"والغرور الذي تضاحك منه","كل غر فقد شأى المين مينا",210,"ن",2,0],["والغيثِ كيف تغيّرت أخلاقه","فبُليت بعد جواده بضنينهِ",211,"ن",2,0],["والغواني آذناتٌ لفمي","ويدي مرتسَناتٌ في حبالي",212,"ل",2,0],["والغانياتُ بناتُ غدرٍ من أبٍ","يضربن في نسبٍ إليه عريقِ",213,"ق",1,0],["والغانياتُ عَطفةً وصدْفَةً","يُجنَى لك الحنظلُ من شِهادها",214,"د",3,0],["والغامرون المَحْلَ من جودهمُ","بكلّ كفٍّ ذاب في عامٍ جَمَدْ",215,"د",1,0],["والغَرْسُ بالسقي والدهماءُ عالمةٌ","أنَّ المَحامدَ أسنى ما اقتنى الرجل",216,"ل",1,0],["والغبار المثار في وضح الص","بح كمسكٍ يفتُّ في كافور",217,"ر",1,0],["والغيث يبكي ووجهُ الأرض مبتسمٌ","فالجوُّ في مأتمٍ والأرض في عرس",218,"س",1,0],["والغزال الأغنّ جتفي وما أت","عبُ من يعشق الغزال الأغنَّا",219,"ن",2,0],["والغدر من شيم الدنيا فساكنها","إليه أشوقُ من أرضٍ إلى مطر",220,"ر",1,0],["والغواني روح الحياة لنفسٍ","في يد الحبِ آذنتْ بزهوق",221,"ق",1,0],["وَالغَرُّ وَالفاخاتُ وَالطاووسُ","كَأَنَّهُ بَينَهُما عَروسُ",222,"س",1,0],["وَالغُدرُ تَضحَكُ عَن ثُغورِ حَبابِها","مِمّا تُدَغدِغُهُ الصَبا وَتَجَمِّشُ",223,"ش",1,0],["وَالغَدرُ قَد لَمَعَت جَواشِنُ مائِها","ما بَينَ بوقاتٍ وَبَينَ بِنودِ",224,"د",1,0],["وَالغَيمُ في الأُفُقِ مَمدودٌ سَرادِقُهُ","وَالطَيرُ يَصفِرُ وَالأَوتارُ تَصطَخِبُ",225,"ب",1,0],["والغواني يغرهن الثناء","كان قلبي في راحتيها وحيدا",226,"د",2,0],["والغرُّ عن شكر امتنانك غافلٌ","وأخو القبول على عطائك حامدُ",227,"د",1,0],["والغوثُ من سدرة قدس العلى","يحفُّ ملهوفاً يناديهمُ",228,"م",1,0],["والغائِبينَ الحاضرينَ أليَّةً","ضُرِبَتْ عليها في الهَوى أسْتاري",229,"ر",2,0],["والغرب واليمن القصية أهله","من خوفهم في قائم وحصيد",230,"د",1,0],["والغيث روى بلدة ثم انتحى","أخرى فنوء سحابه مدرار",231,"ر",1,0],["والغيث ينبوع الحياة وطالما","وافى مع الإغراق بالإحراق",232,"ق",1,0],["والغيث وهو كما قد قيل أوله","قطر ومنه خراب السد بالعرم",233,"م",1,0],["وألغيتني حتى رأيت غنيمة","دخولي مع الجم الغفير أسلم",234,"م",1,0],["والغدّ عندي الحقّ للطلاب","والفخر عندي أفخر الثياب",235,"ب",1,0],["والغنيُّ الّذي له المِنَنُ الغر","رُ جُثوماً على رقابِ الرّجالِ",236,"ل",1,0],["وَالغَدرُ سُلوانُ الفَتى لِحَميمِه","بعد الحِمامِ وليس مِثلِي يغدُرُ",237,"ر",1,0],["وَالغابُ أَهيَبُ ما يكونُ إِذا ثوَتْ","أَشبالُه فيه مع الآسادِ",238,"د",1,0],["وَالغانِياتُ لذِي الشّباب حبائبٌ","وإذا المشيبُ دنا فهنّ أعادِ",239,"د",1,0],["والغيب غيب على ما كان في أزل","ولا سواه ولا شيء سواه هم",240,"م",1,0],["والغير ينفخ في الرما","د ونحن ننفخ في ضرم",241,"م",1,0],["والغير في أر","ضه نعائم",242,"م",1,0],["والغيب أنت الغيب حق ولا","نقدر أن ندنو ولا نلحق",243,"ق",1,0],["والغيب تبدّى في صور","من ينظر فيها يشهده",244,"د",2,0],["والغني الغني بالذات لا بال","عرَض الزائل المثار عجاجه",245,"ج",2,0],["وَالغائِبُ الغَيبَةَ الطَويلَ في سَفَرٍ","زَوجَتُهُ قَد دَعَت لِوَطئِهِ ضَرَرا",246,"ر",2,0],["والغُصْنُ نَضْرٌ والشَّبَا","بُ شَعْرُهُ جَعْدٌ قَطَطْ",247,"ط",1,0],["والغيثُ يَبْكي في خِلالِ نَبَاتِها","والبَرْقُ يَضْحَكُ منه ضِحْكَ الشّامِتِ",248,"ت",1,0],["والغُصْنُ يَحْسُنُ حينَ يُكْ","سَى وهُوَ يَحْسُنُ حِينَ يَعْرى",249,"ر",2,0],["والغصنُ يُعْرَف في البستان مَنْبِتُه","وقَدْ رأَينا بِكَ البُستَانَ في غُصُنِ",250,"ن",1,0],["والغصنُ يَحكي إِذا مال النسيمُ به","منكِ انْعِطافاً وما يحكيكِ أَعْطافاً",251,"ف",2,0],["وَالغَمرُ ذو الأَحَساءِ وَال","لَذّاتُ مِن صاعٍ وَدَيسَق",252,"ق",1,0],["وَألغَيْتُ مِنْ نَاظِريَّ السُّهادَ","وَأَلَقَيْتُ في القَلْبِ نُوراً ونَارا",253,"ر",2,0]]}