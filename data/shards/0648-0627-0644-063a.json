لغيب مشهدها وفيه حضورها","ومغيبها عين الحضور لحاضر",157,"ر",1,0],["والغمر مع جهله مآربه","تقضى بلا عضبه ولهذمه",158,"م",2,0],["والغمر لم يلق ما لم يلق مصرعه","هما ويرتقب العلات من كهنا",159,"ن",2,0],["والغصنُ ناحَ مُنَثّراً ومُنوّراً","والطيرُ صاحَ مُزَقزقاً ومغرّدا",160,"د",2,0],["والغصنُ مالَ إلى أخيهِ قوامِها","وكأنهُ العطشانُ فوقَ المورِد",161,"د",1,0],["والغصنُ مالَ وكالزّفيرِ حَفَيفُهُ","يهدي لكِ التفّاحَ والرمّانا",162,"ن",2,0],["والغربُ من مصرٍ الى مرّاكشٍ","مع كل قُطرٍ بالهدى مشمول",163,"ل",1,0],["وَالغيم ظلله وَالبدر شق له","وَالثدى فاضَ بدر منه مدرارا",164,"ر",2,0],["وَآلِ غِنىً جَمٍّ هُمُ الْبَحْرُ ثَرْوَةً","وَلكِنَّهُمْ عِنْدَ النَّوائِبِ آلُ",165,"ل",1,0],["والغيب محتجب عنا فليس تَرَى","من خائضٍ فيه إلا جاهلاً سَرَفا",166,"ف",2,0],["والغصون اللدن يدنيها الصبا","فترى في الدوح غصنا ضمّ غصنا",167,"ن",2,0],["وَالغيثُ يَسكبُ دمعَه","والزَهر مفترُّ الثُغورِ",168,"ر",1,0],["والغوطتانِ عَلَى محيَّا جلقٍ","من سندسٍ عند الشروقِ لثام",169,"م",1,0],["والغربُ بالأشباحِ يزخر أُفقهُ","فكأنها الأضغاثُ من أحلامه",170,"م",2,0],["وَ (الغوطتان) وَأَنتِ بدرٌ ساطع","لكليلةٍ ظلماء ذات حلوك",171,"ك",1,0],["والغصن توقظه الصبا فيقوم من","خبل الرقاد وفرعه مهدول",172,"ل",1,0],["والغيد والخرد الأتراب","قواصر الطرف في الخدر",173,"ر",1,0],["والغواني الحسان يرتعن فيه","ناعمات بين الحمى والمناهل",174,"ل",1,0],["وَالغوثُ نجلُ مشيشٍ وهوَ نجل أبي","بكرٍ أبوه عليٌّ مرهف خذمُ",175,"م",1,0],["وَالغِشُّ وَالتَزويرُ وَالوَرَقُ ال","خَفي كَما مَضى تَوضيحُهُ بِبَيانِ",176,"ن",1,0],["وَالغَيُّ اليَعدِلُها فيما لَهُ خَطَرا","فَما تَرَوَّت بِحَزمٍ كانَ لي وَزَرا",177,"ر",2,0],["والغد العبقريّ إن كان من حظّي","فأنواره لغير عيوني",178,"ن",2,0],["والغيد مصفوفات في قاعها","مثل الجواري الخنس الكنس",179,"س",1,0],["وَالغَينُ في القافِ وَفي ال","ياءِ وَفي الطاءِ عَبَر",180,"ر",1,0],["وَالغُصنُ أَبهَجُ ما يَشوقك مورقاً","وَالثَوبُ أَجمَلُ ما يُروقك مُعلما",181,"م",2,0],["وَالغَيمُ يَنثُر دُرّا فَوقَ مُنبَسِط","من الزَبرجد يحكى شَكله الصحفا",182,"ف",2,0],["وَالغُصن يَسجد لِلنَّسيم وَيُنثَني","في مَرّة شَوق