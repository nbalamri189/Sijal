ً","يُجنَى لك الحنظلُ من شِهادها",212,"د",3,0],["والغامرون المَحْلَ من جودهمُ","بكلّ كفٍّ ذاب في عامٍ جَمَدْ",213,"د",1,0],["والغَرْسُ بالسقي والدهماءُ عالمةٌ","أنَّ المَحامدَ أسنى ما اقتنى الرجل",214,"ل",1,0],["والغبار المثار في وضح الص","بح كمسكٍ يفتُّ في كافور",215,"ر",1,0],["والغيث يبكي ووجهُ الأرض مبتسمٌ","فالجوُّ في مأتمٍ والأرض في عرس",216,"س",1,0],["والغزال الأغنّ جتفي وما أت","عبُ من يعشق الغزال الأغنَّا",217,"ن",2,0],["والغدر من شيم الدنيا فساكنها","إليه أشوقُ من أرضٍ إلى مطر",218,"ر",1,0],["والغواني روح الحياة لنفسٍ","في يد الحبِ آذنتْ بزهوق",219,"ق",1,0],["وَالغَرُّ وَالفاخاتُ وَالطاووسُ","كَأَنَّهُ بَينَهُما عَروسُ",220,"س",1,0],["وَالغُدرُ تَضحَكُ عَن ثُغورِ حَبابِها","مِمّا تُدَغدِغُهُ الصَبا وَتَجَمِّشُ",221,"ش",1,0],["وَالغَدرُ قَد لَمَعَت جَواشِنُ مائِها","ما بَينَ بوقاتٍ وَبَينَ بِنودِ",222,"د",1,0],["وَالغَيمُ في الأُفُقِ مَمدودٌ سَرادِقُهُ","وَالطَيرُ يَصفِرُ وَالأَوتارُ تَصطَخِبُ",223,"ب",1,0],["والغواني يغرهن الثناء","كان قلبي في راحتيها وحيدا",224,"د",2,0],["والغرُّ عن شكر امتنانك غافلٌ","وأخو القبول على عطائك حامدُ",225,"د",1,0],["والغوثُ من سدرة قدس العلى","يحفُّ ملهوفاً يناديهمُ",226,"م",1,0],["والغائِبينَ الحاضرينَ أليَّةً","ضُرِبَتْ عليها في الهَوى أسْتاري",227,"ي",1,0],["والغرب واليمن القصية أهله","من خوفهم في قائم وحصيد",228,"د",1,0],["والغيث روى بلدة ثم انتحى","أخرى فنوء سحابه مدرار",229,"ر",1,0],["والغيث ينبوع الحياة وطالما","وافى مع الإغراق بالإحراق",230,"ق",1,0],["والغيث وهو كما قد قيل أوله","قطر ومنه خراب السد بالعرم",231,"م",1,0],["وألغيتني حتى رأيت غنيمة","دخولي مع الجم الغفير أسلم",232,"م",1,0],["والغدّ عندي الحقّ للطلاب","والفخر عندي أفخر الثياب",233,"ب",1,0],["والغنيُّ الّذي له المِنَنُ الغر","رُ جُثوماً على رقابِ الرّجالِ",234,"ل",1,0],["وَالغَدرُ سُلوانُ الفَتى لِحَميمِه","بعد الحِمامِ وليس مِثلِي يغدُرُ",235,"ر",1,0],["وَالغابُ أَهيَبُ ما يكونُ إِذا ثوَتْ","أَشبالُه فيه مع الآسادِ",236,"د",1,0],["وَالغانِياتُ لذِي الشّباب حبائبٌ","وإذا المشيبُ دنا فهنّ أعادِ",237,"د",1,0],["والغيب غيب على ما كان في أزل","ولا سواه ولا شيء سواه هم",238,"م",1,0],["والغير ينفخ في الرما","د ونحن ننفخ في ضرم",239,"م",1,0],["والغير في أر","ضه نعائم",240,"م",1,0],["والغيب أنت الغيب حق ولا","نقدر أن ندنو ولا نلحق",241,"ق",1,0],["والغيب تبدّى في صور","من ينظر فيها يشهده",242,"د",2,0],["والغني الغني بالذات لا بال","عرَض الزائل المثار عجاجه",243,"ج",2,0],["وَالغائِبُ الغَيبَةَ الطَويلَ في سَفَرٍ","زَوجَتُهُ قَد دَعَت لِوَطئِهِ ضَرَرا",244,"ر",2,0],["والغُصْنُ نَضْرٌ والشَّبَا","بُ شَعْرُهُ جَعْدٌ قَطَطْ",245,"ط",1,0],["والغيثُ يَبْكي في خِلالِ نَبَاتِها","والبَرْقُ يَضْحَكُ منه ضِحْكَ الشّامِتِ",246,"ت",1,0],["والغُصْنُ يَحْسُنُ حينَ يُكْ","سَى وهُوَ يَحْسُنُ حِينَ يَعْرى",247,"ر",2,0],["والغصنُ يُعْرَف في البستان مَنْبِتُه","وقَدْ رأَينا بِكَ البُستَانَ في غُصُنِ",248,"ن",1,0],["والغصنُ يَحكي إِذا مال النسيمُ به","منكِ انْعِطافاً وما يحكيكِ أَعْطافاً",249,"ف",2,0],["وَالغَمرُ ذو الأَحَساءِ وَال","لَذّاتُ مِن صاعٍ وَدَيسَق",250,"ق",1,0],["وَألغَيْتُ مِنْ نَاظِريَّ السُّهادَ","وَأَلَقَيْتُ في القَلْبِ نُوراً ونَارا",251,"ر",2,0]]}