{"poems":[[55,"أذاع بذي العهد عرفانه","https://www.aldiwan.net/poem29731.html","المتقارب"],[55,"ألا لله بادرة الطلاب","https://www.aldiwan.net/poem30747.html","الوافر"],[73,"لا يخدعنك صحة ويسار","https://www.aldiwan.net/poem4009.html","الكامل"],[95,"سوى الحب لا تشفي الفؤاد المكلما","https://www.aldiwan.net/poem11364.html","الطويل"],[39,"إذا واضعته مصون الحديث","https://www.aldiwan.net/poem7066.html","المتقارب"],[93,"ليطرب من شاء أن يطربا","https://www.aldiwan.net/poem8759.html","عموديه"],[93,"شربناها على سر القوافي","https://www.aldiwan.net/poem8849.html","عموديه"],[93,"دبت وقد أرخى الظلام ستارا","https://www.aldiwan.net/poem8861.html","عموديه"],[91,"تحبهم ثم ارزم ثم سالا","https://www.aldiwan.net/poem44900.html","الوافر"],[45,"ضروب الناس عشاق ضروبا","https://www.aldiwan.net/poem9501.html","الوافر"],[45,"إلام طماعية العاذل","https://www.aldiwan.net/poem9759.html","المتقارب"],[47,"عذيري من واش بها لم أواله","https://www.aldiwan.net/poem65537.html","الطويل"],[63,"أجانبها حذارا لا اجتنابا","https://www.aldiwan.net/poem51817.html","الوافر"],[18,"أليلتنا بذي حسم أنيري","https://www.aldiwan.net/poem23949.html","الوافر"],[50,"كان الشباب مطية الجهل","https://www.aldiwan.net/poem64491.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85451","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85444","الطويل"],[108,"آمال وآلام !!","https://www.poetsgate.com/ViewPoem.aspx?id=179444",""],[18,"أليلتنا بذي حسم أنيري","https://www.poetsgate.com/ViewPoem.aspx?id=27758",""],[92,"يافا الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=179202",""],[124,"تناءت على قرب الديار السرائر","https://www.aldiwan.net/poem49315.html","الطويل"],[136,"أجدك أن بينهم أن آنا","https://www.aldiwan.net/poem54722.html","الوافر"],[136,"أعادك من أسماء عيد مشوق","https://www.aldiwan.net/poem54790.html","الطويل"],[190,"إن عابني أهل ودي في ونى أودي","https://www.aldiwan.net/poem44099.html","البسيط"],[203,"قاسوك يا شمس الضحى","https://www.aldiwan.net/poem45340.html","مجزوء الكامل"],[228,"أمير الشعر لا نور وحق","https://www.aldiwan.net/poem41613.html","الرمل"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[362,"أضاء ببرقة برق لموع","https://www.aldiwan.net/poem4163.html","الوافر"],[409,"هل في القلوب بيوم الحشر إذعان","https://www.aldiwan.net/poem33388.html","البسيط"],[412,"ألم بمضجعي بعد الكلال","https://www.aldiwan.net/poem50138.html","الوافر"],[435,"لك العلياء والشرف المفدى","https://www.aldiwan.net/poem41437.html","الوافر"],[495,"أبي فارسُ الصرماء عمرُو بنُ مالكٍ","https://www.aldiwan.net/poem656.html",""],[505,"جلا سر الغيوب لنا الصباح","https://www.aldiwan.net/poem37682.html","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48772","الكامل"],[995,"","https://poetry.dctabudhabi.ae/diwan/poem/96294","المتقارب"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144005","الوافر"],[440,"","https://poetry.dctabudhabi.ae/diwan/poem/47385","المتقارب"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128716","الطويل"],[1586,"","https://poetry.dctabudhabi.ae/diwan/poem/96345","المتقارب"],[1826,"","https://poetry.dctabudhabi.ae/diwan/poem/198971","الوافر"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21434","الطويل"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46741","الوافر"],[2789,"","https://poetry.dctabudhabi.ae/diwan/poem/21617","البسيط"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65124","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67991","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62903","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129503","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92052","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216811","الكامل"],[3779,"","https://poetry.dctabudhabi.ae/diwan/poem/141543","الوافر"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131016",""],[3799,"","https://poetry.dctabudhabi.ae/diwan/poem/147678","الطويل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86565","الوافر"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119451","الهزج"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4883,"كأس من بُرتقال","https://www.poetsgate.com/ViewPoem.aspx?id=48401",""],[4927,"الجمال المحبب","https://www.poetsgate.com/ViewPoem.aspx?id=30184",""],[4955,"صرخت بوجه القهر","https://www.poetsgate.com/ViewPoem.aspx?id=191274",""],[5150,"ما كل ما يعلم يقال ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=202901",""],[5183,"سباق الأعنة","https://www.poetsgate.com/ViewPoem.aspx?id=180222",""],[307,"مساءُ البهاء","https://www.poetsgate.com/ViewPoem.aspx?id=213699",""],[5431,"ستظلُ دهرا في دمي","https://www.poetsgate.com/ViewPoem.aspx?id=197517",""],[5444,"رُّمانُ.. وأيلولُ أسود","https://www.poetsgate.com/ViewPoem.aspx?id=205085",""],[5493,"إلى المنفى أعود","https://www.poetsgate.com/ViewPoem.aspx?id=197216",""],[5525,"وداعة الله","https://www.poetsgate.com/ViewPoem.aspx?id=7266",""],[5525,"سلام","https://www.poetsgate.com/ViewPoem.aspx?id=944",""],[5628,"الشاعر وأنين الناي الحزين","https://www.poetsgate.com/ViewPoem.aspx?id=191333",""],[5693,"رباعيات . خفقات قلب.","https://www.poetsgate.com/ViewPoem.aspx?id=34848",""],[5784,"بغير الوصل لا أجد الأمان....","https://www.poetsgate.com/ViewPoem.aspx?id=190725",""],[5829,"كان الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=162006",""],[5126,"بائِع المسَاويك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87809&r=&rc=24",""],[4222,"أجيران جيرون مالي مجير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52786&r=&rc=78",""]],"verses":[["كَأَنَّ الجِيادَ تَسامى بِكُم","قِنانُ الشَريفِ وَعُقبانُهُ",0,"ن",2,0],["كَأَنَّ الجَوَّ غَضَّ بِهِ فَأَومى","لِيَقذِفَهُ عَلى قِمَمِ الشِعابِ",1,"ب",1,0],["كانَ الجَوادَ بِما حَوى وَقَد استَوى","في مالِهِ الإِقلالُ وَالإِكثارُ",2,"ر",1,0],["كَأَنَّ الْجَمَادَ النَّاضِحَ الدَّمَ لَمْ يَكُنْ","سَمِيعاً بَصِيراً مُدْرِكاً مُتَكَلِّمَا",3,"م",2,0],["كأن الجراد يغنينه","يناغم ظبي الأنيس المشورا",4,"ر",2,0],["كَأَنَّ الجِبالَ عَلى كاهِلي","كَأَنَّ سُروري أَن أَغضَبا",5,"ب",2,0],["كَأَنَّ الجِنَّ قَد نَفَثَت رُؤاها","عَلى أَوراقِها في ضَوءِ فَجرِ",6,"ر",1,0],["كانَ الجَوابُ قَذائِفاً نارِيَّةً","تَهوى الوُرود وَتَكرَهُ الإِصدارا",7,"ر",2,0],["كأن الجو عفريت مخوف","تزمجر ثم كشر ثم صالا",8,"ل",2,0],["كَأَنَّ الجَوَّ قاسى ما أُقاسي","فَصارَ سَوادُهُ فيهِ شُحوبا",9,"ب",2,0],["كَأَنَّ الجُفونَ عَلى مُقلَتي","ثِيابٌ شُقِقنَ عَلى ثاكِلِ",10,"ل",1,0],["كَأَنَّ الجِبالَ الراسِياتِ تَعَلَّمَت","رَواجِحُها مِن حِلمِهِ وَجَلالِهِ",11,"ل",2,0],["كأنَّ الجوَّ لما انقضَّ فيها","أطالَ عليهم منه شِهابا",12,"ب",2,0],["كَأَنَّ الجَديَ جَديَ بَناتِ نَعشٍ","يَكُبُّ عَلى اليَدَينِ بِمُستَديرِ",13,"ر",1,0],["كانَ الجَميلُ إِذا اِرتَدَيتُ بِهِ","وَمَشَيتُ أَخطِرُ صَيَّتَ النَعلِ",14,"ل",1,0],["كانَ الجَدير به إبقاء جذوته","إذ لَيسَ في نشر أنوار الهدى سرف",15,"ف",1,0],["كأَنَّ الجذوع القائمات منابر","علت خطباء عودَهنَّ تَقول",16,"ل",1,0],["كان الجدودُ لهم شرّى يأوونَهُ","ولنا وكورٌ من يردها يصطد",17,"د",1,0],["كأن الجدي في مثناه ربق","أسير أو بمنزلة الأسير",18,"ر",1,0],["كأنَّ الجوَّ بين الشمسِ تُزْهَى","وبينَ الشمسِ غطَّاها نِقاب",19,"ب",1,0],["كأن الجوى واليأس والسهد والضنى","ديونق على من ضاءه منك ناظر",20,"ر",1,0],["كَأَنَّ الجَمرَ في الظَّلمَاءِ فَوضَى","تَوَقَّدُ جَليِهِ الوَضَّاحِ بَانَا",21,"ن",2,0],["كَأنَّ الجَدَا يَشكُو الجَدَا مِنهُ كَثرَةً","إليه ولاَ يَعرُوهُ غَورٌ مُرَنَّقُ",22,"ق",1,0],["كان الجواب احضروني في ولائمكم","واستحضروني أيّام المصيبات",23,"ت",1,0],["كأنَّ الجمالَ بأعمارنا","يطولُ ليصبحنَ منهُ قصارا",24,"ر",2,0],["كَأَنَّ الجِنَّ تَخطُرُ في دُجاه","وَفي جنباتِهِ لِلبومِ نعقُ",25,"ق",1,0],["كانَ الجِرابُ لَدَيهِ مَحفوظاً إِلى","قَتلِ الإِمامِ المُرتَضى عُثمانِ",26,"ن",1,0],["كَأَنَّ الجَو صُكّ بِصَارِمَيهِ","فَسَالَ عَلَى حَنَادِسِهِ النّجيعُ",27,"ع",1,0],["كان الجهاد ونشر العلم همته","حتى دعاه إلى الجنات رضوان",28,"ن",1,0],["كَأَنَّ الجود بعض الكفِّ منه","فَما لِلبَعضِ عَنها من زَوالِ",29,"ل",1,0],["كأن الجود في كفيك بحر","بلا جزر نراه يفيض مدّا",30,"د",2,0],["كَأَنَّ الجِيادَ الشُعثَ تَحتَ رِحالِهِم","سَمامٌ دَعاها لِلمَزاحِفِ ناجِرُ",31,"ر",1,0],["كأن الجند ما شقَّت عجاجا","ولا بهجومها ارتفع الصياحُ",32,"ح",1,0],["كان الجلاء أقل ما طلبوا","بالرأي لا بالطعن والضرب",33,"ب",1,0],["كأنّ الجرابيَّ من شمسِها","تَلوَّحُ بالنارِ أو تُصلَبُ",34,"ب",1,0],["كأنّ الجوّ صرْحٌ أو غَديرٌ","صفاءً حين تنظرُه ولُطْفا",35,"ف",2,0],["كَأَنَّ الْجَوَارِيَ كَنَّفْنَها","تَخَلَّخُ مِنْ كُلِّ ما جانِبِ",36,"ب",1,0],["كأن الجحيم استبطأتهم فبادرت","بإحراقهم قبل الممات تعاجل",37,"ل",1,0],["كأن الجمان على مغزل","خذول لها رشأ قد قرم",38,"م",1,0],["كأن الجدول المنساب نصل","صقيل المتن هز إلى كفاح",39,"ح",1,0],["كَانَ الجَمِيعُ لدَيه بَاباً واحِداً","والصُّبحُ لاَحَ لِمَن لَهُ عَينَانِ",40,"ن",1,0],["كأَنَّ الجُمانَ الفَصل نيطَت عُقودُهُ","لَياليَ جُملٌ لِلرِّجالِ خَلوبُ",41,"ب",1,0],["كَأَنَّ الجارَ حينَ يَحلُّ فيهم","عَلى الشُمِّ البَواذِخ مِن شَماما",42,"م",2,0],["كانَ الجَواجُ عُبَيدُ اللَهِ أَكرَمَهُم","في كُلِّ حَقٍّ يَنوبُ الناسَ مَذكورُ",43,"ر",1,1],["كأنّ الجواري المنشآت يبادقٌ","وكلّ عذا من هذه بينها فرزا",44,"ز",2,0],["كَأَنَّ الجوَّ شوبٌ زِبْرِجي","وظهرَ البحرِ من روض الخُزامَى",45,"م",2,0],["كأَن الجديَّ استنظرته ركابُه","فباتَ لها في أفقه مترقبَا",46,"ب",2,0],["كأن الجود في ناديك عبد","مطيع في السرائر ما عصاكا",47,"ك",2,0],["كأن الجو مذهولاً أَسيفٌ","يُلطِّم وَجهَه كَفُّ الغُيوم",48,"م",1,0],["كان الجنوح إلى السعادة حكمة","واليوم من يبغي السعادة أخرق",49,"ق",1,0],["كأنَّ الجوَّ بحرٌ من زجاج","فراسب دُرِّه فيه يبين",50,"ن",1,0],["كأن الجياد القب آرام وجرة","وقد راعها صيادها المترقب",51,"ب",1,0],["كأن الجياد الصافنات وقد عدت","سطور كتاب والمقدم عنوان",52,"ن",1,0],["كأن الجو ملك ذو جلال","عليه الفور من غيم صفيق",53,"ق",1,1],["كأن الجام كف وهي","أطراف لها بضه",54,"ض",2,0],["كأن الجواسقَ مأهولةً","بروج تَطَلعُ منها البدورُ",55,"ر",1,0],["كان الجميع يتخيّلني مثل ماتخيل","البدو بَرق ٍ بَرَق غَرب ورعوده شمال",56,"ل",1,0],["كَاْنَ الْجَمَاْلُ مُحَبَّبَاْ","كَالْبَدْرِ مِنْ خَلْفِ الْعَبَاْ",57,"ب",2,1],["كانَ الجوابُ منِ الغثاءِ مدوِّياً","بالصمتِ والنسيانِ والخذلانِ",58,"ن",1,0],["كان الجنونُ أو الخيانةُ وصفَهُ حُكماً","ويبتذلُ السفيهُ وقورَها",59,"ر",3,0],["كأن الجبال الشم وهي تحوطها","من الله سور للعلى والفضائل",60,"ل",1,0],["كأنّ الجمالَ سوادُ الليالي","ووجهك بدرٌ به يعتلي",61,"ل",2,0],["كان الجفونَ لدمعتي","كنتُ السحابَ ليمطرَه",62,"ر",2,0],["كان الجبانَ.. فلم يَسِرْ في نهرِنا","كلا، ويخشى منكم (الجُوْلانا)",63,"ن",2,0],["كأنَّ الجُبَّ يمنحُني صُعودًا","فيُرْهقُني بغيهَبِهِ الصعودُ",64,"د",1,0],["كان الجروح اللي بقلبي سبايبك","أنت الذي بارجى حنانك وأناجي",65,"ج",2,0],["كان الجفا منك حصل لي فلا بد","أرضى بعطفك لوه رد التحيه",66,"ي",2,0],["كانَ الجوابُ صفير الريحِ في أُذُني","والرمل تذروهُ في عيني سوافيها (4)",67,"ي",3,0],["كان الجمال يزورها في لهفة","أضحي الجلال بسدرة الترتيل",68,"ل",1,0],["كأن الجمر يذكى فوق جفني","على من بالصبابة قد بلانا",69,"ن",2,0],["كان الجلاء هو الدنيا وزهوتها","واليوم تزهو على الأعناق آثام",70,"م",1,1],["كانَ (الجُنَيْهُ) التِّبْرُ مُسْتَبْخساً","ثُمَّ اسْتَوَى (تِسْعِينَ) فاذْكُرْ حِجَاكْ",71,"ك",1,0],["كأن الجواسق مأهولة","بروج تطلع منه البدور",72,"ر",1,0]]}