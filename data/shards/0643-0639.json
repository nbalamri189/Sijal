tml","الخفيف"],[26,"عرفت الديار كرقم الدوا","https://www.aldiwan.net/poem24098.html","المتقارب"],[29,"لأسماء محتل بناظرة البشر","https://www.aldiwan.net/poem6183.html","الطويل"],[91,"سلام عليها طفلة وفتية","https://www.aldiwan.net/poem8831.html","عموديه"],[92,"بالأمس قد كانت حياتي","https://www.aldiwan.net/poem38891.html","المجتث"],[92,"أيها الحب أنت سر بلائي","https://www.aldiwan.net/poem38975.html","الخفيف"],[85,"يا ثرى النيل في نواحيك طير","https://www.aldiwan.net/poem62831.html","الخفيف"],[85,"أيها المنتحي بأسوان دارا","https://www.aldiwan.net/poem63710.html","الخفيف"],[45,"تبا للحمك أيها اللحام","https://www.aldiwan.net/poem66642.html","البسيط"],[61,"أخرس ينبيك بإطراقه","https://www.aldiwan.net/poem51634.html","السريع"],[2,"من يتجرم لي المناطق ظالما","https://www.aldiwan.net/poem25037.html","الطويل"],[66,"يا للحماسة ضاقت بينكم حيلي","https://www.aldiwan.net/poem41550.html","البسيط"],[80,"هل أنت فادية فؤاد عميد","https://www.aldiwan.net/poem31494.html","الكامل"],[44,"أرأيت أي سوالف وخدود","https://www.aldiwan.net/poem30556.html","الكامل"],[87,"ما لي بودك بعد اليوم إلمام","https://www.aldiwan.net/poem8263.html","البسيط"],[33,"متى يشتفي منك الفؤاد المعذب","https://www.aldiwan.net/poem26027.html","الطويل"],[33,"لو كان لي قلبان لعشت بواحد","https://www.aldiwan.net/poem41541.html","الطويل"],[105,"إلى القوم الألى جمعوا الجموعا","https://www.aldiwan.net/poem44203.html","الوافر"],[39,"أمن دمن بشاجنة الحجون","https://www.aldiwan.net/poem53733.html","الوافر"],[39,"شث شعب الحي التئام","https://www.aldiwan.net/poem53751.html","المديد"],[39,"طال في رسم مهدد أبده","https://www.aldiwan.net/poem53781.html","المنسرح"],[39,"لمن ديار بهذا الجزع من ربب","https://www.aldiwan.net/poem53814.html","البسيط"],[40,"أسائل عن وجناء في السجن جارها","https://www.aldiwan.net/poem42282.html","الطويل"],[40,"لمن طلل بالنعف نعف وقير","https://www.aldiwan.net/poem42313.html","الطويل"],[22,"نأتك أمامة إلا سؤالا","https://www.aldiwan.net/poem21647.html","المتقارب"],[22,"يا جفنة ترك ابن هوذة خلفه","https://www.aldiwan.net/poem21665.html","الكامل"],[48,"لا تخشعن لطارق الحدثان","https://www.aldiwan.net/poem65313.html","الكامل"],[50,"لقد ذكرتني ليلة القدر مجلسا","https://www.aldiwan.net/poem63947.html","الطويل"],[46,"وجدت ابن آدم في غرة","https://www.aldiwan.net/poem23006.html","المتقارب"],[46,"أم الكتاب إذا قومت محكمها","https://www.aldiwan.net/poem23089.html","البسيط"],[46,"نقمت الرضى حتى على ضاحك المزن","https://www.aldiwan.net/poem23626.html","الطويل"],[19,"تنكر بعدي من أميمة صائف","https://www.aldiwan.net/poem351.html",""],[15,"نأتك سليمى فالفؤاد قريح","https://www.aldiwan.net/poem45279.html","الطويل"],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85327","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39678","الرمل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16635","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55524","المجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54277","الخفيف"],[98,"شاعر يترك الخيال كسيحا","https://www.poetsgate.com/ViewPoem.aspx?id=55333",""],[39,"طَالَ في رَسْمِ مَهْدَدٍ رَبَدُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=4253",""],[85,"يا ثَرَى النيلِ، في نَواحيكَ طيرٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9621&r=&rc=111",""]],"verses":[["كَعِيابِ الدُروعِ أَسمَعَ رَكضُ ال","خَيلِ فيها خَشاخِشَ الأَبدانِ",0,"ن",1,0],["كَعَمتُ فاغِرَةَ الثَغرِ المَخوفِ بِهِم","يَهفو بِأَيمانِهِم نَبعٌ وَمُرّانُ",1,"ن",1,0],["كَعَواسِلِ الذُؤبانِ يَذرَع","نَ الأَماعِزَ وَالخُرُما",2,"م",2,0],["كَعُضوٍ رَمَت فيهِ اللَيالي بِفادِحٍ","وَمَن حَمَلَ العُضوَ الأَليمَ تَأَلَّما",3,"م",2,0],["كَعِمَّةِ الأَلوَثِ مالَت بِهِ","بَينَ النَدامى نَزَواتُ الرَحيق",4,"ق",1,0],["كَعَقائِلِ الأَبطالِ تُجلَبُ دونَها","بيضُ القَواضِبِ وَالقَنا المُتَدَفِّقُ",5,"ق",1,0],["كَعالِيَةِ الرُمحِ إِن طاوَلوهُ","طالَ إِلى المَجدِ نَفساً وَباعا",6,"ع",2,0],["كَعَمتُ لِساني أَن يَقولَ وَإِن يَقُل","فَقُل في الجِرازِ العَضبِ إِن فارَقَ الغِمدا",7,"د",2,0],["كَعَيناءَ ظَلَّ لَها جُؤذُرٌ","بِقُنَّةِ جَوٍّ فَأَجمادِها",8,"د",3,0],["كَعَروسٍ مِن آلِ ساسانَ تُجلى","في دَبيقي حُلَّةٍ وَإِزارِ",9,"ر",1,0],["كَعبَةٌ لِلسَماحِ وَالعِلمِ فَالحَجُّ","إِلَيهِ فَرضٌ عَلَينا يُؤَدّى",10,"د",2,0],["كَعَهدِهِمِ إِذ أَنتَ حَيٌّ وَإِذ لَهُم","لَدَيكَ مَنالاتٌ وَرِيٌّ وَمَشبَعُ",11,"ع",1,0],["كَعِقْدٍ مِنَ الدُّرِّ فِي سِلْكِهِ","فَرَائِدٌ بَاهِرَةٌ تُنْظَمُ",12,"م",1,0],["كَعَقرِ الهاجِرِيِّ إِذا اِبتَناهُ","بِأَشباهٍ حُذينَ عَلى مِثالِ",13,"ل",1,0],["كعكَّ في مناسبها منار","إلى عدنان واضحة السبيلِ",14,"ل",1,1],["كعذراء في مجنى السيال تخيرت","أنابيب رخصات الفروع سيالها",15,"ل",3,0],["كعنز السوء تنطح عالفيها","وترميها عِصيّ الذابحينا",16,"ن",2,0],["كَعَنزِ السُّوءِ تَنطَحُ عَالِفِيهَا","وتَرأَمُهَا عِصِيُّ الذَّائِحينَا",17,"ن",2,0],["كعوب القنا عجباً براحته التي","يروِّي نداها مشرعات طوالك",18,"ك",1,0],["كعادةٍ لم تزل لكل أب","يَنميكَ تغشى عُفاتُه حُجَره",19,"ر",2,0],["كعبة يعمُرها النا","س بحج واعتمار",20,"ر",1,0],["كعصا صاحب العصا","جل ذاك التلقُّف",21,"ف",1,0],["كعين الناظر الضاحِ","ك في محجره المشرقْ",22,"ق",1,0],["كعمروٍ أو كأندادٍ لعمروٍ","ألا يا قومُ للكفر الجُلالِ",23,"ل",1,0],["كعبةِ النَّيك للزناةِ بها في","كُلِّ يوم وليلة استلامُ",24,"م",1,0],["كَعوذِ المُعَطِّفِ أَحزى لَها","بِمَصدَرَةِ الماءِ رَأمٌ رَذِيُّ",25,"ي",1,0],["كَعَطشانَ حَجَّ الماءَ حَتّى أَطاعَني","رَسولٌ إِلى لَعساءَ طَيِّبَةِ النَشرِ",26,"ر",1,0],["كَعابٌ تَلاقى الحُسن وَالفَضلُ عِندَها","كَما يَلتَقي في الصَفحَةِ السَطر وَالسَطرُ",27,"ر",1,0],["كَعَرُوسةٍ مِنْ غانِياتِ الشِّعْرِ","في شَفَقِ السَّحَابْ",28,"ب",1,0],["كَعَرائسِ الأَمَلِ الضَّحُوكِ","يَمِسْنَ ما طالَ الأَمَدْ",29,"د",1,0],["كَعِتابِ الحَبيبِ في أُذُنِ الصَب","بِ وَهَمسِ النَديمِ حَولَ الشَمولِ",30,"ل",1,0],["كَعَذارى أَخفَينَ في الماءِ بَضّاً","سابِحاتٍ بِهِ وَأَبدَينَ بَضّا",31,"ض",2,0],["كَعُوَيمِلِ الصَدقاتِ مُزدَهِياً بِها","وَالكَلبُ فيها سارِقٌ ظَلّامُ",32,"م",1,0],["كعاشِقٍ أخفَى هواه وقد","نَمَّت عليه عَبرةٌ تَجري",33,"ي",1,0],["كَعَوفِ اِبنِ شَمّاسٍ يُرَشِّحُ شِعرَهُ","إِلَيَّ أَسِدّي يا مَنِيَّ وَأَسجِحي",34,"ي",1,0],["كَعاجِزٍ لَم يُطِق في الحُكمِ مَقدَرَةً","فَإِن رَأوا حالَةً في الناسِ مُنكَرَةً",35,"ه",1,0],["كَعُيونِ عُشّاقٍ أبَاحَ لها الكَرى","مَنْ كان عَذّبَهُنّ بالتَّسهِيدِ",36,"د",1,0],["كَعبٌ وَحاتَمٌ اللَذانِ تَقَسَّما","خُطَطَ العُلى مِن طارِفٍ وَتَليدِ",37,"د",1,0],["كَعَقْرَبِ الْمَاءِ يَمْشِي مِشْيَةً صدَداً","فَخَلْفُهُ عِنْدَ جِدِّ الأَمْرِ إِقْدَامُ",38,"م",1,0],["كَعُصفورَةٍ في كَفِّ طِفلٍ يَزُمُّها","تَذوقُ حِياضَ المَوتِ وَالطِفلُ يَلعَبُ",39,"ب",1,0],["كَعُصفُورةٍ في كفِّ طفلٍ يُهِينُها","تُعَانِي عَذابَ المَوتِ والطِفلُ يلعبُ",40,"ب",1,0],["كعهدِكَ إذ جرى سمّاً نقيعا","وأجرَى الأمرَ عَبّادٌ سويّا",41,"ي",2,0],["كَعُثكولِ الصَفِيِّ زَهاهُ هُلبٌ","بِهِ عَبسُ المَصايِفِ كَالقُرونِ",42,"ن",1,0],["كَعَقيلِ الحُرِّ في لَونِهِ","لُمَعٌ كَالشامِ مِن غَيرِ شام",43,"م",1,0],["كعراقِ الأَطِبَّةِ السودِ يَستنْ","نُ كَحَبلٍ يَجولُ مُنفَصِدُه",44,"د",2,0],["كَعامِرِ بنِ جُوَينٍ في مُرَكَّبِهِ","أَو مِثلِ أَوسِ بنِ سُعدى سَيِّدِ العَرَبِ",45,"ب",1,0],["كَعابٌ إِذا قامَت قَليلاً تَأَوَّدَت","كَمَشي الحَسِيرِ مُكرَهاً وَهوَ مُزحَفُ",46,"ف",1,0],["كَعِبرِيِّ بانٍ أَثبتَتهُ أُصُولُهُ","يُحَرِّكُ أَعلاهُ نَسيمُ دَبُورِ",47,"ر",1,0],["كَعاطِيَةٍ مِن ظِباءِ السَليلِ","حُسّانَةِ الجيدِ تُزجي غَزالا",48,"ل",2,0],["كَعَريضَةِ الشيزى يُكَلَّلُ فَوقَها","شَحمُ السَنامِ غَداةَ ريحٍ صَرصَرِ",49,"ر",1,0],["كَعُقودِ ياقوتٍ نُظِمنَ وَلُؤلُؤٍ","أَوساطُهُنَّ فَرائِدُ العِقيانِ",50,"ن",1,0],["كَعابٌ وَأُخرى كَالكَعابِ خَريدَةٌ","ثَقالٌ وَلَم تَستَشعِرا عَيشَ جُحَّدِ",51,"د",1,0],["كَعامِلِ قَومٍ أَساءَ الصَنيعَ","وَلا ريبَ في أَنَّهُ يَنصَرِف",52,"ف",1,0],["كَعِلَّةِ الجِسمِ أَدنَتهُ إِلى شَجَبٍ","يُعَدُّ أَشنَعَ مِن غَدرٍ تُوافيكا",53,"ك",2,0],["كَعابٌ دُجاها فَرْعُها ونَهارُها","مُحيّاً لها قامتْ له الشمسُ بالحُسنِ",54,"ن",1,0],["كَعَهدِكِ لا عَهدُ الشَبابِ يُضِلُّني","وَلا هَرِمٌ مِمَّن تَوَجَّهَ دالِفُ",55,"ف",1,0],["كَعَومِ السَفينِ في غَوارِبِ لُجَّةٍ","تُكَفِّئُها في ماءِ دِجلَةَ ريحُ",56,"ح",1,0],["كعَروسٍ جُلِيَتْ في حِبَرٍ","صَنْع صنعاء وديباجِ خُوَي",57,"ي",1,0],["كَعَذراء تحمل في قَلبِها","غَراماً وَلكنها تكتم",58,"م",1,0],["كعبة الأحرار هذي محنةٌ","راعت الأحرارَ في أكرم عيد",59,"د",1,0],["كعصبة زنجٍ راعها الشيب فازدهت","مناقيش في داجي الشبيبة أفرع",60,"ع",1,0],["كَعَهْدِهِ فَازَ بِالسَّبْ","قِ وَالحَوَاضِرُ خَلْفَهْ",61,"ف",2,0],["كَعْبةٌ حَجّتْ الوُفُودُ إِليها","تَسْتَحِثُّ الرِّكَابَ وَفْداً فَوَفْدا",62,"د",2,0],["كعليل على فراش من السل","بعيد المزار عن إخوانه",63,"ن",2,0],["كَعِراقِ الأطِبَّة ِ السُّودِ، يَسْتَ","نُّ، كَحَبْلٍ يَجُولُ، مُنْفَصِدُهْ",64,"د",2,0],["كعتاب الحبيب في أذنِ الصَّ","ب، وهمسِ النديمِ حولَ الشمول",65,"ل",1,0]]}