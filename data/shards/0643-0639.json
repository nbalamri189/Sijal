ِن فارَقَ الغِمدا",7,"د",2,0],["كَعَيناءَ ظَلَّ لَها جُؤذُرٌ","بِقُنَّةِ جَوٍّ فَأَجمادِها",8,"د",3,0],["كَعَروسٍ مِن آلِ ساسانَ تُجلى","في دَبيقي حُلَّةٍ وَإِزارِ",9,"ر",1,0],["كَعبَةٌ لِلسَماحِ وَالعِلمِ فَالحَجُّ","إِلَيهِ فَرضٌ عَلَينا يُؤَدّى",10,"د",2,0],["كَعَهدِهِمِ إِذ أَنتَ حَيٌّ وَإِذ لَهُم","لَدَيكَ مَنالاتٌ وَرِيٌّ وَمَشبَعُ",11,"ع",1,0],["كَعِقْدٍ مِنَ الدُّرِّ فِي سِلْكِهِ","فَرَائِدٌ بَاهِرَةٌ تُنْظَمُ",12,"م",1,0],["كَعَقرِ الهاجِرِيِّ إِذا اِبتَناهُ","بِأَشباهٍ حُذينَ عَلى مِثالِ",13,"ل",1,0],["كعكَّ في مناسبها منار","إلى عدنان واضحة السبيلِ",14,"ل",1,1],["كعذراء في مجنى السيال تخيرت","أنابيب رخصات الفروع سيالها",15,"ل",3,0],["كعنز السوء تنطح عالفيها","وترميها عِصيّ الذابحينا",16,"ن",2,0],["كَعَنزِ السُّوءِ تَنطَحُ عَالِفِيهَا","وتَرأَمُهَا عِصِيُّ الذَّائِحينَا",17,"ن",2,0],["كعوب القنا عجباً براحته التي","يروِّي نداها مشرعات طوالك",18,"ك",1,0],["كعادةٍ لم تزل لكل أب","يَنميكَ تغشى عُفاتُه حُجَره",19,"ر",2,0],["كعبة يعمُرها النا","س بحج واعتمار",20,"ر",1,0],["كعصا صاحب العصا","جل ذاك التلقُّف",21,"ف",1,0],["كعين الناظر الضاحِ","ك في محجره المشرقْ",22,"ق",1,0],["كعمروٍ أو كأندادٍ لعمروٍ","ألا يا قومُ للكفر الجُلالِ",23,"ل",1,0],["كعبةِ النَّيك للزناةِ بها في","كُلِّ يوم وليلة استلامُ",24,"م",1,0],["كَعوذِ المُعَطِّفِ أَحزى لَها","بِمَصدَرَةِ الماءِ رَأمٌ رَذِيُّ",25,"ي",1,0],["كَعَطشانَ حَجَّ الماءَ حَتّى أَطاعَني","رَسولٌ إِلى لَعساءَ طَيِّبَةِ النَشرِ",26,"ر",1,0],["كَعابٌ تَلاقى الحُسن وَالفَضلُ عِندَها","كَما يَلتَقي في الصَفحَةِ السَطر وَالسَطرُ",27,"ر",1,0],["كَعَرُوسةٍ مِنْ غانِياتِ الشِّعْرِ","في شَفَقِ السَّحَابْ",28,"ب",1,0],["كَعَرائسِ الأَمَلِ الضَّحُوكِ","يَمِسْنَ ما طالَ الأَمَدْ",29,"د",1,0],["كَعِتابِ الحَبيبِ في أُذُنِ الصَب","بِ وَهَمسِ النَديمِ حَولَ الشَمولِ",30,"ل",1,0],["كَعَذارى أَخفَينَ في الماءِ بَضّاً","سابِحاتٍ بِهِ وَأَبدَينَ بَضّا",31,"ض",2,0],["كَعُوَيمِلِ الصَدقاتِ مُزدَهِياً بِها","وَالكَلبُ فيها سارِقٌ ظَلّامُ",32,"م",1,0],["كعاشِقٍ أخفَى هواه وقد","نَمَّت عليه عَبرةٌ تَجري",33,"ي",1,0],["كَعَوفِ اِبنِ شَمّاسٍ يُرَشِّحُ شِعرَهُ","إِلَيَّ أَسِدّي يا مَنِيَّ وَأَسجِحي",34,"ي",1,0],["كَعاجِزٍ لَم يُطِق في الحُكمِ مَقدَرَةً","فَإِن رَأوا حالَةً في الناسِ مُنكَرَةً",35,"ه",1,0],["كَعُيونِ عُشّاقٍ أبَاحَ لها الكَرى","مَنْ كان عَذّبَهُنّ بالتَّسهِيدِ",36,"د",1,0],["كَعبٌ وَحاتَمٌ اللَذانِ تَقَسَّما","خُطَطَ العُلى مِن طارِفٍ وَتَليدِ",37,"د",1,0],["كَعَقْرَبِ الْمَاءِ يَمْشِي مِشْيَةً صدَداً","فَخَلْفُهُ عِنْدَ جِدِّ الأَمْرِ إِقْدَامُ",38,"م",1,0],["كَعُصفورَةٍ في كَفِّ طِفلٍ يَزُمُّها","تَذوقُ حِياضَ المَوتِ وَالطِفلُ يَلعَبُ",39,"ب",1,0],["كَعُصفُورةٍ في كفِّ طفلٍ يُهِينُها","تُعَانِي عَذابَ المَوتِ والطِفلُ يلعبُ",40,"ب",1,0],["كعهدِكَ إذ جرى سمّاً نقيعا","وأجرَى الأمرَ عَبّادٌ سويّا",41,"ي",2,0],["كَعُثكولِ الصَفِيِّ زَهاهُ هُلبٌ","بِهِ عَبسُ المَصايِفِ كَالقُرونِ",42,"ن",1,0],["كَعَقيلِ الحُرِّ في لَونِهِ","لُمَعٌ كَالشامِ مِن غَيرِ شام",43,"م",1,0],["كعراقِ الأَطِبَّةِ السودِ يَستنْ","نُ كَحَبلٍ يَجولُ مُنفَصِدُه",44,"د",2,0],["كَعامِرِ بنِ جُوَينٍ في مُرَكَّبِهِ","أَو مِثلِ أَوسِ بنِ سُعدى سَيِّدِ العَرَبِ",45,"ب",1,0],["كَعابٌ إِذا قامَت قَليلاً تَأَوَّدَت","كَمَشي الحَسِيرِ مُكرَهاً وَهوَ مُزحَفُ",46,"ف",1,0],["كَعِبرِيِّ بانٍ أَثبتَتهُ أُصُولُهُ","يُحَرِّكُ أَعلاهُ نَسيمُ دَبُورِ",47,"ر",1,0],["كَعاطِيَةٍ مِن ظِباءِ السَليلِ","حُسّانَةِ الجيدِ تُزجي غَزالا",48,"ل",2,0],["كَعَريضَةِ الشيزى يُكَلَّلُ فَوقَها","شَحمُ السَنامِ غَداةَ ريحٍ صَرصَرِ",49,"ر",1,0],["كَعُقودِ ياقوتٍ نُظِمنَ وَلُؤلُؤٍ","أَوساطُهُنَّ فَرائِدُ العِقيانِ",50,"ن",1,0],["كَعابٌ وَأُخرى كَالكَعابِ خَريدَةٌ","ثَقالٌ وَلَم تَستَشعِرا عَيشَ جُحَّدِ",51,"د",1,0],["كَعامِلِ قَومٍ أَساءَ الصَنيعَ","وَلا ريبَ في أَنَّهُ يَنصَرِف",52,"ف",1,0],["كَعِلَّةِ الجِسمِ أَدنَتهُ إِلى شَجَبٍ","يُعَدُّ أَشنَعَ مِن غَدرٍ تُوافيكا",53,"ك",2,0],["كَعابٌ دُجاها فَرْعُها ونَهارُها","مُحيّاً لها قامتْ له الشمسُ بالحُسنِ",54,"ن",1,0],["كَعَهدِكِ لا عَهدُ الشَبابِ يُضِلُّني","وَلا هَرِمٌ مِمَّن تَوَجَّهَ دالِفُ",55,"ف",1,0],["كَعَومِ السَفينِ في غَوارِبِ لُجَّةٍ","تُكَفِّئُها في ماءِ دِجلَةَ ريحُ",56,"ح",1,0],["كعَروسٍ جُلِيَتْ في حِبَرٍ","صَنْع صنعاء وديباجِ خُوَي",57,"ي",1,0],["كَعَذراء تحمل في قَلبِها","غَراماً وَلكنها تكتم",58,"م",1,0],["كعبة الأحرار هذي محنةٌ","راعت الأحرارَ في أكرم عيد",59,"د",1,0],["كعصبة زنجٍ راعها الشيب فازدهت","مناقيش في داجي الشبيبة أفرع",60,"ع",1,0],["كَعَهْدِهِ فَازَ بِالسَّبْ","قِ وَالحَوَاضِرُ خَلْفَهْ",61,"ف",2,0],["كَعْبةٌ حَجّتْ الوُفُودُ إِليها","تَسْتَحِثُّ الرِّكَابَ وَفْداً فَوَفْدا",62,"د",2,0],["كعليل على فراش من السل","بعيد المزار عن إخوانه",63,"ن",2,0],["كَعِراقِ الأطِبَّة ِ السُّودِ، يَسْتَ","نُّ، كَحَبْلٍ يَجُولُ، مُنْفَصِدُهْ",64,"د",2,0],["كعتاب الحبيب في أذنِ الصَّ","ب، وهمسِ النديمِ حولَ الشمول",65,"ل",1,0],["كعبة العارفين قطب رحاهم","ملحق العاجزين بالاملاك",66,"ك",1,0],["كعود الشباب ورشف الرضاب","وشم النحور ولثم الخدود",67,"د",1,0],["كعبة حسن اشرقت شمسها","قبلت منها الحجر الاسودا",68,"د",2,0],["كعبة الامن للمريد وباب ال","خير والبر مظهر الاسعاد",69,"د",1,0],["كعتمة مع فجر","رقيقة صبغة اللَه",70,"ل",2,0],["كعبة العارفين قطب البرايا","سيد طاب مبدأ وفروعا",71,"ع",2,0],["كعمامة الأَستاذ عبود","المزركشة المتينة",72,"ن",2,0],["كعبِ بن مامةَ في الحِقِب","والقائلينَ الفاعلِينَ",73,"ن",1,0],["كَعَّ الأَبطَالُ بِهِ حَتى أنثَنَى","مُدبِراً كُلُّ كَمِىٍّ وبَطَل",74,"ل",1,0],["كعش عصفورةٍ من فوقِ مرتفع","هوى بافراخها في حندس الظلَمِ",75,"م",1,1],["كعبة جود يسئل الوفد بها","رب مقام وحجا وحجر",76,"ر",1,0],["كعُمّارَّيتَيْن على رحيلٍ","بمحبوبين بينهما رقيب",77,"ب",1,0],["كَعُثمانَ أَغنى الجيشَ والجيشُ معسرٌ","وَجهّزهُ إبلاً وجهّزهُ تِبرا",78,"ر",2,0],["كَعبة اللَّه بيته قبلةَ النا","سِ إليهِ أعظِم بهذا بناءَ",79,"ا",2,0],["كَعَصاةِ الكليمِ كلّ حصاةٍ","كانَ مِن دونِ رَميها الإلقاءُ",80,"ا",2,0],["كعهودِ الغيدِ إن صدقتْ","فقُصاراها إلى الكذبِ",81,"ب",1,0],["كعبة البر نحوه جئت اسعى","فحلا لي سعيي به وطوافي",82,"ي",1,0],["كَعابٌ أَتَت في الحُسنِ فَخرَ الكَواعِبِ","لبانَتُها نيطَت بِحَدِّ القَواضبِ",83,"ب",1,1],["كعَذَارَى تخالهنّ سُكَارى","يتعانقن والوجوه شموس",84,"س",1,0],["كَعبَةُ اللَهِ الَّتي حَرَّمَها","أَنتُمُ الخيرَةُ مِن جيرانِها",85,"ن",3,0],["كَعابٌ كَخ