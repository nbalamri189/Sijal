{"poems":[[53,"أسائل سيفي أي بارقة تجدي","https://www.aldiwan.net/poem30621.html","الطويل"],[51,"دامت لك الصالحات والنعم","https://www.aldiwan.net/poem66347.html","المنسرح"],[45,"هل الربع قد أمست خلاء منازله","https://www.aldiwan.net/poem65625.html","الطويل"],[28,"إذا أظلمت سيما امرئ السوء أسفرت","https://www.aldiwan.net/poem5437.html","الطويل"],[58,"إذا أظمأتك أكف الرجال","https://www.aldiwan.net/poem30794.html","المتقارب"],[105,"أبا الفضل أقبل وارفع الصوت شاكرا","https://www.aldiwan.net/poem44043.html","الطويل"],[46,"أما حياتي فما لي عندها فرج","https://www.aldiwan.net/poem23350.html","البسيط"],[28,"إذا أظلمت سيما امرىء السوء أسفرت","https://www.poetsgate.com/ViewPoem.aspx?id=22009",""],[144,"كفى الدين عزا ما قضاه لك الدهر","https://www.aldiwan.net/poem11758.html","الطويل"],[213,"منازل للأحباب غبر طوامس","https://www.aldiwan.net/poem37874.html","الطويل"],[281,"يقيني يقيني حادثات النوائب","https://www.aldiwan.net/poem60788.html","الطويل"],[365,"حيث انتهيت من الهجران بي فقف","https://www.aldiwan.net/poem60841.html","البسيط"],[365,"قضى على جد شانيكم بإتعاس","https://www.aldiwan.net/poem60867.html","البسيط"],[367,"أبى الدمع أن يشفى به هم هائم","https://www.aldiwan.net/poem17262.html","الطويل"],[465,"شهيدا غرامي ادمعي وسجومها","https://www.aldiwan.net/poem3217.html","عموديه"],[537,"أشاقك بالمنتصى منزل","https://www.aldiwan.net/poem23851.html","المتقارب"],[568,"أذابت قلبه الزفره","https://www.aldiwan.net/poem69677.html","مجزوء الرجز"]],"verses":[["إِذا أَظلَمَت آمالُ قَومٍ بِرَدِّها","أَضاءَ سَنا مَعروفِهِ ظُلمَةَ الرَدِّ",0,"د",1,0],["إذا أظلَّ السحابُ خِطَّتَها","هَمْهَمَ بالرَّعدِ وهو مكتتم",1,"م",1,0],["إِذا أَظلَمَ الدَهرُ العَبوسُ أَضاءَهُ","أَغَرُّ مِنَ الفِتيانِ حُلوٌ شَمائِلُه",2,"ل",2,0],["إِذا أَظلَمَت سيما اِمرِئِ السوءِ أَسفَرَت","خَلائِقُ مِن عَلوانَ يَدعو دَليلُها",3,"ل",3,1],["إِذا أَظمَأتَكَ أَكُفُّ الرِجالِ","كَفَتكَ القَناعَةُ شبعاً وَريّا",4,"ي",2,1],["إذا أظمأ اللَّهُ البلادَ وأهلَهَا","فَبِاسْمِكَ يَسْقِيهَا الغُيوثَ المواطرا",5,"ر",2,0],["إِذا أَظَلَّت مِنَ الأَهواءِ مَهلَكَةٌ","فَلا تَهابَن رَداها وَاِمضِيَن قُدُما",6,"م",2,0],["إذا أظلمتْ سيما امرِىءِ السّوْءِ أسفرَتْ","خَلائِقُ من عَلْوَانَ يَدعو دَليلُهَا",7,"ل",3,1],["إِذا أَظهَروا سِرَّ الجُفونِ فَلا دُجىً","فَإِن لَفَّهُم نَقعُ المَذاكي فَلا فَجرُ",8,"ر",1,0],["إذا أظلَمَ الدَّهرُ الخؤونُ رُجاءَه","علينا فجدواه مُنِيرٌ وقابِسُ",9,"س",1,0],["إِذا أَظْلَمَتْ سُبْلُ السُّرَاةِ إِلى الْعُلى","سَرَوْا فَاسْتَضَاءُوا بَيْنَها بِالْمَنَاسِبِ",10,"ب",1,0],["إذا أظلّتْه للأيّامِ مُظْلِمةٌ","مضَيْتَ مُعتزِماً فيها ولم تَقِف",11,"ف",1,0],["إذا أظلَّتْ هوادي الخَطْبِ واشتبهتْ","كسَمْتِ طامسةِ الأعلامِ أملاس",12,"س",1,0],["إِذا أَظلَمَت في القَلبِ لَيلَةُ هَفوَةٍ","فَزادَت وُضوحاً مِنكَ شُهبُ المَكارِمِ",13,"م",1,0],["إذا أظلمت يهماء فهو صاحبها","وإن أشكلت غماء فهو عليمها",14,"م",3,0],["إِذا أَظلَمَ اللَيلُ مِن دونِهِ","عَفَتهُ جَعارِ الَّتي تَقزِلُ",15,"ل",1,0],["إذا أَظْهَرَتْ في الحُبِّ","وفاءً أظْهَرَ الغَدْرَهْ",16,"ر",2,0]]}