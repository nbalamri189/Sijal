الهوان وصيحة المرتاب","https://www.aldiwan.net/poem55365.html","الكامل"],[343,"ألق الدنيا حباب","https://www.aldiwan.net/poem55384.html","مجزوء الرمل"],[352,"يا ابن الخلائف من مروان أنجبك","https://www.aldiwan.net/poem68969.html","البسيط"],[354,"يا سعيدا به كواكب سعدي","https://www.aldiwan.net/poem40835.html","الخفيف"],[365,"أعد التأمل أيها المرتاب","https://www.aldiwan.net/poem60988.html","الكامل"],[404,"هل أهنيك أم أهني المعالي","https://www.aldiwan.net/poem33473.html","الخفيف"],[404,"قال عبد مسه طول الضرر","https://www.aldiwan.net/poem33934.html","الرمل"],[411,"لام في أم مالك عاذلاكا","https://www.aldiwan.net/poem67486.html","الخفيف"],[417,"انظر إلى الأشراف كيف تسود","https://www.aldiwan.net/poem54146.html","البسيط"],[438,"ربوع الندى من بعد فقدك بلقع","https://www.aldiwan.net/poem2548.html","الطويل"],[452,"اهل افغانستان","https://www.aldiwan.net/poem23875.html","الطويل"],[454,"هذي وصيتك النفيسة لم تزل","https://www.aldiwan.net/poem61640.html","الكامل"],[456,"سخنة في الشتاء باردة الصيف","https://www.aldiwan.net/poem26621.html","الخفيف"],[459,"أتراها يوم صدت أن أراها","https://www.aldiwan.net/poem55814.html","الرمل"],[459,"أمنها على أن المزار بعيد","https://www.aldiwan.net/poem56220.html","الوافر"],[459,"حاشاك من عارية ترد","https://www.aldiwan.net/poem56234.html","الوافر"],[459,"أقامت على قلبي كفيلا من العهد","https://www.aldiwan.net/poem56244.html","الطويل"],[462,"ترفعت عن مدح الرجال وقادني","https://www.aldiwan.net/poem15117.html","الطويل"],[465,"سري وعقود الأفق منثالة النظم","https://www.aldiwan.net/poem3173.html","عموديه"],[465,"نسيم الصبا والليل منتظم العقد","https://www.aldiwan.net/poem3176.html","عموديه"],[465,"أنظر إلى نسج الربيع وحوكه","https://www.aldiwan.net/poem3207.html","عموديه"],[465,"إن هم الأمير أصلحه الله","https://www.aldiwan.net/poem3364.html","عموديه"],[465,"يا خليلي تلك أعلام نجد","https://www.aldiwan.net/poem3489.html","عموديه"],[467,"سخطت ولم أذنب وترضى مخالفا","https://www.aldiwan.net/poem50476.html","الطويل"],[494,"جاد ربعا حللته يا همام","https://www.aldiwan.net/poem67324.html","الخفيف"],[501,"قلوب الأولياء لها سيوف","https://www.aldiwan.net/poem37953.html","الوافر"],[506,"العار","https://www.aldiwan.net/poem42463.html","البسيط"],[516,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[554,"بلاءك إني غير مستعب الرضى","https://www.aldiwan.net/poem68395.html","الطويل"],[576,"من فر منك فما يلام","https://www.aldiwan.net/poem3009.html","مجزوء الكامل"],[576,"تخطو وتخطر بين الحلي والحلل","https://www.aldiwan.net/poem3024.html","البسيط"]],"verses":[["سَخا لَكَ مِن ريحِ الزَفيرِ بِحاصِبٍ","مُقيمٍ وَمِن ماءِ الشُؤونِ بِوادِقِ",0,"ق",1,0],["سَخِطَ الغُرابُ عَلى المَساقِطِ بَينَها","فَلَهُ بِإِنجازِ الفِراقِ نَعيقُ",1,"ق",1,0],["سُخطٌ لَوَ أَنَّ الطودَ يُرمى بِهِ","ساخَ عَنِ الأَطوادِ أَو خَفَّضا",2,"ض",2,0],["سَخِرَتْ بَدَائِعُهَا الَّتِي أَوْدَعْتَهَا","بِزَمَانِهَا هَذَا وَكُلَّ زَمَانِ",3,"ن",1,0],["سَخَّرَ العِلمَ لِيَبني آيَةً","فَوقَ شَطِّ النيلِ تَبدو كَالعَلَم",4,"م",1,1],["سَخِروا مِنَ الفَضلِ الَّذي أوتيتَهُ","وَاللَهُ يَسخَرُ مِنهُمُ في النارِ",5,"ر",1,0],["سَخاوِيَّ أَفلالِ تَبيتُ بِجَوزِها","مِنَ القَفرِ وَالإِقواءِ تَعوي عَواسِلُه",6,"ل",2,0],["سَخاويَّ ماتَت فَوقَها كُلِّ هَبوَةٍ","مِنَ القَيظِ وَاِعَتَّمت بِهِنَّ الحَزاوِرُ",7,"ر",1,0],["سخّرت من أوتاره ما لم يكن","ليطيع غيرك قطّ في تسخيره",8,"ر",2,0],["سخنت كحمّام عليكَ مدامعي","لما رزِئت بكوكبٍ وقَّاد",9,"د",1,0],["سخت ومحت شكوى قتادة فاغْتدت","بها العينُ تجري إذ بها العين تجبر",10,"ر",1,0],["سخّاه عن رُزءِ ذاك أنَّ له","حُسناً إذا قاسه به غمره",11,"ر",2,0],["سخرتُ فيك هجائي بعد ما ذَئِرتْ","منك القوافي وقِدْماً عيفت القُذَر",12,"ر",1,0],["سخطت على مهندسك الملقّى","وما هو كفءُ سخطك بالضمير",13,"ر",1,0],["سُخِّر الفيلُ وهُوَ أعظم مني","لضئيل الرجال يركب ظهره",14,"ر",2,0],["سخِطَ الإله على أُولَ","ئك إنهم من شر غرسه",15,"س",2,0],["سخطُوا مودَّتَهُم وخانُوا جارَهُم","لا فارقَ الأَوداجَ مُدْيةُ ساحط",16,"ط",1,0],["سخْلةٌ ما عَدَتْ فراشك لكن","لم تكُن قطُّ من بناتِ فراشِك",17,"ك",1,0],["سَخَّرَ العِلمُ لَهُم حَتّى الغُيوم","فَهُم مِثلَهُمُ فَوقَ الصَعيد",18,"د",1,0],["سَخرْتَ بأَنَّاتِ شَعْبٍ ضَعيفٍ","وكَفُّكَ مخضوبَةٌ من دمَاهْ",19,"ه",1,0],["سَخَافةٌ دُنياكُمُ هذه","تائهةٌ في ظلمةٍ لا تُحَدْ",20,"د",1,0],["سُخطُك قَد زادَني سَقاما","فاِبعَث إِلَيَّ الرِضى مسيحا",21,"ح",2,0],["سخت في حمأته","وتعدّت ارجلك",22,"ك",1,0],["سَخَّرَهُ اللَهُ لَكا","وَلِلعِبادِ قَبلَكا",23,"ك",2,0],["سُخِّرَ العالَمُ مِن أَرضٍ وَماء","لَكَ وَالريحُ وَما تَحتَ السَماء",24,"ا",2,0],["سَخِروا مِنَ الدُنيا كَما سَخِرَت بِهِم","وَاِنبَتَّ مِن أَسبابِها المُتَعَلَّقُ",25,"ق",1,0],["سُخِّرَ الناسُ وَإِن لَم يَشعُروا","لِقَوِيٍّ أَو غَنِيٍّ أَو مُبين",26,"ن",1,0],["سخّر أفلاكهم لأمرهمُ","نجومَها السائراتِ والشهبا",27,"ب",2,0],["سَخاوَةٌ مِن نَدى مَروانَ أَعرِفُها","وَالطَعنِ لِلخَيلِ في أَكتافِها زَوَرُ",28,"ر",1,0],["سَخا طَلَباً لِلوِترِ نَفساً بِمَوتِهِ","فَماتَ كَريماً عائِفاً لِلمَلائِمِ",29,"م",1,0],["سخره الخضر لابن خالته","يحمل قطرا لسد يأجوج",30,"ج",1,0],["سخاءٌ بهجرٍ من سمينٍ مُدَمْلَجٍ","وشُحٌّ بوصلٍ مِنْ هَزِيلٍ مُوَشَّحِ",31,"ح",1,0],["سخيّة بالسكر مَرّتْ على","دنانِها بالختم أيْدٍ شحاح",32,"ح",1,0],["سَخِطَت لَهاهُ عَلى جَداهُ سَخطَةً","فَاِستَرفَدَت أَقصى رِضا المُستَرفِدِ",33,"د",1,0],["سَخِنَت عَيني لَئِن عُدتَ لَها","لَتَمُدَّنَّ بِحَبلٍ مُنبَتِر",34,"ر",1,0],["سُخنَةُ المَشتى لِحافٌ لِلفَتى","تَحتَ لَيلٍ حينَ يَغشاهُ الصَرَد",35,"د",1,0],["سَخِرَت بِالنَجمِ هِمَّتُهُ","وَاِزدَرَت يُمناهُ بِالدِيَمِ",36,"م",1,0],["سَخِرَ الوُلاةُ بِنا فَساروا سيرَةً","مَلَأَت لَنا خِزياً وَفاضَت عارا",37,"ر",2,0],["سَخِيُّ النَّفسِ والهيجاءُ تَغلِي","فتملأ أَنْفُسَ الشُّجعانِ شُحّا",38,"ح",2,0],["سَخونُ الشِتاءِ يُدفِئُ القُرَّ مَسُّها","وَفي الصَيفِ جَمّاءُ العِظامِ بَرودُ",39,"د",1,0],["سَخَطتُم عَلى اللَهِ العَظيمِ قَضائَهُ","سَيَمضي بِما فيهِ إِذا كَثُرَ اللَغطُ",40,"ط",1,0],["سَخَّرَ اللَهُ لِلأَمينِ مَطايا","لَم تُسَخَّر لِصاحِبِ المِحرابِ",41,"ب",1,1],["سُخِّنتَ مِن شِدَّةِ البُرودَةِ حَت","تى صِرتَ عِندي كَأَنَّكَ النارُ",42,"ر",1,0],["سُخامِيَّةٌ لَم يَقطَعِ السِنُّ مَتنَها","لَها مُذ ثَوَت في دَنِّها سَنَتانِ",43,"ن",1,0],["سَخوا لِيَقولَ الناسُ جادوا وَأَقدَموا","لِيُذكَرَ في الهَيجاءِ قِرنٌ مَنازِلُ",44,"ل",1,0],["سُخْطاً عَلَى الظُّلاّمِ أَقْ","دَرَ مَا نَكُونُ عَلَى الكَلِمْ",45,"م",1,0],["سَخِطَ المَلِيكُ عَلَيْهِ إِثْرَ نَصِيحَةٍ","فَاقْتَصَّ مِنْهُ غَوَايَةً وَضَلاَلاَ",46,"ل",2,0],["سَخِرْتُ بِكُلِّ مَشَّاءٍ بِهَجْرٍ","فَبَاءَ بِخَيْبَةٍ وَمَرِيرِ خَسْرِ",47,"ر",1,0],["سَخَّرَ الطِّبَّ لِلأَنَامِ جَمِيعاً","فَتَقَرَّاهُ فِي جَمِيعِ الجِهَاتِ",48,"ت",1,0],["سَخَّرَ الْفُلْكَ لهَا تُغْرِقُهَا","فَنَجَتْ وَالْغَوْرُ لاَ يُدْرِكُ سَبْرَا",49,"ر",2,0],["سَخَطوا عَلى الدُنيا لِعظمِ مصابِهِ","فَرَضوا بِحُكمِ مُقدِّرِ الأَشياءِ",50,"ا",2,0],["سَخُونُ الشِّتاءِ يُدْفِىء ُ القُرَّ مَسُّها","وفي الصَّيْفِ جَمَّاءُ العِظَامِ بَرُودُ",51,"د",1,0],["سخرت بالسّفينة اللّجة","الخضراء واختار قبره الربّان",52,"ن",1,0],["سُخطُك قَد زادَني سَقَامًا","فاِبعَث إِلَيَّ الرِِّضا مَسيحا",53,"ح",2,0],["سخية تبذل في ربها ال","لقمة باستحلاء إطعامها",54,"م",3,0],["سَخَاؤُكَ أفنَى كُلَّ مَا أنتَ كَاسِبٌ","ولَكِنَّهُ أبقَى مَحَامِدَ لاَ تفَنَى",55,"ن",2,0],["سُخطُه سهلٌ عليه هيّن","ويرى سخطَ الورى ما لا يطاقْ",56,"ق",1,0],["سخا بفرائد الأفراحِ دهري","وطرزت الربى بطرازِ زهرِ",57,"ر",1,1],["سَخِطنا فَلَمّا قُمتَ فينا مَقامَهُ","وَزِدتَ رَضينا أَن تُقيمَ وَيَرحَلا",58,"ل",2,0],["سَخَوا لَمّا اِنتَشَوا وَهَمى نَداهُ","وَما عَرَفَ النِدامَ وَلا المُداما",59,"م",2,0],["سَخاءٌ كَما فاضَ الأَتيُّ عَلى الثَرى","وَحُسنٌ كَما شُقَّ الغَمامُ عَنِ الشَمسِ",60,"س",1,0],["سخونة الجو وبرد ظلها","كسى النسيم لذة لا تنحصر",61,"ر",1,0],["سخطا من الله إن لم تستقل وتتب","فالله يغفر ذنب العبد إن يتب",62,"ب",1,0],["سُخفٌ وأَسخفُ منهُ وهو مَعجَزةٌ","وَضلَّهُ أَن يُسمَّوهُ بايمان",63,"ن",1,0],["سخيّ أبيّ لا يُطاق كفاحُه","وليسَ لهُ في ذا الزمانِ مِثَالُ",64,"ل",1,0],["سَخَوا وَسَطَوا فُهُم حَياةٌ","لِمَن يَرجوهُمُ وَهُمُ حِمامُ",65,"م",1,0],["سَخيَت مِنكَ جُفونٌ","كُنَّ قِدماً بُخَلاءا",66,"ا",3,0],["سَخَاءَكَ إِنَّ عِرْضَكَ لَيْسَ يُنْقِي","وَبِذَلِكَ لاَ يُجِيبُ أَخَا اصْطِرَاخِ",67,"خ",1,0],["سَخَا بِالنَّفْسِ شُحّاً بِالْمَعَالِي","وَجَاهَدَ بِالطَّرِيفِ وَبِالتِّلاَدِ",68,"د",1,0],["سَخِيٌّ بِتَعذيبِ المُحِبِّ وَإِنَّهُ","عَلى عاشِقِيهِ بِالوِصالِ لَباخِلُ",69,"ل",1,0],["سخط ناجز وحلم بطيء","وسلاح للوخز فينا صقيله",70,"ل",2,0],["سَخافَةَ العَقلِ في جَميعِ الكَلامِ سَدى","وَأَحسَنُ القَولِ ماتَرجي نَتيجَتُهُ",71,"ت",2,0],["سخِرَ الزمانُ به فعا","شَ على البقيّة من مُناه",72,"ه",1,0],["سخر المجد منكم والأماني","وعلت صفحة السماء جراح",73,"ح",1,0],["سخر العدو وفي مرارة سخره","عبث السراب الخادع الخلاب",74,"ب",1,0],["سخريات امرها في ه","ذه الدنيا عجاب",75,"ب",1,0],["سخرت للحنش المرجوم ذا جششٍ","كل البريةِ مهزوم",76,"م",1,0],["سَخَّرتني لَكَ المَكارم يا مَن","سعدت في مَديحِهِ الشُعَراءُ",77,"ا",2,0],["سَخِطَ النَبيُّ على البريء وما درى","مِمّا جَناهُ الآفِكُ الكذّاب",78,"ب",1,0],["سخر اللّه للإِمام أناساً","يصدمون الأبطال بالأبطال",79,"ل",1,0],["سخَّر الجن مع الإِنس له","وطيور الجو من كل مقر",80,"ر",1,0],["سُخطُكَ الحَتفُ حينَ تَسخَطُ وَالغُن","مُ إِذا ما رَضيتَ يَوماً رَضاكا",81,"ك",2,0],["سخط الحسود بما به من سالم","رضي الإِله الواحد المعبود",82,"د",1,0],["سخيّ شجاع لا يضاهى وإنما","يسود الفتى من حيث يسمو ويشجع",83,"ع",1,0],["سخا بك فعل الثابتين المعزز","يدك عروش الفاسقين المعجزِ",84,"ز",1,1],["سَخرَت من الأحداثِ حتى أخرست","مُتصِّلفاً وأتت عل المتحامِق",85,"ق",1,0],["سُخنَةٌ في الشِتاءِ بارِدَةُ الصَيفِ","سَراجٌ في اللَيلَةِ الظَلماءِ",86,"ا",2,1],["سُخِّرتْ لي فأطاعت إمرتي","بعد أن شَقّت على الناس عَصَاها",87,"ا",3,0],["سخا بهِمُ أنَّ السخاءَ شجاعةٌ","وشجّعهم أنَّ الشجاعةَ جودُ",88,"د",1,0],["سخوا ولم تَبْنِ عليهم طيّىءٌ","وفصُحوا ولم تلدهم نَجْدُ",89,"د",1,0],["سخوتُ بشعري قبلَ مدحك لاقياً","بِسَبطِ كلامي كلَّ ذي نائلٍ جعدِ",90,"د",1,0],["سخوتُ له بالمدح حُباً وقُرْبةً","فلا بالنَّدى يلوي ولا أنا أكذبُ",91,"ب",1,0],["سخي فنزه عن لئم محله","نتوج فرفعه عن الأنمل العقم",92,"م",1,0],["سخي على جود الزمان ومنعه","قريب على قرب المطالب والبعد",93,"د",1,0],["سخطَ الأنام على الزمان وصرفهِ","ورضى الخلائقِ غايةٌ لا تدرك",94,"ك",1,0],["سخطه في مديحةٍ وسؤالٍ","ورضاهُ في خلوةٍ وغلام",95,"م",1,0],["سخطهُ في الحروب نارُ جحيمٍ","ورضاهُ في السّلم جنّةُ خلد",96,"د",1,0],["سَخَطتَ وَلَم أُذنِب وَتَرضى مُخالِفاً","كَأَنّي أَخو ذَنبٍ فَفِعلُكَ مُعجِبُ",97,"ب",1,1],["سَخطُ المال مِن أَكفِكُم ما","حَمَدَتهُ السُيوفُ وَالأَقلامُ",98,"م",1,0],["سَخِيٌّ هاشميُّ الطَّوْرِ ماجَتْ","على ساحاتِهِ سُحْبُ الضُّيوفِ",99,"ف",1,0],["سخِّرْ أراضيك للاعداء يلتهِموا","ما ظلّ من أُمّةٍ أنهكها الطّرَبُ",100,"ب",1,0],["سخنت بالبعاد عنك عيون","كنت حياً وطرفهن قرير",101,"ر",1,0],["سَخاءَكَ إِنّي لَم أُناجيكَ في المُنى","فَتُرجِعَني إِلّا بِنائِلِكَ الجَزلِ",102,"ل",1,0],["سَخِرَتْ بهم أَوْهَامُهم","هُزْءاً وبالأَوهام هَامُوا",103,"م",3,0],["سخا بما ليس يسخو الأَسخياءُ به","بالمالِ والجاه والأَيام والدول",104,"ل",1,0]]}