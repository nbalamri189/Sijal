.com/ViewPoem.aspx?id=199003",""],[5409,"طرق الباب حالماً بلقاها","https://www.poetsgate.com/ViewPoem.aspx?id=155363",""],[5431,"قانون الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=183014",""],[5431,"تُضاء بنا الأكوان حبا ولن نُطفا","https://www.poetsgate.com/ViewPoem.aspx?id=193477",""],[5431,"حول الحرام ترى اللسان مطقطقا","https://www.poetsgate.com/ViewPoem.aspx?id=197841",""],[5431,"هو الحبّ...","https://www.poetsgate.com/ViewPoem.aspx?id=211520",""],[5431,"كيف تنجو بخبثها الأشرارُ؟...","https://www.poetsgate.com/ViewPoem.aspx?id=211836",""],[5476,"وَاسْتَقَالَ الْمَلَّاحُ","https://www.poetsgate.com/ViewPoem.aspx?id=194683",""],[5561,"أطلِقْ عنانَكَ","https://www.poetsgate.com/ViewPoem.aspx?id=192746",""],[5561,"مُسامِرُ الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=194728",""],[5582,"سَلْ الأَظْعانَ إِنْ مَرَّتْ","https://www.poetsgate.com/ViewPoem.aspx?id=187212",""],[5605,"ستُونَ عَامًا","https://www.poetsgate.com/ViewPoem.aspx?id=160307",""],[5605,"نصيحة !!","https://www.poetsgate.com/ViewPoem.aspx?id=160814",""],[5628,"مغترب يصف حاله","https://www.poetsgate.com/ViewPoem.aspx?id=178540",""],[5732,"لولا الهرم والفقر والثالث الموت","https://www.poetsgate.com/ViewPoem.aspx?id=177867",""],[5770,"الفجر موعده اقترب","https://www.poetsgate.com/ViewPoem.aspx?id=178700",""],[5781,"قارئ كفّ","https://www.poetsgate.com/ViewPoem.aspx?id=208937",""],[402,"سجدوا لكسرى إذ بدا إجلالا","https://www.poetsgate.com/ViewPoem.aspx?id=36216",""],[5853,"((القضاة الأربعة ؟ )))","https://www.poetsgate.com/ViewPoem.aspx?id=175665",""],[5861,"هو الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=188032",""],[5956,"أبطال فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=192326",""],[5956,"الفخر بالابن فراس","https://www.poetsgate.com/ViewPoem.aspx?id=192387",""],[5956,"سخّرْتَ وقتك لنجدتنا","https://www.poetsgate.com/ViewPoem.aspx?id=193506",""],[5956,"أعانك الله في ترتيب أنفسكم","https://www.poetsgate.com/ViewPoem.aspx?id=193864",""],[5956,"سنَدُ الصديق","https://www.poetsgate.com/ViewPoem.aspx?id=194378",""],[5956,"أ تأتي الإمارات يا صالح؟","https://www.poetsgate.com/ViewPoem.aspx?id=194595",""],[5970,"ذرة ما بين أرض وسماء","https://www.poetsgate.com/ViewPoem.aspx?id=130581",""],[6002,"في موضع للسالك","https://www.poetsgate.com/ViewPoem.aspx?id=211682",""],[6069,"وكم ليلةٍ عاطاني الراح بدرها","https://www.poetsgate.com/ViewPoem.aspx?id=105687",""],[6082,"تبَا كفى","https://www.poetsgate.com/ViewPoem.aspx?id=58844",""],[6093,"بان لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=176082",""],[6093,"إحالة جواب","https://www.poetsgate.com/ViewPoem.aspx?id=204761",""],[6148,"أشواق القبة الخضراء","https://www.poetsgate.com/ViewPoem.aspx?id=202096",""],[242,"أقول لمن يصيخ الى اصطراخ","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563805",""],[6202,"يا أبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86763&r=&rc=64",""],[6202,"رجاء جديد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86724&r=&rc=25",""],[3155,"الأريج القديم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75609&r=&rc=32",""],[6237,"رمضان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77859&r=&rc=1",""],[463,"حاشاك من عارية ٍ تردُّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60023&r=&rc=79",""],[6319,"الجنوب الصعب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86563&r=&rc=5",""],[6355,"من أنا؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66590&r=&rc=50",""]],"verses":[["سَخا لَكَ مِن ريحِ الزَفيرِ بِحاصِبٍ","مُقيمٍ وَمِن ماءِ الشُؤونِ بِوادِقِ",0,"ق",1,0],["سَخِطَ الغُرابُ عَلى المَساقِطِ بَينَها","فَلَهُ بِإِنجازِ الفِراقِ نَعيقُ",1,"ق",1,0],["سُخطٌ لَوَ أَنَّ الطودَ يُرمى بِهِ","ساخَ عَنِ الأَطوادِ أَو خَفَّضا",2,"ض",2,0],["سَخِرَتْ بَدَائِعُهَا الَّتِي أَوْدَعْتَهَا","بِزَمَانِهَا هَذَا وَكُلَّ زَمَانِ",3,"ن",1,0],["سَخَّرَ العِلمَ لِيَبني آيَةً","فَوقَ شَطِّ النيلِ تَبدو كَالعَلَم",4,"م",1,1],["سَخِروا مِنَ الفَضلِ الَّذي أوتيتَهُ","وَاللَهُ يَسخَرُ مِنهُمُ في النارِ",5,"ر",1,0],["سَخاوِيَّ أَفلالِ تَبيتُ بِجَوزِها","مِنَ القَفرِ وَالإِقواءِ تَعوي عَواسِلُه",6,"ل",2,0],["سَخاويَّ ماتَت فَوقَها كُلِّ هَبوَةٍ","مِنَ القَيظِ وَاِعَتَّمت بِهِنَّ الحَزاوِرُ",7,"ر",1,0],["سخّرت من أوتاره ما لم يكن","ليطيع غيرك قطّ في تسخيره",8,"ر",2,0],["سخنت كحمّام عليكَ مدامعي","لما رزِئت بكوكبٍ وقَّاد",9,"د",1,0],["سخت ومحت شكوى قتادة فاغْتدت","بها العينُ تجري إذ بها العين تجبر",10,"ر",1,0],["سخّاه عن رُزءِ ذاك أنَّ له","حُسناً إذا قاسه به غمره",11,"ر",2,0],["سخرتُ فيك هجائي بعد ما ذَئِرتْ","منك القوافي وقِدْماً عيفت القُذَر",12,"ر",1,0],["سخطت على مهندسك الملقّى","وما هو كفءُ سخطك بالضمير",13,"ر",1,0],["سُخِّر الفيلُ وهُوَ أعظم مني","لضئيل الرجال يركب ظهره",14,"ر",2,0],["سخِطَ الإله على أُولَ","ئك إنهم من شر غرسه",15,"س",2,0],["سخطُوا مودَّتَهُم وخانُوا جارَهُم","لا فارقَ الأَوداجَ مُدْيةُ ساحط",16,"ط",1,0],["سخْلةٌ ما عَدَتْ فراشك لكن","لم تكُن قطُّ من بناتِ فراشِك",17,"ك",1,0],["سَخَّرَ العِلمُ لَهُم حَتّى الغُيوم","فَهُم مِثلَهُمُ فَوقَ الصَعيد",18,"د",1,0],["سَخرْتَ بأَنَّاتِ شَعْبٍ ضَعيفٍ","وكَفُّكَ مخضوبَةٌ من دمَاهْ",19,"ه",1,0],["سَخَافةٌ دُنياكُمُ هذه","تائهةٌ في ظلمةٍ لا تُحَدْ",20,"د",1,0],["سُخطُك قَد زادَني سَقاما","فاِبعَث إِلَيَّ الرِضى مسيحا",21,"ح",2,0],["سخت في حمأته","وتعدّت ارجلك",22,"ك",1,0],["سَخَّرَهُ اللَهُ لَكا","وَلِلعِبادِ قَبلَكا",23,"ك",2,0],["سُخِّرَ العالَمُ مِن أَرضٍ وَماء","لَكَ وَالريحُ وَما تَحتَ السَماء",24,"ا",2,0],["سَخِروا مِنَ الدُنيا كَما سَخِرَت بِهِم","وَاِنبَتَّ مِن أَسبابِها المُتَعَلَّقُ",25,"ق",1,0],["سُخِّرَ الناسُ وَإِن لَم يَشعُروا","لِقَوِيٍّ أَو غَنِيٍّ أَو مُبين",26,"ن",1,0],["سخّر أفلاكهم لأمرهمُ","نجومَها السائراتِ والشهبا",27,"ب",2,0],["سَخاوَةٌ مِن نَدى مَروانَ أَعرِفُها","وَالطَعنِ لِلخَيلِ في أَكتافِها زَوَرُ",28,"ر",1,0],["سَخا طَلَباً لِلوِترِ نَفساً بِمَوتِهِ","فَماتَ كَريماً عائِفاً لِلمَلائِمِ",29,"م",1,0],["سخره الخضر لابن خالته","يحمل قطرا لسد يأجوج",30,"ج",1,0],["سخاءٌ بهجرٍ من سمينٍ مُدَمْلَجٍ","وشُحٌّ بوصلٍ مِنْ هَزِيلٍ مُوَشَّحِ",31,"ح",1,0],["سخيّة بالسكر مَرّتْ على","دنانِها بالختم أيْدٍ شحاح",32,"ح",1,0],["سَخِطَت لَهاهُ عَلى جَداهُ سَخطَةً","فَاِستَرفَدَت أَقصى رِضا المُستَرفِدِ",33,"د",1,0],["سَخِنَت عَيني لَئِن عُدتَ لَها","لَتَمُدَّنَّ بِحَبلٍ مُنبَتِر",34,"ر",1,0],["سُخنَةُ المَشتى لِحافٌ لِلفَتى","تَحتَ لَيلٍ حينَ يَغشاهُ الصَرَد",35,"د",1,0],["سَخِرَت بِالنَجمِ هِمَّتُهُ","وَاِزدَرَت يُمناهُ بِالدِيَمِ",36,"م",1,0],["سَخِرَ الوُلاةُ بِنا فَساروا سيرَةً","مَلَأَت لَنا خِزياً وَفاضَت عارا",37,"ر",2,0],["سَخِيُّ النَّفسِ والهيجاءُ تَغلِي","فتملأ أَنْفُسَ الشُّجعانِ شُحّا",38,"ح",2,0],["سَخونُ الشِتاءِ يُدفِئُ القُرَّ مَسُّها","وَفي الصَيفِ جَمّاءُ العِظامِ بَرودُ",39,"د",1,0],["سَخَطتُم عَلى اللَهِ العَظيمِ قَضائَهُ","سَيَمضي بِما فيهِ إِذا كَثُرَ اللَغطُ",40,"ط",1,0],["سَخَّرَ اللَهُ لِلأَمينِ مَطايا","لَم تُسَخَّر لِصاحِبِ المِحرابِ",41,"ب",1,1],["سُخِّنتَ مِن شِدَّةِ البُرودَةِ حَت","تى صِرتَ عِندي كَأَنَّكَ النارُ",42,"ر",1,0],["سُخامِيَّةٌ لَم يَقطَعِ السِنُّ مَتنَها","لَها مُذ ثَوَت في دَنِّها سَنَتانِ",43,"ن",1,0],["سَخوا لِيَقولَ الناسُ جادوا وَأَقدَموا","لِيُذكَرَ في الهَيجاءِ قِرنٌ مَنازِلُ",44,"ل",1,0],["سَخِطْنَ فَلاَ يَرَيْنَهُمُ بَوَاءً","ولاَ يَنْزِعْنَ حَتَّى يَغْتَدِينَا",45,"ن",2,0],["سَخَاخاً يُزَجِّي الذِّئْبُ بَيْنَ سُهُوبِهَا","وفَحْلُ النَّعَامِ رِزُّهُ وأَزَامِلُهْ",46,"ل",2,0],["سُخْطاً عَلَى الظُّلاّمِ أَقْ","دَرَ مَا نَكُونُ عَلَى الكَلِمْ",47,"م",1,0],["سَخِطَ المَلِيكُ عَلَيْهِ إِثْرَ نَصِيحَةٍ","فَاقْتَصَّ مِنْهُ غَوَايَةً وَضَلاَلاَ",48,"ل",2,0],["سَخِرْتُ بِكُلِّ مَشَّاءٍ بِهَجْرٍ","فَبَاءَ بِخَيْبَةٍ وَمَرِيرِ خَسْرِ",49,"ر",1,0],["سَخَّرَ الطِّبَّ لِلأَنَامِ جَمِيعاً","فَتَقَرَّاهُ فِي جَمِيعِ الجِهَاتِ",50,"ت",1,0],["سَخَّرَ الْفُلْكَ لهَا تُغْرِقُهَا","فَنَجَتْ وَالْغَوْرُ لاَ يُدْرِكُ سَبْرَا",51,"ر",2,0],["سَخَطوا عَلى الدُنيا لِعظمِ مصابِهِ","فَرَضوا بِحُكمِ مُقدِّرِ الأَشياءِ",52,"ا",2,0],["سَخُونُ الشِّتاءِ يُدْفِىء ُ القُرَّ مَسُّها","وفي الصَّيْفِ جَمَّاءُ العِظَامِ بَرُودُ",53,"د",1,0],["سخرت بالسّفينة اللّجة","الخضراء واختار قبره الربّان",54,"ن",1,0],["سُخطُك قَد زادَني سَقَامًا","فاِبعَث إِلَيَّ الرِِّضا مَسيحا",55,"ح",2,0],["سخية تب