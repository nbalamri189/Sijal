{"poems":[[53,"ألا يا لقومي للخطوب الطوارق","https://www.aldiwan.net/poem29952.html","الطويل"],[53,"يا دار ما طربت إليك النوق","https://www.aldiwan.net/poem29956.html","الكامل"],[53,"كيف أضاء البرق إذ أومضا","https://www.aldiwan.net/poem30175.html","السريع"],[77,"ذكروا العهود فهاج من أشجاني","https://www.aldiwan.net/poem36070.html","الكامل"],[86,"سخر العلم ليبني آية","https://www.aldiwan.net/poem10359.html","الرمل"],[86,"إن صوروك فإنما قد صوروا","https://www.aldiwan.net/poem68950.html","الكامل"],[30,"عفا الزرق من مي فمحت منازله","https://www.aldiwan.net/poem29545.html","الطويل"],[30,"لمية أطلال بحزوى دوائر","https://www.aldiwan.net/poem29586.html","الطويل"],[88,"الشعر بعد مصابه بكبيره","https://www.aldiwan.net/poem45040.html","الطويل"],[72,"قف بالحمى بعد البدور وناد","https://www.aldiwan.net/poem18572.html","الكامل"],[72,"صحا القلب لولا نسمة تتخطر","https://www.aldiwan.net/poem18693.html","الطويل"],[51,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[51,"لا يغضبن لعمرو من له خطر","https://www.aldiwan.net/poem62965.html","البسيط"],[51,"تلق نصيحتي يا ابن الوزير","https://www.aldiwan.net/poem62978.html","الوافر"],[51,"أسأت فأحسن بي جهده","https://www.aldiwan.net/poem64067.html","المتقارب"],[51,"لا تقصدن لحاجة","https://www.aldiwan.net/poem64582.html","مجزوء الكامل"],[51,"أشجتك منزلة بمرجي راهط","https://www.aldiwan.net/poem65022.html","الكامل"],[51,"بينما أنت في احتيال فياشك","https://www.aldiwan.net/poem65818.html","الخفيف"],[91,"طوي العام كما يطوى الرقيم","https://www.aldiwan.net/poem8820.html","عموديه"],[92,"ألا أيها الظالم المستبد","https://www.aldiwan.net/poem38895.html","المتقارب"],[92,"لو كانت الأيام في قبضتي","https://www.aldiwan.net/poem38924.html","السريع"],[78,"مولاي أشكو إليك داء","https://www.aldiwan.net/poem14151.html","مخلع البسيط"],[89,"إن من قد جبلك","https://www.aldiwan.net/poem44848.html","مجزوء المديد"],[85,"الحيوان خلق له عليك حق","https://www.aldiwan.net/poem7932.html","مجزوء الرجز"],[85,"أحمدك الله وأطري الأنبياء","https://www.aldiwan.net/poem8099.html","الرمل"],[85,"جرح على جرح حنانك جلق","https://www.aldiwan.net/poem62839.html","الكامل"],[85,"قف على كنز بباريس دفين","https://www.aldiwan.net/poem63736.html","الرمل"],[62,"يا قاتل الله معشرا ظلموا الحكمة","https://www.aldiwan.net/poem52237.html","المنسرح"],[28,"فأعقب الله ظلا فوقه ورق","https://www.aldiwan.net/poem5054.html","البسيط"],[28,"لله يربوع ألما تكن لها","https://www.aldiwan.net/poem5536.html","الطويل"],[61,"درجني الحرف أي تدريج","https://www.aldiwan.net/poem51376.html","المنسرح"],[80,"رقيقة ماء الحسن يجري بخدها","https://www.aldiwan.net/poem31506.html","الطويل"],[80,"من شاء أن تسكر راح براح","https://www.aldiwan.net/poem31514.html","السريع"],[44,"كشف الغطاء فأوقدي أو أخمدي","https://www.aldiwan.net/poem30545.html","الكامل"],[31,"آذنت هند ببين مبتكر","https://www.aldiwan.net/poem42521.html","الرمل"],[31,"ليت هندا أنجزتنا ما تعد","https://www.aldiwan.net/poem42576.html","الرمل"],[74,"قل لمسرى الريح من إضم","https://www.aldiwan.net/poem13255.html","المديد"],[105,"هواك هواك والدنيا شؤون","https://www.aldiwan.net/poem43372.html","الوافر"],[105,"خزاعة أبشري بالعهد سمحا","https://www.aldiwan.net/poem44065.html","الوافر"],[22,"ألا طرقت هند الهنود وصحبتي","https://www.aldiwan.net/poem22008.html","الطويل"],[52,"ألا تريان البرق ما هو صانع","https://www.aldiwan.net/poem26872.html","الطويل"],[48,"سخر الله للأمين مطايا","https://www.aldiwan.net/poem62423.html","الخفيف"],[48,"قل لزهير إذا اتكا وشدا","https://www.aldiwan.net/poem63391.html","المنسرح"],[48,"وخمر كعين الديك صبحت سحرة","https://www.aldiwan.net/poem65292.html","الطويل"],[46,"إذا ما الردينيات جارت سمت لها","https://www.aldiwan.net/poem23127.html","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55303","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55160","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54836","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54656","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43659","الكامل"],[22,"ألا طرقت هندُالهنود وصحبتي","https://www.poetsgate.com/ViewPoem.aspx?id=19727",""],[78,"مَولايَ أَشكو إِلَيكَ داءً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86544&r=&rc=89",""]],"verses":[["سَخا لَكَ مِن ريحِ الزَفيرِ بِحاصِبٍ","مُقيمٍ وَمِن ماءِ الشُؤونِ بِوادِقِ",0,"ق",1,0],["سَخِطَ الغُرابُ عَلى المَساقِطِ بَينَها","فَلَهُ بِإِنجازِ الفِراقِ نَعيقُ",1,"ق",1,0],["سُخطٌ لَوَ أَنَّ الطودَ يُرمى بِهِ","ساخَ عَنِ الأَطوادِ أَو خَفَّضا",2,"ض",2,0],["سَخِرَتْ بَدَائِعُهَا الَّتِي أَوْدَعْتَهَا","بِزَمَانِهَا هَذَا وَكُلَّ زَمَانِ",3,"ن",1,0],["سَخَّرَ العِلمَ لِيَبني آيَةً","فَوقَ شَطِّ النيلِ تَبدو كَالعَلَم",4,"م",1,1],["سَخِروا مِنَ الفَضلِ الَّذي أوتيتَهُ","وَاللَهُ يَسخَرُ مِنهُمُ في النارِ",5,"ر",1,0],["سَخاوِيَّ أَفلالِ تَبيتُ بِجَوزِها","مِنَ القَفرِ وَالإِقواءِ تَعوي عَواسِلُه",6,"ل",2,0],["سَخاويَّ ماتَت فَوقَها كُلِّ هَبوَةٍ","مِنَ القَيظِ وَاِعَتَّمت بِهِنَّ الحَزاوِرُ",7,"ر",1,0],["سخّرت من أوتاره ما لم يكن","ليطيع غيرك قطّ في تسخيره",8,"ر",2,0],["سخنت كحمّام عليكَ مدامعي","لما رزِئت بكوكبٍ وقَّاد",9,"د",1,0],["سخت ومحت شكوى قتادة فاغْتدت","بها العينُ تجري إذ بها العين تجبر",10,"ر",1,0],["سخّاه عن رُزءِ ذاك أنَّ له","حُسناً إذا قاسه به غمره",11,"ر",2,0],["سخرتُ فيك هجائي بعد ما ذَئِرتْ","منك القوافي وقِدْماً عيفت القُذَر",12,"ر",1,0],["سخطت على مهندسك الملقّى","وما هو كفءُ سخطك بالضمير",13,"ر",1,0],["سُخِّر الفيلُ وهُوَ أعظم مني","لضئيل الرجال يركب ظهره",14,"ه",1,0],["سخِطَ الإله على أُولَ","ئك إنهم من شر غرسه",15,"س",2,0],["سخطُوا مودَّتَهُم وخانُوا جارَهُم","لا فارقَ الأَوداجَ مُدْيةُ ساحط",16,"ط",1,0],["سخْلةٌ ما عَدَتْ فراشك لكن","لم تكُن قطُّ من بناتِ فراشِك",17,"ك",1,0],["سَخَّرَ العِلمُ لَهُم حَتّى الغُيوم","فَهُم مِثلَهُمُ فَوقَ الصَعيد",18,"د",1,0],["سَخرْتَ بأَنَّاتِ شَعْبٍ ضَعيفٍ","وكَفُّكَ مخضوبَةٌ من دمَاهْ",19,"ه",1,0],["سَخَافةٌ دُنياكُمُ هذه","تائهةٌ في ظلمةٍ لا تُحَدْ",20,"د",1,0],["سُخطُك قَد زادَني سَقاما","فاِبعَث إِلَيَّ الرِضى مسيحا",21,"ح",2,0],["سخت في حمأته","وتعدّت ارجلك",22,"ك",1,0],["سَخَّرَهُ اللَهُ لَكا","وَلِلعِبادِ قَبلَكا",23,"ك",2,0],["سُخِّرَ العالَمُ مِن أَرضٍ وَماء","لَكَ وَالريحُ وَما تَحتَ السَماء",24,"ا",2,0],["سَخِروا مِنَ الدُنيا كَما سَخِرَت بِهِم","وَاِنبَتَّ مِن أَسبابِها المُتَعَلَّقُ",25,"ق",1,0],["سُخِّرَ الناسُ وَإِن لَم يَشعُروا","لِقَوِيٍّ أَو غَنِيٍّ أَو مُبين",26,"ن",1,0],["سخّر أفلاكهم لأمرهمُ","نجومَها السائراتِ والشهبا",27,"ب",2,0],["سَخاوَةٌ مِن نَدى مَروانَ أَعرِفُها","وَالطَعنِ لِلخَيلِ في أَكتافِها زَوَرُ",28,"ر",1,0],["سَخا طَلَباً لِلوِترِ نَفساً بِمَوتِهِ","فَماتَ كَريماً عائِفاً لِلمَلائِمِ",29,"م",1,0],["سخره الخضر لابن خالته","يحمل قطرا لسد يأجوج",30,"ج",1,0],["سخاءٌ بهجرٍ من سمينٍ مُدَمْلَجٍ","وشُحٌّ بوصلٍ مِنْ هَزِيلٍ مُوَشَّحِ",31,"ح",1,0],["سخيّة بالسكر مَرّتْ على","دنانِها بالختم أيْدٍ شحاح",32,"ح",1,0],["سَخِطَت لَهاهُ عَلى جَداهُ سَخطَةً","فَاِستَرفَدَت أَقصى رِضا المُستَرفِدِ",33,"د",1,0],["سَخِنَت عَيني لَئِن عُدتَ لَها","لَتَمُدَّنَّ بِحَبلٍ مُنبَتِر",34,"ر",1,0],["سُخنَةُ المَشتى لِحافٌ لِلفَتى","تَحتَ لَيلٍ حينَ يَغشاهُ الصَرَد",35,"د",1,0],["سَخِرَت بِالنَجمِ هِمَّتُهُ","وَاِزدَرَت يُمناهُ بِالدِيَمِ",36,"م",1,0],["سَخِرَ الوُلاةُ بِنا فَساروا سيرَةً","مَلَأَت لَنا خِزياً وَفاضَت عارا",37,"ر",2,0],["سَخِيُّ النَّفسِ والهيجاءُ تَغلِي","فتملأ أَنْفُسَ الشُّجعانِ شُحّا",38,"ح",2,0],["سَخونُ الشِتاءِ يُدفِئُ القُرَّ مَسُّها","وَفي الصَيفِ جَمّاءُ العِظامِ بَرودُ",39,"د",1,0],["سَخَطتُم عَلى اللَهِ العَظيمِ قَضائَهُ","سَيَمضي بِما فيهِ إِذا كَثُرَ اللَغطُ",40,"ط",1,0],["سَخَّرَ اللَهُ لِلأَمينِ مَطايا","لَم تُسَخَّر لِصاحِبِ المِحرابِ",41,"ب",1,1],["سُخِّنتَ مِن شِدَّةِ البُرودَةِ حَت","تى صِرتَ عِندي كَأَنَّكَ النارُ",42,"ر",1,0],["سُخامِيَّةٌ لَم يَقطَعِ السِنُّ مَتنَها","لَها مُذ ثَوَت في دَنِّها سَنَتانِ",43,"ن",1,0],["سَخوا لِيَقولَ الناسُ جادوا وَأَقدَموا","لِيُذكَرَ في الهَيجاءِ قِرنٌ مَنازِلُ",44,"ل",1,0],["سُخْطاً عَلَى الظُّلاّمِ أَقْ","دَرَ مَا نَكُونُ عَلَى الكَلِمْ",45,"م",1,0],["سَخِطَ المَلِيكُ عَلَيْهِ إِثْرَ نَصِيحَةٍ","فَاقْتَصَّ مِنْهُ غَوَايَةً وَضَلاَلاَ",46,"ل",2,0],["سَخِرْتُ بِكُلِّ مَشَّاءٍ بِهَجْرٍ","فَبَاءَ بِخَيْبَةٍ وَمَرِيرِ خَسْرِ",47,"ر",1,0],["سَخَّرَ الطِّبَّ لِلأَنَامِ جَمِيعاً","فَتَقَرَّاهُ فِي جَمِيعِ الجِهَاتِ",48,"ت",1,0],["سَخَّرَ الْفُلْكَ لهَا تُغْرِقُهَا","فَنَجَتْ وَالْغَوْرُ لاَ يُدْرِكُ سَبْرَا",49,"ر",2,0],["سَخَطوا عَلى الدُنيا لِعظمِ مصابِهِ","فَرَضوا بِحُكمِ مُقدِّرِ الأَشياءِ",50,"ا",2,0],["سَخُونُ الشِّتاءِ يُدْفِىء ُ القُرَّ مَسُّها","وفي الصَّيْفِ جَمَّاءُ العِظَامِ بَرُودُ",51,"د",1,0],["سُخطُك قَد زادَني سَقَامًا","فاِبعَث إِلَيَّ الرِِّضا مَسيحا",52,"ح",2,0]]}