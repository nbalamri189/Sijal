",3,"ك",1,0],["بَطيؤونَ عَن داعي اللِقاءِ تَخالُهُم","إِذا ما دَعوا يَوماً مُرِمَّينَ هُجَّعا",4,"ع",2,0],["بِطَعنٍ كَوَلغِ الذِئبِ إِن زَعزَعَ القَنا","سَقاها شَآبيبَ الدِماءِ المَوائِرِ",5,"ر",1,0],["بِطَعنٍ كَدُفّاعِ الغَمامِ تَحُثُّهُ","ذَوابِلُ يُمطِرنَ الدِماءَ صَوائِبا",6,"ب",2,0],["بِطَرفٍ لا يُخَفَّضُ مِن خُضوعٍ","وَقَلبٍ لا يُتَعتَعُ مِن وَجيبِ",7,"ب",1,0],["بَطَلٍ كَأَنَّ ثِيابَهُ في سَرحَةٍ","يُحذى نِعالَ السِبتِ لَيسَ بِتَوأَمِ",8,"م",1,0],["بِطَعنٍ تُرعَدُ الأَبطالُ مِنهُ","لِشِدَّتِهِ فَتَجتَنِبُ القِتالا",9,"ل",2,0],["بِطَرفِهِ تُقسَمُ المَنايا","وَدَلِّهِ تَمرَضُ القُلوبُ",10,"ب",1,0],["بِطالِعِ يُمْنٍ صالَ في السّعْدِ شأوُهُ","فَما هوَ منْ عَمْرِو الرِّجالِ ولا زَيْدِ",11,"د",1,0],["بِطاهِرَةِ الأَثوابِ فاتِنَةِ الضُحى","مُسَبَّحَةِ الآناءِ مِحرابُها الخِدرُ",12,"ر",1,0],["بِطامٍ يَكِبُّ الفُلكَ حَولَ جَنابهِ","لَأَذقانِهِ مُعلَولِبَ المَدِّ يَرتَمي",13,"م",2,0],["بَطاحِيٌّ لَهُ نَسَبٌ مُصَفّى","وَأَخلاقٌ لَها عَرضٌ وَطولُ",14,"ل",1,0],["بِطَهَ قَدِيماً عظَّمَ الوَحْيُ شَأْنَها","وَطَهَ حَدِيثاً عَزَّزَ العِلْمُ شَأْنَهَا",15,"ن",3,0],["بِطُلَ النَّفْعِ لِلْبِلاَدِ إِذَا مَا","عُدَّ أَهْلُ الجَلاَّدِ فِي الأبْطَالِ",16,"ل",1,0],["بِطَعنٍ كَتَضريمِ الحَريقِ اِختِلاسُهُ","وَضَربٍ بِشطَباتٍ صَوافي الرَوانِقِ",17,"ق",1,0],["بطل الحرب مثله بطل السع","يِ ومنه الأعمال مثل الصيال",18,"ل",1,0],["بِطِخفَةَ ضارَبنا المُلوكَ وَخَيلُنا","عَشِيَّةَ بِسطامٍ جَرَينَ عَلى نَحبِ",19,"ب",1,0],["بِطَليحِ أَسفارٍ تَرَكنَ بَقِيَّةً","مِنها فَأَحنَقَ صُلبُها وَسَنامُها",20,"م",3,0],["بطعن كوقع سِراد النقال","يحاكي به الَّلَبة الأبجلُ",21,"ل",1,1],["بَطَحنا مِنهُمُ مَرجَ بنَ جَحشٍ","فَلَم يَقِفوا عَلَيهِ وَلَم يُحاموا",22,"م",3,0],["بِطَعنٍ كَإيزاعِ المَخاضِ رَشاشُهُ","وَضَربٍ يُزيلُ الهامَ مِن كُلِّ مَفرِقِ",23,"ق",1,0],["بَطَيبَةَ رَسمٌ لِلرَسولِ وَمَعهَدُ","مُنيرٌ وَقَد تَعفو الرُسومُ وَتَهمَدِ",24,"د",1,1],["بطالع السعد لا جدْيٌ ولا حملٌ","جازت مدى الشهب والغفران ما انتطحت",25,"ت",1,0],["بطن ساري الوحوش فما أب","رح في الموت الحياة مسافر",26,"ر",1,0],["بطباعه يزكو فكيف بطابعٍ","لثبوت أعناء على المتطبع",27,"ع",1,0],["بطيفك يا بدر والطارق","ومسبل شعرك والغاسق",28,"ق",1,1],["بطحاء مكة غرس المفرقين وفي","أعلام مصر ظلال الدَّوح والضال",29,"ل",1,0],["بطبِّ أبقراط وافى إليَّ","وراح ولكن بخفيّ حنين",30,"ن",1,0],["بطاووس بستانٍ يدور وينجلي","وينفُض عن أرياشه بللَ القطر",31,"ر",1,0],["بطاءً عن المبتغِي نصرَهم","إلى أن يغادَر شلواً أَكيلا",32,"ل",2,0],["بَطنُ يُمناكَ لنا زم","زمُ يغشاها الحِيامُ",33,"م",1,0],["بطلُ الوقاحة لا الحياءِ كأنْ به","عن أن يخونَ أمانةً تهوين",34,"ن",1,0],["بَطَرُ الأَنامِ مِنَ السُرورِ وَعِندَهُم","إِنَّ السُرورَ مُرادِفُ العَنقاءِ",35,"ا",2,0],["بَطَشَت أَنامِلُها فَأَعوَزَ ساعِدٌ","وَأَعانَ ساعِدُها فَخانَ المَنكِبُ",36,"ب",1,0],["بطل النهضة الكبيرة في مصر","رئيس لحزب القوي الحفيل",37,"ل",1,0],["بطيئة حين امشي","بعقلي الخطوات",38,"ت",1,0],["بطرس من عبيدكا","والكل من جنودكا",39,"ك",2,0],["بطشت فلم تدع لهمو وجودا","وكان البطش إشفاقا وجودا",40,"د",2,0],["بَطَلَ الشَرقِ قَد بَكَتكَ المَعالي","وَرَثاكَ الوَلِيُّ وَالأَخصامُ",41,"م",1,0],["بَطَلُ المَوتِ في الرِوايَةِ رُكنٌ","بُنِيَت مِنهُ هَيكَلاً وَفُصولا",42,"ل",2,0],["بَطَلُ البَداوَةِ لَم يَكُن يَغزو عَلى","تَنَكٍ وَلَم يَكُ يَركَبُ الأَجواءَ",43,"ا",2,0],["بَطَلٌ حُقوقُ الشَرقِ مِن أَحمالِهِ","وَقَضِيَّةُ الإِسلامِ مِن أَعبائِهِ",44,"ا",3,0],["بَطَلُ الدَولَتَينِ حامى حِمى رو","ما الَّذي لا تَقودُهُ الأَهواءُ",45,"ا",2,0],["بِطَاوِيةِ الأَجَادِلِ أَوْ بُزَاةٍ","مُحَمِّجَةٍ لداهِيةٍ شَمُوسِ",46,"س",1,1],["بِطُلولٍ كَأَنَّهُنَّ نُجومٌ","في عِراصٍ كَأَنَّهُنَّ لَيالي",47,"ل",2,0],["بطن حديث وهو مستنبط","من أرضنا إن نجلت نجلا",48,"ل",2,0],["بِطَرائِقٍ كَطَرائِقٍ وَخَلائِقٍ","كَخَلائِقٍ وَضَرائِبٍ كَضَرائِبِ",49,"ب",1,0],["بَطَلٌ يَخوضُ الخَيلَ وَهيَ شَوائِلٌ","خَلفَ الأَسِنَّةِ وَهوَ غَيرُ مُدَجَّجِ",50,"ج",1,0],["بِطولِ ضَنى جِسمي بِكُم وَتَبَلُّدي","بِقُوَّةِ حُبِّيكُم وَضِعفِ تَجَلُّدي",51,"ي",1,1],["بِطَعنٍ دِراكٍ في النُحورِ يَحُطُّهُم","نَشاوى وَضَربٍ في جَماجِمِهِم هَبرُ",52,"ر",1,0],["بِطَولِكَ اِنحازَتِ الأَيّامُ راجِعَةً","عَن ساحَتي وَصُروفُ الدَهرِ مُنصَرَفا",53,"ف",2,0],["بِطَعنٍ يَكُبُّ الدارِعينَ دِراكُهُ","وَضَربٍ كَما تَرغو المُخَزَّمَةُ البُزلُ",54,"ل",1,0],["بِطِخفَةَ وَالرَيّانِ حَيثُ تَصَوَّبَت","عَلى جَعفَرٍ عِقبانُها وَنُسورُها",55,"ر",3,0],["بطَلٌ إذا لَقِيَ الكميَّ أَماتَه","قبلَ الطِّعانِ بطعَنةٍ مِن فيهِ",56,"ي",2,0],["بِطَويلِ النِجادِ ضَيَّقَ باعَ ال","عُذرِ سَمحٍ قَصيرِ عُمرِ الوُعودِ",57,"د",1,0],["بِطَرفٍ عَلا في قَبضِهِ الريحُ سابِحٌ","لَهُ أَربَعٌ تَحكي أَنامِلَ حاسِبِ",58,"ب",1,0],["بطل الأبطال من أرض الهرم","لبس الغار وجلّى وغنم",59,"م",1,1],["بطلاً يطول بذكره في سلمهِ","كصياله بحسامِهِ في المازقِ",60,"ق",1,0],["بَطَلٌ تَشْهَقُ مَنْ لهذمِهِ","في جباهِ الرّوعِ أفواهُ الجراح",61,"ح",1,0],["بِطَعنٍ في نُحورِهِمُ مَريدٌ","وَضَربٍ في رُؤوسِهِمُ عَنيدِ",62,"د",1,0],["بَطَشَت مِنهُم بِلُؤلُؤَةِ الغَوّا","صِ حُسناً وَدُميَةِ المِحرابِ",63,"ب",1,0],["بِطَعنَةٍ خَرقاءَ تَأتي عَلى","حَزامَةِ المُستَلئمِ الدارِعِ",64,"ع",1,0],["بطرفِها وقدِّها","يُذكر موسى والخضرْ",65,"ر",1,0],["بِطرفِها وقدِّها","نذكرُ موسى والخضِرْ",66,"ر",1,0],["بطرفِهِ في العاشقينَ سُلِّطا","وما أحدَّ سيفِهِ حينَ سطا",67,"ط",2,0],["بَطَلٌ جَرى الفَلَكُ المُحيطُ بِسَرجِهِ","وَاِستَلَّ صارِمَهُ يَدُ المِقدارِ",68,"ر",1,0],["بطلٌ ما اضطرمت نارُ الوغَى","وتَرامَى هَوْلُها إلا اضطَرمْ",69,"م",1,0],["بَطَلٌ مَضَى يَرمِي العُبابَ بِهِمَّةٍ","جَاشَتْ زَواخِرُها وبَأسٍ طَامِ",70,"م",1,0],["بَطلٌ تأهّبَ للجهادِ يُقيمُه","ومَضَى فلا خَوَرٌ ولا اسْتِسلامُ",71,"م",1,0],["بطلٌ أبصرتُ مجرى دمهِ","في جبينِ الشَّرقِ لمّا وجما",72,"م",2,0],["بَطلٌ تَوسّعَ في ميادينِ الوغَى","لمّا تضايقَ عن مَداهُ المأزِقُ",73,"ق",1,0],["بَطَلَ الكِنانةِ مَن لها ولأَهْلِها","يحمِي محارِمَها ويَكشِفُ عَارَها",74,"ر",3,1],["بَطلُ المفاوضةِ المخو","فُ ولَيْثُها الخَطِرُ النَيوبْ",75,"ب",1,0],["بَطِرَ المُلوكُ فَهَبَّ يَقمَعُ شَرَّهُم","طَبٌّ بِأَدواءِ المُلوكِ مُحَنَّكُ",76,"ك",1,0],["بِطاءٌ عَنِ الأَمرِ العَظيمِ كَأَنَّما","يَرَونَ بِهِ مَقضِيَّ مَوتٍ مُحَتَّمِ",77,"م",1,0],["بَطَلٌ يَرَى مَوْجَ المنايا حَوْلَهُ","فَعَزِيمَةٌ تَطفوا وقَلْبٌ يَرْسُبُ",78,"ب",1,0],["بَطَل