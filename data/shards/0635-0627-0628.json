{"poems":[[79,"هل كنت تعلم في هبوب الريح","https://www.aldiwan.net/poem36635.html","الكامل"],[79,"صاب مزن الدموع من جفن صبك","https://www.aldiwan.net/poem36705.html","الخفيف"],[95,"يا لعهد الصبا تقضي وشيكا","https://www.aldiwan.net/poem9159.html","الخفيف"],[23,"رحم الله نافع ابن بديل","https://www.aldiwan.net/poem21304.html","الخفيف"],[23,"صابت شعائره بصرى وفي رمح","https://www.aldiwan.net/poem21371.html","البسيط"],[53,"نكهت شنطف ففاح كنيف","https://www.aldiwan.net/poem65728.html","الطويل"],[47,"يا أبا نهشل نداء غريب","https://www.aldiwan.net/poem10891.html","الخفيف"],[68,"صرف المدام به السرور مخصص","https://www.aldiwan.net/poem38488.html","الكامل"],[68,"أطعت داعي الهوى رغما على العاصي","https://www.aldiwan.net/poem40648.html","البسيط"],[82,"قبس بكف مديرها أم كوكب","https://www.aldiwan.net/poem31239.html","الكامل"],[76,"قل لمسرى الريح من إضم","https://www.aldiwan.net/poem13255.html","المديد"],[107,"اشهدي يا مصر أعمال البنين","https://www.aldiwan.net/poem43070.html","الرمل"],[111,"نكس العلام يا خير الملل","https://www.poetsgate.com/ViewPoem.aspx?id=67046",""],[92,"ليت الذي بك في وقع النوائب بي !","https://www.poetsgate.com/ViewPoem.aspx?id=179093",""],[193,"سيد الرسل قدره معلوم","https://www.aldiwan.net/poem35108.html","الخفيف"],[240,"دار الهوى بين اللوى وشراف","https://www.aldiwan.net/poem31818.html","الكامل"],[242,"يا أبا يعزى يا معز الناس","https://www.aldiwan.net/poem19703.html","الخفيف"],[308,"لله قوم حموني","https://www.aldiwan.net/poem57698.html","المجتث"],[310,"عظم الأجر عن عظيم المصاب","https://www.aldiwan.net/poem56609.html","الكامل"],[343,"صابر الدهر على كر النوائب","https://www.aldiwan.net/poem68827.html","الرمل"],[369,"بعد الصباح الذي ودعتكم فيه","https://www.aldiwan.net/poem60602.html","البسيط"],[376,"جمرات الهوى بمثلك تصلى","https://www.aldiwan.net/poem57227.html","الطويل"],[376,"لم تستمع سره من كل ملتمس","https://www.aldiwan.net/poem57354.html","البسيط"],[435,"صابر على الأخطار في طلب العلى","https://www.aldiwan.net/poem40724.html","الكامل"],[445,"الله جارك ظاعنا ومقيما","https://www.aldiwan.net/poem34799.html","الكامل"],[463,"حب إليها بالغضا مرتبعا","https://www.aldiwan.net/poem56125.html","السريع"],[463,"لي عند ظبي الأجرع","https://www.aldiwan.net/poem56126.html","مجزوء الرجز"],[543,"لا مصاب في هذه الدنياء","https://www.aldiwan.net/poem48312.html","عموديه"],[563,"لي وجود بمن يقول أنا","https://www.aldiwan.net/poem33776.html","الخفيف"],[621,"","https://poetry.dctabudhabi.ae/diwan/poem/198590","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48811","الخفيف"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199599","المسحوب"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199593","المسحوب"],[880,"","https://poetry.dctabudhabi.ae/diwan/poem/34764","الرمل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/71001","السريع"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55921","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56126","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64712","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79875","الرجز"],[2140,"","https://poetry.dctabudhabi.ae/diwan/poem/31480","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53108","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27648","الرمل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104975","الرجز"],[2346,"","https://poetry.dctabudhabi.ae/diwan/poem/18017","الخفيف"],[2467,"","https://poetry.dctabudhabi.ae/diwan/poem/111699","الخفيف"],[2496,"","https://poetry.dctabudhabi.ae/diwan/poem/100437","الكامل"],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84524","الكامل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76062","المديد"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112582","الرمل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139907","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48312","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205548","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216811","الكامل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81298","الخفيف"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133155","المجتث"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147290","الرمل"],[4702,"الوقت ياعزام بانت غوايبه","https://www.poetsgate.com/ViewPoem.aspx?id=155114",""],[4702,"كارثة سيول جدة .. 30 / 1 / 2011م","https://www.poetsgate.com/ViewPoem.aspx?id=155464",""],[4715,"صباح الخير","https://www.poetsgate.com/ViewPoem.aspx?id=208558",""],[4767,"السيرة العظيمة","https://www.poetsgate.com/ViewPoem.aspx?id=204762",""],[4988,"مدرسة دنياي","https://www.poetsgate.com/ViewPoem.aspx?id=214087",""],[4119,"الحق مبتهج والسيف مبتسم","https://www.poetsgate.com/ViewPoem.aspx?id=16222",""],[5121,"دولة الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=33514",""],[5121,"روايتي الشقية","https://www.poetsgate.com/ViewPoem.aspx?id=37466",""],[5409,"نبتت فوق روضة من غدير","https://www.poetsgate.com/ViewPoem.aspx?id=155302",""],[5461,"الحزن في صوتك","https://www.poetsgate.com/ViewPoem.aspx?id=501",""],[5573,"أشعلت لي في داجر الليل مصباح","https://www.poetsgate.com/ViewPoem.aspx?id=200076",""],[5573,"خاتم ذهب","https://www.poetsgate.com/ViewPoem.aspx?id=200179",""],[5573,"برد وسلام","https://www.poetsgate.com/ViewPoem.aspx?id=200218",""],[5573,"ياوقتي يامطول ليلك/مع طولك ماتقضي شف","https://www.poetsgate.com/ViewPoem.aspx?id=200307",""],[5573,"قال الذي يسرح معه فجة النور","https://www.poetsgate.com/ViewPoem.aspx?id=204541",""],[5652,"ماملّ منهو يرقب الصبح عصفور","https://www.poetsgate.com/ViewPoem.aspx?id=177965",""],[5732,"ياغزال الريم ياظبي الفلا","https://www.poetsgate.com/ViewPoem.aspx?id=177889",""],[5784,"زمن العقوق","https://www.poetsgate.com/ViewPoem.aspx?id=199041",""],[6056,"خصلتين ٍ فوق خدّه","https://www.poetsgate.com/ViewPoem.aspx?id=130327",""],[6100,"عادي التعب","https://www.poetsgate.com/ViewPoem.aspx?id=52555",""],[6113,"نوال","https://www.poetsgate.com/ViewPoem.aspx?id=12877",""],[6113,"السالفه...............!!!","https://www.poetsgate.com/ViewPoem.aspx?id=41916",""]],"verses":[["صابَرْتُ مِنْها لُجّةً مهْما ارْتمَتْ","وطَمَتْ رَمَيْتُ عُبابَها بسَبوحِ",0,"ح",1,0],["صَابَ مُزْنُ الدُّمُوعِ مِنْ جَفْنِ صَبِّكْ","عِنْدَمَا اسْتَرْوَحَ الصَّبَا مِنْ مَهَبِّكْ",1,"ك",1,1],["صابرٌ طاول الزمان إلى أن","رد أدباره إلى إقبال",2,"ل",1,0],["صابِراً صادِقَ الحَديثِ إِذا ما","أَكثَرَ القَومُ قالَ قَولَ السِدادِ",3,"د",1,0],["صابَت شَعائِرُهُ بُصرى وَفي رُمَحٍ","مِنهُ دُخانُ حَريقٍ كَالأَعاصيرِ",4,"ر",1,1],["صابرتني يوماً وقالت أغثني","بجماع به أطفِّي الحريقا",5,"ق",2,0],["صابِرٍ مِنكَ كُلَّ يَومٍ عَلى جُم","لَةِ هَذا الجَفاءِ وَالتَثريبِ",6,"ب",1,0],["صابَت يَداهُ فَلا السَماحُ بِرَبعِهِ","وانٍ وَلا ظِلُّ الأَمانِ يَقلِصُ",7,"ص",1,0],["صابٍ إِلى نَحوِكُم صَبٌّ بِحُبِّكُم","مُحافِظُ الوُدِّ لِلدّاني وَلِلقاصي",8,"ص",2,0],["صابتْ فأضْحَكَتِ النديمَ بأكْؤُسٍ","عَهدي به من نقطهنَّ يُقَطبُ",9,"ب",1,0],["صابِرٍ في اللَهِ مُحتَسِبٍ","واثِقٍ بِاللَهِ مُعتَصِمِ",10,"م",1,0],["صابِري الأَحداثَ مَهما مَكَرَت","وَثِقي بِاللَهِ خَيرِ الماكِرينْ",11,"ن",1,0],["صابراً في منشط أو مكره","ثابت العزم شديد المكتهل",12,"ل",1,0],["صابتْ حشاك ، وأخْطَتْني ، نوافذُها","ليت النوائبَ لمْ تُخطئْ ولم تُصب",13,"ب",1,0],["صابِراً غير نافرٍ من أذاهُم","كلّما كذّبوهُ جاءَ حِماهم",14,"م",1,0],["صابَت ثَراكِ مِنَ الدُموعِ مَواطِرٌ","تُغنيكَ عَن صَوبِ الحَيا الوَكّافِ",15,"ف",1,0],["صَابِرٌ لِلْوُفُودِ مِثْلُ أَبِيهِ","سَيِّدِي صَابِرٍسَنَا الأَغْلاَسِ",16,"س",1,0],["صابوا وصانوا وصالوا","كذا جناسُ المعالي",17,"ي",1,0],["صابرٌ فيه ذو اليقينِ وذو العق","لِ فذا عن رِضا وذا عن غلابِ",18,"ب",1,0],["صابِرِ الدَهرَ عَلى كَرِّ النوائِب","مِن كُنوزِ البرِّ كِتمانُ المَصائِب",19,"ب",1,1],["صابِرْ زمانَكَ تَعْبُرْ عنكَ شِدَّتُه","وأَمهلِ الرَّنْقَ يَخْلُصْ منه صافيه",20,"ي",2,0],["صابُها شَهدُها لدَينا فَما يُع","رَفُ مِنها ماذا أمرَّ وأحلى",21,"ل",2,0],["صابٍ إلى الوَصلِ نابٍ عنه ممتزجٍ","كأنَّه رِدفُه في اللين والدهَسِ",22,"س",1,0],["صابر على الأخطار في طلب العلى","إن اكتساب المجد بالإخطار",23,"ر",1,1],["صابَتْ عَلَى الإِشراكِ خَسْفاً مُفْنِياً","وهَمَتْ علينا بالنوالِ غُيُوما",24,"م",2,0],["صابت حساماً ولساناً ويداً","بأيِّها شاء مضى فقطَعا",25,"ع",2,0],["صابوا رَذاذاً وتلو","وَتْ بالسيول الدّفَّعِ",26,"ع",1,0],["صَابرٍ للقضاءِ فيمَا قَضَى اللهُ","وأنعِم بصابرٍ للقضَاء",27,"ا",2,0],["صابرا باسمه الصبور هنا","حاش لله أن أكون أنا",28,"ن",2,0],["صابح محياه تلق النجح في الآمل","وانظر بناديه حسن الشمس في الحمل",29,"ل",1,1],["صابَروه دهراً وهم من عناد ال","دهر أولى بثورةٍ واضطراب",30,"ب",1,0],["صابج وزا شروايه","من بو هدب نشّاح",31,"ح",1,0],["صاب القلب اختلافي","أمرٍ ما ينكتم",32,"م",1,0],["صابِرٌ لَيسَ يُبالي كَثرَةً","جُزَّ بِالمِنجَلِ أَو مِنهُ نُتِف",33,"ف",1,0],["صابرَ الصبرَ فاستغاث به الصبر","فصاح الصبور يا صبرُ صَبْرا",34,"ر",2,0],["صابٍ للثم اكفٍ لا يكفّ على","مدى الليالي لذاك اللثم يرتقبُ",35,"ب",1,0],["صاب لنحو النحو قلباً مرتقٍ","بالصرف عن كل انتقاص يوبقُ",36,"ق",1,0],["صابِيْ الْفُؤادِ إليَ النَّدى تَوَّاقِهِ","ساميْ الَّلحاظِ إِلَى الْعُلا طَمّاحِهِ",37,"ح",2,0],["صابتكَ مِن بَوارقي مُرِشَّةٌ","من عَتبٍ شُؤبُوبُها لا من بَرد",38,"د",1,0],["صابوا بِسِتَّةِ أَبياتٍ وَأَربَعَةٍ","حَتّى كَأَنَّ عَلَيهِم جابِياً لَبِدا",39,"د",2,0],["صابوا وصالوا فاعتلى بهم","في الخافقين النفع والضرر",40,"ر",1,0],["صابراً في كل سوءٍ وأذى","في كيانٍ من عمومٍ وخصوص",41,"ص",1,0],["صابحني بالكاس ظبيٌ لي من","رضا به مصطبح ومغتبق",42,"ق",1,0],["صابِرٌ صادِقٌ وَفِيٌّ إِذا ما","أَكثَرُ القَومِ قالَ قَولَ السَدادِ",43,"د",1,0],["صابَرَ الصبرَ فاستغاث به الصب","رُ فصاحَ المحبُّ بالصبرِ صبرا",44,"ر",2,0],["صاب شربت به المنية قد غدا","مستعذب الإصدار والإبراد",45,"د",1,0],["صابَت لحاظي خدّه فَرَمى الحشا","سَهماً فَكانَ الرمى حكم قصاص",46,"ص",1,0],["صابَني مِن شادِنٍ سَهم لَحظٍ","فَفُؤادي دائمُ القَرحِ دام",47,"م",1,0],["صابر ما قال آه","ايها الناس ارحموه",48,"ه",1,0],["صابر ما قال آه","أيها الناس اجمعوه",48,"ه",1,0],["صابٍ منَ الأتراك أصبى مهجتي","فعبدت نور الحسن فوق جبينه",49,"ن",2,0],["صابَ غيثاً وصالَ ليْثاً وحيّا","صبْحَ هدْيٍ يجْلو الخُطوبَ الروامِسْ",50,"س",1,0],["صابًا إذا ارتوت الشفاه شربته","بالناظرين وساء ذاك شرابا",51,"ب",2,0],["صابرتها زمناً كأن جزاءها","عن كل رزء حل تاج مشرق",52,"ق",1,0],["صابَها في الضُحى مرش مِن الطل","عَلى آنف الحَدائق مبطى",53,"ط",2,0],["صابي كمثل جرير","في شان هذا الغرير",54,"ر",1,0],["صابر محتسب في وحدتي","نبضيَ العابد عنوان افتخاري",55,"ر",2,0],["صابر ومؤمن بالقدر واعمل السبب","يوم الدعا رد القدر في كتايبه",56,"ب",2,0],["صابرة تحت المآسي والقهر والظلم مدّه","عذبوها دون ذنبٍ ترتكب والا جنايه",57,"ا",3,0],["صابني نوبة فرح بهجه وسرور","كِنني واصل الى قمة نجاحي",58,"ح",2,0],["صابراً كان يدفعُ الشرَّ عنه","ما أتى مشركٌ بِشَرِّ عَتيا",59,"ي",2,0],["صابر وحسبي من كسى الناس بلباس","والحمد له بالضيق ولا انفراجه",60,"ج",2,1],["صاب الغمام عليهم والسهام معا","فما دروا أيما الهطالة الديم",61,"م",1,0],["صابني رعشٌ فهزَّ الوجدَ حرّى","قد سقاني لوعة َالجسم ِالهزيل ِ",62,"ل",1,0],["صَابِرٌ حَتَّى فَتَّتَ الْصَّبْرُ شَكْلِي","فَارْتَمَى فَوْقَ وِجْنَتَيَّ الْجَزَاءُ",63,"ا",2,0],["صابرات على السرى صبر ركبٍ","تاه في غور بلقع مجهول",64,"ل",1,0],["صابك اللي من زمان صابني","في معاليق الحشا جرحه دفين",65,"ن",1,0],["صابر وأصابر والعمر كله اكفاح","لو طارق الفرقا عظيم الطوارق",66,"ق",1,0],["صابر على اللي سكب في كبدي اوقودي","مامل ياخوك لي صبري ولا اجهادي",67,"د",2,0],["صابر وحكمك يامدير الكون صادر من حكيم","ماغيرك الباقي ولا ياخالقي لغيرك دوام",68,"م",1,0],["صابر والدنيا وش فيها","ينفعني من صفق الكف",69,"ف",1,0],["صابر على حملي لي ايام واشهور","وسنين مرتني بعد رحلة الطيش",70,"ش",1,0],["صابر مع الي ماخذٍ بالصبر دور","يكتب على الله يقبل الحظ شاري ..!!",71,"ر",2,0],["صابغ حبك بقلبي مانجلا","ياحبيبي مثل دقات الوشام",72,"م",1,0],["صابرًا كنتُ ..حين كنت أغني","للصباح الجميلِ ..وقتَ الشروقِ",73,"ق",1,0],["صاب قلبي لحظ عينه يوم لدّه","وإنتثر دمعي ، على خدي سكايب",74,"ب",1,0],["( صابر ) وليت احلامي اللي بكتني","ما بللت خد الرجا دم وهموم",75,"م",1,0],["صابني الطرف المحلى بالكحال","طحت فيهاوالبشرمتجمعين",76,"ن",1,0],["صابرً والله على صبري يعين","محتري كلمه من الظبي الجفول",77,"ل",1,0]]}