.poetsgate.com/ViewPoem.aspx?id=25794",""],[5606,"يقول عيسى وعيسى يرفع أقواله","https://www.poetsgate.com/ViewPoem.aspx?id=197970",""],[5609,"المنديل","https://www.poetsgate.com/ViewPoem.aspx?id=215572",""],[5616,"الجوع.. الجوع!","https://www.poetsgate.com/ViewPoem.aspx?id=205221",""],[5629,"الحاجه","https://www.poetsgate.com/ViewPoem.aspx?id=184549",""],[5638,"قيدي يحدثني","https://www.poetsgate.com/ViewPoem.aspx?id=198120",""],[5652,"أمانينا","https://www.poetsgate.com/ViewPoem.aspx?id=208683",""],[5686,"فإن ضاقت بك الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=203360",""],[5691,"زمان الأقوياء","https://www.poetsgate.com/ViewPoem.aspx?id=206311",""],[5700,"وداعا أبا خلدون","https://www.poetsgate.com/ViewPoem.aspx?id=207483",""],[5721,"ينابيع البكاء","https://www.poetsgate.com/ViewPoem.aspx?id=214506",""],[5732,"الملحمة الزايدية","https://www.poetsgate.com/ViewPoem.aspx?id=177865",""],[5764,"رجلي وبابك","https://www.poetsgate.com/ViewPoem.aspx?id=191426",""],[5781,"من نسْلِ ملحٍ وماء","https://www.poetsgate.com/ViewPoem.aspx?id=198552",""],[5794,"تراب","https://www.poetsgate.com/ViewPoem.aspx?id=122801",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5818,"الشعب واللص","https://www.poetsgate.com/ViewPoem.aspx?id=199688",""],[5818,"تقبّله تراه ولا يراها","https://www.poetsgate.com/ViewPoem.aspx?id=200201",""],[5848,"الأحرار","https://www.poetsgate.com/ViewPoem.aspx?id=53098",""],[5943,"نبضُ القلبِ","https://www.poetsgate.com/ViewPoem.aspx?id=11703",""],[5956,"أنانياتها","https://www.poetsgate.com/ViewPoem.aspx?id=182455",""],[5956,"دفاع عن الحظائر *","https://www.poetsgate.com/ViewPoem.aspx?id=183370",""],[5956,"العبّارة المصرية","https://www.poetsgate.com/ViewPoem.aspx?id=192129",""],[5986,"أيا عترة المختار والسادة الطهر","https://www.poetsgate.com/ViewPoem.aspx?id=162956",""],[5997,"سَرْجٌ وَأكْحَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=214284",""],[161,"حنين الأنام لحج بيت الله الحرام","https://www.poetsgate.com/ViewPoem.aspx?id=175362",""],[4442,"أبت أن تسيغ العيش ألا بما تهوى","https://www.poetsgate.com/ViewPoem.aspx?id=170991",""],[6082,"سر فرقانا","https://www.poetsgate.com/ViewPoem.aspx?id=60177",""],[6134,"سواد عينيك يشبه لسواد القلب","https://www.poetsgate.com/ViewPoem.aspx?id=169595",""],[6142,"هلم نرق ماء العيون لمن أحيا","https://www.poetsgate.com/ViewPoem.aspx?id=155751",""],[6152,"الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=201745",""],[6172,"إختيال 1","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82526&r=&rc=13",""],[5561,"حلو الكلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86130&r=&rc=4",""],[6313,"صباح الهم يا بلدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83381&r=&rc=0",""],[6360,"شَغَبْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87598&r=&rc=1",""]],"verses":[["يَموتُ قَومٌ فَلا يَأسى لَهُم أَحَدٌ","وَواحِدٌ مَوتُهُ حُزنٌ لِأَقوامِ",0,"م",1,0],["يَموتُ إِذا آيَستَهُ مِن حَبيبِهِ","وَيَحيا إِذا حَرَّكتَهُ بِأَماني",1,"ي",1,0],["يَموتُ المُداوي لِلنُفوسِ وَلا يَرى","لِما فيهِ مِن داءِ النُفوسِ مُداوِيا",2,"ي",2,0],["يَموتُ رَديءُ الشِعرِ مِن قَبلِ أَهلِهِ","وَجَيِّدُهُ يَبقى وَإِن ماتَ قائِلُه",3,"ل",2,0],["يَموجُ عَلى النَواظِرِ فَهوَ ماءٌ","وَيَلفَحُ بِالهَواجِرِ فَهوَ نارُ",4,"ر",1,0],["يموت القويُّ كما أنه","يموت الضعيف فهل من مخلَّد",5,"د",1,0],["يَموتُ في الغابِ أَو في غَيرِهِ الأَسَدُ","كُلُّ البِلادِ وِسادٌ حينَ تُتَّسَدُ",6,"د",1,1],["يَموتُ راعي الضَأنِ في جَهلِهِ","مَوتَةَ جالينوسَ في طِبِّهِ",7,"ب",2,0],["يموتان فيه وبعد البلى","طويلاً يعيشان في المرمسِ",8,"س",1,0],["يَموتُ بِها المُتَيَّمُ كُلَّ يَومٍ","عَلى فَوتِ المَواعِدِ وَاللِقاءِ",9,"ا",2,0],["يَمورُ كَمَورِ الريحِ في عَصَفاتِها","أَوِ الماءِ وافى مَهبِطاً فَتَدَفَّعا",10,"ع",2,0],["يَموتُ ذَكاءُ الطِّفْلِ ما دامَ عندَهُمْ","وكيفَ صَلاحُ الفَرْعِ والأصلُ فاسِدُ",11,"د",1,0],["يَموتُ الفَتى مِن عَثرَةٍ بِلسانِهِ","وَلَيسَ يَموتُ المَرءُ مِن عَثرَةِ الرِّجلِ",12,"ل",1,0],["يَموتُ ذو البِرِّ وَالتَقوى فَتَغبِطُهُ","وَلا تُنافِسُهُ في بَعضِ أَعمالِه",13,"ل",2,0],["يَموجُ بِهِ بَحرٌ كَأَنَّ حَبابَهُ","عَلَيهِ دِلاصٌ سَردُها مِنهُ محكمُ",14,"م",1,0],["يموتونَ موتَ العِزّ في حَوْمةِ الوَغى","إذا ماتَ أهلُ الجبنِ بين الكَواعِبِ",15,"ب",1,0],["يَموتُ مَشايِخُ الكُتّابِ هَزلاً","وَرِزقُكَ أَنتَ في السِتّينَ يَجري",16,"ر",2,0],["يَمُوتُ مَعِي سِرُّ الصَّدِيقِ وَلَحْدُهُ","ضَمِيرٌ لَهُ الْجَنْبَانِ مُكْتَنِفَانِ",17,"ن",1,1],["يموت الخالدون بكل فجٍ","ويستعصي على الموتِ الخلود",18,"د",1,0],["يَموتُ بِسُوءِ الرأيِ مَن ساءَ خُلقه","وللمرءِ ذِي التقوى عن الغَيِّ مَصْرَفُ",19,"ف",1,0],["يَموتُ كَما مَاتَ مَن قَد مَضى","يُردُّ إِلى اللَهِ باري النَسَم",20,"م",1,0],["يموت ويَحْيا بينَ راجٍ وآيسٍ","فكانَ له الهُلْكُ المُواشكُ أرْوَحا",21,"ح",2,0],["يُمَوِّتُني شَوقي وَتُحيينِيَ المُنى","فَلَستُ بِحَيٍّ في الحَياةِ وَلا الرَدي",22,"د",2,0],["يَموتُ الهَوى حَتّى كَأَن لَم يَكُن هَوىً","وَلَيسَ لِما اِستَبقَيتُ مِنك بَقاءُ",23,"ا",2,0],["يَموجُ بَحرُكِ وَالأَهواءُ غالِبَةٌ","لِراكِبَيهِ فَهَل لِلسُفنِ إِرساءُ",24,"س",3,0],["يَموتُ المَرءُ لَيسَ لَهُ صَفيٌّ","وَقَبلَ اليَومِ عَزَّ الأَصفِياءُ",25,"ي",3,0],["يَموتانِ مِثلَ الناظِرَينِ تَوارُداً","فَلا هُوَ مَفقودٌ وَلا هِيَ فاقِدُ",26,"د",1,0],["يَموتونَ بِالحُمّى وَغَرقى وَفي الوَغى","وَشَتّى مَنايا صادَفَت قَدَراً حُمّا",27,"م",2,0],["يَمُورُ النَدَى في مِدرَيَيها كأَنَّهُ","فَرِيدٌ هَوى مِن سِلكِهِ فَتَحَدَّرا",28,"ر",2,0],["يَمونُ أهلَ البيتِ باكتسابِهْ","أهبَبْتُه فانصاعَ في إهبابِهِ",29,"ب",2,0],["يموت للحق خلق","وَالحق لَيسَ يَموتُ",30,"ت",1,0],["يَموت أناس في سبيل حقوقهم","وَلَيسَ يموت الحق فهو له العمر",31,"ر",1,0],["يَموت إِذا لَم يُشجِ شعرٌ بشدوِهِ","وَيَحيا إذا أَشجى حَياة خلود",32,"د",1,0],["يَموت المرء تدريجاً","ولكن هو لا يَدري",33,"ي",1,0],["يموت راعي الضّأن في جهله","ميتة جالينوس في طبّه",34,"ب",2,0],["يَموتُ الهَوى مِنّي إِذا ما لَقيتُها","وَيَحيا إِذا فارَقتُها فَيَعودُ",35,"د",1,0],["يموت قوم وراء قوم","ويثبت الأول العزيز",36,"ز",1,1],["يَمُوتُ قَلْبِي ويَحْيَا حَيْرَةً وهُدىً","فِي عالَمِ الْوَجْدِ إِنْ صَدَّتْ وإِنْ جَنَحَتْ",37,"ت",1,0],["يَموتُ أَسيرُ الحُبِّ قَبلَ اِنطِلاقِهِ","وَما بيدِ المَملوكِ مِن أَمرِهِ شَيُّ",38,"ي",1,0],["يموتُ الفتَى من قَبْلِ أنْ يعرِفَ الفتَى","من الأمرِ ما يأتي وما يتجنَّب",39,"ب",1,0],["يَمُوجُ فَيْعُلو البَرَّ والبَحْرَ مَوْجُه","وتَمْلِك أَرْجَاءَ الفَضَاءِ مَذَاهِبُه",40,"ب",2,0],["يَمُوتُ الفَتَى في عَثْرَة ٍ بِلِسَانِهِ","وَلَيْسَ يَمُوتُ المَرْءُ مِنْ عَثْرَة الرِّجْلِ",41,"ل",1,0],["يموتُ \" النبوغُ \" بأحضانه","ويُنعى به \" الأمل \" المرتجى",42,"ا",1,0],["يموعُ إذا مسّ الهجيرُ رداءه","كما انحلَّ شَمْعٌ بالصِلاء فماعا",43,"ع",2,0],["يَموتُ رَدِيُّ الشِّعرِ مِنْ قَبْلِ أَهْلِه","وجيدهُ يبقى وإنْ ماتَ قائلهْ",44,"ل",2,0],["يموت بها المتيم كل يوم","على فوت المواعيد واللقاء",45,"ا",2,0],["يموتُ الْهوى مني إذا ما لقِيتُها","ويحيا إذا فرقتها فيعودُ",46,"د",1,0],["يَموتُ وَيَحيَا لَوعَةً وَطَماعَةً","وما الحِبُّ إلاَّ مِن يُميتُ ومَن يُحيي",47,"ي",1,0],["يموتون إن كفوا الاكفّ مجاعةً","وإلا أتتهم كل داهيةٍ دهيا",48,"ي",2,0],["يموت لدى الورى حينا ويحيا","حياة قد تسوق إلى الحمام",49,"م",1,0],["يموت ويجمع الفودات حرصا","ويشظف لا سقي صفو الرحيق",50,"ق",1,0],["يموت الفتى طِفْلاً وكهلاً وعَبْطة","ويَبقَى على الأيام والدهر جودُهُ",51,"د",2,0],["يموتُ بها ويحيا كلَّ يومٍ","فيدفعهُ القديمُ إلى الجديد",52,"د",1,0],["يموتُ الذي يَسعى إِلى المجدِ مرَّةً","وأمّا الذي يهوى فميتاتُه كُثر",53,"ر",1,0],["يموجُ بِها بحرا منى ومنيّةٍ","قَدِ اِفتَرقا هذا فرات وذا مرُّ",54,"ر",1,0],["يموت الفتى بالجهل من قبل موته","ويحيى بروح العلم من بعد ميتة",55,"ه",1,0],["يَموتُ وَيَحيا تارَةً مِن دَبيبِها","وَلَيسَ لَهُ أَن يُفصِحَ القيلَ مَنطِقُ",56,"ق",1,0],["يموت الندى فوق أوراقِها","وينكرُها الغيث إما هتن",57,"ن",1,0],["يموت الضعيف ويحيا القوي","ويجتاح هذين سيل عرم",58,"م",1,0],["يَموتُ كَما ماتَ العُناةُ مُعَنّاهُ","وَما عَلِمَ الواشي بِغامِضِ مَعناهُ",59,"ه",1,1],["يَموتُ الفَتى شَوقاً إِلى الحُسنِ وَحدَهُ","فَكَيفَ بِمَن قَد فارَقَ الحُسنَ وَالحُسنى",60,"ن",2,1],["يَموتُ شِعرٌ وَما جَفَّ اليَراعُ بِهِ","وَبَعضُ ما قيلَ مَذبوحٌ عَلى النُصُبِ",61,"ب",1,0],["يموتُ المرءُ من داءٍ بداءٍ","إِذا عَزَّ الشِفاءُ على الدواءِ",62,"ا",2,0],["يَموتُ لَئيم القَومِ مِن قبل مَوتِهِ","وَيقبُرُ مِن قَبلِ الدُخولِ إِلى القَبرِ",63,"ر",1,0],["يموت اشتياقا كلما عن ذكركم","فيحييه خقاق النسيم إذا هبا",64,"ب",2,0],["يموت الصحيح ويحيا المصاب","وما كل من يرم عمداً يصاب",65,"ب",1,1],["يموت أبو المرء قدامه","ويتبعه النسل والأمهات",66,"ت",1,0],["يموت غني القوم موتة مدقع","ويرمس عبد السوء ما رمس الفتح",67,"ح",1,0],["يموت غني القوم موتة مدقع","ويدفن محروم المنى دفن مرتد",68,"د",1,0],["يموت زعيم الجيش موتة مدقع","وعكرشة في الموت كالأسد في الورد",69,"د",1,0],["يموت المحل بسفح الحضي","ض موتة من للسماكين راق",70,"ق",1,0],["يموت زعيم القوم موتة مدقع","وسيان فيه ليث غاب وخرنق",71,"ق",1,0],["يموتُ الدهرُ من هَرَمٍ وتفنَى","بنوهُ وهي باقيةُ الرسومِ",72,"م",1,0],["يموت إباءً أن يعيش بغبطةٍ","على غيره فيها من الناس كَلُّهُ",73,"ل",2,0],["يموتُ حسودها منها بداء","إذا استشفاه عاود منه نكسا",74,"س",2,0],["يموتُ لديها المَحل والمحل عارقٌ","ويحذرُها بأسُ الحسام المهنَّد",75,"د",1,0],["يموتُ به ويحيامن نَّداهُ","بمغبُّرين قِرْنٌ أو عَديمُ",76,"م",1,0],["يموت الردى والمحْلُ عند فِنائهِ","إِذا سَلَّ سَيفَىْ نصْره والرغائبِ",77,"ب",1,0],["يموتُ الفارسُ المِقْدامُ منهُ","وتأمَنهُ الغَنائمُ والطَّريدُ",78,"د",1,0],["يموج به في الحرب صاف أديمه","حفوز لِهامات الملوك حوافره",79,"ر",2,0],["يَموتُ قائِمُهُم بِالذُّلِّ مُنطَمِساً","والسيلُ فيهم مِنَ الأَكدارِ يَنحَدِرُ",80,"ر",1,0],["يَموتُ الفَتى منهمْ ويَحْيَى بِنَظْرَةٍ","لِمَحْبوبهِ والحَيُّ خالٍ من السِّوى",81,"س",3,0],["يَموتُ إن سارتِ الأظْعانُ مُزْمِعَةً","وجْداً ويُحْييهِ صَوتُ الرَّكبِ إن خَطَروا",82,"ر",3,0],["يموتُ الفردُ منّا مُستحيلا","لمشروعٍ بدعمِ \"مُمَولّينا\"",83,"ن",2,0],["يموتُ الشّيخُ كهلاً والكُهولُ","يموتونَ شباباً يافِعينا",83,"ن",2,0],["يموت بالفكر ثم يحيى","بالذكر في القلب واللسان",84,"ن",1,0],["يموت ويحيى كلما لمعت له","بروق الحمى النجديْ وغرد طائر",85,"ر",1,0],["يموت في ساعة ويحيى","فموته طاب والحياة",86,"ه",1,0],["يَمورُ وَهوَ كابِنٌ حَيِيُّ","خَزايَةً وَالخَفِرُ الخَزِيُّ",87,"ي",1,0],["يموتُ مفقودُنا يوماً وفاقدُهُ","في كلِّ يومٍ يذوقُ الموتَ مُتَّصِلا",88,"ل",2,0],["يموتُ اللَّيْثُ في الفَلواتِ جوعاً","وتُبشِمُ كَثْرَةُ الشَّبَعِ الكِلابا",89,"ب",2,0],["يموتُون غيظاً كلَّما عشتُ غِبْطةً","فقد ضمَّنِي قصْرٌ وقد ضمَّهم لحْدُ",90,"د",1,0],["يَموتُ في حُبِّهِ تلْميذهُ كَلَفاً","لأَجْلِ ذاكَ إذا وَافى يُلقِّنُهْ",91,"ه",1,0],["يَمُوتُ عَزيزُ القَومِ ميتَةَ عاجِزٍ","ذَليلٍ وَيُعطَى جاهِلٌ حَظَّ عالِمِ",92,"م",1,0],["يموت بها عزريل في كل صورة","تجلت لنا الأنوار في قرص شمسه",93,"ه",1,0],["يموت في الحب من يحيا به وبه","في الحشر يحشره للحب حاشره",94,"ر",2,0],["يموتُ العذلُ في أهلِ التَّصابي","بهِنّ فما لأهلِ العشقِ لاحِ",95,"ح",1,0],["يموج كالبحر ضمتنا غواربُهُ","فأغرقتنا بإرغاء وإزباد",96,"د",1,0],["يَموجُ جَوهرُ مَعناها بِرَونَقِهِ","كَجَوهَرِ السّيفِ لَو يَبدو بِمُنصَقلِ",97,"ل",1,0],["يَموجُ بِفُرسانٍ لُيوثٍ كَواسرٍ","وَما مِثلُهُ بِالمَوجِ مِن مُتَلاطِمِ",98,"م",1,0],["يَموجُ وَهوَ زُلالٌ كاللُّجينِ عَلى","تُربٍ مِنَ المِسكِ ذاكي الطيبِ وَالذّفَرِ",99,"ر",1,0],["يَموتُ غَراماً لَيس يَرضى حَياتَهُ","وَمِنهُ عَليها الدّهرَ يُهدَى سَلامُهُ",100,"م",2,0],["يَموجُ بِالفَضلِ وَالعِرفانِ متَّصِلاً","مِنهُ التموُجُّ إِطماعاً لِمغترفِ",101,"ف",1,0],["يَمُوتُ وَلاَ يَنْفَكُّ مِنْ قَيْدِ أسْرِهِ","وَرَاضٍ لِمَا يَرْضى مُطِيعُ لأَمْرِهِ",102,"ه",1,0],["يموت بهذا كل خير وسنَّةٍ","ويحيا بهذا كل لؤم ومنكرِ",103,"ر",1,0],["يموج عليها الآل حتى كأنما","به ناقض أو مسه الذعر فارتمى",104,"م",2,0],["يَموت فَيَحيا ثُم يَفرغ زاده","فَيَرجع للقبر الَّذي مِنهُ قيما",105,"م",2,0],["يموت القلب من لهو ولغو","ويحيا كلما ذُكر الحِمام",106,"م",1,0],["يموتُ الصالحونَ وأنتَ حيٌّ","تَخَطّاكَ المنايا لا تموتُ",107,"ت",1,1],["يموج بحر الجمال فيه","فيلقى بالساحلين عنبر",108,"ر",1,0],["يَموتُ في الأَطمارِ ذو البُؤْسِ ومَنْ","يَسْحبُ في الحِيرَةِ أَذيالَ الحِبَرْ",109,"ر",1,0],["يُمَوِّلُ الدُّرَّ إِذْ يُملي قلائدَهُ","وطالما كَبتَ الحُسَّادَ إِذْ كتَبا",110,"ب",2,0],["يموتُ من أجرحهُ حسرةً","إذ ليس يدري موضعَ المقتلِ",111,"ل",1,0],["يموت من وجدٍ حذارَ الهوى","فما الذى يصنعُ عند المسير",112,"ر",1,0],["يَموتُ الصَبُّ وَالكِتمانُ عَنهُ","إِذا حَسُنَ 