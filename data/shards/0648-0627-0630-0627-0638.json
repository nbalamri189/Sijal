{"poems":[[53,"شوق يعرض لا إلى الآرام","https://www.aldiwan.net/poem29772.html","الكامل"],[3,"هل غادر الشعراء من متردم","https://www.aldiwan.net/poem85.html","الكامل"],[88,"سر في حياتك سير نابه","https://www.aldiwan.net/poem44813.html","مجزوء الكامل"],[88,"يا قوم لا تتكلموا","https://www.aldiwan.net/poem44818.html","مجزوء الكامل"],[91,"يا أيها الشادي المغرد في الضحى","https://www.aldiwan.net/poem8797.html","عموديه"],[62,"خفق الطبول وزمرة الندمان","https://www.aldiwan.net/poem52250.html","الكامل"],[45,"أحرى الخطوب بأن يكون عظيما","https://www.aldiwan.net/poem65661.html","الكامل"],[61,"ولقد مررت على المحدث مرة","https://www.aldiwan.net/poem51568.html","الكامل"],[49,"حيل البلى تأتي على المحتال","https://www.aldiwan.net/poem63053.html","الكامل"],[45,"أحْرَى الخُطُوبِ بأنْ يكونَ عَظيمَا","https://www.poetsgate.com/ViewPoem.aspx?id=32079",""],[91,"الفيلسوف المجنح","https://www.poetsgate.com/ViewPoem.aspx?id=53013",""],[148,"لا يخدعنك ظاهر من باطن","https://www.aldiwan.net/poem68507.html","الكامل"],[148,"أعدد لضيفك أهبة الإِكرام","https://www.aldiwan.net/poem68525.html","الكامل"],[197,"يا شموسا طلعت في الغلس","https://www.aldiwan.net/poem45537.html","الرمل"],[364,"وفر سهامك قد أصبت مقاتلي","https://www.aldiwan.net/poem17935.html","الكامل"],[369,"أبقى الرسيم من الركاب رسوما","https://www.aldiwan.net/poem57136.html","الكامل"],[441,"دع عنك صهباء الدساكر","https://www.aldiwan.net/poem56047.html","عموديه"],[549,"نادمت طيفك ليلة الرمل","https://www.aldiwan.net/poem47275.html","أحذ الكامل"],[556,"انهض بربك لا بنفسك","https://www.aldiwan.net/poem34286.html","مجزوء الكامل"]],"verses":[["وَإِذا ظَفِرتُ مِنَ المَناقِبِ بِالمُنى","أَهوَنتُ بِالأَرزاقِ وَالأَقسامِ",0,"م",1,0],["وَإِذا ظُلِمتُ فَإِنَّ ظُلمِيَ باسِلٌ","مُرٌّ مَذاقَتَهُ كَطَعمِ العَلقَمِ",1,"م",1,0],["وإذا ظفرت بذى الوفا","ء فحُطّ رحلك في رحابه",2,"ب",2,0],["وإذا ظُلِمتم فاضحكوا","طرباً ولا تتظلّموا",3,"م",3,0],["وَإِذا ظَفِرتَ بِنَفحَة وَبِقَطرَةٍ","فَلَقَد ظَفِرتَ بِرَوضَة وَبِمَورِدِ",4,"د",1,0],["وإِذا ظفرتُ من المَنى برغائبي","فيها فقحطانٌ على عدنانِ",5,"ن",1,0],["وَإِذا ظَفِرتَ عَفَوتَ وَهوَ إِذا رَأى","ظَفَراً عَلى الأَقرانِ كانَ لَئيما",6,"م",2,0],["وإذا ظِباءُ الأُنْسِ تَكتُبُ كُلَّ ما","يُملي وتُثبِتُ ما يَقولُ وتَسمَعُ",7,"ع",1,0],["وَإِذا ظَمِئتَ إِلى اِلتَقى أُسقيتَهُ","مِن مَشرَبٍ عَذبِ المَذاقِ زُلالِ",8,"ل",1,0],["وإذا ظَفِرْتَ غَفَوْتَ، وَهْوَ إذا رَأى","ظَفَراً على الأقْرَانِ كانَ لَئِيمَا",9,"م",2,0],["وإذا ظفرت بنفحة وبقطرة","فلقد ظفرت بروضو وبمورد",10,"د",1,0],["وإذا ظفرت بمُتَّقٍ فاقنع به","يكفيك من أحفائك الإِنسان",11,"ن",1,0],["وإذا ظفرت بظلمةٍ من ليلهِ","فالنّور باطن ذلك الأظلام",12,"م",1,0],["وإذا ظنُّوا الغرامَ هوساً","فأنا ربُّ الهوى والهوسِ",13,"س",1,0],["وَإِذا ظَفِرتَ بِرَأيِهِ وَبِرَيِّهِ","أَمِنَت مُناكَ بِهِ خُمولَ الخامِلِ",14,"ل",1,0],["وإِذا ظَننتُ بأَنَّني استَحدَثتُهُ","ألفيتُ مَن عَرفَ الحَديثَ قَدِيما",15,"م",2,0],["وإذا ظلمت فما لظل","مك غير عزم منك ناصر",16,"ر",1,0],["وإذا ظمئتُ فمن غديركمُ","نَهلي ومن جَدْواكُم عَلِّي",17,"ي",1,0],["وإذا ظهرت وكنت أن","ت بغير أنت لطيب غرسك",18,"ك",1,0]]}