{"poems":[[55,"شوق يعرض لا إلى الآرام","https://www.aldiwan.net/poem29772.html","الكامل"],[3,"هل غادر الشعراء من متردم","https://www.aldiwan.net/poem85.html","الكامل"],[90,"سر في حياتك سير نابه","https://www.aldiwan.net/poem44813.html","مجزوء الكامل"],[90,"يا قوم لا تتكلموا","https://www.aldiwan.net/poem44818.html","مجزوء الكامل"],[93,"يا أيها الشادي المغرد في الضحى","https://www.aldiwan.net/poem8797.html","عموديه"],[64,"خفق الطبول وزمرة الندمان","https://www.aldiwan.net/poem52250.html","الكامل"],[47,"أحرى الخطوب بأن يكون عظيما","https://www.aldiwan.net/poem65661.html","الكامل"],[63,"ولقد مررت على المحدث مرة","https://www.aldiwan.net/poem51568.html","الكامل"],[51,"حيل البلى تأتي على المحتال","https://www.aldiwan.net/poem63053.html","الكامل"],[47,"أحْرَى الخُطُوبِ بأنْ يكونَ عَظيمَا","https://www.poetsgate.com/ViewPoem.aspx?id=32079",""],[93,"الفيلسوف المجنح","https://www.poetsgate.com/ViewPoem.aspx?id=53013",""],[154,"لا يخدعنك ظاهر من باطن","https://www.aldiwan.net/poem68507.html","الكامل"],[154,"أعدد لضيفك أهبة الإِكرام","https://www.aldiwan.net/poem68525.html","الكامل"],[203,"يا شموسا طلعت في الغلس","https://www.aldiwan.net/poem45537.html","الرمل"],[371,"وفر سهامك قد أصبت مقاتلي","https://www.aldiwan.net/poem17935.html","الكامل"],[376,"أبقى الرسيم من الركاب رسوما","https://www.aldiwan.net/poem57136.html","الكامل"],[449,"دع عنك صهباء الدساكر","https://www.aldiwan.net/poem56047.html","عموديه"],[556,"نادمت طيفك ليلة الرمل","https://www.aldiwan.net/poem47275.html","أحذ الكامل"],[563,"انهض بربك لا بنفسك","https://www.aldiwan.net/poem34286.html","مجزوء الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138261",""],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107236","الكامل"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112434","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48767","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112854","الكامل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128713","الكامل"],[1689,"","https://poetry.dctabudhabi.ae/diwan/poem/36197","الكامل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87842","الكامل"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108426","الكامل"],[2076,"","https://poetry.dctabudhabi.ae/diwan/poem/105243","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53152","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93867","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132552","الكامل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97897","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117947","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86355","الرمل"],[4830,"يازينب","https://www.poetsgate.com/ViewPoem.aspx?id=195354",""],[5005,"بوح عاشق","https://www.poetsgate.com/ViewPoem.aspx?id=208157",""],[5628,"شمس الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=178541",""],[5957,"ماء الود","https://www.poetsgate.com/ViewPoem.aspx?id=215529",""]],"verses":[["وَإِذا ظَفِرتُ مِنَ المَناقِبِ بِالمُنى","أَهوَنتُ بِالأَرزاقِ وَالأَقسامِ",0,"م",1,0],["وَإِذا ظُلِمتُ فَإِنَّ ظُلمِيَ باسِلٌ","مُرٌّ مَذاقَتَهُ كَطَعمِ العَلقَمِ",1,"م",1,0],["وإذا ظفرت بذى الوفا","ء فحُطّ رحلك في رحابه",2,"ب",2,0],["وإذا ظُلِمتم فاضحكوا","طرباً ولا تتظلّموا",3,"م",3,0],["وَإِذا ظَفِرتَ بِنَفحَة وَبِقَطرَةٍ","فَلَقَد ظَفِرتَ بِرَوضَة وَبِمَورِدِ",4,"د",1,0],["وإِذا ظفرتُ من المَنى برغائبي","فيها فقحطانٌ على عدنانِ",5,"ن",1,0],["وَإِذا ظَفِرتَ عَفَوتَ وَهوَ إِذا رَأى","ظَفَراً عَلى الأَقرانِ كانَ لَئيما",6,"م",2,0],["وإذا ظِباءُ الأُنْسِ تَكتُبُ كُلَّ ما","يُملي وتُثبِتُ ما يَقولُ وتَسمَعُ",7,"ع",1,0],["وَإِذا ظَمِئتَ إِلى اِلتَقى أُسقيتَهُ","مِن مَشرَبٍ عَذبِ المَذاقِ زُلالِ",8,"ل",1,0],["وإذا ظَفِرْتَ غَفَوْتَ، وَهْوَ إذا رَأى","ظَفَراً على الأقْرَانِ كانَ لَئِيمَا",9,"م",2,0],["وإذا ظفرت بنفحة وبقطرة","فلقد ظفرت بروضو وبمورد",10,"د",1,0],["وإذا ظفرت بمُتَّقٍ فاقنع به","يكفيك من أحفائك الإِنسان",11,"ن",1,0],["وإذا ظفرت بظلمةٍ من ليلهِ","فالنّور باطن ذلك الأظلام",12,"م",1,0],["وإذا ظنُّوا الغرامَ هوساً","فأنا ربُّ الهوى والهوسِ",13,"س",1,0],["وَإِذا ظَفِرتَ بِرَأيِهِ وَبِرَيِّهِ","أَمِنَت مُناكَ بِهِ خُمولَ الخامِلِ",14,"ل",1,0],["وإِذا ظَننتُ بأَنَّني استَحدَثتُهُ","ألفيتُ مَن عَرفَ الحَديثَ قَدِيما",15,"م",2,0],["وإذا ظلمت فما لظل","مك غير عزم منك ناصر",16,"ر",1,0],["وإذا ظمئتُ فمن غديركمُ","نَهلي ومن جَدْواكُم عَلِّي",17,"ل",2,0],["وإذا ظهرت وكنت أن","ت بغير أنت لطيب غرسك",18,"ك",1,0],["وإذا ظمئت ورمت أن تشفي الصدا","فبحوره لك قد صفون مواردا",19,"د",2,0],["وإِذا ظَمِئتَ فَمورِدٌ مُستَعذَبٌ","وإِذا جَنَيتَ فكلُّ غصنٍ دانِ",20,"ن",1,0],["وإذا ظلام الليل أسدل ستره","وتسابقت أشباحه في الأربع",21,"ع",1,0],["وإذا ظفرت بألفة الأهواء في","أمرٍ ظفرت بألفة الآراء",22,"ا",2,0],["وإذا ظفرت بحبهم وبودهم","فاحمد لمن أولاك واشكر واسجد",23,"د",1,0],["وإذا ظمئت إلى نداه فقطرةٌ","من فيض كوثر بحره يرويني",24,"ن",2,0],["وَإِذا ظَفرت بِلذّة فَاِنهَض بِها","لا يَمنَعنّك عَن هَواكَ مَفنّدُ",25,"د",1,0],["وَإِذا ظَمِئتَ وَلَم تَجِد لَكَ مَنهَلاً","عَذبَ المِياهِ كَصافِياتِ الأَدمُعِ",26,"ع",1,0],["وإذا ظفرت بوقفة في ربعها","فاهتف سلاماً يا ربوع سلاما",27,"م",2,0],["واذا ظفرت بذلك القلب الذي","رهنوه بين خمائل وتلاع",28,"ع",1,0],["وإذا ظلمت الغيث في تشبيهه","بنداك ألزم برقه أن يخفقا",29,"ق",2,0],["وَإذَا ظَنَنتَ تَعَارُضاً فِيهَا فَذَا","مِن آفَةِ الأفهَامِ وَالأذهَانِ",30,"ن",1,0],["وإذا ظلمة الخطوب اكفهرت","فبدور الدجى شموس النهار",31,"ر",1,0],["وإذا ظفرت بلذة لي ذلة","فيها زجرت النفس عن لذاتها",32,"ه",2,0],["وإذا ظفرت من القلوب بواحدٍ","حرٍّ فحسبكَ منه ألا يتحول",33,"ل",1,0],["وإذا ظفرت به فلا ألوي على","أبناء عصري غربوا أو شرّقوا",34,"ق",3,0],["وإذا ظل الوصال انتقلا","لم يعد فائته بالأسف",35,"ف",1,0],["واِذا ظننتُ بمقصدي بلغَ المنى","في مدحها عبقتْ صفاةٌ أعجبُ",36,"ب",1,0],["وإذا ظلمتَ، فحاذرنْ ظُلْم الرَّشا","ف(المروُ) إنْ شاءَ الظٌّلامة يظلمُ",37,"م",1,0],["وإذا ظهرتِ يعودُ لي حُلُمي","طفلا إلى أبويهِ يندفعُ",38,"ع",1,0],["وإذا ظمئنا، النهرُ جاد بصفوه ِ","لنقاومَ الأشواق والأوصابا",39,"ب",2,0]]}