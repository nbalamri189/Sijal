{"poems":[[79,"تخطت وفود الليل بان به الوخط","https://www.aldiwan.net/poem36395.html","الطويل"],[29,"بان الخليط غداة الجناب","https://www.aldiwan.net/poem5783.html","المتقارب"],[74,"أصبحت بعد تطاول الأيام","https://www.aldiwan.net/poem19690.html","الكامل"],[74,"إن مت من جوع بمصر فحسرة","https://www.aldiwan.net/poem20039.html","الكامل"],[53,"أرواح فيك سعوط لا يقام له","https://www.aldiwan.net/poem64950.html","البسيط"],[91,"أبكي بليل حف بالظلمات","https://www.aldiwan.net/poem44603.html","الكامل"],[91,"ان مت فاجعل كفني طيبا","https://www.aldiwan.net/poem44686.html","السريع"],[47,"اللوم منك وإن نصحت غرام","https://www.aldiwan.net/poem66646.html","الكامل"],[60,"أفاطم هاك السيف غير ذميم","https://www.aldiwan.net/poem30880.html","الطويل"],[107,"طالت أناتك في القوم الألى جهلوا","https://www.aldiwan.net/poem43393.html","البسيط"],[50,"إن مت منك وقلبي فيه ما فيه","https://www.aldiwan.net/poem66188.html","البسيط"],[70,"إن مت وزار تربتي من أهوى","https://www.aldiwan.net/poem1536.html",""],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85769","الكامل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30506","البسيط"],[108,"من وحي البحر","https://www.poetsgate.com/ViewPoem.aspx?id=179317",""],[147,"شفاء الهدى يا سيفه العضب أن تشفا","https://www.aldiwan.net/poem11779.html","الطويل"],[164,"في الصلح راسل دهر راح غضبانا","https://www.aldiwan.net/poem59080.html","البسيط"],[214,"مطلب دموعي إن نفد","https://www.aldiwan.net/poem13488.html","مجزوء الرجز"],[215,"منازل كانت جلوة العين والحشا","https://www.aldiwan.net/poem46626.html","الطويل"],[236,"لي بين سلع والعقيق عهود","https://www.aldiwan.net/poem44566.html","الكامل"],[308,"بسهم أجفانه رماني","https://www.aldiwan.net/poem58009.html","مخلع البسيط"],[353,"أنمت طرفي قريرا منك في دعة","https://www.aldiwan.net/poem19833.html","الخفيف"],[369,"هبني أقصر بالخطا","https://www.aldiwan.net/poem60794.html","مجزوء الكامل"],[591,"يا ساكني مهجتي وقلبي","https://www.aldiwan.net/poem17464.html","مخلع البسيط"],[591,"يا من هجر المحب من غير سبب","https://www.aldiwan.net/poem17976.html","الدوبيت"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96987","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38767","الرمل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77655","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46581",""],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46562","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/143997","الكامل"],[275,"","https://poetry.dctabudhabi.ae/diwan/poem/205764","الكامل"],[1689,"","https://poetry.dctabudhabi.ae/diwan/poem/36183","المجتث"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53178","المنسرح"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53059","البسيط"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106840","الكامل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137396",""],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130807",""],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/128250","الدوبيت"],[2909,"","https://poetry.dctabudhabi.ae/diwan/poem/96414","المنسرح"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200982","الكامل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112577","المجتث"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139890","البسيط"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139889","البسيط"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118746","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133232","البسيط"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125822","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54414","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54410","البسيط"],[4246,"","https://poetry.dctabudhabi.ae/diwan/poem/103256","الكامل"],[4326,"","https://poetry.dctabudhabi.ae/diwan/poem/98043","المتقارب"],[4728,"إن الخليّ ينامُ لم يشكُ الجوى (فصحى)","https://www.poetsgate.com/ViewPoem.aspx?id=176973",""],[4935,"بعيد جلوسك عبد الحميد","https://www.poetsgate.com/ViewPoem.aspx?id=129302",""],[5046,"جاد الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=197944",""],[5075,"لا تسأليني","https://www.poetsgate.com/ViewPoem.aspx?id=187719",""],[5216,"الشِّعر والحب","https://www.poetsgate.com/ViewPoem.aspx?id=187013",""],[5277,"مشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=215212",""],[2743,"أغتص بريقتي كحسي الحاسي","https://www.poetsgate.com/ViewPoem.aspx?id=122295",""],[5442,"آن التأهب للرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=114779",""],[5545,"الروح حيرى","https://www.poetsgate.com/ViewPoem.aspx?id=184778",""],[5674,"حزن المرايا","https://www.poetsgate.com/ViewPoem.aspx?id=198680",""],[5725,"احجية الحب","https://www.poetsgate.com/ViewPoem.aspx?id=186471",""],[5732,"اللي سباني بالهوى فارع الطول","https://www.poetsgate.com/ViewPoem.aspx?id=177944",""],[5853,"لو انه يدري","https://www.poetsgate.com/ViewPoem.aspx?id=175709",""],[6019,"شهقةُ قصيدةٍ في رثائه","https://www.poetsgate.com/ViewPoem.aspx?id=137041",""],[6075,"لِلْحُبِّ عَاشَ","https://www.poetsgate.com/ViewPoem.aspx?id=213326",""]],"verses":[["أَنَمْتَ عَلَى مَهْدِ اْلأَمَانِ عُيُونَهَا","فَيُسْمَعُ مِنْ بَعْدِ السُّهَادِ لَهَا غَطٌّ",0,"ط",1,0],["أَنِمتَ بِعَينٍ عَلى خِزيَةٍ","فَأَغضِ عَلى الذُلِّ أَشفارَها",1,"ر",3,0],["إن متُّ من حزنٍ فإن بنيّ قد","ماتوا بشامهمُ من الإعدام",2,"م",1,0],["إن متّ من جوع بمصر فحسرة","إن مات أولادي بجوع الشام",3,"م",1,1],["إن مُتَّ عاش من الأعراض ميِّتُها","وإن بقيت فما للناس أعراض",4,"ض",1,0],["إن مت تحزن في العراق أحبتي","حينا وتفرح في العراق عداتي",5,"ت",2,0],["ان مت فاجعل كفني طيباً","تفوح من اردانه الريا",6,"ي",2,1],["إِن مُتُّ مِن أَسَفٍ لِشَحطِ مَزارِها","فَالمَوتُ رَوحٌ وَالحَياةُ حِمامُ",7,"م",1,0],["اَنِمتَ اِبنَ عَبدِ الدارِ حَتّى ضَرَبتَهُ","بِذي رَونَقٍ يَفري العِظامَ صَميمِ",8,"م",1,0],["أَنَمتَ سَيفَكَ عَن آجالِهِم فَعَتَوا","وَأَيقَظوا الشَرَّ لا يَعتاقُهُم وَجَلُ",9,"ل",1,0],["إِن مِتُّ مِنكَ وَقَلبي فيهِ ما فيهِ","وَلَم أَنَل فَرَجاً مِمّا أُقاسيهِ",10,"ي",2,1],["إن مُتّ وزارَ تُرْبَتي من أَهْوَى","لبَّيْتُ مناجِياً بغيرِ النَجْوَى",11,"ج",3,1],["إن مت تحزن في العراق أحبة","حيناً وتفرح في العراق أعادي",12,"ي",1,0],["إِنْ مُتُّ قبْلكَ لا تَعْجَبْ فذُو أَمَلٍ","قد حُمَّ مِن دُونِهِ يَوْماً حِمَاميُّ",13,"ي",1,0],["إن مت فادفنوا معي رغابي","يا بحر، أنت ريبة المرتاب",14,"ب",1,0],["أَنَمتَ عُيونَ الخَلقِ بَعدَ سُهادِها","كَذا كُلُّ جَفنٍ مُذ تَأَلَّمتَ ما أَغفا",15,"ف",2,0],["أنمت عينك دون المر تطلبه","غير وإن رمته استنهضت يقظانا",16,"ن",2,0],["ان مت في عشقي يكون","عجب ورب المشرقين",17,"ن",1,0],["إن متّ لا مت فلتهلك أكاسرةٌ","يروعهم في حياة الخلد إقبالي",18,"ي",1,0],["إن مت من شغفي بها وصبابتي","فقتيل أسياف الغرام شهيد",19,"د",1,0],["إن مت مالي سواه خصمٌ","لأنه قاتلي بعينه",20,"ه",1,0],["أَنمْتُ طَرْفي قَرِيراً مِنكَ في دَعَةٍ","لِمَوْعِدٍ قَدْ كَفَاني شَرَّ أَعْدائي",21,"ي",1,1],["إن مِتُّ لم يَمُتِ الّذي","سَيّرْتُ من كَلِمٍ غَوال",22,"ل",1,0],["إِنْ مُتُّ في حُبِّكُمْ فَإِنّي","أَحْيا عَلى عِشْقِكُمْ وأُبْعَثْ",23,"ث",1,0],["إن متُّ مِن الهَجْر فما ذاكَ عجَبْ","بَلْ إنْ سَلِمتْ رُوحي فَهذاكَ عَجبْ",24,"ب",1,0],["أن متناً شكوته طال ما زا","حمت فيه من الملائك غرا",25,"ر",2,0],["إِنّ مَتنَ الصبّ أَوهاهُ الهَوى","وَلِصَدري بِالهَوى ما زالَ شَرحُ",26,"ح",1,0],["إِن متّ ما بَينَ يَدَيها يَوما","لا تَخشَ مِن هَذا المَماتِ ضَيما",27,"م",2,0],["إن مِتُّ مِتُّ فخَلِّني وغَوايتي","إنّ الغَواية حُلوةٌ لجُناتها",28,"ت",3,0],["إِن مت فَالذكر خلف","مِن الحَياة وَالشرف",29,"ف",1,0],["إن مت فخلني وغوايتي","إن الغواية حلوة لجناتها",30,"ت",3,0],["إن مت في أرض الأجانب يائسا","حنت اليك من الغريب عظام",31,"م",1,0],["إِن مُتّ وَجداً عَلَيهم","بِأَدمُعي غَسَلوني",32,"ن",2,0],["أنمت في ظلها الأنام فلا","خاب لهم في دوامها أمل",33,"ل",1,0],["أنمته آمناً من كل نائبة","فليس يرتاع من دهر ونبوته",34,"ت",2,0],["إن متُّ لم يحزن محبٌّ","أو حييت فلا ابتسام",35,"م",1,0],["أنمت الرعايا في أمان فكلهم","لسان بآيات الدعا قد ترنما",36,"م",2,0],["ان مت قبلك فاذكرني بما تركت","يداي من اثر واندب على طللي",37,"ل",2,0],["إن مت وجمرة الهوى في كبدي","فالويل إذا لساكني الأرماس",38,"س",1,0],["إن متَّ ماتَ الندى يزيد فلا","تودِ ولا يودِ بحركُ اللجبُ",39,"ب",1,0],["إن مت أبقى في قريضي خالداً","وأعيش في الآهات والأفكار",40,"ر",1,0],["إن متّ قربان قومي","بلغت كل منايا",41,"ي",2,0],["إن متُّ شوقاً فلي غرامٌ","نباتُه بالسقام وادث",42,"ث",1,0],["إن متُّ شوقاً فلي غرامٌ","نباتُه بالسقام وادس",43,"س",1,0],["إن متّ لا تبكوا علىّ فانني","حيّ بقلب العرب يا إخواني",44,"ي",1,1],["إن متّ بالعشق لا خوف ولا جزع","فميت العشق دار الخلد مأواه",45,"ا",2,0],["إنْ مِتَّ مُبْتَعِداً فذكرك خالد","متجدد بتجدد الأزمان",46,"ن",1,0],["أَنمتَ عبادَ اللّهِ أمناً فلم تدعْ","عيونَ العدى رُعباً تكحَّلُ بالغمضِ",47,"ض",1,0],["أَنمتَ عدلاً عيونَ العالمينَ بما","أَذهبتَ عنها القَذَى والرَّينَ والغمصا",48,"ص",2,0],["إن مت جسماً أنت حي سمعة","دهراً تردد ذكرها الأجيالُ",49,"ل",1,0],["إن مت وجداً وما تم رضى","واعنائي في الورى واشقوتي",50,"ت",2,0],["إنْ متّ قولوا يا رفاقُ لعَاذِلي:","قدْ ماتَ مِن حبّ الكرامِ كرامُ",51,"م",1,0],["أنمت الأنام بمهد الأمان","تساوي القريب به والبعيد",52,"د",1,0],["إن متُّ فاجعل من رفاتي مشهداً","واسكب غيوثَ الروح للإفراج",53,"ج",1,0],["إنْ مِتُّ فَلْتَعْلَمِي مَا كُنْتُ آمُلُهُ","لا شَيءَ فَوْقَ رُؤَاهَا طَامِعٌ فِيه",54,"ي",2,0],["إنْ مِتُّ سيبقى لي شِعري","يَتحدّى صوتَ الصرخاتْ",55,"ت",1,0],["\"إنْ مِتُّ يبق وريثٌُ\"..من انوثتِها","تحبوكَ فيها.. بهذا الحبّ ملتحدا",56,"د",2,0],["إن مت وجمرة الهوى في كبدي","فالويل إذا الساكني الأرماس",57,"س",1,0],["أنمت المبوأ في المفا","خر ذروة الشرف الأصيل",58,"ل",1,0],["إن متُ يوماً في هواكَ فلا تسلْ","فالنحلُ آثر أن يموتَ معَ العسلْ",59,"ل",1,1],["إن متُّ ..فاغسلني بعطر قصائدي","فردوس روحي نشوتي وسكوني",60,"ن",2,0],["إن متنا ياطيف الهوى من نوى","الذنب كل الذنب للرافضِ",61,"ض",1,0],["ان مت باسبابه فانا عز مقتول","ان رشي من فيض دمعه رذاذي",62,"ذ",2,0],["إن متُ في يومي فيكفي أنه","يحيا جميلا خالدا بكياني",63,"ن",2,0],["إن مُتَّ يا سيدي حيٌّ بما انعتقَ _","الحرفُ الذي انثالَ منه عابقاً طَلُّ",64,"ل",1,0],["إِنْ مِتَّ عِشْقًا نَظْرَتِي","رُغْمَ الْبِعَادِ تُعِيدُ كْ",65,"ك",1,0]]}