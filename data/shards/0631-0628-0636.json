{"poems":[[56,"عللاني بسماع وطلا","https://www.aldiwan.net/poem27664.html","الرمل"],[87,"أيها المنتحي بأسوان دارا","https://www.aldiwan.net/poem63710.html","الخفيف"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/142326","الخفيف"],[108,"تأميم القناة","https://www.poetsgate.com/ViewPoem.aspx?id=179582",""],[438,"رب ضحك جنيته من عنوس","https://www.aldiwan.net/poem12647.html","الخفيف"],[438,"لولا ظبى تنسل من لحظاته","https://www.aldiwan.net/poem12779.html","الكامل"],[484,"قرنت قلوصك ربها بزميله","https://www.aldiwan.net/poem37580.html","الكامل"],[505,"رفعت بسري كل أمري لسيدي","https://www.aldiwan.net/poem38020.html","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63969","البسيط"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203695","الخفيف"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203776",""],[1275,"","https://poetry.dctabudhabi.ae/diwan/poem/73539","البسيط"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/19992","المديد"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100988","الكامل"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126209","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74028","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83665","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83509","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83646","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83410","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83607","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83539","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83499","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83395","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83347","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83664","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83528","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83444","الخفيف"],[4755,"رَبِّ ضَاقَت.. وأَنتَ أَدرَى وأَعلَمْ","https://www.poetsgate.com/ViewPoem.aspx?id=198293",""],[4859,"فاعلاتن مستفعلن فاعلاتن","https://www.poetsgate.com/ViewPoem.aspx?id=190559",""],[4929,"وطني المغتصب","https://www.poetsgate.com/ViewPoem.aspx?id=199181",""],[5691,"نجوم وبشر","https://www.poetsgate.com/ViewPoem.aspx?id=206118",""]],"verses":[["رُبَّ ضَيفٍ تاجِرٍ أَخسَرتُهُ","بِعتُهُ المَطعَمَ وَاِبتَعتُ الثَنا",0,"ا",1,0],["رُبَّ ضَربٍ مِن سَوطِ فِرعَونَ مَضٍّ","دونَ فِعلِ الفِراقِ بِالنَفسِ مَضّا",1,"ض",2,0],["رب ضاقت ملاعبي","في الدروب المقيدة",2,"د",2,1],["رَبَضَ الجيش على خطِّ القناةْ","وعلى شُطآنها أَلْقَى عصاهْ",3,"ا",2,1],["رب ضِحْكٍ جنيتُه من عنوسِ","ونعيمٍ ألفيتُهُ من بُوسِ",4,"س",1,1],["ربضَ ابنُ حُجْرٍ حَجْرةً عن شأوِه","واغتالَ غَيْلاناً مدى غاياتِه",5,"ت",2,0],["ربضت هناك وأشرقت بالشعر لا","بدم الوتين وحيعلت بهديله",6,"ل",2,0],["رَبَضْتُ بِبابِ الفَضْلِ منكَ ولم أزلْ","على أملِ الإحسانِ يا واسعَ البِرِّ",7,"ر",1,0],["ربضتَ ممَّا يلي الدنيا لتحميَها","كالكلبِ من حيثُ لاقى جيفةً ربضا",8,"ض",2,0],["ربض الروم فوقها يطلبون ال","ثار حمر العيون والأنياب",9,"ب",1,0],["رَبضَتْ بين موحشات البراري","معقلاً فوق معقلٍ جبار",10,"ر",1,1],["رُبَّ ضَعيفٍ أَذاهُ خافٍ","يُبدي مَع القُوَّةِ الإِذابة",11,"ه",1,0],["رُبَّ ضافي الأَمنِ في وَزَرٍ","قَد أَبَتَّ الخَوفَ في وَزَرِه",12,"ر",2,0],["ربضوا لنصرتها أسود خفية","خلقت لرعى حقيقة وذمار",13,"ر",1,0],["رَبَضَت أسدٌ نِقمَةٍ فَرَسَتهُ","بالنصٍ لنا بنورٍ ونارِ",14,"ر",1,0],["ربضت عَلى علمي بعلويّ همَّتي","كَذي لبد للوثبِ في الغيل رابِضِ",15,"ض",1,0],["رَبّ ضاعِف عَلَيهِ أَزكى صَلاةٍ","وَعَلى الآلِ وَالصحابِ الأَماجِد",16,"د",1,0],["ربّ ضاعف أزكى الصلاة عليه","وعلى صحبه وآلٍ نبلِ",17,"ل",1,0],["رَبِّ ضاعِف عَلَيهِ أَزكى صَلاةٍ","وَسَلامٍ يَدوم ما الكَونُ باقِ",18,"ق",1,0],["ربّ ضاعف أزكى الصلاة عَلَيهِ","وَعَلى الآلِ أَطيَبَ النَفَحاتِ",19,"ت",1,0],["ربّ ضاعف أَزكى الصَلاة عَلَيهِ","ما حَلا مدحُهُ وَطابَ النَشيدُ",20,"د",1,0],["ربّ ضاعِف أَزكى السَلام عَلَيهِ","وَذَويهِ ما خُطَّ فَوقَ الطروسِ",21,"س",1,0],["ربّ ضاعِف أزكى الصلاة عَلَيه","وَعلى آلِه وَمن كان صحبه",22,"ب",2,0],["ربِّ ضاعِف عَلَيهِ أَزكى صَلاةٍ","وَسَلامٍ لآلهِ وَالصَحبِ",23,"ب",1,0],["ربّ ضاعِف عَلى حَبيبك طه","وَعَلى الآلِ وَالصِحاب الكِرامِ",24,"م",1,0],["رَبِّ ضاعِف عَلى الحَبيبِ المُفَدّى","صَلَواتٍ يَفوحُ مِنها العَبيرُ",25,"ر",1,0],["رَبّ ضاعِف عَلَيهِ أَزكى صَلاة","نَفحُها عَمَّ سائِر الأَكوانِ",26,"ن",1,0],["ربّ ضاعِف عَلَيهِ أَزكى صَلاةٍ","وَسَلامٍ تَطيب منها البُعوثُ",27,"ث",1,0],["رَبِّ ضَاقَت.. وأَنتَ أَدرَى وأَعلَمْ","إِنْ أَسَرَّ احتياجُنا.. أَو تَكَلَّمْ",28,"م",1,1],["رب ضر يذيقك المر شهدا","فتصبر وإن أطلت انتظارا",29,"ر",2,0],["ربضت في جوفه الداجي عقودٌ","جرعتنا كأسها مرا وصابا",30,"ب",2,0],["رُبَّ ضَرٍّ في مُفيدٍ ظاهِرٍ","لوْ عَرَفْناهُ لَجُزْنا الضّائِرا",31,"ر",2,0]]}