5","السريع"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83348","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133087","الطويل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83187","الرجز"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83163","الوافر"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83197","الرجز"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120501","الوافر"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35108","البسيط"],[4679,"وهل في البرايا مثل لبنان مرتعٌ","https://www.poetsgate.com/ViewPoem.aspx?id=142739",""],[4730,"هذا الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=27831",""],[4849,"مشكور يا أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=53502",""],[4901,"وحقك إن أدخلتني النار قلت","https://www.poetsgate.com/ViewPoem.aspx?id=186128",""],[585,"هنا المحفل المشهود بالشعب يزخر","https://www.poetsgate.com/ViewPoem.aspx?id=161897",""],[5083,"بُنودُ الشَّام","https://www.poetsgate.com/ViewPoem.aspx?id=53878",""],[5145,"أسير وقلبي في هواك أسير","https://www.poetsgate.com/ViewPoem.aspx?id=108064",""],[5150,"يا ألله ...!","https://www.poetsgate.com/ViewPoem.aspx?id=203383",""],[5183,"سَيْفُ الْلّهِ","https://www.poetsgate.com/ViewPoem.aspx?id=186452",""],[5183,"فيض الرحمة","https://www.poetsgate.com/ViewPoem.aspx?id=185882",""],[5205,"سما أكباد ارباب النهى انفطرت","https://www.poetsgate.com/ViewPoem.aspx?id=120993",""],[4045,"نشدت بحقّ الله من كان مسلما","https://www.poetsgate.com/ViewPoem.aspx?id=200273",""],[592,"على الحبر بحر العلم بدر المنابر","https://www.poetsgate.com/ViewPoem.aspx?id=128847",""],[5436,"زفرات(على لسان العراق)للشاعر إسماعيل الصيّاح","https://www.poetsgate.com/ViewPoem.aspx?id=129741",""],[5690,"سلوا عن فؤادي من بار واحنا يفدا","https://www.poetsgate.com/ViewPoem.aspx?id=172144",""],[5725,"آية الليل","https://www.poetsgate.com/ViewPoem.aspx?id=194691",""],[5829,"صوفي","https://www.poetsgate.com/ViewPoem.aspx?id=180093",""]],"verses":[["وآيةُ نَصْرٍ في حِجابِ مهابَةٍ","تُدافِعُ عنْ دينِ الهُدى مَنْ يَكيدُهُ",0,"د",2,0],["وآيَةُ بُشْرى هَزّ مِعْطَفَهُ الهُدَى","لَها وتَبَدّى للزّمانِ ارتيَاحُهُ",1,"ح",2,0],["وَأَيُّهُما ما قُلتُ إِن قُلتَ شَربَةٌ","وَإِن قُلتَ مَوتٌ إِنَّهُ لَقَمينُ",2,"ن",1,0],["وَأَيَّةُ أَحلامٍ رَدَدنَ مُجاشِعاً","يُعَلّونَ ذيفاناً مِنَ السُمِّ مُنقَعا",3,"ع",2,0],["وأيّةُ بلوى كالبياض الذي بدا","وأيُّ فقيدٍ كالسَّواد الذي نضا",4,"ض",2,0],["وآية الأدب الرّومَى في لغة","لم تُخل من سرها عجما ولا عربا",5,"ب",2,0],["وأيهم كالمتنبى آمرؤ","صوّاغ أمثالٍ عزيزُ المثيل",6,"ل",1,0],["وآية الشمس ظهو","ر حمرة في الشفق",7,"ق",1,0],["وأيُّ هِلال لم يَشِنْهُ مَحَاقُهُ","وأيُ شهابٍ لم يَخُنْه أُفولُ",8,"ل",1,0],["وَأَيُّهُمُ يُعيرُ عَلَيكَ دَمعاً","وَآلِسُ دونَ أَهلِكَ وَالدُروبُ",9,"ب",1,0],["وَأَيَّةُ نِعمَةٍ لَم تَرمِ فيها","بِشُؤمٍ مِنكَ يَثلِمُ في الحَديدِ",10,"د",1,0],["وَأَيَّةُ نُعمى ساقَها اللَهُ نَحوَنا","فَكانَ لَنا اِستِئنافُها وَاِقتِبالُها",11,"ل",3,0],["وَأَيَّةُ سِلعَةٍ إِن أَطلَقَتها","حِبالُكَ لي كَطَيبَةَ غَيرِ نَزرِ",12,"ر",1,0],["وَأَيُّ هَوىً أَو أَيُّ لَهوٍ أَصَبتَهُ","عَلى ثِقَةٍ إِلّا وَأَنتَ مُفارِقُه",13,"ق",2,0],["وآية من وفاء للألى سحبت","عليهم حادثات الدهر نسيانا",14,"ن",2,0],["وأَيَّةً صحَّفْتَ معكوسها","بنقطة دلَّت على الأخرى",15,"ر",2,0],["وَآيَةُ ذَلِكَ أَن تَسمَعي","إِذا جِئتُكُم ناشِداً يَنشُدُ",16,"د",1,0],["وَأَيَّةُ شَيبَةٍ إِلّا نَذيرٌ","وَهَل طَرَبٌ وَقَد مَثَلَت خَطيبا",17,"ب",2,0],["وَآيَةُ وَجدِ الصَبِّ تَهطالُ دَمعِهِ","وَدَمعُ الشَجيِّ الصَبِّ أَعدَلُ شاهِدِ",18,"د",1,0],["وآيةُ الحقِّ أن لا شيءَ يغلبُه","من يغلب اللهَ أو من يدفع القَدَرا",19,"ر",2,0],["وآيَةُ هذا أن دَحَا اللّهُ أرْضَهُ","ولكنّهَا لم تُرْسَ من غيرِ مَعلَم",20,"م",1,0],["وَأَيُّهُمُ لَم يَكُن","ظَلوماً وَلَم يُظلَمِ",21,"م",1,0],["وَآيَةُ لُؤمِ التَيمِ أَن لَو عَدَدتُمُ","أَصابِعَ تَيمِيٍّ نَقَصنَ مِنَ العَشرِ",22,"ر",1,0],["وَأَيَّةُ أَرْجُلٍ سَتَدُوسُ أَرْضاً","فَرَشْنَاهَا بِحَبَّاتِ القُلُوبِ",23,"ب",1,0],["وَأُيَّةُ الجُمَحيُّ قَوَّمَ مَيْلَهُ","عَضْبٌ بأيدي المؤمنينَ مُهَنَّدُ",24,"د",1,0],["وأيّةُ بهجة للنفس تبقى","إذا ذهبت أحبتُها الكرامُ",25,"م",1,0],["وآيةُ القصَص الأخرى فزاجرَةٌ","عن التكبّر أمثالَ الفراعين",26,"ن",1,0],["وأَيَّة نجوى كنجواي طفلي","يقول: أبي، وأقول: بنيَّا؟",27,"ي",2,0],["وآية الله في التنزيل قائلة","من كان يفسد في اوطانه صلبا",28,"ب",2,0],["وَأيُّهُمُ يُعِيرُ عَلَيْكَ دَمْعاً،","وَألسُنُ دونَ أهلكَ وَالدُّرُوبُ",29,"ب",1,0],["وآية الحق ألا شيء يغلبه","من يغلب الله أو من يدفع القدرا",30,"ر",2,0],["وآية ُ ذلكَ أن تسمعي","نداءَ المصلينَ، يا معمرُ!",31,"ر",1,0],["وَأَيُّهُمُ مِنّي وَمِنهُم بِسَيفِهِ","يُلاقي إِذا ما حانَ وَقتُ التَنازُلِ",32,"ل",1,0],["وإيه وقد وفيت شَوقِيَ حَقَّهُ","أعشد نظراً في البدر والغصن النضر",33,"ر",1,0],["وآيةُ ذلِّ النفسِ أن يحكمَ الهوى","وقد أصبحَ الشرقانِ فيهِ سواءُ",34,"ا",2,0],["وَأَيُّ هَوىً نَجا مِنهُ فُؤادي","وَسَهمٍ عارٍ مِنهُ لَم يُصِبني",35,"ن",2,0],["وآية حب اللَه منا اتباعه","به وعد الغفران بعد المحبة",36,"ه",1,0],["وَآيَةُ إسراء مَعَ الشُّعَرايَا","مُرِيدَ الشِّفَاءِ مَع فُصِّلَت بِالكِتَابَةِ",37,"ه",1,0],["وَآيَةَ التابوتِ وَالأَلوحِ إِذ","جاءَت وَف الإِلقاءِ ما مِنها اِنكَسَر",38,"ر",1,0],["وَآيةِ غنج لَحظك ذي الفَقارِ","وصالك جَنَّتي وَجفاكَ ناري",39,"ي",1,0],["وَأيّة أَرض قَد حَللت فَإِنَّنا","لِنَعجب مِنها أَنَّها وَسِعت بَحرا",40,"ر",2,0],["وأَيّة بَلْدةٍ حَلّتْ رِكابي","تَلَوْتُ بها لشُكرِ نَداكَ آيا",41,"ا",3,0],["وأيّةُ دُرّةٍ لنظامِ عَلْيا","ئها قد كان جِيدُ المَجْدِ حال",42,"ل",1,0],["وأيُّ هلالِ أفقٍ غَاب عَنهُ","وكان لأُفقهِ أبداً يزينُ",43,"ن",1,0],["وأيَّةُ جَدوى في البقاءِ وقدْ وهَتْ","وأَقْوى قلبُهُ من ذكائِهِ",44,"ا",3,0],["وأيَّةُ قفرة لم أرْمِ فيها","ولم أُزْعِجْ بِمَهْمَهها ركابي",45,"ب",2,0],["وأيَّة لَذَّة في دارِ دنيا","تَلَذُّ لنا وما فيها عناء",46,"ا",2,0],["وأيّة أزمةٍ لم يُدعَ فيها","ولم يمدد لها باعاً أشدَّا",47,"د",2,0],["وأيّة علم لم يقم حججا على","مسائله مستئجات من الفكر",48,"ر",1,0],["وأيَّةُ أُسوةٍ فِي الحسنِ منهُ","لإِحسانِي إِذَا ارْتُخِصَ الشِّراءُ",49,"ا",2,0],["وأَيَّةُ حُرَّةٍ من حُرِّ نَظْمِي","تَجَلَّتْ للخلائِقِ فِي جِلاءِ",50,"ا",2,0],["وأَيَّةُ أَشجارٍ وسَلْمُكَ سَقْيُها","إِلَى أَنْ بَغى فِيهَا فأَيَّةُ أَجْذالِ",51,"ل",1,0],["وآية الحزن بين الناس قد نسخت","من بعد موت علي آية الجذل",52,"ل",1,0],["وأيّ هوىً حادث العهد أم","س أنساه ذاك الهوى المُحوِلا",53,"ل",2,0],["وأية بلدة لا علم فيها","ولا تقوى يعاد لها الكنيف",54,"ف",1,0],["وآية الجود كون منعهِ","خصَّك بالمنفساتِ أو شملك",55,"ك",1,0],["وآية صبوتها أنها","إذ حديت رقصت للتغّني",56,"ن",2,0],["وأيّة نار شبَّها أيُّ مُوقد","وأي عظيم هاج مِن أيّما دَدِ",57,"د",1,0],["وآيةُ الحقِّ من مِنْهاجِنا أَبداً","لرَمْزِها في كتابِ النَّصرِ تَفْسيرُ",58,"ر",1,0],["وأيّةُ صَعْبَةٍ ذلّلتَ قسْراً","قرَاها أيّ ذلٍّ للرّجالِ",59,"ل",1,0],["وأي هذا كان كان فيه","فضل يكل القول أن يحصيه",60,"ه",1,0],["وآيةٌ مَجَّها صُلبُ الخَليلِ وإس","ماعيلُ أعقَبَها في صُلبِ قيدارِ",61,"ر",1,0],["وأيةُ جارَةٍ ومَناخِ ركبٍ","وَنَجعَة مُرمِلين وأيُّ جار",62,"ر",1,0],["وأيُّهما عَلى الخَلوات أبكي","أبدرَ التَّمِّ أم شمسَ النَّهار",62,"ر",1,0],["وآيةٌ عِرقُ إسماعيلَ أحسَبُها","في الفَضلِ عَن عِرق إسماعيلَ والياس",63,"س",1,0],["وأية شرعة لا بد منها","خلت من طائعين وكارهينا",64,"ن",2,0],["وَآيةُ المُلوكِ أَورَدُوها","إِن دَخَلوا قَريَةً أَفسَدوها",65,"ه",2,0],["وآية من يعملْ دليل لربه","ودل حديث التائِبُ الذنبِ مسندا",66,"د",2,0],["وآيةُ الإحسانِ منسوخَةً","قد أسقِطَت من صُحُفِ الدَهرِ",67,"ر",1,0],["وَأَية حَرب فيك بَينَ جَوانِحي","تَكن الضلوع ما تبيح المَدامع",68,"ع",1,0],["وآيةُ للصُّدودِ بَيَّنةٌ","يُعْجِزُني في الرِّضَا تَأْوُّلهُا",69,"ل",3,0],["وأيّها مع الذي وذا وأل","يلزم تاليها برفع في العمل",70,"ل",1,0],["وآية الغار في ثور حكت عجباً","فيه تحيَّر لُبُّ الحاذِقِ الفَهِمِ",71,"م",1,0],["وأية نفس يا حسيب أضعتها","فندت إلى كاف سواك وشدت",72,"ت",1,0],["وايها السهم ما اهداك لي هدفا","وما اضل الذي سماك اعلانا",73,"ن",2,0],["وايها الحي ما طيب الحياة على","خوف التحسب ان الآن قد آنا",73,"ن",2,0],["وآية الملك العظمى لناظرها","نعم بل الحجة الكبرى لمعتبر",74,"ر",1,0],["وَآيَةُ شَمْسٍ فِي فُؤَادِيَ أُفْقُهَا","إِذَا مَا تَبَدَّتْ أُخْتُهَا فَهُمَا سَوَى",75,"و",2,0],["وَإِيهٍ عَلَى الشَّمْلِ الجَمِيعِ وَجِيرَةٍ","لَهُمْ مَا لَهُمْ مِنْ صِدْقِ حُبِّي وَمِنْ وُدِّي",76,"د",2,0],["وَآيَةُ بَرقِ الجَوِّ سَكبُ دُمُوعِهِ","بِأَبطَح وَادٍ أَو سَمَاوَةِ نِيقِ",77,"ق",1,0],["وَآيةُ ذاكَ الخَاطِرِ الفَذِّ نَفثَةٌ","تَسُدُّ عَلَى الأَذهَانِ كُلَّ طَرِيقِ",77,"ق",1,0],["وإيه أيا عيد يا مُسعداً","رعايا المليك رعاه الإله",78,"ا",3,0],["وَأَيُّهُم أملي بِنَفسٍ كَريمَة","يَردّ عَلَيها مِثل بَيتِكَ مَنصِبُ",79,"ب",1,0],["وآية الغار إذ وقّيت في حجبٍ","عن كل رجس لرجس الكفر منتحلِ",80,"ل",1,0],["وأية ساعةٍ ما صحَّ مروا","إلى جبانهم فطراً ونحرا",81,"ر",2,0],["وَأَيَّةُ أَرضٍ تَيَمَّمتُها","تَيَمَّمَني مِنكَ فِيها الغِنى",82,"ا",1,0],["وأيَّةُ قُربَةٍ أعلى وأغلى","من الترحالِ للبَيتِ الحرامِ",83,"م",1,1],["وأيَّةُ زَورَةٍ تمحو الخطايا","كزَورَةِ أحمدٍ خيرِ الأنامِ",83,"م",1,0],["وَآية ذلكَ بعدَ الخلوق","تغلّف رأسك بِالغالِيَه",84,"ل",3,0],["وأيّة وجهٍ للحياء كوجهِه","فحياه ربُّ العالمين واحياه",85,"ا",2,0],["وَآية النمل في طرس العذار حلت","وَعَينه هِيَ صاد حَولَها اِكتمَلَت",86,"ت",1,0],["وأية من لدنه لا يمنّ بها","إلا على نادر من مستحقيها",87,"ي",3,0],["وآية العنكبوت نسيج","لما رقى الغار باختفاء",88,"ا",2,0],["وآية الهجر انسخى حكمها","حتى يطيب العيش لي في الهوى",89,"و",2,0],["وأي هناء في المسرات مثل ما","بدا عن صنيع منك حق به الفخر",90,"ر",1,0],["وأية بنت عليها خمار","فقالت لها الأمُّ ألق الخمارا",91,"ر",2,0],["وأية أمٍّ أباحت لها","من الكاس نخبا على القوم دارا",91,"ر",2,0],["وآية التطهير قد دلت على","عصمتها من الذنوب كملا",92,"ل",2,0],["وَآيَةُ ذَلِكَ أَنَّ بَني كُلَيبٍ","بِشَرِّ قَرارة وُجِدَت شِعابا",93,"ب",2,0],["وَآيَة ما قالَت لَهُنَّ عَشِيَّةً","وَفي السترِ حراتُ الوُجوهِ مَلائِحُ",94,"ح",1,0],["وأيهما في المجد أبعد غايةٍ","عشيةَ تَقريني الأَسنةُ أَو أَقري",95,"ر",2,0],["وَأيُّها مَصحُوبَ أل بَعدُ صِفَه","يَلزَمُ بِالرَّفعِ لَدَى ذِى المَعرِفَه",96,"ه",1,0],["وَأىُّ هَذَا أيُّها الَّذِى وَرَد","وَوَصفُ أىِّ بِسِوَى هَذا يُرَد",96,"د",1,0],["وأية نفس لا أبالك لم تكن","إلى الموت يوماً وهي بالىغم سالكه",97,"ك",2,0],["وأَيَّة راحة لكريم نفس","يكدّ