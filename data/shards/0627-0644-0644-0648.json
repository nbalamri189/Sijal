{"poems":[[39,"اللورق الهواتف أم لباك","https://www.aldiwan.net/poem7329.html","الوافر"],[49,"اللوم للعاشقين لوم","https://www.aldiwan.net/poem25159.html","مجزوء البسيط"],[23,"اللؤم خير من ثقيف كلها","https://www.aldiwan.net/poem21461.html","الكامل"],[87,"اللورد قال صراحة","https://www.aldiwan.net/poem7281.html","مجزوء الكامل"],[47,"ما بعيني هذا الغزال الغرير","https://www.aldiwan.net/poem63566.html","الخفيف"],[47,"اللوم منك وإن نصحت غرام","https://www.aldiwan.net/poem66646.html","الكامل"],[107,"ويح ذي القصة ماذا يشهد","https://www.aldiwan.net/poem43989.html","الرمل"],[77,"قمن في مأتم على العشاق","https://www.aldiwan.net/poem69059.html","الخفيف"],[90,"اللؤم داءٌ في النفوس عياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19583&r=&rc=86",""],[152,"اللؤم أكرم من وبر ووالده","https://www.aldiwan.net/poem761.html",""],[164,"سود العيون أم المواضي البيض","https://www.aldiwan.net/poem58917.html","الكامل"],[164,"أهلا به من بحر علم صدره","https://www.aldiwan.net/poem59122.html","الرجز"],[173,"يا باكياً لدمنة وأربع","https://www.aldiwan.net/poem1635.html",""],[186,"ما مر ذكرك خاطرا في خاطري","https://www.aldiwan.net/poem67068.html","الكامل"],[240,"مولاي مجد الدين يا","https://www.aldiwan.net/poem31794.html","مجزوء الرجز"],[567,"ربيبة من ذوات الغنج والحور","https://www.aldiwan.net/poem52918.html","البسيط"],[567,"بغداد أيتها الركاب فبادري","https://www.aldiwan.net/poem52940.html","الكامل"],[567,"الزهر تبسم نورا عن أقاحيها","https://www.aldiwan.net/poem52974.html","البسيط"],[580,"اللؤلؤ الرطب حب","https://www.aldiwan.net/poem2738.html","المجتث"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138245",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122662","البسيط"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110428","البسيط"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110390","البسيط"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96980","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87260","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38939","الرجز"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38158","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38962","البسيط"],[1113,"","https://poetry.dctabudhabi.ae/diwan/poem/101185","السريع"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46537","الرجز"],[1376,"","https://poetry.dctabudhabi.ae/diwan/poem/118080","البسيط"],[1415,"","https://poetry.dctabudhabi.ae/diwan/poem/102301","الكامل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87840","الكامل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52087","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48255","الكامل"],[2673,"","https://poetry.dctabudhabi.ae/diwan/poem/70318","البسيط"],[2708,"","https://poetry.dctabudhabi.ae/diwan/poem/80426","الرجز"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58509","السريع"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26117","البسيط"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74097","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62925","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109976","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110057","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110006","الخفيف"],[3763,"","https://poetry.dctabudhabi.ae/diwan/poem/124163","الكامل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95321","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69977","الوافر"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77023","الكامل"],[4024,"","https://poetry.dctabudhabi.ae/diwan/poem/203806",""],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90852","الكامل"],[4693,"عتاب","https://www.poetsgate.com/ViewPoem.aspx?id=53819",""],[1901,"لا تعجبوا إن قلتُ بانتْ سعادْ","https://www.poetsgate.com/ViewPoem.aspx?id=160414",""],[5055,"( م . س . س )","https://www.poetsgate.com/ViewPoem.aspx?id=104296",""],[5183,"الموقف الحق","https://www.poetsgate.com/ViewPoem.aspx?id=180156",""],[5230,"أوصاف الخيل","https://www.poetsgate.com/ViewPoem.aspx?id=12271",""],[5252,"اشلونك","https://www.poetsgate.com/ViewPoem.aspx?id=36106",""],[5271,"الى/ لئيمة","https://www.poetsgate.com/ViewPoem.aspx?id=67533",""],[307,"وجوه في المرايا","https://www.poetsgate.com/ViewPoem.aspx?id=214163",""],[3294,"قد بت طول الليل ساهر","https://www.poetsgate.com/ViewPoem.aspx?id=173268",""],[5606,"سوق التداول كلما ينتفض طاح","https://www.poetsgate.com/ViewPoem.aspx?id=199201",""],[5695,"براءة ووفاء..","https://www.poetsgate.com/ViewPoem.aspx?id=212553",""],[5704,"مصر أم الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=192534",""],[5776,"خاتمٌ بلا إصبع","https://www.poetsgate.com/ViewPoem.aspx?id=199329",""],[5956,"أحسِنْ إلى الفقراء وابعدْ عنهمو","https://www.poetsgate.com/ViewPoem.aspx?id=207268",""],[6093,"بئرٌ معطلةٌ ( الكامل )","https://www.poetsgate.com/ViewPoem.aspx?id=176094",""],[6093,"اللومُ عنديَ أنْ تفنى على طللِ (البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176200",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577049",""]],"verses":[["اللورق الهواتف أم لباك","عمٍ عما بُزَنُ به غفولُ",0,"ل",1,1],["اللَومُ لِلعاشِقينَ لومُ","لِأَنَّ خَطبَ الهَوى عَظيمُ",1,"م",1,1],["اللُؤمُ خَيرٌ مِن ثَقيفٍ كُلِّها","حَسَباً وَما يَفعَل لَئيمٌ تَفعَلِ",2,"ل",1,1],["اللورد قال صراحة","زغلولنا سنجربه",3,"ب",2,1],["اللَواتي يَنظُرنَ بِالنَظَرِ الفا","تِرِ مِن أَعيُنِ الظِباءِ الحورِ",4,"ر",1,0],["اللَومُ مِنكَ وَإِن نَصَحتَ غَرامُ","إِذ حَظُّهُ مِن مِثلِيَ الإِرغامُ",5,"م",1,1],["اللّواتي تَبعثُ الشرَّ فإن","عَصَفَ الشَرُّ تولَّتْ تركُدُ",6,"د",1,0],["اللّواتي مَرَقْنَ من أضْلُعِ النّصْ","رِ لهُ أسهُماً على المُرّاق",7,"ق",1,0],["اللؤم داءٌ في النفوس عياء","لم يَشفِ منه سوى الحمامِ دَواءُ",8,"ا",2,1],["اللَؤمُ أَكرَمُ مِن وَبرٍ وَوالِدُهُ","وَاللُؤمُ أَكرَمُ مِن وَبرٍ وَما وَلَدا",9,"د",2,1],["اللومُ إِغراءٌ إذا اشتدَّ الهوى","والعذل فيه إذا طغى تحريضُ",10,"ض",1,0],["اللوح فيه ظاهر لأنه","منه وفيه وعليه ذكره",11,"ر",2,0],["أَلِلوَصِيِّ حينَ في مِحرابِهِ","عُمِّمَ بِالسَيفِ وَلَمّا يَركَعِ",12,"ع",1,0],["اللَّوذَعِيُّ الفاضلُ القطب الَّذي","مَلَكَت يَداهُ الفَضلَ دونَ مَناظرِ",13,"ر",1,0],["اللَوذَعِيُّ الأَريَحِي","يُ القُلَّبِيُّ الحُوَّلُ",14,"ل",1,0],["اللَوْذعي الذي في مِصرَ مَجلِسُهُ","وذِكرُهُ لا يَزالُ الدَّهرَ في سَفَرِ",15,"ر",1,0],["اللَوْذعيُّ الكاملُ الفَرْدُ الذي","أفعالُهُ يَغلِبْنَ قولَ الشاعرِ",16,"ر",1,0],["اللوذعيُّ العزيزُ الباسلُ المَلِكُ ال","غازي المَلا بِيَدٍ حَسْبي أياديها",17,"ي",3,0],["اللؤلؤُ الرَّطْبُ حَبٌّ","في رَاحَتي نَفَائِسْ",18,"س",1,1],["اللوذعيّ الألمعيّ يزينه","أدب يفوق لآلئاً وزبرجدا",19,"د",2,0],["اللَّوذَعيُّ الَّذي حَقًّا يَكادُ عَلَى","ما في قُلُوبِ جَميعِ النّاسِ يَطَّلِعُ",20,"ع",1,0],["اللوذعيُّ الذي الزورآءُ وأهليها","وصيتهُ سَار في أَقصَى ضواحيها",21,"ي",3,0],["اللوذعيُّ الذي في مصرَ مسكنُهُ","وذكرُهُ كعبيرٍ في الورى انتشرا",22,"ر",2,0],["اللؤم شأني والمكارم شأنكم","وعلى سجيتها البرية تعمل",23,"ل",1,0],["اللوذعيّ الأَلمعيّ الجهبذي","تاج الفَخار مِن الزَمان بِهِ عَلا",24,"ل",2,0],["اللَوذَعِيُّ الناقِدُ البَصيرُ","بَحرُ العُلومِ الحافِظُ الخبيرُ",25,"ر",1,0],["اللّوذَعِيُّ الأَديبُ الألمعيّ وَمَن","قَد كُحِّلت بالتّقى نوراً بصائِرُهُ",26,"ر",2,0],["اللوذعي الذكيّ الفذّ في زمني","فَقَلَّ مثلاً وَأَضحى الأَوحد الفَردا",27,"د",2,0],["اللون لون المسك في خده","والريح ريح المسك من خاله",28,"ه",1,0],["اللوم سوء المهلكه","مَع الأَماني المهلكه",29,"ه",1,0],["اللوز أشجارهُ نشاوى","بميل أغصانه الرطاب",30,"ب",1,1],["اللون تبر والحقيقة جوهر","والريح مسك والمذاقة فوفل",31,"ل",1,0],["اللوم يمضي بالهوى","وكن عَلَى عهدي ملازم",32,"م",1,0],["اللَوذِعِيِّ فَما يُشَقُّ غُبارُهُ","هُوَ وَالعُلى في بُردَةٍ أَخماسِ",33,"س",1,0],["اللَّوْذَعِيُّ الأصْرم الأذْكَى الذي","مَا يَنبَغِي لِسِوَى ذكَاه ركُونُ",34,"ن",1,0],["اللوذعي الملكِ الشريفِ مُبَدِّدِ ال","أعداءِ قاطبة بحدِّ المشرفي",35,"ف",2,0],["اللومُ أَشبه بي منها وإِن ظلمت","أنا الذي سقتُ حَتفي في الهوى بيدي",36,"د",2,0],["اللوز في كَيْلوسِه محمود","لا سيما اخْضَرُه الجدِيدُ",37,"د",1,0],["اللونُ لونُ الدَّمِ مِن خَدِّه","والرِّيَحُ ريحُ المسكِ من خالِهِ",38,"ه",1,0],["اللُؤمُ أَنكَحَها وَاللُؤمُ أَلقَحَها","وَكُلُ فَحلٍ لَهُ مِن ضَربِهِ قَدَرُ",39,"ر",1,0],["اللَواتي إِذا تَبَدَّت عَلى النا","س أَرتهم في بردك الخلفاءَ",40,"ا",2,0],["أللواتي يحفَظنَ عهدَكَ بالغَي","بِ ويَرعينَ سِرَّ كلِّ خليلِ",41,"ل",1,0],["اللوذعيُّ الأَلمعيُّ الأَريحيُّ","المولويُّ السُؤدُديُّ الأكبرُ",42,"ر",1,0],["اللَوذَعُ الشهم الشجيع الأَروَعُ ال","قَرمُ الذريعُ الأَمنَعُ اللَيثُ البَطَل",43,"ل",1,0],["آلَ لُوطٍ كأَنَّما من ثراكم","كُوِّنَ اللائطونَ اهلُ النِفاقِ",44,"ق",1,0],["اللؤم فيك لجاجة من عاشق","وافى يخادعني بلفظ العاذل",45,"ل",1,1],["اللون برق مختلس","والصوت رعد مرتجس",46,"س",1,0],["اللوذعُ الشَهمُ الهمامُ وَزيرُنا","وَمجيرنا المَرجُوُّ حصن ضَمانِهِ",47,"ن",2,0],["اللَوذعيّ المُصقع اللِسن الَّذي","قَد حازَ ما بَينَ الوَرى تَفضيلا",48,"ل",2,0],["اللون، والقد الرشي","ق، وطرفه إذ يرمق",49,"ق",1,0],["اللوذعي الألمعي","ي فطانة وتأملا",50,"ل",2,0],["اللوم ليس على العدو فطالما","صنع الغزاة لغزوهم أسباب",51,"ب",1,0],["اللوم قد يَقصِر عن ردِّها","وربما جاءَ بعكسِ المراد",52,"د",1,0],["اللوحة أللي ترجمة .. ويل","نقرأ .. معانيها ولختام",53,"م",1,0],["اللؤم يدنيه إلى طبعه","واللوم يثنيه عن الحُجب",54,"ب",1,0],["اللون وجه اللي غدا شمله اشتات","وإلاّ كما بنّ اليمن وسط دلّه",55,"ل",2,0],["اللون ذا ماهوب من لونك","خيرتك بوصلي وهجراني",56,"ن",2,0],["اللؤمُ طَبعكِ والمَكَارمُ سَاحَتي","(إنْ أَنتَ أَكرمتَ اللئيمَ تَمَرّدا)",57,"د",2,0],["اللونُ قشرُ الموزِ حين بلوغهِ","والجسمُ من حملِ الخطوبِ كليلُ",58,"ل",1,0],["اللوم في شرع الهوى","يالائمي إحدى الكبائر",59,"ر",1,0],["اللون الأحمر نعرفه دم وجراح","وأول ضحايا السوق ناسٍ فقيره",60,"ر",2,0],["اللّونُ زَهرٌ والقصيدُ سِلالُ","والجمعُ بينَ الصّورتيْنِ كَمالُ",61,"ل",1,1],["اللؤم بادٍ وحبل الوصل منقطع","والكل أمسى له في الغدر أنصارُ",62,"ر",1,0],["اللّوحةُ تَنطقُ بالآتي","والآتي عنها لا يعلَمْ!!!",63,"م",1,0],["اللؤم يأتي من فقيرٍ جاحدٍ","لا مِن فقيرٍ عابدٍ يتألمُ",64,"م",1,0],["اللَّوْذَعيُّ إذا تحدث في الورى","قلتَ :المحدثُ للورى سَحْبَانُ",65,"ن",1,0],["اللومُ عنديَ أنْ تفنى على طللِ","وأنْ تذوبَ لبخل اللُعْس بالعسلِ",66,"ل",1,1],["اللواليح غربان دمن مسهيه","عَلى الصُبح يَوم ان شيلوا من الدار",67,"ر",1,0]]}