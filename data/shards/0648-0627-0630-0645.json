{"poems":[[14,"ألا إن أصحاب الكنيف وجدتهم","https://www.aldiwan.net/poem38287.html","الطويل"],[85,"صغار في الذهاب وفي الإياب","https://www.aldiwan.net/poem7585.html","الوافر"],[45,"ما لنا من أبي المعمر إلا","https://www.aldiwan.net/poem11051.html","الخفيف"],[169,"من ذا أفتاك بسفك دمي","https://www.aldiwan.net/poem1682.html",""],[182,"من آل نابلسي الأمجاد مرتحل","https://www.aldiwan.net/poem61103.html","البسيط"],[281,"إذا ما علا يأسي يغالب لي الرجا","https://www.aldiwan.net/poem1362.html",""],[297,"وعلى سلبها الوقار فكم أه","https://www.aldiwan.net/poem33165.html","الخفيف"],[357,"أضاء ببرقة برق لموع","https://www.aldiwan.net/poem4163.html","الوافر"],[377,"لنا الحجر المرموز في الكتب سره","https://www.aldiwan.net/poem59333.html","الطويل"],[403,"مرحبا يا مرحبا يا مرحبا بنسيم","https://www.aldiwan.net/poem34146.html","الرمل"],[453,"ست من السنوات جاوز عمرها","https://www.aldiwan.net/poem61591.html","الكامل"],[458,"علمتها الأيام أن تتجنى","https://www.aldiwan.net/poem55839.html","الخفيف"],[575,"يا منية القلب لولا أن يقال سلا","https://www.aldiwan.net/poem2902.html","البسيط"],[575,"قتلي لحبكم شهادة","https://www.aldiwan.net/poem3076.html","مجزوء الكامل"]],"verses":[["وَإِذ ما يُريحُ الحَيَّ صَرماءُ جونَةٌ","يَنوسُ عَلَيها رَحلُها ما يُحَلَّلُ",0,"ل",1,0],["وإذ ملئت لك الدينا نفاقا","وضاقت بالغباوة والتغابي",1,"ب",2,0],["وَأَذَمُّ الفِتيانِ مَن باتَ يُلقى","دونَنا سِترُهُ وَيُغلَقُ بابُه",2,"ب",2,0],["وَأَذَمَّ لِمَن أَضحى بِحِبا","هُ عَلى الأَيّامِ فَلَم يَرِمِ",3,"م",1,0],["وَإِذ مَضى نَحوَ باريهِ فَأَنزَلَهُ","في جَنَّةٍ رُفَعَت فيها لَهُ الدّرَجُ",4,"ج",1,0],["وإذ ما كرهت الأمر فارضَي وسلمي","ففي طيِّه المحبوب يأتيك مدرجا",5,"ج",2,0],["وأَذمَّت كرامَ قَومٍ فذُمَّت","وَذمامُ الكرام غيرُ ذميمِ",6,"م",1,0],["وَإذ مَرمَى غَوَانِيهِ قَرِيبٌ","إلَيهِ وَخَطوً هِمَّتِهِ ذَرِيعُ",7,"ع",1,0],["وإذ مات عبداً مُبدَعاً متألماً","فقام إلهاً مبدِعَ الكون صائغا",8,"غ",2,0],["وأذم الدهر إذ ساعدني","بسعاد فرشفت الشنبا",9,"ب",2,0],["وإذ مضيتُ إلى الفناء وهبتها","في الغربتينَ هواىَ دون فناء",10,"ا",2,0],["وأذمُّ الدنيا وللناس آذا","نٌ بواقٍ إذا عُذلنَ سمعنا",11,"ن",2,0],["وإِذ مغانِيكِ بالأَنوار زاهرةٌ","حتَّى لقد خِلْتُ في مَغْنَاكِ مفْنَاكِ",12,"ك",1,0],["وأَذُمُّ مِن حالِي تشعُّثَها","ومِنْ أَمْري فساده",13,"د",2,0]]}