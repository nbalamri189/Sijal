{"poems":[[14,"ألا إن أصحاب الكنيف وجدتهم","https://www.aldiwan.net/poem38287.html","الطويل"],[87,"صغار في الذهاب وفي الإياب","https://www.aldiwan.net/poem7585.html","الوافر"],[47,"ما لنا من أبي المعمر إلا","https://www.aldiwan.net/poem11051.html","الخفيف"],[173,"من ذا أفتاك بسفك دمي","https://www.aldiwan.net/poem1682.html",""],[186,"من آل نابلسي الأمجاد مرتحل","https://www.aldiwan.net/poem61103.html","البسيط"],[286,"إذا ما علا يأسي يغالب لي الرجا","https://www.aldiwan.net/poem1362.html",""],[302,"وعلى سلبها الوقار فكم أه","https://www.aldiwan.net/poem33165.html","الخفيف"],[362,"أضاء ببرقة برق لموع","https://www.aldiwan.net/poem4163.html","الوافر"],[382,"لنا الحجر المرموز في الكتب سره","https://www.aldiwan.net/poem59333.html","الطويل"],[409,"مرحبا يا مرحبا يا مرحبا بنسيم","https://www.aldiwan.net/poem34146.html","الرمل"],[458,"ست من السنوات جاوز عمرها","https://www.aldiwan.net/poem61591.html","الكامل"],[463,"علمتها الأيام أن تتجنى","https://www.aldiwan.net/poem55839.html","الخفيف"],[580,"يا منية القلب لولا أن يقال سلا","https://www.aldiwan.net/poem2902.html","البسيط"],[580,"قتلي لحبكم شهادة","https://www.aldiwan.net/poem3076.html","مجزوء الكامل"],[754,"","https://poetry.dctabudhabi.ae/diwan/poem/18849","الطويل"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137755",""],[905,"","https://poetry.dctabudhabi.ae/diwan/poem/146462","السريع"],[1039,"","https://poetry.dctabudhabi.ae/diwan/poem/203946","المتقارب"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202130","الرجز"],[1181,"","https://poetry.dctabudhabi.ae/diwan/poem/204067","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55930","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112819","الخفيف"],[1433,"","https://poetry.dctabudhabi.ae/diwan/poem/90579","المتقارب"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49938","الطويل"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26669","الكامل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118350","الخفيف"],[1929,"","https://poetry.dctabudhabi.ae/diwan/poem/110689","الطويل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110273","السريع"],[2096,"","https://poetry.dctabudhabi.ae/diwan/poem/144614","الطويل"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21434","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134204","الطويل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103908","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86307","الطويل"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45918","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94969","الوافر"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146754","الكامل"],[4984,"نذيرُ الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=175528",""],[5419,"لماذا أنت بالذات؟","https://www.poetsgate.com/ViewPoem.aspx?id=31454",""],[5419,"الموت","https://www.poetsgate.com/ViewPoem.aspx?id=32220",""],[5419,"في عيادة طبيب الأطفال ... ( شعر للأطفال )","https://www.poetsgate.com/ViewPoem.aspx?id=71146",""],[470,"يا شيخ شعري","https://www.poetsgate.com/ViewPoem.aspx?id=178095",""],[5605,"بنا عجب","https://www.poetsgate.com/ViewPoem.aspx?id=159671",""],[5725,"شحرورة","https://www.poetsgate.com/ViewPoem.aspx?id=195122",""],[5956,"القهوة وكف المحبوب","https://www.poetsgate.com/ViewPoem.aspx?id=182087",""],[6229,"أمّتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65214&r=&rc=37",""]],"verses":[["وَإِذ ما يُريحُ الحَيَّ صَرماءُ جونَةٌ","يَنوسُ عَلَيها رَحلُها ما يُحَلَّلُ",0,"ل",1,0],["وإذ ملئت لك الدينا نفاقا","وضاقت بالغباوة والتغابي",1,"ب",2,0],["وَأَذَمُّ الفِتيانِ مَن باتَ يُلقى","دونَنا سِترُهُ وَيُغلَقُ بابُه",2,"ب",2,0],["وَأَذَمَّ لِمَن أَضحى بِحِبا","هُ عَلى الأَيّامِ فَلَم يَرِمِ",3,"م",1,0],["وَإِذ مَضى نَحوَ باريهِ فَأَنزَلَهُ","في جَنَّةٍ رُفَعَت فيها لَهُ الدّرَجُ",4,"ج",1,0],["وإذ ما كرهت الأمر فارضَي وسلمي","ففي طيِّه المحبوب يأتيك مدرجا",5,"ج",2,0],["وأَذمَّت كرامَ قَومٍ فذُمَّت","وَذمامُ الكرام غيرُ ذميمِ",6,"م",1,0],["وَإذ مَرمَى غَوَانِيهِ قَرِيبٌ","إلَيهِ وَخَطوً هِمَّتِهِ ذَرِيعُ",7,"ع",1,0],["وإذ مات عبداً مُبدَعاً متألماً","فقام إلهاً مبدِعَ الكون صائغا",8,"غ",2,0],["وأذم الدهر إذ ساعدني","بسعاد فرشفت الشنبا",9,"ب",2,0],["وإذ مضيتُ إلى الفناء وهبتها","في الغربتينَ هواىَ دون فناء",10,"ا",2,0],["وأذمُّ الدنيا وللناس آذا","نٌ بواقٍ إذا عُذلنَ سمعنا",11,"ن",2,0],["وإِذ مغانِيكِ بالأَنوار زاهرةٌ","حتَّى لقد خِلْتُ في مَغْنَاكِ مفْنَاكِ",12,"ك",1,0],["وأَذُمُّ مِن حالِي تشعُّثَها","ومِنْ أَمْري فساده",13,"د",2,0],["وَإِذ مالَهُم في النائِباتِ تلادَهُم","لِفَكِّ العُناةِ أَو لِكَشفِ المَغارِمِ",14,"م",1,0],["وإذ ملأ الناس روح السكينه","عدوا كالجحافل نحو المدينه",15,"ن",2,1],["وإذ مغاني اللهو مأهولة","وليل فودي حالك أليل",16,"ل",1,0],["وإذ موردي من رضاب الثغور","وإذ مرتعي من ثمار النهود",17,"د",1,0],["وإذ مضى هذا فأما بعد","فإنني لآل طه عبد",18,"د",1,0],["وإذ مررت على زرود فلا تغر","بالمشي فيه موائل الأغصان",19,"ن",1,0],["واذمّ دهراً ليس فيه للفتى","الاّ الشقا ثم العنا ثم التعبْ",20,"ب",1,0],["وإذ ما بدت لربع حبيب ال","قلب للعيون شراف البَوَاد",21,"د",1,0],["وإذ ميعَةُ اللَّهوِ تَجري بنا","وَحيلُ الوِصال مَتينُ القُوَى",22,"ا",1,0],["وأَذمَمْتُهم حتَّى توّهمَت إنَّما","خُلقنَ لتأليف الهِجاءِ القَرائِحُ",23,"ح",1,0],["وأذمَّةٌ في سرِّ لخمٍ طالما","خَدَمَت رعايةَ حقّها الأمراء",24,"ا",2,0],["واذ ما دهاك سفاح دمع","غادر الصبر كالحمار اسيرا",25,"ر",2,0],["وإذ مورد اللذات صاف وناظري","يزيل قذاه منظر منكم نضر",26,"ر",1,0],["واذ مرأت عند انتصاف النهار","أن فريداً مغرق في السيكون",27,"ن",1,0],["وإذ مركبي طرف من الجهل جامح","على الحلم في مضماره ما يصده",28,"د",2,0],["وَإِذ ما يَقولُ النّاسُ شيءٌ مُهَوَّنٌ","عَلَينا وإِذ غُصنُ الشَّبابِ رَطيبُ",29,"ب",1,0],["وإذ مانحا ناح إلى درسه بدا","بتصريف ترصيف التصانيف راشدا",30,"د",2,0],["وإذ مشلنا باقٍ جميع محسد","ولم تقتطع ذاك الدهور الدهارس",31,"س",1,0],["وَاِذ مَنَعتني عَن هَواها مَوانِعي","تَجافَت جُنوبي في الهَوى عَن مَضاجِعي",32,"ي",1,0],["وَإِذ ما أَتَيتُ المُصطَفى وَضَريحَهُ","فَبَلِّغْ سَلامي لِلنَّبِيِّ مُحَمَّدِ",33,"د",1,0],["وإذ من تومجان وآل كوسا","وآل قراعلي سكنوا الرموسا",34,"س",2,1],["وأذم أيام الفراق فإنها","علل وإن خفيت على العواد",35,"د",1,0],["وإذ مالت الشمس نحو المغيب","إلى البحر تحنو له جانحهْ",36,"ح",2,1],["وإذ ما الشعر عاندني","لماذا أنت أبياتي؟",37,"ت",2,0],["وإذ ما تخيَّر منَّا رفيقاً","فما من سبيلٍ سوى أنْ يموتا",38,"ت",2,0],["وإذ ما تذوقت مرّ الدواءِ","تذكر حلاوة طعم الشفاءْ",39,"ا",2,0],["وإذْ مُهاجرةُ الأطيار تبلغُها","تبكي وتُمعنُ عن قيعانِها هرَبا!",40,"ب",2,0],["وإِذْ ما الغربُ خَيَّرَهُمْ","فَرِيْحُ الغَرْبِ قد ركبوا",41,"ب",3,0],["واذمها اخشى الوشاة نكايةً","وهي التي في كل شئ تحمدُ",42,"د",1,1],["وإذْ مخيلتي في الحالِ تنبترُ","وإذْ بأجنحتي في الحال تنكسرُ",43,"ر",1,0],["وإذ مصّممةُ الأزياءِ تُفْزِعهم","بموقفٍ لفتاة العصرِ مُنفرِد",44,"د",1,0]]}