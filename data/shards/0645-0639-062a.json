ewPoem.aspx?id=130158",""],[242,"مات الحفيظ فمن يحفظ من عاشا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563799",""],[572,"عَجِبَتْ من قَنَاعَتي وقُعُودي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9230&r=&rc=87",""],[572,"وَيْلاهُ من قلبي ومن كبدِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9239&r=&rc=96",""]],"verses":[["مُعتادَةٌ شُربَ الدَما","ءِ وَعِندَها الماءُ المَعينُ",0,"ن",1,0],["مُعتَجِراً بِاللَيلِ أَحدو بِهِ","بِزلاءَ تَستَولي عَلى الحادي",1,"د",2,0],["مُعتَقِلٍ خَطِّيَّةً لَدْنَةً","تَفجَعُ أَبداناً بِأَرواحِ",2,"ح",1,0],["معتّقَةً جسّمَتْها اليَهودُ","ومنْ بعْدِها ثلّثَتْها النّصارى",3,"ر",2,0],["مُعَتَّقاً قَبلَ عادٍ","في مُظلِماتِ الحُبوسِ",4,"س",1,0],["مُعتَضِدٌ بِاللَهِ إِحسانُهُ","جَمٌّ إِذا ما الدَهرُ يَوماً أَسا",5,"س",2,0],["معتقة من ذوي الحجب في","يمين محجّبة عاتق",6,"ق",1,0],["معتصماً بالكرمِ المؤيد","مصلي الحمد على محمد",7,"د",1,0],["مُعْتَادَةٌ قَنَصَ الأبْطال شِكَّتُهُ","يرى الطِّرادَ غداة الرَّوعِ كالطَّرَدِ",8,"د",1,0],["مُعتمدٌ لم يزلْ عميداً","ينطقُ عن فضله البيان",9,"ن",1,0],["مُعتزليٌّ مُسِرُّ كُفرٍ","يُبدي ظُهوراً لها بطونُ",10,"ن",1,0],["مُعَتَّقَةً مِن أَذرِعاتٍ هَوَت بِها الر","رِكابُ وَعَنَّتها الزِقاقُ وَقارُها",11,"ر",3,0],["مُعَتَّقَةً كالتِبرِ أَمّا بُخارُها","فَضَخمٌ وَأَمّا جِسمُها فَدَقيقُ",12,"ق",1,0],["مُعتَمدُ الأَركان وَالقَواعِدِ","وَسَنَدُ العالي بِهن الصاعِدِ",13,"د",1,0],["مُعتَكِرَ الفُؤادِ","مُضَيِّعَ الوِدادِ",14,"د",1,0],["مُعتَمِدٌ فيهِمِ عَلى اللَهِ تَنقا","دُ إِلى سَيبِهِ فَتَعتَمِدُه",15,"د",2,0],["مُعتَصِبٌ بِرِداءِ المُلكِ يَتبَعُهُ","مَوجٌ تَرى فَوقَهُ الراياتِ وَالقَتَرا",16,"ر",2,0],["مُعَتَّقَةٌ أَفنى الجَديدَ عَتيقُها","وَأَبى صَميماً مِن حُشاشَتِها لُبّا",17,"ب",2,0],["مُعتَقِداً فيهِ ما تَحَقَّقَ لي","مِن وُدِّهِ وَهوَ فِيَّ مُعتَقِدُ",18,"د",1,0],["مُعَتَّقَةٌ لَو غَسَّلوا مَيِتاً بِها","لَما ذابَ مِنهُ المُخُّ وَاِنهَشَمَ العَظمُ",19,"م",1,0],["مُعتَدِلُ القَدِّ عَلَيهِ كُمَّةٌ","فَهوَ بِها كَالأَلِفِ المُشَدَّدِ",20,"د",1,0],["مُعتادَةً تَهَبُ الحَليلَ صَداقَها","فَخراً عَلى الأَكفاءِ وَالأَقرانِ",21,"ن",1,0],["معتادةً أكْلَ لحوم العدى","غدت خماصاً ثم راحت بطان",22,"ن",1,0],["معتَّقَةٌ شُقّ عنها الثّرَى","وحيّ السرور بها في دفين",23,"ن",1,0],["مُعَتّقَةً حمراءَ ينساغُ صِرْفها","إذا الماءُ فيها بالمزاج تَصَرّفا",24,"ف",2,0],["مُعَتَّقَةٍ حمراءَ تنْشُرُ فضْلَها","لِخُطّابها في اللَّونِ والطَّعمِ وَالنَّشرِ",25,"ر",1,0],["معتّقةٌ دعْ ذكر أحْقابِ عُمرها","فقد مُلئتْ منها أناملُ حاسِبِ",26,"ب",1,0],["مُعتّقة في يَدَيْ راهبٍ","على دنّها ختْمُهُ بالصّليبِ",27,"ب",1,0],["مُعتَدِلٌ لَم يَعتَدِل عَدلُهُ","في عاشِقٍ طالَ بِهِ خَبلُهُ",28,"ل",2,1],["مُعتَدِلٌ كَالغُصنِ الناضِرِ","أَبلَجُ مِثلُ القَمَرِ الزاهِرِ",29,"ر",1,1],["مُعَتَّقَةً إِذَا سَلَكَتْ ضَمِيراً","مَحَتْ عَنْهُ الْكَلالَةَ وَالسَّآمَهْ",30,"م",2,0],["مُعْتَدِلٌ طَوْراً وَطَوْرَاً مَائِلُ","تَهْفُو بِهِ الْجَنُوبُ وَالشَّمَائِلُ",31,"ل",1,0],["مُعتَدِلاً مُعتَدِياً في الهَوى","أَحبِب بِهِ مُعتَدِلاً مائِلا",32,"ل",2,0],["مُعَتَّقَةٌ صاغَ المِزاجُ لِرَأسِها","أَكاليلَ دُرٍّ ما لِمَنظومِها سِلكُ",33,"ك",1,0],["مُعتَرِفاً بِالشَوقِ مُكتَئباً","أَشكو إِلى اللَهِ لا إِلى أَحَدِ",34,"د",1,0],["مُعتَرِضاً بِفَجرِهِ في لَيلَةٍ","كَفَرَسٍ بَيضاءَ دَهماءَ اللَبَب",35,"ب",1,0],["مُعَتَّقَةٌ حَمراءُ وَقدَتُها جَمرُ","وَنَكهَتُها مِسكٌ وَطَلعَتُها تِبرُ",36,"ر",1,0],["مُعَتَّقَةً كَما أَوفى لِنوحٍ","سِوى خَمسينَ عاماً أَلفُ عامِ",37,"م",1,0],["مُعْتَقَلٌ لَكِنَّهُ مُطْلَقٌ","يَجُولُ في مَسْكَنِهِ سَرْمَدَا",38,"د",2,0],["مُعْتَدِلُ الْقَامَةِ ذُو لَحْظَةٍ","تَعَلَّمَ الْخَطِّيُّ مِنْهُ الْمَضَا",39,"ض",2,0],["مُعَتَّقَةٍ كَانَتْ ذَخِيرَةَ مَعْشَرٍ","لأَبْنَائِهِمْ فِي جَوْفِ أَقْتَمَ كَابِي",40,"ب",2,0],["مُعْتَدَّةً بِجَلاَلِ مَصْدَرَهَا","مُعْتَزَّةً بِفَصَاحَةِ العَرَبِ",41,"ب",1,0],["مُعْتَصِمٌ بِالخَيْرِ مَا اسْطَاعَهُ","وَلَيْسَ لِلشَّرِّ بِمُسْتَنْزِلِ",42,"ل",1,0],["مُعْتَمِدٌ فينَا عَلى الله قَدْ","أيّدَهُ الله بعَقْدٍ وَثيقْ",43,"ق",1,0],["معتادة ً أكْلَ لحوم العدى","عذت خماصا ثم راحت بطان",44,"ن",1,0],["معتمداً ما ساءني لا حائدا","عنهُ تُراعي الحُرم التلائدا",45,"د",2,0],["معتدل الشيمة حتى إبْلُه","سِيرتُها بين الرسيم والعَنَقْ",46,"ق",1,0],["معترفٌ بالحقّ من قبل أن","يوجَبَ للصاحب أن يُفرَضا",47,"ض",2,0],["معتّقة من قبل كسرى مصونة","وما ضمّها دنّ ولا نالها عصر",48,"ر",1,0],["مُعتَّقَةٌ لَم يَفضُضِ الدَهرُ خَتمَها","وَقَد عاصَرَت عَدنانَهُ وَنِزارَهْ",49,"ر",2,0],["معتدل القد غصن بان","عليه قد هاجت البلابل",50,"ل",1,0],["مُعَتِّقُها أبو جَهْلٍ","فَلَمْ تُوصَفْ بأمثَالِ",51,"ل",1,0],["مُعَتَّقَةً أَفْنى الزمانَ وجودُها","فجاءت كفَوتِ اللحظِ أورِقَةِ العشقِ",52,"ق",1,0],["مُعَتَّقَةً مِن هَدايا القسوس","تَجلُّ عَنِ الوَصفِ أَن تشتَرى",53,"ر",2,0],["مُعْتَقِداً أَنَّهُ وَإِنْ بَلَغَتْ","فِيهِ الْبَلاَغَةُ لاَ يُحَدِّدُهَا",54,"د",3,0],["مُعْتَصِماً بِبَقَايَا الصَّبْرِ مِنْ كَمَدٍ","أَوْدَى بِمُعْظَمِهِ إِذِ الْحَشَا حَاشَا",55,"ش",2,0],["مُعتَّقةٌ أجدَّت كلَّ بالٍ","وصيَّرَتِ الحصى ذَهباً لبيسا",56,"س",2,0],["مُعتَمدٌ مِن شَأْنِهِ","رَعيُ العُهُودِ وَالذِّمَمْ",57,"م",1,0],["مُعتَمَدُ المُلكِ شُجاعٌ فَما","يُقَعقِعُ الدَهرُ لَهُ بِالشِنان",58,"ن",1,0],["مُعتَقِلٌ مِن قَدِّهِ ذابِلاً","وَلَحظُهُ أَمضى مِنَ المِخذَمِ",59,"م",1,0],["مُعتَقِدٌ أَنَّ دَمي صارَ في","حُكمِ الهَوى حِلّاً وَوَصلي حَرام",60,"م",1,0],["مُعَتَّقَةً كُمَيتَ اللَّونِ صِرفاً","مِنَ المِسكِ الذَكِيِّ لَها خِتامُ",61,"م",1,0],["مُعَتَّقَةً مِن صَيدِنايا سَبَأتُها","يَهُزُّ بِها الرّاووقُ أَعطافَ إِبليسا",62,"س",2,0],["مُعَتَّقَةً كميت اللَونِ يَبدو","بِها الضِّدانِ مِن ماءٍ وَنارِ",63,"ر",1,0],["مُعَتَّقَةٌ صَهباءَ تَحسَبُ أَنَّها","مِنَ اللُطفِ في فِعلِ الزُجاجِ ضَميرُ",64,"ر",1,0],["مُعَتَّقَةٍ كُمَيتِ اللَونِ صِرفٍ","تُلَعثِمُ مِقوَلَ اللَقِنِ الفَصيحِ",65,"ح",1,0],["مُعتَقِلاً رُمحَ عُقَيلٍ طالِباً","لِطالِبٍ وَجَعفَراً مِنَ البِحَر",66,"ر",1,0],["مُعتصِميُّ العَزْمِ حَثَّ خيلَهُ","للغَوْوِ حتّى حازَ حُسنَ مُنقلَب",67,"ب",1,0],["معترف بالذنب والعيب والوزر حقا","صدق لست فيه شاك",68,"ك",1,0],["معترفاً بأنه مصحف","في كل ما يقول محرف",69,"ف",1,0],["معتَّقَةً تُسَرُّ النفسُ فيها","وقد طافت بها حسناءُ رُود",70,"د",1,0],["معتقلاً أسنَّةً خطَّيةً","كأن في طعانها سفع الذك