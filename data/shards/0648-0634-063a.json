{"poems":[[9,"ما تعيف اليوم في الطير الروح","https://www.aldiwan.net/poem21921.html","الرمل"],[53,"كان أناس يرون أني في","https://www.aldiwan.net/poem65695.html","المنسرح"],[87,"علمت بالقلم الحكيم","https://www.aldiwan.net/poem63745.html","مجزوء الكامل"],[45,"أحاد أم سداس في أحاد","https://www.aldiwan.net/poem9539.html","الوافر"],[30,"وشغلت عن حسب الكرام وما بنوا","https://www.aldiwan.net/poem5477.html","الكامل"],[51,"يا ساكن الدنيا لقد أوطنتها","https://www.aldiwan.net/poem62017.html","الكامل"],[51,"يا واعظ الناس قد أصبحت مهتما","https://www.aldiwan.net/poem63194.html","البسيط"],[46,"صحبي قفوا مليتكم صحبا","https://www.aldiwan.net/poem30062.html","السريع"],[35,"وشغلت عن فهم الحديث سوى","https://www.aldiwan.net/poem25832.html","الكامل"],[48,"متى نشأت ريح لقدرك بابعثي","https://www.aldiwan.net/poem23204.html","الطويل"],[92,"سامراء","https://www.poetsgate.com/ViewPoem.aspx?id=179132",""],[343,"كفلت لطالب الدنيا بهم","https://www.aldiwan.net/poem68734.html","السريع"],[463,"متى وصلت تحية مستهامِ","https://www.aldiwan.net/poem55870.html","الوافر"],[463,"بالغور ما شاء المطايا والمطر","https://www.aldiwan.net/poem56190.html","الرجز"],[556,"خذ صاحبي عني الذي أملي","https://www.aldiwan.net/poem47284.html","أحذ الكامل"],[563,"إني أنا لست أنا","https://www.aldiwan.net/poem33847.html","مجزوء الرجز"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87132","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48743","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48650","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77621","الرجز"],[930,"","https://poetry.dctabudhabi.ae/diwan/poem/132400","الكامل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67833","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64804","الكامل"],[3276,"","https://poetry.dctabudhabi.ae/diwan/poem/121439","الكامل"],[3317,"","https://poetry.dctabudhabi.ae/diwan/poem/35858","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91496","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206152","الكامل"],[3778,"","https://poetry.dctabudhabi.ae/diwan/poem/89990","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102962","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119705","الكامل"],[4085,"","https://poetry.dctabudhabi.ae/diwan/poem/105154","الكامل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102746","الكامل"],[4192,"","https://poetry.dctabudhabi.ae/diwan/poem/104437","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54498","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133127","الوافر"],[4591,"","https://poetry.dctabudhabi.ae/diwan/poem/144254","المتدارك"],[5155,"يا دنيا ..!","https://www.poetsgate.com/ViewPoem.aspx?id=176238",""],[5376,"ما اعتدْتُ بعداً عنك يا أمي","https://www.poetsgate.com/ViewPoem.aspx?id=191870",""],[5461,"يا وش بقى","https://www.poetsgate.com/ViewPoem.aspx?id=500",""],[5956,"أسعى لتحسين أحوالها","https://www.poetsgate.com/ViewPoem.aspx?id=183396",""],[406,"صرخة في زمن الهمس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63267&r=&rc=78",""],[463,"منَ العارِلولا أنَّ طيفكِ يطرقِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60159&r=&rc=215",""]],"verses":[["وَشَغاميمَ جِسامٍ بُدَّنٍ","ناعِماتٍ مِن هَوانٍ لَم تُلَح",0,"ح",1,0],["وشغفنا بغصون","منهم هيف رشاق",1,"ق",1,0],["وَشَغَلتَ نَفسَكَ بِالخَصي","بِ مِنَ الجُهودِ عَنِ العَقيمِ",2,"م",1,0],["وَشُغلُ النَفسِ عَن طَلَبِ المَعالي","بِبَيعِ الشِعرِ في سوقِ الكَسادِ",3,"د",1,0],["وَشُغِلتَ عَن حَسَبِ الكِرامِ وَما بَنَوا","إِنَّ اللَئيمَ عَنِ المَكارِمِ يُشغَلُ",4,"ل",1,1],["وَشَغَلتَ قَلبَكَ عَن مَعادِكَ بِالمُنى","وَخَدَعتَ نَفسَكَ بِالهَوى وَفَتَنتَها",5,"ت",3,0],["وَشُغلُها بِعُيوبِ الناسِ تُبصِرُها","مِنهُم وَلا تُبصِرُ العَيبَ الَّذي فيها",6,"ي",3,0],["وَشُغِلتَ عَن دَبغِ الجُلودِ بِما","نَشَرَ البَلاءَ وَجَلَّلَ الخَطبا",7,"ب",2,0],["وَشَغِلتُ عَن فَهمِ الحَديثِ سِوى","ما كانَ مِنكَ وَحُبُّكُم شُغلي",8,"ي",1,1],["وَشُغلُ فَمٍ يَستَغفِرُ اللَهَ ذَنبَهُ","أَحَقُّ بِهِ مِن ذِكرِ زَينَبَ أَو جُملِ",9,"ل",1,0],["وَشَغَلتُ بالي والمصيبَةُ أنني","أجني فراغَ العُمرِ مِن مشغوله !",10,"ل",2,0],["وَشُغلٍ لَيسَ يَعقُبُهُ فَراغ","وَسَعيٍ دائِمٍ مَع كُلِّ ساعِ",11,"ع",1,0],["وشغلِك بي وإن عرَضَتْ أمورٌ","تُحيلُ الجفنَ عن عهدِ المنامِ",12,"م",1,0],["وشغَلوا مكانَهُ من بَعده","كالشمس سدَّ جوَّها الشُّهبُ الزُّهُرْ",13,"ر",1,0],["وَشغلتُ نفسي برهةً بهمُ","فكأنّني منهمْ بلا شُغلِ",14,"ل",1,0],["وشغلوا الكون بهم","وهيَّجوه شجنا",15,"ن",2,0],["وَشغفت فيكَ بِكُل غُصن مائس","يُزري لرقته بلينِ قوام",16,"م",1,0],["وشغلتمُ بالعتب منه جانباً","وجدال خصمكمُ أحق بشغله",17,"ل",2,0],["وشغلته صيحة المستفرصِ","عن نغمةٍ ولذةٍ في المرقصِ",18,"ص",1,0],["وَشغلت شدقيه عِندَ الإِكله","وَالصاحِبان يَنظُرانِ فِعله",19,"ه",1,0],["وشغلت عن ذم الأنام بشاغل","وثناك خصمٌ من أبيك مماحك",20,"ك",1,0],["وَشُغْلي بِمَدْحِ الْمُصْطَفى فَهْوَ مَغْنَمُ","أنَيْنَا إلىَ وَادِي الْعَقِيقِ بِفَرْحَةٍ",21,"ه",1,0],["وَشَغَلْتُ قَلْبي واللِّسانَ بِكُمْ","في الحُبِّ عَن زَيْدٍ وعَن عَمْرِو",22,"ر",2,0],["وشغلت قلبي بامتداح المصطفى","مهما يكن بسواه لا يرتاحُ",23,"ح",1,0],["وَشُغلُكَ في إِصلاحِ نَفسِكَ وَالوَرى","وَصَدرُكَ مَشروحٌ وَخُلقُكَ واسِعُ",24,"ع",1,0],["وَشغلتمُ فتفرّعوا","وَفتكتمُ فتحيزوا",25,"ز",3,0],["وشغلتني عما يُحَبُّ كأنما","هذا الوجود على جمالك دائر",26,"ر",1,0],["وشغلت خوط البان في أوراقه","بعناقه من فضرة بذبول",27,"ل",1,0],["وشغلت عن ذم الزمان بمدحة","لندى سليمان القران الأسعد",28,"د",1,0],["وشغلت ذهني في سواه فقال لي","من كان في الأسواء والبلوى معي",29,"ع",2,0],["وشغلت حتى كدت من شغلي بهم","عنهم يخيل انني مشغول",30,"ل",1,0],["وشغلت وقتك بالبطالة دائما","فمتى لربك ساعة تتفرغ",31,"غ",1,0],["وشغفت بالثغر المفلج","عن عقود أو درر",32,"ر",1,0],["وشغلتَ جأشَهُمُ بجيشٍ هدَّهُمْ","فجنى ثمارَ النُّصرةِ الجيشانِ",33,"ن",1,0],["وشغل الوقت في قوتٍ ولبسٍ","وطاعات الغواني والفروج",34,"ج",1,0],["وشغاف بي يدعوك إلى","حسبانك في حالي حسنا",35,"ن",2,0],["وشغلت بالي كله","يا ليتني أجري ببالك",36,"ك",1,0],["وشغافُ قلبي لا يفارقُ نبضةً","موصولةً بالروحِ والجسمِ",37,"م",1,0],["وش غيرك يا منوة القلب واطغاك","على حبيب ما تخير بدالك",38,"ك",1,0],["وشغلتُ وقتي باللقاء بوجْهِها","متعاطفاً معها وفِيَّ ضميرُ",39,"ر",1,0],["وشغلنا ببعضنا في صراع","يملأ النفس حسرة واكتئابا",40,"ب",2,0],["وشغثٌ أراقَ السّيرُ ماءَ مزادهمْ","وهمَّاتهم فيهِ روايا تدفَّقُ",41,"ق",1,0]]}