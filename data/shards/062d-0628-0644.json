"],[4830,"هو نفْسُ مُحمّد","https://www.poetsgate.com/ViewPoem.aspx?id=204707",""],[4869,"مايعيش قلب الطيّب","https://www.poetsgate.com/ViewPoem.aspx?id=151564",""],[4875,"ركعتين","https://www.poetsgate.com/ViewPoem.aspx?id=133585",""],[4908,"حبلى سنيني (شعر / ماجد العبادي) وضيم المحبة (تعقيب/جهاد العبادي)","https://www.poetsgate.com/ViewPoem.aspx?id=209094",""],[669,"نبئت أن أبانا كان عن أنس","https://www.poetsgate.com/ViewPoem.aspx?id=18388",""],[182,"","https://www.poetsgate.com/ViewPoem.aspx?id=72802",""],[4978,"حبل الحياة قصير أيها الناس","https://www.poetsgate.com/ViewPoem.aspx?id=177375",""],[4978,"في حزننا وافتقاد القرب والسند","https://www.poetsgate.com/ViewPoem.aspx?id=177531",""],[4978,"حذوة الفرس","https://www.poetsgate.com/ViewPoem.aspx?id=211980",""],[5011,"نار والله نار","https://www.poetsgate.com/ViewPoem.aspx?id=9504",""],[3271,"مرثية غصن الزيتون","https://www.poetsgate.com/ViewPoem.aspx?id=103533",""],[5072,"خريف الأحبة","https://www.poetsgate.com/ViewPoem.aspx?id=53931",""],[5081,"مَا عَادَ يَشْجُبُ !!!","https://www.poetsgate.com/ViewPoem.aspx?id=186986",""],[5092,"حبلٌ من الهجران","https://www.poetsgate.com/ViewPoem.aspx?id=178350",""],[5092,"هزَّ قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=190578",""],[5187,"وجيه في التسعين","https://www.poetsgate.com/ViewPoem.aspx?id=29067",""],[5190,"بيني وبين الطبيب","https://www.poetsgate.com/ViewPoem.aspx?id=153352",""],[5277,"صبا العراق","https://www.poetsgate.com/ViewPoem.aspx?id=193677",""],[308,"سلوا الدموع فإن الصب مشغول","https://www.poetsgate.com/ViewPoem.aspx?id=118851",""],[5431,"كم مسنا الضر ياحنان انت لها","https://www.poetsgate.com/ViewPoem.aspx?id=189875",""],[5431,"النارنج قصة عاشقٍ","https://www.poetsgate.com/ViewPoem.aspx?id=202098",""],[5433,"حب جديد","https://www.poetsgate.com/ViewPoem.aspx?id=36220",""],[5525,"مني السلام","https://www.poetsgate.com/ViewPoem.aspx?id=7260",""],[5595,"أطلقْ دموعَك ، فالأحزانُ تستعرُ","https://www.poetsgate.com/ViewPoem.aspx?id=144533",""],[243,"ليلة القدر","https://www.poetsgate.com/ViewPoem.aspx?id=20959",""],[5721,"أعظم من أسلافي الأول","https://www.poetsgate.com/ViewPoem.aspx?id=215232",""],[5742,"رثاء الصفاء","https://www.poetsgate.com/ViewPoem.aspx?id=206959",""],[5756,"قصة حياة","https://www.poetsgate.com/ViewPoem.aspx?id=5435",""],[5781,"خَمائِلهُ بِلَونِ دمي","https://www.poetsgate.com/ViewPoem.aspx?id=208990",""],[5854,"أهزّك الوجد لما بانت الرُسُم ((بالتوحيد نتحد))","https://www.poetsgate.com/ViewPoem.aspx?id=192157",""],[5897,"إلى ذات الحرير الأخضر","https://www.poetsgate.com/ViewPoem.aspx?id=160572",""],[1920,"الأرجوحة المشنقة","https://www.poetsgate.com/ViewPoem.aspx?id=197103",""],[6032,"جفّ اليراعُ","https://www.poetsgate.com/ViewPoem.aspx?id=181527",""],[6056,"خصلتين ٍ فوق خدّه","https://www.poetsgate.com/ViewPoem.aspx?id=130327",""],[6108,"رحلة","https://www.poetsgate.com/ViewPoem.aspx?id=192588",""],[6127,"ليلى قناع","https://www.poetsgate.com/ViewPoem.aspx?id=188182",""],[6139,"حب وأسى","https://www.poetsgate.com/ViewPoem.aspx?id=212335",""],[242,"حبل الدنا يا مبتغيه رث","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563804",""],[5080,"عن حجّ شريان الحروف لقدسه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88136&r=&rc=6",""],[6235,"تراتيل الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77691&r=&rc=6",""]],"verses":[["حَبلٌ غَدا بِأَكُفِّنا طَرَفٌ","مِنهُ وَفي أَيدي النَوى طَرَفُ",0,"ف",1,0],["حُبٌّ لِذاتِ اللَهِ كانَ وَلَم يَزَل","وَهَوىً لِذاتِ الحَقِّ وَالإِصلاحِ",1,"ح",1,0],["حَبلَينِ طالا حِبالَ الناسِ قَد بَلَغا","حَيثُ اِنتَهى مِن سَماءِ الناظِرِ النَظَرُ",2,"ر",1,0],["حَبلاً بِهِ رَجَعَت نُفوسُكُمُ","وَلَقَد بَلَغنَ تَراقِيَ النَحرِ",3,"ر",1,1],["حَبلاً أَخَذتُ بِهِ فَنَجّاني بِهِ","رَبّي بِنِعمَةِ مُدرِكٍ غَفّارِ",4,"ر",1,0],["حبل الفجيعة ملتفٌ على عنقي","من ذا يعاتب مشنوقاً إذا اضطربا؟",5,"ب",2,0],["حَبلُ المُنى بِحِبالِ اليَأسِ مَعقودُ","وَالأَمنُ مِن حادِثِ الأَيّامِ مَفقودُ",6,"د",1,1],["حَبلُها عِندَنا مَتينٌ وَحَبلي","عِندَها واهِنُ القِوى أَنقاضُ",7,"ض",1,0],["حَبلي وَحَبلُ الَّذي كَلِفتُ بِهِ","عَلى تَدانيهِ غَيرُ مُتَّصِلِ",8,"ل",1,0],["حبلٌ وثيقٌ وكَرزنٌ وأنا","بحملهِ ناهضٌ ومتّئدُ",9,"د",1,0],["حُبَّ لَو شِئتِ اِلتَقَينا","مَجلِساً قَبلَ المَماتِ",10,"ت",1,0],["حَبَلَتني بِمُناها","وَرُقاها فَالخِلابِ",11,"ب",1,0],["حبل السياسة قد أمست به عقد","فحلَّ أنت بأيدي رأيك العقدا",12,"د",2,0],["حَبِلْتِ بِلا وِزْرٍ وَأَنْجَبْتِ لِلْفِدَى","مُخَلِّصَ هَذَا الْخَلْقِ مِنْ رِبْقَةِ الوِزْرِ",13,"ر",1,0],["حب لفاروق في جوانحنا","مخلد في حياتنا أثره",14,"ر",2,0],["حبلا بريق ٍ.. رافقا جيدها","واستأنسا بالهُدْبِ والمِحْجر ِ",15,"ر",1,0],["حَبْلٌ لِمُعْتَصِمٍ نُورٌ لِمُتَّبِعٍ","هُدىً لِذِي حَيْرَةٍ أَمْنٌ لِمَن فَزِعا",16,"ع",2,0],["حَبْلُ المَودَّةِ بَينَنا لم يُنقضِ","سَخِطَ الحَسُودُ بِذاكَ مِنَّا أَو رَضِي",17,"ض",2,1],["حَبٌّ لمُزْنٍ غَدا حَبّاً بلُجّته","ودُرُّ سُحْبِ غدا دُرّاً كما حُكِيا",18,"ي",2,0],["حَبْلُ رجاءٍ للخَلْقِ مُتَّصلٍ","مَدَّتْه أيدي الغُواةِ فانقَطعا",19,"ع",2,0],["حبلُ الهَوى ملقىً على الغارِب","فما لها ترقِلُ بالراكبِ",20,"ب",1,1],["حبلى ببكرٍ سيتْرَبَّى بناصرةٍ","ميلاده بيت لحمٍ فهي آثار",21,"ر",1,0],["حَبلٌ غَدا من حِبالِ اللهِ عُرْوَتُهُ","تَقِي المُحِبَّ من الآثامِ والخَلَلِ",22,"ل",1,0],["حَبِلَتْ بِكِ الذكرَى كأنَّ (خديجةً)","تنسلُّ في وجع المخاض وتُحشَرُ",23,"ر",1,0],["حبلاً متيناً بكفَّيه له طرفٌ","شدَّ العِراجُ إليه العَقدَ والكَرَبا",24,"ب",2,0],["حَبل الهَوى بِفُؤادِ الصبِّ مَشدود","وَبابُ سلوانِهِ لا شكَّ مَسدودُ",25,"د",1,1],["حُبٌّ لأِحْمَدَ قَدْ فَشَا","بَيْنَ الْجَوانِحِ والْحَشَا",26,"ش",2,1],["حبلى بعدة أولادٍ وما أفتٌرِعتْ","عذراء تحكي لنا العذراء تطهيرا",27,"ر",2,0],["حَبلُكَ وَالسَلُّ لَقَد أَودَيا","بِهَيبَةِ المَوتِ الوُقورِ الرَهيبْ",28,"ب",1,0],["حُبِّ لِلشَّادنِ الَّذي","شَفَّني طَرْفُهُ الثَّمِلْ",29,"ل",1,0],["حُبٌّ لَو أنَّكَ ذُقْتَهُ","لعَذَرْتَ فيهِ مِنْ عَذَلْتا",30,"ت",2,0],["حبل التَعلق وَالوفا","مفتاح قفل الأَنعم",31,"م",1,0],["حبل الوفاء وَترجمان المُصطَفى","وَالصوت بعد الصَوت بعد الصوت",32,"ت",1,0],["حبل المحبة مهما اشتدُّ منقطعٌ","إن لم يقوِّهِ مضطرٌ ومنتفعُ",33,"ع",1,1],["حبل المحبة ما أوهى قواه إذا","كانت من النفع والأَغراض تُصطنعُ",33,"ع",1,0],["حُبْلَى لها فَتَكاتٌ في أجِنّتها","على اقتدار لهم فيها وتكدير",34,"ر",1,0],["حبل المومس من صيره","في الغيابات جنيناً واستر",35,"ر",1,0],["حب لمصر من الإسلام منبعه","وفي العروبة نور ليس يحتجب",36,"ب",1,0],["حَبلهُ جَبلُ غرورٍ","عنده غير وَثيقِ",37,"ق",1,0],["حَبلاً مَتِيناً مِن صَفاءِ ودَادِكُم","فَضلاً وَذَاكَ الحَبلُ لاَ يُقطَع بِشَى",38,"ا",1,0],["حَبلَ وُدٍّ مشن أَكابِرِكُم","فالزَمُوهُ يا أُولِى الهِمَمِ",39,"م",1,0],["حبلُ المنى مثل حبل الشمس، متصلاً","يُرى، وإن كان عند اللمس مبتوتا",40,"ت",2,0],["حب له ما انفك حشو حشاشتي","أبداً وتلك سجية الأمناء",41,"ا",2,0],["حبل الأماني كحبل الشمس متصل","ببعضه وهو عند اللمس مقتضب",42,"ب",1,0],["حَبِلت بي الأُمُّ القديمةُ بالخطا","ولذاك كانَ نظيرَهُ ميلادي",43,"د",2,0],["حبل اعتصام المؤمنين فحبذا الم","تمسكون وخيبة للناكل",44,"ل",1,0],["حبلت لي بهرقل القوة","أو سميلا أوم ذيون الشراب",45,"ب",1,0],["حبلى شهوراً قد خلت وهي في","أوائل السابع دون ازدياد",46,"د",1,0],["حَبلي بيدَيك أَمسِكي أَو أَرخي","لي حنَّةُ وَرقاءَ نأت عَن فَرخِ",47,"خ",1,1],["حب لي بين المرمى على رغم لانذال","بين اسم المحله والذي هو بها حال",48,"ل",1,0],["حبلٌ من النور برهانٌ وموعظةٌ","قد مده الله حبلاً غير منصرم",49,"م",1,0],["حَبْلُ الدُّنَى يَا مُبْتَغيهِ رَثُّ","وَالذُّلُّ فِي اطِّلَابِها مُنْبَثُّ",50,"ث",1,1],["حبل الدجى اخلولق فيها فقد","عم الضيا من خيط شمس الإباء",51,"ا",2,0],["حب لنا كالنورِ يبعثه","بدر الليالي كلما انتقلا",52,"ل",2,0],["حبلُ الرجاء بروحي غير منصرمٍ","إذ للحليم أسوقُ الإثمَ والزللا",53,"ل",2,0],["حبلٌ من اللهِ تقطَّعَ وصلُهُ","بين السَّما والمؤمنينِ متينُ",54,"ن",1,0],["حبل الوصل لاشابه بخيط مكره","قطعته بنفسي ولو هم بكوني",55,"ن",2,0],["حبلين وصلي بالولي لا تضايقت","تفنى حياتي ما طرالي يترخّن",56,"ن",1,0],["حبلى سنيني بالتعب والبلاوي","والهم في قلبي من العام يأويه",57,"و",3,1],["حبلا متينا بكفيه له طرف","سد العراج إليه العقد والكربا",58,"ب",2,0],["حَبِلَتْ من إرْعادِنا كَلماتٌ","أنْجَبَتْ شَجْباً صَارِخاً وَعَليّا",59,"ي",2,0],["حبل الحياة قصي