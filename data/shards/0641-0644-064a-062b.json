{"poems":[[55,"هب للديار بقية الجلد","https://www.aldiwan.net/poem30519.html","الكامل"],[95,"بلغت أقصى العمر الفاني","https://www.aldiwan.net/poem11247.html","السريع"],[63,"طلعت شموس الخدر كيما تغربا","https://www.aldiwan.net/poem51784.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55243","الرمل"],[147,"لا زال ملكك بالعلى مأهولا","https://www.aldiwan.net/poem11789.html","الكامل"],[189,"صلى الإله عليك يا بن رسوله","https://www.aldiwan.net/poem14639.html","الكامل"],[240,"سقى صوب الحيا دمنا","https://www.aldiwan.net/poem31915.html","مجزوء الوافر"],[520,"يا من أدل يبسط العذر من جارا","https://www.aldiwan.net/poem12138.html","البسيط"],[580,"على كل حال ليس لي عنك مذهب","https://www.aldiwan.net/poem3109.html","الطويل"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44812","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53113","المتقارب"],[520,"يا من اذل ببسط العذر من جارا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577542",""]],"verses":[["فَليَثبُتَنَّ الآنَ إِن ثَبُتَت","قَدَمٌ عَلى جَمرٍ لِمُعتَمِدِ",0,"د",1,0],["فَلْيَثُبِ اللهُ بِرُضْوَانِ","أخْلَقَ مَنْ وَلَّى بِرُضْوَانِ",1,"ن",1,0],["فَلْيَثْوِ في رَمْسِ الخُمولِ فإنني","نارٌ تضرَّمُ في ذُؤابةِ كبكبا",2,"ب",2,0],["فَلْيَثِبْهَا اللهُ بِالحُس","نَى وَفَضْلُ اللهِ جَمُّ",3,"م",1,0],["فَليَثنِ فائِلَ رَأيِهِ عَن رايَةٍ","أَمَرَ الإِلَهُ بِنَصرِها جِبريلا",4,"ل",2,0],["فليَثْبُتِ الإفرنجُ منه لقَسْوَرٍ","بعث الحُتوف إليهمُ من غِيله",5,"ل",2,0],["فَليثُ شَرىً إِذا أَسرى","وَطَودُ خِمىً إِذا جَلَسا",6,"س",2,0],["فلي ثلاثة أيام أعود على الدهليز","أبسط عند الناس أعذارا",7,"ر",2,0],["فَلِي ثقةُ في جودِه لا تَخُونُني","ولي أَملٌ في فضلِه لا يُخَّيب",8,"ب",1,0],["فَلَيثُ الغَابِ يَفتَرِسُ الأنَاسِي","وَلَيثُ البَيتِ يَفتَرِسُ الذِئَابا",9,"ب",2,0],["فليثٌ أبارَ وطودٌ أجارَ وبدرٌ أن","ارَ وغيثٌ همرْ",10,"ر",1,0],["فلي ثلاثة أيام أعود من الده","ليز أبسط عند النفس أعذارا",11,"ر",2,0]]}