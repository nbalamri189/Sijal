,""],[5480,"قابوس","https://www.poetsgate.com/ViewPoem.aspx?id=9887",""],[5484,"روع الكون وادلهم السماء","https://www.poetsgate.com/ViewPoem.aspx?id=206305",""],[5488,"يابارق من جدا الشرق سناي","https://www.poetsgate.com/ViewPoem.aspx?id=100728",""],[5533,"يا أُمَّةَ المِلْيَار","https://www.poetsgate.com/ViewPoem.aspx?id=180269",""],[5542,"شاهد التاريخ","https://www.poetsgate.com/ViewPoem.aspx?id=10069",""],[5561,"شهرزاد","https://www.poetsgate.com/ViewPoem.aspx?id=192903",""],[5582,"أَبْدَلَتْهُ النَّوَى بَعْدَ خُرَّدِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=186882",""],[5582,"إِنَّما نَوْحُ الحَمامِ","https://www.poetsgate.com/ViewPoem.aspx?id=63567",""],[5606,"اليوم الوطني87","https://www.poetsgate.com/ViewPoem.aspx?id=194254",""],[5691,"بيت الغرابيب","https://www.poetsgate.com/ViewPoem.aspx?id=206248",""],[5720,"الْرَوْنَةُ *","https://www.poetsgate.com/ViewPoem.aspx?id=199382",""],[5720,"قادةٌ وأثَر *","https://www.poetsgate.com/ViewPoem.aspx?id=199812",""],[5720,"قائدُ السفينة","https://www.poetsgate.com/ViewPoem.aspx?id=199953",""],[5725,"ياظبية الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=179251",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[5770,"رثاء الشهيد فيصل الحسيني","https://www.poetsgate.com/ViewPoem.aspx?id=178701",""],[5853,"ردّ قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=175668",""],[5893,"حنا على العهد","https://www.poetsgate.com/ViewPoem.aspx?id=141493",""],[5897,"حلم","https://www.poetsgate.com/ViewPoem.aspx?id=156535",""],[5997,"لِرَبِّ الْعَالَمَيْنِ","https://www.poetsgate.com/ViewPoem.aspx?id=214257",""],[5997,"القدس نادى","https://www.poetsgate.com/ViewPoem.aspx?id=214279",""],[6093,"جيل من ذهب","https://www.poetsgate.com/ViewPoem.aspx?id=205227",""],[6115,"يالله يامن بامره الشر والخير","https://www.poetsgate.com/ViewPoem.aspx?id=180503",""],[6117,"فَتَاةُ الْقُدْسِ","https://www.poetsgate.com/ViewPoem.aspx?id=182794",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[5309,"أيها الشاكي ولا ناصر له","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573539",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[6222,"عام مضى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1932&r=&rc=3",""],[6257,"صعلكة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87176&r=&rc=1",""],[572,"حَبَّذَا الزَّائرُ في وقتِ السّحَرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9260&r=&rc=117",""]],"verses":[["قادَهُ المِقدارُ قَسراً بَعدَما","أَكرَهَ السُمرَ عَلى المَقِّ الطَوالِ",0,"ل",1,0],["قادَهُ الغَمضُ مِن زَرودٍ فَلَمّا","زارَ أَنبى عَن مُقلَتَيَّ الغُمضا",1,"ض",2,0],["قادَ بنَ ليلى قائِدُ المُعتاصِ","كانَ سِياغي فَغَدا اِغتِصاصي",2,"ص",2,0],["قادَت حَزامَتُهُ المَنونَ فَلَم","تَمنَع مَضارِبَ بيضِهِ البُترِ",3,"ر",1,0],["قادوا السَوابِقَ مُحفاةً مُقَوَّدَةً","كَأَنَّها بَحَثَت عَن مُضمَرِ التُرَبِ",4,"ب",1,0],["قادَ الكَتائِبَ وهْوَ مُقتَبِلُ الصِّبا","حتَّى اتّقَتْ غَزَواتِهِ الأعْداءُ",5,"ا",2,0],["قَادِرَاتٍ عَلَى مُكَافَحَةِ الدَّهْ","رِ بِعَزْمٍ ثَبْتٍ وَحِلْمٍ رَصِينِ",6,"ن",1,0],["قادته نحوَك بالخِطام كأنه","جَمَلٌ يساقُ إلى القياد وقد نفَرْ",7,"ر",1,0],["قادَتهُمُ نِيَّةٌ لِلبَينِ شاطِنَةٌ","يا حَبَّ لِلبَينِ إِذ حَلَّت بِهِ بينا",8,"ن",2,0],["قادوا إِلَيكُم صُدورَ الخَيلِ مُعلِمَةً","تَغشى الطِعانَ وَفي أَعطافِها زَوَرُ",9,"ر",1,0],["قادوا الهُذَيلَ بِذَي بَهدى وَهُم رَجَعوا","يَومَ الغَبيطِ بِبِشرٍ وَهوَ مَغلولُ",10,"ل",1,0],["قاد الجيوش لخمس عشرة حجة","ولداته عن ذاك في اشغال",11,"ل",1,0],["قاد الهوى الفجارَ فانقادوا له","وأبتْ عليه مقادةُ الأبرارِ",12,"ر",1,0],["قاد أبا الصقر إلى ما أرى","من فعله قائدُ توفيقِ",13,"ق",1,0],["قادرٌ أن يُميتَ أشجانَ قوم","قادرٌ أن يُهيِّجَ الأشجانا",14,"ن",2,0],["قادَهُ ذَلِكَ الغَضَنفَرُ نوجي","وَيُناطُ الحُسامُ بِالصِنديدِ",15,"د",1,0],["قادوا الجُيوشَ فَكُلُّ سَهلٍ ضَيِّقٌ","وَرَنوا المَعاقِلَ فَهيَ أَرضٌ داحِيَه",16,"ي",2,0],["قادَةُ الناسِ وَإِن لَم يَقرُبوا","طَبَعاتِ الهِندِ وَالسُمرَ اللِدانا",17,"ن",2,0],["قادَهُم لِلفَتحِ في الأَرضِ فَتىً","لَو تَأَنّى حَظَّهُ قادَ الصَحابا",18,"ب",2,0],["قادِرٌ يَمسَخُ المَمالِكَ أَعما","لاً وَيُعطي وَسيعَها أَعوانَه",19,"ن",2,0],["قادَ المَقانِبَ أَقصى شُربِها نَهَلٌ","عَلى الشَكيمِ وَأَدنى سَيرِها سِرَعُ",20,"ع",1,0],["قادَ الجِيادَ إِلى الطِعانِ وَلَم يَقُد","إِلّا إِلى العاداتِ وَالأَوطانِ",21,"ن",1,0],["قادتُ حزامتهُ المَنون كأنَّما","يحدُو بموهونِ القفار موقّعِ",22,"ع",1,0],["قادَ الرِجالَ عَلى العِيالِ وَما اِمتَرى","في أَنَّ لِلقَوّادِ أَجرَ القائِدِ",23,"د",1,0],["قاد تَمَّ حُسنُ المُحَمَّدِيَّةِ بِالبَد","رِ الَّذي بِالضِياءِ يَغمُرُها",24,"ر",3,0],["قاد وَجَدنا مُحَمَّدَ اِبنِ عَلِيٍّ","غايَةَ المَجدِ قائِلاً وَفَعولا",25,"ل",2,0],["قاد حالَ مِن دونِهِ البِعادُ وَتَش","ريقُ صُدورِ المَطِيِّ في لَقَمِه",26,"م",2,0],["قادَ آباؤُهُ الجِيادَ مُلوكاً","قَبلَ قَودِ الجِيادِ مِن ذي رُعَينِ",27,"ن",1,0],["قادَ الجِيادَ مِنَ البَلقاءِ مُنقَبِضاً","شَهراً تَقَلقَلُ في الأَرسانِ وَاللُجُمُ",28,"م",1,0],["قادَ الجيادَ له من وَطئِها صَخَبٌ","على الصُّخورِ ومن أرهاجِها ظُلَلُ",29,"ل",1,0],["قادِرٌ قاهِرٌ قَوِيٌّ لَطيفٍ","ظاهِرٍ باطِنٍ قَريبٍ بَعيدِ",30,"د",1,0],["قادوا الشَوازِبَ كَالأَجيالِ حامَلَةً","أَمثالَها ثَبتَةً في كُلِّ مُضطَرِمِ",31,"م",1,0],["قادَ المَنايا وَالجُيوشَ فَأَصبَحَت","وَلَها بِأَرشَقَ قَسطَلٌ عُثنونُ",32,"ن",1,0],["قادرٌ أنتَ على كلتيهما","فاقضِ بالأولى بجاهِ المصطفى",33,"ف",2,0],["قادَهُ الطَرفُ يَومَ سِرنا إِلى الحَي","نِ جِهاراً وَلَم نَخَف أَن يَحينا",34,"ن",2,0],["قادَهُ الحَينُ نَحوَها فَأَتاها","غَيرَ عاصٍ إِلى هَواها سَريعا",35,"ع",2,0],["قادَتِ العَينُ إِلَيها قَلبَهُ","عَقِبَ التَشريقِ مِن يَومِ الأَضاح",36,"ح",1,0],["قادةٌ ما صادفوا أكفاءَهم","وجنودٌ مِثلُها لم يُخلَقِ",37,"ق",1,0],["قادَ النُفوسَ مَهابَةً وَمَحَبَّةً","بَدرٌ بَدا مُتَعَمِّماً بِسَوادِ",38,"د",1,0],["قادَ الخضارمةَ الملوكَ فوارساً","قد كان فارسَ جمْعها المشبوحا",39,"ح",2,0],["قادَ النَدى بِعِنانِهِ","وَتسَربَلَ المَعروفَ دِرعا",40,"ع",2,0],["قادَني نَحوَهُ الرَجاءُ فَصَدَّق","تُ رَجائي وَاِختَرتُ حَمدَ لِساني",41,"ن",2,0],["قادَهُ إِبليسُ طَوعاً","بَعدَما كانَ عَصِيّا",42,"ي",2,0],["قادَني لِلشَقاءِ جَهراً فُؤادي","وَفُؤادي فَعّالُ تِلكَ المُعيدُ",43,"د",1,0],["قادَ الجُنودَ مِن البُصَيرَةِ لِلعِدى","حَتّى وَقَعنَ بِصينِ ثَغرٍ قودا",44,"د",2,0],["قادَ النَباطِيَّ إِلى حَتفِهِ","نَظرَةُ عَينٍ شَطرَ مَحبوبِ",45,"ب",1,0],["قادَ الجِيادَ مِنَ الجَولانِ قائِظَةً","مِن بَينِ مُنعَلَةٍ تُزجى وَمَجنوبِ",46,"ب",1,0],["قادَني طَرْفي وقلبي للهوَى","كيف مِن طرْفي ومِن قَلبي حِذاري",47,"ر",2,0],["قادَ الجِيادَ إِلى الأعْداءِ سارِيَةً","قُبَّاً طَواها كطَيِّ العَصْبِ إِضْمَارُ",48,"ر",1,0],["قادَ جَيْشاً مِنْ قُلُوبٍ حَوْلَهُ","خاضعاتٍ إِنْ نَهَى أوْ أمَرَا",49,"ر",2,0],["قادهم خيرُ رئيسٍ للعُلا","شمريِّ العزم عالي الحَسَب",50,"ب",1,0],["قاد للمجد مناجيد الحمى","كلُّهم أرْوَعُ مُنْبَتُّ القَرينْ",51,"ن",1,0],["قاد السفينة في خضم زاخر","يطغى الدمُ القاني على غمراته",52,"ت",2,0],["قادوا الحمى في فجر نهضته؛ فما","عرفوا عن النهج السويِّ محيدا",53,"د",2,0],["قادة للجمودِ والجهلٍ في الشرق","على الشعب تنصُرُ استعمارا",54,"ر",2,0],["قادوا الجيوش فكلّ سهل ضيّق","ورموا المعاقل فهي أرض داحيه",55,"ي",2,0],["قادم من مدائن الريح وحدي","فاحتضني ،كالطفل، يا قاسيونُ",56,"ن",1,0],["قاده الطرفُ، يومَ سرنا، إلى الحي","نِ جهاراً، ولم يخفْ أنْ يحينا",57,"ن",2,0],["قادت فؤادي للعناء بنظرة","لو لم تكن نظرت لكنت مسلما",58,"م",2,0],["قاد الصليب بجهله مستنصراً","والنصر موقوف على الإسلام",59,"م",1,0],["قادوا الخيول فأعطيت أعداؤهم","لتغيظهم فتضاعفا ذلان",60,"ن",1,0],["قادَ مِنهُم نحوَ العداةِ أسوداً","رَجَفت مِن زئيرها الأنحاءُ",61,"ا",2,0],["قادَهُم للرشادِ طوعاً وكرهاً","سيفهُ وَالشريهةُ الغرّاءُ",61,"ا",2,0],["قادَ الجيوشَ بهمّةٍ وثّابَةٍ","وبهِ تحُفُّ ملائِكُ الرحمنِ",62,"ن",1,0],["قادَ الجِيادَ مَعاقِلاً وَإِن اِكتَفى","بِمَعاقِلٍ مِن رَأيِهِ وَحُصونِ",63,"ن",1,0],["قادني لحظُه إليه","دليلا بسحرهِ",64,"ر",2,0],["قادمٌ حتى يراني","قبل أن يرتدَّ طرفي",65,"ف",2,0],["قاد الخيول الصافنات الى العدا","ثم اِنتَضى بيضا تدل عَلى الهدى",66,"د",2,0],["قَادَ الخَليقَةَ مِنْ بُعْدٍ ومِن كَثبٍ","نَحْوَ الخَلِيفَةِ إِسجَاحٌ يُوالِيهِ",67,"ي",2,0],["قاد الصفوف صلاح الدين مجتهداً","وتحت رايتَهِ الإقدامُ والظفر",68,"ر",1,0],["قادَ عَوداً مِنَ الجُيوشِ لُهاماً","أَرعَنَ الحَجرَتَينِ حينَ يَسيرُ",69,"ر",1,0],["قادِرٌ أَوجَد الخَلائِقَ مِن لا","شَيءَ فَضلاً وَجادَ بِالآلاءِ",70,"ا",2,0],["قادحاتِ الحصَى كأنّ خُطاها","تَقذِفُ الجَوَّ منه بالشُّهْبِ قَذْفا",71,"ف",2,0],["قادَ الجِيادَ على وَجَاها شُزَّباً","قُبَّ البطونِ نَواحِلَ الأَبدانِ",72,"ن",1,0],["قَ ادّعاء السَّمع أعينُهم","ورُبّ خُبرٍ لَديهِ يَصغُرُ الخَبَرُ",73,"ر",1,0],["قادوا إليكَ المُضْمَرات كأنَّما","يغزون كِسْرى وَيْلَهُمْ أو قيصَرا",74,"ر",2,0],["قادَهم دَاعي المنايا","ولَكَمْ قادوا الجنودا",75,"د",2,0],["قاد الجيوش إلى صنعا وحاربه","فاضطر منه على صلح على دخن",76,"ن",1,0],["قادت إلى نهج الهداية أمة","فقوي بما أبرزته الإِسلام",77,"م",1,0],["قادوا إلى الإِسلام فاقرة","وعليه سيف ضلالهم سَلُّوا",78,"ل",3,0],["قادَت فُؤادَكَ فَاِستَقادَ وَمِثلُها","قادَ القُلوبَ إِلى الصِبا فَأَمالَها",79,"ل",3,0],["قادني الوَجْدُ وقد","كنتُ له صعب القياد",80,"د",1,0],["قادَ بِهِ أَجرَدُ ذو مَيعَةٍ","عَبلاً شَواهُ غَيرُ كابٍ عَثور",81,"ر",1,0],["قادَ وقادَ السودَ نحوَ","فهُمْ على الغارِ لهُمْ غارَهْ",82,"ه",1,1],["قادَهُ الحبُّ بين دمعٍ طليقٍ","وفؤادٍ من الجوى في عِقالِ",83,"ل",1,0],["قادَ الجيادَ إِلَى الجهادِ وَحَفَّنِي","بِنَدى يَدَيْهِ تَحْتَ ظِلَّيْ سَجْفِهِ",84,"ف",2,0],["قادت إِلَيْكَ بِهِ فِي عَهْدِ مُوثِقِهِ","قلائدٌ لَمْ يُضِعْها فِي مُقَلِّدِهِ",85,"د",2,0],["قادَ الجنودَ مُكاثِراً بِرِماحِها","شُهُبَ الدُّجى وبأُسْدِها عَدَدَ الدَّبا",86,"ب",2,0],["قادَ العُلا بِزِمَامِ كُلِّ فَضيلَةٍ","واقْتادَهُ الرَّاجِي بِغَيْرِ زِمَامِ",87,"م",1,0],["قادنا الشوقُ إِليها وصبَا","نحوها قلبُ الشجيِّ المغرَمِ",88,"م",1,0],["قادَني للرُبى مَرُوحَ العِنانِ","نفْحُ دَوْحِ النسيمِ في الرَيحانِ",89,"ن",1,1],["قادني نحوه الغَرامُ وفي جَفْنَيْ","هِ شيءٌ يدعو المحبَّ خفيُّ",9