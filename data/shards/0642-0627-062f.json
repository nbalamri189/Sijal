/poetry.dctabudhabi.ae/diwan/poem/54250","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54238","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54212","الرمل"],[106,"ميلاد الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179497",""],[106,"ذكرى فريد !","https://www.poetsgate.com/ViewPoem.aspx?id=179479",""],[90,"علموها!","https://www.poetsgate.com/ViewPoem.aspx?id=179031",""],[91,"عصر الرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=53398",""],[99,"ترصيع بالذهب على سيف دمشقي","https://www.poetsgate.com/ViewPoem.aspx?id=587",""],[31,"أصبحَ القلبُ في الحبالِ رهينا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19120&r=&rc=382",""],[115,"لا عذبن العين غير مفكر","https://www.aldiwan.net/poem40486.html","عموديه"],[150,"يهن الجزيرة منك أي حسام","https://www.aldiwan.net/poem68464.html","الكامل"],[160,"ظهرت عجائب قدرة الرحمن","https://www.aldiwan.net/poem59156.html","الكامل"],[189,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[197,"حي الأساتذة الكرام تحية","https://www.aldiwan.net/poem39949.html","الكامل"],[235,"إن كان دينك في الصبابة ديني","https://www.aldiwan.net/poem31741.html","الكامل"],[250,"بأبي من أعارني","https://www.aldiwan.net/poem14977.html","مجزوء الخفيف"],[254,"أعلنت ضعفي","https://www.aldiwan.net/poem24946.html","مجزوء الرمل"],[271,"أعلمت من ركب البراق عتيما","https://www.aldiwan.net/poem52097.html","الكامل"],[275,"فواتح الفتح تنبي عن تواليه","https://www.aldiwan.net/poem25461.html","البسيط"],[290,"مهما تألبت الأحداث والغير","https://www.aldiwan.net/poem11710.html","البسيط"],[322,"قد تسديتها وتحتي أمون","https://www.aldiwan.net/poem56341.html","الخفيف"],[353,"يا رجائي في شدتي ورخائي","https://www.aldiwan.net/poem40841.html","الخفيف"],[364,"أتراها تظنني الطيف لطفا","https://www.aldiwan.net/poem60838.html","الخفيف"],[365,"لمن الديار بروضة السلان","https://www.aldiwan.net/poem44474.html","الكامل"],[402,"وافاك يصحبه الإسعاد والظفر","https://www.aldiwan.net/poem46940.html","البسيط"],[402,"قد آن أن تلوي العنان وتقصرا","https://www.aldiwan.net/poem46979.html","الكامل"],[402,"أيها المختال كبرا","https://www.aldiwan.net/poem47002.html","مجزوء الرجز"],[403,"طال الوقوف على الأطلال والدمن","https://www.aldiwan.net/poem33399.html","البسيط"],[403,"نظم يجل بأن يقال مدام","https://www.aldiwan.net/poem33419.html","الكامل"],[403,"هذا كتاب كله جهل","https://www.aldiwan.net/poem33466.html","الكامل"],[410,"طرقتك زائرة فحي خيالها","https://www.aldiwan.net/poem67473.html","الكامل"],[416,"لامني سعد على","https://www.aldiwan.net/poem53873.html","مجزوء الرمل"],[428,"يا رب غيثٍ قد قرى عازبٍ","https://www.aldiwan.net/poem770.html",""],[432,"قاد وقاد السود نحو","https://www.aldiwan.net/poem12639.html","السريع"],[432,"دون بيض الخدور سمر العوالي","https://www.aldiwan.net/poem12694.html","الخفيف"],[439,"أعيا شفاء الهم إن لم تشفه","https://www.aldiwan.net/poem34840.html","الكامل"],[439,"الآن رد عنان الملك في يده","https://www.aldiwan.net/poem34858.html","البسيط"],[439,"أهلا بمن قهر الملوك ومرحبا","https://www.aldiwan.net/poem34865.html","الكامل"],[439,"نعم يبشر بدؤها بتمام","https://www.aldiwan.net/poem34866.html","الكامل"],[452,"يا ليالي السفح من عهد الصبا","https://www.aldiwan.net/poem13926.html","الرمل"],[452,"قادني للربى مروح العنان","https://www.aldiwan.net/poem13938.html","الخفيف"],[452,"أي قلب يبقى على الحب أي","https://www.aldiwan.net/poem13969.html","الخفيف"],[458,"سلك الخيال بحاجر","https://www.aldiwan.net/poem56096.html","مجزوء الكامل"],[458,"لعلهم لو وقفوا","https://www.aldiwan.net/poem56108.html","مجزوء الرجز"],[458,"هون في الليل عليها الغررا","https://www.aldiwan.net/poem56183.html","الرجز"],[458,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[461,"هو في ناديه طود راسخ","https://www.aldiwan.net/poem15398.html","الرمل"],[464,"نشوات طرفك والقوام الأهيف","https://www.aldiwan.net/poem3147.html","عموديه"],[493,"سقت العهاد خليط ذاك المعهد","https://www.aldiwan.net/poem67392.html","الكامل"],[515,"دم أبا فاتك حليف بقاء","https://www.aldiwan.net/poem12000.html","الخفيف"],[515,"ثغر الزمان بنجم الدين مبتسم","https://www.aldiwan.net/poem12263.html","البسيط"],[551,"قربا مني القلاص العتاقا","https://www.aldiwan.net/poem47367.html","المديد"],[551,"قادت حراني يوم النفر خرعبة","https://www.aldiwan.net/poem47831.html","البسيط"],[558,"أتعبتني بقر الشام","https://www.aldiwan.net/poem34182.html","المديد"],[558,"إنما الدين كله تقليد","https://www.aldiwan.net/poem34595.html","الخفيف"],[567,"حبذا الزائر في وقت السحر","https://www.aldiwan.net/poem69697.html","الرمل"]],"verses":[["قادَهُ المِقدارُ قَسراً بَعدَما","أَكرَهَ السُمرَ عَلى المَقِّ الطَوالِ",0,"ل",1,0],["قادَهُ الغَمضُ مِن زَرودٍ فَلَمّا","زارَ أَنبى عَن مُقلَتَيَّ الغُمضا",1,"ض",2,0],["قادَ بنَ ليلى قائِدُ المُعتاصِ","كانَ سِياغي فَغَدا اِغتِصاصي",2,"ي",1,0],["قادَت حَزامَتُهُ المَنونَ فَلَم","تَمنَع مَضارِبَ بيضِهِ البُترِ",3,"ر",1,0],["قادوا السَوابِقَ مُحفاةً مُقَوَّدَةً","كَأَنَّها بَحَثَت عَن مُضمَرِ التُرَبِ",4,"ب",1,0],["قادَ الكَتائِبَ وهْوَ مُقتَبِلُ الصِّبا","حتَّى اتّقَتْ غَزَواتِهِ الأعْداءُ",5,"ا",2,0],["قَادِرَاتٍ عَلَى مُكَافَحَةِ الدَّهْ","رِ بِعَزْمٍ ثَبْتٍ وَحِلْمٍ رَصِينِ",6,"ن",1,0],["قادته نحوَك بالخِطام كأنه","جَمَلٌ يساقُ إلى القياد وقد نفَرْ",7,"ر",1,0],["قادَتهُمُ نِيَّةٌ لِلبَينِ شاطِنَةٌ","يا حَبَّ لِلبَينِ إِذ حَلَّت بِهِ بينا",8,"ن",2,0],["قادوا إِلَيكُم صُدورَ الخَيلِ مُعلِمَةً","تَغشى الطِعانَ وَفي أَعطافِها زَوَرُ",9,"ر",1,0],["قادوا الهُذَيلَ بِذَي بَهدى وَهُم رَجَعوا","يَومَ الغَبيطِ بِبِشرٍ وَهوَ مَغلولُ",10,"ل",1,0],["قاد الجيوش لخمس عشرة حجة","ولداته عن ذاك في اشغال",11,"ل",1,0],["قاد الهوى الفجارَ فانقادوا له","وأبتْ عليه مقادةُ الأبرارِ",12,"ر",1,0],["قاد أبا الصقر إلى ما أرى","من فعله قائدُ توفيقِ",13,"ق",1,0],["قادرٌ أن يُميتَ أشجانَ قوم","قادرٌ أن يُهيِّجَ الأشجانا",14,"ن",2,0],["قادَهُ ذَلِكَ الغَضَنفَرُ نوجي","وَيُناطُ الحُسامُ بِالصِنديدِ",15,"د",1,0],["قادوا الجُيوشَ فَكُلُّ سَهلٍ ضَيِّقٌ","وَرَنوا المَعاقِلَ فَهيَ أَرضٌ داحِيَه",16,"ي",2,0],["قادَةُ الناسِ وَإِن لَم يَقرُبوا","طَبَعاتِ الهِندِ وَالسُمرَ اللِدانا",17,"ن",2,0],["قادَهُم لِلفَتحِ في الأَرضِ فَتىً","لَو تَأَنّى حَظَّهُ قادَ الصَحابا",18,"ب",2,0],["قادِرٌ يَمسَخُ المَمالِكَ أَعما","لاً وَيُعطي وَسيعَها أَعوانَه",19,"ن",2,0],["قادَ المَقانِبَ أَقصى شُربِها نَهَلٌ","عَلى الشَكيمِ وَأَدنى سَيرِها سِرَعُ",20,"ع",1,0],["قادَ الجِيادَ إِلى الطِعانِ وَلَم يَقُد","إِلّا إِلى العاداتِ وَالأَوطانِ",21,"ن",1,0],["قادتُ حزامتهُ المَنون كأنَّما","يحدُو بموهونِ القفار موقّعِ",22,"ع",1,0],["قادَ الرِجالَ عَلى العِيالِ وَما اِمتَرى","في أَنَّ لِلقَوّادِ أَجرَ القائِدِ",23,"د",1,0],["قاد تَمَّ حُسنُ المُحَمَّدِيَّةِ بِالبَد","رِ الَّذي بِالضِياءِ يَغمُرُها",24,"ر",3,0],["قاد وَجَدنا مُحَمَّدَ اِبنِ عَلِيٍّ","غايَةَ المَجدِ قائِلاً وَفَعولا",25,"ل",2,0],["قاد حالَ مِن دونِهِ البِعادُ وَتَش","ريقُ صُدورِ المَطِيِّ في لَقَمِه",26,"م",2,0],["قادَ آباؤُهُ الجِيادَ مُلوكاً","قَبلَ قَودِ الجِيادِ مِن ذي رُعَينِ",27,"ن",1,0],["قادَ الجِيادَ مِنَ البَلقاءِ مُنقَبِضاً","شَهراً تَقَلقَلُ في الأَرسانِ وَاللُجُمُ",28,"م",1,0],["قادَ الجيادَ له من وَطئِها صَخَبٌ","على الصُّخورِ ومن أرهاجِها ظُلَلُ",29,"ل",1,0],["قادِرٌ قاهِرٌ قَوِيٌّ لَطيفٍ","ظاهِرٍ باطِنٍ قَريبٍ بَعيدِ",30,"د",1,0],["قادوا الشَوازِبَ كَالأَجيالِ حامَلَةً","أَمثالَها ثَبتَةً في كُلِّ مُضطَرِمِ",31,"م",1,0],["قادَ المَنايا وَالجُيوشَ فَأَصبَحَت","وَلَها بِأَرشَقَ قَسطَلٌ عُثنونُ",32,"ن",1,0],["قادرٌ أنتَ على كلتيهما","فاقضِ بالأولى بجاهِ المصطفى",33,"ف",2,0],["قادَهُ الطَرفُ يَومَ سِرنا إِلى الحَي","نِ جِهاراً وَلَم نَخَف أَن يَحينا",34,"ن",2,0],["قادَهُ الحَينُ نَحوَها فَأَتاها","غَيرَ عاصٍ إِلى هَواها سَريعا",35,"ع",2,0],["قادَتِ العَينُ إِلَيها قَلبَهُ","عَقِبَ التَشريقِ مِن يَومِ الأَضاح",36,"ح",1,0],["قادةٌ ما صادفوا أكفاءَهم","وجنودٌ مِثلُها لم يُخلَقِ",37,"ق",1,0],["قادَ النُفوسَ مَهابَةً وَمَحَبَّةً","بَدرٌ بَدا مُتَعَمِّماً بِسَوادِ",38,"د",1,0],["قادَ الخضارمةَ الملوكَ فوارساً","قد كان فارسَ جمْعها المشبوحا",39,"ح",2,0],["قادَ النَدى بِعِنانِهِ","وَتسَربَلَ المَعروفَ دِرعا",40,"ع",2,0],["قادَني نَحوَهُ الرَجاءُ فَصَدَّق","تُ رَجائي وَاِختَرتُ حَمدَ لِساني",41,"ي",1,0],["قادَهُ إِبليسُ طَوعاً","بَعدَما كانَ عَصِيّا",42,"ي",2,0],["قادَني لِلشَقاءِ جَهراً فُؤادي","وَفُؤادي فَعّالُ تِلكَ المُعيدُ",43,"د",1,0],["قادَ الجُنودَ مِن البُصَيرَةِ لِلعِدى","حَتّى وَقَعنَ بِصينِ ثَغرٍ قودا",44,"د",2,0],["قادَ النَباطِيَّ إِلى حَتفِهِ","نَظرَةُ عَينٍ شَطرَ مَحبوبِ",45,"ب",1,0],["قادَ الجِيادَ مِنَ الجَولانِ قائِظَةً","مِن بَينِ مُنعَلَةٍ تُزجى وَمَجنوبِ",46,"ب",1,0],["قادَني طَرْفي وقلبي للهوَى","كيف مِن طرْفي ومِن قَلبي حِذاري",47,"ي",1,0],["قادَ الجِيادَ إِلى الأعْداءِ سارِيَةً","قُبَّاً طَواها كطَيِّ العَصْبِ إِضْمَارُ",48,"ر",1,0],["قادَ جَيْشاً مِنْ قُلُوبٍ حَوْلَهُ","خاضعاتٍ إِنْ نَهَى أوْ أمَرَا",49,"ر",2,0],["قادهم خيرُ رئيسٍ للعُلا","شمريِّ العزم عالي الحَسَب",50,"ب",1,0],["قاد للمجد مناجيد الحمى","كلُّهم أرْوَعُ مُنْبَتُّ القَرينْ",51,"ن",1,0],["قاد السفينة في خضم زاخر","يطغى الدمُ القاني على غمراته",52,"ت",2,0],["قادوا الحمى في فجر نهضته؛ فما","عرفوا عن النهج السويِّ محيدا",53,"د",2,0],["قادة للجمودِ والجهلٍ في الشرق","على الشعب تنصُرُ استعمارا",54,"ر",2,0],["قادوا الجيوش فكلّ سهل ضيّق","ورموا المعاقل فهي أرض داحيه",55,"ي",2,0],["قادم من مدائن الريح وحدي","فاحتضني ،كالطفل، يا قاسيونُ",56,"ن",1,0],["قاده الطرفُ، يومَ سرنا، إلى الحي","نِ جهاراً، ولم يخفْ أنْ يحينا",57,"ن",2,0],["قادت فؤادي للعناء بنظرة","لو لم تكن نظرت لكنت مسلما",58,"م",2,0],["قاد الصليب بجهله مستنصراً","والنصر موقوف على الإسلام",59,"م",1,0],["قادوا الخيول فأعطيت أعداؤهم","لتغيظهم فتضاعفا ذلان",60,"ن",1,0],["قادَ مِنهُم نحوَ العداةِ أسوداً","رَجَفت مِن زئيرها الأنحاءُ",61,"ا",2,0],["قادَهُم للرشادِ طوعاً وكرهاً","سيفهُ وَالشريهةُ الغرّاءُ",61,"ا",2,0],["قادَ الجيوشَ بهمّةٍ وثّابَةٍ","وبهِ تحُفُّ ملائِكُ الرحمنِ",62,"ن",1,0],["قادَ الجِيادَ مَعاقِلاً وَإِن اِكتَفى","بِمَعاقِلٍ مِن رَأيِهِ وَحُصونِ",63,"ن",1,0],["قادني لحظُه إليه","دليلا بسحرهِ",64,"ر",2,0],["قادمٌ حتى يراني","قبل أن يرتدَّ طرفي",65,"ف",2,0],["قاد الخيول الصافنات الى العدا","ثم اِنتَضى بيضا تدل عَلى الهدى",66,"د",2,0],["قَادَ الخَليقَةَ مِنْ بُعْدٍ ومِن كَثبٍ","نَحْوَ الخَلِيفَةِ إِسجَاحٌ يُوالِيهِ",67,"ي",2,0],["قاد الصفوف صلاح الدين مجتهداً","وتحت رايتَهِ الإقدامُ والظفر",68,"ر",1,0],["قادَ عَوداً مِنَ الجُيوشِ لُهاماً","أَرعَنَ الحَجرَتَينِ حينَ يَسيرُ",69,"ر",1,0],["قادِرٌ أَوجَد الخَلائِقَ مِن لا","شَيءَ فَضلاً وَجادَ بِالآلاءِ",70,"ا",2,0],["قادحاتِ الحصَى كأنّ خُطاها","تَقذِفُ الجَوَّ منه بالشُّهْبِ قَذْفا",71,"ف",2,0],["قادَ الجِيادَ على وَجَاها شُزَّباً","قُبَّ البطونِ نَواحِلَ الأَبدانِ",72,"ن",1,0],["قَ ادّعاء السَّمع أعينُهم","ورُبّ خُبرٍ لَديهِ يَصغُرُ الخَبَرُ",73,"ر",1,0],["قادوا إليكَ المُضْمَرات كأنَّما","يغزون كِسْرى وَيْلَهُمْ أو قيصَرا",74,"ر",2,0],["قادَهم دَاعي المنايا","ولَكَمْ قادوا الجنودا",75,"د",2,0],["قاد الجيوش إلى صنعا وحاربه","فاضطر منه على صلح على دخن",76,"ن",1,0],["قادت إلى نهج الهداية أمة","فقوي بما أبرزته الإِسلام",77,"م",1,0],["قادوا إلى الإِسلام فاقرة","وعليه سيف ضلالهم سَلُّوا",78,"ل",3,0],["قادَت فُؤادَكَ فَاِستَقادَ وَمِثلُها","قادَ القُلوبَ إِلى الصِبا فَأَمالَها",79,"ل",3,0],["قادني الوَجْدُ وقد","كنتُ له صعب القياد",80,"د",1,0],["قادَ بِهِ أَجرَدُ ذو مَيعَةٍ","عَبلاً شَواهُ غَيرُ كابٍ عَثور",81,"ر",1,0],["قادَ وقادَ السودَ نحوَ","فهُمْ على الغارِ لهُمْ غارَهْ",82,"ه",1,1],["قادَهُ الحبُّ بين دمعٍ طليقٍ","وفؤادٍ من الجوى في عِقالِ",83,"ل",1,0],["قادَ الجيادَ إِلَى الجهادِ وَحَفَّنِي","بِنَدى يَدَيْهِ تَحْتَ ظِلَّيْ سَجْفِهِ",84,"ف",2,0],["قادت إِلَيْكَ بِهِ فِي عَهْدِ مُوثِقِهِ","قلائدٌ لَمْ يُضِعْها فِي مُقَلِّدِهِ",85,"د",2,0],["قادَ الجنودَ مُكاثِراً بِرِماحِها","شُهُبَ الدُّجى وبأُسْدِها عَدَدَ الدَّبا",86,"ب",2,0],["قادَ العُلا بِزِمَامِ كُلِّ فَضيلَةٍ","واقْتادَهُ الرَّاجِي بِغَيْرِ زِمَامِ",87,"م",1,0],["قادنا الشوقُ إِليها وصبَا","نحوها قلبُ الشجيِّ المغرَمِ",88,"م",1,0],["قادَني للرُبى مَرُوحَ العِنانِ","نفْحُ دَوْحِ النسيمِ في الرَيحانِ",89,"ن",1,1],["قادني نحوه الغَرامُ وفي جَفْنَيْ","هِ شيءٌ يدعو المحبَّ خفيُّ",90,"ي",1,0],["قاد العلا وجرى ففا","تَ وليس تُدرَك سُبَّقُهْ",91,"ق",2,0],["قاد الصعابَ الحُمسَ يش","تدّ لها ويلطُفُ",92,"ف",1,0],["قادَحهم ففازهم أروعُ ما","قامرَ في العلياء إلّا قَمَرا",93,"ر",2,0],["قادحتَها بمحاسنٍ","ما أصلدتْ أيسارُها",94,"ر",3,0],["قادها الودُّ بأسبابِ النُّهى","لمحلٍّ جَلَّ قَدْراً ومَقاماً",95,"م",2,0],["قاد الجحافل قبل مبلغ حلمهِ","تجبيرَ لا ضرعٍ ولا متخوف",96,"ف",1,0],["قادَ الجِيادَ إِلى الجِيادِ عَوابِسا","شُعثاً وَلَولا بَأسهِ لَم تَنقدِ",97,"د",1,0],["قادراً قاهراً تذل وتردي","كل ضد بعزة قعساء",98,"ا",2,0],["قادت إليه زمام الملك أربعة","نصر الهدى والندى والسيف والقلم",99,"م",1,0],["قاد قلبي منهُمُ أحْوَذِىٌّ","رشّحوهُ ليقودَ النِّياقا",100,"ق",2,0],["قادَتْ حِرانِيَ يوم النَّفْرِ خُرعُبَةٌ","وضلَّ عنِّي ما أُوتيتُ من جَلَدِ",101,"د",1,1],["قادرٌ في الحال يأخذهم","بي على قهر وإرغام",102,"م",1,0],["قاده الشرع كالبهيمة ينقا","د بإيمانه فيدنو البعيد",103,"د",1,0],["قاده السُّكْرُ إلى أحبابِهِ","فَشَكَرْنا ذاك من فِعْلِ السُّكُرْ",104,"ر",1,0]]}