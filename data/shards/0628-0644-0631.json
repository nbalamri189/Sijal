{"poems":[[9,"هل أنت يا مصلات مب","https://www.aldiwan.net/poem21972.html","مجزوء الكامل"],[85,"مولاي يوم الجمعه","https://www.aldiwan.net/poem54276.html","مجزوء الرجز"],[90,"هكذا يدرك في الدنيا الكمال","https://www.aldiwan.net/poem45045.html","الرمل"],[53,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[53,"بان شبابي فعز مطلبه وانبت بيني وبينه نسبه","https://www.aldiwan.net/poem8518.html","المنسرح"],[53,"نفرت هيفك الليالي وغيدك","https://www.aldiwan.net/poem61938.html","الخفيف"],[53,"أيعيب مشيي جاهل لو أنه","https://www.aldiwan.net/poem64670.html","الكامل"],[53,"يا سليمان لا ألومك في رد","https://www.aldiwan.net/poem66031.html","الخفيف"],[68,"بدت لنا الراح في تاج من الحبب","https://www.aldiwan.net/poem38500.html","البسيط"],[15,"أقفر من أهله ملحوب","https://www.aldiwan.net/poem45286.html","مخلع البسيط"],[78,"بل رب مذهبة المزاج ومذهب","https://www.aldiwan.net/poem39005.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42734","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42564","الكامل"],[63,"","https://poetry.dctabudhabi.ae/diwan/poem/50177","الرجز"],[108,"عصفورة تتحدى النسور!","https://www.poetsgate.com/ViewPoem.aspx?id=179471",""],[131,"يا من لقلب شديد الهم محزون","https://www.aldiwan.net/poem24221.html","البسيط"],[139,"لم أهدكم هذي الرسالة آملا","https://www.aldiwan.net/poem49018.html","الكامل"],[146,"إن لم أكن من راضعى الخمر","https://www.aldiwan.net/poem58375.html","السريع"],[164,"يوم سرور وشفاء صدر","https://www.aldiwan.net/poem59024.html","الرجز"],[164,"يا بحر علم يزخر","https://www.aldiwan.net/poem59124.html","مجزوء الرجز"],[164,"الفسح يطلب منكم الكرماني","https://www.aldiwan.net/poem59188.html","الكامل"],[228,"أترى جاءت لكي تصطاد","https://www.aldiwan.net/poem41904.html","مجزوء الرمل"],[230,"أبصر الثعلب الغراب على غص","https://www.aldiwan.net/poem55143.html","الخفيف"],[231,"داعي الحياة","https://www.aldiwan.net/poem24239.html","عموديه"],[310,"بل ربما قد كان في أغمارهم","https://www.aldiwan.net/poem56393.html","الكامل"],[438,"أعلمت أن من الصدود خدورا","https://www.aldiwan.net/poem12313.html","الكامل"],[463,"ياابنة القوم تراك","https://www.aldiwan.net/poem56083.html","مجزوء الرمل"],[563,"لا تمش معه كما ترى","https://www.aldiwan.net/poem34486.html","مجزوء الكامل"],[580,"أحسنتم إن تحسنوا في الفعل","https://www.aldiwan.net/poem3038.html","الرجز"],[591,"ما رأينا ضربة من صارم","https://www.aldiwan.net/poem18020.html","الرمل"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2420","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138246",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138300",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138288",""],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96987","الخفيف"],[701,"","https://poetry.dctabudhabi.ae/diwan/poem/107332","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38925","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77575","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77503","المنسرح"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77505","الرجز"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107215","الرمل"],[1011,"","https://poetry.dctabudhabi.ae/diwan/poem/124612","الكامل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126173","الرجز"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56277","البسيط"],[1239,"","https://poetry.dctabudhabi.ae/diwan/poem/128274","الكامل"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82286","السريع"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79846","الرمل"],[1627,"","https://poetry.dctabudhabi.ae/diwan/poem/29571","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108632","الخفيف"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128000","البسيط"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52074","الرجز"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104690","الكامل"],[2231,"","https://poetry.dctabudhabi.ae/diwan/poem/124055","الكامل"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46740","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87316","الرجز"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105660","الكامل"],[2760,"","https://poetry.dctabudhabi.ae/diwan/poem/146509","الكامل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65980","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93842","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100227","الكامل"],[3272,"","https://poetry.dctabudhabi.ae/diwan/poem/143936","السريع"],[3386,"","https://poetry.dctabudhabi.ae/diwan/poem/124616","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62893","المنسرح"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138466",""],[3600,"","https://poetry.dctabudhabi.ae/diwan/poem/178031",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91132","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118014","الرجز"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59513","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114051","الخفيف"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102948","الكامل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[4387,"","https://poetry.dctabudhabi.ae/diwan/poem/124044","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133137","الكامل"],[4480,"","https://poetry.dctabudhabi.ae/diwan/poem/28927","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120287","الخفيف"],[4927,"غيابُ عفراء","https://www.poetsgate.com/ViewPoem.aspx?id=29828",""],[3591,"يا أمير البلاد أهدي سلاماً","https://www.poetsgate.com/ViewPoem.aspx?id=149442",""],[5121,"مَاتَ يَوْمِي","https://www.poetsgate.com/ViewPoem.aspx?id=33573",""],[5136,"دعه يبكي فمن بكى يستريح","https://www.poetsgate.com/ViewPoem.aspx?id=121548",""],[5155,"أين الفتى السياب!؟","https://www.poetsgate.com/ViewPoem.aspx?id=176271",""],[5206,"مناهج الله","https://www.poetsgate.com/ViewPoem.aspx?id=187391",""],[470,"أنا المليكُ وأوجاعي مماليكي!","https://www.poetsgate.com/ViewPoem.aspx?id=178024",""],[5660,"وَيحَ الأَماني إِذا كانَت مِنَ العَدَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=36845",""],[5672,"من بقايا الرثاء...","https://www.poetsgate.com/ViewPoem.aspx?id=206450",""],[5956,"علائق الروح ما بيني وبين أبي","https://www.poetsgate.com/ViewPoem.aspx?id=192096",""],[5956,"ضربتْ سكوني يا إلهُ شجونُها","https://www.poetsgate.com/ViewPoem.aspx?id=192384",""],[5956,"ما درَّ شعري هكذا لسواكما","https://www.poetsgate.com/ViewPoem.aspx?id=193703",""],[5956,"لو مات أولادي لن أحزنا","https://www.poetsgate.com/ViewPoem.aspx?id=194592",""],[5956,"القدِّيسة النقية تقية","https://www.poetsgate.com/ViewPoem.aspx?id=215548",""]],"verses":[["بَل رُبَّ مَجرٍ جَحفَلٍ","يَهوي بِهِ مَلِكٌ حُلاحِل",0,"ل",1,0],["بل روضة ممطورة","أزهارها منوّعَهْ",1,"ع",2,0],["بل رأى أوطانه يرهقها","من بني الغرب انتداب واحتلال",2,"ل",1,0],["بل رأوا رحمةَ الأعادي ولاقَو","هم مِلاءً بعَسْفهم أوفياءَ",3,"ا",2,0],["بل راعني أنه دليلُ بلى","والعودُ يذوي إذا ذوى هَدَبُهْ",4,"ب",2,0],["بل رُواءٌ ومَخْبرٌ وفِعَالٌ","عقدتْ دون غيرها تسويدَكْ",5,"ك",1,0],["بل رُجمةً لهُمُ سماجة منظرٍ","بل رحمة لتتابع الأنفاس",6,"س",1,0],["بل رأيت المديحَ فيك قبيحاً","كَلبوسٍ على عروسٍ ذميمَهْ",7,"م",2,0],["بَل رُبَّ لَيلٍ غَدا في الآهِباتِ غَدَت","تَنقَضُّ فيهِ كُؤوسٌ وَهيَ كَالشُهُبِ",8,"ب",1,0],["بَل رُبَّ ماءٍ وَرَدتُ آجِنٍ","سَبيلُهُ خائِفٌ جَديبُ",9,"ب",1,0],["بل ربَّ مُذْهبةِ المزاجِ ومُذْهَبٍ","راحا براحةِ ريمهِ وغزالهِ",10,"ه",1,1],["بَلْ رُبَّ سَارِيَةٍ هَطْلاءَ دَانِيَةٍ","تَنْمُو السَّوَامُ بِهَا وَالنَّبْتُ يَكْتَهِلُ",11,"ل",1,0],["بَلْ رُبَّ غَانِيَةٍ طَرَقْتُ خِبَاءَهَا","وَالنَّجْمُ يَطْرِفُ عَنْ لَواحِظِ أَرْمَدِ",12,"د",1,0],["بل رغبةٌ فيها شبيهَ الزُّهْدِ","ولم تَزَلْ بالماءِ كفُّ العَبدِ",13,"د",1,0],["بل رأته بين السحاب، فنادت","ه؛ فلبى نداءَها غيرَ وان",14,"ن",1,0],["بَل رُبَّ حَيٍّ شَديدِ الشَغبِ ذي لَجَبٍ","دَعَوتُهُم رَهناً مِن بَعدِ مَرهونِ",15,"ن",1,0],["بل رمت ذكرى حافظ العهد الذي","إفضالكم عمّ الأنام وفاته",16,"ه",1,0],["بل ربما طاف بها أهيفٌ","أجفانه من صُحُف السحرِ",17,"ر",1,0],["بل رفده الشفع ينيم وفده","ولا ينام جفنه عن وتر",18,"ر",1,0],["بل ربما ركبتها","فكان ما لا يحصر",19,"ر",1,0],["بل رأيه التطواف من أرض إلى","أرض ومن وطن إلى أوطان",20,"ن",1,0],["بَل رَمَتهُ فَوقَ كانو","نِ هَواها وَشَوَتهُ",21,"ه",1,0],["بَل رَأى الجُبنَةَ الشَهِيَّةَ تَهوى","فَبَكاها وَلاتَ حينَ بُكاءِ",22,"ا",2,0],["بل رحيق الخلد قد طاب جناه","وسرى فيه حلاه وشذاه",23,"ا",2,0],["بل ربّما قَد كان في أغمارِهم","إِيثارُ دُنياهم على الأديانِ",24,"ن",1,1],["بَلْ رُبَّ خِرْقٍ جُبْتُهُ بِأَجادِلٍ","يَحْمِلْنَ مِنْ أَكْوَارِهِنَّ وُكُورا",25,"ر",2,0],["بل رزئياتٌ تواصَي","ن شَماتاً بانتهاكي",26,"ك",2,0],["بل رؤية لا رؤية","وجرى الحديث وما جرى",27,"ر",2,0],["بل رِدْفُه كالجدِّ تحت خِصْرِه","وخِصْرُه من فوقِه كالهزل",28,"ل",1,0],["بَلْ رَأَيْنا مَشقَّةً من كاتِبٍ","في سِجلٍّ كَسَرَتْ أَلف قَلَمْ",29,"م",1,0],["بَل رُبَّ دُنيا قَد رَأَي","تُ كَبيرَةٍ حَقّاً مَزيرَه",30,"ر",2,0],["بل روض تاريخ زهت أدواحه","وأرتك من أزهى الزمان عهودا",31,"د",2,0],["بل روضة أزهارها قد عطّرت","قطراً غدا باريجهن معطِّرا",32,"ر",2,0],["بل روض كل بلاغة وفصاحة","والنبت معناه ألانيق المبتكر",33,"ر",1,0],["بل رأيت النار التي قد رآها","صاحب الطور يوم قد خر ذعرا",34,"ر",2,0],["بل رُدَّ من جار وانصر كلَّ مهتضَمٍ","وحاوِل الأمنَ فيما شطَّ واقتربا",35,"ب",2,0],["بَل رَطَّبت مِنّا البشائِرُ أَكبداً","كادَت تَذوبُ حَرارَةً بِجنانها",36,"ن",3,0],["بَل رُحت هارِباً عَلى جَوادي","وَراحَتي اليُمنى عَلى فُؤادي",37,"ي",1,0],["بَل راحَ يَسعى إِلى أَبيها","وَكانَ مِن تَحتِهِ حِصانُ",38,"ن",1,0],["بَل رَجع الفارس وَالحِصان","كِلاهُما مِن تَعَبٍ عرقان",39,"ن",1,0],["بَل رَضِينا في التَّصَابِي جَورَهُ","كُلَّما رامَ فُؤادِي هَجرَهُ",40,"ه",1,0],["بل ربما حكم القصور بما يرى","من كونها ليست له بمعان",41,"ن",1,0],["بل ربما أغرى فتىً مشغوفاً","بشربه فاستهون المصروفا",42,"ف",2,0],["بل ربما إن فحواه يؤثر في","سمعي أشدّ من الطعن الذي نفدا",43,"د",2,0],["بل ربما فاقوا الذئا","ب بما جنوا خلف الحجاب",44,"ب",1,0],["بَل ريحهُ أَطيَبُ مِن ريحِهِ","وَمَسّه أَليَنُ مِن مَسِّهِ",45,"س",2,0],["بل رآه حول كسرى فاكتسى","وجهُه من سورة الغيظ قُطوبا",46,"ب",2,0],["بَل رُبَّ خَرقٍ لا أَنيسَ بِهِ","نابي الصُوى مُتَماحِلٍ سَهبِ",47,"ب",1,0],["بل رأينا الذين تاهوا وباهوا","مثل ما قال عنهم اللَه بورا",48,"ر",2,0],["بل راح ينثر من أكمامه بدرا","له وثوبا موشاة بها اتشحا",49,"ح",2,0],["بل رجائي مقدار ما أنتم أه","ل بان تبلغوا نفوساً مناها",50,"ا",3,0],["بَلْ رُبَّمَا عَدُّوا الذي","أذْنَبَ مِثلَ المُفْضَلِ",51,"ل",1,0],["بَل رَافِعاً إِذ ذَاكَ رَأساً فِى السَّما","لِعُلُوِّهِ حَقّاً يُشِيرُ بِفَضلِ بَر",52,"ر",1,0],["بل رب هاجرةٍ نصبن أنوفَها","منها لانفاس كلفح النار",53,"ر",1,0],["بَل رُبَّ مُعتَرِضٍ رَدَدتُ جِماحَهُ","في رأسِهِ فأقَرَّ وَهوَ لَئيمُ",54,"م",1,0],["بَل رأسُهُ الجاهي مَعَ البَنَادر","ومُنزلِ السُّلطان والجزائرِ",55,"ر",1,0],["بل رتلي للنفس","أنغام الهوى كالبلبل",56,"ل",1,0],["بلْ رُبَّ خَرْقٍ لا أنيسَ به","نابِي الصُوى مُتماحلٍ شَهْبِ",57,"ب",1,0],["بل راسبي أصله من يعرب","إذ قلَّ أهلوها مع القلاَّل",58,"ل",1,0],["بل راح مجنوناً بها","مثلي وكنا بالسويه",59,"ي",2,0],["بل راع قلبي أغيدٌ","تستلٌّ من جفنيه قضب",60,"ب",1,0],["بل راضيا ما كان منه وإن","حملت في الحب على صعبه",61,"ب",2,0],["بل ربنا بلواء المجد جاد لكم","إن قيل لا قلمن يعطى ولابن من",62,"ن",1,0],["بل رامَ في الحُبِّ أَنْ أُساعدهُ","وأَينَ جِدِّيَ في الحُبِّ من لَعِبِهْ",63,"ب",2,0],["بل رضوا ما اختاره الله لهم","وإليها اختار في الدنيا بلاه",64,"ا",2,0],["بل رسلنا الكتب التي","تجري بخافية الصدور",65,"ر",1,0],["بل رُمت تَفريق اللفي","ف وَصدع جَمع بِالهَواجس",66,"س",1,0],["بل ربما وحسبها في الدار","بالقهر من رجالها الأحرار",67,"ر",1,0],["بل رُبَّ يومٍ قد لهوت وليلةٍ","بمزامرٍ ومخامرٍ وحواصن",68,"ن",1,0],["بَل رِياحٍ تُثِيرُ سُحباً صَهِيلٌ","رَعدُهُ قَدحٌ بَرقُهُ اللألاَءُ",69,"ا",2,0],["بل روضة للخير لا هوتية","تحيا بها الأرواح والأجساد",70,"د",1,0],["بل ربما يضيعون حقه","وأنت ذاك يا سعيد الجد",71,"د",1,0],["بل روضة مطلولة بهيه","بل درّة مكنونة مضيه",71,"ه",1,0],["بل رحمة عمّت جميع الأرض من","عند الكريم المنعم المتفضّل",72,"ل",1,0],["بل ربما