{"poems":[[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[275,"تذكرت ما أبلى الزمان وما غير","https://www.aldiwan.net/poem35628.html","الطويل"],[275,"أحن إلى طيب الغدائر والفم","https://www.aldiwan.net/poem35634.html","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137113",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201150","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202917","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202831","الطويل"],[4764,"شيخة الظبيان","https://www.poetsgate.com/ViewPoem.aspx?id=24834",""],[5005,"وُد.....","https://www.poetsgate.com/ViewPoem.aspx?id=189352",""],[5818,"ملهمة شعري","https://www.poetsgate.com/ViewPoem.aspx?id=199981",""],[5956,"تسائلني: أكلتَ؟","https://www.poetsgate.com/ViewPoem.aspx?id=182647",""]],"verses":[["أَحبُّ جميعِ العالمين لربّهِ","وَأَعظمُهم خَوفاً له وله شكرا",0,"ر",2,0],["أُحبُّ جمالاً بالجلال محجَّباً","بأبيض يُحمى بينَ أهليه أو أسمر",1,"ر",1,0],["أُحبُّ جمالَ الفنّ في كلّ صورة","وقلبي طروبُ للجمالِ المتمّم",2,"م",1,0],["احب جميع الناس من كل ملة","وليس له في الناس من يضمر البغضا",3,"ض",2,0],["أحب جميع أشعاري ولكن","وفيرُ الحب للشعر الأخير",4,"ر",1,1],["أحب جميع الكون أهوى ارتياده","فلي كل حينٍ بالوجود هوى غضُّ",5,"ض",1,1],["أحبُّ جمالاً بالمخاطر مرفقاً","وأهوى من الأثمار ما عزّ مجتنى",6,"ن",2,0],["أحبج .. والهوى بَحرين ..تِقاسَم روحي الساعه","بَحر يرمي مِن الطيبه ..مراسي شوقه الظميان",7,"ن",1,0],["أحبّ جنوناً بشَعرِك يلهو","وعقلاً ونضجاً بعينيك يبدو",8,"د",2,0],["أحبّ جمالكِ الفِطري","وكفّاً ناعماً أخضبْ",9,"ب",1,0],["أحب جمالَها الفتا","‏ ‏ ‏ نَ يحملني إلى العليا ‏ ‏",10,"ي",2,1]]}