{"poems":[[89,"إن فعل الرجال غير الكلام","https://www.aldiwan.net/poem44616.html","الخفيف"],[66,"تركتنا لواحظ الأتراك بين","https://www.aldiwan.net/poem40647.html","الخفيف"],[369,"صدق الصد للملوك علامه","https://www.aldiwan.net/poem57138.html","البسيط"],[377,"لو يكون اللقاء باستحقاق","https://www.aldiwan.net/poem49203.html","الخفيف"],[413,"أترى في الوجود مثلك عالم","https://www.aldiwan.net/poem54119.html","الخفيف"],[512,"بزغت بالظلام شمس الديور","https://www.aldiwan.net/poem20787.html","الخفيف"]],"verses":[["كل ظني أن الحقيقة تبدو","بعد حين مميطة للثام",0,"م",1,0],["كُلُّ ظَبيٍ في أَسرِ رِقّي وَلَكِن","ما لِأَسري في حُبِّهِ مِن فَكاكِ",1,"ك",1,0],["كلُّ ظنٍّ سألتُه عَن نَداهُ","قائِم قائِل بهِ عَلامَه",2,"م",2,0],["كُل ظل مَع النَوى يَحموم","كُل وَرد كَذاكَ مِن غَساق",3,"ق",1,0],["كل ظامٍ على مناهل ما أو","تيت من فضل ربك حايم",4,"م",1,0],["كلُّ ظَبيٍ عزيزِ شكلٍ غَرير","يفضحُ البدرَ بالجَمال الغَزيرِ",5,"ر",1,0]]}