{"poems":[[91,"إن فعل الرجال غير الكلام","https://www.aldiwan.net/poem44616.html","الخفيف"],[68,"تركتنا لواحظ الأتراك بين","https://www.aldiwan.net/poem40647.html","الخفيف"],[376,"صدق الصد للملوك علامه","https://www.aldiwan.net/poem57138.html","البسيط"],[385,"لو يكون اللقاء باستحقاق","https://www.aldiwan.net/poem49203.html","الخفيف"],[422,"أترى في الوجود مثلك عالم","https://www.aldiwan.net/poem54119.html","الخفيف"],[519,"بزغت بالظلام شمس الديور","https://www.aldiwan.net/poem20787.html","الخفيف"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133861","السريع"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126124","الرجز"],[5168,"يا ورده تعيش بمزهريه؟","https://www.poetsgate.com/ViewPoem.aspx?id=33676",""]],"verses":[["كل ظني أن الحقيقة تبدو","بعد حين مميطة للثام",0,"م",1,0],["كُلُّ ظَبيٍ في أَسرِ رِقّي وَلَكِن","ما لِأَسري في حُبِّهِ مِن فَكاكِ",1,"ك",1,0],["كلُّ ظنٍّ سألتُه عَن نَداهُ","قائِم قائِل بهِ عَلامَه",2,"م",2,0],["كُل ظل مَع النَوى يَحموم","كُل وَرد كَذاكَ مِن غَساق",3,"ق",1,0],["كل ظامٍ على مناهل ما أو","تيت من فضل ربك حايم",4,"م",1,0],["كلُّ ظَبيٍ عزيزِ شكلٍ غَرير","يفضحُ البدرَ بالجَمال الغَزيرِ",5,"ر",1,0],["كل ظهور واضح نعمة","من حرية أيان ما يجري",6,"ر",2,0],["كل ظلام وغمام ينجلي","بالقمرين النيرين ابني علي",7,"ي",1,0],["كل ظنهم اعوفك , آني مجنون؟","شلون اكدر اصلي بغير نية",8,"ي",2,0]]}