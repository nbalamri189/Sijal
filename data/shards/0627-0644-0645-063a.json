{"poems":[[104,"هادئ القلب مطبق الأجفان","https://www.aldiwan.net/poem33126.html","الخفيف"],[240,"لأبي علي مرتقى","https://www.aldiwan.net/poem31801.html","مجزوء الكامل"],[357,"المغرب","https://www.aldiwan.net/poem961.html",""],[463,"سائل الدار إن سألت خبيرا","https://www.aldiwan.net/poem56165.html","الخفيف"],[466,"لا أوحش الله من جود أسر به","https://www.aldiwan.net/poem16426.html","البسيط"],[543,"عفوا إذا أكثرت من إنشادي","https://www.aldiwan.net/poem48209.html","عموديه"],[556,"أعلى العهد منزل بالجناب","https://www.aldiwan.net/poem48064.html","الخفيف"],[591,"المغرم من ذكراكم يقلقه","https://www.aldiwan.net/poem17624.html","مخلع الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38957","البسيط"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56636","الخفيف"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102066","الكامل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87799","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100273","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132719","البسيط"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136801",""],[4728,"الطفل ودموع الأمتين","https://www.poetsgate.com/ViewPoem.aspx?id=176955",""],[5032,"طَلْقة","https://www.poetsgate.com/ViewPoem.aspx?id=189835",""],[5112,"البدر الراحل","https://www.poetsgate.com/ViewPoem.aspx?id=212708",""],[5419,"نقوش","https://www.poetsgate.com/ViewPoem.aspx?id=31470",""],[5720,"أنتَ الإِلٰهُ","https://www.poetsgate.com/ViewPoem.aspx?id=201610",""],[5776,"لحيةُ الصّبح","https://www.poetsgate.com/ViewPoem.aspx?id=199324",""],[5891,"أحلام الموتى","https://www.poetsgate.com/ViewPoem.aspx?id=39927",""],[6089,"شاعرة البلاد","https://www.poetsgate.com/ViewPoem.aspx?id=213028",""],[6089,"يا سيد الأرض الكريمة","https://www.poetsgate.com/ViewPoem.aspx?id=215728",""],[549,"موسيقى مؤجَّلة","https://www.poetsgate.com/ViewPoem.aspx?id=202998",""],[6212,"أميرة الماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1629&r=&rc=10",""]],"verses":[["المَغاوير حَضرٌ وَبداة","زمجروا دونَ أُمة الطُغيان",0,"ن",1,0],["أَلمُغمِدِ البيضَ الصَوارِ","مَ في الجَماجِمِ وَالمَفارِق",1,"ق",1,0],["المغرب المعطاء أجمل جنة","فيها وجدت سعادتي وأماني",2,"ن",2,0],["المغاني أحفى بقلبي من العذ","ل وإن هجن لوعةً وزفيرا",3,"ر",2,0],["المُغْمِدُ البيضَ في هامِ الكُماةِ ضُحىً","والحاطِمُ السُّمْرَ في اللَّبَّاتِ والثُّغَرِ",4,"ر",1,0],["المغربُ الأقصَى اذكرُوه كلَّما","كانت دموعُكُمُ علَى اتسعدَاد",5,"د",1,0],["المَغاني تلكَ المَغاني فَهل في","هنَّ ما قَد عهدتُ مِن أَطرابي",6,"ب",2,0],["المُغْرَمُ مَنْ ذِكْراكُم يُقْلِقُهْ","وَالعانيَ مَنْ أَشْواقُكُمْ تَحْرِقُهْ",7,"ه",1,1],["المَغرِبي الّذي فيلالِ بَلدتهِ","وَفَخرها فيهِ لَم يَبرح بِمُنكشفِ",8,"ف",1,0],["المغاني التي بكيت عليها","باقيات تكلمي يا مغان",9,"ن",1,0],["المغرد المحبوب قطب زمانه","وأوانه الوهاج دع من غركا",10,"ك",2,0],["المغطس الحامي وَقَعت بِهِ","وَأَراكَ لا تَنفَكُّ في غَطس",11,"س",1,0],["المغنيات السمر في سلب","والغانمات الخيل في طردِ",12,"د",1,0],["المغمدون الضبا في كل معترك","حيث الحجى ومناط البيض واللمم",13,"م",1,0],["المغربي قاسم من قبله","ضريحه وكان شيخ الجمله",14,"ه",1,0],["المغني رقص كنه ذكر من يحبه","خاف له حد بعد منه وهو مشتغب به",15,"ب",2,1],["المغول يقود فرسانها جنكيزخان","والمغارب قاد فرسانها بن تاشفين",16,"ن",1,0],["الْمُغْلِقُون على الحَقِيْقَةِ","يَكْرَهُون الأَسْئلَة",17,"ل",2,1],["المَغْرِبُ؟ لَا مَغْرِبَ يَأْتِي","لَا قَهْوَةَ مِنْ ثَغْرِ الْفَجْرِ",18,"ر",1,0],["المغربُ العربيُّ اغتمَّ ساحلُه","وفي الجزيرةِ شادَ الحزنُ بنيانا",19,"ن",2,0],["المغني البَر ّ الكري","مُ بِمَنِّهِ .. والماجدُ",20,"د",1,0],["المغنّي تذوبُ فيه الأغاني","والمغني يذوبُ في الوزنِ لحنا",21,"ن",2,0],["المغنون عليكم أقبلوا","يملأون البحر يطغى يغرقون",22,"ن",1,0],["المغرب اتشحتْ سنا الكلمات وال","أفراحُ لايُخشى هناك نفادُها",23,"د",3,0],["المغرب العظمى به سارت إلى","قمم المعارف والمعارف منجدُ",24,"د",1,0],["المُغْلَقُونَ وكفُّ الشِّعرِ تفتحُنا","همساً، ونحن على رَفِّ الأَسَى عُلَبُ",25,"ب",1,0],["المغربُ الأقصى على أهدابها","شَرْقٌ، يَزُفُّ جناهُ طَرْفٌ أَحْوَرُ!",26,"ر",1,0]]}