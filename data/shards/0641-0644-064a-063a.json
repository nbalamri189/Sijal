{"poems":[[75,"لو كان قولك مت ما كان ردي لا","https://www.aldiwan.net/poem11895.html","البسيط"],[53,"لم يبكني رسم منزل طسما","https://www.aldiwan.net/poem66036.html","المنسرح"],[71,"تركت مكاتبتي عامدا","https://www.aldiwan.net/poem29012.html","المتقارب"],[48,"سبحان ربك هل يزول كغيره","https://www.aldiwan.net/poem22706.html","الكامل"],[48,"لو كانت الخمر حلا ما سمحت بها","https://www.aldiwan.net/poem23476.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54615","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54605","الكامل"],[102,"بشرى النبوءة","https://www.poetsgate.com/ViewPoem.aspx?id=50187",""],[290,"ماذا أقول وقد وقفت بموقف","https://www.aldiwan.net/poem39428.html","الكامل"],[333,"فوق هذي الربا أقمت وحيدا","https://www.aldiwan.net/poem54989.html","الخفيف"],[361,"يا موت طرفى رهانٍ","https://www.aldiwan.net/poem24534.html","البسيط"],[396,"الحمدلله حمدا موافيا بالنوال","https://www.aldiwan.net/poem54549.html","عموديه"],[505,"كتب الظلام على الوجود سطورا","https://www.aldiwan.net/poem38003.html","مجزوء الكامل"],[547,"رطلان لا أزداد فوقهما","https://www.aldiwan.net/poem34020.html","أحذ الكامل"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112464","الرمل"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93088","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79996","البسيط"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/78005","الرجز"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100463","المتقارب"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71064","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53129","الكامل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28476","السريع"],[2919,"","https://poetry.dctabudhabi.ae/diwan/poem/198742",""],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100503","الرجز"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126944","السريع"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129364","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91153","الطويل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107530","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136675",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120555","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139470",""],[5100,"قلب وثانية....","https://www.poetsgate.com/ViewPoem.aspx?id=207713",""],[5861,"ألم الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=190619",""],[5950,"أغاني الراحلين ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128337",""]],"verses":[["فَليُغنِ كَفَّكَ أَنّي بَعضُ مَن مَلَكَت","وَلِيَكفِ طَرفَكَ أَنّي بَعضُ مَن قَتَلا",0,"ل",2,0],["فليغْنَ في غِبطةٍ تدومُ له","ووعْظِ بَلْوى تزورُه لَمما",1,"م",2,0],["فلي غيرةٌ مِنْ رسولٍ سعى","إليكَ وقدْ كنتُ أولى بذاكا",2,"ك",2,0],["فَلِيُغنِ عَن لِبسِ الشُفوفِ نَسائِجاً","بِالتِبرِ لُبسُكَ رَثَّةَ الأَطمارِ",3,"ر",1,0],["فَليَغفِرِ اللَهُ كَم تَطغى مَآرِبُنا","وَرَبُّنا قَد أَحَلَّ الطَيِّباتِ لَنا",4,"ن",2,0],["فَلْيَغْنِمَا العَيْشَ وَلْيَجُوزَا","مَدَاهُ فِي نَعْمَةٍ وَطِيبِ",5,"ب",1,0],["فَلْيَغْنِمَا نِعَمَ الْحَيَاةِ وَيَبْلُغَا","أَسْنَى الْمُنَى مَوْفُورَةَ الأَسْبَابِ",6,"ب",1,0],["فليغنم الجور إقبال الزمان له","فإنّ إقباله إنذار إدبار",7,"ر",1,0],["فليغضض الأدباء طرف ذكائهم","حتى أمر ومنطقي مشكور",8,"ر",1,0],["فليُغنّوا به فما هو إلا","بعض ما يشعرون أو يُلهمونا",9,"ن",2,0],["فليغتنم أجره ذو الصبر بعدهما","وليخش ذو جزع من أمره الفرط",10,"ط",1,0],["فليغسل الجسم كله لا يبقى خلال","ولينو فرض اغتساله عند صب الزلال",11,"ل",1,0],["فلْيَغْشَ منكَ الطَّوقَ حُبًّا باللِّقا","وتَذَكَّرَنْ إذْ حلَّ موسى الطُّورا",12,"ر",2,0],["فَليَغتَفِر لي مَن يُنادمني","أنِّي أُحِبُّ عواقِبَ الرُّشدِ",13,"د",1,0],["فليغنوا ولتغالي بالنواح","يا أبا المنذر حتى تقبرا",14,"ر",2,0],["فليغضض الطرف عما ليس يدركه","وليربع القوم قد شق الذي طلبوا",15,"ب",3,0],["فليغتد اليوم كلُّ خدرٍ","أعمادُ أسجافه تطيحُ",16,"ح",1,0],["فليغضض الجاهل من طرفه","وليلو عن ذلك وليزدجر",17,"ر",1,0],["فلي غلمة يرتقون السماك","لكسب المعالي ونيل الكمال",18,"ل",1,0],["فلي غَرَضٌ لا بُدَّ لي من ركوبه","بلا رقبةٍ منِّي ولا بحذار",19,"ر",1,0],["فليغتبط ملك نهضت بعبئه","وليمش خطو الدهر عنه القهقرى",20,"ر",2,0],["فَلي غَرامٌ بِكَ ما أَضرَمَت","زِنادَهُ البِيضُ الرَّعابِيبُ",21,"ب",1,0],["فَلِيَغْرُبِ التَّاريخُ مَا التَّاريخُ مَا حِبْرُ الكِتَابِ","الكَوْنُ يَحْفَظُ زَايِداً يَتْلُوهُ في وَهَجِ الشِّهَابِ",22,"ب",1,0],["فليغتبط وليهنه أن قد أتى","تأريخه حاز من اللَه الرضا",23,"ض",2,0],["فليغرفوا من أبحري كلهم","وليقطفوا الأزهار من روضتي",24,"ت",2,0],["فليغد يشكر عفتي","بين المخلخل والسوار",25,"ر",1,0],["فَلي غلظة يَخشى عدوّي وَبالها","وَبي رَأفةٌ يَرجو صديقي وَسائلي",26,"ل",2,0],["فليغد موتكما حياةً للورى","وليمحُ طيب دماكما ذاك الدما",27,"م",2,0],["فليغضَّ الغداةَ حاسدُك الطرف","ففي الشَمس تخطفُ الأبصار",28,"ر",1,0],["فليغتنم انس التعارف وفده","فالدهر بين مفرق ومجمع",29,"ع",1,0],["فليغث دين جده وليغثنا","اننا بافتقار غوثٍ سواء",30,"ا",2,0],["فليغتسلْ طينُ المُحبِّ بِوَصْلِها","حتى يُجدّدَ ذنبُهُ إيمانَهْ",31,"ن",2,0],["فلي غيبةٌ أخفي جروحي وندبَها","ألملمُ أشلائي وأصداءِ قِيلِهِ",32,"ل",2,0],["فليغفر الله ذنب أوهامي إن ( قامت","بحمل روحي إلى ما يقتل أحلامي )",33,"م",2,0]]}