{"poems":[[73,"أشاقك من عليا دمشق قصورها","https://www.aldiwan.net/poem4027.html","الطويل"],[23,"قومي الذين هم آووا نبيهم","https://www.aldiwan.net/poem21570.html","البسيط"],[74,"عيد يعود إلى هذا الثنا العالي","https://www.aldiwan.net/poem19474.html","البسيط"],[26,"وما حمل البختي عام غياره","https://www.aldiwan.net/poem24080.html","الطويل"],[63,"لقد طمع البشري في ولم يكن","https://www.aldiwan.net/poem51804.html","الطويل"],[60,"أنا الصقر الذي حدثت عنه","https://www.aldiwan.net/poem30891.html","الوافر"],[99,"قلب تقسم بين الوجد والألم","https://www.aldiwan.net/poem24873.html","البسيط"],[71,"أدر أحاديث سلع والحمى أدر","https://www.aldiwan.net/poem28789.html","البسيط"],[50,"أجارة بيتينا أبوك غيور","https://www.aldiwan.net/poem63375.html","الطويل"],[111,"أشعة الحق لا تخفى عن النظر","https://www.poetsgate.com/ViewPoem.aspx?id=512",""],[146,"إذا نثر الناس الهرقلية الصفرا","https://www.aldiwan.net/poem58435.html","الطويل"],[280,"ألما بأشلاء العلى والمكارم","https://www.aldiwan.net/poem25526.html","الطويل"],[302,"أشارت من لها في الحسن شاره","https://www.aldiwan.net/poem33259.html","الوافر"],[358,"تصاحى نديم الحان من نشوة السكر","https://www.aldiwan.net/poem40344.html","البسيط"],[369,"رأيت الطريق إلى الوصل وعرا","https://www.aldiwan.net/poem60911.html","الطويل"],[369,"ألا ليت قلبي يوم أعلن وجده","https://www.aldiwan.net/poem60955.html","الطويل"],[371,"عذول الهوى يبني بغير أساس","https://www.aldiwan.net/poem17018.html","الطويل"],[415,"أيا منقذي والحادثات تنوشني","https://www.aldiwan.net/poem32284.html","الطويل"],[422,"نؤمل أن يطول بنا الثواء","https://www.aldiwan.net/poem54077.html","الوافر"],[438,"طلعت ربيعا من ربيع وأربع","https://www.aldiwan.net/poem12659.html","الطويل"],[463,"أعينوني على طلب المعالي","https://www.aldiwan.net/poem56066.html","الوافر"],[463,"إذا عم صحراء الغمير جدوبها","https://www.aldiwan.net/poem56293.html","الطويل"],[463,"سلا دار البخيلة بالجناب","https://www.aldiwan.net/poem56296.html","الوافر"],[469,"نعم نفحة الوادي التي تتأرج","https://www.aldiwan.net/poem3143.html","عموديه"],[580,"جلست ببستان الجليس وداره","https://www.aldiwan.net/poem2724.html","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48893","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48898","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48558","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202085","الطويل"],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/69217","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56280","الوافر"],[1862,"","https://poetry.dctabudhabi.ae/diwan/poem/199194","البسيط"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52072","الطويل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52029","البسيط"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124744","الطويل"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113798","الطويل"],[2163,"","https://poetry.dctabudhabi.ae/diwan/poem/124034","الطويل"],[2231,"","https://poetry.dctabudhabi.ae/diwan/poem/124058","الطويل"],[2234,"","https://poetry.dctabudhabi.ae/diwan/poem/111085","الطويل"],[2491,"","https://poetry.dctabudhabi.ae/diwan/poem/115065","الطويل"],[2577,"","https://poetry.dctabudhabi.ae/diwan/poem/80147","الوافر"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58533","الرجز"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109795","الطويل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112687","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89342","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62828","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62826","الوافر"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66528","السريع"],[3733,"","https://poetry.dctabudhabi.ae/diwan/poem/21387","الطويل"],[3793,"","https://poetry.dctabudhabi.ae/diwan/poem/124786","الرجز"],[3836,"","https://poetry.dctabudhabi.ae/diwan/poem/99229","الوافر"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102979","الطويل"],[4129,"","https://poetry.dctabudhabi.ae/diwan/poem/205347","المتقارب"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81734","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72499","الطويل"],[4680,"قيثارة الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=185069",""],[1012,"باب الكريم","https://www.poetsgate.com/ViewPoem.aspx?id=186322",""],[4862,"سقاه الدهر أتراحاً ووهنا","https://www.poetsgate.com/ViewPoem.aspx?id=55374",""],[4914,"بمن أتداوى والدوا معك وسدوا","https://www.poetsgate.com/ViewPoem.aspx?id=170940",""],[4971,"وقاسِحٍ كعَموُدِ الأَثْلِ يَحْفِزُه","https://www.poetsgate.com/ViewPoem.aspx?id=82628",""],[3271,"من نار السكينة","https://www.poetsgate.com/ViewPoem.aspx?id=128739",""],[5302,"صراع نفس","https://www.poetsgate.com/ViewPoem.aspx?id=202725",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[6019,"رقصةٌ بفتنةِ الإشتياق","https://www.poetsgate.com/ViewPoem.aspx?id=137042",""],[6093,"رامٍ رماني بسوءٍ ( المجتث)","https://www.poetsgate.com/ViewPoem.aspx?id=175999",""]],"verses":[["وَقاسَمتُماني أَن تُعينا عَلى النَوى","إِذا نَزواتُ البَينِ سارَ سُؤوَرُها",0,"ر",3,0],["وَقاسَموهُ بِها الأَموالَ إِذ قَدِموا","مُجاهِدينَ وَقَسمُ الجاحِدُ النارُ",1,"ر",1,0],["وقاسم الرأي من طلاَّع شامخةٍ","ومن مشير على الأغراض نزَّال",2,"ل",1,0],["وَقاسَمَها بِاللَهِ جَهداً لَأَنتُم","أَلَذُّ مِنَ السَلوى إِذا ما نَشورُها",3,"ر",3,0],["وقاسَمَني جودَ الأمير كأنَّما","له في القوافي السائراتِ نَصيبُ",4,"ب",1,0],["وَقاسَيتُ الحُروبَ أَنا اِبنُ سَبعٍ","فَلَّما شِبتُ أَفنَيتُ الرِجالا",5,"ل",2,0],["وقاسمتني الهوى حتى إذا رحلت","ألقت فؤادي بضنكٍ غير مقتسم",6,"م",1,0],["وقاسمُ الجودِ في عالٍ ومنخفضٍ","كقسمةِ الغيثِ بينَ النجمِ والشجرِ",7,"ر",1,0],["وَقاسَينَ لَيلاً دونَ بَيسانَ لَم يَكَد","سَنا صُبحِهِ لِلناذِرينَ يُنيرُ",8,"ر",1,0],["وقاسطي الشام والراضي حكومتهم","من أهل صفين والراضي على الأثر",9,"ر",1,0],["وقاسمها بُعدُ المدى في جسومها","فأفنى بها شطرا وابقى لها شطرا",10,"ر",2,0],["وَقاسَمْتُ فِي حَمْلِ الرّزِيَّة قَوْمَها","ولَيْسَ قَسيمُ البرِّ غَيْرَ المُقاسِمِ",11,"م",1,0],["وَقاسَمتُ العَذولَ عَلى هَواها","فَكانَ الرِّبحُ لي وَلَه الخَسارَه",12,"ر",2,0],["وَقاسيت ما لَو أَنَّ في الخَلق بَعضَهُ","لَأَلهاهُمُ خَلع العذار عَن العُذرِ",13,"ر",1,0],["وقاسَيْنَ عِشْراً إلى أن ورَدْنَ","صباحاً سَحائبَ كفَّيْهِ عَشرا",14,"ر",2,0],["وقاسَيْنَ ليلاً دونَ قاسانَ جُبْنَهُ","طويلاً على الآفاقِ قد زَرَّ بُرده",15,"د",2,0],["وَقاسَيتُ ما أَنكى عَدُوِّيَ مِنكُمُ","وَأَصعَبُ عِندي مِنهُ ما سَأُقاسي",16,"س",2,0],["وقاسَمَنِي قلبِي على الصّبرِ عنكُمُ","ولا عجبٌ إن بانَ بعدَكَ حنثُهُ",17,"ث",2,0],["وقاسم من زكا أصلاً وفرعاً","وما في طيب عنصره مِراء",18,"ا",2,0],["وقاسَمني في أن يقاسِمَني النّوى","رشا معهُ قلبي وأشواقُه مَعي",19,"ع",2,0],["وقاس بك الرجالَ فبنتَ فوتاً","وإن شوبهت في خَلْقِ الرجالِ",20,"ل",1,0],["وقاسٍ كأنَّ الجمرَ فلذةُ كبدهِ","يَرَى بالدماءِ نَحْلَةً يستذيبُها",21,"ب",3,0],["وقاسَمَني مُناصَفةً عليه","وجاحَدَني ليحبسه كتابي",22,"ب",2,0],["وقاسوا بك الأشباهُ جهلاً وضلَّةً","وغيرُ سواءٍ ياسمينٌ وعوسج",23,"ج",1,0],["وقاسيت مِنْكَ الغدرَ والهَجْرَ والقِلى","وأَنفقْتُ منك الشعر والعمر والدهرا",24,"ر",2,0],["وقاسيت في يومَي سقامك ما طوى","على الأرض أجيالاً وهد قرونا",25,"ن",2,0],["وقاسيت جهد الدفع والجذب فيهما","فلم تسترح حتى انقضى الدفع والجذب",26,"ب",1,0],["وقاسيت فيما رمت شر موانع","لها كل حرُّ النفس صار مقاسيا",27,"ي",2,0],["وقاسيت صعباً بَيْنَ حِلٍّ ورحْلةٍ","يَقَلِّبُ قَلبَ الصَّخْر أدْناهُ واهيا",28,"ي",2,0],["وَقاسَيتُ مِن بَلوى زَمان وَكُربَةٍ","وَودّعني مِن أَقرَبيّ حَميم",29,"م",1,0],["وقاسمها بسيف منه مُنضىٍ","بكفٍّ بالمكارم خير مقسمْ",30,"م",1,0],["وقاسم ثم عبد الله آخر ما","علمته وإلى شيبان منتسبي",31,"ب",2,0],["وَقَاسُوا عَلَى نَاسٍ ضِعَافٍ تَقَدَّمُوا","وَهَاتِيكَ أعوَامٌ مَضَتْ وَفُصُولُ",32,"ل",1,0],["وَقاَسَمُوهُ عَلَى وَجهِ الرّضَى قِسمَاً","يَدْرِي المُوفَّقُ فِيها مَنْ له الغَلَبُ",33,"ب",1,0],["وقاس أناسٌ نقص ذلك قيمةً","من العبد في أثمانه إذ ينزل",34,"ل",1,0],["وقاسى مَشَقّاتِ الطريقِ ولم يَزَل","يُسايرُها ما بينَ غَورٍ إلى نَجدِ",35,"د",1,0],["وقاسوا على أشبارهم طول باعه","فما قدروا ءالاء ذي المنح البرّ",36,"ر",1,0],["وقاست بفقد الشيخ وجد مصابة","بواحدها لما تولى شبابها",37,"ب",3,0],["وقاسيت ما قاسيت كي الف لاثماً","لأعتاب أبواب الرضا في خراسان",38,"ن",1,0],["وقاسمني دَهري بَنيَّ بشَطرِهِ","فلما تَوفَّى شَطرَهُ مال في شَطري",39,"ر",2,0],["وقاسمَ نِصْفَ إِمْرَتِهِ زُهَيْرا","ولمْ يَكُ دونَه في الأمرِ والي",40,"ل",2,0],["وقاسمٌ ثمَّ أَبو الفتح وَلي","وهو بِغيرِ قاسِمٍ لم يُعْزَلِ",41,"ل",1,0],["وقاسمت من اهوى فؤادي والهوى","فكان فوادي عندها والهوى عندي",42,"د",2,0],["وقاسمَ اللَه ثلاثاً مالهُ","ولم يخيب من جدى آماله",43,"ه",1,0],["وقاسيت العذاب بفكِّ خرسٍ","وموت بهائم الشغل الأليم",44,"م",1,0],["وقاسَ بني شَمْرٍ بآلِ مُحَرّقٍ","وغربلَ ألفاظَ الوَرى والمَعانيا",45,"ي",2,0],["وقاسَ بديعاتِ الأمورِ بنفسِهِ","إلى أنْ علاهُ الشّيبُ وهو وليدُ",46,"د",1,0],["وقاسم اللَّه صروف الردى","ما خطرت في الوشي غيد رداح",47,"ح",1,0],["وَقاسَيتُم غَرباً يَمُدُّ عِنانَهُ","كَغَربِ الفُراتِ جاشَ يَومَ جَنوبِ",48,"ب",1,0],["وقَاس بَعدُ طولَه وعَرضَه","وقال قد عرفته بالغُرضَه",49,"ه",1,0],["وقاسم كانت له ذخِيرَه","من تمرِه في قُرعةٍ صغيرَه",49,"ه",1,0],["وقاسمني صَدُوحُ البَانِ شَجْوِي","فأجريتُ الدموعَ لهُ وناحا",50,"ح",2,0],["وقاس بأقداح الخديعة أهلها","فليس بمكر ما يزاح به المكر",51,"ر",1,0],["وقاسي ليتّدع المسلمون","\"وأنكى ليهلك\" أهل اللئام",52,"م",1,0],["وقاسَ بالهمزةِ النقلَ ابنُ مسعدة","في باب ظن وفيه خالفَ القُدَما",53,"م",2,0],["وقاسمت الكرخ الرصافة بالهنا","ودجلة قد سالت بصفو تهانيها",54,"ي",3,0],["وقاسميني الهوى ما أمطرتْ مُزني","عشقاً وفاض الندى عذباً بقافيتي",55,"ت",2,0],["وقاسمهم بالله أني ناصح","فأنهى إلى أبهى مقام وأكرما",56,"م",2,0],["وقاسى من أحبته عناءً","ونال من الصحاب أذىً وطعنا",57,"ن",2,0],["وقاسمتني فيك السرور وفي الحشا","لهيب جوى من جره الجفن أرمد",58,"د",1,0],["وقاسِحٍ كعَموُدِ الأَثْلِ يَحْفِزُه","وِرْكا حِصانٍ وصُلْبٌ غيِرُ مَعْروقِ",59,"ق",1,1],["وقاسمتهُ كل زاد السكونِ","وكل الهوى حين صافيتهُ",60,"ت",2,0],["وقاسيت آلاما نفتني لبقعة","من التيه والتيه العظيم يلوع",61,"ع",1,0],["وقاس قياساً فاسداً لا يقيسه","من الناس إلاَّ فاسدُ الرأي والقصد",62,"د",1,0],["وقاس على ما قاله الشيخ في امرئ","جهول بأمر لا تبين دلائله",63,"ل",2,0],["وقاسميني كؤوسَ العشقِ ما برحتْ","في قعرها قطرةٌ للشَّوقِ نُسقيهِ",64,"ي",2,0],["وقاسموني رفاقي","بالله كيْما أحِلَّهْ",65,"ل",2,0]]}