07.html","مخلع البسيط"],[442,"إليك إليك يا ربي","https://www.aldiwan.net/poem14351.html","الهزج"],[442,"آها لها من غصة النادم","https://www.aldiwan.net/poem14479.html","السريع"],[442,"رضى بما قدر الباري وألزمنا","https://www.aldiwan.net/poem14486.html","البسيط"],[444,"أهي الجنة التي وعد الله","https://www.aldiwan.net/poem55987.html","عموديه"],[444,"قف بالديار وحيها","https://www.aldiwan.net/poem56021.html","عموديه"],[444,"دع عنك صهباء الدساكر","https://www.aldiwan.net/poem56047.html","عموديه"],[453,"وجني من القرنفل غض","https://www.aldiwan.net/poem13777.html","الخفيف"],[453,"وجني من القرنفل يبدي","https://www.aldiwan.net/poem13908.html","الخفيف"],[454,"قالوا تصبر قد يتوب الغادر","https://www.aldiwan.net/poem61766.html","الكامل"],[459,"تركتك يا زمان قلى فدعني","https://www.aldiwan.net/poem55826.html","الوافر"],[459,"ضنا بأن يعلم الناس الهوى لمن","https://www.aldiwan.net/poem55861.html","البسيط"],[459,"مالي ولم أسبِق إلى الغنمِ","https://www.aldiwan.net/poem55868.html","أحذ الكامل"],[459,"هل في الشموس التي تحدى بها العير","https://www.aldiwan.net/poem56166.html","البسيط"],[459,"لمن الظعن تهتدي وتجور","https://www.aldiwan.net/poem56178.html","الخفيف"],[459,"أبلغ بها أمنية الطالب","https://www.aldiwan.net/poem56275.html","السريع"],[462,"ولقد أكتم همي جازما","https://www.aldiwan.net/poem15665.html","الرمل"],[465,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[465,"باحت بنجد وهوى غزلانها","https://www.aldiwan.net/poem3273.html","عموديه"],[465,"درت أنها شمس الضحى فتجلت","https://www.aldiwan.net/poem3592.html","عموديه"],[469,"وشاعر من بني النجار","https://www.aldiwan.net/poem59999.html","مخلع البسيط"],[478,"أطل الوقوف على رسوم الدار","https://www.aldiwan.net/poem15238.html","الطويل"],[480,"رشقت فؤادي بالسهام","https://www.aldiwan.net/poem36920.html","مجزوء الكامل"],[480,"عاطني يا تونسي في نخبها","https://www.aldiwan.net/poem37603.html","الرمل"],[483,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[516,"مقامك من فضل وفصل خطاب","https://www.aldiwan.net/poem12011.html","الطويل"],[516,"دانت لأمرك طاعة الأقدار","https://www.aldiwan.net/poem12106.html","الكامل"],[518,"كأنما النار والرماد معاً","https://www.aldiwan.net/poem59842.html","المنسرح"],[542,"تولت رجالي بالغنائم والغنى","https://www.aldiwan.net/poem680.html",""],[552,"ما لك في ربة الغلائل","https://www.aldiwan.net/poem47285.html","الرجز"],[552,"أما ترى الرزء الذي أقبلا","https://www.aldiwan.net/poem47307.html","السريع"],[552,"أترى يؤوب لنا الأبي","https://www.aldiwan.net/poem47336.html","مجزوء الكامل"],[552,"هبت تلوم على الندى هند","https://www.aldiwan.net/poem47877.html","أحذ الكامل"],[559,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[559,"فيه أنا ميت ومقبور","https://www.aldiwan.net/poem34481.html","السريع"],[559,"دارنا هذه هي الأشجار","https://www.aldiwan.net/poem34537.html","الخفيف"],[559,"إن للإحسان نورا","https://www.aldiwan.net/poem34550.html","مجزوء الرمل"],[568,"أحبابنا بقلوبنا شطوا","https://www.aldiwan.net/poem69613.html","الكامل"],[576,"خانت جفوني لما لم تفض بدمي","https://www.aldiwan.net/poem2780.html","البسيط"],[576,"من فر منك فما يلام","https://www.aldiwan.net/poem3009.html","مجزوء الكامل"],[576,"وجنة فوقها عذار أطلا","https://www.aldiwan.net/poem3027.html","الخفيف"],[576,"قتلي لحبكم شهادة","https://www.aldiwan.net/poem3076.html","مجزوء الكامل"],[576,"أمورد يا ناظري أم وريد","https://www.aldiwan.net/poem3088.html","الرجز"],[577,"من مبلغ الشعراء عن أخويهم","https://www.aldiwan.net/poem1773.html","الكامل"]],"verses":[["وَجِنانٌ ماضٍ عَلى رَوعَةِ الخَط","بِ وَنَفسٌ كَثيرَةُ النَزَوانِ",0,"ن",1,0],["وَجَنَّت عَلَيهِ لَيلَةٌ عَقرَبِيَّةٌ","لَها سائِلٌ في كُلِّ وادٍ وَقاطِرُ",1,"ر",1,0],["وَجُنَّ مَوجاً وَطَغى عُبابا","قارَعَنا وَاِنتَزَعَ اللُبابا",2,"ب",2,0],["وَجَنَيْتَ غَضَّ الْفَتْحِ مِنْ وَرَقِ الظِّبَا","وَالنَّصْرَ مِنْ غَرْسِ الْقَنَا الْمُتَحَطِّمِ",3,"م",1,0],["وجُنْحُ اللّيلِ مَطْويُّ النّواحي","وضوْءُ الفَجْرِ منْشورُ البُنودِ",4,"د",1,0],["وَجُندُ كِسرى غَداةَ الحِنوِ صَبَّحَهُم","مِنّا كَتائِبُ تُزجي المَوتَ فَاِنصَرَفوا",5,"ف",3,0],["وَجَنِّبوني عَلى شُكرٍ مَوائِدَكُم","بِما حَوَت مِن أَفاويهٍ وَأَلوانِ",6,"ن",1,0],["وَجَنَّبَني أَن أَفعَلَ الخَيرَ والِدٌ","ضَئيلٌ إِذا ما عُدَّ أَهلُ المناسِبِ",7,"ب",1,1],["وَجَنَّةِ عَدنٍ تَطَّبيكَ وَكَوثَرِ","بِمَرأىً يَزيدُ العُمرَ طيباً وَيَنسَأُ",8,"س",2,0],["وَجَنابُكَ الثَبتُ الَّذي لا يَنثَني","وَحُسامُكَ الوَضبُ الَّذي لا يَكهَمُ",9,"م",1,0],["وجنّبوهمِ على فعل معاقَبةً","أن العقاب إذا كرّرته قتلا",10,"ل",2,0],["وجنّبته السيف الجُراز لأنه","تعالت عن الكلب العَقور مَضاربه",11,"ب",2,0],["وَجِنُّ الخافِقَينِ يَسِرنَ فيهِم","سِراعَ السَيرِ نازِحَةَ المَعادِ",12,"د",1,0],["وَجَناءُ تُرقِلُ بَعدَ طولِ هِبابِها","إِرقالَ جَأبٍ مُعلَمٍ بِكُدومِ",13,"م",1,0],["وَجَنِينَاً وَمُرضِعاً ساكِنَ المَه","دِ وبَعدَ الرِّضَاعِ عِندَ الفِطَامِ",14,"م",1,0],["وَجَناتُهُ تَجني عَلى عُشّاقِهِ","بِبَديعِ ما فيها مِنَ اللَألاءِ",15,"ا",2,0],["وجنيتُ من ثمر الذنوب تعمداً","لما رأيت العفو حظّ الجاني",16,"ن",2,0],["وجنان الخلود يفتح منها الل","ثم صدغاً يظلّ كالزرفين",17,"ن",1,0],["وجنَّة وردٍ تشكو النفوسُ لها لهفا","بياضُ م شمَّلها وقبَّلها ألفا",18,"ف",2,0],["وجنةٌ للغُنْجِ فيها عقربٌ","وبلاءُ الصب من عقربِها",19,"ب",3,0],["وَجُندٌ تَجودُ بِأَكبادِها","عَلى الأَرض وَالأَرضُ لا تَعَلمُ",20,"م",1,0],["وجَناحُ الفَجْرِ يومي","نَحْوَ رَبَّاتِ الجَناحِ",21,"ح",1,0],["وجناح لطائر صاده اللي","ل فأمسى يعالج الأشراكا",22,"ك",2,0],["وَجِنانُ الخُلدِ وَكَوثَرُهُ","وَكَفى الآباءُ رَياحينا",23,"ا",1,0],["وَجَنّاتٍ مِنَ الأَشعارِ فيها","جَنىً لِلمُجتَني مِن كُلِّ ذَوقِ",24,"ق",1,1],["وَجَناها جِنايَةً","لَيسَ فيها بِأَوَّلِ",25,"ل",1,0],["وَجُندِيُّ القَضِيَةِ مُنذُ قامَت","تَعَلَّمَ تَحتَ رايَتِها اللِقاءَ",26,"ا",2,0],["وَجَناحُ السِلمِ إِلّا أَنَّها","ساعَةَ الرَوعِ جَناحٌ مِن سَقَر",27,"ر",1,0],["وَجَناحٍ غَيرِ ذي قادِمَةٍ","كَجَناحِ النَحلِ مَصقولٍ سَواء",28,"ا",2,0],["وَجَنَّبَني قُربَ السَلاطينِ مَقتُها","وَما يَقتَضيني مِن جَماجِمِها النَسرُ",29,"ر",1,0],["وجنيتُ رمَّانَ النهودِ وإنَّها","لِمَنِ اجتناها صِحَّةٌ وسَقَامُ",30,"م",1,0],["وجنى على عُصَبِ النِفاق كما جَنَى","في الغابرينَ على ثَمُودَ قُدَارُ",31,"ر",1,0],["وجَنَّةٍ بالطِيبِ موصوفةٍ","مَوشِيَّةِ الأرجَاءِ منسوجَهْ",32,"ج",2,1],["وَجَنَّةُ خُلدٍ عَذَّبَتنا بِدَلِّها","وَما خِلتُ أَنّا بِالجِنانِ نُعَذَّبُ",33,"ب",1,0],["وَجَنى الوَردَ ثالِثٌ فَسَبيلي","شَمُّ وَردٍ تارَةً وَتَقبيلُ وَردِ",34,"د",1,0],["وَجُنَّ الهَوى فيها عَشِيَّةَ أَعرَضَت","بِناظِرَتَي ريمٍ وَسالِفَتَي خِشفِ",35,"ف",1,0],["وَجنَتُهُ حَمراءُ مَصقولَةٌ","وَجِسمُهُ مِن بَرَدٍ كُلُّهُ",36,"ل",2,0],["وجَنَّاتٌ يحيِّي الشَّربَ وَهناً","جَنَى وَهَدَاتِها وجَنَى ربُاها",37,"ا",3,0],["وجِنانٍ ذُلِّلَتْ أثمارُها","بينَ أمواهٍ نَميراتٍ وظِلّ",38,"ل",1,0],["وجَنَّتْ ثِمارُ الرَّنْدِ وَرْداً وطالما","تَصدَّعْنَ رَيَّاً في رِطابٍ مَوائِسِ",39,"س",1,0],["وجُندُبةٍ تمشي بساقٍ كأنَّه","على فَخِدٍ كالعُودِ منشارُ عرعرِ",40,"ر",1,1],["وَجَناتٌ تَحَيَّرَ الوَردُ فيها","وثُغورٌ جَرَتْ عليها العُقارُ",41,"ر",1,0],["وَجَنابُ الإِفسادِ مُرٌّ وَبيءٌ","وَجَنابُ الإِصلاحِ حُلوٌ مَريعُ",42,"ع",1,0],["وجنبني حب الكواعب أنني","أرى المرد إن ترع الوداد لها تشكر",43,"ر",1,1],["وَجِنحُ دُجُنَّةٍ فيهِ اِغتَبَقنا","وَواصَلنا الصَبوحَ بِيَومِ دَجنِ",44,"ن",1,1],["وَجَنَّةُ الحُسنِ في خَدَّيكَ موثَقَةَ","وَنارُ حُبِّكَ لا تُبقي وَلا تَذَرُ",45,"ر",1,0],["وجنون الأعمى إذا ما استجدى","وهو يعشو لناره كالمجوس",46,"س",1,0],["وجُنِنَّ من قلقي عَلي","ك وكيف لي أن أعقلا",47,"ل",2,0],["وجنيّةٍ ضَنّتْ على نظري","بِجنيّ وَرْدِ الوجنَةِ الخَضلِ",48,"ل",1,0],["وَجَنى لي فَإِنَّ قَلبي عَليلٌ","ما اشتهى من جَنِيِّ رُمّانِ صَدرك",49,"ك",1,0],["وجنتي وردٌ مربَى","والسنا عندي كثير",50,"ر",1,0],["وَجَنَيتُ رَوضاً في قِناعِكَ أَزهَرا","وَقَضيبَ بانٍ في وِشاحِكَ أَثمَرا",51,"ر",2,0],["وَجَنَوا ثِمارَ النَصرِ مِن غَرسِ القَنا","بِأَكُفِّهِم وَلَنِعمَ غَرسُ الغارِسِ",52,"س",1,0],["وَجُنداً لَهُ مِن صادِقِ البَأسِ مَعقِلٌ","يَخُرُّ لَهُ أَعلى المَعاقِلِ جاثِيا",53,"ي",2,0],["وَجُنودٍ رَمَيتُهُم بِحَريقٍ","يَتَلَظّى إِذا أَحَسَّ بِريحِ",54,"ح",1,1],["وَجُنَّت بِأَطلالِ الدُجَيلِ وَمائِهِ","وَكَم طَلَلٍ مِن خَلفِهِنَّ وَماءُ",55,"ا",2,0],["وَجَنَوْا عَلَى هارونَ بالعِجْلِ الّذي","نَسَبُوا لَهُ تَصْوِيرَهُ تَضْلِيلا",56,"ل",2,0],["وَجَنوبٌ وَشمالٌ جَعَلاَ","تُرْبَهُ فِي جَبهَةِ الدَّهْرِ غضوناً",57,"ن",2,0],["وَجِنُّ مَشارِفٍ بُعِثُوا شُهُوداً","فإنَّ مِنَ الوُثُوقِ بهِمْ جُنُونا",58,"ن",2,0],["وجنَيْتُمُ ثَمَرَ الوقائِعِ يانِعاً","بالنصر من وَرَق الحديدِ الأخضَر",59,"ر",1,0],["وَجَنَّةٍ لُقِّبَتِ المُنتَهى","ثُمَّ اِسمُها في العَجمِ جُلّارُ",60,"ر",1,0],["وَجناءُ تَكفي بِالسَيرِ راكِبَها","تَحريكَ سَوطٍ وَقَولَهُ حَيهِل",61,"ل",1,0],["وَجَنِيِّ وَردٍ يَستَبيكَ بِحُسنِهِ","مِثلَ الشُموسِ طَلَعنَ مِن أَغصانِ",62,"ن",1,0],["وَجِنانٌ قالَ الإِلَهُ لَها كو","ني فَكانَت روحاً وَرَوحاً وَراحا",63,"ح",2,0],["وَجُنَّ فُرَيخُ الزِنجِ بَل جُنَّتِ اِستُهُ","فَأَصبَحتُ دَلّاقاً لَهُ بِطَبيبِ",64,"ب",1,0],["وَجَنَّتُكَ الأُلى عَروسُكَ وافَقَت","رِضاكَ فَإِن أَجَنَتكَ فَاِجنِ ثِمارَها",65,"ر",3,0],["وجُنْحٍ يَمْلأ الفَوْدَينِ شَيْباً","ولكنْ يَجْعَلُ الصّحْرَاءَ خَالا",66,"ل",2,0],["وَجْنةٌ كالربيع جادَ عليها","من حياءٍ لا من حَياً وَسميُّ",67,"ي",1,1],["وجَنابٍ زُويَتْ من كُلّ فَجْ","جٍ لهُ قصداً رجال النُّجْبِ زَي",68,"ي",1,0],["وجناح الهزار ريش قليل","وجناحي فكري الَّذي لا يُجارى",69,"ر",2,0],["وجنَّاتِ نَخْلٍ واجماتٍ كواسفٍ","وأسرابِ طير في الفلاةِ شريدِ",70,"د",1,0],["وجنِّيَّاتُ بحرِ الرُّو","مِ أم دُنيا من السِّحرِ",71,"ر",1,0],["وجُنْدَ سُليمانٍ رأى السيْفُ حَوْلَها","فحاذَرَ نَمْلٌ دَبّ فيه مِنَ الحَطْم",72,"م",1,0],["وَجَنَّبَكَ العَيْشُ احْتِقَارٌ لِشَأْنِهِ","إِذَا مَا غَدَا فِيهِ العَفَافُ عَفَاءَ",73,"ا",2,0],["وَجنَةُ مَعشوقٍ رَأى عاشِقاً","فَاِصفَرَّ ثُمَّ اِحمَرَّ خَوفَ الرَقيب",74,"ب",1,0],["وجندٌ في شجاعتِهم حياةٌ","إذا جلَب الجنودُ بها الحِماما",75,"م",2,0],["وجَنَى خَدَّيْكِ قد زَهَّدَني","في حَديثِ الوَرْدِ يُزْهَى في الرُّبا",76,"ب",2,0],["وجنونٌ بالمُلْكِ يعصِفُ بالدن","يا لكي يملِكَ القُبورَ سعيدا",77,"د",2,0],["وجنودُكِ الأحرارُ تستبقُ الْخُطا","لتردَّ صفعتَها إلى غازيك",78,"ك",1,0],["وجنّدتَ من آرائِكَ الغرِ جحفلاً","طلائِعُه أغَنتْ عن البيضِ والدُّهْمِ",79,"م",1,0],["وجَنَانُ مِصْرَ عَلَى جَنَاحَيْ طَائرٍ","مِمَّا أَلَحَّ عليه مِنْ أَهْوال",80,"ل",1,0],["وجنِّبوا مصرَ أخطاءً لها سَلَفَتْ","فإنما خَطَأُ الماضي صَوَابُ غَدِ",81,"د",1,0],["وجنت يداه على علومٍ طالما","أجريت شرعتها وشدت جدارها",82,"ر",3,0],["وجنودكم رهنُ الكَرى","بين المخادع، والمقاصر؟",83,"ر",1,0],["وجنيت غصن الفتح من ورق الظبا","والنصر من غرس القنا المتحطم",84,"م",1,0],["وجنايةُ الحسنِ الغريرِ إذا رمى","فشريقُ دمعٍ، أو غريقُ دماءِ",85,"ا",2,0],["وجنةٌ تَنطف السرورَ عليها","مسحةُ الهادئ الغيورِ الأسيف",86,"ف",1,0],["وجُندُبةً طارحَتْ جُندُباً","وبُوماً زقا وسحيلاً ثغا",87,"ا",1,0],["وَجَنى لي، فإنّ قلبي عَليلٌ،","منا اشتهى من جَنِيِّ رمّان صدرك",88,"ك",1,0],["وجنّتُكَ الأولى عروسُك وافقَتْ","رِضاكَ، فإن أجنَتكَ فاجنِ ثمارَها",89,"ر",3,0],["وجنون أحلامي تثور عنيفة","حمراء بين معالم وقباب",90,"ب",1,0],["وجنّت مهاة الرّمل حتّى لغازلت","وجنّ حمام الأيك حتّى لشبّبا",91,"ب",2,0],["وَجَنى العز يانِعاً مِن غُصون","لِلمَعالي تَجل عَن ان تَمسا",92,"س",2,0],["وجناب الغوث الجليل عليه","طيلسان التعظيم والانتصار",93,"ر",1,0],["وجناح نجح نستعين بعزمه ال","عالي لدى السراء والضراء",94,"ا",2,0],["وجناحاهُ يَخفُقانِ ابتهاجاً","لخَيالٍ رأى به ما تَمَنَّى",95,"ن",2,0],["وَجناءَ لا يَسأَمُ الإيضاعَ راكِبُها","إِذا السَرابُ اِكتَساهُ الحَزنُ وَالقورُ",96,"ر",1,0],["وَجنَّبه دَوَاهِمَ كُلَّ دَاهٍ","وجنَّبَهُ المَذَّلَةَ والمَلاَمَا",97,"م",2,0],["وجنة عصفت ريحُ المنونِ بها","وظافر ظُفُر البلوى به نشبا",98,"ب",2,0],["وجندُه الحر ولتحي السراة لهم","وليحى مِن جمعنا مَن قال آمينا",99,"ن",2,0],["وَجَنَيتَ أَثمارَ العَوالي وَاِجتَنى","وَمِنَ الجَنا أَريٌ وَمِنهُ عَلقَمُ",100,"م",1,0],["وَجَنابٍ مُمَنَّعٍ يُنصَفُ المَظ","لومُ فيهِ وَيُنصَرُ المُستَضامُ",101,"م",1,0],["وجنة احسان وجنة مشهد","لطيف شريف لا يرى بعده بعد",102,"د",1,0],["وجنة أشواق وانة عاشق","تقدس بالتقوى افيض له الود",102,"د",1,0],["وَجَنّاتُ عَدنٍ قَد أَوَينا لِظِلِّها","وَعِزَّةُ دينٍ نَعتَلي بِمَحَلِّها",103,"ه",2,0],["وَجَنَيْتَ مِنْ شَجَرِ القِلى بِيَدِ الهَوى","مِمَّا غَرَسْتَ بِمُهجَتي ثَمَرَ الجَفا",104,"ف",2,0],["وَجُند