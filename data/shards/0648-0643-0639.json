{"poems":[[77,"نديمي عللني بمشمولة واسق","https://www.aldiwan.net/poem35920.html","الطويل"],[9,"ألم تنه نفسك عما بها","https://www.aldiwan.net/poem21912.html","المتقارب"],[93,"مجد الشآم أعدته فأعيدا","https://www.aldiwan.net/poem9162.html","الكامل"],[30,"أدارا بحزوى هجت للعين عبرة","https://www.aldiwan.net/poem29554.html","الطويل"],[51,"أطلع الله وجه شهرِك هذا","https://www.aldiwan.net/poem66377.html","الخفيف"],[45,"في غير شأنك بكرتي وأصيلي","https://www.aldiwan.net/poem65605.html","الكامل"],[97,"يا من طواها الليل في ظلمائه","https://www.aldiwan.net/poem24355.html","الكامل"],[97,"يا من طواها الليل في بيدائه","https://www.aldiwan.net/poem25096.html","الكامل"],[44,"من سجايا الطلول ألا تجيبا","https://www.aldiwan.net/poem30582.html","الخفيف"],[50,"يا خليلا نبا بنا في المشيب","https://www.aldiwan.net/poem64853.html","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54729","الكامل"],[106,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[45,"في غَيرِ شأْنكَ بُكْرَتِي وأصِيلي","https://www.poetsgate.com/ViewPoem.aspx?id=32124",""],[113,"حثثنا الركب اقلقه الضجيج","https://www.aldiwan.net/poem41189.html","عموديه"],[145,"أمسعود جاء السعد والخير واليسر","https://www.aldiwan.net/poem47624.html","الطويل"],[167,"أمارات سر الحب ما لا يكتم","https://www.aldiwan.net/poem1662.html",""],[247,"غشيت لليلى بشرق مقاما","https://www.aldiwan.net/poem2095.html","المتقارب"],[254,"يا بان بشر يا سيدي يا ابن بشر","https://www.aldiwan.net/poem48484.html","الخفيف"],[347,"سررت موهنا نحوي فأبدت مسرتي","https://www.aldiwan.net/poem15550.html","الطويل"],[513,"فرض على الشعر أن يبدا بما يجب","https://www.aldiwan.net/poem12013.html","البسيط"],[557,"شهدت حقيتي عظيم شاني","https://www.aldiwan.net/poem69263.html","الوافر"]],"verses":[["وكعْبَةِ روْضٍ زارَها القَطْرُ والتَقَتْ","بميقاتِها جوّابةُ الغَرْبِ والشّرْقِ",0,"ق",1,0],["وَكَعبَةُ نَجرانَ حَتمٌ عَلَي","كِ حَتّى تُناخي بِأَبوابِها",1,"ب",3,0],["وكعهدكم بذكائهم ومضائهم","رفعوا لهم في الخافقين بنودا",2,"د",2,0],["وَكَعبٌ وَعُرقوبٌ كِلا مَنجَمَيهِما","أَشَمُّ حَديدُ الأَنفِ عارٍ مُعَرَّقُ",3,"ق",1,0],["وكعَمْتَ اللسانَ عن كلِّ هُجْرٍ","وحميْتَ الضمير رجمَ الظُّنون",4,"ن",1,0],["وَكَعَمتَ شِدقَ الآكِلِ الذَأبِ الشَبا","حَتّى حَمَيتَ جُزارَةَ المَأكولِ",5,"ل",1,0],["وكعادةِ الحظِ الشقيّ وعادتي","أقلبتُ بعد ذهاب نجمي الأوحدِ",6,"د",1,0],["وكعادة الحظ الشقي وعادتي","أقبلت بعد ذهاب نجمي الأوحد",7,"د",1,0],["وَكِعاباً كَأَنَّما أَلبَسَتها","غَفَلاتُ الشَبابِ بُرداً قَشيبا",8,"ب",2,0],["وَكِعابٍ مِن آلِ سَعدِ بنِ بَكرٍ","رَعَمَتني جُفونُها في المَغيبِ",9,"ب",1,0],["وَكَعَهْدهِمْ بِذَكَائِهِمْ وَمَضَائِهِمْ","رَفَعُوا لَهُمْ فِي الخَافِقَيْنِ بُنُودا",10,"د",2,0],["وكَعابٍ يتيمةٍ ما درت لِلْ","يُتم معنى في غير درِّ العقود",11,"د",1,0],["وَكَعَمتَ شِدقَ الآكلِ الذَّرِبِ الشَّبَا","حَتّى حَمَيْتَ جُزَارَةَ المأكُولِ",12,"ل",1,0],["وكعبة رشده من كل فج","من الاقطاب طاف به الحجيج",13,"ج",1,0],["وكعبة حجّاج الجناب الذي سما","وجلّ فلا ركنٌ لديه ولا حجر",14,"ر",1,0],["وَكَعبَةُ بَيتِ اللَهِ تَعلَمُ أَنَّها","لَهُ وَكَذا البَيتُ المُقَدَّسُ يَعلَمُ",15,"م",1,0],["وَكَعباً فَسائِلهُمُ وَالرِبابَ","وَسائِل هَوازِنَ عَنّا إِذا ما",16,"م",2,0],["وكعابي التي يرضضها المش","ي من أحيلها ليت شعري",17,"ي",1,0],["وَكَعبَتُهُ ميمٌ بِنارِ بَياضِها اس","تَعَدَّت لِإِبصارِ الجَمالِ بَصيرَتي",18,"ي",1,0],["وكعبة الله لولا قدرها حجر","ومندل الهند لولا عرفه حطب",19,"ب",1,0],["وكَعْبَتُهُ بِفاسِ الشَّرْع هُدَّتْ","كحَلاَّجِ المحبةِ إِذْ تَبَدَّتْ",20,"ت",1,0]]}