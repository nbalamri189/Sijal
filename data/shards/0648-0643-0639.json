{"poems":[[102,"وحدة الشاعر","https://www.aldiwan.net/poem24839.html","عموديه"],[79,"نديمي عللني بمشمولة واسق","https://www.aldiwan.net/poem35920.html","الطويل"],[9,"ألم تنه نفسك عما بها","https://www.aldiwan.net/poem21912.html","المتقارب"],[95,"مجد الشآم أعدته فأعيدا","https://www.aldiwan.net/poem9162.html","الكامل"],[32,"أدارا بحزوى هجت للعين عبرة","https://www.aldiwan.net/poem29554.html","الطويل"],[53,"أطلع الله وجه شهرِك هذا","https://www.aldiwan.net/poem66377.html","الخفيف"],[47,"في غير شأنك بكرتي وأصيلي","https://www.aldiwan.net/poem65605.html","الكامل"],[99,"يا من طواها الليل في ظلمائه","https://www.aldiwan.net/poem24355.html","الكامل"],[99,"يا من طواها الليل في بيدائه","https://www.aldiwan.net/poem25096.html","الكامل"],[46,"من سجايا الطلول ألا تجيبا","https://www.aldiwan.net/poem30582.html","الخفيف"],[52,"يا خليلا نبا بنا في المشيب","https://www.aldiwan.net/poem64853.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54729","الكامل"],[108,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[47,"في غَيرِ شأْنكَ بُكْرَتِي وأصِيلي","https://www.poetsgate.com/ViewPoem.aspx?id=32124",""],[119,"حثثنا الركب اقلقه الضجيج","https://www.aldiwan.net/poem41189.html","عموديه"],[151,"أمسعود جاء السعد والخير واليسر","https://www.aldiwan.net/poem47624.html","الطويل"],[173,"أمارات سر الحب ما لا يكتم","https://www.aldiwan.net/poem1662.html",""],[254,"غشيت لليلى بشرق مقاما","https://www.aldiwan.net/poem2095.html","المتقارب"],[261,"يا بان بشر يا سيدي يا ابن بشر","https://www.aldiwan.net/poem48484.html","الخفيف"],[354,"سررت موهنا نحوي فأبدت مسرتي","https://www.aldiwan.net/poem15550.html","الطويل"],[520,"فرض على الشعر أن يبدا بما يجب","https://www.aldiwan.net/poem12013.html","البسيط"],[564,"شهدت حقيتي عظيم شاني","https://www.aldiwan.net/poem69263.html","الوافر"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86886","الرجز"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34429","الوافر"],[921,"","https://poetry.dctabudhabi.ae/diwan/poem/124065","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62550","الرجز"],[1012,"","https://poetry.dctabudhabi.ae/diwan/poem/132425","الطويل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35371","الطويل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35351","الخفيف"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102059","الوافر"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114029","المنسرح"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114777","الطويل"],[2208,"","https://poetry.dctabudhabi.ae/diwan/poem/95288","الرجز"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104979","البسيط"],[2380,"","https://poetry.dctabudhabi.ae/diwan/poem/29474","الطويل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121180","الطويل"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118824","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74233","الطويل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103407","الطويل"],[3083,"","https://poetry.dctabudhabi.ae/diwan/poem/137998",""],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132571","الطويل"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100190","الرجز"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48371","السريع"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138591",""],[3697,"","https://poetry.dctabudhabi.ae/diwan/poem/140263",""],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85199","الوافر"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103552","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77179","الطويل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127074","الوافر"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54353","الكامل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76706","البسيط"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76703","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139751",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139532",""],[4691,"أبراءة العينين قد سحرتك","https://www.poetsgate.com/ViewPoem.aspx?id=61731",""],[4691,"أمطرها وفاء","https://www.poetsgate.com/ViewPoem.aspx?id=105403",""],[5032,"كمان اللّيل","https://www.poetsgate.com/ViewPoem.aspx?id=191770",""],[5281,"مُقلةُ الحُسْنِ..رسولنا محمدٌ صلى الله عليه وسلَّم","https://www.poetsgate.com/ViewPoem.aspx?id=200143",""],[5385,"قوس المنون بسهم البين قدر رشقا","https://www.poetsgate.com/ViewPoem.aspx?id=144222",""],[5431,"نبضُ الإباء","https://www.poetsgate.com/ViewPoem.aspx?id=183029",""],[5544,"عمان اسعدي","https://www.poetsgate.com/ViewPoem.aspx?id=213441",""],[5937,"الأوركيديّة","https://www.poetsgate.com/ViewPoem.aspx?id=211800",""],[5939,"لستِ أنثى!","https://www.poetsgate.com/ViewPoem.aspx?id=185492",""],[5956,"شوق زوجين","https://www.poetsgate.com/ViewPoem.aspx?id=182441",""]],"verses":[["وكعيني طفلة ترنو إلى","مقلتي طفل كسول الناظر",0,"ر",1,0],["وكعْبَةِ روْضٍ زارَها القَطْرُ والتَقَتْ","بميقاتِها جوّابةُ الغَرْبِ والشّرْقِ",1,"ق",1,0],["وَكَعبَةُ نَجرانَ حَتمٌ عَلَي","كِ حَتّى تُناخي بِأَبوابِها",2,"ب",3,0],["وكعهدكم بذكائهم ومضائهم","رفعوا لهم في الخافقين بنودا",3,"د",2,0],["وَكَعبٌ وَعُرقوبٌ كِلا مَنجَمَيهِما","أَشَمُّ حَديدُ الأَنفِ عارٍ مُعَرَّقُ",4,"ق",1,0],["وكعَمْتَ اللسانَ عن كلِّ هُجْرٍ","وحميْتَ الضمير رجمَ الظُّنون",5,"ن",1,0],["وَكَعَمتَ شِدقَ الآكِلِ الذَأبِ الشَبا","حَتّى حَمَيتَ جُزارَةَ المَأكولِ",6,"ل",1,0],["وكعادةِ الحظِ الشقيّ وعادتي","أقلبتُ بعد ذهاب نجمي الأوحدِ",7,"د",1,0],["وكعادة الحظ الشقي وعادتي","أقبلت بعد ذهاب نجمي الأوحد",8,"د",1,0],["وَكِعاباً كَأَنَّما أَلبَسَتها","غَفَلاتُ الشَبابِ بُرداً قَشيبا",9,"ب",2,0],["وَكِعابٍ مِن آلِ سَعدِ بنِ بَكرٍ","رَعَمَتني جُفونُها في المَغيبِ",10,"ب",1,0],["وَكَعَهْدهِمْ بِذَكَائِهِمْ وَمَضَائِهِمْ","رَفَعُوا لَهُمْ فِي الخَافِقَيْنِ بُنُودا",11,"د",2,0],["وكَعابٍ يتيمةٍ ما درت لِلْ","يُتم معنى في غير درِّ العقود",12,"د",1,0],["وَكَعَمتَ شِدقَ الآكلِ الذَّرِبِ الشَّبَا","حَتّى حَمَيْتَ جُزَارَةَ المأكُولِ",13,"ل",1,0],["وكعبة رشده من كل فج","من الاقطاب طاف به الحجيج",14,"ج",1,0],["وكعبة حجّاج الجناب الذي سما","وجلّ فلا ركنٌ لديه ولا حجر",15,"ر",1,0],["وَكَعبَةُ بَيتِ اللَهِ تَعلَمُ أَنَّها","لَهُ وَكَذا البَيتُ المُقَدَّسُ يَعلَمُ",16,"م",1,0],["وَكَعباً فَسائِلهُمُ وَالرِبابَ","وَسائِل هَوازِنَ عَنّا إِذا ما",17,"م",2,0],["وكعابي التي يرضضها المش","ي من أحيلها ليت شعري",18,"ر",2,0],["وَكَعبَتُهُ ميمٌ بِنارِ بَياضِها اس","تَعَدَّت لِإِبصارِ الجَمالِ بَصيرَتي",19,"ي",1,0],["وكعبة الله لولا قدرها حجر","ومندل الهند لولا عرفه حطب",20,"ب",1,0],["وكَعْبَتُهُ بِفاسِ الشَّرْع هُدَّتْ","كحَلاَّجِ المحبةِ إِذْ تَبَدَّتْ",21,"ت",1,0],["وَكَعبة الهُدى وَكنز العافي","وَقُبلة الصَلاة للأَخيار",22,"ر",1,0],["وَكَعبَةُ مَكرُماتٍ قَد تَجَلّت","فَلَم يَرَ دونها الراجي حِجازا",23,"ز",2,0],["وكعبة أنس يمصَحُ الحزن عندها","ويمحى كما يمحى لدى الحجر الذنب",24,"ب",1,0],["وكعبة المعروف أنت والذي","يحجّها من كل فج للأنامْ",25,"م",1,0],["وكعبة حجي حيث وجهت وجهتي","ففي كل حال حولها جولاني",26,"ن",2,0],["وَكَعبَةِ مَجدٍ شادَها العِزُّ فَاِنبَرَت","تَطوفُ بِمَغناها أَماني الوَرى شَوطا",27,"ط",2,0],["وَكعابٌ تُصمي إِذا لاحَ مِنها","بَدرُ وَجهٍ مُسَتَّرٍ بِنِقابِ",28,"ب",1,0],["وكعبة قصدنا فالى معظم","ونوّه قدرها الرحمن قادر",29,"ر",1,0],["وكعبةً للعلوم شامخةً","لها تحُجّ النُّهى وَتَعتَمِر",30,"ر",1,0],["وكَعبٌ عقيدُ الجُود والحِلمِ وَالنُّهى","وذُو الحِكَم الغُرّ المُبَشّر بالنَّبي",31,"ب",2,0],["وكعبة من حَجَّها","يَفُوزُ فيها بِعُمَر",32,"ر",1,0],["وكعبة لحجيج العلم راحته","كالركن يفخر فيها كل مستلم",33,"م",1,0],["وكعبٌ فإني لابنها وحَليفُها","وناصِرُها حيثُ استمرَّ مَريرُها",34,"ر",3,0],["وكعب زهير اما عفو محمد","بنظم مديح لائذا متذللا",35,"ل",2,0],["وكعبةُ قصدِ الواصلين وحجرهم","وزمزمهم منه مناهلهم تجري",36,"ر",2,0],["وَكَعب علا كَعباً وَمرة قَد سَمَت","مروءته وَاذكر كِلاباً إِذا أَجدى",37,"د",2,0],["وكعب علا عن طالب المجد كعبه","فنال بأدنى السعي أعلى المراتب",38,"ب",1,0],["وكعبته حسن الحبيب ووجهه","إليه يصلي صبحه وأصائله",39,"ل",2,0],["وكعبتنا من شاهق العز في حمى","تحدر عنه كل من جاء مصعدا",40,"د",2,0],["وكعبة فضلها رب العلى","على بقاع الأرض فيما سلفا",41,"ف",2,0],["وكعبةُ الجودِ أنا اليومَ إذ","تقْصِدُ موْلَى الخلقِ أفْواجُها",42,"ج",3,0],["وَكَعَسى حَرَى وَلكِن جُعِلاَ","خَبَرُهَا حَتماً بِأَن مُتَّصِلاَ",43,"ل",2,0],["وكعبة فضلٍ لا تحد جهاته","غدا حجها من حج مكة أكبرا",44,"ر",2,0],["وكعبةً حجها الطلاب حين دروا","أن المقرر للإرشاد منهاج",45,"ج",1,0],["وكعبة وحدة بمقام جمع","أخال يديه في التقبيل مبنى",46,"ن",2,0],["وكعبة آمالٍ كثيراً حجيجها","لها حرمٌ فيه مشاعر للشعر",47,"ر",1,0],["وَكَعبُ هُوَ اِبنُ الأَشرَف القَرضي مِن","بِأَشعارِهِ وَصَف الخَراعِب أَسفَرا",48,"ر",2,0],["وكعبة ربنا لبست عليه","حدادا ضافيا طول السنينا",49,"ن",2,0],["وكعادة البيتِ المقدَّسِ يحزنُ ال","بيتُ الحرامُ عليه بلْ عرفاتُهُ",50,"ت",2,0],["وكعبة كانت الامال تعمرها","فاليوم لا عاكف فيها ولا باد",51,"د",1,0],["وكعبة للجمال طافت","من حولها أنفُس العباد",52,"د",1,0],["وكعبة مجدٍ أقفرت فالصفا بها","كدورة عيش والحجون شجون",53,"ن",1,0],["وكعبة المجد أقام ركنَها","كما بنى ربع العلوم الأرحبا",54,"ب",2,0],["وكعادة ِ العشاق ِ ودَّعتَ المنى","من بعدما نصفين قد شطرتك َ !",55,"ك",1,0],["وكعطر يداعب الكفَّ حتى","يصبحَ الكف َّ طيبا معطارا",56,"ر",2,0],["وكعادةِ المأساةِ تأخُذني إلى","سفَرٍ يطولُ كأنّهُ أزمانُ",57,"ن",1,0],["وكعادتي أبكي ويَغْتسلُ الدجى","بالدمعِ حتى تذْهبَ الأدْرانُ",57,"ن",1,0],["وَ(كَعْبُ) \"بَانَتْ سُعَادٌ\" عَنْهُ فَابْتَسَمَتْ","لَهُ السَّعَادَةُ إِذْ أَلْبَسْتَهُ.. فَسَمَا",58,"م",2,0],["وكعبة للندى من ام ساحتها","نال المنى من يمين جودها غدقا",59,"ق",2,0],["وكعاشقٍ والعشق فعل مروءةٍ","أهبُ الضعيفَ مظلّتي وردائي",60,"ا",3,0],["وكعب وبشير والخليل ابن أحمد","ومازن والصلت الذي ما نبا حدا",61,"د",2,0],["وكعبٍ تخلَّقَ مِن أغنياتٍ","ونَهدٍ تخلَّقَ مِن كِبرياءْ",62,"ا",2,0],["وكعادةٍ بدَّدْتِ آخرَ فرصةٍ","قد جازَ حدَّ الرَّتْقِ هذا المَزْعُ",63,"ع",1,0],["وكعائلٍ دفعَ الديونَ جميعَها","فَرَحي بلقيا حُبِّها وشبابِهِ",64,"ب",2,0]]}