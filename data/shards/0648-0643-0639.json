{"poems":[[77,"نديمي عللني بمشمولة واسق","https://www.aldiwan.net/poem35920.html","الطويل"],[9,"ألم تنه نفسك عما بها","https://www.aldiwan.net/poem21912.html","المتقارب"],[93,"مجد الشآم أعدته فأعيدا","https://www.aldiwan.net/poem9162.html","الكامل"],[30,"أدارا بحزوى هجت للعين عبرة","https://www.aldiwan.net/poem29554.html","الطويل"],[51,"أطلع الله وجه شهرِك هذا","https://www.aldiwan.net/poem66377.html","الخفيف"],[45,"في غير شأنك بكرتي وأصيلي","https://www.aldiwan.net/poem65605.html","الكامل"],[97,"يا من طواها الليل في ظلمائه","https://www.aldiwan.net/poem24355.html","الكامل"],[97,"يا من طواها الليل في بيدائه","https://www.aldiwan.net/poem25096.html","الكامل"],[44,"من سجايا الطلول ألا تجيبا","https://www.aldiwan.net/poem30582.html","الخفيف"],[50,"يا خليلا نبا بنا في المشيب","https://www.aldiwan.net/poem64853.html","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54729","الكامل"],[106,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[45,"في غَيرِ شأْنكَ بُكْرَتِي وأصِيلي","https://www.poetsgate.com/ViewPoem.aspx?id=32124",""]],"verses":[["وكعْبَةِ روْضٍ زارَها القَطْرُ والتَقَتْ","بميقاتِها جوّابةُ الغَرْبِ والشّرْقِ",0,"ق",1,0],["وَكَعبَةُ نَجرانَ حَتمٌ عَلَي","كِ حَتّى تُناخي بِأَبوابِها",1,"ب",3,0],["وكعهدكم بذكائهم ومضائهم","رفعوا لهم في الخافقين بنودا",2,"د",2,0],["وَكَعبٌ وَعُرقوبٌ كِلا مَنجَمَيهِما","أَشَمُّ حَديدُ الأَنفِ عارٍ مُعَرَّقُ",3,"ق",1,0],["وكعَمْتَ اللسانَ عن كلِّ هُجْرٍ","وحميْتَ الضمير رجمَ الظُّنون",4,"ن",1,0],["وَكَعَمتَ شِدقَ الآكِلِ الذَأبِ الشَبا","حَتّى حَمَيتَ جُزارَةَ المَأكولِ",5,"ل",1,0],["وكعادةِ الحظِ الشقيّ وعادتي","أقلبتُ بعد ذهاب نجمي الأوحدِ",6,"د",1,0],["وكعادة الحظ الشقي وعادتي","أقبلت بعد ذهاب نجمي الأوحد",7,"د",1,0],["وَكِعاباً كَأَنَّما أَلبَسَتها","غَفَلاتُ الشَبابِ بُرداً قَشيبا",8,"ب",2,0],["وَكِعابٍ مِن آلِ سَعدِ بنِ بَكرٍ","رَعَمَتني جُفونُها في المَغيبِ",9,"ب",1,0],["وَكَعَهْدهِمْ بِذَكَائِهِمْ وَمَضَائِهِمْ","رَفَعُوا لَهُمْ فِي الخَافِقَيْنِ بُنُودا",10,"د",2,0],["وكَعابٍ يتيمةٍ ما درت لِلْ","يُتم معنى في غير درِّ العقود",11,"د",1,0],["وَكَعَمتَ شِدقَ الآكلِ الذَّرِبِ الشَّبَا","حَتّى حَمَيْتَ جُزَارَةَ المأكُولِ",12,"ل",1,0]]}