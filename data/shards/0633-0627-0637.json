{"poems":[[55,"أمن شوق تعانقني الأماني","https://www.aldiwan.net/poem29668.html","الوافر"],[65,"وعاذلة والفجر في حجر أمه","https://www.aldiwan.net/poem45936.html","الطويل"],[65,"أنا ابن الأكرمين أبا وأما","https://www.aldiwan.net/poem45939.html","الطويل"],[65,"أسمراء عهدي بالخطوب قريب","https://www.aldiwan.net/poem46118.html","الطويل"],[65,"أماط والليل أثيث الجناح","https://www.aldiwan.net/poem46168.html","السريع"],[90,"نكب الشارع الكبير ببغداد","https://www.aldiwan.net/poem44426.html","الخفيف"],[93,"لا تقلقي يوم النوى أو فاقلقي","https://www.aldiwan.net/poem8985.html","عموديه"],[45,"أقل فعالي بله أكثره مجد","https://www.aldiwan.net/poem9542.html","الطويل"],[68,"وليلة في طول يوم العرض","https://www.aldiwan.net/poem40689.html","الرجز"],[83,"حوى الحب خمسا بهجة نكهة لما","https://www.aldiwan.net/poem61311.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85594","المجتث"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54251","الخفيف"],[93,"ضرة جلق","https://www.poetsgate.com/ViewPoem.aspx?id=53143",""],[132,"ألا قل لذى حمق تسربل بالغدر","https://www.aldiwan.net/poem50593.html","الطويل"],[136,"رقاب العقل إن لنا ولوعا","https://www.aldiwan.net/poem54805.html","الوافر"],[146,"حرام على طروق الديار","https://www.aldiwan.net/poem58444.html","المتقارب"],[159,"لجنون الهوى وهبت جناني","https://www.aldiwan.net/poem55511.html","الطويل"],[164,"أتاها رسولي فاسمعوا ما جرا له","https://www.aldiwan.net/poem58988.html","الطويل"],[199,"لمن الدار مثل خط الكتاب","https://www.aldiwan.net/poem54424.html","الخفيف"],[234,"خليلي قد ولى الظلام وهملجا","https://www.aldiwan.net/poem51194.html","الطويل"],[276,"أهاب سحيرا بالفراق مهيب","https://www.aldiwan.net/poem52070.html","الطويل"],[347,"مرقص ضاحك يحف به البشر","https://www.aldiwan.net/poem55323.html","الخفيف"],[412,"سأطلب العلاء بكل ليث","https://www.aldiwan.net/poem50180.html","الوافر"],[422,"أدار الكأس صافية المدام","https://www.aldiwan.net/poem53947.html","الكامل"],[422,"سقاك الحيا من أربع وطلول","https://www.aldiwan.net/poem54049.html","الطويل"],[443,"أشفيت حر جوى ودمعك يهمل","https://www.aldiwan.net/poem2502.html","الكامل"],[447,"حرائق حزن في فؤادي تجدد","https://www.aldiwan.net/poem14448.html","الطويل"],[463,"أتمنى والمنى جهد المقل","https://www.aldiwan.net/poem55996.html","الرمل"],[470,"في رحاب الحسين","https://www.aldiwan.net/poem59034.html","عموديه"],[475,"سأطلب بالشام الوليد فإنه","https://www.aldiwan.net/poem4730.html","الطويل"],[482,"أرى العيش بعد المالكية لا يحلو","https://www.aldiwan.net/poem15218.html","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63879","الهزج"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64720","الوافر"],[1624,"","https://poetry.dctabudhabi.ae/diwan/poem/45386","الوافر"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108549","الطويل"],[2019,"","https://poetry.dctabudhabi.ae/diwan/poem/177966","الطويل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71078","الطويل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106996","الرجز"],[2600,"","https://poetry.dctabudhabi.ae/diwan/poem/145207","الكامل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65969","الطويل"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127365","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201963","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201658","السريع"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100867","الوافر"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100754","الطويل"],[3243,"","https://poetry.dctabudhabi.ae/diwan/poem/140233",""],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48353","الطويل"],[3546,"","https://poetry.dctabudhabi.ae/diwan/poem/103381","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45760","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45786","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129493","الطويل"],[3637,"","https://poetry.dctabudhabi.ae/diwan/poem/106761","الطويل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132121","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59484","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135160","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107493","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54416","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136714",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120519","الطويل"],[4691,"يا من أراك ولا أراك","https://www.poetsgate.com/ViewPoem.aspx?id=157419",""],[4691,"إ إهداء لشاعر إرتريا عبدالرحمن سكاب \"هداء لناسك \"","https://www.poetsgate.com/ViewPoem.aspx?id=158296",""],[4929,"رمال الثلج","https://www.poetsgate.com/ViewPoem.aspx?id=199317",""],[4929,"وضيفة الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=199553",""],[3271,"راهب الغرب","https://www.poetsgate.com/ViewPoem.aspx?id=103195",""],[5121,"نشوة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=33517",""],[5136,"بأبي روضة من الحسن من بعض","https://www.poetsgate.com/ViewPoem.aspx?id=121578",""],[5213,"يا آل دارم لا أصلا ولا حسباً","https://www.poetsgate.com/ViewPoem.aspx?id=170415",""],[2365,"ظربت وشاقتك البروق اللوامع","https://www.poetsgate.com/ViewPoem.aspx?id=200652",""],[5225,"مدارات","https://www.poetsgate.com/ViewPoem.aspx?id=36080",""],[5271,"المتناثرة","https://www.poetsgate.com/ViewPoem.aspx?id=123674",""],[5387,"أنا والليل","https://www.poetsgate.com/ViewPoem.aspx?id=53149",""],[5431,"ساطع الحب قلبه لاانحدارُ","https://www.poetsgate.com/ViewPoem.aspx?id=198197",""],[5431,"وما أحلى الرجوع إلى الطحينِ...","https://www.poetsgate.com/ViewPoem.aspx?id=199868",""],[5431,"غمامٌ حاتميٌ ...","https://www.poetsgate.com/ViewPoem.aspx?id=214181",""],[5558,"سأَصنعُ أَجنحةً وأَطيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=211842",""],[5587,"هيا نتسامح","https://www.poetsgate.com/ViewPoem.aspx?id=194341",""],[5587,"أنت الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=202780",""],[5668,"لم أعشق سواه","https://www.poetsgate.com/ViewPoem.aspx?id=179114",""],[5674,"نبضتي متوقده","https://www.poetsgate.com/ViewPoem.aspx?id=198686",""],[5703,"ليلة شوق","https://www.poetsgate.com/ViewPoem.aspx?id=206151",""],[5848,"ست الكل","https://www.poetsgate.com/ViewPoem.aspx?id=53093",""],[6043,"نبتة المولى","https://www.poetsgate.com/ViewPoem.aspx?id=207718",""],[6093,"ألم تَرَ أن قلبيَ لا يتوبُ ( الوافر )","https://www.poetsgate.com/ViewPoem.aspx?id=176027",""],[6125,"أحلِّقُ في الدُّجى وحدي","https://www.poetsgate.com/ViewPoem.aspx?id=212879",""],[6239,"الشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75970&r=&rc=21",""],[6259,"سأطلَّبُ العلاءَ بكل ليث","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59416&r=&rc=64",""],[6277,"سأفتح حانة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64456&r=&rc=19",""],[5567,"حوادم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69069&r=&rc=7",""]],"verses":[["سَأُطلِعُ مِن ثَنايا الدَهرِ عَزماً","يَسيلُ بِهِمَّةِ الحَربِ العَوانِ",0,"ن",1,0],["سَأَطْلُبُها وَالنَّقْعُ يَضْفُو رِداؤُهُ","وَجُرْدُ المَذاكي في الدِّماءِ تَعومُ",1,"م",1,0],["سَأَطْلُبُ رُتْبَةً شَمّاءَ حَتّى","يَمُدَّ بِها عَلَيِّ العِزُّ ظِلَّهْ",2,"ل",2,0],["سأَطْلُبُ عِزَّ الدَّهْرِ ما دامَ ضافِياً","عَلَيَّ رِداءٌ لِلشَّبابِ قَشِيبُ",3,"ب",1,0],["سأطْلُبُ العِزَّ ولوْ رَفْرَفَتْ","على حَواشيهِ عَوالي الرِّماحْ",4,"ح",1,0],["ساطعاً يملأ الفضا مستطيراً","حاملاً في ذرّاته الأقذرارا",5,"ر",2,0],["سَأَطيرُ عَنها في غَدٍ بِحَشاشَةٍ","مَكلومَةٍ وَبِناظِرٍ مُغرَورِقِ",6,"ق",1,0],["سَأَطلُبُ حَقّي بِالقَنا وَمَشايِخٍ","كَأَنَّهُمُ مِن طولِ ما اِلتَثَموا مُردُ",7,"د",1,0],["ساطِعَةً كَالبَرقِ عِندَ الوَمضِ","حَتّى إِذا آنَ أَداءُ الفَرضِ",8,"ض",1,0],["سَأطلُبُ خَمساً طَاعَةً مِنهُ والرّضا","ووِدَّا وعَطفاً ثُمَّ وصلاً مُسَلَّمَا",9,"م",2,0],["سأطلب النيل حتى","أبل منه لهاتي",10,"ي",1,0],["ساطعاتُ الشمُوس فيه مَشاعِيلُ","وأَضْواؤُهُ بناتُ الهِلال",11,"ل",1,0],["سأطير عنها في غد بحشاشة","مكلومة ، ويناظر مغرورق",12,"ق",1,0],["سأطلق أَمْراسى عليه سوابقاً","تفتتُ منه أَعْظُمَ الظهرِ والصدرِ",13,"ر",1,0],["سَأَطوي البِيدَ قَاصِدَهَا بِوَهمٍ","يَبُذٌّ الصَّعلَ عَدواً حِينَ رِيعَا",14,"ع",2,0],["سأطوِى على لَهبٍ غُلَّتى","إلى أن يُعطَّلَ ذاك القَليبُ",15,"ب",1,0],["سَأُطِيلُ السُّجُودَ في قِبْلَةِ الكأْ","سِ بِتَسْبِيحِ أَلْسُنِ العِيدانِ",16,"ن",1,0],["سأطلب ثارى من زماني بأحمد","من كان ذا ثأر كثأري سعى له",17,"ل",2,0],["ساطِعٍ يَصطَنِعنَ مِنهُ ذُيولاً","كَمُلاءِ العِراقِ ذي الهَدّابِ",18,"ب",1,0],["سأطلب حقّي إن قضى اللهُ لي به","وأفتح منه كلَّ ما كان مُرْتَجا",19,"ج",2,0],["سأطلب منك الصفح حَتّى يَكون لي","لديك منالصفح الجَميل نصيب",20,"ب",1,0],["ساطعات في النور تغري اناساً","فقدوا في الهوى نهاهم وساحوا",21,"ح",3,0],["سَأَطَّلب العلاء بِكُلِّ لَيثٍ","لَهُ رأس بِذِكرِ اللَهِ وَحدَهُ",22,"د",2,1],["سأُطْرِبُ في مديحك كلَّ واعٍ","ولا طربَ الشجيّ المستهام",23,"م",1,0],["سأَطلبُ أسباب العُلى ولوَ انَّها","بأَنياب آسادٍ ربضنَ بغيل",24,"ل",1,0],["سأطيع داعية الغرام بربعها","كلفا وأعصي من يلوم ويعذل",25,"ل",1,0],["سأطلب فيه الأجر والصبر بعده","هو الفرط المدحور تبديه لي غد",26,"د",1,0],["ساط شهداً لِيَ في حنظلةٍ","لستَ حُلواً إنما خمرُك خَلّْ",27,"ل",1,0],["سأطبَعُ ثَغري على مَوطِئَيك","سلامٌ لأرضِكَ من مَلْثَمِ !",28,"م",1,0],["سأَطلُبُ بِالشامِ الوَليدَ فَإِنَّهُ","هُوَ البَحرُ ذو التَيّارِ لا يَتَغَضغَضُ",29,"ض",1,1],["سأطلبُها بالعيسِ تَنتهِبُ الفلا","سِراعاً إذا ما هابتِ المهمةَ الاِبْلُ",30,"ل",1,0],["سأطْريكَ بأشعارٍ","تَهيجُ الذكرَ للناس",31,"س",1,0],["سأَطَّرِحُ الملامَ على هواهُ","وأطْرَحُ فيهِ نفسي كلَّ مَطْرَحْ",32,"ح",1,0],["سَأَطلُبُ لا بِأَلسِنَةِ اليَراعِ","سِوى ذا الحَظِّ مِن أَيدي الزِماعِ",33,"ع",1,1],["سأُطوَى على دين المسيح ابن مريمٍ","وأبدو وفي هام الموالاة رايتي",34,"ي",1,0],["سأطفي حرارات الفؤاد من الهوى","بغير التقاء حين تسنو لواهبهُ",35,"ب",2,1],["سأطْلُبُها إِمّا بأَرضيَ قاطِناً","وإِمّا طريداً في البلاد غريبا",36,"ب",2,0],["سأطرق الحيين موهنا على","ذامله تلف بالسهل الجبل",37,"ل",1,0],["سأطير شوقاً نحوه فلقد بدت","للشوق في أحشائي الحركات",38,"ت",1,0],["سأطلبهم حتى أرى الكل منهم","يلوذ بنا من خوفنا حيثما ألفي",39,"ف",2,0],["ساطعا كالشمس يهدي","ها إلى خير مصير",40,"ر",1,0],["سأطبع شعريَ قبل الممات","ومن قبل أن يُفقدَ الفاهم",41,"م",1,0],["سأطبع الواصل من تيّاره","وأدفن الباقيَ في المستقبل",42,"ل",1,0],["سأطريه متى عزّت بلادي","وقد رُزقت كما رُزق الكمالا",43,"ل",2,0],["سأطريك بالشعر الذي أنت أهله","وأسدى اليك الشكر وهو جزيل",44,"ل",1,0],["سأطلق مقولي ليزيح عني","من الأحزان شيئا أو يقارب",45,"ب",1,0],["سأطْمَعُ في وصْلٍ وإنْ طالَ هجْرُها","وأقْطَعُ دهْري في عَسى ولعلّما",46,"م",2,0],["سأطردُ عنّي النوم كي لا أَراكم","إذا ما أَتاني النَّومُ والنَّاسُ نُوَّمُ",47,"م",1,0],["سَأطلع في أُفق البَلاغة أَنجُماً","إِلَيهِ بِها سَيّارة الحَمد تَهتَدي",48,"د",2,0],["سَأَطوي بِوَخد البُزَّل البيد في الدُجى","وَأَقطَع مِن تلك الفَراسخ أَذرُعا",49,"ع",2,0],["سأطلق ما إن عشت في شكر وصفه","بدايع نظم من أياديه تحبس",50,"س",1,0],["سأطلُبُ بُعد الدَّارِ عنكُم لتقرُبُوا","وتسكُبُ عينايَ المودعَ لِتَجمُدَا",51,"د",2,0],["سأطل منك على خرائب أم على","وجهٍ أغر من الصباح ضحوكِ",52,"ك",1,0],["ساطٍ يجري في البُعدِ كما","يجري في القرب ولم يحلِ",53,"ل",1,0],["سأطلب في حوائج للكريم","له متوسلاً باسم العظيم",54,"م",1,1],["سأطرحها جميعاً للهي","ب وليس لي أرب",55,"ب",1,0],["سأطرق أرماس الجدود مناجياً","اعاظمَ أبقى منهم الدهر أعظما",56,"م",2,0],["سأَطلبُ ربّي في ورودِ بحاركم","وأَهجرُ قوماً أَظمأتني بروضُها",57,"ض",3,0],["سأطوي البيدَ نحو عُلاك كيما","يبيتَ الجفنُ وهو بكم قريرُ",58,"ر",1,0],["ساطلب آثار العدو مقاتلا","بمن هوا باق من كماتى وابطالى",59,"ل",2,0],["سأطير طيرَ محبّةٍ","لأعود نجمًا في سماكْ",60,"ك",1,0],["ساطعٌ في ظلامِ تلك الليالي","يُرسلُ الضَّوْءَ شاديًا صدَّاحا",61,"ح",2,0],["سأُطلِقُ في الخليلِ شراعَ سُفْنِي","تُماخرُ موجَهُ دونَ انعطافِ",62,"ف",1,0],["سَأُطْلِقُ شِعْرِيْ على كُلِّ من","أَحَالَ بلادِيْ بُكًًا وعَوِيْلا",63,"ل",2,0],["سَأُطْلِقُ حَرْفِيَ في نحْرِهِمْ","رَصَاصًا وشِعْرِيَ َسِيْفًًا صَقِيْلَا",63,"ل",2,0],["ساطيًا في الخفاء آنا وآنا","يخْتلُ الناس لا يُبالي جهارا",64,"ر",2,0],["سَاطِعٌ وَالْنُّورُ مِنْ ذَاكَ الْمُحَيَّا","ألْهَبَ الْوِجْدَانَ فِي لَيْلٍ كَحَيِلِ",65,"ل",1