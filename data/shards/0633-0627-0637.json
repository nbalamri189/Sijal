{"poems":[[53,"أمن شوق تعانقني الأماني","https://www.aldiwan.net/poem29668.html","الوافر"],[63,"وعاذلة والفجر في حجر أمه","https://www.aldiwan.net/poem45936.html","الطويل"],[63,"أنا ابن الأكرمين أبا وأما","https://www.aldiwan.net/poem45939.html","الطويل"],[63,"أسمراء عهدي بالخطوب قريب","https://www.aldiwan.net/poem46118.html","الطويل"],[63,"أماط والليل أثيث الجناح","https://www.aldiwan.net/poem46168.html","السريع"],[88,"نكب الشارع الكبير ببغداد","https://www.aldiwan.net/poem44426.html","الخفيف"],[91,"لا تقلقي يوم النوى أو فاقلقي","https://www.aldiwan.net/poem8985.html","عموديه"],[43,"أقل فعالي بله أكثره مجد","https://www.aldiwan.net/poem9542.html","الطويل"],[66,"وليلة في طول يوم العرض","https://www.aldiwan.net/poem40689.html","الرجز"],[81,"حوى الحب خمسا بهجة نكهة لما","https://www.aldiwan.net/poem61311.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85594","المجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54251","الخفيف"],[91,"ضرة جلق","https://www.poetsgate.com/ViewPoem.aspx?id=53143",""],[129,"ألا قل لذى حمق تسربل بالغدر","https://www.aldiwan.net/poem50593.html","الطويل"],[133,"رقاب العقل إن لنا ولوعا","https://www.aldiwan.net/poem54805.html","الوافر"],[143,"حرام على طروق الديار","https://www.aldiwan.net/poem58444.html","المتقارب"],[156,"لجنون الهوى وهبت جناني","https://www.aldiwan.net/poem55511.html","الطويل"],[161,"أتاها رسولي فاسمعوا ما جرا له","https://www.aldiwan.net/poem58988.html","الطويل"],[196,"لمن الدار مثل خط الكتاب","https://www.aldiwan.net/poem54424.html","الخفيف"],[230,"خليلي قد ولى الظلام وهملجا","https://www.aldiwan.net/poem51194.html","الطويل"],[272,"أهاب سحيرا بالفراق مهيب","https://www.aldiwan.net/poem52070.html","الطويل"],[343,"مرقص ضاحك يحف به البشر","https://www.aldiwan.net/poem55323.html","الخفيف"],[407,"سأطلب العلاء بكل ليث","https://www.aldiwan.net/poem50180.html","الوافر"],[417,"أدار الكأس صافية المدام","https://www.aldiwan.net/poem53947.html","الكامل"],[417,"سقاك الحيا من أربع وطلول","https://www.aldiwan.net/poem54049.html","الطويل"],[438,"أشفيت حر جوى ودمعك يهمل","https://www.aldiwan.net/poem2502.html","الكامل"],[442,"حرائق حزن في فؤادي تجدد","https://www.aldiwan.net/poem14448.html","الطويل"],[459,"أتمنى والمنى جهد المقل","https://www.aldiwan.net/poem55996.html","الرمل"],[466,"في رحاب الحسين","https://www.aldiwan.net/poem59034.html","عموديه"],[471,"سأطلب بالشام الوليد فإنه","https://www.aldiwan.net/poem4730.html","الطويل"],[478,"أرى العيش بعد المالكية لا يحلو","https://www.aldiwan.net/poem15218.html","الطويل"]],"verses":[["سَأُطلِعُ مِن ثَنايا الدَهرِ عَزماً","يَسيلُ بِهِمَّةِ الحَربِ العَوانِ",0,"ن",1,0],["سَأَطْلُبُها وَالنَّقْعُ يَضْفُو رِداؤُهُ","وَجُرْدُ المَذاكي في الدِّماءِ تَعومُ",1,"م",1,0],["سَأَطْلُبُ رُتْبَةً شَمّاءَ حَتّى","يَمُدَّ بِها عَلَيِّ العِزُّ ظِلَّهْ",2,"ل",2,0],["سأَطْلُبُ عِزَّ الدَّهْرِ ما دامَ ضافِياً","عَلَيَّ رِداءٌ لِلشَّبابِ قَشِيبُ",3,"ب",1,0],["سأطْلُبُ العِزَّ ولوْ رَفْرَفَتْ","على حَواشيهِ عَوالي الرِّماحْ",4,"ح",1,0],["ساطعاً يملأ الفضا مستطيراً","حاملاً في ذرّاته الأقذرارا",5,"ر",2,0],["سَأَطيرُ عَنها في غَدٍ بِحَشاشَةٍ","مَكلومَةٍ وَبِناظِرٍ مُغرَورِقِ",6,"ق",1,0],["سَأَطلُبُ حَقّي بِالقَنا وَمَشايِخٍ","كَأَنَّهُمُ مِن طولِ ما اِلتَثَموا مُردُ",7,"د",1,0],["ساطِعَةً كَالبَرقِ عِندَ الوَمضِ","حَتّى إِذا آنَ أَداءُ الفَرضِ",8,"ض",1,0],["سَأطلُبُ خَمساً طَاعَةً مِنهُ والرّضا","ووِدَّا وعَطفاً ثُمَّ وصلاً مُسَلَّمَا",9,"م",2,0],["سأطلب النيل حتى","أبل منه لهاتي",10,"ي",1,0],["ساطعاتُ الشمُوس فيه مَشاعِيلُ","وأَضْواؤُهُ بناتُ الهِلال",11,"ل",1,0],["سأطير عنها في غد بحشاشة","مكلومة ، ويناظر مغرورق",12,"ق",1,0],["سأطلق أَمْراسى عليه سوابقاً","تفتتُ منه أَعْظُمَ الظهرِ والصدرِ",13,"ر",1,0],["سَأَطوي البِيدَ قَاصِدَهَا بِوَهمٍ","يَبُذٌّ الصَّعلَ عَدواً حِينَ رِيعَا",14,"ع",2,0],["سأطوِى على لَهبٍ غُلَّتى","إلى أن يُعطَّلَ ذاك القَليبُ",15,"ب",1,0],["سَأُطِيلُ السُّجُودَ في قِبْلَةِ الكأْ","سِ بِتَسْبِيحِ أَلْسُنِ العِيدانِ",16,"ن",1,0],["سأطلب ثارى من زماني بأحمد","من كان ذا ثأر كثأري سعى له",17,"ل",2,0],["ساطِعٍ يَصطَنِعنَ مِنهُ ذُيولاً","كَمُلاءِ العِراقِ ذي الهَدّابِ",18,"ب",1,0],["سأطلب حقّي إن قضى اللهُ لي به","وأفتح منه كلَّ ما كان مُرْتَجا",19,"ج",2,0],["سأطلب منك الصفح حَتّى يَكون لي","لديك منالصفح الجَميل نصيب",20,"ب",1,0],["ساطعات في النور تغري اناساً","فقدوا في الهوى نهاهم وساحوا",21,"ح",3,0],["سَأَطَّلب العلاء بِكُلِّ لَيثٍ","لَهُ رأس بِذِكرِ اللَهِ وَحدَهُ",22,"د",2,1],["سأُطْرِبُ في مديحك كلَّ واعٍ","ولا طربَ الشجيّ المستهام",23,"م",1,0],["سأَطلبُ أسباب العُلى ولوَ انَّها","بأَنياب آسادٍ ربضنَ بغيل",24,"ل",1,0],["سأطيع داعية الغرام بربعها","كلفا وأعصي من يلوم ويعذل",25,"ل",1,0],["سأطلب فيه الأجر والصبر بعده","هو الفرط المدحور تبديه لي غد",26,"د",1,0],["ساط شهداً لِيَ في حنظلةٍ","لستَ حُلواً إنما خمرُك خَلّْ",27,"ل",1,0],["سأطبَعُ ثَغري على مَوطِئَيك","سلامٌ لأرضِكَ من مَلْثَمِ !",28,"م",1,0],["سأَطلُبُ بِالشامِ الوَليدَ فَإِنَّهُ","هُوَ البَحرُ ذو التَيّارِ لا يَتَغَضغَضُ",29,"ض",1,1],["سأطلبُها بالعيسِ تَنتهِبُ الفلا","سِراعاً إذا ما هابتِ المهمةَ الاِبْلُ",30,"ل",1,0]]}