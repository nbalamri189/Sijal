{"poems":[[36,"ألا ليت أيام مضين تعود","https://www.aldiwan.net/poem4881.html","الطويل"],[75,"لئن قصر اليأس منك الأمل","https://www.aldiwan.net/poem11853.html","المتقارب"],[53,"اردد علي قراطيسي ممزقة","https://www.aldiwan.net/poem9238.html","البسيط"],[53,"أستغفر الله من ذنبي ومن خطئي","https://www.aldiwan.net/poem66417.html","البسيط"],[72,"أبى الله إلا أن تسود وتفضلا","https://www.aldiwan.net/poem42765.html","الطويل"],[91,"لقد يرتقي في الجمع فرد ذرى المجد","https://www.aldiwan.net/poem44863.html","الطويل"],[30,"إليك من الصمان والرمل أقبلت","https://www.aldiwan.net/poem1293.html",""],[60,"ما أحسن الدنيا وإقبالها","https://www.aldiwan.net/poem30913.html","السريع"],[46,"تصدت وحبل البين مستحصد شزر","https://www.aldiwan.net/poem29676.html","الطويل"],[48,"لا تسأل الضيف إن أطعمته ظهرا","https://www.aldiwan.net/poem22086.html","البسيط"],[70,"شربنا على ذكر الحبيب مدامة","https://www.aldiwan.net/poem1525.html",""],[92,"إلى المناضلين","https://www.poetsgate.com/ViewPoem.aspx?id=179212",""],[92,"الثورة العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=178929",""],[173,"قم فاسقنيها قبل صوت الحمام","https://www.aldiwan.net/poem1679.html",""],[343,"يا رب كن لي وليا","https://www.aldiwan.net/poem68722.html","المجتث"],[361,"يا موت طرفى رهانٍ","https://www.aldiwan.net/poem24534.html","البسيط"],[369,"قل لعماد الدين عن عبده","https://www.aldiwan.net/poem60855.html","البسيط"],[396,"من شل بقعا على جنبيه ماطاقها","https://www.aldiwan.net/poem54430.html","عموديه"],[435,"الحمد لله الذي قد حللا","https://www.aldiwan.net/poem40815.html","الرجز"],[445,"سلام وهنيت فيك السلامه","https://www.aldiwan.net/poem34883.html","المتقارب"],[466,"عليها ذمام الله من كل ذاعر","https://www.aldiwan.net/poem15462.html","الطويل"],[509,"هواك لا نوار الملامة ملمع","https://www.aldiwan.net/poem38404.html","الطويل"],[534,"قل لعلي نالا","https://www.aldiwan.net/poem37249.html","مجزوء الرجز"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44601","البسيط"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44613","المجتث"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48791","المتقارب"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48652","الرجز"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61038","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136331","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112911","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101018","الطويل"],[1782,"","https://poetry.dctabudhabi.ae/diwan/poem/128776","السريع"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48253","البسيط"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89547","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53203","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27741","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27514","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27400","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27404","السريع"],[2234,"","https://poetry.dctabudhabi.ae/diwan/poem/111086","البسيط"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137104",""],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87336","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87341","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87326","الرجز"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130795",""],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11337","السريع"],[3243,"","https://poetry.dctabudhabi.ae/diwan/poem/140234",""],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71321","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74030","الرجز"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102427","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129349","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66426","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110085","الطويل"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202341","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114574","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[4034,"","https://poetry.dctabudhabi.ae/diwan/poem/83116","الطويل"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136817",""],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83187","الرجز"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120510","المجتث"],[4699,"زهرتي","https://www.poetsgate.com/ViewPoem.aspx?id=193382",""],[4778,"رسول السماء","https://www.poetsgate.com/ViewPoem.aspx?id=200413",""],[4785,"عيد البرية","https://www.poetsgate.com/ViewPoem.aspx?id=129424",""],[4978,"تشطير بلقيسيات 1","https://www.poetsgate.com/ViewPoem.aspx?id=177256",""],[4984,"يا خالق الأكوان","https://www.poetsgate.com/ViewPoem.aspx?id=190543",""],[585,"هو الصوت دوّى من فلسطين عالياً","https://www.poetsgate.com/ViewPoem.aspx?id=161906",""],[5206,"حَيَاةُ المُهَج","https://www.poetsgate.com/ViewPoem.aspx?id=187392",""],[5277,"الهوى العراقي...","https://www.poetsgate.com/ViewPoem.aspx?id=194162",""],[5431,"وكم للحب آهاتٌ جياعُ","https://www.poetsgate.com/ViewPoem.aspx?id=188127",""],[5476,"وَاسْتَقَالَ الْمَلَّاحُ","https://www.poetsgate.com/ViewPoem.aspx?id=194683",""],[5690,"أسيرُ وقلبي في الغرام أسيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=172162",""],[6068,"في نصر أحمد -08-","https://www.poetsgate.com/ViewPoem.aspx?id=175895",""],[6267,"فإنْ ذُكرَتْ هششتُ لذكرها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=8341&r=&rc=50",""],[2220,"استغفرُ اللهَ منْ علمٍ أفوهُ بهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11427&r=&rc=301",""]],"verses":[["فَإِن ذُكِرَت لُبنى هَشِشتُ لِذِكرِها","كَما هَشَّ لِلثَديِ الدَرورِ وَليدُ",0,"د",1,0],["فَإِنَّ ذِمامَ الهَوى لَم أَزَل","أُبَقّيهِ حِفظاً كَما لَم أَزَل",1,"ل",1,0],["فإن ذلك أجدى من تشاغلها","بحفظ مدحك يا علجَ الفلاليجِ",2,"ج",1,0],["فإن ذلك ذنبٌ لستُ أحفِله","لا يغفرُ اللَّهُ ذاكَ الذنبَ آمينا",3,"ن",2,0],["فَإِن ذَكَروا يَوماً أَغَرَّ مُحَجَّلاً","فَإِيّاهُ يَعنونَ الأَغَرَّ المُحَجَّلا",4,"ل",2,0],["فان ذل ذاك الشعب فهو يعزه","وان ضل ذاك الشعب فهو له يهدى",5,"د",2,0],["فَإِنَّ ذُنوباً مِن سِجالِكَ مالِىءٌ","حِياضي فَأَفرِغ لي ذُنوباً أُناهِبُه",6,"ب",2,0],["فَإِنَّ ذا العَرشِ جَزيلُ العَطا","ءِ يُضَعِفُ بِالحَبَةِ أَمثالَها",7,"ل",3,0],["فَإِن ذَمَّتِ الأَعداءُ سوءَ صَباحِها","فَلَيسَ يُؤَدّي شُكرَها الذِئبُ وَالنَسرُ",8,"ر",1,0],["فَإِنَّ ذَلِكَ مِن قَولٍ يُلَقِّنُهُ","لا أَشتَهي الزادَ وَهوَ الساغِبُ الحَرِبُ",9,"ب",1,0],["فإن ذُكرَتْ في الحَيّ أصبحَ أهلُهُ","نَشاوى ولا عارٌ عليهمْ ولا إثم",10,"م",1,0],["فأنذرْ بحنظلةٍ خائنا","تعجَّلَه الثَمرُ الطيب",11,"ب",1,0],["فان ذهبت طي الرياح جهودنا","فعرضك يا أبناء يعرب ناصع",12,"ع",1,0],["فَإِنَّ ذا الإِسمَ بِهِ لائِقٌ","لا بِالمشائِيمِ الطَغامِ اللِئام",13,"م",1,0],["فَإِن ذَمَمتَ صَنيعي","فَقَد حَمَدتُ صَنيعَك",14,"ك",1,0],["فإن ذا السكر من كأس المحبة في","موت وطيب حياة غير معتبط",15,"ط",1,0],["فإنْ ذا يكُنْ غَضباً مُفْرِطاً","لِما بدا من زَلَلٍ فارِط",16,"ط",1,0],["فانذق ببقعا إلى الحد به على أشداقها","إن هي بخلعه وإن هي لبست أخلاقها",17,"ق",3,0],["فإن ذا الكاسر محمود الخبر","وفعله بالصيد حسناً مشتهر",18,"ر",1,0],["فإن ذكَّرتني ليالي المُقامِ","لديكَ نعيماً بدارِ المقامَهْ",19,"م",2,0],["فانْ ذُكرت نُعمى فأنت جَوادها","واِنْ لقحت حربٌ فأنت هُمامُها",20,"م",3,0],["فان ذل عذري في ازالة قهره","انيناً حزيناً باكياً اتشفع",21,"ع",1,0],["فإنَّ ذا يَسْرِي إلَى","فَسادِ عَقْلِ العُقَلا",22,"ل",2,0],["فَإِنَّ ذلِكَ أَمرٌ مَع نَفاسَتِهِ","وَنُبلِهِ بِفَناءِ العُمرِ مَوصولُ",23,"ل",1,0],["فَإِنَّ ذلِكَ عِندي","سُقوطُ نَفسٍ وَهِمَّهْ",24,"ه",1,0],["فإن ذهب اليوم ميدانها","فقد خسرت أمس فرسانها",25,"ن",3,0],["فإن ذكرنا لكم ذنوبا","كفَّرَها دفعُكُمُ الغريبا",26,"ب",2,0],["فَإِن ذبت صَبراً أَو أَسى ما عَلمتَني","عَلى أَحد إِلا عَليك أَذوب",27,"ب",1,0],["فان ذكروني بينهم وتعرفوا","شؤني فصف عني بما أنت عالمه",28,"م",2,0],["فان ذنوبي اورثت قلبي المحن","اجرني وخذني للكمال تفضلا",29,"ل",2,0],["فإن ذكرت باريس غوثاً تزلزلت","وإن يذكر التاميز زبلين يحبق",30,"ق",1,0],["فإن ذوى الروض بأنفاسه","يحيى من الدمع بمهراقه",31,"ق",2,1],["فإنَّ ذلكَ واللهِ الكريمِ هو ال","ندبُ الكريمُ الذي أفضاُلهُ شَرَعُ",32,"ع",1,0],["فَإِن ذَكَروا بَأساً فَأَنتَ مُقَدَّمٌ","وَإِن ذكروا عُرفاً فَأَنتَ مُنيلُ",33,"ل",1,0],["فانذر لها حجّاً عليك فإنها","دار السلام وكعبة الإسلام",34,"م",1,0],["فإنّ ذمه ذو النقصِ فهي شهادةٌ","بأن الذي قد ذم في الفضل كاملُ",35,"ل",1,0],["فإن ذلك إكسيرٌ وقوّتُه","إنَّ تقلبَ العين والأجساد والصورا",36,"ر",2,0],["فإنَِّ ذا فطنة مثلي مخلقة","ترى الحقائقَ تأتيها على قدر",37,"ر",1,0],["فإن ذكرتم فاذكروه بما","تلاه في القرآنِ ذي الذكر",38,"ر",1,0],["فإن ذكرنا حسيناً والطفوف غدا","تذكاره لرزايا الدهر ينسينا",39,"ن",2,0],["فان ذاكر جدواه امامهم","كمو قد الشمع في قاعات عميان",40,"ن",1,0],["فَأَنذِرُكُم هَذا التّفَاوُتُ بَينَهُم","وَبَينَ اليَمَاني يَا خَليلي مِنَ النَّسرِ",41,"ر",1,0],["فَإنَّ ذا ثَمنُ أزوامٍ لِطَايركُم","من مَشرِقٍ لِمَغربٍ وَهوَ مَفصولُ",42,"ل",1,0],["فَإنَّ ذاكَ قِبلَةُ المُحَكَّمِ","ولا تُخِلُّ بصَلاةِ المُسلِمِ",43,"م",1,0],["فان ذا التقليد داءٌ فشا","لو دام فيه اخذها تصرعُ",44,"ع",1,0],["فَإِنَّ ذا العَقلِ إِذا هَيَّجتَهُ","هِجتَ بِهِ ذا خَبَلٍ خابِلِ",45,"ل",1,0],["فإن ذا الخطاب ما تعلقا","عليه ما دام بشرك علقا",46,"ق",2,0],["فَإِنْ ذَبَلَتْ أَجْفَانُهَا وَهْيَ نَرْجِسٌ","فَمِنْ طُوْلِ مَا أَدْمَنْتُ فِيهِنَّ مِنْ شُرْبِ",47,"ب",1,0],["فَإِنّ ذا من شرف الحَوباء","وَرُبَّما مالَ إِلى شحناءِ",48,"ا",2,0],["فإن ذقت فاها بعدما سقط الندى","بعطفي بخنداة رداح المنطق",49,"ق",1,0],["فانذرهم في معجزات ضياؤها","يسير بها الساري بليل ويهتدي",50,"د",2,0],["فإن ذوي الآداب يهدى إليهم","بديع المعاني إذ يجوش بها الصدرُ",51,"ر",1,0],["فانَّ ذَكاءَ العقل للمَرءِ مَعقِلٌ","غنيٌّ بهِ عن كلّ تُرسٍ وصارمِ",52,"م",1,0],["فإن ذعرت منك الجياد فإننا","بأمنك لو جاورتنا قمناء",53,"ا",2,0],["فإن ذلك أصل لومِهِنَّ لها","وذلكَ الوجهُ في التخصيصِ يكفيهِ",54,"ف",3,0],["فإن ذرى الأولمب والأرض بيننا","مشاعٌ فلا ألوي له حبل عاتقي",55,"ي",1,0],["فإن ذَرفَت عَينايَ وَجداً عليكما","ففي دون ما ألقاهُ مبكى ومجْزَعُ",56,"ع",1,0],["فإن ذا بشي من الله كان في الكون بودي","سابقة ود من ود الرحيم الودود",57,"د",1,0],["فَإِن ذوى رَوضُ الصِبا فَجُودُهُ","يُعِيدُ غَضّاً ناعِماً ما قَد ذَوَى",58,"ا",1,0],["فَإِنّ ذا لَونَينِ","مَن لَبِسَ الحالَينِ",59,"ن",1,0],["فان ذكراه كادت","توحى الى اعتقادا",60,"د",2,0],["فإن ذبل الفؤاد أسىً وحزناً","تُرَوِّيني جذورُ هواكِ رفقاً",61,"ق",2,0],["فأنذَر من قومه الأقربين","وما فلَّ عزمه حقد العدا",62,"د",2,0],["فَإنْ ذَكَرْتُمْ رَسُولَ اللهِ تكرِمَةً","فَبَلِّغُوهُ سَلامَ الشَّاعِرِ القَرَوِيّ",63,"و",2,0],["فإنْ ذهبتَ بعيداً","(كما يشاء التجنّي)",64,"ن",2,0],["فأنذر الخلق بما لم يكن","في علمهم من هول يوم الندا",65,"د",2,0],["فإن ذدت عني ما أبحت غزاتهم","فإن وراء المنع للغل شافيا",66,"ي",2,0],["فَإنْ ذَاقَهَا لَمْظًا لَهَا مِنْ نُقَاخِهَا","يَجِدْ ذَوْقَهَا أحْلَى مَذَاقًا مِنَ الصَّهْبَا",67,"ب",2,0],["فإنْ ذقنَ المنامَ حسبنَ موتاً","دنا منهنَّ بعدَ السهدِ حتفا",68,"ف",2,0],["فإن ذقتم ملوحتنا فغوصوا","ببحر الحب وافرنا مطاعُ",69,"ع",1,0],["فَإِنْ ذَكَرُونِي بِبَعْضِ الْعُلَا","ذَكَرْتُهُمُ فِي الْمُنَى حَيْثُ سَارُوا",70,"ر",3,0],["فأن ذكروا يوماً سعاداً وزينباً","فاحسب ليلي بالسلام تشيرُ",71,"ر",1,0],["فإن ذكروا بدر التمام بسبّة","فقد نسبوا طفلا لربّ المغارب",72,"ب",1,0],["فإنْ ذُكرَتْ هششتُ لذكرها","كَمَا هَشَّ لِلثَّدْيِ الدَّرُورِ وَلِيدُ",73,"د",1,1],["فإنّ ذا فطنة ٍ مثلي مخلفة ٍ","ترى الحقائقَ تأتيها على قدر",74,"ر",1,0]]}