{"poems":[[34,"ألا ليت أيام مضين تعود","https://www.aldiwan.net/poem4881.html","الطويل"],[73,"لئن قصر اليأس منك الأمل","https://www.aldiwan.net/poem11853.html","المتقارب"],[51,"اردد علي قراطيسي ممزقة","https://www.aldiwan.net/poem9238.html","البسيط"],[51,"أستغفر الله من ذنبي ومن خطئي","https://www.aldiwan.net/poem66417.html","البسيط"],[70,"أبى الله إلا أن تسود وتفضلا","https://www.aldiwan.net/poem42765.html","الطويل"],[89,"لقد يرتقي في الجمع فرد ذرى المجد","https://www.aldiwan.net/poem44863.html","الطويل"],[28,"إليك من الصمان والرمل أقبلت","https://www.aldiwan.net/poem1293.html",""],[58,"ما أحسن الدنيا وإقبالها","https://www.aldiwan.net/poem30913.html","السريع"],[44,"تصدت وحبل البين مستحصد شزر","https://www.aldiwan.net/poem29676.html","الطويل"],[46,"لا تسأل الضيف إن أطعمته ظهرا","https://www.aldiwan.net/poem22086.html","البسيط"],[68,"شربنا على ذكر الحبيب مدامة","https://www.aldiwan.net/poem1525.html",""],[90,"إلى المناضلين","https://www.poetsgate.com/ViewPoem.aspx?id=179212",""],[90,"الثورة العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=178929",""]],"verses":[["فَإِن ذُكِرَت لُبنى هَشِشتُ لِذِكرِها","كَما هَشَّ لِلثَديِ الدَرورِ وَليدُ",0,"د",1,0],["فَإِنَّ ذِمامَ الهَوى لَم أَزَل","أُبَقّيهِ حِفظاً كَما لَم أَزَل",1,"ل",1,0],["فإن ذلك أجدى من تشاغلها","بحفظ مدحك يا علجَ الفلاليجِ",2,"ج",1,0],["فإن ذلك ذنبٌ لستُ أحفِله","لا يغفرُ اللَّهُ ذاكَ الذنبَ آمينا",3,"ن",2,0],["فَإِن ذَكَروا يَوماً أَغَرَّ مُحَجَّلاً","فَإِيّاهُ يَعنونَ الأَغَرَّ المُحَجَّلا",4,"ل",2,0],["فان ذل ذاك الشعب فهو يعزه","وان ضل ذاك الشعب فهو له يهدى",5,"د",2,0],["فَإِنَّ ذُنوباً مِن سِجالِكَ مالِىءٌ","حِياضي فَأَفرِغ لي ذُنوباً أُناهِبُه",6,"ب",2,0],["فَإِنَّ ذا العَرشِ جَزيلُ العَطا","ءِ يُضَعِفُ بِالحَبَةِ أَمثالَها",7,"ل",3,0],["فَإِن ذَمَّتِ الأَعداءُ سوءَ صَباحِها","فَلَيسَ يُؤَدّي شُكرَها الذِئبُ وَالنَسرُ",8,"ر",1,0],["فَإِنَّ ذَلِكَ مِن قَولٍ يُلَقِّنُهُ","لا أَشتَهي الزادَ وَهوَ الساغِبُ الحَرِبُ",9,"ب",1,0],["فإن ذُكرَتْ في الحَيّ أصبحَ أهلُهُ","نَشاوى ولا عارٌ عليهمْ ولا إثم",10,"م",1,0],["فأنذرْ بحنظلةٍ خائنا","تعجَّلَه الثَمرُ الطيب",11,"ب",1,0],["فان ذهبت طي الرياح جهودنا","فعرضك يا أبناء يعرب ناصع",12,"ع",1,0]]}