{"poems":[[88,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[54,"لما ظننت فراقهم لم أرقد","https://www.aldiwan.net/poem27130.html","الكامل"],[484,"طال المدى في خطة الأعراض","https://www.aldiwan.net/poem37181.html","الكامل"],[567,"الزهر تبسم نورا عن أقاحيها","https://www.aldiwan.net/poem52974.html","البسيط"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25478","الرجز"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56172","المتدارك"],[1473,"","https://poetry.dctabudhabi.ae/diwan/poem/124027","الخفيف"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87831","الكامل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107002","الكامل"],[3277,"","https://poetry.dctabudhabi.ae/diwan/poem/125986","البسيط"],[3394,"","https://poetry.dctabudhabi.ae/diwan/poem/123889","البسيط"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52985","الرمل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123944","الخفيف"],[3869,"","https://poetry.dctabudhabi.ae/diwan/poem/34858","الخفيف"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103048","الخفيف"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36302","الدوبيت"],[5038,"سل قلبي المكلوم","https://www.poetsgate.com/ViewPoem.aspx?id=188130",""],[5219,"ليتها","https://www.poetsgate.com/ViewPoem.aspx?id=194757",""],[5561,"خذني إليك ...","https://www.poetsgate.com/ViewPoem.aspx?id=206453",""],[6268,"عَدُّودَةُ الخُروج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82921&r=&rc=7",""]],"verses":[["سَلْ قاهِرَ الفُرسِ والرُّومانِ هل شَفَعَتْ","له الفُتوحُ وهل أغنَى تَواليها",0,"ي",3,0],["سَلَقَتهُمُ زَفَراتُ قَلبٍ مُحرَقٍ","وَسِجالُ دَمعٍ بِالدِماءِ مُوَرَّدِ",1,"د",1,0],["سلق الوفي بعهده منك الحسو","د تشفيا بلسانه النضناض",2,"ض",1,0],["سَلْ قومَ عكاءَ حِينَ اربَدَّ مشرِقُها","والشأمَ والتُركَ لمَّا اسودَّ ناديها",3,"ي",3,0],["سِلْقٌ خَلِيلُ سَلْقَةِ طَلّاسْ","لا يَسْأَمُ العَرِيسُ مِنْ إِفْلاسْ",4,"س",1,1],["سل قوم الترك ومن علمِ","عن حرب البأس ذو العلمِ",5,"م",1,1],["سل قريشا بأمر وقعة بدر","كيف اذلالُها نفير العناد",6,"د",1,0],["سَل قَلبَكَ الخَفّاقَ عَن حُزني وَعَن","وُدّي وَإِخلاصي وَصِدقِ ذِمامي",7,"م",2,0],["سل قلبك القاسي فهل","قاسى كما قاسيت ام لم",8,"م",1,0],["سل قرطجنَّة أو سل قادساً وكذا","أرض المتابيل حيث العاج والذهب",9,"ب",1,0],["سلقت آذانه بعنز","قد أكلوا في الحجاز لحمه",10,"ه",1,0],["سل قُراها كي تراها","ألفتْ وصفَ التحسن",11,"ن",1,0],["سل قذيف المكسيم كم من خراب","سيم خسفا فيه على العمران",12,"ن",1,0],["سَلَقَتنا وَخَردَلَت","ثُمَّ وَلَّت فَأَدبَرَت",13,"ت",1,1],["سل قنا الخط أو ظبى الهند عنه","تلف عزَّ الدنيا بكفيه ذلّا",14,"ل",2,0],["سَل قَلبيَ هَل يَطيبُ أَو يَبتَهِجُ","إِلّا وَغِناؤُهُنَّ سمعي يلجُ",15,"ج",1,1],["سَلْ قَلْبِيَ الْمَكْلومَ سَلْ وَقْعَ اللّظى","ما عادَتِ الأَحْلامُ ضَغْثاً أَصْفَرا",16,"ر",2,0],["سل قييسا ذاك من هجر ثوى","كان فصلا من حياة العابثينا",17,"ن",2,0],["سلقوا الصلاحَ بِألسُنٍ مسمومةٍ","والقولُ مِن خبثِ الحديثِ يُعاني",18,"ن",2,0],["سل ( قلندول ) ، شمسها وهواها","كيف أضحت هواية القتل عدوى",19,"و",2,0]]}