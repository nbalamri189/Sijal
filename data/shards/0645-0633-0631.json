w.poetsgate.com/ViewPoem.aspx?id=139687",""],[4869,"مشاكسة زواج ..","https://www.poetsgate.com/ViewPoem.aspx?id=151704",""],[5019,"يا أيها العارف المحكول ناظره","https://www.poetsgate.com/ViewPoem.aspx?id=157050",""],[5111,"قِيثَارَةُ العِشْقِ","https://www.poetsgate.com/ViewPoem.aspx?id=212085",""],[5145,"ما على الجيرة لو صبروا","https://www.poetsgate.com/ViewPoem.aspx?id=108198",""],[5155,"أغنية عربية الى كردستان","https://www.poetsgate.com/ViewPoem.aspx?id=176153",""],[778,"قم فاجعل اليوم حسنا","https://www.poetsgate.com/ViewPoem.aspx?id=89217",""],[5281,"ليلة المعراج","https://www.poetsgate.com/ViewPoem.aspx?id=199707",""],[5370,"خلينا نتفاهم","https://www.poetsgate.com/ViewPoem.aspx?id=81641",""],[5388,"أقبل الليل","https://www.poetsgate.com/ViewPoem.aspx?id=206922",""],[5459,"صرخة","https://www.poetsgate.com/ViewPoem.aspx?id=190893",""],[5526,"لا تامن سهيل","https://www.poetsgate.com/ViewPoem.aspx?id=194420",""],[5561,"خذني إليك ...","https://www.poetsgate.com/ViewPoem.aspx?id=206453",""],[470,"القافلة","https://www.poetsgate.com/ViewPoem.aspx?id=178094",""],[5596,"دار الغشّام","https://www.poetsgate.com/ViewPoem.aspx?id=206479",""],[5618,"القدس في عين شاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=208919",""],[5725,"تداعى علينا القوم","https://www.poetsgate.com/ViewPoem.aspx?id=177466",""],[5861,"نداء لدول الطرشستان","https://www.poetsgate.com/ViewPoem.aspx?id=190323",""],[5977,"نجم أفل","https://www.poetsgate.com/ViewPoem.aspx?id=212730",""],[5997,"القدس نادى","https://www.poetsgate.com/ViewPoem.aspx?id=214279",""],[6093,"إلاَّا القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=178563",""],[6189,"يا ضمير الأحرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67118&r=&rc=3",""],[6210,"ألق السلام على القباب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78228&r=&rc=20",""],[6212,"مُكَاشَفَاتٌ أَخِيْرَةٌ في مَهَبِّ اللَّيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1623&r=&rc=4",""],[6237,"حيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77869&r=&rc=11",""],[6237,"جبل فيفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77861&r=&rc=3",""],[406,"إلى ياسر عرفات ( بعها )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=840&r=&rc=31",""],[6318,"القدس في خطر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66164&r=&rc=14",""],[6351,"مخطوطة للمتنبي.. لم تُحقَّق بعد!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86051&r=&rc=4",""],[6355,"مأوى البجع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66641&r=&rc=101",""],[572,"قَامَ بالنَّفسِ في هَوَى قمرٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9325&r=&rc=182",""]],"verses":[["مَسَرَّةَ الشامِ إِنّا","إِخوانُكُم ما حَيينا",0,"ن",2,0],["مَسَرَّةٌ لِي وَفَخْرٌ","تَلازُمُ اسْمِكَ وَاسْمِي",1,"م",2,0],["مسرَّة كانَ طرف الشرع يرقبها","ومطلبٌ كانت العليا تحاوره",2,"ر",2,0],["مُسْرجاتٍ مجللاتٍ تجافي","فَ حديدٍ مواضعَ الأجلالِ",3,"ل",1,0],["مسراك في أخريات الليل يبهجني","بمنظر فاتن أحسن بمسراك",4,"ك",1,0],["مُسرِفٌ في هَجرِهِ ما يَنتَهي","أَتُراهُم عَلَّموهُ السَرَفا",5,"ف",2,0],["مُسرَجٌ في كُلِّ حينٍ مُلجَمٌ","كامِلُ العُدَّةِ مَرموقُ الرُواء",6,"ا",2,0],["مَسَرَّةٌ في قُلوبِ الطيبِ مَفرِقُها","وَحَسرَةٌ في قُلوبِ البَيضِ وَاليَلَبِ",7,"ب",1,0],["مُسرِفٌ في السَماحِ يوهِمُهُ الجو","دُ بِأَنَّ الإِقصادَ في الإِقتِصادِ",8,"د",1,0],["مَسرودَةٍ مِثلِ جِلدِ الصِلِّ لَو نُصِبَت","قامَت وَلو صُبَّ فيها الماءُ ما نَضَحا",9,"ح",2,0],["مسرعات مبطئات ولها","خفة الموت وأثقال الجبال",10,"ل",1,0],["مُسرِعاتٍ كَأَنَّهُنَّ ضِراءٌ","سَمِعَت صَوتَ هاتِفٍ كَلّابِ",11,"ب",1,0],["مسروقة كلها تلك المضامينُ","وليسَ منها لهم إلا العناوينُ",12,"ن",1,1],["مسراكَ نورٌ وأنسامٌ وأنداءُ","فاخفقْ شراعي وطِرْ يصدحْ لك الماءُ",13,"ا",2,1],["مَسْرَحٌ لِلْعُيُونِ يَمْتَدُّ فِيهِ","نَفَسُ الرِّيحِ بَيْنَ مَاضٍ وَآتِ",14,"ت",1,0],["مَسْرودَةً سَرْداً عَلى صفوِهِ","أَفعلَ فِي النفْسِ مِنَ الْخَمْرِ",15,"ر",1,0],["مُسْرِفاً فِي الْبِنَاءِ لله مِمَّا","تَقْتَنِي بِالتُّقَى وَتَذْخُرُ قَصْدَا",16,"د",2,0],["(مسرور) تدري كيف اسكانهم","لا تبق حيا ، صدقت (جلّنار)",17,"ر",1,0],["مسراك نور وأنسام وأنداؤ","فاخفق شراعي ، وطر ، يصدح لك الماء",18,"ا",2,1],["مسرى البشائر في ظهور رياضِ","أبهى وأزهر من زهور رياضِ",19,"ض",1,1],["مسراك يا سيدي بالحزن ملتحف","يشكو إلى الله ما أمسى يعانيه",20,"ي",2,0],["مُسربلةٌ في العيدِ حلَّةَ مخملٍ","كما نشَرَ الطَّاووسُ ريشاته زهوا",21,"و",2,0],["مسرح مخرج الروايات","فيه من إليه الإحياء والإفناء",22,"ا",2,0],["مُسرِعاتٍ حتّى تَخالَ فُوَيْقَ ال","أرضِ منها طَيْراً يَمُرُّ مُسِفّا",23,"ف",2,0],["مَسرَّتُهُ مأْوى الغريبِ وسِتْرُهُ","ولَذَّتُهُ خَيْرُ المُقِلِّ ورِفْدُهُ",24,"د",2,0],["مسربلةً لم تدفع النَّبل دِرعُها","وعُريانةً لم تشكُ قيظاً ولا قُرَّا",25,"ر",2,0],["مَسَرَّةً بعَمِيمِ الجودِ ذي خطرٍ","يحيا بإحسانه جُرْدٌ وآبالُ",26,"ل",1,0],["مسرح إخواني ونفسي حرة","مذ خلقت تصبو إلى إخوانها",27,"ن",3,0],["مسرة محزون وعذر معربد","وكبر مجوسي وفتنة مسلمِ",28,"م",1,0],["مَسَرّةٌ كيلها بلا حَشَفِ","ولذةٌ صَفْوُها بلا كَدَرِ",29,"ر",1,0],["مُسرِفٌ في النَّوالِ كَفّاهُ في تَف","ريقِ ما في جِهاتِه في سِباق",30,"ق",1,0],["مسرجةٌ تُسْرَجُ من فوقها","ذبالةٌ في جَوْفِ مصباحِ",31,"ح",1,1],["مسرّة وَالد بطلوع بَدر","مُنير ثَغره في مَصر باسم",32,"م",1,0],["مُسَرْبَلٌ مثلَ حَبيكِ القزِّ","أو مثلَ جَزْعِ اليَمَنِ الأَرُزِّي",33,"ز",2,0],["مسرف الجود وهوبا","ما سرت ريح مهبه",34,"ب",2,0],["مسرة كان طرف الدين يرقبها","ومطلب كان قلب الكفر يأباه",35,"ا",2,0],["مسرعاً خلف سلوقيّ له","ضامرِ الخصر عظيم الوثبات",36,"ت",1,0],["مَسَرَّةٌ طَفَحَت في الكَونِ مانِحَةً","لِي قسمَها الأَوفَرَ الهِطال بِالجَزلِ",37,"ل",1,0],["مَسَرَةٌ في قُلوبِ الخَلقِ لاعِبَةٌ","خَليل عُلياكَ مِنها شارِدٌ ثَملُ",38,"ل",1,0],["مسرة الانسان والمساءة","نتيجة الإحسان والإساءة",39,"ه",1,0],["مُسَرْبَلُونَ يَقيناً لا يماثِلُهُ","مِنْ نسجِ داودَ في الهَيْجا سَرابيلُ",40,"ل",1,0],["مسرعاً بعضُها الخطى إثرَ بعضٍ","حلَّ عالٍ منها لآخرَ سافل",41,"ل",1,0],["مسرّةٌ قد خصّك الله بها","تملأُ قلبَ الكاشحينَ كمدا",42,"د",2,0],["مسرَّةٌ لأبي الهادي أعادَ بها","بُرءُ الحسينِ لنا العهدَ الذي قدُما",43,"م",2,0],["مسراه في شرف الإسلام منتقلا","بين القبيلين من طود إل