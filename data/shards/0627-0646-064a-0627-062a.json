لاحبَّ إلا أنت","https://www.poetsgate.com/ViewPoem.aspx?id=213764",""],[6106,"سيدنا الإمام الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=6315",""],[6125,"حاشا وكلا أنْ أُبدِّلَ ديني","https://www.poetsgate.com/ViewPoem.aspx?id=212872",""],[6131,"روحي رهينةْ","https://www.poetsgate.com/ViewPoem.aspx?id=189335",""],[6171,"عَزْفٌ عَلَى وَتَرِ الَيأسِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86326&r=&rc=9",""],[6181,"مسافر ومسافرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87686&r=&rc=1",""],[6239,"بَرْزَخٌ من حَجَرٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76053&r=&rc=104",""],[6344,"متاهات الأسى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87974&r=&rc=14",""]],"verses":[["إِنّي أَتاني عَنكَ آوِنَةً","لَذعٌ يَضيقُ بِوَقعِهِ عَطَني",0,"ن",2,0],["إِنِّي أَتَيْتُكَ فَأقْبَلْنِي وَخُذْ بِيَدِي","وَمِنْ لهِيبِ لَظَى جِرْنِي وَسجِّينِ",1,"ن",1,0],["أَن يَأتِياكَ بِرُهنِهِم فَهُما إِذاً","جُهِدا وَحُقَّ لَخائِفٍ أَن يُجهَدا",2,"د",2,0],["أَنَّى اِتَّجَهتَ رَأَيتَ رَوضاً مُحدِقاً","بِشَفا غَديرٍ كَالمَجَرَّةِ وَالسَما",3,"م",2,0],["أَنّى اِتَّجَهتَ لَقيتَ مُنبَجِساً","مُتَدَفِّقاً في يانِعٍ خَضِلِ",4,"ل",1,0],["أَنّى اِتَّجَهتَ رَأَيتَ ماءً سائِحاً","مُتَدَفِّقاً أَو يانِعاً مُتَهَدِّلا",5,"ل",2,0],["إِنّي أَتاني كَلامٌ ما غَضِبتُ لَهُ","وَقَد أَرادَ بِهِ مَن قالَ إِغضابي",6,"ب",2,1],["إِنّي أَتَيتُكَ طالِباً فَبَسَطتَ مِن","أَمَلي وَأَنجَحَ جودُ كَفِّكَ مَطلَبي",7,"ب",2,0],["إِنّي أَتَيتُ مُوَدِّعاً وَأَقولُ لَو","لَم آتِ فَضلَكَ طالِباً لَأَتاني",8,"ن",2,0],["إِنّي أَتاني كِتابٌ كُنتُ تابِعَهُ","إِلَيَّ مِنكَ وَلَم أُقبِل مَعَ العيرِ",9,"ر",1,0],["إِنّي أَتَيتُكَ لِلسَلا","مِ تَكَلُّفاً مِنّي وَحُمقا",10,"ق",2,1],["إِنّي أَتَتني مِن لَدُنكَ صَحيفَةٌ","غَلَبَت هُمومَ الصَدرِ وَهيَ غَوالِبُ",11,"ب",1,1],["إِنّي أَتَتنِيَ شَكوى لا أُسَرُّ بِها","وَذَروُ قَولٍ وَلَم نَخشى الَّذي نَجَما",12,"م",2,1],["إِنّي أَتوبُ إِلَيكِ تَوبَةَ مُذنِبٍ","يَخشى العُقوبَةَ مِن مَليكٍ مُنعِمِ",13,"م",1,0],["إِنّي أُتِيحَت لي يَمانِيَّةٌ","إِحدى بَني الحَرثِ مِن مُذحِجِ",14,"ج",1,0],["إنِّي اتهَمْتُ نَصِيحَ الشَّيْبِ في عَذَلٍ","والشِّيْبُ أَبْعَدُ في نُصِحٍ عَنْ التُّهَمِ",15,"م",1,0],["إِنّي أَتَيتُكُمُ مِنَ القَبرِ","وَالناسُ مُحتَبِسونَ لِلحَشرِ",16,"ر",1,1],["إِنّي أَتَيتُ بَني المُهَل","هِلِ آنِفاً بِهِجائِكا",17,"ك",2,1],["إنّي أتوبُ إلى اللَهِ","من مزاحِكَ فاغفر",18,"ر",1,0],["إِنّي أُتَمِّمُ أَيساري وَأَمنَحُهُم","مَثنى الأَيادي وَأَكسو الجَفنَةَ الأُدُما",19,"م",2,0],["إنِّي أتوبُ إليكَ مُعْترِفاً","إِنْ كُنْتَ تَقْبَلُ تَوْبَ مُعْتَرفِ",20,"ف",1,0],["أنى اتجهت للإسلام في بلد","تجده كالطير مقصوصاً جناحاه",21,"ا",2,0],["أَنِّي أُتَمِّمُ أَيْسَارِي بِذِي أَوَدٍ","مِنْ فَرْعِ شَيْحَاطَ صَافٍ لِيطُهُ قَرِعُ",22,"ع",1,0],["أني اتجهت، وجدت خلفك أمةً","ورأيت ربك بالنجاح كفيلا",23,"ل",2,0],["إني أتيتُكَ مصطافًا، وملتَمسًا","من مائك المعدنيِّ البرءَ من سقمي",24,"م",2,0],["أنَّى اتجهتُ، وجدتُهم بِيَ أحْدَقُوا","«مِنْ عَنْ يَمِينِي تارةً وشِمالِي»",25,"ل",2,0],["أنَّى اتجهنا، رأينا نهضةً عَمَمًا","لها أساسان: إنصاف وعُمْران",26,"ن",1,0],["أنَّى اتجهت إلى الإسلام في بلدٍ","تجده كالطير مقصوصًا جناحاه",27,"ا",2,0],["اِنِّي اتَّهَمْتُ نصيحَ الشَّيْبِ فِي عَذَلِي","والشَّيْبُ أبعَدُ في نُصْحٍ عَنِ التُّهَمِ",28,"م",1,0],["أنْ يَأتِيَاكَ برُهنِهِمْ، فهُمَا إذَنْ","جهدا وحقّ لخائفٍ أنْ يجهدا",29,"د",2,0],["إنّي أَتَتْنَي شَكْوَى لا أُسَرُّ بِها،","وَذَرْوُ قَوْلٍ، وَلَمْ نَخْشَ الَّذي نَجَما",30,"م",2,1],["إنى أتيتُك راجياً ومؤمِّلاَ","أطوى إليك مجاهلاً وقفارَا",31,"ر",2,0],["إِنّي أَتَيتُكَ لِلغِنى قَبلَ العُلى","فَنَحَوتَ لي حَتّى أَنَلتَهُما مَعا",32,"ع",2,0],["إنّي أتَيْتُكِ والأوارُ يَشيطُ بي","من مزنِكِ الهتّان أهْفو للمَطَرْ",33,"ر",1,0],["إنّي أتيتُ إلى البستان مختارا","ولم أكن في انصرافي عنه مختارا",34,"ر",2,1],["إني أتيتُ أفي حقاً بتهنئتي","فمن يهنئني يوماً بنعماك",35,"ك",1,0],["إِنّي أَتتني بِالنَدى","وَالجود مِنكَ إِلى البَشاره",36,"ر",2,0],["إِنّي أَتَتني عَنِ المَهدِيِّ مَعتَبَةٌ","تَكادُ مِن خَوفِها الأَحشاءُ تَضطَّرِبُ",37,"ب",1,1],["إنّي أَتَتني لِسانٌ مَا أُسَرُّ بها","من عُلوَ لا عَجَبق فِيهَا ولا سَخَرُ",38,"ر",1,1],["إني أتيتُكَ حين الدهر أمرضَني","من فاقةٍ أورَثَت في قلبيَ الغَممَا",39,"م",2,0],["إني أتيت وإنني","تحت البلايا الواهيه",40,"ي",2,0],["أني أتيت مصدِّقاً بك مؤمناً","فاغفر وفِر إذ كنتَ غيرَ ضنين",41,"ن",1,0],["إني أتشر من بديع ثنائكم","حللا يجلّبها بديع كلامي",42,"م",2,0],["إنّي اتخذتّك شافعا لي في الدُنا","وتخذت حيدر شافعا لأثامي",43,"م",2,0],["إني أتيتك إذ سمعت مناقباً","يثنى عليك بها وغرّ مدائح",44,"ح",1,0],["إني أتيت لحج بيتك وافداً","حسبي عليك رجاي أنك عاتقي",45,"ق",2,0],["أنى اتجهت رأيت راية أحمد","خفاقة تحدو بها الشجعان",46,"ن",1,0],["إني أتتني لسان لا أسر بها","من علو لا عجب منها ولا سخر",47,"ر",1,1],["إنِّي أتيتُكَ بالدُّعا","ءِ وأينَ قَدْري من دُعائِكْ",48,"ك",1,0],["أنّى أتيتَ ربوعَهُم فرِياضُها","خُضْرٌ ووُرْقُ المَكرُماتِ تثجّجُ",49,"ج",1,0],["إني أتيتُ برَفٍّ من ملائكةٍ","مُوَكَّلينَ بما حُمِّلْتُهُ شَجَنَا",50,"ن",2,0],["أَنّي أُتيحَ لَها وَكانَ بِمَعزِلٍ","وَلكلِّ أَمرٍ واقِعٍ أَسبابُ",51,"ب",1,0],["إِنِّي أَتَيْتُك يا غيثَ الْوَرى ظمئاً","في الحالِ لمّا أَغبَّتْه عَوادِيكا",52,"ك",2,0],["إنّي أتيتك يا مولايَ مُعتذراً","كذاك يطلب صفح الوالد الولدُ",53,"د",1,0],["إِنِّي أَتَيْتُ إِلَى الحَيَاةِ","لِكَيْ أَضُرَّ وَأَنْفَعا",54,"ع",2,0],["أنى اتجهت فجاهه","أبدا ونعماه تجاهي",55,"ي",1,0],["إني أتيتك ظالما مستغفرا","أخشى الذنوب وأرتجي عفو الولي",56,"ل",2,0],["إني أتَيْتُكَ يا بنَ بنت محمد","مُسْتعدياً مَسَّتْنيَ الضَّرِّاء",57,"ا",2,0],["إن يأتني من فضل ربي القوت","هان علي الدرُّ والياقوت",58,"ت",1,0],["أَنَّى أَتَحتَ لِشابك أَنيابَهُ","مُستَأنِسٍ بِدُجى الظَلامِ منازِلِ",59,"ل",1,0],["إني أتيت على فلك فقلت لها","والناس في حملها والسير تعتبر",60,"ر",1,0],["إني اتخذت الغي رشداً والهوى","ديناً ولذت عن الرشاد لواذا",61,"ذ",2,0],["أَنّى أُتيحَ لَها حِرباءُ تَنضُبَةٍ","لا يُرسِلُ الساقَ إِلّا مُمسِكاً ساقا",62,"ق",2,0],["أَنَّى اتّجهْتُ لم يَزَلْ","حَدِيثُهُمْ مَعِى مَعِي",63,"ع",2,0],["أَنّى اِتَّجَهتَ لَمَستهُ مُتَجَسِّماً","وَلَمَحتَ سِحرَ بَهائِهِ الوَضّاحِ",64,"ح",1,0],["أَنّى اِتَّجَهتَ شَهِدتَ مَصرَعَ بائِسٍ","وَسَمِعتَ رَنَّةَ يائِسٍ م