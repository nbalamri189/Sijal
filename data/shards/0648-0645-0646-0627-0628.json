رح"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46017","الطويل"],[3749,"","https://poetry.dctabudhabi.ae/diwan/poem/33130","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131050",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131260",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114511","البسيط"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95356","الكامل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95369","الكامل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127240","السريع"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90872","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94436","الطويل"],[4277,"","https://poetry.dctabudhabi.ae/diwan/poem/124304","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81718","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58141","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58010","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72452","الكامل"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4691,"بيني وبين الحزن أنسابُ !!","https://www.poetsgate.com/ViewPoem.aspx?id=57871",""],[4755,"لِدَارِ الأَسَى بَابَانِ.. عالٍ, وهابِطُ","https://www.poetsgate.com/ViewPoem.aspx?id=198745",""],[4767,"خير الناس","https://www.poetsgate.com/ViewPoem.aspx?id=179651",""],[4994,"يُحبُّهُ اللهُ وأُحبُّهُ أنا","https://www.poetsgate.com/ViewPoem.aspx?id=208943",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[5376,"يا ارضَ الملْبنِ والعسلِ","https://www.poetsgate.com/ViewPoem.aspx?id=188545",""],[5431,"في...","https://www.poetsgate.com/ViewPoem.aspx?id=183282",""],[5431,"في يوم مولد سيدي محمد (ص)","https://www.poetsgate.com/ViewPoem.aspx?id=200935",""],[5628,"ثورة حواء","https://www.poetsgate.com/ViewPoem.aspx?id=178669",""],[5897,"قم يا عراق","https://www.poetsgate.com/ViewPoem.aspx?id=156690",""],[5943,"إنْ غابَ نجمي","https://www.poetsgate.com/ViewPoem.aspx?id=11265",""],[5953,"علت قباب لكم هداتي","https://www.poetsgate.com/ViewPoem.aspx?id=93794",""],[6034,"خطب ألم فسار في الآفاق","https://www.poetsgate.com/ViewPoem.aspx?id=169608",""],[6093,"سَيْرٌ رِيَاضِي","https://www.poetsgate.com/ViewPoem.aspx?id=187112",""],[6097,"فيحاءُ تبكي","https://www.poetsgate.com/ViewPoem.aspx?id=190695",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577061",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""]],"verses":[["وَمَن أَبقى لِآجِلِهِ حَديثاً","وَمَن عانى لِعاجِلِهِ اِكتِسابا",0,"ب",2,0],["ومنْ أبي الفضلِ عِزٌّ يُستَجارُ به","يومَ الوغى وظَلامُ النّقْعِ مُعْتَكِرُ",1,"ر",1,0],["ومَنْ أبو الفتْحِ في الكِلابِ وهلْ","لجاهِلٍ في الأيّامِ منْ خطَرِ",2,"ر",1,0],["وَمِنْ أَبِيٍّ تَوَلَّى عَنْ أَرِيكَتِهِ","بِلاَ شَجىً إِذْ تَوَلاَّهَا بِلاَ رَغَبِ",3,"ب",1,0],["وَمِنَّا بُناةُ المَجدِ قَد عُلَمِت بِهِ","مَعَدٌ وَمِنَّا الجَوهَرُ المُتَخَيَّرُ",4,"ر",1,0],["ومنابرُ الإٍسلام يا ملك الورى","بحلاك وبحليّها تتكلَّلُ",5,"ل",1,0],["ومن أبيكَ تعلَّمت الثباتَ فما","تحتاج تذكُّر أمراً أنتَ تدريه",6,"ي",2,0],["ومن أبى الصدق بعد ما قُمر ال","فضل فمن كل جانبٍ قُمِرَه",7,"ر",2,0],["ومن أبى ما أقول فيك فحي","ياه بموسى قعساء مجتدِع",8,"ع",1,0],["ومن أبَى اللَّهُ أن نُرى أبداً","بعرْضِهِ في مَذمَّةٍ معكا",9,"ك",2,0],["ومنابع القطران وال","كبريت منها تنبعُ",10,"ع",1,0],["وَمِن أَبرَحِ الأَشجانِ إِبراحُ وَجدِنا","عَلى مِعَدٍ مَأفونَةٍ وَفِقاحِ",11,"ح",1,0],["وَمنابِرُ الأَشجارِ قَد قامَت بِها","خُطَباءُ مُفصِحَةٌ مِنَ الأَطيارِ",12,"ر",1,0],["ومن أبطالِها وَهُمُ الضّواري","تَنالُ مخالبُ المُتنمِّرينا",13,"ن",2,0],["ومَنْ أبَى في الرُّزْءِ غَيْرَ الأسَى","كانَ بُكاهُ مُنْتَهَى جُهْدِهِ",14,"د",2,0],["ومن أبادَ الكُفرَ والنِّفاقا","وشَرَّد الفتْنة والشِّقاقا",15,"ق",2,0],["وَمِن أَبي الدَعجاءِ كَالصُؤابِ","وَمِن مُجيبٍ فاتِحِ العِيابِ",16,"ب",1,0],["وَمِنَ ابْتِدَاءِ الدَّهْرِ أَعْلَتْ غُرْبَةٌ","كَلِمَ الثِّقَاتِ عَلَى قُوَى الفُجَّارِ",17,"ر",1,0],["ومَنْ أبصرَ اليامَ خَلْفَ قِناعِهَا","رأى الدَّهرَ يلهو والأمانيّ تكذِبُ",18,"ب",1,0],["ومن أبى ما أقول فيك فحيْ","ياه بموسى قَعْساه مجتدِع",19,"ع",1,0],["ومن ابن خير الله ذي النسب الذي","حفلت به غر من السادات",20,"ت",1,0],["ومن أبى غير المنى حيلةً","أسلمه الحظ إلى العثر",21,"ر",1,0],["وَمَن أَبوهُ عَلِيٌّ لا يُنازِعُهُ","ميراثَ أَحمَدَ باغٍ عَمُّهُ قُثَمُ",22,"م",1,0],["ومن آباء ومن عز ومن شرف","ومن كمالٍ ومن علمٍ ومن أدبِ",23,"ب",1,0],["ومن ابنا جابر كان أولى","فليس بنوه من ابنا الغمام",24,"م",1,0],["ومن ابن أم مشفق حدب","وخليل صدق غير ذي فند",25,"د",1,0],["وَمِنْ إِبْلِيسَ ذِي التَّدْلِي","سِ لاَ تُغْرِي بِنَا أَزَّهْ",26,"ز",2,0],["وَمَنْ أَبْدَى سَنَاكُمْ وَاصْطَفَاكُمْ","فَأَنْهَلَكُمْ بِكَأْسِ الْوُدِّ مَنَّا",27,"ن",2,0],["وَمِنِ ابْنِ زَاكُورٍ سَلاَمٌ عَاطَرٌ","كَالْيَاسَمِينِ يَضُوعُ فِي بُسْتَانِ",28,"ن",1,0],["ومنابت الزقوم يزهر عودها","وثمارها التضليل والتدجيل",29,"ل",1,0],["ومن أبي فذقنه","في عصعصي قد لججا",30,"ج",2,0],["ومن ابدي فرائد عقد نظم","به بهر الزواهر افتقادا",31,"د",2,0],["ومن أبياتِ شعري شدتُ بيتاً","رَفيعاً يَفضَلُ الهرمَ الكبيرا",32,"ر",2,0],["ومن أبطرَتهُ نعمةٌ ظلَّ لاهياً","عن الكَمدِ المُدمي لقلبٍ مكلَّم",33,"م",1,0],["وَمَنِ ابتلاه بطُولِ هِجرته","وجفا عليه فليس في الأَحْيا",34,"ي",2,0],["وَمن أَبو النخبةِ الأعلى مريستهُ","يَرقى العلى دونَ تدريجٍ وتمهيدِ",35,"د",1,0],["وَمَن أَبى إِلّا فَسادَ الوَرى","فَهوَ لِغَيرِ القَتلِ لا يَصلُحُ",36,"ح",1,0],["وَمَن أَبى ذاكَ فَقَد أَساءَ","فَالظِلُّ يَحكي عودَهُ اِستِواءَ",37,"ا",2,0],["ومَنِ ابتنَى وسْطَ العرينِ قبابَهُ","فأحسَّ ريحَ اللَّيثِ قَوَّض ما ابْتَنى",38,"ن",2,0],["ومَن أبَى أن يَستهِلَّ كفُّه","يوماً بجُودِ قاصرٍ لقاصد",39,"د",1,0],["ومن ابنُ أم اللَه أخبرْني ولن","يُدعَى إلهاً فيه ذاتٌ خالقه",40,"ق",2,0],["ومِنْ أَبِيهِمْ أَفادُوا كُلَّ مَكْرُمَةٍ","فهُمْ إِلى المجدِ قد ساروا على السَّنَنِ",41,"ن",1,0],["ومنابِتُ العِزِّ الَّذِي عَمَرَتْ بِهِ","فِي الدهرِ شُمُّ إِكامِها وبِطاحِها",42,"ح",3,0],["ومِنَّا بعدَ هامِدِنا وَزيرٌ","مُلوكُ الأرضِ تخْدِمُهُ قِياما",43,"م",2,0],["وَمَن أَبو جَعرانَ طَبّاخُه","يَكونُ إِلّا تِلكَ أَلوانُه",44,"ه",1,0],["وَمِنّا بَنو ماءِ السَماءِ وَمُنذِرٌ","وَجَفنَةُ مِنّا وَالقُرومُ النَزايِعُ",45,"ع",1,0],["ومَنِ اِبتني الهَرَمين ثمَّ علاهما","بالعَصْب والدّيباج والإستبرقِ",46,"ق",1,0],["وَمِن أَبيضٍ عندَ الضّراب مثلَّمٍ","وَمِن أَسمرٍ عندَ الطّعان مقصّدِ",47,"د",1,0],["ومَنِ ابتَدا بالخيرِ مُنذُ صبائِهِ","فكما نؤرِّخُهُ بخيرٍ يُختَمُ",48,"م",1,0],["ومن أبى نفارق","إن تقبلوا نعانق",49,"ق",1,0],["وَمَن أَباد العِدا في كُل معترك","وَخافَ دَولته الجبار سابور",50,"ر",1,0],["ومن أبوه حاتمٍ","قصَّر عن جودهِ حاتمُ",51,"م",1,0],["ومَنِ ابنُ عمّارٍ أو ابنُ خِصَالِها","ومِنَ العِراقِ مَنِ الرئيس الصَّابِي",52,"ب",2,0],["وَمَنِ اِبتلاهُ ربُّهُ فَمقرَّبٌ","لا مُبعَدٌ مِنهُ وَلا مَهجورُ",53,"ر",1,0],["ومن أبلق بالصبح والغيهب ارتدى","فصار كدر بين مسك ينسم",54,"م",1,0],["ومن أبيض عنّى لنهار أهابه","فخوض أحشاء الظلام يدمدم",54,"م",1,0],["ومن أبطاله كم من مغازٍ","بآلاف ولا يستل موسى",55,"س",2,0],["ومن أبين الخير والمنهج الذي","لسالكه حسن الأمان من الرب",56,"ب",1,0],["ومن إبريز وصفك صغت مدحا","يجل بما حواه عن انتقاد",57,"د",1,0],["ومن أبي المصطفى حماه","في منعة ما لها مبيحُ",58,"ح",1,0],["ومنا بعد ذا الكهان جمعاً","وحكّام الدماء الأولونا",59,"ن",2,0],["ومن أبو مالك دامت سلامته","فيهم تقطّع أمعاء وأوصالُ",60,"ل",1,0],["ومن أبدع الأشياءَ لا عن دلالةٍ","حذاها ولا عونٌ هنالكَ مكتتم",61,"م",1,0],["ومن أباعك ديناراً بأربعةٍ","من الدراهم بيضٍ أفرغت عجبا",62,"ب",2,0],["ومن أبويه أخته فحسابها","إذا كنت ممن يستجيب ويسمعُ",63,"ع",1,0],["ومن أبا في عنا","صَلَّينا عليه",64,"ل",3,0],["وَمن أَبي فَبِحَدِّ المَشرَفِيِّ وَبِال","سُمرِ اللِدانِ وَجُردٍ كَالسَراحينِ",65,"ن",1,0],["وَمِن أَبي حَردَبَةَ الأَثيمِ","وَما لِكٍ وَسَيفِهِ المَسمومِ",66,"م",1,0],["ومن ابتز من قصي هماما","قد سما من ذرى العلى أقصاها",67,"ا",3,0],["ومَنْ اباح لهل الدمنتين دمي","مَا فيه لاَدية منهم ولاَ قوَد",68,"د",1,0],["ومِنْ أبي أحمدٍ في منزلي كرَمٌ","أثنى به حيث مَا سارت به الإِبلِ",69,"ل",1,0],["ومن ابلج وضاح","المحيا مائس الوفره",70,"ر",2,0],["ومن أبيها منعوا ميراثها","ولم تجد في القوم من أغاثها",71,"ه",2,0],["ومن ابوه زكريا الحافظ","محمد على التقى محافظ",72,"ظ",1,0],["ومن أبي لهب الأوصاف قد حملت","في جيدها حبل درٍّ وهو منثور",73,"ر",1,0],["ومَنابِرُ الدّين الحنيفِ زهتْ بهِ","زهْوَ الخِلافةِ بالإمام الأشرفِ",74,"ف",1,0],["ومن أباح له المختار مسجده","ومن أتى مدحه في أشرف الكتب",75,"ب",1,0],["وَمِنّا بَنو العَبّاسِ فَضلاً فَمَن لَكُم","هَلُمّوهُ أَو لا يَنطِقنَ يَمانِ",76,"ن",1,0],["وَمَن أَباحَ الزَمانُ صَفَوَتَهُ","فَلَم يَشُب صَفوَهُ بِتَكديرِ",77,"ر",1,0],["وَمنّا بِأرجاءِ الفَلاةِ زَماجِرٌ","دَوِيَّ هَزيمِ الرَّعدِ في العارِضِ الوَبلِ",78,"ل",1,0],["وَمَن أَبدَأَ النُعمى عَساهُ يُتِمُّها","بِأَلطافِ ذي جَدى مُفاضٍ سِتارُهُ",79,"ر",2,0],["ومن ابتغى البرهان أبيض ناصعا","فليأت بيروتا غداة العيد",80,"د",1,0],["ومن ابتغى وصم الأباة بسؤةٍ","شنعاء يقض زمانه موصوما",81,"م",2,0],["ومن أبو الفيضِ كانَ في العَمُودِ لَهُ","أغناهُ ذلِكَ عن مدحٍ لهُ وكفى",82,"ف",2,0],["ومن ابن سينا حين","قرر ما بنيت له وشيد",83,"د",1,0],["ومن ابن سينا حين هذ","ب ما أتيت به وشيد",84,"د",1,0],["وَمَن أبَى فَسَاقِطٌ فِى هُوَّه","وَمَا بِكَسبٍ تُدركُ النُّبُوَّه",85,"ه",1,0],["ومن أبوه الطلب المرتجي","لدفع خطب قد أماط اللثام",86,"م",1,0],["ومن ابنة العنقود اهرقت الدما","هديا وزمزم بالحجاز المنشد",87,"د",1,0],["ومن آب كان الأوبُ للملك مصلحاً","وأحكم فيهِ الصلح بعد الضغينةِ",88,"ه",1,0],["ومن أبصرت كمه الضباب جماله","وغار على الطرفاء جذع مهينم",89,"م",1,0],["ومن أبطحيٍّ نيطَ عنه نجادُهُ","بجيدِ مُعِمٍّ في العشيرة مُخْوِل",90,"ل",1,0],["ومن أبواهُ وابنُه في قبورهمْ","رُفَاتاً بها صاروا بُعَيْد التَّنَعُّم",91,"م",1,0],["ومَن أبَوَاهُ في التُّرَابِ ووُلْدُه","أينعَمُ عيْشاً أو يطيبُ له مهد",92,"د",1,0],["ومن ابن سينا حين أس","س ما بناه لكم وشيد",93,"د",1,0],["وَمَن أَبعَدَتهُ السابِقاتُ فَإِنَّهُ","لَهُ بَينَ نَبتٍ وَالتُرابِ مَراجِعُ",94,"ع",1,0],["ومن أباريقَ حلمي يستقي شجني","والعمر منسكبُ والوقت ُ أكوابُ",95,"ب",1,0],["ومِن أَبسَطِ الآمَالِ أَدنُو مُزَاحِمًا","فَلا صَعبَها أَلقَى, ولا ما أُبَاسِطُ",96,"ط",1,0],["ومِن أبياتِ أهلِ الخيرِ دَوَّتْ","تهاني حُبِّ رَبَّاتِ الخُدورِ",97,"ر",1,0],["وَمنابِتُ النِسرينِ في أَرْجائهِ","بَعبيرِها الفَجرُ الأنيقُ تَحمَّما",98,"م",2,0],["ومنابر للأصفياء وصفوهم","تبنى من التقدير والعرفان",99,"ن",1,0],["ومنابرُ حيثُ مآذنُها","بالقلبِ تصلي من الوجلِ",100,"ل",1,0],["ومنابعي تهفو إليك وتصطفي","إني لكم متعشقٌ خلٌ وفي!",101,"ف",2,0],["ومنابع النعماء مقفرة","ياليتني في بئرها الدلْوا",102,"و",2,0],["ومنابعُ الأشواقِ جفّ","تْ لنْ تفيضَ لتغمرَكْ",103,"ك",1,0],["ومنابرٍ أصغى الزمان لها","باتت من الأيام كالحلمِ",104,"م",1,0],["ومن ابتساماتِ الطيوفِ بعينها","وبدندنات البشرِ قد غيظَ العمي",105,"م",2,0],["ومن أباليس دار كفر","وملحدين وملحدات",106,"ت",1,0],["ومن ابنه المهدي طال بقاؤه","باق على مر الزمان الباقي",107,"ق",2,0],["وَمِنْ أَبْهَا إِلى نَجْرَانَ سَارٍ","عَلَى جَبَلٍ وَفِي البِيْدِ العِرَاضِ",108,"ض",1,0],["ومنابرُ القُدسِ الشّريفِ تضجَّرَتْ","مِنْ أسْرِهِمْ ومذلّةٍ لِرقابِ",109,"ب",1,0],["وَمِنا بجلق يَشحطوهم عَلى الوَطا","مثل الولايش وَالقُبور خمام",110,"م",1,0],["وَمنا ببر الترك تحت عظامهم","وَمِنا بجلق مات بِأَوشم حال",111,"ل",1,0]]}