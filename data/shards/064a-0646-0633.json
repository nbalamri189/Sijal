ُ","https://www.poetsgate.com/ViewPoem.aspx?id=20751",""],[5652,"ياسعود علمي جاك ..!؟","https://www.poetsgate.com/ViewPoem.aspx?id=177259",""],[5691,"جارة القمر","https://www.poetsgate.com/ViewPoem.aspx?id=205881",""],[5691,"لا ينحني نخل العراق","https://www.poetsgate.com/ViewPoem.aspx?id=207062",""],[5725,"سمراء كالخمر","https://www.poetsgate.com/ViewPoem.aspx?id=194537",""],[5879,"كل النساء","https://www.poetsgate.com/ViewPoem.aspx?id=215463",""],[5897,"على جناح أمنية","https://www.poetsgate.com/ViewPoem.aspx?id=156541",""],[5897,"إيه .. يا جنة الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=176413",""],[5943,"يبكي المسراتِ","https://www.poetsgate.com/ViewPoem.aspx?id=34572",""],[5948,"أحقُّ من أنجزَ موعودَه","https://www.poetsgate.com/ViewPoem.aspx?id=100601",""],[5956,"تحنان للخلد المفقود","https://www.poetsgate.com/ViewPoem.aspx?id=182999",""],[5957,"الحب يا خلّي اقدسهُ","https://www.poetsgate.com/ViewPoem.aspx?id=36267",""],[5969,"من للعيون السارحات سواهُ","https://www.poetsgate.com/ViewPoem.aspx?id=200456",""],[6019,"تلاوةُ حبٍّ في محرابِ الاشتياق","https://www.poetsgate.com/ViewPoem.aspx?id=197104",""],[6075,"( حُلْمٌ رَبِيعِيُّ )","https://www.poetsgate.com/ViewPoem.aspx?id=205254",""],[6097,"عَكّارُنا","https://www.poetsgate.com/ViewPoem.aspx?id=190700",""],[6106,"تحية للمستشارة : د . نهى الصادق الزيني","https://www.poetsgate.com/ViewPoem.aspx?id=6309",""],[6120,"مَن مِنكُمَا الوَرد","https://www.poetsgate.com/ViewPoem.aspx?id=213516",""],[242,"أملى الهنا والسعد ردد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563696",""],[6198,"غمز الشموس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79228&r=&rc=1",""],[6198,"القرط الأزرق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79237&r=&rc=11",""],[6202,"عجز الضعيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86736&r=&rc=37",""],[5957,"أهواك !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82763&r=&rc=147",""],[6225,"إزالة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78009&r=&rc=95",""],[433,"رحلة النيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87052&r=&rc=5",""],[6305,"أجِزْ حَرَامَاً ...!!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87338&r=&rc=11",""],[5126,"فكره","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87793&r=&rc=8",""],[6334,"سيد الأزمان !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82263&r=&rc=13",""],[572,"ومستديرٍ كجرمِ البدرِ مَسْطُوحِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9206&r=&rc=63",""],[6366,"ما لم يقله الرّسّام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86676&r=&rc=4",""]],"verses":[["يَنسى بِها اليَقِظُ المِقدامُ حاجَتَهُ","وَيُصبِحُ المَرءُ فيها مَيِّتَ الخَبَرِ",0,"ر",1,0],["يَنسابُ في الأدْراعِ عامِلُ رُمْحِهِ","كالأَيْمِ يَسبَحُ في غَديرِ الماءِ",1,"ا",2,0],["يَنسَلُّ عَنّي قَمِيصي مِن ضَنى جَسَدي","وَلَو شَدَدتُ عَلى الجِلبابِ أَزراري",2,"ر",2,0],["يَنسى فَيَسكُنُ ما بِهِ وَتَعودُهُ ال","ذِكرى فَيُصرَعُ صَرعَةَ المَجنونِ",3,"ن",1,0],["ينساب مثل انسياب الأيم تحمله","عوامل عجلات من دواليب",4,"ب",1,0],["ينسى الفتى إحسانه فيما مضى","خوف امتنان لا يليق بمحسن",5,"ن",1,1],["ينسى صنيعته ويذكر وعدَهُ","أكرِمْ بذلك من ذَكورٍ ناس",6,"س",1,0],["ينساب جنح الظلام في سَفنٍ","في جِلده المقشعر نشّاش",7,"ش",1,0],["ينساب في وسط الحوا","دث مثلما ينساب أرقم",8,"م",1,0],["ينساب للنور مشغوفا بصورته","منعّما في بديعات الحلى هانى",9,"ن",2,0],["يَنسابُ في النورِ مَشغوفاً بِصورَتِهِ","مُنَعَّماً في بَديعاتِ الحُلى هاني",10,"ن",2,0],["يَنسابُ في مُخضَلَّةٍ مُبتَلَّةٍ","مَنسوجَةٍ مِن سُندُسٍ وَنُضارِ",11,"ر",1,0],["يَنسابُ ما بَينَ الصُخورِ تَمَهُّلاً","وَيَخِفُّ بَينَ الهُوَّتَينِ تَخَطُّرا",12,"ر",2,0],["يُنسونَ حَسّاناً عِصابَةَ جِلَّقٍ","حَتّى يَكادُ بِجِلَّقٍ يَفديكِ",13,"ك",1,0],["يَنسى بِها ما كانَ مِن عُجبِهِ","وَما أَذاقَ المَوتُ مِن كَربِهِ",14,"ب",2,0],["ينساقُ نحوَكَ ما تُرِيدُ بعزمةٍ","ما كدَّها الإِيرادُ والإصدَارُ",15,"ر",1,0],["يُنسيكَ جودَ الغَيثِ جودُهُمُ إِذا","عَثَرَت أَكُفُّهُمُ بِعامٍ مُجدِبِ",16,"ب",1,0],["يَنسى الذُنوبَ وَما تَقادَمَ عَهدُها","مُلقى الضَغائِنِ دارِسُ الأَحقادِ",17,"د",1,0],["يُنسى كِتابُكَ مِن تَقادُمِ عَهدِهِ","وَتَمُرُّ دونَ رَسولِكَ الأَزمانُ",18,"ن",1,0],["يَنسِبُها للعُيونِ رَونَقُها","تَخلُبُ بالحُسنِ من تَردَّاها",19,"ا",3,0],["يَنْسَلُّ بينَ وَشْيِهِ","مثلَ الحُسامِ المُؤتَلِقْ",20,"ق",1,0],["يُنْسيكَ صِبغُ أديمِه الخَمرا","وتُريكَ غُرَّةُ وَجْهِه البَدْرا",21,"ر",2,0],["يَنسى المُلِحُّ عَلى الدُنيا مَنِيَّتَهُ","بِطولِ إِدبارِهِ فيها وَإِقبالِه",22,"ل",2,0],["يَنسَينَ أَصواتَ الحُداةِ وَنَبرَها","طَرَباً لِأَصواتِ الصَدى وَالبومِ",23,"م",1,0],["يَنسابُ فيكَ النيلُ مِلءَ عِنانِهِ","فَالحُسنِ ينبتُ وَالملاحَةُ تَنبُعُ",24,"ع",1,0],["يَنسى أَباهُ وَلَو يُطاوِعهُ الثَرى","لَسَعى إِلى ساداتِهِ مُشتاقا",25,"ق",2,0],["يَنْسَى الإساءَةَ وَهْيَ جُرحٌ بالغٌ","ويعوذُ بالخُلُقِ الكريمِ الزّاكِي",26,"ك",2,0],["يُنسي الوُفودَ سَماحُكُم أَوطانَهُم","وَكَذاكَ طيبُ الوِردِ يُنسي المَصدَرا",27,"ر",2,0],["يَنسَلُّ مِنها لِسانٌ يَستَغيثُ بِهِ","كَما تَعَوَّذَ بِالسَبّابَةِ الفَرِقُ",28,"ق",1,0],["يُنَسّيكَ المُنى نَظَرٌ إِلَيها","وَيَصرِفُ وَجهُها وَجهَ الزَمانِ",29,"ن",1,0],["يَنساخُ في بَطنِ جَيّاشٍ غَوارِبُهُ","تَحتَ السَماءِ سَماءٌ مَوجُها أَشِرُ",30,"ر",1,0],["يَنسى الفَتى الحَربِيُّ في قَبرِهِ","أَيّامَ إِلجامٍ وَإِسراجِ",31,"ج",1,0],["يَنسى الحَوادِثَ أَفتانا وَأَكبَرُنا","وَلَن تُصيبَ فُؤاداً حامِلاً حَزَنا",32,"ن",2,1],["يَنْسجُ الأَحلامَ في قلبي","بِأَضْواءِ الحَيَاهْ",33,"ا",2,0],["يَنْسَى لَهَا الْفَاقِدُ الْمَحْزُونُ لَوْعَتَهُ","وَيَهْتَدِي بِسَنَاهَا كُلُّ قَوَّالِ",34,"ل",1,0],["يَنْسَى بها الْمَوْتُورُ ما في نَفْسِهِ","طَرَبَاً وَيَنزِلُها السَّقِيمُ فَيَبْرَأُ",35,"ر",2,0],["يَنْسَى بهَا كلُّ نائِي الدَارِ مَوْطِنَهُ","وما تَجشَّمَ مِنْ بَيْنٍ وأَسْفَار",36,"ر",1,0],["يُنَسِّقُ علم الأوّلين مُجاهِداً","ولاَ خَيْرَ في عِلْمٍ إذَا لَمْ يُنَسَّقِ",37,"ق",1,0],["يَنسى به المطعونُ فَرْطَ المُنكَرِ","ولو حَكَت عِرْسَ الضَّرير الأبخَرِ",38,"ر",1,0],["ينساب دفْؤُك في الأبدان عافيةً","لا تشتكي السُّقْمَ في نيسانَ أبدان",39,"ن",1,0],["ينسجُ الشعر من زهور الروابي","ويُنَدِّيه بابنة العنقود"