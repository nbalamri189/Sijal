tps://www.aldiwan.net/poem36960.html","مجزوء الكامل"],[514,"كتم الهوى فوشى النحول بسره","https://www.aldiwan.net/poem20801.html","الكامل"],[515,"ما عن هوى الرشأ العذري أعذار","https://www.aldiwan.net/poem12136.html","البسيط"],[538,"كيف المآل إذا تكون الحال","https://www.aldiwan.net/poem47997.html","عموديه"],[538,"شرط العظيم وصفه بالمهتدي","https://www.aldiwan.net/poem48235.html","عموديه"],[541,"لأفرجن اليوم كل الغمم","https://www.aldiwan.net/poem677.html",""],[551,"يا طلل الحي بذات النقا","https://www.aldiwan.net/poem47363.html","السريع"],[551,"دع الهوى يتبعه الأخرق","https://www.aldiwan.net/poem47377.html","السريع"],[551,"يا بأبي من زارني في الدجى","https://www.aldiwan.net/poem47710.html","السريع"],[551,"هل هاج شوقك صوت الطائر الغرد","https://www.aldiwan.net/poem47848.html","البسيط"],[551,"هل عائد ينفع من علتي","https://www.aldiwan.net/poem48029.html","السريع"],[558,"أنا في الملاح على اليقين","https://www.aldiwan.net/poem33819.html","مجزوء الكامل"],[558,"عيني لغير جمالكم لا تنظر","https://www.aldiwan.net/poem34479.html","الكامل"],[558,"لا فرق عندي بين الوتر والوتر","https://www.aldiwan.net/poem34505.html","البسيط"],[562,"لأفئدة النساء هوى جديد","https://www.aldiwan.net/poem52716.html","الوافر"],[563,"يا عاصمي يا سالمي يا قاسمي","https://www.aldiwan.net/poem13606.html","الكامل"],[575,"الصبر بعدك لا يكون","https://www.aldiwan.net/poem2774.html","مجزوء الكامل"],[575,"قلبي يقول لطيف منك يطرقني","https://www.aldiwan.net/poem2997.html","البسيط"],[586,"أنتم لعبدكم أحبه","https://www.aldiwan.net/poem17432.html","مجزوء الكامل"]],"verses":[["لا فَوْتَ عنْ دَرْكِ الحِمامِ لِهارِبٍ","والنّاسُ صَرْعَى مَعْرَكِ الآفاتِ",0,"ت",1,0],["لا فَشَلٌ فِيَّ وَلا سِقاطُ","لَيسَ أَوانَ يُكرَهُ الخِلاطُ",1,"ط",1,1],["لا فَرقَ ما بَينَ بوذِيٍّ يَعيشُ بِهِ","وَمُسلِمٍ وَيَهودِيٍّ وَنَصراني",2,"ي",1,0],["لا فَخرَ فينا وَلا عِمادٌ","وَلا مُعينٌ وَلا كَمالُ",3,"ل",1,0],["لا فَخْرَ أَنْ يَغْلِبَ الأَقْوَى مُنَاضِلَهُ","بَلْ أَنْ يَدِينَ ضَعِيفٌ مِثْلَمَا دِينَا",4,"ن",2,0],["لاَ فَرْقَ فِي ابْنٍ إذَا عُدُّوا وَلاَ ابْنِ أخٍ","وَهَلْ هُمْ غَيْرُ أَنْدَادٍ وَإخْوَانِ",5,"ن",1,0],["لافتضاح العدوّ لا لنجاة","سجد الناس عنك للّه شكرا",6,"ر",2,0],["لا في المَديحِ وَلا الهِجا","ءِ وَلا المُجونِ وَلا اللَعِب",7,"ب",1,0],["لا فُرُحٌ إِن أَصابوا مِن عَدُوِّهِمُ","وَإِن أُصيبوا فَلا خورٌ وَلا جُزُعُ",8,"ع",1,0],["لا فرق عندي بين وصف رضابه","ومدامه إلا الحلالُ الطيب",9,"ب",1,0],["لا في اليسارِ مفاريحٌ إذا بلغوا","غايات مجدٍ ولا في أزْمة جزع",10,"ع",1,0],["لا فضل لي فيها وبحرك قاذف","درر الصفات تقول للخلق انفقوا",11,"ق",3,0],["لا فرقَ بين ضحايا أو عدًى نحرت","فإنَّ أعداه والأنعام سيَّان",12,"ن",1,0],["لا فضْل فيه سِوَى ما أنْت مُفْضِلَهُ","فَشُرْبُ غيرك منْه شُرْبُ تَصْرِيدِ",13,"د",1,0],["لأفنينَّ أفانينَ المديح له","مجاهِراً للأعادي غير مستتر",14,"ر",1,0],["لا فُلَّ حدُّك من حسامٍ صارمٍ","ترك القِراعُ بحدّهِ تفليلا",15,"ل",2,0],["لا في التّجار ولا العُمالِ تنصبُني","وإنني لقليلُ المِثل والبدلِ",16,"ل",1,0],["لا فُقدتْ كفّهُ ولا برحت","ركناً لعافي النوال مستَلما",17,"م",2,0],["لا فتح إلا هكذا ولمثله","فتح الفتوح ببأسه وصرامتِهْ",18,"ت",2,0],["لا فقدناك يا حفيظ حفيظِ ال","مجْد ما لاح في الدجى الفَرقدان",19,"ن",1,0],["لا فلسَ فيه ولا شوكٌ ينغّصُه","كما تكون لشبّوطٍ وبُنِّيّ",20,"ي",1,0],["لا في شَظاها وَلا أَرساغِها عَنَتٌ","وَلا السَنابِكُ أَفناهُنَّ تَقليمُ",21,"م",1,0],["لا فَهَذي وَتِلكَ تَأتي وَتَمضي","كَذَويها وَأَيُّ شَيءٍ يُؤَبَّد",22,"د",1,0],["لا فَضلَ لي إِن رُحتُ أُعلِنُ فَضلَهُم","بِقَصائِدي إِنَّ الضُحى لا يُكتَمُ",23,"م",1,0],["لا فَرقَ عِندَ اللَيلِ بَينَ النَهرِ وَالمُستَنقَعِ","يَخفي اِبتِساماتِ الطَروبِ كَأَدمُعِ المُتَوَجِّعِ",24,"ع",1,0],["لا فُروضاً أَضاعَها","في هَواكُم وَلا سُنَن",25,"ن",1,0],["لا فرد الا والدموع بعينه","رجراجة فكأنما هي زئبق",26,"ق",1,0],["لا فخر في مد السلا","ح الى مقاتل اعزل",27,"ل",1,0],["لا في الجِيادِ وَلا النِياقِ وَإِنَّما","خُلِقَت بِغَيرِ حَوافِرٍ وَخِفافِ",28,"ف",1,0],["لافَيتَ أَعراساً وَلافَت مَأتَماً","كَالشَيخِ يَنعَمُ بِالفَتاةِ وَتُزهَقُ",29,"ق",1,0],["لا فَرقَ بَينَ مُسَلَّطٍ مُتَتَوِّجٍ","وَمُسَلَّطٍ في غَيرِ ثَوبِ مَليكِ",30,"ك",1,0],["لا فاتِكٌ آخَرٌ في مِصرَ نَقصِدُهُ","وَلا لَهُ خَلَفٌ في الناسِ كُلِّهِمِ",31,"م",1,0],["لَأَفحَشَ تَقصيرِ الغَنِيِّ عَنِ العُلا","كَما يَفحَشُ الإِقتارُ بِالحازِمِ الجَلدِ",32,"د",1,0],["لافَضلُكَ المَرجوُّ مِنهُ وَلا","مَعروفُكَ المَعروفُ يَصطَنِعُه",33,"ع",2,0],["لا فَضلُ إِلّا فَضلُ أُمٍّ عَلى اِبنِها","كَفَضلِ أَبي الأَشبالِ عِندَ الفَرَزدَقِ",34,"ق",1,1],["لا فِعلُهُ فِعلٌ وَلَيسَ كَقَولِهِ","قَولٌ وَلَيسَ بِمُفحِشٍ كَزمِ",35,"م",1,0],["لا في نُبُوَّتِهِ كانوا ذَوو وَرَعٍ","ولا رَعوا بَعدَهُ إِلّاً وَلا ذِمَما",36,"م",2,0],["لافَخرَ إِلّا فَخرُ أَهلِ التُقى","غَداً إِذا ضَمَّهُمُ المَحشَرُ",37,"ر",1,0],["لا فُزتُ مِن أَشراكِ حُبِّكِ سالِماً","إِن شُبتُ دَينَ هَواكِ بِالإِشراكِ",38,"ك",1,0],["لا فَرقَ بَينَ شاخِهِ وُعودِهِ","يُحَقِّقُ البُندُقَ في صُعودِهِ",39,"ه",1,0],["لا فَضلَ لي في نِظامي دُرَّ وَصفِكُمُ","بِقيمَةِ الدُرِّ لا بِالسُلكِ يُعتَبَرُ",40,"ر",1,0],["لا فرقَ بين أنينِه ورنينه","وصداه في وادي المنيَّةِ أوضحُ",41,"ح",1,0],["لا فرق بين شَمالها وجنوبها","فهما لقلبي يحملان سلاما",42,"م",2,0],["لا فرقَ ما بين الصباحَ وبينه","إلّا بِعَدْوٍ منه أو تقريبِ",43,"ب",1,0],["لا في رِيامٍ وَلا قُراهُ وَلا","زَبيدِهِ مِثلُهُ وَلا رِمَعِه",44,"ع",2,0],["لا فِي مَوَدَّاتِهِمْ إِذَا صَدَقُوا","رِبْحٌ وَلا فِي فِرَاقِهِمْ غَبَنُ",45,"ن",1,0],["لا في سرورٍ ولهوٍ","ولا صلاحٍ وطاعهْ",46,"ه",1,0],["لا فَخرَ إِلّا قَد عَلاهُ مُحَمَّدٌ","فَإِذا فَخَرتَ بِهِ فَإِنّي أَشهَدُ",47,"د",1,1],["لَأَفصى عِصمَةِ الهُلاّكِ أَفصى","عَلى أَفصى بنِ دَعمَّيٍ بُنينا",48,"ن",2,0],["لافترقت من أجلهِ رِقَّةً","ولم يُرَبِّ البردُ سُقياً سمين",49,"ن",1,0],["لأفلحَ منهم مَن تزكّى وقادَهُ","حوارِيُّ أملاكٍ تَزكّى وأفلحا",50,"ح",2,0],["لا فَرَّجَ اللَهُ عَنّي إِن مَدَدتُ يَدي","إِلَيهِ أَسأَلُهُ مِن حُبِّكَ الفَرَجا",51,"ج",2,0],["لا في السَماءِ وَلا في الأَرضِ مَسلَكُها","وَلا تَقومُ وَلا تَمشي وَلا تَخِدُ",52,"د",1,0],["لا فَجعَ إِلّا كَما فُجِعتُ بِهِ","مِن فارِسٍ كانَ دونَنا حَدِبا",53,"ب",2,1],["لا فَرقَ بَينَ الأَسَكَّ الجَونِ أُطلِقُهُ","وَجَونِ كِندَةَ أَمسى يَعقُدُ التاجا",54,"ج",2,0],["لا فَضلَ يُحباهُ مَخلوقٌ عَلى جِهَةٍ","مِن حالِهِ وَتُساوى النِسرُ وَالمُرَعُ",55,"ع",1,0],["لا فَضلَ لِلقَدَحِ الَّذي اِستَودَعتَهُ","ضَرَباً وَلَكِن فَضلُهُ لِلمودَعِ",56,"ع",1,0],["لا فَرقَ بَينَ بَني فِهرٍ وَغَيرِهِمِ","في دَولَةٍ وَشُهورُ الحِلِّ كَالحَرَمِ",57,"م",1,0],["لا فكر لي عشتُ على فكرتك","أقبس ما أقبس من غُرَّتك",58,"ك",1,0],["لا فما زالا ولا زال الحبيبْ","أيها المفْعِمُ بالحبِّ الوجودا",59,"د",2,0],["لا فتية الرومان في بروجه","ولا غوانيهمْ على مروجه",60,"ه",1,0],["لَأَفُكَّنَّ أَسرَهُم عَن قَريبٍ","مِن أَيادي الأَعداءِ وَالحُسّادِ",61,"د",1,0],["لا فِي سَرَنْدِيبَ لِي إِلْفٌ أُجَاذِبُهُ","فَضْلَ الْحَدِيثِ وَلا خِلٌّ فَيَرْعَى لِي",62,"ي",1,0],["لا فَارِسَ الْيَوْمَ يَحْمِي السَّرْحَ بِالْوَادِي","طَاحَ الرَّدَى بِشِهَابِ الْحَرْبِ وَالنَّادِي",63,"ي",1,1],["لا فِي سَرَنْدِيبَ لِي خِلٌّ أَلُوذُ بِهِ","وَلا أَنِيسٌ سِوَى هَمِّي وَإِطْرَاقِي",64,"ي",1,0],["لا فِي سَرَنْدِيبَ خِلٌّ أَسْتَعِينُ بِهِ","عَلَى الْهُمومِ إِذَا هَاجَتْ وَلا رَاعِي",65,"ي",1,0],["لاَ فِي ربِيعِ الخَيْر تُرْجَى وَلاَ","تَقْشَعُهَا قاشِعَةُ الصَّيفِ",66,"ف",1,0],["لاَ فَرقَ بَيْنَ كَبِيرِهَا","وَصَغِيرِهَا فِيمَا يَنُوبُ",67,"ب",1,0],["لاَ فِعْلَ يُخْطِيءُ فِيهِ الْخَيْرِ بَعْضُهُمَا","إِلا تَدَارَكَهُ الثَّانِي بِتَسْدِيدِ",68,"د",1,0],["لاَ فرْقَ بَيْنَ دَقِيقَةٍ وَجَلِيلَةٍ","مِمَّا بِأَحْوَالِ الحَيَاةِ عَنَاكَا",69,"ك",2,0],["لا فَضلَ إِلاَّ فَضلُهُم فِيمَا انْتَهَي","أَمُر البِلاَدِ بَعْدَ عَنَاءِ",70,"ا",2,0],["لا فالريال مزيف ...أمزيف؟","صاحت وقد سقطت من الإرهاق",71,"ق",1,0],["لا فَرِحَت كُلُّ طِفلَةٍ كَحُلَت","بَعدَكَ عَيناً وَزُرّقت صَدغا",72,"غ",2,0],["لا في ملامحِ وجههِ","بل في توَفُّرهِ ودابه",73,"ب",2,0],["لا فضل فيه للخيال ووحيه","بل أنت رب الفضل في أبياته",74,"ت",2,0],["لا فتية مُرْدٌ بأيد بضَّة","في كل يوم يلبسون قشيبا",75,"ب",2,0],["لا فضول يرتئي لا خبر","خيفة كالأمن أمن كالمخافه",76,"ف",2,0],["لا فَضْلُكَ المَوْجُودُ منه، وَلا","مَعْرُوفُكَ المَعرُوفُ يَصْطَنِعُهْ",77,"ع",2,0],["لا في المديحِ ولا الهجاءِ","ءِ وَلا المُجُونِ وَلا اللّع