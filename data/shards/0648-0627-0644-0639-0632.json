ما","https://www.poetsgate.com/ViewPoem.aspx?id=200272",""],[5302,"يا خادم الحرمين","https://www.poetsgate.com/ViewPoem.aspx?id=200944",""],[5343,"بوارق النصر","https://www.poetsgate.com/ViewPoem.aspx?id=132673",""],[5376,"بغداد إن ضحكت فيها نواجذها","https://www.poetsgate.com/ViewPoem.aspx?id=188304",""],[5431,"فحياتي تنيرها حواءُ","https://www.poetsgate.com/ViewPoem.aspx?id=196821",""],[5490,"غفلة العمر","https://www.poetsgate.com/ViewPoem.aspx?id=176296",""],[5573,"الله وكيلي","https://www.poetsgate.com/ViewPoem.aspx?id=200181",""],[5648,"العلم مده والصدر هات مافيه","https://www.poetsgate.com/ViewPoem.aspx?id=156417",""],[5830,"وَ حََقّاً إِنَّنِي خَجِلُ","https://www.poetsgate.com/ViewPoem.aspx?id=200773",""],[5847,"المولد النبوي الشريف لعام 1435 ه","https://www.poetsgate.com/ViewPoem.aspx?id=176834",""],[5848,"سرحان عبدالصبور","https://www.poetsgate.com/ViewPoem.aspx?id=53460",""],[5936,"ثمان وثمان","https://www.poetsgate.com/ViewPoem.aspx?id=184818",""],[6097,"روح الحبّ قدسية","https://www.poetsgate.com/ViewPoem.aspx?id=190699",""],[6213,"نبراس أمتنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76308&r=&rc=56",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""]],"verses":[["وَالعَزمُ في غَيرِ وَقتِ العَزمِ مَعجَزَةٌ","وَالإِزدِيادُ بِغَيرِ العَقلِ نُقصانُ",0,"ن",1,0],["وَالعَزمُ يَطرَحُني بِكُلِّ مَفازَةٍ","مُتَشابِهٍ فيها زُبىً وَغَوارِبُ",1,"ب",1,0],["وَالعَزْمُ يُوقِظُ داعِي الحَزْمِ نائِمهُ","وَهَل تَدورُ الرَّحَى إلا على القُطُبِ",2,"ب",1,0],["والعِزُّ يُلحِفُني وشائِعَ بُرْدِهِ","حَلَقُ الدِّلاصِ وصارِمي والأشْقَرُ",3,"ر",1,0],["والعِزُّ مُقتَبَلٌ بحيثُ صَريرُها","وصَليلُ سَيفِكَ والجَوادُ الصّاهِلُ",4,"ل",1,0],["والعَزْمُ يفْترعُ النّجومَ بناؤهُ","مهْما أقامَ علَى التُّقى تأسيسا",5,"س",2,0],["وَالْعَزْمُ وَارٍ فِي الْحَفِيظَةِ زَنْدُهُ","وَالرَّأَيُ مَشحُوذُ الْغَرِار صَقِيلُ",6,"ل",1,0],["والعزْمُ بادٍ وصُنْعُ اللهِ مُرْتَقَبٌ","والفَتْحُ مُنْتَظَرٌ إنْ لمْ يَحِنْ فَقَدِ",7,"د",1,0],["وَالْعَزْمُ بَيْنَ الْمَقْصَدَيْن مُرَدَّدٌ","وَالْقَلْبُ بَيْنَ الْحَالَتَيْنِ مُذبْذَبُ",8,"ب",1,0],["وَالعِزُّ عَبدُ الرَحيمِ سَيِّدُنا","مُطَيلَسٌ لِلقَضاءِ بِالشربِ",9,"ب",1,0],["وَالْعِزُّ وَالْجَاهُ فِي هَذَا الحِمَى أَبَداً","بِكُمْ جَدِيدَانِ مَا كَرَّ الْجَدِيدَانِ",10,"ن",1,0],["والعز مجلوب بكلِّ كتيبةٍ","والنصر معقود بكلِّ لواءِ",11,"ا",2,0],["وَالعِزُّ مَضروبُ السُرا","دِقِ وَالقِبابِ لِجارِيَه",12,"ي",2,0],["والعزل في العام له روعة","فكيف في اليوم وفي الثاني",13,"ي",1,0],["والعزّ أبقى ما تراه لمكرم","إكرامُهُ لمروءَةٍ أو دينِ",14,"ن",1,0],["وَالعِزُّ في الثَروَةِ وَالعَيشُ في ال","حَبرَةِ وَالحِرفَةُ في المِحبَرَه",15,"ر",2,0],["وَالعِزُّ يُنقَلُ عَن ناسٍ لِغَيرِهِمُ","وَالأُسدُ تَعدو وَفي آذانِها فَرَكُ",16,"ك",1,0],["والعزّ والشرف الرفيع وذى الحِجى","والعدلٍ والمعروف والأحكامِ",17,"م",1,0],["وَالعِزُّ لا يَبقى لَغَيرِ مُعَوَّدٍ","أَن يَكشِفَ الغَمّاءَ بِالغَمّاءِ",18,"ا",2,0],["وَالعَزمُ إِلّا ما عَزَمتَ مُفَلَّلٌ","وَالمُلكُ إِلّا ما حَفِظتَ مُضَيَّعُ",19,"ع",1,0],["وَالعِزُّ حَيثُ تَرى الدِماءَ مُراقَةً","تَروي الثَرى وَالسَمهَرِيَّ مُحَطَّما",20,"م",2,0],["وَالعَزمُ ما تَرَكَ الحديدَ مُفَلّلاً","وَالخَيلَ حَسرى وَالوَشيجَ مُقَصَّدا",21,"د",2,0],["والعزم من آلاتِه والحزم من","أدواته والشكر من أَقْواته",22,"ت",2,0],["والعز والسعد في رأيٍ تشير به","وأنت من حادثاتِ الدهر في حَرَمِ",23,"م",1,0],["والعزمِ والحزمِ والآراءِ صائبةً","والعلمِ والحلمِ والتوفيقِ والشِّيَم",24,"م",1,0],["والعزُّ معقودُ الحُبا أقْعَسٌ","والبأسُ مطرورُ الشَّبا مُغْضَبُ",25,"ب",1,0],["والعزُّ ليس براضٍ عن عُلاَ مَلِكٍ","ما لم تُعِنْه سيوفُ الهند بالقُضُب",26,"ب",1,0],["والعز جنتنا وروح حياتنا","من دونه أضحى العراق قتيلا",27,"ل",2,0],["والعزم بي قد جد يا سيدي","في شهرنا الأدنى على طهره",28,"ر",2,0],["وَالعز طود منيع لا يحل به","الا نزيل حمى أسد واشبال",29,"ل",1,0],["والعزم والحزم لا ينجي من القدر","سلم هديت لماضي الحكم واصطبر",30,"ر",1,0],["وَالعِزُّ مِنكِ وَذُلّي فيكِ قَد ضَمِنّا","بِاليَأسِ مِن طَمَعي بِالوَصلِ إِهلاكي",31,"ك",2,0],["والعزماتُ الحُمر لونُ الردى","كامنةٌ في الشيم الخُضرِ",32,"ر",1,0],["والعزّ أطرافُ الأسنة والقنا","يوم الوغى وعجاجة شهباء",33,"ا",2,0],["والعزّ ما أفاده","هجرُ الجدارِ والفِرقْ",34,"ق",1,0],["والعِزَّةِ القَعْساءِ عند ال","خوْفِ والصَّدْرِ الوَسِيعِ",35,"ع",1,0],["والعَزمُ ما جاراهُ في","كمْ سابقٌ إِلاَّ سَبَقْ",36,"ق",1,0],["والعزُّ في كلّ الرجال ولم يُنَلْ","عزٌّ بلا نَصَبٍ ولا تكليفِ",37,"ف",1,0],["والعزُّ كلُّ العزِّ في الد","دُنيا لطَيّانٍ خفيفِ",38,"ف",1,0],["والعزم والحزم والاحسان شيمته","والجمع للحق والايفاء بالذمم",39,"م",1,0],["والعزِيزُ الَّذِي إِذا عزَّه المِق","دارُ وهو الأَغَرُّ صارَ الأَذلا",40,"ل",2,0],["والعَزمَةُ القَدَرُ الذي لَو صادَمَت","رَضوى تَصايَحَ جانِباهُ صُدُوعا",41,"ع",2,0],["وَالعَزلُ يَأتيهِ وَالنعمى تُفارقُه","وَالأَمر بِالطرد لا يُرجى تلافيه",42,"ف",3,0],["وَالعَزيزي لَهُ بصدرك نُورٌ","مستعار مِن نُور وَجه الإِمامه",43,"م",2,0],["وَالعز الدائم وَالدَولهْ","في مَصرَ عَساكرُهُ حَولَهْ",44,"ه",1,0],["والعزل بالملك الظلوم أحق من","حكم يعيب فتوحه ويشين",45,"ن",1,0],["والعزمُ من أوصافنا أهلاً به","من قائم بالحزم حق قيامه",46,"م",2,0],["والعز منك فكيف يَل","قى الذل من لك يأمُلُ",47,"ل",1,0],["والعز يحصل بالأسنّة والظُبا","والمجد لم يدرك بعزم واهي",48,"ي",1,0],["والعِز يُطلبُ والدّناءةُ تُعتَزل","رمت المعالي فامتنعْنَ ولم يزل",49,"ل",1,0],["والعزم ماض والفعا","ل مهذب والرأى محصد",50,"د",1,0],["والعز ليس يحل في أوطانه","حتى يحل المال دار هوان",51,"ن",1,0],["والعزُّ ذلٌّ والسَّعادَةُ شَقوةٌ","واليُسرُ عُسْرٌ والبَقاء فَناءُ",52,"ا",2,0],["وَالعِزُّ دانِيَةٌ إِلَيكَ قُطوفُهُ","بِالمُشتَهى وَمَسَرَّةٍ غَضّاءِ",53,"ا",2,0],["والعز دام مقيماً في سعيد حمى","بناؤه ارّخوا بالغرفتين حلا",54,"ل",2,0],["والعزيز القدير واسى بعونٍ","فيه قد نلت للديار وصولا",55,"ل",2,0],["والعز كم قد فاق فيك وجُلّ مذ","بمنير طالعك السعيد قد اقترنْ",56,"ن",1,0],["والعزُّ يلزم كلّ صهوة صاهل","والذلُّ أجمع في ركوب الشُّحَّج",57,"ج",1,0],["والعزيز المنيع من نصرة اللّه","أقامته في محال التولي",58,"ل",2,0],["والعزيز المنيع من مت ذا الع","زة والكبرياء منك بحبل",58,"ل",1,0],["والعزُّ والباسُ في الحدّان إنّهمُ","أهلُ البسالَةِ من مُرد ومن شيبِ",59,"ب",1,0],["والعزُّ والفضل في ذرى سَمَدٍ","لآل نبهان هكذا خُلقوُا",60,"ق",3,0],["والعزُّ لا يسْلكُهُ","والمجدُ لا يُدرْكُهُ",61,"ه",1,0],["والعزُّ عنه يذبُّ ما لا","يذبّه الفارس المشيحُ",62,"ح",1,0],["وَالعِزَّةُ القَعساءُ يلمَعُ دونَها","بيضُ الصَوارِمِ وَالوَشيجُ الذابِلُ",63,"ل",1,0],["والعز كل العز في أمة","تحمى حماها بعوالي الرماح",64,"ح",1,0],["وَالعِزُّ مارَدَّ المُعِزُّ بِسَيفِهِ","مِن بَعدِ ما ذَهَبَت بِهِ الأَحقابُ",65,"ب",1,0],["وَالعِزُّ يُوجَدُ في شَيئَينِ مَوطِنُهُ","إِمّا شَباةُ حُسامٍ أَو شَبا قَلَمِ",66,"م",1,0],["والعَزْمُ والمَجْدُ لا يُرْجَى اجْتِماعُهما","إِلا إِذا اجتمع الإِقْدامُ والكَرَمُ",67,"م",1,0],["والعزُّ أشرف ظل يَسْتَظِلُّ به","فتىً إلى الذُّلِّ لا تخطو به قدم",68,"م",1,0],["والعزم لو رام غزو أفقٍ","بزّ سِماكاً وصاد نَسْرا",69,"ر",2,0],["وَالعزلُ وَالإبقاءُ مَرجِعُهُ إلَى السُّ","لطَانِ دُونَ رَعِيَّةِ السُّلطَانِ",70,"ن",1,0],["وَالعَزلُ وَالإبقَاءُ مَرجِعُهُ إلَى ال","آرَاءِ عِندَكُمُ بِلاَ كِتمَانِ",70,"ن",1,0],["والعزُّ فيهِ قد نما","والبشرُ فيهِ ظاهرُ",71,"ر",1,0],["والعز لا يحويه كفّ في غد","إلا بوضع السيف فوق القمحد",72,"د",1,0],["والعز قال مؤرخاً","حسن العذار زها بأسعد",73,"د",1,0],["والعز ناداه أن كن للعلى كفؤاً","فقد دعتك إليها دمية القصر",74,"ر",1,0],["والعز وافانا بنجل سما","إذ لحظه نحو المعالي يشير",75,"ر",1,0],["وَالعَزمُ في الرُّوحِ حَقٌّ لَيسَ يُنكرُهُ","عَزمُ السَّواعدِ شاءَ النّاسُ أَم نكرُوا",76,"ر",3,0],["والعز في الإقبال قال مؤرخاً","من خير عيدك صالح الأعمال",77,"ل",1,0],["والعز بالإسعاد قال مؤرخا","عيدي سعيد ثابت في عوده",78,"ه",1,0],["والعز ينزل منهم متبوئاً","بيتاً اشم على اشم عماج",79,"ج",1,0],["والعَزْم به ليبَال تِنقَضّ","مَا يِبقَى فوق الأَرضْ جَلْمود",80,"د",1,0],["والعزُّ فِي مَثْواك أضحى راتعاً","وَعَلَى حصونك تُنشَر الأعلام",81,"م",1,0],["والعز بالخير للتوفيق أرخها","أكرم بها لحية نعم الأمير علي",82,"ل",2,0],["والعز قال مؤرخاً","دام الرضى أبداً بسعدك",83,"ك",1,0],["والعز قال أرخوا","أسوارُ عكّا فُتِحت",84,"ت",1,0],["وَالعز بِالإِقبال يَجلو غُرّة","يَزهو بِها وَجه الهَناء المُسفر",85,"ر",1,0],["والعزة الشَّمَّاء إلا أنها","كالشاهق المخضر لا كالجلمد",86,"د",1,0],["والعزمُ إن لم يكن يقيمه عملٌ","فإنه كالهباء سار منتزعِ",87,"ع",1,0],["والعز طورا بالحسام وتارة","بمهند من رأي كل مهذب",88,"ب",1,0],["وَالعِزُّ ما اِقتَطَفَت أَبهى أَزاهِرَه","مِن بَينِ شَوكِ القَنا بيضِ الظَبابيدِ",89,"د",1,0],["والعز ليس بكثرة أو قلة","ليس الكثير مفرقاً بكثير",90,"ر",1,0],["والعزُّ والهونُ مجزومٌ زوالهما","ما حَلَّ أَمرٌ وما حَلَّت نهايتُهُ",91,"ت",2,0],["والعز عند رسيم الأينق الذلل","إن كنت تكره في الراحات عاجلة",92,"ه",1,0],["والعز يوما ويوما رفعة وعلا","والذي يوما ويوما رتبة السفل",93,"ل",1,0],["والعز دأباً بلا تعبٍ ولا طلبٍ","على نعيمٍ وتسلو عن بلا سقر",94,"ر",1,0],["وَالعِزُّ أَفضَلُ ثَروَةٍ يَرِثُونَها","وَلَو انَّهُم في ثَروَةِ الفُقَراءِ",95,"ا",2,0],["والعز أجمعُه تقوى الإله إذا","لو لستَ تملك أموالاً ولا ولدا",96,"د",2,0],["والعز وافى مقبلاً","والذل ولّى مدبِرا",97,"ر",2,0],["وَالعزّ فيهم قديماً غير مقترفٍ","وَالجار فَاِعلم عزيزاً داره بهمِ",98,"م",1,0],["والعزّ حرٍّ عشعشت فوقه البوم","والذلّ بوم وفالشواهيق حوّام",99,"م",1,0],["والعزّةُ وهمٌ معقودٌ","برباط النعْش علاهُ دمُ",100,"م",1,0],["والعزمُ أَسلحتي والحبُّ أَشرعتي","والحظُّ لي سفنٌ تغْدو بإِخفاقي",101,"ق",2,0],["والعزة فيني تمنعن تقول مالك به نصيب","والشوق يشكي لهفتي لأجل الحنين يعاركه",102,"ك",2,0],["والعز منه توسدت النقا والشفة","وصغت معنى الصراحة في السماء لامعة",103,"ع",2,0],["وُالْعِزَّةُ مِنْكَ نُعَانِقُهَا","كَانَتْ للْشَعَبِ تُبَصِّرُهُ",104,"ه",1,0],["والعزّ دارك وهي دار إقامةٍ","والله جارك وهو نعم الجار",105,"ر",1,0],["والعز ما في عقدها تحقيقه","يوما، وإن أغرى، ولا بسوارها",106,"ر",3,0],["والعزم سيف صارم","والحلم أوزن من جبل",107,"ل",1,0],["والعزم في بتر الفساد وأنت من","لا يرتضيه بقائد ومقود",108,"د",1,0],["والعز سيل متى ما هاج قُّدَّ به","ظلم ودابر قوم حكمَه شرعوا",109,"ع",3,0],["والعز في كف أهل المجد حين يُرى","سيف يداوي الذي لم يُرضه الورعُ",109,"ع",1,0],["والعزمُ آسرُها والظلمُ هاجرُها","ما نالَ هامتَها بالضربِ جلادُ",110,"د",1,0],["والعزيزات دربهن افتخارٌ","يتربى بنبلهنّ الإباء",111,"ا",2,0],["والعزم