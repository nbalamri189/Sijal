oem.aspx?id=204774",""],[5413,"طوبى لأيام مررنَ!","https://www.poetsgate.com/ViewPoem.aspx?id=200616",""],[5431,"مهجة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=205811",""],[5636,"تأمّلات","https://www.poetsgate.com/ViewPoem.aspx?id=207340",""],[5847,"في ظلال ميلاد النبي محمد صلى الله عليه وسلم 1431","https://www.poetsgate.com/ViewPoem.aspx?id=52777",""],[5910,"بردة الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=208729",""],[5956,"أحلام شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=183354",""],[5956,"الدين نبع الإنسانية","https://www.poetsgate.com/ViewPoem.aspx?id=192508",""],[5956,"الثلاثي المثالي","https://www.poetsgate.com/ViewPoem.aspx?id=193163",""],[5956,"هل يعرف التاريخ مثل فتايا؟","https://www.poetsgate.com/ViewPoem.aspx?id=193202",""],[5956,"ما درَّ شعري هكذا لسواكما","https://www.poetsgate.com/ViewPoem.aspx?id=193703",""],[5956,"يا ليتني أشفيك من كل الضنا","https://www.poetsgate.com/ViewPoem.aspx?id=194650",""],[5956,"الأديان نبعُ الإنسانية","https://www.poetsgate.com/ViewPoem.aspx?id=194896",""],[5956,"أرجو إله الناس يجمعني به","https://www.poetsgate.com/ViewPoem.aspx?id=207523",""],[5956,"ثلاث قصائد لصديق","https://www.poetsgate.com/ViewPoem.aspx?id=207975",""],[5997,"عِلْمُ الْبَيَاْن","https://www.poetsgate.com/ViewPoem.aspx?id=214993",""],[4442,"خير الصحائف ما يفوح شذاه","https://www.poetsgate.com/ViewPoem.aspx?id=171206",""],[6152,"الشمائل المحمدية","https://www.poetsgate.com/ViewPoem.aspx?id=203758",""],[520,"إن قلت قد خرست خلاخل ساقها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577590",""],[6247,"بطاقة عيد إلى أمتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80270&r=&rc=9",""],[454,"اللغة العربية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82687&r=&rc=51",""],[6318,"مهرجان القصيد (1)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66156&r=&rc=6",""],[5190,"لا تسألي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85040&r=&rc=115",""]],"verses":[["هُوَ رُكنُ مَملَكَةٍ وَحائِطُ دَولَةٍ","وَقَريعُ شَهباءٍ وَكَبشُ نِطاحِ",0,"ح",1,0],["هُوَ رَبّي وَحَسبِيَ اللَهُ رَبّي","فَلَنِعمَ المَولى وَنِعمَ النَصيرُ",1,"ر",1,0],["هو روحي الذي يحاكيك في البأ","س ولكن يؤوده عبء جسمي",2,"ي",1,0],["هو روحي الذي يحاكيك يا بح","ر ويخشى قلبي الجزوع أذاكا",2,"ك",2,0],["هو رَبُّنا إن نالنا رِضوانُه","فلنا المثوبةُ والجزاءُ الأكملُ",3,"ل",1,0],["هُوَ راكِبُ الجَمَل الَّذي سَقَطَتْ بهِ","أصْنامُ بابِلَ قد أتاكَ دَلِيلا",4,"ل",2,0],["هو رُوحٌ يملأُ الشرقَ نشيدا","ويناديكَ ولا يألو وعِيدا",5,"د",2,0],["هُوَ رَأْسُ الْعَامِ قَدْ أَقَ","بَلَ مَيْمُوناً حَمِيدا",6,"د",2,0],["هُوَ رَأْسُ العِلْمِ قَدْ أَقْ","بَلَ مَيْمُوناً حَمِيدا",6,"د",2,0],["هو روحهم محراب جند قلوبهم","وبذروة الاجلال ما اعلاه",7,"ا",2,0],["هو ركن ظهري في الحياة وفي غد","والصالحون أولوا الهدى شفعاء",8,"ا",2,0],["هو رحمةٌ للعالمين ونعمةً","تصلو بفضل سائر النعماء",9,"ا",2,0],["هو رَبُّ العلى أبو العرب الزا","كي لقدْ جلَّ قدرُه أن يُضَاهى",10,"ا",3,0],["هوَ رَبُّ الندَى أبو العرب السا","مى عَلا الخلْقِ في البرية خُلْقَا",11,"ق",2,0],["هو ربُّ الإعطاءِ والشرفِ الما","جد والعدل والندَى والخيرِ",12,"ر",1,0],["هو ربُّ الندى وربُّ الأيادي","الغُرِّ مرهوبةُ الظبا غاراتُه",13,"ت",2,0],["هو رائقُ الآفاقِ تجرى تحته","الأنهارُ وهو بساكنيه حبيبُ",14,"ب",1,0],["هو رحمةُ اللهِ التي أحيا بها الْ","ثَقَليْنِ حتى الجودَ والإيمانا",15,"ن",2,0],["هوَ ربّي وَأَنت في الخلقِ حَسبي","جلَّ دائي وقَد تعاظمَ ذَنبي",16,"ي",1,0],["هو روعة الخلق الجمي","ل ازدانَ بالخلقِ القويم",17,"م",1,0],["هو روضة العليا وبهجة دوحها","لمن اجتنى روض المعالي واجتلى",18,"ل",2,0],["هو روضة العليا ومطلب دوحها","كنز به للطالبين مرام",19,"م",1,0],["هُو رَمز لِقَلب مَريَم رَمز","لِغَرامٍ رَأى الحَياةَ سآما",20,"م",2,0],["هو روحُ من السَماءِ اِستَمَدَّت","حِكمَةَ الفَنِّ من دِماغِ السَماءِ",21,"ا",2,0],["هو روح الخَليل في النجمَة الزه","راء تَمتَصُّ عُنصر الزَهراءِ",21,"ا",2,0],["هو روضة أُنُفٌ تفيدك أخضرا","طَوْراً وطَوْراً أحمرا أو أصفرا",22,"ر",2,0],["هُوَ رَحمَةٌ لِلنّاسِ مُهداة فَمن","قَبل الهِدايَةَ فازَ بِالرّضوانِ",23,"ن",1,0],["هو روح الأرواح من قوّة الحا","ل به حيث يستمدّ الغناء",24,"ا",2,0],["هو رحمتنا العظمى وسرا","جُ الكون ومقتبس السرج",25,"ج",1,0],["هُوَ رَوضَةٌ لَكِنَّها عِندي حِمىً","وَسِوايَ أُهملَ فيهِ فَهوَ مُباحُ",26,"ح",1,0],["هو ربنا هو حسبنا والوكيل","ندعوه نسأل منه حسن الختام",27,"م",1,0],["هو رب الأولينا","هو رب الآخرينا",28,"ن",2,0],["هو ربي هو حسبي","هو خير الرازقينا",28,"ن",2,0],["هو روح مجسدٌ روحه الله","وفكر عقل هويّه إسراء",29,"ا",2,0],["هُوَ رَحمَة ما البَحر إِلّا قَطرة","في جَنب أَيسَر غَيثِها المَسجوم",30,"م",1,0],["هو ربّ الكَرم المحضِ الَّذي","لا يرى الإقلال يوم الجود عذرا",31,"ر",2,0],["هو رحمةٌ نزلتْ على أخياره","وهو الخيار المصطفى لخياره",32,"ر",2,0],["هو ركنُ المجد مَبنى فخره","لا وَهَتْ أركان هاتيك المباني",33,"ن",2,0],["هو رحمةٌ للعالمين ورأفةٌ","وهو البشير لخلقه والمنذر",34,"ر",1,0],["هُو راتِبٌ قد كُنْتُ أَرْقُبُ نَجْمَهُ","فَهَوَى وقد جَعَلَ التُّقلُّقَ راتِبي",35,"ب",2,0],["هو روضةٌ حاشاكَ أنْ","تذوي وساقِيها عِهادُك",36,"ك",1,0],["هو روح الملك الإمامي إذ بال","روح تم البقاء للأجساد",37,"د",1,0],["هو روح العرب من يحفظه","حفظ الروح بها والجسدا",38,"د",2,0],["هو روحي الذي يثور على","الظلم ويأبى الخنوع والتسليما",39,"م",2,0],["هو رائد الآتي ونفحة أمسنا","والثار العاتي على تسليمنا",40,"ن",2,0],["هو رجعُ أشواقي إليكَ تُعيده","شعراً على النسمات جدَّ مؤلفِ",41,"ف",1,0],["هو رفعوا سمك العلى وسماكه","فطال وكم مدت له كف هادم",42,"م",1,0],["هو رحمة في بطنها","اتصسلت بها لا تقطع",43,"ع",1,0],["هو روحي وروحُ معنى فُتوحي","واخْتِتامي وفي الشُؤُنِ افْتِتاحي",44,"ح",2,0],["هو رحلة الدنيا التي عقدت له","فوق الهدى ما انحل من أصفاقها",45,"ق",3,0],["هُوَ رُزءٌ ولا أقولُ عظيمُ","وافتِقادُ البَنِينِ آعظمُ رُزءِ",46,"ا",1,1],["هو راضٍ بَعدَ أنْ لم","يرضَ ما دون القليلِ",47,"ل",1,0],["هُوَ رُكنُ بيتِ الرَّعدِ وَهْوَ عَمُودُهُ","فيهِ الجَلالُ بجانبِ التَّقوَى ثَوَى",48,"و",2,0],["هُوَ راجِحُ العَقلِ الَّذي مِن عَقلِهِ","وَثَباتِهِ بِنتَ الحَصافَةِ مَعقِلا",49,"ل",2,0],["هو روضة الأَدب الَّتي ما بينها","ماء الفصاحة لم يزل يترقرق",50,"ق",1,0],["هوَ رَحمَةٌ لِلناسِ مُهداةٌ فَيا","وَيحَ المعانِدِ إِنَّهُ لا يرحَمُ",51,"م",1,0],["هوَ رُمحٌ سِنانُهُ مِن تَثنٍّ","كَم تَفانَت إِذ يَنثَني الشَّجعانُ",52,"ن",1,0],["هوَ رَوضٌ مِنَ الجنانِ فَسيحٌ","مُزهِرٌ بِالرّضوانِ وَالتكريمِ",53,"م",1,0],["هُوَ روحُ الفَضلِ عين الصّلحا","بَهجة النّفسِ سُرور الأعينِ",54,"ن",1,0],["هوَ رَبُّنا مَن ْذا يُخالِفُ رَبَّهُ","هوَ مَهْبِط ُالتِيجان ِوالنُعمَاءِ",55,"ا",2,0],["هو رَبعُ سلمى أسلمت قلبي لَه","نظراتُ ألفحاظ الظباء الغيد",56,"د",1,0],["هو روض في فلك فترى","غصناً غضاً وترى قمرا",57,"ر",2,0],["هُوَ رافِعٌ عَلَمَ الهُدى وَمَنارهُ","وَمُشَيِّدُ الأَبياتِ ذاتِ عِمادِ",58,"د",1,0],["هو رحمة للعالمين","به صباح اللطف سافر",59,"ر",1,0],["هو رب الجفان مثل الجوابي","وقدر مثل السحاب الجون",60,"ن",1,0],["هو رحمه الرب الكريم وشافع","عند المعاطب واشتدد المرجف",61,"ف",1,0],["هُوَ رَوضة الفَضل الَّتي أَفنانَها","بِالهَدي تَطلع كُل نجم زاهر",62,"ر",1,0],["هو روح توحيدي وعين حقيقتي","وكمال معرفتي وعصمة ديني",63,"ن",2,0],["هو روضُ النُهى وقد جعلَ اللهُ","له منكَ رائقُ البشرِ طَلاّ",64,"ل",2,0],["هو روضةٌ الأيدي العوا","ملِ في الرّقيّ وفي المفاخرْ",65,"ر",1,0],["هو ريم الفلاة لحظاً وجيداً","والتفاتاً وورد نعمان خدا",66,"د",2,0],["هُوَ روحٌ ذابَت أَسىً فَاِستَحالَت","عَبَراتٍ بَينَ الجُفونِ الكَحيلَه",67,"ل",2,0],["هو رام انتشارها كل دهر","وبنوه بمقتداها تراها",68,"ا",3,0],["هو روحُ أرواح اللطائف شمسُها","هو مجمَعُ البَحرين باهي المشَهد",69,"د",1,0],["هو رب السماء يشقى ويقهر","ويعاني نزع الحمام الأحمر",70,"ر",1,0],["هو روعةُ الأهواءِ في سكراتها","وقرارةُ الاهوالِ في الألباب",71,"ب",1,0],["هو رمزٌ فارسيٌّ غامضٌ","وهو نصٌّ عند شخصٍ علوي",72,"و",2,0],["هو رحمةٌ للعالمين وملجأ","للقاصدين بكل ما يتأمل",73,"ل",1,0],["هُوَ رَبُّنَا سُبحَانَهُ وَبِحَمدِهِ","حَقًّا عَلَى العَرشِ استَوَى الرَّحمنِ",74,"ن",1,0],["هو ربنا خالق هو مستو","بالذات هذي كلها بوزان",74,"ن",1,0],["هو ريم يصمي الرمايا بطرف","نبله يترك الهزبر طريحا",75,"ح",2,0],["هو رب بر فضله","يحيي الرميم من العظام",76,"م",1,0],["هو روضة ما ست قدود غصونها","كقوام خود تنجلي في عرس",77,"س",1,0],["هو روض عرفان تجلى عن جني","دان وكم ليس بالمزرور",78,"ر",1,0],["هو روضةٌ أزهارها أربابه","وسماء عزٍّ شهبها الجلساء",79,"ا",2,0],["هو ريق الحبيب لوناً وطعماً","وهو خمر لكن بدون خمار",80,"ر",1,0],["هو رمزُ الوجود سحرُ التجلي","هو روحُ الاكوان معنى المعاني",81,"ن",2,0],["هو روضة الأدب التي أتانها","غنت حمائم دوحها بفنون",82,"ن",1,0],["هو ربٌّ والروحُ هيكلهُ","عرّفتهُ إلى الورى المُقَلُ",83,"ل",1,0],["هو رب السكون فاحترمي","صمته إن صمته أبدي",84,"د",2,0],["هو ربى هو حسبى","مسعفي في كل شأن",85,"ن",1,0],["هو رحمةٌ للمسلمين ونعمة","للمجتدين وآيةٌ لا تُجْحَد",86,"د",1,0],["هو رونق الملك العظيم وروحه","زاكي المحاسن طيب الأغراس",87,"س",1,0],["هو رحمة للعالمي","ن أجلُّ من صلى ووحَّد",88,"د",1,0],["هو روحُ لُطفٍ في الحَقيقَةِ إِنَّما","يَومُ الوَغى لِذَوي الفُجورُ غَضَنفَرُ",89,"ر",1,0],["هو ردٌ يد الصبا لم تحكهُ","انما حاكهُ بنانُ صباها",90,"ا",3,0],["هو روح يحسد الله وما","أعجب الحاسد لله الصمد",91,"د",1,0],["هو رأي واحد نق","لبه علوًا وسفلا!",92,"ل",2,0],["هو روحج الله والأمر ومع","لوله العالم وهو المدد",93,"د",1,0],["هو راجي الغوث والنجدة من","صاحب او من قريب أو صديق",94,"ق",1,0],["هُوَ رُوحٌ وَسائِرُ الكَونِ جِسمٌ","مَا لِجِسمٍ بِدُونِ رُوحٍ بَهاءُ",95,"ا",2,0],["هو روح الكون طُرّاً","هو سرُّ الكائنات",96,"ت",1,0],["هو روح روحانية الكرم الذي","تشفي موارده غليل الورد",97,"د",1,0],["هُوَ روحُ موسيقى سَرت في دَوحَةٍ","مِن بَيعَةٍ سِحرِيَّةِ الأَجراسِ",98,"س",1,0],["هُوَ رَكبُ الحَياةِ يَمشي حَثيثاً","مُستَخِفّاً إِلى ضَريحِ اللَيالي",99,"ي",1,0],["هو رحمة هو منة هو نعمة","للخلق كلهم نداها عرّجا",100,"ج",2,0],["هُوَ روحُ الوجودِ وَالكُلُّ فيه","قَد سَرَت بِالجَمالِ تِلكَ الروحُ",101,"ح",1,0],["هو رحمةُ الرحمن برٌّ لن تَرى","كمحمّدٍ بشراً أَبَرَّ وَأَرحَما",102,"م",2,0],["هو رحمَةٌ لِلعالَمي","نَ وَغوث من يستنجدُ",103,"د",1,0],["هو رحمة الرحمن جاد بِها عَلى","كُلِّ العَوالِم دائِم الرَحماتِ",104,"ت",1,0],["هو رضوان في سكينة رضوى","رضي الله عنه والإسلام",105,"م",1,0],["هُوَ رُوحٌ مِن المَلائِكِ يَسمو","بسليلِ الثَرى لِعالم نورِ",106,"ر",1,0],["هو رحلة الدنيا التي عقدت له","فوق الهدى ما انحل من أصفاق",107,"ق",1,0],["هو (رَبُّهُ والدِّينُ) سُلطَتُهُ",