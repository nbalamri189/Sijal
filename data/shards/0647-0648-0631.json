{"poems":[[85,"عادت أغاني العرس رجع نواح","https://www.aldiwan.net/poem21008.html","الكامل"],[49,"قد رأيت الدنيا إلى ما تصير","https://www.aldiwan.net/poem62085.html","الخفيف"],[97,"يوم أبحرت فوق متنك تهوي","https://www.aldiwan.net/poem24589.html","الخفيف"],[105,"أقبل فتلك ديار يثرب تقبل","https://www.aldiwan.net/poem44226.html","الكامل"],[67,"جاء المسيح من الإله رسولا","https://www.aldiwan.net/poem18078.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39638","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54698","الرمل"],[115,"يا ايها الحادي اعد مغناه","https://www.aldiwan.net/poem40434.html","عموديه"],[115,"لك بين سفار الحمى اسماء","https://www.aldiwan.net/poem41467.html","عموديه"],[115,"عج بالركائب ساحة الجرعاء","https://www.aldiwan.net/poem42181.html","الكامل"],[128,"بوركت بنية وقد بارك الله","https://www.aldiwan.net/poem50480.html","الخفيف"],[128,"من لصب دموعه ليس ترفا","https://www.aldiwan.net/poem50563.html","الخفيف"],[128,"خذ نصيبين من صفاء السرور","https://www.aldiwan.net/poem50603.html","الطويل"],[128,"من لصب تصاعدت حسراته","https://www.aldiwan.net/poem50653.html","الخفيف"],[128,"يا سائلي عن حصن قريتنا لم","https://www.aldiwan.net/poem50674.html","الطويل"],[185,"لا غرو أن رحل الشباب وبانا","https://www.aldiwan.net/poem14688.html","الكامل"],[189,"يا نبيا لدى الإله عظيما","https://www.aldiwan.net/poem35102.html","الخفيف"],[197,"حب تغلغل في الصميم","https://www.aldiwan.net/poem39893.html","مجزوء الكامل"],[210,"نقل الغرام حديث دمعي مرسلا","https://www.aldiwan.net/poem13420.html","الكامل"],[210,"وافى السرور وصحت الأحلام","https://www.aldiwan.net/poem13476.html","الكامل"],[223,"سل البدر بالضياء الظلاما","https://www.aldiwan.net/poem41867.html","الخفيف"],[223,"إيه برناس هيكل الشعراء","https://www.aldiwan.net/poem41899.html","الخفيف"],[229,"إني غريم والغريم مطالب","https://www.aldiwan.net/poem51018.html","الكامل"],[231,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[259,"نحن قوم لنا السماع غذاء","https://www.aldiwan.net/poem35546.html","الخفيف"],[259,"قم واستنشق نفح الفرج","https://www.aldiwan.net/poem35830.html","المتدارك"],[282,"سري بألسنة الدموع يباح","https://www.aldiwan.net/poem32814.html","الكامل"],[304,"يا خيرة الحي عليكم سلام","https://www.aldiwan.net/poem16888.html","السريع"],[304,"خذ يمينا خذ يمينا","https://www.aldiwan.net/poem16907.html","مجزوء الرمل"],[328,"قبل أن يبصر الظلام الضياء","https://www.aldiwan.net/poem54981.html","الخفيف"],[380,"يا مكثرا من ذم كل ذميم","https://www.aldiwan.net/poem48760.html","الخفيف"],[416,"قد نحرنا الزق يوم العيد نحرا","https://www.aldiwan.net/poem53935.html","الطويل"],[416,"جاء الربيع بورده وبهاره","https://www.aldiwan.net/poem54045.html","الكامل"],[416,"هذه الدار وهاتيك المغاني","https://www.aldiwan.net/poem54073.html","الرمل"],[416,"لمن السوابق والجياد الضمر","https://www.aldiwan.net/poem54183.html","الكامل"],[432,"أما الكواكب فاحتموا بمواكب","https://www.aldiwan.net/poem12405.html","الكامل"],[432,"مولاي عبدك يشتكي","https://www.aldiwan.net/poem12546.html","مجزوء الكامل"],[437,"أي طود هوى من الأطواد","https://www.aldiwan.net/poem2497.html","البسيط"],[449,"اللغة العربية","https://www.aldiwan.net/poem969.html","عموديه"],[453,"وحدتي فيلسوفة تمسح الدمع","https://www.aldiwan.net/poem61234.html","الخفيف"],[453,"الشاعر القروي في تكريمنا","https://www.aldiwan.net/poem61569.html","الكامل"],[453,"وطني رأيتك في الربيع فعطره","https://www.aldiwan.net/poem61597.html","الكامل"],[464,"سقى دمع العين لا دموع الغمائم","https://www.aldiwan.net/poem3271.html","عموديه"],[479,"لله كل يرجع","https://www.aldiwan.net/poem37047.html","مجزوء الكامل"],[500,"روح القلب تارة بالمباح","https://www.aldiwan.net/poem38040.html","الخفيف"],[515,"إن قلت قد خرست خلاخل ساقها","https://www.aldiwan.net/poem12193.html","الكامل"],[538,"هو رزء ولا أقول عظيم","https://www.aldiwan.net/poem48313.html","عموديه"],[551,"يا عليل الطرف رفقا","https://www.aldiwan.net/poem47264.html","مجزوء الرمل"],[562,"أعلمت ما بالقلب من نار الجوى","https://www.aldiwan.net/poem52852.html","الكامل"]],"verses":[["هُوَ رُكنُ مَملَكَةٍ وَحائِطُ دَولَةٍ","وَقَريعُ شَهباءٍ وَكَبشُ نِطاحِ",0,"ح",1,0],["هُوَ رَبّي وَحَسبِيَ اللَهُ رَبّي","فَلَنِعمَ المَولى وَنِعمَ النَصيرُ",1,"ر",1,0],["هو روحي الذي يحاكيك في البأ","س ولكن يؤوده عبء جسمي",2,"ي",1,0],["هو روحي الذي يحاكيك يا بح","ر ويخشى قلبي الجزوع أذاكا",2,"ك",2,0],["هو رَبُّنا إن نالنا رِضوانُه","فلنا المثوبةُ والجزاءُ الأكملُ",3,"ل",1,0],["هُوَ راكِبُ الجَمَل الَّذي سَقَطَتْ بهِ","أصْنامُ بابِلَ قد أتاكَ دَلِيلا",4,"ل",2,0],["هو رُوحٌ يملأُ الشرقَ نشيدا","ويناديكَ ولا يألو وعِيدا",5,"د",2,0],["هُوَ رَأْسُ الْعَامِ قَدْ أَقَ","بَلَ مَيْمُوناً حَمِيدا",6,"د",2,0],["هُوَ رَأْسُ العِلْمِ قَدْ أَقْ","بَلَ مَيْمُوناً حَمِيدا",6,"د",2,0],["هو روحهم محراب جند قلوبهم","وبذروة الاجلال ما اعلاه",7,"ا",2,0],["هو ركن ظهري في الحياة وفي غد","والصالحون أولوا الهدى شفعاء",8,"ا",2,0],["هو رحمةٌ للعالمين ونعمةً","تصلو بفضل سائر النعماء",9,"ا",2,0],["هو رَبُّ العلى أبو العرب الزا","كي لقدْ جلَّ قدرُه أن يُضَاهى",10,"ا",3,0],["هوَ رَبُّ الندَى أبو العرب السا","مى عَلا الخلْقِ في البرية خُلْقَا",11,"ق",2,0],["هو ربُّ الإعطاءِ والشرفِ الما","جد والعدل والندَى والخيرِ",12,"ر",1,0],["هو ربُّ الندى وربُّ الأيادي","الغُرِّ مرهوبةُ الظبا غاراتُه",13,"ت",2,0],["هو رائقُ الآفاقِ تجرى تحته","الأنهارُ وهو بساكنيه حبيبُ",14,"ب",1,0],["هو رحمةُ اللهِ التي أحيا بها الْ","ثَقَليْنِ حتى الجودَ والإيمانا",15,"ن",2,0],["هوَ ربّي وَأَنت في الخلقِ حَسبي","جلَّ دائي وقَد تعاظمَ ذَنبي",16,"ي",1,0],["هو روعة الخلق الجمي","ل ازدانَ بالخلقِ القويم",17,"م",1,0],["هو روضة العليا وبهجة دوحها","لمن اجتنى روض المعالي واجتلى",18,"ل",2,0],["هو روضة العليا ومطلب دوحها","كنز به للطالبين مرام",19,"م",1,0],["هُو رَمز لِقَلب مَريَم رَمز","لِغَرامٍ رَأى الحَياةَ سآما",20,"م",2,0],["هو روحُ من السَماءِ اِستَمَدَّت","حِكمَةَ الفَنِّ من دِماغِ السَماءِ",21,"ا",2,0],["هو روح الخَليل في النجمَة الزه","راء تَمتَصُّ عُنصر الزَهراءِ",21,"ا",2,0],["هو روضة أُنُفٌ تفيدك أخضرا","طَوْراً وطَوْراً أحمرا أو أصفرا",22,"ر",2,0],["هُوَ رَحمَةٌ لِلنّاسِ مُهداة فَمن","قَبل الهِدايَةَ فازَ بِالرّضوانِ",23,"ن",1,0],["هو روح الأرواح من قوّة الحا","ل به حيث يستمدّ الغناء",24,"ا",2,0],["هو رحمتنا العظمى وسرا","جُ الكون ومقتبس السرج",25,"ج",1,0],["هُوَ رَوضَةٌ لَكِنَّها عِندي حِمىً","وَسِوايَ أُهملَ فيهِ فَهوَ مُباحُ",26,"ح",1,0],["هو ربنا هو حسبنا والوكيل","ندعوه نسأل منه حسن الختام",27,"م",1,0],["هو رب الأولينا","هو رب الآخرينا",28,"ن",2,0],["هو ربي هو حسبي","هو خير الرازقينا",28,"ن",2,0],["هو روح مجسدٌ روحه الله","وفكر عقل هويّه إسراء",29,"ا",2,0],["هُوَ رَحمَة ما البَحر إِلّا قَطرة","في جَنب أَيسَر غَيثِها المَسجوم",30,"م",1,0],["هو ربّ الكَرم المحضِ الَّذي","لا يرى الإقلال يوم الجود عذرا",31,"ر",2,0],["هو رحمةٌ نزلتْ على أخياره","وهو الخيار المصطفى لخياره",32,"ر",2,0],["هو ركنُ المجد مَبنى فخره","لا وَهَتْ أركان هاتيك المباني",33,"ي",1,0],["هو رحمةٌ للعالمين ورأفةٌ","وهو البشير لخلقه والمنذر",34,"ر",1,0],["هُو راتِبٌ قد كُنْتُ أَرْقُبُ نَجْمَهُ","فَهَوَى وقد جَعَلَ التُّقلُّقَ راتِبي",35,"ب",2,0],["هو روضةٌ حاشاكَ أنْ","تذوي وساقِيها عِهادُك",36,"ك",1,0],["هو روح الملك الإمامي إذ بال","روح تم البقاء للأجساد",37,"د",1,0],["هو روح العرب من يحفظه","حفظ الروح بها والجسدا",38,"د",2,0],["هو روحي الذي يثور على","الظلم ويأبى الخنوع والتسليما",39,"م",2,0],["هو رائد الآتي ونفحة أمسنا","والثار العاتي على تسليمنا",40,"ن",2,0],["هو رجعُ أشواقي إليكَ تُعيده","شعراً على النسمات جدَّ مؤلفِ",41,"ف",1,0],["هو رفعوا سمك العلى وسماكه","فطال وكم مدت له كف هادم",42,"م",1,0],["هو رحمة في بطنها","اتصسلت بها لا تقطع",43,"ع",1,0],["هو روحي وروحُ معنى فُتوحي","واخْتِتامي وفي الشُؤُنِ افْتِتاحي",44,"ح",2,0],["هو رحلة الدنيا التي عقدت له","فوق الهدى ما انحل من أصفاقها",45,"ق",3,0],["هُوَ رُزءٌ ولا أقولُ عظيمُ","وافتِقادُ البَنِينِ آعظمُ رُزءِ",46,"ا",1,1],["هو راضٍ بَعدَ أنْ لم","يرضَ ما دون القليلِ",47,"ل",1,0],["هُوَ رُكنُ بيتِ الرَّعدِ وَهْوَ عَمُودُهُ","فيهِ الجَلالُ بجانبِ التَّقوَى ثَوَى",48,"و",2,0]]}