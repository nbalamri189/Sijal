{"poems":[[53,"ألمع برق أم ضرم","https://www.aldiwan.net/poem29820.html","مجزوء الرجز"],[53,"ومنسوبة من بنات الوجيه","https://www.aldiwan.net/poem29977.html","المتقارب"],[53,"ألا لله بادرة الطلاب","https://www.aldiwan.net/poem30747.html","الوافر"],[63,"ألفت الندى والعامرية تعذل","https://www.aldiwan.net/poem46139.html","الطويل"],[34,"أضوء سنا برق بدا لك لمعه","https://www.aldiwan.net/poem4863.html","الطويل"],[77,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[77,"أفادت وجهتي بنداك مالا","https://www.aldiwan.net/poem36339.html","الوافر"],[77,"أقمنا برهة ثم ارتحلنا","https://www.aldiwan.net/poem36359.html","الوافر"],[77,"مقامك مرفوع على عمد السعد","https://www.aldiwan.net/poem36604.html","الطويل"],[71,"ما عند مودود من قلت مثالبه","https://www.aldiwan.net/poem3785.html","البسيط"],[73,"أعرفك راح في عرف الرياح","https://www.aldiwan.net/poem11940.html","الوافر"],[93,"نور الهدى أهدت إلى شاعرها","https://www.aldiwan.net/poem11310.html","الرجز"],[30,"لقد جشأت نفسي عشية مشرف","https://www.aldiwan.net/poem29594.html","الطويل"],[88,"لعمرك أن قصر البحر قصر","https://www.aldiwan.net/poem44439.html","الوافر"],[27,"ألم خيال هاج من حاجة وقرا","https://www.aldiwan.net/poem5745.html","الطويل"],[51,"سقيتن يا منزلات الهوى","https://www.aldiwan.net/poem8117.html","المتقارب"],[51,"عزاؤك أن الدهر ذو فجعات","https://www.aldiwan.net/poem8699.html","الطويل"],[51,"يا مانعي قوت جسمي","https://www.aldiwan.net/poem9409.html","المجتث"],[51,"أبا الحسين وأنت المليك","https://www.aldiwan.net/poem61822.html","المجتث"],[51,"ومن سره ألا يرى ما يسوؤه","https://www.aldiwan.net/poem61974.html","الطويل"],[51,"يا ناعي ابن رسول الله في البشر","https://www.aldiwan.net/poem64080.html","البسيط"],[51,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[51,"أتتني أبا العباس أخبار وقعة","https://www.aldiwan.net/poem66319.html","الطويل"],[51,"يا من عكفنا عليه لائذين به","https://www.aldiwan.net/poem66386.html","البسيط"],[70,"رأيتك لا تدوم على وداد","https://www.aldiwan.net/poem42449.html","الوافر"],[70,"لحاظك أمضى من المرهف","https://www.aldiwan.net/poem42815.html","المتقارب"],[85,"سقى الله بالكفر الأباظي مضجعا","https://www.aldiwan.net/poem8107.html","الطويل"],[43,"لا يحزن الله الأمير فإنني","https://www.aldiwan.net/poem9454.html","الطويل"],[45,"تعود عوائد الدمع المراق","https://www.aldiwan.net/poem65196.html","الوافر"],[45,"عزمت على المنازل أن تبينا","https://www.aldiwan.net/poem66674.html","الوافر"],[28,"لعمري لقد أردى نوار وساقها","https://www.aldiwan.net/poem5375.html","الطويل"],[28,"إذا رفعوا سمعت لهم عجيجا","https://www.aldiwan.net/poem5382.html","الوافر"],[61,"على أبن العصب الملحي","https://www.aldiwan.net/poem51279.html","الهزج"],[61,"أرى همة تختال بين الكواكب","https://www.aldiwan.net/poem51785.html","الطويل"],[61,"حسب الأمير سماح وطد الحسبا","https://www.aldiwan.net/poem51801.html","البسيط"],[66,"لا بلغ الحاسد ما تمنى","https://www.aldiwan.net/poem39916.html","الرجز"],[66,"لا راجع الطرف باللقا وسنه","https://www.aldiwan.net/poem40971.html","المنسرح"],[80,"رعى ورق البيض الذي زهره دم","https://www.aldiwan.net/poem31308.html","الطويل"],[80,"ومنسم الآذي يعنق شطه","https://www.aldiwan.net/poem31366.html","الكامل"],[80,"ومن سفن القفر سباحة","https://www.aldiwan.net/poem31398.html","المتقارب"],[80,"تدرعت صبري جنة للنوائب","https://www.aldiwan.net/poem31551.html","الطويل"],[44,"أيا من لا يرق لعاشقيه","https://www.aldiwan.net/poem30081.html","الوافر"],[44,"خشنت عليه أخت بني خشين","https://www.aldiwan.net/poem30339.html","الوافر"],[52,"قد أغتدي وفي الدجى مبالغ","https://www.aldiwan.net/poem26840.html","الرجز"],[48,"ما لي وللعاذلات","https://www.aldiwan.net/poem62464.html","المجتث"],[48,"أيا من وجهه الداح","https://www.aldiwan.net/poem62530.html","الهزج"],[48,"ألا قولا لحمدان","https://www.aldiwan.net/poem66129.html","الهزج"],[48,"قد أسبق الجارية الجونا","https://www.aldiwan.net/poem66167.html","السريع"],[50,"راحت رواحا بين كناد","https://www.aldiwan.net/poem63898.html","السريع"],[46,"ما خص مصرا وبأ وحدها","https://www.aldiwan.net/poem22035.html","السريع"],[46,"أم الكتاب إذا قومت محكمها","https://www.aldiwan.net/poem23089.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85574","المتقارب"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16684","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19708","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54724","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54825","الوافر"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142324","الهزج"],[106,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[45,"عَزَمْتُ عَلى المَنَازِلِ أنْ تَبينَا","https://www.poetsgate.com/ViewPoem.aspx?id=31886",""],[88,"لعمرك ان قصر البحر قصر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19540&r=&rc=43",""]],"verses":[["وَمَن سَما بِهامِكُم","إِلى العُلى وَمَن وَقَم",0,"م",1,0],["وَمَنسوبَةٍ مِن بَناتِ الوَجيهِ","تَحسَبُ غُرَّتَها بُرقُعا",1,"ع",2,1],["وَمَن سَمَحَت بِخاتَمِهِ يَمينٌ","تَضَنُّ بِكُلِّ عالِيَةِ الكِعابِ",2,"ب",1,0],["ومَنْ سَلَبَتْهُ نَوشَةُ الدّهْرِ عِزَّهُ","فنَحْنُ لرَيْبِ الدّهْرِ لا تتذَلّلُ",3,"ل",1,0],["وَمِن سَقَمي مِن نِيَّةِ الحِبِّ كُلَّما","أَتى راكِبٌ مِن نَحوِ أَرضَكِ يَضرِبُ",4,"ب",1,0],["وَمَنْ سَجَدَ الْخَلْقُ اعْتِرَافاً لِعِزِّهِ","فَلاَ شَجَرٌ يَأَبَى السُّجُودَ وَلاَ نَجْمُ",5,"م",1,0],["وَمَنْ سَامَ الْزَّمَانَ دَوَامَ أَمْرٍ","فَقَدْ وَقَفَ الرَّجَاءَ عَلَى الْمُحَالِ",6,"ل",1,0],["وَمَنْ سَامَ الزَّمَانَ دَوَامَ حَالٍ","فَقَدْ وَقَفَ الرَّجَاءَ عَلَى الْمُحَالِ",7,"ل",1,0],["ومِنْ سُرُرٍ مَرْفوعَةٍ وأرائِكٍ","كما رقَمَتْ أيْدي الغَمامِ صَبا نَجْدِ",8,"د",1,0],["وَمَن سِواهُ فَكَلبٌ لا خَلاقَ لَهُ","قَد أَعجَزَتني فَما تُحصى مَعايِبُهُ",9,"ب",2,0],["وَمِن سِرِّ اِبنِ عَبّادٍ دَليلٌ","بِهِ بانَ الفَسادُ مِنَ الصَلاحِ",10,"ح",1,0],["وَمَنْسَقاً أَنْظِمُ أَوْرَاقِي بِهِ","وَقَبْلَهُ لَمْ تَأْلَفِ النِّظَامَا",11,"م",2,0],["وَمُنسَدِح بَينَ الرَجا لَيسَ يَشتَكي","إِذا ضَجَّ وَاِبتَلَّت جَوانِبُهُ فَترا",12,"ر",2,0],["ومن سفن تجئ بها شمال","ومن سفن تروح بها جنوب",13,"ب",1,0],["وَمَنسوبَةٍ بَيضاءَ مِن صُلبِ قَومِها","جَعَلتَ الرِماحَ الخاطِراتِ لَها مَهرا",14,"ر",2,0],["ومن سُرَّ مَن را وروضاتها","حُشوشاً تقابلُ وسط الملا",15,"ا",1,0],["ومن سُنن اللَّه التي سنّ في الورى","إذا جالتِ الآراءُ مُعتبِراتِ",16,"ت",1,0],["ومن سُرُوحِيَ فيمَا","تُنيلُ حين سُرُوحِي",17,"ح",2,0],["ومن سياسةِ مُلْكٍ","أصْبحت تهديه قَصدَهْ",18,"د",2,0],["ومَنْ سَرَّهُ ألا يرى ما يَسُوؤُهُ","فلا يَتَّخِذْ شيئاً يخاف له فقدا",19,"د",2,1],["ومن سرى نحوه أو من أشار به","ومن نوى ذاك من أنثى ومن ذكر",20,"ر",1,0],["ومن سرت نقم الطائي تطلبه","ألفى الذي وعدته الفوتَ مخلافا",21,"ف",2,0],["ومن ساءني من بعدُ أو ساء حُرّةً","مقالاً وفعلاً نِكْتُهُ غيرَ مُحتشِمِ",22,"م",1,0],["ومَن سألناهُ قِدماً كلَّ منفسةٍ","فما سألنا بقايا الآي والدِّمنِ",23,"ن",1,0],["وَمَن سَمِعَ الغِناءَ بِغَيرِ قَلبٍ","وَلَم يَطرَب فَلا يَلُمِ المُغَنّي",24,"ن",2,0],["وَمِن سَيفِ لَحظِكَ لا أَتَّقي","وَمِن خَمرِ ريقِكَ لا أَكتَفي",25,"ي",1,0],["وَمَن سابَقَ التاريخَ لَم يَأمَنِ الهَوى","مُلِجّاً وَلَم يَسلَم مِنَ الحِقدِ نازِيا",26,"ي",2,0],["وَمَن سَرَّ أَهلَ الأَرضِ ثُمَّ بَكى أَسىً","بَكى بِعُيونٍ سَرَّها وَقُلوبِ",27,"ب",1,0],["وَمِن سَحَرِيَّةٍ دالَجتُ فيها","تَرَنُّمَ قَينَةٍ وَهُبوبَ ساقِ",28,"ق",1,0],["وَمِن سَقَمٍ مَبيتُ المَرءِ خِلواً","بِلا سَقَمٍ يَبيتُ لَهُ رَهينا",29,"ن",2,0],["وَمَنسوبَةُ الأَجدادِ غَيرُ لَئيمَةٍ","شَفَت لي فُؤادي وَاِشتَفى بي غَليلُها",30,"ل",3,0],["وَمَن سَمَكَ السَماءَ لَهُ فَقامَت","وَسَخَّرَ لِاِبنِ داوُدَ الشَمالا",31,"ل",2,0],["ومنسبوب إلى دجل","ه ما زال لها خدنا",32,"ن",2,0],["ومن سبج أجرت به الكرم سلكها","ولم يجر في منظومه سلك ثاقب",33,"ب",1,0],["ومن سَواقٍ على خضراءَ تَحسَبُها","مُخضرَّةَ البُسْطِ سَلُّوا فوقَها القُضُبا",34,"ب",2,0],["وَمَن سَأَلنا مِنهُ مَنّاً بِالمُنى","فَمَنَّ بِالوَصلِ لَنا وَمَنّا",35,"ن",2,0],["وَمَن سَنا بِشرِهِ وَنائِلُهُ","رَفَّهَ سَعيِ الحُجّابِ وَالخَزَنَه",36,"ن",2,0],["ومنسوبةٍ للحرب مُنْشَأةٍ لها","طوائرُ بالآسادِ في الماءِ عُوّمُ",37,"م",1,0],["وَمُنَسَّمِ الآذيِّ يُعنِقُ شَطُّهُ","من نكبةٍ هوجاءَ حُلّ وثاقُها",38,"ه",2,1],["ومن سُفُنِ القَفْرِ سَبّاحةٌ","منَ الآلِ بَحْراً إذا ما اعْتَرَضْ",39,"ض",1,1],["ومن سار عن أرْضٍ ثوى قلبُهُ بها","تَمَنَّى له بالجِسمِ أَوبةَ آيِبِ",40,"ب",1,0],["وَمَن سَجَدَ الجَمالُ لَهُ خُضوعاً","وَعَمَّ الحُسنُ مِنهُ مَن يَليهِ",41,"ي",2,0],["وَمِن ساتيدَما بَروازَ فَلَّت","شَبا فَخرٍ فَسيحَ الطائِفَينِ",42,"ن",1,0],["وَمِنسَرٍ ماضي الشَباةِ دامِعُ","يَملَأُ كَفَّيهِ جَناحٌ فارِغُ",43,"غ",1,0],["وَمُنسَنٍ بِالهَدايا","يُطعَنَّ في اللَبّاتِ",44,"ت",1,0],["وَمَن سُقيا ثَناياهُ","إِذا اِستَسقَيتَهُ الراحُ",45,"ح",1,0],["وَمَن سَمَّيتُهُ المَولى","وَعَبدَ السوءِ سَمّاني",46,"ي",1,0],["وَمِنسَرٍ أَكلَفَ فيهِ شَفاً","كَأَنَّهُ عِقدُ ثَمانينا",47,"ن",2,0],["وَمِن سَخاوِيٍّ بِها مُشرِفٍ","لِلعَينِ مِن مَثنى وَأَفرادِ",48,"د",1,0],["وَمِن سَجايا نَبلِهِ أَنَّها","كُلُّ قَتيلٍ قَتَلَت لَم يُبَأ",49,"ب",2,0],["وَمِن سَجايا المَخازي أَن تُرى أَشِراً","تَرمي عَشيرَكَ بِالداءِ الَّذي فيكا",50,"ك",2,0],["ومن سيم خسفاً ولَم ينتفض","فإن منيته أفضل",51,"ل",1,0],["ومَنْ سَرّهُ ثَوْبٌ يَعِزّ بلُبْسِهِ","فلا تَجْرِ منه أُمُّ دَفْرٍ على بال",52,"ل",1,0],["ومن سموم حانة","إلى لعاب عاهر",53,"ر",1,0],["وَمِنْ سَاهِرٍ يُفْنِي مَنَارَ حَيَاتِهِ","ضِيَاءً لِيَهْدِي غَافِلِينَ وَرُقَّدَا",54,"د",2,0],["وَمِنْ سَنَةٍ إِلى سَنَةٍ","يُعَاوِدُهَا بِلاَ مَلَلِ",55,"ل",1,0],["ومن سجن إلى سجن","ومن منفى إلى منفى",56,"ف",2,0],["ومن سَبَر المحيطَ فليس يَشْفى","قليلَ طموحِه إلا القرار",57,"ر",1,0],["وَمِنْ سُقْمٍ مَبيتُ المَرْءِ خِلواً،","بلا سُقْمٍ يَبيتُ لَهُ، وَهِيَنا",58,"ن",2,0],["ومن سُفن تجيء بها شمال","ومن سفن تروح بها جنوب",59,"ب",1,0]]}