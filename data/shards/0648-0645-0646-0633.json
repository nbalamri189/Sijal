ps://www.aldiwan.net/poem14490.html","البسيط"],[449,"أناديك هل تدرين ما سبب النّدا ؟","https://www.aldiwan.net/poem1015.html",""],[458,"قم فانتشِطها حسبها أن تعقلا","https://www.aldiwan.net/poem55915.html","الكامل"],[458,"عسى معرض وجهه مقبل","https://www.aldiwan.net/poem55971.html","المتقارب"],[458,"بدينك بعد ما انفرق الجميع","https://www.aldiwan.net/poem56119.html","الوافر"],[458,"هل في الشموس التي تحدى بها العير","https://www.aldiwan.net/poem56166.html","البسيط"],[458,"بكى النار سترا على الموقد","https://www.aldiwan.net/poem56223.html","المتقارب"],[461,"رأيت غياث الدين في البأس والندى","https://www.aldiwan.net/poem15181.html","الطويل"],[461,"خليلي من عليا تميم بن خندف","https://www.aldiwan.net/poem15305.html","الطويل"],[463,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[464,"أعيا وقد عاينتم الآية العظمى","https://www.aldiwan.net/poem3135.html","عموديه"],[464,"هذا العقيق تلك أعلام الحمى","https://www.aldiwan.net/poem3211.html","عموديه"],[464,"وذي خفر عيل صبري به","https://www.aldiwan.net/poem3400.html","عموديه"],[470,"ولكنني وكلت من كل باخل","https://www.aldiwan.net/poem4736.html","الطويل"],[486,"أتعرف رسماً كالرداء المحبر","https://www.aldiwan.net/poem483.html",""],[495,"يا ملك الشرق عمدة الدول","https://www.aldiwan.net/poem10262.html","المنسرح"],[506,"من كبرت عن قدره خطة","https://www.aldiwan.net/poem2431.html","السريع"],[515,"صفو الحياة وإن طال المدى كدر","https://www.aldiwan.net/poem12141.html","البسيط"],[515,"أفي أهل ذا النادي عليم أسائله","https://www.aldiwan.net/poem12195.html","الطويل"],[538,"أحن إلى مصر وما أنا من مصر","https://www.aldiwan.net/poem48137.html","عموديه"],[538,"ألا فاسمعا لي ما أعيد وما أبدي","https://www.aldiwan.net/poem48223.html","عموديه"],[538,"كما قلتم روض المعالي به خصب","https://www.aldiwan.net/poem48292.html","عموديه"],[551,"سلا عنا المنازل لم بلينا","https://www.aldiwan.net/poem47176.html","الوافر"],[551,"على دار حللت بها سلامي","https://www.aldiwan.net/poem47213.html","الوافر"],[551,"ومن سفه لما مررت على الحمى","https://www.aldiwan.net/poem47243.html","الطويل"],[551,"ما ضر طيفك لو والى زياراتي","https://www.aldiwan.net/poem48030.html","البسيط"],[551,"ألا هل لما فات من مطلب","https://www.aldiwan.net/poem48061.html","المتقارب"],[558,"تجلت لنا ذات وفعل بدا واسم","https://www.aldiwan.net/poem34074.html","الطويل"],[583,"كبيشة عرسي تمنى الطلاقا","https://www.aldiwan.net/poem443.html",""],[587,"لك الحمد اللهم يا ذا الحامد","https://www.aldiwan.net/poem11497.html","عموديه"]],"verses":[["وَمَن سَما بِهامِكُم","إِلى العُلى وَمَن وَقَم",0,"م",1,0],["وَمَنسوبَةٍ مِن بَناتِ الوَجيهِ","تَحسَبُ غُرَّتَها بُرقُعا",1,"ع",2,1],["وَمَن سَمَحَت بِخاتَمِهِ يَمينٌ","تَضَنُّ بِكُلِّ عالِيَةِ الكِعابِ",2,"ب",1,0],["ومَنْ سَلَبَتْهُ نَوشَةُ الدّهْرِ عِزَّهُ","فنَحْنُ لرَيْبِ الدّهْرِ لا تتذَلّلُ",3,"ل",1,0],["وَمِن سَقَمي مِن نِيَّةِ الحِبِّ كُلَّما","أَتى راكِبٌ مِن نَحوِ أَرضَكِ يَضرِبُ",4,"ب",1,0],["وَمَنْ سَجَدَ الْخَلْقُ اعْتِرَافاً لِعِزِّهِ","فَلاَ شَجَرٌ يَأَبَى السُّجُودَ وَلاَ نَجْمُ",5,"م",1,0],["وَمَنْ سَامَ الْزَّمَانَ دَوَامَ أَمْرٍ","فَقَدْ وَقَفَ الرَّجَاءَ عَلَى الْمُحَالِ",6,"ل",1,0],["وَمَنْ سَامَ الزَّمَانَ دَوَامَ حَالٍ","فَقَدْ وَقَفَ الرَّجَاءَ عَلَى الْمُحَالِ",7,"ل",1,0],["ومِنْ سُرُرٍ مَرْفوعَةٍ وأرائِكٍ","كما رقَمَتْ أيْدي الغَمامِ صَبا نَجْدِ",8,"د",1,0],["وَمَن سِواهُ فَكَلبٌ لا خَلاقَ لَهُ","قَد أَعجَزَتني فَما تُحصى مَعايِبُهُ",9,"ب",2,0],["وَمِن سِرِّ اِبنِ عَبّادٍ دَليلٌ","بِهِ بانَ الفَسادُ مِنَ الصَلاحِ",10,"ح",1,0],["وَمَنْسَقاً أَنْظِمُ أَوْرَاقِي بِهِ","وَقَبْلَهُ لَمْ تَأْلَفِ النِّظَامَا",11,"م",2,0],["وَمُنسَدِح بَينَ الرَجا لَيسَ يَشتَكي","إِذا ضَجَّ وَاِبتَلَّت جَوانِبُهُ فَترا",12,"ر",2,0],["ومن سفن تجئ بها شمال","ومن سفن تروح بها جنوب",13,"ب",1,0],["وَمَنسوبَةٍ بَيضاءَ مِن صُلبِ قَومِها","جَعَلتَ الرِماحَ الخاطِراتِ لَها مَهرا",14,"ر",2,0],["ومن سُرَّ مَن را وروضاتها","حُشوشاً تقابلُ وسط الملا",15,"ا",1,0],["ومن سُنن اللَّه التي سنّ في الورى","إذا جالتِ الآراءُ مُعتبِراتِ",16,"ت",1,0],["ومن سُرُوحِيَ فيمَا","تُنيلُ حين سُرُوحِي",17,"ح",2,0],["ومن سياسةِ مُلْكٍ","أصْبحت تهديه قَصدَهْ",18,"د",2,0],["ومَنْ سَرَّهُ ألا يرى ما يَسُوؤُهُ","فلا يَتَّخِذْ شيئاً يخاف له فقدا",19,"د",2,1],["ومن سرى نحوه أو من أشار به","ومن نوى ذاك من أنثى ومن ذكر",20,"ر",1,0],["ومن سرت نقم الطائي تطلبه","ألفى الذي وعدته الفوتَ مخلافا",21,"ف",2,0],["ومن ساءني من بعدُ أو ساء حُرّةً","مقالاً وفعلاً نِكْتُهُ غيرَ مُحتشِمِ",22,"م",1,0],["ومَن سألناهُ قِدماً كلَّ منفسةٍ","فما سألنا بقايا الآي والدِّمنِ",23,"ن",1,0],["وَمَن سَمِعَ الغِناءَ بِغَيرِ قَلبٍ","وَلَم يَطرَب فَلا يَلُمِ المُغَنّي",24,"ن",2,0],["وَمِن سَيفِ لَحظِكَ لا أَتَّقي","وَمِن خَمرِ ريقِكَ لا أَكتَفي",25,"ي",1,0],["وَمَن سابَقَ التاريخَ لَم يَأمَنِ الهَوى","مُلِجّاً وَلَم يَسلَم مِنَ الحِقدِ نازِيا",26,"ي",2,0],["وَمَن سَرَّ أَهلَ الأَرضِ ثُمَّ بَكى أَسىً","بَكى بِعُيونٍ سَرَّها وَقُلوبِ",27,"ب",1,0],["وَمِن سَحَرِيَّةٍ دالَجتُ فيها","تَرَنُّمَ قَينَةٍ وَهُبوبَ ساقِ",28,"ق",1,0],["وَمِن سَقَمٍ مَبيتُ المَرءِ خِلواً","بِلا سَقَمٍ يَبيتُ لَهُ رَهينا",29,"ن",2,0],["وَمَنسوبَةُ الأَجدادِ غَيرُ لَئيمَةٍ","شَفَت لي فُؤادي وَاِشتَفى بي غَليلُها",30,"ل",3,0],["وَمَن سَمَكَ السَماءَ لَهُ فَقامَت","وَسَخَّرَ لِاِبنِ داوُدَ الشَمالا",31,"ل",2,0],["ومنسبوب إلى دجل","ه ما زال لها خدنا",32,"ن",2,0],["ومن سبج أجرت به الكرم سلكها","ولم يجر في منظومه سلك ثاقب",33,"ب",1,0],["ومن سَواقٍ على خضراءَ تَحسَبُها","مُخضرَّةَ البُسْطِ سَلُّوا فوقَها القُضُبا",34,"ب",2,0],["وَمَن سَأَلنا مِنهُ مَنّاً بِالمُنى","فَمَنَّ بِالوَصلِ لَنا وَمَنّا",35,"ن",2,0],["وَمَن سَنا بِشرِهِ وَنائِلُهُ","رَفَّهَ سَعيِ الحُجّابِ وَالخَزَنَه",36,"ن",2,0],["ومنسوبةٍ للحرب مُنْشَأةٍ لها","طوائرُ بالآسادِ في الماءِ عُوّمُ",37,"م",1,0],["وَمُنَسَّمِ الآذيِّ يُعنِقُ شَطُّهُ","من نكبةٍ هوجاءَ حُلّ وثاقُها",38,"ه",2,1],["ومن سُفُنِ القَفْرِ سَبّاحةٌ","منَ الآلِ بَحْراً إذا ما اعْتَرَضْ",39,"ض",1,1],["ومن سار عن أرْضٍ ثوى قلبُهُ بها","تَمَنَّى له بالجِسمِ أَوبةَ آيِبِ",40,"ب",1,0],["وَمَن سَجَدَ الجَمالُ لَهُ خُضوعاً","وَعَمَّ الحُسنُ مِنهُ مَن يَليهِ",41,"ي",2,0],["وَمِن ساتيدَما بَروازَ فَلَّت","شَبا فَخرٍ فَسيحَ الطائِفَينِ",42,"ن",1,0],["وَمِنسَرٍ ماضي الشَباةِ دامِعُ","يَملَأُ كَفَّيهِ جَناحٌ فارِغُ",43,"غ",1,0],["وَمُنسَنٍ بِالهَدايا","يُطعَنَّ في اللَبّاتِ",44,"ت",1,0],["وَمَن سُقيا ثَناياهُ","إِذا اِستَسقَيتَهُ الراحُ",45,"ح",1,0],["وَمَن سَمَّيتُهُ المَولى","وَعَبدَ السوءِ سَمّاني",46,"ي",1,0],["وَمِنسَرٍ أَكلَفَ فيهِ شَفاً","كَأَنَّهُ عِقدُ ثَمانينا",47,"ن",2,0],["وَمِن سَخاوِيٍّ بِها مُشرِفٍ","لِلعَينِ مِن مَثنى وَأَفرادِ",48,"د",1,0],["وَمِن سَجايا نَبلِهِ أَنَّها","كُلُّ قَتيلٍ قَتَلَت لَم يُبَأ",49,"ب",2,0],["وَمِن سَجايا المَخازي أَن تُرى أَشِراً","تَرمي عَشيرَكَ بِالداءِ الَّذي فيكا",50,"ك",2,0],["ومن سيم خسفاً ولَم ينتفض","فإن منيته أفضل",51,"ل",1,0],["ومَنْ سَرّهُ ثَوْبٌ يَعِزّ بلُبْسِهِ","فلا تَجْرِ منه أُمُّ دَفْرٍ على بال",52,"ل",1,0],["ومن سموم حانة","إلى لعاب عاهر",53,"ر",1,0],["وَمِنْ سَاهِرٍ يُفْنِي مَنَارَ حَيَاتِهِ","ضِيَاءً لِيَهْدِي غَافِلِينَ وَرُقَّدَا",54,"د",2,0],["وَمِنْ سَنَةٍ إِلى سَنَةٍ","يُعَاوِدُهَا بِلاَ مَلَلِ",55,"ل",1,0],["ومن سجن إلى سجن","ومن منفى إلى منفى",56,"ف",2,0],["ومن سَبَر المحيطَ فليس يَشْفى","قليلَ طموحِه إلا القرار",57,"ر",1,0],["وَمِنْ سُقْمٍ مَبيتُ المَرْءِ خِلواً،","بلا سُقْمٍ يَبيتُ لَهُ، وَهِيَنا",58,"ن",2,0],["ومن سُفن تجيء بها شمال","ومن سفن تروح بها جنوب",59,"ب",1,0],["ومن سحر عين دونها سحر بابل","غدت عينه الرمداء تقرأ والعصر",60,"ر",1,0],["ومن سرى حبهم في كل جارحة","منا وأصبح من أغلى أمانينا",61,"ن",2,0],["ومن سارَ منهم سيرةً نبوية","ومن ودهم منا عراهُ ملامُ",62,"م",1,0],["ومن سارت به للحرب خيلٌ","فخيرٌ من تقهقره الولوجُ",63,"ج",1,1],["ومن سحرها من عذبته استزادها","ومن قتلت قال اذهبي أنت في حلى",64,"ل",2,0],["ومن سَعْدِه ألا يكونَ فإنْ يكن","يَمُت وهْو في الأحشاء ليس بِنامي",65,"م",2,0],["وَمِن سادةِ الأحبارِ قد حلّ حبُّهُ","قُلوباً بنورِ العلمِ قَد عُمِرَت عمرا",66,"ر",2,0],["ومن سادَ في قومهِ الجاهلون","أضرَّتْ بهِ شيمةُ العاقلِ",67,"ل",1,0],["ومن سرائره عنى محجّبةٌ","كأنها الوحيُ يطوى بين أوراق",68,"ق",1,0],["ومن سواه كالمضارع اجعلا","بزيد ميم ذات ضم أوّلا",69,"ل",2,0],["ومن سواه كاسم فاعل ورد","بفتح ما كسرته كالمعتمد",69,"د",1,0],["ومن سواه مثل مصدر بتا","وما عرى تزاد فيه يا فتى",69,"ت",2,0],["ومن سوى ذي اللين شذ ما سمع","أو ضاعفوه نحو لصت فاتبع",69,"ع",1,0],["وَمَن سَحابُ جودِهِ","بِالمَكرُماتِ هُطَّلُ",70,"ل",1,0],["وَمَن سَجاياهُ مِسكٌ","مِن طيبِها وَعَبيرُ",71,"ر",1,0],["وَمَن سَجاياهُ لِلعُفايُ إِذا","أَظلَمَ لَيلُ الآمالِ كَالسُرُجِ",72,"ج",1,0],["وَمَن ساسَها حَتّى اِطمَأَنَّت وَزانَها","بِعَزمَةِ رَأيٍ ثاقِبٍ وَرُواءِ",73,"ا",2,0],["ومن سَنَحَتْ طَلِيعَتُهُ حَمَاماً","كَمَنْ بَرَحَتْ خَدِيعَتُهُ غُرَابَا",74,"ب",2,0],["وَمِنْ سَيْرٍ إِلَى عَيْرٍ","وَمِنْ جَمْزٍ إِلَى جِبْزِ",75,"ز",1,0],["وَمِنْ سُلاَفِ الْوُدِّ أَلْهَمَهُمْ","فَأَصْبَحُوا قَدْ أَخْمَدُوا رِيَّهْ",76,"ي",2,0],["ومن سنن الله التي في عباده","شؤونهم في دهرهم تتقلب",77,"ب",1,0],["ومن ساحلي بحر الخليج مشرقاً","إلى القلزم المشهور حيث يغرب",78,"ب",1,0],["ومن سر حكم الله أنهم طغوا","عتوّاً وفي صغرى السريات أدبوا",78,"ب",3,0],["ومن سر حكم الله انهم التجوا","إلى من عليه بالجهاد تحجبوا",78,"ب",3,0],["ومن سخافة عقل المرء تغضبه","فيه المنايا وترضيه الأماني",79,"ي",1,0],["ومن سفه بالمرء ان بات باسط","الرجاء بأهليها وليس بها أهل",80,"ل",1,0],["ومن سهاها الجسم مضمحل","كأنه صب براه العذل",81,"ل",1,0],["ومن سأل الأيام تغيير وضعها","كمن سأل الشيعي ان يتحنفا",82,"ف",2,0],["وَمن سَكَرات المَوت وَالقَبر وحده","وَعن كل هول واقف بالمراصد",83,"د",1,0],["وَمن ساوَرَ الضرغام أَصبَح باكِيا","عَلَى فَقدِهِ مَحبُوبه حينَ لا يُجدِي",84,"د",2,0],["ومِنْ سَهَكِ الحَديدِ هُناكَ طِيبٌ","تُبَادِرُهُ المَعَاطِسُ بانْتِشَاقِ",85,"ق",1,0],["ومِن سَدَرٍ أضْلَلْتُ فِيها مَرَاشِدي","أبَاحِثُ عَن أتْرابِها الضَّالَ والسِّدْرا",86,"ر",2,0],["وَمِن ساكِباتِ المُزْنِ فَيضُ أكُفِّهمْ","فَرِدْهُمْ تَرِدْ ماءَ الغمام وَأعْذَبا",87,"ب",2,0],["وَمَنْ سارَ يَسْتَقْرِي نَداكَ إِلى الْغِنى","فَلَيْسَ بِمَخْشِيٍّ عَلَيْهِ ضَلالُ",88,"ل",1,0],["وَمِنْ ساعَةٍ لِلْبَيْنِ غَيْرِ حَمِيدَةٍ","سَمَحْتُ بِطَلِّ الدَّمْعِ فِيها وَسَكْبِهِ",89,"ب",2,0],["وَمَن سَما فَضلاً عَلى هَؤُلِي","ياءِ شَأَى لا شَكَّ فِتيانا",90,"ن",2,0],["وَمَن ساوَرَ الإِعدامَ لا فَرقَ بَينَهُ"