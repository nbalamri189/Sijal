{"poems":[[55,"من الظلم أن نتعاطى الخمارا","https://www.aldiwan.net/poem30470.html","المتقارب"],[53,"لعمري لقد أنكرت غير نكير","https://www.aldiwan.net/poem62940.html","الكامل"],[51,"خذ الناس أو دع إنما الناس بالناس","https://www.aldiwan.net/poem62127.html","الطويل"],[92,"الإقطاع","https://www.poetsgate.com/ViewPoem.aspx?id=179169",""],[92,"لعبة التجارب...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66767&r=&rc=175",""],[203,"يا للهوى والغزل","https://www.aldiwan.net/poem45354.html","مجزوء الرجز"],[266,"فديناك طرق الجدا جدى من الهزل","https://www.aldiwan.net/poem38209.html","الطويل"],[275,"أبعد التقى أهفو إلى هفواتي","https://www.aldiwan.net/poem35583.html","الطويل"],[358,"بروحي جمالا صورته يد القدره","https://www.aldiwan.net/poem40340.html","الطويل"],[454,"مع النسيم العليل","https://www.aldiwan.net/poem978.html",""],[1217,"","https://poetry.dctabudhabi.ae/diwan/poem/143763","المجتث"],[1955,"","https://poetry.dctabudhabi.ae/diwan/poem/45433","الطويل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/121014","البسيط"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112494","الطويل"],[4386,"","https://poetry.dctabudhabi.ae/diwan/poem/33788","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58016","الوافر"],[4755,"قَصِيدةٌ أُخرَى وجُرحٌ جَدِيدْ","https://www.poetsgate.com/ViewPoem.aspx?id=184116",""],[5206,"أرى العدل عن لوم العذول هو العدل","https://www.poetsgate.com/ViewPoem.aspx?id=149039",""],[5277,"أواصرُ الآه","https://www.poetsgate.com/ViewPoem.aspx?id=185997",""],[5277,"مِن تهجّدات البدوي الحزين","https://www.poetsgate.com/ViewPoem.aspx?id=208837",""],[5351,"يمانيون يا طه تنادت","https://www.poetsgate.com/ViewPoem.aspx?id=202647",""],[5561,"آلامُ حُر","https://www.poetsgate.com/ViewPoem.aspx?id=196518",""],[6239,"من ذاكرة الصقيع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75978&r=&rc=29",""]],"verses":[["مِنَ الظُلمِ أَن نَتَعاطى الخُمارا","وَقَد سَلَبَتنا الهُمومُ العُقارا",0,"ر",2,1],["من الظّبياتِ العاطيات لمُجتنِي","ثمار قلوبٍ لا لحَبِّ بَذير",1,"ر",1,0],["مِنَ الظُلمِ تَشغيبُ امرِئٍ غَيرِ مُنصِفٍ","وَما بِامرِئٍ لَم يَظلِمِ الناسَ مِن باسِ",2,"س",1,0],["مِنَ الظلْمِ أنَّا نَطْلُبُ العزمَ صادقاً","من الشعبِ منقوضَ القُوى والعزائم",3,"م",1,0],["من الظلم أن تأتي قصيدةُ شاعر","لتُصلِحَ حالاً أو مقالةُ كاتب",4,"ب",1,0],["من الظبى لا كالظبى","من مرحٍ وكسلِ",5,"ل",1,0],["من الظلم ان يسهي عن البدر بالسها","وان يؤخذ الندب المهذب بالنذل",6,"ل",1,0],["من الظبيةِ الغناءِ ألقى لبوءةً","إذا قلتُ يوماً يا بنيّة هاتي",7,"ت",2,0],["مِن الظَبيات الآنسات إِذا بَدَت","مِن الخِدر أَنستني مَعاني ظِبا وَجره",8,"ر",2,0],["من الظلام من الطغيان قاومه","من لا يراعي حقوق اله والجار",9,"ر",1,0],["من الظباء العَواطي","إلى الضِّباع القَوافي",10,"ف",2,0],["مَنِ الظالِمُ الجاني عَلى أَهلِ بَينِهِ","إِذا أُحضِرتَ أِسبابُ اِمرٍ وَأَبُهُما",11,"م",2,0],["من الظِّباءِ الحسانِ لكن","إذا تأمَّلتَهُ ففارَهُ",12,"ر",2,0],["من الظلم تحطيم الحسام لأنه","بكل جهاد في الحياة تجرّدا",13,"د",2,0],["مِنَ الظِباءِ ظِباءٌ هَمُّها السُخُبُ","تَرعى القُلوبَ وَفي قَلبي لَها عُشُبُ",14,"ب",1,1],["من الظُّفَرَاء أعرابٌ لئامٌ","وإبليسٌ يقودُهم الغرورُ",15,"ر",1,0],["مِن الظَّلامِ الجَمِّ يَأتِي الضُّحَى","ومِن نَدَى الأَحزانِ يأتِي \"السَّعِيدْ\"",16,"د",1,0],["مِنَ الظُّلْمِ عَدْلُ الظَلْمِ عَنْ مَزجِهِ بِهِ","وَفِي ظِلمَةٍ مِن ظَلمِهِ يَرتَمِي الهَطْلُ",17,"ل",1,0],["من الظنونِ تراقصَ الأرقُ","والدمعُ حبرٌ خانَهُ الورقُ",18,"ق",1,1],["من الظنِّ الأثيمِ ومِن مَخازٍ","خَزيتُ بها ويعرفُها قليلُ",19,"ل",1,0],["من الظلماء في ذكراك ترجو","إذا ما قصرت منك السماحا",20,"ح",2,0],["مِنَ الظُّلمِ أنْ تَشقى شُعوبٌ بأهلِها","وما الظُّلمُ إلاّ حاقَ في أهْلِهِ الجَوْرُ",21,"ر",1,0],["من الظّمَأ العالي هبطتُ مسلمّا","على الأرضِ تنأى في منافي جنودها",22,"د",3,0]]}