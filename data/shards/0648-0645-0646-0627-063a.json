{"poems":[[53,"يا من هواه من القلوب مكين","https://www.aldiwan.net/poem66463.html","الكامل"],[30,"منا الذي اختير الرجال سماحة","https://www.aldiwan.net/poem5306.html","الطويل"],[104,"سل جنة الشعر ما ألوى بدوحتها","https://www.aldiwan.net/poem32925.html","البسيط"],[52,"أراني قد تصابيت","https://www.aldiwan.net/poem64742.html","الهزج"],[108,"إلى مجلس الأمن","https://www.poetsgate.com/ViewPoem.aspx?id=179350",""],[266,"أعطى سرائرك النحول اللوما","https://www.aldiwan.net/poem38193.html","الكامل"],[369,"هبني أقصر بالخطا","https://www.aldiwan.net/poem60794.html","مجزوء الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138201",""],[673,"","https://poetry.dctabudhabi.ae/diwan/poem/137337",""],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54020","الكامل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53904","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77526","الرجز"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65094","المنسرح"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46518","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64625","الرجز"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47195","الكامل"],[2823,"","https://poetry.dctabudhabi.ae/diwan/poem/146730","الكامل"],[2852,"","https://poetry.dctabudhabi.ae/diwan/poem/142921","السريع"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36727","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111423","الرجز"],[4098,"","https://poetry.dctabudhabi.ae/diwan/poem/122925","الكامل"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105131","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94764","الوافر"],[182,"قدر الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=72801",""],[5596,"نغزى وسحرا","https://www.poetsgate.com/ViewPoem.aspx?id=206186",""],[5937,"تزَلُّجٌ","https://www.poetsgate.com/ViewPoem.aspx?id=211891",""],[6031,"قُلْ لأعْلَى الوَرَى مَحَلاّ ورُتْبَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=46345",""]],"verses":[["ومن اغتدى وكأنه من حسنه","في كل عضو منه حُورٌ عِين",0,"ن",1,0],["وَمِنّا غَداةَ الرَوعِ فِتيانُ غارَةٍ","إِذا مَتَعَت تَحتَ الزُجاجِ الأَشاجِعُ",1,"ع",1,0],["وَمَن أَغار عَلى تلكَ الخِيام ضُحىً","يبيح تَقويضها مِن بَعد تَطنيبِ",2,"ب",1,0],["وَمِن أَغرَبِ مَن حاوَل","تُ في الأَمرِ وَقاسَيتُ",3,"ت",1,0],["ومن أغْثَتَ بُغَاثُ الطَّيْرِ تخطفهُ","ومن أعَنْت فلا جَاهٌ ولا نَشَب",4,"ب",1,0],["ومن اغتذى بلبان كل فضيلة","والندب تقنعه الفضائل مطعما",5,"م",2,0],["ومَنِ اغتَدَى وُدّي له","أصفَى من الماء الزُّلال",6,"ل",1,0],["ومن اغترابك ما اعتزمت سياحة","أو راحة بعد العنا أو مكسبا",7,"ب",2,0],["ومُناغاتك اللطيفةُ تشفي","من سقامِ يُعيي الطبيبَ الأريبا",8,"ب",2,0],["ومَنِ اغْتدى أهلاً لذروة منبرٍ","أهلاً لخدمة جانب المِحْرابِ",9,"ب",1,0],["ومِن اغْتدى في الأسر مثلي مُوثَقاً","فمِنَ الغرائب وصفُه ببقاءِ",10,"ا",2,0],["وَمَن أَغاثَ البائس المَلهوفا","أَغاثَهُ اللَهُ إِذا أُخيفا",11,"ف",2,0],["ومَنْ أَغاثَ العافينَ مَنْ يَدُهُ","سَحَابةٌ بالنَّوالِ مُنْبَعِقَهْ",12,"ق",2,0],["وَمَن أَغاث البائس الملهوفا","أَعانهُ اللَّه إِذا أخيفا",13,"ف",2,0],["ومن أغظت الدهر في ولائه","غيظاً سقاه السم في كأس الردى",14,"ا",1,0],["ومن اغتدى من حُسْنِه كلُّ الورى","إِلفَ السّهاد له دموعٌ ذُرَّفُ",15,"ف",1,0],["ومن اغتدى ربع الفضائل مشرقا","بمكانه وخلا من الإظلام",16,"م",1,0],["ومن أغان طالما رددت","أنغامها من حولي السمر",17,"ر",1,0],["وَمَنِ اِغتَدَت أَنوارُهُ","لِذوي الضَلالة هادِيَه",18,"ي",2,0],["ومن أَغِيلِيفا ومن زاكِنثُسِ","وعِبرِها ونِيرِتُس وسامُسِ",19,"س",1,0],["ومن اغتدت في القلب منها لوعة","تأتي ووقت زوالها لا ياتي",20,"ت",2,0],["ومن أغراه حسنك بالتصابي","وأصباه بك الكشح الهضيم",21,"م",1,0],["ومن اغناطيوس أرجو سماحاً","فذا التقصير من قلبٍ سليمِ",22,"م",1,0],["ومن اغمادنا ما سُلَّ سيفٌ","مطايا في متاهات الخواء",23,"ا",2,0],["ومن اغار سناه","شمساً ونجماً وبدرا",24,"ر",2,0],["ومن أغرتك بالنقش اليماني","فقد أغرتك بالشِعر المُخَلَّدْ",25,"د",1,0],["ومَن اغْتَاظَ من دُعَايَ ولَمْ يَرْ","ضَ بِمَا قُلْتُ فيكَ فَهو ابن",26,"ب",2,0]]}