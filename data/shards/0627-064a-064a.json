{"poems":[[53,"راحل أنت والليالي نزول","https://www.aldiwan.net/poem29892.html","الخفيف"],[43,"كم قتيل كما قتلت شهيد","https://www.aldiwan.net/poem9532.html","الخفيف"],[45,"قلما لا تتصباني الدمن","https://www.aldiwan.net/poem66660.html","الرمل"],[58,"أي يومي من الموت أفر","https://www.aldiwan.net/poem31071.html","الرمل"],[49,"المنايا تجوس كل البلاد","https://www.aldiwan.net/poem62044.html","الخفيف"],[49,"إن دارا نحن فيها لدار","https://www.aldiwan.net/poem62089.html","المديد"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54216","الرمل"]],"verses":[["أَيُّ يَومٍ أَدمى المَدامِعَ فيهِ","حادِثٌ رائِعٌ وَخَطبٌ جَليلُ",0,"ل",1,0],["أَيَّ يَومٍ سَرَرتَني بِوِصالٍ","لَم تَرُعني ثَلاثَةً بِصُدودِ",1,"د",1,0],["أَيَّ يَومٍ بَعدَ يَومٍ لَم يُعِد","حَسَناً مِن فِعلِهِ بَعدَ حَسَن",2,"ن",1,0],["أَي يَومَيَّ مِنَ المَوتَ أَفِر","يَومَ لا يَقدِرُ أَو يَومَ قَدِر",3,"ر",1,1],["أَيُّ يَومٍ يَومُ السِباقِ وَإِذ أَن","تَ تُنادى فَما تُجيبُ المُنادي",4,"د",2,0],["أَيُّ يَومٍ يَومُ الفِراقِ وَإِذ نَف","سُكَ تَرقى عَنِ الحَشا وَالفُؤادِ",4,"د",1,0],["أَيُّ يَومٍ يَومُ الفِراقِ وَإِذ أَن","تَ مِنَ النَزعِ في أَشَدِّ الجِهادِ",4,"د",1,0],["أَيُّ يَومٍ يَومُ الصُراخِ وَإِذ يَل","طِمنَ حُرَّ الوُجوهِ وَالأَجيادِ",4,"د",1,0],["أَيُّ يَومٍ نَسيتُ يَومَ التَلاقي","أَيُّ يَومٍ نَسيتُ يَومَ التَنادِ",4,"د",1,0],["أَيُّ يَومٍ يَومُ الوُقوفِ إِلى اللَ","هِ وَيَومُ الحِسابِ وَالإِشهادِ",4,"د",1,0],["أَيُّ يَومٍ يَومَ المَمَرِّ عَلى النا","رِ وَأَهوالَها العِظَمِ الشِدادِ",4,"د",1,0],["أَيُّ يَومٍ يَومُ الخَلاصِ مِنَ النا","رِ وَهَولِ العَذابِ وَالأَصفادِ",4,"د",1,0],["أَيَّ يَومٍ تَأمَنُ الدَهرَ فيهِ","وَلَهُ في كُلِّ يَومٍ عِثارُ",5,"ر",1,0],["أيُّ يَوْمٍ سعِدَتْ مِصْرُ به","كان في طيِّ الأماني حُلُمَا",6,"م",2,0]]}