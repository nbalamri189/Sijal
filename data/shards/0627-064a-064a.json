{"poems":[[53,"راحل أنت والليالي نزول","https://www.aldiwan.net/poem29892.html","الخفيف"],[43,"كم قتيل كما قتلت شهيد","https://www.aldiwan.net/poem9532.html","الخفيف"],[45,"قلما لا تتصباني الدمن","https://www.aldiwan.net/poem66660.html","الرمل"],[58,"أي يومي من الموت أفر","https://www.aldiwan.net/poem31071.html","الرمل"],[49,"المنايا تجوس كل البلاد","https://www.aldiwan.net/poem62044.html","الخفيف"],[49,"إن دارا نحن فيها لدار","https://www.aldiwan.net/poem62089.html","المديد"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54216","الرمل"],[115,"أي يوم يا ريم عيني تراكا","https://www.aldiwan.net/poem40860.html","عموديه"],[115,"قطعوا من فؤادي الأوصالا","https://www.aldiwan.net/poem41685.html","الخفيف"],[156,"أيئست من أسماء أم لم تيأس","https://www.aldiwan.net/poem423.html",""],[164,"وله نابه وخطب جليل","https://www.aldiwan.net/poem67814.html","الخفيف"],[223,"أيها الظلم والخنا والغرور","https://www.aldiwan.net/poem41927.html","الخفيف"],[237,"كل يوم لك عيد الودود","https://www.aldiwan.net/poem18177.html","المديد"],[328,"مجد يهان وعزة تتضعضع","https://www.aldiwan.net/poem54922.html","الكامل"],[366,"أي يوم علا على الأيام","https://www.aldiwan.net/poem17333.html","الخفيف"],[377,"شدتي أعظم شده","https://www.aldiwan.net/poem66874.html","مجزوء الرمل"],[416,"عد عن من لج في قال وقيل","https://www.aldiwan.net/poem54131.html","الرمل"],[432,"فحن طيبا من بعدهن الديار","https://www.aldiwan.net/poem12483.html","الخفيف"],[437,"كل يوم لي من صدودك حاله","https://www.aldiwan.net/poem2501.html","الخفيف"],[464,"عداك وجدي فعد عن عذلي","https://www.aldiwan.net/poem3178.html","عموديه"],[477,"عهد الصبا ومعاهد الأحباب","https://www.aldiwan.net/poem15221.html","الكامل"],[479,"الخفيف","https://www.aldiwan.net/poem36924.html","الخفيف"],[556,"ما شئتما الآن للزمان","https://www.aldiwan.net/poem2484.html","مخلع البسيط"]],"verses":[["أَيُّ يَومٍ أَدمى المَدامِعَ فيهِ","حادِثٌ رائِعٌ وَخَطبٌ جَليلُ",0,"ل",1,0],["أَيَّ يَومٍ سَرَرتَني بِوِصالٍ","لَم تَرُعني ثَلاثَةً بِصُدودِ",1,"د",1,0],["أَيَّ يَومٍ بَعدَ يَومٍ لَم يُعِد","حَسَناً مِن فِعلِهِ بَعدَ حَسَن",2,"ن",1,0],["أَي يَومَيَّ مِنَ المَوتَ أَفِر","يَومَ لا يَقدِرُ أَو يَومَ قَدِر",3,"ر",1,1],["أَيُّ يَومٍ يَومُ السِباقِ وَإِذ أَن","تَ تُنادى فَما تُجيبُ المُنادي",4,"د",2,0],["أَيُّ يَومٍ يَومُ الفِراقِ وَإِذ نَف","سُكَ تَرقى عَنِ الحَشا وَالفُؤادِ",4,"د",1,0],["أَيُّ يَومٍ يَومُ الفِراقِ وَإِذ أَن","تَ مِنَ النَزعِ في أَشَدِّ الجِهادِ",4,"د",1,0],["أَيُّ يَومٍ يَومُ الصُراخِ وَإِذ يَل","طِمنَ حُرَّ الوُجوهِ وَالأَجيادِ",4,"د",1,0],["أَيُّ يَومٍ نَسيتُ يَومَ التَلاقي","أَيُّ يَومٍ نَسيتُ يَومَ التَنادِ",4,"د",1,0],["أَيُّ يَومٍ يَومُ الوُقوفِ إِلى اللَ","هِ وَيَومُ الحِسابِ وَالإِشهادِ",4,"د",1,0],["أَيُّ يَومٍ يَومَ المَمَرِّ عَلى النا","رِ وَأَهوالَها العِظَمِ الشِدادِ",4,"د",1,0],["أَيُّ يَومٍ يَومُ الخَلاصِ مِنَ النا","رِ وَهَولِ العَذابِ وَالأَصفادِ",4,"د",1,0],["أَيَّ يَومٍ تَأمَنُ الدَهرَ فيهِ","وَلَهُ في كُلِّ يَومٍ عِثارُ",5,"ر",1,0],["أيُّ يَوْمٍ سعِدَتْ مِصْرُ به","كان في طيِّ الأماني حُلُمَا",6,"م",2,0],["أي يوم يا ريم عيني تراكا","هي عين لم تلتفت لسواكا",7,"ك",2,1],["أي يومٍ به السعادة تأتي","برضاهم عني وأكفى الوبالا",8,"ل",2,0],["أَيَئِستَ مِن أَسماءَ أَم لَم تَيأس","وَصَرَمتَ شَبكَ حبالها المُتَلَبِّسِ",9,"س",1,1],["أَيُّ يَومٍ لِراشِدٍ وَلِموسى","ذاكَ يَومٌ لَو تَعلَمونَ ثَقيلُ",10,"ل",1,0],["أَيَّ يَومٍ زُيوتُ نورِك تَخبو","وَعَلى سُنَّةِ الضِياءِ تَثورُ",11,"ر",1,0],["أَيْ يَرَى يَوْماً عَظِيماً شَهِيداً","يَا لَهُ فِي دِينِنَا مِنْ شَهِيدِ",12,"د",1,0],["أَيْ يَرَى وَجْهَ كَرِيمٍ كَرِيمٍ","يَتَدَلَّى لِِكَدُودٍ كَدُودِ",12,"د",1,0],["أيئِستَ أم آمنت أنك زائلٌ","ومن العقائد ما يضرّ وينفع",13,"ع",1,0],["أَيُّ يَومٍ عَلا عَلى الأَيّامِ","أَيُّ نُعمى تَمَّت عَلى الإِسلامِ",14,"م",1,1],["أي يومٍ يا إلهي","يبلغ المهمومُ رشده",15,"د",2,0],["أيّ يومٍ يوم سارت عيسُهم","ودعا داعي نواهم بالرحيل",16,"ل",1,0],["أيُّ يومٍ مضى لنا في رياضٍ","عرّسَتْ في عِراصها الأمطارُ",17,"ر",1,0],["أيّ يوم أصغيت فيه إلى عذ","ل عذول لا نلت منه وصاله",18,"ل",2,0],["أي يدٍ أن بلغتهُا أَمَماً","عندي لأيدي المطيّ والإِبل",19,"ل",1,0],["أىَ يلوحُ لرجعِ طرفكَ رسمُها","بعدَ التوسُّمِ مِثلَ وشمِ خِضابِ",20,"ب",1,0],["أي يوم في حبها ينقضي لم","تك بيني وبينها أشياء",21,"ا",2,0],["أَيُّ يَدٍ لِلزَّمانِ عِندي","أَدنَى بَنانٍ لَها بَناني",22,"ي",1,0]]}