{"poems":[[55,"راحل أنت والليالي نزول","https://www.aldiwan.net/poem29892.html","الخفيف"],[45,"كم قتيل كما قتلت شهيد","https://www.aldiwan.net/poem9532.html","الخفيف"],[47,"قلما لا تتصباني الدمن","https://www.aldiwan.net/poem66660.html","الرمل"],[60,"أي يومي من الموت أفر","https://www.aldiwan.net/poem31071.html","الرمل"],[51,"المنايا تجوس كل البلاد","https://www.aldiwan.net/poem62044.html","الخفيف"],[51,"إن دارا نحن فيها لدار","https://www.aldiwan.net/poem62089.html","المديد"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54216","الرمل"],[119,"أي يوم يا ريم عيني تراكا","https://www.aldiwan.net/poem40860.html","عموديه"],[119,"قطعوا من فؤادي الأوصالا","https://www.aldiwan.net/poem41685.html","الخفيف"],[160,"أيئست من أسماء أم لم تيأس","https://www.aldiwan.net/poem423.html",""],[168,"وله نابه وخطب جليل","https://www.aldiwan.net/poem67814.html","الخفيف"],[228,"أيها الظلم والخنا والغرور","https://www.aldiwan.net/poem41927.html","الخفيف"],[242,"كل يوم لك عيد الودود","https://www.aldiwan.net/poem18177.html","المديد"],[333,"مجد يهان وعزة تتضعضع","https://www.aldiwan.net/poem54922.html","الكامل"],[371,"أي يوم علا على الأيام","https://www.aldiwan.net/poem17333.html","الخفيف"],[382,"شدتي أعظم شده","https://www.aldiwan.net/poem66874.html","مجزوء الرمل"],[422,"عد عن من لج في قال وقيل","https://www.aldiwan.net/poem54131.html","الرمل"],[438,"فحن طيبا من بعدهن الديار","https://www.aldiwan.net/poem12483.html","الخفيف"],[443,"كل يوم لي من صدودك حاله","https://www.aldiwan.net/poem2501.html","الخفيف"],[469,"عداك وجدي فعد عن عذلي","https://www.aldiwan.net/poem3178.html","عموديه"],[482,"عهد الصبا ومعاهد الأحباب","https://www.aldiwan.net/poem15221.html","الكامل"],[484,"الخفيف","https://www.aldiwan.net/poem36924.html","الخفيف"],[561,"ما شئتما الآن للزمان","https://www.aldiwan.net/poem2484.html","مخلع البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122639","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87087","الخفيف"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59591","الكامل"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105468","الخفيف"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/19992","المديد"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113975","الرمل"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105426","الخفيف"],[1787,"","https://poetry.dctabudhabi.ae/diwan/poem/105104","الرمل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/201724","الخفيف"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48220","الرمل"],[2129,"","https://poetry.dctabudhabi.ae/diwan/poem/111093","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53124","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53080","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77362","الخفيف"],[2408,"","https://poetry.dctabudhabi.ae/diwan/poem/128795","الخفيف"],[2575,"","https://poetry.dctabudhabi.ae/diwan/poem/142551","الخفيف"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137050",""],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100211","الخفيف"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65117","الخفيف"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112352","المتدارك"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62923","الرمل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62799","الخفيف"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138611",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138665",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138465",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108290","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110057","الكامل"],[3827,"","https://poetry.dctabudhabi.ae/diwan/poem/139843",""],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95375","الخفيف"],[4481,"","https://poetry.dctabudhabi.ae/diwan/poem/33992","الخفيف"],[4528,"","https://poetry.dctabudhabi.ae/diwan/poem/177949","الخفيف"],[4860,"حدث العاقل بما لا يعقله","https://www.poetsgate.com/ViewPoem.aspx?id=32518",""],[4869,"الاميره","https://www.poetsgate.com/ViewPoem.aspx?id=151633",""],[4869,"طفل حالم","https://www.poetsgate.com/ViewPoem.aspx?id=151706",""],[5057,"غنِّ يا شام","https://www.poetsgate.com/ViewPoem.aspx?id=207360",""],[5121,"روايتي الشقية","https://www.poetsgate.com/ViewPoem.aspx?id=37466",""],[5162,"نورٌ بجوف الغار","https://www.poetsgate.com/ViewPoem.aspx?id=196784",""],[308,"سلوا الدموع فإن الصب مشغول","https://www.poetsgate.com/ViewPoem.aspx?id=118851",""],[5315,"رام أَن يتْرك الْهوى فَبَدَا لَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=190297",""],[5950,"حكاوي","https://www.poetsgate.com/ViewPoem.aspx?id=126265",""],[5956,"يا خالد الحُبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=193695",""],[6093,"أيِّيْ وأيُّكِ إنْ قامَ الهَوى نَكَلا","https://www.poetsgate.com/ViewPoem.aspx?id=177625",""],[6202,"أي يوم يكون للشعراء ..؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86712&r=&rc=13",""]],"verses":[["أَيُّ يَومٍ أَدمى المَدامِعَ فيهِ","حادِثٌ رائِعٌ وَخَطبٌ جَليلُ",0,"ل",1,0],["أَيَّ يَومٍ سَرَرتَني بِوِصالٍ","لَم تَرُعني ثَلاثَةً بِصُدودِ",1,"د",1,0],["أَيَّ يَومٍ بَعدَ يَومٍ لَم يُعِد","حَسَناً مِن فِعلِهِ بَعدَ حَسَن",2,"ن",1,0],["أَي يَومَيَّ مِنَ المَوتَ أَفِر","يَومَ لا يَقدِرُ أَو يَومَ قَدِر",3,"ر",1,1],["أَيُّ يَومٍ يَومُ السِباقِ وَإِذ أَن","تَ تُنادى فَما تُجيبُ المُنادي",4,"د",2,0],["أَيُّ يَومٍ يَومُ الفِراقِ وَإِذ نَف","سُكَ تَرقى عَنِ الحَشا وَالفُؤادِ",4,"د",1,0],["أَيُّ يَومٍ يَومُ الفِراقِ وَإِذ أَن","تَ مِنَ النَزعِ في أَشَدِّ الجِهادِ",4,"د",1,0],["أَيُّ يَومٍ يَومُ الصُراخِ وَإِذ يَل","طِمنَ حُرَّ الوُجوهِ وَالأَجيادِ",4,"د",1,0],["أَيُّ يَومٍ نَسيتُ يَومَ التَلاقي","أَيُّ يَومٍ نَسيتُ يَومَ التَنادِ",4,"د",1,0],["أَيُّ يَومٍ يَومُ الوُقوفِ إِلى اللَ","هِ وَيَومُ الحِسابِ وَالإِشهادِ",4,"د",1,0],["أَيُّ يَومٍ يَومَ المَمَرِّ عَلى النا","رِ وَأَهوالَها العِظَمِ الشِدادِ",4,"د",1,0],["أَيُّ يَومٍ يَومُ الخَلاصِ مِنَ النا","رِ وَهَولِ العَذابِ وَالأَصفادِ",4,"د",1,0],["أَيَّ يَومٍ تَأمَنُ الدَهرَ فيهِ","وَلَهُ في كُلِّ يَومٍ عِثارُ",5,"ر",1,0],["أيُّ يَوْمٍ سعِدَتْ مِصْرُ به","كان في طيِّ الأماني حُلُمَا",6,"م",2,0],["أي يوم يا ريم عيني تراكا","هي عين لم تلتفت لسواكا",7,"ك",2,1],["أي يومٍ به السعادة تأتي","برضاهم عني وأكفى الوبالا",8,"ل",2,0],["أَيَئِستَ مِن أَسماءَ أَم لَم تَيأس","وَصَرَمتَ شَبكَ حبالها المُتَلَبِّسِ",9,"س",1,1],["أَيُّ يَومٍ لِراشِدٍ وَلِموسى","ذاكَ يَومٌ لَو تَعلَمونَ ثَقيلُ",10,"ل",1,0],["أَيَّ يَومٍ زُيوتُ نورِك تَخبو","وَعَلى سُنَّةِ الضِياءِ تَثورُ",11,"ر",1,0],["أَيْ يَرَى يَوْماً عَظِيماً شَهِيداً","يَا لَهُ فِي دِينِنَا مِنْ شَهِيدِ",12,"د",1,0],["أَيْ يَرَى وَجْهَ كَرِيمٍ كَرِيمٍ","يَتَدَلَّى لِِكَدُودٍ كَدُودِ",12,"د",1,0],["أيئِستَ أم آمنت أنك زائلٌ","ومن العقائد ما يضرّ وينفع",13,"ع",1,0],["أَيُّ يَومٍ عَلا عَلى الأَيّامِ","أَيُّ نُعمى تَمَّت عَلى الإِسلامِ",14,"م",1,1],["أي يومٍ يا إلهي","يبلغ المهمومُ رشده",15,"د",2,0],["أيّ يومٍ يوم سارت عيسُهم","ودعا داعي نواهم بالرحيل",16,"ل",1,0],["أيُّ يومٍ مضى لنا في رياضٍ","عرّسَتْ في عِراصها الأمطارُ",17,"ر",1,0],["أيّ يوم أصغيت فيه إلى عذ","ل عذول لا نلت منه وصاله",18,"ل",2,0],["أي يدٍ أن بلغتهُا أَمَماً","عندي لأيدي المطيّ والإِبل",19,"ل",1,0],["أىَ يلوحُ لرجعِ طرفكَ رسمُها","بعدَ التوسُّمِ مِثلَ وشمِ خِضابِ",20,"ب",1,0],["أي يوم في حبها ينقضي لم","تك بيني وبينها أشياء",21,"ا",2,0],["أَيُّ يَدٍ لِلزَّمانِ عِندي","أَدنَى بَنانٍ لَها بَناني",22,"ن",2,0],["أيُّ يَومٍ يمضي عَليكَ وما فرَّ","قتَ كَنزاً ولا نَحَرت كَنازا",23,"ز",2,0],["أَي يَوم زَكيت مالاً جَزيلاً","جَمعه كانَ دائِماً مِن حَرام",24,"م",1,0],["إئى إلى وصل يُتاح به","أشهى إلى الصادي من الورد",25,"د",1,0],["أي يومٍ نرى الكتائب تترا","تتهادى سلاهباً ونياقا",26,"ق",2,0],["أَيّ يَومَيكَ اِعتَزَيتَ لَهُ","اِستَضاءَ المَجدُ مِن قُتُرِه",27,"ر",2,0],["أَيُّ يومٍ لَم يُنِخ فيهِ على","معشَرٍ منهُ بكَلكالِ أجَل",28,"ل",1,0],["أيُّ يومٍ أيُّ يومٍ يومهُ","يومَ ضاقَت بي رحيباتُ السُبُل",28,"ل",1,0],["أي يومٍ يشدو البشير بمن لم","يحل في غيبه ترنم شاد",29,"د",1,0],["أي يوم قد تقضى","ليس فيه لك رزق",30,"ق",1,0],["أي يوم ما بين دجلة والدي","ر زياد ناب الورى ودهاها",31,"ا",3,0],["أي يوم هذا وأي زمانِ","بارك الله في بني عدنانِ",32,"ن",1,1],["أيُّ يومٍ مرَّ إِلا بالقَنا","والمواضي علَقُ الخَصْمِ نَشَغْ",33,"غ",1,0],["ائئمتنا باب الرجا معدن الحجى","كرام الورى أبناء فاطمة الزهرا",34,"ر",2,0],["أيّ يوم في جبهة الدهر غرة","بَكَّرَ الدَّجْنُ فيه ينثر قَطْرَه",35,"ر",2,1],["أي يوم بادي السنا نفقت في","ه مُنَى الآملين بعد الكساد",36,"د",1,0],["أَيُّ يَومٍ يُبَلُّ فيهِ قَريني","يا طَبيباً يُجِلُّهُ الحُكَماءُ",37,"ا",2,0],["أي يوم للحشر غض جديد","شاب فيه الزمان وهو وليد",38,"د",1,1],["أيّ يتمٍ أذلّ كبرَ أنيني","وأراني دجن المسا في صباحي",39,"ح",2,0],["أيّ يومٍ ودّعتُ فيه حبيبي","ثم أسلمتُ مهجتي للنّواح",39,"ح",1,0],["أي يوم يمر لم يمر فيه","اثر من عبد الحميد حميد",40,"د",1,0],["أي يوم لسنا نسميه عيداً","وعلى الكون ظله ممدود",40,"د",1,0],["أي يوم لنا بنعمان لو قد","أنعمونا به الغزال الربيبا",41,"ب",2,0],["أيّ يوم نظمته بجبيب","وزهير يطيب نظم العقود",42,"د",1,0],["أييأسُ مثلي ولي نجمةٌ","تطلّ على عالمٍ أوسعٍ",43,"ع",1,0],["أَيُّ يومٍ دانَ أَو كانَ لكم","قبلَ اِسلامِكم فيه الخَيَارُ",44,"ر",1,0],["أيُّ يومٍ من صاعدٍ لم أرحْ في","هِ بخيلٍ كثيرةِ الأسْلابِ",45,"ب",1,1],["أي يوم قضى به فلعمري","حزنه لا يزال دهراً فدهراً",46,"ر",2,0],["أي يوم فيه تهنى العلاء","يوم طالت على السما البوغاء",47,"ا",2,1],["أي يوميها على الحق ترى","يوم رامت نبشها القبر اهتماما",48,"م",2,0],["أيَّ يوم كان الحمام رحيماً","لكريم حتى نراه رحيما",49,"م",2,0],["أَي يوسفُ الشيخُ المروَّعُ بالأَسَى","خَلِّ البُكاءَ فانهُ حُكمُ الأَزَل",50,"ل",1,0],["أي يوم ببشره طبق الأر","ض سرورا سهولها والحزونا",51,"ن",2,0],["أي يوميك تجتلى يوم تذكي ال","حرب ام يوم تتهب الاموالا",52,"ل",2,0],["أَيُّ يومٍ أَراكَ فيهِ كَما كُن","تَ قَريباً فَأَشتَكي مِن قَريبِ",53,"ب",1,0],["أيّ يومٍ هناك يومي إذا ما","جمع الخلق موقفٌ مشهود",54,"د",1,0],["اييد تعطي..رحمة الرب آمله","واييد توصل مبتغاها بالحبي",55,"ب",2,0],["اييييه اعترف عن حُبك اللي خذآني","لكن عن اسمك .. ويش يصبح مصيره..؟",56,"ر",2,0],["اييييه يآبحْر المشآعر كم خذآ شوقه سفينه","كم جهل ضيم الموآني كآن بس بالحب يدري",57,"ر",2,0],["أيييييه يا شامُ كم رأينا جِراحاً","موجعاتٍ تقُودُنا للبُكاءِ !",58,"ا",2,0],["أَيُّ يَوْمٍ بِلا عِنَاقٍ شَقِيٍّ ؟","لا وَرَبِّي فَمَا احْتَوَانِي الْعَرَاءُ",59,"ا",2,0],["إِي يا خديجةُ دثرينِي إِنَّنِي","فيْ الغارِ نلتُ منابعَ الأسرارِ",60,"ر",1,0],["أيي قريشاً وهم في الحفل أن نطقوا","كما علمنا هم اللسن المقاويل",61,"ل",1,0],["أَي يَوْم أنال مِنْهُ بك الوص","ل فولي وَقَالَ لي لن تناله",62,"ل",2,0],["إيييه ياللي مثل قلب الزمان البخيل","جادك الدمع وعيوني وغربالها",63,"ل",3,0],["أي يترك الأرض رغماً عن إرادته","جذوره في الثرى تسري كتجذيري",64,"ر",2,0],["أيِّيْ وأيُّكِ إنْ قامَ الهَوى نَكَلا","وحينَ يسألُ وصْلاً ردَّ فوهُ بِلا",65,"ل",2,1],["أي يوم يكون للشعراء","ورجال تموت حين ابتلاء",66,"ا",2,0],["أي يوم يكون للشعراء","والمنايا تصول دون حياء",66,"ا",2,0]]}