{"poems":[[65,"تأملت الورى جيلا فجيلا","https://www.aldiwan.net/poem46180.html","الوافر"],[56,"ذممتك أولا حتى إذا ما","https://www.aldiwan.net/poem27603.html","الوافر"],[32,"أخرقاء للبين استقلت حمولها","https://www.aldiwan.net/poem29537.html","الطويل"],[90,"ألا انهض وشمر أيها الشرق للحرب","https://www.aldiwan.net/poem44471.html","الطويل"],[49,"زماني كله غضب وعتب","https://www.aldiwan.net/poem25372.html","الوافر"],[40,"على الدار بالرمانتين تعوج","https://www.aldiwan.net/poem7693.html","الطويل"],[47,"عذيري فيك من لاح إذا ما","https://www.aldiwan.net/poem65672.html","الوافر"],[30,"تحن بزوراء المدينة ناقتي","https://www.aldiwan.net/poem5618.html","الطويل"],[30,"لعمرك ما تجزي مفداة شقتي","https://www.aldiwan.net/poem5651.html","الطويل"],[50,"وفتيان صدق قد صرفت مطيهم","https://www.aldiwan.net/poem63263.html","الطويل"],[50,"طربت إلى خمر وقصف الدساكر","https://www.aldiwan.net/poem63297.html","الطويل"],[52,"أشادن إن ريمة لا تصاد","https://www.aldiwan.net/poem63916.html","الوافر"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30514","الطويل"],[30,"لعمرك ما تجزي مفداة شقتي","https://www.poetsgate.com/ViewPoem.aspx?id=21026",""],[147,"لا تخش عدوى من أبحت ذماره","https://www.aldiwan.net/poem11831.html","الطويل"],[185,"خليلى إنى قد أرقت ونمتما","https://www.aldiwan.net/poem59077.html","الطويل"],[240,"سقاها الحيا من أربع وطلول","https://www.aldiwan.net/poem31789.html","الطويل"],[242,"ذوى خضر الأفراح منذ ذوى الخضر","https://www.aldiwan.net/poem18825.html","الطويل"],[369,"ولم يك في من عيب","https://www.aldiwan.net/poem60612.html","مجزوء الوافر"],[463,"أروم الوفاء الصعب بالمطلب السهل","https://www.aldiwan.net/poem56064.html","الطويل"],[475,"وأوقدت ناري باليفاع فلم تدع","https://www.aldiwan.net/poem4659.html","الطويل"],[482,"أعن أرض الغميم لمحت نارا","https://www.aldiwan.net/poem15207.html","الوافر"],[521,"فلما حملت الدين فيها واصبحت","https://www.aldiwan.net/poem48612.html","الطويل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/97007","الطويل"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/77452","الوافر"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/77449","الطويل"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132856","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101045","الوافر"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132240","الوافر"],[333,"","https://poetry.dctabudhabi.ae/diwan/poem/110986","المجتث"],[2376,"","https://poetry.dctabudhabi.ae/diwan/poem/115214","الطويل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102544","البسيط"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65966","الطويل"],[2798,"","https://poetry.dctabudhabi.ae/diwan/poem/144201","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204579","الطويل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112334","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89261","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85238","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131209",""],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69932","الوافر"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77008","الطويل"],[5072,"قلب ٌ غزاها","https://www.poetsgate.com/ViewPoem.aspx?id=51897",""],[5213,"سعينا لكم سعي الودود وأنتم","https://www.poetsgate.com/ViewPoem.aspx?id=170475",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[5908,"بنا من بنات الماء للكوفة الغرا","https://www.poetsgate.com/ViewPoem.aspx?id=170972",""],[5953,"ولي صاحب إذا كان تقديره الغنى","https://www.poetsgate.com/ViewPoem.aspx?id=93864",""]],"verses":[["فلَمْ أحْمَدْ لِعارِفَةٍ جَواداً","ولم أذْمُمْ على مَنْعٍ بَخيلا",0,"ل",2,0],["فَلَم أَحمِدكَ مِن خَيرٍ وَلَكِن","رَأَيتُ سِواكَ شَرّاً مِنكَ حَدّا",1,"د",2,0],["فَلَمّا حَدا اللَيلُ النَهارَ وَأَسدَفَت","هَوادي الدُجى ما كادَ يَدنو أَصيلُها",2,"ل",3,0],["فلما حللتم أرضنا ذقتم الردى","بأسيافنا حتى صحوتم من العُجب",3,"ب",1,0],["فَلَمّا حالَتِ الأَعداءُ دوني","وَأَصبَحَ بَينَنا بَحرٌ وَدَربُ",4,"ب",1,0],["فَلَمّا حَبا مِن خَلفِنا رَملُ عالِجٍ","وَجَوشٌ بَدَت أَعناقُها وَدَجوجُ",5,"ج",1,0],["فَلَم أُحدِث لَها إِلّا وِداداً","وَلَم أَزدَد بِها إِلّا غَراما",6,"م",2,0],["فَلَمّا حَبا وادي القُرى مِن وَرائِنا","وَأَشرَفنَ أَقتارَ الفِجاجِ القَوائِمِ",7,"م",1,0],["فَلَمّا حَطَطناها عَلَيهِنَّ أَرزَمَت","هُدوءً وَأَلقَت فَوقَهُنَّ البَوانِيا",8,"ي",2,0],["فَلَمّا حَكى الزُنّارُ أَن لَيسَ مُسلِماً","ظَنَنّا بِهِ خَيراً فَظَنَّ بِنا شَرّا",9,"ر",2,0],["فَلَمّا حَلَلناها نَزَلنا بِأَشمَطٍ","كَريمِ المُحَيّا ظاهِرِ الشِركِ كافِرِ",10,"ر",1,0],["فَلَمّا حَثَّتِ الصَهباءُ فينا","وَغَرَّدَ صاحَبي وَخَلا المِسادُ",11,"د",1,0],["فَلَما حَوت كَفاك رمَّة أَمرِهِ","وَشُدَّ بكفّ الحصرِ منهُ المُخنَّقُ",12,"ق",1,0],["فَلَمّا حَطَطْنَاها عَلَيْهِنّ أرْزَمَتْ","هُدُوءاً وَألقَتْ فَوْقَهُنّ البَوَانِيَا",13,"ي",2,0],["فَلِما حَمَت أَتراكَها أَتراكُهُ","وَلِما حَمَت سودانَها سودانُهُ",14,"ن",2,0],["فلم أُحفِ باللَّومِ الرَّفيقَ ولَم أَجِد","خَلِيَّا ولاَذَا البَثِّ يَستَوِيَانِ",15,"ن",1,0],["فَلَم أَحظَ مِن حُبِّ الغَواني بِطائِلِ","سِوى رَعيِ لَيلٍ بِالغَرامِ طَويلِ",16,"ل",1,0],["فَلَمْ أَحْمَدِ الدُّنْيَا بِلاَ نُورِ أَحْمَدٍ","وَهَلْ يُحْمَدَ اللَّيْلُ الْبَهِيمُ بِلاَ قَمَرْ",17,"ر",1,0],["فلم أحسُدْ أخا نِعَم","ولم أشْمَتْ بمُمْتَحَن",18,"ن",1,0],["فلم أحظَ من إحسانها واحتوائها","على كلّ معنى دقّ أو منطق فصلِ",19,"ل",1,0],["فَلَمَّا حَمِدناهُ بِمَا كانَ أَهلَهُ","وَكَانَ حَقيقاً أَن يُسَنَّى وَيُحمَدا",20,"د",2,0],["فلما حالَ عهدُ الودَّ منهما","وأمستْ تمنعُ الكَلِفَ المزارا",21,"ر",2,0],["فَلَمّا حَمَلتُ الدينَ فيها وَاِصبَحَت","حِيالاً مُسِنّاتِ الهَوى كِدت أَندَم",22,"م",1,1],["فلما حططت الرحل فيه وجدته","وامواهه نار وأزهاره الجمر",23,"ر",1,0],["فَلَما حَلّ ربعَ طَريفَ وَالى","إِلى أَجفانِهِ الغُرّ الكِتابا",24,"ب",2,0],["فَلَمّا حَللت السَهل أَرسَلت ماجِداً","تذِلّ لَهُ الأَملاك ساعَةَ يَظهَرُ",25,"ر",1,0],["فلما حللتُ القَصرَ قَصرَ مسرَّتي","تَفَرَّقنَ عني آيساتٍ جُمُوعَها",26,"ع",3,0],["فلما حصحص انقلبت إليه","ونادت بالإمام لها إماما",27,"م",2,0],["فلما حان قلت له اقتطفه","فقال مخلّد حتّى التنادي",28,"د",2,0],["فلم أحيّ صديقا","ولم أردّ سلاما",29,"م",2,0],["فلما حساها هرّها ثم إنّه","تماسك شيئا واجماً متفَكّرا",30,"ر",2,0],["فلم أحل عن معاني من نسبت إلى","جلالهم عن عطياتي وابراري",31,"ر",2,0],["فلما حدفت الوصل إذ ساردلها","لها هي وما هذا إلى اللّه طائع",32,"ع",1,0],["فلما حفّ بالإصباحِ ليلٌ","وعُذرٌ قام عُذري بالعِذار",33,"ر",1,0],["فلم أحظ في شيء على القوت زائد","وفاز بأقصى ما يريد أخو اللؤم",34,"م",1,0],["فلم أحسنِ التمثيلَ في حالة الغنى","ولكنّني أبدعتُ في موقفِ الفقرِ",35,"ر",1,0],["فلما حللتم فيه حاولت نقله","فأخرجته من ناظريَّ عقيقا",36,"ق",2,0],["فلما حوتها عرصته الدار سلمت","سلام حبيب زائر ذي تودد",37,"د",1,0],["فلما حل ذاك الداءُ ضيفاً","هششت ورحت تقريه قواكا",38,"ك",2,0],["فَلَم احفل بِذي اصلٍ وَفَخرٍ","وَيُلهى بِالصبوحِ وَبِالغبوقِ",39,"ق",1,0],["فَلَمّا حَطَّطنا الرحل في دارِكَ الَّتي","عَلى رُبعِها المَأهولِ سَحبُ الرِضى دَرا",40,"ر",2,0],["فلم َ احترقت َ ؟؟ وأنت َ من أحرقْتَها","ولم َ انتفضت َ ؟ ومنك َ جاء حطامُها",41,"م",3,0],["فلما حسبتم انكم قد غنيتم","سقيتم بغدر سعي نمل على صخر",42,"ر",1,0],["فلم أحك أرباب المقالات كلهم","ولكن ذكرنا بعض من زل واستزل",43,"ل",1,0],["فلما حللنا فيه كل لما به","يقول لعينيه قفا نبك من ذكرى",44,"ر",2,0],["فلما حللنا في التراكب أشرقت","جواهرنا شكلا يزيد على الشكل",45,"ل",1,0]]}