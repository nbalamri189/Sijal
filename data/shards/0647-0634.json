{"poems":[[27,"عفا النسران بعدك والوحيد","https://www.aldiwan.net/poem5726.html","الوافر"],[72,"شب الحشا قول الكواعب شابا","https://www.aldiwan.net/poem18236.html","الكامل"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[91,"كم تشتكي وتقول إنك معدم","https://www.aldiwan.net/poem62676.html","عموديه"],[45,"أفي كل دار منك عين ترقرق","https://www.aldiwan.net/poem65183.html","الطويل"],[45,"لعمري لئن أخلقت ثوب التغزل","https://www.aldiwan.net/poem65650.html","الطويل"],[28,"تصيح به الأصداء يخشى به الردى","https://www.aldiwan.net/poem5319.html","الطويل"],[28,"فرعن وفرغن الهموم التي سمت","https://www.aldiwan.net/poem5547.html","الطويل"],[28,"وإن تميما منك حيث توجهت","https://www.aldiwan.net/poem5548.html","الطويل"],[28,"رأيت سماء الله والأرض ألقتا","https://www.aldiwan.net/poem5612.html","الطويل"],[105,"أعد البناء وجدد الميثاقا","https://www.aldiwan.net/poem43050.html","الكامل"],[81,"هي طلعة السعد الأغر فمرحبا","https://www.aldiwan.net/poem61549.html","الكامل"],[81,"طرقت منقبة تروع تحجبا","https://www.aldiwan.net/poem61559.html","الكامل"],[44,"","https://poetry.dctabudhabi.ae/diwan/poem/1149","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39622","الكامل"],[94,"","https://poetry.dctabudhabi.ae/diwan/poem/142406","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[106,"يا راعي الفصحى","https://www.poetsgate.com/ViewPoem.aspx?id=179702",""],[125,"هشت لمقدمه المدينه","https://www.aldiwan.net/poem23748.html","مجزوء الكامل"],[135,"أنت النبي محمد","https://www.aldiwan.net/poem20996.html","مجزوء الكامل"],[148,"أمسعود جاء السعد والخير واليسر","https://www.aldiwan.net/poem47624.html","الطويل"],[190,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[236,"قم قبل إسفار الصباح","https://www.aldiwan.net/poem32117.html","مجزوء الكامل"],[238,"عن نور هديك ثغر الدهر مبتسم","https://www.aldiwan.net/poem19069.html","البسيط"],[238,"حلت حلى حسن الحلى زيدان","https://www.aldiwan.net/poem19294.html","الكامل"],[299,"أمل تدركه العين وأين","https://www.aldiwan.net/poem36859.html","عموديه"],[306,"رسل البشائر ورد وصدور","https://www.aldiwan.net/poem56545.html","الخفيف"],[323,"ألا طال التنظر والثواء","https://www.aldiwan.net/poem56353.html","الوافر"],[354,"لله در عصابة من هاشم","https://www.aldiwan.net/poem39791.html","الكامل"],[401,"نقش على جدار الوطن","https://www.aldiwan.net/poem6788.html","عموديه"],[454,"كاد الخريف يموت مثل مماتي","https://www.aldiwan.net/poem61246.html","الكامل"],[454,"جزيرة النور تحيينا","https://www.aldiwan.net/poem61396.html","السريع"],[454,"أمسائل القدر العتي محيرا","https://www.aldiwan.net/poem61571.html","الكامل"],[459,"تهوى وأنت محلأ مصدود","https://www.aldiwan.net/poem56216.html","الكامل"],[539,"يوم أناخ بباب خير إمام","https://www.aldiwan.net/poem47941.html","عموديه"],[539,"ضنت بهذا اليوم قبل عصور","https://www.aldiwan.net/poem48154.html","عموديه"],[539,"قال البيان لمن أراد مديحه","https://www.aldiwan.net/poem48155.html","عموديه"],[541,"لله درك من فتى فجعت به","https://www.aldiwan.net/poem56626.html","الكامل"],[541,"صرمت حبائلا من حب سلمى","https://www.aldiwan.net/poem56867.html","الوافر"]],"verses":[["هِشامُ المُلكِ وَالحَكَمُ المُصَفّى","يَطيبُ إِذا نَزَلتَ بِهِ الصَعيدُ",0,"د",1,0],["هشمت فخارَ العرب هاشمُ واحتوت","حتى القريض لنسلها أسلابا",1,"ب",2,0],["هشاشته للماء تنسجُ متنَهُ","شمالُ خَريقٍ وَهْوَ حَرَّانُ أهْيَمُ",2,"م",1,0],["هَشَّت لَكَ الدُنيا فَما لَكَ واجِماً","وَتَبَسَّمَت فَعَلامَ لا تَتَبَسَّمُ",3,"م",1,0],["هَشَمنَ إِلى اِبنَ الهاشِمِيَّةِ أَوجُهاً","عَوابِسَ لِلبَيداءِ ما تَتَطَلَّقُ",4,"ق",1,0],["هَشيمَةُ ذاتُ الحاجِبَينِ تُعِلَّنا","مُشَمِّرَةً سُقيا لَها مِن مُعَلِّلِ",5,"ل",1,0],["هِشامَ بنَ خَيرِ الناسِ إِلّا مُحَمَّداً","وَأَصحابَهُ إِنّي لَكُم لَم أُقارِفِ",6,"ف",1,0],["هِشامٌ فَتى الناسِ الَّذي تَنتَهي المُنى","إِلَيهِ وَإِن كانَت رِغاباً جِسامُها",7,"م",3,0],["هِشامٌ خِيارُ اللَهِ لِلناسِ وَالَّذي","بِهِ يَنجَلي عَن كُلِّ أَرضٍ ظَلامُها",8,"م",3,0],["هِشامٌ أَمينُ اللَهِ في الأَرضِ وَالَّذي","بِهِ تَمنَعُ الأَيّامُ ذاتَ المَحارِمِ",9,"م",1,0],["هَشَّتْ إلى النَّعشِ المُقامِ حِيالَها","لمّا رأتْهُ مُزَخْرَفاً بَرّاقا",10,"ق",2,0],["هَشَّت لِمَطلَعِهِ الأَسِرَّةُ وَالأَسِنّ","ةُ وَالمَحَفِلُ وَالمَحافِلُ وَالظُبى",11,"ب",2,0],["هَشُّ النَدى جَزِلُ الوَقارِ كَأَنَّهُ","بَحرٌ وَطَودٌ إِن حَبا وَإِن اِحتَبى",12,"ب",2,0],["هَشماً لِأَنفِ المُسامي حَينَهُ فَسَما","لِهاشِمٍ فَضلُها فيها اِبنُ صالِحِها",13,"ح",3,0],["هَشَّتْ لآنيتي وأشرَق لونُها","وتردّدتْ أنفاسُها في مَضْجعي",14,"ع",2,0],["هشّت إلىّ قبور أدمعي عبق","على الرّياحين في أفيائها وندى",15,"د",2,0],["هَشَمَتْ وَانْتهَشَتْ وافْتَرَسَتْ","مَا اشْتَهَتْ نَهْمَتُهَا عَلماً وَهَبْرَا",16,"ر",2,0],["هَشّموا نابَي ابن بُرْدٍ وحالوا","بين كاس الطلا وبين ابنِ هاني",17,"ن",2,0],["هشَّت له الفصحى، وأطربها اسُمهُ","فكأنَّ أحرُفه انتظمن قصائدا",18,"د",2,0],["هشت لمقدمه المدينه","ومشت إلى الطيش الرعونة",19,"ن",2,1],["هَشَمَ الرَبيكَةَ في الجِفا","نِ وَعَيشُ مَكَّةَ أَنكَدُ",20,"د",1,0],["هشوشٌ بشوشٌ يلقى بالرحب قاصداً","وعن مثل حب المزن تلقاه يفترّ",21,"ر",1,0],["هَشَموا فيه بيضةَ الدرعِ حتّى","دَمِيت منهُ جبّةٌ بيضاءُ",22,"ا",2,0],["هَشٌّ إِلى الإِحسانِ ذو","طَرَبٍ إِلَيهِ وَاِرتِياحِ",23,"ح",1,0],["هَشَّتْ لِلُقْيَاكَ فَاسٌ إِذْ حَلَلْتَ بِهَا","وَفَاسُ لَوْلاَ سَنَا وُجُودِكُمْ عَدَمُ",24,"م",1,0],["هَشَّتْ لِلُقْيَاهُ الْجِنَانُ وَحُورُهَا","مُتَسَرْبِلاً بِمَلاَبِسِ الرِّضْوَانِ",25,"ن",1,0],["هشَّ لما طفّلته أُمه","ودنا من وجهها بالراحتين",26,"ن",1,0],["هَشَّت بِمَولِدِ نَجلِهِ فَسَرى بِها","في العالَمينَ بَشاشَةٌ وَحُبورُ",27,"ر",1,0],["هِشامٌ وَالوَليدُ وَكُلُّ نَفسٍ","تُريدُ لَكَ الفَناءَ لَكَ الفِداءُ",28,"ا",2,0],["هَشموه مِن فَرط التَناول بَينَهُم","قَطفاً فَأَصبَح هاشمٌ مَهشوما",29,"م",2,0],["هشت إليك جبال مكتها فما","ذل العزيز ولا تطامنت القنن",30,"ن",1,0],["هشت لي الأغصان وهي جريمة","وتطلعت لخطاي في الغابات",31,"ت",1,0],["هشت لي الأشجار في نشوة","والماء والطير مغنينا",32,"ن",2,0],["هشت أطايبها وكم صدف الورى","عنها وكل نائح بخباله",33,"ل",2,0],["هَشٌّ لصدر اليوم إمَّا مالُه","فيه وإمّا قربهُ المنقودُ",34,"د",1,0],["هَشَّت رياضُ بلاغةٍ فيه فَذا","زَهرُ البديعِ مفتَّحُ الأكمامِ",35,"م",1,0],["هَشَّت رِياضُ بلاغَةٍ وتَفَتَّحَت","فيهِ عنَ أكمامِ البَديع زُهورُ",36,"ر",1,0],["هَشَّ المُحَيَّا عَن خِلالٍ مِثلمَا","يَفترُّ عَن ثَغرِ الزُّهورِ ثَبِيرُ",37,"ر",1,0],["هَشٌّ إِذا نَزَلَ الوفودُ بِبابِهِ","سَهلُ الحِجابِ مُؤَدَّب الخِدّامِ",38,"م",1,0],["هَشَشتَ لحاجَةٍ وَوَعَدتَ أُخرى","وَلَم تَبخَل بِناجِزَةِ السَراحِ",39,"ح",1,0]]}