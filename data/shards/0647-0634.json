{"poems":[[27,"عفا النسران بعدك والوحيد","https://www.aldiwan.net/poem5726.html","الوافر"],[72,"شب الحشا قول الكواعب شابا","https://www.aldiwan.net/poem18236.html","الكامل"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[91,"كم تشتكي وتقول إنك معدم","https://www.aldiwan.net/poem62676.html","عموديه"],[45,"أفي كل دار منك عين ترقرق","https://www.aldiwan.net/poem65183.html","الطويل"],[45,"لعمري لئن أخلقت ثوب التغزل","https://www.aldiwan.net/poem65650.html","الطويل"],[28,"تصيح به الأصداء يخشى به الردى","https://www.aldiwan.net/poem5319.html","الطويل"],[28,"فرعن وفرغن الهموم التي سمت","https://www.aldiwan.net/poem5547.html","الطويل"],[28,"وإن تميما منك حيث توجهت","https://www.aldiwan.net/poem5548.html","الطويل"],[28,"رأيت سماء الله والأرض ألقتا","https://www.aldiwan.net/poem5612.html","الطويل"],[105,"أعد البناء وجدد الميثاقا","https://www.aldiwan.net/poem43050.html","الكامل"],[81,"هي طلعة السعد الأغر فمرحبا","https://www.aldiwan.net/poem61549.html","الكامل"],[81,"طرقت منقبة تروع تحجبا","https://www.aldiwan.net/poem61559.html","الكامل"],[44,"","https://poetry.dctabudhabi.ae/diwan/poem/1149","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39622","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[106,"يا راعي الفصحى","https://www.poetsgate.com/ViewPoem.aspx?id=179702",""]],"verses":[["هِشامُ المُلكِ وَالحَكَمُ المُصَفّى","يَطيبُ إِذا نَزَلتَ بِهِ الصَعيدُ",0,"د",1,0],["هشمت فخارَ العرب هاشمُ واحتوت","حتى القريض لنسلها أسلابا",1,"ب",2,0],["هشاشته للماء تنسجُ متنَهُ","شمالُ خَريقٍ وَهْوَ حَرَّانُ أهْيَمُ",2,"م",1,0],["هَشَّت لَكَ الدُنيا فَما لَكَ واجِماً","وَتَبَسَّمَت فَعَلامَ لا تَتَبَسَّمُ",3,"م",1,0],["هَشَمنَ إِلى اِبنَ الهاشِمِيَّةِ أَوجُهاً","عَوابِسَ لِلبَيداءِ ما تَتَطَلَّقُ",4,"ق",1,0],["هَشيمَةُ ذاتُ الحاجِبَينِ تُعِلَّنا","مُشَمِّرَةً سُقيا لَها مِن مُعَلِّلِ",5,"ل",1,0],["هِشامَ بنَ خَيرِ الناسِ إِلّا مُحَمَّداً","وَأَصحابَهُ إِنّي لَكُم لَم أُقارِفِ",6,"ف",1,0],["هِشامٌ فَتى الناسِ الَّذي تَنتَهي المُنى","إِلَيهِ وَإِن كانَت رِغاباً جِسامُها",7,"م",3,0],["هِشامٌ خِيارُ اللَهِ لِلناسِ وَالَّذي","بِهِ يَنجَلي عَن كُلِّ أَرضٍ ظَلامُها",8,"م",3,0],["هِشامٌ أَمينُ اللَهِ في الأَرضِ وَالَّذي","بِهِ تَمنَعُ الأَيّامُ ذاتَ المَحارِمِ",9,"م",1,0],["هَشَّتْ إلى النَّعشِ المُقامِ حِيالَها","لمّا رأتْهُ مُزَخْرَفاً بَرّاقا",10,"ق",2,0],["هَشَّت لِمَطلَعِهِ الأَسِرَّةُ وَالأَسِنّ","ةُ وَالمَحَفِلُ وَالمَحافِلُ وَالظُبى",11,"ب",2,0],["هَشُّ النَدى جَزِلُ الوَقارِ كَأَنَّهُ","بَحرٌ وَطَودٌ إِن حَبا وَإِن اِحتَبى",12,"ب",2,0],["هَشماً لِأَنفِ المُسامي حَينَهُ فَسَما","لِهاشِمٍ فَضلُها فيها اِبنُ صالِحِها",13,"ح",3,0],["هَشَّتْ لآنيتي وأشرَق لونُها","وتردّدتْ أنفاسُها في مَضْجعي",14,"ي",1,0],["هَشَمَتْ وَانْتهَشَتْ وافْتَرَسَتْ","مَا اشْتَهَتْ نَهْمَتُهَا عَلماً وَهَبْرَا",15,"ر",2,0],["هَشّموا نابَي ابن بُرْدٍ وحالوا","بين كاس الطلا وبين ابنِ هاني",16,"ي",1,0],["هشَّت له الفصحى، وأطربها اسُمهُ","فكأنَّ أحرُفه انتظمن قصائدا",17,"د",2,0]]}