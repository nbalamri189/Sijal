{"poems":[[29,"عفا النسران بعدك والوحيد","https://www.aldiwan.net/poem5726.html","الوافر"],[74,"شب الحشا قول الكواعب شابا","https://www.aldiwan.net/poem18236.html","الكامل"],[53,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[93,"كم تشتكي وتقول إنك معدم","https://www.aldiwan.net/poem62676.html","عموديه"],[47,"أفي كل دار منك عين ترقرق","https://www.aldiwan.net/poem65183.html","الطويل"],[47,"لعمري لئن أخلقت ثوب التغزل","https://www.aldiwan.net/poem65650.html","الطويل"],[30,"تصيح به الأصداء يخشى به الردى","https://www.aldiwan.net/poem5319.html","الطويل"],[30,"فرعن وفرغن الهموم التي سمت","https://www.aldiwan.net/poem5547.html","الطويل"],[30,"وإن تميما منك حيث توجهت","https://www.aldiwan.net/poem5548.html","الطويل"],[30,"رأيت سماء الله والأرض ألقتا","https://www.aldiwan.net/poem5612.html","الطويل"],[107,"أعد البناء وجدد الميثاقا","https://www.aldiwan.net/poem43050.html","الكامل"],[83,"هي طلعة السعد الأغر فمرحبا","https://www.aldiwan.net/poem61549.html","الكامل"],[83,"طرقت منقبة تروع تحجبا","https://www.aldiwan.net/poem61559.html","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/1149","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39622","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/142406","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[108,"يا راعي الفصحى","https://www.poetsgate.com/ViewPoem.aspx?id=179702",""],[128,"هشت لمقدمه المدينه","https://www.aldiwan.net/poem23748.html","مجزوء الكامل"],[138,"أنت النبي محمد","https://www.aldiwan.net/poem20996.html","مجزوء الكامل"],[151,"أمسعود جاء السعد والخير واليسر","https://www.aldiwan.net/poem47624.html","الطويل"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[240,"قم قبل إسفار الصباح","https://www.aldiwan.net/poem32117.html","مجزوء الكامل"],[242,"عن نور هديك ثغر الدهر مبتسم","https://www.aldiwan.net/poem19069.html","البسيط"],[242,"حلت حلى حسن الحلى زيدان","https://www.aldiwan.net/poem19294.html","الكامل"],[303,"أمل تدركه العين وأين","https://www.aldiwan.net/poem36859.html","عموديه"],[310,"رسل البشائر ورد وصدور","https://www.aldiwan.net/poem56545.html","الخفيف"],[327,"ألا طال التنظر والثواء","https://www.aldiwan.net/poem56353.html","الوافر"],[358,"لله در عصابة من هاشم","https://www.aldiwan.net/poem39791.html","الكامل"],[406,"نقش على جدار الوطن","https://www.aldiwan.net/poem6788.html","عموديه"],[458,"كاد الخريف يموت مثل مماتي","https://www.aldiwan.net/poem61246.html","الكامل"],[458,"جزيرة النور تحيينا","https://www.aldiwan.net/poem61396.html","السريع"],[458,"أمسائل القدر العتي محيرا","https://www.aldiwan.net/poem61571.html","الكامل"],[463,"تهوى وأنت محلأ مصدود","https://www.aldiwan.net/poem56216.html","الكامل"],[543,"يوم أناخ بباب خير إمام","https://www.aldiwan.net/poem47941.html","عموديه"],[543,"ضنت بهذا اليوم قبل عصور","https://www.aldiwan.net/poem48154.html","عموديه"],[543,"قال البيان لمن أراد مديحه","https://www.aldiwan.net/poem48155.html","عموديه"],[545,"لله درك من فتى فجعت به","https://www.aldiwan.net/poem56626.html","الكامل"],[545,"صرمت حبائلا من حب سلمى","https://www.aldiwan.net/poem56867.html","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62579","المتقارب"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119284","المتقارب"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59436","السريع"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56632","الكامل"],[1479,"","https://poetry.dctabudhabi.ae/diwan/poem/20586","الهزج"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49585","السريع"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87862","الكامل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87825","الخفيف"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48271","الكامل"],[2172,"","https://poetry.dctabudhabi.ae/diwan/poem/18691","الكامل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47172","الكامل"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46745","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93921","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100222","المتقارب"],[2954,"","https://poetry.dctabudhabi.ae/diwan/poem/138925",""],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102383","المتقارب"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114564","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135355","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111452","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90839","الرمل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81283","الخفيف"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83127","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83176","الكامل"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67456","الكامل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52131","الرمل"],[2365,"سلم على قبر الحسين وقل له","https://www.poetsgate.com/ViewPoem.aspx?id=200650",""],[5302,"خير الأحبة نجود","https://www.poetsgate.com/ViewPoem.aspx?id=201738",""],[5897,"تسابيح","https://www.poetsgate.com/ViewPoem.aspx?id=157556",""],[5910,"بردة الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=208729",""],[5943,"كليني ياهموم فلن أبالي","https://www.poetsgate.com/ViewPoem.aspx?id=34857",""],[5943,"تشطير لقصيدة كم تشتكي","https://www.poetsgate.com/ViewPoem.aspx?id=138276",""],[5952,"آخر الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=204836",""]],"verses":[["هِشامُ المُلكِ وَالحَكَمُ المُصَفّى","يَطيبُ إِذا نَزَلتَ بِهِ الصَعيدُ",0,"د",1,0],["هشمت فخارَ العرب هاشمُ واحتوت","حتى القريض لنسلها أسلابا",1,"ب",2,0],["هشاشته للماء تنسجُ متنَهُ","شمالُ خَريقٍ وَهْوَ حَرَّانُ أهْيَمُ",2,"م",1,0],["هَشَّت لَكَ الدُنيا فَما لَكَ واجِماً","وَتَبَسَّمَت فَعَلامَ لا تَتَبَسَّمُ",3,"م",1,0],["هَشَمنَ إِلى اِبنَ الهاشِمِيَّةِ أَوجُهاً","عَوابِسَ لِلبَيداءِ ما تَتَطَلَّقُ",4,"ق",1,0],["هَشيمَةُ ذاتُ الحاجِبَينِ تُعِلَّنا","مُشَمِّرَةً سُقيا لَها مِن مُعَلِّلِ",5,"ل",1,0],["هِشامَ بنَ خَيرِ الناسِ إِلّا مُحَمَّداً","وَأَصحابَهُ إِنّي لَكُم لَم أُقارِفِ",6,"ف",1,0],["هِشامٌ فَتى الناسِ الَّذي تَنتَهي المُنى","إِلَيهِ وَإِن كانَت رِغاباً جِسامُها",7,"م",3,0],["هِشامٌ خِيارُ اللَهِ لِلناسِ وَالَّذي","بِهِ يَنجَلي عَن كُلِّ أَرضٍ ظَلامُها",8,"م",3,0],["هِشامٌ أَمينُ اللَهِ في الأَرضِ وَالَّذي","بِهِ تَمنَعُ الأَيّامُ ذاتَ المَحارِمِ",9,"م",1,0],["هَشَّتْ إلى النَّعشِ المُقامِ حِيالَها","لمّا رأتْهُ مُزَخْرَفاً بَرّاقا",10,"ق",2,0],["هَشَّت لِمَطلَعِهِ الأَسِرَّةُ وَالأَسِنّ","ةُ وَالمَحَفِلُ وَالمَحافِلُ وَالظُبى",11,"ب",2,0],["هَشُّ النَدى جَزِلُ الوَقارِ كَأَنَّهُ","بَحرٌ وَطَودٌ إِن حَبا وَإِن اِحتَبى",12,"ب",2,0],["هَشماً لِأَنفِ المُسامي حَينَهُ فَسَما","لِهاشِمٍ فَضلُها فيها اِبنُ صالِحِها",13,"ح",3,0],["هَشَّتْ لآنيتي وأشرَق لونُها","وتردّدتْ أنفاسُها في مَضْجعي",14,"ع",2,0],["هشّت إلىّ قبور أدمعي عبق","على الرّياحين في أفيائها وندى",15,"د",2,0],["هَشَمَتْ وَانْتهَشَتْ وافْتَرَسَتْ","مَا اشْتَهَتْ نَهْمَتُهَا عَلماً وَهَبْرَا",16,"ر",2,0],["هَشّموا نابَي ابن بُرْدٍ وحالوا","بين كاس الطلا وبين ابنِ هاني",17,"ن",2,0],["هشَّت له الفصحى، وأطربها اسُمهُ","فكأنَّ أحرُفه انتظمن قصائدا",18,"د",2,0],["هشت لمقدمه المدينه","ومشت إلى الطيش الرعونة",19,"ن",2,1],["هَشَمَ الرَبيكَةَ في الجِفا","نِ وَعَيشُ مَكَّةَ أَنكَدُ",20,"د",1,0],["هشوشٌ بشوشٌ يلقى بالرحب قاصداً","وعن مثل حب المزن تلقاه يفترّ",21,"ر",1,0],["هَشَموا فيه بيضةَ الدرعِ حتّى","دَمِيت منهُ جبّةٌ بيضاءُ",22,"ا",2,0],["هَشٌّ إِلى الإِحسانِ ذو","طَرَبٍ إِلَيهِ وَاِرتِياحِ",23,"ح",1,0],["هَشَّتْ لِلُقْيَاكَ فَاسٌ إِذْ حَلَلْتَ بِهَا","وَفَاسُ لَوْلاَ سَنَا وُجُودِكُمْ عَدَمُ",24,"م",1,0],["هَشَّتْ لِلُقْيَاهُ الْجِنَانُ وَحُورُهَا","مُتَسَرْبِلاً بِمَلاَبِسِ الرِّضْوَانِ",25,"ن",1,0],["هشَّ لما طفّلته أُمه","ودنا من وجهها بالراحتين",26,"ن",1,0],["هَشَّت بِمَولِدِ نَجلِهِ فَسَرى بِها","في العالَمينَ بَشاشَةٌ وَحُبورُ",27,"ر",1,0],["هِشامٌ وَالوَليدُ وَكُلُّ نَفسٍ","تُريدُ لَكَ الفَناءَ لَكَ الفِداءُ",28,"ا",2,0],["هَشموه مِن فَرط التَناول بَينَهُم","قَطفاً فَأَصبَح هاشمٌ مَهشوما",29,"م",2,0],["هشت إليك جبال مكتها فما","ذل العزيز ولا تطامنت القنن",30,"ن",1,0],["هشت لي الأغصان وهي جريمة","وتطلعت لخطاي في الغابات",31,"ت",1,0],["هشت لي الأشجار في نشوة","والماء والطير مغنينا",32,"ن",2,0],["هشت أطايبها وكم صدف الورى","عنها وكل نائح بخباله",33,"ل",2,0],["هَشٌّ لصدر اليوم إمَّا مالُه","فيه وإمّا قربهُ المنقودُ",34,"د",1,0],["هَشَّت رياضُ بلاغةٍ فيه فَذا","زَهرُ البديعِ مفتَّحُ الأكمامِ",35,"م",1,0],["هَشَّت رِياضُ بلاغَةٍ وتَفَتَّحَت","فيهِ عنَ أكمامِ البَديع زُهورُ",36,"ر",1,0],["هَشَّ المُحَيَّا عَن خِلالٍ مِثلمَا","يَفترُّ عَن ثَغرِ الزُّهورِ ثَبِيرُ",37,"ر",1,0],["هَشٌّ إِذا نَزَلَ الوفودُ بِبابِهِ","سَهلُ الحِجابِ مُؤَدَّب الخِدّامِ",38,"م",1,0],["هَشَشتَ لحاجَةٍ وَوَعَدتَ أُخرى","وَلَم تَبخَل بِناجِزَةِ السَراحِ",39,"ح",1,0],["هَشوش اللقاءِ إذا جئته","تلقّاك كالطالع الأسعد",40,"د",1,0],["ةشمت البعيد وسمت العبيد","وسفت الصعيد لكسب السند",41,"د",1,0],["هشت لك الدنيا فقابلتها","بالبشر والإقبال والاستلام",42,"م",1,0],["هش المقام الأحمدي لزائر","سبقت عوارفه إليه تبشر",43,"ر",1,0],["هِشامٌ وَأَبو عَبدِ","مُنافٍ مِدرَهُ الخَصمِ",44,"م",1,0],["هَشٌّ إلى داعي النَّدى مُسْرِعٌ","يَسبِقُ وفْدَ القولِ بالفعْل",45,"ل",1,0],["هَشَّ المُقَدِّسُ لِلمُؤَذِّنِ داعِياً","وَحَنا الهِلالُ عَلى الصَليبِ مُسَلِّما",46,"م",2,0],["هَشَّمَ المَوجُ جانِبَيهِ وَأَلقى","بِشِراعَيهِ في غَياهِبِ مائِه",47,"ا",3,0],["هشَمَ الظبا عظمَ الصريم بصارمٍ","سيفِ ابن سالمَ بالوميض حكاهُ",48,"ا",2,0],["هَشٍّ يَراح إلى النَدى نَبهتُهُ","وَالصُبحُ ساطِعُ لَونِهِ لَم يَنجَلِ",49,"ل",1,0],["هَشَّتْ إلى نَيْلِ الإجازة نَفْسُهُ","لمّا رآها للأفاضل مَغْنَمَا",50,"م",2,0],["هَشُّ الفُؤادِ هواءُ الصَّدرِ مُنتَخِبٌ","مُقَلِّصٌ عَن قَميصِ الساقِ مَوطودُ",51,"د",1,0],["هشوش المحيا ضاحك السن دائماً","جليف المعالي ذو الجناب المقدس",52,"س",1,0],["هشمت لهاشم أنفاً أشما","فراحت تلف عليه النقابا",53,"ب",2,0],["هش سمعي إليه من قبل مرآه","سلام على كريم السجيه",54,"ي",2,0],["هشيمٌ منَ الغافِ مُستوقدٌ","يُسنِّنُ ريحاً وزادَ استعارا",55,"ر",2,0],["هششت بوجهٍ ضاحِكٍ للذي أتى","وما كنتَ إلا جنةً فيك ما اشتهى",56,"ه",2,0],["هشيشٌ يَهُشُّ الرأسَ ممَّن عتا وفي","بني هاشمٍ هشمٌ لِمَن ما تنهنها",56,"ه",2,0],["هشَّاشُ بشّاشُ يحب في الله","يبغض في الله ويغضب في الإلهِ",57,"ه",1,0],["هَشَّت لَها واستَضَمَّتها لِمُهجَتِها","ذِيُونَةٌ تَستَقِصُّ الأَمرَ بالعَجَبِ",58,"ب",1,0],["هشموا ريحانتي زهرائه","واضاعوا بعده ما وضعه",59,"ع",2,0],["هَش أَهرامها وَقامَ أَبو الهَو","ل يَحيي عَلى المَدى سودانه",60,"ن",2,0],["هَشَّت لَهُ في ثَرى البَيداءِ أَعظمهم","وَكادَ يُسمَع مِنها الشعرُ وَالخُطَبُ",61,"ب",1,0],["هَشٌّ لِزائِره أَأَكثَر أَم وَنى","لَم يَلقَه سَئِماً وَلا مُتَمَنِّعا",62,"ع",2,0],["هشم الثريد لقومه","والناس في محل شديد",63,"د",1,0],["هشَّ للنتِ وقد حيّا الشقيقْ","وهو لا يحسبُه إلاّ رفيقْ",64,"ق",1,0],["هشموا بهاشمة وحاق بهم","ما قدّموا من سىء المكر",65,"ر",1,0],["هش بشوش وجهه متبسم","فالوجه طلق والدلال طليق",66,"ق",1,0],["هشَّتْ له الأغصانُ في خشوعٍ","توضأتْ من فيضهِ الزهورُ",67,"ر",1,0],["هشَّتْ إليكَ الأرضُ تزهو مثلما","تزهو العروسُ فلا تزالُ منعَّمَهْ",68,"م",2,0],["هشاشةُ فكرهِم داءٌ خطيرٌ","يصيدُ الرُّوحَ إن وعيًا عمينا",69,"ن",2,0],["هشَّتْ لكَ الدنيا فمالَكَ واجمٌ","(بالْبُؤْسِ تُهمِلُهَا وَعَنْهَا تُحْجِمُ",70,"م",1,0],["هشّت على الذكرى عصيُّ حنينهم","ماذا ستفعل في زئير أسودِ",71,"د",1,0]]}