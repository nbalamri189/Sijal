{"poems":[[61,"","https://poetry.dctabudhabi.ae/diwan/poem/116971","البسيط"],[276,"أهاب سحيرا بالفراق مهيب","https://www.aldiwan.net/poem52070.html","الطويل"],[398,"قد ظل يجرح صدري","https://www.aldiwan.net/poem53660.html","المجتث"],[445,"نجوم الصبا أين تلك النجوم","https://www.aldiwan.net/poem34849.html","المتقارب"],[580,"لا وأرض القلوب ذات الصدع","https://www.aldiwan.net/poem3052.html","الخفيف"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54149","البسيط"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39151","المتقارب"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77650","الرجز"],[1415,"","https://poetry.dctabudhabi.ae/diwan/poem/102323","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53211","السريع"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146343","البسيط"],[3133,"","https://poetry.dctabudhabi.ae/diwan/poem/203954","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138554",""],[3825,"","https://poetry.dctabudhabi.ae/diwan/poem/206310","المتقارب"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123867","الطويل"],[5253,"أبت كبدي لا أكذبنك قتالهم","https://www.poetsgate.com/ViewPoem.aspx?id=79437",""],[5490,"عجبا ضميري","https://www.poetsgate.com/ViewPoem.aspx?id=176342",""],[5952,"أسير شُرْفةٍ وناي","https://www.poetsgate.com/ViewPoem.aspx?id=213322",""]],"verses":[["وكيفَ قرّت لأهل العلمِ أعينُهُم","أو استلذّوا لذيذّ النوم أو هجعوا",0,"ع",3,1],["وَكَيفَ قفو لي نحو بيت نويرة","وَقَد ساءَني يوم هناك عصيب",1,"ب",1,0],["وَكَيفَ قَد جَحَدوهُ","مَع كلِّ فَضلٍ وَفَخر",2,"ر",1,0],["وكيف قضى حُكْمُ هَذَا القضاءِ","عليَّ لدهرِيَ وَهْوَ الظَّلُومُ",3,"م",1,0],["وكيف قَد زِيد في دَم العين عَيْنٌ","أَنا أُجري دَمي فَلِمْ قيل دَمْعي",4,"ع",2,0],["وكيف قابله من فقد خطبهما","بمذهب مذهب للأنس والجذل",5,"ل",1,0],["وكَيْفَ قَرأْتَ حُرُوفَ اسْمِهِ","من الجِهَتَيْنِ هَدَتْكَ الغَرَضْ",6,"ض",1,0],["وَكيفَ قط هرمٌ يُسامِح","وَبِك قَد مُنحتُ جلَّ المانِح",7,"ح",1,0],["وكيف قران الشمس والبدر كلما","غدا يلثم الكأس الذي في يمينه",8,"ن",2,0],["وكيف قد أشرق في شعره","فاختلط الصبح بجنح الظلام",9,"م",1,0],["وكيف قربُك لم يصْقُل خلائقهم","وقد يُضيء بقُربِ الكوكبِ الغَسَق",10,"ق",1,0],["وكيف قتالي معشرا أدَّبوكمو","على الحق أن لا تأشبوه بباطل",11,"ل",1,0],["وكيف قسي القوم أو تارهن ما","تقطعن إذ أصمت حشاه باسهم",12,"م",1,0],["وكيف قمرنا بها من يَدَيْ","ك لاعبةً بيدَيْ مَنْ لَعِبْ",13,"ب",1,0],["وكيف قضى الراي الشريف بخيبتي","واهملني المولى المنيف المعظم",14,"م",1,0],["وكيف قتالي معشرا أدبوكم","علي الحق أن لا تأشبوه بباطل",15,"ل",1,0],["وكيف قسمتُ بين الناس حبي","وكم أربيت في صدري حناني",16,"ن",2,0],["وكيف قد صار سور فاتنتي","يحكي الأقاصيص يَسْطُرُ السِّيرا",17,"ر",2,0]]}