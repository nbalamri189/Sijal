{"poems":[[39,"من لقلب متيم مستهام","https://www.aldiwan.net/poem7649.html","الخفيف"],[138,"ألم ترني من بعد هم هممته","https://www.aldiwan.net/poem21037.html","الطويل"],[463,"هل تحت ليلك بالغضا من رائد","https://www.aldiwan.net/poem56217.html","الكامل"],[505,"وطد فؤادك كلنا عشاق","https://www.aldiwan.net/poem37944.html","الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126736","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95558","الرمل"],[1876,"","https://poetry.dctabudhabi.ae/diwan/poem/104460","الرمل"],[2384,"","https://poetry.dctabudhabi.ae/diwan/poem/123655","الرمل"],[4718,"ياقلب هون قل التوبه","https://www.poetsgate.com/ViewPoem.aspx?id=137251",""],[5061,"ياوطن","https://www.poetsgate.com/ViewPoem.aspx?id=147162",""],[5573,"البارحه خايلت وصلك سحابه","https://www.poetsgate.com/ViewPoem.aspx?id=213729",""],[5652,"ماكلهم صدّام لو بانو على العالم صِدام ؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=180634",""]],"verses":[["وإلى يَثرِبَ التَّحَوُّلَ عَنها","لِمَقَامٍ عَن غَيرِ دار مُقامِ",0,"م",1,0],["وَآلى يَميناً بَرَّةً إِنَّ زادَنا","كَثيرٌ عَلَيهِ اليَومَ غَيرُ حَرامِ",1,"م",1,0],["وإلى يمين الدولة افتقرت يدٌ","في الملك لم تُعضَدْ سواه بعاضدِ",2,"د",1,0],["وإليَّ يا ظَبيَ النَّقا حَيَّرْتَني","فَلَكُمْ لِقاءٌ مُقْلِقٌ وفِراقُ",3,"ق",1,0],["وَإلى يزيد قد سروا في رأسهِ","وَالشامِتونَ علاهمُ اِستبشارُ",4,"ر",1,0],["وإلى يوم اللقاء المُرتقب","ثم قرير العين فى خلد سمَأ",5,"م",2,0],["وإلى يمكان قد ألقى الزمان","مقود الطاعة في جاه ومال",6,"ل",1,0],["وإلى يسراي أخرى مثلها","طفلة بظلم من فيها خدش",7,"ش",1,0],["والي يذوق الهواء نوبه","يدمن على المر والحالي",8,"ل",2,0],["والي يدعثر فَ الوطن ويظاهر","يندم على فعله وزود هبالہ",9,"ل",1,0],["والي يضيع في حياته صوابه","دنياه ماتسوى ولا فرسن الشات",10,"ت",1,0],["والي يبي هرجٍ يجافي من مجافيه احتدام","عليه باللي فعلها يمحي سوايا سيّته",11,"ت",2,0]]}