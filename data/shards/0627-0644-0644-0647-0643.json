{"poems":[[87,"قف ناج أهرام الجلال وناد","https://www.aldiwan.net/poem63772.html","الكامل"],[51,"الله كاف فمالي دونه كاف","https://www.aldiwan.net/poem62178.html","البسيط"],[52,"أقوى وعطل من فراطة الثمد","https://www.aldiwan.net/poem63936.html","البسيط"],[203,"دجا الظلام فيا ليلى أما فينا","https://www.aldiwan.net/poem45159.html","البسيط"],[325,"بداية الأمر في عشقي ونشأته","https://www.aldiwan.net/poem67234.html","البسيط"],[396,"الله كان ولا شيء معه","https://www.aldiwan.net/poem54474.html","عموديه"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126880","الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126790","البسيط"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126891","الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126815","البسيط"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130628","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27806","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27992","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28007","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27800","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27324","البسيط"],[2371,"","https://poetry.dctabudhabi.ae/diwan/poem/142608","البسيط"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67244","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94209","الكامل"],[3318,"","https://poetry.dctabudhabi.ae/diwan/poem/138767",""],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112401","السريع"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138519",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138580",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138533",""],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83126","الكامل"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89572","الكامل"],[4929,"العراق الحر","https://www.poetsgate.com/ViewPoem.aspx?id=207477",""],[5106,"هذا حَبيبي بِوجهِ الفَجرِ ينتظمُ","https://www.poetsgate.com/ViewPoem.aspx?id=139107",""],[5362,"يا من تفرد بالجمال وصبه","https://www.poetsgate.com/ViewPoem.aspx?id=170377",""],[5397,"بشرا بوجهك ثغر الدهر مبتسم","https://www.poetsgate.com/ViewPoem.aspx?id=157924",""],[5506,"إن جِئتَ بَدراً فَطِب وَاِنزِل بِذي سَلَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=115770",""],[470,"يا سيدى المتنبى","https://www.poetsgate.com/ViewPoem.aspx?id=63453",""],[5732,"الله كفيل الناس وارضه وسيعه","https://www.poetsgate.com/ViewPoem.aspx?id=177863",""],[5956,"الله كرَّر لي نبيلِ ميشيلِ","https://www.poetsgate.com/ViewPoem.aspx?id=194195",""],[5956,"لله درُّ الأريحية سامِيا","https://www.poetsgate.com/ViewPoem.aspx?id=208562",""],[5976,"خالي راشد (مرثيّه)","https://www.poetsgate.com/ViewPoem.aspx?id=33700",""],[6102,"خَيال ..","https://www.poetsgate.com/ViewPoem.aspx?id=183991",""],[6102,"طالق ..","https://www.poetsgate.com/ViewPoem.aspx?id=184436",""],[6102,"كبرياء","https://www.poetsgate.com/ViewPoem.aspx?id=184856",""],[6108,"بيروت","https://www.poetsgate.com/ViewPoem.aspx?id=192389",""],[6115,"الله كم طولت حلمي وصبري","https://www.poetsgate.com/ViewPoem.aspx?id=180540",""],[6149,"سبحان من صاغه وكون","https://www.poetsgate.com/ViewPoem.aspx?id=169628",""],[6152,"أمطار مكة المكرمة","https://www.poetsgate.com/ViewPoem.aspx?id=204736",""]],"verses":[["اللَهُ كَرَّمَ بِالبَيانِ عِصابَةً","في العالَمينَ عَزيزَةَ الميلادِ",0,"د",1,0],["اللَهُ كافٍ فَمالي دونَهُ كافِ","عَلى اِعتِدائي عَلى نَفسي وَإِسرافي",1,"ف",2,1],["اللَهُ كانَ وَما كانَت فَكَوَّنَها","وَما بِها غَيرُكُم مِن أَهلِها سَنَدُ",2,"د",1,0],["الله كوَّنهُ تكوين مرحَمَةٍ","وكوَّن الناسُ بعد اللهِ تكوينا",3,"ن",2,0],["اللَهُ كَمَّلَهُ وَالنَصرُ تَمَّ لَهُ","فَمَن تَعنَتُهُ المَولى يَعنَتُهُ",4,"ت",2,0],["الله كان ولا شيء معه","وهو ما عليه الآن كان",5,"ن",1,1],["اللّه كيفَ قضى الهمامُ المقتدى","مأوى العفاف وملجأ المسكينِ",6,"ن",1,0],["اللّه كيفَ عمادُ المُسلمينَ هوى","فَمُذ هَوى قلبُ أبناء الهدى اِنصدَعا",7,"ع",2,0],["اللّه كم مِن موقفٍ لأبي الرضا","أضحت بهِ تتحدّث الركبانُ",8,"ن",1,0],["اللّه كَم حلّ بالإسلام من نوبٍ","وكَم أصاب الهدى من حادث جللِ",9,"ل",1,0],["اللّه كيف سعت لكم من شانيء","قدم واولوكم عنا وحبوسا",10,"س",2,0],["الله كرَّمهم بعلمِ وجودِه","وسقاهمُ كاسَ العلومِ زُلالا",11,"ل",2,0],["الله كرَّمه إذ كان فضله","على سواه فلم يسنن ولا ابتدعا",12,"ع",2,0],["الله كرمها جوداً وأهلها","لكلِّ صالحةٍ تأهيلُ معشوق",13,"ق",1,0],["الله كرَّمنا بدولة أحمد","كرماً يعم شرائعَ الإحسانِ",14,"ن",1,0],["الله كرَّمَ من هذي سجيَّته","ونعته فإذا يدعوه لَّباه",15,"ا",2,0],["الله كم يعذلون","هالناس في حبنا",16,"ن",2,1],["الله كم فتكت في الناس عيناك","فإنِّني لا أرى منه سوى شاكي",17,"ك",2,1],["اللَه كرم أهل بيت نبيه","وأمد من وافاهم من وافدين",18,"ن",1,1],["اللهُ كَم رَعشةٍ لي مِنه مُهلِكةٍ","كَالصَّبِّ إذ هَزَّهُ لِلحُبِّ تِذكَارُ",19,"ر",1,0],["الله كم مرّت علَيهِ سنون","كَأنّهُ في الليلَةِ البارحَه",20,"ه",1,0],["الله كيف تأمرت أوعادها","في المسلمين وأخرت أمجادها",21,"د",3,1],["الله كم كابد ابن المصطفى نوباً","حياً وميتاً من الأعداء طغيانا",22,"ن",2,1],["الله كيف تتبعوها بالأذى","حتى بمثوى كان فيه حلولها",23,"ل",3,0],["اللَهُ كافِلُ أَمرِكُم وَمُعزُّكُم","بِنَصيرِ مِصرَ وَسَيدِ الزُعَماءِ",24,"ا",2,0],["اللَهٌُ كَمَّلَكُم بِشَأوِ كَمالِهِ","يا حَبَّذا شَرَفٌ سَنِيٌّ راقي",25,"ق",2,0],["الله كرمها والشرع قدسها","والموت فيها جهادٌ فرضه وجبا",26,"ب",2,0],["اللهُ كَمْ أُتْرِفَتْ رُوْحِيْ بِعِصْمَتِهِ","كَأَنَّمَاْ نَفَسَيْ مِنْ رُوْحِهِ رَحِمُ",27,"م",1,0],["الله كم حملت قلبي في الهوى","محنا وكم مني حملت ذنوبا",28,"ب",2,0],["الله كونه نورا بقدرته","وشكله فوق ساق العرش مرتسم",29,"م",1,0],["اللَه كمَّلَه وَالقرب جمَّلَه","وَالحُبُّ فضَّلَهُ مِن سالِفِ القِدَمِ",30,"م",1,0],["الله كم كان ضخماً فى مروءته","وكم تأبد فيه النبل والقدم",31,"م",1,0],["الله كفيل الناس وارضه وسيعه","عالم خفايا نية الجاحديني",32,"ن",2,0],["الله كرَّر لي نبيلَ ميشيلِ","بنبيلَ ميخائيل تاجِ النيلِ",33,"ل",1,1],["الله كأفأني بها كخياليا","ما حَنَّ مسؤولٌ عَليَّ كما هِيا",34,"ي",2,0],["الله كتب هالفاجعه والمطمّه","والحمد للمولى على كلّ حالي",35,"ل",2,1],["اللَّهُ! كَيفَ القَلبُ ثارَ! وَلَم يَتُبْ","عَن رِعشَةٍ بِشَغافِهِ تَختالُ؟",36,"ل",1,0],["اللَّهُ! كَيفَ أَرُدُّ لِي نَفسِي؟ وَقَد","ضَلَّتْ وَضَلَّ بِتِيهِها التَّرحالُ!",36,"ل",1,0],["اللَّهُ ! كَيفَ الإِصبَعُ المَمدُودُ - مِن","بَينِ البَنانِ - تَثُورُ فِيهِ حَرائِقُ ؟",37,"ق",1,0],["اللَّهُ ! كَيفَ نَطَقتَها كَقَذِيفَةٍ ؟","وَقَعَتْ شَظاياها بِقَلبِي : ( طالِقُ )",37,"ق",1,0],["اللَّهُ ! كَيفَ تَلاحَمَتْ نَظراتُنا","وَ كَأَنَّ بَينَ عُيُونِنا مِيثاقُ !",38,"ق",1,0],["الله كرّمنا، وسخّر غيرنا","ولكلِّ عقلٍ حجةٌ وثبوتُ",39,"ت",1,0],["الله كم طوّلت حلمي وصبري","والقلب عاف عن التصبّر .. ويابيه",40,"ه",1,1],["الله كم من دقيق معنى","للحسن ذاك الوشاح بين",41,"ن",1,0],["الله كم أحيت شجون غرامي","وشفت جراحي بعد طول سقامي",42,"م",2,1]]}