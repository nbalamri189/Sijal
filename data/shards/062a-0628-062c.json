{"poems":[[53,"مستقبل خائفه الصفح مستقبل آمنه المنح","https://www.aldiwan.net/poem9400.html","السريع"],[91,"تبجل الامة ياسينها","https://www.aldiwan.net/poem44629.html","السريع"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67349","المتقارب"],[111,"تلك البوارق حاديهن مرنان","https://www.poetsgate.com/ViewPoem.aspx?id=100",""],[92,"احمد شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=179129",""],[119,"تبجح كاذب خب لئيم","https://www.aldiwan.net/poem40498.html","عموديه"],[505,"رأى حاسدي شأني فخامره عمى","https://www.aldiwan.net/poem37777.html","الطويل"],[568,"تبجحت عند الموت والموت بغيتي","https://www.aldiwan.net/poem13619.html","الطويل"],[2439,"","https://poetry.dctabudhabi.ae/diwan/poem/146008","الطويل"],[585,"خذوا بيدي فالدهر جاشت غواربه","https://www.poetsgate.com/ViewPoem.aspx?id=161927",""],[5596,"رد على خليل الجابري","https://www.poetsgate.com/ViewPoem.aspx?id=206719",""]],"verses":[["تَبْجَحُ عدنانُ بأيامه","طُرّاً وما مِنْ شأنِهِ البجْحُ",0,"ح",1,0],["تبجل الامة ياسينها","فحب ياسين لها دين",1,"ن",1,1],["تبجَّسْتَ تَهْجُو رَسُولَ المَلِي","كِ قَاتَلَكَ اللهُ جلفاً لَعِينَا",2,"ن",2,0],["تبجست بهزيم الودق منبثقا","حتى تساوت به أكم وقيعان",3,"ن",1,0],["تُبَجَّلُ فيه مزايا الشُعور","على حينَ في غيرهِ تًحتَقَر",4,"ر",1,0],["تبجح كاذب خب لئيم","وظلما خاض في عرض الكريم",5,"م",1,1],["تَبَجْبِحْ بإحْساني وقُمْ بعِنايَتي","قويًّا وطارِحْ حاسِداً ما له عزْمُ",6,"م",1,0],["تَبَجَّحتُ عِندَ المَوتِ وَالمَوتُ بُغيَتي","وَلَو كُنتُ هَتّاكاً لِما اللَهُ حَرَّما",7,"م",2,1],["تبجح بأولاد كرام كأنهم","نجوم إذا لاحت وطلعتك البدر",8,"ر",1,0],["تبجس بالإعجاز في القول ملهماً","فهش له التنزيل واعتز جانبه",9,"ب",2,0],["تبجّس عذْبُه أيَّ انبجاس","فشقّ نميره صُمّ الرواسي",10,"س",2,1]]}