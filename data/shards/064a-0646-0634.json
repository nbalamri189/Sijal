w.poetsgate.com/ViewPoem.aspx?id=185085",""],[5672,"ما لم يقله رؤبة بن العجاج","https://www.poetsgate.com/ViewPoem.aspx?id=213612",""],[402,"مليكتانا أدام الله عزهما","https://www.poetsgate.com/ViewPoem.aspx?id=36529",""],[5943,"إنْ كانَ فيكم نخوةٌ ومروءةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=11267",""],[5956,"الأديان والمذاهب والطوائف","https://www.poetsgate.com/ViewPoem.aspx?id=192181",""],[6052,"قبة الامام علي الهادي","https://www.poetsgate.com/ViewPoem.aspx?id=53825",""],[5309,"أيها الشاكي ولا ناصر له","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573539",""],[6164,"الثمانون؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66038&r=&rc=48",""],[1583,"أتنسى؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73017&r=&rc=8",""],[6318,"مهرجان القصيد (1)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66156&r=&rc=6",""],[572,"تُرِيكَ مُرورُ الليالي العِبَرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9276&r=&rc=133",""],[4890,"حيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72371&r=&rc=62",""]],"verses":[["يَنشُطُ البُلغَةَ مِن آكِلِها","نِشطَةَ المَطرودِ وَلّى وَهوَ خالي",0,"ل",2,0],["يُنْشِئُ الفَتَيَاتِ الصَّالِحَاتِ لِمَا","يُرْجَى بِهَا مِنْ صَلاحِ الحَالِ وَالشْانِ",1,"ن",1,0],["يَنشُدُ في حَيٍّ مَعَدٍّ أَبا","ضَلَّ عَن المَنشودِ وَالناشِدِ",2,"د",1,0],["ينشد فيها شعره المبتكر","ولا يني فيه ولا يأتلي",3,"ي",1,0],["يَنشَقُّ عن حَدِّها الأتِيُّ كَمَا","شُقَّت مَآلِي المَآتِمِ القُشُبُ",4,"ب",1,0],["ينشق عن حدها اللاقيّ كما","شقت إلى الماتم القشب",5,"ب",1,0],["ينشر العدلَ أو يبثُّ العطايا","فهو زاكي الترغيب والترهيب",6,"ب",1,0],["ينشي وينشد فيه الثغر من أسفٍ","بيتاً تكاد له الأحشاء تضطرم",7,"م",1,0],["ينشد من ودِّك الجميل ومن","مدحكَ في صدرِهِ وفي فيه",8,"ف",3,0],["يُنْشفُ القلبُ ماءه حين تُمْلَى","قبل نشْفِ الهواء ماءَ مدادِهْ",9,"د",2,0],["ينشُدني العهدَ يومَ ذلك وال","عهدُ خِضابٌ أذاله فنضا",10,"ض",2,0],["ينشدنا اللهو عند طلعته","من أوحشتْه البلاد لم يقمِ",11,"م",1,0],["يُنشِدونَ الوَغى وَما يُنشِدُ","الحَسناءَ غَيرُ المُتَيَّمِ المَعمودِ",12,"د",1,0],["يُنشِدُ النَّحْلُ حوالَيْها","أَهازيجاً طِرابْ",13,"ب",1,0],["يَنْشُدُونَ الجمالَ والنُّورَ والأَفراحَ","والمجدَ والحَيَاةَ النبيلهْ",14,"ه",1,0],["ينشأ المرء من تراب وماء","واخيراً اليهما يستحيل",15,"ل",1,0],["يَنشُدُ مِن ذا الخِشفِ ما لَم يَفقِدِ","فَثارَ مِن أَخضَرَ مَمطورٍ نَدي",16,"د",2,0],["يَنشُرنَ وَشياً مُذهَباً وَمُدَبَّجاً","وَمَطارِفاً نُسِجَت لِغَيرِ المَلبَسِ",17,"س",1,0],["يَنشُدنَ في إِرَمٍ وَالنُجحُ في إِرَمٍ","غِنىً عَلى سَيِّدِ الساداتِ مَضمونا",18,"ن",2,0],["يَنشَقُّ ثَوبُ الدُجى عَن نورِ غُرَّتِهِ","كَالشَمسِ تَنجابُ عَن إِشراقِها الظُلَمُ",19,"م",1,0],["يُنشِدنَ مِن رائِعاتِ الآيِ مُطرِبَةً","يَزِدنَها حُسنَتَرديدٍ وَتَرتيلِ",20,"ل",1,0],["يُنَشَّرُ في الدُنِّيا الحَديثُ وَيَنطَوي","وَتَفرِسُ آسادُ العَرينِ وَتُفرَسُ",21,"س",1,1],["يَنشُرُ الدُّرَّ في المَسامعِ نَشْراً","بينَ دُرٍّ مُنظَّمٍ مُسْتاقِ",22,"ق",1,0],["يُنْشِدُ الحَفْلَ فَاتِناً كُلَّ لُبٍ","بِبَدِيعِ الإِيمَاءِ والإِنْشَادِ",23,"د",1,0],["يُنَشِّيءُ نَابِتَةً حُرَّةً","لِمِصْرَ وَيَبْنِي الرِّجَالَ النُّخَبْ",24,"ب",1,0],["يُنْشِدْنَ مِنْ وَصْفِ المَخِيلَةِ جَلْوَةً","لَعَرُوسِ شِعْرٍ زَيْنَةٍ هَيْفَاءِ",25,"ا",2,0],["ينشَطُ الفكرُ بالذيوع ويزكو","وزكاء اليَنبوعِ في جريانه",26,"ن",2,0],["يَنْشُرُ لي ذِكْراه نَشْرَ الصَّبا","وبارقٌ لاحَ بأعلى البُراقْ",27,"ق",1,0],["ينشر اللّحن في الوجود ويطوي","بين أضلاعه الجراح الدّخيلة",28,"ل",2,0],["ينشُدون الناس أحراراً وهم","ملأوا البيتَ عبيداً وإماء",29,"ا",2,0],["ينشدلك حيله .... وينهد حيله","الحزن خطوه والغرابيل خطوات",30,"ت",1,0],["يَنْشَأُ الطِّفلُ يَتيمًا مُعْدَمًا","صنعَ الحَرْبُ لِساقَيْهِ عَرَجْ",31,"ج",1,0],["ينشر لي لذتي كما ينشر الصيف","بعيد الشتاء والمطر",32,"ر",1,0],["يُنشِدنَ ألحانَ الحَنان","تَحظى بلذَّاتِ الوِصال",33,"ل",1,0],["ينشا الصغير على الذي","في مثله نشأ الكبير",34,"ر",1,1],["ينشي فينثينا سلافة سجعه","رشف الرحيق وقهوة الانشاء",35,"ا",2,0],["يَنِشُّ بِشِدقِهِ زَبَدٌ حَرورٌ","وَيَنفُثُ صَدرُهُ حُمَماً أَحَرّا",36,"ر",2,0],["يَنشُدُ المَكرُماتِ في كُلِّ أَرضٍ","لَيسَ فيها عَمّا أَضَلَّ مُبينُ",37,"ن",1,0],["يَنشُرُ مِنها بِكُلِّ نادٍ","لَطائِماً نَشرُها يَضوعُ",38,"ع",1,0],["يُنْشِي بِبَهْجَتِهِ وَحُسْنِ صَنْعَتِهِ","أَضْعَافَ أَنْشَاءِ مَا يَحْوِيهِ مِنْ سَكَرِ",39,"ر",1,0],["يَنشقُّ كُلُّ دَجنٍ","عَنها وَيَنصَدِع",40,"ع",1,0],["ينشا بمكة وَالمقام بيثرب","سَيَقوم بين مصدق وَمكذب",41,"ب",1,0],["يَنشُرُهُ الشَوقُ وَيَطويهِ كَما","يُعيدُهُ غَرامُهُ وَيُبدي",42,"د",2,0],["يُنشي فَيُنسِي من تَقَدَّمَ قَبلُ وَال","أَفراحُ تُنسَى عِندَها الأَتراحُ",43,"ح",1,0],["ينشد الجسم روحه من ظباها","ودماها بين النقا والعقيق",44,"ق",1,0],["يَنشَرِح الصَدر اِذا زُرتَهُ","وَتَنجَلي عَنكَ الهُموم العِظام",45,"م",1,0],["يُنشي سَما نَقعٍ وَوا","بِلُ مُزنِها السُمُّ النَقيعُ",46,"ع",1,0],["ينشدك الزاد وكنت الزبا","قمت اليه بالقفيل ضربا",47,"ب",2,0],["ينشنه نوشاً بأمثال السطع","بكل شعشاع كجذع المزدرع",48,"ع",1,1],["ينشر البرق على أكتافه","حين يعتم هناك السحبا",49,"ب",2,0],["ينشأ في حجر المعالي والعلى","على ظهور الضُمَّر السوابق",50,"ق",1,0],["ينشُدُ من ينشُدُ أوصافَهُ","علقمُ ما أنت الى عامرِ",51,"ر",1,0],["يُنْشِقُها نقْعُهُ غباراً","يشُمُّه الراغم الذليلُ",52,"ل",1,0],["ينشرُ منها المنشدون بُردةً","أو من رياض الحَزنِ عيناءَ أُنُفْ",53,"ف",1,0],["ينشُدُ منكم وطراً فاته","ويسأل الرُّكبانَ مستخبِرا",54,"ر",2,0],["ينشده بين البدور في الدجى","على غصون البان في كثبانها",55,"ن",3,0],["يُنشِدُنا مِن شِعرِهِ الغَثِّ ما","إِن سيلَ عَن مَعناهُ لا يَفهَمُه",56,"م",2,0],["يَنْشُدُ فيهِ قلبَهُ","وكم عساهُ يَنْشُدُه",57,"د",2,0],["ينشر السعد عليه برقعاً","عاجزٌ تسعفهُ لحظتنا",58,"ن",2,0],["ينشرن في كل سمع","ذماً ويطوين حمدا",59,"د",2,0],["ينشي لهم في كل وجه مدحة","سحبت مطارفها على سحبان",60,"ن",1,0],["ينشط المرء من عقال إذا ما","صرخ الناي حيث راق الغناء",61,"ا",2,0],["ينشر الله رحمة ويهيئ","لهمو مرفقاً من الأمر باهي",62,"ي",1,0],["يَنْشِبُ في يافُوخِهِ والجِيْدِ","مَخَالِباً أمْضَى مِنَ الحَدِيْدِ",63,"د",1,0],["يَنْشر لها الآمالَ إِذ","تُطْوى لَهَا البَسابِسْ",64,"س",1,0],["يَنشُقُ النّاشِقُ مِن مَلمَظِها","نَفحَةَ المِسكِ وَذَوبَ العَسَلِ",65,"ل",1,0],["يُنشِي القصائدَ كالنجومِ مُضِيئةً","تبدو لنا من فكرهِ المُتَوَقّدِ",66,"د",1,0],["ينشأ فيهم مثل تيمور لنكِ","لي وأتيلاذي القوَى والفتكِ",67,"ك",1,0],["ينشرن فضلك إن فضلك باهر","قامت علينا من شواهده الحُججْ",68,"ج",1,0],["يَنْشُرُ العَدْلَ أوْ يَبُثُّ العَطَايَا","فَهْوَ مِلْءُ العُيُونُ مِلْءُ الكُبُودِ",69,"د",1,0],["يَنشَقُّ أَخضَرُها عَن أَبيَضٍ يَقَقٍ","كَالثَغرِ يُشرِقُ تَحتَ الشارِبِ الخَضِرِ",70,"ر",1,0],["ينشي بوصف خلالكم","درر المديح وينظمُ",71,"م",1,0],["ينشي في حمد محاسنها","تمداحاً كالمسك العاطِرْ",72,"ر",1,0],["ينشي الدعاء ولكما قد أرخو","ها جاد يا استير دمتِ للأزلْ",73,"ل",1,0],["ينشي نهيقاً به يلتذَ مفتخراً","في صوته يحسب التنهيق تلحينا",74,"ن",2,0],["ينشيه عقداً لمنشى","عقد الثناء نقولا",75,"ل",2,0],["يُنشدني أشعارهَ دائبا","وشعرهُ من طِيبهِ متعَه",76,"ه",1,1],["يَنشَطُ ضِلِّيلُ الهَوَى لِوَعظِهِ","مُقتَبِساً مِن لَفظِهِ ولَمظِهِ",77,"ه",1,0],["يُنَشنِشُ الجلدَ عنه وهي باركةٌ","كما تُنِشنشُ كفَّا فَاتل سلبا",78,"ب",2,0],["يَنشُرنَ نَقعَ القاعِ حينَ يَطَأنَهُ","وَيُطِرن أَفراخَ الحَصا بِالغَرقَدِ",79,"د",1,0],["ينشقُ طيب الفخار محضاً","من عطف عليائه يفوحُ",80,"ح",1,0],["ينشر الحيُّ من طوى الموت منهم","ويعيد الباقي حياة الفاني",81,"ن",2,0],["ينشر عَلَى روس الريادي","فَضْل الله وفَضْله له شْهود",82,"د",1,0],["ينشي العلوم بها فيهتف من يرى","إنشاءه سبحان من أنشاها",83,"ا",3,0],["ينشد في أبنائه من قضى","أيامه برّاً به واصلا",84,"ل",2,0],["يَنشُدُ الحُسنَ حَيثُ لاحَ لِعَينَي","هِ أَفي البيدِ أَو أَعالي الجِبالِ",85,"ل",1,0],["ينشد في كل حمى ومشهدِ","بشرى لذاك السيد الممجد",86,"د",1,0],["يُنشدُ المْنْصِفُ في تَوصِيفهَا","شعرَ تَمامٍ وَبَيتَ الهُذَلي",87,"ل",2,0],["ينشقُّ عنه الحِبرُ نُوراً ساطعاً","كالنَّجمَ أَتلَعَ في الدُّجُنَّة جيدا",88,"د",2,0],["يُنشي الطلاقة في وجوه وفوده","حتى كأن الحسن من حسناته",89,"ت",2,0],["ينشي لنا كل جمعة عظةً","يشلي علينا بها الشياطينا",90,"ن",2,1],["ينشر فوق الأرض ندّ الندى","وقد طوت أيديه نار القَتام",91,"م",1,0],["ينشئ من نقعه سحاباً","تنهلّ منه السهام قطرا",92,"ر",2,0],["ينشىء من الأعراض أجساما كذا","بالعكس كل قابل الامكان",93,"ن",1,0],["ينشيه ر