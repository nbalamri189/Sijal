ا أيها الساري","https://www.aldiwan.net/poem47781.html","البسيط"],[554,"من عذيري من سقام","https://www.aldiwan.net/poem48076.html","مجزوء الرمل"],[554,"شد غروض المطي مغتربا","https://www.aldiwan.net/poem48085.html","المنسرح"],[554,"من لداع لا يجاب","https://www.aldiwan.net/poem48097.html","مجزوء الرمل"],[556,"لا يرحل الشيب عن دار أقام بها","https://www.aldiwan.net/poem68300.html","البسيط"],[556,"أجررت حبل خليع في الصبا غزل","https://www.aldiwan.net/poem68432.html","البسيط"],[561,"هي قامت بنفسها لذويها","https://www.aldiwan.net/poem33637.html","الخفيف"],[561,"لا يرى الفقه الإلهي","https://www.aldiwan.net/poem33673.html","مجزوء الرمل"],[561,"إنني قد شفني السقم","https://www.aldiwan.net/poem34089.html","المديد"],[561,"كل من بالناس يختلط","https://www.aldiwan.net/poem34409.html","المديد"],[561,"فرحي يا فرحي يا فرحي","https://www.aldiwan.net/poem34662.html","الرمل"],[562,"أيها اللائم رفقا","https://www.aldiwan.net/poem69350.html","مجزوء الرمل"],[565,"إن كنت بالله في دنياك تعتصم","https://www.aldiwan.net/poem52850.html","البسيط"],[572,"إن أدع مسكينا فما قصرت","https://www.aldiwan.net/poem52007.html","أحذ الكامل"],[578,"أما الغرام بها فعاد كما بدا","https://www.aldiwan.net/poem3079.html","الكامل"],[745,"","https://poetry.dctabudhabi.ae/diwan/poem/67372","البسيط"],[777,"","https://poetry.dctabudhabi.ae/diwan/poem/28805","المديد"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/21151","الكامل"],[1081,"","https://poetry.dctabudhabi.ae/diwan/poem/2537","الطويل"],[1101,"","https://poetry.dctabudhabi.ae/diwan/poem/97823","الكامل"],[1168,"","https://poetry.dctabudhabi.ae/diwan/poem/75853","الكامل"],[1173,"","https://poetry.dctabudhabi.ae/diwan/poem/20958","الرمل"]],"verses":[["لا يُرهَبُ المَرءُ مِنكُم عِندَ حِفظَتِهِ","وَلا يُراقِبُ يَوماً وَهوَ غَضبانُ",0,"ن",1,0],["لا يُرى مِثلِيَ إِلّا طالِباً","ذُروَةَ المِنبَرِ أَو قَعرَ الرَجَم",1,"م",1,0],["لا يَركَبُ الناهِقُ ذو أُربَةٍ","إِلّا إِذا رُدَّ عَنِ الصاهِلِ",2,"ل",1,0],["لا يَرِم قَبرَكَ مِبراقُ الذُرى","مُنجِدَ الأَعناقِ غَوريَّ التَوالي",3,"ل",2,0],["لا يَرُعكَ الحَيُّ إِن قيلَ هَلَك","أَخَذَ المِقدارُ مِنّا وَتَرَك",4,"ك",1,1],["لا يَرى السَوءَ مَن رَآكَ مَدى الدَه","رِ وَأَحيا الإِلَهُ مَن حَيّاكا",5,"ك",2,0],["لا يَراني العَدوُّ إِ","لّا بِعَينِ المُسارِقِ",6,"ق",1,0],["لا يُرى ناقِلاً إِلى الحَيِّ رِجلاً","لا وَلا ثانِياً إِلى الدارِ جيدا",7,"د",2,0],["لا يَرهَبونَ لِلعِدى ذُبابا","أَمسوا لِقاحاً وَغَدوا نِهابا",8,"ب",2,0],["لا يَركَبُ النَدبُ إِلّا كُلَّ مُعضِلَةٍ","كَأَنَّ ظَهرَ الهُوَينا غَيرُ مَركوبِ",9,"ب",1,0],["لا يَرهَبُ المُنكِرَ مِنكُم وَلا","يَرجوكُمُ إِلّا نَقى الآصِرِ",10,"ر",1,0],["لا يَرقَعُ الناسُ ما أَوهى وَإِن جَهَدوا","طولَ الحَياةِ وَلا يوهونَ ما رَقَعا",11,"ع",2,0],["لا يَرُدُّ القَضَاءَ حُزْنُ جَزْوعٍ","كُلُّ مَنْ عَاشَ بِالقَضَاءِ رَهِينُ",12,"ن",1,0],["لا يَرفَعونَ إِلى داعٍ أَعِنَّتَها","وَفي جَواشِنِها داءٌ يُجافيها",13,"ي",3,0],["لا يَرقَعُ الناسُ ما أَوهَت أَكُفُّهُمُ","عِندَ الدِفاعِ وَلا يوهونَ ما رَقَعوا",14,"ع",3,0],["لا يَرفَعُ الرَحمَنُ مَصروعَهُم","وَلا يُوَهِّن قُوَّةَ الصارِعِ",15,"ع",1,0],["لا يَرفَعِ الرَحمَنُ مَصروعَكُم","وَلا يُوَهِّن قُوَّةَ الصارِعِ",16,"ع",1,0],["لا يرهب التربيع طالع حسنها","ويجلّ جوهرها عن التثمين",17,"ن",1,0],["لا يَرَوْن الجروحَ إلا قصاصاً","وَرَعاً منهُمُ وعدلَ قضاءِ",18,"ا",2,0],["لا يُرَوِّي لا يُقَلِّبُ كفّاً","وأكُفُّ الرجالِ في تقليبِ",19,"ب",1,0],["لا يراني أهلاً لِملْكِ الظَّهاري","يِ ولا موضعَ العطايا الرِّغابِ",20,"ب",1,0],["لا يرى من وَصْفه البُسْ","تان بالبصرة بُدا",21,"د",2,0],["لا يرتجي المرتجون عدل أبي","بكرٍ على مثله ولا عمر",22,"ر",1,0],["لا يرمني الجاهلون وَيْبَهمُ","فإنني ذو مَلاطس لُطُس",23,"س",1,0],["لا يراها ساقطٌ نافلةً","ويراها الحُرُّ فرضاً مُفتَرض",24,"ض",1,0],["لا يرأمُ العوراءَ منطقُه","كلا وليس يعيرها سمعه",25,"ع",2,0],["لا يراها أشاءة من يسامي","ها ولا من بغى جناها سحوقا",26,"ق",2,0],["لا يُرجَ بعدك للهاضوم منفعةٌ","إن متَّ في الماء يا وهب بن إسحاق",27,"ق",1,0],["لا يرهبُ القاصدوك مِنْحَسةً","قد قصدَ الحظُّ بابَ من قصدَكْ",28,"ك",1,0],["لا يرى المنَّ قائلاً","ويرى المنَّ فاعلا",29,"ل",2,0],["لا يراني الإلهُ أهجوكَ عُمري","أنت عندي في حالة المرحوم",30,"م",1,0],["لا يرهبون إذا الأبطال أرهبَهم","يومٌ عصيب وهم في السِّلم رهبان",31,"ن",1,0],["لا يَرهَبُ الضَبعَ مَن أَمسَت بِعَقوَتِهِ","إِلّا الأَذِلّانِ زَيدُ اللاتِ وَالغَنَمُ",32,"م",1,1],["لا يَرهَبونَ يَدَ الخُطو","بِ كَأَنَّما هُم خَلفَ سورِ",33,"ر",1,0],["لا يَرتَضي دينَ الإِلَهُ مُوَفَّقاً","بَينَ القُلوبِ وَيَرتَضيهِ مُفَرَّقا",34,"ق",2,0],["لا يَرحَمُ المِقدامُ ذا خَوَرٍ","أَو يَرحَمُ الضِرغامَةُ الغَنَما",35,"م",2,0],["لا يرى للأرواح عقل تروى","من وجود في خارج الأجسام",36,"م",1,0],["لا يرجع الحق دمع العين منهمرا","فانه من جروح العجز معتصر",37,"ر",1,0],["لا يرد الحقوق قد","غصبت دمع انهمر",38,"ر",1,0],["لا يرى في التجديد قومك الا","بدعة تقصيهم عن الجنات",39,"ت",1,0],["لا يَراهُ الظُلمُ في كاهِلِهِ","وَهوَ يَكوي كاهِلَ الظُلمِ عِقابا",40,"ب",2,0],["لا يَرحَمُ اللَهُ أَرؤُساً لَهُم","أَطَرنَ عَن هامِهِنَّ أَقحافا",41,"ف",2,0],["لا يَرُعكَ المَشيبُ مِنّي فَإِنّي","ما ثَناني عَنِ التَصابي المَشيبُ",42,"ب",1,0],["لا يَرتَضي البِشرُ يَومَ سُؤدُدِهِ","أَو يَتَعَدّى إِشراقَهُ لَهَبُه",43,"ب",2,0],["لا يَرِم رَبعَكَ السَحابَ يَجودُه","تَبتَدي سوقَهُ الصَبا وَتَقودُه",44,"د",2,1],["لا يَرعكَ المَشيبُ مِنّي فَإِنّي","ما ثَناني عَنِ النَصابي المَشيبُ",45,"ب",1,0],["لايَرتَئي الواحِدُ مِنهُم سِوى","ما يَرتَئيهِ في العُلُوِّ الجَميع",46,"ع",1,0],["لا يُرتَضى قَدُّها عِندَ العِناقِ وَلا","يُثنى عَلى خَدِّها في ساعَةِ القُبَلِ",47,"ل",1,0],["لا يَرهَبُ الطَرَفَ البَعيدَ تَطَرُّفاً","عادَ المُضَيَّعُ وَهوَ غَيرُ مُضَيَّعِ",48,"ع",1,0],["لا يَرهَبُ المَوتَ إِنَّ النَفسَ باسِلَةٌ","وَالرَأيُ مُجتَمِعٌ وَالجودُ مُنتَشِرُ",49,"ر",1,0],["لا يرتجي الصَّبُّ بَرْدَ غُلَّتِه","ما ضَنَّ عنه بريقِه بَرَدُه",50,"د",2,0],["لا يَرتجي العزَّ بها غالبٌ","ولا يخافُ الذُّلَّ مغلوبُ",51,"ب",1,0],["لا يُراعي ذِمَّةَ الأُسدِ الَّتي","بَينَها في الغابِ قِدماً قَد نَشا",52,"ش",2,0],["لا يَرقَبُ النَجدَةَ مِن مُدَرَّبِ","إِذا الصُقورُ أُنجِدَت بِالأَكلُبِ",53,"ب",1,0],["لا يرى القرية الصغيرة كفؤاً","لكبار الآمال والأوطارِ",54,"ر",1,0],["لا يُرقَأُ الدَهرَ لَها عاتِكٌ","إِلّا عَلى أَنفاسِ نَجلا تَفوق",55,"ق",1,0],["لا يَرْتقي الرّاقي إلى شرفاتِهِ","إلا بمعراج من اللحظانِ",56,"ن",1,0],["لا يَرْهَبُونَ الْمَنَايَا أَنْ تُلِمَّ بِهِمْ","كَأَنَّ لُقْيَ الْمَنَايَا عِنْدَهُمْ حَرَمُ",57,"م",1,0],["لا يَرْكَنُونَ إِلَى الدُّنْيَا وَزِينَتِهَا","إِذَا هُمُ شَعَرُوا بِالذُّلِّ أَوْ نَقِمُوا",57,"م",3,0],["لا يَرْهَبُ الضِّرْغَامَ بَيْنَ عَرِينِهِ","بَأْساً وَلا يَدَعُ الظِّبَاءَ مَطَافِلا",58,"ل",2,0],["لا يُرغِمُ اللَهُ أَنفاً أَنتِ حامِلُهُ","بَل أَنفَ شانيكِ فيما سَرَّكُم رَغما",59,"م",2,0],["لا يَرجِعُ الرَسمُ بِالبَيانِ وَهَل","يُفقَهُ رُجعاهُ حينَ يَندَثِرُ",60,"ر",1,0],["لا يَرُعْكَ الجندُ يُرْجَى للأذى","أيُّ جندٍ للأذى لم ينهزِمْ",61,"م",1,0],["لا يَراهُ الناسُ إِلّا جَشِعاً","بارِزَ الأَنيابِ كَالذِئبِ اللَعينْ",62,"ن",1,0],["لا يَرهَبُ الناسَ إِن قَلّوا وَإِن كَثُروا","في مطلَبٍ جَلَلٍ لِلَهِ أَو سولِ",63,"ل",1,0],["لا يَرفَعُ الصَوتَ يَدعوهُم لِمَنقبَةٍ","إِلّا تَنافَسَ قَومٌ دونَهُم فيها",64,"ي",3,0],["لا يرهبُ المَوتَ الوَحِيَّ إِذا دَنا","وَيَخافُ قَولَ اللائِمينَ أَلا ابعدِ",65,"د",1,0],["لا يرجعنَّ إليَّ إلا راضياً","والله عَوْنُ نَصيرِه وَمُعينِهِ",66,"ه",1,0],["لا يَرى الشَيءَ مُشكِلاً","وَهوَ يَقرا لِبَينَتَين",67,"ن",1,0],["لا يُريشانِ بِاِختِلافِهِما المَر","ءَ وَإِن طالَ فيهِما أَمَدُه",68,"د",2,0],["لا يَرفَعُ الطَرفَ إِلّا عِندَ مَكرُمَةٍ","مِنَ الحَياءِ وَلا يُغضي عَلى عارِ",69,"ر",1,0],["لا يرهَبُ الطمثَ ولا يشتكي","حملاً ولا عن مُقلتي يُحجَبُ",70,"ب",1,0],["لا يُرَعْ للمَها بداركِ سِرْبٌ","فلقد أشبَهَتْكِ إن لم تَكُنْكِ",71,"ك",1,0],["لا يركُضونَ فؤادَ صَبٍّ هائمٍ","إن لم يُسَمّوه الجَوادَ السَّلْهَبا",72,"ب",2,0],["لا يُرقِئُ اللَهُ عَينَي مَن بَكى حَجَراً","وَلا شَفى وَجدَ مَن يَصبو إِلى وَتَدِ",73,"د",1,0],["لا يردعنّكَ عن هواكَ تحرّج","إنّ التحرّج يورثُ الفقرا",74,"ر",2,0],["لا يَرهَبُ المَوتَ إِنَّ النَفسَ باسِلَةٌ","وَالرَأيَ مُجتَمِعٌ وَالدينَ مُنتَشِرُ",75,"ر",1,0],["لا يَرجَعونَ لِما كانوا وَإِن رَغِموا","وَلا يَنامونَ مِن خَوفٍ وَإِجحادِ",76,"د",1,0],["لا يَرعَوينَ إِلى المُري","بِ وَيَنينَ عَلى المَراصِد",77,"د",1,0],["لا يَراني وَقَد أَرى","وَجهَهُ غَيرَ أَبلَجِ",78,"ج",1,0],["لا يُريدُ الرُشدَ إِلّا ناصِحٌ","وَيَلي قَتلَكَ إِلّا مَن تَعِب",79,"ب",1,0],["لا يَرهَبُ المَوتَ مَن كانَ اِمرِأً فَطِناً","فَإِنَّ في العَيشِ أَرزاءً وَأَحداثا",80,"ث",2,1],["لا يَرفَعُ الصَوتَ بِالقَولِ الهَراءِ ضُحىً","وَلا يَدِبُّ إِلا جاراتِهِ عَتَما",81,"م",2,0],["لا يرى ان يطأطئ الرأس من يح","مل قلبا صعبا وانفاً حميا",82,"ي",2,0],["لا يرأس الناس في عصر نعيش به","إلا الَّذي لقلوب الناس يمتلك",83,"ك",1,0],["لا يرى ثورة لهم قد تميط ال","ضر عنهم وتذهب الويلات",84,"ت",1,0],["لا يَرفع الوطن العَزيز سوى أمرئٍ","حر عَلى الوطن العَزيز يغار",85,"ر",1,0],["لا يرفع الشعب من أَعماق وهدته","إلا رجال أولو عزم ونسوان",86,"ن",1,0],["لا يرحم القوم من بانت مفاقره","فبات في القوم مطوياً على سغب",87,"ب",1,0],["لا يَرتَقي شعب عَلى ال","أدب القَديم له جمود",88,"د",1,0],["لا يَروعَنْكَ خِدْنَها ظمأُ الحَرْ","بِ رُوَيدا فقد حَمَلْتَ غَديرا",89,"ر",2,0],["لا يرفع الجذع عن الأرض الثمر","ولا يحطّ نسب الليل القمرْ",90,"ر",1,0],["لا يُرفعُ المُصحفُ كالدُّفوفِ","والسِّلمُ لا تُذكَرُ في الصفوف",91,"ف",1,0],["لا يَرْحَمِ الرَّحْمنُ مَصْرَعَ مارِقٍ","عَبِثَتْ بطاعتِهِ يَدُ الأَهْواءِ",92,"ا",2,0],["لا يَرقُبُ الجريَ في المواطِنِ لِل","عَقبِ وَلكِن لِلعقابِ حُضُر",93,"ر",1,1],["لا يَرُوقَنكَ صائِرٌ لِفَنَاءٍ","كُلُّ دُنيا مَصيرُها لِلتُّرابِ",94,"ب",1,0],["لا يَرْهَبُونَ عَدُوَّاً فِي مُغَاوَرَةٍ","وَكَيْفَ يَرْهَبُ لَيْثٌ كَرَّ يَعْفُورِ",95,"ر",1,0],["لا يُرَى عَاتِباً عَلَى شِيَمِ الدَّهْ","رِ وَلا عَابِثاً وَلا مَزَّاحَا",96,"ح",2,0],["لا يَرَى جَانِفٌ إِلَيْهِ سَبِيلاً","وَيَرَاهَا الحَرِيبُ وَالمُسْتَضَامُ",97,"م",1,0],["لا يُرَى مِنْهُ فِي السَّجَايَا وَفِي الآ","دَابِ إِلاَّ تَوَافُقٌ وَانْسِجَامُ",97,"م",1,0],["لاَ يَرْحَمُونَ الصِّغَارَ مِنْهُمْ","وَلاَ يَرِقُّونَ لِلْكِبَارْ",98,"ر",1,0],["لا يرى، إذ تطلعُ الشّمسُ، سوى","سائلٍ أو عاجزٍ أو وَكَلِ",99,"ل",1,0],["لا يرجع الميتَ حيا","بنيانُك الأنصابا",100,"ب",2,0],["لا يَرُعني لِلغُرابِ نَعيبٌ","فَكَفى رَوعاً بِهذا النَعِي