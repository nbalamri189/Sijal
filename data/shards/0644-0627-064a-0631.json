"الرجز"],[456,"سلك الخيال بحاجر","https://www.aldiwan.net/poem56096.html","مجزوء الكامل"],[456,"هل في الشموس التي تحدى بها العير","https://www.aldiwan.net/poem56166.html","البسيط"],[456,"بلوت هذا الدهر أطواره","https://www.aldiwan.net/poem56171.html","السريع"],[456,"جم لها الوادي وعز الذائد","https://www.aldiwan.net/poem56225.html","الرجز"],[456,"أفلح قوم إذا دعوا وثبوا","https://www.aldiwan.net/poem56299.html","المنسرح"],[459,"وصاحب من بني الآمال خضت به","https://www.aldiwan.net/poem15303.html","البسيط"],[459,"أجأ وسلمى أم بلاد الزاب","https://www.aldiwan.net/poem15904.html","الكامل"],[459,"الخطب أكبر في النفوس وأعظم","https://www.aldiwan.net/poem16060.html","الكامل"],[459,"أسر بالبرق لا حرصا على الديم","https://www.aldiwan.net/poem16089.html","البسيط"],[459,"يشرق النادي إذا حل به","https://www.aldiwan.net/poem16150.html","الرمل"],[459,"موسع المعروف رحب المنزل","https://www.aldiwan.net/poem16430.html","الرجز"],[466,"إنا لنبن على ما أسسته لنا","https://www.aldiwan.net/poem59686.html","المتقارب"],[480,"نور ربي قد تجلى","https://www.aldiwan.net/poem24359.html","عموديه"],[484,"يا مال والسيد المعمم","https://www.aldiwan.net/poem480.html",""],[513,"صرف النسيب إلى اللوى وزرود","https://www.aldiwan.net/poem12082.html","الكامل"],[513,"ما عن هوى الرشأ العذري أعذار","https://www.aldiwan.net/poem12136.html","البسيط"],[523,"الخيل تعلم يوم الروع إن هزمت","https://www.aldiwan.net/poem2031.html","البسيط"],[536,"ألله أعلم ما السبب","https://www.aldiwan.net/poem48274.html","عموديه"],[538,"لا يرفعون إليه الطرف خشيته","https://www.aldiwan.net/poem56682.html","البسيط"],[538,"أوصي غنيا فما أنفك أذمره","https://www.aldiwan.net/poem56708.html","الطويل"],[549,"لا تقطعن رجاء العيش بالعلل","https://www.aldiwan.net/poem47259.html","البسيط"],[549,"ما زرت إلا خداعا أيها الساري","https://www.aldiwan.net/poem47781.html","البسيط"],[549,"من عذيري من سقام","https://www.aldiwan.net/poem48076.html","مجزوء الرمل"],[549,"شد غروض المطي مغتربا","https://www.aldiwan.net/poem48085.html","المنسرح"],[549,"من لداع لا يجاب","https://www.aldiwan.net/poem48097.html","مجزوء الرمل"],[551,"لا يرحل الشيب عن دار أقام بها","https://www.aldiwan.net/poem68300.html","البسيط"],[551,"أجررت حبل خليع في الصبا غزل","https://www.aldiwan.net/poem68432.html","البسيط"],[556,"هي قامت بنفسها لذويها","https://www.aldiwan.net/poem33637.html","الخفيف"],[556,"لا يرى الفقه الإلهي","https://www.aldiwan.net/poem33673.html","مجزوء الرمل"],[556,"إنني قد شفني السقم","https://www.aldiwan.net/poem34089.html","المديد"],[556,"كل من بالناس يختلط","https://www.aldiwan.net/poem34409.html","المديد"],[556,"فرحي يا فرحي يا فرحي","https://www.aldiwan.net/poem34662.html","الرمل"],[557,"أيها اللائم رفقا","https://www.aldiwan.net/poem69350.html","مجزوء الرمل"],[560,"إن كنت بالله في دنياك تعتصم","https://www.aldiwan.net/poem52850.html","البسيط"],[567,"إن أدع مسكينا فما قصرت","https://www.aldiwan.net/poem52007.html","أحذ الكامل"],[573,"أما الغرام بها فعاد كما بدا","https://www.aldiwan.net/poem3079.html","الكامل"]],"verses":[["لا يُرهَبُ المَرءُ مِنكُم عِندَ حِفظَتِهِ","وَلا يُراقِبُ يَوماً وَهوَ غَضبانُ",0,"ن",1,0],["لا يُرى مِثلِيَ إِلّا طالِباً","ذُروَةَ المِنبَرِ أَو قَعرَ الرَجَم",1,"م",1,0],["لا يَركَبُ الناهِقُ ذو أُربَةٍ","إِلّا إِذا رُدَّ عَنِ الصاهِلِ",2,"ل",1,0],["لا يَرِم قَبرَكَ مِبراقُ الذُرى","مُنجِدَ الأَعناقِ غَوريَّ التَوالي",3,"ي",1,0],["لا يَرُعكَ الحَيُّ إِن قيلَ هَلَك","أَخَذَ المِقدارُ مِنّا وَتَرَك",4,"ك",1,1],["لا يَرى السَوءَ مَن رَآكَ مَدى الدَه","رِ وَأَحيا الإِلَهُ مَن حَيّاكا",5,"ك",2,0],["لا يَراني العَدوُّ إِ","لّا بِعَينِ المُسارِقِ",6,"ق",1,0],["لا يُرى ناقِلاً إِلى الحَيِّ رِجلاً","لا وَلا ثانِياً إِلى الدارِ جيدا",7,"د",2,0],["لا يَرهَبونَ لِلعِدى ذُبابا","أَمسوا لِقاحاً وَغَدوا نِهابا",8,"ب",2,0],["لا يَركَبُ النَدبُ إِلّا كُلَّ مُعضِلَةٍ","كَأَنَّ ظَهرَ الهُوَينا غَيرُ مَركوبِ",9,"ب",1,0],["لا يَرهَبُ المُنكِرَ مِنكُم وَلا","يَرجوكُمُ إِلّا نَقى الآصِرِ",10,"ر",1,0],["لا يَرقَعُ الناسُ ما أَوهى وَإِن جَهَدوا","طولَ الحَياةِ وَلا يوهونَ ما رَقَعا",11,"ع",2,0],["لا يَرُدُّ القَضَاءَ حُزْنُ جَزْوعٍ","كُلُّ مَنْ عَاشَ بِالقَضَاءِ رَهِينُ",12,"ن",1,0],["لا يَرفَعونَ إِلى داعٍ أَعِنَّتَها","وَفي جَواشِنِها داءٌ يُجافيها",13,"ي",3,0],["لا يَرقَعُ الناسُ ما أَوهَت أَكُفُّهُمُ","عِندَ الدِفاعِ وَلا يوهونَ ما رَقَعوا",14,"ع",3,0],["لا يَرفَعُ الرَحمَنُ مَصروعَهُم","وَلا يُوَهِّن قُوَّةَ الصارِعِ",15,"ع",1,0],["لا يَرفَعِ الرَحمَنُ مَصروعَكُم","وَلا يُوَهِّن قُوَّةَ الصارِعِ",16,"ع",1,0],["لا يرهب التربيع طالع حسنها","ويجلّ جوهرها عن التثمين",17,"ن",1,0],["لا يَرَوْن الجروحَ إلا قصاصاً","وَرَعاً منهُمُ وعدلَ قضاءِ",18,"ا",2,0],["لا يُرَوِّي لا يُقَلِّبُ كفّاً","وأكُفُّ الرجالِ في تقليبِ",19,"ب",1,0],["لا يراني أهلاً لِملْكِ الظَّهاري","يِ ولا موضعَ العطايا الرِّغابِ",20,"ب",1,0],["لا يرى من وَصْفه البُسْ","تان بالبصرة بُدا",21,"د",2,0],["لا يرتجي المرتجون عدل أبي","بكرٍ على مثله ولا عمر",22,"ر",1,0],["لا يرمني الجاهلون وَيْبَهمُ","فإنني ذو مَلاطس لُطُس",23,"س",1,0],["لا يراها ساقطٌ نافلةً","ويراها الحُرُّ فرضاً مُفتَرض",24,"ض",1,0],["لا يرأمُ العوراءَ منطقُه","كلا وليس يعيرها سمعه",25,"ع",2,0],["لا يراها أشاءة من يسامي","ها ولا من بغى جناها سحوقا",26,"ق",2,0],["لا يُرجَ بعدك للهاضوم منفعةٌ","إن متَّ في الماء يا وهب بن إسحاق",27,"ق",1,0],["لا يرهبُ القاصدوك مِنْحَسةً","قد قصدَ الحظُّ بابَ من قصدَكْ",28,"ك",1,0],["لا يرى المنَّ قائلاً","ويرى المنَّ فاعلا",29,"ل",2,0],["لا يراني الإلهُ أهجوكَ عُمري","أنت عندي في حالة المرحوم",30,"م",1,0],["لا يرهبون إذا الأبطال أرهبَهم","يومٌ عصيب وهم في السِّلم رهبان",31,"ن",1,0],["لا يَرهَبُ الضَبعَ مَن أَمسَت بِعَقوَتِهِ","إِلّا الأَذِلّانِ زَيدُ اللاتِ وَالغَنَمُ",32,"م",1,1],["لا يَرهَبونَ يَدَ الخُطو","بِ كَأَنَّما هُم خَلفَ سورِ",33,"ر",1,0],["لا يَرتَضي دينَ الإِلَهُ مُوَفَّقاً","بَينَ القُلوبِ وَيَرتَضيهِ مُفَرَّقا",34,"ق",2,0],["لا يَرحَمُ المِقدامُ ذا خَوَرٍ","أَو يَرحَمُ الضِرغامَةُ الغَنَما",35,"م",2,0],["لا يرى للأرواح عقل تروى","من وجود في خارج الأجسام",36,"م",1,0],["لا يرجع الحق دمع العين منهمرا","فانه من جروح العجز معتصر",37,"ر",1,0],["لا يرد الحقوق قد","غصبت دمع انهمر",38,"ر",1,0],["لا يرى في التجديد قومك الا","بدعة تقصيهم عن الجنات",39,"ت",1,0],["لا يَراهُ الظُلمُ في كاهِلِهِ","وَهوَ يَكوي كاهِلَ الظُلمِ عِقابا",40,"ب",2,0],["لا يَرحَمُ اللَهُ أَرؤُساً لَهُم","أَطَرنَ عَن هامِهِنَّ أَقحافا",41,"ف",2,0],["لا يَرُعكَ المَشيبُ مِنّي فَإِنّي","ما ثَناني عَنِ التَصابي المَشيبُ",42,"ب",1,0],["لا يَرتَضي البِشرُ يَومَ سُؤدُدِهِ","أَو يَتَعَدّى إِشراقَهُ لَهَبُه",43,"ب",2,0],["لا يَرِم رَبعَكَ السَحابَ يَجودُه","تَبتَدي سوقَهُ الصَبا وَتَقودُه",44,"د",2,1],["لا يَرعكَ المَشيبُ مِنّي فَإِنّي","ما ثَناني عَنِ النَصابي المَشيبُ",45,"ب",1,0],["لايَرتَئي الواحِدُ مِنهُم سِوى","ما يَرتَئيهِ في العُلُوِّ الجَميع",46,"ع",1,0],["لا يُرتَضى قَدُّها عِندَ العِناقِ وَلا","يُثنى عَلى خَدِّها في ساعَةِ القُبَلِ",47,"ل",1,0],["لا يَرهَبُ الطَرَفَ البَعيدَ تَطَرُّفاً","عادَ المُضَيَّعُ وَهوَ غَيرُ مُضَيَّعِ",48,"ع",1,0],["لا يَرهَبُ المَوتَ إِنَّ النَفسَ باسِلَةٌ","وَالرَأيُ مُجتَمِعٌ وَالجودُ مُنتَشِرُ",49,"ر",1,0],["لا يرتجي الصَّبُّ بَرْدَ غُلَّتِه","ما ضَنَّ عنه بريقِه بَرَدُه",50,"د",2,0],["لا يَرتجي العزَّ بها غالبٌ","ولا يخافُ الذُّلَّ مغلوبُ",51,"ب",1,0],["لا يُراعي ذِمَّةَ الأُسدِ الَّتي","بَينَها في الغابِ قِدماً قَد نَشا",52,"ش",2,0],["لا يَرقَبُ النَجدَةَ مِن مُدَرَّبِ","إِذا الصُقورُ أُنجِدَت بِالأَكلُبِ",53,"ب",1,0],["لا يرى القرية الصغيرة كفؤاً","لكبار الآمال والأوطارِ",54,"ر",1,0],["لا يَرْتقي الرّاقي إلى شرفاتِهِ","إلا بمعراج من اللحظانِ",55,"ن",1,0],["لا يَرْهَبُونَ الْمَنَايَا أَنْ تُلِمَّ بِهِمْ","كَأَنَّ لُقْيَ الْمَنَايَا عِنْدَهُمْ حَرَمُ",56,"م",1,0],["لا يَرْكَنُونَ إِلَى الدُّنْيَا وَزِينَتِهَا","إِذَا هُمُ شَعَرُوا بِالذُّلِّ أَوْ نَقِمُوا",56,"م",3,0],["لا يَرْهَبُ الضِّرْغَامَ بَيْنَ عَرِينِهِ","بَأْساً وَلا يَدَعُ الظِّبَاءَ مَطَافِلا",57,"ل",2,0],["لا يُرغِمُ اللَهُ أَنفاً أَنتِ حامِلُهُ","بَل أَنفَ شانيكِ فيما سَرَّكُم رَغما",58,"م",2,0],["لا يَرجِعُ الرَسمُ بِالبَيانِ وَهَل","يُفقَهُ رُجعاهُ حينَ يَندَثِرُ",59,"ر",1,0],["لا يَرُعْكَ الجندُ يُرْجَى للأذى","أيُّ جندٍ للأذى لم ينهزِمْ",60,"م",1,0],["لا يَراهُ الناسُ إِلّا جَشِعاً","بارِزَ الأَنيابِ كَالذِئبِ اللَعينْ",61,"ن",1,0],["لا يَرهَبُ الناسَ إِن قَلّوا وَإِن كَثُروا","في مطلَبٍ جَلَلٍ لِلَهِ أَو سولِ",62,"ل",1,0],["لا يَرفَعُ الصَوتَ يَدعوهُم لِمَنقبَةٍ","إِلّا تَنافَسَ قَومٌ دونَهُم فيها",63,"ي",3,0],["لا يرهبُ المَوتَ الوَحِيَّ إِذا دَنا","وَيَخافُ قَولَ اللائِمينَ أَلا ابعدِ",64,"د",1,0],["لا يرجعنَّ إليَّ إلا راضياً","والله عَوْنُ نَصيرِه وَمُعينِهِ",65,"ه",1,0],["لا يَرى الشَيءَ مُشكِلاً","وَهوَ يَقرا لِبَينَتَين",66,"ن",1,0],["لا يُريشانِ بِاِختِلافِهِما المَر","ءَ وَإِن طالَ فيهِما أَمَدُه",67,"د",2,0],["لا يَرفَعُ الطَرفَ إِلّا عِندَ مَكرُمَةٍ","مِنَ الحَياءِ وَلا يُغضي عَلى عارِ",68,"ر",1,0],["لا يرهَبُ الطمثَ ولا يشتكي","حملاً ولا عن مُقلتي يُحجَبُ",69,"ب",1,0],["لا يُرَعْ للمَها بداركِ سِرْبٌ","فلقد أشبَهَتْكِ إن لم تَكُنْكِ",70,"ك",1,0],["لا يركُضونَ فؤادَ صَبٍّ هائمٍ","إن لم يُسَمّوه الجَوادَ السَّلْهَبا",71,"ب",2,0],["لا يُرقِئُ اللَهُ عَينَي مَن بَكى حَجَراً","وَلا شَفى وَجدَ مَن يَصبو إِلى وَتَدِ",72,"د",1,0],["لا يردعنّكَ عن هواكَ تحرّج","إنّ التحرّج يورثُ الفقرا",73,"ر",2,0],["لا يَرهَبُ المَوتَ إِنَّ النَفسَ باسِلَةٌ","وَالرَأيَ مُجتَمِعٌ وَالدينَ مُنتَشِرُ",74,"ر",1,0],["لا يَرجَعونَ لِما كانوا وَإِن رَغِموا","وَلا يَنامونَ مِن خَوفٍ وَإِجحادِ",75,"د",1,0],["لا يَرعَوينَ إِلى المُري","بِ وَيَنينَ عَلى المَراصِد",76,"د",1,0],["لا يَراني وَقَد أَرى","وَجهَهُ غَيرَ أَبلَجِ",77,"ج",1,0],["لا يُريدُ الرُشدَ إِلّا ناصِحٌ","وَيَلي قَتلَكَ إِلّا مَن تَعِب",78,"ب",1,0],["لا يَرهَبُ المَوتَ مَن كانَ اِمرِأً فَطِناً","فَإِنَّ في العَيشِ أَرزاءً وَأَحداثا",79,"ث",2,1],["لا يَرفَعُ الصَوتَ بِالقَولِ الهَراءِ ضُحىً","وَلا يَدِبُّ إِلا جاراتِهِ عَتَما",80,"م",2,0],["لا يرى ان يطأطئ الرأس من يح","مل قلبا صعبا وانفاً حميا",81,"ي",2,0],["لا يرأس الناس في عصر نعيش به","إلا الَّذي لقلوب الناس يمتلك",82,"ك",1,0],["لا يرى ثورة لهم قد تميط ال","ضر عنهم وتذهب الويلات",83,"ت",1,0],["لا يَرفع الوطن العَزيز سوى أمرئٍ","حر عَلى الوطن العَزيز يغار",84,"ر",1,0],["لا يرفع الشعب من أَعماق وهدته","إلا رجال أولو عزم ونسوان",85,"ن",1,0],["لا يرحم القوم من بانت مفاقره","فبات في القوم مطوياً على سغب",86,"ب",1,0],["لا يَرتَقي شعب عَلى ال","أدب القَديم له جمود",87,"د",1,0],["لا يَروعَنْكَ خِدْنَها ظمأُ الحَرْ","بِ رُوَيدا فقد حَمَلْتَ غَديرا",88,"ر",2,0],["لا يرفع الجذع عن الأرض الثمر","ولا يحطّ نسب الليل القمرْ",89,"ر",1,0],["لا يُرفعُ المُصحفُ كالدُّفوفِ","والسِّلمُ لا تُذكَرُ في الصفوف",90,"ف",1,0],["لا يَرْحَمِ الرَّحْمنُ مَصْرَعَ مارِقٍ","عَبِثَتْ بطاعتِهِ يَدُ الأَهْواءِ",91,"ا",2,0],["لا يَرقُبُ الجريَ في المواطِنِ لِل","عَقبِ وَلكِن لِلعقابِ حُضُر",92,"ر",1,1],["لا يَرُوقَنكَ صائِرٌ لِفَنَاءٍ","كُلُّ دُنيا مَصيرُها لِلتُّرابِ",93,"ب",1,0],["لا يَرْهَبُونَ عَدُوَّاً فِي مُغَاوَرَةٍ","وَكَيْفَ يَرْهَبُ لَيْثٌ كَرَّ يَعْفُورِ",94,"ر",1,0],["لا يُرَى عَاتِباً عَلَى شِيَمِ الدَّهْ","رِ وَلا عَابِثاً وَلا مَزَّاحَا",95,"ح",2,0],["لا يَرَى جَانِفٌ إِلَيْهِ سَبِيلاً","وَيَرَاهَا الحَرِيبُ وَالمُسْتَضَامُ",96,"م",1,0],["لا يُرَى مِنْهُ فِي السَّجَايَا وَفِي الآ","دَابِ إِلاَّ تَوَافُقٌ وَانْسِجَامُ",96,"م",1,0],["لاَ يَرْحَمُونَ الصِّغَارَ مِنْهُمْ","وَلاَ يَرِقُّونَ لِلْكِبَارْ",97,"ر",1,0],["لا يرى، إذ تطلعُ الشّمسُ، سوى","سائلٍ أو عاجزٍ أو وَكَلِ",98,"ل",1,0],["لا يرجع الميتَ حيا","بنيانُك الأنصابا",99,"ب",2,0],["لا يَرُعني لِلغُرابِ نَعيبٌ","فَكَفى رَوعاً بِهذا النَعِيِّ",100,"ي",1,0],["لاَ يُرْتَجَى مِنْ أُمَّةٍ مَفْتُونَةٍ","بِاللَّهْوِ والتسْوِيفِ أَيُّ فَلاحِ",101,"ح",1,0],["لا يُريدُون أنْ يُشَابَ لهم صَفْوٌ","بِنَوْحٍ للبُؤْسِ أو إِعْوَالِ",102,"ل",1,0],["لا يُرْسِلُ الطرْفُ في مَيْدانِها قَدَماً","إِلاَّ بِزَجْرٍ وَإِيعادٍ وتَهْدِيدِ",103,"د",1,0],["لا يَرَى الطرْفُ منه إلاّ غُباراً","عجز الطرْفُ انْ يَرَى قَصَباته",104,"ت",2,0],["لا يردَعُ التاجرَ عن غشِّه","مثلُ اتقاءِ المتجر الكاسد",105,"د",1,0],["لا يرفعُ العادي إليها طرفَهُ","إلاَّ وردَّ الطرف عنها مطرقا",106,"ق",2,0],["لا يرني الناس شاكيًا أبدًا","فإنما يشتكي أخو الوهن",107,"ن",1,0],["لا يرقد العربيُّ ملءَ جفونه","ويذوقَ طعمَ الزادِ حتى يَثْأَرا",108,"ر",2,0],["لا يرحم التاريخُ في الأَحكام، إنْ","قَاضَى مُسِيئًا، أو أدَانَ مقصِّرا",108,"ر",2,0],["لا يُرْجعُ الله عهدًا دال دائل