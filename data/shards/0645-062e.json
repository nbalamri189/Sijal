html","الخفيف"],[516,"أعندك أن وجدي واكتئابي","https://www.aldiwan.net/poem12008.html","الوافر"],[516,"عند ظباء الجهلتين ثاره","https://www.aldiwan.net/poem12110.html","الرجز"],[516,"إن كنت أزمعت على المسير","https://www.aldiwan.net/poem12128.html","الرجز"],[516,"أنسيم عرفك أم شميم عرار","https://www.aldiwan.net/poem12150.html","الكامل"],[516,"لولا جفون ومقل","https://www.aldiwan.net/poem12209.html","مجزوء الكامل"],[539,"قد بدا لما بدا","https://www.aldiwan.net/poem47448.html","عموديه"],[559,"تعلم حفظ آفات اللسان","https://www.aldiwan.net/poem33822.html","الوافر"],[559,"ظهرت ذاتي لذاتي","https://www.aldiwan.net/poem34729.html","مجزوء الرمل"],[562,"جاري لا تستنكري عذيري","https://www.aldiwan.net/poem27842.html","الرجز"],[562,"طاف الخيالان فهاجا سقما","https://www.aldiwan.net/poem27844.html","الرجز"],[562,"بكيت والمحتزن البكي","https://www.aldiwan.net/poem27848.html","الرجز"],[563,"أتتني بلا وعد من المنزل الأسنى","https://www.aldiwan.net/poem52898.html","الطويل"],[563,"على الدنيا ومن فيها السلام","https://www.aldiwan.net/poem52970.html","الوافر"],[564,"تخافقت البروق على الغميم","https://www.aldiwan.net/poem13599.html","الوافر"],[568,"يا قاتل الله كتاب الدواوين","https://www.aldiwan.net/poem69488.html","البسيط"],[568,"مخطف الخصر أجوف","https://www.aldiwan.net/poem69655.html","مجزوء الخفيف"],[568,"ما ترى في الصبوح أيدك الله","https://www.aldiwan.net/poem69743.html","الخفيف"],[568,"جاءت بعود كأن نغمته","https://www.aldiwan.net/poem69776.html","السريع"],[568,"كأنما الراووق وانتصابه","https://www.aldiwan.net/poem69791.html","الرجز"],[576,"لهفي من العاذل والعاذر","https://www.aldiwan.net/poem3072.html","السريع"],[576,"ما العيش ري ولا الحمام صدى","https://www.aldiwan.net/poem3074.html","المنسرح"]],"verses":[["مخاضٌ جاء آمنة فهزت","بجذع المكرمات من الخصال",0,"ل",1,0],["مُخَرَّقَ الثَوبِ بِطَعنِ اللُدنِ","يا دَهرُ سَيفي مَعقِلي وَحِصني",1,"ن",2,0],["مَخافَةَ واشٍ يَثلِمُ الحُبَّ قَولُهُ","وَهَيهاتَ طالَ الحُبُّ مِنّا وَأَورَقا",2,"ق",2,0],["مَخيلَةٌ لا مَطَرٌ خَلفَها","تَلمَعُ مِنها شَوَلانُ البُروق",3,"ق",1,0],["مَخيلَةٌ مَبرَكُها مِن شَخصِها","إِذا المَطايا عَمَرَت رِباعَها",4,"ع",3,0],["مَخبِرٌ فاحِمٌ وَلونٌ مُضيءٌ","مَن رَأى اليَومَ فاحِماً مُبيَضّا",5,"ض",2,0],["مُخَفِّضُ الجَأشِ إِذا","صاحَ بِهِ الجَمعُ وَقَر",6,"ر",1,0],["مُخِّضنَ بِهِنَّ مَخضَ الوَطَبِ حَتّى","إِذا جَلجَلنَ أَطلَقنَ المَزادا",7,"د",2,0],["مُخرِجاتٍ رُؤوسَهُنَّ إِلى الأَح","شاءِ لِلوَجدِ يَطَّلِعنَ اِطَّلاعا",8,"ع",2,0],["مَخافَةَ أَن يُجَدِّدَ لي صُدوداً","وَكُنتُ حَديثَ عَهدٍ بِالصُدودِ",9,"د",1,0],["مَخافَةَ أَن يَقولَ الناسُ إِنّا","خَتَمنا الوُدَّ مِنّا بِالفَسادِ",10,"د",1,0],["مُخالَطَتي يا فَوزُ أَهلَكِ فَاِعلَمي","يَقيناً بِأَنّي نَحوَ بَيتِكِ أَطمَحُ",11,"ح",1,0],["مخَلَّفُ سِرْبٍ قد أُصيبَ جَناحُهُ","وطِرْنَ فلَمْ يسْطِعْ مَراحاً ولا مَغْدى",12,"د",2,0],["مُخْجِلاً لفْظُهُ حَلاوَةَ معْنا","هُ صَحيحَ الأسْبابِ والأوْتادِ",13,"د",1,0],["مَخوفٍ بِهِ الجِنّانُ تَعوي ذِئابُهُ","قَطَعتُ بِفَتلاءِ الذِراعَينِ بازِلِ",14,"ل",1,0],["مَخازٍ وَما أَدري إِذا ما ذَكَرتُها","إِلى الحَمدِ أُدعى أَو إِلى اللَومِ أُدفَعُ",15,"ع",1,0],["مُخَلَّدَ المَجْدِ دُونَ القَائِمِينَ بِهِ","مِنْ شُوسِ حَرْبٍ وَصُنَّاعٍ وَأَعْوَانِ",16,"ن",1,0],["مُخَالِساً ذِمَّةَ العَلْيَاءِ مُضْطَجِعاً","مِنْ عِصْمَتِهَا فِي مَضْجَعِ الزَّانِي",16,"ن",2,0],["مُخَلِّدَةٌ مَنَاقِبُكَ اللَّوَاتِي","بَلَغْتَ بِهُنَّ غَايَةَ الافْتِنَانِ",17,"ن",1,0],["مَخافَةَ عَيني أَن تَنُمَّ دُموعُها","عَلَيَّ بِأَسرارِ الضَميرِ المُكَتِّمِ",18,"م",1,0],["مُخَفِّقَةٌ يَجري عَلى الهَولِ رَكبُها","عِجالاً بِها ما يَنظُرونَ التَوالِيا",19,"ي",2,0],["مُخَفِّقَةً تَشابَهُ حينَ يَجري","حَبابُ الماءِ وَاِرتَدَتِ القَتاما",20,"م",2,0],["مُخَيَّفٌ بعضُه وردٌ وسائره","جَوْن أفانين إِجْرياه لا هَضَبُ",21,"ب",1,1],["مَخافَةَ أَن يُقالَ بِكُلِّ أَرضٍ","بَنو حَمدانَ كَفّوا عَن قِتالِ",22,"ل",1,0],["مَخافَةَ قَولِ الوُشا","ةِ مِثلُكَ لا يَصبِرُ",23,"ر",1,0],["مُخمِرٍ سِرَّهُ إِذا ما اِلتَقَينا","ثَلِجَت نَفسُهُ بِأَن لا أَخونا",24,"ن",2,0],["مخافةَ أشكو إليك أذاه","فأشكو العدوَّ إلى الصاحب",25,"ب",1,0],["مخيماً تنثر ألطافهُ","نثرَ سقيطِ الوبلِ من عقده",26,"د",2,0],["مخصوصة بالطرد القويم","حدباً كظهر الذنب الركيم",27,"م",1,0],["مُخفَّفةٌ مُثَقَّلةٌ تراها","كأنْ لم يَغْذُ نِصْفَيها غِذاءُ",28,"ا",2,1],["مخاذيلُ مَمَاييل","إلى السَّوْأَى عن الحسنى",29,"ن",2,0],["مخافةً من قِراف مُخزيَةٍ","بل من حريقٍ ذوو الخنا حَصَبُهْ",30,"ب",2,0],["مُخْلِفِي يوم كيومك ما","فيه من بؤس ولا نكدِ",31,"د",1,0],["مُختَّمَةَ الأَطراف تنْقَدُّ قُمْصُها","عن العسل الماذيِّ والعنبر الهندي",32,"د",2,0],["مخبَّل الخَلق في أوصاله حَوَل","كأنّ خِلْقته ثوب به شَطَر",33,"ر",1,0],["مخوف الشذا يمشي الضّراء لصيده","ويبرز للقرن المُناوي فيُصحِر",34,"ر",1,0],["مخافةً إن فاتنا سترها","أن نتلقى سوء مقدار",35,"ر",1,0],["مخضتُ فما اتّقى مخضِي بزبدٍ","وهل يُعطيكَ زُبدَ الماءِ مخضُ",36,"ض",1,0],["مُخلقاً بعد جِدَّةٍ راجلاً بع","د ركوبٍ نِقضاً من الأنقاض",37,"ض",1,0],["مخففةٌ ولم تبلغْ","مقالةَ قائل نحِلَهْ",38,"ل",2,0],["مُخطَفٌ مرهَف تبيّن فيه","أنه من مُضمَّرات الرِّهان",39,"ن",1,0],["مُخَلَّفونَ وَيَقضي الناسُ أَمرَهُمُ","وَهُم بِغَيبٍ وَفي عَمياءَ ما شَعَروا",40,"ر",3,0],["مُخَوُّفَنا المُثَقَّفَةَ العَوالي","لَقَد هَدَّدتَ بِالجَمرِ النَعاما",41,"م",2,0],["مَخضوبَةَ البَنانِ في يَمينِها","كَأسُ مُدامٍ تَخضِبُ البَنانا",42,"ن",2,0],["مُخَفَّفٌ عَن فُؤادي أَنَّ ثُكلَكُما","مُثَقِّلٌ ليَ يَومَ الحَشرِ ميزانا",43,"ن",2,0],["مخافتي من ناره","تثير فيّ الشجنا",44,"ن",2,0],["مخافة أن يُلمَّ الموت يوما","ببنيته فينهدم البناءُ",45,"ا",2,0],["مخلدة أرواحهم وجسومهم","هناك يقاسون المهانة والحرّا",46,"ر",2,0],["مُخطِئٌ مَن ظَنَّ يَوماً","أَنَّ لِلثَعلَبِ دينا",47,"ن",2,0],["مَخطوبَةٌ مُنذُ كانَ الناسُ خاطِبَةٌ","مِن أَوَّلِ الدَهرِ لَم تُرمِل وَلَم تَئَمِ",48,"م",1,0],["مَخلوقَةٌ ضَعيفَةٌ","مِن خُلُقٍ مُصَوَّرَه",49,"ر",2,0],["مُخَضَّبَةٌ وَالقَومُ صَرعى كَأَنَّها","وَإِن لَم يَكونوا ساجِدينَ مَساجِدُ",50,"د",1,0],["مُخلىً لَهُ المَرجُ مَنصوباً بِصارِخَةٍ","لَهُ المَنابِرُ مَشهوداً بِها الجُمَعُ",51,"ع",1,0],["مُخَيِّمُ الجَمعِ بِالبَيداءِ يَصهَرُهُ","حَرُّ الهَواجِرِ في صُمٍّ مِنَ الفِتَنِ",52,"ن",1,0],["مخدّرةً فارقتْ خِدرَها","فباتتْ ملثّمةً بالفِدامِ",53,"م",1,0],["مخلوقةً من فضَّةٍ","مغموسةً في ذهبِ",54,"ب",1,0],["مُخالِفَةً بِضَربٍ بَعدَ ضَربٍ","وَما أَنا وَاِختِلافاتُ الضُروبِ",55,"ب",1,0],["مَخاذيلُ لَم يَستُر فَضائِحَ عَجزِهِم","وَفاءٌ وَلَم يَنهَض بِغَدرِهِمِ شَغبُ",56,"ب",1,0],["مُخبِرَتي بُرقَةُ أَحواجِ","عَن ظُعُنٍ سارَت وَأَحداجِ",57,"ج",1,1],["مُخَيِّمونَ عَلى سيحِ العِراقِ أَبَت","إِلّا سُمُوّاً مَساعيهِم وَإِنجادا",58,"د",2,0],["مُخلِفٌ في الَّذي وَعَد","سيلَ وَصلاً فَلَم يَجُد",59,"د",1,1],["مُخَفَّضَةٌ أَقدارُهُم دونَ قَدرِهِ","كَما اِنخَفَضَت سُفلى تِهامَةَ عَن نَجدِ",60,"د",1,0],["مُخمِدٌ نارَ كُلَّ حَربٍ وَمُذكٍ","جَمرَها بِالرِماحِ بَعدَ خُمودِ",61,"د",1,0],["مُخِلٌّ بِتَصريفِ الأَعِنَّةِ طارِكٌ","لِقاءَ الزُحوفِ وَاِقتِيادَ العَساكِرِ",62,"ر",1,0],["مُخَيِّمٌ في دِمَشقَ مِن دونِهِ ال","خَرقُ بَعيدٌ مِن وِردِهِ صَدَرُه",63,"ر",2,0],["مُخضَرَّةٌ وَالغَيثُ لَيسَ بِساكِبٍ","وَمُضيأَةٌ وَاللَيلُ لَيسَ بِمُقمِرِ",64,"ر",1,0],["مُخَنَّثُ أَعراسٍ وَلَيسَ بِمُطرِبٍ","وَقَينَةُ فِتيانٍ وَلَيسَ بِعاتِقِ",65,"ق",1,0],["مُخالِفُ أَمرِكُم لِلَّهِ عاصٍ","وَمُنكِرُ حَقِّكُم لاقٍ أَثاما",66,"م",2,0],["مَخيلَةُ حِلمٍ في النَدِيِّ كَأَنَّها","إِذا اشتُهِرَت مِنهُ مَخيلَةُ تيهِ",67,"ي",2,0],["مُخَتَّمَةٍ مِن عَهدِ كِسرى بنِ هُرمُزٍ","بَكَرنا عَلَيها وَالفَراريجُ تَنعَبُ",68,"ب",1,0],["مُخَيَّسَةٍ بُزلٍ تَخايَلُ في البُرى","سَوارٍ عَلى طولِ الفَلاةِ غَوادي",69,"د",2,0],["مَخابِئَ حُبٍّ مِن حُمَيدَةَ لَم يَزَل","بِهِ سَقَمٌ مِن حُبِّها إِذ تَأَزَّرا",70,"ر",2,0],["مَخْزَنَةً من ذَهَبٍ","قد مُلِئَتْ كافورا",71,"ر",2,0],["مخضوبَةٌ بالخَمْرِ جاءَتْ بهِ","مُختَضَباً من دمِ عُنقودِها",72,"د",3,0],["مُخلَّدَةٍ تُطيلُ شَجَى الأعادي","وتَضمَنُ عن معاليكَ الخُلودا",73,"د",2,0],["مُختَصِبُ الكَفِّ من الصَّهباءِ","ومُجلِبٌ مُشَمِّرُ القِباءِ",74,"ا",2,0],["مَخوفٍ كَأَنَّ الطَيرَ في مَنزِلاتِهِ","عَلى جِيَفِ الحَسرى مَجالِسُ تَنتَجي",75,"ج",2,0],["مَخوفٍ بَأسُهُ يَكلَأكَ مِنهُ","عَتيقٌ لا أَلَفُّ وَلا سَؤومُ",76,"م",1,0],["مُخَمَّشَةً نَوادِبُهُ","مُسَلَّبَةً غَلائِلُهُ",77,"ل",2,0],["مَخافَةَ أَن أَرومَ لَهُ ار