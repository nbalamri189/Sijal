0247.html","البسيط"],[498,"أجتلى نور وجهه فأذب","https://www.aldiwan.net/poem37636.html","الخفيف"],[498,"قد أبصر الزمان علوى وغفا","https://www.aldiwan.net/poem37959.html","الرجز"],[513,"إذا قدرت على العلياء بالغلب","https://www.aldiwan.net/poem12009.html","البسيط"],[513,"سارت حشاشة مهجتي إذ ساروا","https://www.aldiwan.net/poem12127.html","الكامل"],[527,"يا حبذا كلام","https://www.aldiwan.net/poem37445.html","مجزوء الرجز"],[549,"زارك زوار الحلم","https://www.aldiwan.net/poem47191.html","مجزوء الرجز"],[549,"لا تقطعن رجاء العيش بالعلل","https://www.aldiwan.net/poem47259.html","البسيط"],[549,"يا جالبا للأرق","https://www.aldiwan.net/poem47350.html","مجزوء الرجز"],[549,"عرج على الدارسة القفر","https://www.aldiwan.net/poem47777.html","الرجز"],[556,"نهر القضاء بما يختار خالقنا","https://www.aldiwan.net/poem34625.html","البسيط"],[560,"في فتح عكا برد نار معاطب","https://www.aldiwan.net/poem52976.html","الكامل"],[562,"في فؤادي من الغرام لهيب","https://www.aldiwan.net/poem885.html",""],[565,"شطت لليلى باللوى","https://www.aldiwan.net/poem69615.html","مجزوء الرجز"],[565,"هذ الصبوح فما الذي","https://www.aldiwan.net/poem69659.html","مجزوء الكامل"],[565,"وحشية العينين مياسة","https://www.aldiwan.net/poem69688.html","مجزوء الكامل"],[565,"عادات طيفك أن يعاود","https://www.aldiwan.net/poem69711.html","مجزوء الكامل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["في فَيلَقٍ تَعمى الغَزالَةُ دونَهُ","وَتَكوسُ خابِطَةً بِغَيرِ طِعانِ",0,"ن",1,0],["في فِتيَةٍ رَكِبوا العُلى مِن هاشِمٍ","يَرمونَ أَقطارَ العَدُوِّ كَما رُموا",1,"م",3,0],["في فَيلَقٍ جَمِّ الذَوابِلِ وَالظُبى","مُثرٍ مِنَ الإِسراجِ وَالإِلجامِ",2,"م",1,0],["في فِتيَةٍ تَحسَبُهُم لُثِّموا","عَلى العَرانينِ بُدورَ التَمام",3,"م",1,0],["في فِتيَةٍ عَوَّدَهُم جَوبُ السُبُل","أَن يَشرَبوا ماءَهُم عَلى المَقَل",4,"ل",1,0],["في فُتوٍّ شَيَّعوا أَرماحَهُم","أَمَمَ المَوتِ إِلى الطَعنِ عِجالِ",5,"ل",1,0],["في فِتيَةٍ رَكِبوا أَعراصَهُم وَرَمَوا","بِالذُلِّ خَلفَ ظُهورِ الخَيلِ وَالإِبِلِ",6,"ل",1,0],["في فَيلَقٍ شَرِقٍ بِالبيضِ تَحسَبُهُ","بَرقاً تَدَلّى عَلى الآكامِ وَالقورِ",7,"ر",1,0],["فَيَفري طَريقاً لِلسِبارِ كَأَنَّما","لَها ذِمَّةٌ في الطَعنِ رِسلُ المَسابِرِ",8,"ر",1,0],["في فِتيَةٍ هَجَروا الأَوطانَ وَاِصطَنَعوا","أَيدي المَطايا بِإِدلاجٍ وَتَأويبِ",9,"ب",1,0],["في فِتيَةٍ تَسْحَبُ سُمْرَ القَنا","بحَيثُ ذَيلُ النّقعِ مَسْحوبُ",10,"ب",1,0],["في فِتْيَةٍ ذَمَرَتْ منْها العُلَى صُبُرا","قدْ ساغَ صِبْرُ المَنايا عندَها وحَلا",11,"ل",2,0],["فِي فِتْيَةٍ يَتَحَاوَرُونَ بَدَائِعاً","كَلَقِيطِ دُرٍّ أَوْ سَقِيطِ جُمَانِ",12,"ن",1,0],["في فُلكِهِ إِذ تَبَدّاها لِيَصنَعَها","وَظَلَّ يَجمَعُ أَلواحاً وَأَبوابا",13,"ب",2,0],["فَيَفجَعنَ ذا المالِ الكَثيرِ بِمالِهِ","وَطَوراً يُقَنّينَ الضَريكَ فَيَلحَقُ",14,"ق",1,0],["في فِتيَةٍ كَسُيوفِ الهِندِ قَد عَلِموا","أَن لَيسَ يَدفَعُ عَن ذي الحيلَةِ الحِيَلُ",15,"ل",1,0],["في فَتحِ مَكّةَ كانت دارُه حَرَماً","قد أمَّنَ اللهُ بعدَ البيتِ غاشِيها",16,"ي",3,0],["فَيَفرَحَ مَحزونٌ وَيَكبتَ حاسِدٌ","وَتَبرُدَ أَكبادٌ ذَكِيٌّ سَعيرُها",17,"ر",3,0],["في فِتيَةٍ مِثلُ النُجومِ تَسَنَّموا","في البيدِ أَمثالَ الأَهِلَّة ضُمَّرا",18,"ر",2,0],["في فُتُوٍّ تَوَشَحوا بِالمَعالي","وَتَرَدّوا بِكُلِّ مَجدٍ وَفَخرِ",19,"ر",1,0],["فَيَفُكُّ كُربَةَ مَن تَمَخ","خَخَ نِقيَةَ الدُوَلِ الجَهائِد",20,"د",1,0],["في فؤادي شكر لكم لا يؤدي","حقه بالمحبرات الطوال",21,"ل",1,0],["فِي فِتْيَةٍ مِنْ بَنِي الرُّومَانِ قَدْ أَلِفُوا","نَارَ الوَغَى فَحَكَوْا فِيهَا الشَّيَاطِينَا",22,"ن",2,0],["في فضل جودك قد عاشت مشيختها","في ظل أمنك قد نامت ذراريها",23,"ي",3,0],["فيفيض فيض العلم حتى يرتوي","منه بنو الأمصار والأرياف",24,"ف",1,0],["في فضاء لو سافر البرق فيه","ألف قرن لما أتى مستقرةّ",25,"ر",2,0],["في فِتيَةٍ كَسُيوفِ الهِندِ أَوجُهُهُم","نَحوَ الصَريخِ إِذا ما ثَوَّبَ الداعي",26,"ع",2,0],["في فُحشِ مومِسَةٍ قَليلٍ عَقلُها","مَشهورَةٍ بِالفُحشِ ذاتِ سِبابِ",27,"ب",1,0],["في فرقة بولا علياه ضاحية","شموس علمٍ تحامتها الدَّياجير",28,"ر",1,0],["فيفتح للجفن من مطبق","ويعمل للقلب من طابق",29,"ق",1,0],["في فيكِ خمرٌ وفي عطف الصبا ميد","فما تثنيك إلاَّ من ثناياك",30,"ك",1,0],["في فتيةٍ لم يلاق الناس إذ وجدوا","لهم شبيهاً ولا يلقون إن فُقدوا",31,"د",3,0],["في فمٍ يَنْفح مسكاً","حين يدنو للسِّرار",32,"ر",1,0],["في فيلق بات في الظلماء كوكبها","يهدي وأصبح للأبصار طرافا",33,"ف",2,0],["في فَيلَقٍ يَدعو الأَراقِمَ لَم تَكُن","فُرسانُهُ عُزلاً وَلا أَكفالا",34,"ل",2,0],["في فُؤادي لَو يَعلَمُ الناسُ جُرحٌ","لا يُلاشى حَتّى يُلاشى الفُؤادا",35,"ا",1,0],["في فُندُقٍ أَنا فيهِ ضَيفٌ","جَهَنَّمٍ مَحشورُ",36,"ر",1,0],["في فِتيَةٍ كَالنُجومِ الزُهرِ أَوجُهُهُم","ما فيهِمُ غَيرَ مَطبوعٍ عَلى الكَرَمِ",37,"م",1,0],["في فَمِها مُدامَةٌ","صافِيَةٌ تَرَوَّقَت",38,"ت",1,0],["في فضاءٍ موَرَّدٍ حالمٍ سَا","هٍ أَطافتْ بهِ عَذارى الفُنونِ",39,"ن",1,0],["في فِجاجِ الرَّدى","قَدْ دفنتُ الأَلمْ",40,"م",1,0],["في فؤادي الرَّحيبْ","مَعْبَدٌ للجَمَالْ",40,"ل",1,0],["في فتنة الشَّفقِ البَديعِ","وفي النُّجُومِ البَاسمهْ",41,"ه",1,0],["في فؤادي الغريبِ تُخْلَقُ أَكوانٌ","من السّحرِ ذاتُ حُسْنٍ فريدِ",42,"د",1,0],["في فَروقٍ وَرُباها مَأتَمٌ","ذَرَفَت آماقَها فيهِ العُيون",43,"ن",1,0],["في فِتنَةٍ خُلِطَ البَريءُ بِغَيرِهِ","فيها وَلُطِّخَ بِالدَمِ الأَبرارُ",44,"ر",1,0],["في فَيلَقٍ مِن حَديدٍ لَو قَذَفتَ بِهِ","صَرفَ الزَمانِ لَما دارَت دَوائِرُهُ",45,"ر",2,0],["في فَلَكٍ دائرٍ مَجَرَّتُهُ","نَهرٌ خِلالَ الرِّياضِ يَطَّرِدُ",46,"د",1,0],["في فترةٍ نُسِيَ الحُلومُ بها","وتشابَه المربوبُ والربُّ",47,"ب",1,0],["في فِتيَةٍ طَلَبوا غُبارَكَ إِنَّهُ","نَهجٌ تَرَفَّعَ عَن طَريقِ السُؤدُدِ",48,"د",1,0],["فَيَفهَمُهُ عَن طَرفِ عَينِيَ قَلبُها","فَتوحي بِطَرفِ العَينِ أَنّي عَلى العَهدِ",49,"د",1,0],["في فَضلِها وَبَذلِها وَخَيرِها","جَعفَرٌ الذائِدُ عَن ثُغورِها",50,"ر",3,0],["فيفِتيَةٍ بَكَروا عَلَيَّ تَطَرُّباً","مِن أَوجُهٍ شَتّى وَفيهِم دِعبِلُ",51,"ل",1,0],["في فمي يا عراق.. ماءٌ كثيرٌ","كيف يشكو من كان في فيه ماء؟",52,"ا",2,0],["في فتية لبسوا الحديد مغافرا","وبراقعا وسوابغا وسواعدا",53,"د",2,0],["في فِتيَةٍ جعلوا مَعاقِلَهم","بِيضَ الصَّفائحِ والقَنا السُّمرا",54,"ر",2,0],["في فِتيَةٍ لَيِّني المَآزِرِ لا","يَنسَونَ أَحلامَهُم إِذا سَكِروا",5