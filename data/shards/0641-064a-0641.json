.html","الكامل"],[45,"أسارقها خوف المراقب لحظة","https://www.aldiwan.net/poem63532.html","الطويل"],[45,"يا حسن مبدى الخيل في بكورها","https://www.aldiwan.net/poem63629.html","الرجز"],[45,"أبلغ أبا حسن بآية جوده","https://www.aldiwan.net/poem65616.html","الكامل"],[99,"إفادة في محكمة الشعر","https://www.aldiwan.net/poem6630.html","عموديه"],[61,"ردي الخيال يجد معنى واجدا","https://www.aldiwan.net/poem51370.html","الكامل"],[61,"أمن المدامة تنثني سكرا","https://www.aldiwan.net/poem51670.html","أحذ الكامل"],[2,"فيم لحت إن لومها ذعر","https://www.aldiwan.net/poem25030.html","المنسرح"],[49,"لهفي على الزمن القصير","https://www.aldiwan.net/poem64191.html","مجزوء الكامل"],[66,"في فساد الأحوال لله سر","https://www.aldiwan.net/poem38540.html","الخفيف"],[66,"خفض همومك فالحياة غرور","https://www.aldiwan.net/poem40119.html","الكامل"],[97,"بين الضنى والملالِ","https://www.aldiwan.net/poem24398.html","المجتث"],[44,"عزاء فلم يخلد حوي ولا عمرو","https://www.aldiwan.net/poem30312.html","الطويل"],[44,"أفدت ركاب أبي سعيد للنوى","https://www.aldiwan.net/poem30330.html","الكامل"],[87,"ذهب الصبا وتولت الأيام","https://www.aldiwan.net/poem8289.html","الكامل"],[74,"سقيا ليوم قد أنخت بسرحة","https://www.aldiwan.net/poem12856.html","الكامل"],[74,"سمح الخيال على النوى بمزار","https://www.aldiwan.net/poem12955.html","الكامل"],[105,"في حمى الحق ومن حول الحرم","https://www.aldiwan.net/poem42091.html","الرمل"],[52,"يا صاحبي شيبت عفوا","https://www.aldiwan.net/poem26585.html","مجزوء الكامل"],[75,"فتقت لكم ريح الجلاد بعنبر","https://www.aldiwan.net/poem69080.html","الكامل"],[48,"عفا المصلى وأقوت الكثب","https://www.aldiwan.net/poem10767.html","المنسرح"],[48,"وفتية كمصابيح الدجى غرر","https://www.aldiwan.net/poem62458.html","البسيط"],[48,"طاب الزمان وأورق الأشجار","https://www.aldiwan.net/poem63309.html","الكامل"],[46,"إصبر فمن حيث أهين الحصى","https://www.aldiwan.net/poem22595.html","السريع"],[46,"أعن وخد القلاص كشفت حالا","https://www.aldiwan.net/poem23633.html","الوافر"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85377","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85552","الطويل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125577","الرجز"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16673",""],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30463","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42676","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55180","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54908","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54741","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55102","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142062","البسيط"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/13469","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43762","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54195","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54204","الخفيف"],[77,"عهد الشباب سقى أيامك الأولا","https://www.poetsgate.com/ViewPoem.aspx?id=34202",""],[100,"ليلة خائف","https://www.poetsgate.com/ViewPoem.aspx?id=50433",""],[84,"ولرب حان قد أدرت بديره","https://www.poetsgate.com/ViewPoem.aspx?id=26328",""],[9,"معلقة الأعشي","https://www.poetsgate.com/ViewPoem.aspx?id=11407",""],[45,"أصَبَا الأصَائِلِ إنّ بُرْقَةَ مُنْشِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=32956",""],[91,"صاحب القلم","https://www.poetsgate.com/ViewPoem.aspx?id=53269",""],[85,"أخذتْ نعشكِ مصرُ باليمينْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9630&r=&rc=120",""]],"verses":[["في فَيلَقٍ تَعمى الغَزالَةُ دونَهُ","وَتَكوسُ خابِطَةً بِغَيرِ طِعانِ",0,"ن",1,0],["في فِتيَةٍ رَكِبوا العُلى مِن هاشِمٍ","يَرمونَ أَقطارَ العَدُوِّ كَما رُموا",1,"م",3,0],["في فَيلَقٍ جَمِّ الذَوابِلِ وَالظُبى","مُثرٍ مِنَ الإِسراجِ وَالإِلجامِ",2,"م",1,0],["في فِتيَةٍ تَحسَبُهُم لُثِّموا","عَلى العَرانينِ بُدورَ التَمام",3,"م",1,0],["في فِتيَةٍ عَوَّدَهُم جَوبُ السُبُل","أَن يَشرَبوا ماءَهُم عَلى المَقَل",4,"ل",1,0],["في فُتوٍّ شَيَّعوا أَرماحَهُم","أَمَمَ المَوتِ إِلى الطَعنِ عِجالِ",5,"ل",1,0],["في فِتيَةٍ رَكِبوا أَعراصَهُم وَرَمَوا","بِالذُلِّ خَلفَ ظُهورِ الخَيلِ وَالإِبِلِ",6,"ل",1,0],["في فَيلَقٍ شَرِقٍ بِالبيضِ تَحسَبُهُ","بَرقاً تَدَلّى عَلى الآكامِ وَالقورِ",7,"ر",1,0],["فَيَفري طَريقاً لِلسِبارِ كَأَنَّما","لَها ذِمَّةٌ في الطَعنِ رِسلُ المَسابِرِ",8,"ر",1,0],["في فِتيَةٍ هَجَروا الأَوطانَ وَاِصطَنَعوا","أَيدي المَطايا بِإِدلاجٍ وَتَأويبِ",9,"ب",1,0],["في فِتيَةٍ تَسْحَبُ سُمْرَ القَنا","بحَيثُ ذَيلُ النّقعِ مَسْحوبُ",10,"ب",1,0],["في فِتْيَةٍ ذَمَرَتْ منْها العُلَى صُبُرا","قدْ ساغَ صِبْرُ المَنايا عندَها وحَلا",11,"ل",2,0],["فِي فِتْيَةٍ يَتَحَاوَرُونَ بَدَائِعاً","كَلَقِيطِ دُرٍّ أَوْ سَقِيطِ جُمَانِ",12,"ن",1,0],["في فُلكِهِ إِذ تَبَدّاها لِيَصنَعَها","وَظَلَّ يَجمَعُ أَلواحاً وَأَبوابا",13,"ب",2,0],["فَيَفجَعنَ ذا المالِ الكَثيرِ بِمالِهِ","وَطَوراً يُقَنّينَ الضَريكَ فَيَلحَقُ",14,"ق",1,0],["في فِتيَةٍ كَسُيوفِ الهِندِ قَد عَلِموا","أَن لَيسَ يَدفَعُ عَن ذي الحيلَةِ الحِيَلُ",15,"ل",1,0],["في فَتحِ مَكّةَ كانت دارُه حَرَماً","قد أمَّنَ اللهُ بعدَ البيتِ غاشِيها",16,"ي",3,0],["فَيَفرَحَ مَحزونٌ وَيَكبتَ حاسِدٌ","وَتَبرُدَ أَكبادٌ ذَكِيٌّ سَعيرُها",17,"ر",3,0],["في فِتيَةٍ مِثلُ النُجومِ تَسَنَّموا","في البيدِ أَمثالَ الأَهِلَّة ضُمَّرا",18,"ر",2,0],["في فُتُوٍّ تَوَشَحوا بِالمَعالي","وَتَرَدّوا بِكُلِّ مَجدٍ وَفَخرِ",19,"ر",1,0],["فَيَفُكُّ كُربَةَ مَن تَمَخ","خَخَ نِقيَةَ الدُوَلِ الجَهائِد",20,"د",1,0],["في فؤادي شكر لكم لا يؤدي","حقه بالمحبرات الطوال",21,"ل",1,0],["فِي فِتْيَةٍ مِنْ بَنِي الرُّومَانِ قَدْ أَلِفُوا","نَارَ الوَغَى فَحَكَوْا فِيهَا الشَّيَاطِينَا",22,"ن",2,0],["في فضل جودك قد عاشت مشيختها","في ظل أمنك قد نامت ذراريها",23,"ي",3,0],["فيفيض فيض العلم حتى يرتوي","منه بنو الأمصار والأرياف",24,"ف",1,0],["في فضاء لو سافر البرق فيه","ألف قرن لما أتى مستقرةّ",25,"ر",2,0],["في فِتيَةٍ كَسُيوفِ الهِندِ أَوجُهُهُم","نَحوَ الصَريخِ إِذا ما ثَوَّبَ الداعي",26,"ع",2,0],["في فُحشِ مومِسَةٍ قَليلٍ عَقلُها","مَشهورَةٍ بِالفُحشِ ذاتِ سِبابِ",27,"ب",1,0],["في فرقة بولا علياه ضاحية","شموس علمٍ تحامتها الدَّياجير",28,"ر",1,0],["فيفتح للجفن من مطبق","ويعمل للقلب من طابق",29,"ق",1,0],["في فيكِ خمرٌ وفي عطف الصبا ميد","فما تثنيك إلاَّ من ثناياك",30,"ك",1,0],["في فتيةٍ لم يلاق الناس إذ وجدوا","لهم شبيهاً ولا يلقون إن فُقدوا",31,"د",3,0],["في فمٍ يَنْفح مسكاً","حين يدنو للسِّرار",32,"ر",1,0],["في فيلق بات في الظلماء كوكبها","يهدي وأصبح للأبصار طرافا",33,"ف",2,0],["في فَيلَقٍ يَدعو الأَراقِمَ لَم تَكُن","فُرسانُهُ عُزلاً وَلا أَكفالا",34,"ل",2,0],["في فُؤادي لَو يَعلَمُ الناسُ جُرحٌ","لا يُلاشى حَتّى يُلاشى الفُؤادا",35,"ا",1,0],["في فُندُقٍ أَنا فيهِ ضَيفٌ","جَهَنَّمٍ مَحشورُ",36,"ر",1,0],["في فِتيَةٍ كَالنُجومِ الزُهرِ أَوجُهُهُم","ما فيهِمُ غَيرَ مَطبوعٍ عَلى الكَرَمِ",37,"م",1,0],["في فَمِها مُدامَةٌ","صافِيَةٌ تَرَوَّقَت",38,"ت",1,0],["في فضاءٍ موَرَّدٍ حالمٍ سَا","هٍ أَطافتْ بهِ عَذارى الفُنونِ",39,"ن",1,0],["في فِجاجِ الرَّدى","قَدْ دفنتُ الأَلمْ",40,"م",1,0],["في فؤادي الرَّحيبْ","مَعْبَدٌ للجَمَالْ",40,"ل",1,0],["في فتنة الشَّفقِ البَديعِ","وفي النُّجُومِ البَاسمهْ",41,"ه",1,0],["في فؤادي الغريبِ تُخْلَقُ أَكوانٌ","من السّحرِ ذاتُ حُسْنٍ فريدِ",42,"د",1,0],["في فَروقٍ وَرُباها مَأتَمٌ","ذَرَفَت آماقَها فيهِ العُيون",43,"ن",1,0],["في فِتنَةٍ خُلِطَ البَريءُ بِغَيرِهِ","فيها وَلُطِّخَ بِالدَمِ الأَبرارُ",44,"ر",1,0],["في فَيلَقٍ مِن حَديدٍ لَو قَذَفتَ بِهِ","صَرفَ الزَمانِ لَما دارَت دَوائِرُهُ",45,"ر",2,0],["في فَلَكٍ دائرٍ مَجَرَّتُهُ","نَهرٌ خِلالَ الرِّياضِ يَطَّرِدُ",46,"د",1,0],["في فترةٍ نُسِيَ الحُلومُ بها","وتشابَه المربوبُ والربُّ",47,"ب",1,0],["في فِتيَةٍ طَلَبوا غُبارَكَ إِنَّهُ","نَهجٌ تَرَفَّعَ عَن طَريقِ السُؤدُدِ",48,"د",1,0],["فَيَفهَمُهُ عَن طَرفِ عَينِيَ قَلبُها","فَتوحي بِطَرفِ العَينِ أَنّي عَلى العَهدِ",49,"د",1,0],["في فَضلِها وَبَذلِها وَخَيرِها","جَعفَرٌ الذائِدُ عَن ثُغورِها",50,"ر",3,0],["فيفِتيَةٍ بَكَروا عَلَيَّ تَطَرُّباً","مِن أَوجُهٍ شَتّى وَفيهِم دِعبِلُ",51,"ل",