{"poems":[[53,"رجونا أبا الهيجاء إذ مات حارث","https://www.aldiwan.net/poem30665.html","الطويل"],[24,"إن عرسي قد آذنتني أخيرا","https://www.aldiwan.net/poem21863.html","الخفيف"],[51,"لم يبكني رسم منزل طسما","https://www.aldiwan.net/poem66036.html","المنسرح"],[31,"إنني اليوم عادني أحزاني","https://www.aldiwan.net/poem41287.html","الخفيف"],[48,"أنعت كلبا جال في رباطه","https://www.aldiwan.net/poem64372.html","البسيط"],[48,"خل جنبيك لرام","https://www.aldiwan.net/poem65273.html","مجزوء الرمل"],[1,"سائلوا عنا الذي يعرفنا","https://www.aldiwan.net/poem34017.html","الرمل"],[164,"خل جرجان وخيم أينما","https://www.aldiwan.net/poem46866.html","الرمل"],[451,"يا رذاذ الربيع يا معلن اليقظة","https://www.aldiwan.net/poem61337.html","الخفيف"],[549,"فجعة ما احتسبتها في زماني","https://www.aldiwan.net/poem47168.html","الخفيف"]],"verses":[["خَلَجتُم لِحَسّاسِ بنِ مُرَّةَ طَعنَةً","رَأى الجِدَّ فيها هِجرِسٌ وَهوَ حابِثُ",0,"ث",1,0],["خُلُجاً مِن مُعَبَّدٍ مُسبَطِرٍّ","فَقَّرَ الأُكَم وَالصُوى تَفقيرا",1,"ر",2,0],["خلٌّ جفاني لنعمةٍ حدثت","له فجازته بالذي حكما",2,"م",2,0],["خَلَجَت عَينِيَ اليَمينُ بِخَيرٍ","تِلكَ عَينٌ مَأمونَةِ الخَلَجانِ",3,"ن",1,0],["خَلجُ ذِراعَيهِ إِلى مِلاطِهِ","يَنقَدُّ عَنهُ الضيقُ بِاِنعِطاطِهِ",4,"ط",2,0],["خَلِّ جَنبَيكَ لِرامِ","وَاِمضِ عَنهُ بِسَلامِ",5,"م",1,1],["خُلُجُ الشَدِّ مُلِحّاتٌ إِذا","شالَتِ الأَيدي عَلَيها بِالجِذَم",6,"م",1,0],["خلِّ جُرجانَ وخيِّم أينَما","شئتَ من مَرعىً مُباحٍ وحِمى",7,"م",2,1],["خلجات الفؤاد من بعض ما","فيه ومن بعضه سميع وفاهم",8,"م",1,0],["خَلَجَتْ في بَبْغاءَ نَبْوَةُ دهرٍ","مُولَعٍ بالنَّفيسِ من أثماني",9,"ي",1,0]]}