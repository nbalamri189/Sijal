{"poems":[[55,"رجونا أبا الهيجاء إذ مات حارث","https://www.aldiwan.net/poem30665.html","الطويل"],[24,"إن عرسي قد آذنتني أخيرا","https://www.aldiwan.net/poem21863.html","الخفيف"],[53,"لم يبكني رسم منزل طسما","https://www.aldiwan.net/poem66036.html","المنسرح"],[33,"إنني اليوم عادني أحزاني","https://www.aldiwan.net/poem41287.html","الخفيف"],[50,"أنعت كلبا جال في رباطه","https://www.aldiwan.net/poem64372.html","البسيط"],[50,"خل جنبيك لرام","https://www.aldiwan.net/poem65273.html","مجزوء الرمل"],[1,"سائلوا عنا الذي يعرفنا","https://www.aldiwan.net/poem34017.html","الرمل"],[170,"خل جرجان وخيم أينما","https://www.aldiwan.net/poem46866.html","الرمل"],[458,"يا رذاذ الربيع يا معلن اليقظة","https://www.aldiwan.net/poem61337.html","الخفيف"],[556,"فجعة ما احتسبتها في زماني","https://www.aldiwan.net/poem47168.html","الخفيف"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87831","الكامل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114738","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205717","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216628",""],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83133","الخفيف"],[4690,"لا تقْلقي","https://www.poetsgate.com/ViewPoem.aspx?id=153095",""],[4791,"آهات","https://www.poetsgate.com/ViewPoem.aspx?id=28422",""],[5055,"حب الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=101652",""],[5186,"أي متى كنت مغرما بالملاح؟","https://www.poetsgate.com/ViewPoem.aspx?id=156552",""],[5187,"زيارة لقصر العظم","https://www.poetsgate.com/ViewPoem.aspx?id=29065",""],[5449,"اضحك بقلبك","https://www.poetsgate.com/ViewPoem.aspx?id=196924",""],[6115,"اسمع الرأي المسدد يالحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=180524",""]],"verses":[["خَلَجتُم لِحَسّاسِ بنِ مُرَّةَ طَعنَةً","رَأى الجِدَّ فيها هِجرِسٌ وَهوَ حابِثُ",0,"ث",1,0],["خُلُجاً مِن مُعَبَّدٍ مُسبَطِرٍّ","فَقَّرَ الأُكَم وَالصُوى تَفقيرا",1,"ر",2,0],["خلٌّ جفاني لنعمةٍ حدثت","له فجازته بالذي حكما",2,"م",2,0],["خَلَجَت عَينِيَ اليَمينُ بِخَيرٍ","تِلكَ عَينٌ مَأمونَةِ الخَلَجانِ",3,"ن",1,0],["خَلجُ ذِراعَيهِ إِلى مِلاطِهِ","يَنقَدُّ عَنهُ الضيقُ بِاِنعِطاطِهِ",4,"ط",2,0],["خَلِّ جَنبَيكَ لِرامِ","وَاِمضِ عَنهُ بِسَلامِ",5,"م",1,1],["خُلُجُ الشَدِّ مُلِحّاتٌ إِذا","شالَتِ الأَيدي عَلَيها بِالجِذَم",6,"م",1,0],["خلِّ جُرجانَ وخيِّم أينَما","شئتَ من مَرعىً مُباحٍ وحِمى",7,"م",2,1],["خلجات الفؤاد من بعض ما","فيه ومن بعضه سميع وفاهم",8,"م",1,0],["خَلَجَتْ في بَبْغاءَ نَبْوَةُ دهرٍ","مُولَعٍ بالنَّفيسِ من أثماني",9,"ن",2,0],["خَلَجَتهُ عَن لُبنانَ وَهوَ بِحاجَةٍ","قُصوى إِلى رَبِّ النُهى المِكرامِ",10,"م",1,0],["خَلِّ جَنبَيكَ لِبَاغِ","وتجوَّز بِبَلاغِ",11,"غ",1,1],["خلِّ جهلَ الناس في ظلمائه","واجلُ لي حبَّك نورًا فوق نور",12,"ر",1,0],["خلجانه تنساب كال","حيات ما بين الصخور",13,"ر",1,0],["خَلَجاتٌ تَهفو بِقَلبِ الشَجِيِّ","هِيَ سرُّ الحَياةِ في كُلِّ حَيِّ",14,"ي",1,1],["خلجان صبْري لا تُضاهى فانْهلي","ماشئتِ منها ، من جَداولها اسْتَقي",15,"ق",2,0],["خلٍ جيوشه بالمحبة غزتني","وانا أسيرٍ للعيون العفيفه",16,"ف",2,0],["خل جاحد المعروف في صف ( جالوت )","متنّحجبْ شمس الضحى بظلّة الدير",17,"ر",1,0],["خل جزين تهتدي والأضاحي","بهدى نور وجهك الوضاح",18,"ح",1,0],["خلجاتُ قلبي حين أرمقهم ترى","ما يلاحظ من فراسةِ ساحرِ",19,"ر",1,0],["خلجاتُ صدرِكَ في عيونِكَ أسطرٌ","والعينُ لا تدري النِّفاقَ ولا الرِّياءْ",20,"ا",2,0],["خل جدرك بالبنا دايم قطيب","الجدر لو ما تجوّد مايقف",21,"ف",1,0]]}