{"poems":[[53,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[53,"رقعة من معاتب لك ظلت","https://www.aldiwan.net/poem66390.html","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43834","البسيط"],[111,"تكب على دنياك وهي تبيد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545632",""],[121,"يوم الشَّنق","https://www.aldiwan.net/poem24032.html","الكامل"],[125,"ألا عم صباحاً أيها الربع منعما","https://www.aldiwan.net/poem23818.html","الطويل"],[164,"من كان يكتب ما الأيام تمليه","https://www.aldiwan.net/poem59160.html","البسيط"],[266,"تذكر مهدا بالغوير ومعهدا","https://www.aldiwan.net/poem38337.html","الطويل"],[280,"ولا ودعوا يوم النوى جارة الحمى","https://www.aldiwan.net/poem25412.html","الطويل"],[333,"كذبت هند حين قالت لك القل","https://www.aldiwan.net/poem54941.html","الخفيف"],[396,"يا تاركين الصلاة","https://www.aldiwan.net/poem54601.html","عموديه"],[396,"ما في فعايلي شيء يعجب","https://www.aldiwan.net/poem54634.html","عموديه"],[408,"عجبت من الفعلاء إذ حديت بها","https://www.aldiwan.net/poem46943.html","الطويل"],[435,"يا نفس عدي عن الزلات وارتدعي","https://www.aldiwan.net/poem39828.html","البسيط"],[563,"توبة النفس في الهوى أن تموتا","https://www.aldiwan.net/poem33557.html","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38926","الطويل"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99985","المديد"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61240","البسيط"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126132","الرجز"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77868","الرجز"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/78009","الكامل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89541","الرمل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77327","البسيط"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120597","الكامل"],[2546,"","https://poetry.dctabudhabi.ae/diwan/poem/33971","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58324","الكامل"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99465","الطويل"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115747","السريع"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112495","الرمل"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104307","السريع"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74070","الكامل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35097","الطويل"],[4684,"يغتالنا خببا","https://www.poetsgate.com/ViewPoem.aspx?id=201573",""],[4690,"من القلب إلى القلب","https://www.poetsgate.com/ViewPoem.aspx?id=131041",""],[4718,"ياصاح مالي ومال الحب ودروبه","https://www.poetsgate.com/ViewPoem.aspx?id=137246",""],[4767,"المنزلة","https://www.poetsgate.com/ViewPoem.aspx?id=179760",""],[4929,"الى أصحاب قمة اسطنبول","https://www.poetsgate.com/ViewPoem.aspx?id=199263",""],[5277,"جُبٌّ...ولا دِلَاء","https://www.poetsgate.com/ViewPoem.aspx?id=199916",""],[5318,"استغفروا اللهَ عمّا كان من سَفهٍ","https://www.poetsgate.com/ViewPoem.aspx?id=213797",""],[5363,"مفخرة الإنسانية","https://www.poetsgate.com/ViewPoem.aspx?id=144431",""],[5401,"سلّم الذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=85959",""],[121,"من صدام حسين الى قادة الزعماء العرب","https://www.poetsgate.com/ViewPoem.aspx?id=176701",""],[5956,"عجباً يحارب نفسه الصّومالُ","https://www.poetsgate.com/ViewPoem.aspx?id=194484",""],[6070,"فاضَ الهيامُ بدوحةِ الأفكارِ","https://www.poetsgate.com/ViewPoem.aspx?id=188568",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[5075,"موتوا لأجل القدس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82754&r=&rc=0",""]],"verses":[["توبةٌ مثلُ حَوْبةٍ وقديماً","أتبعَ الجهلُ زلةً بارتطام",0,"م",1,0],["تَوْبةً بعد حَوْبةٍ من عتابي","ك فهل أنتَ قابلٌ يا فلانُ",1,"ن",1,0],["توبي إِلى اللَهِ لا تَزلّي","نَجاتُكِ التَوبُ وَالثَباتُ",2,"ت",1,0],["توبخها والذنب لا ريب ذنبنا","وقد أعذرت والطارقات شهود",3,"د",1,0],["تُوبُوا إلى (إلى شارون) قبلَ رَحِيلِكُمْ","واسْتَغْفِرُوهُ فإنَّه تَوَّابُ",4,"ب",1,0],["تؤب له الأكوان في كل أمرها","وآب إلى المولى صدوراً ومجثما",5,"م",2,0],["توبا إلى الله إن كانت بصائركم","سليمة واحذروا ما الحكم يجريه",6,"ي",2,0],["تؤبد ايام السرور به لنا","وان لم يكن في الدهر يوماً مؤبدا",7,"د",2,0],["تُوبِخني الأَحْداثُ وَالشَّيْخُ عاذِرِي","عَلَى سَفَهٍ فِي الحلْمِ يَا حَسْرَتِي وَحْدِي",8,"د",2,0],["توبتي عن تعشقي واصطباري","وهيامي بالروح والريحان",9,"ن",1,0],["توبوا إلى ربكم","من قبل تمسوا رفات",10,"ت",1,0],["توبة صحيحة ومقبولة","فيها الهنا والشفا والطب",11,"ب",1,0],["تُوبّخُها حتى الكَلابُ لِفِعْلِها","وتُنصحُ لو أجدتْ هناك النّصائحُ",12,"ح",1,0],["توبي إلى اللَه واستدعيه مغفرةً","فإنهُ الغافر التواب حين دعي",13,"ع",2,0],["توبة النفس في الهوى أن تموتا","فتنال المنى وتدرك قوتا",14,"ت",2,1],["تؤبَّدُ بِالتّوفيقِ وَالنّصرِ وَالعُلى","وَتحمدُ في الآفاقِ مَنشورة البَنْدِ",15,"د",1,0],["تَوْبَتِي قَدْ ذَلَّ جانِبُهَا","بِيعَ مِنْها النَّوْمُ بِالسُّهْدِ",16,"د",1,0],["توبي إِلى اللَّه إِن اللَه يَقبلها","وَاسعي بِجهدك في تَحسين عُقباك",17,"ك",1,0],["توبة كل مذنب إقراره","فإن يتب فذلك اعتذاره",18,"ه",1,0],["توبوا عَن الإِعراض إِنا تبنا","منكم جَرى ما قَد جَرى لامنا",19,"ن",2,0],["توبوا هديتم لا تشينوا حبكم","آل النبي ببغضهم لتراؤوا",20,"ا",1,0],["تَوبَةً رَبّي وَغُفراناً لِما","قُلتُ شِعراً وَهوَ تَشبيبٌ وَمَزحُ",21,"ح",1,0],["تُوبُوا إلَى الرَّحمَنِ مِن تَعطِيلكُم","فَالرَّبُّ يَقبَلُ تَوبَةَ النَّدمَانِ",22,"ن",1,0],["توبي لِرَبِّكِ وَاِخشَي هَولَ غَضبَتِهِ","وَعانِقي سُنَّةَ المُختارِ وَالتَزِمي",23,"م",2,0],["تُوبُوا عبادَ الله تَوبَةَ مُخلِصٍ","لِلّهِ تَمحُو بالمتَابِ الحُوبا",24,"ب",2,0],["توبي فَإِنَّكِ عالِمَه","أَولا فَإِنّي آثِمَه",25,"م",2,0],["توبوا وصلّوا داعيين لمُلكه","فيه تنالون النّعيمَ الأكبرا",26,"ر",2,0],["توبخني بالشيب مرشدٌ","لعمري ولكن لست أنشط للرشد",27,"د",1,0],["توبوا إلى الرحمن يغفر لكم","ذنوبكم فهوا الغفور الرحيم",28,"م",1,0],["توبةٌ من بعد أن فزت بها","كل شيء صارفى عيني هنيّا",29,"ي",2,0],["توبوا إليه واطلبوا فضله","فإنه أكرم رزاق",30,"ق",1,0],["توبوا عَسى تُنسى ذنوبكم","فَشِعار مصر الصفح وَالكرمُ",31,"م",1,0],["تُؤَبَّدُ فيها شَعشَعانِيَّةُ الضُحى","إِذا ضاحَكَ الشَمسُ البُحَيرَةَ وَالنَهرا",32,"ر",2,0],["توبوا الى حضن أمٍّ ذابَ خافِقُها","ما أطيب الوصل والإحسانَ والسَّقبا",33,"ب",2,0],["توبي لربّك وارجعي عنْ زلّة","ألله يعلم سِرّنا والخافيه",34,"ي",2,0],["توبه وانا قولها توبه من النوبه","وارجع واحاول معه عله يجاوبني",35,"ن",2,0],["توبوا تنالوا من الرحمان مغفرةً","قد نالها تائب من كل عصيان",36,"ن",1,0],["توبوا لبارئكم وكونوا صورةً","لشعوبكم صدقًا وقولوا وافعلوا",37,"ل",3,0],["توبي..فقد تابتْ زليخةُ بعد ما","طاشتْ..وكادتْ انْ تكونَ الباهلةْ",38,"ل",2,0],["توبوا إلى الله، علَّ اللهَ يُنجينا","مما اقترفنا وضيّعنا وصاياهُ",39,"ا",2,0],["تؤِّبُ في خشوعٍ في صدوعٍ","مع العبدِ النبيِّ مع الأياءِ",40,"ا",2,0],["توبه وهذا الموقف اللي وقفته","حتى آتحاشى سالفة طابخ الفاس",41,"س",1,0],["توبوا إلى (أولمرت) قبل رحيلكم","واستغفروه فإنه توّابُ",42,"ب",1,0],["توبوا إلى الرّحمن ثوبوا للهدى","وتغيّروا تتغيّرِ الأحوالُ",43,"ل",1,0],["توبوا إليهِ لتنعموا في جنَّةِ","قدْ خصَّها الرحمنُ للأبرارِ",44,"ر",1,0],["توبك يا تواب للتواب حق","وباسمك المنتقم الطاغي انكسر",45,"ر",1,0],["توبي إلى الرحمنِ عودي حولَنَا","فهوَ الذي يَهبُ العُلا ويُتيحُ",46,"ح",1,0]]}