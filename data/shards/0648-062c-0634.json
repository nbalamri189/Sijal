{"poems":[[86,"ولت بشاشة دنيانا ودنياك","https://www.aldiwan.net/poem10363.html","البسيط"],[47,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[51,"أرقت كأني بت ليلي على الجمر","https://www.aldiwan.net/poem62871.html","الطويل"],[85,"سماؤك يا دنيا خداع سراب","https://www.aldiwan.net/poem62924.html","الطويل"],[105,"جزى الله ما أديتما من حقوقه","https://www.aldiwan.net/poem43160.html","الطويل"],[40,"هاج الفؤاد وأمسى الحلم قد عزبا","https://www.aldiwan.net/poem42289.html","البسيط"],[235,"تعززت بذي العز","https://www.aldiwan.net/poem18832.html","الهزج"],[475,"كم رضت جامح قلبي عنكم فأبى","https://www.aldiwan.net/poem15242.html","البسيط"]],"verses":[["وَجَشَّموني عَلى ضَعفي وَقُوَّتِهِم","أَن أُمسِكَ القَولَ حَتّى عَن تَحاياكِ",0,"ك",1,0],["وَجَشَّمَها بَطنَ السَماوَةِ قائِظاً","وَقَد أوقِدَت نارَ السُمومِ الهَواجِرُ",1,"ر",1,0],["وجشَّمتُ نفسي فيك كلّ عظيمةٍ","إلى أن تكفَّفتُ الشفاعةَ من عمرو",2,"ر",2,0],["وَجَشَّمتَ مَيدانَ السِياسَةِ فارِساً","وَكُلُّ جَوادٍ في السِياسَةِ كابي",3,"ب",2,0],["وَجَشَّمتُما نَفسَيكُما كُلَّ فادِحٍ","مِنَ الأَمرِ يودي هَولُهُ بِالعَزائِمِ",4,"م",1,0],["وَجَشَّمَتهُ السُرى قُربى وَما جَشِمَت","قُربى سُرى لَيلَةٍ فيهِ وَلا تَعَبا",5,"ب",2,0],["وَجِشْ لِي كُلَّمَا حَزٍّ","بِفَضْلٍ جَلَّ عَنْ حَزِّ",6,"ز",1,0],["وجشَّمتْنَي جوبَ البيدِ طامسةً","يلقى الخيالُ إذا ما جاسَها نَصَبا",7,"ب",2,0]]}