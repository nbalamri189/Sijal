{"poems":[[88,"ولت بشاشة دنيانا ودنياك","https://www.aldiwan.net/poem10363.html","البسيط"],[49,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[53,"أرقت كأني بت ليلي على الجمر","https://www.aldiwan.net/poem62871.html","الطويل"],[87,"سماؤك يا دنيا خداع سراب","https://www.aldiwan.net/poem62924.html","الطويل"],[107,"جزى الله ما أديتما من حقوقه","https://www.aldiwan.net/poem43160.html","الطويل"],[42,"هاج الفؤاد وأمسى الحلم قد عزبا","https://www.aldiwan.net/poem42289.html","البسيط"],[242,"تعززت بذي العز","https://www.aldiwan.net/poem18832.html","الهزج"],[482,"كم رضت جامح قلبي عنكم فأبى","https://www.aldiwan.net/poem15242.html","البسيط"],[969,"","https://poetry.dctabudhabi.ae/diwan/poem/145611","الخفيف"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93094","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49993","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79810","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101039","الطويل"],[1858,"","https://poetry.dctabudhabi.ae/diwan/poem/106702","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65938","الطويل"],[3553,"","https://poetry.dctabudhabi.ae/diwan/poem/17672","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129446","الطويل"],[5452,"بدون تأشيرة","https://www.poetsgate.com/ViewPoem.aspx?id=148451",""],[2914,"ومَن كانَ لا تُعتَدُّ أيّامُهُ لهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=24242&r=&rc=8",""]],"verses":[["وَجَشَّموني عَلى ضَعفي وَقُوَّتِهِم","أَن أُمسِكَ القَولَ حَتّى عَن تَحاياكِ",0,"ك",1,0],["وَجَشَّمَها بَطنَ السَماوَةِ قائِظاً","وَقَد أوقِدَت نارَ السُمومِ الهَواجِرُ",1,"ر",1,0],["وجشَّمتُ نفسي فيك كلّ عظيمةٍ","إلى أن تكفَّفتُ الشفاعةَ من عمرو",2,"ر",2,0],["وَجَشَّمتَ مَيدانَ السِياسَةِ فارِساً","وَكُلُّ جَوادٍ في السِياسَةِ كابي",3,"ب",2,0],["وَجَشَّمتُما نَفسَيكُما كُلَّ فادِحٍ","مِنَ الأَمرِ يودي هَولُهُ بِالعَزائِمِ",4,"م",1,0],["وَجَشَّمَتهُ السُرى قُربى وَما جَشِمَت","قُربى سُرى لَيلَةٍ فيهِ وَلا تَعَبا",5,"ب",2,0],["وَجِشْ لِي كُلَّمَا حَزٍّ","بِفَضْلٍ جَلَّ عَنْ حَزِّ",6,"ز",1,0],["وجشَّمتْنَي جوبَ البيدِ طامسةً","يلقى الخيالُ إذا ما جاسَها نَصَبا",7,"ب",2,0],["وجشيش السميذ أعذب عندي","من رضاب الحبيب عند العناق",8,"ق",1,0],["وجشمها شرق البلاد وغربها","إذا جاز منها سيسباً أم سبسبا",9,"ب",2,0],["وجشَّم طيَّ البيد كل شملّةٍ","عُذافرةٍ حتى أكلَّ وأحرَفا",10,"ف",2,0],["وجشَّمها المسرى ببيداءَ قفرةٍ","ولم تدر قبلَ الطفّ ما البيدُ والسرى",11,"ر",2,0],["وجشات أواذيها فقمنا حيالها","برأس من الأحلام غير مهيل",12,"ل",1,0],["وجَشَّمَها المنصورُ خُرسَ كتائبٍ","تُحَمِّلُ ما يُردِي فيحمِلُهُ الصّبرُ",13,"ر",1,0],["وجشمت نفسي البر والبحر أبتغي","نصيراً فلم أظفر بقرم مهذب",14,"ب",1,0],["وَجَشَّمَني خَوفُ اِبنِ عَفّانَ رَدَّها","فَثَقَّفتُها حَولاً حَريداً وَمَربَعا",15,"ع",2,0],["وجشمها نجد العراق تحفه","مصاليت حرب من ذؤابة هاشم",16,"م",1,0],["وجشّمتنا عناء البحر نركبه","من أجل قوت بنادينا حرمناهُ",17,"ا",2,0],["وجشَّامة ُ الذُّهليُّ، قد وسجتْ به","إِلى أهلِنا مَخزومة ٌ ، وهْوَ مُحقَبُ",18,"ب",1,0]]}