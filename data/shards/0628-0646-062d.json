{"poems":[[119,"رعى الله أطلالا بشهبائنا الغرا","https://www.aldiwan.net/poem41734.html","الطويل"],[369,"أسعداني في الحب ما تعلمان","https://www.aldiwan.net/poem60609.html","الخفيف"],[469,"بنحول خصرك والوشاح الجائل","https://www.aldiwan.net/poem3553.html","عموديه"],[520,"يا ظبية الرمل التي","https://www.aldiwan.net/poem12102.html","مجزوء الرجز"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101540","الكامل"],[1017,"","https://poetry.dctabudhabi.ae/diwan/poem/45205","الوافر"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66284","الرمل"],[2630,"","https://poetry.dctabudhabi.ae/diwan/poem/107319","الرجز"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136572",""],[5111,"لستُ أدرِي","https://www.poetsgate.com/ViewPoem.aspx?id=212384",""],[5422,"آخر عيل في ولادك","https://www.poetsgate.com/ViewPoem.aspx?id=174855",""]],"verses":[["بنحن قسمنا أيدوا السرفا كتفوا","بكسرة خبز عن رشيد وعن كسرى",0,"ر",2,0],["بنَحيلٍ يَظَلُّ ذا دَمْعةٍ سَو","داءَ تَجْري في أوجُهٍ غُرّان",1,"ن",1,0],["بنحول خصركِ والوشاح الجائل","كفّي سهامكِ قد أصبتِ مقاتلي",2,"ل",2,1],["بنحسها وشؤمها","مات الوزير جعفر",3,"ر",1,0],["بنحولهِ بذبولهِ بذهولهِ","فليلقَ بعد اليوم رحمةَ ربهِ",4,"ب",2,0],["بِنَحرِ الكَومِ إِذ سُحِبَت عَلَيهِ","ذُيولُ صِباً تُجاوِبُ بِالأَصيلِ",5,"ل",1,0],["بنحيل الجسم رفقاً إنه","من جناك خصرك المنحول ساما",6,"م",2,0],["بنَحوِ قَولِ واهبٍ وهبتُكا","ذا الشَيءَ أو أعمرتُ أو نحلتُكا",7,"ك",2,0],["بنحُولي بزفرتي بعَنائي","بشقائي بريقك الممنوع",8,"ع",1,0],["بَینَ َحُلْمٍ بَینَ وَھْمٍ","مُشْرَئِبٌّ فِي سَمَاھَا",9,"ا",2,0],["بنحبك طب ليه تجازينا","بالتوهه في بلاد الله",10,"ه",1,0]]}