{"poems":[[39,"به حاضر من غير جن يروعه","https://www.aldiwan.net/poem7471.html","الطويل"],[39,"به حاضر من غير جن تروعه","https://www.aldiwan.net/poem7510.html","الطويل"],[30,"ألا حي إذ أهلي وأهلك جيرة","https://www.aldiwan.net/poem5266.html","الطويل"],[30,"لم أر جارا لامرئ يستجيره","https://www.aldiwan.net/poem5313.html","الطويل"],[35,"لصفراء في قلبي من الحب شعبة","https://www.aldiwan.net/poem25819.html","الطويل"],[119,"من هجرك الامان","https://www.aldiwan.net/poem40439.html","عموديه"],[154,"تزودت من مدح النبي المؤيد","https://www.aldiwan.net/poem68589.html","الطويل"],[189,"ألا هل لدائي من فراقك إفراق","https://www.aldiwan.net/poem14607.html","الطويل"],[215,"أيعجب خاطري كيف التقينا","https://www.aldiwan.net/poem46220.html","الوافر"],[275,"أفيقي فردي بسمة وسلاما","https://www.aldiwan.net/poem35622.html","الطويل"],[287,"إليك المطايا أعنقت يا محمد","https://www.aldiwan.net/poem32811.html","الطويل"],[302,"إذا ما امتطيت الفلك مقتحم البحر","https://www.aldiwan.net/poem33276.html","الطويل"],[358,"سقى صبب الرضوان قبرا حوى التقى","https://www.aldiwan.net/poem40191.html","الطويل"],[409,"لقد صدرت إلى أعلى مقام","https://www.aldiwan.net/poem33449.html","الوافر"],[422,"سقى الله هذا القبر من صيب الحيا","https://www.aldiwan.net/poem53817.html","الطويل"],[469,"سقيت حياً جفني يا بانة الحمى","https://www.aldiwan.net/poem3501.html","عموديه"],[567,"مدامع جفن الصب إحدى الفواضح","https://www.aldiwan.net/poem52955.html","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63973","الهزج"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37733","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119880","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136359","المجتث"],[1281,"","https://poetry.dctabudhabi.ae/diwan/poem/77441","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79961","الطويل"],[2175,"","https://poetry.dctabudhabi.ae/diwan/poem/101272","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109367","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109418","البسيط"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100915","الطويل"],[2697,"","https://poetry.dctabudhabi.ae/diwan/poem/107165","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74169","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89364","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108335",""],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36731","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77176","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77089","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119618","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94435","الطويل"],[4613,"","https://poetry.dctabudhabi.ae/diwan/poem/101945","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139475",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139729",""],[4829,"وصيّة العلطبيس","https://www.poetsgate.com/ViewPoem.aspx?id=34264",""],[4935,"تدل بدلها تيها","https://www.poetsgate.com/ViewPoem.aspx?id=129500",""],[4935,"إلهي فرج الكربا","https://www.poetsgate.com/ViewPoem.aspx?id=129287",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5184,"صبرُ الزيتون","https://www.poetsgate.com/ViewPoem.aspx?id=189879",""],[5480,"زين التباريجه","https://www.poetsgate.com/ViewPoem.aspx?id=1592",""],[5765,"إرتعاش القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=212399",""],[5956,"لحل المشكلات","https://www.poetsgate.com/ViewPoem.aspx?id=194892",""],[6056,"فخ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=156699",""],[2220,"إذا جاءتِ الأسماء يقدمُها الله","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11859&r=&rc=728",""]],"verses":[["به حاضر من غيرِ جن يروعه","ولا حاضراه ذو أثاث وذو رحْلِ",0,"ل",1,1],["به حاضر من غير جن تروعه","ولا أنسٌ ذو ارونان وذو زجل",1,"ل",1,1],["بِهِ حَلَقٌ فيها مِنَ الجوعِ قاتِلٌ","وَمُعتَمَدٌ مِن ذِروَةِ العِزِّ أَقعَسُ",2,"س",1,0],["بِهِ حَطَمَ اللَهُ القُيودَ وَأومِنَت","مَخافَةُ نَفسٍ طومِنَت أَن تَفَزَّعا",3,"ع",2,0],["بِهِ حَلَّ بَيتَ الحَيِّ ثُمَّ اِنثَنى بِهِ","فَزالَت بُيوتُ الحَيِّ وَهوَ مُقيمُ",4,"م",1,0],["به حللت فارحم","هو الهوى هوان",5,"ن",1,0],["بِهِ حينَ لَم تُجدِ التَمائِمُ وَالرُقي","ظَأَرناهُمُ كُرهاً عَلى البِرِّ وَالتُقى",6,"ق",2,0],["به حِكَمٌ مستنبطاتٌ غَرائبٌ","لأَبْكارِها الغُرِّ الفَلاسفُ عُشّاق",7,"ق",1,0],["به حسناء لم تترك لقلبي","سوى اللوعات والدمع السخين",8,"ن",1,0],["به حفَّتِ الأملاكُ حياً وميِّتاً","على طول ما صلّى وعفَّ وصاما",9,"م",2,0],["بِهِ حَلَّ كُلُّ الجُودِ وَالمَجدِ وَالنَدى","وَفَضلٌ وَمَعروفٌ وَعِزٌّ وَسُؤدَدُ",10,"د",1,0],["به حازَت العَليا لؤيُّ بن غالبٍ","وَفازَ به سَهما كنانة وَالنَضرِ",11,"ر",1,0],["بِهِ حُسن بَحر المَكارم وَالعُلى","وَمَن دعي العطّار وَالذكر عاطرُ",12,"ر",1,0],["به حليت إذ حليت جيداً","لسنة أحمد بدر التمام",13,"م",1,0],["به حلَّ ذو علم وفهم وحكمة","وأمسى إلى الربّ الكريم ذهابُه",14,"ب",2,0],["بهِ حسنت عندي المنى وبقربهِ","حمدتُ زماناً كان قبلُ مذمَّماً",15,"م",2,0],["بهِ حسَدَتْ عينايَ أُذني ورُبَّما","تخصَّص بالإقبال بعضُ الجوارحِ",16,"ح",1,0],["به حُزْنا شماليلَ الت","مني وشماطيطَه",17,"ط",2,0],["بهِ حديثُ النّدى قد صحّ معضلُهُ","وحسَّنَتْهُ بنقْلٍ عنهُ أخْبارُ",18,"ر",1,0],["به حلت الأيام وهي مريرة","وأصبح جيد الدهر أجيد خاليا",19,"ي",2,0],["به حر قلبي برود","جد يا غنا المعدمين",20,"ن",1,0],["بِهِ حَيِيَت أَرضُ المَغارب وَاِزدَهت","وَأَضحَت لَهُم أَهلُ المَشارق حُسَّدا",21,"د",2,0],["به حفظ الباري شريعة جدِّه","وشيَّد من أركانها كلَ منهَّد",22,"د",1,0],["به حادثات الدهر ماتت وانها","لقارعة كبرى على اليوم والغد",23,"د",1,0],["به حسدت بيروت كل مدينةٍ","سوى بلدة حازت من الخلق اعظما",24,"م",2,0],["به حديث التهاني كاسمه حسنٌ","وسعد طالعه قد أبهج الزمنا",25,"ن",2,0],["بهِ حُجَلَ شُعرٌ كأنًّ أديمَها","بقيةُ هَدىٍ فى عقيدةِ مُلحِد",26,"د",1,0],["بهِ حَرَسَ اللَّه الجَزِيرَةَ فاغتَدَت","أَعَزَّ عَلَى الأَعداءِ نَيلاً وَأَبعدا",27,"د",2,0],["بِه حمير عزت وَطالَ مَنارها","فَطائرها يَوم الفخار صدوح",28,"ح",1,0],["به حسنُ الأوصاف وافى محبه","ونعم الوكيل الحازم الرأي ذو الزكن",29,"ن",1,0],["به حصر الفضل الجزيل وانما","يقصر من يهوى لذا الفضل حصرهُ",30,"ر",2,0],["بِهِ حِلٌّ مِن أَهلِ الغَرامِ عِصابَةٌ","حَديثُهُم كَالراحِ بَينَ الرياحينِ",31,"ن",1,0],["بِهِ حُسنَ الأَخلاقِ قَد نالَ رِفعَة","وَعِزّاً وَنُعمى دونَها الضِد يَنكُس",32,"س",1,0],["بِهِ حَظَيتَ أَم الرِضاع حَليمَة","فَأَخصَب مَرعاها خُصوصاً وَلَم يَعُد",33,"د",1,0],["به حوزة الزوراء تم أمانها","ولولاه كانت لا تزال تُكدَّرُ",34,"ر",1,0],["بهِ حسن تركيبٍ يروق إلى النهى","ويسكرها من حيث لا تدخل الخمرُ",35,"ر",1,0],["به حظيت أرض الشآم فأسبلت","سحائبه فيها ملثا وريقا",36,"ق",2,0],["به حمد الإله يفوح مسكاً","وتعبق فيه غالية الثناء",37,"ا",2,0],["به حبست عنّا الليالي صفاءها","ببيتٍ على أبوابه ضربت قفلا",38,"ل",2,0],["به حربصيص غالي انفيس وعلطبيس وماسيه","فلا يقدر على حمل الصناديق الف هداجي",39,"ج",2,0],["به حلواننا عزت","بحاضراها وباديها",40,"ي",3,0],["به حجر الهدى ثبتت","دعائمه وما انثلبا",41,"ب",2,0],["به حبه حي فواها لما ثوى","هنالك واهاً ثم واهاً له ثما",42,"م",2,0],["بهِ حُزْنُ طوفانٍ تأخَّرَ وعْدُهُ","ولمّا ﭐبْتنى فُلْكاً أعاقوا بهِ الصُّنعا",43,"ع",2,0],["به حلا به زين مخفنه","يذهل اعباده ومخاليجه",44,"ج",2,0],["به..، حين البلادُ تمرّ ذكرى","بأغنيةٍ على شبّاك منفى !",45,"ف",2,0],["به حرية الإنْسانِ تمضي","بفعلِ الخيرِ لا فعل الشرورِ",46,"ر",1,0],["به حلا ً لو بغيت أشرع ، بتعديده","ما هقيت ،، إنها توفيه الأعدادي",47,"د",2,0],["بهِ حاكمُ اللهِ والأكبرِ اللهُ","وما عزَّ منْ يفنيهِ برهانُ فكرهِ",48,"ه",1,0]]}