{"poems":[[68,"روني من سلافة الصهباء","https://www.aldiwan.net/poem39083.html","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43748","الخفيف"],[92,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[415,"مثل منهل أنعم الملك الصالح","https://www.aldiwan.net/poem32212.html","الخفيف"],[563,"رؤية الحق رؤية الأغيار","https://www.aldiwan.net/poem33550.html","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117929","الرمل"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89603","الرمل"],[5002,"حقّ الحبِّ...","https://www.poetsgate.com/ViewPoem.aspx?id=202378",""],[5508,"وقفنا على حكم الهوى نعلن الشكوى","https://www.poetsgate.com/ViewPoem.aspx?id=110819",""]],"verses":[["رَوِّني مِن سُلافَةِ الصَهباءِ","فَهيَ تَروي مِن سائِرِ الأَدواءِ",0,"ا",2,1],["روّني بِالرَحيقِ يُختَمُ في جَن","ناتِ عَدنٍ وَمسكهُنَّ الخِتامُ",1,"م",1,0],["رونقٌ في الثَّرى وعلى الروضةِ","لطفٌ من السَّما مسكوبُ",2,"ب",1,1],["رونقُ الصّدقِ فِيهِ بادٍ وما زَا","لَ إلى الصّدقِ كلُّ سمعٍ يتُوقُ",3,"ق",1,0],["رونق الكشف ظاهر منه لكن","ستر عاداتهم على العبد جاري",4,"ر",2,0],["رونق الجسم بها منتعش","ولها في اللب سحر مستمر",5,"ر",1,0],["رَونَقُ الرَدى الغَوادي","وَالرَوائِحُ في طَرِيِّهِ",6,"ي",2,0],["رونق الأوهام لفيه ضلالٌ","وظلالي وريفُها قسمةُ ربْ",7,"ب",1,0],["رونقٌ كالحبابِ يعلو على الكأ","س ولكن تحتَ الحبابِ الحُبابُ",8,"ب",1,0]]}