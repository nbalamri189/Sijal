n.net/poem45755.html","الخفيف"],[376,"نحن يوما وصل ويوما فراق","https://www.aldiwan.net/poem57277.html","الخفيف"],[406,"تشكو الفتاوى","https://www.aldiwan.net/poem6741.html","عموديه"],[463,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[504,"هل بان قلبك من سليمى فاشتفى","https://www.aldiwan.net/poem538.html",""],[505,"ها أين يا ريح الصبا","https://www.aldiwan.net/poem38086.html","مجزوء الرجز"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138266",""],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83282","الكامل"],[619,"","https://poetry.dctabudhabi.ae/diwan/poem/203371","زجل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77585","الرجز"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96733","الكامل"],[1269,"","https://poetry.dctabudhabi.ae/diwan/poem/122912","الخفيف"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109234","الكامل"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202133","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53073","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27254","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88637","الخفيف"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60822","الخفيف"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100917","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100345","الخفيف"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101614","الخفيف"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67975","الكامل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/132018","الكامل"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29273","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111450","الخفيف"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44910","الكامل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101378","الكامل"],[4767,"تقريع","https://www.poetsgate.com/ViewPoem.aspx?id=178421",""],[5356,"يتخالسان الحبَّ","https://www.poetsgate.com/ViewPoem.aspx?id=212098",""],[6031,"هَتَفَتْ بِدَمْعِ العَينِ وَهْي سَجُومُ","https://www.poetsgate.com/ViewPoem.aspx?id=46292",""],[6068,"وسائح في فيافي الدوّ تحسبه -05-","https://www.poetsgate.com/ViewPoem.aspx?id=175817",""],[6102,"خلخال","https://www.poetsgate.com/ViewPoem.aspx?id=182738",""],[6207,"رمضان أقبل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78949&r=&rc=5",""],[6228,"باع الثمين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85974&r=&rc=11",""],[463,"سلْ بسلعٍ شجنا كان وكنّا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60268&r=&rc=324",""],[4701,"بلاغة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87361&r=&rc=1",""]],"verses":[["يتخذ الحَلْيَ كالنميمة لا ال","زينة من حسنه الذي جَهره",0,"ر",2,0],["يتخطَّى العِداتِ عمداً إلى البذْ","ل كَسَحِّ الحيا بلا إيماض",1,"ض",1,0],["يتخذ المال حين يملكه","واقية كالدروع والدرق",2,"ق",1,0],["يَتّخِذُ الشِّعْرَى شِعاراً لَهُ","كأَنّما الأُفْقُ لَهُ مَنْزِلُ",3,"ل",1,0],["يَتَخَلّى السالي عَنِ الحُبِّ بِالشُغ","لِ وَيَغلو بِصاحِبِ الوَجدِ وَجدُه",4,"د",2,0],["يَتَخَطّى فيها رِقابَ المَنايا","غَيرَ ما ناكِلٍ وَلا مَزؤودِ",5,"د",1,0],["يَتَخَطّى بِكَ المَهامَةِ وَالبي","دِ دَليلٌ أَعمى كَثيرُ الرُقادِ",6,"د",1,0],["يَتَخَطّى الرَدى فَيَملَأُ صَدرَ السَي","فِ مِن جانِبِ الخَميسِ الكَثيفِ",7,"ف",1,0],["يَتَخَرَّقُ المَعروفُ يَومَ عَطائِهِ","عَن جودِ مُنخَرِقِ اليَدَينِ حُلاحِلِ",8,"ل",1,0],["يَتَخيّرُ الأخلاقَ يَنظمُ حُسْنَها","في كلِّ رُكنٍ قائمٍ ويُنَسِّقُ",9,"ق",1,0],["يَتَخَيَّرونَ عَلى المَليكِ قَضاءَهُ","سَفِهَ الغُواةُ وَلَيسَ فيهِم خَيِّرُ",10,"ر",1,0],["يتخطَّى بنا الفضا","ءَ على السُّنْدسِ النَّضِرْ",11,"ر",1,0],["يَتَخَطَّى الْحَيَاةَ وَالإِنْسَ فِيهَا","مُوحَشاً مُنْذُ كَانَ لَدْنَ الْعُودِ",12,"د",1,0],["يتخذ الحَلْيَ كالتميمة لا ال","زينة من حسنه الذي جَهره",13,"ر",2,0],["يَتَخَلَّص الْمَرْمَى المَدِيدُ","بِهَا إِلَى مَرْمَى مَدِيدِ",14,"د",1,0],["يَتَخَلّى السّالي مِنَ الحُبّ بالشّغْ","لِ، وَيَغلو بصَاحبِ الوَجدِ وَجدُهْ",15,"د",2,0],["يتخطى فيها رقاب المنايا","غير ما ناكل ولا مزءود",16,"د",1,0],["يتخطَّى العِداتِ عمداً إلى البدْ","ل كَسَحّ الحيا بلا إيماض",17,"ض",1,0],["يتخافتُون كأنهم","يتسابقُون إلى الصدَرْ",18,"ر",1,0],["يَتَخَيَّلُ البَطَلُ الكَمِيُّ إِذا رَأى","إِقدامَ جَيشِكَ أَنَّهُ ما يَشجُعُ",19,"ع",1,0],["يَتَخَطَّى إِلى طَرِيقِ المَعالي","بِمَعالٍ خَطِيرَةِ الأَخْطارِ",20,"ر",1,0],["يتخطى الصعاب غير مبال","بزفير الآلات والنيران",21,"ن",1,0],["يتخطفُ الأرواحَ والأجسادَ أنْ","عرضتْ لهُ الأرواحُ والأجسادُ",22,"د",1,0],["يَتَخَطّى إِلى الأَمامِ قَليلاً","ثُمَّ يَعدو بِسُرعَةٍ لِلوَراء",23,"ا",2,0],["يتخطى الرءوس رأساً فرأسا","ماشياً في العُصورِ عهداً فعهدا",24,"د",2,0],["يَتَخَفَّى بِفعلِهِ عِندَما يَظ","هَرُ في الناسِ فِعلُهُ المِخراقُ",25,"ق",1,0],["يتخّطفون القول من فم سائلٍ","متجاهلين من الأمور مآلها",26,"ل",3,0],["يتخايل النيروزُ إن جُعلتْ","حَلْياً على أعضائه العُطْلِ",27,"ل",1,0],["يَتَخالَسونَ نُفوسَهُم بِنَوافِذٍ","فَكَأَنَّما عَضَّ الكُماةُ عَلى الحَصى",28,"ا",1,0],["يتَّخِذُ النَّوْحَ إلى","تلكَ النَّواحي سَبَبَا",29,"ب",2,0],["يتخاصر الفتيان والفتيات في","نمط إلى نهج الغرام يقود",30,"د",1,0],["يَتَخَيَّلُ الإِنسانُ أَبعَدَ مَطمَعِ","وَالَوتُ مِنهُ مِثلَ حَبلٍ وَريدِ",31,"د",1,0],["يتخاطرد أعن نشق","في وصالو أو نيف",32,"ف",1,0],["يَتخِذون الجنَّ للخَدامه","وَيَشرَبون مِنهُم المدامه",33,"ه",1,0],["يتخطّف الألبابَ بالسحرِ الّذي","يوليهِ من لحظاته إنسانهُ",34,"ن",2,0],["يتخطى اليه دو","ني في حالك الدجن",35,"ن",1,0],["يتخبطون الدهر في ظلماتهم","إن لم يقد أهل النهى خطواتهم",36,"م",1,0],["يتخطّى إلى ذراها بعزم","بعض عقباه للسماء ارتقاء",37,"ا",2,0],["يتخيلون الرعد خفق بنودكم","والسحب نقعاً والوميض مهنّدا",38,"د",2,0],["يتخيلُ المسكينُ أنّ علومها","ما بين أوراقِ الكتابِ تُسَطر",39,"ر",1,0],["يتخطى مشي النَزيف اذا ما","ميلت رأسه ابنة العنقود",40,"د",1,0],["يتخفّى بها فتظهر كالمسك","نما عطِرهُ على عَطَارِه",41,"ر",2,0],["يتخير الأكفاءَ من أصلابكم","كم فى الغمودِ اذا طُلبنَ حُسام",42,"م",1,0],["يتخطَّى الحمام صفّ الذنابي","عاثراً صرفه بشم الانوفِ",43,"ف",1,0],["يتخطى هذي وتلك من الورد","فيا طول لوعتي في انتظاره",44,"ر",2,0],["يَتخبَّطون بجهلهم","مثلَ الفَراشِ عَلَى الشُّهب",45,"ب",1,0],["يتخطيان طريق يثرب في الدجى","وعداة دين الله عنهما أحجموا",46,"م",3,0],["يَتَخَطّى عَصفَ الأَعاصيرِ وَثباً","لا يُبالي بِهَولِ هذا الفَناءِ",47,"ا",2,0],["يَتَخَلَّى الرَّاعي سَحِيقَ الفُؤَادِ","وَلَمأوَاهُ يَلتَجِي بِأرتِعادِ",48,"د",1,0],["يَتَخيَّلُ الدُنيا لَهُ وَزراً","إِن ضاقَ بِالمُتَوكِّلِ الوَزرُ",49,"ر",1,0],["يتخالف الإنسان في أخلاقه","إما اغتدى متوافق الأشكال",50,"ل",1,0],["يتخذ الليل خليلاً له","يسعفه في الذكر أو في الدعاء",51,"ا",2,0],["يتخالسان الحبَّ في المأوى","حَجْرُ الهوى سقمٌ لمن يهوى",52,"و",2,1],["يتخبّطُ الأحياءَ حتى لم يكدْ","لَيسيمُ خشيتَهُ السوامَ مُسِيمُ",53,"م",1,0],["يتّخذ الطود حصنا لا يراوحه","يمنعه القرنً عند القصد والصول",54,"ل",1,0],["يَتَخَطَّى حَواجِزَ السَّمعِ لَحنًا","فَائِقَ السِّحرِ مِن دَمِي يَتَضَرَّجْ",55,"ج",1,0],["يتخطفون ولا بصير ينير في","قدد الطرائق لاحبا وضاحا",56,"ح",2,0],["يتخافتون وما دروا","أن الزمان له أذنْ",57,"ن",1,0],["يتخفَّفنَ به يعطينه","دعوة َ الإعظامِ من هنَّا وهنَّا",58,"ن",2,0],["يتخيَّرون حروفَهم لزمانِهم","أما أنا تختارني كلماتي!!",59,"ت",2,0]]}