{"poems":[[11,"صحا القلب من سلمى وعن أم عامر","https://www.aldiwan.net/poem246.html",""],[47,"ألم تر تغليس الربيع المبكر","https://www.aldiwan.net/poem63604.html","الطويل"],[50,"غدوت على اللذات منهتك الستر","https://www.aldiwan.net/poem63280.html","الطويل"],[48,"بقيت وما أدري بما هو غائب","https://www.aldiwan.net/poem22079.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85593","الخفيف"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62279","البسيط"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16633","الوافر"],[11,"","https://poetry.dctabudhabi.ae/diwan/poem/10375","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54227","الطويل"],[233,"خذها ألذ من التجميش والقبل","https://www.aldiwan.net/poem50873.html","البسيط"],[233,"يعد وجيع الوجد ما هيج البعد","https://www.aldiwan.net/poem51175.html","الطويل"],[241,"لي الله قلبي كم يذوب من الذكرى","https://www.aldiwan.net/poem18191.html","الطويل"],[265,"أراحمة قلبي وقد شفني الصبر","https://www.aldiwan.net/poem38281.html","الطويل"],[309,"لصادق رعيه القصر السعيد","https://www.aldiwan.net/poem56577.html","الوافر"],[357,"مطالع سعد قد تجلت كواكبه","https://www.aldiwan.net/poem40814.html","الطويل"],[368,"نمت بأسرار ليل كان يخفيها","https://www.aldiwan.net/poem60595.html","البسيط"],[370,"أسكان قلبي كيف جاورتم الأسى","https://www.aldiwan.net/poem17085.html","الطويل"],[381,"خليلي مرا بي على ربع ناسك","https://www.aldiwan.net/poem59305.html","الطويل"],[420,"بوادي الغضا للمالكية أربع","https://www.aldiwan.net/poem54180.html","الطويل"],[456,"وفائي للصديق أبي علي","https://www.aldiwan.net/poem61305.html","الوافر"],[461,"مشين لنا بين ميل وهيف","https://www.aldiwan.net/poem56114.html","المتقارب"],[464,"تناط أيادي الله منه وعنده","https://www.aldiwan.net/poem15663.html","الطويل"],[464,"أسيف سل أم ذرب نطوق","https://www.aldiwan.net/poem16020.html","الوافر"],[517,"ينم عليه الدمع وهو جحود","https://www.aldiwan.net/poem20831.html","الطويل"],[828,"","https://poetry.dctabudhabi.ae/diwan/poem/10453","الطويل"]],"verses":[["كَأَنَّ ضُلوعَ الجَنبِ في فَوَرانِه","إِذا اِستَحمَشَت أَيدي نِساءٍ حَواسِرِ",0,"ر",1,0],["كَأَنَّ ضَجيجَ البَحرِ بَينَ رِماحِهِم","إِذا اِختَلَفَت تَرجيعُ عَودٍ مُجَرجِرِ",1,"ر",1,0],["كَأَنَّ ضِياءَ الشَمسِ نيطَ بِوَجهِهِ","وَبَدرُ الدُجى بَينَ التَرائِبِ وَالنَحرِ",2,"ر",1,0],["كَأَنَّ ضِياءَ الفَجرِ سَيفٌ يَسُلُّهُ","عَلَيهُم صَباحٌ بِالمَنايا مُذَرَّبُ",3,"ب",1,0],["كانَ ضغط الدجى عليه شديداً","فأتى الصبح مؤذناً بانفلاق",4,"ق",1,0],["كَأَنَّ ضَحْكَتَها يَوْماً إِذَا ابْتَسَمَتْ","بَرْقٌ سَحَائِبُهُ غُرٌّ زَهَالِيلُ",5,"ل",1,0],["كأن ضيوفهم والنار تذكى","لهم بتوقد الشعرى صلي",6,"ي",1,0],["كَأَنَّ ضُلوعَ الجَنبِ في فَوَرانِها","إِذا اِستَحمَشَت أَيدي نِساءٍ حَواسِرِ",7,"ر",1,0],["كأَنَ ضِيَاءَ الصُّبْحِ والكَوْنُ مُشْرِقٌ","سَنَا طَلْعَةِ الفَارُوقِ لاحَتْ رَكائِبُه",8,"ب",2,0],["كأن ضجّة صوتِ الطبلِ بينهما","ضجِيجُ عِزّ أبِي المنصورِ في الدولِ",9,"ل",1,0],["كأنّ ضياء الشمس ردّاه نورَه","وأهدى إليه قلبه الأسَدُ الوَرد",10,"د",1,0],["كَأَنَّ ضِيَاءَ الْبَدْرِ وَالشُّهْبِ حَوْلَهُ","سَنَا شَيْخِنَا ابْنِ الَْحَاجِ فِي حَلْقَةِ الإِقْرَا",11,"ر",2,0],["كأن ضياء المشتري غرة جلا","محاسنها فرع وجال بها البشر",12,"ر",1,0],["كأنّ ضرائراً في الأرضِ سيقت","من اِبناءِ السماء لها نقودُ",13,"د",1,0],["كَأَنّ ضِياء الفَجر حبٌّ محجّبٌ","كَأَنّ ظَلام اللَيل واشٍ يُراقبُه",14,"ب",2,0],["كأنّ ضَوْءَ هلالٍ لاحَ فابْتدَرَتْ","زُهْرُ النُجوم تَبدَّى مِن نَواحيها",15,"ي",3,0],["كَأَنَّ ضُلوعي وَالزَفيرَ وَأَدمُعي","طُلولٌ وَريحٌ عاصِفٌ وَسُيولُ",16,"ل",1,0],["كأن ضيا تلك المناسك في الورى","سنا البدرِ في ليلٍ من الإثم حالك",17,"ك",1,0],["كأَنَّ ضياء الشمس فوقَ جبينه","على وجهه النور الإِلهي يسطعُ",18,"ع",1,0],["كأن ضياءها وشذى حلاها","وقد مزجا تفنن جوهري",19,"ي",1,0],["كأن ضريحك زهرُ الربي","ع هبَّت عليه نسيمُ الخريفِ",20,"ف",1,0],["كأنَّ ضجيجَ القاربين بأرضِهِ","وناديهِ في آصالهِ والبَواكرِ",21,"ر",1,0],["كأنَّ ضيوفَ فخر الدينِ وُلْدٌ","يَضمُّهُمُ أبٌ بَرٌّ شَفيقُ",22,"ق",1,0],["كأنّ ضِياها للعِبادِ طوالِعٌ","ففيها شقيٌّ منهمُ وسعيدُ",23,"د",1,0],["كَأَنَّ ضَئِيَّي رَأسِهِ شَجرُ واسِطٍ","تَفاقَمَ حَتّى لاحَكَتهُ مَسامِرُه",24,"ر",2,0]]}