ن اسعدي","https://www.poetsgate.com/ViewPoem.aspx?id=213441",""],[6069,"سرى موهناً واستكتمته المهالك","https://www.poetsgate.com/ViewPoem.aspx?id=105697",""],[6093,"إِذَا ظَهَرَ المَشْيْبُ بِوَجْهِ حَيٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=180714",""],[6143,"مناجاة","https://www.poetsgate.com/ViewPoem.aspx?id=34307",""],[6175,"عبيدكَ ليسوا حَجَرْ!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72850&r=&rc=75",""]],"verses":[["كَأَنَّ ضُلوعَ الجَنبِ في فَوَرانِه","إِذا اِستَحمَشَت أَيدي نِساءٍ حَواسِرِ",0,"ر",1,0],["كَأَنَّ ضَجيجَ البَحرِ بَينَ رِماحِهِم","إِذا اِختَلَفَت تَرجيعُ عَودٍ مُجَرجِرِ",1,"ر",1,0],["كَأَنَّ ضِياءَ الشَمسِ نيطَ بِوَجهِهِ","وَبَدرُ الدُجى بَينَ التَرائِبِ وَالنَحرِ",2,"ر",1,0],["كَأَنَّ ضِياءَ الفَجرِ سَيفٌ يَسُلُّهُ","عَلَيهُم صَباحٌ بِالمَنايا مُذَرَّبُ",3,"ب",1,0],["كانَ ضغط الدجى عليه شديداً","فأتى الصبح مؤذناً بانفلاق",4,"ق",1,0],["كَأَنَّ ضَحْكَتَها يَوْماً إِذَا ابْتَسَمَتْ","بَرْقٌ سَحَائِبُهُ غُرٌّ زَهَالِيلُ",5,"ل",1,0],["كأن ضيوفهم والنار تذكى","لهم بتوقد الشعرى صلي",6,"ي",1,0],["كَأَنَّ ضُلوعَ الجَنبِ في فَوَرانِها","إِذا اِستَحمَشَت أَيدي نِساءٍ حَواسِرِ",7,"ر",1,0],["كأَنَ ضِيَاءَ الصُّبْحِ والكَوْنُ مُشْرِقٌ","سَنَا طَلْعَةِ الفَارُوقِ لاحَتْ رَكائِبُه",8,"ب",2,0],["كأن ضجّة صوتِ الطبلِ بينهما","ضجِيجُ عِزّ أبِي المنصورِ في الدولِ",9,"ل",1,0],["كأنّ ضياء الشمس ردّاه نورَه","وأهدى إليه قلبه الأسَدُ الوَرد",10,"د",1,0],["كَأَنَّ ضِيَاءَ الْبَدْرِ وَالشُّهْبِ حَوْلَهُ","سَنَا شَيْخِنَا ابْنِ الَْحَاجِ فِي حَلْقَةِ الإِقْرَا",11,"ر",2,0],["كأن ضياء المشتري غرة جلا","محاسنها فرع وجال بها البشر",12,"ر",1,0],["كأنّ ضرائراً في الأرضِ سيقت","من اِبناءِ السماء لها نقودُ",13,"د",1,0],["كَأَنّ ضِياء الفَجر حبٌّ محجّبٌ","كَأَنّ ظَلام اللَيل واشٍ يُراقبُه",14,"ب",2,0],["كأنّ ضَوْءَ هلالٍ لاحَ فابْتدَرَتْ","زُهْرُ النُجوم تَبدَّى مِن نَواحيها",15,"ي",3,0],["كَأَنَّ ضُلوعي وَالزَفيرَ وَأَدمُعي","طُلولٌ وَريحٌ عاصِفٌ وَسُيولُ",16,"ل",1,0],["كأن ضيا تلك المناسك في الورى","سنا البدرِ في ليلٍ من الإثم حالك",17,"ك",1,0],["كأَنَّ ضياء الشمس فوقَ جبينه","على وجهه النور الإِلهي يسطعُ",18,"ع",1,0],["كأن ضياءها وشذى حلاها","وقد مزجا تفنن جوهري",19,"ي",1,0],["كأن ضريحك زهرُ الربي","ع هبَّت عليه نسيمُ الخريفِ",20,"ف",1,0],["كأنَّ ضجيجَ القاربين بأرضِهِ","وناديهِ في آصالهِ والبَواكرِ",21,"ر",1,0],["كأنَّ ضيوفَ فخر الدينِ وُلْدٌ","يَضمُّهُمُ أبٌ بَرٌّ شَفيقُ",22,"ق",1,0],["كأنّ ضِياها للعِبادِ طوالِعٌ","ففيها شقيٌّ منهمُ وسعيدُ",23,"د",1,0],["كأن ضياء الصبح قد حال لونه","أو الليل قد أرخى على الصبح برقعا",24,"ع",2,0],["كأنَّ ضلوعهُ ممّا تعرّت","قِسىِّ وُترت يومَ الجلادِ",25,"د",1,0],["كأنَّ ضرامَ النارِ يلفحُ رَكْبَهُ","إذا احترَّ من وقدِ الهجير شواهقه",26,"ق",2,0],["كَأنَّ ضِياءَ الشّمسِ نُورُ جَبينها","وَجَبهَتها الغَرّا تَلوحُ كَأَنجُمِ",27,"م",1,0],["كأن ضياء انجمه علينا","أيادي الشهم عثمان الجواد",28,"د",1,0],["كَأنَّ ضِيَاءَ الْبَدْرِ في غَسَقِ الدجَى","بَيَاضُ العَطَايَا فِي سَوَادِ المَطَالِبِ",29,"ب",1,0],["كأنَّ ضياء غرّتها","لَنا في الليلِ قنديلُ",30,"ل",1,0],["كأنَّ ضَجيجَ مُعولِها","بَنو الملاحِ في النَّادِي",31,"د",2,0],["كَأَنَّ ضِيَاءَ الصُّبْحِ وَالشَّمْسَ بَعْدَهُ","هِدَايَةُ خَيْرِ الخَلْقِ مِنْ آلِ عَدْنَانِ",32,"ن",1,0],["كأن ضياء فكرك في دجاها","ضياء الصبح والليل البهيم",33,"م",1,0],["كأن ضياء الكهربى في سمائها","سنا الشمس وهاجاً بغير أفول",34,"ل",1,0],["كَأَنَّ ضَئِيَّي رَأسِهِ شَجرُ واسِطٍ","تَفاقَمَ حَتّى لاحَكَتهُ مَسامِرُه",35,"ر",2,0],["كأن ضياء البدر من ضوء وجهها","له لمعان في الورى وبروق",36,"ق",1,0],["كان ضياءً لناظريها","فأطفأته يد الدبور",37,"ر",1,0],["كان ضلوعه ترمي جمارا","على هضاب قلب قد تراما",38,"م",2,0],["كان ضم وعناق","فتلاشينا وغبنا",39,"ن",2,0],["كأنّ ضياءَ الفجرِ سيفٌ مُشهَّرٌ","مَتى ادّرَع الليلُ البَهيمُ يَقُدُّهُ",40,"د",2,0],["كأن ضئيلة لسعت فؤادي","فحم بسمها الجسد الجليد",41,"د",1,0],["كانَّ ضُبَاتِ المشرَفيَّة من كرى","فَما يَبتَغي إلا مَقرَّ المَحاجِر",42,"ر",1,0],["كأن ضياء الصبح في الليل إذ سرى","بصيرة إيمان سرت في عمى كفر",43,"ر",1,0],["كان ضيفا لديهم فقروه","لا سقاهم حيا بعطن دراك",44,"ك",1,0],["كَأَنَّ ضَوءَ الصُبحِ شُهبُ غَارَةٍ","تَقَاذَفَ الحُضرُ بِهِنَّ وارتَمى",45,"ا",1,0],["كأَنَّ ضياء الشَّمس وَجْهُ إمامِنا","إذا ازداد بشراً في الوغى وإذا أعطى",46,"ط",2,0],["كانَ ضوءُ الصُبح مَوعِده","وَمَضى لَيتَ الدُجى أَبدُ",47,"د",1,0],["كأن ضوء البدر في","دجلة حين يشرق",48,"ق",1,1],["كَأَنّ ضَميرَهمْ في قَعْرِ جُبٍّ","أمام صُموتِهم قَدْ بُحَّ صَيْحُ",49,"ح",1,0],["كان ضاع النور بعيون الظلام","الزمن ما خلّد العمر الضرير",50,"ر",1,0],["كَانَ ضَيفِيْ طَائِفاً بِيْ شُرُوقَاً","فَإِذَا اللَّيلُ غَشَاْهُ رَزِيَّا",51,"ي",2,0],["كَأَنَّ ضِيَاءَهُ الْمَنْثُورَ رُوحٌ","تُلَألِئُ شُرْفَةَ الْوَجْدِ الحَقِيقِي",52,"ق",2,0],["كأنَّ ضفائرك الظامئات","بقايا صباحٍ ونورٍ ونارْ",53,"ر",1,0],["كأن ضمير الدهر جاء به لكي","يكفر عن ذنب جنى قبله عمدا",54,"د",2,0],["كأن ضنى أحداقها وخصورها","تقاسمه عشاقها والبواتك",55,"ك",1,0],["كَأَنَّ ضِيَاءَهُ ضُوءٌ لِفَجْرٍ","لِيُوْقِظَ نَائِمَاً قَدْ غَرَّ عَنْه",56,"ن",2,0],["كان ضرباً من عذابٍ","كي أنادي أنجديني",57,"ن",2,0],["كأنْ ضوءُ كلِّ الشموس","على كتِفَيها انحدَرْ",58,"ر",1,0]]}