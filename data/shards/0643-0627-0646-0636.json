{"poems":[[11,"صحا القلب من سلمى وعن أم عامر","https://www.aldiwan.net/poem246.html",""],[45,"ألم تر تغليس الربيع المبكر","https://www.aldiwan.net/poem63604.html","الطويل"],[48,"غدوت على اللذات منهتك الستر","https://www.aldiwan.net/poem63280.html","الطويل"],[46,"بقيت وما أدري بما هو غائب","https://www.aldiwan.net/poem22079.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85593","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16633","الوافر"],[11,"","https://poetry.dctabudhabi.ae/diwan/poem/10375","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54227","الطويل"],[227,"خذها ألذ من التجميش والقبل","https://www.aldiwan.net/poem50873.html","البسيط"],[227,"يعد وجيع الوجد ما هيج البعد","https://www.aldiwan.net/poem51175.html","الطويل"],[235,"لي الله قلبي كم يذوب من الذكرى","https://www.aldiwan.net/poem18191.html","الطويل"],[259,"أراحمة قلبي وقد شفني الصبر","https://www.aldiwan.net/poem38281.html","الطويل"],[303,"لصادق رعيه القصر السعيد","https://www.aldiwan.net/poem56577.html","الوافر"],[351,"مطالع سعد قد تجلت كواكبه","https://www.aldiwan.net/poem40814.html","الطويل"],[362,"نمت بأسرار ليل كان يخفيها","https://www.aldiwan.net/poem60595.html","البسيط"],[364,"أسكان قلبي كيف جاورتم الأسى","https://www.aldiwan.net/poem17085.html","الطويل"],[374,"خليلي مرا بي على ربع ناسك","https://www.aldiwan.net/poem59305.html","الطويل"],[413,"بوادي الغضا للمالكية أربع","https://www.aldiwan.net/poem54180.html","الطويل"],[451,"وفائي للصديق أبي علي","https://www.aldiwan.net/poem61305.html","الوافر"],[456,"مشين لنا بين ميل وهيف","https://www.aldiwan.net/poem56114.html","المتقارب"],[459,"تناط أيادي الله منه وعنده","https://www.aldiwan.net/poem15663.html","الطويل"],[459,"أسيف سل أم ذرب نطوق","https://www.aldiwan.net/poem16020.html","الوافر"],[512,"ينم عليه الدمع وهو جحود","https://www.aldiwan.net/poem20831.html","الطويل"]],"verses":[["كَأَنَّ ضُلوعَ الجَنبِ في فَوَرانِه","إِذا اِستَحمَشَت أَيدي نِساءٍ حَواسِرِ",0,"ر",1,0],["كَأَنَّ ضَجيجَ البَحرِ بَينَ رِماحِهِم","إِذا اِختَلَفَت تَرجيعُ عَودٍ مُجَرجِرِ",1,"ر",1,0],["كَأَنَّ ضِياءَ الشَمسِ نيطَ بِوَجهِهِ","وَبَدرُ الدُجى بَينَ التَرائِبِ وَالنَحرِ",2,"ر",1,0],["كَأَنَّ ضِياءَ الفَجرِ سَيفٌ يَسُلُّهُ","عَلَيهُم صَباحٌ بِالمَنايا مُذَرَّبُ",3,"ب",1,0],["كانَ ضغط الدجى عليه شديداً","فأتى الصبح مؤذناً بانفلاق",4,"ق",1,0],["كأن ضيوفهم والنار تذكى","لهم بتوقد الشعرى صلي",5,"ي",1,0],["كَأَنَّ ضُلوعَ الجَنبِ في فَوَرانِها","إِذا اِستَحمَشَت أَيدي نِساءٍ حَواسِرِ",6,"ر",1,0],["كأَنَ ضِيَاءَ الصُّبْحِ والكَوْنُ مُشْرِقٌ","سَنَا طَلْعَةِ الفَارُوقِ لاحَتْ رَكائِبُه",7,"ب",2,0],["كأن ضجّة صوتِ الطبلِ بينهما","ضجِيجُ عِزّ أبِي المنصورِ في الدولِ",8,"ل",1,0],["كأنّ ضياء الشمس ردّاه نورَه","وأهدى إليه قلبه الأسَدُ الوَرد",9,"د",1,0],["كَأَنَّ ضِيَاءَ الْبَدْرِ وَالشُّهْبِ حَوْلَهُ","سَنَا شَيْخِنَا ابْنِ الَْحَاجِ فِي حَلْقَةِ الإِقْرَا",10,"ر",2,0],["كأن ضياء المشتري غرة جلا","محاسنها فرع وجال بها البشر",11,"ر",1,0],["كأنّ ضرائراً في الأرضِ سيقت","من اِبناءِ السماء لها نقودُ",12,"د",1,0],["كَأَنّ ضِياء الفَجر حبٌّ محجّبٌ","كَأَنّ ظَلام اللَيل واشٍ يُراقبُه",13,"ب",2,0],["كأنّ ضَوْءَ هلالٍ لاحَ فابْتدَرَتْ","زُهْرُ النُجوم تَبدَّى مِن نَواحيها",14,"ي",3,0],["كَأَنَّ ضُلوعي وَالزَفيرَ وَأَدمُعي","طُلولٌ وَريحٌ عاصِفٌ وَسُيولُ",15,"ل",1,0],["كأن ضيا تلك المناسك في الورى","سنا البدرِ في ليلٍ من الإثم حالك",16,"ك",1,0],["كأَنَّ ضياء الشمس فوقَ جبينه","على وجهه النور الإِلهي يسطعُ",17,"ع",1,0],["كأن ضياءها وشذى حلاها","وقد مزجا تفنن جوهري",18,"ي",1,0],["كأن ضريحك زهرُ الربي","ع هبَّت عليه نسيمُ الخريفِ",19,"ف",1,0],["كأنَّ ضجيجَ القاربين بأرضِهِ","وناديهِ في آصالهِ والبَواكرِ",20,"ر",1,0],["كأنَّ ضيوفَ فخر الدينِ وُلْدٌ","يَضمُّهُمُ أبٌ بَرٌّ شَفيقُ",21,"ق",1,0],["كأنّ ضِياها للعِبادِ طوالِعٌ","ففيها شقيٌّ منهمُ وسعيدُ",22,"د",1,0]]}