{"poems":[[79,"سل ما لسلمى بنار الهجر تكويني","https://www.aldiwan.net/poem36040.html","البسيط"],[87,"معالي العهد قمت بها فطيما","https://www.aldiwan.net/poem8100.html","الوافر"],[60,"ترد رداء الصبر عند النوائب","https://www.aldiwan.net/poem31184.html","الطويل"],[60,"تَرَدَّ رِدَاْءَ الصَّبْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=10076",""],[164,"إلى كم تمادى في غرور وغفلة","https://www.aldiwan.net/poem59149.html","الطويل"],[189,"أرى الشر طبع نفوس الأنام","https://www.aldiwan.net/poem14667.html","المتقارب"],[309,"إذا شئت أن تحيا سعيدا مدى العمر","https://www.aldiwan.net/poem16761.html","الطويل"],[369,"أشبه دهري أبناؤه فهم","https://www.aldiwan.net/poem60655.html","المنسرح"],[396,"عن الناس لا تسأل ولا عن فعالهم","https://www.aldiwan.net/poem54512.html","عموديه"],[396,"سلام على أهل الظنون الجميلة","https://www.aldiwan.net/poem54605.html","عموديه"],[852,"","https://poetry.dctabudhabi.ae/diwan/poem/123977","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59420","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124780","الطويل"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116495","الطويل"],[3509,"","https://poetry.dctabudhabi.ae/diwan/poem/124131","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206138","المتقارب"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133241","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77140","الوافر"],[4104,"","https://poetry.dctabudhabi.ae/diwan/poem/125317","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123511","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123516","الطويل"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93753","الوافر"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133094","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83201","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58035","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58076","الطويل"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35427","البسيط"],[4932,"سررتم فَإِنِّي بعدكم غير مسرور","https://www.poetsgate.com/ViewPoem.aspx?id=189366",""],[592,"ما بال عينيك مثل الهاطل الساري","https://www.poetsgate.com/ViewPoem.aspx?id=128848",""],[5410,"رسالة خاصة","https://www.poetsgate.com/ViewPoem.aspx?id=140759",""],[4623,"كتمت الهوى لكن نحولي به باحا ومن (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146769",""],[6152,"كن جابرا للقلوب","https://www.poetsgate.com/ViewPoem.aspx?id=213151",""]],"verses":[["وَكُنْ شَفِيعِي فِي النَّارِ يَاأَمَلِي","لَعَلَّ أَحْظَى بِأَجْرٍ غَيْر مَمْنُونِ",0,"ن",1,0],["وَكُن شَعبَ الخَصائِصِ وَالمَزايا","وَلا تَكُ ضائِعاً بَينَ البَرايا",1,"ي",2,0],["وَكُن شاكِراً لِلّهِ في كُلِّ نِعمَةٍ","يَثِبكَ عَلى النُعمى جَزيلَ المَواهِبِ",2,"ب",1,0],["وَكُنْ شَاكِرا للَّه فِي كُلِّ نِعْمَة","ٍ يثيبكَ على النعمى جزيل المواهب",3,"ب",1,0],["وكن شغلنا عن كل شغل وهمنا","وبغيتنا عن كل هم وبغية",4,"ه",1,0],["وكن شاكرا فضلَ ما فيهمُ","بغيرِ تَغال ودونَ اهتضام",5,"م",1,0],["وَكُن شاكِراً لِلَهِ قَلباً وَقالِباً","عَلى فَضلِهِ ِنَّ المَزيدَ مَعَ الشكرِ",6,"ر",1,0],["وكنْ شفيعاً منَ الّذينَ لدى","شُغلٍ إذا لم يُشفَّعوا غَرِموا",7,"م",3,0],["وكن شاكرا لله قلبا وقالبا","لتعطي مزيدا من كريم ومن ملي",8,"ل",2,0],["وكن شاكرا الله قلبا وقالبا","لتحظى من المولى بنيل الزيادة",9,"ه",1,0],["وكن شاكراً للَه في كل حالة","ترى النعم الغرا تقيد بالشكر",10,"ر",1,0],["وكن شافعا في ابن الخلوف بجاهك","العظيم الذي أعددته لغد ذخرا",11,"ر",2,0],["وكن شاكرا لله وارض بقسمه","تثب وتزد رزقا وإرغام حسد",12,"د",1,0],["وكن شاطرا في اللّه للّه وحده","ولا تعط غير اللّه في حقه شطرا",13,"ر",2,0],["وكن شفيعاً له في يوم مسألة","فقد ثوى في ذنوب ليس يحصيها",14,"ي",3,0],["وكن شجرًا موقرًا بالثمار","وفاخر بتفاحك الحنظلا",15,"ل",2,0],["وكن شفيعا إذا ما الصحف قد نشرت","ولم أجد لي بها قدمت لي زادا",16,"د",2,0],["وَكُن شَهماً أَبِيّاً ذا اِعتِناء","بِفِعلِ الخَيرِ مَحمودَ الإِقامَه",17,"م",2,0],["وكن شاكراً لِلّه حيث أنا لكم","من الشان ان انزلت فيكم وسيلتي",18,"ي",1,0],["وكن شافعى يا مالكى من شظى لظى","اذا اشتدّ بالعاصين فيها بهم قط",19,"ط",1,0],["وكن شافعى يا نافعى عندما لكى","وكل أصولى افعل بهم ذا تصدّقا",20,"ق",2,0],["وَكُن شَهم الفُؤاد رَفيع نَفس","إِذا اِحتشدت جُموع في مَجال",21,"ل",1,0],["وكن شفيعي بحق الرحم يا سيدي","بعد الكبائر من الأوزار في لممي",22,"م",2,0],["وَكُن شَبيهَ البَدرِ في السَماءِ","وَنُورُهُ يَلُوحُ فَوقَ الماءِ",23,"ا",2,0],["وكنْ شفيعيَ يا خير الأنامِ غداً","عليكَ صلَّى إلهي مُدَّةَ العُصر",24,"ر",1,0],["وكن شاهداً أن الرسول محمداً","بشيرٌ نذيرٌ للضلالةِ قامِعُ",25,"ع",1,0],["وَكُن شَكوراً إِذا أَرضاهُ ما صَنَعَت","بِكَ المَشيئَةُ مِن شَيءٍ تُقاسيهِ",26,"ي",2,0],["وَكن شاكراً يسرا وبالعسر رَاضِيا","فأجر الرضى وَالشُّكْر أفضل مذخور",27,"ر",1,0],["وكن شرساً صعباً وشرياً على العدا","وأهل الردى والفحش والغدر والخنز",28,"ز",1,0],["وكن شمساً ولا تك كوكباً قد","أضيء بزيف نور أو تعامى",29,"م",2,0],["وكن شافعا لي في ذنوب تراكمت","علي ومثلي أن يرى بعضها ناحا",30,"ح",2,0],["وكن شجاعاً فإن الجُبن منقصة","وكن إذا استأسدَ الأعداء مغوارا",31,"ر",2,0]]}