"ر",2,0],["يا ندامايَ والزمان موافٍ","ما لدهرٍ على العهود استقامه",57,"م",2,0],["يا نديمي قد راق وقت التصابي","وتداني المنى وفاض الحبورُ",58,"ر",1,0],["يا نديمي وقد وهبْتُك أرضي","فاقتطِعْها فإنني عنك راضي",59,"ض",2,0],["يا نَديمي بادِر فأهنا السرور","في اجتلاء المُدام عِنْدَ البُكورِ",60,"ر",1,1],["يا نداماي هذه خُلَس العي","ش فهل مسعد على الاقتراف",61,"ف",1,0],["يا ندامايَ صفّق الجدولُ الطلْ","قُ ارتياحاً لغصنه واعتداله",62,"ل",2,0],["يا ندوبي تصبّري يا ندوبي","وتناسي هموم أمسي العصيب",63,"ب",1,1],["يا نديميّ كنتما فافترقنا","فاسلواني لكلّ شيء زوالُ",64,"ل",1,0],["يا نديمَيَّ بالصَّراة اغصبا ذا ال","يومَ رهناً بذا الصَّبوح الغبوقُ",65,"ق",1,0],["يا ندامايَ بها النِّسيانُ لي","ولكم منِّي حِفاظي والذِّكَرْ",66,"ر",1,0],["يا نداماي بسلْعٍ هل أرى","ذلك المَغْبقَ والمصطَبَحا",67,"ح",2,0],["يا نديمي والنديمُ معينٌ","يا خليليَّ والخليل شفوق",68,"ق",1,0],["يا نَدامى والوجدُ أَمرٌ عَجيبٌ","ساعِدونا على الهوَى يا نَدامى",69,"م",2,0],["يا نديمي أعد عليَّ وكرر","ذكر من غاب في ستور الصيانه",70,"ن",2,0],["يا نديمي إن غابت الناس عني","فتبدت حقيقة الحق مني",71,"ن",2,1],["يا نديمي لك مني قدْر ما","أنت فيه كلما العقل احتمل",72,"ل",1,0],["يا نداماي ما على شاربيها","حيث باحوا بسرها من باس",73,"س",1,0],["يا نداماي لا عليكم إذا ما","جذبتكم حرارتي من باس",74,"س",1,0],["يا نديمي بحانة الغيب إن ال","غيب كالعين لم يزل نضاخا",75,"خ",2,0],["يا نديمي خذ المدامة مني","إنني قد أدرت هذا الشرابا",76,"ب",2,0],["يا نَديمي والجَوُّ أدكَنُ لِلغيمِ","عَلَيهِ مِن وَشيِهِ طَيلَسانُ",77,"ن",1,0],["يا نَديمي والجَوُّ أَدكَنُ لِلغَي","مِ عليهِ مِن وَشيهِ جِلبابُ",78,"ب",1,0],["يا نداء كان من أغنيتي","وصلاة من فؤادي للوجود",79,"د",1,1],["يا نَديمي ما لوم ذي الوَجد يُجدي","في هَوى أَغيد رَشيق القدّ",80,"د",1,1],["يا نديمي أو من رضابك صرفا","عاطنيها وقل هنيئاً مريا",81,"ي",2,0],["يا نديمي ما فيك عيب سوى ان","ك فينا لا ترقب الغفلات",82,"ت",1,0],["يا نداماي وأيام الصبا","هل لنا رجع وهل لفعمر فسح",83,"ح",1,0],["يا نديمي دعِ المِكاسَ وهاك ال","راحَ خُذْها فلاتَ حينَ مِكاس",84,"س",1,0],["يا نديمَ الأقلامِ مالك أَص