wPoem.aspx?id=186015",""],[469,"يا نديمي والنديم معين","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574762",""],[6225,"نداء الأرض","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80913&r=&rc=182",""],[463,"من عذيري يومَ شرقيّ الحمى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60006&r=&rc=62",""],[6318,"الهند .. تقاوم الاحتلال البريطاني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65940&r=&rc=0",""],[6324,"لا تسل عن أرقي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87946&r=&rc=11",""],[572,"يا نديميَّ جَنّباني الرّحيقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9404&r=&rc=261",""],[572,"يا نَدِيمِي أَطْلِقِ الكأْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9351&r=&rc=208",""]],"verses":[["يا نَديمَيّ فؤادي كلّما","نفحَتْ ريحُ النُّعامَى انْتَشا",0,"ش",2,0],["يا نَديمي بِاللَهِ قُل لي لِماذا","هَذِهِ الخَندَريسُ تُدعى بِرِجسِ",1,"س",1,0],["يا نَدى يُمنى أَبي القاسِمِ غِم","يا سَنا شَمسِ المُحَيّا أَشمِسِ",2,"س",1,0],["يا نديميّ وهذا يومنا","يوم صحوٍ فاجعلاه يوم سكري",3,"ر",2,0],["يا نديميّ في المدام فداءٌ","لكما في المدامة العاذلان",4,"ن",1,0],["يا نَديمي إِلى الكُؤو","س وَيا مِنشِدَ اِنشُدِ",5,"د",1,0],["يا نَديمي وَكَما تَه","وى حَبيبٌ وَحَميمُ",6,"م",1,0],["يا نُدورَ الخَيرِ أَسعِف بِالصِياح","ما تَرى ما فَعَلَت فينا الرِياح",7,"ح",1,0],["يا نَديمُ خِفَّ بِها","لا كَبا بِكَ الطَرَبُ",8,"ب",1,0],["يا نَديمَيَّ بِالسَواجيرِ مِن وُد","دَ اِبنِ مَعنٍ وَبُحتُرِ اِبنِ عَتودِ",9,"د",1,0],["يا نَديمي إِذا تَفَرَّدَ بي الفِك","رُ وَيا مُؤنِسي إِذا كُنتُ وَحدي",10,"د",2,0],["يا ندامى الحب سُمار الهوى","سكبوا لي السهد في ذاك الشراب",11,"ب",1,0],["يَا نَدِيمَيَّ فِي سَرَنْدِيبَ كُفَّا","عَنْ مَلامِي فَلَيْسَ يُغْنِي الْمَلامُ",12,"م",1,1],["يَا نَدِيمَيَّ عَلِّلانِي فَلَنْ تَهْ","لِكَ نَفْسٌ قَدْ عَلَّلَتْهَا النِّدَامُ",13,"م",1,0],["يا نَدَمي عَلى سَهمِ بنِ عَوذٍ","نَدامَةَ ما سَفِهتُ وَضَلَّ حِلمي",14,"م",2,1],["يا نَديمَيَّ إِسقِياني فَقَد لا","حَ صَباحٌ وَأَذَّنَ الناقوسُ",15,"س",1,0],["يا نَدامايَ يا بَني نَوَّبَختٍ","لا يَضيعَنَّ بَينَكُم طَيلَساني",16,"ن",2,0],["يا نَدِيمَيَّ مِنْ سَرَنْدِيبَ كُفَّا","عَنْ مَلامِي وَخَلِّياني لِمَا بِي",17,"ب",2,0],["يا ندى يا حنان أم الدوالي","وبرغمي يجيب من لا أنادي",18,"د",2,0],["يا نديميَّ، إنَّما أنا صبٌّ","بابنةِ النِّيلِ لا ببنت الحان",19,"ن",1,0],["يا نديميَّ، تلك ساعةُ صَفوٍ","سنحت، فاختلستها من زماني",19,"ن",2,0],["يا نديمي فؤادي كلما","نفحت ريح النعامى انتعشا",20,"ش",2,0],["يا نديمي أمري اليكَ فزدْني","او فدَعني فلستُ أنطقُ نَبسا",21,"س",2,0],["يا نَديمَيّ بالسّوَاجيرِ مِنْ وُدّ","بنِ مَعْنٍ، وَبُحتُرَ بنِ عَتُودِ",22,"د",1,0],["يا نديمي إلى متى الإغفاء","بسم الكون حين حيّت ذكاء",23,"ا",2,1],["يا نديمي لا تأس بالله واشرب","لذّة العيش هذه الصهباء",23,"ا",2,0],["يا نديمي تعزّ واسل فقبلا","قد عفت بعد أهلها الحمراء",23,"ا",2,0],["يا نديمي إليّ نبكي فقد يسعد","قلب النائي الحزين البكاء",23,"ا",2,0],["يا نديميَّ ! علالاني ، فلنْ ته","لِكَ نَفْسٌ قَدْ عَلَّلَتْهَا النِّدَامُ",24,"م",1,0],["يا ندِيمي وانسَ ما","كان وما سوفَ يَصِير",25,"ر",1,0],["يا نديمي إِنَّ بعضَ الناس","إِن جُستَ الأمور",25,"ر",1,0],["يا نديمي إِنني أُبصِرُ","هل أنتَ بَصِير",25,"ر",1,0],["يا نديمي نحنُ مثل الناس","إِن جُستَ الأمور",25,"ر",1,0],["يا نَديميَّ اِترُكاني وَاِذهَبا","لَيسَ وادي الذُلِّ لِلحُرِّ بِوادِ",26,"د",1,0],["يا نديمي في صبايا","أنت يا ملهى الصبايا",27,"ي",2,1],["يا ندامى قد تحدّى","الهمّ في قلبي المداما",27,"م",2,0],["يا نديمي عد لتذكرنا","عودةَ الأرواحِ للرممِ",28,"م",1,0],["يا نَدِيماً نادمتُ فيه السُّرورا","بأبي أنتَ مُلهياً وسميرا",29,"ر",2,1],["يا نديمي يباح في العيد طيف","لا نرى في خياله ما نريد",30,"د",1,0],["يا نَديمي أَبرَأَت جُرحي يَدٌ","فاضَ مِنها مَرهَمُ القَلبِ الكَريمِ",31,"م",1,0],["يا نَديمُ الرُؤى عَلَيكَ سَلامٌ","وَسَلامٌ يا سَيِّدَ الشُعَراءِ",32,"ا",2,0],["يا ندِيمي اتَّخِذْ سوايَ فإِنّي","لستُ أَحْيا ما بين مَثْنىً وزِير",33,"ر",1,0],["يا نَديمَيَّ عَرِّجا بي جَميعاً","نَشرَبُ الراحَ كَالصَلاةِ جَماعَه",34,"ع",2,0],["يا نَديمي وَقَد تَبَرَّمتُ بِالنَش","وَةِ حَتّى مَلِلتُ كَأسَ المُديرِ",35,"ر",1,0],["يا ندمي قد خلوت بحر","ليس