/ViewPoem.aspx?id=211799",""],[5943,"مابينَ ثغرِ الياسمين ومسمعي","https://www.poetsgate.com/ViewPoem.aspx?id=61910",""],[5950,"محطّات ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128125",""],[5953,"ولي صاحب إذا كان تقديره الغنى","https://www.poetsgate.com/ViewPoem.aspx?id=93864",""],[5957,"هي قصة","https://www.poetsgate.com/ViewPoem.aspx?id=214638",""],[5974,"غربة يتيم","https://www.poetsgate.com/ViewPoem.aspx?id=200259",""],[6001,"لمحت لك","https://www.poetsgate.com/ViewPoem.aspx?id=410",""],[6056,"الخنجر المذروب","https://www.poetsgate.com/ViewPoem.aspx?id=130515",""],[6089,"في شفتي القصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=213031",""],[6102,"موعد","https://www.poetsgate.com/ViewPoem.aspx?id=185070",""],[6102,"ميرا","https://www.poetsgate.com/ViewPoem.aspx?id=185071",""],[6193,"براءة بر في برآء المحرم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55428&r=&rc=4",""],[6237,"مسافر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77905&r=&rc=47",""],[6261,"الحصار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82136&r=&rc=8",""],[6315,"قَبائلُ النِّسْرِين !! هامشٌ على قرطاسِ المُتَنَبّي ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87575&r=&rc=0",""],[6322,"احتِرَاق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82626&r=&rc=7",""],[6331,"خبِّريني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82020&r=&rc=1",""],[6344,"ملامح من فوضى الصَّدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87966&r=&rc=6",""],[5567,"ذات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69072&r=&rc=10",""]],"verses":[["وَإِن أَورَدوها غَيرَ ماءٍ حايَدَت","حِيادَ عَيوفٍ يُنكِرُ الماءَ قامِحِ",0,"ح",1,0],["وأنا وحدي أناغي هاتفا","من فم الوحي الشذيّ الطاهر",1,"ر",1,0],["وَإِنَّا وَإِنْ كُنَّا عَلَى ثَبجِ الدُّنَا","فَلاَبُدَّ يَوْماً أَنْ نَحُلَّ عَلَى الشَّطِّ",2,"ط",1,0],["وَأَنا وَشِعري كَم يُعَنِّفني الوَرى","فيهِ فَلا فَلا أُصغي إِلى التَعنيفِ",3,"ف",1,0],["وَإِنَّ أَولى البَرايا أَن تُواسِيَهُ","عِندَ السُرورِ الَّذي واساكَ في الحَزَنِ",4,"ن",1,1],["وَإِنّا وَجَدنا إِذ وَفَدنا عَلَيكُمُ","صُدورَ القَنا وَالخَيلَ أَنجَحَ وافِدِ",5,"د",1,0],["وَإِنّا وَإِخواناً لَنا قَد تَتابَعوا","لَكَالمُغتَدي وَالرائِحِ المُتَهَجِّرِ",6,"ر",1,0],["وَإِن أَوجَعَتني مِن أَعادِيَّ شيمَةٌ","لَقيتُ مِنَ الأَحبابِ أَدهى وَأَوجَعا",7,"ع",2,0],["وإن أوْعَدَ ارتَجَّت فإن تمَّ سُخطهُ","تهاوت جبال الأرض في الأرض سُوَّخا",8,"خ",2,0],["وَأَنا وَصَحبِيَ لا نُفَكِّرُ في غَدٍ","فَكَأَنَّ لَيسَ غَدٌ وَلا مُستَقبَلُ",9,"ل",1,0],["وَإِنّا وَكَلباً إِخوَةٌ بَينَنا عُرى","مِنَ العَقدِ قَد شَدَّ القُوى مَن يُغيرُها",10,"ر",3,0],["وَإِنّا وَإِيّاكُم جَرَينا فَأَيُّنا","تَقَلَّدَ حَبلَ المُبطِئِ المُتَأَخِّرِ",11,"ر",1,0],["وَإِنّا وَإِيّاكُم إِلى ما نَسومُكُم","لَمِثلانِ أَو أَنتُم إِلى الصُلحِ أَفقَرُ",12,"ر",1,0],["وِإِن أَولاكَ ذو كَرَمً جَميلاً","فَكُن بِالشُكرِ مُنطَلِقَ اللِسانِ",13,"ن",1,0],["وَإِن أَومَأتُ بِالشَيءِ","وَما يَخفى تَكاتَمتا",14,"ت",2,0],["وإنّا وإيّاهُمْ كَمَارِنِ نَبْعَةٍ","تَهَضّمَ نَجمْاً من يَراعٍ مُهَضَّم",15,"م",1,0],["وَإِنّا وَإِخوانَنا عامِراً","عَلى مِثلِ ما بينَنا نَأتَمِر",16,"ر",1,0],["وإن أودِعوا سِراً رأيتَ صُدورهم","قُبوراً لأسرارٍ تُنَزّهُ عن نَقلِ",17,"ل",1,0],["وإِنَّا وإِيَّاكُمْ ومَوْعِدُ بَيْنَنَا","كَمِثْل لَبِيدٍ يَوْمَ زَايَلَ أَرْبَدَا",18,"د",2,0],["وإنّا وإنْ جارت علينا كوارثٌ","يَقِلُّ التَّعَزّي عندها والتّعلُل",19,"ل",1,0],["وأنا وصحي لا نفكر في غد","فكأنّ ليس غد ولا مستقبل",20,"ل",1,0],["وَإنّا وَإيّاكُمْ جَرَيْنَا، فَأيُّنَا","تَقَلّدَ حَبْلَ المُبْطِىءِ المُتَأخِّرِ",21,"ر",1,0],["وان اودعوا سرا رأيت صدورهم","كنوزا بها الارصاد جلت عن الحل",22,"ل",1,0],["وانا والزمان كما يراني","غريب لاذ بالغوث الغريب",23,"ب",1,0],["وأنا، وأُذنايَ اللَّتانِ","تُهَدِّداني بِالتَّجَمُّدِ والصَّمَمْ",24,"م",1,0],["وأَنا وأَنت علىْ أختلاف قبيلنا","في عرف بيك وجيشه سيان",25,"ن",1,0],["وأنا وأنت أذل من وتد ومن","عير باسطبل الهوان مقيم",26,"م",1,0],["وإِن أولاَكَ الوِصَالَ تَعَرَّضَت","قَطِيعَتُهُ دُونَ الوِصَالِ تَعُرُّضَا",27,"ض",2,0],["وَإِنَّ أَولى الوَرى بِالأَمرِ أَوفَرُهُم","قِسماً إِذا ظَلَّتِ الأَخطارُ تُقتَسَمُ",28,"م",1,0],["وإن أولى الورى بالعفو قدرهم","على العقوبة إن يظفر بذى زلل",29,"ل",1,0],["وإن أولى الورى بالمجدِ كلُّ فتىً","من نفسه ومِنَ الأمجادِ في نسبِ",30,"ب",1,0],["وَإِن أَومَوا إِلى غَرَضٍ بَعيدٍ","أَصابوهُ وَإِن شَهِدوا أَغاروا",31,"ر",3,0],["وإنا وإياكم عبيدُ بن أرقم","كما الأنف والأذنانِ في الرأس أجمعا",32,"ع",2,0],["وأَنا والَّذي أَعلَّ فؤادي","بهواه لست الغداة بسالي",33,"ل",2,0],["وأنا وهم تحت المقدر والقضا","وميزان من يرضى القضاء رجيح",34,"ح",1,0],["وَأَنا وَقَد كادَ العَيا يَغتالُني","أَصبَحتُ مَغبوطاً بِأَعظَمِ صِحَّةٍ",35,"ه",1,0],["وَإِنَّ أَوّل ما سكَّت دَراهمنا","أَرّختها عادَ أَمر الملك مُكتملا",36,"ل",2,0],["وَأَنا وَحَقك لا تؤثر","عندي العذال شَيء",37,"ي",2,0],["وإن أَوعدَ الجانِينَ جاء وَعيدُه","كأنّ أُسوداً في نواحيهِ رُبَّضا",38,"ض",2,0],["وأن أول من ضرّى البزاة هم","ملوك فارس آل المجد والخطرِ",39,"ر",1,0],["وأنا والمقامِ والبيتِ والرك","نِ يميناً وزمزمٍ والمصلّى",40,"ل",2,0],["وإِنَّ أَوْلى بِمُهْدٍ فيكَ مِدْحَتَهُ","لَوْ جاءَ قَبْلُ مِنَ التَّقْصِيرِ يَعْتَذِرُ",41,"ر",1,0],["وإن أوْتَرَتْ قَوساً إلى رَمْيِ مُسْلِمٍ","فلا انْفَصَلَتْ عن مَقْبِضِ العَضْمِ والعَجْسِ",42,"س",1,0],["وإِنَّ أَوَّلَ مقتولٍ بِفِطْرَتِهِ","شَكٌّ من الغَدْرِ أَرداهُ وَلَمْ يَدِهِ",43,"د",2,0],["وأنا والسماء شخصان قد با","تا غريمين بعد طعن الغروب",44,"ب",1,0],["وأنا واقف أراقب كالمشدوه إحسا","سها العجيب المنعّم",45,"م",1,0],["وإن أودَى بنيسابور قومي","فجدُّكُمُ من الأملاك جدِّي",46,"د",2,0],["واِنْ أوجسَ النَّكْسُ خوفاً اِذا","أجشُّ الجيادِ يَجُشُّ الصهيلا",47,"ل",2,0],["وأنا واصل وراء كتابي","قادم خلفه على الأعقاب",48,"ب",1,0],["وأنا وراءك شعلةٌ أبديّة","في صدرها يتألَّقُ الإيمان",49,"ن",1,0],["وأَنا وليّكُم فَلِمْ","يُروى عدوُّكُم وأَظْمَا",50,"م",2,0],["وَإِنَّا وَإِنْ أَغْرَى بِنَا الحُسْنُ عَامِداً","نُؤَمِّلُ أَنْ يُجْرِي بِنَا اليُسْرُ ما يُجْرِي",51,"ر",2,0],["وإن اولو يوماً للفظ أقدروا له","بأن ضيقوا فاردده بالنص مهتد",52,"د",1,0],["وَأَنا وَأَنا لِقَومٍ إِذا","فَخِرنا فَما في الوَرى فاخِرُ",53,"ر",1,0],["وَإِن أَوبت لِأَحضان الطَبيعة لَم","أُلاق أَحنى عَلى الأَبناء أَحضانا",54,"ن",2,0],["وإن أُول جميلاً مً","رَّةً يُولِ بهِ عَشْرا",55,"ر",2,0],["وَإِن أَوعَدت بِالقَتلِ في سَيفِ لَحظِها","فَكَم مِن صَريعٍ قَد تَرى وَقَتيلِ",56,"ل",1,0],["وَإنّا وُلِدنا لِلمَماتِ وَلِلفَنا","وَأَعمارُنا مِنّا تهدُّ وتخربُ",57,"ب",1,0],["وإن أودْعتَ ها سرت تُف","شى السرائر بالصُّياح وبالصراخ",58,"خ",1,0],["وأنا وأنتَ على منازف ِجرحِنا","ضَنِكٌ بموتتهِ يُدينُ الأضنكا",59,"ك",2,0],["وإن أومض البرق الشمالي وهنة","بدت منه أشباه له وشكول",60,"ل",1,0],["وانا ونثاه اليمي وحدثا","عن العي لما انهل حين تشعيا",61,"ع",3,0],["وَإِنّا وَإِيّاكُم وَما كانَ مِنكُمُ","كَصَدعِ الصَفا لا يَرأَبُ الصَدعُ شاعُبهْ",62,"ب",2,0],["وأنا وذكرك في سرور كامل","فكأنني من طيبه مخمور",63,"ر",1,0],["وإن أوقفت طير لداود في الفضا","فطه عليه الشهب أمست تسلم",64,"م",1,0],["وإنا وإن طالت ليالي بعادنا","فانا على صدق الوفا في المعامله",65,"ل",2,0],["وان أوافى حجة","مقبولة ممن هفا",66,"ف",2,0],["وان أؤدى فعلها","بالصدق من غير جفا",66,"ف",2,0],["وأنا وسلمانُ الأديبُ إمامنا","وجميعُ من صقلَتْ نُهاه دُروسُه",67,"س",2,0],["وأنا واللهِ ما أعرفُها","ليس في الأخلاق مثلُ النَّصَفَه",68,"ف",2,0],["وَإِن أوتيتَ فيهِ طَويلَ باعٍ","وَقالَ الناسُ إِنَّكَ قَد سَبَقتا",69,"ت",2,0],["وآن اوانٌ للقران فاقبل ال","عروسان والأقران تصحب أقرانا",70,"ن",2,0],["وَإِنّا وَما تُهدي لَنا إِن هَجَوتَنا","لَكالبَحرِ مَهما يُلقَ في البَحرِ يَغرَقِ",71,"ق",1,0],["وإن أوحشتني يا الهي خطيئتي","فأنس رجائي فيك يا واحد انجلى",72,"ل",2,0],["وَأَنا وَأَنتَ عَلى اِرتِكا","بِ الموبِقاتِ مِنَ الحِراصِ",73,"ص",1,0],["وإنَّا وإن ضرَّستنا الخطوبُ","لنعطيكَ جهدَ رِضى العاذر",74,"ر",1,0],["وَإِن أوقِدَت نارُها بِالعِرا","قِ ضاءَ الحِجازَ سَنا نارِها",75,"ر",3,0],["وأنا والله صفرٌ","من كلا مالٍ وعين",76,"ن",1,0],["وإن أودى وهن له إماءٌ","وكان اللفظ عتقاً في اللزق",77,"ق",1,0],["وَأَنا واياكم كَمرء مُعَذبٍ","بِأَبناء سوءٍ يُظهِرون عُقوقاً",78,"ق",2,1],["وإن أَوْرَى زنادكمُ شراراً","فبين النارِ بَوْنٌ والدُّخَانِ",79,"ن",1,0],["وان أوبأت أو أن تعكر ماؤها","تنحى لأخرى ليس يُعييه مذهب",80,"ب",1,0],["وان اوله طود وثانيه","سيفٌ ومجملهُ صدقٌ بلا كذب",81,"ب",1,0],["وإن أولع الواشون عمداً بوصلنا","فنحنُ بتجديد المودة أبصرُ",82,"ر",1,0],["وإنَّ أَولاهما بالسعدِ لو علموا","من لا تفارقُه أنفاسُ محتضر",83,"ر",1,0],["وأنا وإياك الظليلُ","وظلمه في كل حين",84,"ن",1,0],["وَإِن أَوقَدَ الحَرُّ الحِزابِيّ فَاِرتَقى","إِلى كُلِّ نَشزٍ مُحزَئِلّ سَرابُها",85,"ب",3,0],["وانا وحقك في صفاتك مغرم","واليك شعري في الغرام رسولي",86,"ل",2,0],["وأنا وأنت وليس ترمقنا","سوى عين الكواكب والنجوم",87,"م",1,0],["وإن اولَى امرىءٍ بالعدل من خَضعت","له الرقاب ومن دانت له الأُمم",88,"م",1,0],["وإنَّا وإيّاهمْ كَوَارِد مَنْهَلٍ","على حَوْضِه بالتَّاليات يُهِيب",89,"ب",1,0],["وانا وحرمته يكون حفيظه","أرعى لك الأغنام بالشرطية",90,"ه",1,0],["وأنا وحدي بفكري","تائه يا ليت شعري",91,"ي",1,0],["وأنا والغير في السو","ء على حسن الوفاق",92,"ق",1,0],["وَاَنَا وَحِيْدٌ! مَا صُرَاخِيَ مِلَّةٌ","لكِنَّهُ استِفْهَامُ شِعْرِيْ أَوْ يَدِيْ!",93,"د",2,0],["وإنّ أولى الورى بالرّفق شاكرُ ما","تُسدي إليه من الإنعام مُتّصلا",94,"ا",1,0],["وانا وانت على رباها تابع","يمشي وراء المالك المتبوع",95,"ع",1,0],["وأنا وأنت على وفاق دائم","ما حدت عنك وما مللت مقامي",96,"م",2,0],["وأنا وأنت مهاجم ومدافع","أناما اندحرت ولا فررت امامي",96,"م",2,0],["وأنا والظلامُ مُنتَظِرٌ مِثْ","لي عبدٌ يُسلّيه في الغياهب حُرّ",97,"ر",1,0],["وَأَنا واقِفٌ بِبابِكَ أَرجو","مِنحَةً مِن لَدُنكَ تُصلِحُ شاني",98,"ن",2,0],["وإن اول رزء جل فادحه","لكم وغادر جفن الدين في سكب",99,"ب",1,0],["وأنا واقفون بكل حرب","كجندك كي نبيدك أو نبيد",100,"د",1,0],["وَأَنا وَأَنتِ كَما أَراد لَنا الهَوى","يَشكو النَوى وَمشرِّقٌ وَمُغَرِّب",101,"ب",1,0],["وَإنا وَإِن شانا القَضا حسن جمعنا","لَقَد كُنت ترجونا لجمع المشتت",102,"ت",1,0],["وَأَنا وَتلك كَما تَرو","م يحلُّنا القَصر المشيد",103,"د",1,0],["وأَنا وَأَنت كما أَراد لَنا الهَوى","لا أَنت باخلةٌ ولا أَنا أَقنعُ",104,"ع",1,0],["وَأَنا وَراحلتي ندافع ذا وَذا","حَتّى نَردّ الدَهر في تنكيصه",105,"ص",2,0],["وإنا وإن كنّا من الضيم والأسى","نياح الغواني خفن سوء التأيم",106,"م",1,0],["وإن أوصافه ليست بمحدثةٍ","كذاك أسماؤه