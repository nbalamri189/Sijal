{"poems":[[95,"سبرت نهاية الإخلاص خوفاً","https://www.aldiwan.net/poem9783.html","عموديه"],[90,"هل الدهر إلا أعجمي أخاطبه","https://www.aldiwan.net/poem45012.html","الطويل"],[46,"من سجايا الطلول ألا تجيبا","https://www.aldiwan.net/poem30582.html","الخفيف"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16703","الكامل"],[170,"وفى السحاب لمغناه وإن خانا","https://www.aldiwan.net/poem46863.html","البسيط"],[264,"نحن وفد القرى حللنا الخياما","https://www.aldiwan.net/poem35964.html","الخفيف"],[505,"زر حيش لا تلو النياق لحاسا","https://www.aldiwan.net/poem37995.html","الكامل"],[849,"","https://poetry.dctabudhabi.ae/diwan/poem/105612","الطويل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61023","الطويل"],[1239,"","https://poetry.dctabudhabi.ae/diwan/poem/128278","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79934","الخفيف"],[1692,"","https://poetry.dctabudhabi.ae/diwan/poem/101592","المنسرح"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114030","الكامل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89525","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109460","الطويل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137371",""],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76030","الطويل"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116495","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108330",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109961","البسيط"],[3677,"","https://poetry.dctabudhabi.ae/diwan/poem/35067","الكامل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76452","الطويل"],[4092,"","https://poetry.dctabudhabi.ae/diwan/poem/141703","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72527","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72488","الكامل"],[3591,"أحبكمَ والشاهداتُ الحواسدُ","https://www.poetsgate.com/ViewPoem.aspx?id=149376",""],[5147,"سبرت مقاييس العراق فلاح لي","https://www.poetsgate.com/ViewPoem.aspx?id=166736",""],[5147,"أضر بجسمي عرق النسا","https://www.poetsgate.com/ViewPoem.aspx?id=166690",""],[5174,"لغة الخلود","https://www.poetsgate.com/ViewPoem.aspx?id=199065",""],[5232,"حَظٌّ جريح","https://www.poetsgate.com/ViewPoem.aspx?id=213613",""],[5302,"ما أثلج الصدرا","https://www.poetsgate.com/ViewPoem.aspx?id=201896",""],[5431,"على لسان ابليس!!....","https://www.poetsgate.com/ViewPoem.aspx?id=202708",""],[5616,"الناس","https://www.poetsgate.com/ViewPoem.aspx?id=203231",""]],"verses":[["سَبَرْتُ نِهَايَةَ الإِخْلاصِ خُوْفاً","عَلَى ابْنِ جَمِيلٍ زَيْنِ الشَّبَابِ",0,"ب",1,1],["سَبَرت زماني بالنُهَي ومَخَضْته","بتجربتي حتى تجلّت عواقبه",1,"ب",2,0],["سَبَراتٍ إِذا الحُروبُ أُبيخَت","هاجَ صِنَّبرُها فَكانَت حُروبا",2,"ب",2,0],["سَبْرِيَّةٌ في مَسّها بَحْرِيَّةٌ","بمياهِها شَمْسِيّةٌ بشُعاعِها",3,"ع",3,0],["سبَرتُ حاليَ في قربٍ وفي بُعُدٍ","فلا تسلني ودعني كان ما كانا",4,"ن",2,0],["سَبرَ البِشرُ جُرحَ قَلبٍ لِصَبٍّ","أثخَنَتهُ قوسُ الزَمانِ سِهاما",5,"م",2,0],["سَبَرَ الحَقائِقَ طائراً لِحَضيرةٍ","لم يُبقِ فيها للرِّجالِ مَساسا",6,"س",2,0],["سبرت الورى طراً فلم أر ماجداً","سواه لماذيّ الفضائل مشتارا",7,"ر",2,0],["سبرت بِأَطراف السيوف جِراحها","وَكُنت لَها طباً رَفيقاً وَآسيا",8,"ي",2,0],["سبرت مواضيع الهوى فإذا بها","مظاهر ود كلهن مصائد",9,"د",1,0],["سبرَ الدهر بالتجاربِ حتَّى","بالنهى والفخارِ صارَ زعيما",10,"م",2,0],["سبرت أخلاقهم فليس لنا","إلا شقيّ يريك وجه تقي",11,"ق",2,0],["سَبَرَ اللياليَ فامترى أخلافَها","خُبراً وَسوّغَ صَافيا ومُكَدّرا",12,"ر",2,0],["سَبَرتُ مُلوكاً قَد رَأَيتُ فِعالَهُم","وَطالَعتُ أَخبارَ المُلوكِ الذَواهِبِ",13,"ب",1,0],["سبرت بني الدنيا فلم أر مثله","وهب أنه يلفى ولكنه نزر",14,"ر",1,0],["سبر الحب واستبان مداه","فدراه كهنا وصرفا وغورا",15,"ر",2,0],["سَبرتُ بِهِ ما بَهرَجُوا وَانتقَدتُهُ","وَألقيتُ ما قَد كانَ زيغاً منمَّقا",16,"ق",2,0],["سبرنا بها بحر المعالي فلم تجد","لنا بعد ذلك السبر من احد خبرا",17,"ر",2,0],["سبر الامور بفكرةٍ وقادة","لم يتركن امراً عليه محجبا",18,"ب",2,0],["سَبَرتُ كُلاً فإِن صفواً وإِن كَدَراً","سِيَّانِ عندي وإن حُلواً وان مَقِرا",19,"ر",2,0],["سبرٍ لِجائِفَةِ الأُمورِ أَطِبَّةٍ","لِلصَّدعِ ذي النَبَأ الجَليلِ مَرائِبِ",20,"ب",1,0],["سبرت حَياة الناس حَتّى كأَنَّني","وكل فَتى فوق الثَرى توامان",21,"ن",1,1],["سبرت شرائع العلماء طرا","فلم أر كاعتقاد الحنبلي",22,"ي",1,1],["سبرتموها بمسبار تجسم من","رأى مصيب وحدس فات سابور",23,"ر",1,0],["سبر الممالك جده في فطنة","أنست متى ذكرت لنا سابورا",24,"ر",2,0],["سبرت سجاياه الحسان فإنها","مناهل راحٍ للفتى ومواردُ",25,"د",1,0],["سبرت مقاييس العراق فلاح لي","بقاموسه ما لا يحيط به عقل",26,"ل",1,1],["سبرت علاجك سبر الحكيم","وفي كي قلبك كان الدوا",27,"ا",1,0],["سَبَرُوا أَغْوَارَ مَجْدٍ قَدَ هَوَى","كَيْ يُعِيدُوا لِلدُّنَى غُرَّ الْمَبَانِي",28,"ن",2,0],["سبرتُ الناسَ من صغري بحسٍّ","وفكر ٍ يعشقُ الدُّنيا انفتاحا",29,"ح",2,0],["سبرت خوافيها وأيقنت أنني","تماديت في أمر ولم أقدر القدرا",30,"ر",2,0],["سبرَ الحياة ولم يصل لضيائها","وأراه قعرَ ظلامها لايوقظُ !!",31,"ظ",1,0],["سبرت الناس غوراً ثم غوراً","وعشت طقوسهم سراً وجهراً",32,"ر",2,1]]}