الرمل"],[3561,"","https://poetry.dctabudhabi.ae/diwan/poem/32367","الخفيف"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199027","الرجز"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117967","الخفيف"],[3793,"","https://poetry.dctabudhabi.ae/diwan/poem/124786","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[4038,"","https://poetry.dctabudhabi.ae/diwan/poem/107293","الخفيف"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119602","الرجز"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4308,"","https://poetry.dctabudhabi.ae/diwan/poem/34763","المنسرح"],[4858,"إيهِ يا مصرُ","https://www.poetsgate.com/ViewPoem.aspx?id=138074",""],[4896,"هذه الموجة من هذا الخضم","https://www.poetsgate.com/ViewPoem.aspx?id=180862",""],[3271,"[2] هكذا قال النورج","https://www.poetsgate.com/ViewPoem.aspx?id=104130",""],[3271,"راهب الغرب","https://www.poetsgate.com/ViewPoem.aspx?id=103195",""],[5409,"كلما اجتاز بعدك الدهر ميلا","https://www.poetsgate.com/ViewPoem.aspx?id=155494",""],[5409,"أضحكتنا ورب ضحكٍ بكاء","https://www.poetsgate.com/ViewPoem.aspx?id=155244",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""]],"verses":[["ثُمَّ دُم ما حَسُنَ العَي","شُ وَما طابَ الدَوامُ",0,"م",1,0],["ثُمَّ دانَت بَعدُ الرِبابُ وَكانَت","كَعَذابٍ عُقوبَةُ الأَقوالِ",1,"ل",1,0],["ثم دعا من بينهم واحداً","مشوّه الوجه كثير القذر",2,"ر",1,0],["ثُمَّ دَعَوتُ القَومَ هَذا بازي","فَأَيُّكُم يَنشَطُ لِلبِرازِ",3,"ز",1,0],["ثمَّدتني بناتُ بورانَ حتَّى","أعْقمَتْني وكنتُ غير عقيم",4,"م",1,0],["ثم دارت بهم على نفسها بالرغم","عن كل حيلة الطيار",5,"ر",1,0],["ثم دارت بالمنايا","فوردنا طائعينا",6,"ن",2,0],["ثُمَّ دَعَت مِن عَجَبٍ أُختَها","هِنداً فَقالَت عُمَرٌ أَرسَلا",7,"ل",2,0],["ثُمَّ دَعَتها المُدامُ مِن كَثَبٍ","وَاللَيلُ ذو سُدفَةٍ وَإِدماسِ",8,"س",1,0],["ثم دافعت عنه بعد يقينٍ","مثلما يفعل الكميُّ الجسور",9,"ر",1,0],["ثم دَرْوينُ وهو من قال إنا","نسلُ قردٍ قضت عليه الدهور",9,"ر",1,0],["ثُمَّ دُمِّرَت وَأَتى","من مُدَمِّرِها",10,"ر",3,0],["ثم دارت بالأرض كالفلك الدو","ار لا تحصر النهى اقصاها",11,"ا",3,0],["ثمَّ دبَّ المَساءُ تَقْدمُه الأطيارُ","مرعوبةً وريحٌ جَنوب",12,"ب",1,0],["ثمّ دعتْ، من عجبٍ، أختها","وَواعِدِيهِ سَرْحَتَيْ مَالِكٍ",13,"ل",2,0],["ثُمَّ دَانُوا واستعصَمُوا بِجوَارِ الش","شَيخِ مِمَّا يَأتِي بِه الحدثَانُ",14,"ن",1,0],["ثم دار الزمان دورة نحس","عكست نجم سعدها شر عكس",15,"س",1,0],["ثُمَّ دَالُ الدُّنُوِّ مِنْ كُلِّ يُمْنٍ","وَنَجَاحٍ وَيُسْرَةٍ بَعْدَ عُسْرِ",16,"ر",1,0],["ثم دعنى إن لم يرقك حديثي","عنك يا بن الرقطاء والتنين",17,"ن",1,0],["ثَمَدْ يُرى كأَبِيهِ بَحْرَ نَدَّى","والوَبْلُ أَوْلُهُ مِنَ الطَّلِّ",18,"ل",1,0],["ثم دوَّى المكانُ من غضبهِ الرَّاجا","وكادت تُهدَّمُ الاركان",19,"ن",1,0],["ثم دنا جاذباً عِطافِيَ وال","خوفُ يلوّي منه فقال قمِ",20,"م",1,0],["ثم دمدم يا منشد الحانِ واذكر","عهد خلان حاجرٍ والرفاقِ",21,"ق",1,0],["ثمد الماء حظ غيري منها","وأنا لا انتهاء لي في الموارث",22,"ث",1,0],["ثمد الماء سقتنا وروت","وهدتنا لم تَقُلْ أمّا ثمود",23,"د",1,0],["ثم داوود كان بالحسن مغرى","وسقى بالجمال ألطف كوب",24,"ب",1,0],["ثم دعا الله دعاء من سمع","دعاؤه حين دعاه فرفع",25,"ع",1,0],["ثم دعا الذين كان يحذر","منهم أبو بكر ومنهم عمر",25,"ر",1,0],["ثم دعاه بينهم إليه","وقال وهو رافع يديه",25,"ه",1,0],["ثم دعا بالراية المؤيدة","فجعلت في يده وقوّدة",25,"ه",1,0],["ثم دعى النبي أيضا فرجع","فردّه وعاد قالوا فدفع",25,"ع",1,0],["ثم دعا الناس إلى المسير","إلى ابن هند وإلى التشمير",25,"ر",1,0],["ثم دعاهم بعد للتقية","ولينسبوا إليه عباسية",25,"ه",1,0],["ثم دعوته فلم","يشكُ أسىً ويضرع",26,"ع",1,0],["ثمَّ دوسي بِأَخمصَيك الثُّريَّا","تَمنحيها بِالدَّوْسِ حُسْنَ اِعتِلاءِ",27,"ا",2,0],["ثُم دَعا إِلى النِزال كَلبه","وَالكَلبُ يَرميه بِأَدنى جَلبه",28,"ه",1,0],["ثُمَ دَعا وَهاتفٌ قَد هَتَفا","مُنادياً قَد ظَهَر الَّذي اِختَفى",29,"ف",2,0],["ثُمَ دَنا مِنهُ عَظيمُ كَلب","قوته قَد غرست في القَلب",30,"ب",1,0],["ثُم دَنا الحِصان مِنهُ فَجَرى","وَرَجَع الحِصان بَعد خاسرا",31,"ر",2,0],["ثُم دَنوا مِن حملها فَنَفَرَت","وَضَرَبت بِرجلها وَعَفَرَت",32,"ت",1,0],["ثم دانتْ لك العبادُ وأضحى","كل قالٍ بذلة وهوان",33,"ن",1,0],["ثم دوموا لا زلتمُ في سرور","ونعيمٍ في مدة الأيام",34,"م",1,0],["ثم دع ذا إن وسطتك الحرامي","ة في طرق واسطما ما احتيالي",35,"ل",2,0],["ثم دويس كان في المدينة","يقول قومي أنصتوا لسيرتي",36,"ي",1,0],["ثم دعا أهله جميعاً","حيث أنتأوا أن هلم أهلا",37,"ل",2,0],["ثُمَ دَبيس وَدَبيس غرَّه","رَحب الذراع ذُو سَجايا حرّه",38,"ه",1,0],["ثُم دَنَوت مِنهُ فَاِستَخبرته","عَن حالِه فَقَص ما ذكرته",39,"ه",1,0],["ثُم دَخَلت الوَكر وَهوَ خَلفي","في فاقَةٍ يَعجَز عَنها وَصفي",39,"ي",1,0],["ثُم دَنوت ساعياً لا طائِرا","إِذ نَتَفوا ريش جَناحي الوافِرا",39,"ر",2,0],["ثُم دَعاني خالياً فَاِعتَذَرا","وَتابَ مِن ذمهم وَاِستَغفَرا",40,"ر",2,0],["ثم دعت لا طرقت ربعَكمُ","إلاَّ المسرّات مدى آبادها",41,"د",3,0],["ثم دياجي النحس زالتْ فما","أسعدها وابيضَّ قطراها",42,"ا",3,0],["ثم دارت كاساتها فسقتنا","خمرة حرة تمازج حرا",43,"ر",2,0],["ثمدَ الحوضُ شَفَت العينُ دهراً","من نفوسٍ محبوبُها الأرفاثُ",44,"ث",1,0],["ثم دار الفلك وأمسيت عن ذاك راحل","كم مسافات حالات بيننا كم مراحل",45,"ل",1,0],["ثم دليل كونه مخالفا","لخلقه كما علمت سالفا",46,"ف",2,0],["ثم دليل سمعه وبصره","كذا الكلام يا فريد عصره",46,"ه",1,0],["ثم دليل كون فعل الممكن","أو تركه جاز على المهيمن",46,"ن",1,0],["ثم دليل كون أعراض البشر","جازت عليهم كالسقام والضرر",46,"ر",1,0],["ثم دللتُ صباها فنَمتْ","كالنّبات الغضّ في ظلّ الفنن",47,"ن",1,0],["ثم دعني فرحا مستبشراً","أتغنى بزفاف الفرقدين",48,"ن",1,0],["ثُمَّ دَعى خاناته وَالملا","شَيخ الشَياطين كَثير العله",49,"ه",1,0],["ثمَّ دَعها في الشّمس حتى تَراها","بعدَ فَلسٍ في صُفْرَةِ الدِّينارِ",50,"ر",1,0],["ثمَّ دَكَّتهُ حفيظتُه","واعاد النار من عزمه",51,"م",2,0],["ثم داوي البلا بخلق جميل","وبحبل من الكمال طويل",52,"ل",1,0],["ثُمَّ دارَ الحَق قَبر في الثَرى","من تَراهُ فيهِ يَوماً ما نَزَل",53,"ل",1,0],["ثُمَّ دافَعتُها إِلى القُبَّةِ الخَضراءِ","نَمشي في مَرمَرٍ مَسنونِ",54,"ن",1,0],["ثم دهى الحين الرشيد فاخترم","والموت حتم في العباد قد حتم",55,"م",1,0],["ثم دهى بعد الإمام المعتصم","وهو على دجلة حين فقصم",55,"م",1,0],["ثم دار الزمان دوراً فقالوا","لك بشرى بدولة الإقبال",56,"ل",1,0],["ثم دخلنا لصلاة الصّبح","وكلّنا مستبشرٌ بالنُّجحِ",57,"ح",1,0],["ثُمَّ دَعاهُ لِلجلوسِ فَأبى","وَقالَ يا مُريدَ زَفسَ الأَنجَبا",58,"ب",2,0],["ثمَّ دارَت عَلى النَدَامى مُدامٌ","من جَنى البُنِّ في لُجَينِ الأَوَانِي",59,"ن",2,0],["ثم دنوا منكم ليبتغوا الظَفَر","وكانت الساعة أدهة وأمَر",60,"ر",1,0],["ثُمَّ دعاهُم رَبُّهُم فابتدَرُوا","إلى مَحَلِّ القُربِ مِنهُ وَالرِضَا",61,"ا",1,0],["ثُمَّ دَعَتني إِلى مُبارَزَةِ ال","حُبِّ فَرُجَّت مِن تَحتِنا المُثُلُ",62,"ل",1,0],["ثمّ دسّوهم كرقطاءَ اختفت","تلدَغُ المَرء وتسقيه المَنونا",63,"ن",2,0],["ثم دوى الطبل في إفريقيا","فشجا حرا بأمريكا النغم",64,"م",1,0],["ثمّ دار الدهر حيناً فمشى فيه العفاءُ","غرسةٌ صلّى لها الصبح وحيّاها المساءُ",65,"ا",2,0],["ثمّ دار الزمانُ دورةَ نحسٍ","فإذا حظُّها مع النحسِ دارا",66,"ر",2,0],["ثم دالت أيامهم واستر الد","دهر ملكاً مقدراً أن يزولا",67,"ل",2,0],["ثم دارت رحى الزمان فأبدت","لي ما ينطوي عليه الخفاء",68,"ا",2,0],["ثم دعني لصبوتي أتغنّى","ب ( ألاتِ الشنوف والأطواق ِ)",69,"ق",1,0]]}