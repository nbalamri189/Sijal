ق الباب حالماً بلقاها","https://www.poetsgate.com/ViewPoem.aspx?id=155363",""],[5411,"طائر النَّار","https://www.poetsgate.com/ViewPoem.aspx?id=191637",""],[5431,"اقتل إلهك ...","https://www.poetsgate.com/ViewPoem.aspx?id=208787",""],[5491,"أحبك فوق ما تتصور","https://www.poetsgate.com/ViewPoem.aspx?id=215087",""],[5717,"يا حسرة من فؤاد محتدم","https://www.poetsgate.com/ViewPoem.aspx?id=170590",""],[5771,"بَدَاوة","https://www.poetsgate.com/ViewPoem.aspx?id=189436",""],[5794,"كنز لا يفنى ..","https://www.poetsgate.com/ViewPoem.aspx?id=80285",""],[5842,"كي لا ينضب الماءُ","https://www.poetsgate.com/ViewPoem.aspx?id=73684",""],[5891,"أحلام الموتى","https://www.poetsgate.com/ViewPoem.aspx?id=39927",""],[5956,"أنا شيعيٌّ وسنيٌّ…. معا","https://www.poetsgate.com/ViewPoem.aspx?id=192366",""],[5957,"إنتظار","https://www.poetsgate.com/ViewPoem.aspx?id=26226",""],[6046,"أنا بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=35208",""],[6102,"قاتل","https://www.poetsgate.com/ViewPoem.aspx?id=184624",""],[5075,"ماذا جنى الأحرار ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82761&r=&rc=7",""],[5957,"دموع الانتظار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82572&r=&rc=116",""],[463,"حيها أوجهاً على السفحِ غرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60067&r=&rc=123",""],[5190,"الببغاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78301&r=&rc=14",""],[572,"ونديمٍ مُخَالفٍ لا يشاءُ الذي أشَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9353&r=&rc=210",""]],"verses":[["أَقتادُهُنَّ بِفاحِمٍ مُتَخايِلٍ","فَيُريبُني وَيَرينُ لي وَيَزينُ بي",0,"ب",2,0],["أقتاف آثاراً لهنّ دوارساً","كانت إليها غدوتي ورواحي",1,"ح",2,0],["أَقَتلوني يا ثِقاتي","إِنَّ في قَتلي حَياتي",2,"ت",2,1],["أُقتُلهُ وَاِطَرَح جِسمَهُ لِلكِلاب","وَلتَذهَبِ الروحُ إِلى النارِ",3,"ر",1,0],["أَقتِصارٌ عَلى أَحاديثِ فَضلٍ","فَهوَ مُستَكرَهٌ كَثيرُ الفُضولِ",4,"ل",1,0],["أَقتُلُ الأَبطالَ قَهراً","ثُمَ لا أَفزَعُ شَيّا",5,"ي",2,0],["اِقتَضِب كَما سَأَلوا","فاعِلاتُ مُفتَعِلُ",6,"ل",1,0],["أقتادهُنَّ إلى حربٍ على الضجر","فيصْطلن على حربي مع الضجرِ",7,"ر",1,0],["اُقتُليهِ قَتلاً سَريحاً مُريحاً","لا تَكوني عَلَيهِ سَوطَ عَذابِ",8,"ب",1,0],["أَقَتَلتَ الكُماةَ في الحَربِ غُلباً","أَم قَتَلتَ النِساءَ وَالأَطفالا",9,"ل",2,0],["اقْتُلْ عليٌّ إنّهم مَعْشَرٌ","مَا مِثْلَهم أعمَى الهَوَى مَعْشَرا",10,"ر",2,0],["اقترحْ ما شِئتَ وَاطْمَعْ لا تَخفْ","مِن نَدى كَفَّيهِ نَقصاً أو نَفادا",11,"د",2,0],["اِقتَرَبَ الوَعدُ وَالقُلوبُ إِلى","اللَهوِ وَحُبِ الحَياةِ سائِقُها",12,"ق",3,1],["اِقتَرَنَت مِن خَشيَةِ لِلرَدى","عَفَّرَها في النَقعِ زُنبورُ",13,"ر",1,0],["أَقتادُ هَمّاً بِأَقتادٍ عَلى إِبلٍ","وَهَل يُبَلِّغُ ما أَمَّلتُهُ القَتَدُ",14,"د",1,0],["أَقتاتُ مِن طَيِّبِ النَباتِ وَهَل","يَسلَمُ عودُ الفَتى مِنَ الأُبَنِ",15,"ن",1,0],["اقتحمتنَّ السياجَ","فقد خضعَ الكونُ واستسلما",16,"م",2,0],["إِقْتَرَنَا رُوحاً وَجِسْماً فَهُمَا","لَيْلَى لَبِيبٌ وَلَبِيبُ لَيْلَى",17,"ل",2,0],["اقتربي... كاملة الأوصافْ!","اقتربي.. جمهورك القديمْ",18,"م",1,0],["اقتبالُ الربيعِ في بَسَماتِهْ","نبَّه الكونَ بعدَ طولِ سُباتِهْ",19,"ت",2,1],["أقتلوهم ، واسجنوا آباءهم","واقتلوهم ، بعد تكبيل سنه",20,"ن",2,0],["أقتل المقتول ، أدميه إلى","أن أرى الأسرار ، حمرا معلنه",20,"ن",2,0],["أُقتلي بنْتَكِ الصغيرةَ لُبنى","لا تكابدْ ما كابدت أمُّ لبنى",21,"ن",2,0],["اِقتَدى حَييٌّ مِنَ السُؤالِ مُنهَمِلُ النَدى","عَفُوٌّ عَنِ الجُهّالِ مُتَّصِلُ الصفحِ",22,"ح",1,0],["إقترحنا عليك إنشاء دار","يلتقى عندها رجال الفنون",23,"ن",1,0],["اقتصد يا حلو في هذا الدلال","وتعال انظر عنائي من نواك",24,"ك",1,0],["أَقتَلُ ما كانوا إِذا","سَلّوا سُيوفَ الحَدَقِ",25,"ق",1,0],["اقتل عداك فهم أو لو بغي وقد","غدروا وفرق ما لهم من مجمع",26,"ع",1,0],["اقترفت وما عترفت ولو أني","اعترفت في الأنام مثيل",27,"ل",1,0],["اِقتعدوا الرِّدف وأع","طَوْك مكانَ القَمَعِ",28,"ع",1,0],["أَقتضيهم مطلَ الإِيابِ وقد وف","فَى الفراقُ الوشيكُ فيهم نَذْرا",29,"ر",2,0],["أقتلُ حلماً وتقولُ العُلى","واعجباً للقائل الباسمِ",30,"م",1,0],["أقتلتني وغضبت عامدةً","فهبي رضاكِ وأنتِ في حلّ",31,"ل",1,0],["اقتل وعذب وصادر","فلا معقب أصلا",32,"ل",2,0],["أَقتاتُ غيظي فإذا عِفْتُهُ","خرجتُ من غيظٍ إلى عِفّةِ",33,"ه",1,0],["أقَتلاً مِنَ الأَعرابِ فالذُّلُ ما بِهِ","تُهانُوا وَقَتلاً مِن أكُفِّ الأَعاجِمِ",34,"م",1,0],["اِقتُل وَلا تخش الطلَب","بالوتر لا وَالشفعِ",35,"ع",1,0],["أقتل المسلمين يجوز عمداً","فقال نعم على دين المسيح",36,"ح",1,0],["اقتضى أن نساء فيما فتحنا","ه ببذل الأموال والأبناء",37,"ا",2,0],["اقتضى وَصفَه القريضُ فما يب","لغُ فيه من القريض بليغه",38,"غ",2,0],["أَقتُلُهُم وَلا أَرى عَلِيّا","وَلَو بَدا أَوجَرتُهُ الخَطِيّا",39,"ي",2,1],["أقتطف النور وأجتنى الزهر","ونجم اقبالى وسعدى قد ظهر",40,"ر",1,0],["اقتادَ حسنك للقلوب فكلها","إما أسير أو مُعنى هالك",41,"ك",1,0],["أقتيب قد قلنا غداة أتيتنا","بدل لعمرك من يزيد أعور",42,"ر",1,1],["أقتدي بالذي يقول بناها","ذلك الخالق الحكيمُ الباري",43,"ر",2,0],["أقتفي الحق ولا أر","ضى بآراء الرجال",44,"ل",1,0],["إقتعدها وأقم من صدرها","حيثُ وفد البيت يُلقون الرحالا",45,"ل",2,0],["أُقْتُلُوا أَنْفُسَكُمْ يا حُسَّدي","قد نَمَى المالُ وقد أَثْرَى العدد",46,"د",1,0],["اِقتَرَبَ الوَعدُ وَالقُلوبُ إِلى الل","لَهوِ وَحُبُّ الحَياةِ سائِقُها",47,"ق",3,1],["اقتلوني يا عداتي","بوفائي بعداتي",48,"ت",2,1],["إِقتصّ مشن ذاكَ الغَزال لَنا فَقَد","أَضحَت جَرائمه بِها مُتعدّده",49,"د",2,0],["اقتلوا الساحر أيان يكون","ابحثوا عنه أذيقوه العطب",50,"ب",1,0],["أقتات منه علالاتٍ مسكنةً","ويستقي منه وهمي كل مرغوب",51,"ب",1,0],["اقتله مثل البعوض مبتدراً","فما بقتل البعوض من باس",52,"س",1,0],["أقتلتهم بالحسن أم قتلوك","الشمس أمك والهلال أبوك",53,"ك",1,1],["اقتلوني واتركوهُ أُنظري","قتلوهُ آه يا ويح اللئام",54,"م",1,0],["أقتفيها وفي يديّ فؤادي","ثم ألوي وفي يديّ حطامُ",55,"م",1,0],["اقتفى أثر اهله في المعالى","نفسه للدعاء دابا حرية",56,"ي",2,0],["اقتفيت الأسلاف فازددت علما","في سبيل العلى اتبعت أباكا",57,"ك",2,0],["أقتلتنا، ظلماً، بلا ترةٍ","عمداً، لتوهن آمن العظم؟",58,"م",1,0],["اقتصد فِي كل حَال","واجتنب شحا وغرما",59,"م",2,1],["اِقتَصِد يا فُؤاد إِن تُقتُ يَوماً","ربّ شوق طغى فَعادَ خبالا",60,"ل",2,0],["اقتلوني ومالكاً","واقتلوا مالكاً معي",61,"ع",2,0],["اِقتَبَل أَنتَ ناعِماً وَت