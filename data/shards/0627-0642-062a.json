{"poems":[[53,"ولقد أكون من الغواني مرة","https://www.aldiwan.net/poem30713.html","الكامل"],[88,"لمن الديار يلحن في الصحصاح","https://www.aldiwan.net/poem44408.html","الكامل"],[64,"أقتلوني يا ثقاتي","https://www.aldiwan.net/poem67662.html","الرمل"],[91,"أمر السلطان بالشاعر يوما فأتاه","https://www.aldiwan.net/poem62797.html","عموديه"],[45,"ذكرتنيك روحة للشمول","https://www.aldiwan.net/poem65597.html","الخفيف"],[58,"أنا مذ كنت صبيا","https://www.aldiwan.net/poem30791.html","مجزوء الرمل"],[66,"طويل له دون البحور فضائل","https://www.aldiwan.net/poem38472.html","الطويل"],[90,"أرح ركابك من أين ومن عثر","https://www.aldiwan.net/poem60154.html","عموديه"],[31,"شاق قلبي تذكر الأحباب","https://www.aldiwan.net/poem42632.html","الخفيف"],[105,"أيها الجند ظافرا يتمشى","https://www.aldiwan.net/poem43097.html","الخفيف"],[105,"خوضوا الوغى يا أهل وادي القرى","https://www.aldiwan.net/poem44051.html","السريع"],[105,"تلك عقبى البغي فانظر كيف عادا","https://www.aldiwan.net/poem44219.html","الرمل"],[21,"اقترب الوعد والقلوب إلى","https://www.aldiwan.net/poem36191.html","المنسرح"],[48,"قد أغتدي والصبح مشهور","https://www.aldiwan.net/poem63411.html","الخفيف"],[46,"والحكم جار على الأكتاد محتمل","https://www.aldiwan.net/poem22384.html","البسيط"],[46,"من لي بترك الطعام أجمع إن ال","https://www.aldiwan.net/poem23538.html","المنسرح"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55181","الرجز"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199490","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54305","الخفيف"],[100,"مأساة حارس الملك","https://www.poetsgate.com/ViewPoem.aspx?id=50435",""],[90,"صفحة من الحياة الشعبية أو بيت يتهدم","https://www.poetsgate.com/ViewPoem.aspx?id=179029",""],[150,"أصبت من الحساد أنفذ مقتل","https://www.aldiwan.net/poem68600.html","الطويل"],[211,"يا نجوم الفنون والدهر ليل","https://www.aldiwan.net/poem46602.html","الخفيف"],[211,"مرت الأيام والروح الحزين","https://www.aldiwan.net/poem46613.html","الرمل"],[235,"عسى غزال الأبرق","https://www.aldiwan.net/poem31803.html","مجزوء الرجز"],[261,"وان طيفا منك عاود مضجعي","https://www.aldiwan.net/poem38243.html","الكامل"],[391,"يا طبيب القلوب قلبي عليل","https://www.aldiwan.net/poem54534.html","عموديه"],[458,"لي عند ظبي الأجرع","https://www.aldiwan.net/poem56126.html","مجزوء الرجز"],[458,"حيها أوجها على السفح غرا","https://www.aldiwan.net/poem56191.html","الخفيف"],[461,"كبت جفان الحي من دارم","https://www.aldiwan.net/poem15098.html","السريع"],[464,"شهرت علي صوارم العذل","https://www.aldiwan.net/poem3349.html","عموديه"],[479,"غب التحية أنهي","https://www.aldiwan.net/poem36939.html","المجتث"],[551,"هل عائد ينفع من علتي","https://www.aldiwan.net/poem48029.html","السريع"]],"verses":[["أَقتادُهُنَّ بِفاحِمٍ مُتَخايِلٍ","فَيُريبُني وَيَرينُ لي وَيَزينُ بي",0,"ب",2,0],["أقتاف آثاراً لهنّ دوارساً","كانت إليها غدوتي ورواحي",1,"ح",2,0],["أَقَتلوني يا ثِقاتي","إِنَّ في قَتلي حَياتي",2,"ت",2,1],["أُقتُلهُ وَاِطَرَح جِسمَهُ لِلكِلاب","وَلتَذهَبِ الروحُ إِلى النارِ",3,"ر",1,0],["أَقتِصارٌ عَلى أَحاديثِ فَضلٍ","فَهوَ مُستَكرَهٌ كَثيرُ الفُضولِ",4,"ل",1,0],["أَقتُلُ الأَبطالَ قَهراً","ثُمَ لا أَفزَعُ شَيّا",5,"ي",2,0],["اِقتَضِب كَما سَأَلوا","فاعِلاتُ مُفتَعِلُ",6,"ل",1,0],["أقتادهُنَّ إلى حربٍ على الضجر","فيصْطلن على حربي مع الضجرِ",7,"ر",1,0],["اُقتُليهِ قَتلاً سَريحاً مُريحاً","لا تَكوني عَلَيهِ سَوطَ عَذابِ",8,"ب",1,0],["أَقَتَلتَ الكُماةَ في الحَربِ غُلباً","أَم قَتَلتَ النِساءَ وَالأَطفالا",9,"ل",2,0],["اقْتُلْ عليٌّ إنّهم مَعْشَرٌ","مَا مِثْلَهم أعمَى الهَوَى مَعْشَرا",10,"ر",2,0],["اقترحْ ما شِئتَ وَاطْمَعْ لا تَخفْ","مِن نَدى كَفَّيهِ نَقصاً أو نَفادا",11,"د",2,0],["اِقتَرَبَ الوَعدُ وَالقُلوبُ إِلى","اللَهوِ وَحُبِ الحَياةِ سائِقُها",12,"ق",3,1],["اِقتَرَنَت مِن خَشيَةِ لِلرَدى","عَفَّرَها في النَقعِ زُنبورُ",13,"ر",1,0],["أَقتادُ هَمّاً بِأَقتادٍ عَلى إِبلٍ","وَهَل يُبَلِّغُ ما أَمَّلتُهُ القَتَدُ",14,"د",1,0],["أَقتاتُ مِن طَيِّبِ النَباتِ وَهَل","يَسلَمُ عودُ الفَتى مِنَ الأُبَنِ",15,"ن",1,0],["اقتحمتنَّ السياجَ","فقد خضعَ الكونُ واستسلما",16,"م",2,0],["إِقْتَرَنَا رُوحاً وَجِسْماً فَهُمَا","لَيْلَى لَبِيبٌ وَلَبِيبُ لَيْلَى",17,"ل",2,0],["اقتربي... كاملة الأوصافْ!","اقتربي.. جمهورك القديمْ",18,"م",1,0],["اقتبالُ الربيعِ في بَسَماتِهْ","نبَّه الكونَ بعدَ طولِ سُباتِهْ",19,"ت",2,1],["أقتلوهم ، واسجنوا آباءهم","واقتلوهم ، بعد تكبيل سنه",20,"ن",2,0],["أقتل المقتول ، أدميه إلى","أن أرى الأسرار ، حمرا معلنه",20,"ن",2,0],["أُقتلي بنْتَكِ الصغيرةَ لُبنى","لا تكابدْ ما كابدت أمُّ لبنى",21,"ن",2,0],["اِقتَدى حَييٌّ مِنَ السُؤالِ مُنهَمِلُ النَدى","عَفُوٌّ عَنِ الجُهّالِ مُتَّصِلُ الصفحِ",22,"ح",1,0],["إقترحنا عليك إنشاء دار","يلتقى عندها رجال الفنون",23,"ن",1,0],["اقتصد يا حلو في هذا الدلال","وتعال انظر عنائي من نواك",24,"ك",1,0],["أَقتَلُ ما كانوا إِذا","سَلّوا سُيوفَ الحَدَقِ",25,"ق",1,0],["اقتل عداك فهم أو لو بغي وقد","غدروا وفرق ما لهم من مجمع",26,"ع",1,0],["اقترفت وما عترفت ولو أني","اعترفت في الأنام مثيل",27,"ل",1,0],["اِقتعدوا الرِّدف وأع","طَوْك مكانَ القَمَعِ",28,"ع",1,0],["أَقتضيهم مطلَ الإِيابِ وقد وف","فَى الفراقُ الوشيكُ فيهم نَذْرا",29,"ر",2,0],["أقتلُ حلماً وتقولُ العُلى","واعجباً للقائل الباسمِ",30,"م",1,0],["أقتلتني وغضبت عامدةً","فهبي رضاكِ وأنتِ في حلّ",31,"ل",1,0],["اقتل وعذب وصادر","فلا معقب أصلا",32,"ل",2,0],["أَقتاتُ غيظي فإذا عِفْتُهُ","خرجتُ من غيظٍ إلى عِفّةِ",33,"ه",1,0]]}