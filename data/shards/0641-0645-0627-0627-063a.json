{"poems":[[55,"الله يعلم ميلي عن جنابكم","https://www.aldiwan.net/poem29960.html","البسيط"],[88,"رياض أفق من غمرة الموت واستمع","https://www.aldiwan.net/poem10488.html","الطويل"],[30,"أبيت أمني النفس أن سوف نلتقي","https://www.aldiwan.net/poem1234.html",""],[52,"أفرخ الزنج طال بك البلاء","https://www.aldiwan.net/poem64886.html","الوافر"],[108,"سلاح غاندي","https://www.poetsgate.com/ViewPoem.aspx?id=179409",""],[30,"أبيت أمني النفس أن سوف نلتقي","https://www.poetsgate.com/ViewPoem.aspx?id=21313",""],[240,"هي الأيام صحتها سقام","https://www.aldiwan.net/poem31759.html","الوافر"],[280,"ولي العهد أم عهد الولي","https://www.aldiwan.net/poem25452.html","الوافر"],[287,"بكم قلبي عليل ما يبل","https://www.aldiwan.net/poem32664.html","الوافر"],[422,"يشق علي أن تشقى بحبس","https://www.aldiwan.net/poem53982.html","الوافر"],[422,"لفقدان عبد الواحد الدمع قد جرى","https://www.aldiwan.net/poem54022.html","الطويل"],[443,"يا مانعي النوم بقطع الوصال","https://www.aldiwan.net/poem2583.html","السريع"],[445,"تناضل عنك أقدار السماء","https://www.aldiwan.net/poem34803.html","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122732","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122593","الوافر"],[828,"","https://poetry.dctabudhabi.ae/diwan/poem/124038","الطويل"],[1916,"","https://poetry.dctabudhabi.ae/diwan/poem/121547","الوافر"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76656","الطويل"],[2140,"","https://poetry.dctabudhabi.ae/diwan/poem/31482","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53192","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53078","الوافر"],[2211,"","https://poetry.dctabudhabi.ae/diwan/poem/121908","الطويل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120784","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89342","الوافر"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109945","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91192","الوافر"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119464","الوافر"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136911",""],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81718","الطويل"],[1012,"أباة الضيم","https://www.poetsgate.com/ViewPoem.aspx?id=186325",""],[1012,"فتح بلدة نفعا","https://www.poetsgate.com/ViewPoem.aspx?id=124499",""],[4815,"صُراخ","https://www.poetsgate.com/ViewPoem.aspx?id=210474",""],[5106,"يُقَبِّلُنِيْ بِشَاطِئِهِ نَهَا","https://www.poetsgate.com/ViewPoem.aspx?id=150264",""],[5997,"الغَرَّاْءُ","https://www.poetsgate.com/ViewPoem.aspx?id=214276",""],[6079,"ألا ليت القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=207373",""],[5080,"يكبّل لحظة ويزيح أخرى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88132&r=&rc=2",""]],"verses":[["فَما أَغُبُّكَ مِن عُذرٍ وَلا شَغَلٍ","وَلا أَزورُكَ مِن وَجدٍ وَلا شَغَفِ",0,"ف",1,0],["فَما أَغلَبٌ شاكي العَزيمَةِ أَروَعٌ","يُصارِعُهُ في الغابِ أَغلَبُ أَروَعُ",1,"ع",1,0],["فَما أُغمِدَ حَتّى أَنابَت قُلوبُهُم","وَسَمَّحَ لِلضَربِ الشَآمي دِماؤُها",2,"ا",3,0],["فَما اِغتَبَطَت فَتاةُ بَني غَنِيٍّ","وَلا الزِنجِيُّ إِنَّهُما سَواءُ",3,"ا",2,0],["فما أغنت بريطانيا","قوى الأسطول والجند",4,"د",1,0],["فَمَا أُغْمدا حَتى أنابَتْ قُلُوبُهُمْ،","وَسَمّحَ، للضّرْبِ الشّآمي، دِماؤها",5,"ا",3,0],["فَما أَغنَت أَسِنَّتُها المَواضي","وَلا مَنَعَت عَشيرَتُها الكِرامُ",6,"م",1,0],["فَمَا أَغْنَى ابنُ غَانِيَةٍ فَتِيلاً","وَمَا أَجْدَى ذوُوهُ بَنُو عَلِيِّ",7,"ي",1,0],["فَما أَغناهُ عِندي عَن سِلاحٍ","فَفي حَملِ السِلاحِ عَلَيهِ كَلُّ",8,"ل",1,0],["فما أغلى ليالينا وأحلى","لقد بيعت لشِقْوَتِنا ببخس",9,"س",1,0],["فما أَغمدوا في الترب إلاَّ مهنَّداً","ولا حملوا في النَّعش إلاَّ غضنفرا",10,"ر",2,0],["فما اغتدى يضحك يوم الندى","إلا بكى المال إذا عنه مال",11,"ل",1,0],["فما أَغْنَتْ بظهرِ الغَيْبِ إِلّا","وَقَدْ أَغنى بِهَا كرَمُ الوَفاءِ",12,"ا",2,0],["فَما أغنَى دِفاعُهُم وأَغنَت","مُدافَعَةُ النِّساءِ عَنِ الرِّجالِ",13,"ل",1,0],["فما أغنى ذمرمرُ عن بَراشٍ","ولا أكفى بَراقِشُ عن هِداد",14,"د",1,0],["فما أغنت البيض الصوارم والقنى","نقيراً وما أغنى الوليد ولا عمرو",15,"ر",2,0],["فما أغنى مسالمة الليالي","وأصبح شاكيا ألم التمنى",16,"ن",2,0],["فما أغرب الأيام فيما قضت به","تريني بعدي عنك آنس من قربي",17,"ب",2,0],["فَما أَغنى صِياحُ الحَيِّ عَنهُ","وَوَلولَةُ النِساءِ مَعَ الرَنينِ",18,"ن",1,0],["فما أغنى العباد عن الغوادي","إذا ما جَوُّ جود منك غاما",19,"م",2,0],["فما أغنى اقتدارَكَ عن أناس","تَرَاكَضَ في صدورهم الحُقُود",20,"د",1,0],["فما أغفل الإنسان عن قدر نفسه","وأجهله في بذل ما هو باذله",21,"ل",2,0],["فما اغترّ رومي كما اغتر فطرهم","كفرعون ذي الأوتاد قال ابن لي صرحا",22,"ح",2,1],["فما أغبى الزمان بكل حرٍّ","وأقساه على أهل العلوم",23,"م",1,0],["فما اغتالَهُ شِصُّ الأماني بمَوعِدٍ","ولا رَهِبَ التهديدَ ممَّن تهدَّدا",24,"د",2,0],["فَما أَغنى صَليبٌ عَن قَتيلٍ","تحضّنه عَلى يَأس وَباسه",25,"س",2,0],["فما أغنوا غناءك في فقير","وهل يغني غناءك من عداكا",26,"ك",2,0],["فما اغنى تبجحه فتيلا","ولا وقّاه منقلب المصير",27,"ر",1,0],["فما أغنت الأَبدانَ درعٌ بها اكتستْ","ترائبُها مصقولةٌ كالسَّجنجل",28,"ل",1,0],["فما اغنت وقد تركت هواء","وآذن سمكها بالانهزام",29,"م",1,0],["فما أغنت وقد تركت هباءً","وآَذَنَ سمكها بالإنهدام",30,"م",1,0],["فما أغْنَى هَوى الدُّنيا نُفوسَاً","وما حَمَلَ الكَسِيحُ بِها كَسِيحَا",31,"ح",2,0],["فَمَا أغْفُو .. وَإِلَّاهُ بَجَفْنِيْ","وَلا أصْحُو .. وَإلَّاهُ نَهَارِيْ",32,"ر",2,0],["فَمَا أَغْلَقَ الْعُشَّاْقُ بَاْبَاً مِنَ الْهَوَىٰ","ثَلَاْثَاً بِشَبِّ النَّاْرِ تُعْيِي الْمَطَاْفِيَا",33,"ف",3,0],["فما أغناكَ عن ذلٍّ إليها","وقد تعفو بحُبٍّ لا اقتدارِ",34,"ر",1,0],["فما أغوتهُ أنصافُ الّليالي","وماضلّتْ خطاهُ إليهِ مَسرى",35,"ر",2,0]]}