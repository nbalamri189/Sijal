{"poems":[[53,"بقلبي للنوائب جانحات","https://www.aldiwan.net/poem30186.html","الوافر"],[88,"أرى بعد نوم طال في الشرق يقظة","https://www.aldiwan.net/poem44423.html","الطويل"],[88,"أخص في العلم إن أردت كمالا","https://www.aldiwan.net/poem44998.html","الخفيف"],[47,"أتعز أنت على رسوم مغان","https://www.aldiwan.net/poem25112.html","الكامل"],[72,"كل يوم سعادة مستهله","https://www.aldiwan.net/poem19475.html","الخفيف"],[51,"رجل وجهه كضرع المرد","https://www.aldiwan.net/poem11448.html","الخفيف"],[91,"هجرت القوافي ما بنفسي ملالة","https://www.aldiwan.net/poem9055.html","عموديه"],[70,"يا ثقيلا لي من رؤيته","https://www.aldiwan.net/poem42752.html","مجزوء الرمل"],[66,"لا تخش ياربع الحبيب همودا","https://www.aldiwan.net/poem41375.html","الكامل"],[31,"فجعتنا أم بشر","https://www.aldiwan.net/poem41858.html","مجزوء الرمل"],[105,"أبشر فذلك ما سألت قضاه","https://www.aldiwan.net/poem44207.html","الكامل"],[102,"قم حبيبي وأطفئ المصباحا","https://www.aldiwan.net/poem33110.html","الخفيف"],[21,"كل عيش وإن تطاول دهرا","https://www.aldiwan.net/poem36185.html","الخفيف"],[67,"يا أيها السيد الذي شهدت","https://www.aldiwan.net/poem18094.html","المنسرح"],[48,"الموت منا قريب","https://www.aldiwan.net/poem62538.html","المجتث"],[50,"سيدي خذ بي أتانا","https://www.aldiwan.net/poem24538.html","مجزوء الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85552","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[109,"خفض عليك مفندي","https://www.aldiwan.net/poem16462.html","مجزوء الكامل"],[115,"للّه اشكو ما اصاب فؤادي","https://www.aldiwan.net/poem41135.html","عموديه"],[121,"جف الكرى عكس الدموع معاً دما","https://www.aldiwan.net/poem23824.html","الكامل"],[132,"جعلت بيننا الرباب النمو ما","https://www.aldiwan.net/poem54747.html","الخفيف"],[169,"إلى كم مناجاة الهموم العوازب","https://www.aldiwan.net/poem1604.html",""],[178,"لا يعود بطانا","https://www.aldiwan.net/poem50698.html","المتقارب"],[185,"يا خليلي الهوى برح بي","https://www.aldiwan.net/poem14115.html","الرمل"],[186,"كل من أوليته خيرا","https://www.aldiwan.net/poem44073.html","مجزوء الرمل"],[204,"أبحت أبا الحسين صميم ودي","https://www.aldiwan.net/poem53359.html","الوافر"],[231,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[235,"مولاي مجد الدين يا","https://www.aldiwan.net/poem31794.html","مجزوء الرجز"],[235,"يا علو أغريت السهاد بناظري","https://www.aldiwan.net/poem32015.html","الكامل"],[237,"ما لمن مسه من الفقر داء","https://www.aldiwan.net/poem18031.html","الخفيف"],[237,"يا حسنه والحسن قيد","https://www.aldiwan.net/poem18133.html","مجزوء الكامل"],[252,"طرف المحب موكل بعذابه","https://www.aldiwan.net/poem1450.html",""],[271,"رد بالمطي موارد الغزلان","https://www.aldiwan.net/poem52069.html","الكامل"],[284,"مناي من دنياي هاتي التي","https://www.aldiwan.net/poem44307.html","السريع"],[320,"ما زلت لله أحمد","https://www.aldiwan.net/poem67168.html","المجتث"],[328,"كل حب مصيره اللذهاب","https://www.aldiwan.net/poem54963.html","الخفيف"],[349,"يا ذاهبا عني وما","https://www.aldiwan.net/poem15528.html","مجزوء الكامل"],[349,"لمغيب قلبي في هواكم مشهد","https://www.aldiwan.net/poem15644.html","الكامل"],[364,"أرغمت آنف حاسديك بسفرة","https://www.aldiwan.net/poem60682.html","الكامل"],[371,"ما في الأشل لباغضيه","https://www.aldiwan.net/poem56965.html","مجزوء الكامل"],[380,"يا مكثرا من ذم كل ذميم","https://www.aldiwan.net/poem48760.html","الخفيف"],[429,"ماست بلدن والأثيث تميم","https://www.aldiwan.net/poem41395.html","الكامل"],[441,"ليت الكفان الذي إن مت لي صنعا","https://www.aldiwan.net/poem14333.html","البسيط"],[441,"ألا كم مدع لله تائب","https://www.aldiwan.net/poem14349.html","الوافر"],[441,"وقيت ببردي ظهر جلدي على البرد","https://www.aldiwan.net/poem14365.html","الطويل"],[458,"صحا القلب لكن صبوة وحنين","https://www.aldiwan.net/poem55824.html","الطويل"],[458,"إذا لم يقرب منك إلا التذلل","https://www.aldiwan.net/poem56075.html","الوافر"],[458,"نشدتك يا بانة الأجرع","https://www.aldiwan.net/poem56118.html","المتقارب"],[458,"نرق وتقسو بالغوير قلوب","https://www.aldiwan.net/poem56279.html","الطويل"],[464,"شهرت علي صوارم العذل","https://www.aldiwan.net/poem3349.html","عموديه"],[477,"حي عني الحمى وحي المصلى","https://www.aldiwan.net/poem15265.html","الخفيف"],[500,"أزعج الليل الندامى","https://www.aldiwan.net/poem37800.html","مجزوء الرمل"],[500,"إطمس مشاهدك التي","https://www.aldiwan.net/poem37971.html","مجزوء الكامل"],[500,"شرافة الشوق لا زالت تطول إلى","https://www.aldiwan.net/poem38058.html","البسيط"],[538,"حذرته لو ينفع التحذير","https://www.aldiwan.net/poem48135.html","عموديه"],[551,"ما نحن إلا للفناء","https://www.aldiwan.net/poem48110.html","مجزوء الكامل"]],"verses":[["وَبَغَّضَني المَشيبُ إِلى لِداتي","وَهَوَّنَني البَقاءُ عَلى أُناسي",0,"ي",1,0],["وبغداد بين الأجنبيّ وبينها","مزيد صراع في السياسة مشتدّ",1,"د",1,0],["وبُغاة العلوم مثل رُماة الصيَ","د فاعلم وليس مُنْمٍ كمُصمْ",2,"م",1,0],["وَبَغى عَلى عَبسٍ حُذَيفَةَ فَاِشتَفَت","مِنهُ صَوارِمُهُم وَمِن ذُبيانِ",3,"ن",1,0],["وبغال مثل البروج تحمل","ن سعوداً بعينها مستقله",4,"ل",2,0],["وبغيض سبحانَه من بغيضٍ","وتعالى عن كل مِثْلٍ ونِدِّ",5,"د",1,0],["وَبَغَّضَني الأَشعارَ أَنَّ دُعاتَها","كَثيرٌ وَأَنَّ الصادِقينَ قَليلُ",6,"ل",1,0],["وَبَغيضاً هُوَ في الحَل","قِ شَجاً لَيسَ يَزولُ",7,"ل",1,0],["وَبَغوا فَوَكَّلتَ الحِمامَ بِحَربِهِم","ثُمَّ اِرتَضَيتَ لَهُ السُيوفَ جُنودا",8,"د",2,0],["وَبِغالاً مُلجَماتٍ","جَنَّبوها بِالجِلالِ",9,"ل",1,0],["وَبَغَوْا عليكَ فعذَّبوا الجسدَ الذي","ما للكرامةِ والنّعِيمِ سواهُ",10,"ا",2,0],["وَبَغى البينُ أَشهراً لا يُبالي","ما نُقاسيه صَبوَةً وَنحولا",11,"ل",2,0],["وَبُغاثَ اليَعفُرِ وَاليَعفُرَ النافِرُ","وَالعوهَجَ التُؤَامَ الضَئيلا",12,"ل",2,0],["وَبُغْيَتِي أنْ أَكُونَ سائِبَةً","مِنْ بَلَدِي في جَوانِبِ السَّاحِلْ",13,"ل",1,0],["وَبُغضُها لَكَ زَينٌ","وَحُبُّها لَكَ فاضِح",14,"ح",1,0],["وَبِغُنجٍ وَدَلالٍ","سَلَّ جِسمي وَبَراني",15,"ن",2,0],["وبغداد دار العلم قد أصبحت بهم","يهددها داء من الجهل معضل",16,"ل",1,0],["وَبِغَيْرِ قُرْبَى بَيْنَنَا","كُلٌّ إلى كُلٍّ قَرِيْبُ",17,"ب",1,0],["وَبِغُصن قامَتِهِ الرَطي","ب وَعَطفُهُ المُتَأود",18,"د",1,0],["وبغوا على الدين المبين فحربوا","احكامه بجهالة وعناد",19,"د",1,0],["وبغربة لا تصحبن مبطناً","فبطانة للسوء تذهب محرما",20,"م",2,0],["وبغربة لا تصحبن مذبذباً","فمذبذبٌ أفعى تنيب مسمما",20,"م",2,0],["وبغربة لا تصحبن مبذراً","إن المبذر للشياطين يُرْسَما",20,"م",2,0],["وبِغَورِ الغَدِيرِ في جَنبِهِ ال","غَربي حَيثُ العَرَاءُ عَرَّى الصَّرِيمَا",21,"م",2,0],["وَبُغضي لأَربابِ الخَنا وَمَودَّتي","لِكُلِّ أَبيِّ الضَّيمِ محضِ الضَرائِبِ",22,"ب",1,0],["وبغدادُ تجري الفرات دموعا","فقلب العراق دهتهُ الكروبُ",23,"ب",1,0],["وبغاثُ الطيرِ في أفنانها","آمنات من ذَوات المِخْلَب",24,"ب",1,0],["وبغى فاتركه والبغ","ي ترى رأيا صحيحا",25,"ح",2,0],["وبغضي للمشيب أعد عندي","كُميتاً لونه لونُ الخضابِ",26,"ب",1,0],["وَبَغى أَخو دوسٍ هِدايَةَ أمِّهِ","فَأَبَت فَأَقبَلَ مُستَهلّ الشانِ",27,"ن",1,0],["وَبَغَمَت عاطِفَةً","عَلى طَلاها مُغزِلُ",28,"ل",1,0],["وَبِغمَةٍ مِثلِ الشُموسِ عَوابِسٍ","خَلَطوا البَسالَةِ بِالجَمالِ الباهِرِ",29,"ر",1,0],["وَبِغَازِي خُطُوبِ مَنْ قَدْ أَتَاهُ","سَيِّدِي الْغَازِي مَنْ غَزَاهُ الثَّنَاءُ",30,"ا",2,0],["وَبُغَاثُهُ مُسْتَنْسِرٌ","وَسَرَاتُهُ سُرَّتْ بِجَدْجَدْ",31,"د",1,0],["وَبَغيت للآمال منهج رُشدها","فَمَضَت تُنافِسُ في حَثيث طِلابِهِ",32,"ب",2,0],["وَبَغيت غيثا مُستَعيرا جوده","من جود عَبد اللَه ذي الاحسان",33,"ن",1,0],["وَبَغلَةٌ شَهباءُ طَيّارَة","تَطوي لِيَ البُلدان في السيرِ",34,"ر",1,0],["وَبُغيَتي وَرَجائي","أَراهُ أَسنى وَأِسعَدُ",35,"د",1,0],["وبغير التقوى العزيز ذليل","وبها العبد مستعزُّ الجناب",36,"ب",1,0],["وَبِغَيرِ ذَنبٍ خُنتَني","وَزَعَمتَ أَنّي مُذنِبُ",37,"ب",1,0],["وَبَغَيرِ جَورِ العَدلِ لَم يَتَدَيَّنوا","وَعَلى سِوى غَيبِ العَمى لِم يَشهَدوا",38,"د",3,0],["وبغَيْرِ شُكْري نِعمةً بك جُدِّدَتْ","سِرّي وجَهْري بعدَها لم أَشغَل",39,"ل",1,0],["وبَغَى أشلُّ أخي القِحا","بِ يَخوضُ في عُجبٍ وتِيهِ",40,"ي",2,0],["وَبِغَير فهم في نَدي القَوم لا","تَنطق بِمَنثور وَلا مَنظوم",41,"م",1,0],["وبغيث معروف يروّي طالبا","وندا يديه بالجميل عميم",42,"م",1,0],["وبغض اللَه لي أعداك قاطبةً","والمدج فيهم وسوء الظن والبدعا",43,"ع",2,0],["وبغض للذي كانوا عليه","وحب للذي للَه واجب",44,"ب",1,0],["وبغض لي الدنيا بحبيك إنها","حبالة سوء تقبض الروح بالفرد",45,"د",1,0],["وبغدادُ تبكي والبُصَيرةُ تشتكي","وشعري نشيج عنهما ورنينُ",46,"ن",1,0],["وبغَّض خدّاً بالمشيب معنبراً","إليها عِذارٌ بالشبابِ مغلَّلُ",47,"ل",1,0],["وبغداد دارُ حقوقٍ عليك","متى ترعَ أيسرها تقنعِ",48,"ع",1,0],["وبغدادُ طلقٌ وجهُها مبتسِّمٌ","وللمُلكِ من بعد الخمودِ شُبوبُ",49,"ب",1,0],["وبغوا مع الوحش الهوامل في البي","داء واحترشوا مع الحسلِ",50,"ل",1,0],["وبغيضٌ اليَّ مَنْ ليس يدري","صنعةَ الشَّعرِ أن يكونَ مُدِلاّ",51,"ل",2,0],["وبَغى جَهلاً عَذولٌ","أَسمَعَ القَوْمَ مَلامَا",52,"م",2,0],["وبغيرِ قولِ المُصْطَفى","وكِتابِهِ لا يقْنَعُ",53,"ع",1,0],["وبُغيةٌ دونكُمْ خفَّتْ وفيكَ على","ميزانِها بينَ أربابِ النُّهى ثقُلتْ",54,"ت",1,0],["وبَغَى وما التَّاريخُ يَحفَظُ مِثلَه","بَغياً يُلاقي ويلَهُ المَغمورُ",55,"ر",1,0],["وبَغَوْا نجاءً حين سُد","دَتْ دونهم طُرُقُ النَّجاء",56,"ا",2,0]]}