{"poems":[[53,"بقلبي للنوائب جانحات","https://www.aldiwan.net/poem30186.html","الوافر"],[88,"أرى بعد نوم طال في الشرق يقظة","https://www.aldiwan.net/poem44423.html","الطويل"],[88,"أخص في العلم إن أردت كمالا","https://www.aldiwan.net/poem44998.html","الخفيف"],[47,"أتعز أنت على رسوم مغان","https://www.aldiwan.net/poem25112.html","الكامل"],[72,"كل يوم سعادة مستهله","https://www.aldiwan.net/poem19475.html","الخفيف"],[51,"رجل وجهه كضرع المرد","https://www.aldiwan.net/poem11448.html","الخفيف"],[91,"هجرت القوافي ما بنفسي ملالة","https://www.aldiwan.net/poem9055.html","عموديه"],[70,"يا ثقيلا لي من رؤيته","https://www.aldiwan.net/poem42752.html","مجزوء الرمل"],[66,"لا تخش ياربع الحبيب همودا","https://www.aldiwan.net/poem41375.html","الكامل"],[31,"فجعتنا أم بشر","https://www.aldiwan.net/poem41858.html","مجزوء الرمل"],[105,"أبشر فذلك ما سألت قضاه","https://www.aldiwan.net/poem44207.html","الكامل"],[102,"قم حبيبي وأطفئ المصباحا","https://www.aldiwan.net/poem33110.html","الخفيف"],[21,"كل عيش وإن تطاول دهرا","https://www.aldiwan.net/poem36185.html","الخفيف"],[67,"يا أيها السيد الذي شهدت","https://www.aldiwan.net/poem18094.html","المنسرح"],[48,"الموت منا قريب","https://www.aldiwan.net/poem62538.html","المجتث"],[50,"سيدي خذ بي أتانا","https://www.aldiwan.net/poem24538.html","مجزوء الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85552","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"]],"verses":[["وَبَغَّضَني المَشيبُ إِلى لِداتي","وَهَوَّنَني البَقاءُ عَلى أُناسي",0,"ي",1,0],["وبغداد بين الأجنبيّ وبينها","مزيد صراع في السياسة مشتدّ",1,"د",1,0],["وبُغاة العلوم مثل رُماة الصيَ","د فاعلم وليس مُنْمٍ كمُصمْ",2,"م",1,0],["وَبَغى عَلى عَبسٍ حُذَيفَةَ فَاِشتَفَت","مِنهُ صَوارِمُهُم وَمِن ذُبيانِ",3,"ن",1,0],["وبغال مثل البروج تحمل","ن سعوداً بعينها مستقله",4,"ل",2,0],["وبغيض سبحانَه من بغيضٍ","وتعالى عن كل مِثْلٍ ونِدِّ",5,"د",1,0],["وَبَغَّضَني الأَشعارَ أَنَّ دُعاتَها","كَثيرٌ وَأَنَّ الصادِقينَ قَليلُ",6,"ل",1,0],["وَبَغيضاً هُوَ في الحَل","قِ شَجاً لَيسَ يَزولُ",7,"ل",1,0],["وَبَغوا فَوَكَّلتَ الحِمامَ بِحَربِهِم","ثُمَّ اِرتَضَيتَ لَهُ السُيوفَ جُنودا",8,"د",2,0],["وَبِغالاً مُلجَماتٍ","جَنَّبوها بِالجِلالِ",9,"ل",1,0],["وَبَغَوْا عليكَ فعذَّبوا الجسدَ الذي","ما للكرامةِ والنّعِيمِ سواهُ",10,"ا",2,0],["وَبَغى البينُ أَشهراً لا يُبالي","ما نُقاسيه صَبوَةً وَنحولا",11,"ل",2,0],["وَبُغاثَ اليَعفُرِ وَاليَعفُرَ النافِرُ","وَالعوهَجَ التُؤَامَ الضَئيلا",12,"ل",2,0],["وَبُغْيَتِي أنْ أَكُونَ سائِبَةً","مِنْ بَلَدِي في جَوانِبِ السَّاحِلْ",13,"ل",1,0],["وَبُغضُها لَكَ زَينٌ","وَحُبُّها لَكَ فاضِح",14,"ح",1,0],["وَبِغُنجٍ وَدَلالٍ","سَلَّ جِسمي وَبَراني",15,"ن",2,0],["وبغداد دار العلم قد أصبحت بهم","يهددها داء من الجهل معضل",16,"ل",1,0],["وَبِغَيْرِ قُرْبَى بَيْنَنَا","كُلٌّ إلى كُلٍّ قَرِيْبُ",17,"ب",1,0]]}