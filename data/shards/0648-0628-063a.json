%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[6185,"نرجّيْكَ للجُلَى !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86943&r=&rc=3",""],[6199,"بغداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66252&r=&rc=5",""],[463,"نرقُّ وتقسو بالغوير قلوبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59978&r=&rc=34",""],[6305,"رؤى في أخريات الطريق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87346&r=&rc=19",""],[5190,"الحسناء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78290&r=&rc=4",""],[5190,"إطلالة على العام الجديد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78300&r=&rc=13",""]],"verses":[["وَبَغَّضَني المَشيبُ إِلى لِداتي","وَهَوَّنَني البَقاءُ عَلى أُناسي",0,"س",2,0],["وبغداد بين الأجنبيّ وبينها","مزيد صراع في السياسة مشتدّ",1,"د",1,0],["وبُغاة العلوم مثل رُماة الصيَ","د فاعلم وليس مُنْمٍ كمُصمْ",2,"م",1,0],["وَبَغى عَلى عَبسٍ حُذَيفَةَ فَاِشتَفَت","مِنهُ صَوارِمُهُم وَمِن ذُبيانِ",3,"ن",1,0],["وبغال مثل البروج تحمل","ن سعوداً بعينها مستقله",4,"ل",2,0],["وبغيض سبحانَه من بغيضٍ","وتعالى عن كل مِثْلٍ ونِدِّ",5,"د",1,0],["وَبَغَّضَني الأَشعارَ أَنَّ دُعاتَها","كَثيرٌ وَأَنَّ الصادِقينَ قَليلُ",6,"ل",1,0],["وَبَغيضاً هُوَ في الحَل","قِ شَجاً لَيسَ يَزولُ",7,"ل",1,0],["وَبَغوا فَوَكَّلتَ الحِمامَ بِحَربِهِم","ثُمَّ اِرتَضَيتَ لَهُ السُيوفَ جُنودا",8,"د",2,0],["وَبِغالاً مُلجَماتٍ","جَنَّبوها بِالجِلالِ",9,"ل",1,0],["وَبَغَوْا عليكَ فعذَّبوا الجسدَ الذي","ما للكرامةِ والنّعِيمِ سواهُ",10,"ا",2,0],["وَبَغى البينُ أَشهراً لا يُبالي","ما نُقاسيه صَبوَةً وَنحولا",11,"ل",2,0],["وَبُغاثَ اليَعفُرِ وَاليَعفُرَ النافِرُ","وَالعوهَجَ التُؤَامَ الضَئيلا",12,"ل",2,0],["وَبُغْيَتِي أنْ أَكُونَ سائِبَةً","مِنْ بَلَدِي في جَوانِبِ السَّاحِلْ",13,"ل",1,0],["وَبُغضُها لَكَ زَينٌ","وَحُبُّها لَكَ فاضِح",14,"ح",1,0],["وَبِغُنجٍ وَدَلالٍ","سَلَّ جِسمي وَبَراني",15,"ن",2,0],["وبغداد دار العلم قد أصبحت بهم","يهددها داء من الجهل معضل",16,"ل",1,0],["وَبِغَيْرِ قُرْبَى بَيْنَنَا","كُلٌّ إلى كُلٍّ قَرِيْبُ",17,"ب",1,0],["وَبِغُصن قامَتِهِ الرَطي","ب وَعَطفُهُ المُتَأود",18,"د",1,0],["وبغوا على الدين المبين فحربوا","احكامه بجهالة وعناد",19,"د",1,0],["وبغربة لا تصحبن مبطناً","فبطانة للسوء تذهب محرما",20,"م",2,0],["وبغربة لا تصحبن مذبذباً","فمذبذبٌ أفعى تنيب مسمما",20,"م",2,0],["وبغربة لا تصحبن مبذراً","إن المبذر للشياطين يُرْسَما",20,"م",2,0],["وبِغَورِ الغَدِيرِ في جَنبِهِ ال","غَربي حَيثُ العَرَاءُ عَرَّى الصَّرِيمَا",21,"م",2,0],["وَبُغضي لأَربابِ الخَنا وَمَودَّتي","لِكُلِّ أَبيِّ الضَّيمِ محضِ الضَرائِبِ",22,"ب",1,0],["وبغدادُ تجري الفرات دموعا","فقلب العراق دهتهُ الكروبُ",23,"ب",1,0],["وبغاثُ الطيرِ في أفنانها","آمنات من ذَوات المِخْلَب",24,"ب",1,0],["وبغى فاتركه والبغ","ي ترى رأيا صحيحا",25,"ح",2,0],["وبغضي للمشيب أعد عندي","كُميتاً لونه لونُ الخضابِ",26,"ب",1,0],["وَبَغى أَخو دوسٍ هِدايَةَ أمِّهِ","فَأَبَت فَأَقبَلَ مُستَهلّ الشانِ",27,"ن",1,0],["وَبَغَمَت عاطِفَةً","عَلى طَلاها مُغزِلُ",28,"ل",1,0],["وَبِغمَةٍ مِثلِ الشُموسِ عَوابِسٍ","خَلَطوا البَسالَةِ بِالجَمالِ الباهِرِ",29,"ر",1,0],["وَبِغَازِي خُطُوبِ مَنْ قَدْ أَتَاهُ","سَيِّدِي الْغَازِي مَنْ غَزَاهُ الثَّنَاءُ",30,"ا",2,0],["وَبُغَاثُهُ مُسْتَنْسِرٌ","وَسَرَاتُهُ سُرَّتْ بِجَدْجَدْ",31,"د",1,0],["وَبَغيت للآمال منهج رُشدها","فَمَضَت تُنافِسُ في حَثيث طِلابِهِ",32,"ب",2,0],["وَبَغيت غيثا مُستَعيرا جوده","من جود عَبد اللَه ذي الاحسان",33,"ن",1,0],["وَبَغلَةٌ شَهباءُ طَيّارَة","تَطوي لِيَ البُلدان في السيرِ",34,"ر",1,0],["وَبُغيَتي وَرَجائي","أَراهُ أَسنى وَأِسعَدُ",35,"د",1,0],["وبغير التقوى العزيز ذليل","وبها العبد مستعزُّ الجناب",36,"ب",1,0],["وَبِغَيرِ ذَنبٍ خُنتَني","وَزَعَمتَ أَنّي مُذنِبُ",37,"ب",1,0],["وَبَغَيرِ جَورِ العَدلِ لَم يَتَدَيَّنوا","وَعَلى سِوى غَيبِ العَمى لِم يَشهَدوا",38,"د",3,0],["وبغَيْرِ شُكْري نِعمةً بك جُدِّدَتْ","سِرّي وجَهْري بعدَها لم أَشغَل",39,"ل",1,0],["وبَغَى أشلُّ أخي القِحا","بِ يَخوضُ في عُجبٍ وتِيهِ",40,"ي",2,0],["وَبِغَير فهم في نَدي القَوم لا","تَنطق بِمَنثور وَلا مَنظوم",41,"م",1,0],["وبغيث معروف يروّي طالبا","وندا يديه بالجميل عميم",42,"م",1,0],["وبغض اللَه لي أعداك قاطبةً","والمدج فيهم وسوء الظن والبدعا",43,"ع",2,0],["وبغض للذي كانوا عليه","وحب للذي للَه واجب",44,"ب",1,0],["وبغض لي الدنيا بحبيك إنها","حبالة سوء تقبض الروح بالفرد",45,"د",1,0],["وبغدادُ تبكي والبُصَيرةُ تشتكي","وشعري نشيج عنهما ورنينُ",46,"ن",1,0],["وبغَّض خدّاً بالمشيب معنبراً","إليها عِذارٌ بالشبابِ مغلَّلُ",47,"ل",1,0],["وبغداد دارُ حقوقٍ عليك","متى ترعَ أيسرها تقنعِ",48,"ع",1,0],["وبغدادُ طلقٌ وجهُها مبتسِّمٌ","وللمُلكِ من بعد الخمودِ شُبوبُ",49,"ب",1,0],["وبغوا مع الوحش الهوامل في البي","داء واحترشوا مع الحسلِ",50,"ل",1,0],["وبغيضٌ اليَّ مَنْ ليس يدري","صنعةَ الشَّعرِ أن يكونَ مُدِلاّ",51,"ل",2,0],["وبَغى جَهلاً عَذولٌ","أَسمَعَ القَوْمَ مَلامَا",52,"م",2,0],["وبغيرِ قولِ المُصْطَفى","وكِتابِهِ لا يقْنَعُ",53,"ع",1,0],["وبُغيةٌ دونكُمْ خفَّتْ وفيكَ على","ميزانِها بينَ أربابِ النُّهى ثقُلتْ",54,"ت",1,0],["وبَغَى وما التَّاريخُ يَحفَظُ مِثلَه","بَغياً يُلاقي ويلَهُ المَغمورُ",55,"ر",1,0],["وبَغَوْا نجاءً حين سُد","دَتْ دونهم طُرُقُ النَّجاء",56,"ا",2,0],["وبغيرها تغدو الحياة جحيمنا","فيها الشفا وتأجج اليران",57,"ن",1,0],["وبغير هام لا نحرك ساكنا","وبغير هام فالجسوم رمام",58,"م",1,0],["وَبغبطة في دَولة","مَأمونها بِكَ أَعرف",59,"ف",1,0],["وبِغَسْلِ أقذارِ الكِلاب تَحرُّفِي","في أكثر الأوقاتِ والأزمانِ",60,"ن",1,0],["وبغيضٌ إليَّ عيشي وقد أع","رضتِ عني وسؤددي واشتهاري",61,"ر",2,0],["وبغى على العقبان عاتٍ عاصفٌ","أعياهمُ بأساً وطال جماحا",62,"ح",2,0],["وبُغَاثُ الطير تصطا","دُ الشياهين وتجرحْ",63,"ح",1,0],["وبغدادُ أبعدُ مما تكون","أمدّ يَدي نحوَها جَدولا",64,"ل",2,0],["وَبغداد ُ.. بغدادُ أشكو لها","شكاة َالجزوع ِإلى الأجْزَعِ",65,"ع",1,0],["وَبَغدَاد ُأبْعَد ُمِمَّا أراه","وَأقرَبُ للعَيْن ِمن أدمُعِي",65,"ع",2,0],["وبغير الوصل لا سكنت","زفرة ترقى على سكنِ",66,"ن",1,0],["وبغوا له كيداً فكان له إلى","درك الذرى من أوكد الأسباب",67,"ب",1,0],["وبغبطة علياء فايقه الزكا","وتفقّه مستحكم الآراءِ",68,"ا",2,0],["وبغصبهم قد كاكم اقتسمت لهم","حججا تلوح قلائدا برقابها",69,"ب",3,0],["وبغير صوان وصنوان حكت","جيش البلاد كتائبا وبنودا",70,"د",2,0],["وَبِغَيرِ الخَيرِ لا زا","لَ قُيَيسُ بنُ الزُّبَيرِ",71,"ر",1,0],["وبغضتُ بين الحاسدينَ ولم يزل","ذلو الفضل عند الناقصين بغيضَا",72,"ض",2,0],["وَبِغِبْطَةٍ خَصُّوا الَّذِينَ قُلُوبُهُمْ","مُلِئَتْ بِمَحْضِ الحُبِّ لِلْخُصَّاصِ",73,"ص",1,0],["وبغرة سفرت بغيهب طرة","فبدت تباشير الصباح الأبلج",74,"ج",1,0],["وَبَغدادُ لَو هَتَفَت بي هَلُمَّ","هلُمَّ لما كُنتُ مِمَّن يُلَبّي",75,"ي",1,0],["وَبِغَيرِ مَعرِفَةٍ وَلا نَسَبٍ","أَنّى وَشَعبُكَ لَيسَ مِن شَعبي",76,"ب",2,0],["وبغير بأسك ما ارعوت أبطالها","لما استقر بحجرها العصيان",77,"ن",1,0],["وبغصنه رمانتان عليهما","حيات فرع ضل فيها الساري",78,"ر",2,0],["وَبَغيضٍ صَعبِ الشَكيمَةِ قاسٍ","وَحَبيبٍ سَهلِ المِراسِ حَنونِ",79,"ن",1,0],["وبغاث قد غدا مستنسرا","فيه واصطاد به الصقرُ الأسَد",80,"د",1,0],["وبغداد وسامرا","وباخمرى على السكر",81,"ر",1,0],["وبغر نوابت في سدوس","ضحكة البرق في سواد الغيوم",82,"م",1,0],["وَبَغَيتُمُ أن تَنسِبُوا للابتِدَا","عِ عَسَاكِرَ الآثارِ والقُرآنِ",83,"ن",1,0],["وبغض احدى مقلتيه اذا رنا","وارى الجفون وسيفها المسلولا",84,"ل",2,0],["وَبِغَير طاعتك القَضا لَم يَأخذ","وَالدَهر مره بِما تَشاء يَنفذ",85,"ذ",1,0],["وَبِغَير أَمر اللَه قامَ مُحكَماً","بِالمُسلِمين يَزيد وَهُوَ أَمير",86,"ر",1,0],["وَبَغى بِها ماءَ النِطافِ فَلَم يَجِد","ماءاً بِتَنهِيَةٍ وَلا بِعِمارِ",87,"ر",1,0],["وَبَغَى عَلَيها مِن وُلاةِ أُمُورِها","مَن لا يُبالِي إِن عَرَاهُ العارُ",88,"ر",1,0],["وبغالهم وجمالهم وسلاحهم","ولباسهم ونفيسهم والأصفرا",89,"ر",2,0],["وبغض لي كبير الهم أني","به أنسى الصغار من الهموم",90,"م",1,0],["وَبَغياً عَلى الجارِ القَريبِ إِذا طَرا","عَلَيكُم وَخَتلَ الراكِبِ المُتَفَرِّدِ",91,"د",1,0],["وبغرفة من نافع لتفاؤلٍ","واللهِ عزَّ وجلَّ ليس بنافعِ",92,"ع",1,0],["وبغداد بحر ساحلاه جواهر","ودجلة روض طرتاه شقيق",93,"ق",1,0],["وَبَغوا فاستدالَ منهم لكَ الل","هُ وأَعطاكَ أَفْضَلَ الآمَالِ",94,"ل",1,0],["وبغيبة الخلف المهذب خائفاً","درست شريعته وهد دعامها",95,"م",3,0],["وبغيرِ سُمٍّ قاتلٍ وصوارمٍ","وعِقابِ رَبٍّ لَيسَ يَغفُلُ عن أَحَد",96,"د",1,0],["وَبِغَيرِ صَرحِ الدّينِ عِندَ اليَأسِ لا","تَجِد النُّفوسُ معاذَها مَأنوسا",97,"س",2,0],["وبَغرَةُ أ