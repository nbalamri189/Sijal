ُ","https://www.poetsgate.com/ViewPoem.aspx?id=188891",""],[5353,"صدى صمتي","https://www.poetsgate.com/ViewPoem.aspx?id=212457",""],[5410,"فحضارة الإسلام حصن صامد","https://www.poetsgate.com/ViewPoem.aspx?id=73563",""],[5431,"ما أحيلاهُ الوصال","https://www.poetsgate.com/ViewPoem.aspx?id=183043",""],[5431,"كم ساقني نور الصباح لمقلتيهْ","https://www.poetsgate.com/ViewPoem.aspx?id=183633",""],[5431,"فحضنت قلبك حانيا ..ومضيتُ..","https://www.poetsgate.com/ViewPoem.aspx?id=191815",""],[5582,"لِمَنْ المَنازِلُ بِالصَّفِيحَةِ تُعْرَفُ","https://www.poetsgate.com/ViewPoem.aspx?id=187184",""],[243,"ذبول أزهار الدفلى","https://www.poetsgate.com/ViewPoem.aspx?id=50480",""],[5691,"خمسون عاماً...!","https://www.poetsgate.com/ViewPoem.aspx?id=206746",""],[5717,"لم تحي بامرء في سمع وفي بصر","https://www.poetsgate.com/ViewPoem.aspx?id=170587",""],[3856,"كَم زَفرةٍ أوشَكَتْ أن تُرمِدَ الحَطَبا","https://www.poetsgate.com/ViewPoem.aspx?id=215915",""],[5908,"هب الصبا إن هب أو تنفسا","https://www.poetsgate.com/ViewPoem.aspx?id=170974",""],[5937,"إلى شاعرٍ في الرُكن","https://www.poetsgate.com/ViewPoem.aspx?id=211897",""],[5956,"أخشَى أموتُ ولا أراك بجانبي","https://www.poetsgate.com/ViewPoem.aspx?id=193713",""],[5956,"اللغة العربية الفصحى ولهجاتها العامية","https://www.poetsgate.com/ViewPoem.aspx?id=202206",""],[5992,"البِيضُ أخلقُ بالفتى والأسمرُ","https://www.poetsgate.com/ViewPoem.aspx?id=41819",""],[6102,"الحب في الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=182875",""]],"verses":[["كَم زَفرَةٍ خَرساءَ","مُتَمَسِّكاً بِعَلائِقِ الأَجرِ",0,"ر",1,0],["كَمَزلَقَةِ الذُبابِ إِذا أُمِرَّت","عَلى ذي الداءِ بالِغَتِ الوِداجا",1,"ج",2,0],["كَم زَفرَةٍ ضَعُفَت فَصارَت أَنَّةً","تَمَّمتُها بِتَنَفُّسِ الصُعَداءِ",2,"ا",2,0],["كمْ زُرْتُها بنِجادِ السّيْفِ مُشْتَمِلاً","والنّجْمُ في الأُفُقِ الغَرْبيّ حَيْرانُ",3,"ن",1,0],["كم زنت قرطاساً بآياته","بين شتيت باهرٍ أو جميع",4,"ع",1,0],["كم زفرة بين الجوانح ما ارتقت","حَذَرَ الرقيب ومدمع لم يُسجمِ",5,"م",1,0],["كم زارني معروفُه","من قبلِ وعدٍ بالْتِقاءِ",6,"ق",3,0],["كم زخرفَ القولَ من زورٍ وَلبَّسَهُ","على العقول ولكنْ قلَّما لَبِثَا",7,"ث",2,0],["كم زفرةٍ لي تبيت تُنهض أح","شائي ودمعٍ عليك منبجِس",8,"س",1,0],["كم زوَّجتني بدأةٌ منهمُ","وقالتْ العودة لي أعرِس",9,"س",1,0],["كم زاحم الدهر فوق مدحضة","زلج فما زل عن زحالقها",10,"ق",3,0],["كم زفرةٍ لي ملءَ الصدرِ حينئذ","عن حسرةٍ في ضمير القلب أطويها",11,"ي",3,0],["كَم زَهرَةٍ في السَفحِ خادِرَةِ المُنى","سَكَنَت عَلى يَأسٍ سُكونَ الجَلمَدِ",12,"د",1,0],["كَم زُرنَها وَالحَيُّ مُنتَبِهٌ","وَتَرَكتُها وَالحَيُّ قَد هَجَدا",13,"د",2,0],["كَم زَهِدنا بِثَروَةٍ مِن نُضارٍ","وَقَنِعنا بِثَروَةٍ مِن أَماني",14,"ن",2,0],["كَم زَفرَةٍ مِن شِغافِ القَلبِ صاعِدَة","وعَبرة مِن شؤون العين تَنحَدِرُ",15,"ر",1,0],["كم زار منك نظامنا","جرمٌ يجدّ السير دائب",16,"ب",1,0],["كَم زَورَةٍ لَكَ في الأَعرابِ خافِيَةٍ","أَدهى وَقَد رَقَدوا مِن زَورَةِ الذيبِ",17,"ب",1,0],["كَم زَمانٍ بَكَيتُ مِنهُ قَديماً","ثُمَّ لَمّا مَضى بَكَيتُ عَلَيهِ",18,"ي",2,0],["كم زفرة في الضلوع قرّت","يحوطها هيكلٌ مريض",19,"ض",1,0],["كم زهرةٍ تضحكُ في كمِّها","ونسمةٍ تعثُر في ذيلها",20,"ه",2,0],["كَمُزيلٍ رِجلَيهِ عَن بَلَلِ القَط","رِ وَما حَولَهُ مِنَ الأَرضِ بَحرُ",21,"ر",1,0],["كَم زالَ جيلٌ وَهَذي الأَرضُ باقِيَةٌ","ما هَمَّ بِالزيغِ مِن أَوتادِها وَتَدُ",22,"د",1,0],["كم زارني والدّجى يَرْبدّ من حَنَقٍ","والزهْرُ تبسِمُ عن وَجْهِ الذي عَبَسَا",23,"س",2,0],["كَمْ زُرْتُهُ فِي يَقْظَةٍ","وَأَلَمَّ بِي فِي مَهْجَعِ",24,"ع",1,0],["كم زَهْرةٍ عَلِقَتْ بفَضْلِ رِدَائه","فالوردُ مِلءُ ردائِه والعَبْهر",25,"ر",1,0],["كَمْ زَانَ مِنْ مُلْكٍ كَمَا ازْ","دَانَ الْمُهَنَّدِ بِالْفِرِنْدِ",26,"د",1,0],["كم زُيْنَ اسمٌ بألقاب مكدَّسة","وقد تجرَّد من زَيْن مُسماه",27,"ا",2,0],["كم زيجةٍ مازال يدمَى جرحها","ومن الجروح: ذوابلٌ ودوامي!",28,"م",2,0],["كم زان سيفٌ مِعْصَما","كانت تزيَّنُه الأساور",29,"ر",1,0],["كم زفرة لنعي ما أذنت لها","ولا مشفعة من صارخ صحل",30,"ل",1,0],["كم زرتها والحيّ منبته","وتركتها والحيّ قد هجدا",31,"د",2,0],["كَم زَفْرَةٍ في شِغافِ القَلبِ صاعِدَةٍ","وعَبرةٍ مِن شؤون الدَّهر تَنحَدِرُ",32,"ر",1,0],["كَم زارَ غَيرَكَ وَهوَ مُغضٍ سادِمٌ","وَأَتاكَ يَمشي مِشيَةَ المُختالِ",33,"ل",1,0],["كَمْ زفراتٍ وكم دُمُوع","هذا لَعَمري هُوَ القُطُوعُ",34,"ع",1,1],["كَمَزَايا خَلائِقٍ لأَبي القا","سِمِ فينا مُنِيرَةِ الأَنْوارِ",35,"ر",1,0],["كم زف نحوى جوده عروسه","ليس سوى الشكر لها من مهر",36,"ر",1,0],["كَم زبيَةٍ حَفَرَت لَها يَدُ كاشِحٍ","يَبغي لَها الأَسواءَ في غَفَلاتِها",37,"ت",3,0],["كم زورةٍ ليَ بالزوراءِ خُضْتُ بها","عُبابَ بحرٍ من الليلِ الدجوجيِّ",38,"ي",1,1],["كم زَورةٍ لي تحت ذاك المرقِد","في حَيّ سهم بالظلام مُرْتَدِ",39,"د",1,0],["كم زهرةٍ تذوي وتحملُ عرفَها","هبّاتُ ليلٍ ساكنٍ تُحيينا",40,"ن",2,0],["كم زحفةٍ زحف الرشيدُ بجيشهِ","حتى الخليجِ ودونَه الإزباد",41,"د",1,0],["كم زحفةٍ لعلوجِ الرومِ أوقفَها","سلاحُ جيشِكِ أو أشلاء قَتلاك",42,"ك",1,0],["كم زفرةٍ عند إِدبارِ النجومِ إِذا","صعَّدتها خلتُ مَعْها النفسَ تنتزع",43,"ع",1,0],["كم زهرةٍ رفّتْ فخلت فراشةً","بيضاءَ رفَّ جناحُها بترفق",44,"ق",1,0],["كم زان أرضا أقفرت","ووجنةً مزخرفه",45,"ف",2,0],["كم زارني والثريا يلوها قمرٌ","والليل منسدلُ الأذيال والطنب",46,"ب",1,1],["كم زرتُهم وحُماةُ الحَيِّ مانعةٌ","للبيضِ بالبيض أو للسُّمْر بالسُّمُر",47,"ر",1,0],["كَم زِقّ خَمرٍ فيهِمُ ناطِقٍ","سَكرانَ بَل راجيهِ سَكرانُ",48,"ن",1,0],["كَم زورة لي وَاعتِنا","ق تَحتَ أَستار الظَلام",49,"م",1,0],["كَم زارَني وَجلاً وَاللَيل يَسترنا","عَن الرَقيب وَتَخفينا غَواشيهِ",50,"ي",2,0],["كَم زارَني جَنح الدُجى وَجَلا","تَهفو جَوانِحُهُ مِن الذُعر",51,"ر",1,0],["كم زَرْتُ حضرتَك الَّتي","ما زلتُ منها في حبور",52,"ر",1,0],["كم زعيم مسخّر شرفه","بات أقصى خلاصه تلفه",53,"ف",2,1],["كم زورةٍ على الغضا تأذَنُ لي","فيها بيوتٌ لم تصِلْ زُوّارُها",54,"ر",3,0],["كم زورةٍ نطق النطاق فصاحةً","فيها رحمتُ لها السوار الألكنا",55,"ن",2,0],["كم زورةٍ كان الظلام مؤازري","فيها وثغرُ الصبح فيه منافسي",56,"س",2,0],["كم زورةٍ تمّتْ بها أنفاسها","وكفى العبيرُ محدّثاً أنْ يعبقا",57,"ق",2,0],["كَم زَرَعنا ، وَكَم سَقى دَمُنا","وَسَهرْنا حتى ذوَى الكَبِد ُ",58,"د",1,0],["كم زودته شيوخها بدعائها","والفضل منه لم يكن معدوما",59,"م",2,0],["كم زارني وأنا البعيدُ عن النّدى","مِنْ سَيْبِ كفّكِ مِن لُهاً وأيادِ",60,"د",1,0],["كَم زَلزَلَ اللَهُ مِن قَومٍ لِكُفرِهِم","قَدَماً وَأَهلُكَ جيلٌ قَبلَهُ جيلُ",61,"ل",1,0],["كَم زاعَمَتكَ مُلُوكٌ وَهيَ وادِعَةٌ","أمناً فَها هيَ شَتَّى أمنُها فَرقُ",62,"ق",1,0],["كم زاد رونقُها بما نسَّقتهُ","وزها محيَّاها بما نقحتهُ",63,"ت",2,0],["كم زَهرَةً ترنو لتش","هدَ سَيح زُهرٍ تحت ماء",64,"ا",2,0],["كم زار مبتسما ليلا فقلت له","وبارق الثغر يغزو عسكر الدجن",65,"ن",1,0],["كَم زَيَّن القَومُ في حُمرِ الثّيابِ كَما","حَلّى نِساءَهُم بِالنيل والسُّلُبِ",66,"ب",1,0],["كَمْ زمانٍ مضَى بها مُسْتَلَذٍّ","لَيْلنُا فيه مثلُ لَيْل الحَزِيز",67,"ز",1,0],["كم زفرةِ بالصدر تلفحُ جمرة","لولا الرَّقيبُ لأخمدت بدموع",68,"ع",1,0],["كم زفرة لي في هوا","ك تقصّ أَثناء الجوانح",69,"ح",1,0],["كَمْ زِدْتَ فِي نقصك العليا جَوَى كَبِدٍ","حَرَّى فَيَا لَيْتَ لم تُنْقِصْ وَلم تَزِدِ",70,"د",1,0],["كَم زلزلت صولاتهُ لعداتهِ","حصناً فَأمسى وهي قاعٌ صفصفُ",71,"ف",1,0],["كَم زَلزلت أرضَهم لمّا بطشتَ بهم","كأنَّ بَطشَك فيهم نفخة الصورِ",72,"ر",1,0],["كم زفرة تبعتها بزفرة","تكاد منها الصخر أن يلينا",73,"ن",2,0],["كَمْ زارَهُ شاكياً جَوْرَ الزَّمانِ أَخو","ذِلِّ فعادَ بتاجِ العزِّ مُعْتَصِبا",74,"ب",2,0],["كم زلة أعفيتها بالمرسلا","ت من رياح العفو عن عبد جنى",75,"ا",1,0],["كم زَفرة في الحشا تُصعدِّها","وعبْرةٍ في العذار يسكبها",76,"ب",3,0],["كم زرتُكَ في ليلٍ داجٍ","فيه للأنجم تَخْفاق",77,"ق",1,0],["كم زادَني العذلُ وُلوعاً بها","ما أولعَ النفسَ بقتَّالها",78,"ل",3,0],["كم زُرتُه فرأيت الأرضَ قد جُمعت","في مجلسٍ لفتىً في استوى البَشر",79,"ر",1,0],["كَم زفرة كم عبرة كم صرخة","كَم صعقة منعت لَذيذ مذاق",80,"ق",1,0],["كم زفرةٍ تَسْتَعيرُ النارُ وَقْدَتَها","ولوعةٍ طَيَّ أضْلاعي تُناجيني",81,"ن",2,0],["كم زارني والدجى يربد من حنق","منا فأشعل في ظلمائه قبسا",82,"س",2,0],["كَم زَوجَةٍ سَلَبَتها زَوجَها فَغَدَت","عَلى الطوى وَالأَسى وَالسُقم وَالضَجَرِ",83,"ر",1,0],["كم زوى من عظيمة عن حمى الد","ين ولولاه لم تجد من زواها",84,"ا",3,0],["كم زرتها والليل ضاف برده","وبه النجوم سواطع لنوارها",85,"ر",3,0],["كم زئير سمعت ساستها","ومواء حسبوا لايسمعون",86,"ن",1,0],["كم زلزلت بالجياد العادياتِ لهُ","أرضٌ بقارعَةِ التخويف منتشِرَه",87,"ر",2,0],["كم زرت أجداث الأحبة منشداً","شعري فحركها صدى الإنشاد",88,"د",1,0],["كم زاد عن شرف البلاد وكم سطا","في الخطب فانهزمت جيوشُ ظلامهِ",89,"م",2,0],["كَم زَجَرناهُم عَنِ السُحتِ فَلَن","يَعرِفوا مِن دونِهِ مُنتَجَعا",90,"ع",2,0],["كَم زَرَعنا وَكَم حَصَدنا حُقولا","لَم يَصِلنا مِن ريعِهِنَّ نَقيرُ",91,"ر",1,0],["كم زَوّروا الزُخرفَ في خِلافهم","تالله لا أمرٌ هُنالكَ اقتَضى",92,"ض",2,0],["كم زانهم طيبُ أخلاقِ بها عبقت","أريجُ أخلاقِ طاها سيِّد الرُسل",93,"ل",1,0],["كَم زارَ في راحه صاحٍ فأسكره","وَمرَّ في راحهِ ذُو سَكرة فَصَحا",94,"ح",2,0],["كَم زَلَّةٍ من كَريمٍ ظَلَّ يَسترُها","مِن دونها سُتُرُ الأبوابِ والكِلَلُ",95,"ل",1,0],["كم زرتهُ ورواق الليل منسدِلٌ","مسهّمٌ راق إعجاباً بأنجمِهِ",96,"ه",1,1],["كمْ زرتُه لابتغاءٍ جودٍ","فكانَ لي مُطْعماً وكاسي",97,"س",2,0],["كَم زَجَرَ الوالِي بِهِ","مِن خائِنٍ مُختَلسِ",98,"س",1,0],["كم زاحمته سيوف الفاتحين فكا","ن النصر يأتيه مكفولا من العطب",99,"ب",1,0],["كم زيّنت رحبات الدرس طلعتهُ","واِنهالَ وارفهُ للخيرِ واِنسَكبا",100,"ب",2,0],["كم زارع لراقدٍ قد أكَلاَ","ومُوقدٍ ناراً وغيرُه اصْطَلى",101,"ل",2,0],["كم زنت بالحلي كفا","وزنت بالحلي نحرا",102,"ر",2,0],["كم زها الظل على الزهرة","في الصبح وراق",103,"ق",1,0],["كم زجّ إصبع بعضهم في عينها","وهمُ الذين قد استقوا إحسانها",104,"ن",3,0],["كَم زمن قضّيته بالحمى","بذكره لذَّ فمُ الذاكِرِ",105,"ر",1,0],["كم زوجة أذوى الفراق فؤادها","نعمت برؤية زوجها المفقود",106,"د",1,0],["كمزؤود تروعه","ليال ما لها فجر",107,"ر",1,0],["كم زهور جمّعتها وعطور","سرقتها الحياة لم تبق شيّا",108,"ي",2,0],["كم زرتهم أينما حلت ركائبهم","بطائف من لسان الحال جوالِ",109,"ل",1,0],["كم زرت حيّك ضاحكاً في ساعة","لسّاعة يبكي بها ضرغامها",110,"م",3,0],["كَم زادَهم مِن غارة ملموسةٍ","بِالقبِّ تعطب والأسنّة تلمعُ",111,"ع",1,0],["كم زَخرَفَت وَجنات طرسى أَنملى","بعذار خط أَواهاب شَباب",112,"ب",1,0],["كم زرتهموا في الكرى طيفاً واحسبني","للسقم لو زرتهم شخصاً لما فرقوا",113,"ق",3,0],["كم زنت مرتبة رأيتهم زمناً","وكم ق