{"poems":[[53,"أوما رأيت وقائع الدهر","https://www.aldiwan.net/poem30444.html","الكامل"],[53,"أداري المقلتين عن ابن ليلى","https://www.aldiwan.net/poem30660.html","الوافر"],[53,"أبكيك لو نقع الغليل بكائي","https://www.aldiwan.net/poem30779.html","الكامل"],[63,"تلك الحدوج يراعيهن غيران","https://www.aldiwan.net/poem46159.html","البسيط"],[93,"علمتني الخط فما راعني","https://www.aldiwan.net/poem11080.html","السريع"],[83,"أللمحة من بارق متبسم","https://www.aldiwan.net/poem54240.html","الكامل"],[51,"ما أستزيد لقاسم من ربه غير البقاء","https://www.aldiwan.net/poem7960.html","مجزوء الكامل"],[51,"يا مادح الحقد محتالا له شبها","https://www.aldiwan.net/poem9213.html","البسيط"],[51,"زارت على غفلة من الحرس","https://www.aldiwan.net/poem64675.html","المنسرح"],[51,"ما رشأ الأنس بمستأنس","https://www.aldiwan.net/poem64702.html","الطويل"],[51,"يا نجدة الروم في بطارقها","https://www.aldiwan.net/poem65502.html","المنسرح"],[51,"نبكي الشباب لحاجات النساء ولي","https://www.aldiwan.net/poem66769.html","البسيط"],[91,"يا أيها الشادي المغرد في الضحى","https://www.aldiwan.net/poem8797.html","عموديه"],[91,"قالت سكت وما سكت سدى","https://www.aldiwan.net/poem8813.html","عموديه"],[91,"ما لقلبي يلج من الخفقان","https://www.aldiwan.net/poem62761.html","عموديه"],[78,"سكن فؤادك لا تذهب به الفكر","https://www.aldiwan.net/poem14154.html","البسيط"],[89,"ماذا برقراق السحائب","https://www.aldiwan.net/poem44965.html","مجزوء الكامل"],[43,"من الجآذر في زي الأعاريب","https://www.aldiwan.net/poem9507.html","البسيط"],[49,"أن بالله وحده وإليه","https://www.aldiwan.net/poem63179.html","الطويل"],[97,"مكاني الهادئ البعيد","https://www.aldiwan.net/poem24785.html","مجزوء البسيط"],[69,"معرة النعمان عيني إذا","https://www.aldiwan.net/poem29090.html","السريع"],[50,"عن يميني وعن يساري وقدا","https://www.aldiwan.net/poem62381.html","الخفيف"],[46,"والحكم جار على الأكتاد محتمل","https://www.aldiwan.net/poem22384.html","البسيط"],[68,"قف بالديار وحي الأربع الدرسا","https://www.aldiwan.net/poem1503.html",""],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54271","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54288","الكامل"],[106,"الديمقراطية","https://www.poetsgate.com/ViewPoem.aspx?id=179443",""],[106,"قومي بين الشرق والغرب","https://www.poetsgate.com/ViewPoem.aspx?id=179442",""],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[91,"لم أجد أحدا ...","https://www.poetsgate.com/ViewPoem.aspx?id=53029",""],[78,"سَكِّن فُؤادكَ لا تَذهَب بِكَ الفِكَرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86482&r=&rc=27",""],[143,"ما كان قبلك في الزمان الخالي","https://www.aldiwan.net/poem11802.html","الكامل"],[155,"كم زفرات وكم دموع","https://www.aldiwan.net/poem55639.html","مخلع البسيط"],[155,"بدر ليل أولا فشمس نهار","https://www.aldiwan.net/poem55704.html","الخفيف"],[160,"يا طيب ما يهدى قبيل الفجر","https://www.aldiwan.net/poem58782.html","الرجز"],[169,"سقها ولو ذهب السرى بسراتها","https://www.aldiwan.net/poem1609.html",""],[198,"كم زورة لي بالزوراء خضت بها","https://www.aldiwan.net/poem51870.html","البسيط"],[229,"وصامت الجو بعيد الفرقد","https://www.aldiwan.net/poem51126.html","الكامل"],[270,"هلا وفيت كما وعدت حزينا","https://www.aldiwan.net/poem35582.html","الكامل"],[270,"عودي الى ماضيك يا بغداد","https://www.aldiwan.net/poem35650.html","الكامل"],[270,"حبي الخليفة مولانا ومولاك","https://www.aldiwan.net/poem35652.html","البسيط"],[298,"من فاته أن يرى الأشجان ماثلة","https://www.aldiwan.net/poem36307.html","عموديه"],[298,"حيتك باسمة ثغور الزنبق","https://www.aldiwan.net/poem36840.html","عموديه"],[303,"يا سيدا رب العلا","https://www.aldiwan.net/poem57736.html","مجزوء الرجز"],[303,"كم زارني والثريا يلوها قمر","https://www.aldiwan.net/poem57850.html","الكامل"],[364,"لولا طروق خيال منك منتظر","https://www.aldiwan.net/poem60919.html","البسيط"],[366,"غرتك أبدان وأردان","https://www.aldiwan.net/poem17126.html","الرجز"],[380,"من للمحب المستهام","https://www.aldiwan.net/poem48802.html","مجزوء الكامل"],[380,"أمسى المعنى يعاني ما يعانيه","https://www.aldiwan.net/poem48841.html","البسيط"],[380,"سقت الغريب حمائم الفجر","https://www.aldiwan.net/poem49205.html","أحذ الكامل"],[416,"مولاي قد حان الوداع","https://www.aldiwan.net/poem53845.html","مجزوء الكامل"],[453,"كم زعيم مسخر شرفه","https://www.aldiwan.net/poem61355.html","الخفيف"],[458,"أولى لها أن يرعوي نفارها","https://www.aldiwan.net/poem56170.html","الرجز"],[464,"بين القدود وبين أعطاف القنا","https://www.aldiwan.net/poem3325.html","عموديه"],[464,"في القلب منزلة الغزال الشامس","https://www.aldiwan.net/poem3577.html","عموديه"],[464,"لتذكري ظبيات سلع والنقا","https://www.aldiwan.net/poem3619.html","عموديه"],[465,"الموجعة","https://www.aldiwan.net/poem59030.html","عموديه"],[479,"ظلموك يا جدي ولست ظلوما","https://www.aldiwan.net/poem37194.html","الكامل"],[551,"يا طيف ألا زرتنا بسواد","https://www.aldiwan.net/poem47852.html","الكامل"]],"verses":[["كَم زَفرَةٍ خَرساءَ","مُتَمَسِّكاً بِعَلائِقِ الأَجرِ",0,"ر",1,0],["كَمَزلَقَةِ الذُبابِ إِذا أُمِرَّت","عَلى ذي الداءِ بالِغَتِ الوِداجا",1,"ج",2,0],["كَم زَفرَةٍ ضَعُفَت فَصارَت أَنَّةً","تَمَّمتُها بِتَنَفُّسِ الصُعَداءِ",2,"ا",2,0],["كمْ زُرْتُها بنِجادِ السّيْفِ مُشْتَمِلاً","والنّجْمُ في الأُفُقِ الغَرْبيّ حَيْرانُ",3,"ن",1,0],["كم زنت قرطاساً بآياته","بين شتيت باهرٍ أو جميع",4,"ع",1,0],["كم زفرة بين الجوانح ما ارتقت","حَذَرَ الرقيب ومدمع لم يُسجمِ",5,"م",1,0],["كم زارني معروفُه","من قبلِ وعدٍ بالْتِقاءِ",6,"ق",3,0],["كم زخرفَ القولَ من زورٍ وَلبَّسَهُ","على العقول ولكنْ قلَّما لَبِثَا",7,"ث",2,0],["كم زفرةٍ لي تبيت تُنهض أح","شائي ودمعٍ عليك منبجِس",8,"س",1,0],["كم زوَّجتني بدأةٌ منهمُ","وقالتْ العودة لي أعرِس",9,"س",1,0],["كم زاحم الدهر فوق مدحضة","زلج فما زل عن زحالقها",10,"ق",3,0],["كم زفرةٍ لي ملءَ الصدرِ حينئذ","عن حسرةٍ في ضمير القلب أطويها",11,"ي",3,0],["كَم زَهرَةٍ في السَفحِ خادِرَةِ المُنى","سَكَنَت عَلى يَأسٍ سُكونَ الجَلمَدِ",12,"د",1,0],["كَم زُرنَها وَالحَيُّ مُنتَبِهٌ","وَتَرَكتُها وَالحَيُّ قَد هَجَدا",13,"د",2,0],["كَم زَهِدنا بِثَروَةٍ مِن نُضارٍ","وَقَنِعنا بِثَروَةٍ مِن أَماني",14,"ي",1,0],["كَم زَفرَةٍ مِن شِغافِ القَلبِ صاعِدَة","وعَبرة مِن شؤون العين تَنحَدِرُ",15,"ر",1,0],["كم زار منك نظامنا","جرمٌ يجدّ السير دائب",16,"ب",1,0],["كَم زَورَةٍ لَكَ في الأَعرابِ خافِيَةٍ","أَدهى وَقَد رَقَدوا مِن زَورَةِ الذيبِ",17,"ب",1,0],["كَم زَمانٍ بَكَيتُ مِنهُ قَديماً","ثُمَّ لَمّا مَضى بَكَيتُ عَلَيهِ",18,"ي",2,0],["كم زفرة في الضلوع قرّت","يحوطها هيكلٌ مريض",19,"ض",1,0],["كم زهرةٍ تضحكُ في كمِّها","ونسمةٍ تعثُر في ذيلها",20,"ه",2,0],["كَمُزيلٍ رِجلَيهِ عَن بَلَلِ القَط","رِ وَما حَولَهُ مِنَ الأَرضِ بَحرُ",21,"ر",1,0],["كَم زالَ جيلٌ وَهَذي الأَرضُ باقِيَةٌ","ما هَمَّ بِالزيغِ مِن أَوتادِها وَتَدُ",22,"د",1,0],["كم زارني والدّجى يَرْبدّ من حَنَقٍ","والزهْرُ تبسِمُ عن وَجْهِ الذي عَبَسَا",23,"س",2,0],["كَمْ زُرْتُهُ فِي يَقْظَةٍ","وَأَلَمَّ بِي فِي مَهْجَعِ",24,"ع",1,0],["كم زَهْرةٍ عَلِقَتْ بفَضْلِ رِدَائه","فالوردُ مِلءُ ردائِه والعَبْهر",25,"ر",1,0],["كَمْ زَانَ مِنْ مُلْكٍ كَمَا ازْ","دَانَ الْمُهَنَّدِ بِالْفِرِنْدِ",26,"د",1,0],["كم زُيْنَ اسمٌ بألقاب مكدَّسة","وقد تجرَّد من زَيْن مُسماه",27,"ا",2,0],["كم زيجةٍ مازال يدمَى جرحها","ومن الجروح: ذوابلٌ ودوامي!",28,"م",2,0],["كم زان سيفٌ مِعْصَما","كانت تزيَّنُه الأساور",29,"ر",1,0],["كم زرتها والحيّ منبته","وتركتها والحيّ قد هجدا",30,"د",2,0],["كَم زَفْرَةٍ في شِغافِ القَلبِ صاعِدَةٍ","وعَبرةٍ مِن شؤون الدَّهر تَنحَدِرُ",31,"ر",1,0],["كَم زارَ غَيرَكَ وَهوَ مُغضٍ سادِمٌ","وَأَتاكَ يَمشي مِشيَةَ المُختالِ",32,"ل",1,0],["كَمْ زفراتٍ وكم دُمُوع","هذا لَعَمري هُوَ القُطُوعُ",33,"ع",1,1],["كَمَزَايا خَلائِقٍ لأَبي القا","سِمِ فينا مُنِيرَةِ الأَنْوارِ",34,"ر",1,0],["كم زف نحوى جوده عروسه","ليس سوى الشكر لها من مهر",35,"ر",1,0],["كَم زبيَةٍ حَفَرَت لَها يَدُ كاشِحٍ","يَبغي لَها الأَسواءَ في غَفَلاتِها",36,"ت",3,0],["كم زورةٍ ليَ بالزوراءِ خُضْتُ بها","عُبابَ بحرٍ من الليلِ الدجوجيِّ",37,"ي",1,1],["كم زَورةٍ لي تحت ذاك المرقِد","في حَيّ سهم بالظلام مُرْتَدِ",38,"د",1,0],["كم زهرةٍ تذوي وتحملُ عرفَها","هبّاتُ ليلٍ ساكنٍ تُحيينا",39,"ن",2,0],["كم زحفةٍ زحف الرشيدُ بجيشهِ","حتى الخليجِ ودونَه الإزباد",40,"د",1,0],["كم زحفةٍ لعلوجِ الرومِ أوقفَها","سلاحُ جيشِكِ أو أشلاء قَتلاك",41,"ك",1,0],["كم زفرةٍ عند إِدبارِ النجومِ إِذا","صعَّدتها خلتُ مَعْها النفسَ تنتزع",42,"ع",1,0],["كم زهرةٍ رفّتْ فخلت فراشةً","بيضاءَ رفَّ جناحُها بترفق",43,"ق",1,0],["كم زان أرضا أقفرت","ووجنةً مزخرفه",44,"ف",2,0],["كم زارني والثريا يلوها قمرٌ","والليل منسدلُ الأذيال والطنب",45,"ب",1,1],["كم زرتُهم وحُماةُ الحَيِّ مانعةٌ","للبيضِ بالبيض أو للسُّمْر بالسُّمُر",46,"ر",1,0],["كَم زِقّ خَمرٍ فيهِمُ ناطِقٍ","سَكرانَ بَل راجيهِ سَكرانُ",47,"ن",1,0],["كَم زورة لي وَاعتِنا","ق تَحتَ أَستار الظَلام",48,"م",1,0],["كَم زارَني وَجلاً وَاللَيل يَسترنا","عَن الرَقيب وَتَخفينا غَواشيهِ",49,"ي",2,0],["كَم زارَني جَنح الدُجى وَجَلا","تَهفو جَوانِحُهُ مِن الذُعر",50,"ر",1,0],["كم زَرْتُ حضرتَك الَّتي","ما زلتُ منها في حبور",51,"ر",1,0],["كم زعيم مسخّر شرفه","بات أقصى خلاصه تلفه",52,"ف",2,1],["كم زورةٍ على الغضا تأذَنُ لي","فيها بيوتٌ لم تصِلْ زُوّارُها",53,"ر",3,0],["كم زورةٍ نطق النطاق فصاحةً","فيها رحمتُ لها السوار الألكنا",54,"ن",2,0],["كم زورةٍ كان الظلام مؤازري","فيها وثغرُ الصبح فيه منافسي",55,"س",2,0],["كم زورةٍ تمّتْ بها أنفاسها","وكفى العبيرُ محدّثاً أنْ يعبقا",56,"ق",2,0],["كَم زَرَعنا ، وَكَم سَقى دَمُنا","وَسَهرْنا حتى ذوَى الكَبِد ُ",57,"د",1,0],["كم زودته شيوخها بدعائها","والفضل منه لم يكن معدوما",58,"م",2,0],["كم زارني وأنا البعيدُ عن النّدى","مِنْ سَيْبِ كفّكِ مِن لُهاً وأيادِ",59,"د",1,0]]}