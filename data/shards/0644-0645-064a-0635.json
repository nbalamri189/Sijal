{"poems":[[88,"لا تأمنن دنياك في حالة","https://www.aldiwan.net/poem44805.html","السريع"],[51,"سبغت نعمة ودام صفاء","https://www.aldiwan.net/poem7955.html","الخفيف"],[51,"راع قلبي مشيب رأس خليس","https://www.aldiwan.net/poem64653.html","الخفيف"],[51,"أطلع الله وجه شهرِك هذا","https://www.aldiwan.net/poem66377.html","الخفيف"],[51,"يا كريما لم يزل محتمِا","https://www.aldiwan.net/poem66525.html","الرمل"],[51,"نوك وغي وعي","https://www.aldiwan.net/poem66753.html","المجتث"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[45,"نصيب عينيك من سح وتسجام","https://www.aldiwan.net/poem66640.html","البسيط"],[49,"اهرب بنفسك من دنيا مضللة","https://www.aldiwan.net/poem63073.html","البسيط"],[80,"أغمر الهوى كم ذا تقطعني عذلا","https://www.aldiwan.net/poem31329.html","الطويل"],[31,"ولقد قالت لأتراب لها","https://www.aldiwan.net/poem42600.html","الرمل"],[102,"قدر ساقه فآواه روضا","https://www.aldiwan.net/poem32977.html","الخفيف"],[48,"دع عنك يا صاح الفكر","https://www.aldiwan.net/poem63300.html","مجزوء الكامل"],[90,"خل النديم","https://www.poetsgate.com/ViewPoem.aspx?id=178950",""],[117,"عدوكم بخطوب الدهر مقصود","https://www.aldiwan.net/poem4356.html","البسيط"],[197,"أنحلوني وأسقموا","https://www.aldiwan.net/poem45226.html","مجزوء الخفيف"],[233,"يا ابن عبد الكريم كلفتنا المش","https://www.aldiwan.net/poem31806.html","الخفيف"],[347,"لمغيب قلبي في هواكم مشهد","https://www.aldiwan.net/poem15644.html","الكامل"],[362,"وجدي بلومك يا عذول يزيد","https://www.aldiwan.net/poem60944.html","الكامل"],[364,"رجعت عنه بلا سمع ولا بصر","https://www.aldiwan.net/poem17020.html","البسيط"],[369,"ما عليها سهرت أم بت نائم","https://www.aldiwan.net/poem57165.html","الخفيف"],[434,"يا هلالا في فلك","https://www.aldiwan.net/poem2494.html","مجزوء الرمل"],[466,"نفسي الفداء لشخص لست أسميه","https://www.aldiwan.net/poem59528.html","البسيط"],[466,"لم يصف عيسى بن مرقس لأخ","https://www.aldiwan.net/poem59990.html","المنسرح"],[503,"إلهٌ من نباح","https://www.aldiwan.net/poem42459.html","مخلع البسيط"],[549,"يا دار دار الصوم القوم","https://www.aldiwan.net/poem47200.html","السريع"],[549,"خل عنها منيحة للئام","https://www.aldiwan.net/poem47202.html","الخفيف"],[565,"أمر عيش وحال خفض","https://www.aldiwan.net/poem69620.html","مخلع البسيط"],[573,"صدوا فإنساني إليهم صدى","https://www.aldiwan.net/poem3087.html","السريع"]],"verses":[["لم يَصفُ بالسراء عُرس ابنه","ولم تَرُق ليلته الساهره",0,"ر",2,0],["لم يُصَفِّ الدواءُ جسمَك إلا","عن صفاءٍ كما يكون الصفاءُ",1,"ف",3,0],["لم يُصيبَا في أمرها فأصيبا","بعذاب من الإله بئيس",2,"س",1,0],["لَمْ يصُمْ فُوك دون عينيك فيهِ","كصيامِ الأفواهِ دونَ العيون",3,"ن",1,0],["لم يصرِّحْ لك بالسوء ولا","أضمر السوء اعتماداً إذْ لحن",4,"ن",1,0],["لم يصفُ عيشُك لكنْ","عيشُ الغَبِيِّ هَنيُّ",5,"ي",1,0],["لَم يَصدُقِ اِبنَ الحَسَنِ النصرُ بِهِ","أَصبَحَ ضاحِكاً وَأَمسى قَد بَكى",6,"ا",1,0],["لَم يَصطَحِب في طَريقٍ وَالبَخيلُ وَلَم","يولَد وَجِبسٌ مِنَ الأَقوامِ في عامِ",7,"م",1,0],["لَم يَصفُ شُربُ اِمرِئٍ فيها فَأَعجَبَهُ","إِلّا تَكَدَّرَ أَو أَمسى لَهُ وَشَلا",8,"ل",2,0],["لم يصبِ منكَ القلبَ مَشْيُ جآذرٍ","يُنَزِّع فيه التّيهَ أقدامَها نَقْلا",9,"ل",2,0],["لَم يُصِبها نَكَدٌ فيما مَضى","ظَبيَةٌ تَختالُ في مَشيَتِها",10,"ت",3,0],["لَم يَصدِّق عَينيه حَتّى أَطَلَّت","وَأَطالَت في ختله نَجواها",11,"ه",2,0],["لَم يَصطَبِح مِنها النَدي","مُ ثَلاثَةً إِلّا سَكِر",12,"ر",1,0],["لم يُصبني كأسُ النديم وخمرُهُ","لو دام لي ثغر الحبيب وريقه",13,"ق",2,0],["لم يُصغِ للوعظِ لا قلباً ولا أذناً","وكيف تُصغي إلى الوعظِ الجلاميدُ",14,"د",1,0],["لم يُصبْ قَطُّ بالهوى","عاشقٌ ثم يسلمُ",15,"م",1,0],["لَم يَصِحَّ النَدمانُ فيهِ مِنَ الرا","حِ وَلا الكَأسُ مِن فَمِ الإِبريقِ",16,"ق",1,0],["لَم يَصبُ عَنها الصابِئونَ وَلَم يَهُد","إِلّا إِلَيها في الهُدى المُتَهَوِّدُ",17,"د",1,0],["لم يَصْدُقِ الواشون فيما بَلّغُوا","كَلاّ ولم يَتغيَّرِ المَعْهود",18,"د",1,0],["لَم يَصبِرِ الدَهرُ مِقدارَ الخِطابِ لَهُ","لِمُحسِنٍ إِن أَسا لا كانَ كُلُّ مُسي",19,"ي",1,0],["لَم يَصِلني ولَم يَعِدني وقالَ اك","تُم فَماذا أسَرَّ حتَّى أُكاتِم",20,"م",1,0],["لم يصخ سمعي إلى","لائمٍ حيث سلك",21,"ك",1,0],["لَم يُصبشحُ الغُصنُ مِن أَعطافِهِ خَجَلاً","إِلّا وَأَمسى حُيَيّاً مَن تَثَنّيهِ",22,"ي",2,0],["لَم يَصفُ عيسى بنُ مُرقُسٍ لِأَخٍ","إِلّا وَشابَ الصَفاءَ تَكديرُ",23,"ر",1,1],["لم يُصنع اللهُ إنّما صُنْ","نِعتْ ربوبٌ من النّباحِ",24,"ح",1,0],["لم يُصبحوا فيها لوم يغبُقوا","إلّا بِكَأسَي خَمْرَةِ الأنْعَمِ",25,"م",1,0],["لم يُصبني بالسُّوءِ رامٍ وكم أصْ","مى وأَردى بما يُعابُ الرّامي",26,"ي",1,0],["لَمْ يَصُنْ المَحْلُ قَطُّ مَالاً","لَهُمْ وَلَمْ يُسْتَذَلَّ عِرْضُ",27,"ض",1,0],["لم يَصِد الشَّعرُ له وجنةً","والوجْهُ بالشَّعر كَنَصْلٍ صَدِي",28,"ي",1,0]]}