{"poems":[[90,"لا تأمنن دنياك في حالة","https://www.aldiwan.net/poem44805.html","السريع"],[53,"سبغت نعمة ودام صفاء","https://www.aldiwan.net/poem7955.html","الخفيف"],[53,"راع قلبي مشيب رأس خليس","https://www.aldiwan.net/poem64653.html","الخفيف"],[53,"أطلع الله وجه شهرِك هذا","https://www.aldiwan.net/poem66377.html","الخفيف"],[53,"يا كريما لم يزل محتمِا","https://www.aldiwan.net/poem66525.html","الرمل"],[53,"نوك وغي وعي","https://www.aldiwan.net/poem66753.html","المجتث"],[87,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[47,"نصيب عينيك من سح وتسجام","https://www.aldiwan.net/poem66640.html","البسيط"],[51,"اهرب بنفسك من دنيا مضللة","https://www.aldiwan.net/poem63073.html","البسيط"],[109,"البردة","https://www.aldiwan.net/poem58555.html","عموديه"],[82,"أغمر الهوى كم ذا تقطعني عذلا","https://www.aldiwan.net/poem31329.html","الطويل"],[33,"ولقد قالت لأتراب لها","https://www.aldiwan.net/poem42600.html","الرمل"],[104,"قدر ساقه فآواه روضا","https://www.aldiwan.net/poem32977.html","الخفيف"],[50,"دع عنك يا صاح الفكر","https://www.aldiwan.net/poem63300.html","مجزوء الكامل"],[92,"خل النديم","https://www.poetsgate.com/ViewPoem.aspx?id=178950",""],[123,"عدوكم بخطوب الدهر مقصود","https://www.aldiwan.net/poem4356.html","البسيط"],[203,"أنحلوني وأسقموا","https://www.aldiwan.net/poem45226.html","مجزوء الخفيف"],[240,"يا ابن عبد الكريم كلفتنا المش","https://www.aldiwan.net/poem31806.html","الخفيف"],[354,"لمغيب قلبي في هواكم مشهد","https://www.aldiwan.net/poem15644.html","الكامل"],[369,"وجدي بلومك يا عذول يزيد","https://www.aldiwan.net/poem60944.html","الكامل"],[371,"رجعت عنه بلا سمع ولا بصر","https://www.aldiwan.net/poem17020.html","البسيط"],[376,"ما عليها سهرت أم بت نائم","https://www.aldiwan.net/poem57165.html","الخفيف"],[443,"يا هلالا في فلك","https://www.aldiwan.net/poem2494.html","مجزوء الرمل"],[473,"نفسي الفداء لشخص لست أسميه","https://www.aldiwan.net/poem59528.html","البسيط"],[473,"لم يصف عيسى بن مرقس لأخ","https://www.aldiwan.net/poem59990.html","المنسرح"],[510,"إلهٌ من نباح","https://www.aldiwan.net/poem42459.html","مخلع البسيط"],[556,"يا دار دار الصوم القوم","https://www.aldiwan.net/poem47200.html","السريع"],[556,"خل عنها منيحة للئام","https://www.aldiwan.net/poem47202.html","الخفيف"],[572,"أمر عيش وحال خفض","https://www.aldiwan.net/poem69620.html","مخلع البسيط"],[580,"صدوا فإنساني إليهم صدى","https://www.aldiwan.net/poem3087.html","السريع"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2420","الكامل"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2409","المنسرح"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48676","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70948","المديد"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59409","البسيط"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95563","الخفيف"],[1782,"","https://poetry.dctabudhabi.ae/diwan/poem/128771","البسيط"],[1782,"","https://poetry.dctabudhabi.ae/diwan/poem/128768","الكامل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87838","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2124,"","https://poetry.dctabudhabi.ae/diwan/poem/45484","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77200","الخفيف"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104989","الكامل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105034","الخفيف"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110624","السريع"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67276","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60894","البسيط"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205770","الرمل"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147358","الكامل"],[3112,"","https://poetry.dctabudhabi.ae/diwan/poem/130449","الرجز"],[3150,"","https://poetry.dctabudhabi.ae/diwan/poem/82362","الخفيف"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121618","الخفيف"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97967","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91069","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216831","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118004","السريع"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35538","المنسرح"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77053","الخفيف"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107521","الكامل"],[4013,"","https://poetry.dctabudhabi.ae/diwan/poem/113659","الكامل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102731","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133116","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139481",""],[4755,"بالشِّعرِ أَو بالعَشرِ لَن أَضرِبَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=196960",""],[4578,"زف المدامة واسع سعيك للصفا","https://www.poetsgate.com/ViewPoem.aspx?id=49483",""],[5052,"أتلفتُ حَوبائي","https://www.poetsgate.com/ViewPoem.aspx?id=205347",""],[5183,"لفح الأسى","https://www.poetsgate.com/ViewPoem.aspx?id=180226",""],[5219,"فراق واشتياق","https://www.poetsgate.com/ViewPoem.aspx?id=194940",""],[5343,"بوارق النصر","https://www.poetsgate.com/ViewPoem.aspx?id=132673",""],[5459,"المتخم","https://www.poetsgate.com/ViewPoem.aspx?id=190892",""],[5542,"حوار في ساحة المطاف","https://www.poetsgate.com/ViewPoem.aspx?id=10068",""],[5659,"لم يصف واصف الفراق فأحصى","https://www.poetsgate.com/ViewPoem.aspx?id=200459",""],[4623,"من يعذر المشتاق في شطحاته ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146691",""],[5781,"خَمائِلهُ بِلَونِ دمي","https://www.poetsgate.com/ViewPoem.aspx?id=208990",""],[5956,"أقصوصة أنثى سُحاقية","https://www.poetsgate.com/ViewPoem.aspx?id=182690",""],[463,"عمى صباحا بعدنا واسلمي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60311&r=&rc=367",""],[6318,"الفجر الدامي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66161&r=&rc=11",""],[572,"أمَرَّ عيشٌ وَحَالَ خفضُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9361&r=&rc=218",""]],"verses":[["لم يَصفُ بالسراء عُرس ابنه","ولم تَرُق ليلته الساهره",0,"ر",2,0],["لم يُصَفِّ الدواءُ جسمَك إلا","عن صفاءٍ كما يكون الصفاءُ",1,"ف",3,0],["لم يُصيبَا في أمرها فأصيبا","بعذاب من الإله بئيس",2,"س",1,0],["لَمْ يصُمْ فُوك دون عينيك فيهِ","كصيامِ الأفواهِ دونَ العيون",3,"ن",1,0],["لم يصرِّحْ لك بالسوء ولا","أضمر السوء اعتماداً إذْ لحن",4,"ن",1,0],["لم يصفُ عيشُك لكنْ","عيشُ الغَبِيِّ هَنيُّ",5,"ي",1,0],["لَم يَصدُقِ اِبنَ الحَسَنِ النصرُ بِهِ","أَصبَحَ ضاحِكاً وَأَمسى قَد بَكى",6,"ا",1,0],["لَم يَصطَحِب في طَريقٍ وَالبَخيلُ وَلَم","يولَد وَجِبسٌ مِنَ الأَقوامِ في عامِ",7,"م",1,0],["لَم يَصفُ شُربُ اِمرِئٍ فيها فَأَعجَبَهُ","إِلّا تَكَدَّرَ أَو أَمسى لَهُ وَشَلا",8,"ل",2,0],["لَمْ يَصْرَعِ الظَّبْيُ مِنْ حُسْنٍ بِهِ أَسَدَاً","بَلْ جَاءَهُ حُسْنُهُ مِنْ صَرْعِهِ الأَسَدَا",9,"د",2,0],["لم يصبِ منكَ القلبَ مَشْيُ جآذرٍ","يُنَزِّع فيه التّيهَ أقدامَها نَقْلا",10,"ل",2,0],["لَم يُصِبها نَكَدٌ فيما مَضى","ظَبيَةٌ تَختالُ في مَشيَتِها",11,"ت",3,0],["لَم يَصدِّق عَينيه حَتّى أَطَلَّت","وَأَطالَت في ختله نَجواها",12,"ه",2,0],["لَم يَصطَبِح مِنها النَدي","مُ ثَلاثَةً إِلّا سَكِر",13,"ر",1,0],["لم يُصبني كأسُ النديم وخمرُهُ","لو دام لي ثغر الحبيب وريقه",14,"ق",2,0],["لم يُصغِ للوعظِ لا قلباً ولا أذناً","وكيف تُصغي إلى الوعظِ الجلاميدُ",15,"د",1,0],["لم يُصبْ قَطُّ بالهوى","عاشقٌ ثم يسلمُ",16,"م",1,0],["لَم يَصِحَّ النَدمانُ فيهِ مِنَ الرا","حِ وَلا الكَأسُ مِن فَمِ الإِبريقِ",17,"ق",1,0],["لَم يَصبُ عَنها الصابِئونَ وَلَم يَهُد","إِلّا إِلَيها في الهُدى المُتَهَوِّدُ",18,"د",1,0],["لم يَصْدُقِ الواشون فيما بَلّغُوا","كَلاّ ولم يَتغيَّرِ المَعْهود",19,"د",1,0],["لَم يَصبِرِ الدَهرُ مِقدارَ الخِطابِ لَهُ","لِمُحسِنٍ إِن أَسا لا كانَ كُلُّ مُسي",20,"س",2,0],["لَم يَصِلني ولَم يَعِدني وقالَ اك","تُم فَماذا أسَرَّ حتَّى أُكاتِم",21,"م",1,0],["لم يصخ سمعي إلى","لائمٍ حيث سلك",22,"ك",1,0],["لَم يُصبشحُ الغُصنُ مِن أَعطافِهِ خَجَلاً","إِلّا وَأَمسى حُيَيّاً مَن تَثَنّيهِ",23,"ي",2,0],["لَم يَصفُ عيسى بنُ مُرقُسٍ لِأَخٍ","إِلّا وَشابَ الصَفاءَ تَكديرُ",24,"ر",1,1],["لم يُصنع اللهُ إنّما صُنْ","نِعتْ ربوبٌ من النّباحِ",25,"ح",1,0],["لم يُصبحوا فيها لوم يغبُقوا","إلّا بِكَأسَي خَمْرَةِ الأنْعَمِ",26,"م",1,0],["لم يُصبني بالسُّوءِ رامٍ وكم أصْ","مى وأَردى بما يُعابُ الرّامي",27,"م",2,0],["لَمْ يَصُنْ المَحْلُ قَطُّ مَالاً","لَهُمْ وَلَمْ يُسْتَذَلَّ عِرْضُ",28,"ض",1,0],["لم يَصِد الشَّعرُ له وجنةً","والوجْهُ بالشَّعر كَنَصْلٍ صَدِي",29,"د",2,0],["لَم يَصطَلينَ غَضاً وَلَم","يَضرِبنَ لِلبَهمِ الحَظيرَه",30,"ر",2,0],["لَم يَصحُ هَذا الفُؤادُ مِن طَرَبِه","وَمَيلِهِ في الهَوى وَفي لَعِبِه",31,"ب",2,1],["لم يصبحوا شيعاً ولكن أصبحت","دعوى السياسة مغنماً مقسوما",32,"م",2,0],["لم يصبْني بعد فرقته","حزنٌ مُؤْذٍ ولا جزَع",33,"ع",1,0],["لم يصف موردها يوما لوارده","إلا وصيره وقع الدلا وخما",34,"م",2,0],["لم يصعر خدوده المال جما","بل تهادى تواضعاً لا يمينُ",35,"ن",1,0],["لم يصح منا بعذري الهوى ثمل","الاَّ واسكر من جفنيه حيث صحا",36,"ح",2,0],["لم يصف لي عيش ولو ملكت يدي","جنات عدن دون يوم وصاله",37,"ل",2,0],["لَم يَصُغكَ الرَحمَنُ مِن خالِصِ التِب","رِ لِتَزهو فَلُمَّ مِن أَذيالِك",38,"ك",1,0],["لم يصفكم حقيقة الوصف إلاّ ال","له في صحفه التي أبداها",39,"ا",3,0],["لَم يُصبِحِ القَومُ جيراناً فَكُلُّ نَوى","بِالناسِ لا صَدعَ فيها سَوفَ تَنصدِعُ",40,"ع",1,0],["لَم يَصُل يَعرُبٌ وَلا طالَ خوفو","قَد تَمَشّى عَلى عُلانا الدُثورُ",41,"ر",1,0],["لم يصف لي من بعد طول صدوده","إلا بعرس للجواد زماني",42,"ن",2,0],["لم يصيبوا الحسين إلا فقيداً","حينما أرخوه أين الحسين",43,"ن",1,0],["لم يصح من سكر الصبا قده","كأنما يشرب من خده",44,"د",2,0],["لم يصطنعها لأَيمِ الله مُصطنع","دَعوهُ أن باقتفاكَ الكلُ مُجتمعُ",45,"ع",1,0],["لم يَصرموا إنما حبلى هموا صرموا","لم يرحلوا إنّما هم رَحَّلوا جلدي",46,"د",2,0],["لم يصادف رحمة من أنفس","كلما زادت غنى زاد ظماها",47,"ا",3,0],["لِمَ يَصْنَعُ الإِنْسَانُ مَوتَاً غَائِرَاً","يَطْهُو بِهِ الأَجْدَاثَ جَورَاً بِاليَدِ!",48,"د",1,0],["لم يصعدوا نحوَ السماءِ الساميه","لصدهم عن استماع الخبرِ",49,"ر",1,0],["لم يُصيبوا الرّشادَ فيما أتَوهُ","لا ولا كانَ جَدُّهم بسعيدِ",50,"د",1,0],["لم يُصِبْ نَصْبُهم مَكائدَ شَرٍ","وتَساوَى التَّحْذِيرُ والإغْراءُ",51,"ا",2,0],["لم يصبها في مداها غيرٌ","غير أن المرءَ جهلاً ينتقد",52,"د",1,0],["لَم يَصف قَلب فيهِ طَبع تَقلّب","إِلا وَذاك لغدره إِيماء",53,"ا",2,0],["لم يصبروا حتى يعيدك بينهم","يوم الرجاء فعجلوا الميعادا",54,"د",2,0],["لم يصب أيام الصبا نحو ما","يدنس العرض به أو يشين",55,"ن",1,0],["لَم يَصحُ مُنذُ اِنتَشَت لَواحِظهُ","وَكَيفَ يَصحُو وَريقهُ الخَمره",56,"ر",2,0],["لَم يُصب سَهم فِكرِهِ غَيرَ عَين","الحَق مَهما فَقدت رَأياً أَسدا",57,"د",2,0],["لم يُصبني وحدي هواهُ بل أرى","كلَّ الكرامِ له من العشاقِ",58,"ق",1,0],["لم يصغِ للتَّعنيف مسمع والهٍ","رسخ الهوى والوجد في سودائهِ",59,"ا",3,0],["لم يصدق الواشون في ما حدثوا","عني بأني حبل ودي انكث",60,"ث",1,1],["لم يصف حال امرئٍ فيها بلا نكدٍ","إن جاء صفاءً تلاه موجب الكدر",61,"ر",1,0],["لم يصبُ للدنيا وإن تزينت","ولم تمله أبداً أهواؤها",62,"ا",3,0],["لَم يَصحُ مِن ذُلٍّ ولا فاقَةٍ","لم يَغفُ مِن خَوفٍ ومِن مَسغَبَةْ",63,"ب",2,0],["لم يصبني من بعدها ريمٌ ولو","أنشأ الدخان بوجنتيه الزُّخرفا",64,"ف",2,0],["لم يصفُ لي عذِبٌ من بعد ماءكمُ","يامَنْ بماءكمُ بُرئي وإروائي",65,"ا",3,0],["لم يصحب الدهر منه غير ذي حذر","ببلغة من يسير العيش تكفيه",66,"ي",2,0],["لم يصغ إلا لقلب كان مذهبه","ألا يطاوع أقوالا لواشيها",67,"ي",3,0],["لم يصرخ الشعب يوما دونما رهب","إلا وكل ذليل منه مقتلَعُ",68,"ع",1,0],["لَمْ يُصِبْ جِلْدَكَ خَدْشٌ فَتَرَى","مُقْلَةً فِي الْجُرْحِ تَبْكِي بِدَمِ..",69,"م",1,0],["لم يُصِبْكم إلاَّ لأنَّ خُطاكم","وقفتْ حَيْثُ ساخت الأَقدامُ",70,"م",1,0],["لم يصف واصف الفراق فأحصى","بعض ما يستحقّ اسم الفراق",71,"ق",1,1],["لم يصغ للعذال في العذل الذي","فاهوا به فيمن اضر بذاته",72,"ت",2,0],["لَمْ يَصْنعِ الحبُّ مَجدًا للَّتي عشِقَتْ","ليْتَ المليحةَ نهرَ الحُبِّ لا تَرِدُ",73,"د",1,0],["لم يُصِخْ قطُّ لدرسي","عاشقاً قلبُه درسهْ",74,"س",2,0],["لم يصدفوا عن خلفاء الهدى","ولم يكافوا نعمة َ المنعمِ",75,"م",1,0],["لُمِّي صُفَوفَك ، أَمّة الإِسلام ، كال","بُنْيانِ مَشْدوداً بِعَهْدٍ آكَدِ",76,"د",1,0],["لَمْ يَصُنِ البُخْلُ قطُّ مالاً","لهمِ ولا يُستَذَلُّ عِرْضُ",77,"ض",1,0]]}