{"poems":[[55,"ألا ليت أذيال الغيوث السواجم","https://www.aldiwan.net/poem29766.html","الطويل"],[55,"إلا يكن نصلا فغمد نصول","https://www.aldiwan.net/poem29887.html","الكامل"],[93,"سألت وقد مرت الشمأل","https://www.aldiwan.net/poem9059.html","عموديه"],[87,"بني مصر ارفعوا الغار","https://www.aldiwan.net/poem8078.html","الهزج"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54207","البسيط"],[92,"حالنا أو في سبيل الحكم","https://www.poetsgate.com/ViewPoem.aspx?id=179149",""],[92,"عاشوراء","https://www.poetsgate.com/ViewPoem.aspx?id=179150",""],[93,"ريح الشمال","https://www.poetsgate.com/ViewPoem.aspx?id=53198",""],[190,"حادثات دهمن في أسبوع","https://www.aldiwan.net/poem43630.html","الخفيف"],[244,"إلى مجدك العلياء تعزى وتنسب","https://www.aldiwan.net/poem23838.html","الطويل"],[286,"لا أمنع الدمع أن يهمى وأن يكفا","https://www.aldiwan.net/poem1375.html",""],[408,"سقامي يظهر ما أضمر","https://www.aldiwan.net/poem46931.html","المتقارب"],[449,"جنى قوم على الدنيا","https://www.aldiwan.net/poem55978.html","عموديه"],[473,"لا تلحظن من أنت مستهتر","https://www.aldiwan.net/poem60445.html","السريع"],[543,"جبال هموم على كاهلي","https://www.aldiwan.net/poem47991.html","عموديه"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83297","الوافر"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1473,"","https://poetry.dctabudhabi.ae/diwan/poem/124025","الكامل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128697","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49544","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124762","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62946","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66446","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205879","الهزج"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135295","الرجز"],[3977,"","https://poetry.dctabudhabi.ae/diwan/poem/99178","السريع"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35414","الطويل"],[5102,"الله يمسّيك بالهجر ..","https://www.poetsgate.com/ViewPoem.aspx?id=13634",""],[5122,"(( يامضيع العشاق..1))","https://www.poetsgate.com/ViewPoem.aspx?id=27095",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5411,"( وتَأبَى شُموسُكَ )","https://www.poetsgate.com/ViewPoem.aspx?id=186720",""],[6023,"أخاك اغتفر ذنبه","https://www.poetsgate.com/ViewPoem.aspx?id=123894",""],[6124,"نور العشق","https://www.poetsgate.com/ViewPoem.aspx?id=174662",""],[6183,"سُدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79863&r=&rc=53",""]],"verses":[["وَغَطّى عَلى الأَرضِ الدُجى فَكَأَنَّنا","نُفَتِّشُ عَن أَعلامِها بِالمَناسِمِ",0,"م",1,0],["وَغَطى عَلى تِلكَ الجِراحِ كَأَنَّهُ","ما آبَ مِنهُ بِغارِبٍ مَخزولِ",1,"ل",1,0],["وَغَطّى السُهى وَجهَهُ بِالغَمامِ","كَما يَنزَوي الخائِفُ الأَعزَلُ",2,"ل",1,0],["وَغَطّوا البَرَّ بِالآسِ","وَغَطّوا البَحرَ بِالوَردِ",3,"د",1,0],["وغطَّتِ الوجهَ بالمِنْديلِ في خَفَرٍ","كما تَوارَى وراءَ الشكِّ إيمانُ",4,"ن",1,0],["وغطَّى على نقصِ الضعيف نجاحُه","وراح القويُّ عرضةً للعواثر",5,"ر",1,0],["وغطَّى على الأبصار حقدٌ فلم تكن","لتَجهَدَ عينٌ أن تَمُدَّ وتُبصِرا",6,"ر",2,0],["وغطى السّهى وجهه بالغمام","كما يتزوى الخائف الأعزل",7,"ل",1,0],["وغطائي السماء والجوّ بيتي","ووطائي منابت اليربوع",8,"ع",1,0],["وغطت منار الدين سحب ضلالة","كمثل نمير الماء غطاه طحلب",9,"ب",1,0],["وغُطّي الأمر عن أبصارنا وله","غطاؤه عن عيان الأمر قد كشفا",10,"ف",2,0],["وغَطِّ العذارَ فَمَهْمَا بدا","فإنّا على خَلْعِهِ نُعْذَرُ",11,"ر",1,0],["وغطى الأرض اجساد","تقاسي النزع كالاشلا",12,"ا",1,0],["وَغَطِّ بِالأَطرافِ وَجهَ الهَوى","فَلَيسَ تَخفى لَحَظاتُ المُريب",13,"ب",1,0],["وغطَّت على بَصري وقَضَت","قضاءً على عَقلىَ الرَّاحلِ",14,"ل",1,0],["وَغَطريفٌ تَعِزُّ بِهِ قُرَيشٌ","لَهُ في كُلِّ مَكرُمَةٍ يَدانِ",15,"ن",1,0],["وغَطّت الحِذِّيرَ في أخطارِه","فَقَد سَما عَمرو إِلى أوتارِه",16,"ه",1,0],["وغطارف صرفوا النفوس عن الهوى","إلا الصوارم والوشيج الذُبّلا",17,"ل",2,0],["وغطية بالستر الجميل وأسبلي","عليه بحق الله ذيل الفتوة",18,"ه",1,0],["وَغَطَّتْ على أبصارِنا وقلوبِنَا","فطالَ عليها الحَوْمُ وهي سَراب",19,"ب",1,0],["وغطّ فما واكظم نصب في تثاؤب","فذلك مسنون بأمر المرشد",20,"د",1,0],["وغطارف رفلوا الخطى من قبلهم","قُبروا وحسنُ بلائِهم لم يُقْبَرِ",21,"ر",1,0],["وغطِّ مساوي الأصدقاء ولا تكن","لها ساخطاً من بعد ما كنت",22,"ت",1,0],["وغطى كل جدرانى","بمنظور ومُزْدَانِ",23,"ن",1,0],["وغطِّ عنه مالَنا وأرضَنا","ومن عطائك إلهي أرضِنا",24,"ن",2,0],["وغطِّ بالأشواق وجه الهوى","فليس تخفى لحظات المريب",25,"ب",1,0],["وَغَطَّيتُها عَنّي بِثَوبِ عَوالِمي","وَعَن حاسِدي فيها لِشِدَّةِ غيرَتي",26,"ي",1,0],["وغطيت في سابع سهر وسُهادي","أنا ودمعتي وسبحتي وخيالي",27,"ل",2,0],["وغطه بشعر مايبيله أستشوار","مافيه داعي تعمله في الكوافير",28,"ر",1,0],["وغط رسول الله إذ قال ما أنا","بقار فنال الجهد منه لأمر ما",29,"م",2,0],["وَغَطى الَبنَفسَجُ صُبْحَ الأقاحِ","وَعْنْد التَّسابيح قامَ المَلا",30,"ل",2,0],["وغطِّ على عيبه","يدم منه عهد الوفا",31,"ف",2,0],["وغطَّى القلبَ بالأوهامِ والوعدِ","وظلَّ الشوقُ للمحبوبِ يُضنينا",32,"ن",2,0],["وَ غَطّى جَناحُ الغُروبِ الضِّياءَ","وَمَدَّ عَلى الأرضِ سودَ الظِّلالْ",33,"ل",1,0]]}