"","https://poetry.dctabudhabi.ae/diwan/poem/31689","البسيط"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126985","الكامل"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61277","البسيط"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45903","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45882","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110060","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91867","البسيط"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85116","المجتث"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131065",""],[3828,"","https://poetry.dctabudhabi.ae/diwan/poem/138928","الرجز"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125824","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90975","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28683","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72850","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141567","الكامل"],[4755,"العميد عدنان الحمادي .. وداعا","https://www.poetsgate.com/ViewPoem.aspx?id=207924",""],[4760,"ماتجي عل مزاجي ..","https://www.poetsgate.com/ViewPoem.aspx?id=35829",""],[4828,"سيرةُ ضوء","https://www.poetsgate.com/ViewPoem.aspx?id=193407",""],[4847,"قل هو الحب وطن","https://www.poetsgate.com/ViewPoem.aspx?id=175537",""],[4858,"سيدي يا رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=34882",""],[4858,"من شعب عمر المختار","https://www.poetsgate.com/ViewPoem.aspx?id=138201",""],[4858,"العروبة ودماء أطفال غزّة","https://www.poetsgate.com/ViewPoem.aspx?id=175068",""],[4869,"نظم الاحاسيس","https://www.poetsgate.com/ViewPoem.aspx?id=151614",""],[4929,"الى الذين يطلبون من صنعاء أن تنتفض","https://www.poetsgate.com/ViewPoem.aspx?id=199409",""],[4929,"جنازة أيلول","https://www.poetsgate.com/ViewPoem.aspx?id=199973",""],[5010,"ترجون نصرا بالكلام !!","https://www.poetsgate.com/ViewPoem.aspx?id=190309",""],[5082,"مسلّةُ الجسور","https://www.poetsgate.com/ViewPoem.aspx?id=212762",""],[5150,"اللحن الخالد - دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=202798",""],[5186,"عوفيت يا شيخ العرب","https://www.poetsgate.com/ViewPoem.aspx?id=156545",""],[5277,"وقفةٌ على أطلالِ القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=200887",""],[592,"الحق شمس لأهل الحق قد بانا","https://www.poetsgate.com/ViewPoem.aspx?id=128820",""],[5351,"المتناقض","https://www.poetsgate.com/ViewPoem.aspx?id=202233",""],[5431,"فارس منهزم في الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=183027",""],[5431,"سقط النصيف...","https://www.poetsgate.com/ViewPoem.aspx?id=198368",""],[5544,"إلى المتفانين من أجلنا","https://www.poetsgate.com/ViewPoem.aspx?id=213440",""],[5688,"لو كان يملك...","https://www.poetsgate.com/ViewPoem.aspx?id=200776",""],[5691,"أسير الذئب","https://www.poetsgate.com/ViewPoem.aspx?id=205764",""],[5691,"لسان حال الرئيس","https://www.poetsgate.com/ViewPoem.aspx?id=207076",""],[5829,"الحب المضطرب","https://www.poetsgate.com/ViewPoem.aspx?id=150377",""],[5829,"شهداء بدر","https://www.poetsgate.com/ViewPoem.aspx?id=163686",""],[5859,"طفلة","https://www.poetsgate.com/ViewPoem.aspx?id=29415",""],[5939,"بي لها","https://www.poetsgate.com/ViewPoem.aspx?id=179999",""],[5956,"شعبان ورمضان والإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=194654",""],[6005,"إصطفي خلف الأخريات","https://www.poetsgate.com/ViewPoem.aspx?id=161459",""],[6072,"القلبُ إذا تَلَكَّأ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84903&r=&rc=3",""],[2220,"إني إناءٌ ملآنُ ليسَ يشرٌ ما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11724&r=&rc=594",""],[5190,"الشعر والمشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78334&r=&rc=47",""]],"verses":[["لَكِنَّ كَفَّيكَ نَالَ طولُهُما","مَا كَلَّ عَنهُ نَجائبُ الإِبِلِ",0,"ل",1,0],["لكنكم تجهلون رتبته","ماذا فعلتم يا أجهل الجهله",1,"ل",2,0],["لكنكم وجلال الله يكلؤكم","تسترفضون جميلاً من توالينا",2,"ن",2,0],["لكنك المرءُ يُسدي عرفَهُ ويرى","تركَ الحساب عليه أفضلَ الحَسَبِ",3,"ب",1,0],["لكنكم تَحشُونها دهرَكُم","فكلكمُ مُتَّسع الثُّقبِ",4,"ب",1,0],["لكنكم كالمسك طاب لعينه","ويزيد حين تخوضه جُدَّاحُه",5,"ح",2,0],["لكنْ كما راقَت القُمْرِيَّ جَنَّتُهُ","فظلَّ يُتْبِعُ تغْرِيداً بتغْريدِ",6,"د",1,0],["لكنَّكم فرطتُمُ في واحدٍ","وهو الضُّراط فعدِّلُوا الإفراطا",7,"ط",2,0],["لكنك الرجل الذي لم نَلْقَه","إلا على سنن المحجة قائما",8,"م",2,0],["لَكِن كَفاكِ عُقوبَةً","مَن خانَ خانَتهُ الكَرامَه",9,"م",2,0],["لَكِنْ كَرِهْناه لمَّا سار في طُرُقٍ","من فيكَ مكروهَةِ الأنفاسِ والنُّطَفِ",10,"ف",1,0],["لكِنَّكُمْ حَطَبٌ بالٍ يُحرِّقُهُ","سَعيرُ شَمْسِ الضُّحى من قبلِ أشعاري",11,"ر",2,0],["لَكِنَّكَ الفَرعُ الَّذي هُوَ أَصلُهُ","شَرَفاً وَمَجدُكَ بِضعَةٌ مِن مَجدِهِ",12,"د",2,0],["لكنّك المرءُ لو ترميهِ صاعقةٌ","تَنهاه عن نَزعاتِ الغَيِّ ما ازْدجَرا",13,"ر",2,0],["لكنّكُم كنتم كأهْلِ العِجلِ لم","يُحْفَظْ لموسى فيهمُ هَرُون",14,"ن",1,0],["لكن كي تولد ثانية","في مايو أو في أكتوبر",15,"ر",1,0],["لكن كتمي كف العادلين بهم","إن المحب عن العذال في صمم",16,"م",1,0],["لكنَّ كلَّ غريبةٍ وعجيبةٍ","من فعلِ هذا المَنْجَنونِ الدائرِ",17,"ر",1,0],["لكنكم بين الثريا والثرى","أوسعتنا منك ومنهم عجبا",18,"ب",2,0],["لكن كتمتُ عَن الواشينَ بي وَبها","محبَّةً هي في الأَحشاءِ مُستَتِرَه",19,"ر",2,0],["لكنّ كفَك بالنّوا","ل لِمُجْدِبِ الأقوامِ قَطر",20,"ر",1,0],["لكن كل حاسد","بعينه قد رَقَبَكْ",21,"ك",1,0],["لكن كرهت بأن تراني عاضلاً","فأرد خُطَّاباً أتوا لخطابي",22,"ب",2,0],["لكنك رحت لهم أسداً","وهم في النسبة كالنقد",23,"د",1,0],["لكن كثير ذنوبه مغفورة","عندي لواحدة من الحسنات",24,"ت",1,0],["لكنك الشمس المضيئة في الضحى","تذر النجوم شواخصاً إذ تسطع",25,"ع",1,0],["لكنكم عُشّي إذا","رعَى رجائي الدِّمَنا",26,"ن",2,0],["لكن كرهتَ مِصاعَهم في طرحها","عني وأنت الفارسُ العطَّافُ",27,"ف",1,0],["لكنَّكُم أنتُم سَتَذهَبُ ريحُكُم","إذ ْ كُلُّ آصِرَة ٍ لَكُم تَتَقَطَّعُ!",28,"ع",1,0],["لكِن كَبيرُ بنُ هِندٍ يَومَ ذلِكُم","فُتخُ الشَمائِلِ في أَيمانِهِم رَوَحُ",29,"ح",1,0],["لكنْ كمِ الكريمُ من عاداتِهِ","يولي الضَّعيفَ فَضْلهُ ويُمْنحِ",30,"ح",1,0],["لكنك المولى الذي ما على","سائله منقصة السائل",31,"ل",1,0],["لكنك المحكوم منها بها","عليك بالجهل وبالإنتقاد",32,"د",1,0],["لكن كسبت قلوب عمال لهم","منك انجلى عدل وعقل راجح",33,"ح",1,0],["لكنكم شئتم ما شاء بارؤكم","فحكمه ورضاكم يجريان معا",34,"ع",2,0],["لَكِنْ كتابُ الله منها شاهدٌ","يَجلو العَمى ويُنوِّرُ الأبصارَا",35,"ر",2,0],["لكن كعمتَ فمَ الخَطبِ الجليلِ لَدُنْ","صادفتَهُ خَشِعاً ما إِنْ يَني دَهِشا",36,"ش",2,0],["لكنك استفتحتها","بحُلى الشباب مع المشيب",37,"ب",1,0],["لكِنَّكَ الحَمّالُ لَم يَطمَعوا","فيكَ وَلَم يَخشوا أَذاكَ الرَهيبْ",38,"ب",1,0],["لكنكم أنتم توابع غاشم","لا تخضعون إلى الرحيم العاقل",39,"ل",1,0],["لكن كنيت به عن ذكر غانية","لها أَديم بعين الشمس قد غمسا",40,"س",2,0],["لكنك اخترك البقا لا الفنا","ولم ترم الا الخطير المرام",41,"م",1,0],["لكن كم ابقى لنا من حرقة","قد أفنت الأجسام حتى الاعظما",42,"م",2,0],["لَكِنْ كَرَرْتَ إِلَى النَّصَارَى رَاجِعاً","وَالحَزْمُ مِمَّا تَحْتَفِيهِ وَتَصْطَفِي",43,"ف",2,0],["لكنك البحر والأشعار من دررٍ","ومن يعود إلى مأواه ما ظلما",44,"م",2,0],["لكنكم لو رمتم من عندنا","ماء العيون لها ماء الاعين",45,"ن",1,0],["لَكِنَّكُم قَدَّمتُمُ أقوَالَهُم","أبداً عَلَى النَّصِّ العَظِيمِ الشَّانِ",46,"ن",1,0],["لَكِنَّكُم خَالَفتُمُ المَنصُوصَ للش","بَهِ التِي هِيَ فِكرَةُ الأذهَانِ",46,"ن",1,0],["لَكِنَّكُم قَدَّمتُمُ رَأيَ الرِّجَا","لِ عَلَيهِمَا أفأنتُم عِدلاَنِ",46,"ن",1,0],["لَكِنَّكُم وَاللهِ مَا أنتُم عَلَى","إثبَاتِهِ وَالحَقُّ ذُو بُرهَانِ",46,"ن",1,0],["لَكِنَّكُم أكفَرتُمُوهُ وَقُلتُمُ","مَن قَالَ هَذَا فَهوَ ذُو كُفرَانِ",46,"ن",1,0],["لَكِنَّكُم أوقَدتُمُو لِلحَربِ نَا","راً بَينَ طَائِفَتَينِ مُختَلِفَانِ",46,"ن",1,0],["لَكِنَّكُم بِالعَكسِ قَد صَرَّحتُمُ","وَوَضَعتُمُ القَانُونَ ذَا البُهتَانِ",46,"ن",1,0],["لَكِنَّكُم أنتُم أبَحتُم قَتلَهُم","بِوِفَاقِ سُنَّتِهِ مَعَ القُرآنِ",46,"ن",1,0],["لكن كم للَه من حكم","دقت فلم يعلم لها سر",47,"ر",1,0],["لكنك الحورا التي لو لاحظت","عيناك كفاراً ثناهم طرفك",48,"ك",1,0],["لكن كقدوتنا بالعدل إذ نبذب","آيات خالقنا والحق قد بانا",49,"ن",2,0],["لكن كتبي ما عقني أحد","منها وكانت ضياي في النادي",50,"د",2,0],["لكنك تضحك حتى","تمسك البطَطَنَّهْ",51,"