{"poems":[[55,"قربوهن ليبعدن المغارا","https://www.aldiwan.net/poem30447.html","الرمل"],[55,"لأشكرنك ما ناحت مطوقة","https://www.aldiwan.net/poem30750.html","البسيط"],[88,"لا تلم كفي إذا السيف نبا","https://www.aldiwan.net/poem10698.html","الرمل"],[95,"في حيكم لي قلب جد مرتهن","https://www.aldiwan.net/poem11218.html","البسيط"],[53,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[53,"لم يبكني رسم منزل طسما","https://www.aldiwan.net/poem66036.html","المنسرح"],[47,"قل للجنوب إذا غدوت فأبلغي","https://www.aldiwan.net/poem65668.html","الخفيف"],[82,"هل كان أودع سر قلب محجرا","https://www.aldiwan.net/poem31438.html","الكامل"],[89,"حي مغنى الهوى بوادي الشآم","https://www.aldiwan.net/poem8286.html","الخفيف"],[52,"أخداش أنت ابن الثلاثة","https://www.aldiwan.net/poem64722.html","مجزوء الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85682","الرمل"],[47,"معَ الدّهرِ ظُلمٌ ليسَ يُقلِعُ رَاتِبُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31697",""],[82,"هل كان أودعَ سرَّ قلب محجراً","https://www.poetsgate.com/ViewPoem.aspx?id=3244",""],[139,"الشوق إلى نظم الأزجال","https://www.aldiwan.net/poem48847.html","عموديه"],[208,"أخداك ورد أم ثناياك جوهر","https://www.aldiwan.net/poem53264.html","الطويل"],[240,"واعجبي وحادث الد","https://www.aldiwan.net/poem32166.html","مجزوء الرجز"],[290,"يا رئيس الخطابة ازددت قدرا","https://www.aldiwan.net/poem39413.html","الخفيف"],[406,"رسالة اعتذار إلى أم المؤمنين خديجة (رضي الله عنها)","https://www.aldiwan.net/poem10309.html","عموديه"],[469,"هذه حلبة الهوى والفراق","https://www.aldiwan.net/poem3481.html","عموديه"],[473,"اخدم صديقك بكرة وعشية","https://www.aldiwan.net/poem59704.html","الكامل"],[569,"دعني أخي من الأدب","https://www.aldiwan.net/poem823.html",""],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101506","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38369","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38325","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38122","السلسلة"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46530","الرجز"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109169","السريع"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84506","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100969","الوافر"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120750","البسيط"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67218","الطويل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87734","الرمل"],[3227,"","https://poetry.dctabudhabi.ae/diwan/poem/143348","السريع"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103828","المنسرح"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138680",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131280",""],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102972","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111436","الرمل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44905","الطويل"],[5136,"أسموط در فصلت بالعسجد","https://www.poetsgate.com/ViewPoem.aspx?id=121799",""],[5183,"الزوراء","https://www.poetsgate.com/ViewPoem.aspx?id=186596",""]],"verses":[["أَخدِموهُنَّ الغَواني غَيرَةً","إِنَّهُم كانوا عَلى المَجدِ غَيارى",0,"ر",2,0],["أَخدَمتَني نُوَبَ الأَيّامِ طائِعَةً","وَكانَ كُلَّ الرِضى أَن آمَنَ النُوَبا",1,"ب",2,0],["أَخدِمُ الجَرحى وَأَقضي حَقَّهُم","وَأُواسي في الوَغى مَن نُكِبا",2,"ب",2,0],["أَخٌ دَعَانِي فَإِكْرَاماً وَتَلْبِيَةً","قَدْ سَرَّ قَلْبِي ذَاكَ الصَّوْتُ فِي أُذُنِي",3,"ن",2,0],["أخْدَمَ المُلْكَ مُرْهَفاً في مضاء ال","سَيْفِ صَلْتاً وقَدِّهِ المقْدُودِ",4,"د",1,0],["أخٌ دعاني لكي أشاركَهُ","فيما حَوتْه يداهُ محتكما",5,"م",2,0],["أَخُدِعتُ عَنكَ وَأَنتَ بَدرٌ خادِعٌ","لِلَّيلِ عَن ظُلَمٍ لَهُ وَغُيومِ",6,"م",1,0],["أخدودهُ في الرأسِ ضَرْبَةُ أبيضٍ","وقليبُه في القلب طعنةُ أَسمَرا",7,"ر",2,0],["أَخْدَعُ النَّفْسَ بِالْمُنَى وَهْيَ تَأْبَى","وَخِدَاعُ الْمُنَى غِذَاءُ الأَنَامِ",8,"م",1,0],["أَخِداشُ أَنتَ اِبنُ الثَلا","ثَةِ لَيسَ فَوقَهُمو ثَلاثَه",9,"ث",2,1],["اخدموا الشعب بحق","واذكروه باحترام",10,"م",1,1],["أخدتَ بوِترِ الدّينِ مثنى وظَفِرَتْ","يَداكَ، فلَمْ يُفلِتْ عَدوٌّ تُطالِبُهْ",11,"ب",2,0],["أخدوده في الرأس ضربة ُ أبيضٍ","وقلبيه في القلب طعنة أسمرا",12,"ر",2,0],["أخد أجازه ودار منشار","في مصرِ ياكل ويوَلَي",13,"ي",1,0],["أخدّاكَ وردٌ أم ثناياك جوهرُ","وصدغاك مسك أم عذارك عنبرُ",14,"ر",1,1],["أَخدِمُهُ بِالعُريِ وَال","جوعِ وَطولِ التَعَبِ",15,"ب",1,0],["اخدم العلم خدمة النصح وارغب","ان يرى القطر منك مجدا وفخرا",16,"ر",2,0],["أخديجة َ الأَمْجَادِ ‘ كيف أَعُودُ","ومن السِّنين حواجزٌ وسدودُ",17,"د",1,1],["أخديجة الطُّهرِ الذي شهِدَت به","بَطحاءُ مكةَ والأنامُ شُهُودُ",17,"د",1,0],["أخدمت حسنها سويداءَ قلبي","فهي لا تهتدي لسبل الإباقِ",18,"ق",1,0],["اُخدُم صَديقَكَ بَكرَةً وَعَشِيَّةً","وَإِن اِستَعَدَّ لِنَفسِهِ خُدّاما",19,"م",2,1],["اخدع وخن واغدر تفز","فالنصح عقباه النصب",20,"ب",1,0],["أخداعٌ وهل يُعَدُّ خداعاً","ان تُسمَّى حسناؤنا الحسناءَ",21,"ا",2,0],["أَخْدَمْتها مِن فِكرَتي بِوَليدةٍ","تكسى العَباءة لا شفوفَ السندسِ",22,"س",1,0],["أَخدَمتها بِقَصيدةٍ","جِسم البديعِ بِها نَحيف",23,"ف",1,0],["أَخدمت لها قينةً وليدةَ فكرٍ","هيفاءَ تحاكي على التمايُل أغصان",24,"ن",1,0],["أخدعهم بِالمال","وَلين المَقال",25,"ل",1,0],["أخدم أوطاني وقومي ولا","تعصبٌ عندي فاجري معه",26,"ه",1,1],["اخدم على باب مولى إن عصيت عفا","وإن سألت تنل ما شئت من كرم",27,"م",1,0],["أخٌ دميت لمهلكه قلوب","رماها نعيه بالمصميات",28,"ت",1,0],["أخدمُ دَارَ الإمامِ حَسبِي","مِن شَرَفٍ باهرٍ صَميم",29,"م",1,0],["أخدّكَ أم برقُ اليمامة أومضا","أم السيفُ من جفنيك قد شعَ منتضى",30,"ض",2,1],["أُخدم الأَوطان بِالصُدق يَحُل","تُربها تَبراً وَحصباها صَدَف",31,"ف",1,0],["أخدمتُ أشعاريَ باباً أبى","على قَضايا الجودِ أن يُرتجا",32,"ج",2,0],["أخدمنا الأرض والسماء ومن","في الجو من مائه ومن شهبه",33,"ب",2,0],["أخدمهم لا للجزا","فإنني للآل قن",34,"ن",1,0],["إخدموا الأمة مجاناً ينل","كلكم منها ولاءً واحتراما",35,"م",2,0],["أخدوه مني يوم صاح بركبهم","ذاك النفير وجد ذاك الحادي",36,"د",2,0],["أَخِداعاً يا ظَلُوماً جِئتنِي","ومَنيِلا نالَ فَخرَ الغَلَبِ",37,"ب",1,0],["أَخدتُ مِنَ الدُنيا تَجاريبَ أَهلِها","فَما نَفَعَت شَيئاً وَأَغنَت تَجارِبي",38,"ب",2,0],["أخدود ذاك الزهر يزهو زهرة","أم نظم در في الرقيم مخلد",39,"د",1,0],["أخدعتم من دونها فانخدعتم","وعلى الخدع يقتل الأبرياء",40,"ا",2,0]]}