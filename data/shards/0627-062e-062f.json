{"poems":[[53,"قربوهن ليبعدن المغارا","https://www.aldiwan.net/poem30447.html","الرمل"],[53,"لأشكرنك ما ناحت مطوقة","https://www.aldiwan.net/poem30750.html","البسيط"],[86,"لا تلم كفي إذا السيف نبا","https://www.aldiwan.net/poem10698.html","الرمل"],[93,"في حيكم لي قلب جد مرتهن","https://www.aldiwan.net/poem11218.html","البسيط"],[51,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[51,"لم يبكني رسم منزل طسما","https://www.aldiwan.net/poem66036.html","المنسرح"],[45,"قل للجنوب إذا غدوت فأبلغي","https://www.aldiwan.net/poem65668.html","الخفيف"],[80,"هل كان أودع سر قلب محجرا","https://www.aldiwan.net/poem31438.html","الكامل"],[87,"حي مغنى الهوى بوادي الشآم","https://www.aldiwan.net/poem8286.html","الخفيف"],[50,"أخداش أنت ابن الثلاثة","https://www.aldiwan.net/poem64722.html","مجزوء الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85682","الرمل"],[45,"معَ الدّهرِ ظُلمٌ ليسَ يُقلِعُ رَاتِبُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31697",""],[80,"هل كان أودعَ سرَّ قلب محجراً","https://www.poetsgate.com/ViewPoem.aspx?id=3244",""],[136,"الشوق إلى نظم الأزجال","https://www.aldiwan.net/poem48847.html","عموديه"],[205,"أخداك ورد أم ثناياك جوهر","https://www.aldiwan.net/poem53264.html","الطويل"],[236,"واعجبي وحادث الد","https://www.aldiwan.net/poem32166.html","مجزوء الرجز"],[286,"يا رئيس الخطابة ازددت قدرا","https://www.aldiwan.net/poem39413.html","الخفيف"],[401,"رسالة اعتذار إلى أم المؤمنين خديجة (رضي الله عنها)","https://www.aldiwan.net/poem10309.html","عموديه"],[465,"هذه حلبة الهوى والفراق","https://www.aldiwan.net/poem3481.html","عموديه"],[469,"اخدم صديقك بكرة وعشية","https://www.aldiwan.net/poem59704.html","الكامل"],[565,"دعني أخي من الأدب","https://www.aldiwan.net/poem823.html",""]],"verses":[["أَخدِموهُنَّ الغَواني غَيرَةً","إِنَّهُم كانوا عَلى المَجدِ غَيارى",0,"ر",2,0],["أَخدَمتَني نُوَبَ الأَيّامِ طائِعَةً","وَكانَ كُلَّ الرِضى أَن آمَنَ النُوَبا",1,"ب",2,0],["أَخدِمُ الجَرحى وَأَقضي حَقَّهُم","وَأُواسي في الوَغى مَن نُكِبا",2,"ب",2,0],["أَخٌ دَعَانِي فَإِكْرَاماً وَتَلْبِيَةً","قَدْ سَرَّ قَلْبِي ذَاكَ الصَّوْتُ فِي أُذُنِي",3,"ن",2,0],["أخْدَمَ المُلْكَ مُرْهَفاً في مضاء ال","سَيْفِ صَلْتاً وقَدِّهِ المقْدُودِ",4,"د",1,0],["أخٌ دعاني لكي أشاركَهُ","فيما حَوتْه يداهُ محتكما",5,"م",2,0],["أَخُدِعتُ عَنكَ وَأَنتَ بَدرٌ خادِعٌ","لِلَّيلِ عَن ظُلَمٍ لَهُ وَغُيومِ",6,"م",1,0],["أخدودهُ في الرأسِ ضَرْبَةُ أبيضٍ","وقليبُه في القلب طعنةُ أَسمَرا",7,"ر",2,0],["أَخْدَعُ النَّفْسَ بِالْمُنَى وَهْيَ تَأْبَى","وَخِدَاعُ الْمُنَى غِذَاءُ الأَنَامِ",8,"م",1,0],["أَخِداشُ أَنتَ اِبنُ الثَلا","ثَةِ لَيسَ فَوقَهُمو ثَلاثَه",9,"ث",2,1],["اخدموا الشعب بحق","واذكروه باحترام",10,"م",1,1],["أخدتَ بوِترِ الدّينِ مثنى وظَفِرَتْ","يَداكَ، فلَمْ يُفلِتْ عَدوٌّ تُطالِبُهْ",11,"ب",2,0],["أخدوده في الرأس ضربة ُ أبيضٍ","وقلبيه في القلب طعنة أسمرا",12,"ر",2,0],["أخد أجازه ودار منشار","في مصرِ ياكل ويوَلَي",13,"ي",1,0],["أخدّاكَ وردٌ أم ثناياك جوهرُ","وصدغاك مسك أم عذارك عنبرُ",14,"ر",1,1],["أَخدِمُهُ بِالعُريِ وَال","جوعِ وَطولِ التَعَبِ",15,"ب",1,0],["اخدم العلم خدمة النصح وارغب","ان يرى القطر منك مجدا وفخرا",16,"ر",2,0],["أخديجة َ الأَمْجَادِ ‘ كيف أَعُودُ","ومن السِّنين حواجزٌ وسدودُ",17,"د",1,1],["أخديجة الطُّهرِ الذي شهِدَت به","بَطحاءُ مكةَ والأنامُ شُهُودُ",17,"د",1,0],["أخدمت حسنها سويداءَ قلبي","فهي لا تهتدي لسبل الإباقِ",18,"ق",1,0],["اُخدُم صَديقَكَ بَكرَةً وَعَشِيَّةً","وَإِن اِستَعَدَّ لِنَفسِهِ خُدّاما",19,"م",2,1],["اخدع وخن واغدر تفز","فالنصح عقباه النصب",20,"ب",1,0]]}