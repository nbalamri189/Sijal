{"poems":[[95,"سلام على القدس ومن به","https://www.aldiwan.net/poem11150.html","الطويل"],[72,"لكم أينما كنتم مكان وإمكان","https://www.aldiwan.net/poem42683.html","الطويل"],[69,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16681","السريع"],[0,"أجارتنا ان الخطوب تنوب","https://www.poetsgate.com/ViewPoem.aspx?id=6446",""],[124,"أناديك لو رد النداء رميم","https://www.aldiwan.net/poem49281.html","الطويل"],[139,"تأمل رعاك الله حسن المواكب","https://www.aldiwan.net/poem49034.html","الطويل"],[302,"وإني غريب بين قومي وجيرتي","https://www.aldiwan.net/poem32946.html","الطويل"],[409,"حمام بأغصان الرياض ترنما","https://www.aldiwan.net/poem33421.html","الطويل"],[412,"جسمي نحيل بالحب والحب","https://www.aldiwan.net/poem50202.html","المنسرح"],[518,"لعمرك ما قرب الديار بنافع","https://www.aldiwan.net/poem67788.html","الطويل"],[563,"لمائه كلنا أواني","https://www.aldiwan.net/poem33828.html","مخلع البسيط"],[563,"خيطان خيط أبيض وهو الوجود","https://www.aldiwan.net/poem34578.html","الرجز"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54029","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48768","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48821","البسيط"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133831","الوافر"],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101901","الرجز"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100231","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199919","الوافر"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127061","البسيط"],[4208,"","https://poetry.dctabudhabi.ae/diwan/poem/110724","البسيط"],[5459,"أسرى التحرر","https://www.poetsgate.com/ViewPoem.aspx?id=204380",""],[5561,"حُكْمُ القضاء","https://www.poetsgate.com/ViewPoem.aspx?id=192908",""],[5561,"ومضة شوق","https://www.poetsgate.com/ViewPoem.aspx?id=193806",""],[5616,"أماه","https://www.poetsgate.com/ViewPoem.aspx?id=203232",""],[6102,"صراحة مفرطة ...","https://www.poetsgate.com/ViewPoem.aspx?id=184430",""],[5309,"بلادي هوى الدنيا ومأوى الغرائب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573554",""]],"verses":[["وَلَيْسَ غَرِيباً فِيهِ إِلاَّ بشَخْصِهِ","فَتًى زَارَهُ قَبْلاً مِرَاراً بِقَلْبِهِ",0,"ب",2,0],["وَلَيسَ غَريباً مَن إِلَيكَ اِغتِرابُهُ","لَهُ مِنهُ أَهلٌ حَيثُ كانَ وَأَوطانُ",1,"ن",1,0],["وليسَ غيرُكَ لِي مَوْلىً أُؤَمِّلُهُ","بَعْدَ الإلهِ وَحَسْبِي مِنكَ تَأْمِيلُ",2,"ل",1,0],["وليسَ غِرْباني بمَزْجُورَة","ما أنا من ذي الخِفّةِ الأسْحَم",3,"م",1,0],["وليس غريبا من تناءت دياره","ولكن من وارى التراب غريب",4,"ب",1,0],["وليس غبين القوم من غاله الردى","ولكن من يخطيه فهو مقيم",5,"م",1,0],["وليس غريباً فهو يعزَى لأحمدٍ","حميدِ السجايا الحبر بحرِ الغرائبِ",6,"ب",1,0],["وَلَيسَ غَريبُ الدار من راحَ نائياً","عن الأهل لكن من غَدا نائي الشكلِ",7,"ل",1,0],["وليس غريب الدار من صار منجداً","ولا من تراه في التهائم مُتْهِماً",8,"م",2,0],["وَلَيسَ غَيرَ الأَظفارِ بَينَهُما","مِن أَسمَرٍ ذابِلٍ وَمِن عَضَبِ",9,"ب",1,0],["وليس غريباً من تناءت دياره","ولكن من يجفى فذاك غريب",10,"ب",1,0],["وليس غير الوجود فيها","بقائم والجميع فاني",11,"ن",2,0],["وليس غير الأبيض الخيط الذي","هو الوجود الحق من فجر العمود",12,"د",1,0],["وليس غريباً أن مثلي يحبكم","فأنتم لدى الإنصاف أفضل إنسان",13,"ن",1,0],["وليس غير الذي ترضى بمنتظرٍ","وليس غير الذي ترجو بمرتقب",14,"ب",1,0],["وليس غير الذي ضحّى بمهجته","للشعب أولى بتمثال وتذكار",15,"ر",1,0],["وليس غريمكم وغداً غريبا","ولا ذاك العتي من اليهود",16,"د",1,0],["وليس غير السبعة المقرره","معهودة في الشرعة المطهره",17,"ه",1,0],["وليس غريب أن أبثك لوعة","ولكن كتمان المحب غريب",18,"ب",1,0],["وليس غناهم المنسي إلا","نداء الفجر حي على الفلاح",19,"ح",1,0],["وليس غير الفرات العذب فيك لنا","من كوثر طاب حتى الحشر مرعاك",20,"ك",1,0],["وليس غيرك يا من يستعان به","في الكون يعدى لكشف الضر والعلل",21,"ل",1,0],["وليس غريبًا أن نعودَ لغربةٍ","وتعلُوَ أصواتُ الزنيمِ المخادعِ",22,"ع",1,0],["وليس غريبا أن تزيدَ مخاوفي","وعندي فؤادٌ في هواكِ نجيب",23,"ب",1,0],["وليس غيرك يا نبع الهدى علم","حتى يُشفَّع فيك العبد والحرُّ",24,"ر",1,0],["وليسَ غيرك يا أماه من رتقت!","ثوبي وأقرب من صاحبت ما رتقوا!",25,"ق",3,0],["وَلَيسَ غَرِيبًا أَنَّ لِلرُّعبِ رِعدَةً","وَأَنَّ جِراءَ الكَلبِ دَيدَنُها سُعرُ",26,"ر",1,0],["وَلَيسَ غِنِيٌّ لا يُؤَدّي ضَريبَةً","كَمِثلِ الَّذي يُرديهِ حَملُ المَتاعِبِ",27,"ب",1,0]]}