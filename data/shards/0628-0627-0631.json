لطارق المتأوب","https://www.aldiwan.net/poem4636.html","الطويل"],[475,"حي عني منحني الوادي وأثله","https://www.aldiwan.net/poem15200.html","الخفيف"],[475,"كم دون مسراك من بيد وأخطار","https://www.aldiwan.net/poem15202.html","البسيط"],[477,"وحق سيف أنور","https://www.aldiwan.net/poem37204.html","مجزوء الرجز"],[498,"رفرف غصن البان لا بمرق","https://www.aldiwan.net/poem37963.html","الرجز"],[498,"أيها المستحلف الليل أفق","https://www.aldiwan.net/poem38032.html","الرمل"],[498,"إن معنى الهيام بالأولياء","https://www.aldiwan.net/poem38101.html","الخفيف"],[513,"أعندك أن وجدي واكتئابي","https://www.aldiwan.net/poem12008.html","الوافر"],[549,"فما ماء مزن بات جفن سحابة","https://www.aldiwan.net/poem47897.html","الطويل"],[551,"طرق الخيال فهاج لي بلبالا","https://www.aldiwan.net/poem68406.html","الكامل"],[556,"صبغة الله وجود الله","https://www.aldiwan.net/poem33628.html","الرمل"],[560,"قف بالمطايا على أنجاد ذي سلم","https://www.aldiwan.net/poem52785.html","البسيط"],[567,"ونار دعوت المعتفين بضوئها","https://www.aldiwan.net/poem52006.html","الطويل"],[569,"بارك فيك الله من غلام","https://www.aldiwan.net/poem2056.html","الرجز"]],"verses":[["بِأَروَعَ مِن ظَمياءَ قَلباً وَمُهجَةً","غَداةَ سَمِعنا لِلتَفَرُّقِ داعِيا",0,"ي",2,0],["بِأَربُقَ قَد أَدارَ لَكُم رَحاها","مَدارَ الطَودِ مَرداةً طَحونا",1,"ن",2,0],["بِأُرجوحَةٍ بَينَ الخَصاصَةِ وَالغِنى","وَمَنزِلَةٍ بَينَ الشَقاوَةِ وَالنُعمى",2,"م",2,0],["بِأَربَقَ حَطَّ عارِضَهُ وَأَجلى","عَنِ الأَعداءِ وَالأَعداءُ هامُ",3,"م",1,0],["بارِقاً مُزنُهُ أَطا","لَ اِستِناناً وَأَعرَضا",4,"ض",2,0],["بِأَروَعَ مَصبوبٍ عَلى قالِبِ الحَيا","وَأَبيَضَ مَطبوعٍ عَلى سِكَّةِ البَدرِ",5,"ر",1,0],["بِأَرماحٍ خُلِقنَ مِنَ المَنايا","وَأَسيافٍ طُبِعنَ عَلى الجِلادِ",6,"د",1,0],["بأرْوَعَ منْ آلائِهِ البَحْرُ مُطْرِقٌ","حَياءً ومِنْ لأْلائِهِ البَدْرُ قابِسُ",7,"س",1,0],["بأرْوَعَ فَضْفاضِ الرِّداءِ مُذَرَّبٍ","أغِرَّةَ عَزْمٍ للخُطوبِ مُدَوِّخِ",8,"خ",1,0],["بأرجائِهِ مما اقْتَنَيْتُمْ نَزائِعٌ","يُباحُ عليهنّ الحِمى المُتَخَوَّفُ",9,"ف",1,0],["بأرْضٍ كأنّ الرّوْضَ في جَنَباتِها","يجُرُّ ذُيولَ العَصْبِ فوقَ أَكامِ",10,"م",1,0],["بأَروعَ مِن آلِ النَّبيِّ إذا انْتَمى","أفاضَ على الدُّنيا عُلاً ومساعِيا",11,"ي",2,0],["بِأَرضٍ تَرَدّى الماءُ مِن هَضَباتِه","فَأَصبَحَ فيها نَبتُها يَتَوَهَّجُ",12,"ج",1,0],["بَارِكْ عَلَيْهَا بِذِكْرِ اللهِ مِنْ قِصَصِ","وَاذْكُر بِهَا مَا أَتَى فِي سُورَةِ الْقَصَصِ",13,"ص",1,1],["بارَكَ المَطرانُ في أَعمالِهِم","فَسَلوهُ بارَكَ القَومَ عَلاما",14,"م",2,0],["بِأَرضِ كولُمبَ أَبطالٌ غَطارِفَةٌ","أُسدٌ جِياعٌ إِذا ما ووثِبوا وَثَبوا",15,"ب",3,0],["بارِك لِعَبدِكَ في الدُمو","عِ فَإِنَّها نِعمَ المُعين",16,"ن",1,0],["بِأَرضٍ يُحارُ الرَكبُ في فَلَواتِها","عَلى أَنَّ هادي القَومِ فيها القَطا الكَدري",17,"ر",2,0],["بِأَرضٍ لا الكِلابُ بِها كِلابٌ","وَلا الناسُ السَراةُ هُناكَ ناسُ",18,"س",1,0],["بَارَكَ اللهُ فِيكُمَا فَارْغَدَا عَيْش","اً وَذُوقَا صَفْوَ الزَّمَان وَأَمْنَهْ",19,"ن",2,0],["بَارَكَ اللهُ فِي العَرُوسَيْنِ","وَلْيَسْتَقْبِلا عَهْدَ غِبْطَةٍ وَأَمَانِ",20,"ن",1,0],["بَارَكَ اللهُ فِيكُمو وَعَلَيْكُمُ","بِدُعَاءِ الجَنَانِ قَبْلَ اللِّسَانِ",21,"ن",1,0],["بَارَكَ اللهُ فِي الشَّبَابِ وَمَا فِي","ذَخْرِهِ مِنْ صَلابَةٍ وَعَزِيمِ",22,"م",1,0],["بَارَكَ اللهُ فِي قِرَانِ النَّجِيبَ","يْنِ وَفِي يَوْمِهِ الأَغْرِّ الوَسِيمِ",23,"م",1,1],["بَارَكَ اللهُ فِيكُمُ وَسَقَى","أَغْرَاسَكُمْ كُلُّ ضَاحِكٍ هَطَّالِ",24,"ل",1,0],["بارى الرِياحَ فَأَعطى وَهيَ جارِيَةٌ","حَتّى إِذا وَقَفَت أَعطى وَلَم يَقِفِ",25,"ف",1,0],["بِأرقَطَ مَحدودٍ وَثَطٍّ كِلاهُما","عَلى وَجهِهِ سِيما اِمرِئِ القَيسِ غَيرِ سائقِ",26,"ق",1,0],["بِأَرضٍ تَرى فيها الحُبارى كَأَنَّها","قَلوصٌ أَضَلَّتها بِعِكمَينِ عيرُها",27,"ر",3,0],["بِأَرضٍ هِجانِ التُربِ وَسِميَّةِ الثَّرى","عَذاةٍ نَأَت عَنها المُلوحَةُ وَالبَحرُ",28,"ر",1,0],["بارعن كالجبال تضيق عنه","لظاهرة إذا ورد البحورُ",29,"ر",1,1],["بِأرحام شَوَابِكَ عالِمَات","إلَى أيِّ المَنَاسِبِ يَلتَقِينَا",30,"ن",2,0],["بأروع ناصريِّ الذكر ما في","رواية فضله مثقال رين",31,"ن",1,0],["باردُ الرأسِ واستُهُ","تتلظَّى لها وهَجْ",32,"ج",1,0],["بِأرْعَنَ لَوْ يُرْمَى بِهِ عُرْضُ يَذْبُلٍ","لأصْبَحَ مَرْسَى صَخْرِهِ وهْوَ جَدْجَدُ",33,"د",1,0],["بآرائه أضحَتْ سيُوفكَ تُنْتَضى","فَتُغْمَدُ من هَامِ العدا في غُمُودِها",34,"د",3,0],["بِأَرْبى على الأقران مني صولةً","وقد أنذرَ التجريبُ من كان يُنذَر",35,"ر",1,0],["بأرعنَ جرّارٍ عِراضٍ صدورُهُ","كثافٍ نَواحيه ضخام كَرادِسه",36,"س",2,0],["بارَ حمدُ الرجال بين ملوك ال","ناس حتى أقمت للحمد سوقا",37,"ق",2,0],["بِأَرضٍ لا أَنيسَ بِها يَبابٍ","وَأَمسِلَةٍ مَدافِعُها خَليفُ",38,"ف",1,0],["بِأَريِ الَّتي تَهوي إِلى كُلِّ مُغرِبٍ","إِذا اِصفَرَّ ليطُ الشَمسِ حانَ اِنقِلابُها",39,"ب",3,0],["بِأَريِ الِّتي تَأرِيِ اليَعاسيبُ أَصبَحَت","إِلى شاهِقٍ دونَ السَماءِ ذُؤابُها",39,"ب",3,0],["بِأَرضٍ يَعرِفونَ بِها الشَمَرذى","نُطاعِنُهُم بِفِتيانٍ عِتاقِ",40,"ق",1,0],["باروا جُمادى بِشيزاهُم مُكَلَّلَةً","فيها خَليطانِ واري الشَحمِ وَالكَبِدِ",41,"د",1,0],["باريسُ أُعجوبَةُ الدُنيا وَجَنَّتُها","وَرَبَّةُ الحُسنِ مَطروقا وَمُبتَكَرا",42,"ر",2,0],["بارِعٌ في كُلِّ ما تَط","لُبُ مِنهُ وَتَرومُ",43,"م",1,0],["بارِدَةً ثَقيلَةً","مُظلِمَةً مُنكَدِرَه",44,"ر",2,0],["بارثات يفعلن غير مريدات","ومفعولهن غير مراد",45,"د",1,0],["بِأَرضِ الجيزَةِ اِجتازَ الغَمامُ","وَحَلَّ سَماءَها البَدرُ التَمامُ",46,"م",1,1],["بارَكَ اللَهُ لَها في فَرعِها","وَقَضى الخَيرَ لِمِصرٍ في جَناها",47,"ا",3,0],["بارِدٌ وَمِن عَجَبٍ","يُشتَهى وَيُطَّلَبُ",48,"ب",1,0],["بِأَرضٍ تَهلِكُ الأَشواطُ فيها","إِذا مُلِئَت مِنَ الرَكضِ الفُروجُ",49,"ج",1,0],["بِأَرضٍ ما اِشتَهَيتَ رَأَيتَ فيها","فَلَيسَ يَفوتُها إِلّا الكَرامُ",50,"م",1,0],["بارتْ عليَّ بضائِعي فكأنَّنِي","مستبضِعٌ طِيباً إِلى كَنَّاسِ",51,"س",1,0],["بارزتُ دهري وهو قَرْنِي فانتضَى","في السُّودِ من فَوْدَيَّ بيضَ صفائحِ",52,"ح",1,1],["بارَكَ اللَهُ لِلخَليفَةِ في الفَت","حِ الجَنوبِيِّ وَالبِناءِ الجَديدِ",53,"د",1,0],["بارَكَ اللَهُ لِلخَليفَةِ في المُل","كِ الَّذي حازَهُ لَهُ المِقدارُ",54,"ر",1,0],["بِأَروَعَ مِن طَيِّ كَأَنَّ قَميصَهُ","يُزَرُّ عَلى الشَيخَينِ زَيدٍ وَحاتِمِ",55,"م",1,0],["بِأَرباقِ الحَميرِ مُقَوِّدوها","وَما يَدرونَ ما قودُ الجِيادِ",56,"د",1,0],["بِأَرحُلِنا يَخ