{"poems":[[88,"إيه يا ليل هل شهدت المصابا","https://www.aldiwan.net/poem10378.html","الخفيف"],[95,"أنا في الروض ساهر وهو نائم","https://www.aldiwan.net/poem11410.html","الخفيف"],[49,"هل ترى النعمة دامت","https://www.aldiwan.net/poem25264.html","مجزوء الرمل"],[53,"أرقت كأني بت ليلي على الجمر","https://www.aldiwan.net/poem62871.html","الطويل"],[94,"يا موت قد مزقت صدري","https://www.aldiwan.net/poem38940.html","مجزوء الكامل"],[87,"الأمر آل أحسن المآل","https://www.aldiwan.net/poem7912.html","الرجز"],[228,"لا تنوحي على ذهاب العميد","https://www.aldiwan.net/poem41884.html","الخفيف"],[295,"لا تلم أن هجرت أيام أنسى","https://www.aldiwan.net/poem11670.html","الخفيف"],[398,"كنت دهرا أقول بالاستطاعه","https://www.aldiwan.net/poem53503.html","الخفيف"],[415,"لا زلت يا ملك الإسلام في نعم","https://www.aldiwan.net/poem31697.html","عموديه"],[505,"ما أحيلي ليلى وما أبهاها","https://www.aldiwan.net/poem37707.html","الخفيف"],[563,"أيها الطلعة التي أخذتنا","https://www.aldiwan.net/poem34407.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122761","المتقارب"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104069","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87218","الوافر"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56145","الكامل"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137866",""],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79998","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137940",""],[2555,"","https://poetry.dctabudhabi.ae/diwan/poem/147063","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201386","الطويل"],[3317,"","https://poetry.dctabudhabi.ae/diwan/poem/35865","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138602",""],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133267","الوافر"],[4233,"","https://poetry.dctabudhabi.ae/diwan/poem/177995","الطويل"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139266","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139579",""],[5019,"يا أيها العارف المحكول ناظره","https://www.poetsgate.com/ViewPoem.aspx?id=157050",""],[5096,"مرثية القائد صالح 1","https://www.poetsgate.com/ViewPoem.aspx?id=211322",""],[4045,"أعينى لقد جار الزمان فجودي","https://www.poetsgate.com/ViewPoem.aspx?id=200275",""],[5431,"لقد هاج بي وجدٌ عظيم مؤججُ","https://www.poetsgate.com/ViewPoem.aspx?id=188944",""],[5690,"نوائب الدهر إنذارٌ إلى الأممِ","https://www.poetsgate.com/ViewPoem.aspx?id=172180",""],[5842,"الموت/ صباح الحكيم","https://www.poetsgate.com/ViewPoem.aspx?id=128792",""],[5939,"الرجل الحديدي","https://www.poetsgate.com/ViewPoem.aspx?id=188441",""]],"verses":[["فَفَقَدتُم عَلى الحَوادِثِ جَفناً","وَفَقَدنا المُهَنَّدَ القِرضابا",0,"ب",2,0],["فَفَقَدْتِ الْحَيَاةَ فَقْدَ نَفِيسٍ","تَزْدَرِيهِ نَفْسُ الكَرِيمِ الحَازِمْ",1,"م",1,0],["فَفَقيرٌ مِن غَنِيٍّ","وَغَنِيٍّ مِن فَقيرِ",2,"ر",1,0],["ففقرٌ من العقل المُسدَّد للهدى","وفقرٌ من المال المشدِّد للأزر",3,"ر",1,0],["فَفَقَدْتُ روحاً طاهراً","شهماً يَجِيشُ بكلِّ خَيْرِ",4,"ر",1,0],["فَفَقدت بِهِ القَرى حَياها","وَماتَ بِالأَنبار مَن أَحياها",5,"ه",2,0],["فَفَقَدتَ العَينَ البَصيرَةَ حِفظاً","لِمُراعاةِ حرمَة في اللحودِ",6,"د",1,0],["ففقدنا الحفاظ والمجد والنبل","وصرنا عبيد ترك وفرس",7,"س",1,0],["فَفَقَدتُ اِستِطاعَتي في هَوى ظَب","يٍ فَسَمعاً لِلمُجبَرين وَطاعَه",8,"ه",1,0],["ففق بنصر على الكفار إنهم","يرديهم المهلكان الغدر والأشر",9,"ر",1,0],["ففقدنا الوجود منا هياما","واصطلاماً لما وجدنا هداها",10,"ا",3,0],["ففقدنا بنوره ما لدينا","إن شهدناه بالجمال اكتفينا",11,"ن",2,0],["فَفَقرُ المَسيحِ أعزَّ المَسيحَ","وَنَفسُ عِصامٍ أَجلَّت عِِصاما",12,"م",2,0],["فَفقدتُ من نَفسي لفرطِ تلهُّفي","نَفس الحياةِ وقلتُ من أبكاكِ",13,"ك",1,0],["فَفقت وَأَنتَ في مَهد التَهاني","بِحوز مَعارف خدنا وَكَهلا",14,"ل",2,0],["ففقدتها يوماً فبتُّ انوحها","والأنف بات يصبّ اغزر دمعة",15,"ه",1,0],["ففقدنا به بدرا بلبنان غائبا","فناح له معنا من لشوق اقصاه",16,"ا",2,0],["ففقدتُه فقدَ النواظر ضوءها","وعججتُ عجَّة مثقلٍ مجهود",17,"د",1,0],["ففقدتَ الشبابَ حين دعاني","شَيبُ راسي واللحيةُ البيضاء",18,"ا",2,0],["ففقدها جرعهم شربةً","أمرَّ منها قطُّ لم يشربوا",19,"ب",3,0],["ففقر الفتى خلف السلامة كالغنا","ولا خير في نفعٍ على عقبه صفع",20,"ع",1,0],["ففقري وأسمالي وفضلي وعزتي","دروس لتحقير الغنى والمظاهر",21,"ر",1,0],["فَفَقرُكَ مَذمومٌ عَدا الفَقرُ لِلَّذي","هُوَ اللَهُ رَبّي فَهوَ مِن أَحسَنِ الخُلُقِ",22,"ق",1,0],["ففقدان انصار وتصريع صفوة","يراها واطفال لديه تقتل",23,"ل",1,0],["ففقت الأنبيا بلواء حمد","بيوم أنت فيه ملتجانا",24,"ن",2,0],["ففقد صديق الصدق فيها أحلني","محل غريب داره الدهر تبرح",25,"ح",1,0],["ففقر المرء ميتته","لذا تغدو فترحمه",26,"م",2,0],["فَفُق وعلاك ملجأ كل مجدٍ","إليه المجد والمعروف عاجا",27,"ج",2,0],["ففقد هذا الولي من كيس أهل هدى","لذا ترى الكل كالثكلا وخنساء",28,"ا",2,0],["ففَقِيدُنا هُو \"صالحٌ\" أنّى لنَا","بفَجِيعَةٍ هُزَّتْ لَها الأرْكانُ",29,"ن",1,0],["ففقدك ياهيلان كدّر عيشتى","وأخلق من دنياي كلّ جديد",30,"د",1,0],["ففقرعظيم والشعوب ذليلة","إلى ساحةالاهمال دوما تُدحرجُ",31,"ج",1,0],["ففقت من سكرتي حبي ومن شئمي","يدي على جرح قلبي صحت واندمي",32,"م",2,0],["فَفقدت همسا عاطرا","وجهاً لَطيفاً كالقمَرْ",33,"ر",1,0],["فَفَقرُ دِماكِ زادَ القلبَ بُخلاً","فكيفَ هَوايَ يَجري في الوريدِ؟",34,"د",1,0]]}