{"poems":[[58,"مولاتنا يا غلام مبتكره","https://www.aldiwan.net/poem58590.html","المنسرح"],[234,"أيها المزجي مطيته","https://www.aldiwan.net/poem51084.html","المديد"],[556,"كل يوم غريبة للخطوب","https://www.aldiwan.net/poem48056.html","الخفيف"],[563,"هذه الأثواب والخلع","https://www.aldiwan.net/poem34397.html","المديد"],[1416,"","https://poetry.dctabudhabi.ae/diwan/poem/199203","الخفيف"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11881","المديد"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77247","الرمل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110612","الرمل"],[240,"","https://poetry.dctabudhabi.ae/diwan/poem/13018","الرمل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138647",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138465",""],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118741","الرمل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86392","الرمل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97091","الخفيف"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58034","البسيط"],[4625,"","https://poetry.dctabudhabi.ae/diwan/poem/124118","الرمل"]],"verses":[["عُجْ عَبَراتِ المُدامِ نَحوِيَ مِنْ","عَشْرٍ وعِشْرينَ واثْنَتَيْ عَشَرَهْ",0,"ر",2,0],["عُجْ على ماء الفُرَات وقِف","كوقوف الصبّ يعتِذر",1,"ر",1,0],["عُجْ عَلى هذهِ الدّيار التي لي","س لداعٍ بأهلها من مُجيبِ",2,"ب",1,0],["عج على الوادي المقدس بي","وتأدب ههنا سبع",3,"ع",1,0],["عُجْ على النَّيربَيْنِ فالسَّهم فالمِز","ز ةِ مسترسلاً بغير احتشام",4,"م",1,0],["عِجّ عَلى عَباسَ تَلقَ فَتىً","غَيرَ نَكريشٍ وَلا بَذَجِ",5,"ج",1,1],["عُج عَلى الرَملِ بِنا","فَهُناكَ الأَمَلُ",6,"ل",1,0],["عج على الوادي بجرعاء الحمى","واحبس الركب بوادي الأجرع",7,"ع",1,1],["عُج عَلى رَبعِ أَبي الفَض","لِ تَعُج خَيرَ مَعاجِ",8,"ج",1,0],["عج على وادي الغريين وقف","حول قبر المرتضى مستلما",9,"م",2,0],["عج على طيبة واقصد مرقداً","حل فيه خير من صلى وصاما",10,"م",2,0],["عج على أرض الحمى مستطلعاً","خبر الساكن فيه كيف صار",11,"ر",1,0],["عج على الزوراء واحبس ساعة","فإليها تقطع الفج العميقا",12,"ق",2,0],["عج على طيبة ففيها قبور","من شذاها طابت صباً وشمال",13,"ل",1,0],["عُجْ عن وِصالِ ذوات الدَّلِّ والحَوَرِ","المائِسات ذواتِ الرونقِ النضرِ",14,"ر",1,1],["عج على بيت رفيع سمكه","واسعاً أرجاؤه فيه الرغب",15,"ب",1,0]]}