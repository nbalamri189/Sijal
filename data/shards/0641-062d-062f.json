صره","https://www.poetsgate.com/ViewPoem.aspx?id=200591",""],[5748,"كتبتُ ولو أنني أستطيعُ","https://www.poetsgate.com/ViewPoem.aspx?id=26152",""],[1089,"أشرت إليه هل علمتَ مودّتي","https://www.poetsgate.com/ViewPoem.aspx?id=152941",""],[5759,"سجى الليل","https://www.poetsgate.com/ViewPoem.aspx?id=213405",""],[469,"جزتَ في المجد والفعال الشريفِ","https://www.poetsgate.com/ViewPoem.aspx?id=76859",""],[5906,"أُمّة وأئمة","https://www.poetsgate.com/ViewPoem.aspx?id=188216",""],[5906,"سُكَّر","https://www.poetsgate.com/ViewPoem.aspx?id=188224",""],[6102,"نِهايَةُ المُسَلسَل","https://www.poetsgate.com/ViewPoem.aspx?id=182768",""],[6213,"حبٌّ مارد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76278&r=&rc=35",""]],"verses":[["فَحَدَاكَ تَوفِيقُ الإِلاَهِ لِمَنْصِبٍ","مَثْوَاكَ مَثْوَاهُ وَغِيلُكَ غِيلُهُ",0,"ل",2,0],["فحدّقَ منْ أجْفانِهِ نرْجِسَ الرُّبَى","وحدّدَ منْ آذانِهِ ورَقَ كُرّاسِ",1,"س",1,0],["فَحَديثُهُ السِحرُ الحَلالُ وَمَدحُهُ","مَحضُ الصَحيحِ وَحَلَّةُ المُدّاحِ",2,"ح",1,0],["فحَداها بوارجاً تملأ البح","ر وقاراً طوراً وطوراً بُوسا",3,"س",2,0],["فَحَدَّرَ العُصمَ مِن عَمايَةَ لِلسَه","لِ وَقَضّى بِصاحَةَ الأَرَبا",4,"ب",2,0],["فَحَدِّثني وَقُل لي أَيُّ","شَيءٍ أَنتَ في الدُنيا",5,"ي",2,0],["فَحَديثي غَيرُ ما قَد","ظَنَّهُ الواشي وَقَدَّر",6,"ر",1,0],["فَحَدِّث فَقَد يُهتَدى بِالحَديثِ","وَخَبِّر فَقَد يُؤتَسى بِالخَبَر",7,"ر",1,0],["فَحِد في مُلتَقى الخَيلَينِ عَنهُ","وَإِن كُنتَ الخُبَعثِنَةَ الشِحيعا",8,"ع",2,0],["فَحَدَّثَ كاذِباً عَنهُ","وَقالَ بِغَيرِ ما شَعَرا",9,"ر",2,0],["فَحَدَّثتُ الظِباءَ مُؤَزَّراتٍ","أَلا لِلَّهِ ما مَنَعَ الإِزارُ",10,"ر",1,0],["فَحَدَّثتُهُمُ أَنّي","عَلى الرَجعَةِ آلَيتُ",11,"ت",1,0],["فَحَدِّثني بِما أَدعو","كَ طولَ اللَيلِ مُنكَبّا",12,"ب",2,0],["فَحَدِّثني فَقَد نُقِّصتَ عُمراً","وَكِنديراً أَقَلَّ فَتىً تَشاءُ",13,"ا",2,0],["فَحَدِّثوني بِغَيرِ مَينٍ","عَنِ الثُرَيّا وَعَن سُهاها",14,"ا",3,0],["فحديث دمعي عن تلهب مهجتي","ذاكي اللظى وحديث دمعك بادر",15,"ر",1,0],["فَحَدِّثْ عَنْ مَزَايَاهُ الغوَالي","وَحَدِّثْ عَنْ سَجَايَاهُ العِتَاقِ",16,"ق",1,0],["فحداك توفيق الإله لمنصب","مثواك مثواه وغيلك غيله",17,"ل",2,0],["فحدّق يستقصي مفاتن جسمها","كما يتقصّى أحرف السطر قاريء",18,"ي",2,0],["فحدِّثْ فقد أذنِنت بالسَماع","لحلو حديثِك آذانه",19,"ن",2,0],["فحد الخمر مهما اشتط","جلد مترف راق",20,"ق",1,0],["فَحَدَّثني حتى سَئِمتُ حَدِيثَهُ","وَبيَّنتُ عكسض القصدِ مِنهُ وَطَردَهُ",21,"د",2,0],["فحديثها راحٌ يريحُ ذوي الهوى","فاذكر هناك أباطحاً ومعالما",22,"م",2,0],["فحدِّث عن دلائله ففيها","شفاء للنُّهى من كلِّ داء",23,"ا",2,0],["فَحَدَّرَتْ مُقْلَتا عَيْني العقِيقَ عَلَى","خَدٍّ حَكى ذَهباً مِنْهُ بِصُفْرَتِهِ",24,"ت",2,0],["فحديثُهم عندي ألذ","ذ من التمتّع بالمدام",25,"م",1,0],["فَحَداني هذا على خيرِ مدحٍ","هزّ منه الأرواح نعم الحداءُ",26,"ا",2,0],["فحداني إلى الفتاة شعور","لاقت الروح منه ما أضناها",27,"ا",3,0],["فحديث نداه يداه غدت","لعطا ترويه وتسنده",28,"د",2,0],["فحديثُها كالبُرء أو كَرِضا الْ","مَحْبُوب بعد السُّخْط والهجر",29,"ر",1,0],["فَحَديثُهُ بِسَماحِهِ وَكِفاحِهِ","في كَسبِهِ عالي العُلا مَأثورُ",30,"ر",1,0],["فَحَدَّثتُ نَفسي بالغِنى غيرَ كاذِبٍ","لأَنَّ بَني أَيُّوبَ هُمْ مَنْبعُ النَّدا",31,"د",2,0],["فَحَدُّ مَن حادَ عَنها","في الناسِ حَدُّ البَهيمَه",32,"م",2,0],["فَحدّث عَن البَحر العُباب بِكُلّ ما","رَواهُ لَنا راوي السحاب عَن العينِ",33,"ن",1,0],["فحديثهم من بين أخ","بار الورى معشوق أذني",34,"ن",2,0],["فحدا الحادي لسقيا عهدكم","عارضاً إنْ ساقه البرق كبا",35,"ب",2,0],["فحَدِّثْ عن مكارمه فإنِّي","لتعْجِبُني أحاديثُ الكرام",36,"م",1,0],["فحِدْ عني يا لائ","مُ أو فاسمعْ وخُذْ عنّي",37,"ن",2,0],["فحدّثوا عن قمرٍ مُشرِقٍ","يلعبُ بالبرقِ على الشمسِ",38,"س",1,0],["فحدَّثا خنساءَ قالت نعم","هامَ كمْن هام فماذا يكونْ",39,"ن",1,0],["فحدّثتُهم عنك بي كيف شئتُ","فبالروض يظهر فضلُ الدِّيَمْ",40,"م",1,0],["فَحَدِيثُهُمْ عَنْ حُسْنِ وَجْهِكَ مُسْنَدٌ","وَحَدِيثُهُمْ عَنْ طِيبِ رِيقِكَ مُرْسَلُ",41,"ل",1,0],["فحديثه ليقينه متتبِّعٌ","وطريفه بتليده مقرون",42,"ن",1,0],["فحديث إخوان الصفاء لذاذة","تجنى ويومن من جناية حوبها",43,"ب",3,0],["فحدثتنيَ نفسي أن أصوغ لهَا","من جوهر الشعر ما يهدى له العجبا",44,"ب",2,0],["فحديث كل سماحة","صحت فعن نعمامه تسند",45,"د",1,0],["فحدا ركاب مناه نحو فتى","ذي همةٍ تعلو على الهمم",46,"م",1,0],["فحد عنه إذاً واعدل ودعه","تفز ترتاح تأمن كل ثقلهْ",47,"ل",2,0],["فحدث بما تختار عن سر حكمة","وعن سير رضوان وعن مسلك الحلم",48,"م",1,0],["فحدث عن مزاياهم وكرر","وجانب ما روة عمر وكعب",49,"ب",1,0],["فحدتْ قوافي الشعر باسمك مذ لها","راضت خلائقك الحسان صعابها",50,"ب",3,0],["فحدت إليك على البعاد مدامعي","غيثاً جنوبُ تنفّس الصعداءِ",51,"ا",2,0],["فحدّق فيّ وحدّقت فيه","ومثلي إلى مثله يَنظُر",52,"ر",1,0],["فَحَديثُ الحَبيب حُسناً وإن دا","مَ تَراه عند المُحبِّ حَديثا",53,"ث",2,0],["فحدّثتني يا سعد عنهم فزدتني","شجونا فزدني من حديثك يا سعد",54,"د",1,0],["فحديثي كالدر فصل باليا","قوت يجري في جيد ظبي أغن",55,"ن",1,0],["فحديث آباء الفتى ينشي به","عزماً كنفخ الروح في الجثمان",56,"ن",1,0],["فحد له حدا لقوم وكلما","أتى شافعا فيهم يحد له حدا",57,"د",2,0],["فحدث عن مآثر أشرفيّ","نتروج بالمفاخر والجلال",58,"ل",1,0],["فَحَدِّثْ عن عباب البحر جوداً","إذا ما ضَنَّ بالمال البخيل",59,"ل",1,0],["فحدُّه كل حدٍّ","للخلق إذ هو فيه",60,"ي",2,0],["فحدُّه كل محدود بصورته","وما تناهتْ فيبقى الأمر مجهولا",61,"ل",2,0],["فحديثه دون الصحيح وأنه","فوق الضعيف وليس ذا اتقان",62,"ن",1,0],["فحدت عن الاظهار عمد السره","وما حاد ذو الاسرار يوما عن القصد",63,"د",1,0],["فحدَّثني الصخرُ عما رأى","واسمعني الماءُ ما يسمع",64,"ع",1,0],["فحدثني فإن الصدق أدنى","لباب الحق من كذب وجحد",65,"د",1,0],["فحدائقٌ ما بينَهُنَّ جداوِلٌ","وبلابلٌ فوق الغصون لها طرب",66,"ب",1,0],["فحدث بما يملي ضميرك اذ ترى","مغازلة الفتيان فالحرُّ يخجل",67,"ل",1,0],["فحدثتني الليالي وهي مسعدة","تقول أبشر بما تبديه أيامي",68,"م",2,0],["فحِدُّ لِسانِهِ رأيٌ قوِيمٌ","وحِدُّ سنانِهِ موتٌ زؤامُ",69,"م",1,0],["فحدق بي لحظة صامتا","ومد الأكف لنحو السما",70,"ا",1,0],["فحدّق فيّ حينا ثم أعلى","زفيراً قلت ليس له انقطاع",71,"ع",1,0],["فحدق في الاتومبيل المولي","الى أهليه وجها لا يحب",72,"ب",1,0],["فحديث العلاء يسند عنه","حيث فيه طهارة العنصريه",73,"ي",2,0],["فحدث بمدح كيف شئت تفننا","فأوصافه تبدو عدولاً شواهدا",74,"د",2,0],["فحدثيني حديث شوق","إلى الحمى والعقيق يسند",75,"د",1,0],["فحدثيني لماذا","لما التفت انصرفت",76,"ت",1,0],["فحَدرتَ منها والسماءُ بغبطةٍ","والجنُّ من فرحٍ تُصفق صَفْقا",77,"ق",2,0],["فَحديثُ وَصلِك شُغلُ أَفكاري وَلَو","قَلبي يُحَدِّثُني بِأَنَّك مُتلِفي",78,"ف",2,0],["فحدّث عن البحر المحيط فإنه","لبرٌّ أصيلٌ لا يرى نهر وارد",79,"د",1,0],["فحدثني عقلي بتكليف مائةٍ","من الفدن جار الجسر منها وأغراني",80,"ن",2,0],["فحَدُّ الزُهدِ يُنتِجُ فَقدَ هَمٍّ","وبُعداً عن حُنّوٍ واغتِمامِ",81,"م",1,0],["فحدّك الزم ولا تشهد لحضرته","نقصاً ولا خللاً فيما يعانيه",82,"ي",2,0],["فَحدثي عَن شَبابي","وَعَن يَدي في القيود",83,"د",1,0],["فَحَدا بي غَيظي فَكُدتُ أُوَافي","هِ بِسَيفٍ يَبتَتُّ بَطناً وَظَهرا",84,"ا",1,0],["فحديثي فيك ما أشقى الحديث","جذوة شبت فعادت لهبا",85,"ب",2,0],["فَحَدَّثتُ نَفسي أَنَّها أَو خَيالها","أَتانا عَشاء حينَ قُمنا لِنَهجَعا",86,"ع",2,0],["فحدّث القوم بالمسرى فما اعترفوا","مع أنه عندهم بالصدق قد عرفا",87,"ف",2,0],["فحدّث عن مسراه قوما بغوا بما","رآه وبالعير الذى عنه قد مشى",88,"ش",2,0],["فحد عن الغيّ كن باللَه معتقداً","فالكفر أن تخدما لأقنان أحرارُ",89,"ر",1,0],["فَحدِّثوهُ بوَجدي فَهوَ يُبلِغُهُ","إِلى النُّزولِ حِمَى قَلبي وفَي بَصَري",90,"ر",2,0],["فحدت عن منهج ما كان أوضحه","وسرت من بعده في كل مضطرب",91,"ب",1,0],["فحدَّهُمُ رسُولُ الله حَدّاً","بقَذْفِهِمُ من الضَّرْبِ الوَبيلِ",92,"ل",1,0],["فحدائِقُ الآدابِ من","كَ تنفَّستْ مِسكاً وطيبا",93,"ب",2,0],["فحدثيني واذكري ما بدا","من حبنا في الفترة السالفة",94,"ف",2,0],["فحداك شوقُك للجهاد مكبِّراً","مَن للوغى إلاّ الفتى يهواها ؟",95,"ا",3,0],["فحدائقُ نفسي قد زُرعت","شوكاً واشتقتُ إلى الوردِ",96,"د",1,0],["فحدود خطها الغرب كما","شاءها تبقى ويحميها (الرجال !)",97,"ل",1,0],["فحدث القلب فيه القلب مفتتناً","ومال فيه فم يلوي عليه فم",98,"م",1,0],["فحدثي آل جنكيزٍ وصاحبهم","عن مصرع الروم والعرش الذي انحطما",99,"م",2,0],["فحديثُكِ حلوٌ عذبٌ مثلُ","النبعِ الصافي حين يسيلْ",100,"ل",1,0],["فحدوت الجد في مركبة","وعلى المركب زجر الصافنات",101,"ت",1,0],["فحدثتني بسر ما أبحت به","يا ليتني صغت من أبعاده جملا",102,"ل",2,0],["فحدتُها والدجى يغتالُ رهبتَها","وقاربتْ شفتي فاها لتتّحدا",103,"د",2,0],["فَحَدَّثْ لِذِي الحَاجَاتِ مَا كَرَمٌ هُنَا","فَإِنَّ المَعَالِي رِمْسُهَا غَيْرُ مُرْسَمِ",104,"م",1,0],["فحديثهُ شعرٌ أهيم بسحره..","وجميلُ شعرك لايذيبُ سواكا",105,"ك",2,0],["فحدق بعين القلب فيها مفكراً","وأتصف بحكم العدل إن كنت مسلما",106,"م",2,0],["فحدثَ عنكَ المخلصونَ وأطنبواْ","ومعناكَ مهما أطنبواْ ظلَّ خافيَا",107,"ي",2,0],["ف حدادها ، ومن القنا خطاره","وأحْوَى رَمَى عَنْ قِسِيِّ الحَوَرْ",108,"ر",1,0],["فحدّت عن الإظهار عمداً لسره","وحاد عن الإظهار أيضاً على عمدِ",109,"د",1,0],["فَحدّثتُها أبغي اللقاءَ فهالني","بها المسكُ مِن أنفاسِها يتفتَّقُ",110,"ق",1,0],["فحديث الرُّواة عن عزمك المش","هور أو عن معروفك المعروف",111,"ف",1,0],["فَحُدودُها أَرْسى صَلاحُ عَصِيَّها","وَبَكاهُ في البَيْتِ المُقَدَّسِ مِنْبَرُ ُ",112,"ر",1,0],["فحديد طوق إرادتها","تثنيه ولكن لا يكسر",113,"ر",1,0],["فَحَدِّقْ أَيُّنا بَلَغَ الثُّرَيَّا","وَمَنْ يَحبُو عَلَى القِيعانِ أَسفَلْ",114,"ل",1,0],["فحدائق الأيام تفتح بابها","وشقائق النعمان أجمل عطرها",115,"ر",3,0]]}