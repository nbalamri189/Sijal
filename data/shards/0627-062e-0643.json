{"poems":[[49,"إني منعت من المسير إليكم","https://www.aldiwan.net/poem25327.html","الكامل"],[53,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54689","الطويل"],[411,"أخ كان لي وهو الحليف المساعد","https://www.aldiwan.net/poem49419.html","الطويل"],[572,"أخ كان مني في قربه","https://www.aldiwan.net/poem69484.html","المتقارب"],[881,"","https://poetry.dctabudhabi.ae/diwan/poem/21183","الطويل"],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/69185","الطويل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35705","الطويل"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82610","الطويل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46437","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89561","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[881,"تقول سُلَيْمى ما لِجِسْمك شاحباً","https://www.poetsgate.com/ViewPoem.aspx?id=175385",""],[402,"مضى حسن في ذمة الله أنسه","https://www.poetsgate.com/ViewPoem.aspx?id=35345",""],[5956,"تصادُمُ السمُوِّ بالدنُوِّ","https://www.poetsgate.com/ViewPoem.aspx?id=193936",""]],"verses":[["أَخكو وَهَل أَخكو جِنايَةَ مُنعِمٍ","غَيظُ العَدُوِّ بِهِ وَكَبتُ الحاسِدِ",0,"د",1,0],["أخٌ كم باتَ ضيْفي في قِراه","قريرَ العينِ ليس به اعتِمامُ",1,"م",1,0],["أَخٌ كَانَ رَوْحَا لِلْقُلُوبِ فَإِذْ قَضَى","أٌقَمْنَا وَمَا قَلْبٌ لِشَيٍْ بِمُرْتَاحِ",2,"ح",1,0],["أخٌ كانَ لي وهو الحليفُ المساعدُ","تنكّرَ فهو اليومَ ضدٌّ مُباعِدُ",3,"د",1,1],["أَخٌ كَانَ مِنِّي فِي قُرْبِهِ","بِحَيْثُ بَنَانُ يَدِي مِنْ بَنَانِي",4,"ن",2,1],["أَخٌ كانَ يَكفيني وكانَ يُعينُني","عَلى النائِباتِ السُودِ حينَ تَنوبُ",5,"ب",1,0],["أَخٌ كَذَوب الشَهد طَعمُ إِخائِهِ","إِذا اختلفت بيض اللَيالي وَسودُها",6,"د",3,1],["أَخٌ كانَ مِنّي في حِمىً لا يَحله","سِواهُ وَلا يُفضي إِلَيهِ غَريبُ",7,"ب",1,0],["أخ كُنتُ آوي مِنهُ عِند اِدّكاره","إِلى ظِلّ أَفنان من العِزّ باذِخ",8,"خ",1,1],["أَخٌ كانَ لي قَد كُنت أَحسَبُ أَنَّهُ","دِلاصي وَسَيفي ان نَحاني طالب",9,"ب",1,0],["أخٌ كانَ لي نِعمَ المُعينُ على التُقى","بهِ تَنجَلي عَنّي الهُمومُ وَتَذهَبُ",10,"ب",1,0],["إخكليس أكطور أنزلها","بمنزله بأجل شعار",11,"ر",1,0],["أخٌ كان يَكْفِيني وِكان يُعِيننِيِ","على نائباتِ الدَّهْرِ حين تَنوب",12,"ب",1,0],["أخ كان روحا للقلوب فإذ قضى","أقمنا وما قلب لشيء بمرتاح",13,"ح",1,0],["أخٌ كان قبل المنح يَبْدي مودَّة","ويجثو احتراماً ثم صار كهِرْقِلِ",14,"ل",1,0]]}