{"poems":[[39,"وأم جذام كان عبار قوم","https://www.aldiwan.net/poem7443.html","الوافر"],[108,"أعياد النصر","https://www.poetsgate.com/ViewPoem.aspx?id=179343",""],[510,"المفر","https://www.aldiwan.net/poem27797.html","الوافر"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100152","الوافر"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203782","المتقارب"],[1828,"","https://poetry.dctabudhabi.ae/diwan/poem/89638","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53078","الوافر"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65976","الوافر"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67992","الكامل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35508","الوافر"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117257","الرجز"],[5145,"ريح الصبا هل لك أن تسعدي","https://www.poetsgate.com/ViewPoem.aspx?id=108224",""],[5186,"اليسر في العسرى على مقدارها","https://www.poetsgate.com/ViewPoem.aspx?id=156462",""],[592,"تلألأ نور الحق في الخلق وانتشر","https://www.poetsgate.com/ViewPoem.aspx?id=128721",""],[5376,"لنا في الشامِ أشواقٌ وعشقُ","https://www.poetsgate.com/ViewPoem.aspx?id=188345",""],[5561,"عروبتنا","https://www.poetsgate.com/ViewPoem.aspx?id=213353",""],[5587,"العلم","https://www.poetsgate.com/ViewPoem.aspx?id=196761",""],[5701,"رفيع القدر حيانا","https://www.poetsgate.com/ViewPoem.aspx?id=164703",""],[5837,"زمل التخوت","https://www.poetsgate.com/ViewPoem.aspx?id=189995",""]],"verses":[["وأم جذام كان عبار قوم","على قوم وعطف ذي العقول",0,"ل",1,1],["وأَمجاد مِصْرٍ تهزُّ الوجودَ","ويستَعْذبُ الدهرُ إِنْشَادها",1,"د",3,0],["وأمجادُ بني العبّاسِ شرُّ","وأيّامُ بني الأصفرَ غُرُّ",2,"ر",1,0],["وأمجدها وأجملها ثناءً","وأنداها بكالحة السنين",3,"ن",1,0],["وأمجدُ ما في تراث العصور","تخيّر في أرضها مضجعا",4,"ع",2,0],["وأُمُّ جَذيمةٍ وَهناةَ بِكرٌ","عَقيلَةُ من ذُرى العربِ الهِجانِ",5,"ن",1,0],["وَأُمَّ جناب أبلج يوسفيّ","على نعماه تزدحم الوفود",6,"د",1,0],["وأمجد مهجة نزعت بهَوْنٍ","ففي جسد تناهزه النصول",7,"ل",1,0],["وأَمَجُّ ثغرَ الأنسِ من","شخصِ الوِصال إِذَا دنا",8,"ن",2,0],["وَأَمَّ جَنابكَ العافونَ طَرّا","كَما يَتيمّم الرُكنَ الحَجيجُ",9,"ج",1,0],["وأمجد الصمد المجيد إلهنا","ما دام جثماني بكلّ لساني",10,"ن",2,0],["وأمجدي من فيض إخلاصه","حضرة ذاك السيد الأمجد",11,"د",1,0],["وأمج لطف جمالها وجلالها","ناهيك خسف جلالها وجرارها",12,"ر",3,0],["وأم جميع الأنبياء بإيليا","وصلى بهم فيها وفي ذاك مفتخر",13,"ر",1,0],["وأمجادُ العلا تاريخُ فجرٍ","بيارقُها لها سمْقٌ وخفْقُ",14,"ق",1,0],["وأمجادُنا إن كان فيها بقيَّةٌ","بكاءٌ على الماضي وحاضِرُنا أخزى",15,"ا",1,0],["وَ أَمْجَادُ الهُدَى قَوْلٌ كَرِيمٌ","كَأَنَّ كَلَامَهُمْ سِرُّ الفَهِيمِ",16,"م",1,0],["وأمجادا لساسان","وعدنان وقحطانا",17,"ن",2,0],["وأمجادهم ما هي بحاجة لإيضاحات","والكل يعرفها بسر وجهارة",18,"ر",2,0]]}