.ae/diwan/poem/139008",""],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38157","المتقارب"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62478","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79805","الخفيف"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127945","المديد"],[1892,"","https://poetry.dctabudhabi.ae/diwan/poem/96237","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69375","الخفيف"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105019","الخفيف"],[2338,"","https://poetry.dctabudhabi.ae/diwan/poem/111149","الخفيف"],[2610,"","https://poetry.dctabudhabi.ae/diwan/poem/22592","الخفيف"],[3210,"","https://poetry.dctabudhabi.ae/diwan/poem/143413","الخفيف"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67970","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86356","الرمل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33311","الرمل"],[4560,"","https://poetry.dctabudhabi.ae/diwan/poem/118193","الخفيف"],[4767,"بحور القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=179966",""],[4816,"سامحكم الله","https://www.poetsgate.com/ViewPoem.aspx?id=8491",""],[5055,"هيف الثمار","https://www.poetsgate.com/ViewPoem.aspx?id=177434",""],[5061,"انين الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=147428",""],[5072,"زمن","https://www.poetsgate.com/ViewPoem.aspx?id=34351",""],[5183,"قال","https://www.poetsgate.com/ViewPoem.aspx?id=186485",""],[5192,"** كل م اسبح **","https://www.poetsgate.com/ViewPoem.aspx?id=36998",""],[5582,"قَدْكَ يا عاذِلُ تُبْدِي اللَّوْمَ قَدْ","https://www.poetsgate.com/ViewPoem.aspx?id=186907",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[5616,"صرخة","https://www.poetsgate.com/ViewPoem.aspx?id=204843",""],[5725,"انسام طيبة","https://www.poetsgate.com/ViewPoem.aspx?id=183345",""],[5804,"قصيدة يتكرر فيها حرف السين","https://www.poetsgate.com/ViewPoem.aspx?id=182858",""],[5838,"ظل يختال في رداء شباب","https://www.poetsgate.com/ViewPoem.aspx?id=200851",""],[5848,"السويدي والعليّا","https://www.poetsgate.com/ViewPoem.aspx?id=50604",""],[5912,"عرس القرنفل","https://www.poetsgate.com/ViewPoem.aspx?id=205015",""],[5950,"عمر ومسافة ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128118",""],[463,"أنذرتني أمُّ سعدٍ أنَّ سعدا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60043&r=&rc=99",""],[6331,"خبِّريني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82020&r=&rc=1",""]],"verses":[["كُلُّ مَأسورٍ يُرَجّى فَكُّهُ","غَيرَ مَن أَصبَحَ في قَيدِ اللَيالي",0,"ل",2,0],["كُلَّما سُلَّ مِن فُؤادِيَ سَهمٌ","عادَ سَهمٌ لَكُم مَضيضَ الوَقعِ",1,"ع",1,0],["كُلَّما سارَ طالِباً خَفضَ عَيشٍ","نالَ ذُلّاً مِنَ الزَمانِ وَخَفضا",2,"ض",2,0],["كُلَّما سُرَّ بِهَا قالتْ له","زادَكَ اللَّهُ سروراً وفرحْ",3,"ح",1,0],["كلَّما سرتُ زلَّ بي فيهِ مَهْوَى","تَتَضاعى به وُحُوشُ الحِمَامِ",4,"م",1,0],["كلما سارت لأرض خيلهم","سبق العلم إليها الأَسلا",5,"ل",2,0],["كل ما ساء وما سرّ بها","ينقضى بين صباح ومساء",6,"ا",2,0],["كُلَّما سَبَّحتَ لِلعَرشِ بِهِ","رَفَعَ الرَحمَنُ وَالرُسُلُ الحُجُب",7,"ب",1,0],["كُلَّما سِرتُ في اِقتِضائِكَ مالي","عَنَقاً سِرتَ في مِطالِكَ رَكضا",8,"ض",2,0],["كُلَّما ساءَلتُهُ خَيراً أَبى","وَبِلاءٍ شَدَّ ظَهراً وَاِعتَصَم",9,"م",1,0],["كلَّمَا سَارَ خُطْوَةً وَقَفَ الْمَوْ","تُ فَسَدَّ الطَّرِيقَ عَنْ طُلاَّبِهْ",10,"ب",2,0],["كلّما ساءل الدجى أين يمضي","لجّ في الصمت واستفاض خشوعه",11,"ع",2,0],["كلّما سلسلت من ألحانها","مسحوا الدمع على فضل الرّداء",12,"ا",2,0],["كلما سار سال دمع مآقي","ه ومن حق دمعه أن يسيلا",13,"ل",2,0],["كُلَّمَا سَدّد رَامٍ سَهمَهَا","عَادَ فِي لِبَّتِهِ مُنتَكِسَا",14,"س",2,0],["كلّما سَدَّ طعنةً في فؤاد","قال خُذها نَجلاءَ من خَوصاء",15,"ا",2,0],["كُلَّما سار إلى مَنْبَعِهِ","صدَّهُ الباغي ، وأدْمى عَقِبهْ",16,"ب",2,0],["كلما سَقسقت يراعتيَ الحرَّ","ى أرادَ الشقاءُ ألاّ تُبيناً",17,"ن",2,0],["كلَّما سُونِد منكم بأخيهِ","صارمٌ صَمَّمَ أمضىَ وأَحَدَّا",18,"د",2,0],["كُلَّما ساقَها مِنَ الدَنِّ ساقُ","ظَلَّ لِلَيلٍ مِن سَناها سِباقُ",19,"ق",1,0],["كُلَّما سِرنا تَرَكنا مَنزِلاً","فيهِ شَتّى مِن سِباعِ الأَرضِ غاروا",20,"ر",3,0],["كلما سارَ بالظُبى والعَوالي","بعثَ الذُعرَ قبلَهُ بالصُدورِ",21,"ر",1,0],["كلّما ساءني بفعلٍ قبيحٍ","جاءني منه سرّني بكلامِهْ",22,"م",2,0],["كُلَّما سُلَّتْ صَوارِمُهَا","قَالَ قَلْبِي قَد دَنَا أَجَلي",23,"ل",2,0],["كلما سرتُ في الحُسينيّ والأث","ل شجاني من الحُسَيني شاج",24,"ج",1,0],["كلما ساءت فعالا","قلت إن الحسنات",25,"ت",1,0],["كُلّما سارَت تَراها طاِئراً","أَو كَبَرقٍ قَد سَرى بِيَدي اِبتِسامَه",26,"م",2,0],["كلما ساء أتاني","فضله يكفي البلاءَ",27,"ا",2,0],["كلما سالت الكفاحُ حديداً","علَّم الراسيات كيف الثبات",28,"ت",1,0],["كلما سحت مدامعها","فسعيرا القلب في شعل",29,"ل",1,0],["كلما سرت من فراقك ميلا","مال من مهجتي اليك فريق",30,"ق",1,0],["كُلَّما سارَ مُزمِعاً أَزمَعَ المَج","دُ مَسِيراً وَكُلَّما حَلَّ حَلّا",31,"ل",2,0],["كلما سلَّ لحظه رحت أدعو","كم قتيل كما قتلت شهيد",32,"د",1,0],["كلما سودت صحائف بيضا","غادرت أوجه الصفائح سودا",33,"د",2,0],["كُلَّما سُمتُهُ النُّهو","ضَ إِلى كُوَّةٍ عَثَر",34,"ر",1,0],["كلّما سارتِ العقولُ لكيْ تق","طَعَ تِيهاً تَغوَّلتْ في تِيهِ",35,"ه",1,0],["كلما سار فُسحةً طار شوقاً","حَثْحث العِيس كي يغالَ الرغائب",36,"ب",1,0],["كلما سجلت فيها أحرفاً","لا تفي بالبعض والكل بقي",37,"ي",1,0],["كلما سكنَ قلبي زفرةً","بالبكا هيجَ شوقي زفرةً",38,"ر",2,0],["كلما سارت العقول لكي","تقطع تيها توغلت في تيه",39,"ه",1,0],["كلما سيطرت علينا بِجزء","من ترابٍ لنا تقيم احتفالا",40,"ل",2,0],["كلما سلكت بغير درب المخاطير","جدد هموم القلب هم سطى به",41,"ب",2,0],["كلما سألت الرسم داره عدّني","تجتاحني الوجنات يمطر حايبه",42,"ب",2,0],["كلما سليت شوي ثم قلت راحت","لقيتها في جوف صدري تسوحي",43,"ح",2,0],["كلُّ مأساتِنا بأنّا جهلنا","ما أضاءتْ بليلنا الأنوارُ",44,"ر",1,0],["كلما ساء لها قالت له","دعك يا غافل من كثر السؤال",45,"ل",1,0],["كل م اسبح بين رمشك والنظر غار الغرام","من مكاني في عيونك خايف اطفي شمعته",46,"ت",2,0],["كُلَّما سَبَّحَ فِي حُجْرَتِهِ","لامِعُ البَرْقِ تَداعَى وَسَجَدْ",47,"د",1,0],["كلما سبّح الخلائق باس","م الله والله سامع نجواها",48,"ا",3,0],["كلَّما سرتُ خطوةً لبلادي","صدَّ خطوي الحاخامُ والبطريقُ",49,"ق",1,0],["كلما سحّت مزينات الجوى","امطرتْ دمعاً علا سيل البطاحِ",50,"ح",1,0],["كُلَّما سِرتُ وبُؤسي سِيرتي","هَمَسَ الحزنُ بنفسي ثُمَّ وسوسْ",51,"س",1,0],["كلما سحبت «2» أساءة خلق","حسّنوه بمزج السحاب",52,"ب",1,0],["كل ما سولف غيابك عنك جبت \" اكبر مطمّه \"","كنّي اللي عن هجير الشمس بالشمس يتفيّا !",53,"ي",2,0],["كلما سافر النسيم شفيفا","هاجني طيف للحبيب يزار",54,"ر",1,0],["كل ما سلّ العتب ف/ الصدر سيفه","قام يحصد ما بلغ منّي قطافه",55,"ف",2,0],["كلما سوندِ منكم بأخيهِ","صارمٌ يممَ أمضى وأحدا",56,"د",2,0],["كلَّما ساقيتُ أمنيةً","راحَ وجهُ الجَدْبِ يعتذرُ",57,"ر",1,0]]}