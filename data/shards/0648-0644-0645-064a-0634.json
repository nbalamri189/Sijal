{"poems":[[53,"ذكرتك حين ألقت بي عصاها","https://www.aldiwan.net/poem8527.html","الوافر"],[53,"وافى وحياني بكأس وراح","https://www.aldiwan.net/poem9427.html","السريع"],[91,"إني غير مختار وفارق مضطرا","https://www.aldiwan.net/poem45097.html","الطويل"],[47,"أمرتجع مني حباء خلائف","https://www.aldiwan.net/poem62732.html","الطويل"],[60,"سلام على أهل القبور الدوارس","https://www.aldiwan.net/poem31000.html","الطويل"],[68,"لم تتبع الأمر إلا كان أو كادا","https://www.aldiwan.net/poem38505.html","البسيط"],[77,"شكا ما شكوت الرمح والنصل والسهم","https://www.aldiwan.net/poem69019.html","الطويل"],[48,"أريد ليان العيش في دار شقوة","https://www.aldiwan.net/poem23499.html","الطويل"],[132,"خليلي إن الهم والحزن خيما","https://www.aldiwan.net/poem50509.html","الطويل"],[136,"أإن ظعن الخليط ضحى فبانا","https://www.aldiwan.net/poem54656.html","الوافر"],[164,"دمعي على الخد مثل الدر ينتثر","https://www.aldiwan.net/poem58847.html","الكامل"],[214,"يا متهمي بالسلو مهلا","https://www.aldiwan.net/poem13319.html","مخلع البسيط"],[275,"سلام أيها الغيم الملث","https://www.aldiwan.net/poem35291.html","الوافر"],[308,"سذاجة خده زادت إلى أن","https://www.aldiwan.net/poem57916.html","الوافر"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[369,"تحن إلى شرقي نعمان ناقتي","https://www.aldiwan.net/poem60814.html","الكامل"],[369,"أشاكر أنا للأيام أم شاك","https://www.aldiwan.net/poem60816.html","البسيط"],[371,"عذول الهوى يبني بغير أساس","https://www.aldiwan.net/poem17018.html","الطويل"],[371,"يموت كما مات العناة معناه","https://www.aldiwan.net/poem17141.html","الطويل"],[385,"استغر الله العظيم العفو","https://www.aldiwan.net/poem47411.html","الرجز"],[447,"عذاب الهوى في قلب من رامه عذب","https://www.aldiwan.net/poem14329.html","الطويل"],[458,"أفى العرس تنعى يالها قسوة القدر","https://www.aldiwan.net/poem61712.html","الطويل"],[458,"أخي وجمال الشعر ما أنت ناثر","https://www.aldiwan.net/poem61748.html","الطويل"],[463,"إلى كم حبسها تشكو المضيقا","https://www.aldiwan.net/poem56088.html","الوافر"],[466,"تعاظم حزني والرزية أعظم","https://www.aldiwan.net/poem15905.html","الطويل"],[487,"صار بفؤاد الوجد نحو ربوعها","https://www.aldiwan.net/poem24440.html","عموديه"],[545,"إذا ما أراد الأمر ناجى ضميره","https://www.aldiwan.net/poem56699.html","الطويل"],[556,"لقاؤك يا سلمى وإن كان دائما","https://www.aldiwan.net/poem47228.html","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37911","البسيط"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133773","السريع"],[1175,"","https://poetry.dctabudhabi.ae/diwan/poem/67747","الطويل"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6749","الوافر"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101045","الوافر"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71034","الطويل"],[2049,"","https://poetry.dctabudhabi.ae/diwan/poem/118058","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89561","الطويل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130801",""],[2875,"","https://poetry.dctabudhabi.ae/diwan/poem/124046","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202821","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204479","الطويل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112587","الوافر"],[3102,"","https://poetry.dctabudhabi.ae/diwan/poem/113895","الطويل"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140306",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138450",""],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59506","المتقارب"],[4122,"","https://poetry.dctabudhabi.ae/diwan/poem/111119","المتقارب"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94353","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81682","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136640",""],[4394,"","https://poetry.dctabudhabi.ae/diwan/poem/117177","الوافر"],[4767,"بدر عدنان","https://www.poetsgate.com/ViewPoem.aspx?id=179957",""],[4955,"إذا ما عشت في الدنيا فخورا","https://www.poetsgate.com/ViewPoem.aspx?id=188762",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[2598,"وَصَهْبَاءَ جُرْجانِيَّة ٌ لَمْ يَطُفْ بِهَا","https://www.poetsgate.com/ViewPoem.aspx?id=20734",""],[5689,"إلى م النوم كالعني الشجين","https://www.poetsgate.com/ViewPoem.aspx?id=143401",""],[5751,"تَحارُ بكَ الحروب","https://www.poetsgate.com/ViewPoem.aspx?id=214772",""],[6093,"أسارةُ إنَّ الهّجْرَ للحبِّ قاتل","https://www.poetsgate.com/ViewPoem.aspx?id=176430",""],[6093,"تَزيدُ قناعتيْ حِيْناً فحيناً","https://www.poetsgate.com/ViewPoem.aspx?id=177693",""]],"verses":[["ولم يُشْمِتْ بنا داوودَ فيما","رجا سَفَهاً وأمَّلَ في مغيبي",0,"ب",2,0],["ولم يُشَفِّف لي كؤوسَ الطِّلا","فقلت يا رُوحِي وزَيْنَ المِلاحْ",1,"ح",1,0],["ولَم يشجني شيءٌ كمنظر غادةٍ","قَد اِغتال كفُّ الظلم حاميها غدرا",2,"ر",2,0],["وَلَم يُشتَهَر إِلّا الَّذي قُلتُ فيهِمِ","وَإِن رَفَدوا يَوماً وَزادوا عَلى الرِفدِ",3,"د",1,0],["وَلَم يَشرَبوا مِن بارِدِ الماءِ شُربَةً","وَلَم يَأكُلوا مِن خَيرِ رَطبٍ وَيابِسِ",4,"س",1,0],["وَلَم يُشاهِد بَني الأَمالِ قَد قُطِعَت","مِنها العَلائِقُ إِلّا عاجَ أَو عادا",5,"د",2,0],["ولم يشكُ ذا حتى شكا ذاكَ قبلَهُ","وعاودَ ذا ممَّا تطرَّقَ ذا سُقمُ",6,"م",1,0],["وَلَم يُشوِ حَتفٌ أُمَّ عُفرٍ بِوَهدَةٍ","وَلا أُمَّ غُفرٍ بَينَ آسٍ وَظَيّانِ",7,"ن",1,0],["ولم يشجني شوقاً فراقُ أحبةٍ","إذا لم يذوقوا من فراقي تَنَدُّمَا",8,"م",2,0],["ولم يشهد عليك بذاك قاضى","قضاة القطر حسبك ذا هوانا",9,"ن",2,0],["ولم يشنه وهل يسعى إلى كلمٍ","يعاب فيها بقبحِ السيرة القمرُ",10,"ر",1,0],["ولم يشن وعده بمطل","ويتبع القول منه فعلا",11,"ل",2,0],["ولم يَشرَب معي إلا شريفٌ","كريمٌ ليسَ في عَينيهِ خُبث",12,"ث",1,0],["ولم يشعر به حتى تبدي","بحيلته وصح عليه نقشه",13,"ه",1,0],["وَلَم يَشُدَّ الحَشا مِن عَوزِ مَطلَبِ","فَالخَيراتِ لَهُ مِن غَيرِ ما طَلَبِ",14,"ب",1,0],["ولم يَشْكُ قلبي قَطُّ صِدْقَ قِتالهِمْ","ولكنّه يَشكو أليمَ قِتالك",15,"ك",1,0],["ولم يَشُدَّ بخَصْرٍ منكِ مَنطِقةً","إلاّ لكَي تَخدُمي ما عِشتِ مَوْلاك",16,"ك",1,0],["وَلَم يُشجِني إِلّا جِنايَةُ عَينِهِ","بِما أودِعَت عَينايَ وَهوَ نُعاسي",17,"س",2,0],["وَلَم يَشُمِ الشَكوى وَلا سَئِمَ الهَوى","وَلا سامَ ما يَهوى وَلَكِنَّهُم تاهوا",18,"ه",3,0],["ولم يشاركه السّوى في مشيته","ولا ترى من حاجزٍ لوثبته",19,"ه",1,0],["ولم يشفني من غلني غير وقفتي","عليه ويبريني من تربي الترب",20,"ب",1,0],["ولم يشرح الانجيلَ إلا خلالُه","ولا كُتب الأديانِ دونَ الذي سَطر",21,"ر",1,0],["ولم يَشقَ إلاّ اثنان أنت ومبضعٌ","حوى فنِّ جبار لحرب الجبابر",22,"ر",1,0],["ولم يُشفِقْ على حسبٍ غلامٌ","يكون على ركائبه شفيقا",23,"ق",2,0],["ولم يشهد النادي مُطاعاً وأهْلُهُ","مرمُّون من ارهابهِ لا يُكلَّمُ",24,"م",1,0],["ولم يشهد العين المحيط فإنه","على بسط بالنقص يبدو لها خفا",25,"ف",2,0],["وَلَم يُشرِكِ الأدنين في جُلِّ أَمرِهِ","إِذا اِختَلَفَت بالأضعَفينَ قوى الحَبلِ",26,"ل",1,0],["ولم يشفِ ذاك القربُ وهو مرَجَّمٌ","من القوم سُقماً بل أثار سُقاما",27,"م",2,0],["وَلَم يَشِب إِنّما شَمسُ البَها غَربَت","تَحتَ العِذارِ وتعلوهُ أشعّتُها",28,"ه",2,0],["ولم يشق الزهر أكمامه","والجو بالأطياب لم يعبق",29,"ق",1,0],["وَلَمْ يَشْهَدِ القُس المُهَيْنِمُ نَارَهَا","طَرُوقاً وَلاَ صَلَّى عَلَى طَبْخِهَا حِبْرُ",30,"ر",1,0],["وَلَم يَشغَلَكَ عَنهُ هَوى مُطاعٌ","وَلا دُنيا بِزُخرُفِها فُتِنتا",31,"ت",2,0],["ولم يشغلهما حل ولكن","بركن البيت للصلوات قاما",32,"م",2,0],["ولم يَشْكُ ما قد كان يعقوب يشتكي","إلى الله من بَثٍّ لديه ومن حُزْن",33,"ن",1,0],["ولم يشهد الأبطال في يوم غارة","يعوم به طرف من الخيل سابح",34,"ح",1,0],["وَلم يَشتَغِل عَن ذا بِبَيعٍ وَلا شِرا","نَعَم في اِبتِناءِ المَجدِ لِلبَذلِ يَطرَبُ",35,"ب",1,0],["ولم يشعر اخو العمياء الا","وناب الهر يوغل في الاهاب",36,"ب",1,0],["ولم يشدُ بالأسحارِ خلفى مغرّدٌ","يقول على آثار من ذهب العفا",37,"ف",2,0],["ولم يشفني شعري من الخطب ناشئاً","لأني وجدت الخطب أعظم من شعري",38,"ي",1,0],["ولم يُشقني نقص النظام وانما","شقائي بعقلٍ للنواقص يستجلي",39,"ل",2,0],["ولم يشك الطوى أحد بمصر","ولم تظهر بعيشتنا جراح",40,"ح",1,0],["ولم يشتغل إلا بطقس صلاته","لفاديه يغلو في الجمود وفي الصمت",41,"ت",1,0],["ولم يشأ مبدع الأكوان ان يقفا","في موقفٍ واحدٍ ذئب وإنسان",42,"ن",1,0],["ولم يشركه في كنه سواهم","وعلياهم ولست أخاف حنثا",43,"ث",2,0],["ولم يشف نفسي سوى قولهم","سليمانُ ياذا الفَخَار أقْدمِ",44,"م",1,0],["ولم يشجني فقد عيش الشباب","وليل الصبا ولذيذ الوسن",45,"ن",1,0],["ولم يشكُ غير الوغد عن هونِ فطرةٍ","يرى الذلَّ في الشكو كسامي المراتب",46,"ب",1,0],["ولم يُشجني بَعدَ الحبيب مفارقٌ","كطيفٍ أثارَ الوجدَ من بعد إطفاءِ",47,"ا",2,0],["ولم يُشجني سجعُ الحمام وإنمَّا","حنينُ نياق الظاعنينَ شَجاني",48,"ن",2,0],["ولم يشهَد جنازَتَهُ البواكي","فتَبكيهِ بمُنهَلٍّ سفوحِ",49,"ح",1,0],["ولَم يُشكرْ لسارٍ أيُّ سعيٍ","ولَم تَظفرْ بِمطلبِها جنود",50,"د",1,0],["ولم يشبعكَ مالٌ أو نفوذٌ","فبعتَ الحقَّ أعدمتَ الضميرا",51,"ر",2,0],["ولم يشركوا الله جل جلاله","ولم يتركوها قاصدين على عمد",52,"د",1,0],["وَلَم يَشْهَدِ القَشُّ المُهَيْنِمُ نَارَهَا","طَرُوقاً ولا صَلَّى عَلَى طَبْخِها حَبْرُ",53,"ر",1,0],["ولم يشكر لنا ما قد بنينا","له في المجد من ركن ركين",54,"ن",1,0],["ولم يشجبْكَ في المعنى نزوحٌ","وبيتُكَ لمْ ينلْهُ الأمسَ هَدْمُ",55,"م",1,0],["ولمْ يشغلِ القلبَ الخلاءَ سواكمُ","وإني قُبيلَ اليومَ للقلب شاغِلُ",56,"ل",1,0],["11. وَ لَمْ يَشْذُذْ عَنِ البيضاءِ إلاَّ","خبيثٌ جَاهلٌ نَبذَ اليَقِينَا",57,"ن",2,0],["20. وَ لَمْ يَشْكُكْ بحالِهِمُ عَليمٌ","نَقِيُّ الدِّيْنِ مُسْتَوفٍ فُنُونا",57,"ن",2,0]]}