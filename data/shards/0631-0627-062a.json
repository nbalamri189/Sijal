l","الطويل"],[475,"رأتني صريع الخمر يوماً فسؤتها","https://www.aldiwan.net/poem2162.html","الطويل"],[480,"رأت أقوامها اغتصبت بلادي","https://www.aldiwan.net/poem36904.html","الوافر"],[496,"تعالى الله ما شاء","https://www.aldiwan.net/poem10277.html","الهزج"],[501,"رأت أطلال سلما بعد بعد","https://www.aldiwan.net/poem37688.html","الوافر"],[501,"رأت رفرف الأكوان هند فولت","https://www.aldiwan.net/poem37718.html","الطويل"],[516,"لكل مقام في علاك مقال","https://www.aldiwan.net/poem12200.html","الطويل"],[516,"محلك لا يسام ولا يسامى","https://www.aldiwan.net/poem12260.html","الوافر"],[517,"فلا النفس ملتها ولا العين تنتهي","https://www.aldiwan.net/poem48662.html","الطويل"],[539,"كما شئت مر فالدهر ممتثل أمرا","https://www.aldiwan.net/poem48181.html","عموديه"],[541,"رأت شمطا تخص به المنايا","https://www.aldiwan.net/poem56690.html","الوافر"],[552,"سلا عنا المنازل لم بلينا","https://www.aldiwan.net/poem47176.html","الوافر"],[554,"أعاود ما قدمته من رجائها","https://www.aldiwan.net/poem68382.html","الطويل"],[554,"سرت بملام حين هوم عذلي","https://www.aldiwan.net/poem68431.html","الطويل"],[568,"أبى الدهر إلا فعالا خسيسا","https://www.aldiwan.net/poem69635.html","المتقارب"],[576,"أيا دار في جنات عدن له دار","https://www.aldiwan.net/poem2783.html","الطويل"],[576,"مضى معهم قلبي فلله درره","https://www.aldiwan.net/poem3060.html","الطويل"],[576,"رأت منك رائيتي ما تحب","https://www.aldiwan.net/poem3095.html","المتقارب"],[587,"رأت شغفي عند ارتشاف رضابها","https://www.aldiwan.net/poem17999.html","الطويل"]],"verses":[["رَأَت لا مِعاً فَاِستَشرَقَت لَمَضائِهِ","وَلَو كانَ مِن مُزنِ النَدى لَشَفاها",0,"ا",3,0],["رَأَت شَعَراتٍ في عِذارِيَ طَلقَةً","كَما اِفتَرَ طِفلُ الرَوضِ عَن أَوَّلِ الوَسمي",1,"م",2,1],["رَأَت بَياضَكَ مُسوَدّاً مَطالِعُهُ","ما فيهِ لِلحُبِّ لا عَينٌ وَلا أَثَرُ",2,"ر",1,0],["رأت أُمُّ عَمروٍ يَومَ سارَت مَدامِعي","تَنُمُّ بِسرِّي في الهَوى وَتُذيعُهُ",3,"ع",2,1],["رَأَتْنِي فَتاةُ الحَيِّ أَغْبَرَ شاحِباً","فَأَذْرَتْ دُموعاً كَالجُمانِ تُريقُها",4,"ق",3,1],["رَأَتْ أُمَيْمَةُ أَطْمارِي وَناظِرُهَا","يَعومُ بالدَّمْعِ مُنْهَلَّاً بَوادِرُهُ",5,"ر",2,1],["رَأَتْني في أَوائِلِها مُشِيحاً","أُلَهِّبُ جَمْرَتَيْ ضَرْبٍ وَطَعْنِ",6,"ن",1,0],["رَأَتْ أُمُّ عَمْروٍ ما أُعاني فعَرَّضَتْ","بِشَكْوَى وفي فَيْضِ الدُّموعِ بَيانُها",7,"ن",3,1],["رَأَت طَعني فَوَلَّت وَاِستَقَلَّت","وَسُمرُ الخَطِّ تَعمَلُ في قَفاها",8,"ا",3,0],["رَأَت رَغبَةً مِنّي فَأَبدَت زَهادَةً","أَلا رُبَّ مَحرومٍ مِنَ الناسِ راغِبِ",9,"ب",1,0],["رأتْ واللّيْلُ قد سَدَلَ الرِّواقا","شُعاعَ البرْقِ يأتَلِقُ ائْتِلاقَا",10,"ق",2,1],["رَأَتْ مِنْكَ عَنِّي مِلأَهَا حُسْنَ مَنْظَرٍ","يُقَيِّدُ طَرفَ النَّاظِرِ الْمُتَوَسِّمِ",11,"م",1,0],["رَأَتْ عَصَبِي غَزْلاً وَجِسْمِي مَرَمَّةً","فَهَا هِيَ تُسْدِي كُلَّ يَوْمٍ وَتُلْحِمُ",12,"م",1,0],["رَأَت عُجُزاً في الحَيِّ أَسنانَ أُمَّها","لِداتي وَشُبّانُ الرِجالِ لِداتُها",13,"ت",3,0],["رَأَت رَجُلاً غائِبَ الوافِدَي","نِ مُختَلِفَ الخَلقِ أَعشى ضَريرا",14,"ر",2,0],["رَأَت أَنَّها رَخصَةٌ في الثِيابِ","وَلَم تَعدُ في السِنِّ أَبكارَها",15,"ر",3,0],["رَأَت حُلاها عَلى الأَوطانِ فَاِبتَهَجَت","وَلَم تَحَسَّر عَلى الحَليِ الَّذي ذَهَبا",16,"ب",2,0],["رَأَتني كَأَنضاءِ اللِجامِ وَبَعلُها","مِنَ المَلءِ أَبزى عاجِزٌ مُتَباطِنُ",17,"ن",1,0],["رَأَت رَجُلاً أَودى السِفارُ بِوَجهِهِ","فَلَم يَبقَ إِلّا مَنظَرٌ وَجَناجِنُ",17,"ن",1,0],["رَأَت راكِباً أَو راعَها لِفَواقِها","صُوَيتٌ دَعاها مِن أُعَيِّسَ فاتِرِ",18,"ر",1,0],["رَأَت أَنَساً عِنَد الخَلاءِ فَأَقبَلَت","وَلَم تُبدِ إِلّا في تَصَرُّفِها ذُعرا",19,"ر",2,0],["رَأَت شُجوني وَرَأَت تَخديدي","مِن مُجحِفاتِ زَمَنٍ مِرّيدِ",20,"د",1,0],["رَأَتنا كَأَنّا قاصِدونَ لِعَهدِها","بِهِ فَهيَ تَدنو تارَةً وَتَزَحزَحُ",21,"ح",1,0],["رأت نفسها طالتْ فظنّتْ بأنها","تفوتُ على رغم اللحاق المراميا",22,"ي",2,0],["رَأَت حَنيفَةُ إِذ عُدَّت مَساعيها","أَن بِئسَما كانَ يَبني المَجدَ بانيها",23,"ي",3,0],["رَأَت صِرمَةً لِلحَنظَلِيِّ كَأَنَّها","شَظِيُّ القَنا مِنها مُناقٌ وَرُزَّحُ",24,"ح",1,0],["رَأَت أُمامَةُ أَنقاضاً عَلى عَجَلٍ","وَهاجِعاً عِندَهُ عَنسٌ وَأَقتادُ",25,"د",1,0],["رَأَت مالِكٌ نَبلَ الفَرَزدَقِ قَصَّرَت","عَنِ المَجدِ إِذ لا يَأتَلي الغَلوَ نازِعُ",26,"ع",1,0],["رَأَت مَرَّ السِنينَ أَخَذنَ مِنّي","كَما أَخَذَ السَرارُ مِنَ الهِلالِ",27,"ل",1,0],["رَأَتني قَد شَحَبتُ وَسَلَّ جِسمي","طِلابُ النازِحاتِ مِنَ الهُمومِ",28,"م",1,1],["راتبه مجهول أمرٍ وما","معلومه أيضاً بمعلوم",29,"م",1,0],["رأت بناتي حبّ جسمي الذي","من طرزه عندي أذًى مؤلم",30,"م",1,1],["رأتك نظير العين في الناس دولة","على رأسِها من صوغ لفظك تيجان",31,"ن",1,0],["رأت نارَ إبرَاهيم أيامَ أوقِدتْ","وحازت من الأوصافِ أوصافَها الحسنى",32,"ا",1,0],["رأتْ تركها اللذاتِ من خَوفِ ربِّها","قُنوطاً وأن اللَه إن قَنِطتْ سخِط",33,"ط",1,0],["رأت ما فيك نفسي رأيَ حدسٍ","فلم يخطئ سَدادي واعتدالي",34,"ل",2,0],["رأتْ عيني لمُنْكَرةٍ قواما","ووجهاً يشبه البدرَ التماما",35,"م",2,1],["رَأَتني صَريعَ الخَمرِ يَوماً فَسُؤتُها","بِقُرّانَ إِنَّ الخَمرَ شُعثٌ صِحابُها",36,"ب",3,0],["رَأَت بارِقاتٍ بِالأَكُفِّ كَأَنَّها","مَصابيحُ سُرجٍ أوقِدَت بِمِدادِ",37,"د",1,0],["رَأَت أَنَّ رَيعانَ الشَبابِ قَدِ اِنجَلى","وَأَنَّ مَشيبي حاضَرَتني عَواجِلُه",38,"ل",2,0],["رَأَتهُ خَشفاً فَأَدنَتهُ فَراءَ بِها","شاةً فَأَنشَبَ فيها نابَهُ نَمِرا",39,"ر",2,0],["رَأَت شَعَراتٍ لُحنَ بيضاً بِمَفرِقي","وَغُصنِيَ مِن ماءِ الشَبابِ رَطيبِ",40,"ب",1,0],["رَأَت رَجُلاً يَسعى إِلَيها فَحَملَقَت","إِلَيهِ بِمَأقى عَينِها المُتَقَلِّبِ",41,"ب",1,0],["رَأَتكَ ذَوُو الأَحلامِ خَيراً خِلافَةً","مِنَ الراتِعينَ في التِلاعِ الدَواخِلِ",42,"ل",1,0],["رَأَت شَفَقاً يَنعى النَهارَ مُضَرَّجاً","فَقُلتُ لَها حَتّى النَهارُ شَهيدُ",43,"د",1,0],["رَأَت وَجهَ مَن أَهوى بِلَيلٍ عَواذِلي","فَقُلنَ نَرى شَمساً وَما طَلَعَ الفَجرُ",44,"ر",1,0],["رَأَت لَونَ نورِكَ في لَونِها","كَلَونِ الغَزالَةِ لا يُغسَلُ",45,"ل",1,0],["رَأَت كُلَّ مَن يَنوي لَكَ الغَدرَ يُبتَلى","بِغَدرِ حَياةٍ أَو بِغَدرِ زَمانِ",46,"ن",1,0],["رأت إبلي قد غالَها الحقُّ واتَّقى","بها الدهرَ منهوبُ التِلاد كريمُ",47,"م",1,1],["رأتْ جودَهُ شُهْبُ النجوم فحلَّقَتْ","مخافةَ أن تُعطَى فُرادَى وتوأمَا",48,"م",2,0],["رَأَت رَغبَتي فيها فَأَبدَت زَهادَةً","أَلا رُبَّ مَحرومٍ مِنَ الناسِ راغِبِ",49,"ب",1,0],["رَأَت وَخطَ شَيبٍ في عِذاري فَصَدَّتِ","وَلَم تَتَنَظَّر بي نَوىً قَد أَجَدَّتِ",50,"ت",1,1],["رَأَت لَمَّةً عَلّى بَياضاً سَوادَها","تَعاقُبِ مُبيَضٍّ عَلَيها وَمُسوَدِّ",51,"د",1,0],["رَأَت فَلَتاتِ الشَيبِ فَاِبتَسَمَت لَها","وَقالَت نُجومٌ لَو طَلَعنَ بِأَسعُدِ",52,"د",1,0],["رَأَت رُشدَها عِجلُ فَثابَت حُلومُها","وَلَم يَعشَ مِنها عَن مَراشِدِها طَرفُ",53,"ف",1,0],["رَأَت رَبَّةُ الرَحمانِ أَخرَجَهُ لَنا","وَجَدٌّ وَمَن خَيرِ الجُدودِ سَعيدُها",54,"د",3,0],["رَأَتهُ مَعَ القَتلى وَغَيَّرَ بَعلَها","عَلَيها تُرابٌ في دَمٍ قَد تَعَفَّرا",55,"ر",2,0],["رَأَت ذائِداً حُرّاً فَطَيَّرَ سَيفُهُ","عَنِ الحَوضِ أولاها فَأَجلَينَ نُقَّرا",56,"ر",2,0],["رَأَت أَينُقاً عَرّيتُ عاماً ظُهورُها","وَما كانَ هَمّي تَستَريحُ رَواحِلُه",57,"ل",2,0],["رَأَت بَينَ عَينَيها رَوِيَّةَ وَاِنجَلى","لَها الصُبحُ عَن صَعلٍ أَسيلٍ مَخاطِمُه",58,"م",2,0],["رَأَت قُرَيشٌ أَبا العاصي أَحَقَّهُمُ","بِاِثنَينِ بِالخاتَمِ المَيمونِ وَالقَلَمِ",59,"م",1,0],["رَأَتني مَعَدٌّ مُصحِراً فَتَناذَرَت","بَديهَةَ مَخشِيَّ الجَريرَةِ عارِمِ",60,"م",1,1],["رَأَتنا مَعَدٌّ يَومَ شالَت قُرومُها","قِياماً عَلى أَقتارِ إِحدى العَظائِمِ",61,"م",1,0],["رَأتْ شيئاً يُضاحِكُها فصَدَّتْ","وكان جَزاؤُهُ منها العُبوسا",62,"س",2,1],["رأتْ أسَدَاً يَلقَى المنيَّةَ حاسِراً","إذا اختالَ في قُمْصِ الحديدِ أُسودُها",63,"د",3,0],["رأتْ أمثالَ صورتِها حديداً","فكادَتْ وهي راسيةٌ تَميدُ",64,"د",1,0],["راتعٌ في رياضِ حمدِ أُناسٍ","رتَعوا منه في رياض ثَوابِ",65,"ب",1,0],["رأت جانبَ الأعداءِ سهلاً فأسهلَت","فلائقُ كانت بِغضةً وتحبُّبا",66,"ب",2,0],["رَأَت رَجُلاً لاقى مِنَ العَيشِ غِبطَةً","وَأَخطَأَهُ فيها الأُمورُ العَظائِمُ",67,"م",1,1],["رَأَتكَ اللَيالي يا اِبنَ آدَمَ ظالِماً","وَخيرُ الوَرى مَن يَعفُ عِندَ اِقتِدارِهِ",68,"ر",2,1],["رَأَت غَداةَ النَوى نارَ الكَليمِ وَقَد","شَبَّت وَلَم تُبقِ مِن قَلبي وَلَم تَذَرِ",69,"ر",1,0],["رَأَتِ السُحبُ أَنَّها حينَ تَهمي","لَيسَ تَمتَدُّ نَحوَها الأَبصارُ",70,"ر",1,0],["رَأَت بَنو أُرتُقٍ نَهجَ الرَشادِ بِهِ","وَليسَ كُلُّ زِنادٍ في الدُجى يوري",71,"ر",2,0],["رأت بك روح الفجر حين تبيّنت","بياض الأماني في أشعَّته الحُمر",72,"ر",1,0],["رَأَتْني سُلَيمَى والقذالُ كأنّما","تَنَفّسَ فيه الصبحُ فابيَضَّ حالِكُه",73,"ك",2,0],["رَأَتهُ في المَهدِ عَتّابٌ فَقالَ لَها","ذَوو الفِراسَةِ هَذا صَفوَةُ الكَرَمِ",74,"م",1,0],["رَأَت قَسَماتٍ قَد تَقَسَّمَ نَضرَها","سُرى اللَيلِ وَالإِسآدُ فَهيَ سَواهِمُ",75,"م",1,0],["رَأَت تَشَنُّنَهُ فَاِهتاجَ هائِجُها","وَقالَ لاعِجُها لِلعَبرَةِ اِنسَكِبي",76,"ب",2,0],["رَأَتكِ عَيني فَدَعاني الهَوى","إِلَيكِ لِلحَينِ وَلَم أَعلَمِ",77,"م",1,0],["رَأَت رَجُلاً شاحِباً جِسمُهُ","مُسارِيَ أَرضٍ أَطالَ الوَجيفا",78,"ف",2,0],["رَأَت رَجُلاً أَمّا إِذا الشَمسُ عارَضَت","فَيَضحى وَأَمّا بِالعَشيِّ فَيَخصَرُ",79,"ر",1,0],["رأت جللاً من الأحداثِ نُكراً","هَراقَ العينَ واعتصرَ الجبينا",80,"ن",2,0],["رأت حُورَ الجِنانِ مُصرَّعاتٍ","يُقرِّبْن النُّفوسَ ويفتدينا",80,"ن",2,0],["رَأَت مِنكَ المُلوكُ فَتى خُطوبٍ","يُدافِعُهُنَّ بِالهِمَمِ الكِبارِ",81,"ر",1,0],["رأتْ ملّةَ الكُفرِ تغزو النُّفوس","فجاءَتْ تُمزِّقُ أوصالَها",82,"ل",3,0],["رأته يَنحَطُّ من عَليائِهِ فزعاً","من بعد ما أفزعَ الأجيالَ مُشتَرِفَا",83,"ف",2,0],["رَأَت الغَدرَ فَآذاها فَهَل","تَحملُ الضيم وَلَمّا تَغفلِ",84,"ل",1,0],["رَأَتني خَضِيبَ الرأسِ شَمَّرتُ مِئزَري","وَقَد عَهِدتني أَسوَدَ الرَأسِ مُسبِلا",85,"ل",2,1],["رَأَت رائِحاً جَوناً فَقامَت غَريرَةٌ","بِمِسحاتِها قَبلَ الظَلامِ تُبادِرُه",86,"ر",2,0],["رَأَت أُقحُوانَ الشَيبِ لاحَ وَآذَنَت","مَلاحاتُ أَيّامِ الصِبا بِوَداعِ",87,"ع",1,0],["رَأَت طالِعاً لِلشَيبِ أَغفَلتُ أَمرَهُ","وَلَم تَتَعَهَّدهُ أَكُفُّ الخَواضِبِ",88,"ب",1,1],["رأتْني حِماماً فاقشَعَرّتْ جُلُودُهَا","وإني زعيمٌ أنْ تَلينَ العَرائك",89,"ك",1,0],["رأتْ هاشمٌ من تلك ما قد بدا لها","وفي هذه مَكنُونُ ما لم يكن يبدو",90,"د",2,0],["رَأَت شَخصَ الرَقيبِ عَلى التَداني","فَأَسبَلَتِ الظَلامَ عَلى الضِياءِ",91,"ا",2,0],["رَأَت عِندَنا ضَوءَ السِراجِ فَراعَها","فَما سَكَنَت حَتّى أَمَرنا بِهِ يُطفى",92,"ا",1,0],["رَأَت نوحاً وَقَد شَمِطَت وَشابَت","وَقَد شَهِدَت قُروناً قَبلَ نوحِ",93,"ح",1,0],["رَأَتِ الدَهرَ ناشِئاً","وَكَبيراً مُهَرَّما",94,"م",2,0],["رَأَت زِيَّ الغُلامِ أَتَمَّ حُسناً","وَأَدنى لِلفُسوقِ وَلِلأَثامِ",95,"م",1,0],["رَأَت لَها صورَةً تَروقُ بِها","فَأَقبَلَت فَردَةً لِمُنفَرِدِ",96,"د",1,0],["رَأَت جارَها رُدَّت عَلَيهِ حَديقَةٌ","مِنَ المالِ ماطَت نَجتَني رُطَباً رَغدا",97,"د",2,0],["رَأَت خَلَلاً بَينَ العُيونِ فَأَقبَلَت","عَلى خَوفِ أَعداءٍ وَخَوفِ وُلاةِ",98,"ه",1,0],["رَأَتني تَرَفَّعتُ الشَبابَ فَأَعرَضَت","بِشِقٍّ فَما أَدري طَغَت أَم أَدَلَّتِ",99,"ت",1,0],["رَأَتكَ البَرايا ظالِماً يا اِبنَ آدَمٍ","وَبِئسَ الفَتى مَن جارَ عِندَ اِقتِدارِهِ",100,"ر",2,0],["رأَت كل شيء في الطَبيعة غيرها","جميلاً به تجلى العيون وَتبهر",101,"ر",1,0],["رأَت أَعينى من كنت أُصفِي مودتي","له يَبتَغي ضيمي وَيَسعى إلى حَتفي",102,"ف",2,0],["رأت وراء الصدر طَي","راً قَلِقاً مضطربا",103,"ب",2,0],["رأتْ إساري في قيودٍ ثقالْ","بين يدَيْ ذي مِرّةٍ يبسمونْ",104,"ن",1,0],["رأتِ الحِدادَ به على أحيائها","أتُراهمو صَبَغوا السماءَ حِدادا",105,"د",2,0],["رأتْها العُيونُ الزُّرْقُ في كَيْدِ وائِلٍ","وعايَنَها في حَرْبِ ذُبْيان داحِس",106,"س",1,0],["رَأتْني بالمَطِيرَةِ لا رَأتْني","قَريباً والمَخِيلَةُ قد نأتْني",107,"ن",2,1],["رأتْ زَهَراً غضّاً فهاجَتْ بمِزْهَرٍ","مَثانِيهِ أحْشاءٌ لَطُفْنَ وأوْصال",108,"ل",1,0],["رأتْ كَوْثَرَيْ رِسْلٍ وخَمْرٍ بجَنّةٍ","شآمِيّةٍ ما أُكْلُ ساكِنِها خَمْط",109,"ط",1,0],["رَأَتْ شُدُنَ الآرامِ في زَمَنِ الهَوى","ولم تَرَ لَيْلى فهي تَسْفَحُ ماءَهَا",110,"ا",3,0],["رَأَتْهُ فِيهَا كَثِيرَ غَمٍّ","يَبدُو عَلَى وَجْهِهِ اصْفِرَارْ",111,"ر",1,0],["رَأَتْ بِرَبْعِكَ عِزَّ المُلْكِ فَانْصَرَفَتْ","عَنْ ذِكر لُبْنَى وَذِكْرَى رَبْعِهَا الْخرِبِ",112,"ب",1,0],["رأت فاتحَ الدنْيا يفرُّ جبانةً","ويُلْقِي على الأقدارِ نظرةَ عاتبِ",113,"ب",1,0],["رأتْ مصر فيه عاهلاً عزّ نِدُّه","ومن أيْن للبدرِ المنيرِ صحابُ",114,"ب",1,0],["رَأَتْ فِيه مِصْرٌ همَّةً عَلَويّةً","يَرى كُلُّ بَأْسٍ عَزْمَها فيُجَانِبُه",115,"ب",2,0],["رَأَتِ البَصْرَةُ فِيهِ حَفْلَها","وَرَأَتْ بَغْدَادُ فِيه مُنْتَدَاها",116,"ا",3,0],["رَأَتْ جَلالاً مَهيباً","فَمَا وَنَتْ أَنْ تَهَابَا",117,"ب",2,0],["رأتك كالدهرِ 