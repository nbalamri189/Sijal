{"poems":[[41,"هل يدنيك من أجارع واسط","https://www.aldiwan.net/poem53778.html","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141998","الخفيف"],[382,"ذلت لعزة دينك الأديان","https://www.aldiwan.net/poem59237.html","الكامل"],[747,"","https://poetry.dctabudhabi.ae/diwan/poem/143295","الكامل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86523","الكامل"],[4205,"","https://poetry.dctabudhabi.ae/diwan/poem/22105","الخفيف"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83141","الكامل"],[5409,"هدأ الدجى لولا أنين عليل","https://www.poetsgate.com/ViewPoem.aspx?id=155307",""],[5691,"سفارة فوق الدماء","https://www.poetsgate.com/ViewPoem.aspx?id=206030",""],[6097,"دموع دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=190673",""],[6320,"ثَلْجُ الجَحِيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83636&r=&rc=17",""]],"verses":[["يَتَضَمَّنونَ لِمَن يُجاوِرُ فيهِمُ","رَيبَ الزَمانِ وَكَبَّةَ الإِقتارِ",0,"ر",1,0],["يتضاربنَ بالجوانح تزحاما","ويمعِنّ في الفضاءِ سباقا",1,"ق",2,0],["يتضمن اللاهوتَ متَّحداً به","والإتحاد يزينه التبيان",2,"ن",1,0],["يتضارطون فإن شكوت ضراطهم","شفعوا سماع الضرط بالإسماع",3,"ع",1,0],["يتضاحكون من الردى حتى غدا","لهم صدى البارود عزف قيان",4,"ن",1,0],["يتضَوَّعنَ لَو تَضَمَّخنَ بِالمِس","كِ صُناناً كَأَنَّهُ ريحُ مَرق",5,"ق",1,0],["يَتَضاحَكانِ مِن السُرو","رِ وَفي الأَسى يَتباكَيانِ",6,"ن",1,0],["يتضورون بمسمعٍ من جارهم","فكأن بينهم مسافةَ ميل",7,"ل",1,0],["يتَضاحكُ كُوشْنَرُ مبْتَهِجاً","والحِقْدُ بهِ طبْعٌ صِرْفُ",8,"ف",1,0],["يَتضوّعونَ إذا الرياحُ تقلّبَتْ","أهواؤُها.. فجَرَتْ تَجورُ عليها",9,"ي",3,0],["يَتَضَاحَكُونَ إِذَا الْتَقَوْا بِنَوَائِبِي","وَأَنَا بِهَمِّي نَازِفاً أُحْصِي السِّنِينْ",10,"ن",1,0]]}