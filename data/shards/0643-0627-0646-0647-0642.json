{"poems":[[53,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[91,"أيتها النفس اقترب","https://www.aldiwan.net/poem44672.html","مجزوء الرجز"],[63,"جاءك شهر السرور شوال","https://www.aldiwan.net/poem51336.html","المنسرح"],[51,"ما أقرب الموت منا","https://www.aldiwan.net/poem63162.html","المجتث"],[68,"نم بسر الروض خفق الرياح","https://www.aldiwan.net/poem41356.html","الرجز"],[54,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[50,"للمقت سطران في خديه من شعر","https://www.aldiwan.net/poem66151.html","البسيط"],[159,"سقيا ليوم بدا قوس الغمام به","https://www.aldiwan.net/poem55650.html","الطويل"],[159,"وغادة ترفل في الشباب","https://www.aldiwan.net/poem55794.html","الرجز"],[189,"سيان ستر غرامي فيك والعدم","https://www.aldiwan.net/poem14662.html","البسيط"],[208,"لا تكبروا من ملاح المرد إنسانا","https://www.aldiwan.net/poem53168.html","البسيط"],[226,"قائم فوق شاطىء النهر","https://www.aldiwan.net/poem55276.html","المنسرح"],[558,"استمطر العين أن أحبابه احتملوا","https://www.aldiwan.net/poem68393.html","البسيط"],[558,"نبا به الوساد","https://www.aldiwan.net/poem68396.html","مجزوء الرجز"],[558,"يا أيها المعمود","https://www.aldiwan.net/poem68407.html","مجزوء الرجز"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138202",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122598","البسيط"],[789,"","https://poetry.dctabudhabi.ae/diwan/poem/146221","المجتث"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64229","الخفيف"],[880,"","https://poetry.dctabudhabi.ae/diwan/poem/34787","السريع"],[928,"","https://poetry.dctabudhabi.ae/diwan/poem/145676","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62586","البسيط"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25426","الرجز"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145112","الرجز"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6763","السريع"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123167","البسيط"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123099","البسيط"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47182","البسيط"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75996","البسيط"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58317","السريع"],[2365,"وحارس غفلة حرّاسه","https://www.poetsgate.com/ViewPoem.aspx?id=200644",""],[159,"وغادة ٍ ترفلُ في الشبابِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26940&r=&rc=11",""]],"verses":[["كأنه قالبٌ لكلّ هوىً","فكلُّهُ والمُنى على قَدَرِ",0,"ر",1,0],["كأنه قلادة","من لؤلؤ على لبب",1,"ب",1,0],["كأنه قيد فضة حرج","فض عن الصائمين فاختالوا",2,"ل",3,0],["كَأَنَّهُ قَد سَقانا","بِكَأسِهِ حَيثُ كُنّا",3,"ن",2,0],["كَأَنَّهُ قَد شَقَّ بَحرَ الدُجى","وَبَعدَهُ خاضَ غَديرَ الصَباح",4,"ح",1,0],["كَأَنَّهُ قَحطانُ أَو مَعَدٌّ","وَدارُهُ تِهامَةٌ أَو نَجدُ",5,"د",1,0],["كَأَنَّهُ قَمَرٌ وَلّى المِحاقُ بِهِ","في لَيلَةِ التَمِّ إِذ وافى مَدى حُسنِه",6,"ه",1,0],["كَأَنَّهُ قَوْسُ رامٍ والبُرُوقُ لَهُ","رَشْقُ السِّهامِ وعَيْنُ الشَّمْسِ بُرْجاسُ",7,"س",1,0],["كأَنَّهُ قُفلٌ عَلَى خَرابِ","مفتاحه أَير أَبي تُرابِ",8,"ب",1,0],["كأَنه قد تَغذَّى من نوالِ أبى","عبد الإله الذي تَرْوَى به الأُمَم",9,"م",1,0],["كأنه قبَّة من فضَّةٍ قسِمت","في ملتقى الخَور أردافاً وأعكانا",10,"ن",2,0],["كأنه قد أقام محتفظاً","برمال تلوح كالتبر",11,"ر",1,0],["كَأَنَّهُ قَمَرٌ أَو ضَيغَمٌ هِصرٌ","أَو حَيَّةٌ ذَكَرٌ أَو عارِضٌ هَطِلُ",12,"ل",1,0],["كَأَنَّهُ قَضيبٌ","في غَرسِهِ مَيّادُ",13,"د",1,0],["كَأَنَّهُ قَضيبٌ","في غَرسِهِ يَميدُ",14,"د",1,0],["كأنه قلعة قامت على عمد","يدعو مؤذنها للفرض مرتقبا",15,"ب",2,0],["كأنَّه قَمَرٌ يَقضي بصاعِقَةٍ","في الرَّوع أو بِشهابٍ منه وَقّاد",16,"د",1,0],["كأنه قُرَشِيٌّ","تهفو عليه البنود",17,"د",1,0],["كأنه قمرٌ ما مثله بشرٌ","في طرفه حورٌ يرنو فيجرحني",18,"ن",2,0],["كأنه قد قيل في مجلسٍ","قد كنت آتيه وأغشاه",19,"ا",2,0],["كأنه قلم في كف ذي أرب","يواصل الضبط في تقييد أشعار",20,"ر",1,0],["كأنّه قالَب قد صِيغ من رِقَةٍ بي","ضاء قد طُبعت فيه الكمالاتُ",21,"ت",1,0],["كَأَنَّهُ قَدْ كانَ رَبْعاً فَعَفا","يُمْسِي فَيُضْحِي لِلْمَنايا هَدَفا",22,"ف",2,0],["كأنه قد سخر البيانا","فانكشف الغيب له عيانا",23,"ن",2,0],["كَأَنَّهُ قَد جاءَهُ مُخبِرٌ","بِأَمنِهِ مِن قِبَلِ اللَهِ",24,"ل",2,0],["كأنَّهُ قَيلٌ أوانَ فَتكِهِ","قِرناً تَصَدَّى لِزَوالِ مُلكِهِ",25,"ه",1,0],["كأنه قدح تنصبّ في فمه","خمر بها البسط مخصوص سوا بسوا",26,"و",2,0],["كأنه قمر قد لاح في شفق","وكاد من شعره يغشاه ديجور",27,"ر",1,0],["كأنّه قال مَنْ يهْوَى مَحَاسِنَهُ","لم يَسْتَطِعْ دونَ شرح الحبِّ كِتمانا",28,"ن",2,0],["كَأَنَّهُ قمرٌ قَد حَفَّهُ قِطعٌ","مِن الغَمامِ فَمَستورٌ وَمَكشُوفُ",29,"ف",1,0],["كأنَه قد سَقَطَتْ دالهُ","فأصبحَ العَوادُ عَواءَ",30,"ا",2,0],["كأنه قد ضلّ في قفرة","عليه باب القصد مسدود",31,"د",1,0],["كأنهُ قفلٌ على َ خرابِ","مفتاحهأ .. أبي ترابِ",32,"ب",1,0]]}