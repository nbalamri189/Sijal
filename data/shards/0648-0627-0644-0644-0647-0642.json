{"poems":[[79,"ما لليراع خواضع الأعناق","https://www.aldiwan.net/poem35907.html","الكامل"],[79,"العمر نوم والمنى أحلام","https://www.aldiwan.net/poem36107.html","الكامل"],[79,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[29,"ولقد رحلت إليكم عيدية","https://www.aldiwan.net/poem5794.html","الكامل"],[72,"لا تعتب الدهر في خطب رماك به","https://www.aldiwan.net/poem43037.html","البسيط"],[71,"آثارك الحسنى إذا ما بدت","https://www.aldiwan.net/poem28472.html","السريع"],[33,"من عاشق صب يسر الهوى","https://www.aldiwan.net/poem41320.html","السريع"],[33,"من عاشقٍ صبٍّ يسرُّ الهوى ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19084&r=&rc=346",""],[234,"قل لنزار أنت أس العلا","https://www.aldiwan.net/poem50994.html","السريع"],[242,"يا أمنا ميمونه","https://www.aldiwan.net/poem19276.html","مجزوء الرجز"],[369,"في الجيرة الغادين بدر","https://www.aldiwan.net/poem60895.html","مجزوء الكامل"],[369,"هل أنت بطولك مسعده","https://www.aldiwan.net/poem60943.html","المتدارك"],[371,"مملوك مولانا ومملوك ابنه","https://www.aldiwan.net/poem17907.html","الكامل"],[408,"أذكر الوعد مولانا ومالكنا","https://www.aldiwan.net/poem46927.html","البسيط"],[409,"فقلت حسبكما لله دركما","https://www.aldiwan.net/poem33440.html","البسيط"],[445,"السيف أبهى للعلا","https://www.aldiwan.net/poem34762.html","مجزوء الكامل"],[445,"عمرت بطول بقائك الأعمار","https://www.aldiwan.net/poem34878.html","الكامل"],[469,"قد كانت الفصحاء تذكر حاتماً","https://www.aldiwan.net/poem3391.html","عموديه"],[563,"في الكون للحق أمثال بها نطقا","https://www.aldiwan.net/poem34300.html","البسيط"],[563,"إني أنا بك يا ودود","https://www.aldiwan.net/poem34580.html","مجزوء الكامل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[580,"يا قلب ويحك إن ظبيك قد سنح","https://www.aldiwan.net/poem3091.html","الكامل"],[592,"قلب المحب من الهجران مكلوم","https://www.aldiwan.net/poem11515.html","عموديه"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138291",""],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87117","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38277","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62534","الكامل"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105464","البسيط"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105462","الكامل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114706","السريع"],[1971,"","https://poetry.dctabudhabi.ae/diwan/poem/97560","المجتث"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131331","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27384","السريع"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27906","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77345","الكامل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112622","الرجز"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48459","البسيط"],[3531,"","https://poetry.dctabudhabi.ae/diwan/poem/145737","الدوبيت"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77136","الكامل"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78300","الكامل"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78234","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119689","البسيط"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119602","الرجز"],[4149,"","https://poetry.dctabudhabi.ae/diwan/poem/145504","السريع"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95053","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83388","الكامل"],[4578,"","https://poetry.dctabudhabi.ae/diwan/poem/114605","الكامل"],[4767,"استئثار","https://www.poetsgate.com/ViewPoem.aspx?id=185275",""],[4778,"معجزة","https://www.poetsgate.com/ViewPoem.aspx?id=197696",""],[4798,"وطن الجنى","https://www.poetsgate.com/ViewPoem.aspx?id=20227",""],[5033,"قبضةٌ من أثر الرسول","https://www.poetsgate.com/ViewPoem.aspx?id=207615",""],[5150,"غربة","https://www.poetsgate.com/ViewPoem.aspx?id=202797",""],[5185,"الوعد","https://www.poetsgate.com/ViewPoem.aspx?id=71576",""],[5271,"على ضفافكِ أَستطيبُ عَذابي","https://www.poetsgate.com/ViewPoem.aspx?id=60537",""],[5273,"نداء","https://www.poetsgate.com/ViewPoem.aspx?id=28772",""],[5410,"دٌّ على موغل في الزيفِ والعدم","https://www.poetsgate.com/ViewPoem.aspx?id=140754",""],[5411,"القَصيدةُ المحَمدية","https://www.poetsgate.com/ViewPoem.aspx?id=186387",""],[5431,"مادمت أنت بناره متورّطا ....","https://www.poetsgate.com/ViewPoem.aspx?id=200964",""],[5431,"وقفة عزّة....","https://www.poetsgate.com/ViewPoem.aspx?id=206595",""],[5596,"إلى آل الفلاح في مصابهم","https://www.poetsgate.com/ViewPoem.aspx?id=206783",""],[5829,"تحية الى اهل العلم","https://www.poetsgate.com/ViewPoem.aspx?id=159310",""],[5956,"خلَفٌ أتانا طاهراً مثل السّلفْ","https://www.poetsgate.com/ViewPoem.aspx?id=193487",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[6093,"القصيدة الزبيدية في مدح خير البرية","https://www.poetsgate.com/ViewPoem.aspx?id=195006",""]],"verses":[["واللهُ قدْ قرَنَ الثّناءَ بأرْضِهِ","بثَنائِهِ منْ فوْقِ سَبْعِ طِباقِ",0,"ق",1,0],["وَاللهُ قَدْ كَتَبَ الْفَنَا عَلَى الْوَرَى","وَقَضَاؤُهُ جَفَّتْ بِهِ الأَقْلاَمُ",1,"م",1,0],["وَاللهُ قَدْ ولاَّكَ أَمْرَ عِبَادِهِ","لَمَّا ارْتَضَاكَ وِلاَيَةً لاَ تُعْزَلُ",2,"ل",1,0],["وَاللَهُ قَدَّرَ أَن تَكونَ خَليفَةً","خَيرَ البَرِيَّةِ وَاِرتَضاكَ المُرتَضي",3,"ض",2,0],["وَاللَهُ قَد جَعَلَ الأَيّامَ دائِرَةً","فَلا تَرى راحَةً تَبقى وَلا تَعَبا",4,"ب",2,0],["واللّهِ قدْ أبكيتِ عيني وقدْ","أوحشتِ يا شمسَ الضحى داري",5,"ي",1,0],["وَاللَهُ قَد أَنزَلَ في وَحيِهِ","مُبَيِّناً في آيِهِ المُحكَمِ",6,"م",1,0],["واللهُ قد انزل في وحيههِ","مُبَيِّناً في آيِهِ المُحْكَمِ:",7,"م",1,0],["واللهُ قد أعطاك سعدا رمى","عن مِلكك الأعداء بالنحسِ",8,"س",1,0],["وَاللهُ قَدْ أَوْلاَكِ بَذْ","لَ الْعُرْفِ يَا مَصُونَهْ",9,"ن",2,0],["واللّهُ قد باهَى بِه","هل فوقَ أَمْرِ اللّهِ أَمر",10,"ر",1,0],["واللهُ قضَى بالرُّشْدِ له","فَتخَيَّرَه مُستَرشِده",11,"د",2,0],["وَاللَهُ قَد ذَكَرَ السَلامَ وَأَنَّهُ","يَجزي بِأَحسَنَ مِنهُ في القُرآنِ",12,"ن",1,0],["والله قد أَمر الطّهر البتولَ بأن","تهزّ بالجذعِ حتّى يسقط الثّمرُ",13,"ر",1,0],["واللّه قسم في الأقطار نعمته","فكل قطر به من فضله قسم",14,"م",1,0],["واللهُ قَدْ ضَمِنَ الجَزَا","ءَ لِكُلِّ مُقْتَدِرٍ عَفا",15,"ا",1,0],["واللهُ قَدْ أَعْلَى مَحَلَّكَ أَنْ تُرى","مكشوفَةً فِي سِتْرِكَ الأَسْتارُ",16,"ر",1,0],["والله قد أدنى لنا بك بعدما","طال المدى منهُ البعيد النازحاً",17,"ح",2,0],["والله قد ضرب الأكوان أمثلة","بالفعل لا نحن فاترك عنك ذا السلقا",18,"ق",2,0],["والله قال بكل شي","ء قل محيط محض جود",19,"د",1,0],["والله قد كفل للنبي","بالنصر والتمكين للمهديّ",20,"ي",1,0],["والله قد أكد في إيجابه","طاعة أهل الأمر في كتابه",20,"ه",1,0],["والله قد أوجب في التنزيل","لكل من آمن بالرسول",20,"ل",1,0],["والله قد براه في المعروف","من قوله الحق من التكليف",20,"ف",1,0],["والله قد أمر أن تقرا","في بيتها فأبرزوها جهرا",20,"ر",2,0],["والله قد حكم فيما قالا","في وحيه المنزل الرجالا",20,"ل",2,0],["والله قد أنزل فيه آية","بأن فيه لهم كفاية",20,"ه",1,0],["والله قد فضل في كتابه","وقدم الفاضل في إيجابه",20,"ه",1,0],["واللهُ قَدْ فَتَح المُرادُ لأَنَّه","بقدومِ مَوْكِبك المُظَفَّرِ قد فَتَح",21,"ح",1,0],["والله قد وعد الإسلام نصرته","لكن ذا البغي من ذا الوعد محروم",22,"م",1,0],["والله قال لهم بايمان تكو","ن المعجزات وذاك حقا قد جرى",23,"ر",2,0],["وَاللَه قيَّضه لنصرة ملة","نجحت لَهُ فيما تَروم عَزائم",24,"م",1,0],["وَاللَّه قَلّب أَهلَ الكَهفِ إِذ رَقَدوا","لَولاهُ كانوا فَنوْا بِالتّربِ وَالبللِ",25,"ل",1,0],["والله قد شرع الشرائع لم يدع","فيها اختياراً للمريد الآملِ",26,"ل",1,0],["واللَه قد شد أزر المسلمين بهم","وقد لقينا بهم في دهرنا وزرا",27,"ر",2,0],["واللَه قلدك الأمور ولا أرى","مناً عليك لغير ربك فاشكر",28,"ر",1,0],["واللَهُ قد عاتَبَ في نَملةٍ","نبيَّ صدقٍ هديُهُ يُحمَدُ",29,"د",1,0],["واللَه قدّر هذا","وَلَم يكن باِختياري",30,"ر",2,0],["واللهُ قد أَيَّدَهُ بالنَّصْرِ","وجاءَهُ استِمْرَارُهْ بِمصرِ",31,"ر",1,0],["والله قد عيّن نوّابه","في نشأةٍ قامتْ من الثقل",32,"ل",1,0],["والله قد ذمَّ الذي نحت الذي","هو عابدٌ إياه وهو صَموت",33,"ت",1,0],["واللهُ قَد أعطَاهُ ذَاكَ وَلَيسَ هَ","ذَا وَصفَهُ فاعجَب مِنَ البُهتَانِ",34,"ن",1,0],["واللهُ قَالَ وَقَائلٌ وَكَذَا يَقُو","لُ الحَقَّ لَيسَ كَلاَمُهُ بِالفَاني",34,"ن",2,0],["واللهُ قَد نَادَى الكَلِيمَ وَقَبلَهُ","سَمِعَ النِّدَا في الجَنَّةِ الأبَوَانِ",34,"ن",1,0],["وَالله قَد وَصَفَ الجَمَاد بِأنَّهُ","مَيتٌ أصَمُّ وَمَا لَهُ عَينَانِ",34,"ن",1,0],["واللهُ قَد جَعَل الضَّلاَلَةَ قُدوةً","بِأئِمَّةٍ تَدعُو إِلَى النِّيرَانِ",34,"ن",1,0],["وَاللهُ قَالَ بِنَفسِهِ لرَسُولِهِ","إنِّي أنَا الله العَظِيمُ الشَّانِ",34,"ن",1,0],["وَاللهُ قَالَ بِنَفسِهِ لرَسُولِهِ","اذهَب إلَى فِرعَونَ ذِي الطُّغيَانِ",34,"ن",1,0],["وَاللهُ قَالَ بِنَفسِهِ حَمَ مَع","طَهَ وَمَع يَس قَولَ بَيَانِ",34,"ن",1,0],["واللهِ قَدَّرَ ذَاكَ أجمَعَهُ بِإح","كَامٍ وإتقَانٍ مِنَ الرَّحمَنِ",34,"ن",1,0],["والله قَد كَفَّرتُم مَن قَالَ بَع","ضَ مَقَالِهِم يَا أمَّةَ العُدوَانِ",34,"ن",1,0],["والله قد أحصى الذي قد قلتم","في ذلك المعراج بالميزان",34,"ن",1,0],["والله قد جعل النساء عوانيا","شرعا فأضحى البعل وهو العاني",34,"ن",2,0],["والله قد جعل البنين مع النسا","من أعظم الشهوات في القرآن",34,"ن",1,0],["وَاللَهُ قَد شَرَعَ الصَلاة عِبادَةً","وَرِياضَةً لِلروحِ وَالجُثمانِ",35,"ن",1,0],["واللَهُ قَد شاءَ بأن يَراهُ","مُخضّباً بالطف في دماهُ",36,"ه",1,0],["واللهُ قد ضاعفَ الأجْرَ الجزيلَ بما","ألمّ من ألَمٍ في اللّوحِ مكْتوبِ",37,"ب",1,0],["واللهُ قد قال فيه قبلي","يهجوه لا خيرَ في كَثير",38,"ر",1,0],["وَاللّهُ قَد وَعَدَ المَزيدِ بِشُكرِهِ","وَلإِن شَكَرتُم قالَ فَاِشكُر تَزدد",39,"د",1,0],["وَاللَهُ قَد خَلَقَ الجَميلَ وَلَم يَقُل","هيموا بِلين قَده المُتَمايِل",40,"ل",1,0],["وَاللَه قلدك المهابة وَالبَها","مننا وَأَنتَ بِما حبت خَليق",41,"ق",1,0],["واللَه قسَّم بين الناس رزقهم","لا يجلب الحزم ما الرحمن يدفعه",42,"ع",2,0],["واللَه قد حفكّم بالنصر","فزال عنكمُ جميعُ الضُرّ",43,"ر",1,0],["والله قد آثره بالعلا","وخصه الله بما خصه",44,"ص",2,0],["واللَه قد أرَّختُ جاد بلا مِرا","وإلى صفا التخليد آسين اصطفى",45,"ف",2,0],["وَاللَهُ قدَّر كُل شَيء هَل تَرى","قُدِّرتَ لي يا سَعد قبلَ مَماتي",46,"ي",1,0],["واللَه قد أثنى عليكم بالذي","قد شرَّف الثقلين منه ثناء",47,"ا",2,0],["والله قد أوصى به","عما يراد وأقسما",48,"م",2,0],["والله قد قال إنّي خالق بشرا","خلائف الأرض تهدي للمروآت",49,"ت",1,0],["والله قد أعلاك صوتَ حقيقةٍ","أو كشَّر الأعداءُ عن نابِ الشنا",50,"ن",2,0],["واللهُ قدّرَ أن تلقاهُ فاحتفلتْ","بك السماواتُ وانثالَ المدى عِطرا",51,"ر",2,0],["والله قد مسحَ الشقاءَ بمسحةٍ","بيدِ المسيحِ فهل ترى من يَفهمُ..!؟",52,"م",1,0],["والله قد وعد الرسول صراحة","فالحج والفتح المبين يرام",53,"م",1,0],["والله قد باتَ الفؤادُ مُهجّراً","والبعد ينكأ جرحهُ بِإيابِ",54,"ب",1,0],["واللهِ قد حَسِبوا بأنَّ مياهَكمْ","فيها الشفاء لهم كما في زمزمِ",55,"م",1,0],["والله قد أوجد الإحساس مَكْرُمَةًً","كي يُدرِكَ المرءُ ما أضناه مِنْ ألمِ",56,"م",1,0],["والله قَدْ قَدَّرَ الأرْزاق في قَدَرٍ","والله قَدْ خَلَق الدُّنيا بأقْدارِ",57,"ر",1,0],["والله قد وهب القلوب ثمارها","هل للفؤاد بزرعه أن يقنطا؟",58,"ط",2,0],["والله قد جعل الكرام منابرا","هو أهل من أتْقى وأهل المغفرة",59,"ر",2,0],["والله قدّر فابتلى","فجزى بأضعافٍ ثواب",60,"ب",1,0],["والله قد خلبَ الألبابَ منطقُه","فاستأسر الحبُّ أدنانا وأقصانا",61,"ن",2,0],["والله قد قضّيتُ عمري مخلصاً","أغنى الزمان هدىً به الكون اعترفْ",62,"ف",1,0],["(وَاللهُ) (قادِرٌ) و(َمُقتدِرٌ)","وَواسعُ الرَّحمَاتِ والنِّعَمِ",63,"م",1,0],["7.والله ُ قَدْ أَلْقَى عَلَيْكَ مَحَبَّةً","وَبِهَا أَحَبَّكَ كُلُّ مَنْ لَاقَاكَا",64,"ك",2,0],["42.وَالله ُ قَدْ أَوْحَى إِلَيْكَ كَلامَهُ","فُهُنَاكَ أَحْمَدُ قَدْ بَلَغْتَ هَنَاكَا",64,"ك",2,0]]}