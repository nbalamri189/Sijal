{"poems":[[74,"ما لمن لام فيكمو من جواب","https://www.aldiwan.net/poem18239.html","الخفيف"],[93,"أروي لكمعن شاعر ساحير","https://www.aldiwan.net/poem62815.html","عموديه"],[71,"قال داري مضيئة","https://www.aldiwan.net/poem28673.html","مجزوء الخفيف"],[107,"أقبلوا راشدين فالأمر جد","https://www.aldiwan.net/poem44015.html","الخفيف"],[107,"نهضت من كل أوب تلتقي","https://www.aldiwan.net/poem44200.html","الرمل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54684","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[113,"صالح للخير لما أن بنى","https://www.aldiwan.net/poem16319.html","الرمل"],[119,"ملك الدنيا امام المسلمين","https://www.aldiwan.net/poem40477.html","عموديه"],[193,"حمد امرئ أخلص في آدائه","https://www.aldiwan.net/poem35279.html","الرجز"],[230,"قلت يا صالح ارم دل","https://www.aldiwan.net/poem55120.html","مجزوء الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62552","الرمل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59256","الرمل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100887","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58452","الخفيف"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127399","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204502","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204649","الخفيف"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48348","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91533","الرمل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66572","السريع"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[4701,"لارا","https://www.poetsgate.com/ViewPoem.aspx?id=176662",""],[4919,"جرح","https://www.poetsgate.com/ViewPoem.aspx?id=34792",""],[4929,"قلت ياشعر","https://www.poetsgate.com/ViewPoem.aspx?id=202415",""],[5573,"النعش فوق الثريا له منصه","https://www.poetsgate.com/ViewPoem.aspx?id=206497",""]],"verses":[["قالَ ديوانهُ مقالة صدق","إنّ وَكرَ العقاب لابن العقاب",0,"ب",1,0],["قالَ دَعا أَصحابُهُ سَيِّدٌ","في لَيلَةٍ رَقَّت حَواشيها",1,"ي",3,0],["قال داري مضيئةٌ","قلتُ واللهِ مظلِمهْ",2,"ه",1,1],["قال دَعْهم لمالكِ المُلْكِ وَاعْلَمْ","أنّهم قاتِلوكَ فالقومُ لُدُّ",3,"د",1,0],["قال دعها يا رعاكَ اللهُ لي","وَاشْفِ هذا القلبَ من أوصابِهِ",4,"ه",1,0],["قال دع عنك ذا وقل لي من رب","بكَ من قبل أن يسوءَ المصير",5,"ر",1,0],["قَالَ دَاعِي الخَيْرِ فِي تَارِيخَها","لِتَعِشْ بَرْبَارَةٌ وَلْيَفْرَحُوا",6,"ح",3,0],["قَالَ دَعِ الآتِيَ لِلغَيْبِ","وَخُذْ بِمَا حَضَرْ",7,"ر",1,0],["قالَ داعي البَشَر بَشَراً أَرخوا","في سَبيل اللَه خان قَد بَني",8,"ن",2,0],["قال داعي الغيب يا زوارها","ادخلوها بسلام آمنين",9,"ن",1,0],["قالَ دَعوا لي صَفوتي وَعبدي","كِلاهُما ما جاوزَ العِشرينا",10,"ن",2,0],["قال دَعني كما أَشا","أَحكمُ اليومَ في المَلا",11,"ل",2,0],["قال داعي المجد جهراً أرخوا","مرج الجامع بين الخافقينْ",12,"ن",1,0],["قَالَ دَعْ ذَا وَانْتَقِلْ نَادَيْتُ لاَ","سَمِعَ اللَّهُ لِمَنْ قَدْ سَمِعَكْ",13,"ك",1,0],["قال دعنى لما أنا ابنُ سبيل","أو غريبٌ ولا من الأشرار",14,"ر",1,0],["قالَ دَعني منَ الملامِ فإنّي","لَستُ ما عِشْتُ للملامِ بِسامِعْ",15,"ع",1,0],["قال دمعي وللدموع كلام","يوقظ النفس للهدى والرشاد",16,"د",1,0],["قال دعني لم يبقَ عنديَ زهر","قلت باقٍ لديك زهر الخدود",17,"د",1,0],["قال دعني واذهب لشأنك إذ لم","يجد فيك الملام والتعنيف",18,"ف",1,0],["قال دعْها وسَلِّ قلبَكَ عنْها","قلتُ هَلّا للعاشقين قُلوبُ",19,"ب",1,0],["قال دمعُ العَين سَل ما","ما جَرى من بَعد سلمى",20,"م",2,1],["قَالَ دُجاها لَجُفونِي لَقَد","شَغَلْتِ عَنِّي فَرْقَدِي فَارْقُدِي",21,"د",2,0],["قال دعها فإنَّ ربّاً حسودا","نبلها افتلَّ راغباً أن تبيدا",22,"د",2,0],["قال درويشُ: انتظرْها،ثم لمْ","ينتظرْهُ الموتُ ،هل ماتَ انتظارا؟",23,"ر",2,0],["قال دواء الدنيا كله ما يفيد","ألا بنظره منها نظرة شوق وحنيية",24,"ي",2,0],["قال دعني أما سئمتَ احتراقا","في متوني وهدك الترديدُ",25,"د",1,0],["قال دونك عالم الاحلام وصّه","واكرم الي جاع في عز الصفاري",26,"ر",2,0]]}