{"poems":[[72,"ما لمن لام فيكمو من جواب","https://www.aldiwan.net/poem18239.html","الخفيف"],[91,"أروي لكمعن شاعر ساحير","https://www.aldiwan.net/poem62815.html","عموديه"],[69,"قال داري مضيئة","https://www.aldiwan.net/poem28673.html","مجزوء الخفيف"],[105,"أقبلوا راشدين فالأمر جد","https://www.aldiwan.net/poem44015.html","الخفيف"],[105,"نهضت من كل أوب تلتقي","https://www.aldiwan.net/poem44200.html","الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54684","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[110,"صالح للخير لما أن بنى","https://www.aldiwan.net/poem16319.html","الرمل"],[116,"ملك الدنيا امام المسلمين","https://www.aldiwan.net/poem40477.html","عموديه"],[190,"حمد امرئ أخلص في آدائه","https://www.aldiwan.net/poem35279.html","الرجز"],[226,"قلت يا صالح ارم دل","https://www.aldiwan.net/poem55120.html","مجزوء الخفيف"]],"verses":[["قالَ ديوانهُ مقالة صدق","إنّ وَكرَ العقاب لابن العقاب",0,"ب",1,0],["قالَ دَعا أَصحابُهُ سَيِّدٌ","في لَيلَةٍ رَقَّت حَواشيها",1,"ي",3,0],["قال داري مضيئةٌ","قلتُ واللهِ مظلِمهْ",2,"ه",1,1],["قال دَعْهم لمالكِ المُلْكِ وَاعْلَمْ","أنّهم قاتِلوكَ فالقومُ لُدُّ",3,"د",1,0],["قال دعها يا رعاكَ اللهُ لي","وَاشْفِ هذا القلبَ من أوصابِهِ",4,"ه",1,0],["قال دع عنك ذا وقل لي من رب","بكَ من قبل أن يسوءَ المصير",5,"ر",1,0],["قَالَ دَاعِي الخَيْرِ فِي تَارِيخَها","لِتَعِشْ بَرْبَارَةٌ وَلْيَفْرَحُوا",6,"ح",3,0],["قَالَ دَعِ الآتِيَ لِلغَيْبِ","وَخُذْ بِمَا حَضَرْ",7,"ر",1,0],["قالَ داعي البَشَر بَشَراً أَرخوا","في سَبيل اللَه خان قَد بَني",8,"ن",2,0],["قال داعي الغيب يا زوارها","ادخلوها بسلام آمنين",9,"ن",1,0],["قالَ دَعوا لي صَفوتي وَعبدي","كِلاهُما ما جاوزَ العِشرينا",10,"ن",2,0],["قال دَعني كما أَشا","أَحكمُ اليومَ في المَلا",11,"ل",2,0]]}