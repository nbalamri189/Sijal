{"poems":[[72,"لله غانية يوما خلوت بها","https://www.aldiwan.net/poem42423.html","البسيط"],[77,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54534","الكامل"],[111,"الله أكبر رزء نكس العلما","https://www.poetsgate.com/ViewPoem.aspx?id=525",""],[186,"أحبابنا هل لذاك العهد تذكار","https://www.aldiwan.net/poem67065.html","البسيط"],[302,"ماست فأزرت بالغصون الميس","https://www.aldiwan.net/poem33241.html","الكامل"],[364,"ما أومض البرق بالجرداء مبتسماً","https://www.aldiwan.net/poem809.html",""],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56081","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64617","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108851","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108731","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108687","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108904","البسيط"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48258","البسيط"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88659","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93596","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94018","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93866","الكامل"],[3523,"","https://poetry.dctabudhabi.ae/diwan/poem/131357","الكامل"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2578","البسيط"],[4085,"","https://poetry.dctabudhabi.ae/diwan/poem/105149","الكامل"],[4578,"بغرةٍ تنقضى في حبها حججي","https://www.poetsgate.com/ViewPoem.aspx?id=49370",""],[5749,"العين الشهلا","https://www.poetsgate.com/ViewPoem.aspx?id=28634",""]],"verses":[["لِلَّهِ غانِيَةٌ يَوماً خَلَوتُ بِها","في مَجلِسٍ غابَ عَنّا فيهِ واشيها",0,"ي",3,1],["للّه غزْوَتُهم غداةَ فراقسٍ","وقد استُشِبَّتْ للكريهةِ نار",1,"ر",1,0],["للهِ غُيَّابٌ حضُورٌ في النُّهَى","مَاتُوا فَبَاتُوا أَخْلَدَ الأَحْياءِ",2,"ا",2,0],["لله غيرته لله سيريته","لله نصرته لله ان هجما",3,"م",2,0],["لِلّهِ غُصنٌ نَشا مِن روحِ مَكرُمَةٍ","طابَت لَنا مِنهُ أَغصانٌ وَأَثمارُ",4,"ر",1,0],["لِلَّه غانيةٌ عَنَت لضيائِها","شَمسُ الضحى إِذ أَشرقت في الأطلسِ",5,"س",1,0],["لِلِه غانية هدَّت لواحظُها","قلباً كئيباً ولن ترعى له ذمما",6,"م",2,0],["لله غيبة بطرس كم أودعت","بحشاشتي هماًّ لجسمي اسقما",7,"م",2,0],["لله غيرته لله سيرته","لله نصرته لله إن هجما",8,"م",2,0],["للَّهِ غانية حظيت بها فما","أحلى مراشفها وأطيبها فما",9,"م",2,1],["للَه غانية مرت بنا سحراً","في حلةٍ مثل أذناب الطواويس",10,"س",1,1],["للَه غانية حظيت بوصلها","والليل من نار النهار على حذر",11,"ر",1,1],["للَه غانيةٌ قامت تودِّعني","وشخصها في فؤادي لا يفارقني",12,"ن",2,1],["لله غيثُ ندىً لله ليثُ وغىً","غضنفرٌ لحجابِ النقْعِ هَتَّاكِ",13,"ك",1,0],["لِلَّه غيرة آمر قد اوجبت","حكم القصاص واكدت ما اوجبا",14,"ب",2,0],["لِلّه غادون أَضحى عَيشهم رَغدا","وَناظِري ألف التَسهيد وَالسَهَرا",15,"ر",2,0],["للَه غصن قوام دون ضمته","لم نلق قلباً لصب غير مكسور",16,"ر",1,0],["للَه غزلان لما غازلتها","إلا وقد شردت ودمعي ذارف",17,"ف",1,0],["للّه غيثٌ فيضه غمر الورى","خجل الغيوث بما أفاض وأتحفا",18,"ف",2,0],["لِلَّهِ غارَتُنا وَالمَحلُ قَد شَجِيَت","مِنهُ البِلادُ فَصارَ الأُفقُ عُريانا",19,"ن",2,1],["للَه غانية غفت لضيائها","شمس الضحى إذ أشرقت بالأطلس",20,"س",1,0],["لله غربُ حسام منه قد شهدت","في الغرب أثاره كالصبح في البلج",21,"ج",1,0],["لله غير زور رصامي وقوليا هاني","او شكون هذا حموالساكن فسلا",22,"ل",2,0]]}