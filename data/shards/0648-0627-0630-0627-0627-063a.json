{"poems":[[55,"أي طود دك من أي جبال","https://www.aldiwan.net/poem29889.html","الرمل"],[65,"الورد يبسم والركائب حوم","https://www.aldiwan.net/poem46212.html","الكامل"],[87,"أحمدك الله وأطري الأنبياء","https://www.aldiwan.net/poem8099.html","الرمل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85411","المتدارك"],[108,"ذكرى دنشواي","https://www.poetsgate.com/ViewPoem.aspx?id=179341",""],[92,"يا بنت رسطاليس","https://www.poetsgate.com/ViewPoem.aspx?id=179219",""],[190,"أحمد الله كثيرا","https://www.aldiwan.net/poem43889.html","مجزوء الرمل"],[376,"بدر تم يثنيه دعص وخوط","https://www.aldiwan.net/poem56932.html","الخفيف"],[422,"سعدت نجد إذا وافيت نجدا","https://www.aldiwan.net/poem54161.html","الرمل"],[463,"أخلق الدهر لمتى وأجدا","https://www.aldiwan.net/poem56230.html","الخفيف"],[632,"","https://poetry.dctabudhabi.ae/diwan/poem/203121","المتدارك"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/73951","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53063","الرمل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28517","الرمل"],[3182,"","https://poetry.dctabudhabi.ae/diwan/poem/202670","الكامل"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92454","الكامل"]],"verses":[["وَإِذا أَغلى الوَرى أُكرومَةً","وَجَدوا عِندَكَ أَثمانَ الغَوالي",0,"ل",2,0],["وإذا أغامَ الخَطْبُ جابَ ضَبابَهُ","شَمْسُ الضُّحى وسَطا عَليهِ الضَّيْغَمُ",1,"م",1,0],["وَإِذا أُغضِبتَ فَاِغضَب لِعَظيم","شَرَفٍ قَد مُسَّ أَو عِرضٍ كَريم",2,"م",1,0],["وإذا اغتر الإنسان بقو","وته يعمى منه البصر",3,"ر",1,0],["وإذا أُغيرَ على البلا","د، فكلُّنَا جَيْشٌ يذود",4,"د",1,0],["وإذا اغتَلَتْ فينا مراجلُ نقمةٍ","ألا يكونوا زمهريراً باردا",5,"د",2,0],["وإذا أغلقت بابي","فكأنّي في شلندي",6,"د",2,0],["وإِذا اغتَرَّ قُلتُ ظَبيٌ غَريرٌ","وإِذا افتَرَّ قلتُ دُرٌّ سقِيطُ",7,"ط",1,0],["وإذا أغْمَدْتَهُ كانَ له","هام من يعصيك في الهيجاء غمدا",8,"د",2,0],["وإذا اغبّرتِ السنونَ وأبدَى","شَعثُ الأرض وجهَها المُربَدَّا",9,"د",2,0],["وإذا أغمدت اللحظ فتك","ت فكيف وأنت تجرده",10,"د",2,0],["واذا اغتابك اللئيم فشكراً","حيث أضحى جهد اللئيم اغتيابه",11,"ب",2,0],["وإذا أُغْلِقَ بابٌ فثقوا","من أبي الفتح بتسهيل افتتاح",12,"ح",1,0],["وَإِذا أَغضَبَهُ ريُّكُمُ","فَسَقى اللَّهُ الفَضا وَالسُّمُرا",13,"ر",2,0],["واذا اغترى بك في القيامة أهله","فبمثل ما أوليتني تغري بي",14,"ب",2,0],["وَإِذا اغتَسَلتَ فَكُن لِجِسمِكَ دالِكاً","حَتّى يَعُمَّ جَميعُهُ الكَفّانِ",15,"ن",1,0],["وإذا أَغيب عن المجالس كان في","ها منطقي ومسامعي ونواظري",16,"ر",2,0]]}