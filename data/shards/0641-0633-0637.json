{"poems":[[3,"فخر الرجال سلاسل وقيود","https://www.aldiwan.net/poem149.html",""],[79,"سكن الحب فؤادي وعمر","https://www.aldiwan.net/poem36493.html","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54886","الكامل"],[242,"سل الهموم بتوشيحي وأشعاري","https://www.aldiwan.net/poem18807.html","البسيط"],[315,"ضحكت وجوه الدهر بعد عبوس","https://www.aldiwan.net/poem59511.html","الكامل"],[398,"أسد ولكن الكلاب","https://www.aldiwan.net/poem53595.html","مجزوء الكامل"],[409,"وافى نظامك وهو خير نظام","https://www.aldiwan.net/poem33424.html","الكامل"],[466,"ما طاب شيء في الزمان لسامع","https://www.aldiwan.net/poem15678.html","الكامل"],[469,"سري وعقود الأفق منثالة النظم","https://www.aldiwan.net/poem3173.html","عموديه"],[473,"ومنعم ناديته متعرضا","https://www.aldiwan.net/poem59782.html","الكامل"],[580,"امزج بريقك أو بمدح العادل","https://www.aldiwan.net/poem3022.html","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86777","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87176","الكامل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80213","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64738","الكامل"],[1264,"","https://poetry.dctabudhabi.ae/diwan/poem/105519","الكامل"],[1467,"","https://poetry.dctabudhabi.ae/diwan/poem/136782",""],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133869","الكامل"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105434","الكامل"],[2121,"","https://poetry.dctabudhabi.ae/diwan/poem/143015","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53200","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93926","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94244","الخفيف"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147344","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74149","الكامل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123916","الكامل"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61282","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133308","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111447","الكامل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127079","الكامل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97091","الخفيف"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97092","الكامل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97082","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72857","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72797","البسيط"],[4625,"","https://poetry.dctabudhabi.ae/diwan/poem/124117","الكامل"],[4639,"","https://poetry.dctabudhabi.ae/diwan/poem/124653","الكامل"],[4690,"الرجال والنساء","https://www.poetsgate.com/ViewPoem.aspx?id=131045",""],[4859,"يا ساكن البعد!","https://www.poetsgate.com/ViewPoem.aspx?id=204885",""],[5277,"شظايا الذاكرة","https://www.poetsgate.com/ViewPoem.aspx?id=185998",""],[5431,"لعل الشك تطفئه غمامه","https://www.poetsgate.com/ViewPoem.aspx?id=191095",""],[5431,"رسالة عروبية","https://www.poetsgate.com/ViewPoem.aspx?id=210257",""],[5484,"هذي الطلول فقف بنا يا ساري","https://www.poetsgate.com/ViewPoem.aspx?id=206304",""],[5565,"إني أبثّكَ سيّدي","https://www.poetsgate.com/ViewPoem.aspx?id=110221",""],[5690,"خلَعَ الزمان الآن ثوب حداحدهِ","https://www.poetsgate.com/ViewPoem.aspx?id=172149",""],[5829,"الاسراء والمعراج","https://www.poetsgate.com/ViewPoem.aspx?id=166830",""]],"verses":[["فَسَطا عَلَيَّ الدَهرُ سَطوَةَ غادِرٍ","وَالدَهرُ يَبخُلُ تارَةً وَيَجودُ",0,"د",1,0],["فسَطا الوصْلُ على الهجْرِ كمَنْ","ببَني نصْر على الدّهْرِ انْتَصَرْ",1,"ر",1,0],["فَسَطَا عَلَيْهِ مُبَادِراً","وَالْفَوْزُ أَخْلَقُ بِالمُبَادِرْ",2,"ر",1,0],["فَسَطْعَتِي تُنْشِدُ السُّلْوَانَ مَايَتُهَا","وَرَمْلُهَا يَطْلُبُ الْحُزْنَ بِأَوْتَارِي",3,"ي",1,0],["فسطا على وفري وروع مأمني","واجتث من دوح النشاط غروسي",4,"س",2,0],["فَسَطا عَلى روح الحُسَي","نِ وَأَهلِهِ جَمَّ الجماحِ",5,"ح",1,0],["فسطورها شرحت صدور مسرتي","كالنور يذهب وحشة الإِظلام",6,"م",1,0],["فسُطاكَ موتٌ للأعادي قاتِلٌ","ونَداكَ للعافين غَيْثٌ صَيِّبُ",7,"ب",1,0],["فسطوته تخشى ونعماء ترتجى","وهمه تعلو وأنمله تهمى",8,"م",2,0],["فَسَطا عَلَيَّ وَقالَ تَجبَهُني بِما","لَم يَبدُ مِن أَحَدٍ إِلَيَّ سِواكا",9,"ك",2,0],["فسطَا عليَّ بهجْوِه بل نَجْوه","وأَتى عليَّ بشتْمه المتواصل",10,"ل",1,0],["فسطوا على أعدائهم وسقوهمُ","كأسَ الردى بمدافع وحديد",11,"د",1,0],["فَسُطوره رُسِمت بصدر طُروسه","كَقلائدٍ نُظمت مِن العقيان",12,"ن",1,0],["فَسَطا القَضا حَتّى رائتُ جِبالُهُ","هَماً تَراكم قائِماً بِجَوانِبي",13,"ب",2,0],["فسُطاكَ مِنْ قَبْلِ المماتِ إِماتةٌ","ورِضاكَ مِنْ بَعْدِ المَعادِ مَعادُ",14,"د",1,0],["فسطا عليها راجعاً","في كل مقدام زحوف",15,"ف",1,0],["فسطرت أخفافها الشوق على","صحف الثرى والسير قد أملى لها",16,"ل",3,0],["فسطا عليه وقال نك","لا كان ذاك ولا كرامه",17,"م",2,0],["فسطا على تلك الجموع بنفسه","للَه شدة بأس ذاك الساطي",18,"ط",2,0],["فسطوة من حاكم","على يراعي ويدي",19,"د",2,0],["فسطاك تكفل عنك يوماً بعده","لا أعتب الدنيا ولا أتظلم",20,"م",1,0],["فَسَطَوا عَلَى أتبَاعِهِ وَجُنُودِهِ","بِالبَغيِ وَالعُدوَانِ وَالبُهتَانِ",21,"ن",1,0],["فسطوتهم في البر والبحر أصبحت","قلوب جميع الناس منها على وجل",22,"ل",1,0],["فسطور الطروس أبدت بديعا","حسنه ما أتى زمان بمثله",23,"ل",2,0],["فَسَطِّرِ الدَّمْعَ هَالاتٍ مُوَضَّأَةٍ","أَرْخَى كَلاكِلَهَا سِحْرٌ مِنَ السُّجُفِ",24,"ف",1,0],["فَسَطا علي الدَهر سَطوة ظالم","بتفرق وَتعنف وَتعسفِ",25,"ف",1,0],["فسطا عليهم مفرداً فثنت له","تلك الجموع النظرة الشزراء",26,"ا",2,0],["فَسَطا بِسَيفِ اللَهِ يَضرِبُهُم بِهِ","ضَرباً يُقَرُّ به الهُدى وَيُوطَّدُ",27,"د",1,0],["فسطا عليه الموت سطوة ضيغم","من قبل أن تجنى الثمار ويقطفا",28,"ف",2,0],["فسَطا أَياسُ على ابنش أَنثِيمِيُّنٍ","يَفَعٌ تَرعرَعَ فانبَرى لِطَرادِ",29,"د",1,0],["فسطا عليهم مثل ليث خادر","من بعد وعظ مؤلم التقريع",30,"ع",1,0],["فسطا شاحذاً من الباس عضباً","كتبت في فرنده الآجال",31,"ل",1,0],["فسطا مدير رحى الوجود يكسر","البيض الصفاح وللرماح يحطم",32,"م",1,0],["فسطا ابن أحمد بعدهم بعزائم","أردت من الأبطال كل سميدع",33,"ع",1,0],["فسطورهُ وطروسهُ في حسنها","حاكت سماء زيّنت بكواكبِ",34,"ب",1,0],["فسطاط يحيى علت مجدا سرادقهُ","ومدّ أطنابه العلياءَ للفلكِ",35,"ك",1,1],["فسطوا على الجمع الكثيف كما هوت","شهب على جمع الغوات رجوم",36,"م",1,0],["فسطا عليهم كالعفرني مفردا","وأبادهم وهم الرمال عدادا",37,"د",2,0],["فسطورٌ تَذْكُرُ أزواجًا","لا آخرَ فيها أوْ أوَّلْ",38,"ل",1,0],["فسطوةُ الحبِّ لا تحنوْ على أحدٍ","إذا غزتهُ وجادَ البينُ بالمددِ!",39,"د",1,0],["فسطري من دمي تاريخ محنتنا","إن خاصمت سفرك الأقلامُ والكتبُ",40,"ب",1,0],["فسطوته على الأحباب وحشٌ","وساديٌ يمدُ لنا ظلامه",41,"م",2,0],["فسطوعي مجرّة من ضياء","وخصومي أشباه جُرْمٍ عجائز",42,"ز",1,0],["فسطت على الباغين أية سطوة","موروثة من حيدر الكرار",43,"ر",1,0],["فسطا عليّ بجورِه","أكذا الكريمُ إذا قدَر",44,"ر",1,0],["فسطا عليهم بأسهُ فأعادهم","كلاّ غدا ينقاد في أصفادهِ",45,"د",2,0],["38. فسطاطها في الغوطتين فعجلوا","نقفُ خطى العدنان يا نعم الأثر",46,"ر",1,0]]}