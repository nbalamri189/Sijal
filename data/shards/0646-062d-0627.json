{"poems":[[55,"أحظى الملوك من الأيام والدول","https://www.aldiwan.net/poem29908.html","البسيط"],[55,"جاء بها قالصة عن ساق","https://www.aldiwan.net/poem29930.html","الرجز"],[55,"تزود من الماء النقاخ فلن ترى","https://www.aldiwan.net/poem30517.html","الطويل"],[65,"أثرها فلا ماء أصابت ولا عشبا","https://www.aldiwan.net/poem46174.html","الطويل"],[3,"نحا فارس الشهباء والخيل جنح","https://www.aldiwan.net/poem92.html",""],[79,"تلافيت نصر الدين إذ كاد يتلف","https://www.aldiwan.net/poem35977.html","الطويل"],[9,"ألا قل لتياك ما بالها","https://www.aldiwan.net/poem21973.html","المتقارب"],[37,"سقى دمنتين لم نجد لهما مثلا","https://www.aldiwan.net/poem39120.html","الطويل"],[10,"قذى بعينك أم بالعين عوار","https://www.aldiwan.net/poem21079.html","البسيط"],[95,"نهاية الفخر لي في هذا الكلم","https://www.aldiwan.net/poem11309.html","البسيط"],[95,"سلام عليكم والفواد المسلم","https://www.aldiwan.net/poem11363.html","الطويل"],[32,"خليلي عوجا عوجة","https://www.aldiwan.net/poem29570.html","الطويل"],[90,"سقتنا المعالي من سلافتها صرفا","https://www.aldiwan.net/poem44835.html","الطويل"],[90,"بني وطني ماذا أؤمل بعدما","https://www.aldiwan.net/poem44979.html","الطويل"],[90,"بدت كالشمس يحضنها الغروب","https://www.aldiwan.net/poem45008.html","الوافر"],[90,"أجدك يا كواكب لا ترينا","https://www.aldiwan.net/poem45071.html","الوافر"],[23,"ثوى بمكة بضع عشرة حجة","https://www.aldiwan.net/poem21251.html","الطويل"],[74,"أذكى سنا البرق في أحشائه لهبا","https://www.aldiwan.net/poem18234.html","البسيط"],[53,"سقيتن يا منزلات الهوى","https://www.aldiwan.net/poem8117.html","المتقارب"],[40,"صدقت معية نفسه فترحلا","https://www.aldiwan.net/poem7809.html","الكامل"],[64,"نحاسنا تغلنا وزئبقنا","https://www.aldiwan.net/poem52222.html","المنسرح"],[82,"نعيمك أن تزف لك العقار","https://www.aldiwan.net/poem31437.html","الوافر"],[22,"أفيما خلا من سالف العيش تدكر","https://www.aldiwan.net/poem21656.html","الطويل"],[77,"أنظلم أن شمنا بوارق لمحا","https://www.aldiwan.net/poem69094.html","الطويل"],[107,"","https://poetry.dctabudhabi.ae/diwan/poem/49521","الوافر"],[35,"","https://poetry.dctabudhabi.ae/diwan/poem/10689","الطويل"],[22,"افي ما خلا من سالف العيش تدَّكّرْ","https://www.poetsgate.com/ViewPoem.aspx?id=19747",""],[37,"سقى دمنتينِ لم نجدْ لهما مثلا","https://www.poetsgate.com/ViewPoem.aspx?id=22066",""],[119,"عليكم كلما اختبط الظلام","https://www.aldiwan.net/poem40491.html","عموديه"],[119,"بجاه رسول الله نعطي المآربا","https://www.aldiwan.net/poem41258.html","عموديه"],[130,"للحب دين وللأشواق باقينا","https://www.aldiwan.net/poem794.html",""],[147,"لا فات ملكك ما أعيا به الطلب","https://www.aldiwan.net/poem11730.html","البسيط"],[147,"أرى سفها ولو جاء العذول","https://www.aldiwan.net/poem11804.html","الوافر"],[164,"كلات ودين الله أفضل ما تكلا","https://www.aldiwan.net/poem59159.html","الطويل"],[189,"نحا البين في تشتيت شملي مقاصدا","https://www.aldiwan.net/poem14496.html","الطويل"],[203,"زمان عيشنا فيه اضطرار","https://www.aldiwan.net/poem45408.html","الوافر"],[254,"ألا بان الخليط ولم يزاروا","https://www.aldiwan.net/poem2119.html","الوافر"],[280,"كأن كتائب الباغين حزن","https://www.aldiwan.net/poem25543.html","الوافر"],[342,"إذا ما جد واستذكى عليها","https://www.aldiwan.net/poem45312.html","الوافر"],[445,"أخفضا نوت فينا النوى ولعلها","https://www.aldiwan.net/poem34863.html","الطويل"],[457,"خطرنا بحكم اللهو للسفح خطرة","https://www.aldiwan.net/poem13693.html","الطويل"],[458,"عرفناك يا يوم عيد الحياة","https://www.aldiwan.net/poem61253.html","المتقارب"],[458,"لماذا أعزي بل لماذا أهنىء","https://www.aldiwan.net/poem61308.html","الطويل"],[463,"راش نبالا في جفنه ورمى","https://www.aldiwan.net/poem55902.html","المنسرح"],[466,"ومسنت حي ينكر الإنس آله","https://www.aldiwan.net/poem16074.html","الطويل"],[466,"تبلج وجه الدهر بعد قطوبه","https://www.aldiwan.net/poem16344.html","الطويل"],[484,"أدرها من سلافك يا نديم","https://www.aldiwan.net/poem37037.html","الوافر"],[580,"نحافة الغصن غيظ من تثنيكا","https://www.aldiwan.net/poem3044.html","البسيط"],[668,"","https://poetry.dctabudhabi.ae/diwan/poem/139020",""],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96630","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49956","الطويل"],[1553,"","https://poetry.dctabudhabi.ae/diwan/poem/144594","الهزج"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87919","الطويل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128074","الطويل"],[1955,"","https://poetry.dctabudhabi.ae/diwan/poem/45407","البسيط"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89561","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109742","الطويل"],[2346,"","https://poetry.dctabudhabi.ae/diwan/poem/18011","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76140","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93903","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202725",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203486","الوافر"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132608","السريع"],[3243,"","https://poetry.dctabudhabi.ae/diwan/poem/140230",""],[3307,"","https://poetry.dctabudhabi.ae/diwan/poem/145537","الطويل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112306","الطويل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/53024","الوافر"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86259","الوافر"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129506","الوافر"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109925","الطويل"],[3654,"","https://poetry.dctabudhabi.ae/diwan/poem/27099","البسيط"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128885","البسيط"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86527","الطويل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86515","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114417","الطويل"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88567","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119639","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123504","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4578,"تجلَّت فيها شمس النهار على رُمحٍ","https://www.poetsgate.com/ViewPoem.aspx?id=49377",""],[4956,"سلام على العلم","https://www.poetsgate.com/ViewPoem.aspx?id=1394",""],[585,"نح الدنان ودعني أيها الساقي","https://www.poetsgate.com/ViewPoem.aspx?id=161929",""],[5145,"هو الدهر لا عتب عليه ولا عتبى","https://www.poetsgate.com/ViewPoem.aspx?id=108104",""],[592,"تجانف هذا المارق الماذق الأشقى","https://www.poetsgate.com/ViewPoem.aspx?id=128797",""],[5401,"بذر المحبه","https://www.poetsgate.com/ViewPoem.aspx?id=85369",""],[5450,"كرسي","https://www.poetsgate.com/ViewPoem.aspx?id=50289",""],[5561,"غضب القدس","https://www.poetsgate.com/ViewPoem.aspx?id=194360",""],[5616,"زناد","https://www.poetsgate.com/ViewPoem.aspx?id=203483",""],[5732,"الملحمة الزايدية","https://www.poetsgate.com/ViewPoem.aspx?id=177865",""],[5784,"بغير الوصل لا أجد الأمان....","https://www.poetsgate.com/ViewPoem.aspx?id=190725",""],[5848,"نسولف !!","https://www.poetsgate.com/ViewPoem.aspx?id=49002",""],[6082,"علام الحزن؟","https://www.poetsgate.com/ViewPoem.aspx?id=58987",""],[6131,"الكونُ المُسَافرُ للفَراغْ","https://www.poetsgate.com/ViewPoem.aspx?id=189269",""],[313,"صبر ينفذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66511&r=&rc=33",""],[5724,"ردد من الروح ذكرى سيد البشر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55156&r=&rc=23",""],[6213,"أفي السلم نحيا!!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76302&r=&rc=50",""],[2696,"ألَمَّ خَيَالٌ مِنْ أُمَيْمَة َ مَوْهِناً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27417&r=&rc=21",""],[5190,"لا زلتُ أشكو لوعةَ الغُرباءِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78295&r=&rc=8",""]],"verses":[["نَحا لِنَحوِكَ لا يَلوي عَلى أَحَدٍ","إِنَّ المُقيمَ عَنِ النُزّاعِ في شَغَلِ",0,"ل",1,0],["نَحّارَةٌ لِلإِبِلِ المَناقي","فُواقُها أَدنى مِنَ الفُواقِ",1,"ق",1,0],["نُحاسِنُ أَقمارَ الدُجى بِوُجوهِهِم","فَنَبهَرُها نوراً وَنَغلِبُها سَعدا",2,"د",2,0],["نُحاذِرُ منْ حَيَّيْ سُلَيْمٍ وعامِرٍ","أَناسِيَّ لا يَرْضَوْنَ غيرَ الظُّبا صَحْبا",3,"ب",2,0],["نَحا فارِسُ الشَهباءِ وَالخَيلُ جُنَّحٌ","عَلى فارِسٍ بَينَ الأَسِنَّةِ مُقصَدِ",4,"د",1,1],["نَحا نحْوَ أرْباب العُلَى ففَعالُهُمْ","على السَّنَن المَرْضيِّ والعدْلِ يعطِفُ",5,"ف",1,0],["نَحائِصَ شَتّى عَلى عَينِهِ","حَلائِلَ لَم يُؤذِهِ قالُها",6,"ل",3,0],["نُحارِبُ أَقواماً فَنَسبي نِساءَهُم","وَنُصفِدُهُم أَسراً وَنوجِعُهُم قَتلا",7,"ل",2,0],["نَحّارُ راغِيَةٍ مِلجاءُ طاغِيَةٍ","فَكّاكُ عانِيَةٍ لِلعَظمِ جَبّارُ",8,"ر",1,0],["نحَارُ فِيهِ فَمَا تَدْرِي تَفَردَهُ","أَبِالقَوَافِي وَإِنْ راعَتْ أَمِ الْهِمَمُ",9,"م",1,0],["نُحَارِبُ هَذَا الْغَرْبَ فِكْراً وَنِيَّةً","وَيَضْحَكُ منَّا وَالْحَصَافَةُ تَلْطِمُ",10,"م",1,0],["نَحاها لِثَأجِ نَحوَةً ثُمَّ إِنَّهُ","تَوَخّى بِها العَينَينِ عَينَي مُتالِعِ",11,"ع",1,0],["نَحا أن يَتِمّ الدَست فيها لحزبه","علينا وظن الأمر فيما نحا يَخْفى",12,"ف",2,0],["نحاول عزاً بابتذال نفوسنا","فنشري خسيساً بالثمين المقدّس",13,"س",1,0],["نحا فيما أتاه طريق علم","نحاها شيخه الحبر الأريب",14,"ب",1,0],["نحاول منه إعراب المعاني","بتأويل فنرجع مُعْجِمِينا",15,"ن",2,0],["نُحارِبُ مَن عادى مِنَ الناسِ كُلَّهِم","جَمعاً وَإِن كانَ الحَبيبُ المُصافِيا",16,"ي",2,0],["نحا الهوَى فكرَهُ العاني فصيَّرهُ","بعامل القدِّ لا ينفكُّ منتصبا",17,"ب",2,0],["نحافَ الجسُومِ خفافَ الحُلو","مِ صغارَ الرؤوسِ عظامَ اللِّحى",18,"ا",1,0],["نُحُّ الحَناجِرِ ما يَكادُ يُقيمُها","تَدَعُ القَعودَ مِنَ التَصَرُّفِ أَجزَلا",19,"ل",2,0],["نحاسنا تغلنا وزئبقنا","ما طار في طبخنا عن الثُّفلِ",20,"ل",1,1],["نحاسٌ ينبري منه شُواظٌ","لأرواحِ العلوجِ بِه بَوَارُ",21,"ر",1,0],["نُحامي وَراءَ السَبيِ مِنكُم كَما حَمَت","أُسودٌ ضَوارٍ حَولَ أَشبالِها هُصُر",22,"ر",1,0],["نحاهم به أمضى من السيف وَقعُه","وأجزَلَ من أركان رَضوى وأرجحا",23,"ح",2,0],["نُحارِبُ مَن يُحارِبُنا ونأبَى","لأَنْفُسِنا المَذَلَّةَ والصَّغارا",24,"ر",2,0],["نُحاوِبُ وُرقاً قَد أَصَخنَ لِصَوتِها","فَكُلٌّ لِكُلٍّ مُسعِدٌ وَمُجيبُ",25,"ب",1,0],["نُحامي ورَاءَ السَّبْيِ مِنْكُمْ كما حَمَتْ","أُسُودٌ ضَوارِي حَوْلَ أشبالها عُقُرْ",26,"ر",1,0],["نحاربُ أقوماً فنسبي نساءَهمْ","ونُصفدُهمْ أسراً ونوجعُهمْ قتلا",27,"ل",2,0],["نحاضركم مع الارواح منا","ولولا ذاك ساء بنا المقام",28,"م",1,0],["نحاضره في الحادثات اذا عدى","عدو فتبدي الخارقات العجائبا",29,"ب",2,0],["نحاول الصبر عنكم كي نلوذ به","والصبر في الحب صعب لا يلبينا",30,"ن",2,0],["نَحا جَنابَكَ وَالأَشواقُ تَجذُبُهُ","فَدَأبُهُ الشَدُّ وَالتَقريبُ وَالخَبَبُ",31,"ب",1,0],["نَحا شَرَفُ المُلوكِ بِلا دَليلٍ","طَرائِقَ لَيسَ يَعرِفُها دَليلُ",32,"ل",1,0],["نحامي بنص الكتب عنه ومالنا","سوى سيفك الماضي يضر فلا فلاّ",33,"ل",2,0],["نَحا البَيْنُ في تشتيتِ شَمْلي مَقاصِدا","فسَدَّد رَمْيا نافِذا ليس نافِذا",34,"ذ",2,1],["نحاذرهُ ومن يخشَ الرزايا","فاصعبُ من رزاياهُ الحذارُ",35,"ر",1,0],["نُحاذِرُ أَن تَبينَ بَنو عُقَيلٍ","بِجارَتِنا فَقَد حُقَّ الحِذارُ",36,"ر",1,0],["نَحا ظُلَمَ الضّلالَة مِنْهُ بَرْقٌ","أحَدَّتْهُ القَبَائِل مِن هلالِ",37,"ل",1,0],["نَحاها قارِباً وَأَرَنَّ فيها","لِيورِدَها شَريَعةَ أَو سَرارا",38,"ر",2,0],["نَحاها مُقِيلُ العاثِرِينَ بِعَثْرَةٍ","لَعاً لِيَ مِنْها والنَّوى لا لَعاً لَهَا",39,"ل",3,0],["نحاول فيه الأنس من رونق الصبا","ونضرب عن راجي الهموم به صفحا",40,"ح",2,0],["نحاسب أنفسنا بينما","يداعبنا المقبل الأمثل",41,"ل",1,0],["نحار بتكييف له ثم حيرتي","تجن فلا أدري بما اليوم أبدأ",42,"ا",1,0],["نحّاك قلبٌ لا يُحسِن الصفحَ عن","جُرمٍ ووجهٌ لا يعرف الجُرُما",43,"م",2,0],["نحا عضُدَ الدين الجواد فَانْجحتْ","مَباغيهِ والآمالُ عند مُحمَّدِ",44,"د",1,0],["نحا سعيُه في المجدِ منْحى جُدوده","وأرْبى عليهم نجْدَةً وتكَرُّما",45,"م",2,0],["نحا ليراعه منحى شريفا","مشى فيه كما يمشي الحكيم",46,"م",1,0],["نحافَةُ الغصنِ غيظٌ من تَثَنِّيكا","وجملةُ الهجْرِ جُزْءٌ من تَجَنِّيكا",47,"ك",2,1],["نحاك بهاء الدين ما لا يرده","إذا ما أتى تدبير زيدٍ ولا عمرو",48,"ر",2,0],["نُحاول توديعاً ونخشى مراقباً","كظامٍ يرى نهلاً ولم يستطع وِردا",49,"د",2,0],["نُحاول إحسانَ الملوك وقد مَضوا","ونرجو غنى بَالشعر والشّعرُ كاسدُ",50,"د",1,0],["نحا الأظمأُ للرِّدفِ ال","لذي برّح 