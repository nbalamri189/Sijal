{"poems":[[95,"يا عبرة الدهر جاوزت المدى فينا","https://www.aldiwan.net/poem11172.html","البسيط"],[87,"لام فيكم عذوله وأطالا","https://www.aldiwan.net/poem63024.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54870","الكامل"],[100,"الدول العظمى","https://www.poetsgate.com/ViewPoem.aspx?id=55340",""],[124,"يا حسن واحسرتا على غرر","https://www.aldiwan.net/poem49263.html","المنسرح"],[189,"قالوا محا الجدري بهجته","https://www.aldiwan.net/poem14119.html","أحذ الكامل"],[189,"والله لو صح عندي أن هجركم","https://www.aldiwan.net/poem14644.html","البسيط"],[216,"إن الليالي والأيام أطراق","https://www.aldiwan.net/poem37856.html","البسيط"],[216,"سر قاصدا سرعا يا حادي النجب","https://www.aldiwan.net/poem37918.html","البسيط"],[275,"عوضت منك من الإيناس إيحاشا","https://www.aldiwan.net/poem35052.html","البسيط"],[310,"خطب عيون الدين منه ثجوجه","https://www.aldiwan.net/poem56586.html","الكامل"],[382,"نار تثير على الضلوع وطيسا","https://www.aldiwan.net/poem59384.html","الكامل"],[520,"لا تحسبن أني هجو","https://www.aldiwan.net/poem12194.html","مجزوء الكامل"],[563,"هي قامت بنفسها لذويها","https://www.aldiwan.net/poem33637.html","الخفيف"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96981","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86799","الكامل"],[357,"","https://poetry.dctabudhabi.ae/diwan/poem/142216","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70789","الكامل"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203731","المجتث"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80193","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56276","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64766","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48962","الكامل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114798","الكامل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123170","الكامل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123171","البسيط"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108491","الكامل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104964","البسيط"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130799",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201753","السريع"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65142","الكامل"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101244","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133214","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111408","الخفيف"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93776","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94487","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73171","البسيط"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/141095","المنسرح"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123852","السريع"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204296","الكامل"],[4737,"باب النجار مخلع","https://www.poetsgate.com/ViewPoem.aspx?id=212576",""],[4837,"قسم","https://www.poetsgate.com/ViewPoem.aspx?id=22347",""],[4858,"رثاء الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=157954",""],[5007,"صلصة الصاد","https://www.poetsgate.com/ViewPoem.aspx?id=180745",""],[5183,"الشِّْعرَى","https://www.poetsgate.com/ViewPoem.aspx?id=186427",""],[5185,"قرطبة قلعة العلم","https://www.poetsgate.com/ViewPoem.aspx?id=203224",""],[5431,"صبرا أُخيَّ","https://www.poetsgate.com/ViewPoem.aspx?id=183277",""],[5431,"قالت لي القدس...","https://www.poetsgate.com/ViewPoem.aspx?id=202677",""],[5431,"حشد الرعاع ...","https://www.poetsgate.com/ViewPoem.aspx?id=202871",""],[5561,"لملمْ عصورَكَ ...","https://www.poetsgate.com/ViewPoem.aspx?id=197720",""],[5628,"البحث عن بثينة","https://www.poetsgate.com/ViewPoem.aspx?id=191332",""],[5667,"البحر","https://www.poetsgate.com/ViewPoem.aspx?id=214837",""],[5813,"باب الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=176828",""],[5854,"فصحى اللغات","https://www.poetsgate.com/ViewPoem.aspx?id=208608",""],[5956,"طباعي لم تُرض طباع أبي رحمه الله","https://www.poetsgate.com/ViewPoem.aspx?id=192148",""],[5956,"شاعر يدافع عن صديقه","https://www.poetsgate.com/ViewPoem.aspx?id=192463",""],[5871,"طَالَ البعَاد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74809&r=&rc=189",""]],"verses":[["لَكِنَّ صَرْفاً مِنَ المَقْدُورِ غَالَبَهُمْ","فَمَا نَجَا مِنْهُمُ غَيْرُ الأَقَلِّينَا",0,"ن",2,0],["لَكَ نُصحي وَما عَلَيكَ جِدالي","آفَةُ النُصحِ أَن يَكونَ جِدالا",1,"ل",2,0],["لَكِنْ صَبَرْتَ لِحُكْمِ رَبِّكَ مُسْلِماً","وَعرَفْتَ أَنَّ الْفَائِزَ الصَّبَّارُ",2,"ر",1,0],["لك نصف الناس لو تنهضهم","كانت الأملاك بعض الخول",3,"ل",1,0],["لكن صدر الفتى يجيش فما","يعد كالشعر غير معتسر",4,"ر",1,0],["لكنْ صفَتْ صهباءُ وَجْنتِه","لونا فجَمَّلَ صَفْوَها الحبب",5,"ب",1,0],["لكنْ صددتمُ بلا ذنبٍ وهل سببٌ","للحَيْن أوجب هجراني سوى المَلل",6,"ل",1,0],["لكنَّ صبراً فما في الموتِ من عَتَب","نذوق ما أنبياءُ اللهِ قد ذاقوا",7,"ق",3,0],["لكنَّ صبراً عسى الرحمنُ يَجْمَعُنا","يومَ المعادِ بأعلى السَّكنْ والرُّتبِ",8,"ب",1,0],["لكنَّ صدقَ اختباري فيه زَهَّدني","وكلُّ سهمٍ من العينينِ قد طاشا",9,"ش",2,0],["لكن صحيحُ سميّه كالروح في","أنفاسهِ ما إِن يملُّ نتيجه",10,"ج",2,0],["لكن صروف الدهر قد صيَّرنَني","وبنوه شكَّاء الأذى والبوسا",11,"س",2,0],["لكن صفعت بك الذي","نفثاته يعرفن منكا",12,"ك",2,0],["لك نصحي بذلت إن كنت ممن","وفقته أن يقبل النصح فيها",13,"ي",3,0],["لكن صمت تأسياً","بمقر شقشقة الهدير",14,"ر",1,0],["لَكن صَبَوت لِمعشر","لَم يَعرفوا يا بَدر ودّك",15,"ك",1,0],["لكن صلاح الدين مات وماله","فينا وريث حمية وإماره",16,"ر",2,0],["لكن صغيرَك عرِّفَنَّ بما تشا","تلق النجاحَ بعون رب الناسِ",17,"س",1,0],["لكنّ صوتك يؤذي","فابقي ونحيه عنا !",18,"ن",2,0],["لَكن صَنائِعنا أَسرارَها عَظمت","فَنجتني الآن مِنها كُل مُرتَغِبِ",19,"ب",1,0],["لكن صروف الدهر ما برحت ترا","شق عبدكم بالأسهم المسنونَهْ",20,"ن",2,0],["لكنْ صَبَرْتُ على أَليمِ كَلامِهَا","صَبر النَّديمِ على الشَّرابِ وإِنْ حَذا",21,"ذ",2,0],["لكنَّ صدقَكَ للخليفةِ","حربةٌ تُردي الهَلاك",22,"ك",1,0],["لكن صفَت منكَ الخلائقُ واعتلَت","عن عِلَّةٍ تُبدِي العيون تَنَصُّلا",23,"ل",2,0],["لكن صغيراً كنت ما عمري سوى","عشرين عاماً أي وبعض شهور",24,"ر",1,0],["لكنّ صُفرة هذا من سلامته","وصفرتي من ضنى وجد وتفليس",25,"س",1,0],["لكن صاحبنا سعيداً قد رأى","ذئباً يخاتله فهاج به الحنق",26,"ق",1,0],["لكن صبرت لأمر الله محتسباً","إياه والعيش ما بين العدا نكد",27,"د",1,0],["لكن صفات الطاهرات ملكنني","بيد الخشوع ومستقر عظات",28,"ت",1,0],["لكن صغرتم ثم أعلنتمُ","حرب العصابات من الرعب",29,"ب",1,0],["لكن صُرفت لضيق ذرع حواسد","قد أسمعت بنميمة شنعاء",30,"ا",2,0],["لكن صرف القضا أمضى مقدره","وعاق مسعاه ما يقضي محتمه",31,"م",2,0],["لكن صفاتك يا مكمّل قصّرت","عنها صروف الأبجدية والهجا",32,"ج",2,0],["لكِ نُصحي مَهما تَعِي حِكمَةً أَن","تَتَّقِيهِ وأَن تُلينِي المَقالا",33,"ل",2,0],["لكن صُروف وَأَيام لَها دُول","دارَت عَلَيك كَما دارَت عَلى الأُمم",34,"م",1,0],["لكنَّ صَبري مات من طول النوى","فلكِ البقاء ولا تقولي ما جَرى",35,"ر",2,0],["لكن صدَدتِ وما قدَّمتِ صالحةً","ومن شروطِ الهوى جَورٌ وإِنصافُ",36,"ف",1,0],["لكن صديق حمدت خلته","لدن شربنا كأس الصفاء معا",37,"ع",2,0],["لكن صروف الدهر ان عاندت","هيهات ان يرتد منها جماح",38,"ح",1,0],["لكن صفرت فلم أجد إلا التي","قد آن لي أن أستطيل ذماءها",39,"ا",3,0],["لكنْ صلصلتي ينقصُها","كي للملأِ الأعلى تُرفَعْ",40,"ع",1,0],["لكنّ صحبي يومَ شدَّت دُنيَتي تركوا عليّاً مُتعباً ومُهاناً","والله إنّي سوف أصبح سيّداً رجلاً عزيزاً سيّداً ومُطاعاً",41,"ا",1,0],["لكنّ صرحَ الحقِّ يعلو شامخا","بيدِ الشّهيدِ وفتيةٍ صُلَحاءَ",42,"ا",2,0],["لكنّ صِدْقِي أصاب اليوم صَدْمَتهُ","لمّا ترصّد والإذلال مضمونُ",43,"ن",1,0],["لكن صاحبهم يغشى الكريهة في","إقدام من لم يخف ممن يصادمه",44,"م",2,0],["لكن صخراً- ليت صخراً كان سه","لا يرقب الخطواتِ أن تتهربا",45,"ب",2,0],["لكنَّ صبحا قد أهلَّ بنوره","كالطير يشدو ضاحكا ومغردا",46,"د",2,0],["لكنّ صبريَ مشكاةٌ زجاجته","من هيبة الله أنوارٌ وترفيعُ",47,"ع",1,0],["لكنّ صوت الذعر جاء","مجلجلا دون ارتجاع!",48,"ع",1,0],["لكنَّ صمتَكَ غُدرانٌ موارِدُها","وَهْمُ السرابِ بوجهِ الأرضِ يقتتِلُ",49,"ل",1,0],["لكنّ صوتا ً جاء َ مُعترضا ً","مِنْ داخلي ..... ما هكذا الأمرُ",50,"ر",1,0],["لكنَّ صبرَكَ ياأدنى مرافئِنا","وخيرَ ما نرتجي مرٌّ بهِ كِبَرُ",51,"ر",1,0],["لكن صوابي مابرى من صوابي","يبريه وصلك ياكحل موق الأهداب",52,"ب",1,0],["لكن صرحك في الأفاق قلعته","طود يطاول في عليائه زحلا",53,"ل",2,0],["لكنَّ صفحي كما تدْريه يصحبني","ويصبِحُ البدرُ بعدَ الغيم منبلجا",54,"ج",2,0],["لكنَّ صَفْحَ الشهم عنك مؤكَّدٌ","فهو الأصيل العطف وهو الأطيبُ",55,"ب",1,0],["لَكِنَّ صِدْقي سَيَبْقَى العُمْرَ يَغْفِرُ لِي","بَاقٍ أُحِبُّ إلَى أَنْ يَفرغَ الأجَلُ",56,"ل",1,0]]}