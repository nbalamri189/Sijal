,""],[4764,"حَضرة معاليك","https://www.poetsgate.com/ViewPoem.aspx?id=29533",""],[4767,"فداك الكون","https://www.poetsgate.com/ViewPoem.aspx?id=178772",""],[4767,"تاج الشجاعة","https://www.poetsgate.com/ViewPoem.aspx?id=179986",""],[4767,"الوداع المر","https://www.poetsgate.com/ViewPoem.aspx?id=212990",""],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[4578,"من أطلع الريحان في الجلنار","https://www.poetsgate.com/ViewPoem.aspx?id=49426",""],[4978,"تشطير عين سارة لغالية أبو ستة","https://www.poetsgate.com/ViewPoem.aspx?id=177201",""],[4983,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=21771",""],[4992,"عراق الصابرين","https://www.poetsgate.com/ViewPoem.aspx?id=25073",""],[4992,"الدم الخالد","https://www.poetsgate.com/ViewPoem.aspx?id=6316",""],[4119,"هبوا أن حاجبه حاجب","https://www.poetsgate.com/ViewPoem.aspx?id=16225",""],[4119,"تنوء بها يوم الخصام حلومها","https://www.poetsgate.com/ViewPoem.aspx?id=16207",""],[5038,"حبيس الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=197668",""],[5121,"حنين ودموع","https://www.poetsgate.com/ViewPoem.aspx?id=33628",""],[5136,"عاد عليك العيد يا أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=121553",""],[5183,"الحزن العميق","https://www.poetsgate.com/ViewPoem.aspx?id=180262",""],[5183,"عواطف الإخاء","https://www.poetsgate.com/ViewPoem.aspx?id=180212",""],[5199,"لاتقول الناس بالانفس سوى","https://www.poetsgate.com/ViewPoem.aspx?id=146249",""],[5268,"ماسَت يداكِ","https://www.poetsgate.com/ViewPoem.aspx?id=207007",""],[5281,"تنومة الزهراء","https://www.poetsgate.com/ViewPoem.aspx?id=200094",""],[308,"تنوح حمامات اللوى فَأُجِيب","https://www.poetsgate.com/ViewPoem.aspx?id=189362",""],[5302,"ملحمة الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=200060",""],[5320,"العامل","https://www.poetsgate.com/ViewPoem.aspx?id=40903",""],[5370,"عقارب الساعة","https://www.poetsgate.com/ViewPoem.aspx?id=85520",""],[5376,"يا قِبلةَ الشوقِ هاج القلبَ وجدانُ","https://www.poetsgate.com/ViewPoem.aspx?id=191873",""],[5409,"تحولت بعدك الأرياف والمدن","https://www.poetsgate.com/ViewPoem.aspx?id=155486",""],[5447,"خطوة","https://www.poetsgate.com/ViewPoem.aspx?id=208320",""],[5464,"قانا","https://www.poetsgate.com/ViewPoem.aspx?id=8311",""],[5582,"حَلِيفُ جَوَىً ما ناحَ يَوْماً حَمامُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=187264",""],[482,"ما لم تزوروا فالمامُ الكرى زورُ","https://www.poetsgate.com/ViewPoem.aspx?id=111256",""],[5751,"طيلسان الريح","https://www.poetsgate.com/ViewPoem.aspx?id=214790",""],[5879,"رصاص الحي ..","https://www.poetsgate.com/ViewPoem.aspx?id=215493",""],[5956,"هنالك في عمق السعود كواكب","https://www.poetsgate.com/ViewPoem.aspx?id=193362",""],[5956,"أستاذتي","https://www.poetsgate.com/ViewPoem.aspx?id=194456",""],[5956,"تنوح المزامير فور نواك","https://www.poetsgate.com/ViewPoem.aspx?id=199932",""],[5970,"بني مصر هبوا وأجهدوا ما استطعتمو","https://www.poetsgate.com/ViewPoem.aspx?id=130665",""],[5979,"حمى الله من كيد الزمان خلائقاً","https://www.poetsgate.com/ViewPoem.aspx?id=181360",""],[5986,"أيا عترة المختار والسادة الطهر","https://www.poetsgate.com/ViewPoem.aspx?id=162956",""],[6127,"طلائع الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=198788",""],[6318,"حب ووفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66154&r=&rc=4",""],[572,"أثابَ فأعداني إلى ظُلمِهِ الدَّهْرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9330&r=&rc=187",""]],"verses":[["تَنوشُ أَنابيبُ الرِماحِ وَراءَهُم","كَأُسدٍ تُماشيها جَوانِبُ غيلِ",0,"ل",1,0],["تَنوسُ رُكبانُها نَوسَ القِراطِ إِذا","مالَت مِنَ السَهَرِ الأَجيادُ وَالعُذُرُ",1,"ر",1,0],["تَنوحُ وتَبْكي فوقَ آفْنانِ أيْكةٍ","فِداهُنَّ منْ أرضِ العِراقِ نَخيلها",2,"ل",3,0],["تنَوَّرْ سَناها منْ بَعيدٍ ولا تُرَعْ","فليس على مَنْ آنَسَ النّارَ منْ باسِ",3,"س",1,0],["تَنوطُ التَميمَ وَتَأبى الغَبو","قَ مِن سِنَةِ النَومِ إِلّا نَهارا",4,"ر",2,0],["تَنوحُ عَلى القَرينِ وَأَينَ مِنها","وَقَد غالَ الرَدى ذاكَ القَرينُ",5,"ن",1,0],["تَنَوَّرتُها مِن أَذرُعاتٍ وَأَهلُه","بِيَثرِبَ أَدنى دارَها نَظَرٌ عالِ",6,"ل",1,0],["تَنوطُ العِتاقَ الحِميَرِيَّةَ صُحبَتي","بِأَعيَسَ نَهّاضٍ عَلى الأَينِ مِرجَمِ",7,"م",1,0],["تَنُوحُ قَمَارِيُّ الجِنَانِ حِيَالَهَا","وَقَبْلاً تَغَنَّتْ فِي ذَرَاهَا الحَمَائِمُ",8,"م",1,0],["تُنَوِّطُ مِصرُ بِكَ المُخزِياتِ","وَتَبصُقُ في وَجهِكَ المَوصِلُ",9,"ل",1,0],["تَنوءُ بِأُخراها فَلأَياً قِيامُها","وَتَمشي الهَوينا مِن قَريبٍ فَتَبهُرُ",10,"ر",1,0],["تنوء به الأقياد أن رام نهضةً","فيشكو الأذى والدمع من عينه يجري",11,"ر",2,0],["تَنوحُ بَناتُ أَبي مالِكٍ","بِبوقِ النَصارى وَمِزمارِها",12,"ر",3,0],["تَنوطونَ العِلابَ وَلَم تَعُدّوا","لِيَومِ الرَوعِ صَلصَلَةَ اللِجامِ",13,"م",1,0],["تنوّع القولُ فقيل أربعٌ","حروفها وقيل حرفٌ واحد",14,"د",1,0],["تَنوس منه وذَحاتُ استِه","كأنها أفئدة الجُزر",15,"ر",1,0],["تنوَّقا بوركتما تَنطَّسا","وبالرِّفاءِ والبنينَ أعْرِسا",16,"س",2,0],["تنوبُ أباه النائباتُ فلا يني","يُكانفُهُ في أمرهِ ويُحاوط",17,"ط",1,0],["تَنوشُ بِرِجلَيها وَقَد بَلَّ ريشَها","رَشاشٌ كَغِسلِ الوَفرَةِ المُتَصَبِّبِ",18,"ب",1,0],["تَنُوءُ به الآمالُ والجَدُّ قاعِدٌ","وتُسْهِرُه العلياءُ والحَظُّ راقدُ",19,"د",1,0],["تَنوطُ آمالُنا مِنهُ إِلى مَلِكٍ","مُرَدَّدٍ في صَريحِ المَجدِ مَنسوبِ",20,"ب",1,0],["تَنوحُ لِفَقدِكَ الجُردُ المَذاكي","وَتَبكيكَ الصَوارِمُ وَالعَوالي",21,"ل",2,0],["تنوءُ بهم في ذُبّلِ الخطِّ أنْجُمٌ","سحائبها نَقْعٌ وأمطارها دمُ",22,"م",1,0],["تنوءُ به غِرّاً حفيظةُ عَزْمِهِ","وترجَحُ أسبابُ الأناةِ بِهِ كَهلا",23,"ل",2,0],["تَنوبُ منابَ الشمسِ بعد غروبها","إذا بزغت كالشمس في رأسِ مَطلَعِ",24,"ع",1,0],["تُنوعِتنَ حَتّى عاوَدَ القَلبَ سُقمُهُ","وَحَتّى تَذَكَّرتُ الحَديثَ المُوَدَّعا",25,"ع",2,0],["تَنوبُ مورِقَةً عَن عِذارٍ","وَتَضحَكُ زاهِرَةً عَن شَنَب",26,"ب",1,0],["تَنوحُ لِيَ الوَرقاءُ وَهيَ خَلِيَّةٌ","وَيَنهَلُّ دَمعُ المُزنِ وَهوَ جَمادُ",27,"د",1,0],["تَنوبُ عَنِ الحَسناءِ وَالدارِ غُربَةٌ","فَما شِئتَ مِن لَهوٍ بِها وَتَأَنُّسِ",28,"س",1,0],["تَنُوءُ بأعباءٍ ثِقالٍ من الأَذَى","ويُوشِكُ فيها الخَسفُ أن يتجدَّدا",29,"د",2,0],["تَنوحُ لَها الأَطيارُ في القُضبِ رِقَّةً","وَيُذري عَلَيها المُزنُ أَدمُعَهُ رَحما",30,"م",2,0],["تَنوحُ وَقَد تَولَت مُدبِراتٌ","تَخالُ سوادَ أَيكَتِها عَرينا",31,"ن",2,0],["تَنُوءُ بِأَعلى خَلفِها فَيُطِيعُها","وَيَأبى نَقاً في الحُقوِ خَدلَ المُخَدَّمِ",32,"م",1,0],["تَنَوُّطُنا بِذُبيانٍ عَزِيزٌ","عَلَينا مِثلُ أَثقالِ الجِبالِ",33,"ل",1,0],["تَنوهُ أَنقاضٍ كَأَنَّ هُوِيَّها","هُوِيُّ سَماماتٍ بِنَجدٍ طَرائِدِ",34,"د",1,0],["تَنوبُ الرَزايا أَعظُمي لا أَصونُها","بِمُتَّخَذٍ مِن عَرعَرٍ وَتَنوبِ",35,"ب",1,0],["تَنوطُ بِنا الحَوادِثُ كُلُّ ثِقلٍ","وَرَبُّ الناسِ يَصرُفُ ما تَنوطُ",36,"ط",1,1],["تنور فوق الأشفياء وقد أتى","على قطن أغباش ذي حدب خضر",37,"ر",1,0],["تنوي زماعاً وَلكن","أيان ذاك الزماع",38,"ع",1,0],["تَنوح عَلى إلف تَرامَت به النَوى","وَفي القَلب من ذاك النواح صدوع",39,"ع",1,0],["تَنوح عَلى ما ضيعت من سعادة","وَقَد مرَّ من ليل الشَقاء هَزيع",39,"ع",1,0],["تَنُوبُ عَنْ تَهْنِئَةٍ","سَالِفَةٍ لَمْ تُقَلِ",40,"ل",1,0],["تَنوبُ عَن كُنهِها مَعارِفُها","وَفَضلُ بَدرٍ يَنوبُ عَن أُحُدِ",41,"د",1,0],["تَنَوَّرتُها مِن أَذرُعاتٍ وَأَهلُها","بِيَثرِبَ أَدنى دارَها نَظَرٌ عالِ",42,"ل",1,0],["تَنوطُ لَنا حُبَّ الحَياةِ نُفوسُنا","شَقاءً وَيَأتي المَوتُ مِن حَيثُ لا نَدري",43,"ر",2,0],["تنوي قبورك لكن","تجتازها غير ناوي",44,"ا",3,0],["تُنُوهِبْنَ من أقوات طاوٍ ضلوعَه","على الجْوع أو من دمع ثكلى وأيِّم",45,"م",1,0],["تنوخذي في بحر فكري وأسبحي","وبعطيس .. جوهرتي وقولي بقتها",46,"ت",3,1],["تنورها الحبر ابن عباس منهم","فحج علياً والحجيج نصير",47,"ر",1,0],["تنورتموه وهو نجم لأفقها","فاصبح هذا الكون بالنور مشعلا",48,"ل",2,0],["تنوبُ دواهي الدهر من كان داهيا","فكنت الفتى الاعلى وكانو الادانيا",49,"ا",1,0],["تنوب عن الكينا بمر مذاقها","وتُغنى عن الكنياك في زمنِ البردِ",50,"د",1,0],["تَنوحُ عَلى فَقَدِ الأَميرِ مُحَمدٍ","رِجالٌ عَلَيهِ بِالدِّما تَتَلَثَّمُ",51,"م",1,0],["تَنوحُ القَوافي بَعد يَومِكَ حَسرةً","فنُوشِكُ نَخشى نَثرَها حينَ تُنظَمُ",51,"م",1,0],["تَنوح الهاتفاتُ على ذُراه","وتُعْشِبُ في أسافِله الرِّحاب",52,"ب",1,0],["تَنوشُ مِن صُوَّةِ الأَنهارِ يُطعِمُهُ","مِنَ التَهاويلِ وَالزُبّادِ ما أَكَلا",53,"ل",2,0],["تنوح بِلا دمع وللحزن آية","على نوحها 