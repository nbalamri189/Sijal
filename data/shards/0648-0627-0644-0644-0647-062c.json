{"poems":[[79,"وسواس حليك أم هم الرقباء","https://www.aldiwan.net/poem36791.html","الكامل"],[85,"بشرى كما وضح الزمان وأجمل","https://www.aldiwan.net/poem54256.html","الكامل"],[79,"وسواسُ حليكِ أم هم الرقباءُ","https://www.poetsgate.com/ViewPoem.aspx?id=3296",""],[147,"لا تخش عدوى من أبحت ذماره","https://www.aldiwan.net/poem11831.html","الطويل"],[234,"لا نالك السقم المحذور إن وردا","https://www.aldiwan.net/poem51156.html","البسيط"],[275,"أدمشق ما أمضى سيوف بنيك","https://www.aldiwan.net/poem35644.html","الكامل"],[445,"قد عادت الشمس في أعلى مطالعها","https://www.aldiwan.net/poem34798.html","البسيط"],[445,"عمرت بطول بقائك الأعمار","https://www.aldiwan.net/poem34878.html","الكامل"],[543,"يوم أناخ بباب خير إمام","https://www.aldiwan.net/poem47941.html","عموديه"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59703","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59435","الكامل"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93101","الرجز"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2484,"","https://poetry.dctabudhabi.ae/diwan/poem/132507","الرجز"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112691","الرجز"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117927","السريع"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40155","المنسرح"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119648","الكامل"],[4313,"","https://poetry.dctabudhabi.ae/diwan/poem/104436","الكامل"],[5122,"لله","https://www.poetsgate.com/ViewPoem.aspx?id=27776",""],[5145,"البين فرق بين جفني والكرى","https://www.poetsgate.com/ViewPoem.aspx?id=108235",""],[5145,"لله درك من بناءٍ عالي","https://www.poetsgate.com/ViewPoem.aspx?id=108232",""],[5183,"هبة العليم","https://www.poetsgate.com/ViewPoem.aspx?id=180194",""],[5226,"للقدس .. كلام آخر","https://www.poetsgate.com/ViewPoem.aspx?id=27720",""]],"verses":[["وَاللهُ جَلَّ اسْماً لِمُلْكِكَ حزبه","وَاللهُ فِيهِ كِفَايَةٌ وَكِفَاءُ",0,"ا",2,0],["واللهُ جَلَّ جلالُه إن أمْهَلت","أحكامُهُ مُستدرَجاً لا تُهملُ",1,"ل",1,0],["والله جلَّ اسماً لملكِكَ ناصرٌ","والله فيك كفاية ٌ وكِفاءُ",2,"ا",2,0],["وَاللَهُ جاءَ بِها عَلى أَعقابِهِم","لِيَفيضَ مِن إِحسانِهِم إِحسانُهُ",3,"ن",2,0],["والله جارُك ممَّا أنت تحذره","ومصطفِيك ومعطِيك الذي وعدا",4,"د",2,0],["والله جِرحُكَ ليسَ يَبقى دامياً","واللهِ ثأرُكِ ليسَ بالمَتروكِ",5,"ك",1,0],["واللهُ جارُكَ فِي حِلٍّ ومُرْتَحَلٍ","وسَاحَةِ الأَرْضِ دانيها وشاسِعِها",6,"ع",3,0],["واللهُ جارُكَ كم أَجَرْتَ عِبادَهُ","من كُلِّ خطبٍ لَيْسَ مِنه جارُ",7,"ر",1,0],["والله جَلَّ جلالُه سَيزيدُكُم","من فائِقِ الإحسانِ والإنعامِ",8,"م",1,0],["واللّه جلَّ جلاله متكفلٌ","بالنصر والمعهودِ من إنعامه",9,"م",2,0],["والله جل جلاله","أعطاه فضلا لا يحد",10,"د",1,0],["وَاللَهُ جَلَّ شَأنَهُ بِرشدِه","أَيده بِروحِهِ وَسَدَّدا",11,"د",2,0],["واللهُ جَلَّ جَلاَلُهُ مُتَكَلِّمٌ","بِالنَّقلِ وَالمَعقُولِ والبُرهَانِ",12,"ن",1,0],["واللَه جلَّ ملكهُ حكيمُ","وهو بتدبير الورى عليمُ",13,"م",1,0],["واللَه جل للذي أتهم","أشد بأسا ونكالا منكم",14,"م",1,0],["والله جلت ذاته حافظ","حافظ دين الله في عصره",15,"ر",2,0],["وَاللَّهُ جازيهِ عَن مُقيَّدةٍ","أَعزَّها اللَّهُ مُذْ تَولّاها",16,"ا",1,0],["واللَه جلّ جلاله مع من غدا","في نصحه للناس خير أمين",17,"ن",1,0],["واللَه جار لا يرد قضاؤه","في الخلق وهوالواحد القهار",18,"ر",1,0],["والله جعل كيده وقومه أبتظليل","وسلط على قومه وفيله وصده",19,"د",2,0],["والله جارك حيث كنت من الأذى","وبصير شأنك فادعه مستنصرا",20,"ر",2,0],["والله جارك من حوادث تعتري","وتسوقهنّ مصارف الأحوال",21,"ل",1,0],["والله جل يقول فيكم إنما","يخشاه دون عباده علماؤه",22,"ا",3,0],["والله جل جلاله .. معنا وإن","ظن الغزاة بأننا أيتامُ",23,"م",1,0]]}