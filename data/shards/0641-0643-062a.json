oem/128403","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66339","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83661","الخفيف"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28780","الكامل"],[4551,"","https://poetry.dctabudhabi.ae/diwan/poem/139874",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139627",""],[4818,"كعبة العشق","https://www.poetsgate.com/ViewPoem.aspx?id=203507",""],[4858,"العروبة ودماء أطفال غزّة","https://www.poetsgate.com/ViewPoem.aspx?id=175068",""],[4927,"الْحُبُّ الْمُتَوَقِّدُ","https://www.poetsgate.com/ViewPoem.aspx?id=29846",""],[4984,"مرَّ قطار صحبك","https://www.poetsgate.com/ViewPoem.aspx?id=175538",""],[4984,"ويحك ..","https://www.poetsgate.com/ViewPoem.aspx?id=175801",""],[5121,"قَلَمِي","https://www.poetsgate.com/ViewPoem.aspx?id=33498",""],[5145,"كنت التمست أخا العلى والسؤدد","https://www.poetsgate.com/ViewPoem.aspx?id=108205",""],[5150,"غربة","https://www.poetsgate.com/ViewPoem.aspx?id=202797",""],[5191,"بالحبّ قد نطقا","https://www.poetsgate.com/ViewPoem.aspx?id=212453",""],[5277,"زهرةٌ لا تذبلها الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=196558",""],[5277,"معارضةُ يائيةِ ابن الفارض(1)","https://www.poetsgate.com/ViewPoem.aspx?id=198943",""],[5285,"نوَّارة","https://www.poetsgate.com/ViewPoem.aspx?id=203655",""],[5296,"لك السلام","https://www.poetsgate.com/ViewPoem.aspx?id=154776",""],[307,"قالوا بأنّ الشعرَ ليس قوافياً","https://www.poetsgate.com/ViewPoem.aspx?id=215943",""],[5376,"عدنا للمسجدِ إخوانا","https://www.poetsgate.com/ViewPoem.aspx?id=214060",""],[5444,"مجد القلم","https://www.poetsgate.com/ViewPoem.aspx?id=205506",""],[5628,"الأميرة الغجرية","https://www.poetsgate.com/ViewPoem.aspx?id=178444",""],[5628,"التحول","https://www.poetsgate.com/ViewPoem.aspx?id=178547",""],[5751,"قرويةٌ هذي الأغاني","https://www.poetsgate.com/ViewPoem.aspx?id=215017",""],[5859,"رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=29416",""],[5861,"هو قالها","https://www.poetsgate.com/ViewPoem.aspx?id=191302",""],[5931,"جرح الجفا !","https://www.poetsgate.com/ViewPoem.aspx?id=175396",""],[5956,"لا رب عندي غير رب واحد","https://www.poetsgate.com/ViewPoem.aspx?id=192654",""],[186,"رمس لناصيف الكريم ثوى به","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55911&r=&rc=174",""],[5051,"يا عنترة !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87708&r=&rc=2",""],[6242,"أرق المساء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87553&r=&rc=1",""],[6345,"محمد الدرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78674&r=&rc=45",""]],"verses":[["فكتبت أحمدها إليك","عن المروءة والسلام",0,"م",1,0],["فكتابٌ أو رسولٌ","معه منك سلامُ",1,"م",1,0],["فَكِتلَةٌ فَرُؤامٌ مِن مَساكِنِها","فَمُنتَهى السَيلِ مِن بَنيانَ فَالحُبَلُ",2,"ل",1,0],["فَكَتَبَ اللَيثُ أَماناً لَها","وَزادَ أَن جادَ بِمُستَنقَعِ",3,"ع",1,0],["فَكَّت أَكُفُّ المَوتِ غُلَّ قَصائِدي","عَنهُ وَضَيغَمُها عَلَيهِ يَزيرُ",4,"ر",1,0],["فَكُتَّابُ الشَّمالِ هُمُ جَمِيعاً","فلا صَحِبَتْ شِمالُهُمُ اليَمِينا",5,"ن",2,0],["فكتائبٌ أعجلْتَها لم تنجفِلْ","وكتائبٌ في اليَمِّ خاضَتْ تُجفِل",6,"ل",1,0],["فَكَتَبتُ في فَصٍّ لِيَبلُغَها","مَن نامَ لَم يَعقِل كَمَن سَهِدا",7,"د",2,0],["فكتمتُ سِرَّهمُ وهَلْ","تلقى أخَاً وَجْدٍ كَتُومَا",8,"م",2,0],["فَكَتَبتَ إِسجالاً عَلى قِمَمِ العِدى","بِشَبا الظُبى أَلّا تَكونَ سِجالا",9,"ل",2,0],["فَكَتَبتَ تَذكُرُ ما أَنا","لَت مِن مَواهِبِها الجَزيلَه",10,"ل",2,0],["فكتبه اليوم أغنت عن كتائبه","فعلا وزن بما ضمن من نعمه",11,"م",2,0],["فَكَتَبَتُ تاريخي بِجانبِ قَبرِها","حَلَت عَفيفةُ بِالمَقامِ الأَطهَرِ",12,"ر",1,0],["فَكَتبَتُ بالتاريخِ فيهِ قائِلاً","ناحَ الحَمامُ عَلى غَريبِ المَنزلِ",13,"ل",1,0],["فكَتَبَتَ تاريخاً يُسطِّرُ حَولَها","يا تُربةَ السوسان باكركِ النَدى",14,"د",2,0],["فَكَتَبَتُ وَالتاريخُ لَبَّى قائِلاً","جاوَرتُ في الدارينِ ميخائيلا",15,"ل",2,0],["فَكَتَبَتُ في اللَوحِ المُؤرِّخِ راسِماً","بِجوارِ عَرشِ اللَّهِ حلَّتْ مَريَمُ",16,"م",1,0],["فَكَتَبتُ وَالتّاريخُ أَنبَأَ صَدقَهُ","في مَنزلِ الرَحمَنِ باتَ خَليلُهُ",17,"ل",2,0],["فَكَتَبَتُ وَالتّا