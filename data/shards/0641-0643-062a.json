{"poems":[[93,"يا من يخاطبه ويمدحه","https://www.aldiwan.net/poem9831.html","مجزوء الكامل"],[51,"أنا صب مستهام","https://www.aldiwan.net/poem66023.html","مجزوء الرمل"],[38,"قالت سليمى أتنوي اليوم أم تغل","https://www.aldiwan.net/poem7736.html","البسيط"],[85,"إنفع بما أعطيت من قدرة","https://www.aldiwan.net/poem8015.html","السريع"],[44,"إني على ما نالني لصبور","https://www.aldiwan.net/poem30044.html","الكامل"],[67,"ثكلت طوائف المستخدمينا","https://www.aldiwan.net/poem18120.html","الوافر"],[75,"قامت تميس كما تدافع جدول","https://www.aldiwan.net/poem69047.html","الكامل"],[48,"كتبت على فص لخاتمها","https://www.aldiwan.net/poem62570.html","الكامل"],[126,"حي المعاليم والرسوما","https://www.aldiwan.net/poem50515.html","مجزوء الكامل"],[141,"النجم أقرب من مداك منالا","https://www.aldiwan.net/poem11792.html","الكامل"],[141,"يا غابرا وجد الندى","https://www.aldiwan.net/poem11797.html","مجزوء الكامل"],[158,"في لحظ عينيه سكر من رحيق فمه","https://www.aldiwan.net/poem58995.html","البسيط"],[180,"رمس توارت فيه خير قرينة","https://www.aldiwan.net/poem61060.html","الكامل"],[180,"رمس لميخائيل قد نزل الرضى","https://www.aldiwan.net/poem61073.html","الطويل"],[180,"من آل دلال كريمة معشر","https://www.aldiwan.net/poem61127.html","الكامل"],[180,"رمس لناصيف الكريم ثوى به","https://www.aldiwan.net/poem61168.html","الكامل"],[180,"من آل صباغ الكرام كريمة","https://www.aldiwan.net/poem66903.html","الكامل"],[180,"من آل أرقش راحل لما مضى","https://www.aldiwan.net/poem66934.html","الكامل"],[180,"من آل فرنيني الأكارم ماجد","https://www.aldiwan.net/poem66949.html","الكامل"],[180,"أمسى بنو الزهار بعد عزيزهم","https://www.aldiwan.net/poem66995.html","الكامل"],[183,"هذا الإمام إمامي حاضر بادي","https://www.aldiwan.net/poem14504.html","البسيط"],[184,"نفوس الناس بالشح","https://www.aldiwan.net/poem43661.html","الهزج"],[197,"بأبي الذي كتبت يداه تحيتي","https://www.aldiwan.net/poem45190.html","الكامل"],[202,"تطوى المنى عن طلاب غايته","https://www.aldiwan.net/poem53265.html","المنسرح"],[221,"أسرعت لبابك أقرعه","https://www.aldiwan.net/poem41617.html","المتدارك"],[308,"سيدي والظنون فيك جميلة","https://www.aldiwan.net/poem59510.html","الخفيف"],[400,"يا ساري الريح ساعدني على وطري","https://www.aldiwan.net/poem33913.html","البسيط"],[426,"أسناء برق لاح أم","https://www.aldiwan.net/poem41420.html","مجزوء الكامل"],[551,"عاصى الشباب فراح غير مفند","https://www.aldiwan.net/poem68399.html","الكامل"],[560,"أنشا لإيليا الغيور كنيسة","https://www.aldiwan.net/poem52547.html","الكامل"],[560,"هذا الضريح لبطرس العازار من","https://www.aldiwan.net/poem52616.html","الكامل"],[560,"من آل نوفل يافع غض الصبا","https://www.aldiwan.net/poem52656.html","الكامل"],[560,"إن ابنة الحداد طنوس انطوت","https://www.aldiwan.net/poem52662.html","الكامل"],[573,"هيهات ما حالي كحالك","https://www.aldiwan.net/poem3043.html","مجزوء الرمل"]],"verses":[["فكتبت أحمدها إليك","عن المروءة والسلام",0,"م",1,0],["فكتابٌ أو رسولٌ","معه منك سلامُ",1,"م",1,0],["فَكِتلَةٌ فَرُؤامٌ مِن مَساكِنِها","فَمُنتَهى السَيلِ مِن بَنيانَ فَالحُبَلُ",2,"ل",1,0],["فَكَتَبَ اللَيثُ أَماناً لَها","وَزادَ أَن جادَ بِمُستَنقَعِ",3,"ع",1,0],["فَكَّت أَكُفُّ المَوتِ غُلَّ قَصائِدي","عَنهُ وَضَيغَمُها عَلَيهِ يَزيرُ",4,"ر",1,0],["فَكُتَّابُ الشَّمالِ هُمُ جَمِيعاً","فلا صَحِبَتْ شِمالُهُمُ اليَمِينا",5,"ن",2,0],["فكتائبٌ أعجلْتَها لم تنجفِلْ","وكتائبٌ في اليَمِّ خاضَتْ تُجفِل",6,"ل",1,0],["فَكَتَبتُ في فَصٍّ لِيَبلُغَها","مَن نامَ لَم يَعقِل كَمَن سَهِدا",7,"د",2,0],["فكتمتُ سِرَّهمُ وهَلْ","تلقى أخَاً وَجْدٍ كَتُومَا",8,"م",2,0],["فَكَتَبتَ إِسجالاً عَلى قِمَمِ العِدى","بِشَبا الظُبى أَلّا تَكونَ سِجالا",9,"ل",2,0],["فَكَتَبتَ تَذكُرُ ما أَنا","لَت مِن مَواهِبِها الجَزيلَه",10,"ل",2,0],["فكتبه اليوم أغنت عن كتائبه","فعلا وزن بما ضمن من نعمه",11,"م",2,0],["فَكَتَبَتُ تاريخي بِجانبِ قَبرِها","حَلَت عَفيفةُ بِالمَقامِ الأَطهَرِ",12,"ر",1,0],["فَكَتبَتُ بالتاريخِ فيهِ قائِلاً","ناحَ الحَمامُ عَلى غَريبِ المَنزلِ",13,"ل",1,0],["فكَتَبَتَ تاريخاً يُسطِّرُ حَولَها","يا تُربةَ السوسان باكركِ النَدى",14,"د",2,0],["فَكَتَبَتُ وَالتاريخُ لَبَّى قائِلاً","جاوَرتُ في الدارينِ ميخائيلا",15,"ل",2,0],["فَكَتَبَتُ في اللَوحِ المُؤرِّخِ راسِماً","بِجوارِ عَرشِ اللَّهِ حلَّتْ مَريَمُ",16,"م",1,0],["فَكَتَبتُ وَالتّاريخُ أَنبَأَ صَدقَهُ","في مَنزلِ الرَحمَنِ باتَ خَليلُهُ",17,"ل",2,0],["فَكَتَبَتُ وَالتّاريخُ يَنطقُ صادِقاً","لا رَيبَ عِندَ اللَهِ باتَ خَليلُهُ",18,"ل",2,0],["فَكَتبتُ بِالتاريخِ نَظمي قائِلاً","يا ساكنَ الفَردوسِ أَنَّكَ أَسعَدُ",19,"د",1,0],["فَكَّت مَسرَّتُها أَسْرَ القلوبِ وقد","تَقلَّبت للأَسى ما بين أَصْفاد",20,"د",1,0],["فكتب الجد قد ردّت","وكتب الهزل محظوظه",21,"ه",1,0],["فكتابهُ عندي وكتْبي عندهُ","غنجُ الحبيبِ وآهةُ الثكلانِ",22,"ن",1,0],["فكُتبُه كالعيون إن نُشِرَت","سَوَادُها من بياضها أحوَرْ",23,"ر",1,0],["فَكَتَمت السرَّ وَفي كَبِدي","قَيثارُ الحَظِّ أُقَطِّعُهُ",24,"ع",2,0],["فكتبنا معولين على حل","مك تمحو الاصار عنا الثقيله",25,"ل",2,0],["فكتبتم بعد من قد صار في غرف","من الجنان وفي روض وفي نهر",26,"ر",1,0],["فكتمت حبك بالحشا","والدمع باح بما اكتتم",27,"م",1,0],["فَكَتِلكَ لا تِلكَ الَّتي ضاقَت بِها","كَفُّ الفَرَزدَقِ إِذ يُقالُ لَهُ قَدِ",28,"د",1,0],["فكتبتُ قولَ مؤرِّخيهِ ببابِها","يا حَيُّ شَعبُكَ تحتَ سيفكَ يَلتَجِي",29,"ي",1,0],["فكتبتُ في تأريخنا هذا لهُ","قد جاورَ العازارَ بطرُسُ في السَّما",30,"م",2,0],["فكتبتُ تأريخاً بأعلى تُربِهِ","أبشِرْ فإنَّكَ عندَ ربِّكَ أسعَدُ",31,"د",1,0],["فكتبتُ والتاريخُ أنشدَ عاجلاً","هل يزرَعُ السُّوسانُ إلاّ في الثَرَى",32,"ر",2,0],["فكتبتَ لي ما صرتُ منه","فوقَ ظهرِ الأُفْقِ سَالِكْ",33,"ك",1,0]]}