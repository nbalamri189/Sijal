{"poems":[[57,"إنما عتبي عليها","https://www.aldiwan.net/poem26196.html","مجزوء الرمل"],[53,"طرقت أسماء والركب هجود","https://www.aldiwan.net/poem61906.html","الرمل"],[94,"لست أبكي لعسف ليل طويل","https://www.aldiwan.net/poem38894.html","الخفيف"],[91,"وصف الدنيا كثيرون","https://www.aldiwan.net/poem44886.html","مجزوء الرمل"],[99,"يا أبا الأشواق غن","https://www.aldiwan.net/poem24584.html","مجزوء الرمل"],[104,"حبذا لو يصوم منا زعيم","https://www.aldiwan.net/poem33022.html","البسيط"],[77,"إمسحوا عن ناظري كحل السهاد","https://www.aldiwan.net/poem69087.html","الطويل"],[48,"أوجز الدهر في المقال إلى أن","https://www.aldiwan.net/poem22772.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[108,"زفاف الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179500",""],[99,"عيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63618&r=&rc=165",""],[136,"كلف العيس بالسرى فذراها","https://www.aldiwan.net/poem54692.html","الخفيف"],[234,"لم أفارقكما اختيارا وهل تختار","https://www.aldiwan.net/poem50849.html","الخفيف"],[280,"أذنت أرض العدى بافتتاح","https://www.aldiwan.net/poem25601.html","المديد"],[347,"قيل لي هات في الوطن","https://www.aldiwan.net/poem55326.html","مجزوء الخفيف"],[366,"سيدي بالذي أمدك بالحسن","https://www.aldiwan.net/poem68074.html","الخفيف"],[408,"أنا وحدي في المكان","https://www.aldiwan.net/poem46526.html","مجزوء الرمل"],[438,"دون ما بيننا من الود يكفي","https://www.aldiwan.net/poem12384.html","الخفيف"],[449,"يا رسولي اذهبا فأبلغاها","https://www.aldiwan.net/poem56061.html","الخفيف"],[563,"أنا عندي أن الشهود حجاب","https://www.aldiwan.net/poem34967.html","الخفيف"],[584,"أي شيء يمنح الأوطان قدرا","https://www.aldiwan.net/poem56777.html","الرمل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63793","الخفيف"],[1183,"","https://poetry.dctabudhabi.ae/diwan/poem/18217","الرمل"],[1315,"","https://poetry.dctabudhabi.ae/diwan/poem/140223",""],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89541","الرمل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106849","الخفيف"],[2769,"","https://poetry.dctabudhabi.ae/diwan/poem/98168","المديد"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100247","الرمل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109801","الخفيف"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101603","الخفيف"],[3685,"","https://poetry.dctabudhabi.ae/diwan/poem/203163","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91864","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128911","الخفيف"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59480","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[4087,"","https://poetry.dctabudhabi.ae/diwan/poem/131666",""],[4388,"","https://poetry.dctabudhabi.ae/diwan/poem/115345","المديد"],[5136,"وأخ يأكل لحمي ميتا","https://www.poetsgate.com/ViewPoem.aspx?id=121522",""],[5147,"روح النفس فهي ضيف بمغناك","https://www.poetsgate.com/ViewPoem.aspx?id=166733",""],[5277,"هاك زهرة","https://www.poetsgate.com/ViewPoem.aspx?id=208576",""],[5414,"صرخة من وراء الأسوار","https://www.poetsgate.com/ViewPoem.aspx?id=12936",""],[5431,"رافض ذلّ احتلالك","https://www.poetsgate.com/ViewPoem.aspx?id=184976",""],[5970,"محنة تأتي وأخرى في رواح","https://www.poetsgate.com/ViewPoem.aspx?id=130629",""],[6212,"طائفية أو فيفية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1624&r=&rc=5",""]],"verses":[["إِنَّما عَتَبي عَلَيها","بَعدَ أَن كانَ عَلَيكا",0,"ك",2,1],["إنما عاندت إذ عاندتَهُ","حظَّك الأوفَرَ فابعَدْ وثمودُ",1,"د",1,0],["إنَّما عَبْرَتي لخَطْبِ ثَقيلٍ","قَدْ عَرَانا ولمْ نَجِدْ مَن أَزاحَهْ",2,"ح",2,0],["إنما عندي في تص","ويرها القول الصواب",3,"ب",1,0],["إنما عيدك عيدي","وهو يوم فوق ظني",4,"ن",2,0],["إنما عُدَّةُ الضعيفِ احتجاجٌ","لمُ يُجاوِزْ حدَّ السطورِ احتدامُهْ",5,"م",2,0],["إنّما عُوِّدْتُما في ذا الورى","عادةَ الأنواءِ في الأرض الجَماد",6,"د",1,0],["إِنَّما عِشَرَةُ الأَنامِ نِفاقٌ","وَتَباهٍ في باطِلٍ وَتَجازِ",7,"ز",1,0],["إنما علمي كله هو أن ال","لَهَ حي وأنه لا يبور",8,"ر",1,0],["إنما عجمنا عودَه؛ فإذا له","وجهُ البدور، وهمَّةُ الآساد",9,"د",1,0],["إنما عيدك عيندي","وهو يوم فوق ظني",10,"ن",2,0],["إِنَّما عُرِّيَت شَهُوراً لإِعمَا","لِ شُهُورٍ أمَامَهَا وَوَارَاهَا",11,"ا",3,0],["إنما عِيدُنا العزِيزُ الّذي نِل","نا بنُعْماه مُنْتَهَى الآمالِ",12,"ل",1,0],["إنَّما عَزْمُ إمامٍ مُطاع","أمْرُهُ في كلِّ حَيّ لَقاح",13,"ح",1,0],["ان ما عب خمركم","واحتوى الكأس والوسن",14,"ن",1,0],["اِنَّما عُصبَة الجَمالِ نُجوم","أَنتَ قَد صِرتَ فَوقَهُنَّ هِلالا",15,"ل",2,0],["إنّما عندي ما شِئتَ","من الكُتبِ الحِسانِ",16,"ن",1,0],["إِنَّمَا عادَةُ الكِرامُ وما أَوْ","لاكَ فيهم بأَنْ تُعَدَّ بأَلْفِ",17,"ف",1,0],["إنما عتبهُ لقد كان قصدي","وعن العتب ضلّ عقلي وتاها",18,"ا",3,0],["إنما عندي الشراب وغيري","عنده موضع الشراب سراب",19,"ب",1,0],["إنَّما عشنا وفاءَ الحبِّ فيها","هكذا عهدُ الوفا للحرِّ أَمْرا",20,"ر",2,0],["إنما عيرُنا الكؤوسُ تراها","سائراتٍ تُحْدَى بناءٍ وزير",21,"ر",1,0],["إِنَّما عَبدُ مُنافٍ جَوهَرٌ","زَيَّنَ الجَوهَرَ عَبدُ المُطَّلِب",22,"ب",1,0],["إنما عصر الصبا ليل دجا","أدبر الليل بإشراق النهار",23,"ر",1,0],["إنما عيشُكُم مَنَامٌ قصيرٌ","فيه تشقى وتسعدُ الأحياء",24,"ا",2,0],["إِنَّما عَبدُ العَزيزِ المُفتَدى","مِن عَظيمِ المَنِّ إِحسانٌ وَمَنحُ",25,"ح",1,0],["إنما عذرها همُ ونساهم","عذرهنَّ العمى وقبحُ الصفات",26,"ت",1,0],["إنما عاقبت ناظره","إذا أعاد الطرف مسترقا",27,"ق",2,0],["إنما عيش الفتى متعبة","للفتى يوماً ويوماً مستراح",28,"ح",1,0],["انما عيسنا سوابق خيل","ولدينا هوادج المركبات",29,"ت",1,0],["إنّما عند وصفها خانني الفك","ر وألقى على بيانيَ عيّا",30,"ي",2,0],["إنما عم ظلمكم سائر الأر","ض فشابت ذوائب الآفاق",31,"ق",1,0],["إِنَّما عزَّ بعدُنا عن حَبيبٍ","حار في وَصف حُسنه النيران",32,"ن",1,0],["انما عادة الضيوف باذن","يدخلون البيوت والغرفان",33,"ن",1,0],["إنما عاجَ بكم عن طاعتي","قلُّ توفيقٍ عراكم وحَمقْ",34,"ق",1,0],["إنما عند ما رأى الطروادا","عبروا السور بالعجال طرادا",35,"د",2,0],["إنما عيني رأت طلعته","كشعاع الشمس من ثقب نزل",36,"ل",1,0],["إنما عاقَبت ناظَره","إن أعادَ اللحظَ مُستَرِقا",37,"ق",2,0],["إنما عرضي حقا عرضه","فليعبني إنه لهو المعيب",38,"ب",1,0],["إنما عالم الطباع سبيل","وعبور لعالم لن يزولا",39,"ل",2,0],["إنّ ما عندي يفوقُ اليومَ حبي","مُذ تعارفْنا وقلبي صانَ عهدَك",40,"ك",1,0],["إنما عشتُ شامخا بيقيني","رافعَ الرأسً عزةً وفخارا",41,"ر",2,0],["إنما عشقي عظيمٌ","فاق مايجري ببالك",42,"ك",1,0],["إنما عزم الفتي في صبره","لا يرى الصابر مكسور الجناح",43,"ح",1,0],["إنما عشقِيكِ وَصْلٌ ناعمٌ","وفؤادُ العشقِ وَهْنٌ ضَمّ وَهْنَا",44,"ن",2,0]]}