{"poems":[[95,"شارفت مصر وفيها كل ناضرة","https://www.aldiwan.net/poem11107.html","البسيط"],[53,"عيد يطابق أول الأسبوع","https://www.aldiwan.net/poem65060.html","الكامل"],[53,"أقول لما رأيت عرسي","https://www.aldiwan.net/poem66512.html","مخلع البسيط"],[91,"ما شاهدت عيني ممث","https://www.aldiwan.net/poem44910.html","مجزوء الكامل"],[47,"للفضل أخلاق يلقن بفضله","https://www.aldiwan.net/poem65547.html","الكامل"],[22,"شاقتك أظعان للي","https://www.aldiwan.net/poem21642.html","مجزوء الكامل"],[1,"أشجاك الربع أم قدمه","https://www.aldiwan.net/poem34014.html","المديد"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54588","الخفيف"],[113,"خفض عليك فما الفؤاد بسالي","https://www.aldiwan.net/poem16260.html","الكامل"],[215,"أكرموا مطران أو لا تكرموه","https://www.aldiwan.net/poem46305.html","الرمل"],[275,"حتام تعشق عاجا تحت ديباج","https://www.aldiwan.net/poem35179.html","البسيط"],[309,"أمن الموت أجزع","https://www.aldiwan.net/poem16760.html","مجزوء الخفيف"],[382,"بالعقل قد يحوي الفتى الإحياء","https://www.aldiwan.net/poem66965.html","الكامل"],[457,"للفيجة الغناء عين لم تزل","https://www.aldiwan.net/poem13741.html","الكامل"],[463,"نوازع الشوق والغليلِ","https://www.aldiwan.net/poem55990.html","مخلع البسيط"],[463,"أصب برأيي أصاب الحظ أو غلطا","https://www.aldiwan.net/poem56141.html","البسيط"],[519,"ضربوا القباب وطنبوها بالقنا","https://www.aldiwan.net/poem20802.html","الكامل"],[519,"سل ضاحك البرق يوما عن ثناياها","https://www.aldiwan.net/poem20830.html","البسيط"],[543,"السحر هذا ما أرى","https://www.aldiwan.net/poem48280.html","عموديه"],[564,"للفقر أهل فكن لهم تبعا","https://www.aldiwan.net/poem69346.html","المنسرح"],[572,"ألقي في حبك القناع","https://www.aldiwan.net/poem69611.html","مخلع البسيط"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138375",""],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112453","السريع"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86905","الكامل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54005","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63866","المنسرح"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18546","الكامل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35722","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79987","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79868","السريع"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79953","الكامل"],[1723,"","https://poetry.dctabudhabi.ae/diwan/poem/216322","الكامل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132252","الكامل"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11153","السريع"],[1895,"","https://poetry.dctabudhabi.ae/diwan/poem/74990","الرمل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96035","الكامل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105059","الرمل"],[2496,"","https://poetry.dctabudhabi.ae/diwan/poem/100436","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87321","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203494","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204576",""],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86291","الرمل"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35508","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111507","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111451","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111506","السريع"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70143","الكامل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36329","الدوبيت"],[4166,"","https://poetry.dctabudhabi.ae/diwan/poem/203266","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90889","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90857","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90802","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90919","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90756","الوافر"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136689",""],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72875","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72447","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72864","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72873","الرمل"],[4545,"","https://poetry.dctabudhabi.ae/diwan/poem/216345",""],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52156","الخفيف"],[4755,"لِلفاتِحِينَ الجَوَّ لِلطائراتْ","https://www.poetsgate.com/ViewPoem.aspx?id=184207",""],[4929,"كن متفائلا","https://www.poetsgate.com/ViewPoem.aspx?id=199294",""],[5061,"اللكزس","https://www.poetsgate.com/ViewPoem.aspx?id=153003",""],[5145,"البين فرق بين جفني والكرى","https://www.poetsgate.com/ViewPoem.aspx?id=108235",""],[5147,"للفوز أجهزة تداول صرفها","https://www.poetsgate.com/ViewPoem.aspx?id=166743",""],[5186,"قلب الدهر اختيارا","https://www.poetsgate.com/ViewPoem.aspx?id=156521",""],[5187,"عروس العاصي","https://www.poetsgate.com/ViewPoem.aspx?id=29699",""],[5302,"ألف مبارك للزعيم","https://www.poetsgate.com/ViewPoem.aspx?id=215933",""],[5320,"قلعة الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=40442",""],[5431,"حشد الرعاع ...","https://www.poetsgate.com/ViewPoem.aspx?id=202871",""],[709,"ضربوا القبابَ وطنّبوها بالقنا","https://www.poetsgate.com/ViewPoem.aspx?id=2906",""],[5470,"ذاكرة المجد","https://www.poetsgate.com/ViewPoem.aspx?id=12367",""],[5480,"ثوب الحداد","https://www.poetsgate.com/ViewPoem.aspx?id=10980",""],[5533,"الفَجْرُ قادِم","https://www.poetsgate.com/ViewPoem.aspx?id=176644",""],[5558,"احْذَرْ قِلاعي بلْ جُنودي","https://www.poetsgate.com/ViewPoem.aspx?id=211847",""],[5573,"عبرتك فعل البليد ومكسبه وإفلاسه","https://www.poetsgate.com/ViewPoem.aspx?id=206490",""],[5707,"اتتنا من ودادك خير هبه","https://www.poetsgate.com/ViewPoem.aspx?id=189184",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[5848,"تصطفل يا قلب","https://www.poetsgate.com/ViewPoem.aspx?id=50599",""],[5897,"همسات لحظة","https://www.poetsgate.com/ViewPoem.aspx?id=156243",""],[5897,"يا طيبة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=156357",""],[5956,"شكراً لكرَم حفيدي فيصل","https://www.poetsgate.com/ViewPoem.aspx?id=193145",""],[6056,"الأ لفية ))(( المنبثقة","https://www.poetsgate.com/ViewPoem.aspx?id=130517",""],[6142,"الله ما أسناك يا كوكب","https://www.poetsgate.com/ViewPoem.aspx?id=155677",""],[5309,"ألشعر عاطفة بروحك تلمع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573519",""]],"verses":[["لِلْفَضْلِ فِي مِصْرَ أَعْلامٌ سَمَتْ وَصُوًى","وَإِنْ أَظْهَرَهَا فِيهَا صَوَايَاهَا",0,"ا",3,0],["للفألِ بالإقبال فيه شاهدٌ","عدلُ الشهادة ليس بالمدفوعِ",1,"ع",1,0],["للفال بُشرى بذاك عندي","ليست بزُورٍ ولا بميْن",2,"ن",1,0],["للفن ثم الفن ثم","مَ الفن فاطمة القديره",3,"ر",2,0],["لِلفَضلِ أَخلاقٌ يَلِقنَ بِفَضلِهِ","ما كانَ يَرغَبُ مِثلَها عَن مِثلِهِ",4,"ل",2,1],["لِلفَحلِ في آثارِها","زَجَلٌ يُخايِلُ أَو يُخاطِر",5,"ر",1,0],["لِلفَتى عَقلٌ يَعيشُ بِهِ","حَيثُ تَهدي ساقَهُ قَدَمُه",6,"م",2,0],["لِلْفِنُونِ ازْدِهَارُهَا وَالرَّزَايَا","غَافِلاَتٌ وَالأَمْنُ في اسْتِتْبَابِ",7,"ب",1,0],["لِلفَضل قَد غَرَسَت يَداهُ مَغارِساً","فَجَنى بِها ثَمَري عَلاً وَمَعالي",8,"ل",2,0],["للفتى يبقى من المجد أخوه","وهو ما أصدر من وحي الذكاء",9,"ا",2,0],["للفأل كالشؤمِ إضرارٌ بصاحبهِ","فاملُك هواكَ لإفساحٍ وإحراج",10,"ج",1,0],["لِلفَضائِلِ كُلِّها","وَهوَ لِلكُلِّ يَشفَعُ",11,"ع",1,0],["للفضل يُعزَى كلُّ خِرقٍ سؤددٍ","والعدل يطوي نشرُه الأعداء",12,"ا",2,0],["للفيجة الغناء عين لم تزل","فيها تطاردنا المنى ونطارد",13,"د",1,1],["للفِقَر المشكلاتِ منه","عارضةُ البارقِ الهطولِ",14,"ل",1,0],["للفرس والعُرب من شأنيهما شرفٌ","يردُّ خزياً على أعقابها النَّبطَا",15,"ط",2,0],["للفخرِ جَرْحاهُ تلَذُّ بضَرْبه","والبُرُّ يُرضي الجُرْبَ في ألَم الهَنا",16,"ن",2,0],["للفاضلينَ سُجودٌ حين يُمسِكُها","كأنّ سرَّ العصا فيها فألقاها",17,"ا",3,0],["لِلفخرِ حين يُذكَرُ","العلمَ فَالعِلمَ أطلُبِ",18,"ب",1,0],["للِفقرِ أهلٌ فَكُن لهمْ تبعَا","واعملْ على حبّهم وخِدمِتهمْ",19,"م",1,1],["لِلْفَهْمِ فِي لَحْظِهِ اتِّقَادٌ","لِلْعِلْمِ فِي لَفْظِهِ التِمَاعُ",20,"ع",1,0],["للفصل فيما بيننا قال لقد","أنساكم الشيطان ما قد انعقد",21,"د",1,0],["للفهم قد نسبوه اذ هو آية","فيه ولم يعهد كذاك فهيم",22,"م",1,0],["للفور تفنى لوعة المستهام","ويعبق المرج بعطر الورود",23,"د",1,0],["للفرع كُلٌّ حامدٌ","للأَصل كُلٌّ شاكر",24,"ر",1,0],["لِلْفضْلِ أقوامٌ أقامُوا رسمَهُ","مِنهمْ حقيقاً أحمدُ بن القاضِي",25,"ي",1,1],["للفيلِ أنيابه وَجُثَّتُه","فأيُّ شيءٍ في الفيل يُعْوِزُه",26,"ز",2,0],["لِلفارِسِ الحامي الحَقيقَةِ مُعلَماً","زادَ الرِفاقَ إِلى قُرى نَجرانِ",27,"ن",1,0],["لِلفَضلِ أَموالٌ أَطافَ بِها النَدى","حَتّى جَهِدنَ وَجودُهُ لَم يَجهَدِ",28,"د",1,0],["للفضلِ ما ارتفعت سماً","إلاَّ وكانَ ذكاءها",29,"ا",3,0],["للفضل أربابٌ وكلٌّ له","مزيّةٌ يسمو بعلياها",30,"ا",3,0],["للفاطميِّ القادريّ ومَن له","حسبٌ من الأحساب كانَ لبابها",31,"ب",3,0],["لِلفضْلِ يَوْمُ الطَّالَقانِ، وقَبْلَه","يومٌ أناخَ بهِ على خَاقانِ",32,"ن",1,1],["للفضل أقفال وهو مفاتح ال","أقفال معطى الفضل بالإكثار",33,"ر",1,0],["لِلفاعِلِ المَعروفِ في قَومِهِ","لايَستَوي المَعروفُ وَالمُنكَرُ",34,"ر",1,0],["لِلفَتى فرصة وَصل إنها","تدرك الأَشياء من قبل الثلل",35,"ل",1,0],["للفيض في قحم السنين","غداة ظنت بالعهاد",36,"د",1,0],["للفناء الرحب أقبلت وقد","ضاق بي مما أرى رحب الفضا",37,"ض",2,1],["للفضل والجود والتقوى أضيف فكم","تتابعت منه في العليا إضافات",38,"ت",1,0],["للفتِّ والرُتقَةِ والدَّامانِ","والنَّفسِ فارتُقه بلا تَواني",39,"ي",1,0],["للفن منتسبون لو تابعتهم","بفنونهم تجد الفنون جنونا",40,"ن",2,0],["للفار من مأكلي غذاء","والبق جسمي لديه قوت",41,"ت",1,0],["لِلفَتى لا تَنظُرن اِن رُمت اِن","تَعرِف الاِنسانَ وَاِنظُر ما فَعَل",42,"ل",1,0],["لِلفِعلِ تَوكِيدٌ بِنُونَينِ هُما","كنُونِى اذهَبَنَّ واقصِدنَهُمَا",43,"م",2,0],["لِلفظكَ يهجرُ الرَوض البَهيجُ","وَدُونَ ثِيابك المِسك الأَريجُ",44,"ج",1,1],["للفلك هيرا أسرعت وكذا","فالأس ثمة فوسذٌ ذهبا",45,"ب",2,0],["لِلفَجرِ ظَلّض تَرقُبُ الخَيّاله","تَعقُبها كَتائِبُ الرَجّالَه",46,"ه",1,0],["لِلفُلكِ سَيَّرَهُ بِها وَهُوَ انثَنى","لِحَثيثِ مَركَبَةٍ لَهُ مُستعجِلا",47,"ل",2,0],["للفلك يأتونا بذخرٍ ذخر","أعددته لابن أياكٍ أنا",48,"ن",2,0],["للفضل اضحى خازناً وامينهُ","فلديهِ مِنهُ طارِفٌ وتليدُ",49,"د",1,0],["لِلفَجرِ بَدَت حينَ سَرَت أَوضاحُ","فالظُلمةُ لا شَكَّ بِها تَنزاحُ",50,"ح",1,1],["للفصل والفضل والألطاف منه ترى","والعلم والحلم جمع غير منخرم",51,"م",1,0],["للفضل قوم لا يقوم بغيرهم","ومحاسن البيت الرفيع باله",52,"ل",2,0],["للفضل أهل لا يقوم بغيرهم","بيت سوى أهليه فيه خالي",53,"ل",2,0],["للفرع من أصله الأسرار سارية","شبل الكماة كمي وابن السرة سري",54,"ر",2,0],["للفتك قد خلقت فاضحت فتنة","تدع الأسود فرايس الغزلان",55,"ن",1,0],["للفضل أهل لا يقوم بغيرهم","بيت سوى أهليه فيه خال",56,"ل",1,0],["للفتك قد خُلق الكماة","وللخبا خلقت نساء",57,"ا",2,0],["للفتاوى نتيجة حازها القا","ضي فعادت نتيجةً للقضايا",58,"ي",2,1],["للفتق والرتق قد تصدى","فاعجب له فاتقا وراتق",59,"ق",1,0],["للفتاوي سفينةٌ قلتُ فيها","إذ غدت حضرةُ الشريفِ قمينه",60,"ه",1,1],["للفتاوي بهجة مالكُها","صاحب البهجةِ مولانا الشريف",61,"ف",1,1],["لِلفِهامى لا تِشير إلا امثال","والبِهايِمْ لو تِدِقّ لها طبول",62,"ل",1,0],["للفقير الضعيفِ فيه أنينٌ","خارجٌ لو سمِعت من طيّاته",63,"ت",2,0],["لِلفاتِحِينَ الجَوَّ لِلطائراتْ","والمُشرِعِينَ البَحرَ لِلباخِراتْ",64,"ت",1,1],["للفجر من رحم الظلام حلولُ","وللجة الليل الثقيل أفولُ",65,"ل",1,1],["للفخامه والرقي اسمه دليل","مثل ماللنحل مدلوله عسل",66,"ل",1,0],["للفقه فيه وللحديث معالم","وقراءة القرآن أزهر أنورا",67,"ر",2,0],["للفوز أجهزة تداول صرفها","بين الأنام على هدى أشكالها",68,"ل",3,1],["للفتى عندي مثال","جئت ألقيه ابتكارا",69,"ر",2,0],["للفنِّ لوحٌ عبرَ دورتها","والشِّعرُ بعضُ نشيدها العَذِبِ",70,"ب",1,0],["للفوز أهل وللألقاب فارسها","وللخسارة أمر ليس يعنينا",71,"ن",2,0],["للفَيلسوفِ الفَذِّ \"عَبدالرازق\"","فَضْلُ ارتقِاءَ الفِكرِ إِثرَ خَواء",72,"ا",2,0],["للفقر للعجز المشين","لفقه أدلجة الصراع!!",73,"ع",1,0],["لِلْفَخْرِ جَرْحَاهُ تَلَذُّ بَض