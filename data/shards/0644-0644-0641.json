{"poems":[[93,"شارفت مصر وفيها كل ناضرة","https://www.aldiwan.net/poem11107.html","البسيط"],[51,"عيد يطابق أول الأسبوع","https://www.aldiwan.net/poem65060.html","الكامل"],[51,"أقول لما رأيت عرسي","https://www.aldiwan.net/poem66512.html","مخلع البسيط"],[89,"ما شاهدت عيني ممث","https://www.aldiwan.net/poem44910.html","مجزوء الكامل"],[45,"للفضل أخلاق يلقن بفضله","https://www.aldiwan.net/poem65547.html","الكامل"],[22,"شاقتك أظعان للي","https://www.aldiwan.net/poem21642.html","مجزوء الكامل"],[1,"أشجاك الربع أم قدمه","https://www.aldiwan.net/poem34014.html","المديد"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54588","الخفيف"],[110,"خفض عليك فما الفؤاد بسالي","https://www.aldiwan.net/poem16260.html","الكامل"],[212,"أكرموا مطران أو لا تكرموه","https://www.aldiwan.net/poem46305.html","الرمل"],[271,"حتام تعشق عاجا تحت ديباج","https://www.aldiwan.net/poem35179.html","البسيط"],[305,"أمن الموت أجزع","https://www.aldiwan.net/poem16760.html","مجزوء الخفيف"],[378,"بالعقل قد يحوي الفتى الإحياء","https://www.aldiwan.net/poem66965.html","الكامل"],[453,"للفيجة الغناء عين لم تزل","https://www.aldiwan.net/poem13741.html","الكامل"],[459,"نوازع الشوق والغليلِ","https://www.aldiwan.net/poem55990.html","مخلع البسيط"],[459,"أصب برأيي أصاب الحظ أو غلطا","https://www.aldiwan.net/poem56141.html","البسيط"],[515,"ضربوا القباب وطنبوها بالقنا","https://www.aldiwan.net/poem20802.html","الكامل"],[515,"سل ضاحك البرق يوما عن ثناياها","https://www.aldiwan.net/poem20830.html","البسيط"],[539,"السحر هذا ما أرى","https://www.aldiwan.net/poem48280.html","عموديه"],[560,"للفقر أهل فكن لهم تبعا","https://www.aldiwan.net/poem69346.html","المنسرح"],[568,"ألقي في حبك القناع","https://www.aldiwan.net/poem69611.html","مخلع البسيط"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["لِلْفَضْلِ فِي مِصْرَ أَعْلامٌ سَمَتْ وَصُوًى","وَإِنْ أَظْهَرَهَا فِيهَا صَوَايَاهَا",0,"ا",3,0],["للفألِ بالإقبال فيه شاهدٌ","عدلُ الشهادة ليس بالمدفوعِ",1,"ع",1,0],["للفال بُشرى بذاك عندي","ليست بزُورٍ ولا بميْن",2,"ن",1,0],["للفن ثم الفن ثم","مَ الفن فاطمة القديره",3,"ر",2,0],["لِلفَضلِ أَخلاقٌ يَلِقنَ بِفَضلِهِ","ما كانَ يَرغَبُ مِثلَها عَن مِثلِهِ",4,"ل",2,1],["لِلفَحلِ في آثارِها","زَجَلٌ يُخايِلُ أَو يُخاطِر",5,"ر",1,0],["لِلفَتى عَقلٌ يَعيشُ بِهِ","حَيثُ تَهدي ساقَهُ قَدَمُه",6,"م",2,0],["لِلْفِنُونِ ازْدِهَارُهَا وَالرَّزَايَا","غَافِلاَتٌ وَالأَمْنُ في اسْتِتْبَابِ",7,"ب",1,0],["لِلفَضل قَد غَرَسَت يَداهُ مَغارِساً","فَجَنى بِها ثَمَري عَلاً وَمَعالي",8,"ل",2,0],["للفتى يبقى من المجد أخوه","وهو ما أصدر من وحي الذكاء",9,"ا",2,0],["للفأل كالشؤمِ إضرارٌ بصاحبهِ","فاملُك هواكَ لإفساحٍ وإحراج",10,"ج",1,0],["لِلفَضائِلِ كُلِّها","وَهوَ لِلكُلِّ يَشفَعُ",11,"ع",1,0],["للفضل يُعزَى كلُّ خِرقٍ سؤددٍ","والعدل يطوي نشرُه الأعداء",12,"ا",2,0],["للفيجة الغناء عين لم تزل","فيها تطاردنا المنى ونطارد",13,"د",1,1],["للفِقَر المشكلاتِ منه","عارضةُ البارقِ الهطولِ",14,"ل",1,0],["للفرس والعُرب من شأنيهما شرفٌ","يردُّ خزياً على أعقابها النَّبطَا",15,"ط",2,0],["للفخرِ جَرْحاهُ تلَذُّ بضَرْبه","والبُرُّ يُرضي الجُرْبَ في ألَم الهَنا",16,"ن",2,0],["للفاضلينَ سُجودٌ حين يُمسِكُها","كأنّ سرَّ العصا فيها فألقاها",17,"ا",3,0],["لِلفخرِ حين يُذكَرُ","العلمَ فَالعِلمَ أطلُبِ",18,"ب",1,0],["للِفقرِ أهلٌ فَكُن لهمْ تبعَا","واعملْ على حبّهم وخِدمِتهمْ",19,"م",1,1],["لِلْفَهْمِ فِي لَحْظِهِ اتِّقَادٌ","لِلْعِلْمِ فِي لَفْظِهِ التِمَاعُ",20,"ع",1,0],["للفصل فيما بيننا قال لقد","أنساكم الشيطان ما قد انعقد",21,"د",1,0]]}