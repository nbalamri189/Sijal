{"poems":[[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87833","الخفيف"],[4858,"إيهِ يا صاحِ","https://www.poetsgate.com/ViewPoem.aspx?id=138205",""],[6229,"مرة في الزمان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65207&r=&rc=31",""],[6318,"مهرجان القصيد (1)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66156&r=&rc=6",""]],"verses":[["سَمَّمَت نَفسَكِ الشُرورُ فَأَضحَت","لَم تُؤَثِّر لِلخَيرِ فيها وَسيلَه",0,"ل",2,0],["سمِّ مَن شئتَ تجدْهُ بطلاً","راسخَ الإيمانِ عبداً للغفور",1,"ر",1,0],["سَمّ ما شئتَ صُنْعَنا في الرباطِ","قِمّةٌ سيلُها يعمّ الشواطي",2,"ط",2,1],["سَمِّ مَا شِئْت مِنْ مِثالٍ فَهَذا","أَدَبُ الضَّائع الشَقيِّ الجَحُودِ",3,"د",1,0]]}