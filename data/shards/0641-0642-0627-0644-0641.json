{"poems":[[57,"إذا لمت عيني اللتين أضرتا","https://www.aldiwan.net/poem26484.html","الطويل"],[87,"بغل أتى الجواد ذات مره","https://www.aldiwan.net/poem8004.html","الرجز"],[47,"ومستضحك من عبرتي وبكائي","https://www.aldiwan.net/poem10209.html","الطويل"],[35,"ألا أيها القلب اللجوج المعذل","https://www.aldiwan.net/poem25851.html","الطويل"],[107,"كذلك يشقى الجامح المتعسف","https://www.aldiwan.net/poem44190.html","الطويل"],[50,"وخمار أنخت إليه رحلي","https://www.aldiwan.net/poem62483.html","البسيط"],[50,"مجون صب في صنم","https://www.aldiwan.net/poem66283.html","مجزوء الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85546","البسيط"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30462","الطويل"],[108,"الكبش والقصاب","https://www.poetsgate.com/ViewPoem.aspx?id=179575",""],[82,"انظرهما في الظلام قد نجما","https://www.poetsgate.com/ViewPoem.aspx?id=3715",""],[95,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[154,"وأدور مياس العواطف أصبحت","https://www.aldiwan.net/poem68448.html","الطويل"],[308,"عاتبت من سد سمعي صوت فقحته","https://www.aldiwan.net/poem57600.html","البسيط"],[354,"أقبل صبحي وسفر","https://www.aldiwan.net/poem15721.html","مجزوء الرجز"],[369,"ألم صبحا وجمر الحلي قد بردا","https://www.aldiwan.net/poem60940.html","البسيط"],[398,"وشادن ذي غنج","https://www.aldiwan.net/poem53451.html","مجزوء الرجز"],[484,"الموت درس وعزرائيل ملقيه","https://www.aldiwan.net/poem36869.html","البسيط"],[487,"أقول لأقوام رمونا بأسهم العقول","https://www.aldiwan.net/poem24466.html","عموديه"],[521,"ألا يا عقاب الوكر وكر ضرية","https://www.aldiwan.net/poem48672.html","الطويل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[578,"حذار حذار من ركون إلى الزمن","https://www.aldiwan.net/poem3640.html","الطويل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66632","الرجز"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66746","الطويل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110486","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38508","المنسرح"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59192","المجتث"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64767","المجتث"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46512","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46525","الرجز"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137914",""],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79969","البسيط"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128023","الطويل"],[1724,"","https://poetry.dctabudhabi.ae/diwan/poem/144783","الطويل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104770","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27323","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27432","السريع"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137518",""],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109878","السريع"],[3296,"","https://poetry.dctabudhabi.ae/diwan/poem/105628","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205505","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111520","الطويل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127229","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83521","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83199","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58079","الطويل"],[4534,"","https://poetry.dctabudhabi.ae/diwan/poem/145396","الوافر"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35141","الوافر"]],"verses":[["فَقالَ فُؤادي عَنكِ لَو تُرِكَ القَطا","لَنامَ وَما باتَ القَطا يَخرُقُ السُهبا",0,"ب",2,0],["فَقالَ فَضلي قَد بَدا يا خِلّي","وَآنَ أَن تَعرِفَ لي مَحَلّي",1,"ي",1,0],["فَقالَ فَمَن أَبكاكَ إِن كُنتَ صادِقاً","فَقُلتُ الَّذي أَهوى فَقالَ سَوائي",2,"ا",3,0],["فَقالَ فُؤادي ما اِجتَرَرتُ مَلامَةَ","إِلَيكَ وَلَكِن أَنتَ بِاللَومِ تَعجَلُ",3,"ل",1,0],["فقال فعلنا ثم عادَ شَفِيعُه","يُبَشِّرُه بالعفوِ والشيخُ يَرجُفُ",4,"ف",1,0],["فَقالَ فَإِنَّ عِندي بِنتَ عَشرٍ","فَقُلتُ لَهُ مَقالَةَ مَن يُناجي",5,"ج",2,0],["فقال فعلتَها قد كن","تَ عندي غيرَ متهم",6,"م",1,0],["فقال في وصفها شعري يؤرخها","تحرر الناس من أسر وأحواج",7,"ج",1,0],["فقالَ فَرِيقٌ لَيْسَ ذا الشِّعْرُ شِعْرَهُ","وَقالَ فَرِيقٌ أَيْمُنُ اللَّهِ ما نَدْرِي",8,"ر",2,0],["فقال في نفسه القصَّابُ مبتسمًا:","يا كبش أنت رقيقُ القلب، طيبِّه",9,"ب",2,0],["فقال: فابتزه الدهر نور واحدة","فقلت: وهل نجا من صروفه أحد",10,"د",1,0],["فَقَالَ فَتىً ما لِلْمَلِيحَةِ تخْجَلُ","وَحَيْثُ تَكُنْ تَنْزِلْ عَلَى الرُّحْبِ وَالسَّهْلِ",11,"ل",1,0],["فقال فريق سحر بابل عنده","وقال فريق ليس هذا من الإِنس",12,"س",1,0],["فقال فوق ضراطي كلما سنحت","أنام ملء جفوني عن شواردها",13,"ه",2,0],["فَقالَ فَسِّرهُ لَنا","فَنَجمُهُ فيكَ زَهَر",14,"ر",1,0],["فقال في ليلِ أصداغي خَفِيتُ سُرىً","فكان مَن هَبَّ بالوادي كَمنْ هَجَرا",15,"ر",2,0],["فَقالَ فيمَن وَلِمَن","فَقُلتُ هذا فيكَ لي",16,"ل",2,0],["فقال في ذاك مأسوفا مؤرخا","رزم أبيك تلاه اليوم ثانيه",17,"ي",2,0],["فقال فهل مسترشد يتبعكم","فأقبس مشكاة على نعت سائل",18,"ل",1,0],["فَقالَ فَريق القَوم لما نَشَدتهم","نِعم وَفَريق ليمن اللَهُ لا نَدري",19,"ر",2,0],["فقال في غير مقام البغتة","في مهل يا قوم كانت فلتة",20,"ه",1,0],["فقال فيما قال قد وليتكم","ولست إذ وليتكم بخيركم",20,"م",1,0],["فقال فيما وصفوه في الخبر","لولا علي لهلكت يا عمر",20,"ر",1,0],["فقال في ذلك لابن هند","فلج في المنع وفي التعدي",20,"ي",1,0],["فقال فيه إنه الإله","جل الذي ليس لنا سواه",20,"ه",1,0],["فَقالَ فُؤادي هَل أَذوبُ مِنَ الأَسى","فَقُلتُ تَعَجَّل لا أَبا لَكَ وَاِفعَلَن",21,"ن",1,0],["فقال في الذَّكرِ وما","كانَ حديثاً يُفتَرى",22,"ا",1,0],["فقال فمن قد كنتُ مولاه منكمُ","فهذا له مَولىً يُطاعُ ويُسمَعُ",23,"ع",1,0],["فقالَ فيها لسان الحالِ لا عَجبٌ","يا أُختض خيرِ أَخٍ يا بنتَ خيرِ اَبِ",24,"ب",1,0],["فَقالَ فَضلٌ عَليَّ صارَ لَهُ","أَما تَرى فَضلَهُ عَلى راسي",25,"ي",1,0],["فَقَالَ فَرْقِي هِلاَلٌ","قُلْنَا هِلاَلٌ سَعِيدُ",26,"د",1,0],["فقالَ فيضُ دُمُوعٍ","تلْتَذُّهُنَّ الْتِذاذَا",27,"ذ",2,0],["فَقالَ فيها صفرة تَبين","وثمَّ تضريس لَها يَشين",28,"ن",1,0],["فَقالَ في الحال لَهُ الحجام","لي حاجة يا أَيُّها الهمام",29,"م",1,0],["فقال فيها لسان الحال لا عجب","يا اخت خير اخ يا بنت خيراب",30,"ب",1,0],["فقال في رأيه والسيفُ يُجمعُ من","أطراف مملكة الإِسلام ما انتشرا",31,"ر",2,0],["فقال فَمُنَّ بالنعلين إني","رميضٌ قال لستم تحتذونا",32,"ن",2,0],["فقال فلان صاحبى فتنهدت","وقالت أيا روحى تعيش وتسلم",33,"م",1,0],["فقال فلا تضجر وإن كنت باردا","فإن ثمار الأرض فضل سحائبي",34,"ا",3,0],["فَقالَ فَما تَخشى فَما ذَاكَ شأنُنا","فَقُلتُ نَعم وَاللهِ يا مُنيَةَ النَّفسِ",35,"س",1,0],["فقال فكم من طائف ما نال إلا","فقال الهاتف ملاحظة من الحورِ الحِسان",36,"ن",1,0],["فقال فيه واتّقوا فتنة","وتمم القولَ به منظرا",37,"ر",2,0],["فقال فلان صاحبي فتنهدت","وكادت تذيق السر لولا التبسم",38,"م",1,0],["فقال في تاريخه منشداً","فؤادنا من ثمرات الفؤَاد",39,"د",1,0],["فقال فتى قضى قبلي ضياعا","أضاعوني وأي فتى أضاعوا",40,"ع",3,0],["فقال في لثغةِ الطفلِ البريء وفي","صراحة الطِّفل قولًا بيِّن الخطَلِ",41,"ل",1,0],["فَقالَ فيلا لِأَخيلَ يا اِبني","بَرِّز عَلى الأَقرانِ يَومَ الطَعنِ",42,"ن",1,0],["فَقالَ فَطرُقلُ سَرى الوَبالُ","وَيلاهُ ما الحيلَةُ وَالمآلُ",42,"ل",1,0],["فقال فريام يعلوه الجلال أجل","بني غير مقال الحق لم تقل",43,"ل",1,0],["فقال فريام إما كنت منتسباً","إلى ابن آياك فاصدقني بلا مهل",43,"ل",1,0],["فقال فنجانه من تحت قهوته","لي أسوة انحاط الشمس عن زحل",44,"ل",1,0],["فَقالَ فيكَ رَسول اللَهِ مُبتَهِجاً","لَو كانَ بعدي نبيٌّ كانَ ثمّ عُمَر",45,"ر",1,0],["فَقالَ فَاستُرها وَكُن لِي غافِرا","لَيسَ الكَريمُ لِلمُساوي ناشِرا",46,"ر",2,0],["فقال فلا تترك إلهكَ طَرْفَةً","نهاراً ونَمْ ليلاً فذا قِيلَ أنفعُ",47,"ع",1,0],["فقال فتى من الندماء صفه","فقلت الليل أقبل بالنجوم",48,"م",1,0],["فَقالَ فَتىً مِنَ الفِتيانِ صِفهُ","فَقُلتُ اللَيلُ أَقبَلَ بِالنُجومِ",49,"م",1,0]]}