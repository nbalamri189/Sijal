{"poems":[[91,"أحمد كان مثل بحر رحيب","https://www.aldiwan.net/poem44619.html","الخفيف"],[60,"عد من نفسك الحياة فصنها","https://www.aldiwan.net/poem30837.html","الخفيف"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16683","الخفيف"],[92,"الريف الضاحك","https://www.poetsgate.com/ViewPoem.aspx?id=179018",""],[189,"لا غرو أن رحل الشباب وبانا","https://www.aldiwan.net/poem14688.html","الكامل"],[287,"وأهيف القد بالقلوب هفا","https://www.aldiwan.net/poem32705.html","المنسرح"],[310,"عظم الأجر عن عظيم المصاب","https://www.aldiwan.net/poem56609.html","الكامل"],[348,"إنما جاري لعمري","https://www.aldiwan.net/poem24177.html","مجزوء الرمل"],[391,"ذاد عنى النوم هم بعد هم","https://www.aldiwan.net/poem1843.html","الرمل"],[438,"طار عن برقة برق فشم","https://www.aldiwan.net/poem12350.html","الرمل"],[473,"أيهذا الصديق لا عتب إن لم","https://www.aldiwan.net/poem60241.html","الخفيف"],[563,"كن غنيا في صورة الفقراء","https://www.aldiwan.net/poem35079.html","الخفيف"],[794,"","https://poetry.dctabudhabi.ae/diwan/poem/101203","الرمل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62453","الرمل"],[1185,"","https://poetry.dctabudhabi.ae/diwan/poem/75730","الرمل"],[1479,"","https://poetry.dctabudhabi.ae/diwan/poem/20575","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48924","الخفيف"],[2348,"","https://poetry.dctabudhabi.ae/diwan/poem/203446","الرمل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48374","الخفيف"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126914","الخفيف"],[3537,"","https://poetry.dctabudhabi.ae/diwan/poem/26997","الرمل"],[3561,"","https://poetry.dctabudhabi.ae/diwan/poem/32383","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128905","الخفيف"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113835","الرمل"],[4727,"وگم أؤمل","https://www.poetsgate.com/ViewPoem.aspx?id=214038",""],[4797,"يا قو قبك","https://www.poetsgate.com/ViewPoem.aspx?id=29426",""],[5525,"هام القصايد","https://www.poetsgate.com/ViewPoem.aspx?id=30108",""],[391,"لا تَقُولن إذا ما لم تُرِدْ","https://www.poetsgate.com/ViewPoem.aspx?id=22522",""]],"verses":[["انما جاءت الوفود ترامى","لتحييك ركعا وقياما",0,"م",2,0],["إِنَّما جِئتَها لِتَستَقبِلَ المَو","تَ وَأُدخلتُها لِتَخرُجَ عَنها",1,"ن",3,0],["إنما جارَتايَ جارِيَتا حَي","يٍ وما زالتِ النّساءُ كَثيرا",2,"ر",2,0],["إنما جلَّلها الثلجُ الذي","غُمِرتْ منه جبالٌ وكهوف",3,"ف",1,0],["إنْ ماج أسفُله حَقَرْتَ له النَّقا","أو ماس أعلاه حَقَرْتَ البانا",4,"ن",2,0],["إِن ماجَ رَدَّ القَضيبَ مُنخَذِلاً","أَو لاحَ راحَ الهِلالُ مُنخَسِفا",5,"ف",2,0],["إنّما جِسمها ثيابٌ نَضتها","لَم تُمتّع بطولِ لبس الثيابِ",6,"ب",1,0],["إِنَّما جاري لَعَمري","فَاِعلَموا أَدنى عِيالي",7,"ل",2,1],["إِنَّما جادَ بِشَأسٍ خالِدٌ","بَعدَما حاقَت بِهِ إِحدى العِظَم",8,"م",1,0],["إنما جَسَّر أَلْحَاظَ المَهَا","أَنها تُتْلِفُ ما لَمْ تَغْرَمِ",9,"م",1,0],["إِنَّما جِئتُ أَطرُقُ البابَ لَمّا","كانَ عَهدي بِهِ بِلا تَنكيدِ",10,"د",1,0],["إنما جاههم توهُّم عزٍّ","في هوان وشهرة في خفاء",11,"ا",2,0],["إنما جعدك ليل","وبه البدر استنارا",12,"ر",2,0],["إنما جودك غيث","والرعايا كالنباتِ",13,"ت",1,0],["انما جاء مَقولي ترجماناً","عَن لسان الوَرى انيب منابه",14,"ب",2,0],["إِنَّ ما جِئنا بِهِ حَقُ صِدقٍ","ساطِعٌ نورُهُ مُضِيءٌ مُنيرُ",15,"ر",1,0],["إنما جهلهُا أساسُ شقاها","إنما الجهلُ في الحياة شقاء",16,"ا",2,0],["إنما جاءَ رقيبٌ بينَنَا","فاجتمعنا باختلاف الجهتين",17,"ن",1,0],["إنما جنّةُ العريفِ عَروسٌ","وأنا تاجُها الرّفيعُ المُحَلّا",18,"ل",2,0],["انما جودكم على الناس طرا","كان لطفا ولم يكن عن جزاء",19,"ا",2,0],["إِنَّما جاءَت بِمُهرٍ","واحِدٍ وَهوَ وَخيمُ",20,"م",1,0],["إِنَّما جِئتُ هارِباً مِن ذُنوبٍ","عَدَدَ القِطفِ لا تُريدُ اِنقِلاعا",21,"ع",2,0],["انما جدك الذي قد جنى ذا","وستجنى كذا على أولادك",22,"ك",1,0],["إنما جيران طه المجتبي","في حمى اللَه ومختار الرسل",23,"ل",1,0],["گأنّما جُعِلُوا في بَطْنِ نَاذِرةٍ","مِن فاجِرٍ أوَلٍ لِلْفاجِرِ الثَّاني",24,"ي",1,0],["ان ما جبرك الغلا ما اقدر على جبرك","ياللي على ارض الوفا ما شبرك بشبري",25,"ر",2,0],["أن ما جمعت النور من كل وقاد","وطوقت بنجوم المجرة بناني",26,"ن",2,1],["إنما جاد بِشَأْسٍ خالدٌ","بعد ما حاقت به إحدى الظُّلَمْ",27,"م",1,0]]}