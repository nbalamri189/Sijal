"https://poetry.dctabudhabi.ae/diwan/poem/54217","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54327","المنسرح"],[36,"قتل ابن عفان الإما م","https://www.poetsgate.com/ViewPoem.aspx?id=15896",""],[106,"مبايعة الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179496",""],[106,"عصبة الأمم","https://www.poetsgate.com/ViewPoem.aspx?id=179423",""],[77,"فتحت سعودك كل باب مبهم","https://www.poetsgate.com/ViewPoem.aspx?id=34204",""],[100,"ليلة خائف","https://www.poetsgate.com/ViewPoem.aspx?id=50433",""],[90,"الأوباش","https://www.poetsgate.com/ViewPoem.aspx?id=179102",""],[90,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=179239",""],[47,"وما أنسَ لا أنسَ يومَ المغارِ","https://www.poetsgate.com/ViewPoem.aspx?id=14646",""],[51,"أما الزمانُ إلى سلمى فقد جَنَحا","https://www.poetsgate.com/ViewPoem.aspx?id=27419",""],[51,"تركْنا لكُمْ دنياكُمُ وتخاضَعَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=28466",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[3,"جازتْ ملماتُ الزَّمانِ حدودها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10679&r=&rc=33",""]],"verses":[["فَاِنهَض بِها إِنَّكَ مِن مَعشَرٍ","إِن جُشِّموا الأَمرَ أَبانوا الغِنى",0,"ن",2,0],["فَاِنهَض بِهِ في النائِباتِ تَجَد","عَضباً تَساقَطُ دونَهُ القُلَلُ",1,"ل",1,0],["فَاِنهَض لَها إِنَّها الغُلامُ تَجِد","حَبلاً ضَنيناً بِكَفِّ مَن عَلِقا",2,"ق",2,0],["فَإِن هَزَّ يَوماً فَرعَ مُلكِكَ حاسِدٌ","فَإِنَّ المَعالي مُحكَماتُ الأَواصِرِ",3,"ر",1,0],["فَاِنهَض فَلَو رُمتَ لَحاقَ العُلى","صافَحتَ أَيدي الأَنجُمِ الزُهرِ",4,"ر",1,0],["فَاِنهَض لِأَخذِ الثَأرِ غَيرَ مُقَسِّرٍ","حَتّى تُبيدَ مِنَ العِداةِ عَديدَها",5,"د",3,0],["فَانْهَدْ بِسَعْدِكَ قَبْلَ جُنْدِكَ لِلْعِدَى","وَابْعَثْ بِرُعْبِكَ قَبْلَ جَيْشِكَ تَهْزِمِ",6,"م",1,0],["فَاِنهَي خَيالَكِ أَن يَزورَ فَإِنَّهُ","في كُلِّ مَنزِلَةٍ يَعودُ وِسادي",7,"د",2,0],["فَإِن هَمَّ سُراةُ النيلِ أَن يَقِفوا","عَلى القُبورِ وَإِن لَم تَحوِ إِنسانا",8,"ن",2,0],["فَاِنهَض وَدَع شَكوى الزَمانِ وَلا تَنُح","في فادِحِ البُؤسى مَعَ الأَنواحِ",9,"ح",1,0],["فَاِنهَض إِلى شربِ المُدا","مِ وَلا تُطِع في الراحِ لائِم",10,"م",1,0],["فانْهَضْ وَنَبِّئْنَا الصَّوَابَ وَقُلْ لَنَا","قَوْلاً يُبَصِّرُ بِالْعَوَاقِبِ مَنْ عَمِي",11,"م",2,0],["فَإِن هَمَمتَ بِهِ فَاِفتِك بِخُبزَتِهِ","فَإِنَّ مَوقِعَها مِن لَحمِهِ وَدَمِهِ",12,"م",2,0],["فإنه بات حليف السهر","مذ نزح الورد عن المنزل",13,"ل",1,0],["فإن هذي ليلةٌ حاليه","تزهو ببدرين وطلق النسيم",14,"م",1,0],["فانهضوا اليوم مستجدّين مجداً","كالذي كان دونه القمران",15,"ن",1,0],["فَاِنهَ الفَرَزدَقَ أَن يَعيبَ فَوارِساً","حَمَلوا أَباهُ عَلى أَزَبَّ نَفورِ",16,"ر",1,0],["فَإن هِيَ لَم تَصلُح لِحَي سِوَاهُمُ","فَإِن ذَوِي القُربَى أحَقُّ وأقرَبُ",17,"ب",1,0],["فإنَّهم للنَّاس فيما يَنُوبُهم","غُيُوثُ حَياً يَنفِي به المَحلُ مُمحِلُ",18,"ل",1,0],["فَإِن هُنَّ يا اِبنَ السَراةِ الكِرامِ","رَدَدنَ القُلوبَ رَدَدنا النَهَب",19,"ب",1,0],["فَإِنَّهُم أَفضَلُ الأَحياءِ كُلِّهِمِ","إِن جَدَّ بِالناسِ جِدُّ القَولِ أَو شَمِعوا",20,"ع",3,0],["فإنها بالخصام نارٌ","وقودها الناسُ والحجارة",21,"ه",1,0],["فإنها تُذعن في لحظةٍ","مهتزّةً للنيك مرتاحَهْ",22,"ح",2,0],["فإن هي زالت عنكُمُ فزوالُها","يُجدِّدُ إنعاماً على كل ماجدِ",23,"د",1,0],["فإن هم عُذروا بالجهل صاحبها","فليس في رفض أعمى القلبِ مؤتمر",24,"ر",1,0],["فإن هو أدى بعض حقك فارضه","فليس بمغبونٍ أخٌ متجاوز",25,"ز",1,0],["فإن هو بيع من أمَمٍ عليه","وإلا فالإباقُ له شفيعُ",26,"ع",1,0],["فإن هاجتِ الهيجاءُ أو عادَ عودُها","على بدئها لم يُلقَ منِّيَ أعزلُ",27,"ل",1,0],["فإن هجاءَ المرءِ بالفعلِ نفسَهْ","هو الشيء يبقي والمقولُ هو البالي",28,"ل",2,0],["فإنْ هو لم يحفلْ بنقمي ونعمتي","فعندي له عَوْدُ المتمِّ المكمّلِ",29,"ل",1,0],["فإن هاجه هيجٌ من العذلِ أصبحتْ","فرائضهُ مشفوعةً بنوافلِ",30,"ل",1,0],["فإنْ هي كانتْ مُلْهَماتٍ رشادها","على جَهْلها فليعترف للمُخاصمِ",31,"م",1,0],["فَإِن هَنَّأوكَ بِما نِلتَهُ","فَإِنّي أُهَنّي بِكَ المَنصِبا",32,"ب",2,0],["فَإِن هِيَ قالَت لا سَبيلَ فَقُل لَها","عَناءٌ عَلى العُذرِيُّ مِنكِ طَويلُ",33,"ل",1,0],["فان هلكت فمالي عنه منصرف","وان بقيت فمالي عنه سلوان",34,"ن",1,0],["فإنها مُصلِحة","للمعد المرتبكه",35,"ك",2,0],["فَإِنَّهُ كانَ بِأَقصى السَطحِ","فَاِشتاقَ مِن خِفَّتِهِ لِلمَزحِ",36,"ح",1,0],["فَإِن هَمَسوا بَعدَ جَهرٍ بِها","فَخَفقُ الحُلِيِّ عَلى الغانِيَه",37,"ي",2,0],["فَإِن هَمَمتَ فَاِذكُرِ ال","مَقادِرَ المُقَدَّرَه",38,"ر",2,0],["فَإِن هابوا بِجُرمِهِمِ عَلِيّاً","فَقَد يَرجو عَلِيّاً مَن يَهابُ",39,"ب",1,0],["فَإِنَّهُ حُجَّةٌ يُؤذي القُلوبَ بِها","مِن دينُهُ الدَهرُ وَالتَعطيلُ وَالقِدَمُ",40,"م",1,0],["فانهضْ لها بالعزم تكنفُه الظُبَى","والسابغيّةُ نسجُها موضونُ",41,"ن",1,0],["فَإِن هَمَّ أَهلُ الغَورِ يَوماً بِعَودَةٍ","إِلى الغَيِّ مِن طُغيانِهِم فَهوَ بِالقُربِ",42,"ب",1,0],["فَإِن هِيَ لَم تَقنَع بِمَكروهِ ما مَضى","عَلَيها فَعِندَ المُرهَفاتِ مَزيدُها",43,"د",3,0],["فَإِنَّهُمُ وَإِنّا حَيثُ نَغدو","وَإِن كانَت تُدَبِّرُنا العُقولُ",44,"ل",1,0],["فَإِنَّهُمُ الأَحلافُ وَالغَيثُ مَرَّةً","يَكونُ بِشَرقٍ مِن بِلادٍ وَمِن غَربِ",45,"ب",1,0],["فَإِنَّهُما إِن يَظلِماكَ فَفيهِما","نَكالٌ لِعُريانِ العَذابِ عَصَبصَبُ",46,"ب",1,0],["فَإِنَّ هَجينَي نَهشَلٍ قَد تَواكَلا","وَبَيَّنَ ضاحي البُرءِ غَيرُ كَذوبِ",47,"ب",1,0],["فَإِنَّ هِشاماً إِن تُلاقيهِ سالِماً","تَكوني كَمَن بِالغَيثِ يَنصُرُ جانِبُه",48,"ب",2,0],["فَإِن هُم أَبَوا أَن يَقبَلوهُ وَلَم تَجِد","فِراقاً لَهُ إِلّا الَّذي رُمتَ فَاِفعَلِ",49,"ل",1,0],["فإنَّها نَشوةٌ وَلَّتْ عُذوبتُها","وخَرَّ ذو التَّاجِ عنها وهو مخمورُ",50,"ر",1,0],["فَإِنَّهُ يَدُقُّكُم دَقَّ الطَحن","وَلا يَخافُ في الهياجِ مَن وَمَن",51,"ن",1,0],["فَإِنَّهُ إِن أَسَأتَ صُحبَتَهُ","أَعدى أَعاديكَ إِذ تُفارِقُه",52,"ه",1,0],["فَإِنَّهُ كَاللَيثِ يُخفي الشَرَسا","حَتّى إِذا ريعَ حِماهُ اِفتَرَسا",53,"س",2,0],["فَإِنَّ هَذا الصُدودَ قَصدٌ","وَإِنَّ ذاكَ الوَدادَ زورُ",54,"ر",1,0],["فَإِنَّها إِذا رَأَتكَ مُقبِلاً","مادَت وَخَرَّ السورُ لِاِضطِرابِهِ",55,"ب",2,0],["فإنهُمْ يتّقونَ البَطْشَ مِنْ مَلِكٍ","مُنَفّذٍ أمْرَهُ كاللَّمحِ بالبصرِ",56,"ر",1,0],["فإنّها بالسّحرِ ممزوجَةٌ","أمَا تَرَاها أسكَرَتْ كلّ صاح",57,"ح",1,0],["فإنّهُ مُسْتَرْجِعٌ هِبَاتِهِ","وباخلٌ مِن الصِّبا بما سَمَح",58,"ح",1,0],["فَإِن هَمَمتَ بِهِ فَاِفتُك بِخُبرَتِهِ","فَإِن مَوقِعَها مِن لَحمِهِ وَدَمِه",59,"م",2,0],["فَاِنهَض وَإِن خِلتَ الشِتاءَ مُصَمِّماً","حَزنَ الخَليفَةِ جامِحاً في المِسحَلِ",60,"ل",1,0],["فَاِنهَلَّ في أَسطُرِهِ أَسطُرٌ","لِلدَمعِ سَطرٌ فَوقَهُ سَطرُ",61,"ر",1,0],["فانهضْ إلى فيءِ الدوالي بنا","نشاهدِ الأزرقَ في الأزرقِ",62,"ق",1,0],["فإنهمْ عنْ سبيل الصدقِ قد عَرَجوا","فاعذرْ فليسَ على العرجانِ مِنْ حرجِ",63,"ج",1,0],["فَاِنهَلَّ دَمعي في الرِداءِ صَبابَةً","فَسَتَرتُهُ بِالبُردِ دونَ صِحابي",64,"ي",1,0],["فَاِنهَض أَبا عَبدِ الإِلَهِ بِآمِلٍ","قَد جابَ دونَكَ كُلَّ خَرقٍ طامِسِ",65,"س",1,0],["فاِنهَض بِجِدِّكَ في حَسمِ الضَلالِ كَما","دَبَّ السَنا في الدُجى وَالبَرءُ في سَقَمِ",66,"م",1,0],["فَإِنَّ هَذا خُلُقُ الزَمانِ","فَإِنَّ هَذا خُلُقُ الزَمانِ",67,"ن",1,0],["فَإِنَّهُ في حَلقِهِ","طَعمُ شَجاً يُرَدِّدُه",68,"د",2,0],["فإِنَّهَا الرُّسْلُ وَالأَمْلاكُ شافِعُها","لِوُصْلةٍ منه تَسآلٌ وَتَطْفِيلُ",69,"ل",1,0],["فإنَّه شّمْسُ فَضْلٍ هُمْ كَواكِبُها","يُظْهِرْنَ أَنْوَارَها للناسِ في الظُّلَمِ",70,"م",1,0],["فانهَض بأعْباءِ الخِلافَةِ كلِّهَا","إنّ المُحَمَّلَهُنَّ عَودٌ بازل",71,"ل",1,0],["فإنْ هَزّ أسيافَ الهِرَقْلِ فإنّهَا","إذا شِئْتَ أغلالٌ له وقيودُ",72,"د",1,0],["فَإِن هُمُ لِلِقائي بَعدَها رَجَعوا","أَرَيتُهُم مَرَّةً أُخرى مَنِ الراسي",73,"س",2,0],["فإن هو جفّ لم ينفك","كَ في برّ ولا بحرِ",74,"ر",1,0],["فإنّها أعشقُ بغّياةً","لهذه المغصوبةِ النيّهِ",75,"ي",2,0],["فَاِنهَض بِجَدٍّ أَو أَقِم مُتَنَظِّراً","سَيبَ الإِلهِ فَإِنَّهُ مَقدورُ",76,"ر",1,0],["فَإِنَّهُ وَلَدٌ بَرٌّ بِوالِدِهِ","وَالبَرُّ يُخلَقُ مِنهُ الطُرفُ وَالتَلُدُ",77,"د",1,0],["فَإِن هَلَكَت خُروسُكِ أُمَّ لَيلى","فَما أَنا مِن صِحابِكِ وَاللُمّاتِ",78,"ت",1,0],["فَإِن هِيَ قالَت ما عَلِمتُ فَرُبُّها","مِنَ المَوتِ يُعطيها لِأَدوائِها حَسما",79,"م",2,0],["فَإِن هِيَ لَم تُجِبهُ إِلى قَبيحٍ",