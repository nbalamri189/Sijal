{"poems":[[29,"عرفت منازلاً بلوى الثماني","https://www.aldiwan.net/poem4450.html","الوافر"],[87,"لقد لبى زعيمكم النداء","https://www.aldiwan.net/poem62929.html","الوافر"],[71,"بني عمنا لا عدمناكم","https://www.aldiwan.net/poem28948.html","المتقارب"],[48,"لقد دجى الزمان فلا تدجوا","https://www.aldiwan.net/poem22246.html","الوافر"],[266,"عدوك مقتول بسيء فعله","https://www.aldiwan.net/poem38146.html","الطويل"],[556,"من على هذه الديار أقاما","https://www.aldiwan.net/poem47232.html","الخفيف"],[567,"عجب نراه فسبحوا من أبدعا","https://www.aldiwan.net/poem52756.html","الكامل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110388","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119981","الخفيف"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133824","الخفيف"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137846",""],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66311","الرجز"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69315","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48319","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216364","المتقارب"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127125","الطويل"],[4728,"عجبنا كيف نامن لدنيانا","https://www.poetsgate.com/ViewPoem.aspx?id=176868",""]],"verses":[["عَجِبنا يا بَني عُدَسِ بنِ زَيدٍ","لِبِسطامٍ شَبيهِ عَفَرَّزانِ",0,"ن",1,0],["عَجِبنا كَيفَ لَم يَخضَرَّ عوداً","وَقَد حَمَلَ المُروءَةَ والرُفاءَ",1,"ا",2,0],["عجبْنا لقلةِ إنصافكم","كبرتُمْ بنا فكبرتم علينا",2,"ن",2,0],["عَجِبنا لِلرَكائِبِ مُبرَياتٍ","يَسيلُ بِهِنَّ بَعدَ الفَجِّ فَجُّ",3,"ج",1,0],["عجبنا لهذا الدهر جاد على الورى","بمثلك مع شح الزمان وبخله",4,"ل",2,0],["عُجْ بنا نندبُ الّذين تولَّوْا","باِقتِيادِ المنونِ عاماً فعاما",5,"م",2,0],["عَجَبٌ نَراهُ فسَبِّحوا من أبدَعا","قد أشرَقَ القَمَرانِ في وَقتٍ مَعَا",6,"ع",2,1],["عجبنا للشهابِ يحلُّ أَرضاً","وكيفَ الشهبُ تحجبها اللحود",7,"د",1,0],["عج بنجد نحيِّي دار الرباب","جادها واكف ملثُّ الربابِ",8,"ب",1,1],["عج بنا تنتش النفوس بنصرين","لنا في العلى غداة اللقاء",9,"ا",2,0],["عجبنا له اذ حل في الأرض مثلنا","ومن افقها قد ظل يبدي لنا الشهما",10,"م",2,0],["عج بنادي كان لي قمر","وأنت قد كنت مطالعه",11,"ع",2,0],["عَجِبنا لَهُ أَن تَقبِضَ السَيف كَفُّهُ","وَأَكثَرُ شَيءٍ عُوِّدَت كَفُّهُ البَسطُ",12,"ط",1,0],["عجِبْنا لمَن ناواكَ يبْغي تعَزُّزاً","ولمْ يُلْفَ من قَيْدِ المَذلّةِ مُطْلَقا",13,"ق",2,0],["عجبنا زمانًا لهذي الحروبْ","وما في الحروب لعمري عجيبْ",14,"ب",1,1],["عجبنا له إذ كان ذا هيبة لها","تذوب الجبال الصم وهو أخو البشر",15,"ر",1,0],["عجبنا عجبنا كيف نأمن لدنيانا","وهي لو تضحّكنا دقيقة .. تبكّينا",16,"ن",2,1]]}