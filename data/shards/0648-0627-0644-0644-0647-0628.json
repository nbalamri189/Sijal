{"poems":[[79,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[53,"ما أستزيد لقاسم من ربه غير البقاء","https://www.aldiwan.net/poem7960.html","مجزوء الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39682","المنسرح"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[201,"جاء الربيع وأنت راقد","https://www.aldiwan.net/poem39867.html","مجزوء الكامل"],[447,"هذي المنازل ها هيه","https://www.aldiwan.net/poem14399.html","مجزوء الكامل"],[534,"طمعتم يا ويحكم معشرا","https://www.aldiwan.net/poem37336.html","السريع"],[563,"أقبل على الحق لا تقبل على الباطل","https://www.aldiwan.net/poem34202.html","المواليا"],[563,"سنة نبي مختار","https://www.aldiwan.net/poem34235.html","منهوك المنسرح"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138379",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138235",""],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86899","البسيط"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25360","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25341","الرجز"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26416","الكامل"],[3369,"","https://poetry.dctabudhabi.ae/diwan/poem/117043","الكامل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85244","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77136","الكامل"],[4762,"ماذا تبقى...؟","https://www.poetsgate.com/ViewPoem.aspx?id=212901",""],[4802,"مجتمع كان","https://www.poetsgate.com/ViewPoem.aspx?id=34319",""],[4932,"ومستنير بسنا رَأْيه","https://www.poetsgate.com/ViewPoem.aspx?id=189373",""],[5183,"أَلْطَّاغُوتْ","https://www.poetsgate.com/ViewPoem.aspx?id=186459",""],[5232,"جنون","https://www.poetsgate.com/ViewPoem.aspx?id=213461",""],[5512,"دمشق ( ياقوتة حمراء )","https://www.poetsgate.com/ViewPoem.aspx?id=204614",""],[5792,"ليل المحبين","https://www.poetsgate.com/ViewPoem.aspx?id=180341",""],[5953,"باب الهداية باب واحد أبدي","https://www.poetsgate.com/ViewPoem.aspx?id=93783",""],[5956,"القداسة في البشرْ","https://www.poetsgate.com/ViewPoem.aspx?id=193842",""]],"verses":[["وَاللهُ بِالتَّمْحِيصِ يُوقِظُ أَنْفُساً","عَنْ حَقِّهِ الْمَحْتُومِ كَانَتْ تَغْفُلُ",0,"ل",1,0],["واللَّهُ بعدُ يزيده","أعلى مَنالةِ ذي ارتقاءِ",1,"ق",3,0],["واللهب السكران","يرقصُ في نارِه",2,"ه",1,0],["واللهبُ الوضّاح","من خلفهِ غابا",2,"ب",2,0],["واللّهُ بذاك قضى لا أنْ","تَ فلَسْتُ عليكَ أعدِّدهُ",3,"د",2,0],["واللَه بالمرصاد يخزي","كل شيطان ومارد",4,"د",1,0],["واللَه بينهما له","إذ قال نار حاميه",5,"ي",2,0],["واللهُ بالمِرْصادِ يَجْزِيكُمُ","بالظُّلْمِ كَيْلَ الصّاعِ بالصّاعِ",6,"ع",1,0],["والله بالوعد موفي والسوى ماطلْ","والغير ماحِلْ وربي غيثه الهاطلْ",7,"ل",1,0],["والله بالإحسانْ","يوفى لكم في الكيلْ",8,"ل",1,0],["والله بارك منه نسلا صالحا","بكرات ربك للأنام نعيم",9,"م",1,0],["والله بالمرصاد للباغي إلى","أن يحتويه من الثرى أخدود",10,"د",1,0],["وَاللَه بلّغك المَأمول حَيث علا","وَعمّ وَجهَك نُورٌ فَوقه نُور",11,"ر",1,0],["وَاللِهبُ لِهبُ الخافقَينِ يَهذِمُه","كَلَّفتُهُ عِيدِيَّةً تَجَشَّمُه",12,"م",2,0],["وَاللَّه بَيْنَ القَلْبِ والأَضْعَافِ","وَإِنْ أَصابَ العَيْشَ وَاسْتِحْصافِي",13,"ف",2,0],["وَاللَهُ بالِغُ أَمرِهِ في خَلقِهِ","وَإِلَيهِ مَصدَرُنا غَداً وَالمَورِدُ",14,"د",1,0],["والله بالتأييد منه يمدهم","فبهم يقوم بمجدنا البرهان",15,"ن",1,0],["واللَه بالعلم في كل الأماكن لا","يخفاه شيء سميع شاهد ويرى",16,"ر",2,0],["وَاللّهُ بارينا جَرَت عاداتِهِ","في كُلّ طاغٍ بِالهَلاكِ مُقَيَّد",17,"د",1,0],["والله بشر كل صبار بما","يرضيه في الأخرى فيا حسن المآل",18,"ل",1,0],["والله بعضهم معرف لوقتنا الآن","إني اعرفه حتى اشوفه قبالي",19,"ل",2,1],["وَالله بالعصر على خسره","مَا لم يقدم صَالحا يقسم",20,"م",1,0],["والله بحكمة يقضي","فسعادته أو قسوته",21,"ت",2,0],["واللهِ بصوتكِ تفكيري","ويموجُ بيَ الشعرُ الأشقرْ",22,"ر",1,0],["واللهُ بالتِّينِ والزَّيتونِ بارَكَها","بالزَّيتِ كلُّ ترابِ الشَّامِ يَخْتَضِبُ",23,"ب",1,0],["والله بأيدي اطوله","كان اخذ الزين من يمناه",24,"ا",2,0],["والله باطنه اسم وظاهره","نوبة ورسالات بلا أود",25,"د",1,0],["والله بارك في قصيدي كلما","جلّى بتصويرِ التدينِ بالصُّوَرْ",26,"ر",1,0]]}