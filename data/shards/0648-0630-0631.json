te.com/ViewPoem.aspx?id=207763",""],[4927,"الوداع المحزن","https://www.poetsgate.com/ViewPoem.aspx?id=29644",""],[4119,"من لقلب يألف الفكرا","https://www.poetsgate.com/ViewPoem.aspx?id=16151",""],[5038,"سحرتني","https://www.poetsgate.com/ViewPoem.aspx?id=195425",""],[5050,"قل للذي ترك العلى","https://www.poetsgate.com/ViewPoem.aspx?id=38201",""],[5183,"رباه","https://www.poetsgate.com/ViewPoem.aspx?id=186597",""],[5183,"نداء الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=180192",""],[5206,"حَيَاةُ المُهَج","https://www.poetsgate.com/ViewPoem.aspx?id=187392",""],[5206,"أرى العدل عن لوم العذول هو العدل","https://www.poetsgate.com/ViewPoem.aspx?id=149039",""],[5333,"نزلتُ إلى الأمر الدنيّ وكان لي","https://www.poetsgate.com/ViewPoem.aspx?id=8690",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5582,"لِمَنْ المَنازِلُ بِالصَّفِيحَةِ تُعْرَفُ","https://www.poetsgate.com/ViewPoem.aspx?id=187184",""],[5582,"إِنَّما نَوْحُ الحَمامِ","https://www.poetsgate.com/ViewPoem.aspx?id=63567",""],[1890,"صَرمتْ حبالك بعد وصلك زينبُ","https://www.poetsgate.com/ViewPoem.aspx?id=16446",""],[5689,"ضاقت بمن في ظلها الآجام","https://www.poetsgate.com/ViewPoem.aspx?id=143413",""],[5689,"حطمت لي يد القضا كل فلس","https://www.poetsgate.com/ViewPoem.aspx?id=143434",""],[5725,"مدينة الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=184314",""],[6024,"الجد","https://www.poetsgate.com/ViewPoem.aspx?id=186353",""],[6102,"طالق ..","https://www.poetsgate.com/ViewPoem.aspx?id=184436",""],[6127,"إليكِ يا أنا","https://www.poetsgate.com/ViewPoem.aspx?id=203112",""]],"verses":[["وذريةٌ بالحق عنها أئمة","وحبلٌ من المولى وعِدلٌ لمنزل",0,"ل",1,0],["وَذَرنا وَقَوماً إِن هُمُ عَمَدوا لَنا","أَبا ثابِتٍ وَاِجلِس فَإِنَّكَ ناعِمُ",1,"م",1,0],["وَذَروا عَلى نَهرِ المَدامِعِ نَعشَهُ","يَسري بِهِ لِلرَوضَةِ الفَيحاءِ",2,"ا",2,0],["وذَر اليراعَ تشي بدمع مدادِها","وشيَ القريض يروق في الأوراقِ",3,"ق",1,0],["وذروة جَونها لما استنارت","حكت تاجاً على رأس النجاشي",4,"ش",2,0],["وذروا لقاءَ الموجعين فقدْ","تعدي الصحاحَ مبارك الجرب",5,"ب",1,0],["وذرّ مسك الليل من فرقِ الأفق","واتَّشحت خود السماء بالنطق",6,"ق",1,0],["وَذَرَّةُ الرَملِ كَكُلِّ الجِبال","وَكَالَّذي عَزَّ الَّذي هانا",7,"ن",2,0],["وذَرَوْتُ أَفكاري الحزينَةُ للدُّجى","ونَثَرْتُها لعواصِفِ الأَيَّامِ",8,"م",1,0],["وذرى من الدين القشو","ر جميعها وخذي اللبابا",9,"ب",2,0],["وَذَرني وَإِيّاهُ وَطِرفي وَذابِلي","نَكُن واحِداً يَلقى الوَرى وَاِنظُرَن فِعلي",10,"ل",2,0],["وَذِراعُ كُلِّ أَبي فُلانٍ كُنيَةً","حالَت فَصاحِبُها أَبو الأَيتامِ",11,"م",1,0],["وَذَراهُ فيهِ الحَميمُ سَواءٌ","حينَ يَعفوهُ وَالنَزيعُ الجَنيبُ",12,"ب",1,0],["وَذَرِ الَحسودَ وَلَو صَفا لَكَ مَرَّةً","أَبعِدهُ عَن رُؤياكَ لا يُستَجلَبُ",13,"ب",1,0],["وذراعي في انتظارٍ وصدري","فيه بالضيف فرحة واحتفاء",14,"ا",2,0],["وذَرّتْ لنا شمسُ النّهارِ مذيبّةً","على الأرض روحاً في السماءِ له جسم",15,"م",1,0],["وَذَراها في الريحِ إِن كُنتَ تَرجو","سَيرَ شِعري في نَعتِها بِالريحِ",16,"ح",1,0],["وذَرْعُ هذي الأرضِ بالذراعِ","عشرونَ في الطولِ بلا نزاعِ",17,"ع",1,0],["وذَرْعُها في العرضِ أيْضاً عَشَرَهْ","وهْو ذِراعٌ باليدِ المعْتَبَرَهْ",17,"ه",1,0],["وذرفتَ دمعاً لا يُكفْ","كف هيَّجتْةُ الغُوطْتانِ",18,"ن",1,0],["وَذَرعَ طولِ الأَرضِ وَالأَفلاكِ","وَكَم بِلادِ الصينِ وَالأَتراكِ",19,"ك",1,0],["وذَرا جلابيباً تُشَقّ جيوبُها","حتى أُضَرّجَها دَماً مسْفُوحا",20,"ح",2,0],["وذر عذلي فما عندي","لمسحاتِك من طينِ",21,"ن",1,0],["وَذَرِ الإِمارَةَ وَاِتِّخاذَكَ دِرَّةً","في المِصرِ يَحسَبُها حُسامَ المُنجِدِ",22,"د",1,0],["وذرني وإياه وطرفي وذابلي","نكن واحداً نلق الورى وانظرن فعلي",23,"ي",1,0],["وَذَرْهُمْ يَخُوضُوا إِنَّمَا هِيَ فِتْنَةٌ","لَهُمْ بَيْنَهَا عَمَّا قَلِيلٍ مَصَارِعُ",24,"ع",1,0],["وذرُوا قلبي وذِكرى غَيِّهِ","فعسى يَلْقَى مِنَ الحُبِّ شِفا",25,"ف",2,0],["وذر النذلَ ولا تنصحْ لهُ","إنما النذلُ كثوبٍ مُبْتذَلْ",26,"ل",1,0],["وذَرِ الشىءَ الذي صاحبُه","إن يُسَائِل عنه يطرق في وَجَلْ",26,"ل",1,0],["وذَرِ القُربى ولا تقطعْ لها","رحما فاللهُ ينجِى مَنْ يَصِلْ",26,"ل",1,0],["وذرِ الريا والعجبَ والخيلاء والأضغ","انَ والشحناءَ يا متعفّفُ",27,"ف",1,0],["وذر الجبال لِما ألمّ خواشعاً","متصدعات والبحارَ تسجّر",28,"ر",1,0],["وذرِي رحابَ الجو تبعث صرصراً","يا ريحُ وأسري بيننا إعصارا",29,"ر",2,0],["وَذُرىً تَقيكَ القُرَّ حينَ هُجُومِهِ","وَالحَرَّ لا وَحماً وَلا مَملُولا",30,"ل",2,0],["وذر الخليج بها يعيذ","عروسه من كل حاسد",31,"د",1,0],["وذروني أجرع الصاب","وأستوحي الظلاما",32,"م",2,0],["وذَرِ الهمومَ نَسيئةً","وتَعجَّلِ اللذّات نَقدا",33,"د",2,1],["وذرته بين أنياب البلى","يتلاشى تحت أثقال الصخور",34,"ر",1,0],["وَذُرى الجِبالِ إِذا رَأَتهُ تَ","قولُ ما أَعلى ذُراه",35,"ا",2,0],["وذر كل شيطان يخالف أمرها","غوى على أحزابه متحوذ",36,"ذ",1,0],["وَذراع شاةِ الخَيبَرِيَّة أَصبَحَت","بِالسُمِّ تُخبِرُهُ بِلا أَكنانِ",37,"ن",1,0],["وَذِراعُه كَسَبيكَةٍ مِن فِضَّةٍ","وَيزينُ رَحبَ الكَفِّ لينُ بنانِ",37,"ن",1,0],["وَذَر مَلامي في هِجاءِ اِمرِئٍ","لَحِقتُ فيهِ بِأَبي ذُرِّ",38,"ر",1,0],["وذروا الفواحش والكبائر والخنى","من ظاهر منها ومن مكنون",39,"ن",1,0],["وذر الذل واطلب العز فالذل","دليل على انتكاس الرؤس",40,"س",1,0],["وذرَّت نجمةٌ زَهراءُ كنّا","نمدُّ إِلى أشعّتِها اليَمينا",41,"ن",2,0],["وَذرِ الحزينَ يبثُّ بعضَ شكاتِه","فالصدرُ يحرجُ بالهمومِ حواشدا",42,"د",2,0],["وذُراه مُزْدَحِمُ الوفودِ تَؤُمُّه","أبداً لأنّ نَداهُ عَذْبُ المَنْهَل",43,"ل",1,0],["وذرَعْنَ عَرْضَ البِيدِ طائشةَ الخُطا","بأخي عَزائمَ في البلادِ مُجَوِّل",44,"ل",1,0],["وذَرينا الدموعَ من مأْقِ جفنٍ","رُبَّ داءٍ يكون فيه الدَواءُ",45,"ا",2,0],["وَذر الدُموع عَلى المَعا","لَم تَستَهلُّ فَتُسرع",46,"ع",1,0],["وَذَرِ الَّذي كانَت تَعَرَّفُ داءَهُ","اِنَّ الشِفاءَ لهُ اِستِماعُ خِطابي",47,"ب",2,0],["وذرِ اتّباعكَ لِلْهوى","إنَّ الْهوى شركُ الْهَوانِ",48,"ن",1,0],["وذروا رمادَكَ في الفراتِ ضلالَةً","أتُرى دَرَى ذاري رمادكَ ما ذَرى",49,"ر",2,0],["وذَرِ السَّفيه إذا تَصدّى لامرِئٍ","مَتَحَلِّمٍ ونَحاهُ بالإضرار",50,"ر",1,0],["وَذَر الدَهر يتبع اليسرَ عُسراً","وَالهَوى بِالنَوى وَنُعماهُ بوسا",51,"س",2,0],["وذرها تروِّي بالدموع غليلها","وأنَّى يبلّ الدَّمع من مغرم صدى",52,"د",2,0],["وذرا أوجه البلاغَةِ حتى","أوْ شَكَتْ أن تْكونَ سِحْراً حلالا",53,"ل",2,0],["وذرع الأَرض يسيرُ ماشياً","معتبراً ولو سرى مغاضبا",54,"ب",2,0],["وذِراعي لو بسيفٍ قُطِعَتْ","كَفُّها بابَ السِّوى ما طَرَقَا",55,"ق",2,0],["وذَروا القُلوبَ الواجباتِ برَبْعِه","تقضي الحُقوقَ الواجبات وتندُبُ",56,"ب",1,0],["وذرِ اِنتقادي بالشُّناةِ فلم تُنِرْ","شمسُ الظّهيرة للعيون الحُولِ",57,"ل",1,0],["وَذُرى قُفِّ سَبسَبٍ","لاحِقٍ بِالسَباسِبِ",58,"ب",1,0],["وذر حديث الخلى واذكر","محاسن الثغر فهو بارد",59,"د",1,0],["وذُرَى مئذنةٍ طا","لتْ ذُرَى النجم ذراها",60,"ا",3,0],["وذراها الفسيح لم يلف فيه","منذ حل الوزير أرض جدوب",61,"ب",1,0],["وذر الظلامة هل ترى","نال السلامة من قسط",62,"ط",1,0],["وَذراعات الفلا فتل مرافقها","كم قد قطعنا بها عرض المسافاتِ",63,"ت",1,0],["وذرية يرفل في غلائل من","نسج الغليل يجرها وملا",64,"ل",2,0],["وذري القلا عن هايم يرجو اللقا","كرماً فمني بالمنا واسدي الجدا",65,"د",2,0],["وَذَرُوا التَحاسُدَ وَالتَنافُسَ بَينَكُم","فَكِلاهُما نَزغٌ مِنَ الشَيطانِ",66,"ن",1,0],["وذرة من زللي إحدى الكبر","وأنت تواب رحيم بالفطر",67,"ر",1,0],["وذَرى حمَته مَنْ يلوذ بهِ","سُمُر القنا والشُّقرُ والدُّهمُ",68,"م",1,0],["وذَراه للوفادِ منتجعَ","وحماه للخَواف مُستندُ",69,"د",1,0],["وذروَا القبورَ عَلَى تواريخٍ لها","فضريحُ اسعدَ في القلوب مشيَّدُ",70,"د",1,0],["وذر الخيانة للخئو","ن فإنها عيب وذام",71,"م",1,0],["وذر الجديد إذا رأيت سبيله","عوجاً عن الحق المبين تميل",72,"ل",1,0],["وذر الهوى وامدد لدي","نك راحة البر الوصول",73,"ل",1,0],["وذري الفؤاد يذق مرارات النوى","ويلاقي من بلواك ما هو لاقي",74,"ق",2,0],["وذر أنا فطراً فاكمل صنعنا","بفضائل منه وحسنِ بلاءِ",75,"ا",2,0],["وذَرَّ في كفِّه الأَرزاق يَقْسِمُهامِنْ راح","تيه لِمَنْ في عصره ذَرَأَ",76,"ا",1,0],["وذرني وإياها ووجدي فللهوى","ولي ولها شأن وما سره يبدى",77,"د",2,0],["وذَرَّ ذو العَرشِ ذَرًّا طابَ بينهما","فانبَثَّ نورٌ لهُ في الأرضِ تخليدُ",78,"د",1,0],["وذرفتُ دمعي في الوسادِ مُردّداً","\"حُلمُ الصّبابةِ كاذبٌ أفّاقُ\"",79,"ق",1,0],["وَذَرني فَما أَعدَدتُ بَعدَك ساعِدي","مُعيني وَلا صَدري أَمينا عَلى سِرّي",80,"ر",2,0],["وَذَرني وَإِيّاها فَإِن لَم أَفُز بِها","سَريعاً وَإِلّا لَستُ نَجلَ سِنانِ",81,"ن",1,0],["وذريعتي ثقتي وفضلك إذ","شرف الفعال وطهر العرض",82,"ض",1,0],["وَذَروا الحَقلَ وَخَلّوا مَن دَنا","في هِضابٍ وَنُجودٍ وَسَنَد",83,"د",1,0],["وذَر فى الخوضِ يَلعبونَ","ثمّ قل اللهُ تكُن حَصُونا",84,"ن",2,0],["وذر ما سوى ما أوجب الود حقه","بنشر الثنا في مدحهم واغنم الأجرا",85,"ر",2,0],["وذرِ العفافَ فلستَ أول من صبا","ودع الفلاحَ فلات حين فلاحِ",86,"ح",1,0],["وذروا عيون الحاسدين بحاصب","فقد حملقوا نحو النهوض بأرمد",87,"د",1,0],["وذر التجني واجن من غض الجني","ما يستطاب ودع عداك وما جنب",88,"ب",1,0],["وذرأهيفاً يزري الغصون رشاقة","وهيفاء عن عين الجآذر تنظر",89,"ر",1,0],["وذر النرجس يرنو شاخصاً","ودع النما إن قال ونم",90,"م",1,0],["وذرتْ بقاياك الرياح فأصبحتْ","بدداً وفي الأزهار كُلّ جميع",91,"ع",1,0],["وذرت أوراقها هاجرة","فغدت مسلوبة كل حلاها",92,"ا",3,0],["وذر البرادة من عسجد","عليه وما لقيت مبرده",93,"د",2,0],["وذراعها كذراع ليث مده","وذراعها اليَمَنىّ كالمقبوضة",94,"ه",1,0],["وذَرنِي وَمَن هامُوا بصَيحَةش بائِدٍ","يردِّدُ يا لَيلَى يرَجِّعُ يا رَيَّا",95,"ي",2,0],["وَذر الرِياح المايسات لأَنَّها","تَهتز بَينَ مفضض وَمدنر",96,"ر",1,0],["وذَرِي مغالبةَ الملوكِ فإنّ مَن","نَاواهمُ فِي قبرِه مَلْحود",97,"د",1,0],["وَذرني أُسائلُ عجماءها","عَساها تَكلّمُ أَو تَنطقُ",98,"ق",1,0],["وذر علي لن عادوا وإن رجعوا","لأزرعن طريق الطف ريحانا",99,"ن",2,0],["وذر الأعين تذري دمعها","عميت اما غدت فيه شحاحا",100,"ح",2,0],["وذر الأجفان ذا رية","بدموع هن كاللجيج",101,"ج",1,0],["وَذُرى مَجد أَحرَزناه","بِسُيوف النَصر لمقتبل",102,"ل",1,0],["وذر الورق تغنيني كما","كنت من قبل أغني الشعرا",103,"ر",2,0],["وذراها تفري الفلا ورباها","ودعاها فالشوق طبعاً دعاها",104,"ا",3,0],["وَذَرِ التَكَهُّنَ وَالتَعَرُّف وَالرُّقى","وَالسِّحرَ وَالتَّنجيمَ وَالتَّحبيسا",105,"س",2,0],["وذر دموعك تجري في الثرى بدمٍ","فالآن أرخص سوق الموت غاليها",106,"ي",3,0],["وَذر اللمَى يَصفو لسكير الهَوى","فَإِذا ظمئتَ فَذُق مَراشف أَرقم",107,"م",1,0],["وذروني كيف ابغى موئلاً","بين خناس ووسواس رجيم",108,"م",1,0],["وذر الخدور وما بها من خرد","كيلا تصاب بسهم طرف بابلي",109,"ل",2,0],["وذرى النخيل موائل فكأ