.aspx?id=187631",""],[5105,"عزفتُ فودعتُ الصِّبا والغوانيا","https://www.poetsgate.com/ViewPoem.aspx?id=135341",""],[5183,"إلى الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=180189",""],[5302,"ملحمة الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=200060",""],[592,"ألا يا أيها الإنسان سمعا","https://www.poetsgate.com/ViewPoem.aspx?id=128822",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[5455,"هدية عيد ميلادك","https://www.poetsgate.com/ViewPoem.aspx?id=34428",""],[5606,"تذكرني وطالع لروحك فالمرايه","https://www.poetsgate.com/ViewPoem.aspx?id=194354",""],[5690,"مليك الورى ولاَّك","https://www.poetsgate.com/ViewPoem.aspx?id=172234",""],[5691,"عكاظُ الفيسِبوك...!","https://www.poetsgate.com/ViewPoem.aspx?id=207585",""],[5818,"بثامن آيةٍ في العادياتِ","https://www.poetsgate.com/ViewPoem.aspx?id=199689",""],[5956,"طبيعة حواء الغموض","https://www.poetsgate.com/ViewPoem.aspx?id=182454",""],[5956,"العين بالعين..‏","https://www.poetsgate.com/ViewPoem.aspx?id=183739",""],[6102,"السِّفر اليماني","https://www.poetsgate.com/ViewPoem.aspx?id=186268",""],[6189,"أروى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83571&r=&rc=38",""],[231,"ناحتُ الصخر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79149&r=&rc=23",""]],"verses":[["وَلَكِنَّ قَلبي قَد تَقَسَّمَهُ الهَوى","شَتاتاً فَما أُلفى صَبوراً وَلا جَلدا",0,"د",2,0],["وَلَكِنْ قَضَاءٌ يَغْلِبُ الْعَزْمَ حُكْمُهُ","وَيَضْرِبُ مِنْ دُونِ الْحِجَا بِحجَابِ",1,"ب",1,0],["ولكن قد غلبت جيوش قوم","أذلّوُا بالبوارج كلّ لج",2,"ج",1,0],["وَلَكِن قِراهُ ما تَشَهّى وَرِفدُهُ","وَلَو سَأَلَ الأَعمارَ ماهُوَ سائِلُ",3,"ل",1,0],["وَلَكِنَّ قَولي لَيسَ يَفضُلُ عَنفَتىً","عَلى كُلِّ قَولٍ مِن مَعاليهِ خاطِرُ",4,"ر",1,0],["وَلَكِن قَد بَكيتَ وَأَنتَ خِلوٌ","بَعيدُ الدارِ مِن عَونِ القَتيلِ",5,"ل",1,0],["وَلَكِنَّ قَيناً حَمَّمَ الكيرُ أَنفَهُ","لَئيمُ المُحَيّا لِلِئامِ رَبيبُ",6,"ب",1,0],["ولكن قلَّ ما استكثرتَ إلّا","سقطتَ على ذئابٍ في ثيابِ",7,"ب",1,0],["ولكن قضاياه سدادٌ وَجُودُهُ","ينابيع بالمعروف مُنفجراتُ",8,"ت",1,0],["ولكنْ قد وثقتَ بصدق وُدّي","وآمَنك اختبارُك من زيالي",9,"ل",2,0],["ولكنْ قدْ تَحمَّلها ضليعٌ","له في الخَطْبِ حَزمٌ واحتزامُ",10,"م",1,0],["وَلَكِن قَذاها كُلُّ أَشعَثَ نابِئٍ","رَمَتنا بِهِ الغيطانُ مِن حَيثُ لا نَدري",11,"ر",2,0],["ولكنّ قرص البدر في لمعانه","ببعض الليالي البيضِ منك بديل",12,"ل",1,0],["ولكن قِبلة الدكتور مصر","وسودان يراه لها كظل",13,"ل",1,0],["وَلَكِنَّ قَبلَكَ خابَ المَسيحُ","وَباءَ بِمَنشورِهِ القَيصَرُ",14,"ر",1,0],["وَلَكِنَّ قَلباً بَينَ جَنبَيَّ مالَهُ","مَدىً يَنتَهي بي في مُرادٍ أَحُدُّهُ",15,"د",2,0],["وَلَكِن قَد وَرِثتَ بَني كُلَيبٍ","حَظائِرَها الخَبيثَةَ وَالزِرابا",16,"ب",2,0],["ولكنَّ قلب الحر تعروه نشوة","فيثني على الآلاء وضاحة السنا",17,"ن",2,0],["وَلكنَّ قَتْلَىً في بلادي كريمةً","سَتُبْقِيهِ مَفْقُودَ الجَوابِ يحاوِلُهْ..",18,"ل",2,0],["وَلَكِن قَد رُزِقتَ بِهِ سِلاحاً","لَوِ اِستَعصَيتَ ما أَدَّيتَ طاعَه",19,"ع",2,0],["وَلَكِن قُلتَ وَالمُهجاتُ تَجري","مَعاذَ اللَهِ مِن كَذِبٍ وَمَينِ",20,"ن",1,0],["وَلَكِن قَد مَنَحتُ هَوايَ صَفواً","فَلَيتَ اللَهُ يَمنَحُني حَواكِ",21,"ك",1,0],["وَلَكِنَّ قَلبي سيقَ لِلحَينِ نَحوَكُم","فَجِئتُ فَلا يُسراً لَقيتُ وَلا صَبرا",22,"ر",2,0],["وَلَكِن قَد أَصابَ سَوادَ عَيني","عُوَيدُ قَذىً لَهُ طَرفٌ حَديدُ",23,"د",1,0],["ولكن قل تَبارَكَ من هداكا","أترقدُ هاهنا وهمو هناكا",24,"ك",2,0],["وَلَكِن قَرَّبوا قُلُصاً حِثاثاً","عَواصِفَ قَد حُنينَ مِنَ المِراحِ",25,"ح",1,0],["وَلَكِن قَضاءٌ لَيسَ يُسطاعُ رَدُّهُ","بِحيلَةِ ذي مَكرٍ وَلا فِكرِ ذي عَقلِ",26,"ل",1,0],["وَلَكِن قَتادٌ عَديمُ الجَناةِ","كَثيرُ الأَذاةِ أَبى غَيرَ شَرّ",27,"ر",1,0],["وَلكنَّ قَومي أَصبَحُوا مِثلَ خَيبَرٍ","بِها داؤُها وَلاَ تَضُرُّ الأَعادِيا",28,"ي",2,0],["وَلكن قبل الموت حيناً إذا أَتى","تهب عَلى الإنسان نكباء زعزع",29,"ع",1,0],["ولكنَّ قَومي فوضوا الأمر كله","إلى قدرٍ من ربِّهم وَجدود",30,"د",1,0],["وَلَكِن قَتيلاً يَدرُجُ الطَيرُ حَولَهُ","وَتَشرَبُ غِربانُ الفَلا مِن جَوانِحي",31,"ح",2,0],["وَلَكِنَّ قَوْماً يَذُودُونَ عَنْ","حَقِيقَتِهِمْ مِنْ يَدِ المُعْتَدِي",32,"د",2,0],["وَلَكِن قَد بَخِلتَ بِكُلِّ شَيءٍ","فَحَتّى السَلحُ مِنكَ عَلَيهِ بُخلُ",33,"ل",1,0],["وَلَكِنْ قدْ أصَابَ سَوَادَ عَيْنِي","عويد ندى له طرف حديد",34,"د",1,0],["وَلَكِنْ، قَدْ مَنَحْتُ هَوَايَ صَفْواً","فليتَ اللهَ يمنحني هواك!",35,"ك",1,0],["ولكن قلباىً خالجته همومه","ترى أي ملهى طيب ليس يجنب",36,"ب",1,0],["ولكن قد ازداد المزيد وأوشكت","عرى الصبر من بعد الثبات تحطما",37,"م",2,0],["ولكنْ قضاءُ اللهِ ما عنه مهربٌ","فَمنْ منهُ مِن أحيائنا غيرُ سَالمِ",38,"م",1,0],["ولكن قضاءُ الله ما عنه مهربٌ","إذا ما قضاهُ وهو أحكمُ حاكمِ",39,"م",1,0],["ولكن قضت فيه الفراسةُ عندَه","بأَن له من دون أَبنائه شأْنا",40,"ن",2,0],["ولكن قلتم جاور سوانا","فقد جللنا حدثا جليلا",41,"ل",2,0],["ولكِن قد ولدتِ لأمِّ سُوءٍ","يَقُومُ بأمرِها بَعلٌ لَئيمُ",42,"م",1,0],["ولكنّ قلباً لم يُفَتِّحهُ لحظُها","وليسَ لهُ منها هوىً ونصيب",43,"ب",1,0],["وَلكِنْ قادَنِي شَوْقِي إِلَيْكُمْ","وَحُبِّي كُلَّ مَعْدُومِ الشُّكُولِ",44,"ل",1,0],["ولكن قومي أطاعوا الغُوا","ةَ حتى تعكسَ أهلُ الدمِ",45,"م",1,0],["ولكن قضاءُ اللَه غَيرُ مُدافَعٍ","وأَحكامُه تَجري وَلَم تَخشَ من دَركِ",46,"ك",1,0],["وَلَكِنَّ قَومي شَبرَقوها فُجاءَةً","بِأَورَقَ لا لَغبٍ وَلا مُتَخاذِلِ",47,"ل",1,0],["ولكنْ قلّما أغْنَى احْتيالٌ","إذا ما حُمَّ مَقْدورُ اغْتِيال",48,"ل",1,0],["ولكنَّ قومي أَطاعوا الغُوا","ةَ حتى تَعَكَّظَ أَهلُ الدمِ",49,"م",1,0],["وَلَكن قَد جَلا عَنها صَداها","بِصيقل لُطفِهِ المَولى الجَليل",50,"ل",1,0],["ولكن قد تصيبك","فطها بالمدارة",51,"ه",1,0],["ولكِن قضتْ فِينا اللّيالي بجَوْرِهَا","وعادتُها كُفرُ الفَضائلِ والغَمطُ",52,"ط",1,1],["ولكن قد أصيبَ بسهم رامٍ","قضى أن لا يرد عن المراد",53,"د",1,0],["ولكنْ قد بَدَأْتَ به رَحِيقاً","أُنَافِسُ أَنْ تُضِيفَ له الخِتاما",54,"م",2,0],["ولكنْ قسمةُ الدهر","كما تُعرَفُ بالغُبْنِ",55,"ن",1,0],["ولكن قبيحُ أن أضنّ بمدحة","وقد غمرت كفاك بالجود والبر",56,"ر",1,0],["ولكن قُلُوبٌ قُسِّمَتْ وجوانِحٌ","منازِلَ مقدوراً لَهَا نُوَبُ الدَّهْرِ",57,"ر",1,0],["ولكن قطعيَ العضو ال","أليمَ يزيد في ألمي",58,"م",2,0],["ولكن قَضاءُ اللهِ لا مُتَأخِّرٌ","اذا ما جرى عنهُ ولا مُتقَدِّمُ",59,"م",1,0],["ولكن قد يصغى الى كل كاذبٍ","وما قال اعداء المحبة يتبع",60,"ع",1,0],["ولكن قد وجدت فيه طبعاً","يمانع عن مطالبة الوصال",61,"ل",1,0],["ولكن قلَّ سابِقُهم إليها","كما قَلَّتْ صَناديدُ الطِّعانِ",62,"ن",1,0],["وَلَكِنَّ قَومي أَحدَثوا بَعدَ عَهدِنا","وَعَهدِكَ أَضغاناً كَلِفنَ بِشانِكا",63,"ك",2,0],["وَلَكِن قَصائِدَ شَوقي اللَواتي","لَهُنَّ سَجَّلَ بِلَوحِ الخُلودِ",64,"د",1,0],["ولكنْ قد تَضمُّكِ أمُّ سوءٍ","إلى لَبَّاتها وأبٌ لئيمُ",65,"م",1,0],["وَلَكِنَّ قومي أَحرَزَتهُم سُيوفُهُم","فآبوا وَقَد عادوا حُماةَ المَكارِمُ",66,"م",1,0],["وَلَكِنَّ قَومي آزَرَتني رماحُهُم","عَشِيَّةَ هَبّوا بِالرِماحِ الخَوافِقِ",67,"ق",1,0],["ولكنْ قضاءٌ سابقٌ حكمتْ به","مقاديرُ ترمي مَنْ تَشأْ بسهامِ",68,"م",1,0],["ولكن قومي أطاعوا الغُوَا","ةَ حتى تَلفَّظَ أهلُ الدَمِ",69,"م",1,0],["وَلكن قَضاء اللَه حتم فَلَيسَ لي","سواه عَلى حَمل الخطوب حَسيب",70,"ب",1,0],["ولكن قد شعرت بنعم صقر","أعزّ الآل مني والأقاربْ",71,"ب",1,0],["ولكنَّ قلبي غدا مَرْبعاً","لِضَيفٍ هَمومٍ سَروبٍ حروزِ",72,"ز",1,0],["ولكن قصارى العبد شكوى يبثها","إليك ودمع يستهل الماقيا",73,"ي",2,0],["ولكنَّ قلبي ذاب حزناً وقد جرى","من العينِ دمعٌ في الخدودِ علائمه",74,"م",2,0],["ولكن قابلت جهلي بحلمٍ","ينوِّل كل جارحةٍ مناها",75,"ا",3,0],["ولكن قد ترى منه إذا ما","تعصَّى السيفَ ذا الأشبال دونا",76,"ن",2,0],["وَلَكِنَّ قَولي لَهُ مَرحَباً","وَأَهلاً مَع السَهلِ واِنعِم صَباحا",77,"ح",2,0],["وَلكن قد يَسُرُّ وَيتَقيني","بجَهدِ الوُدِّ مُغضَبَةَ الرِواقِ",78,"ق",1,0],["ولكن قارع الابطال حتى","أصابوا الامن واجتنبوا الفرارا",79,"ر",2,0],["ولكن قد جهلت الامر منها","وليس كعالم الأمر الجهول",80,"ل",1,0],["ولكن قلبي شاقه ذكر من رقى","جواد المعالي واعتلى ربوة المجد",81,"د",1,0],["وَلَكِنَّ قَلبِي واثِقٌ بِكَ عالِمٌ","بِكُلِّ جَمِيلٍ مِنكَ غَيرِ مُعَتِّمِ",82,"م",1,0],["ولكن قد دنا من عفو ربّ","عفو راحم بَرّ غفور",83,"ر",1,0],["وَلكِنَّ قلبى قَد قَسا قَسوَةً فَهِى","اَشَدُّ مِنَ الصَّخرِ العَظِيمِ لِجَهلِهِ",84,"ل",2,0],["ولكن قد أبوا إلا اعتسافاً","علينا يرصدون بنا الفتونا",85,"ن",2,0],["وَلكن قضاءٌ مُبرَمٌ يَستَوي به","مَليكٌ 