poem/122006","الكامل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46486","الكامل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104778","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53167","الطويل"],[2484,"","https://poetry.dctabudhabi.ae/diwan/poem/132507","الرجز"],[2496,"","https://poetry.dctabudhabi.ae/diwan/poem/100438","الوافر"],[2721,"","https://poetry.dctabudhabi.ae/diwan/poem/20692","الطويل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205878","البسيط"],[3115,"","https://poetry.dctabudhabi.ae/diwan/poem/216337",""],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/140011","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48292","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216810","الكامل"],[3778,"","https://poetry.dctabudhabi.ae/diwan/poem/90019","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54413","الكامل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81241","السريع"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135122","الرجز"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62129","البسيط"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62125","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72832","البسيط"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204169","الطويل"],[4676,"وحشي المفضل","https://www.poetsgate.com/ViewPoem.aspx?id=206650",""],[4929,"تنقيب عن معدن الكرامة في صحراء الضمير","https://www.poetsgate.com/ViewPoem.aspx?id=199178",""],[4978,"يمشي الجمال إذا تمشي وإياها","https://www.poetsgate.com/ViewPoem.aspx?id=177634",""],[5092,"عناد","https://www.poetsgate.com/ViewPoem.aspx?id=176738",""],[5343,"صدى البردة","https://www.poetsgate.com/ViewPoem.aspx?id=132671",""],[5409,"أهزةٌ أيقظت من روعها البلدا","https://www.poetsgate.com/ViewPoem.aspx?id=155458",""],[5853,"غروب شمس","https://www.poetsgate.com/ViewPoem.aspx?id=175722",""],[5873,"تصرّم الصبا","https://www.poetsgate.com/ViewPoem.aspx?id=215353",""],[5897,"عروس الحسن ..غادة","https://www.poetsgate.com/ViewPoem.aspx?id=156854",""],[5906,"فمعفر الليث","https://www.poetsgate.com/ViewPoem.aspx?id=188221",""],[5956,"دعوتُ للإنسانية","https://www.poetsgate.com/ViewPoem.aspx?id=194884",""],[6070,"أَضَفْتَ إلى سنينَ العمر ذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=188673",""],[520,"عسى منجد الأظعان يوما يغيرها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577553",""],[402,"مفامك فوق ما يهب الوسام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54046&r=&rc=898",""]],"verses":[["أَضَفتَ إِلى صُروحِ العِلمِ صَرحاً","بِزَورَةِ ذَلِكَ المَلِكِ الحَكيمِ",0,"م",1,0],["أَضَفْتَ إِلَى التَّلِيدِ طَرِيفَ جَاهِ","وَقَلْبُكَ بِالمَحَامِدِ مُسْتَهَامُ",1,"م",1,0],["أضفى على السَّعدينِ بُرْدَ سماحةٍ","فاهتزَّ جُودُهُما وأقبلَ يرفلُ",2,"ل",1,0],["أضفها فهي أعمار أضيفت","وما تدري لماضيك النبيل",3,"ل",1,0],["أضفى على علم البلاد حَماسَهُ","وسرى إليه العزم من عزماته",4,"ت",2,0],["أضْفَيْتمُو حُلَلَ الثناء على امرئ","ليس الثناءُ وَحُبُّه من دَأبه",5,"ب",2,0],["أَضَفتَ إِلى التَكديرِ خَوفاً وَقَد صَفَت","مَشارِبُ فيها وَاِطمَأَنَّت مَسارِبُ",6,"ب",1,0],["أَضَفتَ إِلى الجَدِّ اِجتِهادَاً وَلَم تَكُن","كَمَن تَرَكَ الجِدَّ اِتِّكالاً عَلى الجَدِّ",7,"د",1,0],["أَضَفتَ إِلى الغِنى أَمناً وَعَدلاً","لَقَد جاوَزتَ حَدَّ المُنعِمينا",8,"ن",2,0],["أُضِفنا إِلَيهِ فاِحتُرِمنا بِحُرمَةٍ","عَلَونا بِها الجَوزاءَ رِفعَةَ هِمَّةٍ",9,"ه",1,0],["أضفني إلى النوكي وقل هو أبله","وهات الغنى عن كل حر وباخل",10,"ل",1,1],["اضفري الغار شهب أنجمك الزهر","وزيني مفارق الأبطال",11,"ل",1,0],["أضفَى على النّاسِ ظِلَّ الأمنِ فابتَهجوا","حتّى تَناسَوا زمانَ الجَورِ والجنَف",12,"ف",1,0],["أَضفت اِعتِكار الهُموم","إِلى لَيلي العاكر",13,"ر",1,0],["أضفتم فلا جُوُّ الظَّلام ببادرٍ","لديه ولا بأسُ الشتاء بمؤلم",14,"م",1,0],["أضفت إلى الجاري الذي لي إقامة","أقمت بها حالي وأثرى فقيرها",15,"ر",3,0],["أضفت إلى أجر الجهاد زيارة ال","خليل فأبشر أنت غاز موفق",16,"ق",1,0],["أَضَفْتَ إلىَّ الفضلَ منك تفضّلاً","وَأثنيتَ عمداً بالّذي أنت صانعُ",17,"ع",1,0],["أَضفى عَلى وادي المَنية رَوعة","مِن صَوب ضُوء سال كَالبللور",18,"ر",1,0],["أُضِفتَ إِلى الرَب الحَليم محمدٍ","فَحزتَ مِن الاسم الكَريم عُلا الذكر",19,"ر",1,0],["أضفَى عليه النَّورُ من أثْوابِهِ","خِلَعاً تُهذّب نَشرها تَهذيبَها",20,"ب",3,0],["أَضفى عَلى الأَرضِينَ ظِلّ مَهابَةٍ","فَحَمى بِها حامَ العِبادِ وَساما",21,"م",2,0],["أضفناكم نزلناكم أعيدوا","علينا يا كراما من كرام",22,"م",1,0],["أضف وجرِّد وبأل واعمله مع","فعل بأن أو ما بتقدير وقع",23,"ع",1,0],["أضف عليه الصمغ بعد بله","حتى يذوبَ بعد ذاك انزل به",24,"ه",1,0],["أَضْفَى عَلَى أَعْطَافِهَا حُلَلَ الرِّضَى","فَهَفَتْ إِلَى ذِكْرَى الحَبِيبِ لَهَا الشَّجِي",25,"ج",2,0],["أَضفى الوقار عَلَيهِ حلة هَيبَةٍ","تَطريزُها التَبجيل وَالتَعظيم",26,"م",1,0],["أُضِفنا فِيهِ مِن حُلَواهُ نُوراً","هُمُ الشُّهَدَاءُ وَالأَحيا سِيادِى",27,"د",2,0],["أضفت إلى خير المواليد موسماً","دعمت به الملك الذي أنت كافله",28,"ل",2,0],["أضف لها شهراً وقام المستضي","لسيفهِ بعد أبيه ينتضي",29,"ي",1,0],["أضف عدد الأئمة ثم أرخ","على أوج السماك ضريح أحمد",30,"د",1,0],["أَضفتُ فَلم أُفحش عَلَيهِ وَلَم أَقُل","لِأَحرِمَه إِنَّ المَكانَ مَضيقُ",31,"ق",1,0],["أضفى إلهي عليها ظل رحمته","وظل من منهل الرضوان يسقيها",32,"ي",3,0],["أضفى بمعروفه وضلّه","غيمٍ يعم وخيرٍ يبد",33,"د",1,0],["أضفتُ إلى ميلادهِ غزواتِه","وما عنَّ لي من آية وإياء",34,"ا",2,0],["أضْفى علَيْها الحُسْنُ حُلّتَهُ التي","لم تسْتَطِعْ أيْدي التّناوُل لمْسَها",35,"س",3,0],["أضفى على تلعاتها ووهادها","حللاً تكاد تخف بالأعطاف",36,"ف",1,0],["أضفتهم حتى إذا ما تمردوا","أضفت بهم تبآ لهم وخسار",37,"ر",1,0],["أَضفى ظلالَ العَدْل بعدَ تقلُّصٍ","وبَنَى أَساسَ العدلِ بعدَ تقوُّضِ",38,"ض",1,0],["أَضفى عَلَيها الحُب فنانه","وَزانَها بِالأَعيُن الزاهِيَه",39,"ه",1,0],["أضف له العفة واتبعه العلا","مثل الذي له أضفت الأولا",40,"ل",2,0],["أضفى على الدين أبراد الشباب فقل","صديقه البر أو فاروقه عمر",41,"ر",1,0],["أضفى مواردها أزاح سقامها","أحيى خواطرها أقال عثارها",42,"ر",3,0],["أضفتَ سعدك للَه الذي سعدَت","به الملوكُ ومن قد ضيفَ مجبورُ",43,"ر",1,0],["أضفت إلى النفس التي بين أضلعي","بأنفاسها نفساً إلى الصدر تولج",44,"ج",1,0],["أضفتُ ملحاً لجُرحي، كيفَ تَضحكُ من","بُكائهِ ، جَارحاً ملحي الذي خَذَلَكْ",45,"ك",1,0],["أضفَوا عليهِ من القداسةِ هالةً","جعلتهُ فيهم حاكماً معبودَا",46,"د",2,0],["أضفى الجمال على التكوين مسحته","في صورة باكتمال الحسن وشّاها",47,"ا",3,0],["أُضفِّرُ شَعْرَهُنَّ على حروفي","وأدعو من جميلاتي الُّلبابا",48,"ب",2,0],["أضفت لزينتها دينا فقلدها","تاج الفضيلة والأخلاق في النَّسَمِ",49,"م",1,0],["أضفى الحياء عليه من نجابته","حتى حكى الخفرات الكنس الخردا",50,"د",2,0],["أضفتْ: أيرضيك المنال بما له","يفديك قلبي فانتهل مما لنا",51,"ن",2,0],["أضفى البهاء على عيشي تواجده","في خاطري جزوة الإلهام قد قدحا",52,"ح",2,0],["أضفتِ إليه تاريخاً","إلى عليائه قادَهْ",53,"د",2,0],["أَضْفى عَلى وَجْهِ السَّليقَةِ ذِكْرُنا","وَرَمَتْ مُؤابُ إلى الحَضيضِ مَغولا",54,"ل",2,0],["أضفْتُ أميراتِ الجمال طلاوةً","سقاني بها الهادي لأسْقي سَوائيا",55,"ي",2,0],["أَضَفْتَ إلى سنينَ العمر ذكرى","لِتَمسحَ دَمعةً وتضيفَ أُخرى",56,"ر",2,1],["أضفت إلى الجاري الذي لي إقامةً","أقمت بها حالي وأترى فقيرها",57,"ر",3,0],["أضفت إلى التليد طرف جاه","وقلبك بالمحامد مستهام",58,"م",1,0]]}