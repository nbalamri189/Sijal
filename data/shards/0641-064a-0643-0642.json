{"poems":[[53,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[333,"أبنجواي من رقيق النشيد","https://www.aldiwan.net/poem55060.html","الخفيف"],[366,"بابي شادنا تجدر فازداد","https://www.aldiwan.net/poem68101.html","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56287","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80011","الخفيف"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101234","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117990","الرمل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76443","الرمل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97091","الخفيف"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136736",""],[5689,"حطمت لي يد القضا كل فلس","https://www.poetsgate.com/ViewPoem.aspx?id=143434",""]],"verses":[["فيك قالت أئمَّةُ الشعر ما قا","لت بلا رؤية ولا لُقيان",0,"ن",1,0],["فيك قلبان ضارعان إلى الل","ه بعيدان عن ضلال الجدود",1,"د",1,0],["فيك قَد صار مُطلَق الدَمع مضنى","مُستَهاما لَم يَلق مِنكَ مُجيرا",2,"ر",2,0],["فيك قلبي لسادرٌ وعيوني","في سلامٍ غفت وراحة سرِ",3,"ر",1,0],["فيكَ قد أسكت الردى منه فحلاً","طالما قد ملأ النديَّ هديرا",4,"ر",2,0],["فيك قد أشرقت أشعة قدس","وأضاءت كما تضيء الشموس",5,"س",1,0],["فيك قد خاصمت عذّا","لي ولم أسمع ملام",6,"م",1,0],["فيكَ قنديك بِلا زيت يَرى","نوره العميان",7,"ن",1,0],["فيك قد حل سيد الرسل طه","وعلي وفاطم والآل",8,"ل",1,0],["فيكَ قد لامني العذولُ ولولا","ك لما راعَ قلبي التفنيدُ",9,"د",1,0],["فيكَ قد أينعت منازلُ جصان","وقد عمها الندى والجودُ",9,"د",1,0],["فيك قد طأطأ الوجود جلالا","إذ رأى آدم العلا كل رأس",10,"س",1,0],["فيك قد علم الأنام نظاما","نجب العرب بعد أنجاب فرس",10,"س",1,0]]}