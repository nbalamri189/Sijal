/ViewPoem.aspx?id=121654",""],[5136,"بمن يستغيث العبد إلا بمولاه","https://www.poetsgate.com/ViewPoem.aspx?id=121766",""],[5183,"عُمان","https://www.poetsgate.com/ViewPoem.aspx?id=186489",""],[5189,"كنْ يا أخي","https://www.poetsgate.com/ViewPoem.aspx?id=190549",""],[5219,"تواضع تكن ...","https://www.poetsgate.com/ViewPoem.aspx?id=194988",""],[5237,"بإحسان ذي الطول أهل الكرم","https://www.poetsgate.com/ViewPoem.aspx?id=113118",""],[5327,"الفَلُّ المَارِد !","https://www.poetsgate.com/ViewPoem.aspx?id=140752",""],[592,"ألا قل لذي جهلٍ بكل الحقائق","https://www.poetsgate.com/ViewPoem.aspx?id=128798",""],[5368,"طوقاً من نجاة","https://www.poetsgate.com/ViewPoem.aspx?id=184389",""],[5431,"تاج فوز....","https://www.poetsgate.com/ViewPoem.aspx?id=203359",""],[5472,"الى الله من عودتى توبتى","https://www.poetsgate.com/ViewPoem.aspx?id=200466",""],[5550,"يا ابن الوجود","https://www.poetsgate.com/ViewPoem.aspx?id=211770",""],[5689,"أراك بذي الدنيا الجفاء حبورها","https://www.poetsgate.com/ViewPoem.aspx?id=143409",""],[4623,"كتمت الهوى لكن نحولي به باحا ومن (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146769",""],[4623,"أرى الهجر لا يقوى على حمله القلب (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146606",""],[5845,"إذا عهدوا فليسَ لهمْ وفاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=198492",""],[5861,"جدال الروح","https://www.poetsgate.com/ViewPoem.aspx?id=190862",""],[1920,"كن للخير مفتاحا","https://www.poetsgate.com/ViewPoem.aspx?id=191388",""],[5956,"أرفرفُ كالطير في رمضانِ","https://www.poetsgate.com/ViewPoem.aspx?id=204409",""],[6089,"النبي الخاتم","https://www.poetsgate.com/ViewPoem.aspx?id=213039",""],[6152,"عافني واعف عني يا رب","https://www.poetsgate.com/ViewPoem.aspx?id=215643",""],[6152,"أعد فؤادي فنبضي لم يعد فيه","https://www.poetsgate.com/ViewPoem.aspx?id=215762",""],[6242,"يا أيها الشعر قد جددت أحزاني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87555&r=&rc=2",""]],"verses":[["وَكُن لِيَ في الأَولادِ وَالأَهلِ حافِظاً","إِذا ما اِطمَأَنَّ الجَنبُ في مَوضِعِ البَقا",0,"ق",2,0],["وَكُن لَها جَمَلاً ذَلولاً ظَهرُهُ","اِحمِل وَكُنتَ مُعاوِداً تَحمالَها",1,"ل",3,0],["وَكُن لي دَليلاً في الظَلامِ وَهادِياً","فَلَيلي بَهيمٌ وَالطَريقُ عِثارُ",2,"ر",1,0],["وَكُن لِعَلِيٍّ بَهجَةَ العُرسِ إِنَّهُ","بِعِزِّكَ في الأَفراحِ تَمَّت مَزاياهُ",3,"ا",2,0],["وَكُن لِما يُؤثِرُهُ مُقتَبِسا","وَاِخضَع إِذا لانَ وَلِن إِذا قَسا",4,"س",2,0],["وكُنْ لَطِيفاً بِنَا في كلِّ نَازِلَةٍ","لُطْفاً جَمِيلاً بهِ الأهْوَالُ تَنْحَسِرُ",5,"ر",1,0],["وَكن لَها مخترعاً","وَلا تكن مقلدا",6,"د",2,0],["وكن لما تملكه باذلا","ولا تهاون بقرى الضيف",7,"ف",1,0],["وَكُن لِلعِلمِ ذا طَلَبٍ وَبَحثٍ","وَناقِش في الحَلالِ وَفي الحَرامِ",8,"م",1,0],["وَكُن لِيَ مِن سَوراتِ عَتبِكَ مُؤمِناً","فَقَد جَلَّ في نَفسي وَإِن دَقَّ عَن فَهمي",9,"م",2,0],["وكن لي إلهي إنني العبد لامراء","وغاية ما عندي لك الشكر والحمد",10,"د",1,0],["وَكُن لَها وزراً ممّا ألمّ بها","فَقَد كَفاها على الأوزار تنكيلُ",11,"ل",1,0],["وكن لي في ذا اليوم ثمت في غد","شفيعا إلى الرحمن في محو زلتي",12,"ت",2,0],["وكن لي في الدنيا شفيعاً فإنني","لأرجوك في الأخرى لحشري وموقفي",13,"ف",2,0],["وكن لي مجيراً من خطوب لذي الحجى","الكريم إلى العمر اللئيم تؤض",14,"ض",1,0],["وَكُن لي إِلى جودِ الخَليفَةِ شافِعاً","أَنَل حاجَتي ما كُنتَ مِن شُفَعائي",15,"ي",1,0],["وَكُنْ لِي كُلَّمَا حِينٍ","تَدَاعَى الأَمْرُ لِلشَّخْزِ",16,"ز",1,0],["وُكُنْ لِي مُجِيراً مِنَ الْغَمَرَاتِ","فَسُقْمِي طَوِيلٌ وَدَائِي عَفَنْ",17,"ن",1,0],["وكن لي مقيلا من عثار اصابني","وان لم تكن لي عند نائبة من لي",18,"ل",2,0],["وَكن لقائلها عَبد الرَحيم اذا","ضاق الخناق له من أَمنع العصم",19,"م",1,0],["وكن لِدَخيل علته طَبيبا","بِلا نار وَلا طول اِنتظار",20,"ر",1,0],["وَكُن لهم غياثا","إِذا الزَمان عاثا",21,"ث",2,0],["وَكُن له كالنور","في ظُلمَةِ الدَيجورِ",21,"ر",1,0],["وكن للطف اللَه منتظراً","من حيث لا تدريه أو تدري",22,"ر",2,0],["وَكُن لِوُدّي إِذا ما شِئتَ مُحتَفِظاً","فَعِندي الوُدُّ أَحلا مِن نَوى وَصَبا",23,"ب",2,0],["وَكُن لِما شَرَعتَهُ في حُبِّها","مُتَّبِعاً مَطرَحاً عَنكَ الكَسَل",24,"ل",1,0],["وَكُن ليَ عَوناً فَالزَمان أَتاحَ لي","خُطوباً عَلى قَهري أَتَت تَتَحزَّبُ",25,"ب",1,0],["وَكُن لي شافِعا في يَومِ حَشر","اِذا ما اِشتَدَّ بِالناسِ البَلاء",26,"ا",2,0],["وكُنْ لي كالمُؤيَّدِ في اصطناعي","لِيُعْضَدَ أوّلٌ منكمْ بِثان",27,"ن",1,0],["وكن لنا عند ما نحشر حفاة عراه","وعافنا واعف عنا واعط كل رجاه",28,"ا",2,0],["وكن لنار بنا في كل حين","لا سيما عندما يحمي الجبين",29,"ن",1,0],["وكن لعبدك في أحواله","لكي يكن منك في رضوان",30,"ن",1,0],["وكن لي إليه على كل حال","ومن أنت له فوق سؤاله ينل",31,"ل",1,0],["وكن لنا عندما يرصف علينا المدر","وارحم الهي إذا صرنا بطون الحفر",32,"ر",1,0],["وكن لي سيدي في كل حال","وقدني للأمور المنجيات",33,"ت",1,0],["وكن لي سيدي في كل حال","ولارب تدعني للخطوب",34,"ب",1,0],["وكن لي سيدي في كل حال","وفي الدنيا وفي يوم الجزاء",35,"ا",2,0],["وكن لي إلهي غفوراً رحيماً","واغفر لعبدك خدني زياد",36,"د",1,0],["وكن لي مثل ما قد كن","ت منتقذي ومعتصمي",37,"م",2,0],["وكن لي على ما كنتَ أمسِ معوِّدي","غداً مستعِدّاً إنني بك لاحقُ",38,"ق",1,0],["وكن لي معيناً في الشؤون وناصراً","وغوثاً وذخراً واجبار لكسر بالنصرِ",39,"ر",1,0],["وكنْ لهم لأَجلِهِ مُصْطفِياً","قد يصطَفي العبدُ من الله اصْطَفَى",40,"ا",1,0],["وَكنْ للّذي يَقضي بِهِ اللَّه وَحدَه","وإنْ لم توافقه الأمانيُّ شاكرا",41,"ر",2,0],["وكن للذي يدعو بها حافظاً وكن","مجيباً له في كل ما كان ناويا",42,"ي",2,0],["وكن له خائفاً ومرتجياً","تمضي البلايا وتقبل النعم",43,"م",1,0],["وكن له مظهراً لا عنه محتجباً","فإن شمس الضحى بالبدر تنكسف",44,"ف",1,0],["وكنّ لنا مثالا في ثبات","وفوز الناس ينشأ من ثبات",45,"ت",1,0],["وكُن لإلهِ العالمين موحّداً","ولا تتّبع غير الّذي جاء في الكتبِ",46,"ب",1,0],["وَكُن لِلوَرى في رحلةٍ وَإِقامةٍ","ملاذاً لَهُ عَزم لَدى الخَطب ما وَهى",47,"ه",2,0],["وكن لراجيك خير حامٍ","فأنت من أفضل الحماةِ",48,"ه",1,0],["وَكُن لَهُ مُدبِّرا","وَواقياً وَكافِيا",49,"ي",2,0],["وكن لعيب مُؤاخ","يك ساترا أيَّ ساتر",50,"ر",1,0],["وكن لازماً تقوى الإله وكنْ له","مُطيعاً إليه كلَّ أمرٍ مُفَوِّضا",51,"ض",2,0],["وكن لجميع المسلمين وجازهم","بعدن وجنبهم لظى تتطرم",52,"م",1,0],["وكن للمسلمين ولا تكلهم","لغيرك يا إله المشرقين",53,"ن",1,0],["وكن لي في حياة ثم موت","وفي ظلم اللحود وفي معادي",54,"د",2,0],["وكن للمسمليمن وجد عليهم","بجود مستجاد مستعاد",54,"د",1,0],["وكن لأمير المؤمنين وصن به","حمى الدين من غارات أهل التمجس",55,"س",1,0],["وكن لوليّ العهد يا برّ آكسه","بفضلك في الدارين أجمل ملبس",55,"س",1,0],["وكن له حافظا معينا","ورقة شر كل عادي",56,"د",2,0],["وكن لجميع المسلمين إذا دعوا","لنيل مثوبات ورد مظالم",57,"م",1,0],["وكن لأمير المؤمنين الذي حمى","لنا الدين بالهندي والصعدة السمرا",58,"ر",2,0],["وكن لولي العهد واجزل ثوابه","وأيمن به الأرا ويسر له الأمرا",58,"ر",2,0],["وكن للمسلمين وجد بيمن","لأشياخي الذين بهم فخاري",59,"ر",2,0],["وكن لأمير المؤمنين الذي حمى","حمى الدين من أعدائه بالقواطع",60,"ع",1,0],["وكن لجميع المسلمين وجازهم","بعدن وجنبهم شرور المخادع",60,"ع",1,0],["وكن لجميع المسلمين وجازهم","بعدن وجنبهم لظى يتضرم",61,"م",1,0],["وكن لعبدك مولانا الخليفة عث","مان المليك الجليل الضيغم الشهما",62,"م",2,0],["وَكُنَّ لا يَطْلُبنَهُ بِذَحلِ","فَإِنْ تَرَيْنِي كَالحُسامِ النَحْلِ",63,"ل",1,0],["وكن لي وادفعن عن حنانا","بمن في الشمس ظل بالغمامه",64,"م",2,0],["وكن لنا دائماً والوالدين وأو","لاد وقينا الردى واردد غوائله",65,"ل",2,0],["وكن لي بما يأتي على طبق ما مضى","فقد كنت لي فيما مضى خير مسعف",66,"ف",1,0],["وكن لي حفيظاً يا رقيب وعاصماً","لنفسي من آفاتها البشرية",67,"ه",1,0],["وَكُن لِوَزير الحَج مِن أَورَد العِدى","وَرود حَتوف منهلاً بَعد منهل",68,"ل",1,0],["وَكُن لَهُ خَير جارٍ","أَلم يَجِدكَ يَتيما",69,"م",2,0],["وَكُن لي رَحيماً في البَلاء وَفي البَلى","بَدُنيا وَأُخرى يا رَجا كُل سائِلِ",70,"ل",1,0],["وكن لي شفيعا يوم لا ذو شفاعه","وأنت به يا أكرم الرسل شافع",71,"ع",1,0],["وكن لي في يوم الحساب مقابلا","بجبرك وامنحني هناك برحمة",72,"ه",1,0],["وكن لي شافعا في الحشر إذ لا","أرى لي والدا يغني ولا ابنه",73,"ن",2,0],["وكن لي شفيعا من لظى إن تلهبت","وشاهدت من هول القيامة موقفا",74,"ف",2,0],["وكنْ للكلّ في حِلم وعدل","فأنت الكلُّ ليس به انقسام",75,"م",1,0],["وَكن لي شافِعاً بالوصل إِنّي","محب وَالمحب هو الذَليل",76,"ل",1,0],["وكن لذويك إن دهت اللّيالي","صلاحاً فالثّنا للصّالحينا",77,"ن",2,0],["وكنْ لنا أملاً حتى نعيشَ به","لا يعرفُ العيشَ منْ لا يعرفُ الأمَلا",78,"ل",2,0],["وكن لنا وليّا وناصراً حفيا","لا نختشى غويّا بجاء عبدك العلى",79,"ل",2,0],["وكن لنا وأصلحنّ أمرنا","تولّنا وأجبرن كسرنا",80,"ن",2,0],["وكن لمحمَّد المأمونِ مما","يحاذرُ من صروف وامتهان",81,"ن",1,0],["وكن لوجه الدهر خالا فأقبلت","حوادث ردته عن الخال خاليا",82,"ل",3,0],["وكن لنا يا ربنا وليا","واجعل حلى التقوى لنا حليا",83,"ي",2,0],["وكن لنا يا ربنا نصيرا","فلم تزل بحالنا بصيرا",83,"ر",2,0],["وكن لنا موفقا مسددا","وموثرا مظفرا مؤيدا",83,"د",2,0],["وكن لما سن خير الرسل متبعا","ولا ترم غيره من سائر السبل",84,"ل",1,0],["وَكُن لَهُ مِن أَذَى الدَّارَين ياسَنَدِى","وأَصلِحِ الأهلَ وَالإِخَوانَ وَالوَلَدُ",85,"د",1,0],["وكن لنا ربِّ في دُنيا وآخرةٍ","فإنَّنا برسول اللَه نَنتَصِرُ",86,"ر",1,0],["وكن للحق عبداً يا ابن ودي","فعبدُ الحق في الدارين حرُّ",87,"ر",1,0],["وكن للصالحين أخا وخلا","وكن في هذه الدنيا غريبا",88,"ب",2,0],["وَكُن لَهُمو إِذا حَزَبَ الزَمانُ","يَداً تَذوي الحَصيبَ مِنَ الرُماةِ",89,"ه",1,0],["وكن لي من الخذلان ان لم تكنه لي","مجيرا وادخلني حماك الممنعا",90,"ع",2,0],["وكن لَّهُ راوية كالأصمعي","والجهلُ أولى بالذي لم يصدق",91,"ق",1,0],["وَكُن لي مَلجَأً في كُلِّ حالٍ","إِذا ما حُلَّ عَن صَبري الوِكاءُ",92,"ا",2,0],["وَكُن للرَعايا وَالِداً وَاعف عَنهُم","لتظفر في الدارين بِالأَجر وَالحَمد",93,"د",1,0],["وكن له كافلا تظفر بنيل هدى","واسأل لناظمه عفوا عن اللمم",94,"م",1,0],["وكن لمريد الظلم من أعظم البلا","إذا نشبت في المسلمين مخالبه",95,"ب",2,0],["وكن لأهل علم المعاني مجاورا","تمد من الأسرار في كل دفعة",96,"ه",1,0],["وكن لدين الحبيب أحمد حافظا","وطهره يا إلاهي من أهل ظلمة",96,"ه",1,0],["وكن لي في المأمولِ منكَ مُجَرِّباً","لتعلمَ ما آتي وما أتجنَّبُ",97,"ب",1,0],["وَكُن لِجَمعِ مُشبِهٍ مُفَاعِلاً","أوِ المَفَاعِيلَ بِمَنعٍ كافِلاً",98,"ل",2,0],["وَكُن لعقبى عُبَيد أَنت كُنت لَهُ","مِن قَبل أَن تَجعَل الأَشياء أَشياء",99,"ا",2,0],["وَكُن لِلوَرى رَوضاً ضوافٍ ظلالُه","مقيلاً وَناراً بِالشواظ توهج",100,"ج",1,0],["وكن لتشملك الألطاف مجتنباً","ما لا يحب وباعد عن مناهيه",101