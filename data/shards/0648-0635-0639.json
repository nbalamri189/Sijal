{"poems":[[30,"حلفت برب مكة والمصلى","https://www.aldiwan.net/poem4958.html","الوافر"],[30,"فسيرا فلا شيخين أحمق منكما","https://www.aldiwan.net/poem5283.html","الطويل"],[68,"كان الزمان بلقياكم يمنينا","https://www.aldiwan.net/poem40132.html","البسيط"],[89,"محا البين ما أبقت عيون المها مني","https://www.aldiwan.net/poem8240.html","الطويل"],[76,"شأوت مطايا الصبا مطلبا","https://www.aldiwan.net/poem12866.html","المتقارب"],[54,"يا دار يا دار أطرابي وأشجاني","https://www.aldiwan.net/poem26663.html","البسيط"],[77,"أقول دمى وهي الحسان الرعابيب","https://www.aldiwan.net/poem69105.html","الطويل"],[52,"مللت مبيتي بالقرين وشاقني","https://www.aldiwan.net/poem63905.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85473","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[102,"في بيتها العريق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67676&r=&rc=164",""],[119,"سألتك سربي مسرعا عن ديارهم","https://www.aldiwan.net/poem40427.html","عموديه"],[136,"ألا إن أم الخير سلمى أبوبكر","https://www.aldiwan.net/poem54673.html","الطويل"],[230,"وهبتك يا دهر من تطلب","https://www.aldiwan.net/poem55095.html","المتقارب"],[254,"أليلى على شحط المزار تذكر","https://www.aldiwan.net/poem2118.html","الطويل"],[261,"قل للأمير المرتجى","https://www.aldiwan.net/poem48550.html","مجزوء الرجز"],[266,"تذكر مهدا بالغوير ومعهدا","https://www.aldiwan.net/poem38337.html","الطويل"],[303,"ذر النفس لا يود الأسى بذمائها","https://www.aldiwan.net/poem36289.html","عموديه"],[310,"إلهي ذنوبي ما علمت وإنني","https://www.aldiwan.net/poem56602.html","الطويل"],[354,"أنا في فقدي وجودي","https://www.aldiwan.net/poem15630.html","مجزوء الرمل"],[369,"عدد لكم أن سرت في تشييعي","https://www.aldiwan.net/poem60845.html","الكامل"],[369,"خطبن وأيمان الكماة المنابر","https://www.aldiwan.net/poem60906.html","الطويل"],[371,"سأركب بحر الهوى مقدما","https://www.aldiwan.net/poem17056.html","المتقارب"],[382,"ذلت لعزة دينك الأديان","https://www.aldiwan.net/poem59237.html","الكامل"],[401,"فناد أباك يُورد ما عليه","https://www.aldiwan.net/poem576.html",""],[409,"بلد ما أقول فيها وقد","https://www.aldiwan.net/poem33911.html","الخفيف"],[422,"من معيد لي من عهد الألى","https://www.aldiwan.net/poem53974.html","الرمل"],[457,"لك الطائر الميمون فاسرج به طرفا","https://www.aldiwan.net/poem13844.html","الطويل"],[511,"وصعدة لبست سربال مشتهر","https://www.aldiwan.net/poem2379.html","البسيط"],[519,"هلم بنا يا برق في أبرق الحمى","https://www.aldiwan.net/poem20828.html","الطويل"],[520,"عادت عليك أهلة الأعياد","https://www.aldiwan.net/poem12061.html","الكامل"],[563,"إن ديني وملتي واعتقادي","https://www.aldiwan.net/poem34642.html","الخفيف"],[563,"ألا أيها الحادي لذاك الحمى سر بي","https://www.aldiwan.net/poem34950.html","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38766","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119939","المتقارب"],[1138,"","https://poetry.dctabudhabi.ae/diwan/poem/100655","المتقارب"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93094","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79984","الكامل"],[1755,"","https://poetry.dctabudhabi.ae/diwan/poem/87949","الطويل"],[1829,"","https://poetry.dctabudhabi.ae/diwan/poem/130571","الطويل"],[1886,"","https://poetry.dctabudhabi.ae/diwan/poem/130698","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28035","الطويل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137413",""],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76003","المتقارب"],[3024,"","https://poetry.dctabudhabi.ae/diwan/poem/138037","الخفيف"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100850","الطويل"],[3625,"","https://poetry.dctabudhabi.ae/diwan/poem/204080","الخفيف"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132090","الكامل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95324","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77017","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91046","الكامل"],[4257,"","https://poetry.dctabudhabi.ae/diwan/poem/117143","الرجز"],[5149,"حنانيكَ","https://www.poetsgate.com/ViewPoem.aspx?id=215289",""],[5183,"ثورة العراق","https://www.poetsgate.com/ViewPoem.aspx?id=185645",""],[5213,"أترى زورقا يقل الملاحا","https://www.poetsgate.com/ViewPoem.aspx?id=170429",""],[5320,"القومسيون","https://www.poetsgate.com/ViewPoem.aspx?id=43254",""],[5431,"نبعة النور مصر أرض السجود","https://www.poetsgate.com/ViewPoem.aspx?id=198662",""],[5431,"القصيدة الكونية ..وثقبُ الكون سبّاقُ ...","https://www.poetsgate.com/ViewPoem.aspx?id=199015",""],[5442,"لعل حداة العيش أن يترفقوا","https://www.poetsgate.com/ViewPoem.aspx?id=114754",""],[5442,"تقدم قبل الركب دمعي ليبقا","https://www.poetsgate.com/ViewPoem.aspx?id=114760",""],[5442,"هذا اللقاء وما شفيت غليلا","https://www.poetsgate.com/ViewPoem.aspx?id=114739",""],[5818,"ملهمة شعري","https://www.poetsgate.com/ViewPoem.aspx?id=199981",""],[6093,"يا عاذلَ الدَّمْعِ إنْ أجراهْ إنسانُ ( البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176207",""],[6093,"القصيدة الزبيدية في مدح خير البرية","https://www.poetsgate.com/ViewPoem.aspx?id=195006",""],[6102,"العراب","https://www.poetsgate.com/ViewPoem.aspx?id=182907",""]],"verses":[["وَصَعصَعَةَ المُجيرِ عَلى المَنايا","بِذِمَّتِهِ وَفَكّاكِ العُناةِ",0,"ه",1,0],["وَصَعصَعَةُ الخَيرِ الَّذي كانَ قَبلَهُ","يُشَرِّفُ حَوضاً في حَيا المَجدِ مُترَعا",1,"ع",2,0],["وَصَعبِ وِردٍ عَدَلناهُ بِأَسهَلِهِ","أَمّا هَواكَ فَلَم يُعدَل بِمَنهَلِهِ",2,"ه",1,0],["وَصَعْبٌ عَلَى ذِي اللُّبِّ رِئْمَانُ ذِلَّةٍ","يَظَلُّ بِهَا فِي قَوْمِهِ وَاهِيَ الْمَتْنِ",3,"ن",1,0],["وَصَعَّدتُ عَن حُبِّهِ زَفرَةً","يَكادُ لَها الصَدرُ أَن يَلهَبا",4,"ب",2,0],["وَصَعدَةٍ كَرِشاءِ البِئرِ ناهِضَةٍ","بِأَزرَقٍ كَاِتِّقادِ النَجمِ يَقظانِ",5,"ن",1,0],["وصَعْقٌ بُركْنِ الأفقِ وابنُ طهارة","يَذُبُّ عن الفرقانِ بالتاجِ معصوب",6,"ب",1,0],["وَصَعراءَ مِن مَسِّ الخِشاشِ كَأَنَّها","مَسيرَةُ صادٍ في الشُؤونِ اللَوابِدِ",7,"د",1,0],["وَصعدت في جبل سما","وَهبطت ثم هبطت وَهدا",8,"د",2,0],["وصعِّدوا في ذِلّةِ الضارعِ","أنفاسكم نشْوى بتلك العطورْ",9,"ر",1,0],["وصعدت كمجهول قلق","يختاز شعابا مجهوله !",10,"ل",2,0],["وصعب عليه ان يشاهد مرغما","منازل من يهوى على غير ما يهوى",11,"و",2,0],["وصَعبَةُ بِنتُ الحَضرَمِي أُمُّ طَلعَةٍ","وَهِي مِن بني قَحطَانَ أهلِ القَنَا السُّمرِ",12,"ر",1,0],["وَصعبٌ على الحُرِّ فيه المُقام","وَلكنَّ هِجرانهُ أَصعبُ",13,"ب",1,0],["وَصَعبٌ يَزِلُّ الغَفرَ عَن قُذُفاتِهِ","بِحافاتِهِ بانٌ طِوالٌ وَعَرعَرُ",14,"ر",1,0],["وصعدا ونزلا","ودخلا وخرجا",15,"ج",2,0],["وصعب الهوى سهل لمن كان عاشقا","سوى ان يرى فيه العذول المفندا",16,"د",2,0],["وصعَّدتُ في آثارِ قوميَ زفرةً","أَلنتُ بها صمَّ الصفا والسواريا",17,"ي",2,0],["وَصعبٌ بقاءٌ وَاِصطبارٌ على الأذى","وَلكن خلاصي منه أَنكى وأصعبُ",18,"ب",1,0],["وَصُعودي في هُبوطي","وَهُبوطي في صُعودي",19,"د",2,0],["وصُعودُ هذي الشُّهْبِ بعدَ تَصوُّبٍ","وكذا استقامَتُهُنَّ بَعد رُجوع",20,"ع",1,0],["وصَعْبٌ بلا إسعادِ صَحبٍ نفائسٍ","إذا لم يكنْ بعضٌ لبعضٍ يُضافر",21,"ر",1,0],["وَصَعبَينِ مِن لَوعَتي وَالوِصالِ","فَلا تِلكَ هانَت وَلا ذا اِتَّفَق",22,"ق",1,0],["وصعدتَ من بعد اَن هدمتَ حصونَه","وتقوَّضت من بأسك الأركان",23,"ن",1,0],["وصَعّد إن أصلك من مُعالِ","بِبَيذخَ حيث تعرفُكَ الديارُ",24,"ر",1,0],["وصعدنا لموقف الحج في لي","لة خير لصبحها إسفار",25,"ر",1,0],["وصعابٌ للمعالي لم تُقَدْ","قادها من غير كرهٍ ذُلُلا",26,"ل",2,0],["وصعِّد وضوِّب نظرةً بعد نظرةٍ","فما ثَم إِلاّ الخير فامدد له كفا",27,"ف",2,0],["وصعدةٍ لبست سربال مشتهر","بالحب منغمس في السهد والأرق",28,"ق",1,1],["وصعبٌ إذا اِستعطَفتَه لانَ جانباً","وعذْبٌ إذا عادَيْتَه صارَ عَلقَما",29,"م",2,0],["وصعدت ذورة منبر أبقيت في","شرفاته شرفاً على الأعواد",30,"د",1,0],["وصعدت العلا وخلَّفتُ جسمي","في يدي أصدقائه والأعادي",31,"د",2,0],["وصعب الهوى سهلٌ إذا كثر الرجا","وأنواع أفراح به شدة الكرب",32,"ب",1,0],["وَصَعد فيها رُمحَهُ نَحوَ صفّهِم","وَجَرَّدَ فيها عَضبهُ الماضِيَ الحدِّ",33,"د",1,0],["وصعرت خدا لمن لم يزل","أخا كبريا وأرغت أنفا",34,"ف",2,0],["وصعب على المرء تكليفه","أمورا خلاف الذي يعهدُ",35,"د",1,0],["وصعد أقذاءً لعينيك عن دم","فأوشك أن يجري مع الدمع صيبا",36,"ب",2,0],["وصعابِ أمرٍ أسلستْ","مذ راضَها من بعد نخوه",37,"و",2,0],["وَصع فَتخَةً في خِنصَري لِتَكونَ لي","مذَكِّرَةً إِن كنتَ تَعزُب عن ذِكرى",38,"ر",2,0],["وَصَعبٌ تَرَقّى المَرءِ في دَرَجِ العُلا","وَسَهلٌ تَدَلّى المَرءِ في دَرَكِ الحَدر",38,"ر",1,0],["وصعدني همي وصوب مرةً","وذو الهم يوماً مصعد ومصوب",39,"ب",1,0],["وصَعَّبَ ملقاها وسهَّلَ عيشَها","وَزَيَّنَ مرآها فللَّهِ ما أدرى",40,"ر",2,0],["وصعقٌ وجودُ الحقِّ في دارِ غربتي","فلا صقعٌ أعلى في المنازلِ من صعقي",41,"ع",3,0],["وصعدت من رتب المفاخر ذروة","يلو لها التعظيم والاكرام",42,"م",1,0],["وَصَعبٌ عَلى مَن لَهُ عادَةٌ","وَيَألَفُها تركُ مألوفِهِ",43,"ف",2,0],["وَصِعابَ الْخُطوبِ وَاْلآلامِ","وَشِدادَ الْجُروحِ وَاْلاََسْقامِ",44,"م",1,0],["وصعب على قلب رآك مجنه","فلم تك عنه في الكريهة واقيا",45,"ي",2,0],["وصعيد يحول نبتاً نضيراً","مونق الروض مورق الأشجار",46,"ر",1,0],["وصعدت في فلك الجلالة مثلما","صعد النبي بهودجٍ من نارَ",47,"ر",1,0],["وصَعيدُ بَيتٍ حَله فركائبي","تَسعى به دُونَ البيوت وترملُ",48,"ل",1,0],["وصعدت تؤج كما","بليلٍ حالكٍ سطعت",49,"ت",1,0],["وَصعاد قامات الخَراعِب اِحكَمت","في قَلبِهِ وَلَها بِهِ تَكسير",50,"ر",1,0],["وصعود معراج إلى تشبيهه","من قاب قوسين المقام أشارا",51,"ر",2,0],["وصعدوا عليه ثم نزلوا","سعياً وفيما بين ذاك أرملوا",52,"ل",3,0],["وَصَعَّرْتُ خَدِّي لِلبَلاءِ وَخَطْبِهِ","وَأبدَيْتُ صَبراً، في عَوَاقِبِهِ بِشْرُ",53,"ر",1,0],["وصعقت ومن والاك وهل","يَرثَى لك من تتوعَّده",54,"د",2,0],["وصعيب بأنهن نصارى","أيرى عنه دينهن فلاحا",55,"ح",2,0],["وصعب الحياة وخلو الوفا","ض وما للصغيرة من يرعها",56,"ه",2,0],["وصعيدٌ يقدم القلب قمحا","بسمة الله في شفاه الصعيدِ",57,"د",1,0],["وصعقة الفلك عند اللمس زلزلةٌ","تَمزقُ الروح أشلاءٌ وأطباقُ",58,"ق",1,0],["وصعد كفيه وقد أمسك الحيا","فما صوباً حتى غدا يتدفق",59,"ق",1,0],["وصعد كفيه وقد أمسك الحيا","فما رجعا حتى انبرى متدفقا",60,"ق",2,0],["وصعدت مع جبريل حتى القاب من","قوسين أو أدنى بلغت حلولا",61,"ل",2,0],["وصعبٌ كان يا عمري","وكان جوابي الأصعبْ",62,"ب",1,0],["16. وصَعْدةُ الحقِّ قد هُزَّت فأرسلها","في نَحْرِ صعدةَ آسادٌ وشُجعان",63,"ن",1,0],["39.وَصَعَدَّتَ حَتَّى قَدْ بَلَغْتَ المُنْتَهَى","والمُبْتَدَا حَيْثُ الَّذِي سَوَّاكَا",64,"ك",2,0],["وَ صُعِقتَ بِالتَّيَّارِ بَينَ نُهُودِها","إِمَّا اقتَحَمتَ تَجاذُبَ الأَقطابِ !",65,"ب",1,0]]}