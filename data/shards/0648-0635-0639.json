{"poems":[[28,"حلفت برب مكة والمصلى","https://www.aldiwan.net/poem4958.html","الوافر"],[28,"فسيرا فلا شيخين أحمق منكما","https://www.aldiwan.net/poem5283.html","الطويل"],[66,"كان الزمان بلقياكم يمنينا","https://www.aldiwan.net/poem40132.html","البسيط"],[87,"محا البين ما أبقت عيون المها مني","https://www.aldiwan.net/poem8240.html","الطويل"],[74,"شأوت مطايا الصبا مطلبا","https://www.aldiwan.net/poem12866.html","المتقارب"],[52,"يا دار يا دار أطرابي وأشجاني","https://www.aldiwan.net/poem26663.html","البسيط"],[75,"أقول دمى وهي الحسان الرعابيب","https://www.aldiwan.net/poem69105.html","الطويل"],[50,"مللت مبيتي بالقرين وشاقني","https://www.aldiwan.net/poem63905.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85473","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[100,"في بيتها العريق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67676&r=&rc=164",""],[116,"سألتك سربي مسرعا عن ديارهم","https://www.aldiwan.net/poem40427.html","عموديه"],[133,"ألا إن أم الخير سلمى أبوبكر","https://www.aldiwan.net/poem54673.html","الطويل"],[226,"وهبتك يا دهر من تطلب","https://www.aldiwan.net/poem55095.html","المتقارب"],[250,"أليلى على شحط المزار تذكر","https://www.aldiwan.net/poem2118.html","الطويل"],[257,"قل للأمير المرتجى","https://www.aldiwan.net/poem48550.html","مجزوء الرجز"],[262,"تذكر مهدا بالغوير ومعهدا","https://www.aldiwan.net/poem38337.html","الطويل"],[299,"ذر النفس لا يود الأسى بذمائها","https://www.aldiwan.net/poem36289.html","عموديه"],[306,"إلهي ذنوبي ما علمت وإنني","https://www.aldiwan.net/poem56602.html","الطويل"],[350,"أنا في فقدي وجودي","https://www.aldiwan.net/poem15630.html","مجزوء الرمل"],[365,"عدد لكم أن سرت في تشييعي","https://www.aldiwan.net/poem60845.html","الكامل"],[365,"خطبن وأيمان الكماة المنابر","https://www.aldiwan.net/poem60906.html","الطويل"],[367,"سأركب بحر الهوى مقدما","https://www.aldiwan.net/poem17056.html","المتقارب"],[378,"ذلت لعزة دينك الأديان","https://www.aldiwan.net/poem59237.html","الكامل"],[397,"فناد أباك يُورد ما عليه","https://www.aldiwan.net/poem576.html",""],[404,"بلد ما أقول فيها وقد","https://www.aldiwan.net/poem33911.html","الخفيف"],[417,"من معيد لي من عهد الألى","https://www.aldiwan.net/poem53974.html","الرمل"],[453,"لك الطائر الميمون فاسرج به طرفا","https://www.aldiwan.net/poem13844.html","الطويل"],[507,"وصعدة لبست سربال مشتهر","https://www.aldiwan.net/poem2379.html","البسيط"],[515,"هلم بنا يا برق في أبرق الحمى","https://www.aldiwan.net/poem20828.html","الطويل"],[516,"عادت عليك أهلة الأعياد","https://www.aldiwan.net/poem12061.html","الكامل"],[559,"إن ديني وملتي واعتقادي","https://www.aldiwan.net/poem34642.html","الخفيف"],[559,"ألا أيها الحادي لذاك الحمى سر بي","https://www.aldiwan.net/poem34950.html","الطويل"]],"verses":[["وَصَعصَعَةَ المُجيرِ عَلى المَنايا","بِذِمَّتِهِ وَفَكّاكِ العُناةِ",0,"ه",1,0],["وَصَعصَعَةُ الخَيرِ الَّذي كانَ قَبلَهُ","يُشَرِّفُ حَوضاً في حَيا المَجدِ مُترَعا",1,"ع",2,0],["وَصَعبِ وِردٍ عَدَلناهُ بِأَسهَلِهِ","أَمّا هَواكَ فَلَم يُعدَل بِمَنهَلِهِ",2,"ه",1,0],["وَصَعْبٌ عَلَى ذِي اللُّبِّ رِئْمَانُ ذِلَّةٍ","يَظَلُّ بِهَا فِي قَوْمِهِ وَاهِيَ الْمَتْنِ",3,"ن",1,0],["وَصَعَّدتُ عَن حُبِّهِ زَفرَةً","يَكادُ لَها الصَدرُ أَن يَلهَبا",4,"ب",2,0],["وَصَعدَةٍ كَرِشاءِ البِئرِ ناهِضَةٍ","بِأَزرَقٍ كَاِتِّقادِ النَجمِ يَقظانِ",5,"ن",1,0],["وصَعْقٌ بُركْنِ الأفقِ وابنُ طهارة","يَذُبُّ عن الفرقانِ بالتاجِ معصوب",6,"ب",1,0],["وَصَعراءَ مِن مَسِّ الخِشاشِ كَأَنَّها","مَسيرَةُ صادٍ في الشُؤونِ اللَوابِدِ",7,"د",1,0],["وَصعدت في جبل سما","وَهبطت ثم هبطت وَهدا",8,"د",2,0],["وصعِّدوا في ذِلّةِ الضارعِ","أنفاسكم نشْوى بتلك العطورْ",9,"ر",1,0],["وصعدت كمجهول قلق","يختاز شعابا مجهوله !",10,"ل",2,0],["وصعب عليه ان يشاهد مرغما","منازل من يهوى على غير ما يهوى",11,"و",2,0],["وصَعبَةُ بِنتُ الحَضرَمِي أُمُّ طَلعَةٍ","وَهِي مِن بني قَحطَانَ أهلِ القَنَا السُّمرِ",12,"ر",1,0],["وَصعبٌ على الحُرِّ فيه المُقام","وَلكنَّ هِجرانهُ أَصعبُ",13,"ب",1,0],["وَصَعبٌ يَزِلُّ الغَفرَ عَن قُذُفاتِهِ","بِحافاتِهِ بانٌ طِوالٌ وَعَرعَرُ",14,"ر",1,0],["وصعدا ونزلا","ودخلا وخرجا",15,"ج",2,0],["وصعب الهوى سهل لمن كان عاشقا","سوى ان يرى فيه العذول المفندا",16,"د",2,0],["وصعَّدتُ في آثارِ قوميَ زفرةً","أَلنتُ بها صمَّ الصفا والسواريا",17,"ي",2,0],["وَصعبٌ بقاءٌ وَاِصطبارٌ على الأذى","وَلكن خلاصي منه أَنكى وأصعبُ",18,"ب",1,0],["وَصُعودي في هُبوطي","وَهُبوطي في صُعودي",19,"د",2,0],["وصُعودُ هذي الشُّهْبِ بعدَ تَصوُّبٍ","وكذا استقامَتُهُنَّ بَعد رُجوع",20,"ع",1,0],["وصَعْبٌ بلا إسعادِ صَحبٍ نفائسٍ","إذا لم يكنْ بعضٌ لبعضٍ يُضافر",21,"ر",1,0],["وَصَعبَينِ مِن لَوعَتي وَالوِصالِ","فَلا تِلكَ هانَت وَلا ذا اِتَّفَق",22,"ق",1,0],["وصعدتَ من بعد اَن هدمتَ حصونَه","وتقوَّضت من بأسك الأركان",23,"ن",1,0],["وصَعّد إن أصلك من مُعالِ","بِبَيذخَ حيث تعرفُكَ الديارُ",24,"ر",1,0],["وصعدنا لموقف الحج في لي","لة خير لصبحها إسفار",25,"ر",1,0],["وصعابٌ للمعالي لم تُقَدْ","قادها من غير كرهٍ ذُلُلا",26,"ل",2,0],["وصعِّد وضوِّب نظرةً بعد نظرةٍ","فما ثَم إِلاّ الخير فامدد له كفا",27,"ف",2,0],["وصعدةٍ لبست سربال مشتهر","بالحب منغمس في السهد والأرق",28,"ق",1,1],["وصعبٌ إذا اِستعطَفتَه لانَ جانباً","وعذْبٌ إذا عادَيْتَه صارَ عَلقَما",29,"م",2,0],["وصعدت ذورة منبر أبقيت في","شرفاته شرفاً على الأعواد",30,"د",1,0],["وصعدت العلا وخلَّفتُ جسمي","في يدي أصدقائه والأعادي",31,"د",2,0],["وصعب الهوى سهلٌ إذا كثر الرجا","وأنواع أفراح به شدة الكرب",32,"ب",1,0]]}