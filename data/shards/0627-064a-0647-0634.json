{"poems":[[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[88,"سكن الفيلسوف بعد اضطراب","https://www.aldiwan.net/poem10484.html","الخفيف"],[107,"تلك العروبة جرحها يجري دما","https://www.aldiwan.net/poem42060.html","الكامل"],[107,"قومي أهاب من الحياة بشير","https://www.aldiwan.net/poem42068.html","الكامل"],[107,"قل للحسين ولات حين ملام","https://www.aldiwan.net/poem43043.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39584","الكامل"],[6,"معلقة الحارث بن حلزة اليشكري","https://www.poetsgate.com/ViewPoem.aspx?id=11409",""],[92,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[228,"لا لقوم ولا لدين","https://www.aldiwan.net/poem39694.html","مجزوء الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64249","الرمل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145856","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48977","الخفيف"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130068","الرمل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66155","الرجز"],[4739,"الملهمة","https://www.poetsgate.com/ViewPoem.aspx?id=28035",""],[4782,"رِحَال الليل","https://www.poetsgate.com/ViewPoem.aspx?id=202629",""],[5335,"لون المسا","https://www.poetsgate.com/ViewPoem.aspx?id=35184",""],[5335,"كيف اخذت الملح كله وانت حالي","https://www.poetsgate.com/ViewPoem.aspx?id=35188",""],[5883,"شيطان الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=22789",""],[5943,"رقصَ العقالُ","https://www.poetsgate.com/ViewPoem.aspx?id=52930",""]],"verses":[["آيةٌ شارِقُ الشَقيقَةِ إِذ جا","ءَوا جَميعاً لِكُلِّ حَيٍّ لِوَاءُ",0,"ا",2,0],["إيهِ شِبلي قَد أَكثَرَ الناسُ فيكَ ال","قَولَ حَتّى تَفَنَّنوا في عِتابي",1,"ب",2,0],["إيهٍ شُعوبَ المُسلِمينَ تنبَّهوا","وتَدَاركوا أَسْبابَكم أن تُجْذَما",2,"م",2,0],["إيهٍ شُعوبَ الإنس إن لم تنهضوا","فالعيشُ جَهلٌ والحياةُ غُرورُ",3,"ر",1,0],["إيهٍ شُعوب المسلمين أَنوَّمٌ","أم أنتِ يقظَى بعد طول مَنامِ",4,"م",1,0],["إيهِ شواطئَ مصرَ والدنيا مُنىً","تهفو إليكِ بنا صباحَ مساءَ",5,"ا",2,0],["آيةٌ شارق الشقيقة إذ جا","ءت معدٌ لكل حيٍ لواء",6,"ا",2,0],["إيهٍ شبابَ الرافدين ومَنْ بهم","يرجو العراقُ تَبَلّجَ الأسحار",7,"ر",1,0],["إيهِ شَوقي فَحافِظٌ","كانَ أَشقى وَأَعظَما",8,"م",2,0],["إيهِ شَوقي فَحافِظٌ","كانَ في بُؤسِهِ أَحَب",8,"ب",1,0],["أَيَّةً شَطَّتْ نَوَى الأظْ","عانِ لا شَطَّتْ نَوَاها",9,"ا",3,0],["إيه شِّعري أيَا لُعِنْتَ مُخيفاً","منجَلٌ أنتَ والبقايا حَصادُ",10,"د",1,0],["إيه شيخَ الهُدى بررتَ بوادٍ","قد رضعتَ الإباءَ في أحضانهْ",11,"ن",2,0],["إيه شوقي إن منثور العُلا","لم يَفُز في جمعهِ أحدٌ سِواك",12,"ك",1,0],["ايهِ شَبابَ العُرْبِ يا زَهْرَ الرُّبا","ماذا تُعِدُّونَ لاتٍ قَدْ دَنا",13,"ا",1,1],["إِيهِ شَبابَ العُرْبِ أَحْيُوا أُمَّةً","يَشْغَلُها عَنِ الهُدَى داعي الهَوَى",13,"ا",1,0],["ايهِ شَبابَ العُرْبِ لا فَخْرَ سِوَى","ما قَدْ عَمِلْتُمْ وسِوَى هذا هَبا",13,"ا",1,0],["ايهِ شَبابَ العُرْبِ هُبُّوا فالكَرى","قَدْ ارْهَقَ البُلْدانَ ذُلا وشَقا",13,"ا",1,0],["إيه شاعر.. وانتي أعذب شاعره","معك اعيش الحب.. وارجع اكتبه",14,"ب",2,1],["إيهِ شِعري سنَّمَ الليلُ رحالَهْ","وبجنبي خافقٌ ملّ اشتعالهْ",15,"ل",2,1],["ايه شفت الحب بعيونك وشفتك","اذكرْانك جيت ضيف ورحت غالي",16,"ل",2,0],["ايه شفت الحب بعيونك وشفتك","واذكرْانك جيت ضيف ورحت غالي",17,"ل",2,0],["إيهٍ شيطان الشعر لقد","زينت لقلبي الأفكارا",18,"ر",2,0],["إيهٍ شبابَ العربِ لاترضوا بما","فيه احتذيتمْ بالرؤوسِ نعالا",19,"ل",2,0]]}