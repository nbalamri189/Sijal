{"poems":[[95,"لم تشق نفس أنت مسعدها","https://www.aldiwan.net/poem11086.html","أحذ الكامل"],[58,"حتى أصادف مالا أو يقال فتى","https://www.aldiwan.net/poem58616.html","البسيط"],[45,"من الجآذر في زي الأعاريب","https://www.aldiwan.net/poem9507.html","البسيط"],[47,"أما لعيني طليح الشوق تغميض","https://www.aldiwan.net/poem64638.html","البسيط"],[186,"مضى أغابيوس المفضال اسقفنا","https://www.aldiwan.net/poem66931.html","البسيط"],[199,"ما هاج شوقك من مغاني دمنة","https://www.aldiwan.net/poem54420.html","الكامل"],[228,"لبيك يا قلب ماض فيك ناداني","https://www.aldiwan.net/poem39693.html","البسيط"],[415,"لأرمين بنفسي كل مهلكة","https://www.aldiwan.net/poem31685.html","عموديه"],[445,"الشمس شاهدة وإن تك واحده","https://www.aldiwan.net/poem34857.html","الكامل"],[473,"لا أنس أيامي ولا أطرابي","https://www.aldiwan.net/poem60426.html","الكامل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48632","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48594","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77528","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77510","الرجز"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130636","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80000","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79986","الكامل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87835","الكامل"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33888","السريع"],[2212,"","https://poetry.dctabudhabi.ae/diwan/poem/202379","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88658","الرجز"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111247","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74174","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138696",""],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132096","الكامل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117283","الكامل"],[5074,"طفولة","https://www.poetsgate.com/ViewPoem.aspx?id=153511",""],[5100,"كل نفس ذائقة الحبّ","https://www.poetsgate.com/ViewPoem.aspx?id=207695",""],[5183,"الصاروخ","https://www.poetsgate.com/ViewPoem.aspx?id=180184",""],[5363,"لمن جرّح في السيد قطب","https://www.poetsgate.com/ViewPoem.aspx?id=144286",""],[5596,"تقريض كتاب دالية المحقق الخليلي","https://www.poetsgate.com/ViewPoem.aspx?id=206711",""],[5606,"الوحده أحسن من اللي رفقته بايره","https://www.poetsgate.com/ViewPoem.aspx?id=194252",""],[5725,"النار في جسدي","https://www.poetsgate.com/ViewPoem.aspx?id=201832",""],[5809,"وددت","https://www.poetsgate.com/ViewPoem.aspx?id=205563",""],[5977,"يا نعمة الرحمن","https://www.poetsgate.com/ViewPoem.aspx?id=213533",""],[6078,"جرحٌ يتأوّه","https://www.poetsgate.com/ViewPoem.aspx?id=202776",""],[199,"ما هاجَ شوقكَ من مغاني دمنة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=20777",""],[6124,"شقراء مرت","https://www.poetsgate.com/ViewPoem.aspx?id=174657",""],[186,"مضي أغابيوس المفضال اسقفنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55874&r=&rc=137",""],[6203,"عاشق.. يتعثر في بردته!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88024&r=&rc=2",""],[6225,"أنِين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81027&r=&rc=264",""]],"verses":[["حتى أصاب الود مشرعةً","عذبت لديك وطاب موردها",0,"د",3,0],["حتّى أُصَادِفَ مالاً أَوْ يُقَالَ فَتىً","لاقَى الرَّدَى بَيْنَ أَسْيافٍ وأَرْمَاحِ",1,"ح",1,1],["حَتّى أَصابَ مِنَ الدُنيا نِهايَتَها","وَهَمُّهُ في اِبتِداءاتٍ وَتَشبيبِ",2,"ب",1,0],["حَتّى اِصطَفَيتُ أُموراً كُنتُ أَرفُضُها","وَيُصطَفى الأَمرُ يَوماً وَهوَ مَرفوضُ",3,"ض",1,0],["حَتّى اِصطَفاهُ لِتاجِ المَجد خالِقُهُ","فَكُلُّنا أَرِّخوا يَبغي شَفاعَتَهُ",4,"ت",2,0],["حَتّى اِصطَلى وَهَجَ المَقيطِ وَخانَهُ","أَبقى مَشارِبَهُ وَشابَ عَثاها",5,"ا",3,0],["حَتّى أَصابَ سَراهَ العَصرِ ناحِيَةً","يَمُجُّ فيها سَحابَ الظِلِّ كَهفانِ",6,"ن",1,0],["حتى أصادف حتفي فهو أجمل بي","من الخمول وأستغني عن الناس",7,"س",1,0],["حَتَّى اصطفى لَكَ من صَوَافِنِ خَيْلِهِ","عِلْقاً لَهُ لَمْ يَدَّخِرْكَ فوائِدَهْ",8,"د",2,0],["حَتّى أُصِبتُ بِقُربِهِم فَأَصابَني","قَلَقٌ يَقِلُّ كَثيرَهُ لِمَصابي",9,"ب",2,0],["حتى أصاب غرّة فقتله","لحقده عليه فيما فعله",10,"ه",1,0],["حتى أصابه بها ابن ملجم","وخضب الشيبة منه بالدم",10,"م",1,0],["حتى أصابك من يد ال","موت الزؤام اليوم صائبْ",11,"ب",1,0],["حتى أصابتني بآفتها","زمناً وحل الداء بالبطن",12,"ن",1,0],["حَتّى أَصابَت قامَة البَلُّوط","وَنَزَلَت بِهِ إِلى الهُبوط",13,"ط",1,0],["حَتّى أُصيب كُلُّ مَن بِالغابه","بِما جَناه غاية الإِصابه",14,"ه",1,0],["حتى اصابك سهمه فاصاب من","قلبي سويداه فشب وقودا",15,"د",2,0],["حتَّى اصطفى من عزةٍ دارَ عُلى","ترفع كفُّ المجد من عمادها",16,"د",3,0],["حتَّى أصبتَ صميمَ قلبي بغتةً","وطرقتني بفجيعةٍ صمَّاءِ",17,"ا",2,0],["حَتّى أُصِبتُ بِها بِمُنعَرَجِ اللِوى","ما بَينَ دَيروطٍ وَبَينَ شِعابِها",18,"ب",3,0],["حَتّى أَصارَتهُ اللَيالي لَقىً","يَعافُهُ مَن كانَ مِنهُ قَريب",19,"ب",1,0],["حتى اصطفا ماله ظلما وكان على","ما ناله منه في سيخوخة الهرم",20,"م",1,0],["حَتَّى أصلِّي العَصرَ قَبلَ فَوَاتِها","قَالاَ سَتَفعَلُ ذَاكَ بَعدَ الآنِ",21,"ن",1,0],["حتىّ اصبت من شعاب مكه","ما شعب الفواد حتىّ انصدعا",22,"ع",2,0],["حتى اصيب بخنجر في فخذه","وجراحة بلغت إلى الأحشاء",23,"ا",2,0],["حَتّى اِصطَفاكَ وَلي الأَمر مُرتَضياً","إِذ فيكَ أَمر صَلاح الناس مَحصور",24,"ر",1,0],["حتى أصابوا بالنبال سقائه","فكأنها في قلبه الحران",25,"ن",1,0],["حتى أصبتُ وذقت من ويلاته","ما لم أذق وجرعت ما لم أجرع",26,"ع",1,0],["حتى أصيبَ القلب يوم وداعهم","سحراً بسهم للفؤاد مريع",27,"ع",1,0],["حَتَّى أَصَابَتْ مِنْ فُؤَادِيْ مَقْتَلاً","فَعَلِمْتُ أنِّيْ لَسْتُ كُفءَ نِزَالِ",28,"ل",1,0],["حتى اصطليتُ بنارهِ وخَبِرتُهُ","فندمت عمّا قد جنتهُ يديّا",29,"ي",2,0],["حتى أصاب من الحياة مراده","واستل بغيته من الأحجار",30,"ر",1,0],["حتى أصاب بمزنة النور البلا","د فأعشبت ألقاً بسيل حكيمِ",31,"م",1,0],["حتى اصطفاك إله العرش محتسباً","له الشهادة فاستدناك للحرم",32,"م",1,0],["حتى أصبح اللي يهد أكثر من اللي يشيد","والحال مثل المريض إلى بكى زائره",33,"ر",2,0],["حتى اصطلى بردي من شدّة الكمدِ","لجّت بمرتعد نوق المجانينِ",34,"ن",1,0],["حتَّى أُصَلِّي صَلاةً أَسْتريحُ بِهَا","أَهذِّبُ النَّفْسَ فِي المِحْرابِ تَذْلِيلا",35,"ل",2,0],["حتى أصاب القلب يوما وحشةٌ","لتباعد الأحبابِ والخلّانِ",36,"ن",1,0],["حتّى اصطدمتُ بجدرانٍ تحاصرنا","لكلِّ بابٍ متاهاتٌ من الغرفِ",37,"ف",1,0],["حَتَّى اصْطَلَى وَهَجَ المَقِيْظِ وَخَانَهُ","أبقى مشاربه وشاب عثاها",38,"ا",3,0],["حتى أصابتْ في المدى قلبَ الندى","والصبحُ من غير الندى ذاقَ المللْ",39,"ل",1,0],["حتى اصطفاه لتاج المجد خالقه","فلكنا أرخوا يبغي شفاعته",40,"ت",2,0],["حتى أصابعيَ الولهى كم اشتبكتْ","على الحروفِ وأبكتْ مَحْجَرَ القَلَمِ",41,"م",1,0],["حتى أصبتَ لهُ مِن كلِّ أغنيةٍ","ذكرَى , وأحكمتَ فيهِ السِحرَ ما وسِعَكْ",42,"ك",1,0]]}