{"poems":[[110,"سطا حُسناً","https://www.shoaraa.com/p13815",""],[55,"نغالب ثم تغلبنا الليالي","https://www.aldiwan.net/poem29886.html","الوافر"],[95,"تحية أيها القتلى وتسليماً","https://www.aldiwan.net/poem11387.html","البسيط"],[95,"أبيت والسيف يعلو الرأس تسليماً","https://www.aldiwan.net/poem11419.html","البسيط"],[87,"يمد الدجى في لوعتي ويزيد","https://www.aldiwan.net/poem63672.html","الطويل"],[45,"من الجآذر في زي الأعاريب","https://www.aldiwan.net/poem9507.html","البسيط"],[35,"طربت وهاجتك الديار البلاقع","https://www.aldiwan.net/poem25889.html","الطويل"],[48,"ضحكنا وكان الضحك منا سفاهة","https://www.aldiwan.net/poem23065.html","الطويل"],[48,"قران المشتري زحلا يرجى","https://www.aldiwan.net/poem23581.html","الوافر"],[87,"يمدُّ الدُّجى في لوعتي ويزيدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9543&r=&rc=33",""],[158,"قيود الأحرار","https://www.aldiwan.net/poem932.html",""],[240,"نار جوى في الضلوع تتقد","https://www.aldiwan.net/poem32028.html","المنسرح"],[353,"برغمي إن خلت منه المذاود","https://www.aldiwan.net/poem20065.html","الوافر"],[369,"هم نازلون بقلبي أية سلكوا","https://www.aldiwan.net/poem60817.html","البسيط"],[422,"لأسماء دار حيث منقطع الرمل","https://www.aldiwan.net/poem53930.html","الطويل"],[438,"طرحنا فوق غاربها الزمانا","https://www.aldiwan.net/poem12375.html","الوافر"],[438,"أجودك أم جود المطر","https://www.aldiwan.net/poem12399.html","المتقارب"],[443,"إذا بارق من بارق لاح مومضاً","https://www.aldiwan.net/poem2536.html","الطويل"],[463,"أجيراننا بالغور والركب متهِم","https://www.aldiwan.net/poem55875.html","الطويل"],[463,"لعل لها مع النسرين سرا","https://www.aldiwan.net/poem56198.html","الوافر"],[469,"معاليك أعلى أن يحيط بها الوصف","https://www.aldiwan.net/poem3294.html","عموديه"],[491,"أتعرف رسماً كالرداء المحبر","https://www.aldiwan.net/poem483.html",""],[505,"بالله يا أيها الساري العشية لم","https://www.aldiwan.net/poem37966.html","البسيط"],[534,"مسامع من ناديت يا عمرو سدت","https://www.aldiwan.net/poem37501.html","الطويل"],[121,"","https://poetry.dctabudhabi.ae/diwan/poem/145618","الوافر"],[1417,"","https://poetry.dctabudhabi.ae/diwan/poem/203128","البسيط"],[1802,"","https://poetry.dctabudhabi.ae/diwan/poem/116935","الرجز"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69336","المتقارب"],[3080,"","https://poetry.dctabudhabi.ae/diwan/poem/96113","الطويل"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107068","الطويل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112340","المتقارب"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216737","المتقارب"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86443","المتقارب"],[4104,"","https://poetry.dctabudhabi.ae/diwan/poem/125319","الطويل"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21523","الطويل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97070","الخفيف"],[4797,"أعز الكويت","https://www.poetsgate.com/ViewPoem.aspx?id=132240",""],[4883,"قصيدة حب","https://www.poetsgate.com/ViewPoem.aspx?id=48366",""],[4888,"الشاطئان مصر والإمارات","https://www.poetsgate.com/ViewPoem.aspx?id=207744",""],[5057,"مرتاحُ الضّميرِ","https://www.poetsgate.com/ViewPoem.aspx?id=203665",""],[5411,"النَّقْشُ اليَمانِي","https://www.poetsgate.com/ViewPoem.aspx?id=186271",""],[5411,"آخر الملكات","https://www.poetsgate.com/ViewPoem.aspx?id=193470",""],[402,"لا يعبد المرء ربا ولا ولا وطنا","https://www.poetsgate.com/ViewPoem.aspx?id=36310",""],[158,"قيود الأحرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84689&r=&rc=13",""],[6213,"دنان العشق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85492&r=&rc=95",""],[6225,"إحياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78068&r=&rc=153",""]],"verses":[["يحطّ به الرحال على غمارٍ","إذا ما الطرف سار إليه كابا",0,"ب",2,0],["يَحُطُّ السَيلُ ذُروَةَ كُلِّ طَودٍ","رُهوناً بِالجَنادِلِ وَالرِمالِ",1,"ل",1,0],["يُحَطِّمُ العَظْمُ مِنْكُم دُونَ يُغْيَتِكُمْ","فَتَصبِرُونَ وَيَأَبْى العَزْمُ تَحْطِيمَا",2,"م",2,0],["يُحَطِّمُ العَظْمُ مِنْكُمُ دُونَ بُغْيَتِكُمْ","فَمَا تَهُونُ وَيَأْبَى العَزْمُ تَحْطِيمَا",3,"م",2,0],["يُحَطَّمُ رُمحٌ دونَنا وَمُهَنَّدٌ","وَيَقتُلُنا لَحظٌ وَيَأسِرُ جيدُ",4,"د",1,0],["يَحِطَّ كُلَّ طَويلِ الرُمحِ حامِلُهُ","مِن سَرجِ كُلِّ طَويلِ الباعِ يَعبوبِ",5,"ب",1,0],["يَحِطُّ الوُعولَ الشُهلَ مِن رَأسِ شاهِقٍ","وَلِلسِدرِ وَالدَومِ الطِوالِ المَصارِعُ",6,"ع",1,0],["يُحَطِّمُنا رَيبُ الزَمانِ كَأَنَّنا","زُجاجٌ وَلَكِن لا يُعادُ لَهُ سَبكُ",7,"ك",1,0],["يَحُطُّ إِلى الفَوادِرِ كُلَّ حينٍ","مَنيعاتُ الفَوادِرِ مِن ذَراها",8,"ا",3,0],["يحطِّم رمحٌ دوننا ومهندٌ","ويقلنا لحظٌ ، ويأسر جيدُ",9,"د",1,0],["يحطمني الزمان وأنت ايض","تعين زماني الباغي عليا",10,"ي",2,0],["يَحطِمُ يَومَ الوَغى السِلاحَ وَلا ال","عَدُوُّ ناجٍ مِنهُ وَلا العُدَدُ",11,"د",1,0],["يُحَطِّمُ منهُ ثَغْراً لا نِياباً","ولا أنيابَ فيهِ وَلا زَوائِدْ",12,"د",1,0],["يَحُطُّ قوماً ويَعلو آخَرونَ به","كما يُديرُ نُجومَ اللّيلةِ الفَلَك",13,"ك",1,0],["يَحُطُّ سواك العَزْلُ عن شَرَف العُلى","ومثلُك لا يَنْحَطُّ ما عاشَ بالعَزْل",14,"ل",1,0],["يَحُطُّ لِثامَ نائِلِهِ فيبدُو","وقد عَقَدَ الحياءُ له لِثاما",15,"م",2,0],["يحَطُّ الفتى نَقْصُه دِرْهَماً","وكيف الذي نَقَصَ اثْنَيْ عَشَرْ",16,"ر",1,0],["يحطم سمر الخط بالخط بعدما","يفلّ الجراز المنتضى حين ينتضى",17,"ض",2,0],["يحُطُّ بضَبِّيِّينَ جمرةُ فخرهم","بحيثُ انتمَوْا وملكُهم حيثُ خيَّموا",18,"م",3,0],["يُحَطُّ المَيْسُ منها عن جُنوبٍ","محلَّقَةٍ وكنَّ رحَلنَ شُعْرَا",19,"ر",2,0],["يحطَّ لديهِ القلبُ فضل قناعهِ","ويصرفُ عنهُ من مهابتهِ الطرف",20,"ف",1,0],["يَحُطُّ الوُعولَ العُصمَ مِن كُلِّ شاهِقٍ","وَيَقذِفُ بِالثيرانِ في المُتَحَيَّرِ",21,"ر",1,0],["يَحُطُّهُ الآهُ مبهوتاً ويرفَعُهُ","والصِدقُ والعَجزُ يُعطيهِ ويمنَعُهُ",22,"ع",2,0],["يَحُطُّ بِدارِ الباهِليَّةِ رَحْلَهُ","صَبَاحاً ويأْتي دَارَهُ بالعَشِيَّةِ",23,"ه",1,0],["يُحَطِّمُ وَهْمَ دَوْلَتِهِ","وَيَفْضَحُ زَيْفَها العَارِي",24,"ر",2,0],["يحط أثقاله في خير منزلة","ويستخص من البلدان موقانا",25,"ن",2,0],["يحطب في بجاده الأيم الذكر","والأسودُ السالخ مكروه النظر",26,"ر",1,0],["يَحُطُّ مِنَ النِيقِ ما في الوُكُورِ","وَيُخفي مِنَ الأَرضِ ما في الكُوى",27,"ا",1,0],["يحطم أركان الجبال فترتمي","شماريخ من عَمرِ ابن عروان بالصخرِ",28,"ر",1,0],["يحطون من قدر البلاد وانما","يسوقون للأوطان ذلاً معاجلا",29,"ل",2,0],["يحطّ الغريبُ الرحَال","ويمضي إِلى المرقَدِ",30,"د",1,0],["يُحطّم أعوادَها العاريا","ت تحطيمَ ذي جنة منذعر",31,"ر",1,0],["يحط جلاميده سيلها","بدمع كمدمعي الدافق",32,"ق",1,0],["يحطم آمال الرجال ذوي النهى","ويأخذ في ضبع الدنيء ويرفع",33,"ع",1,0],["يَحِطانِ كأَساً للنَديمِ إِذا جَرت","عَليَّ وإِن كانَت حَلالاً لِمَن شَرِب",34,"ب",1,0],["يحطم الجيش رابط الجأش حتى","صبغ الأرض من دماء الأعادي",35,"د",2,0],["يحطون للشعر الصحيح العفيف قيود","والي خافوا الشاعر يقصون جنحاته",36,"ه",1,0],["يْحَطبُونَ الضّلْوع فْ غَابَةْ أَيَّامكْ بَلْيّا فَاسْ","شِتَاهُم ضِحْكَةْ شْفَاهكْ..وشَافوْا نَاْر مَشبُوْبَةْ",37,"ب",2,0],["يَحُطُّ في أرضِها رَحْلُ الهوى ولها","في كلِّ رُكنٍ بعمقِ الرُّوحِ أركانُ",38,"ن",1,0],["يحُطّ على \"الوسادةِ\" كلّ رأسٍ","سواءٌ رأسُ عبدٍ أو أميرِ",39,"ر",1,0],["يَحُطُّ بِكَفّة نَقَشٌ لِصِرْوا","حَ والسَّيْفُ اليَمانِيُّ السَّديدُ",40,"د",1,0],["يَحُطُّ عَلى كَفِّ الْهَوى وَيَفرُّ","يَمام عَلى الدّفْل العَتيقِ يَمُرُّ",41,"ر",1,1],["يحطم العظم منكم دون بغيتكم","فتصبرون ويأبى العزم تحيطما",42,"م",2,0],["يحطمني الزمان وأنت ايضا","تعين زماني الباغي عليا",43,"ي",2,0],["يحطّم كل أشرعتي","ومجدافي وأعواني!",44,"ن",2,0],["يُحطِّمها تقهقرُها اتقاءً","لوهمٍ : أنها أبدًا حطامُ",45,"م",1,0]]}