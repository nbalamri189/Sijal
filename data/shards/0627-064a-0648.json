{"poems":[[53,"ألا ليت أذيال الغيوث السواجم","https://www.aldiwan.net/poem29766.html","الطويل"],[53,"عظيم الأسى في هذه غير مقنع","https://www.aldiwan.net/poem30141.html","الطويل"],[63,"رماك بشوق فالمدامع ذرف","https://www.aldiwan.net/poem46173.html","الطويل"],[77,"أيوسف دم للملك تعلي بناءه","https://www.aldiwan.net/poem35699.html","الطويل"],[77,"لقد رام كتم الوجد يوم ارتحاله","https://www.aldiwan.net/poem36375.html","الطويل"],[77,"دعا عزماتي والمطية والوخدا","https://www.aldiwan.net/poem36533.html","الطويل"],[77,"زمانك أفراح لدينا وأعياد","https://www.aldiwan.net/poem36614.html","الطويل"],[77,"إذا سرت سار النور حيث تعوج","https://www.aldiwan.net/poem36660.html","الطويل"],[77,"ألا حدثاها فهي أم العجائب","https://www.aldiwan.net/poem36775.html","الطويل"],[73,"أيوحشني الزمان وأنت أنسي","https://www.aldiwan.net/poem11848.html","الوافر"],[83,"عزاء فإن الشجو قد كان يسرف","https://www.aldiwan.net/poem54270.html","الطويل"],[88,"أ يوسف ما إن أنت من فحل هجمة","https://www.aldiwan.net/poem44392.html","الطويل"],[27,"أزرت ديار الحي أم لا تزورها","https://www.aldiwan.net/poem5767.html","الطويل"],[27,"ألا تصحو وتقصر عن صباكا","https://www.aldiwan.net/poem5946.html","الوافر"],[51,"ثنى شوقه والمرء يصحو ويسكر","https://www.aldiwan.net/poem63015.html","الطويل"],[51,"كل داع لعلي","https://www.aldiwan.net/poem64562.html","مجزوء الرمل"],[51,"أمكوك الخسار سأنتحيكا","https://www.aldiwan.net/poem65804.html","الوافر"],[51,"لعمري لقد غاب الرضا فتطاولت","https://www.aldiwan.net/poem66300.html","الطويل"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[29,"أيوعدني بكر وينفض عرفه","https://www.aldiwan.net/poem6100.html","الطويل"],[85,"يا نائح الطلح أشباه عوادينا","https://www.aldiwan.net/poem63691.html","البسيط"],[45,"لأخي الحب عبرة ما تجف","https://www.aldiwan.net/poem65151.html","الخفيف"],[45,"محا نور النواظر والعقول","https://www.aldiwan.net/poem65643.html","الوافر"],[28,"أيوب إني لا إخالك تمتري","https://www.aldiwan.net/poem5009.html","الكامل"],[80,"أجمل على بخل الغواني وإجمال","https://www.aldiwan.net/poem31339.html","الطويل"],[44,"أيوسف جئت بالعجب العجيب","https://www.aldiwan.net/poem30065.html","الوافر"],[44,"شعري أنى هربت في الطلب","https://www.aldiwan.net/poem30070.html","المنسرح"],[105,"أغيثوا مصر واستبقوا بنيها","https://www.aldiwan.net/poem43387.html","الوافر"],[52,"أي ورد على خدود الغزال","https://www.aldiwan.net/poem26743.html","الخفيف"],[75,"الشمس عنه كليلة أجفانها","https://www.aldiwan.net/poem69029.html","الكامل"],[48,"لا والتفات الظباء بالمقل","https://www.aldiwan.net/poem66275.html","المنسرح"],[48,"لا صحب الله فتية طربوا","https://www.aldiwan.net/poem66553.html","المنسرح"],[46,"أيوجد في الورى نفر طهارى","https://www.aldiwan.net/poem22803.html","الوافر"],[46,"لقد آن أن يثني الجموح لجام","https://www.aldiwan.net/poem23643.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39624","الرمل"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39498","المديد"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54860","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54748","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54656","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54745","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55170","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54958","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43667","المجتث"],[90,"يا فراتي","https://www.poetsgate.com/ViewPoem.aspx?id=178986",""]],"verses":[["أَيوعِدُنا مَن عَطَّلَ البيضَ وَالقَنا","وَأَقسَمَ لا يَنجو بِغَيرِ الهَزائِمِ",0,"م",1,0],["أَيَومَ عُبَيدِ اللَهِ كَم رُعتَ مِن حَشىً","جَليدٍ عَلى طولِ المَدى لَم يُرَوَّعِ",1,"ع",1,0],["أيُوعِدُني الحَيُّ اليَماني وصارِمي","كهَمِّكَ مَفْتوقُ الغِرارَيْنِ مُرْهَفُ",2,"ف",1,0],["أيوسف دم للملك تعلي بناءه","وتكسوه عضباً من حلاك وسندسا",3,"س",2,1],["أيوسف دُمْ للِدِّينِ تَحْمِي ذِمَارَهُ","وَتَجْنِي الأمَانِي تَحْتَ ظِلِّ ظلالِهِ",4,"ل",2,0],["أيوسُفُ يا حامي الجزيرَةِ حيثُ لا","نَصيرٌ ومُصْلي بأسِها الضُّمّر الجُرْدا",5,"د",2,0],["أَيوسُفُ حسْبُ القوْلِ فيكَ وإنْ عَلا","قُصورٌ فما إنْ يَحصُرُ القَطْرَ تَعْدادُ",6,"د",1,0],["أيُوسُفُ دُم للدّين تحْمي ذِمارَهُ","إذا كانَ للخَطْبِ الأبيِّ وُلوجُ",7,"ج",1,0],["أَيُوسُفُ إِنَّ الدَّهْرَ أَصْبَحَ وَاقِفاً","عَلَى بَابِكَ الْمَأمُولِ مَوْقِفَ تَائِبٍ",8,"ب",1,0],["أَيوحِشُني الزَمانُ وَأَنتَ أُنسي","وَيُظلِمُ لي النَهارُ وَأَنتَ شَمسي",9,"س",2,1],["أيوسُفُ قد أَرْضَيْتَهُ أجمل الرضا","وكان بما ترضى وتختار يكلَفُ",10,"ف",1,0],["أ يوسف ما إن أنت من فحل هجمةٍ","ولكن من الشَول الطوالب للفحل",11,"ل",1,1],["أَيَوماً لِماخورِ الفَرَزدَقِ خَزيَةٌ","وَيَوماً زَواني بابِلٍ وَخُمورُها",12,"ر",3,0],["أَيوعِدُني الأُخَيطِلُ مِن بَعيدٍ","وَقَد لاقى أَسِنَّتَنا شِباكا",13,"ك",2,0],["أيوحشهم فِقدانُ قردٍ وفيهُمُ","بناة المعالي والعديد المجمهَر",14,"ر",1,0],["أي وصافِ عليٍّ","لا يُقرّون بنحسه",15,"س",2,0],["أيورٌ طاعنتْك وأنت ماء","وطالتْ عنك غفلةُ مُدَّعيكا",16,"ك",2,0],["أيوجِبُ أنِّي ذو سلاحٍ مَذَلَّتي","لأعْزَلَ تُثْنَى عنه فيَّ العظائمُ",17,"م",1,0],["أيُّ وزن وأيُّ حرف رويٍّ","لهما بالمديح فيك يدان",18,"ن",1,0],["أَيوعِدُني بَكرٌ وَيَنفُضُ عُرفَهُ","فَقُلتُ لِبَكرٍ إِنَّما أَنتَ حالِمُ",19,"م",1,1],["إيوانُهُ الفَخمُ مِن عُليا مَقاصِرِهِ","يُفني المُلوكَ وَلا يُبقي الأَواوينا",20,"ن",2,0],["أَي وَسَعيِ الحَجيجِ حينَ سَعَوا شُع","ثاً وَصَفَّ الحَجيجِ ساعَةَ صَفّوا",21,"ف",3,0],["أَيَومَ مُحَمَّدٍ لَم تُبقِ سُؤلاً","وَلا أَمَلاً لِذي أَمَلٍ وَسولِ",22,"ل",1,0],["أَيّوبُ إِنّي لا إِخالُكَ تَمتَري","في أَن تَكونَ جَنيبَةً لِلقائِدِ",23,"د",1,1],["أَيُؤمَن مِنك الحَتفُ وَالكَيدُ في الهَوى","وطرفُكِ مُغْتالٌ وعِطْفُك مُخْتالُ",24,"ل",1,0],["أَيوسُفُ جِئتَ بِالعَجَبِ العَجيبِ","تَرَكتَ الناسَ في شَكٍّ مُريبِ",25,"ب",1,1],["أَيُّ وَليدٍ رَأى سُيوفَهُمُ","في الحَربِ مَشهورَةً فَلَم يَشِبِ",26,"ب",1,0],["أَيَومَ الحَشرِ مَوعِدُنا إِذا ما","تَلَمَّسَتِ الشَعوبُ مُعَلِّميها",27,"ي",3,0],["أَيُّ وَردٍ عَلى خُدودِ الغَزالِ","أَيُّ مَيلٍ في قَدِّهِ وَاِعتِدالِ",28,"ل",1,1],["إيوانُ مَلْكٍ لو رأتْهُ فارسٌ","ذُعِرَتْ وخَرّ لسَمكِهِ إيوانها",29,"ن",3,0],["أيورُهم في الأنام قد وسمت","جباهُها هؤلا من السفَل",30,"ل",1,0],["أيورُ هذي الأنامِ قد رُسَمَت","جباهُها هؤلاء من البغَل",31,"ل",1,0],["أَيوجَدُ في الوَرى نَفَرٌ طَهارى","أَمِ الأَقوامُ كُلُّهُمُ رُجوسُ",32,"س",1,1],["أيُوعِدُنا بالرّوم ناسٌ وإنّما","همُ النّبْتُ والبِيضُ الرّقاقُ سَوامُ",33,"م",1,0],["أيُّ وادٍ رائعٍ أحجارُهُ","تحذر الرّيحُ عليهنّ سُراها",34,"ا",3,0],["أَيُّ وردٍ فوقَ خدٍّ بدا","مُستنيراً بينَ سُوسانِ",35,"ن",1,0],["أَيَوْمَ بَلَّغْتَ العِرَاقَ المُنَى","فَالحُكْمُ شورَى وَالحِمَى حُرُّ",36,"ر",1,0],["أَيُّ وَفِيٍّ لاَ وَفِيَّ مِثْلُهُ","أَيُّ هُمَامٍ مُسْعِفٍ جَوَادِ",37,"د",1,0],["أَيُّ وَصْفٍ أَوْفَى وَاَبْلَغُ مِمَّ","قَالَ فِي وَصْفِهِ كَبِيرُ الأُسَاةِ",38,"ه",1,0],["إِيْ وَآياتِ أَثِينا كَانَ مِنْ","شَأْنِهَا أَنْ تمْنَحَ الأَخْطَارَ دَهْرَا",39,"ر",2,0],["أَيُّ وَحْيٍ يَصُوغُ رَسْماً فَيُحْيي","هِ بِذَاكَ التَّقْدِيرِ وَالتَّجْويدِ",40,"د",1,0],["أَيُوسُفُ إِنِّي قَبْلَ مَنْعَاك لَمْ أَثُرْ","وَلَمْ يَتَيقَّظْ لِلْمُلِمَّاتِ بِي قَبْلُ",41,"ل",1,0],["أَيُوَفَّى بِالْحَمْدِ حَقٌّ لِمَنْ كَا","ن وَمَا زَالَ لِلْحُقُوقِ نَصِيرَا",42,"ر",2,0],["أَيَومَ مَصرَعِهِ أَم","يَومَ الحِساب شَهِدتُه",43,"ت",2,0],["إي وعيشٍ مضى عليك بَهيِّ","وشُعاعٍ من شّطِكِ الذهبيِّ",44,"ي",1,1],["إي ومجرى الجيادِ يومَ التنّاَدي","ومجرِّ الرماح حول الندي",44,"ي",1,0]]}