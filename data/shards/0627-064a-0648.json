{"poems":[[53,"ألا ليت أذيال الغيوث السواجم","https://www.aldiwan.net/poem29766.html","الطويل"],[53,"عظيم الأسى في هذه غير مقنع","https://www.aldiwan.net/poem30141.html","الطويل"],[63,"رماك بشوق فالمدامع ذرف","https://www.aldiwan.net/poem46173.html","الطويل"],[77,"أيوسف دم للملك تعلي بناءه","https://www.aldiwan.net/poem35699.html","الطويل"],[77,"لقد رام كتم الوجد يوم ارتحاله","https://www.aldiwan.net/poem36375.html","الطويل"],[77,"دعا عزماتي والمطية والوخدا","https://www.aldiwan.net/poem36533.html","الطويل"],[77,"زمانك أفراح لدينا وأعياد","https://www.aldiwan.net/poem36614.html","الطويل"],[77,"إذا سرت سار النور حيث تعوج","https://www.aldiwan.net/poem36660.html","الطويل"],[77,"ألا حدثاها فهي أم العجائب","https://www.aldiwan.net/poem36775.html","الطويل"],[73,"أيوحشني الزمان وأنت أنسي","https://www.aldiwan.net/poem11848.html","الوافر"],[83,"عزاء فإن الشجو قد كان يسرف","https://www.aldiwan.net/poem54270.html","الطويل"],[88,"أ يوسف ما إن أنت من فحل هجمة","https://www.aldiwan.net/poem44392.html","الطويل"],[27,"أزرت ديار الحي أم لا تزورها","https://www.aldiwan.net/poem5767.html","الطويل"],[27,"ألا تصحو وتقصر عن صباكا","https://www.aldiwan.net/poem5946.html","الوافر"],[51,"ثنى شوقه والمرء يصحو ويسكر","https://www.aldiwan.net/poem63015.html","الطويل"],[51,"كل داع لعلي","https://www.aldiwan.net/poem64562.html","مجزوء الرمل"],[51,"أمكوك الخسار سأنتحيكا","https://www.aldiwan.net/poem65804.html","الوافر"],[51,"لعمري لقد غاب الرضا فتطاولت","https://www.aldiwan.net/poem66300.html","الطويل"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[29,"أيوعدني بكر وينفض عرفه","https://www.aldiwan.net/poem6100.html","الطويل"],[85,"يا نائح الطلح أشباه عوادينا","https://www.aldiwan.net/poem63691.html","البسيط"],[45,"لأخي الحب عبرة ما تجف","https://www.aldiwan.net/poem65151.html","الخفيف"],[45,"محا نور النواظر والعقول","https://www.aldiwan.net/poem65643.html","الوافر"],[28,"أيوب إني لا إخالك تمتري","https://www.aldiwan.net/poem5009.html","الكامل"],[80,"أجمل على بخل الغواني وإجمال","https://www.aldiwan.net/poem31339.html","الطويل"],[44,"أيوسف جئت بالعجب العجيب","https://www.aldiwan.net/poem30065.html","الوافر"],[44,"شعري أنى هربت في الطلب","https://www.aldiwan.net/poem30070.html","المنسرح"],[105,"أغيثوا مصر واستبقوا بنيها","https://www.aldiwan.net/poem43387.html","الوافر"],[52,"أي ورد على خدود الغزال","https://www.aldiwan.net/poem26743.html","الخفيف"],[75,"الشمس عنه كليلة أجفانها","https://www.aldiwan.net/poem69029.html","الكامل"],[48,"لا والتفات الظباء بالمقل","https://www.aldiwan.net/poem66275.html","المنسرح"],[48,"لا صحب الله فتية طربوا","https://www.aldiwan.net/poem66553.html","المنسرح"],[46,"أيوجد في الورى نفر طهارى","https://www.aldiwan.net/poem22803.html","الوافر"],[46,"لقد آن أن يثني الجموح لجام","https://www.aldiwan.net/poem23643.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39624","الرمل"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39498","المديد"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54860","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54748","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54656","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54745","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55170","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54958","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43667","المجتث"],[90,"يا فراتي","https://www.poetsgate.com/ViewPoem.aspx?id=178986",""],[108,"الاولين","https://www.poetsgate.com/ViewPoem.aspx?id=8407",""],[85,"أنْدَلُسِيَّة ٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9527&r=&rc=17",""],[94,"من كسعد ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66301&r=&rc=19",""],[115,"أي وقت لشؤُني","https://www.aldiwan.net/poem40898.html","عموديه"],[117,"الغلاء الوحش","https://www.aldiwan.net/poem24033.html","الرمل"],[132,"أرى العذال في الهيمان لاموا","https://www.aldiwan.net/poem54654.html","الوافر"],[142,"تظن فراقا أن تثار حمول","https://www.aldiwan.net/poem58376.html","الطويل"],[197,"أي وعينيك فاض كأس غرامي","https://www.aldiwan.net/poem39807.html","الخفيف"],[197,"عشق المجد والهوى فكرة تنمو","https://www.aldiwan.net/poem39874.html","الخفيف"],[223,"مر جنح من الظلام وقلبي","https://www.aldiwan.net/poem41919.html","الخفيف"],[231,"طال في شرك المضايق حبسي","https://www.aldiwan.net/poem44588.html","الخفيف"],[237,"يا سيدي سيد الجمهور جمهور","https://www.aldiwan.net/poem18816.html","البسيط"],[241,"ألا راية للعدل في مصر تخففق","https://www.aldiwan.net/poem45772.html","الطويل"],[260,"يا أخوينا من أبينا وأمنا","https://www.aldiwan.net/poem1105.html",""],[270,"أيوحشك الملهى ويؤنسك الرمس","https://www.aldiwan.net/poem35181.html","الطويل"],[270,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[297,"أفي كل يوم للأماني تكذيب","https://www.aldiwan.net/poem33335.html","الطويل"],[298,"أدال الله (جلق) من عداها","https://www.aldiwan.net/poem36817.html","عموديه"],[298,"نفخ الصور فهبوا مسرعين","https://www.aldiwan.net/poem36856.html","عموديه"],[320,"أي وقت وأي هائل طقس","https://www.aldiwan.net/poem61667.html","الخفيف"],[320,"ماس عجبا بعطفه وترنح","https://www.aldiwan.net/poem67138.html","الخفيف"],[328,"بين همس الشفاه والأحداق","https://www.aldiwan.net/poem55035.html","الخفيف"],[328,"فيك للشعر من سنا الإلهام","https://www.aldiwan.net/poem55047.html","الخفيف"],[349,"أنا بالموت عشت في الأحياء","https://www.aldiwan.net/poem15497.html","مجزوء الخفيف"],[349,"أي وجد بين الورى مثل وجدي","https://www.aldiwan.net/poem15595.html","الخفيف"],[365,"أيوعدني إذا ما غبت عنه","https://www.aldiwan.net/poem44385.html","الوافر"],[365,"كانت قريش تحمل الخمر مرة","https://www.aldiwan.net/poem44494.html","الطويل"],[371,"هل مع اليأس رجاء","https://www.aldiwan.net/poem57536.html","مجزوء الرمل"],[380,"يا رياح الفجر من نحو الحمى","https://www.aldiwan.net/poem48786.html","الرمل"],[380,"من للمحب المستهام","https://www.aldiwan.net/poem48802.html","مجزوء الكامل"],[405,"ألقى الرجاء بعينيه ويمنعه","https://www.aldiwan.net/poem50018.html","البسيط"],[410,"كأن التي يوم الرحيل تعرضت","https://www.aldiwan.net/poem67479.html","الطويل"],[416,"لمن الركب وحيفا وذميلا","https://www.aldiwan.net/poem53988.html","الرمل"],[416,"أتراك تعرف علتي وشفائي","https://www.aldiwan.net/poem54187.html","الكامل"],[437,"قلت للافتخار إذا أنا عاينت","https://www.aldiwan.net/poem2517.html","الخفيف"],[441,"ليت الكفان الذي إن مت لي صنعا","https://www.aldiwan.net/poem14333.html","البسيط"],[458,"أيوما مثل يوم الجزع","https://www.aldiwan.net/poem55890.html","مجزوء الوافر"],[464,"هذه دولة الندى والسماح","https://www.aldiwan.net/poem3162.html","عموديه"],[464,"جد بقلبي وهزل","https://www.aldiwan.net/poem3313.html","عموديه"],[464,"يا خليلي تلك أعلام نجد","https://www.aldiwan.net/poem3489.html","عموديه"],[474,"أيوعدني أبو ليلى طفيل","https://www.aldiwan.net/poem2150.html","الوافر"],[500,"أي ورد قد شممناه ضحى","https://www.aldiwan.net/poem37781.html","الرمل"],[516,"والله ما يدري امروء ذو جنابه","https://www.aldiwan.net/poem48701.html","الطويل"],[538,"أتركوه يهذي فإن كلامه","https://www.aldiwan.net/poem47945.html","عموديه"],[558,"زينة العبد فقره واحتياجه","https://www.aldiwan.net/poem34682.html","الخفيف"],[567,"اكفنا ياعذول شر لسانك","https://www.aldiwan.net/poem69496.html","الخفيف"]],"verses":[["أَيوعِدُنا مَن عَطَّلَ البيضَ وَالقَنا","وَأَقسَمَ لا يَنجو بِغَيرِ الهَزائِمِ",0,"م",1,0],["أَيَومَ عُبَيدِ اللَهِ كَم رُعتَ مِن حَشىً","جَليدٍ عَلى طولِ المَدى لَم يُرَوَّعِ",1,"ع",1,0],["أيُوعِدُني الحَيُّ اليَماني وصارِمي","كهَمِّكَ مَفْتوقُ الغِرارَيْنِ مُرْهَفُ",2,"ف",1,0],["أيوسف دم للملك تعلي بناءه","وتكسوه عضباً من حلاك وسندسا",3,"س",2,1],["أيوسف دُمْ للِدِّينِ تَحْمِي ذِمَارَهُ","وَتَجْنِي الأمَانِي تَحْتَ ظِلِّ ظلالِهِ",4,"ل",2,0],["أيوسُفُ يا حامي الجزيرَةِ حيثُ لا","نَصيرٌ ومُصْلي بأسِها الضُّمّر الجُرْدا",5,"د",2,0],["أَيوسُفُ حسْبُ القوْلِ فيكَ وإنْ عَلا","قُصورٌ فما إنْ يَحصُرُ القَطْرَ تَعْدادُ",6,"د",1,0],["أيُوسُفُ دُم للدّين تحْمي ذِمارَهُ","إذا كانَ للخَطْبِ الأبيِّ وُلوجُ",7,"ج",1,0],["أَيُوسُفُ إِنَّ الدَّهْرَ أَصْبَحَ وَاقِفاً","عَلَى بَابِكَ الْمَأمُولِ مَوْقِفَ تَائِبٍ",8,"ب",1,0],["أَيوحِشُني الزَمانُ وَأَنتَ أُنسي","وَيُظلِمُ لي النَهارُ وَأَنتَ شَمسي",9,"س",2,1],["أيوسُفُ قد أَرْضَيْتَهُ أجمل الرضا","وكان بما ترضى وتختار يكلَفُ",10,"ف",1,0],["أ يوسف ما إن أنت من فحل هجمةٍ","ولكن من الشَول الطوالب للفحل",11,"ل",1,1],["أَيَوماً لِماخورِ الفَرَزدَقِ خَزيَةٌ","وَيَوماً زَواني بابِلٍ وَخُمورُها",12,"ر",3,0],["أَيوعِدُني الأُخَيطِلُ مِن بَعيدٍ","وَقَد لاقى أَسِنَّتَنا شِباكا",13,"ك",2,0],["أيوحشهم فِقدانُ قردٍ وفيهُمُ","بناة المعالي والعديد المجمهَر",14,"ر",1,0],["أي وصافِ عليٍّ","لا يُقرّون بنحسه",15,"س",2,0],["أيورٌ طاعنتْك وأنت ماء","وطالتْ عنك غفلةُ مُدَّعيكا",16,"ك",2,0],["أيوجِبُ أنِّي ذو سلاحٍ مَذَلَّتي","لأعْزَلَ تُثْنَى عنه فيَّ العظائمُ",17,"م",1,0],["أيُّ وزن وأيُّ حرف رويٍّ","لهما بالمديح فيك يدان",18,"ن",1,0],["أَيوعِدُني بَكرٌ وَيَنفُضُ عُرفَهُ","فَقُلتُ لِبَكرٍ إِنَّما أَنتَ حالِمُ",19,"م",1,1],["إيوانُهُ الفَخمُ مِن عُليا مَقاصِرِهِ","يُفني المُلوكَ وَلا يُبقي الأَواوينا",20,"ن",2,0],["أَي وَسَعيِ الحَجيجِ حينَ سَعَوا شُع","ثاً وَصَفَّ الحَجيجِ ساعَةَ صَفّوا",21,"ف",3,0],["أَيَومَ مُحَمَّدٍ لَم تُبقِ سُؤلاً","وَلا أَمَلاً لِذي أَمَلٍ وَسولِ",22,"ل",1,0],["أَيّوبُ إِنّي لا إِخالُكَ تَمتَري","في أَن تَكونَ جَنيبَةً لِلقائِدِ",23,"د",1,1],["أَيُؤمَن مِنك الحَتفُ وَالكَيدُ في الهَوى","وطرفُكِ مُغْتالٌ وعِطْفُك مُخْتالُ",24,"ل",1,0],["أَيوسُفُ جِئتَ بِالعَجَبِ العَجيبِ","تَرَكتَ الناسَ في شَكٍّ مُريبِ",25,"ب",1,1],["أَيُّ وَليدٍ رَأى سُيوفَهُمُ","في الحَربِ مَشهورَةً فَلَم يَشِبِ",26,"ب",1,0],["أَيَومَ الحَشرِ مَوعِدُنا إِذا ما","تَلَمَّسَتِ الشَعوبُ مُعَلِّميها",27,"ي",3,0],["أَيُّ وَردٍ عَلى خُدودِ الغَزالِ","أَيُّ مَيلٍ في قَدِّهِ وَاِعتِدالِ",28,"ل",1,1],["إيوانُ مَلْكٍ لو رأتْهُ فارسٌ","ذُعِرَتْ وخَرّ لسَمكِهِ إيوانها",29,"ن",3,0],["أيورُهم في الأنام قد وسمت","جباهُها هؤلا من السفَل",30,"ل",1,0],["أيورُ هذي الأنامِ قد رُسَمَت","جباهُها هؤلاء من البغَل",31,"ل",1,0],["أَيوجَدُ في الوَرى نَفَرٌ طَهارى","أَمِ الأَقوامُ كُلُّهُمُ رُجوسُ",32,"س",1,1],["أيُوعِدُنا بالرّوم ناسٌ وإنّما","همُ النّبْتُ والبِيضُ الرّقاقُ سَوامُ",33,"م",1,0],["أيُّ وادٍ رائعٍ أحجارُهُ","تحذر الرّيحُ عليهنّ سُراها",34,"ا",3,0],["أَيُّ وردٍ فوقَ خدٍّ بدا","مُستنيراً بينَ سُوسانِ",35,"ن",1,0],["أَيَوْمَ بَلَّغْتَ العِرَاقَ المُنَى","فَالحُكْمُ شورَى وَالحِمَى حُرُّ",36,"ر",1,0],["أَيُّ وَفِيٍّ لاَ وَفِيَّ مِثْلُهُ","أَيُّ هُمَامٍ مُسْعِفٍ جَوَادِ",37,"د",1,0],["أَيُّ وَصْفٍ أَوْفَى وَاَبْلَغُ مِمَّ","قَالَ فِي وَصْفِهِ كَبِيرُ الأُسَاةِ",38,"ه",1,0],["إِيْ وَآياتِ أَثِينا كَانَ مِنْ","شَأْنِهَا أَنْ تمْنَحَ الأَخْطَارَ دَهْرَا",39,"ر",2,0],["أَيُّ وَحْيٍ يَصُوغُ رَسْماً فَيُحْيي","هِ بِذَاكَ التَّقْدِيرِ وَالتَّجْويدِ",40,"د",1,0],["أَيُوسُفُ إِنِّي قَبْلَ مَنْعَاك لَمْ أَثُرْ","وَلَمْ يَتَيقَّظْ لِلْمُلِمَّاتِ بِي قَبْلُ",41,"ل",1,0],["أَيُوَفَّى بِالْحَمْدِ حَقٌّ لِمَنْ كَا","ن وَمَا زَالَ لِلْحُقُوقِ نَصِيرَا",42,"ر",2,0],["أَيَومَ مَصرَعِهِ أَم","يَومَ الحِساب شَهِدتُه",43,"ت",2,0],["إي وعيشٍ مضى عليك بَهيِّ","وشُعاعٍ من شّطِكِ الذهبيِّ",44,"ي",1,1],["إي ومجرى الجيادِ يومَ التنّاَدي","ومجرِّ الرماح حول الندي",44,"ي",1,0],["أيّوه يادنيا الفرح والبسمتين","أنشهد أنّه ماعلى مثلس .. غبار",45,"ر",1,0],["إيوانه الفخم من عليا مقاصره","يفني الملوك ولا يبقي الأوانينا",46,"ن",2,0],["أيّ ورد للحسن تشتفّه عيني","ويبقى بقدرة الله وردا ..",47,"د",2,0],["أي وقت لشؤُني","من ذنوبي اتفرغ",48,"غ",1,1],["أَيُّ وَحْشٍ كاسِرٍ لا يَنْثَني","أَيُّ أَفْعَى سُمُّهُ في بَدَني",49,"ن",2,1],["أيوعدني أشمط ذو بنات","حقير الجاه ليس له مَقام",50,"م",1,0],["أيوعدني الأقوام أن ودَّت المُنَى","بأنّا لبعض الفاركاتِ بُعولُ",51,"ل",1,0],["أي وعينيك فاض كأس غرامي","يا حبيبي وما بلغت مرامي",52,"ي",1,1],["أيّ وقع في النفس صاح لمرأى","مستميت يختال في الأكفان",53,"ن",1,0],["إِي وَلكِن لَو يُدرِكونَ أُموراً","قَد رماها الفُؤاد في كِتمانِه",54,"ن",2,0],["أي وقت تدور كأس المعاني","في رياض البشرى بنفحة قدس",55,"س",1,0],["إِيْ وَالذِي سَطَّرَتْ أَيْدِي الْعَلاَءِ لَكُمْ","فِي مُصْحَفِ الْمَجْدِ وَهْوَ خَيْرُ مَسْطُورِ",56,"ر",1,0],["أيؤملُ إصلاحٌ لنا وأميرُنا","بِغُلِّ نفوذِ الإِحتلالي مُوثَقُ",57,"ق",1,0],["أَيُؤكَلُ مَولانا وَمَولى اِبنِ عَمِّنا","مُقيمٌ وَمَنصورٌ كَما نُصِرَت جَسرُ",58,"ر",1,0],["أيوحشُكِ الملهى ويؤنِسُكِ الرَّمسُ","غريبةُ دارٍ أنتِ أيتها النفسُ",59,"س",1,1],["أيوسُفَ يا ابن العظمةِ استعظمَ الورى","شهادَتَكَ المُثلى ومثلكَ لم يرا",60,"ر",2,0],["أَيوقفُني صَرفُ الزَمان ضَراعةً","وَما الخُطو مقصورٌ ولا القيدُ مكروبُ",61,"ب",1,0],["(أَيوسفُ) والضحايا اليومَ كثرٌ","ليهنك كنتَ أولَ من بداها",62,"ا",3,0],["أَيّ وجدانٍ وحسُ يجدون","من هوى النفسِ وخلجاتِ الضمير",63,"ر",1,0],["أَيَّ وَقتٍ وَأَيَّ هائِلِ طَقسٍ","بانَ سِرُّ تَأثيرِهِ في النَفسِ",64,"س",1,1],["أَي وَرَبي فَإِنَّهُ قَد تَجَلّى","بِثِيابِ العُلا وَفيها تَبَجَّح",65,"ح",1,0],["أي واد ترجين لو عشت فيه","غير واديك يا بنة الأسواق",66,"ق",1,0],["أي واد من الشقاوة والحر","مان يطوى في غيهب من ظلام",67,"م",1,0],["أَيُّ وَجدٍ بَينَ الوَرى مِثلُ وَجدي","بِفَنائي وَجَدتُ فيهِ بَقائي",68,"ا",3,0],["أَيُّ وَجدٍ بَينَ الوَرى مِثلَ وَجدي","إِذا أَرَتني فيهِ الغِوايَةُ رُشدي",69,"د",2,1],["أَيُوعِدُني إِذا ما غِبتُ عنه","وَيَصرِفُ مُهرَهُ والرُمحَ دوني",70,"ن",2,1],["أَيُوعِدُني سَعدٌ وفي الكفِّ صارمٌ","سَيَمنَعُ منّي أَن أَذِلَّ وَأَخضَعَا",71,"ع",2,0],["أي وقتٍ تعدم ال","جُبّة فيه والكساءُ",72,"ا",2,0],["أَي وَمَن قَد علم الإِنسان ما","لَم يَك يَعلَمُ مِن فَنّ الأَدَب",73,"ب",1,0],["أَي وَالَّذي قَد أَنشَأ القَلب","المُعَذَب مِن ضَرام",74,"م",1,0],["أيوجبُ العدلُ إن حقَّتْ حقائقُهُ","عليهِ وهو مُعَنَّىً مُحْرَجٌ حَرَجا",75,"ج",2,0],["أَيَومُ نَداهُ الغَمرُ أَم يَومُ بِأسِهِ","وَما مِنهُما إِلّا أَغَرُّ مُحَجَّلُ",76,"ل",1,0],["إيْ ودينِ الحبِّ لولا سربكم","ما استباحت أعْيُن الغيد قتيلا",77,"ل",2,0],["إيْ والذي جعل العلى من مجده","فرح الصديق وغمَّة الأعداء",78,"ا",2,0],["أي وقت حصّلت جاهك هذا","قال لي قبل أن أصير شريفا",79,"ف",2,0],["إيوان كسرى وخمد النار والقمر ال","منشق في كمه من بعد ما طلعا",80,"ع",2,0],["أيوماً مثلَ يوم الجز","عِ تنساه وإن قَدُما",81,"م",2,1],["أيُّ وَسنى ولم تنمْ عن معاليك","ونشوى ما شافهت كأسَ راح",82,"ح",1,0],["أيُّ وجوهٍ أقبلت","تدفعُ في صدر الأول",83,"ل",1,0],["أيّ وردٍ ببرده كم لهُ في","القلب من لوعةٍ تشبُّ ووقد",84,"د",1,0],["أيوعدني أبو ليلى طًفَيلٌ","ويُهدي لي مع القلص الكلاما",85,"م",2,1],["أَيُّ وردٍ قد شممْناهُ ضُحًى","عبِقَ الجَنْبَذُ منه بالحِمى",86,"م",2,1],["ايوم إِذا الفَيتَه ذا يَسارَة","فَاِعطَيت عَفواً مِنكَ ام يَوم تُجهَد",87,"د",1,0],["أيُّ وجهٍ يراهُ منكَ رسولُ اللهِ","في النومِ يا مثالًَ الذَّمامَه",88,"م",2,0],["أي وقت يمر من غير نوع","من عطاء كسا الكساد رواجه",89,"ج",2,0],["أَيُّ وَجْدَيْكَ تَشْتَكِي وَإِلَى","أَيِّ خَلِيْلٍ تَحِنُّ مِنْ خِلاَّنِكْ",90,"ك",1,0]]}