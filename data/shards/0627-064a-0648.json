ع","https://www.poetsgate.com/ViewPoem.aspx?id=193102",""],[5956,"لماذا الرّعبُ يا عرب؟","https://www.poetsgate.com/ViewPoem.aspx?id=202499",""],[5956,"يا سامِيا العظمى رعاك إلهُنا","https://www.poetsgate.com/ViewPoem.aspx?id=207489",""],[6134,"ماذا حملتم على الايدي بلا حذر","https://www.poetsgate.com/ViewPoem.aspx?id=169551",""],[6142,"من عذيري من ألمعي تغابى","https://www.poetsgate.com/ViewPoem.aspx?id=155692",""],[6147,"أم الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=151698",""],[6152,"باقية بقلبي للأبد","https://www.poetsgate.com/ViewPoem.aspx?id=204658",""],[6202,"إن تمكري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86708&r=&rc=9",""],[6202,"الشعر والسيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86705&r=&rc=6",""]],"verses":[["أَيوعِدُنا مَن عَطَّلَ البيضَ وَالقَنا","وَأَقسَمَ لا يَنجو بِغَيرِ الهَزائِمِ",0,"م",1,0],["أَيَومَ عُبَيدِ اللَهِ كَم رُعتَ مِن حَشىً","جَليدٍ عَلى طولِ المَدى لَم يُرَوَّعِ",1,"ع",1,0],["أيُوعِدُني الحَيُّ اليَماني وصارِمي","كهَمِّكَ مَفْتوقُ الغِرارَيْنِ مُرْهَفُ",2,"ف",1,0],["أيوسف دم للملك تعلي بناءه","وتكسوه عضباً من حلاك وسندسا",3,"س",2,1],["أيوسف دُمْ للِدِّينِ تَحْمِي ذِمَارَهُ","وَتَجْنِي الأمَانِي تَحْتَ ظِلِّ ظلالِهِ",4,"ل",2,0],["أيوسُفُ يا حامي الجزيرَةِ حيثُ لا","نَصيرٌ ومُصْلي بأسِها الضُّمّر الجُرْدا",5,"د",2,0],["أَيوسُفُ حسْبُ القوْلِ فيكَ وإنْ عَلا","قُصورٌ فما إنْ يَحصُرُ القَطْرَ تَعْدادُ",6,"د",1,0],["أيُوسُفُ دُم للدّين تحْمي ذِمارَهُ","إذا كانَ للخَطْبِ الأبيِّ وُلوجُ",7,"ج",1,0],["أَيُوسُفُ إِنَّ الدَّهْرَ أَصْبَحَ وَاقِفاً","عَلَى بَابِكَ الْمَأمُولِ مَوْقِفَ تَائِبٍ",8,"ب",1,0],["أَيوحِشُني الزَمانُ وَأَنتَ أُنسي","وَيُظلِمُ لي النَهارُ وَأَنتَ شَمسي",9,"س",2,1],["أيوسُفُ قد أَرْضَيْتَهُ أجمل الرضا","وكان بما ترضى وتختار يكلَفُ",10,"ف",1,0],["أ يوسف ما إن أنت من فحل هجمةٍ","ولكن من الشَول الطوالب للفحل",11,"ل",1,1],["أَيَوماً لِماخورِ الفَرَزدَقِ خَزيَةٌ","وَيَوماً زَواني بابِلٍ وَخُمورُها",12,"ر",3,0],["أَيوعِدُني الأُخَيطِلُ مِن بَعيدٍ","وَقَد لاقى أَسِنَّتَنا شِباكا",13,"ك",2,0],["أيوحشهم فِقدانُ قردٍ وفيهُمُ","بناة المعالي والعديد المجمهَر",14,"ر",1,0],["أي وصافِ عليٍّ","لا يُقرّون بنحسه",15,"س",2,0],["أيورٌ طاعنتْك وأنت ماء","وطالتْ عنك غفلةُ مُدَّعيكا",16,"ك",2,0],["أيوجِبُ أنِّي ذو سلاحٍ مَذَلَّتي","لأعْزَلَ تُثْنَى عنه فيَّ العظائمُ",17,"م",1,0],["أيُّ وزن وأيُّ حرف رويٍّ","لهما بالمديح فيك يدان",18,"ن",1,0],["أَيوعِدُني بَكرٌ وَيَنفُضُ عُرفَهُ","فَقُلتُ لِبَكرٍ إِنَّما أَنتَ حالِمُ",19,"م",1,1],["إيوانُهُ الفَخمُ مِن عُليا مَقاصِرِهِ","يُفني المُلوكَ وَلا يُبقي الأَواوينا",20,"ن",2,0],["أَي وَسَعيِ الحَجيجِ حينَ سَعَوا شُع","ثاً وَصَفَّ الحَجيجِ ساعَةَ صَفّوا",21,"ف",3,0],["أَيَومَ مُحَمَّدٍ لَم تُبقِ سُؤلاً","وَلا أَمَلاً لِذي أَمَلٍ وَسولِ",22,"ل",1,0],["أَيّوبُ إِنّي لا إِخالُكَ تَمتَري","في أَن تَكونَ جَنيبَةً لِلقائِدِ",23,"د",1,1],["أَيُؤمَن مِنك الحَتفُ وَالكَيدُ في الهَوى","وطرفُكِ مُغْتالٌ وعِطْفُك مُخْتالُ",24,"ل",1,0],["أَيوسُفُ جِئتَ بِالعَجَبِ العَجيبِ","تَرَكتَ الناسَ في شَكٍّ مُريبِ",25,"ب",1,1],["أَيُّ وَليدٍ رَأى سُيوفَهُمُ","في الحَربِ مَشهورَةً فَلَم يَشِبِ",26,"ب",1,0],["أَيَومَ الحَشرِ مَوعِدُنا إِذا ما","تَلَمَّسَتِ الشَعوبُ مُعَلِّميها",27,"ي",3,0],["أَيُّ وَردٍ عَلى خُدودِ الغَزالِ","أَيُّ مَيلٍ في قَدِّهِ وَاِعتِدالِ",28,"ل",1,1],["إيوانُ مَلْكٍ لو رأتْهُ فارسٌ","ذُعِرَتْ وخَرّ لسَمكِهِ إيوانها",29,"ن",3,0],["أيورُهم في الأنام قد وسمت","جباهُها هؤلا من السفَل",30,"ل",1,0],["أيورُ هذي الأنامِ قد رُسَمَت","جباهُها هؤلاء من البغَل",31,"ل",1,0],["أَيوجَدُ في الوَرى نَفَرٌ طَهارى","أَمِ الأَقوامُ كُلُّهُمُ رُجوسُ",32,"س",1,1],["أيُوعِدُنا بالرّوم ناسٌ وإنّما","همُ النّبْتُ والبِيضُ الرّقاقُ سَوامُ",33,"م",1,0],["أيُّ وادٍ رائعٍ أحجارُهُ","تحذر الرّيحُ عليهنّ سُراها",34,"ا",3,0],["أَيُّ وردٍ فوقَ خدٍّ بدا","مُستنيراً بينَ سُوسانِ",35,"ن",1,0],["أَيَوْمَ بَلَّغْتَ العِرَاقَ المُنَى","فَالحُكْمُ شورَى وَالحِمَى حُرُّ",36,"ر",1,0],["أَيُّ وَفِيٍّ لاَ وَفِيَّ مِثْلُهُ","أَيُّ هُمَامٍ مُسْعِفٍ جَوَادِ",37,"د",1,0],["أَيُّ وَصْفٍ أَوْفَى وَاَبْلَغُ مِمَّ","قَالَ فِي وَصْفِهِ كَبِيرُ الأُسَاةِ",38,"ه",1,0],["إِيْ وَآياتِ أَثِينا كَانَ مِنْ","شَأْنِهَا أَنْ تمْنَحَ الأَخْطَارَ دَهْرَا",39,"ر",2,0],["أَيُّ وَحْيٍ يَصُوغُ رَسْماً فَيُحْيي","هِ بِذَاكَ التَّقْدِيرِ وَالتَّجْويدِ",40,"د",1,0],["أَيُوسُفُ إِنِّي قَبْلَ مَنْعَاك لَمْ أَثُرْ","وَلَمْ يَتَيقَّظْ لِلْمُلِمَّاتِ بِي قَبْلُ",41,"ل",1,0],["أَيُوَفَّى بِالْحَمْدِ حَقٌّ لِمَنْ كَا","ن وَمَا زَالَ لِلْحُقُوقِ نَصِيرَا",42,"ر",2,0],["أَيَومَ مَصرَعِهِ أَم","يَومَ الحِساب شَهِدتُه",43,"ت",2,0],["إي وعيشٍ مضى عليك بَهيِّ","وشُعاعٍ من شّطِكِ الذهبيِّ",44,"ي",1,1],["إي ومجرى الجيادِ يومَ التنّاَدي","ومجرِّ الرماح حول الندي",44,"ي",1,0],["أيّوه يادنيا الفرح والبسمتين","أنشهد أنّه ماعلى مثلس .. غبار",45,"ر",1,0],["إيوانه الفخم من عليا مقاصره","يفني الملوك ولا يبقي الأوانينا",46,"ن",2,0],["أيّ ورد للحسن تشتفّه عيني","ويبقى بقدرة الله وردا ..",47,"د",2,0],["أي وقت لشؤُني","من ذنوبي اتفرغ",48,"غ",1,1],["أَيُّ وَحْشٍ كاسِرٍ لا يَنْثَني","أَيُّ أَفْعَى سُمُّهُ في بَدَني",49,"ن",2,1],["أيوعدني أشمط ذو بنات","حقير الجاه ليس له مَقام",50,"م",1,0],["أيوعدني الأقوام أن ودَّت المُنَى","بأنّا لبعض الفاركاتِ بُعولُ",51,"ل",1,0],["أي وعينيك فاض كأس غرامي","يا حبيبي وما بلغت مرامي",52,"م",2,1],["أيّ وقع في النفس صاح لمرأى","مستميت يختال في الأكفان",53,"ن",1,0],["إِي وَلكِن لَو يُدرِكونَ أُموراً","قَد رماها الفُؤاد في كِتمانِه",54,"ن",2,0],["أي وقت تدور كأس المعاني","في رياض البشرى بنفحة قدس",55,"س",1,0],["إِيْ وَالذِي سَطَّرَتْ أَيْدِي الْعَلاَءِ لَكُمْ","فِي مُصْحَفِ الْمَجْدِ وَهْوَ خَيْرُ مَسْطُورِ",56,"ر",1,0],["أيؤملُ إصلاحٌ لنا وأميرُنا","بِغُلِّ نفوذِ الإِحتلالي مُوثَقُ",57,"ق",1,0],["أَيُؤكَلُ مَولانا وَمَولى اِبنِ عَمِّنا","مُقيمٌ وَمَنصورٌ كَما نُصِرَت جَسرُ",58,"ر",1,0],["أيوحشُكِ الملهى ويؤنِسُكِ الرَّمسُ","غريبةُ دارٍ أنتِ أيتها النفسُ",59,"س",1,1],["أيوسُفَ يا ابن العظمةِ استعظمَ الورى","شهادَتَكَ المُثلى ومثلكَ لم يرا",60,"ر",2,0],["أَيوقفُني صَرفُ الزَمان ضَراعةً","وَما الخُطو مقصورٌ ولا القيدُ مكروبُ",61,"ب",1,0],["(أَيوسفُ) والضحايا اليومَ كثرٌ","ليهنك كنتَ أولَ من بداها",62,"ا",3,0],["أَيّ وجدانٍ وحسُ يجدون","من هوى النفسِ وخلجاتِ الضمير",63,"ر",1,0],["أَيَّ وَقتٍ وَأَيَّ هائِلِ طَقسٍ","بانَ سِرُّ تَأثيرِهِ في النَفسِ",64,"س",1,1],["أَي وَرَبي فَإِنَّهُ قَد تَجَلّى","بِثِيابِ العُلا وَفيها تَبَجَّح",65,"ح",1,0],["أي واد ترجين لو عشت فيه","غير واديك يا بنة الأسواق",66,"ق",1,0],["أي واد من الشقاوة والحر","مان يطوى في غيهب من ظلام",67,"م",1,0],["أَيُّ وَجدٍ بَينَ الوَرى مِثلُ وَجدي","بِفَنائي وَجَدتُ فيهِ بَقائي",68,"ا",3,0],["أَيُّ وَجدٍ بَينَ الوَرى مِثلَ وَجدي","إِذا أَرَتني فيهِ الغِوايَةُ رُشدي",69,"د",2,1],["أَيُوعِدُني إِذا ما غِبتُ عنه","وَيَصرِفُ مُهرَهُ والرُمحَ دوني",70,"ن",2,1],["أَيُوعِدُني سَعدٌ وفي الكفِّ صارمٌ","سَيَمنَعُ منّي أَن أَذِلَّ وَأَخضَعَا",71,"ع",2,0],["أي وقتٍ تعدم ال","جُبّة فيه والكساءُ",72,"ا",2,0],["أَي وَمَن قَد علم الإِنسان ما","لَم يَك يَعلَمُ مِن فَنّ الأَدَب",73,"ب",1,0],["أَي وَالَّذي قَد أَنشَأ القَلب","المُعَذَب مِن ضَرام",74,"م",1,0],["أيوجبُ العدلُ إن حقَّتْ حقائقُهُ","عليهِ وهو مُعَنَّىً مُحْرَجٌ حَرَجا",75,"ج",2,0],["أَيَومُ نَداهُ الغَمرُ أَم يَومُ بِأسِهِ","وَما مِنهُما إِلّا أَغَرُّ مُحَجَّلُ",76,"ل",1,0],["إيْ ودينِ الحبِّ لولا سربكم","ما استباحت أعْيُن الغيد قتيلا",77,"ل",2,0],["إيْ والذي جعل العلى من مجده","فرح الصديق وغمَّة الأعداء",78,"ا",2,0],["أي وقت حصّلت جاهك هذا","قال لي قبل أن أصير شريفا",79,"ف",2,0],["إيوان كسرى وخمد النار والقمر ال","منشق في كمه من بعد ما طلعا",80,"ع",2,0],["أيوماً مثلَ يوم الجز","عِ تنساه وإن قَدُما",81,"م",2,1],["أيُّ وَسنى ولم تنمْ عن معاليك","ونشوى ما شافهت كأسَ راح",82,"ح",1,0],["أيُّ وجوهٍ أقبلت","تدفعُ في صدر الأول",83,"ل",1,0],["أيّ وردٍ ببرده كم لهُ في","القلب من لوعةٍ تشبُّ ووقد",84,"د",1,0],["أيوعدني أبو ليلى طًفَيلٌ","ويُهدي لي مع القلص الكلاما",85,"م",2,1],["أَيُّ وردٍ قد شممْناهُ ضُحًى","عبِقَ الجَنْبَذُ منه بالحِمى",86,"م",2,1],["ايوم إِذا الفَيتَه ذا يَسارَة","فَاِعطَيت عَفواً مِنكَ ام يَوم تُجهَد",87,"د",1,0],["أيُّ وجهٍ يراهُ منكَ رسولُ اللهِ","في النومِ يا مثالًَ الذَّمامَه",88,"م",2,0],["أي وقت يمر من غير نوع","من عطاء كسا الكساد رواجه",89,"ج",2,0],["أَيُّ وَجْدَيْكَ تَشْتَكِي وَإِلَى","أَيِّ خَلِيْلٍ تَح