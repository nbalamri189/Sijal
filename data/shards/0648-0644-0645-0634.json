{"poems":[[92,"رثاء شيخ الشريعة","https://www.poetsgate.com/ViewPoem.aspx?id=178927",""],[409,"ولقد ذكرتك بعد أن جد النوى","https://www.aldiwan.net/poem33651.html","الكامل"],[443,"أشاقتك من أطلال ليلى معالم","https://www.aldiwan.net/poem2587.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122824","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59271","الرجز"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65167","الكامل"],[3142,"","https://poetry.dctabudhabi.ae/diwan/poem/74137","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135740","الرجز"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125799","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33464","الكامل"],[6225,"إلى متى ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78030&r=&rc=115",""]],"verses":[["ولم شرق الناعي بمنعاه عله","رأى شامتا يخشى وعيناً تحاذره",0,"ر",2,0],["ولمشفقيهم أدمع منهلة","كالغيث إلا أنها لم تقلع",1,"ع",1,0],["ولم شهدت منك الفرنج مواقفاً","وبحر المنايا موجده متلاطمُ",2,"م",1,0],["وَلمَّ شملَهُمُ غُرماً فَسادَتُهُم","أَنصارُهُ وَمَواليهِم مَواليهِ",3,"ي",2,0],["وَلِمُشْتَرِي حَمَلِ الهَوَى","أرْخَى الذَّوَائِبَ سُنْبُلَهْ",4,"ل",2,0],["ولمشكل التنزيل تبيانا وعن","معناه كشافا لدى التنقيص",5,"ص",1,0],["ولمّ شتات الشمل عند مقرّنا","فأَرواحنا مِمّا عَراها تغلق",6,"ق",1,0],["ولُمَّ شملَها ووفِّقَنّها","وبالغنى والنصر أيِّدَنّها",7,"ه",2,0],["وَلُمَّ شعثَ بنى عدنانَ كلهَّم","ياباني الركنِ شَيِّد فوقه الأطما",8,"م",2,0],["ولمُشرقٍ من نور حس","نٍ لم يَزَل وقفاً عليكا",9,"ك",2,0],["ولمِشيةِ الأملِ احتوى البرقُ الخُطى","ودعا الصفاءَ إليه فهو مَنائِرُ",10,"ر",1,0]]}