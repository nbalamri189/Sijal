{"poems":[[53,"قمر غاض ضوؤه في المحاق","https://www.aldiwan.net/poem29935.html","الخفيف"],[86,"ارحمونا بني اليهود كفاكم","https://www.aldiwan.net/poem10952.html","الخفيف"],[73,"لست بالجاحد آلاء العلل","https://www.aldiwan.net/poem11941.html","الرمل"],[93,"مصر تهدي إلى بنيها السلاما","https://www.aldiwan.net/poem11323.html","الخفيف"],[88,"أيها الناظر ذا الفقر","https://www.aldiwan.net/poem45076.html","مجزوء الرمل"],[4,"لا تزجر الفتيان عن سوء الرعه","https://www.aldiwan.net/poem21177.html","الرجز"],[72,"كفوا حديث العذل عن مسمعي","https://www.aldiwan.net/poem19170.html","السريع"],[51,"لا تزل أيها الإمام السعيد","https://www.aldiwan.net/poem11443.html","الخفيف"],[51,"نفرت هيفك الليالي وغيدك","https://www.aldiwan.net/poem61938.html","الخفيف"],[51,"ومن العجائب يا أبا الفياض","https://www.aldiwan.net/poem64948.html","الكامل"],[51,"مذ صرت همي في النوم واليقظه","https://www.aldiwan.net/poem65036.html","المنسرح"],[51,"لم يزل قلبه إليهم مشوقا","https://www.aldiwan.net/poem65527.html","الخفيف"],[51,"أيها السيد الذي اختاره السيد","https://www.aldiwan.net/poem65973.html","الخفيف"],[51,"حببت درة القيان إلينا","https://www.aldiwan.net/poem66421.html","الخفيف"],[51,"سمعا أبا إسحق إنك ماجد","https://www.aldiwan.net/poem66524.html","الكامل"],[91,"يا شاعرا حلو المودة","https://www.aldiwan.net/poem8762.html","عموديه"],[70,"ونديم بت منه","https://www.aldiwan.net/poem42254.html","مجزوء الرمل"],[70,"لا تزد في الهوى علي","https://www.aldiwan.net/poem42389.html","مجزوء الخفيف"],[70,"ما الذي تطلب مني","https://www.aldiwan.net/poem42426.html","مجزوء الرمل"],[80,"عجبي من سكينتي ووقاري","https://www.aldiwan.net/poem31439.html","الخفيف"],[31,"إرحمينا يا نعم مما لقينا","https://www.aldiwan.net/poem41278.html","الخفيف"],[105,"أيها الجند ظافرا يتمشى","https://www.aldiwan.net/poem43097.html","الخفيف"],[105,"يا معشر الإنس جئتم كل رائعة","https://www.aldiwan.net/poem43105.html","البسيط"],[52,"وقفت بالروض أبكي فقد مشبهه","https://www.aldiwan.net/poem27052.html","البسيط"],[46,"لا تزدرن صغارا في ملاعبهم","https://www.aldiwan.net/poem23397.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85534","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54734","الخفيف"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116961","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54266","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54252","الخفيف"],[106,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[90,"الى السعدون..","https://www.poetsgate.com/ViewPoem.aspx?id=179037",""],[51,"ما يوفيك حقَّك التقريظُ","https://www.poetsgate.com/ViewPoem.aspx?id=29385",""],[51,"لم يزلْ قلْبُهُ إليهم مَشوقا","https://www.poetsgate.com/ViewPoem.aspx?id=29924",""],[101,"قد قرأنا الحياة َ سَطْراً فسطراً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62466&r=&rc=58",""]],"verses":[["لا تَزالُ الأَيّامُ تَصدُرُ مِنّا","عَن إِخاءٍ لَم نُقذِهِ بِفِراقِ",0,"ق",1,0],["لا تَزيدوا عَلى الصُكوكِ فِخاخاً","مِن غِناءٍ ما بَينَ دُفٍّ وَعودِ",1,"د",1,0],["لا تَزَل دَولَتُكُم مَبسوطَةً","بَسطَةً في طَيِّها قَبضُ الدُوَل",2,"ل",1,0],["لا تَزِيغُوا لِنَزْعَةٍ مِنْ وِدَادِ","لا تُرُومُوا سِوَى الْفَلاحِ مَرَامَا",3,"م",2,0],["لا تزد بلواه من فع","لك هذا ببلاء",4,"ا",2,0],["لا تَزجُرِ الفِتيانَ عَن سوءِ الرِعَه","يا رُبَّ هَيجا هِيَ خَيرٌ مِن دَعَه",5,"ع",2,1],["لا تزد القلب على شجوِه","إن كنت لا تأرق لي فاهجع",6,"ع",1,0],["لا تزل أيها الإِمام السعيدُ","لك نعمى تَنْمِي وعمر يزيدُ",7,"د",1,1],["لا تزلْ والوفود تَعْفر أفنا","ءك ما عشتَ والأسود وصيدَكْ",8,"ك",1,0],["لا تُزهَيَنَّ بما مَلكتَ فلم تكن","من قَبْلها حَرَضاً من الأحراض",9,"ض",1,0],["لا تزل يا أبا الحسين أخا الإح","سان والحسن غائظاً من تغيظ",10,"ظ",1,0],["لا تزل عين شانئٍ تتقذا","كم مَعوراً إنسانها مبخوقا",11,"ق",2,0],["لا تزُل عنه نعمةٌ لو أُزيلت","لم تجدْ عنه وِجهةً للزوالِ",12,"ل",1,0],["لا تزالُ القلوبُ تَصْبُو إليها","أو تراها تُقلِّب الأجفانا",13,"ن",2,0],["لا تزبرنَّ على الضعيفِ فربما","ظلم الزَّبيرُ فعاد رَجْعَ أنين",14,"ن",1,0],["لا تَزعَمَنَّ لَهُ المَتابَ","فَإِنَّ تَوبَتُهُ كِذاب",15,"ب",1,0],["لا تَزِدني فَوقَ سُكري","بِالهَوى سُكرَ الحُمَيّا",16,"ي",2,0],["لا تَزِد في الهَوى عَلَيَّ","إِنَّ رُشدَ المُحِبِّ غَيَّ",17,"ي",1,1],["لا تَزِدني فَوقَ ما قَد","كانَ مِن ذاكَ التَجَنّي",18,"ن",2,0],["لا تزالُ الأبرارُ تأمَنُ منه","سَطْوَةً تُتّقَى على الفُجّارِ",19,"ر",1,0],["لا تَزالينَ آثَرَ الناسِ عِندي","فَاِعلَمي ذاكَ في الهَوى ما حَيِيّنا",20,"ن",2,0],["لا تزيدوا نُفوسَنا مِن نَعيمٍ","زادَ أَنضاءَها أَذىً وَخَبالا",21,"ل",2,0],["لا تَزعُموا هَذِهِ الهَيجاءَ مُعجِزَةً","أَلا لَهُ البَأسُ وَالهَيجاءُ وَالغَلَبُ",22,"ب",1,0],["لا تَزدَري يا اِبنَةَ الأَقوامِ ذا كَرَمٍ","إِن رَثَّ ثَوباهُ وَاِستَعصى عَلى النَظَرِ",23,"ر",1,0],["لا تَزدَرُنَّ صِغاراً في مَلاعِبِهِم","فَجائِزٌ أَن يُرَوا ساداتِ أَقوامِ",24,"م",1,1],["لا تزهق الروح من جسم يقيم به","واجمع إن اسطعت أرواحاً وأبدانا",25,"ن",2,0],["لاَ تَزِينُ الْخِصَالَ يَوْمَ فَخَارٍ","مِثْلُهُ فِي الرِّجَالِ أَرْوَعُ فَرْدَا",26,"د",2,0],["لا تزرها واجتنبها","إنّها شرُّ مزورِ",27,"ر",1,0],["لا تُزْهِرُ الجنةُ إِلاّ بما","يَسْفَحُه الباكِي على وِزْره",28,"ر",2,0],["لا تَزينُ العقودُ جِيداً إذا لم","يَكُ بالحسن قبلَها مُزدانا",29,"ن",2,0],["لا تُزيروهُمُ قبرَ كلِّ وليّ","وأزيروهم قبرَ كلِّ شهيد",30,"د",1,0],["لا تُزعجونا بالتشدُّقِ اننا","بسوى التخلص منكمُ لا نقنع",31,"ع",1,0],["لا تزال يا أبا الحسين أخا الإح","سان والحسن غائظاً من تغيظ",32,"ظ",1,0],["لاتزلْ عينُ شانيءٍ تتقذا","كم مَعوراً إنسانُها مبخوقا",33,"ق",2,0],["لاتَزينُ العقودُ جِيداً إذا لم","يَكُبالحسن قبلها مُزادنا",34,"ن",2,0]]}