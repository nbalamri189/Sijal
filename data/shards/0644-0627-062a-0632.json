28","الرمل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141567","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139587",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139520",""],[4675,"الإحتفال بالمولد النبوي","https://www.poetsgate.com/ViewPoem.aspx?id=193538",""],[4684,"مع (دونكيشوته) بدون همز.","https://www.poetsgate.com/ViewPoem.aspx?id=201111",""],[4830,"يالِقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=213988",""],[4929,"القدس والخونة","https://www.poetsgate.com/ViewPoem.aspx?id=199525",""],[5092,"هموم","https://www.poetsgate.com/ViewPoem.aspx?id=182903",""],[5186,"أيهذا البناء لو كنت حرا","https://www.poetsgate.com/ViewPoem.aspx?id=156469",""],[5277,"لوحةٌ ذهنية","https://www.poetsgate.com/ViewPoem.aspx?id=187829",""],[5277,"أشهى آهةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=192207",""],[5302,"وعلى هواه بما يرى ذهبا","https://www.poetsgate.com/ViewPoem.aspx?id=201380",""],[307,"الكنوز","https://www.poetsgate.com/ViewPoem.aspx?id=213659",""],[5387,"نغاق","https://www.poetsgate.com/ViewPoem.aspx?id=53769",""],[5409,"أين ذاك الوادي الذي كان بال","https://www.poetsgate.com/ViewPoem.aspx?id=155315",""],[5442,"حادي الركب لا تحث المطيا","https://www.poetsgate.com/ViewPoem.aspx?id=114762",""],[5550,"لا تزيدي","https://www.poetsgate.com/ViewPoem.aspx?id=212683",""],[5674,"دموعي فوق أهدابي ملح","https://www.poetsgate.com/ViewPoem.aspx?id=189088",""],[5674,"متمردة","https://www.poetsgate.com/ViewPoem.aspx?id=191453",""],[5764,"الليل فضّاح","https://www.poetsgate.com/ViewPoem.aspx?id=137062",""],[5909,"يا آخر العشّاق هبْكَ قيامَتي","https://www.poetsgate.com/ViewPoem.aspx?id=210559",""],[5961,"الذكر","https://www.poetsgate.com/ViewPoem.aspx?id=199835",""],[6102,"ذَبح !!","https://www.poetsgate.com/ViewPoem.aspx?id=183996",""],[6324,"لا تسل عن أرقي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87946&r=&rc=11",""]],"verses":[["لا تَزالُ الأَيّامُ تَصدُرُ مِنّا","عَن إِخاءٍ لَم نُقذِهِ بِفِراقِ",0,"ق",1,0],["لا تَزيدوا عَلى الصُكوكِ فِخاخاً","مِن غِناءٍ ما بَينَ دُفٍّ وَعودِ",1,"د",1,0],["لا تَزَل دَولَتُكُم مَبسوطَةً","بَسطَةً في طَيِّها قَبضُ الدُوَل",2,"ل",1,0],["لا تَزِيغُوا لِنَزْعَةٍ مِنْ وِدَادِ","لا تُرُومُوا سِوَى الْفَلاحِ مَرَامَا",3,"م",2,0],["لا تزد بلواه من فع","لك هذا ببلاء",4,"ا",2,0],["لا تَزجُرِ الفِتيانَ عَن سوءِ الرِعَه","يا رُبَّ هَيجا هِيَ خَيرٌ مِن دَعَه",5,"ع",2,1],["لا تزد القلب على شجوِه","إن كنت لا تأرق لي فاهجع",6,"ع",1,0],["لا تزل أيها الإِمام السعيدُ","لك نعمى تَنْمِي وعمر يزيدُ",7,"د",1,1],["لا تزلْ والوفود تَعْفر أفنا","ءك ما عشتَ والأسود وصيدَكْ",8,"ك",1,0],["لا تُزهَيَنَّ بما مَلكتَ فلم تكن","من قَبْلها حَرَضاً من الأحراض",9,"ض",1,0],["لا تزل يا أبا الحسين أخا الإح","سان والحسن غائظاً من تغيظ",10,"ظ",1,0],["لا تزل عين شانئٍ تتقذا","كم مَعوراً إنسانها مبخوقا",11,"ق",2,0],["لا تزُل عنه نعمةٌ لو أُزيلت","لم تجدْ عنه وِجهةً للزوالِ",12,"ل",1,0],["لا تزالُ القلوبُ تَصْبُو إليها","أو تراها تُقلِّب الأجفانا",13,"ن",2,0],["لا تزبرنَّ على الضعيفِ فربما","ظلم الزَّبيرُ فعاد رَجْعَ أنين",14,"ن",1,0],["لا تَزعَمَنَّ لَهُ المَتابَ","فَإِنَّ تَوبَتُهُ كِذاب",15,"ب",1,0],["لا تَزِدني فَوقَ سُكري","بِالهَوى سُكرَ الحُمَيّا",16,"ي",2,0],["لا تَزِد في الهَوى عَلَيَّ","إِنَّ رُشدَ المُحِبِّ غَيَّ",17,"ي",1,1],["لا تَزِدني فَوقَ ما قَد","كانَ مِن ذاكَ التَجَنّي",18,"ن",2,0],["لا تزالُ الأبرارُ تأمَنُ منه","سَطْوَةً تُتّقَى على الفُجّارِ",19,"ر",1,0],["لا تَزالينَ آثَرَ الناسِ عِندي","فَاِعلَمي ذاكَ في الهَوى ما حَيِيّنا",20,"ن",2,0],["لا تزيدوا نُفوسَنا مِن نَعيمٍ","زادَ أَنضاءَها أَذىً وَخَبالا",21,"ل",2,0],["لا تَزعُموا هَذِهِ الهَيجاءَ مُعجِزَةً","أَلا لَهُ البَأسُ وَالهَيجاءُ وَالغَلَبُ",22,"ب",1,0],["لا تَزدَري يا اِبنَةَ الأَقوامِ ذا كَرَمٍ","إِن رَثَّ ثَوباهُ وَاِستَعصى عَلى النَظَرِ",23,"ر",1,0],["لا تَزدَرُنَّ صِغاراً في مَلاعِبِهِم","فَجائِزٌ أَن يُرَوا ساداتِ أَقوامِ",24,"م",1,1],["لا تزهق الروح من جسم يقيم به","واجمع إن اسطعت أرواحاً وأبدانا",25,"ن",2,0],["لاَ تَزِينُ الْخِصَالَ يَوْمَ فَخَارٍ","مِثْلُهُ فِي الرِّجَالِ أَرْوَعُ فَرْدَا",26,"د",2,0],["لا تزرها واجتنبها","إنّها شرُّ مزورِ",27,"ر",1,0],["لا تُزْهِرُ الجنةُ إِلاّ بما","يَسْفَحُه الباكِي على وِزْره",28,"ر",2,0],["لا تَزينُ العقودُ جِيداً إذا لم","يَكُ بالحسن قبلَها مُزدانا",29,"ن",2,0],["لا تُزيروهُمُ قبرَ كلِّ وليّ","وأزيروهم قبرَ كلِّ شهيد",30,"د",1,0],["لا تُزعجونا بالتشدُّقِ اننا","بسوى التخلص منكمُ لا نقنع",31,"ع",1,0],["لا تزال يا أبا الحسين أخا الإح","سان والحسن غائظاً من تغيظ",32,"ظ",1,0],["لاتزلْ عينُ شانيءٍ تتقذا","كم مَعوراً إنسانُها مبخوقا",33,"ق",2,0],["لاتَزينُ العقودُ جِيداً إذا لم","يَكُبالحسن قبلها مُزادنا",34,"ن",2,0],["لا تزر أن قضيت قبري ولا تب","ك عليه كسائر الأصحاب",35,"ب",1,1],["لا تَزُرْ في كل يومٍ مرةً","كلَّ من تهوى فيعروك الملَلْ",36,"ل",1,0],["لا تزوَّجْ قطعاً بغير مَشُوراتٍ","من الأقرباء والأصدقاءِ",37,"ا",2,0],["لا تَزَوَّجْ قطعة عليها ولا","تنظُرْ سواها ياذا التُّقَى والوَفاءِ",37,"ا",2,0],["لا تزرعوا في المَحْلِ يوماً سُكراً","أن لا يَحُلَّ بكم أَسىً وشَقاءُ",38,"ا",2,0],["لا تزل حابسَ المطى بدورٍ","دارساتٍ قد خلتها وُشُومَا",39,"م",2,0],["لا تزل حابس المطى بدور","كنت فيها مع الرباب قديما",39,"م",2,0],["لا تزل هائما بهن مقيما","إن عارا عليك ألا تهيما",39,"م",2,0],["لا تَزُلْ عن العقيقيِ ففيهِ","وطرِى إن قضَيتُه أو نحبى",40,"ب",2,0],["لا تزالون ليلكم والنهارا","واتخذتم حب الغواني شعارا",41,"ر",2,0],["لا تزدهِيك ثيابُ الكِبرِياءِ ولا","يعتاد حلمَك تشتيتٌ وتفريق",42,"ق",1,0],["لا تَزِدني عَلَيكَ في الحُبِّ وَجداً","بَعضَ ما بي مِنَ الصَبابَةِ يكفى",43,"ف",2,0],["لاَ تَزَلْ تُبْرِزُ أَسْرَارَهُ","كَالصَّبَا تُذْكِي أَرِيجَ الأَقَاحْ",44,"ح",1,0],["لا تزيدي في شقائي","فشقائي زاد فصلا",45,"ل",2,0],["لا تزدْ، حسبي عتاباً","كُفَّ عني ذا الشقاقَ",46,"ق",1,0],["لا تزد ماء عبرتي دماءً","عندنا من جفاك ما يكفينا",47,"ن",2,0],["لا تُزعِج الموتى بشكواكَ التي","يَهتزُّ منها جندَلٌ ورجام",48,"م",1,0],["لا تَزَالُ العُجْمُ تَعْجُمُها","طَيَّ تَعْجيزٍ وَتَعْجيلِ",49,"ل",1,0],["لا تزدْ ضيقاً عليه سبلَه","ضَمنتْ سودُ اللَّيالي تبلَه",50,"ه",1,0],["لا تَزعمن أنّ شُرب الراح أَقبَح مِن","مَضَرّة الناس وَاِنشُد شارب الراحِ",51,"ح",1,1],["لا تَزُرها بَعدَ ذِئبِ هَوىً","إِنَّ تِلكَ الشَمسَ في الأَسَدِ",52,"د",1,0],["لا تزالون في الرِّجال رؤوساً","من رئيس منكم ومن مرؤوس",53,"س",1,0],["لا تزال الأيام في كلِّ حَوْلٍ","لكَ عيداً ودُمْتَ حَوْلاً فحَولا",54,"ل",2,0],["لا تزدري يا عاذلي بمهفهفٍ","قد جاءً يبدل شينهُ بالسينِ",55,"ن",1,1],["لاَ تَزِد شَتمِي وَمَنقصَتِي","إنَّمَا المَغبُونُ مَن غَبَنَا",56,"ن",2,0],["لا تزجر النفس عن أمرٍ تهمُّ به","فإنما العيش ما أحرزتَ من وطر",57,"ر",1,0],["لا تزدني بذا الزّمان اِختباراً","فلقد كنتُ بالزّمانِ عليما",58,"م",2,0],["لا تزل في نِعَمٍ تغ","دو عليها وتروحُ",59,"ح",1,0],["لا تزال الدنيا لديه ذلولاً","آخذاً في زمامها حيث شاءا",60,"ا",3,0],["لا تزال الصبوح أحلى مذاقاً","ومحيّا هندٍ وسيماً صبيحا",61,"ح",2,0],["لا تَزالُ الدّهرَ يا بُرجَ العُلى","لِلمِعالي فيكَ شَمسٌ ثمَّ صبحُ",62,"ح",1,0],["لا تزل ألفَ حجة مهرجانٍ","أنت تفضي به إلى النيروزِ",63,"ز",1,0],["لا تَزَل تُستَجَدُّ أيامُ أُنس","كُلَّ يومٍ بمثله مشفوعُ",64,"ع",1,0],["لا تَزده فَوقَ ما حَلَّ بِهِ","فَبِقَلبي شاغلٌ قَد شَغَلَه",65,"ل",2,0],["لا تزد في الهوى اواري فإني","عن عيون الورى اواري اواري",66,"ر",2,0],["لا تُزُوّج بكرَها بابنِ السَّمَا","رَونَقُ الحُسنِ لها بالعنَسِ",67,"س",1,0],["لا تزدني عليك في الحب وجدا","بعض ما بي من الصبابة أكفى",68,"ف",2,0],["لا تزدهيه الغانيات ولا","يصبيه حبُّ الأعين النجل",69,"ل",1,0],["لا تزال الأعياد عيداً فعيدا","لك تجلو منها الهلال السعيدا",70,"د",2,1],["لا تزرعن من الخلائق جدولا","هيهات إن ريعت وإن لم تريع",71,"ع",1,1],["لا تزدروا بمخاتل ومسارق","قد ذل من بعد المقام الشاهق",72,"ق",1,1],["لا تزدري برثيتِ خلقة ثوبهِ","عند التنفُّسِ في الكلام لنفسهِ",73,"س",2,0],["لا تزدني على الذي بي غراماً","وترفق فليس فيَّ مَزيدُ",74,"د",1,0],["لا تزدني على الذي بي وَجْداً","ما على ما لقيت من مستزاد",75,"د",1,0],["لا تزو عنا وجهك المجتلى","فالشمس لا يعهد منها قطوب",76,"ب",1,0],["لا تزدْ صاحِ عَلى اِستِمساكِنا","بِاِتِّحادٍ مُرعِبٍ مَن عَجَما",77,"م",2,0],["لا تزالوا بعزّة اللّه مشكور الفعا","ل على مدى الأيام",78,"م",1,0],["لا تزدني يا ربّ داء لجسمي","أنا حسي الإفلاسُ داء دفينا",79,"ن",2,1],["لا تزجوني بقبر انني","أبغض السجن ولو بعد مماتي",80,"ت",2,0],["لا تزال القلوب كالصخر حتى","تملئيها تلطفاً وقبولا",81,"ل",2,0],["لا تزالُ السّعودُ تقضي بما قد","يتمنّاهُ والزّمانُ غُلامه",82,"م",2,0],["لا تزنْها بسواها","فهي عند الوزن ترْزُن",83,"ن",1,0],["لا تزل في ظل عيش","ناعم لا يتغير",84,"ر",1,0],["لا تزالي في الفضل ورداً فتيقاً","وعليه آمالنا طلٌّ قطرِ",85,"ر",1,0],["لا تزعموا ان لا أراكم في النوى","فجمالكم في طرس شعري يرمق",86,"ق",1,0],["لا تَزْهَوُنَّ بحسنكم","والعيش مملوءٌ شجونا",87,"ن",2,0],["لا تَزدَهيهِ مِنَ الدُنيا مَطامِعُها","وَلا يُرى بِسِوى الإِحسان جَذلانا",88,"ن",2,0],["لا تَزدَهيهِ مِنَ الدُنيا مَطامِعُها","وَلا يُرى بِسِوى إِعطائِها جَذِلا",89,"ل",2,0],["لا تَزدَهيهِ مَطامِع الدُنيا وَلا","يَرنو لِزُخرُفِ حُسنِها المُتَعَجِّلِ",90,"ل",1,0],["لا تزيل الهموم الأسميا ال","غوث منكم لا خمرة القسيس",91,"س",1,0],["لا تَزَوَّج فَتَهلَكا","حِذرَكَ اليَومَ حِذرَكا",92,"ك",2,1],["لا تزرعنَّ سوى نبات عوال","إن العلى ثمر القنا العسّالِ",93,"ل",1,1],["لا تزد قلبي الكليم كلوما","إن للوجد فيه وقع النبال",94,"ل",1,0],["لا تَزَلْ دارُكَ كَيفَ اِنتَقَلتْ","كعبةً محفوفةً بالطّائفين",95,"ن",1,0],["لا تزيدوا الشكوى بحق عيال","لبثت خلفكم تبث الشكيه",96,"ه",1,0],["لا تزعجن أخا الذكاءِ قريحةً","في مدح أيٍّ قد كلفت بحبهِ",97,"ب",2,1],["لا تَزرعِ الخيرَ فيمن دأبُه خدَعٌ","كم مِن غَشومٍ غَواهُ النّطقُ بالرَّتَل",98,"ل",1,0],["لا تزلْ محفوفةً من","ك البرايا بالمآمن",99,"ن",1,0],["لا تزدني في حُبِّهِ يا عذولي","خلِّ النُّصحَ ما أَنا قابِلٌ له",100,"ل",2,0],["لا تَزِد مِن لَوعَةٍ كَبِدي","وَتَرفق إِنَّها كَبِدُ",101,"د",1,0],["لا تَزدَهيكَ عِزَّةُ المَناصِبِ","فَعِزَّةُ الدُنيا كَبَرق خالِبِ",102,"ب",1,0],["لا تُزهَ بِالطَريفِ وَالتلادِ","فَكُلُّ ما تَرى إِلى نَفادِ",102,"د",1,0],["لا تَزدَهيكَ زينَةُ الحَياةِ","فَكُلُّ مَجموعٍ إِلى شَتاتِ",103,"ت",1,0],["لا تَزدَهيكَ شُهرَةُ الإِنسانِ","وَلا تَقُل آخُذ عَن فُلانِ",104,"ن",1,0],["لا تزدني رشح علم","بالخبايا أنا أدري",105,"ي",1,0],["لا تزبئرّ إلى القتال ولا إلى ال","شكوى ولا تك بيننا قذِّيفا",106,"ف",2,0],["لا تزغ عنه لا ولا عن نظيرٍ","لعلاه اني ا