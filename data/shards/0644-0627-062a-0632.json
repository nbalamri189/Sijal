{"poems":[[53,"قمر غاض ضوؤه في المحاق","https://www.aldiwan.net/poem29935.html","الخفيف"],[86,"ارحمونا بني اليهود كفاكم","https://www.aldiwan.net/poem10952.html","الخفيف"],[73,"لست بالجاحد آلاء العلل","https://www.aldiwan.net/poem11941.html","الرمل"],[93,"مصر تهدي إلى بنيها السلاما","https://www.aldiwan.net/poem11323.html","الخفيف"],[88,"أيها الناظر ذا الفقر","https://www.aldiwan.net/poem45076.html","مجزوء الرمل"],[4,"لا تزجر الفتيان عن سوء الرعه","https://www.aldiwan.net/poem21177.html","الرجز"],[72,"كفوا حديث العذل عن مسمعي","https://www.aldiwan.net/poem19170.html","السريع"],[51,"لا تزل أيها الإمام السعيد","https://www.aldiwan.net/poem11443.html","الخفيف"],[51,"نفرت هيفك الليالي وغيدك","https://www.aldiwan.net/poem61938.html","الخفيف"],[51,"ومن العجائب يا أبا الفياض","https://www.aldiwan.net/poem64948.html","الكامل"],[51,"مذ صرت همي في النوم واليقظه","https://www.aldiwan.net/poem65036.html","المنسرح"],[51,"لم يزل قلبه إليهم مشوقا","https://www.aldiwan.net/poem65527.html","الخفيف"],[51,"أيها السيد الذي اختاره السيد","https://www.aldiwan.net/poem65973.html","الخفيف"],[51,"حببت درة القيان إلينا","https://www.aldiwan.net/poem66421.html","الخفيف"],[51,"سمعا أبا إسحق إنك ماجد","https://www.aldiwan.net/poem66524.html","الكامل"],[91,"يا شاعرا حلو المودة","https://www.aldiwan.net/poem8762.html","عموديه"],[70,"ونديم بت منه","https://www.aldiwan.net/poem42254.html","مجزوء الرمل"],[70,"لا تزد في الهوى علي","https://www.aldiwan.net/poem42389.html","مجزوء الخفيف"],[70,"ما الذي تطلب مني","https://www.aldiwan.net/poem42426.html","مجزوء الرمل"],[80,"عجبي من سكينتي ووقاري","https://www.aldiwan.net/poem31439.html","الخفيف"],[31,"إرحمينا يا نعم مما لقينا","https://www.aldiwan.net/poem41278.html","الخفيف"],[105,"أيها الجند ظافرا يتمشى","https://www.aldiwan.net/poem43097.html","الخفيف"],[105,"يا معشر الإنس جئتم كل رائعة","https://www.aldiwan.net/poem43105.html","البسيط"],[52,"وقفت بالروض أبكي فقد مشبهه","https://www.aldiwan.net/poem27052.html","البسيط"],[46,"لا تزدرن صغارا في ملاعبهم","https://www.aldiwan.net/poem23397.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85534","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54734","الخفيف"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116961","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54266","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54252","الخفيف"],[106,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[90,"الى السعدون..","https://www.poetsgate.com/ViewPoem.aspx?id=179037",""],[51,"ما يوفيك حقَّك التقريظُ","https://www.poetsgate.com/ViewPoem.aspx?id=29385",""],[51,"لم يزلْ قلْبُهُ إليهم مَشوقا","https://www.poetsgate.com/ViewPoem.aspx?id=29924",""],[101,"قد قرأنا الحياة َ سَطْراً فسطراً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62466&r=&rc=58",""],[118,"لا تزر أن قضيت قبري ولا تبك","https://www.aldiwan.net/poem49343.html","الخفيف"],[126,"شمر الذيل وبادر للعمل","https://www.aldiwan.net/poem50540.html","الرمل"],[126,"أيها العاقل الذي شاء تزو","https://www.aldiwan.net/poem50678.html","الخفيف"],[126,"أوصيكمو يا أيها العقلاء","https://www.aldiwan.net/poem50680.html","الكامل"],[130,"صاحب الرحل والقلوص الرسوما","https://www.aldiwan.net/poem54652.html","الخفيف"],[140,"يا صحابي واين منى صحبى","https://www.aldiwan.net/poem58430.html","البسيط"],[195,"لي طرف لم يدر ما الإغفاء","https://www.aldiwan.net/poem39813.html","الخفيف"],[227,"قلبي لحبك دون الخلق مخلوق","https://www.aldiwan.net/poem50915.html","البسيط"],[230,"قلت إن القضيب يحكيك عطفا","https://www.aldiwan.net/poem14754.html","الخفيف"],[235,"يا بدورا لست عنها بصاح","https://www.aldiwan.net/poem18118.html","المديد"],[252,"في الهوى لست وحدي","https://www.aldiwan.net/poem25017.html","مجزوء الرمل"],[252,"ضيقت الخناق","https://www.aldiwan.net/poem25019.html","مجزوء الرمل"],[259,"يا أخا العين في المحاسن عينا","https://www.aldiwan.net/poem38162.html","الخفيف"],[268,"الشام يقهر والعراق يضام","https://www.aldiwan.net/poem35641.html","الكامل"],[273,"لم يخن في الحب تأويلي","https://www.aldiwan.net/poem25541.html","المديد"],[296,"حق للمخزون أن ترثي له","https://www.aldiwan.net/poem36287.html","عموديه"],[351,"لا تزعمن أن شرب الراح أقبح من","https://www.aldiwan.net/poem40406.html","البسيط"],[364,"لست من صدي ولا رشدي","https://www.aldiwan.net/poem16978.html","المديد"],[413,"يا بني الشيخ والغياث المرجى","https://www.aldiwan.net/poem53846.html","الخفيف"],[413,"كم دم فيك أيها الريم طلا","https://www.aldiwan.net/poem54000.html","الخفيف"],[426,"لا تزدري يا عاذلي بمهفهف","https://www.aldiwan.net/poem40536.html","الكامل"],[431,"أيها ذا المدعي لسنا","https://www.aldiwan.net/poem25313.html","المديد"],[462,"وقد أخضب الدمع فاكفف رائد النظر","https://www.aldiwan.net/poem3578.html","عموديه"],[549,"خلها إنها تريد الغميما","https://www.aldiwan.net/poem47231.html","الطويل"],[549,"من رأى الأظعان فوق","https://www.aldiwan.net/poem47903.html","مجزوء الرمل"]],"verses":[["لا تَزالُ الأَيّامُ تَصدُرُ مِنّا","عَن إِخاءٍ لَم نُقذِهِ بِفِراقِ",0,"ق",1,0],["لا تَزيدوا عَلى الصُكوكِ فِخاخاً","مِن غِناءٍ ما بَينَ دُفٍّ وَعودِ",1,"د",1,0],["لا تَزَل دَولَتُكُم مَبسوطَةً","بَسطَةً في طَيِّها قَبضُ الدُوَل",2,"ل",1,0],["لا تَزِيغُوا لِنَزْعَةٍ مِنْ وِدَادِ","لا تُرُومُوا سِوَى الْفَلاحِ مَرَامَا",3,"م",2,0],["لا تزد بلواه من فع","لك هذا ببلاء",4,"ا",2,0],["لا تَزجُرِ الفِتيانَ عَن سوءِ الرِعَه","يا رُبَّ هَيجا هِيَ خَيرٌ مِن دَعَه",5,"ع",2,1],["لا تزد القلب على شجوِه","إن كنت لا تأرق لي فاهجع",6,"ع",1,0],["لا تزل أيها الإِمام السعيدُ","لك نعمى تَنْمِي وعمر يزيدُ",7,"د",1,1],["لا تزلْ والوفود تَعْفر أفنا","ءك ما عشتَ والأسود وصيدَكْ",8,"ك",1,0],["لا تُزهَيَنَّ بما مَلكتَ فلم تكن","من قَبْلها حَرَضاً من الأحراض",9,"ض",1,0],["لا تزل يا أبا الحسين أخا الإح","سان والحسن غائظاً من تغيظ",10,"ظ",1,0],["لا تزل عين شانئٍ تتقذا","كم مَعوراً إنسانها مبخوقا",11,"ق",2,0],["لا تزُل عنه نعمةٌ لو أُزيلت","لم تجدْ عنه وِجهةً للزوالِ",12,"ل",1,0],["لا تزالُ القلوبُ تَصْبُو إليها","أو تراها تُقلِّب الأجفانا",13,"ن",2,0],["لا تزبرنَّ على الضعيفِ فربما","ظلم الزَّبيرُ فعاد رَجْعَ أنين",14,"ن",1,0],["لا تَزعَمَنَّ لَهُ المَتابَ","فَإِنَّ تَوبَتُهُ كِذاب",15,"ب",1,0],["لا تَزِدني فَوقَ سُكري","بِالهَوى سُكرَ الحُمَيّا",16,"ي",2,0],["لا تَزِد في الهَوى عَلَيَّ","إِنَّ رُشدَ المُحِبِّ غَيَّ",17,"ي",1,1],["لا تَزِدني فَوقَ ما قَد","كانَ مِن ذاكَ التَجَنّي",18,"ن",2,0],["لا تزالُ الأبرارُ تأمَنُ منه","سَطْوَةً تُتّقَى على الفُجّارِ",19,"ر",1,0],["لا تَزالينَ آثَرَ الناسِ عِندي","فَاِعلَمي ذاكَ في الهَوى ما حَيِيّنا",20,"ن",2,0],["لا تزيدوا نُفوسَنا مِن نَعيمٍ","زادَ أَنضاءَها أَذىً وَخَبالا",21,"ل",2,0],["لا تَزعُموا هَذِهِ الهَيجاءَ مُعجِزَةً","أَلا لَهُ البَأسُ وَالهَيجاءُ وَالغَلَبُ",22,"ب",1,0],["لا تَزدَري يا اِبنَةَ الأَقوامِ ذا كَرَمٍ","إِن رَثَّ ثَوباهُ وَاِستَعصى عَلى النَظَرِ",23,"ر",1,0],["لا تَزدَرُنَّ صِغاراً في مَلاعِبِهِم","فَجائِزٌ أَن يُرَوا ساداتِ أَقوامِ",24,"م",1,1],["لا تزهق الروح من جسم يقيم به","واجمع إن اسطعت أرواحاً وأبدانا",25,"ن",2,0],["لاَ تَزِينُ الْخِصَالَ يَوْمَ فَخَارٍ","مِثْلُهُ فِي الرِّجَالِ أَرْوَعُ فَرْدَا",26,"د",2,0],["لا تزرها واجتنبها","إنّها شرُّ مزورِ",27,"ر",1,0],["لا تُزْهِرُ الجنةُ إِلاّ بما","يَسْفَحُه الباكِي على وِزْره",28,"ر",2,0],["لا تَزينُ العقودُ جِيداً إذا لم","يَكُ بالحسن قبلَها مُزدانا",29,"ن",2,0],["لا تُزيروهُمُ قبرَ كلِّ وليّ","وأزيروهم قبرَ كلِّ شهيد",30,"د",1,0],["لا تُزعجونا بالتشدُّقِ اننا","بسوى التخلص منكمُ لا نقنع",31,"ع",1,0],["لا تزال يا أبا الحسين أخا الإح","سان والحسن غائظاً من تغيظ",32,"ظ",1,0],["لاتزلْ عينُ شانيءٍ تتقذا","كم مَعوراً إنسانُها مبخوقا",33,"ق",2,0],["لاتَزينُ العقودُ جِيداً إذا لم","يَكُبالحسن قبلها مُزادنا",34,"ن",2,0],["لا تزر أن قضيت قبري ولا تب","ك عليه كسائر الأصحاب",35,"ب",1,1],["لا تَزُرْ في كل يومٍ مرةً","كلَّ من تهوى فيعروك الملَلْ",36,"ل",1,0],["لا تزوَّجْ قطعاً بغير مَشُوراتٍ","من الأقرباء والأصدقاءِ",37,"ا",2,0],["لا تَزَوَّجْ قطعة عليها ولا","تنظُرْ سواها ياذا التُّقَى والوَفاءِ",37,"ا",2,0],["لا تزرعوا في المَحْلِ يوماً سُكراً","أن لا يَحُلَّ بكم أَسىً وشَقاءُ",38,"ا",2,0],["لا تزل حابسَ المطى بدورٍ","دارساتٍ قد خلتها وُشُومَا",39,"م",2,0],["لا تزل حابس المطى بدور","كنت فيها مع الرباب قديما",39,"م",2,0],["لا تزل هائما بهن مقيما","إن عارا عليك ألا تهيما",39,"م",2,0],["لا تَزُلْ عن العقيقيِ ففيهِ","وطرِى إن قضَيتُه أو نحبى",40,"ب",2,0],["لا تزالون ليلكم والنهارا","واتخذتم حب الغواني شعارا",41,"ر",2,0],["لا تزدهِيك ثيابُ الكِبرِياءِ ولا","يعتاد حلمَك تشتيتٌ وتفريق",42,"ق",1,0],["لا تَزِدني عَلَيكَ في الحُبِّ وَجداً","بَعضَ ما بي مِنَ الصَبابَةِ يكفى",43,"ف",2,0],["لاَ تَزَلْ تُبْرِزُ أَسْرَارَهُ","كَالصَّبَا تُذْكِي أَرِيجَ الأَقَاحْ",44,"ح",1,0],["لا تزيدي في شقائي","فشقائي زاد فصلا",45,"ل",2,0],["لا تزدْ، حسبي عتاباً","كُفَّ عني ذا الشقاقَ",46,"ق",1,0],["لا تزد ماء عبرتي دماءً","عندنا من جفاك ما يكفينا",47,"ن",2,0],["لا تُزعِج الموتى بشكواكَ التي","يَهتزُّ منها جندَلٌ ورجام",48,"م",1,0],["لا تَزَالُ العُجْمُ تَعْجُمُها","طَيَّ تَعْجيزٍ وَتَعْجيلِ",49,"ل",1,0],["لا تزدْ ضيقاً عليه سبلَه","ضَمنتْ سودُ اللَّيالي تبلَه",50,"ه",1,0],["لا تَزعمن أنّ شُرب الراح أَقبَح مِن","مَضَرّة الناس وَاِنشُد شارب الراحِ",51,"ح",1,1],["لا تَزُرها بَعدَ ذِئبِ هَوىً","إِنَّ تِلكَ الشَمسَ في الأَسَدِ",52,"د",1,0],["لا تزالون في الرِّجال رؤوساً","من رئيس منكم ومن مرؤوس",53,"س",1,0],["لا تزال الأيام في كلِّ حَوْلٍ","لكَ عيداً ودُمْتَ حَوْلاً فحَولا",54,"ل",2,0],["لا تزدري يا عاذلي بمهفهفٍ","قد جاءً يبدل شينهُ بالسينِ",55,"ن",1,1],["لاَ تَزِد شَتمِي وَمَنقصَتِي","إنَّمَا المَغبُونُ مَن غَبَنَا",56,"ن",2,0],["لا تزجر النفس عن أمرٍ تهمُّ به","فإنما العيش ما أحرزتَ من وطر",57,"ر",1,0],["لا تزدني بذا الزّمان اِختباراً","فلقد كنتُ بالزّمانِ عليما",58,"م",2,0],["لا تزل في نِعَمٍ تغ","دو عليها وتروحُ",59,"ح",1,0]]}