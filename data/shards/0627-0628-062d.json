{"poems":[[53,"أرى نفسي تتوق إلى النجوم","https://www.aldiwan.net/poem29756.html","الوافر"],[53,"من الظلم أن نتعاطى الخمارا","https://www.aldiwan.net/poem30470.html","المتقارب"],[53,"نصافي المعالي والزمان معاند","https://www.aldiwan.net/poem30627.html","الطويل"],[3,"سائل عميرة حيث حلت جمعه","https://www.aldiwan.net/poem106.html",""],[77,"سكن الحب فؤادي وعمر","https://www.aldiwan.net/poem36493.html","الرمل"],[77,"أمولاي استزد بالشكر صنعا","https://www.aldiwan.net/poem36579.html","الوافر"],[77,"جهاد هوى لكن بغيري ثوابي","https://www.aldiwan.net/poem36716.html","الطويل"],[73,"أعرفك راح في عرف الرياح","https://www.aldiwan.net/poem11940.html","الوافر"],[83,"أبحر سماح مد عشرة أبحر","https://www.aldiwan.net/poem54259.html","الطويل"],[27,"أتصحو بل فؤادك غير صاح","https://www.aldiwan.net/poem5698.html","الوافر"],[72,"رمى حشاي ويا شوقي إلى الرامي","https://www.aldiwan.net/poem19676.html","البسيط"],[51,"طربت إلى ريحانة الأنف والقلب","https://www.aldiwan.net/poem8307.html","الطويل"],[51,"ومسمع لا عدمت فرقته","https://www.aldiwan.net/poem66043.html","المنسرح"],[29,"صحا القلب عن أروى وأقصر باطله","https://www.aldiwan.net/poem6057.html","الطويل"],[91,"طوى بعض نفسي إذ طواك الثرى عني","https://www.aldiwan.net/poem62780.html","عموديه"],[91,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[85,"أَمنس إلى كم تضل السبيلا","https://www.aldiwan.net/poem7517.html","المتقارب"],[43,"حشاشة نفس ودعت يوم ودعوا","https://www.aldiwan.net/poem9720.html","الطويل"],[44,"فحواك عين على نجواك يا مذل","https://www.aldiwan.net/poem30389.html","البسيط"],[87,"أطعت الغي في حب الغواني","https://www.aldiwan.net/poem8233.html","الوافر"],[48,"من سبني من ثقيف","https://www.aldiwan.net/poem10785.html","المجتث"],[48,"أبحت حريم الكأس إذ كنت مثريا","https://www.aldiwan.net/poem63305.html","الطويل"],[48,"أأشرس إن يكن ما قيل حقا","https://www.aldiwan.net/poem64485.html","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39625","السريع"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9871","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42611","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54952","الوافر"],[90,"على مجلسي","https://www.poetsgate.com/ViewPoem.aspx?id=179010",""],[3,"سائلْ عميرة َ حيثُ حلت جمعها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10719&r=&rc=73",""]],"verses":[["أَبَحتُ حَريمَهُ إِبِلي فَأَمسَت","تُغيرُ شِفاهَهنَ عَلى الجَميمِ",0,"م",1,0],["أَبَحنا حِماها أَكُفَّ المَطِيِّ","حَتّى اِنتَهَبنا الرُبى وَالجِرارا",1,"ر",2,0],["أَبَحنا لَها تَقتَضُّ مِن عُذَرِ الرُبى","فَكَرَّت عَلَيها بِالعَجاجِ الفَدافِدُ",2,"د",1,0],["أَبِحَيِّ قَيسٍ أَم بِعُذرَةَ بَعدَم","رُفِعَ اللِواءُ لَهَ وَبِئسَ المَلحَقُ",3,"ق",1,0],["أبْحُرُ الجودِ وأمْلاكُ الوَرى","وسُيوفُ اللهِ تُرْدي مَنْ كَفَرْ",4,"ر",1,0],["أبَحْتَ ذِمارَ مَنْ ناواكَ لمّا","نَوَيْتَ جِهادَهُ وقَصَدْتَ قَصْدَهْ",5,"د",2,0],["أبَحْنَ ذِمَاري وَانْتَهَبْنَ شَبِيبَتِي","أَهْنَّ نُصُولٌ أَمْ فُصًولُ خِضابِ",6,"ب",1,0],["أَبَحرَ الجودِ في يَومِ العَطايا","وَلَيثَ البَأسِ في يَومِ الكِفاحِ",7,"ح",1,0],["أبحرَ سماحٍ مدَّ عشرة أبحر","تفيض غمام الجود وهي الأناملُ",8,"ل",1,1],["أَبَحتَ حِمى تِهامَةَ بَعدَ نَجدٍ","وَما شَيءٌ حَمَيتَ بِمُستَباحِ",9,"ح",1,0],["أبحت يا صاحب السرّ النوال وقد","منعت ما خيف من ظلمٍ وإظلام",10,"م",1,0],["أبحتُ حمى قلبي له دون غيره","وأنزلتُهُ في السهل منه وفي الرَّحْبِ",11,"ب",1,0],["أبحَّ فيه شُذور حَشرجةٍ","منظومةٍ في مقاطعِ النغمِ",12,"م",1,0],["أَبَحتَ حُصونَ الأَعجَمينَ فَأَمسَكَت","بِأَبوابِها مِن مَنزِلٍ أَنتَ نازِلُه",13,"ل",2,0],["أَبَحتُ الأَسى دَمعي وَأَنهَبتُهُ دَمي","وَكُنتُ أُعِدُّ الحُزنَ ضَرباً مِنَ الجُبنِ",14,"ن",1,0],["أَبحَثُ عَن نَفسي فَلا أَهتَدي","وَلَيسَ يَهديني إِلَيها أَريب",15,"ب",1,0],["أبحث البراز بهذى البلاد","وكان البراز بها مستحيلا",16,"ل",2,0],["أَبَحرٌ يَضُرُّ المُعتَفينَ وَطَعمُهُ","زُعاقٌ كَبَحرٍ لا يَضُرُّ وَيَنفَعُ",17,"ع",1,0],["أَبَحتَ أَوعارَهُ بِالضَربِ وَهوَ حِمىً","لِلحَربِ يَثبُتُ فيهِ الرَوعُ وَالوَهَلُ",18,"ل",1,0],["أَبَحْتُ لَهُ الْفُؤَادَ فَعَاثَ فِيهِ","وَحَقُّ الضَّيْفِ إِعْزَازُ الْمَكَانِ",19,"ن",1,0],["أَبَحتُ عِرضي ثَقيفاً","وَلَطمَ خَدّي وَضَربَه",20,"ب",2,0],["أَبَحتُ حَريمَ الكَأسِ إِذ كُنتُ مُثرِياً","وَأَقصَرتُ عَنها بَعدَما صِرتُ مُعسِرا",21,"ر",2,1],["أَبَحتَ مِنِ اِبنِ أُختِكَ غَيرَ حِلٍّ","وَقُلتَ عَهِدتُ أَشياخي كَذاكا",22,"ك",2,0],["أبحثُ عنه وسُدىً ما أرى","أين حبيبي أين سارت خُطاه",23,"ه",1,0],["أَبِحَيِّ قَيسٍ أَم بِعُذرَةَ بَعدَما","رُفِعَ اللِواءُ لَهَ وَبِئسَ المَلحَقُ",24,"ق",1,0],["أَبَحْتُ لِلْعَيْنِ فِيهَا مَا تَقَرُّ بِهِ","وَذُدْتُ كَفَّ الصِّبَا عَنْ مَعْقِدِ الأُزُرِ",25,"ر",1,0],["أَبَحْت لَهَا دَمِي وَجَفوْتُ أَهْلِي","فكان الصَّدُّ مِنْهَا وَالنُّفُورُ",26,"ر",1,0],["ابحتُ لكِ الشَكوى فهل تسمعينها","والا فبَعدَ اليوم لستُ ببائح",27,"ح",1,0],["أبحيِّ قيس أمْ بعذرة َ بعدما","رفعَ اللواءُ لها وبئسَ الملحق",28,"ق",1,0]]}