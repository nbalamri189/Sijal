{"poems":[[53,"أرى نفسي تتوق إلى النجوم","https://www.aldiwan.net/poem29756.html","الوافر"],[53,"من الظلم أن نتعاطى الخمارا","https://www.aldiwan.net/poem30470.html","المتقارب"],[53,"نصافي المعالي والزمان معاند","https://www.aldiwan.net/poem30627.html","الطويل"],[3,"سائل عميرة حيث حلت جمعه","https://www.aldiwan.net/poem106.html",""],[77,"سكن الحب فؤادي وعمر","https://www.aldiwan.net/poem36493.html","الرمل"],[77,"أمولاي استزد بالشكر صنعا","https://www.aldiwan.net/poem36579.html","الوافر"],[77,"جهاد هوى لكن بغيري ثوابي","https://www.aldiwan.net/poem36716.html","الطويل"],[73,"أعرفك راح في عرف الرياح","https://www.aldiwan.net/poem11940.html","الوافر"],[83,"أبحر سماح مد عشرة أبحر","https://www.aldiwan.net/poem54259.html","الطويل"],[27,"أتصحو بل فؤادك غير صاح","https://www.aldiwan.net/poem5698.html","الوافر"],[72,"رمى حشاي ويا شوقي إلى الرامي","https://www.aldiwan.net/poem19676.html","البسيط"],[51,"طربت إلى ريحانة الأنف والقلب","https://www.aldiwan.net/poem8307.html","الطويل"],[51,"ومسمع لا عدمت فرقته","https://www.aldiwan.net/poem66043.html","المنسرح"],[29,"صحا القلب عن أروى وأقصر باطله","https://www.aldiwan.net/poem6057.html","الطويل"],[91,"طوى بعض نفسي إذ طواك الثرى عني","https://www.aldiwan.net/poem62780.html","عموديه"],[91,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[85,"أَمنس إلى كم تضل السبيلا","https://www.aldiwan.net/poem7517.html","المتقارب"],[43,"حشاشة نفس ودعت يوم ودعوا","https://www.aldiwan.net/poem9720.html","الطويل"],[44,"فحواك عين على نجواك يا مذل","https://www.aldiwan.net/poem30389.html","البسيط"],[87,"أطعت الغي في حب الغواني","https://www.aldiwan.net/poem8233.html","الوافر"],[48,"من سبني من ثقيف","https://www.aldiwan.net/poem10785.html","المجتث"],[48,"أبحت حريم الكأس إذ كنت مثريا","https://www.aldiwan.net/poem63305.html","الطويل"],[48,"أأشرس إن يكن ما قيل حقا","https://www.aldiwan.net/poem64485.html","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39625","السريع"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9871","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42611","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54952","الوافر"],[104,"سيدة الاقمار","https://www.poetsgate.com/ViewPoem.aspx?id=16826",""],[90,"على مجلسي","https://www.poetsgate.com/ViewPoem.aspx?id=179010",""],[3,"سائلْ عميرة َ حيثُ حلت جمعها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10719&r=&rc=73",""],[115,"ابحت لنا عينيك للسفك والفتك","https://www.aldiwan.net/poem40864.html","عموديه"],[117,"دمشق","https://www.aldiwan.net/poem24044.html","عموديه"],[117,"سافر","https://www.aldiwan.net/poem24065.html","السريع"],[136,"أيا معدن الآداب والظرف والنهى","https://www.aldiwan.net/poem2688.html","الطويل"],[142,"كما قلتما برء الصبابة في الياس","https://www.aldiwan.net/poem58452.html","الطويل"],[143,"إن لم أقل فيك ما يردي العدى كمدا","https://www.aldiwan.net/poem11753.html","البسيط"],[143,"شفاء الهدى يا سيفه العضب أن تشفا","https://www.aldiwan.net/poem11779.html","الطويل"],[204,"أبحت أبا الحسين صميم ودي","https://www.aldiwan.net/poem53359.html","الوافر"],[211,"إلى شاطئ فيه إغراقكم","https://www.aldiwan.net/poem46245.html","المتقارب"],[211,"يا مخلفا ودموع القلب تتبعه","https://www.aldiwan.net/poem46292.html","البسيط"],[239,"إلى مجدك العلياء تعزى وتنسب","https://www.aldiwan.net/poem23838.html","الطويل"],[275,"قضى صادق الآثار في أمرك الأرضى","https://www.aldiwan.net/poem25491.html","الطويل"],[280,"هي الديار فعج في رسمها العاري","https://www.aldiwan.net/poem60723.html","البسيط"],[305,"بذاتك يا الله بغيهبك الأسمى","https://www.aldiwan.net/poem56406.html","الطويل"],[353,"كل حي سوى المهيمن فاني","https://www.aldiwan.net/poem39759.html","الخفيف"],[353,"ألا يا غزالا قاتلي سهم لحظه","https://www.aldiwan.net/poem40358.html","الطويل"],[364,"لما تراءت راية الربيع","https://www.aldiwan.net/poem60555.html","الرجز"],[364,"لما تراءت راية الربيع","https://www.aldiwan.net/poem60851.html","الرجز"],[366,"لعمري لئن أضحى عن الغيد عاديا","https://www.aldiwan.net/poem17304.html","الطويل"],[366,"وليل بطيء طلوع الصباح","https://www.aldiwan.net/poem17865.html","المتقارب"],[377,"أيدري الدهر أيم الله أني","https://www.aldiwan.net/poem59430.html","الكامل"],[400,"يا ضيف وجداني","https://www.aldiwan.net/poem6759.html","عموديه"],[410,"حمدنا الذي أدى ابن يحيى فأصبحت","https://www.aldiwan.net/poem67519.html","الطويل"],[416,"بلغ الشوق لعمري ما أراد","https://www.aldiwan.net/poem53890.html","الرمل"],[429,"أراك سخي الدمع طال بك الأمر","https://www.aldiwan.net/poem41064.html","الطويل"],[432,"الحيا من غيوثك البارقات","https://www.aldiwan.net/poem12317.html","الخفيف"],[437,"صدرت ولم أنقع بكم غلة الصدر","https://www.aldiwan.net/poem2557.html","الطويل"],[441,"أطاوي السبسب القهب","https://www.aldiwan.net/poem14421.html","مجزوء الوافر"],[458,"إما تقومون كذا أو فاقعدوا","https://www.aldiwan.net/poem56238.html","الرجز"],[479,"أقلع بقشك أيها الأسطول","https://www.aldiwan.net/poem37195.html","الكامل"],[495,"قرة عيني بذكا محبتي أي فلكا","https://www.aldiwan.net/poem10256.html","مجزوء الرجز"],[529,"لله در المقبلي فإنه","https://www.aldiwan.net/poem37309.html","الكامل"],[538,"أيها القائد المفدى بروحي","https://www.aldiwan.net/poem47595.html","عموديه"],[551,"أما آن للسلوان أن يردع الصبا","https://www.aldiwan.net/poem48083.html","الطويل"],[551,"ولما التقينا والرقيب بنجوة","https://www.aldiwan.net/poem48108.html","الطويل"],[558,"أنا المعروف لي بالله ألوان","https://www.aldiwan.net/poem33827.html","الهزج"]],"verses":[["أَبَحتُ حَريمَهُ إِبِلي فَأَمسَت","تُغيرُ شِفاهَهنَ عَلى الجَميمِ",0,"م",1,0],["أَبَحنا حِماها أَكُفَّ المَطِيِّ","حَتّى اِنتَهَبنا الرُبى وَالجِرارا",1,"ر",2,0],["أَبَحنا لَها تَقتَضُّ مِن عُذَرِ الرُبى","فَكَرَّت عَلَيها بِالعَجاجِ الفَدافِدُ",2,"د",1,0],["أَبِحَيِّ قَيسٍ أَم بِعُذرَةَ بَعدَم","رُفِعَ اللِواءُ لَهَ وَبِئسَ المَلحَقُ",3,"ق",1,0],["أبْحُرُ الجودِ وأمْلاكُ الوَرى","وسُيوفُ اللهِ تُرْدي مَنْ كَفَرْ",4,"ر",1,0],["أبَحْتَ ذِمارَ مَنْ ناواكَ لمّا","نَوَيْتَ جِهادَهُ وقَصَدْتَ قَصْدَهْ",5,"د",2,0],["أبَحْنَ ذِمَاري وَانْتَهَبْنَ شَبِيبَتِي","أَهْنَّ نُصُولٌ أَمْ فُصًولُ خِضابِ",6,"ب",1,0],["أَبَحرَ الجودِ في يَومِ العَطايا","وَلَيثَ البَأسِ في يَومِ الكِفاحِ",7,"ح",1,0],["أبحرَ سماحٍ مدَّ عشرة أبحر","تفيض غمام الجود وهي الأناملُ",8,"ل",1,1],["أَبَحتَ حِمى تِهامَةَ بَعدَ نَجدٍ","وَما شَيءٌ حَمَيتَ بِمُستَباحِ",9,"ح",1,0],["أبحت يا صاحب السرّ النوال وقد","منعت ما خيف من ظلمٍ وإظلام",10,"م",1,0],["أبحتُ حمى قلبي له دون غيره","وأنزلتُهُ في السهل منه وفي الرَّحْبِ",11,"ب",1,0],["أبحَّ فيه شُذور حَشرجةٍ","منظومةٍ في مقاطعِ النغمِ",12,"م",1,0],["أَبَحتَ حُصونَ الأَعجَمينَ فَأَمسَكَت","بِأَبوابِها مِن مَنزِلٍ أَنتَ نازِلُه",13,"ل",2,0],["أَبَحتُ الأَسى دَمعي وَأَنهَبتُهُ دَمي","وَكُنتُ أُعِدُّ الحُزنَ ضَرباً مِنَ الجُبنِ",14,"ن",1,0],["أَبحَثُ عَن نَفسي فَلا أَهتَدي","وَلَيسَ يَهديني إِلَيها أَريب",15,"ب",1,0],["أبحث البراز بهذى البلاد","وكان البراز بها مستحيلا",16,"ل",2,0],["أَبَحرٌ يَضُرُّ المُعتَفينَ وَطَعمُهُ","زُعاقٌ كَبَحرٍ لا يَضُرُّ وَيَنفَعُ",17,"ع",1,0],["أَبَحتَ أَوعارَهُ بِالضَربِ وَهوَ حِمىً","لِلحَربِ يَثبُتُ فيهِ الرَوعُ وَالوَهَلُ",18,"ل",1,0],["أَبَحْتُ لَهُ الْفُؤَادَ فَعَاثَ فِيهِ","وَحَقُّ الضَّيْفِ إِعْزَازُ الْمَكَانِ",19,"ن",1,0],["أَبَحتُ عِرضي ثَقيفاً","وَلَطمَ خَدّي وَضَربَه",20,"ب",2,0],["أَبَحتُ حَريمَ الكَأسِ إِذ كُنتُ مُثرِياً","وَأَقصَرتُ عَنها بَعدَما صِرتُ مُعسِرا",21,"ر",2,1],["أَبَحتَ مِنِ اِبنِ أُختِكَ غَيرَ حِلٍّ","وَقُلتَ عَهِدتُ أَشياخي كَذاكا",22,"ك",2,0],["أبحثُ عنه وسُدىً ما أرى","أين حبيبي أين سارت خُطاه",23,"ه",1,0],["أَبِحَيِّ قَيسٍ أَم بِعُذرَةَ بَعدَما","رُفِعَ اللِواءُ لَهَ وَبِئسَ المَلحَقُ",24,"ق",1,0],["أَبَحْتُ لِلْعَيْنِ فِيهَا مَا تَقَرُّ بِهِ","وَذُدْتُ كَفَّ الصِّبَا عَنْ مَعْقِدِ الأُزُرِ",25,"ر",1,0],["أَبَحْت لَهَا دَمِي وَجَفوْتُ أَهْلِي","فكان الصَّدُّ مِنْهَا وَالنُّفُورُ",26,"ر",1,0],["أبحرتِ ، سيدةَ الأقمار ،عن رجلٍ ما زال يبحرُ في أعماقِه الكمدُ","وراعَك الحزنُ في عينيه..مؤتلقاً وصدّك اليأسُ في دنياه يحتشدُ",27,"د",1,0],["ابحتُ لكِ الشَكوى فهل تسمعينها","والا فبَعدَ اليوم لستُ ببائح",28,"ح",1,0],["أبحيِّ قيس أمْ بعذرة َ بعدما","رفعَ اللواءُ لها وبئسَ الملحق",29,"ق",1,0],["ابحت لنا عينيك للسفك والفتك","وعن سكرة الحسن تضحك اذ نبكي",30,"ك",2,1],["أبحرَ اللّيلُ ومِجْدافُ الهوى","وعلى مِيناءِ وِجْداني رَسا",31,"س",2,0],["أَبْحِرْ إلى قلبي، وشَطِّ الهوى","لا تبتعدْ، فالبُعْدُ عنّي خَطَرْ",32,"ر",1,0],["أَبَحتُ لَكَ التَقبيلَ في فيهِ إِنَّما","أَخافُ عَلَيكَ السكرَ يا نُخبَةَ الصَحبِ",33,"ب",1,0],["ابحتَ حِمىَ الإحسانِ حتّى أصابه","معاشرُ من نَيل المنى غيرُ أكياسِ",34,"س",1,0],["أَبَحتُكَ الصَفوَ مِن أَمواهِهِ فَسَقى","رِياضَ فَخرِكَ لا نَزراً وَلا ثَمَدا",35,"د",2,0],["أَبَحتَنِيَ الإيسارَ عِلماً بِأَنَّني","سَيَبقى عَلى الأَيّامِ ما أودِعُ الصُحفا",36,"ف",2,0],["أبحتُ أبا الحسين صميم ودي","فداعبني بألفاظٍ عِذابِ",37,"ب",1,1],["أبحتم من الهجو ما لا يباح","ففي هجوكم جادت القافيه",38,"ي",2,0],["أبحتك الخوف منى إنني أسدٌ","منه الظباء على ميعاد إرداء",39,"ا",2,0],["أبحت لهم جوداً ولم تستبحهم","فأصبحت منهوباً وأعداك تنهب",40,"ب",1,0],["أبَحْتَ حِماها قادِراً وحَمَيْتَه","فَغَادَرْتَ حُبَّ الغَدْرِ في صَدْرِها بُغْضا",41,"ض",2,0],["أَبَحْتَها وَحَمَيْتَ الشّامَ معْتقِداً","أَنْ لَيْسَ يَنْفَعُ إِلاّ كُلُّ ضَرّارِ",42,"ر",1,0],["أَبحتَ لَنا من اِسمك المؤمن الّذي","بِهِ قَد دُعينا المؤمنينَ حمىً أَسمى",43,"م",2,0],["أبحر الدَمع لا تُعادل نَفعاً","قَطرة مِن سَحائب الغُفرانِ",44,"ن",1,0],["أَبحت دَمي لِلأَعيُن الزُرق في الهَوى","فَفي أَيّ ذَنب كانَ حَظّيَ أَسوَدا",45,"د",2,0],["أَبَحتُ لِلنسِ دَمَ الزِقاقِ","في حَيثُ لاقوها مِنَ الآفاقِ",46,"ق",1,0],["أَبَحْتُ للنّاسِ دمَ الزِّقاقِ","في حيثُ لاقَوها منَ الآفاقِ",47,"ق",1,0],["أَبَحتُكِ سِرّاً في الفُؤادِ بِرَدِّهِ","سَيبقى وَإِن أَفنَيتُ فيكِ فُؤادِيا",48,"ي",2,0],["أَبَحتَ فُؤادي وَأَنتَ المُباحُ","وَما كانَ مِن حَقِّهِ اَن تُبيحَه",49,"ح",2,0],["أبحت المنكرات فلا نظامٌ","بسعيك إذ أضعت الحق هدرا",50,"ر",2,0],["أبحرتُ فيك لأنّك البَحْرُ","ونَهِلْتُ منك لأنّك النَّهْرُ",51,"ر",1,1],["أَبَحتَ جِبالَ الكابُلِيِّ وَلَم تَدَع","بِهِنَّ لِنيرانِ الضَلالَةِ مَوقِدا",52,"د",2,0],["أبحُر الجود وكلٌّ منهمُ","ربَّما أربى على البحر وزادا",53,"د",2,0],["أبحت الذي قد كان عندي مكنما","واعلنت وجدا فيك ام خفي السر",54,"ر",1,0],["أَبحَرَتْ عندكَ السّعودُ غَداةً","خلَّفَتْهَا النُّحوسُ عندَ عُداةِ",55,"ه",1,0],["أبحتم حمى قلبي فاصبح بعدكم","يشُكّ باطراف المثقّفة السمر",56,"ر",1,0],["أَبحت وغير مرتد","وهذا غاية الأَرب",57,"ب",1,0],["أبحتَني مجدَك إذ أرحتني","ممّن أذمُّ منهُمُ وأحمَدُ",58,"د",1,0],["ابحرت نحو الدردنيل لفتحه","فرأيت أن الدردنيل مهول",59,"ل",1,0],["أبحت روحي ودمي","بنى هداد روحكا",60,"ك",2,0],["أََبْحاثُهُ قَدْ سَدَّدَتْ سَهْماً إلى","نَحْرِ التَّعَصُّبِ مُرْهَفَ الأَطْرافِ",61,"ف",1,0],["أبحقٍّ لهم بِحَقِّكَ هذا","إني والله ذاتُ قَلبٍ حَزِينِ",62,"ن",1,0],["أَبَحتُ هَواها مِن سَرارةِ مُهجَتي","حِمىً لَو حَمَتْه همَّتي لم أكن صبّا",63,"ب",2,0],["أَبَحْنا الهَوى ما شاءَ مِنّا وَرُوِّيَتْ","عُيونٌ ظِماءٌ في الهَوى وَقُلوبُ",64,"ب",1,0],["أبحتم عرض من لم يرض ما أنتم","عليه من نفاق فهو خسران",65,"ن",1,0]]}