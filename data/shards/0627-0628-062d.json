ي !! بحر الهوى !! ولقيت سناره","https://www.poetsgate.com/ViewPoem.aspx?id=34861",""],[5841,"سافرت في فكري وْ هجيت","https://www.poetsgate.com/ViewPoem.aspx?id=37007",""],[5842,"ويحكِ يادمشق .. ! / غسان عبد الفتاح","https://www.poetsgate.com/ViewPoem.aspx?id=174873",""],[5848,"ختامها مسك","https://www.poetsgate.com/ViewPoem.aspx?id=53353",""],[5875,"شيّب المهاريف","https://www.poetsgate.com/ViewPoem.aspx?id=187017",""],[5908,"تعرفت منهم بالغربين أربعا","https://www.poetsgate.com/ViewPoem.aspx?id=170975",""],[5923,"لغد أقول ....... ذاك دأبي قبل يوم الأفول","https://www.poetsgate.com/ViewPoem.aspx?id=146239",""],[5937,"بَين رِمشَين","https://www.poetsgate.com/ViewPoem.aspx?id=211818",""],[5939,"بلاغٌ عن حالة عشق","https://www.poetsgate.com/ViewPoem.aspx?id=180016",""],[5943,"كرباجٌ لهاجٍ","https://www.poetsgate.com/ViewPoem.aspx?id=46729",""],[5956,"عيونهنّ","https://www.poetsgate.com/ViewPoem.aspx?id=181861",""],[5956,"كم موجةٍ شعريةٍ تجتاحني","https://www.poetsgate.com/ViewPoem.aspx?id=215614",""],[5970,"سر هذا الدهر قد أعيا طلابي","https://www.poetsgate.com/ViewPoem.aspx?id=130576",""],[5975,"عيناك .. الثريا","https://www.poetsgate.com/ViewPoem.aspx?id=52991",""],[5997,"بعثريني","https://www.poetsgate.com/ViewPoem.aspx?id=214249",""],[6019,"قبطان","https://www.poetsgate.com/ViewPoem.aspx?id=53051",""],[6019,"إبحار في عينيكِ","https://www.poetsgate.com/ViewPoem.aspx?id=53055",""],[6024,"الحاسد","https://www.poetsgate.com/ViewPoem.aspx?id=186346",""],[6031,"هِيَ الدارُ تَستسقيكَ مَدْمَعَكَ الجاري","https://www.poetsgate.com/ViewPoem.aspx?id=46266",""],[6035,"ويحكِ يادمشق .. !","https://www.poetsgate.com/ViewPoem.aspx?id=174872",""],[6038,"روح عساف","https://www.poetsgate.com/ViewPoem.aspx?id=25693",""],[6046,"هاجر لتنشئ دولة الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=36938",""],[6048,"في لون عينيك لاح الصبح والشفقُ","https://www.poetsgate.com/ViewPoem.aspx?id=197799",""],[6152,"وحدكِ من أناديه بروحي","https://www.poetsgate.com/ViewPoem.aspx?id=203275",""],[1078,"سيغني الله عن فرج القريب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=611785",""],[6201,"كينونة الماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87476&r=&rc=0",""],[6221,"رحلة في دروب الذكريات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64919&r=&rc=3",""],[6221,"عذبة النجوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64917&r=&rc=1",""],[6242,"قلمٌ حائر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87569&r=&rc=16",""],[6263,"كما شئتَ يا شعر...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81062&r=&rc=13",""],[6275,"الشاردة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83618&r=&rc=10",""],[6291,"مساءات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87669&r=&rc=2",""],[6314,"جدارية عارية للبحر والجسد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88073&r=&rc=8",""],[6323,"لغة الشعور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82174&r=&rc=5",""],[2696,"ألَمَّ خَيَالُ لَيْلى أُمِّ عَمْرِو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27409&r=&rc=13",""],[6339,"وطن النماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87894&r=&rc=6",""],[6355,"من أجل عينيك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66570&r=&rc=30",""]],"verses":[["أَبَحتُ حَريمَهُ إِبِلي فَأَمسَت","تُغيرُ شِفاهَهنَ عَلى الجَميمِ",0,"م",1,0],["أَبَحنا حِماها أَكُفَّ المَطِيِّ","حَتّى اِنتَهَبنا الرُبى وَالجِرارا",1,"ر",2,0],["أَبَحنا لَها تَقتَضُّ مِن عُذَرِ الرُبى","فَكَرَّت عَلَيها بِالعَجاجِ الفَدافِدُ",2,"د",1,0],["أَبِحَيِّ قَيسٍ أَم بِعُذرَةَ بَعدَم","رُفِعَ اللِواءُ لَهَ وَبِئسَ المَلحَقُ",3,"ق",1,0],["أبْحُرُ الجودِ وأمْلاكُ الوَرى","وسُيوفُ اللهِ تُرْدي مَنْ كَفَرْ",4,"ر",1,0],["أبَحْتَ ذِمارَ مَنْ ناواكَ لمّا","نَوَيْتَ جِهادَهُ وقَصَدْتَ قَصْدَهْ",5,"د",2,0],["أبَحْنَ ذِمَاري وَانْتَهَبْنَ شَبِيبَتِي","أَهْنَّ نُصُولٌ أَمْ فُصًولُ خِضابِ",6,"ب",1,0],["أَبَحرَ الجودِ في يَومِ العَطايا","وَلَيثَ البَأسِ في يَومِ الكِفاحِ",7,"ح",1,0],["أبحرَ سماحٍ مدَّ عشرة أبحر","تفيض غمام الجود وهي الأناملُ",8,"ل",1,1],["أَبَحتَ حِمى تِهامَةَ بَعدَ نَجدٍ","وَما شَيءٌ حَمَيتَ بِمُستَباحِ",9,"ح",1,0],["أبحت يا صاحب السرّ النوال وقد","منعت ما خيف من ظلمٍ وإظلام",10,"م",1,0],["أبحتُ حمى قلبي له دون غيره","وأنزلتُهُ في السهل منه وفي الرَّحْبِ",11,"ب",1,0],["أبحَّ فيه شُذور حَشرجةٍ","منظومةٍ في مقاطعِ النغمِ",12,"م",1,0],["أَبَحتَ حُصونَ الأَعجَمينَ فَأَمسَكَت","بِأَبوابِها مِن مَنزِلٍ أَنتَ نازِلُه",13,"ل",2,0],["أَبَحتُ الأَسى دَمعي وَأَنهَبتُهُ دَمي","وَكُنتُ أُعِدُّ الحُزنَ ضَرباً مِنَ الجُبنِ",14,"ن",1,0],["أَبحَثُ عَن نَفسي فَلا أَهتَدي","وَلَيسَ يَهديني إِلَيها أَريب",15,"ب",1,0],["أبحث البراز بهذى البلاد","وكان البراز بها مستحيلا",16,"ل",2,0],["أَبَحرٌ يَضُرُّ المُعتَفينَ وَطَعمُهُ","زُعاقٌ كَبَحرٍ لا يَضُرُّ وَيَنفَعُ",17,"ع",1,0],["أَبَحتَ أَوعارَهُ بِالضَربِ وَهوَ حِمىً","لِلحَربِ يَثبُتُ فيهِ الرَوعُ وَالوَهَلُ",18,"ل",1,0],["أَبَحْتُ لَهُ الْفُؤَادَ فَعَاثَ فِيهِ","وَحَقُّ الضَّيْفِ إِعْزَازُ الْمَكَانِ",19,"ن",1,0],["أَبَحتُ عِرضي ثَقيفاً","وَلَطمَ خَدّي وَضَربَه",20,"ب",2,0],["أَبَحتُ حَريمَ الكَأسِ إِذ كُنتُ مُثرِياً","وَأَقصَرتُ عَنها بَعدَما صِرتُ مُعسِرا",21,"ر",2,1],["أَبَحتَ مِنِ اِبنِ أُختِكَ غَيرَ حِلٍّ","وَقُلتَ عَهِدتُ أَشياخي كَذاكا",22,"ك",2,0],["أبحثُ عنه وسُدىً ما أرى","أين حبيبي أين سارت خُطاه",23,"ه",1,0],["أَبِحَيِّ قَيسٍ أَم بِعُذرَةَ بَعدَما","رُفِعَ اللِواءُ لَهَ وَبِئسَ المَلحَقُ",24,"ق",1,0],["أَبَحْتُ لِلْعَيْنِ فِيهَا مَا تَقَرُّ بِهِ","وَذُدْتُ كَفَّ الصِّبَا عَنْ مَعْقِدِ الأُزُرِ",25,"ر",1,0],["أَبَحْت لَهَا دَمِي وَجَفوْتُ أَهْلِي","فكان الصَّدُّ مِنْهَا وَالنُّفُورُ",26,"ر",1,0],["أبحرتِ ، سيدةَ الأقمار ،عن رجلٍ ما زال يبحرُ في أعماقِه الكمدُ","وراعَك الحزنُ في عينيه..مؤتلقاً وصدّك اليأسُ في دنياه يحتشدُ",27,"د",1,0],["ابحتُ لكِ الشَكوى فهل تسمعينها","والا فبَعدَ اليوم لستُ ببائح",28,"ح",1,0],["أبحيِّ قيس أمْ بعذرة َ بعدما","رفعَ اللواءُ لها وبئسَ الملحق",29,"ق",1,0],["ابحت لنا عينيك للسفك والفتك","وعن سكرة الحسن تضحك اذ نبكي",30,"ك",2,1],["أبحرَ اللّيلُ ومِجْدافُ الهوى","وعلى مِيناءِ وِجْداني رَسا",31,"س",2,0],["أَبْحِرْ إلى قلبي، وشَطِّ الهوى","لا تبتعدْ، فالبُعْدُ عنّي خَطَرْ",32,"ر",1,0],["أَبَحتُ لَكَ التَقبيلَ في فيهِ إِنَّما","أَخافُ عَلَيكَ السكرَ يا نُخبَةَ الصَحبِ",33,"ب",1,0],["ابحتَ حِمىَ الإحسانِ حتّى أصابه","معاشرُ من نَيل المنى غيرُ أكياسِ",34,"س",1,0],["أَبَحتُكَ الصَفوَ مِن أَمواهِهِ فَسَقى","رِياضَ فَخرِكَ لا نَزراً وَلا ثَمَدا",35,"د",2,0],["أَبَحتَنِيَ الإيسارَ عِلماً بِأَنَّني","سَيَبقى عَلى الأَيّامِ ما أودِعُ الصُحفا",36,"ف",2,0],["أبحتُ أبا الحسين صميم ودي","فداعبني بألفاظٍ عِذابِ",37,"ب",1,1],["أبحتم من الهجو ما لا يباح","ففي هجوكم جادت القافيه",38,"ي",2,0],["أبحتك الخوف منى إنني أسدٌ","منه الظباء على ميعاد إرداء",39,"ا",2,0],["أبحت لهم جوداً ولم تستبحهم","فأصبحت منهوباً وأعداك تنهب",40,"ب",1,0],["أبَحْتَ حِماها قادِراً وحَمَيْتَه","فَغَادَرْتَ حُبَّ الغَدْرِ في صَدْرِها بُغْضا",41,"ض",2,0],["أَبَحْتَها وَحَمَيْتَ الشّامَ معْتقِداً","أَنْ لَيْسَ يَنْفَعُ إِلاّ كُلُّ ضَرّارِ",42,"ر",1,0],["أَبحتَ لَنا من اِسمك المؤمن الّذي","بِهِ قَد دُعينا المؤمنينَ حمىً أَسمى",43,"م",2,0],["أبحر الدَمع لا تُعادل نَفعاً","قَطرة مِن سَحائب الغُفرانِ",44,"ن",1,0],["أَبحت دَمي لِلأَعيُن الزُرق في الهَوى","فَفي أَيّ ذَنب كانَ حَظّيَ أَسوَدا",45,"د",2,0],["أَبَحتُ لِلنسِ دَمَ الزِقاقِ","في حَيثُ لاقوها مِنَ الآفاقِ",46,"ق",1,0],["أَبَحْتُ للنّاسِ دمَ الزِّقاقِ","في حيثُ لاقَوها منَ الآفاقِ",47,"ق",1,0],["أَبَحتُكِ سِرّاً في الفُؤادِ بِرَدِّهِ","سَيبقى وَإِن أَفنَيتُ فيكِ فُؤادِيا",48,"ي",2,0],["أَبَحتَ فُؤادي وَأَنتَ المُباحُ","وَما كانَ مِن حَقِّهِ اَن تُبيحَه",49,"ح",2,0],["أبحت المنكرات فلا نظامٌ","بسعيك إذ أضعت الحق هدرا",50,"ر",2,0],["أبحرتُ فيك لأنّك البَحْرُ","ونَهِلْتُ منك لأنّك النَّهْرُ",51,"ر",1,1],["أَبَحتَ جِبالَ الكابُلِيِّ وَلَم تَدَع","بِهِنَّ لِنيرانِ الضَلالَةِ مَوقِدا",52,"د",2,0],["أبحُر الجود وكلٌّ منهمُ","ربَّما أربى على البحر وزادا",53,"د",2,0],["أبحت الذي قد كان عندي مكنما","واعلنت وجدا فيك ام خفي السر",54,"ر",1,0],["أَبحَرَتْ عندكَ السّعودُ غَداةً","خلَّفَتْهَا النُّحوسُ عندَ عُداةِ",55,"ه",1,0],["أبحتم حمى قلبي فاصبح بعدكم","يشُكّ باطراف المثقّفة السمر",56,"ر