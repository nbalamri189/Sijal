{"poems":[[9,"بانت سعاد وأمسى حبلها انقطعا","https://www.aldiwan.net/poem21951.html","البسيط"],[95,"سادتي جاز فضلكم آمالي","https://www.aldiwan.net/poem9161.html","الخفيف"],[90,"يا إمام الهدى ورب المعالي","https://www.aldiwan.net/poem44433.html","الخفيف"],[53,"كم يعز المفضل المبخوت ويبز المحبب المنعوت","https://www.aldiwan.net/poem8693.html","الخفيف"],[53,"ثنى شوقه والمرء يصحو ويسكر","https://www.aldiwan.net/poem63015.html","الطويل"],[53,"خلياني عند اصطكاك الخصومِ","https://www.aldiwan.net/poem66322.html","الطويل"],[53,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[58,"لو أطقت العزاء ما قل صبري","https://www.aldiwan.net/poem58660.html","الخفيف"],[54,"فك حرا للوجد قيد البكاء","https://www.aldiwan.net/poem27332.html","الخفيف"],[50,"أيها العاتب في الخم","https://www.aldiwan.net/poem66171.html","مجزوء الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39634","الرمل"],[92,"بشرى جنيف","https://www.poetsgate.com/ViewPoem.aspx?id=179106",""],[92,"الإقطاع","https://www.poetsgate.com/ViewPoem.aspx?id=179169",""],[53,"خلياني عند اصطكاك الخصوم","https://www.poetsgate.com/ViewPoem.aspx?id=25876",""],[132,"يا نفس أنت محادده","https://www.aldiwan.net/poem50643.html","مجزوء الكامل"],[146,"لست أقضى إذا رأيتك نذرا","https://www.aldiwan.net/poem58427.html","الخفيف"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[199,"لو أطعتك يا غرار كسوتني","https://www.aldiwan.net/poem54379.html","الكامل"],[327,"آذن اليوم جيرتي بارتحال","https://www.aldiwan.net/poem56350.html","الخفيف"],[463,"ما على منجد رأى ما أهمه","https://www.aldiwan.net/poem55903.html","الخفيف"],[463,"نظرة منك ويوم بالجريب","https://www.aldiwan.net/poem56280.html","الرمل"],[520,"لو اطلعت على سري وإضماري","https://www.aldiwan.net/poem12126.html","البسيط"],[567,"أجمل الله في فؤادك صبرا","https://www.aldiwan.net/poem52990.html","الخفيف"],[591,"من للخلاف وللوفاق مسائلا","https://www.aldiwan.net/poem17726.html","الكامل"],[591,"يا أقتل الناس ألحاظا وأعذبهم","https://www.aldiwan.net/poem18009.html","البسيط"],[612,"","https://poetry.dctabudhabi.ae/diwan/poem/82798","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122723","الكامل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96987","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63891","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64292","المجتث"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62500","الرمل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62460","الرمل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138103",""],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49552","الخفيف"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76675","الخفيف"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202066","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53195","السريع"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77227","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93676","البسيط"],[3156,"","https://poetry.dctabudhabi.ae/diwan/poem/34722","المتقارب"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104302","المديد"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91198","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216573","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141680","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120300","الكامل"],[4702,"الحياة دروب","https://www.poetsgate.com/ViewPoem.aspx?id=163960",""],[1901,"من مجيري من الهوى أَو معيني","https://www.poetsgate.com/ViewPoem.aspx?id=160400",""],[5022,"البردة المالكية","https://www.poetsgate.com/ViewPoem.aspx?id=186512",""],[5106,"عَاْشَ صَقْرَاً قَلَصَ الْكِبْرَ حِيْاْضَاْ","https://www.poetsgate.com/ViewPoem.aspx?id=150032",""],[5376,"أشكو السَقَامةَ بالهوى يا شامُ","https://www.poetsgate.com/ViewPoem.aspx?id=188933",""],[5518,"هو المختار (ﷺ)","https://www.poetsgate.com/ViewPoem.aspx?id=187373",""],[5573,"اشوف العلم للغادي مناره","https://www.poetsgate.com/ViewPoem.aspx?id=200316",""],[5608,"صبح المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=33180",""],[5691,"ليالي شهرزاد","https://www.poetsgate.com/ViewPoem.aspx?id=205893",""],[469,"جزتَ في المجد والفعال الشريفِ","https://www.poetsgate.com/ViewPoem.aspx?id=76859",""],[5952,"نِلْتُ خُفَّا","https://www.poetsgate.com/ViewPoem.aspx?id=201759",""],[6124,"لو أطعنا","https://www.poetsgate.com/ViewPoem.aspx?id=174955",""],[520,"لو اطلعت على سري وإضماري","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577530",""],[5126,"فلسطين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87828&r=&rc=43",""]],"verses":[["لَو أُطعِموا المَنَّ وَالسَلوى مَكانَهُمُ","ما أَبصَرَ الناسُ طُعماً فيهِمُ نَجَعا",0,"ع",2,0],["لو أطاعتني الصفا لما أك","بر فيكم من النهى والخصال",1,"ل",1,0],["لو أطاقوا أن يقتلوا منك جسماً","ما أطاقوا أن يقتلوا منك ذكرا",2,"ر",2,0],["لو أطقتُ القتال عنكم لقاتلْ","تُ ولو أنَّ قِرنيَ التابوتُ",3,"ت",1,0],["لو اطلعت عيناك فيه اطِّلاعةً","رأيت قليباً جولُها يَتهوَّر",4,"ر",1,0],["لو أطاعتْ كما عصتْ لاستحقَّتْ","خُلَّة الله دون إبراهيم",5,"م",1,0],["لو أطافا هناك للدهر قسراً","حارَنا سابقَيْه أَيَّ حِرانِ",6,"ن",1,0],["لَوْ أَطَقْتُ العَزَاءَ ما قَلَّ صَبْري","وقَبيحٌ في الحبِّ حُسْنُ العَزَاءِ",7,"ا",2,1],["لَو أَطَعنا لِلصَبرِ عِندَ الرَزايا","ما عَرَفناهُ شِدَّةً مِن رَخاءِ",8,"ا",2,0],["لَو أَطَعنا ذا عِتابٍ","لَأَطَعنا اللَهَ فيها",9,"ي",3,0],["لو أطاقوا أفلتوا من قيدها","فإذا هم حيث شاؤوا يُشرقونْ",10,"ن",1,0],["لو اطاقَتْ فيه الغضونُ لقصَّتْ","عن عراكٍ مع الليالي ، عنيف",11,"ف",1,0],["لو اطَّلَعتْ عيناكَ أبصرتَ مأْتَماً","أُقيمَ على الأحياءِ قبلَ المآتم",12,"م",1,0],["لو أطاعت كما عصت لاستحقت","وهْو أدنى لهُ إلى التَّضريم",13,"م",1,0],["لو أطنبوا في وَصْفِها","دهرا فكانت زايِدَهْ",14,"د",2,0],["لو أطاقت سعيا إذا زُلتَ عنها","لغدت في أوائل الركب حسرى",15,"ر",2,0],["لَو أَطاعوا هِرقلهُم إِذ نهاهم","بِنهاهُ لمّا هُريقت دماءُ",16,"ا",2,0],["لَو أَطَعتُكَ يا غِرارُ كَسَوتَني","في كُلِّ مَجمَعَةٍ ثِنِيابَ صَغارِ",17,"ر",1,1],["لَو أُطيعُ الشَمُوعَ أَو تَعتَليني","زَلَّ حِلمي وَلا مَني عُذّالي",18,"ل",2,0],["لو أطعتُ العفاف ما دنَّستني","خُلطةٌ في رَعاعِ هذي اللُّمّهْ",19,"م",2,0],["لو أطاعته يدٌ حاملةٌ","لم تُكذِّبْ ظبتاهُ عن ضَريبِ",20,"ب",1,0],["لو اطلعت على سري وإضماري","لم تؤثري غير ما يجري بغيثاري",21,"ر",2,1],["لَو أَطَعنا الدُّموعَ مُبتَدِراتٍ","ما وَقَفنا عَليكَ نُنشِدُ شِعرا",22,"ر",2,0],["لَوْ أُطْلقَ اسْمُ النيّراتِ لما سَرَى","ذِهْنُ الّذي هُوَ سامعٌ لِسِواكُمُ",23,"م",1,0],["لَوِ اطَّلعْتَ على قَلْبي وَجَدْتَ بِهِ","مِنْ فِعْلِ عَيْنَيكَ جُرْحاً لَيْسَ يَنْدَمِلُ",24,"ل",1,0],["لَو أَطلَق المَرء لِلعَين العِنان عَلى","تِلكَ المَآسي لَما جَفت مَآقيها",25,"ي",3,0],["لَو أُطلِقُوا وشُكِلتَ ثُم جَريتُم","في حَلبَةٍ لَسَبقتَهُم مَشكولا",26,"ل",2,0],["لو أطاقت أم السماء لضمتك","إليها حرصاً عليك وبرا",27,"ر",2,0],["لو اطَّلَعْتُ على ما في ضميرك مِنْ","شوقٍ لما هبتُ أنْ أسعى على راسي",28,"س",2,0],["لَوِ اطَّلَعْتَ عَلَيْهِمْ","وَلَّيْتَ مِنْهُمْ فِرارا",29,"ر",2,0],["لو أطار البشر جسماً","كنتَ يا جسمي طائرْ",30,"ر",1,0],["لو أطاعوا عُلَماهُم ثبتوا","لكن السَّابقُ فيهم لا يُردّ",31,"د",1,0],["لو أطلقوها لطار اليوم مبتهجا","كبلبل الروض من غُصن الى غُصنُ",32,"ن",1,0],["لو أَطافَتْ لأطفأتْ حُرَقاتِ","الوَجْدِ بينَ القُلوب والأكباد",33,"د",1,0],["لو أطلت علي رحمة عيني","ه انجلت شدتي وذاب حديدي",34,"د",2,0],["لو أطاق الصفا لقبرك سعيا","لسعى وهو شيق متبول",35,"ل",1,0],["لو أطْلِقت والريح في حَلبَةٍ","لطالت الريح وجاءت أمام",36,"م",1,0],["لَو أَطَقنا حَملَ السِلاحِ لَأَنزَل","ناكمُ كارِهينَ خَلفَ الحُدودِ",37,"د",1,0],["لَو أَطلَقوها وَراء البر آونة","لِيَمسكُوه أَتت وَالبر قَد مسكا",38,"ك",2,0],["لِواطُ الخَليفَةِ أَعجوبَةٌ","وَأَعجَبُ مِنهُ فِعالُ الوَزير",39,"ر",1,0],["لو أطاعت أمر خالقها","فكرت في قتل عاشقها",40,"ه",2,1],["لَو أَطاعوا لكانوا للعفو أَهلاً","أَو أَجابوا لكان للعذر محمل",41,"ل",1,0],["لو أطلقوها كما شاءت لكان لهم","منها قيان كما شاؤا وندمان",42,"ن",1,0],["لو أطاق المسير من هذه الأر","ض لما حلّ غير بلدة حمص",43,"ص",1,0],["لو اطلقت لي قدرة لربطته","مع صنوه اعنى به العكموسا",44,"س",2,0],["لو اطيع النفس فيها طحت في وسط الخطر","كلّ وقت اردّ عنها نفسي وشيطانيه",45,"ن",3,0],["لو أطعنا عقولنا ما اشترينا","سلعةَ الحبِّ بالشبابِ الثمينِ",46,"ن",1,0],["لو اطلعت عليهم في تقلّبهم","لم تغمض الطرف بعد اليوم من رخم",47,"م",1,0],["لَوْ أَطَلَّتْ لَمْعَةُ الأَسْيَاْفِ قَاْضَىْ","عَاْشَ شَهْمَاً مِنْ سِنَامِ الْمَجْدِ فَاْضَا",48,"ا",1,0],["لو أطرقوني في المهاجرِ مبعدا","أو أخرسوني لا يحاق كلامُ",49,"م",1,0],["لو أطلق الكونُ الفسيحُ لسانه","لسرتْ إليك بمدحه الأشعار",50,"ر",1,0],["لواطلب درب يتعبني مساره","ابصبر لين مااتم المسيره",51,"ر",2,0],["لو اطلبتني كلي .. كلي لها شوَي","وشلون اوفّي .. من برتني بهدبها",52,"ه",2,0],["لوْ أطَعْتِ الفُؤادَ إحْدى اللَّيالي","لجَنى إثْرَها عليْكِ الفُؤادُ",53,"د",1,0],["لو أطلتَ النَّوى لأظمأتُ إغذ","اذي إلى منزل النوى ووجيفي",54,"ف",2,0],["لو أطلَّت منْ نهارٍ ربما","آثرتْ شمسيْ بهذا الكون كسْفا",55,"ف",2,0],["لو أطعنا زرقةَ الثوبِ القصيرِ","لاقتنصنا بهجةً للروحِ تسري",56,"ي",1,1],["لو اطلعت على سرّي وإضماري","لم تؤثري غير ما يجري بإيثاري",57,"ر",2,1],["لو اطّرِد المقياس يوماً لمزقت","طُلىً من دهاقين العُلوج إزاءَها",58,"ا",3,0]]}