{"poems":[[55,"لا عادت الكأس عليل النسيم","https://www.aldiwan.net/poem29774.html","السريع"],[55,"من شافعي وذنوبي عندها الكبر","https://www.aldiwan.net/poem30415.html","البسيط"],[57,"أجفوه أني أبقي عليه وفي القلب","https://www.aldiwan.net/poem26477.html","المنسرح"],[79,"يا سراج الجمال يا ابن سراج","https://www.aldiwan.net/poem36668.html","الخفيف"],[88,"حال بين الجفن والوسن","https://www.aldiwan.net/poem68962.html","المديد"],[95,"أغادية بكرت بالحيا","https://www.aldiwan.net/poem11146.html","المتقارب"],[74,"وأغيد كل شيء منه يعجبني","https://www.aldiwan.net/poem19143.html","البسيط"],[94,"بالأمس قد كانت حياتي","https://www.aldiwan.net/poem38891.html","المجتث"],[91,"انظر إلى الكواكب","https://www.aldiwan.net/poem44667.html","مجزوء الرجز"],[87,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[45,"حسم الصلح ما اشتهته الأعادي","https://www.aldiwan.net/poem9554.html","الخفيف"],[47,"هاجي بني بحتر وطيئها","https://www.aldiwan.net/poem62765.html","المنسرح"],[63,"رد جفني بسافح الدمع يندى","https://www.aldiwan.net/poem51724.html","الخفيف"],[51,"أجفوتني فيمن جفاني","https://www.aldiwan.net/poem65339.html","مجزوء الكامل"],[68,"لي صاحب إن خانني دهري وفى","https://www.aldiwan.net/poem40947.html","الكامل"],[68,"لمن الشوازب كالنعام الجفل","https://www.aldiwan.net/poem41583.html","الكامل"],[46,"أجفان خوط البانة الأملود","https://www.aldiwan.net/poem30531.html","الكامل"],[159,"ونرجس للنسيم معتنق","https://www.aldiwan.net/poem55596.html","المنسرح"],[190,"دعوه يبكي لفقد خلانه","https://www.aldiwan.net/poem43249.html","المنسرح"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[214,"تخطرت والتفتت كالرشا","https://www.aldiwan.net/poem13346.html","السريع"],[255,"أجفانه ضمنت لي صدق موعده","https://www.aldiwan.net/poem14980.html","البسيط"],[275,"سحرا مشى الفتيان مبتسمينا","https://www.aldiwan.net/poem35623.html","الكامل"],[287,"من قد من قد قلبي يخجل البان","https://www.aldiwan.net/poem32339.html","البسيط"],[287,"حي على أثلات يبرينا","https://www.aldiwan.net/poem32396.html","السريع"],[287,"يا بدر تم ليس لي","https://www.aldiwan.net/poem32446.html","مجزوء الكامل"],[287,"صيدت ضراغم حاجر بمحاجر","https://www.aldiwan.net/poem32744.html","الكامل"],[287,"فيك عذولي عذرا","https://www.aldiwan.net/poem32763.html","مجزوء الرجز"],[287,"يا نجم كم أدنو إليك وتبعد","https://www.aldiwan.net/poem32806.html","الكامل"],[287,"ما شد أزرار القبا","https://www.aldiwan.net/poem32867.html","مجزوء الرجز"],[287,"يا سائرين أوائل الركب","https://www.aldiwan.net/poem32869.html","أحذ الكامل"],[302,"هد الحمام لآل عبد مناف","https://www.aldiwan.net/poem33214.html","الكامل"],[385,"أذكيت حر الجوى والليل قد بردا","https://www.aldiwan.net/poem49197.html","البسيط"],[385,"قلب تكون من ضرم","https://www.aldiwan.net/poem49211.html","مجزوء الكامل"],[435,"قمر بأفلاك الخدورِ","https://www.aldiwan.net/poem40082.html","مجزوء الكامل"],[438,"أبليت بعدك في الأنام ظنوني","https://www.aldiwan.net/poem12427.html","الكامل"],[519,"ضربوا القباب وطنبوها بالقنا","https://www.aldiwan.net/poem20802.html","الكامل"],[567,"سل ابنة القوم هل تدري بما صنعت","https://www.aldiwan.net/poem52879.html","البسيط"],[580,"لست الملوم بما تجني علي بصري","https://www.aldiwan.net/poem3066.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138427",""],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44561","الرجز"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122353","السلسلة"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64059","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63893","الكامل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59673","السريع"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78049","الرجز"],[1779,"","https://poetry.dctabudhabi.ae/diwan/poem/124063","الكامل"],[2643,"","https://poetry.dctabudhabi.ae/diwan/poem/123809","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100297","الرجز"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74168","الطويل"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110809","الرجز"],[3369,"","https://poetry.dctabudhabi.ae/diwan/poem/117027","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62897","الكامل"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101242","السريع"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216811","الكامل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66551","الكامل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44897","الرمل"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78269","الكامل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127248","السريع"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54498","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45136","المنسرح"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94547","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73378","الدوبيت"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76727","الوافر"],[4984,"الْيَأْسُ","https://www.poetsgate.com/ViewPoem.aspx?id=204660",""],[5147,"ما أضمرت مني الضمائر","https://www.poetsgate.com/ViewPoem.aspx?id=166704",""],[5213,"أرأيت كيف تقصف الاسل","https://www.poetsgate.com/ViewPoem.aspx?id=170519",""],[5338,"لي في هباتك حيرة لا توصف","https://www.poetsgate.com/ViewPoem.aspx?id=187913",""],[709,"ضربوا القبابَ وطنّبوها بالقنا","https://www.poetsgate.com/ViewPoem.aspx?id=2906",""],[5464,"كُتِبَ الوفاءُ عليَّ دون إرادتي","https://www.poetsgate.com/ViewPoem.aspx?id=125405",""],[5464,"يا صاحبي","https://www.poetsgate.com/ViewPoem.aspx?id=6687",""],[5470,"خضاب القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=10979",""],[5621,"كيفَ تمضي","https://www.poetsgate.com/ViewPoem.aspx?id=24563",""],[5309,"أنوار هادي الورى في كعبة الحرم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573517",""]],"verses":[["أَجفو مَغانيهِ وَما بَينَنا","لا يُغضِبُ الناقَةَ فيهِ الرَسيم",0,"م",1,0],["أَجفو لَهُ الوُلدَ مَذخوراً لَهُ شَفَقِ","عَليهِ دونَهُمُ الرَوعاتُ وَالحَذَرُ",1,"ر",1,0],["أَجفوهُ أَنّي أُبقي عَلَيهِ وَفي ال","قَلبِ اِشتياقٌ كَأَنَّهُ اللَهَبُ",2,"ب",1,1],["أجُفونٌ تُجيلُها أمْ كُؤوسٌ","أُتْرِعَتْ للهَوى بغَيْرِ مِزاجِ",3,"ج",1,0],["أَجَفاءً أَشتَكي وَشَقاً","إِنَّ هَذا مُنتَهى المِحَنِ",4,"ن",1,0],["أَجَفَّ الرَّدَى غُصْنَهَا وَالغُصُو","نُ فِي الرَّوْضِ زهرةٌ نَادِيَهْ",5,"د",3,0],["أجفانه السود لا تخطي إذا رشقتْ","سهامها وسهام الليل لا تخطي",6,"ي",1,0],["أَجْفانُ فاتنةٍ أَرَتْنِيها","الحَيَاةُ لشَقْوَتي",7,"ي",1,0],["أَجْفانُ فاتنةٍ تراءَتْ","لي على فَجْرِ الشَّبابْ",7,"ب",1,0],["اجفلن لا يحملن غير","الخوف في الحقائب",8,"ب",1,0],["أَجفَلَ الجِنُّ عَن عَزائِمَ فِرعَو","نَ وَدانَت لِبَأسِها الآناءُ",9,"ا",2,0],["أَجفَلَ الناسُ عَن طَريقِ أَبي المِس","كِ وَذَلَّت لَهُ رِقابُ العِبادِ",10,"د",1,0],["أَجفَرَ غُرمولُهُ فَقَد كَثُرَت","أَشباهُ غِلمانِهِ عَلى وَلَدِه",11,"د",2,0],["أجَفاءً مُرّاً ولم أَجْنِ ذَنْباً","فأُجازَى به بُعاداً وصَدَّا",12,"د",2,0],["أَجَفَوتَني فيمَن جَفاني","وَجَعَلتَ شَأنَكَ غَيرَ شَأني",13,"ن",2,1],["أَجفو فَيَمنَحُني المَوَدَّةَ طالِباً","قُربي وَأَمنَحُهُ الوِدادَ إِذا جَفا",14,"ف",2,0],["أَجفو الدِيارَ فَإِن رَكِبتُ وَضَمَّني","سَرجُ المُطَهَّمِ قُلتُ هَذا مَنزِلي",15,"ل",2,0],["أَجفانُ خوطِ البانَةِ الأُملودِ","مَشغولَةٌ بِكَ عَن وِصالِ هُجودِ",16,"د",1,1],["أَجْفانُ دُرٍّ عَلَى ذُرى قَصَبٍ","تَقْطُرُ مِسْكاً وَما بِها عَرَقُ",17,"ق",1,0],["أجفانه أبكت العيون دما","وأنحل الجسم غنج أحضانه",18,"ن",2,0],["أَجفَلوا في البلادِ من غير حربٍ","وَعَناهم تحصّنٌ واِنزواءُ",19,"ا",2,0],["اجفانها نبلا بقلبي رمت","كأنما قد حملت تركثبا",20,"ب",2,0],["أجفانه ضَمِنت لي صِدق موعِدِه","فكيفَ توفى ضماناً وهي تِنكرُهُ",21,"ه",1,1],["أجفانكنَّ تقرَّحت من دَمعِها","وتجرّحَت منا الضلوعُ أنينا",22,"ن",2,0],["أَجفانُهُ السودُ مِنها البيضُ مُصلَتَةٌ","تِلكَ السُيوفُ لَها الأَجفانُ أَجفانُ",23,"ن",1,0],["أَجفانُهُ المَرضى عَلى ضَعفِها","أَمسى بِها الجَبّارُ مِسكينا",24,"ن",2,0],["أَجفانُكَ السَّكرى مُعَر","بِدَةٌ كَثيراتُ الخُصومِ",25,"م",1,0],["أَجفانُها مَرضى وَما لأَسيرِها","فادٍ وَلا لِقَتيلِها مِن ثائِرِ",26,"ر",1,0],["أَجفانُهُ تُدهِشُ عَن","جِفانِكُم من حَضَرا",27,"ر",2,0],["أَجفانُكَ المَرضى بِها أَمرَضتَني","عِدني وَعُدني مَلَّ مِنّي العُوَّدُ",28,"د",1,0],["أَجفانُهُ مِنها يَسُل","لُ حَدَّ سَيفٍ ما نَبا",29,"ب",2,0],["أَجفانُ عَيني في المَنازِلِ قَد","جادَت فَأَغنَت عَن حَيا السُّحبِ",30,"ب",1,0],["أَجَفاً وما عوَّدتني منك الجَفا","وَعَظيمُ حزني ليس عنك بخافِ",31,"ف",1,0],["أَجفو الرقاد وَقَد نامَ الوَرى جَزَعاً","من أَن يَرى طَيفُهُ في النَوم مَن رَقَدا",32,"د",2,0],["أَجفانُهُ تَصمي القُلو","ب وَنطقهُ يُحيي الرِمَم",33,"م",1,0],["أجفانهُ سكرانةٌ","من خمر مبسمهِ العطير",34,"ر",1,0],["أَجفَلْتُ عن جُلْفُوذَ إِجفالَ امْرِئٍ","بالدََيْنِ يُطْلَبُ ثَمَّ أَوْ بالدِّين",35,"ن",1,0],["أجفانُكُمْ غَصَبَتْ سَوادَ قُلوبِنا","وخُصورُكم عنهُ تعوِّضُنا الضّنا",36,"ن",2,0],["أجفانُها خَلَعَتْ سُقْماً علَيَّ ولا","لَوْمٌ عليها فمِن أثوابِها خَلَعتْ",37,"ت",1,0],["أَجْفَانُ عَيْنَيَّ مَا خِيطتْ عَلى سنةٍ","هذا وقَدْ غَدت الأَهدابُ كَالإِبَر",38,"ر",1,0],["اجفانها بسهامها رشقت لنا","مهجا غدون قتيلة الاجفان",39,"ن",1,0],["أَجفانُهُ أَسقَمُ مِن عُهودِهِ","أُردافُهُ أَثقَلُ مِن صُدودِهِ",40,"ه",1,0],["اجفى وانا العندليب فيك وعار","تصغى لصدى عاذلي وتطرب اذناك",41,"ك",1,0],["أَجُفوناً مَنَحْتَنا أَمْ حُتُوفاً","أَلحاظاً أَبَحْتَنا أم سُيوفا",42,"ف",2,1],["أجفانُ كافورٍ حُبِينَ بأعينٍ","من زعفرانٍ ناعماتِ الملمس",43,"س",1,0],["أجفانها أم جفن سيف الوغى","صيرنا في شُغل شاغل",44,"ل",1,0],["أَجفانُها تَسبي","سراً وَإِعلانا",45,"ن",2,0],["أجفانهن لذي الغرام أضرّ من","بيض السيوف سللن من أجفان",46,"ن",1,0],["أجفانُ عيني لم تَذُق طعم الكَرى","مُذ ثُوِّرَت للظاعنين العيس",47,"س",1,1],["أجفانه ساحرة","يا ويل من قد سحرا",48,"ر",2,0],["أَجفني جودا بِالدُموع عَلى فَتى","حَوى شَرف الدُنيا فَراح إِلى الخُلد",49,"د",1,0],["أَجفني جودا بِالدُموع لواحد","أَنامله تَنهل بِالجود وَالرفَد",49,"د",1,0],["أجفني جودا بالدموع فإنها","مصائب قد وافت على الحر والعبد",49,"د",1,0],["أجفني جودا بالدموع فإنها","حشاشة قلبي فرقتها يد الوجد",49,"د",1,0],["أجفان من أحببته","تحملت عنك المرض",50,"ض",1,0],["أجفانه من سهره تتوجع","صب يموت وعينه تتطلع",51,"ع",1,1],["أَجَفَوهُ واحتجوا بِسُنَّتِهِ","وظهرتَ فاعتلَّتْ بكَ العِلَلُ",52,"ل",1,0],["أجفانه تنفث مكحولة","على محبيه بسحر حلال",53,"ل",1,0],["أجفو الكلام وقد يُغَوّثُ مكتوٍ","ناجٍ ويسكت في اللظى من يخنق",54,"ق",1,0],["أجْفانُهُ شَرَكُ الْقُلوبِ كأنّما","هاروتُ أوْدَعَها فُنونَ فُتونِهِ",55,"ن",2,0],["أَجفاءٌ ذاكَ قُل فِيمَ وَلِم","أَم دلالٌ أَم نفورٌ أَم شَمَمْ",56,"م",1,1],["أَجفانُها مَرضى وَكَم سَفَكت دَماً","وَسَطت عَلى الآسادِ وَهيَ شَداد",57,"د",1,0],["أجفانه ساهرة في الدجى","وناره في القلب ذات اضطرام",58,"م",1,0],["أَجفانُهُمْ نَفَتِ الغِرارَ كما انتفَى","ماضي الغِرارِ بهم منَ الأَجفانِ",59,"ن",1,0],["أَجفانُهُ أَنهار","وَخَدّهُ أُخدود",60,"د",1,0],["أجفان حور العين قد راشت لنا","سهماً قلوب ذوي الصبابة قد دسر",61,"ر",1,0],["أَجفُوكَ منَ الرَّقيبِ خوفاً ويدي","لا تبرحُ من فوقِ حشىً خَفَّاقِ",62,"ق",1,0],["أجفتني فلم ينبت ربيع","وحطتني فلم يثبت يفاع",63,"ع",1,0],["أَجَفَّتْ عيونُ الماء أم نَضَبَت لِكَيْ","تَكُفَّ قلوبُ الحالِمِينَ عن النَّبْض",64,"ض",1,0],["أجفانه السود قلدته","للفتك بيض الظبا البواتر",65,"ر",1,0],["أجفوننا والود متصل","بخلا وما من شانك البخل",66,"ل",1,0],["أَجْفو فَتوصِلُ ثُمَّ أَعْصِي سَادِرًا","فَتَبَرّ بِي وَالبِرُّ مِنْكَ تَلَطُّفُ",67,"ف",1,0],["أَجْفَانُكُمْ غَصَبَتْ سَوَادَ قُلُوْبِنَا","وخصوركمْ عنهُ تعوّضنا الضّنى",68,"ن",2,0],["أجفو نعيمَ المارقين وإنْ سعى","ليْ منهُ صحنٌ بالرحيقِ خضيبُ",69,"ب",1,0],["أجفو نعيمَ المارقينَ وإنْ سعى","لي منهُ صحنٌ بالقطافِ خضيبُ",70,"ب",1,0],["أَجِفُّ وأَندَى حِينَ يَهمِي رَحِيقُهَا","وَأحسُو رَحِيقَ الفَنِّ مِن كَأسِ ذِكرَاهَا",71,"ا",3,0],["أجَفاءً ؟ يضيقُ للهَجْرِ صدري","وأنا البّرُّ ليسَ مني جَفاءُ",72,"ا",2,0],["أَجَفوَةٌ وَرُعاةٌ غَرَّهُم طَمَعٌ","كأَنَّهُم عَن نِداءِ الحَقِّ في صَمَمِ",73,"م",1,0]]}