لغرام أسيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=172162",""],[5843,"رأفت الهجان","https://www.poetsgate.com/ViewPoem.aspx?id=51300",""],[5943,"إنصافٌ وإبخاسٌ","https://www.poetsgate.com/ViewPoem.aspx?id=52312",""],[5953,"يا دولة الحق كم تري تقف","https://www.poetsgate.com/ViewPoem.aspx?id=93850",""],[5972,"متى مضر الحمراء تطلب ثارها","https://www.poetsgate.com/ViewPoem.aspx?id=170786",""],[4442,"أهوت به علته فانتدب","https://www.poetsgate.com/ViewPoem.aspx?id=171003",""],[6167,"جمهورية الخلفاء الراشدين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85473&r=&rc=2",""]],"verses":[["يَقومُ اِهتِزازَ الرُمحِ خَبَّت كُعوبُهُ","وَيَقعُدُ إِقعاءَ اِبنِ عَيلٍ تَسَمُّعا",0,"ع",2,0],["يَقومُ بآفاقِ البِلادِ خَطيبُها","يُتَرْجِمُ عنْ حُبّي ويُخْبِرُ عنْ وُدّي",1,"د",2,0],["يَقومُ عَلى الوَغمِ في قَومِهِ","فَيَعفو إِذا شاءَ أَو يَنتَقِم",2,"م",1,0],["يُقَوِّمُها حَتّى تَقومَ مُتونُها","فَيَقصُرُ عَنها كُلُّ ما يُتَمَثَّلُ",3,"ل",1,0],["يَقومُ في مَشروعِهِ نافِذاً","كَأَنَّهُ عَنتَرَةُ العَبسي",4,"س",2,0],["يَقومُ وَرائي ناشِدٌ لي بِغَدرَةٍ","طَوالَ اللَيالي أَو تَزولُ يَلَملَمُ",5,"م",1,0],["يَقومُ القُعودُ إِذا أَقبَلوا","وَتَقعُدُ هَيبَتُهُم بِالقِيامِ",6,"م",1,0],["يَقومُ بِهِ لِلهاشِمِيّاتِ مَأتَمٌ","لَهُ ضَجَّةٌ يَبكي بِها كُلُّ ضاحِكِ",7,"ك",1,0],["يُقَوِّمُ أولاهُم إِذا اِعوَجَّ سِربُهُم","مَواكِبُ وَاِبنُ المُنذِرينَ الحُلاحِلُ",8,"ل",1,0],["يقوم مقام النيل في مصر فضلهُ","إذا جرَّت الأقلامَ تلك الأصابع",9,"ع",1,0],["يقوم بنصري في الصبابة عون من","أقام ابن أيوبٍ عماداً لدينه",10,"ن",2,0],["يقومُ لها المالُ المؤثَّل والعِدَى","إذا قام للنار الحصادُ المحزَّمُ",11,"م",1,0],["يَقومُ مَقامَ البارِدِ العَذبِ في الظَما","وَيُغني عَنِ الأَزوادِ في البَلَدِ القَفرِ",12,"ر",1,0],["يقوم به عن الأبو","ين جبريل ويخدمه",13,"م",2,0],["يقوم عنكم بها جيش ملائكة","موكل بتخوم الدين يحميها",14,"ي",3,0],["يَقومُ بِالعَهدِ عَن أَوفى الجُدودِ بِهِ","عَن والِدٍ أَبلَجِ الذِمّاتِ عاليها",15,"ي",3,0],["يَقومُ مَقامَ الجَيشِ تَقطيبُ وَجهِهِ","وَيَستَغرِقُ الأَلفاظَ مِن لَفظِهِ حَرفُ",16,"ف",1,0],["يُقَوِّمُ تَقويمُ السَماطَينِ مَشيَهُ","إِلَيكَ إِذا ما عَوَّجَتهُ الأَفاكِلُ",17,"ل",1,0],["يَقومُ لَها السِماطُ وَقَد أَضاءَت","عَلى لَبّاتِها أَبَداً سُموطُ",18,"ط",1,0],["يَقومونَ مِن بُعدٍ إِذا بَصُروا بِهِ","لِأَبلَجَ مَوفورِ الجَلالَةِ أَروَعِ",19,"ع",1,0],["يُقَوِّمُ مِن تَثَنّيها اِعتِدالٌ","يَكادُ يُقالُ مِن هَيَفٍ نُحولُ",20,"ل",1,0],["يَقُومُ بها يَوْمَ الحِسابِ مُدَافِعاً","يَرُدُّ بها ذَمَّامَهُ وَيُجَادِلُهْ..",21,"ل",2,0],["يَقومُ فَيَمشي بَينَنا مُتَنَكِّراً","فَلا سِرُّنا يَفشو وَلا هُوَ يَظهَرُ",22,"ر",1,0],["يَقومُ بِكَ القَلبُ الأَبِيُّ وَتارَةً","يَغوصُ بِكَ الفَهمُ الذَكِيُّ فَتُطرِقُ",23,"ق",1,0],["يَقومُ عليه حامٍ لا يَنامُ","أعانكم الأُلى نَبَذُوا الوفاءَ",24,"ا",2,0],["يَقومونَ في الأَقوامِ يَحكونَ فِعلَنا","سَفاهَةَ أَحلامٍ وَسُخرِيَّةً بِنا",25,"ن",2,0],["يقومُ بأوقاتِ الظهيرة مائلاً","يقلب في أسطر لابه عينَ أحوَل",26,"ل",1,0],["يَقومُ بِأَفعالِ الكِرامِ وَعِندَهُ","شِفاءٌ مِنَ الداءِ المَحَبَّةِ وَالفَقرِ",27,"ر",1,0],["يَقومُ بِهِ القَليلُ إِلى المَخازي","وَيَخزِلُهُ عَنِ المَجدِ القُعودُ",28,"د",1,0],["يَقومُ بِأَفعالِ النَبِيِّ وَقَولِهِ","كَوَحي اِبنِ بَيضٍ في صَفاءِ صِفاتِ",29,"ت",1,0],["يَقومُ بِالقَومِ يَومَ جِئتَهُمُ","وَلا يَخيبُ الرُوّادُ في سَبَبِه",30,"ب",2,0],["يَقومُ الفَتى مِن قَبرِهِ إِن دَعَوتَهُ","وَما جَرَّ مَخطوطٌ لَهُ في الرَواجِبِ",31,"ب",1,0],["يَقومُ عَلَيهِ النوحُ لَيلاً وَلَو غَدا","سَليماً لَأَجرى شَأوَ غَيٍّ وَبَكَّرا",32,"ر",2,0],["يقومُ بها مِثْلُ الرُّدَيْنِيّ ما سَعى","بشِكّتِهِ مِثْلي الضّعيفُ ولا الآلي",33,"ل",2,0],["يقُومُ لَدَيْكَ النَّاسُ فِي خَيْرِ مَحْفِلٍ","ويَسْتقَبِلُ الإِجْلاَلَ رَكْبَكَ وَالبِشْرُ",34,"ر",1,0],["يقومُ في الأرضِ مقام الخالق","ويغدقُ الرزقَ على الخلائقِ",35,"ق",1,0],["يقوم فيعروه التياع مبرح","فينكص وهناً فهو يقظان نائم",36,"م",1,0],["يقوم بنظمهم اسد همام","تورث غابة الاسد الهمام",37,"م",1,0],["يقوم تلون الحرباء فيهم","كما في العيس تندلس النعام",38,"م",1,0],["يقوم مسهدا من رام مجدا","ويعطي المهر من يبغى الوصالا",39,"ل",2,0],["يقوم كريم العرق في موقف الوفا","كريما ولم يعبأ بلي الازمة",40,"ه",1,0],["يقوم مقام المَجْرِ في الحرب شدةً","ويرجعُ عنه خصمه وهْو ضَارعُ",41,"ع",1,0],["يقوم عمَّ وفيمَ القلب مختبل","والعقل معتقل والدمع مسفوحد",42,"ح",2,0],["يقوم بجيشه التّقوى","ويقدم جيشه الرعب",43,"ب",1,0],["يَقومُ مَقامَ الحَمدِ يَطلُبُ مَوعِدا","قَضى اللَهُ في الدارَينِ أَن كانَ سَيِّدا",44,"د",2,0],["يقوم على قوائمه ويثني","فيبرك لا انحناء ولا انيراخ",45,"خ",1,0],["يُقَوَّمُ الشارِخُ مِن زَيغانِهِ","فَيَستَوي ما اِنعاجَ مِنهُ وَاِنحَنى",46,"ا",1,0],["يَقومُ بِهِ حَيّاً نِزارٍ وَيَعرُبٍ","شُهودٌ وَفي الدَعوى يَمينٌ وَشاهِدُ",47,"د",1,0],["يقوم فيبدي نصحه عند نفسه","وينهى بخير وهو بالزور يشهد",48,"د",1,0],["يُقَوِّمُنا واضِحٌ وَجهُهُ","كَريمُ المَضارِبِ وَالمَنصِبِ",49,"ب",1,0],["يَقومُ بِناءٌ كَعُشِّ النُسور","بِناءٌ يَرى العابِرونَ عَلَيه",50,"ه",1,0],["يقوم بها بين الحطيم وزمزم","زعيم إلى بيت النبوة ينسب",51,"ب",1,0],["يَقومُ إِذا أَوفي عَلى رَأسِ هَضبَةٍ","قِيامَ الفَنيقِ الجافِرِ المُتَشَمِّسِ",52,"س",1,0],["يقوم بأمر مقعدٍ همم الوري","ويجلس عزاً والأنام وقوف",53,"ف",1,0],["يُقَوِّمُ مُعوَجَّ الأُمورِ بِرَأيِهِ","وَما كانَ لَولا رايُهُ بِالمُقَوَّمِ",54,"م",1,0],["يَقومُ في حَومة الهَيجاءِ مُنفرداً","يَومَ الكِفاح مَقام العَسكر اللَجِبِ",55,"ب",1,0],["يَقومُ لَهُ دَمعي بِإِثباتِ ما جَرى","وَيَأخُذُ لي حَقّي وَيُنصِفَني مِنكِ",56,"ك",1,0],["يَقومُ مَعَ الرُمحِ الرُدَينِيِّ قائِماً","وَيَقصُرُ عَنهُ طولُ كُلِّ نِجادِ",57,"د",1,1],["يَقومُ فَيَتلو كلَّ يَومٍ صَحائِفاً","فَهَل كانَ مَحظوراً عَلَيهِ استِماعُها",58,"ع",3,0],["يقوم غريقُ الماء حيّاً على الرجا","ولكن غريق الإثم ميتاً على الجمر",59,"ر",1,0],["يقوم لله يطلب أجره الكامل","يبغي بذلك وجه الواحد المنان",60,"ن",1,0],["يقوم على ساق لتأويل لفظها","وصرف معانيها إلى ما يشايع",61,"ع",1,0],["يقوم مقامي في الذي أنا طالب","مَنْ اللّه ربي خالقي واسِعِ الْبر",62,"ر",1,0],["يقوِّمُها الحادونَ وَهْيَ تَميلُ","تَجانَفْنَ عَنْ وَعْثِ الطّريقِ وسَهْلِهِ",63,"ه",1,0],["يقوم إذ يراه كل جالِسِ","مُبجّلٌ ناهيكَ من مبجّلِ",64,"ل",1,0],["يقومون إرثا في مقام أَبيهمو","فلا سوحهم خال ولا ربعهم قفر",65,"ر",1,0],["يقوم له الوغى فيها بساق","على أعدائه ذات انتقام",66,"م",1,0],["يقوم بها بين السِّماطين خاطبٌ","صدوقٌ وبعضُ المادحينَ يمينُ",67,"ن",1,0],["يقوم الخطابُ الفصلُ والجوُّ ساكنٌ","لديها مقامَ النصلِ والنقعُ ساطعُ",68,"ع",1,0],["يقوم مقام الغيث صوبُ يمينِه","ويُغنيه طبعُ الحلم أنْ يتحلَّما",69,"م",2,0],["يقوم إلى الأحداث والدهر قاعدٌ","ويجلس في حيث الملوكُ قيامُ",70,"م",1,0],["يقوم خطيبُ الدمع في موقف النَّوى","فيفصح عن سجع الحمام الأعاجمِ",71,"م",1,0],["يقوم من بالبخار فتيق روح","له من مغلق الأمر انفتاح",72,"ح",1,0],["يَقومُ لهُ مَجْلى الجَلالِ مُهَيْمِناً","جَمالاً عليهِ من شَمائِلِهِ زِيُّ",73,"ي",1,0],["يقومُ واللَّيلُ مُرْخاةٌ كَلاكِلُهُ","يبكي انْدِهاشاً وقلبُ الخِبِّ فَرْحَانُ",74,"ن",1,0],["يقومُ لنا من هذه الدَّارِ رَوْنَقٌ","له من شُؤُنِ اللهِ في الكَوْن طِلْسَمُ",75,"م",1,0],["يَقومُ على المَحَجَّةِ أحْمَدِيًّا","إذا عَجِزَ الرِّجالُ عن الوُقوفِ",76,"ف",1,0],["يقومُ بالوجدِ والأَشواقُ تلفَحُهُ","ضمن الجَوانِحِ طيَّ اللَّيلِ باللَّهَبِ",77,"ب",1,0],["يقومُ على بُسطِ الخَفا مثل حاضِرٍ","رَفيعُ التَّدلِّي وهو أَبعَدُ غائِبِ",78,"ب",1,0],["يقوم بالعذر عني في محبتهم","عذر يقدسه التشبيب والغزل",79,"ل",1,0],["يَقُومُ بالمقْصُودِ مِنْ","بَيانِ مالَمْ يَبِنِ",80,"ن",1,0],["يَقُومُونَ في نَصْرِ الْقَوِيِّ فكُلُّهُمْ","لَهُ وَعَلَى ذِي الضَّعْفِ نارٌ تُسَعَّرُ",81,"ر",1,0],["يَقُومُن بأَهْوالٍ ثِقالٍ طَويلَةٍ","وتَحْريرِ أبْحاثٍ تَجِلُّ عَنْ الحَصْرِ",82,"ر",1,0],["يَقومُ إلى الْمِحْرابِ والنَّاسُ نُوَّمٌ","لِيَركَعَ للخَلاّقِ طَوْراً ويَسْجُدا",83,"د",2,0],["يَقُومُ لَهُ بالعُذْرِ في كُلِّ مَحْفِلٍ","بِكُلِّ بلادٍ في الأَنامِ مُنادِي",84,"د",2,0],["يَقومُ بِباغي الدينِ يَحيى وَجَعفَرٌ","إِذا لُحِيَ الإِسلامُ وَاِضطَرَبَ الحَبلُ",85,"ل",1,0],["يقومُ بالأمر بادي الرأيِ مُقتدراً","تهابُ زأرتَهُ الآسادُ في الأجَمِ",86,"م",1,0],["يقومُ بالأمرِ بينَ النَّاسِ مُنفرِداً","والغيرُ قد كَلَّ عنهُ غيرَ مُنفرِدِ",87,"د",1,0],["يقومُ من الصَلاةِ إلى المَثاني","ومن سُنَنِ الكِتابِ إلى الفُروض",88,"ض",1,0],["يقوّمها جورُ سُكّانِها","إذا هي عن قَصْدِها تَعدِلُ",89,"ل",1,0],["يق