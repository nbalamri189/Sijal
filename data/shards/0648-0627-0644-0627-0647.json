{"poems":[[87,"اجعل رثاءك للرجال جزاء","https://www.aldiwan.net/poem62936.html","الكامل"],[87,"ضج الحجاز وضج البيت والحرم","https://www.aldiwan.net/poem63747.html","البسيط"],[136,"ألما بي على الربع القديم","https://www.aldiwan.net/poem54742.html","الوافر"],[240,"أترى تعود لنا كما","https://www.aldiwan.net/poem31737.html","مجزوء الكامل"],[276,"أعد الوداع فما أراك تراني","https://www.aldiwan.net/poem52062.html","الكامل"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[309,"يا نفس هذا الذي تأتينه عجب","https://www.aldiwan.net/poem16775.html","البسيط"],[376,"أين مكان السلو من عذلي","https://www.aldiwan.net/poem57231.html","المنسرح"],[463,"دواعي الهوى لك أن لا تجيبا","https://www.aldiwan.net/poem56305.html","المتقارب"],[484,"يهتز صوتهما الرنين","https://www.aldiwan.net/poem37615.html","مجزوء الكامل"],[510,"جدِّدْ","https://www.aldiwan.net/poem61090.html","مجزوء الرجز"],[543,"قدك يا جميل","https://www.aldiwan.net/poem47914.html","عموديه"],[556,"رأيتك لا ترعى حقوقي ولم تصخ","https://www.aldiwan.net/poem47898.html","الطويل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[752,"","https://poetry.dctabudhabi.ae/diwan/poem/142279","البسيط"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54175","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48632","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63884","الهزج"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72340","الكامل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133806","المتقارب"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109271","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89154","الوافر"],[4728,"راوية","https://www.poetsgate.com/ViewPoem.aspx?id=176881",""],[4767,"شمس الإمامة","https://www.poetsgate.com/ViewPoem.aspx?id=180572",""],[4830,"ذكريات الدّيار","https://www.poetsgate.com/ViewPoem.aspx?id=195076",""],[4858,"آسادٌ في الأسر","https://www.poetsgate.com/ViewPoem.aspx?id=137593",""],[4858,"يا غافلينَ عن الأسير وأهله","https://www.poetsgate.com/ViewPoem.aspx?id=138315",""],[4862,"سماحة اللقاء","https://www.poetsgate.com/ViewPoem.aspx?id=55376",""],[4955,"إذا أتى لحصاد الروح من جسدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=188784",""],[4984,"أ تريد أن تحكي الحكاية","https://www.poetsgate.com/ViewPoem.aspx?id=215861",""],[5121,"يَا عِيدُ مَرحَى","https://www.poetsgate.com/ViewPoem.aspx?id=33497",""],[5136,"مثلي من عيشه يطيب","https://www.poetsgate.com/ViewPoem.aspx?id=121519",""],[5285,"سميرة","https://www.poetsgate.com/ViewPoem.aspx?id=203519",""],[5376,"يا زائرَ البيتِ لو حُمِّلت من مُقلِ","https://www.poetsgate.com/ViewPoem.aspx?id=188424",""],[5431,"كم مسنا الضر ياحنان انت لها","https://www.poetsgate.com/ViewPoem.aspx?id=189875",""],[5431,"ماكان أعجلها لتتركه!في برزخٍ والحلم يبطئه","https://www.poetsgate.com/ViewPoem.aspx?id=201659",""],[5458,"ألا بذكر الله تطمئن القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=72385",""],[5561,"اليوم المشهود","https://www.poetsgate.com/ViewPoem.aspx?id=196817",""],[5561,"خذني إليك ...","https://www.poetsgate.com/ViewPoem.aspx?id=206453",""],[5573,"الياس جمره تشتعل داخل الجوف","https://www.poetsgate.com/ViewPoem.aspx?id=200075",""],[5596,"تحت قدمي والدتي","https://www.poetsgate.com/ViewPoem.aspx?id=206782",""],[5704,"القدس لنا","https://www.poetsgate.com/ViewPoem.aspx?id=194471",""],[5906,"آمال نافقة","https://www.poetsgate.com/ViewPoem.aspx?id=188823",""],[5953,"عاذلتي في الشيب لو تعلم ما","https://www.poetsgate.com/ViewPoem.aspx?id=93807",""],[5977,"سنابل المدينة","https://www.poetsgate.com/ViewPoem.aspx?id=213793",""],[6096,"من دون وداع","https://www.poetsgate.com/ViewPoem.aspx?id=177528",""],[6102,"صَنَم !!","https://www.poetsgate.com/ViewPoem.aspx?id=184433",""],[6102,"يا أنا","https://www.poetsgate.com/ViewPoem.aspx?id=185331",""]],"verses":[["وَالأَهلُ لا أَهلاً بِحَبلِ وَلائِهِم","حَتّى تَراهُم بَينَهُم رُحَماءُ",0,"ا",2,0],["والاهُمُ أُمَراءُ السوءِ وَاِتَّفَقوا","مَعَ العُداةِ عَلَيها فَالعُداةُ هُمُ",1,"م",1,0],["وِإلاَّ هَامِداً مُتَلَبِّداً في","جَوَانِبِهِ كَجُونِ قَطاً جُثُومِ",2,"م",1,0],["والاهُما مِن خَمرِ عَي","نَيهِ وَخَمرَةِ رَأسِ عَينِ",3,"ن",1,0],["والاهدليون الكِرام فروعها","وَثمار ذاكَ المنصب الصنوان",4,"ن",1,0],["والأَهلُ والأقاربُ","أَدنَتهُمُ التَجارِبُ",5,"ب",1,0],["والأهل والمال والمركوب تركبه","والثوب تلبسه فالكل ينقلب",6,"ب",1,0],["والأَهيَفُ الأَغيَدُ الأَغَنُّ عَلى","حالَتِهِ في الصُّدودِ لَم يَحلِ",7,"ل",1,0],["وإلا هلمّوا أُباهيكُمُ","فمن قامَ والفَخْرَ قام المصيبا",8,"ب",2,0],["والأهليون لمثله","خول فيا للأهليين",9,"ن",1,0],["والأهلُ في تصيُّدْ","والجارُ في ترصُّدْ",10,"د",1,0],["والأَهلُ طُراًّ وَدَّعُوا","ومَعشَرُ الإخوَانِ",11,"ن",1,0],["وإلّا هشيمٌ في فضاءٍ تكدُّهُ","محكّمَةٌ فيه الرّياحُ البوارحُ",12,"ح",1,0],["والأهم وكل أوليائهم","يعلم ما علم من أسمائهم",13,"م",1,0],["و(الآه) فوق شغاف الليل أجنحةٌ","أنا المعنَّى بها وجْداً وشاديها",14,"ي",3,0],["والأهلُ من أجله في حالة عظمتْ","يقضي التعجبَ منها من له بصرُ",15,"ر",1,0],["والأهل حول فراشها","والكل باكي العين نادبْ",16,"ب",1,0],["وإلاَّ ها أَنا الساع","ةَ في آخرِ أنفاسي",17,"س",2,0],["والأهل قد ساروا إليه ورأينا","طلب افتكاك فؤاده المرهون",18,"ن",1,0],["وإلا هديرُ البحار العماق","يجيشُ به صدرُها المغضِب",19,"ب",1,0],["والأهل أيضا وهلمَّ جرا","حتى لينسى الكائنات طرَّا",20,"ر",2,0],["وإلا هل جهنم فيك صدرٌ","لأهلِك في منازلها زفير",21,"ر",1,0],["وإلا هلالٍ على بدر الجبين إلتوى","وأغاض نجمات في ليل الشعر ضاوية",22,"و",3,0],["والاهُ في الدنيا وفي الأخرى معاً","قد كان حاملَ ما أتاه وشارِعَه",23,"ع",2,0],["والأهلُ في ألفةٍ والصحبُ في سمرٍ","والطيرُ من فرحٍ يشدو بوادينا",24,"ن",2,0],["والآهِ بعد الآهِ في أحشائنا","نُذُرُ الفناء فهل لنا مَن يغضبُ؟",25,"ب",1,0],["والأهلُ والصّحبُ الكرامُ تجلببوا","بكآبةٍ سوداءَ لا تتبدّدُ",26,"د",1,0],["والآهُ في الليلِ البهيم لها صدىً","عما أعاني صار ثَمَّ مترجما",27,"م",2,0],["والأهلُ قد فُجِعوا... للطبِّ قد هرعوا","فهل يَرُدُّ لنا الأنفاسَ راقينا؟!",28,"ن",2,0],["والأهل والناس الذين تبددوا","وحوادث بادت فليس لها اقتفاء",29,"ا",2,0],["وَالأَهْلُ رَحْبٌ شَمْلُهُمْ","فِي فَرْحَةِ الْعِيِدِ الْمُغَنَّى",30,"ن",2,0],["والأهل طراً أفض عليهم","فضلك والزوج والنسيب",31,"ب",1,0],["والآهُ ماجتْ بالقلوبِ وكلَّما","ذُكرتْ سميرةُ يصْطَلي شادينا",32,"ن",2,0],["والآهُ في قلبِنا مخْنوقَةٌ طُمِرَتْ","كالنارِ بركانِها في باطنِ الجَبَلِ",33,"ل",1,0],["والأهل مثقلة أيامهم سقما","أوجاعهم عظُمتْ والحزن زلزالُ",34,"ل",1,0],["والآهة السكرى إذا صدحت","برقا مع التهطال تذرؤه",35,"ا",2,0],["والآه انفثها لتخبو حرقتي","فتشبُّ ناراً تشبه الإعصارا",36,"ر",2,0],["والأهلُ كُلٌّ مع الحسبانِ مُنهمكٌ","كلٌّ مُدانٌ وما بالنفسِ أسرارُ",37,"ر",1,0],["وإلاهُهمْ مالٌ وضيعٌ قدرُهُ","هم عابدوهُ فهم على خُسرانِ",38,"ن",1,0],["والآه لو تُحسر لقت بالرجا أووف","لو نلت مطلوبي هناواطعم الزاد",39,"د",1,0],["والأهل كالمأخوذ من هول الذي","قرع المسامع بالأشد الاصدع",40,"ع",1,0],["والآه أطلقها غما كذا ألمًا","والجرح من زمن والله ما التأما",41,"م",2,0],["والأَهازيجُ اعتَلَتْها أَحرُفٌ","مِن بَقايَا القَولِ أو أَدنى الجُمَلْ",42,"ل",1,0],["والأهل والآمال والنفس التي","منها النفوس الزاكيات والحسب",43,"ب",1,0],["والأهل في شوقٍ إلى لقياكُمُ","ما أجمل الإنجاز بعد عطاء",44,"ا",2,0],["والآهُ تحضنني تمضي إلى أسفٍ","تروي ضنى مُهْجَتي والدمعُ ساقيها",45,"ي",3,0],["وَالآهُ - يا وَيلاهُ - فَوقَ فَمِي","مَصلُومَةٌ تَشتاقُ مَن صَلَما !",46,"م",2,0],["وَ الآهُ أَنَّةُ أَضلُعٍ","عَبَرَتْ بِزَفرَتِها الحُدُودْ",47,"د",1,0]]}