{"poems":[[55,"أما كنت مع الحي","https://www.aldiwan.net/poem29741.html","الهزج"],[47,"ترى زعيم الجبال منقينا","https://www.aldiwan.net/poem62646.html","المنسرح"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85385","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16684","الطويل"],[173,"أرتها المآقي ما تكن الجوانح","https://www.aldiwan.net/poem1611.html",""],[190,"ومرماري الطبيب له غلام","https://www.aldiwan.net/poem43597.html","الوافر"],[333,"على دارك يا جاري","https://www.aldiwan.net/poem54945.html","الهزج"],[412,"أبا الفضل طال الليل أم خانني صبري","https://www.aldiwan.net/poem50177.html","الطويل"],[443,"ترى زائري طيف الخيال الذي سرى","https://www.aldiwan.net/poem2571.html","الطويل"],[463,"وخرقاء معرقة في الضلال","https://www.aldiwan.net/poem56224.html","المتقارب"],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107275","الطويل"],[1571,"","https://poetry.dctabudhabi.ae/diwan/poem/97724","المتقارب"],[2290,"","https://poetry.dctabudhabi.ae/diwan/poem/98016","المتقارب"],[2391,"","https://poetry.dctabudhabi.ae/diwan/poem/18047","الطويل"],[2973,"","https://poetry.dctabudhabi.ae/diwan/poem/107028","السريع"],[4469,"","https://poetry.dctabudhabi.ae/diwan/poem/103131","المجتث"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141635","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120518","البسيط"],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""]],"verses":[["تَرَي زَمجَرَةَ الآسا","دِ هَمساً بَينَ غابَينا",0,"ن",2,0],["تُرى زَعيمَ الجِبالِ مُنقِيَنا","إِنقاءَ غُسلٍ مِن نَجوِ ناجِيَتِه",1,"ت",2,1],["تَرى زهرة قد أعجب العين لونها","وفاح لها في الروض عَرفٌ معطر",2,"ر",1,0],["تَرَيْ زَرَدَ الفَقْعاءِ حاطَ قَتِيرَهُ","جَنى الكَحْصِ مَسْقِيّاً بعَلٍّ وإنهال",3,"ل",1,0],["تُرى زُمَرُ الأَملاكِ وَسطَ بُيوتِهِم","تُحيّيهمُ حيناً وَحيناً تُصافِحُ",4,"ح",1,0],["ترى زنّاره في الخصر يهوي","إلى الساقين ليس له رديف",5,"ف",1,0],["ترى زوجك في النعمة","لا تبرح دنياها",6,"ه",2,0],["تَرى زرد الماذيِّ مِنهُ مفكَّكاً","يَطيح كَما طاحَ القُلامُ عَن الظفرِ",7,"ر",1,0],["ترُى زائري طيف الخيال الذي سرى","وكيف يزور الطيف من منع الكرى",8,"ر",2,1],["ترى زوجَها أبداً فوقها","ومن غيرهِ جاء أولادُها",9,"د",3,0],["تَرَى زُمَرَ الأَحبابِ في ظِلِّ ليلِهِ","وُقوفاً عَلى أَقدامِ ذُلٍّ بِهِ تَاهُوا",10,"ا",1,0],["ترى زوجة مغبرةً","وتمسي لصحبته قاليه",11,"ه",1,0],["ترى زَوجةُ الشيخِ مَغمومةً","وَتمسي لصحبتهِ قالِيَه",12,"ل",3,0],["تَرى زَهَرَ الحَوذانِ حَولَ رِياضِهِ","يُضيءُ كَلَونِ الأَتحَمِيِّ المُوَرَّسِ",13,"س",1,0],["ترى زهيراً قد نمته العلى","للقين لما سله مخذما",14,"م",2,0],["ترى زمرذ أرضٍ","منه اليواقيت تنتج",15,"ج",1,0],["ترى زوجي الرجال فتتّقيهم","وليس الأمر عن حبّ الصلاح",16,"ح",1,1],["ترى زمانك عبدا عند سدته","يوليك ما صد عنه وهو مسرور",17,"ر",1,0],["ترى زمر السفار فيه قوافلا","حيارى حسارى من مشاة وركبان",18,"ن",1,0]]}