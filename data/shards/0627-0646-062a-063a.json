قب تعلاّ","https://www.poetsgate.com/ViewPoem.aspx?id=180433",""],[4767,"خروج الحسين","https://www.poetsgate.com/ViewPoem.aspx?id=199425",""],[5000,"كلُّ عام","https://www.poetsgate.com/ViewPoem.aspx?id=5540",""],[5106,"زَاْكِيَاْتٍ كَفَرْحَةِ الأَنْبِيَ","https://www.poetsgate.com/ViewPoem.aspx?id=156840",""],[5198,"نظرة الطرف اللعوبة","https://www.poetsgate.com/ViewPoem.aspx?id=136096",""],[5302,"شعري","https://www.poetsgate.com/ViewPoem.aspx?id=201746",""],[5425,"نَورَسَةُ الهَور","https://www.poetsgate.com/ViewPoem.aspx?id=198930",""],[5614,"احلام المنام","https://www.poetsgate.com/ViewPoem.aspx?id=1368",""],[5616,"تأبين الفقيد فاروق","https://www.poetsgate.com/ViewPoem.aspx?id=203499",""],[5616,"الحجاب","https://www.poetsgate.com/ViewPoem.aspx?id=204841",""],[5629,"المذمة","https://www.poetsgate.com/ViewPoem.aspx?id=184510",""],[5756,"رثاء الشيخ زايد","https://www.poetsgate.com/ViewPoem.aspx?id=8433",""],[5848,"مع المحبه لتركي رويع","https://www.poetsgate.com/ViewPoem.aspx?id=48979",""],[5864,"الشام","https://www.poetsgate.com/ViewPoem.aspx?id=190337",""],[5956,"ساعِدِي الموجَ يا رفاهي","https://www.poetsgate.com/ViewPoem.aspx?id=182092",""],[6124,"يوسف","https://www.poetsgate.com/ViewPoem.aspx?id=120701",""],[6225,"سميرُ الصمت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80929&r=&rc=198",""],[5567,"حلول","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69071&r=&rc=9",""]],"verses":[["إِن تُغدِفي دوني القِناعَ فَإِنَّني","طَبٌّ بِأَخذِ الفارِسِ المُستَلئِمِ",0,"م",1,0],["إِن تُغفِلوا دارِسَ آثارِهِ","عَفّى عَلَيها الدَهرُ بِالطَمسِ",1,"س",1,0],["إِن تَغَنّى البُلبُلُ اِهتا","جَ غِناءَ الوَرَشانِ",2,"ن",1,0],["إِن تَغَيَّرتَ فَما غُي","يِرَ مِنّا لَكَ عَهدُ",3,"د",1,0],["إِن تَغدِروا فَالغَدرُ مِنكُم شيمَةٌ","وَالغَدرُ يَنبُتُ في أُصولِ السَخبَرِ",4,"ر",1,0],["إن تغب عني وإن تق","دم فلي بالهجر قرحه",5,"ح",2,0],["أنت غيثي ونباتي للثنا","حقه أن يتلقاك بزهر",6,"ر",1,0],["إن تغش أبواب مغناه التي فتحت","فطالما بالعطايا والندى قفلت",7,"ت",1,0],["أنت غرابٌ خيرُ أحواله","ما لَزم الصمتَ ولم يَنْعَبِ",8,"ب",1,0],["أنت غيثٌ يقيظُ فينا حياهُ","إذ حيا الغيثِ لا يكاد يقيظ",9,"ظ",1,0],["إِن تَغِب في فَراشَةٍ أَلواني","فَأَنا في زَهرَةٌ تَطيرُ",10,"ر",1,0],["إِن تَغِب فَالصُبحُ عِندِيَ كَالدُجى","وَالدُجى إِن جِئتَ بِالصُبحِ اِزدَرى",11,"ر",2,0],["إِن تَغفَلِ الدُنيا وَيَغفَل أَهلُها","عَنكُم فَخالِقُ أَهلِها لا يَغفَلُ",12,"ل",1,0],["إِن تَغلُ في اللَومِ أُغرِق في اللَجاجِ وَإِن","تُكثِر مِنَ العَذلِ أُكثِر مِن جَوى الكَمَدِ",13,"د",1,0],["أَنتَ غَيثُ الغُيوثِ يَحيا بِهِ القَو","مُ إِذا أَمحَلوا وَبَحرُ البُحورِ",14,"ر",1,0],["إِن تَغَطّى عَنكَ الأَصادِقُ تُبدي","شِدَّةُ الدَهرِ عَنهُمُ وَلِيانُه",15,"ن",2,0],["أنتَ غَيْثٌ لموالي","كَ ولَيثٌ لمُثيرِكْ",16,"ك",1,0],["إِن تَغِب عَن لِحاظِ عَيني فَلِلقَل","بِ لِحاظٌ سَريعَةُ الإِدراكِ",17,"ك",1,0],["إن تغنيني فإني","طائر في كل غصن",18,"ن",1,0],["إن تغضبوا لبني النضيرِ فإنّه","خَطبٌ يراه بنو أبيكَ عظيما",19,"م",2,0],["إن تغنت جاوبنها برنينٍ","يدعُ للفتك أنفُسَ الصُّوَّام",20,"م",1,0],["أَنتَ غَزالٌ غَنِجٌ","بِهِ يَتيهُ الغَنَجُ",21,"ج",1,0],["أَنتَ غَرامي وَإِن أَبَيتَ هَوىً","وَأَنتَ سُؤلي وَمُنتَهى شَجَني",22,"ن",2,0],["أَنتَ غصن مزهر","وَستحوى ثمرا",23,"ر",2,0],["أنت غافٍ بين نومين، أنا","بين نابيَ حيَّةٍ وحشٌ رقادي",24,"د",2,0],["إنْ تَغَيَّرْتَ فَمَا غُيّ","رَ مِنّا لَكَ عَهْدُ",25,"د",1,0],["إِن تَغَزَلت أَو مَدَحت فَإِني","لَستُ بِالشاعر المُطيل كَلامي",26,"م",2,1],["انت غصن شأنك المي","ل كما ملت الا اعطف",27,"ف",1,0],["انت غوث الوجود مفتاح كنز ال","جود والخير سح من ميزابك",28,"ك",1,0],["أَنتَ غَيثٌ إِذا اِعتَرى الأَرضَ مَحلٌ","وَدَواءٌ إِذا اِشتَكى الدينُ داءَ",29,"ا",2,0],["إن تغيبوا عن العيون فأنتم","في قلوب حضوركم مستمر",30,"ر",1,1],["إن تغرسِ الرأيَ فالتسديدُ زهرتُهُ","وإن هززتَ القنا أَجْنَيْنَكَ الظفرا",31,"ر",2,0],["أنتَ غرستَ الحبَّ في اضلعي","فكيفَ لا أسقيهِ من أدمعي",32,"ع",2,1],["أنتَ غَزالٌ وأنت غُصنٌ","وأنتَ ليلٌ وأنت بَدرُ",33,"ر",1,0],["إن تغب عني فهذى صورتك","تؤنس الروح وهذي طلعتك",34,"ك",1,0],["إن تغسلوا دونَ القلوبِ تُطَهِّروا","وطناً عليهِ من العلوجِ جرَاد",35,"د",1,0],["إِن تَغَنَّ الوَرقاءُ في الأَوراقِ","صَدَّ عَنّي آسي الأَسى وَالراقي",36,"ق",2,1],["أَنتَ غَنِيٌّ مِن كُلِّ حُسنٍ","أَما لِهَذا الغِنى زَكاةُ",37,"ه",1,0],["إِن تَغدُ مِن عَدَنٍ فَأَبينَةٍ","فَمَقيلُها الحُوّارُ وَالبِشرُ",38,"ر",1,0],["أَن تَغضَبَ الكَأسُ لِما قَد أَنتَ","إِنَّ أَناةَ الكَأسِ شَيءٌ نَكِر",39,"ر",1,0],["إن تغنّيتُ أو بكيت فإني","عبد قلبي مدامعاً وابتساما",40,"م",2,0],["إن تغّنيت أو بكت سواء","أعشق الناس من سلا ثم هاما",40,"م",2,0],["إنْ تَغْشَ طَرْفي وقلبي نازلاً بهما","فالطرفُ والقَلبُ كُل مَنزلُ القَمر",41,"ر",1,0],["أنتِ غذَّيتني منَ الحبِّ شهْداً","أنتِ أسقيتني بهِ السَّلْسَبيلا",42,"ل",2,0],["أنت غيثً على العُفاةِ","وليثٌ على العِدى",43,"د",2,0],["إن تغنى بلبل قلت له","أيها البلبل قف لا تتغن",44,"ن",1,0],["أنت غصن مائل في لينه","قال لكن ليس للغصن كفل",45,"ل",1,0],["أَنْتَ غيثٌ على العُفاة هطول","أَنْتَ بحرٌ من المكارم طامي",46,"م",2,0],["إنْ تغابَتْ عنه أُناسٌ لأمرٍ","أَو عَمَتْ عنه أعينُ الحسَّاد",47,"د",1,0],["أنت غوثُ الأنام غيثُ أوا","م الخلق خلّى سماحه حيث حلَّا",48,"ل",2,0],["إِن تَغَنّى خَرَقتُ ثَوبِيَ غَيظا","فَتَغَنّى في ثَوبِهِ الزَنبورُ",49,"ر",1,0],["إن تغيظونا فالتقاطع أنكى","حيث منه أسواقكم ستبور",50,"ر",1,0],["أنت غيب وهو غيب","لك تأتي أنت منه",51,"ن",2,0],["أنت غيري حقيقة ولو اَني","قلت لما فنيت ذاتك ذاتي",52,"ت",2,0],["إِن تغب عنكمُ الهديّةُ مني","فسآتيكم بِنفْسِي هديَّه",53,"ي",2,0],["إن تغيبُوا عن عيوني فلَكُم","في سُوَيدا القلب قد شيَّدتُ كِنّا",54,"ن",2,0],["أنتَ غُصنٌ مِن دَوحَةٍ خَصَّها اللَّ","هُ بِطيبِ الثَّرى وطيبِ الثِّمار",55,"ر",1,0],["أَنتَ غُصنٌ وَلَم يُمِلْكَ كَلامي","بِاِلتِفاتٍ إِليّ مَاذا يُميلُكْ",56,"ك",1,1],["أنت غيثُ العباد يا ابن ابن سلطا","نَ بن سيفٍ وأنت ليث الخميسِ",57,"س",1,1],["أنت غيث يثري الفقير بنعماه","وليث تحت العجاج المثار",58,"ر",1,0],["أنت غيث يعشو إلى ناره ال","وفد وليث يغشى الأسنة ذلقا",59,"ق",2,0],["أنت غيثي إذا ظمئت لورد","أنت غوثي إذا افتقرت لزاد",60,"د",1,0],["إنْتِغَنَّى به ونشْد به ونقْصِد","والاشواق اللّي نعانيها شديده",61,"د",2,0],["ان تغب حبذا وان تبق فالفضل","الذي قالته منثى العجيب",62,"ب",1,0],["أنت غيثٌ لكنَّ جودك من أولا","ه سكب وأوَّل الغيث قطر",63,"ر",1,0],["إن تغِظنا على الزمانِ بما ضَنَّت","به من جداً يدُ الحدثانِ",64,"ن",1,0],["إِن تَغرُ بِالخَرقاءِ أُسرَتَنا","تَلقَ الكَتائِبَ دونَنا تَردي",65,"د",2,0],["أَنتَ غَذَيتني بِفَضلك إِذ سَلّح","تَ مُستَقبَلي بِعَضب صَقيلِ",66,"ل",1,0],["أَنتَ غَوثٌ بَل كَذَا غَيثٌ لَنا","أَنتَ كَهفٌ لِليَتَامى الفُقَرَا",67,"ر",2,0],["انتَ غيثي حين اقلَقُ من","نكباتِ الدهر والأبدى",68,"د",2,0],["أنت غوثُ الكون اجمعهُ","ومدادٌ ليسَ بالعدد",68,"د",1,0],["ان تغتدي يحكمها امرد","مهفهف القامة مياسها",69,"س",3,0],["إن تغيبي عنّا فسقياً ورعياً","أو تحُلّي فيناً فأهلاً وسهلا",70,"ل",2,0],["إن تغز فالنصر والفتح المبين له","عليك ألوية خفاقة العذب",71,"ب",1,0],["أنتَ غادرت دولة الملك الناص","ر يهفو لواؤها المنشور",72,"ر",1,0],["أنت غيث تهمي شآبيب هم","اه علينا في كلّ عام جماد",73,"د",1,0],["أنت غيث أنت بدر","أنت ليث أنت شمس",74,"س",1,0],["أنت غوثُ الأنام بل وغياثُ ال","مُستْتغيِثين إذ خلفت أباكا",75,"ك",2,0],["أنتِ غادرتني غريقاً حريقا","أنتِ صيّرتني نحيفاً نحيلا",76,"ل",2,0],["أَنتَ غَيثٌ في العَطيّا","ت وَلَيثٌ في السَريّه",77,"ي",2,0],["أَنتَ غَيثٌ يُعاشُ في كَنَفَيهِ","حينَ تُمسي البِلادُ جَدباً مَحولا",78,"ل",2,0],["أنت غوث وغياث","وعطوف ومواسي",79,"س",2,0],["ان تغيب عن عيوني","انه في القلب قد حل",80,"ل",1,0],["إن تغب في الثرى فذكراك تبقى","في قلوب الأبناء والأحفاد",81,"د",1,0],["إن تغاضوا عنها دعتهم إليها","بلسان الشذى ولحن العبير",82,"ر",1,0],["انت غصن إن ماس يرسل لحنا","ام كمان ام بلبلٌ سكرانُ",83,"ن",1,0],["أنت غوث لمن شكالك كرباً","أنت غيث لمن شكالك محلا",84,"ل",2,0],["أنت غرسُ النيل هلّا صنتهُ","وبذرتَ الخير في هذا البلَد",85,"د",1,0],["إن تغب عنّا فقد ذكّرتهم","بعلاءِ الشرق لا شلَّت يداك",86,"ك",1,0],["أَنتَ غوثُنا","وَالفضا رَخم",87,"م",1,0],["أَنتَ غالِبٌ","يَومَ تَختَصِم",87,"م",1,0],["إن تُغفِلوا أَعمالكم","فَوزارة العُمّال غُفلُ",88,"ل",1,0],["انت غصن الخلاف لم","أجن منه سوى الكند",89,"د",1,0],["إِن تَغتَبِط في اليَومِ تُصبِح في غَدٍ","مِمّا خَبا لَكَ وَاجِماً تَتَوَجَّعُ",90,"ع",1,0],["إِن تَغوِ أَغوِ وَإِن تُصِب","رُشداً فَقِدماً اِختَرتَ خيرَه",91,"ر",2,0],["ان تغدى من كف طه رضيعاً","فالعدى من دماه ترضع سمرا",92,"ر",2,0],["إن تغنى فكل عضو يرجى","إنه مسمع عليه حبيس",93,"س",1,0],["إن تغضِ عيناك من تيه فلا عجب","عيناي ضاعفتا في حسنك النظرا",94,"ر",2,1],["إن تُغب شمسًا فأوصِ النوم بي","قبل أن تُعرض عني أو تغيبا",95,"ب",2,0],["أنت غلّبتني على كل جبّا","ر وقلدتني زمام القضاء",96,"ا",2,0],["إن تغزّلت في الحسان بشعرٍ","فهي أعني إذا ذكرت النساء",97,"ا",2,0],["إن تغنيت يا غزالي فشرف","غزلي في جمالك المتسامي",98,"م",2,0],["إِن تَغَنَّت حارَ شَحرورُ الرُبا","أَو تَثَنَّت غارَ مِنها القَضَب",99,"ب",1,0],["أنت غوث الأنام والكون طرا","أنت سر الوجود علما وحلما",100,"م",2,0],["إن تغننا الهيجاء أفقرنا الندى","إن السماحة آفة الأموال",101,"ل",1,0],["أَنتَ غياثُ مَحْلِهِمْ إِنْ أَجدَبوا","وَخَيرهُم إِنْ ذُكِر الخيارُ",102,"ر",1,0],["أَنت غَيثٌ بِهِ العَوالمُ تَحيا","وَربيعٌ يُحيى النفوسَ ويَسعَدْ",103,"د",1,0],["أنت غربٌ وذاك شرقٌ مقيما","أي فتقٍ أتى من الجانبين",104,"ن",1,0],["إِن تَغنّوا بِالحُبِّ عاد سُلوّاً","يُزعِجون الهَوى بِما يُسمِعونَه",105,"ن",2,0],["أنتَ غُصْنٌ في رَوْضَةِ الآمالِ","جَرِّدِ العَزْمَ في صُفوفِ اللَّيالي",106,"ي",1,0],["أنت غالي ياوليفي لا تغلاّ","يثبت الليّ بيننا ايامٍ طوالا",107,"ل",2,0],["إن تغادرني بحزن ال","بُعدِ عنكم أتسربل",108,"ل",1,0],["إنْ تغِبْ عنْ نُور عيني","تُصبِحُ الجنّةُ رَمْضا",109,"ض",2,0],["إِنْ تَغَنَّىْ يَعْشَوْشِبُ الصُّبْحُ عِنْدِيْ","أَوْ تَأَذَّىْ بَكَىْ عَلَيْهِ مَسَاْئِيْ",110,"ا",3,0],["ان تغلّى ينخلق في خاطري مليون حوبة","وان تخّلى راحت ضلوعي من الفرقا حطاما",111,"م",2,0],["إن تغنى فالكل يصغي انشراحا","للغناء الذي يثير المطارح",112,"ح",1,0],["إِنْ تُغْضِبِيهِ فَقَدْ يَنأَى النَهَارُ بِهِ","وَتَحتَويِهِ أَكُفُّ النُورِ بالوَشَلِ",113,"ل",1,0],["انت غيثن هل من بعد الجفافي","واخصبت ارضي .. حمدتك يا الاه",114,"ا",2,0],["أنت غواصنا الأثير المفدّى","ليس إلا لديك هذا العقيق!",115,"ق",1,0],["أنت غصنٌ في دوحةِ الحقِّ فوا","حٌ زكيُّ الثمارِ.. طابتْ وطابا",116,"ب",2,0],["ان تغرب صاحبي جيته وطن","وان تغربت أكثر أصحابي تشين",117,"ن",1,1],["انت غايه انت رايه انت شاره","انت خوه انت قوه انت جيره",118,"ر",2,0],["أنت غايب .. وكنّك غايبٍ 1000 عام","شفت كيف الزمان .. وسطوة العولمة ؟",119,"م",2,0],["أنت غوثُ المظلومِ ، ياربِّ ، فامنحْ","شَعبَها الحُرَّ حقَّهُ المسلوبا",120,"ب",2,0],["أنت غنّي يا رفاهي أطربيني","ساعدي الموجَ على بثِّ الشعورِ",121,"ر",1,0],["إنْ تَغلقِي كُلَّ المنافِي أختفِي","إن تَفتَحِي بابًا يُنَادِي شهْوتِي",122,"ي",1,1],["أنتَ غنيّتَ للرضا والمحبهْ","عاشقا .. والوجودُ يأكلُ قلبَهْ",123,"ب",2,1],["أنتَ غيبي إن تجلّى فيّ كشفٌ","أنتَ كشفي حين يحتارُ الخطابُ",124,"ب",1,0]]}