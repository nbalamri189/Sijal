{"poems":[[3,"هل غادر الشعراء من متردم","https://www.aldiwan.net/poem85.html","الكامل"],[86,"أجاد مطران كعاداته","https://www.aldiwan.net/poem10857.html","السريع"],[73,"لا افتنان كافتناني","https://www.aldiwan.net/poem11970.html","مجزوء الرمل"],[47,"نبوة الإدلال ليست","https://www.aldiwan.net/poem25295.html","مجزوء الرمل"],[23,"يا حار من يغدر بذمة جاره","https://www.aldiwan.net/poem21305.html","الكامل"],[72,"مرحبا بالنظم يأتي","https://www.aldiwan.net/poem18489.html","مجزوء الرمل"],[72,"يا عذولي خلني أغنم عمري","https://www.aldiwan.net/poem18701.html","الرمل"],[72,"نفس عن الحب ما حادت ولا غفلت","https://www.aldiwan.net/poem19467.html","البسيط"],[51,"هل تعرف الدار بذي الأثأب","https://www.aldiwan.net/poem8512.html","السريع"],[51,"مذ صرت همي في النوم واليقظه","https://www.aldiwan.net/poem65036.html","المنسرح"],[91,"وقعت نحلة على الأقحوان","https://www.aldiwan.net/poem8795.html","عموديه"],[91,"دمية حسناء تغري النظرا","https://www.aldiwan.net/poem8870.html","عموديه"],[91,"لمن الديار تنوح فيها الشمأل","https://www.aldiwan.net/poem9061.html","عموديه"],[45,"عهد المشوق بوصل الأنس الخرد","https://www.aldiwan.net/poem62749.html","البسيط"],[45,"بين أفق الصبا وأفق الدبور","https://www.aldiwan.net/poem63589.html","الخفيف"],[45,"لاجديد الصبا ولا ريعانه","https://www.aldiwan.net/poem66799.html","البسيط"],[61,"يا أبا إسحاق زاد الله","https://www.aldiwan.net/poem51668.html","مجزوء الرمل"],[66,"تركتنا لواحظ الأتراك بين","https://www.aldiwan.net/poem40647.html","الخفيف"],[97,"يا أبا الأشواق غن","https://www.aldiwan.net/poem24584.html","مجزوء الرمل"],[105,"اذهب حيي مذمما مشؤوما","https://www.aldiwan.net/poem44195.html","الكامل"],[75,"زهر الروض بنت دمع الغمام","https://www.aldiwan.net/poem69020.html","الخفيف"],[48,"هذا مقال سمج","https://www.aldiwan.net/poem62490.html","مجزوء الرجز"],[48,"لله طيف سرى فأرقني","https://www.aldiwan.net/poem66127.html","المنسرح"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85523","الرمل"],[100,"رسالة إلى صديق في قبره","https://www.poetsgate.com/ViewPoem.aspx?id=183584",""],[47,"نَبْوَة ُ الإدْلالِ لَيْسَتْ،","https://www.poetsgate.com/ViewPoem.aspx?id=14763",""],[109,"إن تغزلت أو مدحت فإني","https://www.aldiwan.net/poem16534.html","الخفيف"],[115,"أه من يوسف قلبي","https://www.aldiwan.net/poem40883.html","عموديه"],[115,"يا رفاعي وقعت في أبوابك","https://www.aldiwan.net/poem41238.html","عموديه"],[143,"عاذ بالصفح من أَحب البقاء","https://www.aldiwan.net/poem11716.html","الخفيف"],[151,"إن تغيبوا عن العيون فأنتم","https://www.aldiwan.net/poem1408.html",""],[199,"يوم بهذي الليالي يشبه القمرا","https://www.aldiwan.net/poem45350.html","البسيط"],[199,"أنت غرست الحب في اضلعي","https://www.aldiwan.net/poem45581.html","السريع"],[204,"مني تقيا ومنك مكر","https://www.aldiwan.net/poem53278.html","البسيط"],[211,"أقريب أنت مني أم بعيد","https://www.aldiwan.net/poem46631.html","الرمل"],[270,"عودي الى ماضيك يا بغداد","https://www.aldiwan.net/poem35650.html","الكامل"],[282,"إن تغن الورقاء في الأوراق","https://www.aldiwan.net/poem32690.html","الخفيف"],[282,"يا قمرا وصله الحياة","https://www.aldiwan.net/poem32856.html","مخلع البسيط"],[300,"عوجوا فحيوا أيها السفر","https://www.aldiwan.net/poem45485.html","أحذ الكامل"],[300,"قد بكرت عاذلتي بكرة","https://www.aldiwan.net/poem45491.html","السريع"],[328,"الندامى وما أحب الندامى","https://www.aldiwan.net/poem54938.html","الخفيف"],[364,"لولا طروق خيال منك منتظر","https://www.aldiwan.net/poem60919.html","البسيط"],[400,"أنت علمتني !!","https://www.aldiwan.net/poem6744.html","عموديه"],[402,"يا بن خير الورى ومن","https://www.aldiwan.net/poem46910.html","مجزوء الخفيف"],[403,"حدث البارق عن صنعا وعن","https://www.aldiwan.net/poem33394.html","الرمل"],[403,"قال لي خلي لما زارني","https://www.aldiwan.net/poem33464.html","الرمل"],[416,"من لصب متيم مستهام","https://www.aldiwan.net/poem53989.html","الخفيف"],[416,"ذكراني عهد الصبا بسعاد","https://www.aldiwan.net/poem54075.html","الخفيف"],[464,"جزت حد المديح قولاً وفعلا","https://www.aldiwan.net/poem3134.html","عموديه"],[468,"ومغن له لسان عثور","https://www.aldiwan.net/poem60094.html","الخفيف"],[479,"مجلس الشورى هل أتاك النذير","https://www.aldiwan.net/poem37602.html","الخفيف"],[558,"ما له عندك كنه","https://www.aldiwan.net/poem33685.html","مجزوء الرمل"],[558,"ليت شعري مذ كررت نظراتي","https://www.aldiwan.net/poem34727.html","الخفيف"],[575,"لم أذق بعد ريقه البابليه","https://www.aldiwan.net/poem2830.html","الخفيف"]],"verses":[["إِن تُغدِفي دوني القِناعَ فَإِنَّني","طَبٌّ بِأَخذِ الفارِسِ المُستَلئِمِ",0,"م",1,0],["إِن تُغفِلوا دارِسَ آثارِهِ","عَفّى عَلَيها الدَهرُ بِالطَمسِ",1,"س",1,0],["إِن تَغَنّى البُلبُلُ اِهتا","جَ غِناءَ الوَرَشانِ",2,"ن",1,0],["إِن تَغَيَّرتَ فَما غُي","يِرَ مِنّا لَكَ عَهدُ",3,"د",1,0],["إِن تَغدِروا فَالغَدرُ مِنكُم شيمَةٌ","وَالغَدرُ يَنبُتُ في أُصولِ السَخبَرِ",4,"ر",1,0],["إن تغب عني وإن تق","دم فلي بالهجر قرحه",5,"ح",2,0],["أنت غيثي ونباتي للثنا","حقه أن يتلقاك بزهر",6,"ر",1,0],["إن تغش أبواب مغناه التي فتحت","فطالما بالعطايا والندى قفلت",7,"ت",1,0],["أنت غرابٌ خيرُ أحواله","ما لَزم الصمتَ ولم يَنْعَبِ",8,"ب",1,0],["أنت غيثٌ يقيظُ فينا حياهُ","إذ حيا الغيثِ لا يكاد يقيظ",9,"ظ",1,0],["إِن تَغِب في فَراشَةٍ أَلواني","فَأَنا في زَهرَةٌ تَطيرُ",10,"ر",1,0],["إِن تَغِب فَالصُبحُ عِندِيَ كَالدُجى","وَالدُجى إِن جِئتَ بِالصُبحِ اِزدَرى",11,"ر",2,0],["إِن تَغفَلِ الدُنيا وَيَغفَل أَهلُها","عَنكُم فَخالِقُ أَهلِها لا يَغفَلُ",12,"ل",1,0],["إِن تَغلُ في اللَومِ أُغرِق في اللَجاجِ وَإِن","تُكثِر مِنَ العَذلِ أُكثِر مِن جَوى الكَمَدِ",13,"د",1,0],["أَنتَ غَيثُ الغُيوثِ يَحيا بِهِ القَو","مُ إِذا أَمحَلوا وَبَحرُ البُحورِ",14,"ر",1,0],["إِن تَغَطّى عَنكَ الأَصادِقُ تُبدي","شِدَّةُ الدَهرِ عَنهُمُ وَلِيانُه",15,"ن",2,0],["أنتَ غَيْثٌ لموالي","كَ ولَيثٌ لمُثيرِكْ",16,"ك",1,0],["إِن تَغِب عَن لِحاظِ عَيني فَلِلقَل","بِ لِحاظٌ سَريعَةُ الإِدراكِ",17,"ك",1,0],["إن تغنيني فإني","طائر في كل غصن",18,"ن",1,0],["إن تغضبوا لبني النضيرِ فإنّه","خَطبٌ يراه بنو أبيكَ عظيما",19,"م",2,0],["إن تغنت جاوبنها برنينٍ","يدعُ للفتك أنفُسَ الصُّوَّام",20,"م",1,0],["أَنتَ غَزالٌ غَنِجٌ","بِهِ يَتيهُ الغَنَجُ",21,"ج",1,0],["أَنتَ غَرامي وَإِن أَبَيتَ هَوىً","وَأَنتَ سُؤلي وَمُنتَهى شَجَني",22,"ي",1,0],["أَنتَ غصن مزهر","وَستحوى ثمرا",23,"ر",2,0],["أنت غافٍ بين نومين، أنا","بين نابيَ حيَّةٍ وحشٌ رقادي",24,"د",2,0],["إنْ تَغَيَّرْتَ فَمَا غُيّ","رَ مِنّا لَكَ عَهْدُ",25,"د",1,0],["إِن تَغَزَلت أَو مَدَحت فَإِني","لَستُ بِالشاعر المُطيل كَلامي",26,"ي",1,1],["انت غصن شأنك المي","ل كما ملت الا اعطف",27,"ف",1,0],["انت غوث الوجود مفتاح كنز ال","جود والخير سح من ميزابك",28,"ك",1,0],["أَنتَ غَيثٌ إِذا اِعتَرى الأَرضَ مَحلٌ","وَدَواءٌ إِذا اِشتَكى الدينُ داءَ",29,"ا",2,0],["إن تغيبوا عن العيون فأنتم","في قلوب حضوركم مستمر",30,"ر",1,1],["إن تغرسِ الرأيَ فالتسديدُ زهرتُهُ","وإن هززتَ القنا أَجْنَيْنَكَ الظفرا",31,"ر",2,0],["أنتَ غرستَ الحبَّ في اضلعي","فكيفَ لا أسقيهِ من أدمعي",32,"ي",1,1],["أنتَ غَزالٌ وأنت غُصنٌ","وأنتَ ليلٌ وأنت بَدرُ",33,"ر",1,0],["إن تغب عني فهذى صورتك","تؤنس الروح وهذي طلعتك",34,"ك",1,0],["إن تغسلوا دونَ القلوبِ تُطَهِّروا","وطناً عليهِ من العلوجِ جرَاد",35,"د",1,0],["إِن تَغَنَّ الوَرقاءُ في الأَوراقِ","صَدَّ عَنّي آسي الأَسى وَالراقي",36,"ق",2,1],["أَنتَ غَنِيٌّ مِن كُلِّ حُسنٍ","أَما لِهَذا الغِنى زَكاةُ",37,"ه",1,0],["إِن تَغدُ مِن عَدَنٍ فَأَبينَةٍ","فَمَقيلُها الحُوّارُ وَالبِشرُ",38,"ر",1,0],["أَن تَغضَبَ الكَأسُ لِما قَد أَنتَ","إِنَّ أَناةَ الكَأسِ شَيءٌ نَكِر",39,"ر",1,0],["إن تغنّيتُ أو بكيت فإني","عبد قلبي مدامعاً وابتساما",40,"م",2,0],["إن تغّنيت أو بكت سواء","أعشق الناس من سلا ثم هاما",40,"م",2,0],["إنْ تَغْشَ طَرْفي وقلبي نازلاً بهما","فالطرفُ والقَلبُ كُل مَنزلُ القَمر",41,"ر",1,0],["أنتِ غذَّيتني منَ الحبِّ شهْداً","أنتِ أسقيتني بهِ السَّلْسَبيلا",42,"ل",2,0],["أنت غيثً على العُفاةِ","وليثٌ على العِدى",43,"د",2,0],["إن تغنى بلبل قلت له","أيها البلبل قف لا تتغن",44,"ن",1,0],["أنت غصن مائل في لينه","قال لكن ليس للغصن كفل",45,"ل",1,0],["أَنْتَ غيثٌ على العُفاة هطول","أَنْتَ بحرٌ من المكارم طامي",46,"م",2,0],["إنْ تغابَتْ عنه أُناسٌ لأمرٍ","أَو عَمَتْ عنه أعينُ الحسَّاد",47,"د",1,0],["أنت غوثُ الأنام غيثُ أوا","م الخلق خلّى سماحه حيث حلَّا",48,"ل",2,0],["إِن تَغَنّى خَرَقتُ ثَوبِيَ غَيظا","فَتَغَنّى في ثَوبِهِ الزَنبورُ",49,"ر",1,0],["إن تغيظونا فالتقاطع أنكى","حيث منه أسواقكم ستبور",50,"ر",1,0],["أنت غيب وهو غيب","لك تأتي أنت منه",51,"ن",2,0],["أنت غيري حقيقة ولو اَني","قلت لما فنيت ذاتك ذاتي",52,"ت",2,0],["إِن تغب عنكمُ الهديّةُ مني","فسآتيكم بِنفْسِي هديَّه",53,"ي",2,0]]}