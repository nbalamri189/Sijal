لم","https://www.aldiwan.net/poem53957.html","المتقارب"],[417,"أتنسى صالحا يوما عبوسا","https://www.aldiwan.net/poem54060.html","الوافر"],[417,"أقول لصاحبي ورضيع كأسي","https://www.aldiwan.net/poem54079.html","الوافر"],[417,"أتنكر منك ما تطوي الضلوع","https://www.aldiwan.net/poem54084.html","الوافر"],[417,"حثثت على عنيف السير نوقي","https://www.aldiwan.net/poem54111.html","الوافر"],[417,"دعاه إلى الهوى داعي التصابي","https://www.aldiwan.net/poem54151.html","الوافر"],[417,"قلب يذوب ومهجة تتقطع","https://www.aldiwan.net/poem54185.html","الكامل"],[433,"أبدى شمائل جفوة وبعاد","https://www.aldiwan.net/poem12600.html","الكامل"],[450,"جهاد ولكن ليس بالسيف والقن","https://www.aldiwan.net/poem990.html",""],[459,"من جب غارب هاشم وسنامها","https://www.aldiwan.net/poem55867.html","الكامل"],[459,"يا ماشيا بالعتب يحمل مره","https://www.aldiwan.net/poem56079.html","الكامل"],[459,"سائل الدار إن سألت خبيرا","https://www.aldiwan.net/poem56165.html","الخفيف"],[459,"تهوى وأنت محلأ مصدود","https://www.aldiwan.net/poem56216.html","الكامل"],[459,"أمن أسماء والمسرى بعيد","https://www.aldiwan.net/poem56226.html","الوافر"],[464,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[465,"تلقاك يا سعد بالنجح سعد","https://www.aldiwan.net/poem3152.html","عموديه"],[465,"متى لمتني في الغوزال الأغنِ","https://www.aldiwan.net/poem3326.html","عموديه"],[478,"أعن أرض الغميم لمحت نارا","https://www.aldiwan.net/poem15207.html","الوافر"],[480,"سماط أمد إلى الظرفا","https://www.aldiwan.net/poem37187.html","المتقارب"],[506,"من تنادي","https://www.aldiwan.net/poem27891.html","المديد"],[515,"أتنكر بأس أحداق العذارى","https://www.aldiwan.net/poem20826.html","الوافر"],[515,"جعلتك بالسويدا من فؤادي","https://www.aldiwan.net/poem20857.html","الوافر"],[516,"أفي أهل ذا النادي عليم أسائله","https://www.aldiwan.net/poem12195.html","الطويل"],[539,"أمسوا يمر الذكر منك بمجلس","https://www.aldiwan.net/poem47992.html","عموديه"],[541,"أرى الدهر ينسيني أحاديث جمة","https://www.aldiwan.net/poem56756.html","الطويل"],[552,"أضنا بالتواصل والتصافي","https://www.aldiwan.net/poem47391.html","الوافر"],[552,"أتنسين يا لمياء شملك جامعا","https://www.aldiwan.net/poem48098.html","الطويل"],[568,"ألا أبلغ أبا بكر","https://www.aldiwan.net/poem69649.html","مجزوء الكامل"]],"verses":[["أَتَنظُرُ كَيفَ تَسفَعُ بِالنَواصي","لَيالينا وَتَعثُرُ بِالجِبالِ",0,"ل",1,0],["أَتُنجِدانِ فؤاداً شَيِّقاً عَلِقَتْ","بِهِ الصَبابَة إِن أَتهَمتُما نَجَدا",1,"د",2,0],["أَتَنسى قَولَ صَحبِكَ إِذ تَراءَتْ","هيَ ابنَةُ وائِلٍ لَولا شَواها",2,"ا",3,0],["أتُنْصِفُني أُخْتُ العُرَيْبِ وقد أرى","مُوَشَّحَها يَعْدو علَيْهِ المُؤَزَّرُ",3,"ر",1,0],["أَتَناساكِ كَي يُريغَ فُؤادي","زُمَّ يَشتَدُّ عِندَ ذاكَ وَلَوعي",4,"ع",2,0],["أَتَنسَينَ أَيّاماً لَنا بِدُحَيضَةٍ","وَأَيّامَنا بَينَ البَدِيِّ فَثَهمَدِ",5,"د",1,0],["أَتَنسى رِفدَنا بِعُوَيرِضاتٍ","غَداةَ الخَيلُ تَخفِرُ ما حَوَيتا",6,"ت",2,0],["أَتَنسى إِذ تُوَدِّعُ وَهيَ بادٍ","مُقَلَّدُها كَما بَرَقَ الصَبيرُ",7,"ر",1,0],["أَتَنْأَيْنَ عَنِّي وَتَجْفِيْنَنِي","لإِرْضَاءِ طَائِفَةٍ مَاكِرَهُ",8,"ر",2,0],["أَتَنْقَضِي نَسَمٌ مِنْ رُوحِ خَالِقِهَا","جَبْراً كَمَا تَنْقَضِي إِنْ مَرَّتِ النَّسَمُ",9,"م",1,0],["أَتَنْظُرُونَ بَنِي الطَّلْيَانِ مُعْجِزَهُمْ","وَتَذْكُرُونَ الَّذِي أَنْسَاكُمُ القِدَمُ",10,"م",1,0],["أَتنسى ولا تنسى ليالِينَا التي","خلسنا بِهِنَّ العيش في جنَّة الخُلدِ",11,"د",1,0],["أتناط الفتوح في خنصر الك","فِّ ازدياناً إن قطّت الإبهام",12,"م",1,0],["أتنسى أدرنة عما قريب","إذن لا بلغنا العلا والكمال",13,"ل",1,0],["أَتَنسى بِالرِمادَةِ وِردَ سَعدٍ","كَما وَرَدوا مُسَلَّحَةَ الصِعابِ",14,"ب",1,0],["أَتَنسَونَ الزُبَيرَ وَرَهطَ عَوفٍ","وَجِعثِنَ بَعدَ أَعيَنَ وَالرَبابا",15,"ب",2,0],["أَتَنسى دارَتي هَضَباتِ غَولٍ","وَإِذ وادي ضَرِيَّةَ خَيرُ وادي",16,"د",2,1],["أَتَنفي قُروماً مِن مَعَدٍّ لَغَيرِهِم","كَذَبتَ وَلَم تَصدُق مَعَدٌّ مَصيرُها",17,"ر",3,1],["أَتَنفَعُكَ الحَياةُ وَأُمُّ عَمروٍ","قَريبٌ لا تَزورُ وَلا تُزارُ",18,"ر",1,0],["أَتَنسَونَ شَدّاتِ اِبنِ أَحوَزَ إِنَّها","جَلَت كُلَّ وَجهٍ مِن مَعَدٍّ فَأَسفَرا",19,"ر",2,0],["أَتَنسَونَ يَومَي رَحرَحانَ كِلَيهِما","وَقَد أَشرَعَ القَومُ الوَشيجَ المُؤَمَّرا",19,"ر",2,0],["أَتَنسَونَ يَومَي رَحرَحانَ وَأُمُّكُم","جَنيبَةُ أَفراسٍ يَخُبُّ بَعيرُها",20,"ر",3,0],["أَتَنسَونَ الزُبَيرَ وَرَهنَ عَوفٍ","وَعَوفاً حينَ عَزَّكُمُ فَجارا",21,"ر",2,0],["أَتَنسَينَ ما نَسري لِحُبِّ لِقائِكُم","وَتَهجيرَنا وَالبيدُ غُبرٌ خَواشِعُ",22,"ع",1,0],["أَتَنسَونَ الزُبَيرَ قَتيلَ سَعدٍ","وَجِعثِنَ إِذ تُصَرَّفُ كُلَّ حالِ",23,"ل",1,0],["أَتَنسى يَومَ حَومَلَ وَالدَخولِ","وَمَوقِفَنا عَلى الطَلَلِ المُحيلِ",24,"ل",1,1],["أَتَنسى لِطولِ العَهدِ أَم أَنتَ ذاكِرٌ","خَليلَكَ ذا الوَصلِ الكَريمِ شَمائِلُه",25,"ل",2,0],["أَتَنسى إِذ تُوَدِّعُنا سُلَيمى","بِفَرعِ بَشامَةٍ سُقِيَ البَشامُ",26,"م",1,0],["أَتُنكِرُني كَأَنَّكَ لَستَ تَدري","بِأَنّي ذَلِكَ البَطَلُ المُحامي",27,"م",2,0],["أَتُنكِرُ أَنّي شَكَوتُ الزَمانَ","وَأَنّي عَتَبتُكَ فيمَن عَتَب",28,"ب",1,0],["أتنبُو بيَ الدنيا على حين لينها","وقد سكن الزلزال وامْتُهِدَ المهْدُ",29,"د",1,0],["أتَنمى إلى قطحان ثم تسبني","ضَلَلْتَ سبيل الأدعياء الأكايس",30,"س",1,0],["أتنقُصُ بي معروفك الصّمَّ بعدما","برئتُ منَ الأفعال ذاتِ المناقص",31,"ص",1,0],["أتناك ذاك وذاك طو","لك في الرجال وذاك عرضُك",32,"ك",1,0],["أتنتحِلُ التقزُّزَ يا ابن حُسْنٍ","وحَجَّامُ القبيلةِ يمْتَطيكا",33,"ك",2,0],["أتَنْسونَ من يَرعَى لكْم كلَّ ليلةٍ","نجومَ القوافي والنجومَ التَّوالِيَا",34,"ل",3,0],["أَتُنكِرُ الدارَ أَم عِرفانَ مَنزِلَةٍ","لَم يَبقَ غَيرُ مُناخِ القِدرِ وَالحُمَمِ",35,"م",1,1],["أَتُنشدُ صوتَ الحَيَاةِ الرخيمَ","وأَنتَ سجينٌ بهذا الوجودْ",36,"د",1,0],["أَتَنسينَ أَيّامَنا بِاللِوى","وَأَيّامَنا بِذَوي الأَجفَرِ",37,"ر",1,0],["أتنيل بغداد الاديب سلامة","ام ليس في بلد السلام سلام",38,"م",1,0],["أَتُنكِرُ يا اِبنَ إِسحاقٍ إِخائي","وَتَحسَبُ ماءَ غَيري مِن إِنائي",39,"ا",2,1],["أَتُنكِرُ ما نَطَقتُ بِهِ بَديهاً","وَلَيسَ بِمُنكَرٍ سَبقُ الجَوادِ",40,"د",1,1],["أَتَنسى بَنو سَعدٍ جُدودَ الَّتي بِها","خَذَلتُم بَني سَعدٍ عَلى شَرِّ مَخذَلِ",41,"ل",1,1],["أَتَناسَيتَ أَم نَسيتَ المَنايا","أَنَسيتَ الفِراقَ لِلأَولادِ",42,"د",1,0],["أَتُنكِرُ أَن تَكونَ أَخا نَعيمٍ","وَأَنتَ تَصيفُ في فَيِءِ الظِلالِ",43,"ل",1,0],["أَتَنسى رَسولَ اللَهِ أَفضَلَ مَن مَشى","وَآثارُهُ بِالمَسجِدَينِ كَما هِيا",44,"ي",2,0],["أتنزعَ آلةَ التعريف منا","وما أعني بها ألفاً ولاما",45,"م",2,0],["أَتَندُبُ إِلفاً قَد أَذابَكَ بُعدُهُ","وَتُذري دُموعاً قَد يَسيلُ غَزيرُحا",46,"ر",3,0],["أَتنامُ عَن حَالٍ تظلُّ لِمثلها","تَهفو القُبورُ وتَفزعُ الأكفانُ",47,"ن",1,0],["أَتنامُ عَينُكَ والعُيونُ سُهادُ","ويقَرُّ جنبُكَ والجُنوبُ قَتادُ",48,"د",1,1],["أتنظرُ نكبةَ الوطنِ المُذكَّى","وتسمعُ صيحةَ الشّعب الحريبِ",49,"ب",1,0],["أَتَنقِمُ ما يُريبُكَ مِن خِلالي","وَتُنكِرُ ما يَروعُكَ مِن مَقالي",50,"ل",2,1],["أَتنقضُ عهدَكَ تبغِي القتالَ","وما كنتَ ممّن بَغَى أو غَدَرْ",51,"ر",1,0],["أتنكرون على الإسلامِ بهجتَهُ","والله أطلعه من نوره مثلا",52,"ل",2,0],["أَتَنظُرانِ قَليلاً رَيثَ غَفلَتِهِم","أَو تَعدُوانِ فَإِنَّ الريحُ لِلعادي",53,"ي",1,1],["أَتَنعَتُ داراً قَد عَفَت وَتَغَيَّرَت","فَإِنّي لِما سالَمتَ مِن نَعتِها حَربُ",54,"ب",1,0],["أَتُنشِدُني بَعضَ ما صُغتَهُ","وَلا تَدَعِ الأَجوَدَ الأَفخَرا",55,"ر",2,0],["أتنسى صَدعَ أمّكَ فوق أيري","تدورُ كما يدورُ أبو رياحِ",56,"ح",1,0],["أَتَنَصُّحاً ما تَأمُرينَ فَمِثلَها","رَجَعَ النَصيحُ شَفى مِنَ الأَبراحِ",57,"ح",1,0],["أَتَنتَفي مِنّا لِآثامِنا","وَخِلتُها لَو نَطَقَت لَاِنتَفَت",58,"ت",1,0],["أتنقصه من حظه وهو زائدٌ!","ونبخسه والبخس شيءٌ محرم؟!",59,"م",1,0],["أتنكرني الشام وفي فؤادي","تلقّيت الصوارم والرماحا",60,"ح",2,0],["أَتَنْظُرُهَا حَسْنَاءَ جَمَّلَهَا الرَّدَى","لِيَسْطُو عَلَيْهَا سِطْوَةَ المُتَشَفِّعِ",61,"ع",1,0],["أَتَنْظرُ غيْرَ فضَاءٍ رَحِيبٍ","تُحَاكِي النُّجُومُ بِه العِثْيَرَا",62,"ر",2,0],["أَتُنكِر مَن أَتى أَو سَوفَ يَأتي","وَرَبُّكَ مَن أَتاحَ وَمَن يُتيحُ",63,"ح",1,0],["أتنسَينَ آثار من قد مضى","ودهراً تقاسيهِ قدما خؤونا",64,"ن",2,0],["أتنقمُ إن سفلَتْ كِفَّتي","لرجحانها ذاكَ أعلى لها",65,"ل",3,0],["أتنوخذ البحر .. ولا أرسي ..بجال المضيق","والشي بالشي؟ .. لاعيبه ولا أستحسنه",66,"ن",2,0],["أتنأى فهلاّ وقفة يشتفي بها","خليل ويقضي حقّ لوعته صبّ",67,"ب",1,0],["أتنأى وما ودّعت أهلا ولا حمى","فأين الحنان السمح والخلق الرّحب",67,"ب",1,0],["أتَنمى إلى قحطان ثم تسبُّني","ضَلِلْتَ سبيل الأَدعياء الأَكايس",68,"س",1,0],["أتنقُصُ بي معروفك الصّتَم بعدما","برئتُ من الأفعال ذاتِ المناقص",69,"ص",1,0],["أتُنْكِرُ يا ابنَ إسْحَقٍ إخائي","وتَحْسَبُ ماءَ غَيرِي من إنائي؟",70,"ا",2,1],["اتنصدع السَماء بنبح كَلب","أَم الشعرى العُبور بِهِ تبالي",71,"ل",2,0],["أتنكرُ مِن فتًى داءَ قديما","فهذا ليس منه صارَ بِدْعَا",72,"ع",2,0],["أتنساها على خَيْفِ","مِنىً تَهوِى أبابيلا",73,"ل",2,1],["أتنجو بجسمِك فوق الركاب","وتنِبذُ قلبَك بين الظِّباءِ",74,"ا",2,0],["أتنفق هذا في هوى هذه التي","أبى الله ان تسوى جناح بعوضة",75,"ه",1,0],["أتنزله بدارك بعد علم","وتحفر وسطها لك منه قبرا",76,"ر",2,0],["أَتِنا عِهادَ الأَرضِ يَرتَعِيانِها","مِنَ الضَيفِ حَتّى أَنسَلا وَتَقَوَّبا",77,"ب",2,0],["أَتَنَفّسَت بتنفُّسي أَثْلاتُهُ","أم أَيْنَعَتْ بمدامعي أزهارُهُ",78,"ر",2,0],["أتنامُ عن أمَلي وتتركني سُدىً","والدهرُ يَلحظني بطرفٍ أَخْزَر",79,"ر",1,0],["أتنشط للوصل يا سيدي","فإن الحبيب له قد نشطْ",80,"ط",1,1],["أتنفع ذي الملامةُ مستحيراً","وحشو القلب مني حرُّ نار",81,"ر",1,0],["أتنآى ورجلاك فوق الثرى","كأنك فوق مدار الشموس",82,"س",1,1],["أتنبو بحسنك عن عاشقيك","لتطويه أيدي البلا في الرموس",82,"س",1,0],["أَتُنكِرُه وَأَنتَ عَلَي","هِ لَو فَكَّرتَ بُرهانُ",83,"ن",1,0],["أتنسَى أيُّها العات","ب ظلما ليلةَ النَهْرِ",84,"ر",1,1],["أَتُنكِرُ قَتلي بِأَلحاظِها","وَهَذا دَمي في جَلابيبِها",85,"ب",3,1],["أَتَنساني وَأَنتَ كَفيلُ رِزقي","وَعِندَكَ إِن مَرِضتُ شِفاءُ دائي",86,"ا",2,0],["أَتَنسين ما بَيني وَبينك وَالدُجى","غِطاءٌ عَلَينا وَالعُيونُ هَواجِعُ",87,"ع",1,0],["أتنسى يوَمنا بالدَّيرِ صُبحاً","وَهامُ الأُفْقِ كَلَّله الشُّروق",88,"ق",1,0],["أتُنكِرُ إعزازي مكانَكَ جاهداً","وتَجْحَدُ إحساني إليك تُراكا",89,"ك",2,0],["أَتُنكِرُ إِن نَزَلتُ عَلى كَريمٍ","كَرامَتُهُ لِمُستَقرٍ مُقِرِّ",90,"ر",1,0],["أتنكر حقَّ قدّيسٍ طهورٍ","له في بِيعَة الأبكار عيد",91,"د",1,0],["أَتُنكرُ موتَهم وأنا سُهَيلٌ","طلَعتُ بموتِ أولادِ الزِناءِ",92,"ا",2,0],["أتنأين عني وتجفيني","لإرضاء طائفة ما كره",93,"ر",2,0],