{"poems":[[164,"في الصلح راسل دهر راح غضبانا","https://www.aldiwan.net/poem59080.html","البسيط"],[234,"جرحي بعينيك ليس يندمل","https://www.aldiwan.net/poem50867.html","المنسرح"],[302,"جلا الكؤوس فجلى ظلمة السدف","https://www.aldiwan.net/poem33219.html","البسيط"],[369,"أحضر الليل منك عقدا وثغرا","https://www.aldiwan.net/poem60893.html","الخفيف"],[469,"هذه دولة الندى والسماح","https://www.aldiwan.net/poem3162.html","عموديه"],[558,"يا أيها المعمود","https://www.aldiwan.net/poem68407.html","مجزوء الرجز"],[558,"عجبا لطيف خيالك المتجانب","https://www.aldiwan.net/poem68410.html","الكامل"],[121,"","https://poetry.dctabudhabi.ae/diwan/poem/145635","الكامل"],[121,"","https://poetry.dctabudhabi.ae/diwan/poem/145626","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56405","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53085","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77267","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204642","الخفيف"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35607","الكامل"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29307","البسيط"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/198890","البسيط"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86454","الخفيف"],[4085,"","https://poetry.dctabudhabi.ae/diwan/poem/105143","الخفيف"],[4332,"","https://poetry.dctabudhabi.ae/diwan/poem/73641","البسيط"],[4830,"هَيتَ لك","https://www.poetsgate.com/ViewPoem.aspx?id=198709",""],[4968,"معزوفة العشق","https://www.poetsgate.com/ViewPoem.aspx?id=208095",""],[4984,"عيد الشجرة","https://www.poetsgate.com/ViewPoem.aspx?id=180037",""],[5005,"على حافة الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=208150",""],[5111,"قِيثَارَةُ العِشْقِ","https://www.poetsgate.com/ViewPoem.aspx?id=212085",""],[5225,"السحابة","https://www.poetsgate.com/ViewPoem.aspx?id=30819",""],[5343,"عجزت عيونك","https://www.poetsgate.com/ViewPoem.aspx?id=132536",""],[5358,"نطقتْ","https://www.poetsgate.com/ViewPoem.aspx?id=201485",""],[5436,"موال حب للعراق(للشاعرجميل حسين الساعدي)","https://www.poetsgate.com/ViewPoem.aspx?id=138980",""],[5455,"نبض القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=34457",""],[5461,"يا سحايب سراة ابها","https://www.poetsgate.com/ViewPoem.aspx?id=8548",""],[5573,"يا سحابه حال قطرك دون شوفك سامحيني","https://www.poetsgate.com/ViewPoem.aspx?id=205472",""],[5736,"إن الذي سوّا السنا سوّاك","https://www.poetsgate.com/ViewPoem.aspx?id=203833",""],[5742,"رثاء الصفاء","https://www.poetsgate.com/ViewPoem.aspx?id=206959",""],[5939,"ثورة عاشق","https://www.poetsgate.com/ViewPoem.aspx?id=178590",""],[6075,"لقاءٌ ساحرٌ","https://www.poetsgate.com/ViewPoem.aspx?id=204403",""]],"verses":[["يا سحاب الرضا جودي على بلد","جرى بها اضرم الاعراض نيرانا",0,"ن",2,0],["يا سحرُ إنّ الذينَ قد زعَموا","أنّ المسمَّى سِوى اسمِهِ جَهِلوا",1,"ل",3,0],["يا سحرُكَم أَبتغي رِضاكِ وكم","أُغْضِي على حُرْقةٍ وأَحْتَمِل",1,"ل",1,0],["يا سحرُكم تَنْثَنِي الحفائِظُ بي","عليكِ والإِنتظارُ والمَهَل",1,"ل",1,0],["يا سحرُ إنّ السُّلُو عَنكِ على","قلبِي حرامٌ ما أُنْسئ الأَجَل",1,"ل",1,0],["يا سحبَ نيسان روّي الكرم من كرم","فَفي الحَباب غنىً عَن لؤلؤ الصَدفِ",2,"ف",1,0],["يا سحابَ الجفونِ جُودي بقطرِ الدْ","دَمعِ منّى صَدْراً من القلبِ قَفرا",3,"ر",2,0],["يا سحاباً حلَّتْ عزاليه هامَ الأك","م إذ وشحتْ متون البطاح",4,"ح",1,0],["يا سِحرُ واصِليني","فَإِنَّني عَميدُ",5,"د",1,0],["يا سِحرُ قَد جَرَّعتِني غُصَصَ الهَوى","كَدَّرتِ بِالهِجرانِ صَفوَ مَشارِبي",6,"ب",2,0],["يا سُحْبُ أجنحةُ الفُؤادِ تَكَسَّرَتْ","وَمَجادِفُ الكَلِمَاتِ لَمْ تَتَحَمَّلِ",7,"ل",1,0],["يَا سُحْبُ لي قَلبٌ تَجَاذَبَهُ الهَوَى","وهُمُومُ لَيَلٍ كالمَغارةِ أَلْيَلِ",8,"ل",1,0],["يا سحب جود الله عمي تربةً","ضمّت كريماً عمّنا فيه المصابْ",9,"ب",1,1],["يا سحاباً لريّ كل أوام","وشهاباً لرجم كل مريد",10,"د",1,0],["يا سِحرَ مطرانٍ وَحِكمَةَ حافِظٍ","لَكُما بَيانى خاضِعٌ مُستَسلِمُ",11,"م",1,0],["يا سحاباً مزمجراً ما رأينا","منه إلا رعوده وبروقه",12,"ق",2,0],["يا سُحب لَو شاهَدته يَومَ النَّدى","لحَقرت جودَك عِندَهُ وَنَداكِ",13,"ك",1,0],["يا سِحرَ خَطوَكِ إِذا تَمشينَ تابِعَةً","في الصُبحِ أُمَّكِ نَحوَ الحَقلِ في مَرَحِ",14,"ح",1,0],["يا سحب بلغ تحياتي وأخبرهم","أني على عهدهم عهدي وإيماني",15,"ن",2,0],["يا سحاب الندى إذا المحل أكدى","وسراج الهدى إذا الليل يغشى",16,"ش",2,0],["يا سحاباً بفيض جدواه فضلاً","طوق العالمين جيداً فجيدا",17,"د",2,0],["يا سِحرَ طَرفٍ وَحُسنَ وَجهٍ","لِلبَدرِ مِن نُورِهِ اِقتِباسُ",18,"س",1,0],["ياسحرَ ناهدةٍ سما أترابَهُ","فَلُربَّما من حور عَدْنٍ أنزلَكْ",19,"ك",1,0],["يا سحر أغنية واللّحن قافيتي","أسرجتها فاعتلت بي صهوة الشّبق",20,"ق",1,0],["يا سحر غاباتها تمتد في أفق","حول السهول وفي الآكام والمدر",21,"ر",1,0],["يا سِحْرَ أمنيتي، يا أيُّها السَّحَرُ","والغيثُ في شَفتي، والوجدُ والوطرُ",22,"ر",1,0],["يَا سِحرُ يا جمْرَ الكلامِ علَى فَميْ","يَا لوْعةً فيْ سَكْرتِيْ تنْهَارُ",23,"ر",1,0],["يا سحابهْ قْدرَها فوقْ السحاب","لا يصيبك باسْ يا بحر الندى",24,"د",2,1],["يَا سِحْرُ أَنْتِ ضِيَاءُ عَيْنِيَ لَا أَرَى","إِلَّا بِكُمْ دَرْبَ الهُدَى المُتَنَوَّرَا",25,"ر",2,0],["يَا سِحْرُ أَنْتِ سَوَادُ قَلْبِيَ فِي الصَّفَا","وَلَأَنْتِ عُمْرِي مَا النُّهَى قَدْ عَمَّرَا",25,"ر",2,0],["يا سِحْرَ بابِلَ تارةً","أجري لهُ وأطيرُ تارة",26,"ر",2,0],["يا سِحْر َ بابلَ حارَ الساحرونَ بِما","تُوحي رُقاك َ وأعيا سَعْيَهم رَهَقُ",27,"ق",1,0],["ياسحابه صيف منها مابعد شفت المطر","مغريه مثل الطموح ومشغله مثل القذا",28,"ذ",2,0],["يا سحايب سراة أبها تعديّ شمال","واستعيري دموعي سيّلي كل واد",29,"د",1,1],["يا سحابه حال قطرك دون شوفك سامحيني ​","مالمحتك لين ما اهديتك عيوني ياسحابه",30,"ب",2,1],["يا سحرَ عينٍ قد أطاح بمهجتي","إن الذي سوّا السَنا سوّاكا",31,"ك",2,0],["يا سحب صبي على أجداثهم غدقا","وبردي قبر من غطته أستارُ",32,"ر",1,0],["يا سِحْرَ طَلَّتِها: ما زِلتُ أَعشقُها","لكنَّها لنْ تَرَى في العينِ أحزاني",33,"ن",2,0],["يَا سِحْرَهَا قَلْبِي وَرُحِي مِلْكُهَا","أَتُرَاكَ يَا مَفْتُونُ قَدْ تَنْسَاهَا",34,"ا",3,0]]}