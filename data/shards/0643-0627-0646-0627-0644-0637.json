{"poems":[[55,"ذكرت على بعدها من منالي","https://www.aldiwan.net/poem29904.html","المتقارب"],[102,"ليلة فارس الغبار","https://www.poetsgate.com/ViewPoem.aspx?id=50434",""],[102,"ليلة فارس الغبار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67737&r=&rc=224",""],[164,"أيامنا بك كلها أعياد","https://www.aldiwan.net/poem58841.html","الكامل"],[185,"ألا يا سلم عوجى تخبرينا","https://www.aldiwan.net/poem58837.html","الوافر"],[310,"الدهر حرب بالرزايا الفجع","https://www.aldiwan.net/poem56486.html","الكامل"],[369,"إذا لم تقدرا أن تسعداني","https://www.aldiwan.net/poem60633.html","الوافر"],[487,"أسحر السحر في جفن الغزال","https://www.aldiwan.net/poem24467.html","عموديه"],[572,"وروض عن صنيع الغيث راض","https://www.aldiwan.net/poem69580.html","الوافر"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66779","الوافر"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35753","الهزج"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125478","الوافر"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106839","الكامل"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46741","الوافر"],[2758,"","https://poetry.dctabudhabi.ae/diwan/poem/31506","المتقارب"],[3291,"","https://poetry.dctabudhabi.ae/diwan/poem/106685","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91617","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216634","الطويل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40107","البسيط"],[5206,"حجر الفلاسفة","https://www.poetsgate.com/ViewPoem.aspx?id=187417",""],[5376,"بنا الأحزان بالآمال تترى","https://www.poetsgate.com/ViewPoem.aspx?id=191965",""],[5952,"الناس للناس","https://www.poetsgate.com/ViewPoem.aspx?id=207271",""],[549,"موسيقى مؤجَّلة","https://www.poetsgate.com/ViewPoem.aspx?id=202998",""]],"verses":[["كَأَنَّ الطَريدَ إِلى ظُلَّةٍ","يَمُدُّ بِعَلوٍ لِفاتَ الجِبالِ",0,"ل",1,0],["كان الطريق بلا يدين ، يقول ... خلطت يميني ، حكمني بشمالي","لا درب غيري ، منتهاي كأولي ... أنوي السؤال ، يردّ قبل سؤالي",1,"ل",2,0],["كان الطريق بلا يدين ، يقول","خلطت يميني ، حكمني بشمالي",2,"ل",2,0],["كان الطغاةُ إذا أثاروا فتنةً","ربحت تجارتهُم بها وأفادوا",3,"د",3,0],["كأنَّ الطَّيرَ عاكِفَةً عَلَيهِم","جُنُودٌ مِن سَوادِ الأَعجَمِينَا",4,"ن",2,0],["كانَ الطويلَ ذراعُهُ العالي الذرى","فَاِستَنزلته إِلى ثلاثة أذرعِ",5,"ع",1,0],["كأنّ الطّودَ غَيْظاً حينَ ألقَى","بإفكِهمُ الجَهولَ أخا افْتِتان",6,"ن",1,0],["كأن الطرس روض فيه","له حلل الخمائل من غوال",7,"ل",1,0],["كَأَنَّ الطَّلَّ مُنْتَثِرَاً عَلَيْهِ","بَقَايَا الدَّمْعِ فِي خَدِّ المَشُوقِ",8,"ق",1,0],["كأن الطير حولهم نضارعه","عُكوفاً حولَ صُلبانِ الأبيلِ",9,"ل",1,0],["كَأَنَّ الطَلَلَ المُلتَف","فَ في ثَوبِ البلى طِرسُ",10,"س",1,0],["كأن الطبَّ أعياهُ اعتلالي","وما ألقاهُ من فَرطِ الهُزَالِ",11,"ل",1,1],["كان الطيب فلم يفده وقد","صال الحمامُ وحارت الفكر",12,"ر",1,0],["كَأَنَّ الطائِفينَ بِها صَوادٍ","رأت رِيّا وَقَد وردت هُياما",13,"م",2,0],["كَأَنَّ الطِمِرَّةَ ذاتَ الطِما","حِ مِنها لِضَبرَتِهِ بِالعِقالِ",14,"ل",1,0],["كأنَّ الطُّيُورَ والغُصُونَ مَنَابِرٌ","أئِمَّةُ وعظٍ لِلقُلُوبِ فِصَاحُ",15,"ح",1,0],["كَأَنّ الطير فَوقَ الغصنِ تَهوي","كُراتٌ تُرتَمَى بالمنجنيق",16,"ق",1,0],["كأن الطلى بحر فمن خاض لجَّه","تعرّى فلا جند تُماز ولا شاه",17,"ا",2,0],["كَأَنَّ أَلطافَها تَجلو لأَعْيُنِنا","آثارَ أَلطافِ فَخرِ الدّينِ بالدّينِ",18,"ن",1,0],["كَأنَّ الطِّبَّ بُقْرَاطًا بِأحْوَى","حَوَى عِلمًا صَحِيحًا فَلْسَفِيَّا",19,"ي",2,0],["كأن الطيف في نومي سلام","تمر على فؤاد الحب قصرا",20,"ر",2,0],["كأن الطِّيْبَ منْبتُهُ فصيلته من الآس","له من ضَوْعِها عِرْقٌ لِعِرْقٍ فيه دساسِ",21,"س",1,0],["كان الطريقُ غريباً مثل سالكِهِ","ورغبةُ المشيِ قد فاضَتْ بها الرُّكَبُ",22,"ب",1,0]]}