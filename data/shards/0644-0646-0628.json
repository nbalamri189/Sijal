{"poems":[[90,"كفى بالعلم في الظلمات نورا","https://www.aldiwan.net/poem45002.html","الوافر"],[87,"يا أيها السائل ما الحرية","https://www.aldiwan.net/poem7765.html","الرجز"],[87,"على أي الجنان بنا تمر","https://www.aldiwan.net/poem63714.html","الوافر"],[47,"إنك والاحتفال في عذلي","https://www.aldiwan.net/poem65613.html","الخفيف"],[30,"وحلت بدهناها تميم وألجأت","https://www.aldiwan.net/poem5114.html","الطويل"],[113,"جل ما بي من الهوى","https://www.aldiwan.net/poem16457.html","مجزوء الخفيف"],[309,"مرحبا مرحبا بربع المصلى","https://www.aldiwan.net/poem16871.html","الخفيف"],[408,"ألمت فهاجت لوعة بفؤادي","https://www.aldiwan.net/poem46494.html","الطويل"],[563,"قضى الأمر وجف القلم","https://www.aldiwan.net/poem34195.html","الرمل"],[629,"","https://poetry.dctabudhabi.ae/diwan/poem/100587","المتقارب"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112450","المنسرح"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137719",""],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136132","الطويل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78179","الرمل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49577","الوافر"],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/177841","الطويل"],[1993,"","https://poetry.dctabudhabi.ae/diwan/poem/199041","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89562","البسيط"],[3589,"","https://poetry.dctabudhabi.ae/diwan/poem/34906","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111417","الخفيف"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125816","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133064","الوافر"],[4576,"","https://poetry.dctabudhabi.ae/diwan/poem/31392","الوافر"],[4717,"النمل .. وأزمة السكر","https://www.poetsgate.com/ViewPoem.aspx?id=199650",""],[4737,"التنوير","https://www.poetsgate.com/ViewPoem.aspx?id=212156",""],[4968,"تغريدة الكروان","https://www.poetsgate.com/ViewPoem.aspx?id=208101",""],[5277,"نبضةُ عشق","https://www.poetsgate.com/ViewPoem.aspx?id=186082",""],[5376,"بأيِّ الذنبِ ذاك الطفلُ يُقْتلْ","https://www.poetsgate.com/ViewPoem.aspx?id=196896",""],[5480,"ثوب الحداد","https://www.poetsgate.com/ViewPoem.aspx?id=10980",""],[5596,"تقريظ كتاب التاريخ الإباضي","https://www.poetsgate.com/ViewPoem.aspx?id=206483",""],[5842,"أيها الساسة \\ محمد حسام الدين دو","https://www.poetsgate.com/ViewPoem.aspx?id=152165",""],[5956,"لحل المشكلات","https://www.poetsgate.com/ViewPoem.aspx?id=194892",""],[5126,"زفرةُ أسى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87804&r=&rc=19",""]],"verses":[["لِنَبْتَدر العبور إلى المعالي","بحيث نطاول الشِعر العَبورا",0,"ر",2,0],["لَنبذلنَّ دونها ضحية","النفس والنفيس والذرّيه",1,"ي",2,0],["لِنَبهَجَ خاطِراً وَنَقَرَّ عَيناً","بِأَحسَنِ ما رَأى في البَحرِ سَفرُ",2,"ر",1,0],["لِنَبوَةٍ بي عَنِ الصِبا ثَلَمَت","جاهِيَ أَو كَبرَةٍ عَنِ الغَزَلِ",3,"ل",1,0],["لِنَبلُغَ خَيرَ الناسِ إِن بَلَغَت بِنا","مَراسيلُ خَرقٍ لا تَزالُ تُساوِرُه",4,"ر",2,0],["لِنَبي وَسَيدَ","بَلغ الأُفق فَاِستَوى",5,"و",2,0],["لنبي الهدى شفيع البرايا","خاتم الأنبياء والرسل كلا",6,"ل",2,0],["لَنَبَّهْتُهُمْ بالمدحِ لِلْجودِ والنّدى","وقد مُلِئَتْ أجفانِهُم برُقادِ",7,"د",1,0],["لنبي الله طه المصطفى","ما توالى من إلهي كرم",8,"م",1,0],["لنبك لها بمذاب القلوب","فما قدر أدمعنا المالحه",9,"ح",2,0],["لنبكهم جميعاً","بالمدمع المدرار",10,"ر",1,0],["لنبن صروحا بكل فؤاد","فنأمن من غائلات عواد",11,"د",1,1],["لنبل الهوى في القلب يا رب رمية","فلا تعجبوا إن مت من عشق عزة",12,"ه",1,1],["لِنَبيٍّ حازَ تَعريفاً فَلا","يَقتَضي لِلحال تَعريض وَشَرح",13,"ح",1,0],["لِنَبْكِ على بَقيَّةِ آلِ حَزْمٍ","عُيُونْهُمُ شَبَاباً أو كُهُولا",14,"ل",2,0],["لنبعث يوم البعث تحت لوائه","إذا الله من تلك الأماكن ناداه",15,"ه",1,0],["لنبكي دورا راعها قارع الردى","فأوجف منها ما تستقر وما علا",16,"ل",2,0],["لِنَبلُغَ الظِلَّ وَالمَرعى الخَصيبَ كَذا","الفَضلَ العَميمَ وَنَيلاً غَيرَ مَحسوبِ",17,"ب",1,0],["لَنَبَّأَها ذَوو أَحسابِ قَومي","وَأَعدائي فَكُلٌّ قَد بَلاني",18,"ن",2,0],["لِنَبثَ ثَمَّ لَهُ بِاِنتِظار","وَنَحوَ الأَغرِقِ بِالنَفسِ سار",19,"ر",1,0],["لِنَبلُوَ صَحبي صِدق كَلخَاسَ مُنبِئاً","بِما قد عَلِمتُم آيةٌ وأُعِيدُها",20,"د",3,0],["لِنبكِ على الماضي ونندب حظوطنا","لتبردَ نفسٌ هاج فيها سعيرها",21,"ر",3,0],["لنبقى في امانٍ واقترابٍ","إلى مرضاته فهو الرقيب",22,"ب",1,0],["لَنَبتَغِيَن بِحَربِ يَومِ عَدوٍ","تَرى فيهِ الكَواكِبَ بِالنَهارِ",23,"ر",1,0],["لنبْدأْ بتنفيذِ تلك المراحل","فذِي (لافتاتٌ لملحٍ) ... بدائلْ",24,"ل",1,0],["لنبقى كالدَّوابِ نعيشُ عَلفاً","على فضلاتِ أُكلِ الأقدمينا",25,"ن",2,0],["لنبوءةٍ ضاءت سماوة احرُف","بشروق شمس في علا التبيان",26,"ن",1,0],["لنبضك رعشةٌ تغري بقلبي","كداءٍ ليس يشفيه الدواءُ",27,"ا",2,0],["لِنبْضٍ قد تعلَّقَ في حياةٍ","فيقضي الموتُ منه ما تحلَّلْ",28,"ل",1,0],["لن بكت كلها بدية ما توّفيها الصدوف","ولن حكى نظم القوافي ما يكفينا ضماد",29,"د",1,0],["لنبي الله طه","خير داع قد اجابا",30,"ب",2,0],["لنبني حاضراً أسمى","بلا حقدٍ ولا ساسةْ",31,"س",2,0],["لنبنيَ خيرَ جيلٍ عالميٍّ","يصيرُ تراثَه صفوُ الضميرِ",32,"ر",1,0],["لنبذتها عمداً لأُصْبح جاهلاً","وينيلني جهلي أعزَّ مكان",33,"ن",1,0]]}