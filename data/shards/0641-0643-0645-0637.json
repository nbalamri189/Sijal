{"poems":[[79,"أخي فترة السلوان جاء رسولها","https://www.aldiwan.net/poem36371.html","الطويل"],[88,"أيحصي معانيك القريض المهذب","https://www.aldiwan.net/poem10695.html","الطويل"],[74,"إذا الله كافى منعما عن مقصر","https://www.aldiwan.net/poem20042.html","الطويل"],[68,"ألست ترى ما في العيون من السقم","https://www.aldiwan.net/poem41585.html","الطويل"],[82,"وخفاقة الرايات في جوف نقعها","https://www.aldiwan.net/poem31414.html","الطويل"],[79,"أفي فترة السلوان جاء رسلوها","https://www.poetsgate.com/ViewPoem.aspx?id=34154",""],[113,"إذا ما زرت أكناف المرام","https://www.aldiwan.net/poem16459.html","الوافر"],[154,"ألا فاذكروا المختار تحظوا بخيره","https://www.aldiwan.net/poem68598.html","الطويل"],[164,"ما لي وقد شبت في داعي الصبا أرب","https://www.aldiwan.net/poem58671.html","البسيط"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[203,"ألا لا تلمه اليوم أن يتألما","https://www.aldiwan.net/poem45633.html","الطويل"],[273,"عن العرب الصيد الألى أحرزوا العلى","https://www.aldiwan.net/poem69132.html","الطويل"],[382,"أيدري الدهر أيم الله أني","https://www.aldiwan.net/poem59430.html","الكامل"],[396,"جزى الله المصائب كل خير","https://www.aldiwan.net/poem54603.html","عموديه"],[412,"ألم وليلي بالكواكب أشيب","https://www.aldiwan.net/poem50207.html","الطويل"],[422,"قدمت فحياك المهيمن بندرا","https://www.aldiwan.net/poem53902.html","الطويل"],[445,"بحكم العدل من قاضي السماء","https://www.aldiwan.net/poem34836.html","الوافر"],[447,"يموت الصحيح ويحيا المصاب","https://www.aldiwan.net/poem14346.html","المتقارب"],[505,"جلا سر الغيوب لنا الصباح","https://www.aldiwan.net/poem37682.html","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37894","الطويل"],[1052,"","https://poetry.dctabudhabi.ae/diwan/poem/130870","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56265","الوافر"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26680","الوافر"],[1660,"","https://poetry.dctabudhabi.ae/diwan/poem/72161","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100963","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101045","الوافر"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87837","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/141734","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109382","البسيط"],[2565,"","https://poetry.dctabudhabi.ae/diwan/poem/103723","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100262","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202722","المتقارب"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109939","الطويل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132167","الوافر"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132087","الطويل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132168","المتقارب"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133281","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103000","الوافر"],[4110,"","https://poetry.dctabudhabi.ae/diwan/poem/101161","البسيط"],[4142,"","https://poetry.dctabudhabi.ae/diwan/poem/101332","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4680,"وهبتك العمر","https://www.poetsgate.com/ViewPoem.aspx?id=185008",""],[4767,"حصاد الخير","https://www.poetsgate.com/ViewPoem.aspx?id=88342",""],[4767,"موسم الأمطار","https://www.poetsgate.com/ViewPoem.aspx?id=180857",""],[4954,"كَفاني قَريضي مُؤْنِسًأ","https://www.poetsgate.com/ViewPoem.aspx?id=207724",""],[5397,"تدلت لأفنان النقا عذباتها","https://www.poetsgate.com/ViewPoem.aspx?id=157920",""],[5397,"على الربع دمعي أرسل المد لا الجزرا","https://www.poetsgate.com/ViewPoem.aspx?id=157921",""],[5411,"مَقام الْوَرْدِ","https://www.poetsgate.com/ViewPoem.aspx?id=196446",""],[5616,"الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=205217",""],[5736,"عناق","https://www.poetsgate.com/ViewPoem.aspx?id=208230",""],[5956,"لقبُ المظلوم","https://www.poetsgate.com/ViewPoem.aspx?id=183733",""],[5972,"متى مضر الحمراء تطلب ثارها","https://www.poetsgate.com/ViewPoem.aspx?id=170786",""],[6259,"ألمَّ وليلى بالكواكب أشيبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59357&r=&rc=5",""]],"verses":[["فَكَمْ طُحْلُبٍ يُخْفِي مِنْ الْمَاءِ صَفْحَةً","يَشِفُّ عَنْ الشَّيْءِ الْخَفِيِّ صَقِيلُهَا",0,"ل",3,0],["فَكَم طَلَبوا مِنهُم أَماناً فَأَمَّنوا","وَأَمسى لَهُم في الشَرقِ مَسرىً وَمَسرَبُ",1,"ب",1,0],["فكم طوق سنجابٍ سجعت بمدحه","فيا حسن طوق الساجع المترنم",2,"م",1,0],["فَكَم طَمِعوا في وِحدَتي فَرَمَيتُهُم","بِأَضيَقَ مِن سُمٍّ وَأَقتَلَ مِن سُمِّ",3,"م",1,0],["فَكَم طَعنَةٍ نَجلاءَ تَحسبها فماً","له هَرَتٌ في الذمر بالدمِ تَقْلِسُ",4,"س",1,0],["فكم طحلب مخف من الماء صفحة","يشف عن الشيء الخفي صقيلها",5,"ل",3,0],["فَكَم طارَحت مِن وَرقاء تَشدو","عَلى العَذبات فيهِ مِن الغَرام",6,"م",1,0],["فَكَم طابَ مِن قَلبٍ بَعد خُبثِهِ","دَرى الناسُ طُرّاً صِدقَهُ يَومَ بَعثهِ",7,"ه",1,0],["فكم طلبت ولم اظفر وكم ظفروا","بما طلبت وما جدوا وما طلبوا",8,"ب",3,0],["فَكَم طَعَنوا بالأشعريِّ إِمامنا","وَبالمُاتُريدي الحبر أكرِم بهِ حبرا",9,"ر",2,0],["فكم طللٍ قد باتَ يرثي لصحبهِ","ولو أنهُ استطاع الكلامَ تكلما",10,"م",2,0],["فَكَم طَعنَة بكرٍ يَطيرُ رَشاشُها","لِفِتيانِهِم وَالحَربُ شَمطاءُ عانِسُ",11,"س",1,0],["فكم طوتِ الثرى منا أناساً","وكم محتِ الدنا ذكراً وفخرا",12,"ر",2,0],["فكم طى المصايب من خيور","حسان عاليات غاليات",13,"ت",1,0],["فَكَم طَيبٍ تُغني وَعَلياء تَقتَني","ومكرمة تؤوي وَمال تُغرِّبُ",14,"ب",1,0],["فكم طائل قد رامهم بخديعةٍ","ولكنَّه ما طال إلاَّ وقصَّرا",15,"ر",2,0],["فكَمْ طَلَبُوا الأَمَانِي بالأَمانِي","وكم باعُوا السَّعادَةَ بِالشَّقَاءِ",16,"ا",2,0],["فكم طالبٍ بالعتاب الرضى","فأورثه السخط ذلك العتاب",17,"ب",1,0],["فكم طبقات أقوامٍ عليها","بأثواب الفناء أتوا وراحوا",18,"ح",3,0],["فَكَم طالِبٍ ضَنَّتْ عليهِ بِحُسنها","وقد رُدَّ عن نَيل المُنى وهو خائِبُ",19,"ب",1,0],["فكم طحنت قوما بجؤجؤ صدرها","وما أصلحت يوما دقيقا ولا طحنا",20,"ن",2,0],["فكم طبنا بعودته قلوباً","وبتنا في الحديث له نعاتبْ",21,"ب",1,0],["فكم طلب العويصَ فما تأبّى","وكم قلبَ العيانَ فما استحالا",22,"ل",2,0],["فَكَمْ طَامِعٍ فِي حَاجَةٍ لا يَنالُها","وَكَمْ بَائِسٍ مِنْهَا أَتَاهُ بَشِيرُها",23,"ر",3,0],["فكم طحَنت في ساحة الموت فيلقاً","لصولتها الأسد الضراغم ترهَب",24,"ب",1,0],["فكم طابت به للحق نفس","بطيبة حين أوطنها مقاما",25,"م",2,0],["فَكَم طِفلَةٍ تَبكي أَباها وَقَد قَضى","بَعيداً عَنِ الأَوطانِ لَيسَ لَهُ جُرمُ",26,"م",1,0],["فكم طاهرٍ لم يتَّصِف بطهارةٍ","إذا جاور البحر اللدنيّ واحتمى",27,"ا",1,0],["فكم طغى بالغنى ذو ثروةٍ وبغى","في الأرض وهوبه خالٍ من الوزر",28,"ر",1,0],["فكم طيها من فائت متردم","يهز بما معطف الصلد",29,"د",1,0],["فكم طعنةٍ نجلاء منهم تخاوصت","إليها بنو الزرقاء بالأعين الرمدِ",30,"د",1,0],["فكم طرفةٍ وحديثِ هوى","تكاد تغيب بقلب الزمن",31,"ن",1,0],["فكم طامعٍ بالعيش اصبحَ ناسكاً","لِأَن عادَ سِيماهُ الزَهادةُ والزُهدُ",32,"د",1,0],["فكم طربوا لنغمته ومالوا","كما مال الحساة من المدام",33,"م",1,0],["فكم طعنتك الحادثات وصوّبت","إلى صدرك المرزوء صدر قاة",34,"ه",1,0],["فكم طلع الفجر ثم انقضى","وعاد وعدت فلم تطلعي",35,"ع",2,0],["فكم طوى واسع البيداء مدرعا","درعا من الصبر في مجد وأغوار",36,"ر",1,0],["فكم طير بنى في الجوّ بيتاً","فأسلمته إلى الشرك اغتيال",37,"ل",1,0],["فكم طرقت فتاة الحي يصحبني","مهند غير هياب ولا وكل",38,"ل",1,0],["فكم طبقت بالحزن شجواً لنازل","يزلزل منها سهلها وأكامها",39,"م",3,0],["فَكَم طُلىً مِنهُم بِهِنديٍّ فَرَى","وَكَم حَشى مِنهُم بِخطِّيٍّ حَشَا",40,"ا",1,0],["فكم طغى ليلك الداجي وما برحت","تستصرخ الفجر في جوف الظلام قرى",41,"ر",2,0],["فكم طويت داجيات لها","وما رأيت في العنا بأسا",42,"س",2,0],["فكم طريقٍ سُد بالماء الذي","جرى كماءِ مَنبعٍ فوَّار",43,"ر",1,0],["فكمْ طالَبتْ نفْسِي بنِسيانِ حبّها","وما ذنْب نفْسِي إذْ خليلِي قلانِيَا",44,"ي",2,0],["فكم طلبت في جهدها النفس منية","ولم تدن يوما بالمنى طلباتها",45,"ت",3,0],["فكم طرقتني للحوادث ساعة","على قصر منها تخيلتها الدهرا",46,"ر",2,0],["فَكَمْ طَلعتْ َوكَمْ غَرُبَتْ","شُموسُ الحُبّ يا سارهْ!!",47,"ر",2,0],["فكمْ طعنةٍ جاءَتْ إليَّ من العِدا","وأُخرى رماها وهوَ كالضبِّ صاحِبُ",48,"ب",1,0],["فكم طَعِمتْ شفاهي الصبرَ مرًا","متى ما لاكَ مهجتك احتراقُ",49,"ق",1,0],["فكم طبَّقتُ هذا الاسم حقاً","لأنه من مبادئيَ الصَّوابُ",50,"ب",1,0],["فكم طفلة لما أقيمت بخدرها","عليها العدى قامت تؤجج نارها",51,"ر",3,0],["فكم طيّب تفني وعلياء تقتني","ومكرمة ٍ تؤوي ومال تغرب",52,"ب",1,0]]}