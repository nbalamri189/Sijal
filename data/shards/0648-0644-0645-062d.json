{"poems":[[86,"أي رجال الدنيا الجديدة مدوا","https://www.aldiwan.net/poem10922.html","الخفيف"],[93,"ألطائر العالي مراده","https://www.aldiwan.net/poem11144.html","السريع"],[51,"ضرطة إبراهيم في البربخ","https://www.aldiwan.net/poem9990.html","السريع"],[91,"روحي التي بالأمس كانت ترتع","https://www.aldiwan.net/poem8723.html","عموديه"],[91,"أنا لست بالحسناء أول مولع","https://www.aldiwan.net/poem8980.html","عموديه"],[91,"شاهدتها كالميت في أكفانه","https://www.aldiwan.net/poem62809.html","عموديه"],[74,"ألا إنها سن تزيد فأنقص","https://www.aldiwan.net/poem12975.html","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30433","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54303","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54252","الخفيف"],[91,"الكمنجة المحطّة","https://www.poetsgate.com/ViewPoem.aspx?id=53389",""],[94,"ما شأن هذا الأشعث الجواب","https://www.poetsgate.com/ViewPoem.aspx?id=15610",""],[132,"أقلب لا يزال ولن يزولا","https://www.aldiwan.net/poem54776.html","الوافر"],[150,"صدروا وسحر لحاظهم يغريني","https://www.aldiwan.net/poem68480.html","الكامل"],[261,"أعطى سرائرك النحول اللوما","https://www.aldiwan.net/poem38193.html","الكامل"],[281,"بالسعد طالعك المهل","https://www.aldiwan.net/poem1380.html",""],[453,"ترفع عن معاداة الكريم","https://www.aldiwan.net/poem61339.html","الوافر"],[479,"وافى لصنوه شاعر يوما فما","https://www.aldiwan.net/poem37005.html","الكامل"]],"verses":[["وَلَمَحنا مِن نورِكُم في نَواصي","حَفلَةِ اليَومِ لَمعَةً وَشُعاعا",0,"ع",2,0],["ولمحت ما تحت العبوسة","من شجى تورى زناده",1,"د",2,0],["ولِمْ حَكَيْتَ القردَ في قُبْحه","والقردُ ممسوخٌ ولم تُمْسَخِ",2,"خ",1,0],["وَلَمَحتُ نارَ الوَحيِ في عَينَيكِ","وَالوَحيُ كانَ سُلافَةَ الأَرواحِ",3,"ح",1,0],["وَلَمَحتُ وامِضَةَ البُروقِ فَخِلتُها","فيها فَلَم تَكُ في البُروقِ اللُمَّعِ",4,"ع",1,0],["وَلَمَحتُ أَحلامَ الشَبابِ مَواكِباً","تَتَرى أَمامي وَالهَوى حاديها",5,"ي",3,0],["وَلَمحَةِ عَيشٍ بَينَ كَأسٍ رَوِيَّةٍ","تُدارُ وَظَبيٍ بِاللِوى يَتَقَنَّصُ",6,"ص",1,0],["ولَمَحْتُ إِخْوَانِي لَدَيْكَ كأَنَّهُمْ","مِمّا رَفَعْتَهُمُ نُجُومُ سَماءِ",7,"ا",2,0],["ولمحتُ رَيْحانَ الصبا فرأيتُه","ذَبُلَتْ نضارتُه على الأقداح",8,"ح",1,0],["ولمحنا بجانبيه أُناساً","قُتِلوا ذِلَةً وماتوا هوانا",9,"ن",2,0],["ولمحت أحلام الشّباب مواكبا","تتلاى أمامي والهوى حاديها",10,"ي",3,0],["ولمحت فيه جلال حسنك راقدا","فوق الشفاه اللّعس والأهداب",11,"ب",1,0],["ولَمحَةً بَارِقٍ وسَوادَ لَيلٍ","كَلَيلِ المُغرَمِ المُهتَاجِ طُولا",12,"ل",2,0],["ولمحت من نعمان ما يشفيني","ورأيت من يبرين ما يبريني",13,"ن",2,0],["ولمحكم التقدير أمر مبرم","أو ينقض التدبير أمراً مبرما",14,"م",2,0],["ولمحت منه مخايلا","للفخر قلن افخر وخل",15,"ل",1,0],["ولمحات النجوم وراء سحب","كستر الجود من كف الكريم",16,"م",1,0],["ولمحت في إحدى المفاوز زهرة","كسيت ذبولا واشتكت فيه الظما",17,"م",2,0]]}