{"poems":[[88,"أي رجال الدنيا الجديدة مدوا","https://www.aldiwan.net/poem10922.html","الخفيف"],[95,"ألطائر العالي مراده","https://www.aldiwan.net/poem11144.html","السريع"],[53,"ضرطة إبراهيم في البربخ","https://www.aldiwan.net/poem9990.html","السريع"],[93,"روحي التي بالأمس كانت ترتع","https://www.aldiwan.net/poem8723.html","عموديه"],[93,"أنا لست بالحسناء أول مولع","https://www.aldiwan.net/poem8980.html","عموديه"],[93,"شاهدتها كالميت في أكفانه","https://www.aldiwan.net/poem62809.html","عموديه"],[76,"ألا إنها سن تزيد فأنقص","https://www.aldiwan.net/poem12975.html","الطويل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30433","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54303","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54252","الخفيف"],[93,"الكمنجة المحطّة","https://www.poetsgate.com/ViewPoem.aspx?id=53389",""],[96,"ما شأن هذا الأشعث الجواب","https://www.poetsgate.com/ViewPoem.aspx?id=15610",""],[136,"أقلب لا يزال ولن يزولا","https://www.aldiwan.net/poem54776.html","الوافر"],[154,"صدروا وسحر لحاظهم يغريني","https://www.aldiwan.net/poem68480.html","الكامل"],[266,"أعطى سرائرك النحول اللوما","https://www.aldiwan.net/poem38193.html","الكامل"],[286,"بالسعد طالعك المهل","https://www.aldiwan.net/poem1380.html",""],[458,"ترفع عن معاداة الكريم","https://www.aldiwan.net/poem61339.html","الوافر"],[484,"وافى لصنوه شاعر يوما فما","https://www.aldiwan.net/poem37005.html","الكامل"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/67007","الطويل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87835","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77300","الكامل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106987","الكامل"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/46870","الوافر"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102958","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103026","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90903","الرمل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90884","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81287","البسيط"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81946","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81722","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72710","الكامل"],[4755,"ولَقَد رَأَيتُ.. لَقَد رَأَيتُ مُحَالا","https://www.poetsgate.com/ViewPoem.aspx?id=184349",""],[4782,"شطر الرياحين","https://www.poetsgate.com/ViewPoem.aspx?id=214684",""],[4830,"أذكى الحياءُ","https://www.poetsgate.com/ViewPoem.aspx?id=200328",""],[585,"يا جيرة البان مهلاً واسألوا البانا","https://www.poetsgate.com/ViewPoem.aspx?id=161926",""],[585,"مهلاً فلست بجاحدٍ أو عات","https://www.poetsgate.com/ViewPoem.aspx?id=161934",""],[1043,"المرقص الدائر","https://www.poetsgate.com/ViewPoem.aspx?id=94867",""],[5348,"الرحيل إلى شواطيء الأحلام .","https://www.poetsgate.com/ViewPoem.aspx?id=59564",""],[5419,"قرأت حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=32231",""],[5431,"ويُقسم ثغره أن ترشِفا !!","https://www.poetsgate.com/ViewPoem.aspx?id=195229",""],[5455,"في خاطري كلمتين","https://www.poetsgate.com/ViewPoem.aspx?id=34366",""],[5461,"فر رثاء والده الملك فيصل","https://www.poetsgate.com/ViewPoem.aspx?id=5232",""],[5490,"حديث الأمس","https://www.poetsgate.com/ViewPoem.aspx?id=176287",""],[5493,"أمي غادرتُها","https://www.poetsgate.com/ViewPoem.aspx?id=197573",""],[5653,"مساعيك في نحر العدو سهامُ","https://www.poetsgate.com/ViewPoem.aspx?id=26447",""],[2599,"فى وداع شوقى","https://www.poetsgate.com/ViewPoem.aspx?id=14004",""],[5770,"طار الحمام","https://www.poetsgate.com/ViewPoem.aspx?id=178360",""],[6102,"كبرياء","https://www.poetsgate.com/ViewPoem.aspx?id=184856",""],[6125,"سلامٌ لقلبي المُفَدَّى سلامْ","https://www.poetsgate.com/ViewPoem.aspx?id=212867",""],[6210,"ألق السلام على القباب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78228&r=&rc=20",""],[6314,"المهدية المنتظِرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88075&r=&rc=10",""],[6337,"واهاً لسحركِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81412&r=&rc=24",""]],"verses":[["وَلَمَحنا مِن نورِكُم في نَواصي","حَفلَةِ اليَومِ لَمعَةً وَشُعاعا",0,"ع",2,0],["ولمحت ما تحت العبوسة","من شجى تورى زناده",1,"د",2,0],["ولِمْ حَكَيْتَ القردَ في قُبْحه","والقردُ ممسوخٌ ولم تُمْسَخِ",2,"خ",1,0],["وَلَمَحتُ نارَ الوَحيِ في عَينَيكِ","وَالوَحيُ كانَ سُلافَةَ الأَرواحِ",3,"ح",1,0],["وَلَمَحتُ وامِضَةَ البُروقِ فَخِلتُها","فيها فَلَم تَكُ في البُروقِ اللُمَّعِ",4,"ع",1,0],["وَلَمَحتُ أَحلامَ الشَبابِ مَواكِباً","تَتَرى أَمامي وَالهَوى حاديها",5,"ي",3,0],["وَلَمحَةِ عَيشٍ بَينَ كَأسٍ رَوِيَّةٍ","تُدارُ وَظَبيٍ بِاللِوى يَتَقَنَّصُ",6,"ص",1,0],["ولَمَحْتُ إِخْوَانِي لَدَيْكَ كأَنَّهُمْ","مِمّا رَفَعْتَهُمُ نُجُومُ سَماءِ",7,"ا",2,0],["ولمحتُ رَيْحانَ الصبا فرأيتُه","ذَبُلَتْ نضارتُه على الأقداح",8,"ح",1,0],["ولمحنا بجانبيه أُناساً","قُتِلوا ذِلَةً وماتوا هوانا",9,"ن",2,0],["ولمحت أحلام الشّباب مواكبا","تتلاى أمامي والهوى حاديها",10,"ي",3,0],["ولمحت فيه جلال حسنك راقدا","فوق الشفاه اللّعس والأهداب",11,"ب",1,0],["ولَمحَةً بَارِقٍ وسَوادَ لَيلٍ","كَلَيلِ المُغرَمِ المُهتَاجِ طُولا",12,"ل",2,0],["ولمحت من نعمان ما يشفيني","ورأيت من يبرين ما يبريني",13,"ن",2,0],["ولمحكم التقدير أمر مبرم","أو ينقض التدبير أمراً مبرما",14,"م",2,0],["ولمحت منه مخايلا","للفخر قلن افخر وخل",15,"ل",1,0],["ولمحات النجوم وراء سحب","كستر الجود من كف الكريم",16,"م",1,0],["ولمحت في إحدى المفاوز زهرة","كسيت ذبولا واشتكت فيه الظما",17,"م",2,0],["ولَمْحُكَ يُرْدِي القِرْنَ وَهْوَ مُدَجَّجٌ","وذِكْرُكَ يَُْنِي الجَيْشَ وَهْوَ لُهامُ",18,"م",1,0],["وَلَمَحتُ في زُهرِ النُجومِ جَمالَها","وَسُقيتُ بِنتَ الحانِ مِن ميزابِها",19,"ب",3,0],["وَلَمَحتُ ضوءَ الشَمسِ فيكِ مُوَدِّعاً","كَيَدِ المَليحَةِ أَومَأَت بِخِضابِ",20,"ب",1,0],["ولمحته والنجم من أقراطه","قد لاح فوق قميصه المزرور",21,"ر",1,1],["وَلِمْ حَلأتُمُونِي حينَ لاحَتْ","لِوِرْد السَلْسبيلِ بِه السَّبيلُ",22,"ل",1,0],["ولمحت منها كالسراب مطامعا","لم يغن موردها عن الوراد",23,"د",1,0],["ولمحت من شفتيه عذبا سائغا","كالراح تلمع من خلال دنان",24,"ن",1,0],["ولمحمود المزايا ارخي","رتبة أولى بها الانس سما",25,"م",2,0],["ولمحي الدين الفتى شبله كن","عبد رق ترقى على كيوان",26,"ن",1,0],["وَلَمحة مِن تَزاويق الصِبا عَبرت","دُنياي كَالسحر لَم أَحفَل بِها أَبَدا",27,"د",2,1],["ولمحة نجم أم إنارة مغرم","سنى قبس والحي ليس بظاعنِ",28,"ن",1,0],["ولمحتُ غُرَّةَ قائم متهلل","يسطو بصرفِ الحادث المتجهم",29,"م",1,0],["ولمحت رمان النهوط فبادرت","عيني تثلث جلنار نهودها",30,"د",3,0],["ولَمَحْتُ سَطرًا غامِضًا لَم تَكتَمِل","فيهِ الحُرُوفُ لِكي يَكونَ سؤالا",31,"ل",2,0],["ولمحة الحسن في سيماك متخذًا","تاج القريحة لا تاج السلاطين",32,"ن",1,0],["وَلمَحتُ عينَكَ أبرَقتْ في مُهجتي","شوقاً يلحُّ علَيَّ بالعبراتِ",33,"ت",1,0],["ولمحةً شزرةً أو لفتة ثقلت","عليك أو خلقاً وعراً وخذلانا",34,"ن",2,0],["ولمحت منها فوق لدن غصونها","طيراً يطل مدلّه اللفتات",35,"ت",1,0],["ولمح الحبيب الرحيم تبل","ج أم ومضة الفاتك الظافر؟!",36,"ر",1,0],["ولَمَحْتُ أَوراقَ الخريفِ يَجُرُّهَا","مِن خلفهِ ذيلُ النسيمِ الهَادِي",37,"د",2,0],["ولمحتُ وجهكِ صدفةً فاهتزّ بحر","قصيدتي وتصدعت أبياتي !",38,"ت",2,0],["ولمحتُ في عين السماء غزالتي","والعشب ينمو بالسرير تعففا",39,"ف",2,0],["ولمحت زوله من أقصى الدرب لافيني","مدري وش اقول لكن حي ها اللافي",40,"ف",2,0],["ولمحت في غور العيون تساؤلاً","هل أنجب الرجل العظيم رجالاً",41,"ل",2,0],["ولُمّ حُطامَ حلْم العمر وارفع","بوادٍ مُقفر الجنّات رُكنا",42,"ن",2,0],["ولمحتُ بسمةَ وجهِهَا تُخفِي بهَا","حزنَ النّوَى والعينُ فيهِ تَهيمُ",43,"م",1,0],["ولمحك يردي القرن وهو مدججٌ","وذكرك يثني الجيش وهو لهامُ",44,"م",1,0],["ولمحت أسراب الطيور حزينة ً","خرساء لا شدوا ولا ترتيلا",45,"ل",2,0],["ولمحتُهُ في أوج نشوتِهِ","يطوي الفِجاج ويمتطي السُحبا",46,"ب",2,0],["وَ لَمَحتُها ؛ كَالنُّورِ تَقتَحِمُ الدُّجَى","فَتَدُكُّهُ ؛ فَتُشَعشَعُ الآفاقُ",47,"ق",1,0],["ولمحُ العيونِ التي جرَّعَتْني","عذاباً ولون العذابِ غَرامْ",48,"م",1,0],["ولمحت طيف الفاتحين معاتباً","والأفق رايات تقود صهيلا",49,"ل",2,0],["ولمحتُ طيف الفجر عرَّى جسمه","يهوي على حضن الغياب ويذرفُ",50,"ف",1,0],["ولمحتُ أشلائي تحجُّ بحُلمِها","وتفور وجداً غالبَ الإحباطا",51,"ط",2,0]]}