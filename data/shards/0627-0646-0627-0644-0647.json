"إلا المهند إن لمع",148,"ع",1,0],["إن الهدى لا يستقي","م بشيمة الحب الخدع",148,"ع",1,0],["إنَّ الهمومَ تحيطُ بى يا سيِّدى","لكنَّ ذكرَكَ يا حبيبُ يُبَدِّدُ",149,"د",1,0],["إنَّ الْهَوَى فَارِقٌَ قَالتْ دَعَائِمُهُ","مَنْ يَنْتَمِي قَلبُهُ بِالْحُبِّ أَرْوَاكِ",150,"ك",1,0],["إن الهواء إذا رقت مناسمه","في بلدة لطفت أخلاط أهليها",151,"ي",3,0],["إنّ الهوى قدرٌ يسري بهِ دمنا","ما قد عرفنا لهُ أصلاً وعنوانا",152,"ن",2,0],["إن الهموم مدينتي لكنّها","أقصايَ يبقى حزنها قتّالُ",153,"ل",1,0],["إِنَّا لَهُ وَإِلَيْهِ","يَا أُمَّةَ اَلْإِسْلَامِ ...",154,"م",1,0],["إِنَّ الْهَوَى تَشْتَاقُ فِيهِ حِكَايَةٌ","لِمَلَاحِمٍ تَرْوِي لَهَا التِّفْصَالاَ",155,"ل",2,0],["إن الهوى جوهره واحد","لا يقبل القسمة أزلاما",156,"م",2,0],["إن الهوى غيرُ الهوانِ وإنما","لُغةُ الجمالِ...الوردُ بالأشواكِ",157,"ك",1,0],["إن الهوى،مِن عندنا، بلغ العُلا :","عُرْس االأحبة أشعل الأقباسا",158,"س",2,0],["إن الهوى لهو السمو","م فمن يذقه يمت سليما",159,"م",2,0],["إن الهزيمة باضت بين أجنحتي","وأفرخ البيض قيدا ليس ينكسر",160,"ر",1,0],["إنَّ الهواية َ تُغنيني وتَرفدني","ذوقا ً وحسَّا ً، فيحلو الطبعُ في ذاتي",161,"ت",2,0],["إنَّ الهواياتِ لا تنمو بمجتمع ٍ","تعيشُ أجيالهُ باللا مبالاةِ",161,"ه",1,0],["إنّ الهوى في طبعه متقلبٌ","والقلبُ يهوى من ترومُ خداعي",162,"ع",2,0],["إنّ الهدايةَ في الدجى","أنْ تستقيم على المسارْ",163,"ر",1,0],["إنَّ الهِدايَةَ خُطوَةٌ أُولَى عَلَى","دَربِ النَّجاةِ تَرُدُّها الأقدامُ",164,"م",1,0],["إنّ الهلال يُرَى حتماً فقلت لهم","حتَمْتُمُ بشَتات بين جلاّسي",165,"س",2,0],["إنَّ الهَوى إحْساسُ قَلْبٍ مُدْنَفٍ","وَهُوَ الشُّعورُ وَ لا يُباع وَيُشْتَرى",166,"ر",2,0],["إن الهوى من نور عينك نازلُ","وله من الدمع الغزير منازلُ",167,"ل",1,1],["إنّ الهوى ماكان يوما جملة","تصف الهيام بدمعةٍ قد تشْرِقُ",168,"ق",1,0],["إنّ الهوى طيبٌ يؤلف بيننا","فيه الحنان مهيمنٌ متدفقُ",168,"ق",1,0],["إن الهوى شريان عالمنا","ماعاش من بالحب يقتصدُ",169,"د",1,0],["إنّ الهمام الذي قد باع صهوته","أمست ممالكه دون الأصاحيب",170,"ب",1,0],["إنَّ الهروب إذا استطعت فضيلة","أو فالمصير وليمة دون ارتياب",171,"ب",1,0],["\" أنا لها \" ضَارِعًا يَرْجُو لأمّته","طَوْقَ الخَلاَصِ ، وَ مَا مِنْ شَافِعٍ نَطَقَا",172,"ق",2,0],["إنّ الهوى كالوغى بالهول مسْتعرٌ","تهفو الكماةُ له شوقًا فيهناها",173,"ا",3,0],["انا له الجا من ابوه ودناياه","ويكن لي حب على الناس يخفيه",174,"ي",2,0],["إن الهوى يقضي بكل مهانة","حينا على أربابه الاغمار",175,"ر",1,0],["إنا لهذا اليوم عشنا دهرنا رهنَ الإشارة","ولأجله متنا بساح السجن أوهَينا جداره",176,"ر",2,0],["إنَ الهوى يقضي بكلِّ غوايةٍ","فاكبحْ هواكَ عنِ الفؤادِ تَجَسُّرا",177,"ر",2,0],["إِنَّ الهَزِيمَةَ قَدْ فَلَّتْ قُلُوبَهَمُ","كُلُّ العَزَائِم خَارَتْ دُونَ مُعْتَصَمِ",178,"م",1,0],["إن الهوى جرح يذوب بخافقي","منه النّياط على المدى تتقطع",179,"ع",1,1],["أَنَالَهُمُ ما لم يُنِلكُمْ إلهُهم","فكُلُّكُمُ بَادي العَدَاوةِ حَاسِدُ",180,"د",1,0],["5-إن الهوى التذكار للمجد الذي","ضاعت عواطره لتبعث فانيا",181,"ي",2,0],["أَنا لَها ؛ وَ هْيَ لِي ؛ قَلبانِ تَجمَعُنا","رُوحٌ تَرَدَّدُ شَرقِي ؛ وَ هْيَ تَغتَرِبُ",182,"ب",1,0],["أناله نيل هارون النبي من الكلي","مِ طولاً وإعظاماً وتابيها",183,"ي",3,0],["إِنَّ الهَوى كَالشُّهبِ في أَطوارِهِ","يَخبو وَيتبَعُهُ شِهابٌ تالِ",184,"ل",1,0],["إن الهوى ضدُّ العقول لأنهُ","ضريت جآذرهُ على آساده",185,"د",2,0],["أنا لهفةُ المحرومِ والظمآنِ والجوعانِ","شِعريَ للأسى يَتَعَصَّبُ",186,"ب",1,0],["إنَّ الهُمُومَ وَإنْ خَفَّتَ مَحَامِلُهَا","لَيْلٌ على لَهبِ الأبْصَارِ مُعْتَكِرُ",187,"ر",1,0],["إن الهوى ناسجٌ أكفانَ حامِلِهِ","فحاذري أن يُحاكَ اليومَ بُرْداكِ!",188,"ك",1,0]]}