{"poems":[[53,"لا أشتكي ضري من","https://www.aldiwan.net/poem29805.html","مجزوء الكامل"],[53,"قضت المنازل يوم كاظمة","https://www.aldiwan.net/poem29962.html","الكامل"],[63,"نأى بجانبه والصبح مبتسم","https://www.aldiwan.net/poem46133.html","البسيط"],[55,"قد كنت أرجو وصلكم","https://www.aldiwan.net/poem26548.html","مجزوء الكامل"],[77,"إن الهوى لشكاية معروفة","https://www.aldiwan.net/poem36655.html","الكامل"],[27,"إن الهجيم قبيلة مخسوسة","https://www.aldiwan.net/poem4442.html","الكامل"],[27,"قل للديار سقى أطلالك المطر","https://www.aldiwan.net/poem5764.html","البسيط"],[27,"ما هاج شوقك من عهود رسوم","https://www.aldiwan.net/poem6009.html","الكامل"],[23,"إن الهدايا تجارات اللثام وما","https://www.aldiwan.net/poem21621.html","البسيط"],[51,"من ذا رأت عيناه مثلي في الشجا","https://www.aldiwan.net/poem9239.html","الرجز"],[51,"ضربتها عنك صفحا بعدما لحقت","https://www.aldiwan.net/poem66527.html","البسيط"],[85,"تلك الطبيعة قف بنا يا ساري","https://www.aldiwan.net/poem63715.html","الكامل"],[43,"أجاب دمعي وما الداعي سوى طلل","https://www.aldiwan.net/poem9943.html","البسيط"],[43,"لا خيل عندك تهديها ولا مال","https://www.aldiwan.net/poem10136.html","البسيط"],[62,"إن الهواء به الحياة","https://www.aldiwan.net/poem52230.html","مجزوء الكامل"],[62,"نظري إلى لمع الوميض حنين","https://www.aldiwan.net/poem52265.html","الكامل"],[45,"إني تركت الصبا عمدا ولم أكد","https://www.aldiwan.net/poem63458.html","البسيط"],[45,"ليت الخليط الذي قد بان لم يبن","https://www.aldiwan.net/poem66670.html","البسيط"],[28,"أبلغ معاوية الذي بيمينه","https://www.aldiwan.net/poem5603.html","الكامل"],[61,"أخلت أن جنابا منك يجتنب","https://www.aldiwan.net/poem51814.html","البسيط"],[66,"لا تهد شيئا لم يكن حسنا","https://www.aldiwan.net/poem38535.html","الكامل"],[107,"كم أظهر العشق من سر","https://www.aldiwan.net/poem58554.html","عموديه"],[80,"لو أن ربع غير مندرس","https://www.aldiwan.net/poem31407.html","البسيط"],[44,"قف بالطلول الدارسات علاثا","https://www.aldiwan.net/poem30565.html","الكامل"],[50,"أعبيد يا ذات الهوى النزر","https://www.aldiwan.net/poem63818.html","الكامل"],[50,"يا صاح قم فاسقني بالكأس إعرابا","https://www.aldiwan.net/poem64847.html","البسيط"],[50,"ومريضة مرض الهوى","https://www.aldiwan.net/poem64862.html","مجزوء الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85300","الكامل"],[44,"","https://poetry.dctabudhabi.ae/diwan/poem/1312","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16623","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54521","الكامل"],[115,"عربد بالافكار راح الهوى","https://www.aldiwan.net/poem41184.html","عموديه"],[120,"أبليت فيك العمر وهو جديد","https://www.aldiwan.net/poem49351.html","الكامل"],[124,"بالنفس يا شيخ من تقواك أشياء","https://www.aldiwan.net/poem23734.html","البسيط"],[128,"أنت الحبيب المرتضى ولك الهنا","https://www.aldiwan.net/poem50490.html","الكامل"],[142,"قد رجع الحق إلى نصابه","https://www.aldiwan.net/poem58439.html","الرجز"],[143,"لا فات ملكك ما أعيا به الطلب","https://www.aldiwan.net/poem11730.html","البسيط"],[185,"إن الخلافة لم تزل عن أصلها","https://www.aldiwan.net/poem14645.html","الكامل"],[185,"كم قدر ما أخفي الهون وأصون","https://www.aldiwan.net/poem14687.html","الكامل"],[186,"اصبر على كل ما جاء الزمان به","https://www.aldiwan.net/poem44120.html","البسيط"],[198,"ألا اقصري لا أطيع العذل في رشأ","https://www.aldiwan.net/poem51911.html","البسيط"],[204,"نفس المحب دواؤها في دائها","https://www.aldiwan.net/poem53154.html","الكامل"],[211,"إن الهدايا التي راعتك قد ضمنت","https://www.aldiwan.net/poem46329.html","البسيط"],[211,"مرت الأيام والروح الحزين","https://www.aldiwan.net/poem46613.html","الرمل"],[223,"كان شفيق لم يزل مختلي","https://www.aldiwan.net/poem39703.html","السريع"],[229,"يا كانيا عن دمعه","https://www.aldiwan.net/poem50932.html","مجزوء الكامل"],[261,"حتام لا ينثني الجموح","https://www.aldiwan.net/poem38346.html","مخلع البسيط"],[270,"هلا وفيت كما وعدت حزينا","https://www.aldiwan.net/poem35582.html","الكامل"],[275,"طلت نجيعي أطلاء وأطلال","https://www.aldiwan.net/poem25537.html","البسيط"],[275,"عذلوه في تشبيبه ونسيبه","https://www.aldiwan.net/poem25625.html","الكامل"],[282,"إن الهوى إن كنت عنه تسأل","https://www.aldiwan.net/poem32675.html","الكامل"],[282,"لئن نأت بعد قرب منكم الدار","https://www.aldiwan.net/poem32761.html","البسيط"],[304,"يا جيرة بالمعهد اليماني","https://www.aldiwan.net/poem16842.html","الرجز"],[305,"در أيادي التهاني فتحت صدفه","https://www.aldiwan.net/poem56474.html","البسيط"],[320,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[353,"أدر راح الصفا ولك الأمان","https://www.aldiwan.net/poem39769.html","الوافر"],[371,"إن الهوى المجحودا","https://www.aldiwan.net/poem57497.html","المجتث"],[403,"إن الهوى العذري فنى","https://www.aldiwan.net/poem33385.html","مجزوء الكامل"],[406,"إن كنت تصدق في ادعاء وداده","https://www.aldiwan.net/poem50188.html","الكامل"],[429,"لا والمحيا وصباح الجبين","https://www.aldiwan.net/poem40242.html","السريع"],[441,"العذل يقلق والصبابة تلبس","https://www.aldiwan.net/poem14308.html","الكامل"],[441,"صب صبته إلى ليلى صبابته","https://www.aldiwan.net/poem14340.html","البسيط"],[441,"هذي نهاية وقع الحادث الجلل","https://www.aldiwan.net/poem14475.html","البسيط"],[461,"زهي المباسل لانتضاء المقصل","https://www.aldiwan.net/poem15147.html","الكامل"],[475,"لا در دري إن أطعمت نازلكم","https://www.aldiwan.net/poem1824.html","البسيط"],[477,"أما هواك وان تقادم عهده","https://www.aldiwan.net/poem15208.html","الكامل"],[479,"الحب داء دفين","https://www.aldiwan.net/poem36935.html","المجتث"],[504,"أحببت رب ملاحة لجماله","https://www.aldiwan.net/poem38412.html","الكامل"],[538,"قدك يا جميل","https://www.aldiwan.net/poem47914.html","عموديه"],[551,"يوم الحمى ما أنت من همي","https://www.aldiwan.net/poem47212.html","أحذ الكامل"],[562,"قف بالمطايا على أنجاد ذي سلم","https://www.aldiwan.net/poem52785.html","البسيط"],[562,"الحمد لله من الله بالفرج","https://www.aldiwan.net/poem52832.html","البسيط"],[570,"مالي أرى إبلي تحل كأنها","https://www.aldiwan.net/poem59472.html","الكامل"],[576,"إن الهوان حمار القوم يعرفه","https://www.aldiwan.net/poem1772.html","البسيط"]],"verses":[["إِنَّ إِلَهاً مَسَّ بِال","ضُرِّ جَوادٌ مُنعِمُ",0,"م",1,0],["إِنَّ الهَضيمَةَ إِن أُقادَ لَها","قِدرٌ لَعَمرُكَ لا أُؤَثِّفُها",1,"ف",3,0],["إنّ الهَدايا وخَيْرُ القولِ أصْدقُهُ","تَفْنى بَقِيتَ وتَبْقى هذهِ الكَلِمُ",2,"م",1,0],["إِنَّ الهَوى لَو كانَ يَن","فُذُ فيهِ حُكمي أَو قَضائِي",3,"ا",2,0],["إنّ الهَوى لَشِكايَةٌ معْروفةٌ","صَبِرُ التّصَبُّرِ منْ أجَلِّ عِلاجِها",4,"ه",2,1],["إِنَّ الهُجَيمَ قَبيلَةٌ مَخسوسَةٌ","ثُطُّ اللِحى مُتَشابِهو الأَلوانِ",5,"ن",1,1],["إِنَّ الهُذَيلَ بِذي بَهدى تَدارَكَهُ","لَيثٌ إِذا شَدَّ مِن نَجداتِهِ الظَفَرُ",6,"ر",1,0],["إِنَّ الهُمومَ عَلَيكَ داءٌ داخِلٌ","حَتّى تُفَرِّجَ شَكَّها بِصَريمِ",7,"م",1,0],["إِنَّ الهَدايا تِجاراتُ اللِثامِ وَما","يَبغي الكِرامُ لِما يُهدونَ مِن ثَمَنِ",8,"ن",1,1],["أن الهوى مرَّ به فعرَّجا","لما رأى ذاك الجبين الأبلجا",9,"ج",2,0],["إن الهجاءَ إذا نَدَّت شواردُه","لا يرعوينَ لأصواتِ المُهَنِّينا",10,"ن",2,0],["إِنَّ الهِلالَ وَأَنتَ وَحدَكَ كَهفُهُ","بَينَ المَعاقِلِ مِنكَ وَالأَسوارِ",11,"ر",1,0],["إِنَّ الهُمامَ الَّذي فَخرُ الأَنامِ بِهِ","خَيرُ السُيوفِ بِكَفَّي خَيرَةِ الدُوَلِ",12,"ل",1,0],["أَنالَهُ الشَرَفَ الأَعلى تَقَدُّمُهُ","فَما الَّذي بِتَوَقّي ما أَتى نالوا",13,"ل",3,0],["إنّ الهواء به الحيا","ة وشأنه شأن عجيب",14,"ب",1,1],["إِنَّ الهَوى والرأيَ مالا نحوكمْ","بركائبي وهوى الرجالِ فنونُ",15,"ن",1,0],["إِنَّ الهَوى وَالنَوى شَيئانِ ما اِجتَمَعا","فَخَلَّيا أَحَداً يَصبو إِلى أَحَدِ",16,"د",1,0],["إِنَّ الهُمومَ إِذا أَوطَنَّ في خَلَدٍ","لِلمَرءِ سارَ وَلَم يَربَع عَلى وَطَنِ",17,"ن",1,0],["إِنَّ الهُمومَ وَجَدتَها حينَ اِلتَقَت","في الصَدرِ طارِقِهُنَّ غَيرُ نِيامِ",18,"م",1,0],["إن الهُمامَ الذي أضحى يغالبُكم","له على الدَّهْرِ فيما سامَه الغَلَبُ",19,"ب",1,0],["إِنَّ الهَديَّةَ في زِيارَتِها","تُزري بِصاحِبِها وَلا يَدري",20,"ي",1,0],["إن الهوى لجدير بالفداء وإن","كان الحبيب خيالا مر أو حلما",21,"م",2,0],["إن الهوا لمحيطٌ بالنفوسِ فقُلْ","هل حظّها منه غيرُ الفوْتِ بالنفَسِ",22,"س",1,0],["إِنَّ الهُمومَ الطارِقاتِكَ مَوهِناً","مَنَعَت جُفونَكَ أَن تَذوقَ حَثاثا",23,"ث",2,0],["إِنَّ الهَوى جَثَمَت عَقارِبُهُ","فيهِ جُثومَ الفَرخِ في الوَكرِ",24,"ر",1,0],["إِنَّ الهَوى حَسَنٌ حَتّى تُدَنِّسَهُ","فَاِطلُب هَواكَ سَتيراً وَاِرعَ أَحبابا",25,"ب",2,0],["إِنَّ الهُمومَ تَعَلَّقَت","حَوراءَ كالرَشَأَ الرَبيب",26,"ب",1,0],["إِنَّ الهَوى مَعنى تقص","صر عَن إبانته العباره",27,"ر",2,0],["إِنَّ الهِلالَ إِذا رَأَيتَ نُمُوَّهُ","أَيقَنتَ أَن سَيَكونُ بَدراً كامِلا",28,"ل",2,0],["إنّ الهَدايا كَراماتٌ لآخِذِها","إنْ كُنّ لَسْنَ لإسْرافٍ وأطْماعِ",29,"ع",1,0],["إِنْ أَلَّهَتْكَ النَّاسُ كُنْ عَبْداً هُنَا","وَاخْضَعْ لِهذِي الشِّيمَةِ الشَّمَّاءِ",30,"ا",2,0],["ان الهوى ويلاه داعي البلا","فاسلم ولم تعشق اخي الملاح",31,"ح",1,0],["إن الهوى كالنار يخمد جمره","والحسن ليس له كذاك خلود",32,"د",1,0],["إن الهوى والجوى والوجد معدنه","مذ آنست رسها بالقلب حواء",33,"ا",2,0],["إن الهوَى حُلْوُ المذاقةِ أولا","فإذا تحكم خِلْتَه مُرَّ الجَنَى",34,"ن",2,0],["إن الهلالَ يُرتَجى طلوعُه","بعد السَّرارِ ليلةَ احتجابهِ",35,"ب",2,0],["أَنالَهُ الجودُ وَالإِقدامُ مَنزِلَةً","ما نالَها سالِفاً آباؤُهُ النُجُبُ",36,"ب",1,0],["إن الهناءَ لها برُتْبِة وَصْلِهِ","ضعفُ الهَناءِ له برتبِة وَصْلِها",37,"ل",3,0],["إن الهوى لَهُوَ الهوانُ وإنما اخ","تصروه تَخْفيفا فزال النون",38,"ن",1,0],["إن الهوى لحّة من خاضها عبثا","لم يلتجيء حذرا منها إلى هرب",39,"ب",1,0],["إن الهوى حاكمٌ ألاَّ تُرى كبدٌ","دونَ انصداعٍ وجسمٌ غيرَ منهوك",40,"ك",1,0],["إن الهوى هو في اهتزاز غصونها","طيش الحليم وفي لحاظ ظبائها",41,"ا",3,0],["إن الهدايا التي راعتك قد ضمنت","ذهاب عقلك لما غرّك الذهبُ",42,"ب",1,1],["إن الهوى أحلام","في روضها أشدو",43,"و",1,0],["إِنَّ الهَوى يَهوِّنُ الجَلجَلَه","لَيسَ الهَوى يا أُختَ روحي سوى",44,"س",3,0],["إنّ الهوى عذبٌ فَكُنْ","فيه اللجوجَ المستفيقا",45,"ق",2,0],["إن الهوى داؤه عياء","يعجز عن برئه المسيح",46,"ح",1,0],["إن الهَوى شمسُ الرّبيع فتارةً","تَخفى وتسَمحُ بالأشعَّة حينا",47,"ن",2,0],["أَنالَهُمْ رُتَبَ العَلْيا وَخَوَّلَهُمْ","مَلْكٌ لِمَا أعْجَزَ الأَمْلاكَ نَيَّالُ",48,"ل",1,0],["إنَّ الهُدى لمّا شَكا لِضَنىً بِهِ","ما شَكّ في إبْلالِه بِطَبِيبِهِ",49,"ب",2,0],["إِنَّ الهَوى إِن كُنتَ عَنهُ تَسأَلُ","مَعنىً يَزيدُ بِما يَقولُ العُذَّلُ",50,"ل",1,1],["إِنَّ الهَوى جائِرٌ في الحُكمِ لَيسَ لَهُ","في الجارِ لا في سِواهُ يُؤخَذُ الجارُ",51,"ر",1,0],["إن الهوى في الصب قد تحكم","وتم من شأنه عليه ما تم",52,"م",1,0],["إنّ الهِلال الّذي وافاكَ سوفَ يُرى","بَدراً وشَمسك بالإشراقِ مُلتحفه",53,"ف",2,0],["إِنَّ الهَوى ما تَوَلّى يَصِمِ أَو يَصِمِ","النَفسُ ما لَم تُقيدُ فهيَ هائِمَةً",54,"ه",1,0],["أَنالَهُم التَواضع كُلّ مَجدٍ","فَعَزّوا بِالتَواضع حَيث هانوا",55,"ن",3,0],["إن الهوى المجحودا","ينهاكُما أن تَعودا",56,"د",2,1],["إن الهوى العذري فنى","فإذا صبوت فلا تلمني",57,"ي",1,1],["إِنَّ الهَوى ضِدَ العقول لأَنَّهُ","ضربت جآذِرَهُ عَلى آسادِهِ",58,"د",2,0],["إن الهوى العذري لي مذهبٌ","تبًا لقلبٍ بالهوى لا يدين",59,"ن",1,0],["إن الهوى في مهجتي ونواظري","وأفيدتي فمقبل ومعرس",60,"س",1,0],["إن الهوى في لقا ليلى ورؤيتها","قد أثملتنتا وفي البطحا مدامته",61,"ت",2,0],["إن الهواشم أعلام البلاد وقا","دات العباد وتاج الدهر والدول",62,"ل",1,0],["إنَّ الهوى العذريَّ أُودع صفوه","في دارميٍّ ليس بالمُتَنقلِ",63,"ل",1,0],["إِنَّ الهَوانَ فَلا يَكذِبكُما أَحَدٌ","كَأَنَّهُ في بَياضِ الجِلدِ تَحزيزُ",64,"ز",1,0],["اِنَّ الهوى طمعٌ يولَّدُ داءَهُ","أملٌ يقوَّيهِ الجوى ويُمِدُّه",65,"د",2,0],["إن الهوى في دقيقة","يريك عكس الحقيقة",66,"ه",1,0],["إن الهوى متمكن في مهجتي","لا يمكن التقليل الاستقاله",67,"ل",2,0],["إنَّ الهَوى قَتَّالُ","عَساكَ أن تَلقَاني",68,"ي",1,0],["إنّ الهوى وَالرّأيَ ما اِجتَمعا","الرّأي يُبصِرُ وَالهَوى يُعمي",69,"ي",1,0],["إنَّ الهوى كرْمةٌ باتَ الحكيمُ بها","سكرانَ من شربِ كأسٍ نازفِ اللَّممِ",70,"م",1,0],["أنا لهُ كَيفَما دارَ الزَّمانُ بهِ","ومَعْهُ حيثُ استَوَى فيهِ منَ الدَرَجِ",71,"ج",1,0],["إِنَّ الهَوادَةَ لا هَوادَةَ بَينَنا","إِلّا التَجاهُلَ فَأَجهَدَنَّ فَزارا",72,"ر",2,0],["إِنَّ الهَوانَ حِمارُ القَومِ يَعرِفُهُ","والحُرُّ يُنكِرُهُ والرَّسلَةُ الأُجُدُ",73,"د",1,1]]}