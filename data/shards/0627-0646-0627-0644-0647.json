d=184862",""],[6142,"في ذكره الله آخى المسلمين وسا","https://www.poetsgate.com/ViewPoem.aspx?id=155717",""],[5309,"هذا هواك فودعي عهد الهوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573549",""],[6259,"إن كنت تصدق في ادعاء وداده","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59365&r=&rc=13",""],[6261,"الحصار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82136&r=&rc=8",""],[5126,"قولا لذات اللّمى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87803&r=&rc=18",""],[6331,"الشكوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82021&r=&rc=2",""]],"verses":[["إِنَّ إِلَهاً مَسَّ بِال","ضُرِّ جَوادٌ مُنعِمُ",0,"م",1,0],["إِنَّ الهَضيمَةَ إِن أُقادَ لَها","قِدرٌ لَعَمرُكَ لا أُؤَثِّفُها",1,"ف",3,0],["إنّ الهَدايا وخَيْرُ القولِ أصْدقُهُ","تَفْنى بَقِيتَ وتَبْقى هذهِ الكَلِمُ",2,"م",1,0],["إِنَّ الهَوى لَو كانَ يَن","فُذُ فيهِ حُكمي أَو قَضائِي",3,"ا",2,0],["إنّ الهَوى لَشِكايَةٌ معْروفةٌ","صَبِرُ التّصَبُّرِ منْ أجَلِّ عِلاجِها",4,"ه",2,1],["إِنَّ الهُجَيمَ قَبيلَةٌ مَخسوسَةٌ","ثُطُّ اللِحى مُتَشابِهو الأَلوانِ",5,"ن",1,1],["إِنَّ الهُذَيلَ بِذي بَهدى تَدارَكَهُ","لَيثٌ إِذا شَدَّ مِن نَجداتِهِ الظَفَرُ",6,"ر",1,0],["إِنَّ الهُمومَ عَلَيكَ داءٌ داخِلٌ","حَتّى تُفَرِّجَ شَكَّها بِصَريمِ",7,"م",1,0],["إِنَّ الهَدايا تِجاراتُ اللِثامِ وَما","يَبغي الكِرامُ لِما يُهدونَ مِن ثَمَنِ",8,"ن",1,1],["أن الهوى مرَّ به فعرَّجا","لما رأى ذاك الجبين الأبلجا",9,"ج",2,0],["إن الهجاءَ إذا نَدَّت شواردُه","لا يرعوينَ لأصواتِ المُهَنِّينا",10,"ن",2,0],["إِنَّ الهِلالَ وَأَنتَ وَحدَكَ كَهفُهُ","بَينَ المَعاقِلِ مِنكَ وَالأَسوارِ",11,"ر",1,0],["إِنَّ الهُمامَ الَّذي فَخرُ الأَنامِ بِهِ","خَيرُ السُيوفِ بِكَفَّي خَيرَةِ الدُوَلِ",12,"ل",1,0],["أَنالَهُ الشَرَفَ الأَعلى تَقَدُّمُهُ","فَما الَّذي بِتَوَقّي ما أَتى نالوا",13,"ل",3,0],["إنّ الهواء به الحيا","ة وشأنه شأن عجيب",14,"ب",1,1],["إِنَّ الهَوى والرأيَ مالا نحوكمْ","بركائبي وهوى الرجالِ فنونُ",15,"ن",1,0],["إِنَّ الهَوى وَالنَوى شَيئانِ ما اِجتَمَعا","فَخَلَّيا أَحَداً يَصبو إِلى أَحَدِ",16,"د",1,0],["إِنَّ الهُمومَ إِذا أَوطَنَّ في خَلَدٍ","لِلمَرءِ سارَ وَلَم يَربَع عَلى وَطَنِ",17,"ن",1,0],["إِنَّ الهُمومَ وَجَدتَها حينَ اِلتَقَت","في الصَدرِ طارِقِهُنَّ غَيرُ نِيامِ",18,"م",1,0],["إن الهُمامَ الذي أضحى يغالبُكم","له على الدَّهْرِ فيما سامَه الغَلَبُ",19,"ب",1,0],["إِنَّ الهَديَّةَ في زِيارَتِها","تُزري بِصاحِبِها وَلا يَدري",20,"ي",1,0],["إن الهوى لجدير بالفداء وإن","كان الحبيب خيالا مر أو حلما",21,"م",2,0],["إن الهوا لمحيطٌ بالنفوسِ فقُلْ","هل حظّها منه غيرُ الفوْتِ بالنفَسِ",22,"س",1,0],["إِنَّ الهُمومَ الطارِقاتِكَ مَوهِناً","مَنَعَت جُفونَكَ أَن تَذوقَ حَثاثا",23,"ث",2,0],["إِنَّ الهَوى جَثَمَت عَقارِبُهُ","فيهِ جُثومَ الفَرخِ في الوَكرِ",24,"ر",1,0],["إِنَّ الهَوى حَسَنٌ حَتّى تُدَنِّسَهُ","فَاِطلُب هَواكَ سَتيراً وَاِرعَ أَحبابا",25,"ب",2,0],["إِنَّ الهُمومَ تَعَلَّقَت","حَوراءَ كالرَشَأَ الرَبيب",26,"ب",1,0],["إِنَّ الهَوى مَعنى تقص","صر عَن إبانته العباره",27,"ر",2,0],["إِنَّ الهِلالَ إِذا رَأَيتَ نُمُوَّهُ","أَيقَنتَ أَن سَيَكونُ بَدراً كامِلا",28,"ل",2,0],["إنّ الهَدايا كَراماتٌ لآخِذِها","إنْ كُنّ لَسْنَ لإسْرافٍ وأطْماعِ",29,"ع",1,0],["إِنْ أَلَّهَتْكَ النَّاسُ كُنْ عَبْداً هُنَا","وَاخْضَعْ لِهذِي الشِّيمَةِ الشَّمَّاءِ",30,"ا",2,0],["ان الهوى ويلاه داعي البلا","فاسلم ولم تعشق اخي الملاح",31,"ح",1,0],["إن الهوى كالنار يخمد جمره","والحسن ليس له كذاك خلود",32,"د",1,0],["إن الهوى والجوى والوجد معدنه","مذ آنست رسها بالقلب حواء",33,"ا",2,0],["إن الهوَى حُلْوُ المذاقةِ أولا","فإذا تحكم خِلْتَه مُرَّ الجَنَى",34,"ن",2,0],["إن الهلالَ يُرتَجى طلوعُه","بعد السَّرارِ ليلةَ احتجابهِ",35,"ب",2,0],["أَنالَهُ الجودُ وَالإِقدامُ مَنزِلَةً","ما نالَها سالِفاً آباؤُهُ النُجُبُ",36,"ب",1,0],["إن الهناءَ لها برُتْبِة وَصْلِهِ","ضعفُ الهَناءِ له برتبِة وَصْلِها",37,"ل",3,0],["إن الهوى لَهُوَ الهوانُ وإنما اخ","تصروه تَخْفيفا فزال النون",38,"ن",1,0],["إن الهوى لحّة من خاضها عبثا","لم يلتجيء حذرا منها إلى هرب",39,"ب",1,0],["إن الهوى حاكمٌ ألاَّ تُرى كبدٌ","دونَ انصداعٍ وجسمٌ غيرَ منهوك",40,"ك",1,0],["إن الهوى هو في اهتزاز غصونها","طيش الحليم وفي لحاظ ظبائها",41,"ا",3,0],["إن الهدايا التي راعتك قد ضمنت","ذهاب عقلك لما غرّك الذهبُ",42,"ب",1,1],["إن الهوى أحلام","في روضها أشدو",43,"و",1,0],["إِنَّ الهَوى يَهوِّنُ الجَلجَلَه","لَيسَ الهَوى يا أُختَ روحي سوى",44,"س",3,0],["إنّ الهوى عذبٌ فَكُنْ","فيه اللجوجَ المستفيقا",45,"ق",2,0],["إن الهوى داؤه عياء","يعجز عن برئه المسيح",46,"ح",1,0],["إن الهَوى شمسُ الرّبيع فتارةً","تَخفى وتسَمحُ بالأشعَّة حينا",47,"ن",2,0],["أَنالَهُمْ رُتَبَ العَلْيا وَخَوَّلَهُمْ","مَلْكٌ لِمَا أعْجَزَ الأَمْلاكَ نَيَّالُ",48,"ل",1,0],["إنَّ الهُدى لمّا شَكا لِضَنىً بِهِ","ما شَكّ في إبْلالِه بِطَبِيبِهِ",49,"ب",2,0],["إِنَّ الهَوى إِن كُنتَ عَنهُ تَسأَلُ","مَعنىً يَزيدُ بِما يَقولُ العُذَّلُ",50,"ل",1,1],["إِنَّ الهَوى جائِرٌ في الحُكمِ لَيسَ لَهُ","في الجارِ لا في سِواهُ يُؤخَذُ الجارُ",51,"ر",1,0],["إن الهوى في الصب قد تحكم","وتم من شأنه عليه ما تم",52,"م",1,0],["إنّ الهِلال الّذي وافاكَ سوفَ يُرى","بَدراً وشَمسك بالإشراقِ مُلتحفه",53,"ف",2,0],["إِنَّ الهَوى ما تَوَلّى يَصِمِ أَو يَصِمِ","النَفسُ ما لَم تُقيدُ فهيَ هائِمَةً",54,"ه",1,0],["أَنالَهُم التَواضع كُلّ مَجدٍ","فَعَزّوا بِالتَواضع حَيث هانوا",55,"ن",3,0],["إن الهوى المجحودا","ينهاكُما أن تَعودا",56,"د",2,1],["إن الهوى العذري فنى","فإذا صبوت فلا تلمني",57,"ن",2,1],["إِنَّ الهَوى ضِدَ العقول لأَنَّهُ","ضربت جآذِرَهُ عَلى آسادِهِ",58,"د",2,0],["إن الهوى العذري لي مذهبٌ","تبًا لقلبٍ بالهوى لا يدين",59,"ن",1,0],["إن الهوى في مهجتي ونواظري","وأفيدتي فمقبل ومعرس",60,"س",1,0],["إن الهوى في لقا ليلى ورؤيتها","قد أثملتنتا وفي البطحا مدامته",61,"ت",2,0],["إن الهواشم أعلام البلاد وقا","دات العباد وتاج الدهر والدول",62,"ل",1,0],["إنَّ الهوى العذريَّ أُودع صفوه","في دارميٍّ ليس بالمُتَنقلِ",63,"ل",1,0],["إِنَّ الهَوانَ فَلا يَكذِبكُما أَحَدٌ","كَأَنَّهُ في بَياضِ الجِلدِ تَحزيزُ",64,"ز",1,0],["اِنَّ الهوى طمعٌ يولَّدُ داءَهُ","أملٌ يقوَّيهِ الجوى ويُمِدُّه",65,"د",2,0],["إن الهوى في دقيقة","يريك عكس الحقيقة",66,"ه",1,0],["إن الهوى متمكن في مهجتي","لا يمكن التقليل الاستقاله",67,"ل",2,0],["إنَّ الهَوى قَتَّالُ","عَساكَ أن تَلقَاني",68,"ي",1,0],["إنّ الهوى وَالرّأيَ 