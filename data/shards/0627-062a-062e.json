ى الشَّهادةَ أوْ أنْ تَموتْ؟","https://www.poetsgate.com/ViewPoem.aspx?id=176268",""],[6093,"حادٍ وليس له بعير","https://www.poetsgate.com/ViewPoem.aspx?id=176447",""],[6096,"رافض النعمة","https://www.poetsgate.com/ViewPoem.aspx?id=177722",""],[6102,"ساق !!","https://www.poetsgate.com/ViewPoem.aspx?id=184410",""],[6102,"رسالة إلى \"موديل\" ...","https://www.poetsgate.com/ViewPoem.aspx?id=184870",""],[6202,"احبس دموعك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86700&r=&rc=1",""],[5001,"سمراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83395&r=&rc=16",""],[572,"اتّخذَ الليلَ حَمَلْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9427&r=&rc=284",""]],"verses":[["أَتَخلَعُ حَليُكَ الأَشعارَ عَنها","إِذا كُسِيَت مِنَ المَعنى المُعادِ",0,"د",1,0],["أتُخْطِئُهُ العُلا ويُدِلُّ فيها","بعِرْقٍ من شُيوخِكَ غيرِ وانِ",1,"ن",1,0],["أتَخْشى الضَّراغِمُ ذُؤْبانَهُ","وتَشْكو الصُّقورُ إليهِ قَطاهْ",2,"ا",2,0],["أَتُخبِرُ مَن لاقَيتَ أَنَّكَ لَم تُصِب","عِثاراً وَقَد لاقَيتَ نَكباً عَلى نَكبِ",3,"ب",1,0],["أتخال أني للملامة سامع","لا والذي قد سد عنها مسمعي",4,"ع",2,0],["أَتَخافُ الشَمسَ أَم أَنتَ كَذا","تَعشَقُ اللَيل وَتَهوى السَهَرا",5,"ر",2,0],["أَتَخجَلُ بِاِسمِ مَنتَهوى","أَحَسناءٌ بِغَيرِ اِسمِ",6,"م",1,0],["أَتخشى نشيدَ السَّماءِ الجميلَ","أَتَرْهَبُ نورَ الفضَا في ضُحَاهْ",7,"ا",2,0],["أَتَخَالُ في الوادي البعيدِ المرتَجَى","هيهاتَ لنْ تَلْقَى هناكَ مَرُوما",8,"م",2,0],["أتخشى ضلالا في السرى وطريقها","عليه بياض الفرقدين دليل",9,"ل",1,0],["اِتَخَذ الكُوفَةَ درعا وَقَنا","وَالأَعزلُ الأَكشَفُ مَن فيها اِحتَمى",10,"ا",1,0],["اِتَّخِذ سُكناكَ في تَلقِ الجَواء","بَينَ شَمسٍ وَنَباتٍ وَهَواء",11,"ا",2,0],["اِتَّخَذتِ السَماءَ يا دارُ رُكنا","وَأَوَيتِ الكَواكِبَ الزُهرَ سَكنا",12,"ن",2,1],["أَتَخفِرُ كُلَّ مَن رَمَتِ اللَيالي","وَتُنشِرُ كُلَّ مَن دَفَنَ الخُمولُ",13,"ل",1,0],["أَتَخَشّى زِيالَ عَلوَةَ بَل هِج","رانَها وَالمُحِبُّ خاشٍ جَنانُه",14,"ن",2,0],["أَتَخشى الذُلَّ وَيحَكَ في بَنيها","إذا رُفِعَت بِها لِلعِزِّ رايَهْ",15,"ا",3,0],["اتَّخذتم أرضَ النجاشيِّ داراً","وتَركتُمْ دِيارَكم والقَطينا",16,"ن",2,0],["أَتَخذُلُ ناصِري وَتُعِزَّ عَبساً","أَيَربوعَ بنَ غَيظٍ لِلمِعَنِّ",17,"ن",1,0],["أتخشى لِقانا سليلَ السماء","أتحذرُنا أم تخافُ الضِّياء",18,"ا",2,0],["أَتُخْفِرُ ذِمَّتِي وَتَرُومُ عَطْفِي","لَقَدْ مَنَّتْكَ نَفْسُكَ بِالْكِذابِ",19,"ب",1,1],["اتَخِذَتْ عَبْقَرِيَّةُ الشِّعْرِ فِيهِ","سُلَّماً لِلعُرُوجِ وَالإِصْعَادِ",20,"د",1,0],["أَتَخُونُ صَبْرَكَ يَا عَلِيُّ عَزِيمَةٌ","عَهْدُ الخُطُوبِ بِهَا أَشَدَّ وَاَصْلَبَا",21,"ب",2,1],["أتْخَمتُم الوقتَ بالأعمال، ويحكمو","هلا أضفتم إلى الآجال آجالا!",22,"ل",2,0],["اتَخذوا على «روما» المسا","لك فهْي في ضيق المسام",23,"م",1,0],["أُتخِمتَ بالتُّخوم أرضُ الأعاري","ب، وغَضَّت سماؤها بالبُنود",24,"د",1,0],["أتخشى أن نُغيرَ عليك يومًا","كما في الأرض غاراتٌ تُثَار؟",25,"ر",1,0],["أتختلب الأطماع عقبى كهذه","ويا رب سلم بعده الخطب أجسم",26,"م",1,0],["أتخفين عنّي وحولي شذاك","يوشّي الدروب ويغشى الأثير",27,"ر",1,0],["اتخذ الجوّ ملعبا ثم أمسى","راكضا في الهواء ركض الهواء",28,"ا",2,0],["اتخذيه أخا يكن لك عونا","كلّ نفس محتاجة للأخاء",28,"ا",2,0],["اتخذت من المعروف درعاً حصينة","وقتْك من الطاغي وينت أخيذُه",29,"ذ",2,0],["أتخطِئُني فواضلُكَ اللَّواتي","كَثُرْن فليس يحصيهنَّ عَدُّ",30,"د",1,0],["أتَخَالِينني نَسِيتُ زَمَاني","فِيكَ أيَّامَ شَملِكِ المَجمُوعِ",31,"ع",1,0],["أَتَخونُكُم عِندَ اللِقاءِ صَوارِمٌ","وَتَخونُكُم بَعدَ الفِرارِ عُقولُ",32,"ل",1,0],["أتخشى بأَن يغشى صوارمه الظما","إذا ما اتقى الجبار بالذل واحتمى",33,"م",2,1],["أتخاف ضيما يا خليفة أحمد","في دار ملكك ملة الإسلام",34,"م",1,0],["أَتَخشى هُجومَ الفَقرِ أَم تَطلُبُ الرِّضا","بِهِ مِن عَدُوٍّ أَنتَ إِن شِئتَ غالبُهْ",35,"ب",2,0],["اتخذ باللهو لهواً","واتخذ بالروضِ روضا",36,"ض",2,1],["أتَخذت السحابَ داركَ في الجو","فليست تجيئنا منكَ كُتْبُ",37,"ب",1,0],["أتخطر في بالي خطرت فليتني","وقد ثار ما خطرت على بالي",38,"ي",1,1],["أتخفى على العذّال حالة عاشق","وعبرته ممزوجة بدماء",39,"ا",2,0],["أتخذُلُني إذ كُنتُ أُخفي وأكتُمُ","غراماً غَدَت عنهُ العُيونُ تترجمُ",40,"م",1,1],["أَتُخزَى بَنو العَبَّاسِ وَالمَجْدُ فيهِمُ","وِرَاثَة جَدّ لا شِراءَ عَن الجدِ",41,"د",1,0],["أَتخربُ بيتاً لَستَ تبرح حلّه","وَتُضرِم صدراً ضمَّ ودّك للخلبِ",42,"ب",1,0],["اِتَّخَذني عَبدُ رِقٍّ","في حِمى القَصرِ المُنيفِ",43,"ف",1,1],["أَتَخشَينَ إِن طالَ اللِقاءُ تَسَلِّيا","وَتَخشَينَ إِن طالَ الفِراقُ تَأَسِّيا",44,"ي",2,0],["أتخشى على الممدوح تُظهِرُ ذاته","عياناً وخير المدح ما خُصَّ بالكشف",45,"ف",1,0],["أتخدعنا يا صريع الأسى","وتفضح من أمرنا ما استتر",46,"ر",1,0],["أَتخالني لِمدَى جَلالِكَ بالغاً","اللهُ اكبرُ ما أجلَّ وأكبرا",47,"ر",2,0],["أَتَخُبُ مِنّي كُلَّ لَخناءَ عانِسٍ","وَكَيفَ وَخُطبانُ الخُطوبِ لَها نَقدُ",48,"د",1,0],["أتخيَّلُ المعنى البديعَ وأجتلي","ما راقَ من كَلِمٍ ومن معنًى جلي",49,"ي",1,1],["أتَخْدِمُ كلَّ مبتذَل حقير","إذا ما بيعَ لا يُشرى بفلس",50,"س",1,0],["أَتخيّلْتَ أنّ وقتَك ليلٌ","سَفهاً إنّ ذا دُخانُ البَخورِ",51,"ر",1,0],["اتَخِذْتُمْ بِذَاكَ البَرَايَا خَوَلء","وَدُنْيَا تَفَرَّقْتُمُوهَا دُوَلْ",52,"ل",1,0],["أَتَّخِذُ اللَّيْلَ جَمَلْ","مَا حُمِّلَ اللَّيْلُ حَمَلْ",53,"ل",1,1],["أَتخون يا سَكَني فقال نعم","لي في الخيانة نِسْبةٌ عليا",54,"ي",2,1],["اتَّخذوه لِهزْله هُزُواً","وأَنْتَ لِلجدِّ رَاكِبٌ جَدَداً",55,"د",2,0],["أتخال من حاز المعالي والغنى","يمسي على مهج الورى مستحوذا",56,"ذ",2,0],["أَتَخَيَّلُ الأَرجاءَ بَدَكَ قَد خَلَت","فَكَأَنَّما تِلكَ الرُبوعُ قِفارُ",57,"ر",1,0],["أتُخلين بالجيدِ القلائدَ بيِّني","لنا القصدَ أن تُحلينَه بالقلائد",58,"د",1,0],["أتَخُبُّ مِنكَ الأربعُونَ بِكَرِّها","وَرَقاً وتَطلُبُ خُلَّةً من زينبا",59,"ب",2,0],["أتخلد فيه وهو مثلك ذاهب","ألا إن آمال الفؤاد كواذبه",60,"ب",2,0],["اتخيَّلوني ظلمةً قد جئتهُم","في ظلمةٍ فاستصبحوا نُورَينِ",61,"ن",1,0],["أتخاذلٌ زعماءَ مص","ر أمام هاوية عميقه",62,"ق",2,0],["أتخاف العدى وأنت محيط","بالذي دبر الدهاة وكادوا",63,"د",3,0],["أَتُخَوِّفُ الأوزارَ فيك متيّماً","من للمتيّمِ فيكَ بالأوزار",64,"ر",1,0],["اتخبّره وتخصّصه كيف حاله","وقل له وليف لك مطرّش مراسيل",65,"ل",1,0],["اِتّخذ الصارِمَ مِن نَرجِسٍ","وَاِتّخذَ الدِّرعَ مِنَ الآسِ",66,"س",1,0],["أتخذل يا حامي الذمار عصابة","بهديك دانت ما لها عنه مذهب",67,"ب",1,0],["اتختُلُني وتحسَبُني كخِشفٍ","من الغِزلانِ اغفلَ ما يريمُ",68,"م",1,0],["أَتخالُ أَنَّ البَدْرَ يُمحقُ بالسُّها","سَهْواً وأَنَّ البَحر يُحذَفُ بالجُذا",69,"ذ",2,0],["أتخشى سهامَ الفَقرِ ما دُمتَ مُنفقاً","نصيبكَ والنعمى عليكَ سوابغُ",70,"غ",1,0],["أتخونين روحه ثم لا يثنيك","إن ابنه بها قد تجسم",71,"م",1,0],["اتخذ للبعد عمن ظلما","سلما تسمو به جوَ السما",72,"م",2,1],["أَتُخبِرُ عَن نَحسٍ لِغَيرِكَ شُؤمُهُ","وَنَجمُكَ بادي الشَرِّ يا شَرَّ مُخبِرِ",73,"ر",1,0],["أتخفى على الأيامِ غُرُّ مناقبي","وقد بذَّ شأوي شأوَ كلَّ نَقَابِ",74,"ب",1,0],["أتخطَّى لها رقاب ليوثٍ","ساكناتٍ والليل في أقلاق",75,"ق",1,0],["أتخال ذات الخال أن صدودها","دون النوى يا صحابي تبصّرا",76,"ر",2,0],["أتخال ذات الخال أن معاطف ال","فتيات دون ذوابل الفتيان",77,"ن",1,0],["أتخبر عنهم الدمن الدثورُ","وقد ينبي إذا سئل الخبيرُ",78,"ر",1,1],["أتخشى أيها الأكال جوعاً","وأنت مجاور اللحم الزكي",79,"ي",1,1],["أتخذتم عند المهيمن عهداً","أم نسيتم من عنده السراء",80,"ا",2,0],["أتَخْشَى مِنَ الأكدَارِ تونسُ بَعدمَا","كَسَاهَا حُصُوناً إنَّ ذا لَجَلِيلُ",81,"ل",1,0],["اتخسرُ فوق التاج والنهي والامر","غناك ولا تحظى باسرك في قصر",82,"ر",1,1],["اتخشون فقرا بعدكم لبنيكم","أعيذكم ان تسلكوا الخطة البترا",83,"ر",2,0],["أتخيلتكم تسلبون ضياءها","فلأجلها خفق السِّماكُ الأعزل",84,"ل",1,0],["أتخير الألفاظ فيك ولم أقم","يوماً بوحشي الكلام مُشَقْشِقا",85,"ق",2,0],["أتخالُ حيثُ بدا الصدى إنساناً","لم تدرِ أنّ لكل صوْتٍ شانا",86,"ن",2,1],["أَتخلط بِالظرافة وَعظ نسك","فَتبكينا وَتضحكنا مِرارا",87,"ر",2,0],["اِتخذ السَيف لَهُ صاحباً","وَصَهوة المَهر لَهُ مَسكَنا",88,"ن",2,0],["أتخالني من زلة أتعتب","قلبي عليك أرق مما تحسب",89,"ب",1,1],["اتخلى عن كل قيد ورسم","رسمته لنا العقول الوضيعة",90,"ع",2,0],["اتخاف من طعم الردى فتعافه","لاتخش فهو ألذ كل طعام",91,"م",1,0],["اتختفي الشمس يا من رام يكتمها","في يوم صحو وجو الافق لم يغم",92,"م",1,0],["أتُخرجُ أرضُنا الذهب المصفّى","ونُحرم منه في ماضٍ وآتي",93,"ت",2,0],["أتَخشينَ جور الدهر والعيش ناعم","وحولك أقوام على الدهر غلَّبُ",94,"ب",1,0],["اتخذ القرآن لي إماماً","في العلم نحو أربعين