://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[51,"سمِّي خليل الله لازلتَ مثله","https://www.poetsgate.com/ViewPoem.aspx?id=28601",""],[51,"خبا نَحْسٌ وأعقب منه سعْد","https://www.poetsgate.com/ViewPoem.aspx?id=28470",""],[130,"رسم ربع بجانب الينبوع","https://www.aldiwan.net/poem54803.html","الخفيف"],[141,"هل غير ظلك للعفاة مقيل","https://www.aldiwan.net/poem11791.html","الكامل"],[158,"أتخشى بأن يغشى صوارمه الظما","https://www.aldiwan.net/poem58941.html","الطويل"],[158,"شكوى الهدى وتعلق الإسلام","https://www.aldiwan.net/poem59211.html","الكامل"],[167,"أأسكت عن مولى الورى أم أعاتبه","https://www.aldiwan.net/poem1603.html",""],[197,"اتخذ باللهو لهوا","https://www.aldiwan.net/poem45521.html","مجزوء الرمل"],[197,"علم الله أنني بك صب","https://www.aldiwan.net/poem45556.html","الخفيف"],[209,"أتخطر في بالي خطرت فليتني","https://www.aldiwan.net/poem46622.html","الطويل"],[220,"لقد فرض الحب الحبيب وسنه","https://www.aldiwan.net/poem55461.html","الكامل"],[248,"أتخذلني إذ كنت أخفي وأكتم","https://www.aldiwan.net/poem15029.html","الطويل"],[273,"ولا ودعوا يوم النوى جارة الحمى","https://www.aldiwan.net/poem25412.html","الطويل"],[303,"أعيذ صفاء الود من كدر العتب","https://www.aldiwan.net/poem56604.html","الطويل"],[318,"اتخذني عبد رق","https://www.aldiwan.net/poem61645.html","مجزوء الرمل"],[364,"لعمري لئن أضحى عن الغيد عاديا","https://www.aldiwan.net/poem17304.html","الطويل"],[374,"لقد ضل من قد حاد عن مورد الكشف","https://www.aldiwan.net/poem59322.html","الطويل"],[399,"قد آن أن تلوي العنان وتقصرا","https://www.aldiwan.net/poem46979.html","الكامل"],[405,"أيا أسد الأداب عطفة راحم","https://www.aldiwan.net/poem4182.html","الطويل"],[413,"أتخيل المعنى البديع وأجتلي","https://www.aldiwan.net/poem53887.html","الكامل"],[413,"يشق علي أن تشقى بحبس","https://www.aldiwan.net/poem53982.html","الوافر"],[512,"بزغت بالظلام شمس الديور","https://www.aldiwan.net/poem20787.html","الخفيف"],[565,"له شغل عن سؤال الطلل","https://www.aldiwan.net/poem69529.html","المتقارب"],[565,"أتخذ الليل جمل","https://www.aldiwan.net/poem69536.html","مجزوء الرجز"],[573,"أتخون يا سكني فقال نعم","https://www.aldiwan.net/poem2824.html","أحذ الكامل"],[573,"ما العيش ري ولا الحمام صدى","https://www.aldiwan.net/poem3074.html","المنسرح"]],"verses":[["أَتَخلَعُ حَليُكَ الأَشعارَ عَنها","إِذا كُسِيَت مِنَ المَعنى المُعادِ",0,"د",1,0],["أتُخْطِئُهُ العُلا ويُدِلُّ فيها","بعِرْقٍ من شُيوخِكَ غيرِ وانِ",1,"ن",1,0],["أتَخْشى الضَّراغِمُ ذُؤْبانَهُ","وتَشْكو الصُّقورُ إليهِ قَطاهْ",2,"ا",2,0],["أَتُخبِرُ مَن لاقَيتَ أَنَّكَ لَم تُصِب","عِثاراً وَقَد لاقَيتَ نَكباً عَلى نَكبِ",3,"ب",1,0],["أتخال أني للملامة سامع","لا والذي قد سد عنها مسمعي",4,"ع",2,0],["أَتَخافُ الشَمسَ أَم أَنتَ كَذا","تَعشَقُ اللَيل وَتَهوى السَهَرا",5,"ر",2,0],["أَتَخجَلُ بِاِسمِ مَنتَهوى","أَحَسناءٌ بِغَيرِ اِسمِ",6,"م",1,0],["أَتخشى نشيدَ السَّماءِ الجميلَ","أَتَرْهَبُ نورَ الفضَا في ضُحَاهْ",7,"ا",2,0],["أَتَخَالُ في الوادي البعيدِ المرتَجَى","هيهاتَ لنْ تَلْقَى هناكَ مَرُوما",8,"م",2,0],["أتخشى ضلالا في السرى وطريقها","عليه بياض الفرقدين دليل",9,"ل",1,0],["اِتَخَذ الكُوفَةَ درعا وَقَنا","وَالأَعزلُ الأَكشَفُ مَن فيها اِحتَمى",10,"ا",1,0],["اِتَّخِذ سُكناكَ في تَلقِ الجَواء","بَينَ شَمسٍ وَنَباتٍ وَهَواء",11,"ا",2,0],["اِتَّخَذتِ السَماءَ يا دارُ رُكنا","وَأَوَيتِ الكَواكِبَ الزُهرَ سَكنا",12,"ن",2,1],["أَتَخفِرُ كُلَّ مَن رَمَتِ اللَيالي","وَتُنشِرُ كُلَّ مَن دَفَنَ الخُمولُ",13,"ل",1,0],["أَتَخَشّى زِيالَ عَلوَةَ بَل هِج","رانَها وَالمُحِبُّ خاشٍ جَنانُه",14,"ن",2,0],["أَتَخشى الذُلَّ وَيحَكَ في بَنيها","إذا رُفِعَت بِها لِلعِزِّ رايَهْ",15,"ا",3,0],["اتَّخذتم أرضَ النجاشيِّ داراً","وتَركتُمْ دِيارَكم والقَطينا",16,"ن",2,0],["أَتَخذُلُ ناصِري وَتُعِزَّ عَبساً","أَيَربوعَ بنَ غَيظٍ لِلمِعَنِّ",17,"ن",1,0],["أتخشى لِقانا سليلَ السماء","أتحذرُنا أم تخافُ الضِّياء",18,"ا",2,0],["أَتُخْفِرُ ذِمَّتِي وَتَرُومُ عَطْفِي","لَقَدْ مَنَّتْكَ نَفْسُكَ بِالْكِذابِ",19,"ب",1,1],["اتَخِذَتْ عَبْقَرِيَّةُ الشِّعْرِ فِيهِ","سُلَّماً لِلعُرُوجِ وَالإِصْعَادِ",20,"د",1,0],["أَتَخُونُ صَبْرَكَ يَا عَلِيُّ عَزِيمَةٌ","عَهْدُ الخُطُوبِ بِهَا أَشَدَّ وَاَصْلَبَا",21,"ب",2,1],["أتْخَمتُم الوقتَ بالأعمال، ويحكمو","هلا أضفتم إلى الآجال آجالا!",22,"ل",2,0],["اتَخذوا على «روما» المسا","لك فهْي في ضيق المسام",23,"م",1,0],["أُتخِمتَ بالتُّخوم أرضُ الأعاري","ب، وغَضَّت سماؤها بالبُنود",24,"د",1,0],["أتخشى أن نُغيرَ عليك يومًا","كما في الأرض غاراتٌ تُثَار؟",25,"ر",1,0],["اتخذت من المعروف درعاً حصينة","وقتْك من الطاغي وينت أخيذُه",26,"ذ",2,0],["أتخطِئُني فواضلُكَ اللَّواتي","كَثُرْن فليس يحصيهنَّ عَدُّ",27,"د",1,0],["أتَخَالِينني نَسِيتُ زَمَاني","فِيكَ أيَّامَ شَملِكِ المَجمُوعِ",28,"ع",1,0],["أَتَخونُكُم عِندَ اللِقاءِ صَوارِمٌ","وَتَخونُكُم بَعدَ الفِرارِ عُقولُ",29,"ل",1,0],["أتخشى بأَن يغشى صوارمه الظما","إذا ما اتقى الجبار بالذل واحتمى",30,"م",2,1],["أتخاف ضيما يا خليفة أحمد","في دار ملكك ملة الإسلام",31,"م",1,0],["أَتَخشى هُجومَ الفَقرِ أَم تَطلُبُ الرِّضا","بِهِ مِن عَدُوٍّ أَنتَ إِن شِئتَ غالبُهْ",32,"ب",2,0],["اتخذ باللهو لهواً","واتخذ بالروضِ روضا",33,"ض",2,1],["أتَخذت السحابَ داركَ في الجو","فليست تجيئنا منكَ كُتْبُ",34,"ب",1,0],["أتخطر في بالي خطرت فليتني","وقد ثار ما خطرت على بالي",35,"ي",1,1],["أتخفى على العذّال حالة عاشق","وعبرته ممزوجة بدماء",36,"ا",2,0],["أتخذُلُني إذ كُنتُ أُخفي وأكتُمُ","غراماً غَدَت عنهُ العُيونُ تترجمُ",37,"م",1,1],["أَتُخزَى بَنو العَبَّاسِ وَالمَجْدُ فيهِمُ","وِرَاثَة جَدّ لا شِراءَ عَن الجدِ",38,"د",1,0],["أَتخربُ بيتاً لَستَ تبرح حلّه","وَتُضرِم صدراً ضمَّ ودّك للخلبِ",39,"ب",1,0],["اِتَّخَذني عَبدُ رِقٍّ","في حِمى القَصرِ المُنيفِ",40,"ف",1,1],["أَتَخشَينَ إِن طالَ اللِقاءُ تَسَلِّيا","وَتَخشَينَ إِن طالَ الفِراقُ تَأَسِّيا",41,"ي",2,0],["أتخشى على الممدوح تُظهِرُ ذاته","عياناً وخير المدح ما خُصَّ بالكشف",42,"ف",1,0],["أَتخالني لِمدَى جَلالِكَ بالغاً","اللهُ اكبرُ ما أجلَّ وأكبرا",43,"ر",2,0],["أَتَخُبُ مِنّي كُلَّ لَخناءَ عانِسٍ","وَكَيفَ وَخُطبانُ الخُطوبِ لَها نَقدُ",44,"د",1,0],["أتخيَّلُ المعنى البديعَ وأجتلي","ما راقَ من كَلِمٍ ومن معنًى جلي",45,"ي",1,1],["أتَخْدِمُ كلَّ مبتذَل حقير","إذا ما بيعَ لا يُشرى بفلس",46,"س",1,0],["أَتخيّلْتَ أنّ وقتَك ليلٌ","سَفهاً إنّ ذا دُخانُ البَخورِ",47,"ر",1,0],["اتَخِذْتُمْ بِذَاكَ البَرَايَا خَوَلء","وَدُنْيَا تَفَرَّقْتُمُوهَا دُوَلْ",48,"ل",1,0],["أَتَّخِذُ اللَّيْلَ جَمَلْ","مَا حُمِّلَ اللَّيْلُ حَمَلْ",49,"ل",1,1],["أَتخون يا سَكَني فقال نعم","لي في الخيانة نِسْبةٌ عليا",50,"ي",2,1],["اتَّخذوه لِهزْله هُزُواً","وأَنْتَ لِلجدِّ رَاكِبٌ جَدَداً",51,"د",2,0]]}