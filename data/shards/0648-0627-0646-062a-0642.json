207227",""],[5431,"عادات ثقيلة ...","https://www.poetsgate.com/ViewPoem.aspx?id=213746",""],[5461,"ليه إذا","https://www.poetsgate.com/ViewPoem.aspx?id=8538",""],[5536,"الشفة السفلى !!","https://www.poetsgate.com/ViewPoem.aspx?id=19796",""],[5592,"إِنَّ الطَّبِيبَ بِطِبِّهِ وَدَوَائِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=191201",""],[5720,"البَصْمَة","https://www.poetsgate.com/ViewPoem.aspx?id=200696",""],[5751,"إيقاعُ اُنثى","https://www.poetsgate.com/ViewPoem.aspx?id=214769",""],[4623,"لا تلوموني إني أطلت المقالا ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146608",""],[5821,"قالو توفت","https://www.poetsgate.com/ViewPoem.aspx?id=114113",""],[5848,"كأنها الفرقى طلبتك حاجتين","https://www.poetsgate.com/ViewPoem.aspx?id=48893",""],[5937,"متحف الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=211894",""],[5939,"لِقلبي أكملي الرحلةْ","https://www.poetsgate.com/ViewPoem.aspx?id=178592",""],[5956,"أرجو أن تترجِم للغريب","https://www.poetsgate.com/ViewPoem.aspx?id=184257",""],[6089,"الكلماتُ البالغاتُ","https://www.poetsgate.com/ViewPoem.aspx?id=213394",""],[6117,"مانعةُ الرَّخَاء","https://www.poetsgate.com/ViewPoem.aspx?id=182789",""],[6124,"وحدنا كنا","https://www.poetsgate.com/ViewPoem.aspx?id=174665",""],[6359,"المجلس الطاريء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69093&r=&rc=7",""]],"verses":[["وإنْ تَقْتَسِمْ مُضَرٌ ما بَنَتْ","هُ منْ مَجْدِها يتفَرَّعْ ذُراهْ",0,"ا",2,0],["وَإِنَّ تُقى الرَحمَنِ لا شَيءَ مِثلُهُ","فَصَبراً إِذا تَلقى السِحاقَ الغَراثِيا",1,"ي",2,0],["وَإِن تَقصُرِ الدَعوى إِلى الرَهطِ قَصرَةً","فَإِنَّكَ ذو فَضلٍ عَلى الحَقِّ بَيَّنِ",2,"ن",1,0],["وَأَنتَقِدُ الفَوارِسَ بيدَ أَنّي","رَأَيتُ اللَومَ أَن أَلقى اللِئاما",3,"م",2,0],["وانتقدَ السُّكَّرَ نُقَّادُهُ","وشاوروا في نقده المُذهبا",4,"ب",2,0],["وأنت قليب لها مَستقىً","ولكنَّ جالك لم يُعرش",5,"ش",1,0],["وانتقاصي مع العدو وقد كا","ن يرى لي نقائِصي رُجْحانا",6,"ن",2,0],["وَإِن تَقرُبِ الدارَ الَّتي أَنا ساكِنٌ","هَجَرتُ مَغانيها وَلَو أَنَّها الخُلدُ",7,"د",1,0],["وَأَنتَ قالَ الصَحبُ وَاِستَضحَكوا","هَل لَكَ حَسناءٌ نُحَيِّها",8,"ي",3,0],["وَإِن تَقبضهُ مِن عَبدٍ","تَمُنُّ بِهِ عَلى عَبدِ",9,"د",1,0],["وأنت قريب في الولاء مؤمل","وأنت أبىّ في الخصام كبير",10,"ر",1,0],["وَأَن تُقسَمي لِأَبَرِّ الرِجالِ","وَأَن تَلِدي الأَنفُسَ العالِيَه",11,"ي",2,0],["وَإِن تَقَدَّمَ ذو تَقوى بِصالِحَةٍ","قَدَّمتُ بَينَ يَدَيهِ عَبرَةَ النَدَمِ",12,"م",1,0],["وَإِن تُقتَلا لا توفَيا غَيرَ أَنَّهُ","دَمُ الثَأرِ أَحرى أَن يُصابَ فَيَنقَعا",13,"ع",2,0],["وَإِن تَقتُلوا بِالفَأسِ يَحيَ قَتيلُكُم","وَإِلّا فَإِنَّ الفَأسَ عارٌ قَتيلُها",14,"ل",3,0],["وَاِنتِقالٌ مِنَ الحَرورِ إِلى الظِل","لِ وَسَهمُ الرَدى عَلَيكَ مُنيفُ",15,"ف",1,0],["وَاِنتِقادٌ إِذا جَلَت ظُلمَةُ الشَك","كِ جَلاهُ بِنورِهِ الوَقّادِ",16,"د",1,0],["وأنْتِ قدحتِ في أعشارِ قلبي","بسهميك المُعلّى والرّقيبِ",17,"ب",1,0],["وَأَنتِ قُرَّةُ عَيني إِن نَوىً نَزَحَت","وَمُنيَتي وَإِلَيكِ الشَوقُ وَالطَرَبُ",18,"ب",1,0],["وَإِن تَقرُبي يا لَيلُ وَالحُبُّ صادِقٌ","كَما كانَ يَنمو وَالنَوالُ بَعيدُ",19,"د",1,0],["وَإِن تَقَعِ النُسورُ عَلَيَّ يَوماً","فَلَحمُ المُعتَفى لَحمٌ كَريمُ",20,"م",1,0],["وإنْ تَقُلْ بَيّنْ لنا ما الّذي","منهُ تَبَقّى بَعْدَ ذا قُلْتُ مَهْ",21,"م",2,0],["وَأَنتَ قُطبُ المَعالي","عَلَيكَ كانَ المَدارُ",22,"ر",1,0],["وَإِنْ تقصر خُطَايَ، فرُبَّ خطْوٍ","قصيرٍ نمَّ عن خُلُق كريم",23,"م",1,0],["وانتقى من دمنا عمتّه","واتخذنا وجهه الناري نعال",24,"ل",1,0],["وانتقاضٍ طَوراً كما انتقض الطائرُ","من وَقفةٍ على الأسلاك",25,"ك",1,0],["وانتقلنا لكن لبُرج سُعود","قَرنَ الله فيه بدرْاً وشَمسا",26,"س",2,0],["وأنت ؟ قال الصحب واستضحكوا","هل لك حسناء نحيّيها ؟",27,"ي",3,0],["وانتقاضي مع العدو وقد كا","ن يرى لي نقائِصي رُجْحانا",28,"ن",2,0],["وان تقل كفر فلا تشتبه","فأحبب الآل بقلب سليم",29,"م",1,0],["وإن تقدمني في الشعر قالته","وفاتني كل عنان وأمام",30,"م",1,0],["وَإِن تَقَلَّدتُموها وَهيَ ناصِلَةٌ","فَإِنَّها مِن دَمِ الأَعداءِ تَختَضِبُ",31,"ب",1,0],["وَأَنتَ قَتَلتَ أَعَزَّ الفُحولِ","فَما ذا يَظُنُّ أَذَلُّ الخَدَم",32,"م",1,0],["وأنت قطبٌ له الأفلاك دائرةٌ","وبدر سعدك تمّ ليسَ ينكسفُ",33,"ف",1,0],["وانتقلت من الحصيب وحشة","أَخالها من بعدكم في عدنا",34,"ن",2,0],["وإن تقلّدَ من ذي إمرةٍ عملاً","وجدتَهُ علماً في ذلك العمَلِ",35,"ل",1,0],["وَإِن تقلا لَقَد عَمّت مُؤرخة","سَحائِبُ اللُطفِ وَالرِّضوان مَثواها",36,"ا",3,0],["وانتَقِلْ إن شئتَ تفَّا","حَ رِياض الوَجَنات",37,"ت",1,0],["وَانْتَقِ الْفََضْلَ بِالصَّلاَةِ عَلَى أَزْ","كَى رَسُولٍ مِثْلَ الذِينَ انْتَقَوْهُ",38,"و",2,0],["وأنت قمين أن يبل غليلها","وغلة من أم الموارد تنقع",39,"ع",1,0],["واِنتقِذني من يد البَين الَّذي","شفَّ جِسمي وَبَرى منّي العِظاما",40,"م",2,0],["واِنتقِدهُ من يد البَين الَّذي","لَم يَزَل يَشذبُهُ جَوراً وَيَلحو",41,"ح",2,0],["وانتقذني وتداركني وكن","لي معيناً يا إمام الحنفا",42,"ف",2,0],["وإن تقل كيف حال النزلة والتنزيل","وكيف حال المرابع والربى والمسيل",43,"ل",1,0],["وانتقِدْها انتقادَ صَفْحٍ فكم جُوْ","وِزَ صَفْحاً ما لم يَكُنْ مَنْقودا",44,"د",2,0],["وإِن تقتلونا نُقتِّلكُمُ","وإِن تَقصِدوا لدمٍ نَقصِدِ",45,"د",1,0],["وإن تقل حاجة مست فربتما","فأين صبرك من حين إلى حين",46,"ن",1,0],["وأنتَ قلتَ لِمن أضحى على ثِقَةٍ","بحسنِ عفوِكَ إنّي عند ظنِّكَ بي",47,"ي",1,0],["وانتقلتم منها وأنتم أناس","ما اتخذتم إلاَّ رضا الله زادا",48,"د",2,0],["وانتقاماً لأَجله صمَّمَ الشا","مُ على عَوْدَةٍ إِلَيْهِ انْتِقَالا",49,"ل",2,0],["وإن تقُلْ أُقحوانٌ فيه طلُّ ندًى","فعنْهُ حين تهبّ الريحُ ما يهَبُ",50,"ب",1,0],["وإِنْ تَقْسُ أَكْبادٌ كِرَامٌ عَلَيْهِمُ","فواكَبِدِي مِمَّنْ تَذُوبُ لَهُ صَخْرِي",51,"ر",2,0],["وانتقى عظميَ لمّا لم يجدْ","فوهُ لحماً لِيَ من فرط هُزالي",52,"ل",2,0],["وإن تقدّمتَ أقواماً بحبّهم","فإنما سرتَ والباقي على السنن",53,"ن",1,0],["وانتقل حينا فحينا","بين أفنان الفنون",54,"ن",1,0],["وانتقى في طريق طه سلوكا","كلُّ أحكامه عقودٌ نضيده",55,"د",2,0],["وانتقاها عروس قدسٍ وحلا","ها وفي حضرة القبول جلاها",56,"ا",3,0],["وانتقىْ خيرَ امّةٍ أخرِجتْ للْ","ناسِ بعد أنْ أصبَحتْ في رقادِ",57,"د",1,0],["وانتقال الطبع شيء معوز","مثل ما أعوز لين الجلمد",58,"د",1,0],["وَإنْ تَقلّبتُ عَلى مَضجَعي","كانَ لِجَنبي فيهِ جَمرُ الغَضا",59,"ا",1,0],["وإن تقل إن كل شيء","وجوده حكم مستقل",60,"ل",1,0],["وانتقم الله لأوليائه","من جمعهم على يدي أعدائه",61,"ه",1,0],["وَإِنْ تَقَدَّمَ حَيَّا","وَإِنْ تَحَدَّثَ كَاسَا",62,"س",2,0],["وَأَنتَ قَرين البَأس وَالمَجد وَالعُلا","وَكَم تَلهم العليا وَتوحي التَساميا",63,"ي",2,0],["وأَنتقي أَنْفَسَ ما يُنْتَقى","من لؤلؤِ المدحِ ومن درّه",64,"ر",2,0],["وَاِنتِقالُ الطّباعِ أَمرٌ مُحالٌ","وَرجاءُ المُحالِ رأيُ الضّعيفِ",65,"ف",1,0],["وإن تقرُن بها لحماً","فصيِّره لنا فالا",66,"ل",2,0],["وأنت قوام جثماني ومعنى","وجوديّ المبين سنا رشادي",67,"د",2,0],["وَإنْ تَقِسْ بِفَتَى الأنْصَارِ ذَا نَسَبٍ","فَلاَ تَقِسْهُ فليسَ التمرُ كالحَشَفِ",68,"ف",1,0],["وَأَنتَ قَلبكَ لَم يُشفق عَلَيكَ وَلَم","أَعهدهُ يَقسي إِذا ما حادِثٌ نَزَلا",69,"ل",2,0],["وأنتَ قريبٌ إليَّ قريبٌ","كَنفَسِي منيَ بل أقربُ",70,"ب",1,0],["وإن تقل منهن أو منهمُ","أقل وأغنيك صبي صبيح",71,"ح",1,0],["وإِنْ تُقُلْ قَوْلَ جَهولٍ فَقُلْ","سَيَذْهَبُ القَوْلُ ومَنْ قالَهُ",72,"ل",2,0],["وَأَن تَقل بِالرأي وَالعُقول","فَإِنَّهُ مُشتَرك الدليل",73,"ل",1,0],["وإن تَقَبَّضتُ عنه قال ذو صَلَفٍ","أثرى فقد لَحِقَته زَهوةُ البطرِ",74,"ر",1,0],["وانتقص الجفن ضنى","فيمن به الحسن اكتمل",75,"ل",1,0],["وأن تقِفَ البيقورُ عندَ ورودِها","هُناكَ التبكّي منهُمُ والتقاتل",76,"ل",1,0],["وان تقلَّبَ فهوَ الويلُ حيثُ بهِ","نادت جيوشٌ من الأهوال واحربا",77,"ب",2,0],["وإن تقلَّب كلٌّ يبتغيه وإن","قلَّبتهُ فيهِ ذا اللغز قد كُتبا",77,"ب",2,0],["وَأنْتَ قَيْنٌ تَنْحَتُ الأقْتَابَا","لِشَرٌ أمْرِ إنْ دُعِي أجَابَا",78,"ب",2,0],["وإنْ تَقْتُلُوا ابْنَيْ بَدِيلٍ وهَاشماً","فَنَحْن تَرَكْنَا مِنْكُمْ القَرْنَ أعضَبَا",79,"ب",2,0],["وأن تقفَ العَلْيَا عليك ظنونَها","إذا رابها جِدٌّ من الأمرِ أوْ هزل",80,"ل",1,0],["وأنت قديماً كنتَ أوَّلَ رائشٍ","لِذِكْرِيَ حتَّى طار في الشرق والغرب",81,"ب",1,0],["وإن تقادم حبلٌ","من ودي غيري جدا",82,"د",2,0],["وإن تقطعت الأرحام كان له","في أهل يثرب أعمامٌ وأخوال",83,"ل",1,0],["وانتقبت بالنبات عنه","والتحفت منه في رداءِ",84,"ا",2,0],["وَاِنتَقَلَ الأَمرُ عَن المَدينَهْ","وَكانَ حَقاً ما رَوى سَفينَه",85,"ه",1,0],["وإن تقصدي الرمّال تبغي تجسّسا","أضعتِ وأيم اللهِ في ذلك الحظوا",86,"و",2,0],["وأنت قد تذكر الماضي وما وأدت","كفّاه من أمل غال ومن همم",87,"م",1,0],["وأنتَ قلتَ ولو أنَّهُم وأنا","قد جِئتهُ فأنا إليه مُحتَضِرُ",88,"ر",1,0],["وانتقالي ما ينتهي","هكذا جاء في الزُّبُر",89,"ر",1,0],["وان تقلدها والمجد كان به","قبلاً يزيد بها قدراً على قدر",90,"ر",1,0],["وأنت قسيم النار قسمٌ تجيزهُ","عليها وقسم من لظاها تجيره",91,"ر",2,0],["وإن تقترض شيئا فندب مضاعف","كمثلين إلا خمس بذل التجود",92,"د",1,0],["وإن تقترض أحسن وفاء لمقرض","فإن خيار الناس أحسن مردد",92,"د",1,0],["وانتقاضِ العُهُود بعدَ ابترامٍ","وارتشاف الحجا مدامَ الأماني",93,"ن",2,0],["وان تقل حلفت ليلى اليمين لنا","فانها تسترق السمع والبصرا",94,"ر",2,0],["وَإن تَقِس بِمَسقَطٍ وَالسِّندِ","فالتِّيرَ والمُحنِثَ لا تُعَدِّ",95,"د",1,0],["وَإن تقيسِ النَّسرَ في الغروبِ","فَهوَ مَعَ الذُّبَّانِ يا حبيبي",95,"ي",1,0],["وَإن تُقَيِّد واحِداً فالثاني","الجاهِ يا رُبَّاني",95,"ي",1,0],["وَإن تُقَيِّدِ السُّهَيلَ أربَعَا","فالضفدعُ المشهورُ خمسٌ وَضعَا",95,"ع",2,0],["وَإن تقيسِ الحوتَ والفؤادَا","خمسةَ إلاّ ثلثَ يا أستاذا",95,"ذ",2,0],["وَإن تُقِس بالخَمسِ يا حبيبي","ذُبَّانَ عَيُّوقِكَ في المغيبِ",95,"ب",1,0],["وَإن تقيسِ النَّطحَ والعَنَاقَا","هُم سَبعةٌ في هَنوَرَ اتِّفَاقَا",95,"ق",2,0],["وإن تَقِس بِآخِرِ الداموتي","على سُهَيلٌ دابر وركون",96,"ن",1,0],["وَإن تَقِس كَوكباً شَرقاً ومغربَهُ","تَزدَاد ربعاً فجرِّب يُبلَغِ السُّولُ",97,"ل",1,0],["وَإن تَقِيسَن بخَنِّ البارِ يا أمَلي","فلا يقابِلُهُ شيءٌ كَمَا القَيلُ",97,"ل",1,0],["وإن تَقيسُوا على نَجمَينِ إستَوَيَا","بِجَانِبِ الشَّرقِ مَجنُوبٌ ومشمولُ",97,"ل",1,0],["وإن تَقِيسُوا على الأصلِي وَقُطبِكُم","راساً بِرَاسٍ خُذُوا هذي معاميلُ",97,"ل",1,0],["وَإن تَقِس لِنُجُومٍ ليسَ بَينَهُمُ","قُطبٌ وَلاَ طايرٌ فالمِثلُ مَعقُولُ",97,"ل",1,0],["وإن تَقَضَّت عندكَ التسعونا","زِدِ المايه وَآعمَلَ يا فطينا",98,"ن",2,0],["وإن تَقِيسِ الجاهَ إصبَعَينِ","وَنِصفَ إصبَعٍ يُرَى بالعَينِ",99,"ن",1,0],["وَإن تقيسِ الجاهَ خَمساً عادَه","والنسرَ سَبعاً فَوقَهَا زِيَادَه",99,"ه",1,0],["وَإن تَقِس ضِفدَعاً عَلاَ بِمَشرِقِهِ","على عَدَن في قياسٍ فالظَّليمَينِ",100,"ن",1,0],["وَإن تُقَيِّد ظَلِيماً في الغُروبِ على","عَدَن والحوتُ ذُبَّانُ وإثنَينِ",100,"ن",1,0],["وَإن تُقَابِل بالسَقِي والسَّيرِ","شَرقاً وَغَرباً أنتَ في ذا البرِّ",101,"ر",1,0],["وَإن تَقِيس الجَاهَ عَشراً دَايِمَا","وَقَيدُكَ البَرَّاقٌ في مَهايِمَا",102,"م",2,0],["وإن تَقِيسِ القَلبَ ثُمَّ المَعقِلا","عَلى مِهايَم أربعاً مُشتَمِلاَ",102,"ل",2,0],["وَإن تِقيس القَلب وَالظَّلِيمَا","عَلى زَجَد أربَعَةً مُدِيمَا",102,"م",2,0],["وَإن تَقِيس الفَرقَدَ الكَبِيرَا","فَالمُستَقِلُّ عِندَنَا إشتَهَرَا",102,"ر",2,0],["وَإِن تُقَابِلهَا هُنَاكَ فَآحذَرَا","لأنَّ تَحتَ الما هُنَأكَ حَجَرَا",102,"ر",2,0],["وَانتِقالٌ مِن تاجرٍ لِرَئيسٍ","في نَعيمٍ وَنضرَةٍ وَسُرورِ",103,"ر",1,0],["وإِنْ تقاسَمْتُمُ بالحُبِّ كان لكم","منه النَّصيبُ الحقيرُ التّافِهُ الزَّنِم",104,"م",1,0],["وانتقى حافلة من بينها","وعليها للركوب انعطفا",105,"ف",2,0],["وإن تقلبهُ أمسى وهو حرفٌ","وفعلٌ إنه شيءٌ عجيبُ",106,"ب",1,0],["وإن تقسطوا فالثغر ثغر أميرنا","وهذا أميرٌ في الكتائب مقبل",107,"ل",1,0],["وأنت قد أعطيتني الشعرا","فلتسمعي مني أنا الشكرا",108,"ا",1,0],["وإن تقع عربدة هناكا","فليس يشقى فيهم سواكا",109,"ك",2,0],["وأنتَ قد جُبِلَت فيكَ الجبلَّةُ عن","تَركِ النواذِ يَداً ضيما بأذوادِ",110,"د",1,0],["وأنْ تقولَ لي البيداءُ من وجلٍ","أجئتَ يا راكبَ الخطيّة الذُّبَلِ",111,"ل",1,0],["وَأَنتَ قل لي من يحب قَلبك","تحبني مثل محبَتي لَك",112,"ك",1,0],["وان تقف في بابه إذ أتت","خلف علي فعليها ازار",113,"ر",1,0],["وإن تقصر عوادي الموت مدته","عش أنت ما فاته من قادم المدد",114,"د",1,0],["وانتِ قُدسُ القُدس ثم الخِبا","والعرشُ والتابوتُ والهيكلُ",115,"ل",1,0],["وأنت قبر والمنى جثة","غسلتها من دمعي الحائر",116,"ر",1,0],["وَإِن تَقدّمَ سينَ الثغرِ ميمُ فَمٍ","ماس القَوامُ بأَمرٍ ليس ينحرف",117,"ف",1,0],["وإن تقل من دينها التبرّج","جلّ النساء في الجموع تخرج",118,"ج",1,0],["وان تقصد أبا بكر فبحراً","يعمّ نداه خصباً أو جديبا",119,"ب",2,0],["وأنت قريع العلم والأدب الذي","به تسحر الألباب حسناً وتبيينا",120,"ن",2,0],["وإن تقل زدها بياناً فخذ","حسابها كي تكمل الفائده",121,"د",2,0],["وانتقم من مناوئيك وشيد","من عظام الأعداء صرحاً وطيدا",122,"د",2,0],["وإن تقدم على ثانيه ثالثه","رأيت ظرف زمان حب إذ قلبا",123,"ب",2,0],["وَانْتَقَبَتْ بِالصُّبْحِ لكِنَّها","تَقَنَّعَتْ بِالجِنْدِسِ الأَسْوَدِ",124,"د",1,0],["وانتقضت بغدادُ عُمرانها","عن رأي لا ذاك ولا هذا",125,"ذ",2,0],["وإن تُقدِّرهُ شأنَهُ أصَبتَ بِهِ","مُرادَها بِعُمُومٍ فيهِ يُوفيهِ",126,"ف",3,0],["وَانْتَقِلْ عَنْ مَوْضِعٍ لا يُرْتَضَى","تَلْقَ مَا تَرْضَى بِأذْيَالِ النَّقَلْ",127,"ل",1,0],["وأنت قبل الآت من جهاتِ","كونك كن لنا بحفظٍ آتِ",128,"ت",1,0],["وَأَنتَ قَريبٌ قَد رَأَيتَ مَكانَهُ","تُنادي شَتيراً يَومَ ذاكَ وَعاصِما",129,"م",2,0],["وإن تقل زيد حرى أو حرى","أو قمن أو القمين ذكر",130,"ر",1,0],["وإن تقيس بضوء الشمس جوهره","سعدا وكيف يقاس النجم بالترب",131,"ب",1,0],["وانتقدُ الرِجالَ بكلِّ نادٍ","وَأَعجمُ عُودَهم في كُلِّ سوقِ",132,"ق",1,0],["وأنت قاض فعسى تقضيها","وهي الوصال بعد هذا البعد",133,"د",1,0],["وَاِنتَقَينا مِن شَذاها نَفحةً","عادَت السَكرةُ فيها سَكرَتينِ",134,"ن",1,0],["وانت قطب والمعالي رحى","فلم يكن إلا عليك المدار",135,"ر",1,0],["وَإِن تقرع الأَبواب راحَةُ قارعٍ","يَطِر عِندَها قَلب لذكرك خافقُ",136,"ق",1,0],["وَإِن تَقتفينا العاديات لغارة","فَلا عوذ إِلا كاتب وَخَطيب",137,"ب",1,0],["وانتَقَلت ما بين شطّى نهرِها","وَسَنَدَيها مِن ذُرىً إلى ذُرى",138,"ا",1,0],["وإن تقمه في مقام يكفيك","على كمالٍ أحسن الخصال",139,"ل",1,0],["وانْتَقَصَتْنا امَمٌ كُنا لَها","بَدْرا يَبُثُّ الهَدْيَ فَياضَ الضِّيا",140,"ا",1,0],["وأنت قَويٌّ ما عدلت مسلَّط","يخافُكَ كلُّ الحضر ثم البداوة",141,"ه",1,0],["وإن تقلب الأيام فينا اع","تبارٌ للأريب وما ارعويتِ",142,"ت",1,0],["وإن تقلَّدَ بحراً من أناملهِ","رأيتَ كيف اقترانُ الرّزقِ بالأجلِ",143,"ل",1,0],["وان تقصد بساحتهم خدينا","تصادفه دخانا او اتونا",144,"ن",2,0],["وانتَقَى الخَوفُ أَهلَهُ, فاستَطاعُوا","أَن يَفِرُّوا سِياسَةً لا اعتِزالا",145,"ل",2,0],["وأنت قد كنتَ فيها","بها لكم طاب رجنُ",146,"ن",1,0],["وأنت قلوب للمعالي فساجلت","على فتنِ العلياء سجع الحمائم",147,"م",1,0],["وأنت قبلة أشواقي وكعبتُها","وثورة الرغبة الحمراء مُطَّلَبَا",148,"ب",2,0],["وانتقدُ الخليلَ بما اقتفَاهُ","فكلُّ بحورِهِ أشباهُ صحْرا",149,"ر",2,0],["وَأَنْتَقِي مِنْ شَوَاطِي اليَمِّ لِي صَدَفَاً","كَسَاحِرٍ ضَمِنَتْ أَصْدَافُهُ البَشَرَا",150,"ر",2,0],["وانتقام الخصم مع شدَّتهِ","هو إرهاصٌ لنصرٍ يتدانى",151,"ن",2,0],["وأنت قمت لشمل الأهل تجمعه","وما لويت على ناه ولا لاحي",152,"ح",2,0],["وان تقلدت الاحزان قلب فتى","اتاه توقيعها في عزل واليها",153,"ي",3,0],["وَأنْتِ قَصيدةٌ تَخْتالُ بِدْءًا","بِأنَّ رويّها سَوْح الفَوارِسْ",154,"س",1,0],["وأنتِ قافيةٌ بالشعرِ شاردةٌ","جعلتها في لسانِ الحبّ ديوانا",155,"ن",2,0],["وأنتِ قافيةٌ واللهِ مفردةٌ","صيَّرْتُها في ثنايا القلبِ ديوانا",156,"ن",2,0],["وأنت قطعة ياقوتٍ أقدّدها","نظما فانشره تغلى به الحللُ",157,"ل",1,0],["وأنتِ قافيةٌ بالشعرِ سائرةٌ","بالبوحِ حاكيةٌ يعتادُها الزجلُ",158,"ل",1,0],["وانتقي ما شئتِ من معنىً طريفٍ","أنتِ من يضفي على المعنى جمالَه !",159,"ل",2,0],["وإنْ تقبضْ على جمراتِ صدقٍ","ترى الرحمن في ظللٍ ظليلةْ",160,"ل",2,0],["وأنتقي لك من سواليفي حسنها","والقصايد من غزلها كل... حروه",161,"و",2,0],["وأن تقفزي فوق َ الحواجز ِ كُلها..","وأن تشربيني خمرة ً تُذهِب ُ العقلا!!",162,"ل",2,0],["وَأَن تقتلونا يَوْم حرَّة واقم","فَنحْن على الْإِسْلَام أول من قتل",163,"ل",1,1],["وأنتِ قَيثارةٌ أزهُو بِها طَرَباً","تَصُوغُ حُلْمَاً مضىٰ يعتادُني أَمَدَا",164,"د",2,0],["وأنتِ قصيدتي الأحلى وصوتي","تلونه عيونُكِ إذ تُغيرُ",165,"ر",1,0],["وانتقيت المختار منها لحصر","المدح للمختار ادعيته محالا",166,"ل",2,0],["وانت قول مثل الي يقولون","امين كانك يابعد عمري تبيني",167,"ن",2,0],["وانت قبل تنام تطفي شمعتين","والمخدة من شذى خدك تفوح",168,"ح",1,0],["وأنتِ قيامةٌ ، فمتى تُعيري","شفاهي نفخةَ الصورِ المُلَثَّمْ",169,"م",1,0],["وأنتِ قَصيّةٌ دُنيا","وأنتِ عَصيةٌ سَهلةْ",170,"ل",2,0],["وإنْ تقنعْ بفكري يا قريبي","فأرجو أن تترجمَ للغريبِ",171,"ب",1,0],["وإن تقبلِ النفسُ الهوانَ ففي غدٍ","يحاصرُها بالخوفِ والذلِّ إثمُها",172,"م",3,0],["وأنَّ تقلُّبَ الأخلاقِ طبعٌ","تشرَّبهُ وريدُ الكبرياءِ",173,"ا",2,0],["وانتقيتُ الصَّعبَ حلمي والصِّحابَا","وارتديتُ الشَّوكَ كُمًّا صارَ وَرْدَا",174,"د",2,0],["وانتقلنا بعد أيامٍ إلى","نقطةٍ أخرى أثارتْ بلبلة",175,"ل",2,0]]}