{"poems":[[34,"فلما طلعن ذا الغلالة وانتحت","https://www.aldiwan.net/poem27702.html","الطويل"],[108,"رويدك يا جمال!","https://www.poetsgate.com/ViewPoem.aspx?id=179353",""],[234,"أتنسى أيها العات","https://www.aldiwan.net/poem51076.html","الهزج"],[369,"طربن لترجيع الغناء المهزج","https://www.aldiwan.net/poem60970.html","الطويل"],[463,"نعم من جميلة إحدى النعم","https://www.aldiwan.net/poem55877.html","المتقارب"],[473,"حللت عرى إخائك من إخائي","https://www.aldiwan.net/poem60543.html","الوافر"],[572,"بدت في نسوة مثل المها","https://www.aldiwan.net/poem69764.html","الهزج"],[951,"","https://poetry.dctabudhabi.ae/diwan/poem/19945","الوافر"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202079","المتقارب"],[1381,"","https://poetry.dctabudhabi.ae/diwan/poem/98198","البسيط"],[1594,"","https://poetry.dctabudhabi.ae/diwan/poem/97784","السريع"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100472","الوافر"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28614","المتقارب"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74161","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62772","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205879","الهزج"],[4270,"","https://poetry.dctabudhabi.ae/diwan/poem/124283","الطويل"]],"verses":[["فَلَما طَلعنَ ذا الغِلالَةَ وانتَحت","بِهنَّ الحُداةُ في خَويٍّ لَه سَهلُ",0,"ل",1,1],["فَلَمَّا طاشت الآمال قلنا","-على مضض-: إلى الله المآل",1,"ل",1,0],["فلمَّا طَلَع الصبح","كتمتَ الصبح بالشعر",2,"ر",1,0],["فلمّا طَوتْ كفُّ الدجى سطْرَ أحرفٍ","منَ العيسِ في ظهْرٍ من البيدِ مُدْرَج",3,"ج",1,0],["فلما طلعنَ بنا النَّهروان","تعاقدنَ طاعةَ حُكمِ الحَكَمْ",4,"م",1,0],["فَلَم أُطلِق سِباقَ الَتبِ مِنّي","غَداةَ نَشَرتَ أَجنِحَةَ الجَفاءِ",5,"ا",2,0],["فلمّا طُفْنَ بالمجْلِ","سِ أفراداً وأَزْوَاجَا",6,"ج",2,0],["فلما طاب مشربها تداعى","لها الغادون وابتدروا التجارا",7,"ر",2,0],["فلمَّا طَغَى الماءُ أجْرى بِه","سَفينتَه رَبُّها في العُباب",8,"ب",1,0],["فلم أطاع عذولاً ما يسهِّدُه","إذا غفا كلُ طرْفٍ ما يسهِّدُهُ",9,"د",2,0],["فلم أطلق صبراً على رُزئه","وجدتُه أقرب إخوانيه",10,"ي",2,0],["فلم أطلب قراها منك تبراً","ولا أرجوك تمهرها لجينا",11,"ن",2,0],["فَلَمّا طَلَعتَ بِمَلمومَةٍ","يلمُّ بِها وَهج كالدَّخَن",12,"ن",1,0],["فَلم أطعه وَلَم أَبرح مخالفه","وَالشَيب أَبعد في نصح عَن التُهم",13,"م",1,0],["فلم أطلُبِ المعرورَ من غيرِ كفِّه","وهلْ تُطلَبُ الأمطارُ إلاّ من السُّحْبِ",14,"ب",1,0],["فلما طال بي عهدًا","ولم أسعد بهجرانِ",15,"ن",1,0],["فلما طلبت الوصل من أم ايمن","على شغف منى بأجفانها المرضى",16,"ض",2,0]]}