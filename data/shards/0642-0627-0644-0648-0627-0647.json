https://www.poetsgate.com/ViewPoem.aspx?id=186019",""],[5431,"وطن الأكفان ...","https://www.poetsgate.com/ViewPoem.aspx?id=198867",""],[470,"يا شيخ شعري","https://www.poetsgate.com/ViewPoem.aspx?id=178095",""],[5672,"من بقايا الرثاء...","https://www.poetsgate.com/ViewPoem.aspx?id=206450",""],[5691,"أمام المرآة","https://www.poetsgate.com/ViewPoem.aspx?id=206736",""],[5737,"رسالة لأهلنا في اليمن","https://www.poetsgate.com/ViewPoem.aspx?id=198441",""],[5997,"عِلْمُ الْبَيَاْن","https://www.poetsgate.com/ViewPoem.aspx?id=214993",""],[6035,"كذبة السيادة .. والإستقلال ! .","https://www.poetsgate.com/ViewPoem.aspx?id=175130",""],[6115,"يالله يامن بامره الشر والخير","https://www.poetsgate.com/ViewPoem.aspx?id=180503",""],[6212,"فيفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1620&r=&rc=1",""],[6213,"الناس أسرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76273&r=&rc=30",""]],"verses":[["قالوا: هم البشر الأرقى وما أكلوا","شيئاً.. كما أكلوا الإنسان أو شربوا",0,"ب",3,0],["قالوا هجاك أبو حفص فقلت لهم","بذاك أمكنني من قَفْدِ يافُوخِهْ",1,"ه",1,1],["قالوا هجاك أبو حفص فقلت لهم","لا تدخلوا بيننا يا معشر الحسدَهْ",2,"د",2,1],["قالوا هجاك أبو حفص فقلت لهم","عرضي على ذاك وقْفٌ آخر الأبدِ",3,"د",1,1],["قالوا هجاك أبو حفْصٍ فقلت لهم","أعاش بعدي سليمان بن داوُودِ",4,"د",1,1],["قالوا هجاك أبو حفصٍ فقلت لهم","استبطأتْ هامةُ الصَّفْعان عادتَها",5,"ت",3,1],["قالوا هجاك أبو حفصٍ فقلت لهم","قد طال قرنُ أبي حفص على قِصرِهْ",6,"ر",2,1],["قالوا هوت من ذُرى جدارٍ","عالٍ فقال الجميع خِيره",7,"ر",2,0],["قالوا هجاك أبو حفصٍ فقلتُ لهم","لا شبَّ قرنُ أبي حفص ولا زُرعا",8,"ع",2,1],["قالوا هجاك أبو حفص فقلت لهم","تأنَّ في بيته من سوف يردعُهُ",9,"ه",1,1],["قالوا هجاك أبو المزّاق قلتُ لهم","ولم هجاني فقالوا للذي بلَغَهْ",10,"غ",2,1],["قالوا هجاك أبو حفص ولحيتُه","فقلتُ ما أنصفاني في الذي فعلا",11,"ل",2,1],["قالوا هجاك أبو حفص فقلتُ لهم","باللَّهِ أدفعُ ما لا تدفع الحِيلُ",12,"ل",1,1],["قالوا هجاك أبو حفصٍ فقلتُ لهم","أخي وخلِّي ونَدماني وصَفعاني",13,"ي",1,1],["قالوا هي الزاد الحرام وأخرجوا","من أكلهم مال اليتيم حرامها",14,"م",3,0],["قالوا هو الذي برا","هذا الوجود والورى",15,"ر",2,0],["قالوا هَجَرتَ إِلَيهِ الغَيثَ قُلتُ لَهُم","إِلى غُيوثِ يَدَيهِ وَالشَآبيبِ",16,"ب",1,0],["قالوا هُوَ البَدرُ قُلتُ البَدرُ مُنمَحِقٌ","قالوا هُوَ الشَمسُ قُلتُ الشَمسُ تَحتَجِبُ",17,"ب",1,0],["قالوا هُوَ الغَيثُ قُلتُ الغَيثُ مُنتَظَرٌ","قالوا هُوَ اللَيثُ قُلتُ اللَيثُ يُغتَصَبُ",17,"ب",1,0],["قالوا هُوَ السَيلُ قُلتُ السَيلُ مُنقَطِعٌ","قالوا هُوَ البَحرُ قُلتُ البَحرُ مُضطَرِبُ",17,"ب",1,0],["قالوا هُوَ الظِلُّ قُلتُ الظِلُّ مُنتَقِلٌ","قالوا هُوَ الدَهرُ قُلتُ الدَهرُ مُنقَلِبُ",17,"ب",1,0],["قالوا هُوَ الطَودُ قُلتُ الطَودُ ذو خَرسِ","قالوا هُوَ المَوتُ قُلتُ المَوتُ يَجتَنَبُ",17,"ب",1,0],["قالوا هُوَ السَيفُ قُلتُ السَيفُ نَندُبُهُ","وَذاكَ مِن نَفسِهِ بِالجودِ يُنتَدَبُ",17,"ب",1,0],["قالوا هُبِلتَ أَتَبغي بَينَهُم نَسَباً","هَيهاتَ ما لَكَ في الأَعرابِ مِن نَسَبِ",18,"ب",1,0],["قالوا هناك واجب","فاعلمه تعل في الرتب",19,"ب",1,0],["قالوا هو الحقُّ ما نسعى لنُصْرتِهِ","يا بُؤسَهُ كم هوانٍ أهلهُ ساموا",20,"م",3,0],["قالوا هرمت ولم تطرق تهامة في","مشاة وفد ولا ركبان أجمال",21,"ل",1,0],["قالوا هي الكِبْرُ قلتُ الكبر مَحْمَدةٌ","إذا تساميتَ عمّا بالعلا يودِي",22,"د",2,0],["قالوا هنا لُبْنانُ قلتُ وهل سوى","لُبنانَ ملعبُ صبوتي ومِراحي",23,"ح",2,0],["قالوا هو الحقّ ما نسعى لنصرته","يا بؤسه كم هوان أهله سامو",24,"م",2,0],["قالوا هلمّ فقلت غير محامل","غيري أزدهته لمن دعاه الخفة",25,"ه",1,0],["قالوا هَجتكَ سَلولُ اللُّؤمِ مُخفِيةً","فاليومَ أهجوا سَلولاً لا أُخافيهَا",26,"ي",3,1],["قالوا هجاكَ سَلوليٌّ فقلتُ لهم","قد أنصفَ الصخرة الصّماءَ راميهَا",26,"ي",3,0],["قالوا هو الغيث والتفريق بينهما","اضوا واشهر من نار ومن نور",27,"ر",1,0],["قالوا هو الغيث قلت الغيث بعض ندى","يمناه حين تجود السحب بالمطر",28,"ر",1,0],["قالوا هو البحر قلت الفرق بينهما","اضوا من الشمس لا يخفى على البشر",28,"ر",1,0],["قالوا هو أَهم عليحتم","قلت عهود الهوى رزات",29,"ت",1,0],["قالوا : هو الصديق ، قلت : كفاه","ما يحفظ التاريخ من ذكراه",30,"ا",2,1],["قالوا هي الذرات حين تفجرت","نثرت نظام الجو أي نثار",31,"ر",1,0],["قالوا هجرتَ أرضَها","أهجرُها برغمي",32,"م",2,0],["قالوا هي الخضراء أرض فلاحة","فأجبتهم وأبو الأنام فلاحي",33,"ح",2,1],["قالوا هُوَ الغَيث قُلتُ الغَيثُ آوِنَةً","يَهمِي وَغَيثُ نَداهُ لا يَزالُ هَمي",34,"م",2,0],["قالوا هي الأعيان والأعراض لم","يدروا سوى ألفاظ نطق الناطق",35,"ق",1,0],["قالوا هو الجسم أعني ما تركب من","جواهرٍ فردةٍ قولاً لأهلِ هدى",36,"د",2,0],["قالوا هُوَ ابنُ اللهِ جهراً والعِدَى","من حولهم مثلُ الذِّئابِ الحُوَّمِ",37,"م",1,0],["قالوا هل السيف بأل","حاظ له قلت أجل",38,"ل",1,0],["قالوا هزلتَ وكيف يهزل ناحلٌ","من هزل عاتكةٍ وجِدِّ لعوب",39,"ب",1,0],["قالوا هو اللهُ جلَّ اللهُ خالقُنا","من أن يكون ابنَ أمِّ أو يكونَ أبا",40,"ب",2,0],["قًالُوا هِيَ الشَّهْدُ لَدَى ذَوْقِهَا","طِيباً فَقُلْتُ الشَّهْدُ وَاللَّهِ دُونْ",41,"ن",1,0],["قالوا هو البحر ما هذي الرياض به","تزهو فقلت نعم هذي جزائره",42,"ر",2,0],["قالوا هي الروح قلت الروح تعشقها","وكيف لا ولها منها امتدادات",43,"ت",1,0],["قالوا هي العقل قلت العقل يخدمها","وكم عليها لواليها ولايات",43,"ت",1,0],["قالوا هي النور قلت النور ما صنعت","منها زجاجاتها الغر النفيسات",43,"ت",1,0],["قالوا هي النار قلت النار تطفئها","بالما وهذي لها بالما استعارات",43,"ت",1,0],["قالوا هي قلت الماء برقعها","وكم لها نسجت منها غلالات",43,"ت",1,0],["قالوا هي الكون قلت بالكون نشأتها","وكم لها في وجود الكون آيات",43,"ت",1,0],["قالوا هي اللوح قلت اللوح قد رسمت","فيه لأسمائها طرق خفيات",43,"ت",1,0],["قالوا هي الفلك الدوار قلت لهم","يا كم عليه لها منها إحاطات",43,"ت",1,0],["قالوا هديت هي الكرسي قلت لهم","لنور مصاحبها الكرسي مشكاة",43,"ه",1,0],["قالوا هي الفلك الأعلى المحيط فقل","يا ما عليه لها منها احاطات",43,"ت",1,0],["قالوا هي العرش قلت العرش مركزها","وكم لها بأعاليه استواءات",43,"ت",1,0],["قالوا هو الله الذي يأتى كما","أخْبَرَنا من الغَماِم في ظُلَلْ",44,"ل",1,0],["قالوا هم قد عَطّلوا الأديَانَا","وأبْطلَوا الإسْلامَ والإيمانَا",45,"ن",2,0],["قالوا هو الشرق لم نحسن سياسته","وكل من لا يسوسُ الملك يخلعه",46,"ع",2,1],["قالوا هدى جَدواه نَنْكِس","يا احمَد نِحِن لي ناخِذ الشّور",47,"ر",1,0],["قَالُوا هُوَ المَلعَبُ ال