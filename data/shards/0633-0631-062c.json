{"poems":[[63,"هويتها والفراق يهواها","https://www.aldiwan.net/poem51406.html","المنسرح"],[92,"أرج الشباب وخمره المسكوب","https://www.aldiwan.net/poem60158.html","عموديه"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85378","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19668","الكامل"],[202,"ومسددين إلى الطعان ذوابلا","https://www.aldiwan.net/poem51973.html","الكامل"],[445,"نعم يبشر بدؤها بتمام","https://www.aldiwan.net/poem34866.html","الكامل"],[449,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72331","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79862","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27219","الخفيف"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120894","السريع"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93573","الكامل"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26179","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54332","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139641",""],[4829,"التوابع والزوابع","https://www.poetsgate.com/ViewPoem.aspx?id=34253",""],[4869,"شعور الليل والغربه","https://www.poetsgate.com/ViewPoem.aspx?id=151648",""],[4984,"عِيدِيَّةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=204720",""],[5112,"قمر البيان","https://www.poetsgate.com/ViewPoem.aspx?id=212997",""],[5837,"بعيد الشبح","https://www.poetsgate.com/ViewPoem.aspx?id=179316",""],[6031,"مَا بَالُ عينِكَ لا تَجُودُ بِمَائِهَا","https://www.poetsgate.com/ViewPoem.aspx?id=46293",""],[6125,"كأنَّا بما في هَوَانا ارتَوَينَا","https://www.poetsgate.com/ViewPoem.aspx?id=212881",""],[4222,"أنتم لمحمود كآل محمد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52709&r=&rc=1",""]],"verses":[["سُرْجٌ أضاءَت على الزمانِ فما","أخمدَها الدهرُ مُنذ أذكَاها",0,"ا",3,0],["سُرُجٌ تنير الخابطين ، وأنْجُمٌ","نغدو على أضوائها وَنَؤُوب",1,"ب",1,0],["سر جَليلاً إلى سلانيك عنا","إن فيها كواعبا أَبكارا",2,"ر",2,0],["سرٌّ جلالك صانه فالسين في","يمنى يديه وفي الشمال الراء",3,"ا",2,0],["سُرُجٌ تَرى الأرواحَ تُطفي غيرها","عبثاً وهذي تطفئُ الأرواحا",4,"ح",2,0],["سُرُجٍ لِدِينِ الحَقِّ إِلّا أَنَّها","كَسَتِ الضَّلالَ دياجِيَ الإِظْلامِ",5,"م",1,0],["سرجا تطفا إذا الصبح انفجر","أو كأن الكهربا قد قدحت",6,"ت",1,0],["سرج الهدى عادت بأسياف العدى","ألَفَ الهوان طرايد الأقطان",7,"ن",1,0],["سُرجاً للعُلى ولدتَ وكلٌّ","كم له من نهار فخرٍ تجلّى",8,"ل",2,0],["سُرج العلم أُسرجت في الهواء","لمرادٍ بليلة الإسراءِ",9,"ا",2,1],["سِرّ جمال ليس فيه اشتراك","قضى بحب ليس عنه انفكاك",10,"ك",1,1],["سَرج العُلى بِمحلكم لا تخمد","إن يطف مصباح فآخر يُوقد",11,"د",1,1],["سُرُجٌ تَلوحُ إِذا نَظَرتَ فَإِنَّها","نورٌ يُضيءُ وَإِن مَسَستَ فَنارُ",12,"ر",1,0],["سُرُجُ الهدى سحب لنّدى شهبُ النُّهى","أُسْدُ الحروبِ ضراغمُ الهيجاءِ",13,"ا",2,0],["سُر جلال الدين شاه الذي","في العلم أضحى علمَاً والأياد",14,"د",1,0],["سرجت الّي فلا قبلي سرجْه الا قوي نوّاف","وزرنا عنتر العجلان قد جيته لاجل شمّه",15,"م",2,0],["سرجت الفكر بابياتي وجيتك فوق موالي","اناديك بصدى قلبي ولكن خابت لحوني",16,"ن",2,0],["سُرُجُ الصحافة ما انتهت","إلا إلى سقط المتاع",17,"ع",1,0],["سَرَجْنَا هَذِهِ الْأَرْوَاحَ خَيْلًا","وَ قَدْ جِئْنَا شُهُودًا لِلْقِرَانِ",18,"ن",1,0],["سرجت الخيول بدربه وزاد فيها الضبح","وخلَّى على صدري برك ضيق ويدافر",19,"ر",1,0],["سُرُجٌ يُضِيءُ بها الظَّلامَ فَمَا لَها","في التُّرْبِ تستعدِي على ظُلَمائِها",20,"ا",3,0],["سَرَجنَا من الليلِ شَمسًا فَحَالَتْ","ظَلامَ الجَفَاءِ ائتِلافًا عَلَينَا",21,"ن",2,0],["سرج الهدى سحب الندى شهب النهى","أسد الحروب ضراغم الهيجاء",22,"ا",2,0]]}