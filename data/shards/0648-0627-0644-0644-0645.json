{"poems":[[55,"ما ابيض من لون العوارض أفضل","https://www.aldiwan.net/poem29902.html","الكامل"],[469,"ته على النجم والمحل الأثيرِ","https://www.aldiwan.net/poem3281.html","عموديه"],[852,"","https://poetry.dctabudhabi.ae/diwan/poem/123978","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38952","الرمل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59137","الرمل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78113","الرمل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140092",""],[3697,"","https://poetry.dctabudhabi.ae/diwan/poem/140285",""],[5302,"في فؤادي ضرام","https://www.poetsgate.com/ViewPoem.aspx?id=201267",""],[5725,"ساقي الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=186810",""]],"verses":[["وَاللِمَّةُ البَيضاءُ أَهوَنُ حادِثٍ","في الدَهرِ لَو أَنَّ الرَدى لا يَعجِلُ",0,"ل",1,0],["واللَّمى لم تكن لتحمده الأل","سنُ جمعاً لولا بياض الثغور",1,"ر",1,0],["واللم مشتهر بما يأوي من ال","علماء والفضلاء تحت ظلاله",2,"ل",2,0],["وَاللّمى يَجري على الدُّرِّ النّظيم","قَد حَكى الشَّهدَ وَفاقَ القرقفا",3,"ف",2,0],["واللَّمَى وَالثَّغْرُ مِسْكٌ وَأقَاحْ","وَالطُّلَى سُوسَانْ",4,"ن",1,0],["وَاللمى المَمزوج بِالكاس","قَد دَعا مَيت الهَوى حَيا",5,"ي",2,0],["واللمط نبت في حواشي ذيله","وبقربه جبل المروطاسية",6,"ه",1,0],["واللمز فيهم وكل القبح قد جمعوا","وفي القلوب من الأحقاد أوغار",7,"ر",1,0],["واللمى فيك زان حتى ليبدو","لمحب من الشفاه ابتسام",8,"م",1,0],["واللميّا لم تزل تحرمني","من رضاب شهده لم يذقِ",9,"ق",1,0]]}