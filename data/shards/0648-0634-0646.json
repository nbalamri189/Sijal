{"poems":[[65,"كتمنا الهوى وكففنا الحنينا","https://www.aldiwan.net/poem46144.html","المتقارب"],[0,"لمن طلل بين الجدية والجبل","https://www.aldiwan.net/poem84.html","الطويل"],[49,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[53,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[63,"أسلم للأيام أم لا أسلم","https://www.aldiwan.net/poem51450.html","الطويل"],[63,"قليل لها أن يتبع الدمع غيرها","https://www.aldiwan.net/poem51683.html","الطويل"],[68,"هو الدهر مغرى بالكريم وسلبه","https://www.aldiwan.net/poem40134.html","الطويل"],[82,"صفا لي من ورد الشبيبة ما صفا","https://www.aldiwan.net/poem31377.html","الطويل"],[48,"ترنم في نهارك مستعينا","https://www.aldiwan.net/poem22214.html","الوافر"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20984","الرمل"],[119,"ينادي وضيع العرق هل من مماثل","https://www.aldiwan.net/poem40853.html","عموديه"],[154,"يهن الجزيرة منك أي حسام","https://www.aldiwan.net/poem68464.html","الكامل"],[164,"ألا قللا ما بي تقر عيونها","https://www.aldiwan.net/poem58783.html","الطويل"],[234,"ليهن الملك مالكه الجديد","https://www.aldiwan.net/poem51155.html","الوافر"],[242,"لقيت يا رب من غمور","https://www.aldiwan.net/poem18813.html","مجزوء البسيط"],[255,"عودته أنه يجني وأعتذر","https://www.aldiwan.net/poem14956.html","البسيط"],[264,"دعوت وجودي حيث ما ثم داعيا","https://www.aldiwan.net/poem35965.html","الطويل"],[276,"طيف الخيال من النيابتين سرى","https://www.aldiwan.net/poem52115.html","البسيط"],[303,"مالي أرى القوم بعد الحزن في طرب","https://www.aldiwan.net/poem36814.html","عموديه"],[310,"أعيذ صفاء الود من كدر العتب","https://www.aldiwan.net/poem56604.html","الطويل"],[369,"إلى من يشار بهذا العذل","https://www.aldiwan.net/poem60798.html","المتقارب"],[369,"ألم تريا أن الحمول تسير","https://www.aldiwan.net/poem60891.html","الطويل"],[408,"الحمد لله نلنا السؤل والأربا","https://www.aldiwan.net/poem46548.html","البسيط"],[438,"احكم على الثقلين الإنس والجان","https://www.aldiwan.net/poem12753.html","البسيط"],[449,"وشب بأرض بوليفا","https://www.aldiwan.net/poem55925.html","عموديه"],[484,"فم الإحساس أصبح في افترار","https://www.aldiwan.net/poem37620.html","الوافر"],[556,"سلا عنا المنازل لم بلينا","https://www.aldiwan.net/poem47176.html","الوافر"],[556,"لمن ضرم أعلى اليفاع تعلقا","https://www.aldiwan.net/poem47366.html","الطويل"],[556,"أمنك سرى طيف وقد كان لا يسري","https://www.aldiwan.net/poem47792.html","الطويل"],[569,"سرور المعالي عاد والعود اجمل","https://www.aldiwan.net/poem884.html",""],[592,"أمور القضا ليست بحكم العوالم","https://www.aldiwan.net/poem11521.html","عموديه"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53711","الخفيف"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34426","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38334","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37894","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59111","الطويل"],[1132,"","https://poetry.dctabudhabi.ae/diwan/poem/121088","الخفيف"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112827","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112926","الوافر"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93145","الرجز"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122053","الطويل"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137937",""],[2211,"","https://poetry.dctabudhabi.ae/diwan/poem/121918","الطويل"],[2211,"","https://poetry.dctabudhabi.ae/diwan/poem/121907","الوافر"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121177","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93925","الوافر"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104679","البسيط"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118791","المتقارب"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134010","الوافر"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133994","البسيط"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104362","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89232","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86261","الوافر"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108051","الخفيف"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66368","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66363","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110079","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110085","الطويل"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118748","المتقارب"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85236","الطويل"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32767","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90798","الطويل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81925","الكامل"],[4516,"","https://poetry.dctabudhabi.ae/diwan/poem/66930","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72543","الطويل"],[4679,"أأذنبَ في لونه الأسودُ","https://www.poetsgate.com/ViewPoem.aspx?id=142773",""],[4902,"رثاء الامير احمد بن سلمان","https://www.poetsgate.com/ViewPoem.aspx?id=22854",""],[4927,"عيد الميلاد","https://www.poetsgate.com/ViewPoem.aspx?id=32634",""],[5344,"الله يسامحك ..","https://www.poetsgate.com/ViewPoem.aspx?id=180710",""],[5490,"خضر عروش الروح","https://www.poetsgate.com/ViewPoem.aspx?id=176332",""],[5525,"زمان الشح","https://www.poetsgate.com/ViewPoem.aspx?id=943",""],[5536,"أعطني الناي َ وغنيّ !!","https://www.poetsgate.com/ViewPoem.aspx?id=23194",""],[4623,"خليلي زدني من مديح محمد ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146771",""],[5759,"أقولُ لها","https://www.poetsgate.com/ViewPoem.aspx?id=214106",""],[5770,"إلى وردة","https://www.poetsgate.com/ViewPoem.aspx?id=183281",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[6113,"سر الجاذبيه","https://www.poetsgate.com/ViewPoem.aspx?id=120889",""]],"verses":[["وشنّوا على وَلَدَيْ يَعْرُبٍ","غِواراً يُضَرِّمُ حَرْباً زَبُونا",0,"ن",2,0],["وشَنصِل وشَنصِل ثمَّ شَنصِل عَشَنصَلٍ","عَلى حاجِبي سَلمى يَزِينُ مَعَ المُقَل",1,"ل",1,0],["وَشَنَّ عَلى ذي الخالِ خَيلاً تَناهَبَت","سَماوَةُ كَلبٍ بَينَها وَعُراعِرُ",2,"ر",1,0],["وشُنَّتْ لها في آل أخدرَ غارةٌ","كما شُبَّ أُلْهوبٌ الحريقِ المضرَّمُ",3,"م",1,0],["وشُنَّتْ عليه للمَجانينِ غارَةٌ","فأصبحَ نَهباً بينَهم يُتَقَسَّمُ",4,"م",1,0],["وشَنَّ على الحُورِ الكواعبِ غارَةً","أغارَ بها غِيدَ النِّساءِ وحُورَها",5,"ر",3,0],["وَشَنَّ عَلى عُربِ العَذارينَ غارَةً","يَضيقُ بِها في البَرِّ واسِعُ رَحبِهِ",6,"ب",2,0],["وشنّفَ أذْني بالهوى حُسْنُ منطقٍ","بنجواه غازلتُ الغزال المشنّفا",7,"ف",2,0],["وَشَنَّفنَ المَسامِعَ قائِلاتٍ","وَكَلَّمنَ القُلوبَ مُكَلِّماتِ",8,"ت",1,0],["وشَنَّعوا أَنَّ وَراءَ الفَجِّ","خمسينَ ألفاً من رجالِ العِلْجِ",9,"ج",1,0],["وشَنيبٌ كالأَقاحي شابَهُ","نُضحُ ماءِ الُمزنِ في غَيرِ صَرَد",10,"د",1,0],["وشن الاداني خيب الله سعيهم","على الدين والاسلام غارة قاتل",11,"ل",1,0],["وشننتها كالسيل في عرصاتهم","والنار تحت الريح فوق ضرام",12,"م",1,0],["وشنّفتُ أعطاف الكلام فصيحة","تبسم ثغرا من معانٍ يزينَها",13,"ن",3,0],["وشنّ على العِدَا من كلّ فَجّ","كتائبَ لاتُحَاد ولا تحِيدُ",14,"د",1,0],["وَشُنَّ يَا رَبَّنَا عَلَيْهِ","غَارَاتِ زِلْزَالِكَ الْمُبِيرِ",15,"ر",1,0],["وشنِّف السمعَ من ألفاظ مِقوله","فإِنه بَحرُ علمٍ كُلُّهُ دُرَرُ",16,"ر",1,0],["وَشَنَّ لِيَ الغاراتَ تَعدو وَقَد غَدَت","عَلَيَّ بِعادي الجور تَعدو العَوادِيا",17,"ي",2,0],["وَشن غاراته في كل ناحية","وَقامَ لِلَّه والاسلام منتصرا",18,"ر",2,0],["وشُنِّفَتْ أسمُعٌ قدْ كان أوقرها","رنينُ فاجِعةِ الأحداثِ والنوَب",19,"ب",1,0],["وَشُنّت عليه غارةٌ من بلاغةٍ","يَسيرٌ بها أن تُلحق التبر بالتربِ",20,"ب",1,0],["وشَنُّوا الحُروبَ على أصفهان","لِيُخْرِجَ منها الأعزَّ الأذلّ",21,"ل",1,0],["وشَنَّ عليَّ الشّيبُ من أَجلِ حَرْبها","دِلاصاً له في العارِضَينِ قَتير",22,"ر",1,0],["وشنَّ غاراته حتّى أثار بهِ","حرباً ضروساً تثير الويلَ والحَرَبا",23,"ب",2,0],["وشنّ دِرْعاً على درّاعةٍ فزَرى","بكلِّ صاحبِ إيوانٍ وديوانِ",24,"ن",1,0],["وشنّت أمّة الطليا","ن حرب الثأر والنهم",25,"م",1,0],["وشنف بالمكارم كل سمع","ورددها بسجعات الكناري",26,"ر",2,0],["وشَنْباءٍ المضاحك من نِزارٍ","فقدتُ لحسنِ بهجتها القَرِينا",27,"ن",2,0],["وَشنباءَ تستدعي العَزوفَ إلى الصِّبا","فَيعلقها السّالِي الّذي ما تعلّقا",28,"ق",2,0],["وَشَنعاءَ جاءَت مِن لسانِ سَفيهكمْ","تَصاممتُها عمداً وما بِيَ من وَقْرِ",29,"ر",1,0],["وشن عليهم غارة اثر غارةٍ","بيوم به عن طفلها الأم تذهل",30,"ل",1,0],["وشن عليهم غارة بعد غارة","على غرة منهم وذا فعل حازم",31,"م",1,0],["وشنئنا المؤاجرين فملنا","بعد خُبْرٍ إلى وصالِ القحابِ",32,"ب",1,0],["وَشنَّفَ سَمعي حينَ أَعجمتُ أَوّلاً","لَهُ ولأن العينَ عِندي نونُ",33,"ن",1,0],["وَشَنَّفت مِن ذاكَ الحَديثِ مَسامِعي","بِدُرٍّ يَزين البكرَ ما بَينَ أَترابِ",34,"ب",1,0],["وَشَنِّفْ بِأَذكارِ الحبيبةِ مَسمَعي","فَتِلكَ لَهُ قرطٌ هَوَتهُ الكَواعِبُ",35,"ب",1,0],["وَشَنَّ بِهِ الغَارَاتِ حَتَّى لَقَدْ غَدَا","وَعَقْلُ الَّذِي خَلفَ المَعَاقِلِ عَاقِلُ",36,"ل",1,0],["وشنوا على أسماعنا كل غارةٍ","وقل حماتي عند ذاك وأنصاري",37,"ر",2,0],["وشنا على عبد ضعيف أغارة","وطائفة الأهواء واللهو معهما",38,"م",2,0],["وشنف فزت أسماع الكرام","أهيل الحب في الوجه الصبيح",39,"ح",1,0],["وَشُنَّ غارَاتِ العَطَايَا شَنَّةً","وَكَسبَكَ الحمدَ اتَّخِذهُ سُنَّةً",40,"ه",1,0],["وشنف الأسماع في ذكر التي","من الغواني الغيد ربات الحجى",41,"ا",1,0],["وَشَنَّتْ مِنَ التَّبْرِيحِ وَالوَجْدِ غَارَةً","يَضِيقُ عَلَى رَبِّ الحُرُوبِ مَجَالُهَا",42,"ل",3,0],["وشنَّت على الاعداءِ أصدق غارةٍ","مُضعضعةً منها قواها وقاهره",43,"ر",2,0],["وشن غويرات وظن بجهله","تقوم لمثلى عند خطب مآتم",44,"م",1,0],["وشنى غارة فيمن تركت","فما في العيش بعد أبى انتفاع",45,"ع",1,0],["وشنفت اسماع الورى بلآلىء","لجيد مديح السبط انظمتها درا",46,"ر",2,0],["وَشَنجَ شَنجُو فَوقَهَا عُرُوق","إحذَرَ مِنهَا وَهيَ في الطَّرِيق",47,"ق",1,0],["وشنف باسم من أهواه سمعي","وأعرض عن تلاحين المثاني",48,"ن",2,0],["وشنفت منه آذان القبول لها","إلا وحاز نصيباً من معانيها",49,"ي",3,0],["وشنّف ليَ الكأس كي أرتوي","وأشفِ فؤادي فإني سقيم",50,"م",1,0],["وشنف مسمعيك بمطربات","بها الأرواح طابت مستزيده",51,"د",2,0],["وشنف السمع من انباء همته","فان كل مهم طوع ايديها",52,"ي",3,0],["وشن على النصاب داهية شنعا","مقام علي طاهر القلب عفه",53,"ه",1,0],["وشنَّع حالات الضلال بهديه","فوجه الهدى من بعد أن فات أشنع",54,"ع",1,0],["وَشنف سَمع نَدمان بِمَدح","لِمَن حازَ الكَمال مَع الجَلال",55,"ل",1,0],["وشنارٌ أن يخجل المرءُ ممن","عدَّ بين الحمير في الطبقات",56,"ت",1,0],["وشننت فيهم للنوائب غارة","أودى بها القاصي معاً والداني",57,"ن",2,0],["وشنّوا عليه إذ أتى كل غارةٍ","وشبّوا ضراماً بات بالحقد مشعلا",58,"ل",2,0],["وشَنَّ علينا غارةً ثائرُ الرَدَى","ونادت أَيا لِلثارِ فينا لَهاذمُه",59,"م",2,0],["وشِنشِنةٌ ما شانَها قَطُّ وَصمةٌ","وخِيمٌ لهُ تعنُو شَمَالُ النواسمِ",60,"م",1,0],["وشنّوا على ضدّهم غارة","فإن لم تكن شغلوا بالقِرى",61,"ر",2,0],["وشن على الأعراب غارات محنق","وأنهلهم صاب الردى بالمصائب",62,"ب",1,0],["وَشَنِئتُ أَخبارَ الزُبَيرِ","وَما رَواهُ مِنَ النَسَب",63,"ب",1,0],["وشنفت الأسماع أصوات صيته ال","ذي هز أعطاف الملوك الأكارم",64,"م",1,0],["وشنيبُ ثغرٍ في فم أم لؤلؤٌ","نظموه في سلكٍ من المرجان",65,"ن",1,0],["وشنفت مسمعي صبحاً رطانتهم","وقال قائلهم للعير جرجاري",66,"ر",2,0],["وشنت عليها غارة تفضح الدجا","فغابت ومن شمس الضحى اتخذت ترسا",67,"س",2,0],["\"وشنقاً بسلك\"\"التلغراف\"\"\"","يهلكَ لله ما ذلك المشهدُ",68,"د",1,0],["وش نام \"بالعود \"غير حصان ربعه جسور","وش قام بالصدر غير الحزن قومه مجار",69,"ر",1,0],["وَشَنُّوْا - فِيْ جَرَاْئِدِهِمْ - هُجُوْماً","عَلَىْ مَنْ لاْذَ بِالصَّبْرِ الْجَمِيْلِ",70,"ل",1,0],["وش ناتج الحب كانك ما تشاركني","واشاركك فرحتك واشاركك همك..",71,"ك",1,0],["وشنفتَ في نجوى القلوب شغافَها","فأسلمتَها للنور في الظلماتِ",72,"ت",1,0],["وش نقول اليوم ياطفال القهر","في القصايد ذل والله العظيم",73,"م",1,0],["وش نبي با الشمع والمصباح والعازف ونايه","اطفها نورك يكفي و( اعطني الناي َ وغني)",74,"ن",2,0],["وشنف به سمعي بجمع أحبتي","وأرغم به انف الأعادي وحسدي",75,"د",2,0],["وشَنّوا ضَروساً نحوَ عسكرِ همَّتي","لما رفَّ طرفي أو تقلَّصَ حاجبُ",76,"ب",1,0],["وشَنَّفَ أذني نداءٌ رخيمٌ","رقيقٌ شجيًّ كسجعِ اليمام",77,"م",1,0],["وشنف بذكر الأكرمين مسامعي","فذكرهم يحلو على كل صيغةِ",78,"ه",1,0],["وش نيوتن مانيوتن لعنبو جد اكتشافه","والله ان عيون هذي فيها سرّ الجاذبيّه",79,"ي",2,0]]}