{"poems":[[74,"أمنزل ذات الخال حييت منزلا","https://www.aldiwan.net/poem20541.html","الطويل"],[53,"أمامك فانظر أي نهجيك تنهج","https://www.aldiwan.net/poem9253.html","الطويل"],[47,"قلب مشوق عناه البث والكمد","https://www.aldiwan.net/poem62734.html","البسيط"],[47,"هزيع دجا في الرأس بادره بدر","https://www.aldiwan.net/poem64537.html","الطويل"],[68,"عزمت يا متلفي على السفر","https://www.aldiwan.net/poem39640.html","المنسرح"],[77,"سرى وجناح الليل أقتم أفتخ","https://www.aldiwan.net/poem69093.html","الطويل"],[92,"إلى الباجة جي \" في نكبته\"","https://www.poetsgate.com/ViewPoem.aspx?id=179138",""],[124,"غذائي الحب يا من فيه حرمان","https://www.aldiwan.net/poem49336.html","البسيط"],[146,"كما قلتما برء الصبابة في الياس","https://www.aldiwan.net/poem58452.html","الطويل"],[147,"إباؤك للمجد أن يبتذل","https://www.aldiwan.net/poem11800.html","المتقارب"],[173,"طما بحر الهموم به فمادا","https://www.aldiwan.net/poem1620.html",""],[234,"إذا حان من شمس النهار غروب","https://www.aldiwan.net/poem51242.html","الطويل"],[287,"لئن نأت بعد قرب منكم الدار","https://www.aldiwan.net/poem32761.html","البسيط"],[382,"أزل يا شقيق الروح مني بقيتي","https://www.aldiwan.net/poem66906.html","الطويل"],[563,"لقد قيل لي ما الفرق عند أولي الذكر","https://www.aldiwan.net/poem34496.html","الطويل"],[592,"وقول أبي العباس أحمد أنها","https://www.aldiwan.net/poem11498.html","عموديه"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137566",""],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63786","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119863","الكامل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109030","الطويل"],[2126,"","https://poetry.dctabudhabi.ae/diwan/poem/100548","الطويل"],[3216,"","https://poetry.dctabudhabi.ae/diwan/poem/198803","الطويل"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119455","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58155","الكامل"],[4526,"","https://poetry.dctabudhabi.ae/diwan/poem/75840","الوافر"],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[4914,"بمن أتداوى والدوا معك وسدوا","https://www.poetsgate.com/ViewPoem.aspx?id=170940",""],[4935,"بك التقوى يلوح لنا سناها","https://www.poetsgate.com/ViewPoem.aspx?id=129506",""],[4935,"محمد جودك الا وفى تسامى","https://www.poetsgate.com/ViewPoem.aspx?id=129503",""],[5582,"أَسِيرُ غَرامٍ ذائِبُ القَلْبِ مَعْمُودُ","https://www.poetsgate.com/ViewPoem.aspx?id=63499",""]],"verses":[["يؤيد خدّيه يدٌ ضربت به","دراكاً فما تحتاج كالبيض صيقلا",0,"ل",2,0],["يؤيده ركنان ثَبْتان رَجْلُهُ","وخيلٌ كأَرسال الجراد وأَوْثَجُ",1,"ج",1,0],["يُؤَيِّدُ المُلكَ مِنهُ نُصحَ مُجتَهِدٍ","لِلَّهِ يُسرِعُ بِالتَقوى وَيَتَّئِدُ",2,"د",1,0],["يُؤَيِّدُ مِنها كُلَّ ما ضاقَ أَيدُها","بِهِ وَيُداوي كُلَّ ما عَزَّ أَن يَبرو",3,"ر",2,0],["يُؤيِسُني مِن لِقاكَ قَولُهُمُ","بِأَنَّهُ لا رُجوعَ لِلقَمَرِ",4,"ر",1,0],["يؤيّدهُ المقدارُ بالِغَ أمْرِهِ","ويُمْدَحُ بالسَّبْع المَثاني ويُمدَخ",5,"خ",1,0],["يؤّيدهُ ذهْنٌ خصيبٌ ومنطقٌ","متينٌ كهُدابِ الدِمَقْسِ وناعم",6,"م",1,0],["يوي تعاقبها الغصن الرطيب ولا","يبقى على الغصن أن الغصن قينان",7,"ن",1,0],["يؤيده الرحمن في كلِّ موقفٍ","بنصر يعود الليثُ وهو به خاسِ",8,"س",1,0],["يُؤَيِّدُهُ حَدُّكَ المُتَّقى","وَيَعضُدُهُ جَدُّكَ المُقتَبَل",9,"ل",1,0],["يُؤَيِّدُ خاطِري وَيُجيدُ فِكري","وَأَجعَلُهُ لِما أَبني عِمادا",10,"د",2,0],["يُؤَيِّده رأيٌ يلوح نجاحُه","كما لاح عَضْبُ الشَّفْرَتيْنِ قَضِيب",11,"ب",1,0],["يُؤيِّدُ البَدءَ بِالعَودِ الجَميلِ بِلا","مَنٍّ فَنائِلُهُ المِدرارُ إِدرارُ",12,"ر",1,0],["يؤيدهم ذاك المعزِّي لقوله","تَقوَّوا أنا معكم مدى كل حجة",13,"ه",1,0],["يؤيد هذا قوله جئت من أبي","إليكم أبوه الروح منه أتى يبري",14,"ر",2,0],["يؤيده نص ببئر بضاعة","فراجعه لا تكسل ولا تتبلد",15,"د",1,0],["يؤيد هذا المقال امتحان","دقيق بكل مكان جرى",16,"ا",1,0],["يؤيَّدُ جيشُهُ بجيوشِ نصرٍ","تسيرُ على النجاحِ إِذا تسير",17,"ر",1,0],["يؤي مجاريه ويضحي جاره","حرما على ريب الزمان محرَّما",18,"م",2,0],["يؤيّد جمهورية القوم ظاهراً","ويهدمها كي يبلغ الملك بالسّر",19,"ر",1,0],["يؤيده رب البرايا على الورى","وتقدمه الأملاك والفتح والنصر",20,"ر",1,0],["يؤيدك الرحمن بالخير والتقى","ألستَ سليل الخيّرين ابنَ زايد",21,"د",1,0],["يؤيدها عتبي عزم مؤيد","بحزم يخلي خلفه البيض ظلعا",22,"ع",2,0],["يؤيدُها دمعٌ على الذنب ساكبٌ","بزهد وإخبات عن اللهو عاصمِ",23,"م",1,0],["يؤيَّهُ وَاللَهيفَ بوارداتٍ","كَما يَتغاوثُ الحِسي النَزيفُ",24,"ف",1,0],["يؤيده سلطان عين يقينه","بحق يقين بالعيان لأعيان",25,"ن",1,0],["يؤيد فيها للحنيف شريعة","فيزهق غي الشرك حين يؤيد",26,"د",1,0],["يؤيدك الآله فدم بخير","مع الانجال واسعد في ولاها",27,"ا",3,0],["يؤيدك الاله بخير سعد","وثغر الدهر يوليك ابتساما",28,"م",2,0],["[ يُؤَيِّدُهُ زَيْدُ بنُ كَهْلانَ فِي الْعُلا","وَيَرْفَعُهُ فِيما تَسَنَّمَهُ هُودُ ]",29,"د",1,0]]}