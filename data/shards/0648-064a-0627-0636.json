{"poems":[[55,"كيف أضاء البرق إذ أومضا","https://www.aldiwan.net/poem30175.html","السريع"],[74,"واحيلتي بظلام الطرة الداجي","https://www.aldiwan.net/poem18450.html","البسيط"],[47,"أما كان في تلك الدموع السوائل","https://www.aldiwan.net/poem65638.html","الطويل"],[92,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[47,"أَمَا كَانَ في تَلْكَ الدُّموعِ السَّوائلِ","https://www.poetsgate.com/ViewPoem.aspx?id=32192",""],[119,"بدأت ببسم الله في مبدأ الأمر","https://www.aldiwan.net/poem42205.html","الطويل"],[325,"أيا حامل الرمح الشبيه بقده","https://www.aldiwan.net/poem67089.html","الطويل"],[333,"تعالي يابنة الأحلام","https://www.aldiwan.net/poem54976.html","الهزج"],[347,"أيا ضباب حياتي","https://www.aldiwan.net/poem55343.html","المجتث"],[563,"بأسماء رب العالمين ابتدائيا","https://www.aldiwan.net/poem33573.html","الطويل"],[748,"","https://poetry.dctabudhabi.ae/diwan/poem/131362","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59421","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84482","البسيط"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64510","الطويل"],[1680,"","https://poetry.dctabudhabi.ae/diwan/poem/81895","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49584","المتقارب"],[2211,"","https://poetry.dctabudhabi.ae/diwan/poem/121914","الوافر"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105672","الطويل"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/128238","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206149","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117844","الطويل"],[3749,"","https://poetry.dctabudhabi.ae/diwan/poem/33125","البسيط"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66535","المتقارب"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33674","البسيط"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89587","الطويل"],[4649,"","https://poetry.dctabudhabi.ae/diwan/poem/101938","الطويل"],[4963,"المهره اللي يتل القلب طاريها!!!","https://www.poetsgate.com/ViewPoem.aspx?id=34635",""],[5136,"بمن يستغيث العبد إلا بمولاه","https://www.poetsgate.com/ViewPoem.aspx?id=121766",""],[5338,"دمشق الصمود دمشق الفدا","https://www.poetsgate.com/ViewPoem.aspx?id=189744",""],[592,"تجانف هذا المارق الماذق الأشقى","https://www.poetsgate.com/ViewPoem.aspx?id=128797",""],[5525,"هداج","https://www.poetsgate.com/ViewPoem.aspx?id=7284",""]],"verses":[["وَيا ضِياءً إِن نَأى نورُهُ","لَم نَرَ يَوماً بَعدَهُ أَبيَضا",0,"ض",2,0],["ويا ضلالَ رشادِي في هوَى صنمٍ","لا شيء أهتك لي من طرفه الساجي",1,"ج",2,0],["وَيا ضَيعَةَ الثَغرِ الرَقيقِ إِذا سَرى","لِتَقبيلِهِ رَشفاً بِتِلكَ الجَحافِلِ",2,"ل",1,0],["ويا ضجِيعَي كرًى أعمى يلفُّهما","لفَّ الحبيبين في مطمورةٍ دُون",3,"ن",1,0],["وَيا ضَيْعَةَ الَُّغرِ الرَّقيقِ إِذا سرَى","لِتَقْبيلِهِ رَشْفاً بِتِلْكَ الجَحَافِلِ",4,"ل",1,0],["ويا ضار لا تطرق بضرك ذلتي","ويا نافع انفعني ويا نور كن فخري",5,"ر",2,0],["وَياضامِراً حيفاً لِأَسرى جَمالِهِ","وَيالا شاهِراً سَيفاً حَكى لَحظَةَ عَقَبا",6,"ب",2,0],["ويا ضيعةَ دنيانا","إذا ولى ولم نعلم",7,"م",1,0],["ويا ضباب حياتي","متى تحول هواء",8,"ا",2,0],["ويا ضار من كل المضرات وقِّنى","ويا نافع انفعني وغطِّى المساويا",9,"ي",2,0],["ويا ضاحكا للضّيف حين زمانه","قضى عن نؤ عارض غير ضاحك",10,"ك",1,0],["ويا ضليلا عن النهج القويم أما","هدتك للمقصد الأسنى دلالات",11,"ت",1,0],["وَيا ضَجيعاهُ في قَبرٍ حَوى شَرفاً","عَلَيكُما مِن إِلَه العَرشِ تَجليلُ",12,"ل",1,0],["ويا ضارّ حال النفع عمن أردته","بضر وكشف الضر ملك الألوهة",13,"ه",1,1],["وَيَا ضَارُّ كُنْ لِلْحَاسِدِينَ مُوَبِّخاً","وَيَا نَافِعُ أنْفَعْنِي بِرُوحِ مُحَصَّلاَ",14,"ل",2,0],["ويا ضيعتا بين رَبْعٍ عَفَا","وخلٍّ جفا وَشَبَابٍ رَحَل",15,"ل",1,0],["وياضيف المشيب سبقت وقتا","به لو جئت كنت على صواب",16,"ب",1,0],["ويا ضيعة الأحلام في بلد به","أخو الحلم في أهل السفاهة يقتدي",17,"د",2,0],["ويا ضريحاً على هام السماك علا","عليك من صلوات الله أزكاها",18,"ا",3,0],["ويا ضيعة النفس التي لا يجيرها","من البث والشكوى سواك مجير",19,"ر",1,0],["ويا ضربة عنها الأمينُ ابن عمه","بصادق وحي الله نبا وخبرا",20,"ر",2,0],["وَيا ضُحى السَبتِ ما لِلقَومِ قَد سَبَتوا","تَهَوَّدوا أَم بِكَأسِ الطَعنِ قَد سَكِروا",21,"ر",3,0],["وَيا ضَريحَ شُعَيبٍ ما لَهُم جَثَموا","كَمِديَنَ أَم لَقوا رَجفاً بِما كَفَروا",21,"ر",3,0],["وَياضَجيعَ التُّرْبِ أَقْلَقْتَني","كَأَنَّما فَرْشِيَ شَوكُ القَتادْ",22,"د",1,0],["ويا ضياءَ بنِ من شمسٍ ومن قمرٍ","يحويهما قَدُّهُ غُصنٌ من البانِ",23,"ن",1,0],["وَيا ضَيفُ لا تَعدِل عَنِ الدارِ وَالفِنا","وَيا ضَيفُ إِنزِل فَالنُزولُ سُرورُ",24,"ر",1,0],["ويا ضيعة الإسلام والعلم والتقى","لفقد الإمام الأروع المتهجد",25,"د",1,0],["وياضيعة اللي نصيبه مايوافيها","حظه تردى وعنه الباب مردودي",26,"د",2,0],["وياضار هل للضر غيرك كاشف","ومن تحمه فالضر حقاً تحاماه",27,"ا",2,0],["وَيَا ضِحْكَةً فِي فَمِ الْمُغْرِيَاتِ","تُغِيضُ الحَقُودَ وَتُنْسِي الرَّدَىٰ",28,"د",2,0],["ويا ضيعة الدين الحنيفي عند من","يسوم له خسفاً ويرجو له محقا",29,"ق",2,0],["ويا ضايعٍ في غابة الحبر الأسود","ضاع العمر ما جبت حرفين من عاج",30,"ج",1,0]]}