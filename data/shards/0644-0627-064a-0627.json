=213725",""],[5573,"البارحه خايلت وصلك سحابه","https://www.poetsgate.com/ViewPoem.aspx?id=213729",""],[5652,"وطن ال بدون !!","https://www.poetsgate.com/ViewPoem.aspx?id=176984",""],[5652,"وتبقى لك العزوه عدود وعشاير","https://www.poetsgate.com/ViewPoem.aspx?id=190144",""],[5667,"البحر","https://www.poetsgate.com/ViewPoem.aspx?id=214837",""],[5677,"مجرد رأي","https://www.poetsgate.com/ViewPoem.aspx?id=179850",""],[5691,"وفاق","https://www.poetsgate.com/ViewPoem.aspx?id=206444",""],[5704,"العيْنُ بالعين ...","https://www.poetsgate.com/ViewPoem.aspx?id=198786",""],[5725,"مالي ارى الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=215175",""],[5764,"الليل فضّاح","https://www.poetsgate.com/ViewPoem.aspx?id=137062",""],[5776,"رملٌ يسافرُ بالواحة","https://www.poetsgate.com/ViewPoem.aspx?id=199342",""],[402,"يا عائدا برعاية الرحمن","https://www.poetsgate.com/ViewPoem.aspx?id=36542",""],[402,"سوى الحب لا تشفي الفؤاد المكلما","https://www.poetsgate.com/ViewPoem.aspx?id=36334",""],[5790,"أنظرت أم فوقت سهما","https://www.poetsgate.com/ViewPoem.aspx?id=112135",""],[469,"أعاذلتي كُفّي ثكلتِ عن العذلِ","https://www.poetsgate.com/ViewPoem.aspx?id=76855",""],[5842,"إشراقات الأمل / محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=105051",""],[5865,"إلى أصدقائي","https://www.poetsgate.com/ViewPoem.aspx?id=179880",""],[5873,"رنق العيش","https://www.poetsgate.com/ViewPoem.aspx?id=215357",""],[5873,"المجالدة على الآمال","https://www.poetsgate.com/ViewPoem.aspx?id=215413",""],[5873,"المدلة بالجمال","https://www.poetsgate.com/ViewPoem.aspx?id=215918",""],[5875,"عبق الخزامى","https://www.poetsgate.com/ViewPoem.aspx?id=37155",""],[5939,"بي لها","https://www.poetsgate.com/ViewPoem.aspx?id=179999",""],[5956,"لا تخاليني تاركا","https://www.poetsgate.com/ViewPoem.aspx?id=182147",""],[5956,"لا تحَرّضني على الانتقام لنفسي","https://www.poetsgate.com/ViewPoem.aspx?id=192991",""],[6046,"لا ياس مع الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=35245",""],[6052,"دارنا","https://www.poetsgate.com/ViewPoem.aspx?id=34810",""],[4442,"براعم الروضة أعللها النطف","https://www.poetsgate.com/ViewPoem.aspx?id=171004",""],[6142,"مذ صلصل الله من طين خليقته","https://www.poetsgate.com/ViewPoem.aspx?id=155709",""],[1583,"عيناكِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73061&r=&rc=18",""],[6072,"أرَقٌ وغَرَق !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82190&r=&rc=22",""],[5080,"أشجرت ذاتك في أحشاء تربته","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88137&r=&rc=7",""],[6259,"عبسن من شعرٍ في الرأس مبتسمِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59397&r=&rc=45",""],[2220,"لما تألفتِ الأشياء بالألف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11566&r=&rc=440",""]],"verses":[["لا يَأمَنُ الدَهرَ عَلى غِرَّةٍ","وَعَزَّ لَيثُ الغابِ أَن يُؤمَنا",0,"ن",2,0],["لَأياً يُجاهِدُها لا يَأتَلي طَلَباً","حَتّى إِذا عَقلُهُ بَعدَ الوَنى ثابا",1,"ب",2,0],["لا يَأخُذُ الرَشوَةَ في حُكمِهِ","وَلا يُبالي غَبَنَ الخاسِرِ",2,"ر",1,0],["لا يَأمَنُ السامِعُ المِسكينُ وَثبَتَهُ","مِن كُردُفانِ إِلى أَعلى فِلَسطينِ",3,"ن",1,0],["لا يَأتَلي لِدَوامِ مُلكِكَ داعِياً","وَإِلى وَلائِكَ في المَحافِلِ داعي",4,"ع",2,0],["لا يَأسَ رُبَّ دُنوِّ دارٍ جامِعٍ","لِلشَملِ قَد أَدّى إِلَيهِ بِعادُ",5,"د",1,0],["لا يَأمَنُ الأَعداءُ رَجمَ ظُنونِهِ","إِنَّ الغُيوبَ وَراءَها إِمدادُ",5,"د",1,0],["لا يَأخُذُ الخَسفَ في قَومٍ فَيَغضِبَهُم","وَلا تَراهُ إِذا ما قامَ مَحدودا",6,"د",2,0],["لا يَأْخُذُ الأَبْصَارَ نُورٌ هَابِطٌ","مُتَوَانِياً كَهُبُوطِهَا المُتَوانِي",7,"ن",2,0],["لأْياً يُثَابُ بِهِ فَقِيدٌ لَمْ يَكُنْ","فِي قَوْمِهِ لِيُثَابَ بِالنِّسْيَانِ",8,"ن",1,0],["لا يَأْتَلِيهَا دَرّاً وَبِرّاً","كَمَا تَبَرُّ الأُمُّ البَنِينَا",9,"ن",2,0],["لأَيَّ المُلُوكِ الصِّيدِ صَرْحٌ مُمَرَّدٌ","كَبُرْجٍ وَمَا الأَبْرَاجُ مِنْهُ بِأَفْحَمَا",10,"م",2,0],["لآياتِ الحِجَى وَالقَلبِ فِيهِ","رَوَائِعُ تَسْتَبِي لُبَّ الحَلِيمِ",11,"م",1,0],["لا يَأمَنانِ سِباعَ الَليلِ أَو بَرَدا","إِن أَظلَما دونَ أَطفال لَها لَجَبُ",12,"ب",1,0],["لأي أمر ذِهِ الليالي","تأتي وتمضي على الوِلاء",13,"ا",2,0],["لا يَأمَنَنَّ قَوِيٌّ نَقضَ مِرَّتِهِ","إِنّي أَرى الدَهرَ ذا نَقضٍ وَإِمرارِ",14,"ر",1,0],["لا يَأمَنونَ عَلى الأَدِلَّةِ هَولَها","إِلّا بِأَشجَعَ صادِقِ التَصميمِ",15,"م",1,0],["لا يأتلي منهم إمامُ سيادةٍ","من أن يبذّ النيراتِ مراتِبا",16,"ب",2,0],["لأيام مولانا العزيزِ عواطفٌ","على قاصديهِ من ندًى وثواب",17,"ب",1,1],["لا يأمننَّ السفيه بادرتي","فإنني عارضٌ لمن عرضا",18,"ض",2,0],["لا يأملنَّ معاشرٌ جيَفٌ","جزْري خبائثَهم ولا أكلي",19,"ل",2,0],["لأي أمرٍ مرادٍ بالفتى جُمِعتْ","تلكَ الفنونُ فضمتْهُنَّ أفنان",20,"ن",1,0],["لا يا رَسولي لا تَذكُر لَهُ غَضَبي","فَذاكَ مِنّي تَمويهٌ وَبُهتانُ",21,"ن",1,0],["لا يأمن الماشي بار","جله سقوطا من عل",22,"ل",1,0],["لا يَأخُذَنَّ عَلى العَواقِبِ بَعضُكُم","بَعضاً فَقِدماً جارَتِ الأَحكامُ",23,"م",1,0],["لا يَأمُلُ النَفَسَ الأَقصى لِمُهجَتِهِ","فَيَسرِقُ النَفَسَ الأَدنى وَيَغتَنِمُ",24,"م",1,0],["لا يَأمَنُ البَرَّ مُفضِياً كَنَفٌ","مِنهُ وَلا البَحرَ طامِياً حَدَبُه",25,"ب",2,0],["لا يَأمَنُ الدَهرُ إِلّا الخائِنُ البَطِرُ","مَن لَيسَ يَعقِلُ ما يَأتي وَما يَذَرُ",26,"ر",1,1],["لا يَأمَنَنَّ اِمرُؤٌ مُساعَدَةَ ال","دُنيا فَإِنّي رَأَيتُها دُوَلا",27,"ل",2,0],["لا يَأمَنَنَّ اِمرُؤٌ هَواهُ","فَإِنَّ بَعضَ الهَوى جُنونُ",28,"ن",1,0],["لا يَأمَلَنَّ بَنوا أَبي الفَضلِ البَقا","إِنَّ الفَناءَ إِلَيهِمُ لَقَريبُ",29,"ب",1,0],["لا يأمنِ الأعداءُ وقعَ صوارمٍ","نامتْ مناياهُنّ في الأجفانِ",30,"ن",1,0],["لا يَأمَلُ المالُ النَجاةَ إِذا عَدا","صَرفُ الزَمانِ مُجاءَةً بِعَديمِ",31,"م",1,0],["لا يَأمَنَن أَخدَعاكَ بادِرَةً","مِن قَدعِهِ إِن أَمِنتَ مِن قَذعِه",32,"ع",2,0],["لا يَأسَفونَ إِذا هُمُ سَمِنَت لَهُم","أَحسابُهُم أَن تُهزَلَ الأَعمارُ",33,"ر",1,0],["لا يأتمرْ مِنّا الرُّماةُ بِمَقْتَلٍ","فَلَنا نِبالٌ مثلهم وسِهامُ",34,"م",1,0],["لا يَأْسَ من نَفحاتِ ربّكَ إنّني","لأرى السّنا خَلَلَ الدُّجَى يتألَّقُ",35,"ق",1,0],["لا يَأمُرونَ بِغَيرِ الظُلمِ أَنفُسَهُم","وَاللَهُ يَأمُرُهُم عَدلاً وَإِحسانا",36,"ن",2,0],["لا يأمَنُ الشَعبُ المُرَوَّعُ كَيدَهُم","إِلّا بِطاعَتِهِ وَبِاِستِسلامِهِ",37,"م",2,0],["لا يأكُلُ السِّرحانُ شِلوَ طعينهم","مما عليه من القنا المتكسِّر",38,"ر",1,0],["لا يَأيَسَنَّ فَقيرٌ مِن غِنىً أَبَداً","بَعدَ الَّذي نالَ يَعقوبُ بنُ داوودِ",39,"د",1,1],["لا يَأثَرُ الغِلَّ لِلخَليلِ وَلا","تَغلِبُهُ طَيرُهُ إِذا غَضِبا",40,"ب",2,0],["لا يأمن المدلج الساري تورُّطَهُ","ما لَم يوطِّد له من عقله سندا",41,"د",2,0],["لا يأمن الناس امرأ","خاتلهم أو قد كذب",42,"ب",1,0],["لا يأمن الماشي بلي","لٍ للظلام من العثار",43,"ر",1,0],["لا يا غرامي وهذا الفنُّ مِلءُ دمي","بالنَّار والصَّبواتِ الحمر مشَّاءُ",44,"ا",2,0],["لا يأمَنُ النَّاسُ مَمْساهُ ومُصْبَحَهُ","في كلِّ فجٍّ وإن لَم يَغْزُ يُنْتَظَرُ",45,"ر",1,0],["لا يَأْمَنُ الصَّامِتُ الْمَعْصُومُ صَوْلَتَهُ","وَلا يَدُومُ عَلَيْهِ النَّاطِقُ الْبَذِرُ",46,"ر",1,0],["لاَ يَأْتَلِي عَنْ سَعْيِه لِلْعُلَى","وَلَوْ شَاءَ كَيْوَانَ لَمْ يَأْتَلِ",47,"ل",1,0],["لا يأتلي ينشُد حقاً ولا","ينفك ان يُغضب أو يغضبا",48,"ب",2,0],["لا يأبهون بارهابٍ إذا احتدَموا","ولا بِمَصْرَعِهِمْ إن شعبُهم سَلِما",49,"م",2,0],["لايارفيقي؟؟؟ ليت .... لاشنت .. مازنت","أمرضتني وانا معندي مناعه",50,"ع",2,0],["لا يأمن الأعداء وقعَ صورام","نامتْ مناياهنّ في الأجفان",51,"ن",1,0],["لا يألمون ولا تشكو جسومهم","من اللظى فهي نيران بنيران",52,"ن",1,0],["لا يأملنَّ معاشرٌ جِيَفٌ","جزْري خباءثهم ولاأكلي",53,"ل",2,0],["لأي أمرٍ طويت الكشح عن رجل","عف الأديم لفضل فيه برهان",54,"ن",1,0],["لا يَأمَنَنَّ سُطاكَ ذو جَهلٍ بِها","ما لِلقَضاءِ وَلا لِأَمرِكَ مَدفَعُ",55,"ع",1,0],["لا يَأمَنَنَّ الشِركُ بَطشَ غَشَمشَمٍ","يُرجى لِقَطعِ فُروعِهِ وَعُروقِهِ",56,"ق",2,0],["لا يَأمَنُ العَجزَ وَالتَقصيرَ مادِحُهُ","وَلا يَخافُ عَلى الإِطنابِ تَكذيبا",57,"ب",2,0],["لا يَأمنن بعدي عطيّة حرّةً","مِنَ الناسِ أو جارٌ كريمٌ يجاوره",58,"ه",1,1],["لا يأتلي في قَتْل أَب","ناءِ النبيِّ على حَميَّهْ",59,"ي",2,0],["لا يَأمَنُ التَّبِعَاتِ إلا هائِبٌ","عَرضاً تَقَدَّمَهُ وَعيدٌ هَائِلُ",60,"ل",1,0],["لا يَأْتَلِي مِنْ ذَهَبٍ يَلُفُّهُ","مِنِّي وَمِنْ دراهِمٍ يَحُوشُها",61,"ش",3,0],["لاَ يَأْمُلُ الرّزْقَ إلاّ مِنْ مَضارِبِهِ","فَرْسُ الْهُمامِ بِأَنْيابٍ وَأَظْفارِ",62,"ر",