{"poems":[[53,"ما أسرع الأيام في طينا","https://www.aldiwan.net/poem29723.html","السريع"],[9,"بانت سعاد وأمسى حبلها رابا","https://www.aldiwan.net/poem21909.html","البسيط"],[9,"شاقتك من قتلة أطلالها","https://www.aldiwan.net/poem21944.html","السريع"],[86,"يرغي ويزبد بالقافات تحسبها","https://www.aldiwan.net/poem68854.html","البسيط"],[71,"ما سر سكان الحمى بمذاع","https://www.aldiwan.net/poem4025.html","الكامل"],[73,"للحب في تلك القباب مراد","https://www.aldiwan.net/poem11948.html","الكامل"],[10,"عيني جودا بدمع منكما جودا","https://www.aldiwan.net/poem21074.html","البسيط"],[93,"يا عائداً برعاية الرحمن","https://www.aldiwan.net/poem11169.html","الكامل"],[93,"يوم أثار كوامن الأشجان","https://www.aldiwan.net/poem11171.html","الكامل"],[93,"قضيت عمري لا مستدينا","https://www.aldiwan.net/poem11212.html","مخلع البسيط"],[93,"سوى الحب لا تشفي الفؤاد المكلما","https://www.aldiwan.net/poem11364.html","الطويل"],[93,"أصول الضاد طيبة الأروم","https://www.aldiwan.net/poem11416.html","الوافر"],[30,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[88,"من أين من أين يا ابتدائي","https://www.aldiwan.net/poem45073.html","مخلع البسيط"],[27,"حيوا المقام وحيوا ساكن الدار","https://www.aldiwan.net/poem5782.html","البسيط"],[27,"ما هاج شوقك من عهود رسوم","https://www.aldiwan.net/poem6009.html","الكامل"],[72,"عطفت كأمثال القسي حواجبا","https://www.aldiwan.net/poem18230.html","الكامل"],[72,"لأيام مولانا العزيز عواطف","https://www.aldiwan.net/poem18305.html","الطويل"],[51,"قولا لنحوينا أبي حسن","https://www.aldiwan.net/poem64969.html","المنسرح"],[51,"قومي بنو العباس حلمهم","https://www.aldiwan.net/poem65919.html","أحذ الكامل"],[51,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[70,"أنت الحبيب وما لي عنك سلوان","https://www.aldiwan.net/poem42451.html","البسيط"],[89,"قد قلت ان العقل لي","https://www.aldiwan.net/poem44853.html","مجزوء الكامل"],[85,"يا أخت أندلس عليك سلام","https://www.aldiwan.net/poem63741.html","الكامل"],[43,"عقبى اليمين على عقبى الوغى ندم","https://www.aldiwan.net/poem10529.html","البسيط"],[45,"لا الدهر مستنفذ ولا عجبه","https://www.aldiwan.net/poem10901.html","المنسرح"],[49,"لا يأمن الدهر إلا الخائن البطر","https://www.aldiwan.net/poem62087.html","البسيط"],[49,"أرى المقادير تعمل العملا","https://www.aldiwan.net/poem63065.html","المنسرح"],[49,"ما كل ما تشتهي يكون","https://www.aldiwan.net/poem63158.html","مجزوء البسيط"],[66,"سفها إذا شقت عليك جيوب","https://www.aldiwan.net/poem40296.html","الكامل"],[80,"أخذت سفاقس منك عهد أمان","https://www.aldiwan.net/poem31263.html","الكامل"],[44,"يا ربع لو ربعوا على ابن هموم","https://www.aldiwan.net/poem30351.html","الكامل"],[44,"أبو علي وسمي منتجعه","https://www.aldiwan.net/poem30461.html","المنسرح"],[44,"لا أنت أنت ولا الديار ديار","https://www.aldiwan.net/poem30516.html","الكامل"],[105,"أقبل عليك من الشعوب سلام","https://www.aldiwan.net/poem42067.html","الكامل"],[105,"من هيبة يغضي القريض ويطرق","https://www.aldiwan.net/poem42076.html","الكامل"],[105,"يا أيها الناس إن الله يأمركم","https://www.aldiwan.net/poem43081.html","البسيط"],[105,"حل الوفاء الحق عقد ذمامه","https://www.aldiwan.net/poem43101.html","الكامل"],[75,"فتقت لكم ريح الجلاد بعنبر","https://www.aldiwan.net/poem69080.html","الكامل"],[50,"لا يأيسن فقير من غنى أبدا","https://www.aldiwan.net/poem63899.html","البسيط"],[50,"يا صاحبي العشية احتسبا","https://www.aldiwan.net/poem64817.html","المنسرح"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85425","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85835","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85504","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39652","البسيط"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72235","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42635","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55173","السريع"],[90,"على الخالصي","https://www.poetsgate.com/ViewPoem.aspx?id=179083",""],[90,"فلسطين الدامية","https://www.poetsgate.com/ViewPoem.aspx?id=179033",""],[80,"أخذتْ سفاقس منك عهدَ أمانِ","https://www.poetsgate.com/ViewPoem.aspx?id=3768",""],[51,"قوْمي بنو العباسِ حلمُهمُ","https://www.poetsgate.com/ViewPoem.aspx?id=30245",""],[118,"غذائي الحب يا من فيه حرمان","https://www.aldiwan.net/poem49336.html","البسيط"],[141,"هل بعد فتحك ذا لباغ مطمع","https://www.aldiwan.net/poem11774.html","الكامل"],[141,"أرقدت عن قلق الفؤاد مشوقه","https://www.aldiwan.net/poem11787.html","الكامل"],[162,"لن تستطيع لأمر الله تعقيبا","https://www.aldiwan.net/poem67835.html","البسيط"],[168,"لا يأمنن بعدي عطية حرة","https://www.aldiwan.net/poem2036.html","الطويل"],[227,"الحر لا يأتي الدنيه","https://www.aldiwan.net/poem50732.html","مجزوء الكامل"],[273,"دنياك للأخرى سبيل سابل","https://www.aldiwan.net/poem25534.html","الكامل"],[278,"أقول واليوم بهيم خطبه","https://www.aldiwan.net/poem60605.html","الرجز"],[278,"هي الديار فعج في رسمها العاري","https://www.aldiwan.net/poem60723.html","البسيط"],[320,"بان السفاء وأودى الجهل والسرف","https://www.aldiwan.net/poem56340.html","البسيط"],[357,"ما أومض البرق بالجرداء مبتسماً","https://www.aldiwan.net/poem809.html",""],[359,"إن العواذل قد كووا","https://www.aldiwan.net/poem67582.html","مجزوء الكامل"],[361,"بالعفر دار من جميلة هيجت","https://www.aldiwan.net/poem1718.html","الطويل"],[362,"قف يا خيال وإن تساوينا ضنى","https://www.aldiwan.net/poem60630.html","الكامل"],[362,"بغرة وجهك منا القسم","https://www.aldiwan.net/poem60658.html","المتقارب"],[369,"لا مقصر عن هوى ولا سال","https://www.aldiwan.net/poem57226.html","المنسرح"],[388,"يا أيها الإنسان","https://www.aldiwan.net/poem54429.html","عموديه"],[393,"هل بالمنازل إن كلمتها خرسُ","https://www.aldiwan.net/poem587.html",""],[403,"عبسن من شعر في الرأس مبتسم","https://www.aldiwan.net/poem50128.html","البسيط"],[429,"أما الكواكب فاحتموا بمواكب","https://www.aldiwan.net/poem12405.html","الكامل"],[447,"يئس الصغار من الكبار","https://www.aldiwan.net/poem995.html",""],[456,"ألا فتى يسأل قلبي ماله","https://www.aldiwan.net/poem55905.html","الرجز"],[456,"جم لها الوادي وعز الذائد","https://www.aldiwan.net/poem56225.html","الرجز"],[456,"إذا فطمت قراره كل وادي","https://www.aldiwan.net/poem56229.html","الوافر"],[459,"الخرق يرهب لكن الأناة لها","https://www.aldiwan.net/poem15979.html","البسيط"],[459,"من مبلغ سلف الأجواد إذ سبقوا","https://www.aldiwan.net/poem16058.html","البسيط"],[462,"نسيم الصبا والليل منتظم العقد","https://www.aldiwan.net/poem3176.html","عموديه"],[462,"أنجل علي ما برحت محمداً","https://www.aldiwan.net/poem3305.html","عموديه"],[475,"لا تخدعن فتصطفي لك صاحبا","https://www.aldiwan.net/poem15315.html","الكامل"],[542,"حديقة بلا غناء","https://www.aldiwan.net/poem67250.html","عموديه"],[549,"ما للقلوب غداة السبت مزعجة","https://www.aldiwan.net/poem47250.html","البسيط"],[549,"يهون عندكم أني بكم أرق","https://www.aldiwan.net/poem47381.html","البسيط"],[549,"ريعت لتنعاب الغراب الهاتف","https://www.aldiwan.net/poem47390.html","الكامل"],[549,"تلك الديار برامتين همود","https://www.aldiwan.net/poem47881.html","الكامل"],[560,"دعاني من هوى هند وأسما","https://www.aldiwan.net/poem52779.html","الوافر"]],"verses":[["لا يَأمَنُ الدَهرَ عَلى غِرَّةٍ","وَعَزَّ لَيثُ الغابِ أَن يُؤمَنا",0,"ن",2,0],["لَأياً يُجاهِدُها لا يَأتَلي طَلَباً","حَتّى إِذا عَقلُهُ بَعدَ الوَنى ثابا",1,"ب",2,0],["لا يَأخُذُ الرَشوَةَ في حُكمِهِ","وَلا يُبالي غَبَنَ الخاسِرِ",2,"ر",1,0],["لا يَأمَنُ السامِعُ المِسكينُ وَثبَتَهُ","مِن كُردُفانِ إِلى أَعلى فِلَسطينِ",3,"ن",1,0],["لا يَأتَلي لِدَوامِ مُلكِكَ داعِياً","وَإِلى وَلائِكَ في المَحافِلِ داعي",4,"ع",2,0],["لا يَأسَ رُبَّ دُنوِّ دارٍ جامِعٍ","لِلشَملِ قَد أَدّى إِلَيهِ بِعادُ",5,"د",1,0],["لا يَأمَنُ الأَعداءُ رَجمَ ظُنونِهِ","إِنَّ الغُيوبَ وَراءَها إِمدادُ",5,"د",1,0],["لا يَأخُذُ الخَسفَ في قَومٍ فَيَغضِبَهُم","وَلا تَراهُ إِذا ما قامَ مَحدودا",6,"د",2,0],["لا يَأْخُذُ الأَبْصَارَ نُورٌ هَابِطٌ","مُتَوَانِياً كَهُبُوطِهَا المُتَوانِي",7,"ن",2,0],["لأْياً يُثَابُ بِهِ فَقِيدٌ لَمْ يَكُنْ","فِي قَوْمِهِ لِيُثَابَ بِالنِّسْيَانِ",8,"ن",1,0],["لا يَأْتَلِيهَا دَرّاً وَبِرّاً","كَمَا تَبَرُّ الأُمُّ البَنِينَا",9,"ن",2,0],["لأَيَّ المُلُوكِ الصِّيدِ صَرْحٌ مُمَرَّدٌ","كَبُرْجٍ وَمَا الأَبْرَاجُ مِنْهُ بِأَفْحَمَا",10,"م",2,0],["لآياتِ الحِجَى وَالقَلبِ فِيهِ","رَوَائِعُ تَسْتَبِي لُبَّ الحَلِيمِ",11,"م",1,0],["لا يَأمَنانِ سِباعَ الَليلِ أَو بَرَدا","إِن أَظلَما دونَ أَطفال لَها لَجَبُ",12,"ب",1,0],["لأي أمر ذِهِ الليالي","تأتي وتمضي على الوِلاء",13,"ا",2,0],["لا يَأمَنَنَّ قَوِيٌّ نَقضَ مِرَّتِهِ","إِنّي أَرى الدَهرَ ذا نَقضٍ وَإِمرارِ",14,"ر",1,0],["لا يَأمَنونَ عَلى الأَدِلَّةِ هَولَها","إِلّا بِأَشجَعَ صادِقِ التَصميمِ",15,"م",1,0],["لا يأتلي منهم إمامُ سيادةٍ","من أن يبذّ النيراتِ مراتِبا",16,"ب",2,0],["لأيام مولانا العزيزِ عواطفٌ","على قاصديهِ من ندًى وثواب",17,"ب",1,1],["لا يأمننَّ السفيه بادرتي","فإنني عارضٌ لمن عرضا",18,"ض",2,0],["لا يأملنَّ معاشرٌ جيَفٌ","جزْري خبائثَهم ولا أكلي",19,"ل",2,0],["لأي أمرٍ مرادٍ بالفتى جُمِعتْ","تلكَ الفنونُ فضمتْهُنَّ أفنان",20,"ن",1,0],["لا يا رَسولي لا تَذكُر لَهُ غَضَبي","فَذاكَ مِنّي تَمويهٌ وَبُهتانُ",21,"ن",1,0],["لا يأمن الماشي بار","جله سقوطا من عل",22,"ل",1,0],["لا يَأخُذَنَّ عَلى العَواقِبِ بَعضُكُم","بَعضاً فَقِدماً جارَتِ الأَحكامُ",23,"م",1,0],["لا يَأمُلُ النَفَسَ الأَقصى لِمُهجَتِهِ","فَيَسرِقُ النَفَسَ الأَدنى وَيَغتَنِمُ",24,"م",1,0],["لا يَأمَنُ البَرَّ مُفضِياً كَنَفٌ","مِنهُ وَلا البَحرَ طامِياً حَدَبُه",25,"ب",2,0],["لا يَأمَنُ الدَهرُ إِلّا الخائِنُ البَطِرُ","مَن لَيسَ يَعقِلُ ما يَأتي وَما يَذَرُ",26,"ر",1,1],["لا يَأمَنَنَّ اِمرُؤٌ مُساعَدَةَ ال","دُنيا فَإِنّي رَأَيتُها دُوَلا",27,"ل",2,0],["لا يَأمَنَنَّ اِمرُؤٌ هَواهُ","فَإِنَّ بَعضَ الهَوى جُنونُ",28,"ن",1,0],["لا يَأمَلَنَّ بَنوا أَبي الفَضلِ البَقا","إِنَّ الفَناءَ إِلَيهِمُ لَقَريبُ",29,"ب",1,0],["لا يأمنِ الأعداءُ وقعَ صوارمٍ","نامتْ مناياهُنّ في الأجفانِ",30,"ن",1,0],["لا يَأمَلُ المالُ النَجاةَ إِذا عَدا","صَرفُ الزَمانِ مُجاءَةً بِعَديمِ",31,"م",1,0],["لا يَأمَنَن أَخدَعاكَ بادِرَةً","مِن قَدعِهِ إِن أَمِنتَ مِن قَذعِه",32,"ع",2,0],["لا يَأسَفونَ إِذا هُمُ سَمِنَت لَهُم","أَحسابُهُم أَن تُهزَلَ الأَعمارُ",33,"ر",1,0],["لا يأتمرْ مِنّا الرُّماةُ بِمَقْتَلٍ","فَلَنا نِبالٌ مثلهم وسِهامُ",34,"م",1,0],["لا يَأْسَ من نَفحاتِ ربّكَ إنّني","لأرى السّنا خَلَلَ الدُّجَى يتألَّقُ",35,"ق",1,0],["لا يَأمُرونَ بِغَيرِ الظُلمِ أَنفُسَهُم","وَاللَهُ يَأمُرُهُم عَدلاً وَإِحسانا",36,"ن",2,0],["لا يأمَنُ الشَعبُ المُرَوَّعُ كَيدَهُم","إِلّا بِطاعَتِهِ وَبِاِستِسلامِهِ",37,"م",2,0],["لا يأكُلُ السِّرحانُ شِلوَ طعينهم","مما عليه من القنا المتكسِّر",38,"ر",1,0],["لا يَأيَسَنَّ فَقيرٌ مِن غِنىً أَبَداً","بَعدَ الَّذي نالَ يَعقوبُ بنُ داوودِ",39,"د",1,1],["لا يَأثَرُ الغِلَّ لِلخَليلِ وَلا","تَغلِبُهُ طَيرُهُ إِذا غَضِبا",40,"ب",2,0],["لا يأمن المدلج الساري تورُّطَهُ","ما لَم يوطِّد له من عقله سندا",41,"د",2,0],["لا يأمن الناس امرأ","خاتلهم أو قد كذب",42,"ب",1,0],["لا يأمن الماشي بلي","لٍ للظلام من العثار",43,"ر",1,0],["لا يا غرامي وهذا الفنُّ مِلءُ دمي","بالنَّار والصَّبواتِ الحمر مشَّاءُ",44,"ا",2,0],["لا يأمَنُ النَّاسُ مَمْساهُ ومُصْبَحَهُ","في كلِّ فجٍّ وإن لَم يَغْزُ يُنْتَظَرُ",45,"ر",1,0],["لا يَأْمَنُ الصَّامِتُ الْمَعْصُومُ صَوْلَتَهُ","وَلا يَدُومُ عَلَيْهِ النَّاطِقُ الْبَذِرُ",46,"ر",1,0],["لاَ يَأْتَلِي عَنْ سَعْيِه لِلْعُلَى","وَلَوْ شَاءَ كَيْوَانَ لَمْ يَأْتَلِ",47,"ل",1,0],["لا يأتلي ينشُد حقاً ولا","ينفك ان يُغضب أو يغضبا",48,"ب",2,0],["لا يأبهون بارهابٍ إذا احتدَموا","ولا بِمَصْرَعِهِمْ إن شعبُهم سَلِما",49,"م",2,0],["لا يأمن الأعداء وقعَ صورام","نامتْ مناياهنّ في الأجفان",50,"ن",1,0],["لا يأملنَّ معاشرٌ جِيَفٌ","جزْري خباءثهم ولاأكلي",51,"ل",2,0],["لأي أمرٍ طويت الكشح عن رجل","عف الأديم لفضل فيه برهان",52,"ن",1,0],["لا يَأمَنَنَّ سُطاكَ ذو جَهلٍ بِها","ما لِلقَضاءِ وَلا لِأَمرِكَ مَدفَعُ",53,"ع",1,0],["لا يَأمَنَنَّ الشِركُ بَطشَ غَشَمشَمٍ","يُرجى لِقَطعِ فُروعِهِ وَعُروقِهِ",54,"ق",2,0],["لا يَأمَنُ العَجزَ وَالتَقصيرَ مادِحُهُ","وَلا يَخافُ عَلى الإِطنابِ تَكذيبا",55,"ب",2,0],["لا يَأمنن بعدي عطيّة حرّةً","مِنَ الناسِ أو جارٌ كريمٌ يجاوره",56,"ه",1,1],["لا يأتلي في قَتْل أَب","ناءِ النبيِّ على حَميَّهْ",57,"ي",2,0],["لا يَأمَنُ التَّبِعَاتِ إلا هائِبٌ","عَرضاً تَقَدَّمَهُ وَعيدٌ هَائِلُ",58,"ل",1,0],["لا يَأْتَلِي مِنْ ذَهَبٍ يَلُفُّهُ","مِنِّي وَمِنْ دراهِمٍ يَحُوشُها",59,"ش",3,0],["لاَ يَأْمُلُ الرّزْقَ إلاّ مِنْ مَضارِبِهِ","فَرْسُ الْهُمامِ بِأَنْيابٍ وَأَظْفارِ",60,"ر",1,0],["لا يَأسَفونَ وَقَد أَعذَبتُ أَلسُنَهُم","وَلَو يَظُنّونَ أَن أُعنى بِهِم أَسِفوا",61,"ف",3,0],["لا يأمن الجارُ إلاَّ في جِوارِهِمُو","ويردَعون الذي يستركبُ الجُرُما",62,"م",2,0],["لا يا أَخي وَلا أَقو","ل لِعاذلي لا يا أَخي",63,"ي",1,0],["لِأَيّامِها قيدَت وَأَيّامِها جَرَت","لِغُنمٍ وَلَم تُؤخَذ بِأَرضٍ وَتُغصَبِ",64,"ب",1,0],["لا يَألَفُ الرّاجونَ غيرَ فِنائهِ","أبداً ففيهِ الظِّلُّ يُشْمَلُ والجَنى",65,"ن",2,0],["لِأَيّامُ مُلكِكَ لَمّا أَتَت","جَلا الظُلمَ أَنوارُها وَالظُلَم",66,"م",1,0],["لا يا ابنَ داودَ لَستُ مِن نَفرٍ","كلٌّ لما قَد هَويتَه قالِ",67,"ل",1,0],["لا يأمنه آمن","بقول عبدالله",68,"ه",1,0],["لأياً إِذا مَثل الحرباء منتصبا","من الظهيرة يثني جيدها المرسُ",69,"س",1,0],["لا يأَلَمونَ لِنَقص اليُخلِ وَهوَ بِهِم","مُبرِّح كَيف لِلأَمواتِ بِالأَلَمِ",70,"م",1,0],["لا يأْمْرنِّي منك وجْهُ مُسالمٍ","صمْتاً وقد أَخْفَيْتَ قَلْبَ مُحاربِ",71,"ب",1,0],["لا يا أخي إن الجهاد فريضة","فإلى متى في الحق نحن نماري",72,"ر",2,0],["لا يألم الفقرَ الذي محَّضه","يوماً إذا عمّ الغنى سُؤَّالَه",73,"ل",2,0],["لا يأخذ التدبيرَ إلا مِن عَلٍ","فالناسُ ينحطُّون وهو صاعدُ",74,"د",1,0],["لأيّام البشائر والتهاني","بها نشرُ الروائح والغوادي",75,"ي",1,0],["لا يأمنُ الدهر بأس الجمرِ لامسهُ","وقد يروحُ سليماً لامِسُ اللَّهبِ",76,"ب",1,0],["لا يأخذون المباغي غير غَشْرمَةٍ","ولا يضامون إنْ حَلَّوا وإن ظعنوا",77,"ن",3,0],["لأيّامه فضلٌ على الدهر كلّه","كفضل نجوم الليل بالقمر السّعد",78,"د",1,0],["لآياتهِ برهان عيسى بن مريمٍ","بها تبرأ الأسقام أو تسمعُ الصمُّ",79,"م",1,0],["لا يأتلي بالأوابدِ قاصداً","طبع غدا لابن اللئيمة لمبكرا",80,"ر",2,0],["لا يَأْنَسُ الطينُ حتَّى يحضنَ الطينا","فلا أريدُكِ ريحانًا ونسرينا",81,"ن",2,1],["لا يَألَمون بشيءٍ مِن مَصائبهمْ","حتّى إذا أُولِمُوا في دينهمْ أَلِموا",82,"م",3,0],["لا يألف الحِقْدُ مَغْنىً من مساكنِهِ","ولا يُلَبِّثُ في أبياتِهِ الحَنَقُ",83,"ق",1,0],["لا يَأخذونَ المالَ إلّا بالظُّبا","تَنْدى دماً أو من سِنانٍ راعِفِ",84,"ف",1,0],["لا يَأخُذونَ المالَ إِلّا بِالقَنا","تَحمرّ مِنه ترائبٌ ووريدُ",85,"د",1,0],["لأيَّامِ الصِّبا زَهْوٌ ولكنْ","سيَخبُثُ بعدهُ ما لَذَّ طَعْما",86,"م",2,0]]}