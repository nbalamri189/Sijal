{"poems":[[53,"سننت لهذا الرمح غربا مذلقا","https://www.aldiwan.net/poem29931.html","الطويل"],[86,"آذنت شمس حياتي بمغيب","https://www.aldiwan.net/poem10474.html","الرمل"],[86,"شيخان قد خبرا الوجود وأدركا","https://www.aldiwan.net/poem68877.html","الكامل"],[88,"رمت مسمعي ليلا بأنه مؤلم","https://www.aldiwan.net/poem45022.html","الطويل"],[72,"مذ أضامتني الليالي جفاني","https://www.aldiwan.net/poem20125.html","الخفيف"],[51,"ذق أبا جعفر مغبة جرمك","https://www.aldiwan.net/poem65807.html","الخفيف"],[51,"أبا حسن لم أمس من حال بالكم","https://www.aldiwan.net/poem66724.html","البسيط"],[91,"أبصرتها في الخمس والعشر","https://www.aldiwan.net/poem8851.html","عموديه"],[70,"أيا من راح عن حالي","https://www.aldiwan.net/poem43007.html","مجزوء الوافر"],[45,"أحاجيك هل للحب كالدار تجمع","https://www.aldiwan.net/poem64680.html","الطويل"],[61,"رد جفني بسافح الدمع يندى","https://www.aldiwan.net/poem51724.html","الخفيف"],[31,"يا خليلي قربا لي ركابي","https://www.aldiwan.net/poem42626.html","الخفيف"],[90,"غضبة","https://www.poetsgate.com/ViewPoem.aspx?id=179231",""],[51,"أبا حسنٍ لم أمْسِ من حال بالكمْ","https://www.poetsgate.com/ViewPoem.aspx?id=30747",""],[115,"عسى نظرة تجلو قليبي كنظرة","https://www.aldiwan.net/poem40893.html","عموديه"],[132,"أإن ظعن الخليط ضحى فبانا","https://www.aldiwan.net/poem54656.html","الوافر"],[132,"لا تلوماه في الهوى أو لوما","https://www.aldiwan.net/poem54746.html","الخفيف"],[211,"رويدك أيها القلب","https://www.aldiwan.net/poem46777.html","مجزوء الوافر"],[223,"رفينا تعالي كأس خمر ونارة","https://www.aldiwan.net/poem41628.html","الطويل"],[231,"سبح لربك في الظلام الداجي","https://www.aldiwan.net/poem44595.html","الكامل"],[270,"كنت يا أماه أرعى النجما","https://www.aldiwan.net/poem35229.html","الرمل"],[270,"قبلتها فشممت وردا أحمرا","https://www.aldiwan.net/poem35242.html","الكامل"],[270,"حواء أمك حبها أشقانا","https://www.aldiwan.net/poem35584.html","الكامل"],[270,"أشجاك نور النجمة الزهراء","https://www.aldiwan.net/poem35609.html","الكامل"],[270,"الشام يقهر والعراق يضام","https://www.aldiwan.net/poem35641.html","الكامل"],[270,"لأبي عبيدة في دمشق وخالد","https://www.aldiwan.net/poem35645.html","الكامل"],[276,"هل عند عمرة من بتات مسافر","https://www.aldiwan.net/poem2239.html","الكامل"],[304,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[304,"أبرق الحمى وقت السحير تلوح","https://www.aldiwan.net/poem16903.html","الطويل"],[353,"رياض الهنا باليمن فاحت ورودها","https://www.aldiwan.net/poem40398.html","الطويل"],[371,"أبقى الرسيم من الركاب رسوما","https://www.aldiwan.net/poem57136.html","الكامل"],[377,"طوبى لمن قد تاب بعد خطائهِ","https://www.aldiwan.net/poem66970.html","الكامل"],[416,"ما قضى إلا على الصب العميد","https://www.aldiwan.net/poem54016.html","الرمل"],[429,"يا ديار الانس من وادي الطرب","https://www.aldiwan.net/poem41400.html","الرمل"],[432,"أهلا بطيف في الدجنة أوبا","https://www.aldiwan.net/poem12551.html","الكامل"],[477,"أبرق تبدى أم وميض سنا ثغر","https://www.aldiwan.net/poem15206.html","الطويل"],[482,"فاء الفقير فكاكه من أسره","https://www.aldiwan.net/poem24418.html","عموديه"],[538,"لا مصاب في هذه الدنياء","https://www.aldiwan.net/poem48312.html","عموديه"],[586,"فدتك نفوس قد حلا بك حالها","https://www.aldiwan.net/poem17657.html","الطويل"],[587,"ألا أيها الغادي مجداً بنجداً","https://www.aldiwan.net/poem11509.html","عموديه"]],"verses":[["فَتَذهَبُ بِالشَطرِ الَّذي كُلُّهُ غِنىً","وَأَذهَبُ بِالشَطرِ الَّذي كُلُّهُ شَقا",0,"ق",2,0],["فَتَذَكَّرتُ بِهِ يَومَ اِنطَوى","صادِقُ العَزمَةِ كَشّافُ الكُروبِ",1,"ب",1,0],["فَتَذَوَّقوا طَعمَ الحَياةِ وَأَدرَكوا","ما في الجَهالَةِ مِن أَذىً وَتَبابِ",2,"ب",1,0],["فتُذرىِ دموعاً كالجمان تناثرت","وتضحك عن مثل الجمان المنظَّم",3,"م",1,0],["فتذكرت قول أحمد قدماً","لا افتخاراً إلا لمن يضام",4,"م",1,0],["فتذكْرتُ موبقاتِ ذُنوبي","فرجَوْتُ الخروجَ منها بشَتْمك",5,"ك",1,0],["فتذويقُ إشباع هَدَى اللَّه سعيكُمْ","وإلا فحسماً يتركُ القلبَ ساليا",6,"ل",3,0],["فَتَذَكَّرَت نَفسي صَبابَتَها","ما أَولَعَ المَهجورَ بِالذِكرِ",7,"ر",1,0],["فَتَذكُرُ أَنَّها لَمَحَت","خَيالاً في خِلالِ هَبا",8,"ب",2,0],["فَتَذهَبُ أَيّامي الَّتي تَستَفِزُّني","بِطالاتُها إِنّي إِلى اللَهِ أَرجِعُ",9,"ع",1,0],["فتذكَّرْتُ جِدُّ نُعماكَ لَمَّا","مِرحَ الغَيثُ في الرِّياضِ وجدَّا",10,"د",2,0],["فَتَذوقانِ بَعضَ ما ذُقتُ مِنها","أَو تَدابانِ حِقبَةً مِثلَ دابي",11,"ي",1,0],["فتذوَّقَتْك فقال قائلُها","انَ الغَضَنفَر لحمُه مُرّ",12,"ر",1,0],["فتذويقُ إشباعٍ هَذَى اللَّه سعيكمْ","وإلا فحسماً يتركُ القلبَ ساليا",13,"ل",3,0],["فتذهب أحزان وتأتي بشائر","ويجدع سيف الغيب انف المعنف",14,"ف",1,0],["فتذرى الدمع من أسف وتبدى","دفين الوجد اذ شدوا الظعانا",15,"ن",2,0],["فَتَذكَّرتُ إِذ رَأَيتُ بَنِيهَا","عَدِمَت مِنهُمُ عَطُوفاً رَحِيمَا",16,"م",2,0],["فتذكيه ويبكيها","لعمرك إنه خطب",17,"ب",1,0],["فَتِذكارُ هاتيكَ الرُسومِ مُقَدَّسٌ","فَلا تَلمِسيهِ بِاِذّكارٍ مكذَّبِ",18,"ب",1,0],["فتذللت سُبُلاً فجاجا منةً","منه على السّلاك بين فجاج",19,"ج",1,0],["فتذكَّرتُ غِناءً مُطرباً","فوقَ مَهدي وأحاديثَ الحِمى",20,"م",2,0],["فتذكَّريني في اللّيالي وارفعي","طرفاً إلى تِلكَ الكواكبِ أحوَرا",21,"ر",2,0],["فتذكّري في الليلِ طيبَ حديثِنا","وتذكّري في الصُبحِ طيبَ هوانا",22,"ن",2,0],["فتذكّري عَهدَ الصبوَّةِ بعد مَن","يمشي مع الأرواحِ والأفياء",23,"ا",2,0],["فتَذكّروا أجدادَكم وترَبّصوا","وحَكيمُكم بأمورِكم قوَّام",24,"م",1,0],["فتذَكَّرت فيها المدائنُ أُمَّها","وتنَسَّمت نبأً كحِلمِ الراقد",25,"د",1,0],["فَتَذَكَّرَت ثَقَلاً رَثيداً بَعدَما","أَلقَت ذُكاءُ يَمينَها في كافِرِ",26,"ر",1,0],["فتذكارهم راحي وروحي وراحتي","يطيب به قلبي وتصفو ضمائري",27,"ر",2,0],["فتذكرني نجداً سقى اللّه دوحها","ملثاً بأكناف الرياض تسيح",28,"ح",1,0],["فَتذكرنا عَهد الحِجاز وَلم تَكُن","لِطول المَدى تنسى لَدينا عُهودها",29,"د",3,0],["فَتَذاكروا شِيماً غرسنَ مكارِماً","لو يُعتَصَرنَ لَخِلتَهنَّ كُرُوما",30,"م",2,0],["فتذيب نفس المرء في إيغالها","من بعد ذوب عظامه وكلائه",31,"ا",3,0],["فتذكَّرتُ زماناً مرَّ بي","طرب النشوة مرعيَّ العهود",32,"د",1,0],["فتذكرت أو يقاتا مضت","ولويلات بها نلنا الأرب",33,"ب",1,0],["فتذكّرتْ نفسي ليالي نادمَتْ","فيها أناةَ العَطوِ ناعمةَ الصِّبا",34,"ب",2,0],["فتُذْكِرُني أيامَ وصلٍ قطعْتُها","بها بينَ أعلامِ المحصَّبِ فالحِجْرِ",35,"ر",1,0],["فتذوق طعم معالم الأسرار في","قفص الكثائف معلنا في ديره",36,"ر",2,0],["فَتذَرَّع بالصبر عمَّا قضَاه ال","له فالصَّبر شِيمةُ العُظماء",37,"ا",2,0],["فَتَذَلَّلتُ حِينَ أَبْدَى دَلالاً","وَرأى رُخْصَ أَدْمُعِي فَتَغَالا",38,"ا",1,0],["فتذرك من شاءوا الإمام مآثراً","ومجداً سما فخراً به وتفردا",39,"د",2,0]]}