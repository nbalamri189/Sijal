{"poems":[[55,"سننت لهذا الرمح غربا مذلقا","https://www.aldiwan.net/poem29931.html","الطويل"],[88,"آذنت شمس حياتي بمغيب","https://www.aldiwan.net/poem10474.html","الرمل"],[88,"شيخان قد خبرا الوجود وأدركا","https://www.aldiwan.net/poem68877.html","الكامل"],[90,"رمت مسمعي ليلا بأنه مؤلم","https://www.aldiwan.net/poem45022.html","الطويل"],[74,"مذ أضامتني الليالي جفاني","https://www.aldiwan.net/poem20125.html","الخفيف"],[53,"ذق أبا جعفر مغبة جرمك","https://www.aldiwan.net/poem65807.html","الخفيف"],[53,"أبا حسن لم أمس من حال بالكم","https://www.aldiwan.net/poem66724.html","البسيط"],[93,"أبصرتها في الخمس والعشر","https://www.aldiwan.net/poem8851.html","عموديه"],[72,"أيا من راح عن حالي","https://www.aldiwan.net/poem43007.html","مجزوء الوافر"],[47,"أحاجيك هل للحب كالدار تجمع","https://www.aldiwan.net/poem64680.html","الطويل"],[63,"رد جفني بسافح الدمع يندى","https://www.aldiwan.net/poem51724.html","الخفيف"],[33,"يا خليلي قربا لي ركابي","https://www.aldiwan.net/poem42626.html","الخفيف"],[92,"غضبة","https://www.poetsgate.com/ViewPoem.aspx?id=179231",""],[53,"أبا حسنٍ لم أمْسِ من حال بالكمْ","https://www.poetsgate.com/ViewPoem.aspx?id=30747",""],[119,"عسى نظرة تجلو قليبي كنظرة","https://www.aldiwan.net/poem40893.html","عموديه"],[136,"أإن ظعن الخليط ضحى فبانا","https://www.aldiwan.net/poem54656.html","الوافر"],[136,"لا تلوماه في الهوى أو لوما","https://www.aldiwan.net/poem54746.html","الخفيف"],[215,"رويدك أيها القلب","https://www.aldiwan.net/poem46777.html","مجزوء الوافر"],[228,"رفينا تعالي كأس خمر ونارة","https://www.aldiwan.net/poem41628.html","الطويل"],[236,"سبح لربك في الظلام الداجي","https://www.aldiwan.net/poem44595.html","الكامل"],[275,"كنت يا أماه أرعى النجما","https://www.aldiwan.net/poem35229.html","الرمل"],[275,"قبلتها فشممت وردا أحمرا","https://www.aldiwan.net/poem35242.html","الكامل"],[275,"حواء أمك حبها أشقانا","https://www.aldiwan.net/poem35584.html","الكامل"],[275,"أشجاك نور النجمة الزهراء","https://www.aldiwan.net/poem35609.html","الكامل"],[275,"الشام يقهر والعراق يضام","https://www.aldiwan.net/poem35641.html","الكامل"],[275,"لأبي عبيدة في دمشق وخالد","https://www.aldiwan.net/poem35645.html","الكامل"],[281,"هل عند عمرة من بتات مسافر","https://www.aldiwan.net/poem2239.html","الكامل"],[309,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[309,"أبرق الحمى وقت السحير تلوح","https://www.aldiwan.net/poem16903.html","الطويل"],[358,"رياض الهنا باليمن فاحت ورودها","https://www.aldiwan.net/poem40398.html","الطويل"],[376,"أبقى الرسيم من الركاب رسوما","https://www.aldiwan.net/poem57136.html","الكامل"],[382,"طوبى لمن قد تاب بعد خطائهِ","https://www.aldiwan.net/poem66970.html","الكامل"],[422,"ما قضى إلا على الصب العميد","https://www.aldiwan.net/poem54016.html","الرمل"],[435,"يا ديار الانس من وادي الطرب","https://www.aldiwan.net/poem41400.html","الرمل"],[438,"أهلا بطيف في الدجنة أوبا","https://www.aldiwan.net/poem12551.html","الكامل"],[482,"أبرق تبدى أم وميض سنا ثغر","https://www.aldiwan.net/poem15206.html","الطويل"],[487,"فاء الفقير فكاكه من أسره","https://www.aldiwan.net/poem24418.html","عموديه"],[543,"لا مصاب في هذه الدنياء","https://www.aldiwan.net/poem48312.html","عموديه"],[591,"فدتك نفوس قد حلا بك حالها","https://www.aldiwan.net/poem17657.html","الطويل"],[592,"ألا أيها الغادي مجداً بنجداً","https://www.aldiwan.net/poem11509.html","عموديه"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138384",""],[855,"","https://poetry.dctabudhabi.ae/diwan/poem/138855",""],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46521","الرجز"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132845","الخفيف"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78176","الخفيف"],[1470,"","https://poetry.dctabudhabi.ae/diwan/poem/216506","المتقارب"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48946","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48917","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125359","الكامل"],[2032,"","https://poetry.dctabudhabi.ae/diwan/poem/121984","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77252","الكامل"],[2527,"","https://poetry.dctabudhabi.ae/diwan/poem/17699","الكامل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205854","الخفيف"],[2954,"","https://poetry.dctabudhabi.ae/diwan/poem/138925",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138676",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91627","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103026","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111455","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[4023,"","https://poetry.dctabudhabi.ae/diwan/poem/146892","الكامل"],[4038,"","https://poetry.dctabudhabi.ae/diwan/poem/107289","الكامل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97096","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136596",""],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136468",""],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58031","الكامل"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4767,"طفل الخلود","https://www.poetsgate.com/ViewPoem.aspx?id=88355",""],[4930,"جدِّدي عهد الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=213235",""],[4984,"عبق القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=175557",""],[5145,"رقدت ودهرك لا يرقد","https://www.poetsgate.com/ViewPoem.aspx?id=108069",""],[5273,"كبرياء عاشقة","https://www.poetsgate.com/ViewPoem.aspx?id=28546",""],[5425,"كوني لَهُمْ","https://www.poetsgate.com/ViewPoem.aspx?id=207509",""],[5430,"هموم","https://www.poetsgate.com/ViewPoem.aspx?id=1445",""],[5431,"وما زالت الأحياء بالسوط تُقمعُ!!!","https://www.poetsgate.com/ViewPoem.aspx?id=200185",""],[5431,"الحب دربٌ آمنٌ","https://www.poetsgate.com/ViewPoem.aspx?id=201942",""],[5459,"نصر وخُسر","https://www.poetsgate.com/ViewPoem.aspx?id=214873",""],[5493,"غُفرانَكَ اللّهمَّ","https://www.poetsgate.com/ViewPoem.aspx?id=196958",""],[5691,"الكوكب الأحمر... الوطن القادم...!","https://www.poetsgate.com/ViewPoem.aspx?id=206733",""],[5720,"قادةٌ وأثَر *","https://www.poetsgate.com/ViewPoem.aspx?id=199812",""],[5776,"عامُ الأبابيلِ اليمانية...","https://www.poetsgate.com/ViewPoem.aspx?id=203647",""],[5784,"كأني على ساحة الشعر ذيب....","https://www.poetsgate.com/ViewPoem.aspx?id=190729",""],[5943,"جيلُ كَسْرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=11260",""],[5943,"يكفي مكابرة","https://www.poetsgate.com/ViewPoem.aspx?id=34310",""],[5952,"آخر الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=204836",""],[6023,"وحقِّك إنِّي للرياح لحاسدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=123874",""],[6159,"سبورة الفوضى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85855&r=&rc=1",""]],"verses":[["فَتَذهَبُ بِالشَطرِ الَّذي كُلُّهُ غِنىً","وَأَذهَبُ بِالشَطرِ الَّذي كُلُّهُ شَقا",0,"ق",2,0],["فَتَذَكَّرتُ بِهِ يَومَ اِنطَوى","صادِقُ العَزمَةِ كَشّافُ الكُروبِ",1,"ب",1,0],["فَتَذَوَّقوا طَعمَ الحَياةِ وَأَدرَكوا","ما في الجَهالَةِ مِن أَذىً وَتَبابِ",2,"ب",1,0],["فتُذرىِ دموعاً كالجمان تناثرت","وتضحك عن مثل الجمان المنظَّم",3,"م",1,0],["فتذكرت قول أحمد قدماً","لا افتخاراً إلا لمن يضام",4,"م",1,0],["فتذكْرتُ موبقاتِ ذُنوبي","فرجَوْتُ الخروجَ منها بشَتْمك",5,"ك",1,0],["فتذويقُ إشباع هَدَى اللَّه سعيكُمْ","وإلا فحسماً يتركُ القلبَ ساليا",6,"ل",3,0],["فَتَذَكَّرَت نَفسي صَبابَتَها","ما أَولَعَ المَهجورَ بِالذِكرِ",7,"ر",1,0],["فَتَذكُرُ أَنَّها لَمَحَت","خَيالاً في خِلالِ هَبا",8,"ب",2,0],["فَتَذهَبُ أَيّامي الَّتي تَستَفِزُّني","بِطالاتُها إِنّي إِلى اللَهِ أَرجِعُ",9,"ع",1,0],["فتذكَّرْتُ جِدُّ نُعماكَ لَمَّا","مِرحَ الغَيثُ في الرِّياضِ وجدَّا",10,"د",2,0],["فَتَذوقانِ بَعضَ ما ذُقتُ مِنها","أَو تَدابانِ حِقبَةً مِثلَ دابي",11,"ب",2,0],["فتذوَّقَتْك فقال قائلُها","انَ الغَضَنفَر لحمُه مُرّ",12,"ر",1,0],["فتذويقُ إشباعٍ هَذَى اللَّه سعيكمْ","وإلا فحسماً يتركُ القلبَ ساليا",13,"ل",3,0],["فتذهب أحزان وتأتي بشائر","ويجدع سيف الغيب انف المعنف",14,"ف",1,0],["فتذرى الدمع من أسف وتبدى","دفين الوجد اذ شدوا الظعانا",15,"ن",2,0],["فَتَذكَّرتُ إِذ رَأَيتُ بَنِيهَا","عَد