{"poems":[[9,"ما بكاء الكبير بالأطلال","https://www.aldiwan.net/poem21974.html","الخفيف"],[75,"أنت المسبب للولوع","https://www.aldiwan.net/poem11960.html","مجزوء الكامل"],[39,"من لقلب متيم مستهام","https://www.aldiwan.net/poem7649.html","الخفيف"],[74,"أخفي الأسى ولسان دمعي يعلن","https://www.aldiwan.net/poem20150.html","الكامل"],[74,"جاءت العاذلات شيئا فريا","https://www.aldiwan.net/poem20564.html","الخفيف"],[53,"يا أخي أين ريع ذاك اللقاء","https://www.aldiwan.net/poem7944.html","الخفيف"],[87,"وهذه واقعة مستغربه","https://www.aldiwan.net/poem8047.html","الرجز"],[87,"أهل القدود التي صالت عواليها","https://www.aldiwan.net/poem62992.html","البسيط"],[87,"إلى عرفات الله يا خير زائر","https://www.aldiwan.net/poem63776.html","الطويل"],[64,"يا ليلة السفح ألا عدت ثانية","https://www.aldiwan.net/poem52276.html","البسيط"],[47,"لوت بالسلام بنانا خضيبا","https://www.aldiwan.net/poem10668.html","المتقارب"],[47,"بنا أنت من مفجوة لم تعتب","https://www.aldiwan.net/poem10896.html","الطويل"],[46,"عنت فأعرض عن تعريضها أربي","https://www.aldiwan.net/poem29680.html","البسيط"],[46,"عنت له سكن فهام بذكرها","https://www.aldiwan.net/poem30241.html","الكامل"],[107,"أقبل فتلك ديار يثرب تقبل","https://www.aldiwan.net/poem44226.html","الكامل"],[15,"ليس رسم على الدفين ببالي","https://www.aldiwan.net/poem45253.html","الخفيف"],[78,"ورب ملتفة العوالي","https://www.aldiwan.net/poem38859.html","مخلع البسيط"],[70,"صد حمى ظمئي لماك لماذا","https://www.aldiwan.net/poem1495.html",""],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39670","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43706","الرجز"],[132,"إني بفضل من الله ذو دعة","https://www.aldiwan.net/poem50491.html","البسيط"],[147,"لي بامتداحك عن ذكر الهوى شغل","https://www.aldiwan.net/poem11803.html","البسيط"],[147,"ما مرتقاك على من رامه أمم","https://www.aldiwan.net/poem11824.html","البسيط"],[159,"سلكان للدمع محلول ومعقود","https://www.aldiwan.net/poem55734.html","البسيط"],[203,"ما أوجب الإعراض بعد الذي","https://www.aldiwan.net/poem45213.html","السريع"],[280,"لله قلعة بيران وعزتها","https://www.aldiwan.net/poem25443.html","البسيط"],[285,"ألم أك للقوافي الغر خدنا","https://www.aldiwan.net/poem60692.html","البسيط"],[356,"قد أغتدي والليل مركوم الظلم","https://www.aldiwan.net/poem68967.html","الرجز"],[396,"كلنا أموات لكن بخت من قدم إحسان","https://www.aldiwan.net/poem54455.html","عموديه"],[447,"أيا ليلى ويا ليت التلاقي","https://www.aldiwan.net/poem14315.html","الوافر"],[463,"أإن تحدث عصفور على فننِ","https://www.aldiwan.net/poem55829.html","البسيط"],[463,"إما تقومون كذا أو فاقعدوا","https://www.aldiwan.net/poem56238.html","الرجز"],[469,"طربي إلى ماء الحمى ونزيله","https://www.aldiwan.net/poem3443.html","عموديه"],[482,"أغار إذا وصفتك من لساني","https://www.aldiwan.net/poem16190.html","الوافر"],[520,"ردا أحاديث المنى وأعيدا","https://www.aldiwan.net/poem12092.html","الكامل"],[520,"الشعر يعلم أن قدرك أكبر","https://www.aldiwan.net/poem12099.html","الكامل"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2418","الخفيف"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138243",""],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199587","المسحوب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38202","الرمل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77662","الرجز"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129527","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62550","الرجز"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61040","البسيط"],[1178,"","https://poetry.dctabudhabi.ae/diwan/poem/31473","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56214","الرمل"],[1348,"","https://poetry.dctabudhabi.ae/diwan/poem/73692","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79981","الطويل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113977","الخفيف"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132226","الخفيف"],[1838,"","https://poetry.dctabudhabi.ae/diwan/poem/104155","الطويل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118372","الطويل"],[2186,"","https://poetry.dctabudhabi.ae/diwan/poem/124187","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53122","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53228","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93686","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93854","الكامل"],[2851,"","https://poetry.dctabudhabi.ae/diwan/poem/105600","المنسرح"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58280","الخفيف"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74249","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74237","الكامل"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126256","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110049","السريع"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118002","الرمل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114486","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102983","الكامل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36520","الدوبيت"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94453","الكامل"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104541","البسيط"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66127","الطويل"],[4579,"","https://poetry.dctabudhabi.ae/diwan/poem/205457","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120469","الوافر"],[4607,"","https://poetry.dctabudhabi.ae/diwan/poem/132202","الكامل"],[4728,"حزم ما هو مثل حزم الظامي","https://www.poetsgate.com/ViewPoem.aspx?id=176900",""],[4775,"مغامرات عنتر","https://www.poetsgate.com/ViewPoem.aspx?id=175219",""],[5055,"يا البندري","https://www.poetsgate.com/ViewPoem.aspx?id=110088",""],[5574,"مَنْ يُخبِرُ الحوتَ؟","https://www.poetsgate.com/ViewPoem.aspx?id=205715",""],[5956,"البلدة السعيدة","https://www.poetsgate.com/ViewPoem.aspx?id=185792",""],[5997,"يا أبا منصور","https://www.poetsgate.com/ViewPoem.aspx?id=214240",""],[4442,"بشرى الأماني فقد زالت غواشيها","https://www.poetsgate.com/ViewPoem.aspx?id=171222",""],[6328,"حتّى متى ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84883&r=&rc=24",""]],"verses":[["عَنتَريسٌ تَعدو إِذا مَسَّها السَو","طُ كَعَدوِ المُصَلصِلِ الجَوّالِ",0,"ل",1,0],["عَن تَمَنٍّ وَطولِ حَبسٍ وَتَجمي","عِ شَتاتٍ وَرِحلَةٍ وَاِحتِمالِ",0,"ل",1,0],["عَنَتِ الأُصولِ لِأَصلِهِ","وَتَقاصَرَت عَنهُ الفُروع",1,"ع",1,0],["عَنتَرِيسٌ شِمِلَّةٌ ذَاتُ لَوثٍ","هَوجَلٌ مَيلَعٌ كَتُومُ البُغَامِ",2,"م",1,0],["عنت القرائح عن بلوغ صفاته","وتسترت خلف الشفاه الألسن",3,"ن",1,0],["عن تفاريق يمنه فاسأل الجا","مع تسئل لسان صدق عليّا",4,"ي",2,0],["عن تدابيرك اللِّطاف اللَّواتي","هُنَّ أخفى من مُستسرِّ الهباءِ",5,"ا",2,0],["عَنَت لَها رَبيبَةُ السَباخِ","تَحمِلُ وَزنَيها مِنَ الأَوساخِ",6,"خ",1,0],["عَنَّت لَنا أُصُلاً تُغري بِنا أَسَلاً","مَهزوزَةً شَكلاً مَشروعَةً تيها",7,"ي",3,0],["عَنَت لَكَ في التُربِ المُقَدَّسِ جَبهَةٌ","يَدينُ لَها العاتي مِنَ الجَبَهاتِ",8,"ت",1,0],["عنَّتْ عواطلَ لاحَلْيٌ لهنّ سِوى","حُسنٍ ترددَ بين الفَرعِ والقدمِ",9,"م",1,0],["عَنَت كَبِدي قَسوَةٌ مِنكَ ما","تَزالُ تَجَدَّدُ فيها نُدوبا",10,"ب",2,0],["عَنَت طَيِّئاً جَمعاً وَثَنَّت بِمَذحِجٍ","خُصوصاً وَعَمَّت في الكَلاعِ وَيَحصُبِ",11,"ب",1,0],["عَنَّت فَأَعرَضَ عَن تَعريضِها أَرَبي","يا هَذِهِ عُذُري في هَذِهِ النُكَبِ",12,"ب",1,1],["عَنَّت لَهُ سَكَنٌ فَهامَ بِذِكرِها","أَيُّ الدُموعِ وَقَد بَدَت لَم يُجرِها",13,"ر",3,1],["عَنَتِ الوجوهُ فراكِعٌ متخشعٌ","يخشى الإلهَ وساجِدٌ مُتَبَتِّلُ",14,"ل",1,0],["عَنتَريسٍ كَأَنَّها ذو وُشومٍ","أَحرَجَتهُ بِالجَوِّ إِحدى اللَيالي",15,"ل",2,0],["عنتْ لهُ أوجهُ المنايا","فعافَها القومُ واشْتَهاها",16,"ا",3,0],["عَنَتِ الغزالَةُ والغَزَالُ لِوَجْهِهِ","مُتَلفّتاً وبه عِياذاً لاذا",17,"ذ",2,0],["عَنَتِ الشعوبُ لسيفهم فتألَّبوا","يتنازعون مصايرَ الأقوامِ",18,"م",1,0],["عَنَّت لَكَ العَينُ فَلَم","تَقوى الرُقى أَن تَذَرَك",19,"ك",1,0],["عَنَتْ إليه ملوكُ الأرضِ قاطبةً","طوعاً له كلُّها تدعو بآمينِ",20,"ن",1,0],["عَنَّت لَهُ فُرَصٌ شَتّى دَعاكَ لَها","يا مَن بِهِ فُرَصُ العَلياءِ تُهتَبَلُ",21,"ل",1,0],["عَنَت حُماةُ بُيوتِ الشَعرِ راغِمَةً","مُذ طُنِّبَت لَكَ في أَوطانِها الخِيَمُ",22,"م",1,0],["عَنَّتْ يَدُ الدَّمْعِ في خَدِّي عِنانَ دَمٍ","كأنَّهُ مِنْ أَديمِ القَلْبِ مَقْدُودُ",23,"د",1,0],["عن تشبهُ الوردَ فإني من ال","هوى عرتني هزَّةُ الآسِ",24,"س",1,0],["عَنَتْ وَدَانَتْ عَلَى حُكْمِ المُنَى فَرَقاً","مِنْ سَيِّد قَدْ هَوَتْ مِنْ أَرْفَعِ السُّورِ",25,"ر",1,0],["عَنَتْنِي لا الثَّناءَ لَها مُطِيقاً","وَلا كُفْرانُها لِي مُسْتَجازا",26,"ز",2,0],["عنت لنا أرنبُ من نحو سلم","فثار منها الكلبُ كالصقرِ الشهم",27,"م",1,0],["عن تكلم فقوله زول كله وبهتان","أو تحرك فحركاته ذنوب وخسران",28,"ن",1,0],["عنتقتك بعد مطل من وصال","فزادني الهوى طيب العناق",29,"ق",1,0],["عنَّتْ له أمُّ خشفٍ من كرائمهم","سمَّى الهوى عَينَها جلَّابةَ الِفتنِ",30,"ن",1,0],["عن تعبٍ أُورِدَ ساقٌ أوّلاً","ومَسحَتْ غرَّةَ سَبَّاقٍ يدُ",31,"د",1,0],["عنت البدورُ لأنجمٍ فارقتها","والصبح ما خاض الدجى بحجوله",32,"ل",2,0],["عَنَت لسطاك أَزمنة وَدانَت","لَكَ الثَقلان مِن أُنسٍ وَجان",33,"ن",1,0],["عنت الوجوه بها لوجهك خدمة","وغدت تبدد لثمها تبديدا",34,"د",2,0],["عنت الوجوه وقد طلعت فما يرى","إلا جبين في التراب معفر",35,"ر",1,0],["عَنتَريسٍ تَنفي اللُغامَ بِمِثلِ ال","سِبتِ هَوجاءَ كَالجُلالِ الخُفافِ",36,"ف",1,0],["عنت العلى لك يا كريم المحتدِ","فسموت تعلو فوق هام الفرقد",37,"د",1,1],["عن تايحة لعيوني","علّقت فيه كتاب",38,"ب",1,0],["عَنترُ الهَيجاءِ أَجرا ضَيغَمِ","حَاتمُ الجودِ وَمَعنُ الكَرَمِ",39,"م",1,0],["عَنتَرَة في غابر الأَزمانِ","كانَ إِذا ما صالَ في المَيدانِ",40,"ن",1,0],["عنت لمعانيه الكواكب واقتدت","بها فغدت ما بين هاد وراجم",41,"م",1,0],["عَنَت لها القلوب طوعاً وجرى","على الجسوم من قَضا الحب احتكامْ",42,"م",1,0],["عنت وجوه الأَماني غَير وانية","أَيامها السحم أَو أَرزاؤها الكلح",43,"ح",1,0],["عَنَّت لَهُ سَفعاءُ لُك","كَت بِالبَضيعِ لَها الخَبائِب",44,"ب",1,0],["عنتريٌّ في ميادين الوغا","حاتميٌّ بالعطايا والصلاتْ",45,"ت",1,0],["عَنَّت كَإِحدى حاجِبَيهِ تَقَوُّساً","بَيضاءَ راقَت في العُيونِ جَمالا",46,"ل",2,0],["عنت لك أهلُ الكبرياء وقبَّلتْ","ثرى نعلك الحسَّاد والأنف راغمُ",47,"م",1,0],["عَنتَريسٌ مهيُ الزمامِ سلوفٌ","ناجِلاها من الهجانِ الغَوالي",48,"ل",2,0],["عنتريس عرندس عيطموس","عيسجور وعرمس كوماء",49,"ا",2,0],["عنت واعدتني الليالي فلا أرى","لأهل نعيم غبطةً لم تضرم",50,"م",1,1],["عنتك به بين اللدين عناية","وزانتك عنه خشية وخشوع",51,"ع",1,0],["عنّت فهام الفؤاد منّي","وجداّ إلى سحرها الحلال",52,"ل",1,0],["عنَّت له أدماءُ أمُّ شادنٍ","أجفلها قانصها ونفَّرا",53,"ر",2,0],["عنت لنا عين ذاك السرب فاختلست","عيونها أنفساً لم تنج من فتن",54,"ن",1,0],["عنت جل أَبناء العُلوم لفضله","وَعَما قَليل سَوفَ يَعنو لَهُ الكُل",55,"ل",1,0],["عنت وأجفان العناية قد عفت","وبدا وعين الحظ يقظى نبهي",56,"ب",3,0],["عنت لقلبي فهيجت غللي","ظبية بان سليمة المقل",57,"ل",1,1],["عَنْتَرُ الحربِ لو يُطالَبُ مِثلي","بدِقيقٍ لَفَرّ مِن فَرْدِ حَمْلَه",58,"ل",2,0],["عَنت شَغفاً كُل الغُصون لِقده","وَطابَت جِهات الكَون مِن طيب وَرده",59,"ه",1,1],["عنت الغُصون المائِسات لِقَده","فَتَكَسرت شغفاً بِحسن دَلاله",60,"ل",2,0],["عنت البدور لوجهها وجمالها","ولحسنها لهج العذول يكبر",61,"ر",1,0],["عَنَت لهُ الأَملاكُ حتى عَلَت","منها على تِيجانِها الأَرجُلُ",62,"ل",1,0],["عنت الأعداء من هيبتهم","ولهم خرّت على أذقانها",63,"ن",3,0],["عنت له أملاك السماواتِ كلها","تلقته بالترحيب منها مسارعه",64,"ع",2,0],["عنّت فكاد الدهر يرقص نشوة","لغنائها والصخر يورق مثمرا",65,"ر",2,0],["عَنَّت لي فاِغتَنَمتُ مِنها اللَحظا","وَاِحتَلتُ لَعلّي بِمُرادي أَحظى",66,"ظ",2,1],["عن تحفة الأوطان تنشد بالثنا","لمؤلفيها بكرةً وعشيَّه",67,"ي",2,0],["عنت له فاستمالته ملامحها","واتلعت فاسترقته مراقيها",68,"ي",3,0],["عَنَتْ لِرِجالِ الْغَرْبِ خُضْعا رِقابُها","اسارَى كما تَعْنُو قَطا لِبَزاةِ",69,"ه",1,0],["عنتريسٍ توفي الزمام بفعمٍ","مثل جذع الأشاءة المجرود",70,"د",1,0],["عنت لهم عسير وهي تحكى","قبيل العسر طغيانا وقمدا",71,"د",2,0],["عنت لنا من وحشة","جاءت لورد الماء ملء عنانها",72,"ن",3,1],["عن تعاليل الهوى والريم ومْتيّمها","السعير بخافقي والعاصفة بعظامي",73,"م",2,0],["عنترٌ لا لن يعود","من ليالي الجاهليةْ",74,"ي",2,1],["عنتر غزى النعمان في يوم حشرة","وتعاظمت بالسيف شح النبالي",75,"ل",2,0],["١٤- عن تاجِ ودِّي، وكيفَ الشوقُ زيّنَهُ","عن قُبلةٍ، عن بهاءٍ 