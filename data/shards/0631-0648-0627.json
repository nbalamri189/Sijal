tsgate.com/ViewPoem.aspx?id=206970",""],[5305,"الاستسعاد بمدح سيد الأسياد","https://www.poetsgate.com/ViewPoem.aspx?id=187378",""],[5320,"حب يحتضر","https://www.poetsgate.com/ViewPoem.aspx?id=42995",""],[592,"أقول لعمري ما لهذا حقيقةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=128718",""],[592,"تجانف هذا المارق الماذق الأشقى","https://www.poetsgate.com/ViewPoem.aspx?id=128797",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5397,"تدلت لأفنان النقا عذباتها","https://www.poetsgate.com/ViewPoem.aspx?id=157920",""],[5408,"عروبيٌّ صوتي","https://www.poetsgate.com/ViewPoem.aspx?id=190873",""],[5431,"وقفة عزّ...","https://www.poetsgate.com/ViewPoem.aspx?id=207555",""],[5431,"أقسى من الليل ...","https://www.poetsgate.com/ViewPoem.aspx?id=210254",""],[5444,"بلد الألف ربوة","https://www.poetsgate.com/ViewPoem.aspx?id=205450",""],[5573,"تحيزمت واحلامي عن العين غايبه","https://www.poetsgate.com/ViewPoem.aspx?id=200138",""],[5596,"ردي على قصيدة ناصر بن سعيد الرواحي","https://www.poetsgate.com/ViewPoem.aspx?id=206691",""],[5605,"مرثية حنان الآغا","https://www.poetsgate.com/ViewPoem.aspx?id=159625",""],[5690,"ما بال نائحة الأغصان لم تنمِ","https://www.poetsgate.com/ViewPoem.aspx?id=172182",""],[5720,"الأَرض (*)","https://www.poetsgate.com/ViewPoem.aspx?id=200226",""],[5732,"الله من قلب","https://www.poetsgate.com/ViewPoem.aspx?id=177901",""],[5744,"انا الأُنثى","https://www.poetsgate.com/ViewPoem.aspx?id=207275",""],[5953,"لاح ضياء القمر الزاهر","https://www.poetsgate.com/ViewPoem.aspx?id=93849",""],[5956,"أثر الحوادث في شعري","https://www.poetsgate.com/ViewPoem.aspx?id=186090",""],[5966,"ياموطن الخير","https://www.poetsgate.com/ViewPoem.aspx?id=158435",""],[5975,"غاليتي..","https://www.poetsgate.com/ViewPoem.aspx?id=53267",""],[5975,"رواحٌ من الإيمان..","https://www.poetsgate.com/ViewPoem.aspx?id=58782",""],[6131,"وَ غَنَّى الشَّهيدُ الشَّاعرُ","https://www.poetsgate.com/ViewPoem.aspx?id=189277",""],[186,"أتتنا وجنح الليل منسدل الستر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55767&r=&rc=30",""],[186,"رواية جاد منشبها اللبيب بما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55742&r=&rc=5",""],[6355,"يد أبيك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66586&r=&rc=46",""]],"verses":[["رِواءٌ مِنَ الماءِ آماقُهُ","ظِماءٌ مِنَ النَومِ أَجفانُهُ",0,"ن",2,0],["رَوامٍ إِلى جَمعٍ كَأَنَّ رُؤوسَها","قِبابٌ بَنَتها بِالمَراقِبِ عادُ",1,"د",1,0],["رِواءٌ لا تُريحُ الريحُ فيها","مِنَ الإِدلاجِ إِنتاجَ الغَوادي",2,"د",2,0],["رِوايَةُ الفَضْلِ في انْقِطاعٍ","عنْهُمْ إذا ما فُرِضْتَ راوِي",3,"ا",3,0],["رِوايةٌ في عَوالي المَجْدِ ثابتَةٌ","وفي صَحائِفِ بِيضِ المَشْرِفيّاتِ",4,"ت",1,0],["رَواحَ العَشِيِّ وَسَيرَ الغُدوِّ","يَدَ الدَهرِ حَتّى تُلاقي الخِيارا",5,"ر",2,0],["رَوادِفُهُ تَثني الرِداءَ تَسانَدَت","إِلى مِثلِ دِعصِ الرَملَةِ المُتَهَيِّلِ",6,"ل",1,0],["رَوايا فِراخٍ بِالفَلاةِ تَوائِمٍ","تَحَطَّمَ عَنها البيضُ حُمرِ الحَواصِلِ",7,"ل",1,0],["رِواقٍ يُظِلُّ القَومَ أَو مُكفَأٍ بِهِ","حَبائِلُهُ مِن يُمنَةٍ وَعَطائِفِ",8,"ف",1,0],["رواضع في حجر الغرام تَرَعْرَعَتْ","وشبَّت فشَبَّتْ حبِّها في فؤاديا",9,"ي",2,0],["رواعد تملأ رُعباً","وترسل في تهزُّمها المنونا",10,"ن",2,0],["رواية رؤيا قد جرت في ديارنا","فجائعها حتى انتهت في المقابر",11,"ر",1,0],["روائح يعبقن الملا فكأنها","لذكر علاء الدين في الطيب ينتمي",12,"م",2,0],["رواغي رواغُ الخائِف القلبِ لا السالي","وهجريَ هجر النافر الجأش لا القالي",13,"ل",2,1],["رَوابٍ مِن بَني جُشَمَ بنِ بَكرٍ","تَصَدَّعُ عَن مَناكِبِها السُيولُ",14,"ل",1,0],["رِوايَةً يَظهَرُ فيها لَكُم","كَيفَ يُداجي الصادِقَ الخاتِلُ",15,"ل",1,0],["رواياتهما زادت","أحاديث الهوى شانا",16,"ن",2,0],["رُواةُ قَصائِدي فَاعجَب لِشِعرٍ","بِكُلِّ مَحَلَّةٍ يَرويهِ خَلقُ",17,"ق",1,0],["رُواةُ قَصائِدي قَد رَتَّلوها","وَغَنَّوها الأَسِنَّةَ وَالنِصالا",18,"ل",2,0],["رَواسي اِبتِداعٍ في رَواسي طَبيعَةٍ","تَكادُ ذُراها في السَحابِ تُغَيَّبُ",19,"ب",1,0],["رَوامي الكِفافِ وَكِبدِ الوِهادِ","وَجارِ البُوَيرَةِ وادِ الغَضى",20,"ا",1,0],["رِواقُ العِزِّ حَولَكِ مُسبَطِرٌّ","وَمُلكُ عَلِيٍّ اِبنِكِ في كَمالِ",21,"ل",1,0],["رواءٌ كإيماضِ الغَمامةِ مونقٌ","وبِشرٌ كصدرِ المشرفيِّ صقيلُ",22,"ل",1,0],["روائعُ أحلامٍ تمرُّ بمضجعي","وتطردُ عن عيني الغشاشَ المروَّعَا",23,"ع",2,0],["رُواءٌ وَرَأيٌ عِندَما تُنقَضُ الحُبى","وَتُرعِدُ أَشباهُ الخُطوبِ وَتُبرِقُ",24,"ق",1,0],["رَواعِفُ بِالجادِيِّ كُلَّ عَشِيَّةٍ","إِذا سُفنَهُ سَوفَ الهِجانِ الرَواشِفِ",25,"ف",1,0],["رَوافعُ أبصارٍ خُفِضْنَ مَذَلَّةً","وطولُ يمينٍ قَصَّرَت وشِمالِ",26,"ل",1,0],["رَواكِدُ قيسُ الكَفِّ مِن مُتَناوِلٍ","وَفيها عُلىً لا تُرتَقى بِالسَلالِمِ",27,"م",1,0],["رَواحِلُنا قَد بَزَّنا الهَمُّ أَمرَها","إِلى أَن حَسِبنا أَنَّهُنَّ رَواحِلُه",28,"ل",2,0],["رَواجِحُ أَكفالٍ مَريضاتُ أَعيُنٍ","إِلَيهِنَّ يَصبو الراهِبَ المُتَنَطِّسُ",29,"س",1,0],["رَواحاً وَقَد حَنَّت أَوائِلَ لَيلِها","رَوائِحُ لِلإِظلامِ أَلوانُها كُدرُ",30,"ر",1,0],["روايةٌ في شُعوبِ الشَّرق رائعةٌ","لها على مَلعبِ الأجيالِ تمثيلُ",31,"ل",1,0],["روايةٌ وخَيَالاتٌ مُنَمَّقَةٌ","تُصَاغُ مِن دار نُوّابٍ ودُستورِ",32,"ر",1,0],["رِوايَةٌ صاغَها سَعدٌ وَزَيَّنَها","مِن صَحبِهِ الصيدِ لِلأَطفالِ راويها",33,"ي",3,0],["رُواءٌ من العيشِ الرخيِّ وبهجَةٌ","من الكُحْلِ في الأجفانِ أو مُرْسَلِ الشَّعَرْ",34,"ر",1,0],["رَوَّاكِ ربُّ النّاسِ من سرحةٍ","ألقى عليها ظِلَّهُ من عَل",35,"ل",1,0],["رَوابٍ في النَهارِ فَما تَراها","وَيمشي مَشيَ لَيلَتِها تَعومُ",36,"م",1,0],["رَوايا فِراخٍ تَنتَحي بِأُنوفِها","خَراشِيَّ قَيضِ القَفزَةِ المُتَصَيِّحِ",37,"ح",1,0],["رِواءَكِ فَاِشرَبي وَدَعي ثِماداً","وَأَحواضاً يَكونُ لَها رَواكِ",38,"ك",1,0],["رَوانِيَ صَبري فَأَضحَت إِلَيَّ","عُيونٌ عَلى غَفَلاتٍ رَواني",39,"ن",2,0],["رَوائِمَ لي عَكَفنَ عَلَيَّ لَيلاً","عُكُوفَ العُوذِ قَد رَئِمَت جَنينا",40,"ن",2,0],["روايةً مُلَّت كما","مُلَّ الزمانُ ملعبا",41,"ب",2,0],["روامي الكفاف وكبد الوهاد","وجار البويرة وادي الغضى",42,"ا",1,0],["رواق العزّ فوقك مسبطرّ","وملك عليّ ابنك في كمال",43,"ل",1,0],["رواقُ مجدٍ على جدرانهِ رُفِعَتْ","للخالدين أماثيلٌ وآثارُ",44,"ر",1,0],["رَوَائِعُ الخَلْقِ حَلَّتْ مِنْ سَرِيرتِهِ","فِي مَجْمَعٍ لِشتِيتِ الْفنِّ مُخْتَصَر",4