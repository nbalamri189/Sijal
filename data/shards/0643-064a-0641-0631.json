{"poems":[[51,"ما كل ما تشتهي يكون","https://www.aldiwan.net/poem63158.html","مجزوء البسيط"],[82,"أإن بكت ورقاء في غضن بان","https://www.aldiwan.net/poem31262.html","السريع"],[77,"طلب المجد من طريق السيوف","https://www.aldiwan.net/poem69060.html","الخفيف"],[412,"أرحت نفسي من عداة الملاح","https://www.aldiwan.net/poem50195.html","السريع"],[461,"كيف رأيتم طلبي وصبري","https://www.aldiwan.net/poem2178.html","الرجز"],[463,"كيف رأيت الإبلا","https://www.aldiwan.net/poem55956.html","مجزوء الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79947","المنسرح"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[4739,"إعتذار من نوع خاص","https://www.poetsgate.com/ViewPoem.aspx?id=28123",""],[5038,"قارورة مسك","https://www.poetsgate.com/ViewPoem.aspx?id=189987",""],[5277,"طيفٌ عابر","https://www.poetsgate.com/ViewPoem.aspx?id=187892",""],[5431,"دجلة الحب-للعراق الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=198264",""],[5638,"ملحمة حر","https://www.poetsgate.com/ViewPoem.aspx?id=197920",""]],"verses":[["كَيفَ رَضينا بِضيقِ دارٍ","أَم كَيفَ قَرَّت بِها العُيونُ",0,"ن",1,0],["كيفَ رَمَتْ بالنّارِ أحشاءَهُ","ذاتُ هديلٍ في رياضِ الجِنَان",1,"ن",1,0],["كيفَ راهنتَ في السباقِ على ما","فيك من وِنيَةٍ وباعٍ قَطوف",2,"ف",1,0],["كَيفَ رَجوعي في الهَوى بَعدَما","خَلَعته خَلع رِداء فطاح",3,"ح",1,0],["كَيفَ رَأَيتُم طَلَبي وَصَبري","شَفَيتُ يا مازِنُ حَرَّ صَدري",4,"ر",2,1],["كيف رأيت الإبلا","خواطفاً كلاَ ولا",5,"ل",2,1],["كيف رقابٌ من الجحيم بكم","حرَّرها الله في تبصُّرها",6,"ر",3,0],["كيف رضت قواك خيل الأعادي","وبفقديك ما استقام قواها",7,"ا",3,0],["كيف روض الشوق ما تنبت اشجاره","كيف تصبح ديرة الود مهجوره",8,"ر",2,0],["كَيفَ رامَ الْوَصْلَ في أُغْنِيَةٍ","وَارْتَقى شِعْري إِلَيها مِنْ دَمي",9,"م",2,0],["كيفَ روَّتْ بشذاها خافقي","فجنتْ قلبيَ بعدَ اليَبَسِ",10,"س",1,0],["كيف ريقت جرارها بعد عزٍّ","في حروب تبيحها للهباء",11,"ا",2,0],["كَيْفَ رُمْتَ التَّحَدِّيَ انْطِقْ أَجِيبَنْ","سَفَهًا مِنْكَ أَمْ لِجَهْلِ الْوَعِيدِ؟",12,"د",1,0]]}