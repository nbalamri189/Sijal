{"poems":[[53,"وسمتك حالية الربيع المرهم","https://www.aldiwan.net/poem29817.html","الكامل"],[53,"قربوهن ليبعدن المغارا","https://www.aldiwan.net/poem30447.html","الرمل"],[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[86,"إن كنتم تبذلون المال عن رهب","https://www.aldiwan.net/poem10919.html","البسيط"],[86,"إن صوروك فإنما قد صوروا","https://www.aldiwan.net/poem68950.html","الكامل"],[93,"تحية أيها القتلى وتسليماً","https://www.aldiwan.net/poem11387.html","البسيط"],[30,"أعن ترسمت من خرقاء منزلة","https://www.aldiwan.net/poem29532.html","البسيط"],[30,"ذكرت فاهتاج السقام المضمر","https://www.aldiwan.net/poem29590.html","الرجز"],[4,"إن تقوى ربنا خير نفل","https://www.aldiwan.net/poem21191.html","الرمل"],[47,"المجد بالرقة مجموع","https://www.aldiwan.net/poem25233.html","السريع"],[23,"ما بال عيني دموعها تكف","https://www.aldiwan.net/poem21478.html","المنسرح"],[72,"يا شاهر اللحظ حبي فيك مشهور","https://www.aldiwan.net/poem18695.html","البسيط"],[51,"صادت فؤادي عشية النفر","https://www.aldiwan.net/poem62946.html","الطويل"],[91,"سمعت عويل النائحات عشية","https://www.aldiwan.net/poem8833.html","عموديه"],[91,"راودني النوم وما برحا حتى طأطأت له راسي","https://www.aldiwan.net/poem8971.html","عموديه"],[12,"أونس ريح الموت في المكاسر","https://www.aldiwan.net/poem1213.html",""],[38,"طاف الخيال بأصحابي وقد هجدوا","https://www.aldiwan.net/poem7701.html","البسيط"],[92,"يا قلب كم فيك من دنا محجبة","https://www.aldiwan.net/poem38914.html","البسيط"],[92,"قدس الله ذكره من صباح","https://www.aldiwan.net/poem38922.html","الخفيف"],[89,"كان النعي يثير في الأرواح","https://www.aldiwan.net/poem44718.html","الكامل"],[89,"اذكري إذ كنا صغيرين نلعب","https://www.aldiwan.net/poem44865.html","الخفيف"],[85,"قم سليمان بساط الريح قاما","https://www.aldiwan.net/poem63696.html","الرمل"],[45,"مغنى منازلها التي بمشقر","https://www.aldiwan.net/poem63594.html","الكامل"],[45,"شرخ الشباب أخو الصبا وأليفه","https://www.aldiwan.net/poem65161.html","الخفيف"],[61,"أؤنب الشوق فيهم وهو يضطرم","https://www.aldiwan.net/poem51449.html","البسيط"],[61,"يأبى إذا خطر العقيق بباله","https://www.aldiwan.net/poem51464.html","الكامل"],[49,"أخوي مرا بالقبور","https://www.aldiwan.net/poem62076.html","مجزوء الكامل"],[66,"طمعي في لقاك بعد إياس","https://www.aldiwan.net/poem40639.html","الخفيف"],[66,"جن الظلام فمذ بدا مبتسما","https://www.aldiwan.net/poem40643.html","الكامل"],[80,"قالوا صبا يا من رأى مستهام","https://www.aldiwan.net/poem31289.html","السريع"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[48,"وبلدة فيها زور","https://www.aldiwan.net/poem63368.html","مجزوء الرجز"],[48,"وقانص محتقر ذميم","https://www.aldiwan.net/poem65275.html","الرجز"],[46,"إن يقرب الموت مني","https://www.aldiwan.net/poem22148.html","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85525","المجتث"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72239","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16644","السريع"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16626","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54948","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54710","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54267","المجتث"],[106,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[6,"معلقة الحارث بن حلزة اليشكري","https://www.poetsgate.com/ViewPoem.aspx?id=11409",""],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[91,"الدمعة الخرساء","https://www.poetsgate.com/ViewPoem.aspx?id=53068",""],[91,"الدمعة الخرساء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67822&r=&rc=7",""],[110,"كوكب السعد بالنجاح أنارا","https://www.aldiwan.net/poem16288.html","الخفيف"],[129,"وحباك الإله ملكا وإنصالا","https://www.aldiwan.net/poem50531.html","الخفيف"],[129,"سمعا وطوعا للإمام","https://www.aldiwan.net/poem50606.html","مجزوء الكامل"],[187,"في كل منقلب غيظ أساء به","https://www.aldiwan.net/poem43798.html","البسيط"],[187,"عامل الإنسان قبل ال","https://www.aldiwan.net/poem43947.html","مجزوء الرمل"],[262,"عمر الفتى يقصر ما طالا","https://www.aldiwan.net/poem38208.html","السريع"],[272,"لم يبق في الحي من ربع ولا طلل","https://www.aldiwan.net/poem52078.html","البسيط"],[291,"هذه أنة تجاوب في أنحاء صدري","https://www.aldiwan.net/poem11692.html","الخفيف"],[329,"بين أمواجك يا ده","https://www.aldiwan.net/poem55033.html","مجزوء الرمل"],[329,"يا نديمي هات الأباريق هات","https://www.aldiwan.net/poem55034.html","الخفيف"],[343,"في هدأة الفكر","https://www.aldiwan.net/poem55319.html","منهوك المنسرح"],[343,"صرفند معقل الاحرار ما","https://www.aldiwan.net/poem55320.html","الرمل"],[354,"أنسمة فاحت بنشر الخزام","https://www.aldiwan.net/poem39801.html","السريع"],[372,"شك فيما شكوت من طول ليلي","https://www.aldiwan.net/poem57240.html","الخفيف"],[392,"الحمدلله حمدا موافيا بالنوال","https://www.aldiwan.net/poem54549.html","عموديه"],[404,"لا توردن على سمعي من الكلم","https://www.aldiwan.net/poem33446.html","البسيط"],[440,"الشمس شاهدة وإن تك واحده","https://www.aldiwan.net/poem34857.html","الكامل"],[444,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[459,"ضنا بأن يعلم الناس الهوى لمن","https://www.aldiwan.net/poem55861.html","البسيط"],[459,"كيف رأيت الإبلا","https://www.aldiwan.net/poem55956.html","مجزوء الرجز"],[480,"بالشاعرين نحيي ندوة الأدب","https://www.aldiwan.net/poem37191.html","البسيط"],[480,"أيقظ شعورك واطرح برقع الكسل","https://www.aldiwan.net/poem37601.html","البسيط"],[496,"مولاي إن عدت ولم ترضى لي","https://www.aldiwan.net/poem9774.html","السريع"],[515,"هذا الحمى فانزل على جرعائه","https://www.aldiwan.net/poem20799.html","الكامل"],[539,"أبخير عيد أم بخير إمام","https://www.aldiwan.net/poem47940.html","عموديه"],[552,"إن نعمى وما درت","https://www.aldiwan.net/poem47159.html","مجزوء الخفيف"],[552,"أأبا الحسين كفيت ما بعد الردى","https://www.aldiwan.net/poem47742.html","الكامل"],[552,"ما في السلو لنا نصيب يطلب","https://www.aldiwan.net/poem48091.html","الكامل"],[559,"أيها الطلعة التي أخذتنا","https://www.aldiwan.net/poem34407.html","الخفيف"],[562,"يا رب أنت تجبر الكسيرا","https://www.aldiwan.net/poem27849.html","الرجز"],[563,"لاحت فقلنا كوكب الصبح بان","https://www.aldiwan.net/poem52897.html","السريع"]],"verses":[["أَو ناقِشٍ مِن جِلدِهِ شَوكَ القَنا","عَن كُلِّ فاغِرَةٍ كَشَدقِ الأَعلَمِ",0,"م",1,0],["أَو نَعامُ الدَوِّ بادَرنَ الدُجى","يَتَجاوَينَ عِراراً وَزِمارا",1,"ر",2,0],["أَو نَقَشتُم فَالنَقشُ تَجشَمُهُ النا","سُ وَفيهِ الصَلاحُ وَالإِبراءُ",2,"ا",2,0],["أَو نابَنا حادِثٌ نَرجو إِزالَتَهُ","قالَ اِستَكينوا وَخَلّوا سَورَةَ الغَضَبِ",3,"ب",1,0],["أَو نَقَّصوكَ فَإِنَّما قَد نَقَّصوا","دينَ النَبِيِّ مُحَمَّدِ المُختارِ",4,"ر",1,0],["أَو نَالَ حُرِّيَّةً قَومٌ بِهَا جَدُرُوا","وَهُمْ يُبَالُونَ تَقْتِيلاً وَتَكْلِيمَا",5,"م",2,0],["أَو نَفحَةٌ مِن أَعالي حَنوَةٍ مَعَجَت","فيها الصَبا مَوهِناً وَالرّوضُ مَرهومُ",6,"م",1,0],["أَو نآئِحاتٌ موجَعاتٌ حُسَّرٌ","وَإِن حَبا مِن أَنفِ رَملٍ مَنخِرُ",7,"ر",1,0],["أَو نَهَتهُ فَأَتاهُ رِزقُهُ","فَاِشتَوى لَيلَةَ ريحٍ وَاِجتَمَل",8,"ل",1,0],["أَو نَصِلُ الأَبعَدَ مِن قَومِنا","وَالنَسَبُ الأَقرَبُ مَقطوعُ",9,"ع",1,0],["أَو نَدعُ في الأَوسِ دَعوَةً هَرَباً","وَقَد بَدا في الكَتيبَةِ النَصَفُ",10,"ف",1,0],["أو نعل تبر أجادت في هديته","إلى جوادِ ابن أيوبَ المقادير",11,"ر",1,0],["أو نُطِّقت خصرها بمنطقة ال","جوزاء قلَّت لذلك الخصر",12,"ر",1,0],["أَو نَسمَةً أَنا هَمسُها وَحَفيفُها","أَبَداً تُطَوِّفُ في الرُبى وَتَدورُ",13,"ر",1,0],["أَو نَصنَعُ خَيلاً مِن قَصَبٍ","أَو طَيّاراتٍ مِن وَرَقِ",14,"ق",1,0],["أَو نَأتي بِالفَحمِ القاتِم","وَنُصَوِّرُ فَوقَ الأَبوابِ",14,"ب",1,0],["أَو نَجبُلُ ماءً وَتُرابا","وَنُشيدُ بُيوتاً وَقِبابا",14,"ب",2,0],["أَو نَجعَلُ مِنهُ أَنصابا","أَو نَصنَعُ حَلوى وَكَبابا",14,"ب",2,0],["أُونِس ريحَ المَوتِ في المكاسِر","لا بُدَّ يَوماً من لِقاء المقادِر",15,"ر",1,1],["أَو ناشِطٌ أَسفَعُ الخَدَّينِ أَلجَأَهُ","نَفحُ الشَمالِ فَأَمسى دونَهُ العَقَدُ",16,"د",1,0],["أَو نحلَةً جرَّها التيَّارُ مُنْدَفِعاً","إلى البحارِ تُغنّي فوقها الدِّيَمُ",17,"م",1,0],["أَو نسيماً أَضمُّ صدركِ في رِفقٍ","إلى صدريَ الخفوقِ النَّحيلِ",18,"ل",1,0],["او نم بقبرك مستريحا من ونى","او هي متانة فكرك السباح",19,"ح",1,0],["او نغني معا اناشيد قد طا","بت بلحن مشج وصوت مكهرب",20,"ب",1,0],["أَو نُجوماً ذاتَ أَذنابٍ بَدَت","تُنذِرُ الناسَ نُشوراً وَقِياما",21,"م",2,0],["أَو نِعمَةً ثُعَلِيَّةً يَمَنِيَّةً","بِمُحَمَّدِ بنِ الأَشعَثَينِ وَجَعفَرِ",22,"ر",1,0],["أَو نائِلُ الفَتحِ بنِ خاقانَ الَّذي","لِلمَكرُماتِ تَليدُهُ وَطَريفُهُ",23,"ف",2,0],["أُؤَنِّبُ الشَّوقَ فيهِم وهو يَضطَرِمُ","وأستَقِلُّ دموعَ العينِ وهي دَمُ",24,"م",1,1],["أو نابِلاً لمّا تَكامَلَ نَزعُه","لم تتَّصل أغراضُه بِنبالِه",25,"ل",2,0],["أَو ناطِقٍ أَو سامِعٍ","يَوماً بِعُرفٍ أَو نَكيرِ",26,"ر",1,0],["أَو نَفاري عَليكَ مِن نَصَبِ الدَر","بِ بِحَسبِ الإِدلالِ وَالإيناسِ",27,"س",1,0],["أَو نورُ شَمسِ الدينِ قَد جَلّى الدُجى","لَمّا بَدا وَلَهُ القُلوبُ سَماءُ",28,"ا",2,0],["أو نفحَةٌ تعبقُ من روضةٍ","تُحيي من الصّبّ رَميمَ العظام",29,"م",1,0],["أوَ نُورُ الإِلهِ تُطْفِئُهُ الأَفْ","واهُ وَهْوَ الذي به يُسْتَضاءُ",30,"ا",2,0],["أَو نالَكَ القَومُ أَثَر","وَإِن رَأى خَيراً نَشَر",31,"ر",1,0],["أَو نَعسَةٌ تَنهَضُ في نَؤومِ","أَشجَعُ مِن ذي لُبَدٍ هَضيمِ",32,"م",1,0],["أَو ناشِطٌ يَتَبَغّى","في مُقفَرِ الأَرضِ عِربَه",33,"ب",2,0],["أَو نخوة كان فيها","للقاعدين اندفاع",34,"ع",1,0],["أو ناشئاً حَدَثاً تُحَّكمُ مِثْلَهُ","صُلْعُ الرجالِ تَوارَثَ التحكيما",35,"م",2,0],["أو نِسْوةُ الزّنْجِ بِأَيْمانِها","للرّقْصِ قُضْبٌ ذَهَبِيّات",36,"ت",1,0],["أو نَزَلَتْ تَنْهَبُ في خُفْيَةٍ","تَخْتَارُ ما تَفْعَلُ أو تُلْهَمُ",37,"م",1,0],["أَوْ نَثَرْتَ الكَلاَمَ فَهْوَ مِنَ البَهْجَةِ","وَالفِطْنَةِ البَدِيعَةِ شِعْرُ",38,"ر",1,0],["أَوْ نَهرِهَا وَبِهِ مَوَارِدُ فِي","حِسٍّ وَفِي مَعْنىً لِوُرَّادِ",39,"د",1,0],["أو نفحةٌ من جميلٍ","طافتْ بأحلام بُثْنِ",40,"ن",1,0],["أو نازِلٌ بجَزِيرةٍ، أو سابحٌ","في البحر بين الرَّأسِ والشَّلاَل",41,"ل",1,0],["أو نقشتم فالنقش يجشمه الن","اس وفيه الإسقام والإبراء",42,"ا",2,0],["أو نداءاتُ حارسٍ وهو في الأشباح","لاحتْ لعينه مستريب",43,"ب",1,0],["أو نسمة أنا همسها وحفيفها","أبدا تطوّف في البرى وتدور",44,"ر",1,0],["أو نسمة أنا همسها وحفيفها","أبدا تطوّف في الذرى وتدور",45,"ر",1,0],["أو نلتقي عند الكثيب ، على رضى","وقناعة ، صفصافة وغدير",45,"ر",1,0],["أَو نَحُثُّ الركاب يَوماً لِمصر","وَكَفَتنا دِيارُهُ الأَمصارا",46,"ر",2,0],["أَو نُجيد المَديح لِلغَير سَهواً","وَنَرى في رِدائِهِ الأَخيارا",46,"ر",2,0],["أوْ ندىً لو فرقته بينَ أهلِ","الأرض لم تُلْفِ فيهمُ بُخَّالا",47,"ل",2,0],["أو ناحَ طيرٌ بالضحى","مِن فوق أغصانِ الشجرْ",48,"ر",1,0],["أو نخلة السوء يأوي البوم مذ يفعت","في رأسها وهي لا شيص ولا كثر",49,"ر",1,0],["أو نفاقا أو رياء","أو لأسباب تفيد",50,"د",1,0],["أو نائل يصلح اعماله","فربما قد ساء أعمالا",51,"ل",2,0],["أَو نور هدى بريك الشمس طالعة","في نقطة المَجدِ لا في نقطة الحمل",52,"ل",1,0],["أو نواح المحبّ في الطلل البالي","رأى الرسم بعد طول اغتراب",53,"ب",1,0],["أو نعيبا في حمى الأم","وات لا يطرب حيا",54,"ي",2,0],["أو نعيم عبت ليالي منه","خمر وصل يتيه بالقبلات",55,"ت",1,0],["آونة اضداد","وتارة أشباه",56,"ه",1,0],["او نسيم هبّ يسري سحرا","يبهج النفس يقر الأعينا",57,"ن",2,0],["أَو نبَّه الوَسنان في شَدوه","حيّ عَلى نَيل المُنى يا نِيام",58,"م",1,0],["أو ندىً من يَدَي أَبي الجَيشِ لا يُح","صَى بِوَزنٍ ولا يُحاطُ بكَيلِ",59,"ل",1,0],["أوناسيا إن كثر تبطل كذلك توال","ثلاث حركات لو سهوا فخف ذا الجلال",60,"ل",1,0],["أو نكتة لذوي الآداب مطربة","يهتز منها فؤاد الحاذق الفهم",61,"م",1,0],["أَوْ نازِعٍ فزِعٍ إِلَيْكَ حياتهُ","من حَيَّةٍ فِي قَلْبِهِ لكَ راصِدَهْ",62,"د",2,0],["أو نظام الشمس مملوكا رقيق","ما له شغل سوى خدمته",63,"ه",1,0],["أو نصرةٌ لم يزل جودُ الوزير بها","سيفا مع الحرّ مسلولا على الزمنِ",64,"ن",1,0],["أو نِيل بالفضل السُّها","لكنتَ ذاك الرَّجلا",65,"ل",2,0],["أو نظرة في طروس نستفيد بها","ضاءت من الجانب الشرقي كالشهب",66,"ب",1,0],["أو نحرق الإرم المضني ونعجب من","إخفاق سعي وما في الجهل من حيل",67,"ل",1,0],["أو نقد الزور على ناقدِ","فالخمر قد تُعصب بالثيبِ",68,"ب",1,0],["أو نحوَهُ نسرُ النجومِ هَوى فلا","عجباً فبَيضتُهُ بخِدرِ خِبائهِ",69,"ا",3,0],["أو نائحٍ يَبكي أَخَاهُ أوِ ابنَهُ","من مُنتَمٍ لِقَرابَةِ الأَرحامِ",70,"م",1,0],["أو نسيمَ الصَّبا يمر","رُ اِجتِيازاً برُدْنِها",71,"ن",3,0],["أو ناضلوك فَضَلْتَهُمْ بصوائبٍ","أو زاحموك زَحَمْتَهمْ بقَدامِسِ",72,"س",1,0],["أَو نِعمتانِ فَهذهِ مَتروكةٌ","مذخورة أبداً وأُخرى تُسلبُ",73,"ب",1,0],["أو نظرناه في الجلال رأينا","أسداً فاتكاً من الأُسْدِ أسطى",74,"ط",2,0],["آوِنَةً وَيَأخُذُ الخُصورا","وَيَركَبُ العَم صاء أَن تَحورا",75,"ر",2,0],["أو نارُ إبراهيمَ مشبوبةً","في مُهَج الحُسَّادِ ذاتِ الدُخانْ",76,"ن",1,0]]}