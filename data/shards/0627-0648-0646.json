iewPoem.aspx?id=53679",""],[5106,"زَاْكِيَاْتٍ كَفَرْحَةِ الأَنْبِيَ","https://www.poetsgate.com/ViewPoem.aspx?id=156840",""],[5186,"أي متى كنت مغرما بالملاح؟","https://www.poetsgate.com/ViewPoem.aspx?id=156552",""],[5213,"صدقتك سلمى وعدها وودادها","https://www.poetsgate.com/ViewPoem.aspx?id=170455",""],[5293,"المتكبرة","https://www.poetsgate.com/ViewPoem.aspx?id=186134",""],[5376,"ياأمتي خبا النفيرُ فاسمعي","https://www.poetsgate.com/ViewPoem.aspx?id=188498",""],[5409,"تخشع النفس هيبةً من جلال ال","https://www.poetsgate.com/ViewPoem.aspx?id=155478",""],[5409,"علاك يقصر عن إدراكه الكلم","https://www.poetsgate.com/ViewPoem.aspx?id=155497",""],[5431,"أفيون....","https://www.poetsgate.com/ViewPoem.aspx?id=204084",""],[5461,"اذكريني","https://www.poetsgate.com/ViewPoem.aspx?id=27708",""],[5461,"الونه","https://www.poetsgate.com/ViewPoem.aspx?id=8533",""],[5561,"المجد","https://www.poetsgate.com/ViewPoem.aspx?id=205111",""],[5644,"يطيب يومي","https://www.poetsgate.com/ViewPoem.aspx?id=198641",""],[5644,"سامح فؤادًا","https://www.poetsgate.com/ViewPoem.aspx?id=198654",""],[5668,"ذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=178829",""],[5690,"دع عنك تشبيباً بوصف محاجرِ","https://www.poetsgate.com/ViewPoem.aspx?id=172161",""],[5720,"الدُّنْيَا","https://www.poetsgate.com/ViewPoem.aspx?id=203978",""],[5732,"يا روح روحي","https://www.poetsgate.com/ViewPoem.aspx?id=177940",""],[5881,"غرباء","https://www.poetsgate.com/ViewPoem.aspx?id=183810",""],[5897,"محمدٌ .. يا رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=156845",""],[5897,"من وحي ال21","https://www.poetsgate.com/ViewPoem.aspx?id=158793",""],[5943,"عيش بلا أمل","https://www.poetsgate.com/ViewPoem.aspx?id=34324",""],[5953,"يا محضر الغيد بالصمان بالغار","https://www.poetsgate.com/ViewPoem.aspx?id=93853",""],[5956,"أجمل جنة في الأرض","https://www.poetsgate.com/ViewPoem.aspx?id=184960",""],[5956,"صوتٌ حنونٌ فألُهُ تبشيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=205261",""],[5957,"يا شجي الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=53772",""],[6038,"مجرد أوهام 2003","https://www.poetsgate.com/ViewPoem.aspx?id=25701",""],[6056,"وردتين ٍ على تل","https://www.poetsgate.com/ViewPoem.aspx?id=130333",""],[6056,"خشف المها","https://www.poetsgate.com/ViewPoem.aspx?id=130384",""],[6097,"أيّار","https://www.poetsgate.com/ViewPoem.aspx?id=186068",""],[6143,"حلم","https://www.poetsgate.com/ViewPoem.aspx?id=176851",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[6262,"العائد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80128&r=&rc=26",""],[6299,"أُونِسُ رِيحَ المَوْتِ في المكاسِرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19685&r=&rc=10",""]],"verses":[["أَو ناقِشٍ مِن جِلدِهِ شَوكَ القَنا","عَن كُلِّ فاغِرَةٍ كَشَدقِ الأَعلَمِ",0,"م",1,0],["أَو نَعامُ الدَوِّ بادَرنَ الدُجى","يَتَجاوَينَ عِراراً وَزِمارا",1,"ر",2,0],["أَو نَقَشتُم فَالنَقشُ تَجشَمُهُ النا","سُ وَفيهِ الصَلاحُ وَالإِبراءُ",2,"ا",2,0],["أَو نابَنا حادِثٌ نَرجو إِزالَتَهُ","قالَ اِستَكينوا وَخَلّوا سَورَةَ الغَضَبِ",3,"ب",1,0],["أَو نَقَّصوكَ فَإِنَّما قَد نَقَّصوا","دينَ النَبِيِّ مُحَمَّدِ المُختارِ",4,"ر",1,0],["أَو نَالَ حُرِّيَّةً قَومٌ بِهَا جَدُرُوا","وَهُمْ يُبَالُونَ تَقْتِيلاً وَتَكْلِيمَا",5,"م",2,0],["أَو نَفحَةٌ مِن أَعالي حَنوَةٍ مَعَجَت","فيها الصَبا مَوهِناً وَالرّوضُ مَرهومُ",6,"م",1,0],["أَو نآئِحاتٌ موجَعاتٌ حُسَّرٌ","وَإِن حَبا مِن أَنفِ رَملٍ مَنخِرُ",7,"ر",1,0],["أَو نَهَتهُ فَأَتاهُ رِزقُهُ","فَاِشتَوى لَيلَةَ ريحٍ وَاِجتَمَل",8,"ل",1,0],["أَو نَصِلُ الأَبعَدَ مِن قَومِنا","وَالنَسَبُ الأَقرَبُ مَقطوعُ",9,"ع",1,0],["أَو نَدعُ في الأَوسِ دَعوَةً هَرَباً","وَقَد بَدا في الكَتيبَةِ النَصَفُ",10,"ف",1,0],["أو نعل تبر أجادت في هديته","إلى جوادِ ابن أيوبَ المقادير",11,"ر",1,0],["أو نُطِّقت خصرها بمنطقة ال","جوزاء قلَّت لذلك الخصر",12,"ر",1,0],["أَو نَسمَةً أَنا هَمسُها وَحَفيفُها","أَبَداً تُطَوِّفُ في الرُبى وَتَدورُ",13,"ر",1,0],["أَو نَصنَعُ خَيلاً مِن قَصَبٍ","أَو طَيّاراتٍ مِن وَرَقِ",14,"ق",1,0],["أَو نَأتي بِالفَحمِ القاتِم","وَنُصَوِّرُ فَوقَ الأَبوابِ",14,"ب",1,0],["أَو نَجبُلُ ماءً وَتُرابا","وَنُشيدُ بُيوتاً وَقِبابا",14,"ب",2,0],["أَو نَجعَلُ مِنهُ أَنصابا","أَو نَصنَعُ حَلوى وَكَبابا",14,"ب",2,0],["أُونِس ريحَ المَوتِ في المكاسِر","لا بُدَّ يَوماً من لِقاء المقادِر",15,"ر",1,1],["أَو ناشِطٌ أَسفَعُ الخَدَّينِ أَلجَأَهُ","نَفحُ الشَمالِ فَأَمسى دونَهُ العَقَدُ",16,"د",1,0],["أَو نحلَةً جرَّها التيَّارُ مُنْدَفِعاً","إلى البحارِ تُغنّي فوقها الدِّيَمُ",17,"م",1,0],["أَو نسيماً أَضمُّ صدركِ في رِفقٍ","إلى صدريَ الخفوقِ النَّحيلِ",18,"ل",1,0],["او نم بقبرك مستريحا من ونى","او هي متانة فكرك السباح",19,"ح",1,0],["او نغني معا اناشيد قد طا","بت بلحن مشج وصوت مكهرب",20,"ب",1,0],["أَو نُجوماً ذاتَ أَذنابٍ بَدَت","تُنذِرُ الناسَ نُشوراً وَقِياما",21,"م",2,0],["أَو نِعمَةً ثُعَلِيَّةً يَمَنِيَّةً","بِمُحَمَّدِ بنِ الأَشعَثَينِ وَجَعفَرِ",22,"ر",1,0],["أَو نائِلُ الفَتحِ بنِ خاقانَ الَّذي","لِلمَكرُماتِ تَليدُهُ وَطَريفُهُ",23,"ف",2,0],["أُؤَنِّبُ الشَّوقَ فيهِم وهو يَضطَرِمُ","وأستَقِلُّ دموعَ العينِ وهي دَمُ",24,"م",1,1],["أو نابِلاً لمّا تَكامَلَ نَزعُه","لم تتَّصل أغراضُه بِنبالِه",25,"ل",2,0],["أَو ناطِقٍ أَو سامِعٍ","يَوماً بِعُرفٍ أَو نَكيرِ",26,"ر",1,0],["أَو نَفاري عَليكَ مِن نَصَبِ الدَر","بِ بِحَسبِ الإِدلالِ وَالإيناسِ",27,"س",1,0],["أَو نورُ شَمسِ الدينِ قَد جَلّى الدُجى","لَمّا بَدا وَلَهُ القُلوبُ سَماءُ",28,"ا",2,0],["أو نفحَةٌ تعبقُ من روضةٍ","تُحيي من الصّبّ رَميمَ العظام",29,"م",1,0],["أوَ نُورُ الإِلهِ تُطْفِئُهُ الأَفْ","واهُ وَهْوَ الذي به يُسْتَضاءُ",30,"ا",2,0],["أَو نالَكَ القَومُ أَثَر","وَإِن رَأى خَيراً نَشَر",31,"ر",1,0],["أَو نَعسَةٌ تَنهَضُ في نَؤومِ","أَشجَعُ مِن ذي لُبَدٍ هَضيمِ",32,"م",1,0],["أَو ناشِطٌ يَتَبَغّى","في مُقفَرِ الأَرضِ عِربَه",33,"ب",2,0],["أَو نخوة كان فيها","للقاعدين اندفاع",34,"ع",1,0],["أَوْ نَعْجَةٌ مِنْ إِرَاخِ الرَّمْلِ أَخْذَلَهَا","عَنْ إِلْفِها وَاضِحُ الخَدَّيْنِ مَكْحُولُ",35,"ل",1,0],["أو ناشئاً حَدَثاً تُحَّكمُ مِثْلَهُ","صُلْعُ الرجالِ تَوارَثَ التحكيما",36,"م",2,0],["أو نِسْوةُ الزّنْجِ بِأَيْمانِها","للرّقْصِ قُضْبٌ ذَهَبِيّات",37,"ت",1,0],["أو نَزَلَتْ تَنْهَبُ في خُفْيَةٍ","تَخْتَارُ ما تَفْعَلُ أو تُلْهَمُ",38,"م",1,0],["أَوْ نَثَرْتَ الكَلاَمَ فَهْوَ مِنَ البَهْجَةِ","وَالفِطْنَةِ البَدِيعَةِ شِعْرُ",39,"ر",1,0],["أَوْ نَهرِهَا وَبِهِ مَوَارِدُ فِي","حِسٍّ وَفِي مَعْنىً لِوُرَّادِ",40,"د",1,0],["أو نفحةٌ من جميلٍ","طافتْ بأحلام بُثْنِ",41,"ن",1,0],["أو نازِلٌ بجَزِيرةٍ، أو سابحٌ","في البحر بين الرَّأسِ والشَّلاَل",42,"ل",1,0],["أوني خيام الحي من حيث طنبت","أليس ضمير الأرض ذاك المخيم",43,"م",1,0],["أو نقشتم فالنقش يجشمه الن","اس وفيه الإسقام والإبراء",44,"ا",2,0],["أو نداءاتُ حارسٍ وهو في الأشباح","لاحتْ لعينه مستريب",45,"ب",1,0],["أو نسمة أنا همسها وحفيفها","أبدا تطوّف في البرى وتدور",46,"ر",1,0],["أو نسمة أنا همسها وحفيفها","أبدا تطوّف في الذرى وتدور",47,"ر",1,0],["أو نلتقي عند الكثيب ، على رضى","وقناعة ، صفصافة وغدير",47,"ر",1,0],["أَو نَحُثُّ الركاب يَوماً لِمصر","وَكَفَتنا دِيارُهُ الأَمصارا",48,"ر",2,0],["أَو نُجيد المَديح لِلغَير سَهواً","وَنَرى في رِدائِهِ الأَخيارا",48,"ر",2,0],["أوْ ندىً لو فرقته بينَ أهلِ","الأرض لم تُلْفِ فيهمُ بُخَّالا",49,"ل",2,0],["أو ناحَ طيرٌ بالضحى","مِن فوق أغصانِ الشجرْ",50,"ر",1,0],["أو نخلة السوء يأوي البوم مذ يفعت","في رأسها وهي لا شيص ولا كثر",51,"ر",1,0],["أو نفاقا أو رياء","أو لأسباب تفيد",52,"د",1,0],["أو نائل يصلح اعماله","فربما قد ساء أعمالا",53,"ل",2,0],["أَو نور هدى بريك الشمس طالعة","في نقطة المَجدِ لا في نقطة الحمل",54,"ل",1,0],["أو نواح المحبّ في الطلل البالي","رأى الرسم بعد طول اغتراب",55,"ب",1,0],["أو نعيبا في حمى الأم","وات لا يطرب حيا",56,"ي",2,0],["أو نعيم عبت ليالي منه","خمر وصل يتيه بالقبلات",57,"ت",1,0],["آونة اضداد","وتارة أشباه",58,"ه",1,0],["او نسيم هبّ يسري سحرا","يبهج النفس يقر الأعينا",59,"ن",2,0],["أَو نبَّه الوَسنان في شَدوه","حيّ عَلى نَيل المُنى يا نِيام",60,"م",1,0],["أو ندىً من يَدَي أَبي الجَيشِ لا يُح","صَى بِوَزنٍ ولا 