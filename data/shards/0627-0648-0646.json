ء السكون غناءا",211,"ا",3,0],["أو نلتقي في خلد عدْنٍ بعد أن","ذقتُ الجحيمَ وكاحلي مكسورُ؟",212,"ر",1,0],["أوَ نمضي كغريبين كما؟","لم يكن للحبِ ذكرٌ بيننا",213,"ن",2,0],["أو نذبحه بالسلاح ونحط رأسه بالطيني","بعيار يحسم القول ويختصر الكلام",214,"م",1,0],["أون ونات ٍ ،، تهد ، التلالا","شقت مشاع الصدرمن شدّة التل",215,"ل",1,1],["أونّ من جرح ٍ بقلبي له نزيف","والدمع وسط العين زاد إغراقها",216,"ق",3,0],["أوْ نَجْمَةٌ أَفَلَتْ عَنها مَجَرَّتُها","تَبكي لِفُرْقَتِها فُلْكٌ وأنْوارُ",217,"ر",1,0],["أو نامَ سيفٌ ,هل نكونُ كمن بدا","نحوَ السماء موجهاً ذا الراس؟",218,"س",1,0],["أو نامَ قوم قد حملنا همهم","أو جار جرمٌ خلته كالماس!",218,"س",1,0],["آونات الزَمان بَعضاً وَكلا","قد رعت ذمة إليك وإلا",219,"ل",2,0],["أو نصفُ مساءٍ تتدلَّى","ساقاه مِنْ قمرٍ راسبْ",220,"ب",1,0],["أُونِسُ رِيحَ المَوْتِ في المكاسِرِ","... ... ... منْ أممٍ نهابرِ",221,"ر",1,1]]}