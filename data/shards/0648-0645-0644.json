[91,"تأملات","https://www.poetsgate.com/ViewPoem.aspx?id=53220",""],[2,"إنَّ الرزية َ، لا رزية َ مثلها،","https://www.poetsgate.com/ViewPoem.aspx?id=5317",""],[97,"في الظلام","https://www.poetsgate.com/ViewPoem.aspx?id=12763",""],[86,"أقضيه فى الأشواق إلا أقله","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69208&r=&rc=66",""],[91,"تأملات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67903&r=&rc=183",""],[3,"بَرْدُ نَسيم الحجاز في السَّحَرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10700&r=&rc=54",""]],"verses":[["وَمُلوكٌ قادوا الرُؤو","سَ مُطيعاً وَآبِيا",0,"ي",2,0],["وَمُلتَبِسٍ بِالرَكبِ بادَرتُ خَلفَهُ","أُلَوِّحُ بِالأَردانِ وَهُوَ يَراني",1,"ي",1,0],["وَمَلاعِبَ الإِنسِ الجَميعِ طَوى الرَدى","مِنهُم فَصِرتِ مَلاعِبَ الجِنّانِ",2,"ن",1,0],["وَمُلتَهِبِ السَردِ عاري الرِما","حِ مُرتَعِدِ البيضِ دامي الحَوامي",3,"م",2,0],["وَمُلَملِمٌ يَرمي العَدُوَّ بِرُكنِهِ","ماضٍ كَفِهرِ المِنجَنيقِ مُلَملِمُ",4,"م",1,0],["وَمُلوكٍ في ثَراهُم","ضَرَبَ المَجدُ عُروقَه",5,"ق",2,0],["وَمِلنا بِالجِيادِ عَلى وَجاها","وَقَد دَمِيَ الشَكائِمُ وَالعِذارُ",6,"ر",1,0],["وَمَلامُ أَيّامٍ وَلَيسَ لَها","عَطفٌ وَبَعضُ اللَومِ لا يُجدي",7,"ي",1,0],["وَمَلِكٍ إِنفنا أَن نُقيمَ بِبابِهِ","فَزَوَّدنا زادَ اِمرِىءٍ ما تَزَوَّدا",8,"د",2,0],["وَمُلّيتَ حَتّى تَسأَمَ العَيشَ مَلَّةً","فَلو خُلِّدَ الأَقوامُ كُنتَ المُخَلَّدا",9,"د",2,0],["وَمَلبونَةٍ في بُيوتِ الغُزِيِّ","يُقَدِّمُ إِغباقَها الحالِبُ",10,"ب",1,0],["وَمُلتَثِمٍ قالَ لي لَثمُهُ","عَذابُ الهَوى في الثَنايا العِذابِ",11,"ب",1,0],["وَمِلنا عَلى الأَكوارِ طَربى كَأَنَّما","رَأَينا العِراقَ أَو نَزَلنا قِبابَها",12,"ب",3,0],["وَمِلنا عَلى القورِ مِن نَقعِنا","بِأَوسَعَ مِنها وَأَعلى بِنا",13,"ا",1,0],["وَمَلاثِ مِرطِكِ إِنَّهُ قَسَمٌ","بَرٌّ يُخَصُّ بِمِثلِهِ المِرطُ",14,"ط",1,0],["وَملأتُ السَّمعَ مِنّي كَلِماً","يَحسُدُ القَلبُ عَلَيها الأُذُنا",15,"ن",2,0],["وَمَلَأْتُ مَسْحَبَ ذَيْلِها قُبَلاً","وَلَدَيَّ حَقُّ الزَّوْرِ مُفْتَرَضُ",16,"ض",1,0],["ومُلْتَحِفٍ بالأمْنِ مَنْ أنتَ جارُهُ","ولوْ كان آسادُ الشّرى منْ عُداتِهِ",17,"ت",2,0],["ومَلْعَبُ فِتيانٍ ومَبْرَكُ هَجْمَةٍ","ومَسْحَبُ أطْمارِ الإماءِ الحَواطِبِ",18,"ب",1,0],["ومَلْحَمةٍ دونَ الخِلافَةِ خُضْتَها","بعَزْمَةِ أبَّاءٍ على القِرْنِ كَرَّارِ",19,"ر",1,0],["ومُلتَهِباتٍ بالوَميضِ يُزيرُها","مَوارِدَ يهديها إلَيهنَّ خِرْصانُ",20,"ن",1,0],["وَمُلكُ كِسرى لا أَشتَهيهِ إِذ","ما غابَ وَجهُ الحَبيبِ عَن نَظَري",21,"ر",2,0],["وَمَلِلتِ سَيَّدَتي مُواصَلَتي","مِن قَبلِ أَن يَستَحكِمَ الوَصلُ",22,"ل",1,0],["وملأتَ أيْديها وقدْ كادَتْ علَى","حُكْمِ القَضاءِ تُشافِهُ التّفْليسا",23,"س",2,0],["ومُلْكُكَ منْصورٌ وحِزْبُكَ غالِبٌ","وسيْفُكَ آنافَ الضّلالَةِ جادِعُ",24,"ع",1,0],["وَمِلْ عَلَى أَثْلاَثِ الْبَانِ مُنْعَطِفاً","وَحَيّ سَلْعاً وَسَلْ عَنْ حَالِ مِسْكِينِ",25,"ن",1,0],["وَمُلْتَفِتٌ عَنْ حُذْوَتَيْنِ إِذَا هَوَى","أَوانْقَضَّ قُلْتَ الشُّهْبُ يَقْدُمُهَا الرَّجْمُ",26,"م",1,0],["وَمُلَفَّفِ فِي الْعَصْبِ أَعْرَتْ مَتْنَهُ","وَكَسَتْهُ حَاشِيَةَ الرِّدَاءِ الْمُعْلَمِ",27,"م",1,0],["ومُلْتَفِتٍ عنْ أزْرَقِ اللّحْظِ قدْ حَكى","بهِ العَلَقُ المُحْمَرُّ مُقْلَةَ أرْمَدِ",28,"د",1,0],["ومُلوكٍ تعبّدوا الدّهْرَ حتّى","أصْبَحَ الدّهْرُ وهْوَ عَبْدٌ صَريحُ",29,"ح",1,0],["وَمَلَأتُم جَوانِبَ النيلِ وَعداً","وَوَعيداً وَرَحمَةً وَعَذابا",30,"ب",2,0],["وَمَلَكتَ الزِمامَ وَاِحتَطتَ لِلغَي","بِ وَأَدرَكتَ بِالأَناةِ الطِلابا",30,"ب",2,0],["وَمَلَّ كِلانا مِن أَخيهِ وَهَكَذا","إِذا طالَ عَهدُ المَرءِ بِالشَيءِ مَلَّهُ",31,"ل",2,0],["وَمَلَكتَهُنَّ كَما مَلَك","تَ زِمامَ مِصرَ أَباً وَجَدّا",32,"د",2,0],["وَمَلَّت بَناتُ الشِعرِ مِنّا مَواقِفاً","بِسِقطِ اللِوى وَالرَقمَتَينِ وَلَعلَعِ",33,"ع",1,0],["وَمُلَبِّبٌ لِغَريمِهِ وَمُطالِبٌ","بِدَمٍ أُريقَ بِمَسبَحِ الحيتانِ",34,"ن",1,0],["وَمُلتَطِمُ الأَمواجِ جَونٌ كَأَنَّهُ","دُجى اللَيلِ نائي الشاطِئَينِ مَهولُ",35,"ل",1,0],["وَمُلتَمِسٍ مِنّي الشَكِيَّةَ غَرَّهُ","لِيانُ حَواشي شيمَتي وَجَمالُها",36,"ل",3,0],["وَمُلقَى الوَلايا مِن مِنىً حَيثُ حَلَّقَت","إيادٌ وَحَلَّت غامِدٌ وَعَتيبُ",37,"ب",1,0],["وَمِلْءَ الزَّمَانِ وَمِلْءَ المَكَا","نِ وَدُنْيَايَ أَجْمَعَ والاخِرَهْ",38,"ر",2,0],["وَمُلتَمِسٌ يا اِبنَ اِمرِئِ القَيسِ إِذ رَمَت","بِكَ الحَربُ جالَي صَعبَةِ المُتَرَجِّلِ",39,"ل",1,0],["وملتف زرع بالأسنة مزهرٍ","ولكن به المرّان تحلو مجانيها",40,"ي",3,0],["وملهباً في سهول الأرض ينهبها","نهباً ويخلط الهوباً بالهوب",41,"ب",1,0],["ومليكاً وَلّى عنهمُ كم سعَوا في","ه خميساً عرمرماً فخميسا",42,"س",2,0],["وَمِلَّةُ الزاعمينَ عيسى ابنِم اللّ","ه وما صَوَّروا وما صَلَبُوا",43,"ب",3,0],["وَمُلكي بَقايا ما وَهَبتُ مُفاضَةٌ","وَرُمحٌ وَسَيفٌ قاطِعٌ وَحِصانُ",44,"ن",1,0],["وَمَلَّكتُكَ النَفسَ النَفيسَةَ طائِعاً","وَتُبذَلُ لِلمَولى النُفوسُ النَفائِسُ",45,"س",1,0],["وَمِلنَ عَنِ الغُوَيرِ وَسِرنَ حَتّى","وَرَدنَ عُيونَ تَدمُرَ وَالجِبابا",46,"ب",2,0],["وَمِلنا بِالخُيولِ إِلى نُمَيرٍ","تُجاذِبُنا أَعِنَّتَها جِذابا",46,"ب",2,0],["ومليحٌ يقولُ حسنُ حلاهُ","اعملوا ما أردتمُ أهل بدر",47,"ر",1,0],["ومللت من بول الحيا","وقرفت من ريح العجوز",48,"ز",1,0],["وملولة الأخلاق لما أن رأت","أثر السقام بجسميَ المنهاض",49,"ض",1,1],["وملجأ العلم في أوطانه لفتىً","للجودِ والبأس فيه الشهد واللسع",50,"ع",1,0],["ومليكاً قد ماتَ بعد مليكٍ","بحماة يا حرّ قلبي لذاك",51,"ك",1,0],["ومليحٌ إذا نظرت إليه","نظرة خفَّفت أليم عذابك",52,"ك",1,1],["وملتقياً منِّي مدائح عوّدت","فرائدُها لقيا مقامك من قبل",53,"ل",1,0],["وملك صلاح دين الله يزهو","بأفضل فاضل فيه إقامهْ",54,"م",2,0],["ومليح يقول حسن حلاه","لي جبين بالشعر حف سناه",55,"ه",1,1],["وملول هويتهُ غير أنِّي","لا أراه من الملال ملولا",56,"ل",2,0],["ومليح إذا نظرت إليه","قلت أملك له الملاح رعايا",57,"ي",2,1],["وملوكُ الأنام قد أحوج اللَّ","هُ عُرا ملكها إلى الدَّهماءِ",58,"ا",2,0],["ومَلَّكْتُمُ لَيْثاً كُنوزاً مصونةً","بِبذْلٍ لأعراضٍ ومنْع مواعدِ",59,"د",1,0],["وملتُ نحو الذي يميلُ أخو ال","جهل إلى مثله ويختارُهُ",60,"ر",2,0],["ومليكُهُ لزواله","ماضي العزيمة غير مُقصرْ",61,"ر",1,0],["وملأت مشرقها ومغربها","عدلاً تغشَّى الناس أوسعه",62,"ع",2,0],["وملء دارِي وحقِّ سيدي ال","أكبر ذي المجد والعلا حُرَمُ",63,"م",1,0],["وَمُلَحَّبٍ خَضِلِ الثِيابِ كَأَنَّما","وَطِئَت عَلَيهِ بِخُفِّها العَيثومُ",64,"م",1,0],["وَمَلاحَةٍ في مَنطِقٍ مُتَرَخِّمٍ","مِنها وَحُسنِ تَقَتُّلٍ وَدَلالِ",65,"ل",1,0],["وَمَليحَةٍ لا هِندُ مِن أَسمائِها","كَلّا وَلَيسَت كَالحِسانِ الخُرَّدِ",66,"د",1,0],["وَمَلِكٍ أَسقَطتُ عَنهُ التاجا","وَساكِنٍ هَيَّجتُهُ فَهاجا",67,"ج",2,0],["وَمَليحَةٍ في وَجهِها أَلَقُ الضُحى","وَالسِحرُ وَالصَهباءُ في أَقوالِها",68,"ل",3,0],["وَمَلَأتُ عَقلي مِن حَديثِ شُيوخِها","وَأَخَذتُ شِعري مِن لَغى أَطفالِها",68,"ل",3,0],["وَمَلَأتُ مِن طيبِ الثَناءِ مَجامِراً","يُذكينَ بَينَ يَدَيكَ هَذا العَنبَرا",69,"ر",2,0],["وَمِلحَفَةٍ دَرسٍ وَجَردِ مُلاءَةٍ","إَذا أَنهَجَت مِن جانِبٍ لا تُكَفَّفُ",70,"ف",1,0],["ومللت البقاء فيها غريباً","تشتكي الداء والمريض ملول",71,"ل",1,0],["وملأته من حكمة وفكاهة","وجلوته مثل الرياض وأحسنا",72,"ن",2,0],["وملعب كمعاني الحلم لو صدقت","وكالأماني لولا أنها كذب",73,"ب",1,0],["وَمُلكُ الطَيرِ لَم تَحفِل","بِهِ كِبراً وَطُغيانا",74,"ن",2,0],["وَمَلاعِبٌ تُجري الحُظوظُ مَعَ الصِبا","في ظِلِّهِنَّ وَتوهَبُ الأَقسامُ",75,"م",1,0],["وَمُلكُكَ أَرقى بِالدَليلِ حُكومَةً","وَأَنفَذُ سَهماً في الأُمورِ وَأَصوَبُ",76,"ب",1,0],["وَمَلَكنا فَالمالِكونَ عَبيدٌ","وَالبَرايا بِأَسرِهِم أُسَراءُ",77,"ا",2,0],["وَمُلوكاً كَأَمسِ في القُربِ مِنّا","وَكَطَسمٍ وَأُختِها في البِعادِ",78,"د",1,0],["وَمَلِلتُ نَحرَ عِشارِها فَأَضافَني","مَن يَنحَرُ البِدَرَ النُضارَ لِمَن قَرى",79,"ر",2,0],["وَمَلمومَةٌ سَيفِيَّةٌ رَبَعِيَّةٌ","يَصيحُ الحَصى فيها صِياحَ اللَقالِقِ",80,"ق",1,0],["وَمَلمومَةٌ زَرَدٌ ثَوبُها","وَلَكِنَّهُ بِالقَنا مُخمَلُ",81,"ل",1,0],["وَمَلَّ القَنا مِمّا تَدُقُّ صُدورَهُ","وَمَلَّ حَديدُ الهِندِ مِمّا تُلاطِمُه",82,"م",2,0],["وَمَلَّنِيَ الفِراشُ وَكانَ جَنبي","يَمَلُّ لِقاءَهُ في كُلِّ عامِ",83,"م",1,0],["وَمَلِكٍ أَوطَأَها جَبينَهُ","يَقودُها مُسَهِّداً جُفونَهُ",84,"ن",2,0],["وَمَليحةٍ بكرتْ عليَّ مُليحةً","سَحَراً وقد صبغَ الخدودَ جفونُ",85,"ن",1,0],["وملكتُ مفتاحَ الكُنوزِ بفطنةٍ","كشَفتْ ليَ السرَّ الخفيَّ المُبْهَما",86,"م",2,0],["ومَليحة الحركاتِ إِنْ رفَلَتْ","في الحيّ شاغبَ عِقدَها القُرطُ",87,"ط",1,0],["ومَليحةِ الشكوى إليَّ مليحةٌ","من صرفِ أيام لهن دَبِيبُ",88,"ب",1,0],["وَمُلّيتَ عَبدَ اللَهِ مِن ذي تَطَوُّلٍ","كَريمِ السَجايا هِبرِزِيِّ الضَرائِبِ",89,"ب",1,0],["وَمُلَوَّمٍ في الحُبِّ قُلتُ وَأَرسَلَت","عَيناهُ واكِفَ أَدمُعٍ أَسرابِ",90,"ب",1,0],["وَمَلَأتَ أَحشاءَ العَدُوِّ بَلابِلاً","فَاِرتَدَّ يَحسُدُ فيكَ مَن لَم يَحسُدِ",91,"د",1,0],["وَمُلّيتَ عَيشاً مِن أَبي الفَتحِ إِنَّهُ","سَليلُ العُلا وَالسُؤدُدِ المُتَراقِدِ",92,"د",1,0],["وَمُلّيتَ عَبدَ اللَهِ إِنَّ سَماحَهُ","هُوَ القَطرُ في إِسبالِهِ وَأَخو القَطرِ",93,"ر",1,0],["وَمَلعونُ السِتارَةِ لَم يُخَلِّص","خَفيفُ المُخطِياتِ مِنَ الثَقيلِ",94,"ل",1,0],["وَمُلحَمَةٍ شَهِدتَ لِيَومَ بَأسٍ","تَزيدُ المَرءَ لِلأَجَلِ اِقتِرابا",95,"ب",2,0],["وَمَلمومَةٍ فيها الحَديدُ كَثيفَةٍ","إِذا ما اِرجَحَنَّت بِالمَنايا ظِلالُها",96,"ل",3,0],["وملكت عبدا لم ترم خطراته","عتقا ولم تعرف سبيل إباق",97,"ق",1,0],["ومُلحَدٌ ساخَ في أحشائِهِ عَلَمٌ","من المَكارمِ بل نارٌ على عَلَمِ",98,"م",1,0],["وملَكْتَ بالمِنَنِ الرِّقابَ وإنَّما","مِنَنُ المُلوكِ جَوامِعُ الأعناقِ",99,"ق",1,0],["وملوكَ كِنْدَةَ حَطَّ عن","تلك الأسِرَّةِ والقَراِبس",100,"س",1,0],["وملآنُ من عَبَراتِ الكُرومِ","كأنَّ على فَمِه عُصفُرا",101,"ر",2,0],["وملعَبُ إفرِنْدِيَّةِ الرَّوْضِ يَعْتَلي","عليه خَلوقيُّ البِناء المُشَيَّدِ",102,"د",1,0],["ومِلْتَ بهم من غيرِ فَضلٍ عليهمُ","إلى الوَرْدِ غضّاً والشَّرابِ مُورَّدا",103,"د",2,0],["ومُلِّكْتَ مَدحي كما مُلِّكَتْ","بنو هاشمٍ بُرْدَها والقَضيبا",104,"ب",2,0],["وَمُلجِمُنا ما إِن يَنالُ قَذالَهُ","وَلا قَدَماهُ الأَرضَ إِلّا أَنامِلُه",105,"ل",2,0],["وَمُلكُكِ فيهِمُ دُوَلٌ","بِها الأَقدارُ تَختَلِفُ",106,"ف",1,0],["وَمَلَكتُ قَودَ عِنانِ نَفسي بِالهُدى","وَطَوَيتُ عَن تَبَعِ الهَوى أَذيالي",107,"ل",2,0],["وَمَليحٍ لَهُ رَقيبٌ قَبيحٌ","يَتَعَنّى وَغَيرُهُ يَتَهَنّى",108,"ن",2,1],["وَمُلبِسي النَعَمَ اللاتي يُباعِدُني","عَنها الحَياءُ فَلا أَنفَكُّ مُنتَزِحا",109,"ح",2,0],["وملتُ برأسي كابياً أو مواسياً","وعندي من الأشجانِ والشوقِ ما عندي",110,"د",2,0],["وملحُكِ في دمي وشذاكِ باقٍ","وهذا الصوتُ أسمعُه دواما",111,"م",2,0],["وملوكٌ من حِمْيرٌ ملؤوا الأرْ","ضَ وكانتْ من حكمهم تحتَ خَتْمِ",112,"م",1,0],["وَمُلتَحِفٍ بِالصقلِ مِن لَمعِ بارقٍ","يُطيرُ فَرَاشَ الهام من حَدّه القرعُ",113,"ع",1,0],["وملتحفٌ بالأثْرِ أصبَحَ عارِياً","مِنَ الفَخرِ يَومَ الضّربِ إذ لبس الغِمدا",114,"د",2,0],["ومليح الدلّ إنْ علّ بها","قلتَ نجمٌ في فمِ البدر غرب",115,"ب",1,0],["وَمَلَّكتُماني صَعبَةً وَخِشاشَها","وَأَمكَنتُما مِن طامِحٍ وَعِنانِهِ",116,"ن",2,0],["وَمُلَحَّباً لاقى المَنِيَّةَ حاسِراً","وَالمَوتُ أَحمَرُ واقِفاً بِحِيالِهِ",117,"ل",2,0],["وَمَلآنَ مِن ضِغنٍ كَواهُ تَوَقُّلي","إِلى الهِمَّةِ العُليا سَناماً وَغارِبا",118,"ب",2,0],["وَمَلْمَسِ عِفَّةٍ قَدْ نِلْتُ مِنْهُ","بِأَيْدِي اللَّهْوِ مَا شَاءَ التَّمَنِّي",119,"ن",2,1],["ومليحٍ إذا النحاةُ رأَوْهُ","فضَّلوهُ على بديعِ الزمانِ",120,"ن",1,1],["وملحةُ فضلِكُمْ بعد اختتامِ","تقولُ أقولُ منْ بعدِ افتتاحِ",121,"ح",1,0],["وَمَلَأتُ بَينَ جَبينِهِ وَيَمينِهِ","جَفنَيَّ بِالأَنوارِ وَالأَنواءِ",122,"ا",2,0],["وَمِلتُ مَعَ الشَبابِ عَنِ التَصابي","وَكَيفَ بِهِ وَقَد طَلَعَت رَقيبا",123,"ب",2,0],["وَمَلَأتُ جَفني عَبرَةً وَلَرُبَّما","أَبكَيتُهُ فَجَرى دَماً مَوّارا",124,"ر",2,0],["وَمِل إِلى أَيكَةٍ بِلَيلٍ","يَهفو اِهتِزازاً بِها قُدامى",125,"م",2,0],["وَمِلتُ بِطَرفي عَن فَتاةٍ وَقَهوَةٍ","وَعَطَّلتُ سَمعي مِن مَلامِ اللَوائِمِ",126,"م",1,0],["وَمِلآنَ فاضرِب لي وَلا تَخلُفَّنني","لَدى شُعبَةِ الأصغاءِ إِن شِئتَ مَوعِدا",127,"د",2,0],["وَمَليكُها وَقَسيمُها عَن أَمرِهِ","يُعطى بِأَمرِكَ ما تَشاءُ وَيُمنَعُ",128,"ع",1,0],["وَمَلِكُ المُلوكِ أَعني جَعفَرا","كَفى بِهِ لِلفاخِرينَ مَفخَرا",129,"ر",2,0],["وَمَلِكُ الرومِ أَتى كِتابُهُ","بِزَلَّةٍ تَزِفُّهُ أَصحابُهُ",129,"ه",1,0],["وَمَليٌّ بِصَمتِهِ الحِلمِ إِن طا","رَت سَريعاً مِثلَ الفِراشِ الحُلومُ",130,"م",1,0],["وَمَليحٍ مُقَرطَقٍ","أَحوَرِ العَينِ أَكحَلِ",131,"ل",1,0],["وَمَلَكنا رِقَّ الإِمامَةِ ميرا","ثاً فَمَن ذا عَنّا بِفَخرٍ يَحيدُ",132,"د",1,0],["ومَلَّكَتْ يَداكَ اليُمْنَى مَلائكَةٌ","غُرٌّ كِرامٌ وَأَبطالٌ بَهَالِيلُ",133,"ل",1,0],["ومَلْكَكَ ما ضمّتْ عليه تهائمٌ","ومَلْكَكَ ما ضَمّتْ عليه نجود",134,"د",1,0],["وَمِل إِلى مَجلِسٍ عَلى شَرَفٍ","بِالكَرخِ بَينَ الحَديقِ مُعتَمَدِ",135,"د",1,0],["وَمُلِحَّةٍ في العَذلِ ذاتِ نَصيحَةٍ","تَرجو إِنابَةَ ذي مُجونٍ مارِقِ",136,"ق",1,1],["ومُلِحّةٍ بالعذلِ تحسبُ أنّني","للعذلِ أتركُ صُحبَةَ الشطّار",137,"ر",1,1],["ومُلحةٍ بالعذل ذات نصيحةٍ","ترجو إنابةَ ذي مجونٍ مارقِ",138,"ق",1,1],["وَمَلهىً بِكَ أَحياناً","خِلافَ السَمُرِ المُقمَر",139,"ر",1,0],["وَمِل الآنَ لا أَصبو تَناهَت لَجاجَتي","وَماتَ الهَوى وَاِنشَقَّ عَن هامَتي سُكري",140,"ي",1,0],["وَمَلَأتَ ثَوبَكَ إِن رَأَيتَ كَتيبَةً","في النَومِ أَلَّلَها الحَديدُ الموجَدُ",141,"د",1,0],["وَمَلعَبٍ لِجَوارٍ يَنتَقِدنَ بِهِ","وَكُلِّ مُنتَزَهٍ لِلَّهوِ مُنتَقَدُ",142,"د",1,0],["وَمَلِكٌ تَسجُدُ المُلوكُ لَهُ","موفٍ عَلى الناسِ يَرزِقُ العَرَبا",143,"ب",2,0],["وَمُلوكٍ إِن تَعَرَّضتُ لَهُم","عَرَّضوا ديني وَشيكاً لِلعَطَب",144,"ب",1,0],["وَمَلعَبِ النونِ يُرى بَطنُهُ","مِن ظَهرِهِ أَخضَرَ مُستَصعَبِ",145,"ب",1,0],["وَمُلكٌ كَالرِياحِ جَرَت قَبولٌ","فَلَم تَلبَث وَأَعقَبَت الدَبورُ",146,"ر",1,0],["وَمَلِلنا مِنهُ مَغدىً","وَمَبيتاً وَمَقيلا",147,"ل",2,0],["ومُلْتَثِمٍ بالغَلْفَقِ الجَعْدِ عَرّستْ","عليه فلم تَكْشِفْ خَفِيَّ لِثَامهِ",148,"م",2,0],["وَمِلنا إِلَينا بِالسَوالِفِ وَالحُلى","وَبِالقَولِ فيما يَشتَهي المَرِحُ الخالي",149,"ي",1,0],["وملكٍ أوطأها جبينه","يقوده مسهّداً جفونه",150,"ن",2,0],["وملأت سِفَرَ المجد من عَجَبِ","وخلقتَ أبطالاً من العَدَمِ",151,"م",1,0],["وملاحم الأبطالِ في فلوجه","قصص الكفاح غريبها وعجيبها",152,"ب",3,0],["ومِلْتُ إلى الأدْواحِ فانطلقتْ بها","صوادحُ طار الصمت عن وُكُناتِها",153,"ت",3,0],["ومَلكٍ بمدرج الأوغاد","من رائحٍ يلطمه وغاد",154,"د",1,0],["وَمَلكتُه بالكفِّ ملكةَ قادرٍ","فانصاعَ مؤتَمراً لحُكمِ أميرِه",155,"ر",2,0],["وَمُلكُ كِسرى لا أَشتَهيهِ إِذا","ما غابَ وَجهُ الحَبيبِ عَن نَظَري",156,"ر",2,0],["ومُلكُ سُليمَان بنِ داودَ زُلِّزلَت","وريدانَ قَد أَلحَقنَهُ بالصَّعائدِ",157,"د",1,0],["وَمِلاَكُ أَمْرِكُمُ التَّآخِي بَيْنَكُمْ","تَتَعَارَفُونَ مِنَ اسْمِهِ بِشِعَارِ",158,"ر",1,0],["وَمِلاَكُ شِيمَتنَا الوَفَاءُ فَإِنَّهُ","لِسَعَادَةِ الأَقْوَامِ خَيْرُ مِلاَكِ",159,"ك",1,0],["وَمَلأتُ السَّمَاءشَكْوَى غَرَامي","فَشَغَلْتُالأبْرَارَ عَنْ تَقْوَاهَا",160,"ا",3,0],["ومُلِّيتُمُ للحظِّ ركناً موطَّداً","يُملِّيكمُ للعزِّ ركناً مدالظا",161,"ظ",2,0],["وَمَلأْتِ بِالْعِلْمِ الْبِلادَ فَنُورُهُ","في كُلِّ مُنْعَطَفٍ وَبُهْرَةِ ساحِ",162,"ح",1,0],["وَمَلِيكُكُمْ مَثَلُ الشبابِ مُجّمَّلٌ","بِخلائِقٍ غُرِّ الْوُجُوهِ صِباحِ",162,"ح",1,0],["وَمَلِيكاً يَرْعَى الإِلَهَ وَيَخْشَا","هُ وَيُعْلي الإِيمَانَ والتَوْحِيدا",163,"د",2,0],["وملمومَةِ الأقطارِ حَشْو عَجاجِها","عِتاقُ المذاكي والوشيجُ المقوَّمُ",164,"م",1,0],["وملأت من بركاته","رحلي، وإنَ صِفرت يدي",165,"د",2,0],["وملكْنَ قلبَكَ، لا يَرَوْنَ فَكَاكَهُ","أرأيتَ مَمْلُوكَ الغواني يُشْتَري؟",166,"ر",2,0],["وملكك منصور وحزبك غالب","وسيفك أناف الضلالة جاذع",167,"ع",1,0],["وملَّكهم رقابَكم فآبٍ","تملَّكَها وذو خَورَ أطاعا",168,"ع",2,0],["ومُلْكُ الدَّهرِ أنتَ بما توفّي","من الألمِ الذبيحِ وما تُعيف",169,"ف",1,0],["ومَلامحٌ مشبوبة هي وحدَها","وكَفى ، دليلُ نجابةِ الأعراب",170,"ب",1,0],["وملكتَ لم تَقُدِ الرعيلَ وإنما","يُغنيك رأيُك أنْ يُقادَ رعيل",171,"ل",1,0],["وملاءَماً بيد المَنون جِراحَه","جُرح المُقيم عليكَ لا يلتام",172,"م",1,0],["وَمُلّيتَ عَيْشاً مِن أبي الفَتحِ، إنّهُ","سَليلُ العُلا، وَالسّؤدَدِ المُتَرَافِدِ",173,"د",1,0],["وملأت عقلي حديث شيوخها","وأخذت شعري من لغى أطفالها",174,"ل",3,0],["وملعنٍ، ذاقَ الهوانَ، مدفعٍ","راخيتَ عقدة َ كبلهِ، فانحلتِ",175,"ت",1,0],["وملتُ برأسي باكياً أو مواسياً","وعندي من الأشجان والشوقِ ما عندي",176,"د",2,0],["ومل كلانا من أخيه وهكذا","إذا طال عهد المرء بالشئ مله",177,"ل",2,0],["ومليحة في وجهها ألق الضحى","والسحر والصهباء",178,"ا",2,0],["ومِلْكُ كِسْرَى لا أَشتَهيه إذا","ما غابَ وجهُ الحبيبِ عن النظر",179,"ر",1,0]]}