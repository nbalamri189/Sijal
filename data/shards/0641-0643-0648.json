.poetsgate.com/ViewPoem.aspx?id=176738",""],[5111,"مَرَاكِبُ الرَّجَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=212131",""],[5186,"فتاة السترة استمعي لنصحي","https://www.poetsgate.com/ViewPoem.aspx?id=156502",""],[5189,"الحب نهرا","https://www.poetsgate.com/ViewPoem.aspx?id=213319",""],[5193,"من وحي العزّة","https://www.poetsgate.com/ViewPoem.aspx?id=213569",""],[5388,"قناديل الأحبة","https://www.poetsgate.com/ViewPoem.aspx?id=206919",""],[5563,"غيداء لعوب","https://www.poetsgate.com/ViewPoem.aspx?id=211741",""],[5667,"هند","https://www.poetsgate.com/ViewPoem.aspx?id=214871",""],[5667,"الطبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=214892",""],[5689,"أهبت فنلت من قلبي الجوابا","https://www.poetsgate.com/ViewPoem.aspx?id=143429",""],[5732,"الملحمة الزايدية","https://www.poetsgate.com/ViewPoem.aspx?id=177865",""],[5744,"عمان","https://www.poetsgate.com/ViewPoem.aspx?id=207274",""],[5776,"دفنوه حيا","https://www.poetsgate.com/ViewPoem.aspx?id=199402",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5830,"سَلامٌ لِعَيْنَيْنِ","https://www.poetsgate.com/ViewPoem.aspx?id=201123",""],[5853,"لفاتنتي","https://www.poetsgate.com/ViewPoem.aspx?id=175682",""],[5939,"حبيبتي تغارُ من نفسها!","https://www.poetsgate.com/ViewPoem.aspx?id=178581",""],[5939,"أحلى مُنجزاتِك","https://www.poetsgate.com/ViewPoem.aspx?id=185498",""],[5953,"ألا يا رجال الحق بالحق أبشروا","https://www.poetsgate.com/ViewPoem.aspx?id=93852",""],[5975,"لا تغيبي عن عيوني","https://www.poetsgate.com/ViewPoem.aspx?id=53265",""],[6142,"لم يكن همه بدنياه إلا","https://www.poetsgate.com/ViewPoem.aspx?id=155695",""],[242,"أتانا النظم يبهج كاللآلي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563811",""],[5519,"عطر الصّباح ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69279&r=&rc=12",""],[5190,"مضى سهم القضاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78299&r=&rc=12",""],[5190,"المفترق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78333&r=&rc=46",""],[6351,"صحراء انتظارٍ أنا.. وغيمة الموعد أنت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86048&r=&rc=8",""]],"verses":[["فَكونوا كَما أَنا في النائِبا","تِ آبى مَعَ القَدحِ إِلّا اِستِعارا",0,"ر",2,0],["فَكوني كَلَيلى الأَخيَليَّةِ في الهَوى","وَإِلّا كَلُبنى أَو كَعَفراءَ أَو جُملِ",1,"ل",1,0],["فَكونوا جَميعاً ما اِستَطَعتُم فَإِنَّهُ","سيَلبَسُكُم ثَوبٌ مِنَ اللَهِ واسِعُ",2,"ع",1,0],["فَكونوا لِلبِلادِ وَلا يَفُتكُم","مِنَ النُهُزاتِ وَالفُرَصِ اِغتِنامُ",3,"م",1,0],["فَكونوا رِجالاً عامِلينَ أَعِزَّةً","وَصونوا حِمى أَوطانِكُم وَتَحَرَّروا",4,"ر",3,0],["فَكُّوا قُيُوداً أُبْرِمَتْ أَسْبَابُهَا","وَعَلَى التَّقَادُمِ لَمْ تَكُنْ بِرِمَامِ",5,"م",1,0],["فَكونوا رِفاعِيِّينَ في الحُبِّ مَرَّةً","وَخوضوا لَظى نارٍ لِشَوقِيَ حَرّاءِ",6,"ا",2,0],["فُكُّوا الغضَنفَرَ من إسار غزالَةٍ","قيداه خَلْخَالٌ لها وسِوارُ",7,"ر",1,0],["فكوَتْ بالصدودِ قلبي وقالتْ","هاكَ طبي وآخرُ الطبِّ كيْ",8,"ي",1,0],["فكونوا في أماكنكم حُلولا","رُماةَ النَّبلِ رُدُّوا الخيلَ عنَّا",9,"ن",2,0],["فكونوا حصيداً خامدينَ أوِ ارعَوُوا","إلى مَلِكٍ في كفِّه الموتُ والنشر",10,"ر",1,0],["فَكوني حُرَّةً في حِفظِ عَيني","هَداكَ لِقِبلَةِ المَعروفِ هادِ",11,"د",1,0],["فَكوني كَما كُنّا لَكُم نَقضِ حاجَةً","وَلا تَسمَعي قَولَ العَدُوِّ المُكايِدِ",12,"د",1,0],["فَكَوارِبٌ وَزَوارِعٌ وَكَوافِرٌ","وَحَواصِدٌ وَجَوامِعٌ وَدَوائِسُ",13,"س",1,0],["فَكونوا جِياداً أُضمِرَت خَوفَ غارَةٍ","صَوائِمَ إِلّا مِن شَكيمٍ تَلوكُها",14,"ك",3,0],["فَكَونُكَ في هَذي الحَياةِ مُصيبَةٌ","يُعَزّيكَ عَنها أَن تَبُرَّ وَتُحسِنا",15,"ن",2,0],["فَكونا مَعَ الناسِ كَالبارِقينِ","تَعُمّانِ بِالنورِ أَو تَخفُوانِ",16,"ن",1,0],["فَكُونُوا حَصِيداً خَامِدِينَ أَوِ افْزَعُوا","إِلَى الْحَرْبِ حَتَّى يَدْفَعَ الضَّيْمَ دَافِعُ",17,"ع",1,0],["فُكُّوا العُقُولَ مِنَ التَّصْفِيدِ تَنْطَلِقُوا","وَمَا تُبَالُونَ أَقْدَاماً بِتَصْفِيدِ",18,"د",1,0],["فكُوني في سماحِكِ بالضحايا","كعهدكِ في سماحِكِ بالأضاحي",19,"ح",2,0],["فَكَونا كَيفَما شئتا وَدَوما","بَعزَكما عَلى مَرّ اللَيالي",20,"ل",2,0],["فَكَوّلَخٌ بُعدُهُ لَم يَستَطِعهُ","بِتَقرِيبٍ سِوَى الزَّعِلِ القَاني الظَّنَابِيبِ",21,"ب",1,0],["فكوّنت الأنام فكا","ن عن عدم ولم يكن",22,"ن",1,0],["فَكونوا يَهوداً واِعملوا باِعتقادهم","بِعيسى وإلّا فاِتبعوا الملّة الغرّا",23,"ر",2,0],["فَكَوثَرُهُ يُحيى الفَقيرَ وَكَوثَري","يُثيرُ حَياةً في جَمادِ الدَفاتِرِ",24,"ر",1,0],["فُكّوا أسيراً لكمُ مُوثقاً","عليه في حفظ الهوى موثق",25,"ق",1,0],["فَكَونُ مِثلي يَسيرُ عَن بَلَدٍ","عارٌ عَلى أَهلِ ذَلِكَ البَلَدِ",26,"د",1,0],["فَكَوْنُكَ مِنْ ذُرَى الأَحْبَابِ قَاضٍ","عَلَيْنَا فِي الإِخَاءِ بِالاِتِّصَالِ",27,"ل",1,0],["فكوني لنفسي في الضّلالِ دليلةً","وإن لم يكن هديٌ رضيتُ بسلوان",28,"ن",1,0],["فكوني كما في عهدها كنت إذ بدت","وفيها بساتين تموج بأزهار",29,"ر",1,0],["فَكونوا كَداعٍ كَرَّةً بَعدَ فَرَّةٍ","أَلا رُبَّ مَرءٍ فّرَّ ثُمَّتَ أَقبَلا",30,"ل",2,0],["فكونوا غمائمَ مبراقها","يُشام سناه ويستمطر",31,"ر",1,0],["فكؤوسُها تفترّ عن","دمِ قهوةٍ في صِبْغِ عندَمْ",32,"م",1,0],["فكونِي شَفيعي إِلَى ابْنِ الشَّفِيعِ","وكُونِي رَسُولِي إِلَى ابن الرَّسُولِ",33,"ل",1,0],["فُكُّوا القيود وأحيوها بحكمتكم","وجنبوها عباداتٍ لأوثان",34,"ن",1,0],["فكونوا لها كلما عُطّلتْ","حلىً منكم القُلبُ والأطوُقُ",35,"ق",1,0],["فكونوا كيفما شِئْتُمْ","فما أجْفو ولا أسْلو",36,"ل",2,0],["فكونوا لكلمتنا جامعين","لكيما يتم بها مقصدي",37,"د",2,0],["فَكُونَا تابِعَيْنِ لِكُلِّ نَصٍّ","صَحِيحٍ واشْرُدا عَنْ كُلِّ خَالِ",38,"ل",1,0],["فُكُّوا عقالَ بعيري.. إِنَّ بِي سَفَراً","إِلَيَّ.. ما جَفَّ في الأعماقِ مَنْبَعُهُ !",39,"ع",2,0],["فكَوْكَبٌ في مَشْرِقٍ","وليس يأْتي مَغْربَا",40,"ب",2,0],["فَكونوا كَجِسمٍ واحِدٍ أَن تَأَلَّمَت","لَهُ أَنمُلٌ تَلقى الجَميعَ تَأَلُّما",41,"م",2,0],["فكونك في الظهر من آدمٍ","بشؤمك أهبطه إذ عصا",42,"ص",2,0],["فكوا السلاسل والأغلال والتمسوا","بعد النجاة مثال الترك والعرب",43,"ب",1,0],["فكوا وثاقي أسر عنكم إلى أمد","أعيا النواشط في الأمصار والسفنا",44,"ن",2,0],["فَكَوْنُ ذا في نعيمِ رُوحٍ","بكَوْنِ ذا في أليم كَرْبِ",45,"ب",1,0],["فكوكب معتد داجاه نحس","وكوكب مجتد رجاه سعدُ",46,"د",1,0],["فكَوَّنه في الذَرّ نوراً مقدَّماً","يواريه من نورٍ حجابٌ مطنَّب",47,"ب",1,0],["فكؤوس السر دائرة","فعلى منهاجه استقم",48,"م",1,0],["فكوني عبداً فيك ذلي خالص","وسائر أطواري مقام فخاريا",49,"ي",2,0],["فكوني كزنبقةٍ واحفظي","بحسنِ الوفاءِ شذاكِ العَطِر",50,"ر",1,0],["فَكُونوا حَوْلَهُ صَوْناً وَرِدْءاً","فإنَّ الفَرْعَ تَكْنُفُهُ الغصون",51,"ن",1,0],["فكواكبُ الخضراء من آياتها","قمر يضيء بها ونجم يلمع",52,"ع",1,0],["فكوني على أعلى سحيقٍ بهضبةٍ","مُمنَّعةٍ لا تُستطاعُ قِلالُها",53,"ل",3,0],["فكُونوا سناناً في حَجْورٍ لعلَّها","تكون سِنانا للقبائل والعُشْرِ",54,"ر",1,0],["فكوننا من دليل العقلِ مأخذه","والعلمُ مأخذه من شرعه الزاهي",55,"ي",1,0],["فكونه ما رأيتُ فيه","أكمل من صورتي وكوني",56,"ن",2,0],["فَكَونِيَ مُلكاً لَهُ بَيَّنٌ","وَمُلكي لَهُ قَولُهُ هيتُ لَك",57,"ك",1,0],["فكوني كما شاءَ الغرام حبيبتي","وأنت حياتي ليس عنك ذهاب",58,"ب",1,0],["فكونوا كما كنتم اسود وسادتي","فإني على غير الحواسد حاجب",59,"ب",1,0],["فكؤوسه تبدي شعاع خُدوده","وَخدوده تبدي شعاع الأكؤس",60,"س",1,0],["فَكُونوا أُسُوداً في المَناتِخِ والدُّجَى","ولا تَسمَعُوا مِن قَولِ زَيدٍ ولا عَمروِ",61,"ر",2,0],["فَكُونوا جَميعاً باتحاد قُلوبكم","عَلى أَمرِكُم شَخصاً وَلا تَطلُبوا النَكرا",62,"ر",2,0],["فكونوا كيفما شئتم","فأهواكم بلوناها",63,"ا",3,0],["فكوني يا بنات الشعر أهلي","وأشياعي لدى البلوى وركني",64,"ن",2,0],["فكواكب السرطان أول منزل","وبطينها مثل الاثاف لقدرة",65,"ه",1,0],["فَكونوا لَهُ وَارعوا محل جواره","وَنسبته أكرم بِهَذا لَهُ ذخرا",66,"ر",2,0],["فكونوا كأهليكم أولي العلم انه","بدمياط قد شيدت بمجد منازله",67,"ل",2,0],["فكوكبُ النّحس عند الإبتداء أفلا","لكم توالت فُتوحاتُ مُفرّحةٌ",68,"ه",1,0],["فكونوا مثله شرفا وعلماً","فما يغني الحديث عن القديم",69,"م",1,0],["فَكونوا كَداعي كَرَّةٍ بَعدَ فَرَّةٍ","أَلا رُبَّ مَن قَد فَرَّ ثمّتَ أَقبَلا",70,"ل",2,0],["فكونه مفتياً شرط لساعتنا","افتى فافتن اقواماً بجهلهم",71,"م",1,0],["فكوني كما كان الرئيس قويّةً","ويكفيك من سعد ثناه المخلّدُ",72,"د",1,0],["فكونوا يداً إنّ الخطوب عسيرةٌ","وإنّ اِتّحاد القوم في الخطبِ أحكمُ",73,"م",1,0],["فكونوا يداً إنّ الخطوب عسيرة","وإنّ اتحادَ القوم في الخطب أنفعُ",74,"ع",1,0],["فَكوني أُولَئِكَ تَسقينَها","فِدىً لِأُولَئِكَ عَمي وَخالي",75,"ل",2,0],["فكّوا القيود وَأطلقوا فَمَشى","للغرب ليث الشرق يحتَكِمُ",76,"م",1,0],["فَكوني كَما شاءَ الوشاة وَصدّقي","زَخارفهم واصغي لِقَول المفنّد",77,"د",1,0],["فكوهاناً بها قصر منيف","سما وبمنطق الجوزا تمنطق",78,"ق",1,0],["فكونوا كما شئتم فإنا كما نشا","صحونا جميعاً وانجلى ذلك السكر",79,"ر",1,0],["فكونوا كجماع الثريا تكن لكم","على دونها الشعرى تلوح وتخفق",80,"ق",1,0],["فكوني كما شاء الكمال وحاذري","نقائص لم يعقبن قط سوى الثلب",81,"ب",1,0],["فكور نور الشمس حزناً لفقده","وأعولت الأملاك ندبا على الندب",82,"ب",1,0],["فكونوا كظني فيكم أنَّ لي بِكم","لَظَنَّاً جميلاً عَهْدُهُ متقادمُ",83,"م",1,0],["فكواكب الآداب تش","رق بعد اظلام الخسوف",84,"ف",1,0],["فكوا أسير رقاد عنه رقكم","فادى جفونكم المرضى بصحته",85,"ت",2,0],["فَكونوا لما كنتم فَلَستم بعابر","سَبيلا بليل خانه نور فرقد",86,"د",1,0],["فَكُونُوا رِجالاً وَاستَجِيشُوا بِشدَّةِ","فَقَد لاحَ لي زَفسٌ يَمِيلُ لنُصرَتي",87,"ي",1,0],["فَكِوّنُوا وحدةً منكم مؤيدةً","بكل مقتدر بالله معتصم",88,"م",1,0],["فكونوا لنا آل السُّويَديّ جُنّةً","بكم ندرأ الأخطار حيث تصادمُ",89,"م",1,0],["فكورت وانكدرت شمس الهنا","وأنجم الأفراح والتهاني",90,"ن",2,0],["فكوسها طاف عليها الشهد من","لذاتهم والسم فيها راسب",91,"ب",1,0],["فكونوا كما شئتم إذ لم تذكروا","بسالف عهدٍ بالجهار وبالخفا",92,"ف",2,0],["فكونوا لهم أعوان خير لنيله","بما خصكم مولاكم في الورى وعم",93,"م",1,0],["ف(كورونا) تجوس الكون رعباً","قطيع الموت في الأذهان ترعى",94,"ع",2,0],["فكوني له يا غاية الحب موطنا","وزوريه كفا بالوداد معطره",95,"ر",2,0],["فَكُونِي مَعِي كُلَّمَا","بَدَا كُلّ بابٍ كَمِينْ",96,"ن",1,0],["فكوني أنت منقذة","فهذا الحال يشجيني",97,"ن",2,0],["فكومة تحوم حول كومة","لتحفظ الحقوق في الجوار",98,"ر",1,0],["فكوَّرَ اليأسُ فيهِ شمسَ أُمنيتي","ورحتُ أشكو لنجمِ الليلِ مأساتي",99,"ت",2,0],["فكونوا سعاةً لجنيِ ثِمارٍ","فيَحْلو بُعادي بِقَطْفِ الوُعودِ",100,"د",1,0],["فكونوا على حملِ الأمانةِ أهلَها","وقوموا إلى جنْيِ الأماني الفرائدِ",101,"د",1,0],["فَكُوْنِيْ مِثْلَ مَنْ زَكَّىْ","وَمَنْ أَعْطَىْ، وَمَنْ و