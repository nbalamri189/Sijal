{"poems":[[53,"من الظلم أن نتعاطى الخمارا","https://www.aldiwan.net/poem30470.html","المتقارب"],[55,"يقولون لي واصل سواها لعلها","https://www.aldiwan.net/poem26186.html","الطويل"],[24,"رحلت إلى قومي لأدعو جلهم","https://www.aldiwan.net/poem21868.html","الطويل"],[86,"لقد نصل الدجى فمتى تنام","https://www.aldiwan.net/poem10686.html","الوافر"],[86,"أطل على الأكوان والخلق تنظر","https://www.aldiwan.net/poem10689.html","الطويل"],[93,"ألتاج تاج مملكين عظام","https://www.aldiwan.net/poem11386.html","الكامل"],[70,"إلى عدلكم أنهي حديثي وأنتهي","https://www.aldiwan.net/poem43042.html","الطويل"],[80,"بكرت تغازله الدمى الأبكار","https://www.aldiwan.net/poem31431.html","الكامل"],[69,"قلت يا هند طببيني بوصل","https://www.aldiwan.net/poem28187.html","الخفيف"],[105,"أدأبك أن تريد المستحيلا","https://www.aldiwan.net/poem44213.html","الوافر"],[75,"تقول بنو العباس هل فتحت مصر","https://www.aldiwan.net/poem69083.html","الطويل"],[50,"عبيدة أطلقي عني صفادي","https://www.aldiwan.net/poem63921.html","الوافر"],[50,"ألا من لصب عازب النوم ساهد","https://www.aldiwan.net/poem63940.html","الطويل"],[46,"جنت الغوارس واستقل أخو الغني","https://www.aldiwan.net/poem22806.html","الكامل"],[46,"كأن إبارا في المفارق خيطت","https://www.aldiwan.net/poem23068.html","الطويل"],[46,"لعمري لقد نام الفتى عن حمامه","https://www.aldiwan.net/poem23469.html","الطويل"],[46,"أواني هم فألقى أواني","https://www.aldiwan.net/poem23545.html","المتقارب"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42682","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54697","البسيط"],[90,"ذكرى وعد بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179206",""],[107,"أخوك البدر يا فلك المعالي","https://www.aldiwan.net/poem16289.html","الوافر"],[130,"يا أيها المرتدى أسنى الجلابيب","https://www.aldiwan.net/poem54882.html","البسيط"],[148,"أيا ذا الفضل والمنن","https://www.aldiwan.net/poem68497.html","مجزوء الرمل"],[187,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[221,"جثا الليل ملتفا ببرد السرائر","https://www.aldiwan.net/poem41614.html","الطويل"],[229,"لولا شذا من نشركم ينشق","https://www.aldiwan.net/poem44579.html","السريع"],[233,"ما لي أرضى والبحر معترض","https://www.aldiwan.net/poem32091.html","المنسرح"],[235,"أتانا النظم يبهج كاللآلي","https://www.aldiwan.net/poem18856.html","الوافر"],[268,"أطالعة زهراء من ليل أحزان","https://www.aldiwan.net/poem35673.html","الطويل"],[283,"مدينة شلف يا عتيقة آثار","https://www.aldiwan.net/poem39369.html","الطويل"],[404,"لقد علم الأقوام أن قد فررتمُ","https://www.aldiwan.net/poem639.html",""],[413,"أينكر معروفنا المنكر","https://www.aldiwan.net/poem54039.html","المتقارب"],[429,"مولاي أمرك قد تقدم","https://www.aldiwan.net/poem12729.html","مجزوء الكامل"],[436,"لعلك يا شمس عند الأصيل","https://www.aldiwan.net/poem34889.html","المتقارب"],[451,"لم يحصر الفن فن ذهن وانان","https://www.aldiwan.net/poem61805.html","البسيط"],[456,"دعاها معقلة بالعراق","https://www.aldiwan.net/poem56092.html","المتقارب"],[459,"زمان كله هجر","https://www.aldiwan.net/poem16093.html","الهزج"],[477,"ألا بالتعاضد فلنبتد","https://www.aldiwan.net/poem37579.html","المتقارب"],[527,"نظام يا ابن ودي أم لآلي","https://www.aldiwan.net/poem37270.html","الوافر"],[573,"لقد لقيت نصباً","https://www.aldiwan.net/poem2747.html","مجزوء الرجز"]],"verses":[["فَكونوا كَما أَنا في النائِبا","تِ آبى مَعَ القَدحِ إِلّا اِستِعارا",0,"ر",2,0],["فَكوني كَلَيلى الأَخيَليَّةِ في الهَوى","وَإِلّا كَلُبنى أَو كَعَفراءَ أَو جُملِ",1,"ل",1,0],["فَكونوا جَميعاً ما اِستَطَعتُم فَإِنَّهُ","سيَلبَسُكُم ثَوبٌ مِنَ اللَهِ واسِعُ",2,"ع",1,0],["فَكونوا لِلبِلادِ وَلا يَفُتكُم","مِنَ النُهُزاتِ وَالفُرَصِ اِغتِنامُ",3,"م",1,0],["فَكونوا رِجالاً عامِلينَ أَعِزَّةً","وَصونوا حِمى أَوطانِكُم وَتَحَرَّروا",4,"ر",3,0],["فَكُّوا قُيُوداً أُبْرِمَتْ أَسْبَابُهَا","وَعَلَى التَّقَادُمِ لَمْ تَكُنْ بِرِمَامِ",5,"م",1,0],["فَكونوا رِفاعِيِّينَ في الحُبِّ مَرَّةً","وَخوضوا لَظى نارٍ لِشَوقِيَ حَرّاءِ",6,"ا",2,0],["فُكُّوا الغضَنفَرَ من إسار غزالَةٍ","قيداه خَلْخَالٌ لها وسِوارُ",7,"ر",1,0],["فكوَتْ بالصدودِ قلبي وقالتْ","هاكَ طبي وآخرُ الطبِّ كيْ",8,"ي",1,0],["فكونوا في أماكنكم حُلولا","رُماةَ النَّبلِ رُدُّوا الخيلَ عنَّا",9,"ن",2,0],["فكونوا حصيداً خامدينَ أوِ ارعَوُوا","إلى مَلِكٍ في كفِّه الموتُ والنشر",10,"ر",1,0],["فَكوني حُرَّةً في حِفظِ عَيني","هَداكَ لِقِبلَةِ المَعروفِ هادِ",11,"د",1,0],["فَكوني كَما كُنّا لَكُم نَقضِ حاجَةً","وَلا تَسمَعي قَولَ العَدُوِّ المُكايِدِ",12,"د",1,0],["فَكَوارِبٌ وَزَوارِعٌ وَكَوافِرٌ","وَحَواصِدٌ وَجَوامِعٌ وَدَوائِسُ",13,"س",1,0],["فَكونوا جِياداً أُضمِرَت خَوفَ غارَةٍ","صَوائِمَ إِلّا مِن شَكيمٍ تَلوكُها",14,"ك",3,0],["فَكَونُكَ في هَذي الحَياةِ مُصيبَةٌ","يُعَزّيكَ عَنها أَن تَبُرَّ وَتُحسِنا",15,"ن",2,0],["فَكونا مَعَ الناسِ كَالبارِقينِ","تَعُمّانِ بِالنورِ أَو تَخفُوانِ",16,"ن",1,0],["فَكُونُوا حَصِيداً خَامِدِينَ أَوِ افْزَعُوا","إِلَى الْحَرْبِ حَتَّى يَدْفَعَ الضَّيْمَ دَافِعُ",17,"ع",1,0],["فُكُّوا العُقُولَ مِنَ التَّصْفِيدِ تَنْطَلِقُوا","وَمَا تُبَالُونَ أَقْدَاماً بِتَصْفِيدِ",18,"د",1,0],["فكُوني في سماحِكِ بالضحايا","كعهدكِ في سماحِكِ بالأضاحي",19,"ح",2,0],["فَكَونا كَيفَما شئتا وَدَوما","بَعزَكما عَلى مَرّ اللَيالي",20,"ي",1,0],["فَكَوّلَخٌ بُعدُهُ لَم يَستَطِعهُ","بِتَقرِيبٍ سِوَى الزَّعِلِ القَاني الظَّنَابِيبِ",21,"ب",1,0],["فكوّنت الأنام فكا","ن عن عدم ولم يكن",22,"ن",1,0],["فَكونوا يَهوداً واِعملوا باِعتقادهم","بِعيسى وإلّا فاِتبعوا الملّة الغرّا",23,"ر",2,0],["فَكَوثَرُهُ يُحيى الفَقيرَ وَكَوثَري","يُثيرُ حَياةً في جَمادِ الدَفاتِرِ",24,"ر",1,0],["فُكّوا أسيراً لكمُ مُوثقاً","عليه في حفظ الهوى موثق",25,"ق",1,0],["فَكَونُ مِثلي يَسيرُ عَن بَلَدٍ","عارٌ عَلى أَهلِ ذَلِكَ البَلَدِ",26,"د",1,0],["فَكَوْنُكَ مِنْ ذُرَى الأَحْبَابِ قَاضٍ","عَلَيْنَا فِي الإِخَاءِ بِالاِتِّصَالِ",27,"ل",1,0],["فكوني لنفسي في الضّلالِ دليلةً","وإن لم يكن هديٌ رضيتُ بسلوان",28,"ن",1,0],["فكوني كما في عهدها كنت إذ بدت","وفيها بساتين تموج بأزهار",29,"ر",1,0],["فَكونوا كَداعٍ كَرَّةً بَعدَ فَرَّةٍ","أَلا رُبَّ مَرءٍ فّرَّ ثُمَّتَ أَقبَلا",30,"ل",2,0],["فكونوا غمائمَ مبراقها","يُشام سناه ويستمطر",31,"ر",1,0],["فكؤوسُها تفترّ عن","دمِ قهوةٍ في صِبْغِ عندَمْ",32,"م",1,0],["فكونِي شَفيعي إِلَى ابْنِ الشَّفِيعِ","وكُونِي رَسُولِي إِلَى ابن الرَّسُولِ",33,"ل",1,0],["فُكُّوا القيود وأحيوها بحكمتكم","وجنبوها عباداتٍ لأوثان",34,"ن",1,0],["فكونوا لها كلما عُطّلتْ","حلىً منكم القُلبُ والأطوُقُ",35,"ق",1,0],["فكونوا كيفما شِئْتُمْ","فما أجْفو ولا أسْلو",36,"و",1,0],["فكونوا لكلمتنا جامعين","لكيما يتم بها مقصدي",37,"د",2,0],["فَكُونَا تابِعَيْنِ لِكُلِّ نَصٍّ","صَحِيحٍ واشْرُدا عَنْ كُلِّ خَالِ",38,"ل",1,0],["فكَوْكَبٌ في مَشْرِقٍ","وليس يأْتي مَغْربَا",39,"ب",2,0]]}