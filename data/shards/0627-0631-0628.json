يط"],[402,"قل لمن شره يهرول سعيا","https://www.aldiwan.net/poem49821.html","الخفيف"],[413,"لست أنسى الركب بنا","https://www.aldiwan.net/poem53897.html","الرمل"],[413,"ملكت فؤاد صبك في جمالك","https://www.aldiwan.net/poem54024.html","الوافر"],[413,"سكب الدمع لها فانسكبا","https://www.aldiwan.net/poem54052.html","الرمل"],[413,"هل تركتم غير الجوى لفؤادي","https://www.aldiwan.net/poem54177.html","الخفيف"],[426,"زارت فكان بأمر الله اسراها","https://www.aldiwan.net/poem41037.html","البسيط"],[426,"ورد الكتاب مصرحا ومسطرا","https://www.aldiwan.net/poem41038.html","الكامل"],[426,"ماست بلدن والأثيث تميم","https://www.aldiwan.net/poem41395.html","الكامل"],[426,"عج بالديار وحي ذاك المعهدا","https://www.aldiwan.net/poem41428.html","الكامل"],[429,"تيم قلبي أغيد","https://www.aldiwan.net/poem12484.html","مجزوء الرجز"],[429,"حمد السرى من كنت وجه صباحه","https://www.aldiwan.net/poem12584.html","الكامل"],[434,"خذ من قياد الدهر خير زمام","https://www.aldiwan.net/poem2495.html","الكامل"],[450,"ما آل برمك في ذرى بغداد","https://www.aldiwan.net/poem13714.html","الكامل"],[450,"تنفست نسمات السحر في السحر","https://www.aldiwan.net/poem13760.html","البسيط"],[450,"شكرا وحق لمن وعى أن يشكرا","https://www.aldiwan.net/poem13764.html","الكامل"],[450,"بينما نحن في حديث الخلاعات","https://www.aldiwan.net/poem13939.html","الخفيف"],[451,"أربعاء الرماد يا عيد أحزا","https://www.aldiwan.net/poem61392.html","الخفيف"],[456,"طاف عليه بالرقمتينِ","https://www.aldiwan.net/poem55834.html","مخلع البسيط"],[456,"تربعت بين العذيب فالنقا","https://www.aldiwan.net/poem56093.html","الرجز"],[456,"هل لقتيل على اللوى ثائر","https://www.aldiwan.net/poem56169.html","المنسرح"],[456,"بين النقا فثنية الحجر","https://www.aldiwan.net/poem56199.html","أحذ الكامل"],[466,"شرب صباح ولا ذراح","https://www.aldiwan.net/poem59589.html","مخلع البسيط"],[466,"صبح جبين وليل سالفة","https://www.aldiwan.net/poem59644.html","المنسرح"],[491,"خلف المدائح بعدك التأبين","https://www.aldiwan.net/poem67315.html","الكامل"],[493,"لئن أحرزك الداعي","https://www.aldiwan.net/poem10238.html","الهزج"],[536,"رتب العز وعز الرتب","https://www.aldiwan.net/poem47425.html","عموديه"],[536,"دام بقاؤك لنا","https://www.aldiwan.net/poem47918.html","عموديه"],[538,"اربع علينا قليلا أيها الحادي","https://www.aldiwan.net/poem56848.html","البسيط"],[544,"آذنت جارتي بوشك رحيل","https://www.aldiwan.net/poem1858.html","الخفيف"],[549,"لك ما تراماه لحاظ الناظر","https://www.aldiwan.net/poem47795.html","الكامل"],[551,"تعز فقد مات الهوى وانتهى الجهل","https://www.aldiwan.net/poem68388.html","الطويل"],[556,"يعلم الحق نفسه بالذي قد","https://www.aldiwan.net/poem34093.html","الخفيف"]],"verses":[["أرَبْعَ البَخيلَةِ ماذا دَهاكَ","وما للحِمى خاشِعاً مُسْتَكينا",0,"ن",2,0],["أَرَبَّت باِلأَكارِعِ وَهيَ تَبغي","رُعاةَ الشاءِ وَالضَأنَ القِهادا",1,"د",2,0],["إِربَع فَحَيِّ مَعارِفَ الأَطلالِ","بِالجَزعِ مِن حُرُصٍ فَهُنَّ بَوالِ",2,"ل",1,1],["أَرَبَّ بِعينِيَّ البُكا كُلَّ لَيلَةٍ","فَقَد كادَ مَجرى الدَمعِ عينَيَّ يَقرَحُ",3,"ح",1,0],["أربعة غرآء","رنانة صماء",4,"ا",2,0],["أربأ بولدك أن يزيد ألبهم","عن كاتب متوسط أو قاري",5,"ر",2,0],["أَربَع بِطوسٍ عَلى قَبرِ الزَكِيِّ بِها","إِن كُنتَ تَربَعُ مِن دينٍ عَلى وَطَرِ",6,"ر",1,0],["أَرَبَّت بِها الأَمطارُ حَتّى كَأَنَّها","كِتابُ زَبورٍ في مَهاريقَ مُعجَمِ",7,"م",1,0],["أَرَبَّت بِها الهَوجاءُ وَاِستَوفَضَت بِها","حَصى الرَملِ نَجرانِيَّةٌ حينَ تَجهَلُ",8,"ل",1,0],["أَرَبَّت عَلَيها كُلُّ هَوجاءَ رادَةٍ","زَجولٍ بِجَولانِ الحَصى حينَ تَسحَقُ",9,"ق",1,0],["أَربَّت بِها هَوجاءُ تَستَدرِجُ الحَصى","مُفَرَّقَةً تُذري التُرابَ جَموعُ",10,"ع",1,0],["أَرَبَّت عَلَيها كُلُّ هَوجاءَ رادَةٍ","شَمالٍ وَأَنفاسُ اليَمانِيَةِ الكُدرِ",11,"ر",1,0],["أربحوا هذا العشيّا","قد شفي وعوف مولاك",12,"ك",1,0],["أَرَبَّت بِعَينَيكَ الدُموعُ السَوافِحُ","فَلا العَهدُ مَنسِيٌّ وَلا الرَبعُ بارِحُ",13,"ح",1,1],["أَرَبَّت عَلَيهِ كُلُّ وَطفاءَ جَونَةٍ","هَتوفٍ مَتى يُنزِف لَها الوَبلُ تَسكُبِ",14,"ب",1,0],["أَربَعَةٌ مِنها أَنيسِيّانِ","وَطائِراً يُعرَفُ بِالبَيضاني",15,"ي",1,0],["أرْبَحْتَني منها نَصِيبَكَ مُحْسِناً","فربحتُ خيراً منكَ في الأرباحِ",16,"ح",1,0],["أرْبِح مُعَامِلَكَ التَّسَاهُلَ غالِياً","عَنْ أنْ تُعَدَّ مُعَامِلاً لَمْ يُرْبِحِ",17,"ح",1,0],["أربعةً جُدتَ لي بها سلفاً","إذ عقّني من ثِقاتيَ البررَهْ",18,"ر",2,0],["إربٌ يُكادُ العدى به وندىً","يقرن بين القلوب بالأُلَف",19,"ف",1,0],["أَرِبتُ لِإِربَتِهِ فَاِنطَلَق","تُ أُزجي لِحُبِّ الإيابِ السَنيحا",20,"ح",2,0],["إِربَع عَلى دِمَنٍ تَقادَمَ عَهدُها","بِالجَوفِ وَاِستَلَبَ الزَمانُ حِلالَها",21,"ل",3,0],["أَرَبَّت بِها شَهرَي رَبيعٍ عَلَيهِمُ","جَنائِبُ يَنتِجنَ الغَمامَ المَتالِيا",22,"ي",2,0],["أربَّ العيد هذا العيد يُجلَى","وكم لك من دعاء فيه يتلى",23,"ل",2,0],["أَربَعَةٌ تَجمَعُهُم هِمَّةٌ","يَنقُلُها الجيلُ إِلى عَقبِهِ",24,"ب",2,0],["أربعة من واحد فاتنبه","من وسن يا أيها الراقدُ",25,"د",1,0],["أَرَبُ النَفسِ كُلَّهُ وَمَتاعُ ال","عَينِ في خَدِّهِ وَفي تَوريدِه",26,"د",2,0],["أَرَبيعَةَ الفَرَسِ اِشكُري يَدَ مُنعِمٍ","وَهَبَ الإِساءَةَ لِلمُسيءِ الجاني",27,"ي",1,0],["أَرْبتْ على الفُرس في التيجانِ وانتَسَبت","للهندِ أكرِمْ بذاك الجيلِ من جِيلِ",28,"ل",1,0],["أَرَبَّ القَوافي الغُرِّ يُرقَى بمثلِها","لقد فَرَّ أفعَى يَنفُثُ السُّمَّ مُنقَعا",29,"ع",2,0],["أَرْبُعَاءٌ حُسامُه مشهورُ","حين يأتي وشرُّه مَحذورُ",30,"ر",1,1],["أَربَي أن أجلُبَ الحمدَ إلى","يَعرُبيّ الفخْرِ أو أُهدي المِدَح",31,"ح",1,0],["أَرَبَّت بِها الأَرواحُ كُلَّ عَشِيَّةٍ","فَلَم يَبقَ إِلّا آلُ خَيمٍ مُنَضَّدِ",32,"د",1,0],["أرَبّاه أنقذني فأنت رميتني","بقلب على الأشواك والدم مشاءِ",33,"ا",2,1],["أَرَبَيعَنا في تِسعَ عَشرَةَ حِجَّةً","حَقّاً لَهِنَّكَ لَلرَبيعُ الأَزهَرُ",34,"ر",1,0],["أَرِبتُ إِلى هِندٍ وَتِربَينِ مَرَّةً","لَها إِذ تَوافَقنا بِقَرنِ المُقَطَّعِ",35,"ع",1,1],["أَرّباً واحِداً أَم أَلفُ رَبٍّ","أَدينُ إِذا تَقَسَّمَت الأُمورُ",36,"ر",1,1],["أَرَبَّ المُدجِناتُ بِهِ وَجَرَّت","بِهِ الأَذيالَ مُعصِفَةٌ جَهولُ",37,"ل",1,0],["أرْبِحْ بِمَنْ أهْدَى إليه ثَنَاءَهُ","إنَّ الكريمَ لَرَابِحٌ مَرْبُوحُ",38,"ح",1,0],["أَرَبعَ البَلى إِنَّ الخُشوعَ لَبادِ","عَليكَ وَإِنّي لَم أَخُنكَ وِدادي",39,"ي",1,1],["اِربَع عَلى الطَلَلِ الَّذي اِنتَسَفَت","مِنهُ المَعالِمُ أَنجُمَ النَحسِ",40,"س",1,1],["أَربَعَةٌ يَحيا بِها","قَلبٌ وَروحٌ وَبَدَن",41,"ن",1,1],["أربعةٌ تعجب لحّاظَها","كرّةُ مَن يبصرها خاسره",42,"ر",2,1],["أَرَبَّت بِها الأَرواحُ حَتّى كَأَنَّما","تَهادَينَ أَعلى تُربِها بِالمَناخِلِ",43,"ل",1,0],["أَرَبَّت بِها نَآجَةٌ تَزدَهي الحَصى","وَأَسحَمُ وَكّافُ العَشِيِّ هَطولُ",44,"ل",1,0],["أَرَبَّت عَلَيهِ كُلُّ وَطفَاءَ جَونةٍ","وَأَسحَمَ هَطالٍ يَسُوقُ القَوارِيا",45,"ي",2,0],["أَربعة جُزِّئتْ لأَربعةٍ","أَجزاؤُها بالنُّفوس تَلْتحمُ",46,"م",1,0],["أرْبَت لَطافتُهُ على نَشْرِ الصَّبا","وأبَت تَرافَتُهُ التّقَمّصَ لاذا",47,"ذ",2,0],["أَرْبَعَةٌ في مَجْلِسٍ جُمِّعُوا","فطارَ هَذَانِ بهَذَينِ",48,"ن",1,0],["أَرَبَّةُ الْعُودِ أَمْ قُمْرِيَّةُ السَّحَرِ","غَنَّتْ فَحَرَّكَتِ الأَشْجَانَ بِالْوَتَرِ",49,"ر",1,1],["أَرْبَى عَلَى شِمْرَاخِ أَرْعَنَ بَاذِخٍ","سَامٍ لَهُ فَوْقَ السَّحَائِبِ طَاقُ",50,"ق",1,0],["إرْبَأْ بِنَفْسِكَ أَنْ تَكُونَ نَجِيبَا","وازْجُرْ خَلِيلَكَ أَنْ يَكُونَ أدِيبَا",51,"ب",2,1],["أَرْبَتْ مَفَاخِرُهَا بِعَدِّ","كَ فِي مُجِيدِيها الْعِظَامِ",52,"م",1,0],["أَرَبَّ المُدْجِنَاتِ به وجَرَّتْ","به الأذيال معصفة ٌ جفول",53,"ل",1,0],["إرْبَعْ فَحَيِّ مَعَارِفَ الأطْلاَلِ","بالجزع من حرُضٍ فهنَّ بوالِ",54,"ل",1,1],["أربَّ بعينيَّ البُكا كلَّ ليلة","ٍ وقد كادَ مجرى الدَّمعِ عيني يُقرِّحُ",55,"ح",1,0],["أرْبِحْ مُعَامِلَكَ التَّسَاهُلَ عَالِياً","عَنْ أنْ تُعَدَّ مُعَامِلاً لَمْ يُرْبِحِ",56,"ح",1,0],["أرْبَحْتَني منها نَصِيبَكَ مُحْسِناِ خفيف","فربحتُ خيراً منكَ في الأرباحِ",57,"ح",1,0],["أربّت بالأكارعِ وهي تبغي","رُعاة َ الشاءِ والضَّأْنَ القِهَادَ",58,"د",1,0],["أربحْ بمن أهدي إليه ثناؤه","إن الكريم لرابحٌ مربوحُ",59,"ح",1,0],["أَربوتنا حيتك عَنا السَحائبُ","فَأَنتَ لِوَجه الأَرض عَينٌ وَحاجِبُ",60,"ب",1,1],["أرَبَّةَ بَيتِى إِن ظَفِرتِ فَشَنفي","ولاَ تَسمَعِى مَن لاَمَ فِيهِ وعَنَّفَا",61,"ف",2,1],["أَربابُها شَفَقاً عَلَيها نَومُهُم","تَحليلُ مَوضِعها وَلَمّا يَهجَعوا",62,"ع",3,0],["أَربى عَلى باذِلِ الكومِ العِشارِ قِرىً","مَن جودُهُ النِعَمُ المُسناةُ لا النَعَمُ",63,"م",1,0],["أَربابُ أَردِيَةٍ لا ظُلمَ يَصحَبُها","يَوماً وَأَردِيَةٍ تُجلى بِها الظُلَمُ",63,"م",1,0],["أَرَبْعَ البِلى إِنِّي إِلَيْكَ لَشَاكِ","وَإِنِّي عَلَى وَجْدي عَلَيْكَ لَبَاكِ",64,"ك",1,1],["أَربَيتَ في لَومي وَزِدتَ وَلَن تَرى","قَلبي مُطيعَكَ في اِتِّراكِ هَوائِهِ",65,"ا",3,0],["أَرَبْعَ شبابي هلْ إليكَ رجوعُ","فللهَمِّ في قلبي عليك صدوعُ",66,"ع",1,1],["أَربعةً أربعةً مُزدوجَه","وهيَ الّتي فيها الأسامي مُدمَجه",67,"ه",1,0],["أربّ الرفيق الجزل ألف تحيّة","ومثلك من أعماق قلبي أحيّيه",68,"ي",2,0],["أرِبَت مودَّتُكم على الأيّامِ","فَتَرَ الإخاءُ لفترة الإسلامِ",69,"م",1,1],["أَرَبٌ يَبولُ الثُعلُبانُ بِرَأسِهِ","لَقَد هانَ مَن بالَت عَلَيهِ الثَعالِبُ",70,"ب",1,1],["أربّاه أنقذني فأنت رميتني","بقلب على عهد الأحباء بكاء",71,"ا",2,0],["أرباه لا تفعل فإني أرى الهوى","على وقده بالقلب أنفاس روحاء",71,"ا",2,0],["أَرْبَى تَنَاسُقُ نَظْمِهِ","بِكُمْ علَى الْعِقْدِ الْمُنَضَّدْ",72,"د",1,0],["أَرَبَّ الْخَلْقِ بِالْمُخْتَارِ أَسْبِلْ","عَلَيَّ مَوَاهِباً مِثْلَ الْعِهَادِ",73,"د",1,0],["أَرْبَى علَى نَهْرِ الأَبُلَّةِ بَهْجَةً","وَزَرَى بِرَوْضِ الْغُوطَةِ الْمَشْهُورِ",74,"ر",1,0],["أَرَبَّ عَلى مَغانيها مُلِثٌّ","هَزيمٌ وَدقُهُ حَتّى عَفاها",75,"ا",3,0],["أربعةٌ تقتضيك دين ال","سماع واللهو والعقار",76,"ر",1,0],["أربى على كلِّ السفينِ سفينُنا","واليومَ أصبَحنا بلا مِزلاج",77,"ج",1,0],["أرْبِحْ بِهِمْ صَفْقَةً لَم يَعْدُ مُؤْثِرُها","بِمَا اسْتَثَارَ مِنَ الهَيْجَاءِ خُسْرَانا",78,"ن",2,0],["أرْبَتْ طَواِئفُه على مَا قَبْلَها","والغُنْمُ في خَوْض الخطار خَطيرُ",79,"ر",1,0],["اِربَع خَلاكَ الذَمُّ في نِعمَةٍ","آهِلَةِ الرَبعِ بِوَفدِ التَّهان",80,"ن",1,0],["أَربَّ العُلى وَالمجدِ والبأس والندى","إِليكَ فَلَولا أَنتَ ما اِستغرق الوصفُ",81,"ف",1,0],["أَربَّ النَدى وَالفضل والمجد والحجا","وَناظمَ أَشتاتِ العُلى وَجِماعَها",82,"ع",3,0],["أَربيبَ حجر المكرُمات ورَبّها","وَرَضيعَ ثدي العارض المُتَعَنجرِ",83,"ر",1,0],["أَرَبَّةَ الخِدر ذاتَ الرَيط والخُمُرِ","إليكِ عنّي فما التَشبيبُ من وطري",84,"ر",2,1],["اربطْ عَلى كبدي وَش","دَّ عَلَى فؤادي الموجع",85,"ع",1,0],["أَرَبَّت عَلَيها ُلَّ هَوجاءَ 