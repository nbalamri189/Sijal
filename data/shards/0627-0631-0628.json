//poetry.dctabudhabi.ae/diwan/poem/42611","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42707","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54643","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55232","الكامل"],[22,"تعذّر بعد رامة َ من سليمى","https://www.poetsgate.com/ViewPoem.aspx?id=19803",""],[35,"إرْبَعْ فَحَيِّ مَعَارِفَ الأطْلاَلِ","https://www.poetsgate.com/ViewPoem.aspx?id=22143",""],[35,"أقولُ ونِضْوِي واقِفٌ عِنْدَ رَمْسِها","https://www.poetsgate.com/ViewPoem.aspx?id=21992",""],[51,"إنْ كنتَ ضِنّاً بي عَتبْتَ لأنَّني","https://www.poetsgate.com/ViewPoem.aspx?id=27364",""],[51,"يا لائمي في الرَّاح غيرَ مُقَصِّرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=27408",""],[24,"صَبَحْنا الحيَّ حَيَّ بني جِحاشٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10864&r=&rc=5",""],[67,"أمدائح لي فيكَ أم تسبيحُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13729&r=&rc=5",""]],"verses":[["أرَبْعَ البَخيلَةِ ماذا دَهاكَ","وما للحِمى خاشِعاً مُسْتَكينا",0,"ن",2,0],["أَرَبَّت باِلأَكارِعِ وَهيَ تَبغي","رُعاةَ الشاءِ وَالضَأنَ القِهادا",1,"د",2,0],["إِربَع فَحَيِّ مَعارِفَ الأَطلالِ","بِالجَزعِ مِن حُرُصٍ فَهُنَّ بَوالِ",2,"ل",1,1],["أَرَبَّ بِعينِيَّ البُكا كُلَّ لَيلَةٍ","فَقَد كادَ مَجرى الدَمعِ عينَيَّ يَقرَحُ",3,"ح",1,0],["أربعة غرآء","رنانة صماء",4,"ا",2,0],["أربأ بولدك أن يزيد ألبهم","عن كاتب متوسط أو قاري",5,"ر",2,0],["أَربَع بِطوسٍ عَلى قَبرِ الزَكِيِّ بِها","إِن كُنتَ تَربَعُ مِن دينٍ عَلى وَطَرِ",6,"ر",1,0],["أَرَبَّت بِها الأَمطارُ حَتّى كَأَنَّها","كِتابُ زَبورٍ في مَهاريقَ مُعجَمِ",7,"م",1,0],["أَرَبَّت بِها الهَوجاءُ وَاِستَوفَضَت بِها","حَصى الرَملِ نَجرانِيَّةٌ حينَ تَجهَلُ",8,"ل",1,0],["أَرَبَّت عَلَيها كُلُّ هَوجاءَ رادَةٍ","زَجولٍ بِجَولانِ الحَصى حينَ تَسحَقُ",9,"ق",1,0],["أَربَّت بِها هَوجاءُ تَستَدرِجُ الحَصى","مُفَرَّقَةً تُذري التُرابَ جَموعُ",10,"ع",1,0],["أَرَبَّت عَلَيها كُلُّ هَوجاءَ رادَةٍ","شَمالٍ وَأَنفاسُ اليَمانِيَةِ الكُدرِ",11,"ر",1,0],["أربحوا هذا العشيّا","قد شفي وعوف مولاك",12,"ك",1,0],["أَرَبَّت بِعَينَيكَ الدُموعُ السَوافِحُ","فَلا العَهدُ مَنسِيٌّ وَلا الرَبعُ بارِحُ",13,"ح",1,1],["أَرَبَّت عَلَيهِ كُلُّ وَطفاءَ جَونَةٍ","هَتوفٍ مَتى يُنزِف لَها الوَبلُ تَسكُبِ",14,"ب",1,0],["أَربَعَةٌ مِنها أَنيسِيّانِ","وَطائِراً يُعرَفُ بِالبَيضاني",15,"ي",1,0],["أرْبَحْتَني منها نَصِيبَكَ مُحْسِناً","فربحتُ خيراً منكَ في الأرباحِ",16,"ح",1,0],["أرْبِح مُعَامِلَكَ التَّسَاهُلَ غالِياً","عَنْ أنْ تُعَدَّ مُعَامِلاً لَمْ يُرْبِحِ",17,"ح",1,0],["أربعةً جُدتَ لي بها سلفاً","إذ عقّني من ثِقاتيَ البررَهْ",18,"ر",2,0],["إربٌ يُكادُ العدى به وندىً","يقرن بين القلوب بالأُلَف",19,"ف",1,0],["أَرِبتُ لِإِربَتِهِ فَاِنطَلَق","تُ أُزجي لِحُبِّ الإيابِ السَنيحا",20,"ح",2,0],["إِربَع عَلى دِمَنٍ تَقادَمَ عَهدُها","بِالجَوفِ وَاِستَلَبَ الزَمانُ حِلالَها",21,"ل",3,0],["أَرَبَّت بِها شَهرَي رَبيعٍ عَلَيهِمُ","جَنائِبُ يَنتِجنَ الغَمامَ المَتالِيا",22,"ي",2,0],["أربَّ العيد هذا العيد يُجلَى","وكم لك من دعاء فيه يتلى",23,"ل",2,0],["أَربَعَةٌ تَجمَعُهُم هِمَّةٌ","يَنقُلُها الجيلُ إِلى عَقبِهِ",24,"ب",2,0],["أربعة من واحد فاتنبه","من وسن يا أيها الراقدُ",25,"د",1,0],["أَرَبُ النَفسِ كُلَّهُ وَمَتاعُ ال","عَينِ في خَدِّهِ وَفي تَوريدِه",26,"د",2,0],["أَرَبيعَةَ الفَرَسِ اِشكُري يَدَ مُنعِمٍ","وَهَبَ الإِساءَةَ لِلمُسيءِ الجاني",27,"ي",1,0],["أَرْبتْ على الفُرس في التيجانِ وانتَسَبت","للهندِ أكرِمْ بذاك الجيلِ من جِيلِ",28,"ل",1,0],["أَرَبَّ القَوافي الغُرِّ يُرقَى بمثلِها","لقد فَرَّ أفعَى يَنفُثُ السُّمَّ مُنقَعا",29,"ع",2,0],["أَرْبُعَاءٌ حُسامُه مشهورُ","حين يأتي وشرُّه مَحذورُ",30,"ر",1,1],["أَربَي أن أجلُبَ الحمدَ إلى","يَعرُبيّ الفخْرِ أو أُهدي المِدَح",31,"ح",1,0],["أَرَبَّت بِها الأَرواحُ كُلَّ عَشِيَّةٍ","فَلَم يَبقَ إِلّا آلُ خَيمٍ مُنَضَّدِ",32,"د",1,0],["أرَبّاه أنقذني فأنت رميتني","بقلب على الأشواك والدم مشاءِ",33,"ا",2,1],["أَرَبَيعَنا في تِسعَ عَشرَةَ حِجَّةً","حَقّاً لَهِنَّكَ لَلرَبيعُ الأَزهَرُ",34,"ر",1,0],["أَرِبتُ إِلى هِندٍ وَتِربَينِ مَرَّةً","لَها إِذ تَوافَقنا بِقَرنِ المُقَطَّعِ",35,"ع",1,1],["أَرّباً واحِداً أَم أَلفُ رَبٍّ","أَدينُ إِذا تَقَسَّمَت الأُمورُ",36,"ر",1,1],["أَرَبَّ المُدجِناتُ بِهِ وَجَرَّت","بِهِ الأَذيالَ مُعصِفَةٌ جَهولُ",37,"ل",1,0],["أرْبِحْ بِمَنْ أهْدَى إليه ثَنَاءَهُ","إنَّ الكريمَ لَرَابِحٌ مَرْبُوحُ",38,"ح",1,0],["أَرَبعَ البَلى إِنَّ الخُشوعَ لَبادِ","عَليكَ وَإِنّي لَم أَخُنكَ وِدادي",39,"ي",1,1],["اِربَع عَلى الطَلَلِ الَّذي اِنتَسَفَت","مِنهُ المَعالِمُ أَنجُمَ النَحسِ",40,"س",1,1],["أَربَعَةٌ يَحيا بِها","قَلبٌ وَروحٌ وَبَدَن",41,"ن",1,1],["أربعةٌ تعجب لحّاظَها","كرّةُ مَن يبصرها خاسره",42,"ر",2,1],["أَرَبَّت بِها الأَرواحُ حَتّى كَأَنَّما","تَهادَينَ أَعلى تُربِها بِالمَناخِلِ",43,"ل",1,0],["أَرَبَّت بِها نَآجَةٌ تَزدَهي الحَصى","وَأَسحَمُ وَكّافُ العَشِيِّ هَطولُ",44,"ل",1,0],["أَرَبَّت عَلَيهِ كُلُّ وَطفَاءَ جَونةٍ","وَأَسحَمَ هَطالٍ يَسُوقُ القَوارِيا",45,"ي",2,0],["أَربعة جُزِّئتْ لأَربعةٍ","أَجزاؤُها بالنُّفوس تَلْتحمُ",46,"م",1,0],["أرْبَت لَطافتُهُ على نَشْرِ الصَّبا","وأبَت تَرافَتُهُ التّقَمّصَ لاذا",47,"ذ",2,0],["أَرْبَعَةٌ في مَجْلِسٍ جُمِّعُوا","فطارَ هَذَانِ بهَذَينِ",48,"ن",1,0],["أَرَبَّةُ الْعُودِ أَمْ قُمْرِيَّةُ السَّحَرِ","غَنَّتْ فَحَرَّكَتِ الأَشْجَانَ بِالْوَتَرِ",49,"ر",1,1],["أَرْبَى عَلَى شِمْرَاخِ أَرْعَنَ بَاذِخٍ","سَامٍ لَهُ فَوْقَ السَّحَائِبِ طَاقُ",50,"ق",1,0],["إرْبَأْ بِنَفْسِكَ أَنْ تَكُونَ نَجِيبَا","وازْجُرْ خَلِيلَكَ أَنْ يَكُونَ أدِيبَا",51,"ب",2,1],["أَرْبَتْ مَفَاخِرُهَا بِعَدِّ","كَ فِي مُجِيدِيها الْعِظَامِ",52,"م",1,0],["أَرَبَّ المُدْجِنَاتِ به وجَرَّتْ","به الأذيال معصفة ٌ جفول",53,"ل",1,0],["إرْبَعْ فَحَيِّ مَعَارِفَ الأطْلاَلِ","بالجزع من حرُضٍ فهنَّ بوالِ",54,"ل",1,1],["أربَّ بعينيَّ البُكا كلَّ ليلة","ٍ وقد كادَ مجرى الدَّمعِ عيني يُقرِّحُ",55,"ح",1,0],["أرْبِحْ مُعَامِلَكَ التَّسَاهُلَ عَالِياً","عَنْ أنْ تُعَدَّ مُعَامِلاً لَمْ يُرْبِحِ",56,"ح",1,0],["أرْبَحْتَني منها نَصِيبَكَ مُحْسِناِ خفيف","فربحتُ خيراً منكَ في الأرباحِ",57,"ح",1,0],["أربّت بالأكارعِ وهي تبغي","رُعاة َ الشاءِ والضَّأْنَ القِهَادَ",58,"د",1,0],["أربحْ بمن أهدي إليه ثناؤه","إن الكريم لرابحٌ مربوحُ",59,"ح",1,0]]}