{"poems":[[55,"إذا رابني الأقوام بعد ودادة","https://www.aldiwan.net/poem29849.html","الطويل"],[53,"تلق نصيحتي يا ابن الوزير","https://www.aldiwan.net/poem62978.html","الوافر"],[31,"ألا يا اسقياني وانفيا عنكما القذى","https://www.aldiwan.net/poem6082.html","الكامل"],[30,"أوصي تميماً إن قضاعة ساقها","https://www.aldiwan.net/poem1237.html",""],[30,"هذا الذي تعرف البطحاء وطأته","https://www.aldiwan.net/poem5493.html","البسيط"],[35,"أيا ويح من أمسى يخلس عقله","https://www.aldiwan.net/poem25988.html","الطويل"],[48,"إليك تناهى كل فخر وسؤدد","https://www.aldiwan.net/poem23640.html","الطويل"],[92,"العلم والوطنية","https://www.poetsgate.com/ViewPoem.aspx?id=178949",""],[113,"يا حبذا شادن في ثغره ضرب","https://www.aldiwan.net/poem16399.html","البسيط"],[124,"ما أنس لا أنس أياما نعمت بها","https://www.aldiwan.net/poem49318.html","البسيط"],[125,"ألا عم صباحاً أيها الربع منعما","https://www.aldiwan.net/poem23818.html","الطويل"],[125,"بالبحر قيلولة والشوق أختنق","https://www.aldiwan.net/poem23821.html","البسيط"],[159,"لها حكم لقمان وصورة يوسف","https://www.aldiwan.net/poem55476.html","الطويل"],[208,"بدت لوداع والتجمل سترها","https://www.aldiwan.net/poem53273.html","الطويل"],[287,"أدار ليلا قمر شمس راح","https://www.aldiwan.net/poem32831.html","السريع"],[308,"ما رمت منه القرب إلا أتي","https://www.aldiwan.net/poem57977.html","السريع"],[353,"أبا العباس تاج الدين أحمد","https://www.aldiwan.net/poem20104.html","الوافر"],[398,"لقد رحلت سعدى فهل لك مسعد","https://www.aldiwan.net/poem53688.html","الطويل"],[411,"ظفر بن عبد الله أكرم","https://www.aldiwan.net/poem49852.html","مجزوء الكامل"],[438,"تولى سقي دارهم الولي","https://www.aldiwan.net/poem12770.html","الوافر"],[471,"يا ثور لا تشتمن عرضي فداك أبي","https://www.aldiwan.net/poem50422.html","البسيط"],[556,"ما كان يومك يا أبا إسحاق","https://www.aldiwan.net/poem47355.html","الكامل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70933","الطويل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138103",""],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104983","البسيط"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58257","المجتث"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100831","الكامل"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216559",""],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74060","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73229","الرجز"],[4359,"","https://poetry.dctabudhabi.ae/diwan/poem/141137","البسيط"],[4727,"لقد آضنا","https://www.poetsgate.com/ViewPoem.aspx?id=210781",""],[592,"تجانف هذا المارق الماذق الأشقى","https://www.poetsgate.com/ViewPoem.aspx?id=128797",""],[5956,"تعالوا","https://www.poetsgate.com/ViewPoem.aspx?id=195019",""],[6093,"لعلَّهُ لا يعدُّ لنا هروبا","https://www.poetsgate.com/ViewPoem.aspx?id=176250",""],[6174,"الشِّعر في عُرس النجومِ الخُضر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86185&r=&rc=2",""],[6175,"يقولون لو يهوى لسالت دموعه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72835&r=&rc=60",""]],"verses":[["وَلَيسَ قُبوعُ الصِلِّ مانِعَ وَثبِهِ","إِذا نالَ مِنهُ والِغٌ بِمَنالِ",0,"ل",1,0],["وليس قرىً بأضعف من تجافٍ","يكون عن المسيء من القدير",1,"ر",1,0],["وَلَيسَ قَذاها بِالَّذي لا يَريبُها","وَلا بِالذُبابِ نَزعُهُ أَيسَرُ الأَمرِ",2,"ر",1,0],["وَلَيسَ قُضاعِيٌّ لَدَينا بِخائِفٍ","وَإِن أَصبَحَت تَغلي القُدورُ مِنَ الحَربِ",3,"ب",1,0],["وَلَيسَ قَولُكَ مَن هَذا بِضائِرِهِ","العُربُ تَعرِفُ مَن أَنكَرتَ وَالعَجَمُ",4,"م",1,0],["وَلي سَقَطاتٌ حينَ أُغفِلُ ذِكرَها","يَغوصُ عَلَيها مَن أَرادَ تَعَقُّبي",5,"ب",2,0],["وليس قَضيبُ الهِندِ إلاّ كنابِتٍ","من القَضْبِ في كفّ الهِدانِ المُعرِّدِ",6,"د",1,0],["وليسق حبّيك العراق ليشتفي","منه الغليل ويرتوي الظمآن",7,"ن",1,0],["وَلَيسَ قَصدي سِوى أَني أَقبل أَع","تاب الدِيار وَلا لي غَيرَهُ أَرَب",8,"ب",1,0],["وليس قدماً ولا غراً فاخدعه","لكن نصيباه من فهم ومن خجل",9,"ل",1,0],["وليس قشيباً ذا وليس بسابيء","له إنه إرث الأوائل أنجما",10,"م",2,0],["وليس قلبي في الأنام معتشقا","لغيرها غير من لله يعتشقُ",11,"ق",1,0],["وَلِي سُقْمُ أَيُّوبٍ وَغُرْبَةُ يُونُسٍ","وَأَحْزَانُ يَعْقُوبٍ وَوَحْشَةُ آدَمِ",12,"م",1,0],["وليس قبيحاً سكرة اللهو بالفتى","ولا سيَّما والظَّرف والشَّكل خمرُها",13,"ر",3,0],["وَلَيسَ قَولي بِفَسادٍ وَلا","نَقصٍ فَخُذ في الجِدِّ لا في المِزاح",14,"ح",1,0],["وليس قصدي غير أجفانه","يا من رأى الأسهم عادت غرض",15,"ض",1,0],["وَلَيْسَ قَليلُهُ عِندِي قَلِيلاً","وَإعْطاءُ القَلِيلِ فَما تَعَوَّدْ",16,"د",1,0],["وَلَيسَ قَديماً سابِقاً غَيرُ ذاتِهِ","وَان كانَ أَبناءُ الضَلال تَبَلَّدوا",17,"د",3,0],["ولْيُسْقَ غَرسُ وفائهِ","وصَفائهِ سَقْيَ الظِّرافِ",18,"ف",1,0],["ولي سُقْمٌ عليكَ ومنك بُرْءٌ","وبي ظمأٌ إليك وفيك رِيُّ",19,"ي",1,0],["وَلَيسَ قُربُكُمُ شاءٌ وَلا لَبَنُ","أَيَرجِعُ الضَيفُ عَنكُم غَيرَ مَحبورِ",20,"ر",1,0],["ولْيسقِ قبرَك كلُّ مُنخرقِ الكُلى","مِرعادُ كلّ عشيّةٍ مِبْراقِ",21,"ق",1,0],["وليس قالوا بعده من قائم","وابتعوا كل غويّ ظالم",22,"م",1,0],["وليس قياماً قبل إشباع ضيفه","فذلكمُ عيب مع الشِّيب والصبى",23,"ب",2,0],["وليس قلبي صخرا لا شعور له","لكن أفراحه قيدن في رَسَنِ",24,"ن",1,0],["وليس قبح مع بديع يستوي","فإن الإيطا عندهم كما روي",25,"ي",1,0],["وليس قصدهمو صلحاً كما زعموا","لكنهم قدَّروا أمراً وما قدروا",26,"ر",3,0],["وَليس قصدُكَ إلا","قتلي أسىً والسّلام",27,"م",1,0],["وليسقط الغاوي فعند سقوطه","يدري بما اقترفت يداه ويعلم",28,"م",1,0],["ولَي سقانا الحب بالكاسِ","ليته يَسْقيكم ولو رشْفَه",29,"ف",2,0],["وَلَيسَ قائدنا الأَعلى بِمُنتَصِر","لَولا تعاون قوّاد وأَجنادِ",30,"د",1,0],["وليس قصدي ابداً","في الحُبِّ إلا يُوسُفا",31,"ف",2,0],["وليس قوم يكون فيهم","معلن فسق بلا ارتهاب",32,"ب",1,1],["وليس قنوع المرء ذنبا وإنما","سكوتك عن ظلم الملوكِ موانِعُ",33,"ع",1,0],["وليس قناة الدين إلاَّ ثقيفة","معدلة فيما لديناولن تلقى",34,"ق",2,0],["وليس قَوامُ تفكيري وفعلي","سوى نصر السُّمُوِّ على الدَّنِيَّةْ",35,"ي",2,0],["وليس قلىً لأصحابٍ كرامٍ","ولكنِّي أفضلُ أن أغيبا",36,"ب",2,0],["وَلْيَسْقُطِ الشِّعْرِ مِنْ أَعْلَى مَنَابِرِه ...","يَوْمَ المَنَابِرُ كَفٌّ سَيْفُهَا خَشَبُ",37,"ب",1,0],["وليس قليلاً أن يَضُمَّكِ خافقي","ولكنّني صَبري عليكِ قليلُ!",38,"ل",1,0]]}