m47353.html","الكامل"],[551,"قد زرت ليلة هومنا على العيس","https://www.aldiwan.net/poem47744.html","البسيط"],[551,"ما زرت إلا خداعا أيها الساري","https://www.aldiwan.net/poem47781.html","البسيط"],[551,"قل للذي يحسدنا في الهوى","https://www.aldiwan.net/poem47832.html","السريع"],[559,"يا صاح هل هذه شموس","https://www.aldiwan.net/poem69353.html","مخلع البسيط"],[562,"اليوم لاح لنا في الحي شمسان","https://www.aldiwan.net/poem52711.html","البسيط"],[562,"يا أيها السفح ماذا يصنع البان","https://www.aldiwan.net/poem52853.html","البسيط"],[562,"لو كان للدار نطق سبحت عجبا","https://www.aldiwan.net/poem52855.html","البسيط"],[562,"كادت تذوب ثغور البحر من حسد","https://www.aldiwan.net/poem52927.html","البسيط"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"قد زارني نصف ليلي","https://www.aldiwan.net/poem2713.html","المجتث"],[575,"لو كان سقم حبيب القلب في بدني","https://www.aldiwan.net/poem2990.html","البسيط"],[575,"ليل وصل منيرة أقماره","https://www.aldiwan.net/poem3059.html","الخفيف"],[586,"يا فاضح البدر حسنا","https://www.aldiwan.net/poem17439.html","المجتث"],[587,"معالي الأمور الساميات المعالم","https://www.aldiwan.net/poem11520.html","عموديه"]],"verses":[["قَد زادَهُ اللَهُ عَلى عُظمِ الخَطَر","مَكارِماً ذاتَ حُجولٍ وَغُرَر",0,"ر",1,0],["قَد زَيَّلَت عَظيمَةٌ فَشَمِّري","وَاِرضي بِما جَرَّ القَضاءُ وَاِصبِري",1,"ي",1,1],["قَد زَيَّنَ اللَهُ في عَينَيَّ ما صَنَعت","حَتّى أَرى حَسَناً ما لَيسَ بِالحَسَنِ",2,"ن",1,0],["قَد زارَني طَيفَكُم لَيلاً فَأَرَّقَني","فَبُتُّ لِلشَوقِ أُذري الدَمعَ تَهتانا",3,"ن",2,0],["قد زرت قبرك يا أبا الشرف","فنثرت ذر الدمع من أسف",4,"ف",1,1],["قَدْ زَيَّنَ الدُّنْيَا بِنُورِ جَمَالِهِ","فَلِذّاكَ مَا يُدْعَى أَبَا زِيَّانِ",5,"ن",1,0],["قدْ زُرْتُ قَبْرَكَ عنْ طَوْعٍ بأغْماتِ","رأيْتُ ذلِكَ منْ أوْلَى المُهِمّاتِ",6,"ت",1,1],["قَد زَيَّنَ العِلمَ بِأَخلاقِهِ","فَعاشَ مِلءَ العَينِ وَالمَسمَعِ",7,"ع",1,0],["قَد زَعزَعَتهُ يَدُ القَضا","ءِ وَزَلزَلَتهُ يَدُ القَدَر",8,"ر",1,0],["قَد زُرتُ مُتحَفَ مِصرٍ","في ظُهرِ يَومِ الخَميسِ",9,"س",1,0],["قَد زارَني مِن بَني الأَتراكِ مُختَفِياً","ظَبيٌ عَلى غَيرِ ميعادٍ لَهُ سَلَفا",10,"ف",2,1],["قد زارك العيد السعيد مبشْراً","فاسمح لألف منهم بمزارِ",11,"ر",1,0],["قد زان قصريَ سعدٌ","بسعده المتوالي",12,"ي",1,0],["قد زاغت الأبصار فيما ترى","إذ فات عنها سرّك المودع",13,"ع",1,0],["قَد زَوَّجوهُم فَهُم فيهِم وَناسِبُهُم","إِلى حَنيفَةَ يَدعو ثُلثَ باقيها",14,"ي",3,0],["قد زمجرَ الرعدُ بآفاقهِ","كأنَّه ممَّا دهاه صرَخ",15,"خ",1,0],["قد زُفّت الشمس إلى البدرِ","يا لك من قَدر ومن قَدْرِ",16,"ر",1,1],["قد زاد في شكوى إِطِّراحُك إي","يايَ وما كان ذاك من سُننِك",17,"ك",1,0],["قَد زارَني مَن لا أُحِبُّ","وَأَنتِ أَولى مَن تَزوري",18,"ر",2,0],["قَد زَلَّ مَن كانَ المُعي","نَ لِوَجدِهِ الدَمعُ المَعينُ",19,"ن",1,0],["قَد زارَنا النَرجِسُ الذَكيُّ","وَآنَ مِن يَومِنا العَشيُّ",20,"ي",1,1],["قد زرت قبرك الذي","ترابه قد شملك",21,"ك",1,0],["قَد زِدتَها هَرَماً يُحَجُّ فِناؤُهُ","وَيُشَدُّ لِلدُنيا إِلَيهِ حِزامُ",22,"م",1,0],["قَد زادَني إِقبالُكُم وَقُبولُكُم","شَرَفاً عَلى الشَرَفِ الَّذي أَولَيتُهُ",23,"ت",2,0],["قَد زُرتُهُ وَسُيوفُ الهِندِ مُغمَدَتٌ","وَقَد نَظَرتُ إِلَيهِ وَالسُيوفُ دَمُ",24,"م",1,0],["قد زُرْتُهُ وَسُيُوفُ الهِنْدِ مُغْمَدَةٌ","وَقد نَظَرْتُ إلَيْهِ وَالسّيُوفُ دَمُ",25,"م",1,0],["قد زرعنا النضار في الفض","ضَةِ البيضاء وهي التي تسمى بزورا",26,"ر",2,1],["قد زوجت بالحل أجسادها","فاصبحت تصبو إلى نفسِها",27,"س",3,0],["قد زُفَّ منك إِلى الكَفِيِّ وإنّه","لأعَزُّ زَوْرٍ في أعزِّ مكانِ",28,"ن",1,0],["قد زادَ طيبَ أحاديثِ الكرامِ بها","ما بالكرائمِ من جُبنٍ ومن بُخُلِ",29,"ل",1,0],["قَد زارَ مِن بِعدٍ فَبَرَّدَ مِن حَشاً","ضَرِمٍ وَسَكَّنَ مِن فُؤادٍ مُقلِقِ",30,"ق",1,0],["قَد زادَ في شَوقِ الغَمامُ وَهاجَني","زَجَلُ الرَواعِدِ تَحتَ لَيلٍ مُطرِقِ",30,"ق",1,0],["قَد زادَ في كَمَدي وَأَضرَمَ لَوعَتي","مَثوى حَبيبٍ يَومَ بانَ وَدِعبِلِ",31,"ل",1,1],["قَد زادَ يَومُ البُؤسِ بَعدَكَ أَنَّهُ","أَفضى إِلَيَّ بِعُقبِ يَومِ نَعيمِ",32,"م",1,0],["قَد زِدتَ في مَرَضِ القُلوبِ فَبَرَّحَت","بُرَحاؤُها وَتَضاعَفَت أَشجانُها",33,"ن",3,0],["قد زادت اللحية في حسنه","زيادة زاد بها عشقي",34,"ي",1,0],["قَد زُرتِني مَرَّةً في الدَهرِ واحِدَةً","ثَنّي وَلا تَجعَليها بَيضَةَ الديكِ",35,"ك",1,0],["قَد زُرتُكُم وَعُيونُ الخَطبِ تَلحَظُني","شَزراً وَتَعثُرُ في آثارِيَ النُوَبُ",36,"ب",1,0],["قد زُرتُ أيكك بعد أن طال النوى","وإليه كنتُ محلقاً بخيالي",37,"ي",1,1],["قَد زَعَمنا أَنَّ السُلُوَّ حُظوظٌ","إِذ زَعَمتُم أَنَّ الهَوى أَرزاقُ",38,"ق",1,0],["قَد زادَ قَلبي حَزَناً","رَسمٌ وَرَبعٌ مُحوِلُ",39,"ل",1,1],["قَد زُرِّدَت فَوقَ فَرعٍ","مِن فَوقِهِ شَمسِيَّه",40,"ي",2,0],["قَد زَيَّنَ اللَهُ دُنيانا وَحَسَّنَها","بِاِبنِ الشَفيعِ إِلى الرَحمَنِ في المَطَرِ",41,"ر",1,0],["قَد زُرتِنا مَرَّةً في الدَهرِ وَاحِدَةً","عودي وَلا تَجعَليها بَيضَةَ الديكِ",42,"ك",1,0],["قَد زُرتُ أَملاكَ بَني هاشِمٍ","وَزارَني البيضُ المَعاصيرُ",43,"ر",1,0],["قَد زُيِّنَت بِالمُحَيّا صورَةً عَجَباً","وَزانَها كَفَلٌ رابٍ وَما عابا",44,"ب",2,0],["قَد زَكَّتِ القَدَمانِ في غَيرِ الهُدى","وَيَداهُ عَمّا حازَهُ ما زَكَّتا",45,"ت",2,0],["قَد زوجت لا عن خيارِ","من جاهل كالوحش ضاري",46,"ر",2,1],["قد زال عن بغداد كل حلاوة","لكن كذاك لها قديم ودادي",47,"د",2,0],["قَدْ زَارهَا مُتَفَضِّلاً فَتَكَامَلَتْ","فِي عِيدِهَا أَسْبَابُ الاسْتِبْشَارِ",48,"ر",1,0],["قَدْ زَعَمُوا الشُّورَى لَنَا مَفْسَدَةً","عَلَى صَلاَحِهَا أَقَالُوا جدَّا",49,"د",2,0],["قَد زادَ في اللَيلِ لَيلٌ","وَطابَ ظِلُّ المَقيلِ",50,"ل",1,0],["قد زارني ذاتَ يومٍ","في وقتِ قَيْظٍ وكِنّ",51,"ن",1,0],["قَدْ زَارَهَا مِنْكَ غَيْثٌ","فَانْهَلَّ فِيها انْسِكابا",52,"ب",2,0],["قد زَادَ في شَوْقي الغَمامُ وَهاجني","زَجَلُ الرّوَاعِدِ تحتَ لَيلٍ مُطرِقِ",53,"ق",1,0],["قد زاد في شكوايَ إطراحُك إي","يايَ وما كان ذاك من سُننِك",54,"ك",1,0],["قَد زارَنا النَّرجِسُ الذَكيُّ","وَحانَ مِن يَومِنا العَشِيُّ",55,"ي",1,1],["قَد زارَني وَكَأَنَّهُ رَيحانة","يَهتَزُّ مِن تَحت القِباءِ الأَخضَرِ",56,"ر",1,1],["قَد زارَني وَظَلام اللَيل مُعتَكَرُ","وَالنجم يخطر في أَلحاظِهِ السَهَرُ",57,"ر",1,1],["قَد زارَ مَن كُنت قَبل زورتِهِ","أَراهُ لَكن بِمُقلة الأَمَل",58,"ل",1,1],["قد زاحمت قبة الافلاك همته","فاقصرتها وحار الجدي والحوت",59,"ت",1,0],["قد زهاه الشموخ فاختال تيهاً","ولوى شدقه على الخلصاء",60,"ا",2,0],["قد زاده الله ثروةً وغنىً","كما علا كلَّ حاكمٍ رَفَعَهْ",61,"ع",2,0],["قد زان مَخبَره بأجملِ مَنظرٍ","وأعان مَنظرَه بأحسن مخَبرِ",62,"ر",1,0],["قَدْ زَهَتِ الرَّاءُ مِنْ مُقَبَّلِهِ","فَوْقَ نِظَامَيْنِ لُؤْلُؤِيَّيْنِ",63,"ن",1,0],["قد زادني الشوق على ضعفي وها","لبعدكم والعظم منى قد وهن",64,"ن",1,0],["قد زرتُها ليلاً فلما أسفرت","أبصرتُ شمساً نورُها يتصعّدُ",65,"د",1,0],["قد زدته شكرا وزادك أنعما","والشكر للنعماء خير خدين",66,"ن",1,0],["قد زيد ضعف ما يراد كله","في وزنه وهو العجيب أمره",67,"ر",2,0],["قَد زارَ خالِقَهُ الكَريمِ مخلِّفاً","في الأَرضِ ذكرَ مَكارمٍ لا تَدرُسُ",68,"س",1,0],["قَد زارَ ميخائيلُ والدَهُ وفِي","دارِ السَعادةِ باتَ مَعَهُ نَزيلا",69,"ل",2,0],["قد زادني أدبٌ يمشي على قدمٍ","صحيحة ما بها عيب ولا حنفُ",70,"ف",1,1],["قد زينوا الأحداث وي","لهمو وسمّوها مخادع",71,"ع",1,0],["قد زرت موضع قبره فكأنما","قلّبتُ منه روضة وقبولا",72,"ل",2,0],["قد زكت لي بك الأماني وصارت","همماً ترتقي وكانت هموما",73,"م",2,0],["قد زاره المرض العاتي فأزهقه","وكان كالورد في ألفاف بستان",74,"ن",1,0],["قَدْ زَارَهَا إِذْ زُرْتَهَا خُفْيَةً","بَدْرُ الْمَعَالِي مُشْرِقُ الْغُرَّهْ",75,"ر",2,0],["قد زها في لجينه","رونقاً مذ تجدّدا",76,"د",2,0],["قد زالَ ما كان من نهدٍ ومن كفَلٍ","تلكَ المحاسِنُ من دكَّانِ بزّاز",77,"ز",1,0],["قد زالَ ما كان من نهدِ ومن كَفَلٍ","فما ظفرتُ بخفَّاقٍ ورَجراج",78,"ج",1,0],["قد زادني كلفاً بنظمك أنه","صيغت لمدح الهاشمي حلاه",79,"ا",2,0],["قَد زاحَمَ الوُرقَ عَلى رَنينِها","وَشارَكَ النِياقَ في حَنينِها",80,"ن",3,0],["قد زُرعتْ من قبلها ال","منى بوادٍ مجدب",81,"ب",1,0],["قد زاد هذا النيل في عامنا","فأغرق الأرض بإنعامه",82,"ه",1,1],["قد زاد منه الحنين","وساعدته الدموع",83,"ع",1,0],["قَد زُحزِحت عنكم قليلاً ريثما","يَشدو الفتيُّ ويحلم المترعرعُ",84,"ع",1,0],["قَد زايَلَ الشامَ تَبكي بَعدَهُ أَسَفَا","وَغَرَسَ خَيراتِهِ فيها اِزدَهى وَرَبا",85,"ب",2,0],["قَد زَكا أَصل فرعه","وَحَوى الفَضل مُطلَقا",86,"ق",2,0],["قَد زُرت عَبدِك مُحسنا متفضلا","وَكَذا العَبيد تَزورُها