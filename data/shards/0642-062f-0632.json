0521.html","البسيط"],[43,"الخيل والليل والبيداءُ تعرفني","https://www.aldiwan.net/poem20938.html","البسيط"],[62,"قد زرعنا النضار في الفضة","https://www.aldiwan.net/poem52156.html","الخفيف"],[62,"في باطن الأرواح كبريتة","https://www.aldiwan.net/poem52167.html","السريع"],[62,"خفق الطبول وزمرة الندمان","https://www.aldiwan.net/poem52250.html","الكامل"],[62,"أصالة الرأي صانتني ( لامية العجم )","https://www.aldiwan.net/poem52315.html","البسيط"],[45,"أما الخيال فإنه لم يطرق","https://www.aldiwan.net/poem65181.html","الكامل"],[45,"قد زاد في كمدي وأضرم لوعتي","https://www.aldiwan.net/poem65588.html","الكامل"],[45,"قل للجنوب إذا غدوت فأبلغي","https://www.aldiwan.net/poem65668.html","الخفيف"],[45,"علل النفوس قريبة أوطانها","https://www.aldiwan.net/poem66669.html","الكامل"],[61,"محسن الأخلاق والخلق","https://www.aldiwan.net/poem51345.html","السريع"],[49,"يا أحسن الناس ريقا غير مختبر","https://www.aldiwan.net/poem64263.html","البسيط"],[66,"ما هبت الريح إلا هزني الطرب","https://www.aldiwan.net/poem40984.html","البسيط"],[97,"قد زرت أيكك بعد أن طال النوى","https://www.aldiwan.net/poem24592.html","الكامل"],[44,"يا هلالا غدا عليه المحاق","https://www.aldiwan.net/poem30017.html","الخفيف"],[31,"قد زاد قلبي حزنا","https://www.aldiwan.net/poem42023.html","مجزوء الرجز"],[52,"كم غدوة وعشيه","https://www.aldiwan.net/poem26570.html","المجتث"],[48,"قام الأمين بأمر الله في البشر","https://www.aldiwan.net/poem63359.html","الطويل"],[50,"أخشى عليك من الجارات حاسدة","https://www.aldiwan.net/poem62299.html","البسيط"],[50,"يا طير إنا في غد طير","https://www.aldiwan.net/poem63822.html","السريع"],[50,"يا صاح قم فاسقني بالكأس إعرابا","https://www.aldiwan.net/poem64847.html","البسيط"],[46,"يا صاح إن حاورت آخر مشفق","https://www.aldiwan.net/poem22177.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85581","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85557","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54943","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54693","الرجز"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/9443","المجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54267","المجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54236","المجتث"],[45,"أمّا الخَيالُ، فإنّهُ لمْ يَطْرُقِ","https://www.poetsgate.com/ViewPoem.aspx?id=32849",""],[51,"أنَّى تشاغلتَ عن أبي حَسَنِكْ","https://www.poetsgate.com/ViewPoem.aspx?id=30025",""],[78,"قَد زارَنا النَّرجِسُ الذَكيُّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86636&r=&rc=131",""]],"verses":[["قَد زادَهُ اللَهُ عَلى عُظمِ الخَطَر","مَكارِماً ذاتَ حُجولٍ وَغُرَر",0,"ر",1,0],["قَد زَيَّلَت عَظيمَةٌ فَشَمِّري","وَاِرضي بِما جَرَّ القَضاءُ وَاِصبِري",1,"ي",1,1],["قَد زَيَّنَ اللَهُ في عَينَيَّ ما صَنَعت","حَتّى أَرى حَسَناً ما لَيسَ بِالحَسَنِ",2,"ن",1,0],["قَد زارَني طَيفَكُم لَيلاً فَأَرَّقَني","فَبُتُّ لِلشَوقِ أُذري الدَمعَ تَهتانا",3,"ن",2,0],["قد زرت قبرك يا أبا الشرف","فنثرت ذر الدمع من أسف",4,"ف",1,1],["قَدْ زَيَّنَ الدُّنْيَا بِنُورِ جَمَالِهِ","فَلِذّاكَ مَا يُدْعَى أَبَا زِيَّانِ",5,"ن",1,0],["قدْ زُرْتُ قَبْرَكَ عنْ طَوْعٍ بأغْماتِ","رأيْتُ ذلِكَ منْ أوْلَى المُهِمّاتِ",6,"ت",1,1],["قَد زَيَّنَ العِلمَ بِأَخلاقِهِ","فَعاشَ مِلءَ العَينِ وَالمَسمَعِ",7,"ع",1,0],["قَد زَعزَعَتهُ يَدُ القَضا","ءِ وَزَلزَلَتهُ يَدُ القَدَر",8,"ر",1,0],["قَد زُرتُ مُتحَفَ مِصرٍ","في ظُهرِ يَومِ الخَميسِ",9,"س",1,0],["قَد زارَني مِن بَني الأَتراكِ مُختَفِياً","ظَبيٌ عَلى غَيرِ ميعادٍ لَهُ سَلَفا",10,"ف",2,1],["قد زارك العيد السعيد مبشْراً","فاسمح لألف منهم بمزارِ",11,"ر",1,0],["قد زان قصريَ سعدٌ","بسعده المتوالي",12,"ي",1,0],["قد زاغت الأبصار فيما ترى","إذ فات عنها سرّك المودع",13,"ع",1,0],["قَد زَوَّجوهُم فَهُم فيهِم وَناسِبُهُم","إِلى حَنيفَةَ يَدعو ثُلثَ باقيها",14,"ي",3,0],["قد زمجرَ الرعدُ بآفاقهِ","كأنَّه ممَّا دهاه صرَخ",15,"خ",1,0],["قد زُفّت الشمس إلى البدرِ","يا لك من قَدر ومن قَدْرِ",16,"ر",1,1],["قد زاد في شكوى إِطِّراحُك إي","يايَ وما كان ذاك من سُننِك",17,"ك",1,0],["قَد زارَني مَن لا أُحِبُّ","وَأَنتِ أَولى مَن تَزوري",18,"ر",2,0],["قَد زَلَّ مَن كانَ المُعي","نَ لِوَجدِهِ الدَمعُ المَعينُ",19,"ن",1,0],["قَد زارَنا النَرجِسُ الذَكيُّ","وَآنَ مِن يَومِنا العَشيُّ",20,"ي",1,1],["قد زرت قبرك الذي","ترابه قد شملك",21,"ك",1,0],["قَد زِدتَها هَرَماً يُحَجُّ فِناؤُهُ","وَيُشَدُّ لِلدُنيا إِلَيهِ حِزامُ",22,"م",1,0],["قَد زادَني إِقبالُكُم وَقُبولُكُم","شَرَفاً عَلى الشَرَفِ الَّذي أَولَيتُهُ",23,"ت",2,0],["قَد زُرتُهُ وَسُيوفُ الهِندِ مُغمَدَتٌ","وَقَد نَظَرتُ إِلَيهِ وَالسُيوفُ دَمُ",24,"م",1,0],["قد زُرْتُهُ وَسُيُوفُ الهِنْدِ مُغْمَدَةٌ","وَقد نَظَرْتُ إلَيْهِ وَالسّيُوفُ دَمُ",25,"م",1,0],["قد زرعنا النضار في الفض","ضَةِ البيضاء وهي التي تسمى بزورا",26,"ر",2,1],["قد زوجت بالحل أجسادها","فاصبحت تصبو إلى نفسِها",27,"س",3,0],["قد زُفَّ منك إِلى الكَفِيِّ وإنّه","لأعَزُّ زَوْرٍ في أعزِّ مكانِ",28,"ن",1,0],["قد زادَ طيبَ أحاديثِ الكرامِ بها","ما بالكرائمِ من جُبنٍ ومن بُخُلِ",29,"ل",1,0],["قَد زارَ مِن بِعدٍ فَبَرَّدَ مِن حَشاً","ضَرِمٍ وَسَكَّنَ مِن فُؤادٍ مُقلِقِ",30,"ق",1,0],["قَد زادَ في شَوقِ الغَمامُ وَهاجَني","زَجَلُ الرَواعِدِ تَحتَ لَيلٍ مُطرِقِ",30,"ق",1,0],["قَد زادَ في كَمَدي وَأَضرَمَ لَوعَتي","مَثوى حَبيبٍ يَومَ بانَ وَدِعبِلِ",31,"ل",1,1],["قَد زادَ يَومُ البُؤسِ بَعدَكَ أَنَّهُ","أَفضى إِلَيَّ بِعُقبِ يَومِ نَعيمِ",32,"م",1,0],["قَد زِدتَ في مَرَضِ القُلوبِ فَبَرَّحَت","بُرَحاؤُها وَتَضاعَفَت أَشجانُها",33,"ن",3,0],["قد زادت اللحية في حسنه","زيادة زاد بها عشقي",34,"ي",1,0],["قَد زُرتِني مَرَّةً في الدَهرِ واحِدَةً","ثَنّي وَلا تَجعَليها بَيضَةَ الديكِ",35,"ك",1,0],["قَد زُرتُكُم وَعُيونُ الخَطبِ تَلحَظُني","شَزراً وَتَعثُرُ في آثارِيَ النُوَبُ",36,"ب",1,0],["قد زُرتُ أيكك بعد أن طال النوى","وإليه كنتُ محلقاً بخيالي",37,"ي",1,1],["قَد زَعَمنا أَنَّ السُلُوَّ حُظوظٌ","إِذ زَعَمتُم أَنَّ الهَوى أَرزاقُ",38,"ق",1,0],["قَد زادَ قَلبي حَزَناً","رَسمٌ وَرَبعٌ مُحوِلُ",39,"ل",1,1],["قَد زُرِّدَت فَوقَ فَرعٍ","مِن فَوقِهِ شَمسِيَّه",40,"ي",2,0],["قَد زَيَّنَ اللَهُ دُنيانا وَحَسَّنَها","بِاِبنِ الشَفيعِ إِلى الرَحمَنِ في المَطَرِ",41,"ر",1,0],["قَد زُرتِنا مَرَّةً في الدَهرِ وَاحِدَةً","عودي وَلا تَجعَليها بَيضَةَ الديكِ",42,"ك",1,0],["قَد زُرتُ أَملاكَ بَني هاشِمٍ","وَزارَني البيضُ المَعاصيرُ",43,"ر",1,0],["قَد زُيِّنَت بِالمُحَيّا صورَةً عَجَباً","وَزانَها كَفَلٌ رابٍ وَما عابا",44,"ب",2,0],["قَد زَكَّتِ القَدَمانِ في غَيرِ الهُدى","وَيَداهُ عَمّا حازَهُ ما زَكَّتا",45,"ت",2,0],["قَد زوجت لا عن خيارِ","من جاهل كالوحش ضاري",46,"ر",2,1],["قد زال عن بغداد كل حلاوة","لكن كذاك لها قديم ودادي",47,"د",2,0],["قَدْ زَارهَا مُتَفَضِّلاً فَتَكَامَلَتْ","فِي عِيدِهَا أَسْبَابُ الاسْتِبْشَارِ",48,"ر",1,0],["قَدْ زَعَمُوا الشُّورَى لَنَا مَفْسَدَةً","عَلَى صَلاَحِهَا أَقَالُوا جدَّا",49,"د",2,0],["قَد زادَ في اللَيلِ لَيلٌ","وَطابَ ظِلُّ المَقيلِ",50,"ل",1,0],["قد زارني ذاتَ يومٍ","في وقتِ قَيْظٍ وكِنّ",51,"ن",1,0],["قَدْ زَارَهَا مِنْكَ غَيْثٌ","فَانْهَلَّ فِيها انْسِكابا",52,"ب",2,0],["قد زَادَ في شَوْقي الغَمامُ وَهاجني","زَجَلُ الرّوَاعِدِ تحتَ لَيلٍ مُطرِقِ",53,"ق",1,0],["قد زاد في شكوايَ إطراحُك إي","يايَ وما كان ذاك من سُننِك",54,"ك",1,0],["قَد زارَنا النَّرجِسُ الذَكيُّ","وَحانَ مِن يَومِنا العَشِيُّ",55,"ي",1,1]]}