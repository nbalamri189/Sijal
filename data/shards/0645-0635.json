ewPoem.aspx?id=33313",""],[77,"ما على القلب بعدكم من جناح","https://www.poetsgate.com/ViewPoem.aspx?id=33823",""],[30,"عفا الدَّحلُ منْ ميِّ فمحَّتْ منازلهُ","https://www.poetsgate.com/ViewPoem.aspx?id=3087",""],[67,"سارتِ العِيسُ يُرجعْنَ الحنينا","https://www.poetsgate.com/ViewPoem.aspx?id=14580",""],[90,"على سعد","https://www.poetsgate.com/ViewPoem.aspx?id=179079",""],[45,"لأَيَّةِ حالٍ أَعْلَنَ الوَجْدَ كاتِمُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=32082",""],[45,"نصب إلى طيب العراق وحسنها","https://www.poetsgate.com/ViewPoem.aspx?id=31273",""],[91,"لمن الديار؟","https://www.poetsgate.com/ViewPoem.aspx?id=53211",""],[51,"وقفاتُ رأيك في الخطوبِ تأملُ","https://www.poetsgate.com/ViewPoem.aspx?id=30338",""],[51,"مالي إذا زدتُ حُبا زدتِ مقلية ً","https://www.poetsgate.com/ViewPoem.aspx?id=30615",""],[105,"في حمى الحق ومن حول الحرم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55068&r=&rc=238",""],[97,"ليلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63574&r=&rc=121",""]],"verses":[["مُصافيكَ في الأَيّامِ أَنفُكَ أَنفُهُ","إِذا جَلَّ ما تَلقى وَرُغمُكَ رُغمُهُ",0,"م",2,0],["مَصاعِبُ لَم تُعطِ الرُؤوسَ لِقائِدٍ","وَلا اِستَوسَقَت قَبلَ المَنايا لِسائِقِ",1,"ق",1,0],["مَصاعِبٌ ذَعذَعَت أَيدي المَنونِ بِها","فَطاعَ مُعتَصِمٌ وَاِنقادَ مُمتَنِعُ",2,"ع",1,0],["مُصطَنِعي وَالسَنُّ في رَوقِها","أَصابَ مِنّي غَرَضَ المَصنَعِ",3,"ع",1,0],["مَصائِبُ لا أُنادي الصَبرَ فيها","وَلا أُدعى إِلَيهِ وَلا أُنادى",4,"د",2,0],["مُصابُكَ لَم يَدَع قَلباً ضَنيناً","بَغُلَّتِهِ وَلا عَيناً جَمادا",4,"د",2,0],["مَصاعِبٌ حَطَمَتهُم","أَيدي المَنونِ فَخَبّوا",5,"ب",3,0],["مُصابٌ نُجومُ المَجدِ فيهِ نَواجِمٌ","تَرَكنَ نَجومَ الصَبرِ عَنهُ غَوارِبا",6,"ب",2,0],["مُصابٌ رَمى مِن هاشِمٍ في صَميمِها","فَأَمسَت دُراها خُشَّعاً وَالغَوارِبُ",7,"ب",1,0],["مَصاليتُ يَغشَوْنَ المَنايا وَقَولُهُم","لِمَن صَدَّ عَنها لاتَ حينَ مَناصِ",8,"ص",1,0],["مصْروفَةٌ لجِهادٍ","وحِكمَةٍ وعطيّهْ",9,"ه",1,0],["مُصطَفى الكونِ من ظُهورِ النّبيي","نَ هُداةِ الأنامِ سُبْلِ الفَلاحِ",10,"ح",1,0],["مَصَائِبُ أَشْجَى وَقْعُهَا مُهَجَ الْعِدَى","وَكَمْ نِعَمٍ فِي طَيِّ تِلْكَ الْمَصَائِبِ",11,"ب",1,0],["مَصارِعُ إِخوانٍ وَفَخرُ قَبيلَةٍ","عَلَينا كَأَنّا لَيسَ مِنّا قَبيلُها",12,"ل",3,0],["مُصابُ صَرّوفٍ مُصابُ النُهى","فَليَبكِهِ كُلَّ فُؤادٍ يَعي",13,"ع",2,0],["مُصحَفُ عُثمانَ صاحَ مِن حَنَقٍ","رافِعُ قَدري ما بالُهُ خَفَضَه",14,"ض",2,1],["مَصقولَةَ الأَلفاظِ يَلقاها الفَتى","مِن كُلِّ جارِجَةٍ بِسَمعٍ واعِ",15,"ع",1,0],["مُصابُ الَّذي يَأسى بِمَيتِ ثَوابِهِ","هُوَ البَرحُ لا المَيتُ الَّذي أَحرَزَ القَبرُ",16,"ر",1,0],["مَصانِعَ عِزٍّ لَيسَ بِالتّربِ شُرِّفَت","وَلَكِن بِصُمَ السَمهَرِيِّ المُعَرَّنِ",17,"ن",1,0],["مُصيبَتُهُ عَلَيَّ وَرَوَّعَتني","فَقَد خَصَّت مُصيبَتُهُ وَعَمَّت",18,"ت",1,0],["مِصْرُ تُحَيِّيكُمْ وَتُثْنِي عَلَى","كُلِّ جَوَادٍ مَاجِدٍ نَدْبِ",19,"ب",1,0],["مِصْرُ الَّتِي فِيهَا الْهُدَى وَالنَّدَى","يَسْتَبِقَانِ المَجْدَ مِنْ قُرْبِ",19,"ب",1,0],["مِصْرُ يَا أُسْتَاذُ تَذْكُرُ مَا","جِئْتَ بِالإِعْجَابِ وَالْعُجْبِ",20,"ب",1,0],["مِصْرُ تَزْهَى بِطَلْعَةِ الْعَاهِلِ الْعَ","ادِلِ وَالْحَاكِمِ الْحَصِيفِ الأَرِيبِ",21,"ب",1,0],["مَصْدَرُ أَنْوَارٍ كَفَى أَنَّهُ","مَطْلَعُ هّذِي الشُّهُبِ اللاَّمِعَهْ",22,"ع",2,0],["مِصْرُ جَاءَتْ وَبِهَا","بِالوَلاءِ البَينِ",23,"ن",1,0],["مِصْرُ الَّتِي لَيْسَتْ مَنَابِتُهَا","خِلَساً وَمَا فِي مَائِهَا أَسَنُ",24,"ن",1,0],["مِصْر الَّتِي أَبَداً حَدَائِقُهَا","غَنَّاءُ لا يَعْرَى بِهَا غُصُنُ",24,"ن",1,0],["مِصْر الَّتِي أَخْلاقُ أُمَّتِهَا","زَهْرٌ سَقَاهُ العَارِضُ الهَتِنُ",24,"ن",1,0],["مِصْر الَّتِي أَخْلاقُهَا حُفُلٌ","وَيَدِرُّ الشُّهْدُ وَاللَّبَنُ",24,"ن",1,0],["مِصْرُ تُهْدِي إِلَيْهِ مضنْ هُوَ أَهْدَا","هُ إِلَيْهَا تَهَادِيَ الخُلْصَانِ",25,"ن",1,0],["مِصْرُ قَامَتْ كُنْتَ بِالرُّوحِ تَفْتَدِيهَا وَمَا","مَنْ يَفْتَدِيهَا بِرُوحِهِ مَغْبُونُ",26,"ن",1,0],["مُصَابٌ أَصَابَ العُرْبَ بَدْواً أَوْ حُضَّراً","فَقَحْطَانُ مَكْلُومُ الفُؤَادِ وَعَدْنَانُ",27,"ن",1,0],["مِصْرُ تِيهِي بِنَابِهِينَ كِرَا","هُمْ فَخَارُ الأَمْصَارِ فِي كُلِّ آنِ",28,"ن",1,0],["مُصَابُكُمْ شَفَّ مِصْرَ حُزْناً","ورَوَّعَ البَيْتَ وَالشَّآمَا",29,"م",2,0],["مِصْرُ تَرْعَى ذِمَامَهُ وَتُحْيِّي","كُلَّ بَرْقٍ مِنْ السَّوَادِ يشَامُ",30,"م",1,0],["مِصْرُ الْحَضَارَةُ وَالآثَارُ شَاهِدَةٌ","مِصْرُ السَّمَاحَةُ مِصْرُ المَجْدُ مِنْ قِدَمِ",31,"م",1,0],["مِصْرُ العَزِيزَةُ إِنْ جَارَتْ وَإِنْ عَدَلَتْ","مِصْرُ الْحَبِيبَةُ إِنْ نَرحَلْ وَإِنْ نُقِمِ",31,"م",1,0],["مِصْرُ تَبْكِي مُحَمَّداً بِفُؤَادٍ","أَثْخَنَتْهُ السِّهَامُ بَعْدَ السِّهَامِ",32,"م",1,0],["مِصْرُ قَهَّارَةُ الزَّمَانِ وَلَمْ تَعْ","دَمْ هُمَاماً يَجِيءُ بَعْدَ هُمَامِ",32,"م",1,0],["مِصْر تُنَادِيكُمْ فَمَنْ يُحْجِمُ","تَطَوَّعُوا وَالأَسْبَقُ الأَكْرَمُ",33,"م",1,1],["مِصْرُ بِحَقٍّ نَدَبَتْ نَشْئَهَا","لَهَا وَذَاكَ الشَّرَفُ الأَعْظَمُ",33,"م",1,0],["مِصْرُ تُهْدِي إِلَى بَنِيهَا السَّلامَا","وَهْيَ تَدْعُو إِلَى الْحِفَاظِ الكِرَامَا",34,"م",2,1],["مِصْرُ الَّتِي مِتُّمْ فِدَاهَا أَصْبَحَتْ","وَكَأَنَّمَا فِيهَا السرُورُ حَرَامُ",35,"م",1,0],["مِصْرُ الَّتِي ظَنوا الْحِمَامَ سُكُونَهَا","وَهَلِ السكُون مَعَ الشَّكَاةِ حِمَامُ",35,"م",1,0],["مَصَابِيحُ يَسْتَعْدِي بِهَا مَنْ يُضِيئُهَا","عَلَى ظُلُمَاتِ اللَّيْلِ أَوْ تَتجَرَّمَا",36,"م",2,0],["مِصْرُ الَّتِي أَعَزَزْتِهَا وَحَبَبْتِهَا","عَنْ ظُهْرِ نَفْسٍ مِنْكِ حُبَّ غَرَامِ",37,"م",1,0],["مِصْرُ العَرِينِ وَهَؤلاَءِ بِمَا بِهِمْ","مِنْ عِزَّةٍ هُمْ خَيْرَةُ الأَشْبالِ",38,"ل",1,0],["مَصابيحُهُ خوصُ العُيونِ كَأَنَّها","قَطاً خامِسٌ أَسرى بِهِ مُتَيَمِّمُ",39,"م",1,0],["مِصَكٌّ كَمِقلاءِ الفَتى ذادَ نَفسَهُ","عَنِ الوِردِ حَتّى اِئتَجَّ فيها غَليلُها",40,"ل",3,0],["مَصاليتُ رَكّابونَ لِلشَرِّ حالَةً","وَلِلخَيرِ حالاً ما تُجازى نَوافِلُه",41,"ل",2,0],["مَصابيحَ ليَسَت بِاللَواتيِ تَقودُها","نُجومٌ وَلا بالآفِلاتِ الدَوالِكِ",42,"ك",1,0],["مصارفة النقدين فيها بمثلها","أجاز بها قاضي الجمال التقاضيا",43,"ي",2,0],["مُصابنا أمسى فظيعاً بها","يا ربّ ما أفظع هذا المُصاب",44,"ب",1,0],["مَصاعيبَ أَمثالَ الهُذَيلِ رِماحُهُم","بِها مِن دِماءِ القَومِ خَضبٌ عَلى خَضبِ",45,"ب",1,0],["مَصاليتُ يَومَ الرَوعِ تَلقى عَصِيَّنا","سُرَيجِيَّةً يَخلينَ ساقاً وَمِعصَما",46,"م",2,0],["مُصَلٍّ أباه له سابق","بأن قيل فات العِذارُ العذارا",47,"ر",2,1],["مُصَفَّون في الأحسَابِ مَحضُونَ نَجرُهم","هُمُ المَحضُ مِنَّا والصَّرِيحُ المهذَّبُ",48,"ب",1,0],["مُصِّيّبٌ على الأعوَادِ يومَ رُكوبِها","لِما قالَ فيها مُخطِيءٌ حينَ يَنزِلُ",49,"ل",1,0],["مُصابي جَليلٌ وَالعَزاءُ جَميلُ","وَظَنّي بِأَنَّ اللَهَ سَوفَ يُديلُ",50,"ل",1,1],["مُصَدِّقاً لِلنَبِيِّينَ الأُلى سَلَفوا","وَأَبذَلَ الناسِ لِلمَعروفِ لِلجادي",51,"ي",1,0],["مصرّف الفكر في حبِّ العلومِ فما","يشفى بسعدى ولا يروى بظمياء",52,"ا",2,0],["مصونةٌ تجعلُ الأستارَ ظاهرةً","وجنةٌ تتلقى العينَ باللهب",53,"ب",1,0],["مصونة السرّ ماتتْ دونَ غايتها","حاجاتُ قومٍ وللحاجاتِ أوقات",54,"ت",1,0],["مصعَّدة من حيث تم كيانها","تطافُ علينا في إناءٍ مجسَّد",55,"د",1,0],["مصريَّة تبدِي التصامم إن روتْ","لفظاً لأن اللفظ منها سكّر",56,"ر",1,1],["مصحح النقل عن شهدٍ وعن بردٍ","لأنه منهلٌ بالراح معلول",57,"ل",1,0],["مصرية بين بيوت الفضل ما عرفت","فيها نسبة جزّار وحمَّام",58,"م",1,0],["مُصدِّقَ كنيةٍ حسناءَ واسمٍ","وكم سمةٍ مكذَّبةٍ كذوبِ",59,"ب",1,0],["مصباحُ نورٍ يُرى الخفيُّ به","جهراً ولولاهُ طال مُحتجَبُهْ",60,"ب",2,0],["مُصدَّرٌ بمجدهم مؤرّخُ","ذو همةٍ تسمو وحلم يرسخُ",61,"خ",1,0],["مُصغياً عن معايب فيه شتّىً","حقُّها أن تُدِرَّ غيظاً وريدَكْ",62,"ك",1,0],["مُصَرصِر لكنه صيِّتٌ","عقارب الدار له تُذعَر",63,"ر",1,0],["مُصغياً نحو الملاهي ناعماً","بين أشباه المها والخندريس",64,"س",1,0],["مصمماً غير وقاف وآونة","تلقاه عند حدود الله وقّافا",65,"ف",2,0],["مصقولةٌ أخلاقُه لا تُجتَرى","مشحوذةٌ عزماتُه لا تَنْكلُ",66,"ل",1,0],["مُصحوْنَ مُسْتَمْطَرون سحَّاً","فهمْ غيوثٌ بلا غيومِ",67,"م",1,0],["مُصحَّح الجسم لم يُلْمِمُ به سَقَمٌ","ولا استكان إلى هجرٍ ولا بَيْن",68,"ن",1,0],["مُصحّح الجسم لم يُلمِم به سقمٌ","ولا استكان لهجرانٍ ولا بَيْنِ",69,"ن",1,0],["مُصَفَّقَةٌ مُصَفّاةٌ عُقارٌ","شَآمِيَّةٌ إِذا جُلِيَت مَروحُ",70,"ح",1,0],["مُصاحِبَ خوصٍ قَد نَحِلنَ كَأَنَّما","يَقينَ النُفوسِ أَن تَمَسَّ الكَلاكِلا",71,"ل",2,0],["مَصاليتُ نَصطَنعُ السُيوفَ مَعاذَةً","لَنا عارِضٌ يَنفي العَدُوَّ وَيَرجَحُ",72,"ح",1,0],["مَصقولَةٌ صَقلَ الزُجا