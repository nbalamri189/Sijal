{"poems":[[74,"أقلامك الحمر في أوراقك البيض","https://www.aldiwan.net/poem19129.html","البسيط"],[46,"إن الأمير حمام الجارع الجاني","https://www.aldiwan.net/poem30333.html","البسيط"],[52,"مسني من صدود عبدة ضر","https://www.aldiwan.net/poem62393.html","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43687","الخفيف"],[208,"ريح شوق للبين كانت سموما","https://www.aldiwan.net/poem53185.html","الخفيف"],[265,"دفعناكُمُ بالحلم حتى بطرتُمُ","https://www.aldiwan.net/poem1108.html",""],[275,"مسن في الوشي بين زهر ونور","https://www.aldiwan.net/poem35260.html","الخفيف"],[385,"مسني الضر من صدودك عني","https://www.aldiwan.net/poem49257.html","الخفيف"],[443,"صب براه بعدهم طول الأرق","https://www.aldiwan.net/poem2500.html","الرجز"],[457,"كم حللت الحبى بشرخ الشباب","https://www.aldiwan.net/poem13629.html","الخفيف"],[466,"خفضا لا موت الا بأجل","https://www.aldiwan.net/poem15467.html","الرمل"],[475,"ودعتهن ولا شيء يراجعني","https://www.aldiwan.net/poem4819.html","البسيط"],[484,"سل ما لقلبي تلظى","https://www.aldiwan.net/poem37176.html","المجتث"],[505,"يا رجال الغيب أين الهمم","https://www.aldiwan.net/poem37787.html","الرمل"],[556,"ما للقلوب غداة السبت مزعجة","https://www.aldiwan.net/poem47250.html","البسيط"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59533","الخفيف"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65072","الرمل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65093","الرمل"],[1895,"","https://poetry.dctabudhabi.ae/diwan/poem/74990","الرمل"],[1991,"","https://poetry.dctabudhabi.ae/diwan/poem/20387","الخفيف"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199808","المسحوب"],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84534","الخفيف"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75932","الخفيف"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99474","السريع"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82820","الخفيف"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117880","الرمل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66540","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77070","الرجز"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4733,"عتاب","https://www.poetsgate.com/ViewPoem.aspx?id=189631",""],[4830,"ياصَبيَّهْ","https://www.poetsgate.com/ViewPoem.aspx?id=210819",""],[5186,"\"من \"\"البرج\"\" في كانون والليل خيما","https://www.poetsgate.com/ViewPoem.aspx?id=156441",""],[5295,"إمامُ العشقِ","https://www.poetsgate.com/ViewPoem.aspx?id=163335",""],[5411,"يا بن زيدون..","https://www.poetsgate.com/ViewPoem.aspx?id=189921",""],[5725,"مسنا الضر","https://www.poetsgate.com/ViewPoem.aspx?id=212344",""],[5776,"مسّني الشعرُ","https://www.poetsgate.com/ViewPoem.aspx?id=199457",""],[5941,"الملكوت","https://www.poetsgate.com/ViewPoem.aspx?id=188907",""],[5980,"جئت والوقوف بالمكارم أظلم","https://www.poetsgate.com/ViewPoem.aspx?id=146262",""]],"verses":[["مسنونة الحدّ كم عدت مكارمها","فرضاً فقامت بمسنونٍ ومفروض",0,"ض",1,0],["مِسَنُّ فِكرٍ إِذا كَلَّت مَضارِبُهُ","يَوماً وَصَيقَلُ أَلبابٍ وَأَذهانِ",1,"ن",1,0],["مَسَّني مِن صُدودِ عَبدَةَ ضَرُّ","فَبَناتُ الفُؤادِ ما تَستَقِرُّ",2,"ر",1,1],["مَسَّني القَرحُ وَاِستَضامَني البَغ","يُ لِفقدانِ بُغيَتي وَاِقتِراحي",3,"ح",2,0],["مَسَّني حظُّك الجسيم فأعدا","نيَ حتى رأيتُ حظي جسيما",4,"م",2,0],["مَسَننا مِنَ الآباءِ شَيئاً وَكُلُّنا","إِلى حَسَبٍ في قَومِهِ غَيرُ راضِعِ",5,"ع",1,0],["مِسنَ في الوشي بينَ زهرٍ ونورِ","وحَللنَ الشعورَ فوقَ الصدورِ",6,"ر",1,1],["مَسَني الضُرُّ مِن صُدودك عَني","وَأَشتَفي حاسِدي بِذَلِكَ مني",7,"ن",2,1],["مسني العطيا والزمان باخل","مردى الأعادي والمنيات خرق",8,"ق",1,0],["مسند الشام مع فسطين خير الد","ين من جاء بالعجيب العجاب",9,"ب",1,0],["مُسْنتٍ طارتْ به مُجْدِبةٌ","فسرى يخْضبُ خُفّاً واِطَلْ",10,"ل",1,0],["مُسَنَّداتٌ وَقَد مالَت سَوالِفُها","وَما بِهِنَّ سِوى مَسِّ الهَوى أَلَم",11,"م",1,0],["مسني اليك وداد","يثير كامن وجدك",12,"ك",1,0],["مسَّنا الكربُ فقُوموا علَناً","وأَغيثونا وجُودوا وأنْعِموا",13,"م",3,0],["مسنّدين إلى زَوْراءَ موحشة","ظلماءَ لا إِرَمٌ فيها ولا عَلَمُ",14,"م",1,0],["مسنى الضرُّ إذ هجرتَ فصِلني","قد عذُبْ لي أن كنت تهوى عذابي",15,"ب",2,0],["مَسَّني مِنْ شعرِكَ البا","ردِ حرٌّ بل حَريقُ",16,"ق",1,0],["مَسَّني الضُّرُّ فأَسْعِدْ","ني على مَشْي أُموري",17,"ر",2,0],["مسني الضر وَأَنتم عدتي","واعتمادي إن دهت قَلبي الغيل",18,"ل",1,0],["مُسنِفاتٌ كَأَنَّهُنَّ قَنا الهِن","د وَنَسّى الوَجيفُ شَغبَ المرودِ",19,"د",1,0],["مسندى ذخري وسلطاني","لي علينا طالت اشبوره",20,"ر",2,0],["مسنى حادِث الزَمان بهم","وَهُوَ لا شك من عوادى الكرام",21,"م",1,0],["مُسند الدارِمي وَمُسنَدَ عَبدٍ","وَالصَحيحينِ مُسلِماً وَالبُخاري",22,"ر",2,0],["مسنة تصبو إلى أمردٍ","فهي على العاهة لوطيه",23,"ي",2,0],["مَسّنى السَقم مِن تجنّيه حَتّى","صارَ جِسمي من الضَنا كَالخَياله",24,"ل",2,0],["مسنداً فضل أهالي ال","فضل منهم والإنابه",25,"ب",2,0],["مَسَّنِيَ الضُّرُّ وَما لي سِوى","مَنْ يَمْنَعُ اَلجَارَ وَلا يُمْنَعُ",26,"ع",1,0],["مُسنَد تَيّار العُلوم النَخلي","وَما حَوى فَهرَست شَمس الفَضل",27,"ل",1,0],["مسنى من ذنوبى الضرّ فاكشف","يا مآبى ما بى من الضراء",28,"ا",2,0],["مسَّني الضرُّ فأين المُشتكى","إذ رأيتُ الصّدَّ مِنكَ المستداما",29,"م",2,0],["مَسَّني من طائفُ الاغراءِ شيءٌ","حينَ بانَتْ منكِ للاِغواء نيَّهْ",30,"ي",2,0],["مسن قضى حمال أثقال غيره","وكل لدى البلوى عن الحمل أحجما",31,"م",2,0],["مَسَّنِي مِنْ مُقْلَتَيكَ هَوَىً","فاعتَزَلْتُ الْعَقْلَ والعُقََلا",32,"ل",2,0],["مَسَّنِي الضُّرُّ وَاحْتَسَبْتُكَ لُبْسا","كَيْفَ أَنْسَاكَ دُلَّني كَيْفَ أنْسى",33,"س",2,1],["مسنا الضر يا عراق فعادا","وجه شر من الطغاة فعادى",34,"د",2,1],["مسّني الشعرُ فارتددتُ بصيرا","أكتبُ الآهَ أولاً وأخيرا",35,"ر",2,1],["مسّني الشعرُ كارتجافةِ وحيٍ:","عشْ فقيراً ومُتْ فقيراً فقيرا",35,"ر",2,0],["مسّني الشعرُ والدروبُ ظلامٌ","وأنا لم أزلْ بصيراً بصيرا",35,"ر",2,0],["مسني الضرُّ ابتداء واختتاماً","وابتداءً واختتاما مس أهلي",36,"ل",2,0],["مسني الضر من عوادي زمان","وقد الجمر في الضمير وأضرم",37,"م",1,0]]}