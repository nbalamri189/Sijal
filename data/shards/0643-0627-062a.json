السريع"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76027","الرجز"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93371","الخفيف"],[2799,"","https://poetry.dctabudhabi.ae/diwan/poem/121145","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94293","الرمل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58471","الخفيف"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100495","الخفيف"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109782","البسيط"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112291","المتدارك"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89258","الخفيف"],[3569,"","https://poetry.dctabudhabi.ae/diwan/poem/105758","الرمل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108337",""],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66595","الخفيف"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44733","الرمل"],[4203,"","https://poetry.dctabudhabi.ae/diwan/poem/105533","الخفيف"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45023","الرمل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83172","الخفيف"],[4456,"","https://poetry.dctabudhabi.ae/diwan/poem/203899",""],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72723","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72467","السريع"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72520","الرمل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72754","البسيط"],[4767,"مولد الانتصار","https://www.poetsgate.com/ViewPoem.aspx?id=179794",""],[5022,"البردة المالكية","https://www.poetsgate.com/ViewPoem.aspx?id=186512",""],[5061,"البدر لا غاب","https://www.poetsgate.com/ViewPoem.aspx?id=147151",""],[5104,"فاسألوا عنه غامضات المعاني","https://www.poetsgate.com/ViewPoem.aspx?id=38510",""],[5219,"أضنيت قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=193839",""],[5573,"الله وكيلي","https://www.poetsgate.com/ViewPoem.aspx?id=200181",""],[402,"لم يكد يسبق الفضاء نذير","https://www.poetsgate.com/ViewPoem.aspx?id=35702",""],[5956,"كل ما عندك لطفٌ وجَمال","https://www.poetsgate.com/ViewPoem.aspx?id=182049",""],[5956,"سندرا أمُّ الجميع","https://www.poetsgate.com/ViewPoem.aspx?id=193161",""],[6023,"قل لمن بالقريض بزَّ الفحولا","https://www.poetsgate.com/ViewPoem.aspx?id=123905",""],[6115,"كاتب الخط يفنى والقلم والدواه","https://www.poetsgate.com/ViewPoem.aspx?id=181837",""],[6124,"طَلْعُ نيلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=109746",""],[406,"كاترينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66905&r=&rc=11",""],[6268,"هذيان بائع الدموع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82917&r=&rc=3",""],[572,"نطقَ الودُّ باللّسانِ الفَصِيحِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9214&r=&rc=71",""]],"verses":[["كَاتبْتَنِي مُتَفَضِّلاً فَمَلَكْتني","لاَزِلْتُ مِنْكَ مُكَاتَباً مَمْلُوكَا",0,"ك",2,0],["كاتمتُ أشجاني وحسبِي بالبُكا","في صفحِ خدِّي للعواذِلِ كاتبا",1,"ب",2,0],["كاتبٌ يبذل النضارَ صحاحاً","ويصون الشذورَ في الأدراج",2,"ج",1,0],["كاتبٌ حاسبٌ فقد عامل الخل","لَةَ بيني وبينهُ بالحسابِ",3,"ب",1,0],["كاتبٌ ضاق باليراعة ذَرْعاً","فتعاطى القناة نزوَ السريس",4,"س",1,0],["كاتِبٌ لا بَل سَحابٌ هَتِنٌ","كَم رَوى الأَرواحَ خَمراً وَسَقى",5,"ق",2,0],["كاتب الشرق ماله من جزاء","غير صفع السقاة حين تطوف",6,"ف",1,0],["كاتِبٌ مُحسِنُ البَيانِ صَناعُه","اِستَخَفَّ العُقولَ حيناً يَراعُه",7,"ع",2,1],["كاتِبُ السِرِّ الَّذي في عَصرِهِ","سِرُّ دَستِ المُلكِ يَوماً ما فَشا",8,"ش",2,0],["كأتونٍ مسعَّرٍ","غاضبٍ ينثرُ الحُمَم",9,"م",1,0],["كاتبٌ علَّقَ قلبي","منْ عذاريهِ سطورُ",10,"ر",1,1],["كاتبُ مكْسٍ قلَّدوهُ القضا","لا زالَ في طردٍ وفي عَكْسِ",11,"س",1,1],["كاتبْتَني وأذنتَ لي بكتابةٍ","مني إليكَ لقدْ فُتنت فُتونا",12,"ن",2,1],["كات جِناناً أرضُهم معروشةً","فأصابها من جيشه إعصار",13,"ر",1,0],["كاتِبٌ أَيضاً وَما مَر","رَ عَلى رَأسِ الكِتابَه",14,"ب",2,0],["كاتَمتُهُ بَعضَ ما أَلقى وَقُلتُ لَهُ","لا أَستَطيعُ دَواعي الحُبِّ مُنقادا",15,"د",2,0],["كاتَمتُ ما أَلقى إِلى وَجهِها","حَتّى إِذا عَذَّبَني باحا",16,"ح",2,0],["كاتَمتُها أَمري وَما شَعَرَت بِهِ","وَكَذاكَ قَد كاتَمتُهُ أَصحابي",17,"ب",2,0],["كاتَبَه أَولادُه بالطاعَهْ","وبالدُّخولِ مَدْخلَ الجماعه",18,"ه",1,0],["كاتبٌ حنّتْ صَحيفتُهُ","وبكى من رَحمةٍ قلمُه",19,"م",2,0],["كاتِبُكَ المُزْدَهي بمنْطِقِه","صَهْوَة حتى يَخِرّ جَلْمَدُها",20,"د",3,0],["كَاتِبٌ نَسْجُ وَحْدِهِ وَخَطِيبٌ","مَا لَهُ فِي المُناظِرِين نَظِيرُ",21,"ر",1,0],["كاتِبٌ تلمح في أُسلوبه:","وجهَه، بل يدَه، بل أصبعَه",22,"ع",2,0],["كأت تفاريق النفوس التي مضت","شعاع مضى في هبوة متطايرا",23,"ر",2,0],["كاتَبتُمُوني بِالمَسيرِ نَحوَكُم","وَقُلتُمُ خُذ في المَسيرِ أَو دَعِ",24,"ع",1,0],["كاتباه تمتّعا منه بالقر","ب فما يكتبا الذنوب عليه",25,"ي",2,0],["كاتبٌ سوف يفوق الكاتبين","بالبيان العذب والسحر المبين",26,"ن",1,1],["كاتِبٌ حاسِبٌ خَطيبٌ بَليغٌ","ناصِحٌ زائِدٌ عَلى النُصّاحِ",27,"ح",1,0],["كاتَبتَني بِأَرَقَّ مِن","دَمع المُحب إِذا اِنسَجَم",28,"م",1,0],["كاتبٌ بالفِعْل لكن","لونُه الأسودُ قاري",29,"ر",2,0],["كاتَمتَ واشِيَكَ الهَوى قبلَ النّوى","فَبَدا له من بَعدِها كِتمانُهُ",30,"ن",2,0],["كاتبٌ تحسد الدراري حروفاً","برأتها بنانهُ من بريّ",31,"ي",1,0],["كاتمتُه أصلَ الصبابةِ جاحداً","وعلى المحبِّ دلائلٌ لا تُجحَدُ",32,"د",1,0],["كاتمتُه وجدي فعبّر ناظري","عن سرّ ما ألقاهُ من عبَراتِه",33,"ت",2,0],["كاتبتنى واداء الحق يعجزني","فلا أزال لكم قنًا مدى الحقب",34,"ب",1,0],["كاتمٌ عرفه ويظهره الإطرا","ء عنه والعرف عرفٌ نموم",35,"م",1,0],["كاتباً بالسيوف في جبهات الصيد","لم يألُ بالقنا إعجاما",36,"م",2,0],["كاتبتني شوقاً إلي وقالت","أخذ اللّه يا بُنيّ بحقي",37,"ق",2,0],["كاتِبٌ شاعِرٌ لَبِيبٌ أَرِيبٌ","فارِسٌ رَائِسٌ رَفيعُ الْعِمادِ",38,"د",1,0],["كاتب الغيب خط في لوح روح","أحرف الكائنات من فوق ذلك",39,"ك",1,0],["كاتبٌ يقطعُ السُيوفَ يَراعٌ","في يديهِ وليسَ ضَرْبٌ يَليهِ",40,"ي",2,0],["كاتبٌ بارعٌ إذا التبسَ الرأ","يُ بدا في كتابِهِ المشروحِ",41,"ح",1,0],["كاتبني محسناً بمحكمة","ذات بيان دلت على فطنه",42,"ن",2,0],["كاتمتها حتى اعترتني سَوْرَةٌ","ضلتْ تترجم في الهوى عما بي",43,"ب",2,0],["كاتَمْتُ، والحُبُّ لا يَخْفَى لكاتِمِهِ","بالدَّمْعِ يُعْرَفُ مَنْ يَهْوَى وبِالسَّقَمِ",44,"م",1,0],["كاتبني عاتباً لقولي","أورى هواه الحشا وحرر",45,"ر",1,0],["كاتب نائم وذو الشعر لاه","وأديب سبته كأس الشمول",46,"ل",1,0],["كاتبته في حاجةٍ عرضتْ لنا","فكأنّني كاتبتُ وحش القاع",47,"ع",1,0],["كاتبةٌ عظمي برَت","قلبي بها معلَّقُ",48,"ق",1,1],["كاتِبُهُ الهَجرِىُّ للأحبابِ","بَحرُ الذُنُوبِ خَادِمُ الطلابِ",49,"ب",1,0],["كاتبت من أهواه مستعذباً","لطول ما ألقاه من ظلمه",50,"م",2,1],["كاتمِ سِرٍ لَم يَفه","يَوماً بِكُم وَلا نَطَق",51,"ق",1,0],["كاتِمٌ لِلأَسرارِ عن كُلِّ واشٍ","غَير ما في الصكوك مِن أَسرارِ",52,"ر",1,0],["كاتبت عبدالواحد البدر الذي","منح العبيد حلاوة الإعتاق",53,"ق",1,0],["كاتب العليا وما وفت له","رب مال ما له تنجيم",54,"م",1,0],["كاتبٌ دونه ابنُ مقْلةَ خطاً","ليسَ يرضى قُدامةً قدامه",55,"م",2,0],["كاتبوه فجاءهم يقطع البي","داء يطوي سهولها والوعورا",56,"ر",2,0],["كاتبه قلبي المعنى","وحبره مدمعي السجام",57,"م",1,0],["كاتمتُ الدمعَ هوًى فوشا","والدمع كذلك أعهدُهُ",58,"د",2,0],["كاتبته نفوسُنا فاشتراها","لطفُه فهي ملك حر رقيق",59,"ق",1,0],["كاتبٌ من فوق فرع ال","غيمِ بالعقيانِ يكتب",60,"ب",1,0],["كاتب خاطب من الغيب مدرا","راً يراعا اجرى واجرى لسانا",61,"ن",2,0],["كاتِبٌ قَدُّهُ إِلَى الخَطِّ يُعْزَى","بارِعٌ فِي فُنُونِهِ لاَ يُبَارَى",62,"ر",2,0],["كاتبُ الإِصلاحِ فينا","زيَّنَ الماءَ بِنَقشِ",63,"ش",1,0],["كاتب قارئ بأجهر صوت","ما بلوح البسيط خط وتمتم",64,"م",1,0],["كاتب في صحيفة الأرض سط","رين طويلين كل سطر منمنم",64,"م",1,0],["كاتِبُ المَغرِب مِن غَيرِ خلاف","وَلِسانُ الدَولَة الصلت الفَصيح",65,"ح",1,0],["كاتِبٌ كُلُّهُ وَفاءٌ وَوُدُّ","مَلَكٌ في مَظاهِر الإِنس يَبدُو",66,"د",2,1],["كاتب يمناه مثل حالي","ومثله كاتب الشمال",67,"ل",1,0],["كاتب السر سابقا كان في الزو","را وزيرا وفي العراق مشيرا",68,"ر",2,1],["كاتبه الحبر بتحبيره","قال لأقلام العلا ليقوا",69,"ق",3,0],["كاتب انشاؤه السحر المبين","كشرو فضلش بودز يرنكين",70,"ن",1,0],["كاتب سر غداة يملي","يراعه ما له صرير",71,"ر",1,0],["كاتبني حيث صرت رقا","وهو بحريتي خبير",71,"ر",1,0],["كاتماً آياتِ حقٍّ كم تجَلَّتْ","واهتدى من نورها من كان غافل",72,"ل",1,0],["كاتمتهم فانبرى آس ليفضحني","(فقال إني سقيم) بين السقم",73,"م",1,0],["كاتمٍ سري ولا