{"poems":[[77,"يا من تقلد للعلاء سلوكا","https://www.aldiwan.net/poem36383.html","الكامل"],[72,"عطفت كأمثال القسي حواجبا","https://www.aldiwan.net/poem18230.html","الكامل"],[72,"كم عذول على هواك أداجي","https://www.aldiwan.net/poem18451.html","الخفيف"],[51,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[51,"راع قلبي مشيب رأس خليس","https://www.aldiwan.net/poem64653.html","الخفيف"],[91,"امنحيني يا نجوم الألقا","https://www.aldiwan.net/poem9047.html","عموديه"],[85,"أرقصوه بقولهم فيلسوف","https://www.aldiwan.net/poem7563.html","الخفيف"],[85,"كاتب محسن البيان صناعه","https://www.aldiwan.net/poem62841.html","الخفيف"],[66,"كرر اللوم عليه إن تشا","https://www.aldiwan.net/poem40645.html","الرمل"],[97,"موقفٌ حانَ فاغتنم","https://www.aldiwan.net/poem24754.html","مجزوء الخفيف"],[69,"كاتب علق قلبي","https://www.aldiwan.net/poem28300.html","مجزوء الرمل"],[69,"كاتب مكس قلدوه القضا","https://www.aldiwan.net/poem28986.html","السريع"],[69,"كاتبتني وأذنت لي بكتابة","https://www.aldiwan.net/poem29238.html","الكامل"],[75,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[48,"قد علا الديوان كابه","https://www.aldiwan.net/poem62436.html","مجزوء الرمل"],[50,"يا ليلتي لم أنم شوقا وتسهادا","https://www.aldiwan.net/poem63896.html","البسيط"],[50,"أنى دعاه الشوق فارتاحا","https://www.aldiwan.net/poem63965.html","السريع"],[50,"أأرقت بعد رقادك الأواب","https://www.aldiwan.net/poem64844.html","الكامل"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[76,"من محب شفه سقمه","https://www.aldiwan.net/poem38991.html","المديد"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16625","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54920","الخفيف"],[106,"فيلسوف الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=179354",""],[105,"أعدوا لأعلام البيان المنابرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55073&r=&rc=243",""],[169,"يا باكياً لدمنة وأربع","https://www.aldiwan.net/poem1635.html",""],[186,"بنفسي شادن أحسن الله له","https://www.aldiwan.net/poem43181.html","الخفيف"],[211,"كاتب سوف يفوق الكاتبين","https://www.aldiwan.net/poem46288.html","الرمل"],[269,"أَنا من بغية الأَمير","https://www.aldiwan.net/poem26456.html","الخفيف"],[380,"يا من مواطر فضله","https://www.aldiwan.net/poem48775.html","مجزوء الكامل"],[402,"يا أخا السؤدد والمجد","https://www.aldiwan.net/poem46508.html","مجزوء الرمل"],[409,"أعلمت ما فعلت به أجفانه","https://www.aldiwan.net/poem32364.html","الكامل"],[429,"من مجيري من قده السمهري","https://www.aldiwan.net/poem40092.html","الخفيف"],[432,"ماست فقيل هي القضيب الأملد","https://www.aldiwan.net/poem12594.html","الكامل"],[432,"لولا ظبى تنسل من لحظاته","https://www.aldiwan.net/poem12779.html","الكامل"],[448,"لما علمت بما ألقى من الوصب","https://www.aldiwan.net/poem53774.html","الطويل"],[464,"ولهي في الهوى حديث قديم","https://www.aldiwan.net/poem3279.html","عموديه"],[464,"إن حجبتم أشباحكم والمناما","https://www.aldiwan.net/poem3525.html","عموديه"],[495,"وعجوز كأنها قوس لام","https://www.aldiwan.net/poem10248.html","الخفيف"],[529,"دمت رب الإصدار والإيراد","https://www.aldiwan.net/poem37449.html","الخفيف"],[558,"كل شيء كما أتى النص هالك","https://www.aldiwan.net/poem33538.html","الخفيف"],[562,"لا تلوميه في الهوى واعذريه","https://www.aldiwan.net/poem52968.html","الخفيف"],[567,"نطق الود باللسان الفصيح","https://www.aldiwan.net/poem69741.html","الخفيف"]],"verses":[["كَاتبْتَنِي مُتَفَضِّلاً فَمَلَكْتني","لاَزِلْتُ مِنْكَ مُكَاتَباً مَمْلُوكَا",0,"ك",2,0],["كاتمتُ أشجاني وحسبِي بالبُكا","في صفحِ خدِّي للعواذِلِ كاتبا",1,"ب",2,0],["كاتبٌ يبذل النضارَ صحاحاً","ويصون الشذورَ في الأدراج",2,"ج",1,0],["كاتبٌ حاسبٌ فقد عامل الخل","لَةَ بيني وبينهُ بالحسابِ",3,"ب",1,0],["كاتبٌ ضاق باليراعة ذَرْعاً","فتعاطى القناة نزوَ السريس",4,"س",1,0],["كاتِبٌ لا بَل سَحابٌ هَتِنٌ","كَم رَوى الأَرواحَ خَمراً وَسَقى",5,"ق",2,0],["كاتب الشرق ماله من جزاء","غير صفع السقاة حين تطوف",6,"ف",1,0],["كاتِبٌ مُحسِنُ البَيانِ صَناعُه","اِستَخَفَّ العُقولَ حيناً يَراعُه",7,"ع",2,1],["كاتِبُ السِرِّ الَّذي في عَصرِهِ","سِرُّ دَستِ المُلكِ يَوماً ما فَشا",8,"ش",2,0],["كأتونٍ مسعَّرٍ","غاضبٍ ينثرُ الحُمَم",9,"م",1,0],["كاتبٌ علَّقَ قلبي","منْ عذاريهِ سطورُ",10,"ر",1,1],["كاتبُ مكْسٍ قلَّدوهُ القضا","لا زالَ في طردٍ وفي عَكْسِ",11,"س",1,1],["كاتبْتَني وأذنتَ لي بكتابةٍ","مني إليكَ لقدْ فُتنت فُتونا",12,"ن",2,1],["كات جِناناً أرضُهم معروشةً","فأصابها من جيشه إعصار",13,"ر",1,0],["كاتِبٌ أَيضاً وَما مَر","رَ عَلى رَأسِ الكِتابَه",14,"ب",2,0],["كاتَمتُهُ بَعضَ ما أَلقى وَقُلتُ لَهُ","لا أَستَطيعُ دَواعي الحُبِّ مُنقادا",15,"د",2,0],["كاتَمتُ ما أَلقى إِلى وَجهِها","حَتّى إِذا عَذَّبَني باحا",16,"ح",2,0],["كاتَمتُها أَمري وَما شَعَرَت بِهِ","وَكَذاكَ قَد كاتَمتُهُ أَصحابي",17,"ي",1,0],["كاتَبَه أَولادُه بالطاعَهْ","وبالدُّخولِ مَدْخلَ الجماعه",18,"ه",1,0],["كاتبٌ حنّتْ صَحيفتُهُ","وبكى من رَحمةٍ قلمُه",19,"م",2,0],["كاتِبُكَ المُزْدَهي بمنْطِقِه","صَهْوَة حتى يَخِرّ جَلْمَدُها",20,"د",3,0],["كَاتِبٌ نَسْجُ وَحْدِهِ وَخَطِيبٌ","مَا لَهُ فِي المُناظِرِين نَظِيرُ",21,"ر",1,0],["كاتِبٌ تلمح في أُسلوبه:","وجهَه، بل يدَه، بل أصبعَه",22,"ع",2,0],["كأت تفاريق النفوس التي مضت","شعاع مضى في هبوة متطايرا",23,"ر",2,0],["كاتَبتُمُوني بِالمَسيرِ نَحوَكُم","وَقُلتُمُ خُذ في المَسيرِ أَو دَعِ",24,"ع",1,0],["كاتباه تمتّعا منه بالقر","ب فما يكتبا الذنوب عليه",25,"ي",2,0],["كاتبٌ سوف يفوق الكاتبين","بالبيان العذب والسحر المبين",26,"ن",1,1],["كاتِبٌ حاسِبٌ خَطيبٌ بَليغٌ","ناصِحٌ زائِدٌ عَلى النُصّاحِ",27,"ح",1,0],["كاتَبتَني بِأَرَقَّ مِن","دَمع المُحب إِذا اِنسَجَم",28,"م",1,0],["كاتبٌ بالفِعْل لكن","لونُه الأسودُ قاري",29,"ر",2,0],["كاتَمتَ واشِيَكَ الهَوى قبلَ النّوى","فَبَدا له من بَعدِها كِتمانُهُ",30,"ن",2,0],["كاتبٌ تحسد الدراري حروفاً","برأتها بنانهُ من بريّ",31,"ي",1,0],["كاتمتُه أصلَ الصبابةِ جاحداً","وعلى المحبِّ دلائلٌ لا تُجحَدُ",32,"د",1,0],["كاتمتُه وجدي فعبّر ناظري","عن سرّ ما ألقاهُ من عبَراتِه",33,"ت",2,0],["كاتبتنى واداء الحق يعجزني","فلا أزال لكم قنًا مدى الحقب",34,"ب",1,0],["كاتمٌ عرفه ويظهره الإطرا","ء عنه والعرف عرفٌ نموم",35,"م",1,0],["كاتباً بالسيوف في جبهات الصيد","لم يألُ بالقنا إعجاما",36,"م",2,0],["كاتبتني شوقاً إلي وقالت","أخذ اللّه يا بُنيّ بحقي",37,"ي",1,0],["كاتِبٌ شاعِرٌ لَبِيبٌ أَرِيبٌ","فارِسٌ رَائِسٌ رَفيعُ الْعِمادِ",38,"د",1,0],["كاتب الغيب خط في لوح روح","أحرف الكائنات من فوق ذلك",39,"ك",1,0],["كاتبٌ يقطعُ السُيوفَ يَراعٌ","في يديهِ وليسَ ضَرْبٌ يَليهِ",40,"ي",2,0],["كاتبٌ بارعٌ إذا التبسَ الرأ","يُ بدا في كتابِهِ المشروحِ",41,"ح",1,0]]}