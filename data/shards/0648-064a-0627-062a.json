ewPoem.aspx?id=22197",""],[4929,"حرٌّ في زمن العبيد الجزء (2) ( حوار)","https://www.poetsgate.com/ViewPoem.aspx?id=204919",""],[5005,"حُلمٌ في الضّجيج..","https://www.poetsgate.com/ViewPoem.aspx?id=190155",""],[5092,"تيه","https://www.poetsgate.com/ViewPoem.aspx?id=139892",""],[5100,"عزف ملكي","https://www.poetsgate.com/ViewPoem.aspx?id=207710",""],[5102,"المعلم رمز الصمود","https://www.poetsgate.com/ViewPoem.aspx?id=12869",""],[5122,"(( الشعر ))","https://www.poetsgate.com/ViewPoem.aspx?id=23975",""],[5136,"أعاتبه وهو المليك المكرم","https://www.poetsgate.com/ViewPoem.aspx?id=121663",""],[5147,"أضر بجسمي عرق النسا","https://www.poetsgate.com/ViewPoem.aspx?id=166690",""],[5183,"بَْينَ الْشَّهْدِ وَالْشَّهَادَة","https://www.poetsgate.com/ViewPoem.aspx?id=186463",""],[5183,"الدّعَاءُ الأول","https://www.poetsgate.com/ViewPoem.aspx?id=185884",""],[5183,"الخال","https://www.poetsgate.com/ViewPoem.aspx?id=186611",""],[5277,"المغاضبة","https://www.poetsgate.com/ViewPoem.aspx?id=191930",""],[592,"ألا قل لذي جهلٍ بكل الحقائق","https://www.poetsgate.com/ViewPoem.aspx?id=128798",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5419,"هي في عيني","https://www.poetsgate.com/ViewPoem.aspx?id=31459",""],[5419,"ذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=32275",""],[5431,"لعمرك إنّ الحب راحٌ ومبهجُ","https://www.poetsgate.com/ViewPoem.aspx?id=189966",""],[5431,"حديث بيني وبين قيس ابن الملوح","https://www.poetsgate.com/ViewPoem.aspx?id=191885",""],[5605,"مرثية حنان الآغا","https://www.poetsgate.com/ViewPoem.aspx?id=159625",""],[5638,"قيدي يحدثني","https://www.poetsgate.com/ViewPoem.aspx?id=198120",""],[1680,"أتطلب أن تكون كثير مال","https://www.poetsgate.com/ViewPoem.aspx?id=108878",""],[5686,"دروب الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=203361",""],[5691,"تدور بنا الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=206080",""],[5839,"السهاد","https://www.poetsgate.com/ViewPoem.aspx?id=62050",""],[5953,"لاح ضياء القمر الزاهر","https://www.poetsgate.com/ViewPoem.aspx?id=93849",""],[5956,"الخرير وراحة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=183160",""],[5956,"نريد الرجوع","https://www.poetsgate.com/ViewPoem.aspx?id=192335",""],[5957,"حكايات (المسنجر)","https://www.poetsgate.com/ViewPoem.aspx?id=46453",""],[6070,"أتيتُ إلى النُّجومِ معَ التَّحيّةْ","https://www.poetsgate.com/ViewPoem.aspx?id=189731",""],[6100,"قلب المولع","https://www.poetsgate.com/ViewPoem.aspx?id=52594",""],[6124,"الرسالة","https://www.poetsgate.com/ViewPoem.aspx?id=103197",""],[6262,"صديقي الوطن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80127&r=&rc=25",""],[6305,"خُذِي قلَمِي ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87345&r=&rc=18",""],[6315,"بيروت وأحاديث العرَّاف ... قراءة لأقداح الأنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87583&r=&rc=8",""]],"verses":[["ويا تعس غاو أرجعته لرشده","طباعٌ لفظ كلما رق جانبه",0,"ب",2,0],["وَيأَتيك أَحياناً عِتابي وَرُبمّا","يَروضُ أَبيَّ الوُدِّ مِنكَ عِتابُ",1,"ب",1,0],["وَيَأتي المَوتُ طِفلاً في مُهودٍ","وَيَلقى حَتفَهُ قَبلَ الفِطامِ",2,"م",1,0],["ويا تجاراً بما أتوا من","روائع الفضل شرفونا",3,"ن",2,0],["وَيَأْتِي النَّصْرُ وَفْقَ مُنَى","تَمَنِّيهَا فَيُرْضِيهَا",4,"ي",3,0],["وَيَأْتَلِفُ الذَّرُّ وَهْوَ خَفِيٌّ","فَيَمْثلُ فِي الصُّوَرِ الظَّاهِرَهْ",5,"ر",2,0],["ويأْتَمُّ بالأيامِ وهْي ذميمةٌ","فينْسَى الذي تُقْصي ويَرْعَى الذي تُدْني",6,"ن",2,0],["ويأتي للفتى يومٌ فيومٌ","وما يأتي لهُ يأتي عليه",7,"ه",1,0],["وَيَأتيكُمُ ما عِشتُ يا آلَ كامِلٍ","سَلامي عَليكُم دائِماً وَسُؤالي",8,"ل",2,0],["وَيَأتيها الَّذي لا يَجتَويها","إِذا قُصِرَ السُتورُ عَلى الدُخانِ",9,"ن",1,0],["ويأتمر الظلام عليَّ حتى","كأني هابط أعماق غارِ",10,"ر",1,0],["وَيَأتي مِنَ الهِجرانِ زَلَّةُ مُدنَفٍ","فَأُعمِلُ في السُلوانِ فِكرَةَ عازِمِ",11,"م",1,1],["ويأتي على أعيُنِ الحاسدينَ","إذا سألوا مَن فتىً قيل ذا",12,"ا",1,0],["وَيا تَعالي عُقاراً قَرقَفاً رَقَصَت","عِندَ المِزاجِ بِطاساتٍ وَأَقداحِ",13,"ح",1,0],["وَيَأتي الفَتى رِزقُهُ وادِعاً","وَلَو كانَ في النيقِ عِندَ الفُدُر",14,"ر",1,0],["وَيَأتيكَ بِالأَخبارِ مَن لَم تَبِع لَهُ","بَتاتاً وَلَم تَضرِب لَهُ وَقتَ مَوعِدِ",15,"د",1,0],["ويَأتِيكُمْ لَنَا سَرعَانُ خَيْلٍ","يُغَادِرُ خَلْفَهُ جمعاً كَثيفَا",16,"ف",2,0],["ويا تمهيد سيدنا الخليلي","تمهد ان تعيش بلا خدين",17,"ن",1,0],["ويأتدم العداء لحمي مهنئا","وما مرئت للصائدين الضراغم",18,"م",1,0],["ويأتي الفتى يوم فيومٌ","وما ياتي لهُ يأتي عليه",19,"ه",1,0],["ويأتي ذليلا خاضعا مثلما الذي","حواليه اسد الغاب في البر تزأر",20,"ر",1,0],["وَيَأتي بي فَيَطرَحُني عَلَيها","فَأوقِظُها وَقَد قُضِيَ القَضاءُ",21,"ا",2,0],["ويأتمن الحليم عليه غفلا","بليدا وهو محبوب نفيس",22,"س",1,0],["ويأتي ما يغطي كل هذا","أمور في عواقبها أمور",23,"ر",1,0],["ويأتي الليل عن جزع وخوف","بحدّ السيف والسلب المبيد",24,"د",1,0],["ويأتيك من صاحب مبغض","ومن وامق كان ينوي البعادا",25,"د",2,0],["ويأتي الليل عن فزع شديد","بخوف القتل والسلب المبيد",26,"د",1,0],["ويأتي إلى الهيجاء أصلعَ حاسراً","تُدَرِّعه منها القواضِبُ والسُّمرُ",27,"ر",1,0],["ويأتي النّدامى والعُقَارُ بكفِّهِ","ومفتضحٌ من نَشْرِها المَنْدلُ الرَّطبُ",28,"ب",1,0],["وَيا تُربةً حلَّ فيها الأَمينُ","لأَنتِ الفَراديسُ أَو أَخصَبُ",29,"ب",1,0],["ويأْتي من الحِرْصِ أن رُبّما","نقَضْتَ أُموراً وأَبرَمْتَ أُخرى",30,"ر",2,0],["ويأتي الفتح من فتاح","فضلا بل كسب أو مفتاح",31,"ح",1,0],["ويا تارك الخمرِ لا تأتِهِ","فإنّ خلائقَه تُسكِرُ",32,"ر",1,0],["ويأتي بأمرٍ لا أطيقُ وأُصدمُ","فكيدُ الحظوظ لا أبالكَ يُندِمُ",33,"م",1,0],["ويأتيكم على بعدي وقربي","سلام الله من قلب سليم",34,"م",1,0],["ويا تربَه قد صرت مِسكاً بطيبِهِ","فلا زائر إِلاَّ بمسكك معْطَارُ",35,"ر",1,0],["ويأْتي الزَّمانُ بما قَدْ أَرادَ","ويَقْضي القضاءُ بما قَد قَضَى",36,"ض",2,0],["ويأْتُونَ بالأَشْعارِ يَبهَرُ حُسْنُها","ولكِنَّها موجودَةٌ في الدَّفَاتِر",37,"ر",1,0],["وَيَا تِلْكَ اللِّحَاظِ أَرَى عَجيباً","سِهاماً كُلَّما كُسِرَتْ تُصِيبُ",38,"ب",1,0],["وَيا تِلْكَ المعاطِفِ خَبِّرِينَا","مَتَى يَتعطَّفُ الغُصْنُ الرَّطيبُ",38,"ب",1,0],["ويأتيكَ غيري مِن بلادٍ قريبةٍ","له الأمنُ فيها صاحبٌ لا يجانِبُه",39,"ب",2,0],["ويأتي الخَتَنُ الأوَّ","لُ مثلَ الأسدِ المقعي",40,"ع",2,0],["وَيَأتيَ سُلطانَ الكواكِب بَعدَهُ","وَمِن ضَوئِه كلُّ الكَواكِبِ قَد يخفى",41,"ف",2,0],["ويا تفرسنا في فارس كرُمت","منك السجايا فوال الفضل والكرما",42,"م",2,0],["ويأتي لها البدر مستمسكاً","بأعطارها وبأستارها",43,"ر",3,0],["ويا تواب يا وهاب وفق","فقد خط المشيب دجى عذاري",44,"ر",2,0],["ويأتي لساق العرش يسجد تحته","ويبسط للرحمن راح خاشع",45,"ع",1,0],["ويأتي لساق العرش يسجد تحته","ويبدأ بالتحميد شكرا ويختم",46,"م",1,0],["ويا تلكَ اللئيلات المَواضي","أَلا عودي لنا بالوصلِ عودي",47,"د",2,0],["ويأتي بعده شعبان شَهْر النب","ي الطاهر الطهر الكريم",48,"م",1,0],["ويأتيك إن شاء الكريم الذي به","تدل على المولى بحسن الادلة",49,"ه",1,0],["وَيا تارِكاً للأمر وَهُوَ فَريضة","وَيا فاعِلاً للنهي وَهو محرم",50,"م",1,0],["ويا تقيا على الإحسان منطويا","أكثر فأنت بحبل اللّه موصول",51,"ل",1,0],["ويأتي بشير منكم فأضمه","وأشركه في مهجتي وأبيح",52,"ح",1,0],["ويا ترى بالفراق","من بعد ما شمت",53,"ت",1,0],["ويا تُرجمانَ الذكر غيرَ مشارَكٍ","فكلُّ امتدادٍ غيرُ مدك قاصرُ",54,"ر",1,0],["ويأتي على ما يأتي للفصلِ والقضا","وقد كان قبلَ الخلقِِ في ذلك العينِ",55,"ن",1,0],["ويأتيِه وفد الخير من كل وُجهةٍ","سِراعاً وبالتوفيق يَشتدُّ أزرهُ",56,"ر",2,0],["ويأتي بما قد قلت فيه مؤرخاً","بشمس العلا بدر الجمال تأهلا",57,"ل",2,0],["ويأتي الأباة محل الذين","أضاعوا الكرامة استسلموا",58,"م",3,0],["ويأتيكم منه جواب سريرةٍ","فصحت به سبل العلوم لسارب",59,"ب",1,0],["ويأتي الزامُ لَهُ يتابع","قيام أولِ النَّعشِ فَوقَ الرابع",60,"ع",1,0],["وَيَأتي مِن النَظمِ البَديعِ بِمُعجزٍ","يَطيحُ لَدَيهِ نَظم كُلِّ مُخرِّقِ",61,"ق",1,0],["وَيَأتي رَسولُ اللَهِ مِلقَبرِ يَقظَةً","إِلَيهِ فَيُثنى بِالمعارِفِ وَالفَضلِ",62,"ل",1,0],["ويا ترى هل أرى وادي العقيق وهل","يبدو لعيني نخيلات البساتين",63,"ن",1,0],["ويأتيني الألى شابوا وخابوا","كأني صرتُ مأوى العاجزينا",64,"ن",2,0],["ويأتي الى عالم النفس حقا","وقد حمد الورد بعد الصدر",65,"ر",1,0],["ويأتيك أيلول من بعده","بأيام علّان من بعد آب",66,"ب",1,0],["وَيَا تَلَهُّبَ قَلْبِي فِي مَحَاسِنِهِ","قَدْ أُعْجِزَ الدَّمْعُ أَنْ يُطْفِيكَ فَاتَّقِدِ",67,"د",1,0],["ويأتون مع بعض على الغين باطلاً","فأحوالهم مقتٌ وظلم وعدوان",68,"ن",1,0],["ويأتون للقاضي فيحكم أنها","لمن كان منه بالدراهم إحسان",68,"ن",1,0],["ويأتي لديس في سباخٍ مصلياً","صلاةً تنافيها شروط وأركان",68,"ن",1,0],["وَيا تارِكاً عرب المَشارق عبرة","وَيا مرعباً بِالأَخذ أَهل المَغارب",69,"ب",1,0],["وَيَأتيني البُكا عَفواً","وَيعصيني البُكا لَمّا",70,"م",2,0],["ويا توّابُ فاقضينَّ حاجتي","وكثِّرنْ ثوابي مع مثوبتي",71,"ي",1,0],["وَيأَتي أَخاهُ مُستَظِلاًّ بِتُرسِهِ","كَطِفلٍ لِحُجرِ الأُمِّ أَبدَى حَنِينهُ",72,"ه",1,0],["ويأتى غدا والرسل تحت لوائه","فيفتح من باب الشفاعة مغلقا",73,"ق",2,0],["وَيَأتي بِما أوتي من الطَير شاكِراً","وَلَو كانَ عُصفوراً وَبَعض بَلابِلِ",74,"ل",1,0],["ويأتي الشباب بآماله","فتيا يعانق ريحانتي",75,"ت",2,0],["ويَأتِي على رُغمِ مَن لِلأَذَى","أَعَانُوا, وخانُوا, وهانُوا......إِلَخ.",76,"خ",1,0],["ويأتي بأحزابهِ بَعدَ أنْ","يُؤاخِيَ ثُوَّارُهُ عَسْكَرَه",77,"ر",2,0],["ويأتي بعدهم فرحاً (حسينٌ)","على صدري يميل إذا رآنا",78,"ن",2,0],["ويأتيهم (محمد) فوق مُهرٍ","ويطلق يا له منه العنانا",78,"ن",2,0],["ويأتي بكلّ عاهرةٍ","لكي تُحيي لياليها",79,"ا",1,0],["ويأتي عن العبدِ الكبير مفاوضٌ","بمنحِكَ نعتاً في القطيع له قَدرُ",80,"ر",1,1],["ويا تلك الذئابُ بأيّ عُرْفٍ","أراكم ترتعونَ مع الوُعول؟",81,"ل",1,0],["ويأتي الليلُ يفرشُ ذكرياتِهْ","على حلمٍ يداعبُ أمنياتِهْ",82,"ت",2,1],["ويا توأمَ الروحِ أنتِ مداري","ومركزُ كوني وما أشتهيهِ",83,"ي",2,0],["ويأتي المفتش بعد المديرِ","يُنقِّب عن هفوةٍ في جهودْ",84,"د",1,0],["وياتيلها بشهود عدل وبراهين","وتعاهده ماعاد تخلف وعوده",85,"د",2,0],["ويأتلق النادي بسحر سنانه","كأن سناه في دجى الحظ",86,"ظ",1,0],["ويأتي على هيكلي حاملا","لرجلي جميع صنوف البلى",87,"ا",1,0],["ويأتيها وللدنيا حُداء","يكاد يحهد للاجبال هدا",88,"د",2,0],["ويأتلي أن اجتلاء شخصه","لمقلة الدهر رؤىً من أجل",89,"ل",1,0],["ويا ترى مَن أمير الحسن ليس سوى","حقيقة الحسن حيث الحجب والحجب",90,"ب",1,0],["ويا تفتّحَ أزهاري إذا مطرت","من فوقها الغيمُ تهمي.. فصلَ نيسانِ",91,"ن",1,0],["ويأتي بتسليم على خير مرسل","كما هو منصوص أهل الحقائق",92,"ق",1,0],["ويأتي مولداً وضعوه جهراً","وجهلاً وابتداعاً للضلال",93,"ل",1,0],["ويأتي به بغياً وظلماً وفرية","تؤيد أحزاب الضلالة جحافله",94,"ل",2,0],["ويأتي من نجوم الليل نجمٌ","يرِقّ.. وحالُ قلبي مزقتْه",95,"ت",2,0],["ويأتي البينُ يطرحنا بعيداً","فلا يبقى لنا غير الصديقِ",96,"ق",1,0],["ويأتي على غابات وجدٍ بناره","مليكا على سُحْب الغرام يُتوّجُ",97,"ج",1,0],["ويأتي إلى زيتٍ يفورُ تأججاً","فيقْربُ من ظهر الحبيب ويسكبُ",98,"ب",1,0],["وَ(يَأْتِي المَوْت من بَحْرٍ) وَحبْرٍ","وَدُنيَانَا (انْتِظَارٌ) وَافتِتَانُ",99,"ن",1,0],["وَيَأْتِي أُمَّةَ الإِسْلا","مِ مِنْ أَيْدِيكُمُ الْفَجْرُ",100,"ر",1,0],["ويأتيك الغنى وترى سعيداً","مهاباً مكرماً من كل وال",101,"ل",1,0],["ويأتلقُ الشوقُ من وجهها","يحثُ الخطى مسرعا في عجلْ",102,"ل",1,0],["ويأتي خَريفُ العُمْرِ إثْرَ رَبيعِهِ","فيَأتي على نَسْغِ النَّضارَةِ أصْفَرُهْ",103,"ر",2,0],["ويأتي بالمواجعِ منْ سحيقٍ","بعيدِ النّجمِ منطفئِ البريقِ",104,"ق",1,0],["ويأتنا من مطلع الشمس في","وقت الضحى صرخة مستأثر",105,"ر",1,0],["ويأتيك النسيم بفصل حَرٍّ","وإنْ عزَّ الدَّوا أنت اخترعْهُ",106,"ع",2,0],["ويأتي البكورُ وما من رجوعٍ","نقول مساءً يتمّ العبورْ",107,"ر",1,0],["ويأتيها صباحا في هيامٍ","وأن القلب يا عيني تضجّرْ",108,"ر",1,0],["ويأتي العِلْمُ مِفتاحاً لِعَقلٍ","ويبقى العقْلُ هوْ رأسُ القَضيّةْ",109,"ي",2,0],["وياتارك ٍ قلب الاسيمر على ماش","اليا متى وانا على صدك آعيش",110,"ش",1,0],["ويأتي بساطُ الرّيحِ يَحمِلُني على","رُخاءٍ أُناجي وصلَ زهرةَ صبرها",111,"ر",3,0],["ويأتي ولم يأتِ يشعلُ حولي","طقوسَ هوى وقلوباً شهيده",112,"د",2,0],["ويأتي السالبونَ حياةَ شعبٍ","إليكِ فيُنزلونَ بكِ المُصابا",113,"ب",2,0],["ويأتيكَ من بيروت جرحان .. ماثِلٌ","وسارٍ مع الأحلام في فَلَك الشِّعْرى",114,"ر",2,0]]}