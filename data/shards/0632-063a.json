{"poems":[[95,"يا رئيسي وأوليائي وآلي","https://www.aldiwan.net/poem11467.html","الخفيف"],[51,"إن الفناء من البقاء قريب","https://www.aldiwan.net/poem10333.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39664","الكامل"],[92,"على سعد","https://www.poetsgate.com/ViewPoem.aspx?id=179079",""],[131,"عجبت أمامة إذ رأتني شاحبا","https://www.aldiwan.net/poem24207.html","الكامل"],[1173,"","https://poetry.dctabudhabi.ae/diwan/poem/20958","الرمل"]],"verses":[["زَغْرَدَاتُ الرَّضَاعِ هَيْهَاتَ أَنْ","تُنْسَى وَلَحْنُ الوَدَاعِ يَوْمَ الفِصَالِ",0,"ل",1,0],["زُغ كَيفَ شِئتَ عَنِ البِلى فَلَهُ عَلى","كُلَّ اِبنِ أُنثى حافِظٌ وَرَقيبُ",1,"ب",1,0],["زُغْبٌ صِغارٌ مثل أفراخ القَطَا","وحرائرٌ بِتنَ السنين سُهادا",2,"د",2,0],["\" زغلول \" ضميّه إلى آبائه","\" وفؤاد مصرَ ضعيه في أحشاك \"",3,"ك",1,0],["زَغَفٌ مُضاعفةٌ تَخَيَّرَ سَرْدَها","ذو فائشٍ وبنو المُرارِ وتُبَّعُ",4,"ع",1,0],["زَغرَبيٌّ مُستَعزٌّ بَحرُهُ","لَيسَ لِلماهِرِ فيهِ مُطَّلَع",5,"ع",1,0]]}