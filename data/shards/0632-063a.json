{"poems":[[95,"يا رئيسي وأوليائي وآلي","https://www.aldiwan.net/poem11467.html","الخفيف"],[51,"إن الفناء من البقاء قريب","https://www.aldiwan.net/poem10333.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39664","الكامل"],[92,"على سعد","https://www.poetsgate.com/ViewPoem.aspx?id=179079",""],[131,"عجبت أمامة إذ رأتني شاحبا","https://www.aldiwan.net/poem24207.html","الكامل"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203780",""],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25319","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64576","الرجز"],[1653,"","https://poetry.dctabudhabi.ae/diwan/poem/32558","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74061","السريع"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136937",""],[4530,"","https://poetry.dctabudhabi.ae/diwan/poem/20958","الرمل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204315","الطويل"],[5414,"لحن الوفاء …","https://www.poetsgate.com/ViewPoem.aspx?id=180859",""],[5558,"لنْ نَرى مِثلَ رُقِيِّ الشُّهَداءِ","https://www.poetsgate.com/ViewPoem.aspx?id=211876",""],[5883,"جند حماس","https://www.poetsgate.com/ViewPoem.aspx?id=23878",""],[6006,"قيامة","https://www.poetsgate.com/ViewPoem.aspx?id=214147",""]],"verses":[["زَغْرَدَاتُ الرَّضَاعِ هَيْهَاتَ أَنْ","تُنْسَى وَلَحْنُ الوَدَاعِ يَوْمَ الفِصَالِ",0,"ل",1,0],["زُغ كَيفَ شِئتَ عَنِ البِلى فَلَهُ عَلى","كُلَّ اِبنِ أُنثى حافِظٌ وَرَقيبُ",1,"ب",1,0],["زُغْبٌ صِغارٌ مثل أفراخ القَطَا","وحرائرٌ بِتنَ السنين سُهادا",2,"د",2,0],["\" زغلول \" ضميّه إلى آبائه","\" وفؤاد مصرَ ضعيه في أحشاك \"",3,"ك",1,0],["زَغَفٌ مُضاعفةٌ تَخَيَّرَ سَرْدَها","ذو فائشٍ وبنو المُرارِ وتُبَّعُ",4,"ع",1,0],["زغبُ الحواصل لو رأَيتهمُ","والشامتون بسعيهم كُثْر",5,"ر",1,0],["زُغْباً بِمُلْقىً عِنْدَ قَيْضِ المُحِّ","قَطَعْتُهُ وَالآلُ جارِي السَبْحِ",6,"ح",1,0],["زغت على علم عن المحجه","غرقت من خطيئتي في لجه",7,"ه",1,0],["زُغبُ الرُؤوسِ قَرِعَت هاماتُهُم","مِنَ البَلا وَاِستَكَّ مِنهُم سَمعُهُم",8,"م",1,0],["زغلول من وطّدَ ركنَ العلا","ومن بَنى المجدَ ومن شادا",9,"د",2,0],["زُغبُ الجوانح ليس فيهم طائرٌ","إِن يرمِهم متصيّدٌ غضبان",10,"ن",1,0],["زَغرَبيٌّ مُستَعزٌّ بَحرُهُ","لَيسَ لِلماهِرِ فيهِ مُطَّلَع",11,"ع",1,0],["زغب من الأطفال أبناء منزل","شوارد عنه كالقطا المتمزق",12,"ق",1,0],["زغردي ، واسعدي فإن الأماني","أصبحت واقعا جميل السمات",13,"ت",1,0],["زَغْرَداتٌ من طيورٍ عُظَماءٍ","سَقَتِ الكونَ بحُبٍّ وصَفاءِ",14,"ا",2,0],["زغرد الرشاش ينبي أننا","قد حللنا ، ساء صبح المنذرين",15,"ن",1,0],["زغردت عشقا في ركاب غمامة","ترتجي لقياها ودفء التداني",16,"ن",2,0]]}