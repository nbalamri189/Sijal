{"poems":[[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137464",""],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86331","الوافر"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[4792,"جَمالٌ ينحتُ القصيدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86320&r=&rc=2",""]],"verses":[["بحذف المبتدا فاسم غدا","لعظيم كان قدما في الجدود",0,"د",1,0],["بِحَذف القَلبِ وَالتَضعيفِ مِنهُ","نَراهُ قَمقماً عِندَ الاِنام",1,"م",1,0],["بِحَذفِها وَفِّرهُ بَعدُ وَاحظُلاَ","تَرخِيمَ ما مِن هَذِهِ الهَا قَد خَلاَ",2,"ل",2,0],["بحذفٍ وتدويرٍ وجزْرٍ مرقرِقٍ","وصَبٍّ وتمديدٍ ومدٍّ يحاصرُ",3,"ر",1,0]]}