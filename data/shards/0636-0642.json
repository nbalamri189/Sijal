{"poems":[[88,"هي عيني ودمعها نضاح","https://www.aldiwan.net/poem44461.html","الخفيف"],[85,"مال واحتجب","https://www.aldiwan.net/poem63725.html","مجزوء المتدارك"],[97,"كيف أنسى زمناً كنت به","https://www.aldiwan.net/poem24981.html","الرمل"],[44,"أبا قدامة قد قدمت لي قدما","https://www.aldiwan.net/poem30329.html","البسيط"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[50,"أرسلت خلتي من الدمع غربا","https://www.aldiwan.net/poem64795.html","الخفيف"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125577","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43683","المديد"],[90,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""]],"verses":[["ضقت ذرعاً بمحنتي فتراءت","قيد شِبر لي الفجاج الفساح",0,"ح",1,0],["ضِقتُ فيهِ بِالر","رُسلِ وَالكُتُب",1,"ب",1,0],["ضقت ذرعاً بزماني وكذا","ضاقت الأيام والآلام بي",2,"ب",2,0],["ضِقنا بِدَينِكَ فَاِحتَجنا إِلى الدَينِ","مُذ غِبتَ عَنّا بِوَجهٍ ساطِعِ الزَينِ",3,"ن",1,0],["ضِقْتُ ذَرْعاً مِمَّا جَنَيْتُ فَيوْمِي","قَمْطَرِيرٌ وليلَتي دَرْعاءُ",4,"ا",2,0],["ضِقتُ عَن كُربَةِ العِتابِ فَحَسبي","لا تَزيدي حَبيبَ نَفسِكِ كَربا",5,"ب",2,0],["ضِقتُ بها كيف بمن","ضاق بها أن يَحسبا",6,"ب",2,0],["ضِقتُ ذرعاً مِن رَزِيّته","رَبِّ فَاِجعَل مِنكَ لي فَرَجا",7,"ج",2,0],["ضِقنا بها ضيقَ السجينِ بقيدهِ","من فَرْطِ ما حَمَلَتْ من الأوزار",8,"ر",1,0]]}