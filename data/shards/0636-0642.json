"الرمل"],[1895,"","https://poetry.dctabudhabi.ae/diwan/poem/74990","الرمل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53143","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27649","الخفيف"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87696","الرمل"],[2954,"","https://poetry.dctabudhabi.ae/diwan/poem/138925",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205939","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111422","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123501","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72520","الرمل"],[4767,"استئثار","https://www.poetsgate.com/ViewPoem.aspx?id=185275",""],[4881,"بين شاعر وشعره","https://www.poetsgate.com/ViewPoem.aspx?id=200535",""],[4987,"قلوب الرجال","https://www.poetsgate.com/ViewPoem.aspx?id=49574",""],[5000,"أنين الهجر","https://www.poetsgate.com/ViewPoem.aspx?id=6080",""],[585,"ليتني كنت شارداً أجنبياً","https://www.poetsgate.com/ViewPoem.aspx?id=161850",""],[5183,"معنى الوفاء","https://www.poetsgate.com/ViewPoem.aspx?id=186497",""],[5411,"ما مَضى قدْ مَضى","https://www.poetsgate.com/ViewPoem.aspx?id=191214",""],[5628,"الولادة الجديدة","https://www.poetsgate.com/ViewPoem.aspx?id=178478",""],[5691,"الأماني الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=206740",""],[5764,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=137063",""],[5783,"غربة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=34583",""],[5784,"ليس ذنبي","https://www.poetsgate.com/ViewPoem.aspx?id=189911",""],[5970,"غالبتني في لذة العيش نفسي","https://www.poetsgate.com/ViewPoem.aspx?id=130587",""],[5970,"كل بصفحة وجه العيش متبول","https://www.poetsgate.com/ViewPoem.aspx?id=130578",""],[6031,"بعثَتْ طَيْفَها فَزَارَ طُرُوقَا","https://www.poetsgate.com/ViewPoem.aspx?id=46276",""],[5309,"يا رعاة القلب ماذا ردكم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573664",""],[6189,"الكون الفسيح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76136&r=&rc=13",""],[6211,"رسالة الى السلطان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78234&r=&rc=5",""],[2220,"ضاقَ صدري لمَّا أتى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11511&r=&rc=385",""],[5567,"ارحموني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82102&r=&rc=143",""]],"verses":[["ضقت ذرعاً بمحنتي فتراءت","قيد شِبر لي الفجاج الفساح",0,"ح",1,0],["ضِقتُ فيهِ بِالر","رُسلِ وَالكُتُب",1,"ب",1,0],["ضقت ذرعاً بزماني وكذا","ضاقت الأيام والآلام بي",2,"ب",2,0],["ضِقنا بِدَينِكَ فَاِحتَجنا إِلى الدَينِ","مُذ غِبتَ عَنّا بِوَجهٍ ساطِعِ الزَينِ",3,"ن",1,0],["ضِقْتُ ذَرْعاً مِمَّا جَنَيْتُ فَيوْمِي","قَمْطَرِيرٌ وليلَتي دَرْعاءُ",4,"ا",2,0],["ضِقتُ عَن كُربَةِ العِتابِ فَحَسبي","لا تَزيدي حَبيبَ نَفسِكِ كَربا",5,"ب",2,0],["ضِقتُ بها كيف بمن","ضاق بها أن يَحسبا",6,"ب",2,0],["ضِقتُ ذرعاً مِن رَزِيّته","رَبِّ فَاِجعَل مِنكَ لي فَرَجا",7,"ج",2,0],["ضِقنا بها ضيقَ السجينِ بقيدهِ","من فَرْطِ ما حَمَلَتْ من الأوزار",8,"ر",1,0],["ضقت ذرعاً فإن تطق فأعني","أو فعني فما أريد معينا",9,"ن",2,0],["ضِقْتُ ذرعاً من حبِّه مثل ما ض","اقَ اتساعاً بساعديه سِوَارُه",10,"ر",2,0],["ضِقتَ بي والجناحُ منّى مهيضٌ","يا لَحُزني وحيرَتي وذُهولي",11,"ل",2,0],["ضِقْتُ من شكوى حبيبٍ","جئتُ لا أشكو فضاقَ",12,"ق",1,1],["ضِقتُ ذَرعاً مَع وُسعِ بَيداءِ صَبري","كادَ لَولا الرَجاءِ أَن يَتَقَضّى",13,"ض",2,0],["ضقت ذَرعاً بالبعد فيكم وَلَولا","حبُّكم لم يضق من البين ذرعي",14,"ع",2,0],["ضقت ربي ذرعا ولاسبب من كسبي","تب على توبه تمح كل الذنب",15,"ب",1,0],["ضِقتُ ذرعاً ببني اللُّؤمِ فما","تَركَتْ شكوايَ للشعر غَزلْ",16,"ل",1,0],["ضقت ذرعاً من جاهل ليس يدري ال","حلو حلواً بفيه ذاك المريض",17,"ض",1,0],["ضِقتُ ذَرْعاً ففَرَّ صبري وفيهِ","أثَرٌ من تَزاحُم الأشواقِ",18,"ق",1,0],["ضِقْتُ ذَرْعاً بجودِه ويدٌ وا","حدَةٌ لا تُطيقُ حَمْلَ أَيَادِ",19,"د",1,0],["ضِقتُ أن لا أُجزيكَ بالنَّيل نَيلا","فَلَعلّي أجزيكَ بالحمدِ حمدا",20,"د",2,0],["ضقتم بصحبتهم من بعد ما عبثوا","بكل سرٍّ لأوفى الصحب مكنون",21,"ن",1,0],["ضقتُ بالحاضر الكريه ومن لي","بمريح في غيره من عذابي",22,"ب",2,0],["ضقت ذرعا وما وجدت اهتداء","لسبيل يقين بالإسعاد",23,"د",1,0],["ضقت ذرعا مما كسبت من ال","اثم واني به عليم بصير",24,"ر",1,0],["ضقتُ ذرعاً واحتيالا فأغث","حالتي يا سيدي لا حول لي",25,"ل",2,0],["ضقت ذرعا بين خوفي وَالرجا","فاِعتَرى جِسمي اصفرار وَخلل",26,"ل",1,0],["ضقت ذرعاً بالحادثات فلما","زرت مغناه لم يضق بي ذراعه",27,"ع",2,0],["ضقتُ ذرعاً بموجودي","بعد ما كنت في فضا",28,"ض",2,0],["ضقت يا صَدرُ فَضاقَت","هَذِهِ الدُنيا الفَسيحه",29,"ه",1,0],["ضقت ذرعا حتى انتهيت لحارو","ف مروعا وواجم النفسيه",30,"ي",2,0],["ضقتم بأولادكم ذرعًا فما لكمو","ترعون كل أب في الحي ولادِ",31,"د",1,1],["ضِقتُ ذَرعاً لَو لي فُؤَادُ نُحاسٍ","وبصَوتي مَهما تَعَمَّتُ جُهدا",32,"د",2,0],["ضقت ذرعا وكدت أيئس لولا","ك رجائى لشدّتي ورخائى",33,"ا",2,0],["ضقت ذرعا وكدت أيأس لولا","ك رجاء للآمل المعواز",34,"ز",1,0],["ضقت ذرعا من معاناة العنا","جز شكايتها نباشد ديدنا",35,"ن",2,0],["ضقنا بها ذرعاً لنا","فافتح مصاريع السما",36,"م",2,0],["ضقتَ وأنت البحر لا يهتدى","منه إلى طول وعرض وقاعْ",37,"ع",1,0],["ضقت والبال عمس ومنقلب فوق تحت","هى من شوى يوم تفوح صفر الدلال",38,"ل",1,0],["ضِقْتُ بالهجرِ فاستغاثتْ ضُلوعي","وثَوى الليلُ فوقَ ضوءِ الشموعِ",39,"ع",1,1],["ضقت ذرعاً فمن يرفه عني","بين قوم ما زلت فيهم شقيا",40,"ي",2,0],["ضق ما تشاذ رْعاً بها فلكم","ضاق الكريم ومسّه الكرب",41,"ب",1,0],["ضِقْتُ ذَرْعًا وَذي الْحَياةُ تُعافُ","وَالخَوافي إِلى السِّجِلِّ تُضافُ",42,"ف",1,1],["ضقْتُ ذرْعا بأحاسيسي التي","حُجِزَتْ في قبضةِ الهمّ رهينهْ",43,"ن",2,0],["ضِقْتُ ذرعا ً بانتِظار ٍ","دام َ أعواما ً طويلهْ",44,"ل",2,0],["ضقت لكن وين منهم يفهمون","انتي انتي بس أنتي تفهمين",45,"ن",1,0],["ضقت بالسر إذ حملته دهرا","فوق ظهري..وكدت منه أُجنا",46,"ن",2,0],["ضقتُ ذرعًا في كلٍّ يومٍ صدودٌ","وتعالتْ في صدريٙ اللأواءُ",47,"ا",2,0],["ضقت بالهم فانتقمت لنفسي","بالملذات من همومي وبؤسي",48,"س",2,0],["ضقنا وضاقت بنا الدنيا وبغضها","للقلب هم له بالقلب تنكيل",49,"ل",1,0],["ضِقتُ ذَرْعاً بحبِّ من لا أُسمّي","هِ وإنْ مَزَّقَ الحشَا تَمزيقا",50,"ق",2,0],["ضقَد عَرَفتُ الهَمَّ مِن بَعدِكُمُ","فَكَأَنِّي ما عَرَفتُ الفَرَحا",51,"ح",2,0],["ضقتَ بالحق من فمي يامحبّي","ولقد ينكر الفصيحَ فصيحُ",52,"ح",1,0],["ضقنا بما فعل الأقزام في بلدي","صرنا سبايا على الأقزام نقتسمُ",53,"م",1,0],["ضقتُ ذَرعاً بموجدي","بعدَما كنتُ في فضا",54,"ض",2,0],["ضقت ذرعافي حياتي ضقتُ ذرعا","دونه الدنيا سعتْ من غير مسعى",55,"ع",2,0]]}