{"poems":[[88,"هي عيني ودمعها نضاح","https://www.aldiwan.net/poem44461.html","الخفيف"],[85,"مال واحتجب","https://www.aldiwan.net/poem63725.html","مجزوء المتدارك"],[97,"كيف أنسى زمناً كنت به","https://www.aldiwan.net/poem24981.html","الرمل"],[44,"أبا قدامة قد قدمت لي قدما","https://www.aldiwan.net/poem30329.html","البسيط"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[50,"أرسلت خلتي من الدمع غربا","https://www.aldiwan.net/poem64795.html","الخفيف"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125577","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43683","المديد"],[90,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[120,"أين تلك العهود وافقن آمالي","https://www.aldiwan.net/poem49271.html","الخفيف"],[128,"رحم الله من نأى ورمانى","https://www.aldiwan.net/poem50619.html","الخفيف"],[197,"هات يا ساق هات بنت النخيل","https://www.aldiwan.net/poem39944.html","الخفيف"],[254,"ضيقت الخناق","https://www.aldiwan.net/poem25019.html","مجزوء الرمل"],[259,"عند قطب التصريف طولا وعرضا","https://www.aldiwan.net/poem35966.html","الخفيف"],[297,"من لشملي لو فاز منكم بجمع","https://www.aldiwan.net/poem33226.html","الخفيف"],[391,"يا لطيف الطف بي فيجميع أحوالي","https://www.aldiwan.net/poem54515.html","عموديه"],[461,"خفضا لا موت الا بأجل","https://www.aldiwan.net/poem15467.html","الرمل"],[558,"ضرري نفع حاسدي بالنقيض","https://www.aldiwan.net/poem33545.html","الخفيف"],[562,"بين قلب المحب والأحداق","https://www.aldiwan.net/poem52949.html","الخفيف"],[575,"سلام عليه لا على الدهر بعده","https://www.aldiwan.net/poem3075.html","الطويل"]],"verses":[["ضقت ذرعاً بمحنتي فتراءت","قيد شِبر لي الفجاج الفساح",0,"ح",1,0],["ضِقتُ فيهِ بِالر","رُسلِ وَالكُتُب",1,"ب",1,0],["ضقت ذرعاً بزماني وكذا","ضاقت الأيام والآلام بي",2,"ب",2,0],["ضِقنا بِدَينِكَ فَاِحتَجنا إِلى الدَينِ","مُذ غِبتَ عَنّا بِوَجهٍ ساطِعِ الزَينِ",3,"ن",1,0],["ضِقْتُ ذَرْعاً مِمَّا جَنَيْتُ فَيوْمِي","قَمْطَرِيرٌ وليلَتي دَرْعاءُ",4,"ا",2,0],["ضِقتُ عَن كُربَةِ العِتابِ فَحَسبي","لا تَزيدي حَبيبَ نَفسِكِ كَربا",5,"ب",2,0],["ضِقتُ بها كيف بمن","ضاق بها أن يَحسبا",6,"ب",2,0],["ضِقتُ ذرعاً مِن رَزِيّته","رَبِّ فَاِجعَل مِنكَ لي فَرَجا",7,"ج",2,0],["ضِقنا بها ضيقَ السجينِ بقيدهِ","من فَرْطِ ما حَمَلَتْ من الأوزار",8,"ر",1,0],["ضقت ذرعاً فإن تطق فأعني","أو فعني فما أريد معينا",9,"ن",2,0],["ضِقْتُ ذرعاً من حبِّه مثل ما ض","اقَ اتساعاً بساعديه سِوَارُه",10,"ر",2,0],["ضِقتَ بي والجناحُ منّى مهيضٌ","يا لَحُزني وحيرَتي وذُهولي",11,"ل",2,0],["ضِقْتُ من شكوى حبيبٍ","جئتُ لا أشكو فضاقَ",12,"ق",1,1],["ضِقتُ ذَرعاً مَع وُسعِ بَيداءِ صَبري","كادَ لَولا الرَجاءِ أَن يَتَقَضّى",13,"ض",2,0],["ضقت ذَرعاً بالبعد فيكم وَلَولا","حبُّكم لم يضق من البين ذرعي",14,"ي",1,0],["ضقت ربي ذرعا ولاسبب من كسبي","تب على توبه تمح كل الذنب",15,"ب",1,0],["ضِقتُ ذرعاً ببني اللُّؤمِ فما","تَركَتْ شكوايَ للشعر غَزلْ",16,"ل",1,0],["ضقت ذرعاً من جاهل ليس يدري ال","حلو حلواً بفيه ذاك المريض",17,"ض",1,0],["ضِقتُ ذَرْعاً ففَرَّ صبري وفيهِ","أثَرٌ من تَزاحُم الأشواقِ",18,"ق",1,0],["ضِقْتُ ذَرْعاً بجودِه ويدٌ وا","حدَةٌ لا تُطيقُ حَمْلَ أَيَادِ",19,"د",1,0]]}