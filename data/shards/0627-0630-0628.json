diwan/poem/90864","الرمل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94630","الكامل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81255","المجتث"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73131","الطويل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28647","الخفيف"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146753","الخفيف"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66170","الطويل"],[4469,"","https://poetry.dctabudhabi.ae/diwan/poem/103143","الرمل"],[3163,"","https://poetry.dctabudhabi.ae/diwan/poem/123458","الرمل"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35455","الرمل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33589","الهزج"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89574","الرمل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120367","الوافر"],[4830,"نبضات عاشق","https://www.poetsgate.com/ViewPoem.aspx?id=195005",""],[4578,"بالصفا نحو كؤوس الأنس ساق","https://www.poetsgate.com/ViewPoem.aspx?id=49492",""],[4929,"الحق ورايته (اكناف بيت المقدس)","https://www.poetsgate.com/ViewPoem.aspx?id=208723",""],[4935,"لي حلا ورد الهناء الكوثري","https://www.poetsgate.com/ViewPoem.aspx?id=129442",""],[4935,"سطح هذا الكون أضحى (مرسحاً","https://www.poetsgate.com/ViewPoem.aspx?id=129324",""],[5121,"حَوَاس","https://www.poetsgate.com/ViewPoem.aspx?id=216029",""],[5189,"سلّم الأمر","https://www.poetsgate.com/ViewPoem.aspx?id=207684",""],[5277,"هي","https://www.poetsgate.com/ViewPoem.aspx?id=192304",""],[5277,"رثاءٌ لم يكتمل","https://www.poetsgate.com/ViewPoem.aspx?id=205146",""],[5409,"خرج العاهل للصي","https://www.poetsgate.com/ViewPoem.aspx?id=155367",""],[5587,"جئت أشكو","https://www.poetsgate.com/ViewPoem.aspx?id=196790",""],[5596,"الأمل والصدى","https://www.poetsgate.com/ViewPoem.aspx?id=205464",""],[5691,"يوم يُبعثون","https://www.poetsgate.com/ViewPoem.aspx?id=206744",""],[5720,"اقرأْ فديتُكَ *","https://www.poetsgate.com/ViewPoem.aspx?id=199236",""],[5781,"كمشةُ أحزانٍ بيدي...","https://www.poetsgate.com/ViewPoem.aspx?id=208992",""],[5818,"ملهمة شعري","https://www.poetsgate.com/ViewPoem.aspx?id=199981",""],[5851,"زنبقة من بقايا الصلصال","https://www.poetsgate.com/ViewPoem.aspx?id=175251",""],[6038,"غزوة رمش","https://www.poetsgate.com/ViewPoem.aspx?id=27051",""],[6100,"هياكل أوادم","https://www.poetsgate.com/ViewPoem.aspx?id=52556",""],[6129,"للمجاهدين في العراق وللبطلة العظيمة (ميسون)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74364&r=&rc=2",""]],"verses":[["إذ بدا بأسه الأشدّ فأنسى","كل بأس من الحديد شديد",0,"د",1,0],["إذ بين دجلة والفرات مصانع","تفترّ عن شنب بها السنوات",1,"ت",1,0],["اذ بدت بعد كاعب رؤد شمطاء","منها اللحاء والصخب",2,"ب",1,0],["إذ بَلَّغتهُ صروف الدهر غايتهُ","فاحتلّ منزلةً من رأس جبار",3,"ر",1,0],["إذ بنو يعربٍ كأصحاب موسى","وإذ الجيْشُ يوم ذلك قِبطُ",4,"ط",1,0],["إِذ بِتُّ أَنزِعُ مِنها حَليَها عَبَثاً","بَعدَ اِعتِناقٍ وَتَقبيلٍ وَتَجريدِ",5,"د",1,0],["أذبناها وكانت من حديد","وأطفأنا لثورتها ضِراما",6,"م",2,0],["أذَبْتُ لِصَوْغِها ذَهَبَ القوافي","فأَدَّتْ رونقَ الذَّهَبِ المُذابِ",7,"ب",1,0],["إذ باتَ جفني رضيعَ ابني يقاسمُهُ","لُبانَ أسحَمَ يَغذوهُ بِمِقدارِ",8,"ر",1,0],["أذِبْ منك قلباً تُجاري به","سوابقَ عبرتك الساكبه",9,"ب",2,0],["أذبْتَ فؤادي يا فديتُكَ بالعَتْبِ","ولو بتَّ صبّاً ما عَنُفْتَ على صَبِّ",10,"ب",1,1],["إِذ بَدا الكَشحُ وَالوِشاحُ مِنَ الدُر","رِ وَفَصلٌ فيهِ مِنَ المَرجانِ",11,"ن",1,0],["إِذ بَدَت بَينَ نِسوَةٍ","جازِئاتٍ عَقائِلِ",12,"ل",1,0],["أَذَبَّ وَراءَ المُستَضيفِ إِذا دَعا","وَأَضرَبَ في يَومِ الهِياجِ السَنَوَّرا",13,"ر",2,0],["إذ بدا في صَهَواتِ الخيل كال","قمرِ الملآن والسيف الفَرَد",14,"د",1,0],["أذب وأرمي بالحصى من ورائهم","وأبدا بالحسنى لهم وأعود",15,"د",1,0],["أذب في كل يوم","عنهن لو أستَطيع",16,"ع",1,0],["إذ باد حي كامل","عَن عز بيضته يكافح",17,"ح",1,0],["إذْبَحْ على صدرها غرامي","واملأ لها الكأسَ من شقائي",18,"ي",1,0],["أذَبْتِ الحَصَى كمَداً إذْ رَمَيْ","تِ بالدُّرّ يومَ رَمَيْتِ الجِمارا",19,"ر",2,0],["إذْ بَعْضُنَا مِنْ غَيْرِ مَا","نَسَبٍ إلى بَعْضٍ نَسِيْب",20,"ب",1,0],["إِذْ بَاتَ يَضْرِبُ فِي المَفَا","وِزِ وَهْوَ سَاجِي الطرْفِ حَائِرْ",21,"ر",1,0],["أَذبيحٌ أَم جَريحٌ وَجههُ","فَأَديمُ الحُسنِ مِنهُ مُختَرَق",22,"ق",1,0],["أَذُبُّ وَأَحمي رَسولَ المَليكِ","حِمايَةَ حانٍ عَلَيهِ شَفيقِ",23,"ق",1,0],["آذبُّ عنه ولا تصغي لقولهم","إذا رموني بزور القول أو أني",24,"ي",1,0],["إِذ بَذلوا الدرهمَ وَالدينارا","وَذَكروا الرَحمن والمُختارا",25,"ر",2,0],["أذبلت عودك الصبابة حتى","عدت مثل الخيال في الأحلام",26,"م",1,0],["أذبَلتِ حسنَك بالإهمال غافلةً","فبتُّ أُكسِبُهُ باللّمسِ إنضارا",27,"ر",2,0],["إِذْ باطِلُ الأَقْوامِ أَكْثَرُ ناصِراً","وَالْحَقُّ مَدْفُوعُ الدَّلِيلِ لِيَدْحَضا",28,"ض",2,0],["اِذبَحِ الدَّنَّ نَديمي وَاِسقِني","دَمَهُ حَتّى أُرى بِالسُكرِ دَنّا",29,"ن",2,0],["إِذ باتَ شَملي في ضَمانِ وِصالها","وَالقربُ يُبدلُ وحشَتي بتأَنُّسِ",30,"س",1,0],["إِذ بِالشَفاعَةِ شُيِّدَت موئِلَنا","اللَهُ أَكبَرُ ما أَعلا مَنازِلَنا",31,"ن",2,0],["إِذ بِهِ لَم يَروِ مِنهُ","ظَمَأَ الأَكبادَ وِردُ",32,"د",1,0],["إِذ بِالأَسامي أَروا اِختِصاصاً","لِما تَخَصَّصتُ بِالمَعاني",33,"ن",2,0],["أَذ بَدا لي عَكس دَمعي","في صَفاءِ العارِضين",34,"ن",1,0],["أذبُّ عن عترةٍ محاسِنُها","بِحَيثُ زَهرِ النُجومِ موقوفَه",35,"ف",2,0],["إِذ بلغ الفَتى عِشرينَ عاماً","وَأعوزه العلاءُ فَذاكَ عارُ",36,"ر",1,0],["أذَبْتُ عليه يوم مات حشاشتي","وأمسيت في قلبٍ من الحزن ذائب",37,"ب",1,0],["إِذ بمغنى سنان كان يغالي","ويجلِّي يشدوه أكداره",38,"ر",2,0],["إذ بدور السقاة تجلو شموساً","في كؤوسٍ طلعن أنجمَ سعد",39,"د",1,0],["إذ بالقضا نادى ألم تدر أنني","نهيتك فانزل أرض نفس وشهوتي",40,"ت",2,0],["إذ بانبعاث شعاعها لما بدا","حدثت مرائي في الخيال مثالا",41,"ل",2,0],["إذْ بكِ أيقن الباطلُ أنّه","ما بلغ السماءَ وما خرَقا",42,"ق",2,0],["إذ بأبياتٍ من الشع","ر تراه يترنم",43,"م",1,0],["إذ بِالمُنى أحيَيتَها","فَهِىَ منكَ وإلَيك",44,"ك",1,0],["إِذ بِالحَوادِثِ طَرفَةٌ عَن أَهلِها","وَإِذا أَهلُها مُتَآلِفونَ حُضورُ",45,"ر",1,0],["اذبح النفس بسيف الإجتهادْ","في رضى مولاك تحظى بالمرادْ",46,"د",1,1],["إِذ بات وهْوَ وسْنان","ففرّ منه غَضْبَانْ",47,"ن",1,0],["أذبت قلبي وما أبقيت جارحة","فويل نفسي من البلوى وأعضائي",48,"ا",2,0],["أذِبّ في روس المشاريفْ","والله بما في قلبي اخبَرْ",49,"ر",1,1],["إذ بَناتُ الوَصيِّ يُلطَمنَ والبَزَّ","ةُ زو البَزَّةُ والحَليُ عَنهمُ مسلوبُ",50,"ب",1,0],["إِذ بانَ عَن كَشف الرُموز قِناعُهُ","وَالدَهر جادَ بِفَكه مِن أَسره",51,"ر",2,0],["إِذ بِتنفيذها تُرَدّ سَريعاً","لِذَويها الحُقوق مِمَّن توقف",52,"ف",1,0],["إِذ بَعدَ أَن تُخرِجَني عَلَيكا","أَجرُّ مِن ذَقنك أَو يَديكا",53,"ك",2,0],["إِذ بَعدَ ما الديك عَفا وَذُبِحا","صارَت بِنفسِها العَجوز تصحى",54,"ح",2,0],["إِذبَحيني بِلِحاظٍ","وَاِدفَنيني في الجُفونِ",55,"ن",1,0],["إذ باطلي لم تَقشَّع جاهليتُه","عني ولم يترك الخلانُ تقوادي",56,"د",2,0],["أَذَبت نُفوساً واِنثَنَيت بسبّة","تجنبها كبراً لها الإِنس وَالجان",57,"ن",1,0],["إِذ باعَني بيعَ العبيدِ فضمّني","مَن صانَني إلّا من الأنكادِ",58,"د",1,0],["إذ بات يَعْثرُ في ذُيول مَذَلة","يعتاض ضِيقَ الحَبس عن إيوانه",59,"ن",2,0],["إِذْ بَعْضُهُمْ فِي وَرَطاتِ المَثْبَرِ","لاَقَتْ بِوُضْعٍ أُمُّهُ لَمْ تَطْهُرِ",60,"ر",1,0],["إذ بادروا الأتراك في اقبالهم","يتلاطمون كموج بحرٍ زاخرِ",61,"ر",1,0],["أَذَبْنَنِي فَلَقَيتُ النَّائباتِ بِها","لِقاءَ جّذْلانَ طَلْقِ الوَجْهِ مُنْبَسِطِهْ",62,"ط",2,0],["إذ بان سيفك عن غمده","فقد بان بأسك في حدّه",63,"د",2,1],["أذبت كل جامدٍ في وجهها","حتى الذي كان به من حمره",64,"ر",2,0],["إِذ بِهِ السنة اِزدَهَت فَأَنارَت","عَينُ أُنس الزَمان بَعدَ اِنطِماس",65,"س",1,0],["إِذ بِأَعباء المَعالي نَهَضا","ثابت الجَأش ذكي الفِطَنِ",66,"ن",1,0],["إذ بإقبال أزهريها من الكع","بة قد جاءها يبثُّ الحبورا",67,"ر",2,0],["إذ به نامت عيونُ الرُقبا","ليتها تبقى إلى الحشر نياما",68,"م",2,0],["إذ بختان فرقدي سمائِها","لعترة المجد السرورَ خَلّدا",69,"د",2,0],["إذ باتَ يجتازُ من أمرِ الإلهِ بهِ","جبريلُ عَن طبَقٍ أثباجَها طَبَقا",70,"ق",2,0],["إذ بعد فكرت بأن هذا على","مقدار ما يدري به قد سئلا",71,"ل",2,0],["أذبت الفؤاد بفرط الأسى","فصعده الوجد دمعاً همولا",72,"ل",2,0],["إذ بحبل الاله مستمسكان","وبسيف الاله تنتصران",73,"ن",1,0],["إذ بَعضُهُم فِي البَعضِ يَقدَحُ دَائِماً","وَالقَدحُ فِيهِم فَهوَ ذُو إمكَانِ",74,"ن",1,0],["اذ باع شيئا قدره فوق الذي","يعتاضه من هذه الأثمان",74,"ن",1,0],["إِذ بَينَما النيلُ يَوماً نائِماً تَعِبا","يَجري بِأَحلامِهِ لِلبَحرِ تَيّارُ",75,"ر",1,0],["إذ بلالُ الخال فيهِ قد غفا","ورقيبي نجمُ ليلٍ أدكَنِ",76,"ن",1,0],["أذبت الفؤاد بفرط الأسى","دموعا وأوسعت في القلب كلما",77,"م",2,0],["إذ باسرارهم يضنونَ عنهُ","حذراً أن يقولها للسانِ",78,"ن",1,0],["إِذ بِاِرتِياحٍ مِن تَلاحٍ في قِدا","حٍ أَن تَفوزَ عَلى رَفيقٍ يَرتَجِف",79,"ف",1,0],["إذ بكاس الرحيق طافت عليه","حور عين تقول أهلاً بخدني",80,"ن",2,0],["إذ به قد جاءنا منتظر","هو غوث الوقت ملء الأعين",81,"ن",1,0],["إذ برهم وكفى بذاك مودة","فيهم كفاه اللَه شر الحاسدين",82,"ن",1,0],["إِذ بانَ فَضلُ مَساعِيهِ وَهِمَّتِهِ","فَسِّر لَنا شَرحَ مَعنى سالَ سائِلُهُ",83,"ل",2,0],["إذ بدا موكب إدري","س كما تبدو السعود",84,"د",1,0],["إذ بدا كنُهنُا لدينا جليّاً","فبدا الفرق داعياً لاجتناب",85,"ب",1,0],["إِذ بَعضُهُم يَحمي مَراصِدَ بَيتِهِ","عَن جارِهِ وَسَبيلُنا مَورودُ",86,"د",1,0],["إذْ بُكائي لَكُمْ أَجَلُّ خُطوبي","في رِثائي أَشُقُّ جُيوبي",87,"ي",1,0],["أذب واحمى عن حماهم وأحتمى","وأجنى على من رامهم شرّ ما يجنى",88,"ن",2,0],["إذ بشرتك به العليا مؤرّخة","ذا يوم مُلكك بالمأمون مأمونُ",89,"ن",1,0],["إذ بَانَ من تَهوى وأوهى رُكنَها","بينٌ يقولُ لِطَرفِها لا تَهجَعِ",90,"ع",1,0],["إذ بالنبي بشرت وهي بكم","قد جاءكم بينةٌ من ربكم",91,"م",1,0],["أذبت عليه حشا مهجتي","وما كلّ من طرفي الساهر",92,"ر",1,0],["إذ بذات الخمار أمتع ليلى","وبذات الخمار ألهو نهاري",93,"ر",2,0],["إذ بدا تعريف حال الكل في","كلنا فالكل آي ونبا",94,"ب",2,0],["اذ بَنُوهُ تشابهوا فيهِ طبعا","وكذا من قد اوجب الطبع يرعى",95,"ع",2,0],["إذ برأوا المجرم من جرمه","وللبريء المتقي اجرموا",96,"م",3,0],["إذ بايع الناس له فسلموا","وأشرق الدهر وكاد يظلم",97,"م",1,0],["إذ بات يخترق السبع العلى صعداً","حتى انتهى صعداً لمنتهى الصعد",98,"د",1,0],["إذ بها ما تهوي النفوس وتهوي ال","عين لو كان في خيال منام",99,"م",1,0],["إذ بَدا مُتحِفاً لِكُلِّ قَرِيبِ","وَتَحَدَّى فَارتَابَ كُلُّ مُرِيبِ",100,"ب",1,0],["اذبح من طروادة انتقاما","من حولها اثني عشراً كراما",101,"م",2,0],["إِذ بإِيقارَةٍ صَ