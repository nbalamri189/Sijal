{"poems":[[88,"أيها القوم مالكم في جمود","https://www.aldiwan.net/poem44819.html","الخفيف"],[88,"من مبلغ المنصور عن بغداد","https://www.aldiwan.net/poem45006.html","الكامل"],[37,"أنخن أوما فصرن دهما وما","https://www.aldiwan.net/poem7673.html","المنسرح"],[51,"يا كائنا بين أوعاث وأوعار","https://www.aldiwan.net/poem62972.html","البسيط"],[51,"أعقب القرب من حبيبك شحط","https://www.aldiwan.net/poem65005.html","الخفيف"],[29,"يا يومنا عندها عد بالنعيم لنا","https://www.aldiwan.net/poem6117.html","البسيط"],[85,"عرابي كيف أوفيك الملاما","https://www.aldiwan.net/poem7581.html","الوافر"],[61,"تناهى فاطمأن إلى العتاب","https://www.aldiwan.net/poem51802.html","الوافر"],[80,"أشكو إلى الله ما قاسيت من رمد","https://www.aldiwan.net/poem31451.html","البسيط"],[80,"وعظت بلمتك الشائبه","https://www.aldiwan.net/poem31548.html","المتقارب"],[80,"أذبت فؤادي يا فديتك بالعتب","https://www.aldiwan.net/poem31564.html","الطويل"],[31,"إنني اليوم عادني أحزاني","https://www.aldiwan.net/poem41287.html","الخفيف"],[31,"ذكر القلب ذكرة","https://www.aldiwan.net/poem41865.html","مجزوء الخفيف"],[31,"تقول ابنة البكرين يوم لقيننا","https://www.aldiwan.net/poem42497.html","الطويل"],[75,"وهب الدهر نفيسا فاسترد","https://www.aldiwan.net/poem69086.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85579","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85448","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16662","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54886","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"],[135,"منعنا الرسول رسول المليك","https://www.aldiwan.net/poem21021.html","المتقارب"],[161,"ما شئت قله فلحمي دون خالقه","https://www.aldiwan.net/poem58682.html","البسيط"],[190,"حمد امرئ أخلص في آدائه","https://www.aldiwan.net/poem35279.html","الرجز"],[212,"يا أمير الغناء يفديك روحي","https://www.aldiwan.net/poem46323.html","الخفيف"],[271,"هيجت من أبلغ اللذات أذكارا","https://www.aldiwan.net/poem35465.html","البسيط"],[281,"شرفا لمجدك بانيا ومقوضا","https://www.aldiwan.net/poem60712.html","الكامل"],[283,"لست أسلو الشادن الأحوى الأغنا","https://www.aldiwan.net/poem32385.html","الرمل"],[298,"ماست فأزرت بالغصون الميس","https://www.aldiwan.net/poem33241.html","الكامل"],[321,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[350,"مر بي بالآب والإبن","https://www.aldiwan.net/poem15641.html","مجزوء الرمل"],[350,"بنطق سمعي جرى لساني","https://www.aldiwan.net/poem15963.html","مخلع البسيط"],[381,"يا بخيل المقلتين","https://www.aldiwan.net/poem48795.html","مجزوء الرمل"],[394,"يا زائرا سائرا إلى الكوفه","https://www.aldiwan.net/poem53676.html","المنسرح"],[407,"سقى دمعي الأحبة حيث ساروا","https://www.aldiwan.net/poem50161.html","الوافر"],[417,"رمينا بأدهى المعضلات النوائب","https://www.aldiwan.net/poem54172.html","الطويل"],[453,"كلما جدد الشجي ادكاره","https://www.aldiwan.net/poem13758.html","الخفيف"],[465,"يا خليلي تلك أعلام نجد","https://www.aldiwan.net/poem3489.html","عموديه"],[483,"بكعبة أنوار أنخت مطيتي","https://www.aldiwan.net/poem24323.html","عموديه"],[483,"ماذا على من غزلته سكينة","https://www.aldiwan.net/poem24465.html","عموديه"],[506,"غزّة","https://www.aldiwan.net/poem61086.html","المتدارك"],[539,"يا ابن عبد الله يا من","https://www.aldiwan.net/poem47420.html","عموديه"],[539,"يا خير من في عصره","https://www.aldiwan.net/poem47479.html","عموديه"],[554,"هاجت وساوسه برومة دور","https://www.aldiwan.net/poem68402.html","الكامل"],[559,"اذبح النفس بسيف الإجتهاد","https://www.aldiwan.net/poem34629.html","الرمل"],[576,"من يشتري لي أشجان","https://www.aldiwan.net/poem2842.html","منهوك المنسرح"]],"verses":[["إذ بدا بأسه الأشدّ فأنسى","كل بأس من الحديد شديد",0,"د",1,0],["إذ بين دجلة والفرات مصانع","تفترّ عن شنب بها السنوات",1,"ت",1,0],["اذ بدت بعد كاعب رؤد شمطاء","منها اللحاء والصخب",2,"ب",1,0],["إذ بَلَّغتهُ صروف الدهر غايتهُ","فاحتلّ منزلةً من رأس جبار",3,"ر",1,0],["إذ بنو يعربٍ كأصحاب موسى","وإذ الجيْشُ يوم ذلك قِبطُ",4,"ط",1,0],["إِذ بِتُّ أَنزِعُ مِنها حَليَها عَبَثاً","بَعدَ اِعتِناقٍ وَتَقبيلٍ وَتَجريدِ",5,"د",1,0],["أذبناها وكانت من حديد","وأطفأنا لثورتها ضِراما",6,"م",2,0],["أذَبْتُ لِصَوْغِها ذَهَبَ القوافي","فأَدَّتْ رونقَ الذَّهَبِ المُذابِ",7,"ب",1,0],["إذ باتَ جفني رضيعَ ابني يقاسمُهُ","لُبانَ أسحَمَ يَغذوهُ بِمِقدارِ",8,"ر",1,0],["أذِبْ منك قلباً تُجاري به","سوابقَ عبرتك الساكبه",9,"ب",2,0],["أذبْتَ فؤادي يا فديتُكَ بالعَتْبِ","ولو بتَّ صبّاً ما عَنُفْتَ على صَبِّ",10,"ب",1,1],["إِذ بَدا الكَشحُ وَالوِشاحُ مِنَ الدُر","رِ وَفَصلٌ فيهِ مِنَ المَرجانِ",11,"ن",1,0],["إِذ بَدَت بَينَ نِسوَةٍ","جازِئاتٍ عَقائِلِ",12,"ل",1,0],["أَذَبَّ وَراءَ المُستَضيفِ إِذا دَعا","وَأَضرَبَ في يَومِ الهِياجِ السَنَوَّرا",13,"ر",2,0],["إذ بدا في صَهَواتِ الخيل كال","قمرِ الملآن والسيف الفَرَد",14,"د",1,0],["أذب في كل يوم","عنهن لو أستَطيع",15,"ع",1,0],["إذ باد حي كامل","عَن عز بيضته يكافح",16,"ح",1,0],["إذْبَحْ على صدرها غرامي","واملأ لها الكأسَ من شقائي",17,"ي",1,0],["أذَبْتِ الحَصَى كمَداً إذْ رَمَيْ","تِ بالدُّرّ يومَ رَمَيْتِ الجِمارا",18,"ر",2,0],["إذْ بَعْضُنَا مِنْ غَيْرِ مَا","نَسَبٍ إلى بَعْضٍ نَسِيْب",19,"ب",1,0],["إِذْ بَاتَ يَضْرِبُ فِي المَفَا","وِزِ وَهْوَ سَاجِي الطرْفِ حَائِرْ",20,"ر",1,0],["أَذبيحٌ أَم جَريحٌ وَجههُ","فَأَديمُ الحُسنِ مِنهُ مُختَرَق",21,"ق",1,0],["أَذُبُّ وَأَحمي رَسولَ المَليكِ","حِمايَةَ حانٍ عَلَيهِ شَفيقِ",22,"ق",1,0],["آذبُّ عنه ولا تصغي لقولهم","إذا رموني بزور القول أو أني",23,"ي",1,0],["إِذ بَذلوا الدرهمَ وَالدينارا","وَذَكروا الرَحمن والمُختارا",24,"ر",2,0],["أذبلت عودك الصبابة حتى","عدت مثل الخيال في الأحلام",25,"م",1,0],["أذبَلتِ حسنَك بالإهمال غافلةً","فبتُّ أُكسِبُهُ باللّمسِ إنضارا",26,"ر",2,0],["إِذْ باطِلُ الأَقْوامِ أَكْثَرُ ناصِراً","وَالْحَقُّ مَدْفُوعُ الدَّلِيلِ لِيَدْحَضا",27,"ض",2,0],["اِذبَحِ الدَّنَّ نَديمي وَاِسقِني","دَمَهُ حَتّى أُرى بِالسُكرِ دَنّا",28,"ن",2,0],["إِذ باتَ شَملي في ضَمانِ وِصالها","وَالقربُ يُبدلُ وحشَتي بتأَنُّسِ",29,"س",1,0],["إِذ بِالشَفاعَةِ شُيِّدَت موئِلَنا","اللَهُ أَكبَرُ ما أَعلا مَنازِلَنا",30,"ن",2,0],["إِذ بِهِ لَم يَروِ مِنهُ","ظَمَأَ الأَكبادَ وِردُ",31,"د",1,0],["إِذ بِالأَسامي أَروا اِختِصاصاً","لِما تَخَصَّصتُ بِالمَعاني",32,"ن",2,0],["أَذ بَدا لي عَكس دَمعي","في صَفاءِ العارِضين",33,"ن",1,0],["أذبُّ عن عترةٍ محاسِنُها","بِحَيثُ زَهرِ النُجومِ موقوفَه",34,"ف",2,0],["إِذ بلغ الفَتى عِشرينَ عاماً","وَأعوزه العلاءُ فَذاكَ عارُ",35,"ر",1,0],["أذَبْتُ عليه يوم مات حشاشتي","وأمسيت في قلبٍ من الحزن ذائب",36,"ب",1,0],["إِذ بمغنى سنان كان يغالي","ويجلِّي يشدوه أكداره",37,"ر",2,0],["إذ بدور السقاة تجلو شموساً","في كؤوسٍ طلعن أنجمَ سعد",38,"د",1,0],["إذ بالقضا نادى ألم تدر أنني","نهيتك فانزل أرض نفس وشهوتي",39,"ت",2,0],["إذ بانبعاث شعاعها لما بدا","حدثت مرائي في الخيال مثالا",40,"ل",2,0],["إذْ بكِ أيقن الباطلُ أنّه","ما بلغ السماءَ وما خرَقا",41,"ق",2,0],["إذ بأبياتٍ من الشع","ر تراه يترنم",42,"م",1,0],["إذ بِالمُنى أحيَيتَها","فَهِىَ منكَ وإلَيك",43,"ك",1,0],["إِذ بِالحَوادِثِ طَرفَةٌ عَن أَهلِها","وَإِذا أَهلُها مُتَآلِفونَ حُضورُ",44,"ر",1,0],["اذبح النفس بسيف الإجتهادْ","في رضى مولاك تحظى بالمرادْ",45,"د",1,1],["إِذ بات وهْوَ وسْنان","ففرّ منه غَضْبَانْ",46,"ن",1,0]]}