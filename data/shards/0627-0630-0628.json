{"poems":[[88,"أيها القوم مالكم في جمود","https://www.aldiwan.net/poem44819.html","الخفيف"],[88,"من مبلغ المنصور عن بغداد","https://www.aldiwan.net/poem45006.html","الكامل"],[37,"أنخن أوما فصرن دهما وما","https://www.aldiwan.net/poem7673.html","المنسرح"],[51,"يا كائنا بين أوعاث وأوعار","https://www.aldiwan.net/poem62972.html","البسيط"],[51,"أعقب القرب من حبيبك شحط","https://www.aldiwan.net/poem65005.html","الخفيف"],[29,"يا يومنا عندها عد بالنعيم لنا","https://www.aldiwan.net/poem6117.html","البسيط"],[85,"عرابي كيف أوفيك الملاما","https://www.aldiwan.net/poem7581.html","الوافر"],[61,"تناهى فاطمأن إلى العتاب","https://www.aldiwan.net/poem51802.html","الوافر"],[80,"أشكو إلى الله ما قاسيت من رمد","https://www.aldiwan.net/poem31451.html","البسيط"],[80,"وعظت بلمتك الشائبه","https://www.aldiwan.net/poem31548.html","المتقارب"],[80,"أذبت فؤادي يا فديتك بالعتب","https://www.aldiwan.net/poem31564.html","الطويل"],[31,"إنني اليوم عادني أحزاني","https://www.aldiwan.net/poem41287.html","الخفيف"],[31,"ذكر القلب ذكرة","https://www.aldiwan.net/poem41865.html","مجزوء الخفيف"],[31,"تقول ابنة البكرين يوم لقيننا","https://www.aldiwan.net/poem42497.html","الطويل"],[75,"وهب الدهر نفيسا فاسترد","https://www.aldiwan.net/poem69086.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85579","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85448","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16662","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54886","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"]],"verses":[["إذ بدا بأسه الأشدّ فأنسى","كل بأس من الحديد شديد",0,"د",1,0],["إذ بين دجلة والفرات مصانع","تفترّ عن شنب بها السنوات",1,"ت",1,0],["اذ بدت بعد كاعب رؤد شمطاء","منها اللحاء والصخب",2,"ب",1,0],["إذ بَلَّغتهُ صروف الدهر غايتهُ","فاحتلّ منزلةً من رأس جبار",3,"ر",1,0],["إذ بنو يعربٍ كأصحاب موسى","وإذ الجيْشُ يوم ذلك قِبطُ",4,"ط",1,0],["إِذ بِتُّ أَنزِعُ مِنها حَليَها عَبَثاً","بَعدَ اِعتِناقٍ وَتَقبيلٍ وَتَجريدِ",5,"د",1,0],["أذبناها وكانت من حديد","وأطفأنا لثورتها ضِراما",6,"م",2,0],["أذَبْتُ لِصَوْغِها ذَهَبَ القوافي","فأَدَّتْ رونقَ الذَّهَبِ المُذابِ",7,"ب",1,0],["إذ باتَ جفني رضيعَ ابني يقاسمُهُ","لُبانَ أسحَمَ يَغذوهُ بِمِقدارِ",8,"ر",1,0],["أذِبْ منك قلباً تُجاري به","سوابقَ عبرتك الساكبه",9,"ب",2,0],["أذبْتَ فؤادي يا فديتُكَ بالعَتْبِ","ولو بتَّ صبّاً ما عَنُفْتَ على صَبِّ",10,"ب",1,1],["إِذ بَدا الكَشحُ وَالوِشاحُ مِنَ الدُر","رِ وَفَصلٌ فيهِ مِنَ المَرجانِ",11,"ن",1,0],["إِذ بَدَت بَينَ نِسوَةٍ","جازِئاتٍ عَقائِلِ",12,"ل",1,0],["أَذَبَّ وَراءَ المُستَضيفِ إِذا دَعا","وَأَضرَبَ في يَومِ الهِياجِ السَنَوَّرا",13,"ر",2,0],["إذ بدا في صَهَواتِ الخيل كال","قمرِ الملآن والسيف الفَرَد",14,"د",1,0],["أذب في كل يوم","عنهن لو أستَطيع",15,"ع",1,0],["إذ باد حي كامل","عَن عز بيضته يكافح",16,"ح",1,0],["إذْبَحْ على صدرها غرامي","واملأ لها الكأسَ من شقائي",17,"ي",1,0],["أذَبْتِ الحَصَى كمَداً إذْ رَمَيْ","تِ بالدُّرّ يومَ رَمَيْتِ الجِمارا",18,"ر",2,0],["إذْ بَعْضُنَا مِنْ غَيْرِ مَا","نَسَبٍ إلى بَعْضٍ نَسِيْب",19,"ب",1,0],["إِذْ بَاتَ يَضْرِبُ فِي المَفَا","وِزِ وَهْوَ سَاجِي الطرْفِ حَائِرْ",20,"ر",1,0],["أَذبيحٌ أَم جَريحٌ وَجههُ","فَأَديمُ الحُسنِ مِنهُ مُختَرَق",21,"ق",1,0]]}