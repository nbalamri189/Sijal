{"poems":[[90,"أيها القوم مالكم في جمود","https://www.aldiwan.net/poem44819.html","الخفيف"],[90,"من مبلغ المنصور عن بغداد","https://www.aldiwan.net/poem45006.html","الكامل"],[39,"أنخن أوما فصرن دهما وما","https://www.aldiwan.net/poem7673.html","المنسرح"],[53,"يا كائنا بين أوعاث وأوعار","https://www.aldiwan.net/poem62972.html","البسيط"],[53,"أعقب القرب من حبيبك شحط","https://www.aldiwan.net/poem65005.html","الخفيف"],[31,"يا يومنا عندها عد بالنعيم لنا","https://www.aldiwan.net/poem6117.html","البسيط"],[87,"عرابي كيف أوفيك الملاما","https://www.aldiwan.net/poem7581.html","الوافر"],[63,"تناهى فاطمأن إلى العتاب","https://www.aldiwan.net/poem51802.html","الوافر"],[82,"أشكو إلى الله ما قاسيت من رمد","https://www.aldiwan.net/poem31451.html","البسيط"],[82,"وعظت بلمتك الشائبه","https://www.aldiwan.net/poem31548.html","المتقارب"],[82,"أذبت فؤادي يا فديتك بالعتب","https://www.aldiwan.net/poem31564.html","الطويل"],[33,"إنني اليوم عادني أحزاني","https://www.aldiwan.net/poem41287.html","الخفيف"],[33,"ذكر القلب ذكرة","https://www.aldiwan.net/poem41865.html","مجزوء الخفيف"],[33,"تقول ابنة البكرين يوم لقيننا","https://www.aldiwan.net/poem42497.html","الطويل"],[77,"وهب الدهر نفيسا فاسترد","https://www.aldiwan.net/poem69086.html","الطويل"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/29351","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85579","المجتث"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85448","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16662","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54886","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"],[138,"منعنا الرسول رسول المليك","https://www.aldiwan.net/poem21021.html","المتقارب"],[164,"ما شئت قله فلحمي دون خالقه","https://www.aldiwan.net/poem58682.html","البسيط"],[193,"حمد امرئ أخلص في آدائه","https://www.aldiwan.net/poem35279.html","الرجز"],[215,"يا أمير الغناء يفديك روحي","https://www.aldiwan.net/poem46323.html","الخفيف"],[274,"هيجت من أبلغ اللذات أذكارا","https://www.aldiwan.net/poem35465.html","البسيط"],[284,"شرفا لمجدك بانيا ومقوضا","https://www.aldiwan.net/poem60712.html","الكامل"],[286,"لست أسلو الشادن الأحوى الأغنا","https://www.aldiwan.net/poem32385.html","الرمل"],[301,"ماست فأزرت بالغصون الميس","https://www.aldiwan.net/poem33241.html","الكامل"],[324,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[353,"مر بي بالآب والإبن","https://www.aldiwan.net/poem15641.html","مجزوء الرمل"],[353,"بنطق سمعي جرى لساني","https://www.aldiwan.net/poem15963.html","مخلع البسيط"],[384,"يا بخيل المقلتين","https://www.aldiwan.net/poem48795.html","مجزوء الرمل"],[397,"يا زائرا سائرا إلى الكوفه","https://www.aldiwan.net/poem53676.html","المنسرح"],[410,"سقى دمعي الأحبة حيث ساروا","https://www.aldiwan.net/poem50161.html","الوافر"],[420,"رمينا بأدهى المعضلات النوائب","https://www.aldiwan.net/poem54172.html","الطويل"],[455,"كلما جدد الشجي ادكاره","https://www.aldiwan.net/poem13758.html","الخفيف"],[467,"يا خليلي تلك أعلام نجد","https://www.aldiwan.net/poem3489.html","عموديه"],[485,"بكعبة أنوار أنخت مطيتي","https://www.aldiwan.net/poem24323.html","عموديه"],[485,"ماذا على من غزلته سكينة","https://www.aldiwan.net/poem24465.html","عموديه"],[508,"غزّة","https://www.aldiwan.net/poem61086.html","المتدارك"],[541,"يا ابن عبد الله يا من","https://www.aldiwan.net/poem47420.html","عموديه"],[541,"يا خير من في عصره","https://www.aldiwan.net/poem47479.html","عموديه"],[556,"هاجت وساوسه برومة دور","https://www.aldiwan.net/poem68402.html","الكامل"],[561,"اذبح النفس بسيف الإجتهاد","https://www.aldiwan.net/poem34629.html","الرمل"],[578,"من يشتري لي أشجان","https://www.aldiwan.net/poem2842.html","منهوك المنسرح"],[953,"","https://poetry.dctabudhabi.ae/diwan/poem/29434","الكامل"]],"verses":[["إذ بدا بأسه الأشدّ فأنسى","كل بأس من الحديد شديد",0,"د",1,0],["إذ بين دجلة والفرات مصانع","تفترّ عن شنب بها السنوات",1,"ت",1,0],["اذ بدت بعد كاعب رؤد شمطاء","منها اللحاء والصخب",2,"ب",1,0],["إذ بَلَّغتهُ صروف الدهر غايتهُ","فاحتلّ منزلةً من رأس جبار",3,"ر",1,0],["إذ بنو يعربٍ كأصحاب موسى","وإذ الجيْشُ يوم ذلك قِبطُ",4,"ط",1,0],["إِذ بِتُّ أَنزِعُ مِنها حَليَها عَبَثاً","بَعدَ اِعتِناقٍ وَتَقبيلٍ وَتَجريدِ",5,"د",1,0],["أذبناها وكانت من حديد","وأطفأنا لثورتها ضِراما",6,"م",2,0],["أذَبْتُ لِصَوْغِها ذَهَبَ القوافي","فأَدَّتْ رونقَ الذَّهَبِ المُذابِ",7,"ب",1,0],["إذ باتَ جفني رضيعَ ابني يقاسمُهُ","لُبانَ أسحَمَ يَغذوهُ بِمِقدارِ",8,"ر",1,0],["أذِبْ منك قلباً تُجاري به","سوابقَ عبرتك الساكبه",9,"ب",2,0],["أذبْتَ فؤادي يا فديتُكَ بالعَتْبِ","ولو بتَّ صبّاً ما عَنُفْتَ على صَبِّ",10,"ب",1,1],["إِذ بَدا الكَشحُ وَالوِشاحُ مِنَ الدُر","رِ وَفَصلٌ فيهِ مِنَ المَرجانِ",11,"ن",1,0],["إِذ بَدَت بَينَ نِسوَةٍ","جازِئاتٍ عَقائِلِ",12,"ل",1,0],["أَذَبَّ وَراءَ المُستَضيفِ إِذا دَعا","وَأَضرَبَ في يَومِ الهِياجِ السَنَوَّرا",13,"ر",2,0],["إذ بدا في صَهَواتِ الخيل كال","قمرِ الملآن والسيف الفَرَد",14,"د",1,0],["أذب وأرمي بالحصى من ورائهم","وأبدا بالحسنى لهم وأعود",15,"د",1,0],["أذب في كل يوم","عنهن لو أستَطيع",16,"ع",1,0],["إذ باد حي كامل","عَن عز بيضته يكافح",17,"ح",1,0],["إذْبَحْ على صدرها غرامي","واملأ لها الكأسَ من شقائي",18,"ي",1,0],["أذَبْتِ الحَصَى كمَداً إذْ رَمَيْ","تِ بالدُّرّ يومَ رَمَيْتِ الجِمارا",19,"ر",2,0],["إذْ بَعْضُنَا مِنْ غَيْرِ مَا","نَسَبٍ إلى بَعْضٍ نَسِيْب",20,"ب",1,0],["إِذْ بَاتَ يَضْرِبُ فِي المَفَا","وِزِ وَهْوَ سَاجِي الطرْفِ حَائِرْ",21,"ر",1,0],["أَذبيحٌ أَم جَريحٌ وَجههُ","فَأَديمُ الحُسنِ مِنهُ مُختَرَق",22,"ق",1,0],["أَذُبُّ وَأَحمي رَسولَ المَليكِ","حِمايَةَ حانٍ عَلَيهِ شَفيقِ",23,"ق",1,0],["آذبُّ عنه ولا تصغي لقولهم","إذا رموني بزور القول أو أني",24,"ي",1,0],["إِذ بَذلوا الدرهمَ وَالدينارا","وَذَكروا الرَحمن والمُختارا",25,"ر",2,0],["أذبلت عودك الصبابة حتى","عدت مثل الخيال في الأحلام",26,"م",1,0],["أذبَلتِ حسنَك بالإهمال غافلةً","فبتُّ أُكسِبُهُ باللّمسِ إنضارا",27,"ر",2,0],["إِذْ باطِلُ الأَقْوامِ أَكْثَرُ ناصِراً","وَالْحَقُّ مَدْفُوعُ الدَّلِيلِ لِيَدْحَضا",28,"ض",2,0],["اِذبَحِ الدَّنَّ نَديمي وَاِسقِني","دَمَهُ حَتّى أُرى بِالسُكرِ دَنّا",29,"ن",2,0],["إِذ باتَ شَملي في ضَمانِ وِصالها","وَالقربُ يُبدلُ وحشَتي بتأَنُّسِ",30,"س",1,0],["إِذ بِالشَفاعَةِ شُيِّدَت موئِلَنا","اللَهُ أَكبَرُ ما أَعلا مَنازِلَنا",31,"ن",2,0],["إِذ بِهِ لَم يَروِ مِنهُ","ظَمَأَ الأَكبادَ وِردُ",32,"د",1,0],["إِذ بِالأَسامي أَروا اِختِصاصاً","لِما تَخَصَّصتُ بِالمَعاني",33,"ن",2,0],["أَذ بَدا لي عَكس دَمعي","في صَفاءِ العارِضين",34,"ن",1,0],["أذبُّ عن عترةٍ محاسِنُها","بِحَيثُ زَهرِ النُجومِ موقوفَه",35,"ف",2,0],["إِذ بلغ الفَتى عِشرينَ عاماً","وَأعوزه العلاءُ فَذاكَ عارُ",36,"ر",1,0],["أذَبْتُ عليه يوم مات حشاشتي","وأمسيت في قلبٍ من الحزن ذائب",37,"ب",1,0],["إِذ بمغنى سنان كان يغالي","ويجلِّي يشدوه أكداره",38,"ر",2,0],["إذ بدور السقاة تجلو شموساً","في كؤوسٍ طلعن أنجمَ سعد",39,"د",1,0],["إذ بالقضا نادى ألم تدر أنني","نهيتك فانزل أرض نفس وشهوتي",40,"ت",2,0],["إذ بانبعاث شعاعها لما بدا","حدثت مرائي في الخيال مثالا",41,"ل",2,0],["إذْ بكِ أيقن الباطلُ أنّه","ما بلغ السماءَ وما خرَقا",42,"ق",2,0],["إذ بأبياتٍ من الشع","ر تراه يترنم",43,"م",1,0],["إذ بِالمُنى أحيَيتَها","فَهِىَ منكَ وإلَيك",44,"ك",1,0],["إِذ بِالحَوادِثِ طَرفَةٌ عَن أَهلِها","وَإِذا أَهلُها مُتَآلِفونَ حُضورُ",45,"ر",1,0],["اذبح النفس بسيف الإجتهادْ","في رضى مولاك تحظى بالمرادْ",46,"د",1,1],["إِذ بات وهْوَ وسْنان","ففرّ منه غَضْبَانْ",47,"ن",1,0],["إِذ بَعضُهُم يَحمي مَراصِدَ بَيتِهِ","عَن جارِهِ وَسَبيلُنا مَورودُ",48,"د",1,0]]}