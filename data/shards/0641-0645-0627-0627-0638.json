{"poems":[[74,"يا سيدي ذكر بحالي صاحبا","https://www.aldiwan.net/poem18650.html","الرجز"],[74,"أبكيك للحسنين الخلق والخلق","https://www.aldiwan.net/poem19356.html","البسيط"],[333,"الحمد للَه على ماق ضى","https://www.aldiwan.net/poem54955.html","الكامل"],[369,"أشاكر أنا للأيام أم شاك","https://www.aldiwan.net/poem60816.html","البسيط"],[409,"مولاي خذ نشر الذي طويته","https://www.aldiwan.net/poem34102.html","الرجز"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/97001","الطويل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34424","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53038","المتقارب"],[3779,"","https://poetry.dctabudhabi.ae/diwan/poem/141514","الطويل"]],"verses":[["فما أظن حال عبدٍ مخلصٍ","يضيع بين صاحبٍ وسيد",0,"د",1,0],["فما أظنُّك ترضى حالة نعمت","وإن قلبي بنيران الهموم شقي",1,"ق",2,0],["فما أظنّ الأرض تحوى فتى","وجوده قد كان إحدى الكبَر",2,"ر",1,0],["فما أَظُنُّكَ إلاّ أنّه كَرماً","بالنُّورِ من يَدِه البَيْضاءِ أعْداك",3,"ك",1,0],["فما أظن النار في ضلوعه","إلا من الوجد الذي عرفته",4,"ت",2,0],["فما أظلم المحراب بعدك وحده","نعم مشرق الدنيا ومغربها معا",5,"ع",2,0],["فَما أَظلم الدنيا بعيني وَقَد نأت","ولاة غَرامي العاذِلون وَأَقماري",6,"ر",2,0],["فما أظلم الدهر إلا أضاء","ولا جمد الغيث إلا انسكب",7,"ب",1,0],["فما أظلم الأيَّام والصُّبح نيِّرٌ","وأكثر أهل الأرض والأرض بلقُع",8,"ع",1,0]]}