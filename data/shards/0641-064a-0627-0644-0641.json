","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128720","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108568","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100982","الكامل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52029","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2382,"","https://poetry.dctabudhabi.ae/diwan/poem/101803","الطويل"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126193","الرجز"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60956","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87320","الرجز"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140088",""],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68021","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89179","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89124","السريع"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77149","الرجز"],[4166,"","https://poetry.dctabudhabi.ae/diwan/poem/203266","البسيط"],[4246,"","https://poetry.dctabudhabi.ae/diwan/poem/103260","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72870","البسيط"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136384",""],[4823,"زهرة الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=188280",""],[4984,"عيد الشجرة","https://www.poetsgate.com/ViewPoem.aspx?id=180037",""],[307,"أجملُ ما في الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=213656",""],[5401,"مهند وطوني","https://www.poetsgate.com/ViewPoem.aspx?id=85371",""],[5409,"في الفقر عاش ومذ حانت منيته","https://www.poetsgate.com/ViewPoem.aspx?id=155380",""],[5409,"مروا به وسط الدساكر","https://www.poetsgate.com/ViewPoem.aspx?id=155277",""],[5431,"كلي دموعٌ بالحياء مبلله","https://www.poetsgate.com/ViewPoem.aspx?id=192732",""],[5431,"ستظلُ دهرا في دمي","https://www.poetsgate.com/ViewPoem.aspx?id=197517",""],[5431,"أما اكتفيت؟","https://www.poetsgate.com/ViewPoem.aspx?id=212797",""],[5952,"آخر الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=204836",""],[5956,"لحن الحب","https://www.poetsgate.com/ViewPoem.aspx?id=186141",""],[6127,"الأملُ الموعود","https://www.poetsgate.com/ViewPoem.aspx?id=198207",""],[6131,"رسولُ الثَّرَى","https://www.poetsgate.com/ViewPoem.aspx?id=189281",""]],"verses":[["في الفرنسيس هل تعضي مرام","لمجيد أو استمر مرير",0,"ر",1,0],["في الفن سحر لا يمل جماله","واليه يرجع من اراد بعادا",1,"د",2,0],["في الفن معنى حسنه لا يعرف","حتى يمثل ما بمثل يوسف",2,"ف",1,1],["في الفِتنَةِ الكُبرى وَلَو","لا حِكمَةٌ لَم تُشعَلِ",3,"ل",1,0],["في الفاطِمِيّينَ اِنتَمى يَنبوعُهُ","عَذبَ الأُصولِ كَجَدِّهِم مُتَفَجِّرا",4,"ر",2,0],["في الفجر تحتضن القفار رواحلي","والحر حين يرى الملالة يهرب",5,"ب",1,0],["في الفَلِّ يملأ رُعباً","وواحد منه أكثر",6,"ر",1,0],["في الفَتى الزِنجِيِّ مِنهُ شَبَهٌ","غَيرَ أَنَّ الزِقَّ أَذكى وَأَرَق",7,"ق",1,1],["في الفيافي كآبةً ووجوماً","والمحيطاتِ صاخباتِ الهديرِ",8,"ر",1,0],["فِي الْفِرنْسِيسِ هَلْ تقضَّى مَرامٌ","لِمُجِيدٍ أَوِ اسْتَمَرَّ مَرِيرُ",9,"ر",1,0],["فيا لفؤادي ما التباريح والجوى","فعلن إذا ازدادت عليه اللوائم",10,"م",1,0],["في الفياقي كآبة ووجوما","والمحيطات صاخبات الهدير",11,"ر",1,0],["في الفَرقِ والطُرَّة والوَجهِ وال","خدَّين والثغرِ وقدِّ الحَبيب",12,"ب",1,0],["في الفَلَكِ آياتِهِ تَبدو وَفي الفَلَكِ","بِالقُربِ أَولاكَ عَن مُلكٍ وَعَن مَلِكِ",13,"ك",1,0],["في الفعال والتروك","والمقاصد والمقول",14,"ل",1,0],["في الفقهِ مثلُ الشافعيّ ومالكٍ","وأبي حنيفةَ وابنِ حنبلَ أحمدِ",15,"د",1,0],["في الفضل أحمدُ أحمدُ الأزكى لقد","حاز المَدى سَبْقاً فأعيا السُبَّقا",16,"ق",2,0],["في ألف عامٍ ترتقي فإذا انتهت","هدت بهم فإذا هم أسفالها",17,"ل",3,0],["في الفخر كم لك من يد","لا ريب نعرفها يقينا",18,"ن",2,0],["في الفضل هذا لم يكن بما وصف","أفضل منه عند كل من عرف",19,"ف",1,0],["في الفَرْعِ ما في أَصْلِهِ وَزيادَة","كَالغُصْنِ خُصَّ بِما جَنَى مِنْ أُكْلِهِ",20,"ل",2,0],["في الفيافي نشأتُ لكنَّ بُردي","راقَ وشياً ولا يزالُ جديدا",21,"د",2,0],["فيا لِفَقيد مضى شخصه","وَبيض مساعيه لم تفقد",22,"د",1,0],["في الفَضل لا يصغي إلى","مموّهٍ بالوعظِ",23,"ظ",1,0],["في ألف التأنيث مطلقا عرف","وفي مفاعل مفاعيل ألف",24,"ف",1,0],["في ألف بيت بالضروري قائمة","تزيد عن خطبته والخاتمه",25,"ه",1,0],["في الفلك نجّى به نوحا وأهلك","أهل الشرك في ماء طوفان ولا أسفا",26,"ف",2,0],["فيا لفوز حمىً ردت كرامته","له وأعرض عنه الضر وانكسحا",27,"ح",2,0],["في الفيلق الخضراء يقدمها","ملكٌ أشم وكوكبٌ نجد",28,"د",1,0],["في الفكة انفك عنها الليد سالمة","مَن بَعدِ مَا قَد قضَى من جِلمةَ أرَبُ",29,"ب",1,0],["في آلِ فِرعَونٍ وَقَارُونَ وَهَا","مَان ونُمرُودٍ وَجِنكِسخَانِ",30,"ن",1,0],["فيا لفتى قد حيّر الفكر وصفه","فلو كر فيه الفكر لانصاع معكوسا",31,"س",2,0],["فى الفقرِ منّى فاقداً فقيراً","ولم أكن شيئاً غداً مذكُوراً",32,"ر",2,0],["في الفرع من سنحان ينسب أصلُه","والفخر كلُّ الفخر في سنحان",33,"ن",1,0],["في الفَلًكِ الأصلي وكلَّ نَجمِ","إذ قُطُبُ الشَّمالِ فَوقَ اليَمِّ",34,"م",1,0],["في ألف عام سيره لا ينتهي","واللون أحمر وهو من ياقوتة",35,"ه",1,0],["فيألفُ ممشوقٌ هناك بعاشقٍ","فيُشْعِرنا الوجدانُ مَا كَانَ آنفا",36,"ف",2,0],["في الفرس والترك والعرب الأفاضل لا","أقول كاني ولا ماني ولا جذري",37,"ي",1,0],["في الفرس والترك غدا مفرداً","وما له في عُربهم من نظير",38,"ر",1,0],["في الفك تحت الأذن والأسنانا","سحق ثم استأصل اللسانا",39,"ن",2,0],["في الفِئَتَين أَهرَقَت دِماء","لَيسَ لَها في أَمرِهِم مَجال",40,"ل",1,0],["في الفتح ضم من الأنصار شملهم","جبر الكسير بترشيح من الرحم",41,"م",1,0],["في الفضل فرد والشمائل واحد","والجود والإحسان غيث صيب",42,"ب",1,0],["في الفقهِ هذا كتابٌ قد حوى دررا","من المسائل تترى كلُّه غرر",43,"ر",1,1],["فيألف ارباب المكارم والتقى","ويأنف من أهل المكاره والردا",44,"د",2,0],["في الفيافي تسيلُ أوراقُكِ الحم","راءُ جرحاً فذوبَهنّ نزيفُ",45,"ف",1,0],["في ألف نوع من الأشجار سامقة","تجمِّل السوح والأحياء في الحضر",46,"ر",1,0],["في الفجرِ قرآنُ البزوغِ مُرتّلٌ","قد أيقظَ الأرواحَ والأجساما",47,"م",2,0],["في الف ليله والقصص والروايات","مرّه مهند واْغلب أحيان طوووني",48,"ن",2,0],["في الفقر عاش ومذ حانت منيته","كانت خزانته ملأى من الذهب",49,"ب",1,1],["في ألف شهرٍ جهرةً","سبوا الوصي على المنابر",50,"ر",1,0],["في الفيس ألف نميمة وشتيمةٍ","وتقاذف الطعنات بعض المهزلة",51,"ل",2,0],["في ألفٍ موج نازفٍ","جُعلتْ خياميَ مقبره",52,"ر",2,0],["في ألف صاعقة مجنونة وقعت","ولم يبال الهوى : من ظلّ ..من أفنى ..",53,"ن",2,0],["في الفُلْكِ تقذفهُ السنون ولم يصلْ","يوماً لشطِّ غرامك المقصودِ",54,"د",1,0],["في الفقر والاجتدا، في الرِّيِّ والبطرِ","في الجهل ، والاهتدا لوحدة البشرِ..",55,"ر",1,0],["في ألفِ بابٍ مصاريعُ العَطا فُتِحَتْ","سيلٌ تحمّلَ غيثَ العلمِ والحُلُما",56,"م",2,0],["في الفَجرِ يَحملُ نبضَهُ وَ يَفيضُ مَاءْ","يفنَى بذاكَ الظلِّ منْ بعدِ اسْتواءْ",57,"ا",2,1]]}