wan.net/poem33355.html","الرمل"],[413,"ويوم وقفنا دون أسنمة النقا","https://www.aldiwan.net/poem53880.html","الطويل"],[413,"سنا برق تبلج واستنارا","https://www.aldiwan.net/poem54050.html","الوافر"],[436,"بدا لك نجم السعد واطلع النجح","https://www.aldiwan.net/poem34791.html","الطويل"],[436,"هنيئا لهذا الدهر روح وريحان","https://www.aldiwan.net/poem34894.html","الطويل"],[436,"لك الله بالنصر العزيز كفيل","https://www.aldiwan.net/poem34919.html","الطويل"],[456,"رعت من تبالة جعدا لفيفا","https://www.aldiwan.net/poem56111.html","المتقارب"],[456,"أدمعك أم عارض ممطر","https://www.aldiwan.net/poem56182.html","المتقارب"],[456,"ما أنكرت إلا البياض فصدتِ","https://www.aldiwan.net/poem56266.html","الكامل"],[462,"لا تلمني فلات حين ملام","https://www.aldiwan.net/poem3141.html","عموديه"],[462,"وحنين ولكن أين منك زرود","https://www.aldiwan.net/poem3625.html","عموديه"],[464,"وحنت قلوصي بعد هدء صبابة","https://www.aldiwan.net/poem50378.html","الطويل"],[475,"همت غراما بالبروق اللمع","https://www.aldiwan.net/poem15223.html","الرجز"],[475,"ما الدمع بعد نوى الأحبة عار","https://www.aldiwan.net/poem15339.html","الكامل"],[477,"يا راكب الرتل السريع","https://www.aldiwan.net/poem37043.html","مجزوء الكامل"],[498,"كيف لا أندب الطلول غراما","https://www.aldiwan.net/poem37782.html","الخفيف"],[549,"على الربع ربع الراحلين سلامي","https://www.aldiwan.net/poem47207.html","الطويل"],[551,"أديرا علي الراح لا تشربا قبلي","https://www.aldiwan.net/poem68430.html","الطويل"],[556,"قمر من فوق غصن نقا","https://www.aldiwan.net/poem34336.html","المديد"]],"verses":[["وَحَنينِ مُلقاةِ الرِحالِ مُناخَةً","وَصَهيلِ واضِعَةِ السُروجِ عَواري",0,"ر",2,0],["وحَنّةٌ بِتُّ أسْتَبكي الخَليَّ بها","وقد بَدا منْ حِفافَيْ تُوضِحٍ عَلَمُ",1,"م",1,0],["وحَنَّ إِلى عَذَباتِ اللِّوى","ووادي الحِمى وإِلى مُنحَناهْ",2,"ا",2,0],["وحَنَّةٍ كأُوارِ النّارِ يُضْرِمُها","قَلبٌ تمَلّكَ رِقَّ المَدْمَعِ الهَتِنِ",3,"ن",1,0],["وَحَنَّ لِطَيْبَةٍ لِلنَّخْلِ طَيْفٌ","عَلَى حُجُرَاتِ سَاكِنِهَا السَّلاَمُ",4,"م",1,0],["وحَنيّةً تحْنو على سهْمِ الرّدى","فيُصيبُ شاكِلَةَ الرّميِّ سَديدُهُ",5,"د",2,0],["وَحَنَتْ بِهِ عُوجُ الْقِسِيِّ ضُلُوعَهَا","تَغْتَالُ فِيهِ جَوَانحاً وَقُلُوبَا",6,"ب",2,0],["وحنيني إلى مجالسه الزه","رِ حنيني إلى الصبا المعهودِ",7,"د",1,0],["وحنَّت إليكم وزاراتُهُمْ","فحنَّت إلى خير أوطانها",8,"ن",3,0],["وَحَنَت فَحَرَّكَتِ الفَتى وَإِذا بِهِ","جِسمٌ وَلَكِن لا حَياةَ بِهِ وَلا",9,"ا",1,0],["وَحَنَّتِ النوقُ إِلى سَمعِهِ","وَطَرِبَت مِن ذِكرِهِ الصافِنات",10,"ت",1,0],["وَحَنى عَلَيهِ يَضُمُّهُ وَدُموعُهُ","تَنهَلُّ مِثلَ العارِضِ الهَطّالِ",11,"ل",1,0],["وَحَنَّت إِلى أَرضِ العِراقِ حَمولَتي","وَما قَيظُ أَجوافِ العِراقِ بِطائِلِ",12,"ل",1,0],["وحَنَا عليها الدَّوْحُ في جَبَروتِهِ","بالظّلِّ والأَغصانِ والأَنْسامِ",13,"م",1,0],["وَحَنَّت قُلوصي فَاِستَمَعتُ لِسَجرِها","بِرَملَةِ لُدٍّ وَهيَ مَثنِيَّةٌ تَحبو",14,"ب",2,0],["وحنان آمنة كأم","ك في صباك الأول",15,"ل",1,0],["وَحَنَّت نَواقيسٌ وَرَنَّت مَآذِنٌ","وَرَفَّت وُجوهُ الأَرضِ تَستَقبِلُ السُلمى",16,"م",2,0],["وَحَنانِ آمِنَةٍ كَأُم","مِكَ في صِباكَ الأَوَّلِ",17,"ل",1,0],["وحَنّت المُزْنُ على قَبْرِهِ","بعَارِضٍ نَجْوتُهُ مَحْفِلُ",18,"ل",1,0],["وَحَنَّت حَنيناً مُنكَراً هَيَّجَت بِهِ","عَلى ذي هَوىً مِن شَوقِهِ ما تَنَكَّرا",19,"ر",2,0],["وحَنَّ الرَّعْدُ حتى خِلْ","تُه يَستَعْطِفُ الدِّيَما",20,"م",2,0],["وحنَتَه رأفتُه على زُوَّارِهِ","فأراهُمُ خَلَقَ النَّوائبِ ريفا",21,"ف",2,0],["وحَنَّ للجُودِ مُهْتَزَاً ومُنتَصِباً","كالرُّمحِ لم يُؤْتَ من مَيلٍ ولا أَوَدِ",22,"د",1,0],["وحنَّ حتى أجابَ النَّبْتُ حَنَّتَه","كأنه مذكِرٌ أشجانَها النِّيبا",23,"ب",2,0],["وحنَّت في رُباكِ العِيسُ حتى","كأنَّ طُلولَهُنَّ لَها سِقابُ",24,"ب",1,0],["وحنين قلب لا يثو","بُ إلى حيالٍ لا يلم",25,"م",1,0],["وحنيني في أنين غير فاني","للرَّدى أشربه من مقلتيكا",26,"ك",2,0],["وحنيني لك يكوي أعظمي","والثواني جمرات في دمي",27,"ي",1,0],["وحَنَتْ عَلَيْكَ من الجُدُودِ ذُؤابَةٌ","رَعَتِ الحُسَيْنَ وجَعْفَراً وعَقِيلا",28,"ل",2,0],["وَحَنَّ إِلى سَفَرٍ فَطارَ إِلى السُرى","يَخوضُ خَليجاً أَو يَجوبُ كَثيبا",29,"ب",2,0],["وَحَنَّ هَديلٌ عَلى بانَةٍ","تَصَدّى خَطيباً بِها أَخطَبا",30,"ب",2,0],["وَحَنَّ إِلَيهِ كُلُّ وِردٍ مُحَجَّلٍ","كَأَنَّ لُجَيناً سالَ مِنهُ عَلى تِبرِ",31,"ر",1,0],["وَحَنَّت رِكابي وَالهَوى يَبعَثُ الهَوى","فَلَم أَرَ في تَيماءَ إِلّا مُتَيَّما",32,"م",2,0],["وَحَنَّ إلَى بَانِ الغُصُونِ وَقَد شَدَا","بِصَوتِ يُنَاغِي الوَكرَ وَاللهُ غَالِبُ",33,"ب",1,0],["وَحَنَّ النايُ مِن طَرَبٍ وَشَوقٍ","إِلى وَتَرٍ يُجاوِبُهُ فَصيحُ",34,"ح",1,0],["وَحَنَّ شِريانٌ وَنَبعٌ وَصَخَب","تَتَرَّسوا مِنَ القِتالِ بِالهَرَب",35,"ب",1,0],["وحَنا جَوانحَ صَدرِهِ مَملوءةً","عِلماً بما يأتي منَ الحِدْثان",36,"ن",1,0],["وحَنَوا على جَمرٍ ضُلُوعَهمُ","فكأنّما أنفاسُهُمْ شَرَرُ",37,"ر",1,0],["وَحَنَّ مَخمورٌ إِلى خَمرَةٍ","وَجاءَكَ الغَيثُ عَلى قَدرِ",38,"ر",1,0],["وَحَنى بائِسٌ عَلى القُربِ جيداً","لِوَداعٍ وَالعَيسُ مِثلُ الحَنايا",39,"ا",3,0],["وَحَنَّت قَلوصي بَعدَ وَهنٍ وَهاجَها","مَعَ الشَوقِ يَوماً بِالحِجازِ وَميضُ",40,"ض",1,0],["وحَنَّ مِنْ بَيْنِها الكُثْبانُ عنْ نَغَمٍ","تُبْدِي عَنِ الصَّبِّ ما تُخْفي ضَمائِرُهُ",41,"ر",2,0],["وَحنى ظهره توالي اللَيالي","فهو إِن همَّ لا يطيق اِعتدالا",42,"ل",2,0],["وحنوّاً عَلى اليَتامى وَعَقلاً","أَكبرته جاراتها إكبارا",43,"ر",2,0],["وحنايةُ الحسنِ الغريرِ إذا رمى","فشريقُ دمعٍ أو غريقُ دماءِ",44,"ا",2,0],["وحناناً مُجسَّداً إنْ طواني الْ","لَيلُ وَسَّدْتُ صدرَهُ آلامي",45,"ي",1,0],["وَحَنَّ إِلى الحِجازِ القَلبُ مِنّي","فَهاجَ غَرامُهُ بَعدَ السُكونِ",46,"ن",1,0],["وحنانا بضريحٍ طالما","صقلته قبلات الطائفين",47,"ن",1,0],["وحنَّتْ إلى البَرَّ مشتاقةً","إليه كما حنَّتِ الثاكِلُ",48,"ل",1,0],["وحنَتْ إليه مثلما","يحنو إلى الحِبّ الحبيب",49,"ب",1,0],["وحنا عليك حنوَّ مرْ","ضِعةِ الفطيم على الفطيم",50,"م",1,0],["وحنية تحنو على سهم الردى","فيصيب شالكة الرمي سديده",51,"د",2,0],["وحنين قلب لا يثوب","إلى خيالٍ لا يلمْ",52,"م",1,0],["وحَنَّتْ نواقيسٌ، ورَنّتْ مآذنٌ","ورَقَّتْ وجوهُ الأَرضِ تَستقبلُ السلمى",53,"م",2,0],["وَحَنين إِلى الدِيار وَوَجد","يَستَفز النُهى وَشَوق الحا",54,"ح",2,0],["وَحَنين هَينمة الرِياح عَشية","وَتُرسل الأَطيار في الأَسحار",55,"ر",1,0],["وحندس الليل مرخاة كلاكله","وموج داجيه هدار بغلغال",56,"ل",1,0],["وحنانا رحمت احزان يعقو","ب واكرمت عينه بالضياء",57,"ا",2,0],["وحنين من طي دائرة الأك","وان يبدي رقائق الاعتذار",58,"ر",1,0],["وحن قلبي إلى نومٍ تخادعني","أضغاث أحلامه والليل نعسان",59,"ن",1,0],["وحنيني عليكُمُ وأَنيني","كيفَ أخفي هواىَ والحالُ بادِي",60,"ي",1,0],["وَحنتَمَةٌ نَجلُ المُغِيرِة هَاشِمٌ","أبُوهَا ابنُها الفَارُوقُ ذُو المَجدش والفَخرِ",61,"ر",1,0],["وَحَنَّت كَما حَنَّ المُحِبُّ لِوَصلِهِ","حَرامٌ عَلى الأَيّامِ إِيجادُ مِثلِهِ",62,"ه",1,0],["وحن إلى علياك شوقا ودلها","على عورة تمطيك مركبها الوعرا",63,"ر",2,0],["وحن لافق حنت الشمس نحوه","وودت به لو تيطلع الانجم الزهر",64,"ر",1,0],["وَحَنَّت قَلُوصِى مِن عَدَانَ إِلى نَجدِ","وَلَم يُنسِهَا أَوطَانَهَا قِدَمُ العَهدِ",65,"د",1,0],["وحنّت إلى ماء العقيق وأهله","حنين التي عن طيّب العيش زلت",66,"ت",1,0],["وحنَت لهَيبَتِهِ الملوكُ رؤوسَها","ولمن تلاهُ من بني مروانِ",67,"ن",1,0],["وحنَّت إلى سَجَعِ الحَمامِ كأنَّه","رنينُ الحُلى إذ لاعبتْها صُدورها",68,"ر",3,0],["وَحَنينٌ عَلى جَناحَيكَ مَقبو","ضٌ وَوجدٌ مِن قَلبهِ مَسلولُ",69,"ل",1,0],["وحنَّت إليك المَرْوتان وزمزم","وثوْبَ تصريحاً بك الركنُ والحِجْرُ",70,"ر",1,0],["وحنّ إليه الجذع عند فراقه","كما حنّ مسلوب القرين مفجع",71,"ع",1,0],["وَحَنَّت إِلى أَن يَبذُلَ العُرفُ كَفَّهُ","كَما حَنَّتِ الأُمُّ الرَقوبُ إِلى الطِفلِ",72,"ل",1,0],["وَحَنا عَلَيَّ فَرَدَّ لي زَمَنَ الصِبا ال","ماضي وَأَيّامَ الشَبابِ الذاهِبِ",73,"ب",1,0],["وَحَنَّ مِنْ بَيْنِهِ الْجِذْعُ وَكَلَّمَهُ","ضَبُّ الْفَلاَةِ بِمَا غَاظَ الْمُعَادِينَا",74,"ن",2,0],["وَحَنَّ الْجِذْعُ لَمَّا بَانَ عَنْهُ","إِلَيْهِ حَنِينَ مَفْقُودِ الْجَنِينِ",75,"ن",1,0],["وحنت عليَّ تقولُ ما هذا الضَّنى","فلقد عَهدتُكَ غُصنَ وردٍ مُزهِرا",76,"ر",2,0],["وحنت وقالت منك طيبُ غلائلي","فلأذكُرنَّكَ ما نَشرتُ غَلائلا",77,"ل",2,0],["وحنت لتنشقَ وردةً فرأيتُها","أختاً تقبِّل أختَها بتوجّد",78,"د",1,0],["وَحَنّ القَلب أعْشاراً إلَيها","حَنِينَ الوالِهات مِن العشارِ",79,"ر",1,0],["وحنَّ فؤادُه شَوقاً لنجدٍ","وأَينَ الهندُ من نجدٍ وأَنّى",80,"ن",2,0],["وحنَّ إليه الجذعُ بعد فِراقه","فَراح لما قد نالَه يتحطَّمُ",81,"م",1,0],["وَحنينُ وَرقاءٍ علَى فتنِ ضحىً","وَرجاءُ ذي مقةٍ وَلوعة مولع",82,"ع",1,0],["وحنينا يشوقُ فاقدةَ النِّي","بِ فتنسَى صريفَها والرُّغاءَ",83,"ا",2,0],["وحنت لتذكار الليالي التي خلت","لنا بين هاتيك الربوع الأنيسة",84,"ه",1,0],["وحنيني إليك وهو يميني","أنقذيني من حرقة الزفرات",85,"ت",1,0],["وحنين شاد موجع","يهفو إلى الوكر الحبيب",86,"ب",1,0],["وحنيني للقاء وعناق","فترنّم بأهازيج الهيام",87,"م",1,0],["وحنين يا حبيبي","فيه شجو وعزاء",88,"ا",2,0],["وَحَنى دَوحه عَلَينا فَشمنا","مِن قُدود الحِسان ما طابَ شَكلا",89,"ل",2,0],["وَحَنَّ لَهُ الجذع اِشتِياقاً وَلَهفَةً","عَلى بُعدِهِ لَمّا تَخَطّاهُ يَخطبُ",90,"ب",1,0],["وَحَنَّ إِلى وَصلٍ يُجَدِّدُ رَسمَهُ","فَأَعمَلَ مِن بُعدٍ نَجاءَ الرَواسِمِ",91,"م",1,0],["وحَنَنْتُ حَنّةَ واجدٍ طَرِبٍ","وذكرتُ صُحبةَ أهلِه دَهرا",92,"ر",2,0],["وحنوُّها أحنى حَنِيِّ ضلوعِها","منها بمنزلة السرير يهوِّم",93,"م",1,0],["وَحَنين الحَمام في الدَوح يَشدو","كَأَنين المُتَيم المِقلاق",94,"ق",1,0],["وَحَنين نَأي يَنفخ الأَرواح في","صَرعى العَنا وَالوَجد وَالاَهواءِ",95,"ا",2,0],["وحنت فوقه شجيرة ورد","تخذتها الأشلاء في القبر ظلاّ",96,"ل",2,0],["وحنيناً سل بها أبطالها","كم بها أردى من الكفر كميا",97,"ي",2,0],["وحنَّتْ نياق الركب حتَّى وجدتني","وَجَدْتَ لها تحت الضلوع لهيبا",98,"ب",2,0],["وحنَّتْ أنيقي وبكَتْ رفاقي","وأرسَلَتِ الدُّموع لها غزارا",99,"ر",2,0],["وحَنَّتْ إِلَى يَومِ اللِّقاءِ سَوَابِحٌ","لَهَا فِي بِحارِ المَوْتِ نَحْوَ العِدى سَبْحُ",100,"ح",1,0],["وَحَنَّتْ لِدَاعِي الصُّلحِ بكْرٌ وتغلبٌ","وشَفَّعَتِ الأَرْحامَ عبسٌ وذُبيانُ",101,"ن",1,0],["وَحنَّانَةِ الأَوتَارِ فِي كلِّ مهجةٍ","لعاصيكَ أَوْتَارٌ لَهَا وَذُحُولُ",102,"ل",1,0],["وحنَّت لأيّامها بالبطاح","فمدّت وراء صليف صليفا",103,"ف",2,0],["وحنَّت فَدرَّتْ على أرضها","سماءٌ تبوح بما تُضمِرُ",104,"ر",1,0],["وحننتُ نحوكِ حَنَّةً عربيّةً","عِيبت وتُعذرُ ناقةٌ إن حنّتِ",105,"ت",1,0],["وحنيني إلى الشآم ولا مثل حن","يني وقد ثوى بالشآمِ",106,"م",1,0],["وحنينٌ ولكنْ أين منك زرودْ","وشوقٌ ولكنَّ المزار بعيدُ",107,"د",1,1],["وَحَنَّت قُلوصي بَعدَ هُدءِ صَبابَة