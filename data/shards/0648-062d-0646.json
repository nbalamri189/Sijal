40825.html","الطويل"],[365,"طلعت علينا من سماء المكارم","https://www.aldiwan.net/poem60662.html","الطويل"],[365,"ذكر المعسكر صاحبي ذكرا","https://www.aldiwan.net/poem60913.html","أحذ الكامل"],[378,"لو كان للأفلاك نطق أو فم","https://www.aldiwan.net/poem59270.html","الكامل"],[381,"لو يكون اللقاء باستحقاق","https://www.aldiwan.net/poem49203.html","الخفيف"],[381,"مزجت دموع جفونه بدماء","https://www.aldiwan.net/poem49210.html","الكامل"],[395,"قيس وليلى","https://www.aldiwan.net/poem24310.html","عموديه"],[404,"تحفة تهدى لمن يهوى عليا","https://www.aldiwan.net/poem33355.html","الرمل"],[417,"ويوم وقفنا دون أسنمة النقا","https://www.aldiwan.net/poem53880.html","الطويل"],[417,"سنا برق تبلج واستنارا","https://www.aldiwan.net/poem54050.html","الوافر"],[440,"بدا لك نجم السعد واطلع النجح","https://www.aldiwan.net/poem34791.html","الطويل"],[440,"هنيئا لهذا الدهر روح وريحان","https://www.aldiwan.net/poem34894.html","الطويل"],[440,"لك الله بالنصر العزيز كفيل","https://www.aldiwan.net/poem34919.html","الطويل"],[459,"رعت من تبالة جعدا لفيفا","https://www.aldiwan.net/poem56111.html","المتقارب"],[459,"أدمعك أم عارض ممطر","https://www.aldiwan.net/poem56182.html","المتقارب"],[459,"ما أنكرت إلا البياض فصدتِ","https://www.aldiwan.net/poem56266.html","الكامل"],[465,"لا تلمني فلات حين ملام","https://www.aldiwan.net/poem3141.html","عموديه"],[465,"وحنين ولكن أين منك زرود","https://www.aldiwan.net/poem3625.html","عموديه"],[467,"وحنت قلوصي بعد هدء صبابة","https://www.aldiwan.net/poem50378.html","الطويل"],[478,"همت غراما بالبروق اللمع","https://www.aldiwan.net/poem15223.html","الرجز"],[478,"ما الدمع بعد نوى الأحبة عار","https://www.aldiwan.net/poem15339.html","الكامل"],[480,"يا راكب الرتل السريع","https://www.aldiwan.net/poem37043.html","مجزوء الكامل"],[501,"كيف لا أندب الطلول غراما","https://www.aldiwan.net/poem37782.html","الخفيف"],[552,"على الربع ربع الراحلين سلامي","https://www.aldiwan.net/poem47207.html","الطويل"],[554,"أديرا علي الراح لا تشربا قبلي","https://www.aldiwan.net/poem68430.html","الطويل"],[559,"قمر من فوق غصن نقا","https://www.aldiwan.net/poem34336.html","المديد"]],"verses":[["وَحَنينِ مُلقاةِ الرِحالِ مُناخَةً","وَصَهيلِ واضِعَةِ السُروجِ عَواري",0,"ر",2,0],["وحَنّةٌ بِتُّ أسْتَبكي الخَليَّ بها","وقد بَدا منْ حِفافَيْ تُوضِحٍ عَلَمُ",1,"م",1,0],["وحَنَّ إِلى عَذَباتِ اللِّوى","ووادي الحِمى وإِلى مُنحَناهْ",2,"ا",2,0],["وحَنَّةٍ كأُوارِ النّارِ يُضْرِمُها","قَلبٌ تمَلّكَ رِقَّ المَدْمَعِ الهَتِنِ",3,"ن",1,0],["وحنان وانتظار خائف","ورجاء كابتسام الغادر",4,"ر",1,0],["وَحَنَّ لِطَيْبَةٍ لِلنَّخْلِ طَيْفٌ","عَلَى حُجُرَاتِ سَاكِنِهَا السَّلاَمُ",5,"م",1,0],["وحَنيّةً تحْنو على سهْمِ الرّدى","فيُصيبُ شاكِلَةَ الرّميِّ سَديدُهُ",6,"د",2,0],["وَحَنَتْ بِهِ عُوجُ الْقِسِيِّ ضُلُوعَهَا","تَغْتَالُ فِيهِ جَوَانحاً وَقُلُوبَا",7,"ب",2,0],["وحنيني إلى مجالسه الزه","رِ حنيني إلى الصبا المعهودِ",8,"د",1,0],["وحنَّت إليكم وزاراتُهُمْ","فحنَّت إلى خير أوطانها",9,"ن",3,0],["وَحَنَت فَحَرَّكَتِ الفَتى وَإِذا بِهِ","جِسمٌ وَلَكِن لا حَياةَ بِهِ وَلا",10,"ا",1,0],["وَحَنَّتِ النوقُ إِلى سَمعِهِ","وَطَرِبَت مِن ذِكرِهِ الصافِنات",11,"ت",1,0],["وَحَنى عَلَيهِ يَضُمُّهُ وَدُموعُهُ","تَنهَلُّ مِثلَ العارِضِ الهَطّالِ",12,"ل",1,0],["وَحَنَّت إِلى أَرضِ العِراقِ حَمولَتي","وَما قَيظُ أَجوافِ العِراقِ بِطائِلِ",13,"ل",1,0],["وحَنَا عليها الدَّوْحُ في جَبَروتِهِ","بالظّلِّ والأَغصانِ والأَنْسامِ",14,"م",1,0],["وَحَنَّت قُلوصي فَاِستَمَعتُ لِسَجرِها","بِرَملَةِ لُدٍّ وَهيَ مَثنِيَّةٌ تَحبو",15,"ب",2,0],["وحنان آمنة كأم","ك في صباك الأول",16,"ل",1,0],["وَحَنَّت نَواقيسٌ وَرَنَّت مَآذِنٌ","وَرَفَّت وُجوهُ الأَرضِ تَستَقبِلُ السُلمى",17,"م",2,0],["وَحَنانِ آمِنَةٍ كَأُم","مِكَ في صِباكَ الأَوَّلِ",18,"ل",1,0],["وحَنّت المُزْنُ على قَبْرِهِ","بعَارِضٍ نَجْوتُهُ مَحْفِلُ",19,"ل",1,0],["وَحَنَّت حَنيناً مُنكَراً هَيَّجَت بِهِ","عَلى ذي هَوىً مِن شَوقِهِ ما تَنَكَّرا",20,"ر",2,0],["وحَنَّ الرَّعْدُ حتى خِلْ","تُه يَستَعْطِفُ الدِّيَما",21,"م",2,0],["وحنَتَه رأفتُه على زُوَّارِهِ","فأراهُمُ خَلَقَ النَّوائبِ ريفا",22,"ف",2,0],["وحَنَّ للجُودِ مُهْتَزَاً ومُنتَصِباً","كالرُّمحِ لم يُؤْتَ من مَيلٍ ولا أَوَدِ",23,"د",1,0],["وحنَّ حتى أجابَ النَّبْتُ حَنَّتَه","كأنه مذكِرٌ أشجانَها النِّيبا",24,"ب",2,0],["وحنَّت في رُباكِ العِيسُ حتى","كأنَّ طُلولَهُنَّ لَها سِقابُ",25,"ب",1,0],["وحنين قلب لا يثو","بُ إلى حيالٍ لا يلم",26,"م",1,0],["وحنيني في أنين غير فاني","للرَّدى أشربه من مقلتيكا",27,"ك",2,0],["وحنيني لك يكوي أعظمي","والثواني جمرات في دمي",28,"ي",1,0],["وحَنَتْ عَلَيْكَ من الجُدُودِ ذُؤابَةٌ","رَعَتِ الحُسَيْنَ وجَعْفَراً وعَقِيلا",29,"ل",2,0],["وَحَنَّ إِلى سَفَرٍ فَطارَ إِلى السُرى","يَخوضُ خَليجاً أَو يَجوبُ كَثيبا",30,"ب",2,0],["وَحَنَّ هَديلٌ عَلى بانَةٍ","تَصَدّى خَطيباً بِها أَخطَبا",31,"ب",2,0],["وَحَنَّ إِلَيهِ كُلُّ وِردٍ مُحَجَّلٍ","كَأَنَّ لُجَيناً سالَ مِنهُ عَلى تِبرِ",32,"ر",1,0],["وَحَنَّت رِكابي وَالهَوى يَبعَثُ الهَوى","فَلَم أَرَ في تَيماءَ إِلّا مُتَيَّما",33,"م",2,0],["وَحَنَّ إلَى بَانِ الغُصُونِ وَقَد شَدَا","بِصَوتِ يُنَاغِي الوَكرَ وَاللهُ غَالِبُ",34,"ب",1,0],["وَحَنَّ النايُ مِن طَرَبٍ وَشَوقٍ","إِلى وَتَرٍ يُجاوِبُهُ فَصيحُ",35,"ح",1,0],["وَحَنَّ شِريانٌ وَنَبعٌ وَصَخَب","تَتَرَّسوا مِنَ القِتالِ بِالهَرَب",36,"ب",1,0],["وحَنا جَوانحَ صَدرِهِ مَملوءةً","عِلماً بما يأتي منَ الحِدْثان",37,"ن",1,0],["وحَنَوا على جَمرٍ ضُلُوعَهمُ","فكأنّما أنفاسُهُمْ شَرَرُ",38,"ر",1,0],["وَحَنَّ مَخمورٌ إِلى خَمرَةٍ","وَجاءَكَ الغَيثُ عَلى قَدرِ",39,"ر",1,0],["وَحَنى بائِسٌ عَلى القُربِ جيداً","لِوَداعٍ وَالعَيسُ مِثلُ الحَنايا",40,"ا",3,0],["وَحَنَّت قَلوصي بَعدَ وَهنٍ وَهاجَها","مَعَ الشَوقِ يَوماً بِالحِجازِ وَميضُ",41,"ض",1,0],["وحَنَّ مِنْ بَيْنِها الكُثْبانُ عنْ نَغَمٍ","تُبْدِي عَنِ الصَّبِّ ما تُخْفي ضَمائِرُهُ",42,"ر",2,0],["وَحنى ظهره توالي اللَيالي","فهو إِن همَّ لا يطيق اِعتدالا",43,"ل",2,0],["وحنوّاً عَلى اليَتامى وَعَقلاً","أَكبرته جاراتها إكبارا",44,"ر",2,0],["وحنايةُ الحسنِ الغريرِ إذا رمى","فشريقُ دمعٍ أو غريقُ دماءِ",45,"ا",2,0],["وحناناً مُجسَّداً إنْ طواني الْ","لَيلُ وَسَّدْتُ صدرَهُ آلامي",46,"ي",1,0],["وحنّ إلى ظلالك عبد شمس","يريح شجونه ظمأى طلاحا",47,"ح",2,0],["وَحَنَّ إِلى الحِجازِ القَلبُ مِنّي","فَهاجَ غَرامُهُ بَعدَ السُكونِ",48,"ن",1,0],["وحنانا بضريحٍ طالما","صقلته قبلات الطائفين",49,"ن",1,0],["وحنَّتْ إلى البَرَّ مشتاقةً","إليه كما حنَّتِ الثاكِلُ",50,"ل",1,0],["وحنَتْ إليه مثلما","يحنو إلى الحِبّ الحبيب",51,"ب",1,0],["وحنا عليك حنوَّ مرْ","ضِعةِ الفطيم على الفطيم",52,"م",1,0],["وحنية تحنو على سهم الردى","فيصيب شالكة الرمي سديده",53,"د",2,0],["وحنت تنشد الخلود ليغفو","بين أحضانها إله الخلود",54,"د",1,0],["وحنا اليقين على الجحودو ما حنا","إلا على الخلصاء والأتراب",55,"ب",1,0],["وحنت فاطم تضمّ فتاها","لهفة الأمّ فوجئت بالوحيد",56,"د",1,0],["وحنا على بؤس العفاة فما رأوا","من عثرة إلاّ رأوه مقيلا",57,"ل",2,0],["وحنت على النفس الأثيم فابصرت","إثم النفوس على النفوس دخيلا",57,"ل",2,0],["وحنين إلى السماء كما حنّ","إلى نعمة الشفاء العليل",58,"ل",1,0],["وحنين قلب لا يثوب","إلى خيالٍ لا يلمْ",59,"م",1,0],["وحَنَّتْ نواقيسٌ، ورَنّتْ مآذنٌ","ورَقَّتْ وجوهُ الأَرضِ تَستقبلُ السلمى",60,"م",2,0],["وَحَنين إِلى الدِيار وَوَجد","يَستَفز النُهى وَشَوق الحا",61,"ح",2,0],["وَحَنين هَينمة الرِياح عَشية","وَتُرسل الأَطيار في الأَسحار",62,"ر",1,0],["وحندس الليل مرخاة كلاكله","وموج داجيه هدار بغلغال",63,"ل",1,0],["وحنانا رحمت احزان يعقو","ب واكرمت عينه بالضياء",64,"ا",2,0],["وحنين من طي دائرة الأك","وان يبدي رقائق الاعتذار",65,"ر",1,0],["وحن قلبي إلى نومٍ تخادعني","أضغاث أحلامه والليل نعسان",66,"ن",1,0],["وحنيني عليكُمُ وأَنيني","كيفَ أخفي هواىَ والحالُ بادِي",67,"د",2,0],["وَحنتَمَةٌ نَجلُ المُغِيرِة هَاشِمٌ","أبُوهَا ابنُها الفَارُوقُ ذُو المَجدش والفَخرِ",68,"ر",1,0],["وَحَنَّت كَما حَنَّ المُحِبُّ لِوَصلِهِ","حَرامٌ عَلى الأَيّامِ إِيجادُ مِثلِهِ",69,"ه",1,0],["وحن إلى علياك شوقا ودلها","على عورة تمطيك مركبها الوعرا",70,"ر",2,0],["وحن لافق حنت الشمس نحوه","وودت به لو تيطلع الانجم الزهر",71,"ر",1,0],["وَحَنَّت قَلُوصِى مِن عَدَانَ إِلى نَجدِ","وَلَم يُنسِهَا أَوطَانَهَا قِدَمُ العَهدِ",72,"د",1,0],["وحنّت إلى ماء العقيق وأهله","حنين التي عن طيّب العيش زلت",73,"ت",1,0],["وحنَت لهَيبَتِهِ الملوكُ رؤوسَها","ولمن تلاهُ من بني مروانِ",74,"ن",1,0],["وحنَّت إلى سَجَعِ الحَمامِ كأنَّه","رنينُ الحُلى إذ لاعبتْها صُدورها",75,"ر",3,0],["وَحَنينٌ عَلى جَناحَيكَ مَقبو","ضٌ وَوجدٌ مِن قَلبهِ مَسلولُ",76,"ل",1,0],["وحنَّت إليك المَرْوتان وزمزم","وثوْبَ تصريحاً بك الركنُ والحِجْرُ",77,"ر",1,0],["وحنّ إليه الجذع عند فراقه","كما حنّ مسلوب القرين مفجع",78,"ع",1,0],["وَحَنَّت إِلى أَن يَبذُلَ العُرفُ كَفَّهُ","كَما حَنَّتِ الأُمُّ الرَقوبُ إِلى الطِفلِ",79,"ل",1,0],["وَحَنا عَلَيَّ فَرَدَّ لي زَمَنَ الصِبا ال","ماضي وَأَيّامَ الشَبابِ الذاهِبِ",80,"ب",1,0],["وَحَنَّ مِنْ بَيْنِهِ الْجِذْعُ وَكَلَّمَهُ","ضَبُّ الْفَلاَةِ بِمَا غَاظَ الْمُعَادِينَا",81,"ن",2,0],["وَحَنَّ الْجِذْعُ لَمَّا بَانَ عَنْهُ","إِلَيْهِ حَنِينَ مَفْقُودِ الْجَنِينِ",82,"ن",1,0],["وحنت عليَّ تقولُ ما هذا الضَّنى","فلقد عَهدتُكَ غُصنَ وردٍ مُزهِرا",83,"ر",2,0],["وحنت وقالت منك طيبُ غلائلي","فلأذكُرنَّكَ ما نَشرتُ غَلائلا",84,"ل",2,0],["وحنت لتنشقَ وردةً فرأيتُها","أختاً تقبِّل أختَها بتوجّد",85,"د",1,0],["وَحَنّ القَلب أعْشاراً إلَيها","حَنِينَ الوالِهات مِن العشارِ",86,"ر",1,0],["وحنَّ فؤادُه شَوقاً لنجدٍ","وأَينَ الهندُ من نجدٍ وأَنّى",87,"ن",2,0],["وحنَّ إليه الجذعُ بعد فِراقه","فَراح لما قد نالَه يتحطَّمُ",88,"م",1,0],["وَحنينُ وَرقاءٍ علَى فتنِ ضحىً","وَرجاءُ ذي مقةٍ وَلوعة مولع",89,"ع",1,0],["وحنينا يشوقُ فاقدةَ النِّي","بِ فتنسَى صريفَها والرُّغاءَ",90,"ا",2,0],["وحنت لتذكار الليالي التي خلت","لنا بين هاتيك الربوع الأنيسة",91,"ه",1,0],["وحنيني إليك وهو يميني","أنقذيني من حرقة الزفرات",92,"ت",1,0],["وحنين شاد موجع","يهفو إلى الوكر الحبيب",93,"ب",1,0],["وحنيني للقاء وعناق","فترنّم بأهازيج الهيام",94,"م",1,0],["وحنين يا حبيبي","فيه شجو وعزاء",95,"ا",2,0],["وَحَنى دَوحه عَلَينا فَشمنا","مِن قُدود الحِسان ما طابَ شَكلا",96,"ل",2,0],["وَحَنَّ لَهُ الجذع اِشتِياقاً وَلَهفَةً","عَلى بُعدِهِ لَمّا تَخَطّاهُ يَخطبُ",97,"ب",1,0],["وَحَنَّ إِلى وَصلٍ يُجَدِّدُ رَسمَهُ","فَأَعمَلَ مِن بُعدٍ نَجاءَ الرَواسِمِ",98,"م",1,0],["وحَنَنْتُ حَنّةَ واجدٍ طَرِبٍ","وذكرتُ صُحبةَ أهلِه دَهرا",99,"ر",2,0],["وحنوُّها أحنى حَنِيِّ ضلوعِها","منها بمنزلة السرير يهوِّم",100,"م",1,0],["وَحَنين الحَمام في الدَوح يَشد