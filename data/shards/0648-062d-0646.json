,"ترحيبيه بالإمير فهد بن بدر آل سعود","https://www.poetsgate.com/ViewPoem.aspx?id=60995",""],[6008,"الجوف زانت","https://www.poetsgate.com/ViewPoem.aspx?id=60997",""],[6038,"علامك غيوبي","https://www.poetsgate.com/ViewPoem.aspx?id=25686",""],[6100,"حضرة جناب الفقر","https://www.poetsgate.com/ViewPoem.aspx?id=52597",""],[6102,"منة","https://www.poetsgate.com/ViewPoem.aspx?id=185063",""],[5724,"يا ليل ظلامك يحبسني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55136&r=&rc=3",""],[6183,"يَا بيتنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79812&r=&rc=2",""],[6225,"ُمراودة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80918&r=&rc=187",""],[6225,"إزالة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78009&r=&rc=95",""],[6318,"فلق الصباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66162&r=&rc=12",""]],"verses":[["وَحَنينِ مُلقاةِ الرِحالِ مُناخَةً","وَصَهيلِ واضِعَةِ السُروجِ عَواري",0,"ر",2,0],["وحَنّةٌ بِتُّ أسْتَبكي الخَليَّ بها","وقد بَدا منْ حِفافَيْ تُوضِحٍ عَلَمُ",1,"م",1,0],["وحَنَّ إِلى عَذَباتِ اللِّوى","ووادي الحِمى وإِلى مُنحَناهْ",2,"ا",2,0],["وحَنَّةٍ كأُوارِ النّارِ يُضْرِمُها","قَلبٌ تمَلّكَ رِقَّ المَدْمَعِ الهَتِنِ",3,"ن",1,0],["وحنان وانتظار خائف","ورجاء كابتسام الغادر",4,"ر",1,0],["وَحَنَّ لِطَيْبَةٍ لِلنَّخْلِ طَيْفٌ","عَلَى حُجُرَاتِ سَاكِنِهَا السَّلاَمُ",5,"م",1,0],["وحَنيّةً تحْنو على سهْمِ الرّدى","فيُصيبُ شاكِلَةَ الرّميِّ سَديدُهُ",6,"د",2,0],["وَحَنَتْ بِهِ عُوجُ الْقِسِيِّ ضُلُوعَهَا","تَغْتَالُ فِيهِ جَوَانحاً وَقُلُوبَا",7,"ب",2,0],["وحنيني إلى مجالسه الزه","رِ حنيني إلى الصبا المعهودِ",8,"د",1,0],["وحنَّت إليكم وزاراتُهُمْ","فحنَّت إلى خير أوطانها",9,"ن",3,0],["وَحَنَت فَحَرَّكَتِ الفَتى وَإِذا بِهِ","جِسمٌ وَلَكِن لا حَياةَ بِهِ وَلا",10,"ا",1,0],["وَحَنَّتِ النوقُ إِلى سَمعِهِ","وَطَرِبَت مِن ذِكرِهِ الصافِنات",11,"ت",1,0],["وَحَنى عَلَيهِ يَضُمُّهُ وَدُموعُهُ","تَنهَلُّ مِثلَ العارِضِ الهَطّالِ",12,"ل",1,0],["وَحَنَّت إِلى أَرضِ العِراقِ حَمولَتي","وَما قَيظُ أَجوافِ العِراقِ بِطائِلِ",13,"ل",1,0],["وحَنَا عليها الدَّوْحُ في جَبَروتِهِ","بالظّلِّ والأَغصانِ والأَنْسامِ",14,"م",1,0],["وَحَنَّت قُلوصي فَاِستَمَعتُ لِسَجرِها","بِرَملَةِ لُدٍّ وَهيَ مَثنِيَّةٌ تَحبو",15,"ب",2,0],["وحنان آمنة كأم","ك في صباك الأول",16,"ل",1,0],["وَحَنَّت نَواقيسٌ وَرَنَّت مَآذِنٌ","وَرَفَّت وُجوهُ الأَرضِ تَستَقبِلُ السُلمى",17,"م",2,0],["وَحَنانِ آمِنَةٍ كَأُم","مِكَ في صِباكَ الأَوَّلِ",18,"ل",1,0],["وحَنّت المُزْنُ على قَبْرِهِ","بعَارِضٍ نَجْوتُهُ مَحْفِلُ",19,"ل",1,0],["وَحَنَّت حَنيناً مُنكَراً هَيَّجَت بِهِ","عَلى ذي هَوىً مِن شَوقِهِ ما تَنَكَّرا",20,"ر",2,0],["وحَنَّ الرَّعْدُ حتى خِلْ","تُه يَستَعْطِفُ الدِّيَما",21,"م",2,0],["وحنَتَه رأفتُه على زُوَّارِهِ","فأراهُمُ خَلَقَ النَّوائبِ ريفا",22,"ف",2,0],["وحَنَّ للجُودِ مُهْتَزَاً ومُنتَصِباً","كالرُّمحِ لم يُؤْتَ من مَيلٍ ولا أَوَدِ",23,"د",1,0],["وحنَّ حتى أجابَ النَّبْتُ حَنَّتَه","كأنه مذكِرٌ أشجانَها النِّيبا",24,"ب",2,0],["وحنَّت في رُباكِ العِيسُ حتى","كأنَّ طُلولَهُنَّ لَها سِقابُ",25,"ب",1,0],["وحنين قلب لا يثو","بُ إلى حيالٍ لا يلم",26,"م",1,0],["وحنيني في أنين غير فاني","للرَّدى أشربه من مقلتيكا",27,"ك",2,0],["وحنيني لك يكوي أعظمي","والثواني جمرات في دمي",28,"ي",1,0],["وحَنَتْ عَلَيْكَ من الجُدُودِ ذُؤابَةٌ","رَعَتِ الحُسَيْنَ وجَعْفَراً وعَقِيلا",29,"ل",2,0],["وَحَنَّ إِلى سَفَرٍ فَطارَ إِلى السُرى","يَخوضُ خَليجاً أَو يَجوبُ كَثيبا",30,"ب",2,0],["وَحَنَّ هَديلٌ عَلى بانَةٍ","تَصَدّى خَطيباً بِها أَخطَبا",31,"ب",2,0],["وَحَنَّ إِلَيهِ كُلُّ وِردٍ مُحَجَّلٍ","كَأَنَّ لُجَيناً سالَ مِنهُ عَلى تِبرِ",32,"ر",1,0],["وَحَنَّت رِكابي وَالهَوى يَبعَثُ الهَوى","فَلَم أَرَ في تَيماءَ إِلّا مُتَيَّما",33,"م",2,0],["وَحَنَّ إلَى بَانِ الغُصُونِ وَقَد شَدَا","بِصَوتِ يُنَاغِي الوَكرَ وَاللهُ غَالِبُ",34,"ب",1,0],["وَحَنَّ النايُ مِن طَرَبٍ وَشَوقٍ","إِلى وَتَرٍ يُجاوِبُهُ فَصيحُ",35,"ح",1,0],["وَحَنَّ شِريانٌ وَنَبعٌ وَصَخَب","تَتَرَّسوا مِنَ القِتالِ بِالهَرَب",36,"ب",1,0],["وحَنا جَوانحَ صَدرِهِ مَملوءةً","عِلماً بما يأتي منَ الحِدْثان",37,"ن",1,0],["وحَنَوا على جَمرٍ ضُلُوعَهمُ","فكأنّما أنفاسُهُمْ شَرَرُ",38,"ر",1,0],["وَحَنَّ مَخمورٌ إِلى خَمرَةٍ","وَجاءَكَ الغَيثُ عَلى قَدرِ",39,"ر",1,0],["وَحَنى بائِسٌ عَلى القُربِ جيداً","لِوَداعٍ وَالعَيسُ مِثلُ الحَنايا",40,"ا",3,0],["وَحَنَّت قَلوصي بَعدَ وَهنٍ وَهاجَها","مَعَ الشَوقِ يَوماً بِالحِجازِ وَميضُ",41,"ض",1,0],["وحَنَّ مِنْ بَيْنِها الكُثْبانُ عنْ نَغَمٍ","تُبْدِي عَنِ الصَّبِّ ما تُخْفي ضَمائِرُهُ",42,"ر",2,0],["وَحنى ظهره توالي اللَيالي","فهو إِن همَّ لا يطيق اِعتدالا",43,"ل",2,0],["وحنوّاً عَلى اليَتامى وَعَقلاً","أَكبرته جاراتها إكبارا",44,"ر",2,0],["وحَنِين مِنْ عَنُودٍ بَدْأَةٍ","أَقرَعِ النقْبَةِ حَنَّانِ لَحِمْ",45,"م",1,0],["وحنايةُ الحسنِ الغريرِ إذا رمى","فشريقُ دمعٍ أو غريقُ دماءِ",46,"ا",2,0],["وحناناً مُجسَّداً إنْ طواني الْ","لَيلُ وَسَّدْتُ صدرَهُ آلامي",47,"ي",1,0],["وحنّ إلى ظلالك عبد شمس","يريح شجونه ظمأى طلاحا",48,"ح",2,0],["وَحَنَّ إِلى الحِجازِ القَلبُ مِنّي","فَهاجَ غَرامُهُ بَعدَ السُكونِ",49,"ن",1,0],["وحنانا بضريحٍ طالما","صقلته قبلات الطائفين",50,"ن",1,0],["وحنَّتْ إلى البَرَّ مشتاقةً","إليه كما حنَّتِ الثاكِلُ",51,"ل",1,0],["وحنَتْ إليه مثلما","يحنو إلى الحِبّ الحبيب",52,"ب",1,0],["وحنا عليك حنوَّ مرْ","ضِعةِ الفطيم على الفطيم",53,"م",1,0],["وحنكي صروف الدهر حتى تبلدت","وأبصرت ما أخفين والجو قاتم",54,"م",1,0],["وحنية تحنو على سهم الردى","فيصيب شالكة الرمي سديده",55,"د",2,0],["وحنت تنشد الخلود ليغفو","بين أحضانها إله الخلود",56,"د",1,0],["وحنا اليقين على الجحودو ما حنا","إلا على الخلصاء والأتراب",57,"ب",1,0],["وحنت فاطم تضمّ فتاها","لهفة الأمّ فوجئت بالوحيد",58,"د",1,0],["وحنا على بؤس العفاة فما رأوا","من عثرة إلاّ رأوه مقيلا",59,"ل",2,0],["وحنت على النفس الأثيم فابصرت","إثم النفوس على النفوس دخيلا",59,"ل",2,0],["وحنين إلى السماء كما حنّ","إلى نعمة الشفاء العليل",60,"ل",1,0],["وحنين قلب لا يثوب","إلى خيالٍ لا يلمْ",61,"م",1,0],["وحَنَّتْ نواقيسٌ، ورَنّتْ مآذنٌ","ورَقَّتْ وجوهُ الأَرضِ تَستقبلُ السلمى",62,"م",2,0],["وَحَنين إِلى الدِيار وَوَجد","يَستَفز النُهى وَشَوق الحا",63,"ح",2,0],["وَحَنين هَينمة الرِياح عَشية","وَتُرسل الأَطيار في الأَسحار",64,"ر",1,0],["وحندس الليل مرخاة كلاكله","وموج داجيه هدار ب