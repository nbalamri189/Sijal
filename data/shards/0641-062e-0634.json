{"poems":[[125,"ألا عم صباحاً أيها الربع منعما","https://www.aldiwan.net/poem23818.html","الطويل"],[208,"خجل الحبيب من العتاب","https://www.aldiwan.net/poem53200.html","مجزوء الكامل"],[466,"أيها الناطق الذي شغل الأل","https://www.aldiwan.net/poem15153.html","الخفيف"],[556,"يا راكبا وصل الوجيف ذميله","https://www.aldiwan.net/poem47335.html","الكامل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96987","الخفيف"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46521","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46509","الرجز"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121657","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131052",""],[5136,"أفدي التي بت في محبتها","https://www.poetsgate.com/ViewPoem.aspx?id=121669",""],[5431,"أضاجع الحزن اللصيق وأندبُ","https://www.poetsgate.com/ViewPoem.aspx?id=183240",""],[5956,"أحببتُكم مِمّا سمِعتُه عنكم","https://www.poetsgate.com/ViewPoem.aspx?id=207929",""],[5957,"رمضان شهر الخير","https://www.poetsgate.com/ViewPoem.aspx?id=204597",""]],"verses":[["فخشيته نور انشراحٍ وعلمه","يزيل من الجهل الذي قد تغمّما",0,"م",2,0],["فخشيتُ منه تغضُّباً","فمسحتُ ذلك بالقُبَلْ",1,"ل",1,0],["فخشيتُ العقاب إذ هو صِرْفٌ","وإذا الشِّرْبُ جالبٌ للثَّواب",2,"ب",1,0],["فخشوعنا لخشوعِهِ ونحولُنا","إن كنت تُنكره جناه نحولُهُ",3,"ل",2,0],["فخشيت الإسلام فيك يقولو","ن كما قالت المغالون كفرا",4,"ر",2,0],["فَخَشي الغراب مِن نَكيره","إِذ بالغ الحاسد في تَزويره",5,"ه",1,0],["فَخَشي الفاتك أَن يسمعه","رَفيقه الأَدنى وَأَن يمنعه",6,"ه",1,0],["فخشِيتُ من ماءِ اللَّطا","فةِ فيه يشْربُه الغَدِيرُ",7,"ر",1,0],["فخشيت أن تمضي شهيد محبتي","فأذوق يوم الحشر نار جهنم",8,"م",1,0],["فخشه بفضل مطرفها","عني فقبلتها فما لفم",9,"م",1,0],["فخشعتُ للكون العظيم لعلني","أحظى بعلمٍ لايزول وينضبُ",10,"ب",1,0],["فخشيت أن تبكي ابنها أو بِنْتَها","وحضضتُها حتى تجيبَ مُرامي",11,"م",2,0],["فخشعت شوقاً عندما جاء السنا","وتجلتِ الأنوار في الأكوانِ",12,"ن",1,0]]}