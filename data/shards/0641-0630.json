3,"","https://poetry.dctabudhabi.ae/diwan/poem/54752","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54628","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54620","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55069","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55170","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55154","المجتث"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67306","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43853","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54232","الوافر"],[106,"تحيْة الرسالة","https://www.poetsgate.com/ViewPoem.aspx?id=179503",""],[106,"بطش الضعيف","https://www.poetsgate.com/ViewPoem.aspx?id=179576",""],[50,"ألا قل ل\"عبدة \" إن جئتها","https://www.poetsgate.com/ViewPoem.aspx?id=21783",""],[67,"جِوَارُكَ منْ جَوْرِ الزَّمانِ يُجِيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=14535",""],[90,"لم تُنْصفوا اصوت من النجف","https://www.poetsgate.com/ViewPoem.aspx?id=178980",""],[57,"إذا رمت المكارم من كريم","https://www.poetsgate.com/ViewPoem.aspx?id=3415",""],[1,"لِخَوْلَةَ أَطْلالٌ بِبُرْقَةِ ثَهْمَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=10033",""],[28,"ومطروفة العينين قد قدت الصبا","https://www.poetsgate.com/ViewPoem.aspx?id=17970",""],[99,"أنا يا صديقتي متعب بعروبتي","https://www.poetsgate.com/ViewPoem.aspx?id=24608",""],[51,"سَمْعا أبا إسحق إنك ماجدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=30803",""],[97,"قميص النوم","https://www.poetsgate.com/ViewPoem.aspx?id=17278",""],[39,"طَالَ في رَسْمِ مَهْدَدٍ رَبَدُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=4253",""],[1,"لِخَولة َ أطْلالٌ بِبُرقَة ِ ثَهمَدِ، ( معلقة )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13176&r=&rc=0",""],[31,"رَأَيْتُ بِجَنْبِ الخَيْفِ هِنْداً، فَرَاقَني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19048&r=&rc=311",""],[20,"أتعرِف رسم الدار من أم معبد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69764&r=&rc=5",""],[67,"أمدائح لي فيكَ أم تسبيحُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13729&r=&rc=5",""],[36,"طربت وما هذا بساعة مطرب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=16615&r=&rc=0",""],[18,"جَارَتْ بَنُو بَكْرٍ وَلَمْ يَعْدِلُوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26453&r=&rc=19",""],[14,"أقِلِّي عَلَيَّ اللِّوْمَ يا ابْنَة َ مُنْذِرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17403&r=&rc=14",""]],"verses":[["فَذاكَ الطَيُّ لِلماضينَ نَشرٌ","وَهَذا النَشرُ لِلباقينَ طَيُّ",0,"ي",1,0],["فَذاكَ مَكاني إِن أَقَمتُ بِمَنزِلٍ","وَإِلّا فَفي أَيدي الطِلابِ زِمامي",1,"ي",1,0],["فَذَوَت نَضارَتُهُ وَغُص","نُكَ دونَهُ رَيّانُ نامِ",2,"م",1,0],["فَذي الدارُ إِذا تَغنى","وَذي الدارُ إِذا تَخلو",3,"ل",2,0],["فَذاكَ أَبا حَسَنٍ في السَما","حِ مَن لا يُلِمُّ بِهِ السائِلُ",4,"ل",1,0],["فَذِماماً عَلى النَدى أَن يُرَجّى","وَعِيابُ البَخيلِ مِن أَن يُفضى",5,"ض",2,0],["فَذاكَ كَما شاءَ الفُسوقُ مُبَغَّضٌ","وَأَنتَ كَما شاءَ العَفافُ مُحَبَّبُ",6,"ب",1,0],["فَذَمَّ تَعاقُبَ العَصرَينِ رَسمٌ","يَلوحُ كَأَنَّهُ وَشمٌ خَفيُّ",7,"ي",1,0],["فَذُو النَّقْصِ في عَيْشٍ وَريقٍ غُصونُهُ","وَلَيْسَ لِذي فَضْلٍ بِها عِيشَةٌ رَغْدُ",8,"د",1,0],["فَذاكَ دَهْرٌ لمْ أجُدْ بأدْمُعي","داميَةً حتّى تولّى وانْقَضى",9,"ا",1,0],["فَذو العُرِّ يُكْوَى حينَ يُعْضِلُ داؤُهُ","وكلُّ أخي حَزْمٍ متى يَكْوِ يُنْضِجِ",10,"ج",1,0],["فذَرْهُ والمِصاعَ فسوفَ تُؤتَى","بهِ مَلِكاً مَهيباً أو قَتيلا",11,"ل",2,0],["فذَلَّلتُها حتى تحَلَّتْ بمَنطِقٍ","يَرُدُّ على أعقابِ وحْشِيِّها اللُّغا",12,"غ",2,0],["فَذَراني في رَوضَةِ الحُبِّ أَرعى","أَتَمَشّى في نَبتِها وَأَرودُ",13,"د",1,0],["فَذَلِكَ قاَسٍ لَم يَذُق قَلبُهُ تُقىً","وَهَذا جَهولٌ كَيفَ ذو الجَهلِ يَصلُحُ",14,"ح",1,0],["فَذاكَ اللَيثُ مَن يَحمي حِماهُ","وَيُكرِمُ ضَيفَهُ حَيّاً وَمَيتا",15,"ت",2,0],["فَذَكَّرتُهُ ثُمَّ عاتَبتُهُ","عِتاباً رَفيقاً وَقولاً جَميلا",16,"ل",2,0],["فَذاكَ أَوانُ التُقى وَالزَكى","وَذاكَ أَوانٌ مِنَ المُلكِ حارا",17,"ر",2,0],["فَذاكَ وَلَم يُعجِز مِنَ المَوتِ رَبَّهُ","وَلَكِن أَتاهُ المَوتُ لا يَتَأَبَّقُ",18,"ق",1,0],["فَذاكَ وَما أَنجى مِنَ المَوتِ رَبَّهُ","بِساباطَ حَتّى ماتَ وَهوَ مُحَزرَقُ",18,"ق",1,0],["فَذَلِكَ أَدنى أَن تَنالَ جَسيمَها","وَلِلقَصدُ أَبقى في المَسيرِ وَأَلحَقُ",18,"ق",1,0],["فَذَلِكَ شَبَّهتُهُ ناقَتي","وَما إِن لِغَيرِكَ إِعمالُها",19,"ل",3,0],["فَذَلِكَ بَعدَ الجَهدِ شَبَّهتُ ناقَتي","إِذا ما وَنى حَدُّ المَطِيِّ المُخَرَّمِ",20,"م",1,0],["فَذَلِكَ مِن أَيّامِنا وَبَلائِنا","وَنُعمى عَلَيكُم إِن شَكَرتُم لَأُنعُمِ",20,"م",1,0],["فَذَلِكَ بَعدَ الجَهدِ شَبَّهتُ ناقَتي","إِذا الشاةُ يَوماً في الكِناسِ تَجَرثَما",21,"م",2,0],["فَذا الشَنءِ فَاِشنَأهُ وَذا الوُدِّ فَاِجزِهِ","عَلى وُدِّهِ أَو زِد عَلَيهِ العَلانِيا",22,"ي",2,0],["فَذَريني مِنَ المَلامَةِ حَسبي","رُبَّما أَنتَحي مَوارِدَ زورا",23,"ر",2,0],["فذاكَ خُلقٌ مِنَ الفِردَوسِ طينَتُه","اللهُ أوْدَعَ فيها ما ينَقِّيها",24,"ي",3,0],["فَذَلِكَ التاجِرُ الشَهيدُ","قَد عافَ مِن أَجلِها البَقاء",25,"ا",2,0],["فَذاكَ شِفاءُ الجِسمِ تَدمى جِراحُهُ","وَتِلكَ شِفاءُ الوالِهِ المُتَوَجِّعِ",26,"ع",1,0],["فَذَلِكَ سَيفٌ سَلَّهُ اللَهُ قاطِعٌ","فَأَيّانَ يَضرِب يَفرِ دِرعاً وَيَقطَعِ",26,"ع",1,0],["فَذَكَّرَني إيماضُهُ كُلَّما خَفا","زَماناً مَضى رَغداً وَعَصراً تَصَرَّما",27,"م",2,0],["فَذُقِ الَّذي جَشَّمتَ نَفسَكَ فَاِحتَسِب","مِنها أَخاكَ وَعامِرَ بنَ أَبي حُجُر",28,"ر",1,0],["فَذوقي بِما جَشَّمتِ عَيناً مَشومَةً","قَذاها وَقَد يَأتي عَلى العَينِ شومُها",29,"م",3,0],["فَذَرني وَلَكِن شاقَني مُتَغَرّدا","أَغَرُّ الذُرى صاتُ العَشِيّاتِ أَوطَفُ",30,"ف",1,0],["فَذاكَ سَقى أُمَّ الحُوَيرِثِ ماءَهُ","بِحَيثُ اِنتَوَت واهِي الأَسِرَّةِ مُرزِفُ",30,"ف",1,0],["فَذَلِكَ يا هِندُ الرَزِيَّةُ فَاِعلَمي","وَنيرانُ حَربٍ حينَ شُبَّ وَقودُها",31,"د",3,0],["فَذَلِكَ في الجَدِّ مَكروهُهُ","وَفي السِلمِ تَلهو وَتُرخي الإِزارا",32,"ر",2,0],["فَذَكَّرَني أَخي قَوماً تَوَلَّوا","عَلَيَّ بِذِكرِهِم ما قيلَ قيلُ",33,"ل",1,0],["فذاك أناسٌ قل في الخير شأنه","فلا قربهم قرب ولا بعدهم بعد",34,"د",1,0],["فَذَرْهَا وَطِبْ بَيْنَ حُورِ الجِنَ","انِ وَوِلْدَانِهَا وَتَمَلَّ النَّعِيمَا",35,"م",2,0],["فَذَلِكَ أنَّ أنْوَاراً تَجَلَّتْ","بِهِ مِنْ مَهْبِطِ اللهِ الحَكيمِ",36,"م",1,0],["فَذاكَ لِلآجِلِ المَأمولِ أَذخُرُهُ","وَأَنتَ لِلعاجِلِ المَرجُوِّ وَالطَلَبِ",37,"ب",1,0],["فَذَلِكَ دَأبُكُما أَن يَموتَ","مِنَ القَومِ بَينَكُما الأَعجَلُ",38,"ل",1,0],["فَذاكَ يوجِبُ أَنَّ النَبعَ تَجمَعُهُ","إِلى خِلافِكَ في العيدانِ أَو غَرَبَك",39,"ك",1,0],["فَذاكَ شَبَّهتَ عيسي في مَعاقِدِها","إِذا اِنتَحَت في سَوادِ اللَيلِ بِالعيرِ",40,"ر",1,0],["فَذاكَ الَّذي شَبَّهتُ بِالخَرقِ ناقَتي","إِذا قَلَّصَت بَينَ الفَلا وَالمَشارِبِ",41,"ب",1,0],["فذائد سهم عن رميّ يردّه","وآخر رام سهمه نحو ذائد",42,"د",1,0],["فذكّرته أهل الصليب وحربهم","إذا نبعث منهم إلى الشرق أبطال",43,"ل",1,0],["فذان قد أخجل الأهرامَ بَغيُهما","وبغي هذاك أبكى البيت والحرما",44,"م",2,0],["فذاك هو المَيْت في قومه","وأن كان في المجلس الحاشد",45,"د",1,0],["فذاك هو الحيّ حيّ الفَخا","رِ وأن لَحَدَتْه يد اللاحد",45,"د",1,0],["فَذاكَ وَلا تَرَمُّزُ قَينِ لَيلى","عَلى كيرٍ يُثَقَّبُ فيهِ عودُ",46,"د",1,0],["فَذو العَرشِ أَعطانا عَلى الكُرهِ وَالرِضى","إِمامَ الهُدى ذا الحِكمَةِ المُتَخَيَّرا",47,"ر",2,0],["فَذَكَّرنَ ذا الإِعوالِ وَالشَوقِ ذِكرَهُ","فَهَيَّجنَ ما بَينَ الحَشا وَالأَضالِعِ",48,"ع",1,0],["فَذاكَ الفَحلُ جاءَ بِشَرَّ نَجلٍ","خَبيثاتِ المَثابِرِ وَالمَشيمِ",49,"م",1,0],["فَذوقوا وَقعَ أَطرافِ العَوالي","فَيا أَهلَ اليَمامَةِ لا يَماما",50,"م",2,0],["فَذُدتُ مَعَدّاً وَالعِبادَ وَطَيِّئاً","وَكَلباً كَما ذيدَ الخِماسُ البَواكِرُ",51,"ر",1,0],["فَذاكَ دِفاعٌ عَن ذِمارِ أَبيكُمُ","إِذا خَرَقَ السِربالَ حَدُّ المَرافِقِ",52,"ق",1,0],["فذاك شَبَّهتْه المذكَّرة","الوجناءَ في البيد وهي تغتهبُ",53,"ب",1,1],["فَذاكَ مِنهُم بِنا حَديثٌ","وَهوَ لِآبائِنا قَديمُ",54,"م",1,0],["فَذَلِكَ ما أَورَثَتنا القُرونُ","مَجداً تَليداً وَعِزّاً أَشَم",55,"م",1,0],["فَذَلِكَ ما كُنّا نُرَجّي وَنَرتَجي","لِحَمزَةَ يَومَ الحَشرِ خَيرُ مَصيرِ",56,"ر",1,0],["فذاك نَصيبُ السَّلم عندي ولم أكنْ","لأنسى نصيبَ الحرب في نُوُب الحربِ",57,"ب",1,0],["فذاك عَتادي فوق أجردَ سابحٍ","يُريحُ زفيرَ الجري من منْخَرٍ رحبِ",57,"ب",1,0],["فذاك بلاءُ البرِّ عنديَ شاتياً","وكم ليَ من صيفٍ به ذي مثالبِ",58,"ب",1,0],["فذلك عاقني عن شَدِّ رحلي","وعن عَسْفي المهامِهَ واجتيابي",59,"ب",2,0],["فذلك أغراه بهجري ولن ترى","زمانَك هذا تاجرَ النصح يربحُ",60,"ح",1,0],["فذاك مضى لآخرةٍ وهذا","لدنيَا عمره فيها مديدُ",61,"د",1,0],["فذيدت أمانيه وهنّ خَوامِسٌ","وقد كان ممّا لا تُذاد خوامسه",62,"س",2,0],["فذاك وإني أستقي من قريحتي","وأقدحُ إذ غيري من الناس يقبِس",63,"س",1,0],["فذو الزيغِ يُسْتَأنَى وذو الغيث يُنْتَحَى","وذو النفر يُسْتَدْنى وذو الشَّغْب يُوقمُ",64,"م",1,0],["فذاك الحوتُ يَدرسُ ذا","لك التسبيحَ ما سَئِمَا",65,"م",2,0],["فذَوُو السعادةِ ذاهبو","نَ عن القَصومِ إلى العَصوم",66,"م",1,0],["فذكتْ له نارانِ نارُ مطمطمٍ","قَذَفٍ ونار مجمجم سجِّين",67,"ن",1,0],["فذرِ المُقَدَّر أن يهونك نظرةٌ","فترى رصين القول غير رصين",67,"ن",1,0],["فَذاكَ تِلادُهُ وَمُسَلجَماتٌ","نَظائِرُ كُلُّ خَوّارٍ بَروقِ",68,"ق",1,0],["فَذلِكَ سُقيا أُمُّ عَمرٍ وَإِنَّني","لِما بَذَلَت مِن سَيبِها لَبَهيجُ",69,"ج",1,0],["فَذلِكَ أَعلى مِنكِ فَقداً لِأَنَّهُ","كَريمٌ وَبَطني بِالكِرامِ بَعيجُ",69,"ج",1,0],["فَذَروا المَكارِمَ لَستُمُ مِن أَهلِها","وَخُذوا مَساحِيَكُم بَني النَجّارِ",70,"ر",1,0],["فَذَهَبتُ أَمشي في الثَرى مَرِحاً","ما بَينَ جُلّاسي وَمُنفَرِدا",71,"د",2,0],["فَذي لَيلَةٌ بِجَميعِ الزَمانِ","إِذا كانَ في الدَهرِ مَن أَجمَعِ",72,"ع",1,0],["فَذَلِكَ خَطبٌ يَهولُ النُفوسَ","تُصَوِّرُهُ قَبلَ أَن تَحمِلَه",73,"ل",2,0],["فَذِهنٌ كَنَجمِ الصَيفِ في أَوَّلِ الدُجى","وَرَأيٌ كَحَدِّ السَيفِ أَو ذَلِكَ الذِهنِ",74,"ن",1,0],["فَذا مِثلُ هَذا حائِرُ اللُبِّ عِندَهُ","وَذاكَ كَهَذا لَيسَ مِنهُ عَلى أَمنِ",74,"ن",1,0],["فَذا أَساهُ لَهيبٌ في أَدالُعِهِ","وَذا أَساهُ دُموعٌ في مَآقيهِ",75,"ي",2,0],["فَذَكَرتُ ثَمَّ مَحاسِناً تَحتَ الثَرى","غابَت وَشَوَّهَها البِلى تَشويها",76,"ي",3,0],["فَذالِكَ إِن يَلقَ المَنِيَّةَ يَلقَها","حَميداً وَإِن يَستَغنِ يَوماً فَأَجدَرِ",77,"ر",1,0],["فَذادَها وَهيَ مُحمَرٌّ نَواجِذُها","كَما يَذودُ أَخو العُمِّيَّةِ النَجِدُ",78,"د",1,0],["فَذاكَ الفَرضُ وَالرَحمَن عِندي","كَمِثلِ الفَرضِ في حالِ الجِهادِ",79,"د",1,0],["فذاك زعيم الشعب يحمي 