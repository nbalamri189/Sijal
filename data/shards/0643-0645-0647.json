{"poems":[[100,"أمي","https://www.aldiwan.net/poem23695.html","عموديه"],[86,"ماذا أصبت من الأسفار والنصب","https://www.aldiwan.net/poem10508.html","البسيط"],[88,"أصبحت أعذل نوابا وأعيانا","https://www.aldiwan.net/poem44391.html","البسيط"],[72,"أشرق الشام فما أي","https://www.aldiwan.net/poem18456.html","مجزوء الرمل"],[51,"لك ريحان وراح ومجيدات ملاح","https://www.aldiwan.net/poem9410.html","مجزوء الرمل"],[51,"ما أوجب العفو على سيد","https://www.aldiwan.net/poem61992.html","الوافر"],[51,"ما إن علمنا من طعام حاضر","https://www.aldiwan.net/poem62896.html","الكامل"],[91,"جعت والخبز وفير في وطابي","https://www.aldiwan.net/poem8748.html","عموديه"],[91,"والسنا حولي وروحي في ضباب","https://www.aldiwan.net/poem8749.html","عموديه"],[91,"شاهدتها كالميت في أكفانه","https://www.aldiwan.net/poem62809.html","عموديه"],[85,"بي مثل ما بك يا قمرية الوادى","https://www.aldiwan.net/poem6813.html","البسيط"],[85,"ممالك الشرق أم أدارس أطلال","https://www.aldiwan.net/poem62835.html","البسيط"],[85,"يا أخت أندلس عليك سلام","https://www.aldiwan.net/poem63741.html","الكامل"],[28,"تحن بزوراء المدينة ناقتي","https://www.aldiwan.net/poem5618.html","الطويل"],[97,"رسم الحبيبِ الأول","https://www.aldiwan.net/poem24407.html","مجزوء الكامل"],[97,"طابت بك الأيام وافرحتاه","https://www.aldiwan.net/poem25100.html","السريع"],[105,"هو مرتمى الأبطال مالك دونه","https://www.aldiwan.net/poem44209.html","الكامل"],[102,"بيض الحمائم حسبهنه","https://www.aldiwan.net/poem33133.html","مجزوء الكامل"],[67,"حي بلبيس منزلا في العماره","https://www.aldiwan.net/poem18062.html","الخفيف"],[67,"انظر بحقك في أمر الدواوين","https://www.aldiwan.net/poem18116.html","البسيط"],[50,"علليني يا عبد أنت الشفاء","https://www.aldiwan.net/poem64888.html","الخفيف"],[46,"لا تبدأوني بالعداوة منكم","https://www.aldiwan.net/poem22485.html","الكامل"],[76,"أزف الرحيل فودعتني مقلة","https://www.aldiwan.net/poem38981.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85713","المجتث"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72205","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147486",""],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202542","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202536","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54935","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54953","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43748","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43889","الكامل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23651","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54269","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54238","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54218","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54244","الكامل"],[36,"كم هاتف بك من باك وباكية","https://www.poetsgate.com/ViewPoem.aspx?id=15866",""],[106,"بطل الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=179585",""],[106,"تحيْة وقضيّة","https://www.poetsgate.com/ViewPoem.aspx?id=179505",""],[106,"ثورة على الحضارة","https://www.poetsgate.com/ViewPoem.aspx?id=179425",""],[106,"من وحي البحر","https://www.poetsgate.com/ViewPoem.aspx?id=179317",""],[106,"ذكرى دنشواي","https://www.poetsgate.com/ViewPoem.aspx?id=179341",""],[99,"إلى بيروت الأنثى مع الإعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=215333",""]],"verses":[["كم هدتني يدم السمرا إلى","حقلنا في ( الغول ) في ( قاع الرحاب )",0,"ب",1,0],["كَم هِمتُ في البيدِ وَالآرامُ قائِلَةٌ","وَالشَمسُ تَرمي أَديمَ الأَرضِ بِاللَهَبِ",1,"ب",1,0],["كم هدة لك بين النار تُفزِعنا","حتى نخالك منها صرت بركانا",2,"ن",2,0],["كم هلالٍ كادَ يا قا","دم أن يحسد سرجك",3,"ك",1,0],["كَمَهَا الرَّمْلِ تُنَاغِي","هُنَّ أوتارٌ فِصَاحُ",4,"ح",1,0],["كم هَنَةٍ لولاه لم تنصرف","إلا وأشلاء أناس جُذاذْ",5,"ذ",1,0],["كمُهيَّئَيْنِ من المطاعم فيهما","شبهٌ من الأبرار والفجارِ",6,"ر",1,0],["كَم هَشَشنا وَهَشَشتُم لِلمُنى","وَبَكَيتُم وَبَكَينا في مُصابِ",7,"ب",1,0],["كَم هَشَشتُم وَهَشَشنا لِلمُنى","وَبَكَيتُم وَبَكَينا في مُصابِ",8,"ب",1,0],["كَمهَزَّني الشَدوُ الرَخيمُ فَساقَطَت","نَفسي هُموماً أَوشَكَت تَبليها",9,"ي",3,0],["كم هاج مبكاك من مجروح أفئدة","تحت الظلامِ ومن مقروح أكباد",10,"د",1,0],["كَم هِمَّةٍ دَفَعَت جيلاً ذُرا شَرَفٍ","وَنَومَةٍ هَدَمَت بُنيانَ أَجيالِ",11,"ل",1,0],["كَم هاجَهُ صَيدُ المُلوكِ وَهاجَهُم","وَتَكافَأَ الفُرسانُ وَالأَعلامُ",12,"م",1,0],["كَمُهريقِ ماءٍ بِالفَلاةِ وَغَرَّهُ","سَرابٌ أَثارَتهُ رِياحُ السَمائِمِ",13,"م",1,0],["كم هِجنَ أشجانَ الشجي","يِ ونلنَ من قلبِ الخلي",14,"ي",1,0],["كم هدأ الليل وران الكرى","إلا أخا سهدٍ يغنِّي شجاه",15,"ا",2,0],["كم هاربٍ يخشى بَوادِرَ بأسِهِ","ويخافُ منه مُشيَّعاً ما يَهرب",16,"ب",1,0],["كم هجنني ورويتُ هن","هنّ الهديلَ فديتهنَّه",17,"ن",2,0],["كمْ هَدانا مِنْ فضلِهِ بِكِتابٍ","مُعْجِزٍ مِنْ عُلُومِهِ بِأَثارَهْ",18,"ر",2,0],["كَمْ هكذَا سَرَقُوا كَمْ هكذا ظَلَمُوا","كَمْ هكذَا أخَذُوا مالَ السَّلاطِينِ",19,"ن",1,0],["كَمَهاةِ الكِناسِ تَطوي لَنا النَف","سَ عَلى وَدَّةٍ وَفينا جَفاءُ",20,"ا",2,0],["كُمهُ البَصائِرِ لا يَبينُ لَها الهُدى","أَو مُبصِرٌ أَبَداً بِعَينَي أَرمَدِ",21,"د",1,0],["كمهاةِ رَملٍ قد تَربَّعتِ الحِمَى","بينَ الظُّباءِ العُفر والآرامِ",22,"م",1,0],["كَم هدَّ في الشرق بَيتاً","بَعدَ الزَواج الفراقُ",23,"ق",1,1],["كم هلَّلت وهو يضيء الرِّحاب","والتفتَت محسورةً حين غاب",24,"ب",1,0],["كَمْ هاتِفٍ بكَ مِنْ باكٍ وباكِيَةٍ","يا تَوْبُ للضَّيْفِ إذ تُدعى وَلِلْجارِ",25,"ر",1,1],["كم هلكت غادة كعاب","وعمرت أمها العجوز",26,"ز",1,0],["كم هجر النوم أبو محمد","واكتحل العثير بعد الاثمد",27,"د",1,0],["كم هاضتْ الممالك العظاما","مخافةً أن يقطعوا النظاما",28,"م",2,0],["كَمْ هَوَتْ دُونَهَا رَواسٍ فَأَجْلَتْ","عَنْ رُكَامٍ فِي مُسْتَقَرٍ حَقِيرِ",29,"ر",1,0],["كَمْ هَالِكٍ تُنْقِذُهُ مِنْ شَفاً","وَكَادَتِ الدُّنْيَا بِهِ تَعْثُرُ",30,"ر",1,0],["كَم همام سَمَت بِهِ هِمَمٌ لَم","تغنِ في حَتفِهِ اللُّهى وَاللّهامُ",31,"م",1,0],["كمهَنَّديْنِ مُجَرَّدْينِ بريَّةٍ","تَنْبُو الظُّبَى وكِلاهما قَطَّاعُ",32,"ع",1,0],["كم هابطٍ صاعدٌ من بعد هَبْطته","وغائرٍ منجِدٌ من بعد ما غارا",33,"ر",2,0],["كَمُهْرِقِ المَاء في الصَّحْراءِ حِينَ بَدَا","لِعَيْنِهِ بَارِقٌ مِنْ عَارِضٍ كَذِبِ",34,"ب",1,0],["كم هفا القلبُ للُبنان وكم","عاقه صَرْفُ الزمانِ القُلّب",35,"ب",1,0],["كم هشمَّ الدهرُ من سنٍّ ليعجُمَهم","ولم تزَلْ في يديْه نَضْرةُ العود",36,"د",1,0],["كم همّةٍ تفرَع الأجبال سامقةً","وهمةٍ ركدت بين الأخاديدِ",36,"د",1,0],["كم هزَّتْ الدنيا صواعقُ نارها","وأصاب وجهَ الأرضِ من لَوّاحهَا",37,"ح",3,0],["كم هاتف بك من باك وباكية","يا توبُ للضَّفِ إذْ تُدْعَى وللجّارِ",38,"ر",1,1],["كم هاتفٍ بحياة مصرَ وإنما","هو تاجرٌ يَعْنيهِ وفْرَةُ مالِهِ",39,"ل",2,0],["كم هزَّ عطفيها اسمُه","فكأنه نَغَمٌ طروب",40,"ب",1,0],["كم هان أمرٌ فقلَّدناه طائفةً","من الحواشي وحمَّلنَاه أثقالا",41,"ل",2,0],["كم همسةٍ فصيحة الإعْراب","للموج تُطْرِي اللهَ في إسهاب",42,"ب",1,0],["كِمْ هَامَة صُلِبَتْ هُنَا","وَدَمٌ تدفَّقَ من وريد",43,"د",1,0],["كَم هَزَيتمُ مِن صَحَارَاكُم إلَيهِ","تَطلُبونَ اَلمَاءَ وَ الوَجهَ الجَمِيلاَ",44,"ل",2,0]]}