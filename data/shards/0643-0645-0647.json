م هد للمجد قصوراً وكم","هدم للعلياء بنيانا",171,"ن",2,0],["كم هزّه الشوق للتّرحال ممتشقا","وهمَ الوِصالِ وكم هامت به النّجُبُ",172,"ب",1,0],["كَمْ هَزّ قَلْبِيَ عَصْفٌ مِنْ تَذَكُّرِهِمْ","والشَّوْقُ يَشْهَدُ لِيْ والصَّبْرُ والْأَمَلُ",173,"ل",1,0],["كمُهرة شمسٍ تثيرُ العشايا","وتَعْنو بعمري نهاراً فتيّا",174,"ي",2,0],["كم هزني بغنائه طربا","وحنا على قلبي بألحان",175,"ن",1,0],["كم هالني ما قالَ «قيسٌ» في الهوى","حتَّى حسِبتُ العِشقَ مِنْ طُلّابهِ",176,"ب",2,0],["كَمْ هَابِطٍ تُقْبِلُ الدُّنْيَا لِتَفْضَحَهُ","فَسْلَ العُرُوقِ وَبِيَئاًِ سَيِّئَ السَّلَفِ",177,"ف",1,0],["كم هوى ً قد تركتهُ مثلَ سطرٍ","قد محاه من الصحيفة ماح",178,"ح",1,0],["كَمْ هَامَةٍ تَمْشِي اخْتِيَالاً فِي بَطَرْ","لاَحَتْ فَظَنُّوا أَنَّ صَاحِبَهَا بَشَرْ",179,"ر",1,1]]}