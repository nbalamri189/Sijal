d=178444",""],[5694,"الآماره","https://www.poetsgate.com/ViewPoem.aspx?id=129910",""],[5704,"رُجُوع","https://www.poetsgate.com/ViewPoem.aspx?id=191319",""],[5704,"عشق٠٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=204261",""],[5739,"المجره ..!","https://www.poetsgate.com/ViewPoem.aspx?id=127066",""],[5943,"مزنة من ترياق","https://www.poetsgate.com/ViewPoem.aspx?id=41605",""],[5956,"أقسى حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=182403",""],[5956,"أرجوك دعني أبدأ الإسهاما","https://www.poetsgate.com/ViewPoem.aspx?id=193429",""],[5956,"خلَفٌ أتانا طاهراً مثل السّلفْ","https://www.poetsgate.com/ViewPoem.aspx?id=193487",""],[5956,"القاضي الظالم","https://www.poetsgate.com/ViewPoem.aspx?id=193647",""],[6034,"الدهر لا يبرح خوانا","https://www.poetsgate.com/ViewPoem.aspx?id=169609",""],[6177,"هجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81091&r=&rc=38",""],[5355,"أطبق جفونك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86679&r=&rc=2",""],[6212,"مهرة الشمس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1619&r=&rc=0",""],[6234,"الدوحة الشاعرة المحتضرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=6536&r=&rc=3",""],[6238,"لُباب الحُب...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86777&r=&rc=6",""],[6251,"عزة النفس .. إلى الرئيس إبراهيم الحمدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76482&r=&rc=22",""],[6259,"لست في بينها الغداة بلاحِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59363&r=&rc=11",""],[6320,"أَعْشَابُ المَزَابِل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84363&r=&rc=60",""]],"verses":[["كم هدتني يدم السمرا إلى","حقلنا في ( الغول ) في ( قاع الرحاب )",0,"ب",1,0],["كَم هِمتُ في البيدِ وَالآرامُ قائِلَةٌ","وَالشَمسُ تَرمي أَديمَ الأَرضِ بِاللَهَبِ",1,"ب",1,0],["كم هدة لك بين النار تُفزِعنا","حتى نخالك منها صرت بركانا",2,"ن",2,0],["كم هلالٍ كادَ يا قا","دم أن يحسد سرجك",3,"ك",1,0],["كَمَهَا الرَّمْلِ تُنَاغِي","هُنَّ أوتارٌ فِصَاحُ",4,"ح",1,0],["كم هَنَةٍ لولاه لم تنصرف","إلا وأشلاء أناس جُذاذْ",5,"ذ",1,0],["كمُهيَّئَيْنِ من المطاعم فيهما","شبهٌ من الأبرار والفجارِ",6,"ر",1,0],["كَم هَشَشنا وَهَشَشتُم لِلمُنى","وَبَكَيتُم وَبَكَينا في مُصابِ",7,"ب",1,0],["كَم هَشَشتُم وَهَشَشنا لِلمُنى","وَبَكَيتُم وَبَكَينا في مُصابِ",8,"ب",1,0],["كَمهَزَّني الشَدوُ الرَخيمُ فَساقَطَت","نَفسي هُموماً أَوشَكَت تَبليها",9,"ي",3,0],["كم هاج مبكاك من مجروح أفئدة","تحت الظلامِ ومن مقروح أكباد",10,"د",1,0],["كَم هِمَّةٍ دَفَعَت جيلاً ذُرا شَرَفٍ","وَنَومَةٍ هَدَمَت بُنيانَ أَجيالِ",11,"ل",1,0],["كَم هاجَهُ صَيدُ المُلوكِ وَهاجَهُم","وَتَكافَأَ الفُرسانُ وَالأَعلامُ",12,"م",1,0],["كَمُهريقِ ماءٍ بِالفَلاةِ وَغَرَّهُ","سَرابٌ أَثارَتهُ رِياحُ السَمائِمِ",13,"م",1,0],["كم هِجنَ أشجانَ الشجي","يِ ونلنَ من قلبِ الخلي",14,"ل",2,0],["كم هدأ الليل وران الكرى","إلا أخا سهدٍ يغنِّي شجاه",15,"ا",2,0],["كم هاربٍ يخشى بَوادِرَ بأسِهِ","ويخافُ منه مُشيَّعاً ما يَهرب",16,"ب",1,0],["كم هجنني ورويتُ هن","هنّ الهديلَ فديتهنَّه",17,"ن",2,0],["كمْ هَدانا مِنْ فضلِهِ بِكِتابٍ","مُعْجِزٍ مِنْ عُلُومِهِ بِأَثارَهْ",18,"ر",2,0],["كَمْ هكذَا سَرَقُوا كَمْ هكذا ظَلَمُوا","كَمْ هكذَا أخَذُوا مالَ السَّلاطِينِ",19,"ن",1,0],["كَمَهاةِ الكِناسِ تَطوي لَنا النَف","سَ عَلى وَدَّةٍ وَفينا جَفاءُ",20,"ا",2,0],["كُمهُ البَصائِرِ لا يَبينُ لَها الهُدى","أَو مُبصِرٌ أَبَداً بِعَينَي أَرمَدِ",21,"د",1,0],["كمهاةِ رَملٍ قد تَربَّعتِ الحِمَى","بينَ الظُّباءِ العُفر والآرامِ",22,"م",1,0],["كَم هدَّ في الشرق بَيتاً","بَعدَ الزَواج الفراقُ",23,"ق",1,1],["كم هلَّلت وهو يضيء الرِّحاب","والتفتَت محسورةً حين غاب",24,"ب",1,0],["كَمْ هاتِفٍ بكَ مِنْ باكٍ وباكِيَةٍ","يا تَوْبُ للضَّيْفِ إذ تُدعى وَلِلْجارِ",25,"ر",1,1],["كم هلكت غادة كعاب","وعمرت أمها العجوز",26,"ز",1,0],["كم هجر النوم أبو محمد","واكتحل العثير بعد الاثمد",27,"د",1,0],["كم هاضتْ الممالك العظاما","مخافةً أن يقطعوا النظاما",28,"م",2,0],["كَمْ هَوَتْ دُونَهَا رَواسٍ فَأَجْلَتْ","عَنْ رُكَامٍ فِي مُسْتَقَرٍ حَقِيرِ",29,"ر",1,0],["كَمْ هَالِكٍ تُنْقِذُهُ مِنْ شَفاً","وَكَادَتِ الدُّنْيَا بِهِ تَعْثُرُ",30,"ر",1,0],["كَم همام سَمَت بِهِ هِمَمٌ لَم","تغنِ في حَتفِهِ اللُّهى وَاللّهامُ",31,"م",1,0],["كمهَنَّديْنِ مُجَرَّدْينِ بريَّةٍ","تَنْبُو الظُّبَى وكِلاهما قَطَّاعُ",32,"ع",1,0],["كم هابطٍ صاعدٌ من بعد هَبْطته","وغائرٍ منجِدٌ من بعد ما غارا",33,"ر",2,0],["كَمُهْرِقِ المَاء في الصَّحْراءِ حِينَ بَدَا","لِعَيْنِهِ بَارِقٌ مِنْ عَارِضٍ كَذِبِ",34,"ب",1,0],["كم هفا القلبُ للُبنان وكم","عاقه صَرْفُ الزمانِ القُلّب",35,"ب",1,0],["كم هشمَّ الدهرُ من سنٍّ ليعجُمَهم","ولم تزَلْ في يديْه نَضْرةُ العود",36,"د",1,0],["كم همّةٍ تفرَع الأجبال سامقةً","وهمةٍ ركدت بين الأخاديدِ",36,"د",1,0],["كم هزَّتْ الدنيا صواعقُ نارها","وأصاب وجهَ الأرضِ من لَوّاحهَا",37,"ح",3,0],["كم هاتف بك من باك وباكية","يا توبُ للضَّفِ إذْ تُدْعَى وللجّارِ",38,"ر",1,1],["كم هاتفٍ بحياة مصرَ وإنما","هو تاجرٌ يَعْنيهِ وفْرَةُ مالِهِ",39,"ل",2,0],["كم هزَّ عطفيها اسمُه","فكأنه نَغَمٌ طروب",40,"ب",1,0],["كم هان أمرٌ فقلَّدناه طائفةً","من الحواشي وحمَّلنَاه أثقالا",41,"ل",2,0],["كم همسةٍ فصيحة الإعْراب","للموج تُطْرِي اللهَ في إسهاب",42,"ب",1,0],["كِمْ هَامَة صُلِبَتْ هُنَا","وَدَمٌ تدفَّقَ من وريد",43,"د",1,0],["كم همت بلآلام تشدو باسمها","وعلى الأنين تدلّل الآلاما",44,"م",2,0],["كم هزّني الشّدو الرخيم فساقطت","نفسي همومما أوشكت تبليها",45,"ي",3,0],["كَم هَزَيتمُ مِن صَحَارَاكُم إلَيهِ","تَطلُبونَ اَلمَاءَ وَ الوَجهَ الجَمِيلاَ",46,"ل",2,0],["كَمْ هِجْنَنِي ورَوَيْتُ","عَنْهُنَّ الهَدِيلَ … فَدَيْتُهُنَّهْ",47,"ن",2,0],["كم هم قلبي بإفصاح ولم يقل","وهم دمعي بتسكاب ولم يسل",48,"ل",1,0],["كم هادم لبنائها متطلع","لفنائها متربص لجلادِ",49,"د",1,0],["كم هيّج الأشجان من أهل الهوى","برخيم صوت فاق نغمة مزهر",50,"ر",1,0],["كم هزة عند الثنا لأحمد","يعرف في نشواتها السخاء",51,"ا",2,0],["كم هد مهضوب بنا شامخ","وكم بنى طودا وكم هدمه",52,"م",2,0],["كَم هامَةٍ شُقَّت بِهِ وَدَعامَةٍ","دُقَّت فَخَرَّت لِلحَضيضِ الأَسفَلِ",53,"ل",1,0],["كم هَفَت روحهُ إليكِ وقد","جاءَ بها لا بنفسهِ الأمّارَه",54,"ر",2,0],["كم هزيم من حد غرتهم","ليس بدري شرقا من الغرب",55,"ب",1,0],["كم هزّني لِسماعِه طرَبٌ","فغدَوتُ مِنهُ شاعراً غردا",56,"د",2,0],["كَم هَوى مِن كافِرٍ في كافِرِ","وانْضَوَى مِن مُلْحِد في ملحَدِ",57,"د",1,0],["كَمْ هِزَّةٍ لَكَ وَارْتِياحِ لِلنَّدى","لَوْلاهُ ما كانَ الشَّرِيفُ شَرِيفا",58,"ف",2,0],["كمهيضٍ جنحه ودَّ لو أَنْ","طارَ للوكرِ ولكنْ لات حين",59,"ن",1,0],["كم هديةٍ أعقبت بأخرى","لم نجن من مدهن خيرا",60,"ر",2,0],["كم هُناكَ التقينا بالبُكاءِ قضَينا","ضاقَ فينا وضَجَّ المكانْ!",61,"ن",1,0],["كَم هَجَّرَت نُوَبٌ عَلَي","يَ فَما عَدِمتُ بِهِ ظِلالا",62,"ل",2,0],["كم هام مثلك مثقلٌ","لما بصخرته نطح",63,"ح",1,0],["كم همامٍ قاهرِ السَّطوةِ","عضَّتْه بناب",64,"ب",1,0],["كم هالك في حبها تالف","يمشي عليها وهو لا يعقل",65,"ل",1,0],["كم هصرنا فيه ثمار المعاني","ورفلنا في صرح بحث ممرد",66,"د",1,0],["كَمهر سَوءٍ إِذا رَفَّعتَ سيرَتَهُ","رامَ الجِماحَ وَإِن أَخفَضته حَرَنا",67,"ن",2,0],["كم هدانا الصباح من فرقك الوض","اح لما أن جنّ ليل جعودك",68,"ك",1,0],["كم هد ركن عدو حين عانده","وشاد للمجد كنا غير ذي خلل",69,"ل",1,0],["كم هجوم على العلى","وهو من عصعص الذنب",70,"ب",1,0],["كم هدى حائراً وضمَّ شتاتاً","وحمى شاغراً وأغنى مُقلاَّ",71,"ل",2,0],["كم هاجَمَتْهُمْ أُناسٌ حُسَّدٌ لهُمْ","رُدُّوا بخُسْرانِهِمْ حَقراً وقد نَدِموا",72,"م",3,0],["كم هاض من طاغ بها متجبر","ونهاه خوف الله أن يتجبرا",73,"ر",2,0],["كم هاجروا الله في كل بلدة","كأصحاب سلطان الحماة الأجاود",74,"د",1,0],["كم هزّ اوتار القلوب بخطبة","فعلت كما فعلت بهن شمول",75,"ل",1,0],["كمهرقٍ رائقٍ عجيبٍ","وشاه بالحبر من دواةِ",76,"ه",1,0],["كم همة لك بالدنيا مجردة","كالسيف عري متناه عن الخلل",77,"ل",1,0],["كَم هاجَ وَجدي وَالغرامَ حَمائمٌ","قَد غَرَّدت صُبحاً عَلى أَيْكاتِها",78,"ت",3,0],["كَم هَجمَةٍ وَضَعوا فيها سَلالِمَهم","وَما بِهِ لِصعودِ السُّورِ تَوسيلُ",79,"ل",1,0],["كم هُدى لي وضلالٍ","وحَياةٍ وممات",80,"ت",1,0],["كم هولِ أمرٍ فيك قد وافيته","ومُفنِّدٍ لي فيك قد عاديته",81,"ه",1,0],["كَم هَصَرنا فِيهِ أَغصانَ المُنى","ولِنُوّارِ الفُكاهاتِ اقتَطَفنا",82,"ن",2,0],["كمهاة الصريم لولا التثني","خالها اللحظ دمية المحراب",83,"ب",1,0],["كم هموم جلا وكم من كروب","كم سموم وقى وكم زمهرير",84,"ر",1,0],["كم هدى حائرا وأهدى نفيسا","لوليّ وكم أزاح ستارا",85,"ر",2,0],["كَم هَمت للوفدِ من أنوائهِ","