{"poems":[[93,"حكاية حال","https://www.poetsgate.com/ViewPoem.aspx?id=53184",""],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[572,"اسلمي يا كثيرة الإعراض","https://www.aldiwan.net/poem69588.html","الخفيف"],[580,"صدوا فإنساني إليهم صدى","https://www.aldiwan.net/poem3087.html","السريع"],[612,"","https://poetry.dctabudhabi.ae/diwan/poem/82803","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38817","الطويل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61095","الطويل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58427","الطويل"],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11247","المجتث"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86268","الوافر"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108343",""]],"verses":[["وإذ شيح يستعجل الخطو نحوه","وصوت لطيف في الظّلام يقول:",0,"ل",1,0],["وَإِذ شمَّ منهُ الشيخُ ريح ضلالهِ","وَإِلحادهِ أَولاهُ مَع طردهِ زَجرا",1,"ر",2,0],["وَإِذَ شِئْتُ كَانَ قَوْلِي أَحْلَى","مِنْ حَدِيْثِ الْقِيَانِ وَالعُشَّاقِ",2,"ق",1,0],["وإذ شكا تعباً فإن الضنى","يريمه من أعين الهجد",3,"د",1,0],["وَإِذ شَمرت في لجة الماء ساقها","كَفتنا فَلم ننقل إِلى غاية رجلا",4,"ل",2,0],["وَإِذ شَقق الخدّينِ قَد كانَ مُهملاً","فَنَقطه مِنهُ الجَمال بخيلانِ",5,"ن",1,0],["وَإِذ شَملنا في غبطة مُتألق","عدمنا حَسوداً أَو رَقيباً نحاذره",6,"ر",2,0],["وإذْ شَابَ رأسي شاب عَيشي شآيبٌ","رَمى بفُؤادي مُنيَتي بِمنيّتي",7,"ي",1,0],["وَإِذ شِفاءُ الغَواني","مِنّي حَديثٌ وَقُربُ",8,"ب",1,0],["وَاذ شَرَحت بِهِ الاوقافُ صَدراً","وَعَنها قَد أَزالَ الانقِياضا",9,"ض",2,0],["واذ شجاني وميض من مباسهم","جعلت ارقب ليلاً بارق الظلمِ",10,"م",1,0]]}