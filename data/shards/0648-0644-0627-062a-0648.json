{"poems":[[55,"رضيت من الأحباب دون الذي يرضي","https://www.aldiwan.net/poem30167.html","الطويل"],[55,"هوى لكما إن الشباب يعاد","https://www.aldiwan.net/poem30513.html","الطويل"],[73,"ولا تودع متاعك عند عدل","https://www.aldiwan.net/poem3809.html","الوافر"],[49,"ما العمر ماطالت به الدهور","https://www.aldiwan.net/poem24771.html","الرجز"],[74,"يا شاهر اللحظ حبي فيك مشهور","https://www.aldiwan.net/poem18695.html","البسيط"],[45,"عيد بأية حال عدت يا عيد","https://www.aldiwan.net/poem9555.html","البسيط"],[47,"أقول لعنس كالعلاة أمون","https://www.aldiwan.net/poem66666.html","الطويل"],[30,"ألم تذكروا يا آل مروان نعمة","https://www.aldiwan.net/poem5500.html","الطويل"],[107,"أمن عرش الشآم إلى أثينا","https://www.aldiwan.net/poem43065.html","الوافر"],[83,"ياجامع الشمل بعدما افترقا","https://www.aldiwan.net/poem61453.html","الطويل"],[48,"يا نحل إن شار شهدا مكتسب","https://www.aldiwan.net/poem22624.html","البسيط"],[48,"أواني هم فألقى أواني","https://www.aldiwan.net/poem23545.html","المتقارب"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85844","المجتث"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/8786","الطويل"],[124,"غذائي الحب يا من فيه حرمان","https://www.aldiwan.net/poem49336.html","البسيط"],[154,"الخوف والأنس شيء ليس يتفق","https://www.aldiwan.net/poem68515.html","الخفيف"],[164,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[173,"إلى كم مناجاة الهموم العوازب","https://www.aldiwan.net/poem1604.html",""],[173,"أراه الهوى ما لم يكن في حسابه","https://www.aldiwan.net/poem1608.html",""],[208,"تذلل لمن تهوى تكن واجد العز","https://www.aldiwan.net/poem53275.html","الطويل"],[228,"إمحي السواد عن الأهداب في المقل","https://www.aldiwan.net/poem41914.html","البسيط"],[234,"يعد وجيع الوجد ما هيج البعد","https://www.aldiwan.net/poem51175.html","الطويل"],[280,"أسلم للمقدور ثم أسلم","https://www.aldiwan.net/poem25531.html","الطويل"],[286,"لا أمنع الدمع أن يهمى وأن يكفا","https://www.aldiwan.net/poem1375.html",""],[309,"أحبتنا بنجد والصفيح","https://www.aldiwan.net/poem16826.html","الوافر"],[309,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[362,"سأرمي بنبلي ذائدا عن حمى نبلي","https://www.aldiwan.net/poem4151.html","الطويل"],[376,"أبايعت أهل البيعة اليوم في دمي","https://www.aldiwan.net/poem57135.html","الطويل"],[445,"أهل بالبين فانهلت مدامعه","https://www.aldiwan.net/poem34880.html","البسيط"],[445,"أنورك أم أوقدت بالليل نارك","https://www.aldiwan.net/poem34885.html","الطويل"],[463,"ليل السرى مثل نهار المقام","https://www.aldiwan.net/poem55886.html","السريع"],[466,"إذا ما غزوتم معلمين فراوحوا","https://www.aldiwan.net/poem15096.html","الطويل"],[473,"كن أبدا للصديق محتملا","https://www.aldiwan.net/poem59775.html","المنسرح"],[556,"مرت بنا بمصلى الخيف سانحة","https://www.aldiwan.net/poem47343.html","البسيط"],[556,"هل هاج شوقك صوت الطائر الغرد","https://www.aldiwan.net/poem47848.html","البسيط"],[563,"أُمي جميع المقل يا مقلتي أُمي","https://www.aldiwan.net/poem34187.html","المواليا"],[563,"هذا الوجود وهذا الواحد الأحد","https://www.aldiwan.net/poem34575.html","البسيط"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83299","البسيط"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103079","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38878","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62561","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59125","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96698","الطويل"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130631","البسيط"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48919","المتقارب"],[1853,"","https://poetry.dctabudhabi.ae/diwan/poem/26594","الوافر"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110291","المجتث"],[2053,"","https://poetry.dctabudhabi.ae/diwan/poem/132441","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27630","البسيط"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105055","البسيط"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124779","الطويل"],[2491,"","https://poetry.dctabudhabi.ae/diwan/poem/115062","البسيط"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137399",""],[2897,"","https://poetry.dctabudhabi.ae/diwan/poem/122225","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202720","المتقارب"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65102","البسيط"],[3117,"","https://poetry.dctabudhabi.ae/diwan/poem/29531","الطويل"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3536,"","https://poetry.dctabudhabi.ae/diwan/poem/20600","البسيط"],[3561,"","https://poetry.dctabudhabi.ae/diwan/poem/32369","الوافر"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129409","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92443","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206138","المتقارب"],[3793,"","https://poetry.dctabudhabi.ae/diwan/poem/124786","الرجز"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131105",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114124","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135989","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135969","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135821","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135302","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135278","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135923","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135859","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135751","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135784","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135744","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103000","الوافر"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103547","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77166","الوافر"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86479","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83195","الرجز"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83192","الرجز"],[4578,"يا من تمد إليه المكرمات يداً","https://www.poetsgate.com/ViewPoem.aspx?id=49403",""],[4915,"أَرضي غروري","https://www.poetsgate.com/ViewPoem.aspx?id=212677",""],[585,"نثلت لك الكنانة في العتاب","https://www.poetsgate.com/ViewPoem.aspx?id=161849",""],[5183,"حد الطور","https://www.poetsgate.com/ViewPoem.aspx?id=186609",""],[5183,"ضالة المؤمن","https://www.poetsgate.com/ViewPoem.aspx?id=180165",""],[5183,"ذات الخمارين","https://www.poetsgate.com/ViewPoem.aspx?id=180182",""],[5448,"أطع ربك الباري وصفوة رحمان","https://www.poetsgate.com/ViewPoem.aspx?id=138060",""],[5525,"دروبي رمل","https://www.poetsgate.com/ViewPoem.aspx?id=924",""],[5616,"أفكار","https://www.poetsgate.com/ViewPoem.aspx?id=203325",""],[5689,"أراك بذي الدنيا الجفاء حبورها","https://www.poetsgate.com/ViewPoem.aspx?id=143409",""]],"verses":[["وَلا تولِجوا زورَ العُقوقِ بُيوتَكُم","أُناشِدُكُم بِاللَهِ في الحَسَبِ المَحضِ",0,"ض",1,0],["وَلا توعِدوني بِالصَوارِمِ ضِلَّةً","فَبَيني وَبَينَ المَشرَفيِّ وِلادُ",1,"د",1,0],["وَلا تُودِع مَتاعَكَ عِندَ عَدلٍ","وَلا سِيَّما إِذا كانَ اِبنَ سيما",2,"م",2,1],["وَلا تُؤَخِّر أَكلُبَ العِراضِ","فَهُنَّ حَتفٌ لِلظِباءِ قاضِ",3,"ض",1,0],["ولا توالِ أذى قلبي لتهدمه","فإنه منزلٌ بالودِّ معمور",4,"ر",1,0],["وَلا تَوَهَّمتُ أَنَّ الناسَ قَد فُقِدوا","وَأَنَّ مِثلَ أَبي البَيضاءِ مَوجودُ",5,"د",1,0],["وَلا توغِلي في أَرسَناسَ فَتَعثُري","بِمُندَرِسِ الأَحجارِ ثَمَّ دَفينِ",6,"ن",1,0],["وَلا تورِدوني آلَ مَروانَ هُوَّةً","أَخافُ بِجاري رَحلِكُم أَن تُهَدَّما",7,"م",2,0],["وَلا تُؤمِن بِساسَتِهِ زَماناً","يَعُدُّ سِياسَةَ الجُهَلاءِ دينا",8,"ن",2,0],["وَلا تُؤاخِذ فَلَستُ أَوَّلَ مَن","بِخَيسِ عَهدِ الحِسانِ قَد وَثَقا",9,"ق",2,0],["وَلا تَوَهَّمتُ أُنثى الأَنجُمِ اِمرَأَةً","وَلا ظَنَنتُ سُهَيلاً كانَ عَشّارا",10,"ر",2,0],["وَلا توجَدا أَبَداً كاهِنَينِ","تَروعانِ قَوماً بِما تَخزُوانِ",11,"ن",1,0],["ولا تؤمل إذا ما","برحتها أن تعودا",12,"د",2,0],["وَلا تولِيَنَّ الناسَ إِلّا تَجَمُّلاً","نَبا بِكَ دَهرٌ أَو جَفاكَ خَليلُ",13,"ل",1,0],["ولا توهمت أن الكون وأحر بي","حلمٌ يراه من الأرباب سكران",14,"ن",1,0],["ولا تُواكِب غداةَ السَّبق معتدياً","أهل السِّباِ وأنت اللّغو واللحق",15,"ق",1,0],["ولا تؤثروا غير النبي على النبي","فليس كنور الصبح ظلم الدياجر",16,"ر",1,0],["وَلا تُورِدَنها وِردَ سَعدٍ وَعُلَّها","إِذا نَهَلَت عَلَّ الهِجانِ الحَلايِبِ",17,"ب",1,0],["وَلا تُؤلِماهُ بِالمَلامِ فَإِنَّهُ","يُثيرُ جَواهُ وَاِترُكاهُ لِما بِهِ",18,"ب",2,0],["ولا تُوقِظَن هجرانَه بعيادةٍ","فما تقطع الأسيافُ إلا على الحَزِّ",19,"ز",1,0],["وَلا تَودّك نَفسي غَير طاهِرَةٍ","كَأَدمُعِ القَلبِ في قارورَةِ الغَزلِ",20,"ل",1,0],["ولا تُوعدُ الجاني إذا زلّ بل له","فإذا اعتذر المعروفُ عندك والوعد",21,"د",1,0],["وَلا تُوئِسَاهُ مِنْ نَجَاحِ رَجائِهِ","فَلِلدَّهْرِ فِي عُقْبَى العُبوسِ تَبَسُّمُ",22,"م",1,0],["ولا تواضعُ ذي التقوى يمانعه","ولا تكبر ذي الطغوى إذا خجَفا",23,"ف",2,0],["ولا تؤثر على الرحمن شيئاً","تعالى قابل التوب النصوح",24,"ح",1,0],["ولا توقعن اللحظ في كتبة امرىء","وقد صح أن الرقم مخزن قفان",25,"ن",1,0],["ولا تُوهَبُ المَدَّاحُ عَن حُرِّ مَدحِهَا","وَلَكن عَلَى قَدرِ الفُكَاهَةِ وَالهَزلِ",26,"ل",1,0],["ولا تُورِثَن عَينَيكَ سُقمي فإِنَّهُ","حَرامٌ عَلى الذِّميِّ مِيراثُ مُسلِمِ",27,"م",1,0],["ولا تَوَقَّيتُ سَهماً مِنْ لَواحِظِهِ","يُذيبُ سَيفي وَفِي قَلبي مَواقِعُهُ",28,"ع",2,0],["ولا تُوحِشي يَا دَوْلَةَ العزِّ والندى","مساءَكِ من نُورَيهِمَا وابتكارَكِ",29,"ك",1,0],["ولا تُوازي صدرَه فُرجةٌ","تساكن الحبّ وتَقرِي الغرامْ",30,"م",1,0],["ولا توردوها آجنَ القاع إنما","مواردها ماءُ الطُّلى والأكاحل",31,"ل",1,0],["وَلا تُؤَكِّل بِهِ مُناقَصَةً","وَلا تُسَلِّط عَلَيهِ لا وَبَلى",32,"ل",2,0],["ولا تولَّى الّذي ولّاكِ جانِبَهُ","وَلا عدا الخيرُ إلّا مَنْ تعدّاكِ",33,"ك",1,0],["وَلا تُؤاخِ منَ الأقوامِ مُنطَوياً","على الضّغينةِ مملوءاً من الحسدِ",34,"د",1,0],["ولا تؤمي السوى والغير بل أُمّي","أبي الذي تعرفي من قبل أو أُمّي",35,"ي",1,0],["ولا تؤول نصوصاً عن ظواهرها","ولا تحرِّف وخذ طبقَ الذي يرد",36,"د",1,0],["وَلا تُوَفِّر لي حَظٌّ أَلَذُّ بِهِ","إِذا تَضَمَّنَ أَشجاني وَأَشجاني",37,"ن",2,0],["ولا توالد في عدن ولا عدد","في حضرة الفرد والأفعال تنفعل",38,"ل",1,0],["وَلا تودِعِ السرَّ المَصونَ عَنِ الوَرى","لِغَيرِ شَقيقٍ فَهوَ في كَتمِهِ أَحرى",39,"ر",2,1],["ولا توجه عاري الجسم حضرته","إلا ويكسى بروداً ذات ألوان",40,"ن",1,0],["وَلاَ تُوحِشَا طَيْفَ الخَيَالَ فَإنَّهُ","يَقَرُّ بِعَيْنَيَّ الخَيَالُ المُزَاوِرُ",41,"ر",1,0],["وَلا توجفي إلّا عَلى مهلة بها","إِذا وجبَ المسرى وجدّ سراكِ",42,"ك",1,0],["ولا توهمت اني في الزمان ارى","يسير من فوق راحات الورى علم",43,"م",1,0],["ولا توجسي خيفة من ولوعي","فما لفؤاديَ عنك بديلْ",44,"ل",1,0],["وَلا توهي شِمالَكَ لِلأَعادي","فَقَد تَصِلُ الشِمالُ لَكَ اليَمينا",45,"ن",2,0],["ولا توالت حظوظي","سوداً على إثر سود",46,"د",1,0],["ولا تؤَخّر ذا العلى عليَّا","الهاشمي البطلَ الكميَّا",47,"ي",2,0],["ولا تولد عن شيءٍ تقدّمه","فبالوجودِ القديمِ الحادثِ انفردا",48,"د",2,0],["ولا تؤمل سوى رضاه","فإنه للنجاة سلم",49,"م",1,0],["ولا توعين يوعى عليك وأنفقن","يوسع عليك الله رزقا وترقد",50,"د",1,0],["ولا توانٍ ولا عجزٌ يضرُّ اذاذ","جاءَ القضاءُ بما فيهِ لكَ الخِيرُ",51,"ر",1,0],["ولا تؤاخذ عبيدا في تجرئه","على علاك فلولا العذر ما طمعا",52,"ع",2,0],["ولا تؤيس طامعا في رتبة","لمثلها نظيرُه لم يلحق",53,"ق",1,0],["ولا تودع السر إلا له","فلن تجمع السر إما فشا",54,"ش",2,0],["ولا تُؤاخذ جميع العالمين به","يغدُو البريءُ مُصابا والطلوبُ نج",55,"ج",1,0],["وَلا توعِدَنّي إِنَّني إِن تُلاقِني","مَعي مَشرَفِيٌّ في مَضارِبِهِ قَضَم",56,"م",1,0],["ولا تؤم لذي السلطان كن وجلا","ولا تناج لثان دون ثلثهم",57,"م",1,0],["ولا تؤم لقوم يكرهونك حد","ولا تطول ولاحظ صاحب الهرم",57,"م",1,0],["ولا تواصل اذانا بالاقامة بل","فامكث اذا لم يضق وقت لجمعهم",57,"م",1,0],["ولا توهم بذنب كان ذا كبر","فقد اجيب عدو اللّه من قدم",57,"م",1,0],["وَلا تُوَجَّعُ مِن حَقٍّ تَحَمَّلُهُ","وَلا تَتَبَّعُ بِالتَكديرِ ما تَهَبُ",58,"ب",1,0],["وَلا توعِد لِتَقتُلَهُ عَلِيّاً","فَإِنَّ وَعيدَهُ كَلَأُ وَبيلُ",59,"ل",1,1],["ولا تورث من أسلافه شرفا","إلا أضاف إليه مثله شرفا",60,"ف",2,0],["ولا تُؤمّلُ أن يبدي الزَمان لقاً","ما لم يَرُدَّ المعيدُ الروحَ للجسد",61,"د",1,0],["ولا تُوجروا العين خمر الهوى","وتأبوا على القلب أن يثملا",62,"ل",2,0],["ولا تُؤَاخِذهم بما قد أسلَفوا","فهُم بأنواع الخطايا اعترفوا",63,"ف",3,0],["ولا توخى كما يبغي الورى عملا","إلا لوت عزمه عن قصده العبر",64,"ر",1,0],["وَلاَ تُوَاصِل زِيَارَاتِ المُحِبِّ تَزِن","فِي عَينِهِ زِينَةَ الثُّغُورِ بِالفَلَجِ",65,"ج",1,0],["ولا توالِني بشرّ من سواكْ","ووالِني خيرَكَ ربِّ ورضاكْ",66,"ك",1,0],["ولا تؤاخذنا بذنبٍ قد يَجِلْ","ولا بذنبٍ يا إلهي يستقِلْ",67,"ل",1,0],["ولا تؤاخذَنَّ بالعصيانِ","ما دمت ذا عفوٍ وذا غفرانِ",68,"ن",1,0],["ولا تُؤاخِذَنّي إن أخطأتُ","وإن تعمّدتُ وإن أجرأتُ",69,"ت",1,0],["ولا تواخِذَنِّي في الأزمانِ","بكلِّ ما فعلتُ في البُلدانِ",70,"ن",1,0],["ولا تؤاخذ والديَّ والبنينْ","ولا تؤاخذنْ بناتي أيَّ حينْ",71,"ن",1,0],["ولا تؤاخذنْ إخوتي ولا","تؤاخذنْ أخواتي مسجَلا",71,"ل",2,0],["ولا تؤاخذنْ قبيلتي ولا","تؤاخذنْ أحبَّتي كُلاًّ ولا",71,"ل",2,0],["ولا تؤاخذنّي بالذنوبِ","سرّاً وجهراً واسترنْ عيوبي",72,"ي",1,0],["ولا تواخِذنا بما قدَّمنا","واغفرْ لنا إلهي ما أجرمنا",73,"ن",2,0],["ولا توجِّهَنَّا قلبَ شخصِ","إلى حريمنا بأي نقصِ",74,"ص",1,0],["ولا توجِّهنْ عليَّ شرا","من بشرٍ ولا سواه طُرّا",75,"ر",2,0],["ولا تؤيسك قارعة ألحّت","وكيف اليأس والدنيا سجال",76,"ل",1,0],["ولا توهمت أيام الربيع ترى","في ناجر غصة الأنوار والزهر",77,"ر",1,0],["وَلا تُؤاخِذُني بِجُرم مَضى","أَيّام لَهوي فَالشَبابُ اِنقَضى",78,"ض",2,0],["ولا توسمت رسماً في منازلهم","ولا تطلعت برقاً بالغضا لمحا",79,"ح",2,0],["وَلا تُؤاخذهُ بِذاكَ الذَنبِ","وَلا تَكُن فَظّاً غَليظَ القَلبِ",80,"ب",1,0],["وَلا تُوَدِّعهم وَداعَ القالي","فَإِنَّهُ مِن خُلُقِ الأَرذالِ",81,"ل",1,0],["ولا تؤمل بوعدٍ منهُ أمنيةً","فهل مليحٌ يفي يوماً بما وعدا",82,"د",2,0],["ولا تواقيعُ ياني وهيَ ساحرةٌ","تفوقُ لحني بتأنيقٍ وتنسيقِ",83,"ق",1,0],["ولا تولي سوى الغرب امتيازاً","إليه الشرق ينظر باكتئاب",84,"ب",1,0],["ولا توقفاه دون شأو يرومه","فللشأو شأن في مداه عجيب",85,"ب",1,0],["ولا توقظ الشر من نومه","فيضرى عليك بأنيابه",86,"ب",2,0],["ولا توغري همي عليّ فإنني","أحس بصدري جاحماً من تسعر",87,"ر",1,0],["ولا توقعن اللحظ في كتبة امرئ","وقد صح أن الرقم مخزن قفان",88,"ن",1,0],["ولا تواعدنا وبه في الأرض زهره","ولا تفارقنا وبه للبرق طاري",89,"ر",2,0],["ولا توضأت من ماء شككت به","ولا خصفت على ما عابني ورقا!",90,"ق",2,0],["ولا تول سلطان الشعور على الحجى","فما يتعب الألباب إلا شعورها",91,"ر",3,0]]}