{"poems":[[55,"ضربن إلينا خدودا وساما","https://www.aldiwan.net/poem29807.html","المتقارب"],[55,"تناسيت إلا باقيات من الذكر","https://www.aldiwan.net/poem30441.html","الطويل"],[55,"أبينتها أم ناكرتك شياتها","https://www.aldiwan.net/poem30677.html","الطويل"],[55,"لنا كل يوم رنة خلف ذاهب","https://www.aldiwan.net/poem30738.html","الطويل"],[55,"خطوب لا يقاومها البقاء","https://www.aldiwan.net/poem30775.html","الوافر"],[44,"يقول الأرذلون بنو قشير","https://www.aldiwan.net/poem50350.html","الوافر"],[90,"متى تطلق الأيام حرية الفكر","https://www.aldiwan.net/poem45065.html","الطويل"],[11,"أتاني من الديان أمس رسالة","https://www.aldiwan.net/poem266.html",""],[64,"إذا ما لم تكن ملكا مطاعا","https://www.aldiwan.net/poem52352.html","الوافر"],[46,"ألا صنع البين الذي هو صانع","https://www.aldiwan.net/poem29674.html","الطويل"],[107,"بكيت فأبكيت الطلول البواليا","https://www.aldiwan.net/poem43394.html","الطويل"],[107,"تجيب بعثت الوفد أما سبيله","https://www.aldiwan.net/poem44001.html","الطويل"],[107,"ودع ذويك وسر في شأنك الجلل","https://www.aldiwan.net/poem44046.html","البسيط"],[107,"اسم سما لفظه وازدان معناه","https://www.aldiwan.net/poem44048.html","البسيط"],[77,"قد أدبر الليل عنا فا حد بالإبل","https://www.aldiwan.net/poem69022.html","البسيط"],[77,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[50,"عفا المصلى وأقوت الكثب","https://www.aldiwan.net/poem10767.html","المنسرح"],[48,"مناطق غلمان وأحجال أنس","https://www.aldiwan.net/poem23366.html","الطويل"],[48,"لقد أتوا بحديث لا يثبته","https://www.aldiwan.net/poem23481.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85589","المتقارب"],[108,"عدل السماء","https://www.poetsgate.com/ViewPoem.aspx?id=179777",""],[111,"تلك البوارق حاديهن مرنان","https://www.poetsgate.com/ViewPoem.aspx?id=100",""],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[11,"أتاني مِنَ الدّيّانِ، أمسِ، رِسالة ٌ","https://www.poetsgate.com/ViewPoem.aspx?id=16868",""],[92,"الثورة العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=178929",""],[92,"سبيل الجَماهير","https://www.poetsgate.com/ViewPoem.aspx?id=178923",""],[111,"تلك ربوع الحي في سفح النقا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545619",""],[55,"خُطُوبٌ لا يُقَاوِمُهَا البَقَاءُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9811&r=&rc=8",""],[136,"سالت القطرة من كأسي التي","https://www.aldiwan.net/poem54931.html","الرمل"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[215,"وفدت على بغداد والقلب موجع","https://www.aldiwan.net/poem46574.html","الطويل"],[240,"قفوا تعجبوا من سوء حالي ومن ضري","https://www.aldiwan.net/poem31944.html","الطويل"],[253,"اغالط مهما سميت ام خالد","https://www.aldiwan.net/poem1318.html",""],[409,"حمام بأغصان الرياض ترنما","https://www.aldiwan.net/poem33421.html","الطويل"],[445,"أنورك أم أوقدت بالليل نارك","https://www.aldiwan.net/poem34885.html","الطويل"],[445,"لك الخير قد أوفى بعهدك خيران","https://www.aldiwan.net/poem34887.html","الطويل"],[447,"سلوا هل تروا خلقا وإن عز باقيا","https://www.aldiwan.net/poem14491.html","الطويل"],[469,"ديارهم بين العذيب فعاقل","https://www.aldiwan.net/poem3513.html","عموديه"],[482,"آليت لا حلت ولا حلتم","https://www.aldiwan.net/poem15270.html","السريع"],[788,"","https://poetry.dctabudhabi.ae/diwan/poem/206092","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48678","الكامل"],[181,"","https://poetry.dctabudhabi.ae/diwan/poem/81912","الطويل"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105470","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96724","البسيط"],[1235,"","https://poetry.dctabudhabi.ae/diwan/poem/105212","البسيط"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50034","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49926","الطويل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128701","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79987","الكامل"],[1586,"","https://poetry.dctabudhabi.ae/diwan/poem/96336","الطويل"],[358,"","https://poetry.dctabudhabi.ae/diwan/poem/84258","البسيط"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120569","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60829","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87336","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87339","الطويل"],[2673,"","https://poetry.dctabudhabi.ae/diwan/poem/70354","البسيط"],[3080,"","https://poetry.dctabudhabi.ae/diwan/poem/96117","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132719","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100778","المتقارب"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71302","المنسرح"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26116","الطويل"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26117","البسيط"],[3307,"","https://poetry.dctabudhabi.ae/diwan/poem/145541","الطويل"],[3544,"","https://poetry.dctabudhabi.ae/diwan/poem/116841","الوافر"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66363","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91077","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205542","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206137","البسيط"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132115","المتقارب"],[4004,"","https://poetry.dctabudhabi.ae/diwan/poem/111320","البسيط"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78308","البسيط"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127072","المتقارب"],[4292,"","https://poetry.dctabudhabi.ae/diwan/poem/67624","الطويل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117271","الطويل"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62162","الوافر"],[4483,"","https://poetry.dctabudhabi.ae/diwan/poem/101323","السريع"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139474",""],[4755,"العميد عدنان الحمادي .. وداعا","https://www.poetsgate.com/ViewPoem.aspx?id=207924",""],[4816,"عبدالله","https://www.poetsgate.com/ViewPoem.aspx?id=8479",""],[4862,"واحَرَّ قلبي منكِ يا وعدُ","https://www.poetsgate.com/ViewPoem.aspx?id=55629",""],[4896,"قلوب في جوانبها ضرام","https://www.poetsgate.com/ViewPoem.aspx?id=180864",""],[4984,"يَوْمُ الْاسْتِقْلَالِ","https://www.poetsgate.com/ViewPoem.aspx?id=204988",""],[5112,"خلاصة العرب","https://www.poetsgate.com/ViewPoem.aspx?id=211997",""],[5582,"عُجْ بِالمَطِيِّ فَهذا السَّفْحُ وَالعَلَمُ","https://www.poetsgate.com/ViewPoem.aspx?id=63577",""],[482,"حرامٌ على الجفنِ القريحِ منامُه","https://www.poetsgate.com/ViewPoem.aspx?id=111412",""],[5616,"القدس","https://www.poetsgate.com/ViewPoem.aspx?id=203475",""],[5644,"ضيا الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=198647",""],[5701,"تعجبت حتى كدت لا أتعجب","https://www.poetsgate.com/ViewPoem.aspx?id=164590",""],[5786,"يا بارقاً لاحَ من أكتاف كوفانِ","https://www.poetsgate.com/ViewPoem.aspx?id=50655",""],[5956,"المضحوك عليهم.!","https://www.poetsgate.com/ViewPoem.aspx?id=192182",""],[5956,"الشر فينا منذ قابيلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=192436",""],[5956,"الثلاثي المثالي","https://www.poetsgate.com/ViewPoem.aspx?id=193163",""],[5956,"رحلةُ أسرة لغابِ المَسَرَّة","https://www.poetsgate.com/ViewPoem.aspx?id=210739",""]],"verses":[["هُمُ اِستَيقَظوا وَحدَهُم لِلخُطوبِ","فَقاموا بِها وَأَناموا الأَناما",0,"م",2,0],["هُمُ اِستَفرَغوا ما كانَ في البيضِ وَالقَنا","فَلَم يَبقَ إِلّا ذو اِعوِجاجٍ وَذو كَسرِ",1,"ر",1,0],["هُمُ اِستَلدَغوا رُقشَ الأَفاعي وَنَبَّهوا","عَقارِبَ لَيلٍ نائِماتٍ حُماتُها",2,"ت",3,0],["هُمُ اِستَخدَموا الأَملاكَ عِزّاً وَأَرهَفوا","بَصائِرَهُم بَعدَ الرَدى وَالمَعاطِبِ",3,"ب",1,0],["هُمُ اِستَولَوا عَلى النُجَباءِ مِنّا","كَما اِستَولى عَلى العودِ اللِحاءُ",4,"ا",2,0],["هُمُ آسَوا رَسولَ اللَهِ حَتّى","تَرَبَّعَ أَمرُهُ أَمراً قَوِيّا",5,"ي",2,0],["هما ساحلا بحر من العيش مائج","ففي أيّ أمر نحن بينهما نجري",6,"ر",2,0],["هُما سَأَلاني ما فَعَلتُ وَإِنَّني","كَذَلِكَ عَمّا أَحدَثا أَنا سائِلُ",7,"ل",1,0],["هما سِيّانِ من مُلكٍ ونُسْكٍ","يُنيلان الفتَى الشرفَ الرفيعَا",8,"ع",2,0],["هُمُ اِستَودَعوا المَعروفَ مَحفوظَ مالِنا","فَضاعَ وَما ضاعَت لَدَينا الوَدائِعُ",9,"ع",1,0],["هُمُ اِستَودَعوناها فَضاعَت وَلا أَرى","مِنَ الصَحبِ إِلّا عاجِزاً مُتَوانِيا",10,"ي",2,0],["هُم اسْتأذنُوه في الإيابِ وودَّعوا","تُشيِّعُهم منه العَطايا الدَوالِحُ",11,"ح",1,0],["هُما سبيلانِ إمّا النصرُ نُدرِكُه","أو جنّةُ الخُلدِ فيها أطيبُ النُّزُلِ",12,"ل",1,0],["همْ أسرةٌ في ظلالِ اللَّهِ واحدةٌ","تَمضي على الحقِّ تَرجوه وتخشاهُ",13,"ا",2,0],["همُ استبدوا بأسلاب الملوك وهم","حزُّوا نواصيَ أهلِ الخيل والحللِ",14,"ل",1,0],["هُمُ استبدوا بأسلابِ الليوثِ وهُم","جَزّوا نواصيَ أهْلِ الخَيم والحُلَل",15,"ل",1,0],["هُما سَواءٌ وَفَرقُ بَينِهِما","أَنَّهُما جامِدٌ وَمُنسَكِبُ",16,"ب",1,0],["هُمُ أَسِفوا لِلخَطبِ موجِبِ فَرحَةٍ","وَهَشّوا لِأَمرٍ وَهوَ إِحدى السَلاتِمِ",17,"م",1,0],["هُمُ أَسارى مَناياهُم فَما لَهُم","إِذا أَتاهُم أَسيرٌ لا يَفُكّونَه",18,"ن",2,0],["هم استيقظوا من رقاد لهم","صباحاً ونحن بقينا نياما",19,"م",2,0],["هم استخرجوا التِّبر من بطنها","وعاشوا على ظهرها أُسراء",20,"ا",2,0],["هم أسمع الناس في حق وأبصرهم","وفي سواه هم صم وعميان",21,"ن",1,0],["هم أسبغوا للمكرمات دهرهم","فدهرهم للمكرمات في طوى",22,"ا",1,0],["هما سألاني ما فعلت، وإنني","كذلك، عما أحدثا، وأنا سائلُ",23,"ل",1,0],["هم استسلموا للموت ، والموت جارف","وهم عرضوا للسيف ، والسيف قاطع",24,"ع",1,0],["هم استسلموا فاستعبَدتْهم عوائدٌ","مَشت بِهمُ في الناس مشيَ المقيَّد",25,"د",1,0],["هم أسغبوا للمكرمات دهرهم","فدهرهم للمكرمات في طوى",26,"ا",1,0],["هم استولوا على النخباء منا","كما استولى على العود اللحاء",27,"ا",2,0],["هم أساغوك وساغوك ندى","عبقريا ونعيما ورفاها",28,"ه",2,0],["هُم أَساساً للنصرِ كانوا وهل يث","بُتُ إلّا عَلى الأساس البناءُ",29,"ا",2,0],["همُ أسلموني لا عفا الحب عنهم","إلى ليلةٍ من غمرة الحزن ليلاء",30,"ا",2,0],["هُمُ أَسلَموا القَلبَ الخَؤونَ إِلى الأَسى","وَهُم وَكَلوا عَيني بِأَدمُعِها الغُزرِ",31,"ر",1,0],["هما سروتا الحسن الذي حسن روضها","اذا ما انثنى فيه سميهما السرو",32,"و",1,0],["هما سرقا الأعمار منا لأجل ذا","يفران كالسراق في كل مرتمى",33,"م",2,0],["هُما سَمِعا دَعواكِ يَا دعوَة الهدى","وَقَدْ أَوْثقَ الدهرُ الخؤونُ إِسارَكِ",34,"ك",1,0],["هُمُ اسْتَخْلَفُوا الأَحبابَ أَمْوَاجَ لُجَّةٍ","هِيَ المَوْتُ أَوْ فِي المَوْتِ عَنْهُنَّ سُلْوَانُ",35,"ن",1,0],["هما سيدا الابدال لم تلق منهما","على الذكر لو حل العقالين ساهيا",36,"ي",2,0],["همُ أسرةُ المجد التليد فمنهمُ","صدور النوادي أو صدور الجحافل",37,"ل",1,0],["هم أسلموني لاِسارِ الهوى","ظلماً وظنُّوا أنَّني أسلمُ",38,"م",1,0],["هم استنقذوا مني الكليبي بعدما","هوى بين أنياب شبكن من اللخم",39,"م",1,0],["هم أسلموا للذئب قبلك شاتهم","ولنا عليك خلاص هذي الشاة",40,"ه",1,0],["هما سَأَلاني ما بَعيرانِ قُيِّدا","وشَخصانِ بِالْبَرْقاءِ مُرْتَبِعانِ",41,"ن",1,0],["هم أسلموني إلى الأرزاء بعدهم","وخلفوني حليف الوجد وارتحلوا",42,"ل",3,0],["هم أسّسوا الملكَ في الدنيا بهمّتهم","حتّى اِستَقام مدى الأيام ملكهمُ",43,"م",1,0],["هم أسسوا الجود لا معن بن زائدة","كلا ولا حاتم الطائي إن ذكرا",44,"ر",2,0],["هما سيدايَ لاعدمت رضاهما","وأرضيهما إن قلت لاعدماني",45,"ن",2,0],["هما سَلكا آثارهم وتَقيَّلا","خلائقهم لا يَعْدوُان تأدُّبا",46,"ب",2,0],["هم أسلموا الله وجها وركبت","على نصرة الاسلام فيهم طبائع",47,"ع",1,0],["هم أسرةُ الدين التي","فرضَ الإِلهُ ولاءها",48,"ا",3,0],["هم استنقذوا حسان قرا وانتم","لئام المقام والرماح شوارع",49,"ع",1,0],["هُما سَبيلان في أَمرٍ إِذا اِختَلَفا","ما بَيننا فَعلى حُكم الهوى اِتَّفَقا",50,"ق",2,0],["هم أسَّسُوا المُلكَ المشيدَ بناؤُهُ","فكفَوا به الإسلامَ خَطباً فادِحا",51,"ح",2,0],["هم أسقموني دهراً لا عدمتهم","وليس غيرهم يشفى من السقم",52,"م",1,0],["هُمَا سِتَّةٌ فيهَا بِغَيرِ تَزَلزُلٍ","على جَردَفُونٍ صحَّ بالشَّفعِ والوَترِ",53,"ر",1,0],["هُمَا ستَّةٌ لَكِن نفيسٌ قياسُهُم","بمنتَخِ أرياحِ الشمالِ القَواطِع",54,"ع",1,0],["هم استحلوا دمي عمداً فلا حرج","إن أسعفوني بالانصاف أو ظلموا",55,"م",3,0],["هما سيدا غيظ بن مرة لوهوى","من الذبل ميزاناهما لتضعضعا",56,"ع",2,0],["هم اسعروا مهجتي ناراً فخضت بها","في بحر عشق بموج العشق ملتطم",57,"م",1,0],["هما سببا للفتى ضجعة","بقبر على ضيقه آهل",58,"ل",1,0],["هُمَا سَوَاءُ وَالفَرْقُ بَيْنَهُمَا","أَنَّهُمَا سَاكِنٌ وَمُضْطَرِبُ",59,"ب",1,0],["هُمُ اِستَلَبوا مِنكُم إِزارا ظُلامَةً","فَلَم تَبسِطوا فيها لِساناً وَلا يَدا",60,"د",2,0],["هُم أَسرَعُ الناس إِدراكا إِذا طَلَبوا","وَأَعظَمُ الناسِ أَحلاما إِذا قَدَروا",61,"ر",3,0],["هم أسوة الأمجاد، لولا سماحهم","لما اهتو مأمول لإسعاف آمل",62,"ل",1,0],["هما سَبَتَا الفؤادَ وأصبتاهُ","ولم يُدرِك بذلك ما ارادا",63,"د",2,0],["هم استقدموه من مدينة يثرب","بكتبهم واستمردوا حين أقبلا",64,"ل",2,0],["هم استباحوا دماً إذ حرّموا صلةً","وَحللوا الدَمع بَعدَ الهجر من مهج",65,"ج",1,0],["هما سبيلان من يبغِ السلامة لا","يأسف على الحق أو يحلم برؤياهُ",66,"ا",2,1],["هم أسرع الناس في قدح فإن طلبوا","ما يجلب المدح أعيوا كل إعياء",67,"ا",2,0],["هم استصغروك ولكن غداة","أخذت بأسماعهم كبروا",68,"ر",3,0],["هم اسرة الحرب إن قاموا وان قعدوا","وهم بنو الموت إن جاشوا وان حلموا",69,"م",3,0],["هُم اِستَجَدّوا ببحر الحُب ما وَهَنوا","وَما اِستَكانوا وَما خاضوا وما عاموا",70,"م",3,0],["هما سمهريا قلوب الأعادي","هما غصنا روض مردي المعادي",71,"ي",1,0],["هم استعتبوا لي الدهرَ والدهرُ ساخطٌ","فأعتبني بالكره منه وبالصعر",72,"ر",1,0],["همُ أسسوا العليا وأحيوا رسومها","ففخر العلا حتماً عليهم غدا وقفا",73,"ف",2,0],["هما سيان إن صحفت حرفاً","وجدت الراء تنقص أو تزيد",74,"د",1,0],["هما سراجان بيتيهما","كانا لعمري لهما آيتين",75,"ن",1,0],["هما سماءا علاً شمسا ضحىً قمرا","هدىً خضِّما ندىً فاضا بأنواء",76,"ا",2,0],["همْ أسكَتوكَ.. وأنت لَحنُ قلوبنا","كي يَملؤوا مُهَجَ البلادِ فَحِيحا",77,"ح",2,0],["هم اسسوا للعز ساس وبنيان","وهم طفحوا كيل الكرم والبساله",78,"ل",2,0],["همُ أسلموا لك أمرهم طوعاً","وأمرْتِهِمْ وكأنهم جندُ",79,"د",1,0],["هما سجنان يتفقان معنى","ويختلفان ضيقا واتساعاً",80,"ع",2,0],["هُمُ اسْتَرْخَصُوا الْأَرْوَاحَ فَي مَحْشَرِ الْوَغَى","وَضَحَّوْا وَفَاءً لِلْعُهُودِ بِأَبْدَانِ",81,"ن",1,0],["هُمُ أَسْبَابُ عِزَّتِنَا","فَنِعَمَ خُلَاصَةُ الْعَرَبِ",82,"ب",1,0],["هُمْ أَسَّسُوا المَجْدَ فِي الدُّنْيا بِهِمَّتِهِمْ","حَتَّى اسْتَقامَ مَدَى الأَيَّامِ مُلْكُهُمُ",83,"م",1,0],["هما سَبَبا ذاكَ التماسكِ بعدَما","أضرَّ به اِرقالُه ودوامُهُ",84,"م",2,0],["هم أساءوا فمزقونا بطونا","وتمادوا فقطعوا الأرحاما",85,"م",2,0],["هما سَجْدتان تُزِحنَ الهمومَ","ومن لازمَ الذكرَ دومًا نَجَى",86,"ج",2,0],["هما سره الخافي وإن كان باديا","وعندهما عنه الكثير المغيب",87,"ب",1,0],["هما سراجان في جودٍ وفي كرمٍ","وفي الفضائل والتوحيد بحرانِ",88,"ن",1,0],["هم أسُودٌ ضد بعضٍ، وظِباً","إن طغَى الأعداء لفّوا الذنبا",89,"ب",2,0],["هم أسوةٌ ميمونة بشريعةٍ","يدعو لها الحكماء والديّانُ",90,"ن",1,0],["هم أسرةٌ خلعوا ستار ركودهم","وخضوعهم للجهلِ والتعتيمِ",91,"م",1,0],["هم أسرتان كريمتان اعتادتا","منْحَ القرابة قيمة المِحْرابِ",92,"ب",1,0]]}