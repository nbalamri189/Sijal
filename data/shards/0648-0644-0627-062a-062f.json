لا تشرك به أحداً","https://www.poetsgate.com/ViewPoem.aspx?id=171101",""],[4934,"ماني بشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=32780",""],[4984,"سوء الظن","https://www.poetsgate.com/ViewPoem.aspx?id=176015",""],[5054,"فديتك","https://www.poetsgate.com/ViewPoem.aspx?id=214799",""],[5054,"يا ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=213741",""],[5061,"النصيحه","https://www.poetsgate.com/ViewPoem.aspx?id=156538",""],[5183,"وَقَارُ الحَوَادِثُ","https://www.poetsgate.com/ViewPoem.aspx?id=186446",""],[5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5262,"إذا مت فادفني مجاور كرمة","https://www.poetsgate.com/ViewPoem.aspx?id=165128",""],[5292,"العلم أبقى لأهل العلم آثاراً","https://www.poetsgate.com/ViewPoem.aspx?id=122673",""],[592,"رسائل أخوان الصفا والتودد","https://www.poetsgate.com/ViewPoem.aspx?id=128837",""],[5376,"لنا قدسٌ وشامُ","https://www.poetsgate.com/ViewPoem.aspx?id=188266",""],[5448,"أطع ربك الباري وصفوة رحمان","https://www.poetsgate.com/ViewPoem.aspx?id=138060",""],[5538,"ترفع عن وضيع النفس تسلم","https://www.poetsgate.com/ViewPoem.aspx?id=142622",""],[5550,"يكون الفتى","https://www.poetsgate.com/ViewPoem.aspx?id=211259",""],[5550,"يا ابن الوجود","https://www.poetsgate.com/ViewPoem.aspx?id=211770",""],[5689,"أراك بذي الدنيا الجفاء حبورها","https://www.poetsgate.com/ViewPoem.aspx?id=143409",""],[6031,"أَمَوْلَى الوَرَى إنِّي جَعلْتُكَ في الذِي","https://www.poetsgate.com/ViewPoem.aspx?id=46412",""],[6079,"سنن الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=212718",""]],"verses":[["وَلا تَداوَيتُ مِن قَرحٍ فَرى كَبِدي","وَلا سَقانِيَ راقي الحَيِّ سُلوانا",0,"ن",2,0],["وَلا تُدنِ الحَسودَ فَذاكَ عُرٌّ","مَضيضٌ لا يُعالَجُ بِالهِناءِ",1,"ا",2,0],["وَلا تَدعوني لِلجَورِ واِصبِر عَلى الَّتي","بِها كُنتُ أَقضي لِلبَعيدِ عَلى أَبي",2,"ب",2,0],["وَلا تَدعُني لِلجورِ واصبِر عَلى الَّتي","بِها كُنتُ أَقضي لِلبَعيدِ عَلى أَبي",3,"ب",2,0],["ولا تَدَعْ مَنْ بغى عليهم","إلا لَقىً دائمَ الكلومِ",4,"م",1,0],["وَلا تَدَعها تُحيِ مُستَبِدَها","وَتَنتَحِت بِراحَتَيها فَردَها",5,"د",3,0],["ولا تدعوا البذور الذي قد طرحتمُ","يجفّ فتخطوا من ثماركم الجنى",6,"ن",2,0],["ولا تدعوا كتمانه إن علمتمُ","وكونوا لسر الله في الأرض مخزنا",6,"ن",2,0],["ولا تَدَعوني والحوادثَ إنّها","تُعرِّقني عرقَ المُدى وتُمَخْمِخُ",7,"خ",1,0],["وَلا تَدري أَفي أَرضِ","كَ أَم في غَيرِها تُصرَع",8,"ع",1,0],["وَلا تَدَع مَكسَباً حَلالاً","تَكونُ مِنهُ عَلى بَيانِ",9,"ن",1,0],["وَلا تُدَنِّسها بِمَز","جِ مائِكَ المُرَقرَقِ",10,"ق",1,0],["ولا تَدَعِي الرسيمَ ولا الذّميلا","ويا خَيلُ اركضي بالقوم ركضا",11,"ض",2,0],["وَلا تُدرِ كَنكَ الشَمسُ عِند طُلوعِها","فَأَعلَقَ فيهِم أَو يَطولَ ثَوائِيا",12,"ي",2,0],["ولا تدعن نيكهُ جاهداً","فإن الندامةَ في تركهِ",13,"ك",2,0],["وَلا تَدنُ لِلصَهباءِ بِنتاً لِأَبيَضٍ","وَلا تَقرَبِ الحَمراءَ مِن وَلَدِ الزَنجِ",14,"ج",1,0],["ولا تدع أن يكيدو","ك واجتنب أن تكيدا",15,"د",2,0],["ولا تَدْفِنيها الجَهْرَ بل دَفْنَ فاطِمٍ","ودَفْنَ ابنِ أرْوَى لم يُشَيّعْ بإعْوال",16,"ل",1,0],["ولا تدورُ لشعر في مُخَيِّلَة","والشعر تَدْنُو له الشِّعْرَى وَكِيوان",17,"ن",1,0],["ولا تُدغدِغُ منه لذَّةٌ حُلُماً","بل لا يُطيقُ حديثَ اللذَّةِ العذِبا",18,"ب",2,0],["وَلاَ تَدْرِيِ أَفِي أَرْضِكَ","ك أم في غيرها تصرع",19,"ع",1,0],["ولا تدع العيون إذا تلاقت","تمرق عن تجاهلنا الحبابا",20,"ب",2,0],["ولا تدعوني للفكاهةِ بعدها","فقد ذهبت أيام عمري بها سدى",21,"د",2,0],["ولا تدعي يوماً ليوم ورائه","فعقبي تواني المرء فوتُ المصالحِ",22,"ح",1,0],["ولا تدع فرحا إلا صرفت به","وجه الهموم فباب الموت ينتظر",23,"ر",1,0],["ولا تَدَعِ فضلاً على نجلِ سالم","فذلك خيرٌ منك أنقى وأشجَعُ",24,"ع",1,0],["وَلا تَدَعي أُمّي تَفيقُ من الكَرى","فَإِنّي سَأَقضي اللَيلَ داخِلَ مَكتَبي",25,"ب",2,0],["ولا تدعني نهبة لجنوده","وكن لي بحسن الحفظ منه محصنا",26,"ن",2,0],["ولا تدع في النيل من إثرها","إلا بقايا الصوف والبعر",27,"ر",1,0],["ولا تدعي الإخوانَ في أرضِهم عدىً","بما زيَّنَت أهواءُ غاوٍ وكاذب",28,"ب",1,0],["ولا تَدع ولا تَذر","ما تَستَطيعَ من نَظر",29,"ر",1,0],["ولا تدع حسرات النفس سارحه","في مهمه الوجد واحذر روعة القنص",30,"ص",1,0],["ولا تدن ممن يختلى في تكلم","الى حين يفضى فادت منه بايذان",31,"ن",1,0],["ولا تدن ممن لم يكن منك أرفعا","مقاما بأعمال وفضل وعرفان",31,"ن",1,0],["وَلا تَدعُ إِلّا خالق الخَلق سامع الد","دُعا فَهوَ مِن حَبل الوريدين أَقرَبُ",32,"ب",1,0],["ولا تَدعُ العلياءُ صَهْوةَ طِرْفِه","تَقِرُّ ولا مِقْدارَ تَجفيفةِ الِّبْد",33,"د",1,0],["ولا تدعهُ يذكرُ اسمَه ولا","إسمَ الذي شاركه إذ جهلا",34,"ل",2,0],["ولا تدع إلاّ اللهَ في كلّ حاجةٍ","تجده قريباً حينَ تدعوه حاضِرا",35,"ر",2,0],["ولا تدعوا من اليونا","ن طفلا أو أخا هرم",36,"م",1,0],["ولا تدع الجنادب حاكميها","كأنك لم تجد فيها ملاذا",37,"ذ",2,0],["ولا تدرَّعتُ بوصفِ فضلِهِ","في حلبةٍ برَّزتُ في مَيْدانِها",38,"ن",3,0],["ولا تَدُلُّوها فقدّامَها","أدلّة الشوق وهادي الشميمْ",39,"م",1,0],["ولا تدعْ حُلَّة يومٍ لغدٍ","يأتي بأخرَى فالهوى ما قدُما",40,"م",2,0],["ولا تدعني ودعاء الصّبا","في معشرٍ أشقَى بهم مُعسِرا",41,"ر",2,0],["ولا تدرُّ المالَ أخلافُهُ","وغيرُ أيديكم له حالبُ",42,"ب",1,0],["ولا تدَعْني أسال الرُّكبانَ عن","قلبٍ دوٍ وأَستطِبُّ الكتُبا",43,"ب",2,0],["وَلا تَدَع رَوضَةَ الإِغضاءِ عاطِلَةً","لا دَوحَةٌ لِلرِضا فيها وَلا غُصُنُ",44,"ن",1,0],["ولا تدرك الأبصار ذاتك والذي","تراه صنوفاً للصفات إشارات",45,"ت",1,0],["ولا تدّع الرقيَّ إذْ أنت خصمُه","وما كنت الا أرْعَناً همَجيّا",46,"ي",2,0],["ولا تدَّعِ الحزنَ على حال أمّةٍ","أضاعتْ طريقَها فلسْتَ وليّا",46,"ي",2,0],["ولا تَدفِنَنّي بالفلاةِ فإنّني","أخافُ إذا ما مُتُّ أن لا أذوقُها",47,"ق",3,0],["وَلا تَدفَعا بي عنكما غُشْمَ غاشمٍ","فإنِّيَ في أيدي المشيبِ الغواشمِ",48,"م",1,0],["وَلا تُدنِ إلّا مَنْ خبرتَ مغيبَه","ففي النّاس نبعٌ منجبٌ وثُمامُ",49,"م",1,0],["ولا تدّخرْ يوماً لخدمتك الّتي","تَخصّك إلّا الحازمَ المتماسكا",50,"ك",2,0],["وَلا تَدرّعتم بِأَثوابهِ","من بعد أن أصبحتُم حُسّرا",51,"ر",2,0],["ولا تدعني أمد الكف في طلب","ممن سواك على ظن وتخمين",52,"ن",1,0],["وَلا تَدَعهُ عَلى جَمر بمضيعة","فَأَنتَ عاضد مِن ولَّت عَساكره",53,"ر",2,0],["ولا تدع زهرَه غضّاً فهذا مُحَيَّاهُ","سَناهُ تجلَّى تمَّ لي وَطَرِي",54,"ر",2,0],["ولا تَدَعْ لِدَعِيّ","في خصفِ نعلِكَ مخصفْ",55,"ف",1,0],["ولا تَدَعوا قَدَمَاً لِلحِيَاد","ولا للذي خَانَهَا أنْ تَطَاهَا",56,"ا",3,0],["وَلا تَدَعَنَّ المُلكَ وَالأَمرُ مُقبِلٌ","وَلا تَطلُبَنَّهُ حينَ تَهوى مَذاهِبُه",57,"ب",2,0],["وَلاَ تَدَعِ السُّعَالَ يَهُدُّ جِسْمِي","وكَيْفَ وأنْتَ رَحمانٌ رَحِيمُ",58,"م",1,0],["ولا تُدغِمَنَّ إِن جِئتَ بعدَها","بحرفٍ سِواها واقبلِ العِلمَ بالشُكرِ",59,"ر",1,0],["ولا تدري بما قد خبأتهُ","لها الأقدار من بؤس المصير",60,"ر",1,0],["ولا تدعني منك في حيرة","اسبح في لجة بحر ارتياب",61,"ب",1,0],["ولا تدعي قلبا بنا غير ذائب","بنار الهوى من شدة الوجد هائم",62,"م",1,0],["ولا تدعيني أثيرُ الشجونَا","فللوجد عندي حديثٌ يطولْ",63,"ل",1,0],["ولا تدعني وليل الريب اسهرهُ","مقلَّب القلب بين اليأس والاملِ",64,"ل",1,0],["وَلا تَدعا إِن لامَني ثمّ لائمٌ","عَلى سخطِ الواشينِ أَن تَعذُرانِيا",65,"ن",3,0],["ولا تدع ليزيديٍّ شقٍ ولداً","يمشي كوالده الملعون تيّاها",66,"ا",3,0],["وَلا تَدكر الدَهر في مَجلِس","حَديثاً اِذا اِنتَ لَم تَحصه",67,"ص",2,0],["ولا تدعو لطفلٍ لا توالى","أباه ولا لذي كفرٍ أصرا",68,"ر",2,0],["ولا تدع لنا من الاغراض","الا الذي منهن انت راض",69,"ض",1,0],["ولا تدغما ميما إذا كان بعدها","سواها وكن في ذاك معتدل الأمر",70,"ر",1,0],["ولا تَدَعوا أَن تسجدوا عند ذكرهم","إِذا ذُكِروا في مَشْهَدٍ وخَلاءِ",71,"ا",2,0],["ولا تدفعوا حقّاً لحَدٍّ فإِنَّه","عليكم لمولاكم من الرُّقَباءِ",71,"ا",2,0],["ولا تدخلنْ إنْ كنتَ طالبَ حكمةٍ","حقيقةُ ما تبغيه كَفَّةُ مِيزان",72,"ن",1,0],["ولا تداني باطل","تلعب بك الآفات",73,"ت",1,0],["ولا تدم السكون فإن منه","تولد كل خلط فيك خام",74,"م",1,0],["ولا تدع يا صاح نهر الشبعا","كذا البلاطي جدول كالأفعى",75,"ع",2,0],["ولا تدرك العين ماذا يدور","ولا أين تمضي ولا ماهيه",76,"ي",2,0],["ولا تدع وان قدرت حيلة","فهي اجل عسكر مدهدق",77,"ق",1,0],["ولا تدعه كئيباً","يمرُّ مرّ الكرام",78,"م",1,0],["ولا تدع والدا منهم ولا ولدا","فانهم قد عموا جهرا ببغيهم",79,"م",1,0],["ولا تداهن كبير القوم تاجرهم","ولا الرئيس وذا الاعوان والخدم",79,"م",1,0],["وَلا تَدَرَّأتُ بِالدَّرءِ الَّذي قَبلي","عَلى اِبنِ عَمّي وَالمَولى لَهُ غِيَرُ",80,"ر",1,0],["ولا تدفنوني في المدافن حيثما","زحام به يمحى ارتياحي ولذّتي",81,"ي",1,0],["ولا تدر قولي كالرياح مبدداً","فكف جماح الشعر آذان لازمه",82,"م",2,0],["وَلا تَدخُل بِاِمر لَست فيهِ","مِنَ النَجباءِ اِو اِهل الدِرايَه",83,"ا",3,0],["وَلا تَدخُل بِاِمر قَط اِذ لَم","تَكُن مِن اِهلِ ذياكَ الرِهان",84,"ن",1,0],["وَلا تَدَعِ المَسرّةَ وَانتهزها","وَإِن خُتمت مبادي الراح فابدأْ",85,"ا",1,0],["وَلا تَدرأ بمصباح الدياجي","وَلكن بالسرور الهمَّ فادرأْ",85,"ا",1,0],["وَلا تَدَع أُنسَ يَومٍ أَنتَ مالكه","فَما وَراء الَّذي عاينتَ مَستور",86,"ر",1,0],["وَلا تدفعنكم صَولة الدَهر وادرَأوا","بوادرَها بَلْ وَالجموا العَزم وَاسرجوا",87,"ج",3,0],["ولا تداعوا إلى ملكٍ ولا ملكٍ","ولا قتالٍ بحد السيف قتالِ",88,"ل",1,0],["وَلا تَدَع في ساحِها","مِن هامِها وَالخُرَبِ",89,"ب",1,0],["ولا تدعها فإن الدهرَ عادَتَهُ","يخونُ والعيشَ مثلُ الظلِّ لم يقمِ",90,"م",1,0],["ولا تدع للنهج الذي أنت ناهج","سوى من يرى نار الحبيب عيانا",91,"ن",2,0],["ولا تدعْ منهم نَفْساً ولا نَفَساً","فإنهم يأْخذونَ النفْسَ والنفَسا",92,"س",2,0],["وَلا تَدع حَسرَةً في النَفسِ تَعرِفُها","بَل داوِه منكَ بِالفَضلِ الَّذي عُرِفا",93,"ف",2,0],["وَلا تَدَعني حائِراً لَيسَ لي","من آخذٍ نَحوَ الجناب الرَفيع",94,"ع",1,0],["ولا تدعني في كف الزمان سدى","كالقوس عطلها الرامي من الوتر",95,"ر",1,0],["ولا تدعه إلى الإشمات مطرحاً","فإن ذلك عين الذل والصغر",96,"ر",1,0],["وَلا تَدري بِأَنَّ كُلَيبَ أَضحى","قَتيلاً عِندَ جَسّاسِ الغَدُورِ",97,"ر",1,0],["ولا تدفع الموتَ الزؤام تميمةٌ","إذا نشبتْ للمرء منه أظافرُ",98,"ر",1,0],["ولا تدفنني في البقيع فإنني","أريد إلى يوم الحساب التزامها",99,"م",3,0],["ولا تدفع الضيمَ عنها ولا","تكفُّ يدَ الظلم أو تمنع",100,"ع",1,0],["ولا تدعوا أبناءكم في جهالة","فتركهم في الجهل ظلم به ظلم",101,"م",1,0],["ولا تدعوا حسن اتحاد قلوبكم","بعارض أغراض لكل مشاغب",102,"ب",1,0],["ولا تدع اكتسابك من حلال","فعقبى أمره عيش رغيد",103,"د",1,0],["ولا تدري بكم ،، مره ،، ابين لك معاناتي","واقلك ،، قلبي ايحبك / متيم فيك سميته",104,"ت",2,0],["ولا تدع شكر من أولاك أنعمه","فالشُّكر فرضٌ به يزداد فيض ندى",105,"د",2,0],["ولاتديّن من بنوك ومن مصارف لو تمور","ابتدي ابجمع الدراهم كل شيء له معاد",106,"د",1,0],["ولا تدخل مجالات","بسوء الظن في الحملة",107,"ل",2,0],["ولا تَدعِ الأيام تهدمُ ودنا","وأشرب هماً بعد همي وحسرتي",108,"ت",2,0],["ولا تدع الحُساد تَنشر قولها","لياليكِ يا ليلى من الليلِ أليلُ",109,"ل",1,0],["ولا تدور عند ربك للنعيم","كان مااصليت واديت الزكاهہ",110,"ا",2,0],["ولا تدبرت في أخلاقها فبدا","لناظري غير خُلْقٍ زانه حور",111,"ر",1,0],["ولا تدعها على لذات مطعمها","أن الطعام يقوي شهوة النهم",112,"م",1,0],["ولا تدفنوني في الفلاة فانني","أخاف إذا ما مت أن لا أذوقها",113,"ه",2,0],["ولا تداهم إذا ما قلت مسألةً","أضررت بالدين إن داهمت إضرار",114,"ر",1,0],["ولا تدع إلا الله لا شيء غيره","فداع لغير الله غاوٍ ومعتد",115,"د",1,0],["ولا تدري اذا ما الموت يدنو","الى أيِّ العوالم ما تُردُّ",116,"د",1,0],["ولا تدن ممن يختلى في تكلم","إلى حين يفضي فادن منه بإيذان",117,"ن",1,0],["ولا تدعوا صداقتكم لمن لم","يصنها في فؤاد لم يقتم",118,"م",1,0],["ولا تدعِ العمْرَ يمْضي هباءً","فذاك لعمْركَ شرُّ البلاء",119,"ا",2,0],["وَ لا تدْخلْ بُيوتَ البُخْل ضَيْفًا","ولا تَسْمَعْ لعُشَّاق المَلام",120,"م",1,0],["ولا تدمنن العب في أكؤس المنى","لقد تحمق العقل الحصيف خمورها",121,"ر",3,0],["ولا تَدَّعي والصِّدْقُ قَوْلُكَ إنَّني","أَحَلْتُ وِدَادِي أوقَلَبْتُ ثَنَائِيا",122,"ي",2,0],["وَلا تَدْري بِما تُخْفي اللَّيالي","وَأَعْجَزُ مِنْكَ عَرّافٌ كَذوبُ",123,"ب",1,0]]}