{"poems":[[57,"هم كتموني سرهم حين أزمعوا","https://www.aldiwan.net/poem26344.html","الطويل"],[56,"هم كتبوا الصك الذي قد علمته","https://www.aldiwan.net/poem27566.html","الطويل"],[90,"خاض الدجى وظلام الليل مختلط","https://www.aldiwan.net/poem44831.html","البسيط"],[40,"عفت بعدنا أجراع بكر فتولب","https://www.aldiwan.net/poem7688.html","الطويل"],[45,"إيها أتاك الحمام فاخترمك","https://www.aldiwan.net/poem10623.html","المنسرح"],[30,"لست بلائم أبدا عقيلا","https://www.aldiwan.net/poem4979.html","الوافر"],[107,"زلت بأفهام الثقات قضية","https://www.aldiwan.net/poem43110.html","الكامل"],[111,"تهد العمر رائعة المنون","https://www.poetsgate.com/ViewPoem.aspx?id=523",""],[128,"قالوا أناب وما أناب","https://www.aldiwan.net/poem23721.html","مجزوء الكامل"],[190,"وإخوان سوء لا يسر إخاؤهم","https://www.aldiwan.net/poem43851.html","الطويل"],[244,"بمحمد صلوا عليه وسلموا","https://www.aldiwan.net/poem23835.html","الكامل"],[287,"تقول صحابي والمطي بنا تخدي","https://www.aldiwan.net/poem32793.html","الطويل"],[303,"أدال الله (جلق) من عداها","https://www.aldiwan.net/poem36817.html","عموديه"],[333,"من ترانيم وحيك القدسي","https://www.aldiwan.net/poem55045.html","الخفيف"],[422,"هاج القرام وهيجا بلبالي","https://www.aldiwan.net/poem54163.html","الكامل"],[466,"سأبعثها بين البيوت شوازيا","https://www.aldiwan.net/poem15127.html","الطويل"],[482,"هو الوجد ما بالي أنؤ بحمله","https://www.aldiwan.net/poem15255.html","الطويل"],[534,"هم أخذوا عني العلوم بذلة","https://www.aldiwan.net/poem37500.html","الطويل"],[543,"مقدم القائد الأعز نظيرا","https://www.aldiwan.net/poem48180.html","عموديه"],[556,"عذيري من القوم الذين أراهم","https://www.aldiwan.net/poem47192.html","الطويل"],[563,"اغسلوا بي نجاسة الوسواس","https://www.aldiwan.net/poem34440.html","الخفيف"],[567,"إن كنت بالله في دنياك تعتصم","https://www.aldiwan.net/poem52850.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138262",""],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107232","الوافر"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126672","الكامل"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/67015","الكامل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126158","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46564","الرجز"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122006","الكامل"],[2089,"","https://poetry.dctabudhabi.ae/diwan/poem/28822","المتقارب"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87322","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93868","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94005","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93893","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200019","الرجز"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100758","الكامل"],[3307,"","https://poetry.dctabudhabi.ae/diwan/poem/145541","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62847","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62803","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138691",""],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45788","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91831","الطويل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128914","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114374","المتقارب"],[3896,"","https://poetry.dctabudhabi.ae/diwan/poem/45548","الوافر"],[3968,"","https://poetry.dctabudhabi.ae/diwan/poem/105266","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54498","الكامل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81916","الطويل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28642","المنسرح"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139522",""],[4767,"قوم لوط","https://www.poetsgate.com/ViewPoem.aspx?id=212902",""],[4799,"صوت الشوارع","https://www.poetsgate.com/ViewPoem.aspx?id=12260",""],[4852,"هِمْ .. كيف شئتَ","https://www.poetsgate.com/ViewPoem.aspx?id=215039",""],[4929,"الحق ورايته (اكناف بيت المقدس)","https://www.poetsgate.com/ViewPoem.aspx?id=208723",""],[585,"مغلغلة منشورةٌ في المحافل","https://www.poetsgate.com/ViewPoem.aspx?id=161901",""],[5090,"حيي الرجال","https://www.poetsgate.com/ViewPoem.aspx?id=184338",""],[5211,"بيْضاءُ يا أخْتَ الجِنانِ","https://www.poetsgate.com/ViewPoem.aspx?id=176157",""],[5277,"نوافلُ الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=200533",""],[5327,"سَجَنُوك ! إلى سَجينِ السَّكَر","https://www.poetsgate.com/ViewPoem.aspx?id=156015",""],[5397,"يا سائق النوق عن الأربع","https://www.poetsgate.com/ViewPoem.aspx?id=157919",""],[333,"نشيد الصفاء","https://www.poetsgate.com/ViewPoem.aspx?id=101256",""],[5409,"علوكم حيث تعلو منكم الهمم","https://www.poetsgate.com/ViewPoem.aspx?id=155313",""],[5409,"أيار شهرك بالكوارث مفعم","https://www.poetsgate.com/ViewPoem.aspx?id=155316",""],[5409,"ماذا حدا بك فاعتزمت رحيلا","https://www.poetsgate.com/ViewPoem.aspx?id=155477",""],[5409,"لم تنجب الأيام إلا","https://www.poetsgate.com/ViewPoem.aspx?id=155495",""],[5428,"أراني كُلّما قطعوا المزارا","https://www.poetsgate.com/ViewPoem.aspx?id=124932",""],[5431,"الحب دربٌ آمنٌ","https://www.poetsgate.com/ViewPoem.aspx?id=201942",""],[5443,"ربَّاكَ ربّكَ جلَّ منْ ربَّاكَا","https://www.poetsgate.com/ViewPoem.aspx?id=185152",""],[5458,"جولة باطل","https://www.poetsgate.com/ViewPoem.aspx?id=113370",""],[5638,"يا قدس صبرًا","https://www.poetsgate.com/ViewPoem.aspx?id=198037",""],[2765,"برح الخفا ما الحق فيه خفاء","https://www.poetsgate.com/ViewPoem.aspx?id=136825",""],[5956,"الكافورُ الجديد","https://www.poetsgate.com/ViewPoem.aspx?id=192937",""],[5956,"يا حُبَّنا الأعلى","https://www.poetsgate.com/ViewPoem.aspx?id=194669",""],[6152,"بلى صدقت ما قالوه عني","https://www.poetsgate.com/ViewPoem.aspx?id=213176",""],[6200,"غَابَةُ الأَطْفالِ وَ الحِجَارَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81373&r=&rc=15",""],[6277,"إلى \" برفين \"","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64449&r=&rc=12",""],[6332,"خجل الصّحوُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65172&r=&rc=1",""],[6344,"غُرباء يُعاندون الخطوات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87965&r=&rc=5",""]],"verses":[["هُمُ كَتَموني سِرَّهُم حينَ أَزمَعوا","وَقالوا اِتَّعِدنا لِلرَواحِ وَبَكَّروا",0,"ر",3,1],["هُمُ كَتَبوا الصَكَّ الَّذي قَد عَلِمتَهُ","عَلَيكَ وَسَنّوا فَوقَ هامَتِكَ الفَقرا",1,"ر",2,1],["هم كالضفادع فاسمعهم إذا رَطَنوا","فما هنالك إلا اللغوُ واللَغَط",2,"ط",1,0],["هُمُ كاهِلُ الدَهرِ الَّذي يُتَّقى بِهِ","وَمَنكِبُهُ المَرجُوُّ أَكرَمُ مَنكِبِ",3,"ب",1,0],["هَمُّكَ في أمرَدٍ تُقَلِّب في","عينِ دواةٍ لصُلبهِ قَلَمَكْ",4,"ك",1,0],["هُمُ كَرِهوا القِصاصَ مِنَ المَوالي","وَهُم قَصّوا الصَريحَ مِنَ الصَريحِ",5,"ح",1,0],["هُم كَالكَواكِبِ في سَماءِ حَياتِها","مِنها الظَلامُ لَها وَمِنها النورُ",6,"ر",1,0],["هم كانوا لنا بلدا أمينا","فواحربا على البلد الأمين",7,"ن",1,0],["هم كانوا السما سقيا ورعيا","فأقلعت السماء عن القطين",7,"ن",1,0],["هم كانوا رياضا سابغات","بما ترجوه ناضرة الغصون",7,"ن",1,0],["هم كالكلاب فإن سمعت نباحهم","فتذرعي بالصبر يا برفين",8,"ن",1,0],["هم كتماثيل الهياكل خيرها","فقيد ويأبى فقدها لحظ ناظري",9,"ر",2,0],["هم كذبوه وعذبوا أتباعه","فاستعذبوا فيه العذاب وصمموا",10,"م",3,0],["هُمُ كَبُدورِ التِمِّ في السِلمِ بَهجَةً","وَهُم في مَجالِ الحَربِ أَدهى مِنَ الأُسدِ",11,"د",1,0],["هُمُ كتبوا صحائفَ خالداتٍ","أرى صدرَ الزمانِ لقدْ وَعاها",12,"ا",3,0],["هم كما كان والدوهم وأربَوا","وهم القاسمون في كل غي",13,"ي",1,0],["هم كالبحور الزاخرات وإنَّني","لم أنتفع من وردهم ببلال",14,"ل",1,0],["هم كدَّروا صفو الوداد وزعزعوا","نسيم التَّقالي وهو بالوصل راكدُ",15,"د",1,0],["همُ كلَّفوني جوبَ كلِّ تنوفةٍ","تَشُقُّ على قُبِّ الفريقِ وبُزلِهِ",16,"ل",2,0],["هُمُ كَتَمُوا عَنِّي الْمَحاسِنَ كُلَّها","وهم زَخْرَفُوا الأَقْوالَ في كُلِّ سُبَّةِ",17,"ه",1,0],["همُ كالشمسِ كلُّ طَرفٍ رآها ار","تَدَّمِن نورِها كَليلاً حَسيرا",18,"ر",2,0],["هُمُ كَلَموا جسمي ولم يكُ عندهمْ","بأنّ كُلومي ليس يا قومُ من جسمي",19,"م",2,0],["هم كُسالى وإن دعتهم دواعي","حظ نفس كانوا من الأكياس",20,"س",1,0],["هم كالطَّعامِ الذي لا بُدَّ منه لنا","بهِ نَعيشُ ومنهُ يَحدُثُ السَّقَمُ",21,"م",1,0],["هم كالجنود تطوعوا عند الوغى","والبأس في متطوعي الأجناد",22,"د",1,0],["هم كالأسود بسالة إن هوجموا","فرسوا الذي يسطو على الآساد",22,"د",1,0],["هم كالجبال رسوا فلم يتزعزغوا","وكذا تكون رواسخ الأطواد",22,"د",1,0],["هُمُ كانُوا نجوماً في الدَياجِي","وَهُم كانُوا رُجُوماً لِلأعادي",23,"د",2,0],["هُم كالكواكبِ حوله وجبينهُ","يَجلو بمعطلهِ دجى الظلماءِ",24,"ا",2,0],["هُمْ كالقَرِيْضِ وَكَسْرُهُ من وَزْنِهِ","يَبْدو من التَّحْرِيْكِ والإِسْكانِ",25,"ن",1,0],["هم كعبة القصاد هم كنز العطا","هم سادة السادات ما فيهم خفا",26,"ف",2,0],["همك ما عَناكا","حَظك ما كَفاكا",27,"ك",2,1],["هُمُ كَالنُّجُومِ بَدَتْ لَنَا وَمُحَمَّدٌ","شَمْسٌ بِأُفْقِ عُلاَهُمُ الْمُتَبَرِّجِ",28,"ج",1,0],["هُمُ كَشَفوا عَيبَةَ العائِبي","نَ مِنَ العارِ أَوجُهُهُمْ كَالحُمَمْ",29,"م",1,0],["هُم كِلمتانِ سَبعَةُ حُروفِ","تَعكُسُ المذكورَ يا ظريفي",30,"ي",1,0],["هم كرام الورى ولا سيما من","هو فيهم كالورد في الروضات",31,"ت",1,0],["هم كبر واذنب الشجى وذنوبها","قد صفرت وهي اسمها زنوبه",32,"ب",2,0],["هم كرام من كرام ذالهم","كرم الأخلاق والأصلين",33,"ن",1,0],["هم كالخيال ما لهم قرارُ","لهم وان لم يرحلوا اسفارُ",34,"ر",1,0],["هم كالممثل في الثياب فسافل","في نفسه ومملك في الظاهر",35,"ر",1,0],["هم كسروا حد الملوك وقلما","يفل الحصى إلا بصم الجنادل",36,"ل",1,0],["هم كَفَروا نَوالكَ بَعْدَ عدمٍ","ووجه الأرض ما كَفَرَ الغَمامَا",37,"م",2,0],["هم كرِهوا الأقرانَ حينَ تزعزعَتْ","صدورُ القَنا والتفتِ الفئتانِ",38,"ن",1,0],["هم كنزه المخفي والسر","المصون عن الفكر",39,"ر",1,0],["هُم كَالعَبيد وَأَنتُم ساداتهم","بَل سادة الأَشراف وَالأَطراف",40,"ف",1,0],["همُ كدّروا مِن وِرد ودّي صافياً","وَقَد حوّلوا ظلّاً من الأُنس وارفا",41,"ف",2,0],["هم كل منهم ليحضى برفع الحجر","الاسود الرفيع السامي",42,"م",2,0],["همُ كالبنينَ","لهُ في اغتمام",43,"م",1,0],["هُمُ كانوا الحُماةَ وكان فيهم","ذَوو الأفضال والأيدي الطوالِ",44,"ل",1,0],["همّ كوا قلبي غداة رحيلهم","على إثرهم يسري من الوجد مغرما",45,"م",2,0],["هم كالصَّحابةِ يومَ بدرٍ حاولوا","نصرَ النبيِّ ونُبتُ عن حَسّانِ",46,"ن",1,0],["هم ك ه يا عين ص وما أتى","من الآي في ميلاد عيسى بن مريم",47,"م",1,0],["هَمُّكَ في مَرتَعٍ وَمُغتَبِقٍ","كَما تَعيشُ الحَميرُ وَالبَقَرُ",48,"ر",1,0],["هم كرامٌ كم لعلياهم أتت","آيُ فضل دُوِّنَت الكتب",49,"ب",1,0],["همُّكم أنْ تسرقوا الثرواتِ مِمَّن","تحتهم قد فاض بالليل الثراء",50,"ا",2,0],["همّك بوسط ألعابهم تدفنينه","وباقي أثرهم في ملامحك ما زال",51,"ل",1,0],["هِمْ، كيف شئتَ، وزِد وزِد لن أشتكي","يا كلَّ أرضٍ حلَّ فيكِ .. تمهَّدي",52,"د",2,0],["هم كثرةٌ أغرتِ الأعداءُ قِلَّتُهم","ليقضيَ اللهُ أمراً عنده حُسِمَا",53,"م",2,0],["هم كسروا كسرى الملوك وقصرت","يدي قيصرٍ منهم جموع الجحافل",54,"ل",1,0],["هم كالأسودِ شجاعةً وصلابةً","لمْ يرهبوا يومَ النزالِ منيه",55,"ي",2,0],["هُمْ كفّنوك وأنتِ في أحْضانِي.. !","قَدْ أشْعَلُوا بِغَبَاوَةٍ وِجْدانِي..!",56,"ن",2,1],["هم كالطيوفِ كرىً تعاودني","يا ليتهمْ بطيوفِهمْ طلُّوا",57,"ل",3,0],["هُم كالذِّئابِ يُتاجِرونَ بغَدرِهِم","بِئسَتْ تِجارَتُهُم وخَابَ مَنْ اشتَرَى",58,"ر",2,0],["هم كسروا فتكا أكف الردى","فلم تجد فيهن من اصبع",59,"ع",1,0],["هم كما كان والدوهم وأَرْبَوْا وهم القاسمون في كلِّ غيّ","جاهليون قدّسوا جاهليّين سعوا نحو غاية (اللا شيِّ)",60,"ي",1,0],["هم كالخفافيش في الظلماء طائرةً","حتى إذا ما انجلى الليل البهيم عموا",61,"م",3,0],["هم كلما رأوا الجرائم سيطرت","قالوا لجانيهن أنت الضيغم",62,"م",1,0],["هم كلما عجموك زدت صلابة","تأبى على حكم القوي نزولا",63,"ل",2,0],["هم كالحديد وغيرهم","كالعود لا يعتد نصلا",64,"ل",2,0],["همُ كانوا أساطين البرايا","سلاطينا لأمتهم خيارا",65,"ر",2,0],["هم كفّنوه بغدرهم","باعوا المروءة للطمع",66,"ع",1,0],["هم كالخشاش على الثرى ومقامكم","مثل السماء فمن يطول سماك",67,"ك",1,0],["هم كاذبون بكل قول أعلنوا","قتلوا العدالة عامداً متعمدا",68,"د",2,0],["هُمْ كَالصُّقُورِ فَلَمْ تُخْطِئْ فَرَائِسَهَا","هُمْ كَالأُسُودِ فَلَمْ تَرْهَبْ مِنَ الأُمَمِ",69,"م",1,0],["هم كالنجوم وفي الجدوى ندى","بل الصدا ما بعدهم اظماء",70,"ا",2,0],["هُمْ كَرَّسوا وتعاونوا ضدّي، وما","عاوَنْتَني أبداً أيا رِعْديدُ",71,"د",1,0],["هم كلما آذَوا عظيماً ينبري","إبليس للجَّانِين بالتبويسِ",72,"س",1,0],["همُ كذبوا ولكن كيف أضحى"