""],[5481,"وَكنت صَحِيحا والشباب منادمي","https://www.poetsgate.com/ViewPoem.aspx?id=187533",""],[5701,"يقول لها وفي دمه لهيب","https://www.poetsgate.com/ViewPoem.aspx?id=164656",""],[5717,"هذا الكتاب معجز مشاهد","https://www.poetsgate.com/ViewPoem.aspx?id=170606",""],[5720,"لَكَ اللَّهُمَّ ..","https://www.poetsgate.com/ViewPoem.aspx?id=199022",""],[5742,"الحمراء تأريخ ونهضة","https://www.poetsgate.com/ViewPoem.aspx?id=206897",""],[5771,"أنا والحكايات","https://www.poetsgate.com/ViewPoem.aspx?id=191414",""],[5817,"خليل الروح","https://www.poetsgate.com/ViewPoem.aspx?id=191146",""],[5937,"حديثٌ مع الله","https://www.poetsgate.com/ViewPoem.aspx?id=211814",""],[6102,"سارة","https://www.poetsgate.com/ViewPoem.aspx?id=184409",""],[6152,"مناجاة رمضانية","https://www.poetsgate.com/ViewPoem.aspx?id=204731",""],[6152,"هنئيا لأهل البيت","https://www.poetsgate.com/ViewPoem.aspx?id=213147",""],[240,"ألا أبلِغْ عمادَ الدينِ عنّي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26486&r=&rc=11",""],[2638,"دنيا الأذكياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87840&r=&rc=4",""]],"verses":[["وزِدْتَ بأنّ الورْدَ عندَكَ إنْ بَدا","أنيقَ الجَنى والآسَ في وَجْنَةٍ سَوا",0,"و",2,0],["وَزِدتَهُم مِن كَلامِ البُحتُري قِطَعاً","مِثلَ الرِياضِ كَسَتها كَفُّ نَيسانِ",1,"ن",1,0],["وزِدت أضعاف أضعاف ضَريبته","حتى يَبيعوه قيراطاً ببدْرات",2,"ت",1,0],["وزدنا من الفعل الجميل فلم تزلْ","تَكَرَّمُ حتى يعشق الكَرَمَ الوغْدُ",3,"د",1,0],["وزدت بها شاعراً فطنةً","وأنبغْتَ من لم يكن شاعرا",4,"ر",2,0],["وزد في ارتفاعك فوق الورى","بأن تتواضع للرافع",5,"ع",1,0],["وزدادت قوةُ الرأي","وبادتْ قوةُ الجُرمِ",6,"م",1,0],["وَزِدنِيَ مِن ذاكَ الحَديثِ لَعَلَّني","أُصَدِّقُ أَمراً كُنتُ فيهِ مُكَذِّبا",7,"ب",2,0],["وَزِدتُها الدِفءَ فَقَر","رَبتُ لَها مِجمَرَتي",8,"ي",1,0],["وَزِدِ الهِلالَ مِنَ الكَرا","مَةِ وَالصَليبَ مِنَ الرِعايَه",9,"ا",3,0],["وَزِدتَني رَغبَةً في عَقدِ وُدِّكَ إِذ","شَفَعتَ ذاكَ النَدى بِالفَهمِ وَالفِطَنِ",10,"ن",1,0],["وَزِدتَ رَفيعَ مَنصِبِها سَداداً","وَكانَ سِواكَ مِن عَوزٍ سِدادا",11,"د",2,0],["وَزِدْتَ فقلت اضربوا الكافرين","وَعلّمتهم صنعةَ المنجنيقْ",12,"ق",1,0],["وَزِدني عَلى طَوقي مِن الحُلِيِّ زينَةً","تُصيبُ إِذا أَتبَعتُ طَوقي خِضابِيا",13,"ا",1,0],["وَزِدني لِأَولاديَ جَمالاً وَزينَةً","وَيَهوَينَ زَيني زينَةً أَن يَرانِيا",13,"ا",1,0],["وَزِدْتَنَا يَا ذَكَاءُ مَعْنًى","فِي زِينَةِ الكَوَاكِبِ المُلاَلِي",14,"ل",2,0],["وزِدْه ما استطعتَ لك انصياعا","وعما يُغضِبُ الوطَنَ امتِناعا",15,"ع",2,0],["وزِده في الخُطوب بك اعتِزازاً","وحَوْلَ شعارِك الألِقِ اجتماعا",15,"ع",2,0],["وزِدْنَ المسك من ضغْطٍ فضاعا","شديدٌ صُلَّبٌ في الحق حتى",16,"ا",1,0],["وزد بأكمل ما الصلاة مستلماً","على الذي مُنْزَلٌ عليه في النّزلِ",17,"ل",1,0],["وزده إلهي صلاحٍ ورحمة","وفك به الأسرى وفرّج به الهمّا",18,"م",2,0],["وزده حسن يقين وارضه كرما","فيما تولاه من صنع وما وزرا",19,"ر",2,0],["وَزِدتَ فِي الزَّادِ فارتَحَلنَا","عَن شُكرِنَا الرَّاحِلِ المُقِيمِ",20,"م",1,0],["وَزدتُ من مواهب البشيرِ","أَرجو بهِ الزلفى من الغفورِ",21,"ر",1,0],["وزدت فتونَ الجيدِ حتى تركتني","أموتُ على نوحِ الحمامِ المطوَّقِ",22,"ق",1,0],["وزِدْ لعطاء الله ذُلَّ تواضع","فإنك والأقوامَ طرّاً عبيده",23,"د",2,0],["وزدت في كل صبح عزةً وسناً","ولا خلا من رجال الحيّ ناديكي",24,"ك",2,0],["وَزِدهُ مِنكَ إِكراماً وَقُرباً","وَأورِدهُ خَلائِقَكَ العِذابا",25,"ب",2,0],["وزد علاً نحن واشعارنا","نعيش والتاريخ في ظله",26,"ه",1,0],["وَزد قائل الابيات فضلا وَرَحمَة","وأكرمه في دنياه واشفع له غَدا",27,"د",2,0],["وزدتُ على دهري وسنّيَ لم تكن","تَزيدُ عَلى العشرينَ إلّا ثمانيا",28,"ي",2,0],["وَزِد شمائِلَها حسناً بتطريةٍ","وَعَن شَمائلها أكشف غطا الصدفِ",29,"ف",1,0],["وَزدتَ اِعتلاءً كَما يشتهي","مُستنجزُ العُقباني وإقليدسا",30,"س",2,0],["وزدني من الإدناء ما قد وعدتني","فوعدك مضمون إلى حجج عشر",31,"ر",1,0],["وَزِدني حَديثاً عَن قَديم عُهودهم","وَكَرِّر رَعاك اللَه تِذكار مَن رَعى",32,"ع",2,0],["وَزِد إلهيَ والي الأَمر راشده","رُشداً بِهِ يَتَباهى المَجد وَالرتبُ",33,"ب",1,0],["وزِدْنا يَزِدْك اللهُ يا أكرمَ الورَى","فمَن زاد مُلكاً كان نُعماهُ أَزَيدا",34,"د",2,0],["وزِدْ في رياض المُلْكِ عزّاً ورِدْ بها","من العِزّ عذْباً شُربُه غيرُ ناضب",35,"ب",1,0],["وَزِدتَ شُهرَةَ حُسنٍ غَيرَ خافِيَةٍ","فَكانَ سُقمُكَ ناراً قَد عَلا عَلَما",36,"م",2,0],["وزدنا هُدىً يهدي جوارحنا إلى","مرادك في سر الأمور وفي الجهر",37,"ر",1,0],["وزِدْ فَعَالَكَ قَدْراً","إِذ زادَكَ اللهُ قَدْرَا",38,"ر",2,0],["وزِدْ عَلَى الباءِ رَفْعاً","يَرْفَعْ لَكَ اللهُ ذِكْرَا",38,"ر",2,0],["وزدتني فوق وضح الجرح هاشمة","وواجب منك بالاسعاف تنسوني",39,"ن",2,0],["وزدت عشرا ولست منفصلا","هل أنت يا ثلج غير منطلق",40,"ق",1,0],["وزدْ شرفاً أنت يا تاجَها","ولا افترق التاجُ والمفرِقُ",41,"ق",1,0],["وزدتُ يقيناً فيك أنّك واحدٌ","إذا اخترتَ كنتَ العارفَ المتأنِّقا",42,"ق",2,0],["وزِدنَ على حساب مُنايَ لكن","وِشَاحٌ لم يكُنْ لي في حِساب",43,"ب",1,0],["وزدتُ على ما أدركوهُ فصاحةً","وإن يزد الرحمانُ في العمر أزدد",44,"د",1,0],["وَزِدتُكَ أَضعافاً وَغادَرتُ في الحَشا","عِظامَ البَلايا بادِياتٍ وَرُجَّعا",45,"ع",2,0],["وزدني من سلافتكم كؤوسا","ليحن أن يقال شربت سحرا",46,"ر",2,0],["وزدنا فيه غيضاحا","فزادوا فيه إبهاما",47,"م",2,0],["وزدْتَ فأهديت التواضع معناهُ","وجدْتَ فعلّمت التنافس مغزاهُ",48,"ه",1,0],["وزِدْتَ في المُلك إجلالاً ومقدرةً","حتّى جلَلْتَ عن التحديد والقدرِ",49,"ر",1,0],["وزدت من العيال وذاك أنّي","كتبت على لقائك من أعولُ",50,"ل",1,0],["وزدتَ وقد طَرَّحْتَهمْ حِزَقاً بها","بطرْقِ المنايا في عِدادِ إكامِها",51,"م",3,0],["وزِدْتَ مِطالاً عن لقاء مُصَحَّحٍ","وأوْسَعَنا منك اللّقاءُ المُزَوّقُ",52,"ق",1,0],["وزد في الورى فخراً ومجداً وسؤدداً","ورفعة قدرٍ دائماً وتعاليا",53,"ي",2,0],["وزدت على البنين وفير خير","مدى الايام من رب البرية",54,"ي",2,0],["وَزِدتَ عَلى الكَمالِ وَما عَلِمنا","بِمنزِلةٍ تَزيدُ عَلى الكَمالِ",55,"ل",1,0],["وَزد يوم عيد الملك في كُل حجة","سَناء بِهِ يَنحَط قَدر حَسود",56,"د",1,0],["وَزد بهجة ما قلت فيهك مؤرّخاً","تشرّف بِعَبد اللَه يا ملك أَمجاد",57,"د",1,0],["وَزد جاهاً وَتَبجيلاً وَفَخراً","عَلى طُول المَدى ما اِزددتَ فَضلا",58,"ل",2,0],["وَزد رفعة ما قال مَجدي مؤرخاً","قُدوم رِياض للبَهاء هُوَ البَها",59,"ه",2,0],["وَزد سؤدداً ما قالَ مَجدي مؤرخاً","لرفعة إِبراهيم يُمنٌ وَإقبال",60,"ل",1,0],["وَزِدناه مِن زجر وَرَدع وَلَعنة","إِذا هُوَ لَم يَعرف حُقوق الخَلائق",61,"ق",1,0],["وزده علواً في الشريعة إنه","لأحنى على أبنائها من أب بر",62,"ر",1,0],["وَزِدتُ عَلى النَّوى فيهِ غَراماً","وَزادَ عَلى الوِصالِ بيَ الغَرامُ",63,"م",1,0],["وَزِدْ ذاكَ ما قد تغنّى امْحَمامُ","ومن طيبةَ فاح نشرُ امْخُزامى",64,"م",2,0],["وزد جفاءً لا تكن ناسياً","فهو من المستطرف النادر",65,"ر",1,0],["وَزِدتُ اِتِّساعاً في المَكارِمِ وَالعُلا","لِيُصبِحَ جاهي عِندَهُنَّ عَريضا",66,"ض",2,0],["وزد في شكل ما قيدتَ منه","والا ند عن عقلِ الصوابِ",67,"ب",1,0],["وَزِدْتِ بِالتَأْفِيكِ حار الأَحْيَرِ","حاراً وَخَبْطاً فِي الضَلال الأَدْجَرِ",68,"ر",1,0],["وزِدْني صُدوداً أَزِدْ صَبْوَةً","وفي حالةِ السُّخْطِ لا في الرِّضَا",69,"ض",2,0],["وزدنا منك سترا واعف عنا","وعرفنا وظفر بالصغال",70,"ل",1,0],["وزدني فان الفضل شيمة فضلكم","لكي سوء حظي بعد أن جاء ينثني",71,"ن",2,0],["وزد معا واسم وفعل حرف","كبل كمن كفى وهذا ظرف",72,"ف",1,0],["وزد محركا على الخفيف في","تركيب مفروق لدا البنا يفي",73,"ي",1,0],["وزده للتذييل بعد الوتد","جمعا وفي مستفلعن به اقتدي",73,"ي",1,0],["وزد لترفيل على جمع الوتد","من متفاعلن خفيفا قد عهد",73,"د",1,0],["وزدهما وتر بسيط رابع","واركب بوتر في السريع الرابع",73,"ع",1,0],["وزد على الستة عن سعيد","حرفين في قافية القصيد",73,"د",1,0],["وزد لَهُ رأسا كسُبعَي ما نُصِب","يصيرُ باءً مع مُضاهيه انتُخِب",74,"ب",1,0],["وزده شكلا ثالثا مجموعا","لما ترى في ذيله موضوعا",74,"ع",2,0],["وزد له شكلا هنا قد أدغما","كمُدغَم النون الذي تقدما",74,"م",2,0],["وزد لهذا الباب في وضع الرا","مقورا مخطوفةً وبترا",74,"ر",2,0],["وزدني خضوعاً فيك يا متكبراً","إذا حط قدري الناس أعلاه فاعتلى",75,"ل",2,0],["وزدْتُ على أَهل الهوى بغرائبٍ","لقيت بها في الحب فوقَ الّذي لَقوا",76,"ق",3,0],["وَزِدْنِي بِأَصْواتِ الحُدَاةِ صَبَابَةً","وَدَعْ عَنْكَ لحني كُلَّ مَثْنَى وَمَثْلَثِ",77,"ث",1,0],["وَزِد عَلَيهِ ثَباتاً لا يُفارِقُهُ","جَزمٌ بِحَزمٍ يُباري سَهمَ صَيّودِ",78,"د",1,0],["وزدت وقد رآك الطرف حسناً","كزيد الخيل ممدوح الرسول",79,"ل",1,0],["وزد شرفي يا أشرف الناس بالولا","ودم لذوي الأعياد قاطبةً مولى",80,"ل",2,0],["وَزِدتُ بِحُسنِها الفَتّانِ وَجدا","وَزادَت في الهَوى عَبَثاً وَصَدّا",81,"د",2,0],["وزدنا امة الاسلام عزاء","ولا تزد العدى الاتبارا",82,"ر",2,0],["وَزِدتَّهُ رِفعَةً لَمّا جَعَلتَ لَهُ","ذِكراً كَذِكرِكَ لا يَخلُو مِنَ الخُطَبِ",83,"ب",1,0],["وَزد فيهِ مِن مَحمودة العَقل دانِقاً","لتَحِدر مِن كيموس نوكك ما بقى",84,"ق",2,0],["وزدتني رغبة في الموت حين قضى","ريب الزمان ببعدي عن احباي",85,"ا",2,0],["وزد وقُل ذا فضلُنا","ألا يا أحمد",86,"د",1,0],["وَزِدِ المَخلاةَ مِنهُ عَنجَداً","وَشَعيراً ثُمَّ أَقفيهِ اللَبَن",87,"ن",1,0],["وزدت الدين والدنيا سروراً","بانشاء المساجد والزوايا",88,"ا",3,0],["وزد على هذا فلا عاذلا","ترى به يوماً ولا حاسدا",89,"د",2,0],["وزد في الزاد معتدا لضيف","ولست سواه اعني في مقالي",90,"ل",2,0],["وزدتني الداء فوق الداء","عياء اعيا على لقمان",91,"ن",1,0],["وزدت عليه اليوم فرقا يشقه","عمود حديد ظل يرديك للثرى",92,"ر",2,0],["وزدتَ على بهجةٍ بهجةً","وفزتَ من الحسن بالأزيد",93,"د",1,0],["وَزدتَ بِالردف عَناءً فَبي","مِنكَ وَمِنهُ ضعف هذا العَنا",94,"ن",2,0],["وَزِدهنَّ بالتجريبِ مَهما آستَطعتَهُ","مَخَافَتُنَا أن لا يُساعِدَنا عُمري",95,"ر",2,0],["وَزِدهُ يَسيراً في الحمارَينِ مِثلَهَا","ثَمانِيَةَ آزوَامٍ تَسيرُ بِصُحبَتِي",96,"ي",1,0],["وَزِدهُ مِنَ الأزوامِ عشراً ترى بها","لِسَيبَانَ أوتَاداً أوِ الجوُّ غَبرَةِ",96,"ه",1,0],["وَزِدهُمُ تَجرِبَةً لا تَنتَخَا","بِهِم وَحقِّقهُنَّ يَا مُؤرِّخَا",97,"خ",2,0],["وزد الشوق بلقياك فمن","اكثر الترداد اضناه الملل",98,"ل",1,0],["وزد غنماً في بكرة إن تفاضلت","وإلاّ فدعها وازدد الشاة واعتد",99,"د",1,0],["وزدت قلبي سقاماً","وزدت جسمي نحولا",100,"ل",2,0],["وزدت عليها غربة الشعر كلها","بمخطوط ديوانين ضمّا الى عشر",101,"ر",1,0],["وَزدت عَلى الأَقران قَدراً وَسُؤدداً","فَغَيرك مَرجوح وَأَنتَ رَجيح",102,"ح",1,0],["وَزد أَربَعاً وَاجمَع هَديك مُؤرخاً","تَهن أَمين الفَعل بِالكَوكَب الدري",103,"ر",2,0],["وزد عليه فقد يعلو أبا ولد","كالخمر تفعل ما تفعل العنب",104,"ب",1,0],["وزدته بعدها اشيا منوعة","في ضمنها ادمجت من بعد نسخهم",105,"م",1,0],["وزد وضاعف على ذياك اجمعه","مع القبول آلهى فاستجب كلمى",105,"م",2,0]