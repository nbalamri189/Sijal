{"poems":[[53,"وشيخ ينظف أعفاجه","https://www.aldiwan.net/poem64042.html","المتقارب"],[30,"وأفلت دجال النفاق وما نجا","https://www.aldiwan.net/poem5107.html","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54231","الطويل"],[53,"وشيخ يُنظِّف أعفاجَه","https://www.poetsgate.com/ViewPoem.aspx?id=29126",""],[139,"بدا علم الإنسان في عالم الحس","https://www.aldiwan.net/poem49035.html","الطويل"],[463,"إذا لم أحظ منك على التلاقي","https://www.aldiwan.net/poem56089.html","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48537","الرجز"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120028","الوافر"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55957","الطويل"],[1763,"","https://poetry.dctabudhabi.ae/diwan/poem/146063","الطويل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121754","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129406","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131272",""],[3893,"","https://poetry.dctabudhabi.ae/diwan/poem/114860","الوافر"],[4840,"رأى طلعة الباشا المشير تحفها","https://www.poetsgate.com/ViewPoem.aspx?id=129157",""],[5691,"مأمن الله","https://www.poetsgate.com/ViewPoem.aspx?id=206667",""]],"verses":[["رأى طُهر ظاهره لا يتم","م أو يطهرَ الأدَمُ الأحْمر",0,"ر",1,0],["رَأى طَبَقاً لا يَنقُضونَ عُهودَهُم","لَهُم قائِدٌ قُدّامَهُم غَيرُ أَعوَرا",1,"ر",2,0],["رَأَى طَلْعةً لوْ أَنَّ لِلْبَدْرِ مِثْلَهَا","لَمَا انحدرتْ دونَ النجومِ مَنَازِلهْ",2,"ل",2,0],["رأى طُهر ظاهره لا يتمْ","مُ أو يظهر الأدَمُ الأحْمَرُ",3,"ر",1,0],["رأى طاعة الباري عليه فريضة","فعادت قصاراه ملازمة الخمس",4,"س",1,0],["رأى طعم العقوقِ لنا مريراً","فبَرَّ ودلَّهُ صدقُ المذاقِ",5,"ق",1,0],["رأى طبيب القوم أن يكبِّرا","جسمك كي نبصره فصغرا",6,"ر",2,0],["رأى طمأى فأوردني نداه","على بحر من الإحسان طامي",7,"م",2,0],["راى طاءَ طرفي الباء في أول اسمه","وقد ظنها للجرّ فانجرّ للوقتِ",8,"ت",1,1],["رأى طيف سعدى غضي الطرف أن يرى","سواها فظنت لي لواحظ هجدا",9,"د",2,0],["رأى طَرَبَ النَّدْمانِ أسْقَمه الهوَى","فَجَسَّ له نَبْضاً من العُودِ نابِضَا",10,"ض",2,0],["رأى طهره والطهر للرجس دافع","بداراً وبعض القوم بالطهر سوّفوا",11,"ف",3,0],["رأى طلعتي الحسن فاختارها","فكانت له المرتع المخصبا",12,"ب",2,0],["رأى طيراً تمرُّ بعينِ سلمى","وقيل النفس الا أن تريحا",13,"ح",2,0],["رأى طلعة الباشا المشير تحفها","سرادق عز ما أجل وأفخما",14,"م",2,1],["راى طوْقَ النجاةِ له سلاماً","يُغاثُ به و(أمريكا) الخفيرُ",15,"ر",1,0]]}