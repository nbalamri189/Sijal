.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85325","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85843","المجتث"],[44,"","https://poetry.dctabudhabi.ae/diwan/poem/1312","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39658","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39662","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55506","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43754","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43755","الوافر"],[63,"","https://poetry.dctabudhabi.ae/diwan/poem/200108","الطويل"],[106,"فقيد القناة","https://www.poetsgate.com/ViewPoem.aspx?id=179682",""],[90,"ثورة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=179144",""],[45,"سواي مرجي سلوة أو مريدها","https://www.poetsgate.com/ViewPoem.aspx?id=32953",""],[51,"دعْ لباكٍ رسومَه وطلولَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=30335",""],[51,"لا تَصدِفا عن دِمن المنازلِ","https://www.poetsgate.com/ViewPoem.aspx?id=30265",""],[51,"ابا حسن إنّ حبل الِمطا","https://www.poetsgate.com/ViewPoem.aspx?id=29052",""],[51,"قدمتَ قدوم البدر بيتَ سُعُودهِ","https://www.poetsgate.com/ViewPoem.aspx?id=27697",""]],"verses":[["وَلا عَجَبٌ أَن تُمطِرَ العَينُ فَوقَهُ","فَإِنَّ سَوادَ العَينِ فيهِ دَفينُ",0,"ن",1,0],["وَلا عَجَبٌ قَلبي كَما هُنَّ غادِرٌ","عَلى بَعدَ أَنَّ أَضلاعي عَلَيهِ حَواني",1,"ي",1,0],["وَلا عوداً مِنَ الأَحسابِ يُمسي","نَقِيَّ اللَيطِ مِن عُقَدِ الوُصومِ",2,"م",1,0],["وَلا عارٌ عَلى الماتِ","حِ أَن يَغلِبَهُ السَجلُ",3,"ل",1,0],["وَلا عاطِفاً جيدي إِلَيكُم بِلَفنَةٍ","مِنَ الشَوقِ ما سارَ النُجومُ الطَوالِعُ",4,"ع",1,0],["وَلا عَينَ إِلّا الدَمعَ تَجري غُروبُهُ","فَلاقِ بِهِ المَقدورَ إِن شِئتَ أَو دَعِ",5,"ع",1,0],["وَلا عَجَبٌ أَن تَرى مِثلَها","وَزِندُكَ في كَرَمِ العِرقِ واري",6,"ر",2,0],["وَلا عَجَبٌ أَن يُعيرَ الثَراءَ","فَالمَجدُ أَكرَمُ مِن أَن يُعارا",7,"ر",2,0],["وَلا عَرّى ثَراهُ مِنَ الغَوادي","وَمِن نُوّارِها سَبطٌ وَجَعدُ",8,"د",1,0],["وَلا عِلمَ لي بِالغَيبِ إِلّا طَليعَةً","مِنَ الحَزمِ لا يَخفى عَلَيها المُغَيَّبُ",9,"ب",1,0],["وَلا عَزمُهُ في فِعلِهِ بِمُذَلَّلٍ","وَلا مَشيُهُ في فَتكِهِ بِضَراءِ",10,"ا",2,0],["وَلا عَيبَ فيهِ غَيرَ أَنَّ مَطيَّهُ","عَلى اليأسِ مِن تَغويرِهِ في الوَدائِقِ",11,"ق",1,0],["وَلا عِزَّ إِلّا صَهْلَةُ الخَيْلِ في الوَغى","فَلا تَأْلَفا شَدْوَ القِيانِ الصَّوادِحِ",12,"ح",1,0],["وَلا عِزَّ حَتَّى يَضْرِبَ المَرْءُ جَأْشَهُ","عَلى اليَأْسِ فَانْفُضْ رَاحَتَيْكَ مِن النَّاسِ",13,"س",1,0],["ولاعِجُ الوَجْدِ يَطْويهِ وينشُرُهُ","حتى بَدا الصُّبْحُ مَوشِيّاً أكارِعُهُ",14,"ع",2,0],["ولاعَبْتُ ظِلّي في فِنائِكَ بَعدَما","أبَى أن يُزيرَ الأرضَ طُرَّتَهُ البُرْدُ",15,"د",1,0],["ولا عِزَّ حتى تَتْرُكَ القِرنَ مُرهَقاً","حَمَتْهُ العَوالي أن يَعيثَ ويَنْزَعا",16,"ع",2,0],["وَلا عَيبٌ عَلَيَّ وَلا مَلامٌ","إِذا أَصلَحتُ حالي بِالفَسادِ",17,"د",1,0],["وَلا عاشَ إِلّا مَن يُصاحِبُ فِتيَةً","غَطاريفَ لا يَعنيهِمُ النَحسُ وَالسَعدُ",18,"د",1,0],["ولا عُرِفَ الحقُّ المُبينُ من الهَوى","ولا مثَلَتْ للسّالِكين المَهايِعُ",19,"ع",1,0],["وَلاَعِجُ الشَّوْقِ قَدْ هَوَانِي","مِنْ بُعْدِكُمْ فَاقْتَضَى هَوَانِي",20,"ن",2,0],["ولاَ عَارَ في وِرْدِ الحَمَامِ فَإِنَّهُ","سَبيلُ الوَرَى مَا بَيْنَ شِيبٍ وشُبَّانِ",21,"ن",1,0],["وَلاَ عَدِمَتْ أَرْجَاؤُكَ النُّورَ إِنَّهَا","مَطَالِعُ أَقْمَارِي وَآفَاقُ أَنْجُمِي",22,"ي",1,0],["ولا عبيد ولا خيل وإن لبس الن","نَاس الجديد كفاه الواهن البالي",23,"ي",1,0],["وَلا عَيبَ فيها غَيرَ زُرقَةِ عَينِها","كَذاكَ عِتاقُ الطَيرِ زُرقٌ عيونُها",24,"ن",3,0],["وَلا عِندَنا خَيرٌ إِذا كُنتَ باخِلاً","وَأَروَحُ مِن قَولٍ نَعَم ثُمَّ تَبخَلُ",25,"ل",1,0],["وَلا عارِفاً ما كانَ بَيني وَبَينَهُ","وَمِن خَيرِ ما أَدلى بِهِ المَرءُ ما عَرَف",26,"ف",1,0],["وَلا عادِيا لَم يَمنَعِ المَوتَ مالُهُ","وِردٌ بِتَيماءَ اليَهودِيِّ أَبلَقُ",27,"ق",1,0],["وَلا عَجَبٌ أَن ثُلَّ عَرشُ مُمَلَّكٍ","قَوائِمُهُ عودٌ وَدُفُّ وَمِزهَرُ",28,"ر",1,0],["وَلا عَتَبتُ عَلى خِلٍّ يَضِنُّ بِها","ما دامَ يَزهَدُ في شُكري وَعِرفاني",29,"ي",1,0],["وَلا عَجَبٌ فَمِصرُ عَلى وَلاءٍ","وَمالِكُها عَلى خُلُقٍ عَظيمِ",30,"م",1,0],["وَلا عَقلَ يَهديهِم وَلا دينَ عِندَهُم","وَحُكمهُمُ حُكمٌ وَأَمرهُم أَمرُ",31,"ر",1,0],["وَلا عادَني مِن وَفاءٍ سُرورٌ","وَلا نالَني لِجَفاءٍ مَضَض",32,"ض",1,0],["ولاعَبتُها الشِّطرَنج خَيلى تَرَادَفَت","ورُخّى عَليها دارَ بِالشاهِ بالعَجَل",33,"ل",1,0],["وَلاَ عَصَمَ الصَّقِيعُ وَكَانَ مِنْهُ","مَعَاقِلُ خَلْفَهَا لَهُمُ اعْتِصَامُ",34,"م",1,0],["وَلاعَيبَ فيها غَيرَ أَنَّ سَريعَها","قَطوفٌ وَأَن لا شَيءَ مِنهُنَّ أَكسَلُ",35,"ل",1,0],["وَلا عَقِصاً بِحاجَتِهِ وَلَكِن","عَطاءً لَم يَكُن عِدَةً مِطالا",36,"ل",2,0],["ولا عجبٌ أن فاتت الشُّهبَ بالعُلا","وأن جاوزت منها المدى المتناهيا",37,"ي",2,0],["ولا عجب من مَبْسمِ الزهر في الربا","فللبرق من خلف السّحائب مَبْسِمُ",38,"م",1,0],["ولا عيبَ فيه غير أن سنانه","إذا شَمَّ ريح النقع في الحرب يرعُفُ",39,"ف",1,0],["ولا عيب فيها غير أن أولي الهوى","ينادونها في الحسن بنت العجائب",40,"ب",1,0],["ولا عَبت نسمات الحب ألويةً","من الرشاد أقيمت فوق أنشاز",41,"ز",1,0],["ولا عجبٌ فقد جَدَّدت منه","عواطف كان عمّ بها الأناما",42,"م",2,0],["ولا عذّبَتْني في العُذَيب صبابة","ولا شاقني برق لربع ببارق",43,"ق",1,0],["ولا عجب أن عابني الشاعر الذي","يقول سخيف الشعر وهو مُقلِّد",44,"د",1,0],["ولا عجب إن الحياة خيالة","فلا فرق عندي بين شخصك والذكر",45,"ر",1,0],["وَلَأَعوَرَي نَبهانَ كَأسٌ مُرَّةٌ","وَلِتَيمِ بَرزَةَ قَد قَضَيتُ قَضائي",46,"ا",2,0],["وَلا عَرَفوا مَواقِفَ يَومِ جَمعٍ","وَلا حَوضَ السِقايَةِ وَالأَراكا",47,"ك",2,0],["ولا عبر الأيام يعرِف بعضَها","ببعض من الأقوام إلا لبيبها",48,"ب",3,0],["ولا عن صفاة النِّيق زلَّتْ بناعل","ترامى به أطوادُها ولهُوبُها",48,"ب",3,0],["وَلا عَدِيُّ اِبنُ كَعبٍ إِنَّ صَبغَتَها","كَالهُندُوانِيِّ لا رَثٌّ وَلا دَإِرُ",49,"ر",1,0],["وَلا عَزيزاً فَإِنَّ الغَدرَ مَنقَصَةٌ","إِنَّ عَزيزاً دَقيقُ النَفسِ وَالخُلُقِ",50,"ق",1,0],["ولا عدمَ القصَّادُ بابكِ إنَّه","لنجح الرجا بابٌ صحيحٌ مجرَّب",51,"ب",1,0],["ولاعبٍ يعرِبُ شطرنجهُ","عن فهمِه المتَّقدِ الصائب",52,"ب",1,1],["ولا عيبَ فيه غير إسراع جوده","فليس يُمني بالمواعد محوجا",53,"ج",2,0],["ولا عيب في تلك الليالي التي خلت","سوى أنها مرت على الطرف كاللمح",54,"ح",1,0],["ولاعبةٍ بنفس المرءِ يمشي","هواها مثلَ ما يمشي الرُخيخ",55,"خ",1,1],["ولا عيبَ فيه غيرُ إسراف جوده","وأنَّ مدَى علياهُ غيرُ محدَّد",56,"د",1,0],["ولا عيبَ في أثناء عيبة يلتقي","سوى سؤدد يضني وشاةً وحسدا",57,"د",2,0],["ولا عدم الحالَ الضعيفُ موافياً","لديك بأنواعِ اللهى وعوائدا",58,"د",2,0],["ولا عيبَ فيها غير سحر جفونها","وأحبب بها سحَّارة حين تسحر",59,"ر",1,0],["ولا عيب فيه سوى سؤدد","تكدّ الفهومُ ولا يحصر",60,"ر",1,0],["ولا عيبَ فيه غير إفراط سؤددٍ","يشقُّ على جهد المدائح حصره",61,"ر",2,0],["ولا عدساً رأيت له وأما","مصفاه فصفى لي كثيرا",62,"ر",2,0],["ولا عيبَ فيه إن تأمَّلت خلقه","سوى أنه يطغي الخليقة بالعطا",63,"ط",2,0],["ولا عيبَ في أخلاقه غير أنه","إذا عذلوه في الندى ليس يرجع",64,"ع",1,0],["ولا عيب في إحسانه غير أنني","شرهت فما لي اليوم وصف قنوع",65,"ع",1,0],["ولا عجب للشهر وافقَ مقدماً","فكلّ زمان في حماك ربيع",66,"ع",1,0],["ولا عيبَ فيه غير أنَّ له ندىً","يجيب ندا العافين من قبل يسأل",67,"ل",1,0],["ولا عيبَ فيه غير سبق هباته","فما يتهنَّى مفصحٌ بسؤال",68,"ل",1,0],["ولا عيبَ فيه غير إسراف أنعمٍ","ترى عزمها في الجودِ غاية غنمها",69,"م",3,0],["ولا عيب فيه غير أني قصدته","فأنستنيَ الأيام أهلاً وموطنا",70,"ن",2,0],["ولا عيبَ في نعمائهِ غير أنَّها","لأعناق أحرار البريّة أثمان",71,"ن",1,0],["ولا عيبَ أيضاً في بديعِ كلامهِ","سوى أنَّه بالحسِ للناسِ فتَّان",71,"ن",1,0],["ولا عيبَ فيها غير راحة نظمها","وحاسدها ذاك المنكل تعبان",71,"ن",1,0],["ولا عيبَ في نعمائها غير أنَّها","تجود متوهي الكاهل المتجمِّلا",72,"ل",2,0],["وَلا عُرفٌ وَلا نُكرٌ","وَلا يَأسٌ وَلا وَعدُ",73,"د",1,0],["ولا عيبَ فيه غيرَ أني صحبتُه","وَليّاً فأَعْشى ناظرِي خَشعةُ المولى",74,"ا",1,0],["ولا عطاياهُ بمتْلُوَّةٍ","منها الهنيئاتُ بنَكْدائِهِ",75,"ا",3,0],["ولا عيب إلا عيبُ من يملك الغِنى","ويمنعُ أهلَ الفقرِ فضلَ ثرائِهِ",76,"ا",3,0],["ولا عيشَ إلا بين أكوابِ قهوةٍ","تَوَارَثَها عَقْبٌ من الفرس عن عقبِ",77,"ب",1,0],["ولا عجيبٌ لا ولا منْكَرٌ","أن تلِدوا الأَطْيَبَ فالأطيبا",78,"ب",2,0],["ولا عيبَ في أخلاقه غيرَ أنهُ","أخو عزماتٍ في الندى مَحِلاتِ",79,"ت",1,1],["ولا عَجَبٌ أن كانَ من كانَ مِثْلَهُ","تشَبَّهَ بالمعْشوُقِ في التيِّه والصدِّ",80,"د",1,0],["ولا عبدُ الحميد وإنْ زهاه","تَقَادُمُ عهْدِهِ شَهِدَ الحَمِيدُ",81,"د",1,0],["ولا عَمْدَ لم يحفزهُ عمْدٌ مؤكَّدٌ","من المرءِ إلا أشْبَهَ الخطأَ العمْدُ",82,"د",1,0],["ولا عدم العرفُ الذي تصنعونه","مِداداً نُفُودُ البحر قبل نفودِهِ",83,"د",2,0],["ولا عدم المؤمِّل منه مطلاً","تتم به الصنائع والأيادي",84,"د",2,0],["ولا عَلمَ الرحمنُ أنِّي سلَوْتُهُ","ولا زال بي كيدُ الوشاة عن العهدِ",85,"د",1,0],["ولا عيب فيها غير أن ضَجيعها","وإن لم تُصبها الساهرية يسهرُ",86,"ر",1,0],["ولا عذر إن أنت خاتلْتني","عن العذر فعلَ امرئٍ ماكر",87,"ر",1,0],["ولا عيبَ أن تُجزَى القروضُ بمثلها","بل العيبُ أن تَدّان ديناً فلا تَقْضي",88,"ي",1,0],["ولا عيب فيها غير أن نذيرها","يروع قلوبَ الطير حتى تَصعصعا",89,"ع",2,0],["ولا عيب فيه سوى نائل","يلاقي السؤال بخدٍّ ضَرِع",90,"ع",1,0],["ولا عن الأيمانِ منكمْ والشُّمل","ولا مِنَ العُلو ولا مما سفُل",91,"ل",1,0],["ولا على الضارعِ بالأُسد البُسُل","لكم عن الحاسرِ أظفارٌ كُلُل",91,"ل",1,0],["ولا عُرّيا من نجدةٍ وسلامةٍ","لِتَنْجَابَ أهوالٌ وتؤمنَ أوجالُ",92,"ل",1,0],["ولأعدائهِ إذا ما أرادو","هُ بكيدٍ سيوفُه المسلولهْ",93,"ل",2,0],["ولا عدمْتَ نماءً لا انتهاءَ له","في الحال والمال والأحبابِ والخولِ",94,"ل",1,0],["ولا عذرَ إن نِلتَ التي أنت فوقها","على هذه الصغرى التي قلّ عذلُها",95,"ل",3,0],["ولا عذرَ للحالِ التي ضنَّ فرعُها","علينا بما فيه إذا اشتدّ أصلُها",95,"ل",3,0],["ولا عاتٍ يصولُ على ضعيفٍ","صِيالَ الفيل هاج به اغتلامُ",96,"م",1,0],["ولأعقِلنَّ عن الغوائل حيلتي","ولأعقلنَّ عن الهجاء لساني",97,"ن",2,0],["وَلأَعيش في الشُعاعِ بِضعَ ثَوانِ","فَهيَ خَيرٌ مِن أَلفِ عام",98,"م",1,0],["وَلا عَجَبٌ أَن يُبغِضَ الحُرَّ جاهِلٌ","مَتى عَشِقَ البومُ الهَزارَ المُغَرِّدا",99,"د",2,0],["ولا عَيبَ في اليَحمومِ غَيرُ هُزالِهِ","عَلَى أَنَّهُ يَومَ الهِياجِ سَمينُ",100,"ن",1,1],["ولا عار في زيغ الفتى رشذوذه","ولكنما في كذبه والتذبذب",101,"ب",1,0],["وَلا عَظَّمتُ في الأَشياءِ إِلّا","صَحيحَ العِلمِ وَالأَدَبِ اللُبابا",102,"ب",2,0],["وَلِأَعداءِ آلِ أَيّوبَ قَتلٌ","وَلِأَسراهُمُ قِرىً وَثَواءُ",103,"ا",2,0],["ولا عَقَنْبَاةُ السُّلاَمَى لها","في كُلِّ أُفْقٍ عَلَقٌ مُهْمَلُ",104,"ل",1,0],["وَلا عِفَّةٌ في سَيفِهِ وَسِنانِهِ","وَلَكِنَّها في الكَفِّ وَالفَرجِ وَالفَمِ",105,"م",1,0],["ولا عذرَ لي عند العُلى وصوارمي","ظِماءٌ إِلى وِرْدِ الطُلى والغَلاصِمِ",106,"م",1,0],["ولا عذرَ إِلّا أنّ بدءَ إِساءةٍ","له من زياداتِ الوُشاةِ تمامُ",107,"م",1,0],["وَلا عُدَّ سَبقٌ مِثلَ سَبقِكَ في الَّذي","أَتَيتَ إِذا آلاءُ غَيرِكَ عُدَّتِ",108,"ت",1,0],["وَلا عَلِموا أَنَّ المَكارِمَ أُبدِيَت","جِذاعاً وَلا أَنَّ المَظالِمَ رُدَّتِ",108,"ت",1,0],["وَلا عَيشَ حَتّى يَبتَلي طَعمُ وَقعَةٍ","مِنَ السَيفِ يَذكو في حَشاهُ وَقودُها",109,"د",3,0],["وَلا عَيبَ في أَخلاقِهِ غَيرَ أَنَّهُ","غَريبُ الأُسى فيها قَليلُ المُساعِدِ",110,"د",1,0],["وَلا عِزَّ لِلإِشراكِ مِن بَعدِ ما التَقَت","عَلى السَفحِ مِن عُليا طَرونَ عَساكِرُه",111,"ر",2,0],["وَلا عَجَبٌ أَن تَشهَدوا الطَعنَ دونَهُ","وَما عَشَرَتكُم في نَداهُ عَشائِرُه",111,"ر",2,0],["وَلا عَجَبٌ أَن رَجَّمَ الغَيبَ عالِمٌ","فَقَبلَ الغُيوثِ ما تَكونُ المَخايِلُ",112,"ل",1,0],["وَلا عَجَبٌ لِلأُسدِ إِن ظَفِرَت بِها","كِلابُ الأَعادي مِن فَصيحٍ وَأَعجَمِ",113,"م",1,0],["وَلا عُذرَ إِلّا أَنَّ بَدءَ إِساءَةٍ","لَها مِن زِياداتِ الوُشاةِ تَمامُ",114,"م",1,0],["وَلا عُذرَ إِلّا أَنَّ حِلمَ حَليمِها","تَسَفَّهَ في شَرٍّ جَناهُ خَليعُها",115,"ع",3,0],["وَلا عِزَّ إِلّا عِزُّنا قاهِرٌ لَهُ","وَيَسأَلُنا النَصفَ الذَليلُ فَيُنصَفُ",116,"ف",1,0],["ولا عائق يثني عنانك عن هوى","رغا جانب منه وأومض جانب",117,"ب",1,0],["ولا عتب على الدهر","وإن جار وإن أدنى",118,"ا",1,0],["ولا عادَ رَدُّ المُستَعارِ مُسلَّماً","وَقُدَّمَ رَيعانُ الصَّبا وتأخَّرا",119,"ر",2,0],["وَلا عُدَّ يَوماً في الأَنامِ بِغاصِبٍ","سِوى بَأسِ عَمروٍ وَالسَماحَةِ مِن مَعنِ",120,"ن",1,0],["ولا عَجَبٌ أنّ ضَمّاتنا","جَبَرْنَ القلوبَ وَهِضْنَ العظاما",121,"م",2,0],["ولا عَجَبٌ أنّ صَرْفَ الزّمان","تُصَرّفُ يُسْرَاهُ منه زماما",121,"م",2,0],["ولا عَجَبٌ أنْ عَلّمَ الجودَ باخلاً","يَضِلّ أخو جَهْلٍ ويُهدى بعالمِ",122,"م",1,0],["ولا عَدِمَتْ في سلّها من غمودها","ظهوراً فقد تخفى الجداول بالرُّجمِ",123,"م",1,0],["ولا عَجَبٌ فيما تمنّيْتُ إنّني","طويل الأماني عند مَن يحسن الطولا",124,"ل",2,0],["ولا عَرَضَتْ من بيضِهِنَّ سَوافِرٌ","عليكَ الخدودَ الحُمرَ والأعينَ النُّجلا",125,"ل",2,0],["وَلا عَمِلَت خَرقاءُ أَوهَت شَعيبَها","كَما عَمِلَت تِلكَ الدُموعُ الفَوائِضُ",126,"ض",1,0],["وَلا عَجَباً أَنّا ذَلَلنا لِحادِثٍ","تَذِلُّ لَهُ الآسادُ وَهيَ غِضابُ",127,"ب",1,0],["ولا عَرفَ الهلالَ يسير فخماً","ولا نظر السُّهى يمشِي رصينا",128,"ن",2,0],["وَلا عَلَت رايَةٌ لِلعِلمِ تَنشُرُها","إِلّا تَلَقَّفَها دَنلوبُ يَطويها",129,"ي",3,0],["وَلا عالِمٍ ما في غَدٍ غَيرَ أَنَّهُ","يُرَفِّعُ أَعضادَ الحِياضِ بِمِعوَلِ",130,"ل",1,0],["وَلا عَقَقتُ بِجَسِّ الكَأسِ ساقِيَتي","وَلا عَفَفتُ وَظَلَّ الدَهرُ يَنعاني",131,"ي",1,0],["وَلا عَجَبٌ غَيرَ قَتلِ الحُسَينِ","ظَمآنَ يُقصى عَنِ المَشرَبِ",132,"ب",1,0],["ولا عَتْبٌ على مَن قامَ يَجْلو","محاسِنَ لا تُرَى معها عيوبُ",133,"ب",1,0],["ولا عُهُودَ لكُمْ تُرْعَى ولا ذِمَمٌ","ولا بُيُوتُكُم شَعْرٌ وَلا وَبَرُ",134,"ر",1,0],["ولا عجبٌ من كونِ ذا واتفاقهِ","فروحاكما رُوحٌ وجسماكُمَا جِسمُ",135,"م",1,0],["ولا عَجَبٌ أن كُنْتَ خَيرَ مُتَوَّجٍ","فجَدُّكَ بالبَطحاءِ خيرُ مُعمَّم",136,"م",1,0],["ولا عَذُبَ الماءُ القَراحُ لِشارِبٍ","وفي الأرضِ مَرْوانِيّةٌ غيرُ أيِّم",136,"م",1,0],["ولا عجَبٌ والثّغْرُ ثغرُك كلّه","وأنتَ وليُّ الثّأرِ والثّأرُ مطلوب",137,"ب",1,0],["وَلا عَجيبٌ إِن جَفَت دِمنَةٌ","عَن مُستَهامٍ نَومُهُ قوتُ",138,"ت",1,0],["وَلا عَيبَ فيهِم غَيرَ أَنَّ سُيوفَهُم","بِهِنَّ فُلولٌ مِن قِراعِ الكَتائِبِ",139,"ب",1,0],["وَلا عَقلَ لِلدَهرِ فيما أَرى","فَكَيفَ يُعاتَبُ إِن أَذنَبا",140,"ب",2,0],["وَلا عِلمَ لي مِن أَمرِهِم غَيرَ أَنَّهُم","لَو اِنتَبَهوا مِن رَقدَةٍ عَذَلواكا",141,"ك",2,0],["وَلا عَجوزٌ مُكَنّاةٌ وَغانِيَةٌ","كِلتاهُما في المَغاني مِن سَباياكا",142,"ك",2,0],["وَلا عُمتَ في الخَمرِ الَّتي حالَ طَعمُها","كَأَنَّكَ في غَمرٍ مِنَ السَيلِ عائِمُ",143,"م",1,0],["ولا عَبَثَتْ بعُشْبٍ في ربيعٍ","ولا وَرَدَتْ على ظَمَإٍ نَضِيحا",144,"ح",2,0],["وَلا عما وَراء السحب منها","فَذَلِكَ مطلب عنا بَعيد",145,"د",1,0],["ولا عظيم","يدير ملكاً عظيما",146,"م",2,0],["وَلَأَعقَبَ النَجمُ المُرِذُّ بِديمَةٍ","وَلَعادَ ذاكَ الطَلُّ جَوداً وابِلا",147,"ل",2,0],["ولا عزّكِ الجيلُ المُفدّى ولا خبتْ","لقومكِ نارٌ في ذوائبِ أجبالِ",148,"ل",1,0],["ولا عهدَ إلَّا للعروبة والعُلى","لقلبَينِ في كفَّين يعتنقانِ",149,"ن",1,0],["وَلا عِيدَ إِلاَّ لِلأَسَى فِي قُلُوبِنَا","أَمَا مَلَّهُ قَلْبٌ لِفَرْطِ اعْتِيَادِهِ",150,"د",2,0],["وَلا عِلمَ لي إِلّا بِنَقسي وَجَدتُها","فَيا أَبَتِ اِعمَل صالِحاً لِتَراني",151,"ن",2,0],["وَلا عَجَبٌ لِجَوهَرَتي","أَلَيسَ البَحرُ مَعدَنَها",152,"ن",3,0],["ولا عز حتى تضمر النفس يأسها","وهل تلد الأطماع غير هوان",153,"ن",1,0],["ولا عادهُ عائدٌ في الفراشِ","ولا ناله في الفراش الضَّجر",154,"ر",1,0],["ولا عجبٌ أنْ يُخْرِسَ الوضعُ ناطقاً","بلى عجبٌ أنْ يُلْهَمَ القولَ قائل",155,"ل",1,0],["ولا عيش حتى يبتلي طعم وقعتي","من السيف يذكو في حشاه وقودها",156,"د",3,0],["ولأعدائهِ إذا ما أرادو","هُ بكبدٍ سيوفُه المسلوله",157,"ل",2,0],["ولا على مَبرِك ذاكَ الجامل","ما قَدْرُ إصرارِكَ بالجمائل",158,"ل",1,0],["ولا عذر إن أنت خاتلْتني","عن العذر فعلَ امرىء ٍ ماكر",159,"ر",1,0],["ولاعدم العرفُ الذي تصنعونه","مِداداً نُفُوذُ البحر قبل نفودِهِ",160,"د",2,0]]}