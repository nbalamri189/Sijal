{"poems":[[29,"عوجي علينا واربعي ربة البغل","https://www.aldiwan.net/poem5972.html","الطويل"],[94,"كرهت القصور وقطانها","https://www.aldiwan.net/poem38931.html","المتقارب"],[339,"قلب شريد","https://www.aldiwan.net/poem23664.html","عموديه"],[445,"بفتح الفتوح وسعد السعود","https://www.aldiwan.net/poem34864.html","المتقارب"],[463,"ليل السرى مثل نهار المقام","https://www.aldiwan.net/poem55886.html","السريع"],[466,"الام يراك المجد في زي شاعر","https://www.aldiwan.net/poem15927.html","الطويل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80209","البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46534","الرجز"],[266,"","https://poetry.dctabudhabi.ae/diwan/poem/129598","الطويل"],[2449,"","https://poetry.dctabudhabi.ae/diwan/poem/115396","المديد"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74029","المتقارب"],[5273,"حقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=191949",""],[5436,"لهيب الثأر ماخمدا / زاحم محمود","https://www.poetsgate.com/ViewPoem.aspx?id=177642",""],[5533,"ذَهَبَ الشَّباب","https://www.poetsgate.com/ViewPoem.aspx?id=177714",""],[5725,"راهبة","https://www.poetsgate.com/ViewPoem.aspx?id=197099",""],[5751,"كذبةُ سيف","https://www.poetsgate.com/ViewPoem.aspx?id=214773",""]],"verses":[["وَتُرهَبُ يَربوعٌ وَرائِيَ بِالقَنا","وَذاكَ مَقامٌ لَيسَ يُزري بِهِ فِعلي",0,"ل",2,0],["وتُرْهِبُها غادياتُ الغمامِ","وتُؤلِمُها كلُّ ريحٍ عَصُوفْ",1,"ف",1,0],["وترهب القلب الجريح كرامة","ولمست بأطرافي السماء",2,"ا",2,0],["وتُرْهِقُهُمْ كُلَّ طَوْدٍ يفَاعٍ","يُمَثِّلُهُمْ رَهَقاً فِي صَعُودِ",3,"د",1,0],["وترهَبُ الإصحار مستبرِداً","مع الضحى ظلَّ كسورِ الخيامْ",4,"م",1,0],["وترْهبُه زهْرُ النجوم فتَحْتمي","به عند أطرافِ الرماحِ الشَّواجرِ",5,"ر",1,0],["وَترهبُ النسرَ في العَلياء مُنطَلِقاً","فَلا يَكادُ يَمُسُّ الطَيرَ مِن وَجَلِ",6,"ل",1,0],["وَترهات بارِدَه","وَحَسرات زائِدَه",7,"ه",1,0],["وترهب بالكتب الكتايب في الوغى","وتسلب بالحزم الكمي المكافحا",8,"ح",2,0],["وتره يسعى إليه به","ودم يجنيه مطلول",9,"ل",1,0],["وَتَرهَبُ صولةَ عَزمي الأُسود","وَتَخشى لِقائي أَعدائيَه",10,"ي",2,0],["وَتَرَهَّلَتْ آثامُنا مِنْ تُخْمَةٍ","لَنْ يَسْتُرَ الآثامَ ثَوبٌ ضَيِّقُ",11,"ق",1,0],["وترهقهم طوالعُنا","صعابٓ المرتقئ شددا",12,"د",2,0],["وتَرَهَّلتْ تِلْكَ الجُسُومُ وأَقْفَرَتْ","وغَدا التَّصَابِي كالسَّرابِ الخَادِعِ",13,"ع",1,0],["وترهْبنتْ شمساً فشعّ الجيد","فالقلب في دير العيون شريد",14,"د",1,1],["وتُرّهاتٌ أضاعتنا فما وجدتْ","سوى بَنيها بهم عاثتْ يَدُ الشَّجَبِ",15,"ب",1,0]]}