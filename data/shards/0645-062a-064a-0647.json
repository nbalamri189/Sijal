{"poems":[[65,"تأملت الورى جيلا فجيلا","https://www.aldiwan.net/poem46180.html","الوافر"],[47,"سلام عليكم لا وفاء ولا عهد","https://www.aldiwan.net/poem63506.html","الطويل"],[190,"وإخوان سوء لا يسر إخاؤهم","https://www.aldiwan.net/poem43851.html","الطويل"],[447,"أعد نظراً في السرب بالرمل من حزوي","https://www.aldiwan.net/poem14343.html","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108887","الوافر"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105416","الطويل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26421","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89525","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201560","الوافر"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65134","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86284","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131217",""],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97093","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58002","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120448","الوافر"],[4692,"وأتعبني الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=196834",""],[5147,"سر الهوى العذري مودع","https://www.poetsgate.com/ViewPoem.aspx?id=166721",""],[5582,"بَدَتْ عَنْ وَجْهِها سَحَراً فَلاحَا","https://www.poetsgate.com/ViewPoem.aspx?id=186791",""]],"verses":[["متى هَذَرَ القَبائلُ في فَخارٍ","بألْسِنَةٍ تَهُزُّ بِها نُصولا",0,"ل",2,0],["مَتى هِجتُموهُ لا تَهيجوا سِوى الرَدى","وَإِن كانَ خِرقاً ما يُحَلُّ لَهُ عَقدُ",1,"د",1,0],["متى هلكوا لم أبتئس بفجيعة","وإن هم بقوا عاشوا بأشأم طائر",2,"ر",1,0],["متيهه الساري من السحب إن سرى","تخيله يغتاب في قمة السروى",3,"و",2,0],["متى هذا الصدود يصد عني","وتجمعني وفاتنتي الخيام",4,"م",1,0],["متى هم لم يجلب إلى النفس منية","بغير المواضي والمثقفة الذبل",5,"ل",1,0],["مَتى هانَ حُرٌّ لَم يُرِق ماءَ وَجهِهِ","وَلَم تُختَبَر يَوماً بِرَدٍّ صَفائِحُهْ",6,"ح",2,0],["مَتى هَمَّ أَمضى هَمَّهُ بِفَيالِقٍ","تَسوقُ إِلى الأَعداءِ دُهمَ المَصائِبِ",7,"ب",1,0],["متى هيأت أوراقاً لشعري","يفرّ الشعر مصطحباً شعوري",8,"ر",2,1],["متى همّ بالإكرام دهري عاقه","لئيم لأركان المكارم هادم",9,"م",1,0],["مَتى هَزَّ في يُمناهُ سود يراعه","لَها سَجَدَت في الحالِ بيض البَوارِق",10,"ق",1,0],["متى هبطت والليل محلولك الدجى","يقل من يراها تلك شهب ثواقب",11,"ب",1,0],["متى هزت السمر الرماح أكفهم","رأت آل سفيان اضطراب الأراقم",12,"م",1,0],["متى هذه النفس الدنيَّةُ تتقي","هواها وفي علم الشريعة ترسخ",13,"خ",1,1],["متى هب النسيم على الغياض","تذكرت الثناء على رياض",14,"ض",1,1],["متى هذي المسافات ابْعدتنا","وهذا الوقت يأكل من سنيني",15,"ن",2,0],["متى هويت ورحت من","أشواق ذاك الحي منزع",16,"ع",1,0],["مَتَى هَزَلَتْ بِبَيْنٍ عَنْهُ يَوْماً","دَعا بِالوَيْلِ مِنْ فَزَعٍ وَصاحَا",17,"ح",2,0]]}