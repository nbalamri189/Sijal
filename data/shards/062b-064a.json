{"poems":[[55,"ألمع برق أم ضرم","https://www.aldiwan.net/poem29820.html","مجزوء الرجز"],[0,"ألا إِن قوماً كنتم أمس دونهم","https://www.aldiwan.net/poem56.html","الطويل"],[45,"ثياب كريم ما يصون حسانها","https://www.aldiwan.net/poem10578.html","الطويل"],[30,"إن تك كلبا من كليب فإنني","https://www.aldiwan.net/poem5367.html","الطويل"],[71,"بهادر عبدي لا بهاء ولا در","https://www.aldiwan.net/poem28375.html","الطويل"],[50,"لي عرس حرة مملوكة","https://www.aldiwan.net/poem66232.html","الرمل"],[48,"ثيابي أكفاني ورمسي منزلي","https://www.aldiwan.net/poem22222.html","الطويل"],[102,"بشرى النبوءة","https://www.poetsgate.com/ViewPoem.aspx?id=50187",""],[185,"ثيبى أخاضارورة أشفق العدى","https://www.aldiwan.net/poem58747.html","الطويل"],[234,"ثياب الدمى البيض الحسان كثيرة","https://www.aldiwan.net/poem50880.html","الطويل"],[261,"فديت عز الدولة المرتجى","https://www.aldiwan.net/poem48357.html","السريع"],[309,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[369,"عهد هوى كنا عهدناه","https://www.aldiwan.net/poem60599.html","السريع"],[382,"أراك غني الفضل تنتهر البوسا","https://www.aldiwan.net/poem59381.html","الطويل"],[563,"هو الركبان والحادي","https://www.aldiwan.net/poem34630.html","مجزوء الوافر"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39092","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63892","الوافر"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70836","الوافر"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67821","الطويل"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119254","الخفيف"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126148","الرجز"],[1399,"","https://poetry.dctabudhabi.ae/diwan/poem/143713","الخفيف"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128714","الوافر"],[1926,"","https://poetry.dctabudhabi.ae/diwan/poem/139798",""],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/198859","الطويل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96038","البسيط"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137245",""],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84514","الطويل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112547","الكامل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112479","البسيط"],[3337,"","https://poetry.dctabudhabi.ae/diwan/poem/203553",""],[3369,"","https://poetry.dctabudhabi.ae/diwan/poem/117037","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86345","الوافر"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129485","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117890","الوافر"],[4246,"","https://poetry.dctabudhabi.ae/diwan/poem/103253","الوافر"],[4394,"","https://poetry.dctabudhabi.ae/diwan/poem/117201","المتقارب"],[4692,"لغز شعري","https://www.poetsgate.com/ViewPoem.aspx?id=212347",""],[5092,"أُرتّقُ ثوبَ المنى موعدا","https://www.poetsgate.com/ViewPoem.aspx?id=176220",""],[5145,"أأقسد الشيب في فوديه أم قسطا","https://www.poetsgate.com/ViewPoem.aspx?id=108233",""],[5338,"في رثاء محمد مهدي الجواهري","https://www.poetsgate.com/ViewPoem.aspx?id=187640",""],[5431,"ليس حبا من كان رهن انتهاء","https://www.poetsgate.com/ViewPoem.aspx?id=196612",""],[5431,"وقفة عزّة....","https://www.poetsgate.com/ViewPoem.aspx?id=206595",""],[5480,"(( يا علي ))","https://www.poetsgate.com/ViewPoem.aspx?id=1588",""],[5542,"مادلين اولبرايت","https://www.poetsgate.com/ViewPoem.aspx?id=10194",""],[5751,"من منكنّ أحلى","https://www.poetsgate.com/ViewPoem.aspx?id=215030",""],[6335,"رثاء المطر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65400&r=&rc=2",""],[6346,"لك المدائح ياشهيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83384&r=&rc=0",""]],"verses":[["ثِيابَ عارٍ أَبَداً","فَضفاضَةً عَلى القَدَم",0,"م",1,0],["ثِيابُ بَني عَوفٍ طَهارى نَقِيَّةٌ","وَأَوجُهُهُم عِندَ المُشاهِدِ غِرّانِ",1,"ن",1,0],["ثِيابُ كَريمٍ ما يَصونُ حِسانَها","إِذا نُشِرَت كانَ الهِباتُ صِوانَها",2,"ن",3,1],["ثِيابُ أَبي قابوسَ أَورَثَها اِبنَهُ","وَأَورَثَناها عَن مُلوكِ المَشارِقِ",3,"ق",1,0],["ثيابي وشاشي عندَهُ في إهانةٍ","وطرحٍ ولا طيَّ عناهُ ولا نَشْرُ",4,"ر",1,0],["ثيّبٌ بكرٌ ومالي حيلةٌ","ولها خمسُ بناتٍ في قَرن",5,"ن",1,0],["ثِيابِيَ أَكفاني وَرَمسِيَ مَنزِلي","وَعَيشي حِمامي وَالمَنِيَّةُ لِيَ بَعثُ",6,"ث",1,1],["ثيابهم رشوة تنبي مظاهرها","بأنّها دمع أكباد وأبصار",7,"ر",1,0],["َثِيبِى أَخاضارُورَةٍ أَشفَقَ العِدَى","عَلَيهِ وَقَلَّت فِى الصَّدِيقِ مَعاذِرُه",8,"ه",1,1],["ثيابُ الدُّمَى البيض الحسان كثيرةٌ","ولكنّني منهنّ أَبهى وأَجمل",9,"ل",1,1],["ثيابه في سفطي بيتها","وخبزه مأواه في ملتي",10,"ت",2,0],["ثياب وبنيان زروع ومصنع","وسجع وتصنيف وشعر وديوان",11,"ن",1,0],["ثيابُكمْ أحسَنُ ما أصبحَتْ","على سِواكمْ حينَ يُكساه",12,"ا",2,0],["ثيابهم سودٌ وبيضٌ فعالُهم","وحسّادهم صفرٌ وقد طَهُروا روسا",13,"س",2,0],["ثياب كلها يبدو","بها من خلف أضداد",14,"د",1,0],["ثِيابي وأعطافي ونَشْري ونِعْمَتي","وقُرْطي وحَلْيِي والرَّوادِفُ والقَدُّ",15,"د",1,0],["ثياباً لا تزالُ تذوبُ ليناً","إذا الأيدي عرَضْنَ لها بِلمس",16,"س",1,0],["ثياب الليل قد صارتْ","بضوء الفجر أسمالا",17,"ل",2,0],["ثِيَابُ الضَّنى قَدْ جُدِّدَتْ لِبعَادِكُمْ","فَزِيدُوا سِقَامِي إنْ يَكُنْ مِنْ مُرَادِكُمْ",18,"م",1,1],["ثِيَابُ الأَسى عِنْدِي لَبِسْتُ جَدِيدَهَا","وَبُرْدُ اصْطِبَارِي عَنْهُ رَثّ وَمَاكِثُ",18,"ث",1,0],["ثيبات ثوابهن ثلوثي","ثملات ثمالهن ثرائي",19,"ا",2,0],["ثياب الدين عمتها خروق","إذا خرق رقعت بدت خروق",20,"ق",1,0],["ثيبٌ إن هويتُ ذلك منها","ومتى شئتُ لم أجدْ غيرَ بكرِ",21,"ر",1,0],["ثياب السقم تكفيني وغسلي","يصب مدامع تهمي كسحب",22,"ب",1,0],["ثيابك إن طالت سوى حلل التقى","تعود إلى هتك الفضائح والرث",23,"ث",1,0],["ثياب شبابي بالذنوب تشعثت","وبالمدح أرجو أن يزول التشعث",24,"ث",1,0],["ثيابه نسج داود وعمته","عادية أصبحت تعزى إلى أرم",25,"م",1,0],["ثيفيل يا رجل الزمان ومن غدا","جيد الزمان بمجده يتطوق",26,"ق",1,1],["ثياب المَعالي لا تَنال بحيلة","الى أَن تَرى في موقف غير رائث",27,"ث",1,0],["ثيابى كمصطاف الغنى نوافذا","ومشتى الفقير ابن السبيل هشيما",28,"م",2,0],["ثيابه كأمانيه ممزقة","كأنها وهو حيٌّ فوقه كفن",29,"ن",1,0],["ثيابهم بيضوا رياء","وقلبهم بالسواد مظلم",30,"م",1,0],["ثيابهم بيض من رياء","وقلبهم بالسواد مظلم",31,"م",1,0],["ثِيابَ السَقمِ من جفنٍ","لِجِسمي طالَما غَزلا",32,"ا",1,0],["ثيابا ترداها لوي بن غالب","تردى بها والمجد بالمجد يعبث",33,"ث",1,0],["ثياب العرض لحن عليه بيض","وخلق وهو ذو العزمات دمث",34,"ث",1,0],["ثياب العزّ مزّقها التعادي","وصرحُ المجد جدّ به العفاء",35,"ا",2,0],["ثيابُكَ للعيدِ مطوِيَّةٌ","وعِرضُك للشَتمِ والبِذلَه",36,"ل",2,0],["ثِيَابُهُ (مسْنَدِيَّاتٌ) تراه بِها","يَزْهُو ويفْخرُ لا تَبْلى وتَهْترئُ",37,"ا",1,0],["ثيابُ الأماني منىً قُطِّعتْ","أُرَتِّقُ ثوبَ المنى موعدا",38,"د",2,0],["ثياب زرقٍ وتزويرٍ ومخرقةٍ","من اكتساها ففي التلبيس ما فرطا",39,"ط",2,0],["ثِيَابٌ تُرِيكَ الشّرَّ فِي شَرِّ صُورةٍ","وَتَكْسو مِنَ الأَدْوَاءِ أَفْتَكَها طُرّا",40,"ر",2,0],["ثيّبٌ في تصبّرٍ قد تراها","برداءٍ من عفةِ العذراء",41,"ا",2,0],["ثيرانه الهوجاء خلف خلاصنا","بُهُمٌ على طرق الوغى مستنفرة",42,"ر",2,0],["ثيبني يا خوي بأشواري","طار عقلي والحشا شله",43,"ل",2,0],["ثيابها قصرت حتى غدت مثلاً","لكل ثوب قبيح النسج ممقوت",44,"ت",1,0],["ثيابُ الريحِ تحملُ عطرَ روحي","اليكِ فتزدهي سحراً ودَلّا",45,"ل",2,0],["ثيابي «نخيلٌ» والقصائدُ موطني","وبعضي جحيمٌ في نعيميَ يرفل",46,"ل",1,0],["ثِيَابُ الذُّلِّ قَدْ بَلِيَتْ عَلَينَا","وَثُوبَ العِزِّ يَلْبَسُهُ جَدِيدَا",47,"د",2,0]]}