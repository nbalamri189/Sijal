{"poems":[[53,"ألمع برق أم ضرم","https://www.aldiwan.net/poem29820.html","مجزوء الرجز"],[0,"ألا إِن قوماً كنتم أمس دونهم","https://www.aldiwan.net/poem56.html","الطويل"],[43,"ثياب كريم ما يصون حسانها","https://www.aldiwan.net/poem10578.html","الطويل"],[28,"إن تك كلبا من كليب فإنني","https://www.aldiwan.net/poem5367.html","الطويل"],[69,"بهادر عبدي لا بهاء ولا در","https://www.aldiwan.net/poem28375.html","الطويل"],[48,"لي عرس حرة مملوكة","https://www.aldiwan.net/poem66232.html","الرمل"],[46,"ثيابي أكفاني ورمسي منزلي","https://www.aldiwan.net/poem22222.html","الطويل"]],"verses":[["ثِيابَ عارٍ أَبَداً","فَضفاضَةً عَلى القَدَم",0,"م",1,0],["ثِيابُ بَني عَوفٍ طَهارى نَقِيَّةٌ","وَأَوجُهُهُم عِندَ المُشاهِدِ غِرّانِ",1,"ن",1,0],["ثِيابُ كَريمٍ ما يَصونُ حِسانَها","إِذا نُشِرَت كانَ الهِباتُ صِوانَها",2,"ن",3,1],["ثِيابُ أَبي قابوسَ أَورَثَها اِبنَهُ","وَأَورَثَناها عَن مُلوكِ المَشارِقِ",3,"ق",1,0],["ثيابي وشاشي عندَهُ في إهانةٍ","وطرحٍ ولا طيَّ عناهُ ولا نَشْرُ",4,"ر",1,0],["ثيّبٌ بكرٌ ومالي حيلةٌ","ولها خمسُ بناتٍ في قَرن",5,"ن",1,0],["ثِيابِيَ أَكفاني وَرَمسِيَ مَنزِلي","وَعَيشي حِمامي وَالمَنِيَّةُ لِيَ بَعثُ",6,"ث",1,1]]}