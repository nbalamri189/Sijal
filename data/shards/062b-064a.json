{"poems":[[53,"ألمع برق أم ضرم","https://www.aldiwan.net/poem29820.html","مجزوء الرجز"],[0,"ألا إِن قوماً كنتم أمس دونهم","https://www.aldiwan.net/poem56.html","الطويل"],[43,"ثياب كريم ما يصون حسانها","https://www.aldiwan.net/poem10578.html","الطويل"],[28,"إن تك كلبا من كليب فإنني","https://www.aldiwan.net/poem5367.html","الطويل"],[69,"بهادر عبدي لا بهاء ولا در","https://www.aldiwan.net/poem28375.html","الطويل"],[48,"لي عرس حرة مملوكة","https://www.aldiwan.net/poem66232.html","الرمل"],[46,"ثيابي أكفاني ورمسي منزلي","https://www.aldiwan.net/poem22222.html","الطويل"],[179,"ثيبى أخاضارورة أشفق العدى","https://www.aldiwan.net/poem58747.html","الطويل"],[227,"ثياب الدمى البيض الحسان كثيرة","https://www.aldiwan.net/poem50880.html","الطويل"],[254,"فديت عز الدولة المرتجى","https://www.aldiwan.net/poem48357.html","السريع"],[302,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[362,"عهد هوى كنا عهدناه","https://www.aldiwan.net/poem60599.html","السريع"],[374,"أراك غني الفضل تنتهر البوسا","https://www.aldiwan.net/poem59381.html","الطويل"],[556,"هو الركبان والحادي","https://www.aldiwan.net/poem34630.html","مجزوء الوافر"]],"verses":[["ثِيابَ عارٍ أَبَداً","فَضفاضَةً عَلى القَدَم",0,"م",1,0],["ثِيابُ بَني عَوفٍ طَهارى نَقِيَّةٌ","وَأَوجُهُهُم عِندَ المُشاهِدِ غِرّانِ",1,"ن",1,0],["ثِيابُ كَريمٍ ما يَصونُ حِسانَها","إِذا نُشِرَت كانَ الهِباتُ صِوانَها",2,"ن",3,1],["ثِيابُ أَبي قابوسَ أَورَثَها اِبنَهُ","وَأَورَثَناها عَن مُلوكِ المَشارِقِ",3,"ق",1,0],["ثيابي وشاشي عندَهُ في إهانةٍ","وطرحٍ ولا طيَّ عناهُ ولا نَشْرُ",4,"ر",1,0],["ثيّبٌ بكرٌ ومالي حيلةٌ","ولها خمسُ بناتٍ في قَرن",5,"ن",1,0],["ثِيابِيَ أَكفاني وَرَمسِيَ مَنزِلي","وَعَيشي حِمامي وَالمَنِيَّةُ لِيَ بَعثُ",6,"ث",1,1],["َثِيبِى أَخاضارُورَةٍ أَشفَقَ العِدَى","عَلَيهِ وَقَلَّت فِى الصَّدِيقِ مَعاذِرُه",7,"ه",1,1],["ثيابُ الدُّمَى البيض الحسان كثيرةٌ","ولكنّني منهنّ أَبهى وأَجمل",8,"ل",1,1],["ثيابه في سفطي بيتها","وخبزه مأواه في ملتي",9,"ت",2,0],["ثياب وبنيان زروع ومصنع","وسجع وتصنيف وشعر وديوان",10,"ن",1,0],["ثيابُكمْ أحسَنُ ما أصبحَتْ","على سِواكمْ حينَ يُكساه",11,"ا",2,0],["ثيابهم سودٌ وبيضٌ فعالُهم","وحسّادهم صفرٌ وقد طَهُروا روسا",12,"س",2,0],["ثياب كلها يبدو","بها من خلف أضداد",13,"د",1,0]]}