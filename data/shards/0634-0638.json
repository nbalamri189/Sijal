{"poems":[[91,"لا تلحين المنايا","https://www.aldiwan.net/poem44786.html","المجتث"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43727","المتقارب"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25359","الرجز"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126188","الكامل"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33069","المنسرح"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72840","الخفيف"],[5111,"تُفَّاحَةُ المنْتَهَى","https://www.poetsgate.com/ViewPoem.aspx?id=212059",""],[5160,"غربة","https://www.poetsgate.com/ViewPoem.aspx?id=187477",""],[6189,"الريحانة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83581&r=&rc=48",""],[6228,"جسد واحد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85971&r=&rc=8",""]],"verses":[["شظية من بناء","الحياة بين الشظايا",0,"ا",3,0],["شَظَظتُكَ مِن أَزماتِ الزَمانِ","وَلكِن أَبى المَوتُ أَن يُشمَظا",1,"ظ",2,0],["شَظَّى العِدَا عَنْ خالِدٍ أُزامِ","أَو سِرتَ وَسطَ أَسدِكَ الطَغامِ",2,"م",1,0],["شظفٌ أصارفُ مقلتيك عن العلى","والسيفُ لا يرتدُّ عن هجماتهِ",3,"ت",2,0],["شَظى المَروُ مَنسَمَهُ","صَكّاً يُغَنّي الشَدوَ وَعوَعُهُ",4,"ع",2,0],["شظني بعدكم فظرفُ اصطباري","ما له بعدّ شقه من شظاظي",5,"ظ",2,0],["شظىً من النَّار إبراهيم تُحرقُني","قد آهتِ النّارُ يَا سِجِيّلُ يَكْفِينِي",6,"ن",2,0],["شظايا الرّوح قدْ طارتْ","فلمْ تُبْقِ لنا شيَّا",7,"ي",2,0],["شظايانا تطير بلا شظايا","فنصفُ بلاد أمتنا جيوب",8,"ب",1,0],["شظف العيش عليهم كله","ولنا في دورنا كل الرغد",9,"د",1,0]]}