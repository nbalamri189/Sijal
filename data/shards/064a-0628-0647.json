{"poems":[[90,"زهرة قد بدت من الأكمام","https://www.aldiwan.net/poem44428.html","الخفيف"],[47,"من قائل للزمان ما أربه","https://www.aldiwan.net/poem11054.html","المنسرح"],[47,"لك عهد لدي غير مضاع","https://www.aldiwan.net/poem64657.html","الخفيف"],[47,"يزداد في غي الصبا ولعه","https://www.aldiwan.net/poem64662.html","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54277","الخفيف"],[372,"راقه منها بياض ناصع","https://www.aldiwan.net/poem4619.html","الرمل"],[563,"يشرق النور بالمكان القصي","https://www.aldiwan.net/poem33531.html","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79871","الرمل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27949","السريع"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86351","الرمل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135123","الرجز"],[4767,"عقد عيد الميلاد","https://www.poetsgate.com/ViewPoem.aspx?id=214681",""],[4800,"العنيده","https://www.poetsgate.com/ViewPoem.aspx?id=104750",""],[4860,"لأول مره بكتبها","https://www.poetsgate.com/ViewPoem.aspx?id=32387",""],[5455,"يبه","https://www.poetsgate.com/ViewPoem.aspx?id=34696",""],[5525,"نور الصبايا","https://www.poetsgate.com/ViewPoem.aspx?id=7296",""],[5747,"إندماج الحي","https://www.poetsgate.com/ViewPoem.aspx?id=61657",""],[5956,"مُقَلُ النِّسوانْ ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182614",""],[5976,"قمراي","https://www.poetsgate.com/ViewPoem.aspx?id=30350",""],[4442,"قبلت خديه وهو نائم","https://www.poetsgate.com/ViewPoem.aspx?id=171022",""],[6100,"والدي","https://www.poetsgate.com/ViewPoem.aspx?id=52481",""],[5377,"من أحرار اليمن إلى أحرار العراق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79560&r=&rc=16",""],[6237,"وحشة قلب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77896&r=&rc=38",""]],"verses":[["يبهج النفس إذ يحرّك منها","وتر الشعر مطرب الأنغام",0,"م",1,0],["يُبهِجُ عُجمَ البِلادِ فَوزُهُمُ","بِهِ وَتَأسى لِفَوتِهِ عَرَبُه",1,"ب",2,0],["يُبهَتُ الوَفدُ في أَسِرَّةِ وَجهٍ","ساطِعِ الضَوءِ مُستَنيرِ الشُعاعِ",2,"ع",1,0],["يَبهى عَلى أَلحاظِ أَعيُنِهِم","مَرأىً يَزيدُ عَلَيهِ مُستَمَعُه",3,"ع",2,0],["يَبْهَرُ الصَّخرَ أنْ يَرَى منه صَلْداً","آدميَّ الرُّواءِن يَقْرَعُ صَلْدا",4,"د",2,0],["يَبْهَظُ المِفضَلَ مِن أَردَافِهَا","ضَفِرٌ أُردِفَ أَنقَاءَ ضَفِرْ",5,"ر",1,0],["يبهر العقل نوره المتجلي","فيزيل السوى بمحو الولي",6,"ي",1,0],["يَبهجَ العينَ ويجلو الكُرُبا","وإلى الغرب بهاءُ المشرق",7,"ق",1,0],["يبهر أربابَ الحجى بالغنى","ويبهر الناقلُ بالحابر",8,"ر",1,0],["يبهز الكندي في تنجيمه","وهو لا واللَه لم ينظر بزيج",9,"ج",1,0],["يبهر من يفتحه مستانساً","ان يكن الفتح بوهم لابسا",10,"س",2,0],["يُبهِجُ الأسماعَ لحناً","منه عزفاً تستزيد",11,"د",1,0],["يبهذلني وانا مابي جلاده","عنيد الشوق وآنا اكْبر عنيده",12,"د",2,0],["يبه وينك قِوى دهري علي وزادت أظروفي","تِجارت دنيتي ضدي..تهين النفس وتصفعها",13,"ع",3,0],["يبه معقوله ما ودك..يبه معقوله في شوفي؟!","بترحل قبل ماتحمل حلم بنتك وتسمعها",13,"ع",3,0],["يبه عيا اللقاء يلتم..يبه مكتوبه ما توفي","وعد قلته تربيني..وأنا ورده بمواجعها",13,"ع",3,0],["يبه وانا بعد اثنعش عام حسيت","اني قدرت اقول شيٍ كتمته",14,"ت",2,1],["يبه وانا من بعدك ابو التناهيت","مامر طعمٍ للحزن مانهمته",14,"ت",2,0],["يبه ( يبه ) كلمه وانا كل مااوحيت","كلمة ( يبه ) صديت والوقت لمته",14,"ت",2,0],["يبه ( يبه ) كلمه وانا كم تمنيت","اهدم بها وابني بها اللي هدمته",14,"ت",2,0],["يبه وانا لاضقت رحت وتهجيت","ركون بيتٍ ضم حلمٍ حلمته",14,"ت",2,0],["يبهج شبابه عثرته للعشاشيق","يضحك ..وأنا قلبي من الصد محروق",15,"ق",1,0],["يبهر صباح العشق كامل مزاياك","يتنفسك ملهوف لآخر سنينك",16,"ك",1,0],["يبهرني اللؤلؤ والمرجانْ","يبرقُ من مُقَلِ النِّسوانْ",17,"ن",1,1],["يبهرني أن ترنو العينان","بالصِّدْق الروحيِّ الفنّان",17,"ن",1,0],["يبهج حزين الحب يا مولاي","يجبر كسور الخاطر المحروم",18,"م",1,0],["يبهج أن عبث خطوب","فلا يرى منه وجه ساهم",19,"م",1,0],["( يبه ) كبر ( شبلك ) غدى اليوم رجال","( يبه ) وجرحه داخل الصدر ديره",20,"ر",2,1],["( يبه ) وانا اللي ما شكى يمك الحال","عجزت اشيل هموم صدري كبيره",20,"ر",2,0],["(يبه ) جذبني للعنا صوت الآمال","كن العنا يهدر عليّه هديره",20,"ر",2,0],["يبهرون الدنيا بزورة (موسكو)","وعليهم غبار دنيا ثمود",21,"د",1,0],["يبهر النفس عدْوها في سباقٍ","لفحُ أنفاسِه كلفحِ القذيفةْ",22,"ف",2,0]]}