{"poems":[[55,"هل ريع قلبك للخليط المنجد","https://www.aldiwan.net/poem30612.html","الكامل"],[93,"قالت سكت وما سكت سدى","https://www.aldiwan.net/poem8813.html","عموديه"],[87,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[68,"وحق من لا سواهم عندي القسم","https://www.aldiwan.net/poem39644.html","البسيط"],[107,"أرى فسادا وشرا ضاع بينهما","https://www.aldiwan.net/poem43139.html","البسيط"],[107,"سر يا أسامة ما لجيشك هازم","https://www.aldiwan.net/poem43570.html","الكامل"],[48,"يا أيها الناس جاز المدح قدركم","https://www.aldiwan.net/poem22281.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39659","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42564","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43747","البسيط"],[108,"صدى الجمهورية","https://www.poetsgate.com/ViewPoem.aspx?id=179586",""],[92,"اليأس المنشود","https://www.poetsgate.com/ViewPoem.aspx?id=179218",""],[214,"قالوا غدا العيد ماذا أنت لابسه","https://www.aldiwan.net/poem13363.html","البسيط"],[215,"تفننت في اغتيابي عصبة عجزت","https://www.aldiwan.net/poem46300.html","البسيط"],[240,"عصر الشباب تصرمت أوقاته","https://www.aldiwan.net/poem32134.html","الكامل"],[287,"ضربت لزينب بالغوير خيام","https://www.aldiwan.net/poem32462.html","الكامل"],[381,"حبيبتي دبي","https://www.aldiwan.net/poem965.html","عموديه"],[396,"قالوا غدا عيد ماذا أنت لابسه","https://www.aldiwan.net/poem54564.html","عموديه"],[415,"أتظن صبرك منجدا إن أنجدوا","https://www.aldiwan.net/poem32499.html","الكامل"],[463,"لعلهم لو وقفوا","https://www.aldiwan.net/poem56108.html","مجزوء الرجز"],[484,"سلمى بعيشك واصلي","https://www.aldiwan.net/poem36971.html","مجزوء الكامل"],[563,"قالوا غدا نأتي ديار الحمى","https://www.aldiwan.net/poem33856.html","السريع"],[591,"قالوا غدا يندم من لثمه","https://www.aldiwan.net/poem17519.html","السريع"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54040","الكامل"],[1115,"","https://poetry.dctabudhabi.ae/diwan/poem/138805",""],[1889,"","https://poetry.dctabudhabi.ae/diwan/poem/103210","البسيط"],[2868,"","https://poetry.dctabudhabi.ae/diwan/poem/101950","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200039","البسيط"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112486","البسيط"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127053","السريع"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114229","السريع"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94325","البسيط"],[4551,"","https://poetry.dctabudhabi.ae/diwan/poem/139860",""],[5007,"إنّهَا لا تَدْرِي...مَنْ يُخْبِرُهَا ؟","https://www.poetsgate.com/ViewPoem.aspx?id=142528",""],[5375,"قالوا غداً رمضان فاستعدّ تُقًى","https://www.poetsgate.com/ViewPoem.aspx?id=186859",""],[5442,"لا تسأمي يا ناق طول السري","https://www.poetsgate.com/ViewPoem.aspx?id=114730",""]],"verses":[["قالوا غَداً يَومُ النَوى فَتَسَلَّفوا","عَضّاً لِأَطرافِ البَنانِ عَلى غَدِ",0,"د",1,0],["قالوا غَداً تَهمي سَحائِبُنا","فَرَجَعتُ أَدراجي أَقولُ غَدا",1,"د",2,0],["قالوا غَزَوتَ وَرُسلُ اللَهِ ما بُعِثوا","لِقَتلِ نَفسٍ وَلا جاؤوا لِسَفكِ دَمِ",2,"م",1,0],["قالوا غَدا مُغرَماً طولَ الزَمانِ بِهِم","وَاللَهُ يَعلَمُ أَنّي مُغرَمٌ بِكُمُ",3,"م",1,0],["قالوا غَوَيتُم فَجِئناكُم لِنُرشِدَكُم","ثُمَّ الجَلاءُ فَما بَرّوا وَلا صَدَقوا",4,"ق",3,0],["قالوا غلامٌ للكتائبِ قائدٌ","وفتىً على الصَّيدِ الخضارمِ حَاكمُ",5,"م",1,0],["قالوا غَدَونَ مُصيباتِ الغِناءِ لَنا","وَتِلكَ عِندي مُصيباتٌ لَهُم فُدُحُ",6,"ح",1,0],["قالوا غدرتَ ولم أفهمْ لمنطقهم","حكماً ولكنما للقوم أحكامُ",7,"م",1,0],["قالُوا غَداً يَوْمُ الرَّحِيلِ وَمَنْ لَهُمْ","خَوْفَ التَّفَرُّقِ أَنْ أَعِيشَ إِلَى غَدِ",8,"د",1,0],["قالوا غَض الدَمعُ هَل رَدَّ البُكا وَلَدا","لثاكلٍ أَو أَباً برّ لِأَيتامِ",9,"م",1,0],["قالوا: غَدَتْ مصرُ جُمهوريَّةُ؛ فتَرَى","مقالُهم سَرَيانَ البُرْءِ في الجسدِ",10,"د",1,0],["قالوا \" غدٌ \" فَوَجَدتُ اليَومَ يفضُلُه","و\" الصبر \" قالوا : وكان الشَهمُ من جَزعاً",11,"ع",2,0],["قالوا غدا العيد ماذا أنت لابسه","فقلت قد حاكت الأسقام لي بدنا",12,"ن",2,1],["قالوا غوِيٌّ شديد الفتك منطلقٌ","إلى المآثم مغرى بابنة العنب",13,"ب",1,0],["قالوا غَزالُ نَقاً وَخوطُ أَراكَةٍ","ظَلَموهُ أَينَ صِفاتُها وَصِفاتُهُ",14,"ت",2,0],["قالوا غَداً يَومُ النَوى فَأَجَبتُهُم","لا بَل يُحَمُّ لَدى الفِراقِ حِمامُ",15,"م",1,0],["قالوا غَدَوْتِ عن ِالتّسديدِ عاجِزة ً","وأنتِ سَهْمُكِ في التسديدِ مَلْحَمَتي",16,"ت",2,0],["قالوا غدا عيد ماذا أنت لابسه","فقلتفقر وذل واعترافي كبير",17,"ر",1,1],["قالوا غَداً لِنَوى الأَحِبَّةِ موعدٌ","والدّهرُ أجمَعُ بعدَ لَيلَتِنَا غدُ",18,"د",1,0],["قالوا غداً وعدُ النوى","يا بردَها لو لم يفُوا",19,"ف",3,0],["قالوا غرامك قاتل","مرحى لحبّي القاتل",20,"ل",1,0],["قالوا غداً نأتي ديار الحمى","ديار من هم أهل سلمى همو",21,"م",2,1],["قَالُوا غَداً يَنْدَمُ مِنْ لَثْمِه","في ثَغْرِهِ إِذْ يَغْلِبُ السُّكْرُ",22,"ر",1,1],["قالوا غَدَا البَرَّانِ في غُلَّيْرَةٍ","في الوقت صَدْرَ صدورِها الأعْيانِ",23,"ن",1,1],["قالوا غرورا قد كان ما","وعد الله نبي الهدى بنصرته",24,"ت",2,0],["قالوا غَداةَ استقلَّت ما لمقلَتِهِ","أمِن قَذىً هَمَلَت أم عارها رَمَدُ",25,"د",1,0],["قالوا غداً نأت ديار الحمى","ديار من تهوى ونهواهم",26,"م",1,1],["قالوا غدا سنرى أشعارنا تحفا","في أعصر الذرة الملأى من الطرف",27,"ف",1,1],["قالوا غويٌّ شقيّ قلت يا عجبا","قد امتحنت بفجّار وفسّاق",28,"ق",1,0],["قالوا غداً نأتي ديار الحمى","حيا الحمى الغيث وحياهم",29,"م",1,1],["قَالُوا غَداً تَبدُو لَنَا طَيبَةٌ","أنجَادُهَا طَابَت وَأغوارُهَا",30,"ر",3,1],["قالوا غروراً بهِ نجمٌ لهُ غررٌ","وليس يدرون أن النجم غرّارُ",31,"ر",1,0],["قالوا غدا العيد ماذا أنت لابسه","فقلت خلعة ساق عبده جرعا",32,"ع",2,1],["قالوا غرابكَ يا مشؤومُ فانفجرت","من اليَرَاع حُروف الوجد أوزانا",33,"ن",2,0],["قالوا غداً رمضان فاستعدّ تُقًى","وتب على الصوم واهجر لذّة الكأس",34,"س",1,1],["قالوا غدا ندنو فواحسرتا","لو كان بالعمر غد يشترى",35,"ر",2,0]]}