"],[2365,"كلّ امرىء والموت يرقبه","https://www.poetsgate.com/ViewPoem.aspx?id=200643",""],[5324,"هي والربيع وموطني .","https://www.poetsgate.com/ViewPoem.aspx?id=207542",""],[5335,"طاح000طاح","https://www.poetsgate.com/ViewPoem.aspx?id=35190",""],[5776,"حَطَّابٌ كما تشتهي البُذور ....","https://www.poetsgate.com/ViewPoem.aspx?id=206899",""],[5843,"القدس","https://www.poetsgate.com/ViewPoem.aspx?id=51282",""],[5894,"كل الحواسد راعوا ما أنا فيه","https://www.poetsgate.com/ViewPoem.aspx?id=131407",""],[5895,"نقرتْ سهيدةُ","https://www.poetsgate.com/ViewPoem.aspx?id=198608",""],[5895,"قد أتت سلوى","https://www.poetsgate.com/ViewPoem.aspx?id=214162",""],[6004,"الخَطِيئة","https://www.poetsgate.com/ViewPoem.aspx?id=59138",""],[161,"بيْنَ السَّجؤينِ وخُطَّةِ السَّجَّانِ","https://www.poetsgate.com/ViewPoem.aspx?id=175319",""],[6075,"أرض الصمود","https://www.poetsgate.com/ViewPoem.aspx?id=190500",""],[6075,"وطن في عينيك","https://www.poetsgate.com/ViewPoem.aspx?id=195129",""],[6093,"شيطان صعدة","https://www.poetsgate.com/ViewPoem.aspx?id=198391",""],[6218,"عبير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65866&r=&rc=20",""],[6259,"نفسي الفداءُ للحظها من رام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59400&r=&rc=48",""],[6314,"جدارية عارية للبحر والجسد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88073&r=&rc=8",""],[6314,"غزل أحمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88066&r=&rc=1",""]],"verses":[["والحِلْمُ ليسَ يُبايِنُ الخُلُقَ الرِّضَى","والعِلْمُ ليسَ يُعارضُ النّاموسا",0,"س",2,0],["والحَلَّ والتّقْطيرَ والتّصْعيدَ والتْ","تَخْميرَ والتّصْويلَ والتّكليسا",0,"س",2,0],["والحلم لحظ أنتم أجفانه","والعلم قلب أنتم أنواره",1,"ر",2,0],["وَالحِلْمُ فيهِ سَجِيَّةٌ مَلَكِيَّةٌ","فَوقَ القِلَى وَالغلَّ وَالعُدْوَانِ",2,"ن",1,0],["والحلم يروِي جابرٌ عن فضله","والفضلُ يروِي عن يديهِ عطاء",3,"ا",2,0],["والحليمُ العليم من يُحسن الإي","قاد بدءاً ويحسن الإطفاءَ",4,"ا",2,0],["والحلمُ سمتٌ والعفاف طويَّةٌ","والبِر خِدنٌ والوفاء قرين",5,"ن",1,0],["والحل والدهن دور وهو إن عطفت","منه الأعالي على ما تحتها بدر",6,"ر",1,0],["وَالحِلمُ مِن خُلُقِ الكِرامِ وَكَم","نَزَقٍ بِهِ يَتَسَهَّلُ الصَعبُ",7,"ب",1,0],["وَالحَليُ في كُلِّ المَواطِنِ زينَةٌ","شَتّانَ جيدٌ عاطِلٌ وَمُطَوَّقُ",8,"ق",1,0],["وَالحِلمُ يَذهَبُ باطِلاً","إِلّا لِذي سَطَواتِ",9,"ت",1,0],["وَالحِلمُ صَبرُ أَخي عِزٍّ لِظالِمِهِ","حَتّى يَقولَ أُناسٌ ذَلَّ أَو قُمِرا",10,"ر",2,0],["وَالحِلمُ أَفضَلُ ناصِرٍ تَدعونَهُ","فَاِلزَمهُ يَكفِكَ قِلَّةَ الأَصارِ",11,"ر",1,0],["والحَلقاتِ المُتجوِّفاتِ","علامَةٌ للمتحرِّكاتِ",12,"ت",1,0],["والحلق التي عليها يُنْقطُ","تسكن أحياناً وحِيناً تَسقُطُ",12,"ط",1,0],["والحليب الذي رضعتم صغارا","كان من صدر معظم الفقراء",13,"ا",2,0],["والحلم أس والكمال بنية","رفعت على أركانه أعلامها",14,"م",3,0],["والحلم أرواح وكل زكية","ولع الكرام بصنعها أجسامها",14,"م",3,0],["والحلمُ أفضلُ ناصرٍ تَدعُونَهُ،","فالزَمْهُ يَكْفِكَ قِلّةَ الأنصار",15,"ر",1,0],["والحُللَ الخدَّاعة َ البوائدا","والكاعباتِ البيضَ والنواهدا",16,"د",2,0],["والحلم شيمتهُ فليس يقابل ال","جاني بغير الصفح والإغضاءِ",17,"ا",2,0],["والحلم طبع فلا كسب يجود به","لقوله خلق الإِنسان من عجل",18,"ل",1,0],["وَالحِلمُ في بَعضِ المَواطِنِ ذِلَّةٌ","فَاِصفَح وَعاقِب وَاِعجَلَن وَتَأَيَّدا",19,"د",2,0],["والحلم والعلم والأخبار ضائعة","والخير محتقر والشر مشتهر",20,"ر",1,0],["والحلم مثل الدوا مرّ مذاقته","وغبذه نافع والصبر سرّار",21,"ر",1,1],["والحلم شأنك والكريم","يجود حتى في الرقاب",22,"ب",1,0],["والحِلمُ أعظمُ ما يكو","ن إذا تعاظَمَت الخطِيّه",23,"ي",2,0],["وَالْحِلْمَ رَاسٍ طَوْدُهُ","وَقَصَائِدَ الإِرْشَادِ تُنْشَدْ",24,"د",1,0],["والحلم عند ذويه أكبر نعمة","ولدى سواهم قَدرُهُ مجهول",25,"ل",1,0],["والحلم يصحبك الخدين","وان نأى عنك الخدين",26,"ن",1,0],["والحلم حتى يظن الطائعون له","ان المبر لديه من عصى وجني",27,"ن",2,0],["والحلم فيك سجية وببعضه","قدراً توازن يذبلا وتوازى",28,"ز",2,0],["والحلم والعلم في حكم وفي حكم","يمحى به الشك أو تجلى بها الريب",29,"ب",1,0],["والحلمُ لذّتُه كَلذّةِ يَقظةٍ","إن زرتِ ديراً فاسألي القسِّيسا",30,"س",2,0],["وَالحِلمِ وَالعَفوِ اللَذَينِ شَذاهُما","مُتَضَوِّعٌ كَأَريجِ مِسكٍ أَذفَرِ",31,"ر",1,0],["وَالحَليم الَّذي يَرى المَوت أَحلى","مِن حَياة مَرَّت بِدار هَوانِ",32,"ن",1,0],["والحلم تخدُمُه القلوب مجيبةً","كم من يدٍ لك عندنا بيضاءَ",33,"ا",2,0],["وَالحلم وَالمَعروف مِنهُ","وَالمَكارم أَوسَع",34,"ع",1,0],["وَالحِلسُ ثُمَّ النافِسُ المُصيبُ","وَالمصفح المُشتَهر النَجيبُ",35,"ب",1,0],["والحِلُم من شَأني فإنْ شانَ امرُؤٌ","أدَباً بَحدَّتِهِ فحِلمي زانَهُ",36,"ه",1,0],["وَالحلم في بَعض المَواطن نقمة","تَسطو بِها أَبَداً عَلى الأَقوامِ",37,"م",1,0],["والحلم حتى لو وزنتَ حلمَهُ","إلى أبانَ لم يزنْ مثقالَه",38,"ل",2,0],["والحلم والبأس في سلْمٍ ومُعْتركٍ","ما بين مُصطلمٍ ضخمٍ ومُغْتفرِ",39,"ر",1,0],["والحلُّ عند أحمدْ","والله خيرُ مقصِدْ",40,"د",1,0],["والحُلْوُ والْمُرُّ في الشَّيْئَيْنِ مُحْتَجِبٌ","فإِنْ بَلَوْتَهُما لم يُجْهَلِ السَّبَبُ",41,"ب",1,0],["والحِلمُ تَعرِفُه البَريَّةُ دَأبُه","أما النِّدىُّ على النَّدى مَفطُورُ",42,"ر",1,0],["والحِلمِ بالعادةِ لا التَّعوُّدِ","وسَيِّدُ الأخلاقِ حِلمُ السَّيِّدِ",43,"د",1,0],["والحلم والجود فيه والعفاف وما","تحوى الكرام من الأخلاق والشيم",44,"م",1,0],["والحل ينبت في الأعضا موافقة","أما الحرام فعصيان وأرجاس",45,"س",1,0],["وَالحلم وَالشَرَف الرَفيع وَما بهِ","يَمتاز بَين الناس كُل خَطير",46,"ر",1,0],["وَالحلم غَض الطَرفَ عَن كُل امرئٍ","مُستوجب لعقاب عبدٍ جاني",47,"ن",2,0],["وَالحلم وَالمَعروف وَالعَفو الَّذي","مِن وَحشة يَهدي إِلى اِستئناس",48,"س",1,0],["والحلم روض خلقه نواره","والآخرون والرمث والقلام",49,"م",1,0],["والحلقِ المستديرِ من سَبَجٍ","على الجبين المَصُوغِ من دُرِّ",50,"ر",1,0],["وَالحِلمُ بَحراً لَقَد ماجَت مَراحِمهُ","وَكُن بِبَحرِ نَدى بِالجودِ فيّاحِ",51,"ح",1,0],["والحلمُ فضلُ القادرين على العدا","والعفوُ مرْقاةٌ إلى الجنَّاتِ",52,"ت",1,0],["والحلم من شيم الكرام وقلَّ مَنْ","يَبقى عليه في مضيق داهِ",53,"ه",1,0],["وَالحَلَقَ الماذِيَّ وَالمَغافِرا","والمَشْرَفِيَّ وَالقَنَا العَواتِرا",54,"ر",2,0],["والحليم الرشيد يخجله العت","ب ولا يخجل السفيه سبابه",55,"ب",2,0],["والحل بالجزء وبالعصب يرد","في وافر من البحور قد عهد",56,"د",1,0],["وَالحِلمُ أن أتبَعَ رُوَّادَ الخَنَى","أَو أَن يُرَى بِي دَقَعٌ لِرَهبَةٍ",57,"ه",1,0],["والحلم والتقوى ومح","ض الخير فى كل الأمور",58,"ر",1,0],["والحلمُ يولدُ فيما بينكم معكم","يا خِفَّةَ الطودِ لو في طِفلكم وُزِنا",59,"ن",2,0],["والحلُّ والعقد لو يورد صوابهما","إلاَّ الذي ثقة عن رأيه صدرا",60,"ر",2,0],["والحلو ألطف في هذا السبيل لما","ذاقا من الحلو بالمعنى وإن يسرا",61,"ر",2,0],["والحل ما بين الحواشي منهما","من كل ما يزيله قد سلما",62,"م",2,0],["والحليب الخاص بالرز استوى","فارتشفه واغن عن خمر الدنان",63,"ن",1,0],["والحِلمُ وهو حَياةٌ من مهالِكِه","لَمّا رأيت جُنودَ اللَهِ في الضَّرَب",64,"ب",1,0],["والحلم فينا الذي يعطي حقائقنا","الحلُّ والعقد والتليين والشدُّ",65,"د",1,0],["والحلى أصفى لؤلؤ وزبرجد","وكذاك أسورة من العقيان",66,"ن",1,0],["والحِلْمُ بَحْرٌ عِندَ سَاحتِهِ","ونداهُ مثل العَارمِ اللَّجِبِ",67,"ب",1,0],["والحلة الفيحاء لو قد علمت","سارَت باهليها اليك خضعا",68,"ع",2,0],["والحلْمَ من ميراثِ أَحْنَفَ خالِهِ","والبأْسَ من ميراثِ عَمْروٍ عَمِّهِ",69,"م",2,0],["وَالحَلقُ لِلِّحيَةِ مَع ضِيقِ السَلَب","يَعتَادُهُ أهلُ الضَلالِ وَالرِيَب",70,"ب",1,0],["والحلوُ والمزّ مع التَّفيّه","أَغْذِيَّةٌ جَيِّدَةُ الشَّبِيَّةُ",71,"ه",1,0],["والحلو منه يسْتحِيل مُسْرِعًا","مُلَزِّجًا مُسْتَجْلِيًا تَهَوُّعَا",71,"ع",2,0],["والحل بالكسر كسر النفس من حول","به الدراهم في حول من الحول",72,"ل",1,0],["والحلم يولِفك الأنامِ","والحمَق يَدعي حالك وحيد",73,"د",1,0],["والحلويّ احمد الخطيب","معهم وقبره قريب",74,"ب",1,0],["والحلم والصفح لهم ديدن","لا سيما عمن ترجاهم",75,"م",1,0],["والحلق للاحلال قطع كريمه","فغدا له قطع الكريم محللا",76,"ل",2,0],["والحِلمُ شِنشِنةُ الكريمِ ودُونَهُ","يأباهُ لكن بعدُ عجزٍ يَحلُمُ",77,"م",1,0],["وَالحلم فيهِ حَقائق","حُمدت وَكَم منها يُذَم",78,"م",1,0],["وَالحَليم الرَشيد مَن باتَ فيها","لَيسَ تَهوي بِعَقله الأَشياء",79,"ا",2,0],["والحلمَ منه فارزقنَّا أعدلهْ","والنصر منه فارزقنّا أفضلهْ",80,"ه",1,0],["والحلم في بعض المواضع سائغ","عذب وفي أخرى زعاف ناقع",81,"ع",1,0],["والحلم غر ابن الدويش وصنوه","ضيدان وابن بجاد شرزميل",82,"ل",1,0],["والحلم بعد الاقتدار وانه","عفوٌ الذُّ له من التنكيل",82,"ل",1,0],["والحلم غمد حسامه","إلا إذا ما شاء بترا",83,"ر",2,0],["والحلبه الحامضه مثل المدام","والشمس وقت الخريف فيها قليل",84,"ل",1,0],["والحلة الفيحاء فيها طينتي","دار بها أهل الندى والجود",85,"د",1,0],["والحلم يغني الفتى ما عاش عن نسب","فان هما اجتمعا فالفضل موفور",86,"ر",1,0],["والحلم طفل وعن ملاهيه مفطوم","والعجلة اطفالٍ تسابق على اوهام",87,"م",1,0],["وَالحِلُّ مَا حَلَّ اليَمِينَ وَمِثْلُهُ","حَرُمَ الّذِي قَدْ طَارَ فِي العَلْيَاءِ",88,"ا",2,0],["وَالحَلْفُ جَارٍ بِالرَّسُولِ وَنَحْوَهُ","حِلْفٌ بِرَأْسِ الأَهْلِ وَالآبَاءِ",88,"ا",2,0],["والحُلمُ مَا زَالَ انتِظَارًا, ومَا","أقسَى انتِظَارَ الحُلمِ إنْ شَمَّرَا",89,"ر",2,0],["والحلمُ أنت على مُثيرِ إشاعةٍ","كم كان ينشر ما يرى ويجول",90,"ل",1,0],["والحُلْمُ غادرَ أعيُني","مُذ غابَ عن اِبصارِها الأهلُ",91,"ل",1,0],["والحلي في الكف الأشل مضيع","وبهِ أنامل ذي المحاسن باهيه",92,"ي",2,0],["والحلمَ من أحنفٍ والعدلَ من عمرٍ","ومن عليٍ علوَّ الخيمِ والهممِ",93,"م",1,0],["وَالْحَلُّ أَصْبَحَ عِنْدَنَا","فِي الزَّارِ أَوْ فِي الْمَبْخَرَة",94,"ر",2,0],["( والحلق غصّ مراراً )","فكيفْ تضحكُ سِنّي !؟",95,"ن",2,0],["والحلم والعلم والارشاد سيمته","والبر خلق فكم احياء لاحياء",96,"ا",2,0],["وَالْحِلْمُ صُنْوُ الصَّبْرِ فيْكِ تَعانَقا","بَزَّ النِّساءَ بِجَمْعِها عِطْفاكِ",97,"ك",1,0],["والحلم والحبكہ وكلمة قايد","والزهد واصل الجود ذا مبدأ له",98,"ل",2,0],["والحلمُ قيدٌ فدعه واخطُ في مَرَحٍ","والجدُّ داءٌ فداوِ النفسَ باللعب",99,"ب",1,0],["والحُلْمُ رَفْرَفَ فِي السَّمَاءِ لِرَقْصَةِ","الصُّبْحِ الْوَدِيعِ ، وَهَلَّلَ الإشْراقُ",100,"ق",1,0],["وَ الْحُلْمُ تَأْشِيرَتِي لِلْآهِ،نَافِذَتِي","مِنْهَا أُطِلُّ عَلَى الذِّكْرَى،وَ أَعْتَبِرُ",101,"ر",1,0],["والحلم حلمك لا الذي يروونه","عن أحنفٍ ما العين كالمظنون",102,"ن",1,0],["والحلّ والعقد في الدنيا بأجمعها","بحكمه ملي التأييد والظفرا",103,"ر",2,0],["والحلم أن يغضي عن شاتم","حتى كأنّ الشتم لا يغضبه",104,"ب",2,0],["والحلوةً الأنبارً تسدل شعرها","ليلا يهدهدُ للفراتِ هجوعا",105,"ع",2,0],["والحلم ودع جفون النوم والنوم راح","واحلى المواعيد خلتني على بالها",106,"ل",3,0],["والحلمُ يبزغُ ثانيًا","من دون حطاب وفأس",107,"س",1,0],["والحلم يرعى بصدرك يالشعوب شعوب واسياد","وانا لو احلمك من ينصرك يامسرى النبوه",108,"و",2,0],["والحلم طبيعي ولكن لست ألزمه","مع اللئام فإن اللؤم برد به",109,"ه",1,0],["والحُلْمُ بُدِّدَ فِى السَّرابِ كَأَنَّهُ","طَيْفُ السُّهَادِ مُحَمَّلاً أَوْجَاعَا",110,"ع",2,0],["وَالحُلْمُ مَطْرُوحُ عَلَى رَمَقٍ","وَالرُّوحُ فِى َأطْيَافِهِ نَشْوَى",111,"و",2,0],["وَالحُلْمُ يَشدُو بينَ أَهدَابِ المُنَى","وَالعَدلُ مِثلُ النُّور يسرِي زَاهِيَا",112,"ي",2,0],["35- والحُلْمُ كَان على جَنَاحَيْ طَائِرٍ","لَمَّا انْطَوَى ، أَمْسَى مِنْ الْهَذَيَانِ",113,"ن",1,0],["وَالْحُلْمُ بَاتَ عَلَى وِسَادَةِ ضَعْفِنَا","يَشْكُو الطُّغَاةَ وَقَسْوَةَ النِّيرَانِ",114,"ن",1,0],["وَالْحُلْمُ فِي قَيْدِهِ الْمَشْؤُومِ مُنْتَحِبًا.",". بِاللَّهِ لَا تٌغْمِضِي عَيْنَيكِ مَوْلَاتِي",115,"ت",2,0],["والحلم ينفع في الكرام وضده","يجدي مع الأوغاد والأنجاس",116,"س",1,0],["والحُلْمُ أسطولٌ يسافر في الندى","خلف الصباحِ، ولا يعودُ سفيرُ",117,"ر",1,0],["والحِلم في بعض المواطن نعمة ٌ","تسطو بها أبداً على الأقوام",118,"م",1,0],["والحلمتان أكاد أسمع همسها","صبي عليَّ عذابها يا عاصيةْ",119,"ي",2,0],["والحلمتان ك(قامةٍ علمية)","لا تنحني لمدارس (الكُتَّابِ)",120,"ب",1,0]]}