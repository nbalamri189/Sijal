s://www.poetsgate.com/ViewPoem.aspx?id=156449",""],[5277,"سحابةُ القلقِ","https://www.poetsgate.com/ViewPoem.aspx?id=206887",""],[307,"جاهدتُ دهري للحروف وصولا","https://www.poetsgate.com/ViewPoem.aspx?id=213776",""],[5344,"ان شفت طبع البشر كدرك..","https://www.poetsgate.com/ViewPoem.aspx?id=183174",""],[5370,"مشية العسكري","https://www.poetsgate.com/ViewPoem.aspx?id=87424",""],[5431,"أعيذك الشوق أن يكبو بمولاه","https://www.poetsgate.com/ViewPoem.aspx?id=197544",""],[5573,"ياسابح الفكر","https://www.poetsgate.com/ViewPoem.aspx?id=200177",""],[5652,"أجر التصدق ؟","https://www.poetsgate.com/ViewPoem.aspx?id=177801",""],[3856,"وغَرِقنَا حِينَ طِرنَا؛ عِندَما","https://www.poetsgate.com/ViewPoem.aspx?id=215912",""],[5815,"وصية الرحيل الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=200044",""],[5829,"الحبيب الأول","https://www.poetsgate.com/ViewPoem.aspx?id=211051",""],[5842,"إشراقات الأمل / محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=105051",""],[5894,"جاءت بوجه بديع الحسن في الدجج","https://www.poetsgate.com/ViewPoem.aspx?id=131414",""],[5944,"عنيدة","https://www.poetsgate.com/ViewPoem.aspx?id=213101",""],[5956,"حَسَبُ الإنسان لا نَسَبُه","https://www.poetsgate.com/ViewPoem.aspx?id=184369",""],[5970,"أيها النائحون خلوا نواحا","https://www.poetsgate.com/ViewPoem.aspx?id=130607",""],[5970,"سر هذا الدهر قد أعيا طلابي","https://www.poetsgate.com/ViewPoem.aspx?id=130576",""],[6093,"الهاربة إلى المجهول","https://www.poetsgate.com/ViewPoem.aspx?id=202107",""],[6113,"ابعدي يابنت","https://www.poetsgate.com/ViewPoem.aspx?id=14418",""],[5309,"جاهل الحق بالتعصب فاخر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573784",""]],"verses":[["جاهَدتَ دينَ الكُفْرِ حتّى سِمْتَهُ","خَسْفاً ورامَ السَّلْمَ منْكَ عَنيدُهُ",0,"د",2,0],["جاهَدتَ في اللَهِ وَالأَوطانِ مُحتَسِبا","فَاِرجِع إِلى اللَهِ مَأجوراً وَفُز وَطِبِ",1,"ب",1,0],["جاهَدتَ في تَفضيلِهِ","وَوَصَلتَ لَيلَكَ بِالنَهارِ",2,"ر",1,0],["جاه تولى الحمد إحصاءه","فضاق عنه في الحساب العدد",3,"د",1,0],["جاهك ما في الجاه ند له","وذكرك النابه في الذكر",4,"ر",1,0],["جاهدت صرف الدهر دون نموهم","فغلبته والدهر غير ركيك",5,"ك",1,0],["جَاهِلَةً مَا فِي قلوبِ الأُولى","تَأْمَنُهُمْ مِنْ شِيمَةٍ غَادِرَهْ",6,"ر",2,0],["جَاهِدْ عَدُوَّكَ مَا اسْتَطَعْتَ جِهَادَهُ","أَمَّا أَخَاكَ فَمَا اسْتَطَعْتَ فَسَالِمِ",7,"م",1,0],["جاهاً ومالاً كما عوّدتَ من قدمٍ","إنسانَ من لم يكن من قبلُ مذكورا",8,"ر",2,0],["جاهٌ تُرمِّمُهُ ودُبْ","رٌ تبتغي أبداً خَرابهْ",9,"ب",2,0],["جاهرْ به المُلْكَ والملوكَ معاً","ولا تُسَتّرْهُ خوف مُنْتَهكهْ",10,"ك",2,0],["جاهليٌّ كما علمتَ ولكِنْ","لا تراه يعاملُ الجُهَّالا",11,"ل",2,0],["جاهِلٌ مَن حَسِبَ الآتي يَدوم","أَحمَقٌ مَن حَسِبَ الماضي يَعود",12,"د",1,0],["جاهك الجاه","والرعاية غال",13,"ل",1,0],["جاهَدتَ في الرَّحمَنِ حَقَّ جِهادِهِ","وجَرَى المُلوكُ كما جَرَيتَ فقصَّروا",14,"ر",3,0],["جاهَدتَ فيهِ المالَ عَن حَوبائِهِ","وَالمالُ لَيسَ جِهادُهُ كَجِهادِ",15,"د",1,0],["جاهِدِ القومَ وزَلزِلْ دِينَهُمْ","أينَ دِينُ الكُفرِ من دينِ الهُدَى",16,"د",2,0],["جَاهدْتَ في اللَّهِ تُرضيهِ وتنصُره","لم تَلْقَ من سَأَمٍ يوماً ولا مللِ",17,"ل",1,0],["جاهليٌّ زلَّ في إسلامهِ","فَهَوَى من بعد ما كان صعد",18,"د",1,0],["جاهَدتَ في تَمهيدِ حِمصٍ راحِلاً","عَنها وَزِنتَ فِنائَها فِناءَها",19,"ه",2,1],["جاهُ حُسنٍ ما رُدِدتُ بِهِ","وَشَفيعٌ قَطُّ ما خابا",20,"ب",2,0],["جاهُ النبيِّ لِكُلِّ عاصٍ واسِعٌ","والفضلُ أَجدرُ باقتراحِ المُجتَدِي",21,"د",2,0],["جاهَدْتَ في اللهِ أبْطالَ الضَّلاَلِ إِلى","أَنْ ظَلَّ لِلشِّرْكِ بالتَّوحِيدِ تَبْطِيلُ",22,"ل",1,0],["جاهَرَ الناسَ بِما يَأ","تيهِ في ضَنكٍ وَضيقِ",23,"ق",1,0],["جاهِر بنفسِكَ واهتك السترا","واخلع عذاركَ في الهوى جهرا",24,"ر",2,1],["جَاهَدْتِ صَرْفَ الدَّهْرِ دُونَ نُمُوِّهِمْ","فَأَلَنْتِ مِنْهُ وَلَمْ يَكَنْ بِرَكِيْكِ",25,"ك",1,0],["جَاهَدْتِ لَكِنَّ النَّجَاحَ الَّذِي","أَدْرَكْتِهِ أَغْلَى مِنَ النَّصْرِ",26,"ر",1,0],["جاهرْ بنُبْلك في الزما","نِ فحقُّ مثلِكَ أَنْ يجاهرْ",27,"ر",1,0],["جاه خلقناه من ألوان قدرتنا","فكيف بكفر فينا من خلقناه",28,"ا",2,0],["جاهه العالي ملاذي ابدا","انما الوالد يحمي للولد",29,"د",1,0],["جاهدتم في اللَه حق جهاده","ونهضتم الرجفانِ والخفقانِ",30,"ن",1,0],["جَاهَدْتُ بِالصَّبْرِ في إِثْرِ العَزاءِ فَمَا","رَجَعْتُ إِلا وَصَبْرِي عَنْكِ مَفْقُودُ",31,"د",1,0],["جاهدا تُقْدم حتى رَدَّه","حَزْمُك الثَّبْتُ لأَعْلَى مَنْصِب",32,"ب",1,0],["جاهِلٌ يَجهَلُ القِراءَةَ في الأَسفارِ","لكِنَّهُ حَكيمٌ بِفَأسِهِ",33,"ه",1,0],["جاهَدتَ جُهد البَطل الصابِر","فَهَل لعشاقك أَن يعضدوك",34,"ك",1,0],["جاهد الجاحدين حتى أنابوا","واستكانوا كالأنف المخشوش",35,"ش",1,0],["جاهُ الأمانةِ عُقبَاهُ السُّرور كما","جاهُ الخيانة عُقبى أمره النَّدَمُ",36,"م",1,0],["جاهلاً فارَقتُ حيّاً آهلاً","بأحبّائي فلم آنس بحَي",37,"ي",1,0],["جاهدوا بالنفوس والمال حتى","بلغوا ذروة السماك العالي",38,"ل",2,0],["جاهدت في ثغره عذولي","في حال جد أو انبساط",39,"ط",1,1],["جاهليّ يحيا وقد نقد الده","ر كما عاش في المتاهات سام",40,"م",1,0],["جاهليون قدسوا جاهليين سعوا","نحو غاية اللاشي",41,"ي",1,0],["جاهُك ذا المَقْسومُ بينَ الوَرى","تُراه ما لي فيه من قِسْط",42,"ط",1,0],["جاهَدتَ في مولاك حَقّ جهادِه","تبغي رضا المتَفضّلِ المنّانِ",43,"ن",1,0],["جَاهِرْ بوَجْدِك واعصِ اللاّئِمين وَبُحْ","بِحُبّهم إنَّ كتْمَان الهَوى تَلَفُ",44,"ف",1,0],["جاهدت فيهم لوم كلّ مفند","لو أنَّ لي في الحبِّ أجرَ مجاهد",45,"د",1,0],["جاهلٌ ولّد فيه عالِماً","عندَه قام الدليلُ الأوضحُ",46,"ح",1,0],["جاهُهُ شفْعُ مالِه فهو وَتْرٌ","يقتضينا من حالتَيْهِ اقتراحا",47,"ح",2,0],["جاهَرْتَ حُرَّ بلادِهِم بجهادِهِمْ","حَتَّى غَدَوْا وهُمُ لَهَا أَسرارُ",48,"ر",1,0],["جاهدتُ فيك بقولي يوم تختصم ال","أبطالُ إذ فات سيفي يومَ تمتصِعُ",49,"ع",1,0],["جاهرتُ فيكم بالعداوةِ مَنْ","تُخشَى العداوةُ منه في السِّرِّ",50,"ر",1,0],["جاهدنني فرددتها بمؤيَّدٍ","لله صدقُ تقاته وجهاده",51,"د",2,0],["جاهل بالطبع لذته","لذة الثيران والنَعَم",52,"م",1,0],["جاهل كل من رأى","أن شيئا تحركا",53,"ك",2,1],["جاهدي فيه به واجتهدي","واتركي الأوهام بل والفِكَرا",54,"ر",2,0],["جاهدت فوق المستطاع فلم يفد","جهدي وقد حل القضاء حلولا",55,"ل",2,0],["جاهدت خير جهاد لم يقم بطل","به ولو كان أعُطي فسحة الاجل",56,"ل",1,0],["جاهدت فيها وكم أحسنت من عمل","لك اغتدى عند رب الكون مذّخرا",57,"ر",2,0],["جاهَدتَ عُمرَكَ ثُمَّ مُتَّ مُغَرَّباً","فَغَدَوتَ مِن كُلِّ الجِهاتِ شَهيدا",58,"د",2,0],["جاهَدتَ نِصفَ العُمرِ في أَرجائِها","عِلماً وَنِصفاً في الغُروبِ شَريدا",58,"د",2,0],["جاهٌ وَألطافٌ رَفَعتَ بِفِعِلِها","حالي وَحسبُكَ بِارتِفاعِ الحالِ",59,"ل",1,0],["جاهِد بِربِّك أو جاهِد بنفسِك أو","جاهد ببالِغ إخوانٍ وأولاد",60,"د",1,0],["جاهاً إلَى اللهِ الكَريمِ ذَخرّتُهُ","لِعُدُوِّ سُلطانٍ إلَى سُلطانِ",61,"ن",1,0],["جاهد بآلك واعلم أنهم فئةٌ","أثفيةٌ يتوقَّى وقعها الوتدُ",62,"د",1,0],["جاهدٌ يلمظ الأصابعَ والضي","فُ يَراه إلى الطعام مُشيرا",63,"ر",2,0],["جاهلي الهوى فلما دعاه","مرسل الصدغ للصبابة أسلم",64,"م",1,0],["جاهدوا الدهر باليقين وبالآ","مالِ والعزمِ والقلوب الصلاب",65,"ب",1,0],["جاهدتُ فيه طيِّب العقبى وبي","مما أجاهدُ رقةٌ ونحول",66,"ل",1,0],["جاهرت بالنجوى كما أنا شاعر","ولبست ثوب الفاتحين المُعْلَما",67,"م",2,0],["جاهي بِلا مَنصِبٍ جاهي يُصاحِبهُ","وَالشّمسُ لا برجُ عين الشّمسِ في الحَملِ",68,"ل",1,0],["جاهَدتَ للَّهِ في قَومٍ غَوَوا وَعَموا","عَن رُؤيَةِ الحقِّ ذي الإِصباحِ وَالبلجِ",69,"ج",1,0],["جاهُم مَلِك جَزع مِن توت","لا لَهُ وَلا للكَرامَه",70,"ه",1,0],["جاهم بِشُعلة مِن النار","يَخطف بِها كُلّ سارح",70,"ح",1,0],["جاهدِ الكافرين واغلُظْ عليهم","واجعلنهم لمن يُعاديكَ وعظا",71,"ظ",2,0],["جاهدت جهدي في سبيل صلاحهم","ورضيت منهم بالمطيع الواف",72,"ف",1,0],["جَاهِلٍ لَمْ يَدْرِ أنِّي","لَمْ أكُنْ أعْرِفُ أنَّهْ",73,"ن",2,0],["جاهِلٌ غَيرَ أَديبِ","وَهوَ عَونٌ لِلأَديبِ",74,"ب",1,0],["جاهدَ أَو أَبْحَرَ أَو صامَ أَو","صرَّف أَوْ هَلَّلَ أَو كَبَّرَا",75,"ر",2,0],["جاهدت في أعلاء مصرك جاهداً","حتى قضيت لها شهيد جهاد",76,"د",1,0],["جاهدتُ صَرف زماني في مَغيبهما","حَولاً وهذا أَوان النّصر والظَّفَرِ",77,"ر",1,0],["جاهل ومتغَرّب ومِصْطاب","للحب ما عندي تراتيب",78,"ب",1,0],["جاهدت خير جهادٍ فاسترح وكفى","ما كنت في هذه الدّنيا تعانيه",79,"ي",2,0],["جاهَدَ المشركينَ بالسيفِ حتى","دمَّرَ الحقَّ دولةَ الأوثانِ",80,"ن",1,0],["جاهدَ المشركين حتى هداهم","وأبيدت عبادةُ الأوثانِ",80,"ن",1,0],["جاهدوا طائعينَ أمرَ نَبيٍّ","كم تفانت في حُبِّهِ أتقياء",81,"ا",2,0],["جاه الهوى فاستشعروه عاره","ولعبه فاستعذبوه أواره",82,"ر",2,1],["جاهدتَ حَقَّ جهادٍ في رضاه إلى","أن أَشْرَقَ الدّينُ في سهل وفي جبل",83,"ل",1,0],["جاه عقب الوسْميِ العَلّي","والثرى ما حَفّ من بونه",84,"ن",2,0],["جاهد النَّفس جاهداً فإذا ما","فَنِيت عَنكَ فهي عينُ الوجودِ",85,"د",1,1],["جاهي بجاوَه وسُهَيلِي يا فَتَى","شُمُطرَةٌ فَكُن لذا مُلتَفِتَا",86,"ت",2,0],["جَاهِيَّهُم جزيرةٌ فيها شَجَر","وَالنارَجِيل كثيرُ خُذ مِنِّي الخَبَر",87,"ر",1,0],["جاهِدهُمُ إِن كُنتَ عَبداً مُؤمِناً","إِنَّ الدِّفاعَ عَنِ الشَّريعَةِ حُتِّما",88,"م",2,0],["جاهِد وَصَلِّ مَعَ الأَئِمَّةِ كُلِّهم","وَاِسمَع لَهُم وَلِأَمرِ كُلِّ مُؤَمَّرِ",89,"ر",1,0],["جاهَدَ الكُفّارَ إِذ هَزَّ لَهُم","رُمحَهُ اللَذ في مَضاهُ ما اِنثَنى",90,"ن",2,0],["جاهدْ لحرية يحلو الشقاء بها","ودع نعيماً به يستمتع الخدمُ",91,"م",1,1],["جاهدت للحق في يراع","لا يعرف الكذب والرياء",92,"ا",2,0],["جاهه يُرتَجى لِكُل عَظيم","وَأَنا في العِباد أَول راج",93,"ج",1,0],["جاهدت في الله تيجاناً قد انعقدت","على المظالم حتى انحل ما عقدوا",94,"د",3,0],["جاهدت في الملك تحميه وتحفظه","جهاد طه مع الانصار في أُحد",95,"د",1,0],["جاهدتُ لا أبغي الثراءَ وإِنّما","فخر البلاد وعزّها ما أطلبُ",96,"ب",1,0],["جاهدَ في اللَهِ عداهُ مخلِصا","وقَد أطاعَ ربّهُ وما عَصى",97,"ص",2,0],["جاه متى وافيته نلت المنى","وأمنت سوء الحاسد العضّاه",98,"ه",1,0],["جاهد دون الأَوطان حَتّى","أَصبَحَ شلواً بِها حَطيما",99,"م",2,0],["جاهل الأشياء أعمى","لا يرى حيث يدور",100,"ر",1,0],["جاهُكَ فوقَ العبْدِ ظِلٌّ ومِنْ","بُعْدِكَ جمرُ الوَجْدِ قد أُضْرِما",101,"م",2,0],["جاهدت بين يديه فوقت","ثم أحساباً واعراضا صحاحا",102,"ح",2,0],["جاهدت في الدنيا جهاد مثابر","لا يبتغي أجراً ولا هو يفرق",103,"ق",1,0],["جاهدت إن جهاد مثلك في العلى","مثل لالسنة الرواة رسيلُ",104,"ل",1,0],["جاهد بدنياك جاهد","ما فاز إلا المجاهد",105,"د",1,1],["جاهدت حتى اكتسى البيت الحرام منى","وصلت حتى حويت النصر والغلبا",106,"ب",2,0],["جاهدتني فيه العواذل حتى","خلتهم ألبوا علي نقيرا",107,"ر",2,0],["جاه عريض وكف بالندى وكفت","جودا فراحت بأوجاع وأوجال",108,"ل",1,0],["جاه عريض