em/54710","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43920","المتدارك"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43849","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43818","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54225","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54315","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54299","الخفيف"],[106,"زمزم طليعة الأسطول المصري","https://www.poetsgate.com/ViewPoem.aspx?id=179646",""],[106,"حفظ الله صالحًا","https://www.poetsgate.com/ViewPoem.aspx?id=179358",""],[106,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[78,"صنع الريح من الماء زرد","https://www.poetsgate.com/ViewPoem.aspx?id=8986",""],[96,"راكبة الدراجة","https://www.poetsgate.com/ViewPoem.aspx?id=15719",""],[90,"وادي العرائش","https://www.poetsgate.com/ViewPoem.aspx?id=179145",""],[90,"الريف الضاحك","https://www.poetsgate.com/ViewPoem.aspx?id=179018",""],[5,"معلقة عمرو بن كلثوم","https://www.poetsgate.com/ViewPoem.aspx?id=11411",""],[91,"بين الكأس والطاس","https://www.poetsgate.com/ViewPoem.aspx?id=53236",""],[28,"ألَمْ يَأتِ بالشّأمِ الخَليفَةَ أنّنَا","https://www.poetsgate.com/ViewPoem.aspx?id=16947",""],[51,"لم أتخذ منك غير متخَذِ","https://www.poetsgate.com/ViewPoem.aspx?id=28614",""]],"verses":[["صَنَعتَ فَتَمَّمتَ حُسنَ الصَنيعِ","وَكَم صانِعٍ لا يَرُبُّ اِصطِناعا",0,"ع",2,0],["صَنيعاً لا يَجُرُّ عَلَيكَ مَنّاً","وَحِملُ المَنِّ غَيرُ المُستَطاعِ",1,"ع",1,0],["صَنَعٌ بِلينِ حَديثِها","فَدَنَت عُرى أَسبابِها",2,"ب",3,0],["صَنَعتُنَّ ما يُعيي الرِجالَ صَنيعُهُ","فَزِدتُنَّ في الخَيراتِ وَالبَرَكاتِ",3,"ت",1,0],["صَنَعاً يُصَوِّرُ في الفُصو","صِ لَدى الفَراعِنَةِ الكِبارِ",4,"ر",1,0],["صَنَعُ الضَميرِ إِذا أَجالَ بِمُهرَقٍ","يُمناهُ في مَهَلٍ وَفي إيشاكِ",5,"ك",1,0],["صِنْوَانِ إنْ يَكُ حَالَ البَيْنُ بِيْنَهُمَا","فَقَدْ زَكَا بِمَكَانِ الأوَّلِ الثَّاني",6,"ن",2,0],["صنيعٌ تولّى الله تشييد فخره","وكان لما أوليت فيه مجازيا",7,"ي",2,0],["صَنَعَ الحَديدَ لِحِفظِهِ أَسرادَهُ","لِيَنالَ طولَ العَيشِ غَيرَ مَرومِ",8,"م",1,0],["صَنائِعُ فاقَ صانِعُها فَفاقَت","وَغَرسٌ طابَ غارِسُهُ فَطابا",9,"ب",2,0],["صنت كفي عن الأنامِ ولفظي","فحرامٌ نداهُم وثنائي",10,"ا",2,0],["صناعةُ النظم تجنَّبتها","وذاك يا منيتي الواجب",11,"ب",1,1],["صنتني عن أذى الزَّمانِ وقد حا","ول حربي واستكبر استكبارا",12,"ر",2,0],["صنَّفت شجوناً بغزّال جفن","فقرأنا مصنّفاً للغزال",13,"ل",1,0],["صنيعٌ مَريشٌ قوَّم القَيْنُ متنَه","فجاء كما سُلَّ النخاع من الصُّلْبِ",14,"ب",1,0],["صُنهُ عن العنف إن مَغمزَهُ","من عودِك اللدن لا من الصخرِ",15,"ر",1,0],["صنيعةِ خابِرٍ صَنِعٍ مُجيدٍ","أخي علمٍ بصنعتها مُحيط",16,"ط",1,0],["صن مديحي ومطلبي عن أناس","لم أزل عن لقائهم صدّافا",17,"ف",2,0],["صنع والٍ يمسي ويصبح مصبو","حاً بإتعاب جسمه مغبوقا",18,"ق",2,0],["صُنْ مَنْ يصونك عن ثُقل تُحمله","يَزِدْكَ صوناً ويحملْ عنك أثقالا",19,"ل",2,0],["صُنْ عرضَ عبدكِ أن يُذالَ فإنه","ما كان قطُّ لبِذلةٍ منديلا",20,"ل",2,0],["صُنْ وجهَ عبدك عن سؤال معاشرٍ","ألفاهُمُ شرَّ البريةِ حِيلا",20,"ل",2,0],["صنتُ مالي عن الفسادِ بمالي","حان لي أن أصونَ مالي بمالي",21,"ل",2,0],["صنتُ نفساً أذلتَ في العُرف منها","لا عدِمناك من مصونٍ مُذالِ",22,"ل",1,0],["صنتَ نفساً أذلتْ في المجد منها","لا عدمناك من مصونٍ مذالِ",23,"ل",1,0],["صنيعةَ قوَّالٍ بفضلكَ صادعٍ","وفي كل وادٍ لامتداحك هائمِ",24,"م",1,0],["صنائعُ في الصنائع سيداتٌ","صنائع من سواه لهن آمُ",25,"م",1,0],["صَنَّعَها خالقُها","للصفعِ من كل جِهَهْ",26,"ه",2,0],["صَنَمٌ في خَدِّهِ النارُ وَفي","كَفِّهِ ضَرَّتُها تَضطَرِمُ",27,"م",1,0],["صَنَمٍ لَعَمرُكَ ما بَراهُ اللَهُ في","ذا الحُسنِ إِلاّ فِتنَةً لِعِبادِهِ",28,"د",2,0],["صَنَعَ الريحُ من الماءِ زَرَد","أَيُّ درعٍ لقتالٍ لو جمدْ",29,"د",1,1],["صنع إسماعيل جلت يده","كل بنيان على الباني دليل",30,"ل",1,0],["صَنعَةٌ تُدهِشُ العُقولَ وَفَنٌّ","كانَ إِتقانُهُ عَلى القَومِ فَرضا",31,"ض",2,0],["صَنعَةُ الداخِلِ المُبارَكِ في الغَر","بِ وَآلٍ لَهُ مَيامينَ شُمسِ",32,"س",1,0],["صُنْتُ عن أَكْثَرِي هَواهُ فما يَعْ","لَمُ ما بي إلاَّ فُؤادي وطَرْفي",33,"ي",1,0],["صِنْوانِ هذا مُنْذِرٌ","وافَى وَذَا هادٍ أَتَى",34,"ت",2,0],["صُنّا قَوائِمَها عَنهُم فَما وَقَعَت","مَواقِعَ اللُؤمِ في الأَيدي وَلا الكَزَمِ",35,"م",1,0],["صنوان ضدان أب واحد","رباهما في الزمن الذاهبِ",36,"ب",1,1],["صنوان من واحد إذا امتزجا","في البحر حازا أكرم الفعلِ",37,"ل",1,0],["صُنتَني عَن مَعاشِرٍ لا يُسَمّى","أَوَّلوهُم إِلّا غَداةَ سِبابِ",38,"ب",1,0],["صُنتُ نَفسي عَمّا يُدَنِّسُ نَفسي","وَتَرَفَّعتُ عَن جَدا كُلِّ جِبسِ",39,"س",1,1],["صَناديدُ يَلقَونَ الأَسِنَّةَ حُسَّراً","رِجالاً وَيَخشَونَ المَذَلَّةَ دُرَّعا",40,"ع",2,0],["صَناعَ يَدٍ في الجودِ حَيثُ تَوَجَّهَت","أَرَت عَجَباً مِن حُسنِها المُتَضاعِفِ",41,"ف",1,0],["صَنَعَ الصَنائِعَ في الرِجالِ وَلَم يَكُن","كَمُلَعَّنٍ في البَحثِ وَالتَكشيفِ",42,"ف",1,0],["صَناديدَ أَهدَينا إِلَيهِ رُؤوسَهُم","وَقَد باشَرَت مِنها السُيوفُ الشَناذِفُ",43,"ف",1,0],["صنم شغفت بحبه","فغدوت من عبد الصنم",44,"م",1,1],["صَنَعَتْ فوقَها التماثيلَ أيدٍ","عاجِزاتٌ عن صَنعَةِ الخَلاَّقِ",45,"ق",1,0],["صَنائِعٌ تُنشئ المحامدَ كالْ","أَنْوَارِ راحَ الحَياءُ يَفتُقُها",46,"ق",3,0],["صَنائعُ مَشهورِ الصَّنائعِ يَبتَدي","طِباعاً إذا المَسْؤُولُ يوماً تصَّنعا",47,"ع",2,0],["صَنيعُه سائرٌ يلوحُ وهل","يَخْفى صَنيعٌ مدائحي بُرُدُه",48,"د",2,0],["صنائعُ اللهِ لا نُحصي لها عَدَدا","فَنَحْمَدُ الله حَمداً دائماً أَبدا",49,"د",2,1],["صُنتُ الثناءَ عن الملوكِ نزاهةً","وجعلتُه وَقْفاً على آلائِه",50,"ا",3,0],["صُنِ النَفسَ وَاِحمِلها عَلى ما يزيِنُها","تَعِش سالِماً وَالقَولُ فيكَ جَميلُ",51,"ل",1,1],["صُنِ السَرَ عَن كُلِّ مُستَخبِرٍ","وَحاذِر فَما الحَزمُ إِلّا الحِذِر",52,"ر",1,1],["صَنيعُ مَليكِنا حَسَنٌ جَميلٌ","وَما أَرزاقُنا عَنّا تَفوتُ",53,"ت",1,0],["صُن كُلَّ ما شِئتَ فَإِنَّ البِلى","يَمضي بِما صُنتَ وَما لَم تَصُن",54,"ن",1,0],["صَنَمٌ أَضَلَّ العاشِقينَ فَمَعشَرٌ","قَد زُوِّدوا فيها وَقَومٌ نُقِّصوا",55,"ص",3,0],["صَنَمٌ أَضَلَّ العاشِقينَ فَلَم يَرَوا","مُذ لاحَ بُدّاً مِن عِبادَةِ بُدِّهِ",56,"د",2,0],["صنعت في رجائهم","فعلَة الذئبِ بالغنم",57,"م",1,0],["صَنعٌ بتحبيرِ الثناءِ وَحَوْكِهِ","فكأنّما صنعاءُ تحت لساني",58,"ن",2,0],["صُنعُ الَّذي لَولا بَدائِعُ صُنعِهِ","ما عادَ أَصفَرَ بَعدَ إِذ هُوَ أَخضَرُ",59,"ر",1,0],["صَنَعَ الْوُشَاةُ لَهُ حَدِيثاً كَاذِباً","فَقَسَا عَلَيَّ وَكَانَ سَهْلاً لَيِّنَا",60,"ن",2,0],["صَنَمٌ حَامَتِ الْقُلُوبُ عَلَيْهِ","فَانْظُرُوا كَيْفَ تُعْبَدُ الأَصْنَامُ",61,"م",1,0],["صنمٌ من الكافورِ قُلِّدَ لؤلؤاً","رطباً وأُلبسَ ثوبَ لاذٍ أصفرا",62,"ر",2,0],["صَنَمٌ منَ الكافورِ قُلِّدَ لؤلؤاً","رطباً وأُلبسَ ثوبَ لاذٍ أخضرا",63,"ر",2,0],["صَناعَاً متى ما تُرِدْ خُطَّةً","وكيفَ ومهما تُرِدْ تَصْنَعِ",64,"ع",1,0],["صنّاجةَ الأدبِ الغالي، وكم حِقَبٍ","بها المواهبُ سيمَت سَوْمَ مغبون",65,"ن",1,0],["صُنْتُم ودائعَ ربّكم ما رَاعَكُمْ","في الحقِّ طُغيانٌ ولا اسْتبدادُ",66,"د",1,0],["صُنْها عنِ اليأسِ المُميتِ وكن لها","عامَ الحياةِ تَنَلْ مراتِبَها العُلى",67,"ل",2,0],["صُنعُ الأُلى فاتوا العُقولَ وَجاوَزوا","مَرمى القُوى وَمَواقِعَ الإِمكانِ",68,"ن",1,0],["صُنتُ القَريضَ عَنِ المَحالِ وَأَرجَفوا","حَولي فَما جاوَبتُ مِنهُم عاوِيا",69,"ي",2,0],["صَنَعَ البُرودَ لهم فأحسنَ صُنْعَها","وأجادَها صَنَعُ اليَدَيْنِ مُدَرَّبُ",70,"ب",1,0],["صُنْتَ اللّواءَ وآثرتَ الأحقَّ به","إيثارَ أغلبَ لا واهٍ ولا وَكِلِ",71,"ل",1,0],["صُنتَهُ من ذخائِر الله كَنزاً","كان من قبلُ عنده مذخورا",72,"ر",2,0],["صُنتُعُ الحاجِبَينِ خَرَّطَهُ البَق","لُ بَدِيّاً قَبلَ اِستِكاكِ الرِياضِ",73,"ض",1,0],["صَنَعنا لِلمُلِمّاتِ","شَديداً صادِقِ العَدوِ",74,"و",1,0],["صَنعَةُ بارٍ مُقتَدِر","دامَ عَليها فَمَهَر",75,"ر",1,0],["صُنوجٌ عَلى رَقّاصَةٍ قَد تَمايَلَت","لِتُلهِيَ شَرباً بَينَ دُفٍّ وَمِزهَرِ",76,"ر",1,0],["صِنوُ النبيِّ أَخُو النبيِّ وزِيرُهُ","وَوَليُّهُ فِي كلِّ خَطْبٍ مُؤْيِدِ",77,"د",1,0],["صنمٌ ترَدّى الحُسنَ منه مقَرطقٌ","ومشَى على البَرْدِيِّ منْهُ مُخلخَل",78,"ل",1,0],["صُنْعٌ يؤلَّفُ من نظامِ كواكبٍ","طلعتْ لغيرِ كُثَيِّرٍ والأحوص",79,"ص",1,0],["صَنعْنا لها كلّ رِخْوِ العِنانِ","رَحيبِ اللَّبانِ سليم الشّظى",80,"ا",1,0],["صَنائِعُ الخَمرِ عِندي غَيرُ ضائِعَةٍ","حَتّى يَقومَ بِها شُكري فَيَجزيها",81,"ي",3,0],["صَنَعتُ لَقوحَ الحَربِ ثُمَّ بَعَثتُها","تَدِرُّ دِماءَ ا