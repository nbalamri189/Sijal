{"poems":[[79,"قفا فاسألا في ساحة الأجرع الفرد","https://www.aldiwan.net/poem36602.html","الطويل"],[95,"يا حسنها حين تجلت على","https://www.aldiwan.net/poem11300.html","السريع"],[53,"حق الأديب لازم لذي الكرم","https://www.aldiwan.net/poem66033.html","الرجز"],[63,"وطيب النشر عبق","https://www.aldiwan.net/poem51526.html","مجزوء الرجز"],[33,"من عاشق صب يسر الهوى","https://www.aldiwan.net/poem41320.html","السريع"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54327","المنسرح"],[111,"نكس العلام يا خير الملل","https://www.poetsgate.com/ViewPoem.aspx?id=67046",""],[79,"قفا فاسألا في ساحة الأجدع الفرد","https://www.poetsgate.com/ViewPoem.aspx?id=33812",""],[33,"من عاشقٍ صبٍّ يسرُّ الهوى ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19084&r=&rc=346",""],[369,"جوانح واجد وجفون سال","https://www.aldiwan.net/poem60683.html","الوافر"],[556,"ألا غاد دمع العين إن كنت غاديا","https://www.aldiwan.net/poem47140.html","الطويل"],[712,"","https://poetry.dctabudhabi.ae/diwan/poem/144336","الطويل"],[789,"","https://poetry.dctabudhabi.ae/diwan/poem/146220","الرجز"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93101","الرجز"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75954","المجتث"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99480","السريع"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112485","البسيط"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123515","البسيط"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54501","الكامل"],[4728,"يا ملهمة","https://www.poetsgate.com/ViewPoem.aspx?id=176874",""],[5277,"شظايا الذاكرة","https://www.poetsgate.com/ViewPoem.aspx?id=185998",""],[5335,"الغرير","https://www.poetsgate.com/ViewPoem.aspx?id=35189",""],[5931,"بس أمل !","https://www.poetsgate.com/ViewPoem.aspx?id=175192",""],[6056,"نجاحي بعيد الإحتمال .....!","https://www.poetsgate.com/ViewPoem.aspx?id=130158",""]],"verses":[["وأنْتَ ثِمالُ اللّهِ فابْسُطْ نَوالَهُ","إذا بسَطَ المُحْتاجُ راحةَ مُسْتَجْدي",0,"د",2,0],["وَانْتَثَرَ الْقَوْمُ صِغَارَ البُنَى","بَيْنَ سَوارِيهِ الطِّوَالِ الضِّخَامْ",1,"م",1,0],["وأن تثاب بالغنى منه القدمْ","ما حقُّ هذا دفعهُ إلى العدمْ",2,"م",1,0],["وانتَثَرَتْ غُدْرانُه","في رَوْضةٍ نَثْرَ الوَرَقْ",3,"ق",1,0],["وَأَنتِ ثَأري فَتَلافَي دَمي","ثُمَّ اِجعَليهِ نِعمَةً تُنعِمي",4,"م",2,0],["وإن تثره فما الرياح وما","زئيرها إن تدفقت فكره",5,"ر",2,0],["وانتثر يا دمع أجفان التقى","قد أصيب العلم واغتيل العمل",6,"ل",1,0],["وأنت ثمال الله فابسط نواله","إذا بسط المحتاج راحة مستجد",7,"د",1,0],["وَأَنتِ ثَأْرِي، فَتَلافَيْ دَمي،","ثُمَّ کجْعَلِيهِ نِعْمَة ً، تُنْعِمي",8,"م",2,0],["وأنتُ ثِمالُ كلِّ أخي مَعالٍ","إلى الجَوزاء يَنْظُر من مُعال",9,"ل",1,0],["وَإِنْ تثأَروا فالثّأْرُ بالحيِّ كلِّهِ","وما ذاك من داءِ الرّزيّةِ شافيا",10,"ي",2,0],["وإن تثنكم عنا المهامه والسرى","تقربكم منا المودة والذكر",11,"ر",1,0],["وانتثرتْ عوّاؤُهُ","تَناثُرَ العقدِ انقطع",12,"ع",1,0],["وانتثرت نجومه وقلبه","بالكوكب المنقض قد توقدا",13,"د",2,0],["وَإِن تَثَنّى فَغُصنٌ","مِن ناعمِ البانِ مائِس",14,"س",1,0],["وانتثر السوسن من صدغها","وثار منها نفس أبخر",15,"ر",1,0],["وإن تثنى على كرسيّه ورنا","فاسخر من البان صداحا وميّاسا",16,"س",2,0],["وان تثابت فاكظم ما استطعت وضع","احدى يديك اخا العرفان فوق فم",17,"م",1,0],["وإن تثنت وماست مال من خجل","غصن الرياض وفي أوراقه التحفا",18,"ف",2,0],["وأَنتَ ثبتَّ دونَ الدِّين تحمي","حماهُ أَوانَ ولَّى كلُّ دونِ",19,"ن",1,0],["وانتثر شعرٍ وسمط الذهب ما لملمه","هو حريرٍ بازرق العود والمسك انغمر",20,"ر",1,0],["وأنت ثكلى بك الذبّاح من عجبٍ","يرنو إليك ويغضي طرفَه العجبُ",21,"ب",1,0],["وان تثنى يامال الكسر يالخيزرانه","وش تشفون لو مهو جفول حياوي",22,"ا",3,0],["وإن تثنى قدك المايس يا ويل","والقوام جنون لا منه اعتدل",23,"ل",1,0],["وانتثرمجدوله اللي من على متنه خصل","قلت أنا هذي سجايا اللي كريمين الخصال",24,"ل",1,0]]}