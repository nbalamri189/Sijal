{"poems":[[77,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[50,"وعظتك واعظة القتير","https://www.aldiwan.net/poem63373.html","مجزوء الكامل"],[48,"أصحاب ليكة أهلكوا بظهيرة","https://www.aldiwan.net/poem22698.html","الكامل"],[48,"الدهر يزبق من حواه كأنهم","https://www.aldiwan.net/poem23024.html","الكامل"],[119,"طعن الحسود بنا لخفة عقله","https://www.aldiwan.net/poem41695.html","الكامل"],[132,"إن أبطأ المرء في وعد وفي عدة","https://www.aldiwan.net/poem50517.html","البسيط"],[137,"أدركت آمال الشريعة في العدا","https://www.aldiwan.net/poem4237.html","الكامل"],[164,"خاطر بنفسك في رضى الرحمن","https://www.aldiwan.net/poem59197.html","الكامل"],[242,"قل للذي لا ينتهي عن فحشه","https://www.aldiwan.net/poem19722.html","الكامل"],[422,"انظر إلى الأشراف كيف تسود","https://www.aldiwan.net/poem54146.html","البسيط"],[563,"هذا الوجود الحقيقي الواحد الأحد","https://www.aldiwan.net/poem34570.html","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/71032","المجتث"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66235","الكامل"],[2121,"","https://poetry.dctabudhabi.ae/diwan/poem/143015","الرجز"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129435","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91250","الكامل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85244","البسيط"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66579","البسيط"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75683","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83645","البسيط"],[4722,"وبالقضاء وبالأقدار اجمعها","https://www.poetsgate.com/ViewPoem.aspx?id=26472",""],[4767,"شمس الإمامة","https://www.poetsgate.com/ViewPoem.aspx?id=180572",""],[4988,"سبّة غلاها","https://www.poetsgate.com/ViewPoem.aspx?id=198224",""],[592,"الحمد لله حمداً دائماً وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=128796",""],[5434,"لاتسقط شرفها","https://www.poetsgate.com/ViewPoem.aspx?id=37615",""],[5442,"هذا اللقاء وما شفيت غليلا","https://www.poetsgate.com/ViewPoem.aspx?id=114739",""],[5956,"مولدِ الطفل أدهم إيهاب","https://www.poetsgate.com/ViewPoem.aspx?id=193097",""],[6052,"بشرى النبوة","https://www.poetsgate.com/ViewPoem.aspx?id=34805",""],[6093,"قُبْلَةُ المِلْيَارِ","https://www.poetsgate.com/ViewPoem.aspx?id=199427",""]],"verses":[["واللّهُ خصَّكَ بالقُرانِ وفضلِه","واخجلتي ما تَبلُغُ الأشعار",0,"ر",1,0],["وَاللَهُ خَصَّ بِكَ الخَلي","فَةَ فَاِصطَفاكَ عَلى بَصيرِ",1,"ر",1,0],["وَاللَهُ خالِقُنا اللَطيفُ مُكَوِّنٌ","ما لا يَبينُ لِسامِعٍ أَو مُبصِرِ",2,"ر",1,0],["وَاللَهُ خالِقُنا لِأَمرٍ شاءَهُ","أَبَقَ العَبيدُ وَعَبدُهُ لا يَأبَقُ",3,"ق",1,0],["واللَه خير الناصرين لمثلنا","وكفى بقوة ربنا وبحوله",4,"ل",2,0],["واللهِ خلفةُ بِرٍّ صادقٍ ورعٍ","ما خنت عهدي ولا دلَّسْتُ في كَلِمي",5,"م",2,0],["واللَه خَصَّكَ بالكمالِ وشاءَ أن","يبقى على الأيامِ أمرُكَ سَرمَدا",6,"د",2,0],["والله خير المحسنين وفضله","وعطاؤه أبقى على الإِنسان",7,"ن",1,0],["وَاللهَ خَفْ وَارْجُ رِضَاهُ وَبَطْشَهُ","وَارْكَبْ مَطَا دُهْمِ السَّدَادِ وَبَرْشِهِ",8,"ش",2,0],["والله خير الناصرين ولم يكن","إلاَّ لديه النصر والتأكيد",9,"د",1,0],["والله خالقهم يعني مقدرهم","كما لنا جاء في القرآن يعتمد",10,"د",1,0],["واللهُ خيرٌ له مِنْ","هذى البريّةِ طُرَّا",11,"ر",2,0],["والله خصصه بحيدرة الذي","يأتي غداً والنصر تحت لوائه",12,"ا",3,0],["والله خير كافلا","في ستر فرد صمد",13,"د",1,0],["والله خالق نوعنا من أربع","متقابلات كلها بوزان",14,"ن",1,0],["والله خوله عدوا مدبراً","في كل ملحمة وحظا مقبلا",15,"ل",2,0],["وَاللَه خَيرٌ حافِظاً","في سفرة وَإِقامة",16,"ه",1,0],["واللَه خالق أفعال العباد وما","يجري عليهم فعن أمر الإله له جرا",17,"ر",2,0],["وَاللَّهُ خَيَّبَ ما ظَنُّوهُ وَانْتَظَرُوا","وَاللَّهُ حَقَّقَ ما نَرجُو وَنَدَّخِرُ",18,"ر",1,0],["وَاللَه خصك بالسَعادة منة","لما اِكتَفيت به عليك وَكيلا",19,"ل",2,0],["وَاللَهُ خصَّك بِالإِحسانِ منزلةً","لَم يولِها الأَنبِيا وَالرسل تعيينا",20,"ن",2,0],["والله خالق أفعال العباد وما","يجري عليهم فعن أمر الإله جرا",21,"ر",2,0],["والله خاذلُ خاذلٍ من بعد ما","بانت له تلك الحقائق صادعة",22,"ع",2,0],["والله خبل والخبل من خلقته شين","وليا ارتفع راسه يطقّ ابحذاها",23,"ا",3,0],["والله خالٍ عن الست الجهات فذا","قول يقول به من للإله نفى",24,"ف",2,0],["والله خلق بيد الذلول وعسفها","للي يبي المنهاج مثل القطيفه",25,"ف",2,0],["والله خصك في الأنام بخمسة","لم يعطها بشر سواك رسولا",26,"ل",2,0],["والله خيرُ الحافظين يصوننا","من أن نضِلَّ عن الصراطِ ونَعْمى",27,"م",2,0],["والله خيرٌ حافظا ً لكتابهِ","ورسالة الإسلام فيه ِ تصمُدُ",28,"د",1,0],["واللهُ ُ خَصَّكُمُ بِخِدْ","مَةِ ضَيْفِهِ عَبْرَ الزَّمَنْ",29,"ن",1,0]]}