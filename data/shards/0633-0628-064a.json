://www.poetsgate.com/ViewPoem.aspx?id=197280",""],[482,"أشاقكَ مِن غرامِكَ ما يشوقُ","https://www.poetsgate.com/ViewPoem.aspx?id=111409",""],[5616,"الراحلون","https://www.poetsgate.com/ViewPoem.aspx?id=204853",""],[2110,"سريت بها والليل داجي الحنادس","https://www.poetsgate.com/ViewPoem.aspx?id=156274",""],[5660,"هَذَيتِ بِبَيتٍ ظَنَنتيهِ شِعراً","https://www.poetsgate.com/ViewPoem.aspx?id=35625",""],[5830,"فِي المَجْدِ ْمُسْتَبَقٌ","https://www.poetsgate.com/ViewPoem.aspx?id=201192",""],[6038,"يا اللي تغلى","https://www.poetsgate.com/ViewPoem.aspx?id=25694",""],[5616,"الرّاحلون ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1934&r=&rc=4",""],[6334,"في الرمل حمى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82250&r=&rc=0",""],[5190,"الرزق الحلال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78291&r=&rc=5",""]],"verses":[["سَبى فَناؤُكَ آمالاً لِطينَتِها","سَبيَ الأَزِمَّةِ أَعناقَ المَصاعيبِ",0,"ب",1,0],["سَبَيْنا عُقارَ الرّومِ في عُقْرِ دارِها","بحيلَةِ تمْويهٍ وخدْعَةِ تدْليسِ",1,"س",1,0],["سَبَى الأَسْمَاعَ وَالأَبْصَارَ مِنْهَا","غِنَاءُ الطَّيْرِ فِي الظَّبْيِ الأَغَنِّ",2,"ن",1,0],["سبيكته كرسي","وحصنها الإكليل",3,"ل",1,0],["سبيلك في سُبْل المكارم يقتفي","وهديَك يا خير الأئمة يقتدي",4,"د",2,0],["سبيلي إليكَ كتابي إليكا","فلا تقطَعَنَّ سبيلي إليكا",5,"ك",2,1],["سَبِيٌّ مِن يَراعَتِهِ نَفاهُ","أَتِيٌّ مَدَّهُ صُحَرٌ وَلوبُ",6,"ب",1,0],["سَبيلُ الخُلدِ كانَ عَلَيكَ سَهلاً","وَعادَتُهُ يَكُدُّ السالِكينا",7,"ن",2,0],["سُبينَ وعُرِّينَ من بعد ما","ذُبحنَ فيا لكَ من منكرِ",8,"ر",1,0],["سَبيلِيَ أَن أُعطى الَّذي تَسأَلونَني","وَحَقِّيَ أَن يُجدي عَلَيَّ وَلا أُجدي",9,"د",2,0],["سَبِيَّةَ قَومٍ لَو دَعَت لَأَجابَها","بَنا الحَربِ ضَرّابو يَدَي كُلَّ أَصيَدِ",10,"د",1,0],["سُبينَ فباشَرْنَ المَحارِمَ عَنوةً","وعَزَّ عليها أن تُباشِرَ مَحرَما",11,"م",2,0],["سَبَى وأبقَتْ بَوادي سَبْيَهِ لُمَحاً","معشوقةً إن عفَتْ عنها عَواقبٌه",12,"ب",2,0],["سَبْيٌ تحصَّنَ منه الجيشُ وارتبطت","قُبُّ الجيادِ فلا ماشٍ ولا عَذَبُ",13,"ب",1,0],["سُبِيَتْ بِسُيوفٍ من ذَهَبِ","مِن أَهلِ السبتِ أَوِ الأَحَدِ",14,"د",1,0],["سبيلُ المجدِ إيمانٌ وحقٌّ","وسَيْفٌ يَردعُ المُتهجِّمينا",15,"ن",2,0],["سبيلُ مُحمَّدٍ وذَوي هُداهُ","حُماةِ الحقِّ خيرِ المُرشِدينا",15,"ن",2,0],["سَبيلُكُما أَن تُخفِيا لا عِجَ الجَوى","وَما هَو إِلّا أَن يُذاعَ فَيُعلَما",16,"م",2,0],["سَبيلُك في مَرضاةِ ربِّكَ يا بِشرُ","وفي حقِّهِ فَادْأَبْ وإن فَدَح الأمرُ",17,"ر",1,1],["سبيلَ مُحمّدٍ فَاسْلكه أهدى","وخذه يا ابن حربٍ منه عهدا",18,"د",2,0],["سَبيلُ اللَّهِ ليس له إذا ما","بلوتِ السُّبْلَ أجمعَ من ضريبِ",19,"ب",1,0],["سبيلَ السُّوءِ تسلكه مُدِلّا","تريدُ مُحمداً وأراه بَسْلا",20,"ل",2,0],["سبيلان شتّى أنت لا بد عالمٌ","إذا ما استنبتَ الرشد أيهما أهدى",21,"د",2,0],["سَبيلُ الوَرى وَسَبيلُ الوَزيرِ","أَن يَسأَلوهُ وَأَن يَبذُلا",22,"ل",2,0],["سَبيلُ الحبِّ أوَّلُهُ اغْترارُ","وآخِرُهُ هُمومٌ وَادِّكارُ",23,"ر",1,1],["سَبى روحَها فاشتهى جسمَها","فثارتْ بعزّةِ مستكبرَهْ",24,"ه",1,0],["سبَى السحرُ أجملَ أرواحِهِ","فأنطقهن بما يخدعُ",24,"ع",1,0],["سبيل موسى في الزمان الأول","ومذهب الروح ولمّا يُحْوِلِ",25,"ل",1,0],["سَبى القَلبَ إِلّا أَنَّ فيهِ تَخَلُّداً","غَزالٌ بِأَعلى الماتِحينَ رَبيبُ",26,"ب",1,0],["سَبِيلُكَ لاَ يُسَارُ بِهَا وَمَنْذَا","تُوَاتِي جُهْدَهُ تِلْكَ السَّبِيلُ",27,"ل",1,0],["سَبِيلُكَ نَفْعُ النَّاسِ تُوِليهِ شَامِلاً","وتُخْلِصُهُ بدْءاً وَعَوْداً مِنَ الضُّرِّ",28,"ر",1,0],["سبيلى الصّبا مهما حرصت على الصبا","فدعه يذوق الحبّ من قبل أن يبلى",29,"ل",2,0],["سَبِيّةَ قَوْمٍ لَوْ دَعَتْ لأجَابَهَا","بَنُو الحَرْبِ ضرّابوا يَدَيْ كلّ أصْيدِ",30,"د",1,0],["سبيتم أطفال عليك أعزة","ويفضي بزيد ما عليه يزيد",31,"د",1,0],["سَبَى القلْبَ إلاَّ أنَّ فيهِ تَجلُّداً","غزال بأعلى الماتحين ربيب",32,"ب",1,0],["سبيتم بلساني","وحبهم بجناني",33,"ي",1,1],["سبيئتان اثنتان هذي","حلٌّ مباحٌ وذي حَرامُ",34,"م",1,1],["سبيل الهوى هجرٌ ووصلٌ وفرقةق","وجمعٌ وخلفٌ بالزيارة والعتب",35,"ب",1,0],["سَبيلُ شكاتي فِيكَ غيرُ خَفيَّةٍ","فَمن أدمُعِي نَقشِي وَمِن وَجنتَي طِرسي",36,"س",2,0],["سَبيلُ نَجاةٍ لِلجِنانِ مُبَلِّغ","وَدونَكَ فاِستَشهِد بِعَقلِكَ وَالحِسِّ",37,"س",1,0],["سَبيلُ الهَوى وَعْرُ","وَبَرْدُ الهَوى حَرُّ",38,"ر",1,1],["سبيلك أن تستغفر الله بعدها","وأن تتلافى الذنب منها بتوبة",39,"ه",1,0],["سَبى الناسَ مِنها رِدفُها وَقَوامُها","وَوَجنَتُها الحَمرا وَمُقلتها الحورا",40,"ر",2,0],["سبَى فؤادي بألفاظٍ يفصِّلُها","برقُ ابتسامٍ جرى للعقل مختطِفا",41,"ف",2,0],["سبيل إلى عيش يقضي بقربكم","وماضي شباب فات ليس يئيض",42,"ض",1,0],["سَبيكَةٌ مِن فِضَّةٍ","في سَفَطٍ مِن صَندَلِ",43,"ل",1,0],["سبى سبأ قدماً وحي السكاسكِ","ولم يأل عن خونٍ لخان وآلك",44,"ك",1,0],["سبيل المُؤثرينَ على","سبيلِ الّله سُبُلَهُم",45,"م",1,0],["سَبيلُ فَوزٍ بِهِ سادَت جَماعَتُهُ","وَفي المَعادِ وَيا لِلهَولِ حِليَتُهُ",46,"ه",1,0],["سَبيلَ الهُدى لِسالِكينَ سَبيلَهُ","وَأَميالَهُ وَأَقمارِ شَمسِ الأُبُوَّةِ",47,"ه",1,0],["سبَى منّي الفؤادَ لحاظُ فاتِنْ","وعَذَّبني فِراق أغَرَّ شادنْ",48,"ن",1,1],["سَبياً على القُعُداتِ تَخفُقُ فوقَهم","رايات أَبيضَ كالفَنيقِ هِجانِ",49,"ن",1,0],["سَبَى الأطفالَ واجتَّز النَّواصي","من الأَبطالِ وانتَسَفَ الدّيارا",50,"ر",2,1],["سبيل الراهب الراجي بربٍّ","عياناً أن يسام بكل فضلِ",51,"ل",1,1],["سُبِيَت بَناتُ محمدٍ","وَستورُها رهنُ اِنهِتاكِ",52,"ك",1,0],["سبيّةُ سَفَّانين قد خُدعا بها","تصيبُ الفؤادَ من لذيذٍ وتشتفي",53,"ف",2,0],["سبيل الغنى رحب على كل سالك","فما لِيَ أمشي فيه في مدرج النمل",54,"ل",1,0],["سبيل جرى فيه الصفاءُ وقد غدا","عن الأعذبين الأطيبين يعيضُ",55,"ض",1,1],["سبيت الريم في عينٍ","سبت هاروت بالسحرِ",56,"ر",1,0],["سبيل الردى هذا مليك متوج","وسوقة قوم أو قروم قماقم",57,"م",1,0],["سبى الأبصارَ والأسماعَ حتى","لطال به اللسانُ المستذيقُ",58,"ق",1,0],["سبى جلدي حتى ضعاف جفونها","وطلَّ دمي حتى دماها وغيدها",59,"د",3,0],["سَبى عَقلي هِلالُ بَني هِلالٍ","بِأَلحاظٍ كَأَلحاظِ الغَزالِ",60,"ل",1,1],["سبيت على رغم التوله قلبه","فلم كان في لأواه قلبك قاسيا",61,"ي",2,0],["سَبَينا نِساءً مِن جَليحَةَ أَسلَمَت","وَمِن راهِبٍ فَوضى لَدى كُلِّ عَسكَرِ",62,"ر",1,0],["سبى ما جنى من وصله بصدوده","رجاء ووصلاً من تلافي مفارق",63,"ق",1,0],["سبَى قَلبِي جمالُ الظَّبي فينَا","وأحرَقَهُ بجَمرةِ وجنتَيهِ",64,"ه",1,1],["سبى قلبي الولهان يوسف حسنه","فمن لي بقلبٍ غيره أو برده",65,"د",2,0],["سَبىَ القلبَ مني لَحظُ ظَبْي أُحبُّه","فيا قلبُ ما أَصْبىَ ويا لَحْظُ ما أَسْبىَ",66,"ب",2,0],["سبية من سبا جاءت تنبئنا","عن حالها مذ عراها سيلها العرم",67,"م",1,0],["سَبَى سَنا حُسْنِكُمْ فؤادي","مالي وما لِلْجَمالِ مَالِي",68,"ل",2,0],["سبى نسوة السكان في البيد والقرى","بظلم وكل بالمهالك خائض",69,"ض",1,0],["سَبيت الحجى مِنّي وَلا جَور أَنّهُ","خُلِقتُ لِأَنْ أُسبَى وَكنتِ لأنْ تسبِي",70,"ب",2,0],["سَبى مِنهُم وَغادر أَلفَ عِلجٍ","تطاير عَنهُم الطَيرُ الذُبابا",71,"ب",2,0],["سبيكيه طول الدهرِ حرٌّ وخادمٌ","ويبكيه مُسْتَفْتٍ ومُفْتٍ وسائلُ",72,"ل",1,0],["سَبيكتنا الغراء جادتكِ أدمُع","وإلا فَوَكافُ من المزن ناضح",73,"ح",1,1],["سبيل لإدراك الترات مُوّصل","إذا ما سيوف الهند راع صَليلها",74,"ل",3,0],["سَبيل العُلا صعب حمته بوادرُهْ","وسَهْلٌ على من لم تخنْه خواطرُهْ",75,"ر",2,1],["سبيل حبيبيَّ اللذين تبرّضا","دموعي حتى أسرعَ الحزنُ في عقلي",76,"ل",2,0],["سَبِيلُ هُدىً يُهْدَى بهِ كُلُّ مُبْصِرِ","إذَا عَمِيَتْ بالْمُصِرِينَ البَصَائِرُ",77,"ر",1,0],["سَبيلُ الجَميعِ إِلى فُرقَةٍ","فَإِن أَنتَ لَم تَدرِهِ فَاِدرِهِ",78,"ر",2,0],["سَبى قَلبي وَعذبه","فَهَل فيما أَتى عذر",79,"ر",1,0],["سَبَيْتُمْ بأَلحْاظِكمْ والقُدودِ","فُؤادي ما بَيْنَ ضَرْبٍ وطَعْنِ",80,"ن",1,0],["سبيل الهدى نحو الردى قد تيمما","ملابسة الاغيار عين اضاعة",81,"ه",1,0],["سبيت وأعظم ما شجاني غيرة","يا غيرة الإسلام سلب ردائها",82,"ا",3,0],["سبى فؤادى بليلِ شعرٍ","وصُبحِ وجهٍ وغُصنِ قدِّ",83,"د",1,0],["سبيل الحق من حيث المعاني","قريب ليس يعرفه البعيد",84,"د",1,0],["سبيل الموت رب الخلق أورد","فهل منع من المقدور أورد",85,"د",1,1],["سبيل العلا ولها بالغ الجد","ويعلو ذراها راقيا أسعد الجد",86,"د",1,1],["سبيل النبيئي الكرام سبيله","يعم به الدنيا صلاحاً فتقمر",87,"ر",1,0],["سبى حسنها قلبي ومزَّقٍ مُهجتي","حسامٌ سطا من فاتك الطرفِ أغيدِ",88,"د",1,0],["سبيتني بجمال لَم يدع أحدا","إلا وأذهَلَهُ عَن رُشده وَسبا",89,"ب",2,0],["سبيل ودّي له التَصافي","وودّه حين ودّ واهى",90,"ه",2,0],["سبيله الزهد باللذات ينكرها","سعياً إلى لذة في العالم الثاني",91,"ن",2,0],["سبيل أحمدَ خير الن