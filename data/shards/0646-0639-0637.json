{"poems":[[4,"راح القطين بهجر بعدما ابتكروا","https://www.aldiwan.net/poem21160.html","البسيط"],[40,"بان الأحبة بالعهد الذي عهدوا","https://www.aldiwan.net/poem7699.html","البسيط"],[107,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[107,"أقبل نعيم هداك ربك ساريا","https://www.aldiwan.net/poem44192.html","الكامل"],[107,"أقبل فتلك ديار يثرب تقبل","https://www.aldiwan.net/poem44226.html","الكامل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125571","الكامل"],[370,"إذا قتلنا ولا يبكي لنا أحد","https://www.aldiwan.net/poem44510.html","البسيط"],[556,"ما نحن إلا للفناء","https://www.aldiwan.net/poem48110.html","مجزوء الكامل"],[889,"","https://poetry.dctabudhabi.ae/diwan/poem/205129",""],[944,"","https://poetry.dctabudhabi.ae/diwan/poem/51584","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62459","الكامل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25325","الرجز"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52090","البسيط"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102147","البسيط"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88664","الرمل"],[2988,"","https://poetry.dctabudhabi.ae/diwan/poem/29434","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132702","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62741","الكامل"],[4701,"ثلاثون عامًا تمرُّ الظباءْ","https://www.poetsgate.com/ViewPoem.aspx?id=45009",""],[5000,"سلامًا مالكا قلبي سلاما","https://www.poetsgate.com/ViewPoem.aspx?id=6404",""],[5150,"نشيد المقاومة ...!","https://www.poetsgate.com/ViewPoem.aspx?id=202934",""],[5185,"بعض أنفاس البحر","https://www.poetsgate.com/ViewPoem.aspx?id=71578",""],[5251,"مع التعايش","https://www.poetsgate.com/ViewPoem.aspx?id=214845",""],[5648,"فصلة الفيش","https://www.poetsgate.com/ViewPoem.aspx?id=156247",""],[5732,"حنا من المعروف تندا يدينا","https://www.poetsgate.com/ViewPoem.aspx?id=177858",""],[5957,"نشيد التفاؤل","https://www.poetsgate.com/ViewPoem.aspx?id=177207",""],[6093,"شهمٌ على ظَهرِ المآذن صادحٌ","https://www.poetsgate.com/ViewPoem.aspx?id=176426",""]],"verses":[["نُعطي حُقوقاً عَلى الأَحسابِ ضامِنَةً","حَتّى يُنَوِّرَ في قُريانِهِ الزَهَرُ",0,"ر",1,0],["نُعطي الزَكاةَ فَما يَرضى خَطيبُهُمُ","حَتّى نُضاعِفَ أَضعافاً لَها غُدَدُ",1,"د",1,0],["نُعطي الوَقائِعَ حَقَّها وَيَسوءُنا","حَنَقُ الظُبى وَتَعَتُّبُ الفُرسانِ",2,"ن",1,0],["نُعطِي سُيوفَك من قريشٍ ثُلَّةً","ونَسوقُ من غَطفانَ جَمعاً رابيا",3,"ي",2,0],["نُعطِي اليتيمين الكِفَاءَ وإن هما","أَبيا ونَتَّبِعُ التي هي أنبلُ",4,"ل",1,0],["نعطي ونأخُذ في الحديث ومُقلتي","مسحورةٌ بجمالك الأخَّاذ",5,"ذ",1,0],["نُعطي السَوِيَّةَ من طعنٍ له نَفَذٌ","ولا سَوِيَّةَ إذ تُعطى الدنانيرُ",6,"ر",1,0],["نُعطى وَيسلبُنا الّذي","أَعطى التمتّعَ بالعطاء",7,"ا",2,0],["نعطش اليوم ونسقى","في غد نعت الطلول",8,"ل",1,0],["نُعطي الجزيل فلا نمُنُّ عطاؤنا","قبل السؤالِ ونحمل الأثقالا",9,"ل",2,0],["نعطو الحديث عتابنا فيميلنا","طرباً ويأتينا الغرام بعده",10,"د",2,0],["نُعْطِيهِ حُكْراً قَبْل أَنْ يُحاكِرا","فِي البَيْعِ لَوْ رَدَّ الشَبَابَ النَاضِرا",11,"ر",2,0],["نُعطِيكَ مِنْ بَعْدِهِ الأيامُ بَالِغَةً","لِمِثْلِهِ مِنَناً فِي إثرِهَا مِنَنُ",12,"ن",1,0],["نُعطيهِ مأمولهُ ونولهِ فوقَهُ","وذا بِفَضلِ مرقينا العلى سنَدِ",13,"د",1,0],["نعطف الآتي على ما قد مضى","هاجَني لامع برق اومضا",14,"ض",2,0],["نُعطي العَشيرَةَ حَقَّها وَحَقيقَها","فيها وَنَغفِرُ ذَنبَها وَنَسودُ",15,"د",1,0],["نعطي الحقوق وتأخذ الشرف الذي","هو في جبين الدهر نور جماله",16,"ل",2,0],["نُعطي مدائِحَنا ونأخذُ بِشْرَهُ","كلٌّ بتشييدِ المَعالي حاذِقُ",17,"ق",1,0],["نعطِّر شَيبةَ آبائنا","بما سال من عَرَقِ الأنبياء",18,"ا",2,0],["نُعطّرُ بالبراءةِ كلَّ حرفٍ","ونُرسِلُها إلى الدُّنيا حَماما",19,"م",2,0],["نعطيكِ ما ترجينَ منا أنفساً","وبكل نفسٍ نفحةٌ من كربلاءْ",20,"ا",2,0],["نعطي ونأخذ كلٌّ قدر حاجته","فالحب صار بنا الموصوف بالكرم",21,"م",1,0],["نُعطي القلوبَ أماناً زائفاً ..وَ نَعي","أنَّ (الوَباءَ )بِكُلِّ الشَّرِ لَمْ يَزلِ",22,"ل",1,0],["نعطي ولانطلب وفا حاضر وكاش","واليا عطينا مانتظرنا المطاريش",23,"ش",1,0],["نعطي ولا نتبع عطانا بالاقوال","ونبذل ونسكت كننا ما عطينا",24,"ن",2,0],["نعطر بالذكر أفواهنا","لتصبح أرواحنا عاطرة",25,"ر",2,0],["نُعْطي الرَّغَائِبَ في الشَّدائدِ دَأْبُنا","عَوْنُ الصَّديق وتَجْحَدُ الإخوانُ",26,"ن",1,0]]}