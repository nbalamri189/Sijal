أَبُدُورُ تَمٍّ كالبُدُورِ طَوالِعُ","https://www.poetsgate.com/ViewPoem.aspx?id=63530",""],[5616,"شموخا أيتها المآذن","https://www.poetsgate.com/ViewPoem.aspx?id=204845",""],[5704,"يا زائرا للحيِّ٠٠","https://www.poetsgate.com/ViewPoem.aspx?id=204224",""],[402,"لقد آن أن يستمرئ النوم ساهد","https://www.poetsgate.com/ViewPoem.aspx?id=35475",""],[5785,"ذكرتك وقد فاض دمع الغمام","https://www.poetsgate.com/ViewPoem.aspx?id=131563",""],[5786,"لعاذلي قلبٌ ولي قلْبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50652",""],[5786,"إن كنتَ لي صاحباً قِف لي بهبود","https://www.poetsgate.com/ViewPoem.aspx?id=50651",""],[5790,"أيا من راح عن حالي","https://www.poetsgate.com/ViewPoem.aspx?id=111910",""],[5837,"راس جسّاس","https://www.poetsgate.com/ViewPoem.aspx?id=182881",""],[6093,"فَلْسَفَةُ المَوتِ","https://www.poetsgate.com/ViewPoem.aspx?id=179845",""],[6142,"لا عذر للعين إن لم تنفجر علقا","https://www.poetsgate.com/ViewPoem.aspx?id=155754",""],[6260,"الشهيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=6170&r=&rc=0",""],[6351,"صحراء انتظارٍ أنا.. وغيمة الموعد أنت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86048&r=&rc=8",""],[572,"عَراني الزّمَانُ بأحداثِهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9201&r=&rc=58",""]],"verses":[["وَجِسمٌ إِذا جَرَّدتَهُ مِن قَميصِهِ","عَلى الناسِ قالوا هَكَذا يَفعَلُ الحُبُّ",0,"ب",1,0],["وجسم أبيض مدلفن","مثل جبنة ان طريّا",1,"ي",2,0],["وجسماً نحيفاً أنهكته همومُه","فكادت تراه العينُ بعضَ تَوَهُّم",2,"م",1,0],["وَجِسمٌ جالَتِ الأَسقا","مُ فيهِ فَراحَ مُنتَهَبا",3,"ب",2,0],["وَجِسمُكَ فَوقَ هِمَّةِ كُلِّ داءٍ","فَقُربُ أَقَلِّها مِنهُ عَجيبُ",4,"ب",1,0],["وجَسِّدِ الروح بالترداد فهو لنا","نار تحلّل ما يبقى من المَدَرِ",5,"ر",1,0],["وجسّدوا الشيء ما له جسد","وقد وصلتم وحزتم الأربا",6,"ب",2,0],["وجسومٍ إذا الرؤوسُ عَلَتْهُنْ","نَ أثارَتْ حلَّت قُواها الرؤوسُ",7,"س",1,1],["وَجَسَّ مِنَ الأَوتارِ مَثنىً وَمَثلَثاً","فَحَقَّت بِنا الأَفراحُ فَرداً وَتَوأَما",8,"م",2,0],["وجسمٍ له من غيْرِهِ روحُ لذةٍ","سليلِ ضروعٍ أُرْضِعَتْ حَلَبَ السُّحبِ",9,"ب",1,1],["وجسمُك واهنُ الأعضاءِ دامِ","أمالكَ يا ابن بشرٍ في السَّلامِ",10,"م",1,0],["وَجَسَدٍ عَلَيهِ جِلدٌ مِن وَسَخ","كَأَنَّهُ أُشرِبَ نَفطاً أَو لُطَخ",11,"خ",1,0],["وجُسومٌ كَأَنَّمَا رَحَضَتْهَا","منْ عظيم المَهَابَةِ الرُّحَضاءُ",12,"ا",2,0],["وَجِسمُ المَرءِ بِالأَغراضِ رَبعٌ","فَهَل زَكّاهُ تَزكِيَةَ العُروضِ",13,"ض",1,0],["وَجِسمي شَمعَةٌ وَالنَفسُ نارٌ","إِذا حانَ الرَدى خَمَدَت بِأُفِّ",14,"ف",1,0],["وجسم المرء تبنيه خلايا","زمانُ حياتها فيه زهيد",15,"د",1,0],["وَجِسمي في جِبالِ الرَملِ مَلقىً","خَيالٌ يَرتَجي طَيفَ الخَيالِ",16,"ل",1,0],["وَجِسْمِي عَلِيلٌ حَارَ فِيهَ طَبِيبُهُ","وَهَمِّي ثَقِيلٌ قَلَّ فِيهِ المُسَاعِد",17,"د",1,0],["وجسمِي الّذي أَبلاه فقدُكَ إن أكن","رحَلتُ به فالقلبُ عندَكَ خيَّما",18,"م",2,0],["وجسَّ مكانَ الداءِ أَوَّلَ نَظرةٍ","كأنَّ له عِلْماً بموضِعه قِدْما",19,"م",2,0],["وجسوم حمر تنوش جسوما","في ثياب من الجراحات حمر",20,"ر",1,0],["وَجِسمي لِضيفان السقام مَوائِدٌ","وَدَمعي لِزوّار الغَرام مَناهِلُ",21,"ل",1,0],["وجسم للقلا اضحى سقيما","كأن عليه لم يشدد حزام",22,"م",1,0],["وَجَسرَة الخَلقِ مَنفوجٍ مَرافِقُها","عَيرانَةٍ كَوبيلِ القشِّ شِملالِ",23,"ل",1,0],["وجسمي من صُدُودكمُ نحيلٌ","فهلاّ من رجوع أو إيابِ",24,"ب",1,0],["وجِسمي دَهاهُ العَنا","حَنانَيكَ خُذ بيدي",25,"ي",1,0],["وَجِسمي رَهينٌ لِلتَحَرُّقِ وَالنَشظِ","أَقَمتُ عَلى شَوقٍ صَليتُ بِجَمرِهِ",26,"ه",1,0],["وَجُسنا ديارَ الشِركِ نُبرىءُ أَو نَبري","فَكَم وَجنَةٍ دُسنا هُناكَ وَجَبهَةٍ",27,"ه",1,0],["وجسمٌ بالنحول يكادث يخفى","لقد حدثت وراءَكم أُمور",28,"ر",1,0],["وجسم محاه السقم لولا قميصه","بدا شبح كالظل كاد يزول",29,"ل",1,0],["وَجَسدٌ أَبلى بهِ سَقمه","يَكادُ لَولا ثَوبِهِ يَختَفي",30,"ف",2,0],["وجسمك إن لم يظعنوا عنك ناحِل","وقلبك إن بانوا مع الركبِ راحِل",31,"ل",1,0],["وجسمٌ حرامٌ من قوام مضاجع","يغرّد شوقاً والحطيم الأضالع",32,"ع",1,0],["وجسَّ أوتارَ عودٍ بالهوى شعرت","والعَب بأفئِدةٍ كالموجِ بالسُّفُن",33,"ن",1,0],["وجسر على متن الجحيم وموقف","طويل وأهوال الحساب المهولة",34,"ه",1,0],["وجسوم أشقيتها بالتنائي","وجسوم أسعدتها بالتلاقي",35,"ي",1,0],["وجسمي ستعصرُه كرمَةً","وتسقى شبابك من خمرها",36,"ر",3,0],["وجسوم نواحل","لا وقاء ولا وزر",37,"ر",1,0],["وَجَسيمِ هَمٍّ قَد رحَلتُ له","حَتّى تؤوبَ بليَّةً عنسي",38,"س",2,0],["وجسماً ضعيفاً مثل خَصْركِ ناحلاً","وعزمَ اصْطبارٍ مثل جفنكِ فاترا",39,"ر",2,0],["وجست أرض العدا وأفنيت من","أبطالهم ما يجاوز العددا",40,"د",2,0],["وجسم براه الحزن كالبري بالمدى","فصار كمثل السلك في الحرب تسرد",41,"د",1,0],["وجسَّركِ الجمالُ على التجنّي","ألا يا قبحَ ما صنع الجمالُ",42,"ل",1,0],["وجسمٍ حسمُ داء الهمِّ فيهِ","إذا ما ألهمُّ جلَّ عن العلاج",43,"ج",1,0],["وجسوم الخلق عناصرها","فسل الأجداث عن الأمم",44,"م",1,0],["وجساء يسأل عفوا","من جمعنا الفذ طرا",45,"ر",2,0],["وجسمٌ من تباعُدِكُمْ نَحيلٌ","عليه من السَّقامِ لكم رِداءُ",46,"ا",2,0],["وجسرني وفاؤك لي أن","أذاقني الردى غب التجاسر",47,"ر",1,0],["وجسمانيةً فزنا","بها بالقبرِ مِن مريمْ",48,"م",1,0],["وجسمك دون قدرِك وهو فانٍ","به المفتون أنت وفي تلاهي",49,"ي",1,0],["وجسمك فاعطه حقاً بشرعٍ","ومنه على الثرى وضع الجباه",49,"ه",1,0],["وجسمه صور نفخ روح","بأمره تحشر الرفات",50,"ت",1,0],["وَجِسْمُ نُورٍ تَرَاهُ يَبْدُو","كَنَاظِرٍ فِي قَمِيْصِ نَارِ",51,"ر",1,0],["وَجِسْمُ هواءٍ وإنْ لَمْ يَكُنْ","يُرَى للهَوَاءِ بِكَفِّ شَبَحْ",52,"ح",1,0],["وجسومنا متدرعات كلها","والسيف مستل من الأغماد",53,"د",1,0],["وجسمهم في الحس كل مجسم","وأورثهم عز المقام به ذلا",54,"ل",2,0],["وجسم الهدى الرحب السبيل وروحه","ولفظ العلى الفخم الأصيل ومعناه",55,"ا",2,0],["وجسي العود فالعود","عن الأرزاء يقصيني",56,"ن",2,0],["وجسمٌ كرقراقِ الشرابِ غضارةً","وردفٌ ثقيلٌ ثابتٌ متأيّد",57,"د",1,0],["وَجِسمٌ كما الدِّيباجُ وَالساقُ مُدمَجٌ","وَوَجنَتُهُ كالوَردِ إِذ طابَ مَجناهُ",58,"ا",2,0],["وَجِسميَ مَبنيٌّ عَلى السُّقمِ وَالضّنا","وَلَم يَكُ إِلّا اِسماً لَقَد أَشبَهَ الحَرفا",59,"ف",2,0],["وَجِسماً لاحَ في مُخْضَرِّ ثَوْبٍ","بَدا مِنْ تَحتِهِ مِثلُ النُّضارِ",60,"ر",1,0],["وَجسمهُ كانَ بِالحنّاءِ يَصبِغُهُ","فَشِمتُهُ قَد طَلى البِلَّورَ بالذّهبِ",61,"ب",1,0],["وَجِسمي الهوى ثمّ الأَضالعُ صَبوتي","وَكَبدي الجَوى وَالقَلبُ مِنّي غَرامُهُ",62,"م",2,0],["وجَسْرةٌ تتجلَّى الهمومُ بها","نعم وينُفَى عن قربها النكد",63,"د",1,0],["وجسْرةٍ بُهزرٍ وجْناء جبتُ بها الْ","بَيْداء وهْيَ خيارُ الأنيق النجُب",64,"ب",1,1],["وجسوم قد تفانت","ونفوس في سياق",65,"ق",1,0],["وَجِسمٌ تَجَدَّلَ فَوقَ الهِضابِ","تُناوشُهُ جارِحاتُ الفَلا",66,"ا",1,0],["وَجِسْمِي سَقِيمٌ قَدْ أَضَرَّ بِهِ النَّوى","وَغُصْنُ شَبَابي بالْقَطِيعَةِ قَدْ ذَوى",67,"ذ",3,0],["وجسمي من حبها مسقم","وحالي حال بأمر خطيرِ",68,"ر",1,0],["وجسمه بعد حسن اللحف يلحفه","قتام ضرب من الأحجار والخشب",69,"ب",1,0],["وَجس بعسكرك المَنصور محتَكِما","أَرض العِدى فَالَّذي عَودت مَعلوم",70,"م",1,0],["وجسمها في الورى عزيز","وقدرها عندهم مهين",71,"ن",1,0],["وجسمٌ شجَتْه النَّوى","فلِلسُّقْمِ فيه أَثَرْ",72,"ر",1,0],["وجسمك الناحل","وخطوك الحزين",73,"ن",1,0],["وجسدٍ أنْحَلَه ذكرهُمُ","ومضجع ينبو إذا النّجمُ خَفَق",74,"ق",1,0],["وجسمُك ساكنٌ مِنها بعيداً","ولسنَا في الحشا مُتباعِدَينِ",75,"ن",1,0],["وجسومها في الخلد ألا إنها","طبعت بعرصة كربلا لصفائها",76,"ا",3,0],["وَجِسمي مِثلُ ما يَحوي","كَمَرّانِ الكَمَّراني",77,"ي",1,0],["وجسمي في هواها طريح وجد","وحبٌ ماله نهى وآخر",78,"ر",1,0],["وجسمه نسجت هوج الرياح له","ثوباً بقاني دم الأوداج مزوررا",79,"ر",2,0],["وجسومهم تحت السنابك بالعرا","ورؤوسهم فوق الرماح العاليه",80,"ي",2,0],["وجسم ثوى فوق الصعيد ورأسه","تبوء أطراف الصعاد مصاعدا",81,"د",2,0],["وجسم بحر ندى في الترب منعفر","ورأس بدر هدى في الرمح ينتصب",82,"ب",1,0],["وَجَسرَةٍ حَرَجٍ تدمى مَناسِمُها","أَعمَلتُها بي حَتّى تَقطَعَ البيدا",83,"د",2,0],["وجسمى كما شاء الجوى متمزق","وعينى كما شاء الغرام تفور",84,"ر",1,0],["وَجسمه مِن عَزمه","جَميعه قَد رَعشا",85,"ش",2,0],["وجسم براه الشوق وجدا ولوعة","وقامت عليه بالسقام حروبه",86,"ب",2,0],["وَجسمي إِذا رُمتُ اِضطِجاعاً لِراحَةٍ","يَقلَّب عَلى جَمرِ الغَضا ثُم يَحتَذي",87,"ذ",2,0],["وجسمي من تذكرها","أسير الهم والحمّى",88,"م",2,0],["وجسم تراجع بعد النماء","كزرعٍ تناهى وبردٍ سمل",89,"ل",1,0],["وجِسمُكَ من عِلَّةٍ وازوِرارٍ","تُؤلِّمُهُ نظرَةُ العاذِرِ",90,"ر",1,0],["وجسمي من سقامي في نحول","وكأس الصبر مشروبي وزادي",91,"د",2,0],["وجسم لا تكون الروح فيه","جماد عند أرباب السداد",91,"د",1,0],["وجسمي من شوق لمنضود ثغره","غدا عرضا لمّا بدا وهو جوهر",92,"ر",1,0],["وجسوم لقى على الأرض تشكو","ما بها من اصابة وسقام",93,"م",1,0],["وَجسمٌ نُضارِيّ يَكادُ نَضارَةً","يُؤثِّرُ فيهِ أَن أَقولَ يُؤثِّرُ",94,"ر",1,0],["وجسمك من ظهرِ البَسيطة مَدرةٌ","تريد اكتشافَ الغيبِ ذَلِكَ عبرة",95,"ر",2,0],["وجسم لحكمة وبه تكلمت","وبسره صارت في الأرض خليفة",96,"ه",1,0],["وجسمهُ من نحول كالخلال غدا","وقد تشبَّه نور الوجه بالظلم",97,"م",1,0],["وجسمك في الثرى أمسى عفيرا","ثلاثاً لا يرى لحدا وقبرا",98,"ر",2,0],["وجسمي معتلّ ووجدي مضاعف","سروري منقوص وحزني زائدُ",99,"د",1,0],["وجسمٌ جَمُوحُ الطِرفِ من غير كابحٍ","ونفسٌ طَمُوح الطَرفِ من غيرِ راقبِ",100,"ب",1,0],["وَجسومُنا يَومَ المَجال مَنيعةٌ","وَنفوسُنا دُون الأَحبة تُمنَح",101,"ح",1,0],["وَجسمي كَما رام القَضا عادم القِوَى","وَإِن كان حزمي ثابتاً وَأجيد",102,"د",1,0],["وَجسمي في الهَوى دَنفٌ وَقَلبي","عَليلٌ ذا وَهَذا في غَليل",103,"ل",1,0],["وجست يداً كانت نطاقاً لخصرها","فلا رمقاً فيها تحس ولا دما",104,"م",2,0],["وجسَرتُ ثم جببت عن فمِه","يُعطى الغرامُ ويمنَعِ الفَرقُ",105,"ق",1,0],["وجسرتُ ثم جبنتُ عن فمه","يُعطي الغرام ويُمنع الفَرِقُ",106,"ق",1,0],["وجسمي ملك لبعلي حلال","على غيره أبدا حرما",107,"م",2,0],["وجسمها ثم سري","لديكم حيث كنتم",108,"م",1,0],["وجُستَ خِلال المروَتينِ فلم تدَع","حَطيماً وَلَم تَترُك ببكةَ مَشعرا",109,"ر",2,0],["وجسمي ضئيل ولم تُقِمه دعائمٌ","وهل للخوي الذاتيّ تجدي الدعائمُ",110,"م",1,0],["وجسم نحيل لو تخيل من نحا","تخيل مرأى ظله ضلّ اذ ينحو",111,"ح",2,0],["وجسم براه الشوق حتى يكاد لا","يراه حديد الطرف وقت الضحى صحوا",112,"و",2,0],["وجسوم عترة أحمد منبوذةً","رهن الفيافي لا ترى تكفينها",113,"ن",3,0],["وجسومهم تعدو العوادي فوقها","ما بين إيراد إلى إصدار",114,"ر",1,0],["وجسميَ من فرط السقام لَقَد غدا","أسير نسيمٍ سائراً حيثما يسري",115,"ر",2,0],["وجسمك منهوك ودمعك ذارف","وعيناك بالعوار تكتحلان",116,"ن",1,0],["وجسوماً من دونها الشهب فيها","فاخرت أرض كربلاء السماءا",117,"ا",3,0],["وَجُسومُ هَذا الناسِ أَنفاسُ الثَرى","لا بُدَّ يَوماً لِلثَرى أَن تَرجِعا",118,"ع",2,0],["وجسومه