{"poems":[[53,"حلفت بأعلام المحصب من منى","https://www.aldiwan.net/poem30724.html","الطويل"],[83,"ذيب نرهن ذا الغفاره","https://www.aldiwan.net/poem54202.html","مجزوء الرمل"],[88,"رمت مسمعي ليلا بأنه مؤلم","https://www.aldiwan.net/poem45022.html","الطويل"],[70,"أيا من راح عن حالي","https://www.aldiwan.net/poem43007.html","مجزوء الوافر"],[43,"أيدري ما أرابك من يريب","https://www.aldiwan.net/poem9458.html","الوافر"],[62,"يا طالبا لنهايات العلوم ولم","https://www.aldiwan.net/poem52183.html","البسيط"],[62,"يا قاتل الله معشرا ظلموا الحكمة","https://www.aldiwan.net/poem52237.html","المنسرح"],[61,"وجسوم إذا الرؤوس علتهن","https://www.aldiwan.net/poem51588.html","الخفيف"],[66,"شجى وشفى لما شدا وترنما","https://www.aldiwan.net/poem39510.html","الطويل"],[80,"وجسم له من غيره روح لذة","https://www.aldiwan.net/poem31563.html","الطويل"],[105,"إلى القوم الألى جمعوا الجموعا","https://www.aldiwan.net/poem44203.html","الوافر"],[52,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[46,"رياضك غير دائمة فروضي","https://www.aldiwan.net/poem22892.html","الوافر"],[46,"أيا شجر العرا أوسعت ريا","https://www.aldiwan.net/poem22995.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85325","الوافر"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9958","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54752","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43900","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54286","الطويل"],[100,"كلّنا في انتظار ميلاد الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=50117",""],[110,"أخا الريم ما هذي العيون القواتل","https://www.aldiwan.net/poem16325.html","الطويل"],[116,"الا يا من به يجلى الظلام","https://www.aldiwan.net/poem40599.html","عموديه"],[128,"ما هاجك اليوم من رسم وأطلال","https://www.aldiwan.net/poem24261.html","البسيط"],[129,"رحلتم والمدامع في انسكاب","https://www.aldiwan.net/poem50663.html","الوافر"],[130,"وقفت وقد ضاق بي","https://www.aldiwan.net/poem67448.html","مجزوء الكامل"],[151,"تزودت من مدح النبي المؤيد","https://www.aldiwan.net/poem68589.html","الطويل"],[151,"بمدح النبي اقطع زمانك ترشد","https://www.aldiwan.net/poem68596.html","الطويل"],[161,"متى ياتي بقربكم البشير","https://www.aldiwan.net/poem58949.html","الوافر"],[161,"شهود الهوى منى علي عذول","https://www.aldiwan.net/poem58955.html","الطويل"],[224,"ألدمع من عيني لم يذرف","https://www.aldiwan.net/poem41626.html","السريع"],[230,"اصبرا وهذا وافد البين نازل","https://www.aldiwan.net/poem50884.html","الطويل"],[260,"فؤاد على غصن الصبابة ساجع","https://www.aldiwan.net/poem35548.html","الطويل"],[271,"قصرت ما طال من هم ومن حزن","https://www.aldiwan.net/poem35262.html","البسيط"],[305,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[329,"أطرقي أطرقي فقد ضمك","https://www.aldiwan.net/poem54948.html","الخفيف"],[329,"سألقاك حين تنام النجوم","https://www.aldiwan.net/poem54999.html","المتقارب"],[343,"شارد اللب والفكر","https://www.aldiwan.net/poem55314.html","مجزوء الخفيف"],[351,"أعرفت رسم الدار بالحبس","https://www.aldiwan.net/poem640.html",""],[403,"عدمت اللقا إن لم أوافك زائرا","https://www.aldiwan.net/poem46422.html","الطويل"],[410,"تهن يا أطول الملوك يدا","https://www.aldiwan.net/poem31713.html","عموديه"],[442,"فؤاد بنيران المصاب مفأد","https://www.aldiwan.net/poem14450.html","الطويل"],[459,"أزائرة كما زعم الخيال","https://www.aldiwan.net/poem56081.html","الوافر"],[465,"أتهويماً وليل الهم داجي","https://www.aldiwan.net/poem3585.html","عموديه"],[480,"أيان وقفت على الرمم","https://www.aldiwan.net/poem36883.html","المتدارك"],[480,"ما للقريض تعاصى","https://www.aldiwan.net/poem36906.html","المجتث"],[501,"علامة حبكم قلب لهيف","https://www.aldiwan.net/poem38104.html","الوافر"],[514,"أمنت عليك صرف الدهر حتى","https://www.aldiwan.net/poem67741.html","الوافر"],[559,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[559,"عليك بروحك السر الإلهي","https://www.aldiwan.net/poem33652.html","الوافر"],[559,"كل أناس لهم لغات","https://www.aldiwan.net/poem34724.html","مخلع البسيط"],[568,"قم فاعقر الهم بالعقار","https://www.aldiwan.net/poem69658.html","مخلع البسيط"],[568,"عراني الزمان بأحداثه","https://www.aldiwan.net/poem69758.html","المتقارب"]],"verses":[["وَجِسمٌ إِذا جَرَّدتَهُ مِن قَميصِهِ","عَلى الناسِ قالوا هَكَذا يَفعَلُ الحُبُّ",0,"ب",1,0],["وجسم أبيض مدلفن","مثل جبنة ان طريّا",1,"ي",2,0],["وجسماً نحيفاً أنهكته همومُه","فكادت تراه العينُ بعضَ تَوَهُّم",2,"م",1,0],["وَجِسمٌ جالَتِ الأَسقا","مُ فيهِ فَراحَ مُنتَهَبا",3,"ب",2,0],["وَجِسمُكَ فَوقَ هِمَّةِ كُلِّ داءٍ","فَقُربُ أَقَلِّها مِنهُ عَجيبُ",4,"ب",1,0],["وجَسِّدِ الروح بالترداد فهو لنا","نار تحلّل ما يبقى من المَدَرِ",5,"ر",1,0],["وجسّدوا الشيء ما له جسد","وقد وصلتم وحزتم الأربا",6,"ب",2,0],["وجسومٍ إذا الرؤوسُ عَلَتْهُنْ","نَ أثارَتْ حلَّت قُواها الرؤوسُ",7,"س",1,1],["وَجَسَّ مِنَ الأَوتارِ مَثنىً وَمَثلَثاً","فَحَقَّت بِنا الأَفراحُ فَرداً وَتَوأَما",8,"م",2,0],["وجسمٍ له من غيْرِهِ روحُ لذةٍ","سليلِ ضروعٍ أُرْضِعَتْ حَلَبَ السُّحبِ",9,"ب",1,1],["وجسمُك واهنُ الأعضاءِ دامِ","أمالكَ يا ابن بشرٍ في السَّلامِ",10,"م",1,0],["وَجَسَدٍ عَلَيهِ جِلدٌ مِن وَسَخ","كَأَنَّهُ أُشرِبَ نَفطاً أَو لُطَخ",11,"خ",1,0],["وجُسومٌ كَأَنَّمَا رَحَضَتْهَا","منْ عظيم المَهَابَةِ الرُّحَضاءُ",12,"ا",2,0],["وَجِسمُ المَرءِ بِالأَغراضِ رَبعٌ","فَهَل زَكّاهُ تَزكِيَةَ العُروضِ",13,"ض",1,0],["وَجِسمي شَمعَةٌ وَالنَفسُ نارٌ","إِذا حانَ الرَدى خَمَدَت بِأُفِّ",14,"ف",1,0],["وجسم المرء تبنيه خلايا","زمانُ حياتها فيه زهيد",15,"د",1,0],["وَجِسمي في جِبالِ الرَملِ مَلقىً","خَيالٌ يَرتَجي طَيفَ الخَيالِ",16,"ل",1,0],["وَجِسْمِي عَلِيلٌ حَارَ فِيهَ طَبِيبُهُ","وَهَمِّي ثَقِيلٌ قَلَّ فِيهِ المُسَاعِد",17,"د",1,0],["وجسمِي الّذي أَبلاه فقدُكَ إن أكن","رحَلتُ به فالقلبُ عندَكَ خيَّما",18,"م",2,0],["وجسَّ مكانَ الداءِ أَوَّلَ نَظرةٍ","كأنَّ له عِلْماً بموضِعه قِدْما",19,"م",2,0],["وجسوم حمر تنوش جسوما","في ثياب من الجراحات حمر",20,"ر",1,0],["وَجِسمي لِضيفان السقام مَوائِدٌ","وَدَمعي لِزوّار الغَرام مَناهِلُ",21,"ل",1,0],["وجسم للقلا اضحى سقيما","كأن عليه لم يشدد حزام",22,"م",1,0],["وَجَسرَة الخَلقِ مَنفوجٍ مَرافِقُها","عَيرانَةٍ كَوبيلِ القشِّ شِملالِ",23,"ل",1,0],["وجسمي من صُدُودكمُ نحيلٌ","فهلاّ من رجوع أو إيابِ",24,"ب",1,0],["وجِسمي دَهاهُ العَنا","حَنانَيكَ خُذ بيدي",25,"ي",1,0],["وَجِسمي رَهينٌ لِلتَحَرُّقِ وَالنَشظِ","أَقَمتُ عَلى شَوقٍ صَليتُ بِجَمرِهِ",26,"ه",1,0],["وَجُسنا ديارَ الشِركِ نُبرىءُ أَو نَبري","فَكَم وَجنَةٍ دُسنا هُناكَ وَجَبهَةٍ",27,"ه",1,0],["وجسمٌ بالنحول يكادث يخفى","لقد حدثت وراءَكم أُمور",28,"ر",1,0],["وجسم محاه السقم لولا قميصه","بدا شبح كالظل كاد يزول",29,"ل",1,0],["وَجَسدٌ أَبلى بهِ سَقمه","يَكادُ لَولا ثَوبِهِ يَختَفي",30,"ف",2,0],["وجسمك إن لم يظعنوا عنك ناحِل","وقلبك إن بانوا مع الركبِ راحِل",31,"ل",1,0],["وجسمٌ حرامٌ من قوام مضاجع","يغرّد شوقاً والحطيم الأضالع",32,"ع",1,0],["وجسَّ أوتارَ عودٍ بالهوى شعرت","والعَب بأفئِدةٍ كالموجِ بالسُّفُن",33,"ن",1,0],["وجسر على متن الجحيم وموقف","طويل وأهوال الحساب المهولة",34,"ه",1,0],["وجسوم أشقيتها بالتنائي","وجسوم أسعدتها بالتلاقي",35,"ي",1,0],["وجسمي ستعصرُه كرمَةً","وتسقى شبابك من خمرها",36,"ر",3,0],["وجسوم نواحل","لا وقاء ولا وزر",37,"ر",1,0],["وَجَسيمِ هَمٍّ قَد رحَلتُ له","حَتّى تؤوبَ بليَّةً عنسي",38,"س",2,0],["وجسماً ضعيفاً مثل خَصْركِ ناحلاً","وعزمَ اصْطبارٍ مثل جفنكِ فاترا",39,"ر",2,0],["وجست أرض العدا وأفنيت من","أبطالهم ما يجاوز العددا",40,"د",2,0],["وجسم براه الحزن كالبري بالمدى","فصار كمثل السلك في الحرب تسرد",41,"د",1,0],["وجسَّركِ الجمالُ على التجنّي","ألا يا قبحَ ما صنع الجمالُ",42,"ل",1,0],["وجسمٍ حسمُ داء الهمِّ فيهِ","إذا ما ألهمُّ جلَّ عن العلاج",43,"ج",1,0],["وجسوم الخلق عناصرها","فسل الأجداث عن الأمم",44,"م",1,0],["وجساء يسأل عفوا","من جمعنا الفذ طرا",45,"ر",2,0],["وجسمٌ من تباعُدِكُمْ نَحيلٌ","عليه من السَّقامِ لكم رِداءُ",46,"ا",2,0],["وجسرني وفاؤك لي أن","أذاقني الردى غب التجاسر",47,"ر",1,0],["وجسمانيةً فزنا","بها بالقبرِ مِن مريمْ",48,"م",1,0],["وجسمك دون قدرِك وهو فانٍ","به المفتون أنت وفي تلاهي",49,"ي",1,0],["وجسمك فاعطه حقاً بشرعٍ","ومنه على الثرى وضع الجباه",49,"ه",1,0],["وجسمه صور نفخ روح","بأمره تحشر الرفات",50,"ت",1,0],["وَجِسْمُ نُورٍ تَرَاهُ يَبْدُو","كَنَاظِرٍ فِي قَمِيْصِ نَارِ",51,"ر",1,0],["وَجِسْمُ هواءٍ وإنْ لَمْ يَكُنْ","يُرَى للهَوَاءِ بِكَفِّ شَبَحْ",52,"ح",1,0]]}