{"poems":[[65,"نبأ تقاصر دونه الأنباء","https://www.aldiwan.net/poem46201.html","الكامل"],[10,"يا عين جودي بالدموع","https://www.aldiwan.net/poem21064.html","مجزوء الكامل"],[53,"أصل نما بك ربه فرعه","https://www.aldiwan.net/poem65410.html","أحذ الكامل"],[47,"طيف تأوب من سعدى فحياني","https://www.aldiwan.net/poem66664.html","البسيط"],[82,"بكرت تغازله الدمى الأبكار","https://www.aldiwan.net/poem31431.html","الكامل"],[82,"صادتك مهاة لم تصد","https://www.aldiwan.net/poem31480.html","المتدارك"],[76,"خذها إليك وإنها لنضيرة","https://www.aldiwan.net/poem12814.html","الكامل"],[76,"وندي أنس هزني","https://www.aldiwan.net/poem12843.html","مجزوء الكامل"],[76,"يممت من علياك خير ميمم","https://www.aldiwan.net/poem13254.html","الكامل"],[77,"الشمس عنه كليلة أجفانها","https://www.aldiwan.net/poem69029.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85447","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54970","السريع"],[111,"جرد النفس وانهها عن هواها","https://www.poetsgate.com/ViewPoem.aspx?id=530",""],[102,"بين ليل وفجر","https://www.poetsgate.com/ViewPoem.aspx?id=50195",""],[141,"أني سمعت خليلي","https://www.aldiwan.net/poem67929.html","المجتث"],[164,"في كل يوم عارض لك يمطر","https://www.aldiwan.net/poem58991.html","الكامل"],[173,"يا باكياً لدمنة وأربع","https://www.aldiwan.net/poem1635.html",""],[240,"لك ذروة البيت العتيق عماده","https://www.aldiwan.net/poem32098.html","الكامل"],[276,"أفق هديت من التبريح والكمد","https://www.aldiwan.net/poem52105.html","البسيط"],[276,"خل الغرام لصب دمعه دمه","https://www.aldiwan.net/poem52119.html","البسيط"],[376,"لا بتماديك على هجري","https://www.aldiwan.net/poem57430.html","السريع"],[406,"برقية شعرية إلى الصحافة العربية","https://www.aldiwan.net/poem10295.html","عموديه"],[454,"يئس الصغار من الكبار","https://www.aldiwan.net/poem995.html",""],[457,"مالي أطارح نحو أسود صادح","https://www.aldiwan.net/poem13692.html","الكامل"],[463,"عسى معرض وجهه مقبل","https://www.aldiwan.net/poem55971.html","المتقارب"],[463,"نبهت سعدا والأفق","https://www.aldiwan.net/poem56086.html","مجزوء الرجز"],[469,"هي دار مية يا طليق العدل","https://www.aldiwan.net/poem3282.html","عموديه"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96979","الكامل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39016","الكامل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122333","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70857","الخفيف"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59532","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59411","البسيط"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64625","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79807","الكامل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113939","البسيط"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125371","الخفيف"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87693","السريع"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112602","البسيط"],[3173,"","https://poetry.dctabudhabi.ae/diwan/poem/76553","الكامل"],[3836,"","https://poetry.dctabudhabi.ae/diwan/poem/99277","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111506","السريع"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76729","الكامل"],[4764,"يا ليل","https://www.poetsgate.com/ViewPoem.aspx?id=28388",""],[585,"تلك القبور وماثل الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=161873",""],[3591,"كل يرى حسناً من لم يكن حسنا","https://www.poetsgate.com/ViewPoem.aspx?id=149412",""],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""],[5277,"بعْني شذاكَ","https://www.poetsgate.com/ViewPoem.aspx?id=206050",""],[5433,"عزة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=36120",""],[5436,"علم المجد (جواد بركات علي)","https://www.poetsgate.com/ViewPoem.aspx?id=34819",""],[5648,"العلم مده والصدر هات مافيه","https://www.poetsgate.com/ViewPoem.aspx?id=156417",""],[5674,"القرطاس والقلم","https://www.poetsgate.com/ViewPoem.aspx?id=189080",""],[5691,"فتنَةُ كربُلاء...!","https://www.poetsgate.com/ViewPoem.aspx?id=206635",""],[5725,"همس العيون","https://www.poetsgate.com/ViewPoem.aspx?id=191976",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[5786,"لعاذلي قلبٌ ولي قلْبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50652",""],[5845,"أفقْ هديتَ منَ التبرجِ والكمدِ","https://www.poetsgate.com/ViewPoem.aspx?id=198482",""],[5851,"الوطن المسافر","https://www.poetsgate.com/ViewPoem.aspx?id=175286",""],[5952,"أسِل دموعَك","https://www.poetsgate.com/ViewPoem.aspx?id=196704",""],[5956,"قلبي سقط","https://www.poetsgate.com/ViewPoem.aspx?id=192227",""],[5974,"نسائم العشق","https://www.poetsgate.com/ViewPoem.aspx?id=213853",""],[6115,"بعض البشر ودك تصكه بمشعاب","https://www.poetsgate.com/ViewPoem.aspx?id=180527",""],[6198,"الموجةُ الطروبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79239&r=&rc=13",""],[6296,"مد جديد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75694&r=&rc=25",""]],"verses":[["يَنْدُبْنَ أحْمَدَ فالبِلادُ خَواشِعٌ","والأرضُ تُعْوِلُ والصّباحُ مَساءُ",0,"ا",2,0],["يَندُبنَ فَقدَ أَخي النَدى","وَالخَيرِ وَالشِيَمِ الصَوالِح",1,"ح",1,0],["يندى ويصلب عوده فترى","لَدنَ المهزة صادق المنعه",2,"ع",2,0],["يَندى حَياءٍ وَتَندى كَفُّهُ كَرَماً","كَاللَيثِ تَخلِجُهُ في الجَوِّ ريحانِ",3,"ن",1,0],["يَنْدى بلا وَعْدٍ وكم من عارضٍ","من غير بَرْقٍ صوبه مدرارُ",4,"ر",1,0],["يَندى بِالمِسكِ لِراشِفِهِ","وسلافِ القَهوةِ والشهدِ",5,"د",1,0],["يَندى بِها وَجهُ النَدِيِّ وَرُبَّما","بَسَطَت هُناكَ أَسِرَّةَ السَرّاءِ",6,"ر",3,0],["يَندى بِأَخلاقِ الصِحابِ","هُناكَ لابِنَدى السَحابِ",7,"ب",1,0],["يَندى بِهِ النَبتُ الهَشيمُ نَضارَةً","وَيَنِمُّ ذَيلُ الريحِ طيبَ تَنَسُّمِ",8,"م",1,0],["يَنْدى فتنْشأُ في تَنَقُّلِ فَيْئِهِ","غُرُّ السحائبِ مُسبِلاً هَطَلانها",9,"ن",3,0],["يندبن فَقَد وليهن","نَ وَضيعة الحامي الكَبير",10,"ر",1,0],["يَنْدُرُ أَنْ تُطْهى فَإِيامُهَا","مِنْ بَهْجَةٍ أَيامُ أَعْرَاسِ",11,"س",1,0],["\" يندبون اللوى واندب نجدا\"","\" كل عين تبكي على ما شجاها\"",12,"ا",3,0],["يندى وينثر في البقاع أريجه","ويرشّ درب الفجر بالنّسمات",13,"ت",1,0],["يَندُبنَ شَيخاً كَبيراً","قَد كانَ يَعضُدُهُنَّه",14,"ن",2,0],["يندى فيقطر للحيا من وجهه","ماء به نار الحروب تسعر",15,"ر",1,0],["يَندُبنَ يا جَدَّهُ لَو رَأَيتَنا","نُسلَبُ كُلَّ مِعجَرٍ وَبُرقُعِ",16,"ع",1,0],["يُندي السَريرَ بِوَطإِهِ وَتَكادُ أَن","تَخضَرَّ حينَ يَمَسُّهُ أَعوادُهُ",17,"د",2,0],["يندى عَلى الآل والازواج عارضها","وَالصحب من نسمات الند كل ندى",18,"د",2,0],["يندى عَبير أَو مسكا صوب عارضها","وَيبدأ الذكر ذكراها وَيختمه",19,"م",2,0],["يَندى ويستكتمُنا والندى","نعمَ مُنادي البَدو والحَضرِ",20,"ر",1,0],["يندس فيكم كاتب متحامل","متطاول ومراسل كذابُ",21,"ب",1,0],["يندبن لا من ماسح لدموعهن","مروءة أو راحم لصغار",22,"ر",1,0],["يندي يمنتحل الرَذَاذ جناحه","فيظلُّ مرتعشاً بِطلّ راشح",23,"ح",1,0],["يندّ القذى إن تَلاقت عليه","جفونٌ برؤيته تُكحلُ",24,"ل",1,0],["يندبن آثاراً وعه","داً كان حرّاً فأبقْ",25,"ق",1,0],["يندى وما حسرَ السؤال لثامهُ","وأخو الندى يندى وإن لم يسأل",26,"ل",1,0],["يندبن قوماً ما هتفن بذكرهم","إلا تضعضع كل ليثٍ عرين",27,"ن",1,0],["يَندى على جَنباتِه قَطْرُ النَّدى","فاعجَبْ له ماءً وناراً قَدْ مُلي",28,"ل",2,0],["يندى الثر من عظامي كلما بليت","ولا يزال عليه ينبت الكمد",29,"د",1,0],["يندُب الماضيات في عرصات","الدار مُسْتَقْبِلَ الثلاث الأثافي",30,"ف",2,0],["يندى به ماء الشبيبة والحيا","ويْلاه من كلفي وعهد شبابي",31,"ب",2,0],["يندى حياء إذا تهمي يداه ندى","كأنها روضة يجري بها نيل",32,"ل",1,0],["يندك دك الطور ما تصدمه","ولو ترقت فلك النجم انزوى",33,"ا",1,0],["يَندبنَ أَوَّل مُنجدٍ","يوم الوَغى لهف الصياح",34,"ح",1,0],["يَندُبنَ نَدباً أبِيَّ الضَيمِ ذا فجَرٍ","حُلوَ الشمائِل في العَزّاءِ محمودا",35,"د",2,0],["يندُبُ الكلُّ حظَّ مِصرَ وَيَشكُو","جَورَ دَهرٍ يُسيءُ للإِحسانِ",36,"ن",1,0],["يَندَفع التَيار في لُجِهِ","فَسائِلِ اللجة مِن دافعه",37,"ع",2,0],["يندس واحدهم في أيّ مجتمع","كأنه بينه للذل عنوان",38,"ن",1,0],["يَندى بِماءِ الوَرد مُسبَلُ شعرِها","كَالطلّ يَسقُط مِن جَناحِ الطائِر",39,"ر",1,0],["يَنْدَى ويَدْمَى تارةً فكأنما","لَمَسَتْ مضاربَهُ يَدَا رِضْوَانِ",40,"ن",1,0],["يندبن خطباً جل فيهن حل","وحول آخيل سراة الملل",41,"ل",1,0],["يندى له رطب الهواء فيغتدي","وَيُظلُّهُ وَرقُ الغصون فيهجع",42,"ع",1,0],["يندى عليك وأنت منه خائف","وكذاك لجَ البحر مغن مفزع",42,"ع",1,0],["يِنده ويصرخ ، تتنفض (يا مُهجتي لبييييه)","العين لك فدوه ترى ، اهيا وراعيها",43,"ي",3,0],["يندس آونةً ويسنح تارةً","خلف الوهاد ومن وراء جبال",44,"ل",1,0],["يندي لسائلهِ الحسنى بلا منن","وليس يحتقر الناءي الذي أمتهنا",45,"ن",2,0],["يندحر الحجاج تحت قهره","وعروة الحجاج أوثق العرى",46,"ا",1,0],["يندسُّ في طرقي والشوقُ يقلقُهُ","وسايرَ الشوقَ في آثارِهِ قلقي",47,"ق",2,0],["يندمل جرح القلب ماتت احلامه","بس ما اظن يبرى جرح الاحساسي",48,"س",2,0],["يندى الجبين وكلنا خجل","إن رفّ في عليائنا الورم",49,"م",1,0],["يندب حضوضه والقدر مارضابه","ولاله عن المكتوب لاصار راعيه",50,"ي",2,0],["ينداحُ من خلل النوافذ صاخبا","يخضلّ في رطب الشعور هطولُ",51,"ل",1,0],["ينْدُبونَ الحُسيْنَ جَلْداً ولطْما","حيْثُ ضلّوا عنِ الحَقيقَةِ فهْما",52,"م",2,1],["يندسّ من تحت اللواحظ ليلها","والليل يخفي مايروه تأثّما",53,"م",2,0],["يندبن العرب لاولى القبلتين","لطخةٍ بالعار بيدين الجنات",54,"ت",1,0],["يندبني الشّوقُ لأبكي بها","وليس يُجدي النوحُ والندبُ",55,"ب",1,0],["يندي على الآلِ والأرواحِ عارضها","والصحبَ منْ نسماتِ الندِّ كلُّ ندي",56,"د",2,0],["يندس فيك التيه يافجر الرؤى","يا موطنا قد كلّ من أسفاره",57,"ر",2,0],["يندى الجبين لقول الحق فى زمنٍ","ظن الورى أنهم ينجيهم الخَرَسُ",58,"س",1,0],["ينداح دمعي كالشهاب مكَفِّناً","حُلُمي ويوْدِعُها الثرى حيث اختلطْ",59,"ط",1,0],["ينداح في رقة بين الضلوع كما","أقداح ملهمة باتت تناجيني",60,"ن",2,0],["يندس مثل اللى تدرّق ورى الباب","ياهملالي منه يا هملالي",61,"ل",2,0],["يَنْدُبْنَ آمالاً خَبَتْ... فلهنّ في","سَمْع الدجى... شجوٌ... وصوتُ نحيب",62,"ب",1,0],["ينداح مسك تجليها يجاذبني","شجو الصبابات والأسرار والسمرا",63,"ر",2,0]]}