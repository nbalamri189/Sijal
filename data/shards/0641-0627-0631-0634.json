{"poems":[[64,"قالوا صبرت على المكروه من نفر","https://www.aldiwan.net/poem52427.html","البسيط"],[68,"خذ من الدهر لي نصيب","https://www.aldiwan.net/poem41371.html","مجزوء الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141922","الرمل"],[92,"الشاعر الجبَار","https://www.poetsgate.com/ViewPoem.aspx?id=179153",""],[189,"ينازعني شوق إلى الثغر هاجس","https://www.aldiwan.net/poem14554.html","الطويل"],[228,"أسرعت لبابك أقرعه","https://www.aldiwan.net/poem41617.html","المتدارك"],[240,"حرام على الأجفان أن ترد الغمضا","https://www.aldiwan.net/poem31900.html","الطويل"],[302,"إذا ضلت قلوب عن هداها","https://www.aldiwan.net/poem33021.html","الوافر"],[310,"أعيذ صفاء الود من كدر العتب","https://www.aldiwan.net/poem56604.html","الطويل"],[422,"بلغتم كمال الرشد أبناء راشد","https://www.aldiwan.net/poem54010.html","الطويل"],[438,"ما ضر ذاك الريم ألا يريم","https://www.aldiwan.net/poem12725.html","السريع"],[463,"رق لبغداد القضاء والقدر","https://www.aldiwan.net/poem56181.html","الرجز"],[466,"لقد علم الأحياء دان ونازح","https://www.aldiwan.net/poem15399.html","الطويل"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129538","الكامل"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119281","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16710","الرمل"],[1320,"","https://poetry.dctabudhabi.ae/diwan/poem/198169","المنسرح"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79953","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79866","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79834","الكامل"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113808","الوافر"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60935","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93562","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100346","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132699","الطويل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130067","الوافر"],[3568,"","https://poetry.dctabudhabi.ae/diwan/poem/116521","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117857","الوافر"],[3913,"","https://poetry.dctabudhabi.ae/diwan/poem/198354","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77126","الوافر"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111053","البسيط"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105117","الطويل"],[382,"","https://poetry.dctabudhabi.ae/diwan/poem/112010","الوافر"],[4740,"قصة بلا أبطال","https://www.poetsgate.com/ViewPoem.aspx?id=198271",""],[4888,"في ظلِّ مكتبتي","https://www.poetsgate.com/ViewPoem.aspx?id=207731",""],[4935,"سلام الله يا ابن الأكرمينا","https://www.poetsgate.com/ViewPoem.aspx?id=129306",""],[5183,"نهر الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=186612",""],[308,"هَل الْبَرْق قد وشى مطارف ديجور","https://www.poetsgate.com/ViewPoem.aspx?id=189361",""],[5387,"أحبكِ","https://www.poetsgate.com/ViewPoem.aspx?id=50582",""],[5431,"بنٌ أفّاك!...","https://www.poetsgate.com/ViewPoem.aspx?id=208853",""],[5512,"المعلم","https://www.poetsgate.com/ViewPoem.aspx?id=204242",""],[5582,"بَدَتْ عَنْ وَجْهِها سَحَراً فَلاحَا","https://www.poetsgate.com/ViewPoem.aspx?id=186791",""],[5781,"سفرُ الشفاهِ..قصيدة وصلاة","https://www.poetsgate.com/ViewPoem.aspx?id=208989",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[6070,"مُدّي يَدَيكِ وهاكِ العَينَ والهدبا","https://www.poetsgate.com/ViewPoem.aspx?id=192689",""],[5309,"أيها الشاكي ولا ناصر له","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573539",""]],"verses":[["فارشحْ بخيرٍ وإن أعيتْكَ مقدرةٌ","فالغُصنُ يُحْطَبُ إن لم يعطِ بالثَّمرِ",0,"ر",1,0],["فَاِرشِفِ الراحَ يا حَبيب","إِنَّ في ذاكَ مُعتَبَر",1,"ر",1,0],["فارشي الطرقَ قلوباً وثغوراً وصداحا","غرةق من عبد شمسٍ تملأُ الليل صباحا",2,"ح",2,0],["فارشاً دربَهُ بشوك من الفقرِ","وجمرٍ من ضِغنةٍ وسخائِم",3,"م",1,0],["فأرشُفُ درّا لم يُثَقِّبه ناظمٌ","ونَوْرَ أقاح ما نَمَتْه المَغارس",4,"س",1,0],["فَاِرشيهِ بِعاطِفَةٍ يقنع","فَالحجَّةُ لَيسَت تقنَعُهُ",5,"ع",2,0],["فَأَرشَفَني مِن ريقِهِ بابِلِيَّةً","وَأَلثَمَني مِن ثَغرِهِ زَهَراً غَضّا",6,"ض",2,0],["فأَرشِدها جزاكَ اللَه خَيراً","بإرشادِ القلوب إِلى الصَوابِ",7,"ب",1,0],["فَأرشفُ راحاً من ثغورِ أقاحها","ببردِ الرضابِ العذبِ في اللؤلؤ الرطبِ",8,"ب",1,0],["فأَرْشَدْتَهم للخير حتَّى تركتَهم","يقولون إنَّ الرُّشْدَ فعل ابن راشد",9,"د",1,0],["فارشفْ بأسماعِكَ من قهوةٍ","ما أحدثتْ من ندمٍ للنديمْ",10,"م",1,0],["فأرشدَ المستبصرين بكُمُ","لو كان يُغنِي القلبُ أو يُغنِي البصرْ",11,"ر",1,0],["فأُرشدَ سارٍ بعد طول مضلَّةٍ","وأُنجِدَ مخذولٌ وأُيسرَ قانعُ",12,"ع",1,0],["فارشد محير شأنها","لا زلت مرشد كل حائر",13,"ر",1,0],["فأرشد شريداً شفه غشم غاشم","غشوم مشوم باشتهار المشاهد",14,"د",1,1],["فَاِرشَفِ الهَمَّ عَناءُ","إِنَّما الهَمُّ بَلاءُ",15,"ا",2,0],["فأرشدونا كيفَ السبيلُ فقد","ضاقت بنا في هواكُمُ الحِيَلُ",16,"ل",1,0],["فارشفْ أغرَّ كأَنَّ ناسقَ دُره","فيه تناول شهدةً فأذابها",17,"ب",3,0],["فارشفِ المجدَ في كلتيهما طَرباً","راحَ التهاني وقَرِّط سمعه نَغما",18,"م",2,0],["فارشف عروساً من طِلًى","جُليت على وَردِ الخدودِ",19,"د",1,0],["فأَرشَفَنا مِنَ الإكرام ثَوباً","يزيدُ على المدى طيباً ويَصفو",20,"ف",2,0],["فارشفني ثغراً ولاَصقني حَشاً","وافرشني شعْراً ووسَّدني يَدا",21,"د",2,0],["فارشف وشمَّ لَك الهَنا مِن ثَغرِها","كَأساً وَمِن وَجناتِها تفّاحَها",22,"ح",3,0],["فأرش مهيض قوادم","لك لست عنها بالمطيق",23,"ق",1,0],["فأرشد به للدين عوناً وناصراً","وامنع به حصناً لطه ومعقلا",24,"ل",2,0],["فأرشد نورهم من ضلّ منّا","إلى ضَعفِ الأُلى كذَبوا ومانوا",25,"ن",3,0],["فأرش جناحى مثلما","عودتنيه ولا جناح",26,"ح",1,0],["فأرشد للهدى من ليس يدري","لعمرك ما الحلال وما الحرام",27,"م",1,0],["فأرشف من تياك ريقة سلسل","وأرشف من ذياك ريقة أفلج",28,"ج",1,0],["فَأَرشِفُ مِن ثَناياها عِقاراً","بِها سُكري وَراقَ بِها الصَفاء",29,"ا",2,0],["فارشف لها مبسماً يفتر عن برد","واقبل لها زورة واصفح عن الخلل",30,"ل",1,0],["فارشفني من ثغره وحديثه","رحيقهما فازددت سكراً على سكر",31,"ر",1,0],["فأَرشَدَهم ولم يبغوا هداه","فأهملهم وليس لهم وقار",32,"ر",1,0],["فَأَرْشَدْتِ رُوحاً .. مِنْ ضَلاَلٍ إِلَى هُدىً","وَأَنْقَذْتِ قَلْباً ... كَانَ فِي بَاطِنِ الصَّخْرِ",33,"ر",1,0],["فأرشُفُ مِن غدائِرِها","على أيكِ العُلا أَثِبُ",34,"ب",1,0],["فأرشد قومه شرقاً وغرباً","ودافع عنهم حيناً فحينا",35,"ن",2,0],["فأرشدها لله نور جبينه","فشقت دجاها والرحال ركائبه",36,"ب",2,0],["فأرشفه كأس السلاف خطابها","وغازله من خطها أعين الْحور",37,"ر",1,0],["فأرشف منك دميعة ماءٍ","زلالٍ تذيبُ بقلبي الصدا",38,"د",2,0],["فارشف الكوب واستلذّ انعتاقي","إنما البن في الدم استبراكُ",39,"ك",1,0],["فارشِف رحيقاً إذا ما الثَّغرُ ينثرهُ","فكلُّ من لا يطالُ الزَّهرَ مكلومُ",40,"م",1,0],["فَأَرْشِفُ خَمْرَ راحَتِها مِزاجاً","وَأَرْشِفُ خَمْرَ مَبْسِمِها قَراحَا",41,"ح",2,0],["فأرشُقُ ذِكْراهُ بدِفْءِ مَراشِفي","ويا ليْتَ دونَ الحُلْمِ ريحُكَ تَزْأَرُ",42,"ر",1,0],["فأرشد للتوحيد إذ طمت الآفا","ق بالجهل والإشراك مرمى الشقاوتي",43,"ت",2,0],["فأرشد كل العلمين ووطدن","دعائم هذا الكون منه بنظرتي",43,"ت",2,0],["فارشفْ منَ المِسكِ هذا المِسْكُ مَسْكَنَهُ","في كفِّ طُهْرٍ ينادي الإبنَ إذْ ذهَبا",44,"ب",2,0],["فَارشِفا الماءَ الَّذي كَدَّرَهُ","بَعضُكُم حَتَّى تُحَلَّ المُشكِلَه",45,"ل",2,0]]}