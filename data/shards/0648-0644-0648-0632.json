{"poems":[[55,"قرت عيون المجد والفخر","https://www.aldiwan.net/poem30478.html","السريع"],[65,"سرى طيفها والليل رق ظلامه","https://www.aldiwan.net/poem46155.html","الطويل"],[57,"ألا أسعديني بالدموع السواكب","https://www.aldiwan.net/poem26543.html","الطويل"],[53,"ألم تسأل اليوم الظباء الكوانس","https://www.aldiwan.net/poem64666.html","الطويل"],[53,"قد حال للموعد المأمول حولان","https://www.aldiwan.net/poem66435.html","البسيط"],[87,"حياة ما نريد لها زيالا","https://www.aldiwan.net/poem62956.html","الوافر"],[87,"نجا وتماثل ربانها","https://www.aldiwan.net/poem63734.html","المتقارب"],[45,"إلام طماعية العاذل","https://www.aldiwan.net/poem9759.html","المتقارب"],[45,"إذا كان مدح فالنسيب المقدم","https://www.aldiwan.net/poem10143.html","الطويل"],[30,"ومن حين قحطاني سجستان أصبحوا","https://www.aldiwan.net/poem5106.html","الطويل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140971",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/142405","الوافر"],[234,"دليل على أن سوف يرديه ما لقي","https://www.aldiwan.net/poem50925.html","الطويل"],[240,"أيا السيد ما ساع","https://www.aldiwan.net/poem32026.html","الهزج"],[353,"برغمي إن خلت منه المذاود","https://www.aldiwan.net/poem20065.html","الوافر"],[382,"خليلي أما هذه فديارهم","https://www.aldiwan.net/poem59330.html","الطويل"],[454,"أثر النكسة 1967","https://www.aldiwan.net/poem992.html",""],[463,"لأية لبسة خلع الخلاعه","https://www.aldiwan.net/poem56137.html","الكامل"],[563,"وجودي جل عن جسمي","https://www.aldiwan.net/poem34248.html","الهزج"],[572,"متى تنشط للأكل","https://www.aldiwan.net/poem69479.html","الهزج"],[572,"له شغل عن سؤال الطلل","https://www.aldiwan.net/poem69529.html","المتقارب"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87220","البسيط"],[1056,"","https://poetry.dctabudhabi.ae/diwan/poem/178053","الطويل"],[1600,"","https://poetry.dctabudhabi.ae/diwan/poem/146095","الوافر"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108637","الوافر"],[1763,"","https://poetry.dctabudhabi.ae/diwan/poem/146061","الوافر"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47116","الطويل"],[2468,"","https://poetry.dctabudhabi.ae/diwan/poem/117823","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65989","الطويل"],[2869,"","https://poetry.dctabudhabi.ae/diwan/poem/145170","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202750","الطويل"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115432","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65175","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100853","البسيط"],[3200,"","https://poetry.dctabudhabi.ae/diwan/poem/146080","الوافر"],[3307,"","https://poetry.dctabudhabi.ae/diwan/poem/145537","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62873","المتقارب"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202341","الطويل"],[3901,"","https://poetry.dctabudhabi.ae/diwan/poem/141228","المتقارب"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119468","الطويل"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119493","الطويل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45056","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141684","الطويل"],[5121,"الْمِنْهَاجُ","https://www.poetsgate.com/ViewPoem.aspx?id=34716",""],[5442,"تذكر بالحمي عهداً برامه","https://www.poetsgate.com/ViewPoem.aspx?id=114756",""],[454,"أثر النكسة 1967","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82664&r=&rc=28",""]],"verses":[["وَلَو زَجَرتَ المُزنَ عَن صَوبِهِ","لَضَنَّتِ الأَقطارُ بِالقَطرِ",0,"ر",1,0],["ولو زَبّنَتْهُ الحربُ طارَتْ أُفَيْرِخٌ","مَجاثِمُها تحتَ المَغافِرِ هامُهُ",1,"م",2,0],["وَلَو زُرتُكُم في اليَومِ سَبعينَ مَرَّةً","لَكُنتُ كَذي فَرخٍ عَنِ الفَرخِ غَائِبِ",2,"ب",1,0],["ولو زُرتها في وغرة القَيْظ أمرْعت","بوَجْهِكَ وانهلَّ الغمامُ الرواجس",3,"س",1,0],["ولو زرعتُ حصى المعزاء أثمر لي","مذ ذاك شيئاً ولو في متن صفوانِ",4,"ن",1,0],["وَلَو زادَ الحَياةَ الناسُ سَعياً","وَإِخلاصاً لَزادَتهُم جَمالا",5,"ل",2,0],["وَلَو زُلتَ غُيَّبَ عَمرُو الأُمورِ","وَأَخلى المَنابِرَ سَحبانُها",6,"ن",3,0],["وَلَو زُلتُمُ ثُمَّ لَم أَبكِكُم","بَكَيتُ عَلى حُبِّيَ الزائِلِ",7,"ل",1,0],["وَلَو زَحَمَتها بِالمَناكِبِ زَحمَةً","دَرَت أَيُّ سورَيها الضَعيفُ المُهَدَّمُ",8,"م",1,0],["وَلَو زَحَفوا بِاِبنَي شَمامٍ كِلَيهِما","وَبِالشُمِّ مِن سَلمى إِلى سَروِ حِميَرا",9,"ر",2,0],["ولو زحمتها بالمناكب زحمةً","درت أيّ سورينا الضّعيف المهدّم",10,"م",1,0],["ولو زحمت ثبيرا حين شدّت","عليّ لضجّ غاربه وزاحا",11,"ح",2,0],["ولو زرتَهم فرداً لأَخمَدت نارَهم","بنارٍ متَى يَصْلَوْا بها مِنك تُحْرِقِ",12,"ق",1,0],["وَلَو زاحَمَهُ الطَودُ","لَأَمسى وَهوَ مُنهَدُّ",13,"د",1,0],["وَلَوْ زِيَنتْ مَحاسِنُهُ بِنَتْفٍ","وَحَلْقٍ لَمْ تَجِدْ كأساكَ وَاحِدْ",14,"د",1,0],["ولو زوَّدتهم من نسيم صَبائها","لما شاخ من يصبو إليها ويَزلُف",15,"ف",1,0],["ولو زكى الإله لنا نفوس","وطهرها من الحقد الوخيم",16,"م",1,0],["ولو زحموا ثبيرا في مضيقٍ","ألان على مناكبهم صِراعهْ",17,"ع",2,0],["ولو زال الخطا عن عل","م أهل العقد الحل",18,"ل",1,0],["وَلَوْزِيْنَجَةٍ فِي الدُّهْ","نِ والسُّكَّر مَدْفُونَهْ",19,"ن",2,0],["وَلَوْ زَالَتِ الأَرْضُ يَوْمَ الهِيَاجِ","مِنْ تَحْتِ أَخْمَصِهِ لَمْ يَزُلْ",20,"ل",1,0],["وَلَو زَحفت إِلى الأبطال مُنفَرِداً","لانفلَّ جَمعهمُ مِن قَبل أَن تَصلا",21,"ل",2,0],["ولو زلقت من قبل عفوك نعله","ترامى به دحض المقام بريح",22,"ح",1,0],["ولو زعت الحسام العضب سخطاً","لذاب ذبابه بين القراب",23,"ب",1,0],["ولو زار الأمير ببعض شعري","عفاة الخافقين غدوا نظيري",24,"ر",2,0],["ولو زدت العذاب ولست تألو","لما استروحت بالشكوى أنينا",25,"ن",2,0],["ولو زاغ لم يَمْجُدْ وجاءكَ راغِماً","وأنتَ بكلتا الحالتين مجيد",26,"د",1,0],["ولو زَهِمَ الاصلاب منا لزاحمت","عتيبة اذ دّمى جبين المكسَّرِ",27,"ر",1,0],["ولو زدت في الوارث ما خاض بحرها","فؤاد ولا حجر وذهن ولا وهم",28,"م",1,0],["ولو زارني طيف قنعت بقربه","وإن كان من أهواه ليس بزائري",29,"ر",2,0],["ولو زارها طيفي زيارةَ طيفها","مبادلةً ما زرتُ قطّ لها دارا",30,"ر",2,0],["ولوزينج راقَت وطابَت صفاتهُ","كشِعرِ حَبيب أو شعار حبيب",31,"ب",1,1],["ولو زُرت في ليل التّمام مُتمّما","لوعدي لخلتُ البدر قد زار في التّمّ",32,"م",1,0],["ولو زحفتم عراة من ملاحفكم","فوق التراب لخلناكم شياطينا",33,"ن",2,0],["ولو زهر النجوم أبت رضاه","تأبى أن يقول رضيت عنك",34,"ك",1,0],["ولو زمّها مستنصر الله باسمه","لأمّن أهل الأرض روع الروائع",35,"ع",1,0],["ولو زُرَتُهم غيرَ ذي صَبْوَةٍ","ظفِرتَ ولو كنتَ فرداً وَحيدَا",36,"د",2,0],["ولو زرتنا زارتك منّا خراذل","ضخام وأصرام تروح وشاء",37,"ا",2,0],["وَلَو زُرتُ مَيَّةَ فِي يَقظَةٍ","لَظَنَّت بأَنّي خَيَالٌ سَرَى",38,"ر",2,0],["ولوزينج يعزى الى الفرس خلته","بنان عروس في رقاق الغلائل",39,"ل",1,1],["ولوزينج يشفي السقيم كأنه","بنان أكف بضة لم تغضن",40,"ن",1,1],["وَلَو زادَ في الآجالِ حُسنُ طَويَّة","لَطابَت لَهُ الدُنيا وَمُدَّ لَهُ المَدى",41,"د",2,0],["ولو زارني قبل اللقاء خيالكم","وعانقته ليلاً فذلك من جدّي",42,"د",2,0],["وَلَوْ زَانَتْ الدُّنْيَا لِشَرِّ أَوَادِمٍ","لَهُمْ جُرُفٌ هَارٌ يَخُرُّ تَضَعْضُعَا",43,"ع",2,0],["ولو زالت لابقى العفو منها","بقية عمره مسكاً ختامه",44,"م",2,0],["ولو زكى الإله لنا نفوسا","وطهرها من الحقد الوخيم",45,"م",1,0]]}