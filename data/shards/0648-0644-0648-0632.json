{"poems":[[53,"قرت عيون المجد والفخر","https://www.aldiwan.net/poem30478.html","السريع"],[63,"سرى طيفها والليل رق ظلامه","https://www.aldiwan.net/poem46155.html","الطويل"],[55,"ألا أسعديني بالدموع السواكب","https://www.aldiwan.net/poem26543.html","الطويل"],[51,"ألم تسأل اليوم الظباء الكوانس","https://www.aldiwan.net/poem64666.html","الطويل"],[51,"قد حال للموعد المأمول حولان","https://www.aldiwan.net/poem66435.html","البسيط"],[85,"حياة ما نريد لها زيالا","https://www.aldiwan.net/poem62956.html","الوافر"],[85,"نجا وتماثل ربانها","https://www.aldiwan.net/poem63734.html","المتقارب"],[43,"إلام طماعية العاذل","https://www.aldiwan.net/poem9759.html","المتقارب"],[43,"إذا كان مدح فالنسيب المقدم","https://www.aldiwan.net/poem10143.html","الطويل"],[28,"ومن حين قحطاني سجستان أصبحوا","https://www.aldiwan.net/poem5106.html","الطويل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140971",""],[227,"دليل على أن سوف يرديه ما لقي","https://www.aldiwan.net/poem50925.html","الطويل"],[233,"أيا السيد ما ساع","https://www.aldiwan.net/poem32026.html","الهزج"],[346,"برغمي إن خلت منه المذاود","https://www.aldiwan.net/poem20065.html","الوافر"],[374,"خليلي أما هذه فديارهم","https://www.aldiwan.net/poem59330.html","الطويل"],[447,"أثر النكسة 1967","https://www.aldiwan.net/poem992.html",""],[456,"لأية لبسة خلع الخلاعه","https://www.aldiwan.net/poem56137.html","الكامل"],[556,"وجودي جل عن جسمي","https://www.aldiwan.net/poem34248.html","الهزج"],[565,"متى تنشط للأكل","https://www.aldiwan.net/poem69479.html","الهزج"],[565,"له شغل عن سؤال الطلل","https://www.aldiwan.net/poem69529.html","المتقارب"]],"verses":[["وَلَو زَجَرتَ المُزنَ عَن صَوبِهِ","لَضَنَّتِ الأَقطارُ بِالقَطرِ",0,"ر",1,0],["ولو زَبّنَتْهُ الحربُ طارَتْ أُفَيْرِخٌ","مَجاثِمُها تحتَ المَغافِرِ هامُهُ",1,"م",2,0],["وَلَو زُرتُكُم في اليَومِ سَبعينَ مَرَّةً","لَكُنتُ كَذي فَرخٍ عَنِ الفَرخِ غَائِبِ",2,"ب",1,0],["ولو زُرتها في وغرة القَيْظ أمرْعت","بوَجْهِكَ وانهلَّ الغمامُ الرواجس",3,"س",1,0],["ولو زرعتُ حصى المعزاء أثمر لي","مذ ذاك شيئاً ولو في متن صفوانِ",4,"ن",1,0],["وَلَو زادَ الحَياةَ الناسُ سَعياً","وَإِخلاصاً لَزادَتهُم جَمالا",5,"ل",2,0],["وَلَو زُلتَ غُيَّبَ عَمرُو الأُمورِ","وَأَخلى المَنابِرَ سَحبانُها",6,"ن",3,0],["وَلَو زُلتُمُ ثُمَّ لَم أَبكِكُم","بَكَيتُ عَلى حُبِّيَ الزائِلِ",7,"ل",1,0],["وَلَو زَحَمَتها بِالمَناكِبِ زَحمَةً","دَرَت أَيُّ سورَيها الضَعيفُ المُهَدَّمُ",8,"م",1,0],["وَلَو زَحَفوا بِاِبنَي شَمامٍ كِلَيهِما","وَبِالشُمِّ مِن سَلمى إِلى سَروِ حِميَرا",9,"ر",2,0],["ولو زحمتها بالمناكب زحمةً","درت أيّ سورينا الضّعيف المهدّم",10,"م",1,0],["ولو زرتَهم فرداً لأَخمَدت نارَهم","بنارٍ متَى يَصْلَوْا بها مِنك تُحْرِقِ",11,"ق",1,0],["وَلَو زاحَمَهُ الطَودُ","لَأَمسى وَهوَ مُنهَدُّ",12,"د",1,0],["وَلَوْ زِيَنتْ مَحاسِنُهُ بِنَتْفٍ","وَحَلْقٍ لَمْ تَجِدْ كأساكَ وَاحِدْ",13,"د",1,0],["ولو زوَّدتهم من نسيم صَبائها","لما شاخ من يصبو إليها ويَزلُف",14,"ف",1,0],["ولو زكى الإله لنا نفوس","وطهرها من الحقد الوخيم",15,"م",1,0],["ولو زحموا ثبيرا في مضيقٍ","ألان على مناكبهم صِراعهْ",16,"ع",2,0],["ولو زال الخطا عن عل","م أهل العقد الحل",17,"ل",1,0],["وَلَوْزِيْنَجَةٍ فِي الدُّهْ","نِ والسُّكَّر مَدْفُونَهْ",18,"ن",2,0],["وَلَوْ زَالَتِ الأَرْضُ يَوْمَ الهِيَاجِ","مِنْ تَحْتِ أَخْمَصِهِ لَمْ يَزُلْ",19,"ل",1,0]]}