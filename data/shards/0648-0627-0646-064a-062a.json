{"poems":[[95,"مقامك فوق ما يهب الوسام","https://www.aldiwan.net/poem11317.html","الوافر"],[90,"جمالك يا وجه الفضاء عجيب","https://www.aldiwan.net/poem45077.html","الطويل"],[53,"أسالم قد سلمت من العيوب","https://www.aldiwan.net/poem8313.html","الوافر"],[53,"ألا قل لنحويك الأخفش","https://www.aldiwan.net/poem64923.html","المتقارب"],[53,"علاك قناع المشيب اليقق","https://www.aldiwan.net/poem65702.html","المتقارب"],[53,"يعيرني لبس العمامة سادرا","https://www.aldiwan.net/poem66007.html","الطويل"],[53,"أرى بقر الإنس مني تراع","https://www.aldiwan.net/poem66307.html","المتقارب"],[80,"أبى الدهر أن يقنى الحياء ويندما","https://www.aldiwan.net/poem14206.html","الطويل"],[64,"هي العيس قودا في الأزمة تنفخ","https://www.aldiwan.net/poem52455.html","الطويل"],[47,"إذا عرضت أحداج سلمى فنادها","https://www.aldiwan.net/poem63485.html","الطويل"],[71,"تجنب أصدقاءك أو تغافل","https://www.aldiwan.net/poem28887.html","الوافر"],[83,"تجلى شهاب للسعادة آفل","https://www.aldiwan.net/poem61333.html","الطويل"],[41,"ألا من لعين يجف سجومها","https://www.aldiwan.net/poem53748.html","الطويل"],[22,"ألا أبلغ بني عوف بن كعب","https://www.aldiwan.net/poem21645.html","الوافر"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16669","الطويل"],[22,"ألا أبلغَ بني عوف بن كعبٍ","https://www.poetsgate.com/ViewPoem.aspx?id=18927",""],[92,"عاشوراء","https://www.poetsgate.com/ViewPoem.aspx?id=179150",""],[92,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[53,"أرى بَقَر الإنس منِّي تُرا","https://www.poetsgate.com/ViewPoem.aspx?id=30439",""],[53,"يُعيّرني لُبْسَ العمامة ِ سادراً","https://www.poetsgate.com/ViewPoem.aspx?id=30354",""],[41,"أَلاَ مَنْ لِعَيْنٍ لاَ يَجِفُّ سُجُومُها","https://www.poetsgate.com/ViewPoem.aspx?id=4270",""],[119,"اتمرضنا وانت لنا طبيب","https://www.aldiwan.net/poem41222.html","عموديه"],[136,"هو الموت صمصامة منتضى","https://www.aldiwan.net/poem54809.html","المتقارب"],[185,"خليلى إنى قد أرقت ونمتما","https://www.aldiwan.net/poem59077.html","الطويل"],[308,"تفيض عيون بالدموع السواكب","https://www.aldiwan.net/poem16819.html","الطويل"],[361,"هنيئا لك الإقبال واليمن والنجح","https://www.aldiwan.net/poem4174.html","الطويل"],[368,"هم منعوا منا الخيال الذي يسري","https://www.aldiwan.net/poem60909.html","البسيط"],[370,"لكل مودة أجر وأجري","https://www.aldiwan.net/poem17316.html","الوافر"],[370,"إلى العين قبل الكف يبدو شعاعه","https://www.aldiwan.net/poem17318.html","الطويل"],[395,"لك الخير يا عثمان وفقت للرشد","https://www.aldiwan.net/poem54586.html","عموديه"],[407,"تبسم ثغر الدهر وافتى بالبشر","https://www.aldiwan.net/poem33918.html","الطويل"],[461,"شوارد حظ لا يقر نفورها","https://www.aldiwan.net/poem56200.html","الطويل"],[749,"","https://poetry.dctabudhabi.ae/diwan/poem/74975","الطويل"]],"verses":[["وَأَنْ يَتَبَاهَى بِالأَخْطَارِقُوْمٌ","فَحَسْبُكَ أَنَّكَ الفَرْدُ الهُمَامُ",0,"م",1,0],["وإن يتواضع مُعدمِ فهو صاغرٌ","وإن يتواضع ذو الغنى فنجيب",1,"ب",1,0],["وأنَّى تستمِدُّ من السواقي","لتُنضبهَا ولستَ بذي نضوبِ",2,"ب",1,0],["وأنَّى تعفُّ وفي طيزها","سعيرٌ يهرُّ على الحُشَّش",3,"ش",1,0],["وأنى تراع بما أومنت","به من حبالك ذات العُلَق",4,"ق",1,0],["وأَنَّى تعيبُ الصُّلْعَ والأيْرُ منهمُ","وأنت بِحُبّ الأير عينُ المتيَّمِ",5,"م",1,0],["وأنَّي تَفَرَّعَ رأْسِي المشيبُ","ولم أتفرَّعْ ثلاثين عاما",6,"م",2,0],["وَأَن يَتَلَقّى وَجهُ عَتبيَ وَجهُهُ","بِعُذرٍ يُغشِّي صَفحَتَيهِ التَذَمُما",7,"م",2,0],["وان يتوقَّوا في الشَّماريخِ منهمُ","فسوف يَحُطُّ القومَ عنها المشمرِخُ",8,"خ",1,0],["وَإِن يَتَقَلَّد ذا الفَقارِ يُضَف إِلى","شُجاعِ قُرَيشٍ في الوَغى وَجَوادِها",9,"د",3,0],["وإنْ يتكدّروا يوماً فَعُذْراً","فإنَّ القومَ منْ ماءٍ وطينِ",10,"ن",1,0],["وَإن يَتَأخَّر وَهُوَ أخزَى فَإنَّمَأ","تَأخَّرَ لَمَّا قَدَّمَتكَ الفَوَاضِلُ",11,"ل",1,0],["وَأَنّى تَعاطى يَشكُرٌ مَجدَ طَيِّئٍ","وَيَشكُرُ أَخساسٌ صَغيرٌ أَرومُها",12,"م",3,0],["وَآنَيتُ العَشاءَ إِلى سُهَيلٍ","أَوِ الشِعرى فَطالَ بِيَ العَشاءُ",13,"ا",2,0],["وأنّي تيَمّمْتُ العِراقَ لغَيرِ ما","تيَمّمَهُ غَيْلانُ عِندَ بِلال",14,"ل",1,0],["وآنَيْتُ العَشَاءَ إلى سُهَيْلٍ","أو الشِّعْرَى فطالَ بِيَ الأَنَاءُ",15,"ا",2,0],["وأن يتراءى قرده متقدِّماً","يجيءُ على الفُرسان أم متأخِّرا",16,"ر",2,0],["وأني تركتُ دهينَ السِّبالِ","كثيرَ الصيالِ ، شديدَ القوى",17,"ا",1,0],["وأنَّى تَفَرَّعَ رأْسِي المشيِ","بُ ولم أتفرَّغْ ثلاثين عاما",18,"م",2,0],["وأَنَّى تعيبُ الصُّلْعَ والأير منهمُ","أنت بِحُبّ الأير عينُ المتيَّم",19,"م",1,0],["وأنَّى تعاطَى يشكرٌ مجدَ طيِّىء","ٍ ويشكرُ أخساسٌ صغيرٌ أرومُها",20,"م",3,0],["واني تبت عن حبي لحبي","لاني فيه سامتني الخطوب",21,"ب",1,0],["وأني تَصُونُ الدُّمُوعَ العُيُونُ","وعَينُ القُضَاةُ وَيبكِى القَضَا",22,"ض",2,0],["وإِنّى تَدَبَّرتُ الأُمُورَ وَاعلما","بِنَفسىَ والفٍِتيَانِ مُنذُ زَمَانِ",23,"ن",1,0],["وأن يتعشانا بعفو ورحمةٍ","وفضل وإحسان وستر المعايب",24,"ب",1,0],["وأن يتولانا بلطف ورأفةٍ","وحفظ يقينا شر كل المعاطب",24,"ب",1,0],["وان يتوفانا على خير ملةٍ","على ملة الإسلام خير المواهب",24,"ب",1,0],["وَأن يَتَقَاضَى مَوضِعَ النَّصرِ فِي العِدَا","حَفِيظٌ عَلَى الإِسلامِ مُؤتَمَنٌ سَمحُ",25,"ح",1,0],["وأنّى تَرى كُفْوءاً كريماً من الوَرى","إذا عدَلَتْ بالوُدِّ عنك ابنةُ الفِكر",26,"ر",1,0],["وَإِن يَتَوَرَّعوا عَن نَحتِ ذِكري","فَتَحتَ الجَنبِ مِنّي أَيُّ وَعرِ",27,"ر",1,0],["وَإِن يَتَساوَ الخَلقُ في مَورِدِ الرَدى","فَلَم يَتَساوَالخَلقُ في مَورِدِ الذِكرِ",28,"ر",1,0],["وإن يتوفانا على دين أحمد","ويبعثنا تحت لواه لوا الحمد",29,"د",1,0],["وأن يتحلى بالمكارم والعلى","ويصبح فرداً في المحامد والذكر",30,"ر",1,0],["وأنَّى تراني أغسلُ الدمَ موجَعاً","أو العارَ فاعلم ثَمَّ أنى عقيرُها",31,"ر",3,0],["وإني تخيرت المدينة واحداً","لحلف فلم أندم ولم أتلوم",32,"م",1,1]]}