{"poems":[[95,"مقامك فوق ما يهب الوسام","https://www.aldiwan.net/poem11317.html","الوافر"],[90,"جمالك يا وجه الفضاء عجيب","https://www.aldiwan.net/poem45077.html","الطويل"],[53,"أسالم قد سلمت من العيوب","https://www.aldiwan.net/poem8313.html","الوافر"],[53,"ألا قل لنحويك الأخفش","https://www.aldiwan.net/poem64923.html","المتقارب"],[53,"علاك قناع المشيب اليقق","https://www.aldiwan.net/poem65702.html","المتقارب"],[53,"يعيرني لبس العمامة سادرا","https://www.aldiwan.net/poem66007.html","الطويل"],[53,"أرى بقر الإنس مني تراع","https://www.aldiwan.net/poem66307.html","المتقارب"],[80,"أبى الدهر أن يقنى الحياء ويندما","https://www.aldiwan.net/poem14206.html","الطويل"],[64,"هي العيس قودا في الأزمة تنفخ","https://www.aldiwan.net/poem52455.html","الطويل"],[47,"إذا عرضت أحداج سلمى فنادها","https://www.aldiwan.net/poem63485.html","الطويل"],[71,"تجنب أصدقاءك أو تغافل","https://www.aldiwan.net/poem28887.html","الوافر"],[83,"تجلى شهاب للسعادة آفل","https://www.aldiwan.net/poem61333.html","الطويل"],[41,"ألا من لعين يجف سجومها","https://www.aldiwan.net/poem53748.html","الطويل"],[22,"ألا أبلغ بني عوف بن كعب","https://www.aldiwan.net/poem21645.html","الوافر"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16669","الطويل"],[22,"ألا أبلغَ بني عوف بن كعبٍ","https://www.poetsgate.com/ViewPoem.aspx?id=18927",""],[92,"عاشوراء","https://www.poetsgate.com/ViewPoem.aspx?id=179150",""],[92,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[53,"أرى بَقَر الإنس منِّي تُرا","https://www.poetsgate.com/ViewPoem.aspx?id=30439",""],[53,"يُعيّرني لُبْسَ العمامة ِ سادراً","https://www.poetsgate.com/ViewPoem.aspx?id=30354",""],[41,"أَلاَ مَنْ لِعَيْنٍ لاَ يَجِفُّ سُجُومُها","https://www.poetsgate.com/ViewPoem.aspx?id=4270",""],[119,"اتمرضنا وانت لنا طبيب","https://www.aldiwan.net/poem41222.html","عموديه"],[136,"هو الموت صمصامة منتضى","https://www.aldiwan.net/poem54809.html","المتقارب"],[185,"خليلى إنى قد أرقت ونمتما","https://www.aldiwan.net/poem59077.html","الطويل"],[309,"تفيض عيون بالدموع السواكب","https://www.aldiwan.net/poem16819.html","الطويل"],[362,"هنيئا لك الإقبال واليمن والنجح","https://www.aldiwan.net/poem4174.html","الطويل"],[369,"هم منعوا منا الخيال الذي يسري","https://www.aldiwan.net/poem60909.html","البسيط"],[371,"لكل مودة أجر وأجري","https://www.aldiwan.net/poem17316.html","الوافر"],[371,"إلى العين قبل الكف يبدو شعاعه","https://www.aldiwan.net/poem17318.html","الطويل"],[396,"لك الخير يا عثمان وفقت للرشد","https://www.aldiwan.net/poem54586.html","عموديه"],[409,"تبسم ثغر الدهر وافتى بالبشر","https://www.aldiwan.net/poem33918.html","الطويل"],[463,"شوارد حظ لا يقر نفورها","https://www.aldiwan.net/poem56200.html","الطويل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138271",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138189",""],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86758","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48773","الوافر"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63846","المتقارب"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145943","المتقارب"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62656","الرجز"],[1056,"","https://poetry.dctabudhabi.ae/diwan/poem/178052","الطويل"],[1132,"","https://poetry.dctabudhabi.ae/diwan/poem/121102","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108536","المتقارب"],[1690,"","https://poetry.dctabudhabi.ae/diwan/poem/74975","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49574","الطويل"],[1778,"","https://poetry.dctabudhabi.ae/diwan/poem/96508","الوافر"],[1829,"","https://poetry.dctabudhabi.ae/diwan/poem/130584","الطويل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124744","الطويل"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111257","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137058",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202392","الطويل"],[3385,"","https://poetry.dctabudhabi.ae/diwan/poem/141798","الطويل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103871","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48458","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91484","المتقارب"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93276","الطويل"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105134","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94324","الطويل"],[4450,"","https://poetry.dctabudhabi.ae/diwan/poem/138828",""],[4755,"لِأَنَّكَ لا تُبَاعُ ولا تَبِيعُ","https://www.poetsgate.com/ViewPoem.aspx?id=204388",""],[5277,"وجعٌ على وجع","https://www.poetsgate.com/ViewPoem.aspx?id=190692",""],[5490,"نساء","https://www.poetsgate.com/ViewPoem.aspx?id=176174",""],[5536,"بذرة غلاه!!!","https://www.poetsgate.com/ViewPoem.aspx?id=20300",""],[5642,"مُذكرات طفل سوري","https://www.poetsgate.com/ViewPoem.aspx?id=131268",""],[5670,"أُحاذر أن يشتَمَّ قلبي عبيرَها","https://www.poetsgate.com/ViewPoem.aspx?id=215260",""],[5786,"يميناً بها إن كنت للصبّ مُسعِدا","https://www.poetsgate.com/ViewPoem.aspx?id=50660",""],[5956,"الحمد لله أعطانا أمانينا","https://www.poetsgate.com/ViewPoem.aspx?id=192130",""],[402,"مفامك فوق ما يهب الوسام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54046&r=&rc=898",""],[6290,"هَوَى الصِّبْيَانِ وَشْمٌ فِي قُلُوبٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85167&r=&rc=4",""]],"verses":[["وَأَنْ يَتَبَاهَى بِالأَخْطَارِقُوْمٌ","فَحَسْبُكَ أَنَّكَ الفَرْدُ الهُمَامُ",0,"م",1,0],["وإن يتواضع مُعدمِ فهو صاغرٌ","وإن يتواضع ذو الغنى فنجيب",1,"ب",1,0],["وأنَّى تستمِدُّ من السواقي","لتُنضبهَا ولستَ بذي نضوبِ",2,"ب",1,0],["وأنَّى تعفُّ وفي طيزها","سعيرٌ يهرُّ على الحُشَّش",3,"ش",1,0],["وأنى تراع بما أومنت","به من حبالك ذات العُلَق",4,"ق",1,0],["وأَنَّى تعيبُ الصُّلْعَ والأيْرُ منهمُ","وأنت بِحُبّ الأير عينُ المتيَّمِ",5,"م",1,0],["وأنَّي تَفَرَّعَ رأْسِي المشيبُ","ولم أتفرَّعْ ثلاثين عاما",6,"م",2,0],["وَأَن يَتَلَقّى وَجهُ عَتبيَ وَجهُهُ","بِعُذرٍ يُغشِّي صَفحَتَيهِ التَذَمُما",7,"م",2,0],["وان يتوقَّوا في الشَّماريخِ منهمُ","فسوف يَحُطُّ القومَ عنها المشمرِخُ",8,"خ",1,0],["وَإِن يَتَقَلَّد ذا الفَقارِ يُضَف إِلى","شُجاعِ قُرَيشٍ في الوَغى وَجَوادِها",9,"د",3,0],["وإنْ يتكدّروا يوماً فَعُذْراً","فإنَّ القومَ منْ ماءٍ وطينِ",10,"ن",1,0],["وَإن يَتَأخَّر وَهُوَ أخزَى فَإنَّمَأ","تَأخَّرَ لَمَّا قَدَّمَتكَ الفَوَاضِلُ",11,"ل",1,0],["وَأَنّى تَعاطى يَشكُرٌ مَجدَ طَيِّئٍ","وَيَشكُرُ أَخساسٌ صَغيرٌ أَرومُها",12,"م",3,0],["وَآنَيتُ العَشاءَ إِلى سُهَيلٍ","أَوِ الشِعرى فَطالَ بِيَ العَشاءُ",13,"ا",2,0],["وأنّي تيَمّمْتُ العِراقَ لغَيرِ ما","تيَمّمَهُ غَيْلانُ عِندَ بِلال",14,"ل",1,0],["وآنَيْتُ العَشَاءَ إلى سُهَيْلٍ","أو الشِّعْرَى فطالَ بِيَ الأَنَاءُ",15,"ا",2,0],["وأن يتراءى قرده متقدِّماً","يجيءُ على الفُرسان أم متأخِّرا",16,"ر",2,0],["وأني تركتُ دهينَ السِّبالِ","كثيرَ الصيالِ ، شديدَ القوى",17,"ا",1,0],["وأنَّى تَفَرَّعَ رأْسِي المشيِ","بُ ولم أتفرَّغْ ثلاثين عاما",18,"م",2,0],["وأَنَّى تعيبُ الصُّلْعَ والأير منهمُ","أنت بِحُبّ الأير عينُ المتيَّم",19,"م",1,0],["وأنَّى تعاطَى يشكرٌ مجدَ طيِّىء","ٍ ويشكرُ أخساسٌ صغيرٌ أرومُها",20,"م",3,0],["واني تبت عن حبي لحبي","لاني فيه سامتني الخطوب",21,"ب",1,0],["وأني تَصُونُ الدُّمُوعَ العُيُونُ","وعَينُ القُضَاةُ وَيبكِى القَضَا",22,"ض",2,0],["وإِنّى تَدَبَّرتُ الأُمُورَ وَاعلما","بِنَفسىَ والفٍِتيَانِ مُنذُ زَمَانِ",23,"ن",1,0],["وأن يتعشانا بعفو ورحمةٍ","وفضل وإحسان وستر المعايب",24,"ب",1,0],["وأن يتولانا بلطف ورأفةٍ","وحفظ يقينا شر كل المعاطب",24,"ب",1,0],["وان يتوفانا على خير ملةٍ","على ملة الإسلام خير المواهب",24,"ب",1,0],["وَأن يَتَقَاضَى مَوضِعَ النَّصرِ فِي العِدَا","حَفِيظٌ عَلَى الإِسلامِ مُؤتَمَنٌ سَمحُ",25,"ح",1,0],["وأنّى تَرى كُفْوءاً كريماً من الوَرى","إذا عدَلَتْ بالوُدِّ عنك ابنةُ الفِكر",26,"ر",1,0],["وَإِن يَتَوَرَّعوا عَن نَحتِ ذِكري","فَتَحتَ الجَنبِ مِنّي أَيُّ وَعرِ",27,"ر",1,0],["وَإِن يَتَساوَ الخَلقُ في مَورِدِ الرَدى","فَلَم يَتَساوَالخَلقُ في مَورِدِ الذِكرِ",28,"ر",1,0],["وإن يتوفانا على دين أحمد","ويبعثنا تحت لواه لوا الحمد",29,"د",1,0],["وأن يتحلى بالمكارم والعلى","ويصبح فرداً في المحامد والذكر",30,"ر",1,0],["وأنَّى تراني أغسلُ الدمَ موجَعاً","أو العارَ فاعلم ثَمَّ أنى عقيرُها",31,"ر",3,0],["وأنى تحسن الأقوام صنعاً","إذا لم يقتفوا للشهم إثرا",32,"ر",2,0],["وأنى تُحاكي مصرُنا في بهائها","وهل قطرنا يحكيه في عيننا قطر",33,"ر",1,0],["وَأَن يَتَحلَّى كُل عام بِمَوسم","لِمولدك السامي بِأَشرَف محتد",34,"د",1,0],["وأن يتجنب الفوضى نظام","وأن يتألف الشمل البديد",35,"د",1,0],["وأن يتلقاهُمُ يومُهُمْ","بيومِ الهباءةِ والعنقفير",36,"ر",1,0],["وَأنَّى تلَفّتَ أنَّى استَدَار","فَثَمَّ لواءٌ به خافِقُ",37,"ق",1,0],["وأن يتم فضله","عليَّ ما هبّت صَبَا",38,"ب",2,0],["وأنى ترجي الوصل منها وقد نأت","وتبخل بالموجود وهي قريب",39,"ب",1,0],["وإن يتناسوني لعذرٍ فذكروا","بأمري ولا تدري بذاك عواذلي",40,"ل",2,0],["وأنَّى تدوم لظى مهجةٍ","عليها سحاب الرضاب انسكب",41,"ب",1,0],["وإني تخيرت المدينة واحداً","لحلف فلم أندم ولم أتلوم",42,"م",1,1],["وأن يتوقّى الضيمُ جانبَ جاره","كما يتوقّى البعل عَذْراءُ عارِكُ",43,"ك",1,0],["وإني تارك مرواً ورائي","إلى الطبسين معتاماً عمانا",44,"ن",2,1],["وأنى ترد القولَ دارٌ كأنها","لطول بِلاها والتقادم مهرقُ",45,"ق",1,0],["وإن يتأكل وهو دامٍ أقاده","بدامٍ وأعطى أرش ما يتأكل",46,"ل",1,0],["وأني توفي حق من هو للعلى","بمنزلة الكف المتمة للزند",47,"د",1,0],["وان يتخذ منغارب البحر مركباً","فان له فوق المجرة مقعدا",48,"د",2,0],["وإني تعودت الصراع فهل ترى","أصارع رسماً في الجدار مقيما",49,"م",2,0],["وأنى تعاطي قلبه حارثية","تحل ببصرى أو تحل الجوابيا",50,"ي",2,0],["وإن يتضرم لفحه ولهيبه","فنفخك يذكيه وتبدو مدوده",51,"د",2,0],["وأنّى تجاريهِ المُلوكُ وإنّهُ","لَيَسْبِقُ آمادَ العُلى وهْوَ وادِعُ",52,"ع",1,0],["وأنّى تُدانيهِ وقائِمُ سيفهِ","لهُ في العِدَى طوعَ الجهادِ الوقائِعُ",52,"ع",1,0],["وَأَنَّى تَثنَّى فَحَدْقُ العُيونِ","صُروحٌ وَدَمعي جُمانُ النثار",53,"ر",1,0],["وأَنّى تخافُ الضيم دولةُ هاشم","وآراؤك الأَنجاد فيها جنودها",54,"د",3,0],["وان يتعاطوا اكؤس الراح لا يرى","سوى الكأس من فيض الدما يتعاطاه",55,"ا",2,0],["وإن يتخذ حصناً منيعاً تقدُّماً","وأركانهُ طورٌ تعالَت جوانبُه",56,"ب",2,0],["وأن يتلقىّ بالرضا مُقتضى القضا","ولو أنه بالمرهفات يُمزَّقُ",57,"ق",1,0],["وإِنْ يَتَجاهَلُوا فَاقرَأ عليهم","(فَظِيعٌ جَهلُ ما يَجري) فَظِيعُ",58,"ع",1,0],["وإنْ يتغيَّر العُشّا","قُ قلبي لا يرومُ سِواكْ",59,"ك",1,0],["وأنى تسُودُ نفوسُ الرجال","إذا أرضِعوا من صدور الإماء؟",60,"ا",2,0],["واني تحتها مستظل من الزمان ومن عناه","مثل الغريب اللي تريح بعد طالت سفرته",61,"ت",2,0],["وأنَّى تُسمِعُ الموتَى .. وأنى تُسمع الصُّمَّا","ولو أني إذا ضاعفتُ بذلي أظهَروا رُحْما",62,"م",2,0],["‏وأن يتهادى للمسامع همسُها","‏فيُوثقَني في أسرها بعِقالِ",63,"ل",1,0],["وإنّي تزودت الولاء لحيدرٍ","وذلك أزكى ما به المرءُ زوّدا",64,"د",2,0],["وأن يتم على أوطاننا منناً","وأن يزيد عليها الوعي والدينا",65,"ن",2,0],["وأن يتباهى بالخطار قوم","فحسبك أنك الفرد الهمام",66,"م",1,0],["وَ إِنْ يَتَفَرَّقِ الْحِبَّانِ قَهْرًا","سَيَجْمَعْ قَدْرَ بَيْنِهِمَا الْجُنُونُ",67,"ن",1,0]]}