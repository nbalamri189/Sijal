فَ ارْفضّ فانقشعا","https://www.poetsgate.com/ViewPoem.aspx?id=32188",""],[45,"أتَرَاهُ يَظُنُّني، أوْ يَرَانِي","https://www.poetsgate.com/ViewPoem.aspx?id=32077",""],[28,"كم للملاءة من أطلال منزلة","https://www.poetsgate.com/ViewPoem.aspx?id=21749",""],[28,"عزفت بأعشاش وما كدت تعزف","https://www.poetsgate.com/ViewPoem.aspx?id=22116",""],[101,"يا نَسْمَة ً رنّحتْ أعطافَ وادينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62435&r=&rc=27",""],[2,"صَحا القَلبُ عن سلمى وأقصرَ باطِلُهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19479&r=&rc=5",""]],"verses":[["عِزٌّ بِلا كَدَرٍ مِنَ ال","دُنيا وَبَعضُ العِزِّ هونُ",0,"ن",1,0],["عَزمٌ رَضيعُ لِبانِ أَطرافِ القَنا","في حَيثُ يَرضَعُ مِن نَجيعِ لَبانِ",1,"ن",1,0],["عَزّوا إِلَيَّ نِصاباً بَعدَ تَشظِيَةٍ","وَأَلصَقوا بي أَديماً بَعدَ تَعيِيني",2,"ي",1,0],["عَزاءَكَ ما اِستَطَعتَ فَكُلُّ حُزنٍ","يَؤولُ بِهِ الغُلوَّ إِلى الأَثامِ",3,"م",1,0],["عَزَّ مَن أَمسى مُعِدّاً ظَهرَهُ","أَخَذَ الأُهبَةَ يَوماً لِلزَيالِ",4,"ل",1,0],["عَزيمَةُ لاوٍ مُستَبِدٍّ بِرَأيِهِ","وَعَقلُ اِمرِىءٍ لَم يَستَعِن بِعُقولِ",5,"ل",1,0],["عَزَّ صَبري يَومَ اللِقاءِ وَلَكِن","فَضَحَتهُ الأَشجانُ يَومَ الفِراقِ",6,"ق",1,0],["عَزَّ الحِمامُ عَلَيكَ إِ","نَّ القِرنَ إِن ما عَزَّ بَزّا",7,"ز",2,0],["عَزاءَكَ فَالأَيّامُ أُسدٌ مُذِلَّةٌ","تَعُطُّ الفَتى عَطَّ المَقاريصِ لِلبُردِ",8,"د",1,0],["عُزِلتَ وَلَكِن ما عُزِلتَ عَنِ النَدى","وَجودُكَ في جيدِ العُلى لَكَ شاهِدُ",9,"د",1,0],["عَزَّ شِعري إِلّا عَلَيكَ وَمازا","لَ عَزيزاً يَأبى عَلى كُلِّ خَطبِ",10,"ب",1,0],["عَزائِمُ كَالرِياحِ مَرَرنَ رَهواً","عَلى الأَقطارِ مِن دانٍ وَناءِ",11,"ا",2,0],["عَزّوا وَمالَ بهِ الهَوى فَأَذَلَّهُ","إِنَّ العَزيزَ عَلى الذَليلِ يَتيهُ",12,"ه",1,0],["عَزَّ عَلَيَّ بِأَبي","ما صَنَعوا في سَبَبي",13,"ي",1,0],["عَزيزٌ عَلَيها ما وَعَت غَيرَ أَنَّها","نَأَت وَبَناتُ الدَهرِ ذاتُ خُطوبِ",14,"ب",1,0],["عَزِيزٌ بِأَنْفِسِنَا أَنْ نَرَى","رِكَابَكَ مُؤُذِنَةً بِارْتِحَالِ",15,"ل",1,0],["عَزاؤكَ عنْ عبْدِ العَزيزِ هوَ الّذي","يَليقُ بعِزٍّ منْكَ أعْجَزَ ناعِتا",16,"ت",2,0],["عَزباءُ إِذ سُئِلَ الخِلاسُ كَأَنَّما","شَرِبَت عَلَيهِ بَعدَ كُلِّ رُقادِ",17,"د",1,0],["عَزَمنَ رَحيلاً وَاِنتَجَعنَ عَلى هَوىً","وَخِفنَ العِراقَ أَن تَجيشَ بَوائِقُهُ",18,"ق",2,0],["عَزمَةٌ لا يَصُدُّها عَن مَداها","ما يَصُدُّ السُيولَ تَغشى الهِضابا",19,"ب",2,0],["عَزَّ القَرارُ عَلَيَّ لَيلَةَ نَعيِهِ","وَشَهِدتُ مَوكِبَهُ فَقَرَّ قَراري",20,"ر",2,0],["عَزيزٌ عَلَينا أَن نَرى فيكَ مُصطَفى","شَهيدَ العُلا في زَهرَةِ العُمرِ ذاوِيا",21,"ي",2,0],["عِزريلُ هَل أَبصَرتَ فيما مَضى","وَأَنتَ ذاكَ الكَيِّسُ الأَمهَرُ",22,"ر",1,0],["عَزَّتِ السِلعَةُ الذَليلَةُ حَتّى","باتَ مَسحُ الحِذاءِ خَطباً جُساما",23,"م",2,0],["عَزَّت بِقُرطاجَةَ الأَمراسُ فَاِرتُهِنَت","فيها السَفينُ وَأَمسى حَبلُها اِضطِرَبا",24,"ب",2,0],["عَزيزٌ عَلَيهِ يا بَني الشَرقِ أَن تُرى","كَواكِبُهُ في أُفقِهِ غَيرَ طُلَّعِ",25,"ع",1,0],["عُزلٌ وَلَكِن في الجِهادِ ضَراغِمٌ","لا الجَيشُ يُفزِعُها وَلا الأُسطولُ",26,"ل",1,0],["عَزمٌ بِهِ أَخمَدَ اللَهُ الشِقاقَ وَلا","هُزَّت رِماحٌ وَلا سُلَّت لَهُ قُضُبُ",27,"ب",1,0],["عَزائِمُ يَنصاعُ العِدا عَن مُمِرِّها","كَما رُهِبَت يَومَ النِضالِ رِهابُ",28,"ب",1,0],["عَزاءً فَدَتكَ النَفسُ عَنهُ فَإِن ثَوى","فَإِنَّكَ لا الواني وَلا الضَرَعُ الغُمرُ",29,"ر",1,0],["عَزيزٌ عَلَيهِم أَن يَعودَ خَيالُها","فَيُسعِفَ مِنها نائِلٌ في الكَرى ثَمدُ",30,"د",1,0],["عَزاءٌ فَدَتكَ النَفسُ عَزمَ مُسَلِّمٍ","لِمَوقِعِ أَمرٍ لَم يَزَل مُتَوَقَّعا",31,"ع",2,0],["عَزمٌ إِذا قَصَدَ الحِمى لَم يَثنِهِ","أَنَّ القَنا مِن دينِها أَقصادُ",32,"د",1,0],["عَزَمتُ عَلَيها أَمرَها فَصَرَمتُهُ","وَخَيرُ بَديعاتِ الأُمورِ عَزيمُها",33,"م",3,0],["عَزَاءَكُمْ يَا بَنِيهِ الصِّيدِ مِنْ مَلِكٍ","مُسَدَّدِ الرًّأْيِ إِنْ يَمْنَعْ وَإِنْ يَهَبِ",34,"ب",1,0],["عَزْمُهُ مِنْ عُنْصُرٍ مَرِنٍ","خُلْقُهُ مِنْ جَوْهَرٍ صُلْبِ",35,"ب",1,0],["عِزٌّ إذَا مَا سَاوَامَهُمْ","جَادُوا بِأَنْفُسِهِمْ بِلا شَحَنِ",36,"ن",1,0],["عَزَاءَكَ فِي جَوَادِكَ يَا صَديقِي","فَكَمْ فِي الْبُعْدِ عَنُهُ مِنْ شُجُونِ",37,"ن",1,0],["عَزِيزٌ عَلَى مِصْرَ هَذَا المُصَابُ","بِمِقْدَامِهَا المُصْلِحِ الْحَازِمِ",38,"م",1,0],["عَزَماتُ نَحَّاسٍ إِذَا جَاوَرْتَهَا","تُحْيِي بِهَا العَزَمَات وَهْيَ رِغَامُ",39,"م",1,1],["عَزيزٌ إلى مِصْرَ المُفَدَّاةِ رُزْؤُهَا","بِأَنْهَضِ مَنْ تَرْجُوهُ وَالخَطْبُ دَاهِمُ",40,"م",1,0],["عَزَاءَكُمَا يَا جَازِعَيْنِ عَلَى أَبٍ","تُخَلدُ ذِكَرَاهُ الْعُلَى وَالمَكَارِمُ",40,"م",1,0],["عَزَزْنَا بِهَا مِنْ ذِلَّةٍ وَبِعَزْمِهَا","سَيُقْشَعُ هَذَا الْغَيْهَبُ المُتَجَهِّمُ",41,"م",1,0],["عَزَزنا مِن بَني قَيسٍ عَلَيهِ","فَوارِسَ لا يُريدونَ الفِرارا",42,"ر",2,0],["عزّها السامي المراقب","قد ضمن حسن العواقب",43,"ب",1,0],["عزاءً أمين المسلمين فإنها","مقادير رب الخلق في الخلق يُجريها",44,"ي",3,0],["عزاءٌ فإن الشجو قد كان يُسرفُ","وبُشْرى بها الداعي على الغور يُشرفُ",45,"ف",1,1],["عزاءً لمسجدك الجامع","أفارق محرابه المنبرا",46,"ر",2,0],["عزاه إلى إحدى الجنايات حاكم","عليه قضى بطلاً بها وهو لا يدري",47,"ر",2,0],["عَزَبَت قُفَيرَةُ في العَزيبِ وَراوَحَت","بِالكَفِّ بَينَ قَوادِمٍ وَأَواخِرِ",48,"ر",1,0],["عَزَّت كَواهِلُها العَرائِكَ بَعدَما","لَحِقَ الثَميلُ فَما لَهُنَّ ثَميلُ",49,"ل",1,0],["عَزوفٌ أَنوفٌ لَيسَ يَقرَعُ سِنَّهُ","جَريءٌ مَتى يَعزِم عَلى الأَمرِ يَفعَلِ",50,"ل",1,0],["عَزيزٌ حَيثُ حَطَّ السَيرُ رَحلي","تُداريني الأَنامُ وَلا أُداري",51,"ر",2,0],["عَزيزٌ عَلَيهِ أَن يَجوروا عَنِ الهُدى","حَريصٌ عَلى أَن يَستَقيموا وَيَهتَدوا",52,"د",3,0],["عزيزٌ على العذال عني صرفها","وللقلب في دينارِ وجنتها نقد",53,"د",1,0],["عزيزٌ على الساعي مداه وهذه","مهابته عصر الشباب وجوده",54,"د",2,0],["عزماتُ تحفها بركاتٌ","مثلها منه للممالكِ تهدى",55,"د",2,0],["عزم فتى صورة إخلاصه","في البرِّ قد أفضت إلى حمده",56,"د",2,0],["عزائم من لا يختشي يوم غزوِهِ","ردًى وعطاً من ليسَ للفقرِ يحذر",57,"ر",1,0],["عزاءً عليه اليوم يحيى ببيته","وصبراً صلاح الدِّين قد صلح الصبر",58,"ر",1,0],["عزائم وضَّاح المحامد أروعٌ","إذا قيل وضَّاح المحامد أروَع",59,"ع",1,0],["عزيمة السعي ما خابت وسائلها","وآية المنطق السحَّار ما بطلت",60,"ت",1,0],["عزاء العلى عن راحل بيد الردى","وكلّ مقيم مؤذن بارتحاله",61,"ل",2,0],["عزيمة من لا يصعب الجد في العلى","عليه كأنَّ الجد بعض مجونه",62,"ن",2,0],["عزاء مولانا وتسليمه","فكل خطب قد عداه يهون",63,"ن",1,0],["عزُّكم في نصابه آل وهبٍ","والروابي محلُّكم لا الخبُوتُ",64,"ت",1,0],["عزاؤكَ أن الدهرَ ذو فَجعاتِ","وكلُّ جميعٍ صائرٌ لشَتاتِ",65,"ت",1,1],["عَزَاءَكَ فاذكرهُ ولا تنس مِدْحةً","لأَبْلَجَ يحكي سُنَّة البدر أبلْخَا",66,"خ",2,0],["عزيزٌ غَدا فوْقَ التَّودُّدِ عِزُّهُ","وإحْسَانُه في ظلِّه يَتَوَدَّدُ",67,"د",1,0],["عَزَبَتْ عنه سَيِّئاتِي وإحسْا","نِي منْه بمنْظَرٍ مرْصودِ",68,"د",1,0],["عزُّ الحياة وعزُّ الموْت ما اجْتَمعا","أسْنَى وأَبْنَى لِبَيْت العِزِّ ذي العُمُدِ",69,"د",1,0],["عزمت على طيِّ الأهاجيِّ مُنعماً","عليه ومثلي جاد بالصفح والغَفرِ",70,"ر",1,0],["عزاؤك عن ظبيٍ طَرير فإنه","بعينيك إذ شيَّبت غير غرير",71,"ر",1,0],["عزمتُ على لُبس العمامةِ حيلةً","لتستُر ما جرَّتْ عليَّ من الصَّلعْ",72,"ع",1,0],["عزت مطالب دنيا كلِّ ذي أدبٍ","وهان مطلب دنيا الأنوَكِ الخَرِقِ",73,"ق",1,1],["عزْبٌ من النعم الجِسامِ مقدّرٌ","بل أن يقدّرَ لي بهنّ تأهُّلُ",74,"ل",1,0],["عزاؤكِ يا نفسُ لا تهلكي","فإن لأمرك أمراً أصيلا",75,"ل",2,0],["عزمٌ تَناذره العواذلُ بعدما","علم العواذلُ أنه التصميمُ",76,"م",1,0],["عزاؤك عن شباب نالَ منه","زمانٌ فيه لينٌ واعتزامُ",77,"م",1,0],["عزيزٌ علينا أن تَموتِي وأننا","نعيش ولكن حُكِّم الموتُ فاحتكمْ",78,"م",1,0],["عزَّني في خطابه أنْ رآني","صارَ بعضي ظهيره في ملامي",79,"م",2,0],["عزمْتَ ندىً فما أمضْيَت عزماً","وكنتَ مُشهَّراً بمضاءِ عزمِ",80,"م",1,0],["عزمتُ على تطليقِ عرسي لعُسرتي","فعاذت بِحقْوَيْ قاسمٍ وأرنَّتِ",81,"ت",1,1],["عَزَّ الشَرابُ فَأَقبَلَت مَشروبَةٌ","هَدَرَ الدِنانُ بِها هَديرَ الأَفحُلِ",82,"ل",1,1],["عَزَلوهُ لَمّا خانَهُم","فَغَدا كَئيباً مُدنَفا",83,"ف",2,1],["عَزَّتْ دِماءُ المُسلمينَ ولم تكن","لِتَهُونَ وَهْيَ على السّيوفِ حَرامُ",84,"م",1,0],["عَزَّيتُهُ فَأَبى وَما مِن ريبَةٍ","غَيري يَخونُ وَغَيرُهُ يَتَرَيَّبُ",85,"ب",1,0],["عزيز على اهل العراق جميعهم","فراق اخيهم يونس الكاتب الندب",86,"ب",1,0],["عزلتني في بقعتي عنك بيد","فسلاماً ان كان يدنى سلامي",87,"ي",1,1],["عزوا الحجاب الى الكتا","ب فليتهم قرأوا الكتابا",88,"ب",2,0],["عزم الفتى اقوى من الاقدار","وهو به ابر",89,"ر",1,