 أَسْمَى المفاخِرِ أَنَّهَا","نَهَضَتْ بِعِزَّتِهَا العَقَائِدُ أَجْمَعُ",224,"ع",1,0],["عَزَّ الْعَزَاءُ عَلَى السَّقِيمْ يَلُج فِي","نَسَمَاتِهِ التَّصْوِيبُ وَالتَّصْعِيدُ",225,"د",1,0],["عَزْمٌ يَفِّلُ مَكَارهَ الدُّنْيَا","وَيَهْزَأُ بِالصِّعَابْ",226,"ب",1,0],["عزمةٌ تقطع الحديد وجسمٌ","في قميص من الضنى والعذاب",227,"ب",1,0],["عَزماً قَوِيّاً لا يُشاوِرُ رِقبَةً","لِلخَطبِ في الإِصدارِ وَالإيرادِ",228,"د",1,0],["عَزَّيتَني في ما تَرى وَعَزَوتَني","لِلصّابِرينَ وَلاتَ حينَ عَزاءِ",229,"ا",2,0],["عزيزٌ علينا أن نُقِيمَ بذلَّةٍ","فليتَ حشايانا الوطيئةَ أكْوارُ",230,"ر",1,0],["عَزّانِيَ الناسُ ثُمَّ قالوا","لَيثُ الشَرى ما لَهُ جزوعا",231,"ع",2,0],["عَزَّت عَلى الوالِهِ المُعَزّى","ميتَتُكَ المُرَّةُ المساغِ",232,"غ",1,1],["عَزَّ العَوالي بَل عَزَّ المَعالي في","فَرعٍ لَها أَثَّثتهُ أَيَّ تَأثيثِ",233,"ث",1,0],["عَزَّني في الأَعَزِّ عِندي عَنيدٌ","لَم أطِقهُ فَبَزَّني أَيَّ بَزِّ",234,"ز",1,0],["عَزَّ المعارِف مُطْرِقاً في عَاطِفٍ","زَيْنِ الفِناءِ وسَيِّدِ الأنْدَادِ",235,"د",1,0],["عَزاءً عزاءً أيها الطيرُ إِنما","لكل امرىءٍ في ساحةِ العمرِ مَصْرَعُ",236,"ع",1,0],["عزاءً مضى الغازي كريماً لربِّه","فما أعظمَ الْجلَّي وَما أفدحَ الفقدا",237,"د",2,0],["عزاءً ففينا فيصلٌ شِبْلُ فيصلٍ","نَرى في ثنايا وَجهِه الأسدَ الورْدا",237,"د",2,0],["عزيزٌ على الأوطانِ أنَّ شجاعةً","تمزِّقُها الشَّحْناءُ في غيرِ طائل",238,"ل",1,0],["عَزْمٌ كما صَال الْحُسام وهِمّةٌ","أَسْمَى من النَّجم البَعيدِ وأَبْهر",239,"ر",1,0],["عزيمته ترد الغِمدَ سيفاً","وحكمتهُ تردُّ السيفَ غمدا",240,"د",2,0],["عزّوا وعزتّ بهم أخلاقُ أمّتهِم","في الأرضِن لمّا أعزّوا الْخُلقَ والدّينا",241,"ن",2,0],["عزاءً! فإنَّ الكريم إذا ما","أصيبَ بفَقدِ عزيزٍ صبر!",242,"ر",1,0],["عَزَفَ «الكمان»، فندَّ عنه مسامعي","وبكت مطوَّقة، فقلتُ: أعيدي!",243,"د",2,0],["عَزَّت على الأَجْدلِ والعُقَاب","إن كنتَ غيرَ سائغِ الشَّراب",244,"ب",1,0],["عزاءً لنا أن الحضارة أفلست","فرونقها زَيْف ومنطقها كِذْب",245,"ب",1,0],["عزفت اصفرار الرماد العجوز","ليحمرّ فيه طفور الشباب",246,"ب",1,0],["عز والله يا كليب علينا","أن ترى هامتي دهانا وكحلا",247,"ل",2,0],["عزيزٌ عليهِ أنْ يحيدوا عن الهدى","حريصٌ على أن يستقيموا ويهتدوا",248,"د",3,0],["عزم الرجال اذا تناهى حدهُّ","مثلُ الكِمام اذا استوى فتفتقا",249,"ق",2,0],["عزاءُ الكِنانة أنَّ القريضَ","تأمَّرَ دهراً بها ثمَّ فَر",250,"ر",1,0],["عَزِيمةٌ منكَ إنْ جَشّمتَها جَشَمَتْ،","وَرُكنُ رَضْوَى إذا حَمّلتَه اضْطَلَعَا",251,"ع",2,0],["عَزّ دينُ الإلَهِ في الشَّرْقِ والغَرْبِ","بِبِضِ الأَيَّامِ مِنْكَ الحِسَانِ",252,"ن",1,0],["عَزَالَةُ الشّمْسِ لا يَصْحو الفؤادُ بها","حَتى تَرَوّحْتُ لأياً بَعْدَ إيصَالِ",253,"ل",1,0],["عَزَفْتَ بأعشاشٍ وَما كِدْتَ تَعزِفُ،","وَأنكَرْتَ من حَرَاءَ ما كنتَ تَعرِفُ",254,"ف",1,1],["عزّوا وعزتّ بهم أخلاقُ أمّتِهم","في الأرضِ لمّا أعزّوا الْخُلقَ والدّينا",255,"ن",2,0],["عَزيزٌ إذا حَلّ الحَليفانِ حَوْلَهُ","بذي لجبٍ أصواتهُ، وصواهلهْ",256,"ل",2,0]]}