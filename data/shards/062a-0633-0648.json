ق من رقدة الآمال جفن","https://www.poetsgate.com/ViewPoem.aspx?id=157927",""],[5408,"لأنك إنّي","https://www.poetsgate.com/ViewPoem.aspx?id=190763",""],[5431,"[تسول العشق حتى لم تعد يده]","https://www.poetsgate.com/ViewPoem.aspx?id=190967",""],[5431,"ولكن أداينه ....","https://www.poetsgate.com/ViewPoem.aspx?id=214829",""],[5444,"حيث لهيب الجمر","https://www.poetsgate.com/ViewPoem.aspx?id=205073",""],[5480,"تتزاحم شجوني","https://www.poetsgate.com/ViewPoem.aspx?id=9888",""],[5582,"أَتَرْدَعُنِي بِاللَّوْمِ وَالدَّهْرُ أَرْدَعُ","https://www.poetsgate.com/ViewPoem.aspx?id=63534",""],[5596,"شمائل سمائل","https://www.poetsgate.com/ViewPoem.aspx?id=206377",""],[5596,"مجاراة قصيدة الحاسد","https://www.poetsgate.com/ViewPoem.aspx?id=206695",""],[5629,"الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=184506",""],[5650,"ليسَ غيرُ التّيهِ","https://www.poetsgate.com/ViewPoem.aspx?id=181696",""],[5691,"الردح المعاكس","https://www.poetsgate.com/ViewPoem.aspx?id=206213",""],[5695,"لولا الحب....","https://www.poetsgate.com/ViewPoem.aspx?id=212443",""],[5725,"زرني بليلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=201274",""],[5732,"دار لنا","https://www.poetsgate.com/ViewPoem.aspx?id=177832",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5848,"الدعيع والشلية","https://www.poetsgate.com/ViewPoem.aspx?id=49006",""],[5861,"فخر الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=192342",""],[5975,"فرحماك يا توّابُ","https://www.poetsgate.com/ViewPoem.aspx?id=58781",""],[6100,"هياكل أوادم","https://www.poetsgate.com/ViewPoem.aspx?id=52556",""],[6124,"أراك اليوم يا قلب","https://www.poetsgate.com/ViewPoem.aspx?id=193252",""]],"verses":[["تَسومُني الضَيمَ لَقَد","نَفَختَ في غَيرِ ضَرَم",0,"م",1,0],["تَسومُني وِردَ القَذى وَقَد رَأَت","عِزَّةَ هَذي النَفسِ وَاِمتِناعَها",1,"ع",3,0],["تَسوءُ قَطيعَةً وَتَشُوقُ حُبّاً","فَما أَدري عَدُوٌّ أَم حَبيبُ",2,"ب",1,0],["تَسومُهُمُ الرُّومُ الهَوانَ وَأَنتُمُ","تَجُرُّونَ ذَيلَ الخَفضِ فِعلَ المُسالِمِ",3,"م",1,0],["تَسوفُ الثّرى طَوراً ويَعْبَثُ تارةً","بِها أوْلَقٌ من شِدّةِ الوَلَهانِ",4,"ن",1,0],["تَسوؤُنا الحَربُ وَإِن أَصبَحَت","تَدعو رِجالَ الشَرقِ أَن يَفخَروا",5,"ر",3,0],["تَسُوسُ شَأْنُكَ فِيهِ دَائِباً فَطِناً","بِعَزْمِ أَدْرَبَ لا سَاهٍ وَلا وَانِ",6,"ن",1,0],["تَسوفُ التَغلِبيَّةُ وَهيَ سَكرى","قَفا الخِنزيرِ تَحسِبُهُ غَزالا",7,"ل",2,0],["تسوَّكُ بالقنا مما حبتها","بزاتك أو تمضمض بالصفاح",8,"ح",1,0],["تسوق إليه كلّ سعدٍ يشاؤه","وتخدمه في كلِّ أمرٍ يريده",9,"د",2,0],["تسوق لها غرّ الفتوح جنائِباً","وأوَّل هاتيك الجنائب سيس",10,"س",1,0],["تسوَدّ نِقْساً وتجلو كلّ داجيةٍ","فهل هيَ الليل داج أم هي الشمع",11,"ع",1,0],["تسوق بنا الحداة فليس ندري","أشوقاً كان ذلك أم سياقا",12,"ق",2,0],["تَسوقُهُ تَحمِلُ الصُرّادَ مُجدِبَةٌ","حَتّى تَساقَطَ بَينَ الضالِ وَالسَلَمِ",13,"م",1,0],["تَسوكُ بِقُضبانِ الأَراكِ مُفَلَّجاً","يُشَعشِعُ فيهِ الفارِسِيُّ المُرَوَّقُ",14,"ق",1,0],["تسوخ في أوحاله","رِجل القوىّ المحكم",15,"م",1,0],["تَسوسُ الأَمرَ لا يُعطي نَفاذاً","عَلَيكَ الآمِرونَ وَلا النُهاةُ",16,"ه",1,0],["تَسوقينَ لِلمَوتِ البَنينَ كَقائِدٍ","يَرى الجَيشَ خَلقاً هَيِّناً كَذُبابِ",17,"ب",1,0],["تَسوَدُّ ديباجاً إِذا فارَقتَها","فَإِذا حَضَرتَ اِخضَوضَرَ الإِستَبرَقُ",18,"ق",1,0],["تُسَوِّدُ الشَمسُ مِنّا بيضَ أَوجُهِنا","وَلا تُسَوِّدُ بيضَ العُذرِ وَاللِمَمِ",19,"م",1,0],["تُسَوِّقُهُ ذُهلُ بنُ ضُبَّةَ فيكُمُ","عَلى حالَةٍ قَد أَفرَدَتهُ العَشائِرُ",20,"ر",1,0],["تَسوقانِ عَبّاداً زَعيماً كَأَنَّما","تَسوقانِ قِرداً لِلحَمالَةِ أَصلَعا",21,"ع",2,0],["تَسوفُ خُزامى الميثِ كُلَّ عَشِيَّةٍ","بِأَزهَرَ كَالدينارِ حُوٌّ مَكاحِلُه",22,"ل",2,0],["تَسومُ المَطايا الضَيمَ يَحفِدنَ خَلفَها","إِذا زاحَمَ الأَحقابَ بِالغَرضِ جائِلُه",23,"ل",2,0],["تَسورُ بِهِ عِندَ المَكارِمِ دارِمٌ","إِلى غايَةِ المُستَصعَباتِ الشَداقِمِ",24,"م",1,0],["تَسوكُ حَصَى بَرد في عَقيق","فَيا لَهُما ظُلِما بالسّواك",25,"ك",1,0],["تُسَوّدُ الحنّاءَ في كَفّهَا","عِشْقاً لمسودّ عِذارِ الشّباب",26,"ب",1,0],["تَسُومُ زُهيراً أن يَزيدَكَ ضلَّةً","عَلَى مائةٍ لو كان غِرّاً لأكثرا",27,"ر",2,0],["تَسوسُ أَمورَ الناسِ تِسعينَ حِجَّةً","وَهَديُكَ مَحمودٌ وَعِرضُكَ وافِرُ",28,"ر",1,0],["تَسَوَّكَت لي بِمِسواكٍ لِتُعلِمَني","ما طَعمُ فيها وَما هَمَّت بِإِصلاحِ",29,"ح",1,0],["تُسَوِّلُ النَفسُ آمالاً وَتَسأَلُها","فَالخَيرُ سُؤلٌ وَحُسنُ الظَنِّ تَسويلُ",30,"ل",1,0],["تَسَوَّقَ الناسُ بِفُرقانِهِم","وَاِنتَبَلوا جَهلاً فَلَم يَنبُلوا",31,"ل",3,0],["تَسَوَّقوا بِالغِنا لِرَبِّهِمُ","وَأَظهَروا خَيفَةً لَهُ وَدَعوا",32,"ع",3,1],["تَسورُ إليهِ الرّاحُ ثمّ تَهابُهُ","كأنَّ الحُمَيّا لوْعةٌ في ابنَةِ الكَرْمِ",33,"م",1,0],["تَسُوفُ النَّوَاعِجُ خَلاَّتِهِ","كَسَوْفِ الجِمَالِ الغَيَارَى مَبَالاَ",34,"ل",2,0],["تُسَوِّغُ مِنهُ العَيشَ في ظِلِّ دَولَةٍ","مُقابَلَةِ الأَرجاءِ بِالكَوكَبِ السَعدِ",35,"د",1,0],["تسوق الحقيقة في روعةٍ","وترمي القشورَ، وتَروى اللبابا",36,"ب",2,0],["تسودُ به: مساواةٌ، وأمن","فما في الأرض: سنَّوْرٌ، وفار",37,"ر",1,0],["تسوسها أنت والايمان يتركها","ما قام عمرك في دعواك برهان",38,"ن",1,0],["تسوقني نزغة الشيطان منغمسا","في ورطة من غرور الزخرف الوضر",39,"ر",1,0],["تسوق النعامى كل ما ينعش القوى","بفضل مزاج في لطيف من الصدق",40,"ق",1,0],["تَسُوقَانِ عمَّاداً زَعِيماً كأَنّماَ","تَسُوقانِ قِرْداً للحَمالَةِ أصْلَعا",41,"ع",2,0],["تسود منها الشمس رأد الضحى","فالعيش ليلٌ سابغ الستر",42,"ر",1,0],["تسومني أن أُنير القولَ فيك وما","يُغني المرقَّشُ من تفويفِ أبرادِ",43,"د",1,0],["تسوت يداك بسطةً وسماحةً","فلم تفخر اليمنى بفضل على اليسرى",44,"ر",2,0],["تَسوقُهُ الريحُ حَثّاً وَهوَ يَسبِقُها","وَيُفرَجُ المَوجُ عَنهُ وَهوَ يَلتَطِمُ",45,"م",1,0],["تسومك اليوم َ بالأحقاد ِ شرذمة ٌ","أعفُّ منها عفافُ الغدر ِ والكذب ِ",46,"ب",1,0],["تَسُومُهُمُ سُوءَ العَذابِ بِغلظَةٍ","عِداهُم وَيُسقونَ المَهانَةَ بِالرَطلِ",47,"ل",1,0],["تَسُوقُهُ الرِيحُ وَتَحتَثُّهُ ال","جَلُّ وَفي الوَجعاءِ مِنهُ الزِمام",48,"م",1,0],["تَسوسُ الأَقاليمَ أَقلامُهُ","فَيا حَبَّذا مَن بِهِ الناس ساسا",49,"س",2,0],["تسود في عيني الدنيا فلم أرها","تبيض إلا إذا ما كنت في النيل",50,"ل",1,0],["تسوس الحياة الجسم وهي مسوسة","بما فيك من أسرار علم مصونة",51,"ه",1,0],["تَسوسُ أَهلَ الإِسلامِ عُملَتَهُم","وَأَنتَ عِندَ الرَحمنِ مُنتَصَحُ",52,"ح",1,0],["تسوَّدُ أَو تُبيضُّ لَوناً واحِداً","كاللَّيلِ طَوْراً والصَّباحِ النَّيّرِ",53,"ر",1,0],["تَسوفُ الأَوابي مَنكِبَيهِ كَأَنَّها","عَذارى قُرَيشٍ غَيرَ أَن لَم تُوَشَّمِ",54,"م",1,0],["تَسوسُ الوَرى يُمنَى يدَيهِ جلالةً","بإعمالِ أَلْمَى يَلْفِظُ الدُّرَّ أَفشَغا",55,"غ",2,0],["تَسومُ جميلَ الرأيِ لا المالَ إنَّه","بَذولٌ له فيما قَضَتْهُ المكارِمُ",56,"م",1,0],["تسودهم نفس هناك أبيَّة","فكانوا إذنْ ما بين نَسْرٍ وفرقد",57,"د",1,0],["تَسْوَدُّ أَيْدي غَيْرِهِ فِي حَرْبِهِ","فَيُضِيئُها بِيَدٍ لَهُ بَيْضاءِ",58,"ا",2,0],["تسوق أرجلها بالوخد أيديها","وشوق ليلى لليلى حثحث الشوقا",59,"ق",2,0],["تسوغُ في حلقه وتُشرقه","بالغيظ فهي الشَّهاد والسُّمُّ",60,"م",1,0],["تسودُ الشعرَ أو تُضحى","لها ساداتُه خَدَما",61,"م",2,0],["تسومين كف المزن أن تضبِط الحيا","ولا تسلم الأسرارُ عند مذيعِ",62,"ع",1,0],["تسوق مطاياها رياح زَكيّةٌ","بما حملت من وصفكم تتعطَّرُ",63,"ر",1,0],["تسوقُ التهاني خلفَها وأمامَها","تُصعِّدُ في الدنيا بكم وتُصَوِّبُ",64,"ب",1,0],["تسوءه سائلا مِن أين سؤددُه","إنّ اللئيم بما قد ساد مسبوبُ",65,"ب",1,0],["تَسور بِه عِندَ العَطِيَّةِ شِيمةٌ","هِيَ الجُودُ مِنهُ غَير أَن يَتَجَوَّدا",66,"د",2,0],["تسوقُها ريحُ الصَّبا","في عارضٍ مسوَدَّ",67,"د",1,0],["تَسوقُ عَضاريطُ الرِكابِ نِساءَكُم","وَقَد غادَروا منهنَّ نَوحاً وَمأتما",68,"م",2,0],["تَسوقُهُ هِمَّةٌ لله خالِصَةٌ","على الكَواكِبِ قد جَرَّتْ حَواشيها",69,"ي",3,0],["تَسومُ بها القُلوبَ فتشْتَريها","ثَنايا البيضِ بالدُّرِّ الثّمينِ",70,"ن",1,0],["تسود وجه الصبح منه رزية","وشابت نواصي الليل وهو وليد",71,"د",1,0],["تسومُني الصَّبرَ عَمّن لي حَلا بِهمِ","جَميعُ ما مَرّ مِن حالاتِ عِشقِهِمِ",72,"م",1,0],["تسوقه النُّجْلُ إذْ بانتْ ويوقظُهُ","على الهوى لَمَعانُ المَبْسَمِ الرَّتِلِ",73,"ل",1,0],["تسوءُ ظُنُوني حين يَحْسُنُ وجْهُهُ","فآخذهُ من غير بَحْثٍ ولا فَحْصِ",74,"ص",1,0],["تَسوقُ إلى العَميمِ مِنَ الغَوادي","غَمائِمَ كَي تَشُقَّ بِها الجُبوبا",75,"ب",2,0],["تُسَوِّدُه مَعَدٌّ حَيثُ كانَت","قَبائِلُها فَمَن قَدَمٌ وعَنس",76,"س",1,0],["تسود وعقل النفس في النفس سُدة","وفيه بحكم الوهم للطبع ردة",77,"ه",1,0],["تسوق إليهم جحفلاً بعد جحفل","يذود العدى عن حوضهم ويدافع",78,"ع",1,0],["تَسْوَدُّ أَيْدي غَيْرِهِ فِي حَرْبِهِ","فَيُضِيئُها قَيدٍ لَهُ بَيْضاءِ",79,"ا",2,0],["تَسوقُ لِعقلي نشاطاً","وتَصرِفُ أسبابَ كربي",80,"ب",2,0],["تَسُوفُ ثَرَاهُ عَن مَشَقِّ إِهَابِهِ","كَأَنَّ أَسَابِيَّ الدِّمَاءِ عَتيرُ",81,"ر",1,0],["تسود كلاد الجن والانس مفخراً","كما ساد منشي لفظها الجن والانسا",82,"س",2,0],["تسوّر بالأعين المعصمين","وتنظم حبّ القلوب الوشاحا",83,"ح",2,0],["تسومنا الضيم بلا علة","يا بنت روما إننا لن نضام",84,"م",1,0],["تسود بني الدنيا وليست تسودهم","وهل أحد إلا مسود وسائد",85,"د",1,0],["تسومونه سُخطاً ويستعطف الرضى","وتولون ما يغنى ويجري بدائمش",86,"م",2,0],["تسوم اصطباراً كلما زاد غدرهُ","وتخضع في كل الأمور وتعذرُ",87,"ر",1,0],["تسوي الخطا كَما القطا","وَظلها يلاعب",88,"ب",1,0],["تسوءُ أهلَ المقتِ طراً كما","تسرُّ من أَمْحَضْتُهُمْ وُدّي",89,"د",2,0],["تسودُ ما بينَ أخدانٍ واقرانِ","وتُمخُ العزَّ في أهلٍ وجيرانِ",90,"ن",1,0],["تَسوفُ وَتوفي كُلَّ نَشزٍ وَفَدفَدٍ","مَرابِضَ أَبناءِ النِفاقِ الأَرانِبِ",91,"ب",1,0],["تسوغ له منادمة المنايا","سياغ الخمر بالماء الزلال",92,"ل",1,0],["تسوء مُعاديكم حسان شواردي","ويُرضي معاليكم مغيبي ومشهدي",93,"د",2,0],["تسوق لكم مني الجنوب مع الصبا","سحابا بأمطار التحية ينضح",94,"ح",1,0],["تسومكما بغياً نمير هضيمة","ستنجد اخبار لهم وتغور",95,"ر",1,0],["تسوقُ صريم شاءها من جُلاجِلٍ","إليّ ودوني ذاتُ كهفٍ وَقورُها",96,"ر",3,0],["تَسوف الوَعد إِلى غَد وَيا","ما أَقرب الخَلف وَما اَبعَد غَد",97,"د",1,1],["تسود أيامها اللاتي اقام بها","سنينها من لدن كانت واشهرها",98,"ر",3,0],["تَسوقُ أُخراهُم أَوائِلَهُم","كَما يَسوقُ المُعارِضُ الجَلَبا",99,"ب",2,0],["تسورن والأزواج فيها أساوراً","وهل في جنان الخلد إلا مسور",100,"ر",1,0],["تسورت بيضاء من فارس","وأرسلت طرفي حتى هُرَاه",101,"ر",3,0],["تسومه الصَّدَّ فيا وصلها","من لأخ البعد بايصالها",102,"ل",3,0],["تسوِّمها نزائع شاردات","تلفُّ أباطحاً وتجوب وعرا",103,"ر",2,0],["تسور صلالا بأقصى الحدود","لها نفثات تذيبُ الحديدا",104,"د",2,0],["تسوءُني رؤيتُه ليته","يقفز كالبرغ