{"poems":[[53,"من رأى أعينا حذفن","https://www.aldiwan.net/poem29625.html","مجزوء الخفيف"],[53,"لكل مجتهد حظ من الطلب","https://www.aldiwan.net/poem30753.html","البسيط"],[71,"ما ضئيل له الهواء مقيل","https://www.aldiwan.net/poem3857.html","الخفيف"],[93,"جاء الكتاب وأصدق","https://www.aldiwan.net/poem11242.html","المجتث"],[93,"أنا في الروض ساهر وهو نائم","https://www.aldiwan.net/poem11410.html","الخفيف"],[88,"دع مزعج اللوم وخل العتاب","https://www.aldiwan.net/poem44807.html","السريع"],[23,"ما هاج حسان رسوم المقام","https://www.aldiwan.net/poem21255.html","السريع"],[51,"يا ابن المسيب عشت في نعم","https://www.aldiwan.net/poem8151.html","الكامل"],[51,"ويلك يا قد البرستوجه","https://www.aldiwan.net/poem9242.html","السريع"],[51,"كأسك قد آذنك العود","https://www.aldiwan.net/poem61888.html","السريع"],[51,"قل للأمير إذا مثلت له","https://www.aldiwan.net/poem64651.html","أحذ الكامل"],[51,"يا نجدة الروم في بطارقها","https://www.aldiwan.net/poem65502.html","المنسرح"],[51,"رأيت كل شراب لا مساغ له","https://www.aldiwan.net/poem66473.html","البسيط"],[16,"هل ما علمت وما استودعت مكتوم","https://www.aldiwan.net/poem27694.html","البسيط"],[85,"كأس من الدنيا تدار","https://www.aldiwan.net/poem62885.html","مجزوء الكامل"],[56,"اشرب هنيا على ورد وتوريد","https://www.aldiwan.net/poem58602.html","البسيط"],[61,"يا من لديه العفاف والورع","https://www.aldiwan.net/poem51572.html","المنسرح"],[58,"كآساد غيل وأشبال خيس","https://www.aldiwan.net/poem30900.html","المتقارب"],[49,"من نافس الناس لم يسلم من الناس","https://www.aldiwan.net/poem62124.html","البسيط"],[66,"هذا إناء حوى ما كان مجتمعا","https://www.aldiwan.net/poem38467.html","البسيط"],[66,"خذ فرصة اللذات قبل فواتها","https://www.aldiwan.net/poem41354.html","الكامل"],[97,"لا تبكها ذهبت ومات هواها","https://www.aldiwan.net/poem24354.html","الكامل"],[97,"يا حبيبي غيمة في خاطري","https://www.aldiwan.net/poem24929.html","الرمل"],[97,"يا صفوة الأحباب والخلان","https://www.aldiwan.net/poem24934.html","الكامل"],[97,"كيف أنسى زمناً كنت به","https://www.aldiwan.net/poem24981.html","الرمل"],[80,"هل أنت فادية فؤاد عميد","https://www.aldiwan.net/poem31494.html","الكامل"],[69,"أأقتل بين جدك والمزاح","https://www.aldiwan.net/poem28551.html","الوافر"],[105,"قل للألى رقدوا والعدل يقظان","https://www.aldiwan.net/poem42055.html","البسيط"],[105,"شجن بقلبك يطمئن ويفزع","https://www.aldiwan.net/poem43093.html","الكامل"],[21,"جهنم تلك لا تبقي بغيا","https://www.aldiwan.net/poem36164.html","الوافر"],[52,"أكثرت يا عاذلي من العذل","https://www.aldiwan.net/poem26726.html","المنسرح"],[75,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[48,"هات من الراح فاسقني الراحا","https://www.aldiwan.net/poem62515.html","المنسرح"],[48,"لا تبك ليلى ولا تطرب إلى هند","https://www.aldiwan.net/poem62546.html","البسيط"],[48,"ألف المدامة فالزمان قصير","https://www.aldiwan.net/poem63259.html","الكامل"],[48,"عصيت في السكر من لحاني","https://www.aldiwan.net/poem66118.html","مجزوء البسيط"],[48,"دعني من الدار أبكيها وأرثيها","https://www.aldiwan.net/poem66175.html","البسيط"],[46,"لو لم تكن طرق هذا الموت موحشة","https://www.aldiwan.net/poem22252.html","البسيط"],[46,"آليت ما مثري الزمان وإن طغى","https://www.aldiwan.net/poem22416.html","الكامل"],[46,"الناس بالأقدار نالوا كل ما","https://www.aldiwan.net/poem22722.html","الكامل"],[46,"أمسي وأمسي في شحط وإن غدي","https://www.aldiwan.net/poem23515.html","البسيط"],[76,"أصغى إليك بكأسه مصغي","https://www.aldiwan.net/poem39261.html","أحذ الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39577","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39579","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54939","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54775","المنسرح"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/9485","الرمل"],[106,"بطش الضعيف","https://www.poetsgate.com/ViewPoem.aspx?id=179576",""],[90,"صفحة من الحياة الشعبية أو بيت يتهدم","https://www.poetsgate.com/ViewPoem.aspx?id=179029",""],[90,"اليأس المنشود","https://www.poetsgate.com/ViewPoem.aspx?id=179218",""]],"verses":[["كَأُسودِ الشَرى رَكِب","نَ الظِباءَ العَواطِيا",0,"ي",2,0],["كَأسٍ إِذا خُضِبَت بِالماءِ لِمَّتُها","شابَت وَإِن ذَلَّ عَنها الماءُ لَم تَشِبِ",1,"ب",1,0],["كاسِياً مِن ثِيابِ فَضلٍ وَفَخرٍ","عارِياً مِن لِباسِ ذُلٍّ وَعارِ",2,"ر",1,0],["كَأسٌ تُرِيبُ فَنُظْمِي","بِخَمْرِهَا الشَّارِبِينَا",3,"ن",2,0],["كَأْسُ مَوْتٍ سَقَاكِهَا وَاسْتَقَاهَا","مِنْ يَدِ الحُزْنِ وَافِياً غَيْرَ نَادِمْ",4,"م",1,0],["كاسيةَ الجسم أرقّ الكُسا","مَوْشِيّة الثوب بوَشيٍ كذاب",5,"ب",1,0],["كَأساً إِذا ما الشَيخُ والى بِها","خَمساً تَرَدّى بِرِداءِ الغُلام",6,"م",1,0],["كأسٌ إذا ما الماءُ واقَعها","صاغ الحُلَى منها بلا تعبِ",7,"ب",1,0],["كأسُ الندامى ما تَغنَّيْتِهمْ","بالصَّابِ والعلقم ممزُوجَهْ",8,"ج",2,0],["كَأسَكَ قد آذَنَكَ العُودُ","ومُسْمِعٌ أصْحَلُ غِرّيدُ",9,"د",1,1],["كأساً كأنك حين تشربها","قمر يُقبل عارَض الشمس",10,"س",1,0],["كأسي مذ غبتمُ معطلة","لم تجر عندي على طرائقها",11,"ق",3,0],["كأسٌ يسوغها الريانُ لذتَها","إذا تأبَّى سواها كُلُّ رَيَّانِ",12,"ن",1,0],["كَأسُ عَزيزٍ مِنَ الأَعنابِ عَتَّقَها","لِبَعضِ أَربابِها حانِيَّةٌ حومُ",13,"م",1,0],["كَأسٌ مِنَ الدُنيا تُدار","مَن ذاقَها خَلَعَ العِذار",14,"ر",1,1],["كَأسُ المَنِيَّةِ في يَدٍ","عَسراءَ ما مِنها فِرار",14,"ر",1,0],["كَأْسٌ إذا أَبْصَرَتْ في القومِ مُحْتَشِماً","قال السُّرورُ له قُمْ غيرَ مَطْرودِ",15,"د",1,0],["كأسُكَ قد فُرِّقَتْ مَفاصِلُه","بين النَّدامى فليسَ تَجتَمِعُ",16,"ع",1,0],["كَآسادِ غيلٍ وَأَشبالِ خيسٍ","غَداةَ الخَميسِ بِبِيضٍ صِقالِ",17,"ل",1,1],["كاسَ الأُلى أَخَذوا لِلمَوتِ عُدَّتَهُ","وَما المُعِدّونَ لِلدُنيا بِأَكياسِ",18,"س",1,0],["كاس وقمع وإبريق ومغرفة","وصحفة وشرابي وقزعان",19,"ن",1,0],["كَأسٌ كَساها النورُ لَمّا أَن بَدا","مِصباحُ جِرمِ الراحِ في مِشكاتِها",20,"ت",3,0],["كأسي وشمسُ هوايَ والساقي الذي","عَصَرَ الشعاعَ لمهجتي وسقاها",21,"ا",3,0],["كاسفات البال عرجاء المنى","عاثرات الحظ شوهاء الظلال",22,"ل",1,0],["كأسيهما من نشوة وحنان","اكتب لوجه الفن لا تعدل به",23,"ه",1,0],["كأس ود لم ترنق أبداً","وصفت كالذهب المنسكب",24,"ب",1,0],["كَأَسِنَّةٍ طَعَنَتْ بها فُرسانُها","ثُمَّ امتَسكنَ عَنِ القَنا بِكبودِ",25,"د",1,0],["كأسمرَ في قلوبِ البيضِ منهُ","شكاوى فَهْيَ شاكيةُ السلاحِ",26,"ح",1,0],["كاسٍ من الشرف العالي يُهيّجُه","مَن يدّعِي المجدَ زُوراً وهو عُريانُ",27,"ن",1,0],["كَأسُ الهَوى العُذرِيِّ فَوقَ يَمينِها","حَرّى يُلِمُّ بِها المَشوقُ فَيُصرَعُ",28,"ع",1,0],["كَأسٌ لا تَصدَعُ شارِبيها","يَلَذُّ بِحُسنِ رُؤيَتِها النَديمُ",29,"م",1,0],["كَأسُ مُدامٍ أَحظَيتُ فَضلَتَها","كَفَّ حَبيبٍ وَالفِعلُ مِن قِبَلي",30,"ل",2,0],["كأسنِمَةِ الآبالِ أو كحُدُوجِهَا","فمِن زاهِقٍ عن نِسَعةٍ ومُزَمَّم",31,"م",1,0],["كَأساً دِهاقاً صِرفاً كَأَنَّ بِها","إِلى فَمِ الشارِبينَ مِصباحا",32,"ح",2,0],["كَأساً إِذا اِنحَدَرَت في حَلقِ شارِبِها","أَجدَتهُ حُمرَتَها في العَينِ وَالخَدِّ",33,"د",1,0],["كَأسٌ مِنَ الراحِ العَتيقِ بِريحِها","قَبلَ المَذاقَةِ في الرُؤوسِ تَسورُ",34,"ر",1,0],["كَأسُ رَحيقٍ وَوَجهُ ظَبيٍ","تَضِلُّ في حُسنِهِ المَعاني",35,"ي",1,0],["كَأساً كَأَنَّ دَبيبَ النَملِ فَترَتُها","لَديغُها يَشتَفي مِن نَفثِ راقيها",36,"ي",3,0],["كَأسُ المَنيَّةِ أَولى بي وَأَروَحُ لي","مِن أَن أُكابِدَ إِثراءً وَإِحواجا",37,"ج",2,0],["كاساتُهُ المَلأى وَعَزفُ قِيانِهِ","لِلحادِثاتِ بَوارِقٌ وَرُعودُ",38,"د",1,0],["كاسٍ لَهُ حُلَلٌ وَعارٍ مَن لَهُ","لَو باتَ يَستُرُ شَخصَهُ بِجِدارِ",39,"ر",1,0],["كاسوا عُقولاً وَكاسَت إِبلُهُم كَرَماً","وَالغَدرُ في الناسِ لَم يُعرَف بِكَيسانِ",40,"ن",1,0],["كأسٌ تؤلّفُ بِالمَحَبَّةِ بَيْنَنا","طَوراً وتَنْزغُ أَيَّما نَزْغِ",41,"غ",1,0],["كأسُنا مترَعٌ وليلتُنا","غادةٌ من مضارِبِ العربِ",42,"ب",1,0],["كأسنا ضاحِكُ الحبَا","بِ مُصَفَّى من الكدَرْ",43,"ر",1,0],["كَأْسٌ رَأَيْتُ لَهَا نِظَاماً مُونِقاً","فَثَمِلْتُ قَبْلَ شُرَابِهَا بِالمَنْظَرِ",44,"ر",1,1],["كَأْسٌ هِيَ الْبَحْرُ بِالسُّرُورِ طَغَى","وَجَارِيَاتُ الأَسَى بِهِ قِدَدُ",45,"د",1,0],["كاسِياتِ طِمِرٍّ","كادَ يُلقي اللِجاما",46,"م",2,0],["كأسٌ تدور على ثغورِ ظماءِ","مُلئتْ بذوب الفضَّة البيضاءِ",47,"ا",2,1],["كاسراً جفنَه يخالِسُني اللحظَ","لأمرٍ في النفسِ يكسِرُ جَفْنا",48,"ن",2,0],["كأسَينِ ، كاساً لهم بالشُهد منزعةً","وللجماهير كأساً سَمُّها نَقَعا",49,"ع",2,0]]}