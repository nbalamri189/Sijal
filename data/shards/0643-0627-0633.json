5652,"شاعر ولي بالشعر وقفه وجمهور ؟","https://www.poetsgate.com/ViewPoem.aspx?id=175169",""],[5689,"حطمت لي يد القضا كل فلس","https://www.poetsgate.com/ViewPoem.aspx?id=143434",""],[5704,"صعُبَ الكلام على الكلام...","https://www.poetsgate.com/ViewPoem.aspx?id=200003",""],[5717,"صب تسامره بدور","https://www.poetsgate.com/ViewPoem.aspx?id=170584",""],[5725,"جاوزت ان لم تعلمي الحدا","https://www.poetsgate.com/ViewPoem.aspx?id=199871",""],[5747,"بين فرح وبين جرح","https://www.poetsgate.com/ViewPoem.aspx?id=61682",""],[5758,"عَيْنَاهَا","https://www.poetsgate.com/ViewPoem.aspx?id=200528",""],[5781,"يا ملك","https://www.poetsgate.com/ViewPoem.aspx?id=208773",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[5848,"شموخ المملكه","https://www.poetsgate.com/ViewPoem.aspx?id=53331",""],[5861,"معزوفة الجحيم","https://www.poetsgate.com/ViewPoem.aspx?id=188090",""],[5873,"المدلة بالجمال","https://www.poetsgate.com/ViewPoem.aspx?id=215918",""],[5888,"للراقصين بالعتمة","https://www.poetsgate.com/ViewPoem.aspx?id=214505",""],[5909,"النفس أخصب رهوَها الإفناءُ","https://www.poetsgate.com/ViewPoem.aspx?id=210697",""],[6089,"النبي الخاتم","https://www.poetsgate.com/ViewPoem.aspx?id=213039",""],[6093,"الوالد المسكينُ","https://www.poetsgate.com/ViewPoem.aspx?id=206539",""],[549,"موسيقى مؤجَّلة","https://www.poetsgate.com/ViewPoem.aspx?id=202998",""],[6115,"رفرفي ياراية التوحيد عالي","https://www.poetsgate.com/ViewPoem.aspx?id=196475",""],[6148,"بشري","https://www.poetsgate.com/ViewPoem.aspx?id=202057",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""],[5377,"إلي وطني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79564&r=&rc=20",""],[313,"يا شادي البان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66516&r=&rc=38",""],[6180,"الأعداء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81071&r=&rc=5",""],[5555,"فِيْ حَضْرَةِ المُتَنَبِّي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87405&r=&rc=1",""],[5555,"مُعَلَّقَةٌ لِلِاحتِفَاءِ بِالْهَشَاشَةِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87404&r=&rc=0",""],[6300,"كلمات في المنفى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82851&r=&rc=22",""],[147,"هَلْ لِلْخَلِيطِ الْمُسْتِقلِّ إِيَابُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27447&r=&rc=14",""]],"verses":[["كَأُسودِ الشَرى رَكِب","نَ الظِباءَ العَواطِيا",0,"ي",2,0],["كَأسٍ إِذا خُضِبَت بِالماءِ لِمَّتُها","شابَت وَإِن ذَلَّ عَنها الماءُ لَم تَشِبِ",1,"ب",1,0],["كاسِياً مِن ثِيابِ فَضلٍ وَفَخرٍ","عارِياً مِن لِباسِ ذُلٍّ وَعارِ",2,"ر",1,0],["كَأسٌ تُرِيبُ فَنُظْمِي","بِخَمْرِهَا الشَّارِبِينَا",3,"ن",2,0],["كَأْسُ مَوْتٍ سَقَاكِهَا وَاسْتَقَاهَا","مِنْ يَدِ الحُزْنِ وَافِياً غَيْرَ نَادِمْ",4,"م",1,0],["كاسيةَ الجسم أرقّ الكُسا","مَوْشِيّة الثوب بوَشيٍ كذاب",5,"ب",1,0],["كَأساً إِذا ما الشَيخُ والى بِها","خَمساً تَرَدّى بِرِداءِ الغُلام",6,"م",1,0],["كأسٌ إذا ما الماءُ واقَعها","صاغ الحُلَى منها بلا تعبِ",7,"ب",1,0],["كأسُ الندامى ما تَغنَّيْتِهمْ","بالصَّابِ والعلقم ممزُوجَهْ",8,"ج",2,0],["كَأسَكَ قد آذَنَكَ العُودُ","ومُسْمِعٌ أصْحَلُ غِرّيدُ",9,"د",1,1],["كأساً كأنك حين تشربها","قمر يُقبل عارَض الشمس",10,"س",1,0],["كأسي مذ غبتمُ معطلة","لم تجر عندي على طرائقها",11,"ق",3,0],["كأسٌ يسوغها الريانُ لذتَها","إذا تأبَّى سواها كُلُّ رَيَّانِ",12,"ن",1,0],["كَأسُ عَزيزٍ مِنَ الأَعنابِ عَتَّقَها","لِبَعضِ أَربابِها حانِيَّةٌ حومُ",13,"م",1,0],["كَأسٌ مِنَ الدُنيا تُدار","مَن ذاقَها خَلَعَ العِذار",14,"ر",1,1],["كَأسُ المَنِيَّةِ في يَدٍ","عَسراءَ ما مِنها فِرار",14,"ر",1,0],["كَأْسٌ إذا أَبْصَرَتْ في القومِ مُحْتَشِماً","قال السُّرورُ له قُمْ غيرَ مَطْرودِ",15,"د",1,0],["كأسُكَ قد فُرِّقَتْ مَفاصِلُه","بين النَّدامى فليسَ تَجتَمِعُ",16,"ع",1,0],["كَآسادِ غيلٍ وَأَشبالِ خيسٍ","غَداةَ الخَميسِ بِبِيضٍ صِقالِ",17,"ل",1,1],["كاسَ الأُلى أَخَذوا لِلمَوتِ عُدَّتَهُ","وَما المُعِدّونَ لِلدُنيا بِأَكياسِ",18,"س",1,0],["كاس وقمع وإبريق ومغرفة","وصحفة وشرابي وقزعان",19,"ن",1,0],["كَأسٌ كَساها النورُ لَمّا أَن بَدا","مِصباحُ جِرمِ الراحِ في مِشكاتِها",20,"ت",3,0],["كأسي وشمسُ هوايَ والساقي الذي","عَصَرَ الشعاعَ لمهجتي وسقاها",21,"ا",3,0],["كاسفات البال عرجاء المنى","عاثرات الحظ شوهاء الظلال",22,"ل",1,0],["كأسيهما من نشوة وحنان","اكتب لوجه الفن لا تعدل به",23,"ه",1,0],["كأس ود لم ترنق أبداً","وصفت كالذهب المنسكب",24,"ب",1,0],["كَأَسِنَّةٍ طَعَنَتْ بها فُرسانُها","ثُمَّ امتَسكنَ عَنِ القَنا بِكبودِ",25,"د",1,0],["كأسمرَ في قلوبِ البيضِ منهُ","شكاوى فَهْيَ شاكيةُ السلاحِ",26,"ح",1,0],["كاسٍ من الشرف العالي يُهيّجُه","مَن يدّعِي المجدَ زُوراً وهو عُريانُ",27,"ن",1,0],["كَأسُ الهَوى العُذرِيِّ فَوقَ يَمينِها","حَرّى يُلِمُّ بِها المَشوقُ فَيُصرَعُ",28,"ع",1,0],["كَأسٌ لا تَصدَعُ شارِبيها","يَلَذُّ بِحُسنِ رُؤيَتِها النَديمُ",29,"م",1,0],["كَأسُ مُدامٍ أَحظَيتُ فَضلَتَها","كَفَّ حَبيبٍ وَالفِعلُ مِن قِبَلي",30,"ل",2,0],["كأسنِمَةِ الآبالِ أو كحُدُوجِهَا","فمِن زاهِقٍ عن نِسَعةٍ ومُزَمَّم",31,"م",1,0],["كَأساً دِهاقاً صِرفاً كَأَنَّ بِها","إِلى فَمِ الشارِبينَ مِصباحا",32,"ح",2,0],["كَأساً إِذا اِنحَدَرَت في حَلقِ شارِبِها","أَجدَتهُ حُمرَتَها في العَينِ وَالخَدِّ",33,"د",1,0],["كَأسٌ مِنَ الراحِ العَتيقِ بِريحِها","قَبلَ المَذاقَةِ في الرُؤوسِ تَسورُ",34,"ر",1,0],["كَأسُ رَحيقٍ وَوَجهُ ظَبيٍ","تَضِلُّ في حُسنِهِ المَعاني",35,"ن",2,0],["كَأساً كَأَنَّ دَبيبَ النَملِ فَترَتُها","لَديغُها يَشتَفي مِن نَفثِ راقيها",36,"ي",3,0],["كَأسُ المَنيَّةِ أَولى بي وَأَروَحُ لي","مِن أَن أُكابِدَ إِثراءً وَإِحواجا",37,"ج",2,0],["كاساتُهُ المَلأى وَعَزفُ قِيانِهِ","لِلحادِثاتِ بَوارِقٌ وَرُعودُ",38,"د",1,0],["كاسٍ لَهُ حُلَلٌ وَعارٍ مَن لَهُ","لَو باتَ يَستُرُ شَخصَهُ بِجِدارِ",39,"ر",1,0],["كاسوا عُقولاً وَكاسَت إِبلُهُم كَرَماً","وَالغَدرُ في الناسِ لَم يُعرَف بِكَيسانِ",40,"ن",1,0],["كأسٌ تؤلّفُ بِالمَحَبَّةِ بَيْنَنا","طَوراً وتَنْزغُ أَيَّما نَزْغِ",41,"غ",1,0],["كأسُنا مترَعٌ وليلتُنا","غادةٌ من مضارِبِ العربِ",42,"ب",1,0],["كأسنا ضاحِكُ الحبَا","بِ مُصَفَّى من الكدَرْ",43,"ر",1,0],["كَأْسٌ رَأَيْتُ لَهَا نِظَاماً مُونِقاً","فَثَمِلْتُ قَبْلَ شُرَابِهَا بِالمَنْظَرِ",44,"ر",1,1],["كَأْسٌ هِيَ الْبَحْرُ بِالسُّرُورِ طَغَى","وَجَارِيَاتُ الأَسَى بِهِ قِدَدُ",45,"د",1,0],["كاسِياتِ طِمِرٍّ","كادَ يُلقي اللِجاما",46,"م",2,0],["كأسٌ تدور على ثغورِ ظماءِ","مُلئتْ بذوب الفضَّة البيضاءِ",47,"ا",2,1],["كاسراً جفنَه يخالِسُني اللحظَ","لأمرٍ في النفسِ يكسِرُ جَفْنا",48,"ن",2,0],["كأسَينِ ، كاساً لهم بالشُهد منزعةً","وللجماهير كأساً سَمُّها نَقَعا",49,"ع",2,0],["كأس المنيّة في فرند حسامه","فإذا التقت حلق البطان أدارها",50,"ر",3,0],["كاس لماك حلو","وعطره زكي",51,"ي",1,0],["كأسمه حسن الاخلاق جمله","برتبة الرفعة الوفرى تواضعه",52,"ع",2,0],["كاس المحبة مر","حلو وهذا عجيب",53,"ب",1,1],["كأس المنون منوع في هجره","وحياة عاشقه بسر وصاله",54,"ل",2,0],["كأساً زعمتم إنها","خمر فأذ هي كأس صاب",55,"ب",1,0],["كأس الممات على البرية شُربُه","حتمٌ ومنه ليس ينجو ممكن",56,"ن",1,0],["كأسٌ أدرَّت على لذاذتها","عُدّل فيها الزُّعافُ والعسلُ",57,"ل",1,0],["كاسٍ مِنَ الأَسقامِ جُرِّعَ لِلنَوى","كَأساً لَهُ ريقُ الحُبابِ حَبابُ",58,"ب",1,0],["كاسيةٍ من ملح التصابي","أَجفانُها َنشْوى بلا شرابِ",59,"ب",1,0],["كَأسنانِ مشطٍ كلُّهم في ضَلالهم","فَلا أَحدٌ يُبدي على أَحدٍ فَخرا",60,"ر",2,0],["كَأُستاذهِ في الدين حازَ مساوياً","إِذا مُزِجت بالبحرِ أفسدتِ البحرا",60,"ر",2,0],["كَأسنانِ مشطِ العربُ مثلُ الأعاجمِ","وَقَد جعلَ التَقوى أجلّ المكارمِ",61,"م",1,0],["كأس إذا أبصرت في اليوم محتشماً","قال السرورُ له قم غير مطرودِ",62,"د",1,0],["كأس الرحيق صدعته","وللربيع وهبتُه",63,"ه",1,0],["كَأسٌ كَأَنَّ مُدامَها مِن ريقِهِ","كَرماً وَيَلثُمُنا شَفيقُ خُدودِهِ",64,"د",2,0],["كاسِرٌ مُقلَتَيهِ وَاللَيلُ قَد أَد","بَرَ في فَلِ جَيشِهِ المَكسورِ",65,"ر",1,0],["كأس المحبّهْ بمسك الأنس لي مختوم","قد ساقه بالرضا ساقي القضا المحتوم",66,"م",1,1],["كأس الهنا بسلاف الأنس قد طفحتْ","فاشرب وعربد وخلّ النفس إن شطحتْ",67,"ت",1,1],["كأْسُكَ الأُولى تمشَّتْ","في عروقي وَعظامي",68,"م",2,0],["كأْسٌ تدارُ عَلَى هوى الأحبابِ","شفة تعللُ راشفاً برضاب",69,"ب",1,1],["كأسود وله كف خواتمها","در تحمل مرآةً من الذهب",70,"ب",1,0],["كأسرار موسى حين ألقته أمه","رضيعاً بأمر اللَه في وسط لجة",71,"ه",1,0],["كَأسٌ تدارُ بصفوِ ودٍّ لم يَشُب","إلّا الدعاءُ أو الثناءُ مزاجه",72,"ج",2,0],["كأسودَ بارحٍ لم يعن إلّا","بأكلِ الشرشمانة والضبابِ",73,"ب",1,0],["كأسُك الشكر وهو شهدٌ مصفّى","مُزِجت لك فيه قطرة صابِ",74,"ب",1,0],["كأسٌ دِهاقٌ لآدابٍ صُبِحْتُ بها","من كَفّ موليَ ولكنْ طَرفيَ الحاسي",75,"س",2,0],["كأسٌ من السّحْرِ الحلا","لِ لشُرْبِها بالقومِ سُكر",76,"ر",1,0],["كَأسٌ مِنَ البَغيِ لِلأَلبابِ ناهبَةٌ","كَذَلِكَ الكَأسُ لِلأَلبابِ تَنتَهِبُ",77,"ب",1,0],["كأسُ الهَوى والخَمرِ واحِدَةٌ","كلٌّ مُسَلَّطةٌ علَى العَقلِ",78,"ل",1,0],["كأساً إذا جُليت علينا في الدجى","لم يبق منه غيرُ صدعٍ أسودِ",79,"د",1,0],["كاسٍ من الشحناء عاراً مثلما","خلع الحيا عنه فكان العاري",80,"ر",2,0],["كَأسُ حماها سَقَتني","عن حُمَيّاها حُماها",81,"ا",3,0],["كأسلاف لكم كانا ملوكاً","لهم مجد يسامي كل سام",82,"م",1,0],["كاسٌ من الفِعل الجميلِ وإنّهُ","قمِنٌ به عارٍ من العوراءِ",83,"ا",2,0],["كاسون من حلل الثنا","عارون من عيب وشين",84,"ن",1,0],["كاس من الليل بالظلماء ملتحف","لكنما زانهُ التحجيل بالجبَبِ",85,"ب",1,0],["كاس من احلمد ثوباً ليس يخلفه","دهر ولكنّه عار من العار",86,"ر",1,0],["كأس به شرب الهزبر من الردى","تسقاه أَم القشعم الشعواء",87,"ا",2,0],["كأس المنية منها شارب ملك","وسوقة وأولو الاعدام والضعف",88,"ف",1,0],["كأس من الراح أم كأس من الأدب","دارت علينا فحيعلنا على الطرب",89,"ب",1,1],["كأسارى مخضوبة بدمائها","رقمت بجوهر لؤلؤ فتاتي",90,"ت",2,0],["كأسي ومحبوبي وروحي والهوى","لا غير ذا وعليلنا ملتاح",91,"ح",1,0],["كأس بها خمر ناحب القل","وب فماله في الكاس عني براح",91,"ح",1,0],["كأْسي صفَا دَهري وفي جِسمي عفَا","ففي الخَفَا أصبحْتُ معنًى للخَفَا",92,"ف",2,0],["كَأسُ الخطُوب بذا العدُوّ دِهاقُ","والدين قلبُه واجفٌ خَفّاق",93,"ق",1,1],["كَأسُ راحٍ إذا تَبَدَّت أَمامي","طالَ شَوقي لها وطالَ حَنينِي",94,"ن",2,0],["كأسٌ فِلسطيَّةٌ مُعَتَّقَةٌ","شيبَتَ بِماءٍ مِن مُزنَةِ السبلِ",95,"ل",1,0],["كأساً بفيها صَهباءَ مُعرِقَةً","يَغلو بِأَيدي التِجار مَسبَؤُها",96,"ا",3,0],["كاساً من الحجر الرخام مدوَّراً","في بركةٍ جمعت بفكرٍ شاردِ",97,"د",1,0],["كاس حسن وكاس عشق وإني","بهما الآن لم أزل سكرانا",98,"ن",2,0],["كأس صفت بيد المدير ف