{"poems":[[53,"من رأى أعينا حذفن","https://www.aldiwan.net/poem29625.html","مجزوء الخفيف"],[53,"لكل مجتهد حظ من الطلب","https://www.aldiwan.net/poem30753.html","البسيط"],[71,"ما ضئيل له الهواء مقيل","https://www.aldiwan.net/poem3857.html","الخفيف"],[93,"جاء الكتاب وأصدق","https://www.aldiwan.net/poem11242.html","المجتث"],[93,"أنا في الروض ساهر وهو نائم","https://www.aldiwan.net/poem11410.html","الخفيف"],[88,"دع مزعج اللوم وخل العتاب","https://www.aldiwan.net/poem44807.html","السريع"],[23,"ما هاج حسان رسوم المقام","https://www.aldiwan.net/poem21255.html","السريع"],[51,"يا ابن المسيب عشت في نعم","https://www.aldiwan.net/poem8151.html","الكامل"],[51,"ويلك يا قد البرستوجه","https://www.aldiwan.net/poem9242.html","السريع"],[51,"كأسك قد آذنك العود","https://www.aldiwan.net/poem61888.html","السريع"],[51,"قل للأمير إذا مثلت له","https://www.aldiwan.net/poem64651.html","أحذ الكامل"],[51,"يا نجدة الروم في بطارقها","https://www.aldiwan.net/poem65502.html","المنسرح"],[51,"رأيت كل شراب لا مساغ له","https://www.aldiwan.net/poem66473.html","البسيط"],[16,"هل ما علمت وما استودعت مكتوم","https://www.aldiwan.net/poem27694.html","البسيط"],[85,"كأس من الدنيا تدار","https://www.aldiwan.net/poem62885.html","مجزوء الكامل"],[56,"اشرب هنيا على ورد وتوريد","https://www.aldiwan.net/poem58602.html","البسيط"],[61,"يا من لديه العفاف والورع","https://www.aldiwan.net/poem51572.html","المنسرح"],[58,"كآساد غيل وأشبال خيس","https://www.aldiwan.net/poem30900.html","المتقارب"],[49,"من نافس الناس لم يسلم من الناس","https://www.aldiwan.net/poem62124.html","البسيط"],[66,"هذا إناء حوى ما كان مجتمعا","https://www.aldiwan.net/poem38467.html","البسيط"],[66,"خذ فرصة اللذات قبل فواتها","https://www.aldiwan.net/poem41354.html","الكامل"],[97,"لا تبكها ذهبت ومات هواها","https://www.aldiwan.net/poem24354.html","الكامل"],[97,"يا حبيبي غيمة في خاطري","https://www.aldiwan.net/poem24929.html","الرمل"],[97,"يا صفوة الأحباب والخلان","https://www.aldiwan.net/poem24934.html","الكامل"],[97,"كيف أنسى زمناً كنت به","https://www.aldiwan.net/poem24981.html","الرمل"],[80,"هل أنت فادية فؤاد عميد","https://www.aldiwan.net/poem31494.html","الكامل"],[69,"أأقتل بين جدك والمزاح","https://www.aldiwan.net/poem28551.html","الوافر"],[105,"قل للألى رقدوا والعدل يقظان","https://www.aldiwan.net/poem42055.html","البسيط"],[105,"شجن بقلبك يطمئن ويفزع","https://www.aldiwan.net/poem43093.html","الكامل"],[21,"جهنم تلك لا تبقي بغيا","https://www.aldiwan.net/poem36164.html","الوافر"],[52,"أكثرت يا عاذلي من العذل","https://www.aldiwan.net/poem26726.html","المنسرح"],[75,"أصاخت فقالت وقع أجرد شيظم","https://www.aldiwan.net/poem69040.html","الطويل"],[48,"هات من الراح فاسقني الراحا","https://www.aldiwan.net/poem62515.html","المنسرح"],[48,"لا تبك ليلى ولا تطرب إلى هند","https://www.aldiwan.net/poem62546.html","البسيط"],[48,"ألف المدامة فالزمان قصير","https://www.aldiwan.net/poem63259.html","الكامل"],[48,"عصيت في السكر من لحاني","https://www.aldiwan.net/poem66118.html","مجزوء البسيط"],[48,"دعني من الدار أبكيها وأرثيها","https://www.aldiwan.net/poem66175.html","البسيط"],[46,"لو لم تكن طرق هذا الموت موحشة","https://www.aldiwan.net/poem22252.html","البسيط"],[46,"آليت ما مثري الزمان وإن طغى","https://www.aldiwan.net/poem22416.html","الكامل"],[46,"الناس بالأقدار نالوا كل ما","https://www.aldiwan.net/poem22722.html","الكامل"],[46,"أمسي وأمسي في شحط وإن غدي","https://www.aldiwan.net/poem23515.html","البسيط"],[76,"أصغى إليك بكأسه مصغي","https://www.aldiwan.net/poem39261.html","أحذ الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39577","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39579","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54939","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54775","المنسرح"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/9485","الرمل"],[106,"بطش الضعيف","https://www.poetsgate.com/ViewPoem.aspx?id=179576",""],[90,"صفحة من الحياة الشعبية أو بيت يتهدم","https://www.poetsgate.com/ViewPoem.aspx?id=179029",""],[90,"اليأس المنشود","https://www.poetsgate.com/ViewPoem.aspx?id=179218",""],[113,"هيمني آمي","https://www.aldiwan.net/poem40410.html","عموديه"],[113,"الحمد لله لي من عترتي قمر","https://www.aldiwan.net/poem40908.html","عموديه"],[113,"كاس المحبة مر","https://www.aldiwan.net/poem41534.html","المجتث"],[113,"أواه من ظبي النقا ودلاله","https://www.aldiwan.net/poem41660.html","الكامل"],[122,"قالوا أناب وما أناب","https://www.aldiwan.net/poem23721.html","مجزوء الكامل"],[133,"الصبر ليس على فراقك يحسن","https://www.aldiwan.net/poem49163.html","الكامل"],[140,"لا مرية في الردى ولا جدل","https://www.aldiwan.net/poem58417.html","المنسرح"],[141,"هل للخليط المستقل إياب","https://www.aldiwan.net/poem11723.html","الكامل"],[153,"وغادة ترفل في الشباب","https://www.aldiwan.net/poem55794.html","الرجز"],[187,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[187,"مقام أجل الرسل أعلى وأعظم","https://www.aldiwan.net/poem35106.html","الطويل"],[202,"اليوم فاشرب على ورد وتوريد","https://www.aldiwan.net/poem53334.html","البسيط"],[209,"ما عبقر بقدير أن يصوغ هوى","https://www.aldiwan.net/poem46581.html","البسيط"],[230,"أحيى بموعده قتيل وعوده","https://www.aldiwan.net/poem14809.html","الكامل"],[233,"من عذيري فيه وهل من عذير","https://www.aldiwan.net/poem32017.html","الخفيف"],[257,"كأس المحبه بمسك الأنس لي مختوم","https://www.aldiwan.net/poem35320.html","المواليا"],[257,"كأس الهنا بسلاف الأنس قد طفحت","https://www.aldiwan.net/poem35772.html","البسيط"],[296,"لاح في جنح الظلام","https://www.aldiwan.net/poem36799.html","عموديه"],[296,"كأْس تدار على هوى الأحباب","https://www.aldiwan.net/poem36800.html","عموديه"],[301,"كم زارني والثريا يلوها قمر","https://www.aldiwan.net/poem57850.html","الكامل"],[302,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[303,"أنهي لمجلسك العلي تحية","https://www.aldiwan.net/poem56585.html","الكامل"],[303,"عوى الضبع الملفلف في الثياب","https://www.aldiwan.net/poem56599.html","البسيط"],[303,"عظم الأجر عن عظيم المصاب","https://www.aldiwan.net/poem56609.html","الكامل"],[362,"بالكتب طرا كتاب خطه ملك","https://www.aldiwan.net/poem60873.html","البسيط"],[362,"في الجيرة الغادين بدر","https://www.aldiwan.net/poem60895.html","مجزوء الكامل"],[364,"أما ومنك على أعدائك الطلب","https://www.aldiwan.net/poem17155.html","البسيط"],[369,"رسل المدامع أبلغ الرسل","https://www.aldiwan.net/poem57203.html","أحذ الكامل"],[369,"أرأيت إن أخذ الغرام على يدي","https://www.aldiwan.net/poem57502.html","الكامل"],[374,"بئس الزمان المرتدي بشرار","https://www.aldiwan.net/poem59431.html","الكامل"],[390,"بلغت نفسي مناها","https://www.aldiwan.net/poem53668.html","مجزوء الرمل"],[400,"إلى الأشراف أعيان الأنام","https://www.aldiwan.net/poem33410.html","الوافر"],[429,"شق الصباح غلالة الظلماء","https://www.aldiwan.net/poem12771.html","الكامل"],[434,"صب قتيل المقلتين","https://www.aldiwan.net/poem2556.html","مجزوء الكامل"],[434,"ما بعد رامة للمشتاق من إرب","https://www.aldiwan.net/poem2580.html","البسيط"],[434,"أأستجبر عليهم دمعي الجاري","https://www.aldiwan.net/poem2595.html","البسيط"],[438,"حسن العزاء لكم كحسن عزاء","https://www.aldiwan.net/poem14435.html","الكامل"],[438,"سيان في الموت ذو العيلات والترف","https://www.aldiwan.net/poem14462.html","البسيط"],[477,"كأس من الراح أم كأس من الأدب","https://www.aldiwan.net/poem36934.html","البسيط"],[480,"وغزالة لغزالة خضعت ولكن","https://www.aldiwan.net/poem24327.html","عموديه"],[480,"أدر المدامة يا نديم إلى الصباح","https://www.aldiwan.net/poem24333.html","عموديه"],[498,"رفرف غصن البان لا بمرق","https://www.aldiwan.net/poem37963.html","الرجز"],[536,"كأس الخطوب بذا العدو دهاق","https://www.aldiwan.net/poem47536.html","عموديه"],[536,"قلت يوما لها وكنت حياتي","https://www.aldiwan.net/poem47923.html","عموديه"],[538,"كأن فاها لمن تؤنسه","https://www.aldiwan.net/poem56703.html","البسيط"],[538,"إن سليمى والله يكلؤها","https://www.aldiwan.net/poem56917.html","المنسرح"],[556,"ولقد شهدت قبالة الأقصى الذي","https://www.aldiwan.net/poem33495.html","عموديه"],[556,"نحن قوم نهوى الوجوه الحسانا","https://www.aldiwan.net/poem33816.html","الخفيف"],[556,"تب منك حين تقول يا فتاح","https://www.aldiwan.net/poem34679.html","الكامل"],[560,"أسفا لمن قد مات قبل مماته","https://www.aldiwan.net/poem52864.html","الكامل"],[560,"نادى منادي البين حي على السرى","https://www.aldiwan.net/poem52892.html","الكامل"],[565,"لا وجفون ينفثن في العقد","https://www.aldiwan.net/poem69709.html","البسيط"],[565,"للمهرجان عليك حق سنه","https://www.aldiwan.net/poem69714.html","الكامل"]],"verses":[["كَأُسودِ الشَرى رَكِب","نَ الظِباءَ العَواطِيا",0,"ي",2,0],["كَأسٍ إِذا خُضِبَت بِالماءِ لِمَّتُها","شابَت وَإِن ذَلَّ عَنها الماءُ لَم تَشِبِ",1,"ب",1,0],["كاسِياً مِن ثِيابِ فَضلٍ وَفَخرٍ","عارِياً مِن لِباسِ ذُلٍّ وَعارِ",2,"ر",1,0],["كَأسٌ تُرِيبُ فَنُظْمِي","بِخَمْرِهَا الشَّارِبِينَا",3,"ن",2,0],["كَأْسُ مَوْتٍ سَقَاكِهَا وَاسْتَقَاهَا","مِنْ يَدِ الحُزْنِ وَافِياً غَيْرَ نَادِمْ",4,"م",1,0],["كاسيةَ الجسم أرقّ الكُسا","مَوْشِيّة الثوب بوَشيٍ كذاب",5,"ب",1,0],["كَأساً إِذا ما الشَيخُ والى بِها","خَمساً تَرَدّى بِرِداءِ الغُلام",6,"م",1,0],["كأسٌ إذا ما الماءُ واقَعها","صاغ الحُلَى منها بلا تعبِ",7,"ب",1,0],["كأسُ الندامى ما تَغنَّيْتِهمْ","بالصَّابِ والعلقم ممزُوجَهْ",8,"ج",2,0],["كَأسَكَ قد آذَنَكَ العُودُ","ومُسْمِعٌ أصْحَلُ غِرّيدُ",9,"د",1,1],["كأساً كأنك حين تشربها","قمر يُقبل عارَض الشمس",10,"س",1,0],["كأسي مذ غبتمُ معطلة","لم تجر عندي على طرائقها",11,"ق",3,0],["كأسٌ يسوغها الريانُ لذتَها","إذا تأبَّى سواها كُلُّ رَيَّانِ",12,"ن",1,0],["كَأسُ عَزيزٍ مِنَ الأَعنابِ عَتَّقَها","لِبَعضِ أَربابِها حانِيَّةٌ حومُ",13,"م",1,0],["كَأسٌ مِنَ الدُنيا تُدار","مَن ذاقَها خَلَعَ العِذار",14,"ر",1,1],["كَأسُ المَنِيَّةِ في يَدٍ","عَسراءَ ما مِنها فِرار",14,"ر",1,0],["كَأْسٌ إذا أَبْصَرَتْ في القومِ مُحْتَشِماً","قال السُّرورُ له قُمْ غيرَ مَطْرودِ",15,"د",1,0],["كأسُكَ قد فُرِّقَتْ مَفاصِلُه","بين النَّدامى فليسَ تَجتَمِعُ",16,"ع",1,0],["كَآسادِ غيلٍ وَأَشبالِ خيسٍ","غَداةَ الخَميسِ بِبِيضٍ صِقالِ",17,"ل",1,1],["كاسَ الأُلى أَخَذوا لِلمَوتِ عُدَّتَهُ","وَما المُعِدّونَ لِلدُنيا بِأَكياسِ",18,"س",1,0],["كاس وقمع وإبريق ومغرفة","وصحفة وشرابي وقزعان",19,"ن",1,0],["كَأسٌ كَساها النورُ لَمّا أَن بَدا","مِصباحُ جِرمِ الراحِ في مِشكاتِها",20,"ت",3,0],["كأسي وشمسُ هوايَ والساقي الذي","عَصَرَ الشعاعَ لمهجتي وسقاها",21,"ا",3,0],["كاسفات البال عرجاء المنى","عاثرات الحظ شوهاء الظلال",22,"ل",1,0],["كأسيهما من نشوة وحنان","اكتب لوجه الفن لا تعدل به",23,"ه",1,0],["كأس ود لم ترنق أبداً","وصفت كالذهب المنسكب",24,"ب",1,0],["كَأَسِنَّةٍ طَعَنَتْ بها فُرسانُها","ثُمَّ امتَسكنَ عَنِ القَنا بِكبودِ",25,"د",1,0],["كأسمرَ في قلوبِ البيضِ منهُ","شكاوى فَهْيَ شاكيةُ السلاحِ",26,"ح",1,0],["كاسٍ من الشرف العالي يُهيّجُه","مَن يدّعِي المجدَ زُوراً وهو عُريانُ",27,"ن",1,0],["كَأسُ الهَوى العُذرِيِّ فَوقَ يَمينِها","حَرّى يُلِمُّ بِها المَشوقُ فَيُصرَعُ",28,"ع",1,0],["كَأسٌ لا تَصدَعُ شارِبيها","يَلَذُّ بِحُسنِ رُؤيَتِها النَديمُ",29,"م",1,0],["كَأسُ مُدامٍ أَحظَيتُ فَضلَتَها","كَفَّ حَبيبٍ وَالفِعلُ مِن قِبَلي",30,"ل",2,0],["كأسنِمَةِ الآبالِ أو كحُدُوجِهَا","فمِن زاهِقٍ عن نِسَعةٍ ومُزَمَّم",31,"م",1,0],["كَأساً دِهاقاً صِرفاً كَأَنَّ بِها","إِلى فَمِ الشارِبينَ مِصباحا",32,"ح",2,0],["كَأساً إِذا اِنحَدَرَت في حَلقِ شارِبِها","أَجدَتهُ حُمرَتَها في العَينِ وَالخَدِّ",33,"د",1,0],["كَأسٌ مِنَ الراحِ العَتيقِ بِريحِها","قَبلَ المَذاقَةِ في الرُؤوسِ تَسورُ",34,"ر",1,0],["كَأسُ رَحيقٍ وَوَجهُ ظَبيٍ","تَضِلُّ في حُسنِهِ المَعاني",35,"ي",1,0],["كَأساً كَأَنَّ دَبيبَ النَملِ فَترَتُها","لَديغُها يَشتَفي مِن نَفثِ راقيها",36,"ي",3,0],["كَأسُ المَنيَّةِ أَولى بي وَأَروَحُ لي","مِن أَن أُكابِدَ إِثراءً وَإِحواجا",37,"ج",2,0],["كاساتُهُ المَلأى وَعَزفُ قِيانِهِ","لِلحادِثاتِ بَوارِقٌ وَرُعودُ",38,"د",1,0],["كاسٍ لَهُ حُلَلٌ وَعارٍ مَن لَهُ","لَو باتَ يَستُرُ شَخصَهُ بِجِدارِ",39,"ر",1,0],["كاسوا عُقولاً وَكاسَت إِبلُهُم كَرَماً","وَالغَدرُ في الناسِ لَم يُعرَف بِكَيسانِ",40,"ن",1,0],["كأسٌ تؤلّفُ بِالمَحَبَّةِ بَيْنَنا","طَوراً وتَنْزغُ أَيَّما نَزْغِ",41,"غ",1,0],["كأسُنا مترَعٌ وليلتُنا","غادةٌ من مضارِبِ العربِ",42,"ب",1,0],["كأسنا ضاحِكُ الحبَا","بِ مُصَفَّى من الكدَرْ",43,"ر",1,0],["كَأْسٌ رَأَيْتُ لَهَا نِظَاماً مُونِقاً","فَثَمِلْتُ قَبْلَ شُرَابِهَا بِالمَنْظَرِ",44,"ر",1,1],["كَأْسٌ هِيَ الْبَحْرُ بِالسُّرُورِ طَغَى","وَجَارِيَاتُ الأَسَى بِهِ قِدَدُ",45,"د",1,0],["كاسِياتِ طِمِرٍّ","كادَ يُلقي اللِجاما",46,"م",2,0],["كأسٌ تدور على ثغورِ ظماءِ","مُلئتْ بذوب الفضَّة البيضاءِ",47,"ا",2,1],["كاسراً جفنَه يخالِسُني اللحظَ","لأمرٍ في النفسِ يكسِرُ جَفْنا",48,"ن",2,0],["كأسَينِ ، كاساً لهم بالشُهد منزعةً","وللجماهير كأساً سَمُّها نَقَعا",49,"ع",2,0],["كاس لماك حلو","وعطره زكي",50,"ي",1,0],["كأسمه حسن الاخلاق جمله","برتبة الرفعة الوفرى تواضعه",51,"ع",2,0],["كاس المحبة مر","حلو وهذا عجيب",52,"ب",1,1],["كأس المنون منوع في هجره","وحياة عاشقه بسر وصاله",53,"ل",2,0],["كأساً زعمتم إنها","خمر فأذ هي كأس صاب",54,"ب",1,0],["كأس الممات على البرية شُربُه","حتمٌ ومنه ليس ينجو ممكن",55,"ن",1,0],["كأسٌ أدرَّت على لذاذتها","عُدّل فيها الزُّعافُ والعسلُ",56,"ل",1,0],["كاسٍ مِنَ الأَسقامِ جُرِّعَ لِلنَوى","كَأساً لَهُ ريقُ الحُبابِ حَبابُ",57,"ب",1,0],["كاسيةٍ من ملح التصابي","أَجفانُها َنشْوى بلا شرابِ",58,"ب",1,0],["كَأسنانِ مشطٍ كلُّهم في ضَلالهم","فَلا أَحدٌ يُبدي على أَحدٍ فَخرا",59,"ر",2,0],["كَأُستاذهِ في الدين حازَ مساوياً","إِذا مُزِجت بالبحرِ أفسدتِ البحرا",59,"ر",2,0],["كَأسنانِ مشطِ العربُ مثلُ الأعاجمِ","وَقَد جعلَ التَقوى أجلّ المكارمِ",60,"م",1,0],["كأس إذا أبصرت في اليوم محتشماً","قال السرورُ له قم غير مطرودِ",61,"د",1,0],["كأس الرحيق صدعته","وللربيع وهبتُه",62,"ه",1,0],["كَأسٌ كَأَنَّ مُدامَها مِن ريقِهِ","كَرماً وَيَلثُمُنا شَفيقُ خُدودِهِ",63,"د",2,0],["كاسِرٌ مُقلَتَيهِ وَاللَيلُ قَد أَد","بَرَ في فَلِ جَيشِهِ المَكسورِ",64,"ر",1,0],["كأس المحبّهْ بمسك الأنس لي مختوم","قد ساقه بالرضا ساقي القضا المحتوم",65,"م",1,1],["كأس الهنا بسلاف الأنس قد طفحتْ","فاشرب وعربد وخلّ النفس إن شطحتْ",66,"ت",1,1],["كأْسُكَ الأُولى تمشَّتْ","في عروقي وَعظامي",67,"ي",1,0],["كأْسٌ تدارُ عَلَى هوى الأحبابِ","شفة تعللُ راشفاً برضاب",68,"ب",1,1],["كأسود وله كف خواتمها","در تحمل مرآةً من الذهب",69,"ب",1,0],["كأسرار موسى حين ألقته أمه","رضيعاً بأمر اللَه في وسط لجة",70,"ه",1,0],["كَأسٌ تدارُ بصفوِ ودٍّ لم يَشُب","إلّا الدعاءُ أو الثناءُ مزاجه",71,"ج",2,0],["كأسودَ بارحٍ لم يعن إلّا","بأكلِ الشرشمانة والضبابِ",72,"ب",1,0],["كأسُك الشكر وهو شهدٌ مصفّى","مُزِجت لك فيه قطرة صابِ",73,"ب",1,0],["كأسٌ دِهاقٌ لآدابٍ صُبِحْتُ بها","من كَفّ موليَ ولكنْ طَرفيَ الحاسي",74,"ي",1,0],["كأسٌ من السّحْرِ الحلا","لِ لشُرْبِها بالقومِ سُكر",75,"ر",1,0],["كَأسٌ مِنَ البَغيِ لِلأَلبابِ ناهبَةٌ","كَذَلِكَ الكَأسُ لِلأَلبابِ تَنتَهِبُ",76,"ب",1,0],["كأسُ الهَوى والخَمرِ واحِدَةٌ","كلٌّ مُسَلَّطةٌ علَى العَقلِ",77,"ل",1,0],["كأساً إذا جُليت علينا في الدجى","لم يبق منه غيرُ صدعٍ أسودِ",78,"د",1,0],["كاسٍ من الشحناء عاراً مثلما","خلع الحيا عنه فكان العاري",79,"ر",2,0],["كَأسُ حماها سَقَتني","عن حُمَيّاها حُماها",80,"ا",3,0],["كأسلاف لكم كانا ملوكاً","لهم مجد يسامي كل سام",81,"م",1,0],["كاسٌ من الفِعل الجميلِ وإنّهُ","قمِنٌ به عارٍ من العوراءِ",82,"ا",2,0],["كاسون من حلل الثنا","عارون من عيب وشين",83,"ن",1,0],["كاس من الليل بالظلماء ملتحف","لكنما زانهُ التحجيل بالجبَبِ",84,"ب",1,0],["كاس من احلمد ثوباً ليس يخلفه","دهر ولكنّه عار من العار",85,"ر",1,0],["كأس به شرب الهزبر من الردى","تسقاه أَم القشعم الشعواء",86,"ا",2,0],["كأس المنية منها شارب ملك","وسوقة وأولو الاعدام والضعف",87,"ف",1,0],["كأس من الراح أم كأس من الأدب","دارت علينا فحيعلنا على الطرب",88,"ب",1,1],["كأسارى مخضوبة بدمائها","رقمت بجوهر لؤلؤ فتاتي",89,"ت",2,0],["كأسي ومحبوبي وروحي والهوى","لا غير ذا وعليلنا ملتاح",90,"ح",1,0],["كأس بها خمر ناحب القل","وب فماله في الكاس عني براح",90,"ح",1,0],["كأْسي صفَا دَهري وفي جِسمي عفَا","ففي الخَفَا أصبحْتُ معنًى للخَفَا",91,"ف",2,0],["كَأسُ الخطُوب بذا العدُوّ دِهاقُ","والدين قلبُه واجفٌ خَفّاق",92,"ق",1,1],["كَأسُ راحٍ إذا تَبَدَّت أَمامي","طالَ شَوقي لها وطالَ حَنينِي",93,"ن",2,0],["كأسٌ فِلسطيَّةٌ مُعَتَّقَةٌ","شيبَتَ بِماءٍ مِن مُزنَةِ السبلِ",94,"ل",1,0],["كأساً بفيها صَهباءَ مُعرِقَةً","يَغلو بِأَيدي التِجار مَسبَؤُها",95,"ا",3,0],["كاساً من الحجر الرخام مدوَّراً","في بركةٍ جمعت بفكرٍ شاردِ",96,"د",1,0],["كاس حسن وكاس عشق وإني","بهما الآن لم أزل سكرانا",97,"ن",2,0],["كأس صفت بيد المدير فأسكرت","ألباب أهل الله منه الراح",98,"ح",1,0],["كأسٌ على الغِلمانِ يَعرِضُ تارةً","قبلَ الشُّيوخِ لُسوءِ رأيِ سُقاتِهِ",99,"ت",2,0],["كأسٌ إذا فاتَ النديمَ مُقدَّماً","ذَكَرَ العُهودَ فلم يَفُتْهُ مُؤَخرّا",100,"ر",2,0],["كأسُ مُدَامٍ جَلاَ المُدِيْرُ بِهَا","أُمُّ اللَّيَالي وجَدَّةُ الأَبَدِ",101,"د",1,0],["كَأْساً تَرَى فِيْهَا مِثَالَكَ مِنْ يَدَيً","سَاقٍ تُرِيْكَ مِثَالَهَا مِنْ خَدِّهِ",102,"د",2,0]]}