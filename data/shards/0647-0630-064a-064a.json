{"poems":[[88,"لمصر أم لربوع الشام تنتسب","https://www.aldiwan.net/poem10918.html","البسيط"],[74,"تحلو الثغور بذكرك المتردد","https://www.aldiwan.net/poem18546.html","الكامل"],[91,"ما شاهدت عيني ممث","https://www.aldiwan.net/poem44910.html","مجزوء الكامل"],[68,"إني ليطربني العذول فأنثني","https://www.aldiwan.net/poem41355.html","الكامل"],[89,"خلعت في حب غزلان الحمى رسني","https://www.aldiwan.net/poem8236.html","البسيط"],[42,"رد الخليط الجمال فانتقلا","https://www.aldiwan.net/poem42312.html","المنسرح"],[42,"حور بعثن رسولا في ملاطفة","https://www.aldiwan.net/poem42344.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39627","السريع"],[159,"تظلم الورد من خديه إذ ظلما","https://www.aldiwan.net/poem55561.html","البسيط"],[303,"حطمت أغلال يدي","https://www.aldiwan.net/poem36294.html","عموديه"],[447,"الحمد لله القريب النائي","https://www.aldiwan.net/poem14286.html","الرجز"],[484,"غب التحية أنهي","https://www.aldiwan.net/poem36939.html","المجتث"],[484,"الذكر أبقى لكم والمال عارية","https://www.aldiwan.net/poem37207.html","البسيط"],[505,"لله أن يختار من أحبابه","https://www.aldiwan.net/poem38096.html","الكامل"],[563,"يا صاحبي في الرخا وفي الضيق","https://www.aldiwan.net/poem34307.html","المنسرح"],[568,"أحداج تلك الجمال","https://www.aldiwan.net/poem13601.html","المجتث"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126703","البسيط"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103126","الكامل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96969","الكامل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101508","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62502","البسيط"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80186","الكامل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[3153,"","https://poetry.dctabudhabi.ae/diwan/poem/126054","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216758","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73093","الكامل"],[4755,"بُح باسمِ أَيلُولَ، واقرَأ سِفرَ مَن سَطَرُوا","https://www.poetsgate.com/ViewPoem.aspx?id=191666",""],[4831,"ولادة حلم","https://www.poetsgate.com/ViewPoem.aspx?id=208009",""],[4913,"قمرٌ جنوبي","https://www.poetsgate.com/ViewPoem.aspx?id=203005",""],[5081,"أَهْوَاكِ","https://www.poetsgate.com/ViewPoem.aspx?id=185836",""],[5277,"وشمُ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=185674",""],[5419,"مدّي يديكِ","https://www.poetsgate.com/ViewPoem.aspx?id=32253",""],[5431,"لن تُعدما","https://www.poetsgate.com/ViewPoem.aspx?id=191220",""],[5442,"يامن إليه بعزه اتشفع","https://www.poetsgate.com/ViewPoem.aspx?id=114749",""],[5447,"نصر","https://www.poetsgate.com/ViewPoem.aspx?id=208351",""],[5644,"إني معك","https://www.poetsgate.com/ViewPoem.aspx?id=198655",""],[5725,"وتمنعي","https://www.poetsgate.com/ViewPoem.aspx?id=195411",""],[5829,"من باحة الأموي للزوراء","https://www.poetsgate.com/ViewPoem.aspx?id=150259",""],[5956,"يَدُ بنيَّ مربوطةٌ كعقولنا","https://www.poetsgate.com/ViewPoem.aspx?id=193399",""],[3155,"في حرم الوحي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72292&r=&rc=4",""]],"verses":[["هَذي يَدي عَن بَني مِصرٍ تُصافِحُكُم","فَصافِحوها تُصافِح نَفسَها العَرَبُ",0,"ب",1,0],["هذي يدي في الحب إنك قاتلي","طوع الغرام وإن حسنك لا يدي",1,"د",2,0],["هذي يدي عند الودا","عِ إلى مصافحة فقيره",2,"ر",2,0],["هَذي يَمينُكَ وَالوَغى وَمَضارِبِي","وَدَمُ الفَوارِسِ وَالظَما بِيَ فَساقَني",3,"ن",2,0],["هَذِي يَدِي جَسَّهَا الآسِي وَخَامَرَهُ","يَأْسٌ فَغَادَرَهَا صَرْعَى مِنَ الْوَهَنِ",4,"ن",1,0],["هَذي يَمِيني بِاللَهِ مُجتَهِداً","بِحَيثُ يُرضى الإِيمانَ مَن نَفَلا",5,"ل",2,0],["هَذي يَميني رَهيناً بِالوَفاءِ لَكُم","فَارضى بِها وَلا نفِ الكاشِح الرَغَمُ",6,"م",1,0],["هذي يدي مُدِّي إليها يَدا","نقتحم النوءَ ونطوِ العبابْ",7,"ب",1,0],["هذِي يَمِينُكَ في الآجالِ صائِلَةٌ","فَاقْتُلْ بِسَيْفِ رَدَاها الخَوْفَ وَالعَدَمَا",8,"م",2,0],["هذي يدي للعَربِ","في الشرقِ أَو في المغربِ",9,"ب",1,0],["هذي يدي باسطة وعائي","أن تهدني مناهج الإهداء",10,"ا",2,0],["هذي يدي لا تمد","إلا لمن فيه ود",11,"د",1,0],["هذي يدي فليمد المسلمون يدا","نشري رضاك بها يا جد كل تقي",12,"ق",2,0],["هذي يمينُ اللهِ في الحَرَمِ انْجَلَتْ","ولدى البَعيدُ حِجارَةٌ صَمَّاءُ",13,"ا",2,0],["هذي يدي قد مددتها لك خذ","عهدي سريعاً بغير تعويق",14,"ق",1,0],["هَذي يَدُ اِبنِ هِلالٍ","وَذا فَمُ اِبنِ هِلالِ",15,"ل",1,0],["هذي يدي يا بني مصر تُصافِحكم","فَصافِحوها تصافِح نفسها العربُ",16,"ب",1,0],["هذي يدي أسلمت طوعا للهوى","وله عليّ متى سلمت له اليد",17,"د",1,0],["هذي يتاماً كم تلوذ ببعضها","ولكم نساء تلتجي لنساء",18,"ا",2,0],["هذي يدي وملوكُ الارض ترمقها","بأعين الشوق عجزاً لا تُدانيها",19,"ي",3,0],["هذي يتيمة عِقدٍ من مدائحِكم","من خادم برياض الودّ قد غرسا",20,"س",2,0],["هَذي يَدي فتقي بِعَهدي دايِماً","قسماً بِلُطفِكَ ما أَنا خوانُ",21,"ن",1,0],["هذي يدي هذا فؤَادي ها انا","نبدي الخضوع لحسنكِ الغلاَّبِ",22,"ب",1,0],["هذي يمينك في قرباك صائلة","وصارم من سيوف الهند مشهور",23,"ر",1,1],["هذي يميني في يمينك فاعتصمْ","أو لا فأرسلها فما لك منجد",24,"د",1,0],["هَذي يَدي إِنَّ الكَواكبَ لا تَدي","أفَتهتدي إِن كنتَ ممَّن يهتَدي",25,"د",2,1],["هذي يَدِي لم تُصافِح مُذ جُرِحتَ يَدًا","أو زارَها -غَيرَ مُبكٍ- مَرَّةً خَبَرُ",26,"ر",1,0],["هذي يَدِي ولْتَخْسِفِ الدُّنْيا بِنا","لا تخْجَلي في الحبِّ ما قدْ يَعْذرُ",27,"ر",1,0],["هذي ينابيعُ القصائدِ فأنحلوا","من طينها (اللّگشيّ) كالحنّاءِ",28,"ا",2,0],["هَذِى يَدِى مَقْطُوعَةٌ مدَّيْتُهَا","أَرْجُو وِصَالَاً أَيْنَ أَيْنَ يَدَاكِ ؟!",29,"ك",1,0],["هذي يدي مُدَّتْ إليكِ لعلَّنا","نتجاذبُ السلوى.. وليس بكافِ",30,"ف",1,0],["هذي يدي مدّت إليك بحبها","مدّي يديكِ وسافري في مقلتيْ",31,"ي",1,0],["هذي يدي..هذي أنا","والقلب بات ملغما",32,"م",2,0],["هذي يدي تدعوك في غسق الدجى","والخلق إلا من ببابك هجع",33,"ع",1,0],["هذي يدايَ وقلبي، كلُّ أوردتي","عيني وصوتي، نَجَتْ، حبري وأقلامي",34,"م",2,0],["هذي يدي أمسك بها","جاءت لتمحو أدمعَكْ",35,"ك",1,0],["هذي يدي عطشانة واناملي","جدبى فروّيها بلمسة مفصلِ",36,"ل",1,0],["هذي يدٌ رجلٌ ذؤابةُ مفرق","لم يكتملْ عضو من الأعضاء",37,"ا",2,0],["هذي يدٌ بنّاءة مطْلولةٌ","وتحيلُ كلَّ عُنُوسة إنجابا",38,"ب",2,0],["هذي يدٌ رحَّالةٌ بحَّاثة","عن كل قفر كي تحيلَه غابا",38,"ب",2,0],["هذي يدٌ تحدو قوى أجيالِنا","للتضحياتِ وتهزم الإرهابا",38,"ب",2,0],["هذي يدٌ مربوطةٌ كعقولنا","ما غادرتْ مثلي أنا السِّردابا",38,"ب",2,0],["هذي يدٌ مربوطة كجُسومنا","لم تستطعْ جِداً تقيم وِثابا",38,"ب",2,0],["هذي يدي .. تتحسس","السر العصي ، وتستبينُ !",39,"ن",1,0]]}