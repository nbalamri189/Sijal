{"poems":[[53,"قل لأبي سهل الذي ترك","https://www.aldiwan.net/poem65915.html","المنسرح"],[91,"البحر يغلى كان البحر بركان","https://www.aldiwan.net/poem44779.html","البسيط"],[87,"وسقيمة الأجفان لا من علة","https://www.aldiwan.net/poem7049.html","الكامل"],[46,"إلياس كن في ضمان الله والذمم","https://www.aldiwan.net/poem30346.html","البسيط"],[46,"قد شرد الصبح هذا الليل عن أفقه","https://www.aldiwan.net/poem30399.html","البسيط"],[107,"عام أهاب به الزمان فأقبلا","https://www.aldiwan.net/poem42112.html","الكامل"],[107,"أقبل نعيم هداك ربك ساريا","https://www.aldiwan.net/poem44192.html","الكامل"],[107,"اذهب حيي مذمما مشؤوما","https://www.aldiwan.net/poem44195.html","الكامل"],[48,"عيشي مؤد إلى الضراء والوهن","https://www.aldiwan.net/poem23512.html","البسيط"],[119,"منذ الذي يغريك يا ريم الغضا","https://www.aldiwan.net/poem40917.html","عموديه"],[280,"الله عن تلك المناقب دافع","https://www.aldiwan.net/poem25488.html","الكامل"],[309,"يا هل لجيراننا بالمربع الخضر","https://www.aldiwan.net/poem16839.html","البسيط"],[398,"يا وصل مالك لا تعاود","https://www.aldiwan.net/poem53658.html","مجزوء الكامل"],[435,"إن البشير الذي جاد الزمان به","https://www.aldiwan.net/poem41435.html","البسيط"],[443,"صبح الجبين وليل شعرك قد غدا","https://www.aldiwan.net/poem2499.html","الكامل"],[447,"هل لي إلى عصر الشباب","https://www.aldiwan.net/poem14350.html","مجزوء الكامل"],[468,"الرب باق والخلائق فانيه","https://www.aldiwan.net/poem925.html",""],[505,"حزب الغيوب أتانا","https://www.aldiwan.net/poem37698.html","الكامل"],[505,"تحت شراع الرفرف","https://www.aldiwan.net/poem37961.html","مجزوء الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59422","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59409","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56112","البسيط"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64586","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28031","البسيط"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87712","الكامل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102544","البسيط"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127024","البسيط"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70146","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73424","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58167","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58012","الكامل"],[4797,"إتصدق إني عارفك","https://www.poetsgate.com/ViewPoem.aspx?id=132235",""],[4797,"في شاعر المليون","https://www.poetsgate.com/ViewPoem.aspx?id=29427",""],[4802,"دلو بوحي","https://www.poetsgate.com/ViewPoem.aspx?id=32343",""],[5122,"يجض الخفوق","https://www.poetsgate.com/ViewPoem.aspx?id=18065",""],[5150,"ما كل ما يعلم يقال ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=202901",""],[5158,"للحلم للشعر وأشياء أخرى","https://www.poetsgate.com/ViewPoem.aspx?id=59128",""],[5186,"\"وبذاك يحلو قول \"\"يا سعد\"\"\"","https://www.poetsgate.com/ViewPoem.aspx?id=156452",""],[5198,"رسالة مع البدر","https://www.poetsgate.com/ViewPoem.aspx?id=135394",""],[5198,"مسرح الجرح","https://www.poetsgate.com/ViewPoem.aspx?id=135528",""],[5198,"وصالك","https://www.poetsgate.com/ViewPoem.aspx?id=176248",""],[5434,"بالسلك يندار","https://www.poetsgate.com/ViewPoem.aspx?id=37624",""],[5437,"عزاه يا وقتٍ تلاشوا به ارجال","https://www.poetsgate.com/ViewPoem.aspx?id=143695",""],[5455,"آخر الصيف","https://www.poetsgate.com/ViewPoem.aspx?id=213953",""],[5459,"مديح نبوي","https://www.poetsgate.com/ViewPoem.aspx?id=190900",""],[5461,"ياضايق الصدر","https://www.poetsgate.com/ViewPoem.aspx?id=6004",""],[5461,"الله عليها عودت","https://www.poetsgate.com/ViewPoem.aspx?id=26285",""],[5480,"النساء في موطني","https://www.poetsgate.com/ViewPoem.aspx?id=7607",""],[5525,"الليل والوعد","https://www.poetsgate.com/ViewPoem.aspx?id=7197",""],[5525,"هيهات","https://www.poetsgate.com/ViewPoem.aspx?id=7255",""],[5525,"على النوى","https://www.poetsgate.com/ViewPoem.aspx?id=954",""],[5652,"يوم الرفاقه لوحت لي على الكمْ","https://www.poetsgate.com/ViewPoem.aspx?id=190142",""],[5732,"سود الليالي","https://www.poetsgate.com/ViewPoem.aspx?id=177941",""],[4623,"ذكر الحبيب فأطلق العبرات ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146689",""],[5764,"حبيت أنبّه !","https://www.poetsgate.com/ViewPoem.aspx?id=159090",""],[5848,"حلم با الألوان","https://www.poetsgate.com/ViewPoem.aspx?id=53185",""],[5848,"ماغيرها داخل البحرين مملوحة","https://www.poetsgate.com/ViewPoem.aspx?id=48963",""],[5875,"عبق الخزامى","https://www.poetsgate.com/ViewPoem.aspx?id=37155",""],[5956,"كم أبتغي إضحاككم","https://www.poetsgate.com/ViewPoem.aspx?id=192423",""],[5956,"الله علّمنا الكثير لنهتدى","https://www.poetsgate.com/ViewPoem.aspx?id=192648",""],[5956,"أرجو اللجوء لأرضكم وحنوِّكم","https://www.poetsgate.com/ViewPoem.aspx?id=194126",""],[5956,"يا أبا ثابت أرجوك قل لسميةَ الحسناءا","https://www.poetsgate.com/ViewPoem.aspx?id=205164",""],[5973,"رودي-مرثية","https://www.poetsgate.com/ViewPoem.aspx?id=13241",""],[5976,"ذل السكوت","https://www.poetsgate.com/ViewPoem.aspx?id=33893",""],[6115,"للصمت سبع فوائد","https://www.poetsgate.com/ViewPoem.aspx?id=180497",""]],"verses":[["اللَّه عوْني على صنيعِك بي","فما أرى لي بحملهِ قِبَلا",0,"ل",2,0],["الله عون للبنان وقد ثكلت","مما تكابده في الثكل لبنان",1,"ن",1,0],["الله علمِنيه سمحا طاهرا","نزه الخلال وهكذا علمته",2,"ت",2,0],["اللَهُ عافاكَ مِنها عِلَّةً عَرَضاً","لَم تُنحِ أَظفارَها مِن سَقَمِ",3,"م",1,0],["اللَهُ عافاهُ مِن كَربٍ وَمِن وَصَبٍ","كادَ السَماحُ يَذوقُ المَوتَ مِن فَرَقِه",4,"ق",2,0],["الله علّمنا الحياةَ رشيدةً","وأبى علينا أن نَضِلَّ ونجهلا",5,"ل",2,0],["الله عَلَّمَهُ فليس كَفَنِّهِ","فَنٌّ وإن بَهَر العقولَ معانيا",6,"ي",2,0],["اللَّهُ علّمها مَناقِبَ دينهِ","فشفى الخبالَ وأحسن التعليما",7,"م",2,0],["اللَهُ عالِمُ غَيبٍ لا أُحاوِلُهُ","مِن ذي نُجومٍ وَلا أَبغيهِ في الكَهَنِ",8,"ن",1,0],["الله عدل والحقيقة لم تفا","رق وضعها فليقض زورا من قضى",9,"ض",2,0],["اللَّهُ عَنْ تِلكَ المَناقِبِ دَافِعُ","ولَها مِن المَحْذورِ واقٍ مانِعُ",10,"ع",1,1],["اللَه عظمه اللَه كرمه","اللَه قدمه في الورد والصدر",11,"ر",1,0],["أَلِلَّهُ عَونُكَ يا عَلِي","ي وَحَربُ خوّانٍ وَجاحِد",12,"د",1,0],["الله عظمه قدرا وجملّه","أرخ زوينه في حلية الشرف",13,"ف",1,0],["اللّه عظّمه وشيّد مجدهُ","وبنى له بيت الفخار وشيّدا",14,"د",2,0],["اللَه عفوك إنني","قد تبت من حنفي وحاب",15,"ب",1,0],["الله عزوجل يفعل مايشاء","منه القضايا نافذات ماضيه",16,"ي",2,0],["اللَهُ عَوَّدَنا الجَميل وَقَبلَ أَن","نَسَجَ الوُجُودَ بِغيبِه أَعلانا",17,"ن",2,0],["اللهُ عُظِّمَ اسمهُ","لمنْ يَشاءُ يَصْطَفي",18,"ف",2,0],["الله عظمه الله فضله","الله خصصه الله أعطاه",19,"ا",2,0],["الله عظمه من غيره فلذا","لم يدعه باسمه بل بالكنى عظما",20,"م",2,0],["الله عظّمه قدراً وجملّه","ارّخ وزيّنه في حلة الشرفِ",21,"ف",1,0],["اللّه علام الغيوب والكفيل","سبحانه عن الشبيه والبديل",22,"ل",1,0],["الله عاصمهم من كلِّ نازلةٍ","بما يجن من ألطاف وأعطافِ",23,"ف",1,0],["اللَه عَون المُبتَلى حيناً","وَلِكُل بَلوى في الوَرى حِين",24,"ن",1,0],["اللَه عوني على ديني ومالكنا","غوث الأنام الهمام الضيغم الضاري",25,"ر",2,0],["اللّه عظمه شأناً وفضله","فقام بالأمر يحمي أفضل الملل",26,"ل",1,0],["اللَهُ عدلٌ والعدولُ يؤيّدُ","وَالحقُ فيهِ للمعالي يُصعَدُ",27,"د",1,1],["اللهُ عوَّضكَ الجمي","لَ فقِس على ما قد سلَف",28,"ف",1,0],["اللهَ عفوَك يا مولايَ من فَرَطي","وما كسبتُ لدى الإسْرارِ والعَلَنِ",29,"ن",1,0],["اللهَ عَفْوَكَ إنني بك واثقٌ","لكَ هاربٌ من زَلَّتي وكُنُودي",30,"د",2,0],["اللهَ عفوَكَ من ذنوبي كلِّها","يا خيرَ مقصودٍ لكلِّ وفودِ",30,"د",1,0],["الله عطاني منك يازين وأعطاك","من دون لاأشوفك بعيني ولفتك",31,"ك",1,0],["الله عليها من مقاريد الأنظار ..",".. وصلت تحست ما غشاها زبدها",32,"د",3,0],["الله عطاني جناحيني عشان أشقا","أقرا فضاها وأنا أجهل سر أراضيها",33,"ي",3,0],["الله على اللي لا من ذكرته خفوقي جض","يجض الخفوق وفرحته فيه حافضها",34,"ض",3,1],["اللهُ عقلٌ باطنٌ مُتكشِّفٌ","مُتبصرٌ.. أهدى العقولَ بصيرَها",35,"ر",3,0],["الله عطاني .. واحمد اللي عطاني","وكل ٍ يحمد اللي من الجود . اعطاه",36,"ا",2,0],["الله عون العبد ناصره","ما دام في عون الأخ العبد",37,"د",1,0],["الله عليك الله مااحلى مساريك","الكون كلّه في دقايق تحوفه",38,"ف",2,0],["الله على كل طعنة ذقتها من يديك","ومع قو باسك لوتناظر لجرحي بري",39,"ر",2,0],["الله على سطوة بهاك ودلالك","وروضك وجوريّه وياسمينه",40,"ن",2,0],["الله على اللي عايروها بالامتار","طراز بنج شغلت بالعدالي",41,"ل",2,0],["الله على وقتٍ تزايد بغربال","وقتٍ صعيب وكله احلوم شينه",42,"ن",2,1],["الله عطاها من هنا لآخر الصيف","إن عوّدت للقلب .. والا نساها",43,"ا",3,0],["اللهُ عَظَّمَ في الكتابِ رَسولَهُ","وَهَدَى العبادَ بهِ إليهِ سَبيلا",44,"ل",2,0],["الله على مايفرج كربتك قادر","والله له الحكم في دبرة مخاليقه",45,"ق",2,0],["الله عليها عودت وانا احسب الغالي نسى","الله عليها لي بغت ما يطفي الشمس المسا",46,"س",2,1],["الله عطاهن مالحسن قلبن تجلى للعديل","حشمه تتوج ديرتي وراية فصم الشامخات",47,"ت",1,0],["الله عليم .. إني مليك وأنا حر","لأجل الهوى .. رضيت أنا بظلم سيدي",48,"د",2,1],["الله على بعض المحبين ما اشقاه","يرجي زهر روضٍ تولى ربيعه",49,"ع",2,0],["الله على اللي ما صفط لي غرابيل","لاشك شرع الحب همٍ وغربال",50,"ل",1,0],["الله على شاهي حمر كنه الدمْ","امخدرن يطرب عليل المزاجي",51,"ج",2,1],["الله على وقت مضى فات يا حسين","وعزى لمن بيض العذارى كونه",52,"ن",2,1],["الله عظم جاهه وأناله","قدرا عظيما زاد في العظمات",53,"ت",1,0],["الله عليه البال عيّا يذبه","ماكنه الا قلب مخلوق وياي",54,"ا",2,0],["الله عليها نومها شكل ثاني","الحلم لا نامت تشوفه بالالوان",55,"ن",1,0],["الله على الضحكة اللي من عذوبتها","ما غيرها داخل البحرين مملوحة !!",56,"ح",2,1],["الله على روضٍ خضر وقت الأشراق","وعبق الخزامى أنفاس عين النداوي",57,"ا",3,0],["الله عوّضني ببعض عباده","وأشاد لي مجداً كنهضة دولتكْ",58,"ك",1,0],["الله علّمنا الكثير لنهتدي","كالصد عن ظلمٍ وعن عدوانِ",59,"ن",1,0],["الله عاضدَكم بجيشِ محبةٍ","من كل صوبٍ يا أعزّ مجاهدِ",60,"د",1,0],["الله عرَّفني على أبويهما","حتى يكونوا لي هدى وهناءا",61,"ا",3,0],["الله عدل والله يرحمها","والله يهدي السلوان اهليها",62,"ي",3,0],["الله على وقت ٍ كشفنا غطاته","يشبه لبزغ النور في ليل الاعتام",63,"م",1,0],["الله عطاك لسان واعطى مسمعين","الله مقدّر حاجتك والله وهب",64,"ب",1,0]]}