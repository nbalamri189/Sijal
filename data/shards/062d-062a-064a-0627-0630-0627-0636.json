{"poems":[[95,"أمن الفساد طغيت نهر السين","https://www.aldiwan.net/poem11178.html","الكامل"],[74,"ليلاي كم ليلة بالشعر ليلاء","https://www.aldiwan.net/poem18172.html","البسيط"],[53,"زوج شيخ لنا عجوزا","https://www.aldiwan.net/poem62959.html","مخلع البسيط"],[63,"هي الصوارم والخطية الذبل","https://www.aldiwan.net/poem51493.html","البسيط"],[82,"ومديمة لمع البروق كأنما","https://www.aldiwan.net/poem31272.html","الكامل"],[46,"قف بالطلول الدارسات علاثا","https://www.aldiwan.net/poem30565.html","الكامل"],[77,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[78,"أزف الرحيل فودعتني مقلة","https://www.aldiwan.net/poem38981.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[106,"بيروت","https://www.poetsgate.com/ViewPoem.aspx?id=5126",""],[302,"ولقد طرقت الحي من سعد","https://www.aldiwan.net/poem33289.html","أحذ الكامل"],[376,"جعلت على الطرف السهور","https://www.aldiwan.net/poem57441.html","مجزوء الكامل"],[466,"زهي المباسل لانتضاء المقصل","https://www.aldiwan.net/poem15147.html","الكامل"],[520,"تقبل الله صوماً أنت واصله","https://www.aldiwan.net/poem12203.html","البسيط"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100150","الكامل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96029","البسيط"],[2449,"","https://poetry.dctabudhabi.ae/diwan/poem/115381","الكامل"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79719","الكامل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65178","البسيط"],[3296,"","https://poetry.dctabudhabi.ae/diwan/poem/105622","الرجز"],[3526,"","https://poetry.dctabudhabi.ae/diwan/poem/76586","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138551",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111507","الكامل"],[5156,"حلف الأمير بقطعه يده","https://www.poetsgate.com/ViewPoem.aspx?id=99176",""],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""],[5365,"خمرة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=191265",""],[5376,".قالوا الوغى قد فرَّها فرَّارُها......حلب","https://www.poetsgate.com/ViewPoem.aspx?id=188500",""],[5970,"تقود كل فتى في الدهر آمال","https://www.poetsgate.com/ViewPoem.aspx?id=130601",""],[6050,"الشّمسُ تُنسَجُ مِنْ فَم الشُّعراءِ","https://www.poetsgate.com/ViewPoem.aspx?id=103311",""]],"verses":[["حَتَّى إذَا ضَاقَ العَقِيقُ وَضَمَّهَا","سَدَّانِ مِنْ صَخْرٍ أَصَمَّ مَتِينِ",0,"ن",1,0],["حتى إذا ضاء شيب الرأس بتّ على","بقية من نواهي النفس بيضاء",1,"ا",2,0],["حتى إذا ضاجعتْه ليلاً","وصافحت زَوره بزور",2,"ر",1,0],["حتّى إذا ضَحِكَت تلك الرُّبا وطَمَت","تلك الوِهادُ وراقَت بينَها الحِلَلُ",3,"ل",1,0],["حتى إذا ضاقتْ بمضمر حملها","ألْقَتْ بحجرِ الأرضِ منه جنينا",4,"ن",2,0],["حَتّى إِذا ضَرَبَ الخَريفُ رِواقَهُ","سافَت بَريرَ أَراكَةٍ وَكَباثا",5,"ث",2,0],["حتى إذا ضاقَ ذَرْعُ القوْمِ وافترقوا","في الذلِّ فِرْقَينِ من بادٍ ومُمتثِل",6,"ل",1,0],["حتَّى إذا ضَربَ المصيفُ رُواقَهُ","صافَتْ بظلِّ أراكَةٍ وبشامِ",7,"م",1,0],["حتى إذا ضاقتْ عليهِ السُّبُلْ","وعزَّ في الأرض عليهِ المقامْ",8,"م",1,0],["حتى إذا ضحك الجلاد.. ما دمعت","عين ولا غص بالاهات مكروب",9,"ب",1,0],["حتّى إِذا ضاقَ العِناقُ بنا","ضمّاً يَذوبُ له حَصى العِقدِ",10,"د",1,0],["حتى إذا ضمَّرتهن","نَ حملتهنَّ على ضَميري",11,"ر",2,0],["حتى إذا ضاق المكَرُّ وقُسِّمتْ","مُهج الفوارس في الوشيج الذُبَّل",12,"ل",1,0],["حتى إذا ضاق بالأشهاد واستمعت","فصل الخطابة من قرب محافله",13,"ل",2,0],["حتى إذا ضاق الفضاء بعزمه","ألوى به للحشر غير مذمم",14,"م",1,0],["حتى اذا ضربت يمنى القضا وارى","احدى العجائب دهر شأنه العجب",15,"ب",1,0],["حتى إذا ضننت بدورتها","درت لضيفهم من النحر",16,"ر",1,0],["حتى إذا ضاقت بأنفاسي الحيا","ة وحشرجت أسلمتها للماء",17,"ا",2,0],["حتّى إذا ضاء منهُ الحقّ أنكرهُ","جهلا وهل يبصر الأضواء عميانُ",18,"ن",1,0],["حتى إذا ضاقت بها المذاهب","وصد عنها وجفاها الصاحب",19,"ب",1,0],["حَتّى إِذا ضَرَبَ الفِراقُ بِسَهمِهِ","وَغَدَت تَهادى تَحتَ أَرحُلِنا الإِبل",20,"ل",1,0],["حتى إذا ضربوا القباب وطرزت","بالسمر والبيض الرقاق خيامها",21,"م",3,0],["حتى إذا ضاق المجال انعطفا","كلا الأياسين لهم ووقفا",22,"ف",2,0],["حتى إذا ضاق المجال أتا","ه مخاطباً بالعنف يرمقه",23,"ه",1,0],["حتى إذا ضاق الفضاء به","جعل الفضاء تحلة القسم",24,"م",1,0],["حتى إذا ضرى به هادره","وخاف منه أرسل الدمع بكا",25,"ا",1,0],["حتّى إذا ضَعُفَ العبيرُ ببوحهِ","جمعَ النّسيمُ العطرَ من ذكراكِ",26,"ك",1,0],["حتى إذا ضحكتْ لهم دنْيا الفنا","ما أسعفتهمْ في الخباءِ جحارُها",27,"ر",3,0],["حتى إذا ضاع منه الجهد وانقطعت","أماله تلك جدت بعد آمال",28,"ل",1,0],["حتّى إذا ضاع السّبيلُ بفِكْرها","كلّ الكلاب ِتسابقوا لرداء ِ",29,"ا",2,0]]}