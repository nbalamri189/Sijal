{"poems":[[79,"فتحت سعودك كل باب مبهم","https://www.aldiwan.net/poem36122.html","الكامل"],[95,"سما مرامي وشطت","https://www.aldiwan.net/poem9151.html","المجتث"],[39,"حتى إذا طمعت أحناك ضارية","https://www.aldiwan.net/poem7326.html","البسيط"],[93,"يا أيها الشرق التعيس انظر إلى","https://www.aldiwan.net/poem62698.html","عموديه"],[91,"خطبت تؤبنك الدموع","https://www.aldiwan.net/poem44716.html","مجزوء الكامل"],[87,"سقط الحمار من السفينة في الدجى","https://www.aldiwan.net/poem8017.html","الكامل"],[87,"ضمي قناعك يا سعاد أو ارفعي","https://www.aldiwan.net/poem63709.html","الكامل"],[64,"جند من الأحزاب قد نزلوا على","https://www.aldiwan.net/poem52166.html","الكامل"],[99,"وطنٌ دعا وفتى أجاب","https://www.aldiwan.net/poem24756.html","مجزوء الكامل"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[54,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[54,"داو الهموم بقهوة صفراء","https://www.aldiwan.net/poem27329.html","الكامل"],[52,"ما رد سلوته إلى إطرابه","https://www.aldiwan.net/poem64822.html","الكامل"],[52,"لله سلمى حبها ناصب","https://www.aldiwan.net/poem64840.html","البسيط"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141981","الكامل"],[92,"يا بدرداجيَة الخطوب","https://www.poetsgate.com/ViewPoem.aspx?id=179157",""],[147,"ما كان قبلك في الزمان الخالي","https://www.aldiwan.net/poem11802.html","الكامل"],[240,"طرقت ودون طروقها","https://www.aldiwan.net/poem32143.html","مجزوء الكامل"],[275,"طربا أهجت لنا برقصك هذا","https://www.aldiwan.net/poem35267.html","الكامل"],[302,"وافاك نشوان المعاطف ناشي","https://www.aldiwan.net/poem33234.html","الكامل"],[303,"لا تنكري جزعي وفرط تفجعي","https://www.aldiwan.net/poem36256.html","عموديه"],[342,"صدع الظعائن قلبه المشتاقا","https://www.aldiwan.net/poem45423.html","الكامل"],[351,"بجمع جفنيك من البرء والسقم","https://www.aldiwan.net/poem24114.html","البسيط"],[376,"أفردتني وأرى العشاق أقرانا","https://www.aldiwan.net/poem57010.html","البسيط"],[447,"هذي ديارهم وذي أطلالها","https://www.aldiwan.net/poem14393.html","الكامل"],[505,"هب النسيم فسار بالأسرار","https://www.aldiwan.net/poem38018.html","الكامل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66654","الكامل"],[718,"","https://poetry.dctabudhabi.ae/diwan/poem/124029","البسيط"],[880,"","https://poetry.dctabudhabi.ae/diwan/poem/34785","الكامل"],[1090,"","https://poetry.dctabudhabi.ae/diwan/poem/96463","الكامل"],[1664,"","https://poetry.dctabudhabi.ae/diwan/poem/123779","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100988","الكامل"],[1753,"","https://poetry.dctabudhabi.ae/diwan/poem/105873","الكامل"],[2124,"","https://poetry.dctabudhabi.ae/diwan/poem/45450","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53161","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53172","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53108","الكامل"],[2216,"","https://poetry.dctabudhabi.ae/diwan/poem/100480","البسيط"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28560","الكامل"],[2575,"","https://poetry.dctabudhabi.ae/diwan/poem/142554","السريع"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93928","الكامل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109799","الكامل"],[3296,"","https://poetry.dctabudhabi.ae/diwan/poem/105622","الرجز"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62817","المنسرح"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102385","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138703",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108338",""],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3708,"","https://poetry.dctabudhabi.ae/diwan/poem/123840","البسيط"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76504","الكامل"],[4927,"سَهَرُ الْعَاْشِق","https://www.poetsgate.com/ViewPoem.aspx?id=29636",""],[4119,"عن خاطري نبأ الخيال الخاطر","https://www.poetsgate.com/ViewPoem.aspx?id=16155",""],[5397,"هلا سألت مرابعا وطلولا","https://www.poetsgate.com/ViewPoem.aspx?id=157941",""],[5858,"سأعود","https://www.poetsgate.com/ViewPoem.aspx?id=188173",""],[6225,"سبيل البقاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81742&r=&rc=453",""],[6233,"متى قررتِ اغتيالي!؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82692&r=&rc=35",""]],"verses":[["حَتَّى إِذَا طَلَعَتْ وُجُوهُ سُعُودِهَا","بِيضاً عَلَى ذَاكَ السَّوادِ الأَعْظَمِ",0,"م",1,0],["حتى إذا طال كدي","ولم أفز بالطلابه",1,"ب",2,0],["حتى إذا طمعت أحناك ضارية","هن المساريف يوم الغنم والنَجلُ",2,"ل",1,1],["حَتّى إِذا طَرَّت شَوارِبُهُم وَباتَ","مِنَ الشَبابِ لَهُم طِرازٌ مُعلَمُ",3,"م",1,0],["حتى اذا طلع الصبا","ح وقام ابيضه يشيع",4,"ع",1,0],["حَتّى إِذا طَلَعَ النَهارُ أَتَت بِهِ","نَحوَ السَفينَةِ مَوجَةٌ تَتَقَدَمُ",5,"م",1,0],["حَتّى إِذا طُوِيَت وَرِثتِ خِلالَها","رُفِعَ الرَحيقُ وَسِرُّهُ لَم يُرفَعِ",6,"ع",1,0],["حتى إذا طال الحصار عليهمُ","واشتد منه الخوف والإشفاقُ",7,"ق",1,0],["حتى إذا طغت الكوا","رث واستفزكم العذاب",8,"ب",1,0],["حَتّى إِذا طاحَ مِنهُ التُّرسُ تاحَ لَهُ","بابٌ فَكانَ لَهُ تُرساً إِلى العَتَمِ",9,"م",1,0],["حَتّى إِذا طالَ عَلَيهِ الجَهدُ","وَلَم يَكُن مِمّا أَرادَ بُدُّ",10,"د",1,0],["حَتّى إِذا طَلَعَ الصَباحُ تَفَرَّقا","بِتَنَفُّسٍ وَتَأَسُّفٍ وَبُكاءِ",11,"ا",2,0],["حَتّى إِذا طَلَعَ الزَمانُ بِعيشَةٍ","فيها وَسالَ عَلَيهِ بَعضُ شِعابِهِ",12,"ب",2,0],["حَتّى إِذا طالَ تَناصيهِما","وَاِنهَزَمَ الجودُ لَهُ ثائِبُ",13,"ب",1,0],["حتى إذا طلع الرشي","د وماج في الأفق الرحيب",14,"ب",1,0],["حتى إذا طارَتْ بأجنحة الهنَا","والبشرِ نفسُ مُغرَّرٍ مخدوع",15,"ع",1,0],["حَتّى إِذا طارَت بِهِم مُقوَّرَةً","شَرُفَ الوَجيهُ بِها وَذو العُقّالِ",16,"ل",1,0],["حَتّى إِذا طُوِيَت مُلا","ءَتُها كَما يُطوى الكِتابُ",17,"ب",1,0],["حتى إذا طَفَحَ الهوى وتفجَّرَت","لذَّاتُهُ بكِ منكِ قلبي عاذا",18,"ذ",2,0],["حتّى إِذا طابَ اللِقاءُ وَسكَّنت","أَنفاسُهُ نَفسي وَروعةَ جاشي",19,"ش",2,0],["حتى إذا طرق النعيُّ تحشرجتْ","نفسي بصدرٍ بالأَسى متقنع",20,"ع",1,0],["حَتّى إِذا طالَ الوُقوفُ بِدِمنَةٍ","خَرساءَ حَلَّ بِها الرَبيعُ نِطاقا",21,"ق",2,0],["حَتّى إِذا طاحَ عَنها المِرطُ مِن دَهَشٍ","وَاِنحَلَّ في النَظمِ عَقدُ السِلكِ في الظُلَمِ",22,"م",1,0],["حتَّى إِذا طالَ تَردادي ألِفتُهما","وكلُّ شيءٍ إذا هَوَّنتَه هانا",23,"ن",2,0],["حتى إذا طفنا وتم طوافنا","وفروضنا تمت وتم نفالها",24,"ل",3,0],["حتَّى إذا طَلَعَ النَّهارُ طَوى لهُ","كَشْحاً وليسَ نَهارُهُ بِنَهارِ",25,"ر",1,0],["حتى إذا طلع الشميطُ كأنّه","في اللّيلِ صفحةُ خدِّ أدهمِ مُغْرِبِ",26,"ب",1,0],["حتى إذا طلع الشرى كأن على","جنح الدجى منه نيرانا على قنَنِ",27,"ن",1,0],["حتى إذا طفل العشي ووجهت","شمس النهار وآذنت بغئور",28,"ر",1,0],["حَتَّى إِذَا طَمَسَ النُّجومَ وغَمَّهَا","وَردٌ يُغَيِّبُ لَونَهَا مُتَجَوِّبُ",29,"ب",1,0],["حتى إذا طلبوا الوصالَ وعُذِّبوا","بالطَردِ عنك وساء بُعدُ الدارِ",30,"ر",1,0],["حتى إذا طمع العدو ورابه","سكتات ليثهما عن التزآر",31,"ر",1,0],["حتّى إذا طَرَقَ الظَلامَ سَخابِهِ","إذ لا يَرى إِلا القَليلَ سؤولا",32,"ل",2,0],["حَتّى إِذا طَوَيا وَاللَيلُ مُعتَكِرٌ","مِن ذي أُكَيهفُ جِزعَ البانِ وَالأَثَبِ",33,"ب",1,0],["حتى إذا طال التثامهم الثرى","ودّوا مع التقبيل أنك قابل",34,"ل",1,0],["حتى إذا طالبته بدمي","وَرَّى بما في الخدِّ من خجل",35,"ل",1,0],["حتى إذا طال السُّرى وقفوا","فوضى وفي آمالهم قُصُر",36,"ر",1,0],["حتى إذا طلع الفجر المينر لكم","وبان للشمس نور يخطف البصرا",37,"ر",2,0],["حَتّى إِذا طالعت ثَغرَةَ كَيدِهِ","وَهَفا عَلَيهِ لِواؤكَ الخَفّاقُ",38,"ق",1,0],["حتى إذا طارحتني نظرةً","حالمةً من طرفك الأكحل",39,"ل",1,0],["حتى إذا طابت وكاد دبيبها","يسطو على الأشراف قلت له قفا",40,"ف",2,0],["حتى اذا طفح الغرام ولم تعد","كلم العيون تفي بوجداناتها",41,"ت",3,0],["حتى إذا طار غراب الليل عن","أفراخه طهرت للفرض البدن",42,"ن",1,0],["حتى إذا طاشَ من كنانَتِه","أفْوَقُ يومَ النضالِ خَوّارُ",43,"ر",1,0],["حتى إذا طرحَتْ نَسيلاً جافلاً","عنها وقدْ جزأَتْ ثلاثةَ أشهرِ",44,"ر",1,0],["حتى إذا طرقته طارقة الردى","والموت لاحت منه بعض علائم",45,"م",1,0],["حتى اذا طلب الغرام حقوقه","لبي له المطلوب منه بالوفا",46,"ا",1,0],["حَتّى إِذا طَهرو هُنالِكَ أُدخِلوا","جَنّاتِ عَدنٍ وَهي خَيرُ جِنانِ",47,"ن",1,0],["حتى إذا طحنتهم تحت كلكلها","شهباء منها يطيش الإنس والجان",48,"ن",1,0],["حَتّى إِذا طل الصَباح وَبانَ في ارجائه","من كان يقطنه رايت النار في أَحشائه",49,"ه",1,0],["حَتَّىْ إِذَاْ طَلَعَ الصَّبَاْحُº وَأَسْفَرَتْ","عَنْ وَجْهِهَاْ مِحَنٌº سَقَتْكَ الْعَلْقَمَاْ",50,"م",2,0],["حتى إذا طلبته عيني فاتها","والطيف ألطف من شعاع الباصر",51,"ر",1,0],["حتى إذا طرق الفناء فناءى","وتوطن المقدار فيه حلولا",52,"ل",2,0],["حتى إذا طلع الصباح تثاقلت","فهممت ان اذهب لها واجود",53,"د",1,0],["حتى إذا طلعت شمسُ النهار من ال","غرب .. القيامة ُ قامتْ وانتهى السفرُ",54,"ر",1,0],["حتى إذا طَعَنتْ أشواقه رئتي","أهديتُه وطناً في خاطري.. فأبى",55,"ب",2,0]]}