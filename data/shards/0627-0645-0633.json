te.com/ViewPoem.aspx?id=29914",""],[51,"عينَّي هذا ربيع الدَّمع فاحتشدا","https://www.poetsgate.com/ViewPoem.aspx?id=29168",""],[31,"هل تَعرِفُ اليومَ رسمَ الدارِ والطّلَلا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19023&r=&rc=286",""],[88,"إذا انقضى مارْتُ فاكسر خلفه الكوزا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19529&r=&rc=32",""],[7,"يا دارَ مَيّة َ بالعَليْاءِ، فالسَّنَدِ، ( معلقة )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13895&r=&rc=13",""],[18,"كُلَيْبُ لاَ خَيْرَ في الدُّنْيَا وَمَنْ فِيهَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26474&r=&rc=40",""]],"verses":[["أُمسي لَها مُتَفَقِّداً","في العائِدينَ وَلا أَراها",0,"ا",3,0],["أَمسَيتُ أَرحَمُ مَن أَصبَحتُ أَغبِطُهُ","لَقَد تَقارَبَ بَينَ العِزِّ وَالهَونِ",1,"ن",1,0],["أُمَسِّحُ عِرنَينِ الظَلامِ بِعَرعَرٍ","وَمِن دونِهِ خَدٌّ مِنَ اللَيلِ ساهِمُ",2,"م",1,0],["أَمسَت تَمَنَّعُ بِالسِقابِ وَطالَما","جُعِلَ الظُبى لِرِضاعِهِنَّ فِصالا",3,"ل",2,0],["أَمسَيتَ ثالِثَ ناظِرَي","يَ فَكَيفَ أَقذي ناظِرَيكا",4,"ك",2,0],["أَمسى يُقَوِّضُ عَنّا العِزَّ خَلَّفَهُ","وَثَوَّرَ المَجدَ عَنّا بَعدَما بَرَكا",5,"ك",2,0],["أَمسى بِها عاطِلاً مِن بَعدِ حِليَتِهِ","وَهادِماً مِن بِناءِ المَجدِ ما سَمَكا",5,"ك",2,0],["أَمسَت ظُهورُ المَجدِ عِندِكَ تَرتَقي","مِنها إِلى قَمَعِ السَنامِ الأَمنَعِ",6,"ع",1,0],["أَمسى أَخٌ لَكَ لَم يُجارِكَ في الصِبا","طَلَقاً وَلا ساقاكَ دَرَّ المُرضِعِ",6,"ع",1,0],["أُمسي كَأَنَّ مِنَ القَنا","بِأَضالِعي قَرعاً وَوَخزا",7,"ز",2,0],["أَمسى الهَوى فيهِ بِلا أَثَرٍ","وَجَرى البِلى فيهِ بِلا أَمَدِ",8,"د",1,0],["أَمسى عَلَيَّ مَعَ الزَمانِ أَخٌ","قَد كُنتُ آمُلُ يَومَهُ لِغَدِ",8,"د",1,0],["أَمسوا كَأَنَّ لَطائِماً دارِيَّةً","باتَت تَضوعُ مِنَ القِبابِ وَتَنفَحُ",9,"ح",1,0],["أُمسي عَلى وَجَلٍ خَوفَ الفِراقِ كَم","تُمسي الأَعادِيُّ مِن سَيفي عَلى وَجَلِ",10,"ل",1,0],["أَمسَيتُ في رَبعٍ خَصيبٍ عِندَهُ","مُتَنَزِّهاً فيهِ وَفي بُستانِهِ",11,"ن",2,0],["أُمسي بِغَيرِ بِلادِها","ما إِن أُريدُ بِها سِواها",12,"ا",3,0],["أَمسى الفُؤادُ بِهَذا المِصرِ مُرتَهَنا","فَما أُريدُ لِنَفسي غَيرَهُ وَطَنا",13,"ن",2,1],["أَمسى بُكاكَ عَلى هَواكَ دَليلا","فَاِمنَع دُموعَكَ أَن تَفيضَ هُمولا",14,"ل",2,1],["أَمسى لِأَهلِكِ جاراً ما عَلِمتِ بِهِ","لَو تَطلُبينَ إِلَيهِ النَفسَ أَعطاكِ",15,"ك",1,0],["أَمسى يُكَلِّفُني خَوداً مُمَنَّعَةً","مِنّي وَمِن دونِها حُجبٌ وَأَستارُ",16,"ر",1,0],["أَمسى فُؤادي عِندَكُم وَمَحَلُّهُ","عِندي فَأَينَ فُؤادِيَ المَفقودُ",17,"د",1,0],["أَمسَت تَذودُ النَومَ عَن مُقلَتي","ظُلماً وَقَد طابَ لَها المَرقَدُ",18,"د",1,0],["أَمسَت بِيَثرِبَ لا يَأتي لَها خَبَرٌ","وَلا إِذا حَجَّ بَعضُ الناسِ مِن بَلَدي",19,"ي",1,0],["أَمسَت بِيَثرِبَ نَفسي عِندَ جارِيَةٍ","حَوراءَ تُنمى إِلى الغُرِّ المَساميحِ",20,"ح",1,0],["أُمسي وَأُضحي هائِماً","مِن حُبِّكُم في نَصَبِ",21,"ب",1,0],["أَمَسُّ تُرابَ أَرضِكِ يا لُبَينى","وَلَولا أَنتِ لَم أَمسَس تُرابا",22,"ب",2,1],["أَمُستَعبِراً يَبكي مِنَ الشَوقِ وَالهَوى","أَما خَرَ يَبكي شَجوَهُ وَيَهيمُ",23,"م",1,0],["أمُسْتَخْرِجاً كَنْزَ العَقيقِ بآماقِي","أُناشِدُكَ الرّحْانَ في الرّمَقِ الباقِي",24,"ق",2,1],["أمَسْعودُ بنُ يوسُفَ طيْرُ قَلْبي","علَى شجَرِ الكِرامِ لهُ وُقوعُ",25,"ع",1,1],["أمْسَتْ تَحُضُّ على اللِّياذِ بمَنْ جَرَتْ","بسُعودِهِ الأقْلامُ في الألْواحِ",26,"ح",1,0],["أَمْسَكْتِ يُوسُفَ عَنِّي فِعْلَ ظَالِمَةٍ","فَهَلْ لِيَ الْيَوْمَ إلاَّ حُزْنُ يَعْقُوبِ",27,"ب",1,0],["أَمسى الثَعالِبُ أَهلَهُ","بَعدَ الَّذينَ هُمُ مَآبُه",28,"ب",2,0],["أَمسى بِذي العَجلانِ يَقرو رَوضَةً","خَضراءَ أَنضَرَ نَبتُها فَتَرَأَّدا",29,"د",2,0],["أَمسَت سُعادُ بِأَرضٍ لا يُبَلِّغُها","إِلّا العِتاقُ النَجيباتُ المَراسيلُ",30,"ل",1,0],["أَمسى وَأَضحى وَعَينُ اللَهِ تَحرُسُهُ","حَتّى نَما وَحَلاهُ المَجدُ وَالشَمَمُ",31,"م",1,0],["أَمسَت تُنافِسُ فيكَ الشُهبَ مِن شَرَفٍ","أَرضٌ تَوارَيتَ فيها يا فَتى الجودِ",32,"د",1,0],["أَمسى كَماءِ النَهرِ ضاعَ فُراتُهُ","في البَحرِ بَينَ أُجاجِهِ المُنداحِ",33,"ح",1,0],["أَمسى يُبالي حارِساً مِن جُندِهِ","وَلَقَد يَكونُ وَما يُبالي الفَيلَقا",34,"ق",2,0],["أَمسى كُروبَتكينَ في غَمرَةٍ","وَباتَ أوياما لَهُ يَنظُرُ",35,"ر",1,0],["أَم سَليلُ البُخارِ طارَ إِلى القَص","دِ فَأَعيا سَوابِقَ الأَوهامِ",36,"م",1,0],["أَمسَت بِمَدرَجَةِ الخُطوبِ فَما لَها","راعٍ هُناكَ وَما لَها مِن والي",37,"ل",2,0],["أَمسى اِحتَواكَ الزَمهَري","رُ وَظَلَّ يَصهَرُني الجَحيمُ",38,"م",1,0],["أَمسَت سِياسَتُهُم كَطِل","لَسمٍ يُحَيِّرُ كُلَّ قاري",39,"ي",1,0],["أَمسى كِتابُكَ كَالسيما يُعيدُ لَهُم","مَرأى الحَوادِثِ مَرَّت مُنذُ أَزمانِ",40,"ن",1,0],["أَمسى يُمالِئُهُ وَيَنصُرُ غَيَّهُ","وَضَلالَهُ بِحُثالَةِ العُربانِ",41,"ن",1,0],["أمسيت في عدنٍ وخلفت الأسى","في الأرض ملء جوانحٍ وضمائر",42,"ر",1,0],["أَمْسَى رَهِينَ قَرَارَةٍ مَقْرُورَةٍ","وَبَنُوهُ فِي حَرَبٍ وَفِي حِرمَانِ",43,"ن",1,0],["أمْسَتْ ضَريحاً وَأمْسَى","فِيهَا الْعَفَافُ دَفِينَا",44,"ن",2,0],["أَمُستَوجِبٌ أَجرَ الصَبورِ فَكاظِمٌ","عَلى الوَجدِ أَم مُبدي الضَميرِ فَجازِعُ",45,"ع",1,0],["أَمسى بِوَهبينَ مُجتازاً لِمَرتَعِهِ","مِن ذي الفَوارِسِ تَدعو أَنفَهُ الرِبَبُ",46,"ب",1,0],["أمسى به ليلُ الحوادث داجياً","والصبحُ أصبح كاسفَ الإشراقِ",47,"ق",1,0],["أمسى بها الإِسلامُ يشرقُ نورُهُ","والكفرُ أصبحَ فاحمَ الأرجاءِ",48,"ا",2,0],["أمسى التعاضد كالحصن الحصين لهم","إذا تصادم بالأهوال أهوال",49,"ل",1,0],["أمسى غرامك يجري في عروق دمي","كالكهرباء التي تجري بأسلاك",50,"ك",1,0],["أم سكِرتم لما غلبتم بحرب","لم تكن في انبعاثها بنضيجه",51,"ج",2,0],["أمست تكابد من فقر ألَمّ بها","آلام عيش بشيع الطعم مذروح",52,"ح",1,0],["أمست تُناديه وتَندبُ أربُعاً","طَمَست رسوم جمالها الهَبَوات",53,"ت",1,0],["أمست لروعته الأبصار شاخصةً","أما القلوب فقد أجفلن إجفالا",54,"ل",2,0],["أَمسَت طُهَيَّةُ كَالمَجنونِ في قَرَنٍ","وَكانَ يَمشي بَطيئاً غَيرَ مَقرونِ",55,"ن",1,0],["أَمسى فُؤادُكَ عِندَ الحَيِّ مَرهونا","وَأَصبَحوا مِن قَريِّ الخَيلِ غادينا",56,"ن",2,1],["أَمسَيتَ إِذ رَحَلَ الشَبابُ حَزينا","لَيتَ اللَيالِيَ قَبلَ ذاكَ فَنينا",57,"ن",2,1],["أَمسَينَ إِذ بانَ الشَبابُ صَوادِفاً","لَيتَ اللَيالِيَ قَبلَ ذاكَ فَنينا",57,"ن",2,0],["أَمسى سَراةُ بَني الدَيّانِ ناصِيَةً","وَاللُؤمُ يَأوي إِلَيكُم يا بَني قَطَنِ",58,"ن",1,0],["أَمسَت قُوىً مِن حِبالِ الوَصلِ قَد بَلِيَت","يا رُبَّما قَد نَراها حِقبَةً جُدُدا",59,"د",2,0],["أَمسى الفَرَزدَقُ يا نَوارُ كَأَنَّهُ","قِردٌ يَحُثُّ عَلى الزِناءِ قُرودا",60,"د",2,0],["أَمسى فُؤادُكَ ذا شُجونٍ مُقصَدا","لَو أَنَّ قَلبَكَ يَستَطيعُ تَجَلُّدا",61,"د",2,1],["أَمسَت زِيارَتُنا عَلَيكَ بَعيدَةً","فَسَقى بِلادَكِ ديمَةٌ مِدرارُ",62,"ر",1,0],["أَمسى بَنوها وَقَد جَلَّت مُصيبَتُهُم","مِثلَ النُجومِ هَوى مِن بَينِها القَمَرُ",63,"ر",1,0],["أَمسى سُراقَةَ قَد عَوى لِشَقائِهِ","خَطبٌ وَأُمِّكَ يا سُراقَ يَسيرُ",64,"ر",1,0],["أَمسى خَليطُكَ قَد أَجَدَّ فِراقا","هاجَ الحَزينَ وَذَكَّرَ الأَشواقا",65,"ق",2,1],["أَمسَت طُهَيَّةُ كَالبِكارِ أَفَزَّها","بَعدَ الكَشيشِ هَديرُ قَرمٍ بازِلِ",66,"ل",1,1],["أَمسى الفَرَزدَقُ لِلبَعيثِ جَنيبَةً","كَاِبنِ اللَبونِ قَرينَةَ المُشتالِ",67,"ل",1,0],["أَمسَت بِمَنبِجَ حُرَّةٌ","بِالحُزنِ مِن بَعدي حَرِيَّه",68,"ي",2,0],["أَمسى الفَتى عَمروُ بنُ عَبدٍ ثاوِياً","بِجَنوبِ سَلعٍ ثارُهُ لَم يُنظَرِ",69,"ر",1,1],["أَمسى نِساؤُكَ عَطَّلنَ البُيوتَ فَما","يَضرِبنَ فَوقَ قَفا سِترٍ بِأَوتادِ",70,"د",1,0],["أَمسى الخَلابيسُ قَد عُزّوا وَقَد كَثَروا","وَاِبنُ الفُرَيعَةِ أَمسى بَيضَةَ البَلَدِ",71,"د",1,1],["أَمسَت بَسابِسَ تَستَنُّ الرِياحُ بِها","قَد أُشعِلَت بِحَصاها أَيَّ إِشعالِ",72,"ل",1,0],["أمستنقذِي باللطف من قبضة الردى","لئن حثَّني فيكَ الرَّجا فليَ الحق",73,"ق",1,1],["أمسكت عن رميه وأعجبني","تعذيبه بالنباح والقلق",74,"ق",1,0],["أمسدي الأيادي البيض دعوة ظافر","لديك على رغم الزمان المماحك",75,"ك",1,0],["أمستخبراً بالشامِ عن كنه حالتي","ألم ترني مستبشراً بعد أحزاني",76,"ي",1,1],["أمسى الشبابُ رداءً عنك مستلبا","ولن يدومَ على العصرَين ما اعْتقبا",77,"ب",2,1],["أُمْسِي وأُصْبِحُ في ظَلْماءَ من بَصَري","فَما نَهَارِيَ مِنْ لَيْلي بمَحْدُودِ",78,"د",1,0],["أمسى مُجاوركم يأوِي إلى جبل","صعبِ المراقي ويرعى جانبَيْ وادي",79,"د",2,0],["أمسى جنابك محتازاً على جَدثٍ","من الملائكة الأبرار محضور",80,"ر",1,0],["أمسى أبا منزلٍ والجود خادمه","والأرض داراً له والناس أضيافا",81,"ف",2,0],["أمسى مجاوركم يحلُّ بنجوةٍ","ما للخطوب بها عليه طريق",82,"ق",1,0],["أمسكتَ سيْبَكَ إضراءً لرغبتهم","وما بخلتَ وما أمسكتَ ممْساكا",83,"ك",