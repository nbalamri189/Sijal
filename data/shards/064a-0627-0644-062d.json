""],[5388,"درة الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=206916",""],[5431,"يالقلبي واأساه ...","https://www.poetsgate.com/ViewPoem.aspx?id=191671",""],[5455,"الحصاد","https://www.poetsgate.com/ViewPoem.aspx?id=36402",""],[5455,"كبوة جواد","https://www.poetsgate.com/ViewPoem.aspx?id=34465",""],[5463,"سلوى عنوان المودّه","https://www.poetsgate.com/ViewPoem.aspx?id=30881",""],[5573,"لاتبكي ولاتدمع","https://www.poetsgate.com/ViewPoem.aspx?id=200176",""],[5573,"جرة الحمصاني","https://www.poetsgate.com/ViewPoem.aspx?id=200354",""],[2110,"بعثت رسالات الدموع السواكب","https://www.poetsgate.com/ViewPoem.aspx?id=156264",""],[5674,"نسمة الدير","https://www.poetsgate.com/ViewPoem.aspx?id=185169",""],[5674,"دموعي فوق أهدابي ملح","https://www.poetsgate.com/ViewPoem.aspx?id=189088",""],[5704,"يا روح الروح","https://www.poetsgate.com/ViewPoem.aspx?id=195152",""],[5732,"اعلل النفس","https://www.poetsgate.com/ViewPoem.aspx?id=177939",""],[5851,"حزن اليتيمة","https://www.poetsgate.com/ViewPoem.aspx?id=175236",""],[5913,"نجوى نسيم الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=177075",""],[6019,"حَفَاوَةُ اللِّقاءِ الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=212920",""],[321,"يا لحدب الظهور قصع الرقاب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=606415",""],[6225,"حلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80912&r=&rc=181",""]],"verses":[["يا لحظه الفتّاك رفقاً بامرئٍ","يقضي عليه تيقظ ومنام",0,"م",1,1],["يا لَحظَها مَن أُمُّها","أَو مَن أَبوها في الجَآذِر",1,"ر",1,0],["يا لحظة ما كان أسعدها","وهناءة ما كان أعظمها",2,"ه",2,0],["يا لحي يحوى العجائب فيه","عطش العاشقين ري الصادي",3,"د",2,0],["يا لحظه رفقا ويا خده","عليكما في الحب ما لي اصطبار",4,"ر",1,0],["يا لحظه بالمحب رفقا","بالغت بالحد فيه حدا",5,"د",2,0],["يا لحى الله هذه الدار كم قد","اوقعت من بها اعتنى في العناء",6,"ا",2,0],["يا لحى الله عاذلا","جاء بالافك واختلق",7,"ق",1,0],["يا لحدب الظهور فصع الرقاب","لدقاق الأنياب والأذناب",8,"ب",1,1],["يا لحم شداه مزّقه المو","ت وألقى صداه للسافيات",9,"ت",1,0],["يَا لَحْظَهُ أَثْخَنْتَ قَلْبي جِراحْ","كأَنَّ قَتْلِي لَك أَمْرٌ مُباحْ",10,"ح",1,1],["يا لحبر مَضى وَأَخلى الدِيارا","ليت شِعري أَكنت فينا مُعارا",11,"ر",2,1],["يا لحى اللَه كل واش نَموم","قَد سَعى بَينَنا وَكدّر فِكرا",12,"ر",2,0],["يا لحى اللَه علةَ التنكيدِ","لا تقُل لي شراهتي هي عيدي",13,"د",2,1],["يا لحد ميخائيل حيّاك الرضى","وسقاك غيث الرحمة الموصولُ",14,"ل",1,1],["يا لَحا الله وُدَّ مثلكِ ما أن","زرَ رِفدا عندي وأكثرَ منَّا",15,"ن",2,0],["يا لَحَظِّي الأعَمى أما يتلقَّى","قائداً يبتغِي الثوابَ فيُهْدَى",16,"د",2,0],["يا لَحا اللهُ أُناساً كُلّما","لاح للأَطْماعِ بَرْقٌ بَصْبَصُوا",17,"ص",3,0],["يا لَحا اللَّهُ مُهْمِلاً حسبَ الدّه","رَ نَؤُومَ الجفونِ عنه فناما",18,"م",2,0],["يا لَحا اللَّهُ مَن أراك على النّأْ","يِ طريقاً للسَّوءِ فيه مجالُ",19,"ل",1,0],["يا لحاكنَّ مِنْ رماكُنَّ بالحُس","نِ لِتَقْهرنَنا بغيرِ جنودِ",20,"د",1,0],["يا لحيٍّ إذا بدا فيلاقي","كلُّ حيٍّ حياته في مَنونه",21,"ن",2,0],["يا لحظ كلّ غزالٍ لست أملكه","يدنو وما لي حالٌ منه تدنيني",22,"ن",2,0],["يالحي الله خلَّةً مذ المَّت","دفعتهُ للخطة الشنعاءِ",23,"ا",2,0],["يا لحسرى القناع لم تلق إِلّا","آثماً من أُميَّةٍ أَو كفورا",24,"ر",2,0],["يا لَحُدْب الظهور قُعسِ الرقاب","لدقاق الخرطوم والأذنابِ",25,"ب",1,1],["يا لحيةً قد علقت من عارضي","لا استطيع لقبحها تشبيها",26,"ي",3,1],["يا لَحا اللَّه عَذولاً قَد لَحا","وَرَماهُ بِسِهامِ المِحَنِ",27,"ن",1,0],["يا لَحدَ شَمسِ العُلى فيها بِنورِ رِضا","رَبّي الرّحيمُ وَمَولاي الكَريم أَضا",28,"ض",2,1],["يا لَحظهُ السّيف أَضحى السِّحرُ جَوهَرهُ","وَالسّيفُ جَوهرهُ فيهِ لَهُ الشَّرفُ",29,"ف",1,1],["يا لِحية عَظُمَت في وَجهِ صاحِبها","كَثيفة خَبثت شَنعاء قَد قَبحت",30,"ت",1,1],["يا لَحظهُ في سُويدا القَلبِ فَتكها","وَكلُّ فَتكٍ بِهذا الفَتكِ أَنساني",31,"ي",1,1],["يا لحظ ربيب ويا جبين هلال","يا قد قضيب ويا روادف منهال",32,"ل",1,0],["يَا لَحْظَهَا المُسْوَدَّ أحْمَرُ خَدّهَا","يُدْعَى بِقَيْسِيٍّ وَأنْتَ يَمَانِي",33,"ن",2,0],["يا لحظ حتى متى لا تنثني أبدا","عن لحظ ما ليس يجدي من خيالات",34,"ت",1,0],["يا لحاهُ اللّه ما أفضحهُ","مِن خطيبٍ بِالأغاني قَد عُرِف",35,"ف",1,0],["يا لِحيَةً هَتَّكَ أَستارَها","بِأُصبَعٍ مِنهُ وَأُظفورِ",36,"ر",1,0],["يا لحال قد اعربت عن مقام","لي قد طاب فيه خلع العذار",37,"ر",1,0],["يا لحظة لحظ الحمام معيدها","ما كان منك لناظر إنظار",38,"ر",1,0],["يا لحد نظلة اكرم وصل سيدة","من ظل نخلتها رغما اليك سعت",39,"ت",1,1],["يالحُسن قد رأته مقلتاى","يوم قرّت بي الخُطَى فى استانلي باي",40,"ا",2,1],["يا لحد ليلى اعتبر ليلى فقد جليت","منها عليك رياض الورد والآس",41,"س",1,0],["يا لحد روزا الذي بالموت أحياها","باري الوجود وبالفردوس حياها",42,"ا",3,1],["يا لحظُ آلامُ الهَوَى","لم تُبقِ للقلبِ احتمال",43,"ل",1,0],["يا لحظها اِفتُك أوِ اِصفَح","فَأنتَ نَاظِرُ خَاصِ",44,"ص",1,0],["يا لَحظَها عَربِد وَلا تَحتَشِم","ذَنبُك مَغفورٌ وَمُستَحسَنُ",45,"ن",1,0],["يا لحية تشغف في ال","وتشنا العنبرا",46,"ر",2,0],["يا لحية أشبهَ شيء بالدجى","ضلّ بها صاحبها وما اهتدى",47,"ا",1,1],["يا لحظّ الجمال يمرحُ فيه","كلّ وحشٍ عيونه مغمَضاتُ",48,"ت",1,1],["يا لحظّ الأديب يُكرم ميتاً","ويلاقي في العيش بؤساً وذما",49,"م",2,1],["يا لحاظ الحور من بين الجنان","وامضات",50,"ت",1,0],["يا لحية الحب التي","زال هلا تثبتي",51,"ي",1,1],["يا لَحُضِيَّ دعوةٌ يالَهْ","يَسعى على مالى وأَشغالَهْ",52,"ل",2,1],["يا لحيةً عابُوا بها مَنْ بدَتْ","في خدّهِ وقبْلُ حيّوْكِ",53,"ك",1,0],["يا لحَى اللَهُ عِلَّةً لزَمانٍ","وافقت لا محالةَ اسماً وطبعا",54,"ع",2,0],["يا لحى اللّهُ ريبَ دهرٍ خؤونٍ","سادَ فيه كرامَهُ اللؤماء",55,"ا",2,0],["يا لُحُودَ الأَرضِ وارِيني التُّراب","قَبلَ أَن يَدهَمَني هَذا المُصاب",56,"ب",1,0],["يا لحى الله فتيةً ألجأتني","لاغتراب بعد اقتراب لهند",57,"د",1,0],["يا لحيةً تشغفُ في ال","خرءِ وتشنا العَنبرا",58,"ر",2,0],["يا لحا اللَه كف دهر رماني","ببعاد عن خلتي وانتزاحي",59,"ح",2,0],["يا لحى اللّهُ ليلةً قرصَتني","في دياجيرِها البراغيثُ قَرصا",60,"ص",2,1],["يا لحزني غاب ذو العزم الشديد","صاحب الآراءِ والحزم الوطيد",61,"د",1,0],["يا لِحَرب إِعصارُها فيهِ نارٌ","ما رَأَت مِثل نار هذي العُصورُ",62,"ر",1,0],["يا لحظةً أسقمني سقمُها","وفترةً في طرفهِ الفاتِرِ",63,"ر",1,0],["يا لحى الله نواكم إنها","سلبت قلبي وابلت جسدي"