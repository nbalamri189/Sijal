{"poems":[[95,"أليوم عيد البائس المتألم","https://www.aldiwan.net/poem11290.html","الكامل"],[47,"لك عهد لدي غير مضاع","https://www.aldiwan.net/poem64657.html","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38609","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93702","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100355","الرجز"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79726","الخفيف"],[4940,"بي قلب طفل","https://www.poetsgate.com/ViewPoem.aspx?id=214743",""],[402,"اليوم عيد البائس المتألم","https://www.poetsgate.com/ViewPoem.aspx?id=36427",""]],"verses":[["بِيَقِينِ أَنَّ الْبِرَّ لَيْسَ بِبَالِغٍ","غَايَاتِهِ إِنْ كَانَ غَيْرَ مُنَظَّمِ",0,"م",1,0],["بِيَقينٍ مِنَ الضِرابِ يُزيلُ ال","شَكَّ عَن مُنَّةِ الكَمِيِّ الشُجاعِ",1,"ع",1,0],["بي قَارِئ كَالبدرِ مِن","هُ جَمالُهُ يَتَلألأ",2,"ل",2,1],["بي قَرحةٌ لَو أَنَّها بيَلملمٍ","نَسفت جَوانبه وَساخَ يَلملم",3,"م",1,0],["بي قمراً في فلك الحسن بدا","يا قمراً انجم فيه فلكه",4,"ك",2,0],["بي قلب الجميل وهو خفوق","قد بلاه الزمان بالتعذيب",5,"ب",1,0],["بي قيد القوى يرسف فيه","كل حر في عيشه مغلوب",5,"ب",1,0],["‏بي قلب طفل مرهق بطفولتي","وجنون عاشقة ومكر صبيهْ",6,"ي",2,1],["بيقين أن البر ليس ببالغ","غاياته إن كان يغر منظم",7,"م",1,0]]}