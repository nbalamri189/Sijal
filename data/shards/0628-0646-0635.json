{"poems":[[79,"شاهد بعينيك مني قرة العين","https://www.aldiwan.net/poem36030.html","البسيط"],[79,"دعاك بأقصى المغربين غريب","https://www.aldiwan.net/poem36715.html","الطويل"],[23,"كنا ملوك الناس قبل محمد","https://www.aldiwan.net/poem21425.html","الطويل"],[47,"يفندون وهم أدنى إلى الفند","https://www.aldiwan.net/poem63480.html","الوافر"],[46,"أأطلال هند ساء ما اعتضت من هند","https://www.aldiwan.net/poem30544.html","الطويل"],[107,"أدأبك أن تريد المستحيلا","https://www.aldiwan.net/poem44213.html","الوافر"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67287","الوافر"],[147,"هل العدل إلا دون ما أنت مظهر","https://www.aldiwan.net/poem11762.html","الطويل"],[147,"بنصرك يدرك الفتح المبين","https://www.aldiwan.net/poem11833.html","الوافر"],[173,"أبر شهودي أنني لك عاشق","https://www.aldiwan.net/poem1641.html",""],[182,"الزفت","https://www.aldiwan.net/poem50700.html","الوافر"],[369,"أثرها فقد طال الغداة وقوعها","https://www.aldiwan.net/poem60849.html","الطويل"],[409,"فقد غش في الأديان من كان عالما","https://www.aldiwan.net/poem33445.html","الطويل"],[463,"خفف بذات البان من أثقالها","https://www.aldiwan.net/poem55951.html","الرجز"],[487,"طريقتنا قطع العلائق والخطو","https://www.aldiwan.net/poem24360.html","عموديه"],[568,"حمدنا الله ذا العرش المجيد","https://www.aldiwan.net/poem13602.html","الوافر"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2454","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38974","الرجز"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136152","الرمل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64589","الوافر"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118344","الوافر"],[1991,"","https://poetry.dctabudhabi.ae/diwan/poem/20411","الوافر"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87339","الطويل"],[2705,"","https://poetry.dctabudhabi.ae/diwan/poem/128637","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89212","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88968","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89049","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48322","البسيط"],[3641,"","https://poetry.dctabudhabi.ae/diwan/poem/202284","المتقارب"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135203","الوافر"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77007","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77152","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77178","الطويل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44723","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101382","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94888","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94884","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94556","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94885","الوافر"],[4579,"","https://poetry.dctabudhabi.ae/diwan/poem/205460","الوافر"],[4778,"لا يأس مع الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=196521",""],[5055,"شوف ألماس","https://www.poetsgate.com/ViewPoem.aspx?id=103651",""],[5136,"يهنيك يا شمس آل المصطفى العيد","https://www.poetsgate.com/ViewPoem.aspx?id=121551",""],[592,"ألا قل لذي الجهل المركب إنما","https://www.poetsgate.com/ViewPoem.aspx?id=128806",""],[592,"تبصر نور الحق من كان يبصر","https://www.poetsgate.com/ViewPoem.aspx?id=128795",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[470,"شكرا دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=64693",""],[5919,"عواصف اللهِ غارات بلا مَهَلِ","https://www.poetsgate.com/ViewPoem.aspx?id=128684",""],[5956,"الرسالة المحمدية","https://www.poetsgate.com/ViewPoem.aspx?id=184653",""]],"verses":[["بِنَصْرهِ أَرْسَلَ اللهُ الصَّبَا نُشُرا","وَأَنْزَلَ الرُّوحَ خَفَّاق الْجَنَاحَيْنِ",0,"ن",1,0],["بِنَصْرِكَ عَنْكَ الشُّغْلُ مِنْ غَيْرِ مِنَّةٍ","وَهَلْ يَتَسَاوَى مَشْهَدٌ وَمَغِيبُ",1,"ب",1,0],["بِنَصرِ الإِلَهِ وَالنَبِيِّ وَدينِهِ","وَأَكرَمَنا بِاِسمٍ مَضى ما لَهُ مِثلُ",2,"ل",1,0],["بِنُصحِ مُجتَهِدٍ صَحَّت عَزيمَتُهُ","أَو عَزمِ مُنجَرِدٍ أَو حَزمِ مُتَّئِدِ",3,"د",1,0],["بِنَصرِ بنِ مَنصورِ بنِ بَسّامٍ اِنفَرى","لَنا شَظَفُ الأَيّامِ عَن عيشَةٍ رَغدِ",4,"د",1,0],["بنصرٍ للنبيّ وراءَ نصرِ","وكان الله بالحسنى كفيلا",5,"ل",2,0],["بِنَصْرِ اللهِ رُوحُ القُدْسِ فيها","وميكالٌ فَيا طِيبَ الملاءِ",6,"ا",2,0],["بِنَصرِ اِبنِ مَحمودِ اِبنِ نَصرٍ تَسَهَلَّت","مَطالِبُ كانَت قَبلَهُ تَتَوَعَّرُ",7,"ر",1,0],["بِنَصرِكَ يُدرَكُ الفَتحُ المُبينُ","وَعِندَكَ يُؤمَنُ الزَمَنُ الخَؤونُ",8,"ن",1,1],["بِنَصلٍ يَقُولُ المَوتُ حينَ يَشُكُّهُ","بِزَوجَةَ مَن يُعلى بِهِ أَنتِ طالِقُ",9,"ق",1,0],["بنصلِ الحدِّ قد بعُدَ المرامُ","جوازاتٍ يُضاجِعُها الختامُ",10,"م",1,0],["بنَصْرِ بنِ منصورٍ تَلاقَتْ أُمورُها","ولولا نَداهُ لاستطارَتْ صُدوعها",11,"ع",3,0],["بنصح جميع الخلق فيما ينوبهم","ولا سيما فيما أحل وحرما",12,"م",2,0],["بِنَّ صحيحاتٍ وأرسلنَ معي","جفناً قريحاً وفؤاداً والها",13,"ل",3,0],["بنصر الله أيد الله عبده","وأعدادهم بخ بخاجل وأبرد",14,"د",1,0],["بِنَصرِ المُؤمِنينَ أَتاهُ نَصرٌ","وَأَسرارُ الجَداوِلِ وَالسُعودِ",15,"د",1,0],["بِنَصرِ اللَهِ يَعلوها","وَيَمريها وَيَغلِبُها",16,"ب",3,0],["بِنَصرِ دينِك القَويمْ","قَد قامَ في قَلبٍ سَليمْ",17,"م",1,0],["بنصوص ظاهرات","ومقالات صريحه",18,"ح",2,0],["بنصرك استعد لكل هول","بحولك كل هول لا ينوب",19,"ب",1,0],["بنصر الله واثقة يقينا","فلا تدري من الخلق الحدارا",20,"ر",2,0],["بِنَصلِ السَيفِ لَيسَ لَهُ مِجَنٌ","فَصَدَّ وَلَم يُصادِفُهُ جَسيسُ",21,"س",1,0],["بِنِصفِ آصبَعٍ قَد قِستُ والقيدُ رَامِحٌ","على حَالِهِ خًمسٌ على الأفقِ وَاقِع",22,"ع",1,0],["بِنَصرٍ إمامٍ حلَّ مغربنا الهنا","وحقَّ به اليُمنُ المُؤَبَّدُ والأمنُ",23,"ن",1,1],["بنصر من اللَه وفتحٍ وصحةٍ","وعمر ترى الأيام بالطول حرّاسا",24,"س",2,0],["بنصر وفتح جاء صدري فيا له","بسر أجاء الحي خير سعيد",25,"د",1,0],["بنصر من الله وفتح محمد","ببشر وخير أنجز اللَه ما وعد",26,"د",1,0],["بنَصْرِ مُلْكِكَ أعْلى اللهُ مظهَرَهُ","للهِ ساجِدُها يدْعو وراكِعُها",27,"ع",3,0],["بنصر من الله رب العباد","على رغم من أنفه يرغم",28,"م",1,0],["بنصرٍ لا يفارقكم دواماً","وقطع الله دابر كافرينا",29,"ن",2,0],["بِنُصرَةِ دينِ المُصطَفى وَظَهيرِهِ","هُوَ الحِبرُ ذو الافضالِ حاوي المَكارِمِ",30,"م",1,0],["بِنُصحٍ يُزيلُ الغَيَّ عَن مُستَقَرِّهِ","وَيَدعو إِلى الرُشدِ الَّذي يَكشِفُ العَمى",31,"م",2,0],["بنص الإِمام الشافِعِيِّ أَخي التُقى","هُوَ الحبر كَنز العِلمِ شَمسُ المَعارِف",32,"ف",1,0],["بِنَصرٍ لَقَد أَعطى المَناصبَ حَقَها","بِحَزمٍ وَأَعمالٍ بِها قُلِّدَ الفَخرا",33,"ر",2,0],["بنصائح لبلاغها","قلب العلند الصلب اذعن",34,"ن",1,0],["بنصر الله والينا المفدَّى","تبدّت باسم رسلانٍ سبيلا",35,"ل",2,1],["بنصر اللَه فالتاريخ راو","ودوا ماءَ الحياةِ الكوثريا",36,"ي",2,0],["بنصر اللَه قد نِلتَ انتصاراً","فطب نفساً وزد حمد الحميدِ",37,"د",1,0],["بنصر اللَه أرَّخنا عُلاهُ","سبيلٌ شربهُ يشفي العليلا",38,"ل",2,0],["بنصرة هاشمٍ شهّرت نفسي","بداري للعدا وبغير داري",39,"ر",2,0],["بنصرٍ قادمٍ ما ليس إلّا","سويعات عساها لا تطول",40,"ل",1,0],["بنصحك يا بنت لاطال العنقّ","ألبسي والشال وردٍ .. للرّدوف",41,"ف",1,0],["بنصر أحمد شمس الدين نور محيا","الآل بدر سماء المجد والجود",42,"د",1,0],["بنص كتاب الله جل ثناؤه","وسنة من قد كان بالله أعلما",43,"م",2,0],["بنص رسول الله أفضل مرسل","وذلك بالنقل الصحيح محرر",44,"ر",1,0],["بنصرته من ليس للدين ناصراً","وهل هو إلا مارج العقل ذاهله",45,"ل",2,0],["بِنِصفِهِم ضاقَت الدُّنيا بأجمَعِها","وأنتِ تَسمُو بِكِ الأرحامُ والخُلُقُ",46,"ق",1,0],["بنصِّ أرواحنا جندٌ مجنّدٌة","ففي التعارف مرمى غاية الأمل",47,"ل",1,0],["بنصح يُنْطِق الحجرا","وعقل يمحق الكدرا",48,"ر",2,0]]}