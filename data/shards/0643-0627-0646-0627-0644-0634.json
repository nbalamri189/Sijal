","https://www.poetsgate.com/ViewPoem.aspx?id=180222",""],[5190,"الشرخ","https://www.poetsgate.com/ViewPoem.aspx?id=153358",""],[5338,"سقيت ربعك غيث المدمع الهطل","https://www.poetsgate.com/ViewPoem.aspx?id=187697",""],[404,"اعتزالٌ","https://www.poetsgate.com/ViewPoem.aspx?id=191816",""],[5431,"ألا يانارُ بردا فلتكوني","https://www.poetsgate.com/ViewPoem.aspx?id=185983",""],[5431,"حجار نرد ...","https://www.poetsgate.com/ViewPoem.aspx?id=202747",""],[5536,"صرح فرعون!!","https://www.poetsgate.com/ViewPoem.aspx?id=27509",""],[5596,"وادي الكرام","https://www.poetsgate.com/ViewPoem.aspx?id=206177",""],[5596,"الى الشيخ الصوّافي","https://www.poetsgate.com/ViewPoem.aspx?id=206689",""],[5702,"مرثية حنان","https://www.poetsgate.com/ViewPoem.aspx?id=116712",""],[5725,"اتصبوا في غرامك","https://www.poetsgate.com/ViewPoem.aspx?id=178278",""],[5725,"على استحياء","https://www.poetsgate.com/ViewPoem.aspx?id=180382",""],[5809,"رضيع","https://www.poetsgate.com/ViewPoem.aspx?id=205579",""],[5818,"لعلّ الله أنْ يشفي سقامهْ","https://www.poetsgate.com/ViewPoem.aspx?id=193231",""],[5819,"بنت صور","https://www.poetsgate.com/ViewPoem.aspx?id=215659",""],[5992,"نروقُ الطَّرْفَ تدريجاتُ غَيْم","https://www.poetsgate.com/ViewPoem.aspx?id=41805",""],[6104,"أريج الصبايا","https://www.poetsgate.com/ViewPoem.aspx?id=25365",""],[199,"طار الكرى وألم الهم فاكتنعا","https://www.poetsgate.com/ViewPoem.aspx?id=22418",""],[5309,"طلاب الخلد حرر كل واع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573520",""],[5567,"رحلة وجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82080&r=&rc=133",""]],"verses":[["كَأَنَّ الشَمسَ مالَ بِها غُروبٌ","فَأَهوَت في حَيازيمِ الدِنانِ",0,"ن",1,0],["كانَ الشَبابُ دُجُنَّةً فَتَمَزَّقَت","عَن ضَوءِ لا حَسَنٍ وَلا مَألوفِ",1,"ف",1,0],["كانَ الشَبابُ الَّذي أَنضَيتُ مِندَلَهُ","عِقبَ الخَميلَةِ لَمّا صَوَّحَ الزَهرُ",2,"ر",1,0],["كَأَنَّ الشَمسَ تَرمُقُهُ","فَتُخجِلُها بِواتِرُه",3,"ر",2,0],["كأنّ الشّآبيبَ مِنْ صَوْبِهِ","مَواهِبُ خَيْرِ بَني الحَبْرِ فينا",4,"ن",2,0],["كأنّ الشّمسَ قد نَضحَتْ جِيادي","بِذَوْبِ التّبْرِ إذ جَنَحَتْ أصيلا",5,"ل",2,0],["كَأَنَّ الشَموسَ بِها بَيتُهُ","يُطيفُ حَوالَيهِ أَوعالُها",6,"ل",3,0],["كَأَنَّ الشُهبَ في الأَذانِ مِنه","إِذا قَرَعوا بحافَتِها الجَبينا",7,"ن",2,0],["كَأَنَّ الشَمولَ خالَطَت في كَلامِها","جَنِيّاً مِنَ الرُمّانِ لَدناً وَذابِلا",8,"ل",2,0],["كان الشبابُ وقلبي منه منغمسٌ","في فرجةٍ لستُ أدري ما دواعيها",9,"ي",3,0],["كانَ الشَباب وَكانَ لي أَمَلٌ","كَالبَحرِ عُمقاً كَالزَمانِ مَدى",10,"د",2,0],["كان الشباب يسرني","اما المشيب فلا يسر",11,"ر",1,1],["كان الشباب ربيعاً فيه تطربني","من العصافير في الصبح الاغاريد",12,"د",1,0],["كأن الشمس مسلمة اصابت","عفيفا في طيالسه شجاعا",13,"ع",2,0],["كَأَنَّ الشَمسَ قَد نُعِيَت عِشاءً","إِلَيها فَهيَ حَسرى كاسِفاتُ",14,"ت",1,0],["كان الشبابُ الغضُّ يجمعُنا","فمضَى وشتَّتَ شملَنا الوَخْطُ",15,"ط",1,0],["كان الشبابُ هو السرورَ فرمتُهُ","إذ فاتَ في الدنيا فعزَّ المطلبُ",16,"ب",1,1],["كأن الشرب مطبوخ","على راحته اليمنى",17,"ن",2,0],["كأنَّ الشَّقَائِقَ والياسَمينَ","على خَدِّهِ خَجَلاً شُقِّقا",18,"ق",2,0],["كأنَّ الشَّرْبَ ينتهبونَ ناراً","لها لَهَبٌ وليس لها شَرارُ",19,"ر",1,0],["كَأَنَّ الشَمسَ وَالبَدرَ","جَميعاً في تَراقيكِ",20,"ك",1,0],["كأنّ الشرق في هذا وهذا","مَصَفٌّ فيه زَنْجيّ ورومي",21,"م",2,0],["كَأَنَّ الشَمسَ جَلَّلَها كُسوفٌ","أَوِ اِستَتَرَت بِرِجلٍ مِن جَرادِ",22,"د",1,0],["كأنَّ الشقيقَ وألوانهُ","ثيابٌ شُققنَ على ثاكلِ",23,"ل",1,1],["كانَ الشِفاءُ لَنا وَمُنيَتُنا","مِنكِ الحَديثَ فَغالَنا غِيَلُه",24,"ل",2,0],["كأنّ الشّقيقَ الغَضَّ يُكحَلُ أعيُناً","ويَسْفِكُ في لبّاتِهِ الدّمَ سافك",25,"ك",1,0],["كانَ الشَبابُ مَطِيَّةَ الجَهلِ","وَمُحَسِّنَ الضَحِكاتِ وَالهَزلِ",26,"ل",1,1],["كَأَنَّ الشَمسَ مُقبِلَةٌ عَلَينا","تَمَشّى في قَلائِدِ ياسَمينِ",27,"ن",1,0],["كانَ الشَقا حُبّي مَدينِيَّةً","راحَت بِها دارٌ وَما راحا",28,"ح",2,0],["كَأَنَّ الشَذرَ وَالياقوتَ مِنها","عَلى جَيداءَ فاتِرَةِ البُغامِ",29,"م",1,0],["كَأَنَّ الشَدوَ في الأَعراسِ نَوحٌ","وَأَصواتُ النَوادِبِ لَهوُ عُرسِ",30,"س",1,0],["كانَ الشَبابُ ظَلامَ جِنحٍ فَاِنجَلى","وَالشَيبُ يَذهَبُ في النَهارِ الزائِلِ",31,"ل",1,0],["كانَ الشَبابُ يُلَهّينا وَيُعجِبُن","فَما وَهَبنا وَلا بِعنا بِأَرباحِ",32,"ح",1,0],["كانَ الشَبابُ يُلَهّينا وَيُعجِبُنا","فَما وَهَبنا وَلا بِعنا بِأَرباحِ",33,"ح",1,0],["كأَنَّ الشَّمسَ لمَّا غِبْتَ غابَتْ","فليسَ لها على الدُّنيا طُلوعُ",34,"ع",1,0],["كانَ الشَباب سلاحاً لي أَصولُ به","عَلى الَّذين استخفوا بي وأحتكم",35,"م",1,0],["كَانَ الشَّبَابُ لِحَاجَاتٍ وكُنَّ لَهُ","فَقَدْ فَرَغْتُ إلَى حَاجَاتِي الأُخَرِ",36,"ر",1,0],["كأن الشَّمسَ حينَ رأتْ","صِبَاها أوَّلَ الدَّهرِ",37,"ر",1,0],["كَأَنَّ الشُهبَ في الأَذانِ مِنها","إِذا قَرَعوا بحافَتِها الجَبينا",38,"ن",2,0],["كان الشبابُ طمِاحَ لاعجَةِ الهَوى","فاليوم يرفَعُ ساعدَيه طِمَاحِي",39,"ح",2,0],["كان الشبابُ شفيعي في نضارتِه","الزهرُ مؤتلِقٌ والعودُ فَيْنان",40,"ن",1,0],["كان الشجاعة في أسمى مظاهرها","يخطو إلى الموت فردًا ثابت القدم",41,"م",1,0],["كأنَّ الشوقَ يَدفَعُهُ فيذكي","جوانِحَهِ من النجم اقتراب",42,"ب",1,0],["كان الشتاء يغطيني بمعطفه","فلا أفكر في برد ولا ضجر",43,"ر",1,0],["كأنّ الشّمس حيت رأت","صبها أوّل الدّهر",44,"ر",1,0],["كَأَن الشعر رَوض قَد جَنَتهُ","فَهوم السابِقين إِلى الكَمالِ",45,"ل",1,1],["كَأَن الشَباب الروق لَيلة زائر","أَلَمَّ بِها قَبل التَمام نَهار",46,"ر",1,0],["كَأنَّ الشِّيبَ شِيبُهُمُ رُعَاةٌ","يَسُوسُونَ المَجَالِيحَ الهِجَانَا",47,"ن",2,0],["كانَ الشُجاعَ الجَوادَ الفَردَ سُؤدَدُهُ","لَهُ فَضائِلُ تَعلو سادَةَ الأُمَمِ",48,"م",1,0],["كأنّ الشؤالَ على رِفده","قِداحٌ تفوذ بأنصابها",49,"ب",3,0],["كَأَنَّ الشَقائِقَ إِذ أُبرِزَت","غِلالةُ لاذٍ وَثَوبٌ أَحَم",50,"م",1,1],["كَأَنَّ الشَرارَ عَلى نارِنا","وَقَد راقَ مَنظَرُهُ كُلَّ عَينِ",51,"ن",1,1],["كانَ الشَبابُ رِداءً أَستَكِنُّ بِهِ","وَأَستَظِلُّ زَماناً ثُمَّتَ اِنقَشَعا",52,"ع",2,0],["كان الشهابَ المستضيءَ فلم يَنُبْ","عن نوره نور السِّماكِ دليلا",53,"ل",2,0],["كأن الشعور عراها البياض","سهام الردى أو خيوط الكفن",54,"ن",1,0],["كأنَّ الشَّمْسَ شَرّاقاً","باعلا كفِّه العالي",55,"ل",2,0],["كأنّ الشقيقَ بأرْجائها","خدودٌ ثَنَتْ عَقْد تنْقابِها",56,"ب",3,0],["كأنّ الشمس فيه عروس حَوْفٍ","تُزَفّ إليهم في ثوب شَرْب",57,"ب",1,0],["كانَ الشَفيعَ إِلى الحِسانِ فَمُذ مَضى","أَمسَت تُعَدُّ مَساوِياً حَسَناتُهُ",58,"ت",2,0],["كَأَنَّ الشَبابَ كانَ رَوحَةَ راكِبٍ","قَضى أَرَباً مِن أَهلِ سُقفٍ لِغَضوَرا",59,"ر",2,0],["كَأَنَّ الشَّيْبَ يَسْرِقُ نُورَ عَيْني","فَيَنقُصُ ذا إذا ماذا يُزَيَّدْ",60,"د",1,0],["كأنَّ الشَّواقيلَ العظامَ ورَمْيَها","إذا القومُ حَطُّوها مُنيخو جَمائل",61,"ل",1,0],["كان الشَّبابُ للَّيالي خِلعةً","عليّ قد أفاضَها ماضي الحِقَب",62,"ب",1,0],["كَأَنَّ الشَمسَ لَما غِبتَ غابَت","عَنِ الدُنيا فَلَيسَ لَها طُلوعُ",63,"ع",1,0],["كأنَّ الشَّعْرَ شِرْبٌ كانَ صَفْواً","فشابَتْهُ اللَّياليَ بالقَذالي",64,"ل",2,0],["كَأَنَّ الشَمسَ يَومَ أُصيبَ مَعنٌ","مِنَ الإِظلامَ مُلبَسَةٌ جِلالا",65,"ل",2,0],["كانَ الشَبابُ خَفيفَةٌ أَيّامُهُ","وَالشَيبُ مَحمَلُه عَلَيكَ ثَقيلُ",66,"ل",1,0],["كأنّ الشُعاعَ على متنِه","فرنْدٌ بصفحةِ سيفٍ صَدي",67,"د",2,0],["كان الشبابُ الغضُّ لي","لاً فاستنارَ الشّيْبُ فجْرا",68,"ر",2,0],["كان الشبابُ أخا مودّتِها","فرُميتُ في الأخوين بالثُّكلِ",69,"ل",1,0],["كان الشبابُ سُدفةً","من لك لم تقَشّعِ",70,"ع",1,0],["كأنّ الشعرَ لم يُفصحْ لحيٍّ","سواه وكلُّهم لَحِنٌ فصيحُ",71,"ح",1,0],["كأنَّ الشتاء اليَبْسَ بين بيوتهِ","نضيرُ ربيعٍ يجعل الصَّلدَ كاسيا",72,"ي",2,0],["كانَ الشبابُ حينَ كانوا جيرةً","اليهمُ أن هجروا شفيعا",73,"ع",2,0],["كأن الشِّفاهَ اللُّعْسَ منها خواتِمٌ","من التِّبْرِ مختومٌ بِهنَّ على الدُّرْ",74,"ر",1,0],["كأن الشموع وقد أظهرت","من النار في كل رأس سنانا",75,"ن",2,1],["كأنّ الشفانينَ والمفصحات","منَ الطّيرِ فوقهما تهتفُ",76,"ف",1,0],["كَأَنَّ الشّقيقَ الغَضَّ حينَ تراقص","كُؤوسُ طُلا الأَفراحِ حَيثُ الصّدا تَجلو",77,"ل",2,0],["كأنَّ الشُّعاع الأُرْجُوانيَّ فوقَه","سَنا شَفَقٍ يَنْجَاب في الليل عن نَجْمِ",78,"م",1,0],["كأن الشقيق بها وجنةٌ","بآخرها لمعةٌ من عذار",79,"ر",1,0],["كَأَنَّ الشَرارَ عَلى نارِها","وَقَد راقَ مَنظَرُها كُلَّ عَينِ",80,"ن",1,1],["كانَ الشَبابُ لِمَّةً أُزهى بِها","وَصاحِباً حُرّاً عَزيزاً المُصطَحَب",81,"ب",1,0],["كان الشَّبابُ كَزائِرٍ","مَلَّ الزِّيارَةَ فَانْصَرَفْ",82,"ف",1,0],["كَانَ الشَّبَابُ عِنْدَهَا أَرَاكَةً","تُسْقَى بِكَأسَاتِ الرِّضَا المُصَافِيَهْ",83,"ي",2,0],["كان الشفيعُ على العباد بأسرهم","نعماً وآلاءً وجل أمانى",84,"ن",2,0],["كَأَنَّ الشَمسَ لَما كا","سَفَت في ثَوبِها الوَردِ",85,"د",1,0],["كانَ الشَّبابُ كَخِضاب قَد نَصَل","وَاِبتَزَّه الشَّيبُ محلّا فَنَزَل",86,"ل",1,1],["كأن الشمس أضحت منه خجلى","فيوم قدومه ارتدت الغيوما",87,"م",2,0],["كأن الشمس تغزوها الثريا","فتم لها على الشمس النجاح",88,"ح",1,0],["كأن الشرق ليس به رجال","وأن بنيه في الأحداث ناموا",89,"م",3,0],["كانَ الشَبابُ إِلى هِندٍ يُقَرِّبُنِي","وَشابَ رَأسِي فَصارَ اليَومَ يُقصِيني",90,"ن",2,0],["كأن الشمس قد علمت يقينا","بأن البدر أحرمنا ظهوره",91,"ه",1,1],["كأنّ الشيخَ إسماعيلَ لمّا","تَلأْلأَ عِلْمُه يوم الخِتام",92,"م",1,0],["كان الشباب الرَّوق فيها وبها","قضَّيت أيَّام الصِّبا الأوائلا",93,"ل",2,0],["كأن الشمس يسترها غمام","ومنك اليوم قد نارت ذكاء",94,"ا",2,0],["كأن الشعاع أطراف ثوب","وهي تدنو إلى الثرى استمهالا",95,"ل",2,0],["كأنَّ الشَّقائق والأُقْحُوان","خدودٌ تُقَبِّلُهُنَّ الثُّغُورُ",96,"ر",1,1],["كان الشافعي إليه اوصى","بمذهبه فنظمه انتظاما",97,"م",2,0],["كأن الشعر شيبُ القلب عندي","يزيد كشيب شَعري في الخطوب",98,"ب",1,0],["كأن الشعر يطلبني بدين","فكم يجنى علي ويستطيل",99,"ل",1,0],["كأن الشيب ضيف ليس يرضى","بشيء غير شغلي بالمعاد",100,"د",1,0],["كان الشقيق وستر الضباب","وزهر تبقى عليها هزيع",101,"ع",1,0],["كأن الشمس إذ غربت غريق","هوى في البحر أو وافى مغاصا",102,"ص",2,1],["كأن الشمل لم يكن ذا اجتماع","إذا ما شتت البين إجتماعه",103,"ه",1,0],["كأنَّ الشمسَ سُنَّتُها إذا ما","حلَفْنَ لتُسفِرَنَّ منَ اللِّثامِ",104,"م",1,0],["كأنَّ الشبابَ ولذّاتِهِ","ورَيْقَ الصِّبا كانَ ثوباً مُعارا",105,"ر",2,0],["كأن الشمس غرتها ولكن","تغيب بليل شعر كان وحفا",106,"ف",2,0],["كَأَن الشَمس من تَحتَ الأَراضي","لِذلك لا تَرى أَبَداً ضياها",107,"ا",3,0],["كان الشِّداد بعد عصر الجُمعَه","والسّير دفعةً عَقِيبَ دفعَه",108,"ه",1,0],["كأن الشفيق الغض والفجرُ ساطع","خدود زهاها الحسن أن تتنقبا",109,"ب",2,0],["كَأَنَّ الشَيبَ وَالأَحداثَ تَجري","إِلى نَفسِ الفَتى 