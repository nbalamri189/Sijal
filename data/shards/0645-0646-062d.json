://poetry.dctabudhabi.ae/diwan/poem/23993","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54219","الكامل"],[106,"رثاء طيارين!","https://www.poetsgate.com/ViewPoem.aspx?id=179490",""],[106,"استعطاف وتبرئة","https://www.poetsgate.com/ViewPoem.aspx?id=179393",""],[106,"فيم احتفالكم ؟","https://www.poetsgate.com/ViewPoem.aspx?id=179398",""],[106,"أغنية الإِسراء","https://www.poetsgate.com/ViewPoem.aspx?id=179622",""],[106,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[106,"تمثال فينوس","https://www.poetsgate.com/ViewPoem.aspx?id=179776",""],[106,"راهب الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=179334",""],[100,"صدى","https://www.poetsgate.com/ViewPoem.aspx?id=50403",""],[90,"قف بأجداث الضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=179225",""],[90,"فلسطين الدامية","https://www.poetsgate.com/ViewPoem.aspx?id=179033",""],[45,"قل للرئيس أبي محمد الرضا","https://www.poetsgate.com/ViewPoem.aspx?id=32828",""],[99,"إفادة في محكمة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=581",""],[51,"يا رُبَّ لهفانَ على صنيعَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=29481",""],[51,"إذا كان صبريَ للعاجلِ","https://www.poetsgate.com/ViewPoem.aspx?id=30254",""],[51,"أشدْ بأيامنا لتَشهرَها","https://www.poetsgate.com/ViewPoem.aspx?id=29178",""],[51,"خبا نَحْسٌ وأعقب منه سعْد","https://www.poetsgate.com/ViewPoem.aspx?id=28470",""]],"verses":[["مَنَحتُكَ صِدقَ وِدادٍ يَتوقُ","إِلى رَنقِهِ كُلُّ هَذا الأَنامِ",0,"م",1,0],["مَنَحتُكُمُ الوِدادَ فَلَم تَوُدّوا","فَأَلقَيتُ المَلامَ عَلى فِعالي",1,"ي",1,0],["مَنَحتُكَ ماعِندي مِنَ الصَدِّ مُعلِناً","وَعَقدُ ضَميري أَن أَدومَ عَلى الوُدِّ",2,"د",1,0],["مَنَحتُكَ جُلَّ أَشعاري فَلَمّا","ظَفِرتَ بِهِنَّ لَم أَظفَر بِمَنحِ",3,"ح",1,0],["مَنَحتُكَ مِن مَنطِقي تُحفَةً","رَأَيتُ بِها فُرصَةً تُستَلَب",4,"ب",1,0],["مَن حاكِمٌ بَيني وَبَي","نَ الدَهرِ مالَ عَلَيَّ عَمدا",5,"د",2,0],["مِن حُبِّ جارِيَةٍ لَهِجتُ بِذِكرِها","خَوفَ الفِراقِ فَصِرتُ كَالمُتَعَلِّقِ",6,"ق",1,0],["مِن حُبِّ خَودٍ طَفلَةٍ","كَالشَمسِ حُسناً حينَ تُشرِق",7,"ق",1,0],["مِن حاسِدٍ يَقذِفُنا","مُشارِفٍ لِلكَذِبِ",8,"ب",1,0],["مَنَحتَها مِنكَ عَزماً صادِقاً خَضَعَت","لَهُ ظُبى الهِندِ وَالخَطِيَّةُ السُلُبُ",9,"ب",1,0],["مَنَحنا بَقاياهُم حَياةً جَديدَةً","فَعاشوا بِأَعناقٍ مُقَلَّدَةٍ مَنّا",10,"ن",2,0],["مِن حُبِّ جارِيَةٍ يَبدو بِها صَنَمٌ","مِن اللُجَينِ عَلَيهِ تاجُ عِقيانِ",11,"ن",1,0],["مَن حَسَّ لي الأَخَوَينِ","كَالغُصنَينِ أَو مَن راهُما",12,"م",2,1],["منحوني إصغاءهم وقصارى ال","قول فخراً تأييد أهل الفعال",13,"ل",1,0],["مَنَحُوا الجَدِيدَ مِنَ المَفَاخِرِ حَقَّهُ","وَرَعَوْا لِعَهْدِهِمُ القَدِيمِ ذِمَامَا",14,"م",2,0],["مَنْحُوتَةٍ فِي الصَّخْرِ لَكِنَّهَا","تَكَادُ تُحْيِي بَالِيَاتِ الْعِظَامُ",15,"م",1,0],["مِنْحَةُ الْيَوْمِ بَعْدَ أَلْفِ دَلِيلٍ","يَمْلأُ العيْنَ جَاءَ فِيهَا دَلِيلُ",16,"ل",1,0],["من حلّ فيه وادّعى خلده","كان لعمري صادق الدعوى",17,"ع",3,0],["من حيث لا تملك من دهرها","ما جَلَّ أو َدقَّ ولو سِمْسِمه",18,"م",2,0],["مِن حُبَّكُم فَاِعلَمي لِلحُبِّ مَنزِلَةً","نَهوى أَميرُكُمُ لَو كانَ يَهوانا",19,"ن",2,0],["مِن حَياةٍ قَد مَلِلنا طولَها","وَجَديرٌ طولُ عَيشٍ أَن يُمَلّ",20,"ل",1,0],["مَنَحناها الحَرائِبَ غَيرَ أَنّا","إِذا جارَت مَنَحناها الحِرابا",21,"ب",2,0],["مِن حَبيبٍ أَصابَ قَلبَكَ مِنهُ","سَقَمٌ فَهوَ داخِلٌ مَكتومُ",22,"م",1,0],["من حولِ منزلهِ الرَّجاءُ محلقٌ","ومقصرٌ حمدُ الفتى وثناؤه",23,"ا",3,0],["من حيث يرقم إسمه وفعالهُ","فالعزُّ والإقبال والبركات",24,"ت",1,0],["منحتني المال صبحة فعسى","تكون يا أكرم الورى عاده",25,"ه",1,0],["من حكمة الله الخفيَّة أن ترى","كلّ البريَّة راضياً عن عقله",26,"ل",2,0],["من حسانٍ لديَّ لم تهد إلاَّ","لفلانٍ من الورى وفلان",27,"ن",1,0],["من حور رضوان في محاسنِه","لكنَّ نار الفؤاد مأواه",28,"ا",2,0],["مِنْ حَيْثُ لا مِرَرُ الطِّبَاعِ تَنَقَّضَتْ","كِبْراً ولا وَرَقُ الشَّبَابِ تَصَوَّحَا",29,"ح",2,0],["من حقه أن يكون مَصْفَعَةً","أذلّ للصافعين من نَقدَهْ",30,"د",2,0],["من حَبير الشِّعْر من أسْمَعُهُ","فوعاه قال روضٌ أو بُرُودُ",31,"د",1,0],["منحتُكها يا ابن الوزير تَعلَّةً","وزاداً خفيفاً للمقيمين والسَّفْر",32,"ر",1,0],["مَنحتُكها غرّاء يقطعُ وَخْدُها","نهار أخي لهوٍ وليل سَمير",33,"ر",1,0],["مِنْ حَلَبِ الصُّنع أن تُبادر بال","نِعمة مُوليكها فتشكرَها",34,"ر",3,0],["منحتهُمُ مالاً وجاهاً كلاهما","لهم منه حظ يملأ الكف وافر",35,"ر",1,0],["منحْتُكَها كالروض جادتْه دِيمةٌ","بكت فوقه حتى تضاحك عابسه",36,"س",2,0],["منحتُكها تحدو المطيَّ على الونَى","وتنفي الكرى عن ذي السُرى وهو ناعس",37,"س",1,0],["منحتكموها شكم نفس أبية","قليل عن الطاغي الأبيِّ كيوعها",38,"ع",3,0],["من حسن الله وجهَهُ وسجا","ياه وأعطاه كُلِّف الكلفا",39,"ف",2,0],["منحَ اللَّه جدَّةَ الشُّركِ الشي","خَ ولا انفكَّ ذلك التفكيك",40,"ك",1,0],["منحتُكَ مصباحاً فأعشاك ضوؤُهُ","وقد كان ظَنّي أنه سَيُريكا",41,"ك",2,0],["منحتُك مدحي فلم تجزهِ","ألا ضلّ سعْيِيَ من عاملِ",42,"ل",1,0],["منحتْه فضولُهُ كلَّ فضلٍ","حلَّ بين النبيلِ والتنبالِ",43,"ل",1,0],["منحتُكها مطفَّلةً تُباري","ذبابَ السيفِ ليس لها نُكولُ",44,"ل",1,0],["منحْتكها حوليَّةَ النسْج لم تزل","تعانَى مدى حَوْلٍ دكيكٍ وتُخْدَمُ",45,"م",1,0],["مَنَحتُكها بيضاءَ في صدر حافظٍ","وإن مُثِّلتْ سوداءَ في رقِّ راقمِ",46,"م",1,0],["منحتُكَ من حُلِيِّ الشعرِ عقداً","غدا لك دُرُّهُ وليَ النظامُ",47,"م",1,0],["مَنَحْتُكَ من وُدِّي مُقيماً مكانَهُ","يُبارِي ثَناءً لم يزلْ فيكَ ظاعنا",48,"ن",2,0],["من حُسنِ حالٍ ورِفْه بالٍ","ورفع قدرٍ وحَطِّ دَيْن",49,"ن",1,0],["مِن حَولِهِنَّ الأَقاحي","وَالوَرد وَالمَنثورُ",50,"ر",1,0],["مِن حَولِكُم وَأَمامَكُم تارِخُهُم","فَاِستَخبِروهُ فَذاكَ أَصدَقُ راوِيَه",51,"ي",2,0],["من حق إخوانك القدامى","إن تسقى العهد والإخاء",52,"ا",2,0],["مِن حَظِّهم أَن صادَفوا خَليفَةً","في قَلبِهِ لَهُم وَلِلعَفو هَوى",53,"ا",1,0],["مِن حَقِّهِ أَن يُرفَقا","بِهِ وَأَلّا يُرهَقا",54,"ق",2,0],["مِن حَبَّةٍ ذُخِرَت وَأَيدٍ ثابَرَت","جاءَ الزَمانُ بِجَنَّةٍ فَيحاءَ",55,"ا",2,0],["مِن حَديدٍ جانِباها سابِغٍ","رَبَضَ المَوتُ عَلَيهِ وَفَغَر",56,"ر",1,0],["مِن حَواشٍ كَجَليدٍ لَم يَذُب","وَفُصولٍ تُشبِهُ التِبرَ المُذابا",57,"ب",2,0],["مِن حِسانِهِم","سِربٌ اِنسَرَب",58,"ب",1,0],["مَنَحتَهُم هُدنَةٌ مِن سَيفِكَ اِلتُمِسَت","فَهَب لَهُم هُدنَةٌ مِن رَأيِكَ الضَرِبِ",59,"ب",1,0],["من حيثُ جادَ المعتفي فجَداؤهُ","وجهٌ أغرُّ وراحةٌ هتَّانُ",60,"ن",1,0],["من حالكِ اللونِ كجُنْحِ الدُّجَى","وناصعٍ يلمعُ كالكوكبِ",61,"ب",1,0],["مِن حَينِهِم أَنَّ عَكسَ الحَظَّ أَعلَقَهُم","حُتوفَهُم ما اِبتَغى مِنّا وَلا فادى",62,"د",2,0],["مِن حَديثٍ تَخَرَّصوهُ وَقَد يو","قِعُ شَكّاً عَلى الحَديثِ إِختِراصُه",63,"ص",2,0],["مِن حينِهِم أَن غَلَوا بَغياً فَغادَرَهُم","فَرطُ الغُلُوِّ لِأَطرافِ القَنا هَدَفا",64,"ف",2,0],["مِن حَيثُ دارَت دارَ يَطلُبُ وَجهَها","فِعلَ المُقاتِلِ جالَ ثُمَّ استَقبَلا",65,"ل",2,0],["مَنَحَتهُ وَهيَ شَجِيَّةٌ بِبُكائِها","وَوَفى بِضَحكِ الموثَقِ الجَذلانِ",66,"ن",1,0],["مِن حَربِ آلِ أَبي العاصي إِذا غَضِبوا","بِكُلِّ أَبيَضَ كَالمِخراقِ مَأثورِ",67,"ر",1,0],["مِن حَجِّ حافِيَةٍ وَصائِمَةٍ","سَنَتَينِ أُمِّ أُفَيرَخٍ زُعرِ",68,"ر",1,0],["منحونا إلى الحياة جواز","لم تكن قبلهم لنا أسماء",69,"ا",2,0],["مَنحنَاها القِلَى كُرهاً ولَولا","صُروفُ الدَّهرِ لم نَختَر قِلاها",70,"ا",3,0],["مَنَحَتْكَ طاعتَها القبائلُ رَهبةً","فمنحتَ جَمرَةَ عِزّها تَضريما",71,"م",2,0],["منحتُك من مَحاسِنها ربيعاً","مُقِيمَ الزَّهرِ سيَّارَ النَّسيمِ",72,"م",1,0],["منحَتْكِ أنفاسُ الصَّبا ما اسُتودِعَتْ","وسَقاكِ رَقراقُ الحَيا ما رَوَّقا",73,"ق",2,0],["من حيث لا معنىً يُعَقِّدُه","عَيّاً ولا لفظٌ يُكدِّرُه",74,"ر",2,0],["مَنحْتَ وليَّكَ النِّعَمَ اللواتي","كفَتْه كلَّ نائبةٍ تنوبُ",75,"ب",1,0],["مِن حُسنِ أَخلاقِهِم طابَت مَجالِسُهُم","لا الجَهلُ يَهروهُم فيها وَلا الصَخَبُ",76,"ب",1,0],["مَن حَسَدَ الناسَ عَلى مالِهِم","تَحَمَّلَ الهَمَّ بِأَعبائِهِ",77,"ا",3,0],["مِن حَزمِ رَأيِكَ أَلّا","تَكونَ لِلمالِ عَبدا",78,"د",2,0],["مَن حَقَّقَ الإيمانَ في قَلبِهِ","أَوشَكَ أَن يَظهَرَ تَحقيقُهُ",79,"ق",2,0],["مَن حَفِظَ العَهدَ وَفى","مَن أَحسَنَ السَمعَ فَهِم",80,"م",1,0],["مَنَحتُها مُهجَتي وَخالِصَتي","فَكانَ هِجرانُها مُكافاتي",81,"ت",2,0],["مَن حاسِرٍ بِغِرارِ العَضبِ مُلتَحِفٍ","أَو سافِرٍ بِغُبارِ الحَربِ مُلتَثِمِ",82,"م",1,0],["منحت وقد ذهبت شعاعاً غارباً","كسناك طوّافاً على السّمارِ",83,"ر",1,0],["من حق عبد الحق في عدله","له وإن يأبى إليه المسير",8