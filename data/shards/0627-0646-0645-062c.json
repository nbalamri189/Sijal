{"poems":[[88,"وقف الخلق ينظرون جميعاً","https://www.aldiwan.net/poem10675.html","الخفيف"],[102,"الآتون .. من الأزمة","https://www.poetsgate.com/ViewPoem.aspx?id=50340",""],[111,"تكب على دنياك وهي تبيد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545632",""],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122332","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95572","الخفيف"],[1574,"","https://poetry.dctabudhabi.ae/diwan/poem/124217","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100794","الخفيف"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126914","الخفيف"],[5668,"لم أعشق سواه","https://www.poetsgate.com/ViewPoem.aspx?id=179114",""]],"verses":[["إِنَّ مَجدي في الأولَياتِ عَريقٌ","مَن لَهُ مِثلَ أولَياتي وَمَجدي",0,"د",2,0],["إنّ مجابيّة الموت على","رأيهم حقّ لكلّ العالمين",1,"ن",1,0],["إن مجال الخير والشر بينها","مجال اعتبار للعقول مديد",2,"د",1,0],["ان مجنى قوم فان","الموت ليس يسوغ شربه",3,"ب",2,0],["إِن مجد التي سعت بحجاب","فوق مجد التى تعاف الحجابَا",4,"ب",2,0],["إن مج في الشرق من فيه الرضاب ترى","من عرف رياه أهل الغرب قد سكروا",5,"ر",3,0],["ان مجداً بنيته بمواضي","ك على هامة السهى ليس يهدم",6,"م",1,0],["ان مجد الأباء ورئتموه","حيث أرث الأباء للأبناء",7,"ا",2,0],["إنَّ مَجْدي كالنّيّرانِ عَتِيقٌ","في سموٍّ سَمَا مدى الآفاق",8,"ق",1,0]]}