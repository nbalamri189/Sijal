id=133059",""],[5413,"ديغول عادَ","https://www.poetsgate.com/ViewPoem.aspx?id=208605",""],[5431,"تبارك الخلدُ في عينيك يارجلُ","https://www.poetsgate.com/ViewPoem.aspx?id=186687",""],[5431,"لم تروها شفتي...","https://www.poetsgate.com/ViewPoem.aspx?id=190639",""],[5431,"حشد الرعاع ...","https://www.poetsgate.com/ViewPoem.aspx?id=202871",""],[5433,"كبوة حصان","https://www.poetsgate.com/ViewPoem.aspx?id=36765",""],[5458,"لا أحب الآفلين","https://www.poetsgate.com/ViewPoem.aspx?id=72400",""],[5533,"دُوْمَا في القَلْب","https://www.poetsgate.com/ViewPoem.aspx?id=176715",""],[5561,"ومضة شوق","https://www.poetsgate.com/ViewPoem.aspx?id=193806",""],[5573,"ياذيب ياذيب يالي تكتب وتقرا","https://www.poetsgate.com/ViewPoem.aspx?id=202126",""],[243,"مفضوحة لم تبق طي خفاء","https://www.poetsgate.com/ViewPoem.aspx?id=50474",""],[5674,"هزوا بجذع قصائدي","https://www.poetsgate.com/ViewPoem.aspx?id=185185",""],[5674,"لو جئت طيفا أمطرت غيماتي","https://www.poetsgate.com/ViewPoem.aspx?id=185900",""],[5691,"سفارة فوق الدماء","https://www.poetsgate.com/ViewPoem.aspx?id=206030",""],[5736,"عنقاء","https://www.poetsgate.com/ViewPoem.aspx?id=208246",""],[5748,"أرض منمنمة وظل سجسج","https://www.poetsgate.com/ViewPoem.aspx?id=26140",""],[5751,"المعشوق والعاشق","https://www.poetsgate.com/ViewPoem.aspx?id=214763",""],[5751,"مرسوم كوني بنرجسية شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=214785",""],[5756,"الجريمة","https://www.poetsgate.com/ViewPoem.aspx?id=5418",""],[5776,"أطوارُ ......عنكبوت الهولوكوست","https://www.poetsgate.com/ViewPoem.aspx?id=199338",""],[5781,"هاتها نصفَ وسادةٍ وقلب","https://www.poetsgate.com/ViewPoem.aspx?id=202834",""],[5891,"أحلام الموتى","https://www.poetsgate.com/ViewPoem.aspx?id=39927",""],[5894,"إن الفضيلة في الزمان تراد","https://www.poetsgate.com/ViewPoem.aspx?id=131439",""],[5897,"همسات لحظة","https://www.poetsgate.com/ViewPoem.aspx?id=156243",""],[5973,"إسمحي لي بالموت بين يديك","https://www.poetsgate.com/ViewPoem.aspx?id=14391",""],[6008,"المكوك","https://www.poetsgate.com/ViewPoem.aspx?id=61067",""],[6048,"أُحِبكَ وهَذِه ِ قُبلتِي","https://www.poetsgate.com/ViewPoem.aspx?id=198123",""],[6078,"نيليّة الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=202774",""],[6093,"أطلق سبيلي يا مدير","https://www.poetsgate.com/ViewPoem.aspx?id=197904",""],[6144,"نسوان","https://www.poetsgate.com/ViewPoem.aspx?id=13697",""],[5309,"ألشعر عاطفة بروحك تلمع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573519",""],[6300,"نقش قديم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82860&r=&rc=31",""],[5164,"أنت الطريق..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75657&r=&rc=11",""],[6317,"دموع التاريخ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86079&r=&rc=4",""]],"verses":[["وَالحُرُّ إِمّا شِئتَ تَملِكُهُ","بِالمَنِّ يُملَكُ لَيسَ بِالثَمَنِ",0,"ن",1,0],["وَالحُرُّ مِن حَذَرِ الهَوا","نِ يُزايلُ الأَمرَ الجَسيما",1,"م",2,0],["وَالحُرُّ تُنهِضُهُ إِمّا شَجاعَتُهُ","إِلى المُلِمِّ وَإِمّا خَشيَةُ العارِ",2,"ر",1,0],["وَالحَربُ في لَهَبٍ وَالقَومُ في حَرَبٍ","قَد مَدَّ نَقعُ المَنايا فَوقَهُم طُنُبا",3,"ب",2,0],["والحَرْبُ قد رَكِبَتْ حَدْباءَ نافِرَة ً","حَلّتْ على طَبَقٍ مِنْ ظَهرِها عارِ",4,"ر",1,0],["والحرب أغنت أناساً غنيةً عَجَباً","وآخرين رمتهم بالمجاليح",5,"ح",1,0],["وَالحِرصُ في الرِزاقِ وَالأَرزاقِ قَد قُسِمَت","بَغِيُ أَلّا إِنَّ بَغيَ المَرءِ يَصرَعُهُ",6,"ع",2,0],["والحُرُّ لا يقطعُ في حالة","عاداتِ جدواهُ وإجدائِهِ",7,"ا",3,0],["والحربُ تَعْذِمُ بالسيوف مُدِلَّةً","دَلّاً على الخُطَّابِ غيرَ مَلِيحِ",8,"ح",1,0],["والحر من أضحى وقرَّةُ عينه","في المال ينقُص والعلا تزدادُ",9,"د",1,0],["والحريرِ الحرّ والعُصْ","فر مرفضِّ الشرار",10,"ر",1,0],["والحر ما استنفرتَه نافرٌ","ولو تلقّى أنفه جدعه",11,"ع",2,0],["والحربُ تغلي بالكُماةِ قدورَها","والموتُ يأكلُ ما طهتْه نشيلا",12,"ل",2,0],["والحرُّ يسغَبُ دهراً وهو ذو سَعةٍ","والعَفُّ يَطوِي زَماناً وهو سَغبان",13,"ن",1,0],["والحربُ تضرمها فينا حوادثُه","حتى نُرَى بين مضروبٍ ومطعون",14,"ن",1,0],["والحرُّ أَحصرُ حين يَفْخرُ غيرهُ","أبداً وأحضرُ شاهداً وبَراهنا",15,"ن",2,0],["وَالحَربُ لا تَنفَكُّ بَينَهُما وَلا","يَنفَكُّ هَذا المَرءُ في حَسَراتِهِ",16,"ت",2,0],["وَالحَربُ بَيني وَبَينَهُم نَشَبَت","حَربٌ وَلَكِن سِهامَها الوَرَقُ",17,"ق",1,0],["وَالحَربُ حِرفَتُنا وَبِئسَت حِرفَةٌ","إِلّا لِمَن هُوَ في الوَغى مِقدامُ",18,"م",1,0],["وَالحَربُ لا عَقلٌ لَها فَتَسومُها","ما يَنبَغي مِن خُطَّةٍ وَسُلوكِ",19,"ك",1,0],["والحرّ من مارج النار التي صعدت","والماء كوّن فيه الدود والسمكُ",20,"ك",1,0],["والحرف الأحمر نار لنا","حمراء فيها الحر واليبسَ",21,"س",1,0],["والحر وهو النور من شأنه","في سائر الأحوال أن يعتلي",22,"ل",2,0],["وَالحَربُ مُشعَلَةٌ تَغلي مَراجِلُها","حيناً وَيَضرَمُ ذاكي جَمرِها حينا",23,"ن",2,0],["وَالحُرُّ لا يَرأَمُ الصِغارَ إِذا","سيمَ الأَذى أَو نَبا بِهِ وَطَنُه",24,"ن",2,0],["وَالحُرُّ يُظهِرُ لِلعَدُو","وِ صَداقَةً عِندَ الضُرورَة",25,"ر",2,0],["والحربُ تحرق حوليه نواجذها","ناشَتْهُ بالعضّ حتى كاد يُلْتَهمُ",26,"م",1,0],["وَالحَربُ من بيضِ الذُّكورِ كَأنَّما","باضَتْ بِهِنَّ رقائِدٌ في الفَدفَدِ",27,"د",1,0],["والحَربُ في حَربِيّةٍ نيرانُها","تَطأُ المياهَ بشدَّةِ الإِيعادِ",28,"د",1,0],["وَالحَربُ تَعلَمُ حينَ تَجهَلُ غارَةٌ","تَغلي عَلى حَطَبِ القَنا المَحطومِ",29,"م",1,0],["وَالحَربُ تَركَبُ رَأسَها في مَشهَدٍ","عُدِلَ السَفيهُ بِهِ بِأَلفِ حَليمِ",29,"م",1,0],["وَالحُرُّ يَسلُبُهُ جَميلَ عَزائِهِ","ضيقُ المَحَلِّ فَكَيفَ ضيقُ المَذهَبِ",30,"ب",1,0],["وَالحَربُ قائِمَةٌ في مَأزِقٍ لَجِجٍ","تَجثو القِيامُ بِهِ صُغراً عَلى الرُكَبِ",31,"ب",1,0],["وَالحُرفَةَ القُدمى وَأَنَّ عَشيرَنا","زَرَعوا الحُروثَ وَأَنَّنا لا نَزرَعُ",32,"ع",1,0],["والحرب ما لم تكن منهم فوارسها","فالجيش كالنقع والأسياف كالخلل",33,"ل",1,0],["وَالحُرُّ يُعطيكَ عَفواً مِن فَواضِلِهِ","قَبلَ السُؤالِ وَسَيبُ العَبدِ مَنكودُ",34,"د",1,0],["وَالحُرُّ في أَوطانِهِ مُتَغَرِّبٌ","فَتَظَنُّهُ في مِصرِهِ بِوَبارِ",35,"ر",1,0],["وَالحُرُّ يُجزي بِالصَنيعَةِ مُسدِياً","فَكَأَنَّ فِعلَهُما نِكاحُ شِغارِ",36,"ر",1,0],["وَالحَرْبُ لَوْ عَلِمَتْ بأساً تَصُولُ بِهِ","ما هَيَّجَتْ مِنْ حُمَيَّاكَ الَّذي اهْتاجا",37,"ج",2,0],["وَالحُرُّ لا يَكْتَفي مِنْ نَيْلِ مَكْرُمَةٍ","حَتَّى يَرُومَ الَّتي مِنْ دُونِهَا الْعَطَبُ",38,"ب",1,1],["وَالحر إن سيم خسفاً في الحياة أَبى","تباً لمن ناله ضيم وما غضبا",39,"ب",2,0],["وَالحرب تزداد يوماً","من بعد يومٍ ضراما",40,"م",2,0],["وَالحر كالعبد قد ماتَت حماسته","وَالصادق القول مثل الكاذب الأشر",41,"ر",1,0],["وَالحَربُ مِن شَرَفِ الشُعوبِ فَإِن بَغَوا","فَالمَجدُ مِمّا يَدَّعونَ بَراءُ",42,"ا",2,0],["وَالحَربُ يَبعَثُها القَوِيُّ تَجَبُّراً","وَيَنوءُ تَحتَ بَلائِها الضُعَفاءُ",42,"ا",2,0],["والحرب في حق لديك شريعة","ومن السموم الناقعات دواء",43,"ا",2,0],["وَالحِرْصُ إِنْ يَغْدُ شُحّاً بَاءَ صَاحِبُهُ","بِالعَارِ طَالَ بِهِ مُكْثٌ أَوِ انْصَرَفَا",44,"ف",2,0],["وَالحَرَّ وَالْبَردَ أَعْمَلْ","نَ وَالثَّرَى وَالهَواءَ",45,"ا",2,0],["وَالحُرُّ يَكفيهِ الزَمانُ مُؤَدِّباً","شرُّ العَبَدّى مِن تُؤَدِّبُهُ العَصا",46,"ص",2,0],["والحُرُّ لا يَنْعَمُ في وَفْرِه","حتى يَنالَ الأحْداثُ عن قَدْرِه",47,"ر",2,0],["والحربُ تبدأ كالحَصاة بزاخرٍ","لم يُدْرَ إنْ قُذفَتْ مدَى مُنداحها",48,"ح",3,0],["والحربُ قائمةٌ على سيقانها","يجري الصعيد بها دمًا وصديدا",49,"د",2,0],["والحرُّ يُنصفُهُ تاريخهُ، وكفى","بالذِّكْر خُلدًا، وبالتاريخ مِيزَانا!",50,"ن",2,0],["والحُرُّ مَنْ حَمَل الحَياةَ بمَنْكِبٍ","كالطّوْدِ لا يَشْكُو من الأثْقالِ",51,"ل",1,0],["والحرُّ ما استنفزتَه نافرٌ","ولو تلقَّى أنفُه جدْعه",52,"ع",2,0],["وَالحِرصُ في الرِزقِ وَالأَرزاقِ قَد قُسِمَت","بَغِيُ أَلا إِنَّ بَغيَ المَرءِ يَصرَعُهُ",53,"ع",2,0],["والحر يبصر في الزمان غرائبا","نكدا يكاد لها يذوب الجلمد",54,"د",1,0],["والحرّ كالتبر مهما كان موضعه","فليس يصدأ بالأعراض جوهره",55,"ر",2,0],["والحرُّ يلقىَ بالرضا حكمَ القضا","وإذا استفزتهُ الطبيعةُ يكتمُ",56,"م",1,0],["والحرُ لا يرضى الدنايا مركباً","ويرى البقاء مع الهوان هلاكا",57,"ك",2,0],["وَالحَربُ لا تُجنيكَ أَرياً غِبُّها","إِلّا إِذا أَجنَت عِداكَ الحَنظَلا",58,"ل",2,0],["وَالحَربُ ما بَرِحَت سِجالاً في الوَغى","مَدَداً فَغودِرَتِ الحُقوقُ قِتالا",59,"ل",2,0],["والحرب تبعث منها كلَّ معترك","حفائظاً تترك الأعداءَ في حرب",60,"ب",1,0],["والحرُّ مثل الجام ما أودعته","أبصرت باطنه بظهر الجام",61,"م",1,0],["والحربُ تَنكِحُ والنفوسُ مهورُها","ما بينَ أبكارٍ تُزَفُّ وعُونِ",62,"ن",1,0],["والحرّ تسهلُ فيه كلّ شديدة","ويهونُ أصبعهُ إذا لم يعرق",63,"ق",1,0],["والحر فيها ناحل","والنذل فيها قد تحبّر",64,"ر",1,0],["والحرّ سهلٌ طبعه","مستسلم سلس قياده",65,"د",2,0],["والحرُّ موؤودٌ به","كالسرِّ في قلب الكتوم",66,"م",1,0],["والحُرُّ نُشبعهُ أذىً ونُذيقهُ","سوءَ العذابِ ولا يزالُ يُعاني",67,"ن",2,0],["والحربُ قد نشَرَتْ مُلاءَ عَجاجةٍ","بسنابكِ الجُرْدِ الصَّلادم تُنْسَجُ",68,"ج",1,0],["والحرّ من لا تنقُصُ ال","أيام ما هو عاقِد",69,"د",1,0],["وَالْحَرُّ لَوْ يَحْظَى بِنَا","أَبَثَّنَا مَكْنُونَهْ",70,"ن",2,0],["والحرُّ يدعوهُ الضميرُ إلى النَّدى","ماذا تقولُ وفِعلُكَ التَّصديق",71,"ق",1,0],["وَالحرب قامَت عَلى ساق به وَسمت","اذقام منتقما من كل أَفاك",72,"ك",1,0],["والحرّ في ظلم القبور","خير من الملك الأسير",73,"ر",1,0],["والحروب ما تعلمون فوضى","تغرى بأسلوبها العجيب",74,"ب",1,0],["والحرّ تخلقُه الخطو","ب ولا يُنهنَهُ بالخطوب",75,"ب",1,0],["والحر ان يبصر رني","ن القيد ثار على رنينه",76,"ن",2,0],["والحرُّ يُلزِمُهُ تَكرُّمُهُ","ما ليس يَلزَمُهُ فيَلْتَزِم",77,"م",1,0],["وَالحُرُّ فيهِ صابِرُ عِتادُهُ","عَقدُ عِرا أَغوارِهِ بِالأَنجُدِ",78,"د",1,0],["والحر يتركن فليس حرا","ينضحن ماء البدن العسرا",79,"ر",2,0],["وَالحَر لا يَسبيهِ مُبتَذَلٌ","وَإِلى جَمال الدون لا يَصبو",80,"ب",2,0],["وَالحَرُّ لا يَهدي الحرا","مَ إِلى الرِجالِ عَلى طَبَق",81,"ق",1,0],["وَالحَربُ بَينَ صَرائِمي وَصَوارِمي","اِن جا طحونُ رحائها بزبونِ",82,"ن",1,0],["والحُرُّ من يهجرُ ما يشتهي","صيانةً للعرضِ والجاهِ",83,"ه",1,0],["والحرُّ إنْ حاوَلَ أمنيَّة","حاولها فوق الجياد العتاق",84,"ق",1,0],["والحرب قائمة والنار موْقدة","يقول منها جَبانُ القوم واحَربي",85,"ب",2,0],["والحرب قائمة منهم على قدم","والنقع يكحل عين الشمس بالحور",86,"ر",1,0],["والحرّ يطرب حيث صادية الظبا","تروى وساغبة القشاعم تشبع",87,"ع",1,0],["والحراقى لحنبل فاقرأ","كي تكُنْ فاضلاً كثيرَ الجدالِ",88,"ل",1,0],["والحربُ قائِمَةٌ تَغَصُّ بِنَقْعِها","لَمحاً بنارِ المشرَفِيَّةِ مُوقَدا",89,"د",2,0],["والحر حر لا يغي","ير حسن جوهره 