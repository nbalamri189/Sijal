,"ن",1,0],["نُثني عَليكَ ثَناءَ راعي هَجمَةٍ","بَعدَ الجُدوبِ عَلى الغَمامِ المُقلِعِ",1,"ع",1,0],["نَثَلوا كَنائِنَ مَجدِهِم فَتَخَيَّروا","مِنهُنَّ أَقوَمَ نَصلَةٍ لا تُنزَعُ",2,"ع",1,0],["نَثَرَت عَلى بَيضِ الكُماةِ دَراهِماً","فَنُثِرنَ ضَرباً وَهيَ لَم تَتَنَثَّرِ",3,"ر",1,0],["نَثَرنَ عَلَيها سَوادَ القُلوبِ","وَكانَ الهَنا في خِلالِ النِثارِ",4,"ر",1,0],["نَثَرَت فَرائِدَها فَنَظَّمَتِ الرُبى","مِن دَرِّهِنَّ قَلائِداً وَعُقودا",5,"د",2,0],["نَثَروا عَلَيكَ نَوادِيَ الأَزهارِ","وَأَتَيتُ أَنثُرُ بَينَهُم أَشعاري",6,"ر",2,1],["نَثَرَ السُعودَ عَلى الوُفودِ وَحَولَهُ","يَتَجاوَبُ التَكبيرُ وَالتَهليلُ",7,"ل",1,0],["نَثَرتُ مَنظومَ تيجانِ المُلوكِ بِها","فَراحَ يَنظِمُهُ في وَصفِكَ البالُ",8,"ل",1,0],["نَثَرَت لَوعَةُ الفراقِ عَلَيهِ","دُرَّ دَمعٍ فَأَنبَتَت فيهِ وَردا",9,"د",2,0],["نَثرنا عَلى الوادي رُؤوساً أَعزَّةً","لِكُلِّ أَخي بَأسٍ مَنيعٍ جِنابُهُ",10,"ب",2,0],["نَثْرٌ مِنَ الجَزْلِ الَّذِي أَسْلُوبُهُ","يَلِجُ النُّفُوسَ بِغَيْرِ مَا اسْتِئْذَانِ",11,"ن",1,0],["نَثْرٌ فُنُونُ الْحِلَى فِيهِ مُوَزَّعَةٌ","بَيْنَ المَشَاهِدِ وَالآرَاءِ وَالْحِكَمِ",12,"م",1,0],["نُثيرُ بِها نَقعَ الكُلابِ وَأَنتُمُ","تُثيرونَ قيعانَ القُرى بِالمَعازِقِ",13,"ق",1,0],["نثر الربيع بهنّ زهراً مؤنقاً","يزري بنظم قلائد العقيان",14,"ن",1,0],["نثر الظالمون في الأرض منهم","جُثَثاً تملأ الفضاء وهاما",15,"م",2,0],["نثَل الجفيرَ فكنت أهْ","زَعَ ما تَضمَّنه الجفيرُ",16,"ر",1,0],["نثرتْ عليكَ ثناءَها فكأنما","نثرتْ من المسكِ الذكيّ مخازِنا",17,"ن",2,0],["نَثَرتُ دُرّ القَريض نَثراً","يَقومُ ذهني لَهُ بِسِلكِ",18,"ك",1,0],["نثرنها يد الطبيعة جلت","عن شبيه في تلكم الأبعاد",19,"د",1,0],["نَثرَ الكِنانَةَ رَبُّها وَتَخَيَّرَت","يَدُهُ لِنُصرَتِها ثَلاثَةَ أَسهُمِ",20,"م",1,0],["نَثَرَ الفَضاءُ عَلَيهِ عِقدَ نُجومِهِ","فَبَدا زَبَرجَدُهُ بِهِنَّ مُجَوهَرا",21,"ر",2,0],["نَثَرتَهُمُ فَوقَ الأُحَيدِبِ كُلِّهِ","كَما نُثِرَت فَوقَ العَروسِ الدَراهِمُ",22,"م",1,0],["نُثني عَلَيهِ وَلَم يَكُن إِثناؤُنا","قَولاً يُعارُ وَلا حَديثاً يُفتَرى",23,"ر",2,0],["نَثَرتَ الأَخِلّاءَ نَثرَ الجُما","نِ وَأَنفَقتَهُم حينَ تَمّوا بِدارا",24,"ر",2,0],["نُثني عَلَيهِ بِأَنعُمٍ سَلَفَت","أَصغَرُها في النُفوسِ أَكبَرُها",25,"ر",3,0],["نثرنا، شعرنا، جرائدنا الصفراء","والحبر والحروف الإماء",26,"ا",2,0],["نَثرْتَ على الخليجِ الهامَ حتّى","كأنَّ حَصى الخليجِ طُلىً وهامُ",27,"م",1,0],["نثني عليه وجوده أطواقنا","مثل الحمام سجعن في الأطواق",28,"ق",1,0],["نَثَرَتْ يَدُ الأرياحِ لُؤلُؤَ ثَلْجِه","فَبدا بأجيادِ الغُصونِ مُرَصَّعا",29,"ع",2,0],["نثرَتْ فَريدَ الدَّمْعِ حينَ رَأَتْ","صَبّاً يُقادُ إلى الرَّدى نَثرا",30,"ر",2,0],["نَثَرْتَ عليها البَقْلَ غَضّاً كأنما","نَثَرْتَ على حُرِّ اللُّجَيْنِ الزَّبَرْجَدا",31,"د",2,0],["نثرَتْ رياحَ الشَّوق في وَجَناتِها","من نَرْجِس فوقَ الخُدودِ فَرائِدا",32,"د",2,0],["نَثَرَ الجوُّ على الأرْضِ بَرَدْ","أيّ دُرٍّ لنحورٍ لو جَمَدْ",33,"د",1,1],["نَثَرَت فَريدَ مَدامِعٍ لَم يُنظَمِ","وَالدَمعُ يَحمِلُ بَعضَ ثِقلَ المُغرَمِ",34,"م",1,1],["نَثا خَبَرٌ كَأَنَّ القَلبَ أَمسى","يُجَرُّ بِهِ عَلى شَوكِ القَتادِ",35,"د",1,0],["نَثَرتُ فِيها فَرِيدَ المَدحِ فَاِنتَظَمَت","أَحسِن بِمُنتَثِرٍ مِنها وَمُنتَظِمِ",36,"م",1,0],["نثرتُ عليكَ الدمعَ يومَ فراقنا","كما نُثرَتْ فوقَ العروسِ الدراهمُ",37,"م",1,1],["نثرَ الجنوبَ بل القلوبَ بسوطِهِ","فمتى أشاهدُ لؤلؤاً منثورا",38,"ر",2,0],["نَثّوا أَحاديثَ لَم أَسمَع تَحاوُرَها","وَزادَ فيها رِجالٌ غَيظَنا قَرِبوا",39,"ب",3,0],["نَثَرَت بِحِجرِ الأَرضِ فيهِ يَدُ الصِبا","دُرَرَ النَدى وَدَراهِمَ النُوّارِ",40,"ر",1,0],["نَثَرَت بِحِجرِ الرَوضِ فيهِ يَدُ الصَبا","دُرَرَ النَدى وَدَراهِمَ الأَنوارِ",41,"ر",1,0],["نَثَلَت بِهِ زُرقُ النِطافِ سَوابِغاً","زُرقاً وَجَرَّدَتِ الشِعابُ شِفارا",42,"ر",2,0],["نَثَرتهمُ الأقدارُ شرّاً شائعاً","أمسى على يده يُضَمُّ ويُنْظَمُ",43,"م",1,0],["نُثبِّتُ مِن جوانِحنا وتهفو","بهنَّ زلازلٌ ما يَرْعَوينا",44,"ن",2,0],["نَثُلُّ عُروشَ جَبّارينَ غُلباً","وَنَجتَثُّ المَمالِكَ فاتِحينا",45,"ن",2,0],["نُثِرَتْ فوقها الديا","رُ كما يُنثر الزَّهَرْ",46,"ر",1,0],["نَثْرَةٌ مِن ضَمانِها للقَنا الخَطْ","طِيّ عندَ اللّقاءِ نَثْرُ الكُعوب",47,"ب",1,0],["نثقبها بالثُّغُورِ مِن لُطُفٍ","حَسْبُكَ منَّا ببِرِّ مَن لَطُفَا",48,"ف",2,0],["نَثْنِي عَلَيْكِ وَهَلْ يُكَافِيءُ","بَعْضَ مِنَّتِكِ الثَّنَاءْ",49,"ا",2,1],["نَثْرٌ بَلَغْتَ بِهِ الإِمَا","مَةَ مَن تَلاَه فَقَد تَلاَكْ",50,"ك",1,0],["نُثْنِي وَهَلْ يُوفَى ثَنَاؤُكَ حَقَّهُ","وَبِأَيِّ أَلْفَاظِ المَحَامِدِ يُكْتَفَى",51,"ف",2,0],["نَثرُ دُموعٍ وَنَظمُ شِعرٍ","مَلآن مِن جَوهَرِ المَعاني",52,"ن",2,0],["نثرتها من جراحات مضمدة","ومن منى ليس لي في جودها وطر",53,"ر",1,0],["نَثَرُوا كنانَتَهُمْ وكُلَّ سِهامِها","لِلْفَتْكِ والتَدْمِيرِ والإِهْلاكِ",54,"ك",1,0],["نَثَرَ النيلُ فيك تِبراً وأوْهَى","لِينُهُ من قسَاوةِ الْجُلمودِ",55,"د",1,0],["نَثْرتَ بُذُورَ الْحُبِّ في كُل مُهْجَةٍ","وَتِلْكَ التي تَهْفُو إِليكَ سَنَابِلُهْ",56,"ل",2,0],["نَثَرُوا جَمْعَهم فأبْصَرْتُ فِيهم","أنجُماً في الفَضَاءِ مُنْتَثِرَاتِ",57,"ت",1,0],["نثرتُ له زَهْراً وأنظمتُ لؤلؤاً","فأحسنتُ في نثري وأبدعتُ في نظْمي",58,"م",2,0],["نَثَرَ الربِيعُ بِكَ الْوُروُ","دَ نَضِيرَةً وَنَثرْتُ وَرْدِي",59,"د",2,0],["نثرتْ دُرَّها الفَريدَ فكانوا","أسْرعَ الناسِ في الْتِقاطِ الجُمانِ",60,"ن",1,0],["نثقل إِذْ نبغي بلفظك طبنا","من الْهم والجسم الشريف نحيل",61,"ل",1,1],["نَثرُوا فَوْقَهُ الوُرُودَ، فغطَّى","من شذاءُ على أريج الورود",62,"د",1,0],["نثرنا الورود على قبره","فقطَّرَ طيبُ ثراه الورودا",63,"د",2,0],["نثروا الزهورَ، وقمتُ أنثر بينهم","شعري. وشعري طارفي، وتلادي",64,"د",2,0],["نِثَارُها من لؤُلؤ مُذَاب","موجُك -مثلُ الدهر- في انقلاب",65,"ب",1,0],["نَثَرتَهُمُ فَوقَ الأُحَيدِبِ نَثْرَةً","كَما نُثِرَت فَوقَ العَروسِ الدَراهِمُ",66,"م",1,0],["نثرتَ لهُ شُمَّ المتالعِ والقُرى","كما نَثَرَ الصيَّادُ للطَّائرِ الحَبَّا",67,"ب",2,0],["نثرت اللاءلي من دموعي قلائدا","اليك وشعري فيه در منضد",68,"د",1,0],["نَثَرَ الكُتبَ فهى دُرٌّ نَثِيرٌ","يُبهِرُ العَقلَ فَوقَ دُرٍّ نَثِيرِ",69,"ر",1,0],["نثرت عيوني أبحراً من أدمعي","هذا وجمرُ صبابتي لم يُخمدِ",70,"د",1,0],["نُثيرُ عَلى الباقينَ مَجنى ضَغينَةٍ","فَوَيلٌ لَهُم إِن مِتَّ مِن شَرِّ ما تَجني",71,"ن",2,0],["نُثني بِآلاءِ مَن وَلّاكَ نُصرَتَنا","فَشادَ إِقدامُكَ العِزَّ الَّذي دَثَرا",72,"ر",2,0],["نثني عليك بحا