{"poems":[[53,"ضلالا لسائل هذي المغاني","https://www.aldiwan.net/poem29720.html","المتقارب"],[53,"لو كان يرتدع القضاء بمردع","https://www.aldiwan.net/poem30148.html","الكامل"],[53,"تمضي العلى وإلى ذراكم ترجع","https://www.aldiwan.net/poem30156.html","الكامل"],[53,"يا حبذا فوق الكثيب الأعفر","https://www.aldiwan.net/poem30452.html","الرجز"],[53,"لبست الوغى قبل ثوب الغبار","https://www.aldiwan.net/poem30457.html","المتقارب"],[53,"من كل سارية كأن رشاشها","https://www.aldiwan.net/poem30496.html","الكامل"],[86,"نثروا عليك نوادي الأزهار","https://www.aldiwan.net/poem10492.html","الكامل"],[86,"في ساحة البدوي حلت ساحة","https://www.aldiwan.net/poem68926.html","الكامل"],[86,"قالوا صدقت فكان الصدق ما قالوا","https://www.aldiwan.net/poem68960.html","البسيط"],[71,"خبروها بأنه ما تصدى","https://www.aldiwan.net/poem4014.html","الخفيف"],[71,"عسى البارق الشامي يهمي سحابه","https://www.aldiwan.net/poem4026.html","الطويل"],[93,"ألغرس غرسك أيها البستاني","https://www.aldiwan.net/poem11219.html","الكامل"],[93,"نهاية الفخر لي في هذا الكلم","https://www.aldiwan.net/poem11309.html","البسيط"],[30,"أقول لنفسي واقفا عند مشرف","https://www.aldiwan.net/poem29553.html","الطويل"],[88,"يرزت تميس كخطرة النشوان","https://www.aldiwan.net/poem44446.html","الكامل"],[88,"قال قولا به استحق احتراما","https://www.aldiwan.net/poem44825.html","الخفيف"],[51,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[51,"ولع الزمان بأن يحرك ساكنا","https://www.aldiwan.net/poem66698.html","الكامل"],[78,"يا قمرا أفقه فؤادي","https://www.aldiwan.net/poem14172.html","مخلع البسيط"],[89,"إن في أوسع الفضاء نجوما","https://www.aldiwan.net/poem45105.html","الخفيف"],[85,"في مهرجان الحق أو يوم الدم","https://www.aldiwan.net/poem62949.html","الكامل"],[85,"لا السهد يدنيني إليه ولا الكرى","https://www.aldiwan.net/poem63716.html","الطويل"],[43,"على قدر أهل العزم تأتي العزائم","https://www.aldiwan.net/poem10524.html","الطويل"],[45,"لله عهد سويقة ما أنضرا","https://www.aldiwan.net/poem63603.html","الكامل"],[45,"مجانيق شؤمك منصوبة","https://www.aldiwan.net/poem63620.html","المتقارب"],[45,"كم ليلة فيك بت أسهرها","https://www.aldiwan.net/poem63639.html","المنسرح"],[99,"إفادة في محكمة الشعر","https://www.aldiwan.net/poem6630.html","عموديه"],[61,"سحابك في السماح لها انسجام","https://www.aldiwan.net/poem51440.html","البسيط"],[61,"ليس التجلد شيمة العشاق","https://www.aldiwan.net/poem51519.html","الكامل"],[61,"أهلا به من عارض ترك الدجى","https://www.aldiwan.net/poem51560.html","الكامل"],[61,"أمن المدامة تنثني سكرا","https://www.aldiwan.net/poem51670.html","أحذ الكامل"],[61,"أناشد دهري أن يعود كما بدا","https://www.aldiwan.net/poem51709.html","الطويل"],[61,"عذر العذول فراح فيك مساعدا","https://www.aldiwan.net/poem51726.html","الكامل"],[80,"نثر الجو على الأرض برد","https://www.aldiwan.net/poem31499.html","الرمل"],[44,"نثرت فريد مدامع لم ينظم","https://www.aldiwan.net/poem30353.html","الكامل"],[44,"سقى عهد الحمى سبل العهاد","https://www.aldiwan.net/poem30558.html","الكامل"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[69,"نثرت عليك الدمع يوم فراقنا","https://www.aldiwan.net/poem28485.html","الطويل"],[69,"أشكو إلى الرحمن لؤلؤا الذي","https://www.aldiwan.net/poem28667.html","الكامل"],[31,"أمسى صديقك مما قلت قد غضبوا","https://www.aldiwan.net/poem42630.html","البسيط"],[74,"وكمامة حدر الصباح قناعها","https://www.aldiwan.net/poem12942.html","الكامل"],[74,"أذن الغمام بديمة وعقار","https://www.aldiwan.net/poem12944.html","الكامل"],[74,"ماذا عليك وقد نأيت ديارا","https://www.aldiwan.net/poem12958.html","الكامل"],[105,"لك يا شهيد الحق قام المأتم","https://www.aldiwan.net/poem42059.html","الكامل"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[105,"رويدك أيها الجبار فينا","https://www.aldiwan.net/poem43385.html","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39579","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16691","الخفيف"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30473","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54547","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55104","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55024","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43848","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/142343","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54198","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54194","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54231","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54211","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54316","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54288","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54204","الخفيف"],[72,"نثقل إِذْ نبغي بلفظك طبنا","https://www.poetsgate.com/ViewPoem.aspx?id=189421",""],[106,"في ربا الخلد","https://www.poetsgate.com/ViewPoem.aspx?id=179685",""],[106,"فقيد الفصحى!","https://www.poetsgate.com/ViewPoem.aspx?id=179487",""],[106,"زفاف الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179500",""],[106,"من وحي البحر","https://www.poetsgate.com/ViewPoem.aspx?id=179317",""],[43,"على قدر أهل العزم","https://www.poetsgate.com/ViewPoem.aspx?id=62",""],[90,"تونس","https://www.poetsgate.com/ViewPoem.aspx?id=179195",""]],"verses":[["نَثَرتَ العِدا بِدَداً بَعدَما","نَظَمتَ المَمالِكِ نَظمَ الجُمانِ",0,"ن",1,0],["نُثني عَليكَ ثَناءَ راعي هَجمَةٍ","بَعدَ الجُدوبِ عَلى الغَمامِ المُقلِعِ",1,"ع",1,0],["نَثَلوا كَنائِنَ مَجدِهِم فَتَخَيَّروا","مِنهُنَّ أَقوَمَ نَصلَةٍ لا تُنزَعُ",2,"ع",1,0],["نَثَرَت عَلى بَيضِ الكُماةِ دَراهِماً","فَنُثِرنَ ضَرباً وَهيَ لَم تَتَنَثَّرِ",3,"ر",1,0],["نَثَرنَ عَلَيها سَوادَ القُلوبِ","وَكانَ الهَنا في خِلالِ النِثارِ",4,"ر",1,0],["نَثَرَت فَرائِدَها فَنَظَّمَتِ الرُبى","مِن دَرِّهِنَّ قَلائِداً وَعُقودا",5,"د",2,0],["نَثَروا عَلَيكَ نَوادِيَ الأَزهارِ","وَأَتَيتُ أَنثُرُ بَينَهُم أَشعاري",6,"ر",2,1],["نَثَرَ السُعودَ عَلى الوُفودِ وَحَولَهُ","يَتَجاوَبُ التَكبيرُ وَالتَهليلُ",7,"ل",1,0],["نَثَرتُ مَنظومَ تيجانِ المُلوكِ بِها","فَراحَ يَنظِمُهُ في وَصفِكَ البالُ",8,"ل",1,0],["نَثَرَت لَوعَةُ الفراقِ عَلَيهِ","دُرَّ دَمعٍ فَأَنبَتَت فيهِ وَردا",9,"د",2,0],["نَثرنا عَلى الوادي رُؤوساً أَعزَّةً","لِكُلِّ أَخي بَأسٍ مَنيعٍ جِنابُهُ",10,"ب",2,0],["نَثْرٌ مِنَ الجَزْلِ الَّذِي أَسْلُوبُهُ","يَلِجُ النُّفُوسَ بِغَيْرِ مَا اسْتِئْذَانِ",11,"ن",1,0],["نَثْرٌ فُنُونُ الْحِلَى فِيهِ مُوَزَّعَةٌ","بَيْنَ المَشَاهِدِ وَالآرَاءِ وَالْحِكَمِ",12,"م",1,0],["نُثيرُ بِها نَقعَ الكُلابِ وَأَنتُمُ","تُثيرونَ قيعانَ القُرى بِالمَعازِقِ",13,"ق",1,0],["نثر الربيع بهنّ زهراً مؤنقاً","يزري بنظم قلائد العقيان",14,"ن",1,0],["نثر الظالمون في الأرض منهم","جُثَثاً تملأ الفضاء وهاما",15,"م",2,0],["نثَل الجفيرَ فكنت أهْ","زَعَ ما تَضمَّنه الجفيرُ",16,"ر",1,0],["نثرتْ عليكَ ثناءَها فكأنما","نثرتْ من المسكِ الذكيّ مخازِنا",17,"ن",2,0],["نَثَرتُ دُرّ القَريض نَثراً","يَقومُ ذهني لَهُ بِسِلكِ",18,"ك",1,0],["نثرنها يد الطبيعة جلت","عن شبيه في تلكم الأبعاد",19,"د",1,0],["نَثرَ الكِنانَةَ رَبُّها وَتَخَيَّرَت","يَدُهُ لِنُصرَتِها ثَلاثَةَ أَسهُمِ",20,"م",1,0],["نَثَرَ الفَضاءُ عَلَيهِ عِقدَ نُجومِهِ","فَبَدا زَبَرجَدُهُ بِهِنَّ مُجَوهَرا",21,"ر",2,0],["نَثَرتَهُمُ فَوقَ الأُحَيدِبِ كُلِّهِ","كَما نُثِرَت فَوقَ العَروسِ الدَراهِمُ",22,"م",1,0],["نُثني عَلَيهِ وَلَم يَكُن إِثناؤُنا","قَولاً يُعارُ وَلا حَديثاً يُفتَرى",23,"ر",2,0],["نَثَرتَ الأَخِلّاءَ نَثرَ الجُما","نِ وَأَنفَقتَهُم حينَ تَمّوا بِدارا",24,"ر",2,0],["نُثني عَلَيهِ بِأَنعُمٍ سَلَفَت","أَصغَرُها في النُفوسِ أَكبَرُها",25,"ر",3,0],["نثرنا، شعرنا، جرائدنا الصفراء","والحبر والحروف الإماء",26,"ا",2,0],["نَثرْتَ على الخليجِ الهامَ حتّى","كأنَّ حَصى الخليجِ طُلىً وهامُ",27,"م",1,0],["نثني عليه وجوده أطواقنا","مثل الحمام سجعن في الأطواق",28,"ق",1,0],["نَثَرَتْ يَدُ الأرياحِ لُؤلُؤَ ثَلْجِه","فَبدا بأجيادِ الغُصونِ مُرَصَّعا",29,"ع",2,0],["نثرَتْ فَريدَ الدَّمْعِ حينَ رَأَتْ","صَبّاً يُقادُ إلى الرَّدى نَثرا",30,"ر",2,0],["نَثَرْتَ عليها البَقْلَ غَضّاً كأنما","نَثَرْتَ على حُرِّ اللُّجَيْنِ الزَّبَرْجَدا",31,"د",2,0],["نثرَتْ رياحَ الشَّوق في وَجَناتِها","من نَرْجِس فوقَ الخُدودِ فَرائِدا",32,"د",2,0],["نَثَرَ الجوُّ على الأرْضِ بَرَدْ","أيّ دُرٍّ لنحورٍ لو جَمَدْ",33,"د",1,1],["نَثَرَت فَريدَ مَدامِعٍ لَم يُنظَمِ","وَالدَمعُ يَحمِلُ بَعضَ ثِقلَ المُغرَمِ",34,"م",1,1],["نَثا خَبَرٌ كَأَنَّ القَلبَ أَمسى","يُجَرُّ بِهِ عَلى شَوكِ القَتادِ",35,"د",1,0],["نَثَرتُ فِيها فَرِيدَ المَدحِ فَاِنتَظَمَت","أَحسِن بِمُنتَثِرٍ مِنها وَمُنتَظِمِ",36,"م",1,0],["نثرتُ عليكَ الدمعَ يومَ فراقنا","كما نُثرَتْ فوقَ العروسِ الدراهمُ",37,"م",1,1],["نثرَ الجنوبَ بل القلوبَ بسوطِهِ","فمتى أشاهدُ لؤلؤاً منثورا",38,"ر",2,0],["نَثّوا أَحاديثَ لَم أَسمَع تَحاوُرَها","وَزادَ فيها رِجالٌ غَيظَنا قَرِبوا",39,"ب",3,0],["نَثَرَت بِحِجرِ الأَرضِ فيهِ يَدُ الصِبا","دُرَرَ النَدى وَدَراهِمَ النُوّارِ",40,"ر",1,0],["نَثَرَت بِحِجرِ الرَوضِ فيهِ يَدُ الصَبا","دُرَرَ النَدى وَدَراهِمَ الأَنوارِ",41,"ر",1,0],["نَثَلَت بِهِ زُرقُ النِطافِ سَوابِغاً","زُرقاً وَجَرَّدَتِ الشِعابُ شِفارا",42,"ر",2,0],["نَثَرتهمُ الأقدارُ شرّاً شائعاً","أمسى على يده يُضَمُّ ويُنْظَمُ",43,"م",1,0],["نُثبِّتُ مِن جوانِحنا وتهفو","بهنَّ زلازلٌ ما يَرْعَوينا",44,"ن",2,0],["نَثُلُّ عُروشَ جَبّارينَ غُلباً","وَنَجتَثُّ المَمالِكَ فاتِحينا",45,"ن",2,0],["نُثِرَتْ فوقها الديا","رُ كما يُنثر الزَّهَرْ",46,"ر",1,0],["نَثْرَةٌ مِن ضَمانِها للقَنا الخَطْ","طِيّ عندَ اللّقاءِ نَثْرُ الكُعوب",47,"ب",1,0],["نثقبها بالثُّغُورِ مِن لُطُفٍ","حَسْبُكَ منَّا ببِرِّ مَن لَطُفَا",48,"ف",2,0],["نَثْنِي عَلَيْكِ وَهَلْ يُكَافِيءُ","بَعْضَ مِنَّتِكِ الثَّنَاءْ",49,"ا",2,1],["نَثْرٌ بَلَغْتَ بِهِ الإِمَا","مَةَ مَن تَلاَه فَقَد تَلاَكْ",50,"ك",1,0],["نُثْنِي وَهَلْ يُوفَى ثَنَاؤُكَ حَقَّهُ","وَبِأَيِّ أَلْفَاظِ المَحَامِدِ يُكْتَفَى",51,"ف",2,0],["نَثرُ دُموعٍ وَنَظمُ شِعرٍ","مَلآن مِن جَوهَرِ المَعاني",52,"ن",2,0],["نثرتها من جراحات مضمدة","ومن منى ليس لي في جودها وطر",53,"ر",1,0],["نَثَرُوا كنانَتَهُمْ وكُلَّ سِهامِها","لِلْفَتْكِ والتَدْمِيرِ والإِهْلاكِ",54,"ك",1,0],["نَثَرَ النيلُ فيك تِبراً وأوْهَى","لِينُهُ من قسَاوةِ الْجُلمودِ",55,"د",1,0],["نَثْرتَ بُذُورَ الْحُبِّ في كُل مُهْجَةٍ","وَتِلْكَ التي تَهْفُو إِليكَ سَنَابِلُهْ",56,"ل",2,0],["نَثَرُوا جَمْعَهم فأبْصَرْتُ فِيهم","أنجُماً في الفَضَاءِ مُنْتَثِرَاتِ",57,"ت",1,0],["نثرتُ له زَهْراً وأنظمتُ لؤلؤاً","فأحسنتُ في نثري وأبدعتُ في نظْمي",58,"م",2,0],["نَثَرَ الربِيعُ بِكَ الْوُروُ","دَ نَضِيرَةً وَنَثرْتُ وَرْدِي",59,"د",2,0],["نثرتْ دُرَّها الفَريدَ فكانوا","أسْرعَ الناسِ في الْتِقاطِ الجُمانِ",60,"ن",1,0],["نثقل إِذْ نبغي بلفظك طبنا","من الْهم والجسم الشريف نحيل",61,"ل",1,1],["نَثرُوا فَوْقَهُ الوُرُودَ، فغطَّى","من شذاءُ على أريج الورود",62,"د",1,0],["نثرنا الورود على قبره","فقطَّرَ طيبُ ثراه الورودا",63,"د",2,0],["نثروا الزهورَ، وقمتُ أنثر بينهم","شعري. وشعري طارفي، وتلادي",64,"د",2,0],["نِثَارُها من لؤُلؤ مُذَاب","موجُك -مثلُ الدهر- في انقلاب",65,"ب",1,0],["نَثَرتَهُمُ فَوقَ الأُحَيدِبِ نَثْرَةً","كَما نُثِرَت فَوقَ العَروسِ الدَراهِمُ",66,"م",1,0],["نثرتَ لهُ شُمَّ المتالعِ والقُرى","كما نَثَرَ الصيَّادُ للطَّائرِ الحَبَّا",67,"ب",2,0]]}