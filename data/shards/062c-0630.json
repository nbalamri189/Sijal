 شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[458,"من دل ربات العيون النجل","https://www.aldiwan.net/poem56067.html","الرجز"],[458,"سلك الخيال بحاجر","https://www.aldiwan.net/poem56096.html","مجزوء الكامل"],[458,"فكاكك أيها القلب الأسير","https://www.aldiwan.net/poem56202.html","الوافر"],[458,"نبهته فقام مشبوح العضد","https://www.aldiwan.net/poem56228.html","الرجز"],[458,"نظرة منك ويوم بالجريب","https://www.aldiwan.net/poem56280.html","الرمل"],[461,"جمعت لك الأوصاف غير منازع","https://www.aldiwan.net/poem15675.html","الكامل"],[477,"أعرفت من داء الصبابة شافيا","https://www.aldiwan.net/poem15185.html","الكامل"],[500,"أجتلى نور وجهه فأذب","https://www.aldiwan.net/poem37636.html","الخفيف"],[500,"ظهر بأعباء الغرام قد انحنى","https://www.aldiwan.net/poem37761.html","الكامل"],[500,"أأم عبيدة أقلقت ركبي","https://www.aldiwan.net/poem37932.html","الوافر"],[500,"رغبنا بأسرار الشهود لوجهكم","https://www.aldiwan.net/poem38082.html","الطويل"],[500,"رقمت في معارفي الأشياء","https://www.aldiwan.net/poem38098.html","الخفيف"],[504,"أفنى الضنا جسدي وابلى بالي","https://www.aldiwan.net/poem38411.html","الكامل"],[515,"إذا قدرت على العلياء بالغلب","https://www.aldiwan.net/poem12009.html","البسيط"],[515,"يا خير من نظم المديح لمجده","https://www.aldiwan.net/poem12063.html","الكامل"],[551,"ما رأتني عيناك يوم الفراق","https://www.aldiwan.net/poem47357.html","الخفيف"],[551,"لقد ضل من يسترق الهوى","https://www.aldiwan.net/poem48120.html","المتقارب"],[558,"انظر الكل لطيفا","https://www.aldiwan.net/poem34353.html","مجزوء الرمل"],[561,"جاري لا تستنكري عذيري","https://www.aldiwan.net/poem27842.html","الرجز"]],"verses":[["جَذِلاً وَلِلحُسّادِ مِن","أَسَفٍ زَفيرٌ أَو أَنينُ",0,"ن",1,0],["جَذَبتَ عَنِ الغَيِّ أَرسانَها","وَقَد شا فَهَتها المَنايا الدَواني",1,"ي",1,0],["جَذَبتَ عَنِ المُطيعِ زِمامَ عِزٍّ","أَطاعَ الوَخدُ مِنهُ وَالرَسيمُ",2,"م",1,0],["جَذلانُ تُطلِعُ مِنهُ أَندِيَةُ العُلى","وَجهاً كَريمَ الخَدِّ غَيرَ مُلَطَّمِ",3,"م",1,0],["جَذَبتُ حَبلي مِن يَدَي قاطِعٍ","فَاِمدُد لَهُ مِنكَ يَدَي واصِلِ",4,"ل",1,0],["جَذلانُ يَنفُضُ مِن فُروجِ قَميصِهِ","أَعطافَ غُصنِ البانَةِ المَطلولِ",5,"ل",1,0],["جَذلانَ تَقطُرُ نِعمَةً أَيّامُهُ","لِلطالِبينَ فَراغِبٌ وَمُؤَمِّلُ",6,"ل",1,0],["جَذَبتَ مِن لَهَواتِ المَوتِ مُهجَتَهُ","وَكانَ يَطرِفُ في الدُنيا عَلى وَجَلِ",7,"ل",1,0],["جَذلانُ يَرقُصُ في الرُؤوسِ إِذا","غَنَّتهُ بِالصَهَلاتِ سُبَّقُهُ",8,"ق",2,0],["جَذَبَت بِضَبعي مِن تِهامَةَ قاصِداً","وَالنَجمُ في بَحرِ الظَلامِ غَريقُ",9,"ق",1,0],["جَذَبَتهُ في شَطَنِ المَنو","نِ يَدُ النَآدِ العَنقَفيرِ",10,"ر",1,0],["جَذلانَ يَنظُرُ وَجهَهُ","في عارِضِ العَضبِ الشَهيرِ",10,"ر",1,0],["جَذَبتُم بَضَبعِ المَجدِ يا آلَ غالِبٍ","وَغادَرتُمُ الإِعدامَ مُنعَفِرَ الخَدِّ",11,"د",1,0],["جَذَبتُ بِضَبعِ العَزمِ مِن بَينِ أَضلُعي","وَزاحَمتُ بِالهَمِّ الدُجى وَالسَباسِبا",12,"ب",2,0],["جَذلانُ يَلتَقِطُ النَسي","مَ إِذا تَساقَطَتِ الثِيابُ",13,"ب",1,0],["جَذلانُ يَركَعُ إِن مالَ الضِرابُ بِهِ","مُطَرِّباً في قِبابِ البيضِ وَاليَلَبِ",14,"ب",1,0],["جَذَبتَ بِضَبعي فاِمتطى الشُّهبَ أَخمَصِي","فَلَم أَنتَعِل إِلّا جُدَيّاً وَفَرقَدا",15,"د",2,0],["جَذلانُ يَستَضحِكُ الأَيّامَ عَن شِيَمٍ","كَالرَوضِ تَضحَكُ مِنهُ في الرُبى قِطَعُ",16,"ع",1,0],["جَذلانُ في يَومِ الوَغى مُتَطَلِّقٌ","وَجهاً إِلَيها وَالرَدى مُتَجَهِّمُ",17,"م",1,0],["جَذَبنَ البُرى حَتّى شَدِفنَ وَأَصعَرَت","أُنوفُ المَهارى لَقوَةً في المَناخِرِ",18,"ر",1,0],["جَذبَ البُرى في عُرى أَزرارَ آنُفَها","بِراجِعٍ مِن عَتيقِ الجَوفِ مَنشورِ",19,"ر",1,0],["جَذَبنَ الهَوى مِن سِقطِ حَوضى بِسُدفَةٍ","عَلى أَمرِ ظَعّانٍ رَعَتهُ المَحاضِرُ",20,"ر",1,0],["جذلان تحذف جمع المال راحته","حذف الإضافة في الأسماء تنوينا",21,"ن",2,0],["جَذَبتَني لِوَصلِهِ","أَبَداً وَاِقتِرابِهِ",22,"ب",2,0],["جِذْلُ سلطانِه المحكَّك في الخَطْ","ب وعَذْقُ الجُناة ذو الترجيبِ",23,"ب",1,0],["جذْل حكاكٍ في الأمور المائسه","ذي شهب ترمى بها الأبالسه",24,"س",2,0],["جِذلُ نَيْكٍ يمشي الهوينا فينما","زُ وزيمٌ منْ لَحْمهِ عن وزيم",25,"م",1,0],["جذلانَ يَمرحُ في حقولِكَ","كالنسيمِ مُدندنا",26,"ن",2,0],["جُذامٌ سُيوفُ اللَهِ في كُلِّ مَوطِنٍ","إِذا أَزَمَت يَومَ اللِقاءِ أُزامِ",27,"م",1,1],["جَذلانُ هَيِّنَةٌ عَلَيهِ جِراحُهُ","وَجِراحُهُ في قَلبِ كُلِّ غَضَنفَرِ",28,"ر",1,0],["جذلانُ إنْ نفرتْ جواحِمُ غارةٍ","فيهن أمهدةُ البقاءِ جَعاجِعُ",29,"ع",1,0],["جَذلانَ تَحسُدُهُ الجِيادُ إِذا مَشى","عَنَقاً بِأَحسَنِ حُلَّةٍ لَم تُنسَجِ",30,"ج",1,0],["جَذلانَ يَنفُضُ عُذرَةً في غُرَّةٍ","يَقَقٍ تَسيلُ حُجولُها في جَندَلِ",31,"ل",1,0],["جَذلانَ يَسمَحُ في الكَرى بِعِناقِهِ","وَيَضُنُّ في غَيرِ الكَرى بِسَلامِهِ",32,"م",2,0],["جَذلانَ تَلطِمُهُ جَوانِبُ غُرَّةٍ","جاءَت مَجيءَ البَدرِ عِندَ تَمامِهِ",32,"م",2,0],["جَذلانُ ليسَ على المكارمِ صابِراً","يَقظانُ ليسَ عن الكريهةِ حَائِدا",33,"د",2,0],["جَذْلانُ يرغبُ في العُلا فَتِلادُه","مُصْغٍ لدعوةِ راغبٍ أو راهبِ",34,"ب",1,0],["جَذَبوا القِسِيَّ إِلى قِسِيِّ حَواجِبٍ","مِن تَحتِها نَبلُ اللَواحِظِ تَرشُقُ",35,"ق",1,0],["جذبته جذب عنف","قد كاد يذوي الزهورا",36,"ر",2,0],["جَذلانَ مِن ظَفَرٍ حَرّانَ إِن رَجَعَت","مَخضوبَةً مِنكُم أَظفارُهُ بِدَمِ",37,"م",1,0],["جَذَبتُ نَداهُ غُدوَةَ السَبتِ جَذبَةً","فَخَرَّ صَريعاً بَينَ أَيدي القَصائِدِ",38,"د",1,0],["جَذلانَ يَملَأُ مِنحَةً وَبَشاشَةً","أَيدي العُفاةِ وَأَعيُنَ الزُوّارِ",39,"ر",1,0],["جَذلانَ تَحسِبُ وَجهَهُ مُتَهَلِّلاً","في هَبوَةِ الهَيجاءِ غُرَّةَ أَدهَمِ",40,"م",1,0],["جذبوا بِسِرِّ الكيمياءِ عَدُوَّهُم","فَأَطاعَ بَعدَ شَراسَةٍ وَحِرانِ",41,"ن",1,0],["جذلانَ مُحتفلاً يقرّب منهما","للهِ ما يرضَى وما يتقبَّلُ",42,"ل",1,0],["جذلان يرتقبُ الردى","فاعجبْ لموتٍ في سرورِ",43,"ر",1,0],["جَذْلانُ فالآدابُ في حَركاتِهِ","والحِلمُ في إطراقِهِ وسُكونهِ",44,"ن",2,0],["جَذلانَ قَد هَيَّجَ مِن دُوّارِهِ","عارَضتُهُ في سَنَنِ اِمتِيارِهِ",45,"ر",2,0],["جذبتُها فتحانَت","كالغصن لمّا تثنّى",46,"ن",2,0],["جذباً إلى البيت فما إن لوى","حتى استوى في البيت في النقشِ",47,"ش",1,0],["جِذلُ المَها وَصِوارُ كُلِّ خَميلَةٍ","لا عَن تَجَفُّلِهِ نَجاءُ خِبابِهِ",48,"ب",2,0],["جِذْمُ حديدٍ أبَتْ وجَدِّكَ أنْ","يقْطَعَ فيها مُقَطِّعُ الجِذَم",49,"م",1,0],["جَذِلِينَ تَنْعَمُ فِي صَبِي","حَتِنَا وَلَيْلَكُمْ سَعِيدَهْ",50,"د",2,0],["جَذْلاَنَ كَالطِّفْلِ السَّعِيد بِعِيدِهِ","مُسْتَرْسِلاً فِي اللَّفْظِ وَالإِيمَاءِ",51,"ا",2,0],["جَذْلَى بعَوْدِ ذَكِيِّهَا وَسَرِيِّهَا","جَذْلَى بِعَوْدِ كَمِيِّهَا الأَبَاءِ",51,"ا",2,0],["جذبت إليه العرب بعد نفارهم","وذوبت في كاساتهم نغماتي",52,"ت",2,0],["جَذَمَت حَبلي النَوائِبُ مِن","سَكَني وَاِبني فَلا جَذَلا",53,"ل",2,0],["جذوةُ الحربِ إذا ما اشتعلتْ","وبدا الشرُّ وأبدَى الناجذين",54,"ن",1,0],["جذوةٌ للشبابِ كانت نعيماً","وسلاماً على الفؤادِ وبَرْدا",55,"د",2,0],["جذبتني عيناكِ حتى إذا ما","الهبَتْني تحرَّكَت شفتاك",56,"ك",1,0],["جِذْلُ سلطانِه المحكَّك في الخَطْ","ب وعَذْقُ الجُناة ذو الترحيب",57,"ب",1,0],["جُذُوراً إِذَا أَنْهلْنَهَا عُدْنَ بِالعَلِّ","فَيا لَقوَى التَّمْكِينِ فِي جِسْمِ سَالِمِ",58,"م",1,0],["جذبته من واسط نفحات","اخمرته بحب تلك المغاني",59,"ن",2,0],["جذب العزائم للمهيمن حاله","فسرت تطير له بغير جناح",60,"ح",1,0],["جذبت عقلي الكليل وطارت","فمضى يقطع الفجاج وراها",61,"ا",3,0],["جذبتني سلاسل الأقدار","لغزال حلو كثير النفار",62,"ر",1,1],["جَذَّ الرِقابَ وَما إِن سَلَّ صارِمَهُ","وَاِستَنزَلَ الخَطبَ مَقهوراً وَمارَكِبا",63,"ب",2,0],["جذَّتْ أُصول فروعها وتواصلتْ","أَغصانها لنسيمها حبَّا",64,"ب",2,0],["جذبت بحسن الرأي منهم ذوي النهي","وأدنيت منهم من وجدت له عقلا",65,"ل",2,0],["جُذامُ اِخَتُنا الأَدنَونَ قَد عَلِموا","وَما أَخوهُم بِمُضظَّرٍ وَلا وَجِدِ",66,"د",1,0],["جَذَعاً يَستَكبِرُ الشَولُ لَهُ","مُفنَقاً كَالفَحلِ يَعمي بِاللُعابِ",67,"ب",1,0],["جذلان يظفر من غصن إلى غصن","وبسمة الصبح بالإنشاد تغريه",68,"ي",2,0],["جذلان يهتزّ من دلال","نشوان من رقة الشمائل",69,"ل",1,0],["جذلان يختال في غلايله","فاق على الظبي في شمايله",70,"ه",1,0],["جذلان يضحك والالام تعصف بي","يا ربّ لا تسقه يوما جوى شجنى",71,"ن",2,0],["جَذلانَ ناعِمُ جسمِهِ","يَحكي لِرِقَّتِهِ الغَباطي",72,"ي",1,0],["جَذَبَ الغَرامُ عَنانَ طَرفي مَزورا","لَمّا وَقَفتُ عَلى عراصِ المَربَعِ",73,"ع",1,0],["جَذلانَ مُخضَرَّ النَدى","وَالعودِ مُحمَرَّ السِنانِ",74,"ن",1,0],["جَذلانُ يَكثُرُ في النَدى عُذّالُهُ","إِنَّ الكَريمَ عَلى السَماحِ مُعَذَّلُ",75,"ل",1,0],["جَذلانُ يُصبِحُ شَملُ المالِ مُنصَدِعاً","في راحَتَيهِ وَشَملُ الحَمدِ مُؤتَلِفا",76,"ف",2,0],["جَذلانُ مِن مَرَحِ الشَبا","بِ يَنامُ عَن لَيلي وَأَسهَد",77,"د",1,0],["جَذلانَ يَركُضُ في مَيا","دينِ الهَوى خَيلَ المِراحِ",78,"ح",1,0],["جذبت قوس استي في وجهه","فقرطست لحيته ضرطتي",79,"ي",1,0],["جذار غبي أو حسود مولع","بإنكار أسرار العلوم الدقيقة",80,"ه",1,0],["جذبته اِلى علاها الثريا","وَكسته مطارِف الاحسان",81,"ن",1,0],["جَذْلانُ يَحْجُبُ شَطْرَهُ عن شَطْرِهِ","طُولاً أُتمَّ له وعَرْضاً أُكمِلا",82,"ل",2,0],["جَذْلانَ يَنتصِبُ انتصابَ المَجْدَلِ ال","عالي ويَنقَضُّ انقضاضَ الأجْدَل",83,"ل",1,0],["جَذْلانُ يَرْمي العِدا بالخيلِ عاديةً","مُشيحةً فوقَها الأبطالُ والشِّكَك",84,"ك",1,0],["جَذلاً في بني أبيك مُقيماً","في الذي شئْتَ من سناً وسَناء",85,"ا",2,0],["جذبته يد التجاريب يَهوي","فكأن الصعود شرطُ هبوطهْ",86,"ط",2,0],["جَذلان ساحر طَرفِهِ","يَلهو بِأَلباب الكِرام",87,"م",1,0],["جَذلان يُبصر عَبرَتي","تَجري لَدَيهِ فَيَبسم",88,"م",1,0],["جَذَبَ النَبِيُّ بِضَبعِه يَومَ الغَدي","رِ وَوَكَّدَ التَعريفَ بِالتَعيين",89,"ن",1,0],["جَذلان يسر جُلّةً مكنوزة","وسماء بحونةً ووطباً مجزما",90,"م",2,0],["جذوع النخل أشباحٌ طوالٌ","إذا لم تزدهي فيها العذوق",91,"ق",1,0],["جَذَبَ النَّاسَ بالجميل إليه","وحباهم بفضله أجمعينا",92,"ن",2,0],["جَذْلاَنُ يُطْرِبُهُ السُّؤالُ كأَنما","يَسْقِيهِ سائِلُهُ بكأَسِ عُقَارِ",93,"ر",1,0],["جذلانَ يجلبُه الى الدنِفِ الكرى","كالروض يجلبُ عرفَه ريحُ الصَّبا",94,"ب",2,0],["جذلانُ لا في مِعطَسٍ صلَفٌ","منهُ ولا في حاجبٍ مطُّ",95,"ط",1,0],["جذَبتْ بك الهممُ الكبارُ فقد","نلتَ السماءَ وأنتَ تستعلي",96,"ل",2,0],["جذلانُ ما سألتَه وزاده","مسرَّةً إعطاءُ ما لم يُسأَلِ",97,"ل",1,0],["جذلان كلّ عشية","فيها المغارمُ تُغبقُهْ",98,"ق",2,0],["جذبتَ من القُنوع بها ذراعي","فطارت دون أخمَصِيَ النسورُ",99,"ر",1,0],["جذلانَ بين مادحٍ وحاسدٍ","فموجباتُ المدح يوجبن الحسدْ",100,"د",1,0],["جذابَ الرُّوَّاضَ عن مِقودِهِ","مرِسُ الجمرةِ وهّاجُ الثُّقوبِ",101,"ب",1,0],["جذلان مبتسمٌ اذا ازْورَّ الرَّدى","واذا يُنيلُ المُعْتفين فأبْهَجُ",102,"ج",1,0],["جَذِلاً ركضتُ بهِ جوادَ شبيبتي","وسحبتُ مِ