{"poems":[[53,"الآن أعربت الظنون","https://www.aldiwan.net/poem29655.html","مجزوء الكامل"],[53,"ضلالا لسائل هذي المغاني","https://www.aldiwan.net/poem29720.html","المتقارب"],[53,"أمير المؤمنين بثثت فينا","https://www.aldiwan.net/poem29796.html","الوافر"],[53,"وسمتك حالية الربيع المرهم","https://www.aldiwan.net/poem29817.html","الكامل"],[53,"إياك عنه عذل العاذل","https://www.aldiwan.net/poem29842.html","السريع"],[53,"ومقبل كفي وددت بأنه","https://www.aldiwan.net/poem29878.html","الكامل"],[53,"ما ابيض من لون العوارض أفضل","https://www.aldiwan.net/poem29902.html","الكامل"],[53,"أحظى الملوك من الأيام والدول","https://www.aldiwan.net/poem29908.html","البسيط"],[53,"لو صح أن البين يعشقه","https://www.aldiwan.net/poem29955.html","السريع"],[53,"يا دار ما طربت إليك النوق","https://www.aldiwan.net/poem29956.html","الكامل"],[53,"نطق اللسان عن الضمير","https://www.aldiwan.net/poem30476.html","مجزوء الكامل"],[53,"أسائل سيفي أي بارقة تجدي","https://www.aldiwan.net/poem30621.html","الطويل"],[53,"لأظما معلينا وأروى المصائبا","https://www.aldiwan.net/poem30735.html","الطويل"],[53,"إنا نعيب ولانعاب","https://www.aldiwan.net/poem30746.html","مجزوء الكامل"],[53,"لكل مجتهد حظ من الطلب","https://www.aldiwan.net/poem30753.html","البسيط"],[63,"أعد نظرا هل شارف الحي ثهمدا","https://www.aldiwan.net/poem45830.html","الطويل"],[73,"هل النداء الذي أعلنت مستمع","https://www.aldiwan.net/poem11935.html","البسيط"],[73,"الدهر إن أملى فصيح أعجم","https://www.aldiwan.net/poem11979.html","الكامل"],[30,"أشاقتك أخلاق الرسوم الدواثر","https://www.aldiwan.net/poem29579.html","الطويل"],[30,"أإن ترسمت من خرقاء منزلة","https://www.aldiwan.net/poem29580.html","البسيط"],[30,"لمية أطلال بحزوى دوائر","https://www.aldiwan.net/poem29586.html","الطويل"],[72,"أعدى بغيركم دمع المحبينا","https://www.aldiwan.net/poem20172.html","البسيط"],[64,"نسمة من جنابه","https://www.aldiwan.net/poem67576.html","مجزوء الخفيف"],[51,"شاب رأسي ولات حين مشيب","https://www.aldiwan.net/poem8148.html","الخفيف"],[51,"لهوت عن وصف الطلول الدارسه","https://www.aldiwan.net/poem64573.html","الرجز"],[51,"خلياني عند اصطكاك الخصومِ","https://www.aldiwan.net/poem66322.html","الطويل"],[91,"وطن النجوم أنا هنا","https://www.aldiwan.net/poem62783.html","عموديه"],[32,"جذام سيوف الله في كل موطن","https://www.aldiwan.net/poem27725.html","الطويل"],[85,"جبريل هلل في السماء وكبر","https://www.aldiwan.net/poem63765.html","الكامل"],[62,"إن العيون إذا نطقت تخاوصت","https://www.aldiwan.net/poem52341.html","الكامل"],[45,"لم يبق في تلك الرسوم بمنعج","https://www.aldiwan.net/poem62668.html","الكامل"],[45,"أهلا بذالكم الخيال المقبل","https://www.aldiwan.net/poem65577.html","الكامل"],[45,"طفقت تلوم ولات حين ملامه","https://www.aldiwan.net/poem65666.html","الطويل"],[61,"عذر العذول فراح فيك مساعدا","https://www.aldiwan.net/poem51726.html","الكامل"],[61,"شعف الحبائل من ربى وملاعب","https://www.aldiwan.net/poem51812.html","الكامل"],[66,"كيف الضلال وصبح وجهك مشرق","https://www.aldiwan.net/poem41374.html","الكامل"],[97,"رأيت غصنا صغيرا","https://www.aldiwan.net/poem24933.html","المجتث"],[44,"سلم على الربع من سلمى بذي سلم","https://www.aldiwan.net/poem30364.html","البسيط"],[44,"يقول أناس في حبيناء عاينوا","https://www.aldiwan.net/poem30551.html","الطويل"],[74,"سمح الخيال على النوى بمزار","https://www.aldiwan.net/poem12955.html","الكامل"],[74,"وأغر يسفر للعوالي والعلى","https://www.aldiwan.net/poem13240.html","الكامل"],[105,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[105,"أقبل فتلك ديار يثرب تقبل","https://www.aldiwan.net/poem44226.html","الكامل"],[102,"أنا ساعة الرجل الصبور","https://www.aldiwan.net/poem33054.html","مجزوء الكامل"],[75,"متهلل والبدر فوق جبينه","https://www.aldiwan.net/poem69030.html","الكامل"],[48,"لما غدا الثعلب من وجاره","https://www.aldiwan.net/poem63408.html","الطويل"],[48,"نكنا رسول عنان","https://www.aldiwan.net/poem66220.html","المجتث"],[48,"وشاطرِ أحورِ طاوي الحشا","https://www.aldiwan.net/poem66292.html","السريع"],[50,"ما رد سلوته إلى إطرابه","https://www.aldiwan.net/poem64822.html","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16686","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55505","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142044","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43824","المديد"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54317","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54199","الخفيف"],[90,"سلمى ايضاً او وردة بين اشواك!","https://www.poetsgate.com/ViewPoem.aspx?id=179123",""],[51,"شابَ رأسي ولات حينَ مَشيبِ","https://www.poetsgate.com/ViewPoem.aspx?id=26854",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"]],"verses":[["جَذِلاً وَلِلحُسّادِ مِن","أَسَفٍ زَفيرٌ أَو أَنينُ",0,"ن",1,0],["جَذَبتَ عَنِ الغَيِّ أَرسانَها","وَقَد شا فَهَتها المَنايا الدَواني",1,"ي",1,0],["جَذَبتَ عَنِ المُطيعِ زِمامَ عِزٍّ","أَطاعَ الوَخدُ مِنهُ وَالرَسيمُ",2,"م",1,0],["جَذلانُ تُطلِعُ مِنهُ أَندِيَةُ العُلى","وَجهاً كَريمَ الخَدِّ غَيرَ مُلَطَّمِ",3,"م",1,0],["جَذَبتُ حَبلي مِن يَدَي قاطِعٍ","فَاِمدُد لَهُ مِنكَ يَدَي واصِلِ",4,"ل",1,0],["جَذلانُ يَنفُضُ مِن فُروجِ قَميصِهِ","أَعطافَ غُصنِ البانَةِ المَطلولِ",5,"ل",1,0],["جَذلانَ تَقطُرُ نِعمَةً أَيّامُهُ","لِلطالِبينَ فَراغِبٌ وَمُؤَمِّلُ",6,"ل",1,0],["جَذَبتَ مِن لَهَواتِ المَوتِ مُهجَتَهُ","وَكانَ يَطرِفُ في الدُنيا عَلى وَجَلِ",7,"ل",1,0],["جَذلانُ يَرقُصُ في الرُؤوسِ إِذا","غَنَّتهُ بِالصَهَلاتِ سُبَّقُهُ",8,"ق",2,0],["جَذَبَت بِضَبعي مِن تِهامَةَ قاصِداً","وَالنَجمُ في بَحرِ الظَلامِ غَريقُ",9,"ق",1,0],["جَذَبَتهُ في شَطَنِ المَنو","نِ يَدُ النَآدِ العَنقَفيرِ",10,"ر",1,0],["جَذلانَ يَنظُرُ وَجهَهُ","في عارِضِ العَضبِ الشَهيرِ",10,"ر",1,0],["جَذَبتُم بَضَبعِ المَجدِ يا آلَ غالِبٍ","وَغادَرتُمُ الإِعدامَ مُنعَفِرَ الخَدِّ",11,"د",1,0],["جَذَبتُ بِضَبعِ العَزمِ مِن بَينِ أَضلُعي","وَزاحَمتُ بِالهَمِّ الدُجى وَالسَباسِبا",12,"ب",2,0],["جَذلانُ يَلتَقِطُ النَسي","مَ إِذا تَساقَطَتِ الثِيابُ",13,"ب",1,0],["جَذلانُ يَركَعُ إِن مالَ الضِرابُ بِهِ","مُطَرِّباً في قِبابِ البيضِ وَاليَلَبِ",14,"ب",1,0],["جَذَبتَ بِضَبعي فاِمتطى الشُّهبَ أَخمَصِي","فَلَم أَنتَعِل إِلّا جُدَيّاً وَفَرقَدا",15,"د",2,0],["جَذلانُ يَستَضحِكُ الأَيّامَ عَن شِيَمٍ","كَالرَوضِ تَضحَكُ مِنهُ في الرُبى قِطَعُ",16,"ع",1,0],["جَذلانُ في يَومِ الوَغى مُتَطَلِّقٌ","وَجهاً إِلَيها وَالرَدى مُتَجَهِّمُ",17,"م",1,0],["جَذَبنَ البُرى حَتّى شَدِفنَ وَأَصعَرَت","أُنوفُ المَهارى لَقوَةً في المَناخِرِ",18,"ر",1,0],["جَذبَ البُرى في عُرى أَزرارَ آنُفَها","بِراجِعٍ مِن عَتيقِ الجَوفِ مَنشورِ",19,"ر",1,0],["جَذَبنَ الهَوى مِن سِقطِ حَوضى بِسُدفَةٍ","عَلى أَمرِ ظَعّانٍ رَعَتهُ المَحاضِرُ",20,"ر",1,0],["جذلان تحذف جمع المال راحته","حذف الإضافة في الأسماء تنوينا",21,"ن",2,0],["جَذَبتَني لِوَصلِهِ","أَبَداً وَاِقتِرابِهِ",22,"ب",2,0],["جِذْلُ سلطانِه المحكَّك في الخَطْ","ب وعَذْقُ الجُناة ذو الترجيبِ",23,"ب",1,0],["جذْل حكاكٍ في الأمور المائسه","ذي شهب ترمى بها الأبالسه",24,"س",2,0],["جِذلُ نَيْكٍ يمشي الهوينا فينما","زُ وزيمٌ منْ لَحْمهِ عن وزيم",25,"م",1,0],["جَذلانَ يَمرَحُ في حُقولِكَ","كَالنَسيمِ مُدَندِنا",26,"ن",2,0],["جُذامٌ سُيوفُ اللَهِ في كُلِّ مَوطِنٍ","إِذا أَزَمَت يَومَ اللِقاءِ أُزامِ",27,"م",1,1],["جَذلانُ هَيِّنَةٌ عَلَيهِ جِراحُهُ","وَجِراحُهُ في قَلبِ كُلِّ غَضَنفَرِ",28,"ر",1,0],["جذلانُ إنْ نفرتْ جواحِمُ غارةٍ","فيهن أمهدةُ البقاءِ جَعاجِعُ",29,"ع",1,0],["جَذلانَ تَحسُدُهُ الجِيادُ إِذا مَشى","عَنَقاً بِأَحسَنِ حُلَّةٍ لَم تُنسَجِ",30,"ج",1,0],["جَذلانَ يَنفُضُ عُذرَةً في غُرَّةٍ","يَقَقٍ تَسيلُ حُجولُها في جَندَلِ",31,"ل",1,0],["جَذلانَ يَسمَحُ في الكَرى بِعِناقِهِ","وَيَضُنُّ في غَيرِ الكَرى بِسَلامِهِ",32,"م",2,0],["جَذلانَ تَلطِمُهُ جَوانِبُ غُرَّةٍ","جاءَت مَجيءَ البَدرِ عِندَ تَمامِهِ",32,"م",2,0],["جَذلانُ ليسَ على المكارمِ صابِراً","يَقظانُ ليسَ عن الكريهةِ حَائِدا",33,"د",2,0],["جَذْلانُ يرغبُ في العُلا فَتِلادُه","مُصْغٍ لدعوةِ راغبٍ أو راهبِ",34,"ب",1,0],["جَذَبوا القِسِيَّ إِلى قِسِيِّ حَواجِبٍ","مِن تَحتِها نَبلُ اللَواحِظِ تَرشُقُ",35,"ق",1,0],["جذبته جذب عنف","قد كاد يذوي الزهورا",36,"ر",2,0],["جَذلانَ مِن ظَفَرٍ حَرّانَ إِن رَجَعَت","مَخضوبَةً مِنكُم أَظفارُهُ بِدَمِ",37,"م",1,0],["جَذَبتُ نَداهُ غُدوَةَ السَبتِ جَذبَةً","فَخَرَّ صَريعاً بَينَ أَيدي القَصائِدِ",38,"د",1,0],["جَذلانَ يَملَأُ مِنحَةً وَبَشاشَةً","أَيدي العُفاةِ وَأَعيُنَ الزُوّارِ",39,"ر",1,0],["جَذلانَ تَحسِبُ وَجهَهُ مُتَهَلِّلاً","في هَبوَةِ الهَيجاءِ غُرَّةَ أَدهَمِ",40,"م",1,0],["جذبوا بِسِرِّ الكيمياءِ عَدُوَّهُم","فَأَطاعَ بَعدَ شَراسَةٍ وَحِرانِ",41,"ن",1,0],["جذلانَ مُحتفلاً يقرّب منهما","للهِ ما يرضَى وما يتقبَّلُ",42,"ل",1,0],["جذلان يرتقبُ الردى","فاعجبْ لموتٍ في سرورِ",43,"ر",1,0],["جَذْلانُ فالآدابُ في حَركاتِهِ","والحِلمُ في إطراقِهِ وسُكونهِ",44,"ن",2,0],["جَذلانَ قَد هَيَّجَ مِن دُوّارِهِ","عارَضتُهُ في سَنَنِ اِمتِيارِهِ",45,"ر",2,0],["جذبتُها فتحانَت","كالغصن لمّا تثنّى",46,"ن",2,0],["جذباً إلى البيت فما إن لوى","حتى استوى في البيت في النقشِ",47,"ش",1,0],["جِذلُ المَها وَصِوارُ كُلِّ خَميلَةٍ","لا عَن تَجَفُّلِهِ نَجاءُ خِبابِهِ",48,"ب",2,0],["جِذْمُ حديدٍ أبَتْ وجَدِّكَ أنْ","يقْطَعَ فيها مُقَطِّعُ الجِذَم",49,"م",1,0],["جَذِلِينَ تَنْعَمُ فِي صَبِي","حَتِنَا وَلَيْلَكُمْ سَعِيدَهْ",50,"د",2,0],["جَذْلاَنَ كَالطِّفْلِ السَّعِيد بِعِيدِهِ","مُسْتَرْسِلاً فِي اللَّفْظِ وَالإِيمَاءِ",51,"ا",2,0],["جَذْلَى بعَوْدِ ذَكِيِّهَا وَسَرِيِّهَا","جَذْلَى بِعَوْدِ كَمِيِّهَا الأَبَاءِ",51,"ا",2,0],["جذبت إليه العرب بعد نفارهم","وذوبت في كاساتهم نغماتي",52,"ت",2,0],["جَذَمَت حَبلي النَوائِبُ مِن","سَكَني وَاِبني فَلا جَذَلا",53,"ل",2,0],["جذوةُ الحربِ إذا ما اشتعلتْ","وبدا الشرُّ وأبدَى الناجذين",54,"ن",1,0],["جذوةٌ للشبابِ كانت نعيماً","وسلاماً على الفؤادِ وبَرْدا",55,"د",2,0],["جذبتني عيناكِ حتى إذا ما","الهبَتْني تحرَّكَت شفتاك",56,"ك",1,0],["جِذْلُ سلطانِه المحكَّك في الخَطْ","ب وعَذْقُ الجُناة ذو الترحيب",57,"ب",1,0],["جُذُوراً إِذَا أَنْهلْنَهَا عُدْنَ بِالعَلِّ","فَيا لَقوَى التَّمْكِينِ فِي جِسْمِ سَالِمِ",58,"م",1,0]]}