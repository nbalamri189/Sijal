{"poems":[[55,"ما لذا الداني إلى القلب شحط","https://www.aldiwan.net/poem30161.html","الرمل"],[55,"عند قلبي علاقة ما تقضى","https://www.aldiwan.net/poem30174.html","الخفيف"],[79,"أبشر فقد نلت ما ترجو على عجل","https://www.aldiwan.net/poem36369.html","البسيط"],[75,"أستودع الله من أصفي الوداد له","https://www.aldiwan.net/poem11864.html","البسيط"],[10,"ما لذا الموت لا يزال مخيفا","https://www.aldiwan.net/poem21113.html","الخفيف"],[93,"راودني النوم وما برحا حتى طأطأت له راسي","https://www.aldiwan.net/poem8971.html","عموديه"],[93,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[47,"أقصرا قد أطلتما تفنيدي","https://www.aldiwan.net/poem63541.html","الخفيف"],[47,"أوحشت أربع العقيق ودوره","https://www.aldiwan.net/poem63578.html","الخفيف"],[47,"ما لذا الظبي لاينال إقتناصه","https://www.aldiwan.net/poem64618.html","الخفيف"],[68,"وحق من لا سواهم عندي القسم","https://www.aldiwan.net/poem39644.html","البسيط"],[50,"ما لذة العيش إلا شرب صافية","https://www.aldiwan.net/poem65310.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54861","الخفيف"],[79,"أبشر فقد نلت ما ترجو على عجل","https://www.poetsgate.com/ViewPoem.aspx?id=34156",""],[92,"حافظ إبراهيم","https://www.poetsgate.com/ViewPoem.aspx?id=179126",""],[113,"غصن من البان في أثواب سوسان","https://www.aldiwan.net/poem16403.html","البسيط"],[124,"غذائي الحب يا من فيه حرمان","https://www.aldiwan.net/poem49336.html","البسيط"],[132,"فأنا المقر بذا ولكن ليس لي","https://www.aldiwan.net/poem50556.html","الكامل"],[164,"دمعي على الخد مثل الدر ينتثر","https://www.aldiwan.net/poem58847.html","الكامل"],[164,"الحمد للّه رب العالمين على","https://www.aldiwan.net/poem58891.html","الكامل"],[287,"دعني من الرشأ الأغن الأكيس","https://www.aldiwan.net/poem32739.html","الكامل"],[287,"وغن في اللحن القديم معربا","https://www.aldiwan.net/poem32863.html","الرجز"],[409,"حتى م ذا الدهر بالتشتيت يرمينا","https://www.aldiwan.net/poem33381.html","الرمل"],[409,"زارت وقد ولى الهوى العذري","https://www.aldiwan.net/poem33903.html","الكامل"],[422,"باكر نداماك بكأس العقار","https://www.aldiwan.net/poem53938.html","السريع"],[427,"ما لذة العيش إلا صحبة الفقرا","https://www.aldiwan.net/poem46403.html","البسيط"],[435,"عبير ثنا عبد الحميد يد الزهر","https://www.aldiwan.net/poem39902.html","الطويل"],[435,"ما لذة المرء بالكاسات والوتر","https://www.aldiwan.net/poem40743.html","البسيط"],[435,"كفي فإن سحاب الجفن قد وكفا","https://www.aldiwan.net/poem41398.html","البسيط"],[443,"أما الفراق فإن موعده غد","https://www.aldiwan.net/poem2552.html","الكامل"],[469,"قلبي ببيض المعالي هائم دنف","https://www.aldiwan.net/poem3449.html","عموديه"],[469,"ديار هند أقفرت منذ أزمان","https://www.aldiwan.net/poem3492.html","عموديه"],[543,"السحر هذا ما أرى","https://www.aldiwan.net/poem48280.html","عموديه"],[558,"عجبا لطيف خيالك المتجانب","https://www.aldiwan.net/poem68410.html","الكامل"],[572,"ما لذة أكمل من طيبها","https://www.aldiwan.net/poem69618.html","السريع"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2513","الخفيف"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83332","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122577","الخفيف"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66839","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63871","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70771","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119871","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120094","الرمل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96676","الرمل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35392","الكامل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109139","السريع"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49920","البسيط"],[1595,"","https://poetry.dctabudhabi.ae/diwan/poem/142930","الخفيف"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87877","البسيط"],[1892,"","https://poetry.dctabudhabi.ae/diwan/poem/96243","الخفيف"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96034","الكامل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47095","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93587","الرجز"],[2444,"","https://poetry.dctabudhabi.ae/diwan/poem/105388","الرمل"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26251","البسيط"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/198643","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94010","البسيط"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58398","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132714","الرجز"],[119,"","https://poetry.dctabudhabi.ae/diwan/poem/105953","الخفيف"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130071","الكامل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121677","السريع"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205882",""],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119714","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73103","الرجز"],[4347,"","https://poetry.dctabudhabi.ae/diwan/poem/134246","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83351","الكامل"],[4363,"","https://poetry.dctabudhabi.ae/diwan/poem/121512","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141666","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120555","الكامل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52143","الكامل"],[357,"الليل والذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=6324",""],[4767,"إلى نعجة الخليج","https://www.poetsgate.com/ViewPoem.aspx?id=124840",""],[4767,"ساعات الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=129785",""],[4929,"مآلاتُ اللاءات","https://www.poetsgate.com/ViewPoem.aspx?id=208656",""],[5038,"دموع الورد","https://www.poetsgate.com/ViewPoem.aspx?id=195422",""],[5057,"يا آخر الأسفار","https://www.poetsgate.com/ViewPoem.aspx?id=197625",""],[5075,"باق على عهدي","https://www.poetsgate.com/ViewPoem.aspx?id=187690",""],[5121,"فِي أَدْمُعِي","https://www.poetsgate.com/ViewPoem.aspx?id=33577",""],[5121,"ريّان","https://www.poetsgate.com/ViewPoem.aspx?id=33582",""],[5155,"يا عيد","https://www.poetsgate.com/ViewPoem.aspx?id=176588",""],[5183,"وقِّر العلم","https://www.poetsgate.com/ViewPoem.aspx?id=186456",""],[5186,"يا لمنطاد أرضنا يتقلى","https://www.poetsgate.com/ViewPoem.aspx?id=156522",""],[5397,"أجريت قلبي بالدموع مذابا","https://www.poetsgate.com/ViewPoem.aspx?id=157905",""],[5431,"الا اجتراحك في عشق إذا لفحا","https://www.poetsgate.com/ViewPoem.aspx?id=198342",""],[5582,"شَغَفَ القَلْبَ اشْتِياقاً وَنَهَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=63549",""],[5596,"عبق الزهر","https://www.poetsgate.com/ViewPoem.aspx?id=205463",""],[5759,"بانَ السهادُ","https://www.poetsgate.com/ViewPoem.aspx?id=214824",""],[5781,"قلبٌ وذرَّاتُ رماد ...","https://www.poetsgate.com/ViewPoem.aspx?id=176650",""],[6124,"لما عرفت الحب","https://www.poetsgate.com/ViewPoem.aspx?id=174659",""],[6124,"أشجان الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=174685",""],[6355,"رمضان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66634&r=&rc=94",""],[572,"ما لذَّة ٌ اَكْمَلُ في طيّها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9357&r=&rc=214",""]],"verses":[["ما لِذا الداني إِلى القَلبِ شَحَط","وَغَريمِ الحُبِّ بِالدَينِ أَلَطّ",0,"ط",1,1],["ما لِذا الزَورِ ما يَغِبُّ مِنَ الرَم","لِ طُروقاً في مَضجَعٍ قَد أُقِضّا",1,"ض",2,0],["مَا لَذَّةُ الْعَيْشِ إِلاَّ فِي طَلاَوَ طِلاً","أَوْ وَصْلِ حِبً بِلاَ صَدً وَلاَ مَلَلِ",2,"ل",1,0],["ما لَذَّ لي قُربُ أُنسٍ أَنتِ نازِحَةٌ","عَنهُ وَلا ساغَ عَيشٌ لَستِ فيهِ مَعي",3,"ع",2,0],["ما لِذا المَوتِ لا يَزالُ مُخيفاً","كُلَّ يَومٍ يَنالُ مِنّا شَريفاً",4,"ف",2,1],["ما لَذَّةُ مَيتٍ في الرَمسِ","بِالزَهرِ الفَوّاحِ العَطِرِ",5,"ر",1,0],["ما لَذَّتي بِالماءِ أَروى بِهِ","بَل لَذَّتي بِالعَدوِ خَلفَ السَراب",6,"ب",1,0],["ما لَذيذُ الحَياةِ أَحلى لَدَيهِ","مِن نَجاحٍ يُغريهِ بِالمَوعودِ",7,"د",1,0],["ما لِذا الحُبِّ لا يُفادى أَسيرُه","وَالصِبا أَفحَشَ اِقتِضاءً مُعيرُه",8,"ر",2,0],["ما لِذا الظَبيِ لايُنالُ إِقتِناصُه","وَهوَ بِالقُربِ بَيِّنٌ إِفراصُه",9,"ص",2,1],["ما لَذَّ لي العَيشُ مُذ غابَت مَحاسِنُكُم","وَلا حَلَت بَعدَ رُؤياكُم لِيَ النِعَمُ",10,"م",1,0],["ما لَذَّةُ العَيشِ إِلّا شُربُ صافِيَةٍ","في بَيتِ خَمّارَةٍ أَو ظِلُّ بُستانِ",11,"ن",1,1],["مَا لذِي العُنْصُرِ الْكريمِ بِهذِي","الدَّارِ إِلاَّ ابْتِغَاءَ أَكْرَمِ دَارِ",12,"ر",1,0],["ما لذة العيش إلا في علا وطلا","ووصل حب بلا صد ولا ملل",13,"ل",1,0],["ما لذَّةُ العيشِ جَهلُ العَيشِ مَبدؤهُ","والهمُّ واسِطهُ ، والموتُ عُقباه",14,"ا",2,0],["ما لَذَّة الراح إِلّا أَن تَكون لَنا","مدارة مِن يَديهِ وَسَط بُستانِ",15,"ن",1,0],["ما لذة القلب خلواً من دخيل هوىً","ما الليل إن لم يكن بالصبح إيقان",16,"ن",1,0],["ما لذَّتي في لذةِ الدنيا وقد","نوديت فيها مسرعاً بتنقلِ",17,"ل",1,0],["ما لذةُ الملك إلا الحبُّ يكسبه","من قلب كل امرئ للأمر يأتمرُ",18,"ر",1,0],["ما لذَهُ الملكِ إلاّ أن تنال به","حباً يسرك عن أهليه ما انتقلا",19,"ل",2,0],["ما لَذَّتي إِلّا مَديحُ الأَشرَفِ ال","قَيلِ الغَزيرِ الجودِ موسى الأَشوَسِ",20,"س",1,0],["ما لَذَّةُ العَيشِ سِوى الشُربِ عَلى ال","وَردِ أَمامَ الشَربِ أَهلِ الأَدَبِ",21,"ب",1,0],["ما لذَّ لي بعدكم شخص أصادقه","ففي زوايا خمولي صرت مدفونا",22,"ن",2,0],["ما لذَّ لي بعد المشيب سِوَى","كأسِ النظام أداره الفخري",23,"ر",2,0],["ما لَذَّةُ العيش سوى ساعةٍ","في مجلسٍ يُخْلَعُ في العذار",24,"ر",1,0],["ما لذَّةُ العيشِ إلّا صحبةُ الفقرا","هم السلاطينُ والساداتُ والأمرا",25,"ر",2,1],["مآل ذوي الآداب ردٌ لعلمكم","شهيد فمٍ بالسبق في السر والجهرِ",26,"ر",1,0],["ما لذة المرءِ بالكاسات والوترِ","بل باقتناص الثنا والمجد والظفر",27,"ر",1,1],["ما لذ جفني بنوم بعد بعدكم","كلا وداعي الكرى بالطرف ما هدفا",28,"ف",2,0],["ما لذّ لي عيش بغير ربوعه","إلا به عيش ألذّ وأرغد",29,"د",1,0],["ما لذَّة الحبِ إلا المنعُ يحجبه","وبهجةُ الحسن إلاَّ اللينُ والقصف",30,"ف",1,0],["ما لذّةُ الصّبوة لولا الإعلان","خفناً الوشاة والبكا قد خان",31,"ن",1,0],["ما لذَّ للأسماعِ","مِن كلَِّّ شيءٍ مُعجبِ",32,"ب",1,0],["ما لَذَّةُ الدُنيا إِذا ما لَم تَكُن","فيها فَتى كَأسٍ صَريعَ حَبائِبِ",33,"ب",1,0],["مَا لَذَّةٌ أَكْمَلُ مِن طِيْبِهَا","مِنْ قُبْلَةٍ في إثْرِهَا عَضَّهْ",34,"ض",2,1],["ما لِذا الهَمِّ لا يَريمُ فُؤادي","مِثلَ ما يَلزَمُ الغَريمَ الغَريمُ",35,"م",1,0],["ما لِذاتِ الوِشاحِ جاءَت تَبَختَر","وَالضَواحي بِرُدنِها تَتَعَطَّر",36,"ر",1,1],["ما لذي الرأي بعد رأيك بالجم","لةِ رأيٌ ولا لذي الكيد كيد",37,"د",1,0],["ما لَذَّ عيشٌ بعد رضِّ","كِ بالجياد الأعْوَجِيّهْ",38,"ي",2,0],["ما لذا الظهرَ من بعاذين لا يُو","صَلُ أم ما للبطنِ من بطياس",39,"س",1,0],["ما لِذا الخلقِ كلما نابَ خطب","لم تُفدْهمْ بصائراً وعقولا",40,"ل",2,0],["ما لذ لي نيل البخيل ولو غدا","فيه الغنى ويلذني الأعسار",41,"ر",1,0],["ما لذي الرمة شروا","ه ولا لابن الخطيمِ",42,"م",1,0],["ما لِذاتِ الخالِ منها قطعت","مِن وِصالي حبلَها فَاِنقطعا",43,"ع",2,0],["ما لَذَّتي في غَيرِ مَدحِكَ مُخلِصاً","إِلّا بِمَدحِيَ مِن بَنيكَ إِماما",44,"م",2,0],["ما لذها الضيف ولكنما","قد لذها الأكل الشهي الكثير",45,"ر",1,0],["مالذةُ المتمادي في بطالتهِ","وإن تنعَّم إلاَّ لذُّة الجربِ",46,"ب",1,0],["ما لِذا الدهر صَرْفُه لا يغِبُّ","كلَّ يومٍ يروعُنا منه خَطْبُ",47,"ب",1,1],["ما لذَّ اصلاً بلا مرٍّ ولا سقم","منعٌ يعزِّزهُ عذل من الحسدِ",48,"د",1,0],["مالذي في الطريق تصنع بعدي","قلت أبكي عليك طول الطريق",49,"ق",1,0],["ما لذ برد العيش من ذكراه","بعدك وانصرامه",50,"م",2,0],["ما لذي الحلم عنده من ثَبَاتٍ","لاَ وَلاَ صَابِرٌ لَدَيْهِ عزاء",51,"ا",2,0],["ما لذة العَيش لِصَب قَد مَضَت","أَيامه ما بَين هجران وَصَد",52,"د",1,0],["مالذي ضرك لو عدت فتىً","عد أيام اللقا يا مي عيدا",53,"د",2,0],["ما لَذَّ لِلعَينِ نَومٌ بَعدَ ما ذَكَرَت","لَيلاً سَهِرناهُ بَينَ الضالِ وَالسَمَرِ",54,"ر",1,0],["ما لذّ للعين نوم بعدما ذكرت","ليلاً سمرناه بين الضال والسَّمُر",55,"ر",1,0],["ما لذ يا صاح لي صبوح","كلا ولا طاب لي غبوق",56,"ق",1,0],["ما لذَّةُ القَصْفِ أنْ تأتيهِ مُسْتَتِراً","بلْ لذَّة العِشقِ أنْ تأتيهِ مُفْتَضَحا",57,"ح",2,0],["ما لذي لي غير الرضاب منهل","واظمأ القلب لذاك المنهل",58,"ل",1,0],["ما لذاك المسيء واللَه ملجا","بحياة ويوم هول التنادي",59,"ي",1,0],["ما لذَّ لي يوماً طعامٌ طيّبٌ","أو نالني مال أقولُ سَيَذهَبُ",60,"ب",1,0],["ما لَذَّةُ الدنيا إذا لم أكُن","أخْطِر فيها بِردَاءِ الشَّبابْ",61,"ب",1,0],["ما لذا العقاد والتقري","د والتقريظ يُغْرِي",62,"ر",2,0],["ما لذي العين لا تَمَلُّ الدموعا","أتذكَّرت شادناً أم ربوعا",63,"ع",2,1],["ما لذُنوبي عِندها عَظِيمةٌ","نَيلُ نُجومِ الغَفرِ دونَ غَفرِها",64,"ر",3,0],["ما لذ لي العيش مذ فارقت حضرتكم","كلا ولا طاب لي كاس ولا وتر",65,"ر",1,1],["ما لَذّ في سَمعي وَلا سَمع العلى","كَمَديح أحمدَ كلّ مدحٍ مُطربِ",66,"ب",1,0],["ما لَذَّ لي مطعمٌ بعدَ الحبيبِ ولا","عذبُ المشاربِ بعد الظاعنينَ حَلا",67,"ل",2,0],["ما لذّ طعم العيش إلاّ من عدا","ه الثكل لا من كان ذا أيسار",68,"ر",1,0],["ما لذ مثل الاشتغال بذكرها","شيء لطالب بغية مستبدع",69,"ع",1,0],["ما لذَّةُ العيشِ الحقيقة وحدَها","حسبُ النفوس تَوهّمت أوهامَها",70,"م",3,0],["مالذي اسرج في الظلمه...للحزن جواده","انه الحب وجرح...نزعوا عنه ضماده",71,"د",2,0],["ما لذئبٍ عوَى على أرض ليثٍ","غيرُ ما كان من شديد الهِياج",72,"ج",1,0],["ما لِذي العلة من نفعٍ إذا لم","ينتفع بالطبِّ من خيرِ سبيل",73,"ل",1,0],["مالذي جدَّ كي تقولوا عسى أن","لا تسيرَ الأمورُ عَرْجاءَ حَدْبَا ؟",74,"ب",2,0],["ما لِذاكَ الْحُسْنِ عَنْ عَيني مَضى","أَ تَلاشى حينَ واراهُ الْعَمى",75,"م",2,0],["ما لذّةُ العيشِ الرّغيدِ ونفعُهُ","إنْ كانَ منفى المرءِ في جنبيه",76,"ي",2,0],["ما لذَّ لي شهدٌ إذا خاصمتني","والعيشُ مذْ فارقت روحي ما صفا",77,"ف",2,0],["مَا لَذَّ مُرُّ الصَّبِّ فِي نَكَهَاتِهِ","إِذْ سَاحَ دَمْعُ الْحُبِّ فِيِهِ تَجَرُّدِي",78,"د",2,0],["ما لذَّ في ثغريَ العطشانِ منْ ثَمَرٍ","يروي فؤادي إذا ما النَّبضُ قدْ حلبا",79,"ب",2,0],["ما لذّلي كالدمع يروي غلتي","والدع ري للشقي وزاد",80,"د",1,0],["ما لذا العالم في أرجوحةٍ","تترامى تحت الهبا",81,"ب",2,0],["ما لذي رحمة على الأرض إلا","دمعه في غبوقه وصبوحه",82,"ح",2,0],["ما لذ عيش للنفوس ولا الكرى","ليلاً لإنسان النواظر طابا",83,"ب",2,0],["مالذة الدهر ما معنى صبابته","الا اجتراحك في عشق إذا لفحا",84,"ح",2,0],["[ ما لَذِيذُ العَيْشِ يَصْفُو لِلفَتَى","قَطُّ إِلاّ ما إِذا العَقْلُ هَلَكْ ]",85,"ك",1,0],["ما لذّ لي العيش ولا طيبه","إلا به منك هوىً او رمق",86,"ق",1,0],["مالذَّ نومُ العاشقينَ وإنما","قَضَّت مضاجعُ تحتَهُم ووسادُ",87,"د",1,0],["ما لذَّة ال