{"poems":[[55,"خير الهوى ما نجا من الكمد","https://www.aldiwan.net/poem30628.html","المنسرح"],[79,"مولاي ياذا الجلال الباهر العالي","https://www.aldiwan.net/poem36349.html","البسيط"],[9,"أأزمعت من آل ليلى ابتكارا","https://www.aldiwan.net/poem21940.html","المتقارب"],[9,"ألا من مبلغ عني حريثا","https://www.aldiwan.net/poem21987.html","الوافر"],[10,"جرى لي طير في حمام حذرته","https://www.aldiwan.net/poem21067.html","الطويل"],[31,"هلا أنختم لابن وحف فإنه","https://www.aldiwan.net/poem6203.html","الطويل"],[93,"يا نبأ سر به مسمعي","https://www.aldiwan.net/poem9060.html","عموديه"],[93,"أنشودة في ضميري كم أواريها","https://www.aldiwan.net/poem62812.html","عموديه"],[45,"ألا كل ماشية الخيزلى","https://www.aldiwan.net/poem9448.html","المتقارب"],[30,"تكاثر يربوع عليك ومالك","https://www.aldiwan.net/poem4981.html","الطويل"],[2,"ألا أبلغ لديك بني تميم","https://www.aldiwan.net/poem25053.html","الوافر"],[60,"توق مدى الأيام إدخال مطعم","https://www.aldiwan.net/poem30856.html","الطويل"],[51,"أشد الجهاد جهاد الهوى","https://www.aldiwan.net/poem10319.html","المتقارب"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67301","الوافر"],[45,"ألا كل ماشية الخيزلى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=5436&r=&rc=7",""],[113,"آلى الزمان عليه أن يواليكا","https://www.aldiwan.net/poem16196.html","البسيط"],[240,"هل أنت يا أخت القضيب الناضر","https://www.aldiwan.net/poem31983.html","الرجز"],[266,"ترى أي داء من فراقك أعضل","https://www.aldiwan.net/poem38214.html","الطويل"],[275,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[287,"أتحسبون غرب أجفاني جف","https://www.aldiwan.net/poem32704.html","الرجز"],[302,"أفي كل يوم للأماني تكذيب","https://www.aldiwan.net/poem33335.html","الطويل"],[308,"عدمت بالرحبة اكتسابي","https://www.aldiwan.net/poem57763.html","مخلع البسيط"],[368,"إذا دعاهن ارعوين لصوته","https://www.aldiwan.net/poem1708.html","الطويل"],[369,"أأحبابنا قد شقتمونا فأسعدوا","https://www.aldiwan.net/poem60942.html","الطويل"],[376,"متى صارت الجرد المذاكي سفائنا","https://www.aldiwan.net/poem57079.html","الكامل"],[408,"لكسب العلى فاجعل همومك تحمد","https://www.aldiwan.net/poem46939.html","الطويل"],[435,"الحمد لله الذي قد حللا","https://www.aldiwan.net/poem40815.html","الرجز"],[469,"ألمت سليمى والنسيم عليل","https://www.aldiwan.net/poem3634.html","عموديه"],[505,"جاء البشير ليعقوبي بيوسفه","https://www.aldiwan.net/poem38078.html","البسيط"],[556,"سأبلغ حاجاتي وإن كن نزحا","https://www.aldiwan.net/poem47156.html","الطويل"],[563,"إن كنت نائم","https://www.aldiwan.net/poem34090.html","مخلع البسيط"],[563,"في كل جنس من الأجناس معلوم","https://www.aldiwan.net/poem34094.html","البسيط"],[563,"كل أناس لهم لغات","https://www.aldiwan.net/poem34724.html","مخلع البسيط"],[567,"من كان منك أميرا أيها الرمم","https://www.aldiwan.net/poem52895.html","البسيط"],[580,"ما أخشن الدهر على لينه","https://www.aldiwan.net/poem2772.html","السريع"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64094","المنسرح"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70976","الطويل"],[949,"","https://poetry.dctabudhabi.ae/diwan/poem/124748","الرجز"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129523","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59655","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144117","المنسرح"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49590","الرجز"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49574","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53218","الرمل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124769","الطويل"],[2683,"","https://poetry.dctabudhabi.ae/diwan/poem/132505","الرجز"],[2816,"","https://poetry.dctabudhabi.ae/diwan/poem/131919","البسيط"],[2820,"","https://poetry.dctabudhabi.ae/diwan/poem/29518","الطويل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103480","الرجز"],[3100,"","https://poetry.dctabudhabi.ae/diwan/poem/124293","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100773","المتقارب"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138557",""],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45805","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110051","الطويل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66613","البسيط"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2534","الوافر"],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17759","الوافر"],[4070,"","https://poetry.dctabudhabi.ae/diwan/poem/80133","الوافر"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4526,"","https://poetry.dctabudhabi.ae/diwan/poem/75839","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72515","البسيط"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[5225,"مدارات","https://www.poetsgate.com/ViewPoem.aspx?id=36080",""],[5337,"كم قد تؤمل نفس نيل منيتها","https://www.poetsgate.com/ViewPoem.aspx?id=171247",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5461,"كيف ننسى الكويت","https://www.poetsgate.com/ViewPoem.aspx?id=5293",""],[470,"حشودٌ من الحب والكبرياء","https://www.poetsgate.com/ViewPoem.aspx?id=194105",""],[5377,"رثاء شعب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79547&r=&rc=1",""]],"verses":[["وَكُلَّ طاغي الغِرارِ تَلحَظُهُ","مِن غِمدِهِ في طَرائِقٍ قِدَدِ",0,"د",1,0],["وَكُلْ طَعَامَهُمْ وَأَلْبَسْ لِبَاسَهُمُ","وَانْصُبْ لِصَيْدِهِمُ أَشْرَاكَ مُحْتَالِ",1,"ل",1,0],["وَكُلَّ طَويلٍ كَأَنَّ السَلي","طَ في حَيثُ وارى الأَديمُ الشِعارا",2,"ر",2,0],["وَكُلِّ طُوالَةٍ شَنِجٍ نَساها","تَبَدُّ بَدا المَعارِقِ وَالعِنانا",3,"ن",2,0],["وَكُلُّ طَويلِ المَتنِ أَسمَرَ ذابِلٍ","وَكُلُّ عَتيقٍ في جِيادِ الصَفائِحِ",4,"ح",1,0],["وَكُلُّ طَويلِ الساعِدَينِ كَأَنَّهُ","فَنيقٌ خَطيرٌ يَفرَعُ الناسَ شَرمَحُ",5,"ح",1,0],["وَكُلُّ طَلقِ الوَجهِ مَوفورِهِ","في بُردَتَيهِ سَيِّدٌ مائِلُ",6,"ل",1,0],["وَكُلُّ طابِخِ سُمٍّ سَوفَ يَأكُلُهُ","وَكُلُّ حافِرِ بِئرٍ واقِعٌ فيها",7,"ي",3,0],["وَكُلُّ طَريقٍ أَتاهُ الفَتى","عَلى قَدَرِ الرِجلِ فيهِ الخُطا",8,"ا",1,0],["وَكُلُّ طَويلُ الساعِدَينِ كَأَنَّهُ","قَريعُ هِجانٍ يَخبِطُ الناسَ شَرمَحُ",9,"ح",1,0],["وَكُلُّ طُوالَةٍ وَأَقَبَّ نَهدٍ","مَراكِلُها مِنَ التَعداءِ جونُ",10,"ن",1,0],["وَكُلُّ طَعامٍ يَعجَزُ السِنُ مَضغَهُ","فَلا تَقرَبنَّهُ فَهوَ شَرٌّ لِطاعِمِ",11,"م",1,0],["وَكُلُّ طَريفٍ لَهُ لَذَّةٌ","وَكُلُّ تَليدٍ سَريعُ البِلى",12,"ا",1,0],["وكلِّ طِمِرَّةٍ خَفِقٍ حَشَاهَا","تَذِفُّ ذَفيفَ صَفْراءِ الجرادِ",13,"د",1,0],["وَكُلُّ طَرِيقٍ أتَاهُ الفَتَى","على قَدَرِ الرِّجْلِ فيه الخُطَى",14,"ا",1,0],["وَكُلُ طود تَسامى فَهُوَ مُحتقر","إِذا بَدَت وَهَدة مِن نحوِ واديكا",15,"ك",2,0],["وَكُلِّ طَرفٍ فاتِنٍ لِحاظُهُ","يُذكي غَرامَ كُلِّ وَجدٍ فاتِرِ",16,"ر",1,0],["وكل طريق للمهذب مهيع","وفي كل ارض للأكارم منزل",17,"ل",1,0],["وكلُّ طائفةٍ قد بايعت ملكاً","لم يُلفِ من غارة الأسبانِ تحصينا",18,"ن",2,0],["وَكُلُّ طِرفٍ سابِحٍ يَغدو بِذِم","رٍ باسِلٍ بِالزَرَدِ الصافي التَحَف",19,"ف",1,0],["وَكُلُّ طِمِرٍّ فائتِ الشأوِ سابقٍ","له في موامي البيد عدوٌ وتَقريبُ",20,"ب",1,0],["وكل طرفي بها وفكري","فلا رياضٌ ولا رياضه",21,"ه",1,0],["وَكُلِّ طَموحِ الطَرفِ شَقّاءَ شَطبَةٍ","مُقَرَّبَةٍ كَبداءَ سَفواءَ مِمزَعِ",22,"ع",1,0],["وكلُّ طريفٍ من ثنائي ومُتْلَدٍ","حَذاهُ طريفٌ من نَداك ومُتْلَد",23,"د",1,0],["وكلّ طَويلِ السَّاعِدَين تَظنُّهُ","إذا قامَ يَوماً للعِناقِ مُطاعِنا",24,"ن",2,0],["وكلِّ طويلِ القدّ أسْمر ذابلٍ","وكُلِّ رقيقِ الشّفرتَيْن مُهَنّدِ",25,"د",1,0],["وكل طير ذكرٍ فيهم يرى","من هذه الأنواع سمّي بالجرى",26,"ر",2,0],["وكلّ طويل باعه وقناته","وما كلُّ باع للقناةِ طويل",27,"ل",1,0],["وكلُّ طارقِ إِلْهامٍ يُنازِلُني","قيَّدْتُهُ بقياسٍ غيرَ مَكْذوبِ",28,"ب",1,0],["وكلِّ طويلٍ كالرِّشاءِ مَدَدْتهُ","يناجيك منه رأسُهُ بسِنانِ",29,"ن",1,0],["وكل طرف","عليك حائم",30,"م",1,0],["وكل طائفة تخشى أفاضلهم","تبدو أراذلهم بالقبح والشوم",31,"م",1,0],["وكل طير له غذاء","وكل وحش له فلاة",32,"ه",1,0],["وكلُّ طالبِ عِلمٍ فاتَهُ مَدَدٌ","وكلُّ طالبِ رفدٍ فاتَهُ نِعَمُ",33,"م",1,0],["وكُلُّ طَرْفٍ صَارَ مَبذُولَهُ","مالم يَزَلْ يُسْمَى بمَخْزُونِه",34,"ن",2,0],["وكلُّ طرقي إليك تَشْرعُ في","شوارعٍ جمّةٍ وأسواق",35,"ق",1,0],["وكل طعامٍ أشتريه بما الحيا","فلا تحسبنْه كاشفا لعنائي",36,"ي",1,0],["وكلّ طيب طىّ ذاك النشر","وبسطت أكفها الدوالى",37,"ل",2,0],["وكل طريق هكذا عنك موعر","فلي طرق كانت إليك تهون",38,"ن",1,0],["وكلُّ طرير همه الدهر أن يرى","بكف كميّ باسل لا يُزايله",39,"ل",2,0],["وكلّ طَفلٍ كأنّ غُرّته ال","شمسُ أنارت من كِلّة الطّفَلِ",40,"ل",1,0],["وَكلَّ طِرْفٍ ارْمه بِمِسْحلِ","وكلَّ سيْفٍ بين لحييْ رَجُلِ",41,"ل",1,0],["وكلُّ طويلِ الرمحِ طبٌّ بِحَمْلِهِ","إذا شاءَ أبكاهُ دماً وهو ضاحك",42,"ك",1,0],["وكل طِرْفٍ طَرْفُه محدِّق","إلى الوغى يمرح في عنانه",43,"ه",1,0],["وكل طيبا أو ضدّه والبس الذي","تلاقيه من جل ولا تتقيّد",44,"د",1,0],["وكل طيرٍ آخذٌ في مغنى","وكل حزب منهم في معنى",45,"ن",2,0],["وكل طفل له من أهله حرسٌ","يحمونه يقظةً منه وحين غفا",46,"ف",2,0],["وَكُلُّ طَريدٍ هالِكٍ مُتَحَيِّرٌ","كَما هَلَكَ الحَيرانُ وَاللَيلُ مُظلِمُ",47,"م",1,0],["وَكُلِّ طَيرٍ صافرٍ وناعِقِ","مُكتَهلٍ أَو بالغٍ أَو نافقِ",48,"ق",1,0],["وكلّ طاويةِ الأحشاء ذابلةٍ","شديدَةِ الشدّ مثل الخاضبِ الزَعل",49,"ل",1,0],["وكل طموح إلى غاية","تراقب بالقلب والناظر",50,"ر",1,0],["وكل طلق المحيا لم يرع بوغى","قد اكتسى برد عزٍ بالظبا نسجا",51,"ج",2,0],["وَكُل طَرف إِلى الغايات حافرَهُ","يُسابق الطَرف مِنهُ في اِتبِاعَهُم",52,"م",1,0],["وكلُّ طَعامٍ لم يكن من طُهاتِها","سَقامٌ لنفسٍ لذَّ منهُ لها الأَكلُ",53,"ل",1,0],["وَكُلُّ طِرْفٍ إِذْا طالَ الطِّرادُ بِهِ","يَطِيرُ مِن جِلْدِهِ لَولا شَكائِمُهُ",54,"م",2,0],["وَكُلِّ طِمِرَّةٍ خَفِقٍ حَشاها","مُلَملَمَةٍ تَلاقيها بَعيدُ",55,"د",1,0],["وَكُلُّ طِمِرَّةٍ شَنحٍ نَساها","وَعَجلى الشَدِّ صادِقَةِ المِراحِ",56,"ح",1,0],["وكلِّ طِمِرَّةٍ مَرْطى سَبوحٍ","إذا ما شدَّ فارِسُها الحِزاما",57,"م",2,0],["وَكُلُّ طَاهٍ مُشتَوٍ قال أَتى","بماطَهَا وما اشتَوَى وما قَلَى",58,"ا",1,0],["وَكُلُّ طَموحٍ في الجِراءِ كَأَنَّها","إِذا أغتمسَت في الماءِ فتخاءُ كاسِرُ",59,"ر",1,0],["وكل طرس زهى بسطر","فذاك خدَّ وذا عذار",60,"ر",1,0],["وَكُلُّ طِباقٍ في الجَحيمِ عَرَفتُها","وَأَعرِفُ أَهليها وَمن ثَمَّ واضِعُ",61,"ع",1,0],["وكل طيرٍ قوّته إن هو مسك","حسب حجمه حر أو وكري صغير",62,"ر",1,0],["وكل طود إذا ما هاج يوم وغى","فالوحش في فرح والموت في تعب",63,"ب",1,0],["وكل طريقة خرجت وزاغت","عن المشروع بالقول المحال",64,"ل",1,0],["وكل طفل لكم نفسه عطاها","وش جني الطفل من ذنب وخطيه",65,"ي",2,0],["وكل طموحٍ جموح الخيال","أتيحت له جولةٌ جالها",66,"ل",3,0],["وكلِّ طاغيةٍ لو نرتضي معهُ","خِيَانَةَ الشعبِ جاءتْنا تهانيهِ",67,"ي",2,0]]}