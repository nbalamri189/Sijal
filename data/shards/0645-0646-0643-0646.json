{"poems":[[59,"قنعت بالقوت من زماني","https://www.aldiwan.net/poem24630.html","مجزوء البسيط"],[79,"لم يبق لي جود الولاية حاجة","https://www.aldiwan.net/poem36355.html","الكامل"],[79,"يا نجعة الوزراء والنواب","https://www.aldiwan.net/poem36707.html","الكامل"],[51,"المرء منظور إليه","https://www.aldiwan.net/poem63175.html","مجزوء الكامل"],[68,"من كنت أنت رسوله","https://www.aldiwan.net/poem39228.html","مجزوء الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[108,"دمعة على الخفيف","https://www.poetsgate.com/ViewPoem.aspx?id=179355",""],[146,"ليت الهوى يصرفه الراقى","https://www.aldiwan.net/poem58422.html","السريع"],[147,"ما أدرك الطلبات مثل مصمم","https://www.aldiwan.net/poem11813.html","الكامل"],[147,"إدراك وصفك ليس في الإمكان","https://www.aldiwan.net/poem11827.html","الكامل"],[173,"قالوا الدبيثي ذو قواف","https://www.aldiwan.net/poem1671.html",""],[234,"الحر لا يأتي الدنيه","https://www.aldiwan.net/poem50732.html","مجزوء الكامل"],[264,"ربنا إننا لهجنا بذكرك","https://www.aldiwan.net/poem35973.html","الخفيف"],[285,"يا حسنه قمرا وأنت سماؤه","https://www.aldiwan.net/poem60576.html","الكامل"],[422,"لو كنت حاضر طرفه وفؤاده","https://www.aldiwan.net/poem54051.html","الكامل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122541","الكامل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66735","السريع"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66749","السريع"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66669","الكامل"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112432","الكامل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53920","السريع"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63866","المنسرح"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72276","البسيط"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27981","البسيط"],[2298,"","https://poetry.dctabudhabi.ae/diwan/poem/203468",""],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100886","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201234","الخفيف"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145065","المجتث"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68022","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74063","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74059","البسيط"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74043","الكامل"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101231","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91310","الكامل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95356","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81931","الكامل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117309","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83194","الرجز"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139180","البسيط"],[4470,"","https://poetry.dctabudhabi.ae/diwan/poem/125354","الرمل"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67555","البسيط"],[4728,"ما لي بليلٍ أراني لا أجاوِلُهُ (فصحى)","https://www.poetsgate.com/ViewPoem.aspx?id=176892",""],[4978,"أحزنتني لا رأيت الهمّ والحزنا","https://www.poetsgate.com/ViewPoem.aspx?id=177377",""],[4987,"ماهو خطآ","https://www.poetsgate.com/ViewPoem.aspx?id=49576",""],[5136,"خذها هنيئاً أيها الهمام","https://www.poetsgate.com/ViewPoem.aspx?id=121692",""],[5212,"وارث النَّبي","https://www.poetsgate.com/ViewPoem.aspx?id=211736",""],[5277,"زد في تعلّاتي","https://www.poetsgate.com/ViewPoem.aspx?id=191051",""],[5277,"مسافرٌ..زادُهُ الرجوعُ","https://www.poetsgate.com/ViewPoem.aspx?id=200913",""],[5397,"الدين في مثل هذا اليوم قد كملا","https://www.poetsgate.com/ViewPoem.aspx?id=157899",""],[5703,"ليلى والذئب","https://www.poetsgate.com/ViewPoem.aspx?id=206325",""],[5781,"صهيلُ اللَّيلِ وعطره","https://www.poetsgate.com/ViewPoem.aspx?id=202851",""],[5784,"علم فؤادك","https://www.poetsgate.com/ViewPoem.aspx?id=189812",""],[5853,"نجوايَ","https://www.poetsgate.com/ViewPoem.aspx?id=175715",""],[5953,"يا سرّ مرَّى لقد أصبحت لي سكناً","https://www.poetsgate.com/ViewPoem.aspx?id=93789",""],[5956,"أحسِنْ إلى الفقراء وابعدْ عنهمو","https://www.poetsgate.com/ViewPoem.aspx?id=207268",""]],"verses":[["مَن كُنتُ عَن مالِهِ غَنِيّاً","فَلا أُبالي إِذا جَفاني",0,"ن",2,0],["مَنْ كُنْتَ وَالِيهِ تَوَلَّتْهُ الْعُلاَ","وَمَنِ اطَّرَحْتَ فَمَا لَهُ مِنْ وَالِي",1,"ل",2,0],["مَنْ كُنْتَ أَنْتَ حُسَامَهُ فَالنَّصْرُ سَا","رَ أَمَامَهُ حِزْباً مِنَ الأَحْزَابِ",2,"ب",1,0],["مَن كُنتَ تَبغي أَن تَكو","نَ الدَهرَ ذا فَضلٍ عَلَيهِ",3,"ي",2,0],["مَن كُنتَ أَنتَ رَسولَهُ","كانَ الجَوابُ قَبولَه",4,"ل",2,1],["مَن كنيْرُونَ أَتى بِالرَّسْمِ لَمْ","يَستعِرْ صِبْغاً لهُ أَوْ يُجْرِ حِبْرَا",5,"ر",2,0],["من كنتُ بالأمس في شعري أُداعبُهُ","ما بالُه اليوم قد أصبحت أرثيه؟",6,"ي",2,1],["من كُنْسها صدرى ومن روضها","قلبى ومن غُدرانها ماقى",7,"ق",2,0],["مَن كُنتَ يا فَخرَ المُلوكِ ظَهيرَهُ","فَبِناؤُهُ في المَجدِ لَم يَتَهَدَّمِ",8,"م",1,0],["مَن كُنتَ عُدَّتَهُ لِقَهرِ عُداتِهِ","ذَلَّ البَعيدُ لِعِزِّهِ وَالداني",9,"ن",2,0],["مَن كُنتَ أَوصَيتَ بِالمَعاصي","مِن هَذِهِ العُصبَةِ الأَثِيمَه",10,"م",2,0],["من كنتُ مولاه فقد","أضحَى أبو حَسَنٍ ولِيّه",11,"ي",2,0],["مِنكَ نَرجو التَوفيقَ سِرّاً وَجَهراً","فَجَميعُ القُلوبِ في قَيدِ أَسرِك",12,"ك",1,0],["مَنْ كُنْتَ أَنْتَ أَباهُ كانَ لِمَجْدِهِ","أَنْ يَسْتَطِيلَ وَأَنْ يُشادَ بِناؤُهُ",13,"ا",3,0],["من كنت أستصفي الحياةَ لقربه","أصْبَحْتُ أرتقبُ الرَّدى لبعاده",14,"د",2,0],["من كنت مولاه فأهل بيتي","وعترتي من بعد حين موتي",15,"ي",1,0],["مَن كنتَ تُعجبُه بِخدِّكَ أمرداً","مِن أينَ تُعجِبُه بِرأسِك أشيبا",16,"ب",2,0],["من كنتُ مولاه فهذا له","مَولىً فكونوا غيرَ كفَّارِ",17,"ر",1,0],["من كنتُ مولاهُ فهذا له","مَولىً فلا تَأبوا بتكفارِ",17,"ر",1,0],["من كنتُ مولاه فهذا له","مولىً فلم يَرضَوا ولم يَقنعوا",18,"ع",3,0],["من كنتُ مولاهُ فهذا فاعلموا","مولاهُ قولُ إشاعةٍ وصرُاحِ",19,"ح",1,0],["من كنز معلوماته أغنى الورى","وطغت معارفه كموج عباب",20,"ب",1,0],["مِنْ كَنْزِه يَكْثُر إنفاقُه","وهو كما كان به مُفْعَمُ",21,"م",1,0],["مَنْ كنزُ فيهِ لمن تَنَسَّمَهُ","نظيرُ ما في الكنيفِ يكنزُهُ",22,"ز",2,0],["من كنت مولى له هذا يكون له","مولى أتاني به أمر يؤكده",23,"د",2,0],["من كُنوزِ اليقينِ بَدرُ قُرَيشٍ","أحمدُ المُصطَفى عليه الثناء",24,"ا",2,0],["من كنت فيه أة كنت منه","أو كنته عنك ما رجعتا",25,"ت",2,0],["من كنتُ عن مالِه غنيَّاً","رأيته كالذي يراني",26,"ي",1,0],["منكنَّ بلقيسُ التي حُملت على","متنِ الرياح وحبذا الإسراء",27,"ا",2,0],["منكنَّ ربة مصرَ كليوبترة","لا النيل يجهلها ولا البطحاء",27,"ا",2,0],["منكنَّ إِلصابات كانت قوةً","تجرى السفينُ بأمرها والماء",27,"ا",2,0],["منكنَّ واهبة الألوف زبيدةٌ","منكنَّ شاعرةُ الحمى الخنساء",27,"ا",2,0],["منكنَّ أُم المؤمنين خديجةٌ","منكنَّ والدةُ الهُدَى العذراء",27,"ا",2,0],["منكَ نوري قبستُه فاهتديتُ","وجناي الشهيّ منك اجتنيتُ",28,"ت",1,1],["من كنت أرغب فيه","منهم فعنه رغبت",29,"ت",1,0],["من كنت أرجو أن تُرَدَّ شَبِيبَتي","بزمانه والغصنُ مني يُورِقُ",30,"ق",1,0],["مَن كنت أَنتَ أَبا لَهُ","فَبنوه قَد نهلوا وَعلوا",31,"ل",3,0],["من كنت أَرجوه للأماني","عادَ رَجائي بهِ عَقيما",32,"م",2,0],["مَن كنت أَنتَ صَحيبَهُ","عرف الوَفاء إِذا صحب",33,"ب",1,0],["من كنت مولاه فهذا حيدر","مولاه واللَه المهيمن يأمر",34,"ر",1,0],["مَن كُنتِِ أَنتِ مَرادَه كَم يَتعبُ","وَيُلامُ في هَذا الغَرام وَيَعتبُ",35,"ب",1,1],["من كنه ذاتك غير أن","ك واحدي الذات سرمد",36,"د",1,0],["مَن كُنةَ نَبتِ الأَرضِ طُرّاً سَبَرَت","وَلِلعَقاقيرِ جَميعاً خَبَرَت",37,"ت",1,0],["من كنت مولاه فهذا حيدر","مولى أشاد بفضله المعبود",38,"د",1,0],["من كنت أرجو بهم خلاصى","من جرم ذنبي يوم القصاص",39,"ص",1,0],["مَن كُنتَ مِنهُ آمِناً في سِربِك","فَذاكَ لَو عَلمتَ خَيرُ صَحبِك",40,"ك",1,0],["من كنت تعرفه كن فيه متئداً","يكفيك من خلقه ما أنت تعرفه",41,"ه",1,1],["من كنت هواه كيف يهلك","من كنت مناه كيف يحزن",42,"ن",1,0],["من كنت عن ماله غنياً","رأيته مثل ما يراني",43,"ن",2,0],["مَنْ كنتُ أهواهُ يوماً صرتُ أكرَهُهُ","ولا أُزاوِلُ وصلاً مَنْ يُزاوِلُهُ",44,"ل",2,0],["من كنت إبنًا له باقٍ بغرسته","أنعم بلحسنَ من غرسٍ وطيب جنا",45,"ن",2,0],["من كنت بأول خامسة طفل صغير","كنت امتلي حزن وغموض وكأبه",46,"ب",2,0],["منكنونه في سبعة طاف في","ساحتها ينزل أسنا مقام",47,"م",1,0],["مَنْ كُنْتُ مَولاهُ فَذا مولى لَهُ","نَصٌ جَليٌ واضِحُ البُرهانِ",48,"ن",1,0],["من كنت أحسبه رهينَ مودتي","وعثارُ قيلي قد رمته عواثرُ",49,"ر",1,0],["من كنتُ أحسبهُ رهينَ مودتي","وعثارَ قلبي لو رمتْهُ عواثرُ",50,"ر",1,0],["من كنت مولاه حقاً فالوصي له","مولى يمد له التوحيد حبل ولا",51,"ل",2,0],["مَنْ كُنتُ أَظُنُّ بِهِ وَحْشاً","أَوفى مِنْ آلافِ البَشَرِ",52,"ر",1,0],["مَنْ كنتُ أَسْأَلُهُ الرِّضَا فيَصُدُّني","هَجْرًا إليْهِ بُكْرَةً وأَصيلا",53,"ل",2,0],["من كنتٙ يوما في الحياة خليله","نال المنى وتجاوز المأمولا",54,"ل",2,0],["من كنت ُ أحسبها للقلب راوية","أمست لها حجة والآن تفطمني",55,"ن",2,0],["من كنه سر سرير السر مقتبساً","من بحر سلسل بحر الميم مقبسنا",56,"ن",2,0],["مَن كنت تحسبُه وفيّا وادِعاً","تلقاه دُوداً يغتذيك ويحكُمُ",57,"م",1,0]]}