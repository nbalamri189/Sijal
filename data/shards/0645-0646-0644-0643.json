{"poems":[[168,"يا ظبية أشبه شيء بالمها","https://www.aldiwan.net/poem67810.html","الرجز"],[287,"فيك عذولي عذرا","https://www.aldiwan.net/poem32763.html","مجزوء الرجز"],[463,"قم فانتشِطها حسبها أن تعقلا","https://www.aldiwan.net/poem55915.html","الكامل"],[463,"تمد بالآذان والمناخر","https://www.aldiwan.net/poem56185.html","الرجز"],[463,"من ناظر لي بين سلعٍ وقبا","https://www.aldiwan.net/poem56276.html","الرجز"],[503,"يا راكضاً في طلاب دنيا","https://www.aldiwan.net/poem3693.html","مخلع البسيط"],[556,"من لداع لا يجاب","https://www.aldiwan.net/poem48097.html","مجزوء الرمل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119934","المنسرح"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112766","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46562","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46557","الرجز"],[2536,"","https://poetry.dctabudhabi.ae/diwan/poem/131683",""],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67994","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216576","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83480","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72460","الرجز"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139750",""],[4728,"ابتهالات لله","https://www.poetsgate.com/ViewPoem.aspx?id=176966",""],[5785,"لا زالت الأيام لك يوم عيد","https://www.poetsgate.com/ViewPoem.aspx?id=131578",""]],"verses":[["مَن لَكَ بِالمُهَذَّبِ النَدبِ الَّذي","لا يَجِدُ العَيبُ إِلَيهِ مُختَطى",0,"ا",1,0],["مَن لِكَئيبٍ قَد جَفا","أَجفانَهُ طيبُ الكَرى",1,"ر",2,0],["من لكُمُ بني أبيه من لكُمْ","لولاه يبني ماابتنى من العلا",2,"ل",2,0],["من لك بالناس ولا ناسٌ همُ","إلا كلامُ المُحرِجِ المكاشِرِ",3,"ر",1,0],["من لك مثلي بأخٍ مسامحٍ","ترضيه بالعذرِ إذا ما غضبا",4,"ب",2,0],["مَن لَكَ بِالرِيِّ مِن شَراب","يَشتَدُّ مِن شُربه العطاشُ",5,"ش",1,0],["مَن لَكُم مِثلي إِذا عنَّ","طِعانٌ أو ضِرابُ",6,"ب",1,0],["من لك عم في الفضل يحذو","حذوي ولو أنه المعري",7,"ر",2,0],["من لكسير مستجير","يا سليل الشرفا",8,"ف",2,0],["مَن لَكَ بِالمُهذب","الكامل المُؤدب",9,"ب",1,0],["مَن لَك بالصدوق","وَحافظ الحُقوق",10,"ق",1,1],["من لك وعاد انت غير مختون","ولا عروق فيك ولا عظام",11,"م",1,0],["من لكِ اليومَ يَا ريام فهذِي","عُصبة الله والنفوسُ غِذاها",12,"ا",3,0],["من لكولمب والمخاوف تثني","ه وتزجيه خادعات الغرور",13,"ر",1,1],["من لكولمب لا السماوات تهدي","ه ولا النور في دجاهُ بنور",13,"ر",1,0],["من لكربي الشَديد يفرجُ كربي","وَحَياتي جَميعُها آلامُ",14,"م",1,0],["من لك يا من تبتغي شأواه في","مستصعب المسلك وعر المرتقى",15,"ا",1,0],["مَن لكلٍ أمرُ العوالم مُنهىً","وبكلٍ كلُّ الوجود مصان",16,"ن",1,0],["من لك يقيمون الصلاة وبك يعدّون الجهاد","بامرك نشت سحب وهطل ماطر وباعقابه برد",17,"د",1,0],["من لك عقد في الحسن ملك الرشيد","لو علمك بالوصل جوده",18,"د",2,0]]}