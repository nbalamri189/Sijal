{"poems":[[95,"بحمدون إن تنشق عليل نسميها","https://www.aldiwan.net/poem11393.html","الطويل"],[89,"ومسرح لسوام العين ليس له","https://www.aldiwan.net/poem8203.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54875","المجتث"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54768","الوافر"],[147,"هل العدل إلا دون ما أنت مظهر","https://www.aldiwan.net/poem11762.html","الطويل"],[147,"ظن الأراك لدى واديه أظعانا","https://www.aldiwan.net/poem11832.html","عموديه"],[303,"لمن وبمن عسى يرجى العزاء","https://www.aldiwan.net/poem36264.html","عموديه"],[309,"لجيران لنا بالأبطيحه","https://www.aldiwan.net/poem16836.html","الوافر"],[325,"نيشان مجد للخليل أسنى","https://www.aldiwan.net/poem67180.html","الرجز"],[415,"كناس سرب المها عريسة الأسد","https://www.aldiwan.net/poem32224.html","البسيط"],[543,"بما بيننا من حرمة ايها الصحب","https://www.aldiwan.net/poem48303.html","عموديه"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59418","الخفيف"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46555","الرجز"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44868","البسيط"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48925","الطويل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26403","الوافر"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104698","الطويل"],[2176,"","https://poetry.dctabudhabi.ae/diwan/poem/69498","البسيط"],[2211,"","https://poetry.dctabudhabi.ae/diwan/poem/121916","الطويل"],[2332,"","https://poetry.dctabudhabi.ae/diwan/poem/82236","البسيط"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205431","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201956","السريع"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199962","المتقارب"],[2954,"","https://poetry.dctabudhabi.ae/diwan/poem/138922",""],[3098,"","https://poetry.dctabudhabi.ae/diwan/poem/131897","الطويل"],[3222,"","https://poetry.dctabudhabi.ae/diwan/poem/70397","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205733","الطويل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128920","السريع"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125853","الرجز"],[5072,"لا تدعها","https://www.poetsgate.com/ViewPoem.aspx?id=52557",""],[5956,"مناهل إلهامي","https://www.poetsgate.com/ViewPoem.aspx?id=185878",""]],"verses":[["مَنَاظِرُ وَالمَرْآةُ تُجْلَى حِيَالَهَا","تُريكَ أَفَانِينَ الْحِلَى كَيْفَ تُنْظَمُ",0,"م",1,0],["مَنَاظِرٌ لَوْ رَأَى بَهْزَادُ صُورَتَهَا","لاعْتَادَهُ مِنْ تَمَادِي الْحَيْرَةِ الْبَلَهُ",1,"ه",1,0],["مَنَاظِرٌ رَائِعَاتٌ","مِرْآتُهُنّ الغَدِيرُ",2,"ر",1,0],["مَنَاظِرُ تَخْلُبُ الأَلْبَابَ حُسْناً","رَوَابِيهَا الْبَدِيعَةُ وَالمِهَادُ",3,"د",1,0],["مَناظِرُ راقَت لَم تُعِنها مَخابِرٌ","وَما كُلُّ دَوحٍ راقَ رائيهِ مُثمِرُ",4,"ر",1,0],["مَن أَظهَرَ العَدلَ في الآفاقِ فَاِمتَنَعَت","ظِباءُ وَجرَةَ مِن آسادِ خَفّانا",5,"ن",2,0],["مناظرُ سمجةٌ وَسخيفُ لغوٍ","فقلْ أَينَ التصاممُ والعماءُ",6,"ا",2,0],["مناظر للنواظر من قلوب","مطهرة زكيات نقيه",7,"ي",2,0],["مَناظِرُ أَعمالِهِ بِدِقَّةٍ","وَما إِلَيهِ جَلَّ قَدراً دَقَّهُ",8,"ه",1,0],["مَن أظهرَ الجُودَ والإقدامَ إذ عُدِمَا","إلى الوُجود بضرب الهامِ والصَّفَدِ",9,"د",1,0],["مناظِرهُم تُعدِي فحسبُكَ مِنهُمُ","فٍِرارٌ فهم بين الورَى إبلٌ جُربُ",10,"ب",1,0],["من أظهر هارون وصفه لكتاب","قد أوقف شمس الضحى ليوشع إنصال",11,"ل",1,0],["مَن أَظَهر الشَر اِتقى","مَن طَلَبَ الذكر بَقى",12,"ق",2,0],["مَن أَظهَر البَغي صرع","مَن طَلبَ العز قَنع",12,"ع",1,0],["مِن أَظهُرِ الكُتبِ أَقتَنيها","وَخَلِّ مَا تَحتَوي البُحورُ",13,"ر",1,1],["مناظرُ نبعٍ يسحر العينَ حسنُها","ويجلو عن الأبصار همَّ البصائر",14,"ر",1,0],["مَناظِرُ لا يَزالُ الدينُ مِنها","عَزيزَ النَصرِ مَمنوعَ المَرامِ",15,"م",1,0],["مِنَ اظهُرِ أصلاَبٍ لأَرحامِ تَكمُلُ","بهِ رِفعَةً فالظَّهرُ أًَطيَبُ أفضَلُ",16,"ل",1,0],["مَناظِرٌ ذاتُ أَبوابٍ مُفَتَّحَةٍ","أَنيقَةٍ بِزَخاريفٍ وَتَزينِ",17,"ن",1,0],["مناظر حتف بل مراكز هلكة","تشتت شمل الصبر من كل خاطر",18,"ر",1,0],["مناظر ذات أبواب مفتحة","أنيقة بزخاريف وتزيين",19,"ن",1,0],["مناظر هذي الطبيعة رسم","وذهنك أنت إطار الصور",20,"ر",1,0],["مناظرٌ في صور فتّانةٌ","محتاجة لأعين تنظر",21,"ر",1,0],["مناظر منها الحجى يذهلُ","ففيها لكل المنى منهلُ",22,"ل",1,1],["مناظر تدهش أفكار الورى","رأيت روضاً ضاع في كنهور",23,"ر",1,0],["مناظرها تعزى الى ضد وصفها","فلا حسن فيها لرب البصيرة",24,"ر",2,0],["مناظرة تحمي النفوسَ فتنتهي","وَقَدْ شرعوا فِيهَا إِلَى شر مشرع",25,"ع",1,0],["مناظر من سحر الجمال أراها","ولولا سناها قلت كنت أراها",26,"ا",3,1],["مناظر قد راقت الطفل في","جمالها الخلاب ذاك الفريد",27,"د",1,0],["مناظر جميلة","أَزْرتْ بها المخابر",28,"ر",1,0],["مناظرُها بحب ِّ الله ِ تحلو","وفي الإسلام ِ تكتمل ُ المناظر",29,"ر",1,0],["مناظرُ خِرْفانٍ بوادٍ وتلَّة","تظنُّ عُواءَ الذئب سهما مُسمَّما",30,"م",2,0]]}