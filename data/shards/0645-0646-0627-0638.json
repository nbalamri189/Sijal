{"poems":[[93,"بحمدون إن تنشق عليل نسميها","https://www.aldiwan.net/poem11393.html","الطويل"],[87,"ومسرح لسوام العين ليس له","https://www.aldiwan.net/poem8203.html","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54875","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54768","الوافر"],[144,"هل العدل إلا دون ما أنت مظهر","https://www.aldiwan.net/poem11762.html","الطويل"],[144,"ظن الأراك لدى واديه أظعانا","https://www.aldiwan.net/poem11832.html","عموديه"],[299,"لمن وبمن عسى يرجى العزاء","https://www.aldiwan.net/poem36264.html","عموديه"],[305,"لجيران لنا بالأبطيحه","https://www.aldiwan.net/poem16836.html","الوافر"],[321,"نيشان مجد للخليل أسنى","https://www.aldiwan.net/poem67180.html","الرجز"],[410,"كناس سرب المها عريسة الأسد","https://www.aldiwan.net/poem32224.html","البسيط"],[539,"بما بيننا من حرمة ايها الصحب","https://www.aldiwan.net/poem48303.html","عموديه"]],"verses":[["مَنَاظِرُ وَالمَرْآةُ تُجْلَى حِيَالَهَا","تُريكَ أَفَانِينَ الْحِلَى كَيْفَ تُنْظَمُ",0,"م",1,0],["مَنَاظِرٌ لَوْ رَأَى بَهْزَادُ صُورَتَهَا","لاعْتَادَهُ مِنْ تَمَادِي الْحَيْرَةِ الْبَلَهُ",1,"ه",1,0],["مَنَاظِرٌ رَائِعَاتٌ","مِرْآتُهُنّ الغَدِيرُ",2,"ر",1,0],["مَنَاظِرُ تَخْلُبُ الأَلْبَابَ حُسْناً","رَوَابِيهَا الْبَدِيعَةُ وَالمِهَادُ",3,"د",1,0],["مَناظِرُ راقَت لَم تُعِنها مَخابِرٌ","وَما كُلُّ دَوحٍ راقَ رائيهِ مُثمِرُ",4,"ر",1,0],["مَن أَظهَرَ العَدلَ في الآفاقِ فَاِمتَنَعَت","ظِباءُ وَجرَةَ مِن آسادِ خَفّانا",5,"ن",2,0],["مناظرُ سمجةٌ وَسخيفُ لغوٍ","فقلْ أَينَ التصاممُ والعماءُ",6,"ا",2,0],["مناظر للنواظر من قلوب","مطهرة زكيات نقيه",7,"ي",2,0],["مَناظِرُ أَعمالِهِ بِدِقَّةٍ","وَما إِلَيهِ جَلَّ قَدراً دَقَّهُ",8,"ه",1,0],["مَن أظهرَ الجُودَ والإقدامَ إذ عُدِمَا","إلى الوُجود بضرب الهامِ والصَّفَدِ",9,"د",1,0],["مناظِرهُم تُعدِي فحسبُكَ مِنهُمُ","فٍِرارٌ فهم بين الورَى إبلٌ جُربُ",10,"ب",1,0]]}