{"poems":[[55,"أما كنت مع الحي","https://www.aldiwan.net/poem29741.html","الهزج"],[63,"لقد نزعت من عقد ثغرك درة","https://www.aldiwan.net/poem51366.html","الطويل"],[52,"ألا قل لعبدة إن جئتها","https://www.aldiwan.net/poem63871.html","المتقارب"],[287,"ألا ليت شعري هل أراني ساحبا","https://www.aldiwan.net/poem32842.html","الطويل"],[303,"تسر الناظرين فراشتان","https://www.aldiwan.net/poem36854.html","عموديه"],[369,"أقلا عند طيتي المقالا","https://www.aldiwan.net/poem60808.html","الوافر"],[412,"ليهن كلاك مداها القصي","https://www.aldiwan.net/poem50088.html","المتقارب"],[443,"سقاه الصبا خمر الدلال المردد","https://www.aldiwan.net/poem2561.html","الطويل"],[469,"تلقاك يا سعد بالنجح سعد","https://www.aldiwan.net/poem3152.html","عموديه"],[534,"لعمرك ما جانبت في الحق لي رهطا","https://www.aldiwan.net/poem37346.html","الطويل"],[556,"خذوا من جفوني ماءها فهي ذرف","https://www.aldiwan.net/poem47400.html","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70834","الوافر"],[1544,"","https://poetry.dctabudhabi.ae/diwan/poem/111123","الطويل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129835","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205057","الوافر"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74292","الطويل"],[5408,"أدر كأسا","https://www.poetsgate.com/ViewPoem.aspx?id=190870",""],[5605,"بنا عجب","https://www.poetsgate.com/ViewPoem.aspx?id=159671",""]],"verses":[["إِذا ما ثَوَّبَ الداعي","إِلى المَوتِ تَداعَينا",0,"ن",2,0],["إذا ما ثناياك العذاب تألفت","فبعدا لضرس لا يشاكلها بعدا",1,"د",2,0],["إِذا ما ثَنَت جيدَها نَظرَةٌ","حَسِبتَ الغَزالَ بِها عاقِدا",2,"د",2,0],["إِذا ما ثُغورُ الأُقحُوانِ تَبَسَّمَت","فَأَضحى بِها وَعرُ الزَمانِ دَميثا",3,"ث",2,0],["إِذا ما ثارتا فشرارتانِ","وإِما قرّتا فشقيقتان",4,"ن",1,0],["إذا ما ثارَ دونَ الدّينِ خَصْمٌ","بَلَوا منه أَشَدّ فتىً مِحالا",5,"ل",2,0],["إِذا ما ثَنى التيه أَعطافها","تَضَوَّع من نشرها المَندَليّ",6,"ي",1,0],["إذا ما ثناياه تجسّم برقُها","سُقيت سحابا من سلافة صرخد",7,"د",1,0],["إذا ما ثنى التيهُ أعطافه","وأبدى من الحسن ما ليس يبدو",8,"د",2,0],["إذا مَاثَنَتْنِي أَلْسُنُ العَذْلِ عَنْ هُدىً","فَلاَ حَمَلَتْ كَفِّي رَوَاقِميَ الرَّقْطَا",9,"ط",2,0],["إِذا ما ثنوا تلك الوسائد مُيَّلاً","أُدِيرَتْ عليهمْ في الزّجاجةِ قَرْقَفُ",10,"ف",1,0],["إذا ما ثار يَرْهبُه الْ","هصورُ الضيْغمُ الضارى",11,"ر",2,0],["إذا ما ثغور البيض يوماً تبسمت","يكلم من يرضي بألسنة السمر",12,"ر",1,0],["إذا ما ثنى الرمح الطويل كأنّه","مدير لغصن الخيزران لعوبُ",13,"ب",1,0],["إذا ما ثار مندفعا شعوري","فليس يصده السيف الصقيل",14,"ل",1,0],["إِذا ما ثَنى ريح الشَمال غُصونها","تَوهمتها قامات غيد تكسر",15,"ر",1,0],["إذا ما ثرتها ولك اطمأنت","تنادي للوصال ألا تهيّا",16,"ي",2,0],["إذا ما ثورة نَشَبَتْ","هَوَى الحُكَّامُ واحتجبوا",17,"ب",3,0]]}