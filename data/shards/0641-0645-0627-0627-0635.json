{"poems":[[65,"وغادة تشهد الحسان لها","https://www.aldiwan.net/poem45708.html","المنسرح"],[74,"سقى صوب الغمام زمان وصل","https://www.aldiwan.net/poem20293.html","الوافر"],[53,"أبو عثمان والرومي","https://www.aldiwan.net/poem64019.html","الهزج"],[26,"أمنك البرق أرقبه فهاجا","https://www.aldiwan.net/poem24077.html","الوافر"],[87,"يود الناس لو يدورن","https://www.aldiwan.net/poem7358.html","مجزوء الوافر"],[30,"وإن كان قد صلى ثمانين حجة","https://www.aldiwan.net/poem5386.html","الطويل"],[164,"يا من بنعماه لحمي نابت ودمي","https://www.aldiwan.net/poem58990.html","البسيط"],[228,"وما سرى في مقاصير اللظى خبر","https://www.aldiwan.net/poem41466.html","البسيط"],[303,"صبا المشتاق لما أن رآها","https://www.aldiwan.net/poem36330.html","عموديه"],[369,"شفته تحيات العيون العلائل","https://www.aldiwan.net/poem60810.html","الطويل"],[443,"أزال لقياك ما ألقى من الحزن","https://www.aldiwan.net/poem2603.html","البسيط"],[469,"رأى وقفة البين خطباً فطيعاً","https://www.aldiwan.net/poem3503.html","عموديه"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101467","الوافر"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54192","البسيط"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137619",""],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62533","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119922","الطويل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52028","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28031","البسيط"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99074","الهزج"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205879","الهزج"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35574","الوافر"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102737","البسيط"],[5009,"إليك يابن الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=68819",""],[5232,"الفاجعة","https://www.poetsgate.com/ViewPoem.aspx?id=213662",""],[5376,"على مشارفِ عيد اللهِ مبتسمٌ","https://www.poetsgate.com/ViewPoem.aspx?id=205890",""],[5725,"ونالت من الروح ما لا ينال","https://www.poetsgate.com/ViewPoem.aspx?id=209167",""],[5978,"رسالة إلى المتنبي","https://www.poetsgate.com/ViewPoem.aspx?id=191364",""]],"verses":[["فَما اِصطَلَتْ غَيرَ مِجمَرٍ أَرِجٍ","وَلا اِمتَرَتْ ضَرعَ لِقحَةٍ يَدُها",0,"د",3,0],["فما أصغت لداعي القرب أذنٌ","إلى أن مدَّ داعي البين عينا",1,"ن",2,0],["فما أصبحت من بأسٍ","ولا شعري بذي فقر",2,"ر",1,0],["فَما أَصحى هَمِيُّ الماءِ حَتّى","كَأَنَّ عَلى نَواحي الأَرضِ ساجا",3,"ج",2,0],["فما أصبحت منصورا","ولا أمسيت مقهورا",4,"ر",2,0],["فَما أَصبَحَت في الأَرضِ نَفسٌ فَقيرَةٌ","وَلا غَيرُها إِلّا سُلَيمانُ مالُها",5,"ل",3,0],["فما أصادق إلا من يصادقه","ولا ألائم إلا صادق الخدم",6,"م",1,0],["فَما أَصاخَ إِلى الأَنغامِ يَعزِفُها","رَهط مِن الجِنِّ حَتّى مَسَّهُ خَدرُ",7,"ر",1,0],["فما أصباك يا ابن العم منها","أعيناها بربّكَ أم طلاها",8,"ا",3,0],["فما أصبحَتْ إلاّ منَ الجيشِ حالياً","لها الجِيدُ في يومٍ منَ الشَّمْسِ عاطل",9,"ل",1,0],["فما أصخت لتلحاء ومعتبة","لكنما سنني جربا على السنن",10,"ن",1,0],["فما اصحبُ الجسمَ إلاّ سقيماً","يذوب ولا الطَّرفَ إلاَّ دموعا",11,"ع",2,0],["فما أصوات ممنونٍ يغني","شروقَ الشمس اذ رتع الظليم",12,"م",1,0],["فَمَا أصابُوا بما ظنُّوا وما اعْتقَدُوا","فكلُّ شيءٍ أراهُ منه لي حَسَنَا",13,"ن",2,0],["فما أصغر القلب حجما وأوعا","ه نفعا عظيما وتفريج كرب",14,"ب",1,0],["فما أصباهم عنه لجين","ولا ذهب ولا نظروه شزرا",15,"ر",2,0],["فما اصفر وجه المجتديه برده","ولا عاد عن أبوابه بيد صفرِ",16,"ر",1,0],["فمَا أصْبَحَتْ إلاّ رسُومُ ديَارِهِمْ","وليس عَلَيْهَا غَيْرُ نَاعٍ وَناعِبِ",17,"ب",1,0],["فما أصلّي بهم إلا قرأت لهم","من القرآن لما فيه لأيلافِ",18,"ف",1,0],["فما أصنع في مصر","إذا لم أحظ في مصر",19,"ر",1,0],["فما أصغر ما ألقا","ه منه بين جدراني",20,"ن",2,0],["فَما أَصبوا إِلى عَبّ الحَميّا","وَلا أَهفو إِلى نَغم الغَريضِ",21,"ض",1,0],["فما أصاخ إلى قولى وموعظتي","حتى رمى من صروف الحب بالعبر",22,"ر",1,0],["فما أصابك من ضراء فارض وقل:","رب احتسبها لنا ذخراً، لنا فَرَطا",23,"ط",2,0],["فما أصفاكَ عاطفةً وقلبا ً","وما أحلاكَ معسول الرَّحيقِ !.",24,"ق",1,0],["فما أصابَ برمْيٍّ بعد رمْيَتِهِ","إلا هواكِ وما ذا الحبُّ يُجتلبُ",25,"ب",1,0],["فما أصعب السر يا حلوتي","اذا ضيعتْه صدور الرجالْ",26,"ل",1,0],["فما أصابوهُ لكنْ شمسُهمْ غربت","لما تعالى فَسَدَّ الشمسَ بالحُجُبِ",27,"ب",1,0]]}