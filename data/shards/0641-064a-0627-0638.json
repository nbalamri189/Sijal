{"poems":[[53,"أذاع بذي العهد عرفانه","https://www.aldiwan.net/poem29731.html","المتقارب"],[53,"أصبت بعيني من أصاب بعينه","https://www.aldiwan.net/poem29873.html","الطويل"],[77,"ألا هكذا تبنى المدارس للعلم","https://www.aldiwan.net/poem36089.html","الطويل"],[70,"أغصن النقا لولا القوام المهفهف","https://www.aldiwan.net/poem42817.html","الطويل"],[62,"هي العيس قودا في الأزمة تنفخ","https://www.aldiwan.net/poem52455.html","الطويل"],[74,"شراب الأماني لو علمت سراب","https://www.aldiwan.net/poem12869.html","الطويل"],[33,"أبى الله أن تبقى لحي بشاشة","https://www.aldiwan.net/poem25900.html","الطويل"],[75,"صغائر افعال الملوك عظائم","https://www.aldiwan.net/poem69021.html","الطويل"],[90,"الشاعر المقبور","https://www.poetsgate.com/ViewPoem.aspx?id=178931",""],[188,"إلا أنت","https://www.aldiwan.net/poem35679.html","عموديه"],[199,"أناديك يا قلب مذ ودعوا","https://www.aldiwan.net/poem45607.html","المتقارب"],[210,"فؤاد قد أضر به التنائي","https://www.aldiwan.net/poem13441.html","الوافر"],[271,"تطاول ليلي بعد ليلى بثهمد","https://www.aldiwan.net/poem52073.html","الطويل"],[353,"خذي من ودادي العين يا قرة العين","https://www.aldiwan.net/poem39773.html","الطويل"],[353,"هواي سليم الود لا متشاعث","https://www.aldiwan.net/poem40551.html","الطويل"],[416,"ملكت فؤاد صبك في جمالك","https://www.aldiwan.net/poem54024.html","الوافر"],[458,"متى وصلت تحية مستهامِ","https://www.aldiwan.net/poem55870.html","الوافر"],[464,"أإن بعدت لمياء والإلف ينزح","https://www.aldiwan.net/poem3417.html","عموديه"],[558,"إلى الله نرفع أمرا ألم","https://www.aldiwan.net/poem34070.html","المتقارب"],[558,"لذاتي بذاتي لا لكم أنا ظاهر","https://www.aldiwan.net/poem34556.html","الطويل"]],"verses":[["فَيا ظالِماً طَيِّباً ظُلمُهُ","كَثيراً عَلى القَلبِ أَعوانُهُ",0,"ن",2,0],["فَيا ظالِماً تَستَحسِنُ النَفسُ ظُلمَهُ","وَيا قاتِلاً يَستَعذِبُ القَلبُ قَتلَه",1,"ل",2,0],["فَيَا ظَاعِناً لِلْعِلْمِ يَطْلُبُ رِحْلَةً","كُفِيتَ اعْتَرِاضَ الْبِيدِ أَوْ لُجَجَ الْيَمِّ",2,"م",1,0],["فَيا ظَبيُ هَلّا كانَ فيكَ التِفاتَةٌ","وَيا غُصنُ هَلّا كانَ فيكَ تَعَطُّفُ",3,"ف",1,0],["فيا ظَعَناتِ الحيِّ باللّه عَرِّجِي","على سَلْسَلٍ من عبرتي يتنضَّخُ",4,"خ",1,0],["فَيا ظاعِناً قَد حُطَّ مِن ساحَةِ البِلى","بِمَنزِلِ بَينٍ لَيسَ عَنهُ إِيابُ",5,"ب",1,0],["فَيا ظَبيُ كُل رَغداً هَنيئاً وَلا تَخَف","فَإِنَّكَ لي جارٌ وَلا تَرهَبِ الدَهرا",6,"ر",2,0],["فيا ظالم الأموال كيف قدرت أن","تضاف إلى الإنصاف واسمك ظالم",7,"م",1,0],["فيا ظلمة الآمال عني تقشعي","فقد تتجلى عن فؤادي دياجره",8,"ر",2,0],["فيا ظَهري المطعون بالخنجر الذّي","على خيري الموصول قد شَبَّ حامِلُه",9,"ل",2,0],["فيا ظبيُ كيفَ أسلتَ الحشا","وكنتَ بوادي الحشااترتعُ",10,"ع",1,0],["فيا ظمأي لبحر كان جودا","يفيض لنا نداه بالوفاء",11,"ا",2,0],["فَيا ظامىء الآمال ليلك وَالسرى","وَزر بحر جود مخصب السوح مخضرا",12,"ر",2,0],["فَيا ظبية السرب الَّتي سَفَكَت دَمي","بِفَتك نِصال العين أَنتَ عَلى عيني",13,"ن",2,0],["فَيا ظَبيُ مَهلاً إِنَّ طَرفك فاتن","وَفي عقد الأَلباب بِالسحر نافثُ",14,"ث",1,0],["فيا ظَبي الصَّريم وأنت ريمٌ","لكم قُنِصَتْ أُسودٌ في حبالك",15,"ك",1,0],["فيا ظبياتُ إن خِفتُنَّ عقبَى","فخَفْنَ اللهَ في قَتْلَى الغرامِ",16,"م",1,0],["فيا ظبيةَ الوعساء من أيمن الحمى","حلفت من جوى قلبي وإني لمترحُ",17,"ح",1,0],["فيا ظاهراً والسوى باطن","ويا باطناً والسوى مرتسم",18,"م",1,0],["فيا ظاهراً في خلقه وهو باطن","ويا باطناً في أمره وهو ظاهر",19,"ر",1,0]]}