{"poems":[[55,"أذاع بذي العهد عرفانه","https://www.aldiwan.net/poem29731.html","المتقارب"],[55,"أصبت بعيني من أصاب بعينه","https://www.aldiwan.net/poem29873.html","الطويل"],[79,"ألا هكذا تبنى المدارس للعلم","https://www.aldiwan.net/poem36089.html","الطويل"],[72,"أغصن النقا لولا القوام المهفهف","https://www.aldiwan.net/poem42817.html","الطويل"],[64,"هي العيس قودا في الأزمة تنفخ","https://www.aldiwan.net/poem52455.html","الطويل"],[76,"شراب الأماني لو علمت سراب","https://www.aldiwan.net/poem12869.html","الطويل"],[35,"أبى الله أن تبقى لحي بشاشة","https://www.aldiwan.net/poem25900.html","الطويل"],[77,"صغائر افعال الملوك عظائم","https://www.aldiwan.net/poem69021.html","الطويل"],[92,"الشاعر المقبور","https://www.poetsgate.com/ViewPoem.aspx?id=178931",""],[192,"إلا أنت","https://www.aldiwan.net/poem35679.html","عموديه"],[203,"أناديك يا قلب مذ ودعوا","https://www.aldiwan.net/poem45607.html","المتقارب"],[214,"فؤاد قد أضر به التنائي","https://www.aldiwan.net/poem13441.html","الوافر"],[276,"تطاول ليلي بعد ليلى بثهمد","https://www.aldiwan.net/poem52073.html","الطويل"],[358,"خذي من ودادي العين يا قرة العين","https://www.aldiwan.net/poem39773.html","الطويل"],[358,"هواي سليم الود لا متشاعث","https://www.aldiwan.net/poem40551.html","الطويل"],[422,"ملكت فؤاد صبك في جمالك","https://www.aldiwan.net/poem54024.html","الوافر"],[463,"متى وصلت تحية مستهامِ","https://www.aldiwan.net/poem55870.html","الوافر"],[469,"أإن بعدت لمياء والإلف ينزح","https://www.aldiwan.net/poem3417.html","عموديه"],[563,"إلى الله نرفع أمرا ألم","https://www.aldiwan.net/poem34070.html","المتقارب"],[563,"لذاتي بذاتي لا لكم أنا ظاهر","https://www.aldiwan.net/poem34556.html","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83319","الطويل"],[849,"","https://poetry.dctabudhabi.ae/diwan/poem/105612","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120057","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79816","الطويل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48969","الطويل"],[2211,"","https://poetry.dctabudhabi.ae/diwan/poem/121914","الوافر"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67237","الوافر"],[2431,"","https://poetry.dctabudhabi.ae/diwan/poem/139809",""],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100755","المتقارب"],[3150,"","https://poetry.dctabudhabi.ae/diwan/poem/82364","الطويل"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145048","الوافر"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100187","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67980","الطويل"],[3506,"","https://poetry.dctabudhabi.ae/diwan/poem/107335","المتقارب"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123931","المتقارب"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91445","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206138","المتقارب"],[3974,"","https://poetry.dctabudhabi.ae/diwan/poem/105557","الطويل"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93313","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136489",""],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136503",""],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104513","الهزج"],[5302,"خليلي زورا","https://www.poetsgate.com/ViewPoem.aspx?id=200132",""],[2079,"إلى كم أداري والحبيب نفور","https://www.poetsgate.com/ViewPoem.aspx?id=123849",""]],"verses":[["فَيا ظالِماً طَيِّباً ظُلمُهُ","كَثيراً عَلى القَلبِ أَعوانُهُ",0,"ن",2,0],["فَيا ظالِماً تَستَحسِنُ النَفسُ ظُلمَهُ","وَيا قاتِلاً يَستَعذِبُ القَلبُ قَتلَه",1,"ل",2,0],["فَيَا ظَاعِناً لِلْعِلْمِ يَطْلُبُ رِحْلَةً","كُفِيتَ اعْتَرِاضَ الْبِيدِ أَوْ لُجَجَ الْيَمِّ",2,"م",1,0],["فَيا ظَبيُ هَلّا كانَ فيكَ التِفاتَةٌ","وَيا غُصنُ هَلّا كانَ فيكَ تَعَطُّفُ",3,"ف",1,0],["فيا ظَعَناتِ الحيِّ باللّه عَرِّجِي","على سَلْسَلٍ من عبرتي يتنضَّخُ",4,"خ",1,0],["فَيا ظاعِناً قَد حُطَّ مِن ساحَةِ البِلى","بِمَنزِلِ بَينٍ لَيسَ عَنهُ إِيابُ",5,"ب",1,0],["فَيا ظَبيُ كُل رَغداً هَنيئاً وَلا تَخَف","فَإِنَّكَ لي جارٌ وَلا تَرهَبِ الدَهرا",6,"ر",2,0],["فيا ظالم الأموال كيف قدرت أن","تضاف إلى الإنصاف واسمك ظالم",7,"م",1,0],["فيا ظلمة الآمال عني تقشعي","فقد تتجلى عن فؤادي دياجره",8,"ر",2,0],["فيا ظَهري المطعون بالخنجر الذّي","على خيري الموصول قد شَبَّ حامِلُه",9,"ل",2,0],["فيا ظبيُ كيفَ أسلتَ الحشا","وكنتَ بوادي الحشااترتعُ",10,"ع",1,0],["فيا ظمأي لبحر كان جودا","يفيض لنا نداه بالوفاء",11,"ا",2,0],["فَيا ظامىء الآمال ليلك وَالسرى","وَزر بحر جود مخصب السوح مخضرا",12,"ر",2,0],["فَيا ظبية السرب الَّتي سَفَكَت دَمي","بِفَتك نِصال العين أَنتَ عَلى عيني",13,"ن",2,0],["فَيا ظَبيُ مَهلاً إِنَّ طَرفك فاتن","وَفي عقد الأَلباب بِالسحر نافثُ",14,"ث",1,0],["فيا ظَبي الصَّريم وأنت ريمٌ","لكم قُنِصَتْ أُسودٌ في حبالك",15,"ك",1,0],["فيا ظبياتُ إن خِفتُنَّ عقبَى","فخَفْنَ اللهَ في قَتْلَى الغرامِ",16,"م",1,0],["فيا ظبيةَ الوعساء من أيمن الحمى","حلفت من جوى قلبي وإني لمترحُ",17,"ح",1,0],["فيا ظاهراً والسوى باطن","ويا باطناً والسوى مرتسم",18,"م",1,0],["فيا ظاهراً في خلقه وهو باطن","ويا باطناً في أمره وهو ظاهر",19,"ر",1,0],["فَيا ظَبيَةَ الكُثبانِ حُسنَكَ فاتَني","وَيا غادَةَ الجَرعاءِ حُبَّكَ قاتِلي",20,"ل",2,0],["فيا ظاعناً والنسك ملء إهابه","ومر تحلا والخير في أثره سارا",21,"ر",2,0],["فيا ظمء قلبي والمناهل جمة","إلى عذب ماء بالعذيب برادِ",22,"د",1,0],["فيا ظلَّة السارينَ إن غاب نجمهم","لقد خبطوا في قفرةٍ وتعسَّفوا",23,"ف",3,0],["فيا ظُلمةَ العاداتِ كم راح فيكِ من","شهيد وكم تمحو لياليكِ من سَعد",24,"د",1,0],["فيا ظل الشباب عليك منى","سلام من فؤاد ذى انتحاب",25,"ب",1,0],["فيا ظبيَ الصريم إلى م تَجفو","وحتى م الصدودُ قتلتَ نفسا",26,"س",2,0],["فيا ظلم لا تظمأ ويا غدر فاشبعن","ويا ليل لا تجحد ويا صبح فاشهدا",27,"د",2,0],["فيا ظبي رفقاً بقلب امرئ","كليم وجسم فتى ناحل",28,"ل",1,0],["فَيا ظاعِناً أَبلغ سلامي تحيّةً","إلى والديَّ الهائِمين لدى ذِكري",29,"ر",2,0],["فيا ظئر (الجزائر) يا فرنسا","أيجدر بالجزائر أن تخيبا",30,"ب",2,0],["فيا ظاعناً لا مسك السوء إنني","لفقدك لا أنفك مضني مروعا",31,"ع",2,0],["فيا ظبيةَ المَسْعَى ريا ساعةَ اللِّقا","بحقِّكما عُوداً فقد نَفِد العمر",32,"ر",1,0],["فيا ظَبيَةً قَد رَعَت بالعُذَي","بِ عَراراً فغُذِّي بقطرِ النَدى",33,"د",2,0],["فيا ظبية البان عني اليك","فما لي عند الظبا من وطر",34,"ر",1,0],["فَيا ظالمي ارفق بِعَينٍ وَمُهجةٍ","فَحَسبي جَوىً إِن لَم أَجد لِلهَوى دَرءا",35,"ا",2,0],["فيا ظالمين وما همُّنا","سواكم من الناس أن يعدلا",36,"ل",2,0],["فيا ظاعناً لا مسك السوء هل لنا","بلقياك من بعد البعاد نصيب",37,"ب",1,0],["فيا ظفراً عمَّ البلادَ صَلاحُه","بمن كان قد عمّ البلادَ فسادُه",38,"د",2,0],["فيا ظاعناً قد خانني الصبرُ بعدَه","وغيرُ عجيبٍ فيك إن خانني صَبري",39,"ر",2,0],["فيا ظَبي الصَريم نداءَ صبٍ","تمنىّ أن تكونَ له مُجيبا",40,"ب",2,0],["فيا ظلمة أيامي","غداة اجتاحك الظلم",41,"م",1,0],["فيا ظمأي بين التوجد والنوى","ويا شغلي في فارغ يزدهي عجبا",42,"ب",2,0],["فيا ظمئي والماء عذب أخوضه","ويا وحشتي والمؤنسين حضور",43,"ر",1,0]]}