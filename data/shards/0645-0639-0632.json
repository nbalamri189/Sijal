{"poems":[[77,"تقول بنو العباس هل فتحت مصر","https://www.aldiwan.net/poem69083.html","الطويل"],[77,"سرى وجناح الليل أقتم أفتخ","https://www.aldiwan.net/poem69093.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[128,"قالوا كبا جواده وما كبا","https://www.aldiwan.net/poem23744.html","الرجز"],[137,"هو الفتح أعيا وصفه النظم والنثرا","https://www.aldiwan.net/poem4233.html","الطويل"],[190,"معز الدولة الوهناء","https://www.aldiwan.net/poem43751.html","مجزوء الوافر"],[445,"استقبل العز مرفوعا به علمك","https://www.aldiwan.net/poem34775.html","البسيط"],[469,"عداك وجدي فعد عن عذلي","https://www.aldiwan.net/poem3178.html","عموديه"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103094","البسيط"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96997","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48791","المتقارب"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69351","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69337","الرجز"],[2188,"","https://poetry.dctabudhabi.ae/diwan/poem/20915","الطويل"],[2521,"","https://poetry.dctabudhabi.ae/diwan/poem/110666","الطويل"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104681","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133964","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89069","السريع"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45807","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92046","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91440","الوافر"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114097","الطويل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133288","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135737","الرجز"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90952","الطويل"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/178104","البسيط"],[4869,"حب الشرف","https://www.poetsgate.com/ViewPoem.aspx?id=151682",""],[5111,"قِيثَارَةُ العِشْقِ","https://www.poetsgate.com/ViewPoem.aspx?id=212085",""],[5225,"يا نسناسْ الهبايبْ","https://www.poetsgate.com/ViewPoem.aspx?id=27611",""],[5376,"كرامةٌ تلامسُ السماء","https://www.poetsgate.com/ViewPoem.aspx?id=188265",""],[5376,"حتَّام يا عربي","https://www.poetsgate.com/ViewPoem.aspx?id=190351",""],[5376,"دَهُرْتَ أمْ بَلَغَتْ روحٌ تراقيها","https://www.poetsgate.com/ViewPoem.aspx?id=197734",""],[5411,"إلى رجُلٍ مُتَسلّط","https://www.poetsgate.com/ViewPoem.aspx?id=204252",""],[6078,"نيليّة الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=202774",""]],"verses":[["مُعِزُّ الهُدَى والدين والرَحِمِ التي","به اتَّصَلتْ أسبابُها ولهُ الشُّكْر",0,"ر",1,0],["مُعِزُّ الهُدى للّهِ حَوضُ شفاعةٍ","يُسلسَلُ تحتَ العرش رِيّاً ويَنقخ",1,"خ",1,0],["مُعَزِّيَ العالمِ في حزنِهِ","وحاملَ الآلامِ عن قلبهِ",2,"ه",1,0],["معززاً مبجلاً","يا مرحباً يا مرحبا",3,"ب",2,0],["معزُّ الهدى معلبه حامي ذماره","يُجيرُ على أعدائِهِ البرَّ والبحرا",4,"ر",2,0],["معز الدولة الوهنا","ء يوهنها ويفقرها",5,"ر",3,1],["مُعِزَّ دَوْلَتِكَ العُلْيا وصَفْوَتَها","هَذَا حُسامُكَ فِي الهيجا وذا عَلَمُكْ",6,"ك",1,0],["معُزًى بثاني القناة في اللَّون والل","لين وثاني القضيب ذا خجَل",7,"ل",1,0],["معزز في سمار العز مطلبه","مرمى رمت كل فكر دونه شهب",8,"ب",1,0],["معزية الندب الغني بحلمه","وعلام أضعاف الذي أنا قائله",9,"ل",2,0],["معزاً كراسيها بعد ما","جعلت الكفايات أثمانها",10,"ن",3,0],["مُعِزَّ دَولَةِ عَدنانٍ وَأَيَّ فَتىً","فيهِ غَرائِبُ فَضلٍ لَيسَ في أَحَدِ",11,"د",1,0],["مُعِزِّ قَيسٍ وَفَتى قَحطانِ","لا لِحَزِ الكَفِّ وَلا هِدّانِ",12,"ن",1,0],["مُعَزِّبَتي عِندَ القَفا بِعَمودِها","يَكونُ نَكيري أَن أَقولَ ذَريني",13,"ن",2,0],["معز الهدى أصبحت بالسير قاطعا","علمت بهذا القطع قطعت الأمعا",14,"ع",2,0],["معززها المجذوب فيك بأحرفٍ","كواكب في جو السماء تنير",15,"ر",1,0],["معززاً بالنصر والتأييد","والفوز والمجد على التأييد",16,"د",1,0],["معزة الدنيا لمنسوبهم","وحبهم ذخرٌ ليوم المعاد",17,"د",1,0],["معزّ إِلى الداعي مُذل إِلى العِدى","أَمان إِلى الراجي مَنون لِمُجرم",18,"م",1,0],["معزوزة في مَوتها وَحياتها","بنت الخديوي الشَهم إسماعيل",19,"ل",1,0],["معززةٌ يلذُّ الذلُّ فيها","وَيضحكُ من عذولٍ حَيثُ فاها",20,"ا",3,0],["مُعَزِّزَةٍ رُمَّانَتَينش بِصَدرِهَا","بِثَالِثَةٍ مِمَّا حَوَتهُ شُعُوبُهَا",21,"ب",3,1],["معزّة الجهل إدبار ومنقصة","وعزّة العلم إسعاد وإقبال",22,"ل",1,0],["معزُّ يا مذلُّ يا مقَدِّمُ","قدِّم لرتبتي على من يعلمُ",23,"م",1,0],["معز اليتامى والأرامل كنزهم","إذا الضبع الشهباء ذلت بها الأسد",24,"د",1,0],["مَعَزَّزاً بإِله العَرْشِ مُنْتَصِراً","مُمَتَّعًا بِمَزيِدِ القَدْرِ والعُمُرِ",25,"ر",1,0],["معزوفتي طفله تحقق مرادي","باسبابها الارواح تسكن بالاشيا",26,"ي",2,0],["مَعْزوفَةٌ كَالفَجْر يهْواهَا الْمُنَى","ولَهٌ فَكَمْ هَامَتْ بِه أوتَارُ",27,"ر",1,0],["معزول ردف وحايبْ","ومضمّره فترينْ",28,"ن",1,0],["معْزوفَةُ الموتِ تُراقِصُهمْ","لهمْ هديرُ الدمِّ إيْقاعُ",29,"ع",1,0],["معزوفتي وربابتي وروايتي","ولها بديعٌ في الخيالِ أديبُ",30,"ب",1,0],["معزوفةُ العودِ كم ماستْ على وترٍ","ما أرْقصتْ مهجةً تشكو دياجيها",31,"ي",3,0],["مَعْزوفَتي الأولى الَّتي أَهْمَلْتَها","ثَمِلَتْ فَغَنَّى في هَوايَ بَنَفْسَجُ",32,"ج",1,0],["معزوفتانِ من القصائدِ في دمي","دمعُ الوداعِ وبسمةٌ بلقائهِ",33,"ا",3,0]]}