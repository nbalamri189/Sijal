],[46,"والدنا الدهر به طيشة","https://www.aldiwan.net/poem23430.html","السريع"],[46,"أركان دنيانا غرائر أربع","https://www.aldiwan.net/poem23489.html","الكامل"],[46,"الغدر فينا طباع لا ترى أحدا","https://www.aldiwan.net/poem23589.html","البسيط"],[46,"ما بالها ناوية شقة","https://www.aldiwan.net/poem23616.html","السريع"],[76,"والدار بعدهم مقسمة","https://www.aldiwan.net/poem39246.html","أحذ الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85835","الرجز"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125571","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16699","السريع"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19016","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19772","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202531","الرجز"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30458","الكامل"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39308","البسيط"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9982","الرمل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20986","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42503","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42695","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55063","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54760","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54953","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/5277","الخفيف"],[63,"","https://poetry.dctabudhabi.ae/diwan/poem/29753","الرجز"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142339","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54283","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54267","المجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54224","البسيط"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/205861","الكامل"],[106,"ميلاد الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179497",""],[106,"هل عاد قيس؟","https://www.poetsgate.com/ViewPoem.aspx?id=179386",""],[106,"حي البيان","https://www.poetsgate.com/ViewPoem.aspx?id=179367",""],[106,"بين عهدين","https://www.poetsgate.com/ViewPoem.aspx?id=179345",""],[77,"باتت نجوم الأفق دون علاكا","https://www.poetsgate.com/ViewPoem.aspx?id=34151",""],[100,"الشهيدة","https://www.poetsgate.com/ViewPoem.aspx?id=50326",""],[90,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[90,"بم أستهل","https://www.poetsgate.com/ViewPoem.aspx?id=179014",""],[45,"حاجةُ ذا الحَيرَانِ أنْ تُرْشِدَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31625",""],[45,"أصَبَا الأصَائِلِ إنّ بُرْقَةَ مُنْشِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=32956",""],[91,"هملت","https://www.poetsgate.com/ViewPoem.aspx?id=53205",""],[91,"دمعة على جبران جبران","https://www.poetsgate.com/ViewPoem.aspx?id=52997",""],[46,"يَستأسِدُ النّبتُ الغضيضُ، فلا تلُمْ","https://www.poetsgate.com/ViewPoem.aspx?id=18542",""],[51,"ضحكَ الربيعُ إلى بكا الدِّيمِ","https://www.poetsgate.com/ViewPoem.aspx?id=30456",""],[60,"لا تعذليه فإن العذل يولعه","https://www.poetsgate.com/ViewPoem.aspx?id=15018",""],[51,"ضحك الربيعُ إلى بكى الديم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13110&r=&rc=0",""],[31,"لم يقضِ ذو الشجو ممنْ شفه أربا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18769&r=&rc=32",""]],"verses":[["وَالدَهرُ يوجِفُ فيهِ مُع","وَجَّ الطَريقِ وَمُستَقيما",0,"م",2,0],["وَالدَهرُ في أَبياتِنا جُؤذَرٌ","فَالآنَ أَضحى وَهوَ لَيثٌ شَتيم",1,"م",1,0],["وَالدَمعُ تَحفِزُهُ عَينٌ مُؤَرَّقَةٌ","حَفزَ الحَنِيَّةِ عَن نَزعٍ وَتَوتيرِ",2,"ر",1,0],["وَالدَهرُ تَدخُلُ نافِذاتُ سِهامِهِ","مَأوى الصِلالِ وَمَربَضَ الآسادِ",3,"د",1,0],["وَالدَمعُ لا يَرقا لَهُ","غَربٌ كَأَنَّ العَينَ غَربُ",4,"ب",1,0],["وَالدَهرُ مُختَرِمٌ تَشُنُّ صُروفُهُ","في كُلِّ يَومٍ غارَةً شَعواءَ",5,"ا",2,0],["وَالدَّمعُ يَغلِبُني طَوراً وأَغلِبُهُ","وَمَن يُطيقُ غِلابَ المَدمَعِ السَجِمِ",6,"م",1,0],["وَالدَّهْرُ يَرْمُزُ بِالخُطُوبِ وفي","غُلَوائِها الأَيَّامُ تَنْهَمِكُ",7,"ك",1,0],["والدّهْرُ يُغري نَواها بي وعَنْ كَثَبٍ","منْ صَرْفِها بأبي عُثْمانَ أنْتَقِمُ",8,"م",1,0],["والدّهْرُ عَبْدٌ والأوامِرُ طاعَةٌ","والمُلْكُ مُقْتَبَلٌ وزَنْدُكَ وارِ",9,"ر",1,0],["والدّهْرُ يعلَمُ أنِّي لا أذِلُّ لهُ","فكيفَ أفتَحُ بالشّكوى إليكَ فما",10,"م",2,0],["والدُّرُّ يُنظَمُ حينَ يضحَكُ عِقْدُهُ","وإذا بَكَيْتُ فمِنْ جُفوني يُنثَرُ",11,"ر",1,0],["والدّهرُ يُثني بما نُثْني عَلَيكَ بهِ","وما بمُطْريك منْ عِيٍّ وإرْتاجِ",12,"ج",1,0],["والدّهرُ في دسْتِ القَضاءِ مدرِّسٌ","فإذا قضَى يستأنِفُ التّدْريسا",13,"س",2,0],["وَالدِّينُ دِينُ اللِه أَنْتَ عِمَادُهُ","قَدْ كَانَ أَصْبَحَ مَائِلاً لَوْلاَكَا",14,"ك",2,0],["والدّهْرُ عنْ فَتَكاتِهِ لا ينْثَني","وأخصُّ مَنْ يَشْقى بهِ أحْرارُهُ",15,"ر",2,0],["وَالدَّهْرُ بَعْدَ مَشِيبهِ بِكَ لاَبِسٌ","مَا شِئْتَهُ مِنْ عُنْفُوَانِ شَبَابِ",16,"ب",1,0],["وَالدَّوْحُ صَلَّى بِالتَّحِيَّاتِ الَّتِي","أَلْقَى بِمَسْمَعِهِ النَّسِيْمُ الطَّيِّبُ",17,"ب",1,0],["والدهر قد كشف القناع فلم يدع","لِي عُدَّةً لِلْرَوْعِ ألاَّ أَذْهَبَا",18,"ب",2,0],["وَالدَّهْرُ مُحْتَفِلٌ لِمُلْكِكَ مُحْتَفٍ","يُبْدِي عَلَى أَثَرِ العَجِيبِ عَجِيبَا",19,"ب",2,0],["وَالدُجى يَخطو عَلى مَهَلٍ","خَطوَ ذي عِزٍّ وَذي خَفَرِ",20,"ر",1,0],["وَالدَولَعِيُّ الخَطيبُ مُعتَكِفٌ","وَهوَ عَلى قشرِ بَيضَةٍ يَثِبُ",21,"ب",1,0],["وَالدَجنُ لِلشَمسِ المُنيرَةِ حاجِبٌ","وَالجَفنُ مَثوى الصارِمِ الفَتّاكِ",22,"ك",1,0],["وَالدُجى مِن نُجومِهِ في عُقودٍ","يَتَلَألَأنَ مِن سِماكٍ وَنِسرِ",23,"ر",1,0],["والدوام مبدؤه","والنهاية الأزل",24,"ل",1,0],["والدجى عبوسته","والخطوب والوهل",24,"ل",1,0],["والدعاة الهداة إلا إذا","لاذوا بمصر يسقون مر النكال",25,"ل",1,0],["والدو يرميه بزرق عيونه","والجو في كل إتجاه ريدا",26,"د",2,0],["وَالِدُكَ الأَمْجَدُ فِي المُنْتَمَى","زَادَتْهُ مَجْداً رِفْعَةُ المُنْتَمِي",27,"م",2,0],["وَالدَهرُ يُبلي جِدَّةَ الجَديدِ","لَم يُبقِ غَيرَ مُثَّل رُكودِ",28,"د",1,0],["والدهر لو سامع مطيع","يحي الفرائض والسنن",29,"ن",1,0],["والدار حاليةٌ المعاطف والربا","ومَرَادها بالروضة المخضالِ",30,"ل",1,0],["والدين فيه يقول ذو قرءانه","قولاً يحاذر منه ذو إنجيله",31,"ل",2,0],["والدعاوى في الحق منّا كبار","طال فيها التزمير والتطبيل",32,"ل",1,0],["والدمع والشعر ممن قد بكى بهما","كلاهما حكيا في يومه الدررا",33,"ر",2,0],["وَالدَهرُ بَدَّلَ شَيبَةً وَتَحَنِّياً","وَالدَهرُ ذو غيرٍ لَهُ أَطوارُ",34,"ر",1,0],["والدهرُ سلمٌ كيفَ ما حاولتهُ","لا مثل دهري في دمشق محارِبا",35,"ب",2,0],["والدَّمع ينشدُ في مسائله","هل بالطلولِ لسائلٍ رَدّ",36,"د",1,0],["والدّرّ كيف يغيب في أدراجه","ويعاود التقليد وهو ثمين",37,"ن",1,0],["والدهر حيث طلبت مثل مجرد","والعيش حيث طربت مثل موَله",38,"ه",1,0],["وَالدَهرُ يَومانِ مَذمومٌ وَمُمتَدَحٌ","وَالناسُ اِثنانِ مَمنوحٌ وَمَسلوبُ",39,"ب",1,0],["والدهرُ يُبلي الفتى من حيث يُنشئُهُ","حتى تَكُرَّ عليه ليلةُ القَرَبِ",40,"ب",1,0],["والدهر يَقْسم مرةً","نَفْلاً وآونة يُغيرُ",41,"ر",1,0],["والدرّ نظمٌ على الترائب من","هن وأشكاله من العِترِ",42,"ر",1,0],["والدمع في آماقها","حذرَ المُراقب قد تحيَّرْ",43,"ر",1,0],["والدهرُ كالليث فَرّاس ونحن له","فرائسٌ ليس فيها غير مفروس",44,"س",1,0],["والدولةُ الزهراءُ والزمن ال","مِزهار حسبك شافيَ القَرَمِ",45,"م",1,0],["وَالدَهرُ لا يَبقى عَلى حَدَثانِهِ","في رَأسِ شاهِقَةٍ أَعَزُّ مُمَنَّعُ",46,"ع",1,0],["وَالدَهرُ لا يَبقى عَلى حَدَثانِهِ","جَونُ السَراةِ لَهُ جَدائِدُ أَربَعُ",46,"ع",1,0],["وَالدَهرُ لا يَبقى عَلى حَدَثانِهِ","شَبَبٌ أَفَزَّتهُ الكِلابُ مُرَوَّعُ",46,"ع",1,0],["وَالدَهرُ لا يَبقى عَلى حَدَثانِهِ","مُستَشعِرٌ حَلَقَ الحَديدِ مُقَنَّعُ",46,"ع",1,0],["وَالداءُ يَقوى ثُمَّ يَضعُفُ تارَةً","فَكَأَنَّهُ يَبلو القُلوب وَيَسبِرُ",47,"ر",1,0],["وَالدَهرُ حالاتٌ فَيَومٌ بِهِ","تَحُسُّ وَيَومٌ سَعدُهُ كامِلُ",48,"ل",1,0],["وَالدُرُّ مَخبوءً لَكُم في قاعِهِ","كَي تُخرِجوهُ وَتَغنَموا ما شِئتُمُ",49,"م",1,0],["وَالدورَ قالَت دورَكُم وَالمالَ","قالَت إِنَّ أَحسَنَهُ الَّذي أَنفَقتُمُ",49,"م",1,0],["وَالدَهرُ عِندَكَ كُلُّهُ رَمَضانُ يا","مَن لَيسَ يَبرَحُ صائِماً مُتَهَجِّدا",50,"د",2,0],["والدَّهرُ يَدْفُنُ في ظلامِ","الم