قَلَب",143,"ب",1,0],["وَالدَينُ مَتجَرُ مَيِّتٍ فَلِذالِكَ لا","تُلفيهِ في الأَحياءِ إِلّا كاسِدا",144,"د",2,0],["والِدُهُ خَصَّهُ بِعَدوى","مِن مَوتِهِ وَالحَمامُ يُعدي",145,"ي",1,0],["وَالدَهرُ يَخطُبُ أَهلَ اللُبِّ مُذ عَقَلوا","ما خافَ عِيّاً وَلا أَزرى بِهِ الحَصَرُ",146,"ر",1,0],["وَالدَهرُ يَقدُمُ وَالمَعاشِرُ تَنقَضي","وَالعَجزُ تَصديقٌ بِمَينٍ يُخبَرُ",147,"ر",1,0],["وَالدُرُّ دَرٌّ لِلهُمومِ تُسِرُّهُ","إِنَّ الجَواهِرَ بِالأَذاةِ جَواهِرُ",148,"ر",1,0],["وَالدَهرُ سيدٌ في الخَديعَةِ ضَيغَمٌ","في الفَرسِ طائِرُ مَسلَكٍ طَيّارُ",149,"ر",1,0],["وَالدَهرُ عارٍ لا يُغادِرُ مَلبَساً","فَالمَجدُ مُندَرِسٌ بِهِ وَالعارُ",150,"ر",1,0],["وَالداءُ يُطرَدُ بِالأَمَرِّ وَصَر","فُ الخَطبِ وَقتَ نُزولِهِ الصَبرُ",151,"ر",1,0],["وَالدِرعُ لا تُنجي الفَتى","وَكَأَنَّها في العَينِ كُرُّ",152,"ر",1,0],["وَالدارُ تَدمُرُ مِن كُلٍّ وَما غَرَضي","كَونٌ بِتَدمُرَ لَكِن مَنزِلٌ دَمَرا",153,"ر",2,0],["وَالدَفنُ دِفءٌ في الشِتاءِ وَظُلَّةٌ","في القَيظِ حُقَّ لِمِثلِها أَن يُؤَثَرا",154,"ر",2,0],["وَالدَهرُ أَنسى بَني بَكرٍ بُجُيرَهُمُ","وَسَوفَ يُنسي قُرَيشاً غَدرَةَ الشَمِرِ",155,"ر",1,0],["وَالدَهرُ مُفتَنُّ الغَوائِلِ مُهلِكٌ","رَبَّ الحُسامِ وَحامِلَ المِئشارِ",156,"ر",1,0],["وَالدَهرُ لَم يَشعُر بِما هُوَ كائِنٌ","فيهِ فَكَيفَ يُذَمُّ في الأَشعارِ",157,"ر",1,0],["وَالدَهرُ قَصَّ قَنا جَذيمَةَ في الوَغى","وَعَصاهُ تَنضو الخَيلَ تَحتَ قَصيرِ",158,"ر",1,0],["وَالدَينُ نُصحُ الجُيوبِ مُقتَرِناً","مَدى اللَيالي بِعِفَّةِ الحُجُزِ",159,"ز",1,0],["وَالدَهرُ في الحِجِر تُرجى مِنهُ عارِفَةٌ","أَنّى وَقَد بانَ إِعسارُ وَتَفَليسُ",160,"س",1,0],["وَالدَهزُ أَنحى عَلى ذي مارِنٍ أَرجٍ","بِطيبِهِ وَعَلى ذي مارِنٍ وَرِسِ",161,"س",1,0],["وَالدَهرُ أَخرَقُ ما اِهتَدى لِصَنيعَةٍ","وَبَنوهُ كُلُّهُمُ سَفيهٌ أَخرَقُ",162,"ق",1,0],["وَالدُرُّ لاقى المَنايا في أَكُفِّهِمُ","وَكم ثَوى البَحرَ لا يَخشى بِهِ غَرَقا",163,"ق",2,0],["وَالدَهرُ شاعِرٌ آفاتٍ يَفوهُ بِها","لِلناسِ يُفَكِرُ تاراتٍ وَيَرتَجِلُ",164,"ل",1,0],["وَالدَهرُ عَودٌ بِلا فَناءٍ","أَو جَذَعٌ ما لَهُ بَزولُ",165,"ل",1,0],["وَالدَهرُ يُنسي كَمِيَّ الحَربِ صارِمَهُ","وَدِرعَهُ وَفَتاةَ الحَيِّ مِجوَلَها",166,"ل",3,0],["وَالدَهرُ أَكوانٌ تَمُرُّ سَريعَةً","وَيَكونُ آخِرُها نَظيرَ الأَوَّلِ",167,"ل",1,0],["وَالدَهرُ يَقدُمُ عَن تَرادُفِ أَعصُرٍ","فَيَغيبُ أَعصُرُ في الخُطوبِ وَيَقدُمُ",168,"م",1,0],["وَالدَهرُ يَصمُتُ غَيرَ أَنَّ خُطوبَهُ","تُرجِمنَ حَتّى خِلتُهُ يَتَكَلَّمُ",169,"م",1,0],["وَالدَهرُ لا يُنكِرُ تَسويدَهُ","بَني كُلَيبٍ لِبَني دارِمِ",170,"م",1,0],["والِدُنا الدَهرُ بِهِ طَيشَةٌ","فَلَيسَ فيهِ مِن بَنيهِ حَليم",171,"م",1,1],["وَالدَهرُ لا يَدري بِمَن هُوَ كائِنٌ","فيهِ فَكَيفَ يُلامُ فيما كانا",172,"ن",2,0],["وَالدَهرُ يُفقِدُ يَوماً بِهِ كَدَرٌ","وَيَعوزُ الخِلَّ باديهِ كَخافيهِ",173,"ف",3,0],["وَالدَهرُ كَالحَيّوتِ في","إِهلاكِهِ ما حَوَتِ الحاوِيَه",174,"و",3,0],["والدارُ بعدَهُمُ مقسَّمةٌ","بينَ الرياحِ وهاتِفِ الوَدْقِ",175,"ق",1,1],["والدهر لا يسمعه","وإن بكى وإن نحب",176,"ب",1,0],["والدهرُ يُغريني فأُعرِضُ لاهياً","فيَظَلُّ يَفتِنُني بتلكَ وهذي",177,"ي",1,0],["والدهرُ يَهزِلُ والغرامُ يَجدُّ بي","ما كنتِ ساخرةً ولا أنا هاذي",177,"ي",1,0],["والدّهْرُ إعْدامٌ ويُسْرٌ وإبْ","رامٌ ونَقْضٌ ونَهارٌ وليْل",178,"ل",1,0],["وَالدينُ يُسرٌ وَالخِلافَةُ بَيعَةٌ","وَالأَمرُ شورى وَالحُقوقُ قَضاءُ",179,"ا",2,0],["والدين أليق بالإنا","ث فهنّ مدرسة الذكور",180,"ر",1,0],["والدّين بين القدماء عدوى","يقطع أجواز القفار عدوا",181,"د",3,0],["والدارُ قد ضَربَ الكَمالُ رِواقَهُ","فيها وباعُ النقص فيها يَقْصُرُ",182,"ر",1,0],["وَالدَّمْعُ يَهْمُلُ وَالأَنْفاسُ صَاعِدَةٌ","فَالدَّمْعُ في صَبَبٍ والنَّفْسُ في صُعُدِ",183,"د",1,0],["والدارةُ الثالثةُ التي حكتْ","في قَدرها الثانيةَ التي مَضَتْ",184,"ت",1,0],["وَالدِما تَجري عَلَيها","لَونُها أَحمَرُ قاني",185,"ي",1,0],["والدُّهمُ شُعثُ الذُّرَى سَوداءُ تُشِبهُها","مِمَّا وَنَى مِن صَفَا شَبعانَ جَبَّارا",186,"ر",2,0],["والدَّهْرُ مَدْرَجَةُ الْخُطُوب فَمَنْ يَعِشْ","يَهْرَمْ وَمَنْ يَهْرَمْ يَعِثْ فيهِ الْبِلَى",187,"ا",1,0],["وَالدَّهْرُ كَالْبَحْرِ لا يَنْفَكُّ ذَا كَدَرٍ","وَإِنَّمَا صَفْوُهُ بَيْنَ الْوَرَى لُمَعُ",188,"ع",1,0],["وَالدَّينُ وَالدُّنْيَا مَجَالُ كِفَايَةٍ","لِلعَبْقَرِيَّ المُسْتَقِيمِ الصَّادِقِ",189,"ق",1,0],["وَالدَّوْحُ مَيَّادُ الرُّؤو","سِ مُشَيَّعٌ بِالأَذْرُعِ",190,"ع",1,0],["وَالدَّهْرُ أَجْمَعُ دُونَ ثَانِيَةٍ","يَفْدِي بِهَا الأوْطَانَ مَنْ يَفْدِي",191,"د",2,0],["وَالدَّهْرُ فِي أَثْنَائِهِ بَاسِمٌ","وَالعَيْشُ فِي أَفْيَائِهِ أَخْضَرُ",192,"ر",1,0],["وَالدُموعُ تَغسِلُهُ","غَسلَ كُحلِ محجَرِها",193,"ر",3,0],["وَالدَواليبُ إِذ يَدُرنَ وَلا نا","ضِحُ يُسقى بِهِنَّ غَيرُ النَعامِ",194,"م",1,0],["والدّهْرُ يُبدي صَفْحَةَ اسْتِحْواذِ","فامْنُنْ على الأشْلاءِ بالإنقاذِ",195,"ذ",1,0],["والدجى ينساب في الصمت","كأطياف الخطايا",196,"ي",2,0],["والدمعُ تهمي في الشدائدِ سحبُه","ومن الدموع مماطل وموافي",197,"ف",2,0],["والدهر أحرَى رفيقٍ","بأن يخونَ ويُخني",198,"ي",1,0],["والدَّهْرُ لا يُنْشِي الرِّجالَ صَوارِماً","إِلاّ إِذا نَضِجُوا على جَمَراتِه",199,"ت",2,0],["والدهر يبدأ من دمشق وعندها","تبقى اللغات وتحفظ الأنساب",200,"ب",1,0],["والدهر إن ثفلتْ عليه ذنوبُه","يكفيه أنك أنت من حسناته",201,"ت",2,0],["والدهرُ خيرُ مميِّزٍ","بين اللآلئِ والحجر",202,"ر",1,0],["والدافعون لِوَاءَهُ في عالَم","نخر القَرَى كالسوس في آدابه",203,"ب",2,0],["والدهرُ قاضٍ؛ إذا جارَ القضاةُ على","حقً، ففي يده للعدلِ ميزان",204,"ن",1,0],["والدين دين الله أنت عماده","لولاك أصبح مائلا لولاكا",205,"ك",2,0],["والدوالي هناك أشلاء قتلى","جمدت حولها ، بقايا النزيف",206,"ف",1,0],["والداهناتِ دماؤُهم لِمَمَ الثَّرى","والمُؤنساتِ شواطئَ الأنهار",207,"ر",1,0],["والدين ، كلُّ الناس تعرف حَمْلَهُ","والفرق كلُّ الفرق عند أدائه",208,"ا",3,0],["والدّهْرُ لَوْنَانِ فَهَلْ مُخْلِقٌ","أبيَضَهُ باللبسِ، أوْ أسْوَدَهْ",209,"د",2,0],["وَالدّارُ تَعْلَمُ أنّ دَمعيَ لمْ يَغِضْº","فأرُوحَ أحمِلَ مِنّةٍ مِنْ مُسْعِدِ",210,"د",1,0],["والدّهر حالات ، فيقوم به","نحس، ويوم سعده كامل",211,"ل",1,0],["والدجى ، والنجوم تسطع فيه،","واجم حسرة على مصباحك",212,"ك",1,0],["والدّينُ متجَرُ ميّتٍ، فلذاكَ لا","تُلفيهِ، في الأحياءِ، إلاّ كاسِدا",213,"د",2,0],["والدولة ُ الزهراءُ والزمن ال","مِزهار حسبك شافي قزم",214,"م",1,0],["وَالدهرُ يُعطِي الفَتى مِن حَيثُ يَمنَعُه","إِرثاً وَيَمنَعُهُ مِن حَيثِ يُطمِعُهُ",215,"ع",2,0],["والدولة ُ الزهراءُ والزمن ال","هارُ حسبُك شافَيْى قَرَم",216,"م",1,0],["والدَّمْعُ لِلْشَّوْقِ مِتْبَاعٌ فَمَا ذُكِرَتْ","إلاَّ تَرَقْرَقَ ماءُ العَيْنِ فَکنْسَكَبَا",217,"ب",2,0]]}