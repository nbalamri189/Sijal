{"poems":[[71,"هنيت عاما مقبلا مقبلا","https://www.aldiwan.net/poem28741.html","السريع"],[50,"يا غلاما يود كت","https://www.aldiwan.net/poem64355.html","مجزوء الخفيف"],[50,"يا غلاما يريد كتما","https://www.aldiwan.net/poem66562.html","مجزوء الخفيف"],[52,"طرقتنا بالزابيين الرباب","https://www.aldiwan.net/poem64816.html","الخفيف"],[70,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[449,"لست أنسى عهد ليل قريب","https://www.aldiwan.net/poem56036.html","المديد"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53953","الرمل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109187","السريع"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133873","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80068","السريع"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108752","الخفيف"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126667","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28055","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77305","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200057","الخفيف"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112495","الرمل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86344","الرمل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123503","المديد"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133133","الرمل"],[5121,"دعاء","https://www.poetsgate.com/ViewPoem.aspx?id=33666",""],[5573,"من خميس مشيط وصل لي سلامي","https://www.poetsgate.com/ViewPoem.aspx?id=201931",""],[5874,"مَوْقفُ الشِّعْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=212191",""],[5997,"العنابه","https://www.poetsgate.com/ViewPoem.aspx?id=214232",""]],"verses":[["قلت رسولي رمْتُ جرِّي عن ال","أهلينَ ماذا أنتَ مِنْ أم إلى",0,"ل",2,0],["قُلتَ راعٍ مُمَلأً","راحَ يَستاقُ أَكبُشا",1,"ش",2,0],["قلتَ راعٍ لذي اليما","مةِ يستاقُ أكبُشا",2,"ش",2,0],["قُلتُ ريحٌ تَحِنُّ بَينَ أَواسٍ","أَو بَراعٌ غَنّى بِهِ القَصّابُ",3,"ب",1,0],["قُل ترَكْتُ الصّبّ فيكُم شبَحاً","ما لهُ ممّا بَراهُ الشّوقُ فَي",4,"ي",1,0],["قُلْتُ روحي إنْ تَرَيْ بَسطَكِ في","قَبْضِها عِشْتُ فرأيي أن تَرَي",4,"ي",1,0],["قلت رب الجهل من يذهب","وهو في تخليطه معجب",5,"ب",1,0],["قلتُ رفقاً بي فإنّي هالكٌ","قال لي ما عَنْك رِفقِي يُخْتَزَنْ",6,"ن",1,0],["قلتُ رضى مثلي بإحسانه","يُعد إحساناً إِلى مثلة",7,"ل",2,0],["قلت رقوا لذلك الطفل ميمو","ن ولا تؤتموه يا إخواني",8,"ن",2,0],["قلت رأى المهديّ مستشعر ال","سواد حزناً باكيَ الجفن",9,"ن",1,0],["قلت روحي لك الفدا","كللي رأسه قرون",10,"ن",1,0],["قلت رفقا بقلب عبدك رب","كل حب مخفف اكداري",11,"ي",1,0],["قلت ربي فقال لبيك عبدي","لم أجد غير حيرةٍ لي ضلالا",12,"ل",2,0],["قُلتُ روحي لَكِ يا مِصرُ فِدىً","سامِحيني عانِقيني قَبِّلي",13,"ل",2,0],["قلت روحي صريحة عربية","ذات عنف مقسم بالسوية",14,"ي",2,0],["قلت ربي وأنا جاث له","فحباني لطفه قلبا رضيا",15,"ي",2,0],["قُلتُ رِفقاً فَالتَنائي","مِنكَ جسم الصَبِّ اهلَك",16,"ك",1,0],["قل تركتم صبا صبا في هواكم","وتباريح الهجر في برحائي",17,"ا",2,0],["قل تركت المستهام على","خطر لم يستطع نفسا",18,"س",2,0],["قل تركت الصب فيكم شبحاً","داخلته من نواكم برحا",19,"ح",2,0],["قلتُ ربّي فاستفاقتْ في جنوحي","دعوة ٌ فاضتْ بأنداءِ النّقاءِ",20,"ا",2,0],["قل ترى سلطان نفسه ياغواليها هنيه","يحمد الله مامشت رجله مع ادروب الملامي",21,"م",2,0],["قُلْتُ رَهْطٌ كَأَنَّهُمْ أَصْدِقَائِي","مِنْ قَدِيمٍ ، قَالَتْ نَطَقْتَ يَقينَا",22,"ن",2,0],["قلت رحماك تطير بي هواكِ","كلُّ يوم زارني يزداد عُمرا",23,"ر",2,0]]}