{"poems":[[95,"أمر من يطلب الخلود عسير","https://www.aldiwan.net/poem9165.html","الخفيف"],[202,"ألف ألا انعم بالمحبة حالا","https://www.aldiwan.net/poem51903.html","الكامل"],[457,"حاءتك تعنو للجناب الرفيع","https://www.aldiwan.net/poem13830.html","السريع"],[563,"محمد الإسم حمد الرسم معلوم","https://www.aldiwan.net/poem33887.html","البسيط"],[563,"حملت بنا أم من الأرواح","https://www.aldiwan.net/poem34671.html","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77824","الخفيف"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114378","البسيط"],[3464,"ألفٌ أمعاني من يذكرْ","https://www.poetsgate.com/ViewPoem.aspx?id=158742",""],[4955,"قالوا تصبر فقلت الصبر من شيمي","https://www.poetsgate.com/ViewPoem.aspx?id=198919",""],[4979,"الثريا","https://www.poetsgate.com/ViewPoem.aspx?id=176546",""],[5431,"العين (ع)","https://www.poetsgate.com/ViewPoem.aspx?id=205592",""],[5664,"مغيب ومشرق","https://www.poetsgate.com/ViewPoem.aspx?id=176694",""],[5736,"محمود","https://www.poetsgate.com/ViewPoem.aspx?id=203821",""],[5736,"محمد","https://www.poetsgate.com/ViewPoem.aspx?id=208186",""],[5736,"ما العيد","https://www.poetsgate.com/ViewPoem.aspx?id=208401",""]],"verses":[["حاء شوقي ببعض ما رام منه","وهو في الحق للقريض أمير",0,"ر",1,0],["حاء حباني من حبيت بوصله","برضابه فرشفت منه زلالا",1,"ل",2,0],["حاءتك تعنو للجناب الرفيع","في رقة السحر ووشي الربيع",2,"ع",1,1],["حاء وميم إليها الدالُ منتسبٌ","لأنه سرها يخفيه حلقوم",3,"م",1,0],["حاء الحيا والحلم والحفظ احتوت","كل الجمال وسائر الأفراح",4,"ح",1,0],["حاء حور الجنان ميم المَعاني","دال دير الخمور قاف القطوف",5,"ف",1,0],["حاءٌ وَميمٌ قَولُ رَبّي وَحدَهُ","مِن غَيرِ أَنصارٍ وَلا أَعوانِ",6,"ن",1,0],["حاءٌ وميمٌ لإرسالِ الرحيمِ لنا","محمداً وهو عينُ العطفِ والرحُمِ",7,"م",1,0],["حاءٌ حكمٌ لحكومته","عقد الأشكال لقد تنشر",8,"ر",1,0],["(حاءٌ) حوى الحسنَ في خَلقٍ وفي خُلُقِ","حروفُ شعريَ في ذا الوصفِ تحتارُ",9,"ر",1,0],["حاءت كانفاس الربيع رخية","فتحيرت في حسنها هند وعد",10,"د",1,0],["حاءٌ مع السين اللصيقة قافها","تعويذة من سرّه مشحونه!!",11,"ن",2,0],["حا/ءك تسافر بي الى الباء/ واشرق","حب/ واطل للناس منك في شمسين",12,"ن",1,0],["حاءٌ: حَمدتُ اللّهَ أنْ أنصفتني","أكرمتني حينَ الجميعُ تَهلهَلوا",13,"ل",3,0],["حاءٌ / حنانيك، ابتسامة خافقي","قد أظلمت، إلا بنورِك مذ غشا",14,"ش",2,0],["حاءٌ تلوَّن في السُّطورِ مشاعري","باءٌ سَتُحيي في الهَوى أشواقي",15,"ق",2,0]]}