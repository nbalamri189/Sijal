{"poems":[[93,"صدقت في عتبكم أو يصدق الشمم","https://www.aldiwan.net/poem11361.html","البسيط"],[27,"عفا النسران بعدك والوحيد","https://www.aldiwan.net/poem5726.html","الوافر"],[72,"كيف قاسوا قد الحبيب بغصن","https://www.aldiwan.net/poem20160.html","الخفيف"],[51,"ما كرم اللّه بني آدم","https://www.aldiwan.net/poem61874.html","السريع"],[85,"الرشد أجمل سيرة يا أحمد","https://www.aldiwan.net/poem63675.html","الكامل"],[62,"إذا ما الشمس في السرطان صارت","https://www.aldiwan.net/poem52157.html","الوافر"],[62,"يا قاتل الله معشرا ظلموا الحكمة","https://www.aldiwan.net/poem52237.html","المنسرح"],[45,"إن الظباء غداة سفح محجر","https://www.aldiwan.net/poem63628.html","البسيط"],[80,"هل أقال الحمام عثرة حي","https://www.aldiwan.net/poem31249.html","الطويل"],[74,"سمح الخيال على النوى بمزار","https://www.aldiwan.net/poem12955.html","الكامل"],[46,"إذا عشت مفتكرا في الأنام","https://www.aldiwan.net/poem23266.html","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54956","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55037","الخفيف"],[106,"النيل والسودان","https://www.poetsgate.com/ViewPoem.aspx?id=179757",""],[94,"ما شأن هذا الأشعث الجواب","https://www.poetsgate.com/ViewPoem.aspx?id=15610",""],[129,"أيها العاقل الذي شاء تزو","https://www.aldiwan.net/poem50678.html","الخفيف"],[186,"يا بدر تم بالجمال تبرقعا","https://www.aldiwan.net/poem14587.html","الكامل"],[232,"أقل عثرتي واعف يا حسن العفو","https://www.aldiwan.net/poem44568.html","الطويل"],[272,"مقيل العاثرين أقل عثارى","https://www.aldiwan.net/poem52134.html","الوافر"],[272,"عسى من خفي اللطف سبحانه لطف","https://www.aldiwan.net/poem52135.html","الطويل"],[321,"أديت واجبك المقدس كاملا","https://www.aldiwan.net/poem61624.html","الكامل"],[350,"وافى خيالك يا سعاد","https://www.aldiwan.net/poem15635.html","مجزوء الكامل"],[354,"من لصب صبا المعاهد أشجاه","https://www.aldiwan.net/poem40001.html","الخفيف"],[354,"بالفتح لاح لنا الهناء مبشرا","https://www.aldiwan.net/poem40350.html","الكامل"],[407,"ذكر الحمى فبكى لسجع حمامه","https://www.aldiwan.net/poem50115.html","الكامل"],[440,"أهلا بمن نصر الإله وأيدا","https://www.aldiwan.net/poem34795.html","الكامل"],[454,"أخي عبد المسيح فدتك نفسي","https://www.aldiwan.net/poem61583.html","الوافر"],[459,"سل عن فؤادك بين منعقِد اللوى","https://www.aldiwan.net/poem55837.html","الكامل"],[501,"لا تشوش لك سرا","https://www.aldiwan.net/poem37924.html","مجزوء الرمل"],[515,"سفرت فبرقعها حجاب جمال","https://www.aldiwan.net/poem20814.html","الكامل"],[515,"كشفت حجاب السجف عن بيضة الخدر","https://www.aldiwan.net/poem20816.html","الطويل"],[559,"تعلم حفظ آفات اللسان","https://www.aldiwan.net/poem33822.html","الوافر"],[559,"أطوف على ذاتي بكاسات خمرتي","https://www.aldiwan.net/poem34733.html","الطويل"]],"verses":[["وَسُخِّرَتْ مل آيَاتِ الْفَنَاءِ لَهُمْ","حَتَّى الْجِوَارِفُ وَالأَرْيَاحُ وَالرُّجُمُ",0,"م",1,0],["وَسُخِّرَتِ الجِبالُ وَكُنَّ خُرساً","يُقَطَّعُ في مَناكِبِها الحَديدُ",1,"د",1,0],["وسخاء على العفاة بتبرٍ","في زمانٍ لم يسخَ فيه بتبنِ",2,"ن",1,0],["وسُخِّرَ البرُّ لهمْ مركَباً","والبحرُ أنَّى قصد القاصِدُ",3,"د",1,0],["وَسَخِرتَ مِن واشٍ وَكِدتَ لِعاذِلٍ","وَاليَومَ تَنشُدُ مَن يَشي وَيُفَنِّدُ",4,"د",1,0],["وسخّنه ورطبه وحمّر","به الياقوت فهو ينير دارك",5,"ك",1,0],["وسخر الاربع الطبائع لا","قائم من أمرهم بما وجبا",6,"ب",2,0],["وَسَخاءُ نَفسِكَ بِالَّذي بَخِلَت بِهِ","أَيدي المُلوكِ مِنَ التِلادِ الأَوفَرِ",7,"ر",1,0],["وَسخيّاً بنَفسِهِ للعوالي","في رِضى اللّهِ فعلُ ذاكَ السخيِّ",8,"ي",1,0],["وَسَخا الكِرامُ بِما اِستَمَدّوا مِنهُمُ","إِنَّ البِحارَ لَمَنشَءُ الأَمطارِ",9,"ر",1,0],["وَسُخطُ الظِباءِ بِما نالَها","تَوَلَّدَ مِنهُ رِضى الحابِلِ",10,"ل",1,0],["وَسَخَاءٌ يَفِيضُ كَالنِّيلِ إِلاَّ","أَنَّهُ لَيَفيِضُ بَذْلاً وَبِرَّا",11,"ر",2,0],["وَسخاءُ المِتْلاَفِ يُؤْمِنُ إِيَما","ناً صَحِيحاً بِالرَّازِقِ المِخْلاَفِ",12,"ف",1,0],["وسخا؛ فهْو حاتميُّ العطايا","وطغا؛ فهْو عارمُ الطغيان",13,"ن",1,0],["وسخرت بالأوهام عصر شبيبتي","وحسبت فيض الماء لمع سراب",14,"ب",1,0],["وسَخاءِ وعزَّةٍ ورَخاء","وثَرَاءِ فاخطُبْ من الأغنياءِ",15,"ا",2,0],["وسَخا بما قد كان يُبْخِلُني به","كرما وجاد بنفسه وتبرعا",16,"ع",2,0],["وسخر ما بين السماء وأرضه","سحائب يخفو برقها أحسن الخفو",17,"و",1,0],["وَسخرت البحار السبع نجرى","بها الأَفلاك من غادو ساري",18,"ر",2,0],["وَسخر من نشر السحاب لواقعا","اذا اِنتَشَرَت درث سحائبها الوطف",19,"ف",1,0],["وسَخرتُ من علمي ومن أدبي معاً","وأبيتُ أن أُدعى الحكيمَ العاقلا",20,"ل",2,0],["وَسَخا بِطَيفِكَ بِعَدما","ضَنَّ الزَمانُ بِكَ الرُقاد",21,"د",1,0],["وَسَخاءٌ لَو مَعن أَدرَك مَعناه","لاِستماحت يَداه مِنهُ سِجالا",22,"ل",2,0],["وَسَخاءُ كَفٍّ لَو أَلمَّ بِكَ الظَما","شاهَدت مِنهُ لطيب وردِكَ كَوثَرا",23,"ر",2,0],["وَسَخا فَأَدرَكَ قاعِداً مِن مَجدِهِ","ما لَم يَنَله سِواهُ عند قِيامِهِ",24,"م",2,0],["وسَخا لأَطرافِ الرِّماحِ بنفسِهِ","شُحَّاً وإِشفاقاً عل دينِ الهُدى",25,"د",2,0],["وسخر بالوجود وما تغنى","به اللاهون في أفياء رمس",26,"س",1,0],["وسخيمة أغضيتَ عنها واهبا","للحِلم فيها سَوْرة الأضغانِ",27,"ن",1,0],["وسَخيٍّ وبَخيلٍ","وأخي علمٍ وجاهلْ",28,"ل",1,0],["وسخا الشقيقُ لها بحبّةِ قلبِه","فاِستعمَلَتْها في مكان الخالِ",29,"ل",1,0],["وسُخْطٌ لوَ اِنّ النّحلَ ترعى قَتادَه","لمجّتْهُ من أفواهِها سائِلَ الصّبْرِ",30,"ر",1,0],["وسخرية وتعريض ولعن","ونوح واشتغال بالأغاني",31,"ن",2,0],["وسخرت لي كل الوجود تفضلاً","على صورتي مني وأتممت منتي",32,"ي",1,0]]}