.dctabudhabi.ae/diwan/poem/26691","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64898","الكامل"],[1765,"","https://poetry.dctabudhabi.ae/diwan/poem/131508",""],[1858,"","https://poetry.dctabudhabi.ae/diwan/poem/106709","الكامل"],[1910,"","https://poetry.dctabudhabi.ae/diwan/poem/116537","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53193","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53060","الكامل"],[2769,"","https://poetry.dctabudhabi.ae/diwan/poem/98163","المنسرح"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93819","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201696",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202587","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199997","المجتث"],[3060,"","https://poetry.dctabudhabi.ae/diwan/poem/67583","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62971","البسيط"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131982","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117942","البسيط"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35648","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125803","الكامل"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93256","الكامل"],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116051","البسيط"],[4767,"فتوى الإبادة","https://www.poetsgate.com/ViewPoem.aspx?id=178990",""],[4767,"كعبة الوفاد","https://www.poetsgate.com/ViewPoem.aspx?id=179982",""],[4830,"قاريء الكَفّ","https://www.poetsgate.com/ViewPoem.aspx?id=198916",""],[4888,"يحتلني هواها","https://www.poetsgate.com/ViewPoem.aspx?id=207748",""],[4984,"معركة \" الشوابير\"","https://www.poetsgate.com/ViewPoem.aspx?id=191622",""],[5072,"أنت الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=52568",""],[5145,"الله يعلم ما قاسته قاسان","https://www.poetsgate.com/ViewPoem.aspx?id=108055",""],[5351,"آخر الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=202029",""],[5431,"ثورة السودان (3)","https://www.poetsgate.com/ViewPoem.aspx?id=202088",""],[5725,"قل لي الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=207623",""],[5804,"لو أنتِ عندي","https://www.poetsgate.com/ViewPoem.aspx?id=180315",""],[5956,"مهما يكن قلبي صبورا صامدا ‏","https://www.poetsgate.com/ViewPoem.aspx?id=181932",""],[5956,"عتاب على هامش الوداد","https://www.poetsgate.com/ViewPoem.aspx?id=181951",""],[5956,"صراع بين التفاؤل والتشاؤم","https://www.poetsgate.com/ViewPoem.aspx?id=207548",""],[5956,"يا ربَّنا انصرها على أعدائها","https://www.poetsgate.com/ViewPoem.aspx?id=214089",""],[6308,"ذاكرة الوطن القديم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87728&r=&rc=6",""]],"verses":[["حَتّى أَعادَ الصُفرُ أَيّامَهُ","فَاِنتَصَفَ الأَسوَدُ وَالأَسمَرُ",0,"ر",1,0],["حَتَّى أُعِيدَ إِلَيْهَا تَاجُ عِزَّتِهَا","وَانْجَابَ عَنْ جِيدِهَا النيرُ الَّذِي يَقِمُ",1,"م",1,0],["حَتّى اِعتَرَفتُ وَعَزَّتني فَضائِلُهُ","وَفاتَ سَبقاً وَحازَ الفَضلَ مُنفَرِدا",2,"د",2,0],["حتى أعض إصبعي","وساعدي ومعصمي",3,"م",2,0],["حَتّى اِعتَدى كُلُّ الأَنامِ يَقولُ لي","تَللَهِ تَفتَءُ أَنتَ تَذكُرُ يوسُفا",4,"ف",2,0],["حَتّى أَعَدتَ بِها الجِيادَ وَشُهبُها","حُمرٌ لِوَخزِ السُمرِ في لَبّاتِها",5,"ت",3,0],["حَتّى اِعتَلى عالِيَةَ التَميمِ","بُؤساً لَهُ مِن هالِكٍ مَعدومِ",6,"م",1,0],["حتى اعتنقنا على الفراش وقد","غاصَ صقري الجموحُ في الكفل",7,"ل",1,0],["حتى أعين رجل الإمام","برجل القياصر الهمام",8,"م",1,0],["حتّى أَعطَتهُ رئاسَتُه","وسياسَتُه ومهُنَّدهُ",9,"د",2,0],["حَتّى أَعافَ شَراباً لَستُ أَمزجُهُ","بِعبرَتي وَطَعاماً غَيرُ مَغلوثِ",10,"ث",1,0],["حتى أعدتَ له روحَ الحياةِ وقد","أودى بحدِّ اعتزامٍ غيرِ مُنثلِم",11,"م",1,0],["حَتّى أَعادَ الزَمَنَ ال","مَذمومَ وَهوَ مُمتَدَح",12,"ح",1,0],["حَتّى أَعارَتني المُدامَةُ نَشوَةً","فَوَشَت بِحُبِّكِ نَشوَةُ الصَهباءِ",13,"ا",2,0],["حتى اعتَنَقنا فأغضَت طَرفها خَجَلاً","من النجومِ التي ترنو من الغَسَقِ",14,"ق",1,0],["حَتّى أَعودَ وَحُسّادي تَقولُ لَقَد","أَثرى مِنَ الفَضلِ وَالأَموالِ فِتيانُ",15,"ن",1,0],["حتى أعاد إلى الأوطان عزّتَها","ومجدها فهو طودٌ ليس يندثر",16,"ر",1,0],["حتّى أُعيدَتْ إلى ذي مِرَّةٍ يَقِظٍ","من الّذين إذا هَمّوا بها فَتكوا",17,"ك",3,0],["حتى أعودَ مُعَيّداً بكَ راجياً","في حَسْبتي للعَوْدِ ألا أغْلَتا",18,"ت",2,0],["حَتَّى أَعادَ الدِّينَ أَبيضَ مُشْرِقاً","بسيوفِهِ والكُفْرَ أدْهَمَ أَسْوَدَا",19,"د",2,0],["حتى أعلم قومي في توجسهم","أن العروبة كالإسلام زهراء",20,"ا",2,0],["حتى أعدتَ الدُّرْدَ من أنيابه","والليثُ مفتَرَسٌ بها مضغومُ",21,"م",1,0],["حتى أعادكَ ما تنفكُّ مِن وَلَهٍ","تسبُّ طرفاً إلى الأحبابِ طَمّاحا",22,"ح",2,0],["حتى اعتَصَمتًُ من المُلُوكِ بِخَيرِها","جَدّاً وأحسَبِها وأكرَمِها أبا",23,"ب",2,0],["حتى أعدت من المناقب والعلى","ما أفقد الدهر العنيد وضيعا",24,"ع",2,0],["حتّى اِعتَقَدتُ لِوا قَومي فَقُمتُ بِهِ","ثُمَّ اِرتَحَلتُ إِلى الجَفنيّ بِالشامِ",25,"م",1,0],["حتى أَعادْتُهُم ضَراغمُ صِيدِهِ","في خِيسِها كالصِّيدِ في الأَوهاقِ",26,"ق",1,0],["حتى اعتلوا أوكار طير العقبان","ولزقوا حولي حصون كبيره",27,"ر",2,0],["حتَّى أعَادَ لَنَا خِلاَفَةَ هاشمٍ","موطُودةً أكنافُهَا ورُسُومُهَا",28,"م",3,0],["حتى أعود من المسرَّة ناسياً","أن كنت يوماً من بني الأحزان",29,"ن",1,0],["حتى اعتصم به الحرم","باري النسم مجداً دعم",30,"م",1,0],["حتى أعاد الغُرب دون مرامهم","والوحش يرتع منه في أقواتها",31,"ت",3,0],["حتى اعتقدت الاذى لجيرتنا","ولم تكن للاذى بمعتقد",32,"د",1,0],["حتى أعود ساعياً","في جمع شمل الحبب",33,"ب",1,0],["حتى أعود لربعكم","بنفائسٍ وعظائم",34,"م",1,0],["حتى أعيشَ مع الطبيعة وحدها","فتخصّني من دونهم في رفدها",35,"د",3,0],["حتى أعزَّ فقيراً","فيصبح الفقر ذخرا",36,"ر",2,0],["حتى أُعلِّمها المِصاعَ إذا ونت","والضربَ عندَ الكَرِّ والإحجامِ",37,"م",1,0],["حتى أُعيدَ الدُّجى صبحاً برونقها","وأُلبِسَ الشمسَ أَثواباً من القَتَمِ",38,"م",1,0],["حتى أعدت له شبابه ناضرا","فكأنه في سالف الأعوام",39,"م",1,0],["حتى اعتلت كلمات الله وانتشر ال","دين القويم وراس الباطل اندمغا",40,"غ",2,0],["حَتّى أعوّض مِن دَمي بِسلافها","وَأَعود مِن عَدم الحَراك كَدنّها",41,"ه",2,0],["حتى أعاد على الجزيرة","شملها شبراَ فشبرا",42,"ر",2,0],["حتى أَعودَ من امتداحك حالياً","وكأَنني قُلِّدتُ بعض قلائدي",43,"د",2,0],["حتى أعاد بحدِّ السَّيف مُلكَ بني ال","زّهراء واستُرجِعَ الحقُّ الذي تركوا",44,"ك",3,0],["حتى أعاد من الطفوف مشاهداً","يأتي على تلك الرؤوس وينحر",45,"ر",1,0],["حتى أعودَ بِما رجوتك ظافراً","بالرفدِ والشرف العظيم مكللا",46,"ل",2,0],["حتى أعيَتْ قدَمَيَّ درو","بُ السّرِ لأرقامٍ كُبرى",47,"ا",1,0],["حتى أعودَ فأرتمي في حِضنها","أنعِم به وبثغرها ونداها",48,"ا",3,0],["حتى اعتلى أقصى الطلائع ربوة","في المنتهى بلغ الشريط مفاصله",49,"ل",2,0],["حتى أعز َّ الناس ِ غبت َ بليلها","وأقمت َ في سهر الضنى كي تسأله ْ :",50,"ل",2,0],["حتى أعدت غليها طلعةً بهرت","بدر الدجى وأديم الليل ضحيان",51,"ن",1,0],["حتى أعتنقتُ الحب ديناً عن دمي","ما كف صارمهُ ولا هو مَلني",52,"ن",2,0],["حتى أعيش ببرزخٍ","بين اجتراحي والفلاح",53,"ح",1,0],["حتى اعتلوا كالبرق غيمتها","مذ اسرجوها صهوة الدهمِ",54,"م",1,0],["حتَّى أُعيدَ مشاعرًا","ماتت فصارت مُنكرا",55,"ر",2,0],["حتى أعيش أنا بخير سعادة","ويعيش محبوبي بحضني راغدا",56,"د",2,0],["حتى أعودَ إلى قواي مجَدَّداً","وأعيدَ سيفَ الحب شوقاً مُصْلَتا",57,"ت",2,0],["حتى أعَدَّ الله شهما قادراً","وأعاننا بإقامة متعقلة",58,"ل",2,0],["حتى أعيش بسعدها ونقائها","أرجوك تُنْجي زوجتي من دائها",59,"ا",3,0],["حتَّى أُعِيْدَ إلى البِحَارِ نُجُومَها","حتَّى أَشُدَّ لِكُلِّ جُرْحٍ مِئْزَرَا",60,"ر",2,0]]}