{"poems":[[55,"لبست الوغى قبل ثوب الغبار","https://www.aldiwan.net/poem30457.html","المتقارب"],[55,"بلاء القلب ناظره","https://www.aldiwan.net/poem30463.html","مجزوء الوافر"],[84,"لكل شيء إذا ما تم نقصان","https://www.aldiwan.net/poem29425.html","البسيط"],[90,"بدت كالشمس يحضنها الغروب","https://www.aldiwan.net/poem45008.html","الوافر"],[53,"هل أنت من مرتجيك مستمع","https://www.aldiwan.net/poem65399.html","المنسرح"],[47,"ليالينا بين اللوى فزرود","https://www.aldiwan.net/poem63519.html","الطويل"],[47,"يمزج خمرا بجنى ريقه","https://www.aldiwan.net/poem65194.html","السريع"],[68,"يا هلالا من سلطة العي حيي","https://www.aldiwan.net/poem38473.html","الخفيف"],[68,"ليالي الحمى ما كنت إلا لآليا","https://www.aldiwan.net/poem40988.html","الطويل"],[107,"أهاب الحق فاستبقوا كراما","https://www.aldiwan.net/poem41938.html","الوافر"],[54,"وبئر شربنا بها عذبة","https://www.aldiwan.net/poem26890.html","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42565","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42563","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42573","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54286","الطويل"],[19,"ودّعْ لميسَ وداعَ الصّارمِ اللاحِي","https://www.poetsgate.com/ViewPoem.aspx?id=17914",""],[47,"يمْزُجُ خَمْراً بجَنَى رِيقِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=32166",""],[96,"البلبل الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=12827",""],[90,"بدت كالشمس يحضنها الغروب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19504&r=&rc=7",""],[124,"الله في كلف الأحشاء مفتون","https://www.aldiwan.net/poem49320.html","البسيط"],[240,"من عذيري فيه وهل من عذير","https://www.aldiwan.net/poem32017.html","الخفيف"],[240,"حث كؤوس الراح","https://www.aldiwan.net/poem32118.html","مجزوء الرجز"],[261,"فديت بي يا سيدي وحدي","https://www.aldiwan.net/poem48460.html","السريع"],[369,"اليوم يومي ويوم الأينق الذلل","https://www.aldiwan.net/poem60675.html","البسيط"],[371,"يمزقني ذا الحب كل ممزق","https://www.aldiwan.net/poem16968.html","الطويل"],[422,"من لصب متيم مستهام","https://www.aldiwan.net/poem53989.html","الخفيف"],[438,"هل من رفيق رفيق","https://www.aldiwan.net/poem12680.html","المجتث"],[463,"ما كنت لولا طمعي في الخيال","https://www.aldiwan.net/poem55936.html","السريع"],[463,"حسبوا العلا خفا وكن ثقالا","https://www.aldiwan.net/poem56000.html","الكامل"],[534,"من دونها يا عمر وخز الرماح","https://www.aldiwan.net/poem37480.html","السريع"],[556,"دعوا اليوم ما عودتم من تصبر","https://www.aldiwan.net/poem47699.html","الطويل"],[572,"أطلق عقال الروح بالراح","https://www.aldiwan.net/poem69760.html","السريع"],[591,"أهيف كالبدر يصلي","https://www.aldiwan.net/poem17992.html","مجزوء الرمل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83331","الوافر"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122314","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63981","المتقارب"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145959","الوافر"],[287,"","https://poetry.dctabudhabi.ae/diwan/poem/69875","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120067","السريع"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31564","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79803","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100963","الطويل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77368","الرمل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77365","الطويل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110612","الرمل"],[2632,"","https://poetry.dctabudhabi.ae/diwan/poem/216960","الطويل"],[2643,"","https://poetry.dctabudhabi.ae/diwan/poem/123799","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100245","السريع"],[3317,"","https://poetry.dctabudhabi.ae/diwan/poem/35878","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117962","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111469","الطويل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81242","المجتث"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77689","الرمل"],[4988,"سيرة بطل راحت معاه الكرامه","https://www.poetsgate.com/ViewPoem.aspx?id=186507",""],[585,"يا أيها القلم انهض إن سواك كبا","https://www.poetsgate.com/ViewPoem.aspx?id=161888",""],[5121,"حنين ودموع","https://www.poetsgate.com/ViewPoem.aspx?id=33628",""],[5121,"مِزَاجُ الشِّعْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=215347",""],[5363,"مفخرة الإنسانية","https://www.poetsgate.com/ViewPoem.aspx?id=144431",""],[5717,"يا حسرة من فؤاد محتدم","https://www.poetsgate.com/ViewPoem.aspx?id=170590",""],[5725,"موت عراقي الشذى","https://www.poetsgate.com/ViewPoem.aspx?id=207163",""],[5751,"كل ما فيها يُغنّي","https://www.poetsgate.com/ViewPoem.aspx?id=215018",""],[5776,"أطوارُ ......عنكبوت الهولوكوست","https://www.poetsgate.com/ViewPoem.aspx?id=199338",""],[5885,"أشتار من جمالها","https://www.poetsgate.com/ViewPoem.aspx?id=203026",""],[5956,"يمزِّقني التعلق والحنينُ","https://www.poetsgate.com/ViewPoem.aspx?id=206981",""],[6144,"فى الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=13797",""],[406,"نقش على حائط الجراح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63257&r=&rc=76",""],[6275,"البريق الضال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83614&r=&rc=6",""]],"verses":[["يُمَزَّقُ بِالعيسِ جَيبَ الدُجى","وَيَهتِكُ بِالخَيلِ صَدرَ النَهارِ",0,"ر",1,0],["يُمَزِّقُ عَنكَ جَيبَ النَق","عِ مَصقولٌ تُسايُرُه",1,"ر",2,0],["يُمَزِّقُ الدَهرُ حَتماً كُلَّ سابِغَةٍ","إِذا نَبَت مَشرَفِيّات وَخرصانُ",2,"ن",1,0],["يمزّقه من الأفواه نفثٌ","ويقطعه من النَسَم الهُبوب",3,"ب",1,0],["يمزح بالجود لا السفاه فإن","جدَّ فزولٌ ذو عقدةٍ مَصِع",4,"ع",1,0],["يُمَزِّقُهُم وَقعُ الصَفيحِ فَموثَقٌ","أَسيرٌ وَمَسلوبُ الحُشاشَةِ مودِ",5,"د",1,0],["يَمزُجُ خَمراً بِجَنى ريقِهِ","رَقرَقَها الساقي بِتَصفيفِهِ",6,"ه",1,1],["يَمزُجُ الكَأسَ لي فَإِن عَزَّتِ الرا","حُ سَقاني مِن ريقِهِ السُكَّرِيِّ",7,"ي",1,0],["يُمَزَّقُ تَكرارُ الصِدامِ جُلودَها","فَتُكسى دَماً ما أَصبَحَ السَيفُ عارِيا",8,"ي",2,0],["يُمزِّقُ بَعضُهم في الأرضِ بعضاً","ويَفْرِي اللحمَ منه والعِظاما",9,"م",2,0],["يُمَزِّقُ رَيّا جُلودِ الثَما","رِ إِذا مَصَّ ماءَ الثِمارِ العَطَش",10,"ش",1,0],["يُمَزِّقُ أَسْتَارَ الظَّلامِ بِأَعْيُنٍ","تَطِيرُ شَراراً كَالسُّقَاطِ مِنَ الزَّنْدِ",11,"د",1,0],["يُمَزِّقُ أَسْتَارَ النَّواظِرِ بَرْقُهُ","وَيَقْرَعُ أَصْدَافَ الْمَسَامِعِ رَعْدُهُ",12,"د",2,0],["يُمَزِّقُ أَسْتَارَ الدُّجُنَّةِ ضَوْؤُهُ","فَيَنْسِلُهَا مَا بَيْنَ غَورٍ إِلَى نَجْدِ",13,"د",1,0],["يمزِّقها الموتُ العنيفُ صِراعُهُ","بأظفاره حُمْراً وأنيابِه سُحما",14,"م",2,0],["يمزعُ جلدَ الحصى أجشّ مبتركٌ","كأنّهُ فاحصٌ أوْ لاعبٌ داحي",15,"ح",2,0],["يمْزُجُ خَمْراً بجَنَى رِيقِهِ","رَقْرَقَها السَّاقِي بِتَصْفيقِهِ",16,"ق",2,1],["يمزّق قلبي البعد عمّن أحبّهم","ولكن رأيت الذلّ أخشن مركبا",17,"ب",2,0],["يمزقه من الافواه نفثٌ","ويقطعه من النسيم الهبوب",18,"ب",1,0],["يمزق الشوق أحشاه كما فتكت","بالغيم عجرفة الهوج المجانين",19,"ن",1,0],["يَمزُجُ الكَأسَ لي بِماءِ رُضابٍ","كَجَنا النَحلِ شيبَ بِالكافورِ",20,"ر",1,0],["يَمزُجُ كَأسَ الراحِ مِن","رُضابِهِ بِراحِ",21,"ح",1,0],["يمزجها لي رشا أغيدٌ","بريقةٍ أحلى من الشهد",22,"د",1,0],["يُمزِّقُ الدَّهْرَ لَيلَ النّقْعِ حيث دَجا","له ذُبالٌ بأطرافِ القَنا الذُّبُل",23,"ل",1,0],["يُمَزِّقُني ذا الحُبُّ كُلَّ مُمَزَّقٍ","وَيُصبِحُ خَلقي فيهِ وَهوَ جديدُ",24,"د",1,1],["يمزج الرَّاح من لماه ويس","قينا حلالاً يشوبه حرام",25,"م",1,0],["يمزّقُ المأزقَ الجمّ","أيّما تمزيقِ",26,"ق",1,0],["يمزُج صِرفَ الكأس في كفّه","من خُلْقه العذبِ بماءٍ زلالْ",27,"ل",1,0],["يُمزَجن إذكاراً بمدحٍ شاكرٍ","والماءُ يُصلِح مزجُه الجريالا",28,"ل",2,0],["يُمَزِّقُونَ الْعِرْضَ مِنْهُ إذا","جَاءَ بِمُرِّ الْحَقِّ فيهم وَرَاحْ",29,"ح",1,0],["يمزّق أَثوابَ الّذي كنتُ أكتسِي","وينزعها بالرّغمِ أيَّ نزوعِ",30,"ع",1,0],["يمزُجْنَ نَضْح مِدَادُهُنْ","نَ بِمُسْتَعَاضِ دَمِ الجِرَاحِ",31,"ح",1,0],["يَمْزِجُ الخَمْرَ بِفيهِ","فَترَى النّاسَ سُكَارى",32,"ر",2,0],["يُمَزِّقُ في البَرِيَّةِ كُلَّ شَملٍ","فَيُصبِحُ مِثلَما نَثَرَ الهَباءُ",33,"ا",2,0],["يمزق شمل المشكلات لوقتها","اذا شيم من فيه الحسام المذرب",34,"ب",1,0],["يُمَزِّقَ منك الذي لا يخيط","تَمَزُّقَهُ أبداً خائط",35,"ط",1,0],["يُمَزِّقُهُ الأراذلُ وهوَ لاهٍ","بقرقعةِ التراشقِ والترامي",36,"م",2,0],["يُمَزِّقُ جِسمَهُ دَوسُ المَذاكي","وَقَد أَعلَت وَلاياهُ العَويلا",37,"ل",2,0],["يمزج لي بالصفو من ريقه","عذبا وبابن المزن بنت العنب",38,"ب",1,0],["يمزج الخمر لنا بالصْ","صفْوِ مِنْ مَاءِ الرُّضابِ",39,"ب",1,0],["يُمزِّق أَحشاءَ الإِمامةِ ظِفرها","عِناداً ويُدمى من دم الوحي نابُها",40,"ب",3,0],["يمزقهم عثمان كُلَّ ممزَّق","فيعلو منار الحق والحق أغلبُ",41,"ب",1,0],["يمزج الماء وهو يجري حثيثاً","في جذوع النباتِ بالأدهانِ",42,"ن",1,0],["يَمزِجونَ الخَمرَ بِالماءِ فَهَل","مَزَجوا إِن شَرِبوها أَدمُعا",43,"ع",2,0],["يُمَزِّقُ أَستارَ النُفوسِ لُعابُهُ","وَيلطِمُ أَنيابَ النَدامى فَيَهتمُ",44,"م",1,0],["يمزج الشهد بسم منقع","كم عذول في الهوى قد عذلا",45,"ل",2,0],["يمزِّقُ جلباب الظلام بكوكب","يخال ذُبالاً بين عينيه مُشعلا",46,"ل",2,0],["يمزُج الدلَّ بالنفارِ ويفتَرُّ","دلالاً عن مثلِ حبِّ الجمانِ",47,"ن",1,0],["يمزجها بالريق لي شادن","يبسم عن ثغر كمثل الأقاح",48,"ح",1,0],["يُمَزِّقُ مِنّي العِرضَ غَيرَ مُراقِبٍ","بِكُلِّ مَكانٍ كانَ مِنّيَ خالِيا",49,"ي",2,0],["يمزق ما تسدى وتلحم فكرتي","مساء من الرأي الصباح إذا استعلا",50,"ل",2,0],["يُمَزِّقُ جِلدَكَ ماضي سِناني","فَتُلقى لَدى الفُلكِ مَيتَ الهَوانِ",51,"ن",1,0],["يَمُزُّونَ مِنها طافِحَاتٍ وبضعدَ ذا","يُدِيرُونَها دَوراً بِكُلِّهِمِ اتَّصَل",52,"ل",1,0],["يَمزج مر النَحيب","بِذكرَيات الغَرام",53,"م",1,0],["يَمزِجُ الماءَ نَجيعاً","وَيُنادي عَلّلاني",54,"ن",2,0],["ي مزورين الهرج في بثّ الاعلام","تدليسكم وان زان يترك علامه",55,"م",2,0],["يمزق الغزو منها كل ناحيةٍ","وينشر الرعب والإملاق والسغبا",56,"ب",2,0],["يُُمَزِّقُني حنينٌ للحبيبِ","يُفتِّتُني بأحشاءِ النَّحيبِ",57,"ب",1,1],["يَمُزُّ الشُّعُورَ نَدِيمُ الْكَرَى","فَيَسْكَرُ حَتَّى يَفِيض الْهَوَى",58,"و",2,0],["يمزّق بالصلاة جنود حزبٍ","لإبليس اللعين من الصلاءِ",59,"ا",2,0],["يمزجها ذكر ربه بدم","لا ذكر جيرانه بذي سلم",60,"م",1,0],["يمزج الصبر بأقداح الردى","يحتسيها كلّ ليثٍ مبسلِ",61,"ل",1,0],["يمزقني انا منها احتشادٌ","يشتتني ويأخذني العبابُ",62,"ب",1,0],["يُمَزّقُ النّومَ في أسْفَارِ مَرْقَدِهِ","يُغالِبُ (الإيلَ)... للغلاّبِ ميزاتُ",63,"ت",1,0],["يمزج بالوصل اللذيذ ليلا","بحيث لا يبصره النهار",64,"ر",1,0],["يمزقني التعلق والحنينُ","لكل أماكنٍ فيها أكونُ",65,"ن",1,1],["يمزعوا فى الجيوب ويفتحوا الدكاكين ؟","أسأل وزير الشئون ولا أكلم مين ؟",66,"ن",1,0],["يمزق الطفل تمزيقاً وما ذرفت","عين السياسة، أو أبدت له غضبا",67,"ب",2,0],["يمزج الروح بعطر","وانفلات الأبديهْ",68,"ي",2,0]]}