{"poems":[[53,"أبا الصقر لست أرى مهديا","https://www.aldiwan.net/poem8301.html","المتقارب"],[99,"لعينيك احتملنا ما احتملنا","https://www.aldiwan.net/poem24770.html","الوافر"],[92,"فداء لمثواك","https://www.aldiwan.net/poem59036.html","عموديه"],[102,"أخر جديد","https://www.poetsgate.com/ViewPoem.aspx?id=50333",""],[203,"نزع القلب بي فسرت رويدا","https://www.aldiwan.net/poem45582.html","الخفيف"],[240,"ياسمي النبي يا ابن علي","https://www.aldiwan.net/poem31970.html","الخفيف"],[469,"بين حزني وحسنه اليوسفي","https://www.aldiwan.net/poem3166.html","عموديه"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112794","الطويل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111866","الخفيف"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126655","الوافر"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71051","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53226","الخفيف"],[2430,"","https://poetry.dctabudhabi.ae/diwan/poem/143672","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58288","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200698","الخفيف"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93758","الرمل"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62130","الخفيف"],[5829,"سليمى","https://www.poetsgate.com/ViewPoem.aspx?id=210709",""]],"verses":[["ورانَ على قلبه رَيْنُهُ","فليس يُريه صوابي صوابا",0,"ب",2,0],["وران على نوافذها ظلامٌ","وقد كانت تطلّ كألف عينِ",1,"ن",1,0],["وَرَانَ سَحَابٌ صَفِيقُ الحِجَاب","عَلَيَّ مِنَ القَلَقِ المُفْزِعِ",2,"ع",1,0],["ورآني الباب ، فمد على","كتفيّ ، الخضرة والظّلاّ",3,"ل",2,0],["ورآني بذلةِ العاشقِ الصبِّ","فصدتهُ عزةُ المعشوقِ",4,"ق",1,0],["وَرَآني أَهلُ التَشَيُّعِ في الكَر","خِ بِتاسومَةٍ وَذَيلٍ قَصيرٍ",5,"ر",1,0],["ورآني أهل الولاء وما أح","سن وقع الوالي عند الوالي",6,"ي",1,0],["وران جناني فاكشفنه وابدلنه","نورا والهمني يقينا بلا شك",7,"ك",1,0],["ورآني اسومُ نحتَ القوافي","فلحاني فقلتُ خلِّ الملامه",8,"م",2,0],["ورانك آن أن تقنع","بأشواكي ووخزتها",9,"ه",2,0],["ورآني مولاي منه بَعْينِ","هي ليست تنام كالأَعْيانِ",10,"ن",1,0],["ورآنِي ميتاً فكانت حياتي","ما روى من مقاتل الفرسان",11,"ن",1,0],["ورآني الأنام طراً بعيني","زاهد في وضيعهم والشريف",12,"ف",1,0],["ورآني مُلقى لديه صريحاً","فَرَقَاني برُقية الأَقسام",13,"م",1,0],["ورآني الزمان جيّد ذوقٍ","فرماني بأجود النكبات",14,"ت",1,0],["وَرآني طبق ما تَع","هدني للصدق أَهلا",15,"ل",2,0],["ورآني بلا عقار فكادت","صفحة منه تستهل عقارا",16,"ر",2,0],["ورآني السحاب أسحب حالاً","ذات عدم فذاب ماءً ونارا",16,"ر",2,0],["وران على الفؤادِ الهجرٌ حتى","كثيب الشوقِ في الأضلاع أرخى",17,"ا",1,0]]}