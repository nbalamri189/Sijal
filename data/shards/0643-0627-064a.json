{"poems":[[53,"عند قلبي علاقة ما تقضى","https://www.aldiwan.net/poem30174.html","الخفيف"],[53,"هوى لكما إن الشباب يعاد","https://www.aldiwan.net/poem30513.html","الطويل"],[53,"أبى الله إلا أن يسوء بك العدى","https://www.aldiwan.net/poem30635.html","الطويل"],[93,"هي زهرة بسمت بها","https://www.aldiwan.net/poem11469.html","مجزوء الكامل"],[51,"الحب ريحان المحب وراحه","https://www.aldiwan.net/poem9398.html","الكامل"],[91,"لو رأى آدم فتاه لزال الحقد","https://www.aldiwan.net/poem8729.html","عموديه"],[62,"نظري إلى لمع الوميض حنين","https://www.aldiwan.net/poem52265.html","الكامل"],[61,"محلك مثل الغاب ليس يرام","https://www.aldiwan.net/poem51457.html","الطويل"],[52,"كايدكم دهركم بزامرة","https://www.aldiwan.net/poem27330.html","المنسرح"],[1,"أصحوت اليوم أم شاقتك هر","https://www.aldiwan.net/poem33999.html","الرمل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16683","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54699","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54641","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54766","الكامل"],[233,"جد بقلبي ومزح","https://www.aldiwan.net/poem32108.html","مجزوء الرجز"],[278,"أمن الملك حسبك من أمين","https://www.aldiwan.net/poem60689.html","الكامل"],[326,"فوق هذي الربا أقمت وحيدا","https://www.aldiwan.net/poem54989.html","الخفيف"],[355,"أضاء ببرقة برق لموع","https://www.aldiwan.net/poem4163.html","الوافر"],[380,"كائن كملحان فينا من أخي ثقة","https://www.aldiwan.net/poem24194.html","البسيط"],[397,"رذاذ","https://www.aldiwan.net/poem10306.html","عموديه"],[399,"لولا ضني جسدي والمدمع الجاري","https://www.aldiwan.net/poem46918.html","البسيط"],[456,"كيف رأيت الإبلا","https://www.aldiwan.net/poem55956.html","مجزوء الرجز"],[462,"عاد من عيد وصله ما تولى","https://www.aldiwan.net/poem3155.html","عموديه"],[565,"كايدني دهري في طرتي","https://www.aldiwan.net/poem69693.html","السريع"]],"verses":[["كايِناً لِلأَنوفِ جَدعاً وَرَغماً","وَلِهامِ الأَعداءِ وَقماً وَغَضّا",0,"ض",2,0],["كَأَيدي العَذارى الفاقِداتِ تَدارَعَت","لِلَدمِ الطُلى أَطمارُهُنَّ حِدادُ",1,"د",1,0],["كَأَيّامِ حَنوَي دارَزينَ وَأَربِقٍ","مَواقِفُ أَخبى الطَعنُ فيها وَأَوقَدا",2,"د",2,0],["كَائِنْ تُخَفِّفُ عَنْهُمُ","مِنْ وَطْأَةِ الخَطْبِ الثَّقِيلْ",3,"ل",1,0],["كائنْ لهُ حَزْمٌ إليَّ يروقني","حُسْناً ويَقْبُحُ عندي استقباحُه",4,"ح",2,0],["كائِنٌ كُلُّ كائِنٍ حارَ فيهِ","فَهوَ حُلوٌ مُرٌّ وَدانٍ ناءِ",5,"ا",2,0],["كايلْهُمُ بالصاعِ صاعاً واجزِهمْ","بِتراتِهم إنّ التِراتِ ديونُ",6,"ن",1,0],["كأيامِ سيفِ الدولةِ الغرِّ إنّها","سِماتٌ على وَجه الزمانِ وشَامُ",7,"م",1,0],["كايَدَكُم دَهرُكُم بِزامِرَةٍ","تُحدِثُ غَمّاً في كُلِّ سَراءِ",8,"ا",2,1],["كائِراتٍ وَتَراها تَنتَحي","مُسلَحِبّاتٍ إِذا جَدَّ الحُضُر",9,"ر",1,0],["كائِناً للمَنونِ هَرونَ في البَعْ","ثِ لمُوسى عَوْناً له وَوَزيرا",10,"ر",2,0],["كَائِنٌ أَضَفْتَ طَرِيفاً","إِلَى الْفَخَارِ الْعَتِيدِ",11,"د",1,0],["كَائِنْ جَهِدْتِ لإنْصَافِ الشُّعوبِ وَكِمْ","شَهِدْتِ مُؤْتَمَراً فِي كُلِّ مُغْتَرَبِ",12,"ب",1,0],["كَائِنْ لَهُ وَلآلِهِ دَيْنٌ عَلَى","أَوْطَانِهِمْ وَالعالِمُونَ شُهُودُ",13,"د",1,0],["كَأَيِّ عَهدٍ وَدَمٍ","عَلى يَدَيهِ لَم يُطَح",14,"ح",1,0],["كَأَيّامِ الصِّبا حَسُنَتْ وَرَقَّتْ","وَأَيّامِ الصَّبابَةِ وَالشُّجُونِ",15,"ن",1,0],["كائن كلُّ كائن منه يأتي","وإليه إذا انتهى منتهاه",16,"ه",1,0],["كَإِيمَاءِ الحَوَاجِبِ يَومَ بَينٍ","بِتَسلِيمٍ وَقَد غَفَلَ الجَمِيعُ",17,"ع",1,0],["كائِن كَمِلحانَ فينا مِن أَخي ثِقَةٍ","أَو كَاِبنِ عَلقَمَةَ المُستَشهِدِ الشاري",18,"ي",1,1],["كإيقاعِ أوراقِ الزُّهور يهُزُّها","نسيمٌ تهادى حَوْلَها وتصابى",19,"ب",2,0],["كآيَة الودّ والتطهير والنبأ العظيم","حقاً فما مقدار أفكاري",20,"ي",1,0],["كايَلَنِيكَ الدهرُ بال","ناس زمانَ عدَلا",21,"ل",2,0],["كائناتٌ لمن تأملَ حسناً","ولمن أحسن التفهم عقلا",22,"ل",2,0],["كايَدَني دهْرِي في طُرَّتي","بِشَيْبَةٍ ألْبَسَني عارَهَا",23,"ر",3,1]]}