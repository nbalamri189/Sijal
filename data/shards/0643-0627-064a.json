{"poems":[[55,"عند قلبي علاقة ما تقضى","https://www.aldiwan.net/poem30174.html","الخفيف"],[55,"هوى لكما إن الشباب يعاد","https://www.aldiwan.net/poem30513.html","الطويل"],[55,"أبى الله إلا أن يسوء بك العدى","https://www.aldiwan.net/poem30635.html","الطويل"],[95,"هي زهرة بسمت بها","https://www.aldiwan.net/poem11469.html","مجزوء الكامل"],[53,"الحب ريحان المحب وراحه","https://www.aldiwan.net/poem9398.html","الكامل"],[93,"لو رأى آدم فتاه لزال الحقد","https://www.aldiwan.net/poem8729.html","عموديه"],[64,"نظري إلى لمع الوميض حنين","https://www.aldiwan.net/poem52265.html","الكامل"],[63,"محلك مثل الغاب ليس يرام","https://www.aldiwan.net/poem51457.html","الطويل"],[54,"كايدكم دهركم بزامرة","https://www.aldiwan.net/poem27330.html","المنسرح"],[1,"أصحوت اليوم أم شاقتك هر","https://www.aldiwan.net/poem33999.html","الرمل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16683","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54699","المجتث"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54641","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54766","الكامل"],[111,"سميري وهل للمستهام سميرُ ( النهروانية )","https://www.poetsgate.com/ViewPoem.aspx?id=511",""],[240,"جد بقلبي ومزح","https://www.aldiwan.net/poem32108.html","مجزوء الرجز"],[285,"أمن الملك حسبك من أمين","https://www.aldiwan.net/poem60689.html","الكامل"],[333,"فوق هذي الربا أقمت وحيدا","https://www.aldiwan.net/poem54989.html","الخفيف"],[362,"أضاء ببرقة برق لموع","https://www.aldiwan.net/poem4163.html","الوافر"],[388,"كائن كملحان فينا من أخي ثقة","https://www.aldiwan.net/poem24194.html","البسيط"],[406,"رذاذ","https://www.aldiwan.net/poem10306.html","عموديه"],[408,"لولا ضني جسدي والمدمع الجاري","https://www.aldiwan.net/poem46918.html","البسيط"],[463,"كيف رأيت الإبلا","https://www.aldiwan.net/poem55956.html","مجزوء الرجز"],[469,"عاد من عيد وصله ما تولى","https://www.aldiwan.net/poem3155.html","عموديه"],[572,"كايدني دهري في طرتي","https://www.aldiwan.net/poem69693.html","السريع"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88595","الخفيف"],[2176,"","https://poetry.dctabudhabi.ae/diwan/poem/69469","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27974","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93920","الطويل"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115753","الخفيف"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100790","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89222","البسيط"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59460","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59461","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77183","الوافر"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81926","الخفيف"],[4303,"","https://poetry.dctabudhabi.ae/diwan/poem/110655","البسيط"],[4478,"","https://poetry.dctabudhabi.ae/diwan/poem/18798","البسيط"],[4755,"ضَيَّعَ الفَجرُ وَجْهَهُ واتّجَاهَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=183863",""],[4823,"طائر الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=188281",""],[4960,"في وداع طِفلة","https://www.poetsgate.com/ViewPoem.aspx?id=210407",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5351,"غامض","https://www.poetsgate.com/ViewPoem.aspx?id=202101",""],[5461,"من يقول الزين ما يكمل","https://www.poetsgate.com/ViewPoem.aspx?id=8547",""],[5552,"صوت من المخيم","https://www.poetsgate.com/ViewPoem.aspx?id=18416",""],[5956,"مناهل إلهامي","https://www.poetsgate.com/ViewPoem.aspx?id=185878",""]],"verses":[["كايِناً لِلأَنوفِ جَدعاً وَرَغماً","وَلِهامِ الأَعداءِ وَقماً وَغَضّا",0,"ض",2,0],["كَأَيدي العَذارى الفاقِداتِ تَدارَعَت","لِلَدمِ الطُلى أَطمارُهُنَّ حِدادُ",1,"د",1,0],["كَأَيّامِ حَنوَي دارَزينَ وَأَربِقٍ","مَواقِفُ أَخبى الطَعنُ فيها وَأَوقَدا",2,"د",2,0],["كَائِنْ تُخَفِّفُ عَنْهُمُ","مِنْ وَطْأَةِ الخَطْبِ الثَّقِيلْ",3,"ل",1,0],["كائنْ لهُ حَزْمٌ إليَّ يروقني","حُسْناً ويَقْبُحُ عندي استقباحُه",4,"ح",2,0],["كائِنٌ كُلُّ كائِنٍ حارَ فيهِ","فَهوَ حُلوٌ مُرٌّ وَدانٍ ناءِ",5,"ا",2,0],["كايلْهُمُ بالصاعِ صاعاً واجزِهمْ","بِتراتِهم إنّ التِراتِ ديونُ",6,"ن",1,0],["كأيامِ سيفِ الدولةِ الغرِّ إنّها","سِماتٌ على وَجه الزمانِ وشَامُ",7,"م",1,0],["كايَدَكُم دَهرُكُم بِزامِرَةٍ","تُحدِثُ غَمّاً في كُلِّ سَراءِ",8,"ا",2,1],["كائِراتٍ وَتَراها تَنتَحي","مُسلَحِبّاتٍ إِذا جَدَّ الحُضُر",9,"ر",1,0],["كائِناً للمَنونِ هَرونَ في البَعْ","ثِ لمُوسى عَوْناً له وَوَزيرا",10,"ر",2,0],["كَائِنٌ أَضَفْتَ طَرِيفاً","إِلَى الْفَخَارِ الْعَتِيدِ",11,"د",1,0],["كَائِنْ جَهِدْتِ لإنْصَافِ الشُّعوبِ وَكِمْ","شَهِدْتِ مُؤْتَمَراً فِي كُلِّ مُغْتَرَبِ",12,"ب",1,0],["كَائِنْ لَهُ وَلآلِهِ دَيْنٌ عَلَى","أَوْطَانِهِمْ وَالعالِمُونَ شُهُودُ",13,"د",1,0],["كأي رأينا عالما ضل سعيه","وضل به جم هناك غفير",14,"ر",1,0],["كَأَيِّ عَهدٍ وَدَمٍ","عَلى يَدَيهِ لَم يُطَح",15,"ح",1,0],["كَأَيّامِ الصِّبا حَسُنَتْ وَرَقَّتْ","وَأَيّامِ الصَّبابَةِ وَالشُّجُونِ",16,"ن",1,0],["كائن كلُّ كائن منه يأتي","وإليه إذا انتهى منتهاه",17,"ه",1,0],["كَإِيمَاءِ الحَوَاجِبِ يَومَ بَينٍ","بِتَسلِيمٍ وَقَد غَفَلَ الجَمِيعُ",18,"ع",1,0],["كائِن كَمِلحانَ فينا مِن أَخي ثِقَةٍ","أَو كَاِبنِ عَلقَمَةَ المُستَشهِدِ الشاري",19,"ر",2,1],["كإيقاعِ أوراقِ الزُّهور يهُزُّها","نسيمٌ تهادى حَوْلَها وتصابى",20,"ب",2,0],["كآيَة الودّ والتطهير والنبأ العظيم","حقاً فما مقدار أفكاري",21,"ر",2,0],["كايَلَنِيكَ الدهرُ بال","ناس زمانَ عدَلا",22,"ل",2,0],["كائناتٌ لمن تأملَ حسناً","ولمن أحسن التفهم عقلا",23,"ل",2,0],["كايَدَني دهْرِي في طُرَّتي","بِشَيْبَةٍ ألْبَسَني عارَهَا",24,"ر",3,1],["كائناً للمنون هارون في البعث","لموسى عوناً له وَوَزيرا",25,"ر",2,0],["كَأَيّن تَرى في البَرمَكيّينَ مِن نَدىً","وَمِن سابِقاتٍ ما يُشَقُّ غُبارُها",26,"ر",3,0],["كآية الشورى سلب وهي مثبتة","ما قد نفته من إدراك بآلات",27,"ت",1,0],["كأين ترى في الروض من دوحة سمت","وما شجر التفاح كالأثل والخمط",28,"ط",1,0],["كأيادي الكريم لينا وبسطا","وأيادي البخيل يبسا وضمّا",29,"م",2,0],["كائن حقرت الدهر حيث تعينه","كوارث مرت فوق رأسك عون",30,"ن",1,0],["كإير عَيرٍ إذا ما كان خازنه","وفي تراخيه منديل به أَرَضَهْ",31,"ض",2,0],["كائن تركت مُدَّججاً ذا نخوة","في لَحدهِ ومُدَّججاً في يُلحدِ",32,"د",1,0],["كائن حصدتُ به الرقا","بَ إذا استطارَ النَّقعُ حصدا",33,"د",2,0],["كَإيناس الضُيوف بِطيبِ نَفس","وَمِن صلة بِأَرحام وَبر",34,"ر",1,0],["كائنات ألقت الفرس إليها","بأعرابها العرباءَ",35,"ا",2,0],["كايلته الوجد يبديه واستره","فكان أحملنا للوجد ساتره",36,"ر",2,0],["كائِنٍ ذَهَبتُ فَرَدّاني بِكَبدِهِما","عَمّا طَلَبتُ وَجاءاها بِما طُلِبا",37,"ب",2,0],["كائِناتُ الظَّلامِ تَنمُو سَريعًا","كالمَآسِي.. وتَنتَهِي كالشَّرَاهَةْ",38,"ا",3,0],["كائنٌ نصفُهُ الغناءُ فأمسى","بعضُهُ صامتاً يشيعُ بعضَهْ",39,"ض",2,0],["كأيِّ عصفورةٍ ضاقت بها السبُلُ","ظلًت إلى الماوراء الرحب ترتحِلُ",40,"ل",1,1],["كإيراده جهلاً حكاية مالكٍ","هناك مع المنصور للأعين الرمد",41,"د",1,0],["كائناً من أي وهمٍ يا ترى؟","جئتَ بالأمس ولن تأتي غداً",42,"د",2,0],["كايد(ن) ماهو يلين لمن بغاه","يرتفع عن كل سقطات الزلل",43,"ل",1,0],["كائنٌ قد تحارُ فيه البَرايَا","صامدٌ خالد يعيد الحكايهْ",44,"ا",3,0],["كأي حديث من رفاقي وقصة","ولحنِ طيور أو صهيل تحمحما",45,"م",2,0]]}