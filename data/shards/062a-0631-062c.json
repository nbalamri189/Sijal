ل"],[429,"فدر التهاني أرانا طالعا حسنا","https://www.aldiwan.net/poem39857.html","البسيط"],[429,"وافى يطوف بشمس كاسه","https://www.aldiwan.net/poem40239.html","مجزوء الكامل"],[429,"للعين من ألم الأحشاءِ عبرات","https://www.aldiwan.net/poem40534.html","البسيط"],[429,"حكم المنية سهم والورى عرض","https://www.aldiwan.net/poem40708.html","البسيط"],[437,"أمن أميمة مصطاف ومرتبع","https://www.aldiwan.net/poem2573.html","البسيط"],[437,"سلام عليكم والتحية تكتب","https://www.aldiwan.net/poem2601.html","الطويل"],[441,"عجبا لراج فوز ناج سابق","https://www.aldiwan.net/poem14317.html","الكامل"],[441,"الموت في نفسي أغدو به وأجي","https://www.aldiwan.net/poem14360.html","البسيط"],[441,"الصبر من كرم الأخلاق فاصطبر","https://www.aldiwan.net/poem14368.html","البسيط"],[452,"غيري يلذ له الهوى بهوان","https://www.aldiwan.net/poem13931.html","الكامل"],[453,"عمر ينقضي برشد وغى","https://www.aldiwan.net/poem61787.html","الخفيف"],[458,"ما جد السعي أتاه ما سعى له","https://www.aldiwan.net/poem55933.html","الرمل"],[458,"آنس برقا بالشريف لامعا","https://www.aldiwan.net/poem56123.html","الرجز"],[458,"أَستنجِد الصبر فيكم وهو مغلوب","https://www.aldiwan.net/poem56300.html","البسيط"],[461,"ربعي من بني جشم","https://www.aldiwan.net/poem15121.html","المديد"],[464,"عزاء فمن ودعته ليس يرجع","https://www.aldiwan.net/poem3395.html","عموديه"],[470,"يا للرجال لوجدك المتجدد","https://www.aldiwan.net/poem4675.html","الكامل"],[479,"القول كالبرق والأعمال كالمطر","https://www.aldiwan.net/poem37185.html","البسيط"],[479,"أناخ في قلب ليلى هاجس الشجن","https://www.aldiwan.net/poem37572.html","البسيط"],[479,"ذمم تباع وتشترى","https://www.aldiwan.net/poem37604.html","مجزوء الكامل"],[482,"أنخت مطايا الذل نحوك ملقيا","https://www.aldiwan.net/poem24461.html","عموديه"],[500,"هب النسيم فسار بالأسرار","https://www.aldiwan.net/poem38018.html","الكامل"],[500,"أي راح دارت به الأقداح","https://www.aldiwan.net/poem38045.html","الخفيف"],[514,"روت عن تراقيها العقود عن النحر","https://www.aldiwan.net/poem20796.html","الطويل"],[514,"خلط الغرام الشجو في أمشاجه","https://www.aldiwan.net/poem20829.html","الكامل"],[515,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[515,"هنئت مفتتح الصيام السافر","https://www.aldiwan.net/poem12120.html","الكامل"],[515,"ما عن هوى الرشأ العذري أعذار","https://www.aldiwan.net/poem12136.html","البسيط"],[529,"مكحولة الحدقات وطفا","https://www.aldiwan.net/poem37321.html","مجزوء الكامل"],[549,"أمن القتول منازل ومعرس","https://www.aldiwan.net/poem446.html",""],[551,"فجعة ما احتسبتها في زماني","https://www.aldiwan.net/poem47168.html","الخفيف"],[551,"يا راكبا وصل الوجيف ذميله","https://www.aldiwan.net/poem47335.html","الكامل"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["تُرَجِّعُ الحَنينَ وَالبُغاما","شَكوى المَريضِ ماطِلِ السَقاما",0,"م",2,0],["تُرَجّي ثَراءً مِن سِياسٍ وَمِثلِها","وَمِن قَبلِها ما كُنتَ لِلمالِ راجِيا",1,"ي",2,0],["تَرجوهُ أَملاكُ الزَمانِ وَتَتَّقي","سَطواتِ ضرّارٍ لَهُم نَفّاعٍ",2,"ع",1,0],["تَرْجُو ابْنَهُ لِمَفَاخِرَ وَعُلَى","فِي إِثْرِ وَالدِهِ يُجَدِّدُهَا",3,"د",3,0],["تَرْجُو البِلاَدُ عَلَى يَدَيْكَ رُقيَّهَا","وَذَرِيعَتَاهُ عَزِيمَةٌ وَنِظَامُ",4,"م",1,0],["تَرجو الصِبا بَعدَ ما شابَت ذَوائِبُها","وَقَد جَرَت طَلَقاً في حَلبَةِ الكِبَرِ",5,"ر",1,0],["تَرَجَّلَ وَضَّاحٌ وأَسبَلَ بَعدَما","تَكَهَّلَ حِيناً في الكُهُولِ وَمَا احتَلَم",6,"م",1,1],["ترجو قَبولك وهو أكبر منحة","فاسمحْ به خُلَّدتَ من متكرْمِ",7,"م",1,0],["ترجو الخلاص ولم تنهجُ مسالِكها","من باعَ رشداً بِغَيَّ قلّما ربحا",8,"ح",2,0],["تَرجو الهَوادَةَ تَيمٌ بَعدَما وَقَعَت","صَمّاءُ لَيسَ لَها سَمعٌ وَلا بَصَرُ",9,"ر",1,0],["تَرجو الهَوادَةَ يا فَرَزدَقُ بَعدَما","أَطفَأتَ نارَكَ وَاِصطَلَيتَ بِناري",10,"ر",2,0],["ترجَّى لدنياه الملوك وإننا","لنرجوه للدنيا ملاذاً وللأخرى",11,"ر",2,0],["ترجو سواك لدىَ التفكّهِ بالمنى","لكن عليك يُحَصْحص التعويلُ",12,"ل",1,0],["تَرْجوكَ يا مَنْ غدا للناسِ وهْو أبٌ","ولم تشبِ وهُمُ شِيبٌ وشُبَّان",13,"ن",1,0],["تُرَجّي مِن سَعيدِ بَني لُؤَيٍّ","أَخي الأَعياصِ أَنواءً غِزارا",14,"ر",2,0],["تَرجو السَّعادَةَ يا قلبي ولو وُجِدَتْ","في الكونِ لم يشتعلْ حُزْنٌ ولا أَلَمُ",15,"م",1,1],["ترجو من الدهر السلام وقلما","يصفي لك الدهر الاثيم سلاما",16,"م",2,1],["ترجِّي فيك بعد الموت عيشاً","فوا أسفاه إن خاب الرجاءُ",17,"ا",2,0],["ترجو قبولا علها ترتوى","من مورد تهفو إلى عذبه",18,"ب",2,0],["ترجع النفس للحقيقة فيها","وترى أن ما مضى تضليل",19,"ل",1,0],["تُرجى لَهُم وَاللَهُ جَلَّ جَلالُهُ","مِنّا وَمِنكَ بِهِم أَبَرُّ وَأَرفَقُ",20,"ق",1,0],["تُرجَحُ السِلمُ إِذا حَرَّكتَهُ","كِفَّةً أَو تُرجَحُ الحَربُ الزَبون",21,"ن",1,0],["تُرَجّي لِبانيهِما عَودَةً","وَكَيفَ يَعودُ الرَميمُ النَخِر",22,"ر",1,0],["ترجو البَقاءَ بدارِ لا ثَباتَ لها","فهل سَمِعْتَ بظلٍّ غيرِ منتقلِ",23,"ل",1,0],["تُرجى الرَغيباتُ في ذُراهُ","وَيُؤمَنُ الحادِثُ المَخوفُ",24,"ف",1,0],["تُرَجّي خُراسانٌ جَلاءَ ظَلامِها","بِبَدرٍ مِنَ الغَربِ اِرتِقابُ طُلوعِهِ",25,"ع",2,0],["تُرَجّي أَن تَزيدَ بَنو فُقَيمٍ","صِغارُهُم وَقَد أَعيَوا كِبارا",26,"ر",2,1],["تَرجو النَجاةَ وَلَم تَسلُك مَسالِكَها","إِن السَفينَةَ لا تَجري عَلى اليَبَسِ",27,"س",1,0],["تُرجى فَوائِدُهُ وَيُخشى بَأسُهُ","كَالنارِ تَمنَحُكَ الضِياءُ وَتُحرِقُ",28,"ق",1,0],["تُرجى مَواهِبُهُ وَيُرهَبُ بَطشُهُ","مِثلَ الزَمانِ مُسالِماً وَمُحارِبا",29,"ب",2,0],["ترجِّعُ فيها ضروبَ اللحونِ","فَتُطْرِبُنا وَهْيَ لا تفهمُ",30,"م",1,0],["تَرجَمَ الدَمعُ في صَحائِفِ خَدَّي","هِ سُطوراً مُؤَلَّفاتِ الحُروفِ",31,"ف",1,0],["تُرجى لَها عَودَةٌ في الدَهرِ صالِحَةٌ","فَالآنَ أَضمَرَ مِنها اليَأسَ راجيها",32,"ي",3,0],["تَرَجَّحَ فِي مَهْدٍ مِنَ الأَيْكِ لا يَنِي","يَمِيلُ عَلَيْهِ مَائِلاً وَمُقَوَّما",33,"م",2,0],["تُرجِعُ الصَوتَ بِالبُغامِ إِلى جَو","فٍ تُناغي بِهِ الشِعابَ الرِغابا",34,"ب",2,0],["تَرَجَّحُ في مَوشِيَّةٍ ذَهَبِيَّةٍ","كَما اِشتَبَكَت زُهرُ النُجومِ عَلى البَدرِ",35,"ر",1,0],["تَرجو بِنَجدَتِهِ اِنقِضاءَ شَقائِها","وَهوَ الَّذي بِقُعودِهِ يُشقيها",36,"ي",3,0],["تَرُجُّ دفوفُها الأبطالَ رجّا","وتلك خمورُ عسكركِ المرجَّى",37,"ج",2,0],["تُرَجّي نِساءُ الأُزدِ طَلعَةَ ثابِتٍ","أَسيراً وَلَم يَدرينَ كَيفَ حَويلي",38,"ي",1,1],["تَرجُو الوُشاةُ بِأَني فِيكِ أَرهَبُهُم","وَكُنتُ أَحسِبُهُم مِن ذاكَ قَد يَئِسُوا",39,"س",3,0],["تُرَجِّلُ شَعرَها وَتُطيلُ صُدغاً","وَتَلوي كُمَّها فِعلَ الغُلامِ",40,"م",1,0],["تَرجو غَداً وَغَدٌ كَحامِلَةٍ","في الحَيِّ لا يَدرونَ ما تَلِدُ",41,"د",1,0],["تَرجِعُ النَفسُ إِذا وَقَّرتَها","وَدَواءُ الهَمِّ مِن خَمرٍ وَما",42,"ا",1,0],["تَرجِعُ النَفسُ إِذا وَقَّرتَها","وَشِفاءُ الهَمِّ في خَمرٍ وَماءِ",43,"ا",2,1],["تَرجو اِنفِساحاً وَكَم لِلماءِ مِن جِهَةٍ","إِذا تَخَلَّصَ مِن ضيقِ الأَنابيبِ",44,"ب",1,0],["تَرجُ بِذاكَ العَفوَ مِنهُ إِذا","أَلحَدَت ثُمَّ اِنصَرَفَ اللاحِدُ",45,"د",1,0],["تَرجو يَهودُ المَسيحَ يَأتي","وَتَأمُلُ الدَهرَ أَن يَهودا",46,"د",2,1],["تَرَجَّ بِلُطفِ القَولِ رَدَّ مُخالِفٍ","إِلَيكَ فَكَم طِرفٍ يُسَكَّنُ بِالنَقرِ",47,"ر",1,1],["تُرجى الحَياةُ إِذا كانَت مُوَدَّعَةً","وَقَلَّ خَيرُ حَياةٍ حَشوها كُلَفُ",48,"ف",1,0],["تَرجو قُبولَ مَليكٍ لا نَظيرَ لَهُ","وَقَد أَتَيتَ إِلى عَبدٍ فَما قَبِلَك",49,"ك",1,0],["تَرَجّى عِندَها وَصلاً","رُوَيداً إِنَّها عارِك",50,"ك",1,0],["تَرجو لَهُ مِن نَعيمِ الدَهرِ مُمتَنَعاً","وَما عَلِمتَ بِأَنَّ العَيشَ يُشقيهِ",51,"ق",3,0],["تَرجو مروءته وَهَل","يأتي المروءَة من أَباها",52,"ا",3,0],["تَرْجو رِضى المَلِكِ الذي","مَنَحَ المُلوكَ جَلالَها",53,"ل",3,0],["ترجي الحياة وأسبابها","وتطلب عند المليك الزلف",54,"ف",1,0],["ترجّل الحماةُ عن حصونها","ونزل الأباةُ عن مصونها",55,"ه",2,0],["ترجرجتْ بالفئتين أرضهُ","وضاق عنهم طولُهُ وعرضُهُ",56,"ه",1,0],["تُرَجِّيها وقَد صابَت بِقُرٍّ","كما تَرجُو أَصاغِرَها عَتيبُ",57,"ب",1,0],["تَرْجَمْتَهُ فَبَدَتْ لأَعْيُنِهِم","آياتُ وَحْيٍ كُنَّ فِي حُجُبِ",58,"ب",1,0],["تَرْجو وَتُلْحِفُ سَائِلاً","أَمَّا المجِيبُ فَلاَ أَحَدْ",59,"د",1,0],["تَرجيعُ قَعقَعَةِ الشَكيمِ إِذا سَرَت","لِعُداتِها بَدَلٌ مِنَ الإيعادِ",60,"د",1,0],["ترجو النجاة ولم تسلك طريقتها","إن السفينة لا تجري على اليبس",61,"س",1,0],["تَرجَّلَ المُلْكُ إكراماً له ومَشَتْ","خواشعاً – ساسةٌ غُرٌّ – كرُهبان",62,"ن",1,0],["ترجمت عن أساك فهي قصيد","لم يفته البيان والانتقاء",63,"ا",2,0],["تَرَجَّحَ فِي مَهْدٍ مِنَ الأَيْكِ، لا يَنِي","يميلُ عليهِ مائلاً وَ مقوا",64,"ق",3,0],["تُرَجِّعَ مَنطِقاً عَجَباً وَأَوفَت","كَنائِحَةٍ أَتَت نَوحاً قياما",65,"م",2,0],["ترجع الطرف خاسئا وكليلا","من حسود بورطة الوزر عاني",66,"ن",2,0],["ترجمان الرحمن في كل شأن","وتلجى قبوله للدعاء",67,"ا",2,0],["تَرجو انتهاءَ اعتقالي","لكي تَقُضَّ الخِيام",68,"م",1,0],["تُرَجّونَ مِنّا خُطَّةً دونَ نيلِها","ضِرابٌ وَطَعنٌ بِالوَشيجِ المُقَوَّمِ",69,"م",1,0],["تُرَجّونَ أَن نَسخى بِقَتلِ مُحَمَّدٍ","وَلَم تَختَضِب سُمرُ العَوالي مِنَ الدَمِ",69,"م",1,0],["ترجُو سُلوَّكَ في رسومٍ بينها ال","أغصانُ سَكرَى والحمامُ متَّيُم",70,"م",1,0],["تُرجى مَواهِبُهُ وَيُضحي خَوفُهُ","وَلَهُ بِأَلبابِ الوَرى إِلبابُ",71,"ب",1,0],["ترجو الإِقامة في دار منقلة","وتغفلُ الزادَ فيها إذ دَنَا السَّفَرُ",72,"ر",1,0],["ترجو نجاةً بغير فعل","وتلك لا شكَّ مستحيله",73,"ل",2,0],["ترجى وتخشى ولكن خشيةٌ معها","حسن الرَّجا في عظيم أَنت غافره",74,"ر",2,0],["ترجينا الأنام وتتقينا","لديك ونحن نعرف كيف كنا",75,"ن",2,0],["تُرَجِّي بِهِ دِيناً وَدُنيا لِأَنَّهُ","إِلى اللَهِ في الدُنيا وَفي الدينِ سُلَّمُ",76,"م",1,0],["تُرَجِّيهِ العُفاةُ وَتَتَّقِيهِ","هِجانُ المالِ وَالجَيشُ اللُهامُ",77,"م",1,0],["ترجو نصيباً من عُلاكَ وما لها","فيما تُرَجِّيهِ العُفاةُ رجاءُ",78,"ا",2,0],["ترجع الكفُّ وهي أفرغ منها","عند مدّي لها فدأبي وشاني",79,"ن",2,0],["ترجون أمراً دونه","تقف القياصر خاضعين",80,"ن",1,0],["تَرجَمَ الّلفظُ عن سَناه كما تَر","جَم عن واضح النهار الظلامُ",81,"م",1,0],["ترَجَّل واستظِلَّ بهِ","بُعَيدَ الحرِّ والتَّعب",82,"ب",1,0],["تَرجوه في الدنيا لنجح مرادنا","وَنَلوذ منه إِلى الشَفاعة في غد",83,"د",1,0],["ترجو القبول وإن تقبل عنده","من منعم بقبولها يمناه",84,"ا",2,0],["تَرَجَّلَ عَن شَهبائِهِ الظاهِرُ الغازي","وَكانَ بِها البازي المُطِلُّ عَلى النازي",85,"ز",2,1],["تَرَجّاهُ أَربابُ الصَوارِمِ وَالقَنا","كَما كانَ يَرجو جودَهُ رَبُّ عُكازِ",85,"ز",1,0],["ترجو التحرر في الحياة","فلا قيود ولا حدود",86,"د",1,0],["تَرجو بساحتِه لمُرسِلِها","محوَ الذنوب وحطَّة الوِزرِ",87,"ر",1,0],["تُرْجِعُ لي رُوحِي إذا وَدّعَتْ","فَتَنْثَني مُسْرِعَةَ الأَوْبَه",88