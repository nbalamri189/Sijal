{"poems":[[53,"لو صح أن البين يعشقه","https://www.aldiwan.net/poem29955.html","السريع"],[72,"لحظك في الفتك هو البادي","https://www.aldiwan.net/poem18557.html","السريع"],[46,"يا ساهر البرق أيقظ راقد السمر","https://www.aldiwan.net/poem23634.html","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54733","المتقارب"],[327,"بايع هارون إمام الهدى","https://www.aldiwan.net/poem44253.html","السريع"],[329,"المجتث","https://www.aldiwan.net/poem55010.html","المجتث"],[350,"سواي لميل الحب عنه يفاسخ","https://www.aldiwan.net/poem15565.html","الطويل"],[365,"أهلا بوجهك من صباح مقبل","https://www.aldiwan.net/poem60681.html","الكامل"],[394,"يا زائرا سائرا إلى طوس","https://www.aldiwan.net/poem53675.html","المنسرح"],[552,"أعلى الركائب سارت الأحداج","https://www.aldiwan.net/poem48017.html","الكامل"],[563,"إن قلت ويحك فافعل أيها الرجل","https://www.aldiwan.net/poem52932.html","البسيط"]],"verses":[["لِمُشَمِّرِ الأَطرافِ مُنزَعِجِ ال","أَعطافِ يُهجِعُهُ تَأَرُّقُهُ",0,"ق",2,0],["لمشرقٍ من مغربٍ ظلّه","دعْ غايتي مصرٍ وبغداد",1,"د",1,0],["لمُشْمَعِلّيْنِ كالسّيْفَين تحتَهما","مثلُ القَناتَين من أينٍ ومِن ضُمُرِ",2,"ر",1,0],["لِمُشْرِقِهِ مِنْ سَنَاهَا سَنىً","وَمُورِقِهِ مِنْ نَدَاهَا نَدَى",3,"د",2,0],["لِمُشبِهِ المَنصورِ في مُلكِهِ","إِذا تَدَجَّت ظُلمَةُ الباطِلِ",4,"ل",1,0],["لمُشتر لو تراه","تقول أُنسيتُها",5,"ه",2,0],["لِمَشرِقِ شَمسِ الحُسنِ بَعدَ غُروبِها","لِعَينِيَ في عَينَيَّ صَحَّ الناسِخُ",6,"خ",1,0],["لمَشْوا إليهِ مِشْيةً قلَميَّةً","بالهامِ لا قَدمِيّةً بالأرْجُل",7,"ل",1,0],["لِمشهدٍ بِالزَكاءِ مُلتَحِفٍ","وَبِالسَنى وَالسَناءِ مَأنوس",8,"س",1,0],["لِمْ شِرْبُكُمْ عندي النّميرُ وعندكمْ","شِرْبي على الظّمإ الشديد أُجاجُ",9,"ج",1,0],["لمُشكِلِ الرأيِ في أجفانِها قمرٌ","يَدنُو ولو أنَّه في بُعدِهِ زُحلُ",10,"ل",1,0]]}