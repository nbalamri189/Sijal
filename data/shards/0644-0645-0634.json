{"poems":[[55,"لو صح أن البين يعشقه","https://www.aldiwan.net/poem29955.html","السريع"],[74,"لحظك في الفتك هو البادي","https://www.aldiwan.net/poem18557.html","السريع"],[48,"يا ساهر البرق أيقظ راقد السمر","https://www.aldiwan.net/poem23634.html","البسيط"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62221","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54733","المتقارب"],[331,"بايع هارون إمام الهدى","https://www.aldiwan.net/poem44253.html","السريع"],[333,"المجتث","https://www.aldiwan.net/poem55010.html","المجتث"],[354,"سواي لميل الحب عنه يفاسخ","https://www.aldiwan.net/poem15565.html","الطويل"],[369,"أهلا بوجهك من صباح مقبل","https://www.aldiwan.net/poem60681.html","الكامل"],[398,"يا زائرا سائرا إلى طوس","https://www.aldiwan.net/poem53675.html","المنسرح"],[556,"أعلى الركائب سارت الأحداج","https://www.aldiwan.net/poem48017.html","الكامل"],[567,"إن قلت ويحك فافعل أيها الرجل","https://www.aldiwan.net/poem52932.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122551","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122704","الخفيف"],[880,"","https://poetry.dctabudhabi.ae/diwan/poem/34785","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120128","الكامل"],[2404,"","https://poetry.dctabudhabi.ae/diwan/poem/32599","الوافر"],[4218,"","https://poetry.dctabudhabi.ae/diwan/poem/143427","البسيط"],[4867,"خذو مكتوبي","https://www.poetsgate.com/ViewPoem.aspx?id=29063",""],[585,"تلك القبور وماثل الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=161873",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[6031,"قُلْ لِمَنْ فَاقَتِ البُدُورَ كَمَالا","https://www.poetsgate.com/ViewPoem.aspx?id=46311",""],[6277,"ظلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64482&r=&rc=45",""]],"verses":[["لِمُشَمِّرِ الأَطرافِ مُنزَعِجِ ال","أَعطافِ يُهجِعُهُ تَأَرُّقُهُ",0,"ق",2,0],["لمشرقٍ من مغربٍ ظلّه","دعْ غايتي مصرٍ وبغداد",1,"د",1,0],["لمُشْمَعِلّيْنِ كالسّيْفَين تحتَهما","مثلُ القَناتَين من أينٍ ومِن ضُمُرِ",2,"ر",1,0],["لِمُشْتَاقٍ يُصَفِّقُهُ وَقُودٌ","كَنَارِ مَجُوسَ في الأَجَمِ المُطَارِ",3,"ر",1,0],["لِمُشْرِقِهِ مِنْ سَنَاهَا سَنىً","وَمُورِقِهِ مِنْ نَدَاهَا نَدَى",4,"د",2,0],["لِمُشبِهِ المَنصورِ في مُلكِهِ","إِذا تَدَجَّت ظُلمَةُ الباطِلِ",5,"ل",1,0],["لمُشتر لو تراه","تقول أُنسيتُها",6,"ه",2,0],["لِمَشرِقِ شَمسِ الحُسنِ بَعدَ غُروبِها","لِعَينِيَ في عَينَيَّ صَحَّ الناسِخُ",7,"خ",1,0],["لمَشْوا إليهِ مِشْيةً قلَميَّةً","بالهامِ لا قَدمِيّةً بالأرْجُل",8,"ل",1,0],["لِمشهدٍ بِالزَكاءِ مُلتَحِفٍ","وَبِالسَنى وَالسَناءِ مَأنوس",9,"س",1,0],["لِمْ شِرْبُكُمْ عندي النّميرُ وعندكمْ","شِرْبي على الظّمإ الشديد أُجاجُ",10,"ج",1,0],["لمُشكِلِ الرأيِ في أجفانِها قمرٌ","يَدنُو ولو أنَّه في بُعدِهِ زُحلُ",11,"ل",1,0],["لمَّ شعبي","وأرح عَلَيَّ فما اصطَفي",12,"ي",1,0],["لَمَّ شَملَ الأعرابِ واتَّخَذَ السَّي","فَ ظَهيراً وَفَرَّقَ الأتراكا",13,"ك",2,0],["لمشمرين عن السواعد حسرٍ","عنها بكل رشيقة التوتير",14,"ر",1,0],["لمشي بنقش أخضر","وبصولجان فوق خدِّ",15,"د",1,0],["لم شردا يسرن مغنيات","تكون فنونها من كل فند",16,"د",1,0],["لمُشبهاتٌ على فراشي","بَزْرَقَطونا على المَقالي",17,"ي",1,0],["لمشى خطواته معدوله","بمشيت القطى ممثوله",18,"ل",2,0],["لمشمرٍ بين البلاد محبرٍ","نبأ العباد وسائحٍ جوال",19,"ل",1,0],["لمشروعة مطلوبةً بل وقربةً","يشد إليه الرحل من كان ذا بعد",20,"د",1,0],["لم شمل الجزيرة منتشر","وحد الحضر المقيمه والبدات",21,"ت",1,0],["لَمَشُوقٌ إِلَيكِ شَوْقاً يُذِيبُ الْ","حَجَرَ الصَّلْدَ أو يَهُدُّ الجِبَالا",22,"ل",2,0],["لمشمخر ركنه وطيد","عزّ به اللآباء والجدود",23,"د",1,0]]}