=198840",""],[327,"بانَ الخليطُ فَشَطّوا بالرَّعابيبِ","https://www.poetsgate.com/ViewPoem.aspx?id=3929",""],[5516,"هزي إليك","https://www.poetsgate.com/ViewPoem.aspx?id=212249",""],[5545,"رفيق الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=184833",""],[5561,"ومضة شوق","https://www.poetsgate.com/ViewPoem.aspx?id=193806",""],[470,"يا شيخ شعري","https://www.poetsgate.com/ViewPoem.aspx?id=178095",""],[470,"بعد فوات الأوان","https://www.poetsgate.com/ViewPoem.aspx?id=178099",""],[470,"حشودٌ من الحب والكبرياء","https://www.poetsgate.com/ViewPoem.aspx?id=194105",""],[470,"دنيا الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=201295",""],[470,"يا سيدى المتنبى","https://www.poetsgate.com/ViewPoem.aspx?id=63453",""],[5573,"فاز بالخير بادي يوم يقري سلام","https://www.poetsgate.com/ViewPoem.aspx?id=202543",""],[5606,"من يوصل علمي الشيخ ويقله","https://www.poetsgate.com/ViewPoem.aspx?id=197889",""],[5616,"محمود","https://www.poetsgate.com/ViewPoem.aspx?id=203502",""],[5616,"أغنيةُ صمودٍ للمخيَّمِ الفلسطيني","https://www.poetsgate.com/ViewPoem.aspx?id=205219",""],[4444,"فديتك لو لم تكن لي قريبا","https://www.poetsgate.com/ViewPoem.aspx?id=85444",""],[5667,"البحر","https://www.poetsgate.com/ViewPoem.aspx?id=214837",""],[5686,"دروب الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=203361",""],[5818,"ملهمة شعري","https://www.poetsgate.com/ViewPoem.aspx?id=199981",""],[5842,"استغفرُ الله / محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=135811",""],[5848,"ضحكه وتنهيده","https://www.poetsgate.com/ViewPoem.aspx?id=51951",""],[5848,"اقرب الناس","https://www.poetsgate.com/ViewPoem.aspx?id=53162",""],[5848,"أنصحك تكسر الجوال","https://www.poetsgate.com/ViewPoem.aspx?id=48964",""],[5848,"أروح اصور معك في المنتدى العام","https://www.poetsgate.com/ViewPoem.aspx?id=48845",""],[5956,"الفخر بالابن فراس","https://www.poetsgate.com/ViewPoem.aspx?id=192387",""],[6069,"يا أيها المولى الذي وجهه","https://www.poetsgate.com/ViewPoem.aspx?id=105654",""],[5309,"نصوغ من لاعج الأشواق الحانا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573550",""],[6225,"إشباع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78019&r=&rc=105",""],[6243,"منعرج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84441&r=&rc=15",""],[6305,"لا تَبْكِ قَتْلاكَ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87353&r=&rc=26",""],[6355,"شلال نور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66675&r=&rc=135",""]],"verses":[["وَأَنتَ تُساهِمُني في العَلا","ءِ فَخراً وَتَشرَكُني في النَسَب",0,"ب",1,0],["وَأَنتَ تُعَلِّلُنا بِالإِيا","بِ وَالصَبرُ مُرتَحِلٌ لا يَؤوبُ",1,"ب",1,0],["وَأَنتِ تُزَنِّينَهُم بِالهُدى","وَبِالطَّفِّ هامُ بَني فاطِمَه",2,"م",2,0],["وَأَنتَ تُقَلِّبُ الكَفَّينِ آناً","وَآوِنَةً يُقَلِّبُكَ السَقامُ",3,"م",1,0],["وأنتَ تَعِرفُ عَمراً في حَواضِرِها","ولستَ تَجهَلُ عَمراً في بَواديها",4,"ي",3,0],["وَإِنْ تَتَبَوَّئِي مَكَانٍ","بِنَدْوَةِ الاتِّحَادِ العَالَمِي",5,"ي",1,0],["وأنتَ تُعْدِي عليها كلَّما ظَلَمَتْ","يا ابْنَ الكرام بِرِفْدٍ منك مَرْفُودِ",6,"د",1,0],["وأنت تراعي الله فيمن تضمُّه","مدينتُه من مسلم ومُعاهدِ",7,"د",1,0],["وأنت تجود أرضاً بعد أرض","وكفّاه يَعُمَّان البلادا",8,"د",2,0],["وأنت تَحدّاني ليحمى عليهِمُ","وطيسي وما فيهم لذلك منكر",9,"ر",1,0],["وأنت تفدِّيه بأمك تارةً","وآونةً يُغشَى عليك فتنخِر",9,"ر",1,0],["وأنت ترى ما يلفظ الناسُ كلهم","به أسلاً من حُبِّك الأسلَ السَّبطْ",10,"ط",1,0],["وأن تترأَّس حُثَّالةٌ","بكم ويروني مع التابع",11,"ع",1,0],["وإنْ تتابعتَ في شِقاقِكَهُ","فاعددك في النار تصطلي وقدكْ",12,"ك",1,0],["وأن تتلقاني مُجلّاً مُصانِعاً","كما صانعَ الجانِي وليَّ قتيلِ",13,"ل",1,0],["وأن تتولّاني إذا اعتلَّ مذهبي","برفق طبيب مُحْسِنٍ بعليلِ",13,"ل",1,0],["وأنتَ تعيدُ لنا نائلاً","إعادتُه مُنْيَةُ الراغبينا",14,"ن",2,0],["وَأَن تَتَوَلّى الاِبتِساماتُ ثَغرَها","وَفي الحَيِّ مَكلومُ الفُؤادِ عَليلُ",15,"ل",1,0],["وأنت تنبه الدنيا إليه","وتفتأ تذكر العار الجُساما",16,"م",2,0],["وأنت تطرب للواشي وتطمعه","كالطفل ألقى بسمع للخرافات",17,"ت",1,0],["وَأَنتَ تَرى نُصحَ الإِمامِ فَريضَةً","وَإِخبارُهُ عَنّي سَبيلٌ مِنَ النُصحِ",18,"ح",1,0],["وَأَنتَ تَسوقُ بَهمَ بَني كُلَيبٍ","تُطَرطِبُ قائِماً تُشلي الحُوارا",19,"ر",2,0],["وأنتَ تعلمُ أني جَدَّ لي سَفَرٌ","إني إلى الكُتْبِ فيه جِدُّ مُحتاجِ",20,"ج",1,0],["وَأَنتَ تُجيبُ مَن يَدعوكَ رَبّي","وَتَكشِفُ ضُرَّ عَبدِكَ يا حَبيبي",21,"ب",2,0],["وَأَن تَتَدَبَّرَ ماذا تَصيرُ","إِلَيهِ فَتُعمِلَ فيهِ الفِكَر",22,"ر",1,0],["وَأَنتَ تُصيبُ قوتَكَ في عَفافٍ","وَرَيّا إِن ظَمِئتَ مِنَ الزُلالِ",23,"ل",1,0],["وأنت تَنَقَّلينَ على قلوبٍ","وأكبادٍ وأرواحٍ بلينَا",24,"ن",2,0],["وأنت تَهَلُّلُ الفجرِ","وبسمتُه على الأفقِ",25,"ق",1,0],["وأنت تجارب الأمس","وأنت براءة الطفل",25,"ل",1,0],["وَأَنْتَ تَرْنِيمَةُ الصُّوفِيِّ إِنْ خَشِنَتْ","أَيَّامُهُ عَلَّمَتْهَا الحُسْنَ وَالمَلَدَا",26,"د",2,0],["وَأَنتَ تُديرُ قُطبَ رَحاً عَلِيّاً","وَلَم تَرَ لِلرَحا العَلياءِ قُطبا",27,"ب",2,0],["وأنتَ تُسَيِّرُ رَكْبَ الخلودِ","ما تَسْتَجِدُّ لهُ يَتْبَعِ",28,"ع",1,0],["وأنْ تَتَّقِي دونَ ما تَرْتَئِي","ضميرَكَ بالأُسَّلِ الشُّرَّعِ",28,"ع",1,0],["وأَنْتَ تَخْتَرِقُ السَّبْعَ الطَّباقَ بهِمْ","في مَوْكِبِ كُنْتَ فيهِ صاحِبَ العلَمِ",29,"م",1,0],["وأنْتَ تَجُودُ بمِثلِ البِكارِ","من التّبْرِ في مثِلها مِنْ أدَم",30,"م",1,0],["وَأَنتَ تَقتافُ الأَثَر","مِن ذي حُجولٍ وَغُرَر",31,"ر",1,0],["وَأَنتَ تَلحاني وَلا ذَنبَ لي","لَكُم يُرى حَمّالَ أَعبائي",32,"ا",2,0],["وأنت تعلّم النّاس التّعزّي","وخوض الموت في الحرب السّجال",33,"ل",1,0],["وأنتَ ترنو وراءَ الأُفق مبتسماً","كما رَنا نازحٌ لاحتْ لهُ الدارُ",34,"ر",1,0],["وأنت تحت يدي الآسي ورأفته","وبين كل ضعيف القلب خائره",35,"ر",2,0],["وأنت تؤُّمُّ الْحشْدَ جذلانَ هانئاً","ونجمُك لم يحجبْ سَناه ضباب",36,"ب",1,0],["وأنت تغني بلا مبتدا","بلا خبر عن دنوّ الختام",37,"م",1,0],["وأنْ تَتَّقي – دُون ما ترتائي -","ضميرَكَ بالأسَلِ الشُرَّع",38,"ع",1,0],["وأنتَ تُعدي عليها كلَّما ظَلمَتْ","يا بنَ الكرام بِرِفدٍ منك مَرفُودِ",39,"د",1,0],["وانت تقول زورا تبت عنه","فمالك حين اذكره تذوب",40,"ب",1,0],["وأنتَ تَرَى وتَسْمَعُ هَمْسَ رُوحي","ووَسواسي وأوهامي وحَدسي",41,"س",2,0],["وأنت تاج خلود لي أتيه به","وقد غنيت عن النسرين والنفل",42,"ل",1,0],["وأنت تعلِّم كيف الثبا","تُ إن زعزعتنا الخطوبُ الجِسامُ",43,"م",1,0],["وأن تتلألأ بروقُ الحمى","وإن أضرمتنى بإلهابها",44,"ب",3,0],["وأنت تريهم غفلة تحت يقظة","مددت لهم فيها ولم تعجل الحبلا",45,"ل",2,0],["وَأَنتَ تَعلَمُ لازِلتَ المَنيعَ حِمىً","أَنَّ الشَدائِدَ لِلساداتِ غِربالُ",46,"ل",1,0],["وأنت تُواحِيني بما أنا كارهٌ","وتَسْطو عليَّ سطوةً بعدَ سطوةِ",47,"ه",1,0],["وإنْ تَتَعَهَّدْ بالخِلافَة ناظِراً","إليهِ فقَدْ قرّتْ بذاكَ النَّواظِرُ",48,"ر",1,0],["وأنت تدري أن قول الصبا","في حركات الغصن مقبولث",49,"ث",1,0],["وَأن تتمّمَ أجراءُ النبوّة وال","آياتُ والدراجاتُ الشمّ والشيمُ",50,"م",1,0],["وَأَنت ترى التكليف جدّ مشقّةٍ","وَلو كان يُفضي للسعادة عن كثبِ",51,"ب",1,0],["وَأَنتَ تُحيي فِئاماً بَعدَما هَمَدَت","إِحياءَ غَيثٍ بِصَوبِ نَفسٍ حُلبوبِ",52,"ب",1,0],["وأنت تساميت في كل ما","حوى الكون في أرضه والسما",53,"م",2,0],["وانت تحس وراء الحياة","حفيف السعادة فوق السدم",54,"م",1,0],["وَأَنتَ تَعلَمُ اني مُذ كلفت بِهِم","لا حَولَ لي في تَصاريفِ الغَرامِ وَلا",55,"ل",2,0],["وأنت تَجلو عَنْ سَنا غُرّةٍ","زَهْراءَ تُحْيى أمَلَ الآمِل",56,"ل",1,0],["وأَنتَ ترومُ للأشبالِ قُوتاً","ومُطَّلَبي لبنتِ العمِّ مَهرا",57,"ر",2,0],["وأنتَ تَرى النَّهارَ وما يَليهِ","عَلى ما فيهما مُتَقلِّبَينِ",58,"ن",1,0],["وأنتَ تَصونُ هَذا الثَّغر فيه","وصَونُكَ فائِزٌ بالحُسنَيَينِ",58,"ن",1,0],["وأَنتَ تَقولُ لَو حمِّلتَ صَبراً","وبِالصَّبرِ الجَميلِ هَوىً جَميلُ",59,"ل",1,0],["وأنتَ تَعرفُ إِنفاقي ومُكتَسَبي","وإنَّما مثلُ ذا من مثل ذا سرفُ",60,"ف",1,0],["وأنت تَغمِطُ جود اللَه مفترياً","سحقاً لعبدٍ لجود اللَه قد غَمَطا",61,"ط",2,0],["وإن تتبوئي أسمى مكان","بندوة الاتحاد العالمي",62,"ي",1,0],["وأن تتركوا ما قد جنيتم وتقبلوا","على توبة تمحو عظيم الجرائم",63,"م",1,0],["وأنت تحتاج للأعواد من حطب","ترقى بها حي لا ساق ولا قدم",64,"م",1,0],["وأَنْتَ تكلِّفها بالمسير","فخلِّ المَطِيَّ على سيرها",65,"ر",3,0],["وأنت ترى رعدَه صاهلاً","فيطمع في طرفِه الأشقَرِ",66,"ر",1,0],["وأنتَ تتبعتَ الألى بمآثرٍ","تُثيرُ عجاجَ السّبْقِ في وجهِ تُبّعِ",67,"ع",1,0],["وإِن تتقدَّمني فصِلْ وهديَّتي","صلاةٌ إلى سمع العلا وسلامُ",68,"م",1,0],["وأنت تسعى للتي","تعلو بها وتعظُمُ",69,"م",1,0],["وأن تتبع الأقلام في مدح غيركم","وذلك عار عندها وخبال",70,"ل",1,0],["وأنت تمنيني بدمعٍ سمعته","وما كان إلا قولةً من ممرّضي",71,"ض",2,0],["وأنت تحملُ منه كل فادحةٍ","لا بالجبان ولا الهيّابةِ الوكِلِ",72,"ل",1,0],["وأنتَ تَعرفُ أنَّ الدَّمعَ تَذرفُهُ","دَمعُ المُروءَةِ لا دَمعَ المَساكين ِ!",73,"ن",1,0],["وأنتَ تَنأى ، وَتَبكي حولَكَ السُّبُلُ","ضاقَتْ عليكَ فِجاجُ الأرض ِيا رَجُلُ !",74,"ل",1,0],["وأنت تحكم طوق الموت مبتهجا","من حول أعناقهم.. والموت منذهل!",75,"ل",1,0],["وأنتَ تَختَصِرُ الأبعادَ هائِلَة ً","وَقَد تَلاقَتْ على راحاتِكَ الشُّهُبُ",76,"ب",1,0],["وأنتَ تَحلَمُ .. أترَعْتَ الدُّنا حُلُما ً","حتى لَكادَتْ تَهاوى دونَكَ الحُجُبُ",76,"ب",1,0],["وأنتَ تَدري بِأنَّ الدَّ ارَ تَسكُنُها","بِيعَتْ ، وقَبرُكَ هذا..مُوحِشٌ خَرِبُ",76,"ب",1,0],["وَأَنتَ تُرَجّى لِلَّذي أَنتَ أَهلُهُ","وَتَنفَعُ ذا القُربى لَدَيكَ وَسائِلُهْ",77,"ل",2,0],["وأنت تجهل علماً نحن نورده","من بحر حق عليه الناس ما وقفوا",78,"ف",3,0],["وأنت تعرف هذا لست تنكره","لكن بفهمك مفتون وبالفكر",79,"ر",1,0],["وأَنْتَ تَنْفِي الرُّقَادَ مُرْتَقِياً","ومَا رَقَى لِلعَلاَءِ مِنْ رَقَدَا",80,"د",2,0],["وَأَنتَ تَريح الفكر مِن كُل معضل","يَظَل لَهُ في حيرة وَوُجوم",81,"م",1,0],["وأنتَ تلمسها قهراً وتلثمني","جهراً وتغشى رياض العنق تجنبها",82,"ه",2,0],["وَأَن تَتَباهى بِالمَعارف وَالنَدى","سَليلِك مَن أَضحى بِسَيرك يَقتَدي",83,"د",2,0],["وأنت تعلم أني منهما عطلٌ","إذا تأملتني يا ابن الدهاقين",84,"ن",1,0],["وَأَنتَ تَسيرُ إِلى المُكَّرانِ","فَقَد شَحَطَ الوِردُ وَالمَصدَرُ",85,"ر",1,0],["وانتتفت عنفقتي بعدما","شبت وذا من حرفة المملقين",86,"ن",1,0],["وأنت تجيره في كل خطبٍ","وأنت بكل معضلةٍ تقيه",87,"ي",2,0],["وأنت تكفيني غدا أمره","إن كف كف البخل أيدي الشحاح",88,"ح",1,0],["وأَنْتَ تُنَاغِي كُلُّ يَوْمٍ وَلَيْلَةٍ","بِمِصْرِكَ بِيضاً كالظِّباءِ الشّوازبِ",89,"ب",1,0],["وأنت تعلم ذا حقاً وتعدده","ذنباً عليّ كان الودَّ في القلمِ",90,"م",1,0],["وأنت ترى الأشياء رب ولا ترى","وبالمنظر الأعلى مقام الألوهة",91,"ه",1,0],[