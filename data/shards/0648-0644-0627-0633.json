ttps://www.aldiwan.net/poem15215.html","المتقارب"],[477,"أرقت هوى والليل مرخي الذوائب","https://www.aldiwan.net/poem15229.html","الطويل"],[477,"بي من جوى التبريح اشفاق","https://www.aldiwan.net/poem15351.html","السريع"],[495,"خلقت كما ترى صعب الثقاف","https://www.aldiwan.net/poem10241.html","الوافر"],[500,"يا منشد الغيب أذكر من نيهم به","https://www.aldiwan.net/poem37632.html","البسيط"],[500,"ما هفهفتني نسمة الربيع","https://www.aldiwan.net/poem37979.html","السريع"],[515,"في مثل مدحك شرح القول مختصر","https://www.aldiwan.net/poem12117.html","البسيط"],[515,"تناولت المكارم والمساعي","https://www.aldiwan.net/poem12173.html","الوافر"],[515,"أفي أهل ذا النادي عليم أسائله","https://www.aldiwan.net/poem12195.html","الطويل"],[515,"خذ حديثي فإنه معسول","https://www.aldiwan.net/poem12218.html","الخفيف"],[538,"دعاني من ذكر السقام دعانيا","https://www.aldiwan.net/poem47498.html","عموديه"],[538,"لسانكم بالفخر دوما يردد","https://www.aldiwan.net/poem48234.html","عموديه"],[551,"والله لا ذقت يوما","https://www.aldiwan.net/poem47271.html","المجتث"],[551,"أقلني ربي بالذين اصطفيتهم","https://www.aldiwan.net/poem47370.html","الطويل"],[551,"دع الهوى يتبعه الأخرق","https://www.aldiwan.net/poem47377.html","السريع"],[551,"صبرت ومثلك لا يجزع","https://www.aldiwan.net/poem47722.html","المتقارب"],[551,"أما ترى الربع الذي أقفرا","https://www.aldiwan.net/poem47804.html","السريع"],[551,"أما سمعت حمام الأيك إذ صدحا","https://www.aldiwan.net/poem47895.html","البسيط"],[551,"أي فتى ووري في الترب","https://www.aldiwan.net/poem48059.html","السريع"],[558,"أنا العاشق السالي لوجهك يا علو","https://www.aldiwan.net/poem33585.html","الطويل"],[558,"تبارك الله ما في الدار ديار","https://www.aldiwan.net/poem34533.html","البسيط"],[564,"أجودُ ابن زين أو غيوثُ سواجم","https://www.aldiwan.net/poem890.html",""],[567,"لا وجفون ينفثن في العقد","https://www.aldiwan.net/poem69709.html","البسيط"],[575,"مديحك كالمسك لا يكتتم","https://www.aldiwan.net/poem3006.html","المتقارب"],[575,"تقنعت لكن بالحبيب المعمم","https://www.aldiwan.net/poem3018.html","الطويل"],[575,"على خاطري يا شغله منك أشغال","https://www.aldiwan.net/poem3029.html","الطويل"],[586,"لا أسهر الله طرفا نام عن سهري","https://www.aldiwan.net/poem17535.html","البسيط"],[586,"أسير لحاظ كيف ينجو من الأسر","https://www.aldiwan.net/poem17537.html","الطويل"],[586,"الدمع هام والحشا هائم","https://www.aldiwan.net/poem17702.html","السريع"],[587,"أمور القضا ليست بحكم العوالم","https://www.aldiwan.net/poem11521.html","عموديه"]],"verses":[["وَلا سِلمَ حَتّى يَخضِبَ الحَربُ أَرضَها","وَيَغدو فَمُ البَيداءِ بِالنَقعِ راغِيا",0,"ي",2,0],["وَلا سيما وَقَد أَمسى عَليٌّ","ظَهيري وَالسَفيرَ إِلى إِمامي",1,"م",2,0],["وَلا سَيرَ إِلّا أَن أَشُدَّ حَقيبَةً","أَرى ضِمنَها مِن ضامِرِ الزادِ أَبحَلا",2,"ل",2,0],["وَلا سَقى الغَيثُ داراً أَنتَ ساكِنُها","إِلّا بِأَغبَرَ نارِيِّ الذُرى قَصِفِ",3,"ف",1,0],["وَلا سَبَبٌ إِلاّ المَوَدَّةُ إِنَّهُ","تَقَطَّعَ مِنّيَ وَالقُوى لَم تُقَطَّعِ",4,"ع",1,0],["وَلا سَمِعَ الأَعداءُ إِلّا بِأَصلَمٍ","وَلا نَظَرَ الحُسّادُ إِلّا بِأَرمَدا",5,"د",2,0],["وَلا سَترُ الشَبابِ عَلَيَّ عَيباً","فَأَجزَعَ أَن يَنِمَّ عَلى عُيوبي",6,"ب",2,0],["ولا سانِحٌ هزَّ منْ رَوْقِهِ","سَليماً ولا بارِحٌ أعْضَبُ",7,"ب",1,0],["ولا سُكِنَتْ هَذِي الجَزيرةُ بُرْهَةً","وأصْبَحَتِ الأوْطانُ وهْيَ بلاقِعُ",8,"ع",1,0],["وَلاَ سَهِرَتْ عَيْنِي لِبَرْقِ ثَنِيَّةٍ","مِنَ الثَّغْرِ يَبْدُو مَوْهِناً فَيَشِيمُهُ",9,"م",2,0],["ولاسيّما إنْ كان ملْحِمَ بُرْدِها","عَميدُ أولي الألْبابِ نادِرةُ العصرِ",10,"ر",1,0],["ولا سألَ الأطْلالَ بعْدَ قَطينِها","فعيّتْ جَواباً بعْدَ طولِ ترَدُّدِ",11,"د",1,0],["وَلِاِسمِهِ نَسَبٌ لَو كَنتَ تَعرِفُهُ","ما إِن يَؤولُ إِلى عُجمٍ وَلا عرَبِ",12,"ب",1,0],["وَلا سَبيلَ إِلى مَعسولِ ريقَتِهِ","حَتّى يَبيتَ مِنَ الصَهباءِ مُرتَشَفا",13,"ف",2,0],["ولأسْتأصل الموت الوَحِيّ نفوسهم","ونادى عليهم مُؤذناً بفناء",14,"ا",2,0],["ولا سمراتي يبتغيهن عاضدٌ","ولا سلماتي في بجيلة تُعْصَبُ",15,"ب",1,1],["وَلَاِسَتَحَلَّ رِجالٌ مُسلِمونَ دَمي","يَرَونَ أَقبَحَ ما يَأتونَهُ حَسَنا",16,"ن",2,0],["ولاسيّما حين ارتدى الماءُ كِبْرَهُ","وشاغَب أنفاسَ الصَّبا والجنائبِ",17,"ب",1,0],["ولاسيما والذي أرتجي","أبو الصقر ما النُّجحُ بالرائِثِ",18,"ث",1,0],["ولا سِيمَا وقد أعمَقْتَ فيه","مخازِيَكَ اللواتي لنْ تَبيدا",19,"د",2,0],["ولا سِلمَ حتى تُستَرد ظُلامتي","وإلّا فأيقنْ أنّنا فِيئَتا ثغر",20,"ر",1,0],["ولا سيّما بعدَ المشيبِ وبعدَما","أراهم هدى منهاجِهم سُرجُ العقلِ",21,"ل",1,0],["ولا سقَى اللَّه برهةً ضمنتْ","ضدَّيهما وابلاً ولا دِيما",22,"م",2,0],["ولاسِيَّما والخصمُ قاضٍ مُحَكَّمٌ","إليه القضايا والهباتُ الجسائمُ",23,"م",1,0],["ولأسْمُكنّ خلال كُلِّ قبيلة","نشراً لذكرك طيّب النَّسَمانِ",24,"ن",1,0],["وَلا سَمِعتِ الكاسَ ذاتِ الرَنين","إِلّا سَمِعتِ حَطمَةَ الكاسِ",25,"س",1,0],["ولا سامعا إلا شهيقا لمجهش","وإلا زفيرا من حشاشة كامد",26,"د",1,0],["ولا سمع الجماعة غير أني","أرى السودان قطرا أجنبيا",27,"ي",2,0],["ولا ساووك في صدق الطوايا","وإن ساووك في الشيم الكذاب",28,"ب",1,0],["ولا سلوت ولم أهمم ولا خطرت","بالبال سلواك في ماض ولا آتى",29,"ت",2,0],["وَلا سَلَوتُ وَلَم أَهمُم وَلا خَطَرَت","بِالبالِ سَلواكِ في ماضٍ وَلا آتِ",30,"ت",1,0],["وَلا سَقَيتُ الثَرى وَالمُزنُ مُخلِفَةٌ","دَمعاً يُنَشِّفُهُ مِن لَوعَةٍ نَفَسي",31,"س",2,0],["وَلا ساعِياً في قُلَّةِ المَجدِ مُدرِكاً","بِأَفعالِهِ ما لَيسَ يُدرِكُهُ الوَصفُ",32,"ف",1,0],["وَلا سالِكاً إِلّا فُؤادَ عَجاجَةٍ","وَلا واجِداً إِلّا لِمَكرُمَةٍ طَعما",33,"م",2,0],["وَلا سَمَكَت عَنها سَماءً وَليدَةٌ","مَظَلَّةُ أَعرابِيَّةٍ فَوقَ أَسقُبِ",34,"ب",1,0],["وَلا ساهي الفُؤادِ وَلا عَيِيِّ ال","لِسانِ إِذا تَشاجَرَتِ الخُصومُ",35,"م",1,0],["وَلا سَليلٌ يَسُرُّهُ تَلفي","كَناضِحٍ في رِضايَ يَجتَهِدُ",36,"د",1,0],["وَلا سَمَحتَ بِوَعدٍ فيهِ مُرتَقَبٍ","إِلّا تَأَمَّلَهُ عَشراً وَأَمَّلَهُ",37,"ل",2,0],["وَلاسِيَّما لَمّا رَأَونِيَ راغِباً","عَنِ الرِفدِ لا أُبقي مِنَ المالِ باقِيا",38,"ي",2,0],["ولا ساكناً في ليلةٍ مُدْلَهِمَّةٍ","سَرَى ركبُها فيها اصطلاءَ ظلامِ",39,"م",1,0],["ولا سَكَنٌ إلا مناجاة فكرضةٍ","كأني بها مستحضرٌ كلّ غائِبِ",40,"ب",1,0],["وَلَاِستَنجَدتُ حَنظَلَةً وَعَمراً","وَلَم أَعدِل بِسَعدٍ وَالرَبابِ",41,"ب",1,0],["وَلَاِستَرفَدتُ مِن قَيسٍ ذُراها","بَني بَدرٍ وَصيدَ بَني كِلابِ",41,"ب",1,0],["ولا سباني سنا هيفاءَ مقبلةٍ","عجزاءَ مدبرةٍ بالجعدِ والدعجِ",42,"ج",1,0],["وَلا سَيرَ إِلّا فَوقَ ظَهرِ تَنوفَةٍ","يُراعُ سَرابُ القاعِ فيها فَيُرعَدُ",43,"د",1,0],["وَلا سِرتُ عَنها أَركَبُ الصُبحَ أَشهَباً","وَقَد جِئتُ شَوقاً أَركَبُ اللَيلَ أَدهَما",44,"م",2,0],["وَلا سُمِّيَت عِندي لَها مِن سَميَّةٍ","مِنَ الناسِ إِلّا بَلَّ دَمعي رِدائِيا",45,"ي",2,0],["وَلا سِرتُ ميلاً مِن دِمَشقَ وَلا بَدا","سُهَيلٌ لِأَهلِ الشامِ إِلّا بَدا لِيا",45,"ي",2,0],["وَلا سَمِعوا مِن سائِرِ الناسِ مِثلَها","وَلا بَرَزَت في يَومِ أُضحى وَلا فِطرِ",46,"ر",1,0],["ولا سلوى سوى نجوى","أُسرُّ بها لمغناكِ",47,"ك",1,0],["وَلا ستْرَ ما بيْنَ الرَّعايا وبينَهُ","ولكنّهُ حلْماً عَلَى الناسِ يَسْتُرُ",48,"ر",1,0],["ولأسطُوَنَّ على الزّمان بمَن لهُ","قلبي الوَدودُ ومَدْحيَ المُتَنَخَّل",49,"ل",1,0],["وَلا سيما وَقَد غَيَّر","تُ عَقدَ رِباطِ تِكَّتِهِ",50,"ت",2,0],["وَلا سِيَما وَبَعضُهُمُ","إِذا حَيَّيتَهُ اِنتَهَرا",51,"ر",2,0],["ولا سقى ربعَ دارِميّ","وساكنيه سوى الصديد",52,"د",1,0],["وَلا سِيَما إِذا أُعطَيتَ أَيداً","لَمَدَّ يَدَيكَ أَو أَنَفاً بِأَنفِ",53,"ف",1,0],["ولا سُلّ في نَصْرِ المكارِمِ صارِمٌ","ولا شُدّ في غَزْوِ العدُوّ حِزامُ",54,"م",1,0],["ولا سرى في الأرض منهم صدى","إلَّا ودوّى باسمِكَ الأمجدِ",55,"د",1,0],["ولا سَعِدَتْ بالوهمِ في عالم المُنَى","ولا شَقِيَتْ بالحبِّ بين لِدَاتِها",56,"ت",3,0],["ولا سارَ في عَرْضِ السَّماوَةِ بارِقٌ","وليس له مِن قوْمنا خُفَراء",57,"ر",3,0],["وَلا سَرَى الأَمْنُ بَعْدَ الْخَوْفِ وَاعْتَصَمَتْ","بِجَانِبِ الصَّبْرِ هِمَّاتُ الْمَغَاوِيرِ",58,"ر",1,0],["وَلاَ سَعْدٌ وَلاَ سَلْوَى","وَلاَ مَجْدٌ سِوَى العَمَلِ",59,"ل",1,0],["وَلا سابِقٌ إِلّا بِساقٍ سَليمَةٍ","وَلا باطِشٍ ما لَم تُعِنهُ الأَنامِلُ",60,"ل",1,0],["وَلا سابِقٌ مِمّا تَخَيَّلتَ سابِقٌ","وَلا صاحِبٌ مِمّا تَخَيَّرتَ صاحِبُ",61,"ب",1,0],["ولا سلاحَ ... سوى الوعد الذي قطعوا:","تفنى الحياة ولا تفنى المواعيد",62,"د",1,0],["وَلا سَمِعتُكَ تَتلو الذِكرَ في سحرٍ","بِصَوتِ داوودِ في إِفصاحِ هَمّامِ",63,"م",1,0],["وَلا سَقَتني الغَوادي","حَسبي الدُموعُ الغِزارُ",64,"ر",1,0],["ولا سالتْ على أرضٍ دِماءٌ","ولا احمرَّت من العَلَقِ الصِّفاحُ",65,"ح",1,0],["ولا سائلٌ عن ليلة كيف باته","ولا كيف لاقى الصبحَ اسودَ داجيا",66,"ي",2,0],["ولا سرحت آآحط يدّي في جبيني","وأرجي الله مايطوّل ب أنتظاري",67,"ر",2,0],["ولا سُكبَتْ بِيضُ الدّموعِ وَحُمرُها","بحَقٍّ، على مِثلِ الغيوثِ السّوَاكِبِ",68,"ب",1,0],["ولا سكنٌ إلا مناجاة فكرة","ٍ كأني بها مستحضرٌ كلّ غائب",69,"ب",1,0],["ولاسيّما بعدَ المشيبِ وبعدَها","أراهم هديَ منهاجِهم سُرُج العقل",70,"ل",1,0],["ولأسعفتك على الهوى بمعطّر","بالحسن لا بشقائق وأقاح",71,"ح",1,0],["ولا سيما السادات منهم فهم لهم","بدار التحلي من يحامون عنهم",72,"م",1,0],["ولا سيما بالشهم مولاي والدي","ملاذي ومن أعددته في الملا ذخرا",73,"ر",2,0],["ولا سفاسف كتب أذهبت عمري","قراءة بين توريد وإصدار",74,"ر",1,0],["وَلا سَلَبَتنيكَ اللَيالي فَإِنَّني","عَنِ العَيشِ إِلّا في جَنابِكَ راغِبُ",75,"ب",1,0],["وَلا سَكَنَت ريحُ المُظَفَّرِ إِنَّها","إِذا عَصَفَت كانَ المُلوكُ بِها عَصفا",76,"ف",2,0],["وَلا سَلامَةَ إِلّا أَن يَجودَ لَهُم","بِها أَبوها فَيَنأى الخَوفُ وَالوَجَلُ",77,"ل",1,0],["ولا سيما أهل السيادة مثلنا","بنو الشرف المحض المصون عن الهوى",78,"و",2,0],["وَلا سيَّما في مَوقِفِ الوَزنِ وَالعَرضِ","لِنَفسي مُنىً أَرجو إِلَيهاوصولَها",79,"ه",2,0],["ولاسقاني من سلاف ثغره","مجاجة تطفى لهيب الجمر",80,"ر",1,0],["ولا سمعت عن كريم منة","إلا ومنه ضعفها في حجر",81,"ر",1,0],["ولا سيما من بعد علم بطردهم","فما يجدوا كناً يظل ولافيّا",82,"ي",2,0],["ولا سيّما من كان مثلكَ هكذا","يحب الرعايا عادلاً في القضيةِ",83,"ه",1,0],["ولاستراق السمع قد جاؤا إلي","رشد بغير لذلك الشيطان",84,"ن",1,0],["ولا سواه ان تقيس من سما","ظروف جوهر حروف الجر",85,"ر",1,0],["وَلا سَعيَ إِلّا دُونَ سَعيِكَ فَليَنَم","وَيَدري اِمرُؤٌ ناواكَ كَيفَ يَنامُ",86,"م",1,0],["وَلا سَمِعتُ بِشَخصٍ آبَ مِن سَفَرٍ","إِلّا حَنَنتُ وَأَعلَنتُ البُكا أَسَفا",87,"ف",2,0],["ولا ساهرا في الحي أرجو وصالها","ولا ساهيا عن كل كلي وجملتي",88,"ت",2,0],["ولا سِيَمَا إذا كُسِيت رُباها","ملابسَ كان يَرْقُمها السحاب",89,"ب",1,0],["ولا سيما أرض كأرضي وأسرة","كقومي وعيش مثل عي