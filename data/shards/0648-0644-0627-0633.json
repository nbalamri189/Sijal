{"poems":[[53,"أراعي بلوغ الشيب والشيب دائيا","https://www.aldiwan.net/poem29567.html","الطويل"],[53,"متى أنا قائم أعلى مقام","https://www.aldiwan.net/poem29753.html","الوافر"],[53,"سليمان دلتني يداك على الغنى","https://www.aldiwan.net/poem29869.html","الطويل"],[53,"الله يعلم ميلي عن جنابكم","https://www.aldiwan.net/poem29960.html","البسيط"],[53,"عظيم الأسى في هذه غير مقنع","https://www.aldiwan.net/poem30141.html","الطويل"],[53,"أبى الله إلا أن يسوء بك العدى","https://www.aldiwan.net/poem30635.html","الطويل"],[53,"ألان جوانبي غمز الخطوب","https://www.aldiwan.net/poem30752.html","الوافر"],[63,"أتروى وقد صدح الجندب","https://www.aldiwan.net/poem46138.html","المتقارب"],[77,"سقى دارهم هام من السحب هامع","https://www.aldiwan.net/poem35996.html","الطويل"],[77,"إذا فاتني ظل الحمى ونعيمه","https://www.aldiwan.net/poem36117.html","الطويل"],[77,"بعثت بشيء كالجفاء وإنما","https://www.aldiwan.net/poem36426.html","الطويل"],[77,"أهاجتك ذكرى من خليط ومعهد","https://www.aldiwan.net/poem36601.html","الطويل"],[71,"ما اسم إذا قطعوه كان أربعة","https://www.aldiwan.net/poem3870.html","البسيط"],[71,"قد زارني من بني الأتراك مختفياً","https://www.aldiwan.net/poem3966.html","البسيط"],[88,"ألا ما لأهل الشرق في برحاء","https://www.aldiwan.net/poem44973.html","الطويل"],[37,"ولا سمراتي يبتغيهن عاضد","https://www.aldiwan.net/poem6473.html","الطويل"],[64,"إني لأكتم من علمي جواهره","https://www.aldiwan.net/poem67543.html","البسيط"],[51,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[51,"تفاءلت والفأل لي معجب","https://www.aldiwan.net/poem9220.html","المتقارب"],[51,"رددت علي مدحي بعد مطل","https://www.aldiwan.net/poem9993.html","الوافر"],[51,"أرقت كأني بت ليلي على الجمر","https://www.aldiwan.net/poem62871.html","الطويل"],[51,"إذا أنت أزمعت الصنيعة مرة","https://www.aldiwan.net/poem65931.html","الطويل"],[51,"لم يبكني رسم منزل طسما","https://www.aldiwan.net/poem66036.html","المنسرح"],[51,"لعمري لقد غاب الرضا فتطاولت","https://www.aldiwan.net/poem66300.html","الطويل"],[51,"يا هل تعود سوالف الأزمان","https://www.aldiwan.net/poem66471.html","الكامل"],[91,"يا نفس لو كنت ترين الشؤون","https://www.aldiwan.net/poem8972.html","عموديه"],[89,"لقد كان سعد خير قوم مجاهد","https://www.aldiwan.net/poem44614.html","الطويل"],[85,"ببيت الأمة أعتقل المطيا","https://www.aldiwan.net/poem6825.html","الوافر"],[85,"صغار في الذهاب وفي الإياب","https://www.aldiwan.net/poem7585.html","الوافر"],[85,"لا والقوام الذي والأعين اللاتي","https://www.aldiwan.net/poem7794.html","البسيط"],[85,"لا والقوام الذي والأعين اللاتي","https://www.aldiwan.net/poem63677.html","البسيط"],[43,"أظبية الوحش لولا ظبية الأنس","https://www.aldiwan.net/poem9611.html","البسيط"],[43,"لجنية أم غادة رفع السجف","https://www.aldiwan.net/poem9728.html","الطويل"],[43,"ألا لا أرى الأحداث حمدا ولا ذما","https://www.aldiwan.net/poem10543.html","الطويل"],[28,"لولا يدا بشر بن مروان لم أبل","https://www.aldiwan.net/poem1236.html",""],[2,"لمن طلل برامة لا يريم","https://www.aldiwan.net/poem25054.html","الوافر"],[66,"لا عبد يغني عنه ولا ولد","https://www.aldiwan.net/poem40130.html","المنسرح"],[66,"ما جاء عبدك مسطور بعثت به","https://www.aldiwan.net/poem40302.html","البسيط"],[66,"ليالي الحمى ما كنت إلا لآليا","https://www.aldiwan.net/poem40988.html","الطويل"],[80,"شددت على صدر الزماع حزامي","https://www.aldiwan.net/poem31296.html","الطويل"],[80,"تدرعت صبري جنة للنوائب","https://www.aldiwan.net/poem31551.html","الطويل"],[44,"سلام الله عدة رمل خبت","https://www.aldiwan.net/poem30572.html","الوافر"],[69,"صبرا لصرف زمان قاطع الحجج","https://www.aldiwan.net/poem28921.html","البسيط"],[74,"ألا ماء إلا فوق نصل يجرد","https://www.aldiwan.net/poem12903.html","الطويل"],[74,"لك الله من برق تراءى فسلما","https://www.aldiwan.net/poem13245.html","الطويل"],[33,"تذكرت ليلى والسنين الخواليا","https://www.aldiwan.net/poem25753.html","الطويل"],[33,"ألا أيها القوم الذين وشوا بنا","https://www.aldiwan.net/poem25911.html","الطويل"],[102,"بكوري عند شباكي","https://www.aldiwan.net/poem33125.html","مجزوء الوافر"],[67,"ثناؤك من روض الخمائل أعطر","https://www.aldiwan.net/poem18070.html","الطويل"],[75,"قامت تميس كما تدافع جدول","https://www.aldiwan.net/poem69047.html","الكامل"],[48,"تحدر ماء مقلته","https://www.aldiwan.net/poem62471.html","مجزوء الوافر"],[48,"دع الرسم الذي دثرا","https://www.aldiwan.net/poem63390.html","مجزوء الوافر"],[48,"لقبلة الراحِ إذ تصلي","https://www.aldiwan.net/poem66577.html","مخلع البسيط"],[46,"بحمد الله لم تخلق كعاب","https://www.aldiwan.net/poem22997.html","الوافر"],[46,"لقد آن أن يثني الجموح لجام","https://www.aldiwan.net/poem23643.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39538","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16640","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42603","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54825","الوافر"],[19,"","https://poetry.dctabudhabi.ae/diwan/poem/2268","الطويل"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/852","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142064","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43747","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43705","المجتث"],[106,"عرش هوى","https://www.poetsgate.com/ViewPoem.aspx?id=179587",""],[90,"المآسي في حياة الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=179158",""],[45,"مُحَمّدُ! مَا آمَالُنَا بكَوَاذِبِ","https://www.poetsgate.com/ViewPoem.aspx?id=31597",""],[80,"تدَرّعْتُ صبري جُنَّة ً للنوائبِ","https://www.poetsgate.com/ViewPoem.aspx?id=3007",""],[51,"إذا أنتَ أزمعتَ الصنيعة َ مرَّة ً","https://www.poetsgate.com/ViewPoem.aspx?id=30283",""]],"verses":[["وَلا سِلمَ حَتّى يَخضِبَ الحَربُ أَرضَها","وَيَغدو فَمُ البَيداءِ بِالنَقعِ راغِيا",0,"ي",2,0],["وَلا سيما وَقَد أَمسى عَليٌّ","ظَهيري وَالسَفيرَ إِلى إِمامي",1,"م",2,0],["وَلا سَيرَ إِلّا أَن أَشُدَّ حَقيبَةً","أَرى ضِمنَها مِن ضامِرِ الزادِ أَبحَلا",2,"ل",2,0],["وَلا سَقى الغَيثُ داراً أَنتَ ساكِنُها","إِلّا بِأَغبَرَ نارِيِّ الذُرى قَصِفِ",3,"ف",1,0],["وَلا سَبَبٌ إِلاّ المَوَدَّةُ إِنَّهُ","تَقَطَّعَ مِنّيَ وَالقُوى لَم تُقَطَّعِ",4,"ع",1,0],["وَلا سَمِعَ الأَعداءُ إِلّا بِأَصلَمٍ","وَلا نَظَرَ الحُسّادُ إِلّا بِأَرمَدا",5,"د",2,0],["وَلا سَترُ الشَبابِ عَلَيَّ عَيباً","فَأَجزَعَ أَن يَنِمَّ عَلى عُيوبي",6,"ب",2,0],["ولا سانِحٌ هزَّ منْ رَوْقِهِ","سَليماً ولا بارِحٌ أعْضَبُ",7,"ب",1,0],["ولا سُكِنَتْ هَذِي الجَزيرةُ بُرْهَةً","وأصْبَحَتِ الأوْطانُ وهْيَ بلاقِعُ",8,"ع",1,0],["وَلاَ سَهِرَتْ عَيْنِي لِبَرْقِ ثَنِيَّةٍ","مِنَ الثَّغْرِ يَبْدُو مَوْهِناً فَيَشِيمُهُ",9,"م",2,0],["ولاسيّما إنْ كان ملْحِمَ بُرْدِها","عَميدُ أولي الألْبابِ نادِرةُ العصرِ",10,"ر",1,0],["ولا سألَ الأطْلالَ بعْدَ قَطينِها","فعيّتْ جَواباً بعْدَ طولِ ترَدُّدِ",11,"د",1,0],["وَلِاِسمِهِ نَسَبٌ لَو كَنتَ تَعرِفُهُ","ما إِن يَؤولُ إِلى عُجمٍ وَلا عرَبِ",12,"ب",1,0],["وَلا سَبيلَ إِلى مَعسولِ ريقَتِهِ","حَتّى يَبيتَ مِنَ الصَهباءِ مُرتَشَفا",13,"ف",2,0],["ولأسْتأصل الموت الوَحِيّ نفوسهم","ونادى عليهم مُؤذناً بفناء",14,"ا",2,0],["ولا سمراتي يبتغيهن عاضدٌ","ولا سلماتي في بجيلة تُعْصَبُ",15,"ب",1,1],["وَلَاِسَتَحَلَّ رِجالٌ مُسلِمونَ دَمي","يَرَونَ أَقبَحَ ما يَأتونَهُ حَسَنا",16,"ن",2,0],["ولاسيّما حين ارتدى الماءُ كِبْرَهُ","وشاغَب أنفاسَ الصَّبا والجنائبِ",17,"ب",1,0],["ولاسيما والذي أرتجي","أبو الصقر ما النُّجحُ بالرائِثِ",18,"ث",1,0],["ولا سِيمَا وقد أعمَقْتَ فيه","مخازِيَكَ اللواتي لنْ تَبيدا",19,"د",2,0],["ولا سِلمَ حتى تُستَرد ظُلامتي","وإلّا فأيقنْ أنّنا فِيئَتا ثغر",20,"ر",1,0],["ولا سيّما بعدَ المشيبِ وبعدَما","أراهم هدى منهاجِهم سُرجُ العقلِ",21,"ل",1,0],["ولا سقَى اللَّه برهةً ضمنتْ","ضدَّيهما وابلاً ولا دِيما",22,"م",2,0],["ولاسِيَّما والخصمُ قاضٍ مُحَكَّمٌ","إليه القضايا والهباتُ الجسائمُ",23,"م",1,0],["ولأسْمُكنّ خلال كُلِّ قبيلة","نشراً لذكرك طيّب النَّسَمانِ",24,"ن",1,0],["وَلا سَمِعتِ الكاسَ ذاتِ الرَنين","إِلّا سَمِعتِ حَطمَةَ الكاسِ",25,"س",1,0],["ولا سامعا إلا شهيقا لمجهش","وإلا زفيرا من حشاشة كامد",26,"د",1,0],["ولا سمع الجماعة غير أني","أرى السودان قطرا أجنبيا",27,"ي",2,0],["ولا ساووك في صدق الطوايا","وإن ساووك في الشيم الكذاب",28,"ب",1,0],["ولا سلوت ولم أهمم ولا خطرت","بالبال سلواك في ماض ولا آتى",29,"ت",2,0],["وَلا سَلَوتُ وَلَم أَهمُم وَلا خَطَرَت","بِالبالِ سَلواكِ في ماضٍ وَلا آتِ",30,"ت",1,0],["وَلا سَقَيتُ الثَرى وَالمُزنُ مُخلِفَةٌ","دَمعاً يُنَشِّفُهُ مِن لَوعَةٍ نَفَسي",31,"س",2,0],["وَلا ساعِياً في قُلَّةِ المَجدِ مُدرِكاً","بِأَفعالِهِ ما لَيسَ يُدرِكُهُ الوَصفُ",32,"ف",1,0],["وَلا سالِكاً إِلّا فُؤادَ عَجاجَةٍ","وَلا واجِداً إِلّا لِمَكرُمَةٍ طَعما",33,"م",2,0],["وَلا سَمَكَت عَنها سَماءً وَليدَةٌ","مَظَلَّةُ أَعرابِيَّةٍ فَوقَ أَسقُبِ",34,"ب",1,0],["وَلا ساهي الفُؤادِ وَلا عَيِيِّ ال","لِسانِ إِذا تَشاجَرَتِ الخُصومُ",35,"م",1,0],["وَلا سَليلٌ يَسُرُّهُ تَلفي","كَناضِحٍ في رِضايَ يَجتَهِدُ",36,"د",1,0],["وَلا سَمَحتَ بِوَعدٍ فيهِ مُرتَقَبٍ","إِلّا تَأَمَّلَهُ عَشراً وَأَمَّلَهُ",37,"ل",2,0],["وَلاسِيَّما لَمّا رَأَونِيَ راغِباً","عَنِ الرِفدِ لا أُبقي مِنَ المالِ باقِيا",38,"ي",2,0],["ولا ساكناً في ليلةٍ مُدْلَهِمَّةٍ","سَرَى ركبُها فيها اصطلاءَ ظلامِ",39,"م",1,0],["ولا سَكَنٌ إلا مناجاة فكرضةٍ","كأني بها مستحضرٌ كلّ غائِبِ",40,"ب",1,0],["وَلَاِستَنجَدتُ حَنظَلَةً وَعَمراً","وَلَم أَعدِل بِسَعدٍ وَالرَبابِ",41,"ب",1,0],["وَلَاِستَرفَدتُ مِن قَيسٍ ذُراها","بَني بَدرٍ وَصيدَ بَني كِلابِ",41,"ب",1,0],["ولا سباني سنا هيفاءَ مقبلةٍ","عجزاءَ مدبرةٍ بالجعدِ والدعجِ",42,"ج",1,0],["وَلا سَيرَ إِلّا فَوقَ ظَهرِ تَنوفَةٍ","يُراعُ سَرابُ القاعِ فيها فَيُرعَدُ",43,"د",1,0],["وَلا سِرتُ عَنها أَركَبُ الصُبحَ أَشهَباً","وَقَد جِئتُ شَوقاً أَركَبُ اللَيلَ أَدهَما",44,"م",2,0],["وَلا سُمِّيَت عِندي لَها مِن سَميَّةٍ","مِنَ الناسِ إِلّا بَلَّ دَمعي رِدائِيا",45,"ي",2,0],["وَلا سِرتُ ميلاً مِن دِمَشقَ وَلا بَدا","سُهَيلٌ لِأَهلِ الشامِ إِلّا بَدا لِيا",45,"ي",2,0],["وَلا سَمِعوا مِن سائِرِ الناسِ مِثلَها","وَلا بَرَزَت في يَومِ أُضحى وَلا فِطرِ",46,"ر",1,0],["ولا سلوى سوى نجوى","أُسرُّ بها لمغناكِ",47,"ك",1,0],["وَلا ستْرَ ما بيْنَ الرَّعايا وبينَهُ","ولكنّهُ حلْماً عَلَى الناسِ يَسْتُرُ",48,"ر",1,0],["ولأسطُوَنَّ على الزّمان بمَن لهُ","قلبي الوَدودُ ومَدْحيَ المُتَنَخَّل",49,"ل",1,0],["وَلا سيما وَقَد غَيَّر","تُ عَقدَ رِباطِ تِكَّتِهِ",50,"ت",2,0],["وَلا سِيَما وَبَعضُهُمُ","إِذا حَيَّيتَهُ اِنتَهَرا",51,"ر",2,0],["ولا سقى ربعَ دارِميّ","وساكنيه سوى الصديد",52,"د",1,0],["وَلا سِيَما إِذا أُعطَيتَ أَيداً","لَمَدَّ يَدَيكَ أَو أَنَفاً بِأَنفِ",53,"ف",1,0],["ولا سُلّ في نَصْرِ المكارِمِ صارِمٌ","ولا شُدّ في غَزْوِ العدُوّ حِزامُ",54,"م",1,0],["ولا سرى في الأرض منهم صدى","إلَّا ودوّى باسمِكَ الأمجدِ",55,"د",1,0],["ولا سَعِدَتْ بالوهمِ في عالم المُنَى","ولا شَقِيَتْ بالحبِّ بين لِدَاتِها",56,"ت",3,0],["ولا سارَ في عَرْضِ السَّماوَةِ بارِقٌ","وليس له مِن قوْمنا خُفَراء",57,"ر",3,0],["وَلا سَرَى الأَمْنُ بَعْدَ الْخَوْفِ وَاعْتَصَمَتْ","بِجَانِبِ الصَّبْرِ هِمَّاتُ الْمَغَاوِيرِ",58,"ر",1,0],["وَلاَ سَعْدٌ وَلاَ سَلْوَى","وَلاَ مَجْدٌ سِوَى العَمَلِ",59,"ل",1,0],["وَلا سابِقٌ إِلّا بِساقٍ سَليمَةٍ","وَلا باطِشٍ ما لَم تُعِنهُ الأَنامِلُ",60,"ل",1,0],["وَلا سابِقٌ مِمّا تَخَيَّلتَ سابِقٌ","وَلا صاحِبٌ مِمّا تَخَيَّرتَ صاحِبُ",61,"ب",1,0],["ولا سلاحَ ... سوى الوعد الذي قطعوا:","تفنى الحياة ولا تفنى المواعيد",62,"د",1,0],["وَلا سَمِعتُكَ تَتلو الذِكرَ في سحرٍ","بِصَوتِ داوودِ في إِفصاحِ هَمّامِ",63,"م",1,0],["وَلا سَقَتني الغَوادي","حَسبي الدُموعُ الغِزارُ",64,"ر",1,0],["ولا سالتْ على أرضٍ دِماءٌ","ولا احمرَّت من العَلَقِ الصِّفاحُ",65,"ح",1,0],["ولا سائلٌ عن ليلة كيف باته","ولا كيف لاقى الصبحَ اسودَ داجيا",66,"ي",2,0],["ولا سُكبَتْ بِيضُ الدّموعِ وَحُمرُها","بحَقٍّ، على مِثلِ الغيوثِ السّوَاكِبِ",67,"ب",1,0],["ولا سكنٌ إلا مناجاة فكرة","ٍ كأني بها مستحضرٌ كلّ غائب",68,"ب",1,0],["ولاسيّما بعدَ المشيبِ وبعدَها","أراهم هديَ منهاجِهم سُرُج العقل",69,"ل",1,0]]}