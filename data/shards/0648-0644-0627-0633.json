 راحتيه يدي",112,"د",2,0],["ولا سفينةَ لي إلا هواكِ وإن","أغرَق فأسعدُنا في الحبِّ غَرقانا",113,"ن",2,0],["ولا سمحت عَيني بأثمنَ قطرةٍ","لأنَّ وداعَ الأمِّ نشَّفَ عبرتي",114,"ي",1,0],["وَلا سَرى البارق المكي مبتسما","الا وأسهرني رهنا وأَسراها",115,"ا",3,0],["وَلا سلكا سَبيلا نَرتَجيك به","الا وجدناكَ للراجين بالرصد",116,"د",1,0],["وَلا ساماكَ فِي عَلْياءَ إِلاّ","وَفُزْتَ بِها انْفِراداً وَانْفِرازا",117,"ز",2,0],["وَلا سَمَتْ هِمَّةُ ذِي هِمَّةٍ","حَتّى اسْتَوَتْ فِي ذِرْوَةِ الْكَوْكَبِ",118,"ب",1,0],["وَلا سُؤْدَدٌ جَمٌّ بِهِ الْخَطْبُ يُزْدَهى","وَلا نائِلٌ غَمْرٌ بِهِ الْقَطْرُ يَفْضَحُ",119,"ح",1,0],["وَلا سبيلَ إِلى أبوابِ حضرتهِ","إلّا لِمَن مُقتضاه نهجكَ الأممُ",120,"م",1,0],["وَلا سمعٌ عَداهُ ولا لسانٌ","وَلا بصرٌ ثناء والشهودُ",121,"د",1,0],["ولا سنحت في باطن القلب خشية","فكانت لشيء غير هجرك خشيتي",122,"ي",1,0],["وَلا سِيِّما دَعوى التَهَكُّمِ أَنَّها","عَجالَةَ طَيشٍ أَو نَتيجَةَ إِمعاضِ",123,"ض",1,0],["وَلا سِيَّما إِن كُنتَ تَقصِدُ أَحمَدا","هُنالِكَ تُلقي الجَدَّ يَتبَعُهُ المَجدُ",124,"د",1,0],["ولا سبّحوا للحقّ أو قدّسوا العلا","أو استمنحوا السقيان من عنده الورد",125,"د",1,0],["وَلا سَعْيَ لي إلاَّ لِبَابِكَ إنَّهُ","لِرَاجِيهِ بَابٌ لِلنّجاحِ مُجَرَّبُ",126,"ب",1,0],["ولا سَلَب الزّمانُ عُلاك يوماً","فأنت لعاطلِ الدُّنيا حُليّ",127,"ي",1,0],["ولا سعَى فيكما بالبَغْيِ ذو حَسدٍ","إلاّ وردَّ عليه اللهُ مَسْعاه",128,"ا",2,0],["ولا سائفاً يوماً بعَيْنٍ كحيلةٍ","ولا تارساً يوماً بغَيْلٍ مُوشَّم",129,"م",1,0],["ولا سلَلْتُ يدي من بَعْدِ ما عَلِقتْ","لديكَ من بُردةِ العَلياءِ أذْيالا",130,"ل",2,0],["ولا سَرَفٌ في الجُودِ قولُك دائماً","إذا قالَ بعضُ النّاسِ لا خيرَ في السَّرَف",131,"ف",1,0],["ولا سِيَّما من بَعدِ ما شَقَّ ليلتي","من الشّيبِ فَجْر صادِقٌ بعد كاذب",132,"ب",1,0],["ولاستيقنت أَنَّ الموت حقٌّ","وصَرَّحَ شحمُ قلبِكَ عن سوادِ",133,"د",1,0],["وَلا ساقٍ بِهِ إِلّا عَذولٌ","سَقاهُ اللَهُ مِمّا قَد سَقاني",134,"ي",1,0],["ولا سَقَتِ البيضَ سودُ الغَما","مِ وبيضُ أيادي أبي القاسِمِ",135,"م",1,0],["ولا سيما إن كان عندما قدرهم","رفيعاً وأرضاهم بك الخبز والملح",136,"ح",1,0],["وَلا سُدَّ عَن خَيرِ المَساجِدِ بابُهُ","وَأَبوابُهُم إِذ ذاكَ عَنه تُسَدَّد",137,"د",1,0],["ولا سمعوا أَنينَ زهورِ ياف","ولا شكوى حقولِ (البرتقالِ)؟",138,"ل",1,0],["ولا سمعوا عن الأقصى حديث","ينادينا إلى شَدِّ الرِّحالِ؟",138,"ل",1,0],["ولا سيما علم العقيدة أنها الأ","ساس عليه ينبني العبد كلما",139,"م",2,0],["ولاسرائيل لَمَّا أن شكا","ردَّ من يهواه إذ رَدَّ البصر",140,"ر",1,0],["ولا سلا عنه فؤادي وهل","يضل بعد البعد عن رشده",141,"د",2,0],["ولا سمحت بلقيا والدي وأخي","للّه من والدٍ بَرٍّ ومن ولد",142,"د",1,0],["وَلا سُلكت سُبلُ السَماحِ وَلا اهتَدى","إِلى نَهجِ الأَفضالِ في شامنا نَدبُ",143,"ب",1,0],["ولا سَعَتْ بي إلى ما ساءَهُمْ قَدَمُ","كَمْ رُضْتُ نفسيَ بالسُّلوانِ فامتَنَعَتْ",144,"ت",1,0],["ولا سَقى الأطماعَ صوبُ الحَيا","فإنَّها مَهْلَكَةُ الطَّامِعِ",145,"ع",1,0],["ولا سليمانُ ابنُهُ ردَّهَا","بمُلْكِهِ والحشدِ من جُنْدِهِ",146,"د",2,0],["ولأسْمرٍ لدْنِ الكعوبِ وِجارُهُ","حيثُ استَمَرَّ الفكرُ والأوهامُ",147,"م",1,0],["ولا سيما إذا هبَّت شمالٌ","به أو أوْمَضت منه البروق",148,"ق",1,0],["ولا سيَّما إذ شاهد الربع لم يدع","له أهْلُه إلاَّ تِلالاً وأرسما",149,"م",2,0],["ولا سمعت بشيء من مناقبه","إلاَّ انثنيت بما أسمعت نشوانا",150,"ن",2,0],["ولا سَلا قلبي فيمَنْ قد سلا","وحقِّ آياتِ الكتابِ المنزَل",151,"ل",1,0],["ولا سيما من كفّ أحورَ ساحرٍ","بألحاظِه ردّ الخميسَ العرمرما",152,"م",2,0],["ولا سرَتْ نحوكُمُ أسرةٌ","تأسُرُ بالداهيةِ الصّيلَمِ",153,"م",1,0],["ولا سيّما ونحوَكَ كلّ عينٍ","يسارقُ لحظَها نظرُ خفيُّ",154,"ي",1,0],["ولا سقيت ربا الجرعاء من إضم","دمعا غدا يوم سار الحيّ منذر فا",155,"ف",2,0],["ولأَسْطُوَنَّ عَلَى الزمانِ بِعَزْمَتِي","ولأَنْحِيَنَّ عَلَى الخطوبِ بكَلْكَلِي",156,"ل",2,0],["ولاسِيَّما حُرٌّ جَلا لَكَ غَيْمُهُ","نصيحةَ لا وانٍ وإِشفاقَ لا آلِ",157,"ل",1,0],["ولاستَبْدَلَتْ قَرْع النواقيسِ بالضُّحى","مَنارٌ وقامت فِي المحاريب صُلبانُ",158,"ن",1,0],["ولا سكروا بخمرٍ من لماها","ولا بزخارف منها عواث",159,"ث",1,0],["ولا سابق إلا وعقباه لاحق","سبيل الردى كل له فهو سالك",160,"ك",1,0],["ولا سرى في هزيع الليل ريح صب","إلا وحيتك بالأنفاس أزهار",161,"ر",1,0],["ولاستلبت على إضم فؤادي","حماماتٌ تنوح كما تغنِّي",162,"ي",1,0],["ولا سرى عرقُ الإماء فيهمُ","خبائث ليست مَريئات الأُكُلْ",163,"ل",1,0],["ولا سرى مُلكُ بني هاشم","فألحقَ المغرِبَ بالمشرقِ",164,"ق",1,0],["ولا سروح يَغصّ الواديان بها","فيها مُزَكَّى إلي الساعي ومعشورُ",165,"ر",1,0],["ولا سمحتُ لمَلْكٍ قطّ قبلَك باق","تضاءِ رفدٍ ولكن أنت منصورُ",165,"ر",1,0],["ولا سيما عِتابَ أخي عَلاءٍ","سليم العِرْض من عارٍ وعابِ",166,"ب",1,0],["ولا ساجلَتْهُ في النَّوال سحائبٌ","من الوُطْفِ اِلا كان أندى وأغزرا",167,"ر",2,0],["ولأسد الغاب إذا تقنصها","ليلة النفر ظباء المنحنى",168,"ن",2,0],["وَلا سِيَّما مَن كانَ راحى رُضابَهُ","وَنُقلي ثَناياهُ وَزَهري مَجاسِدَه",169,"د",2,0],["ولا سيَّما أن تناءَى الرقيبُ","وأدَّتْ تحيتيَ الاِصْبَعُ",170,"ع",1,0],["ولا سَورةِ الغيرانِ بينَ صِحابهِ","يُسارِقُني لحظَ العدوِّ المراقبِ",171,"ب",1,0],["ولا سحيقُ المسكِ قد حبَّه","في الحيَّ عطارٌ وسحّاقُ",172,"ق",1,0],["ولا سيان في درج المعالي","إذا ميزت مرتفعاً وطاف",173,"ف",1,0],["ولا سرٌّ خفيٌّ في سرائرنا","وطاب بالسرِّ بادينا وخافينا",174,"ن",2,0],["ولا سَمعْتُ سَحَراً رَنينَها","إِلاَّ وَرَنَّتْ بالثَرى دُموعي",175,"ع",2,0],["ولا سطرت على طرس مكاتبة","إلا بدت غرر من فوقها طرر",176,"ر",1,0],["ولاسيما فراق أشم كانت","عقارب رأيه غصص الأفاعي",177,"ع",2,0],["ولا سار في عالي ركائب موكب","ينافس فيه فارس الخيل راجله",178,"ل",2,0],["ولا سلو ولا علو ولكن","لي طلوع مع الهوى ونزول",179,"ل",1,0],["ولا سيَما مَن يَجهلُون مكَانَه","لَدَّى ولَم يَدرُوا لَديه مَكَانِيا",180,"ي",2,0],["ولا سيَما في عهدِ من به عهدُنا","على هامِه تاجُ المفاخِرُ يُعقَدُ",181,"د",1,0],["ولا سمحتُ بعِرْضِي","وقايةً دون مالي",182,"ي",1,0],["ولا سيّرتْ فضلي إليها مغاربٌ","ولا طَيَّرَتْهُ بينهنّ مشارقُ",183,"ق",1,0],["ولا سواءٌ عند ذي إِرْبَةٍ","باطنُ رجلِ المرءِ والمَفْرقُ",184,"ق",1,0],["ولا ساءَني فيك مرّ الزّما","نِ مرأىً ولا رابنِي مَسمَعُ",185,"ع",1,0],["وَلا سقَى اللَّهُ لَنا ظامِئاً","من بعد أن جُنِّبتُمُ الأبحرا",186,"ر",2,0],["وَلا سَقَتكمْ منَ الأنواءِ ساقيةٌ","ولا نَشَحْتُمْ إذا ما معشرٌ نَشَحا",187,"ح",2,0],["وَلا سَمِعنا لِخريقٍ بهِ","صوتاً ولا زَعزَعَةَ النُّكْبِ",188,"ب",1,0],["ولا سفر لا غربة لا إقامة","ولا حضر يوم اللقاء ولا بدو",189,"و",1,0],["ولا سوانا من الأكوان يعرفنا","والغيب نحن وهذا القول إضمار",190,"ر",1,0],["ولا سلم في الدنيا لمستسلم القضا","متى دهمته من أوربا دواهم",191,"م",1,0],["ولا سَقَى الغيثُ دارً مَيَّةَ بال","عَلْيَاءِ كَلاًّ يُدَاكُ والسَّنَدِ",192,"د",1,0],["ولا سيما وَهْوَ مِنْ عَاشِقٍ","رماهُ الهوى وبَراهُ السَّقَمْ",193,"م",1,0],["ولا سيّما لمّا مررتُ بمنزلٍ","كفضلةِ صبرٍ في فؤَادٍ متيَّم",194,"م",1,0],["ولا سِيَّما والصَّاحبُ النَّدبُ صَاحَ بي","إِليكَ فِلي دَلٌّ عليكَ وإِدْلاَل",195,"ل",1,0],["ولا سَقَى دَارَهُ يَوْماً إِذَا سُقِيَتْ","دَاري بِدَمْعي إلّا وابِلُ المَطَرِ",196,"ر",1,0],["وَلَا سِيَّما صَبٌّ يَذُوبُ صَبابةً","بما جلَّ عَنْ حَصْرٍ بِما دَقَّ مِنْ خَصْرِ",197,"ر",1,0],["وَلا سَرتْ مِنْ نَحْوهِ نَسْمةٌ","إلّا عَرفْناها بِرَيَّاكُم",198,"م",1,0],["ولاسيما الأعراب منهم فإنهم","هم الردء للأعدا بتلك الملاحم",199,"م",1,0]]}