m60192.html","الطويل"],[478,"على البان قمرية تسجع","https://www.aldiwan.net/poem15215.html","المتقارب"],[478,"أرقت هوى والليل مرخي الذوائب","https://www.aldiwan.net/poem15229.html","الطويل"],[478,"بي من جوى التبريح اشفاق","https://www.aldiwan.net/poem15351.html","السريع"],[496,"خلقت كما ترى صعب الثقاف","https://www.aldiwan.net/poem10241.html","الوافر"],[501,"يا منشد الغيب أذكر من نيهم به","https://www.aldiwan.net/poem37632.html","البسيط"],[501,"ما هفهفتني نسمة الربيع","https://www.aldiwan.net/poem37979.html","السريع"],[516,"في مثل مدحك شرح القول مختصر","https://www.aldiwan.net/poem12117.html","البسيط"],[516,"تناولت المكارم والمساعي","https://www.aldiwan.net/poem12173.html","الوافر"],[516,"أفي أهل ذا النادي عليم أسائله","https://www.aldiwan.net/poem12195.html","الطويل"],[516,"خذ حديثي فإنه معسول","https://www.aldiwan.net/poem12218.html","الخفيف"],[539,"دعاني من ذكر السقام دعانيا","https://www.aldiwan.net/poem47498.html","عموديه"],[539,"لسانكم بالفخر دوما يردد","https://www.aldiwan.net/poem48234.html","عموديه"],[552,"والله لا ذقت يوما","https://www.aldiwan.net/poem47271.html","المجتث"],[552,"أقلني ربي بالذين اصطفيتهم","https://www.aldiwan.net/poem47370.html","الطويل"],[552,"دع الهوى يتبعه الأخرق","https://www.aldiwan.net/poem47377.html","السريع"],[552,"صبرت ومثلك لا يجزع","https://www.aldiwan.net/poem47722.html","المتقارب"],[552,"أما ترى الربع الذي أقفرا","https://www.aldiwan.net/poem47804.html","السريع"],[552,"أما سمعت حمام الأيك إذ صدحا","https://www.aldiwan.net/poem47895.html","البسيط"],[552,"أي فتى ووري في الترب","https://www.aldiwan.net/poem48059.html","السريع"],[559,"أنا العاشق السالي لوجهك يا علو","https://www.aldiwan.net/poem33585.html","الطويل"],[559,"تبارك الله ما في الدار ديار","https://www.aldiwan.net/poem34533.html","البسيط"],[565,"أجودُ ابن زين أو غيوثُ سواجم","https://www.aldiwan.net/poem890.html",""],[568,"لا وجفون ينفثن في العقد","https://www.aldiwan.net/poem69709.html","البسيط"],[576,"مديحك كالمسك لا يكتتم","https://www.aldiwan.net/poem3006.html","المتقارب"],[576,"تقنعت لكن بالحبيب المعمم","https://www.aldiwan.net/poem3018.html","الطويل"],[576,"على خاطري يا شغله منك أشغال","https://www.aldiwan.net/poem3029.html","الطويل"],[587,"لا أسهر الله طرفا نام عن سهري","https://www.aldiwan.net/poem17535.html","البسيط"],[587,"أسير لحاظ كيف ينجو من الأسر","https://www.aldiwan.net/poem17537.html","الطويل"],[587,"الدمع هام والحشا هائم","https://www.aldiwan.net/poem17702.html","السريع"],[588,"أمور القضا ليست بحكم العوالم","https://www.aldiwan.net/poem11521.html","عموديه"]],"verses":[["ولا سامعٍ يرضى على السبط فعلهم","ولا عالماً حدباً عليهم تكتما",0,"م",2,0],["وَلا سِلمَ حَتّى يَخضِبَ الحَربُ أَرضَها","وَيَغدو فَمُ البَيداءِ بِالنَقعِ راغِيا",1,"ي",2,0],["وَلا سيما وَقَد أَمسى عَليٌّ","ظَهيري وَالسَفيرَ إِلى إِمامي",2,"م",2,0],["وَلا سَيرَ إِلّا أَن أَشُدَّ حَقيبَةً","أَرى ضِمنَها مِن ضامِرِ الزادِ أَبحَلا",3,"ل",2,0],["وَلا سَقى الغَيثُ داراً أَنتَ ساكِنُها","إِلّا بِأَغبَرَ نارِيِّ الذُرى قَصِفِ",4,"ف",1,0],["وَلا سَبَبٌ إِلاّ المَوَدَّةُ إِنَّهُ","تَقَطَّعَ مِنّيَ وَالقُوى لَم تُقَطَّعِ",5,"ع",1,0],["وَلا سَمِعَ الأَعداءُ إِلّا بِأَصلَمٍ","وَلا نَظَرَ الحُسّادُ إِلّا بِأَرمَدا",6,"د",2,0],["وَلا سَترُ الشَبابِ عَلَيَّ عَيباً","فَأَجزَعَ أَن يَنِمَّ عَلى عُيوبي",7,"ب",2,0],["ولا سانِحٌ هزَّ منْ رَوْقِهِ","سَليماً ولا بارِحٌ أعْضَبُ",8,"ب",1,0],["ولا سُكِنَتْ هَذِي الجَزيرةُ بُرْهَةً","وأصْبَحَتِ الأوْطانُ وهْيَ بلاقِعُ",9,"ع",1,0],["وَلاَ سَهِرَتْ عَيْنِي لِبَرْقِ ثَنِيَّةٍ","مِنَ الثَّغْرِ يَبْدُو مَوْهِناً فَيَشِيمُهُ",10,"م",2,0],["ولاسيّما إنْ كان ملْحِمَ بُرْدِها","عَميدُ أولي الألْبابِ نادِرةُ العصرِ",11,"ر",1,0],["ولا سألَ الأطْلالَ بعْدَ قَطينِها","فعيّتْ جَواباً بعْدَ طولِ ترَدُّدِ",12,"د",1,0],["وَلِاِسمِهِ نَسَبٌ لَو كَنتَ تَعرِفُهُ","ما إِن يَؤولُ إِلى عُجمٍ وَلا عرَبِ",13,"ب",1,0],["وَلا سَبيلَ إِلى مَعسولِ ريقَتِهِ","حَتّى يَبيتَ مِنَ الصَهباءِ مُرتَشَفا",14,"ف",2,0],["ولأسْتأصل الموت الوَحِيّ نفوسهم","ونادى عليهم مُؤذناً بفناء",15,"ا",2,0],["ولا سمراتي يبتغيهن عاضدٌ","ولا سلماتي في بجيلة تُعْصَبُ",16,"ب",1,1],["وَلَاِسَتَحَلَّ رِجالٌ مُسلِمونَ دَمي","يَرَونَ أَقبَحَ ما يَأتونَهُ حَسَنا",17,"ن",2,0],["ولاسيّما حين ارتدى الماءُ كِبْرَهُ","وشاغَب أنفاسَ الصَّبا والجنائبِ",18,"ب",1,0],["ولاسيما والذي أرتجي","أبو الصقر ما النُّجحُ بالرائِثِ",19,"ث",1,0],["ولا سِيمَا وقد أعمَقْتَ فيه","مخازِيَكَ اللواتي لنْ تَبيدا",20,"د",2,0],["ولا سِلمَ حتى تُستَرد ظُلامتي","وإلّا فأيقنْ أنّنا فِيئَتا ثغر",21,"ر",1,0],["ولا سيّما بعدَ المشيبِ وبعدَما","أراهم هدى منهاجِهم سُرجُ العقلِ",22,"ل",1,0],["ولا سقَى اللَّه برهةً ضمنتْ","ضدَّيهما وابلاً ولا دِيما",23,"م",2,0],["ولاسِيَّما والخصمُ قاضٍ مُحَكَّمٌ","إليه القضايا والهباتُ الجسائمُ",24,"م",1,0],["ولأسْمُكنّ خلال كُلِّ قبيلة","نشراً لذكرك طيّب النَّسَمانِ",25,"ن",1,0],["وَلا سَمِعتِ الكاسَ ذاتِ الرَنين","إِلّا سَمِعتِ حَطمَةَ الكاسِ",26,"س",1,0],["ولا سامعا إلا شهيقا لمجهش","وإلا زفيرا من حشاشة كامد",27,"د",1,0],["ولا سمع الجماعة غير أني","أرى السودان قطرا أجنبيا",28,"ي",2,0],["ولا ساووك في صدق الطوايا","وإن ساووك في الشيم الكذاب",29,"ب",1,0],["ولا سلوت ولم أهمم ولا خطرت","بالبال سلواك في ماض ولا آتى",30,"ت",2,0],["وَلا سَلَوتُ وَلَم أَهمُم وَلا خَطَرَت","بِالبالِ سَلواكِ في ماضٍ وَلا آتِ",31,"ت",1,0],["وَلا سَقَيتُ الثَرى وَالمُزنُ مُخلِفَةٌ","دَمعاً يُنَشِّفُهُ مِن لَوعَةٍ نَفَسي",32,"س",2,0],["وَلا ساعِياً في قُلَّةِ المَجدِ مُدرِكاً","بِأَفعالِهِ ما لَيسَ يُدرِكُهُ الوَصفُ",33,"ف",1,0],["وَلا سالِكاً إِلّا فُؤادَ عَجاجَةٍ","وَلا واجِداً إِلّا لِمَكرُمَةٍ طَعما",34,"م",2,0],["وَلا سَمَكَت عَنها سَماءً وَليدَةٌ","مَظَلَّةُ أَعرابِيَّةٍ فَوقَ أَسقُبِ",35,"ب",1,0],["وَلا ساهي الفُؤادِ وَلا عَيِيِّ ال","لِسانِ إِذا تَشاجَرَتِ الخُصومُ",36,"م",1,0],["وَلا سَليلٌ يَسُرُّهُ تَلفي","كَناضِحٍ في رِضايَ يَجتَهِدُ",37,"د",1,0],["وَلا سَمَحتَ بِوَعدٍ فيهِ مُرتَقَبٍ","إِلّا تَأَمَّلَهُ عَشراً وَأَمَّلَهُ",38,"ل",2,0],["وَلاسِيَّما لَمّا رَأَونِيَ راغِباً","عَنِ الرِفدِ لا أُبقي مِنَ المالِ باقِيا",39,"ي",2,0],["ولا ساكناً في ليلةٍ مُدْلَهِمَّةٍ","سَرَى ركبُها فيها اصطلاءَ ظلامِ",40,"م",1,0],["ولا سَكَنٌ إلا مناجاة فكرضةٍ","كأني بها مستحضرٌ كلّ غائِبِ",41,"ب",1,0],["وَلَاِستَنجَدتُ حَنظَلَةً وَعَمراً","وَلَم أَعدِل بِسَعدٍ وَالرَبابِ",42,"ب",1,0],["وَلَاِستَرفَدتُ مِن قَيسٍ ذُراها","بَني بَدرٍ وَصيدَ بَني كِلابِ",42,"ب",1,0],["ولا سباني سنا هيفاءَ مقبلةٍ","عجزاءَ مدبرةٍ بالجعدِ والدعجِ",43,"ج",1,0],["وَلا سَيرَ إِلّا فَوقَ ظَهرِ تَنوفَةٍ","يُراعُ سَرابُ القاعِ فيها فَيُرعَدُ",44,"د",1,0],["وَلا سِرتُ عَنها أَركَبُ الصُبحَ أَشهَباً","وَقَد جِئتُ شَوقاً أَركَبُ اللَيلَ أَدهَما",45,"م",2,0],["وَلا سُمِّيَت عِندي لَها مِن سَميَّةٍ","مِنَ الناسِ إِلّا بَلَّ دَمعي رِدائِيا",46,"ي",2,0],["وَلا سِرتُ ميلاً مِن دِمَشقَ وَلا بَدا","سُهَيلٌ لِأَهلِ الشامِ إِلّا بَدا لِيا",46,"ي",2,0],["وَلا سَمِعوا مِن سائِرِ الناسِ مِثلَها","وَلا بَرَزَت في يَومِ أُضحى وَلا فِطرِ",47,"ر",1,0],["ولا سلوى سوى نجوى","أُسرُّ بها لمغناكِ",48,"ك",1,0],["وَلا ستْرَ ما بيْنَ الرَّعايا وبينَهُ","ولكنّهُ حلْماً عَلَى الناسِ يَسْتُرُ",49,"ر",1,0],["ولأسطُوَنَّ على الزّمان بمَن لهُ","قلبي الوَدودُ ومَدْحيَ المُتَنَخَّل",50,"ل",1,0],["وَلا سيما وَقَد غَيَّر","تُ عَقدَ رِباطِ تِكَّتِهِ",51,"ت",2,0],["وَلا سِيَما وَبَعضُهُمُ","إِذا حَيَّيتَهُ اِنتَهَرا",52,"ر",2,0],["ولا سقى ربعَ دارِميّ","وساكنيه سوى الصديد",53,"د",1,0],["وَلا سِيَما إِذا أُعطَيتَ أَيداً","لَمَدَّ يَدَيكَ أَو أَنَفاً بِأَنفِ",54,"ف",1,0],["ولا سُلّ في نَصْرِ المكارِمِ صارِمٌ","ولا شُدّ في غَزْوِ العدُوّ حِزامُ",55,"م",1,0],["ولا سرى في الأرض منهم صدى","إلَّا ودوّى باسمِكَ الأمجدِ",56,"د",1,0],["ولا سَعِدَتْ بالوهمِ في عالم المُنَى","ولا شَقِيَتْ بالحبِّ بين لِدَاتِها",57,"ت",3,0],["ولا سارَ في عَرْضِ السَّماوَةِ بارِقٌ","وليس له مِن قوْمنا خُفَراء",58,"ر",3,0],["وَلا سَرَى الأَمْنُ بَعْدَ الْخَوْفِ وَاعْتَصَمَتْ","بِجَانِبِ الصَّبْرِ هِمَّاتُ الْمَغَاوِيرِ",59,"ر",1,0],["وَلاَ سَعْدٌ وَلاَ سَلْوَى","وَلاَ مَجْدٌ سِوَى العَمَلِ",60,"ل",1,0],["وَلا سابِقٌ إِلّا بِساقٍ سَليمَةٍ","وَلا باطِشٍ ما لَم تُعِنهُ الأَنامِلُ",61,"ل",1,0],["وَلا سابِقٌ مِمّا تَخَيَّلتَ سابِقٌ","وَلا صاحِبٌ مِمّا تَخَيَّرتَ صاحِبُ",62,"ب",1,0],["ولا سلاحَ ... سوى الوعد الذي قطعوا:","تفنى الحياة ولا تفنى المواعيد",63,"د",1,0],["وَلا سَمِعتُكَ تَتلو الذِكرَ في سحرٍ","بِصَوتِ داوودِ في إِفصاحِ هَمّامِ",64,"م",1,0],["وَلا سَقَتني الغَوادي","حَسبي الدُموعُ الغِزارُ",65,"ر",1,0],["ولا سالتْ على أرضٍ دِماءٌ","ولا احمرَّت من العَلَقِ الصِّفاحُ",66,"ح",1,0],["ولا سائلٌ عن ليلة كيف باته","ولا كيف لاقى الصبحَ اسودَ داجيا",67,"ي",2,0],["ولا سرحت آآحط يدّي في جبيني","وأرجي الله مايطوّل ب أنتظاري",68,"ر",2,0],["ولا سُكبَتْ بِيضُ الدّموعِ وَحُمرُها","بحَقٍّ، على مِثلِ الغيوثِ السّوَاكِبِ",69,"ب",1,0],["ولا سكنٌ إلا مناجاة فكرة","ٍ كأني بها مستحضرٌ كلّ غائب",70,"ب",1,0],["ولاسيّما بعدَ المشيبِ وبعدَها","أراهم هديَ منهاجِهم سُرُج العقل",71,"ل",1,0],["ولأسعفتك على الهوى بمعطّر","بالحسن لا بشقائق وأقاح",72,"ح",1,0],["ولا سيما السادات منهم فهم لهم","بدار التحلي من يحامون عنهم",73,"م",1,0],["ولا سيما بالشهم مولاي والدي","ملاذي ومن أعددته في الملا ذخرا",74,"ر",2,0],["ولا سفاسف كتب أذهبت عمري","قراءة بين توريد وإصدار",75,"ر",1,0],["وَلا سَلَبَتنيكَ اللَيالي فَإِنَّني","عَنِ العَيشِ إِلّا في جَنابِكَ راغِبُ",76,"ب",1,0],["وَلا سَكَنَت ريحُ المُظَفَّرِ إِنَّها","إِذا عَصَفَت كانَ المُلوكُ بِها عَصفا",77,"ف",2,0],["وَلا سَلامَةَ إِلّا أَن يَجودَ لَهُم","بِها أَبوها فَيَنأى الخَوفُ وَالوَجَلُ",78,"ل",1,0],["ولا سيما أهل السيادة مثلنا","بنو الشرف المحض المصون عن الهوى",79,"و",2,0],["وَلا سيَّما في مَوقِفِ الوَزنِ وَالعَرضِ","لِنَفسي مُنىً أَرجو إِلَيهاوصولَها",80,"ه",2,0],["ولاسقاني من سلاف ثغره","مجاجة تطفى لهيب الجمر",81,"ر",1,0],["ولا سمعت عن كريم منة","إلا ومنه ضعفها في حجر",82,"ر",1,0],["ولا سيما من بعد علم بطردهم","فما يجدوا كناً يظل ولافيّا",83,"ي",2,0],["ولا سيّما من كان مثلكَ هكذا","يحب الرعايا عادلاً في القضيةِ",84,"ه",1,0],["ولاستراق السمع قد جاؤا إلي","رشد بغير لذلك الشيطان",85,"ن",1,0],["ولا سواه ان تقيس من سما","ظروف جوهر حروف الجر",86,"ر",1,0],["وَلا سَعيَ إِلّا دُونَ سَعيِكَ فَليَنَم","وَيَدري اِمرُؤٌ ناواكَ كَيفَ يَنامُ",87,"م",1,0],["وَلا سَمِعتُ بِشَخصٍ آبَ مِن سَفَرٍ","إِلّا حَنَنتُ وَأَعلَنتُ البُكا أَسَفا",88,"ف",2,0],["ولا ساهرا في الحي أرجو وصالها","ولا ساهيا عن كل كلي وجملتي",89,"ت",2,0],["ولا سِيَمَا إذا كُسِيت رُباها","ملابسَ كان يَرْقُمها السحاب",90,"ب",1,0],["ولا سيما أرض كأرضي وأسرة","كقومي وعيش مثل عيش يافع",91,"ع",1,0],["ولا سيّما إن كفّ أو كان أحنفا","تلقاه قبل الموت بالنار مالك",92,"ك",1,0],["ولا سيّما والجهل أنفقُ ما ترى","يباع وأن العلم ليس بنافق",93,"ق",1,0],["ولاسيما إذا ما كان نزرا","قليلا لم توفّره التجاره",94,"ر",2,0],["وَلا سِيّما أهلُ الكتابِ فَكَم رأوا","بَشائرَ مِنها طابقَ الخبرُ الخُبرا",95,"ر",2,0],["وَلا سيّما مَن كانَ يُنفقُ مالهُ","لِتأييدِ دين اللَّه ينصرُهُ نَصرا",95,"ر",2,0],["وَلا سيّما ما فيهِ تأييدُ دينكم","فَأَعداؤُكم بالعلمِ قَد مَلَكوا الأمرا",95,"ر",2,0],["وَلا سارَ يَوماً في الملاهي بسيرهِم","وَلَم يَرضَ فيما هُم عليه بكفرهِم",96,"م",1,0],["وَلا سيّما الصدّيقُ وَالفاتح الثاني","عليٌّ أبو الأشراف من بعد عثمانِ",96,"ن",1,0],["وَلا سائِلاً إِنَّ عِندَ الإِلَ","ه خَيرَ المَسائِلِ وَالمَطلَبِ",97,"ب",1,0],["وَلا سابِقي كاشِحٌ نازِحٌ","بِذَحلٍ إِذا ما طَلَبتُ الذُحولا",98,"ل",2,0],["ولاستَقصَت حيالَ النَعشِ عيني","وَراءَكَ راحلاً هِمَمَ البُكاةِ",99,"ه",1,0],["ولا سرى ركبٌ إلى أرضكم","إلا تلاه قلبي الشيّق",100,"ق",1,0],["وَلا سَفَروا لِثاماً عَن حَياءٍ","وَلا كَرَمٍ وَلا أَنفٍ حَمِيِّ",101,"ي",1,0],["وَلا سَعى لَكَ صَرفُ الدَهرِ في حُرُمٍ","وَلا رَأى وَجهُ مَن يَرجوكَ حِرمانُ",102,"ن",1,0],["وَلاسِيَما وَهَذا عامُ مَحلٍ","تَوالى الجَدبُ فيهِ بَعدَ عامِ",103,"م",1,0],["وَلا سِيَما وَمَنصورُ بنُ نَصرِ بِن","مَنصورِ الجَوادِ بِها كَفيلُ",104,"ل",1,0],["وَلا سُرِحَت تَرتادُ مَرعىً دَنِيَّةً","وَلا زاحَمَت هيمَ المَطايا عَلى وِردِ",105,"د",1,0],["وَلا سَما إِلى نَوا","لٍ طَرفُها وَلا طَمَح",106,"ح",1,0],["وَلاَسِيَّمَا مَنْ يَدَّعِي الْعِلْمَ مِنْهُمُ","أُولَئِكَ كلٌّ فِي حِمَى الْمَكْرِ هِرْبِذَا",107,"ذ",2,0],["وَلاَ سَيَّمَا مَنْ بَنَى قُبَّةً","بِهِ نُورُ بَهْجَتِهَا سَاطِعُ",108,"ع",1,0],["وَلاَ سَخِطْتُ الذِي رَمَانِي بِهِ","وَإِنْ كَسَانِي السَّقَامَ وَالدَّنَفَا",109,"ف",2,0],["ولا سيما والبردُ وافى بَريدُهُ","وحالي على ما اعتدت في حالة حَالي",110,"ل",2,0],["ولا سيّما لمّا تسامت بروجُها","بأكمل بدرٍ في سما الفضل لائح",111,"ح",1,0],["ولا سحت الأجفان سحب مدامعي","لأطفائه إلا تأجج ناره",112,"ر",2,0],["ولا سقيت الغمام عن ظماء","ان امتدت غير راحتيه يدي",113,"د",2,0],["ولا سفينةَ لي إلا هواكِ وإن","أغرَق فأسعدُنا في الحبِّ غَرقانا",114,"ن",2,0],["ولا سمحت عَيني بأثمنَ قطرةٍ","لأنَّ وداعَ الأمِّ نشَّفَ عبرتي",115,"ي",1,0],["وَلا سَرى البارق المكي مبتسما","الا وأسهرني رهنا وأَسراها",116,"ا",3,0],["وَلا سلكا سَبيلا نَرتَجيك به","الا وجدناكَ للراجين بالرصد",117,"د",1,0],["وَلا ساماكَ فِي عَلْياءَ إِلاّ","وَفُزْتَ بِها انْفِراداً وَانْفِرازا",118,"ز",2,0],["وَلا سَمَتْ هِمَّةُ ذِي هِمَّةٍ","حَتّى اسْتَوَتْ فِي ذِرْوَةِ الْكَوْكَبِ",119,"ب",1,0],["وَلا سُؤْدَدٌ جَمٌّ بِهِ الْخَطْبُ يُزْدَهى","وَلا نائِلٌ غَمْرٌ بِهِ الْقَطْرُ يَفْضَحُ",120,"ح",1,0],["وَلا سبيلَ إِلى أبوابِ حضرتهِ","إلّا لِمَن مُقتضاه نهجكَ الأممُ",121,"م",1,0],["وَلا سمعٌ عَداهُ ولا لسانٌ","وَلا بصرٌ ثناء والشهودُ",122,"د",1,0],["ولا سنحت في باطن القلب خشية","فكانت لشيء غير هجرك خشيتي",123,"ي",1,0],["وَلا سِيِّما دَعوى التَهَكُّمِ أَنَّها","عَجالَةَ طَيشٍ أَو نَتيجَةَ إِمعاضِ",124,"ض",1,0],["وَلا سِيَّما إِن كُنتَ تَقصِدُ أَحمَدا","هُنالِكَ تُلقي الجَدَّ يَتبَعُهُ المَجدُ",125,"د",1,0],["ولا سبّحوا للحقّ أو قدّسوا العلا","أو استمنحوا السقيان من عنده الورد",126,"د",1,0],["وَلا سَعْيَ لي إلاَّ لِبَابِكَ إنَّهُ","لِرَاجِيهِ بَابٌ لِلنّجاحِ مُجَرَّبُ",127,"ب",1,0],["ولا سَلَب الزّمانُ عُلاك يوماً","فأنت لعاطلِ الدُّنيا حُليّ",128,"ي",1,0],["ولا سعَى فيكما بالبَغْيِ ذو حَسدٍ","إلاّ وردَّ عليه اللهُ مَسْعاه",129,"ا",2,0],["ولا سائفاً يوماً بعَيْنٍ كحيلةٍ","ولا تارساً يوماً بغَيْلٍ مُوشَّم",130,"م",1,0],["ولا سلَلْتُ يدي من بَعْدِ ما عَلِقتْ","لديكَ من بُردةِ العَلياءِ أذْيالا",131,"ل",2,0],["ولا سَرَفٌ في الجُودِ قولُك دائماً","إذا قالَ بعضُ النّاسِ لا خيرَ في السَّرَف",132,"ف",1,0],["ولا سِيَّما من بَعدِ ما شَقَّ ليلتي","من الشّيبِ فَجْر صادِقٌ بعد كاذب",133,"ب",1,0],["ولاستيقنت أَنَّ الموت حقٌّ","وصَرَّحَ شحمُ قلبِكَ عن سوادِ",134,"د",1,0],["وَلا ساقٍ بِهِ إِلّا عَذولٌ","سَقاهُ اللَهُ مِمّا قَد سَقاني",135,"ن",2,0],["ولا سَقَتِ البيضَ سودُ الغَما","مِ وبيضُ أيادي أبي القاسِمِ",136,"م",1,0],["ولا سيما إن كان عندما قدرهم","رفيعاً وأرضاهم بك الخبز والملح",137,"ح",1,0],["وَلا سُدَّ عَن خَيرِ المَساجِدِ بابُهُ","وَأَبوابُهُم إِذ ذاكَ عَنه تُسَدَّد",138,"د",1,0],["ولا سمعوا أَنينَ زهورِ ياف","ولا شكوى حقولِ (البرتقالِ)؟",139,"ل",1,0],["ولا سمعوا عن الأقصى حديث","ينادينا إلى شَدِّ الرِّحالِ؟",139,"ل",1,0],["ولا سيما علم العقيدة أنها الأ","ساس عليه ينبني العبد كلما",140,"م",2,0],["ولاسرائيل لَمَّا أن شكا","ردَّ من يهواه إذ رَدَّ البصر",141,"ر",1,0],["ولا سلا عنه فؤادي وهل","يضل بعد البعد عن رشده",142,"د",2,0],["ولا سمحت بلقيا والدي وأخي","للّه من والدٍ بَرٍّ ومن ولد",143,"د",1,0],["وَلا سُلكت سُبلُ السَماحِ وَلا اهتَدى","إِلى نَهجِ الأَفضالِ في شامنا نَدبُ",144,"ب",1,0],["ولا سَعَتْ بي إلى ما ساءَهُمْ قَدَمُ","كَمْ رُضْتُ نفسيَ بالسُّلوانِ فامتَنَعَتْ",145,"ت",1,0],["ولا سَقى الأطماعَ صوبُ الحَيا","فإنَّها مَهْلَكَةُ الطَّامِعِ",146,"ع",1,0],["ولا سليمانُ ابنُهُ ردَّهَا","بمُلْكِهِ والحشدِ من جُنْدِهِ",147,"د",2,0],["ولأسْمرٍ لدْنِ الكعوبِ وِجارُهُ","حيثُ استَمَرَّ الفكرُ والأوهامُ",148,"م",1,0],["ولا سيما إذا هبَّت شمالٌ","به أو أوْمَضت منه البروق",149,"ق",1,0],["ولا سيَّما إذ شاهد الربع لم يدع","له أهْلُه إلاَّ تِلالاً وأرسما",150,"م",2,0],["ولا سمعت بشيء من مناقبه","إلاَّ انثنيت بما أسمعت نشوانا",151,"ن",2,0],["ولا سَلا قلبي فيمَنْ قد سلا","وحقِّ آياتِ الكتابِ المنزَل",152,"ل",1,0],["ولا سيما من كفّ أحورَ ساحرٍ","بألحاظِه ردّ الخميسَ العرمرما",153,"م",2,0],["ولا سرَتْ نحوكُمُ أسرةٌ","تأسُرُ بالداهيةِ الصّيلَمِ",154,"م",1,0],["ولا سيّما ونحوَكَ كلّ عينٍ","يسارقُ لحظَها نظرُ خفيُّ",155,"ي",1,0],["ولا سقيت ربا الجرعاء من إضم","دمعا غدا يوم سار الحيّ منذر فا",156,"ف",2,0],["ولأَسْطُوَنَّ عَلَى الزمانِ بِعَزْمَتِي","ولأَنْحِيَنَّ عَلَى الخطوبِ بكَلْكَلِي",157,"ل",2,0],["ولاسِيَّما حُرٌّ جَلا لَكَ غَيْمُهُ","نصيحةَ لا وانٍ وإِشفاقَ لا آلِ",158,"ل",1,0],["ولاستَبْدَلَتْ قَرْع النواقيسِ بالضُّحى","مَنارٌ وقامت فِي المحاريب صُلبانُ",159,"ن",1,0],["ولا سكروا بخمرٍ من لماها","ولا بزخارف منها عواث",160,"ث",1,0],["ولا سابق إلا وعقباه لاحق","سبيل الردى كل له فهو سالك",161,"ك",1,0],["ولا سرى في هزيع الليل ريح صب","إلا وحيتك بالأنفاس أزهار",162,"ر",1,0],["ولاستلبت على إضم فؤادي","حماماتٌ تنوح كما تغنِّي",163,"ن",2,0],["ولا سرى عرقُ الإماء فيهمُ","خبائث ليست مَريئات الأُكُلْ",164,"ل",1,0],["ولا سرى مُلكُ بني هاشم","فألحقَ المغرِبَ بالمشرقِ",165,"ق",1,0],["ولا سروح يَغصّ الواديان بها","فيها مُزَكَّى إلي الساعي ومعشورُ",166,"ر",1,0],["ولا سمحتُ لمَلْكٍ قطّ قبلَك باق","تضاءِ رفدٍ ولكن أنت منصورُ",166,"ر",1,0],["ولا سيما عِتابَ أخي عَلاءٍ","سليم العِرْض من عارٍ وعابِ",167,"ب",1,0],["ولا ساجلَتْهُ في النَّوال سحائبٌ","من الوُطْفِ اِلا كان أندى وأغزرا",168,"ر",2,0],["ولأسد الغاب إذا تقنصها","ليلة النفر ظباء المنحنى",169,"ن",2,0],["وَلا سِيَّما مَن كانَ راحى رُضابَهُ","وَنُقلي ثَناياهُ وَزَهري مَجاسِدَه",170,"د",2,0],["ولا سيَّما أن تناءَى الرقيبُ","وأدَّتْ تحيتيَ الاِصْبَعُ",171,"ع",1,0],["ولا سَورةِ الغيرانِ بينَ صِحابهِ","يُسارِقُني لحظَ العدوِّ المراقبِ",172,"ب",1,0],["ولا سحيقُ المسكِ قد حبَّه","في الحيَّ عطارٌ وسحّاقُ",173,"ق",1,0],["ولا سيان في درج المعالي","إذا ميزت مرتفعاً وطاف",174,"ف",1,0],["ولا سرٌّ خفيٌّ في سرائرنا","وطاب بالسرِّ بادينا وخافينا",175,"ن",2,0],["ولا سَمعْتُ سَحَراً رَنينَها","إِلاَّ وَرَنَّتْ بالثَرى دُموعي",176,"ع",2,0],["ولا سطرت على طرس مكاتبة","إلا بدت غرر من فوقها طرر",177,"ر",1,0],["ولاسيما فراق أشم كانت","عقارب رأيه غصص الأفاعي",178,"ع",2,0],["ولا سار في عالي ركائب موكب","ينافس فيه فارس الخيل راجله",179,"ل",2,0],["ولا سلو ولا علو ولكن","لي طلوع مع الهوى ونزول",180,"ل",1,0],["ولا سيَما مَن يَجهلُون مكَانَه","لَدَّى ولَم يَدرُوا لَديه مَكَانِيا",181,"ي",2,0],["ولا سيَما في عهدِ من به عهدُنا","على هامِه تاجُ المفاخِرُ يُعقَدُ",182,"د",1,0],["ولا سمحتُ بعِرْضِي","وقايةً دون مالي",183,"ل",2,0],["ولا سيّرتْ فضلي إليها مغاربٌ","ولا طَيَّرَتْهُ بينهنّ مشارقُ",184,"ق",1,0],["ولا سواءٌ عند ذي إِرْبَةٍ","باطنُ رجلِ المرءِ والمَفْرقُ",185,"ق",1,0],["ولا ساءَني فيك مرّ الزّما","نِ مرأىً ولا رابنِي مَسمَعُ",186,"ع",1,0],["وَلا سقَى اللَّهُ لَنا ظامِئاً","من بعد أن جُنِّبتُمُ الأبحرا",187,"ر",2,0],["وَلا سَقَتكمْ منَ الأنواءِ ساقيةٌ","ولا نَشَحْتُمْ إذا ما معشرٌ نَشَحا",188,"ح",2,0],["وَلا سَمِعنا لِخريقٍ بهِ","صوتاً ولا زَعزَعَةَ النُّكْبِ",189,"ب",1,0],["ولا سفر لا غربة لا إقامة","ولا حضر يوم اللقاء ولا بدو",190,"و",1,0],["ولا سوانا من الأكوان يعرفنا","والغيب نحن وهذا القول إضمار",191,"ر",1,0],["ولا سلم في الدنيا لمستسلم القضا","متى دهمته من أوربا دواهم",192,"م",1,0],["ولا سَقَى الغيثُ دارً مَيَّةَ بال","عَلْيَاءِ كَلاًّ يُدَاكُ والسَّنَدِ",193,"د",1,0],["ولا سيما وَهْوَ مِنْ عَاشِقٍ","رماهُ الهوى وبَراهُ السَّقَمْ",194,"م",1,0],["ولا سيّما لمّا مررتُ بمنزلٍ","كفضلةِ صبرٍ في فؤَادٍ متيَّم",195,"م",1,0],["ولا سِيَّما والصَّاحبُ النَّدبُ صَاحَ بي","إِليكَ فِلي دَلٌّ عليكَ وإِدْلاَل",196,"ل",1,0],["ولا سَقَى دَارَهُ يَوْماً إِذَا سُقِيَتْ","دَاري بِدَمْعي إلّا وابِلُ المَطَرِ",197,"ر",1,0],["وَلَا سِيَّما صَبٌّ يَذُوبُ صَبابةً","بما جلَّ عَنْ حَصْرٍ بِما دَقَّ مِنْ خَصْرِ",198,"ر",1,0],["وَلا سَرتْ مِنْ نَحْوهِ نَسْمةٌ","إلّا عَرفْناها بِرَيَّاكُم",199,"م",1,0],["ولاسيما الأعراب منهم فإنهم","هم الردء للأعدا بتلك الملاحم",200,"م",1,0]]}