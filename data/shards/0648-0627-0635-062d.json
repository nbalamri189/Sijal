"https://www.poetsgate.com/ViewPoem.aspx?id=128716",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[592,"لك الحمد اللهم يا واسع المجد","https://www.poetsgate.com/ViewPoem.aspx?id=128838",""],[592,"ما بال عينيك مثل الهاطل الساري","https://www.poetsgate.com/ViewPoem.aspx?id=128848",""],[592,"سفاسط أملاها الغبي وسطرا","https://www.poetsgate.com/ViewPoem.aspx?id=128722",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5442,"نسم آن أن تسري الرفاق إلى الحمى","https://www.poetsgate.com/ViewPoem.aspx?id=114747",""],[5442,"كل يوم تنوي الرحيل مرارا","https://www.poetsgate.com/ViewPoem.aspx?id=114780",""],[709,"للهِ قَوْمٌ بِأَكْنَافِ الْحِمَى نَزَلُوا","https://www.poetsgate.com/ViewPoem.aspx?id=2921",""],[5583,"يا الله يا لي كل خلقه تساله","https://www.poetsgate.com/ViewPoem.aspx?id=25794",""],[5612,"حجُّ القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=205711",""],[5704,"قُمْ خليلي ...","https://www.poetsgate.com/ViewPoem.aspx?id=198798",""],[5848,"يا لابسين الأقنعة والقناعات","https://www.poetsgate.com/ViewPoem.aspx?id=48843",""],[5866,"لوكان فكري يحمر العين مشلول","https://www.poetsgate.com/ViewPoem.aspx?id=182811",""],[2765,"برح الخفا ما الحق فيه خفاء","https://www.poetsgate.com/ViewPoem.aspx?id=136825",""],[6019,"انتفاضةُ ذات","https://www.poetsgate.com/ViewPoem.aspx?id=174251",""],[6320,"وَخْزُ الرِّمَاح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84350&r=&rc=47",""],[5190,"أُحقِّركُم وأكرَهُكُم جميعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85050&r=&rc=125",""]],"verses":[["وَأَصحَرَت أَعراضُهُم لِلأَذى","تُصرِدُ فيهِنَّ نِبالُ المَرام",0,"م",1,0],["وَأَصحَبُ فيها رِفاقَ السَحا","بِ تَنبو عَنِ البَلَدِ العامِرِ",1,"ر",1,0],["وَأَصحَبُ مِن جَرّاكِ مَن سَكَنِ الفَلا","وَأَشرَقُ مِن ذِكراكِ بالباردِ العَذبِ",2,"ب",1,0],["وأصْحَرْنَ عنْ أدَمٍ يَفْشَعِرُّ","كَما هُنِئَ الجَمَلُ الأجْرَبُ",3,"ب",1,0],["وأصْحَبُ فِتياناً تَراهُمْ منَ الحِجى","كُهولاً وهُمْ في المأْزقِ الضَّنْكِ شُبَّانُ",4,"ن",1,0],["وأصحبت من أبوابهم في خطيطة","ولا ذنب للأبواب مرتٌ جديبها",5,"ب",3,0],["وأصحُّ الآراءِ ما ظنَّ ذُو الأَفْ","نِ بِذي الرأي أنَّهُ مأفونه",6,"ن",2,0],["وأصحُّ من مَلك الرقابَ لمالكٍ","مَلكَ القلوبَ بردِّهِنَّ أوامنا",7,"ن",2,0],["وأصحاب المقارف والمرازي","وأصحاب المزارع والسواقي",8,"ق",2,0],["وأصحبُ منهمْ سائِساً غيرَ حازمٍ","وأتبعُ منهم هادياً غيرَ مهتدي",9,"د",2,0],["وَأَصحابُ الشَقيقَةِ يَومَ لاقَوا","بَني شَيبانَ بَالأَسَلِ الحِرارِ",10,"ر",1,0],["وَأَصحَرَ دونَهُم لِلمَوتِ حَتّى","سَقاهُ المَوتُ مِن مَقِرٍ هَبيدِ",11,"د",1,0],["وَاِصحَب وَذِهنُكَ مِن هَجيرٍ لافِحٍ","ذِكراً كَما سَرَتِ القَبولُ بَليلا",12,"ل",2,0],["وَأَصحابُ الشَريفِ وَلا تَساوٍ","كَأَصحابِ اِبنِ زَرعَةَ وَاِبنِ سَمحِ",13,"ح",1,0],["وَاصْحَبُوهالِتُرْبَتي، فَعِظامي","تَشْتَهي أنْتَدُوسَهَا قَدَمَاهَا",14,"ا",3,0],["وأصْحَرْتُ عن قلبي فكان تكالُبٌ","عليّ لإصحاري وكان تواكُل",15,"ل",1,0],["وَأصْحابُ الشّقِيقَةِ يَوْمَ لاقَوْا","بعني شَيْبانَ بِالأسَلِ الحِرَارِ",16,"ر",1,0],["واصحب شريف الاصل مصحوب التقى","فالمرء منجذب الى اشكاله",17,"ل",2,0],["وأصحو إذا الحادي تغنى بمدحكم","وأسكر في معنى ثناكم بلا خمر",18,"ر",1,0],["وأصحاب الرسول ذوي المعالي","عليهم رحمة الرب القوي",19,"ي",1,0],["وأصحاب وأولد كرام","بهم قمري روض السعد غرد",20,"د",1,0],["وأصحاب وأتباع وآل","به فازوا برؤية ليل قدر",21,"ر",1,0],["وأصحاب وأتباع وآل","وأزواج النبي الطاهرات",22,"ت",1,0],["واصحب موات لا يبطن مستو","سرفاً يباعد لا يقاتر درهما",23,"م",2,0],["واصحب لحرّ إذ تلوم يقيمه","واصحب نسيباً لا يبدل معتما",23,"م",2,0],["واصحب خياراً فالخيار تعز من","يدنو لها وبصحبة لن تكلما",23,"م",2,0],["وَأَصحابهُ لا يبلغ الناسُ مدَّهم","وَلا نِصفهُ لو أنفقوا أُحداً تبرا",24,"ر",2,0],["وَأَصحابُ الجَيشِ العَرَمرَم فارِساً","في الخَيلِ أَشهَدُ كَرَّها وَطِرادَها",25,"د",3,0],["واصح وافتح طرفا مريضا صحيحا","إن قلبي يهوى المراض الصحاحا",26,"ح",2,0],["واصحبْ إذا اعتكرَ الظلامُ مصمّماً","سالتْ بصفحته دموعُ الجوهر",27,"ر",1,0],["واصحابه القوم الكرام كأنهم","وقد اشرقوا في ذروة المجد انجم",28,"م",1,0],["واصحابه بالفضل في كل مشهد","حديثهم يفني الزمان ولا يفنى",29,"ن",2,0],["واصحابه الرهط الكرام أولو التقى","فاكرم بهم صحبا واكرم بهم رهطا",30,"ط",2,0],["وَأَصحابُ صِدقٍ بِأَرضِ الحِجازِ","غَدا جَميعُ شَملي بِهِم لا يرام",31,"م",1,0],["وأصحب قلبي الأمن صحبة ذي ظما","رأي بعد خمس عذب ماء فراته",32,"ت",2,0],["واصحب اليأس عنهم طمعا","ان رجائي شفيع محرمه",33,"م",2,0],["وأصحب آمالي الأمير محمداً","ليروي صداها وبله وانهماره",34,"ر",2,0],["واصحبني الهوى والبين جفنا","معينا جادم الماء المعين",35,"ن",1,0],["واصحب الصبر وان","مج شرابا وطعاما",36,"م",2,0],["واصحب الدهر بالعفا فتقوي","النفس من عادة الكريم النفيس",37,"س",1,0],["واصحباني إلى تلقيه بال","أيدي اللواتي يحملن كوباً وكوزا",38,"ز",2,0],["واصحبه الصبر المرير مذاقه","وربما يحلو لك الصبر صاحبا",39,"ب",2,0],["واصحابه والوالدين وان علوا","وَقرباه والولدان أَسفل اسفل",40,"ل",1,0],["وأصحب آمالي إِلى فضل جوده","وأنزل حاجاتي بِمَن لَيسَ يبخل",41,"ل",1,0],["وَاِصحَب ذَوي المَعروفِ وَالعِلمِ وَالهُدى","وَجانِب وَلا تَصحَب هَدِيَّتَ مَنِ اِفتَتَنِ",42,"ن",1,0],["وأصحابه الغر الكرام أثمة","مهاجرهم والقائمون بنصرة",43,"ه",1,0],["واصحب العز ظافراً بالأماني","واترك العصبة العدا مفلوله",44,"ل",2,0],["وأصْحابُهُ كُلُّ عَبْلِ الذِّراعِ","أَصَابِعُ راحتهِ أَذْرُعُ",45,"ع",1,0],["وَأَصحَبُ الشَعثَ طَوّافاً بِكَعبَتِكُم","ما لَمَمتُ لِإِلمامي بِها شَعثي",46,"ث",2,0],["وأصحبْتُه مَن لم أَلِدْه وحُبُّه","من العِزّ حبٌّ الأكرمِين من الوُلْد",47,"د",1,0],["وأصحبته عذراً إليّ كأنما","يعدُّ جزيلَ المكرُمات من الذنب",48,"ب",1,0],["واصحب الرحمن لا تصحب سواه","واسأل الرحمن تظفر بالنوال",49,"ل",1,0],["واصحب الرفق ولا تعدل به","فهو كاللطف به الخير ينال",50,"ل",1,0],["وأصحابه والآل والتابعين ما","تنفس شخص أوحد بالركائب",51,"ب",1,0],["وأصحَابُها صَرعى بِبُرقَةِ أَخرَبٍ","تُجرِّرُهُم ضِبعَانُها ونُسورُها",52,"ر",3,0],["وأصحبُ كلّ مُبْيضّ السجايا","وجنح الليل مسودّ الإهاب",53,"ب",1,0],["وأصحبني بمن ترضى","وتقلبه من الصحب",54,"ب",1,0],["وأصحابه الغر الميامين إنها","لها الفضل في الإسلام والسعد واليمن",55,"ن",1,0],["وأصحابه الغر والتابعين","مدى ما حدا الظعن حادي النياق",56,"ق",1,0],["وأصحاب عزم لم تخنهم حلومهم","وأجناد عز في الجهاد المحوزِ",57,"ز",1,0],["واصحب مدى الأيّام ما عُدَّتْ مدىً","واسلم إذا أفنت عزيزاً مقبلا",58,"ل",2,0],["واصحبوا أيّامَكم واستخدموا","في المعالي هُجنَها والصُّرَحا",59,"ح",2,0],["واصحبْ من النَّيروزِ يوماً يفِي","بالعزّ إن خان الأصاحيبُ",60,"ب",1,0],["واصْحَبْ أُناساً همُّهُمْ خَلاَّقُهُمْ","ولهم إليه بروحِهِمْ إِسْراءُ",61,"ا",2,0],["واصْحَبِ الأَسخِياءَ للهِ فالنَّا","سُ صُنوفٌ أبرُّها الأَسخِياءُ",62,"ا",2,0],["وَاِصحُ كي تُدرك الثّوابَ فكلّ ال","ناسِ في هذه الخطوبِ سُكارى",63,"ر",2,0],["وأصحابه الغر أهل التقى","كواكب فضل إليها يؤم",64,"م",1,0],["وأصحابه والآل مع كل تابعٍ","وتابعهم ما ناح طير وغردا",65,"د",2,0],["وأصحابه والآل ما ماض بارق","وما انهل صوب المدجنات الغواديا",66,"ي",2,0],["وأصحابه والآل ما عاذ والتجا","بعزك يا ذا الكبرياء والمراحم",67,"م",1,0],["وأصحابه والآل مع كل تابعٍ","وتابعهم ما انهل ودق الغمائم",68,"م",1,0],["واصحر للطعن السماك برمحه","ولاذ أخوه أعزلاً بفرار",69,"ر",1,0],["واصحَبَنَّ التُّقَى أمامكَ مصبا","حاً لتجلو ظلامَ تلكَ الليالي",70,"ل",2,0],["وَاصحب بِطُول الدَهر بين أَولى النُهى","طوسناً سَليلك سَيد الأَمراء",71,"ا",2,0],["وَأَصَحُّ كُتبهم عَلى المَشهورِ ما","جَمَعَ البُخاري قالَ ذاكَ المُعظَمُ",72,"م",1,0],["وأصحب من ركب الحجاز لقبره","رجالاً لهم في الصدق بانت مقاصدُ",73,"د",1,0],["وأصحابها في الدجى والضحى","لتلبية المستغيث حضور",74,"ر",1,0],["وأصحابها في تريك الحديد","عليهم دروع بها يتقى",74,"ق",2,0],["وأصحابِ العكاكيزِ","وأصحابِ العثابين",75,"ن",1,0],["وأصحابه الغر الكرام ومن لهم","وقائع صدقٍ في حنينٍ وفي بدر",76,"ر",1,0],["واصحبْ بني الدهر والزمان وكنْ","لما يُريكَ الزمانُ حمَّالا",77,"ل",2,0],["وأصحابهم ثم أنصارهم","من الناس مِنْ كل عبد شكور",78,"ر",1,0],["واصحبْ لدنياكَ كلَّ مكرُمةٍ","نهارَ هاء والآصالَ والغَلَسا",79,"س",2,0],["وأصحاب له كبروق خطف","يصبُّون القضا خيراً وشرَّا",80,"ر",2,0],["واصحب اغصاناً وألحظ ربربا","وأغمز عنابا وأنشق عنبرا",81,"ا",1,0],["وَأَصحَابه سمِّ العِدَى أَنجُم