مفترس...","https://www.poetsgate.com/ViewPoem.aspx?id=208994",""],[5484,"روع الكون وادلهم السماء","https://www.poetsgate.com/ViewPoem.aspx?id=206305",""],[5690,"لطيفة العصر قد وافتك سافرة","https://www.poetsgate.com/ViewPoem.aspx?id=172282",""],[5759,"نشيدُ الغُربة","https://www.poetsgate.com/ViewPoem.aspx?id=214175",""],[5809,"رضا","https://www.poetsgate.com/ViewPoem.aspx?id=205332",""],[5956,"ذكرى حبي الأول","https://www.poetsgate.com/ViewPoem.aspx?id=196838",""],[5956,"نجْلي فراس الطاهرُ الرُّوحاني","https://www.poetsgate.com/ViewPoem.aspx?id=215496",""],[5989,"ما كنتُ بدعاً من العاشقين","https://www.poetsgate.com/ViewPoem.aspx?id=183969",""],[6102,"فَ.......","https://www.poetsgate.com/ViewPoem.aspx?id=184545",""],[6102,"أُمنِياتٌ بَريئَة !!","https://www.poetsgate.com/ViewPoem.aspx?id=211861",""]],"verses":[["كَنزوا الكُنوزَ وَأَغفَلَوا شَهَواتِهِم","فَالأَرضُ تَشبَعُ وَالبُطونُ غِراثُ",0,"ث",1,0],["كنْزُ المَعارِفِ لا تَبيدُ نُقودُه","يوْماً ولا تَفْنَى علَى الإنْفاقِ",1,"ق",1,0],["كن زوج للتوب لاكن","لم تكن عندي بماهر",2,"ر",1,0],["كنز لو استشفوا به من دائهم","لتوجّروا منه الدواء الشافي",3,"ف",2,0],["كنزُ حياةٍ كانَ أنفقتُهُ","على تصاريفَ تصرَّفْتُها",4,"ت",3,0],["كَنَز اللَه في كنيزةَ نتناً","خالص النوع ليس مما يُغشُّ",5,"ش",1,1],["كُن زَهرَةً أَو نَغمَةً في زَهرَةٍ","فَالمَجدُ لِلأَزهار وَالنَغَماتِ",6,"ت",1,0],["كَنزٌ بِحُلوانَ عِندَ اللَهِ نَطلُبُهُ","خَيرَ الوَدائِعِ مِن خَيرِ المُؤَدّينا",7,"ن",2,0],["كَنزُ ذِكرٍ يَزيدُ فيهِ نَماءً","أَن تُجيدوا حِباءَكُم لِمُجيدِه",8,"د",2,0],["كنزٌ بهِ ظفرتْ يدي","والكتمُ مِنْ شرطِ الكنوزِ",9,"ز",1,0],["كَنْزَ البيانِ فمن تَطَلَّبَ لِلغنَى","كنزاً سواه قَضَى الحياةَ عديما",10,"م",2,0],["كَنزٌ مِنَ الآيِ الرَوائِعِ مُنزَلٌ","باقٍ عَلى الأَيّامِ غَيرَ مُضَيَّعِ",11,"ع",1,0],["كَنزانِ ذُخرُهُما يَوؤُمُّكَ نَفعُهُ","عِندَ اِختِلافِ مَواضِعِ الآجارِ",12,"ر",1,0],["كَنْزُ الْكَرِيمِ مُوْلِي النِّعَمِ","هَادِي الأُمَمِ لِشَرِيعَتِهِ",13,"ت",2,0],["كنزُ أحلامِكَ يا شاعرُ في هذا المكانِ","سحرُ أنغامِكَ طوَّافٌ بهاتيكَ المغاني",14,"ي",1,1],["كنزٌ عليه نُقب الجدار","ورُقيتْ بالسارقين الدار",15,"ر",1,0],["كنزا يضمّ لباناتي منوّرة","وما اطمأنّ من النّعمى وما شردا",16,"د",2,0],["كنز الحنيفة من حبّ ومرحمة","كالنور قد غمر الدّنيا وما نفدا",16,"د",2,0],["كنز رعته بعطفها السَ","امي، فلم يذهب سدى",17,"د",2,0],["كنز من الفكر فيه كلُّ مبتكرٍ","أملاه ذهنٌ كومض البرق وقَّاد",18,"د",1,0],["كَنْزُ الْكَرَمِ مُوْلِي النِّعَمِ","هادي الأممِ لشريعتهِ",19,"ت",2,0],["كنزانِ مِن مُتَع الدُنيا يُقِلُّهُما","جمُّ الندى سَرِفٌ في زيِّ مُقتَصِد",20,"د",1,0],["كنز الحياء وفياض العطاء ونبر","اس الوفاء ومن بالله ولهان",21,"ن",1,0],["كنز المناقب تاج ارباب الوحا","والنير المجلى بكل مقام",22,"م",1,0],["كنز المقل سلاح الخائف الوجل","مدح الامام أمير المؤمنين علي",23,"ل",2,1],["كنز الوجود مطلسم","والعقل عن فحواه قاصر",24,"ر",1,0],["كنز الامداد ومظهره","سر الارشاد مهنده",25,"د",2,0],["كنز المفاخر في بني الصياديل","اسد الكتائب وافر الغارات",26,"ت",1,0],["كنز تركنا وعين الله تحرسه","إن ساعد الحظ نلقاه ويلقانا",27,"ن",2,0],["كنزُ درّ قد فاقَ فهو يتيمٌ","وعليهِ جميعهُم أوصياءُ",28,"ا",2,0],["كنز هو المختار فيه تجمعت","سبل الهداية ياله من مجمع",29,"ع",1,0],["كنز المفاخر بحر الجود وافره","وليس يعلم شخص أين ساحله",30,"ل",2,0],["كنز الفضائل منزل التقوى الذي","هو في المعاد إمامه وزعيمه",31,"م",2,0],["كَنْزُ الْغِنَى هُوَ وَالْعَنَا","مِمَّا تَبَايُنُهُ مُؤَبَّدْ",32,"د",1,0],["كنز المَعارف عدل الدين لا برحت","آثاره للهدىنورا وَبرهانا",33,"ن",2,0],["كنز المَعارف منبع الحكم الَّذي","آراؤه شهب يقدن وقودا",34,"د",2,0],["كُنْ زائِراً بِالصِّدقِ فيهِ ذَوِي الهوَى","وَلكَ الزُّبيرُ وَصِهْرُهُ الصِّدِّيقُ",35,"ق",1,0],["كنز غَيب كان في غين الخَفا","فَبدا لِلعَين بِالذات البَهيّه",36,"ي",2,0],["كنز شَمس الراح مبسمه","بِسُيوف اللَحظ مَرصودُ",37,"د",1,0],["كَنزْتُك في بَطْنِ التُّرابِ نفاسةً","وأعززْ به كنزاً لآخِرتي يُقْنى",38,"ن",2,0],["كنز القناعة متاعه فاض منها وعاه","تجرع الصبر أيام البقا والحياه",39,"ا",2,0],["كنزُ حياةٍ لي أنفقْتُهُ","على تصاريفَ تصرَّفْتُها",40,"ا",1,0],["كَنزُ المَحامِدِ وَالتَقوى دَفاتِرُهُ","وَلَيسَ مِن كَنزِهِ الأَوراقُ وَالذَهَبُ",41,"ب",1,0],["كَنَزْتُمْ من الفِعل الجميل صنائعاً","وقد تنفدُ الدُّنيا وليسَ بنافد",42,"د",1,0],["كنزوا المالَ للخُطوبِ وذمي","لهم من أشد خَطْبٍ أشدُّ",43,"د",1,0],["كنزاً عظيماً يرى في عرش مملكتي","من باع شهواته واختار عُبّادي",44,"د",2,0],["كنز الحقائق تاج أقطاب الأمم","خضعت له عرب المشيخ والعجم",45,"م",1,0],["كَنَزوا الوجدَ بأَلبابٍ لنا","فهوَ فيها دائِماً يلتَطِمُ",46,"م",1,0],["كنزٌ من العِرْفانِ صِينَ برَوْنَقٍ","بَرَكاتُهُ بأُولي النُّهى لم تُجهَلِ",47,"ل",1,0],["كنزُها جوهرُها ياقوتُها","قوتُها قوّتُها خمسُ قَواها",48,"ا",3,0],["كَنْزُ العُلومِ الذي يَغنَى الفقيرُ بهِ","منَ العطَايا ويَبقَى فوقُ ما ذَهَبا",49,"ب",2,0],["كَنْزٌ ذَخرناهُ لنا فاغتالَهُ","لِصُّ المنيةِ خاطفاً مُتَمرِّدا",50,"د",2,0],["كنز اللهى ما راى جيدا وقد عطلا","الا وزينه من جوده بحلى",51,"ل",2,0],["كنز الصلاح وكهف للعفاة لذا","أبوابَ فضلك كل الناس قد قرعت",52,"ت",1,0],["كنز نفيس ولكن لا نفاد لهُ","وقد تلألأ نور منه ما كسفا",53,"ف",2,0],["كنز الكنوز على الكنوز وفاته","إن الدنى ليست ديار بقاء",54,"ا",2,0],["كَنْزٌ مِنَ الْحُبِّ قَدْ حُطَّتْ رَوَاحِلُهُ","عِنْدَ الرَّئِيسِ فَلا زَيفٌ وَلاَ بَرَمُ",55,"م",1,0],["كنز عرفانهم يَزيد إِذا ما","أَنفقوه في الرَأي وَالتَعليم",56,"م",1,0],["كنزتَ الأَجرَ وَالأَمداح لمّا","رأيتَ لغيرك الدُنيا اِكتنازا",57,"ز",2,0],["كنزُ الملاحةِ لم يَزَلْ مُسْتُوْدَعَاً","في وجنتيه فحبَّذا من كنز",58,"ز",1,0],["كَنَزَ المجدَ هاشمٌ دون ذا الخل","ق وأَحْرَزْتُمُ على الخلقِ كَنْزَه",59,"ز",2,0],["كَنزُ القَناعَةِ كَنزٌ لا نَفادَ لهُ","وَراحَةُ المَرء تَقفو زُهدَه وتَلي",60,"ل",2,0],["كَنَزت دِماءَ القَلبِ في القَلبِ حافظاً","لِعلمي يَكونُ القَلبُ بِالحفظِ مَنعوتا",61,"ت",2,1],["كَنَزتُ لِعزِّ النّفسِ كُلَّ قَناعَةٍ","وَلَيسَت تُعَزُّ النّفس إِلّا بِذا الكنزِ",62,"ز",1,0],["كَنزُ العلومِ الجَوهَريِّ المحتوي","دُرَّ البلاغَةِ في النّظامِ الأَفخَرِ",63,"ر",1,0],["كنز مدح ليسَ يفنى أبداً","هل لهَا يحصل ما قد وهبا",64,"ب",2,0],["كنز اللوامع برهان الطوالع مفتاح","المطالع مصباح المقامات",65,"ت",1,0],["كنز القناعة كنز لا نفاذ له","وملكه عزّ أن يستخدم الخدما",6