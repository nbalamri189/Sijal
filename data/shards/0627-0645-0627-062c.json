{"poems":[[79,"لله درك من أخ","https://www.aldiwan.net/poem36335.html","مجزوء الكامل"],[95,"إن التي تجلت علياً أنجبت","https://www.aldiwan.net/poem11141.html","الكامل"],[95,"ألتاج تاج مملكين عظام","https://www.aldiwan.net/poem11386.html","الكامل"],[95,"نينت حظك في الحياة جميل","https://www.aldiwan.net/poem11474.html","الكامل"],[91,"في الصدر حتى كدت تردى","https://www.aldiwan.net/poem44868.html","مجزوء الكامل"],[64,"فؤاد على كر الحوادث مارد","https://www.aldiwan.net/poem52454.html","الطويل"],[104,"بيض الحمائم حسبهنه","https://www.aldiwan.net/poem33133.html","مجزوء الكامل"],[52,"وهبت لنا يا فتى منقر","https://www.aldiwan.net/poem62288.html","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[79,"خَطْبٌ ألمَّ فأذْهبَ الأخ والأبا","https://www.poetsgate.com/ViewPoem.aspx?id=33306",""],[164,"كلات ودين الله أفضل ما تكلا","https://www.aldiwan.net/poem59159.html","الطويل"],[173,"أبت نوب الأيام إلا تماديا","https://www.aldiwan.net/poem1691.html",""],[199,"ألا رب لهو آنس ولذاذة","https://www.aldiwan.net/poem54397.html","الطويل"],[275,"جردت من تلك الجفون سيوفا","https://www.aldiwan.net/poem35430.html","الكامل"],[276,"أرى برق الغوير اذا تراءى","https://www.aldiwan.net/poem52103.html","الوافر"],[280,"كأن كتائب الباغين حزن","https://www.aldiwan.net/poem25543.html","الوافر"],[299,"لعن الإله الناس إلا مسلما","https://www.aldiwan.net/poem1748.html","الكامل"],[310,"العدل عهد خلافة الإنسان","https://www.aldiwan.net/poem56394.html","الكامل"],[369,"نزل الأحبة خطة الأعداء","https://www.aldiwan.net/poem61017.html","الكامل"],[422,"باكر نداماك بكأس العقار","https://www.aldiwan.net/poem53938.html","السريع"],[463,"قالوا رضيت قلت ما أجدى الغضب","https://www.aldiwan.net/poem56298.html","الرجز"],[510,"تائية القافلة","https://www.aldiwan.net/poem27889.html","البسيط"],[510,"المُحتلّ","https://www.aldiwan.net/poem42460.html","الهزج"],[520,"من أجل هيبة ذا المقام المذهل","https://www.aldiwan.net/poem12202.html","الكامل"],[556,"شد غروض المطي مغتربا","https://www.aldiwan.net/poem48085.html","المنسرح"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138254",""],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126815","البسيط"],[673,"","https://poetry.dctabudhabi.ae/diwan/poem/137334",""],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112443","الكامل"],[865,"","https://poetry.dctabudhabi.ae/diwan/poem/100581","الطويل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145888","البسيط"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105471","البسيط"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105464","البسيط"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25362","الرجز"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56184","الوافر"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117442","البسيط"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77851","الهزج"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100955","الوافر"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101045","الوافر"],[2137,"","https://poetry.dctabudhabi.ae/diwan/poem/144581","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53073","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77335","البسيط"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104983","البسيط"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124763","الطويل"],[2521,"","https://poetry.dctabudhabi.ae/diwan/poem/110672","البسيط"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87733","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87318","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87331","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87327","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65962","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199997","المجتث"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87366","الطويل"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100173","البسيط"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59488","الطويل"],[3906,"","https://poetry.dctabudhabi.ae/diwan/poem/199407","الوافر"],[3968,"","https://poetry.dctabudhabi.ae/diwan/poem/105264","الطويل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125867","الطويل"],[4142,"","https://poetry.dctabudhabi.ae/diwan/poem/101332","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90846","الطويل"],[4258,"","https://poetry.dctabudhabi.ae/diwan/poem/18989","البسيط"],[4265,"","https://poetry.dctabudhabi.ae/diwan/poem/138723","البسيط"],[4297,"","https://poetry.dctabudhabi.ae/diwan/poem/102206","الوافر"],[4336,"","https://poetry.dctabudhabi.ae/diwan/poem/97540","السريع"],[4718,"ىتاخذ الدنيا على ماخذ الجد","https://www.poetsgate.com/ViewPoem.aspx?id=137213",""],[4767,"الفرحة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=91838",""],[4778,"لله نحن حرائرٌ وعبيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=188377",""],[4858,"كيف السّرور؟","https://www.poetsgate.com/ViewPoem.aspx?id=30639",""],[4927,"ضِيم الكرام","https://www.poetsgate.com/ViewPoem.aspx?id=80798",""],[4955,"لا تفعل الخير كي تحظى بمكرمة","https://www.poetsgate.com/ViewPoem.aspx?id=200212",""],[5296,"حروف العُرْب","https://www.poetsgate.com/ViewPoem.aspx?id=155352",""],[592,"ألا قل لأهل الجهل من كل من قد طغى","https://www.poetsgate.com/ViewPoem.aspx?id=128809",""],[5490,"نساء","https://www.poetsgate.com/ViewPoem.aspx?id=176174",""],[5596,"هجران شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=206190",""]],"verses":[["إمَّا جَنَحْتَ لِوُدِّهِ الضَّا","حِي فَدَوْحُ الْعَهْدِ مَائِل",0,"ل",1,0],["أَمَا جُرِحْتَ بِحَيْثُ لا تَأْسُو يَدٌ","فَجِرَاحُ نَفْسِكَ بِرْؤُهَا مِنْ عِنْدِهِ",1,"د",2,0],["أَمَّا جُلُوسُكَ فَهْوَ أًَوْفَى بَهْجَةٍ","وَأَحَقُّ بِالإِكْبَارِ وَالأَفْخَامِ",2,"م",1,0],["أَمَّا جَمِيلُ فهْوَ مَا تَبْغِي العُلَى","لَبِقٌ عِصَامِيُّ المَضَاءِ نَبِيلُ",3,"ل",1,0],["اما جبين القوم فهو من","الصفاقة ليس يندى",4,"د",2,0],["أما جرّدُوه مقضباً وهو ناشِئٌ","أما جَرَّبوه مقنباً وهو واحدُ",5,"د",1,0],["أمَّا جميلُ المحسنا","ت ففي النهار وفي الدجنّه",6,"ن",2,0],["أَمَ اَجعَلُ مِن جِلدِها حَنبلاً","فَأَقذِر بِحَنبَلِها حَنبَلا",7,"ل",2,0],["أَمَّا جَزَالَتُهُ فَغَايَةُ مَا انْتَهَتْ","شَرَفاً إِليْهِ جَزَالَةُ الفُصَحَاءِ",8,"ا",2,0],["إمّا جزِعْت له فَعُذْرٌ بيِّنٌ","قضَتِ الدَّواهي أن تُحَلّ له الحُبا",9,"ب",2,0],["أما جاهدوا في الله حق جهاده","خطاب لنا من ربنا عمم الكلا",10,"ل",2,0],["أَما جَرَّبَتني في الأُمُورِ فَصادَفَت","هُماماً لِأَحداثِ المُهِمّاتِ كافيا",11,"ي",2,0],["أَماجِدُ أَنَّ القَلبَ رَهنٌ مُتَيَّمٌ","بِهِ سَقَمٌ أَعيا الأَطِبَّةَ مُضمَرُ",12,"ر",1,0],["أما جمالُكِ فهو نارٌ طهَّرت","دَنسَ القلوبِ لذاكَ صرتُ عفيفا",13,"ف",2,0],["اما جبريل روح اللَه وجدا","بمن تحت الكَسا ورد الكساء",14,"ا",2,0],["أمَاجِدُ بينَ أنْسابٍ قِصَارٍ","تَفَاخُرُهم وبَيْن قَناً طوالِ",15,"ل",1,0],["إما جنيتُ عليه حرباً حاطني","ولجأت تحت لبان ليثٍ مُخدر",16,"ر",1,0],["إِمّا جليّاً طبقَ نازلةٍ عرَت","أَو باطناً لملمّةٍ لم تانِ",17,"ن",1,0],["أمّا جَداكَ فمِن فِنائك قد سَرى","حتّى أتاني نازلاً بِفنائي",18,"ا",2,0],["أمَّا جميل الصّنع منه فمِن","شعاره أَكرِمْ به من شعار",19,"ر",1,0],["أَمَا جَنَى خيرا له آدابُهُ","أعاذكُنَّ اللّهُ مِن شرِّ الأدبْ",20,"ب",1,0],["إمّا جِنانٌ نعيمُها مُقيمٌ أوْ","عذابُ نارِ لهُم في مرِّها قوْتُ",21,"ت",1,0],["أما جاورتَ في أيّا","مه الطاعونَ والسّلّا؟",22,"ل",2,0],["أما جراحك يا زمان فإنها اندمل","ت ولكن بعد حز المفصل",23,"ل",1,0],["إِمّا جبيناً بالتُّرب منعفراً","أو وَدَجاً بالنَّجيع مُنسكبا",24,"ب",2,0],["أماجد أمراء عن أب ورثوا","فضلا ونبلا مع الإحسان والجود",25,"د",1,0],["أماجد كان يوم الحَرب عيدهمُ","والموتُ عندهم أحلى من العسلِ",26,"ل",1,0],["أمَّا جَناحاها فلا تطويهما","حتى يكونا للهوا مِيزانا",27,"ن",2,0],["أما جداولها فذائب فضة","بلجيها تتطلع الأزهار",28,"ر",1,0],["أماجد أما مالهم فهو في الندى","مباح وأما عرضهم فهو في كهف",29,"ف",1,0],["أما جرائمُهُ صارت مداعبةً","أما الرصاصُ فقد أمسى رياحيا",30,"ي",2,0],["أماجد تهب النعماء أنملها","من قبل أن ترد المغني لتسألها",31,"ل",3,0],["أماجد جددوا في كل منزلةٍ","من كل مكرمةٍ ما رث أو دثرا",32,"ر",2,0],["أَما جَزاءُ العارِفِ المُسْتَيْقِنِ","عِنْدَكِ إِلَّا حاجَةُ التَفَكُّنِ",33,"ن",1,0],["أماجيد كرامٌ نعم شهب","بدور لا عراها الاغتيابُ",34,"ب",1,0],["إما جهولٌ فلا يدري مواقِعَهُ","أو فاضلٌ فهو لا يخلو من الحَسَدِ",35,"د",1,0],["أَما جاراتنا الحور","أَما الساقي سمسار",36,"ر",1,0],["أماجدُ من بني مصر استجابوا","إلى الخيرات واحتسبوا الثوابا",37,"ب",2,0],["أم اجترأت عليه يد العوادي","فغالته اجتراء واجتراما",38,"م",2,0],["أم اجتُليَ الجمالُ عليك غُفْلاً","فحُكتَ له طرازاً مُستجدّا؟",39,"د",2,0],["أما جهادكُمُ فقد أمست به","أسد الفرنج أذلّ من ضب الكَدا",40,"د",2,0],["أم أجمَعَ العلمَاءُ والعُقَلاءُ مِن","أهلِ اللِّسَانِ وأهلِ كُلٍّ لِسَانِ",41,"ن",1,0],["أما جميلات الوجوه فخائنا","ت بعولهن وهن للأخدان",41,"ن",1,0],["أَم أَجمَعَت لِقِتالِ المُصطَفى فِئَةٌ","أَو سارَ جَيشٌ عَلَيهِ الطَيرُ لَم تَحُمِ",42,"م",1,0],["أما جد بذلوا الله أنفسهم","وتاجروا الله أعماراً فما خسروا",43,"ر",3,0],["أما جاءكم عن ربكم وتزودوا","فما عذر من وافاه غير مزود",44,"د",1,0],["أماجد إن جرت يوما إلى أمد","إلى المكارم أعيت من يجاريها",45,"ي",3,0],["أَما جالدوا في الحَقِ قِدما وَجاهَدوا","أَما قَطّعت في اللَه مِنهُم سَواعد",46,"د",1,0],["أَمَّا جزيره مُلَكِي قاسوها","بإصبَعين ونصفِ جَرَّبوها",47,"ه",2,0],["أما جبالُ كُنكنٍ رِفاعَا","تَنظُرُهَا مِن أربعينَ بَاعَا",48,"ع",2,0],["أمَّا جبالُ المُلِّ عالِيَاتُ","مسيرَ يَومَين في البُرورِ ياتُوا",49,"ت",3,0],["أمَّا جَنُوبي كِلوَةِ هَسوَاندُو","ألكُلُّ عَنكَ في اليَسَارِ يَبدُو",50,"و",1,0],["أما جزت أجوازاً أما رمت أنجداً","أما خضت أهوالاً وهنَّ كوانس",51,"س",1,0],["أما جعلت بفقري","له مقاماً وأمرا",52,"ر",2,0],["أَما جدُ صيدٌ من كرام الوجود من","عَشائر لبنانٍ أُلي النهي والامرِ",53,"ر",1,0],["أماجد بلغاء أصبحت بهم","على جميع البرايا تفخر العرب",54,"ب",1,0],["أما جرَّرَت فيك الغواني ذُيولهَا","ألم تك مأنوسا ببيضٍ عقائلِ",55,"ل",1,0],["أَما جَرَّبْتِ يا أَيامُ مِنّي","فَرُوكَ تَجَمُّعٍ وحَليفَ شَتِّ",56,"ت",1,0],["أماجد قد فاقوا البرية مثل ما","تفوق الليالي كلها ليلة القدر",57,"ر",1,0],["أماجدُ إنَّ الحزنَ حزنانِ فَقْدُ مَنْ","فقدنا وثُكْلٌ في فؤادِكَ دائم",58,"م",1,0],["أماجد من عليا علي بن جعفر","متى عدت الاشراف كانت كرامها",59,"م",3,0],["أماجد أرثا من سراة ولم يزل","إلى الابن سر الأرض يسري من الجد",60,"د",1,0],["إِمّا جَديداً وَإِمّا بالِياً خَلَقاً","عادَ العَذارى لِقَطعيهِ بِأَسيارِ",61,"ر",1,0],["أماجد ما بها ذل لمهتضم","لا تطرق الأسد خوفا أرض ربعهم",62,"م",1,0],["أما جد قد توارثت المعالي","أمام في العلى يقفو إماما",63,"م",2,0],["إمّا جهولٌ أبلهٌ متعبٌ","أَو فطنٌ مِن كيدهِ لا يُجيب",64,"ب",1,0],["اما جوابٍ يفرح القلب ويسد","ولاتلعثم بالجواب اومسده",65,"د",2,0],["أما جادت قريحتكم","بشيء يثلج الصدرا",66,"ر",2,1],["إمّا جنان فيها لا عين رأت","أو نصلى نارا والمقام خلود",67,"د",1,0],["أمّا جنودُ الحقّ فاعلم أنّهم في الفائزين","فاللهُ راضٍ عنهمُ وهمُ رضُوا دنيا ودين",68,"ن",1,0],["أَمَّاْ جُدُوْدُهُمُ: فَجَدٌّ سَاْقِطٌ","وَمُقَاْمِرٌ مُتَمَتِّعٌ زَنَّاْءُ",69,"ا",2,0],["إمَّا جعلتَ همومَ النَّفسَ شهرتَها","فاعلم بأنَّك خاوٍ حينَ تلقاهُ",70,"ه",1,0],["أم اجتمعت لتروي لي","حكاية عاشقٍ يُصرع؟",71,"ع",1,0],["أما جاء آيات تدل بأنه","إذا لم يهاجر مستطيع فإنما",72,"م",2,0],["أما جُعلت في حشايَ الحياةُ","وفي جوفها يستقرّ الفناء؟",73,"ا",2,0],["أم اجتُثّٓ عود الشعر أم جفّ أم جفا","أم النوءُ ناءى والسحائب والقطر",74,"ر",1,0]]}