{"poems":[[79,"لله درك من أخ","https://www.aldiwan.net/poem36335.html","مجزوء الكامل"],[95,"إن التي تجلت علياً أنجبت","https://www.aldiwan.net/poem11141.html","الكامل"],[95,"ألتاج تاج مملكين عظام","https://www.aldiwan.net/poem11386.html","الكامل"],[95,"نينت حظك في الحياة جميل","https://www.aldiwan.net/poem11474.html","الكامل"],[91,"في الصدر حتى كدت تردى","https://www.aldiwan.net/poem44868.html","مجزوء الكامل"],[64,"فؤاد على كر الحوادث مارد","https://www.aldiwan.net/poem52454.html","الطويل"],[104,"بيض الحمائم حسبهنه","https://www.aldiwan.net/poem33133.html","مجزوء الكامل"],[52,"وهبت لنا يا فتى منقر","https://www.aldiwan.net/poem62288.html","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[79,"خَطْبٌ ألمَّ فأذْهبَ الأخ والأبا","https://www.poetsgate.com/ViewPoem.aspx?id=33306",""],[163,"كلات ودين الله أفضل ما تكلا","https://www.aldiwan.net/poem59159.html","الطويل"],[172,"أبت نوب الأيام إلا تماديا","https://www.aldiwan.net/poem1691.html",""],[198,"ألا رب لهو آنس ولذاذة","https://www.aldiwan.net/poem54397.html","الطويل"],[273,"جردت من تلك الجفون سيوفا","https://www.aldiwan.net/poem35430.html","الكامل"],[274,"أرى برق الغوير اذا تراءى","https://www.aldiwan.net/poem52103.html","الوافر"],[278,"كأن كتائب الباغين حزن","https://www.aldiwan.net/poem25543.html","الوافر"],[297,"لعن الإله الناس إلا مسلما","https://www.aldiwan.net/poem1748.html","الكامل"],[308,"العدل عهد خلافة الإنسان","https://www.aldiwan.net/poem56394.html","الكامل"],[367,"نزل الأحبة خطة الأعداء","https://www.aldiwan.net/poem61017.html","الكامل"],[419,"باكر نداماك بكأس العقار","https://www.aldiwan.net/poem53938.html","السريع"],[460,"قالوا رضيت قلت ما أجدى الغضب","https://www.aldiwan.net/poem56298.html","الرجز"],[507,"تائية القافلة","https://www.aldiwan.net/poem27889.html","البسيط"],[507,"المُحتلّ","https://www.aldiwan.net/poem42460.html","الهزج"],[517,"من أجل هيبة ذا المقام المذهل","https://www.aldiwan.net/poem12202.html","الكامل"],[553,"شد غروض المطي مغتربا","https://www.aldiwan.net/poem48085.html","المنسرح"],[1132,"","https://poetry.dctabudhabi.ae/diwan/poem/18989","البسيط"]],"verses":[["إمَّا جَنَحْتَ لِوُدِّهِ الضَّا","حِي فَدَوْحُ الْعَهْدِ مَائِل",0,"ل",1,0],["أَمَا جُرِحْتَ بِحَيْثُ لا تَأْسُو يَدٌ","فَجِرَاحُ نَفْسِكَ بِرْؤُهَا مِنْ عِنْدِهِ",1,"د",2,0],["أَمَّا جُلُوسُكَ فَهْوَ أًَوْفَى بَهْجَةٍ","وَأَحَقُّ بِالإِكْبَارِ وَالأَفْخَامِ",2,"م",1,0],["أَمَّا جَمِيلُ فهْوَ مَا تَبْغِي العُلَى","لَبِقٌ عِصَامِيُّ المَضَاءِ نَبِيلُ",3,"ل",1,0],["اما جبين القوم فهو من","الصفاقة ليس يندى",4,"د",2,0],["أما جرّدُوه مقضباً وهو ناشِئٌ","أما جَرَّبوه مقنباً وهو واحدُ",5,"د",1,0],["أمَّا جميلُ المحسنا","ت ففي النهار وفي الدجنّه",6,"ن",2,0],["أَمَ اَجعَلُ مِن جِلدِها حَنبلاً","فَأَقذِر بِحَنبَلِها حَنبَلا",7,"ل",2,0],["أَمَّا جَزَالَتُهُ فَغَايَةُ مَا انْتَهَتْ","شَرَفاً إِليْهِ جَزَالَةُ الفُصَحَاءِ",8,"ا",2,0],["إمّا جزِعْت له فَعُذْرٌ بيِّنٌ","قضَتِ الدَّواهي أن تُحَلّ له الحُبا",9,"ب",2,0],["أما جاهدوا في الله حق جهاده","خطاب لنا من ربنا عمم الكلا",10,"ل",2,0],["أَما جَرَّبَتني في الأُمُورِ فَصادَفَت","هُماماً لِأَحداثِ المُهِمّاتِ كافيا",11,"ي",2,0],["أَماجِدُ أَنَّ القَلبَ رَهنٌ مُتَيَّمٌ","بِهِ سَقَمٌ أَعيا الأَطِبَّةَ مُضمَرُ",12,"ر",1,0],["أما جمالُكِ فهو نارٌ طهَّرت","دَنسَ القلوبِ لذاكَ صرتُ عفيفا",13,"ف",2,0],["اما جبريل روح اللَه وجدا","بمن تحت الكَسا ورد الكساء",14,"ا",2,0],["أمَاجِدُ بينَ أنْسابٍ قِصَارٍ","تَفَاخُرُهم وبَيْن قَناً طوالِ",15,"ل",1,0],["إما جنيتُ عليه حرباً حاطني","ولجأت تحت لبان ليثٍ مُخدر",16,"ر",1,0],["إِمّا جليّاً طبقَ نازلةٍ عرَت","أَو باطناً لملمّةٍ لم تانِ",17,"ن",1,0],["أمّا جَداكَ فمِن فِنائك قد سَرى","حتّى أتاني نازلاً بِفنائي",18,"ا",2,0],["أمَّا جميل الصّنع منه فمِن","شعاره أَكرِمْ به من شعار",19,"ر",1,0],["أَمَا جَنَى خيرا له آدابُهُ","أعاذكُنَّ اللّهُ مِن شرِّ الأدبْ",20,"ب",1,0],["إمّا جِنانٌ نعيمُها مُقيمٌ أوْ","عذابُ نارِ لهُم في مرِّها قوْتُ",21,"ت",1,0],["أما جاورتَ في أيّا","مه الطاعونَ والسّلّا؟",22,"ل",2,0],["أما جراحك يا زمان فإنها اندمل","ت ولكن بعد حز المفصل",23,"ل",1,0],["إِمّا جبيناً بالتُّرب منعفراً","أو وَدَجاً بالنَّجيع مُنسكبا",24,"ب",2,0],["إِمّا جَديداً وَإِمّا بالِياً خَلَقاً","عادَ العَذارى لِقَطعيهِ بِأَسيارِ",25,"ر",1,0]]}