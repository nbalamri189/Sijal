{"poems":[[79,"زارت وقد صرف العنان الغيهب","https://www.aldiwan.net/poem36776.html","الكامل"],[29,"إن الفرزدق أخزته مثالبه","https://www.aldiwan.net/poem5672.html","البسيط"],[53,"يا أيها المتعالي عن معونتنا","https://www.aldiwan.net/poem8506.html","البسيط"],[72,"لما التحى وتبدلت","https://www.aldiwan.net/poem42860.html","مجزوء الكامل"],[87,"قل للمؤيد ما دهاك","https://www.aldiwan.net/poem7356.html","مجزوء الكامل"],[214,"وشان قد جاد لي من ثغره","https://www.aldiwan.net/poem13453.html","السريع"],[366,"يا ابن الاماجد لا تخش الردى أبدا","https://www.aldiwan.net/poem68121.html","البسيط"],[435,"خود من الترك قد صالت على العرب","https://www.aldiwan.net/poem40050.html","البسيط"],[438,"أقبل بوجهك إني عنك منصرف","https://www.aldiwan.net/poem12318.html","البسيط"],[458,"أين ابتسامك يا حبيبي","https://www.aldiwan.net/poem61716.html","مجزوء الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86967","الكامل"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123432","السريع"],[287,"","https://poetry.dctabudhabi.ae/diwan/poem/69786","الرجز"],[1132,"","https://poetry.dctabudhabi.ae/diwan/poem/121099","البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144121","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79802","الرجز"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48928","المجتث"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71060","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2697,"","https://poetry.dctabudhabi.ae/diwan/poem/107180","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109981","البسيط"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69971","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73418","الكامل"],[4717,"إلى الأستاذ / مصطفى محمود","https://www.poetsgate.com/ViewPoem.aspx?id=199632",""],[4869,"موقف لآ اكثر","https://www.poetsgate.com/ViewPoem.aspx?id=139691",""],[5344,"فنجال مع الوالده ..","https://www.poetsgate.com/ViewPoem.aspx?id=180707",""],[5628,"ذكرى وأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=178461",""],[5829,"الفيحاء","https://www.poetsgate.com/ViewPoem.aspx?id=151769",""],[5841,"اموت انا بالقاف لا منك نطقتي به","https://www.poetsgate.com/ViewPoem.aspx?id=37038",""],[5944,"2020","https://www.poetsgate.com/ViewPoem.aspx?id=213794",""],[6035,"لادامت لكم نِعمُ .. !","https://www.poetsgate.com/ViewPoem.aspx?id=175082",""],[6093,"أرجوحة","https://www.poetsgate.com/ViewPoem.aspx?id=197204",""],[6247,"جمال القرآن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80287&r=&rc=26",""]],"verses":[["لَكِنْ غَدَوْتُ بِرَغْمِ أَنْفِي قَاعِداً","وَالدَّمْعُ مِنْ عَيْنيِ يَفِيضُ وَيُسْكُبُ",0,"ب",1,0],["لَكِن غَمامَةُ لَو تَدعو فَوارِسَنا","يَومَ الوَقيطُ لَما وَلّوا وَلا هابوا",1,"ب",3,0],["لكن غَنيتَ بنفسٍ لا كِفاءَ لها","في النظم والنثر من شعر ومن خطبِ",2,"ب",1,0],["لَكِن غَدا وَعِذارُهُ","خَضِرٌ فَساقَ إِلَيهِ موسى",3,"س",2,0],["لكن غفلة أمّة","عبدت عجولا قبل ذاك",4,"ك",1,0],["لكن غدا في دربه عارض","يقطع في الجد عليّ الطريق",5,"ق",1,0],["لكِنّ غايَة أَمري اِنَّني رَجُل","بِحُبّ آل النَبي أَرجو النَجاةَ غَدا",6,"د",2,0],["لكن غفرت له لما رأيت بهِ","ذا الفضل أسعد صدر السادة النجب",7,"ب",1,0],["لكنْ غُرِرْتُ بِبَرْقٍ باتَ خُلَّبُهُ","يَهْمِي لَهُ دُمُوعي عارِضٌ يَكِفُ",8,"ف",1,0],["لكن غناىَ غنىً لرو","حس لا تُفاخِرُ بالعيوبِ",9,"ب",1,0],["لَكن غَدرت وَهَذِهِ لَكَ عادة","وَالحَق يَظهر لِلنبيه بِلا خَفا",10,"ف",2,0],["لكنْ غدا إشْفاقُنا باطلاً","وكان أمر الله مَفعولا",11,"ل",2,0],["لَكِن غَدَت شيمَتُهُ البُخلَ وَقَد","أَصبَحتُ لا أَطمَعُ في سَلامِهِ",12,"م",2,0],["لكن غدونا كما الطرفين ليس يرى","طرفٌ أخاه ولا يلقاه باصره",13,"ر",2,0],["لكنْ غلِطتُ وليس يأ","مَنُ عاقلٌ غلَطَ الأريبِ",14,"ب",1,0],["لكن غدا مُسلِّماً مُحتسِباً","والخير كلّ الخير في احتسابه",15,"ب",2,0],["لكنْ غرورُ الغواني","أَبقى العزويةَ أَحلى",16,"ل",2,0],["لكنْ غَدَرْتَ وقَصَّرَتْ بك قدرةْ","قَعدتْ وهِمَّةُ عاجِز لم تقدِر",17,"ر",1,0],["لَكِنَّ غَايَتَهَا الظُّنُونُ وَلَيتَهُ","ظَنًّا يَكُونُ مُطَابِقاً بِبَيَانِ",18,"ن",1,0],["لَكِنَّ غَايَتَهُ كفَايَةِ مَن سِوَى ال","مَعصُومِ غَايَةِ نَوعِ ذَا الإِحسَانِ",18,"ن",1,0],["لكن غريب ما له من شاهد","فرد بذا الاسناد ليس بثان",18,"ن",1,0],["لَكِن غُبارُ الجَوِّ يُخفِي لُطفَها","فَلِذا أُرِيناها إِراءً مُحكَما",19,"م",2,0],["لكن غَدَوتِ سماءَ فالملائك قد","قامت برحبكِ أفواجاً على الحَرَسِ",20,"س",1,0],["لَكنَّ غاراتِ المَنايا شابَهَت","غاراتِهِ في حلبَةِ الميدانِ",21,"ن",1,0],["لَكِنَّ غاياتِ العُلا مِن دُونِها","طُرقٌ صِعابٌ يُتَّقَى فيها الرَّدى",22,"ا",1,0],["لكن غرامي طالَ فيكَ وإِنَّهُ","لَمَّا رأيتُكَ رُبَّ طَرفٍ قاصرِ",23,"ر",1,0],["لكنَ غيْرَك - والقيادةُ حرفةٌ -","ما وزنُه؟ .. بل لن يزيدَ المكتبا",24,"ب",2,0],["لكن غلآهم فوق متن السحابه","ولايزعزعه مخلوق بين البريّه",25,"ي",2,0],["لكن غصب نصبر ولآمالنا سروج","يمكن تزين حظوظ عسف الركايب..",26,"ب",1,0],["لكن غدرتِ وقدْ جعلتُكِ قبلتي","والحبُّ إنْ ذهبَ الوفا قَتّالُ",27,"ل",1,0],["لكن غريزتهم أعمت بصائرهم","والحقد أججهم فازدادهم جهلا",28,"ل",2,0],["لكن غرورك لو تغليت الغزل طيبه","والله لغازلك بغروري ذا وتسهرني",29,"ن",2,0],["6-لكن غفلْنا عمَّا يُدَبِّرُهُ","لنا القضاءُ المجهولُ واجتَرحا",30,"ح",2,0],["لكنّ غزّة تدري كيف تلجمهم","والجور يكبحه الصمصامة الحذمُ",31,"م",1,0],["لكِنَّ غِيْرَتهَا وشَكَّ ظُنُونِهَا","وضَعَتْ مشاعرها على أرْجُوحَةْ",32,"ح",2,0],["لكنْ غفلنا عن جمال كتابنا","وأعاقنا حملُ الذنوبِ مع الذنوبْ",33,"ب",1,0]]}