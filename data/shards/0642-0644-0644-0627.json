لبسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200141","الخفيف"],[240,"","https://poetry.dctabudhabi.ae/diwan/poem/13265","السريع"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132584","الخفيف"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145062","الكامل"],[3447,"","https://poetry.dctabudhabi.ae/diwan/poem/32710","البسيط"],[3477,"","https://poetry.dctabudhabi.ae/diwan/poem/133027","الكامل"],[3561,"","https://poetry.dctabudhabi.ae/diwan/poem/32405","المنسرح"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61264","الكامل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131995","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205967","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206135","البسيط"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199016","السريع"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117906","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117888","المجتث"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66618","الرمل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59480","الرمل"],[3855,"","https://poetry.dctabudhabi.ae/diwan/poem/32627","المنسرح"],[3855,"","https://poetry.dctabudhabi.ae/diwan/poem/32696","البسيط"],[3855,"","https://poetry.dctabudhabi.ae/diwan/poem/32646","الكامل"],[3855,"","https://poetry.dctabudhabi.ae/diwan/poem/32629","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40102","المنسرح"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77065","البسيط"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101369","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86450","الكامل"],[4227,"","https://poetry.dctabudhabi.ae/diwan/poem/144280","البسيط"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62127","السريع"],[4444,"","https://poetry.dctabudhabi.ae/diwan/poem/34745","السريع"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139304","الخفيف"],[4450,"","https://poetry.dctabudhabi.ae/diwan/poem/138827",""],[4469,"","https://poetry.dctabudhabi.ae/diwan/poem/103160","السريع"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139518",""],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67542","البسيط"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67438","البسيط"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52198","السريع"],[4578,"نيل السعادة من أحلى الماني","https://www.poetsgate.com/ViewPoem.aspx?id=49621",""],[5038,"الموصل الحدباء","https://www.poetsgate.com/ViewPoem.aspx?id=190135",""],[5050,"خفف العذل عن محب تصامم","https://www.poetsgate.com/ViewPoem.aspx?id=38204",""],[5274,"البردوني وعروبة اليوم","https://www.poetsgate.com/ViewPoem.aspx?id=203259",""],[5436,"لبيك يا علم العراق ( عادل العاني )","https://www.poetsgate.com/ViewPoem.aspx?id=30629",""],[5459,"يا فؤاد ذب ألما","https://www.poetsgate.com/ViewPoem.aspx?id=190946",""],[5701,"حي في المغرب شعبا عربيا","https://www.poetsgate.com/ViewPoem.aspx?id=164613",""],[402,"صدقت في عتبكم أو يصدق الشمم","https://www.poetsgate.com/ViewPoem.aspx?id=36829",""],[5790,"قل لأحبابنا الجناة علينا","https://www.poetsgate.com/ViewPoem.aspx?id=112112",""],[514,"كل شئ مصيره للزوال","https://www.poetsgate.com/ViewPoem.aspx?id=27766",""],[5961,"ان ريح القرب نم","https://www.poetsgate.com/ViewPoem.aspx?id=199809",""],[6031,"قُلْ لأعْلَى الوَرَى مَحَلاّ ورُتْبَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=46345",""],[6090,"قل لسكرى فليحيي آنا ليرنو","https://www.poetsgate.com/ViewPoem.aspx?id=170906",""],[520,"قل لابن دخان اذا جئته","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577579",""],[240,"قُلْ لأَبِي کلنَّقْصِ وَکلْمَخَازِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26478&r=&rc=3",""]],"verses":[["قُل لِأَبي العَوّامِ مُستَدفِعاً","بِهِ جِماحَ القَدَرِ النازِلِ",0,"ل",1,0],["قُل لَأَقنى يَرمي إِلى المَجدِ طَرفا","ضَرِمٍ يُعجِلُ الطَرائِدَ خَطفا",1,"ف",2,1],["قُل لِاِبنِ سَيِّدَةٍ وَإِن أَضحى لَهُ","خَوَلٌ تُدِلُّ بِكَثرَةٍ وَخُيولُ",2,"ل",1,1],["قُل لِأَبي حَفصٍ وَلَم تَكذِبِ","يا قَمَرَ الديوانِ وَالمَوكِبِ",3,"ب",1,1],["قُلْ لامْرِئٍ لَمْ تَرُقْهُ مِصْرُ بَاذِلَةً","نَصْراً لِدَوْلَتِهَا مِنْهُم بِمَا اجْتَرَمُوا",4,"م",3,0],["قل لابن عبّاد أيّ منقصة","من أجلها كنت مكثراً عذله",5,"ل",2,0],["قل لأرباب الوزاره","عَذَلاً أضرمت ناره",6,"ر",2,0],["قُل لِاِبنِ وَرقا جَعفَرٍ","حَتّى يَقولَ بِما عَلِم",7,"م",1,0],["قُل لِأَحبابِنا الجُفاةِ رُوَيداً","دَرِّجونا عَلى اِحتِمالِ المَلالِ",8,"ل",1,1],["قلْ لابن نعلان الذي أصبحت","كرته بين الورى خاسره",9,"ه",1,1],["قل لابن مولانا العزيز ومن له","عند الدكاء النقد والتمييز",10,"ز",1,1],["قل لأبي القاسم المُرَجَّى","قابلَكَ الدهرُ بالعجائبْ",11,"ب",1,1],["قلْ لأبي إسحاق بَيِّنْ لنا","فأنت في العلم من الرُّسَّخِ",12,"خ",1,0],["قل لأمير المؤمنين المعتادْ","رعايةَ اللّه له بالمرصادْ",13,"د",1,1],["قل لأبي حفصٍ إذا جئتَه","قول أخي نصْحٍ وإرشادِ",14,"د",1,1],["قل لأبي سهل الذي ورِث ال","رُوم لطيف العلوم والفُرُسَا",15,"س",2,1],["قل لابن خنساءَ سائل","نَواتَها كَيف رَضّي",16,"ض",2,0],["قل لأبي الصقر قول ذي سددٍ","قرطس بالحق غرَّةَ الهدف",17,"ف",1,0],["قلْ لأبي الصقرِ إن مَثَلْتَ له","واجمع لما أنت قائلٌ حشدكْ",18,"ك",1,0],["قُلْ لأيوبَ والكلامُ سجالُ","والجوابات ذاتَ يومٍ تُدالُ",19,"ل",1,1],["قُلْ لأبي سهلٍ الذي ترك ال","وعْر بمعروفهِ وقد سهُلا",20,"ل",2,1],["قل لابن بلبل لِمْ غلِطْ","تَ وأنتَ شهمٌ قُلقلُ",21,"ل",1,1],["قُلْ لابن بورانَ إن كان ابنَ بورانِ","وما إخال ابن بورانٍ بإنسانِ",22,"ن",1,0],["قُلْ لابن بورانَ إن كان ابنَ بوران","فإنَّ شكّيَ فيه جُلُّ إيماني",23,"ن",2,1],["قُل لِأَهلِ الأَرضِ لا تَخشوا الرَدى","إِنَّهُ مُشتَغِلٌ في طَلَبي",24,"ب",2,0],["قُل لِاِمرِئٍ مِثلَ قارونٍ بِثَروَتِهِ","إِنّي اِمرُؤٌ بِصَحابي فَوقَ قارونِ",25,"ن",1,0],["قل لابناء يعرب ان في القبر","اباكم يذم هذا العقوقا",26,"ق",2,0],["قُل لِاِبنِ سينا لا طَبي","بَ اليَومَ إِلّا الدِرهَمُ",27,"م",1,1],["قُل لِأَهلِ الوُقوفِ موتوا بِغَيظٍ","وَاِبكِ مِما أَقولُهُ يا اِبنَ عيسى",28,"س",2,1],["قُل لِأَبي نوحٍ شَقيق النَدى","وَمَعدِنِ الجودِ وَحِلفِ السَماح",29,"ح",1,0],["قُل لِأَسماءَ أَنجِزي الميعادا","وَاُنظُري كَي تُزَوِّدي مِنكِ زادا",30,"د",2,1],["قُل لِاِبنِ دينَرٍ رَسيلِ القَطرِ","إِذا اِستَهَلَّ بِالنَوالِ الغَمرِ",31,"ر",1,1],["قُل لِأَبي صالِحٍ إِمّا عَرَضتُ لَهُ","تَحمَدهُ قائِلَ أَقوامٍ وَمُستَمِعا",32,"ع",2,0],["قُل لِأَبي جَعفَرٍ وَإِنَّ لَهُ","يَداً يَنالُ البَعيدُ نائِلَها",33,"ل",3,1],["قلْ لابنِ حرْبٍ قد جَنَيْ","تَ عليك حرباً فاصطَبِر",34,"ر",1,1],["قُلْ لابنِ فَهْدٍ وإن شطَّتْ مَنازِلُه","وكم بعيدٍ على العافين ما بَعُدا",35,"د",2,1],["قُل لِأَهلِ الإِكثارِ وَالإِقلالِ","كُلُّكُم مَيِّتٌ عَلى كُلِّ حالِ",36,"ل",1,1],["قُل لِأَهلِ القُبورِ كَيفَ وَجَدتُم","طَعمَ مُرِّ البِلى وَثِقلَ التُرابِ",37,"ب",1,1],["قل لأهل الغناء في","كنف المعهد الأشَم",38,"م",1,0],["قُل لِاِبنِ طَوقٍ رَحى سَعدٍ إِذا خَبَطَت","نَوائِبُ الدَهرِ أَعلاها وَأَسفَلَها",39,"ل",3,1],["قلْ لأهلِ الجاهِ مهما","رمتُمْ عزاً وطاعَهْ",40,"ه",1,1],["قُل لِأَلفٍ مِنَ الأَئِمَّةِ يَقضي","أَلفَ شَهرٍ في صَومِهِ وَصَلاتِهْ",41,"ت",2,0],["قُلْ لأهلِ النّياقِ أوتيتُ أجرِي","جَللاً فَابْتَغوا سِوَايَ أجيرا",42,"ر",2,0],["قل (لآيت) يعروس لعولي","كل حسنٍ لمقلتيك لفدءُ",43,"ا",1,0],["قُل لِأَبي مالِكٍ فَتى مُضَرِ","مَقالَ لا مُفحَمٍ وَلا حَصِرِ",44,"ر",1,1],["قُل لِاِسماعيلَ ذي الخا","لِ عَلى الخَدِّ السِباعي",45,"ع",2,1],["قل لأبي الأنكح إن جئتَهُ","أغضبكَ اللَه بمفساها",46,"ه",2,1],["قُل لِاِبنِ داوُدَ إِذا جِئتَهُ","سَيبُكَ مَوجودٌ وَمَطلوبُ",47,"ب",1,0],["قُلْ لابنِ عزرا أَلسَّخيفِ الحجا","زَرَى عليكَ الكوكبُ الثاقبُ",48,"ب",1,0],["قل لابن هانئ لا ذوت لك كرمة","فقد الربيع هزارها الصداحا",49,"ح",2,0],["قُل لأُمِّ البنَينِ إن حانَ مَوتي","تَبكِني لِلنِّزالِ تَحتَ العَجاجِ",50,"ج",1,1],["قل ل آيات يا عروس العوالي","كل حسن لمقلتيكِ الفداء",51,"ا",2,0],["قُل لِاِبنِ خائِنَةِ البُعولِ","وَاِبنِ الجَوادَةِ وَالبَخيلِ",52,"ل",1,1],["قل لابن سلطانَ قولاً غير مُتَّهَم","مِنْ شاعِرٍ منصف لا يألف الكذبا:",53,"ب",2,0],["قل لابن حُجْر: يا قَتِيلَ عُنَيْزَة","هَلاَّ شَهِدْتَ من الكنِانِة جؤذرا؟",54,"ر",2,0],["قل لأبناءِ «يعرُبٍ»: وحِّدوا الشَّمْ","لَ، كما وحَّدَ النبيُّ الجُهودا",55,"د",2,0],["قل لأولاءِ الذين استأثَروا","بالملذّاتِ وبالحكمِ احتيالا",56,"ل",2,0],["ق