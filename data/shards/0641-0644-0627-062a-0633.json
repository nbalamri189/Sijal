لسلاح فإنه","https://www.poetsgate.com/ViewPoem.aspx?id=201348",""],[5830,"كل الشرائع في محرابك اجتمعت","https://www.poetsgate.com/ViewPoem.aspx?id=204642",""],[5939,"بسكوتة!","https://www.poetsgate.com/ViewPoem.aspx?id=195175",""],[5944,"تعالي","https://www.poetsgate.com/ViewPoem.aspx?id=213330",""],[6031,"أَتَعْجَبُ من أتَانِكَ حِينَ أَنَّتْ","https://www.poetsgate.com/ViewPoem.aspx?id=46351",""],[6031,"هِيَ الدارُ تَستسقيكَ مَدْمَعَكَ الجاري","https://www.poetsgate.com/ViewPoem.aspx?id=46266",""],[6037,"فإن لم تجدني مخلص القول صادق","https://www.poetsgate.com/ViewPoem.aspx?id=186097",""],[161,"لفي كبدٍ خُلِقْتَ فَمَنْ تَلومُ ؟ !","https://www.poetsgate.com/ViewPoem.aspx?id=155650",""],[6052,"وقفة على البحر الميت","https://www.poetsgate.com/ViewPoem.aspx?id=35193",""],[6093,"إذا شئت المجاز فأنت بعضي","https://www.poetsgate.com/ViewPoem.aspx?id=207102",""],[6102,"أَحَقُّ !!","https://www.poetsgate.com/ViewPoem.aspx?id=182816",""],[2380,"ومستنبح يخشى القواء ودونه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=510749",""],[242,"أقول لمن يصيخ الى اصطراخ","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563805",""],[6225,"المرأة المؤمنة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80908&r=&rc=177",""],[6315,"غريبٌ في البلدة ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87580&r=&rc=5",""]],"verses":[["فَلا تَسأَل عَنِ الكاسِ ال","لَتي فيها تَساقَينا",0,"ن",2,0],["فَلا تَستَهِبّوا الشَرَّ مِن رَقَداتِهِ","فَيَسحَتَكُم سَحتَ السِنينَ الخَوالِفِ",1,"ف",1,0],["فَلا تَستَنكِروا غَضَبي عَلَيكُم","فَلَو هُنتُم عَلَيَّ لَما غَضِبتُ",2,"ت",1,0],["فَلا تَسأَلَ سَتَثكَلُ كُلُّ أُمٍّ","إِذا ما إِخوَةٌ كَثُروا وَطابوا",3,"ب",3,0],["فَلا تَسأَليني مَتى تَنقَضي","لَيالي الإِسارِ وَلا تَحزَني",4,"ن",2,0],["فَلا تَسقِياني مِن تِهامَةَ بَعدَها","بِلالاً وَإِن صَوبُ الرَبيعِ أَسالَها",5,"ل",3,0],["فلا تَستنفِعوا التعليِم إلاّ","إذا هذّبتم الطبع الشَرِيرا",6,"ر",2,0],["فَلا تَسأَلينا وَاِسأَلي عَن بَلائِنا","إِياداً وَكَلباً مِن مَعَدٍّ وَوائِلا",7,"ل",2,0],["فَلا تَسأَليني وَاِسأَلي أَيُّ فارِسٍ","إِذا بادَرَ القَومُ الكَنيفُ المُسَتَّرا",8,"ر",2,0],["فَلا تَسأَليني وَاِسأَلي بِيَ صُحبَتي","إِذا ما المَطِيُّ بِالفَلاةِ تَضَوَّرا",8,"ر",2,0],["فلا تسلمَنّي للأعادي وقولهم","ألا من رأى صقراً فريسةَ أرنبِ",9,"ب",1,0],["فَلا تسترثْ حمدي مع الشكر إنه","لبيْنَ قَعيدٍ منهما وقعيدِ",10,"د",1,0],["فلا تسأليني في هواك زيادةً","فأيسره مُرضٍ وأدناه مُقنعُ",11,"ع",1,0],["فلا تسأل النصر إلا امرأً","تراه بنصرك يقضيك حقا",12,"ق",2,0],["فلا تسخط عليَّ ولا تُذِلني","وشبِّه بالمحاسن منكَ فِعلك",13,"ك",1,0],["فلا تسهمنَّ الحظَّ فيه فإنه","جزيلٌ وما مَنْ كان مثلك يُسْهَمُ",14,"م",1,0],["فَلا تَستَرسِلوا لِرَجاءِ سِلمٍ","فَإِنَّ الحَربَ شامِذَةُ النِطاقِ",15,"ق",1,0],["فَلا تُسقِطَنكُم بَعدَها آلَ مالِكٍ","شِرارُ أَحاديثِ الرِجالِ وَقيلُها",16,"ل",3,0],["فَلا تَسمَعوا فينا بِحَقِّكُمُ الَّذي","يَقولُ فُلانٌ عِندَكُم وَفُلانُ",17,"ن",1,0],["فَلا تَستَحيلي لِبُعد الديار","فَإِنّي مَعَ البُعد لا أَستَحيلُ",18,"ل",1,0],["فَلا تَسل عَن جَيشِهِ أَينَ مَضى","وَلا تَسَل عَن بيتِهِ ماذا التُقى",19,"ا",1,0],["فَلا تَسَل عَن قُرَيشٍ كَيفَ حَيرَتُها","وَكَيفَ نُفرَتُها في السَهلِ وَالعَلَمِ",20,"م",1,0],["فَلا تَستَبينُ سِوى قَريَةٍ","أَجَدَّ مَحاسِنَها ما اِندَثَر",21,"ر",1,0],["فَلا تَسمَعَنَّ مِنَ الكاشِحينَ","وَلا تَعبَأَنَّ بِمَحكِ اليَهودِ",22,"د",1,0],["فَلا تَستَنكِرَنَّ لَهُ اِبتِساماً","إِذا فَهِقَ المَكَرُّ دَماً وَضاقا",23,"ق",2,0],["فلا تستهن بالرماد الرميم","فبغيتنا فيه لما همد",24,"د",1,0],["فلا تستعظم التدبير واعمل","إذا ما كنت منه على بصيره",25,"ر",2,0],["فَلا تَسأَلَنهُ خُطَّةَ الظُلمِ إِنَّهُ","إِلى مَنصِبٍ تَأبى الظَلامَ مَحاتِدُه",26,"د",2,0],["فَلا تَسأَلوها عَن قَديمِ تُراثِها","فَعَسجَدُها مِمّا أَفادَ حَديدُها",27,"د",3,0],["فَلا تَسأَلا عَن هَجرِها إِنَّ هَجرَها","جَنى الصَبرِ يُسقى مُرُّهُ مِن جَنى الشُهدِ",28,"د",1,0],["فَلا تَسأَلَنِّيَ عَن حالَةٍ","بُليتُ بِها صَعبَةً مُنكَرَه",29,"ر",2,0],["فَلا تَسأَلَن عَن مَضجَعي وَنُبُوِّهِ","بِأَرضي وَعَن نَومي بِها وَاِمتِناعِهِ",30,"ع",2,0],["فَلا تَسأَلَن بِاِستِواءِ الزَما","نِ وَقَد وافَتِ الشَمسُ ميزانَها",31,"ن",3,0],["فَلا تُسلِموني آلَ مَروانَ لِلَّتي","أَخافُ بِها قَعرَ الرَكِيَّةِ وَالفَما",32,"م",2,0],["فَلا تَسأَلَنَّ المَرءَ إِلّا ضَرورَةً","وَوَفِّر عَلَيهِ كُلَّ ذاتِ يَدَيهِ",33,"ي",2,0],["فَلا تَسْأَلْ عَلَى مَا كَانَ مِنْهُ","وَلا تَسْأَلْ عَلَى مَا كَانَ مِنِّي",34,"ن",2,0],["فلا تسجحْ بمدحِكَ فَهْوَ صدقٌ","وبعضُ المدحِ أكذبُ مِنْ سجاحِ",35,"ح",1,0],["فلا تسمعْ كلاماً منْ فلانٍ","فلستَ بسامعٍ منهُ كلاما",36,"م",2,0],["فَلا تَسمَعي مِن قَولِ مِن وَدَّ أَنَّني","وَإِيّاكِ نُمسي ما نَحَلُّ بِهِ جَدبا",37,"ب",2,0],["فَلا تَسمَعي فينا مَقالَةَ جاهِلٍ","فَرَبّي كَما قَد تَعلَمينَ مُجيبُ",38,"ب",1,0],["فَلا تَسمَعَن بي مَقالَ العِدا","وَلا توكِلَنّي هُديتَ الرِجالا",39,"ل",2,0],["فلا تَسَلْنِي فما حَضَرْتُ لها","لكِنْ سمِعْتُ الصِّيَاحَ والنُّدْبَهْ",40,"ب",2,0],["فلا تَسْتَأْصِلِ الأمْوالَ حَتَّى","يَكُونُوا كلُّهُمْ مُتَوَاطِئينا",41,"ن",2,0],["فلا تَسَل عن معُاديهِ فحسبُكَ من","مُقَرطَسٍ بسِهامِ اللّهِ مَرميّ",42,"ي",1,0],["فلا تسألاني عن زماني الذي خَلا","فوَالعصْرِ إني قبل يحيَى لفي خُسر",43,"ر",1,0],["فَلا تَسأَلِ القَلبَ عَن حُبِّها","كَفى بِالدُموعِ لَها شاهِدا",44,"د",2,0],["فَلا تَسقِني أَصبَحتُ مِن سَكرَةِ الهَوى","أَميدُ أَلا حَسبي مِنَ السَكَراتِ",45,"ت",1,0],["فَلا تَسأَلِ المَرءَ عَن سِنِّهِ","وَلا مالِهِ وَاِخشَ أَن تُعنَتا",46,"ت",2,0],["فَلا تَسأَل أَهِندٌ أَم لَميسٌ","ثَوَت في النِسوَةِ المُتَخَيِّماتِ",47,"ت",1,0],["فَلا تَسأَلِ المَرءَ الغَنِيَّ عَطائَهُ","وَرَجِّ الغِنى مِن رَبِّكَ المُتَعالي",48,"ل",2,0],["فَلا تُسرِعَنَّ فَإِنَّ السَري","عَ يُقَفُ حَقّاً كَما تَعلَمُ",49,"م",1,0],["فَلا تُسدِ لِلنَفسِ الجَميلَ وَأَسدِهِ","لِرَبِّكَ وَاِنفُض عَن عُيونٍ تَوَسُّنا",50,"ن",2,0],["فلا تستكثرنّ له ابتساما","إذا فهق المكرّ دماً وضاقا",51,"ق",2,0],["فلا تَسْتَكْثِرِ الهَجَماتِ فيها","فإعْراسٌ بتلكَ دُخولُ جَنّه",52,"ن",2,0],["فلا تسلْ عن انبساط الملك","ورفق ربّانيه بالفلك",53,"ك",1,0],["فلا تسل عن نهضة العقول","وكثرة المعقول والمنقول",54,"ل",1,0],["فلا تسلْ عن فشلِ العزائمِ","ولم يزل طليعة الهزائمِ",55,"م",1,0],["فلا تسألاني عن تباريحِ علَّتي","ودونَكُما منّي الَّذي تَريَانِ",56,"ن",1,0],["فَلا تَسْأَلَنِّي عَنْ هَوَايَ فَإِنَّنِي","وَرَبِّكَ أَدْرِي كَيْفَ زَلَّتْ بِيَ النَّعْلُ",57,"ل",1,0],["فَلا تَسْأَلِي مِنِّي الزِّيَادَةَ في الْهَوَى","رُوَيْداً فَهَذَا الْوَجْدُ آخِرُ مَا عِنْدِي",58,"د",2,0],["فَلاَ تَسْبِقِي سَيْفَ القَضَاءِ إِلَيْهِمَا","عَلَى أَنَّهُ يَشْفِيهُمَا لَوْ يُعَجِّلُ",59,"ل",1,0],["فلا تسألي من هداني إليك ؟","هداني إليك صباك النضير",60,"ر",1,0],["فلا تسل عن بناتِ ماءٍ","إن صَرصَرَت حَولَها البُزَاةُ",61,"ه",1,0],["فَلا تَسفَهَن أَحلامُكُم في مُحَمَّدٍ","وَلا تَتبَعوا أَمرَ الغُواةِ الأَشائِمِ",62,"م",1,0],["فَلا تَستَدِمها جَفوَةً جَلَّ خَطبُها","فَفالَ بِها رَأيِي وَفُلَّ شَبا عَزمي",63,"م",2,0],["فلا تسمني الصَّبر من بعدهم","فلستُ أصغي لا ولا لي اصطبار",64,"ر",1,0],["فلا تسأل فدتك النفسُ ماذا","لقينا بعد ما فُضَّ الكتابُ",65,"ب",1,0],["فلا تسل عن حالنا بعدكم","أسوأُ حال بعدكم حالنا",66,"ن",2,0],["فلا تسألوا عن ليلة ظفر الهوى","يجيش النوى فيها فافنى الذي أفنا",67,"ن",2,0],["فلا تسألوا عن ليل صبين خليا","وشأنهما في البعد عمن يراقب",68,"ب",1,0],["فَلا تَسمَعُوا فِيَّ الوُشاةَ فَإِنَّهُم","لَأَكذبُ مِن آلٍ رَأتهُ حِيامُ",69,"م",1,0],["فلا تسألوني كيف عيدي فإنني","رأيت الرقيق الحال ليس له قدر",70,"ر",1,0],["فلا تسمح بثوبي مستميح","على عزماته حلّ وشدّ",71,"د",1,0],["فلا تستنمْ لنؤمِ الضحى","ولا ترجُ برةَ أيمانِها",72,"ن",3,0],["فلا تسكتوا عني فما لي إطاقة","على لجة في مائها المر أغرق",73,"ق",1,0],["فلا تَسْفِكِي ظُلْماً دمي وَتَجَنّياً","فحبك فيه يا فديتك يسفك",74,"ك",1,0],["فلا تَسْتشيما بُروقَ السَّحابِ","فَلَلِّريُّ في شَيْم بَرْق الظُّبا",75,"ا",1,0],["فَلا تَستَوطِ مِن دُنياكَ ظَهراً","بِكَفِّ النائِباتِ لَها زِمامُ",76,"م",1,0],["فَلاَ تُسْنِدْ لِغَيْرِ اللهِ نَفْعاً","تَصُنْ رَأْسَ الْيَقِينِ مِنَ افْتِضَاخِ",77,"خ",1,0],["فلا تُسئ في الورى ظنّاً بجهلك من","لم تدر مدركه في القصد والوطر",78,"ر",1,0],["فلا تسمعن ما صنفته رواتهم","فإن أكاذيب اللئام صنوف",79,"ف",1,0],["فَلا تسل عَن لُباناتٍ به قُضيَت","فَلَيسَ يَحسُنُ عنها اليوم تَفتيشُ",80,"ش",1,0],["فلا تسقموني بطول الجفا","ومنوا بوصل ولو في المنام",81,"م",1,0],["فلا تسألنّ المرء عن قدر كسبه","ولو كان منعوتا باوصاف بيحان",82,"ن",1,0],["فَلا تَسأَليني في هَواكَ زَيادَةً","فَلَم يَبقَ في قَلبي لَها بَعدَ مَوضِعُ",83,"ع",1,0],["فَلا تَسَل ما اِعتَرى أَسَلاً مَبولَ مِن أَسَفِ","إِذ لِلنَوى قَد نَوى مُستَتَبِعُ السَبَبا",84,"ب",2,0],["فلا تسلكي في عداد السنين","لياليه بعد فوات الصبا",85,"ب",2,0],["فَلا تَسأَلَن مَن كانَ يَسأَلُ مَرَّة","فَلَلمَوتُ خَيرٌ مِن سُؤالِ سَؤولِ",86,"ل",1,0],["فلا تَسألاني عن دَمٍ قد وَهبْتُه","فما القتلُ في دينِ الهوى بمُحرَّم",87,"م",1,0],["فلا تَسمَحْ بما أنا مُستحِقٌّ","ولا يكُ قَدُّ سَيْري من أديمي",88,"م",2,0],["فلا تَسمَعْ منَ الحدَثانِ أن قد","سعَى في قَطْعِ ذاك الاِتّصال",89,"ل",1,0],["فلا تَسْقِ كأسَ اللّومِ صِرْفاً مَسامعي","ولكنْ بذكْرِ العامريّةِ فامْزُج",90,"ج",1,0],["فَلا تُسمِ في دُنياكَ داراً بِجَنَّةٍ","بِآيَةِ أَنَّ المَرءَ لَيسَ بِخالِدِ",91,"د",1,0],["فَلا تَستَمِر غَيرَ إِحسانِهِ","وَإِلّا فَمُت ظامِئاً ضامِرا",92,"ر",2,0],["فَلا تَسمَعوا إِلّا حَديثاً لِناظِري","يُعادُ بِأَلفاظِ الدُموعِ السَواجِمِ",93,"م",1,0],["فلا تَستَصغِرَن شِعري","فقَد حزتُ به شُكرا",94,"ر",2,0],["فلا تَسَلني كيفَ أمسيتُ بال","حاملِ والمَحمولِ مَسرورا",95,"ر",2,0],["فلا تَستَطيلنَّ اللَّيالي بكيدِها","فما كيدُها عِند الشريفِ بضائِري",96,"ر",2,0],["فلا تَسَلْ غير طرفي عن مدامعِهِ","لا تأخذِ الماءَ إلاّ مِن مَجاريه",97,"ه",1,0],["فلا تَسَلْ كم سبَتْ وجداً وكم قتلَتْ","يَومَ الفراق ولكِنْ سَلْ عن الناجي",98,"ج",2,0],["فلا تساعده على ما وجَّه","فما له فيما أتاه حجة",99,"ج",2,0],["فلا تَسْتَثِرْ حَرباً وإن كنتَ واثِقاً","بشدَّةِ رُكنٍ أو بقُوَّةِ مَنكِبِ",100,"ب",1,0],["فَلا تَسأَلوني عَنهُ صَبراً فَإِنَّني","دفنت بِهِ قَلبي وَفي طَيِّهِ صَبري",101,"ر",2,0],["فلا تسألْ وقيت الشرّ دمعاً","إذا ما لاح برق الحيف سالا",102,"ل",2,0],["فلا تستسقيا غيثاً مريعاً","وقرّي يا صوارم في الغماد",103,"د",1,0],["فلا تسمعن عني مقالة كاذب","فما طاب إلا من يطيب له الأصل",104,"ل",1,0],["فلا تسأل العشاق عما يلوا به","وسلني فإني بالهوى عالم طب",105,"ب",1,0],["فلا تسلْ عن