try.dctabudhabi.ae/diwan/poem/202055","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204878","الخفيف"],[3069,"","https://poetry.dctabudhabi.ae/diwan/poem/198298","السريع"],[3080,"","https://poetry.dctabudhabi.ae/diwan/poem/96099","الرجز"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87562","السريع"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48383","الرجز"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48380","السريع"],[3544,"","https://poetry.dctabudhabi.ae/diwan/poem/116847","الرجز"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61276","الرجز"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101219","المنسرح"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199026","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135628","السريع"],[4004,"","https://poetry.dctabudhabi.ae/diwan/poem/111317","الكامل"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136805",""],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136557",""],[4348,"","https://poetry.dctabudhabi.ae/diwan/poem/76583","السريع"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104876","السريع"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67518","الخفيف"],[4691,"قهقهة 2","https://www.poetsgate.com/ViewPoem.aspx?id=105399",""],[4702,"وردة الساقي","https://www.poetsgate.com/ViewPoem.aspx?id=155328",""],[1012,"فقر الأولياء","https://www.poetsgate.com/ViewPoem.aspx?id=186275",""],[1901,"أنساك ما سَرَّكَ من بُعدِه","https://www.poetsgate.com/ViewPoem.aspx?id=160412",""],[4927,"هالة الخزي وأم العواذل","https://www.poetsgate.com/ViewPoem.aspx?id=29835",""],[4119,"دمعي لسان فمه ناظر","https://www.poetsgate.com/ViewPoem.aspx?id=16091",""],[5302,"يا عجولا","https://www.poetsgate.com/ViewPoem.aspx?id=201222",""],[5409,"أبى الوضع عن جوره أن يكف","https://www.poetsgate.com/ViewPoem.aspx?id=155292",""],[5701,"لاحت على الشاطئ بستانا","https://www.poetsgate.com/ViewPoem.aspx?id=164672",""],[5790,"يا عجبا للمرء مع علمه","https://www.poetsgate.com/ViewPoem.aspx?id=111973",""]],"verses":[["يا عَجَبَ الدَهرِ مَتى سَوَّيا","كَم ضاحِكٍ مِن ذا وَمِن ساخِرِ",0,"ر",1,0],["يا عَجَباً لِلمُرتَجي فَضلَهُ","لَقَد رَجا ما لَيسَ بِالنافِعِ",1,"ع",1,1],["يا عجباً من طوقِ طاقيَّتي","عن لبسِ يومٍ واحدٍ قد غلب",2,"ب",1,1],["يا عجباً لي بعد عصر الصّبا","مخالفٌ في كلِّ حالاتي",3,"ي",1,1],["يا عجباً للشمس شمس الضحى","طالعة بالليل في الأطلس",4,"س",1,0],["يا عجباً إذ ذاك من حالةٍ","دافِعُنا فيها هو الجاذِبُ",5,"ب",1,0],["يا عجباً من خالدٍ","في صبْرِهِ وجلَدِهْ",6,"د",2,1],["يا عجباً منه والعجائبُ لا","تنفد ما مد دهرنا مَدَدَهْ",7,"د",2,0],["يا عجباً من مُشَوَّهٍ نَطفٍ","واجدُه في الورى كمن فَقَدهْ",7,"د",2,0],["يا عجيباً من كل وجهٍ ألا تَع","جب من ذي حجاً تمنّى زهيدَكْ",8,"ك",1,0],["يا عجباً من مُعذِّبي عجباً","عُجبي به ضِعفُهُ فقد هَدَره",9,"ر",2,0],["يا عجباً من شنطف إنها","أضحت تغني غيرَ مرتاعه",10,"ع",2,0],["يا عجباً من ناظري إنه","أضحت تقذّانيَ آماقه",11,"ق",2,0],["يا عجباً ليس لأن ردَّني","من بعد إيماض وتبريقِ",12,"ق",1,0],["يا عجباً من لئيم مُمتحَني","إن عزّ يوماً كريمَ ممتحنك",13,"ك",1,0],["يا عجباً من مُفاخرٍ حَمقٍ","يقيسُ أحفاشَهُ إلى حَضنك",13,"ك",1,0],["يا عَجَباً لِلدَهرِ شَتّى طَرائِقُه","وَلِلمَرءِ يَبلوهُ بِما شاءَ خالِقُه",14,"ق",2,1],["يا عَجَباً مِنْ أَبي الخَبيثِ ومِنْ","سُروحِهِ في البَقَائرِ الدَّثِرَهْ",15,"ر",2,0],["يا عجباً للجَمْرِ من خدِّهِ","لم تشتعلْ في مِسْكِ أصداغِهِ",16,"ه",1,0],["يا عَجَباً لِلعَذارى يَومَ مَعقُلَةٍ","عَيَّرنَني تَحتَ ظِلِّ السِدرَةِ الكِبَرا",17,"ر",2,1],["يا عَجَبا لِعُمانِ الأَسدِ إِذ هَلَكوا","وَقَد رَأَوا عِبَراً في سالِفِ الأُمَمِ",18,"م",1,0],["يا عَجَباً لِلدُنيا كَذا خُلِقَت","مادِحُها صادِقٌ وَعائِبُها",19,"ب",3,0],["يا عَجَباً مِنّي وَما اِختَرتُ مِن","شَكّي عَلى ما قَد تَيَقَّنتُ",20,"ت",1,0],["يا عَجَباً لي أَقَمتُ في وَطَنٍ","ساكِنُهُ كُلُّهُم عَلى سَفَرٍ",21,"ر",1,0],["يا عَجَباً لَلناسِ لَو فَكَروا","أَو حاسَبوا أَنفُسَهُم أَبصَروا",22,"ر",3,1],["يا عَجَباً لِاِمرِئٍ تُخادِعُهُ ال","ساعاتُ عَن نَفسِهِ فَيَنخَدِعُ",23,"ع",1,0],["يا عَجَبا لِلزَمانِ يَأمَنُهُ","مَن قَد يَرى الصَخرَ عَنهُ وَالوَجَعُ",23,"ع",1,0],["يا عَجَباً مِن جُمودِ عَينٍ","لَم تَعرَ مِن حادِثٍ جَليلِ",24,"ل",1,0],["يا عَجَباً إِنّا لَنَلهو وَقَد","نودِيَ في أَسماعِنا بِالرَحيل",25,"ل",1,0],["يا عَجَباً ما عَجِبتُ يا عَجَبا","مِمَّن إِذا لَم يُسخَر بِهِ غَضِبا",26,"ب",2,1],["يا عَجَباً كُلُّنا يَحيدُ عَنِ ال","حَينِ وَكُلٌّ لِحَينِهِ لاقِ",27,"ق",1,0],["يا عجيباً دُونَهُ كلُّ عجيبْ","أين من سِرِّكَ سِرُّ الكِيميَاءْ",28,"ا",2,0],["يا عَجَباً مِن ناصِحٍ لَم يُطَع","كَم حازِمٍ قَد ضاعَ في جاهِلين",29,"ن",1,0],["يا عَجَباً لِلخِلافِ يا عَجَباً","بِفي الَّذي لامَ في الهَوى الحَجَرُ",30,"ر",1,0],["يا عَجَبا مِن عَبدِ عَمروٍ وَبَغيِهِ","لَقَد رامَ ظُلمي عَبدُ عَمروٍ فَأَنعَما",31,"م",2,1],["يا عجباً للسُّيوف اِسَتَوى","كلِيلُها اليومَ وماضِيها",32,"ي",3,1],["يا عَجَباً كَيفَ يَبتَغي نَفَرٌ","مَرضاتَهُ وَهوَ حَتفُ مَرضاهُ",33,"ا",2,0],["يا عَجَباً يَأمُرُني الشَوقُ أَن","أَرجو رَياها وَياسي نَهى",34,"ن",3,0],["يا عَجَباً لي، أقَمتُ في وَطَنٍ،","ساكِنُهُ كُلّهُمْ على السّفَرِ",35,"ر",1,0],["يَا عَجَباً لِقَادِرٍ","مِن خَادٍ أو مِن خَادِرِ",36,"ر",1,1],["يا عَجَبي مِن سِحرِ أَلحاظِهِ","وَسِحرِ أَلحاظٍ فُتِنّا بِهِ",37,"ب",2,0],["يا عجباً للناس كيف اغتدَوْا","في غفلةٍ عمّا وراء المَماتْ",38,"ت",1,1],["يا عجباً لطيب ريحِ التربِ","إذا تَنَدّى بدموعِ السُحْبِ",39,"ب",1,0],["يا عجبا من معشر سكرهم","أثبتهم في عالم المحو",40,"و",1,1],["يا عجباً من شعرها لما ابتدى","من الثريا وانتهى إلى الثرى",41,"ر",2,0],["يا عجبا من أشعرى غدا","يحمد رأي الناس في الاعتزال",42,"ل",1,0],["يا عَجَباً وَالدَهر في طُروقِهِ","مِن عاشِقٍ أَحسَن من مَعشوقِهِ",43,"ه",1,0],["يا عجباً يرقى عليى قده","ودمع عيني أبداً ما رقى",44,"ق",2,0],["يا عجباً وكلما","عشت يزيد العجب",45,"ب",1,0],["يا عجباً من وشْكِ بَينٍ ما رَغَتْ","فيه مطايَانَا ولا الحادي حَدَا",46,"د",2,1],["يا عجباً صادني عناداً على","وجرةَ ظبيٌ يصاد بالحيلِ",47,"ل",1,0],["يا عَجزَ من يطمعُ في قنيصِها","والليثُ جثَّامٌ على مرصادِها",48,"د",3,0],["يا عجباً منكِ فقدْ","طوَيْتِ نشراً عَجَبَا",49,"ب",2,0],["يَا عجبا مَالقيس ليلى","يشكو الذَّي وصْلُه النّفارا",50,"ر",2,0],["يا عَجباً من جَرَتٍ","أَبصرتُ مِنْه عجبا",51,"ب",2,0],["يا عجباً مني ومن صَبْوَتي","في أَوّل العُمْر بشيْخ هرمْ",52,"م",1,1],["يَا عَجباً لأَدْمُعِي","تَزْكُو بطولِ الإِنْفَاقْ",53,"ق",1,0],["يا عجباً للطِّرسِ في كَفِّه","وكيفَ لا يبتَلُّ باليَمِّ",54,"م",1,0],["يا عَجيبَ الذَكاءِ يا نادِرَ المِث","لِ الَّذي ظَلَّ لِلعَجائِبِ مَظهَر",55,"ر",1,0],["يا عَجَباً لابن عطاءٍ رَوى","وربّما صرّحَ بالمنكَرِ",56,"ر",1,1],["يا عجباً وللزمانِ عَجَبٌ","يَلقى ذوو الفكرِ به ضُلاَّلَها",57,"ل",3,0],["يا عَجباً تَخْجلُ مِن ضَمَّها","ولا تُبالي كيفَ أصْمَتْنِي",58,"ن",2,0],["يا عجباً أَبْصَرْتُ في السوقِ","ما أبْصَرَتْهُ عينُ مخلوقِ",59,"ق",1,1],["يا عجباً للبهرجِ الزائفْ","والمُسْلِفِ الحالقِ والناتفْ",60,"ف",1,1],["يا عجباً للذين ظل بهم فر","ط عما لا يحل في المقل",61,"ل",1,0],["يا عَجَبا مِنْ مُوَلعٍ بطَعْنِهِ","وسَبِّه لعُصْبَةٍ ولَعْنهِ",62,"ه",1,0],["يا عَجَباً تَكثر عصيانه","وَتَدعي أَنك تَخشاه",63,"ا",2,0],["يا عَجَبا مَن بارك دَهره","وَهوَ عَظيم الجسم ممتد",64,"د",1,1],["يا عَجَباً مِن غَفلَتي بَعدَ أَن","نادانِيَ الشَيبُ أَلا فَارحَلَن",65,"ن",1,0],["يا عَجَباً مِن موقِنٍ بِالجَزا","وَهوَ قَليلُ الخَوفِ لِلَّهِ",66,"ل",2,0],["يا عجباً لشيخنا الأهوازي","يزهى علينا وهو في هوّاز",67,"ز",1,1],["يا عجبا للقُلوب حاجتهُا","إلى الغواني والحبُّ مِقْوَدُهَا",68,"د",3,0],["يا عجباً من شادن أحور","مرتب يملكه قرد",69,"د",1,0],["يا عَجَباً مِن هَلِعٍ جازِعٍ","يُصبِحُ بَينَ الذَمِّ وَالوِزرِ",70,"ر",1,0],["يا عجباً والدهر ذو عجائب","من شاهد وقلبُه كالغائب",71,"ب",1,1],["يا عجبا والواو تلسعنا","والعين ترمي سهمها صائدي",72,"د",2,0],["يا عجبي من شادن أهيف","يطارد الخيل ويثني الرماح",73,"ح",1,0],["يا عجبا من قمر محسود","هل فيه مرجى ليد الحسودِ",74,"د",1,0],["يا عَجوزاً صادَفَتها","لَيلَةٌ شَتواءُ قَرَّه",75,"ر",2,0],["يا عجَباً ماذا دَهى وحدَتنا","بعدَ التآلُفِ فما معنى الجَفا",76,"ا",1,0],["يا عجباً لِفئةٍ قد فقدت","كلَّ المزايا وغدت تشكو العَنا",76,"ا",1,0],["يا عجَباً نَبذَها الجيلُ الذي","هبطَ أوجُهُ وحَبلٌه ارتخى",76,"ا",1,0],["يا عَجَباً مِن حُرُقاتِ الهَوى","تَصعَدُ نيراناً وَتَجري مِياه",77,"ه",1,0],["يا عجوزاً هي للآناف جيفه","ولعزرائيلَ في الأرض خليفه",78,"ف",2,1],["يا عجوزاً قبيحة شوهاءَ","تزعج الأرض ان بدت والسماءَ",79,"ا",2,1],["يا عجبي من بائع دينه","بلذّة يبيع فيها مُناه",80,"ه",1,1],["يا عجباً ودهرنا عجائب","يعيبني من كله معائب",81,"ب",1,1],["يا عجبا ماذا يضرُّ الفَتى","سَبقُ سواهُ وهو لم يوثَقِ",82,"ق",1,0],["يا عَجَباً لمَنْ غَدا","يهْدِي أئمّةَ الهُدَى",83,"د",2,1],["يا عجباً ليُوسُفٍ يهْتَدي","بالنجْمِ منّي وهْوَ شمْسُ الضُّحى",84,"ح",2,1],["يا عجباً هل يركبُ القَينُ الفَرَس","وعَرَقُ القينِ على الخيل نَجَس",85,"س",1,1],["يا عجبا إِذ يَقبِض الحُساما","بِأَنمُلٍ لا تَعرف اِنضِماما",86,"م",2,0],["يا عجباً والجمال ذو عجب","لا زالَ يبدي لناظري العجبا",87,"ب",2,0],["يا عجبا من ذاك كيف جازا","وقدموه دون أن يمازا",88,"ز",2,0],["يا عجباً لمن يرومُ العجبْ","فيمن يرى أو قد يصوغ الذهبْ",89,"ب",1,1],["يا عجل الرحمان بسطته","للدين حتى تأمن السبل",90,"ل",1,0],["يا عجب يا عجب","من سار معنا تعجب",91,"ب",1,0],["يا عَجَباً لِطَىِّ هذا الدَّهرِ ما","يَنشُرُهُ وَنشرِهِ ما قَد طَوى",92,"ا",1,0],["يا عجباً من صُنع ربِّ السَما","في الارض يَمشي قمرٌ زاهر",93,"ر",1,0],["يا عَجَباً مِن ساكِنٍ مُقلَتي","كَيفَ نَجا مِن دِمعِها السائِلِ",94,"ل",1,0],["يا عجباً من طفل رقاصها","يقرء في الجزء بتباعتي",95,"ي",1,0],["يا عجبي منها ومن شأنها","عدوّة للناس معشوقه",96,"ق",2,0],["يا عجبا ذبابة لا تُرى","تضحك من فراشة حالمة",97,"م",2,0],["يا عجلة الخطْوات فالممشا بساقا مبرما","لا حرّك النسمه طرف ثوبك ومالت خطوتيك",98,"ك",1,0],["يا عجبا من صد عن قتلها","والقتل أهنى عيشة الغضر",99,"ر",1,0],["ياعجباً للحبِ في حكمهِ","وبيعه المولى إلى عبدهِ",100,"د",2,0],["يَاْ عِجْلَةً خَيَّبَتْ آمَاْلَ وَاْلِدِهَاْ","جَهْلاً، وَعَاْشَتْ مَعَ الأَوْغَاْدِ فِيْ خَطَرِ",101,"ر",1,0],["يا عجبا من قائل لم يجد","معنى فقاس الشمس يوما به",102,"ب",2,0],["يا عجولا ما اشتد إلا تأنى","في مراد ولم ينل ما تمنى",103,"ن",2,1],["يا عجباً من صروف الزمان","تعد الفضيلة فينا سخف",104,"ف",1,0],["ياعجبا والشمس في أفقها","شرفنا البدر وحيانا",105,"ن",2,0],["يا عجبا للمرء مع علمه","أن ليالي عمره عاريه",106,"ه",1,1]]}