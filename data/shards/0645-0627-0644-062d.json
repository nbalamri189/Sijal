{"poems":[[88,"مسدي الجميل بلا من يكدره","https://www.aldiwan.net/poem10374.html","البسيط"],[53,"ما لحيتاننا جفتنا وأنى","https://www.aldiwan.net/poem66012.html","الخفيف"],[93,"زعم المرء إنما هو رب","https://www.aldiwan.net/poem62799.html","عموديه"],[87,"قف بروما وشاهد الأمر واشهد","https://www.aldiwan.net/poem63737.html","الخفيف"],[107,"أقبلوا أو فاتقوا سوء المرد","https://www.aldiwan.net/poem44205.html","الرمل"],[54,"ما لحبيبي كسلان في فكر","https://www.aldiwan.net/poem27213.html","المنسرح"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54844","الخفيف"],[53,"ما لحيتاننا جفتنا وأنَّى","https://www.poetsgate.com/ViewPoem.aspx?id=30399",""],[132,"وحباك الإله ملكا وإنصالا","https://www.aldiwan.net/poem50531.html","الخفيف"],[215,"يا نجوم الفنون والدهر ليل","https://www.aldiwan.net/poem46602.html","الخفيف"],[422,"ذكراني عهد الصبا بسعاد","https://www.aldiwan.net/poem54075.html","الخفيف"],[463,"لو شاء سار ليلة النعف وقف","https://www.aldiwan.net/poem56113.html","الرجز"],[473,"كم بحر حرب نقعه آذيه","https://www.aldiwan.net/poem59654.html","الكامل"],[482,"ما لحبل الوصل قد أمسى رماما","https://www.aldiwan.net/poem15278.html","الرمل"],[580,"أنت الأخير هوى وأنت الأول","https://www.aldiwan.net/poem2891.html","الكامل"],[580,"ما هزة الغصن إلا ملك هزته","https://www.aldiwan.net/poem3094.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122791","المنسرح"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122306","الرجز"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119947","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120100","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79886","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124738","الرمل"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131318","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53109","المنسرح"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201032","المنسرح"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204833","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205049","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132551","السريع"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216551",""],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67979","الرمل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62893","المنسرح"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102955","الرمل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94785","الرمل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136558",""],[4764,"قدرة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=30266",""],[4791,"أعذب الحب أكذبه","https://www.poetsgate.com/ViewPoem.aspx?id=28421",""],[5102,"إعدامنا في فجر عيد ..","https://www.poetsgate.com/ViewPoem.aspx?id=12856",""],[5324,"حالة حب.","https://www.poetsgate.com/ViewPoem.aspx?id=212667",""],[5455,"باب النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=213952",""],[5480,"ثوب الحداد","https://www.poetsgate.com/ViewPoem.aspx?id=10980",""],[5589,"ما الحب إلا ما ترون","https://www.poetsgate.com/ViewPoem.aspx?id=187962",""],[5595,"حكامُنا نوّابُنا نيّامُ","https://www.poetsgate.com/ViewPoem.aspx?id=144526",""],[5747,"دهاليز الظلام","https://www.poetsgate.com/ViewPoem.aspx?id=61678",""],[5790,"يا لقومي أين يذهب بي","https://www.poetsgate.com/ViewPoem.aspx?id=111981",""],[5845,"خلِّ الغرامَ يصبٍّ دمعهُ دمهُ","https://www.poetsgate.com/ViewPoem.aspx?id=198429",""],[5952,"نِلْتُ خُفَّا","https://www.poetsgate.com/ViewPoem.aspx?id=201759",""],[5956,"قضية العدل","https://www.poetsgate.com/ViewPoem.aspx?id=192032",""],[463,"لو شاءَ سارٍ ليلة َ النَّعفِ وقفْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60144&r=&rc=200",""]],"verses":[["مالٌ حَلالٌ مُزَكّى ما خَلَطتَ بِهِ","مِلّيمَ سُحتٍ وَلا حَقّاً لِإِنسانِ",0,"ن",1,0],["ما لحيتاننا جفتنا وأنَّى","أخلفَ الزائرونَ مُنتظريهِمْ",1,"م",1,1],["ما لِحَيٍّ بِالمَوتِ عَنهُ اِنفِصالٌ","إِنَّ دُنياهُ هَذِهِ أُخراهُ",2,"ا",2,0],["ما لِحَيٍّ لَم يُمسِ مِنكِ قَبيلٌ","أَو بِلادٌ يُعِدُّها أَوطانَه",3,"ن",2,0],["ما لحقِّ اللَّهِ إلا مُؤمِنٌ","لا يُبالِي غيرَهُ فيما اعتمدْ",4,"د",1,0],["ما لِحَبيبي كَسلانَ في فِكَرٍ","وَقَد جَفا حُسنَهُ وَزينَتَه",5,"ت",2,1],["مَا لِحَيٍّ فِي حُبِّ دَارٍ تُفَدَّى","قَلبُهُ الصَّادِقُ الوَفِيُّ الَغُيورُ",6,"ر",1,0],["ما لحيتاننا جفتنا وأنَّى","أخلفَ الزائرونَ مُنظريهمْ",7,"م",1,1],["ما لحظناك لحظةً قط إلاّ","ومحيّاكَ نُورُه بتَلاَلاَ",8,"ل",2,0],["ما لحرّ إذا تلطّف حظ","في زمان مجرح العدل دون",9,"ن",1,0],["ما لحظي من اغترابي وما لي","موُلعٌ بالاتهام والإِنجاد",10,"د",1,0],["ما لحسودٍ في هواكم عابني","لا رام رفعَ طرفه إلا طُرِفْ",11,"ف",1,0],["ما لِحُرٍّ عَلِقَ العُدمُ بِهِ","مُنقِذٌ غَيرُ يَدي عَبدِ الكَريمِ",12,"م",1,0],["ما لحبلِ الوصلِ قد أمسى رِماما","ولزومِ الصدَّ قد صار لِزاما",13,"م",2,1],["ما لحظُهُ سَهْمٌ وَقَلْبي مَقْتَلٌ","بَلْ كُلُّهُ سَهْمٌ وَكُلِّيَ مَقْتَلُ",14,"ل",1,0],["ما لَحْظُ عينيكِ إِلا شاربٌ ثملٌ","وكسرةُ الجفْنِ إِلا عَيْنُ سَكْرَتِه",15,"ت",2,0],["ما لِحَبيبٍ فَضلٌ علَيّ وَلا","يُحسِنُ قَولي في المَدحِ حَسّانُه",16,"ن",2,0],["ما لحق اللوم غبار عاشق","حدا به من المشيب حادي",17,"د",2,0],["ما لحت في سر الدجى","للبدر إلا واستَسَرا",18,"ر",2,0],["ما لحال بت بالجو","د ترجيحها رزوحُ",19,"ح",1,0],["ما لحيثُ انتهى بكَ الإِسراءُ","لمهبِّ العشرِ العقولِ ارتقاءُ",20,"ا",1,1],["ما لحى من راده ملتحدٌ لا","ولا يدفعه عنه أحد",21,"د",1,0],["ما لحاوي الجَمالِ في الحُسْنِ ثاني","وفُؤادي ما مال عنه لثاني",22,"ن",2,1],["ما لحمام الأراك لا نهضت","بحمله في الغصون أوكار",23,"ر",1,0],["ما لحياتي تسير مسرعة","إن دعيتْ للوقوف لم تقف",24,"ف",1,1],["ما لحرية الورى أي شأن","إن تقسها بثورة للعبيد",25,"د",1,0],["ما لحمه الا لحوم جدودكم","وعظامه من عظم جد حُطِّما",26,"م",2,0],["ما لحظ الوهم حماها على","ان مزاياها بدت سافرات",27,"ت",1,0],["مَالِحْ حلو واحد فِيْ الابصار","الما، لَكَنَّ الْفَرْقْ فِيْ الحلج",28,"ج",1,0],["ما لحصرِ المدحِ فيكم أَمَدٌ","فقُصوري عن دِراكِ المدح مدح",29,"ح",1,0],["ما لِحَمَامِ الأَراكِ منتشياً","يَحْسَبُ شَوقي والحُزْنُ من جَلبِهْ",30,"ب",2,0],["ما لحظت الشر إلا شردا","أو طردت الليث إلا انطردا",31,"د",2,0],["ما لحالي بانحلالٍ وانعدام","ما لأمني في هلاكٍ وخَطر",32,"ر",1,0],["مالَ حتى قد طمعتُ به","ليناً لولا أخو حَجره",33,"ر",2,0],["ما لَحقت روحي ،، تشوفه بعيني","ولا تزيحه او تزيح استتاره",34,"ر",2,0],["مالحق قلبي بحبك مطلبه","أنت ناسيني وأنا راسي عنيد",35,"د",1,0],["ما لحمُ خرفانٍ ذبحْتمْ بعده","وبأي مِلح تنشرونه للقَدِيدْ",36,"د",1,0],["ما لحرفي تاه مني.. وانا اك","تب شعري. ماله احمر القلم",37,"م",1,0],["مالحزني صوت ؟ .. مدري هو خطأ والا صواب !","بس أعرف أني حزين وصوتي الليله جهور",38,"ر",1,0],["م الحزن قرطاس شعري والحبر دمع ٍ يزوف","من عيوني خول دمع ٍ صالي ٍ عاف المهاد",39,"د",1,0],["مالحب إلا ما ترون","عين مطرزة بمين",40,"ن",1,1],["مالٌ حرامٌ أصلُه النارُ التي","قد وُزّعَتْ بجهنمٍ أقسامُ",41,"م",1,0],["مالحق كف العطا مليون منه","بس يكفي لو خذلت الإنعدام",42,"م",1,0],["ما لحمي خده أثر","بجوار البرد في الشنب",43,"ب",1,0],["مالحبُّ إلاَّ لقومٍ يعرفونَ بهِ","قدْ مارسوا الحبَّ حتى هانَ معظمهُ",44,"م",2,0],["ما لِحرفيْ اليوم أن يمدَحَها","لا أراني من (حُنَينٍ) نِلتُ خُفَّا",45,"ف",2,0],["ما لحظة إلا ويقتل أهلهُ","قابيلُ رغم تحضُّرٍ متعاظمِ",46,"م",1,0],["ما لحسودس في هواكمْ عابني","لا رامَ رفعَ طرفهِ إلاَّ طرفْ",47,"ف",1,0]]}