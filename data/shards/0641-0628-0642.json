نِّيرَانُ تَتَّفِقُ!","https://www.poetsgate.com/ViewPoem.aspx?id=215805",""]],"verses":[["فَبَقينا عَلى الشَناءَةِ تَنمِي","نا حُصونٌ وَعِزَّةٌ قَعساءُ",0,"ا",2,0],["فبقيتَ شمساً في سماء خلافة","لا يستطيعُ لها الزمانُ زوالا",1,"ل",2,0],["فبقيتَ شمساً في سماء خلافةٍ","وهُمُ البدورُ أمدّهن سناكا",2,"ك",2,0],["فبقيتم لصلاح","بكمُ لا شك يبقى",3,"ق",2,0],["فَبَقِيّاتُ طينِهِ لاقَتِ الما","ءَ فَصارَت عُذوبَةً في الزُلالِ",4,"ل",1,0],["فَبقِيتَ مرهوبَ الجَنابِ مؤمَّلاً","من شأنِكَ الإغناءُ والإفقارُ",5,"ر",1,0],["فبقِيت للإسلام تنصُرُهُ","والمُلكِ تأخذُ منه ما تَهَبُ",6,"ب",1,0],["فَبَقيتَ في العليا لتدميرِ العِدَى","وغِنى الفَقير وفرجةِ المَكروبِ",7,"ب",1,0],["فبقدِّها وبخدِّها وبثغرِها","غصنٌ وتفاحٌ وحبُّ غمامِ",8,"م",1,0],["فَبَقيتُ مُضنىً في مَحَبَّتِها","مُرَّ الوِصالِ مُكَرَّهَ القُربِ",9,"ب",1,0],["فَبِقَطرَةٍ مِنُ تَبوخُ جَهَنَّمٌ","فيما يُقالُ حَديثُ غَيرِ مُشاهِدِ",10,"د",1,0],["فَبِقَلْبِ كُلِّ فَتىً غَرامٌ كامِنٌ","وبِعِطْفِ كُلِّ مَلِيحَةٍ خُيَلاءُ",11,"ا",2,0],["فبقينا على الشناءة تنمي","نا حصونٌ وعزةٌ معساء",12,"ا",2,0],["فبقطرَةٍ منهُ تَبوخُ جهنّمٌ","، فيما يُقالُ، حديثُ غيرِ مُشاهد",13,"د",1,0],["فبْقَ لا فلَّ جدَّكَ اللَّهُ عن حدٍّ","ولا فَضَّ عن عديدٍ عديدَكْ",14,"ك",1,0],["فَبَقيت ما دامَ الوُجود مُمتِعاً","بِكَ أَيُّها القَمَر المُنير الساطِعُ",15,"ع",1,0],["فبقربه طيب الحياة وانه","بعذيب ريقته شفاء سقامي",16,"م",2,0],["فبقدرك العالي وجاهك داولي","بشفاء عطفك فالفؤاد عليل",17,"ل",1,0],["فَبَقِيتُ المُدَلَّهَ الحائِرَ الصَّبب","آسُبُّ امرءاً صباً أو تَصَابى",18,"ب",2,0],["فَبَقيتَ تُبدِعُ في الفَعالِ فَإِنَّني","في القَولِ يا شَرَفَ المَعالي أُبدِعُ",19,"ع",1,0],["فَبَقاءُ المَديحِ ما لَم يَكُن في","كَ بَقاءُ الحَبابِ فَوقَ السُلافِ",20,"ف",1,0],["فَبَقيتَ مَحروسَ الفِناءِ مُهَنَّأً","في سائِرِ الأَعوامِ وَالأَحوالِ",21,"ل",1,0],["فَبَقيتَ ما شِئتَ البَقاءَ مُعَظَّماً","وَسَقى الغَمامُ رَميمَ تِلكَ الأَعظُمِ",22,"م",1,0],["فَبَقيتَ مِن خَلَفٍ تَكَفَّلَ لِلعُلى","أَلّا يَبيتَ بِغَيرِها مَهموما",23,"م",2,0],["فبقاؤه وبقاء مشبهه","زمن لأهل الأرض والأرض",24,"ض",1,0],["فبقيت والأعداء ساهمة","جذلان في دعة وفي خفض",24,"ض",1,0],["فَبَقِيتُمُ لِلمكرُماتِ وَلِلعُلى","أَبَداً بَقاءَ عَمايَتَينِ وَيَذبلِ",25,"ل",1,0],["فَبَقيتَ ما بَقِيَ الزَمانُ لِذا الوَرى","كَهفاً نَلُوذُ بِهِ وَسِتراً مُسبَلا",26,"ل",2,0],["فَبَقيتَ بَقاءَ الدَهرِ وَرُح","نَ لَكَ الأَيّامُ مِنَ الخَدَمِ",27,"م",1,0],["فبقيتَ ما بقي الزمان مُهنَّأً","بيديك يَقْوَى الأمنُ والإيمان",28,"ن",1,0],["فَبَقيتَ لِلدُنيا تَبُ","ثُّ العَدلَ في أَرجائِها",29,"ا",3,0],["فَبِقُرْبِي إِلَيْكَ وَهْوَ خَليقٌ","بِإِجَابَتِي لَوْ يُجَابُ الدُّعَاءُ",30,"ا",2,0],["فبقاء مجدك حُلي دهر عاطل","ومضاء عضبك للمصائب صائب",31,"ب",1,0],["فبقيتُ حتى اليومَ من أنفاسِها","أهوى البنفسجَ آملاً إن أزهرا",32,"ر",2,0],["فَبَقِيتُما عُمُرَ الزَّمانِ مُصاحِبيْ","عَيْشٍ تَجَنَّبُ صَفْوَهُ الأَكْدارُ",33,"ر",1,0],["فبقي أهل الضروات بها","مثل حوت بخره قد نشفا",34,"ف",2,0],["فَبَقيتَ تَلحظُ مِن أسرّةِ وَجههِ","بَرقَ الرّضا ينهلّ منه قرورُ",35,"ر",1,0],["فَبِقَتلي لَهُ وَكانَ المُرَجّى","سَوفَ تَرتَجُّ ذي المَمالِكِ رَجا",36,"ج",2,0],["فَبِقِيتُ أَهْرُبُ وَهْي تُلْ","فِي جَارَةً مِن بَعْدِ جَارَه",37,"ر",2,0],["فَبَقِيتَ لي يَامن قَنا","دِيلي بهِ أَبَداً مُضِيَّه",38,"ه",1,0],["فَبَقيتُ كَالياقوتِ لا أَخشى بِها","عَرَضاً يُغَيِّرُ جَوهَري النَفساني",39,"ن",2,0],["فَبقِيتَ للإسلام يا شَرفاً له","حتّى تكونَ لنَقْصِهمْ تَكْميلا",40,"ل",2,0],["فَبقِيتَ في حُلَلِ المَناقبِ رافِلاً","ما شاقَ إيماضُ البُروقِ اللُّمَّع",41,"ع",1,0],["فَبقِيتُما مُتَسرْ بِلَىْ حُلَلٍ","للعِزِّ لا يُخشَى لها سَلب",42,"ب",1,0],["فبقيتُ لا أدري أمن أُسَرائهِ","أصبحتُ بين النّاس أم طُلَقائه",43,"ا",3,0],["فبَقيِتَ واسطةً له لتَزينَه","ولكَيْ تُحاكِيَه امتدادَ بَقاء",44,"ا",2,0],["فَبَقيتُ مَفقوداً بِغَيرِ مُصاحِبٍ","وَيَظَلُّ مَوجوداً بِغَيرِ زَمانِ",45,"ن",1,0],["فبقُربها تذرُ الخسيس نفيسا","وببعدها تذر النفيس خسيسا",46,"س",2,0],["فبقدر ما تعني ستنل","ما تمنى فاتعبن أكبر قدر",47,"ر",1,0],["فبقيت مسلوب الفؤاد مشرداً","عني الرقاد مكابداً لتوجعي",48,"ع",2,0],["فبقيت آونة أعض يدي","وأخط آونة على الترب",49,"ب",1,0],["فَبَقيتُما للمُسلِمِي","نَ حِمىً وللدّنيا جَمالا",50,"ل",2,0],["فبقيت يا خير الورى ما غرّدت","في مورق الأغصان ورقُ حمام",51,"م",1,0],["فبقيتَ لي وله وآيةُ معجزي","لولاك في إظهاره لم تَصدعِ",52,"ع",1,0],["فبقيتم والحاسدون علاكُمُ","لا خيرَ فيما ليس فيه حسودُ",53,"د",1,0],["فبقيتَ سيف الدولة بنِ سيوفها","عُمْر الزمان لنجدةٍ وعَطاءِ",54,"ا",2,0],["فبقيتَ يا تاجَ الملو","كِ على الأجانبِ والصِّحابِ",55,"ب",1,0],["فبقيتَ يا تاجَ المُلوكِ للائذٍ","مستعصمٍ ولمُسنتٍ مستمْطرِ",56,"ر",1,0],["فبَقائي منْ فنائي فيكمُ","وسُروري منكُمُ في حَزَني",57,"ن",2,0],["فَبَقيتَ يا تاجَ المُلوكِ","على الرَّعيَّةِ والمَمالِكْ",58,"ك",1,0],["فبَقيتَ يا من صان وجهيَ جودُه","ونَوالُهُ عنْ ذِلَّةٍ وتَبَذُّلِ",59,"ل",1,0],["فبقيت يا شمس الزَّمانِ وعَيْشه","لرَشادِ حَيْرانٍ وثَرْوةِ عائلِ",60,"ل",1,0],["فَبَقيتَ يا غَرْسَ الخِلافة قائماً","بالمجْدِ يحْميك القديمُ الأوَّلُ",61,"ل",1,0],["فَبَقيتَ لي ولِكُلِّ ذي أمَلٍ","ما عَزَّتِ الأرْماحُ والقُضُب",62,"ب",1,0],["فبقيتَ تنعمُ بالسعادة خادماً","والأَمنِ داراً والسلامةِ مركبا",63,"ب",2,0],["فبقيتَ تحيى باللَّهى رممَ المنى","كرماً وتقتل بالسمَّاح العسجدا",64,"د",2,0],["فبقيتم فإن أنفسنا تسمو","بآمالكم عن الإسفاف",65,"ف",1,0],["فبقيت ما بقيت فأيسرُ عمرها","يفنى به عمر الزمان الأطول",66,"ل",1,0],["فبقيت في ظلً تسا","ير عمرً عزٍ ليس ينفد",67,"د",1,0],["فبقيتما عمرَ البقاءِ فإنهُ","يبقى ويفنى الدهرَ طول خلوده",68,"د",2,0],["فبقيتمُ لمؤمل يبغي الغنى","أو مجرمٍ يرجو سماح الغافر",69,"ر",1,0],["فبقدر كد المرء يقتطف الجنى","ليس النشيط سيان والمكسال",70,"ل",1,0],["فبقيتما وبقيت وحدي ناظماً","في جيد مجدكما عقود جواهري",71,"ر",2,0],["فبقيتم وعلي حسن ثنائكم","وعليكم الإحسان والإنعام",72,"م",1,0],["فبقايا آثاره سخنة العي","ن وألفاظه شجا الآذان",73,"ن",1,0],["فبقدر ما أحميتُهمْ ما ساءهمْ","أعطيتُهمْ من تالِدِي وطريفي",74,"ف",2,0],["فَبَقاءُ مَن حُرِمَ المرادَ فناؤُه","وفناءُ من بلغ المرادَ بقاءُ",75,"ا",2,0],["فبقولِه حَدُّ الحسام مُفللاًّ","وبرأْيه خدُّ الهزَبْر مُعَفَّرا",76,"ر",2,0],["فبقيت تحت ظلال ربك في حمى","ورغيد عيش مخضل تتنعم",77,"م",1,0],["فبقدر صنع المرء يلقى اجره","ع