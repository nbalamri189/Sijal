{"poems":[[55,"ستعلمون ما يكون مني","https://www.aldiwan.net/poem29652.html","الرجز"],[57,"إن الغلام الذي أعطاك خاتمه","https://www.aldiwan.net/poem26199.html","البسيط"],[59,"إن الغريب له مخافة سارق","https://www.aldiwan.net/poem24658.html","الكامل"],[9,"أثوى وقصر ليلة ليزودا","https://www.aldiwan.net/poem21927.html","الكامل"],[75,"ما طول عذلك للمحب بنافع","https://www.aldiwan.net/poem11925.html","الكامل"],[95,"وارحمتا لمصاب","https://www.aldiwan.net/poem11151.html","المجتث"],[90,"إن رمت عيشا ناعما ورقيقا","https://www.aldiwan.net/poem44987.html","الكامل"],[29,"بان الخليط فما له من مطلب","https://www.aldiwan.net/poem5661.html","الكامل"],[29,"هاج الهوى لفؤادك المهتاج","https://www.aldiwan.net/poem5696.html","الكامل"],[29,"صرم الخليط تباينا وبكورا","https://www.aldiwan.net/poem5774.html","الكامل"],[49,"غيري يغيره الفعال الجافي","https://www.aldiwan.net/poem25226.html","الكامل"],[49,"أهدى إلي صبابة وكآبة","https://www.aldiwan.net/poem25296.html","الكامل"],[49,"ولقد علمت وما علم","https://www.aldiwan.net/poem25318.html","مجزوء الكامل"],[53,"أشجتك منزلة بمرجي راهط","https://www.aldiwan.net/poem65022.html","الكامل"],[93,"كان على خوان رب المال","https://www.aldiwan.net/poem62626.html","عموديه"],[93,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[91,"الفن روض أنيق غير مسؤوم","https://www.aldiwan.net/poem44743.html","البسيط"],[91,"ان الغريب يعز فكرك فكره","https://www.aldiwan.net/poem44768.html","الكامل"],[91,"صبوا على الاسماع نارا","https://www.aldiwan.net/poem44849.html","مجزوء الكامل"],[87,"عادت أغاني العرس رجع نواح","https://www.aldiwan.net/poem21008.html","الكامل"],[87,"يا أخت أندلس عليك سلام","https://www.aldiwan.net/poem63741.html","الكامل"],[47,"بسماحك المستقبل المستدبر","https://www.aldiwan.net/poem63568.html","الكامل"],[47,"اسمع هديت أبا يحيى مقال أخ","https://www.aldiwan.net/poem64548.html","البسيط"],[47,"يهدي الخيال لنا ذكرى إذا طافا","https://www.aldiwan.net/poem65152.html","البسيط"],[47,"لو أسعدت سعدى بتنويلها","https://www.aldiwan.net/poem65586.html","السريع"],[47,"إنك والاحتفال في عذلي","https://www.aldiwan.net/poem65613.html","الخفيف"],[47,"يكاد عاذلنا في الحب يغرينا","https://www.aldiwan.net/poem66673.html","البسيط"],[47,"رحلت وأودعت الفؤاد لواحظا","https://www.aldiwan.net/poem66839.html","الكامل"],[63,"قل لابن فهد وإن شطت منازله","https://www.aldiwan.net/poem51713.html","البسيط"],[60,"صرمت حبالك بعد وصلك زينب","https://www.aldiwan.net/poem31129.html","الكامل"],[51,"من احس لي أهل القبور ومن رأى","https://www.aldiwan.net/poem10324.html","الكامل"],[51,"من لم يعظه التجريب والأدب","https://www.aldiwan.net/poem10379.html","المنسرح"],[68,"إن الغنى كشهاب كلما اعتكرت","https://www.aldiwan.net/poem38560.html","البسيط"],[99,"عدنا وعدت وعادت","https://www.aldiwan.net/poem24904.html","المجتث"],[82,"هل كان أودع سر قلب محجرا","https://www.aldiwan.net/poem31438.html","الكامل"],[89,"لا تعكفن على المدام","https://www.aldiwan.net/poem8220.html","الكامل"],[71,"غيري يغيره الجفا","https://www.aldiwan.net/poem28552.html","مجزوء الكامل"],[71,"أدر أحاديث سلع والحمى أدر","https://www.aldiwan.net/poem28789.html","البسيط"],[35,"إن الغواني قتلت عشاقها","https://www.aldiwan.net/poem25856.html","الكامل"],[107,"هل ليم نضو صبابة فأفاقا","https://www.aldiwan.net/poem43377.html","الكامل"],[83,"طرقت منقبة تروع تحجبا","https://www.aldiwan.net/poem61559.html","الكامل"],[21,"إن الغلام مطيع من يؤدبه","https://www.aldiwan.net/poem36247.html","البسيط"],[52,"يا ليلتي لم أنم شوقا وتسهادا","https://www.aldiwan.net/poem63896.html","البسيط"],[52,"يا شوق من بات مشغوفا ومجتنبا","https://www.aldiwan.net/poem64811.html","البسيط"],[48,"أسر إن كنت محمودا على خلق","https://www.aldiwan.net/poem22395.html","البسيط"],[48,"قد رضت نفسي حتى ذل جامحها","https://www.aldiwan.net/poem22887.html","البسيط"],[48,"سقيا لشوهاء ما همت بفاحشة","https://www.aldiwan.net/poem23162.html","البسيط"],[70,"زدني بفرط الحب فيك تحيرا","https://www.aldiwan.net/poem1498.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85513","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85582","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85430","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42654","الكامل"],[74,"وهارب من رضوان","https://www.poetsgate.com/ViewPoem.aspx?id=45465",""],[102,"الحبّ القتيل","https://www.poetsgate.com/ViewPoem.aspx?id=50345",""],[96,"على أطلال الجزيرة العربية","https://www.poetsgate.com/ViewPoem.aspx?id=15663",""],[29,"بَانَ الخَليطُ فَمَا لَهُ مِنْ مَطْلَبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=16342&r=&rc=6",""],[112,"إن الغبي زمانه بسخائه","https://www.aldiwan.net/poem16628.html","الكامل"],[145,"كان الوداد منغصا لوشاتنا","https://www.aldiwan.net/poem58379.html","الكامل"],[189,"إلفان متفقان شتهما الردى","https://www.aldiwan.net/poem43246.html","الكامل"],[189,"ومن العجائب للبي","https://www.aldiwan.net/poem43721.html","مجزوء الكامل"],[189,"ما استشعر الصبر إلا وهو مجهود","https://www.aldiwan.net/poem43908.html","البسيط"],[189,"تصبوا البدور على الغصون على","https://www.aldiwan.net/poem44088.html","الكامل"],[283,"من كان مثل أبي علي فلينل","https://www.aldiwan.net/poem60759.html","الكامل"],[289,"من كان يملك درهمين تعلمت","https://www.aldiwan.net/poem34067.html","الكامل"],[307,"إن القناعة كنز ليس بالفاني","https://www.aldiwan.net/poem16811.html","البسيط"],[325,"بان الخليط فشطوا بالرعابيب","https://www.aldiwan.net/poem56349.html","البسيط"],[368,"هاج لك الشوق من ريحانة الطربا","https://www.aldiwan.net/poem44539.html","البسيط"],[396,"ان الغويري له نكهة","https://www.aldiwan.net/poem53492.html","السريع"],[408,"قالت وقد راودتها عن قبلة","https://www.aldiwan.net/poem49484.html","الكامل"],[413,"أمسى المشيب من الشباب بديلا","https://www.aldiwan.net/poem67485.html","الكامل"],[500,"يا مهدي الرشأ الذي ألحاظه","https://www.aldiwan.net/poem3709.html","الكامل"],[542,"إن الغواني قد أعرضن مقلية","https://www.aldiwan.net/poem56844.html","البسيط"],[542,"أقصرت عن جهلي الأدنى وحلمني","https://www.aldiwan.net/poem56858.html","البسيط"],[560,"إن الغني إلى المولى من افتقرا","https://www.aldiwan.net/poem34492.html","البسيط"],[564,"قامت لهيبتها غصون البان","https://www.aldiwan.net/poem52803.html","الكامل"],[564,"الفضل من أهل الكرامة يعرف","https://www.aldiwan.net/poem52807.html","الكامل"],[718,"","https://poetry.dctabudhabi.ae/diwan/poem/28254","الطويل"],[1164,"","https://poetry.dctabudhabi.ae/diwan/poem/20648","البسيط"]],"verses":[["إِنَّ الغِنى مَجلَبَةٌ لِلضَنِّ","وَلِلقُعودِ وَالرِضا بِالوَهنِ",0,"ن",1,0],["إِنَّ الغُلامَ الَّذي أَعطاكِ خاتَمَهُ","في سَطحِ أَزهَرَ قَد أَبلاهُ ذِكراكِ",1,"ك",1,1],["إِنَّ الغَريبَ لَهُ مَخافَةُ سارِقٍ","وَخُضوعُ مَديونٍ وَذِلَّةُ موثَقِ",2,"ق",1,1],["إِنَّ الغَوانِيَ لا يُواصِلنَ اِمرَأً","فَقَدَ الشَبابَ وَقَد يَصِلنَ الأَمرَدا",3,"د",2,0],["إِنَّ الغِنى لَهُوَ القَناعَةُ لا الَّذي","يَشتَفُّ نُطفَةَ ماءِ وَجهِ القانِعِ",4,"ع",1,0],["إِنَّ الغُمُوضَ لَخَيْرٌ","لِلنَّفْسِ مِنْ تَوْضِيحِهْ",5,"ح",2,0],["إن الغناء لمُحدث لك نَشوة","في النفس تُطفىء في حشاك حريقا",6,"ق",2,0],["إِنَّ الغَواني قَد قَطَعنَ مَوَدَّتي","بَعدَ الهَوى وَمَنَعنَ صَفوَ المَشرَبِ",7,"ب",1,0],["إِنَّ الغُرابَ بِما كَرِهتَ لَمولَعٌ","بِنَوى الأَحِبَّةِ دائِمُ التَشحاجِ",8,"ج",1,0],["إِنَّ الغَوانِيَ قَد رَمَينَ فُؤادَهُ","حَتّى تَرَكنَ بِسَمعِهِ تَوقيرا",9,"ر",2,0],["إِنَّ الغَنِيَّ هُوَ الغَنِيُّ بِنَفسِهِ","وَلَوَ أَنَّهُ عاري المَناكِبِ حافِ",10,"ف",1,0],["إِنَّ الغَزالَةَ وَالغَزالَةَ أَهدَتا","وَجهاً إِلَيكَ إِذا طَلَعتَ وَجيدا",11,"د",2,0],["أَنَّ الغَزالَةَ وَالغَزا","لَ لَفي ثَناياهُ وَجيدِه",12,"ه",1,0],["إن الغوائل في المقاحِط جمَّةٌ","فتوقَّ غائلةَ المرادِ القاحط",13,"ط",1,0],["إِنَّ الغِنى وَالصيتَ وَالذَكاءَ","مَتى أُرِد صَيَّرتُها هَباءَ",14,"ا",2,0],["إِنَّ الغِنى في الوَجهِ لي آفَةٌ","فَلَيتَ أَنّي دُميَةٌ لَيتَني",15,"ي",1,0],["ان الغناء الى محياي يجذبني","وان مشت في طريق الموت بي القدم",16,"م",1,0],["ان الغريب يعز فكرك فكره","ادنى اليك من القريب الزاري",17,"ي",1,1],["ان الغنى في كل وقت","كان ثوبا مستعارا",18,"ر",2,0],["إِنَّ الغُرورَ سَقى الرَئيسَ بِراحِهِ","كَيفَ اِحتِيالُكَ في صَريعِ الراحِ",19,"ح",1,0],["إِنَّ الغُرورَ إِذا تَمَلَّكَ أُمَّةً","كَالزَهرِ يُخفي المَوتَ وَهوَ زُؤامُ",20,"م",1,0],["إِنَّ الغَمامَ أَخاكَ جادَ بِمِثلِ ما","جادَت يَداكَ لَوَ اَنَّهُ لَم يَضرُرِ",21,"ر",1,0],["إِنَّ الغُثا اِبنَ أَبي مَنصورَ بادَلَني","بَغياً وَأَنتَ عَلَيهِ بَعضُ أَنصاري",22,"ر",2,0],["إِنَّ الغَواني غَداةَ البَينِ قِضنَ لَنا","ما أَمَّلَ الدَنِفُ المُضنى بِما خافا",23,"ف",2,0],["إِنَّ الغَواني يَومَ سِقطِ اللِوى","أَدَّت إِلَينا الإِفكَ مِن قيلِها",24,"ل",3,0],["إِنَّ الغَواني رَدَدنَ خائِبَةً","رَسائِلي وَاِعتَذَرنَ مِن رُسُلي",25,"ل",2,0],["إِنَّ الغَواني غَداةَ الجِزعِ مِن إِضَمٍ","تَيَّمنَ قَلباً مُعَنّى اللُبِّ مَحزونا",26,"ن",2,0],["إِنَّ الغَرائِرَ يَومَ جَرعاءِ الحِمى","أَغرَينَ دَمعَ العَينِ بِالهَمَلانِ",27,"ن",1,0],["إنَّ الغُصونَ التي رَوَّيْتَها شحَبَتْ","وكيف نُضرتُها والماءُ قد نَفَدا",28,"د",2,0],["إِنَّ الغَنِيَّ مِنَ الرِجالِ مُكَرَّمٌ","وَتَراهُ يُرجى ما لَدَيهِ وَيُرهَبُ",29,"ب",1,0],["إِنَّ الغِنى لَهُوَ القُنوعُ بِعَينِهِ","ما أَبعَدَ الطِبعَ الحَريصَ مِنَ الغِنى",30,"ا",1,0],["إِنَّ الغِنى في النُفوسِ وَالعِزُّ تَق","وى اللَهِ لا فِضَّةٌ وَلا ذَهَبُ",31,"ب",1,0],["إِنَّ الغِنى كَشِهابٍ كُلَّما اِعتَكَرَت","دُجى الخُطوبِ جَلا مِنها حِنادِسَها",32,"ه",2,1],["إن الغريب التَّنائي","فإن فيه شقائي",33,"ي",1,0],["إِنَّ الغرامَ غرامُهُ ذو سَوْرَةٍ","وَمِنَ العيونِ على القلوبِ تَسَوّرا",34,"ر",2,0],["إِنَّ الْغِنَاءَ سَرِيرَةٌ فِي النَّفْسِ قَدْ","ضَاقَتْ بِهَا فَتَفَجَّرَتْ أَلْحَانَا",35,"ن",2,0],["إن الغنيَّ هو الغنيّ","بربِّهِ والمالُ فَيْ",36,"ي",1,0],["إنَّ الغزالةَ لمَّا أن شفعتَ نجتْ","وفزتَ بالشكرِ في الآرامِ والعفُرِ",37,"ر",1,0],["إِنَّ الغَوانِيَ قَتَّلَت عُشّاقَها","يا لَيتَ مَن جَهَلَ الصَبابَةَ ذاقَها",38,"ق",3,1],["إِنَّ الغِوايَةَ لِلرِجالِ تِجارَةً","تَلِدُ البَوارَ وَتورِثُ الإِخفاقا",39,"ق",2,0],["إِنَّ الغَليظَ مِنَ الرِقابِ إِذا عَتا","لَم يَنهَهُ إِلّا الرِقاقُ مِنَ الظُبى",40,"ب",2,0],["إِنَّ الغُلامَ مُطيعٌ مَن يُؤَدِّبُهُ","وَلا يُطيعُكَ ذو شَيبٍ بِتَأديبِ",41,"ب",1,1],["إِنَّ الغَرائِبَ لا تولي مَحارِمَها","فَاِطعَن بِرُمحِكَ مَحلوباً وَوَلّادا",42,"د",2,0],["إِنَّ الغَوانِيَ لا يُغنينَ مَسأَلَةً","وَلا تَرى مِثلَ ما يَسلُبنَنا سَلَبا",43,"ب",2,0],["إِنَّ الغِنى لَعَزيزٌ حينَ تَطلُبُهُ","وَالفَقرُ في عُنصُرِ التَركيبِ مَوجودُ",44,"د",1,0],["إِنَّ الغُمودَ إِذا سُلَّت صَوارِمُها","قُلنَ اليَقينَ وَأَلغَينَ المَعاريضا",45,"ض",2,0],["إِنَّ الغُرابَ وَلَم يوجَد أَخو قَدَمٍ","أَصَحَّ مِنهُ تُعاني رِجلُهُ قَزَلا",46,"ل",2,0],["إنَّ الغرامَ هوَ الحياةُ فمُتْ بِهِ","صَبّاً فحقّك أن تَموتَ وتُعذرا",47,"ر",2,0],["إن الغناء يثير في ال","إنسان مبهمة الخواطرْ",48,"ر",1,1],["إن الغرور لجاعل","بين النهى والحق سدا",49,"د",2,0],["إنَّ الغشمشم وَالجبان كلاهما","في مثل تلك الحال يستَويان",50,"ن",1,0],["إِنَّ الْغِني وَالْفَقْرَ في هَذَا الْوَرَى","لَمُقَدَّرٌ وَاللَّهُ ذُو قِسْطَاسِ",51,"س",1,0],["إنَّ الغمام المنَّان","يجودنا في الأحيان",52,"ن",1,0],["إنّ الغرام الذي قد كنت أنشده","أغاني الروح قد أصبحت أرثيه",53,"ي",2,0],["إنّ الغزالة لو ملكتم أمرها","لحبستم عن جلّق آرادها",54,"د",3,0],["إنَّ الغوانيَ قدْ قطعنَ مودتي","بعدَ الهوى ومنعنَ صفوا المشربِ",55,"ب",1,0],["إِن الغَبيَّ زَمانَهُ بِسَخائِهِ","يُمضي رَبيعاً في الفُصول الأَربَع",56,"ع",1,1],["إن الغصونَ يعودُ حُسنُ قَوامِها","من بعد ما مالت بهزِّ صراصرِ",57,"ر",1,0],["إن الغبينة في انقلابك رائداً","وطنا يسرّ فلا تحِسُّ أمانا",58,"ن",2,0],["أن الغبيّ من الرجا","ل إذا أظلّته النُحوس",59,"س",1,0],["إن الغويّ الذي تحلو جوارحه","من لوعة الحب والمهجور مكمود",60,"د",1,0],["إن الغواني يطبيهنّ الفتى","ويرينه بلحاظ طرف أدعج",61,"ج",1,0],["إِنَّ الْغَمامَ إِذا تَرادَفَ وَبْلُهُ","أَبْقى أَنِيقَ الرَّوْضِ غَيْرَ مُرَوَّضِ",62,"ض",1,0],["إِنَّ الغَنيَّ إِذا تَكَلَّمَ كَاذِباً","قَالوا صَدَقْتَ وَما نَطَقْتَ مُحالا",63,"ل",2,0],["إن الغنى غني النفس قانعها","موفر الحظ من زهد وإيمان",64,"ن",1,0],["إِنَّ الغُلامَ مُطيعٌ مَن يُؤَدِّبُهُ","وَلا يُطيعَكَ ذو شَيبٍ لِتَأديبِ",65,"ب",1,0],["إِنّ الغوانيَ قد أهلكنَني وأرى","حِبالَهُنَّ ضعيفاتِ القُوى كُذُبا",66,"ب",2,0],["اِنَّ الغَويرِيَّ لهُ نَكهَةٌ","بَنَتنِها أَربت عَلى الكَنفِ",67,"ف",1,1],["إنَّ الغَرامَ غرامَةٌ فمتى تكُنْ","بي مُغرَماً فلُتَحتَمِلْ بي مَغْرَما",68,"م",2,0],["إِنَّ الغَواني طالَما قَتَّلنَنا","بِعُيونِهُنَّ وَلا يَدين قَتيلا",69,"ل",2,0],["إِنّ الغَزالة قَد عَلِمنا قَبلَها","سِرَّ المَهاةِ وَلَيتَنا لَم نَعلَمِ",70,"م",1,0],["إِنَّ الغَوانيَ قَد أَعرَضنَ مَقِليَةً","لَما رَمى هَدَفَ الخَمسين ميلادي",71,"ي",1,1],["إِنَّ الغَوانيَ لا تَنفَكُّ غانيَةً","مِنهُنَّ يَعتادُني مِن حُبِّها عيدُ",72,"د",1,0],["إن الغنيَّ إلى المولى من افتقرا","في كل حال وعن أغياره نفرا",73,"ر",2,1],["إنَّ الغريبَ ذليلُ نفسٍ خاملٌ","كالشِّعرِ عندَ سِوَى بني رَسلانِ",74,"ن",1,0],["إنَّ الغَنِيَّ إذا قضَى حقَّ الغِنَى","يَقضي الغِنَي حَقَّ الغَنِيِّ فيُنصِفُ",75,"ف",1,0],["إِنَّ الغَواني قَد عَجِبنَ كَثيراً","وَرَأَينَني شَيخاً صَحَوتُ كَبيرا",76,"ر",2,1],["إِنَ الغَزالَ الَّذي تَرجونَ غِرَّتَهُ","جَمعٌ يَضيقُ بِهِ العَتكانِ أَو أُطَدُ",77,"د",1,0]]}