px?id=152250",""],[5431,"خيمة بؤسٍ...وقصعةِ بردِ","https://www.poetsgate.com/ViewPoem.aspx?id=183414",""],[5431,"ولا عشق يكون بلا اقتحام","https://www.poetsgate.com/ViewPoem.aspx?id=186595",""],[5442,"لعل حداة العيش أن يترفقوا","https://www.poetsgate.com/ViewPoem.aspx?id=114754",""],[5442,"تقدم قبل الركب دمعي ليبقا","https://www.poetsgate.com/ViewPoem.aspx?id=114760",""],[5447,"مضيت لكي أكونه","https://www.poetsgate.com/ViewPoem.aspx?id=210763",""],[5616,"شآم","https://www.poetsgate.com/ViewPoem.aspx?id=203333",""],[5616,"كتبت على جدار الصمت شعري","https://www.poetsgate.com/ViewPoem.aspx?id=204840",""],[5616,"أحوال","https://www.poetsgate.com/ViewPoem.aspx?id=205037",""],[5674,"أبحث عن خطاك بكل ضلع","https://www.poetsgate.com/ViewPoem.aspx?id=185910",""],[5690,"صدقتم لحظهُ لحظ الغزالِ","https://www.poetsgate.com/ViewPoem.aspx?id=172173",""],[5758,"أَحْلَامٌ عَربيَّة","https://www.poetsgate.com/ViewPoem.aspx?id=200513",""],[5781,"يَبابهُ وربيعي","https://www.poetsgate.com/ViewPoem.aspx?id=202855",""],[5883,"تجربة","https://www.poetsgate.com/ViewPoem.aspx?id=24071",""],[5943,"تعاندني","https://www.poetsgate.com/ViewPoem.aspx?id=35875",""],[5956,"إليك أشُدُّ الرحال","https://www.poetsgate.com/ViewPoem.aspx?id=192551",""],[5969,"قَمَرٌ وَنور ( إلى أمي )","https://www.poetsgate.com/ViewPoem.aspx?id=198698",""],[5973,"ذبحتك جومانا أخيرا بشرياني","https://www.poetsgate.com/ViewPoem.aspx?id=13195",""],[5975,"في ولاء آل بيت الرسول3","https://www.poetsgate.com/ViewPoem.aspx?id=53468",""],[6093,"إنِّيْ وإنْ كُنْتَ كُلِّيْ","https://www.poetsgate.com/ViewPoem.aspx?id=204933",""],[6233,"متى قررتِ اغتيالي!؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82692&r=&rc=35",""],[5567,"وكن روحي لتفنى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69067&r=&rc=6",""]],"verses":[["وَأَمضي إِذا بَلَّدَ المُستَغيرُ","وَهابَ الثَنِيَّةَ مَن يَطلُعُ",0,"ع",1,0],["وامض يا شعر إلى الماضي إلى","ملتقى الوحي وذب فيه احتراما",1,"م",2,0],["وَأَمضى عَلى هَولٍ إِذا ما تهَزَهَزَت","مِنَ الخَوفِ أَحشاءُ النفُوسِ الفَواتِكِ",2,"ك",1,0],["وأمضوا سديد الرأي دون تردُّد","فما يَبْلُغ الغايات من يتردّد",3,"د",1,0],["وَأُمُّ ضِرارٍ تَنشُدُ الناسَ والِهاً","أَما لِاِبنِ تَيمِ اللاتِ ماذا أَضَلَّتِ",4,"ت",1,1],["وامْضَغي الأَعشابَ والأَفكارَ","في صَمْتِ الظِّلالْ",5,"ل",1,0],["وامض اجتهد رشا","د في تزويج أختي بالفتى",6,"ا",1,0],["وَأَمضي كَما يَمضي السِنانُ لِطِيَّتي","وَأَطوي كَما تَطوي المُجَلِّحَةُ العُقدُ",7,"د",1,0],["وَأَمضى سِلاحٍ قَلَّدَ المَرءُ نَفسَهُ","رَجاءُ أَبي المِسكِ الكَريمِ وَقَصدُهُ",8,"د",2,0],["وَأَمضى قَضاءَ بَينَها فَتَحاجَزَت","وَمَخفوضُها راضٍ بِهِ وَرَفيعُها",9,"ع",3,0],["وَأَمضَحتِ عِرضي في الحَياةِ وَشِنتِهِ","وَأَوقَدتِ لي ناراً بِكُلِّ مَكانِ",10,"ن",1,0],["وأمضاهما حدّاً فلا تغتررْ به","غِرَارُ الَّذي فيه من السّحْرِ جَوْهَرُ",11,"ر",1,0],["وَأَمضي فَإِمّا بَيتُ نَفسٍ كَريمَةٍ","يُهَدُّ وَإِمّا بَيتُ عِزٍّ يُشَيَّدُ",12,"د",1,0],["وَأَمَضُّ مِن ثِقَلَِ العِيادَةِ لِلفَتى","نُوَبٌ تَكونُ عَوادِيَ العُوّادِ",13,"د",1,0],["وأمضَّاني بالمقامع ضرباً","كدت منه في أرض قبري أغور",14,"ر",1,0],["وأَمضنى من بعد دفنك أَنَّني","ما زرتُ قبرك وَالحَبيب يزار",15,"ر",1,0],["وَامْضِ يَا صَاحبي خَليقاً بأَنْ تُرْ","ثَى حَقيقاً عَلَيْكَ لُبْسُ الْحدَاد",16,"د",1,0],["وأمضَّها فقدُ الشبابِ مضرَّجاً","بدمائه من كفِ غير قريع",17,"ع",1,0],["وأمضُّ من قَحْط السنين بأمةٍ","مشلولةِ الأعمالِ قحطُ رجال",18,"ل",1,0],["وأمضَى قَضَاءً بَيْنَها، فَتَحاجَزَتْ،","وَمَحْفُوضُها رَاضٍ بهِ وَرَفِيعُهَا",19,"ع",3,0],["وأمضي إليها أنا شَهَقاتُ ال","قلوعِ تغازلُ لونَ المَدى",20,"د",2,0],["وأمضي غرار النصح بعد فلوله","فقام بأمرٍ طالما جال في النفسِ",21,"س",1,0],["وَأَمضَوا في الَّذي يَحوُونَ حُكمي","فَفُزتُ بِعاجِلٍ مِنهُ وَآجِل",22,"ل",1,0],["وأمضيت حكم الله في كل مارق","وألغيت أحكام الغواية والأهوا",23,"و",2,0],["وَأَمضى مِن الصِّمصامِ عَزماً إِذا غَدا","يَمُجُّ دَماً مِن صَدرِهِ وَذُبابِهِ",24,"ب",2,0],["وأمضّني الداء العياء فم","ن مُغيثي من معيني",25,"ن",2,0],["وأمضي ولو أنَّ البروقَ صوارمٌ","وأقضي ولو أنَّ الجبالَ قَنَابِلُ",26,"ل",1,0],["وَأَمضَيتَ عزمكَ حتَّى أَخفْتَ","به في بطون النِّساءِ الأَجِنّه",27,"ن",2,0],["وأمضَى من المِقدار عَزْماً وبَطْشةً","وأوسعُ لِلأيّام صَدْراً وأَرْحَبُ",28,"ب",1,0],["وَأمضى مُقدَماً في الرَوعِ مِنهُ","إِذا الأَبطالَ أَعجَلَها الفِرارُ",29,"ر",1,0],["وأَمضى الحكم في القَتلى برازا","وَفي الاسرى مَفاداة وَمنا",30,"ن",2,0],["وَأَمْضى حُساماً وَأَوْفى ذِماماً","وَأَهْمى غَماماً إِذا الْغَيْثُ أَكْدا",31,"د",2,0],["وَأَمْضَيْتَ عَضْباً مِنْ لِسانِيَ بَعدَما","عَمِرْتُ وَحَدّاهُ سَواءُ وَصَفْحاهُ",32,"ا",2,0],["وَأَمضى إِلى ما تَبتَغيهِ وَإِن غَدا","وَمِن دونِ البيضِ الصَوارِمِ وَالنيلِ",33,"ل",1,0],["وأمضى إلى حيث يمضى الزمان","إلى مرفأ الأبدِ الزاخر",34,"ر",1,0],["وامضى لا يني مئة وعشرا","وخمساً ليس يأبه ان يجوعا",35,"ع",2,0],["وأَمضى ما يكونُ السَّيفُ حدًّا","إذا ما استَلَّهُ البطل الجسور",36,"ر",1,0],["وامضِ مع العادةِ في مَهرها","على طريقِ نهجُهُ لاحبُ",37,"ب",1,0],["وأمضيت جدك في غزوهم","فتعساً لجدهم العاثر",38,"ر",1,0],["واِمضِ إلى حيث مضى معشرٌ","كانتْ لهم في الدّرجاتِ العُلا",39,"ل",2,0],["وأمضي على كل بيت أغني","تطوف الكؤوس بوهم.. جديد",40,"د",1,0],["وأَمضَى من ذُبابِ السيفِ رأُياً","وأَجملُ طَلعةً من صَفْحتَيهِ",41,"ي",2,0],["وامضِ مصحوباً فما السي","فُ بأَمْضَى مِنْ مَضَائِكْ",42,"ك",1,0],["وَأَمضاها بِأَلوِيَةٍ","يَسُدُّ الفَجَّ مِقنَبُها",43,"ب",3,0],["وَأمضّ من هذا بأن وَضَعوا به","حَبلاً وفي الأسواق فيه يدارُ",44,"ر",1,0],["وأمضى على من أمّ منهم هزائماً","وسجل ما أمضاهُ سيفٌ مهندُ",45,"د",1,0],["وأمضى بها أهلك الأولون","إلى ابن أمينهمُ راضيه",46,"ي",2,0],["وأمضَّني الداء المبرِّح ليلةً","منحتني الخلقَ الذي أستكمل",47,"ل",1,0],["وامض بالحزم والسداد وصرّف","ما توليتَ قيده وعنانه",48,"ن",2,0],["وأمضي لستُ ملتفتاً وَرَائي","وأرقى لستُ أنظرُ مَنْ أمامي",49,"م",2,0],["وا مُضْرِمَ الوَجْدِ فِي قَلْبٍ يُعَذِّبُهُ","نَأْيُ الأَحِبَّةِ إخِوانِي اليَمانِينا",50,"ن",2,0],["وَأَمضَيتَ عَزماً في سُلَيمانَ راشِداً","وَمَن يَعتَصِم بِاللَّهِ مِثلك يرشدِ",51,"د",1,0],["وَأَمضى عَلى الهَولِ مِن صارِمٍ","وَأَنجَحَ سَعياً مِنَ الدِرهَمِ",52,"م",1,1],["وَأَمَضُّ شَيءٍ لِلقُلوبِ قَطائِعٌ","بِالمَروَزانِ لَهُم وَكَرّزكانِ",53,"ن",1,0],["وأَمْضَى عزيماً في القَضايا مِن الظَّبا","وأَنْفَذُ أَمْراً في البَرايا مِنَ السَّهمِ",54,"م",1,0],["وأَمْضَاهُمُ عَزْمَةً فِي الوَغَى","هُمَامٌ تَعَوَّدَ بَرْحَ الصِّيَالِ",55,"ل",1,0],["وَأَمْضَى عَلَى الحُسَّادِ إِضْرَارَ كَابِتٍ","كَمَا قَدْ أَضَرَّتْ بِالْمَرِيضِ الكوامخ",56,"خ",1,0],["وأمضّ ما جرعت من الغصص التي","قدحت بجانحة الهُدى إيراءها",57,"ا",3,0],["وامضى من ذباب السيف عزماً","وأسرى من خيال الطيف مجرى",58,"ر",2,0],["وأمْضى على أَبناءِ قَيْلَةَ حُكْمَهُ","على شرِسٍ أدْلَوْا به وَليان",59,"ن",1,0],["وامض من عندها وأفت تلبى","وإلى البيت مقبلاً إقبالا",60,"ل",2,0],["وامض قبل إن استطعت سبيلا","حجر البيت واحذر الإغتفالا",60,"ل",2,0],["وامض فاعل الصفا حذا الحجر ال","أسودِ واخرج من بابه وتعالى",60,"ل",2,0],["وَأَمضي غَيرَ مُنتَفِعٍ بِعَيشٍ","وَكَيفَ يَكُونُ بِالعَيشِ اِنتِفاعي",61,"ع",2,0],["وأمضى الظبي لما تكَهّمَ حدّها","فهن على هام الأباطيل في شهر",62,"ر",1,0],["وأمضى من المقداد في الروع عزمة","ومن هضبات الطود في الحلم أرجح",63,"ح",1,0],["وأمضي همومي بالزماع لوجهها","إذا ما الهموم لم يكد بعضها يمضي",64,"ض",2,0],["وَأمضُّ ما يشجي الغَيور نِساؤُكُم","هَتفت وَقَد طرق العَدوُّ خِيامَها",65,"م",3,0],["وَأمضُّ في أَحشائنا مِن فقدِهِ","أنّا وَقَد عزم الرَحيل بَقينا",66,"ن",2,0],["وَأَمض الجُروح أَن رَئيسا","من ذوي الفضل يَمدح المرؤوسا",67,"س",2,0],["وأمضى في الوقائعِ من حُسامٍ","وأثبتُ في الهزاهِزِ من جِبَالِ",68,"ل",1,0],["وأمض داء في الحشا لولا مس ال","راهون ضعضع جانب الراهون",69,"ن",1,0],["وامضِ يا شعر نَادَى النفحِ تكسو","بفوافيك عارياتِ الجنان",70,"ن",1,0],["وامضُّ الداء بالقلب وقوعا","طفلة ما صاغ لها السوط سوارا",71,"ر",2,0],["وَاِمضي مَضاءَ الجَفنِ في حَرَكاتِهِ","وَتَقَطَّعي طُرُقَ الحِجازِ ذَهابا",72,"ب",2,0],["وأمضى حسام للرزايا مجرد","وأنفذ سهم للمنايا مسدد",73,"د",1,0],["وَإمضاؤه أَمضى مِن السَيف مصلتاً","إِذا ما بَدَت مِن فَوق إمضائه الطفرا",74,"ر",2,0],["وامضي ولي ماض من العزم مرهف","يرد غرار السيف وهو كليل",75,"ل",1,0],["وامضي على معضلات الأمور","وان لم اجد غير سيفي معينا",76,"ن",2,0],["وأمضاهم اذا كتبوا يراعاً","وأذلقهم أذا نطقوا لسانا",77,"ن",2,0],["وَاِمضِ في غَيرِ صُحبَةِ اللَهِ ما عِش","تَ مُلقىً مِن كُلِّ فَجٍّ وَوادِ",78,"د",1,0],["وأَمضى على غرَرٍ مُقْدِماً","اذا ما العَزائمُ خُنَّ الهِمَمْ",79,"م",1,0],["وَامض الحَياةَ بجمعِ الجَمعِ في دَعَةٍ","قبل التفرّق وَاترك غيَّ لاحِ لحا",80,"ح",2,0],["وَامضِ الحَياةَ بذي دلٍّ وذاتِ بَهاً","كِلاهُما مَغنمُ اللذّاتُ وَالتحفُ",81,"ف",1,0],["وامضوا على غلوائكم قدماً ولا","تخشوا معرة فاسدي الأذهان",82,"ن",1,0],["وأمضى رسول اللَه في القوم حكمه","لقد قال ما معناه إذ يتأمل",83,"ل",1,0],["وامض ما لاقى الحمى يوم به","طرقته طارقة النوى بالهادي",84,"د",2,0],["وامض شيء في الحشا صدع الحشا","صوت البتولة من حشى وقاد",84,"د",1,0],["وَامضِ وَاقتَد مُطَهَّمَي آنِياسِ","خَيرَ ما في الدُّنيا مِنَ الأفراسِ",85,"س",1,0],["وأمضى على آثارها الحقيقة","تنل بهذا الفعل جل القصد",86,"د",1,0],["وامضي نحو العراق وانشد وحرّض","بالقوافي من كان في بغداد",87,"د",1,0],["وأمض داء أي داء معضل","مرد وخطب زعزع الأطوادا",88,"د",2,0],["وأمضي كتوما حاملا همَّ موطني","وأدعو بليلي للعراقِ تضرعي",89,"ع",2,0],["وأمضي في طريقي للأعالي","وأنظرُ في تأنٍ للبعيدِ",90,"د",1,0],["وأَمضِ العزم منك وخذ بحزم","وأوف الوعد إن كانت وعود",91,"د",1,0],["وامضِ في دربك لا تسمعْ لمن","من عصورِ اليأسِ يهديكَ العِبر",92,"ر",1,0],["وأمْضي وربّي مَعَي طالَمَا","يقيني به راسخٌ كالجِبَال",93,"ل",1,0],["وامضوا على درب الهدى لا تيأسوا","فاليأس أصل الضعف والتهوين",94,"ن",1,0],["وامض في الأمر إن أردت فلاحا","عازما فالفلاح عند العزائم",95,"م",1,0],["وامْضي سبيلا دون أنْ يغيب منْ","تَجْنِينَ كالنَحَّالِ إذْ شارَ العسَلْ",96,"ل",1,0],["وامضي كما يمضي الفؤادُ مُسَهَّداً","مِنْ طُولِ ليلٍ ثُمَّ هاتِ وهاكِ",97,"ك",1,0],["وأمضيتَنِي مُثْملاً ﻻ أفيقْ","فلمْ أدرِ مَن باتْ فينا شَدَنْ",98,"ن",1,0],["وامض ياشعب العلى في وحدة","قد براها الله درعا وجلاها",99,"ا",3,0],["وَامْضِ إِلَى نَحوِ الحَضِيضِ بِرَوضَةِ ال","رِّضْوَانِ فِي أَرضِ الرِّضَى لِمُرِيدِهِ",100,"د",2,0],["١٨-وأمض الليالي ركوعًا سجودًا","وعفِّرْ على تربها ذي الجباه",101,"ا",2,0],["وأمضي مع الحزن أوقاته","فيبكي الغرام وأبكي الغزل",102,"ل",1,0],["وامض بطهرك 