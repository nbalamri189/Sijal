{"poems":[[79,"ثنى الصعدة السمراء من لين قده","https://www.aldiwan.net/poem36608.html","الطويل"],[48,"ترنم في نهارك مستعينا","https://www.aldiwan.net/poem22214.html","الوافر"],[214,"تضاهيك بالجيد الغزالة والصلف","https://www.aldiwan.net/poem13496.html","الطويل"],[422,"أهاج الجوى برقا أغار وأنجدا","https://www.aldiwan.net/poem54165.html","الطويل"],[422,"فخار الملوك بأعوانها","https://www.aldiwan.net/poem54168.html","المتقارب"],[435,"يذكرني المغيب لقا حبيب","https://www.aldiwan.net/poem40538.html","الوافر"],[438,"هل من رفيق رفيق","https://www.aldiwan.net/poem12680.html","المجتث"],[463,"أفلح قوم إذا دعوا وثبوا","https://www.aldiwan.net/poem56299.html","المنسرح"],[466,"منازلكم للخائفين عصام","https://www.aldiwan.net/poem16033.html","الطويل"],[466,"حماك حمى الرحمن من كل حادث","https://www.aldiwan.net/poem16151.html","الطويل"],[1149,"","https://poetry.dctabudhabi.ae/diwan/poem/67701","الطويل"],[1385,"","https://poetry.dctabudhabi.ae/diwan/poem/178070","المنسرح"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64417","الطويل"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132834","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124763","الطويل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58243","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66171","الطويل"],[4929,"رنين الحروف","https://www.poetsgate.com/ViewPoem.aspx?id=210844",""],[4935,"فخار الملوك بأعوانها","https://www.poetsgate.com/ViewPoem.aspx?id=129303",""],[5050,"تجلد أخي وخل الأسى","https://www.poetsgate.com/ViewPoem.aspx?id=38207",""],[6023,"لينهك مجد طارف وتليد","https://www.poetsgate.com/ViewPoem.aspx?id=123864",""],[6261,"الأستاذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82131&r=&rc=3",""]],"verses":[["فمِن ثُعَلِ الزّوْراءِ لمحَةُ طَرْفِهِ","ومنْ مُضَرِ الحَمْراءِ صَفْحَةُ خدِّهِ",0,"د",2,0],["فَمِن ثُكلٍ يَهابُ وَمِن عُقوقٍ","وَأَرزاءٍ يَجِئنَ مُصَمِّماتِ",1,"ت",1,0],["فمن ثغره الصبح المبلج يجتنى","ومن خده الورد المدرج يقتطف",2,"ف",1,0],["فمن ثمَّ أقلامي إذا ما ذكرتها","تخرُّ له في صفحة الطرس سجّدا",3,"د",2,0],["فمن ثمَّ يقطف نوارها","ويجني أزاهير بستانها",4,"ن",3,0],["فمن ثمّ تراني ذا غرامٍ","وملتاعاً لكل غروب شمسِ",5,"س",1,0],["فمن ثغورِ أقاحِ","ومن خدود شقيقِ",6,"ق",1,0],["فَمِنْ ثُريّاه أو مَجرّتِه","لجامُها العسجديُّ واللَّبَبُ",7,"ب",1,0],["فمنثورةٌ في سَلْمهِ ونِزالهِ","رَغائبُ تُغْني المُعْتفينَ وهامُ",8,"م",1,0],["فمنْثورةٌ في سَلْمِه ونِزالِهِ","جماجمُ أبطالِ الوَغى ورَغائبُهْ",9,"ب",2,0],["فمِنْ ثَمّ يَقْضِي أَلْفِ أَلْفٍ دُيُونَهُ","وحَاجَتُهُ مَقْضِيّةٌ لم تُؤَخَّرِ",10,"ر",1,0],["فمن ثراها عليَّ أرْدِيَةٌ","ومن دموعي لها جَلابيب",11,"ب",1,0],["فمن ثروة الدارين قد صار معدما","قضى اللّه أن العلم نور وحكمة",12,"ه",1,0],["فمن ثَيِّبٍ لم تُفتَرع غيرَ خلسَة","وبكرٍ من الألفاظ قد زُوِّجت بِكرا",13,"ر",2,0],["فمن ثبّت الله استجاب موحدا","ومن لم يثبت فهو غير موحد",14,"د",1,0],["فَمِنْ ثَمِلٍ يَهْتَزُّ في الحانِ نَشْوَةً","كما اهتَزَّ غُصْنُ البانةِ المتأوِّدُ",15,"د",1,0],["فمن ثم مكتئباً نزلا","يحذر حراسه وجلا",16,"ل",2,0],["فَمَنْثُورُ دَمْعِي في هَواكِ نَظَمْتُهُ","قَلاادَ شِعْرٍ فافْعَلِي ما بَدا لكِ",17,"ك",1,0],["فمن ثاروا على الشعرِ المقفى","وراموا غيرَهُ للمجدِ بابَا",18,"ب",2,0],["فمن ثم يقطف نوارها","(أولاء العلوم بتبيانها)",19,"ن",3,0],["فمن ثم لست ترى من وفي","بعهد المعالي وإن أسسا",20,"س",2,0],["فمنثور ما تبديه قد ضاع نشره","ومنظومه فوق النحور عقود",21,"د",1,0],["فمن ثُلْثِ قَرنٍ مطلبي متواضعٌ","فساعةُ وصلٍ مطلبٌ متواضعُ",22,"ع",1,0]]}