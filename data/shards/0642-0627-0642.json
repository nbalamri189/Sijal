{"poems":[[46,"لوْ أنَّ دهراً ردَّ رجعَ جوابِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=15648&r=&rc=8",""],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123181","البسيط"],[3509,"","https://poetry.dctabudhabi.ae/diwan/poem/124131","البسيط"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136874",""]],"verses":[["قأقِلْ أسامة ََ جُرمها واصفحْ لها","عنْهُ وهَب ماكانَ لِلْوَهَّابِ",0,"ب",1,0],["قاقت لهم أي تعالوا ها أنا أمكم","يا لابسي فرو سنجاب وقاقوا لي",1,"ل",2,0],["قاقبل من المذنب الراجي شفاعتكم","سلاسل النظم ما أعلى مبانيها",2,"ي",3,0],["قاق لك قاق لك يا ذي سحابه تحروى","فوق غيله ويمم راس واديه وأنوى",3,"و",2,0]]}