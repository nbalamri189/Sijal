{"poems":[[88,"بلابل وادي النيل بالمشرق اسجعي","https://www.aldiwan.net/poem68896.html","الطويل"],[74,"ملوز الطرف أهلا","https://www.aldiwan.net/poem20548.html","المجتث"],[53,"أسوغ لخلاني مساغ شرابهم","https://www.aldiwan.net/poem64944.html","الطويل"],[53,"أقاسم يا من لم يزل ذا نقيبة","https://www.aldiwan.net/poem65863.html","الطويل"],[64,"لنا الأنهار من لبن وخمر","https://www.aldiwan.net/poem52201.html","الوافر"],[64,"في المعدنيات لنا حكمة","https://www.aldiwan.net/poem52231.html","السريع"],[50,"كتمت الحب يا حكم","https://www.aldiwan.net/poem65230.html","مجزوء الوافر"],[185,"ألا يا سلم عوجى تخبرينا","https://www.aldiwan.net/poem58837.html","الوافر"],[275,"لطلعة حسنها انهزم الإياس","https://www.aldiwan.net/poem35348.html","الوافر"],[333,"تعالي يابنة الأحلام","https://www.aldiwan.net/poem54976.html","الهزج"],[409,"سماعا عباد الله أهل البصائر","https://www.aldiwan.net/poem33733.html","الطويل"],[484,"ما كان قولك في لوزان مقبولا","https://www.aldiwan.net/poem36949.html","البسيط"],[563,"للذنب سر عجيب","https://www.aldiwan.net/poem34971.html","المجتث"],[622,"","https://poetry.dctabudhabi.ae/diwan/poem/130719","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48692","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62593","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59422","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59411","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[3318,"","https://poetry.dctabudhabi.ae/diwan/poem/138756",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110110","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114370","الطويل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133250","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102929","البسيط"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70023","الوافر"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123524","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[1901,"رويْدَكَ لا تُشمتْ بصاحِبكَ العِدَى","https://www.poetsgate.com/ViewPoem.aspx?id=160420",""],[4961,"النصفُ الثاني للإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=33329",""],[470,"شكرا دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=64693",""],[5717,"وهل قرأت من كتاب النفس ما","https://www.poetsgate.com/ViewPoem.aspx?id=170602",""],[161,"وَجهُ المرآة","https://www.poetsgate.com/ViewPoem.aspx?id=204621",""]],"verses":[["وَفي اُنظُر إِلى الأَقمارِ زَفرَةُ واجِدٍ","وَأَنَّةُ مَقروحِ الفُؤادِ مُوَزَّعِ",0,"ع",1,0],["وفي انتساب وعلم","أجلّ فرعاً وأصلا",1,"ل",2,0],["وفيَّ أناةٌ لا تُفاتُ بفرصةٍ","لها سيرةٌ موضوعةٌ وهْي كالرَّكض",2,"ض",1,0],["وفي أن يكونَ النَّيلُ نيلاً معجَّلاً","كثيراً تراه لي أقل قليل",3,"ل",1,0],["وفي أنْ إذا أطرقتُ إطراقَ خادمٍ","طفِقتَ تراعيني بعينِ خليلِ",3,"ل",1,0],["وفي أن تمدّ الظلَّ لي وتديمَه","فما ظِلُّ خيرٍ زائلٍ بظليلِ",3,"ل",1,0],["وفي أنني قدرتُ فيك احتمالها","شفيعٌ وجيهٌ عند كلّ نبيل",3,"ل",1,0],["وفي أنهارنا رضراض تبر","ودر بين ياقوت ثمينِ",4,"ن",1,0],["وفي انقلاب الأرض عن طبعها","غنى وملك دائم لا يبور",5,"ر",1,0],["وَفي أَنيابِها فَلَجٌ","فَأَطرَوها وَما عَلِموا",6,"م",3,0],["وَفِى أَنَسٍ معانِدَةٌ وَأُخرَى","فَرَت عَن أُمَّ هامَتِهِ الشُّؤُونَا",7,"ن",2,0],["وفي أنفاسِها نفَسُ النّعامى","بروضٍ كلُّهُ وردٌ وآس",8,"س",1,0],["وفي أنغامه تخفق أشباح الأساطير","تعالى فهنا الحارس",9,"س",1,0],["وفي آنس كم قرية قد تعطّلت","مساجدُها عن كل تالٍ وذاكر",10,"ر",1,0],["وفي انتخابك للحال دليل رضا","جميعنا فليجل ذاك تسجيلا",11,"ل",2,0],["وفي أناس نعيم","وفي أناس لهيب",12,"ب",1,0],["وفي انخفاضي رفع وانحطاطي في","رضاه عزّ وتردادي إليه شرف",13,"ف",1,1],["وفيّان للعرش المقدس والحمى","سعيدان في أرجائه أنت والنيلُ",14,"ل",1,0],["وفي أنفس الناس العداوة والقِلى","وقد قسّم المولى معيشتهم رِفدا",15,"د",2,0],["وفي انقلاب العصا سيفا براحته","جذلان باغ تعامت عنه عيناه",16,"ا",2,0],["وفي انقلاب العصا سيفا براحته","خذلان باغ وباغي البغي مخذول",17,"ل",1,0],["وفي انقطاعه يكون مثل بل","واجهل بأو واعلم بأم معها وهل",18,"ل",1,0],["وفي انتهاء ثالث قد وُضِعَت","وطولها كطوله بل نقصت",19,"ت",1,0],["وَفِي أَنتَ مِنّي لِلنَّبِيِّ دَلالَةٌ","عَلَيهِ وَفِي مَن كُنتُ مُستَوثقُ العَقِد",20,"د",1,0],["وفي انبثاق الروحِ ضلُّوا كونهم","اعزوا الاله الإِبنَ للنُقصانِ",21,"ن",1,0],["وفي إن أولى الناس أن ولايةً","له باتباعٍ فهو أصلٌ ميممُ",22,"م",1,0],["وفى انتصارى على من رام يخذلني","برميهم شفير شاهق هارى",23,"ر",2,0],["وفي أناملك الآمال لامعة","كأنهن بروج حشوها الشهب",24,"ب",1,0],["وَفي إِنشائِها قَد أَرخوها","بِمهدِ الحكمة الفتيان تَنشا",25,"ش",2,0],["وفي أنفس خلفت خلفى جعلته","الخليفة بعدى فهو كنز غناها",26,"ا",3,0],["وفي انتِقال الرُوحِ عَن جُثمانِهِ","عَن نُقلَةٍ الجِسمِ تعازَو أُسى",27,"ا",1,0],["وفيَّ انقباضٌ لا يَريمُ ووَحشةٌ","تُريني وجهَ الكونِ أغبرَ أسودا",28,"د",2,0],["وفي أنوار ِ جودِكِ موجُ حبٍّ","يُضيءُ لساحل ِ الكلماتِ فنَّا",29,"ن",2,0],["وَفي انتِظارِكِ زَهْوُ الشَّام ِأجمَعُهُ","شُكرا ًدِمَشقُ..فِداكِ الرُّوحُ والحَدَقُ",30,"ق",1,0],["وفي انقلابات الفصول عبرة","لو سلمت أحلامنا من حلم",31,"م",1,0],["وَفِي أُنْسٍ وَقَدْ أَمْضَى","حَدِيثَ الرُّوحِ أَشْجاَهُ",32,"ا",2,0]]}