{"poems":[[65,"هذه دارها على الخلصاء","https://www.aldiwan.net/poem45779.html","الخفيف"],[73,"أرى شأنيك شأنهما انبجاس","https://www.aldiwan.net/poem4022.html","الوافر"],[75,"هو الدهر فاصبر للذي أحدث الدهر","https://www.aldiwan.net/poem11936.html","الطويل"],[37,"عرفت الدار كالخلل البوالي","https://www.aldiwan.net/poem39097.html","الوافر"],[53,"متشبث بعلائقي متخلص","https://www.aldiwan.net/poem64932.html","الكامل"],[45,"لهوى النفوس سريرة لا تعلم","https://www.aldiwan.net/poem10567.html","الكامل"],[47,"أهلك والليل أيها الرجل","https://www.aldiwan.net/poem65644.html","المنسرح"],[51,"الله كاف فمالي دونه كاف","https://www.aldiwan.net/poem62178.html","البسيط"],[51,"ألا إنما الإخوان عند الحقائق","https://www.aldiwan.net/poem62188.html","الكامل"],[68,"أصم الله أسمعنا الملاما","https://www.aldiwan.net/poem39927.html","الوافر"],[33,"وما ظبية من ظباء الأراك","https://www.aldiwan.net/poem42611.html","المتقارب"],[76,"جرر ملاءة كل يوم شامس","https://www.aldiwan.net/poem12971.html","الكامل"],[107,"وفت الظنون وبرت الآمال","https://www.aldiwan.net/poem42085.html","الكامل"],[50,"يا سائل الله فزت بالظفر","https://www.aldiwan.net/poem63407.html","المنسرح"],[111,"لا تكترث بالليالي إنها دول","https://www.poetsgate.com/ViewPoem.aspx?id=519",""],[154,"ألا فاشكروا نعمى الإله يزدكم","https://www.aldiwan.net/poem68580.html","الطويل"],[173,"بيني فما أنت من جدي ولا لعبي","https://www.aldiwan.net/poem1605.html",""],[173,"سقها ولو ذهب السرى بسراتها","https://www.aldiwan.net/poem1609.html",""],[189,"أخلآى بالثغر دام الفراق","https://www.aldiwan.net/poem14614.html","المتقارب"],[266,"إني أعيذك أن تلقى الدنا عوضا","https://www.aldiwan.net/poem38194.html","البسيط"],[275,"للقلب إن طال البعاد تقرب","https://www.aldiwan.net/poem35241.html","الكامل"],[285,"إذا لم يكن من حادث الدهر موئل","https://www.aldiwan.net/poem60784.html","الطويل"],[343,"يا أيها الطالب من مثله","https://www.aldiwan.net/poem68692.html","السريع"],[354,"لمغيب قلبي في هواكم مشهد","https://www.aldiwan.net/poem15644.html","الكامل"],[354,"لا يوحشنك في طري","https://www.aldiwan.net/poem15848.html","مجزوء الكامل"],[354,"بدت لعيني بالستور والكلل","https://www.aldiwan.net/poem15861.html","الرجز"],[358,"دع الأجفان تسلب منك جسما","https://www.aldiwan.net/poem39960.html","الوافر"],[358,"ألام بحبه فأزيد وجدا","https://www.aldiwan.net/poem40390.html","الوافر"],[369,"إذا لم تقدرا أن تسعداني","https://www.aldiwan.net/poem60633.html","الوافر"],[371,"صبرت على استبطاء عاقبة الصبر","https://www.aldiwan.net/poem17308.html","الطويل"],[396,"ياطالبا للوصيه","https://www.aldiwan.net/poem54448.html","عموديه"],[422,"ما لها تطوي فيافي الأرض سيرا","https://www.aldiwan.net/poem53994.html","الرمل"],[422,"قدمت قدوم الغاديات السواجم","https://www.aldiwan.net/poem54041.html","الطويل"],[422,"ذكرت على النوى عهد التصابي","https://www.aldiwan.net/poem54047.html","الوافر"],[422,"أسرك من باد لعينيك حاضر","https://www.aldiwan.net/poem54066.html","الطويل"],[422,"تنقلت مثل البدر يا طلعة البدر","https://www.aldiwan.net/poem54158.html","الطويل"],[422,"أهاج الجوى برقا أغار وأنجدا","https://www.aldiwan.net/poem54165.html","الطويل"],[443,"سلام على الربع من ذي سلم","https://www.aldiwan.net/poem2553.html","المتقارب"],[443,"وداعاً أيها القلب الحزين","https://www.aldiwan.net/poem2570.html","الوافر"],[443,"فؤاد عصاه صبره وهو طالبه","https://www.aldiwan.net/poem2577.html","الطويل"],[556,"ألا عوجا لمجتمع السيال","https://www.aldiwan.net/poem47286.html","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86890","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86614","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87112","الطويل"],[852,"","https://poetry.dctabudhabi.ae/diwan/poem/123975","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38755","الطويل"],[855,"","https://poetry.dctabudhabi.ae/diwan/poem/138854",""],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61250","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64888","المجتث"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145166","المتقارب"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64603","البسيط"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50014","البسيط"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21667","البسيط"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52051","الرجز"],[2067,"","https://poetry.dctabudhabi.ae/diwan/poem/198256","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120728","الرمل"],[2888,"","https://poetry.dctabudhabi.ae/diwan/poem/46729","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201926","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202599","الوافر"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74168","الطويل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103407","الطويل"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3439,"","https://poetry.dctabudhabi.ae/diwan/poem/130864","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62896","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48307","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108173","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129448","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59458","الوافر"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102929","البسيط"],[354,"","https://poetry.dctabudhabi.ae/diwan/poem/44093","الوافر"],[3906,"","https://poetry.dctabudhabi.ae/diwan/poem/199407","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90957","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94608","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81716","البسيط"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136468",""],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136735",""],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133106","الرمل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83192","الرجز"],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116075","الوافر"],[4927,"كَيْدُ الْعُذَّاْل","https://www.poetsgate.com/ViewPoem.aspx?id=30197",""],[5442,"فوض أمورك من بين الأنام إلى","https://www.poetsgate.com/ViewPoem.aspx?id=114753",""],[5452,"كوني لي","https://www.poetsgate.com/ViewPoem.aspx?id=112028",""],[5466,"يا مَنْ يرومُ تلاوة القرآن","https://www.poetsgate.com/ViewPoem.aspx?id=112512",""],[5628,"هواجس مرعبة","https://www.poetsgate.com/ViewPoem.aspx?id=178464",""],[5956,"إليك تفتحتْ ورداتُ حبٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=182073",""],[5956,"جلستُ على الشط","https://www.poetsgate.com/ViewPoem.aspx?id=183252",""],[5956,"قبل الموت","https://www.poetsgate.com/ViewPoem.aspx?id=184892",""],[6102,"حالة استسلام","https://www.poetsgate.com/ViewPoem.aspx?id=183613",""]],"verses":[["واِرغَوى باطِلي وَعاثَ بياضٌ","مِن قَتيرٍ في لِمَّةٍ سَوداءِ",0,"ا",2,0],["وَأَرغَمَ بَأسُهُم آنافَ قَومٍ","تَجَنَّبَها لِعِزَّتِها العُطاسُ",1,"س",1,0],["وَأَرغَمَ في بِرّي أُنوفَ عِصابَةٍ","لِقاؤُهُمُ جَهمٌ وَلَحظُهُمُ شَزرُ",2,"ر",1,0],["وَأَرغَمَ ما عَزَمنَ البَينُ حَتّى","دَفَعنَ بِذي المَزارِعِ وَالنِجالِ",3,"ل",1,0],["وارغب بودي أن يُذالَ فإنني","في غير ذاك من الأمور أُرخِّصُ",4,"ص",1,0],["وَأَرَغتَ ما لِأَبي العَشائِرِ خالِصاً","إِنَّ الثَناءَ لِمَن يُزارَ فَيُنعِمُ",5,"م",1,0],["وَاِرغَب إِلى اللَهِ لا إِلى أَحَدٍ","فَإِنَّهُ خَيرُ واصِلٌ تَصِلُ",6,"ل",1,0],["وَاِرغَب بِنَفسِكَ عَمّا لا صَلاحَ لَهُ","وَأَوسَعِ الناسِ مِن بِرٍّ وَإِلطافِ",7,"ف",1,0],["وَأَرغَبُ عَمّا فيهِ ذُلٌّ وَريبَةٌ","وَأَعلَمُ أَنَّ اللَهَ ما عِشتُ رازِقي",8,"ق",2,0],["وَأَرغَدَنا عَلى التَفريقِ عَيشاً","وَأَحسَنَنا لِفَقدِ الإِلفِ حالا",9,"ل",2,0],["وَأَرغَبُ في وُدِّ مَن لَم أَكُن","إِلى وُدِّهِ قَبلِكُم راغِبا",10,"ب",2,0],["وَاِرغَب بِنَفسِكَ عَن مَقامَةِ فاضِلٍ","قَد قامَ يَمثُلُ في خَصاصَةِ بائِسِ",11,"س",1,0],["وَارْغَبْ بنفسكَ عَن سِواها إن دَنا","مِنكَ الرّواحُ وآذنَ التّرحالُ",12,"ل",1,0],["وَاِرغَب إِلى اللَهِ لا إِلى جَسَدٍ","مُنتَقِلٍ مِن صِباً إِلى كِبَرِ",13,"ر",1,0],["وارغب بنفسك ان تخزى على طمع","دع المطامع ترعى خزيها الهمل",14,"ل",1,0],["وَأُرغِم أَنفَ الجَحدِ مِن كُلِّ مُلحِدِ","وَإِن زَهزَهُ البَطّالُ عِطفاً لِمُنشِدِ",15,"د",1,0],["وَاِرغَب بِمَدحِكَ إِلّا في سَليلِ عُلاً","يُنمَى إِلى العِزِّ مِن آبائِكَ النُجُبِ",16,"ب",1,0],["وَاِرغَب بِنَفسِكَ أَن تُقيمَ بِبَلدَةٍ","عُصفورُها يَسطو بِشُهبِ بُزاتِها",17,"ت",3,0],["وأرغمتُ قلبي على سَلوةٍ","فغايةُ ما نال منها الطلاق",18,"ق",1,0],["وأرغد الناس عيشا إن دنا أو نأى","من أتلف الحال في ذا المبسم الحالي",19,"ل",2,0],["وارغَب عن الدنيا الغرورِ وأهلِها","إن كان قلبُكَ بالفضيلةِ يَرغَب",20,"ب",1,0],["وأَرْغَمْتَ أَنْفَ النَّائِبَاتِ بِوَطْأَةٍ","تَخِفُّ عَلَى ظَهْرِ الزَّمَانِ وَتَثْقُلُ",21,"ل",1,0],["وَاِرغَب إِلى اللَهِ الَّذي لَم يَزَل","في يَدِهِ النِعمَةُ وَالنقمَه",22,"م",2,0],["وَاِرغَب إِلى دارٍ تَخَطّاها الشَقا","وَلِأَهلِها فيها النَعيمُ السَرمَدُ",23,"د",1,0],["وَاِرغَب بِكُلِّ نَحوَهُ","تَلقَ المَفازَ بِكُلِّهِ",24,"ل",2,0],["وَاِرغَب إِلى مُوافِقٍ في حُبِّها","تَظفَر في التَوبَةِ مَعَ حُسنِ العَمَل",25,"ل",1,0],["وَأرغب كتم سَرّي في التَصابي","لَدى النَجوى وَيَأبى الدَمع كَتما",26,"م",2,0],["وَأرغب أَن يَكون عَليَّ مَولىً","فَيَأبى أَن أَكون لَدَيهِ عَبدا",27,"د",2,0],["وأُرغِمُ حُسَّدي فَقَدِ اسْتَطالوا","ولولا أنت ما حَسدوا مكاني",28,"ن",2,0],["وَأَرغَمتُ عَينَ الشامِتينَ بِظاهِري","وَإِن رَغِمَت نَفسي بِما هُوَ في سِرّي",29,"ر",2,0],["وارغب إلى الله واجهد","بالسيرة العلويه",30,"ه",1,0],["وارغم الحاسد في نيل العلى","وَلْيَمُتْ خَصْمُك إرغاماً وقهرا",31,"ر",2,0],["وأَرْغَمْتَ آناف الخطوب فأَدبَرَتْ","بذلَّةِ مرغومٍ لعزَّةِ راغم",32,"م",1,0],["وأرغَبُ عن سواك بكل حالٍ","وأطْمَعُ في أياديك الرغاب",33,"ب",1,0],["وأرغمت آناف الطغاة فأصْبَحَتْ","تصعِّر ممَّا أبْصَرَتْ خدّ صاغر",34,"ر",1,0],["وأرغمت آنافاً وأكبتَّ حُسَّداً","وحاقَ بأهل المكر عاقبة المكر",35,"ر",1,0],["وأرغمتُ أنف الحاسدين بمجده","فلا زالَ في المجد العزيز الممجَّدا",36,"د",2,0],["وأرغم من نيله حسّدي","فراحوا وكل نديم الندم",37,"م",1,0],["وأرغمت الأعادي بالعطايا","فشكري عند جودكم رهين",38,"ن",1,0],["وأرغمت حُسّاوي بوعد وإنما","تلافهم أن ينجز الوعد صاحبه",39,"ب",2,0],["وأرغمها أنوفاً من أناسٍ","غَدَوْا يَستنزِلون عن النِّزالِ",40,"ل",1,0],["وَأَرغم بِالبرهان أَنف مفند","جَهول عَنيد فيهِ قَد قُضِيَ الأَمر",41,"ر",1,0],["وَأَرغب عَما فيهِ لِلحَق نَصرة","إِلى باطلٍ شينٍ وَخيم العَواقب",42,"ب",1,0],["وَأَرغم بِالإِنصاف أَنف معاندٍ","ظَلوم سَفيه الرَأي نسلِ لِئام",43,"م",1,0],["وارغمت أنفاً منهم وتركتهم","يعضون من غيظ رؤوس الأباهم",44,"م",1,0],["وَأَرغد عَيشٍ مِنهُ صَفو المَشارِبِ","وَراحَة بالٍ ما العُيون تَفَجَّرَت",45,"ت",1,0],["وأرغمتَ الأنوفَ إذِ اشمَخرَّت","لذاكَ ونالت الأرضَ الجسوم",46,"م",1,0],["وَاِرغب إِلى اللَه في الغُفران مُجتَهِداً","هَذا الصباح بَدا وَاللَّيل مُنهَزم",47,"م",1,0],["وارْغَبْ إلى اللهِ تَظْفَرْ","مِنْ بِرِّهِ بِلَطائِفْ",48,"ف",1,0],["وأُرغمتُ يومًا لحمل القفاف","فما كنت عنها بمستكبر",49,"ر",1,0],["وارغب إلى اللّه في إحسان خاتمة","تلقى بها اللّه والرضوان يؤتيها",50,"ي",3,0],["وأرغد العيش ما صادفت خلوته","من قلب مرتقبٍ أَو عين مختبلِ",51,"ل",1,0],["وَأُرغِدَت أَشهُراً بِالقُهبِ أَربَعَةً","في سِرِّ مُستَأسِدِ القُريانِ مِحبارِ",52,"ر",1,0],["وَارْغَبْ أباكَ السَّيِّدُ الأ","تقَى الحَسيبُ الأمْجَدُ",53,"د",1,0],["وارغب إلى الله مما في خزائنه","فإنما هو بين الكاف والنون",54,"ن",1,0],["وارغب بعقلك أن تبيع العالي ال","باقي بذا الأدنى الذي هو فان",55,"ن",1,0],["وأرغب الرحمن في توبة","فعسى أحظى بها قبل الأجل",56,"ل",1,0],["وَاِرغَب بِسَمعِكَ عَن أفيكة من رَوى","سَفَكوا الدَماءِ عَلى الثريدِ الأَعفَرِ",57,"ر",1,0],["وَاِرغَب بِنَفسِكَ أَن تُعاشِرَ غَيرَ مَن","كَرُمت مَذاهِبُ نَفسِهِ في المَعشَرِ",57,"ر",1,0],["وَاِرغَب عَنِ الدُنيا فَإِنَّ وَراءَها","يَوماً ثَقيلاً ذا غفارٍ مُصغرِ",57,"ر",1,0],["وأرغب في الإهمال حيناً لأنني","أرى لي به حرية وحبورا",58,"ر",2,0],["وأرغب في خفيف النور ليلاً","أخاف فرار أشباح الهناء",59,"ا",2,0],["وَأرغم أَنف الكاشحين بِوَطأتي","وَأسحب في مشيي عَلى رغمِهم بردي",60,"د",2,0],["وأرغو نابٌ في الحروب محكم","ضنين على نفس المشحِّ المغالب",61,"ب",1,0],["وارغب لمن قد زكت اصلا وعنصرها","قد طاب في الاصل والاخلاق والشيم",62,"م",1,0],["وارغب لكفك أن تخط بنانها","خيراً 