{"poems":[[63,"هذه دارها على الخلصاء","https://www.aldiwan.net/poem45779.html","الخفيف"],[71,"أرى شأنيك شأنهما انبجاس","https://www.aldiwan.net/poem4022.html","الوافر"],[73,"هو الدهر فاصبر للذي أحدث الدهر","https://www.aldiwan.net/poem11936.html","الطويل"],[35,"عرفت الدار كالخلل البوالي","https://www.aldiwan.net/poem39097.html","الوافر"],[51,"متشبث بعلائقي متخلص","https://www.aldiwan.net/poem64932.html","الكامل"],[43,"لهوى النفوس سريرة لا تعلم","https://www.aldiwan.net/poem10567.html","الكامل"],[45,"أهلك والليل أيها الرجل","https://www.aldiwan.net/poem65644.html","المنسرح"],[49,"الله كاف فمالي دونه كاف","https://www.aldiwan.net/poem62178.html","البسيط"],[49,"ألا إنما الإخوان عند الحقائق","https://www.aldiwan.net/poem62188.html","الكامل"],[66,"أصم الله أسمعنا الملاما","https://www.aldiwan.net/poem39927.html","الوافر"],[31,"وما ظبية من ظباء الأراك","https://www.aldiwan.net/poem42611.html","المتقارب"],[74,"جرر ملاءة كل يوم شامس","https://www.aldiwan.net/poem12971.html","الكامل"],[105,"وفت الظنون وبرت الآمال","https://www.aldiwan.net/poem42085.html","الكامل"],[48,"يا سائل الله فزت بالظفر","https://www.aldiwan.net/poem63407.html","المنسرح"],[151,"ألا فاشكروا نعمى الإله يزدكم","https://www.aldiwan.net/poem68580.html","الطويل"],[170,"بيني فما أنت من جدي ولا لعبي","https://www.aldiwan.net/poem1605.html",""],[170,"سقها ولو ذهب السرى بسراتها","https://www.aldiwan.net/poem1609.html",""],[186,"أخلآى بالثغر دام الفراق","https://www.aldiwan.net/poem14614.html","المتقارب"],[262,"إني أعيذك أن تلقى الدنا عوضا","https://www.aldiwan.net/poem38194.html","البسيط"],[271,"للقلب إن طال البعاد تقرب","https://www.aldiwan.net/poem35241.html","الكامل"],[281,"إذا لم يكن من حادث الدهر موئل","https://www.aldiwan.net/poem60784.html","الطويل"],[339,"يا أيها الطالب من مثله","https://www.aldiwan.net/poem68692.html","السريع"],[350,"لمغيب قلبي في هواكم مشهد","https://www.aldiwan.net/poem15644.html","الكامل"],[350,"لا يوحشنك في طري","https://www.aldiwan.net/poem15848.html","مجزوء الكامل"],[350,"بدت لعيني بالستور والكلل","https://www.aldiwan.net/poem15861.html","الرجز"],[354,"دع الأجفان تسلب منك جسما","https://www.aldiwan.net/poem39960.html","الوافر"],[354,"ألام بحبه فأزيد وجدا","https://www.aldiwan.net/poem40390.html","الوافر"],[365,"إذا لم تقدرا أن تسعداني","https://www.aldiwan.net/poem60633.html","الوافر"],[367,"صبرت على استبطاء عاقبة الصبر","https://www.aldiwan.net/poem17308.html","الطويل"],[392,"ياطالبا للوصيه","https://www.aldiwan.net/poem54448.html","عموديه"],[417,"ما لها تطوي فيافي الأرض سيرا","https://www.aldiwan.net/poem53994.html","الرمل"],[417,"قدمت قدوم الغاديات السواجم","https://www.aldiwan.net/poem54041.html","الطويل"],[417,"ذكرت على النوى عهد التصابي","https://www.aldiwan.net/poem54047.html","الوافر"],[417,"أسرك من باد لعينيك حاضر","https://www.aldiwan.net/poem54066.html","الطويل"],[417,"تنقلت مثل البدر يا طلعة البدر","https://www.aldiwan.net/poem54158.html","الطويل"],[417,"أهاج الجوى برقا أغار وأنجدا","https://www.aldiwan.net/poem54165.html","الطويل"],[438,"سلام على الربع من ذي سلم","https://www.aldiwan.net/poem2553.html","المتقارب"],[438,"وداعاً أيها القلب الحزين","https://www.aldiwan.net/poem2570.html","الوافر"],[438,"فؤاد عصاه صبره وهو طالبه","https://www.aldiwan.net/poem2577.html","الطويل"],[552,"ألا عوجا لمجتمع السيال","https://www.aldiwan.net/poem47286.html","البسيط"]],"verses":[["واِرغَوى باطِلي وَعاثَ بياضٌ","مِن قَتيرٍ في لِمَّةٍ سَوداءِ",0,"ا",2,0],["وَأَرغَمَ بَأسُهُم آنافَ قَومٍ","تَجَنَّبَها لِعِزَّتِها العُطاسُ",1,"س",1,0],["وَأَرغَمَ في بِرّي أُنوفَ عِصابَةٍ","لِقاؤُهُمُ جَهمٌ وَلَحظُهُمُ شَزرُ",2,"ر",1,0],["وَأَرغَمَ ما عَزَمنَ البَينُ حَتّى","دَفَعنَ بِذي المَزارِعِ وَالنِجالِ",3,"ل",1,0],["وارغب بودي أن يُذالَ فإنني","في غير ذاك من الأمور أُرخِّصُ",4,"ص",1,0],["وَأَرَغتَ ما لِأَبي العَشائِرِ خالِصاً","إِنَّ الثَناءَ لِمَن يُزارَ فَيُنعِمُ",5,"م",1,0],["وَاِرغَب إِلى اللَهِ لا إِلى أَحَدٍ","فَإِنَّهُ خَيرُ واصِلٌ تَصِلُ",6,"ل",1,0],["وَاِرغَب بِنَفسِكَ عَمّا لا صَلاحَ لَهُ","وَأَوسَعِ الناسِ مِن بِرٍّ وَإِلطافِ",7,"ف",1,0],["وَأَرغَبُ عَمّا فيهِ ذُلٌّ وَريبَةٌ","وَأَعلَمُ أَنَّ اللَهَ ما عِشتُ رازِقي",8,"ق",2,0],["وَأَرغَدَنا عَلى التَفريقِ عَيشاً","وَأَحسَنَنا لِفَقدِ الإِلفِ حالا",9,"ل",2,0],["وَأَرغَبُ في وُدِّ مَن لَم أَكُن","إِلى وُدِّهِ قَبلِكُم راغِبا",10,"ب",2,0],["وَاِرغَب بِنَفسِكَ عَن مَقامَةِ فاضِلٍ","قَد قامَ يَمثُلُ في خَصاصَةِ بائِسِ",11,"س",1,0],["وَارْغَبْ بنفسكَ عَن سِواها إن دَنا","مِنكَ الرّواحُ وآذنَ التّرحالُ",12,"ل",1,0],["وَاِرغَب إِلى اللَهِ لا إِلى جَسَدٍ","مُنتَقِلٍ مِن صِباً إِلى كِبَرِ",13,"ر",1,0],["وَأُرغِم أَنفَ الجَحدِ مِن كُلِّ مُلحِدِ","وَإِن زَهزَهُ البَطّالُ عِطفاً لِمُنشِدِ",14,"د",1,0],["وَاِرغَب بِمَدحِكَ إِلّا في سَليلِ عُلاً","يُنمَى إِلى العِزِّ مِن آبائِكَ النُجُبِ",15,"ب",1,0],["وَاِرغَب بِنَفسِكَ أَن تُقيمَ بِبَلدَةٍ","عُصفورُها يَسطو بِشُهبِ بُزاتِها",16,"ت",3,0],["وأرغمتُ قلبي على سَلوةٍ","فغايةُ ما نال منها الطلاق",17,"ق",1,0],["وأرغد الناس عيشا إن دنا أو نأى","من أتلف الحال في ذا المبسم الحالي",18,"ل",2,0],["وارغَب عن الدنيا الغرورِ وأهلِها","إن كان قلبُكَ بالفضيلةِ يَرغَب",19,"ب",1,0],["وأَرْغَمْتَ أَنْفَ النَّائِبَاتِ بِوَطْأَةٍ","تَخِفُّ عَلَى ظَهْرِ الزَّمَانِ وَتَثْقُلُ",20,"ل",1,0],["وَاِرغَب إِلى اللَهِ الَّذي لَم يَزَل","في يَدِهِ النِعمَةُ وَالنقمَه",21,"م",2,0],["وَاِرغَب إِلى دارٍ تَخَطّاها الشَقا","وَلِأَهلِها فيها النَعيمُ السَرمَدُ",22,"د",1,0],["وَاِرغَب بِكُلِّ نَحوَهُ","تَلقَ المَفازَ بِكُلِّهِ",23,"ل",2,0],["وَاِرغَب إِلى مُوافِقٍ في حُبِّها","تَظفَر في التَوبَةِ مَعَ حُسنِ العَمَل",24,"ل",1,0],["وَأرغب كتم سَرّي في التَصابي","لَدى النَجوى وَيَأبى الدَمع كَتما",25,"م",2,0],["وَأرغب أَن يَكون عَليَّ مَولىً","فَيَأبى أَن أَكون لَدَيهِ عَبدا",26,"د",2,0],["وأُرغِمُ حُسَّدي فَقَدِ اسْتَطالوا","ولولا أنت ما حَسدوا مكاني",27,"ن",2,0],["وَأَرغَمتُ عَينَ الشامِتينَ بِظاهِري","وَإِن رَغِمَت نَفسي بِما هُوَ في سِرّي",28,"ر",2,0],["وارغب إلى الله واجهد","بالسيرة العلويه",29,"ه",1,0],["وارغم الحاسد في نيل العلى","وَلْيَمُتْ خَصْمُك إرغاماً وقهرا",30,"ر",2,0],["وأَرْغَمْتَ آناف الخطوب فأَدبَرَتْ","بذلَّةِ مرغومٍ لعزَّةِ راغم",31,"م",1,0],["وأرغَبُ عن سواك بكل حالٍ","وأطْمَعُ في أياديك الرغاب",32,"ب",1,0],["وأرغمت آناف الطغاة فأصْبَحَتْ","تصعِّر ممَّا أبْصَرَتْ خدّ صاغر",33,"ر",1,0],["وأرغمت آنافاً وأكبتَّ حُسَّداً","وحاقَ بأهل المكر عاقبة المكر",34,"ر",1,0],["وأرغمتُ أنف الحاسدين بمجده","فلا زالَ في المجد العزيز الممجَّدا",35,"د",2,0],["وأرغم من نيله حسّدي","فراحوا وكل نديم الندم",36,"م",1,0],["وأرغمت الأعادي بالعطايا","فشكري عند جودكم رهين",37,"ن",1,0],["وأرغمت حُسّاوي بوعد وإنما","تلافهم أن ينجز الوعد صاحبه",38,"ب",2,0],["وأرغمها أنوفاً من أناسٍ","غَدَوْا يَستنزِلون عن النِّزالِ",39,"ل",1,0]]}