{"poems":[[88,"هل الدهر إلا أعجمي أخاطبه","https://www.aldiwan.net/poem45012.html","الطويل"],[72,"أيها البحر نائلا وعلوما","https://www.aldiwan.net/poem18744.html","الخفيف"],[51,"سمعا أبا إسحق إنك ماجد","https://www.aldiwan.net/poem66524.html","الكامل"],[44,"ما لكثيب الحمى إلى عقده","https://www.aldiwan.net/poem30552.html","المنسرح"],[69,"إن للرسام كفا","https://www.aldiwan.net/poem28288.html","مجزوء الرمل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21104","الرمل"]],"verses":[["أيَثْني إلى وجه اللئيم بوجهه","ويرتدّ مُزورّاً عن الحُرّ جانبه",0,"ب",2,0],["أيّ ثلج شابت به الأرض مرأًى","حين شابت به المفاصل مخبر",1,"ر",1,0],["أيثيرُ من شعري دفين عيوبه","ولكل شعر مستثارُ دفين",2,"ن",1,0],["إيثارَ شَزرِ القُوى يَرى جَسَدَ ال","مَعروفِ أَولى بِالطِبِّ مِن جَسَدِه",3,"د",2,0],["أيُّ ثوبٍ لمستْهُ","صارَ مرسوماً شريفا",4,"ف",2,0],["أيّ ثغرٍ ما يُخفَ يَندب لهُ","ومتى يخل مِن القودِ يصن",5,"ن",1,0]]}