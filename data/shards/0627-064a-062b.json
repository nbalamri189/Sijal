{"poems":[[90,"هل الدهر إلا أعجمي أخاطبه","https://www.aldiwan.net/poem45012.html","الطويل"],[74,"أيها البحر نائلا وعلوما","https://www.aldiwan.net/poem18744.html","الخفيف"],[53,"سمعا أبا إسحق إنك ماجد","https://www.aldiwan.net/poem66524.html","الكامل"],[46,"ما لكثيب الحمى إلى عقده","https://www.aldiwan.net/poem30552.html","المنسرح"],[71,"إن للرسام كفا","https://www.aldiwan.net/poem28288.html","مجزوء الرمل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21104","الرمل"],[111,"تكب على دنياك وهي تبيد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545632",""],[240,"أيثبت مدحي في دواوين مدحكم","https://www.aldiwan.net/poem31594.html","الطويل"],[255,"إمام الورى المبعوث من آل هاشم","https://www.aldiwan.net/poem15054.html","الطويل"],[274,"إذا قامت بواكيك","https://www.aldiwan.net/poem26747.html","الهزج"],[275,"أليس يعيش إلا من يروغ","https://www.aldiwan.net/poem35051.html","الوافر"],[347,"قيل لي هات في الوطن","https://www.aldiwan.net/poem55326.html","مجزوء الخفيف"],[438,"عارض الصفح في يديك الصفاحا","https://www.aldiwan.net/poem12583.html","الخفيف"],[458,"إسألوا الشاحب القمر","https://www.aldiwan.net/poem61574.html","مجزوء الخفيف"],[469,"ولهي في الهوى حديث قديم","https://www.aldiwan.net/poem3279.html","عموديه"],[469,"ورد الحياء والخجل","https://www.aldiwan.net/poem3479.html","عموديه"],[471,"بنفسي من لا بد أني هاجره","https://www.aldiwan.net/poem50433.html","الطويل"],[556,"إن من يعذل نصحا","https://www.aldiwan.net/poem47887.html","مجزوء الرمل"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112428","الرمل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46562","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49961","الكامل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141316","البسيط"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87828","الخفيف"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48213","الخفيف"],[2799,"","https://poetry.dctabudhabi.ae/diwan/poem/121137","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201755","الخفيف"],[3009,"","https://poetry.dctabudhabi.ae/diwan/poem/102361","الطويل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132156","الوافر"],[3865,"","https://poetry.dctabudhabi.ae/diwan/poem/203199","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77152","الطويل"],[4961,"في ظلال ِ الصَّدق ِ تُنْتَخَبُ الجواهر","https://www.poetsgate.com/ViewPoem.aspx?id=58865",""],[5431,"الراحمون غمائم الرحمانِ","https://www.poetsgate.com/ViewPoem.aspx?id=200691",""],[5616,"زناد","https://www.poetsgate.com/ViewPoem.aspx?id=203483",""],[5616,"قنديل","https://www.poetsgate.com/ViewPoem.aspx?id=205034",""],[6102,"رسالة إلى \"موديل\" ...","https://www.poetsgate.com/ViewPoem.aspx?id=184870",""]],"verses":[["أيَثْني إلى وجه اللئيم بوجهه","ويرتدّ مُزورّاً عن الحُرّ جانبه",0,"ب",2,0],["أيّ ثلج شابت به الأرض مرأًى","حين شابت به المفاصل مخبر",1,"ر",1,0],["أيثيرُ من شعري دفين عيوبه","ولكل شعر مستثارُ دفين",2,"ن",1,0],["إيثارَ شَزرِ القُوى يَرى جَسَدَ ال","مَعروفِ أَولى بِالطِبِّ مِن جَسَدِه",3,"د",2,0],["أيُّ ثوبٍ لمستْهُ","صارَ مرسوماً شريفا",4,"ف",2,0],["أيّ ثغرٍ ما يُخفَ يَندب لهُ","ومتى يخل مِن القودِ يصن",5,"ن",1,0],["أيثلج صدر أو تغيض مدامع","ويبدىء عقل بعده ويعيد",6,"د",1,0],["أَيُثبَتُ مَدحي في دَواوينِ مَدحِكُم","وَيَخلو دَساتيرُ الجَوائِزِ مِن ذِكري",7,"ي",1,1],["أيثربَ من لي لو ظفرتُ بتربةٍ","يزولُ بها عنّي شقى وعناءُ",8,"ا",2,0],["أَيُثنينَ عَلى قَبرِك","أَم يَلعَنَّ أَحجارَك",9,"ك",1,0],["أيُثري مَن سَقَى خمراً وسمّاً","وللصُلَّاحِ ماءٌ لا يَسوغ",10,"غ",1,0],["أي ثيابي تطهري","واخلعي الرجس والدرن",11,"ن",1,0],["أي ثغرٍ سَما إليه أبو الفتْ","حِ فلم يبْتَدِرْ إليه افتتاحا",12,"ح",2,0],["أيّ ثأر لعاشق","فاته الحب إن ثأر",13,"ر",1,0],["أي ثوب مدبجٍ لخيوط المز","ن منه التوشيح والتسهيم",14,"م",1,0],["أيُّ ثقيلٍ ورملْ","يا قمراً رشدي أضلّ",15,"ل",1,0],["أَيَثبي أَخا ضَرورَةٍ أَصفَقَ العِدى","عَلَيهِ وَقَلَّت في الصَديقِ أَواسِرُه",16,"ر",2,0],["أيُّ ثِقْلٍ لك يا لا","حِي على القلبِ القريحِ",17,"ح",1,0],["أي ثغر لك لم يبتسم","وجراح فيك لم تلتئم",18,"م",1,1],["إِيثار كَعب شكره","طرق المَعالي وَعره",19,"ه",1,0],["إيثاره في بذل مهجته","أَو مالهِ ومُرادُهُ الحَمْدُ",20,"د",1,0],["إيثارك العهد مكتوباً على ورقٍ","بدء الإساءة من دون إلى دون",21,"ن",1,0],["أَيُّ ثَأرٍ بَيني وَبَينَكِ حَتّى","تَقفي دونَ ما أَرومُ وَدوني",22,"ن",2,0],["أيُّ ثوبٍ لو شاهدَ البزَّازُ","راقَ حُسْناً في طرَّتَيْهِ الطرازُ",23,"ز",1,1],["أيثور محتدّاً عليك مهدِّما","بيتاً هو الركن المحبّبُ والحمى",24,"ا",1,0],["أيّ ثأرٍ على الربى لكِ حتى","سلبتْها يداك كلّ طريف",25,"ف",1,0],["أيثبت ما قلتم وتُلغى زيادتي","دمي إِن أسيغت هذه لكم بَسل",26,"ل",1,0],["أيثنيني عن الحسناء زهد","وليلي بعدها أرقٌ وسهدُ",27,"د",1,1],["أي ثلاثُ ما لهن رابع","مثاله الدار وزيدٌ وأنا",28,"ن",2,0],["أَيَثبِتُ لُبٌّ وَالثُغورِ بَواسِم","تُساقِطُ لِلياقوتِ دُرّاً مُنَظَّما",29,"م",2,0],["أيُّ ثقل ٍ قدِ استفاقَ بحبٍّ","لمْ يعُدْ حمْلُهُ بحبِّكِ ثقلا",30,"ل",2,0],["إيثارنا المرْجوّ روح محمدٍ","والراحمون غمائم الرحمانِ",31,"ن",1,0],["أيثمر نخلنا والريح صِرٌّ","أيجري ماؤنا والماء شُحُّ؟",32,"ح",1,0],["أيُّ ثأرٍ هذا؟ وأي جهادٍ؟","إن شرَّ القتالِ شرٌّ وبيلُ",33,"ل",1,0],["أَيَّ ثَوبٍ وَضَعتِ؟ أَيَّ لِباسٍ؟","أَيَّ سَرجٍ نَزَعتِ؟ أَيَّ عِنانِ؟",34,"ن",1,0]]}