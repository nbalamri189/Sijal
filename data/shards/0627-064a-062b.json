{"poems":[[88,"هل الدهر إلا أعجمي أخاطبه","https://www.aldiwan.net/poem45012.html","الطويل"],[72,"أيها البحر نائلا وعلوما","https://www.aldiwan.net/poem18744.html","الخفيف"],[51,"سمعا أبا إسحق إنك ماجد","https://www.aldiwan.net/poem66524.html","الكامل"],[44,"ما لكثيب الحمى إلى عقده","https://www.aldiwan.net/poem30552.html","المنسرح"],[69,"إن للرسام كفا","https://www.aldiwan.net/poem28288.html","مجزوء الرمل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21104","الرمل"],[233,"أيثبت مدحي في دواوين مدحكم","https://www.aldiwan.net/poem31594.html","الطويل"],[248,"إمام الورى المبعوث من آل هاشم","https://www.aldiwan.net/poem15054.html","الطويل"],[267,"إذا قامت بواكيك","https://www.aldiwan.net/poem26747.html","الهزج"],[268,"أليس يعيش إلا من يروغ","https://www.aldiwan.net/poem35051.html","الوافر"],[340,"قيل لي هات في الوطن","https://www.aldiwan.net/poem55326.html","مجزوء الخفيف"],[429,"عارض الصفح في يديك الصفاحا","https://www.aldiwan.net/poem12583.html","الخفيف"],[451,"إسألوا الشاحب القمر","https://www.aldiwan.net/poem61574.html","مجزوء الخفيف"],[462,"ولهي في الهوى حديث قديم","https://www.aldiwan.net/poem3279.html","عموديه"],[462,"ورد الحياء والخجل","https://www.aldiwan.net/poem3479.html","عموديه"],[464,"بنفسي من لا بد أني هاجره","https://www.aldiwan.net/poem50433.html","الطويل"],[549,"إن من يعذل نصحا","https://www.aldiwan.net/poem47887.html","مجزوء الرمل"]],"verses":[["أيَثْني إلى وجه اللئيم بوجهه","ويرتدّ مُزورّاً عن الحُرّ جانبه",0,"ب",2,0],["أيّ ثلج شابت به الأرض مرأًى","حين شابت به المفاصل مخبر",1,"ر",1,0],["أيثيرُ من شعري دفين عيوبه","ولكل شعر مستثارُ دفين",2,"ن",1,0],["إيثارَ شَزرِ القُوى يَرى جَسَدَ ال","مَعروفِ أَولى بِالطِبِّ مِن جَسَدِه",3,"د",2,0],["أيُّ ثوبٍ لمستْهُ","صارَ مرسوماً شريفا",4,"ف",2,0],["أيّ ثغرٍ ما يُخفَ يَندب لهُ","ومتى يخل مِن القودِ يصن",5,"ن",1,0],["أَيُثبَتُ مَدحي في دَواوينِ مَدحِكُم","وَيَخلو دَساتيرُ الجَوائِزِ مِن ذِكري",6,"ي",1,1],["أيثربَ من لي لو ظفرتُ بتربةٍ","يزولُ بها عنّي شقى وعناءُ",7,"ا",2,0],["أَيُثنينَ عَلى قَبرِك","أَم يَلعَنَّ أَحجارَك",8,"ك",1,0],["أيُثري مَن سَقَى خمراً وسمّاً","وللصُلَّاحِ ماءٌ لا يَسوغ",9,"غ",1,0],["أي ثيابي تطهري","واخلعي الرجس والدرن",10,"ن",1,0],["أي ثغرٍ سَما إليه أبو الفتْ","حِ فلم يبْتَدِرْ إليه افتتاحا",11,"ح",2,0],["أيّ ثأر لعاشق","فاته الحب إن ثأر",12,"ر",1,0],["أي ثوب مدبجٍ لخيوط المز","ن منه التوشيح والتسهيم",13,"م",1,0],["أيُّ ثقيلٍ ورملْ","يا قمراً رشدي أضلّ",14,"ل",1,0],["أَيَثبي أَخا ضَرورَةٍ أَصفَقَ العِدى","عَلَيهِ وَقَلَّت في الصَديقِ أَواسِرُه",15,"ر",2,0],["أيُّ ثِقْلٍ لك يا لا","حِي على القلبِ القريحِ",16,"ح",1,0]]}