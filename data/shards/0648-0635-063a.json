4,"صرخة من وراء الأسوار","https://www.poetsgate.com/ViewPoem.aspx?id=12936",""],[5470,"كتبتُ عينيك","https://www.poetsgate.com/ViewPoem.aspx?id=10983",""],[5691,"طاعة عمياء","https://www.poetsgate.com/ViewPoem.aspx?id=206528",""],[5691,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=207079",""],[5847,"حوار مع القلم","https://www.poetsgate.com/ViewPoem.aspx?id=45479",""],[5974,"وداعا","https://www.poetsgate.com/ViewPoem.aspx?id=214637",""],[6093,"قليل_ كثير","https://www.poetsgate.com/ViewPoem.aspx?id=206057",""],[6102,"تحذير ..","https://www.poetsgate.com/ViewPoem.aspx?id=183311",""],[6102,"تقولين خذني","https://www.poetsgate.com/ViewPoem.aspx?id=183319",""],[520,"لك الحسب الباقي في عقب الدهر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577546",""],[6199,"حديث الرجل الأول","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79698&r=&rc=19",""],[6202,"يا مصر لا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86769&r=&rc=70",""],[6202,"عجز الضعيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86736&r=&rc=37",""],[406,"خيمة الظلماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63653&r=&rc=83",""],[6285,"هذه الشام لا تقولي كفانا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86807&r=&rc=0",""],[6291,"لم أزل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87671&r=&rc=4",""],[433,"لقاء القاهرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87049&r=&rc=2",""]],"verses":[["وصغتُ له المديح فآب شعري","بحلو مذاق ما بالكأس ذابا",0,"ب",2,0],["وَصِغارُها مِثلُ الدَبى وَكِبارُه","مِثلُ الضَفادِعِ في غَديرٍ مُقحَمِ",1,"م",1,0],["وَصَغا قُمَيرٌ كانَ يَم","نَعُ بَعضَ بِغيَةٍ اِرتِقابُه",2,"ب",2,0],["وَصِغَارٍ يُحَنَّكُو","نَ بِصَابٍ مِنَ اليَتَمْ",3,"م",1,0],["وَصُغْتِ فِي سَعَةِ","الْوَقْتِ زِينةً لِلآْلِ",4,"ل",1,0],["وصغَّرك ابتعادك فيه حتى","إليك استشرف المتشوِّفونا",5,"ن",2,0],["وصغت ثلجاً فاكتسى برده","ذكاء ألفاظك حتى نفح",6,"ح",1,0],["وصغت المعاني كزهر النجوم","فبوَّأك السعد كيوانها",7,"ن",3,0],["وصغار الأمور رِدْفٌ لذي الرُّت","بة منها والفخرِ والكبرياءِ",8,"ا",2,0],["وَصِغارٍ مِثلِ أَفراخِ القَطا","يَتَضاغَونَ مِنَ الجوعِ الشَديد",9,"د",1,0],["وصِغارُ إخوانٍ يَرَوْنَ سَلامَهُمْ","في الكَائِناتِ مُعَلَّقاً بسَلامي",10,"م",2,0],["وَصَغيرُ الحُظوظِ يَنمى عَلى الأَي","يامِ حَتّى يَجيءَ مِنهُ كَبيرُه",11,"ر",2,0],["وَصَغَّرتَ في الدُنيا مَساكِنَ أَهلِها","فَباهَيتَ فيها بِالبِناءِ وَعالَيتا",12,"ت",2,0],["وَصُغْتُ مِنَ السِّحْرِ الْحَلالِ قَصَائِدَاً","تَظَلُّ بِهَا نَفْسُ الْمُعِيدِ لَهَا نَشْوَى",13,"و",2,0],["وصَغيرُها الحِزبُ الضَّنينُ بحقّها","إن جادَ كلُّ مُسامحٍ بذَّالِ",14,"ل",1,0],["وصغاركَ الأشبالِ تبكي","اللَّيثَ بالدّمعِ الغزير",15,"ر",1,0],["وَصَغا العَشِيُّ وَبانَ أَل","وانُ المِساحِ مِنَ الأَعابِل",16,"ل",1,0],["وَصَغَّرَ في عَيني اِختِبارُ خِصالِهِ","مَحاسِنَ أَخبارٍ أَتَتني عَلى البُعدِ",17,"د",1,0],["وَصَغا إِلى أُخرى يُراقِبُها","فينا وَكُنتُ أَحَقَّ مَن رَقَبا",18,"ب",2,0],["وَصغار الحملان مَربوطة تص","بو إِلى أمّهاتها وَتَلوب",19,"ب",1,0],["وصُغنا لكَ الشعرَ حُبَّ الصِّبا","وشدوَ الأماني وشجو الذِّكَرْ",20,"ر",1,0],["وَصَغَتْ سَنابلُ مثلما أوحَى لها","تأويلُ يوسفَ فهي خُضرٌ تنجمُ",21,"م",1,0],["وصُغْتُ في الوارِدِ المأمولِ تَهْنِئَةً","وجاء كالنجْمِ أُسْقِينا به المَطَرا",22,"ر",2,0],["وَصِغارِ أبكارٍ شَكَت","خَجلاً فعاذَتْ بالكَمائِمْ",23,"م",1,0],["وَصِغارُها مِثلُ الدَبى وَكِبارُها","مِثلُ الضَفادِعِ في غَديرٍ مُقحَمِ",24,"م",1,0],["وصغير الشأن عبدٍ","خامل الذكر حقيرِ",25,"ر",1,0],["وصُغنا له من كل ما تُبدعُ النُّهَى","روائعَ لم يُبذَلْ لهنَّ نِقَاب",26,"ب",1,0],["وَصُغْتُهُ فَاتِنَ الأَلْوَانِ مُزْدَهِراً","كَأَنَّمَا نَقَشَتْهُ كَفُّ آذَارِ",27,"ر",1,0],["وصَغَتْ مَسَاجِدُه لتَرْدِيدِ اسْمِهِ","فكأنما يَحْلُو عَلَى التَّرْدِيدِ",28,"د",1,0],["وَصُغِ الشمْسَ في الأَصَائِلِ تَاجاً","وَانْسُجِ الرَّوْضَ في الرَّبِيع بُرُودَا",29,"د",2,0],["وصغتُ من وَهَج الأحلام لي مدناً","واليوم لا وهجاً أرجو ... ولا مُدُنا",30,"ن",2,0],["وصغار مؤنثون وغيد","غاليات الحلى رخاص المباسم",31,"م",1,0],["وَصَغيرُ الخُطُوطِ يُنْمَى على الأيّ","امِ، حتّى يَجيءَ منهُ كَبيرُهْ",32,"ر",2,0],["وصغارُ النُّجُومِ لَم تَدَّعِ الضَّوءِ","إِذَا حَلَّتِ السَّمَاءَ الشُّمُوسُ",33,"س",1,0],["وصغتُ من الذهن المصفَّى بدائعا","أقرِّط أسماعَ الرُّواةِ بها شَذْرا",34,"ر",2,0],["وصُغ من فعلها تيجان فخر","يضيء بها ويبيض الجبين",35,"ن",1,0],["وصغهما من غير ما تقدما","كبنية المفعول نحو المنتمى",36,"م",2,0],["وَصغا الجَمعُ لِلأَسيرِ يُنادي","هِ بِشَتّى مَطاعِن التَحقير",37,"ر",1,0],["وَصُغْرَى وَكُبْرَى مَعْ فَوَائِدِ غَيْرِهَا","وَفِي بَعْضِهَا إِقْرَارُ أَعْيُنِ رُوَّادِ",38,"د",1,0],["وصغْتُ تَهنئةً بالفتحِ تَحسُدُها","من حُسْنِها في السماء الأنجمُ الزُّهُر",39,"ر",1,0],["وصُغْتَ لهذه الدنيا نِظاماً","يَصُدُّ يَدَاً تَرُوم المستحيلا",40,"ل",2,0],["وصُغْتَ عقود النّظمِ والنثر يافِعاً","فعادَ إلى رَيعانه مِنهما العُمرُ",41,"ر",1,0],["وصغيراً لست أعرفه","قطعه الإِنسان من كبده",42,"د",2,0],["وصُغْتُ له تاجَ المديحِ ولم أَكُنْ","لأَترُكَه حتى يكونَ مُرَصَّعا",43,"ع",2,0],["وصغت للدر ضداً","وللهواء نقيضا",44,"ض",2,0],["وصغى إلى رجعِ الحمام بسجعِهِ","فأهاجَتِ البَلوى بلابِلُ صدرِهِ",45,"ر",2,0],["وصُغْتُ الرُقى إذ علّمَتْني جُفونُها","بناءَ القَوافي السّاحراتِ على الكَسْرِ",46,"ر",1,0],["وصغرت مقدار الخطايا بقدرة","يغور بصافي حلمها وغر الصدر",47,"ر",1,0],["وصُغْتَ مِنَ القَريضِ بَناتِ فِكْرٍ","دَفَعْتَ بِها الوَرَى نَحْو الوَراءِ",48,"ا",2,0],["وصُغتَه خدعةً لي منكَ يَحكي","لِجَوهَرِ ثَغرِه شطراً وشَطرا",49,"ر",2,0],["وصغت هواك للدنيا نشيدا","تراقص حالما مثل الشعاع",50,"ع",1,0],["وَصَغيرَينِ غَيرَ أَنَّ المَعالي","قَد يُمَتَّعنَ بِالصَغيرِ الصَريحِ",51,"ح",1,0],["وصغيرٍ القدّ هِمْتُ بِهِ","تَمّ فيه الحُسْنُ في الصِّغرِ",52,"ر",1,1],["وصغت لمنطقة المسا","مع من صغير أو كبير",53,"ر",1,0],["وصغاري غَيَّرت أَحوالهم","فاقةٌ دارَت عَلَيهم بِالدَمار",54,"ر",1,0],["وصِغارُ اللَّذَّاتِ ولَّت وأبقت","حَسراتٍ على ذنوبٍ كبارِ",55,"ر",1,0],["وصُغْتُكَ من فهمٍ وعلمٍ صياغةً","إذا لُمِسَتْ بالفكرِ دَقَّتْ على اللمس",56,"س",1,0],["وصغير من بني التر","ك يسقِّي بالكبار",57,"ر",1,0],["وصغت هلال الأفق نعلا وسابقت","مساعيك للعليا جياد الجنائب",58,"ب",1,0],["وصغتها من بديع الفكر خالصةً","كالدر صيغ على صرف من الذهب",59,"ب",1,0],["وَصَغَتْ أذْنُ يَانِعِ الآسِ","لِسَمَاعِ الطَّرَبْ",60,"ب",1,0],["وَصَغَى لِتَغْرِيدِ الحَمَامِ فَهَاجَهُ","بَرْقٌ بِأكْنَافِ الأبَيْرِقِ لاَحَا",61,"ح",2,0],["وصغتها نصلا، بريق الردى","في حده، والبسمة المشرقةْ",62,"ق",2,0],["وَصُغتُ مِنَ الإِكليلِ تاجاً لِمَفرِقي","وَنيطَت بِيَ الجَوزاءُ في عُنُقي سِمطا",63,"ط",2,0],["وصغا السِّماك الى المغيب وقد بدا","نجمُ الصّباحِ كأنّه دينارُ",64,"ر",1,0],["وصغه من فعل تعجّب وإن","جرّدته لا بدّ من جرّ بمن",65,"ن",1,0],["وصغ من المصدر لفظا مفعلا","وافتح أو اسكر عينه من قبل لا",65,"ل",2,0],["وَصَغَت أُذني لِزاجِرها","وَلَما تَشجى لِمُزدَجِرِه",66,"ر",2,0],["وصغار مشردين بلا أهل","تراموا على الطريق ومروا",67,"ر",3,0],["وصغيرين قد خلقنا فاعطينا","لهذا كوخاً وذلك قصرا",68,"ر",2,0],["وصغارٍ أبصروا النّور على","يد أهل النّور لا يخشون عابا",69,"ب",2,0],["وصغت مسامعها لسجع حمامة","عند انبلاج الصبح لما رجعا",70,"ع",2,0],["وصغت ضمائرها إلى الغدر","قلت ارحمي من كابد الولها",71,"ه",2,0],["وصغى الحبيب لقولهم فبدا","لي منه دون جناية هجر",72,"ر",1,0],["وصغيرهم وكبيرهم في ذا على","حد سواء ما سوى الولدان",73,"ن",1,0],["وصغت لها عقدا من النظم لؤلؤا","لكيلا يكون الجيد منها معطلا",74,"ل",2,0],["وصغير وكبير","ودقيق وجليل",75,"ل",1,0],["وصغر الرغفان دع ان تتركه","فان في كل رغيف بركه",76,"ه",1,0],["وصغت لك القريض عقود در","فانت من الذين لهم مضاء",77,"ا",2,0],["وصغيرهم حسان فهو بمهده","ما زال طفلاً كالحمامة يسجع",78,"ع",1,0],["وصغنا في مديحك من نجوم","سوائر مثلها عقداً ثمينا",79,"ن",2,0],["وصغت لها الهنا اذ فيك لاقت","قريناً يملأ الدنيا احتراما",80,"م",2,0],["وصغارُ الأقاحِ تلعبُ فى الجد","ول لِعبَ الأطفال فى المهرجَان",81,"ن",1,0],["وصغار توارثوا شر مهدٍ","أرضعوا فيه ثدي سوء الخصال",82,"ل",1,0],["وصغت في مدحهم من كل قافية","كأنما صغتها من معدن الذهب",83,"ب",1,0],["وَصَغيركُم عَبد العَزيزِ فَإِنَّني","أَطوي لِفُرقَتِهِ جَوىً لَم يَصغُرِ",84,"ر",1,0],["وَصغاري مثلُ اليهودِ بذُل","تَشْتَهي لو أتَيتُهُمْ بعَلامه",85,"م",2,0],["وصغار النفوس يبغي هواها","لو يعمّ الجميع بالأرزاء",86,"ا",2,0],["وصغنا حله مما تحلى","فلا زالت صفاتك في الجمال",87,"ل",1,0],["وصغت هجاءهم فإذا الأهاجي","على الأفواه لحن أو نشيد",88,"د",1,0],["وصغيرة في حجمها","لكنها إحدى الكبر",89,"ر",1,0],["وَصُغهُمَا مِن ذِى ثَلاَثٍ صُرِّفَا","قَابِلِ فَضلِ تمَّ غَيرِ ذِى انتِفاً",90,"ف",2,0],["وَصُغ مِن اثنَينِ فَما فَوقُ إلَى","عَشرَةٍ كفَاعِلٍ مِن فَعُلاَ",90,"ل",2,0],["وَصَغَّرُوا شُذُوذَا الَّذِى الَّتى","وَذَا مَعَ الفُرُوعِ مِنها تَا وَتِى",90,"ت",2,0],["وَصغى لِداعي اللَه لا اللاهي وَلَم","يَسمَع بسمعته مِن اللَهوات",91,"ت",1,0],["وصغرني معشر باللسان","هنيئا لهم حين ذاقوا الصغارا",92,"ر",2,0],["وصِغارٍ تَوحَّموا بكِبارٍ","فأَتَوا مِثلَهم بحُسنِ انتِساقِ",93,"ق",1,0],["وصغته من دماء القلب عقدا","فلم تبصر له الحسنا مثيلا",94,"ل",2,0],["وصغت له شعراً فظنوه شاعراً","له أدبٌ عذب المذاق غزير",95,"ر",1,0],["وصغتُك في فمي لحناً شجياً","يُرتَّلُ ما شدا للحُبِّ شادي",96,"د",2,0],["وَصُغْتَ حُلىً مِن عُلاً أحكمت","عَلى عَنق الدَّهر أزرارَها",97,"ر",3,0],["وَصُغتَها مِن عَصيرِ القَلبِ مَعربةً","عَن مُضنياتي وَعَن أَقسى تَباريحي",98,"ي",1,0],["وصغتُ لمجدِكَ كلَّ قصيدٍ","إذا ما نُنوشِد أصغى الورى",99,"ا",1,0],["وَصَغ لَهُ الأَصداف قَبراً فَما","يَستَبطن الدرة غَير الصَدف",100,"ف",1,0],["وصغيرهم وهو الكبير لدى الملا","ولدى العلا هو أكبر الكبراء",101,"ا",2,0],["وصغنا من حوادثنا","خطاباً كلُّه أمل",102,"ل",1,0],["وصُغتُ فرائد الأشعار لحنا","نواسي الهوى من كل فنِّ",103,"ن",1,0],["وَصُغْ للحُسْنِ أبياتًا عِذابًا","مُرصَّعَةً بألوانِ الجُمانِ",104,"ن",1,0],["وصُغنَا مِن شُعَاعِ الحَرفِ شِعراً","أَرَاهُ عَلَى دُمُوعِكِ سَوفَ يَأسَى",105,"س",2,0],["وَصغْتُ كلّ جمالِ الرُّوحِ مِنْ نَغَمٍ","وسط القريضِ قريّا فيه أحترفُ",106,"ف",1,0],["وصُغتُها في عيونِ الشعرِ قافيةً","وكنتُ في وصفِها بالحسنِ ابتدعُ",107,"ع",1,0],["وصغنا بصدق القوم أشعار أنسنا","وعشنا ليال الدهر لم نتبلد",108,"د",1,0],["وصغاري تيتموا في حياتي","«يايدَ الظلم ما رحمتً الصغارا»",109,"ر",2,0],["وصُغتُ من رِقَّةِ الأسحَارِ أغنِيَةً","تَشُفُّ ألحَانها مِن رَعشَةِ الشُّهُبِ",110,"ب",1,0],["وصَغيرٍ يتَّمتْهُ غارَةٌ","قضَتِ الأمُّ لديْها والأبُ",111,"ب",1,0],["وصغار ٍوهَبْتُهُمْ أمْس ِعِلْ