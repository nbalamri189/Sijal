{"poems":[[3,"وتظل عبلة في الخدور تجره","https://www.aldiwan.net/poem200.html",""],[9,"أصرمت حبلك من لمي","https://www.aldiwan.net/poem21911.html","مجزوء الكامل"],[93,"كيف قوضت يا علم","https://www.aldiwan.net/poem11343.html","مجزوء الخفيف"],[93,"يا ترب عصرك بيتي","https://www.aldiwan.net/poem11464.html","المجتث"],[88,"أجدك يا كواكب لا ترينا","https://www.aldiwan.net/poem45071.html","الوافر"],[72,"ما البرق في كانونه قد قدح","https://www.aldiwan.net/poem18480.html","السريع"],[72,"حويت ذرا المجد لما حويت","https://www.aldiwan.net/poem20191.html","المتقارب"],[51,"صرحت عن طوية الأصدقاء","https://www.aldiwan.net/poem7996.html","الخفيف"],[91,"أعلى عيني من الدمع غشاء","https://www.aldiwan.net/poem62753.html","عموديه"],[92,"وأود أن أحيا بفكرة شاعر","https://www.aldiwan.net/poem38906.html","الكامل"],[45,"أوحشت أربع العقيق ودوره","https://www.aldiwan.net/poem63578.html","الخفيف"],[49,"جمعت من الدنيا وحزت ومنيتا","https://www.aldiwan.net/poem10833.html","الطويل"],[87,"أقلا ملامي في هوى الشادن الأحوى","https://www.aldiwan.net/poem8196.html","الطويل"],[105,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[102,"أنا ساعة الرجل الصبور","https://www.aldiwan.net/poem33054.html","مجزوء الكامل"],[39,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[50,"وإني لقادتني إليه مودتي","https://www.aldiwan.net/poem63833.html","الطويل"],[50,"طرب الحمام فهاج لي طربا","https://www.aldiwan.net/poem64861.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85418","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39585","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39580","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16672","البسيط"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30496","الكامل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9970","الكامل"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116961","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54262","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54223","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54292","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54284","الخفيف"],[104,"برقية عاجلة إلى بلقيس","https://www.poetsgate.com/ViewPoem.aspx?id=5117",""],[100,"مآتم وأعراس","https://www.poetsgate.com/ViewPoem.aspx?id=50173",""],[45,"أُوحِشَتْ أرْبُعُ العَقيقِ وَدُورُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31336",""],[132,"قل لمن رام أن يحاول خطا","https://www.aldiwan.net/poem54816.html","الخفيف"],[142,"إذا نثر الناس الهرقلية الصفرا","https://www.aldiwan.net/poem58435.html","الطويل"],[160,"مكانك في الحشا مني مكين","https://www.aldiwan.net/poem59022.html","الوافر"],[222,"أول ما ما يقوله ابن زكري","https://www.aldiwan.net/poem55391.html","الرجز"],[223,"ملقيه بحسنك المأجور","https://www.aldiwan.net/poem41602.html","الخفيف"],[237,"ألا الحمد لله الذي منه إرشادي","https://www.aldiwan.net/poem18160.html","الطويل"],[364,"كتاب عبد إلى مولاه يعتذر","https://www.aldiwan.net/poem60915.html","البسيط"],[400,"قمر الهدى","https://www.aldiwan.net/poem6776.html","عموديه"],[402,"أيا شرف الإسلام دمت مشرفا","https://www.aldiwan.net/poem46521.html","الطويل"],[403,"يا قرير العين في بلده","https://www.aldiwan.net/poem33965.html","الرمل"],[432,"قفا فاسألا مني زفيرا وأدمعا","https://www.aldiwan.net/poem12378.html","الطويل"],[495,"فلو نظمت الثريا","https://www.aldiwan.net/poem10227.html","المجتث"],[514,"كتم الهوى فوشى النحول بسره","https://www.aldiwan.net/poem20801.html","الكامل"],[514,"كشفت حجاب السجف عن بيضة الخدر","https://www.aldiwan.net/poem20816.html","الطويل"],[515,"لك الحسب الباقي على عقب الدهر","https://www.aldiwan.net/poem12142.html","الطويل"],[529,"دعي لومي على فرط الهواء","https://www.aldiwan.net/poem37548.html","الوافر"],[538,"صدعت بحبه من بعد كتمي","https://www.aldiwan.net/poem48161.html","عموديه"],[552,"في رحاب الحب","https://www.aldiwan.net/poem24828.html","عموديه"],[573,"قف بربع الأسى وقوف الطليح","https://www.aldiwan.net/poem3652.html","الخفيف"],[575,"وصغير القد همت به","https://www.aldiwan.net/poem2942.html","المديد"]],"verses":[["وَصِغارُها مِثلُ الدَبى وَكِبارُه","مِثلُ الضَفادِعِ في غَديرٍ مُقحَمِ",0,"م",1,0],["وَصَغا قُمَيرٌ كانَ يَم","نَعُ بَعضَ بِغيَةٍ اِرتِقابُه",1,"ب",2,0],["وَصِغَارٍ يُحَنَّكُو","نَ بِصَابٍ مِنَ اليَتَمْ",2,"م",1,0],["وَصُغْتِ فِي سَعَةِ","الْوَقْتِ زِينةً لِلآْلِ",3,"ل",1,0],["وصغَّرك ابتعادك فيه حتى","إليك استشرف المتشوِّفونا",4,"ن",2,0],["وصغت ثلجاً فاكتسى برده","ذكاء ألفاظك حتى نفح",5,"ح",1,0],["وصغت المعاني كزهر النجوم","فبوَّأك السعد كيوانها",6,"ن",3,0],["وصغار الأمور رِدْفٌ لذي الرُّت","بة منها والفخرِ والكبرياءِ",7,"ا",2,0],["وَصِغارٍ مِثلِ أَفراخِ القَطا","يَتَضاغَونَ مِنَ الجوعِ الشَديد",8,"د",1,0],["وصِغارُ إخوانٍ يَرَوْنَ سَلامَهُمْ","في الكَائِناتِ مُعَلَّقاً بسَلامي",9,"ي",1,0],["وَصَغيرُ الحُظوظِ يَنمى عَلى الأَي","يامِ حَتّى يَجيءَ مِنهُ كَبيرُه",10,"ر",2,0],["وَصَغَّرتَ في الدُنيا مَساكِنَ أَهلِها","فَباهَيتَ فيها بِالبِناءِ وَعالَيتا",11,"ت",2,0],["وَصُغْتُ مِنَ السِّحْرِ الْحَلالِ قَصَائِدَاً","تَظَلُّ بِهَا نَفْسُ الْمُعِيدِ لَهَا نَشْوَى",12,"و",2,0],["وصَغيرُها الحِزبُ الضَّنينُ بحقّها","إن جادَ كلُّ مُسامحٍ بذَّالِ",13,"ل",1,0],["وصغاركَ الأشبالِ تبكي","اللَّيثَ بالدّمعِ الغزير",14,"ر",1,0],["وَصَغا العَشِيُّ وَبانَ أَل","وانُ المِساحِ مِنَ الأَعابِل",15,"ل",1,0],["وَصَغَّرَ في عَيني اِختِبارُ خِصالِهِ","مَحاسِنَ أَخبارٍ أَتَتني عَلى البُعدِ",16,"د",1,0],["وَصَغا إِلى أُخرى يُراقِبُها","فينا وَكُنتُ أَحَقَّ مَن رَقَبا",17,"ب",2,0],["وَصغار الحملان مَربوطة تص","بو إِلى أمّهاتها وَتَلوب",18,"ب",1,0],["وصُغنا لكَ الشعرَ حُبَّ الصِّبا","وشدوَ الأماني وشجو الذِّكَرْ",19,"ر",1,0],["وَصَغَتْ سَنابلُ مثلما أوحَى لها","تأويلُ يوسفَ فهي خُضرٌ تنجمُ",20,"م",1,0],["وصُغْتُ في الوارِدِ المأمولِ تَهْنِئَةً","وجاء كالنجْمِ أُسْقِينا به المَطَرا",21,"ر",2,0],["وَصِغارِ أبكارٍ شَكَت","خَجلاً فعاذَتْ بالكَمائِمْ",22,"م",1,0],["وَصِغارُها مِثلُ الدَبى وَكِبارُها","مِثلُ الضَفادِعِ في غَديرٍ مُقحَمِ",23,"م",1,0],["وصغير الشأن عبدٍ","خامل الذكر حقيرِ",24,"ر",1,0],["وصُغنا له من كل ما تُبدعُ النُّهَى","روائعَ لم يُبذَلْ لهنَّ نِقَاب",25,"ب",1,0],["وَصُغْتُهُ فَاتِنَ الأَلْوَانِ مُزْدَهِراً","كَأَنَّمَا نَقَشَتْهُ كَفُّ آذَارِ",26,"ر",1,0],["وصَغَتْ مَسَاجِدُه لتَرْدِيدِ اسْمِهِ","فكأنما يَحْلُو عَلَى التَّرْدِيدِ",27,"د",1,0],["وَصُغِ الشمْسَ في الأَصَائِلِ تَاجاً","وَانْسُجِ الرَّوْضَ في الرَّبِيع بُرُودَا",28,"د",2,0],["وصغتُ من وَهَج الأحلام لي مدناً","واليوم لا وهجاً أرجو ... ولا مُدُنا",29,"ن",2,0],["وصغار مؤنثون وغيد","غاليات الحلى رخاص المباسم",30,"م",1,0],["وَصَغيرُ الخُطُوطِ يُنْمَى على الأيّ","امِ، حتّى يَجيءَ منهُ كَبيرُهْ",31,"ر",2,0],["وصغارُ النُّجُومِ لَم تَدَّعِ الضَّوءِ","إِذَا حَلَّتِ السَّمَاءَ الشُّمُوسُ",32,"س",1,0],["وصغتُ من الذهن المصفَّى بدائعا","أقرِّط أسماعَ الرُّواةِ بها شَذْرا",33,"ر",2,0],["وصُغ من فعلها تيجان فخر","يضيء بها ويبيض الجبين",34,"ن",1,0],["وصغهما من غير ما تقدما","كبنية المفعول نحو المنتمى",35,"م",2,0],["وَصغا الجَمعُ لِلأَسيرِ يُنادي","هِ بِشَتّى مَطاعِن التَحقير",36,"ر",1,0],["وَصُغْرَى وَكُبْرَى مَعْ فَوَائِدِ غَيْرِهَا","وَفِي بَعْضِهَا إِقْرَارُ أَعْيُنِ رُوَّادِ",37,"د",1,0],["وصغْتُ تَهنئةً بالفتحِ تَحسُدُها","من حُسْنِها في السماء الأنجمُ الزُّهُر",38,"ر",1,0],["وصُغْتَ لهذه الدنيا نِظاماً","يَصُدُّ يَدَاً تَرُوم المستحيلا",39,"ل",2,0],["وصُغْتَ عقود النّظمِ والنثر يافِعاً","فعادَ إلى رَيعانه مِنهما العُمرُ",40,"ر",1,0],["وصغيراً لست أعرفه","قطعه الإِنسان من كبده",41,"د",2,0],["وصُغْتُ له تاجَ المديحِ ولم أَكُنْ","لأَترُكَه حتى يكونَ مُرَصَّعا",42,"ع",2,0],["وصغت للدر ضداً","وللهواء نقيضا",43,"ض",2,0],["وصغى إلى رجعِ الحمام بسجعِهِ","فأهاجَتِ البَلوى بلابِلُ صدرِهِ",44,"ر",2,0],["وصُغْتُ الرُقى إذ علّمَتْني جُفونُها","بناءَ القَوافي السّاحراتِ على الكَسْرِ",45,"ر",1,0],["وصغرت مقدار الخطايا بقدرة","يغور بصافي حلمها وغر الصدر",46,"ر",1,0],["وصُغْتَ مِنَ القَريضِ بَناتِ فِكْرٍ","دَفَعْتَ بِها الوَرَى نَحْو الوَراءِ",47,"ا",2,0],["وصُغتَه خدعةً لي منكَ يَحكي","لِجَوهَرِ ثَغرِه شطراً وشَطرا",48,"ر",2,0],["وصغت هواك للدنيا نشيدا","تراقص حالما مثل الشعاع",49,"ع",1,0],["وَصَغيرَينِ غَيرَ أَنَّ المَعالي","قَد يُمَتَّعنَ بِالصَغيرِ الصَريحِ",50,"ح",1,0],["وصغيرٍ القدّ هِمْتُ بِهِ","تَمّ فيه الحُسْنُ في الصِّغرِ",51,"ر",1,1]]}