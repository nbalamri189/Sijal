354.html","مجزوء الرجز"],[199,"كم تجنيت يا مليح النفور","https://www.aldiwan.net/poem45567.html","الخفيف"],[221,"قائم فوق شاطىء النهر","https://www.aldiwan.net/poem55276.html","المنسرح"],[223,"غلواء ما أحلى المعطارا","https://www.aldiwan.net/poem39711.html","الرجز"],[225,"أبصر الثعلب الغراب على غص","https://www.aldiwan.net/poem55143.html","الخفيف"],[225,"تبسمت عن جوهر العقد","https://www.aldiwan.net/poem55243.html","السريع"],[229,"إليك مدت رقابها العرب","https://www.aldiwan.net/poem51240.html","المنسرح"],[235,"جادك الواكف الهتن","https://www.aldiwan.net/poem31739.html","مجزوء الخفيف"],[235,"آه للبرق أضاءا","https://www.aldiwan.net/poem32197.html","مجزوء الرمل"],[259,"مذ رأيت العاصي أطعت لربي","https://www.aldiwan.net/poem35750.html","الخفيف"],[262,"أبلغا ربطة أني","https://www.aldiwan.net/poem68183.html","مجزوء الرمل"],[282,"ورد الورد سافرا عن خدود","https://www.aldiwan.net/poem32808.html","الخفيف"],[285,"قل لمن تاه دلالا وهوى","https://www.aldiwan.net/poem39393.html","الرمل"],[297,"سقيا لمثناة الحجاز وطيبها","https://www.aldiwan.net/poem33334.html","الكامل"],[310,"هل غير بابك للغريب مؤمل","https://www.aldiwan.net/poem59512.html","الكامل"],[322,"ذرفت عيني دموعا","https://www.aldiwan.net/poem56351.html","مجزوء الرمل"],[328,"كذبت هند حين قالت لك القل","https://www.aldiwan.net/poem54941.html","الخفيف"],[338,"قائد الغفلة الأمل","https://www.aldiwan.net/poem68629.html","مجزوء الخفيف"],[353,"بلغا عني ربوع الصالحيه","https://www.aldiwan.net/poem39576.html","الرمل"],[353,"أقبل الأحمق يوما","https://www.aldiwan.net/poem40206.html","مجزوء الرمل"],[364,"سيف عينيك عازم الانتضاء","https://www.aldiwan.net/poem61004.html","الوافر"],[403,"معرض عن هذه الدنيا يرى","https://www.aldiwan.net/poem33353.html","الرمل"],[403,"تحفة تهدى لمن يهوى عليا","https://www.aldiwan.net/poem33355.html","الرمل"],[403,"جاء يهدي نحوي بديع النظام","https://www.aldiwan.net/poem33414.html","الخفيف"],[403,"غصن شوق علاه قلبي وغرد","https://www.aldiwan.net/poem33977.html","الخفيف"],[416,"وقف الربع على مرتبع","https://www.aldiwan.net/poem53831.html","الرمل"],[416,"هذه الدار وهاتيك المغاني","https://www.aldiwan.net/poem54073.html","الرمل"],[432,"طار عن برقة برق فشم","https://www.aldiwan.net/poem12350.html","الرمل"],[432,"دون ما بيننا من الود يكفي","https://www.aldiwan.net/poem12384.html","الخفيف"],[432,"اجتل اللهو حمرة في بياض","https://www.aldiwan.net/poem12451.html","الخفيف"],[432,"رحلوا فالسقام عندي مقيم","https://www.aldiwan.net/poem12718.html","الخفيف"],[437,"كل يوم لي من صدودك حاله","https://www.aldiwan.net/poem2501.html","الخفيف"],[443,"نقل الطرف في ربوع الأمان","https://www.aldiwan.net/poem55974.html","عموديه"],[443,"لست أنسى عهد ليل قريب","https://www.aldiwan.net/poem56036.html","المديد"],[458,"دع ملامي باللوى أورح ودعني","https://www.aldiwan.net/poem55844.html","الرمل"],[461,"خفضا لا موت الا بأجل","https://www.aldiwan.net/poem15467.html","الرمل"],[464,"بين حزني وحسنه اليوسفي","https://www.aldiwan.net/poem3166.html","عموديه"],[464,"ألبستني جفون عينيه سقما","https://www.aldiwan.net/poem3228.html","عموديه"],[464,"ما لطيف زار منكم موهنا","https://www.aldiwan.net/poem3343.html","عموديه"],[464,"راح يستمطر الدموع الغزارا","https://www.aldiwan.net/poem3621.html","عموديه"],[558,"هي قامت بنفسها لذويها","https://www.aldiwan.net/poem33637.html","الخفيف"],[558,"نشأة الروح بالغروب الطلوع","https://www.aldiwan.net/poem34385.html","الخفيف"],[558,"إن محسوسات الحواس الظواهر","https://www.aldiwan.net/poem34517.html","الخفيف"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["قائِداً لِلقِراعِ كُلَّ حِصانٍ","تَتَراءى بِهِ عُقاباً مُطارا",0,"ر",2,0],["قائِدُ الخَيلِ تَساقى بِالرَدى","تَحتَ آسادٍ لَها النَقعُ لُبَد",1,"د",1,0],["قائِدِ الخَيلِ تَساقى","بِدَمِ الطَعنِ الصَبيبِ",2,"ب",1,0],["قائِلاً هَل مُزايِدٌ","رابِحاً ثُمَّ مَن يَزِن",3,"ن",1,0],["قَايَضَتْ كُلُّ جَارَةٍ أُخْتَهَا مَا","أَبْدَعَتْهُ فُنُونُهَا وَالعَلُومُ",4,"م",1,0],["قائد لم يَرِدْ لظى الحرب إلاّ","مصدراً رأيه لها جاسوسا",5,"س",2,0],["قائم الخصر قاعد الردف أمري","فيهِ ما بين مقعدٍ ومقيم",6,"م",1,0],["قائلاً للمشيرِ بالكدحِ مهلاً","ما اجتهادُ اللَّبيبِ بعد اكتفاءِ",7,"ا",2,0],["قائدُ جيشَيْنِ منهما لَجِبٌ","جمٌّ وَغَاهُ وصامت لَجَبُهْ",8,"ب",2,0],["قائلٌ يا منتهى أملي","نجِّني مما أخاف غدا",9,"د",2,0],["قائلاً حبذا سُرى الليل دأباً","واصطلاء الحَرُورِ ذي الإرماض",10,"ض",1,0],["قائلاً كلَّما فعلتَ وأفعا","لُك لا شكّ تغمُرُ الأقوالا",11,"ل",2,0],["قائلاً بالصوابِ يقرع فصّاً","بجواباته وينطق فصْلا",12,"ل",2,0],["قائلُ المدحِ فيك بدءاً وعوداً","غيرُ مستكرهٍ ولا محتالِ",13,"ل",1,0],["قائلُ المدحِ في عليِّ بن يحيى","غيرُ مستكرهٍ ولا محتالِ",14,"ل",1,0],["قائدُ أهل السماح كُلِّهُمُ","يعطونه في يَمينه الرُّمَما",15,"م",2,0],["قائلٌ قول ذاكرٍ خيرَ عصريْ","ه طويلِ الحنين والتهيام",16,"م",1,0],["قائلاتٍ عيلَ التصبُّرُ عنكم","فانزلوا آن أنْ نراكُمْ وحانا",17,"ن",2,0],["قائل الشعر قد يبور مصابا","بملم وشعره لا يبور",18,"ر",1,0],["قائلا ليس للغراب بروض","زهره الغض باسم اغرودي",19,"د",2,0],["قائلةً ربِّ لا تفارق","بين نبيل طفلي وبيني",20,"ي",1,0],["قائِلاً يا أَيُّها المَولى الوَزير","أَنتَ أَهلُ العَفوِ وَالبِرِّ الغَزير",21,"ر",1,0],["قائِدو كُلِّ شَطبَةٍ وَحِصانٍ","قَد بَراها الإِسراجُ وَالإِلجامُ",22,"م",1,0],["قائِدُ الخَيلِ مُستَقِلٌ عَلَيها","أَجَمُ الخَطِّ في الحَديدِ وِغابُه",23,"ب",2,0],["قائِدُ القَومِ لَيسَ بِالمُتَأَنّي","دونَ حاجاتِهِم وَلا المُتَأَرّي",24,"ي",1,0],["قائِلٌ فاعِلٌ وَلَيسَ يَكونُ ال","قَولُ مَجداً حَتّى يَكونَ الفَعالُ",25,"ل",1,0],["قائِلُها أَنتَ وَقَد أَفرَطَت","في نَتنِها أَم أَنتَ خاريها",26,"ي",3,0],["قائلٌ إنْ نُذُرُ الشَّيبِ بدَت","في عِذاريه وما تُغْني النُّذُر",27,"ر",1,0],["قائِلاً إِن عَفَوتَ قيلَ كَما قي","لَ وَما شاعَ عَنكَ في الخافِقَينِ",28,"ن",1,0],["قائلاً صَه بالله لا تسأليني","فكلانا من دونِها في عناء",29,"ا",2,0],["قائدٌ قادَهُ إلى الموْتِ عِزٌّ","باقتحامٍ كهلٍ وعزْمٍ فتيِّ",30,"ي",1,0],["قائمةٌ في مَلبَسٍ أصْفَرٍ","قد حرّكتْ منه لنا فَرْدَ كُم",31,"م",1,0],["قائدَ الخيلِ بالكماةِ سِرَاعاً","والضحى من قَتامِهنّ أصيلُ",32,"ل",1,0],["قائماً في السّلاحِ يَجمعُ حولَيْ","هِ شُبولاً تَحمِي الحِمَى وَنُمورا",33,"ر",2,0],["قائِدُ جَيشٍ جَحفَلٍ","سارَ لِقَبضِ المُهَجِ",34,"ج",1,0],["قائِمٌ في الوَهمِ حَتّى إِذاما","رُمتُهُ رُمتُ مُعَمّى المَكانِ",35,"ن",1,0],["قائدُنا قينةٌ مخنثّةٌ","بياسمينٍ غضٍ نُحييها",36,"ي",3,0],["قائِمٌ بِاللِواءِ يَدفَعُ بِالمَو","رِجالاً عَن حُرمَةِ الخُلَفاءِ",37,"ا",2,0],["قائِداً قُدّامَ حَيٍّ سَلَفوا","غَيرِ أَنكاسٍ وَلا وُغلٍ رُفُد",38,"د",1,0],["قائلاً أنت اللهُ وحدك قيو","ماً وأما الأكوان فهي تبور",39,"ر",1,0],["قائِلُها فاضلٌ وأفْضَلُ مِن","قائِلِها الألْمَعِيُّ مُنْشِدُها",40,"د",3,0],["قائلاً ناقلاً سميعاً مجيبا","حسن تبيانه كحسن الصفيّ",41,"ي",1,0],["قائلاً :هذه حدودي تخطا","ها عظامٌ إلى أمورٍ عظائِم",42,"م",1,0],["قَائِدُ الخَيلِ، مستقل عَلَيها","أسَلُ الخَطّ في الحَديدِ، وَغَابُهْ",43,"ب",2,0],["قَائل ماله أدناه مجنى ً","من الأيدي جميعاً والأماني",44,"ي",1,1],["قائلٌ فيك للعدوِّ مقالاً","فيه كبْتٌ له وإرغامُ أنف",45,"ف",1,0],["قائماً بالأذى لنا","خصمه اللَه والنبي",46,"ب",2,0],["قائِلاً لي والفَجْرُ في قَبضَةِ اللَّيْ","لِ وَجِسْمُ الدُّجى مِن الصُّبْحِ عارِ",47,"ر",1,0],["قائِمٌ في الدُجى حَليفُ صَلاةٍ","مِن سَنا وَجهِهِ عَلَيها دَليلُ",48,"ل",1,0],["قائمةً قاعدةً","جائلةً لم تجلِ",49,"ل",1,0],["قائماً في دُجَاهُ يرتقبُ الفجرَ وير","مي الدُّجى بدمعٍ غزيرِ",50,"ر",1,0],["قائم فوق شاطىء النهر","ذاهل عن حوادث الدهر",51,"ر",1,1],["قائِمَةٌ كَالطَلَل المَهجورِ","عَلى مِياهِ شاطِيءٍ في صور",52,"ر",1,0],["قائِلاً يا أميرُ عم كلَّ صُبحٍ","صائِحاً صادِحاً وكلَّ مساءِ",53,"ا",2,0],["قائِلاً طبتَ يامُغَنّى النَدامى","غَنِّ غيري قد حانَ وَقتُ غدائي",53,"ا",2,0],["قائِلَةً في شَطرِ تاريخهِ","بُشرى أَتى اِسماعيلُ يا سَعدى",54,"د",2,0],["قايَستِ العِيدَ وهي حُلْتُه","وأخفت اليومَ وهو مُنْتَصب",55,"ب",1,0],["قائِمٌ بِالفُروضِ مِن","مَذهَبِ الجودِ وَالسُنَن",56,"ن",1,0],["قائِدُ الأَبطالِ غُلباً","لا يَمَلّونَ اللِقاءا",57,"ا",3,0],["قائلاً طيبتي علقت باذيا","لِ علاها وتلك طيبي وطبّي",58,"ي",1,0],["قائِداً لي لَيلَةَ القَد","رِ كأنّي أبتَغِيها",59,"ي",3,0],["قائِلاً وَالمَقالُ يُفهَمُ عَنهُ","بِلِسانِ التَسبيحِ وَالتَمجيدِ",60,"د",1,0],["قائلا مستر