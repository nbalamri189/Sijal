3",""],[5136,"أضحك النصر مبسم العلياء","https://www.poetsgate.com/ViewPoem.aspx?id=121488",""],[5225,"مرحبا يا مطول الغيبه","https://www.poetsgate.com/ViewPoem.aspx?id=27616",""],[5277,"قميصُ قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=192064",""],[5353,"لعنة قابيل","https://www.poetsgate.com/ViewPoem.aspx?id=212463",""],[5409,"خرج العاهل للصي","https://www.poetsgate.com/ViewPoem.aspx?id=155367",""],[5409,"خرج الناس يضرعون إلى الله","https://www.poetsgate.com/ViewPoem.aspx?id=155246",""],[5431,"طاغوت....","https://www.poetsgate.com/ViewPoem.aspx?id=202911",""],[5694,"انصروا نبيكم","https://www.poetsgate.com/ViewPoem.aspx?id=129912",""],[5953,"قد أضأ بالقائم النيران","https://www.poetsgate.com/ViewPoem.aspx?id=93851",""],[5953,"إن يوم الغدير يوم السرور","https://www.poetsgate.com/ViewPoem.aspx?id=93784",""],[5956,"الذكرى الخالدة لوحدة الجمهورية العربية المتحدة","https://www.poetsgate.com/ViewPoem.aspx?id=193991",""],[5970,"ساعة يؤنسني فيها الملك","https://www.poetsgate.com/ViewPoem.aspx?id=130672",""],[6093,"فَازَ بِالشِّعْرِ ظَرِيْفْ ( مجزوء الرمل)","https://www.poetsgate.com/ViewPoem.aspx?id=180593",""],[6105,"وبروحي ظَبْي على وَجهه السد","https://www.poetsgate.com/ViewPoem.aspx?id=190385",""],[6117,"فَتَاةُ الْقُدْسِ","https://www.poetsgate.com/ViewPoem.aspx?id=182794",""],[6142,"لم يكن همه بدنياه إلا","https://www.poetsgate.com/ViewPoem.aspx?id=155695",""],[6142,"ما نشا في السما ولا ساح في الأر","https://www.poetsgate.com/ViewPoem.aspx?id=155697",""]],"verses":[["قائِداً لِلقِراعِ كُلَّ حِصانٍ","تَتَراءى بِهِ عُقاباً مُطارا",0,"ر",2,0],["قائِدُ الخَيلِ تَساقى بِالرَدى","تَحتَ آسادٍ لَها النَقعُ لُبَد",1,"د",1,0],["قائِدِ الخَيلِ تَساقى","بِدَمِ الطَعنِ الصَبيبِ",2,"ب",1,0],["قائِلاً هَل مُزايِدٌ","رابِحاً ثُمَّ مَن يَزِن",3,"ن",1,0],["قَايَضَتْ كُلُّ جَارَةٍ أُخْتَهَا مَا","أَبْدَعَتْهُ فُنُونُهَا وَالعَلُومُ",4,"م",1,0],["قائد لم يَرِدْ لظى الحرب إلاّ","مصدراً رأيه لها جاسوسا",5,"س",2,0],["قائم الخصر قاعد الردف أمري","فيهِ ما بين مقعدٍ ومقيم",6,"م",1,0],["قائلاً للمشيرِ بالكدحِ مهلاً","ما اجتهادُ اللَّبيبِ بعد اكتفاءِ",7,"ا",2,0],["قائدُ جيشَيْنِ منهما لَجِبٌ","جمٌّ وَغَاهُ وصامت لَجَبُهْ",8,"ب",2,0],["قائلٌ يا منتهى أملي","نجِّني مما أخاف غدا",9,"د",2,0],["قائلاً حبذا سُرى الليل دأباً","واصطلاء الحَرُورِ ذي الإرماض",10,"ض",1,0],["قائلاً كلَّما فعلتَ وأفعا","لُك لا شكّ تغمُرُ الأقوالا",11,"ل",2,0],["قائلاً بالصوابِ يقرع فصّاً","بجواباته وينطق فصْلا",12,"ل",2,0],["قائلُ المدحِ فيك بدءاً وعوداً","غيرُ مستكرهٍ ولا محتالِ",13,"ل",1,0],["قائلُ المدحِ في عليِّ بن يحيى","غيرُ مستكرهٍ ولا محتالِ",14,"ل",1,0],["قائدُ أهل السماح كُلِّهُمُ","يعطونه في يَمينه الرُّمَما",15,"م",2,0],["قائلٌ قول ذاكرٍ خيرَ عصريْ","ه طويلِ الحنين والتهيام",16,"م",1,0],["قائلاتٍ عيلَ التصبُّرُ عنكم","فانزلوا آن أنْ نراكُمْ وحانا",17,"ن",2,0],["قائل الشعر قد يبور مصابا","بملم وشعره لا يبور",18,"ر",1,0],["قائلا ليس للغراب بروض","زهره الغض باسم اغرودي",19,"د",2,0],["قائلةً ربِّ لا تفارق","بين نبيل طفلي وبيني",20,"ي",1,0],["قائِلاً يا أَيُّها المَولى الوَزير","أَنتَ أَهلُ العَفوِ وَالبِرِّ الغَزير",21,"ر",1,0],["قائِدو كُلِّ شَطبَةٍ وَحِصانٍ","قَد بَراها الإِسراجُ وَالإِلجامُ",22,"م",1,0],["قائِدُ الخَيلِ مُستَقِلٌ عَلَيها","أَجَمُ الخَطِّ في الحَديدِ وِغابُه",23,"ب",2,0],["قائِدُ القَومِ لَيسَ بِالمُتَأَنّي","دونَ حاجاتِهِم وَلا المُتَأَرّي",24,"ر",2,0],["قائِلٌ فاعِلٌ وَلَيسَ يَكونُ ال","قَولُ مَجداً حَتّى يَكونَ الفَعالُ",25,"ل",1,0],["قائِلُها أَنتَ وَقَد أَفرَطَت","في نَتنِها أَم أَنتَ خاريها",26,"ي",3,0],["قائلٌ إنْ نُذُرُ الشَّيبِ بدَت","في عِذاريه وما تُغْني النُّذُر",27,"ر",1,0],["قائِلاً إِن عَفَوتَ قيلَ كَما قي","لَ وَما شاعَ عَنكَ في الخافِقَينِ",28,"ن",1,0],["قائلاً صَه بالله لا تسأليني","فكلانا من دونِها في عناء",29,"ا",2,0],["قائدٌ قادَهُ إلى الموْتِ عِزٌّ","باقتحامٍ كهلٍ وعزْمٍ فتيِّ",30,"ي",1,0],["قائمةٌ في مَلبَسٍ أصْفَرٍ","قد حرّكتْ منه لنا فَرْدَ كُم",31,"م",1,0],["قائدَ الخيلِ بالكماةِ سِرَاعاً","والضحى من قَتامِهنّ أصيلُ",32,"ل",1,0],["قائماً في السّلاحِ يَجمعُ حولَيْ","هِ شُبولاً تَحمِي الحِمَى وَنُمورا",33,"ر",2,0],["قائِدُ جَيشٍ جَحفَلٍ","سارَ لِقَبضِ المُهَجِ",34,"ج",1,0],["قائِمٌ في الوَهمِ حَتّى إِذاما","رُمتُهُ رُمتُ مُعَمّى المَكانِ",35,"ن",1,0],["قائدُنا قينةٌ مخنثّةٌ","بياسمينٍ غضٍ نُحييها",36,"ي",3,0],["قائِمٌ بِاللِواءِ يَدفَعُ بِالمَو","رِجالاً عَن حُرمَةِ الخُلَفاءِ",37,"ا",2,0],["قائِداً قُدّامَ حَيٍّ سَلَفوا","غَيرِ أَنكاسٍ وَلا وُغلٍ رُفُد",38,"د",1,0],["قائلاً أنت اللهُ وحدك قيو","ماً وأما الأكوان فهي تبور",39,"ر",1,0],["قائِلُها فاضلٌ وأفْضَلُ مِن","قائِلِها الألْمَعِيُّ مُنْشِدُها",40,"د",3,0],["قائلاً ناقلاً سميعاً مجيبا","حسن تبيانه كحسن الصفيّ",41,"ي",1,0],["قائم انت على ارجائها","بملاك الأمر والحق الاغر",42,"ر",1,0],["قائلاً :هذه حدودي تخطا","ها عظامٌ إلى أمورٍ عظائِم",43,"م",1,0],["قَائِدُ الخَيلِ، مستقل عَلَيها","أسَلُ الخَطّ في الحَديدِ، وَغَابُهْ",44,"ب",2,0],["قَائل ماله أدناه مجنى ً","من الأيدي جميعاً والأماني",45,"ي",1,1],["قائلٌ فيك للعدوِّ مقالاً","فيه كبْتٌ له وإرغامُ أنف",46,"ف",1,0],["قائماً بالأذى لنا","خصمه اللَه والنبي",47,"ب",2,0],["قائِلاً لي والفَجْرُ في قَبضَةِ اللَّيْ","لِ وَجِسْمُ الدُّجى مِن الصُّبْحِ عارِ",48,"ر",1,0],["قائِمٌ في الدُجى حَليفُ صَلاةٍ","مِن سَنا وَجهِهِ عَلَيها دَليلُ",49,"ل",1,0],["قائمةً قاعدةً","جائلةً لم تجلِ",50,"ل",1,0],["قائماً في دُجَاهُ يرتقبُ الفجرَ وير","مي الدُّجى بدمعٍ غزيرِ",51,"ر",1,0],["قائم فوق شاطىء النهر","ذاهل عن حوادث الدهر",52,"ر",1,1],["قائِمَةٌ كَالطَلَل المَهجورِ","عَلى مِياهِ شاطِيءٍ في صور",53,"ر",1,0],["قائِلاً يا أميرُ عم كلَّ صُبحٍ","صائِحاً صادِحاً وكلَّ مساءِ",54,"ا",2,0],["قائِلاً طبتَ يامُغَنّى النَدامى","غَنِّ غيري قد حانَ وَقتُ غدائي",54,"ا",2,0],["قائِلَةً في شَطرِ تاريخهِ","بُشرى أَتى اِسماعيلُ يا سَعدى",55,"د",2,0],["قايَستِ العِيدَ وهي حُلْتُه","وأخفت اليومَ وهو مُنْتَصب",56,"ب",1,0],["قائِمٌ بِالفُروضِ مِن","مَذهَبِ الجودِ وَالسُنَن",57,"ن",1,0],["قائِدُ الأَبطالِ غُلباً","لا يَمَلّونَ اللِقاءا",58,"ا",3,0],["قائلاً طيبتي علقت باذيا","لِ علاها وتلك طيبي وطبّي",59,"ب",2,0],["قائِداً لي لَيلَةَ القَد","رِ كأنّي أبتَغِيها",60,"ي",3,0],["قائِلاً وَالمَقالُ يُفهَمُ عَنهُ","بِلِسانِ التَسبيحِ وَا