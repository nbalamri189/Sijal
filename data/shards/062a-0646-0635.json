{"poems":[[73,"أهاجك شوق أم سنا بارق نجدي","https://www.aldiwan.net/poem4007.html","الطويل"],[32,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[85,"أدرها ثلاثا من لحاظك واحبس","https://www.aldiwan.net/poem54280.html","الطويل"],[29,"أجد اليوم جيرتك ارتحالا","https://www.aldiwan.net/poem5947.html","الوافر"],[53,"بلاغة ابن فراس","https://www.aldiwan.net/poem64938.html","المجتث"],[72,"تنصل مما جرى واعتذر","https://www.aldiwan.net/poem42880.html","المتقارب"],[47,"يفندون وهم أدنى إلى الفند","https://www.aldiwan.net/poem63480.html","الوافر"],[82,"كفى سيفك الإسلام عادية الكفر","https://www.aldiwan.net/poem31440.html","الطويل"],[46,"سقى عهد الحمى سبل العهاد","https://www.aldiwan.net/poem30558.html","الكامل"],[76,"أطرسك أم ثغر تبسم واضح","https://www.aldiwan.net/poem12888.html","الطويل"],[107,"ربنا إنا اهتدينا","https://www.aldiwan.net/poem42083.html","مجزوء الرمل"],[107,"أنشروا الآثار واستقصوا السير","https://www.aldiwan.net/poem43071.html","الرمل"],[48,"لقد دجى الزمان فلا تدجوا","https://www.aldiwan.net/poem22246.html","الوافر"],[48,"أما والركاب وأقتابها","https://www.aldiwan.net/poem22365.html","المتقارب"],[48,"ألا هل أتى قبر الفقيرة طارق","https://www.aldiwan.net/poem23048.html","الطويل"],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[92,"ذكرى وعد بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179206",""],[47,"الحسناء","https://www.poetsgate.com/ViewPoem.aspx?id=12272",""],[125,"تنصلت للمولى على المنع والكره","https://www.aldiwan.net/poem23834.html","الطويل"],[131,"ألا تلك عرسي إذا أمعرت","https://www.aldiwan.net/poem24263.html","المتقارب"],[199,"إن الخليط أجدوا البين فانقذفوا","https://www.aldiwan.net/poem54398.html","البسيط"],[369,"أشبه دهري أبناؤه فهم","https://www.aldiwan.net/poem60655.html","المنسرح"],[385,"تباعدت عن ألفي فيا حر أشجاني","https://www.aldiwan.net/poem48777.html","الطويل"],[409,"بستان أنس به أقمنا","https://www.aldiwan.net/poem33684.html","مخلع البسيط"],[422,"تنفس عن وجد توقد جمره","https://www.aldiwan.net/poem54071.html","الطويل"],[447,"أسير الهوى قل لي فما أنت صانع","https://www.aldiwan.net/poem14332.html","الطويل"],[463,"روحها مخمسة خمائصا","https://www.aldiwan.net/poem56149.html","الرجز"],[463,"لو كنت تبلو غداة السفح أخباري","https://www.aldiwan.net/poem56179.html","البسيط"],[463,"الليل فالأرض لليث الشرى","https://www.aldiwan.net/poem56180.html","السريع"],[463,"هون في الليل عليها الغررا","https://www.aldiwan.net/poem56183.html","الرجز"],[463,"نديمي وما الناس إلا السكارى","https://www.aldiwan.net/poem56204.html","المتقارب"],[463,"حماها بأطراف الرماح حماتها","https://www.aldiwan.net/poem56261.html","الطويل"],[463,"عزفت فما أدرى الفتى كيف يرغب","https://www.aldiwan.net/poem56271.html","الطويل"],[482,"أعرفت من داء الصبابة شافيا","https://www.aldiwan.net/poem15185.html","الكامل"],[556,"شد غروض المطي مغتربا","https://www.aldiwan.net/poem48085.html","المنسرح"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122726","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77556","الرجز"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/71031","المنسرح"],[1200,"","https://poetry.dctabudhabi.ae/diwan/poem/111167","البسيط"],[1270,"","https://poetry.dctabudhabi.ae/diwan/poem/144682","الطويل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49933","البسيط"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128722","الوافر"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126194","الرجز"],[2852,"","https://poetry.dctabudhabi.ae/diwan/poem/142910","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100387","المتقارب"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62855","المتقارب"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46019","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205536","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216573","البسيط"],[3733,"","https://poetry.dctabudhabi.ae/diwan/poem/21389","الطويل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40139","الطويل"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199090","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86396","الرجز"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102748","الطويل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28679","الوافر"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66151","الكامل"],[4727,"بانت سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=208071",""],[4734,"خيل من الرشقات","https://www.poetsgate.com/ViewPoem.aspx?id=50220",""],[4750,"شدوا يا النشاما","https://www.poetsgate.com/ViewPoem.aspx?id=180431",""],[4797,"يالله يا عالم خفا كل ماكان","https://www.poetsgate.com/ViewPoem.aspx?id=180551",""],[4797,"من لابتي مّره الى جدي افطيس","https://www.poetsgate.com/ViewPoem.aspx?id=71831",""],[1012,"فتح جعلان","https://www.poetsgate.com/ViewPoem.aspx?id=124501",""],[5002,"على باب العيد..","https://www.poetsgate.com/ViewPoem.aspx?id=215097",""],[585,"ماذا الجمود وجرعاء الديار دم","https://www.poetsgate.com/ViewPoem.aspx?id=161903",""],[5213,"وهيفاء خلف الستر تبدي بوجهها","https://www.poetsgate.com/ViewPoem.aspx?id=170407",""],[5351,"على درب الحسين","https://www.poetsgate.com/ViewPoem.aspx?id=202234",""],[5397,"لا تسألن معالم الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=157918",""],[5431,"بلاغة","https://www.poetsgate.com/ViewPoem.aspx?id=182975",""],[5582,"هَلْ ما عَهِدْتُ مِنَ البَشاشَةِ عائِدُ","https://www.poetsgate.com/ViewPoem.aspx?id=186883",""],[4444,"انا المذنب الخطأ والعفو واسعٌ","https://www.poetsgate.com/ViewPoem.aspx?id=85455",""],[5725,"زرني بليلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=201274",""],[5747,"ياسعود لاترقد وانا بخاطري ضيق","https://www.poetsgate.com/ViewPoem.aspx?id=61686",""],[5758,"خيال امرأة","https://www.poetsgate.com/ViewPoem.aspx?id=200511",""],[5976,"طفلة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=34669",""],[463,"أبلغْ بها أمنية َ الطالبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59982&r=&rc=38",""],[463,"حماها بأطراف الرماحِ حماتها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59996&r=&rc=52",""]],"verses":[["تَنصلَ دَهري وَاِستَراحَت مِنَ الوَجى","قَلوصي وَنامَت مُقلَتي وَعَلا جَدي",0,"د",2,0],["تَنَصَّبَت حَولَهُ يَوماً تُراقِبُهُ","صُحرٌ سَماحيجُ في أَحشائِها قَبَبُ",1,"ب",1,0],["تنصُّ من الإشراف جيدَ غزالةٍ","وترنو من الإيجاس عن لحظ أشوسِ",2,"س",1,0],["تَنَصَّفُهُ البَرِيَّةُ وَهوَ سامٍ","وَيُمسي العالَمونَ لَهُ عِيالا",3,"ل",2,0],["تُنَصُّ كلُّ فتاةٍ","مِنهن نصّ القَلُوص",4,"ص",1,0],["تَنَصَّلَ مِمّا جَرى وَاِعتَذَر","وَأَطرَقَ مُرتَدِياً بِالخَفَر",5,"ر",1,1],["تَنَصَّبَ البَرقُ مُختالاً فَقُلتُ لَهُ","لَو جُدتَ جودَ بَني يَزدادَ لَم تَزِدِ",6,"د",1,0],["تُنَصَّلُ للأعْداءِ في الحرب بالرّدى","إذا نُصِّلَتْ هاتيكَ في السلمِ بالسِّحرِ",7,"ر",1,0],["تَنَصَّلَ رَبُّها مِن غَيرِ جُرمٍ","إِلَيكَ سِوى النَصيحَةِ وَالوِدادِ",8,"د",1,0],["تُنَصَّلُ يَومَ الرَوعِ سُمرُ القَنا بِهِ","وَتُطبَعُ مِنهُ لِلجِلادِ الصَفائِحُ",9,"ح",1,0],["تَنْصُرُ اللهَ جِهَارا","في حِمَى الهادي الأمينْ",10,"ن",1,0],["تَنصَحُ الدَهرُ وَتَهدي أَهلَهُ","وَتُري الجِنَّ أَفاعيلَ البَشَرْ",11,"ر",1,0],["تُنِصُّ إِلى تِهامَةَ مُبتَغاها","صَلاحَ وَلَيسَ في النِياتِ وَجُّ",12,"ج",1,0],["تُنَصُّ بِكُلِّ فَتىً ناسِكٍ","صَحيحِ النُهى غَيرِ مُرتابِها",13,"ب",3,0],["تَنَصَّرَ مِن بَعدِ الثَلاثينَ حِجَّةً","وَكَم لاحَ شَيبٌ قَبلَها في المَفارِقِ",14,"ق",1,0],["تنصحهم فتجتوى ديارهم","ان الكرام دارهم لا تجتوى",15,"ا",1,0],["تَنَصَّلَ منه زُوراً صانِعوهُ","كمولودٍ تحدَّرَ مِن سِفاح",16,"ح",1,0],["تَنصبّ فيها وفودُ الماءِ مُعْجِلَةً","كالخيل خارجة من حبل مجُريها",17,"ي",3,0],["تنصَّلتُ للمولى على المنع والكره","لعل الذي أهوى أنال على الوجه",18,"ه",1,1],["تَنُصُّ لِرَوعاتِهِ جيدَها","إِذا سَمِعَت مِن مُغَمٍّ جُؤارا",19,"ر",2,0],["تَنَصَّلَتها لَهُ مِن بَعدِ ما قُذِفَت","بِالعُقرِ قَذفَةَ ظَنٍّ سَلفَعٌ نَصَفُ",20,"ف",1,0],["تُنصِفُ ما دام يَظْلِمونَكَ أو","تَظْلِمُ إنْ كان يُنْصِفُونَ هُم",21,"م",1,0],["تَنصل عَن ذَنب الصُدود بِمَنطق","أَلَذَ وَأَشهى مِن سلاف وَأَلحان",22,"ن",1,0],["تنصب للاجتماع سهماً","وتبتغي للوصال رفعا",23,"ع",2,0],["تنصّل هذا الدهر من ذنبه به","فلا تعتبنّ اللَّيل والصبح عذره",24,"ر",2,0],["تنصل من الأطماع واعلم بأنها","تقطع أعناق الرجال المطامع",25,"ع",1,0],["تنصّ نحوي أعيناً شواخصا","تلفُّتَ العانةِ راعت قانصا",26,"ص",2,0],["تنصَّبوا لهجير الشمس وافترشوا","ليلَ السُّرَى بين أقتابٍ وأكوارِ",27,"ر",1,0],["تنصره الوثبةُ من أن يُرَى","مستصرِخ الخُلسةِ مستنصِرا",28,"ر",2,0],["تنصره الوثبةُ في أوانها","إذا الهوينى خانت المنتظَرا",29,"ر",2,0],["تنصَّت للريح مستفهماً","بأذْنيْن لا يحملان السِّرارا",30,"ر",2,0],["تنصَّل منها الملكُ لمّا تبيَّنتْ","لعينيه أُخْراها ومتعتقبِاتُها",31,"ت",3,0],["تَنُصّ مقاضاتين للسير تلفِظُ ال","مُحالَ وتُوعِي الحقَّ نصحاً فتوعبُ",32,"ب",1,0],["تنصاعُ مِنْ خوفِ السياطِ كأنَّما","خالتْ على أعجازهنَّ أفاعيا",33,"ي",2,0],["تَنصاعُ مثلَ النّعام جافلةً","تَترك أَقصى مُرادها كَثِبا",34,"ب",2,0],["تَنَصَّلَت وَخِضابُ اللَّيلِ قَد نَصَلا","وَقَبَّلَتهُ بِأَن يَرضَى فَما قَبِلا",35,"ل",2,1],["تَنصب فيهِ لَكُم الشراك","وَلَم يَكُن فيهِ لَكُم حِراكُ",36,"ك",1,0],["تنصِبُ أشراكها لتُهلِكَ مَنْ","يموتُ فيها قتيل أطماعِ",37,"ع",1,0],["تنصروا في الهوى وإني","لي مذهب ينتمي لجعفر",38,"ر",1,0],["تنصّرت الأشراف من عار لطمةٍ","وما كان فيها لو صبرت لها ضرر",39,"ر",1,1],["تنصيله مدٌ بما الفته","من غير تفريق اذا وضعته",40,"ه",1,0],["تَنَصُّلاً مِن كُلِّ مَا كَانَ عَقَد","وَأصلَحَ العزمَ الَّذي كانَ فَسَد",41,"د",1,0],["تنصٌ أَحسنَ من جيد الجَداية في","سِمطْين من لؤلؤ حُفاً بياقوتِ",42,"ت",1,0],["تنصل أن ينام ببطن غمد","ولم يطبق على حديه جفنه",43,"ن",2,0],["تنصرُ لا كما الذى يَنصُرُنى","مِن صاحبٍ ومُنتمٍ يحضُرُنى",44,"ن",2,0],["تنصب في الأول العالي فتملأه","وما يزيد إلى تاليه ينبثق",45,"ق",1,0],["تنصَّع خالا بخد الفتاة","لعيني فتحسبها خالها",46,"ل",3,0],["تَنُصُّ عليهِ عهودُ الملو","كِ وتُعْرَفُ أَوصافُه في السِّيَرْ",47,"ر",1,0],["تَنصاعُ أطماعُ المَساعي مِنهُما","صَرعى وَأهواءُ النُّفوسِ تَبيدُ",48,"د",1,0],["تُنصِف الأُمَّةُ الضعيفَ ولا تُن","صِفُ يومًا عظيمَها المظلُوما",49,"م",2,0],["تنصاح طرّته عن صبح غرّته","فيفضح الصبح وجه منه ضحيان",50,"ن",1,0],["تَنَصَّبَ حَتّى قَلَّصَ الظِلُّ بَعدَما","تَطاوَلَ حَتّى كادَ في الأَرضِ يَمصَحُ",51,"ح",1,0],["تَنَصَّرْتَ حيناً وَالبلاءُ مُوكل","ولابُدَّ مِن يَومٍ بِه تَتَهَوَّدُ",52,"د",1,0],["تَنَصَّرتَ أُمّاً بَل تَمجَّسْتَ والِداً","وَعَمّاً فعِرْقُ الكُفْرِ فيك مردّدُ",52,"د",1,0],["تنص على نجد وتهوي بغائر","وئيدِ الخطا أثقالهن رجال",53,"ل",1,0],["تنصلها الألحاظ في أسنة","لا تتقى بالحلق المضاعف",54,"ف",1,0],["تنص بهن البيد نصا كأنها","إذا أرقلت في السير شبه النقانق",55,"ق",1,0],["تَنَصَّلَ بَعدَ ما ظَلَما","فَعادَ لِوَصلِ ما صَرَما",56,"م",2,1],["تَنْصَبُّ لا تَلْوِي عَلَى أَحَدٍ","تُرْدِي المُشاةَ وتُرْخِصُ العُمْرا",57,"ر",2,0],["تَنَصّفُ السُبْل لا تمشي مُزوّيةً","كأنها فارس في الحرب مطلول",58,"ل",1,0],["تنصبُّ في الوجهِ الغريبِ تهدّه","وإذا الرؤوس ُ تراجعتْ تتقحّم",59,"م",1,0],["تنصا فيصل الخالد ربيع لكل محيل","لا قلّت مزاهبنا أو ناب الدهر قحّل",60,"ل",1,0],["تنصا تميم اللي لاامجاد ربان","ذخر الرفيق وعون من جاه عاني",61,"ن",2,0],["تنصا رباع امتعّبين المحاميس","مروين حد المرهفات الصقايل",62,"ل",1,0],["تنصر الله والرسول ودين","الله فيها وتقسط الميزانا",63,"ن",2,0],["تنَصَّفَ عامٌ والفصولُ تَمازَجَتْ","وغيْثُ السَّما هامٍ. ..دُعَانا يُواَكِبُهْ",64,"ب",2,0],["تنصب سحاً عليهم ما تزعزعهم","ولا تزل لهم عن موقفٍ قدم",65,"م",1,0],["تنصرت لما قيل أسما تنصرت","ولم أخش يوم الحشر حد المعاقب",66,"ب",1,0],["تنصبُ فوق ثراكَ دمعاً أحمراً","رقت لهٌ يا سيدي الأحجارُ",67,"ر",1,0],["تنصل في ضنك الحروب على العدى","بأسنة نفثت سمام صلال",68,"ل",1,0],["تنصاع بين حروفكم مطواعة","ويهيم في الق الهوى بستانها",69,"ن",3,0],["تَنْصَبُّ مِنْهُ عَلَى العُفاةِ مَواهِبٌ","وَعَلَى البُغاةِ صَواعِقٌ وَمَكائِدُ",70,"د",1,0],["تنصلت من ذنبي تنصل ضارعٍ","الى من لديه يغفر العمد والسهو",71,"و",1,0],["تنصف غيري والهوى عهدة","يهديك رب في القضا عادلُ",72,"ل",1,0],["تنصاك يازبن الرجال المطاليق","هداج تيما عزوةٍ للقبيله",73,"ل",2,0],["تَنَصَّرْتُ فِي شِرْعَةِ الحُبِّ عِشْقًا","لِأَجْلِ عُيُونٍ تُحَاكِي عُص