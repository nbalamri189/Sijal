{"poems":[[53,"عد عن دار وعن جار ظعن","https://www.aldiwan.net/poem66467.html","الرمل"],[63,"رأيتك تبري للصديق نوافذا","https://www.aldiwan.net/poem51420.html","الطويل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109278","الرمل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76082","الكامل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123934","الخفيف"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107502","الخفيف"]],"verses":[["إن مُبتاع الرضا من ربهِ","فيكُمُ بالنفس لا يخشى الغَبن",0,"ن",1,0],["أَنَمُّ بما اسْتَوْدَعْتُهُ من زُجاجَةٍ","تَرَى الشئَ فيها ظاهِراً وهو باطنُ",1,"ن",1,0],["ان مبدا العمر غالي الثمن","لا تبيعوه بلعب الاكر",2,"ر",1,0],["إِن مُبتَغٍ برَّ الأَنام بِأَسرِهم","لَكَمَن يُرَجّي النَشعَ مِن تِنِّينِ",3,"ن",1,0],["إن مبت الأوطان بالعلم يحيى","وسقام الشعوب بالعلم يبرى",4,"ر",2,0],["إِنم بعثي الشعاعَ إلى أع","ماق سجنٍ يحوي الدجى والشقاءَ",5,"ا",2,0]]}