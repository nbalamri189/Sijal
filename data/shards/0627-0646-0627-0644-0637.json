{"poems":[[55,"ما عند عينك في الخيال الزائر","https://www.aldiwan.net/poem30448.html","الكامل"],[29,"غضبت طهية أن سببت مجاشعا","https://www.aldiwan.net/poem5673.html","الكامل"],[93,"قالوا قضى موسى فقلت قد انطوى","https://www.aldiwan.net/poem8827.html","عموديه"],[93,"خذ ما استطعت من الدنيا وأحليها","https://www.aldiwan.net/poem62810.html","عموديه"],[94,"لله ما أحلى الطفولة","https://www.aldiwan.net/poem38964.html","مجزوء الرمل"],[91,"أجد الحياة من الطبيعة تنبع","https://www.aldiwan.net/poem44867.html","الكامل"],[91,"الناس طرا آمنوا بالله","https://www.aldiwan.net/poem45096.html","الكامل"],[64,"رطب تراكيبك إن","https://www.aldiwan.net/poem52205.html","مجزوء الرجز"],[47,"إن الطويل وقد قلت حلاوته","https://www.aldiwan.net/poem63462.html","البسيط"],[51,"إن الطبيب بطبه ودوائه","https://www.aldiwan.net/poem10326.html","الكامل"],[46,"أقشيب ربعهم أراك دريسا","https://www.aldiwan.net/poem30481.html","الكامل"],[107,"ناج الشهيد وحدث بعده الأثرا","https://www.aldiwan.net/poem42131.html","البسيط"],[52,"إن الطبيب بطبه ودوائه","https://www.aldiwan.net/poem64873.html","الكامل"],[48,"إن الطبيب وذا التنجيم ما فتئا","https://www.aldiwan.net/poem22862.html","البسيط"],[48,"في الوحدة الراحة العظمى فآخ بها","https://www.aldiwan.net/poem23133.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85373","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85430","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85374","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85507","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85343","المتدارك"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85335","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43817","الكامل"],[47,"إن الطويل وإن قلت حلاوته","https://www.poetsgate.com/ViewPoem.aspx?id=32875",""],[264,"أنا الله اعتصامي","https://www.aldiwan.net/poem35814.html","مجزوء الرمل"],[264,"نحمد مولانا الذي قد اصطفى","https://www.aldiwan.net/poem35821.html","الرجز"],[275,"الناس بالأعمال والأخلاق","https://www.aldiwan.net/poem34984.html","الكامل"],[275,"قبلتها فشممت وردا أحمرا","https://www.aldiwan.net/poem35242.html","الكامل"],[275,"قد أبهجتك بنورها وصباها","https://www.aldiwan.net/poem35687.html","الكامل"],[290,"زفت معارف تونس","https://www.aldiwan.net/poem39396.html","مجزوء الكامل"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[369,"حيث انتهيت من الهجران بي فقف","https://www.aldiwan.net/poem60841.html","البسيط"],[382,"قلب يوسوس في الصدور ويخنس","https://www.aldiwan.net/poem59385.html","الكامل"],[382,"إن الطبيعة يا أخي لم تعطنا","https://www.aldiwan.net/poem59434.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138342",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138302",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138312",""],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126823","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48732","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48697","الكامل"],[936,"","https://poetry.dctabudhabi.ae/diwan/poem/138719",""],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70990","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59412","الكامل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126188","الكامل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126132","الرجز"],[1319,"","https://poetry.dctabudhabi.ae/diwan/poem/128281","الرجز"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48942","الكامل"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87867","البسيط"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87940","البسيط"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71042","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27436","الكامل"],[2360,"","https://poetry.dctabudhabi.ae/diwan/poem/119162","البسيط"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106839","الكامل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129973","الكامل"],[2664,"","https://poetry.dctabudhabi.ae/diwan/poem/143095","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94316","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204861","السريع"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84472","البسيط"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26117","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89220","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89150","البسيط"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109911","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110100","الكامل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86506","الكامل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44688","البسيط"],[4105,"","https://poetry.dctabudhabi.ae/diwan/poem/97737","الكامل"],[4291,"","https://poetry.dctabudhabi.ae/diwan/poem/142466","الكامل"],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[4383,"","https://poetry.dctabudhabi.ae/diwan/poem/124110","الرجز"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147258","البسيط"],[4767,"رجب الأصب","https://www.poetsgate.com/ViewPoem.aspx?id=199714",""],[4814,"مهلا","https://www.poetsgate.com/ViewPoem.aspx?id=194449",""],[4858,"آسادٌ في الأسر","https://www.poetsgate.com/ViewPoem.aspx?id=137593",""],[4955,"يسمو الطبيب إذا ما كان ذا خلق","https://www.poetsgate.com/ViewPoem.aspx?id=197723",""],[5065,"سبحة الإنطواء","https://www.poetsgate.com/ViewPoem.aspx?id=205183",""],[5092,"بالجرحِ أكتملُ","https://www.poetsgate.com/ViewPoem.aspx?id=163044",""],[5136,"الحق أبلج واضح للمهتدي","https://www.poetsgate.com/ViewPoem.aspx?id=121802",""],[5219,"شمس الأحبة","https://www.poetsgate.com/ViewPoem.aspx?id=194905",""],[5327,"طِفلٌ عَلَى حَيْدِ الطَّريق","https://www.poetsgate.com/ViewPoem.aspx?id=156128",""],[5343,"صدى البردة","https://www.poetsgate.com/ViewPoem.aspx?id=132671",""],[5431,"طهارة...","https://www.poetsgate.com/ViewPoem.aspx?id=183005",""],[5650,"امْلأْ فُؤادَكَ بِالْحَبيب","https://www.poetsgate.com/ViewPoem.aspx?id=131222",""],[5691,"أطفال العراق","https://www.poetsgate.com/ViewPoem.aspx?id=207065",""],[5956,"لِمَ تقطعين الغاب؟","https://www.poetsgate.com/ViewPoem.aspx?id=182417",""],[5956,"هذي الطبيعة","https://www.poetsgate.com/ViewPoem.aspx?id=183285",""],[5956,"الفطرة البيضاء، والفطرة السوداء","https://www.poetsgate.com/ViewPoem.aspx?id=192038",""],[6068,"طمع الحبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=177484",""],[5309,"ألشعر عاطفة بروحك تلمع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573519",""],[243,"صحيفة الأحرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68182&r=&rc=174",""],[2220,"إن الطبيعة أعطت في عناصرها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11148&r=&rc=22",""],[2220,"لمّا رأيتُ منازلَ الجوزاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11141&r=&rc=15",""]],"verses":[["إِنَّ الطَعائِنَ يَومَ جَوِّ سُوَيقَةٍ","عاوَدنَ قَلبي عِندَ يَومِ الحاجِرِ",0,"ر",1,0],["إِنَّ الطَريقَ إِذا تَبَيَّنَ رُشدُهُ","سَلَكَت طُهَيَّةُ في الطَريقِ الأَخيَبِ",1,"ب",1,0],["إِنَّ الطُيورَ تَذودُ عَن أَوكارِها","أَتَكونُ أَعقَلَ مِنكُمُ الأَتيارُ",2,"ر",1,0],["إِنَّ الطُيورَ الدُمى سِيّانَ في نَظَري","وَالوِرقُ إِن حَبَسَت هَذي أَغانيها",3,"ي",3,0],["إنَّ الطّفولةَ تهتَزُّ","في قَلْبِ الرَّبيعْ",4,"ع",1,0],["إنَّ الطُّفولَةَ حِقْبَةً","شعريَّةٌ بشُعُورِها",4,"ه",2,0],["ان الطبيعة في جميع شؤونها","كاللَه عن اعمالها لا تهجع",5,"ع",1,0],["إن الطبيعة للورى ملموسة","واللَه مسموع من الأفواه",6,"ه",1,0],["إنّ الطبيخ كله","قوته في المرق",7,"ق",1,0],["إِنَّ الطَويلَ وَقَد قَلَّت حَلاوَتُهُ","وَراحَ غَيرِ مَليحِ الشَخصِ مَقدودِ",8,"د",1,1],["إِنَّ الطَبيبَ بِطِبِّهِ وَدَوائِهِ","لا يَستَطيعُ دِفاعَ مَكروهٍ أَتى",9,"ا",1,1],["إِنَّ الطَلاقَةَ وَالنَدى خَيرٌ لَهُم","مِن عِفَّةٍ جَمَسَت عَلَيكَ جُموسا",10,"س",2,0],["إنّ الطَواغيتَ ما يَنفكُّ باطشُها","يُلقِي على الأَرضِ من طُغيانهِ شرَرا",11,"ر",2,0],["إِنَّ الطَبيبَ بِطِبِّهِ وَدَوائِهِ","لا يَستَطيعُ دِفاعَ مَقدورٍ أَتى",12,"ا",1,1],["إِنَّ الطَبيبَ وَذا التَنجيمِ ما فَتِئا","مُشَهَّرَينِ بِتَقويمٍ وَكُنّاشِ",13,"ش",1,1],["إِنَّ الطَبائِعَ لَمّا أُلِّفَت جَلَبَت","شَرّاً تَوَلَّدَ فيهِ القيلُ وَالقالُ",14,"ل",1,0],["إِنَّ الطَريف به تلي","دٌ وَالتَليد به طَريف",15,"ف",1,0],["إِنَّ الطَبيعة لا تُسالِم أَهلها","في كل أَرض أَو بكل زَمان",16,"ن",1,0],["إن الطَبيعة مورد","للشاربين ومصدر",17,"ر",1,0],["إن الطيور إذا أوديت من أسف","تَبكي على شاعر فذ فترثيني",18,"ن",2,0],["إن الطيار سليمان","فوددت لَوَ اَني هدهده",19,"د",2,0],["إن الطَبيعة لَم تَزَل مجهولة","وَلَقَد أَحاطَ بنا لَها أَسرار",20,"ر",1,0],["إِنَّ الطَريقَة دونَ زادٍ وَعرةٌ","وَإِذا تَزَوَّدنا فَما أَوطاها",21,"ا",3,0],["إن الطويل وإن قلت حلاوته","وراح غير مليح الشخص مقدود",22,"د",1,1],["إنّ ألطاف إلهي","ليَ قالت خلّ عنكا",23,"ك",2,0],["إنّ الطريق وعِرُ المسالكِ","على غبيٍّ بالحجاب هالكِ",24,"ك",1,0],["إن الطبيعةَ للضعيفِ عدوَّةٌ","والأفضَلُ الأقوى لخيرٌ باق",25,"ق",1,0],["إنّ الطبيعةَ بالحبيبِ جميلةٌ","وأُحِبُّها إذ منهُ تحوي مَنظرا",26,"ر",2,0],["إنَّ الطّبيعَةَ في الخريفِ مراسلٌ","قامَت تجدّدُ لِلغرامِ صِباها",27,"ا",3,0],["إن الطبيعة لا ترى","إلا الظهور وإن صعب",28,"ب",1,0],["إِنَّ الطَعامَ يَقوى شَهوَةَ النَهَمِ","وَلا تَنَلها الَّذي تَهوى إِلَيهِ وَلا",29,"ل",2,0],["أنّ الطِّرازِيَّ أيضاً معْ حَقارتِه","يَمُدٌُ نحوَ معاشي كَفَّ مُخْتَطِف",30,"ف",1,0],["إن الطبيعة علَّةٌ لحياتنا","والموت فيها حاكمٌ مترئِّس",31,"س",1,0],["إن الطبيعةَ يا أخي لم تعطنا","شمسين في ذا العالم الغرَّارِ",32,"ر",1,1],["إن الطبيب هو الشريف عواطفا","أو مَن بدا منه الشعور رقيقا",33,"ق",2,0],["ان الطلاق بدون وجه لم يجد","ما بين ارباب الحصافة عاذرا",34,"ر",2,0],["ان الطلاق هو العقاب لمن بدا","لخصالنا منها السلوك مغايرا",34,"ر",2,0],["ان الطبيب هو الاله فلذ به","تبرأ من الاسقام والارجاس",35,"س",1,0],["إنّ الطبيب إذا طابت أرومتهُ","يكونُ ذا رأفة بالبائس الحالِ",36,"ل",1,0],["إن الطليق إذا اعتدى متعمّداً","لأحق بالأغلال والأصفاد",37,"د",1,0],["إن الطهور بنانه أولى بما","نوَّلت ذاك الأغلب السفّاكا",38,"ك",2,0],["إن الطبيعة قد حبتك محاسنا","والشمس قد رشفت كؤوس نداك",39,"ك",1,0],["إن الطوَى قومُه قاموا على قدمٍ","فأهلك الصبرَ مني قومُه فهَلك",40,"ك",1,0],["إن الطريق شطيطة فتزودي","لا تقلعي عن زادك لا تغفلي",41,"ل",2,0],["إن الطيور لها السفوح فسيحة","لكنما أوج السما لبزاتهِ",42,"ت",2,0],["إن الطبيب تابع للتجربة","وبائع ما معه في الأجربة",43,"ه",1,0],["إن الطريق للعيون واضحه","بينةٌ أعلامُها ولائحه",44,"ه",1,0],["إِن الطبيعة كيفما أَبصرتَها","أُحجيّةٌ عَمِيَتْ على الأَبصار",45,"ر",1,0],["ان الطيور على اجناسها وقعت","اجل فمن عالم المنكوب أَسرتُهُ",46,"ه",1,0],["إن الطبيعة تستوفي فرائضها","حسبَ الوثيقةِ بين الخلق إذ كانوا",47,"ن",3,1],["ان الطبيعة لا ترضى بشائبة","في قدرها شَأنَ إِفراط ونقصانُ",47,"ن",1,0],["ان الطبيعة لم تترك لهم ابداً","جرائم الفرط ان عزّوا وان هانوا",47,"ن",3,0],["ان الطبيعة لم تفرض على بشرٍ","امراً ينافيهِ إِحساسٌ ووجدان",47,"ن",1,0],["إِنَّ الطبيعة ذا نِهايةُ فِعِلها","ليكون منه ظُهور مَكْنُوناتِها",48,"ت",3,0],["إن الطبيعة كالعروسِ إذا انجلتْ","والبعلُ من تدريه بالإيماء",49,"ا",2,0],["إن الطرماح نالته صواعقها","في ظلمة القهر بين الهام والصرد",50,"د",1,0],["إن الطبيب اللَهُ خالقنا","وداوؤه في الخق مشتهر",51,"ر",1,0],["إن الطبائعَ إذ رأته مكمّلاً","حسدَتهُ فاجتمعت على إهلاكهِ",52,"ه",1,0],["إن الطبيعة والمزاج تشاركا","في الكون لما أوجداه سماحا",53,"ح",2,0],["إن الطعام ليس إلا فضله","فاستغن بالمقيت واغنم فضله",54,"ه",1,0],["ان الطفولات لها خمرة","هازئة بابنة عنقود",55,"د",1,0],["إن الطَعام يقوي شهوة النهم","واعزم عَلى عدم الإصرار بعد ولا",56,"ل",2,0],["إِنَّ الطَريقَ طَريقُ الوارِدينَ لَنا","يا بنَ الأَتانِ وَأَحواضِ الجِبى الكُبَرُ",57,"ر",1,0],["إن الطباع لمنك نافرة فما","يهوَى غليظ الطبع غير الموقص",58,"ص",1,0],["إن الطلا مطرٌ تزهو الرياض به","وتفسد الطرق والأعتاب بالمطر",59,"ر",1,0],["إِنَّ الطَلاقَ مَعَ العتاقِ كِلاهُما","قَسَمانِ عِند اللَهِ مَمقوتانِ",60,"ن",1,0],["إنَّ الطبيعةَ ما زالت تحاولُ ما","يَخُصُّها ولَمِا تَهوَى تُجاذِبُني",61,"ن",2,0],["إن الطريقَ الى الخلاصِ عسيرةٌ","ويَكِلُّ عن إِيضاحِ ذاكَ لِساني",62,"ن",2,0],["إن الطبابة أنزلتك مبجلاً","في صحن وجنتها مكان الخال",63,"ل",1,0],["إِن الطَبيعةَ دَرسٌ لِلعُقول وَإن","زاغَت إِلى طُرق الإِيمان تَهديها",64,"ي",3,0],["إنّ الطويّ إِذا ذَكرتُم ماءها","صَوب السحابِ عُذوبةً وصفاءَ",65,"ا",2,1],["إنَّ الطريقَ إلى الخُلودِ مُظَلَلٌ","بالصَّالحاتِ وبِالجِهادِ مُضَاءُ",66,"ا",2,0],["إنّ الطَّعامَ يُقَوِّي شَهْوَةَ النَّهِمِ","فَلا تَذَرْها عَلى ما تَشْتَهِي هَمَلا",67,"ل",2,0],["إنَّ الطَّعام كان عيش الإنسان","أهلكتني بالحبس بعد الحرمان",68,"ن",1,0],["إن الطريق إلى العرفان تعرية","عمَّا تشَّكل من إيهام من نظموا",69,"م",3,0],["إنَّ الطريقَ إلى الجِنان طويلةٌ","فلتحملوا فيها عصا الترحال",70,"ل",1,0],["إن الطلاسمَ لا تهزُّ هواجسي","فالسحرُ فيها سائغٌ وحلالُ",71,"ل",1,0],["إنّ الطّبيعةَ أنْ تظلّ أسودُنا","في ذا العرين بعزّها تتجلْببُ",72,"ب",1,0],["إنَّ الطبيبَ أمينٌ في رسالتهِ","فإن أبى فعظيمَ الذنبِ يَقترفُ",73,"ف",1,0],["إنَّ الطمأنينةَ العذراءَ وهْيَ معاً","إذ صاحبُ الصُّوْرِ طَوعاً يَنفخُ الصُّوْرَا",74,"ر",2,0],["إنّ الطغاةَ أقاموا حفلَ مقتلنا","على ترائبنا والعمُ يحتفلُ",75,"ل",1,0],["إن الطفولة لا تنافي منعه","عن ذاك خوف تساهل وتعود",76,"د",1,0],["إن الطيور متى تغادر عشها","تقض الحياة صبابة وعويلا",77,"ل",2,0],["إنَّ الطَّرِيقَ لِمَن لَدَيْهِ عَزيمَةٌ","وَشَجَاعَةٌ رَغمَ العِثارِ مُمَهَّدُ",78,"د",1,0],["إن الطعان لفينا وقعه علنا","ماض، وفينا جراح الجز والجلم",79,"م",1,0],["إنّ الطهارة شرطٌ في صلاتكم","وأبلغُ الطهْر طهْر القلبِ يبتهلُ",80,"ل",1,1],["إنّ الطّريقَ لِمنْ يَؤوبُ مُعَبّدٌ","وَدُروبُ مَنْ شَرِبَ الذّنوبَ مُبَعْثَرَهْ",81,"ر",2,0],["إنَّ الطفولة َفيها اليومَ مثْخَنَة ٌ","وليسَ يرفَعُ عنها المحْنة َالأسَفُ !",82,"ف",1,0],["إنَّ الطبيعة كلها في طبعنا","ونرى الجمال الحقَّ فيها يَخْصُبُ",83,"ب",1,0],["إنَّ الطبيعة أنسامٌ معَطّرة","هي الغذاءُ لروحِ الإنس والجَسَدِ",84,"د",1,0],["إن الطوائف كلها ستسُرُّني","هي ثروة التاريخ في متناولي",85,"ل",2,0],["إن الطباع مردها جرثومة","قد أشرعت أسفانها في مائها",86,"ا",3,0],["إِنَّ الطَّبيعَةَ بِالضِّياءِ ضَنينَةٌ","وَلَعَلَّ نورَ المُلهَمينَ تَبَرُّعُ",87,"ع",1,0],["إن الطغاة نجوم ليل ترتدي","ثوب المغيب وأنت شمس نهار",88,"ر",1,0],["إن الطبيعة أعطت في 