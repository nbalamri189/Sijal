{"poems":[[53,"ما عند عينك في الخيال الزائر","https://www.aldiwan.net/poem30448.html","الكامل"],[27,"غضبت طهية أن سببت مجاشعا","https://www.aldiwan.net/poem5673.html","الكامل"],[91,"قالوا قضى موسى فقلت قد انطوى","https://www.aldiwan.net/poem8827.html","عموديه"],[91,"خذ ما استطعت من الدنيا وأحليها","https://www.aldiwan.net/poem62810.html","عموديه"],[92,"لله ما أحلى الطفولة","https://www.aldiwan.net/poem38964.html","مجزوء الرمل"],[89,"أجد الحياة من الطبيعة تنبع","https://www.aldiwan.net/poem44867.html","الكامل"],[89,"الناس طرا آمنوا بالله","https://www.aldiwan.net/poem45096.html","الكامل"],[62,"رطب تراكيبك إن","https://www.aldiwan.net/poem52205.html","مجزوء الرجز"],[45,"إن الطويل وقد قلت حلاوته","https://www.aldiwan.net/poem63462.html","البسيط"],[49,"إن الطبيب بطبه ودوائه","https://www.aldiwan.net/poem10326.html","الكامل"],[44,"أقشيب ربعهم أراك دريسا","https://www.aldiwan.net/poem30481.html","الكامل"],[105,"ناج الشهيد وحدث بعده الأثرا","https://www.aldiwan.net/poem42131.html","البسيط"],[50,"إن الطبيب بطبه ودوائه","https://www.aldiwan.net/poem64873.html","الكامل"],[46,"إن الطبيب وذا التنجيم ما فتئا","https://www.aldiwan.net/poem22862.html","البسيط"],[46,"في الوحدة الراحة العظمى فآخ بها","https://www.aldiwan.net/poem23133.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85373","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85430","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85374","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85507","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85343","المتدارك"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85335","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43817","الكامل"],[45,"إن الطويل وإن قلت حلاوته","https://www.poetsgate.com/ViewPoem.aspx?id=32875",""],[257,"أنا الله اعتصامي","https://www.aldiwan.net/poem35814.html","مجزوء الرمل"],[257,"نحمد مولانا الذي قد اصطفى","https://www.aldiwan.net/poem35821.html","الرجز"],[268,"الناس بالأعمال والأخلاق","https://www.aldiwan.net/poem34984.html","الكامل"],[268,"قبلتها فشممت وردا أحمرا","https://www.aldiwan.net/poem35242.html","الكامل"],[268,"قد أبهجتك بنورها وصباها","https://www.aldiwan.net/poem35687.html","الكامل"],[283,"زفت معارف تونس","https://www.aldiwan.net/poem39396.html","مجزوء الكامل"],[318,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[362,"حيث انتهيت من الهجران بي فقف","https://www.aldiwan.net/poem60841.html","البسيط"],[374,"قلب يوسوس في الصدور ويخنس","https://www.aldiwan.net/poem59385.html","الكامل"],[374,"إن الطبيعة يا أخي لم تعطنا","https://www.aldiwan.net/poem59434.html","الكامل"]],"verses":[["إِنَّ الطَعائِنَ يَومَ جَوِّ سُوَيقَةٍ","عاوَدنَ قَلبي عِندَ يَومِ الحاجِرِ",0,"ر",1,0],["إِنَّ الطَريقَ إِذا تَبَيَّنَ رُشدُهُ","سَلَكَت طُهَيَّةُ في الطَريقِ الأَخيَبِ",1,"ب",1,0],["إِنَّ الطُيورَ تَذودُ عَن أَوكارِها","أَتَكونُ أَعقَلَ مِنكُمُ الأَتيارُ",2,"ر",1,0],["إِنَّ الطُيورَ الدُمى سِيّانَ في نَظَري","وَالوِرقُ إِن حَبَسَت هَذي أَغانيها",3,"ي",3,0],["إنَّ الطّفولةَ تهتَزُّ","في قَلْبِ الرَّبيعْ",4,"ع",1,0],["إنَّ الطُّفولَةَ حِقْبَةً","شعريَّةٌ بشُعُورِها",4,"ه",2,0],["ان الطبيعة في جميع شؤونها","كاللَه عن اعمالها لا تهجع",5,"ع",1,0],["إن الطبيعة للورى ملموسة","واللَه مسموع من الأفواه",6,"ه",1,0],["إنّ الطبيخ كله","قوته في المرق",7,"ق",1,0],["إِنَّ الطَويلَ وَقَد قَلَّت حَلاوَتُهُ","وَراحَ غَيرِ مَليحِ الشَخصِ مَقدودِ",8,"د",1,1],["إِنَّ الطَبيبَ بِطِبِّهِ وَدَوائِهِ","لا يَستَطيعُ دِفاعَ مَكروهٍ أَتى",9,"ا",1,1],["إِنَّ الطَلاقَةَ وَالنَدى خَيرٌ لَهُم","مِن عِفَّةٍ جَمَسَت عَلَيكَ جُموسا",10,"س",2,0],["إنّ الطَواغيتَ ما يَنفكُّ باطشُها","يُلقِي على الأَرضِ من طُغيانهِ شرَرا",11,"ر",2,0],["إِنَّ الطَبيبَ بِطِبِّهِ وَدَوائِهِ","لا يَستَطيعُ دِفاعَ مَقدورٍ أَتى",12,"ا",1,1],["إِنَّ الطَبيبَ وَذا التَنجيمِ ما فَتِئا","مُشَهَّرَينِ بِتَقويمٍ وَكُنّاشِ",13,"ش",1,1],["إِنَّ الطَبائِعَ لَمّا أُلِّفَت جَلَبَت","شَرّاً تَوَلَّدَ فيهِ القيلُ وَالقالُ",14,"ل",1,0],["إِنَّ الطَريف به تلي","دٌ وَالتَليد به طَريف",15,"ف",1,0],["إِنَّ الطَبيعة لا تُسالِم أَهلها","في كل أَرض أَو بكل زَمان",16,"ن",1,0],["إن الطَبيعة مورد","للشاربين ومصدر",17,"ر",1,0],["إن الطيور إذا أوديت من أسف","تَبكي على شاعر فذ فترثيني",18,"ن",2,0],["إن الطيار سليمان","فوددت لَوَ اَني هدهده",19,"د",2,0],["إن الطَبيعة لَم تَزَل مجهولة","وَلَقَد أَحاطَ بنا لَها أَسرار",20,"ر",1,0],["إِنَّ الطَريقَة دونَ زادٍ وَعرةٌ","وَإِذا تَزَوَّدنا فَما أَوطاها",21,"ا",3,0],["إن الطويل وإن قلت حلاوته","وراح غير مليح الشخص مقدود",22,"د",1,1],["إنّ ألطاف إلهي","ليَ قالت خلّ عنكا",23,"ك",2,0],["إنّ الطريق وعِرُ المسالكِ","على غبيٍّ بالحجاب هالكِ",24,"ك",1,0],["إن الطبيعةَ للضعيفِ عدوَّةٌ","والأفضَلُ الأقوى لخيرٌ باق",25,"ق",1,0],["إنّ الطبيعةَ بالحبيبِ جميلةٌ","وأُحِبُّها إذ منهُ تحوي مَنظرا",26,"ر",2,0],["إنَّ الطّبيعَةَ في الخريفِ مراسلٌ","قامَت تجدّدُ لِلغرامِ صِباها",27,"ا",3,0],["إن الطبيعة لا ترى","إلا الظهور وإن صعب",28,"ب",1,0],["إِنَّ الطَعامَ يَقوى شَهوَةَ النَهَمِ","وَلا تَنَلها الَّذي تَهوى إِلَيهِ وَلا",29,"ل",2,0],["أنّ الطِّرازِيَّ أيضاً معْ حَقارتِه","يَمُدٌُ نحوَ معاشي كَفَّ مُخْتَطِف",30,"ف",1,0],["إن الطبيعة علَّةٌ لحياتنا","والموت فيها حاكمٌ مترئِّس",31,"س",1,0],["إن الطبيعةَ يا أخي لم تعطنا","شمسين في ذا العالم الغرَّارِ",32,"ر",1,1]]}