om/ViewPoem.aspx?id=177864",""],[5781,"جمرةٌ في زحمة الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=204823",""],[5781,"مولودةٌ على شفاهٍ مجرّحة","https://www.poetsgate.com/ViewPoem.aspx?id=208985",""],[5784,"علليني","https://www.poetsgate.com/ViewPoem.aspx?id=189790",""],[6068,"إن المحب فؤاده أواب","https://www.poetsgate.com/ViewPoem.aspx?id=192761",""],[6090,"قل لسكرى فليحيي آنا ليرنو","https://www.poetsgate.com/ViewPoem.aspx?id=170906",""],[6102,"عذلوني","https://www.poetsgate.com/ViewPoem.aspx?id=184448",""],[4432,"ادكارا بعد ما ولى الشباب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=564221",""],[242,"عللوني بالوصل قبل الممات","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563793",""]],"verses":[["عَلِّليني يا فَوزُ بِالوَصلِ إِنّي","لا أُراني أَعيشُ إِلّا قَليلا",0,"ل",2,0],["عَلَّلتَني بِالمُنى حَتّى إِذا عَلِقَت","بِالنَفسِ لَم أُعطِ مِن أَسبابِها طَرَفا",1,"ف",2,0],["عللاني بذكر تلك الليالي","وعهود عهدتها كاللالي",2,"ل",2,1],["عَلِّلاني بِسَماعٍ وَطِلا","وَبِضَيفٍ طارِقٍ يَبغي القِرى",3,"ا",1,1],["عَلِّلي بِالكَأسِ مَن أَص","بَحَ مِنها غَيرَ صاحِ",4,"ح",1,0],["عللونا عند النوى بالعناق","وامزجوا بالوداع كأس الفراق",5,"ق",1,1],["علِّلي القلب بأرواح المنا","وعدي الصبَّ ودعي المطل",6,"ل",1,0],["عَلَّلْتُ خدَّيَّ بالدموع له","إذ فاتني أنْ يَعُلَّني ثَغَبُهْ",7,"ب",2,0],["علِّلاني عن ملمَّاتِ الذَكَرْ","وانفيا بالكأس عن قلبي الفكر",8,"ر",1,0],["عَلَّلتَ نَفسَكَ بِالمُحالِ فَأَصبَحَت","في غَمرَةٍ وَغَدَوتَ أَنتَ عَليلا",9,"ل",2,0],["عَلِّل فُؤادَكَ قَد أَبَلّ عَليلُ","وَاِغنَم حَياتَكَ فَالبَقاءُ قَليلُ",10,"ل",1,1],["علليني ولو بوعد فإني","يا سليمى لَقانعٌ بالوعود",11,"د",1,0],["عِلَلٌ لِإِتواءِ الذَخائِرِ كُلَّما","جُلِيَت عَلى مَلِكٍ أَباحَ التالِدا",12,"د",2,0],["عِلَلُ النُفوسِ قَريبَةٌ أَوطانُها","وَصَلَت فَمَلَّ وِصالَها جيرانُها",13,"ن",3,1],["عَلِّلِ النَفسَ بِالقَنوعِ وَاِلّا","طَلَبَت مِنكَ فَوقَ ما يَكفيها",14,"ه",2,0],["عِلَلُ الزَمانِ كَثيرَةٌ","فَتَوَقَّ مِن تِلكَ العِلَل",15,"ل",1,0],["عللتنا بالأماني","فشربنا ظامئينا",16,"ن",2,0],["عَلِّلِ النّفسَ بريحانٍ وراحْ","وأطِعْ ساقِيَها واعصِ اللّواح",17,"ح",1,0],["علَّلونا بوعود منكم","ربما قد علل الظمآنَ آل",18,"ل",1,0],["عِلَلُ البلادِ إذا نظرتَ كثيرةٌ","ومصائبُ الأهلينَ مخُتلفاتُ",19,"ت",1,0],["عَلِّلاني بِصَوتِ نايٍ وَعودِ","وَاِسقِياني دَمَ اِبنَةِ العُنقودِ",20,"د",1,1],["عَلِّليني بِمَوعِدٍ","وَاِمطُلي ما حَيِيتُ بِه",21,"ه",1,1],["عَلِّلاني بِها إِذا غَرَّدَ الدي","كُ وَغابَت مُوَلِّياتُ النُجومِ",22,"م",1,0],["عَلَّلتُهُ بِسِنانِ الرُمحِ مَنفَرِداً","دونَ الأَحِبَّةِ في سَوداءِ دَيجورِ",23,"ر",1,0],["عِلَلُ النِساءِ إِذا اِعتَلَلنَ كَثيرَةٌ","وَسَماحُهُنَّ مِنَ العَجيبِ العاجِبِ",24,"ب",1,0],["علِّليني يا عَبدَ أَنتِ الشِفاءُ","وَاِترُكي مايَقولُ لي الأَعداءُ",25,"ا",2,1],["علّلاني فإنّ بِيضَ الأماني","فَنِيَتْ والظّلامُ ليسَ بِفاني",26,"ن",2,1],["عَلِّلُوا روحي بأرواحِ الصَّبا","فَبِرَيّاها يعودُ الميْتُ حَي",27,"ي",1,0],["عللوه فكان أقتل شيء","ذلك الصد بعدما عللوه",28,"و",2,0],["عَلِّلانِي بِسَمَاعٍ وَطِلا وبضيفٍ طارقٍ يبغي القرى","نَغَمَاتُ الضَّيْفِ أَحْلَى عِنْدَنَا منْ ثغاءِ الشاءِ ، أو ذاتِ الرُّغا",29,"ا",1,1],["عِلَلٌ لإتْوَاءِ الذّخَائِرِ، كُلّمَا","جُلِبَتْ عَلى مَلِكٍ أبَاحَ التّالِدَا",30,"د",2,0],["علل خليلك فالفؤاد عليل","يا حادياً دمع المحب يسيل",31,"ل",1,1],["عَلَّلِ القَومَ قَليلاً","يا اِبنَ بِنتِ الفارِسِيَّه",32,"ي",2,1],["عَلَّلاني وَاِسقِياني","مِن شَرابٍ أَصبَهاني",33,"ن",2,1],["عَلِّلاني بِعاتِقاتِ الكُرومِ","وَاِسقِياني بِكَأسِ أُمِّ حَكيمِ",34,"م",1,1],["عَلّل حَشاي بِذكر ذاكَ المَنزِلِ","وَأَعِد أَحاديثَ الزَمانِ الأَوَّلِ",35,"ل",1,1],["علّلتُ نفسي فلا الآمال صادقة","وضقتُ ذرعاً وفرط الشوق أضناني",36,"ن",2,0],["علليني بالموتِ كيفَ تشائينَ","فإني على المماتِ عليلُ",37,"ل",1,0],["عللتُهُ الصِّرفَ حتى صار يسمحُ لي","بما يشحُ ويَدُنيني على رَغَب",38,"ب",1,0],["عللوها فإن قدرتم فقولوا","أنه لا إله للأكوان",39,"ن",1,0],["عَلِّلْ فؤادَكَ بالمُنى إنّ المنى","فيها لأَفئِدةِ الهُمومِ سِهامُ",40,"م",1,1],["عَلِّلاني بها فقد أَقبلَ اللَّيْ","لُ كَلَونِ الصدودِ مِنْ بعدِ وَصْل",41,"ل",1,0],["عَلِّل مُحِبَّكَ بالتَداني إِنَّهُ","إِن رامَ هَجرُكَ وَالتَجافي يَتلُفُ",42,"ف",1,0],["عَلِّلُونِي بِالْوَصْلِ قَبْلَ الْمَمَاتِ","وَبِذِكِْر أَيَّامِنَا السَّالِفَاتِ",43,"ت",1,1],["عَلِّلاَنِي بِمُطْرِبِ الأَشْعَارِ","فَلَقَدْ جَاءَنَا زَمَانُ النُّوَارِ",44,"ر",1,1],["عَلِّلُوا قَلْبَ الشَّجِي مِنْ شُرْبِهَا","مَا أُحَيْلَى الشُّرْبَ مِنْ تِلْكَ الْعُقَارْ",45,"ر",1,0],["عَلَّلت بِالتَمَنّي","قَلباً مُفردا",46,"د",2,0],["عللوا قلبي بتذكار اللقاء","وانقذوا طرفي من فيض بكائي",47,"ا",2,1],["علَّلَ النَّفسَ بآمالٍ فلم","يكُ إِلا مثلَ أحلامٍ الكري",48,"ي",1,0],["عَلِّلاني وعلِّلا صاحبيّ","وآسقياني منَ المُروّقِ ريّا",49,"ي",2,1],["عَلَّلَهُ القَلبُ بِأَن يَصحَبَهُ","بَعدَكُم حَتّى رَحَلتُم فَرَحَل",50,"ل",1,0],["عَلَّلوني عَنِ الشَآمِ بِذِكرٍ","إِنَّ قَلبي إِلَيهِ بِالأَشواقِ",51,"ق",1,0],["عَلِّلونا منكم ولو بنسيمٍ","يحملُ الشّيح عنكم والخزامى",52,"ا",1,0],["علّلاني يا خليليَّ بما","مرَّ من أيام جَمْعٍ عَلّلا",53,"ل",2,0],["عَلِّلونا بنسيمٌ منكم","عَلَّ يشفينا وإنْ كانَ عليلا",54,"ل",2,0],["علِّلونا منكُم ولو بخيالٍ","يهتدي طيفه فيطرق ليلا",55,"ل",2,0],["عَلَّلْتمونا بكتْبٍ منكُم وَرَدتْ","وربَّما نَفَعَ التعليلُ بالكُتبِ",56,"ب",1,0],["علِّلاني بعسى أو ربَّما","فعسى تغني عسى أو ربَّما",57,"م",2,0],["علِّلاني بعدها من عودها","بمرام غير مرجو الحصول",58,"ل",1,0],["علل على علل أنوء برزئها","وأظل أسخر بالشتاء الآتي",59,"ت",2,0],["علِّلوني ببقاءِ مجدِكمْ","إنما يلتمس البُرءَ العليلُ",60,"ل",1,0],["علَّلتماني به والدارُ نائيةٌ","وبالأحبَّةِ من بعدِ النوى زمنا",61,"ن",2,0],["عِلَلُ العشقِ كَثيرا","تٌ وكم أبْدَتْ سِقَامَا",62,"م",2,0],["عَلِّلونا بِذِكْرِ ساداتِ سَلْعٍ","نحنُ قومٌ نَطيبُ بالتَّعَليلِ",63,"ل",1,1],["عَلِّلوني يا رفْقَتي عن رَفيقٍ","أَنا فارَقْتُهُ وشَطَّ فَريقي",64,"ق",2,0],["عللت فيك الحزن كل تعلة","لم تنفعني شربة وطبيب",65,"ب",1,0],["عَلَّلُوا الأَنْفُس بَغْياً","بالتَّرَجِّي والتَّمَنِّي",66,"ن",2,0],["علّلونا بظاهرٍ من جميلٍ","ودعوا مضمرَ القلوبِ خَفِيّا",67,"ي",2,0],["علّلتُمُ بطُروقكمْ","ومحالكم قلباً عليلا",68,"ل",2,0],["علّلْ برفقك مَن لقيتَ من الورى","إنّ العليلَ شفاؤه تعل