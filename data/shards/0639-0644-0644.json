{"poems":[[55,"إن شمسا أبصرتها فوق سطح","https://www.aldiwan.net/poem26143.html","الخفيف"],[73,"قد نالني منك ما حسبي به وكفى","https://www.aldiwan.net/poem11897.html","البسيط"],[82,"عللاني بذكر تلك الليالي","https://www.aldiwan.net/poem29397.html","الخفيف"],[54,"عللاني بسماع وطلا","https://www.aldiwan.net/poem27664.html","الرمل"],[47,"أقبلت كالبدر تسعى","https://www.aldiwan.net/poem25331.html","مجزوء الرمل"],[72,"عللونا عند النوى بالعناق","https://www.aldiwan.net/poem19354.html","الخفيف"],[72,"زحفت بيض الظبا لما رنا","https://www.aldiwan.net/poem20619.html","الرمل"],[51,"بان شبابي فعز مطلبه وانبت بيني وبينه نسبه","https://www.aldiwan.net/poem8518.html","المنسرح"],[51,"بدل الطرف من النوم السهر","https://www.aldiwan.net/poem64041.html","الرمل"],[91,"نبئت أنك تعشق التمثيلا","https://www.aldiwan.net/poem62632.html","عموديه"],[78,"علل فؤادك قد أبل عليل","https://www.aldiwan.net/poem14041.html","الكامل"],[89,"أنتِ في هجرنا وهذا الصدود","https://www.aldiwan.net/poem44964.html","الخفيف"],[45,"من رقبة أدع الزيارة عامدا","https://www.aldiwan.net/poem63545.html","الكامل"],[45,"علل النفوس قريبة أوطانها","https://www.aldiwan.net/poem66669.html","الكامل"],[58,"فلا تصحب أخا الجهل","https://www.aldiwan.net/poem30813.html","الهزج"],[49,"لايذهبن بك الأمل","https://www.aldiwan.net/poem63077.html","مجزوء الكامل"],[97,"يا أميري أزف البين","https://www.aldiwan.net/poem24767.html","مجزوء الرمل"],[80,"طرقت والليل ممدود الجناح","https://www.aldiwan.net/poem31522.html","الرمل"],[90,"‏كل ما في الكون حب وجمال","https://www.aldiwan.net/poem26553.html","الرمل"],[105,"عندي إذا صرع الجنوب سبات","https://www.aldiwan.net/poem42095.html","الكامل"],[52,"عللاني بصوت ناي وعود","https://www.aldiwan.net/poem27076.html","الخفيف"],[52,"علليني بموعد","https://www.aldiwan.net/poem27270.html","مجزوء الخفيف"],[48,"يا خليلي من بني مخزوم","https://www.aldiwan.net/poem65102.html","الخفيف"],[50,"سبح خليلي وقل يا حسن تصوير","https://www.aldiwan.net/poem63819.html","البسيط"],[50,"خفض على عقب الزمان العاقب","https://www.aldiwan.net/poem64865.html","الكامل"],[50,"علليني يا عبد أنت الشفاء","https://www.aldiwan.net/poem64888.html","الخفيف"],[46,"عللاني فإن بيض الأماني","https://www.aldiwan.net/poem23641.html","الخفيف"],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142019","الخفيف"],[54,"عَلِّلانِي بِسَمَاعٍ وَطِلا","https://www.poetsgate.com/ViewPoem.aspx?id=13864",""],[45,"مِنْ رِقْبَةٍ، أدَعُ الزّيارَةَ عَامِدَا","https://www.poetsgate.com/ViewPoem.aspx?id=31346",""],[116,"علل خليلك فالفؤاد عليل","https://www.aldiwan.net/poem40605.html","عموديه"],[138,"علل القوم قليلا","https://www.aldiwan.net/poem67918.html","مجزوء الرمل"],[138,"عللاني واسقياني","https://www.aldiwan.net/poem67933.html","مجزوء الرمل"],[138,"عللاني بعاتقات الكروم","https://www.aldiwan.net/poem67942.html","الخفيف"],[183,"علل حشاي بذكر ذاك المنزل","https://www.aldiwan.net/poem67041.html","الكامل"],[198,"إعزف على العود يا معبودي الثاني","https://www.aldiwan.net/poem39888.html","البسيط"],[200,"سائلوه متى يفيق الذي جن","https://www.aldiwan.net/poem45613.html","الخفيف"],[213,"من لي باحوى من الآرام منتخب","https://www.aldiwan.net/poem37920.html","الطويل"],[222,"قد رأيت المحال رأي عيان","https://www.aldiwan.net/poem55292.html","الخفيف"],[230,"علل فؤادك بالمنى إن المنى","https://www.aldiwan.net/poem50814.html","الكامل"],[230,"سقياني فلست أصغي لعذل","https://www.aldiwan.net/poem50859.html","الخفيف"],[233,"لاموا على حب المليح وعنفوا","https://www.aldiwan.net/poem14727.html","الكامل"],[238,"عللوني بالوصل قبل الممات","https://www.aldiwan.net/poem18082.html","الخفيف"],[238,"عللاني بمطرب الأشعار","https://www.aldiwan.net/poem18802.html","الخفيف"],[238,"يا رعى الله ليال قد خلت","https://www.aldiwan.net/poem18804.html","الرمل"],[258,"حسب الخليع ملجا","https://www.aldiwan.net/poem2666.html","منهوك المنسرح"],[262,"عللوا قلبي بتذكار اللقاء","https://www.aldiwan.net/poem38376.html","الرمل"],[271,"ذهب الحب فما أشقى الفتى","https://www.aldiwan.net/poem35593.html","الرمل"],[307,"عللاني وعللا صاحبي","https://www.aldiwan.net/poem28.html","الخفيف"],[350,"بدت لعيني بالستور والكلل","https://www.aldiwan.net/poem15861.html","الرجز"],[367,"ليس في الأرض ما يفوق سوى الشام","https://www.aldiwan.net/poem17892.html","الخفيف"],[417,"جد في وجده بكم فعلاما","https://www.aldiwan.net/poem53970.html","الخفيف"],[417,"من معيد لي من عهد الألى","https://www.aldiwan.net/poem53974.html","الرمل"],[417,"لمن الركب وحيفا وذميلا","https://www.aldiwan.net/poem53988.html","الرمل"],[417,"أي نار بها الجوانح تصلى","https://www.aldiwan.net/poem54098.html","الخفيف"],[417,"يا ابن المخيزيم وافتنا رسائلكم","https://www.aldiwan.net/poem54118.html","البسيط"],[417,"ضحك البرق فأبكاني دما","https://www.aldiwan.net/poem54130.html","الرمل"],[417,"عد عن من لج في قال وقيل","https://www.aldiwan.net/poem54131.html","الرمل"],[454,"كاد الخريف يموت مثل مماتي","https://www.aldiwan.net/poem61246.html","الكامل"],[459,"سأَلت ظبية ما هذا النحول","https://www.aldiwan.net/poem55929.html","المتقارب"],[478,"خاطبت بعدكم الأطلال والدمنا","https://www.aldiwan.net/poem15328.html","البسيط"],[501,"أزعج الليل الندامى","https://www.aldiwan.net/poem37800.html","مجزوء الرمل"],[501,"عللونا بذكر سادات سلع","https://www.aldiwan.net/poem37824.html","الخفيف"],[501,"ما عرفت الولي إلا بدلق","https://www.aldiwan.net/poem37938.html","الخفيف"],[516,"أترى يكون الخلاص لي قريب","https://www.aldiwan.net/poem12026.html","الكامل"],[530,"رب إني مستعين","https://www.aldiwan.net/poem37115.html","مجزوء الرمل"],[552,"أيها اللائم الذي لا يمل اللوم","https://www.aldiwan.net/poem47139.html","الخفيف"],[552,"إن كان طيفك زارنا","https://www.aldiwan.net/poem47309.html","مجزوء الكامل"],[552,"يا راكبا وصل الوجيف ذميله","https://www.aldiwan.net/poem47335.html","الكامل"],[559,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"]],"verses":[["عَلِّليني يا فَوزُ بِالوَصلِ إِنّي","لا أُراني أَعيشُ إِلّا قَليلا",0,"ل",2,0],["عَلَّلتَني بِالمُنى حَتّى إِذا عَلِقَت","بِالنَفسِ لَم أُعطِ مِن أَسبابِها طَرَفا",1,"ف",2,0],["عللاني بذكر تلك الليالي","وعهود عهدتها كاللالي",2,"ل",2,1],["عَلِّلاني بِسَماعٍ وَطِلا","وَبِضَيفٍ طارِقٍ يَبغي القِرى",3,"ا",1,1],["عَلِّلي بِالكَأسِ مَن أَص","بَحَ مِنها غَيرَ صاحِ",4,"ح",1,0],["عللونا عند النوى بالعناق","وامزجوا بالوداع كأس الفراق",5,"ق",1,1],["علِّلي القلب بأرواح المنا","وعدي الصبَّ ودعي المطل",6,"ل",1,0],["عَلَّلْتُ خدَّيَّ بالدموع له","إذ فاتني أنْ يَعُلَّني ثَغَبُهْ",7,"ب",2,0],["علِّلاني عن ملمَّاتِ الذَكَرْ","وانفيا بالكأس عن قلبي الفكر",8,"ر",1,0],["عَلَّلتَ نَفسَكَ بِالمُحالِ فَأَصبَحَت","في غَمرَةٍ وَغَدَوتَ أَنتَ عَليلا",9,"ل",2,0],["عَلِّل فُؤادَكَ قَد أَبَلّ عَليلُ","وَاِغنَم حَياتَكَ فَالبَقاءُ قَليلُ",10,"ل",1,1],["علليني ولو بوعد فإني","يا سليمى لَقانعٌ بالوعود",11,"د",1,0],["عِلَلٌ لِإِتواءِ الذَخائِرِ كُلَّما","جُلِيَت عَلى مَلِكٍ أَباحَ التالِدا",12,"د",2,0],["عِلَلُ النُفوسِ قَريبَةٌ أَوطانُها","وَصَلَت فَمَلَّ وِصالَها جيرانُها",13,"ن",3,1],["عَلِّلِ النَفسَ بِالقَنوعِ وَاِلّا","طَلَبَت مِنكَ فَوقَ ما يَكفيها",14,"ه",2,0],["عِلَلُ الزَمانِ كَثيرَةٌ","فَتَوَقَّ مِن تِلكَ العِلَل",15,"ل",1,0],["عللتنا بالأماني","فشربنا ظامئينا",16,"ن",2,0],["عَلِّلِ النّفسَ بريحانٍ وراحْ","وأطِعْ ساقِيَها واعصِ اللّواح",17,"ح",1,0],["علَّلونا بوعود منكم","ربما قد علل الظمآنَ آل",18,"ل",1,0],["عِلَلُ البلادِ إذا نظرتَ كثيرةٌ","ومصائبُ الأهلينَ مخُتلفاتُ",19,"ت",1,0],["عَلِّلاني بِصَوتِ نايٍ وَعودِ","وَاِسقِياني دَمَ اِبنَةِ العُنقودِ",20,"د",1,1],["عَلِّليني بِمَوعِدٍ","وَاِمطُلي ما حَيِيتُ بِه",21,"ه",1,1],["عَلِّلاني بِها إِذا غَرَّدَ الدي","كُ وَغابَت مُوَلِّياتُ النُجومِ",22,"م",1,0],["عَلَّلتُهُ بِسِنانِ الرُمحِ مَنفَرِداً","دونَ الأَحِبَّةِ في سَوداءِ دَيجورِ",23,"ر",1,0],["عِلَلُ النِساءِ إِذا اِعتَلَلنَ كَثيرَةٌ","وَسَماحُهُنَّ مِنَ العَجيبِ العاجِبِ",24,"ب",1,0],["علِّليني يا عَبدَ أَنتِ الشِفاءُ","وَاِترُكي مايَقولُ لي الأَعداءُ",25,"ا",2,1],["علّلاني فإنّ بِيضَ الأماني","فَنِيَتْ والظّلامُ ليسَ بِفاني",26,"ن",2,1],["عَلِّلُوا روحي بأرواحِ الصَّبا","فَبِرَيّاها يعودُ الميْتُ حَي",27,"ي",1,0],["عللوه فكان أقتل شيء","ذلك الصد بعدما عللوه",28,"و",2,0],["عَلِّلانِي بِسَمَاعٍ وَطِلا وبضيفٍ طارقٍ يبغي القرى","نَغَمَاتُ الضَّيْفِ أَحْلَى عِنْدَنَا منْ ثغاءِ الشاءِ ، أو ذاتِ الرُّغا",29,"ا",1,1],["عِلَلٌ لإتْوَاءِ الذّخَائِرِ، كُلّمَا","جُلِبَتْ عَلى مَلِكٍ أبَاحَ التّالِدَا",30,"د",2,0],["علل خليلك فالفؤاد عليل","يا حادياً دمع المحب يسيل",31,"ل",1,1],["عَلَّلِ القَومَ قَليلاً","يا اِبنَ بِنتِ الفارِسِيَّه",32,"ي",2,1],["عَلَّلاني وَاِسقِياني","مِن شَرابٍ أَصبَهاني",33,"ن",2,1],["عَلِّلاني بِعاتِقاتِ الكُرومِ","وَاِسقِياني بِكَأسِ أُمِّ حَكيمِ",34,"م",1,1],["عَلّل حَشاي بِذكر ذاكَ المَنزِلِ","وَأَعِد أَحاديثَ الزَمانِ الأَوَّلِ",35,"ل",1,1],["علّلتُ نفسي فلا الآمال صادقة","وضقتُ ذرعاً وفرط الشوق أضناني",36,"ن",2,0],["علليني بالموتِ كيفَ تشائينَ","فإني على المماتِ عليلُ",37,"ل",1,0],["عللتُهُ الصِّرفَ حتى صار يسمحُ لي","بما يشحُ ويَدُنيني على رَغَب",38,"ب",1,0],["عللوها فإن قدرتم فقولوا","أنه لا إله للأكوان",39,"ن",1,0],["عَلِّلْ فؤادَكَ بالمُنى إنّ المنى","فيها لأَفئِدةِ الهُمومِ سِهامُ",40,"م",1,1],["عَلِّلاني بها فقد أَقبلَ اللَّيْ","لُ كَلَونِ الصدودِ مِنْ بعدِ وَصْل",41,"ل",1,0],["عَلِّل مُحِبَّكَ بالتَداني إِنَّهُ","إِن رامَ هَجرُكَ وَالتَجافي يَتلُفُ",42,"ف",1,0],["عَلِّلُونِي بِالْوَصْلِ قَبْلَ الْمَمَاتِ","وَبِذِكِْر أَيَّامِنَا السَّالِفَاتِ",43,"ت",1,1],["عَلِّلاَنِي بِمُطْرِبِ الأَشْعَارِ","فَلَقَدْ جَاءَنَا زَمَانُ النُّوَارِ",44,"ر",1,1],["عَلِّلُوا قَلْبَ الشَّجِي مِنْ شُرْبِهَا","مَا أُحَيْلَى الشُّرْبَ مِنْ تِلْكَ الْعُقَارْ",45,"ر",1,0],["عَلَّلت بِالتَمَنّي","قَلباً مُفردا",46,"د",2,0],["عللوا قلبي بتذكار اللقاء","وانقذوا طرفي من فيض بكائي",47,"ا",2,1],["علَّلَ النَّفسَ بآمالٍ فلم","يكُ إِلا مثلَ أحلامٍ الكري",48,"ي",1,0],["عَلِّلاني وعلِّلا صاحبيّ","وآسقياني منَ المُروّقِ ريّا",49,"ي",2,1],["عَلَّلَهُ القَلبُ بِأَن يَصحَبَهُ","بَعدَكُم حَتّى رَحَلتُم فَرَحَل",50,"ل",1,0],["عَلَّلوني عَنِ الشَآمِ بِذِكرٍ","إِنَّ قَلبي إِلَيهِ بِالأَشواقِ",51,"ق",1,0],["عَلِّلونا منكم ولو بنسيمٍ","يحملُ الشّيح عنكم والخزامى",52,"ا",1,0],["علّلاني يا خليليَّ بما","مرَّ من أيام جَمْعٍ عَلّلا",53,"ل",2,0],["عَلِّلونا بنسيمٌ منكم","عَلَّ يشفينا وإنْ كانَ عليلا",54,"ل",2,0],["علِّلونا منكُم ولو بخيالٍ","يهتدي طيفه فيطرق ليلا",55,"ل",2,0],["عَلَّلْتمونا بكتْبٍ منكُم وَرَدتْ","وربَّما نَفَعَ التعليلُ بالكُتبِ",56,"ب",1,0],["علِّلاني بعسى أو ربَّما","فعسى تغني عسى أو ربَّما",57,"م",2,0],["علِّلاني بعدها من عودها","بمرام غير مرجو الحصول",58,"ل",1,0],["علل على علل أنوء برزئها","وأظل أسخر بالشتاء الآتي",59,"ت",2,0],["علِّلوني ببقاءِ مجدِكمْ","إنما يلتمس البُرءَ العليلُ",60,"ل",1,0],["علَّلتماني به والدارُ نائيةٌ","وبالأحبَّةِ من بعدِ النوى زمنا",61,"ن",2,0],["عِلَلُ العشقِ كَثيرا","تٌ وكم أبْدَتْ سِقَامَا",62,"م",2,0],["عَلِّلونا بِذِكْرِ ساداتِ سَلْعٍ","نحنُ قومٌ نَطيبُ بالتَّعَليلِ",63,"ل",1,1],["عَلِّلوني يا رفْقَتي عن رَفيقٍ","أَنا فارَقْتُهُ وشَطَّ فَريقي",64,"ق",2,0],["عللت فيك الحزن كل تعلة","لم تنفعني شربة وطبيب",65,"ب",1,0],["عَلَّلُوا الأَنْفُس بَغْياً","بالتَّرَجِّي والتَّمَنِّي",66,"ن",2,0],["علّلونا بظاهرٍ من جميلٍ","ودعوا مضمرَ القلوبِ خَفِيّا",67,"ي",2,0],["علّلتُمُ بطُروقكمْ","ومحالكم قلباً عليلا",68,"ل",2,0],["علّلْ برفقك مَن لقيتَ من الورى","إنّ العليلَ شفاؤه تعليلُهُ",69,"ل",2,0],["عللتنا بما تشير الملاهي","فسمعنا منها ولم ندر ما هي",70,"ي",1,0]]}