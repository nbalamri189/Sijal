{"poems":[[35,"ألم تربع فتخبرك الطلول","https://www.aldiwan.net/poem39107.html","الوافر"],[35,"ألم يحزنك يوم غدت حدوج","https://www.aldiwan.net/poem39174.html","الوافر"],[10,"أهاج لك الدموع على ابن عمرو","https://www.aldiwan.net/poem21073.html","الوافر"],[93,"أطاش حلم الحليم","https://www.aldiwan.net/poem11407.html","المجتث"],[93,"نأسى إذا ودعتنا الشمس في الطفل","https://www.aldiwan.net/poem11475.html","البسيط"],[4,"ألا ذهب المحافظ والمحامي","https://www.aldiwan.net/poem21204.html","الوافر"],[72,"يتيم ابتسامك ما يقهر","https://www.aldiwan.net/poem18706.html","المتقارب"],[26,"وأشعث ماله فضلات ثول","https://www.aldiwan.net/poem24092.html","الوافر"],[85,"تحية شاعر يا ماء جكسو","https://www.aldiwan.net/poem63712.html","الوافر"],[43,"لا تحسن الوفرة حتى ترى","https://www.aldiwan.net/poem9981.html","السريع"],[62,"لمن في عراص البيد نوق مطاريب","https://www.aldiwan.net/poem52480.html","الطويل"],[81,"جرى من جفوني ما أذاب أجفاني","https://www.aldiwan.net/poem61307.html","الطويل"],[19,"صحا قلبه عن سُكره فتأملا","https://www.aldiwan.net/poem356.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85595","الطويل"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72225","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202542","الرجز"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30478","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142039","الوافر"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/8835","البسيط"],[88,"نجيت بالسد بغداداً من الغرق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19538&r=&rc=41",""],[128,"أيا عين جودى بالدموع السواجم","https://www.aldiwan.net/poem50525.html","الطويل"],[143,"إباؤك للمجد أن يبتذل","https://www.aldiwan.net/poem11800.html","المتقارب"],[186,"لعمرك ما شيء علمت مكانه","https://www.aldiwan.net/poem43344.html","الطويل"],[199,"مضى والتقى نجمين في أفق جدا","https://www.aldiwan.net/poem45160.html","الطويل"],[210,"علاك إليه ناظر السعد ناظر","https://www.aldiwan.net/poem13334.html","الطويل"],[212,"لحا الله ورقا هيجتني بشجوها","https://www.aldiwan.net/poem37909.html","الطويل"],[223,"أتجهل قدر بشر إن بشرا","https://www.aldiwan.net/poem39691.html","الوافر"],[223,"ماذا بوسع الزمن المدعي","https://www.aldiwan.net/poem39728.html","السريع"],[223,"حلمت بدنيا ليتها لا تبدد","https://www.aldiwan.net/poem41601.html","الطويل"],[259,"على فقد شهر الصوم تجري المدامع","https://www.aldiwan.net/poem35731.html","الطويل"],[270,"أصاحب لا تعذليه سلام","https://www.aldiwan.net/poem35591.html","المتقارب"],[270,"أمن عربية تشتاق دارا","https://www.aldiwan.net/poem35647.html","الوافر"],[297,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[304,"تفيض عيون بالدموع السواكب","https://www.aldiwan.net/poem16819.html","الطويل"],[305,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[361,"على فقد مثلك تبكى العيون","https://www.aldiwan.net/poem68051.html","المتقارب"],[371,"رضيت بمعصية العاتب","https://www.aldiwan.net/poem57529.html","المتقارب"],[377,"مراتب أهل الفضل خمس تجمعت","https://www.aldiwan.net/poem59262.html","الطويل"],[416,"أسير وقد جازت بنا غاية السرى","https://www.aldiwan.net/poem54176.html","البسيط"],[429,"سلا ظبية الوعساء أين يمينها","https://www.aldiwan.net/poem39912.html","الطويل"],[449,"سلام على الماضي","https://www.aldiwan.net/poem1000.html",""],[463,"أكسف من سماء ساقط أم","https://www.aldiwan.net/poem927.html",""],[504,"حلت حين ما حلت على المصايب","https://www.aldiwan.net/poem38413.html","الطويل"],[558,"هو الركبان والحادي","https://www.aldiwan.net/poem34630.html","مجزوء الوافر"],[575,"سلني بالله عن فلان","https://www.aldiwan.net/poem2845.html","مخلع البسيط"],[575,"نعم هي سعدي وهي لي قمر سعد","https://www.aldiwan.net/poem3086.html","الطويل"]],"verses":[["عَلى فيها إِذا الجَوزاءُ كانَت","مُحَلَّقَةً وَأَردَفَها رَعيلُ",0,"ل",1,0],["عَلى فُضُلِ الرَواعِ تَضَمَّنَتها","خَصِيباتُ المَعالِفِ وَالمُروجُ",1,"ج",1,0],["عَلى فَرعٍ رُزِئتِ بِهِ خُناسٌ","طَويلِ الباعِ فَيّاضٍ حَميدِ",2,"د",1,0],["عَلَى فَتىً كانَ يُرجَى","فِيهِ لِشَأْنٍ عَظِيمِ",3,"م",1,0],["عَلَى فَتًى كَانَ حُرَّ الرَّأْيِ يَعْصِمُهُ","مَا اسْطَاعَ بَحْثاً وَتَمْحِيصاً مِنْ الزَّلَل",4,"ل",1,0],["عَلى فَقدِ الحَريبِ إِذا اِعتَراها","وَعِندَ الفَضلِ في القُحَمِ العِظامِ",5,"م",1,0],["على فضلهِ خنصرُ العاقدين","ومن أجلِ ذا حلي الخنصر",6,"ر",1,0],["عَلى فَتخاءَ يَعلَمُ حَيثُ تَنجو","وَما في حَيثُ تَنجو مِن طَريقِ",7,"ق",1,0],["عَلى فُلكٍ تَسيرُ بِنا الهَوُينى","وَمِن شِعري نَديمٌ لي وَجِلسُ",8,"س",1,0],["عَلى فَتىً مُعتَقِلٍ صَعدَةً","يَعُلُّها مِن كُلِّ وافي السِبال",9,"ل",1,0],["عُلىً فوق أعناقِ النجومِ بناؤُهَا","وعند مجال الغيبِ نَصٌّ وتطنيبُ",10,"ب",1,0],["عَلَى فَقد خِلّ كَان رُوحِي وراحَتِي","وروحِي وريحَانِي ونَاظِر إنسَانِي",11,"ي",1,0],["عَلى فَخِذَيهِ مِن بُرايَةِ عودِها","شَبيهُ سَفى البُهمى إِذا ما تَفَتَّلا",12,"ل",2,0],["على فنن لدنٍ نزا وهو صائح","فهز وأحنى تحته الفنن اللدنا",13,"ن",2,0],["عَلى فتىً من بني سَعْدٍ فُجِعْتُ بِهِ","ماذا أُجنَّ بِهِ في الحُفرةِ الرَّجمِ",14,"م",1,0],["على فلسطين حمى الرايات","وحمل الخيل على الغايات",15,"ت",1,0],["على فَنَنٍ مِن أَيْكةٍ قد تَعَلَّقَتْ","بحبْلِ النَّوَى مِن قَلْبي المُتَعَلِّقِ",16,"ق",1,0],["على فلذ القلوب على دماها","مشيت وقد مشى وطنٌ وراكا",17,"ك",2,0],["عَلى فِراشٍ مِنَ الوَردِ الجَنِيِّ وَما","بَدَلتَ مِن نَفَحاتِ الوَردِ بِاللاءِ",18,"ا",2,0],["على فؤاد بنار الجهل محترق","ودَّ الفرات حياءً منك يومئذٍ",19,"ذ",1,0],["على فَقْدِ مَن زانتْ بطلعة وجهه","وآثاره اليسرى جميعُ المَعَالمِ",20,"م",1,0],["على فقد معدومِ النظيرِ من الورَى","كريمِ السجايا عادلٍ ذِي مكارمِ",20,"م",1,0],["على فقد معدوم الشمائلِ صالحٍ","سليلِ سعيدِ ابن الكرامِ الأكارِمِ",20,"م",1,0],["عُلىً فَضَّتِ الخَلقَ عَن نَهجِها","فَأَفضَت إِلى رُتبَةٍ لَم تُنَل",21,"ل",1,0],["على فيك مما ليس يعنيك شأنه","بقعل وثيق حيث ما كنت فاقفل",22,"ل",1,0],["على فضلك البرهان جاءَت بهِ السما","ففي الأرض من هذا يطيق لهُ جحدا",23,"د",2,0],["على فعله دلت شمائله كما","مكارمه دلت عليها المآثر",24,"ر",1,0],["على فَنَنِ البَانَاتِ من أيْمَن الحِمى","فَقُلْتُ لها كُفِّي فَرِفْقَاً بمُهْجَتي",25,"ت",2,0],["عَلى فَرَسٍ كَأَنَّ الجِنَّ تَعدو","بِرِجلَيها فَتَختَفِيانِ سِرحا",26,"ر",3,0],["عَلى فَمي أُنشودَةٌ لا تَني","وَنَغوَةٌ خَضراءُ في مَسمَعي",27,"ي",1,0],["عَلى فَمِهم سَفر السَماواتِ مُشرَعٌ","وَفي روحِهِم سَيفُ الجَحيمِ مُجَرَّدُ",28,"د",1,0],["على فقد شهر الصوم تجري المدامعُ","وتندبه عند الفراق الجوامعُ",29,"ع",1,1],["على فقدنا بالرجاءِ نَعيشُ","لعلَّ نجوماً وراءَ الغَمام",30,"م",1,0],["على فَقرٍ وضُعفٍ حارَبَتهُ","فأنزل في كتائِبها البوارا",31,"ر",2,0],["على فلاة قفرِ","من الأَنام صفرِ",32,"ر",1,0],["على فرص كانت لو آنى انتهزتها","فقد نلت فيها من شريف المطالب",33,"ب",1,0],["على فعل بغير توجه","ومن غير إخلاص وقلب مراق",33,"ق",1,0],["عَلى فَضلِكم يثني العلى خنصر الثنا","وينهي إليكم بالموحّدة الرجبا",34,"ب",2,0],["عَلى فَقد مِثلَكَ تَبكى العُيون","وَتَجفو لَذيذ المَنامِ الجُفون",35,"ن",1,1],["على فتيةٍ يظلمونَ الزما","نَ ولا يَنزلونَ على واجبِ",36,"ب",1,0],["على فقدهم تبكي الأنامُ وغيرُهم","إلى حيثُ ألقَت رَحلَها أمُّ قَشعَم",37,"م",1,0],["على فطرة الإسلام شبت وشيَّبت","مفارقهم سود الخطوب فتابوا",38,"ب",3,0],["على فلك الآداب أشرق فضله","علوماً كأفنان الريا من فنونها",39,"ن",3,0],["على فطرة الله السنية نهجهم","وما اتخذوا من دون ذلك مذهبا",40,"ب",2,0],["على فرح بمقدمهم اليهم","فهم لهم الوصائف والوصيف",41,"ف",1,0],["على فاقدي في العشق بالضعف والبكا","وجودي واعدامي معا متناسب",42,"ب",1,0],["على فرض وتقدير","تراءت برق إيجاد",43,"د",1,0],["على فؤادِي به ضمانٌ","فإِنَّه دائمُ الضَّمانَهْ",44,"ن",2,0],["على فَمِها خالٌ من النَّدِّ سَاكِنٌ","وما كُلُّ خالٍ من مَساكِنه الخَدُّ",45,"د",1,0]]}