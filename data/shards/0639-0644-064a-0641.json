com/ViewPoem.aspx?id=49424",""],[4859,"مرحى@","https://www.poetsgate.com/ViewPoem.aspx?id=213582",""],[4869,"المليون والبيرق","https://www.poetsgate.com/ViewPoem.aspx?id=151620",""],[4884,"حنانيكِ ياسمراء","https://www.poetsgate.com/ViewPoem.aspx?id=210388",""],[4984,"حسن إختيار أو انهيار","https://www.poetsgate.com/ViewPoem.aspx?id=191329",""],[5003,"سقى الله ربعا لم يزل متيمما","https://www.poetsgate.com/ViewPoem.aspx?id=120393",""],[5033,"أنا باختصار","https://www.poetsgate.com/ViewPoem.aspx?id=182757",""],[5092,"حروفٌ من كتاب الطيش","https://www.poetsgate.com/ViewPoem.aspx?id=176485",""],[5111,"مَرَاكِبُ العشْقِ","https://www.poetsgate.com/ViewPoem.aspx?id=212250",""],[5111,"عَلَى شَفَتِي سُقْرَاطَ","https://www.poetsgate.com/ViewPoem.aspx?id=212269",""],[592,"تجانف هذا المارق الماذق الأشقى","https://www.poetsgate.com/ViewPoem.aspx?id=128797",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5376,".أُبادله بكل هوى وألقى.إلى ولدي الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=188452",""],[5389,"هارون الأمة","https://www.poetsgate.com/ViewPoem.aspx?id=206085",""],[5431,"ماآلف الله أرواحا ليوجعها","https://www.poetsgate.com/ViewPoem.aspx?id=187991",""],[5518,"سلاماً على المختار/إسماعيل الصيّاح","https://www.poetsgate.com/ViewPoem.aspx?id=197226",""],[5690,"قم ودع الغرب أن الشرق ناداكا","https://www.poetsgate.com/ViewPoem.aspx?id=172169",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5956,"تسجيل وتصوير ليلة دخلة عريس","https://www.poetsgate.com/ViewPoem.aspx?id=182669",""],[5977,"ودعتهم","https://www.poetsgate.com/ViewPoem.aspx?id=212715",""],[6056,"الظبي يفرس أسدها","https://www.poetsgate.com/ViewPoem.aspx?id=130507",""],[6342,"رذيلة الطيبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85939&r=&rc=24",""]],"verses":[["عَلى فيها إِذا الجَوزاءُ كانَت","مُحَلَّقَةً وَأَردَفَها رَعيلُ",0,"ل",1,0],["عَلى فُضُلِ الرَواعِ تَضَمَّنَتها","خَصِيباتُ المَعالِفِ وَالمُروجُ",1,"ج",1,0],["عَلى فَرعٍ رُزِئتِ بِهِ خُناسٌ","طَويلِ الباعِ فَيّاضٍ حَميدِ",2,"د",1,0],["عَلَى فَتىً كانَ يُرجَى","فِيهِ لِشَأْنٍ عَظِيمِ",3,"م",1,0],["عَلَى فَتًى كَانَ حُرَّ الرَّأْيِ يَعْصِمُهُ","مَا اسْطَاعَ بَحْثاً وَتَمْحِيصاً مِنْ الزَّلَل",4,"ل",1,0],["عَلى فَقدِ الحَريبِ إِذا اِعتَراها","وَعِندَ الفَضلِ في القُحَمِ العِظامِ",5,"م",1,0],["على فضلهِ خنصرُ العاقدين","ومن أجلِ ذا حلي الخنصر",6,"ر",1,0],["عَلى فَتخاءَ يَعلَمُ حَيثُ تَنجو","وَما في حَيثُ تَنجو مِن طَريقِ",7,"ق",1,0],["عَلى فُلكٍ تَسيرُ بِنا الهَوُينى","وَمِن شِعري نَديمٌ لي وَجِلسُ",8,"س",1,0],["عَلى فَتىً مُعتَقِلٍ صَعدَةً","يَعُلُّها مِن كُلِّ وافي السِبال",9,"ل",1,0],["عُلىً فوق أعناقِ النجومِ بناؤُهَا","وعند مجال الغيبِ نَصٌّ وتطنيبُ",10,"ب",1,0],["عَلَى فَقد خِلّ كَان رُوحِي وراحَتِي","وروحِي وريحَانِي ونَاظِر إنسَانِي",11,"ن",2,0],["عَلى فَخِذَيهِ مِن بُرايَةِ عودِها","شَبيهُ سَفى البُهمى إِذا ما تَفَتَّلا",12,"ل",2,0],["على فنن لدنٍ نزا وهو صائح","فهز وأحنى تحته الفنن اللدنا",13,"ن",2,0],["عَلى فتىً من بني سَعْدٍ فُجِعْتُ بِهِ","ماذا أُجنَّ بِهِ في الحُفرةِ الرَّجمِ",14,"م",1,0],["على فلسطين حمى الرايات","وحمل الخيل على الغايات",15,"ت",1,0],["على فَنَنٍ مِن أَيْكةٍ قد تَعَلَّقَتْ","بحبْلِ النَّوَى مِن قَلْبي المُتَعَلِّقِ",16,"ق",1,0],["على فلذ القلوب على دماها","مشيت وقد مشى وطنٌ وراكا",17,"ك",2,0],["عَلى فِراشٍ مِنَ الوَردِ الجَنِيِّ وَما","بَدَلتَ مِن نَفَحاتِ الوَردِ بِاللاءِ",18,"ا",2,0],["على فؤاد بنار الجهل محترق","ودَّ الفرات حياءً منك يومئذٍ",19,"ذ",1,0],["على فَقْدِ مَن زانتْ بطلعة وجهه","وآثاره اليسرى جميعُ المَعَالمِ",20,"م",1,0],["على فقد معدومِ النظيرِ من الورَى","كريمِ السجايا عادلٍ ذِي مكارمِ",20,"م",1,0],["على فقد معدوم الشمائلِ صالحٍ","سليلِ سعيدِ ابن الكرامِ الأكارِمِ",20,"م",1,0],["عُلىً فَضَّتِ الخَلقَ عَن نَهجِها","فَأَفضَت إِلى رُتبَةٍ لَم تُنَل",21,"ل",1,0],["على فيك مما ليس يعنيك شأنه","بقعل وثيق حيث ما كنت فاقفل",22,"ل",1,0],["على فضلك البرهان جاءَت بهِ السما","ففي الأرض من هذا يطيق لهُ جحدا",23,"د",2,0],["على فعله دلت شمائله كما","مكارمه دلت عليها المآثر",24,"ر",1,0],["على فَنَنِ البَانَاتِ من أيْمَن الحِمى","فَقُلْتُ لها كُفِّي فَرِفْقَاً بمُهْجَتي",25,"ت",2,0],["عَلى فَرَسٍ كَأَنَّ الجِنَّ تَعدو","بِرِجلَيها فَتَختَفِيانِ سِرحا",26,"ر",3,0],["عَلى فَمي أُنشودَةٌ لا تَني","وَنَغوَةٌ خَضراءُ في مَسمَعي",27,"ع",2,0],["عَلى فَمِهم سَفر السَماواتِ مُشرَعٌ","وَفي روحِهِم سَيفُ الجَحيمِ مُجَرَّدُ",28,"د",1,0],["على فقد شهر الصوم تجري المدامعُ","وتندبه عند الفراق الجوامعُ",29,"ع",1,1],["على فقدنا بالرجاءِ نَعيشُ","لعلَّ نجوماً وراءَ الغَمام",30,"م",1,0],["على فَقرٍ وضُعفٍ حارَبَتهُ","فأنزل في كتائِبها البوارا",31,"ر",2,0],["على فلاة قفرِ","من الأَنام صفرِ",32,"ر",1,0],["على فرص كانت لو آنى انتهزتها","فقد نلت فيها من شريف المطالب",33,"ب",1,0],["على فعل بغير توجه","ومن غير إخلاص وقلب مراق",33,"ق",1,0],["عَلى فَضلِكم يثني العلى خنصر الثنا","وينهي إليكم بالموحّدة الرجبا",34,"ب",2,0],["عَلى فَقد مِثلَكَ تَبكى العُيون","وَتَجفو لَذيذ المَنامِ الجُفون",35,"ن",1,1],["على فتيةٍ يظلمونَ الزما","نَ ولا يَنزلونَ على واجبِ",36,"ب",1,0],["على فقدهم تبكي الأنامُ وغيرُهم","إلى حيثُ ألقَت رَحلَها أمُّ قَشعَم",37,"م",1,0],["على فطرة الإسلام شبت وشيَّبت","مفارقهم سود الخطوب فتابوا",38,"ب",3,0],["على فلك الآداب أشرق فضله","علوماً كأفنان الريا من فنونها",39,"ن",3,0],["على فطرة الله السنية نهجهم","وما اتخذوا من دون ذلك مذهبا",40,"ب",2,0],["على فرح بمقدمهم اليهم","فهم لهم الوصائف والوصيف",41,"ف",1,0],["على فاقدي في العشق بالضعف والبكا","وجودي واعدامي معا متناسب",42,"ب",1,0],["على فرض وتقدير","تراءت برق إيجاد",43,"د",1,0],["على فؤادِي به ضمانٌ","فإِنَّه دائمُ الضَّمانَهْ",44,"ن",2,0],["على فَمِها خالٌ من النَّدِّ سَاكِنٌ","وما كُلُّ خالٍ من مَساكِنه الخَدُّ",45,"د",1,0],["على فمِ أحمدَ يُوحي إليهِ","كلاماً بَليغاً ووَحياً خفيّا",46,"ي",2,0],["على فمِ أحمدَ يُوحي إليكَ","وأهلُ الضغائنِ مُسْتَشْرِفوكا",47,"ك",2,0],["عَلى فَتح بَيت كاد لَولاك بابه","يُغلِّقُه يَأس عَنيد مُراقب",48,"ب",1,0],["عَلى فَضلِهِ كُلُّ الأَفاضِلِ أَجمَعوا","وَمِنهُم بِدونِ الخلفِ تَمَّ التّوافقُ",49,"ق",1,0],["عَلى فَتى الدُنيا وَصِنديدِها","وَفارِسِ الدينِ وَسَيفِ الإِمام",50,"م",1,0],["على فضي ماء ذهبته","بروق الغيم بكرة يوم رامِ",51,"م",1,0],["على فاطمي راح يلتف برده","على ذات قدس ليس يلفى مثيلها",52,"ل",3,0],["علي في السجية وهو طفل","فصار اسماً له قبل الفطام",53,"م",1,0],["على فتحه باب التواصل واللقا","بمفتاح حظ بالسوابق مسعود",54,"د",1,0],["على فوق العلى حتى تعالى","وحاز مراتب الشرف الأصيل",55,"ل",1,0],["عَلَيَّ فِي ظِلِّ نَعيمٍ وَغِنَى","وَغازَلَتنِي رَأدَةٌ سَيفانَةٌ",56,"ه",1,0],["على فَقْد وِلْفٍ مِسْتِخِصّه من الملا","كما اختصّ «يعقوبٍ» «بيوسف» مِ الاولادِ",57,"د",1,0],["عَلى فَتّانَةَ العَينَينِ","وَالخَدَّينِ وَالثَغرِ",58,"ر",1,0],["عَلِيٌّ في النسِاءِ لَهُ وَصِيٌّ","أمِينٌ لَمْ يُمانِعْ بالحِجابِ",59,"ب",1,0],["عَليُّ في مِهادِ المَوْتِ عارٍ","وأحْمَدُ مُكْتَسٍ غابَ اغْتِرابِ",59,"ب",1,0],["على فرط أتواقي على عظم لوعَتي","على طول أشواقي على سوء إقبالي",60,"ل",2,0],["على فقد شيخ يرثى لحالنا","فذلك خطب صرفه متعاقب",61,"ب",1,0],["على فقد شيخ الدين فلنبك كلنا","ومدمعنا في الخد كالمزن ساكب",61,"ب",1,0],["على فقد فتح الله أفضل من غدت","مناقبه تزهو بهن المناقب",61,"ب",1,0],["على فقد من شد الرحال لفضله","وسار اليه أعجم وأعارب",61,"ب",1,0],["على فقد رب السر والبر والتقى","مواهب مامن بعدهن مواهب",61,"ب",1,0],["على فقد شمس العلم بدر هداية","ومن نوره للبدر والشمس غالب",61,"ب",1,0],["على فقد من في كل علم له يد","وسبق بنور الله والله واهب",61,"ب",1,0],["عَلى فاجِحٍ هَدَّ العَشيرَةَ فَقدُهُ","بِهِ أَعلَنَ الناعي الحَديثَ المُجَمجَما",62,"م",2,1],["على فعلهِ هذا الجميل حمدتهُ","ومن يحسن الأفعال يستوجب الحمدا",63,"د",2,0],["على فقده فَلْيَبْكِ درسٌ ودارسٌ","بِدَمْعٍ على وجه الطّروس مُذَالِ",64,"ل",1,0],["عليٌ فيه قَدْ بَاهَا الآلهُ","جميعُ الأنبياءُ من ارتَضَاه",65,"ه",1,1],["علي فأما الولاية وال","حكومة في النشأتين فلك",66,"ك",1,1],["عَلى فُتن القَفقاس شُعثاً كَأَنَّها","بِمَفرقِها حينَ اِستَدارت قَلانس",67,"س",1,0],["عَلى فَردِ عَامٍ فاصطفَاها نَوَادِراً","ونَظَّمَهَا كالدرِّ فوقَ العَصايِبِ",68,"ب",1,0],["علَى فِقَرِ الظَّهرِ حَقًّا فاعلمِ","مُستقبلينَ الكلُّ بيرَ زمزمِ",69,"م",1,0],["على فَرسَانَ النَّسرُ ثمَّ ذراعُهُ","ثمانٍ يَشِفُّ الربعَ فوقَ الجزيرةِ",70,"ه",1,0],["على فرس بغل بعير ومرة","له عز مأواه ركوب على الحمر",71,"ر",1,0],["على فقده تبكى الدروس دروسها","فقد أبصرت من بعده القاع صفصفا",72,"ف",2,0],["على فتى أروع من هاشم","مثل الحسام المرهف الباتر",73,"ر",1,0],["عليّ فنون الشعر أتقن صنعها","وطبعك يا ديوان شعري على الله",74,"ه",1,0],["على فقده تبكي الدروس لدرسها","وتنعي محاريب التقى والمساجد",75,"د",1,0],["على فراق تَقِيٍّ كان يُؤنِسُني","أخي وَفاءٍ معي في كُلِّ مِضمارِ",76,"ر",1,0],["على فراقِ حبيبٍ كان يَألَفُني","بالعِلمِ والفَهمش في وِردي وإِصدارِي",76,"ر",2,0],["عَلى فراقكَ ما لي قطُّ مُصطَبَرُ","وَفي بعادكَ طال الغمُّ والكَدَرُ",77,"ر",1,1],["على فتاة ألِفتُها فغدَتْ","عنّي عند الوِصال محتجبهْ",78,"ب",2,0],["عَلى فائِت مِنّي ارجي اِرتِجاعُهُ","سَخِرتُ قَديماً بِالغَرامِ وَاِهلِهِ",79,"ه",1,0],["علي فأما الولاية وال","علوم بها الله قد فضلك",80,"ك",1,0],["على فخر سوريَّا السلامُ فإنها","غدا فخرُها في جملة الوفيات",81,"ت",1,0],["على فمه من الألحان سحر","عميق في معانيه عجيب",82,"ب",1,0],["على فسح العقيق على الروابي","على عُصب الأحبة في حماها",83,"ا",3,0],["على فيصل بحر الندى والمكارم","بكينا بدمعٍ مثل صوب الغمائم",84,"م",1,1],["عَلى فَرَجٍ أَبدى فَأَحيا اِنتِشارُهُ","عُلى سُرحاً جَلّا مُنيرا مَقامُهُ",85,"م",2,0],["على فقد من قادت إلى القلب قرحةً","بسيف لحاظ للنزال تجردا",86,"د",2,0],["على فيها إذا ما اللَّيلُ ناءَتْ","كلا كله وغوَّرَتِ النجومُ",87,"م",1,0],["عليّ فرض مدى عمرى محبتهم","ففي محبّتهم سعدٌ وإثراء",88,"ا",2,0],["على فلان ووجَدت في الحزَن","وجدا وقد وجَدت ماضل إذن",89,"ن",1,0],["على فراش العرس قد مات الفتى","وقلب والديه حزناً فتتا",90,"ت",2,0],["عَلى فِريامَ قد سُقتُ السَّرايا","تُجَرِّعُ آلهُ المَوتَ الزُّؤَاما",91,"م",2,0],["علي فخلت ذيفوباً","إلي مسارعاً جهرا",92,"ر",2,0],["عَلى فَضل لَكُم كَالبحرِ طامِ","فوق المَجرة كَي تَحظى برفعتِهِ",93,"ه",1,0],["عَلى فاجِعٍ هَدَّ العَشيرَةَ فَقدُهُ","كَرورٍ إِذا ما ف