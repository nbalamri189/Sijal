{"poems":[[79,"فتحت سعودك كل باب مبهم","https://www.aldiwan.net/poem36122.html","الكامل"],[29,"لقد نادى أميرك بابتكار","https://www.aldiwan.net/poem5777.html","الوافر"],[93,"ليس يدري الهم غير المبتلي","https://www.aldiwan.net/poem9064.html","عموديه"],[93,"غلط القائل إنا خالدون","https://www.aldiwan.net/poem62825.html","عموديه"],[91,"لهفي على شيخ العروبة احمد","https://www.aldiwan.net/poem44636.html","الكامل"],[51,"نهنه دموعك كل حي فان","https://www.aldiwan.net/poem63122.html","الكامل"],[77,"هل كان ضمخ بالعبير الريحا","https://www.aldiwan.net/poem69095.html","الكامل"],[48,"نعشى عن الأمر حتى يعلو ابن ردى","https://www.aldiwan.net/poem23222.html","البسيط"],[96,"من كسعد ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66301&r=&rc=19",""],[132,"وقلت له لقياك خير علالة","https://www.aldiwan.net/poem50574.html","الطويل"],[240,"أيا عضد الدين يا من غدا","https://www.aldiwan.net/poem31612.html","المتقارب"],[287,"نعشت قوما وكانوا قبل قد دثروا","https://www.aldiwan.net/poem32293.html","البسيط"],[287,"أي ركن وهى من العلماء","https://www.aldiwan.net/poem32295.html","الخفيف"],[466,"أأهجع أم آوي إلى لين مرقد","https://www.aldiwan.net/poem15111.html","الطويل"],[520,"يا مطلق العبرات وهي غزار","https://www.aldiwan.net/poem12104.html","الكامل"],[543,"قدك يا جميل","https://www.aldiwan.net/poem47914.html","عموديه"],[563,"نزل الذي هو عن سواه لفي غنى","https://www.aldiwan.net/poem33535.html","الكامل"],[563,"كلنا بالتخصيص والتعميم","https://www.aldiwan.net/poem33852.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122658","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122566","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122799","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122651","المتقارب"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63858","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62532","الرمل"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93137","البسيط"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21666","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79999","السريع"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102111","السريع"],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84535","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87320","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2840,"","https://poetry.dctabudhabi.ae/diwan/poem/101887","البسيط"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127395","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100817","الكامل"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104341","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62832","المتقارب"],[3589,"","https://poetry.dctabudhabi.ae/diwan/poem/34906","الوافر"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131241",""],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125868","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54410","البسيط"],[4991,"صوت البلابل","https://www.poetsgate.com/ViewPoem.aspx?id=190131",""],[5055,"حسابي للنجوم","https://www.poetsgate.com/ViewPoem.aspx?id=103545",""],[5145,"أرأيت من حملوه للتدفين","https://www.poetsgate.com/ViewPoem.aspx?id=108068",""],[5273,"نفاق","https://www.poetsgate.com/ViewPoem.aspx?id=181011",""],[5273,"رياء","https://www.poetsgate.com/ViewPoem.aspx?id=186925",""],[5493,"معراج الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=203377",""],[186,"دع عنك ذكر المنحنى وزرود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55750&r=&rc=13",""]],"verses":[["نَعَشَ الْجَزِيرَةَ بَعْدَ شَدِّ وَثَاقِهَا","وَأَجَارَ مَنْ حَفَّتْ بِهِ مِنْ مُسْلِمِ",0,"م",1,0],["نُعَشّيها الغَبوقَ عَلى بَنينا","وَنُطعِمُها المُحيلَ عَلى الصَغارِ",1,"ر",1,0],["نَعشَقُ الشَمسَ وَنَخشى حَرَّها","ما صَعِدنا وَهيَ لَمّا تَنزِلِ",2,"ل",1,0],["نَعشَقُ البُقيا لِأَنّا زائِلون","وَالأَماني حَيَّةٌ في كُلِّ حَي",3,"ي",1,0],["نعش تشيعه الى دار البلى","امم تعج فياله من مشهد",4,"د",1,0],["نَعشاً يُكَفكِفُهُ الرِجالُ وَفَوقَهُ","جَسَدٌ يُباعُ بِأَوكَسِ الأَثمانِ",5,"ن",1,0],["نَعَشَ الجُدودَ فلو يُصافحُ هالكاً","ما وَسّدَتهُ يدُ المَنونِ ضَريحا",6,"ح",2,0],["نَعشى عَنِ الأَمرِ حَتّى يَعلو اِبنُ رَدىً","نَعشاً تَبارَكَ رَبُّ العالَمِ العالي",7,"ل",2,1],["نعشق القدّ للعوالي وأحببنا","لهنديّة الصوارم هندا",8,"د",2,0],["نعشْ في ذُرى العليا وحيداً موحداً","فريداً ولم يهتفْ بربعك هاتِفُ",9,"ف",1,0],["نَعَشتَ رَفيقي فَغادَرتَهُ","غَنِيّاً وَغادَرَتني عائِلا",10,"ل",2,0],["نَعَشت قَوماً وَكانوا قَبلُ قَد دَثَروا","لَولا عُلاكَ فَطابَ الوِردُ وَالصَدرُ",11,"ر",1,1],["نَعَشَ اللَهُ نَعشَهُ وَسَقاهُ","رَحمَةً بِالغَمامَةِ الوَطفاءِ",12,"ا",2,0],["نعشتُ بزوراء العراق فَضيلةً","سرى ذكرها ما بين غورٍ وأنْجُدِ",13,"د",1,0],["نعش الجدود العاثرات مشيع","عميت برؤية نعشه الأبصار",14,"ر",1,0],["نَعشي وذاكَ الرَّجُلُ","قَد حَلَّ لي أكفَانِي",15,"ي",1,0],["نعشو إلى النار التي غسق الدجى","من طور سينا القلب قد ظهرت لنا",16,"ن",2,0],["نعشقُ الأوجهَ الحسانَ فنفنى","في تجلِّي جمال كل وسيم",17,"م",1,0],["نَعشتُم بِضَبعي والخُطُوبُ طَريقُها","إليَّ ولي قالِ السَّلامَةِ مَهيَع",18,"ع",1,0],["نَعَشَت نهضةُ الأمير بظبعي","مستميحا من قبلِ أن يُستماحا",19,"ح",2,0],["نَعَشَ المَسيحُ بِضَبعِهِ لِعِنايَةٍ","سَبَقَت فَأَخَّرَها القَضاءُ لِحينِ",20,"ن",1,0],["نعشتَ بضَبع أمرىءٍ هاضه","تَغافُل سادَتِه فانتَعَش",21,"ش",1,0],["نَعِشْ من دهرِنا عيشاً كريماً","فإِن متنا نَمُتْ موتاً عزيزا",22,"ز",2,0],["نُعِشت فينا عقولٌ للهُدى","وجسوم فيه تشكو النًّبا",23,"ب",2,0],["نعشٌ حوى من رسول الله مهجته","ومن عليٍ ولي الله عنوانا",24,"ن",2,0],["نَعَشوا مَفاقِرَهُ فَأَصبَحَ كافِراً","حَسَنَ البَلاءِ وَلَم يَكُن نَعّاشا",25,"ش",2,0],["نعشٌ أتى يُحمل فيه الهنا","ميتاً عليه يندب السؤدد",26,"د",1,0],["نعشَق له ونترك الكاذبين","صلوا عليه",27,"ل",3,0],["نعشوا نواحي أَضلعي بنزولهم","فهمو لها كالروح للأَبدانِ",28,"ن",1,0],["نَعشُ آصبَعٍ قد أرَّخوهُ العُلَمَا","ولا سوى هذا يرونَ فافهَما",29,"م",2,0],["نَعشُ أَحَد عَشَر وَهِي وَمِيزي","في قُطبِ سُهَيلِ يَا عَزِيزِي",30,"ي",1,0],["نعش ابن جعفر حمالون تحمله","فأين عنه سرايا آل عدنان",31,"ن",1,0],["نعش يخف به الجلا","ل نعم به ملك كريم",32,"م",1,0],["نعش تروّيه العيون بمائها","أسفا وتسقيه الدموع سجالا",33,"ل",2,0],["نعش حوى من رسول اللَه بهجته","ومن علي ولي اللَه عنوانا",34,"ن",2,0],["نَعَشْتَ من العسرِ حتى حسب","تُ كفّكَ تُودِعُ كفّي اليَسارا",35,"ر",2,0],["نَعَشتُ بِهِ أَزِمَّةَ طاوِيات","نَواجٍ لا تَبينُ عَلى اِكتِنانِ",36,"ن",1,0],["نعش أيامي الحي تذرف حوله","دمعاً وتلثم عوده الايتام",37,"م",1,0],["نَعْش تَداولُهُ الأكفُّ","يكادُ يطفو في الدموع",38,"ع",1,0],["نعشَ الحق بعدَ طولِ عثارٍ","جَبَرَ الحق بعدَ وَهْنٍ وكسرِ",39,"ر",1,0],["نعشتَ فضلي بإفضالٍ حَلَلْتَ به","من عَقدهِ ما لواهُ الحظُّ أو عَقَصا",40,"ص",2,0],["نعشق بعض بجنون حيل وغباوه","ان قالت شلونك شعلت الشموعي",41,"ع",2,0],["نعشق الدنيا وهي دايم ظلوم","عيشتٍ فيها الأماني تجمعه !",42,"ع",2,0],["نعشاً ولكنّ الرجال بناته","تبعوه بالدعوات والتأمين",43,"ن",1,0],["نَعْشُ السّنين على الدّقائقِ يُحْمَلُ","ودمُوعُنا دورَ الحَزينِ تُمَثِّلُ",44,"ل",1,1],["نَعْشُ السّنينِ على الدّقائقِ يُحْمَلُ","والأمسُ يَنْعَى ذِكْرَهُ المُسْتَقْبَلُ",45,"ل",1,1],["نعش على نعش يراهم نشوةً","ونراهمو أحياء في البسماتِ",46,"ت",1,0],["نعشت بشائره المنى فتهلك","قبل اللقاء بوفده الموعود",47,"د",1,0]]}