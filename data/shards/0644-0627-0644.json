","مجزوء الرجز"],[406,"أرى منك وجه الصد لا يتغير","https://www.aldiwan.net/poem50160.html","الطويل"],[416,"لآل المصطفى علم وجود","https://www.aldiwan.net/poem54092.html","الوافر"],[429,"جمالك ليس يمنعه قناع","https://www.aldiwan.net/poem40059.html","الوافر"],[429,"ألا حيي بكاسك واستنيري","https://www.aldiwan.net/poem41439.html","الوافر"],[432,"نزلوا فادعوا نزال نزال","https://www.aldiwan.net/poem12343.html","الخفيف"],[432,"قرنت بواو الصدغ صاد المقبل","https://www.aldiwan.net/poem12695.html","الطويل"],[441,"أبا ساحباً ذيل البطالة والصبا","https://www.aldiwan.net/poem14400.html","الطويل"],[441,"دع الزفرات صاعدة طوامي","https://www.aldiwan.net/poem14481.html","الوافر"],[443,"إن كان بعض الشعر غير سديد","https://www.aldiwan.net/poem55916.html","عموديه"],[443,"يا جنان الشام يا ذات البها","https://www.aldiwan.net/poem56030.html","عموديه"],[452,"وياسمين حبانا طيب منظره","https://www.aldiwan.net/poem13788.html","البسيط"],[458,"لا لنوازي كبد هاجها","https://www.aldiwan.net/poem56080.html","السريع"],[458,"جاء بها والخير مجلوب","https://www.aldiwan.net/poem56277.html","السريع"],[464,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[464,"وبروحي من وجهه شفقي اللون","https://www.aldiwan.net/poem3257.html","عموديه"],[464,"جهلاً نظرت برامتين","https://www.aldiwan.net/poem3478.html","عموديه"],[464,"نسيم الصبا مثلي يصح ويسقم","https://www.aldiwan.net/poem3496.html","عموديه"],[470,"شأتك المنازل بالأبرق","https://www.aldiwan.net/poem4773.html","المتقارب"],[479,"لا الترك ترضى بما أجرت حكومتها","https://www.aldiwan.net/poem37042.html","البسيط"],[482,"أدر المدامة يا نديم إلى الصباح","https://www.aldiwan.net/poem24333.html","عموديه"],[495,"ألم تر أني في نهضتي","https://www.aldiwan.net/poem9857.html","المتقارب"],[495,"أنعت جهما لم أجد فيما مضى","https://www.aldiwan.net/poem10223.html","الرجز"],[495,"وفتية كنجوم الليل مسعدة","https://www.aldiwan.net/poem10247.html","البسيط"],[500,"أسكرت أهل الوحا خمرتنا","https://www.aldiwan.net/poem37672.html","الرمل"],[506,"رأى الحزن ما عندي من الحزن والكرب","https://www.aldiwan.net/poem2470.html","الطويل"],[538,"دعنى من ذكر حداة الأينق","https://www.aldiwan.net/poem47549.html","عموديه"],[551,"لي من رضابك ما يغني عن الراح","https://www.aldiwan.net/poem47891.html","البسيط"],[562,"هوى في القلب يعذب وهو داء","https://www.aldiwan.net/poem52983.html","الوافر"],[563,"تخافقت البروق على الغميم","https://www.aldiwan.net/poem13599.html","الوافر"],[563,"حمدنا الله ذا العرش المجيد","https://www.aldiwan.net/poem13602.html","الوافر"],[572,"لآل هند بجنبي نفنف دار","https://www.aldiwan.net/poem2054.html","البسيط"],[575,"بكيتك بالعين التي أنت أختها","https://www.aldiwan.net/poem2787.html","الطويل"]],"verses":[["لا لِلَوائِمِ إِقصارٌ بِلائِمَةٍ","عَنِ العَميدِ وَلا لِلقَلبِ سُلوانُ",0,"ن",1,0],["لَأُلزِمن إِن لَم يُغَيِّبَكَ الرَجَم","لِهزِمَتَيكَ عاقِراً مِنَ اللُجُم",1,"م",1,0],["لا لَومَ لِلدَهرِ وَلا عِتابا","تَغابَ إِنَّ الجَلدَ مَن تَغابى",2,"ب",2,1],["لا لَقاكِ الخَطبُ إِلّا","رامِياً غَيرَ مُصيبِ",3,"ب",1,0],["لآلِئاً في التِّبرِ مَغروسَةً","تَستَوقِفُ العَينَ بِلألائِها",4,"ا",3,0],["لَأّلْبَسَنَّ اليَوْمَ حِرْباؤهُ","مِنْ شَمْسِهِ تَحتَ شَآبِيبِ",5,"ب",1,0],["لا لَومَ أَن غَضِبَت عَلَيكَ فَإِنَّها","سَمِعَت لَعَمرُكَ أَعظَمَ البُهتانِ",6,"ن",1,1],["لا لَومَ أَن يَقِفَ الحَبيبُ بِمَنهَلٍ","يَرجو السَبيلَ إِلى الوُرودِ وَيَحذَرُ",7,"ر",1,0],["لا لا وَلا مِثلي المُرَقِّشُ إِذ هَوي","أَسماءَ لِلحَينِ المُحَتَّمِ وَالقَضا",8,"ا",1,0],["لا لدُنْيا جَنَحْتُ آلَغُ فيها","لا لِدينٍ خلَصْتُ لا لصَلاحِ",9,"ح",1,0],["لَآلِئٌ خَلفَ بَلّورٍ قَدِ اِتَسَقَت","في بَيتِ دُهقانَ تَستَهوي نُهى الغيدِ",10,"د",1,0],["لِآلِ عَلِيٍّ زينَةُ المُلكِ وِجهَتي","وَإِن قيلَ شيعِيٌّ فَقَد نِلتُ أَوطاري",11,"ي",1,0],["لَأَلَمَّ بي ما لَو أَلَمَّ بِشاهِقٍ","لَانهالَ جانِبُهُ فَصارَ كَثيبا",12,"ب",2,0],["لا لَهوُ أَيّامِهِ الخالي بِمُرتَجِعٍ","وَلا نَعيمُ لَياليهِ بِمُنتَظَرِ",13,"ر",1,0],["لَأَلفَيتَني بِالوُدِّ بَعدَكَ دائِماً","عَلى عَهدِنا إِذا نَحنُ لَم نَتَفَرَّقِ",14,"ق",1,0],["لا لعمري إني كثير باخوا","ني وما موسر له رأسمالي",15,"ي",1,0],["لآل غريب كل الثناء","وليس على فضلهم بالغريب",16,"ب",1,0],["ل الحسناء","فريدة النساء",17,"ا",2,0],["لا لا فما تبغينه من خطر","أبغي كتاباً حافلاً بالصور",18,"ر",1,0],["لا لاَ وَيَأْبَى العَدْلُ ذَاكَ مَثُوبَةً","لِمُخَلِّفٍ ذِمَماً عَلَى الأَوْطَانِ",19,"ن",1,0],["لا لَعمْرِي لا نَجْحَدَنَّ المَنَايَا","مِنَّةً تَنْتَهِي لَدَيْهَا الْهُمُومُ",20,"م",1,0],["لا لِعِيٍّ وَإِنَّمَا الْقَوْلُ فِي رُزْ","ءٍ كَهَذَا لِصَاِمتاتِ الْكثلُومِ",21,"م",1,0],["لِآلِ رَسولِ اللَهِ بِالخَيفِ مِن مِنىً","وَبِالرُكنِ وَالتَعريفِ وَالجَمَراتِ",22,"ت",1,0],["لَأَلقاكِ قَد أَدأَبتُ وَالقَومُ كُلُّما","جَرَت حَذو أَخفافِ المَطايا ظِلالُها",23,"ل",3,0],["لآلٍ بها تبأى الملوك نفاسة","وجلَّت لعمري أن تكون لآليا",24,"ي",2,0],["لا لأني أراه فيها ملوماً","بل لأني أعيب فعل الساسة",25,"س",2,0],["لا لَومَ إِذ لَجَّ في مَنعٍ أَقارِبُها","إِنَّ الفُؤادَ مَعَ الشَيءِ الَّذي مَنَعوا",26,"ع",3,0],["لآلي من نُبُلات الصوا","ر وكُحل المدامع لا تكتحِل",27,"ل",1,1],["لا لخمس هي المنيخة بالار","ض في حيث تتكي الجلب",28,"ب",1,0],["لآلي السلك في نسب نظيم","ودعنا من أنابيب الرّماح",29,"ح",1,0],["لا لينك اليومَ أرجو","ولستُ أرهبُ شدَّك",30,"ك",1,0],["لآلٍ في سلوكٍ قد جلاها","بنانك أم معانٍ في سطور",31,"ر",1,1],["لا لذَّة اليسر في حماكُم","نلت ولا لذَّة التشكِّي",32,"ي",1,0],["لا لَعَمرُ الإله لكن تعاشي","تَ بصيراً في ليلةٍ قَمراءِ",33,"ا",2,0],["لا لأجلِ المديح بل خيفة الهج","وأخَذْنا جوائزَ الخلفاءِ",34,"ا",2,0],["لا لَعَمْري وكيف ذاك وقبل ال","متْحِ روَّيْتَني بسَجْلٍ رغيبِ",35,"ب",1,0],["لألْقَى أبا عِيسى العلاء بنَ صَاعِدٍ","أَجَلَّ فتىً يُسْمَى إليه ويُوفَدُ",36,"د",1,0],["لألاؤه وَمَضاؤه","وغناؤه في كل مشهدْ",37,"د",1,0],["لآل وهبٍ مِننٌ جَمّةٌ","من يَرَها من حاسدٍ يُبلس",38,"س",1,0],["لا لعمري وامتعضْ من خطةٍ","مثلكَ استنكفَ منِها وامتعض",39,"ض",1,0],["لا لعمرُ الألى نفوكَ وقالوا","قحطبيٌّ مُدَلَّسٌ ما أشطّوا",40,"ط",3,0],["لا لثمَ ثغرٍ ولا محاورةً","يحلَى بها من هواه قد عبدكْ",41,"ك",1,0],["لا لذَّةُ الفاتِكِ مَوْجُودةٌ","عندي ولا لي سلوةُ الناسِكِ",42,"ك",1,0],["لا لعُجب قدّرتُ ذاك ولكن","ني أرجّي بحسن رأيك ذاكا",43,"ك",2,0],["لا لعِرضي من هجاءٍ","صاغَه فاسدُ فكرِك",44,"ك",1,0],["لا لَعمري لا سيّما صنوُ مجدٍ","فيه ما فيك من حميدِ الخصالِ",45,"ل",1,0],["لا لعمري ما للخضاب لذي الأبْ","صارِ إلا التكذيبُ والتأثيمُ",46,"م",1,0],["لا لقُربَى ولادةٍ جمعتكم","أينَ لا أين يَلتقي النَسَبان",47,"ن",1,0],["لا لا أخافُكَ إن عدلَكَ مَأْمني","مما أخاف وضامنٌ تحصيني",48,"ن",2,0],["لَأَلجَأَتني قُرَيشٌ خائِفاً وَجِلاً","وَمَوَّلَتني قُرَيشٌ بَعدَ إِقتارِ",49,"ر",1,0],["لا لا فَإِن سَكَتَ الكَنا","رُ فَلَم يَزَل ذاكَ الكَنار",50,"ر",1,0],["لا لَهفَةَ النَفسِ عَلى غابَةٍ","كُنتُ وَهِنداً نَلتَقي فيها",51,"ي",3,1],["لا لا وَحَقِّ اللَهِ ما","عَوَّدتَني هَذا التَجَنّي",52,"ن",2,0],["لا لا وَحَقِّ اللَهِ ما","أَنا بِالسَميعِ وَلا المُطيعِ",53,"ع",1,0],["لِآل عيسى مِن نَدى راحَتِهِ","وَآل مُوسى قَبَسٌ وَمُنتَشى",54,"ا",1,0],["لِأَلقى اِبنَ إِسحاقَ الَّذي دَقَّ فَهمُهُ","فَأَبدَعَ حَتّى جَلَّ عَن دِقَّةِ الفَهمِ",55,"م",1,0],["لا لون فيه وكله","لون إذا نظر الأريب",56,"ب",1,0],["لا لذّةٌ في سَمَاعٍ","ولا هوىً في شرابِ",57,"ب",1,0],["لا لُمتُ نَفسِيَ في هَوا","كَ وَلا اِنحَرَفتُ لِطولِ صَدِّك",58,"ك",1,0],["لِآلِ حُمَيدٍ مَذهَبٌ فِيَّ لَم أَكُن","لِأَذهَبَهُ فيهِم وَلَو جَدَعوا أَنفي",59,"ي",1,0],["لا لِصَبرٍ هَجَرتُكُم عَلِمَ اللَ","هُ وَلَكِن لِشِدَّةِ الإِشفاقِ",60,"ق",1,1],["لِأَلقاكَ وَاللاقيكَ يَعلَمُ أَنَّهُ","سَيَملَأُ كَفَّي ساعِدَيهِ ثَوابُها",61,"ب",3,0],["لِآلِ أَبي العاصي تُراثُ مَشورَةٍ","لِسُلطانِهِم في الحَقِّ أَلّا يُغَيَّرا",62,"ر",2,0],["لِآلِ المُعَلّى قُبَّةٌ يَبتَنونَها","بِأَيدي كِرامٍ رَفَّعوها بِعَرعَرِ",63,"ر",1,0],["لَأَلفَيتَ فيهِم مُطعِماً وَمُطاعِناً","وَراءَكَ شَزراً بِالوَشيجِ المُقَوَّمِ",64,"م",1,0],["لَأَلقاكَ إِنّي إِن لَقيتُكَ سالِماً","فَتِلكَ الَّتي أُنهى إِلَيها الأَمانِيا",65,"ي",2,0],["لِآلِ أَسماءَ إِذ هامَ الفُؤادُ بِها","حيناً وَإِذ هِيَ لَم تَظعَن وَلَم تَبِنِ",66,"ن",1,0],["لا لَقَّبَتني المَعالي بِاِبنِ بَجدَتِها","يَومَ الفَخارِ وَلا بَرَّ التُقى قَسَمي",67,"م",2,0],["لَاِلتَقَينا قَبولَها بِقَبولٍ","وَشُفينا مِنها وَلَو بِالس