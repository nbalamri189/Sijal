له يا ريح الصبا","https://www.aldiwan.net/poem34157.html","مجزوء الرجز"],[407,"أرى منك وجه الصد لا يتغير","https://www.aldiwan.net/poem50160.html","الطويل"],[417,"لآل المصطفى علم وجود","https://www.aldiwan.net/poem54092.html","الوافر"],[430,"جمالك ليس يمنعه قناع","https://www.aldiwan.net/poem40059.html","الوافر"],[430,"ألا حيي بكاسك واستنيري","https://www.aldiwan.net/poem41439.html","الوافر"],[433,"نزلوا فادعوا نزال نزال","https://www.aldiwan.net/poem12343.html","الخفيف"],[433,"قرنت بواو الصدغ صاد المقبل","https://www.aldiwan.net/poem12695.html","الطويل"],[442,"أبا ساحباً ذيل البطالة والصبا","https://www.aldiwan.net/poem14400.html","الطويل"],[442,"دع الزفرات صاعدة طوامي","https://www.aldiwan.net/poem14481.html","الوافر"],[444,"إن كان بعض الشعر غير سديد","https://www.aldiwan.net/poem55916.html","عموديه"],[444,"يا جنان الشام يا ذات البها","https://www.aldiwan.net/poem56030.html","عموديه"],[453,"وياسمين حبانا طيب منظره","https://www.aldiwan.net/poem13788.html","البسيط"],[459,"لا لنوازي كبد هاجها","https://www.aldiwan.net/poem56080.html","السريع"],[459,"جاء بها والخير مجلوب","https://www.aldiwan.net/poem56277.html","السريع"],[465,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[465,"وبروحي من وجهه شفقي اللون","https://www.aldiwan.net/poem3257.html","عموديه"],[465,"جهلاً نظرت برامتين","https://www.aldiwan.net/poem3478.html","عموديه"],[465,"نسيم الصبا مثلي يصح ويسقم","https://www.aldiwan.net/poem3496.html","عموديه"],[471,"شأتك المنازل بالأبرق","https://www.aldiwan.net/poem4773.html","المتقارب"],[480,"لا الترك ترضى بما أجرت حكومتها","https://www.aldiwan.net/poem37042.html","البسيط"],[483,"أدر المدامة يا نديم إلى الصباح","https://www.aldiwan.net/poem24333.html","عموديه"],[496,"ألم تر أني في نهضتي","https://www.aldiwan.net/poem9857.html","المتقارب"],[496,"أنعت جهما لم أجد فيما مضى","https://www.aldiwan.net/poem10223.html","الرجز"],[496,"وفتية كنجوم الليل مسعدة","https://www.aldiwan.net/poem10247.html","البسيط"],[501,"أسكرت أهل الوحا خمرتنا","https://www.aldiwan.net/poem37672.html","الرمل"],[507,"رأى الحزن ما عندي من الحزن والكرب","https://www.aldiwan.net/poem2470.html","الطويل"],[539,"دعنى من ذكر حداة الأينق","https://www.aldiwan.net/poem47549.html","عموديه"],[552,"لي من رضابك ما يغني عن الراح","https://www.aldiwan.net/poem47891.html","البسيط"],[563,"هوى في القلب يعذب وهو داء","https://www.aldiwan.net/poem52983.html","الوافر"],[564,"تخافقت البروق على الغميم","https://www.aldiwan.net/poem13599.html","الوافر"],[564,"حمدنا الله ذا العرش المجيد","https://www.aldiwan.net/poem13602.html","الوافر"],[573,"لآل هند بجنبي نفنف دار","https://www.aldiwan.net/poem2054.html","البسيط"],[576,"بكيتك بالعين التي أنت أختها","https://www.aldiwan.net/poem2787.html","الطويل"]],"verses":[["لآل رسول الله فيها مضاجعٌ","ومن محكم التزيل عنها موارد",0,"د",1,0],["لا لِلَوائِمِ إِقصارٌ بِلائِمَةٍ","عَنِ العَميدِ وَلا لِلقَلبِ سُلوانُ",1,"ن",1,0],["لَأُلزِمن إِن لَم يُغَيِّبَكَ الرَجَم","لِهزِمَتَيكَ عاقِراً مِنَ اللُجُم",2,"م",1,0],["لا لَومَ لِلدَهرِ وَلا عِتابا","تَغابَ إِنَّ الجَلدَ مَن تَغابى",3,"ب",2,1],["لا لَقاكِ الخَطبُ إِلّا","رامِياً غَيرَ مُصيبِ",4,"ب",1,0],["لآلِئاً في التِّبرِ مَغروسَةً","تَستَوقِفُ العَينَ بِلألائِها",5,"ا",3,0],["لَأّلْبَسَنَّ اليَوْمَ حِرْباؤهُ","مِنْ شَمْسِهِ تَحتَ شَآبِيبِ",6,"ب",1,0],["لا لَومَ أَن غَضِبَت عَلَيكَ فَإِنَّها","سَمِعَت لَعَمرُكَ أَعظَمَ البُهتانِ",7,"ن",1,1],["لا لَومَ أَن يَقِفَ الحَبيبُ بِمَنهَلٍ","يَرجو السَبيلَ إِلى الوُرودِ وَيَحذَرُ",8,"ر",1,0],["لا لا وَلا مِثلي المُرَقِّشُ إِذ هَوي","أَسماءَ لِلحَينِ المُحَتَّمِ وَالقَضا",9,"ا",1,0],["لا لدُنْيا جَنَحْتُ آلَغُ فيها","لا لِدينٍ خلَصْتُ لا لصَلاحِ",10,"ح",1,0],["لَآلِئٌ خَلفَ بَلّورٍ قَدِ اِتَسَقَت","في بَيتِ دُهقانَ تَستَهوي نُهى الغيدِ",11,"د",1,0],["لِآلِ عَلِيٍّ زينَةُ المُلكِ وِجهَتي","وَإِن قيلَ شيعِيٌّ فَقَد نِلتُ أَوطاري",12,"ر",2,0],["لَأَلَمَّ بي ما لَو أَلَمَّ بِشاهِقٍ","لَانهالَ جانِبُهُ فَصارَ كَثيبا",13,"ب",2,0],["لا لَهوُ أَيّامِهِ الخالي بِمُرتَجِعٍ","وَلا نَعيمُ لَياليهِ بِمُنتَظَرِ",14,"ر",1,0],["لَأَلفَيتَني بِالوُدِّ بَعدَكَ دائِماً","عَلى عَهدِنا إِذا نَحنُ لَم نَتَفَرَّقِ",15,"ق",1,0],["لا لعمري إني كثير باخوا","ني وما موسر له رأسمالي",16,"ل",2,0],["لآل غريب كل الثناء","وليس على فضلهم بالغريب",17,"ب",1,0],["ل الحسناء","فريدة النساء",18,"ا",2,0],["لا لا فما تبغينه من خطر","أبغي كتاباً حافلاً بالصور",19,"ر",1,0],["لا لاَ وَيَأْبَى العَدْلُ ذَاكَ مَثُوبَةً","لِمُخَلِّفٍ ذِمَماً عَلَى الأَوْطَانِ",20,"ن",1,0],["لا لَعمْرِي لا نَجْحَدَنَّ المَنَايَا","مِنَّةً تَنْتَهِي لَدَيْهَا الْهُمُومُ",21,"م",1,0],["لا لِعِيٍّ وَإِنَّمَا الْقَوْلُ فِي رُزْ","ءٍ كَهَذَا لِصَاِمتاتِ الْكثلُومِ",22,"م",1,0],["لِآلِ رَسولِ اللَهِ بِالخَيفِ مِن مِنىً","وَبِالرُكنِ وَالتَعريفِ وَالجَمَراتِ",23,"ت",1,0],["لَأَلقاكِ قَد أَدأَبتُ وَالقَومُ كُلُّما","جَرَت حَذو أَخفافِ المَطايا ظِلالُها",24,"ل",3,0],["لآلٍ بها تبأى الملوك نفاسة","وجلَّت لعمري أن تكون لآليا",25,"ي",2,0],["لا لأني أراه فيها ملوماً","بل لأني أعيب فعل الساسة",26,"س",2,0],["لا لَومَ إِذ لَجَّ في مَنعٍ أَقارِبُها","إِنَّ الفُؤادَ مَعَ الشَيءِ الَّذي مَنَعوا",27,"ع",3,0],["لآلي من نُبُلات الصوا","ر وكُحل المدامع لا تكتحِل",28,"ل",1,1],["لا لخمس هي المنيخة بالار","ض في حيث تتكي الجلب",29,"ب",1,0],["لآلي السلك في نسب نظيم","ودعنا من أنابيب الرّماح",30,"ح",1,0],["لا لينك اليومَ أرجو","ولستُ أرهبُ شدَّك",31,"ك",1,0],["لآلٍ في سلوكٍ قد جلاها","بنانك أم معانٍ في سطور",32,"ر",1,1],["لا لذَّة اليسر في حماكُم","نلت ولا لذَّة التشكِّي",33,"ي",1,0],["لا لَعَمرُ الإله لكن تعاشي","تَ بصيراً في ليلةٍ قَمراءِ",34,"ا",2,0],["لا لأجلِ المديح بل خيفة الهج","وأخَذْنا جوائزَ الخلفاءِ",35,"ا",2,0],["لا لَعَمْري وكيف ذاك وقبل ال","متْحِ روَّيْتَني بسَجْلٍ رغيبِ",36,"ب",1,0],["لألْقَى أبا عِيسى العلاء بنَ صَاعِدٍ","أَجَلَّ فتىً يُسْمَى إليه ويُوفَدُ",37,"د",1,0],["لألاؤه وَمَضاؤه","وغناؤه في كل مشهدْ",38,"د",1,0],["لآل وهبٍ مِننٌ جَمّةٌ","من يَرَها من حاسدٍ يُبلس",39,"س",1,0],["لا لعمري وامتعضْ من خطةٍ","مثلكَ استنكفَ منِها وامتعض",40,"ض",1,0],["لا لعمرُ الألى نفوكَ وقالوا","قحطبيٌّ مُدَلَّسٌ ما أشطّوا",41,"ط",3,0],["لا لثمَ ثغرٍ ولا محاورةً","يحلَى بها من هواه قد عبدكْ",42,"ك",1,0],["لا لذَّةُ الفاتِكِ مَوْجُودةٌ","عندي ولا لي سلوةُ الناسِكِ",43,"ك",1,0],["لا لعُجب قدّرتُ ذاك ولكن","ني أرجّي بحسن رأيك ذاكا",44,"ك",2,0],["لا لعِرضي من هجاءٍ","صاغَه فاسدُ فكرِك",45,"ك",1,0],["لا لَعمري لا سيّما صنوُ مجدٍ","فيه ما فيك من حميدِ الخصالِ",46,"ل",1,0],["لا لعمري ما للخضاب لذي الأبْ","صارِ إلا التكذيبُ والتأثيمُ",47,"م",1,0],["لا لقُربَى ولادةٍ جمعتكم","أينَ لا أين يَلتقي النَسَبان",48,"ن",1,0],["لا لا أخافُكَ إن عدلَكَ مَأْمني","مما أخاف وضامنٌ تحصيني",49,"ن",2,0],["لَأَلجَأَتني قُرَيشٌ خائِفاً وَجِلاً","وَمَوَّلَتني قُرَيشٌ بَعدَ إِقتارِ",50,"ر",1,0],["لا لا فَإِن سَكَتَ الكَنا","رُ فَلَم يَزَل ذاكَ الكَنار",51,"ر",1,0],["لا لَهفَةَ النَفسِ عَلى غابَةٍ","كُنتُ وَهِنداً نَلتَقي فيها",52,"ي",3,1],["لا لا وَحَقِّ اللَهِ ما","عَوَّدتَني هَذا التَجَنّي",53,"ن",2,0],["لا لا وَحَقِّ اللَهِ ما","أَنا بِالسَميعِ وَلا المُطيعِ",54,"ع",1,0],["لِآل عيسى مِن نَدى راحَتِهِ","وَآل مُوسى قَبَسٌ وَمُنتَشى",55,"ا",1,0],["لِأَلقى اِبنَ إِسحاقَ الَّذي دَقَّ فَهمُهُ","فَأَبدَعَ حَتّى جَلَّ عَن دِقَّةِ الفَهمِ",56,"م",1,0],["لا لون فيه وكله","لون إذا نظر الأريب",57,"ب",1,0],["لا لذّةٌ في سَمَاعٍ","ولا هوىً في شرابِ",58,"ب",1,0],["لا لُمتُ نَفسِيَ في هَوا","كَ وَلا اِنحَرَفتُ لِطولِ صَدِّك",59,"ك",1,0],["لِآلِ حُمَيدٍ مَذهَبٌ فِيَّ لَم أَكُن","لِأَذهَبَهُ فيهِم وَلَو جَدَعوا أَنفي",60,"ف",2,0],["لا لِصَبرٍ هَجَرتُكُم عَلِمَ اللَ","هُ وَلَكِن لِشِدَّةِ الإِشفاقِ",61,"ق",1,1],["لِأَلقاكَ وَاللاقيكَ يَعلَمُ أَنَّهُ","سَيَملَأُ كَفَّي ساعِدَيهِ ثَوابُها",62,"ب",3,0],["لِآلِ أَبي العاصي تُراثُ مَشورَةٍ","لِسُلطانِهِم في الحَقِّ أَلّا يُغَيَّرا",63,"ر",2,0],["لِآلِ المُعَلّى قُبَّةٌ يَبتَنونَها","بِأَيدي كِرامٍ رَفَّعوها بِعَرعَرِ",64,"ر",1,0],["لَأَلفَيتَ فيهِم مُطعِماً وَمُطاعِناً","وَراءَكَ شَزراً بِالوَشيجِ المُقَوَّمِ",65,"م",1,0],["لَأَلقاكَ إِنّي إِن لَقيتُكَ سالِماً","فَتِلكَ الَّتي أُنهى إِلَيها الأَمانِيا",66,"ي",2,0],["لِآلِ أَسماءَ إِذ هامَ الفُؤادُ بِها","حيناً وَإِذ هِيَ لَم تَظعَن وَلَم تَبِنِ",67,"ن",1,0],["لا لَقَّبَتني المَعالي بِاِبنِ 