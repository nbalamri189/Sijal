,["لا لا أخافُكَ إن عدلَكَ مَأْمني","مما أخاف وصامنٌ تحصيني",117,"ن",2,0],["لا ، لا أنام ولا أذوق كرى ،","أنا لست من يحيا لفجر غد",118,"د",1,0],["لا ، لم يحسّ ارتواء ، أو يجد ظمأ","أو يبتهج ، إن غدت أحلامه منحا",119,"ح",2,0],["لآل الحبيب حماة الغريب","شموس الوجود بدور السعود",120,"د",1,1],["لآل محمد جاه عريض","ومجد جاز عن درك العقول",121,"ل",1,1],["لآل النبي أنجال حيدرة الوغى","بني البضعة الزهرا مقام علا العليا",122,"ي",2,1],["لألأ الكون من ضيا نورك ال","محض وخاف الأكوان جذوة نارك",123,"ك",1,0],["لا لعاً للذي كبابي في الحب","وأهلاً بحبي المستجد",124,"د",1,0],["لآلٍ على هند الفطين يرى لها","بدور الليالي البيض للشمس واضحا",125,"ح",2,0],["لأَلغيت العقاب ولم","أَدع للنفي إِمكانا",126,"ن",2,0],["لأَلفٌ مضَى من بعدها مائة خَلَتْ","وأربعةُ الأعوام والعشرُ في العددْ",127,"د",1,0],["لاَ لاَ ولاَ شَنبَا تُجَاذِبُ مِزهَراً","يُحيِى رَسِيسَ الهَمِّ والأَوجَالِ",128,"ل",1,0],["لِآلِ مُحَمّدٍ راعٍ حَفيظٌ","وِدادُ الصَدرِ مِنّي وَالضَميرُ",129,"ر",1,0],["لا للقدود ولا للأعين السودِ","يصبو فؤادي ولا يهتزّ للغيدِ",130,"د",1,1],["لآلىءُ من بحر الفضائلِ إن بدت","لغائِصها صلَّى عليها وسلَّما",131,"م",2,0],["لا لَومَ يَلزَمُها إِذا قَصَرَت خُطىً","مِن فَرطِ ما حَمَلَت مِنَ الأَثقالِ",132,"ل",1,0],["لآلُىء دَمعي فيكَ ينشرُها الأسى","تَخافُ النَّوى طَوراً وتَرتِقَبُ الوَصلا",133,"ل",2,0],["لآلىءُ أَسلاكٍ أَزاهِرُ رَوضَةٍ","فَهاهيَ تُجنى بِالخَواطِرِ أَو تُجلى",134,"ل",2,0],["لا لومَ إن لبست عليه مسوحها","جزعاً تصانيفٌ له ثم الخُطب",135,"ب",1,0],["لآل معيبدٍ بعليّ فخراً","لهم فيه من العلياءِ ريفُ",136,"ف",1,0],["لآلة الحرب فضل قد أباح لمن","بها يلاعب أخذ المال للغب",137,"ب",1,0],["لا لَعمر الَّذي تَمَسَّكتُ مِنهُ","بِرَجاءٍ لا يَعتَفيهِ القُنوطُ",138,"ط",1,0],["لا لِكاسٍ وَلا لِآسٍ وَلا قُف","فازِ بازٍ وَلا لِضَمِّ خِرادِ",139,"د",1,0],["لالسْتُ بَكّاءً","مِمّا جَرى أو كانْ",140,"ن",1,0],["لأَلْقَى من الإسكندرية نَشْوةً","أَغُضُّ بها ما بين جنبىَّ من وَقْد",141,"د",1,0],["لا لصون فيه إلا","أنّني أفرقُ منهُ",142,"ن",2,0],["لا لعمري ما يصنع السيف في المه","جة ما تصنع الجفون المراض",143,"ض",1,0],["لا للبلاد نزلت كي تبتزَّها","ابناءَها وتقول قوموا واقعدوا",144,"د",3,0],["لال شبان شاد بيتا من العلا","رفيع الذرى ليس السماك يطاوله",145,"ل",2,0],["لا لن أبوح بحبي لن أبوح به","إني لأنبت من أركان ثهلان",146,"ن",1,0],["لا لا أبوح بحب بث","نة إنها اخذت عليّ",147,"ي",1,0],["لا لِقَومٍ وَلا لِدين","أَنتَ لِلنّاسِ أَجمَعين",148,"ن",1,1],["لِأُلي الشقاء قَصيرةً","وَطَويلَة لأُلي القُصور",149,"ر",1,0],["لالهمتني السر لما نظرت","إلي بهذا الفتور الشفوف",150,"ف",1,0],["لأُلزِم حُبَّكُمْ قلبي","وأَجعل حالَكم حالي",151,"ل",2,0],["لألزمه العصا يمشي عليها","وعلمه القران على القبور",152,"ر",1,0],["لألسنة الأقلام أعذب منطقٍ","تهنّيك بالأفراح والأنس يا يحيى",153,"ي",2,1],["لآلِ أَبِي حَفْصٍ وَسائِلُ نُصْرَةٍ","إلَى الدِّينِ وَالدنْيا هيَ النّسْبَةُ الدُّنْيَا",154,"ي",2,0],["لأَلْسِنَةِ النِّيرَانِ فيها بَلاغَةٌ","وَإنْ هِيَ لَمْ تَفْهَمْ حُروفاً وَلا نُطْقَا",155,"ق",2,0],["لا لا فاني في اعتصام زائد","بحبال ودكم الخلي من المرا",156,"ر",2,0],["لا لا وما كل الزمان بواحد","أحيى النفوس بعرفه يوم سعيد",157,"د",1,0],["لآليء لكنّ حبّاتها","تجف على حر أنفاسيه",158,"ي",2,0],["لا لن أعود إلى هواك مسامحاً","فالعمرُ ضاع ومن عزوفك مُمْحِلُ",159,"ل",1,0],["لا للإثابةِ ثمّ أُنهي إثرها","إنّ التخلّفَ واقعٌ لعوائقِ",160,"ق",1,0],["لآلِ حسينٍ صبغةُ الطوعِ والرضا","منَ اللّه ليطَ بالقلوبِ جسيدها",161,"د",3,0],["لا للشجاعة يقدمون وإنما","في غير حرب يقدم الجبناءُ",162,"ا",2,0],["لا لِشَيءٍ كانَ مِنّي قَبلَ ذا","غَيرَ فَخري بِضِياءِ الفَرقَدَين",163,"ن",1,0],["لا لون للفجر إنْ لم تشرقا معهُ","سِحْراً تَضُجّ به الساحات والطُّرُقُ",164,"ق",1,0],["لا لعجز وَخفض قَدر وَلكن","أَحلم الناس أَرفع الناس قَدرا",165,"ر",2,0],["لا لا وأَخافُ أنّها تَحْتَرِقُ","من حَرِّ فؤادي فتَزيدُ الحُرَقُ",166,"ق",1,0],["لا لَومَ بالإغرابِ في مَرعَى المُنى","عندي على جِنْسٍ من الأجناس",167,"س",1,0],["لا لَفظَةٌ لانَت أَتَيتَ بِها وَلا","عَتباً أَتَيتَ بِهِ وَلا ميعادا",168,"د",2,0],["لا لَومَ في الحُكمِ عَلى حاكِمٍ","وَالأَصلُ في الحُكمِ عَلى الظاهِرِ",169,"ر",1,0],["لا لُمتُهُم في لَومِهِم فَهُمُ","أَحبابُنا وَعداةُ ما جَ