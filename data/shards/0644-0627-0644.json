ps://www.poetsgate.com/ViewPoem.aspx?id=179471",""],[106,"حفظ الله صالحًا","https://www.poetsgate.com/ViewPoem.aspx?id=179358",""],[13,"عَلَى الشَّنْفَرَى سَارِي الْغَمَام فَرَائِحٌ","https://www.poetsgate.com/ViewPoem.aspx?id=180789",""],[90,"العلم والوطنية","https://www.poetsgate.com/ViewPoem.aspx?id=178949",""],[35,"أَصَادرَة ٌ حُجَّاجَ كَعْبٍ وَمَالِكٍ","https://www.poetsgate.com/ViewPoem.aspx?id=22059",""],[51,"أصبحتَ عاديتَ للصبا رشدكْ","https://www.poetsgate.com/ViewPoem.aspx?id=30012",""],[51,"سَمْعا أبا إسحق إنك ماجدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=30803",""],[100,"لا اكتراث","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67636&r=&rc=124",""]],"verses":[["لا لِلَوائِمِ إِقصارٌ بِلائِمَةٍ","عَنِ العَميدِ وَلا لِلقَلبِ سُلوانُ",0,"ن",1,0],["لَأُلزِمن إِن لَم يُغَيِّبَكَ الرَجَم","لِهزِمَتَيكَ عاقِراً مِنَ اللُجُم",1,"م",1,0],["لا لَومَ لِلدَهرِ وَلا عِتابا","تَغابَ إِنَّ الجَلدَ مَن تَغابى",2,"ب",2,1],["لا لَقاكِ الخَطبُ إِلّا","رامِياً غَيرَ مُصيبِ",3,"ب",1,0],["لآلِئاً في التِّبرِ مَغروسَةً","تَستَوقِفُ العَينَ بِلألائِها",4,"ا",3,0],["لَأّلْبَسَنَّ اليَوْمَ حِرْباؤهُ","مِنْ شَمْسِهِ تَحتَ شَآبِيبِ",5,"ب",1,0],["لا لَومَ أَن غَضِبَت عَلَيكَ فَإِنَّها","سَمِعَت لَعَمرُكَ أَعظَمَ البُهتانِ",6,"ن",1,1],["لا لَومَ أَن يَقِفَ الحَبيبُ بِمَنهَلٍ","يَرجو السَبيلَ إِلى الوُرودِ وَيَحذَرُ",7,"ر",1,0],["لا لا وَلا مِثلي المُرَقِّشُ إِذ هَوي","أَسماءَ لِلحَينِ المُحَتَّمِ وَالقَضا",8,"ا",1,0],["لا لدُنْيا جَنَحْتُ آلَغُ فيها","لا لِدينٍ خلَصْتُ لا لصَلاحِ",9,"ح",1,0],["لَآلِئٌ خَلفَ بَلّورٍ قَدِ اِتَسَقَت","في بَيتِ دُهقانَ تَستَهوي نُهى الغيدِ",10,"د",1,0],["لِآلِ عَلِيٍّ زينَةُ المُلكِ وِجهَتي","وَإِن قيلَ شيعِيٌّ فَقَد نِلتُ أَوطاري",11,"ي",1,0],["لَأَلَمَّ بي ما لَو أَلَمَّ بِشاهِقٍ","لَانهالَ جانِبُهُ فَصارَ كَثيبا",12,"ب",2,0],["لا لَهوُ أَيّامِهِ الخالي بِمُرتَجِعٍ","وَلا نَعيمُ لَياليهِ بِمُنتَظَرِ",13,"ر",1,0],["لَأَلفَيتَني بِالوُدِّ بَعدَكَ دائِماً","عَلى عَهدِنا إِذا نَحنُ لَم نَتَفَرَّقِ",14,"ق",1,0],["لا لعمري إني كثير باخوا","ني وما موسر له رأسمالي",15,"ي",1,0],["لآل غريب كل الثناء","وليس على فضلهم بالغريب",16,"ب",1,0],["ل الحسناء","فريدة النساء",17,"ا",2,0],["لا لا فما تبغينه من خطر","أبغي كتاباً حافلاً بالصور",18,"ر",1,0],["لا لاَ وَيَأْبَى العَدْلُ ذَاكَ مَثُوبَةً","لِمُخَلِّفٍ ذِمَماً عَلَى الأَوْطَانِ",19,"ن",1,0],["لا لَعمْرِي لا نَجْحَدَنَّ المَنَايَا","مِنَّةً تَنْتَهِي لَدَيْهَا الْهُمُومُ",20,"م",1,0],["لا لِعِيٍّ وَإِنَّمَا الْقَوْلُ فِي رُزْ","ءٍ كَهَذَا لِصَاِمتاتِ الْكثلُومِ",21,"م",1,0],["لِآلِ رَسولِ اللَهِ بِالخَيفِ مِن مِنىً","وَبِالرُكنِ وَالتَعريفِ وَالجَمَراتِ",22,"ت",1,0],["لَأَلقاكِ قَد أَدأَبتُ وَالقَومُ كُلُّما","جَرَت حَذو أَخفافِ المَطايا ظِلالُها",23,"ل",3,0],["لآلٍ بها تبأى الملوك نفاسة","وجلَّت لعمري أن تكون لآليا",24,"ي",2,0],["لا لأني أراه فيها ملوماً","بل لأني أعيب فعل الساسة",25,"س",2,0],["لا لَومَ إِذ لَجَّ في مَنعٍ أَقارِبُها","إِنَّ الفُؤادَ مَعَ الشَيءِ الَّذي مَنَعوا",26,"ع",3,0],["لآلي من نُبُلات الصوا","ر وكُحل المدامع لا تكتحِل",27,"ل",1,1],["لا لخمس هي المنيخة بالار","ض في حيث تتكي الجلب",28,"ب",1,0],["لآلي السلك في نسب نظيم","ودعنا من أنابيب الرّماح",29,"ح",1,0],["لا لينك اليومَ أرجو","ولستُ أرهبُ شدَّك",30,"ك",1,0],["لآلٍ في سلوكٍ قد جلاها","بنانك أم معانٍ في سطور",31,"ر",1,1],["لا لذَّة اليسر في حماكُم","نلت ولا لذَّة التشكِّي",32,"ي",1,0],["لا لَعَمرُ الإله لكن تعاشي","تَ بصيراً في ليلةٍ قَمراءِ",33,"ا",2,0],["لا لأجلِ المديح بل خيفة الهج","وأخَذْنا جوائزَ الخلفاءِ",34,"ا",2,0],["لا لَعَمْري وكيف ذاك وقبل ال","متْحِ روَّيْتَني بسَجْلٍ رغيبِ",35,"ب",1,0],["لألْقَى أبا عِيسى العلاء بنَ صَاعِدٍ","أَجَلَّ فتىً يُسْمَى إليه ويُوفَدُ",36,"د",1,0],["لألاؤه وَمَضاؤه","وغناؤه في كل مشهدْ",37,"د",1,0],["لآل وهبٍ مِننٌ جَمّةٌ","من يَرَها من حاسدٍ يُبلس",38,"س",1,0],["لا لعمري وامتعضْ من خطةٍ","مثلكَ استنكفَ منِها وامتعض",39,"ض",1,0],["لا لعمرُ الألى نفوكَ وقالوا","قحطبيٌّ مُدَلَّسٌ ما أشطّوا",40,"ط",3,0],["لا لثمَ ثغرٍ ولا محاورةً","يحلَى بها من هواه قد عبدكْ",41,"ك",1,0],["لا لذَّةُ الفاتِكِ مَوْجُودةٌ","عندي ولا لي سلوةُ الناسِكِ",42,"ك",1,0],["لا لعُجب قدّرتُ ذاك ولكن","ني أرجّي بحسن رأيك ذاكا",43,"ك",2,0],["لا لعِرضي من هجاءٍ","صاغَه فاسدُ فكرِك",44,"ك",1,0],["لا لَعمري لا سيّما صنوُ مجدٍ","فيه ما فيك من حميدِ الخصالِ",45,"ل",1,0],["لا لعمري ما للخضاب لذي الأبْ","صارِ إلا التكذيبُ والتأثيمُ",46,"م",1,0],["لا لقُربَى ولادةٍ جمعتكم","أينَ لا أين يَلتقي النَسَبان",47,"ن",1,0],["لا لا أخافُكَ إن عدلَكَ مَأْمني","مما أخاف وضامنٌ تحصيني",48,"ن",2,0],["لَأَلجَأَتني قُرَيشٌ خائِفاً وَجِلاً","وَمَوَّلَتني قُرَيشٌ بَعدَ إِقتارِ",49,"ر",1,0],["لا لا فَإِن سَكَتَ الكَنا","رُ فَلَم يَزَل ذاكَ الكَنار",50,"ر",1,0],["لا لَهفَةَ النَفسِ عَلى غابَةٍ","كُنتُ وَهِنداً نَلتَقي فيها",51,"ي",3,1],["لا لا وَحَقِّ اللَهِ ما","عَوَّدتَني هَذا التَجَنّي",52,"ن",2,0],["لا لا وَحَقِّ اللَهِ ما","أَنا بِالسَميعِ وَلا المُطيعِ",53,"ع",1,0],["لِآل عيسى مِن نَدى راحَتِهِ","وَآل مُوسى قَبَسٌ وَمُنتَشى",54,"ا",1,0],["لِأَلقى اِبنَ إِسحاقَ الَّذي دَقَّ فَهمُهُ","فَأَبدَعَ حَتّى جَلَّ عَن دِقَّةِ الفَهمِ",55,"م",1,0],["لا لون فيه وكله","لون إذا نظر الأريب",56,"ب",1,0],["لا لذّةٌ في سَمَاعٍ","ولا هوىً في شرابِ",57,"ب",1,0],["لا لُمتُ نَفسِيَ في هَوا","كَ وَلا اِنحَرَفتُ لِطولِ صَدِّك",58,"ك",1,0],["لِآلِ حُمَيدٍ مَذهَبٌ فِيَّ لَم أَكُن","لِأَذهَبَهُ فيهِم وَلَو جَدَعوا أَنفي",59,"ي",1,0],["لا لِصَبرٍ هَجَرتُكُم عَلِمَ اللَ","هُ وَلَكِن لِشِدَّةِ الإِشفاقِ",60,"ق",1,1],["لِأَلقاكَ وَاللاقيكَ يَعلَمُ أَنَّهُ","سَيَملَأُ كَفَّي ساعِدَيهِ ثَوابُها",61,"ب",3,0],["لِآلِ أَبي العاصي تُراثُ مَشورَةٍ","لِسُلطانِهِم في الحَقِّ أَلّا يُغَيَّرا",62,"ر",2,0],["لِآلِ المُعَلّى قُبَّةٌ يَبتَنونَها","بِأَيدي كِرامٍ رَفَّعوها بِعَرعَرِ",63,"ر",1,0],["لَأَلفَيتَ فيهِم مُطعِماً وَمُطاعِناً","وَراءَكَ شَزراً بِالوَشيجِ المُقَوَّمِ",64,"م",1,0],["لَأَلقاكَ إِنّي إِن لَقيتُكَ سالِماً","فَتِلكَ الَّتي أُنهى إِلَيها الأَمانِيا",65,"ي",2,0],["لِآلِ أَسماءَ إِذ هامَ الفُؤادُ بِها","حيناً وَإِذ هِيَ لَم تَظعَن وَلَم تَبِنِ",66,"ن",1,0],["لا لَقَّبَتني المَعالي بِاِبنِ بَجدَتِها","يَومَ الفَخارِ وَلا بَرَّ التُقى قَسَمي",67,"م",2,0],["لَاِلتَقَينا قَبولَها بِقَبولٍ","وَشُفينا مِنها وَلَو بِالسُمومِ",68,"م",1,0],["لآِلِ سَهلٍ أَكُفٌّ كُلَّما اِجتُدِيَت","فَعَلنَ في المَحلِ ما لا تَفعَلُ الدِيَمُ",69,"م",1,0],["لَآلِئٌ كَالنُجومِ الزُهرِ قَد لَبِسَت","أَبشارُها صَدَفَ الإِحصانِ لا الصَدَفا",70,"ف",2,0],["لألأء وجهكَ يُغني","أنْ يحرسوك بلالا",71,"ل",2,0],["لِالَّتي قالَت لِأَترابٍ لَها","قُطُفٍ فيهِنَّ أُنسٌ وَخَفَر",72,"ر",1,0],["لا لَعَمرِ المَجدِ وَالكَرَمِ","وَمَضاءِ السَيفِ وَالقَلَمِ",73,"م",1,0],["لا لَعَمرِ المَجدِ وَالكَرَمِ","وَمَزارِ البَيتِ وَالحَرَمِ",74,"م",1,0],["لَأَلفَيتِني في غارَةٍ أَعتَزي بِها","إِلَيكَ وَإِمّا راجِعاً أَنا ثائِرُ",75,"ر",1,0],["لا لِمَقالاتٍ وَعَقدِ دَينٍ","لَكِن لِخَدعِ الجاهِلِ المَفتونِ",76,"ن",1,0],["لألْقَتْ إليه الأبحُرُ الصُّمُّ أمرَهَا","وهبّتْ بما شاءَ الرّياحُ السَّواهك",77,"ك",1,0],["لا لِأَن تُقلِعَ عَن قَولِها","مِكثارَةٌ فينا وَمِكثارُ",78,"ر",1,0],["لا لا وَلا أَنعَتُ القَلوصَ وَلا","أُشغَلُ إِلّا بِوَصفِهِ الحَسَنِ",79,"ن",1,0],["لا لا عذرتُ إلى المما","تِ بمَن هويتُ وإن عذَر",80,"ر",1,0],["لِأَلقى بَني عَيلانَ إِنَّ فِعالِهُم","تَزيدُ عَلى كُلِّ الفَعالِ مَراتِبُه",81,"ه",1,1],["لِأَلقى بَني عَيلانَ إِنَّ فَعالَهُم","تَزيدُ عَلى كُلِّ الفَعالِ مَراكِبُه",82,"ب",2,0],["لا لَوم إن فشل المجا","هد بعد أَن لَم يأل جهدا",83,"د",2,0],["لا لِشَيءٍ سِوى المُروءَةِ يَحلو","طَعمُها في فَمِ المَريءِ المُوالي",84,"ل",2,0],["لا لَوْعَتِي تَدَعُ الْفُؤَادَ وَلا يَدِي","تَقْوَى عَلَى رَدِّ الحَبِيبِ الْغَادِي",85,"ي",1,0],["لأَلْقَيْتُهَا طَوْعاً لَعَلَّكِ بَعْدَها","تَقُولِينَ حَيَّا اللهُ عَهْدَكَ مِنْ عَهْدِ",86,"د",1,0],["لا لَفْظَةٌ تَنْبُو وَلا لَغْوٌ بِهِ","يَحشُو الكَلام وَلا قَذِيفَةُ ثَائرِ",87,"ر",1,0],["لا لَيلَ عَافِيَةٍ هَجِعْتُ بِهِ وَلاَ","يَوْمٌ نَشِطْتُ بِهِ مِنَ الإِعْيَاءِ",88,"ا",2,0],["لاَ لاَ وَحَقِّكَ يَا شَهِيدَ وَفَائِهِ","وَرَجِائِهِ كَذَبَ النَّعِيُّ وَأَرْجَفَا",89,"ف",2,0],["لأْلاَؤُهُ يَرْفَضُّ أَلْوَاناً وَفِي","ذَاكَ التَّشَعُبِ قُوَّةٌ لَمْ تُعْهَد",90,"د",1,0],["لاَ لَعَمْرِي لَيْسَ مُنْقَضّاً حِمىً","وَلَهُ فِي الْمَوْقِفِ الصَّعْبِ حُمَاةُ",91,"ه",1,0],["لا، لا أنام ولا أذوق كرى،","إن النهار مضى ولم يعد",92,"د",1,0],["لا لا تموت فإنها لبريئة","حسناء ما شبت عن الأطواق",93,"ق",1,0],["لا ، لَمْ أَجِدْ لَكَ في البُلْدانِ من شَبَهٍ","ولا لِناسِكَ بَيْنَ النَّاسِ أشْباها",94,"ا",3,0],["لا لَم تَذُق لِلهَوى طَعماً فَتَعرِفَهُ","بَل أَنتَ في غَفلَةٍ عَمّا بِعَبّاسِ",95,"س",1,0],["لِآلئُ الدَمعِ راحَتي في","رُزئِهِ هَدَّتِ الجِبالا",96,"ل",2,0],["لَآلئُ عَيني عقدُها مُتَناثِرٌ","وَإِن كانَ لا يشفي البُكاءُ عَليلا",97,"ل",2,0],["لا لحنه عازف ولا وتره","ما كان طيّ النشيد ينتظرُهْ",98,"ر",2,1],["لا لَيْتَ شِعْرِي والخُطُوبُ كَثِيرَةٌ","مَتى رَحْلُ قَيْسٍ مَسْتَقِلٌّ فَراجعُ",99,"ع",1,1],["لا لاجئينَ اليومَ بل","قولوا لهم: يا عائدين",100,"ن",1,0],["لا لعمري، ليست مَلاكًا؛ ولكن","هي أنثى قويةُ الإيمان",101,"ن",1,0],["لا، لَعَمْري، فما أسامَةُ إلا","كاذب حين يَدَّعي إقدامه",102,"م",2,0],["لألْفَيْتَنِي في غَارَةٍ أُدَّعَى لَهَا","إلَيْكَ وَإمَّا رَاجِعاً أَنَا ثَائِرُ",103,"ر",1,0],["لا لن تفرقنا الحدود ولم تكن","تدري الحواجز اخوة جيران",104,"ن",1,0],["لألفيتني بالوُدِّ بعدكَ دائماً","على عهدنا إذْ نحنُ لم نتفرّقِ",105,"ق",1,0],["لا لثمَ ثغرٍ ولا محاورة ً","يُحلى به من هواه قد عبدك",106,"ك",1,0],["لا لا أخافُكَ إن عدلَكَ مَأْمني","مما أخاف وصامنٌ تحصيني",107,"ن",2,0],["لا ، لم يحسّ ارتواء ، أو يجد ظمأ","أو يبتهج ، إن غدت أحلامه منحا",108,"ح",2,0]]}