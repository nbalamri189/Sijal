بدا","https://www.aldiwan.net/poem53381.html","الوافر"],[404,"تلاميذ النبوة","https://www.aldiwan.net/poem6731.html","عموديه"],[407,"بالله يا ريح الصبا","https://www.aldiwan.net/poem34157.html","مجزوء الرجز"],[410,"أرى منك وجه الصد لا يتغير","https://www.aldiwan.net/poem50160.html","الطويل"],[420,"لآل المصطفى علم وجود","https://www.aldiwan.net/poem54092.html","الوافر"],[433,"جمالك ليس يمنعه قناع","https://www.aldiwan.net/poem40059.html","الوافر"],[433,"ألا حيي بكاسك واستنيري","https://www.aldiwan.net/poem41439.html","الوافر"],[436,"نزلوا فادعوا نزال نزال","https://www.aldiwan.net/poem12343.html","الخفيف"],[436,"قرنت بواو الصدغ صاد المقبل","https://www.aldiwan.net/poem12695.html","الطويل"],[445,"أبا ساحباً ذيل البطالة والصبا","https://www.aldiwan.net/poem14400.html","الطويل"],[445,"دع الزفرات صاعدة طوامي","https://www.aldiwan.net/poem14481.html","الوافر"],[447,"إن كان بعض الشعر غير سديد","https://www.aldiwan.net/poem55916.html","عموديه"],[447,"يا جنان الشام يا ذات البها","https://www.aldiwan.net/poem56030.html","عموديه"],[455,"وياسمين حبانا طيب منظره","https://www.aldiwan.net/poem13788.html","البسيط"],[461,"لا لنوازي كبد هاجها","https://www.aldiwan.net/poem56080.html","السريع"],[461,"جاء بها والخير مجلوب","https://www.aldiwan.net/poem56277.html","السريع"],[467,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[467,"وبروحي من وجهه شفقي اللون","https://www.aldiwan.net/poem3257.html","عموديه"],[467,"جهلاً نظرت برامتين","https://www.aldiwan.net/poem3478.html","عموديه"],[467,"نسيم الصبا مثلي يصح ويسقم","https://www.aldiwan.net/poem3496.html","عموديه"],[473,"شأتك المنازل بالأبرق","https://www.aldiwan.net/poem4773.html","المتقارب"],[482,"لا الترك ترضى بما أجرت حكومتها","https://www.aldiwan.net/poem37042.html","البسيط"],[485,"أدر المدامة يا نديم إلى الصباح","https://www.aldiwan.net/poem24333.html","عموديه"],[498,"ألم تر أني في نهضتي","https://www.aldiwan.net/poem9857.html","المتقارب"],[498,"أنعت جهما لم أجد فيما مضى","https://www.aldiwan.net/poem10223.html","الرجز"],[498,"وفتية كنجوم الليل مسعدة","https://www.aldiwan.net/poem10247.html","البسيط"],[503,"أسكرت أهل الوحا خمرتنا","https://www.aldiwan.net/poem37672.html","الرمل"],[509,"رأى الحزن ما عندي من الحزن والكرب","https://www.aldiwan.net/poem2470.html","الطويل"],[541,"دعنى من ذكر حداة الأينق","https://www.aldiwan.net/poem47549.html","عموديه"],[554,"لي من رضابك ما يغني عن الراح","https://www.aldiwan.net/poem47891.html","البسيط"],[565,"هوى في القلب يعذب وهو داء","https://www.aldiwan.net/poem52983.html","الوافر"],[566,"تخافقت البروق على الغميم","https://www.aldiwan.net/poem13599.html","الوافر"],[566,"حمدنا الله ذا العرش المجيد","https://www.aldiwan.net/poem13602.html","الوافر"],[575,"لآل هند بجنبي نفنف دار","https://www.aldiwan.net/poem2054.html","البسيط"],[578,"بكيتك بالعين التي أنت أختها","https://www.aldiwan.net/poem2787.html","الطويل"],[825,"","https://poetry.dctabudhabi.ae/diwan/poem/103390","الطويل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/28095","الطويل"],[1181,"","https://poetry.dctabudhabi.ae/diwan/poem/31519","الطويل"]],"verses":[["لآل رسول الله فيها مضاجعٌ","ومن محكم التزيل عنها موارد",0,"د",1,0],["لا لِلَوائِمِ إِقصارٌ بِلائِمَةٍ","عَنِ العَميدِ وَلا لِلقَلبِ سُلوانُ",1,"ن",1,0],["لَأُلزِمن إِن لَم يُغَيِّبَكَ الرَجَم","لِهزِمَتَيكَ عاقِراً مِنَ اللُجُم",2,"م",1,0],["لا لَومَ لِلدَهرِ وَلا عِتابا","تَغابَ إِنَّ الجَلدَ مَن تَغابى",3,"ب",2,1],["لا لَقاكِ الخَطبُ إِلّا","رامِياً غَيرَ مُصيبِ",4,"ب",1,0],["لآلِئاً في التِّبرِ مَغروسَةً","تَستَوقِفُ العَينَ بِلألائِها",5,"ا",3,0],["لَأّلْبَسَنَّ اليَوْمَ حِرْباؤهُ","مِنْ شَمْسِهِ تَحتَ شَآبِيبِ",6,"ب",1,0],["لا لَومَ أَن غَضِبَت عَلَيكَ فَإِنَّها","سَمِعَت لَعَمرُكَ أَعظَمَ البُهتانِ",7,"ن",1,1],["لا لَومَ أَن يَقِفَ الحَبيبُ بِمَنهَلٍ","يَرجو السَبيلَ إِلى الوُرودِ وَيَحذَرُ",8,"ر",1,0],["لا لا وَلا مِثلي المُرَقِّشُ إِذ هَوي","أَسماءَ لِلحَينِ المُحَتَّمِ وَالقَضا",9,"ا",1,0],["لا لدُنْيا جَنَحْتُ آلَغُ فيها","لا لِدينٍ خلَصْتُ لا لصَلاحِ",10,"ح",1,0],["لَآلِئٌ خَلفَ بَلّورٍ قَدِ اِتَسَقَت","في بَيتِ دُهقانَ تَستَهوي نُهى الغيدِ",11,"د",1,0],["لِآلِ عَلِيٍّ زينَةُ المُلكِ وِجهَتي","وَإِن قيلَ شيعِيٌّ فَقَد نِلتُ أَوطاري",12,"ر",2,0],["لَأَلَمَّ بي ما لَو أَلَمَّ بِشاهِقٍ","لَانهالَ جانِبُهُ فَصارَ كَثيبا",13,"ب",2,0],["لا لَهوُ أَيّامِهِ الخالي بِمُرتَجِعٍ","وَلا نَعيمُ لَياليهِ بِمُنتَظَرِ",14,"ر",1,0],["لَأَلفَيتَني بِالوُدِّ بَعدَكَ دائِماً","عَلى عَهدِنا إِذا نَحنُ لَم نَتَفَرَّقِ",15,"ق",1,0],["لا لعمري إني كثير باخوا","ني وما موسر له رأسمالي",16,"ل",2,0],["لآل غريب كل الثناء","وليس على فضلهم بالغريب",17,"ب",1,0],["ل الحسناء","فريدة النساء",18,"ا",2,0],["لا لا فما تبغينه من خطر","أبغي كتاباً حافلاً بالصور",19,"ر",1,0],["لا لاَ وَيَأْبَى العَدْلُ ذَاكَ مَثُوبَةً","لِمُخَلِّفٍ ذِمَماً عَلَى الأَوْطَانِ",20,"ن",1,0],["لا لَعمْرِي لا نَجْحَدَنَّ المَنَايَا","مِنَّةً تَنْتَهِي لَدَيْهَا الْهُمُومُ",21,"م",1,0],["لا لِعِيٍّ وَإِنَّمَا الْقَوْلُ فِي رُزْ","ءٍ كَهَذَا لِصَاِمتاتِ الْكثلُومِ",22,"م",1,0],["لِآلِ رَسولِ اللَهِ بِالخَيفِ مِن مِنىً","وَبِالرُكنِ وَالتَعريفِ وَالجَمَراتِ",23,"ت",1,0],["لَأَلقاكِ قَد أَدأَبتُ وَالقَومُ كُلُّما","جَرَت حَذو أَخفافِ المَطايا ظِلالُها",24,"ل",3,0],["لآلٍ بها تبأى الملوك نفاسة","وجلَّت لعمري أن تكون لآليا",25,"ي",2,0],["لا لأني أراه فيها ملوماً","بل لأني أعيب فعل الساسة",26,"س",2,0],["لا لَومَ إِذ لَجَّ في مَنعٍ أَقارِبُها","إِنَّ الفُؤادَ مَعَ الشَيءِ الَّذي مَنَعوا",27,"ع",3,0],["لآلي من نُبُلات الصوا","ر وكُحل المدامع لا تكتحِل",28,"ل",1,1],["لا لخمس هي المنيخة بالار","ض في حيث تتكي الجلب",29,"ب",1,0],["لآلي السلك في نسب نظيم","ودعنا من أنابيب الرّماح",30,"ح",1,0],["لا لينك اليومَ أرجو","ولستُ أرهبُ شدَّك",31,"ك",1,0],["لآلٍ في سلوكٍ قد جلاها","بنانك أم معانٍ في سطور",32,"ر",1,1],["لا لذَّة اليسر في حماكُم","نلت ولا لذَّة التشكِّي",33,"ي",1,0],["لا لَعَمرُ الإله لكن تعاشي","تَ بصيراً في ليلةٍ قَمراءِ",34,"ا",2,0],["لا لأجلِ المديح بل خيفة الهج","وأخَذْنا جوائزَ الخلفاءِ",35,"ا",2,0],["لا لَعَمْري وكيف ذاك وقبل ال","متْحِ روَّيْتَني بسَجْلٍ رغيبِ",36,"ب",1,0],["لألْقَى أبا عِيسى العلاء بنَ صَاعِدٍ","أَجَلَّ فتىً يُسْمَى إليه ويُوفَدُ",37,"د",1,0],["لألاؤه وَمَضاؤه","وغناؤه في كل مشهدْ",38,"د",1,0],["لآل وهبٍ مِننٌ جَمّةٌ","من يَرَها من حاسدٍ يُبلس",39,"س",1,0],["لا لعمري وامتعضْ من خطةٍ","مثلكَ استنكفَ منِها وامتعض",40,"ض",1,0],["لا لعمرُ الألى نفوكَ وقالوا","قحطبيٌّ مُدَلَّسٌ ما أشطّوا",41,"ط",3,0],["لا لثمَ ثغرٍ ولا محاورةً","يحلَى بها من هواه قد عبدكْ",42,"ك",1,0],["لا لذَّةُ الفاتِكِ مَوْجُودةٌ","عندي ولا لي سلوةُ الناسِكِ",43,"ك",1,0],["لا لعُجب قدّرتُ ذاك ولكن","ني أرجّي بحسن رأيك ذاكا",44,"ك",2,0],["لا لعِرضي من هجاءٍ","صاغَه فاسدُ فكرِك",45,"ك",1,0],["لا لَعمري لا سيّما صنوُ مجدٍ","فيه ما فيك من حميدِ الخصالِ",46,"ل",1,0],["لا لعمري ما للخضاب لذي الأبْ","صارِ إلا التكذيبُ والتأثيمُ",47,"م",1,0],["لا لقُربَى ولادةٍ جمعتكم","أينَ لا أين يَلتقي النَسَبان",48,"ن",1,0],["لا لا أخافُكَ إن عدلَكَ مَأْمني","مما أخاف وضامنٌ تحصيني",49,"ن",2,0],["لَأَلجَأَتني قُرَيشٌ خائِفاً وَجِلاً","وَمَوَّلَتني قُرَيشٌ بَعدَ إِقتارِ",50,"ر",1,0],["لا لا فَإِن سَكَتَ الكَنا","رُ فَلَم يَزَل ذاكَ الكَنار",51,"ر",1,0],["لا لَهفَةَ النَفسِ عَلى غابَةٍ","كُنتُ وَهِنداً نَلتَقي فيها",52,"ي",3,1],["لا لا وَحَقِّ اللَهِ ما","عَوَّدتَني هَذا التَجَنّي",53,"ن",2,0],["لا لا وَحَقِّ اللَهِ ما","أَنا بِالسَميعِ وَلا المُطيعِ",54,"ع",1,0],["لِآل عيسى مِن نَدى راحَتِهِ","وَآل مُوسى قَبَسٌ وَمُنتَشى",55,"ا",1,0],["لِأَلقى اِبنَ إِسحاقَ الَّذي دَقَّ فَهمُهُ","فَأَبدَعَ حَتّى جَلَّ عَن دِقَّةِ الفَهمِ",56,"م",1,0],["لا لون فيه وكله","لون إذا نظر الأريب",57,"ب",1,0],["لا لذّةٌ في سَمَاعٍ","ولا هوىً في شرابِ",58,"ب",1,0],["لا لُمتُ نَفسِيَ في هَوا","كَ وَلا اِنحَرَفتُ لِطولِ صَدِّك",59,"ك",1,0],["لِآلِ حُمَيدٍ مَذهَبٌ فِيَّ لَم أَكُن","لِأَذهَبَهُ فيهِم وَلَو جَدَعوا أَنفي",60,"ف",2,0],["لا لِصَبرٍ هَجَرتُكُم عَلِمَ اللَ","هُ وَلَكِن لِشِدَّةِ الإِشفاقِ",61,"ق",1,1],["لِأَلقاكَ وَاللاقيكَ يَعلَمُ أَنَّهُ","سَيَملَأُ كَفَّي ساعِدَيهِ ثَوابُها",62,"ب",3,0],["لِآلِ أَبي العاصي تُراثُ مَشورَةٍ","لِسُلطانِهِم في الحَقِّ أَلّا يُغَيَّرا",63,"ر",2,0],["لِآلِ المُعَلّى قُبَّةٌ يَبتَنونَها","بِأَيدي كِرامٍ رَفَّعوها بِعَرعَرِ",64,"ر",1,0],["لَأَلفَيتَ فيهِم مُطعِماً وَمُطاعِناً","وَراءَكَ شَزراً بِالوَشيجِ المُقَوَّمِ",65,"م",1,0],["لَأَلقاكَ إِنّي إِن لَقيتُكَ سالِماً","فَتِلكَ الَّتي أُنهى إِلَيها الأَمانِيا",66,"ي",2,0],["لِآلِ أَسماءَ إِذ هامَ الفُؤادُ بِها","حيناً وَإِذ هِيَ لَم تَظعَن وَلَم تَبِنِ",67,"ن",1,0],["لا لَقَّبَتني المَعالي بِاِبنِ بَجدَتِها","يَومَ الفَخارِ وَلا بَرَّ التُقى قَسَمي",68,"م",2,0],["لَاِلتَقَينا قَبولَها بِقَبولٍ","وَشُفينا مِنها وَلَو بِالسُمومِ",69,"م",1,0],["لآِلِ سَهلٍ أَكُفٌّ كُلَّما اِجتُدِيَت","فَعَلنَ في المَحلِ ما لا تَفعَلُ الدِيَمُ",70,"م",1,0],["لَآلِئٌ كَالنُجومِ الزُهرِ قَد لَبِسَت","أَبشارُها صَدَفَ الإِحصانِ لا الصَدَفا",71,"ف",2,0],["لألأء وجهكَ يُغني","أنْ يحرسوك بلالا",72,"ل",2,0],["لِالَّتي قالَت لِأَترابٍ لَها","قُطُفٍ فيهِنَّ أُنسٌ وَخَفَر",73,"ر",1,0],["لا لَعَمرِ المَجدِ وَالكَرَمِ","وَمَضاءِ السَيفِ وَالقَلَمِ",74,"م",1,0],["لا لَعَمرِ المَجدِ وَالكَرَمِ","وَمَزارِ البَيتِ وَالحَرَمِ",75,"م",1,0],["لَأَلفَيتِني في غارَةٍ أَعتَزي بِها","إِلَيكَ وَإِمّا راجِعاً أَنا ثائِرُ",76,"ر",1,0],["لا لِمَقالاتٍ وَعَقدِ دَينٍ","لَكِن لِخَدعِ الجاهِلِ المَفتونِ",77,"ن",1,0],["لألْقَتْ إليه الأبحُرُ الصُّمُّ أمرَهَا","وهبّتْ بما شاءَ الرّياحُ السَّواهك",78,"ك",1,0],["لا لِأَن تُقلِعَ عَن قَولِها","مِكثارَةٌ فينا وَمِكثارُ",79,"ر",1,0],["لا لا وَلا أَنعَتُ القَلوصَ وَلا","أُشغَلُ إِلّا بِوَصفِهِ الحَسَنِ",80,"ن",1,0],["لا لا عذرتُ إلى المما","تِ بمَن هويتُ وإن عذَر",81,"ر",1,0],["لِأَلقى بَني عَيلانَ إِنَّ فِعالِهُم","تَزيدُ عَلى كُلِّ الفَعالِ مَراتِبُه",82,"ه",1,1],["لِأَلقى بَني عَيلانَ إِنَّ فَعالَهُم","تَزيدُ عَلى كُلِّ الفَعالِ مَراكِبُه",83,"ب",2,0],["لآل سليم معتق أو مهمل","أو ابن كدان العبد عبد بني حبل",84,"ل",1,0],["لا لَوم إن فشل المجا","هد بعد أَن لَم يأل جهدا",85,"د",2,0],["لاَ لَيَّنَ اللهُ لِلْمَعْرُوفِ حَاضِرَهَا","ولاَ يَزَلْ مُغْلِساً مَا عَاشَ بَادِيهَا",86,"ي",3,0],["لا لِشَيءٍ سِوى المُروءَةِ يَحلو","طَعمُها في فَمِ المَريءِ المُوالي",87,"ل",2,0],["لا لَوْعَتِي تَدَعُ الْفُؤَادَ وَلا يَدِي","تَقْوَى عَلَى رَدِّ الحَبِيبِ الْغَادِي",88,"د",2,0],["لأَلْقَيْتُهَا طَوْعاً لَعَلَّكِ بَعْدَها","تَقُولِينَ حَيَّا اللهُ عَهْدَكَ مِنْ عَهْدِ",89,"د",1,0],["لا لَفْظَةٌ تَنْبُو وَلا لَغْوٌ بِهِ","يَحشُو الكَلام وَلا قَذِيفَةُ ثَائرِ",90,"ر",1,0],["لا لَيلَ عَافِيَةٍ هَجِعْتُ بِهِ وَلاَ","يَوْمٌ نَشِطْتُ بِهِ مِنَ الإِعْيَاءِ",91,"ا",2,0],["لاَ لاَ وَحَقِّكَ يَا شَهِيدَ وَفَائِهِ","وَرَجِائِهِ كَذَبَ النَّعِيُّ وَأَرْجَفَا",92,"ف",2,0],["لأْلاَؤُهُ يَرْفَضُّ أَلْوَاناً وَفِي","ذَاكَ التَّشَعُبِ قُوَّةٌ لَمْ تُعْهَد",93,"د",1,0],["لاَ لَعَمْرِي لَيْسَ مُنْقَضّاً حِمىً","وَلَهُ فِي الْمَوْقِفِ الصَّعْبِ حُمَاةُ",94,"ه",1,0],["لا، لا أنام ولا أذوق كرى،","إن النهار مضى ولم يعد",95,"د",1,0],["لا لا تموت فإنها لبريئة","حسناء ما شبت عن الأطواق",96,"ق",1,0],["لا ، لَمْ أَجِدْ لَكَ في البُلْدانِ من شَبَهٍ","ولا لِناسِكَ بَيْنَ النَّاسِ أشْباها",97,"ا",3,0],["لا لَم تَذُق لِلهَوى طَعماً فَتَعرِفَهُ","بَل أَنتَ في غَفلَةٍ عَمّا بِعَبّاسِ",98,"س",1,0],["لِآلئُ الدَمعِ راحَتي في","رُزئِهِ هَدَّتِ الجِبالا",99,"ل",2,0],["لَآلئُ عَيني عقدُها مُتَناثِرٌ","وَإِن كانَ لا يشفي البُكاءُ عَليلا",100,"ل",2,0],["لا لحنه عازف ولا وتره","ما كان طيّ النشيد ينتظرُهْ",101,"ر",2,1],["لا لَيْتَ شِعْرِي والخُطُوبُ كَثِيرَةٌ","مَتى رَحْلُ قَيْسٍ مَسْتَقِلٌّ فَراجعُ",102,"ع",1,1],["لا لاجئينَ اليومَ بل","قولوا لهم: يا عائدين",103,"ن",1,0],["لا لعمري، ليست مَلاكًا؛ ولكن","هي أنثى قويةُ الإيمان",104,"ن",1,0],["لا، لَعَمْري، فما أسامَةُ إلا","كاذب حين يَدَّعي إقدامه",105,"م",2,0],["لا، لعمري، ما كل عيشٍ نسيمٌ","إنما الريحُ: زَعْزَعُ، وَرُخَاءُ",106,"ا",2,0],["لا لم أمت جدا ، أما رايتي","خفّاقة ، فوق ظهور الفرار !",107,"ر",1,0],["لا ، لم يغب عن بالها ،إنه","كان لها جارا عطوفا وصول",108,"ل",1,0],["لا : لم يكن : إنّي أرى قلبه","في عينه كالشّره الواجف",109,"ف",1,0],["لا لست لئيما يؤسفني","أن يهنا غيري في مأمن",110,"ن",1,0],["لا ، لا فيه جبن امرأة","وأنا لو أخنقها أجبن",110,"ن",1,0],["لا ، لو يلم شعب ... يحرّق صدره","جرح على لهب العذاب مسّهد",111,"د",1,0],["لا ! لم ينم شعري ! ولم يصمت ولم","تصمت على أوتاره الأنغام",112,"م",1,0],["لا لا \" البدر \" لا \" الحسن \" السجّان يحكمنا","الحكم للشعب لا \" بدر \" ولا \" حسن \"",113,"ن",1,0],["لألْفَيْتَنِي في غَارَةٍ أُدَّعَى لَهَا","إلَيْكَ وَإمَّا رَاجِعاً أَنَا ثَائِرُ",114,"ر",1,0],["لا لن تفرقنا الحدود ولم تكن","تدري الحواجز اخوة جيران",115,"ن",1,0],["لالا . أنا مخلوق مبدع . مايحب ومايبي","ألاّ يقول أن الاذكيا سبّة رسوب الاغبيا",116,"ي",2,0],["لألفيتني بالوُدِّ بعدكَ دائماً","على عهدنا إذْ نحنُ لم نتفرّقِ",117,"ق",1,0],["لا لثمَ ثغرٍ ولا محاورة ً","يُحلى به من هواه قد عبدك",118,"ك",1,0],["لا لا أخافُكَ إن عدلَكَ مَأْمني","مما أخاف وصامنٌ تحصيني",119,"ن",2,0],["لا ، لا أنام ولا أذوق كرى ،","أنا لست من يحيا لفجر غد",120,"د",1,0],["لا ، لم يحسّ ارتواء ، أو يجد ظمأ","أو يبتهج ، إن غدت أحلامه منحا",121,"ح",2,0],["لآل الحبيب حماة الغريب","شموس الوجود بدور السعود",122,"د",1,1],["لآل محمد جاه عريض","ومجد جاز عن درك العقول",123,"ل",1,1],["لآل النبي أنجال حيدرة الوغى","بني البضعة الزهرا مقام علا العليا",124,"ي",2,1],["لألأ الكون من ضيا نورك ال","محض وخاف الأكوان جذوة نارك",125,"ك",1,0],["لا لعاً للذي كبابي في الحب","وأهلاً بحبي المستجد",126,"د",1,0],["لآلٍ على هند الفطين يرى لها","بدور الليالي البيض للشمس واضحا",127,"ح",2,0],["لأَلغيت العقاب ولم","أَدع للنفي إِمكانا",128,"ن",2,0],["لأَلفٌ مضَى من بعدها مائة خَلَتْ","وأربعةُ الأعوام والعشرُ في العددْ",129,"د",1,0],["لاَ لاَ ولاَ شَنبَا تُجَاذِبُ مِزهَراً","يُحيِى رَسِيسَ الهَمِّ والأَوجَالِ",130,"ل",1,0],["لِآلِ مُحَمّدٍ راعٍ حَفيظٌ","وِدادُ الصَدرِ مِنّي وَالضَميرُ",131,"ر",1,0],["لا للقدود ولا للأعين السودِ","يصبو فؤادي ولا يهتزّ للغيدِ",132,"د",1,1],["لآلىءُ من بحر الفضائلِ إن بدت","لغائِصها صلَّى عليها وسلَّما",133,"م",2,0],["لا لَومَ يَلزَمُها إِذا قَصَرَت خُطىً","مِن فَرطِ ما حَمَلَت مِنَ الأَثقالِ",134,"ل",1,0],["لآلُىء دَمعي فيكَ ينشرُها الأسى","تَخافُ النَّوى طَوراً وتَرتِقَبُ الوَصلا",135,"ل",2,0],["لآلىءُ أَسلاكٍ أَزاهِرُ رَوضَةٍ","فَهاهيَ تُجنى بِالخَواطِرِ أَو تُجلى",136,"ل",2,0],["لا لومَ إن لبست عليه مسوحها","جزعاً تصانيفٌ له ثم الخُطب",137,"ب",1,0],["لآل معيبدٍ بعليّ فخراً","لهم فيه من العلياءِ ريفُ",138,"ف",1,0],["لآلة الحرب فضل قد أباح لمن","بها يلاعب أخذ المال للغب",139,"ب",1,0],["لا لَعمر الَّذي تَمَسَّكتُ مِنهُ","بِرَجاءٍ لا يَعتَفيهِ القُنوطُ",140,"ط",1,0],["لا لِكاسٍ وَلا لِآسٍ وَلا قُف","فازِ بازٍ وَلا لِضَمِّ خِرادِ",141,"د",1,0],["لالسْتُ بَكّاءً","مِمّا جَرى أو كانْ",142,"ن",1,0],["لأَلْقَى من الإسكندرية نَشْوةً","أَغُضُّ بها ما بين جنبىَّ من وَقْد",143,"د",1,0],["لا لصون فيه إلا","أنّني أفرقُ منهُ",144,"ن",2,0],["لا لعمري ما يصنع السيف في المه","جة ما تصنع الجفون المراض",145,"ض",1,0],["لا للبلاد نزلت كي تبتزَّها","ابناءَها وتقول قوموا واقعدوا",146,"د",3,0],["لال شبان شاد بيتا من العلا","رفيع الذرى ليس السماك يطاوله",147,"ل",2,0],["لا لن أبوح بحبي لن أبوح به","إني لأنبت من أركان ثهلان",148,"ن",1,0],["لا لا أبوح بحب بث","نة إنها اخذت عليّ",149,"ي",1,0],["لا لِقَومٍ وَلا لِدين","أَنتَ لِلنّاسِ أَجمَعين",150,"ن",1,1],["لِأُلي الشقاء قَصيرةً","وَطَويلَة لأُلي القُصور",151,"ر",1,0],["لالهمتني السر لما نظرت","إلي بهذا الفتور الشفوف",152,"ف",1,0],["لأُلزِم حُبَّكُمْ قلبي","وأَجعل حالَكم حالي",153,"ل",2,0],["لألزمه العصا يمشي عليها","وعلمه القران على القبور",154,"ر",1,0],["لألسنة الأقلام أعذب منطقٍ","تهنّيك بالأفراح والأنس يا يحيى",155,"ي",2,1],["لآلِ أَبِي حَفْصٍ وَسائِلُ نُصْرَةٍ","إلَى الدِّينِ وَالدنْيا هيَ النّسْبَةُ الدُّنْيَا",156,"ي",2,0],["لأَلْسِنَةِ النِّيرَانِ فيها بَلاغَةٌ","وَإنْ هِيَ لَمْ تَفْهَمْ حُروفاً وَلا نُطْقَا",157,"ق",2,0],["لا لا فاني في اعتصام زائد","بحبال ودكم الخلي من المرا",158,"ر",2,0],["لا لا وما كل الزمان بواحد","أحيى النفوس بعرفه يوم سعيد",159,"د",1,0],["لآليء لكنّ حبّاتها","تجف على حر أنفاسيه",160,"ي",2,0],["لا لن أعود إلى هواك مسامحاً","فالعمرُ ضاع ومن عزوفك مُمْحِلُ",161,"ل",1,0],["لا للإثابةِ ثمّ أُنهي إثرها","إنّ التخلّفَ واقعٌ لعوائقِ",162,"ق",1,0],["لآلِ حسينٍ صبغةُ الطوعِ والرضا","منَ اللّه ليطَ بالقلوبِ جسيدها",163,"د",3,0],["لا للشجاعة يقدمون وإنما","في غير حرب يقدم الجبناءُ",164,"ا",2,0],["لا لِشَيءٍ كانَ مِنّي قَبلَ ذا","غَيرَ فَخري بِضِياءِ الفَرقَدَين",165,"ن",1,0],["لا لون للفجر إنْ لم تشرقا معهُ","سِحْراً تَضُجّ به الساحات والطُّرُقُ",166,"ق",1,0],["لا لعجز وَخفض قَدر وَلكن","أَحلم الناس أَرفع الناس قَدرا",167,"ر",2,0],["لا لا وأَخافُ أنّها تَحْتَرِقُ","من حَرِّ فؤادي فتَزيدُ الحُرَقُ",168,"ق",1,0],["لا لَومَ بالإغرابِ في مَرعَى المُنى","عندي على جِنْسٍ من الأجناس",169,"س",1,0],["لا لَفظَةٌ لانَت أَتَيتَ بِها وَلا","عَتباً أَتَيتَ بِهِ وَلا ميعادا",170,"د",2,0],["لا لَومَ في الحُكمِ عَلى حاكِمٍ","وَالأَصلُ في الحُكمِ عَلى الظاهِرِ",171,"ر",1,0],["لا لُمتُهُم في لَومِهِم فَهُمُ","أَحبابُنا وَعداةُ ما جَهِلوا",172,"ل",3,0],["لا لِما تَجري يَداهُ","بيَدِ الجُودِ يَدانِ",173,"ن",1,0],["لا لَومَ أَن مَنع السُكو","ن فَمِن أَحَب ممنعُ",174,"ع",1,0],["لِآلِ محمدٍ أَصبَحتُ عَبداً","وَآلُ محمدٍ خيرُ البَرِيَّه",175,"ه",1,1],["لآل البيت أرسلت القوافي","تزفُّ لهم فؤاداً مستهاما",176,"م",2,0],["لا لفراق غادة","تُرِيك ثغراً أشنبا",177,"ب",2,0],["لَأَلقى امرءاً خِلُّ المَكارِمِ وَالنَدى","وَحَسبيَ في خَيرِ امرىءٍ حينَ يَذكُرُ",178,"ر",1,0],["لآلِ المصطفى عِلْمُ وجودٌ","يحوزُهما مَجيدٌ أو نَجيبُ",179,"ب",1,1],["لالثم ذيله وتقر عيني","كما قد سر أذاني السماعُ",180,"ع",1,0],["لآل شهاب في نصر بشير","وللاعداء وافى كالنذيرِ",181,"ر",1,0],["لا لقيتُ العيونَ من حَلَقِ الشَّيْ","بِ بدرعٍ وإِن رَمَتْ بِنِبالِ",182,"ل",1,0],["لآلئ لو كانت نجوماً لغادرَتْ","لياليُّها والصبحُ ما لاحَ ينجَلي",183,"ل",2,0],["لآلا فاستفق من شرب كأس جهالة","ودونك كأس العلم فانهله مشربا",184,"ب",2,0],["لآل عمير بعد أبي حسين","من الوافي بعهد الالتزام",185,"م",1,0],["لا لذة في الكون تحكيها وإن","لم تقترن أفعالها بشهود",186,"د",1,0],["لألي الالباب اصناف الكنب","طرزت بل قلدت بل نورت",187,"ت",1,0],["لآليء بسطتْ منها لنا غُرَرٌ","جرى بها من يواقيتٍ أساريرُ",188,"ر",1,0],["لا لنوازِي كبدٍ هاجها","بالبان من خنساءَ تَذكارُ",189,"ر",1,1],["لا لاقطٌ فيها ولا خاضبٌ","والشَّيبُ ملقوطٌ ومخضوبُ",190,"ب",1,0],["لألفته إلفَ الصبا فسلبتهُ","سلبَ المحبِّ دُمى الحسان الغيد",191,"د",1,0],["لا لداء لكنه عم وجداً","لم يدع غير هائم مشتاق",192,"ق",1,0],["لا لوم في كلفي باه","يفَ مخطف الأعطاف لينِ",193,"ن",1,0],["لألهاهم فرطُ البكاءِ عن الهوى","وحسبك من دمعٍ يبوح ويكتم",194,"م",1,0],["لآلِ جَميلَة قَد أَخلقَت","وَمَهما يَطُل عَهدُهُ يُخلِق",195,"ق",1,0],["لآل عثمان في أعناقنا منن","حق اليهم نؤديه كما يجب",196,"ب",1,0],["لا لوم للعشاق إن قهر الهوى","فنما الغرام بهم وصاح وباح",197,"ح",1,0],["لآل فريغون في المكرمات","يد أوَّلاً واعتذاراً أخيرا",198,"ر",2,0],["لآل طه والوصيّ المرتضى","أبا عليّ ارعني سمع الرضى",199,"ض",2,0],["لا لا أزفك إلا كفؤ مكرمة","ولا أبيعك حتى ينفق السوق",200,"ق",1,0],["لألأت في عين يافوخ العلى","لأساطين الحمى حكمتنا",201,"ن",2,0],["لآلِ جُبَيرٍ فيكَ أيُّ فَجيعَةٍ","فَمَا مِنهُم مَن يَستَفِيقُ مِن الكَربِ",202,"ب",1,0],["لا لاَ فما أنا مُطِيقٌ له لَو","اَفنيتُ في مَدحكَ شعرِي المُونَقِ",203,"ق",1,0],["لا لذّةٌ لِيَ في غير الجميلِ ولا","في غيرِ أوديةِ المعروفِ أفراحي",204,"ح",2,0],["لآلئُ لُجَّةٍ بِيضٌ عليها","رجالُ الحيِّ غارت والنِساءُ",205,"ا",2,0],["لِآلِ الفاضِلِ الفُضَلاء أَيدٍ","شُدِدنَ عَلى عُرى المَجدِ الصَميمِ",206,"م",1,0],["لِآلِ الكَورِ كَورٌ في المَعالي","يَدُلُّ عَلَيهِ إِقرارُ الحَسودِ",207,"د",1,0],["لِآلِ هِندٍ بِجَنبَي نَفنَفٍ دارُ","لَم يَمحُ جِدَّتَها ريحٌ وَأَمطارُ",208,"ر",1,1],["لآلئُ دمعي من لآلئَ ثغْرها","ففي وَقْتِ لثْمي كُنْتُ منهُ سرقتُها",209,"ت",3,0],["لألتَمسن يميناً قبل ذاك جَعَلتُها","إذا ما أنا شاهدتُ يوم ذِمارِ",210,"ر",1,0],["لِآَلِ الشَريدِ إِذ اَصابوا لِقاحَنا","بِبَيضانَ وَالمَعروف يحمَدُ فاعِلُه",211,"ل",2,0],["لِإِلدِكَ أَصحابي فَلا تَزدَهيهِمُ","بِسايَةَ إِذ مَدَّت عَلَيكَ الحَلائِبُ",212,"ب",1,1]]}