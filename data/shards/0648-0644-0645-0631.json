{"poems":[[55,"لا لوم للدهر ولا عتابا","https://www.aldiwan.net/poem30736.html","الرجز"],[51,"هل على نفسه امرؤ محزون","https://www.aldiwan.net/poem63134.html","الخفيف"],[147,"لا زال ملكك بالعلى مأهولا","https://www.aldiwan.net/poem11789.html","الكامل"],[201,"طرقتني فجر يوم المولد","https://www.aldiwan.net/poem39890.html","الرمل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77545","الخفيف"],[5183,"الفتوح","https://www.poetsgate.com/ViewPoem.aspx?id=186380",""],[5725,"خمرية طيبة","https://www.poetsgate.com/ViewPoem.aspx?id=177436",""],[240,"يا قاصداً بغداذَ جُزْ عن بلدة ٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26483&r=&rc=8",""]],"verses":[["وَلِم رَبَطتُ الشُزَّبَ العِرابا","يَمرينَ بِالشَكائِمِ اللُعابا",0,"ب",2,0],["وَلِمَرِّ الفَناءِ في كُلِّ يَومٍ","حَرَكاتٌ كَأَنَّهُنَّ سُكونُ",1,"ن",1,0],["وَلِمُرهَفاتِكَ بِالفُنَيدِقِ وَقعَةٌ","مَلَأَت مَسامِعَ مَن بِمِصرَ صَليلا",2,"ل",2,0],["ولمرآى غادة نشوى صغيره","وهي تسقيه وكم قالت زد",3,"د",1,0],["وَلمرآةِ دارها","إِن رَنت عَينُها هَمَت",4,"ت",1,0],["ولمريم العذراء حسن قبولها","من ربها ولشبلها ومكانه",5,"ن",2,0],["ولمرّغوا حُسْنٓ الوجوه بتربةٍ","من طيبةٍ تُجلى بها الاتراحُ",6,"ح",1,0],["وَکلمَرْءُ يُسْلِمُهُ أَبُوهُ وَعِرْسُهُ","ويَخونُهُ القُرباءُ والأصحابُ",7,"ب",1,0]]}