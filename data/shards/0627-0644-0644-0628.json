{"poems":[[55,"قل للهوامل في الدنا ما بالكم","https://www.aldiwan.net/poem30160.html","الكامل"],[47,"أقصرا ليس شأني الإقصار","https://www.aldiwan.net/poem63558.html","الخفيف"],[107,"نهضت من كل أوب تلتقي","https://www.aldiwan.net/poem44200.html","الرمل"],[48,"اللب قطب والأمور له رحى","https://www.aldiwan.net/poem22570.html","الكامل"],[48,"اللُّبُّ قُطبٌ، والأمورُ له رَحًى،","https://www.poetsgate.com/ViewPoem.aspx?id=20118",""],[521,"اللبين يا ليلى جمالك ترحل","https://www.aldiwan.net/poem48641.html","الطويل"],[558,"ذهلت فلم أنقع غليلا بعبرة","https://www.aldiwan.net/poem68231.html","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119981","الخفيف"],[2096,"","https://poetry.dctabudhabi.ae/diwan/poem/144616","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65970","الطويل"],[4679,"ما درت مثل عيدك الأعيادُ","https://www.poetsgate.com/ViewPoem.aspx?id=142749",""],[5431,"حول معضلة الشر ...","https://www.poetsgate.com/ViewPoem.aspx?id=210553",""],[5854,"أَ لِلْبَيْنِ أَرْخَصْتَ الدُّمُوعَ الْغَوَالِيَا؟ ((مرثية طول الأمل))","https://www.poetsgate.com/ViewPoem.aspx?id=191655",""]],"verses":[["اللَبثُ لَمحٌ وَالمُناخُ مُحَفَّرٌ","وَالرَعيُ خَطفٌ وَالوُرودُ لَماظُ",0,"ظ",1,0],["اللُبابُ اللُبابُ يَنميكَ مِنها","لِذُرى المَجدِ وَالنُضارُ النُضارُ",1,"ر",1,0],["اللُّبابِ المحضِ من رُسلِ الهدى","منذ كانوا والصَّميمِ المُعرقِ",2,"ق",1,0],["اللُبُّ قُطبٌ وَالأُمورُ لَهُ رَحىً","فَبِهِ تُدَبَّرُ كُلُّها وَتُدارُ",3,"ر",1,1],["اللُّبُّ قُطبٌ، والأمورُ له رَحًى","، فيهِ تُدَبَّرُ كلُّها وتُدارُ",4,"ر",1,1],["اللَبين يا لَيلى جَمالك تُرحل","لِيَقطَع مِنّا البَين ما كانَ يؤصل",5,"ل",1,1],["أَلِلبَأسِ أَم لِلجودِ أَم لِمُقاوِمٍ","مِنَ المُلكِ يَزحَمنَ الجِبالَ الرَواسِيا",6,"ي",2,0],["اللبب الأريب والمخلف المت","الف والماجد الكريم النصابِ",7,"ب",1,0],["أللبارق العلوي أنت طروب","ألا كل نجدي إليّ حبيب",8,"ب",1,1],["أللبدر جعد أم على البدر مطرف","أم الكواكب الدري خال مقرطف",9,"ف",1,1],["\"آل \"\"لبنان\"\" عن هوى الملك\"","ما انفكوا وعن شرع حبه ماحادوا",10,"د",3,0],["_ أللبرية أن تختار عالمها؟!!!","فكيف لله علم فيه مكتمل!!",11,"ل",1,0],["أَ لِلْبَيْنِ أَرْخَصْتَ الدُّمُوعَ الْغَوَالِيَا؟","فَأبْدَيتَ لِلْعُذّالِ مَا كَانَ خَافِيَا!",12,"ي",2,1]]}