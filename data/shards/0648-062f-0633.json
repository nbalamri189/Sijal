{"poems":[[65,"بَدَتْ عَقِداتُ الرّمْلِ والجَرَعُ العُفْرُ","https://www.aldiwan.net/poem46213.html","الطويل"],[79,"أعشاق غير الواحد الأحد الباقي","https://www.aldiwan.net/poem35913.html","الطويل"],[90,"أقوى مصيف القوم والمربع","https://www.aldiwan.net/poem45066.html","السريع"],[45,"أنا لائمي إن كنت وقت اللوائم","https://www.aldiwan.net/poem10544.html","الطويل"],[46,"لأي حبيب يحسن الرأي والود","https://www.aldiwan.net/poem30617.html","الطويل"],[54,"أيا وادي الأحباب سقيت واديا","https://www.aldiwan.net/poem26567.html","الطويل"],[52,"أعاذل قد نهيت فما انتهيت","https://www.aldiwan.net/poem64749.html","الوافر"],[8,"سما لك هم ولم تطرب","https://www.aldiwan.net/poem21770.html","المتقارب"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21117","الوافر"],[102,"الطريق الهادر","https://www.poetsgate.com/ViewPoem.aspx?id=50202",""],[170,"إذا كان من عزمي التقدم في العلا","https://www.aldiwan.net/poem47133.html","الطويل"],[240,"حياك الربيع من فصاح أعاجم","https://www.aldiwan.net/poem31748.html","الطويل"],[445,"حسبي رضاك من الدهر الذي عتبا","https://www.aldiwan.net/poem34821.html","البسيط"],[445,"وفيهن أضحيت يوم الأضاحي","https://www.aldiwan.net/poem34845.html","المتقارب"],[463,"تركتك يا زمان قلى فدعني","https://www.aldiwan.net/poem55826.html","الوافر"],[469,"سرت زينب والبرق مبتسم الثغر","https://www.aldiwan.net/poem3392.html","عموديه"],[471,"خلا الفيض مما حله فالخمائل","https://www.aldiwan.net/poem50381.html","الطويل"],[491,"أتعرف رسماً كالرداء المحبر","https://www.aldiwan.net/poem483.html",""],[566,"تالله لولا أن تحش الطبح","https://www.aldiwan.net/poem27864.html","الرجز"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117645","الطويل"],[2165,"","https://poetry.dctabudhabi.ae/diwan/poem/20460","الطويل"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199825","المسحوب"],[3038,"","https://poetry.dctabudhabi.ae/diwan/poem/124276","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100729","الطويل"],[3135,"","https://poetry.dctabudhabi.ae/diwan/poem/105699","الطويل"],[3369,"","https://poetry.dctabudhabi.ae/diwan/poem/117029","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109945","الطويل"],[3737,"","https://poetry.dctabudhabi.ae/diwan/poem/138915",""],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/198880","الطويل"],[4483,"","https://poetry.dctabudhabi.ae/diwan/poem/101294","المنسرح"],[4764,"طفل حبي","https://www.poetsgate.com/ViewPoem.aspx?id=28155",""],[4782,"أنا ... والشعر","https://www.poetsgate.com/ViewPoem.aspx?id=207550",""],[4858,"تغير صديق","https://www.poetsgate.com/ViewPoem.aspx?id=35296",""],[4988,"فيض الاحساس","https://www.poetsgate.com/ViewPoem.aspx?id=187412",""],[5397,"أفق من رقدة الآمال جفن","https://www.poetsgate.com/ViewPoem.aspx?id=157927",""]],"verses":[["ودُسْنا بأخْفافِ المَطيِّ بِها ثَرًى","يَنُمُّ على مَسْرى الغَواني بهِ العِطْرُ",0,"ر",1,0],["ودُسّوا لَها المعْنَى رُوَيْداً وأيْقِظوا","بَصيرتَها منْ بعْدِ نوْمٍ وإغْراقِ",1,"ق",1,0],["ودُسّ حيث الأرض أمست له","ملحودة ضاق بها المضجع",2,"ع",1,0],["وَدُسنا بِأَخفافِ المَطِيِّ تُرابَها","فَلا زِلتُ أَستَشفي بِلَثمِ المَناسِمِ",3,"م",1,0],["وَدُسنا بِأَيدي العيسِ لَيلاً كَأَنَّما","تَشابَهَ في ظَلمائِهِ الشيبُ وَالمَردُ",4,"د",1,0],["وَدُسناهُمُ بِالضَربِ وَالطَعنِ دَوسَةً","أَماتَت حُقوداً ثُمَّ أَحيَت مَعالِيا",5,"ي",2,0],["وَدَسَّت في الكِتابِ إِلَيَّ إِنّي","وَقَيتُكَ لَو أَرى خَلَلاً مَضَيتُ",6,"ت",1,0],["وَدَسكَرةٍ صَوتُ أَبَوابِها","كَصوتِ المَواتِحِ بِالجَوأَبِ",7,"ب",1,0],["ودسّهم عليه في قريش","وعونهم عليه كلّ جيش",8,"ش",1,0],["وَدَسَّت في صَحيفَتها إلَيه","ليَملكَ بِضعَها ولأَن تَدينا",9,"ن",2,0],["ودَسَّ لَهَا عَلَى الأَنقَاءِ عَمراً","بِشِكَّتِه وما خَشِيَت كَمينا",9,"ن",2,0],["ودسنا إليه عيون الخطوب","وأهدابها كشفار المدى",10,"د",2,0],["ودستُ جبالاً كدْنَ يعطبْنَ مُهجتي","بما ندفت فيها الثلوج من العطْب",11,"ب",1,0],["وَدَسّوا لَكُم تَحتَ التُرابِ مَكائِداً","فَلَم يَظفَروا إِلّا بَعَدِّ الأَباهِمِ",12,"م",1,0],["ودَسَّسُوا لِيَ فِي مَثْنى حبائِلِهِمْ","شنعاءَ بِتُّ بِهَا حَرَّانَ مُكْتَئِبا",13,"ب",2,0],["ودُسْتَ بِهَا كلَّ صعبِ المرامِ","وقُدْتَ بِهَا كلَّ عاصِي القِيادِ",14,"د",1,0],["ودست الجمر لم أخَفِ احتراقا","وراء الرزق وهو يشِطُّ عنّي",15,"ن",2,0],["ودسنا بهم خدَّ الثرى من جيادنا","لها السمر أرواقٌ بغزلانها العفر",16,"ر",1,0],["وَدَسَّت رَسولاً أَنَّ حَولِيَ عُصبَةٌ","هُمُ الحَربُ فَاِستَبطِن سِلاحَ المُقاتِلِ",17,"ل",1,0],["وَدُسناهُمُ بِالخَيلِ وَالبيضِ وَالقَنا","وَضَربٍ يَفُضُّ الهامَ في كُلِّ مِغفَرِ",18,"ر",1,0],["وَدُستُهُم كَما يُداسُ الفَرفَخُ","يُؤكَلُ مَرّاتٍ وَمَرّاً يُشدَخُ",19,"خ",1,0],["ودسكرةٍ فيها من الشربِ عصبةٌ","لهم مذهبٌ فيه تباحُ المحارمُ",20,"م",1,1],["وَدَسَّت رَسولاً مِن بَعيدٍ بِآيَةٍ","بِأَنَّ حَيِّهم وَاِسأَلهُم ما تَمولوا",21,"ل",3,0],["ودستونيه دوس التّياري","واثر التّجبّر منكم أنقام",22,"م",1,0],["ودس إلى مستودع السر منهم","حديثا غريب الشكل غير فضول",23,"ل",1,0],["ودست هوادي المالكين وهامهم","بصافنةٍ خُزرِ ومقربةٍ قُبل",24,"ل",1,0],["ودست عليه كاظم الغيظ قد رقى","لقد طاول الأفلاك حين أحتبي فيه",25,"ي",2,0],["ودست بساط النور والنور ساطع","وأعطيت من فخر النبوة رفرف",26,"ف",1,0],["ودُستَ بحُبِّ اللَهِ مَعصَرة الرَدَى","وحيداً ولم تُشرِك فكُنتَ مُوَحِّدا",27,"د",2,0],["ودس سماً نقيعاً قد أصاب به","فؤاده يا فداه العرب والعجم",28,"م",1,0],["ودستورنا القرآن في كل وجهة","ولا خير فيمن عن تعاليمه صدوا",29,"د",3,0],["ودست كتف النبي أنت ومن","باريت فيه حضيرة القدس",30,"س",1,0],["ودَس السمِ في نَزفٍ يلوثني بِعتم الكون","وروحي تِنثني بِينه وشطره موطني الحصري",31,"ر",2,0],["ودُسَّ البوحَ في غابات روحي","أهازيجًا تراقصها الطيوف",32,"ف",1,0],["ودُستَ الورودَ وكُلّ العهودِ","وعفتَ الشّذا ونسيمَ السَّحَر!",33,"ر",1,0],["ودستور يا حظرة هل الطيب دستور","امعزّب الوافين لا شك وافي",34,"ف",2,0],["ودس له بصفو العيش سما","به ثمر الردى المحتوم يجنى",35,"ن",2,0]]}