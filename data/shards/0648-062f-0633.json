{"poems":[[63,"بَدَتْ عَقِداتُ الرّمْلِ والجَرَعُ العُفْرُ","https://www.aldiwan.net/poem46213.html","الطويل"],[77,"أعشاق غير الواحد الأحد الباقي","https://www.aldiwan.net/poem35913.html","الطويل"],[88,"أقوى مصيف القوم والمربع","https://www.aldiwan.net/poem45066.html","السريع"],[43,"أنا لائمي إن كنت وقت اللوائم","https://www.aldiwan.net/poem10544.html","الطويل"],[44,"لأي حبيب يحسن الرأي والود","https://www.aldiwan.net/poem30617.html","الطويل"],[52,"أيا وادي الأحباب سقيت واديا","https://www.aldiwan.net/poem26567.html","الطويل"],[50,"أعاذل قد نهيت فما انتهيت","https://www.aldiwan.net/poem64749.html","الوافر"],[8,"سما لك هم ولم تطرب","https://www.aldiwan.net/poem21770.html","المتقارب"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21117","الوافر"],[100,"الطريق الهادر","https://www.poetsgate.com/ViewPoem.aspx?id=50202",""],[166,"إذا كان من عزمي التقدم في العلا","https://www.aldiwan.net/poem47133.html","الطويل"],[235,"حياك الربيع من فصاح أعاجم","https://www.aldiwan.net/poem31748.html","الطويل"],[439,"حسبي رضاك من الدهر الذي عتبا","https://www.aldiwan.net/poem34821.html","البسيط"],[439,"وفيهن أضحيت يوم الأضاحي","https://www.aldiwan.net/poem34845.html","المتقارب"],[458,"تركتك يا زمان قلى فدعني","https://www.aldiwan.net/poem55826.html","الوافر"],[464,"سرت زينب والبرق مبتسم الثغر","https://www.aldiwan.net/poem3392.html","عموديه"],[466,"خلا الفيض مما حله فالخمائل","https://www.aldiwan.net/poem50381.html","الطويل"],[486,"أتعرف رسماً كالرداء المحبر","https://www.aldiwan.net/poem483.html",""],[561,"تالله لولا أن تحش الطبح","https://www.aldiwan.net/poem27864.html","الرجز"]],"verses":[["ودُسْنا بأخْفافِ المَطيِّ بِها ثَرًى","يَنُمُّ على مَسْرى الغَواني بهِ العِطْرُ",0,"ر",1,0],["ودُسّوا لَها المعْنَى رُوَيْداً وأيْقِظوا","بَصيرتَها منْ بعْدِ نوْمٍ وإغْراقِ",1,"ق",1,0],["ودُسّ حيث الأرض أمست له","ملحودة ضاق بها المضجع",2,"ع",1,0],["وَدُسنا بِأَخفافِ المَطِيِّ تُرابَها","فَلا زِلتُ أَستَشفي بِلَثمِ المَناسِمِ",3,"م",1,0],["وَدُسنا بِأَيدي العيسِ لَيلاً كَأَنَّما","تَشابَهَ في ظَلمائِهِ الشيبُ وَالمَردُ",4,"د",1,0],["وَدُسناهُمُ بِالضَربِ وَالطَعنِ دَوسَةً","أَماتَت حُقوداً ثُمَّ أَحيَت مَعالِيا",5,"ي",2,0],["وَدَسَّت في الكِتابِ إِلَيَّ إِنّي","وَقَيتُكَ لَو أَرى خَلَلاً مَضَيتُ",6,"ت",1,0],["وَدَسكَرةٍ صَوتُ أَبَوابِها","كَصوتِ المَواتِحِ بِالجَوأَبِ",7,"ب",1,0],["ودسّهم عليه في قريش","وعونهم عليه كلّ جيش",8,"ش",1,0],["وَدَسَّت في صَحيفَتها إلَيه","ليَملكَ بِضعَها ولأَن تَدينا",9,"ن",2,0],["ودَسَّ لَهَا عَلَى الأَنقَاءِ عَمراً","بِشِكَّتِه وما خَشِيَت كَمينا",9,"ن",2,0],["ودسنا إليه عيون الخطوب","وأهدابها كشفار المدى",10,"د",2,0],["ودستُ جبالاً كدْنَ يعطبْنَ مُهجتي","بما ندفت فيها الثلوج من العطْب",11,"ب",1,0],["وَدَسّوا لَكُم تَحتَ التُرابِ مَكائِداً","فَلَم يَظفَروا إِلّا بَعَدِّ الأَباهِمِ",12,"م",1,0],["ودَسَّسُوا لِيَ فِي مَثْنى حبائِلِهِمْ","شنعاءَ بِتُّ بِهَا حَرَّانَ مُكْتَئِبا",13,"ب",2,0],["ودُسْتَ بِهَا كلَّ صعبِ المرامِ","وقُدْتَ بِهَا كلَّ عاصِي القِيادِ",14,"د",1,0],["ودست الجمر لم أخَفِ احتراقا","وراء الرزق وهو يشِطُّ عنّي",15,"ي",1,0],["ودسنا بهم خدَّ الثرى من جيادنا","لها السمر أرواقٌ بغزلانها العفر",16,"ر",1,0],["وَدَسَّت رَسولاً أَنَّ حَولِيَ عُصبَةٌ","هُمُ الحَربُ فَاِستَبطِن سِلاحَ المُقاتِلِ",17,"ل",1,0],["وَدُسناهُمُ بِالخَيلِ وَالبيضِ وَالقَنا","وَضَربٍ يَفُضُّ الهامَ في كُلِّ مِغفَرِ",18,"ر",1,0],["وَدُستُهُم كَما يُداسُ الفَرفَخُ","يُؤكَلُ مَرّاتٍ وَمَرّاً يُشدَخُ",19,"خ",1,0]]}