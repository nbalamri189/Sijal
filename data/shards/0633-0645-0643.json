{"poems":[[63,"قل لجار الشط ما هذا الوسخ","https://www.aldiwan.net/poem51371.html","الرمل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[228,"أترى جاءت لكي تصطاد","https://www.aldiwan.net/poem41904.html","مجزوء الرمل"],[327,"ألا طال التنظر والثواء","https://www.aldiwan.net/poem56353.html","الوافر"],[519,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130629","المديد"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132887","الكامل"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121340","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40158","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111505","الرجز"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97092","الكامل"],[5183,"السِّمَات","https://www.poetsgate.com/ViewPoem.aspx?id=186460",""],[5956,"عِشْ مَعَ النباتِ والجمادِ","https://www.poetsgate.com/ViewPoem.aspx?id=184145",""]],"verses":[["سمك يفلج من أبصره","وشراب يملأ البطن نفخ",0,"خ",1,0],["سمكٌ مقليٌّ وطيرٌ شويٌّ","ولذيذ من الشواءِ الطيور",1,"ر",1,0],["سَمكُ البَحرِ كَقَلبي","لَيسَ مَن قالَ لِماذا",2,"ذ",2,0],["سَمَكتَ لَهُم بِإِذنِ اللَهِ مُلكاً","كَما سُمِكَت عَلى الأَرضِ السَماءُ",3,"ا",2,0],["سمكَ العزُّ بها أبنيةً","أفصحُ الأعرابِ ما ضمّ بِناها",4,"ا",3,0],["سمكا للسعد منها سماء","وازالا عن سماها النحوسا",5,"س",2,0],["سمكَت كهمّتهِ السماءُ ومُثِّلت","فيها خلائقُه الشراف نُجُوما",6,"م",2,0],["سُمِكَت خيامُكُم بأسنمةِ الربى","مرفوعةً للطارق المنتاب",7,"ب",1,0],["سَمَكتَ المَدارِسَ فَوقَ النّجوم","فَكَم منْجمٍ تَحتَها قَد نَجَم",8,"م",1,0],["سمكه من فضةٍ لم تشب","قد سطرت دون وشيعٍ أشهب",9,"ب",1,0],["سمكوا سماك المجد واستبقوا له","فكأنما له العوادي سلم",10,"م",1,0],["سمك بالحمد مبارك السمات","واعلُ متن الجد تعلُ الكائنات",11,"ت",1,1],["سَمَكٌ كبير آكلٌ لصغيرِه","أفعى تصبّ على سواها السُّما",12,"م",2,0]]}