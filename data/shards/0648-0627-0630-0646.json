{"poems":[[77,"زارت ونجم الدجى يشكو من الأرق","https://www.aldiwan.net/poem35921.html","البسيط"],[86,"أوشك الديك أن يصيح ونفسي","https://www.aldiwan.net/poem10941.html","الخفيف"],[30,"ألا حي دارا قد أبان محيلها","https://www.aldiwan.net/poem29538.html","الطويل"],[30,"لقد خفق النسران والنجم بازل","https://www.aldiwan.net/poem29612.html","الطويل"],[88,"أرى الشعر أحياناً بجيش بخاطري","https://www.aldiwan.net/poem44455.html","الخفيف"],[88,"لقد بت مطروف النواظر بالسهد","https://www.aldiwan.net/poem45057.html","الطويل"],[27,"شعفت بعهد ذكرته المنازل","https://www.aldiwan.net/poem5966.html","الطويل"],[23,"لمن منزل عاف كأن رسومه","https://www.aldiwan.net/poem21242.html","الطويل"],[51,"أساء الرأي أم عزب الرسول","https://www.aldiwan.net/poem65999.html","الوافر"],[38,"تغير قومي ولا أسخر","https://www.aldiwan.net/poem7712.html","المتقارب"],[62,"يا ليلة السفح ألا عدت ثانية","https://www.aldiwan.net/poem52276.html","البسيط"],[28,"ينام الطريد بعدها نومة الضحى","https://www.aldiwan.net/poem5509.html","الطويل"],[66,"إني لفضلك بالمديح أجازي","https://www.aldiwan.net/poem38510.html","الكامل"],[80,"أبا هاشم هشمتني الشفار","https://www.aldiwan.net/poem31300.html","المتقارب"],[69,"بأيمن جرعاء الكثيب خيام","https://www.aldiwan.net/poem28765.html","الطويل"],[31,"ألم تسأل الأطلال والمتربعا","https://www.aldiwan.net/poem42466.html","الطويل"],[52,"شفعيني يا شر في رد نفسي","https://www.aldiwan.net/poem26780.html","الخفيف"],[75,"هل من أعقة عالج يبرين","https://www.aldiwan.net/poem69032.html","الكامل"],[50,"طربت إلى حوضى وأنت طروب","https://www.aldiwan.net/poem64859.html","الطويل"],[46,"سمعت نعيها صما صمام","https://www.aldiwan.net/poem23631.html","الكامل"],[19,"غني تآوى بأولادها","https://www.aldiwan.net/poem335.html",""],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20986","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42602","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54556","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54746","الطويل"],[106,"حي البيان","https://www.poetsgate.com/ViewPoem.aspx?id=179367",""],[100,"الحكم للشعب","https://www.poetsgate.com/ViewPoem.aspx?id=50179",""],[50,"طربتَ إلى \"حوضى \" وأنت طروبُ","https://www.poetsgate.com/ViewPoem.aspx?id=16891",""],[90,"عاشوراء","https://www.poetsgate.com/ViewPoem.aspx?id=179150",""],[90,"النجوى","https://www.poetsgate.com/ViewPoem.aspx?id=178987",""],[109,"ذهاب بلا اياب","https://www.poetsgate.com/ViewPoem.aspx?id=35293",""],[28,"إذا المرء لم يحقن دما لابن عمه","https://www.poetsgate.com/ViewPoem.aspx?id=22046",""],[30,"أَلا حَيِّ دَاراً قَدْ أَبَانَ مُحِيلُهَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=20509&r=&rc=3",""],[129,"وما لي تمن غير لقياك ساعة","https://www.aldiwan.net/poem50623.html","الطويل"],[161,"الفسح يطلب منكم الكرماني","https://www.aldiwan.net/poem59188.html","الكامل"],[178,"لعمري إني يوم بصرى وناقتي","https://www.aldiwan.net/poem4500.html","الطويل"],[226,"وهبتك يا دهر من تطلب","https://www.aldiwan.net/poem55095.html","المتقارب"],[226,"لك الإمارة والأقوام ما برحت","https://www.aldiwan.net/poem55199.html","البسيط"],[250,"تعنى القلب من سلمى عناء","https://www.aldiwan.net/poem2133.html","الوافر"],[305,"ما حل قلبي ولا سكن","https://www.aldiwan.net/poem16880.html","مخلع البسيط"],[329,"النور حولك مبهور السنا عجب","https://www.aldiwan.net/poem54985.html","البسيط"],[343,"أبا غازي ابا الفضل","https://www.aldiwan.net/poem55349.html","مجزوء الوافر"],[362,"لا تأمن الدهر ان الدهر خوان","https://www.aldiwan.net/poem68052.html","البسيط"],[364,"بالعفر دار من جميلة هيجت","https://www.aldiwan.net/poem1718.html","الطويل"],[365,"نصرت على الأعداء فليهنك النصر","https://www.aldiwan.net/poem60900.html","الطويل"],[365,"أأحبتي الشاكين طول تغيبي","https://www.aldiwan.net/poem60990.html","الطويل"],[378,"رأينا من عهودِكم","https://www.aldiwan.net/poem59203.html","مجزوء الوافر"],[384,"ألا حبذا عصر اللوى وزمانه","https://www.aldiwan.net/poem24188.html","الطويل"],[404,"ويدور الحق معه حيثما","https://www.aldiwan.net/poem33354.html","الرمل"],[415,"تذكرت حرب الروم لما تطاولت","https://www.aldiwan.net/poem4485.html","الطويل"],[417,"جد في وجده بكم فعلاما","https://www.aldiwan.net/poem53970.html","الخفيف"],[417,"سطا بحسام مقلته وصالا","https://www.aldiwan.net/poem54125.html","الوافر"],[440,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[453,"تراك المهل في حث الركاب","https://www.aldiwan.net/poem13648.html","الوافر"],[462,"نكبا صمتي وخافا صخبي","https://www.aldiwan.net/poem15144.html","الرمل"],[465,"امشنع أني جنحت إلى الكرى","https://www.aldiwan.net/poem3153.html","عموديه"],[471,"بت الخليط قوى الحبل الذي قطعوا","https://www.aldiwan.net/poem4744.html","البسيط"],[506,"القضيّة","https://www.aldiwan.net/poem27792.html","البسيط"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[587,"خذوا قودي من أسير الكلل","https://www.aldiwan.net/poem17697.html","المتقارب"]],"verses":[["وإذْ نَعِمْنا برَغْمِ الدّهْرِ فيهِ وقدْ","عضّ الأنامِلَ منْ غيْظٍ ومِنْ حنَقِ",0,"ق",1,0],["وَأَذَنِ الصُبحَ أَن يَلوحَ لِعَيني","مِن سَناها فَذاكَ وَقتُ التَحَسّي",1,"س",2,0],["وَإِذ نَحنُ أَسبابُ المَوَدَّةِ بَينَنا","دُماجٌ قُواها لَم يَخُنها وُصولُها",2,"ل",3,0],["وَأُذنٍ تُبينُ العِتقَ مِن حَيثُ رُكِّبَت","مُؤلَلَةٍ زَعراءَ جَيِّدَةِ النَصبِ",3,"ب",1,0],["وأذن لو اسصغيتها نحو كاتم","سمعت بها منه حديث قرونه",4,"ن",2,0],["وإذنّ في الحيّ المؤذَن غدوةً","فأيقظني التكبير من سنةٍ الرقد",5,"د",1,0],["وَإِذ نَحنُ أُلّافٌ لَدى كُلِّ مَنزِلٍ","وَلَمّا تُفَرَّق لِلطِياتِ الجَمائِلُ",6,"ل",1,0],["وَإِذ نَحنُ لَم يولَع بِنا الناسُ كُلُّهُم","وَما تَرتَجي صُرمَ الخَليطِ العَواذِلُ",6,"ل",1,0],["وَإِذ نَحنُ جيرانٌ كَثيرٌ بِغَبطَةٍ","وَإِذ ما مَضى مِن عَشِنا لَم يُصَرَّمِ",7,"م",1,0],["وإذنُ الوجهِ لا الحُجَّابِ إذنٌ","وفي الأحشاء لا الدارِ الدخولُ",8,"ل",1,0],["وَأُذنانِ حَشرٌ إِذا أُفزِعَت","شُرافِيَّتانِ إِذا تَنظُرُ",9,"ر",1,0],["وآذنتنا بقربِ الفجرِ واشيةٌ","باتتْ تُحرِّشُ بين الضَّالِ والسَّلمِ",10,"م",1,0],["وَإِذ نَحَّبَت كَلبٌ عَلى الناسِ أَيُّهُم","أَحَقُّ بِتاجِ الماجِدِ المُتَكَرِّمِ",11,"م",1,0],["وَأُذِنتُ أَن تَرويهِ عَنّي مالِكي","مَع كُلُّ ما تَعزوهُ نَحوي عازي",12,"ز",2,0],["وآذنت عُمّار القفار بحربهم","فيا قُرْبَ ما شَقّوا إليك الخضارما",13,"م",2,0],["وإذْ نسماتُ الوصلِ تحيي قلوبَنا","ونحنُ سهارى والوشاةُ نيامُ",14,"م",1,0],["وَإِذ نَحنُ مِثلُ الماءِ كانَ مِزاجُهُ","كَما صَفَّقَ الساقي الرَحيقَ المُشَعشَعا",15,"ع",2,0],["وَأذَني في الرُقادِ لي إِنَّ عَيني","تَستَعيرُ الرُقادَ مِن عَينَيكِ",16,"ك",1,0],["وَأْذَنْ له يُغْرِقْ أُمَيّةَ مُعْلِناً","ما كلُّ مأذونٍ له مأذون",17,"ن",1,0],["وَإِذ نَحنُ بِالأَدعاصِ أَمّا نَهارُنا","فَصَعبٌ وَأَمّا لَيلُنا فَرَكوبُ",18,"ب",1,0],["وَإِذ نَلتَقي خَلفَ العُيون كَأَنَّنا","سُلافُ عُقارٍ بِالنُقاخِ مَشوبُ",18,"ب",1,0],["وأذّنَتِ الجَنادِبُ في ضُحاها","أذَاناً غيرَ مُنْتَظَرِ الإمامِ",19,"م",1,0],["وَأُذنٌ لَها حَشرَةٌ مَشرَةٌ","كَإِعليطِ مَرخٍ إِذا ما صَفِر",20,"ر",1,0],["وإذ نَقَمتُ مِنَ الوَجناءِ جِبلَتَها","إذ خافَ منكَ وَلُّي الشَجوِ إدبارا",21,"ر",2,0],["وَإِذْ نَحْنُ فيما بَيْنَ إِخْوَانِ لَذَّةٍ","عَلَى شِيَمٍ مَا إِنْ بِهِنَّ نَكِيرُ",22,"ر",1,0],["وَإِذْ نَسْتَلِذُّ الْقَرَّ وَهْوَ كَرِيهَةٌ","وَإِذْ نَسْتَطِيبُ الْحَرَّ وَهْوَ مُذِيبُ",23,"ب",1,0],["وَإِذْناً فَإِنِّي اليَوْمَ أَقْضِي لِرَاحِلٍ","عَلَى مِصْرَ حَقّاً كَادَ يَبْلَى فَجُدِّدا",24,"د",2,0],["وإذنْ لَطِرْتُ إلى الفَضاءَ محلِّقًا","في لمح كوكبه، ورمش شهابه",25,"ب",2,0],["وأذّن الفجر من نيران مدفعه","والمعجزات شفاه والدنا أذن",26,"ن",1,0],["وإذْ نلتقي خلف العيون كأنَّنا","سلافُ عقارٍ بالنُّقاحِ مشوبُ",27,"ب",1,0],["وآذَنَ نورُ \" البيت \" عند برِحلة","وغاصَ النَدى منه فجفَّ وأقفرا",28,"ر",2,0],["وآذنَ بالصبحِ صوتُ الهَزار","كما هيَّجَ النَّغَمَ العازفونا",29,"ن",2,0],["وأذن المغرب وساد الفضا مثل الضباب","وانتهى...والليل لبس الأماكن لبس ثوب",30,"ب",1,0],["وَإذ نحّبَتْ كَلْبٌ على النجاسِ أيُّهمْ","أحَقُّ بِتَاجِ المَاجِدِ المُتَكَرّمِ",31,"م",1,0],["وإذ نحنُ أسبابُ المودَّة ِ بيننا","دماجٌ قواها لم تخنها وصولُها",32,"ل",3,0],["وإذْ نحن في السبعين عاماً تتابعتْ","ونطمعُ أيضاً بعدها بمزيدِ",33,"د",1,0],["واذن له بالسير كي ينجو به","من وقع كل مهند وسنان",34,"ن",1,0],["وإِذْ نحن مِنْ أَنْ تَشْحَطَ الدّارُ غُرْبةً","وإِنْ شُقّ لِلْبَيْنِ العَصا وَجِلانِ",35,"ن",1,0],["وإذ نحن هذا لهذا أخٌ","وهذا لذا ابنٌ وهذا أبُ",36,"ب",1,0],["وَآذنَ البرُّ بِالسُقيا وما فَتِئَت","منهم وَمنكَ صنوفُ البرِّ تُنتَظَرُ",37,"ر",1,0],["وَآذَنَ أَهلُ سَلمى بِاِرتِحالٍ","فَما لِلقَلبِ إِذ ظَعَنوا عَزاءُ",38,"ا",2,0],["وآذن العمر بالذهاب","وبالمسير إلى الرموس",39,"س",1,0],["وآذن اللَه أن تروى جوانحنا","بخمرة من شذاها يخلق العشب",40,"ب",1,0],["واذ ناديت ملتاعاً","قفي هند على مهل",41,"ل",1,0],["وَأَذن لِسَحب صَلاة لِلَّذي شرفت","بِهِ القَبائِل عَدنان وَقَحطان",42,"ن",1,0],["وَأَذنابُها وُحفٌ كَأَنَّ ذُيولَها","مَجَرُّ أَشاءٍمِن سُمَيحَةَ مُرطِبِ",43,"ب",1,0],["وأذنبَ كي يُهدي إليك اعتذارَهُ","ويا رُبَّ ذَنبٍ كان جالبَهُ العُذر",44,"ر",1,0],["وأْذَنْ له ما كَرَّ حَوْ لٌ راجِعٌ","يَرْجعْ غليك مع السَّعود ويَذْهَب",45,"ب",1,0],["وأُذْنٌ كان يطربها","حديثكمُ كففناها",46,"ا",3,0],["وَإِذ نَحنُ لَم يَعرِض لِأُلفَةِ بَينِنا","تَناءٍ وَلا مَلَّ الوِصالَ مَلولُ",47,"ل",1,0],["وإذن سماه طه نفسه","يا له مجداً به خص سميا",48,"ي",2,0],["وإذ نحن في أرض الحجاز وبيننا","مسيرة شهر بينهن بلابله",49,"ل",2,0],["وأْذَنوا للخيال يطرقُ ليلاً","أن يزور الخيالُ منكم مناما",50,"ا",1,0],["وأذَّنَ حُسْنُه للوجد فيه","فشاهدنا بوجنته بلالا",51,"ل",2,0],["وآذَنَ أَنفاسِي ونَفْسِي بِنَشْرِهِ","وَرَيَّاهُ أَنْفاسُ الرِّياحِ النَّواسِمُ",52,"م",1,0],["وآذنت الغزالة حين دَرَّتْ","غداة الصحو من بيت القباب",53,"ب",1,0],["واذَنا للقول من معدنه","إنَّ جِدَّ القولِ غيرُ اللعبِ",54,"ب",1,0],["وأذنْ لسمعك أن يطلق بعدها","ذاكَ المعادَ من الحديث المفترى",55,"ر",2,0],["وَآذَنوكَ بِبَينٍ مِن وِصالِهِم","فَما سَلَوتَ وَلا يُسليكَ ما صَنَعوا",56,"ع",3,0],["وأذْنها بازْدحامِ الموجِ مااكترثتْ","فعلّ شيئاً عن القمّةِ ينبثِقُ",57,"ق",1,0],["وأذن الله له بالهجرة","أقامه مقامه للأثرة",58,"ه",1,0],["وَأذَّنْتُ حِينَ تَجَلَّى الصَّباحُ","بِحيّ على خَيْرِ هذا العَملْ",59,"ل",1,0]]}