{"poems":[[77,"زارت ونجم الدجى يشكو من الأرق","https://www.aldiwan.net/poem35921.html","البسيط"],[86,"أوشك الديك أن يصيح ونفسي","https://www.aldiwan.net/poem10941.html","الخفيف"],[30,"ألا حي دارا قد أبان محيلها","https://www.aldiwan.net/poem29538.html","الطويل"],[30,"لقد خفق النسران والنجم بازل","https://www.aldiwan.net/poem29612.html","الطويل"],[88,"أرى الشعر أحياناً بجيش بخاطري","https://www.aldiwan.net/poem44455.html","الخفيف"],[88,"لقد بت مطروف النواظر بالسهد","https://www.aldiwan.net/poem45057.html","الطويل"],[27,"شعفت بعهد ذكرته المنازل","https://www.aldiwan.net/poem5966.html","الطويل"],[23,"لمن منزل عاف كأن رسومه","https://www.aldiwan.net/poem21242.html","الطويل"],[51,"أساء الرأي أم عزب الرسول","https://www.aldiwan.net/poem65999.html","الوافر"],[38,"تغير قومي ولا أسخر","https://www.aldiwan.net/poem7712.html","المتقارب"],[62,"يا ليلة السفح ألا عدت ثانية","https://www.aldiwan.net/poem52276.html","البسيط"],[28,"ينام الطريد بعدها نومة الضحى","https://www.aldiwan.net/poem5509.html","الطويل"],[66,"إني لفضلك بالمديح أجازي","https://www.aldiwan.net/poem38510.html","الكامل"],[80,"أبا هاشم هشمتني الشفار","https://www.aldiwan.net/poem31300.html","المتقارب"],[69,"بأيمن جرعاء الكثيب خيام","https://www.aldiwan.net/poem28765.html","الطويل"],[31,"ألم تسأل الأطلال والمتربعا","https://www.aldiwan.net/poem42466.html","الطويل"],[52,"شفعيني يا شر في رد نفسي","https://www.aldiwan.net/poem26780.html","الخفيف"],[75,"هل من أعقة عالج يبرين","https://www.aldiwan.net/poem69032.html","الكامل"],[50,"طربت إلى حوضى وأنت طروب","https://www.aldiwan.net/poem64859.html","الطويل"],[46,"سمعت نعيها صما صمام","https://www.aldiwan.net/poem23631.html","الكامل"],[19,"غني تآوى بأولادها","https://www.aldiwan.net/poem335.html",""],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20986","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42602","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54556","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54746","الطويل"],[106,"حي البيان","https://www.poetsgate.com/ViewPoem.aspx?id=179367",""],[50,"طربتَ إلى \"حوضى \" وأنت طروبُ","https://www.poetsgate.com/ViewPoem.aspx?id=16891",""],[90,"عاشوراء","https://www.poetsgate.com/ViewPoem.aspx?id=179150",""],[90,"النجوى","https://www.poetsgate.com/ViewPoem.aspx?id=178987",""],[28,"إذا المرء لم يحقن دما لابن عمه","https://www.poetsgate.com/ViewPoem.aspx?id=22046",""],[30,"أَلا حَيِّ دَاراً قَدْ أَبَانَ مُحِيلُهَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=20509&r=&rc=3",""]],"verses":[["وإذْ نَعِمْنا برَغْمِ الدّهْرِ فيهِ وقدْ","عضّ الأنامِلَ منْ غيْظٍ ومِنْ حنَقِ",0,"ق",1,0],["وَأَذَنِ الصُبحَ أَن يَلوحَ لِعَيني","مِن سَناها فَذاكَ وَقتُ التَحَسّي",1,"س",2,0],["وَإِذ نَحنُ أَسبابُ المَوَدَّةِ بَينَنا","دُماجٌ قُواها لَم يَخُنها وُصولُها",2,"ل",3,0],["وَأُذنٍ تُبينُ العِتقَ مِن حَيثُ رُكِّبَت","مُؤلَلَةٍ زَعراءَ جَيِّدَةِ النَصبِ",3,"ب",1,0],["وأذن لو اسصغيتها نحو كاتم","سمعت بها منه حديث قرونه",4,"ن",2,0],["وإذنّ في الحيّ المؤذَن غدوةً","فأيقظني التكبير من سنةٍ الرقد",5,"د",1,0],["وَإِذ نَحنُ أُلّافٌ لَدى كُلِّ مَنزِلٍ","وَلَمّا تُفَرَّق لِلطِياتِ الجَمائِلُ",6,"ل",1,0],["وَإِذ نَحنُ لَم يولَع بِنا الناسُ كُلُّهُم","وَما تَرتَجي صُرمَ الخَليطِ العَواذِلُ",6,"ل",1,0],["وَإِذ نَحنُ جيرانٌ كَثيرٌ بِغَبطَةٍ","وَإِذ ما مَضى مِن عَشِنا لَم يُصَرَّمِ",7,"م",1,0],["وإذنُ الوجهِ لا الحُجَّابِ إذنٌ","وفي الأحشاء لا الدارِ الدخولُ",8,"ل",1,0],["وَأُذنانِ حَشرٌ إِذا أُفزِعَت","شُرافِيَّتانِ إِذا تَنظُرُ",9,"ر",1,0],["وآذنتنا بقربِ الفجرِ واشيةٌ","باتتْ تُحرِّشُ بين الضَّالِ والسَّلمِ",10,"م",1,0],["وَإِذ نَحَّبَت كَلبٌ عَلى الناسِ أَيُّهُم","أَحَقُّ بِتاجِ الماجِدِ المُتَكَرِّمِ",11,"م",1,0],["وَأُذِنتُ أَن تَرويهِ عَنّي مالِكي","مَع كُلُّ ما تَعزوهُ نَحوي عازي",12,"ي",1,0],["وآذنت عُمّار القفار بحربهم","فيا قُرْبَ ما شَقّوا إليك الخضارما",13,"م",2,0],["وإذْ نسماتُ الوصلِ تحيي قلوبَنا","ونحنُ سهارى والوشاةُ نيامُ",14,"م",1,0],["وَإِذ نَحنُ مِثلُ الماءِ كانَ مِزاجُهُ","كَما صَفَّقَ الساقي الرَحيقَ المُشَعشَعا",15,"ع",2,0],["وَأذَني في الرُقادِ لي إِنَّ عَيني","تَستَعيرُ الرُقادَ مِن عَينَيكِ",16,"ك",1,0],["وَأْذَنْ له يُغْرِقْ أُمَيّةَ مُعْلِناً","ما كلُّ مأذونٍ له مأذون",17,"ن",1,0],["وَإِذ نَحنُ بِالأَدعاصِ أَمّا نَهارُنا","فَصَعبٌ وَأَمّا لَيلُنا فَرَكوبُ",18,"ب",1,0],["وَإِذ نَلتَقي خَلفَ العُيون كَأَنَّنا","سُلافُ عُقارٍ بِالنُقاخِ مَشوبُ",18,"ب",1,0],["وأذّنَتِ الجَنادِبُ في ضُحاها","أذَاناً غيرَ مُنْتَظَرِ الإمامِ",19,"م",1,0],["وَأُذنٌ لَها حَشرَةٌ مَشرَةٌ","كَإِعليطِ مَرخٍ إِذا ما صَفِر",20,"ر",1,0],["وإذ نَقَمتُ مِنَ الوَجناءِ جِبلَتَها","إذ خافَ منكَ وَلُّي الشَجوِ إدبارا",21,"ر",2,0],["وَإِذْ نَحْنُ فيما بَيْنَ إِخْوَانِ لَذَّةٍ","عَلَى شِيَمٍ مَا إِنْ بِهِنَّ نَكِيرُ",22,"ر",1,0],["وَإِذْ نَسْتَلِذُّ الْقَرَّ وَهْوَ كَرِيهَةٌ","وَإِذْ نَسْتَطِيبُ الْحَرَّ وَهْوَ مُذِيبُ",23,"ب",1,0],["وَإِذْناً فَإِنِّي اليَوْمَ أَقْضِي لِرَاحِلٍ","عَلَى مِصْرَ حَقّاً كَادَ يَبْلَى فَجُدِّدا",24,"د",2,0],["وإذنْ لَطِرْتُ إلى الفَضاءَ محلِّقًا","في لمح كوكبه، ورمش شهابه",25,"ب",2,0],["وإذْ نلتقي خلف العيون كأنَّنا","سلافُ عقارٍ بالنُّقاحِ مشوبُ",26,"ب",1,0],["وآذَنَ نورُ \" البيت \" عند برِحلة","وغاصَ النَدى منه فجفَّ وأقفرا",27,"ر",2,0],["وآذنَ بالصبحِ صوتُ الهَزار","كما هيَّجَ النَّغَمَ العازفونا",28,"ن",2,0],["وَإذ نحّبَتْ كَلْبٌ على النجاسِ أيُّهمْ","أحَقُّ بِتَاجِ المَاجِدِ المُتَكَرّمِ",29,"م",1,0],["وإذ نحنُ أسبابُ المودَّة ِ بيننا","دماجٌ قواها لم تخنها وصولُها",30,"ل",3,0]]}