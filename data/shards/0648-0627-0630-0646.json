5,"حمام الأيك","https://www.poetsgate.com/ViewPoem.aspx?id=213526",""],[5770,"إلى صديق","https://www.poetsgate.com/ViewPoem.aspx?id=178681",""],[402,"علا مفرقي بعد الشباب مشيب","https://www.poetsgate.com/ViewPoem.aspx?id=35055",""],[5790,"خذوا قودي من أسير الكلل","https://www.poetsgate.com/ViewPoem.aspx?id=112120",""],[5829,"وقلب العاشقين هنا يذوب","https://www.poetsgate.com/ViewPoem.aspx?id=210213",""],[5845,"صدوا عن الصبِّ الكئيبِ وأعرضوا","https://www.poetsgate.com/ViewPoem.aspx?id=16705",""],[161,"حنين الأنام لحج بيت الله الحرام","https://www.poetsgate.com/ViewPoem.aspx?id=175362",""],[6093,"سُكَارَى","https://www.poetsgate.com/ViewPoem.aspx?id=204997",""],[6247,"الحياة التفات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80275&r=&rc=14",""],[6256,"ضاعت حقيبتها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65917&r=&rc=5",""]],"verses":[["وإذْ نَعِمْنا برَغْمِ الدّهْرِ فيهِ وقدْ","عضّ الأنامِلَ منْ غيْظٍ ومِنْ حنَقِ",0,"ق",1,0],["وَأَذَنِ الصُبحَ أَن يَلوحَ لِعَيني","مِن سَناها فَذاكَ وَقتُ التَحَسّي",1,"س",2,0],["وَإِذ نَحنُ أَسبابُ المَوَدَّةِ بَينَنا","دُماجٌ قُواها لَم يَخُنها وُصولُها",2,"ل",3,0],["وَأُذنٍ تُبينُ العِتقَ مِن حَيثُ رُكِّبَت","مُؤلَلَةٍ زَعراءَ جَيِّدَةِ النَصبِ",3,"ب",1,0],["وأذن لو اسصغيتها نحو كاتم","سمعت بها منه حديث قرونه",4,"ن",2,0],["وإذنّ في الحيّ المؤذَن غدوةً","فأيقظني التكبير من سنةٍ الرقد",5,"د",1,0],["وَإِذ نَحنُ أُلّافٌ لَدى كُلِّ مَنزِلٍ","وَلَمّا تُفَرَّق لِلطِياتِ الجَمائِلُ",6,"ل",1,0],["وَإِذ نَحنُ لَم يولَع بِنا الناسُ كُلُّهُم","وَما تَرتَجي صُرمَ الخَليطِ العَواذِلُ",6,"ل",1,0],["وَإِذ نَحنُ جيرانٌ كَثيرٌ بِغَبطَةٍ","وَإِذ ما مَضى مِن عَشِنا لَم يُصَرَّمِ",7,"م",1,0],["وإذنُ الوجهِ لا الحُجَّابِ إذنٌ","وفي الأحشاء لا الدارِ الدخولُ",8,"ل",1,0],["وَأُذنانِ حَشرٌ إِذا أُفزِعَت","شُرافِيَّتانِ إِذا تَنظُرُ",9,"ر",1,0],["وآذنتنا بقربِ الفجرِ واشيةٌ","باتتْ تُحرِّشُ بين الضَّالِ والسَّلمِ",10,"م",1,0],["وَإِذ نَحَّبَت كَلبٌ عَلى الناسِ أَيُّهُم","أَحَقُّ بِتاجِ الماجِدِ المُتَكَرِّمِ",11,"م",1,0],["وَأُذِنتُ أَن تَرويهِ عَنّي مالِكي","مَع كُلُّ ما تَعزوهُ نَحوي عازي",12,"ز",2,0],["وآذنت عُمّار القفار بحربهم","فيا قُرْبَ ما شَقّوا إليك الخضارما",13,"م",2,0],["وإذْ نسماتُ الوصلِ تحيي قلوبَنا","ونحنُ سهارى والوشاةُ نيامُ",14,"م",1,0],["وَإِذ نَحنُ مِثلُ الماءِ كانَ مِزاجُهُ","كَما صَفَّقَ الساقي الرَحيقَ المُشَعشَعا",15,"ع",2,0],["وَأذَني في الرُقادِ لي إِنَّ عَيني","تَستَعيرُ الرُقادَ مِن عَينَيكِ",16,"ك",1,0],["وَأْذَنْ له يُغْرِقْ أُمَيّةَ مُعْلِناً","ما كلُّ مأذونٍ له مأذون",17,"ن",1,0],["وَإِذ نَحنُ بِالأَدعاصِ أَمّا نَهارُنا","فَصَعبٌ وَأَمّا لَيلُنا فَرَكوبُ",18,"ب",1,0],["وَإِذ نَلتَقي خَلفَ العُيون كَأَنَّنا","سُلافُ عُقارٍ بِالنُقاخِ مَشوبُ",18,"ب",1,0],["وأذّنَتِ الجَنادِبُ في ضُحاها","أذَاناً غيرَ مُنْتَظَرِ الإمامِ",19,"م",1,0],["وَأُذنٌ لَها حَشرَةٌ مَشرَةٌ","كَإِعليطِ مَرخٍ إِذا ما صَفِر",20,"ر",1,0],["وإذ نَقَمتُ مِنَ الوَجناءِ جِبلَتَها","إذ خافَ منكَ وَلُّي الشَجوِ إدبارا",21,"ر",2,0],["وَإِذْ نَحْنُ فيما بَيْنَ إِخْوَانِ لَذَّةٍ","عَلَى شِيَمٍ مَا إِنْ بِهِنَّ نَكِيرُ",22,"ر",1,0],["وَإِذْ نَسْتَلِذُّ الْقَرَّ وَهْوَ كَرِيهَةٌ","وَإِذْ نَسْتَطِيبُ الْحَرَّ وَهْوَ مُذِيبُ",23,"ب",1,0],["وَإِذْناً فَإِنِّي اليَوْمَ أَقْضِي لِرَاحِلٍ","عَلَى مِصْرَ حَقّاً كَادَ يَبْلَى فَجُدِّدا",24,"د",2,0],["وإذنْ لَطِرْتُ إلى الفَضاءَ محلِّقًا","في لمح كوكبه، ورمش شهابه",25,"ب",2,0],["وأذّن الفجر من نيران مدفعه","والمعجزات شفاه والدنا أذن",26,"ن",1,0],["وإذْ نلتقي خلف العيون كأنَّنا","سلافُ عقارٍ بالنُّقاحِ مشوبُ",27,"ب",1,0],["وآذَنَ نورُ \" البيت \" عند برِحلة","وغاصَ النَدى منه فجفَّ وأقفرا",28,"ر",2,0],["وآذنَ بالصبحِ صوتُ الهَزار","كما هيَّجَ النَّغَمَ العازفونا",29,"ن",2,0],["وأذن المغرب وساد الفضا مثل الضباب","وانتهى...والليل لبس الأماكن لبس ثوب",30,"ب",1,0],["وَإذ نحّبَتْ كَلْبٌ على النجاسِ أيُّهمْ","أحَقُّ بِتَاجِ المَاجِدِ المُتَكَرّمِ",31,"م",1,0],["وإذ نحنُ أسبابُ المودَّة ِ بيننا","دماجٌ قواها لم تخنها وصولُها",32,"ل",3,0],["وإذْ نحن في السبعين عاماً تتابعتْ","ونطمعُ أيضاً بعدها بمزيدِ",33,"د",1,0],["واذن له بالسير كي ينجو به","من وقع كل مهند وسنان",34,"ن",1,0],["وإِذْ نحن مِنْ أَنْ تَشْحَطَ الدّارُ غُرْبةً","وإِنْ شُقّ لِلْبَيْنِ العَصا وَجِلانِ",35,"ن",1,0],["وإذ نحن هذا لهذا أخٌ","وهذا لذا ابنٌ وهذا أبُ",36,"ب",1,0],["وَآذنَ البرُّ بِالسُقيا وما فَتِئَت","منهم وَمنكَ صنوفُ البرِّ تُنتَظَرُ",37,"ر",1,0],["وَآذَنَ أَهلُ سَلمى بِاِرتِحالٍ","فَما لِلقَلبِ إِذ ظَعَنوا عَزاءُ",38,"ا",2,0],["وآذن العمر بالذهاب","وبالمسير إلى الرموس",39,"س",1,0],["وآذن اللَه أن تروى جوانحنا","بخمرة من شذاها يخلق العشب",40,"ب",1,0],["واذ ناديت ملتاعاً","قفي هند على مهل",41,"ل",1,0],["وَأَذن لِسَحب صَلاة لِلَّذي شرفت","بِهِ القَبائِل عَدنان وَقَحطان",42,"ن",1,0],["وَأَذنابُها وُحفٌ كَأَنَّ ذُيولَها","مَجَرُّ أَشاءٍمِن سُمَيحَةَ مُرطِبِ",43,"ب",1,0],["وأذنبَ كي يُهدي إليك اعتذارَهُ","ويا رُبَّ ذَنبٍ كان جالبَهُ العُذر",44,"ر",1,0],["وأْذَنْ له ما كَرَّ حَوْ لٌ راجِعٌ","يَرْجعْ غليك مع السَّعود ويَذْهَب",45,"ب",1,0],["وأُذْنٌ كان يطربها","حديثكمُ كففناها",46,"ا",3,0],["وَإِذ نَحنُ لَم يَعرِض لِأُلفَةِ بَينِنا","تَناءٍ وَلا مَلَّ الوِصالَ مَلولُ",47,"ل",1,0],["وإذن سماه طه نفسه","يا له مجداً به خص سميا",48,"ي",2,0],["وإذ نحن في أرض الحجاز وبيننا","مسيرة شهر بينهن بلابله",49,"ل",2,0],["وأْذَنوا للخيال يطرقُ ليلاً","أن يزور الخيالُ منكم مناما",50,"ا",1,0],["وأذَّنَ حُسْنُه للوجد فيه","فشاهدنا بوجنته بلالا",51,"ل",2,0],["وآذَنَ أَنفاسِي ونَفْسِي بِنَشْرِهِ","وَرَيَّاهُ أَنْفاسُ الرِّياحِ النَّواسِمُ",52,"م",1,0],["وآذنت الغزالة حين دَرَّتْ","غداة الصحو من بيت القباب",53,"ب",1,0],["واذَنا للقول من معدنه","إنَّ جِدَّ القولِ غيرُ اللعبِ",54,"ب",1,0],["وأذنْ لسمعك أن يطلق بعدها","ذاكَ المعادَ من الحديث المفترى",55,"ر",2,0],["وَآذَنوكَ بِبَينٍ مِن وِصالِهِم","فَما سَلَوتَ وَلا يُسليكَ ما صَنَعوا",56,"ع",3,0],["وأذْنها بازْدحامِ الموجِ مااكترثتْ","فعلّ شيئاً عن القمّةِ ينبثِقُ",57,"ق",1,0],["وأذن الله له بالهجرة","أقامه مقامه للأثرة",58,"ه",1,0],["وَأذَّنْتُ حِينَ تَجَلَّى الصَّباحُ","بِحيّ على خَيْرِ هذا العَملْ",59,"ل",1,0],["وأذنت للأسماء حتى أنها","حكمت على الأفعال حسب سماتها",60,"ت",3,0],["وَإِذ نَفَروا فازوا فَهُم نَفَرُ التّقى","سَقَتهُم سحاب العَفو صَفواً زلالها",61,"ل",3,0],["وإذ نمق الروض الدما فكأنما","تطرز بالياقوت ثوب زبرجد",62,"د",1,0],["وإذ ناقتي بعض نوق الفرات","لكنها ناقةٌ عائط",63,"ط",1,0],["وَأُذنُه حُسْنَ ذِكرِ الحبِّ تَسمَعُهُ","وَتِلكَ عَن ذِكرِ غَيرِ الحبِّ في طرَشِ",64,"ش",1,0],["وَأذن لَنا نَنزل إِلى المَراعي","فَما لَنا غَيرك فيها راعي",65,"ي",1,0],["وَإِذ نَحنُ أَثمار الأَحادِيث نَجتنِي","وَنَرشُفُ مِن راحِ الوِصالِ وَنَشرَبُ",66,"ب",1,0],["وأذنا خذور كالسنان ومقلتا","طلى راعه القناص فهو هيوب",67,"ب",1,0],["وأذن بحج العقل كعبة رشده","بلبيك يا داعي الراشد أنس أنس",68,"س",1,0],["وَإِذ نحن خيل الوجدِ فينا مغيرةٌ","وَأَسنانه فينا تطول وتمتدُّ",69,"د",1,0],["وَإِذ ناءَ طلق المحيّا نجدي","ماء الصبا والنضارة جارِ",70,"ر",1,0],["وَإِذ نحنُ لَم نُحسِن وداعاً منَ البكا","سِوى نظرٍ تَقضيه عنّا النواظرُ",71,"ر",1,0],["وَإِذ نحنُ نَطوي في الدجى كلّ سملق","تُسايرنا فيها النجوم الزواهرُ",71,"ر",1,0],["وَأَذَّنَ بِالعُمرِ الطَويلِ مُجَدِّداً","بِتَجديدِ مُلكِ الأَرضِ فَتحاً عَلى الوِلا",72,"ل",2,0],["وأذّن للصّلاةِ وجاوبته","نواقيسُ النّصارى في القَلالي",73,"ل",2,0],["وإذ نحن يغدونا ضحىً وأَصائِلاً","جَنَى شجرِ اللَّذات والظلُّ باردُ",74,"د",1,0],["وإذ نحن في حكم أَهل الملاهي","نطيع النّدامى وتعصي العَذولا",75,"ل",2,0],["وإذ نلقاك واردة فتبدي","نفار الظبي آنس صوت داع",76,"ع",1,0],["واذن عَندَلِيبُ المجد لما","بدا من افقه نور الصباح",77,"ح",1,0],["وأذن بلبل الخلخال فينا","فقمنا للسرير وللسرور",78,"ر",1,0],["وأذّن بلبل الخلخال فينا","بحيَّ على يعافير القصور",79,"ر",1,0],["وآذَنَتِ المكارمُ والمعالي","بِخَطْبٍ عاثَ حتى في الخطوب",80,"ب",1,0],["وإذن ذُكر المجد القديم فإنما","بذكرهم تلهو القيان وتعزف",81,"ف",1,0],["وأذِنت للمتعرفين لعَلَّما","عرفوا لقومك حقهم فأنابوا",82,"ب",3,0],["وآذن أن مَن جاءه وهو خائفٌ","فإن له من كان أن يتخفَّرا",83,"ر",2,0],["وأذن لأحمد في قضا حوائجنا","وما نؤمل من منى وآمال",84,"ل",1,0],["وأذن ديكٌ في الصباح فما أتى","عليه الضحى إلا أتانا مع الغدا",85,"د",2,0],["وأذن كنصف البرد تسمعه الندا","خفياً وطرف ينفض الغيب مزورُّ",86,"ر",1,0],["وَأُذنِى سامِعٌ وَالعَينُ تَنظُر","كِرَاءَهُمُوا لِسُفن يا لَزِيمُ",87,"م",1,0],["وَأذَّنَ صُبحُ الشَيبِ في لَيلِ لِمَّتي","فَفِئتُ وَلكِني عَلى اللَيلِ آسِفُ",88,"ف",1,0],["وَإِذ نَحنُ في غُصنِ الشَبابِ وَقَد عَسا","بِنا الآنَ إِلّا أَن يُعَوَّضَ جازِعُ",89,"ع",1,0],["وإذنك ندب في عيادة محرم","وحضرتها للميت لا بتشدد",90,"د",1,0],["واذن بالعير ذاك النعي","فعاد النَفير اجب القرا",91,"ر",2,0],["وأذّن بكل الناس يوم لقائه","وكبر على نحر الصلاة ومجد",92,"د",1,0],["وأذني تحن لرجع الصدى","إذا رنّ في سمعها الغائر",93,"ر",1,0],["واذ نحن فيه محدقين جميعنا","نشاوى لنا فيه صبوحٌ ومغبق",94,"ق",1,0],["وأذَن لسُحب صَلاة منك دائمة","تسقي الضَريح كروض جيدَ بالديم",95,"م",1,0],["وَإذْ نَكَثْتُمْ عُهوداً بَعْدَ أيمان","فَأَيْنَ أيمانُكُمْ يا أهْلَ طُغْيانِ",96,"ن",1,0],["وَأَذنابُ خَيلٍ عُلِّقَت في عَقيصَةٍ","تَرى قُرطَها مِن تَحتِها يَتَطَوَّحُ",97,"ح",1,0],["وَاِذ نَأى بي النَوى قَد قُلت مُبتَدِراً","اِستَودَع اللَهُ في بَغدادَ لي قَمراً",98,"ر",2,0],["وَاِذ نَأى راحِلاً عَنّا عَلى عجل","وَالقَلبُ في أَثره يَسعى كَمنجَذِب",99,"ب",1,0],["وآذن فيك الصبر أن لا يعينني","وآذن فيك الحزن أن يتغلبا",100,"ب",2,0],["وإِذ نَحنُ أَمّا مَن مَشى بِمَوَدَّةٍ","فَنَرضى وأَمّا مَن وشى فنُخالِفُ",101,"ف",1,0],["وآذِناً للفُلْكِ تَجْري خَبَبا","وخالقَ الماءِ وَشِيجاً نَسَبا",102,"ب",2,0],["وأذن الأمير إذ سألته","إذناً وقل آذنته أعلمته",103,"ه",1,0],["وأُذّنَ لِلطِّفلِ يَومَ الوِلاَد","فَهَذَا الأَذَانُ لِتِلكَ الصَّلاَة",104,"ه",1,0],["وإِذ نُرصي الشبابَ ولا نبالي","عواقبه أَتحلو أَم تمرُّ",105,"ر",1,0],["وإِذ نجري جيادَ اللهو فيها","لها كر بساحتها وفرُّ",106,"ر",1,0],["وإذ نحن لا نعرف المنحنى","ولا أرض سلع ولا ثهمد",107,"د",1,0],["وأذن صغت للاشقيا فاز دجارها","بوعظ كسمط حيث يختل بالفض",108,"ض",1,0],["وأذن جهرا صادق الفجر بالنوى","وحيل حتى ازددت وجدا على وجدي",109,"د",2,0],["وأذن داعي البشر في حرم الصفا","وأعلن في تكبيره وتشهدا",110,"د",2,0],["وَأُذنٌ مُوَلَّلَةٌ حَشرَةٌ","وَشِدقٌ رُحابٌ وَجَوفٌ هَوا",111,"ا",1,0],["وأذناً بها يصغى إلى عذل عاذل","وعبرة عين لم تفض بمغاني",112,"ن",2,0],["وَأذنهُ إذ جاءَكَ يَبغي الحِمى","إِذناً لِصبٍّ بِالحِمى مُغرَمِ",113,"م",1,0],["وَأذن لمثلي قام مُستَعرِضاً","سيوف الإسلام بِأن يعرضا",114,"ض",2,0],["وَإِذَن تَسمَعُوا خَطِيبَ إِيادٍ","يَنفُثُ السِحرَ مُمسِكاً بِعَصاهُ",115,"ا",2,0],["وأُذنٌ كنصفِ البرد تسمعه النّدا","خفيّا وطرفٌ ينفضُ العنتَ مزورّ",116,"ر",1,0],["وأذَّنَ المرجُ بالمنثور في طَرَبٍ","فانثالَ مِن كلِّ بُستانٍ يُهاديها",117,"ي",3,0],["وأذّنَ صدْرُهُ الباهي صباحاً","فشعّ على الربى نوراً جليّا",118,"ي",2,0],["وَأَذِّنِي في مَواتٍ ليسَ يوقِظُهُ","صَوْتُ الأَذانِ، ولا صَمْتُ المُصَلِّينا",119,"ن",2,0],["وَأْذَنْ بِفَجْرٍ شُعَاعُ النَّصْرِ غُرَّتُه","وَانْصُرْ جُنُودَاً أَتَوْا لِلْحَقِّ دَاعِينَا",120,"ن",2,0],["وأذن لسحب صلاة منك دائمة","لخاتم الرسل خير الخلق كلهم",121,"م",1,0],["وآذن الشرّ بإقباله","وآذن الخير بإدبار",122,"ر",1,0],["وأَذَّنَ الهَجْرُ، قالتْ: مِنْ هُناكَ فَسِرْ","لِتُبْلِغَ البَحرَ سِرًّا فيكَ كمْ كَبُرَا",123,"ر",2,0],["وإذْ نحن منْ أنْ تشحطَ الدّارُ غربة","ً وإنْ شقَّ البينُ للعصا وجلانِ",124,"ن",1,0],["وآذنهم بشر الرضا بشفاعة","بها فيهم إعطاءء مرسله الأذنا",125,"ن",2,0],["وَأذْنَبنَا وَما زِلنَا سُكَارَى","نُسَافِحُ عِرْضَنَا وَهَلُمَّ جَرَّا",126,"ر",2,0],["وإذ نشتو فهم في البرد دفْءٌ","أعيشُ سعادةً ما دمتُ حيَّا",127,"ي",2,0],["[ وَإِذْ نَحْنُ لِلتَّوْدِيعِ فِي مِلَّةِ الهَوَى","فَرائِضُ تُقْضَى بَيْنَنا وَنَوافِلُ ]",128,"ل",1,0],["وَإِذْ نَحْنُ خَيْلُ الوَجْدِ فِينا مُغِيرَةٌ","وَأَسْبابُهُ فِينا تَطُولُ وَتَمْتَدُّ",129,"د",1,0],["واذن فقد أقوت مغانى الشعر","فى الدنيا وبات لواؤه محلولا",130,"ل",2,0],["وإذن فقد ذهب الزمان بخير ما","جاد الزمان . . أجب فصبرى عيلا",130,"ل",2,0],["وأذّنَ بالمشيب له حجيج","يطوفون المفارق محرمينا",131,"ن",2,0],["وإذ نحن في فصلنا المدرسي","نداعب يوماً جميلاً رُؤاه",132,"ا",2,0],["وإذ نستلذ اآلقر وهو كريهة","وإن نستطيب الحر وهو مذيب",133,"ب",1,0],["وإذ نستبينا كل ذات ملاحة","لها فتنة بالملاعبين لعوب",133,"ب",1,0],["وأذنت حين تجلى الصباح","بحي على خير ذاك العمل",134,"ل",1,0],["واذن الناس قد صارت عجينا","وقد أبلت ضمائرنا الخطوبُ",135,"ب",1,0],["وأذنْ لمشتاقٍ يزركَ فإنهُ","لا يستطيعُ منَ الكبائرِ ينهضُ",136,"ض",1,0],["01-و أذَّنَ بالحَجِّ المُنَاديَ فَاسْمعُوا","تقاريرَ أسْمَاءٍ، وَحَظًّا علا سَهْمَا",137,"م",2,1],["وَآذَنُوا العَقْلَ أَنَّ الغَيَّ غَايَتُهُمْ","فَفَارَقَ القَوْمَ نُوْرُ العَقْلِ في عَجَبِ",138,"ب",1,0],["وإذْ نظرةٌ نحو بابِ السماءِ","تُعيدُ الرجاءَ لقلبي نَدِيّا",139,"ي",2,0],["وإذن لصغنا عنك رائعة","لم تسمع الدنيا شبيهتها",140,"ت",3,0]]}