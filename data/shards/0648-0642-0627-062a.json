{"poems":[[102,"أبو تمام وعروبة اليوم","https://www.aldiwan.net/poem23694.html","عموديه"],[9,"كانت وصاة وحاجات لنا كفف","https://www.aldiwan.net/poem21952.html","البسيط"],[16,"طحا بك قلب في الحسان طروب","https://www.aldiwan.net/poem27695.html","الطويل"],[30,"وجاء قريع الشول قبل إفالها","https://www.aldiwan.net/poem5338.html","البسيط"],[82,"أذبت فؤادي يا فديتك بالعتب","https://www.aldiwan.net/poem31564.html","الطويل"],[46,"سالب عيني لذة الغمض","https://www.aldiwan.net/poem30224.html","السريع"],[107,"بني لحيان لوذوا بالجبال","https://www.aldiwan.net/poem44068.html","الوافر"],[22,"وقاتلت الغداة قتال صدق","https://www.aldiwan.net/poem21692.html","الوافر"],[54,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[8,"جهلت علي ابن الحيا وظلمتني","https://www.aldiwan.net/poem21816.html","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202544","الرجز"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/9487","الرجز"],[22,"وقاتَلْتَ الغَداة َ قِتالَ صِدْقٍ","https://www.poetsgate.com/ViewPoem.aspx?id=19730",""],[102,"أبو تمام وعروبة اليوم","https://www.poetsgate.com/ViewPoem.aspx?id=50330",""],[90,"تذكرت في أوطاني الأهلَ والصحبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19533&r=&rc=36",""],[207,"ألم تسأل الناس عن شأننا","https://www.aldiwan.net/poem68162.html","المتقارب"],[214,"تهللت الأفراح وابتسم الدهر","https://www.aldiwan.net/poem13466.html","الطويل"],[255,"تزوج الشيخ أبي زوجة","https://www.aldiwan.net/poem15051.html","السريع"],[303,"لا هم دمعي من طول البكا نفدا","https://www.aldiwan.net/poem36823.html","عموديه"],[366,"والله لا استطيع صدك","https://www.aldiwan.net/poem68117.html","مخلع البسيط"],[369,"أصح عيون البابلية ما اعتلا","https://www.aldiwan.net/poem60796.html","الطويل"],[406,"رجوتك يا حبيب","https://www.aldiwan.net/poem6720.html","عموديه"],[466,"لله در غمام سح صيبه","https://www.aldiwan.net/poem15914.html","البسيط"],[510,"بيان","https://www.aldiwan.net/poem42464.html","الهزج"],[556,"من شاء ان يعذلني في الهوى","https://www.aldiwan.net/poem47279.html","السريع"],[568,"حمدا لمالكنا لفظا ومستطرا","https://www.aldiwan.net/poem13608.html","البسيط"],[574,"فان يبل الشباب فكل شيء","https://www.aldiwan.net/poem51993.html","الوافر"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126797","الطويل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72327","البسيط"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72330","الرجز"],[1090,"","https://poetry.dctabudhabi.ae/diwan/poem/96443","الطويل"],[1090,"","https://poetry.dctabudhabi.ae/diwan/poem/96462","الطويل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25350","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25344","الرجز"],[1177,"","https://poetry.dctabudhabi.ae/diwan/poem/28377","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49993","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79979","المجتث"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26676","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108822","الوافر"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49590","الرجز"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76802","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124777","الطويل"],[2789,"","https://poetry.dctabudhabi.ae/diwan/poem/21596","الطويل"],[402,"","https://poetry.dctabudhabi.ae/diwan/poem/141718","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100736","الطويل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112669","الرجز"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112646","الرجز"],[3452,"","https://poetry.dctabudhabi.ae/diwan/poem/28868","الطويل"],[3452,"","https://poetry.dctabudhabi.ae/diwan/poem/28855","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138623",""],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66320","السريع"],[3658,"","https://poetry.dctabudhabi.ae/diwan/poem/199177",""],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117842","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85234","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131042",""],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4767,"أدمع المقل","https://www.poetsgate.com/ViewPoem.aspx?id=179920",""],[4858,"أنين القيد","https://www.poetsgate.com/ViewPoem.aspx?id=152051",""],[5324,"والتين والزيتون","https://www.poetsgate.com/ViewPoem.aspx?id=211590",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[5408,"لماذا أنا وهو لا","https://www.poetsgate.com/ViewPoem.aspx?id=190787",""],[5582,"نَفْسُ المُتَيَّمِ دِينُ الحُبِّ مَذْهَبُها","https://www.poetsgate.com/ViewPoem.aspx?id=186667",""],[5672,"ما لم يقله رؤبة بن العجاج","https://www.poetsgate.com/ViewPoem.aspx?id=213612",""],[5885,"نتقاتل","https://www.poetsgate.com/ViewPoem.aspx?id=194800",""],[6193,"لذي سلم والبان لولاك لم أهوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55424&r=&rc=0",""],[6300,"نقش قديم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82860&r=&rc=31",""]],"verses":[["وقاتلت دوننا الأبواق صامدة","أما الرجال فماتوا... ثَمّ أو هربوا",0,"ب",3,0],["وَقاتِلوا القَومَ إِنَّ القَتلَ مَكرُمَةٌ","إِذا تَلَوّى بِكَفِّ المُعصِمِ العُرُفُ",1,"ف",1,0],["وَقاتَلَ مِن غَسّانَ أَهلُ حِفاظِها","وَهِنبٌ وَقاسٌ جالَدَت وَشَبيبُ",2,"ب",1,0],["وَقاتَلَ كَلبُ الحَيِّ عَن نارِ أَهلِهِ","لِيَربِضَ فيها وَالصِلا مُتَكَنَّفُ",3,"ف",1,0],["وقاتلتي بينَ الغواني كأنَّها","مصوَّرةٌ بالعينِ في حبَّةِ القلبِ",4,"ب",1,0],["وَقاتِلي ظُلماً بِإِعراضِهِ","وَلَحظِهِ بِالنَظَرِ المُغضي",5,"ض",2,0],["وقاتِلُ عُقْبَةٍ في يومِ بَدرٍ","أَيحفِلُ حِينَ يُقتلُ أو يُبالِي",6,"ل",2,0],["وَقاتَلتَ الغَداةَ قِتالَ صِدقٍ","فَلا شَلَّت يَداكَ أَبا الرَبابِ",7,"ب",1,1],["وَقاتِلِ الشُيوخِ وَالأَطفالِ","وَناهِبِ الأَرواحِ وَالأَموالِ",8,"ل",1,0],["وَقاتِلَ عَمرٍو قَد تَرَكنا مُجَدَّلاً","يَهِرُّ عَلَيهِ الذِئبُ عَرفاءَ جَيأَلا",9,"ل",2,0],["وقاتل الكذّاب في المعارك","وكلّ أفّاكٍ له مشارك",10,"ك",1,0],["وَقاتِلاً لِعَبدِهِ","وَمُسرِفاً في ظُلمِهِ",11,"م",2,0],["وقاتَلْتَ الغَداة َ قِتالَ صِدْقٍ","فلا شلَّت يداك أبا الّباب",12,"ب",1,1],["وقاتلت دوننا الأبواق صامدة","أم الرجال فماتوا ثم أو هربوا",13,"ب",3,0],["وقاتطرة ترمي الفضا بدخانها","وتملأ صدر الأرض في سيرها رعبا",14,"ا",1,0],["وَقاتَلَتِ العَنسُ شَطرَ النَها","رِ ثُمَّ تَوَلَّت مَعَ الصادِرِ",15,"ر",1,0],["وقاتلتهم فردا بحر قنا الوغي","فولوا وقالوا قد اتى العسكر الحر",16,"ر",1,0],["وقاتلٍ قل لي ماسِنُّها","فقلتُ ما في فمها سِنُّ",17,"ن",1,0],["وقاتلُ النفسِ لو صحّتْ عدالتُه","كمن يداوي بفقءِ المقلةِ الرمدا",18,"د",2,0],["وَقاتِل اللَه فيك طرفى","فَهو الَّذي قَد أَطاعَ وَجدك",19,"ك",1,0],["وقاتَلْتُ أحداثَ اللّيالي تَجارِياً","فَقتَّلْتُها عِلْماً وقَتّلْنني جَهْلا",20,"ل",2,0],["وقاتِلُنا هو المقتولُ فينا","وأَسْعَدُنا هو الأشقى الكئيبُ",21,"ب",1,0],["وقاتلُ المحلُ بالجدوى اذا خمدتْ","نارُ القرى واضحلت نشأة الدِّيم",22,"م",1,0],["وقاتلْنا وقتَّلنا","فما كنّا مقلّينا",23,"ن",2,0],["وقاتلي سحرٌ بأجفانِه","وليس لي طَرفٌ إلى قتلهِ",24,"ل",2,0],["وَقاتِلٌ في الصَلاةِ قَملَةً عَبَثاً","فَهَل يُعيدُ وَما المَشهورُ يا نُظَرا",25,"ر",2,0],["وَقاتل خاله بأَبيه منا","سماعة لم يبع حسباً بمالٍ",26,"ل",1,0],["وقاتَلَ في الأحزاب عَمراً ببأسهِ","وأَرداه مَقتولاً على الأرض يصرعُ",27,"ع",1,0],["وقاتل ابن البتول الطهر فهو كمن","عدا لها غاصباً في أول الزمن",28,"ن",1,0],["وقاتل الكفار إذ لم يستبن","للغير مجروحاً ولا طعينا",29,"ن",2,0],["وَقَاتلَ حَتَّى مَاتَ أكرَمَ مِيتَةٍ","بأَبيَضَ صَافٍ كَالعَقِيقَةِ بَاتِر",30,"ر",1,0],["وَقَاتَلَ حَتَّى مَاتَ أَكرَمَ مِيتَةٍ","وَخَرَّ عَلَى وَجهٍ كَرِيمش وَحَاجِبِ",31,"ب",1,0],["وَقَاتِلٍ حَوْباءَهُ مِن أَجْلِي","لَيْسَ لَهُ مِثْلِي وَأَيْنَ مِثْلِي",32,"ل",2,0],["وقاتِم الأَعْماقِ خاوِي المُخْتَرَقْ","مُشْتَبِه الأَعْلامِ لَمّاعِ الخَفَقْ",33,"ق",1,1],["وَقاتَلتُهُ وَالناسُ قَد أَذعَنوا لَهُ","وَقَد أَقشَعَ الأَحياءُ عَنهُ جَميعا",34,"ع",2,0],["وقاتلَ أتراباً ربائبَ كُلّما","برزنَ تناهبْن الفؤادَ المُشغَّفا",35,"ف",2,0],["وقاتلَ المحل جوداً","في كلِّ أزمةٍ محلِ",36,"ل",1,0],["وقاتل الله أدوار السنين فكم","مزجن بالسمّ ما احلولى من الشهدِ",37,"د",1,0],["وقاتل يا عذول سواي إني","بسيف صدودها الماضي قتيل",38,"ل",1,0],["وقاتل صمَّة الهندي منا","ومنا بعد ذا المتصعلكونا",39,"ن",2,0],["وقاتل المحْلِ فحُلَّ وارْحَلِ","فالأرضُ بينَ رَوْضة ومَنْهَل",40,"ل",1,0],["وقاتل طود اليوم والباب ترسه","يجول به للقوم في كل مرصد",41,"د",1,0],["وقاتله بالنشاب إن خفت كيده","إذا ما دنا فادفع بما شئت واطرد",42,"د",1,0],["وَقاتَلتَ حَتّى لا تَرى لَكَ مَطمَعاً","بِسَيفِكَ في القَومِ الَّذينَ تَحزَّبوا",43,"ب",3,0],["وَقاتلُ الجسمِ مَقتولٌ بِفعلَتِهِ","وَقاتلُ الرُّوحِ لا تَدري بِهِ البَشَرُ",44,"ر",1,0],["وقاتلت أعدائي بأصلت ما به","اذا صلت في الحرب العوان فلول",45,"ل",1,0],["وقاتَلوا ذَويهِ حتّى وَصَلوا","واقتَحَموا الدارَ وفيها دَخَلوا",46,"ل",3,0],["وقاتَلَ القومَ قتالاً باهرا","وقاتلَ الجيوشَ والعساكرا",47,"ر",2,0],["وَقاتِلَتي بَعدَ الذِّماءِ وَعائِدٍ","عَلَيَّ خَيالٌ مِنك مُذْ أَنا يافِعُ",48,"ع",1,0],["وَقاتلَ تَكذيبي العَيافَة بَعدَما","زَجَرتُ فَما أَغنى اعتِيافي وَلا زَجْري",49,"ر",2,0],["وقاتل موسى ما تاسف بل بدت","افاعيل منه مؤذناتٍ ببشراه",50,"ا",2,0],["وقاتل مرحب إذ لم يجد","غنىً بأسياف وأتراسِ",51,"س",1,0],["وقاتِلوه باءوا بشر","في هذه الدار ثم الأخرى",52,"ر",2,0],["وقاتل من لم يدخل الدين طائعا","وشن على أعدائه الغارة الشعوا",53,"و",2,0],["وقاتل بسيف الوحي كل معاندٍ","فليس له من نبوة حين تضرب",54,"ب",1,0],["وقاتل في المعارك مستميتا","وحيث مضيت لاتبغ الرجوعا",55,"ع",2,0],["وقاتلَ اللَهُ الحُداةَ فَلَكم","شَرٍّ على الأَفواه مِنهُم قَ جَرى",56,"ا",1,0],["وقاتل النفس ظلماً جاءه خبر","وسُرَّ بالفعل من قد جاء بالجمل",57,"ل",1,0],["وقاتل بعضُهم بعضاً سفاهاً","وإنّ عدوَّنا لهوَ المُشيرُ",58,"ر",1,0],["وقاتل الأطفال والسلام","والحمام والنسرين.",59,"ن",1,0],["وقاتلهم حتى يفيئوا إلى الهدى","ولا نأخذ الأموال نهباً كما تبد",60,"د",1,0],["وقاتلهم لما أبوا وتمردوا","وقد شردوا عن دعوة الحق للضد",60,"د",1,0],["وقاتلَ روحَ الحضارة ليلٌ","وصانعَ وَهْمَ الخرافةِ شَعْبُ",61,"ب",1,0],["وَقاتِل النَّفْسَ أَنْ يُزْرِي بِلُبِّكَ ما","يَشُوقُها مِنْ مَلاهِيها وَيَخْلُبُها",62,"ب",3,0],["\"وقاتم الأعماق خاوي المخترقْ","مشتبه النسبة لماع الخفقْ\"",63,"ق",1,0],["وقاتلهم ربي كما قاتلوا الورى","وشتت شملا جمعته المهازل",64,"ل",1,0],["وقاتل من لم يدخل الدين طائعا","وشن على أعدائه الغارة العشوا",65,"و",2,0],["وقاتلت كلَّ إحساسٍ مواجعُهُ","تضيئ صمتَ الليالي كلَّما أفِلا",66,"ل",2,0]]}