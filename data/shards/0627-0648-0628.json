مل"],[436,"لمن ربوع مقفرات باللوى","https://www.aldiwan.net/poem12472.html","الرجز"],[456,"مهد الحضارة للعروبة كلها","https://www.aldiwan.net/poem61290.html","الكامل"],[456,"أرشد الله أمة الإسلام","https://www.aldiwan.net/poem61362.html","الخفيف"],[456,"الشاعر القروي في تكريمنا","https://www.aldiwan.net/poem61569.html","الكامل"],[456,"من دمعة الشعب ومن كده","https://www.aldiwan.net/poem61803.html","السريع"],[461,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[461,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[467,"وافى فهز من القوام مثقفاً","https://www.aldiwan.net/poem3220.html","عموديه"],[467,"شم لأثيلات الحمى وضاله","https://www.aldiwan.net/poem3426.html","عموديه"],[473,"لتارك أرضكم من غير مقلية","https://www.aldiwan.net/poem4667.html","البسيط"],[486,"إن الخليط أجد البين فابتكروا","https://www.aldiwan.net/poem2067.html","البسيط"],[517,"ضربوا القباب وطنبوها بالقنا","https://www.aldiwan.net/poem20802.html","الكامل"],[543,"يا ابن الفواطم خير الناس كلهم","https://www.aldiwan.net/poem56823.html","البسيط"],[561,"أنا أدرى كنه ذاته","https://www.aldiwan.net/poem33517.html","مجزوء الرمل"],[561,"أيها الشخص الذي قال أنا","https://www.aldiwan.net/poem33808.html","الرمل"],[561,"إن شربي شرب الجمال الهيم","https://www.aldiwan.net/poem33882.html","الخفيف"],[561,"قل لعباد الخيال","https://www.aldiwan.net/poem34200.html","مجزوء الرمل"],[561,"إن ترم أن تعرف الأحوال","https://www.aldiwan.net/poem34230.html","المديد"],[561,"شمعتي أشرقت بنورك ربي","https://www.aldiwan.net/poem34431.html","الخفيف"],[570,"وليلة فيها قصر","https://www.aldiwan.net/poem69645.html","مجزوء الرجز"],[571,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[589,"بتثني قوامك الممشوق","https://www.aldiwan.net/poem17628.html","الخفيف"],[874,"","https://poetry.dctabudhabi.ae/diwan/poem/17714","الكامل"],[1081,"","https://poetry.dctabudhabi.ae/diwan/poem/2562","الخفيف"],[1140,"","https://poetry.dctabudhabi.ae/diwan/poem/29459","الكامل"]],"verses":[["أَو بَعدَ أَن أَدمى مَديحُكَ خاطِري","بِصِقالِ لَفظٍ أَو طِلابِ مَعاني",0,"ن",2,0],["أَو بَلَّغوا عَن واجِدٍ","لَفَّ الضُلوعَ عَلى الغَرامِ",1,"م",1,0],["أَو بَعدَما رَفَعوا القِبابَ وَخَوَّلوا","في ظِلِّ مُمتَنِعِ المَقامِ ظَليلِ",2,"ل",1,0],["أَو بائِتٍ يَرعى النُجومَ لِغارَةٍ","وَيَعُدُّ لِلمَغدى قَناً وَنِصالا",3,"ل",2,0],["أَو بالِغاً بِالنَفسِ مَعذِرَةً","وَالسَعيُ بَينَ النُجحِ وَالعُذرِ",4,"ر",1,0],["أَو بِنيَةٌ لِلمَجدِ شيدَ أَساسُه","إِلّا وَقَد هَدَمَ القَضاءُ وَطيدَها",5,"د",3,0],["أوْ بأَسْمِيرَ لَنا منْ سمَرٍ","أو علَى ناظورِها منْ مُجتمَعْ",6,"ع",1,0],["أَوَ بَعْدَ شَطْرِ الْحَوْلِ مغْتَرِباً عَلَى","حُكْمِ اللَّيَالِي نَازِحَ الأَوْطَانِ",7,"ن",1,0],["أو بالسلاح لم يستطع عن نفسه","دَفْعاً فَمَدَّ لَهَا يَدَ الْمُسْتَسْلِمِ",8,"م",1,0],["أو بسُلْوانٍ لمَنْ في رِيّةٍ","جِسْمُهُ والقلْبُ في وادِي الأشا",9,"ش",2,0],["أَو بَيضَةٍ في الدِعصِ مَكنونَةٍ","أَو دُرَّةٍ شيفَت لَدى تاجِرِ",10,"ر",1,0],["أَوْ بَاحِثٍ عَمَّا طَوَتْ أَسْفَارُهَا","طَيَّ الجَوَاهِرِ فِي بُطُونِ مَنَاجِمِ",11,"م",1,0],["أَو بِأَنانِ البومِ أَو صَوتِ الصَدى","أَو خالَطَ البيدَ الدَجِيَّ الأَسوَدا",12,"د",2,0],["أَو بارِدُ الصَيفِ مَسجورٌ مَزارِعُهُ","سودُ الذَوائِبِ مِمّا مَتَّعَت هَجَرُ",13,"ر",1,0],["أو بشمس النهارِ والبدر والزُّه","رة عند التثليث والتسديس",14,"س",1,0],["أو بقول الناس عوداً وبدءاً","يا لقوم باخ ذاك الشعاع",15,"ع",1,0],["أَو بُلبُلَ الرَوضِ ما لَذَّ لي","الاِنشادُ إِن لَم يَكُن في مَسمَعِك",16,"ك",1,0],["أو بشوكٍ يُدمي الفَضيلةَ والحُبَّ","ويقضي على بهاءِ الوُجودِ",17,"د",1,0],["أَو بِالحَياةِ وَقَد مَشى في صَفوِها","عادي السِنينَ وَعاثَ عادي الداءِ",18,"ا",2,0],["أَو بِاِبنِ داوُدٍ وَواسِعِ مُلكِهِ","وَمَعالِمٍ لِلعِزِّ فيهِ كِبارِ",19,"ر",1,0],["أَو بَلَّغَتنيهِ الرِكابُ فَقَد أَنى","لِمُقَلقَلٍ في الأَرضِ أَن يَتَدَبَّرا",20,"ر",2,0],["أَو بَينَ حَيِّ أَبي نَعامَةَ هارِباً","أَو بِاللَحاقِ بِطَيِّءِ الأَجبالِ",21,"ل",1,0],["أَو بَيضَةُ الأُدحِيِّ باتَ شِعارَها","كَنَفا النَعامَةِ جُؤجُؤٌ وَعِفاءُ",22,"ا",2,0],["أو بالغٍ سرَّ الذكاء الذي","يكادُ في لحظك أن يَتَّقِد",23,"د",1,0],["أَو بَحرِ نَحرٍ بِالحَبابِ مُقَلَّدٍ","أَو وَجهِ خَرقٍ بِالضَريبِ مُلَثَّمِ",24,"م",1,0],["أَو بِشِملِ شالَ مِن خَصبَةٍ","جُرِّدَت لِلناسِ بَعدَ الكِمام",25,"م",1,0],["أَوْ بتقبيلِ راحةٍ كانَ لل","هِ وباللَّه أخذها والعطاءُ",26,"ا",2,0],["أَوْ بِلَثْمِ التُّرَابِ مِنْ قَدَمٍ لا","نَتْ حَياءً من مَشْيِهَا الصَّفْواءُ",26,"ا",2,0],["أَو باتَ بِالمَخرَجِ مِن تُهمَتي","إِيّاهُ في خاتَمِهِ الأَحمَرِ",27,"ر",1,0],["أَو بِكَ أَبغي أَقيسُ نَفسي","زُنبورُ يا واسِعَ السِلافِ",28,"ف",1,0],["أَو بِتُّ في صَهوَةَ مُستَوطِناً","أُمسي مَعَ الأَغفارِ أَو أُصبَحُ",29,"ح",1,0],["أو بَكّرَ الوَسمِيُّ يَطْلُبُ أَرضَه","نَفِدَ الرّبيعُ وتُرْبُها لم يُوسمِ",30,"م",1,0],["أَوْ بَيْضَةٌ بَيْنَ أَجْمَادٍ يُقَلِّبُهَا","بِالمَنْكَبيْنِ سُخَامُ الزِّفِّ إِجْفِيلُ",31,"ل",1,0],["أَو بِنيَةٌ لِلمَجدِ شيدَ أَساسُها","إِلّا وَقَد هَدَمَ القَضاءُ وَطيدَها",32,"د",3,0],["أَو بَدَتْ سَاخِرَةً مِنْ نَفْسِهَا","تُطْرِيءُ الْجَهْلَ وَمَا كانَ لِيُطْرَا",33,"ر",2,0],["أو بِنيَة من ناطحا","ت السُّحب تومئ بالسجود",34,"د",1,0],["أو بَيْن أهرامٍ، وبَيْن دَوائرٍ","مَجْهُولةِ الأحْجامِ والأطْوالِ",35,"ل",1,0],["أو بين أفعالٍ صَحاحٍ ما شَكَت","عِللاً، ومُعْتلٍّ من الأَفْعالِ",35,"ل",1,0],["أو بعد شطر الحول مغتربا على","حكم الليالي نازع الأوطان",36,"ن",1,0],["أو بالسلاح سيستطع عن نفسه","دفعا فمد لها يد المستسلم",37,"م",1,0],["أو بسلوان لمن في رية","جمسه والقلب في وادي الأشا",38,"ش",2,0],["أو بعدَما بَرَقَتْ أسِرَّتُّه لنا","وبدت مخايلُ حسنِه وبهائه",39,"ا",3,0],["أو بشكل يدعو إلى استحياء","أو بشكل يدعو إلى الاعجاب",40,"ب",1,0],["أوْ بَلّغَتْنِيهِ الرّكابُ، فقَد أتَى","لمُقَلْقَلٍ في الأرْضِ أنْ يَتَدَبّرَا",41,"ر",2,0],["أو بنكرو أدبي فلا تتعجبوا","فالرمد طلوع ذكاء",42,"ا",2,0],["أوْ بَينَ حَيّ أبي نَعَامَةَ هَارِباً،","أوْ بِاللّحَاقِ بطَيّيء الأجْبَالِ",43,"ل",1,0],["أو بكلامي مُوعداً وواعدا","ما كُّل من وافق جَدَّا صاعدا",44,"د",2,0],["أو بالتعالي والجفا","من قال هذا ما صدق",45,"ق",1,0],["أوبعد هذا هل علي وصاحبي","حرج إِذا ناديت يا برفين",46,"ن",1,0],["أَوْ بَرَداً قَدْ أُدِيرَ دائِرةً","مِنْ فَوقِ نارٍ بِغيرِ تَسْعيرِ",47,"ر",1,0],["أَوَ بعدَ أن عمّ العوا","لمَ نوره يطفيه نافِخ",48,"خ",1,0],["أو بالنسيم إذا ثنى غُصُناً","فأرى انثناء العطف كالكسرِ",49,"ر",1,0],["أو بالغصون تكلَّلتْ زَهَراً","فأتتْكَ بالأجيادِ والشذرِ",49,"ر",1,0],["أو بلبل لأشنّف الأسماع بالن","غم الرقيق على ذرى الأشجار",50,"ر",1,0],["أو بعتُ وجداني بأس","واقِ النفاقِ لأكرموني",51,"ن",2,0],["أو بتُّ أسَمع فيها","إِسحاقَ ابنَ ابرَهيما",52,"م",2,0],["أوبي جناح إن سمحت بعبرة","عما تضمنت الحوانح عبّرت",53,"ت",1,0],["أَو بِتُّ شِلوَ الهَمِّ تَم","ضَغُني الخَطوب بِما ضَغينِ",54,"ن",1,0],["أَوْ بَرَاهُ النَّسِيمُ شَيْئاً فَشَيْئاً","فاسْتَحالَ كَالْخِشْلِشَخْتَ الصِّفَاتِ",55,"ت",1,0],["أَوْ بَارِضٍ لاَ بَرْضِ","فِي مُسْتَوٍ مِنْ أَرْضِ",56,"ض",1,0],["أو باقةٌ تجمعُ الأزهارَ عقدتُها","كدملجٍ مثل قلبي عندَهُ قَلق",57,"ق",1,0],["أو بالدفوف وهزها","عند العشية والسحر",58,"ر",1,0],["أو بالقيان وبالمعا","رف والتكاسل والبطر",58,"ر",1,0],["أَو (بنت عمرو) تُنشي روائعَها","و(بنت عمران) بعد ذا ورعا",59,"ع",2,0],["أَو باغِيانِ لِبُعرانٍ لَنا رَفَضَت","كَي لا تُحِسّونَ مِن بُعرانِنا أَثَرا",60,"ر",2,0],["أو بلبلٌ أضحى بروضةِ خده","لولا جوارحُ مقلتيه لغردا",61,"د",2,0],["أو بأوطاننا وحيث تشأنا","وأقامت أسلافنا والأوائل",62,"ل",1,0],["أَو بَدا لي في الحلمِ طيفُ سلوٍّ","عَنهُ ضلّت نفسي عن الجثمانِ",63,"ن",1,0],["أَوْ بِالقُطارةِ أَو فَعَجلّ مُرْسَلاً","فَالعَيْشُ أصْبَحَ بَعْدَ حُلْوٍ صَابَا",64,"ب",2,0],["أَو بِفِكرٍ لا يُستَقَرُّ عَلى حالٍ","يُرينا عَينُ اليَقينِ خَيالُ",65,"ل",1,0],["أَو بَدا الزَهر مِن حدا","ئقِهِ الزُهر محدقا",66,"ق",2,0],["أَو بيع وَصلك لِلعاني بِمهجتهِ","فَإِنَّهُ بِالِّذي يُرضيك قَد سَمَحا",67,"ح",2,0],["أو بادرَني المَوتُ بقَطْعِ العُلَقِ","كم مِن دَيْنٍ كمثْلِ ذا في عُنُقي",68,"ي",1,0],["أَو بِمِرّيخٍ عَلَى شِريانَةٍ","حَشَّهُ الرَّامِي بِظُهرَانٍ حُشُرْ",69,"ر",1,0],["أَو بِالعَماليقِ الَّذي","نَ لَهُم بِها كانَ السَوامُ",70,"م",1,0],["أو بالطوال ففيها العلم أجمعه","خزائن هي للأحكام تختزن",71,"ن",1,0],["أوبَقْتَ نفسُكَ يا ظلو","مُ بِما احْتَقَبْتَ من المَظالِمْ",72,"م",1,0],["أوَ بَعدَ نَاهِيةِ المشيبِ جَهالةٌ","يأبى الوقارُ عليكَ والتّحلِيمُ",73,"م",1,0],["أو بجوادٍ أدهمٍ محجّلٍ","يسيرُ كالبرقِ إذا البرقُ بدا",74,"ا",1,0],["أو باس سيف الدولة العالي الذرى","المستعز بأصله في سهلها",75,"ل",3,0],["أو بنوها اللصوص من أوغلوا","ظلما وباهوا بالعسف والإجرام",76,"م",1,0],["أو بشّت الأديان عند عظاته","غلا لروح مسيحنا وكليمنا",77,"ن",2,0],["أو بادلته نكتةً حلوةً","إلاّ ومغزاها مدى نقده",78,"د",2,0],["أوبَ الغمامة بعدما انقشعت","بمفوَّف الأخلافِ منهلِّ",79,"ل",1,0],["أو بَسطَ اللهُ ربيعاً لهم","لم يَبطَروا في سَعةِ المَخْضَبِ",80,"ب",1,0],["أوبت من قلق كما باتت عدى","الملك المظفر من سطاه على الشفا",81,"ف",2,0],["أو بلَّ من غليله أو جاد إذ","ظنَّ بما يرجوه من إبلاله",82,"ل",2,0],["أَوبُ يَدَي سابِحٍ في الآلِ مُجتَهِدٍ","يَهوى يُقَحِّمُهُ ذو لُجَّةٍ زَبِدُ",83,"د",1,0],["أوبُ ذراعي لجوج جاد واحدها","حتى إذا ما انتهى أودى بهِ القدر",84,"ر",1,0],["أو بِعْنَ أنفُسَها الأهلّةُ صفقةً","منه بنعلِ حذائِه لن تُغبَنا",85,"ن",2,0],["أَو بقرُ بَطني جهاراً قمتُ أَبقرُهُ","حتَّى يُعالَجَ منِّي بَطنُ مَبقورِ",86,"ر",1,0],["أو بدا غصناً رطيباً","أنا أزهى زهراته",87,"ت",2,0],["أو بدا من ذاك شيء لك في","أحد عنك تناءى أو دنا",88,"ن",2,0],["أو بداعي الإلهام فاعتقدوني","لتنالوا ما نال كل حكيم",89,"م",1,0],["أو بعشق الهُيَّفِ المر","د وربات الحجال",90,"ل",1,0],["أو بفكر ذاك يحصل أو","بتعاني ذكره المتوال",91,"ل",1,0],["أو بأني في الناس أنقص قدراً","بكلام الأراذل الأوباش",92,"ش",1,0],["أو بادَرَ السَّيْلَ بَدَرْ","أَدْهَمُ كاللَّيْلِ اعْتَكَرْ",93,"ر",1,0],["أو بدل الجهاد أو أحالا","فروضه أو غير القتالا",94,"ل",2,0],["أو بدل المناسك المستنة","بغيرها مخالفا للسنة",94,"ه",1,0],["أَوْ بِإِرْسَالِكَ السَّلامَ مَعَ الرّي","حِ وَإِلّا فَبِالخيالِ الطّرُوقِ",95,"ق",1,0],["أَو بَيضَةُ الدِعصِ الَّتي وَضَعَت","في الأَرضِ لَيسَ لِمَسِّها حَجمُ",96,"م",1,0],["أَو بَني آكِلِ المُرارِ وَلا صي","دِ بَني جَفنَةَ المُلوكِ الطِوالِ",97,"ل",1,0],["أَو بَينَ مَمنُونٍ علَيهِ وقَومِهِ","إِن كانَ شاكِرَها وَإن لَم يَشكُرِ",98,"ر",1,0]]}