{"poems":[[53,"ونمى إلي من العجائب أنه","https://www.aldiwan.net/poem29657.html","الكامل"],[53,"أترى ديار الحي بال","https://www.aldiwan.net/poem29794.html","مجزوء الكامل"],[53,"إلا يكن نصلا فغمد نصول","https://www.aldiwan.net/poem29887.html","الكامل"],[53,"أكذا المنون تقنطر الأبطالا","https://www.aldiwan.net/poem29888.html","الكامل"],[53,"أوما رأيت وقائع الدهر","https://www.aldiwan.net/poem30444.html","الكامل"],[3,"جازت مُلمات الزمان حدوده","https://www.aldiwan.net/poem147.html",""],[77,"خدع الشوق فؤادي فانخدع","https://www.aldiwan.net/poem35986.html","الرمل"],[77,"ذكروا العهود فهاج من أشجاني","https://www.aldiwan.net/poem36070.html","الكامل"],[77,"فتحت سعودك كل باب مبهم","https://www.aldiwan.net/poem36122.html","الكامل"],[77,"يا هلالا يا قضيبا يا رشا","https://www.aldiwan.net/poem35869.html","الرمل"],[9,"شاقتك من قتلة أطلالها","https://www.aldiwan.net/poem21944.html","السريع"],[93,"دال السكون من الحراك الدائم","https://www.aldiwan.net/poem11373.html","الكامل"],[30,"قفا نحيي العرصات الهمدا","https://www.aldiwan.net/poem29604.html","الرجز"],[4,"راح القطين بهجر بعدما ابتكروا","https://www.aldiwan.net/poem21160.html","البسيط"],[51,"راع قلبي مشيب رأس خليس","https://www.aldiwan.net/poem64653.html","الخفيف"],[51,"يا تناه والتناهي انقطاع","https://www.aldiwan.net/poem65423.html","المديد"],[91,"لو أنني يا هند بدر السما","https://www.aldiwan.net/poem8978.html","عموديه"],[92,"بل يا بهاء هذا الوجود","https://www.aldiwan.net/poem38952.html","الخفيف"],[85,"يا أيها الناعي أبا الوزراء","https://www.aldiwan.net/poem62939.html","الكامل"],[85,"تلك الطبيعة قف بنا يا ساري","https://www.aldiwan.net/poem63715.html","الكامل"],[45,"لله عهد سويقة ما أنضرا","https://www.aldiwan.net/poem63603.html","الكامل"],[28,"تبكي المراغة بالرغام على ابنها","https://www.aldiwan.net/poem5481.html","الكامل"],[2,"صرمت جديد حبالها أسماء","https://www.aldiwan.net/poem25045.html","الكامل"],[97,"إني على كاسي أعيد السنين","https://www.aldiwan.net/poem24921.html","السريع"],[74,"وظلام ليل لا شهاب بأفقه","https://www.aldiwan.net/poem13246.html","الكامل"],[39,"شث شعب الحي التئام","https://www.aldiwan.net/poem53751.html","المديد"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[48,"فدتك نفسي يا أبا جعفر","https://www.aldiwan.net/poem63326.html","السريع"],[48,"عاتبني الشعر ذا إكاف","https://www.aldiwan.net/poem64411.html","مجزوء البسيط"],[46,"أستقبح الظاهر من صاحبي","https://www.aldiwan.net/poem22286.html","السريع"],[46,"أدنى الفوارس من يغير لمغنم","https://www.aldiwan.net/poem23639.html","الكامل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9915","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[106,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[106,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[77,"ذكروا العهود فهاج من أشجاني","https://www.poetsgate.com/ViewPoem.aspx?id=34168",""],[77,"فتحت سعودك كل باب مبهم","https://www.poetsgate.com/ViewPoem.aspx?id=34204",""],[77,"يا هلالا يا قضيبا يا رشا","https://www.poetsgate.com/ViewPoem.aspx?id=34195",""],[90,"بم أستهل","https://www.poetsgate.com/ViewPoem.aspx?id=179014",""],[90,"صورة للخواطر!","https://www.poetsgate.com/ViewPoem.aspx?id=179131",""],[45,"لله عَهْدُ سَوِيقَةٍ ما أنْضَرَا،","https://www.poetsgate.com/ViewPoem.aspx?id=31338",""],[91,"الفقير","https://www.poetsgate.com/ViewPoem.aspx?id=53421",""],[28,"لا قوم أكرم من تميم إذ غدت","https://www.poetsgate.com/ViewPoem.aspx?id=22081",""],[51,"يا أيها المرء الكريم والدا","https://www.poetsgate.com/ViewPoem.aspx?id=27704",""],[116,"ليس التصوف بالخرق","https://www.aldiwan.net/poem41767.html","مجزوء الكامل"],[125,"هلملم هلم نلم شعث قريضنا","https://www.aldiwan.net/poem23771.html","الكامل"],[156,"قم يا غلام اسقني مشعشعة","https://www.aldiwan.net/poem55690.html","المنسرح"],[190,"كم دون طيبة من فراسخ","https://www.aldiwan.net/poem35167.html","مجزوء الكامل"],[192,"قسماً بحسن الطل في الزهر","https://www.aldiwan.net/poem1315.html",""],[198,"يا ليتني فوق الغصون حمامة","https://www.aldiwan.net/poem39817.html","الكامل"],[198,"كفي الملام وعلليني","https://www.aldiwan.net/poem39948.html","مجزوء الكامل"],[230,"ليرغم الدهر أني","https://www.aldiwan.net/poem50825.html","المجتث"],[232,"ما بال أنفاس النسيم إذا سرت","https://www.aldiwan.net/poem44597.html","الكامل"],[236,"أترى تعود لنا كما","https://www.aldiwan.net/poem31737.html","مجزوء الكامل"],[238,"عللوني بالوصل قبل الممات","https://www.aldiwan.net/poem18082.html","الخفيف"],[238,"خلوا سبيل الحوض","https://www.aldiwan.net/poem19301.html","مجزوء الرجز"],[271,"أزنبق كفك البيضاء فالعبق","https://www.aldiwan.net/poem35444.html","البسيط"],[286,"الله أعظم هكذا الاسلام","https://www.aldiwan.net/poem39397.html","مجزوء الكامل"],[299,"هلم ننشد يا صاحبي معا","https://www.aldiwan.net/poem36288.html","عموديه"],[301,"تجلو بأخضر من نعمان ذا أشر","https://www.aldiwan.net/poem45489.html","البسيط"],[304,"وكأن ذاك الخال راهب بيعة","https://www.aldiwan.net/poem57947.html","الطويل"],[305,"ذكر العهد والربى والمنازل","https://www.aldiwan.net/poem16855.html","الخفيف"],[306,"رفع المجد راية للتهاني","https://www.aldiwan.net/poem56387.html","الوافر"],[349,"الخبز فت وزبدنا قد ذابا","https://www.aldiwan.net/poem19860.html","الكامل"],[350,"قل لمن رام للشريعة تتميما","https://www.aldiwan.net/poem15826.html","الخفيف"],[354,"رتب العز والتقى","https://www.aldiwan.net/poem40027.html","مجزوء الخفيف"],[354,"حيا الندامى بشمس الراح مصطبحا","https://www.aldiwan.net/poem40544.html","البسيط"],[365,"كم في قلبي لعينكم من حرق","https://www.aldiwan.net/poem60823.html","الدوبيت"],[368,"ثم إن ينزع إلى أقصاهما","https://www.aldiwan.net/poem4616.html","الرمل"],[390,"يا عمرو لا تفجر بمكة","https://www.aldiwan.net/poem2144.html","مجزوء الكامل"],[404,"الواردات علينا كلها منن","https://www.aldiwan.net/poem33403.html","البسيط"],[410,"فوض الأمر راضيا","https://www.aldiwan.net/poem31871.html","مجزوء الخفيف"],[410,"ما استجهلتك معالم ورسوم","https://www.aldiwan.net/poem32386.html","الكامل"],[433,"لمن ربوع مقفرات باللوى","https://www.aldiwan.net/poem12472.html","الرجز"],[454,"مهد الحضارة للعروبة كلها","https://www.aldiwan.net/poem61290.html","الكامل"],[454,"أرشد الله أمة الإسلام","https://www.aldiwan.net/poem61362.html","الخفيف"],[454,"الشاعر القروي في تكريمنا","https://www.aldiwan.net/poem61569.html","الكامل"],[454,"من دمعة الشعب ومن كده","https://www.aldiwan.net/poem61803.html","السريع"],[459,"مالي شرقت بماء ذي الأثل","https://www.aldiwan.net/poem55909.html","أحذ الكامل"],[459,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[465,"وافى فهز من القوام مثقفاً","https://www.aldiwan.net/poem3220.html","عموديه"],[465,"شم لأثيلات الحمى وضاله","https://www.aldiwan.net/poem3426.html","عموديه"],[471,"لتارك أرضكم من غير مقلية","https://www.aldiwan.net/poem4667.html","البسيط"],[484,"إن الخليط أجد البين فابتكروا","https://www.aldiwan.net/poem2067.html","البسيط"],[515,"ضربوا القباب وطنبوها بالقنا","https://www.aldiwan.net/poem20802.html","الكامل"],[541,"يا ابن الفواطم خير الناس كلهم","https://www.aldiwan.net/poem56823.html","البسيط"],[559,"أنا أدرى كنه ذاته","https://www.aldiwan.net/poem33517.html","مجزوء الرمل"],[559,"أيها الشخص الذي قال أنا","https://www.aldiwan.net/poem33808.html","الرمل"],[559,"إن شربي شرب الجمال الهيم","https://www.aldiwan.net/poem33882.html","الخفيف"],[559,"قل لعباد الخيال","https://www.aldiwan.net/poem34200.html","مجزوء الرمل"],[559,"إن ترم أن تعرف الأحوال","https://www.aldiwan.net/poem34230.html","المديد"],[559,"شمعتي أشرقت بنورك ربي","https://www.aldiwan.net/poem34431.html","الخفيف"],[568,"وليلة فيها قصر","https://www.aldiwan.net/poem69645.html","مجزوء الرجز"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[587,"بتثني قوامك الممشوق","https://www.aldiwan.net/poem17628.html","الخفيف"]],"verses":[["أَو بَعدَ أَن أَدمى مَديحُكَ خاطِري","بِصِقالِ لَفظٍ أَو طِلابِ مَعاني",0,"ن",2,0],["أَو بَلَّغوا عَن واجِدٍ","لَفَّ الضُلوعَ عَلى الغَرامِ",1,"م",1,0],["أَو بَعدَما رَفَعوا القِبابَ وَخَوَّلوا","في ظِلِّ مُمتَنِعِ المَقامِ ظَليلِ",2,"ل",1,0],["أَو بائِتٍ يَرعى النُجومَ لِغارَةٍ","وَيَعُدُّ لِلمَغدى قَناً وَنِصالا",3,"ل",2,0],["أَو بالِغاً بِالنَفسِ مَعذِرَةً","وَالسَعيُ بَينَ النُجحِ وَالعُذرِ",4,"ر",1,0],["أَو بِنيَةٌ لِلمَجدِ شيدَ أَساسُه","إِلّا وَقَد هَدَمَ القَضاءُ وَطيدَها",5,"د",3,0],["أوْ بأَسْمِيرَ لَنا منْ سمَرٍ","أو علَى ناظورِها منْ مُجتمَعْ",6,"ع",1,0],["أَوَ بَعْدَ شَطْرِ الْحَوْلِ مغْتَرِباً عَلَى","حُكْمِ اللَّيَالِي نَازِحَ الأَوْطَانِ",7,"ن",1,0],["أو بالسلاح لم يستطع عن نفسه","دَفْعاً فَمَدَّ لَهَا يَدَ الْمُسْتَسْلِمِ",8,"م",1,0],["أو بسُلْوانٍ لمَنْ في رِيّةٍ","جِسْمُهُ والقلْبُ في وادِي الأشا",9,"ش",2,0],["أَو بَيضَةٍ في الدِعصِ مَكنونَةٍ","أَو دُرَّةٍ شيفَت لَدى تاجِرِ",10,"ر",1,0],["أَوْ بَاحِثٍ عَمَّا طَوَتْ أَسْفَارُهَا","طَيَّ الجَوَاهِرِ فِي بُطُونِ مَنَاجِمِ",11,"م",1,0],["أَو بِأَنانِ البومِ أَو صَوتِ الصَدى","أَو خالَطَ البيدَ الدَجِيَّ الأَسوَدا",12,"د",2,0],["أَو بارِدُ الصَيفِ مَسجورٌ مَزارِعُهُ","سودُ الذَوائِبِ مِمّا مَتَّعَت هَجَرُ",13,"ر",1,0],["أو بشمس النهارِ والبدر والزُّه","رة عند التثليث والتسديس",14,"س",1,0],["أو بقول الناس عوداً وبدءاً","يا لقوم باخ ذاك الشعاع",15,"ع",1,0],["أَو بُلبُلَ الرَوضِ ما لَذَّ لي","الاِنشادُ إِن لَم يَكُن في مَسمَعِك",16,"ك",1,0],["أو بشوكٍ يُدمي الفَضيلةَ والحُبَّ","ويقضي على بهاءِ الوُجودِ",17,"د",1,0],["أَو بِالحَياةِ وَقَد مَشى في صَفوِها","عادي السِنينَ وَعاثَ عادي الداءِ",18,"ا",2,0],["أَو بِاِبنِ داوُدٍ وَواسِعِ مُلكِهِ","وَمَعالِمٍ لِلعِزِّ فيهِ كِبارِ",19,"ر",1,0],["أَو بَلَّغَتنيهِ الرِكابُ فَقَد أَنى","لِمُقَلقَلٍ في الأَرضِ أَن يَتَدَبَّرا",20,"ر",2,0],["أَو بَينَ حَيِّ أَبي نَعامَةَ هارِباً","أَو بِاللَحاقِ بِطَيِّءِ الأَجبالِ",21,"ل",1,0],["أَو بَيضَةُ الأُدحِيِّ باتَ شِعارَها","كَنَفا النَعامَةِ جُؤجُؤٌ وَعِفاءُ",22,"ا",2,0],["أو بالغٍ سرَّ الذكاء الذي","يكادُ في لحظك أن يَتَّقِد",23,"د",1,0],["أَو بَحرِ نَحرٍ بِالحَبابِ مُقَلَّدٍ","أَو وَجهِ خَرقٍ بِالضَريبِ مُلَثَّمِ",24,"م",1,0],["أَو بِشِملِ شالَ مِن خَصبَةٍ","جُرِّدَت لِلناسِ بَعدَ الكِمام",25,"م",1,0],["أَوْ بتقبيلِ راحةٍ كانَ لل","هِ وباللَّه أخذها والعطاءُ",26,"ا",2,0],["أَوْ بِلَثْمِ التُّرَابِ مِنْ قَدَمٍ لا","نَتْ حَياءً من مَشْيِهَا الصَّفْواءُ",26,"ا",2,0],["أَو باتَ بِالمَخرَجِ مِن تُهمَتي","إِيّاهُ في خاتَمِهِ الأَحمَرِ",27,"ر",1,0],["أَو بِكَ أَبغي أَقيسُ نَفسي","زُنبورُ يا واسِعَ السِلافِ",28,"ف",1,0],["أَو بِتُّ في صَهوَةَ مُستَوطِناً","أُمسي مَعَ الأَغفارِ أَو أُصبَحُ",29,"ح",1,0],["أو بَكّرَ الوَسمِيُّ يَطْلُبُ أَرضَه","نَفِدَ الرّبيعُ وتُرْبُها لم يُوسمِ",30,"م",1,0],["أَو بِنيَةٌ لِلمَجدِ شيدَ أَساسُها","إِلّا وَقَد هَدَمَ القَضاءُ وَطيدَها",31,"د",3,0],["أَو بَدَتْ سَاخِرَةً مِنْ نَفْسِهَا","تُطْرِيءُ الْجَهْلَ وَمَا كانَ لِيُطْرَا",32,"ر",2,0],["أو بِنيَة من ناطحا","ت السُّحب تومئ بالسجود",33,"د",1,0],["أو بَيْن أهرامٍ، وبَيْن دَوائرٍ","مَجْهُولةِ الأحْجامِ والأطْوالِ",34,"ل",1,0],["أو بين أفعالٍ صَحاحٍ ما شَكَت","عِللاً، ومُعْتلٍّ من الأَفْعالِ",34,"ل",1,0],["أو بعد شطر الحول مغتربا على","حكم الليالي نازع الأوطان",35,"ن",1,0],["أو بالسلاح سيستطع عن نفسه","دفعا فمد لها يد المستسلم",36,"م",1,0],["أو بسلوان لمن في رية","جمسه والقلب في وادي الأشا",37,"ش",2,0],["أو بعدَما بَرَقَتْ أسِرَّتُّه لنا","وبدت مخايلُ حسنِه وبهائه",38,"ا",3,0],["أو بشكل يدعو إلى استحياء","أو بشكل يدعو إلى الاعجاب",39,"ب",1,0],["أوْ بَلّغَتْنِيهِ الرّكابُ، فقَد أتَى","لمُقَلْقَلٍ في الأرْضِ أنْ يَتَدَبّرَا",40,"ر",2,0],["أو بنكرو أدبي فلا تتعجبوا","فالرمد طلوع ذكاء",41,"ا",2,0],["أوْ بَينَ حَيّ أبي نَعَامَةَ هَارِباً،","أوْ بِاللّحَاقِ بطَيّيء الأجْبَالِ",42,"ل",1,0],["أو بكلامي مُوعداً وواعدا","ما كُّل من وافق جَدَّا صاعدا",43,"د",2,0],["أو بالتعالي والجفا","من قال هذا ما صدق",44,"ق",1,0],["أوبعد هذا هل علي وصاحبي","حرج إِذا ناديت يا برفين",45,"ن",1,0],["أَوْ بَرَداً قَدْ أُدِيرَ دائِرةً","مِنْ فَوقِ نارٍ بِغيرِ تَسْعيرِ",46,"ر",1,0],["أَوَ بعدَ أن عمّ العوا","لمَ نوره يطفيه نافِخ",47,"خ",1,0],["أو بالنسيم إذا ثنى غُصُناً","فأرى انثناء العطف كالكسرِ",48,"ر",1,0],["أو بالغصون تكلَّلتْ زَهَراً","فأتتْكَ بالأجيادِ والشذرِ",48,"ر",1,0],["أو بلبل لأشنّف الأسماع بالن","غم الرقيق على ذرى الأشجار",49,"ر",1,0],["أو بعتُ وجداني بأس","واقِ النفاقِ لأكرموني",50,"ن",2,0],["أو بتُّ أسَمع فيها","إِسحاقَ ابنَ ابرَهيما",51,"م",2,0],["أوبي جناح إن سمحت بعبرة","عما تضمنت الحوانح عبّرت",52,"ت",1,0],["أَو بِتُّ شِلوَ الهَمِّ تَم","ضَغُني الخَطوب بِما ضَغينِ",53,"ن",1,0],["أَوْ بَرَاهُ النَّسِيمُ شَيْئاً فَشَيْئاً","فاسْتَحالَ كَالْخِشْلِشَخْتَ الصِّفَاتِ",54,"ت",1,0],["أَوْ بَارِضٍ لاَ بَرْضِ","فِي مُسْتَوٍ مِنْ أَرْضِ",55,"ض",1,0],["أو باقةٌ تجمعُ الأزهارَ عقدتُها","كدملجٍ مثل قلبي عندَهُ قَلق",56,"ق",1,0],["أو بالدفوف وهزها","عند العشية والسحر",57,"ر",1,0],["أو بالقيان وبالمعا","رف والتكاسل والبطر",57,"ر",1,0],["أَو (بنت عمرو) تُنشي روائعَها","و(بنت عمران) بعد ذا ورعا",58,"ع",2,0],["أَو باغِيانِ لِبُعرانٍ لَنا رَفَضَت","كَي لا تُحِسّونَ مِن بُعرانِنا أَثَرا",59,"ر",2,0],["أو بلبلٌ أضحى بروضةِ خده","لولا جوارحُ مقلتيه لغردا",60,"د",2,0],["أو بأوطاننا وحيث تشأنا","وأقامت أسلافنا والأوائل",61,"ل",1,0],["أَو بَدا لي في الحلمِ طيفُ سلوٍّ","عَنهُ ضلّت نفسي عن الجثمانِ",62,"ن",1,0],["أَوْ بِالقُطارةِ أَو فَعَجلّ مُرْسَلاً","فَالعَيْشُ أصْبَحَ بَعْدَ حُلْوٍ صَابَا",63,"ب",2,0],["أَو بِفِكرٍ لا يُستَقَرُّ عَلى حالٍ","يُرينا عَينُ اليَقينِ خَيالُ",64,"ل",1,0],["أَو بَدا الزَهر مِن حدا","ئقِهِ الزُهر محدقا",65,"ق",2,0],["أَو بيع وَصلك لِلعاني بِمهجتهِ","فَإِنَّهُ بِالِّذي يُرضيك قَد سَمَحا",66,"ح",2,0],["أو بادرَني المَوتُ بقَطْعِ العُلَقِ","كم مِن دَيْنٍ كمثْلِ ذا في عُنُقي",67,"ي",1,0],["أَو بِمِرّيخٍ عَلَى شِريانَةٍ","حَشَّهُ الرَّامِي بِظُهرَانٍ حُشُرْ",68,"ر",1,0],["أَو بِالعَماليقِ الَّذي","نَ لَهُم بِها كانَ السَوامُ",69,"م",1,0],["أو بالطوال ففيها العلم أجمعه","خزائن هي للأحكام تختزن",70,"ن",1,0],["أوبَقْتَ نفسُكَ يا ظلو","مُ بِما احْتَقَبْتَ من المَظالِمْ",71,"م",1,0],["أوَ بَعدَ نَاهِيةِ المشيبِ جَهالةٌ","يأبى الوقارُ عليكَ والتّحلِيمُ",72,"م",1,0],["أو بجوادٍ أدهمٍ محجّلٍ","يسيرُ كالبرقِ إذا البرقُ بدا",73,"ا",1,0],["أو باس سيف الدولة العالي الذرى","المستعز بأصله في سهلها",74,"ل",3,0],["أو بنوها اللصوص من أوغلوا","ظلما وباهوا بالعسف والإجرام",75,"م",1,0],["أو بشّت الأديان عند عظاته","غلا لروح مسيحنا وكليمنا",76,"ن",2,0],["أو بادلته نكتةً حلوةً","إلاّ ومغزاها مدى نقده",77,"د",2,0],["أوبَ الغمامة بعدما انقشعت","بمفوَّف الأخلافِ منهلِّ",78,"ل",1,0],["أو بَسطَ اللهُ ربيعاً لهم","لم يَبطَروا في سَعةِ المَخْضَبِ",79,"ب",1,0],["أوبت من قلق كما باتت عدى","الملك المظفر من سطاه على الشفا",80,"ف",2,0],["أو بلَّ من غليله أو جاد إذ","ظنَّ بما يرجوه من إبلاله",81,"ل",2,0],["أَوبُ يَدَي سابِحٍ في الآلِ مُجتَهِدٍ","يَهوى يُقَحِّمُهُ ذو لُجَّةٍ زَبِدُ",82,"د",1,0],["أوبُ ذراعي لجوج جاد واحدها","حتى إذا ما انتهى أودى بهِ القدر",83,"ر",1,0],["أو بِعْنَ أنفُسَها الأهلّةُ صفقةً","منه بنعلِ حذائِه لن تُغبَنا",84,"ن",2,0],["أَو بقرُ بَطني جهاراً قمتُ أَبقرُهُ","حتَّى يُعالَجَ منِّي بَطنُ مَبقورِ",85,"ر",1,0],["أو بدا غصناً رطيباً","أنا أزهى زهراته",86,"ت",2,0],["أو بدا من ذاك شيء لك في","أحد عنك تناءى أو دنا",87,"ن",2,0],["أو بداعي الإلهام فاعتقدوني","لتنالوا ما نال كل حكيم",88,"م",1,0],["أو بعشق الهُيَّفِ المر","د وربات الحجال",89,"ل",1,0],["أو بفكر ذاك يحصل أو","بتعاني ذكره المتوال",90,"ل",1,0],["أو بأني في الناس أنقص قدراً","بكلام الأراذل الأوباش",91,"ش",1,0],["أو بادَرَ السَّيْلَ بَدَرْ","أَدْهَمُ كاللَّيْلِ اعْتَكَرْ",92,"ر",1,0],["أو بدل الجهاد أو أحالا","فروضه أو غير القتالا",93,"ل",2,0],["أو بدل المناسك المستنة","بغيرها مخالفا للسنة",93,"ه",1,0],["أَوْ بِإِرْسَالِكَ السَّلامَ مَعَ الرّي","حِ وَإِلّا فَبِالخيالِ الطّرُوقِ",94,"ق",1,0]]}