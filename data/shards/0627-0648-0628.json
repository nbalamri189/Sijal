{"poems":[[53,"ونمى إلي من العجائب أنه","https://www.aldiwan.net/poem29657.html","الكامل"],[53,"أترى ديار الحي بال","https://www.aldiwan.net/poem29794.html","مجزوء الكامل"],[53,"إلا يكن نصلا فغمد نصول","https://www.aldiwan.net/poem29887.html","الكامل"],[53,"أكذا المنون تقنطر الأبطالا","https://www.aldiwan.net/poem29888.html","الكامل"],[53,"أوما رأيت وقائع الدهر","https://www.aldiwan.net/poem30444.html","الكامل"],[3,"جازت مُلمات الزمان حدوده","https://www.aldiwan.net/poem147.html",""],[77,"خدع الشوق فؤادي فانخدع","https://www.aldiwan.net/poem35986.html","الرمل"],[77,"ذكروا العهود فهاج من أشجاني","https://www.aldiwan.net/poem36070.html","الكامل"],[77,"فتحت سعودك كل باب مبهم","https://www.aldiwan.net/poem36122.html","الكامل"],[77,"يا هلالا يا قضيبا يا رشا","https://www.aldiwan.net/poem35869.html","الرمل"],[9,"شاقتك من قتلة أطلالها","https://www.aldiwan.net/poem21944.html","السريع"],[93,"دال السكون من الحراك الدائم","https://www.aldiwan.net/poem11373.html","الكامل"],[30,"قفا نحيي العرصات الهمدا","https://www.aldiwan.net/poem29604.html","الرجز"],[4,"راح القطين بهجر بعدما ابتكروا","https://www.aldiwan.net/poem21160.html","البسيط"],[51,"راع قلبي مشيب رأس خليس","https://www.aldiwan.net/poem64653.html","الخفيف"],[51,"يا تناه والتناهي انقطاع","https://www.aldiwan.net/poem65423.html","المديد"],[91,"لو أنني يا هند بدر السما","https://www.aldiwan.net/poem8978.html","عموديه"],[92,"بل يا بهاء هذا الوجود","https://www.aldiwan.net/poem38952.html","الخفيف"],[85,"يا أيها الناعي أبا الوزراء","https://www.aldiwan.net/poem62939.html","الكامل"],[85,"تلك الطبيعة قف بنا يا ساري","https://www.aldiwan.net/poem63715.html","الكامل"],[45,"لله عهد سويقة ما أنضرا","https://www.aldiwan.net/poem63603.html","الكامل"],[28,"تبكي المراغة بالرغام على ابنها","https://www.aldiwan.net/poem5481.html","الكامل"],[2,"صرمت جديد حبالها أسماء","https://www.aldiwan.net/poem25045.html","الكامل"],[97,"إني على كاسي أعيد السنين","https://www.aldiwan.net/poem24921.html","السريع"],[74,"وظلام ليل لا شهاب بأفقه","https://www.aldiwan.net/poem13246.html","الكامل"],[39,"شث شعب الحي التئام","https://www.aldiwan.net/poem53751.html","المديد"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[48,"فدتك نفسي يا أبا جعفر","https://www.aldiwan.net/poem63326.html","السريع"],[48,"عاتبني الشعر ذا إكاف","https://www.aldiwan.net/poem64411.html","مجزوء البسيط"],[46,"أستقبح الظاهر من صاحبي","https://www.aldiwan.net/poem22286.html","السريع"],[46,"أدنى الفوارس من يغير لمغنم","https://www.aldiwan.net/poem23639.html","الكامل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9915","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[106,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[106,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[77,"ذكروا العهود فهاج من أشجاني","https://www.poetsgate.com/ViewPoem.aspx?id=34168",""],[77,"فتحت سعودك كل باب مبهم","https://www.poetsgate.com/ViewPoem.aspx?id=34204",""],[77,"يا هلالا يا قضيبا يا رشا","https://www.poetsgate.com/ViewPoem.aspx?id=34195",""],[90,"بم أستهل","https://www.poetsgate.com/ViewPoem.aspx?id=179014",""],[90,"صورة للخواطر!","https://www.poetsgate.com/ViewPoem.aspx?id=179131",""],[45,"لله عَهْدُ سَوِيقَةٍ ما أنْضَرَا،","https://www.poetsgate.com/ViewPoem.aspx?id=31338",""],[91,"الفقير","https://www.poetsgate.com/ViewPoem.aspx?id=53421",""],[28,"لا قوم أكرم من تميم إذ غدت","https://www.poetsgate.com/ViewPoem.aspx?id=22081",""],[51,"يا أيها المرء الكريم والدا","https://www.poetsgate.com/ViewPoem.aspx?id=27704",""]],"verses":[["أَو بَعدَ أَن أَدمى مَديحُكَ خاطِري","بِصِقالِ لَفظٍ أَو طِلابِ مَعاني",0,"ي",1,0],["أَو بَلَّغوا عَن واجِدٍ","لَفَّ الضُلوعَ عَلى الغَرامِ",1,"م",1,0],["أَو بَعدَما رَفَعوا القِبابَ وَخَوَّلوا","في ظِلِّ مُمتَنِعِ المَقامِ ظَليلِ",2,"ل",1,0],["أَو بائِتٍ يَرعى النُجومَ لِغارَةٍ","وَيَعُدُّ لِلمَغدى قَناً وَنِصالا",3,"ل",2,0],["أَو بالِغاً بِالنَفسِ مَعذِرَةً","وَالسَعيُ بَينَ النُجحِ وَالعُذرِ",4,"ر",1,0],["أَو بِنيَةٌ لِلمَجدِ شيدَ أَساسُه","إِلّا وَقَد هَدَمَ القَضاءُ وَطيدَها",5,"د",3,0],["أوْ بأَسْمِيرَ لَنا منْ سمَرٍ","أو علَى ناظورِها منْ مُجتمَعْ",6,"ع",1,0],["أَوَ بَعْدَ شَطْرِ الْحَوْلِ مغْتَرِباً عَلَى","حُكْمِ اللَّيَالِي نَازِحَ الأَوْطَانِ",7,"ن",1,0],["أو بالسلاح لم يستطع عن نفسه","دَفْعاً فَمَدَّ لَهَا يَدَ الْمُسْتَسْلِمِ",8,"م",1,0],["أو بسُلْوانٍ لمَنْ في رِيّةٍ","جِسْمُهُ والقلْبُ في وادِي الأشا",9,"ش",2,0],["أَو بَيضَةٍ في الدِعصِ مَكنونَةٍ","أَو دُرَّةٍ شيفَت لَدى تاجِرِ",10,"ر",1,0],["أَوْ بَاحِثٍ عَمَّا طَوَتْ أَسْفَارُهَا","طَيَّ الجَوَاهِرِ فِي بُطُونِ مَنَاجِمِ",11,"م",1,0],["أَو بِأَنانِ البومِ أَو صَوتِ الصَدى","أَو خالَطَ البيدَ الدَجِيَّ الأَسوَدا",12,"د",2,0],["أَو بارِدُ الصَيفِ مَسجورٌ مَزارِعُهُ","سودُ الذَوائِبِ مِمّا مَتَّعَت هَجَرُ",13,"ر",1,0],["أو بشمس النهارِ والبدر والزُّه","رة عند التثليث والتسديس",14,"س",1,0],["أو بقول الناس عوداً وبدءاً","يا لقوم باخ ذاك الشعاع",15,"ع",1,0],["أَو بُلبُلَ الرَوضِ ما لَذَّ لي","الاِنشادُ إِن لَم يَكُن في مَسمَعِك",16,"ك",1,0],["أو بشوكٍ يُدمي الفَضيلةَ والحُبَّ","ويقضي على بهاءِ الوُجودِ",17,"د",1,0],["أَو بِالحَياةِ وَقَد مَشى في صَفوِها","عادي السِنينَ وَعاثَ عادي الداءِ",18,"ا",2,0],["أَو بِاِبنِ داوُدٍ وَواسِعِ مُلكِهِ","وَمَعالِمٍ لِلعِزِّ فيهِ كِبارِ",19,"ر",1,0],["أَو بَلَّغَتنيهِ الرِكابُ فَقَد أَنى","لِمُقَلقَلٍ في الأَرضِ أَن يَتَدَبَّرا",20,"ر",2,0],["أَو بَينَ حَيِّ أَبي نَعامَةَ هارِباً","أَو بِاللَحاقِ بِطَيِّءِ الأَجبالِ",21,"ل",1,0],["أَو بَيضَةُ الأُدحِيِّ باتَ شِعارَها","كَنَفا النَعامَةِ جُؤجُؤٌ وَعِفاءُ",22,"ا",2,0],["أو بالغٍ سرَّ الذكاء الذي","يكادُ في لحظك أن يَتَّقِد",23,"د",1,0],["أَو بَحرِ نَحرٍ بِالحَبابِ مُقَلَّدٍ","أَو وَجهِ خَرقٍ بِالضَريبِ مُلَثَّمِ",24,"م",1,0],["أَو بِشِملِ شالَ مِن خَصبَةٍ","جُرِّدَت لِلناسِ بَعدَ الكِمام",25,"م",1,0],["أَوْ بتقبيلِ راحةٍ كانَ لل","هِ وباللَّه أخذها والعطاءُ",26,"ا",2,0],["أَوْ بِلَثْمِ التُّرَابِ مِنْ قَدَمٍ لا","نَتْ حَياءً من مَشْيِهَا الصَّفْواءُ",26,"ا",2,0],["أَو باتَ بِالمَخرَجِ مِن تُهمَتي","إِيّاهُ في خاتَمِهِ الأَحمَرِ",27,"ر",1,0],["أَو بِكَ أَبغي أَقيسُ نَفسي","زُنبورُ يا واسِعَ السِلافِ",28,"ف",1,0],["أَو بِتُّ في صَهوَةَ مُستَوطِناً","أُمسي مَعَ الأَغفارِ أَو أُصبَحُ",29,"ح",1,0],["أو بَكّرَ الوَسمِيُّ يَطْلُبُ أَرضَه","نَفِدَ الرّبيعُ وتُرْبُها لم يُوسمِ",30,"م",1,0],["أَو بِنيَةٌ لِلمَجدِ شيدَ أَساسُها","إِلّا وَقَد هَدَمَ القَضاءُ وَطيدَها",31,"د",3,0],["أَو بَدَتْ سَاخِرَةً مِنْ نَفْسِهَا","تُطْرِيءُ الْجَهْلَ وَمَا كانَ لِيُطْرَا",32,"ر",2,0],["أو بِنيَة من ناطحا","ت السُّحب تومئ بالسجود",33,"د",1,0],["أو بَيْن أهرامٍ، وبَيْن دَوائرٍ","مَجْهُولةِ الأحْجامِ والأطْوالِ",34,"ل",1,0],["أو بين أفعالٍ صَحاحٍ ما شَكَت","عِللاً، ومُعْتلٍّ من الأَفْعالِ",34,"ل",1,0],["أو بعد شطر الحول مغتربا على","حكم الليالي نازع الأوطان",35,"ن",1,0],["أو بالسلاح سيستطع عن نفسه","دفعا فمد لها يد المستسلم",36,"م",1,0],["أو بسلوان لمن في رية","جمسه والقلب في وادي الأشا",37,"ش",2,0],["أو بعدَما بَرَقَتْ أسِرَّتُّه لنا","وبدت مخايلُ حسنِه وبهائه",38,"ا",3,0],["أو بشكل يدعو إلى استحياء","أو بشكل يدعو إلى الاعجاب",39,"ب",1,0],["أوْ بَلّغَتْنِيهِ الرّكابُ، فقَد أتَى","لمُقَلْقَلٍ في الأرْضِ أنْ يَتَدَبّرَا",40,"ر",2,0],["أو بنكرو أدبي فلا تتعجبوا","فالرمد طلوع ذكاء",41,"ا",2,0],["أوْ بَينَ حَيّ أبي نَعَامَةَ هَارِباً،","أوْ بِاللّحَاقِ بطَيّيء الأجْبَالِ",42,"ل",1,0],["أو بكلامي مُوعداً وواعدا","ما كُّل من وافق جَدَّا صاعدا",43,"د",2,0]]}