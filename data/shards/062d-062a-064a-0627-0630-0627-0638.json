{"poems":[[82,"من كان عنه يدافع القدر","https://www.aldiwan.net/poem31442.html","أحذ الكامل"],[50,"وقهوة عتقت في دير شماس","https://www.aldiwan.net/poem63421.html","الطويل"],[50,"وشاعر ما يفيق من خطله","https://www.aldiwan.net/poem66556.html","المنسرح"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42707","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54271","الكامل"],[108,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[190,"إني موصيك فاحفظ عن أخي ثقة","https://www.aldiwan.net/poem44158.html","البسيط"],[193,"هواي طيبة لا بيضاء عطبول","https://www.aldiwan.net/poem35275.html","البسيط"],[343,"ركبوا المراكب واغتدوا","https://www.aldiwan.net/poem68729.html","مجزوء الكامل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122006","الكامل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114759","البسيط"],[2404,"","https://poetry.dctabudhabi.ae/diwan/poem/32590","الكامل"],[3600,"","https://poetry.dctabudhabi.ae/diwan/poem/178030","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111510","الرجز"],[4709,"قلمٌ وقضية","https://www.poetsgate.com/ViewPoem.aspx?id=214835",""],[5691,"عروش الطغاة","https://www.poetsgate.com/ViewPoem.aspx?id=207075",""]],"verses":[["حَتَّى إِذا ظَنُّوا بأنَّهُمُ","رَبِحوا وأنْجَحَ سَعْيُهُمْ خَسِروا",0,"ر",3,0],["حَتّى إِذا ظَنَّ أَنّي غَيرُ مُحتَمِلٍ","أَشارَ نَحوي لِأَمرٍ بَينَ جُلّاسي",1,"س",2,0],["حتى إذا ظفرت يداك به","وسُلَّ من مطلهِ ومن عِلَلِه",2,"ل",2,0],["حَتَّى إِذَا ظَنَّ الظُّنُونَ بِنَفْسِهِ","تِيهاً بِهَا وَخَلَتْ لَهُ الأَعْمَاقُ",3,"ق",1,0],["حتى إِذا ظَهر المَليكُ كأنَّه","بَدْرٌ به انجابَ الظَّلامُ الأَخْدر",4,"ر",1,0],["حتى إذا ظفروا رأي","ت الخير في ترك القعود",5,"د",1,0],["حتى إذا ظفرت يوما يداك به","فابعث عليه حنى سوط يعاقبه",6,"ب",2,0],["حتّى إِذا ظهَرت آيُ البشير له","رَوى أحاديثهُ للناس مكحولُ",7,"ل",1,0],["حَتّى إِذا ظَفِروا بِما","طَلَبوا مِنَ الحالِ اللَطيفَه",8,"ف",2,0],["حَتَّى إذا ظَفِرَتْ يَدَاهُ بِفَتْحِها","وغَدَتْ نُفُوسُ الخَلْقِ ذاتَ تَحَشْرُجِ",9,"ج",1,0],["حتّى إذا ظفرت كفُّ اليقينِ بِها","جاءَت بنورٍ من الظَّلماءِ مُقتَطفِ",10,"ف",1,0],["حتّى إذا ظَفِرتْ يدايَ به","جاء القضاءُ بَحيْنهِ يجري",11,"ر",2,0],["حتى إذا ظفرت يداي بكاعب","كالشمس تقصر دونها الأبصار",12,"ر",1,0],["حتى إذا ظماه ولي والسغب","لخيمه في طلب النوم ذهب",13,"ب",1,0],["حتى إذا ظهرَ المشيبُ وجدتَني","مُتوشحاً برداءِ حزنٍ يقبعُ",14,"ع",1,0],["حتى إذا ظهرت قباحة وجهه","يوماً على الشاشات بالتصوير",15,"ر",1,0]]}