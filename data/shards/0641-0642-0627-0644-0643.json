{"poems":[[88,"تعمدت قتلي في الهوى وتعمدا","https://www.aldiwan.net/poem68959.html","الطويل"],[74,"سألت النقا والبان أن يحكيا لنا","https://www.aldiwan.net/poem18655.html","الطويل"],[53,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8499.html","البسيط"],[53,"ياوجنتيه اللتين من بهج","https://www.aldiwan.net/poem9237.html","مجزوء الكامل"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[50,"جالست يوما أبانا","https://www.aldiwan.net/poem66153.html","المجتث"],[107,"","https://poetry.dctabudhabi.ae/diwan/poem/49149","الوافر"],[108,"الراعي والقطيع","https://www.poetsgate.com/ViewPoem.aspx?id=179569",""],[33,"ألم تسألِ الأطلالَ والمتربعا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18932&r=&rc=195",""],[164,"أتاها رسولي فاسمعوا ما جرا له","https://www.aldiwan.net/poem58988.html","الطويل"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[303,"أقول لصاحبي والشيخ يجثو","https://www.aldiwan.net/poem36285.html","عموديه"],[310,"نفسي الفداء لمن حل الحشا فرأى","https://www.aldiwan.net/poem56361.html","البسيط"],[325,"سألته التقبيل في خده","https://www.aldiwan.net/poem67101.html","السريع"],[411,"وشادن قلت له","https://www.aldiwan.net/poem49479.html","مجزوء الرجز"],[463,"أتكتم يوم بانة أم تبوح","https://www.aldiwan.net/poem56247.html","الوافر"],[469,"شكوت إلى خديه فعل لحاظه","https://www.aldiwan.net/poem3612.html","عموديه"],[541,"قال النبي ولم أجزع يوقرني","https://www.aldiwan.net/poem23854.html","البسيط"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[580,"صفعوه بالعوانيه","https://www.aldiwan.net/poem2794.html","مجزوء الرجز"],[580,"يا من تجنيه جنايات","https://www.aldiwan.net/poem2981.html","السريع"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77497","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46515","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46513","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46540","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79966","الطويل"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11974","المنسرح"],[1607,"","https://poetry.dctabudhabi.ae/diwan/poem/73661","البسيط"],[2816,"","https://poetry.dctabudhabi.ae/diwan/poem/131919","البسيط"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112621","الرجز"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86338","البسيط"],[3732,"","https://poetry.dctabudhabi.ae/diwan/poem/131940","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85284","الرجز"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85276","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120267","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120320","السريع"],[4607,"","https://poetry.dctabudhabi.ae/diwan/poem/132200","المنسرح"],[4767,"نداء محرم","https://www.poetsgate.com/ViewPoem.aspx?id=179993",""],[592,"ألا قل لذي الجهل المركب إنما","https://www.poetsgate.com/ViewPoem.aspx?id=128806",""]],"verses":[["فَقالَ كَبيرُ القَومِ قَد ساءَ فَألُنا","فَإِنّا نَرى حَتفاً بِحَتفٍ تَقَلَّدا",0,"د",2,0],["فقال كثيب الرمل ما أنا حملها","وقال قضيب البان ما أنا قدها",1,"ه",2,0],["فقال كم من مَنيكٍ قد بصُرتُ بهِ","مُحيٍ مُميتٍ مرجَّى الغوث مُرتَقَبِ",2,"ب",1,0],["فقال كلُّ الذي نحلتهما","حقٌّ وما يُمسِيان في حرَجِ",3,"ج",1,0],["فَقالَ كُلٌّ رَضينا بِالأَمينِ عَلَى","عِلمٍ فَأَكرِم بِهِ مِن عادِلٍ حَكَمِ",4,"م",1,0],["فَقالَ كَيفَ شَهِدتُم","بِذا بِغَيرِ عِيانِ",5,"ن",1,0],["فقال كَذَبْتَ مَالَكَ مِن خَلاقٍ","وما تَخْفَى على الله الطَّوِيَّهْ",6,"ي",2,0],["فقالَ كبشٌ له: ما الفرق بينكما؟","كلاكما يبتغي من لحمنا شِبَعا",7,"ع",2,0],["فَقَالَ: کكْتَفِلْ ثُمَّ کلْتَثِمْ فَأْتِ باغِياً","فَسَلِّمْ وَلاَ تُكْثِرْ بِأَنْ تَتَوَرَّعا",8,"ع",2,0],["فقال كئيب القلب قالت فجسمه","فقال نحيل من رآه رثا له",9,"ل",2,0],["فَقالَ كُلٌّ هاتِ","فكركَ في النَجاةِ",10,"ه",1,0],["فقال كيفَ أَنعَمُ","أَم كَيفَ يَهنى المَطعَمُ",10,"م",1,0],["فقال كذاك طُلاّبُ اللآلي","تغوصُ لقاءَ بغيتِها البحورا",11,"ر",2,0],["فَقالَ كلّا فبردُ الجفنِ نكّسهُ","وَهَل محبٌّ وَلَم تَسخن مآقيهِ",12,"ي",2,0],["فَقالَ كَم تَرجو فَقُلتُ أَعطِني","عَشراً وَما زادَ يَكونُ اِحتِسابِ",13,"ب",1,0],["فقالَ كمْ مِن عاشِقٍ","سفَكْتُ في المُنى دَمَهْ",14,"ه",1,0],["فقال كم القنوطُ وأنت تحيا","وكم تأتي الغنيَّ وتستميحُ",15,"ح",1,0],["فقال كذا الوردُ الجنيُّ بدوحةٍ","يدافعُ عنهُ شوكهُ في غصونهِ",16,"ه",1,0],["فَقالَ كُرّوا فَقُلنا إِنَّ كَرَّتَنا","مِن دونِها لَكَ نَصرُ الخالِقِ الباري",17,"ر",2,0],["فقال كل الناس منك يا عمر","أعلم بالحق وأعلى في النظر",18,"ر",1,0],["فقال كُفُّوا الصَّفْع إِني","للحديثِ رَاوِيه",19,"ي",2,0],["فقال كُفَّ الدمعَ عن وجْنةٍ","فيها من الزُّخْرُف آياتُ",20,"ت",1,0],["فَقالَ كانَ في طُلوع الشَمس","في بَلدَةٍ تُسَمى بِعَين شَمس",21,"س",1,0],["فَقالَ كان أَسد بِالحاجر","فَظاً عَلى الأَصحاب وَالعَشائر",22,"ر",1,1],["فَقال كان للخليط راعِ","بِرَعيه موفق المَساعي",23,"ي",1,1],["فَقالَ كُل حَوبه","إِذا تَلَتها التَّوبه",24,"ه",1,0],["فقال كلانا زاهرٌ في سمائه","فقلت نعمْ لكنْ محيّاه أزهر",25,"ر",1,0],["فَقالَ كُلُّ اِمرِىءٍ تَأَمَّلَهُ","أَلفُ صَلاةٍ عَلى رَسولِ اللَه",26,"ه",1,0],["فَقالَ كُنتَ الزَّمانَ تَكنِي","عَنِّي بِشَمسٍ وَذا أَصِيلُ",27,"ل",1,0],["فقال كلٌ أما واللَه ذا سَخَطٌ","قد أوجبته معاصينا فوا أسفا",28,"ف",2,0],["فقالَ كلبٌ لم تَلِدهُ حرّه","واللَهِ لا تذوقَ منهُ قَطرَه",29,"ه",1,0],["فَقالَ كَيف اِصطِباري عَن هَوى رَشإٍ","اهل الهوى سحرُ عَينَيهِ تحارُ بِهِ",30,"ه",1,0],["فقال كواني الزنجبيل بحرّه","وها هو جمر الفم قد احرق الجلدا",31,"د",2,0],["فقال كل هات","فكرك بالنجاة",32,"ه",1,0],["فقال كم قبة للشرك قد هدمت","بسيفنا في عمانٍ والعراقين",33,"ن",1,0],["فَقالَ كَرَبّس يَفيضُ جَمالا","أَخي أَلبَريءَ اِتَّهَمتَ مُحالا",34,"ل",2,0],["فقال كذلك كنت وكنت قدما","لآلك خادما عبدا امينا",35,"ن",2,0],["فقال كن فيها رئيسا كما","انت على الجند رئيس وهاد",36,"د",1,0],["فقال كم لي بدجنهم سحراً","من صرخة لي وللنوم هدا",37,"د",2,0],["فقال كبَّرتَ إذاً فلتكن","لنا بِما رأيتَه مُخبِرا",38,"ر",2,0],["فقال كما قال الأئمة قبله","وسار على منهاج من قد تقدما",39,"م",2,0]]}