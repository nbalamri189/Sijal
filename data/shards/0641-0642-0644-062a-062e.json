{"poems":[[79,"وقائلة صف لي فديتك رحلة","https://www.aldiwan.net/poem36597.html","الطويل"],[24,"بانت سعاد فقلبي اليوم متبول","https://www.aldiwan.net/poem21877.html","البسيط"],[50,"ومجلس ما له شبيه","https://www.aldiwan.net/poem64501.html","مجزوء البسيط"],[24,"بانت سعادُ فقلبي اليومَ متبولُ ( البردة )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10880&r=&rc=21",""],[185,"أمنك أميم الدار غيرها البلى","https://www.aldiwan.net/poem58861.html","الطويل"],[203,"عصافير يحسبن القلوب من الحب","https://www.aldiwan.net/poem45632.html","الطويل"],[341,"قالوا سفيه لصرفي عنهم بصري","https://www.aldiwan.net/poem67802.html","عموديه"],[342,"نظرت وسهب من بوانة بيننا","https://www.aldiwan.net/poem45425.html","الطويل"],[351,"ولما تلاقينا وجدت بنانها","https://www.aldiwan.net/poem24118.html","الطويل"],[369,"لما تراءت راية الربيع","https://www.aldiwan.net/poem60555.html","الرجز"],[473,"وليلة أيقظني معانقي","https://www.aldiwan.net/poem59521.html","الرجز"],[543,"إن كان في كل أرض ما تشان به","https://www.aldiwan.net/poem48233.html","عموديه"],[543,"يا حسرتي يا حسرتي","https://www.aldiwan.net/poem48262.html","عموديه"],[944,"","https://poetry.dctabudhabi.ae/diwan/poem/51604","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119911","السريع"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59188","البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46522","الرجز"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78122","الطويل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111877","المتقارب"],[2291,"","https://poetry.dctabudhabi.ae/diwan/poem/114967","المنسرح"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121198","البسيط"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137441",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93885","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205036","الوافر"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115466","السريع"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65172","البسيط"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126263","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138559",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91698","السريع"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91104","السريع"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117900","الوافر"],[3897,"","https://poetry.dctabudhabi.ae/diwan/poem/124048","البسيط"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44685","الطويل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28644","البسيط"]],"verses":[["فقُلْتُ خُذيها منْ لِسانِ بَلاغةٍ","كما نُظِمَ الياقوتُ والدُّرُّ في عِقْدِ",0,"د",1,0],["فَقُلتُ خَلّوا طَريقي لا أَبا لَكُمُ","فَكُلُّ ما قَدَّرَ الرَحمَنُ مَفعولُ",1,"ل",1,0],["فَقُلتُ خُذها فَدَتكَ نَفسي","فَكُلُّ شَيءٍ لَهُ زَوالُ",2,"ل",1,0],["فَقُلتُ خَلّوا سبيلي لا أَبا لَكُمُ","فَكُلُّ ما قَدَّرَ الرَحمَنُ مَفعولُ",3,"ل",1,0],["فَقُلتُ خَيَالٌ مِن أُمَيمَةَ هَاجَنى","وَذُو الشَّوقِ للطَّيفِ المُلِمِّ طَرُوبُ",4,"ب",1,0],["فقلتُ خدعنا إنها الحربُ خدعةً","وهون خطبي أن أسر الهوى خطبي",5,"ب",2,0],["فقلت خلواسبيلي واتركوا عذلي","مالي سوى طاعة الرحمن من وطر",6,"ر",1,0],["فَقُلتُ خَليلَيَّ اُنظُرا اليَومَ نَظرَةً","لِعَهدِ الصِبا إِذ كُنتُ لَستُ أَفيقُ",7,"ق",1,0],["فَقُلتُ خَضَبتِ الكَفَّ بَعدي أَهَكَذا","يَكونُ جَزاءُ المُستَهامِ المُتَيَّمِ",8,"م",1,0],["فَقُلتُ خَلِّ عَنكَ يا خَليلي","تَجاوُزَ الفَضلِ إِلى الفُضولِ",9,"ل",1,0],["فَقُلتُ خُذ ما في الغَبوقِ مِن نَكَد","وَاِسمَع وَكُن لَمّا أَقولُ مُعتَقِد",10,"د",1,0],["فقلتُ خيراً فقال الخيرُ أعرفُه","ويعرفُ الناسُ خيرَ المطعم البلدي",11,"د",2,0],["فًَقُلتُ خذ يا سيِّدي","وإنني بالمِرصَدِ",12,"د",1,0],["فقلتُ خذ قال كفّي لا تُطاوعُني","فقلتُ قُم قال رِجلي لا تُواتيني",13,"ن",2,0],["فقلت خلوه بأحكامه","كم دار حتى حصل الدار",14,"ر",1,0],["فَقُلْتُ خُذْهَا بِألْفِ ألْفٍ","فِي الثَّغْرِ إنْ شِئْتَ أوْ عَلَى الخَدْ",15,"د",1,0],["فَقُلت خَل هَذِهِ الحَماقه","وَوافق الناس لأَجل الفاقه",16,"ه",1,0],["فَقُلتُ خَضبتِ الكَف يَوم فِراقِنا","فقالَت وَحَق اللَه ذَلِكَ ما جَرى",17,"ر",2,0],["فقلت خمولكَ صانكَ فاهنأ","فليس يظنُّ بأنكَ سارق",18,"ق",1,0],["فقلتُ خُذ من أخيكَ صافيةً","أطيبَ من نيل قبلةٍ الخلَس",19,"س",1,0],["فقلت خذ قال لا استطيع لقد","ارخى المدام يدى والنطق والركبا",20,"ب",2,0],["فقلت خضبت الكف بعد فراقنا","لقد جئت أمرا في الصبابة منكرا",21,"ر",2,0],["فقلت خذي لك لبي وروحي","تملكت ستي وأحرزت خمسي",22,"س",2,0],["فقلت خذيه لا ابغى شراء","فمالت فانثنى الغصن الرطيب",23,"ب",1,0],["فقلتُ خلى عنك هذا الجفا","فأطيبُ العنبر ما أعشبا",24,"ب",2,0],["فقلتُ خُضتُ سُيول النّائبات فتى","لغيره العلمُ والادابُ لم تُضف",25,"ف",1,0],["فقلت خضبت الكف بعد فراقنا","وقد كنت قبلا أعهد الكف جوهرا",26,"ر",2,0],["فقلت خليلي احبسا الركب ساعة","فلي وقفة أروي بها عاطش الثرى",27,"ر",2,0],["فَقلت خلّ اللَه في حُكمه","يَقضي فَإِن الغَيب دُون استتارْ",28,"ر",1,0],["فَقُلت خليها لأَربابها","فَغاية المحيا إِلى موتة",29,"ه",1,0],["فقلت خلاك ذم لا تراعي","فلا مال أريد ولا جياد",30,"د",1,0],["فقلت خلوا سبيلي لا أبا لكم","انى وإن لامني من لام معتكف",31,"ف",1,0],["فَقُلتُ خَضَبت الكَفَّ بَعدَ فِراقِنا","فَما هَذا شَأنُ المُحبينَ في الوَرى",32,"ر",2,0],["فَقُلتُ خَيرٌ فَقَد عايَنتَ ما رَجِعَت","عَنهُ العُيونُ وَقَد أَبعَدتَ مُنتَجَعا",33,"ع",2,0]]}