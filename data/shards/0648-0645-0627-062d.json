16049.html","الطويل"],[462,"أهلا بغر قوافيكم لقد طلعت","https://www.aldiwan.net/poem16069.html","البسيط"],[465,"هوى قمر العلياء يا ساري الجنح","https://www.aldiwan.net/poem3298.html","عموديه"],[465,"سقى الله أطلال ما صبا","https://www.aldiwan.net/poem3384.html","عموديه"],[465,"أحب الحمى والبان وجداً بأهله","https://www.aldiwan.net/poem3405.html","عموديه"],[465,"رسوم ديار باللوى وربوع","https://www.aldiwan.net/poem3499.html","عموديه"],[465,"ألمت سليمى والنسيم عليل","https://www.aldiwan.net/poem3634.html","عموديه"],[478,"خل المطي تخدي","https://www.aldiwan.net/poem15190.html","مجزوء الرجز"],[478,"هو الوجد ما بالي أنؤ بحمله","https://www.aldiwan.net/poem15255.html","الطويل"],[478,"بي من جوى التبريح اشفاق","https://www.aldiwan.net/poem15351.html","السريع"],[480,"أساءت لمن لم يبد منه لها ذنب","https://www.aldiwan.net/poem36914.html","الطويل"],[483,"وما حيوان في الرياض ممايلا","https://www.aldiwan.net/poem24324.html","عموديه"],[496,"شماسة قلب ليس يألف طائره","https://www.aldiwan.net/poem9854.html","الطويل"],[499,"مشت كالغصن يثنيه النسيم","https://www.aldiwan.net/poem3706.html","الوافر"],[506,"اليقِينيّة","https://www.aldiwan.net/poem27893.html","مجزوء الوافر"],[516,"هي الصدمة الأولى فمن بان صبره","https://www.aldiwan.net/poem12130.html","الطويل"],[516,"العلم مذ كان محتاج إلى العلم","https://www.aldiwan.net/poem12262.html","البسيط"],[552,"دع الجزع عن يمناك لا عن شمالكا","https://www.aldiwan.net/poem47348.html","الطويل"],[552,"قد زرت ليلة هومنا على العيس","https://www.aldiwan.net/poem47744.html","البسيط"],[552,"عتاب لدهر لا يمل عتابي","https://www.aldiwan.net/poem48065.html","الطويل"],[559,"يا قلب أحبابنا جسمي بهم بالي","https://www.aldiwan.net/poem34245.html","البسيط"],[559,"دوائر أوهام بها شغل الفكر","https://www.aldiwan.net/poem34532.html","الطويل"],[563,"وفاء العهد من شيم الكرام","https://www.aldiwan.net/poem52793.html","الوافر"],[576,"أيا دمع عيني لا تكن بعد إخواني","https://www.aldiwan.net/poem2776.html","الطويل"],[576,"أضاء بثغرك وادي أضا","https://www.aldiwan.net/poem3054.html","المتقارب"],[576,"أناخ بها البارق الممطر","https://www.aldiwan.net/poem3067.html","المتقارب"],[576,"سلام عليه لا على الدهر بعده","https://www.aldiwan.net/poem3075.html","الطويل"],[588,"إلى الله في كشف المهمات نرغب","https://www.aldiwan.net/poem11511.html","عموديه"]],"verses":[["وما حسن في الناس ظني وإنني","لكاظم غيظ يصطلي من يقاربه",0,"ب",2,0],["وما حسبٌ تطاول بي إليه","ولكنّي بقية من أنابا",1,"ب",2,0],["وَما حَمَلَتني العيسُ إِلّا مُشَمِّراً","لِأَخرُقَ لَيلاً أَو لِأَقطَعَ وادِيا",2,"ي",2,0],["وَما حَمَلَتكَ الخَيلُ إِلّا رَدَدتَها","عَنِ الرَوعِ حُمراً بِالدِماءِ قَوانِيا",2,"ي",2,0],["وَما حائِماتٌ يَلتَقينَ مِنَ الصَدى","إِلى الماءِ قَد موطِلنَ بِالرَشَفانِ",3,"ن",1,0],["وَما حَمَلَت مِثلَ تِلكَ البُدو","رِ بَينَ الذَوائِبِ أَغصانُهُ",4,"ن",2,0],["وَما حِليَةُ البيضِ صَوغُ اللُجَينِ","وَلَكِن حِلاها دِماءُ القِمَم",5,"م",1,0],["وَما حَطَّ الأَعادي لي مَحَلّا","وَلَكِن حَطَّ عَنّي الدَهرُ كَلّا",6,"ل",2,0],["وَما حاجَتي إِلّا المَعالي وَقَلَّما","يَضيعُ رَجائي وَالطِعانُ رَسولي",7,"ل",2,0],["وَما حُطِمَت ذَوابِلُهُ","وَلا قُرِعَت مَحاضِرُه",8,"ر",2,0],["وَما حَرَّكوها لِلطِعانِ كَأَنَّما","زِجاجُ قَناها عُلِّقَت بِالأَشاعِرِ",9,"ر",1,0],["وَما حَبَسَتكَ مَنقَصَةٌ وَلَكِن","كَريمُ الزادِ يُحرِزُهُ الوِعاءُ",10,"ا",2,0],["وَما حَنّوا عَلى مَن خَلَّفوهُ","بِوادي الرَملِ مُنطَرِحاً جَديلا",11,"ل",2,0],["وَما حَمَلَت ذَوُو الأَنسابِ ضَيم","وَلا سَمِعَت لِداعيها مَقالا",12,"ل",2,0],["وَما حائِماتٌ حُمنَ يَوماً وَلَيلَةً","عَلى الماءِ يَخشَينَ العِصِيَّ حَوارِ",13,"ر",1,1],["وَمَا حَالُ زَنْدٍ لَمْ يُؤيَدْ بِسَاعِدٍ","وَمَا حَالُ طَرْفٍ قَدْ أُصِيبَ بِإِنْسَانِ",14,"ن",1,0],["وَمَا حَالُ مَنْ شَطَّتْ بِغَرْبٍ دِيَارُهُ","وَفِي الشَّرْقِ أَهْلُوهُ وَثَمَّ حِلاَلُهُ",15,"ل",2,0],["وما حالُ جِسْمٍ ظاعِنٍ حالَ بينَهُ","قَضاءٌ جَرى حَتْمًا وبيْنَ فُؤادِهِ",16,"د",2,0],["وَمَا حَصَلَتْ نَفْسي عَلَيْهَا بِطَائِلٍ","وَلاَ ظَفِرَتْ كَفِّي ببَعْضِ طِلاَبِ",17,"ب",1,0],["وَما حَمَّلتُها إِلّا شَقاءً","تُقاضيني بِهِ يَومَ الحِسابِ",18,"ب",1,0],["وَما حَكَمَت أَشواقُنا في نُفوسِنا","بِأَيسَرَ مِن حُكمِ السَماحَةِ وَالنَدى",19,"د",2,0],["وَما حَيوانٌ يَتَّقي الناسُ شَرَّهُ","عَلى أَنَّهُ واهي القُوى واهِنُ البَطشِ",20,"ش",1,1],["وَما حائِماتٌ تَمَّ في الصَيفِ ظَمؤُها","فَجاءَت وَلِلرَمضاءِ غَليُ المَراجِلِ",21,"ل",1,1],["وَما حَسَبَت ضَمرِيَّةٌ جَدَوِيَّةٌ","سِوى التَيسِ ذي القَرنَينِ أَنَّ لَها بَعلا",22,"ل",2,0],["ومَا حَلَّ فِي أَثْنَائِهِ مِنْ كَرِيهَةٍ","بِدَوْلَتِنَا الْكُبْرَى تَرُوعُ وَتُؤْلِمُ",23,"م",1,0],["وَما حُسنُ الوُجوهِ لَهُم بِزَينٍ","إِذا كانَت خَلائِقُهُم قِباحا",24,"ح",2,1],["وما حالُ من يستودع الريح سرَّهُ","ويطلبها وهي النموم بكتمانِ",25,"ن",1,0],["وما حلّه مستوحش النفس واجم","من الناس إلاّ تمّ بالضحك انسه",26,"س",2,0],["وما حادثات الدهر إلا خوابط","كعَشواء تمشيِ مشية المُتَرهوِك",27,"ك",1,0],["وما حكم هذا الدهر إلاّ تحكُّمٌ","كحكم فُصوص النرد في نقل مُهرَك",27,"ك",1,0],["وما حُبّها إلا لأجل تحرّر","يكون إلى العَلياء بالناس مُنْجَرّا",28,"ر",2,0],["وما حسنها إلاّ بأنّ سماءها","تضاحك من أحرارها أنجماً زُهرا",28,"ر",2,0],["وما حادثات الدهر إلاّ قصائد","يفوه بها للسامعين فم الدهر",29,"ر",1,0],["وَما حَمَلَت تَيمِيَّةٌ نِصفَ لَيلَةٍ","مِنَ الدَهرِ إِلّا اِزدادَ لُؤماً جَنينُها",30,"ن",3,0],["وَما حَفَلَت هِندٌ تَعَرُّضَ حاجَتي","وَلا نَومَ عينَيَّ الغِشاشَ المُرَوَّعا",31,"ع",2,0],["وما حملوا الحمير على عتاق","مطهرة فيلفوا مبغلينا",32,"ن",2,0],["وَمَا حَمَلُوا الحَميرَ عَلَى عتَاقٍ","مُطَهَّمَةٍ فَيُلفَوا مُبغلينَا",33,"ن",2,0],["وَما حاجَتي بِالمالِ أَبغي وُفورَهُ","إِذا لَم أَفِر عِرضي فَلا وَفَرَ الوَفرُ",34,"ر",1,0],["وَما حُبُّها لَو وَكَّلَتني بِوَصلِهِ","وَلَو صَرَمَ الخُلّانُ بِالمُتَصَرِّمِ",35,"م",1,0],["وما حسبتُ كفّي نوالك كثرة","ولكنْ المحذورِ الرَّدى كنتُ أحسب",36,"ب",1,0],["وما حَقُّ باغيك المزيدَ انتقاصُهُ","ولاسيما والمالُ جَمُّ الحلائبِ",37,"ب",1,0],["وما حركاتُ الدهر في كل طَرفةٍ","بلاهيةٍ عن هذه الحركاتِ",38,"ت",1,0],["وما حياةُ امرئٍ أَضحَتْ مَدَامِعُهُ","مقسومةً بين أحيَاءٍ وأمواتِ",39,"ت",1,0],["وما حَسَدِي وشأَنُكَ غَيْرُ شأني","أيَحْسُدُ صائداً ما لا يصيدُ",40,"د",1,0],["وما حِكاية شيْءٍ لا خَفاء به","جاء العيانُ فألْوَى بالأسانِيدِ",41,"د",1,0],["وما حار لي حاشاه بل كان سيداً","أبى لي أن يدعونني شحمة الصّهر",42,"ر",1,0],["وما حربيَ بالصفو","ولا سلميَ بالكدْرِ",43,"ر",1,0],["وما حمدُ من سدَّدتَه ورفدتَه","وما قال إلا ما يقول عداكا",44,"ك",2,0],["وما حرمةٌ يؤْوونُها بمصونةٍ","ولا درهمٌ يوعونَهُ بمُذالِ",45,"ل",1,0],["وما حمسي من دونه أن رأيتني","وإياه في الهيجاء أمضي وينكُلُ",46,"ل",1,0],["وما حربهُ حربٌ إذ نابذ العدا","ولكنها أرضٌ عليهم تُدمْدِمُ",47,"م",1,0],["وما حسدي امرءاً ما زال يُغْرِي","بي الحُسَّادَ وهْوَ علَيَّ حاني",48,"ن",2,0],["وما حُمِّلَ البُختِيُّ عامَ غِيارِهِ","عَلَيهِ الوُسوقُ بُرُّها وَشَعيرُها",49,"ر",3,1],["وَما حَزِنَت أُمٌّ لِفَقدِ وَحيدِها","بِأَعظَمَ مِن حُزني عَلَيك وَلَوعَتي",50,"ي",1,0],["وَما حَواني غَيرُ مَغناكِ","وَلَم أَفُح حَتّى تَكوني مَعي",51,"ي",1,0],["وَما حَبَبتُ مِنَ الأَشجارِ قُلتُ لَهُم","إِنّي اِفتَتَنتُ بِكاسيها وَعاريها",52,"ي",3,0],["وَما حَلَّ عِندي غَيرُكُم في مَحَلِّكُم","لِكُلِّ حَبيبٍ في الفُؤادِ مَكانُ",53,"ن",1,0],["وَما حَسُنَت عِندي وَحَقِّكَ إِذ غَدَت","هِيَ التِبرُ مَسبوكاً أَوِ الدُرُّ مُنتَقى",54,"ق",2,0],["وَما حارَبَتنا مِن مَعَدٍّ قَبيلَةٌ","فَنَترُكَها حَتّى تُقِرّوا عَلى وِترِ",55,"ر",1,0],["وما حواليهِ إلاَّ الخَ","رابُ يُشجي صُماتُهْ",56,"ه",1,0],["وما حب المعيشة في ديارٍ","لأحرار النفوس بها جفاءُ",57,"ا",2,0],["وما حافظ إلا بناء مكارم","وزاخر عرفان وهضبة سؤدد",58,"د",1,0],["وما حاولت من عصر عظيم","من الآداب للوطن العظيم",59,"م",1,0],["وَما حَطَّ مِن رَبِّ القَصائِدِ مادِحاً","وَأَنزَلَهُ عَن رُتبَةِ الشِعرِ هاجِيا",60,"ي",2,0],["وَما حَمِدتُكَ في هَولٍ ثَبَتَّ لَهُ","حَتّى بَلَوتُكَ وَالأَبطالُ تَمتَصِعُ",61,"ع",1,0],["وَما حارَتِ الأَوهامُ في عُظمِ شَأنِهِ","بِأَكثَرَ مِمّا حارَ في حُسنِهِ الطَرفُ",62,"ف",1,0],["وَما حاجَةُ الأَظعانِ حَولَكِ في الدُجى","إِلى قَمَرٍ ما واجِدٌ لَكِ عادِمُه",63,"م",2,0],["وَما حَبَوتَ أَبا العَبّاسِ مَنقَبَةً","في المَدحِ حَتّى اِستَحَقَّتها مَناقِبُهُ",64,"ب",2,0],["وَما حَظَرَ المَعروفَ إيصادُ ضَيقَةٍ","مِنَ الدَهرِ إِلّا كُنتَ فاتِحَ بابِها",65,"ب",3,0],["وَما حَسَنٌ وَهوَ القَريبُ مَحَلَّةً","بِأَقرَبِ مِن وَفرٍ مَنالاً وَزِبرَجِ",66,"ج",1,0],["وَما حَبَسَت بَغدادُ مِنّا عَزيمَةً","بِمَكتومِ مانَهوى بِها وَمُذاعِهِ",67,"ع",2,0],["وَما حَكاهُ ذُروثُيوسُ وَبَطلَم","يوسُ مِن واضِحٍ لَكُم وَخفي",68,"ف",2,0],["وَما حَمِدَ الفِتيانُ مِثلَ مُحَمَّدٍ","سَناماً لِعَلياءِ الفَعالِ وَكاهِلا",69,"ل",2,0],["وَما حَسُنَت نَواحي الأَرضِ حَتّى","مَلَكتَ السَهلَ مِنها وَالجِبالا",70,"ل",2,0],["وَما حَمَدَ الأَقوامُ كَاِبنِ مُحَمَّدٍ","لِنَعماءَ نوليها وَبُؤسى يُزيلُها",71,"ل",3,0],["وَما حَمَلَ الرُكبانُ شَرقاً وَمَغرِباً","وَأَنجَدَ في أَعلى البِلادِ وَأَتهَما",72,"م",2,0],["وَما حَسَنٌ بِأَن تُهديهِ فَذّاً","سَليبَ السَرجِ مَنزوعَ اللِجامِ",73,"م",1,0],["وَما حَمَلَت أَيديهِمُ مِن جَنازَةٍ","وَلا أَلبَسَت أَثوابَها مِثلَ مَخلَدِ",74,"د",1,0],["وَما حُمِّلَت أَضغانُنا مِن قَبيلَةٍ","فَتَحمِلَ ما يُلقى عَلَيها ظُهورُها",75,"ر",3,0],["وَما حُلَّ مِن جَهلٍ حُبى حُلَمائِنا","وَلا قائِلٌ بِالعُرفِ فينا يُعَنَّفُ",76,"ف",1,0],["وَما حَجَرٌ يُرمى بِهِ أَهلُ جانِبٍ","لِفِتنَتِهِم مِثلَ الَّذي بِالمَشارِقِ",77,"ق",1,0],["وَما حَلَبَ المِصرَينِ مِثلَكَ حالِبٌ","وَلا ضَمَّها مِمَّن جَنا في الحَقائِقِ",78,"ق",1,0],["وَما حَمَلَت أُمُّ اِمرِئٍ في ضُلوعِها","أَعَقَّ مِنَ الجاني عَلَيها هِجائِيا",79,"ي",2,0],["وما حُرِمْناه ففي ذِمامِه","حتى يذوقَ المُرَّ من حِمامِه",80,"م",2,0],["وما حيلَةُ الأعمى القبيحِ إذا التَوتْ","عليه حِسانُ الآنساتِ العقائِلِ",81,"ل",1,0],["وَما حاجَةٌ لَكَ مِن خارِجٍ","وَفِكرُكَ فيكَ وَما تُصدِرُ",82,"ر",1,0],["وَما حُبُّ دارٍ لَيسَ يُؤ","مَنُ سَيلُها وَحَريقُها",83,"ق",3,0],["وَما حادِثاتُ الدَهرِ إِلّا لِعُروَةٍ","تَفُتُّ قُواها أَو لِمُلكٍ تُزيلُهُ",84,"ل",2,0],["وما حسَنٌ إلّا مليكٌ مُتَوَّجٌ","أفاضَ الغنى من راحتيه فلا فقرُ",85,"ر",1,0],["وما حَمَلتْهُ من أنواع طيبٍ","فَمَدْحٌ عَرْفُهُ لَكَ وافتِخارُ",86,"ر",1,0],["وما حِمْيرٌ إلّا الغطارفة الأُلى","أياديهمُ تُسْدَى وأيديكُمُ تسدي",87,"د",2,0],["وَما حَكاهُ وَلا نَعيمَ لَهُ","في جيدِهِ بَل حَكاهُ في جَيَدِه",88,"د",2,0],["وما حالُ الجنودِ بغيرِ سيفٍ","وما حالُ الوجودِ بلا أمينِ",89,"ن",1,0],["وما حدباتُ الأذكياءِ نقيصةٌ","عليهم ولكنْ تلكَ للعلمِ أحملُ",90,"ل",1,0],["وَما حُبَّها إِلّا تَمَكَّنَ في الحَشا","وَأورِثَ في الأَكبادِ مِنهُ سَعيرُ",91,"ر",1,0],["وَما حُبُّ الدِيارِ شَغَفنَ قَلبي","وَلَكِن حُبُّ مَن سَكَنَ الدِيارا",92,"ر",2,0],["وَما حَلَقوا مِن رَأسِ كُلِّ مُلَبِّئٍ","صَبيحَةَ عَشرٍ قَد مَضَينَ مِنَ الشَهرِ",93,"ر",1,0],["وما حَسَبُ الأديبِ وإن تناهَى","بِمُسْتَغنٍ عنِ الأدبِ الحسيبِ",94,"ب",1,0],["وما حقُّ الحياةِ لنا بحقِّ","إذا خِفنا وعيدَ المُبطلينا",95,"ن",2,0],["وَما حادِثٌ يَوماً وَإِن راعَ وَقعُهُ","بِماحٍ هَواها أَو يُطاوِلُها ذِكرا",96,"ر",2,0],["وَما حَجَبَ الدَهرُ مِن سِرِّها","فَخافيهِ عِندَكَ لا يُحجَبُ",97,"ب",1,0],["وَما حاجَتي أَن أَرتَعي العَيش ناضِراً","أُعَلُّ بِماءِ الخَفضِ فيهِ وَأُنهَلُ",98,"ل",1,0],["وما حدثتني بالفرار عزيمتي","وكم حدثتني بالفرار من الوِزرِ",99,"ر",1,0],["وما حسرتي إلاَّ على متعفِّف","يقومُ لوجه الله بالنهضة الكبرى",100,"ر",2,0],["وَما حُمِّلَ الإِنسانُ مِثلَ أَمانَةٍ","أَشَقَّ عَلَهيِ حينَ يَحمِلُها حِملا",101,"ل",2,1],["ومَا حَوَى الغارُ مِنْ خَيرٍ وَمِنْ كَرَمٍ","وكلُّ طَرْفٍ مِنَ الكُّفَّارِ عنه عَمِي",102,"م",2,0],["وَما حامَت عَنِ الأَحسابِ إِلّا","لِتَرفَعَ ذِكرَها بِأَبي نُواسِ",103,"س",1,0],["وَما حاجَتي لَو ساعَدَ الدَهرُ بِالمُنى","كَعابٌ عَلَيها لُؤلُؤٌ وَشَكولُ",104,"ل",1,0],["وَما حاوَلتُما بِقِيادِ خَيلٍ","يَصولُ الوَردُ فيها وَالكُمَيتُ",105,"ت",1,1],["وَما حَكَينَ النَصارى في لِباسِهِمُ","وَلا بَغَينَ كَأَهلِ السَبتِ إِسباتا",106,"ت",2,0],["وَما حَفِظَ الخَريدَةَ مِثلُ بَعلٍ","تَكونُ بِهِ مِن المُتَحَرِماتِ",107,"ت",1,0],["وَما حِرصُهُ في العِلمِ يَدرُسُ كُتبَهُ","وَقَد شاهَدَ الآثارَ تُمحى وَتُدرَسُ",108,"س",1,0],["وَما حَمى عَن صَليلِ السَيفِ هامَتَهُ","إِن باتَ يَصدَحُ في أَيديهِم الجَرَسُ",109,"س",1,0],["وَما حَمدي لِأَدَمَ أَوبَنيهِ","وَأَشهَدُ أَن كُلَّهُم خَسيسُ",110,"س",1,0],["وَما حَزَنَ الإِسلامَ مَغداكَ زارِياً","عَليهِ وَلَكِن رُحتَ رَوحَةَ فارِقِ",111,"ق",1,0],["وَما حَظُّهُ في حِزامٍ يُشَدُّ","لِيُركَبَ أَو في لِجامٍ أُلِك",112,"ك",1,0],["وَما حَفَلَت حَضارِ وَلا سُهَيلٌ","بِأَبشارٍ يَمانِيَةٍ يُدَسنَه",113,"ن",2,0],["وَما حَمَلا رَحلَينِ طَوراً فَيُؤنِسا","إِذا حَفَزَ الوَشكُ الرِحالَ يَئِطّانِ",114,"ن",1,0],["وَما حَقَنَت دَمَ الإِنسانِ فيها","رُموسٌ في الرَغامِ تَفَوَّقَتهُ",115,"ت",2,0],["وَما حَمِدتُ كَبيراً في تَحَدَّ بِهِ","وَلا عَذَلتُ صَغيراً في تَجافيهِ",116,"ف",3,0],["وما حمدتك في هولٍ ثبتّ له","حتى بولتك والأبطال تمتصع",117,"ع",1,0],["وما حكمةُ الصَّمْتِ في عالمٍ","تضجُّ المطامعُ فيهِ اقتتالا",118,"ل",2,0],["وما حلَّ داراً فيكِ يوماً ولا هفتْ","على قلبه ذكراكِ من عهد إِسرَالِ",119,"ل",1,0],["وما حياةُ الفتى فيه أتسليةٌ","وراحةٌ أم فُجاءاتٌ وأخطارُ",120,"ر",1,0],["وما حَيَوانُ البَرّ فيها بِسالِمٍ","إذا لم يُغِثْهُ سِيفُها أو سَفينُها",121,"ن",3,0],["وَما حَمَلَت أُنثى وَما خَبَّ ذِعلِبٌ","وَما طَفَحَ الآذِيُّ في لُجَجِ البَحرِ",122,"ر",1,0],["وَما حَمَلَت ذَوُو الأَنسابِ ضَيماً","وَلا سَمِعَت لِداعيها مَقالا",123,"ل",2,0],["وَمَا حَرَكَاتُ النَّفْسِ إِلَّا دَلالَةٌ","عَلَى صِدْقِ مَا قَالُوا بِهِ فِي التَّعَيُّفِ",124,"ف",1,0],["وَمَا حَمَلَ السَّيْفَ الْكَمِيُّ لِزِينَةٍ","وَلَكِنْ لأَمْرٍ أَوْجَبَتْهُ الْمَفَاخِرُ",125,"ر",1,0],["وما حاجتي لغذاء وماء؟","بحسبيَ طفلاي زادًا، ورِيَّا",126,"ي",2,0],["وما حلموا في النوم إلا برتبةٍ","تُساقُ إليهم، أو زيادةِ راتب",127,"ب",1,0],["وما حكمهم جاهليّ الهوى ؟","تقهقه من سخفه الأيّمُ",128,"م",1,0],["وَمَا حُبُّ مَشْغُوفَيْن بُثَّ هَوَاهُما","إذا لم يكن فيه نثاً وعتابُ",129,"ب",1,0],["وما حكمة الصّمت في عالم","تضجّ المعالم فيه اقتتالا",130,"ل",2,0],["وَما حَمدَ الفيتانُ، مثلَ مُحَمّد،","سَنَاماً لعَلْيَاء الفَعَالِ، وَكاهلا",131,"ل",2,0],["وَما حُسِبَتْ نَوَاحي الأرْضِ، حتى","مَلَكْتَ السهْلَ، منها، وَالجِبالا",132,"ل",2,0],["وما حاجتي للنّور والنّور كامن","بنفسي لا ظلّ عليه ولا ستر",133,"ر",1,0],["وما حاجتي للأفق ضحيان مشرقا","ونفسي الضحى والأفق والشمس والبدر",133,"ر",1,0],["وما حاجتي للكائنات بأسرها","وفي نفسي الدّنيا وفي نفسي الدّهر",133,"ر",1,0],["وما حياة ُ امرىء ٍ أَضْحَتْ مَدَامِعُهُ","مقسومة ً بين أحيَاءٍ وأمواتِ",134,"ت",1,0],["وما حيلتي إن نمّ عن نفسه الهوى","هو العطر والعطر الزكي ّ نموم",135,"م",1,0],["وَما حَكى السَلَف الماضي وَحَدثنا","بِهِ مِن الفَضل بَعضٌ مِن مَعاليكا",136,"ك",2,0],["وما حب الديار شغفن قلبي","ولا هبهن أجج في نارا",137,"ر",2,0],["وما حلا مِنهُ صابٌّ كانَ جرعه","وإنما شابَ إحلاءً بإمرارِ",138,"ر",1,0],["وما حال طفلٍ ضامر ظامئ الحشا","إذا غاله سهم المنايا الجوائر",139,"ر",1,0],["وما حَنَّ مشتاقٌ وما ناحَ طائرٌ","وما سارت العِيس الهِجانُ براكبِ",140,"ب",1,0],["وما حُسْن قصر كلّ من فيه خائف","بجانب قبر فيه بيت محرّمُ",141,"م",1,0],["وما حاجةُ الغَيْرَانِ فيهم إلى القنا","وقد منعتْ منهم عِصِىُّ حِجالِ",142,"ل",1,0],["وَما حامِلي أَن أَستَزيدَ مُصَرِّحاً","سِوى أَنَفي أَن يَجدَعَ الدَهرُ لي أَنفا",143,"ف",2,0],["وَما حَمَّلتَ نَفسَكَ فيهِ وِزراً","وَلا حَمَّلتَ عِزَّكَ فيهِ ثِقلا",144,"ل",2,0],["وما حاتم قل لي وما حلم أحنف","وما زهد ابراهيم أدهم ما الصبر",145,"ر",1,0],["وما حاليطيق إذا انتحالي","فكيف يلذ لي طعم وشرب",146,"ب",1,0],["وما حال الطعام من انتحالي","وإن مرام هذا الحب صعب",146,"ب",1,0],["وما حجر إسماعيل لولا محمدٌ","تداركه حجراً معدا لذي حجرِ",147,"ر",1,1],["وما حكته الريح في اقداحها","من رقة الماء ولون الخمر",148,"ر",1,0],["وما حممت لمكروهِ تُساء به","لكنْ ليُعلم فضلٌ فيك قد جُهلا",149,"ل",2,0],["وما حسبوه في الهوى جاء ناقصا","فليس يفي للعاشقين حساب",150,"ب",1,0],["وما حسدت على كوني أحبكم","لكن على كونه حبا جرى مثلا",151,"ل",2,0],["وما حفظ العليا ووفها حقوقها","فتى لم يطاعن دونها ويضارب",152,"ب",1,0],["وما حالة إلا تحول بأهلها","وهذا هو المعهود من خلق الدهر",153,"ر",1,0],["وَما حُسَينٌ وَبَدرٌ إِن ذَكَرتُهُما","إِلّا هُمامانِ فاقَ الناسَ مَجدُهُما",154,"م",2,0],["وما حُبُّ أُمِّ الغَمرِ إِلاّ سَجِيَّةٌ","عليها بَرانى اللهُ ثُمَّ طَوَانِى",155,"ن",2,0],["وما حان وقتُ الشيبِ منه وإنما","له عِلَّةٌ من وَجْدِه واكْتئابه",156,"ب",2,0],["وما حَظُّه من كسْبه غيرُ قُوتِه","ويَجمع للوُرّاثِ كلَّ حَرام",157,"م",1,0],["وما حرّمت شرب الراح زهدا","ولكن خوف وجاببة الرضاع",158,"ع",1,0],["وما حضك النصيحة والتواني","وليس على مودته مزيد",159,"د",1,0],["وَما حَجَبت عَن قومهِ غير شخصهِ","وَأَنوارهُ قَد عمّتِ البرّ والبحرا",160,"ر",2,0],["وَما حُسَينَةُ إِذ قامَت تُوَدِّعُنا","لِلبَينِ وَاِعتَقَدَت شَذراً وَمُرجانا",161,"ن",2,0],["وما حيلتي إن لم تكنْ ليَ حيلةٌ","وهل بعدَ ما ترمينَ لحظكِ أتقي",162,"ق",2,0],["وما حَسَنٌ في كلِّ يوم تعاتُبٌ","ولا يحسن التفنيد في الجدِّ والهَزلِ",163,"ل",1,0],["وما حبهم للحرب والدهر كله","عليهم جحيمٌ ثائر يتغول",164,"ل",1,0],["وما حاربْتَك التُّرْك إلاّ وبينها","وبين الهُدَى والمَكْرُماتِ حروب",165,"ب",1,0],["وما حال من يدني إليه عداته","تدس له في الشهد سما فيشرب",166,"ب",1,0],["وما حيلةُ المَحزُونِ إلا لواعجٌ","تفيضُ بها الأحشاءُ أو عبرَةٌ تَجري",167,"ر",2,0],["وَما حَسَدتُ بَني بَدرٍ نَصيبَهُمُ","في الخَيرِ دامَ لَهُم مِن غَيرِيَ الحَسَدُ",168,"د",1,0],["وَما حَيٌّ نَحُلُّ بِعَقوَتَيهِم","مِنَ الحَربِ العَوانِ بِمُستَراحِ",169,"ح",1,0],["وما حيلتي إِن لم يُدارِك بعفوِهِ","إله كريم طالَما وهبَ العَفوَا",170,"و",2,0],["وما حَمدَ الإفرنجُ قلباً وساعداً","ولكنَّهم قد يجمدونَ السنوَّرا",171,"ر",2,0],["وَما حَشْوُ الضُّلُوعِ سِوى أُوارٍ","وَما نَوْمُ الجُفون سِوى غِرارِ",172,"ر",1,0],["وما حظ من قد غره نصل صارمٍ","رجا نصره من غمده والحمائل",173,"ل",1,0],["وَما حَسَنٌ عَن ذَلِكَ الحُسنِ سَلوَةٌ","وَلا الصَّبرُ عَن ذاكَ الجَمالِ جَميلُ",174,"ل",1,0],["وما حفظت عيناي من شؤم بختي","على كثرةِ الأشعار إلا قفا نبك",175,"ك",1,0],["وَما حُزتَ الرئاسة باِكتسابٍ","كَما يسعى لنا فيها لئامُ",176,"م",1,0],["وَما حُزناهُ مِن حلٍّ وَحُرمٍ","يُوَزَّعُ في البَنينِ وَفي البَناتِ",177,"ت",1,0],["وَمَا حَدَّثَتْني النَّفْسُ عنكَ بِسَلْوَةٍ","كَأَنَّ الهَوَى مِنّي عَلَيَّ رَقِيبُ",178,"ب",1,0],["وَمَا حَجَبَ الأمْلاكَ تَاللّهِ مِثلُهُ","فَلا زَالَ عَن عَيْنِ الخُطُوب محجَّبَا",179,"ب",2,0],["وَمَا حَاجَةٌ لِشبابٍ غَدَتْ","تُسَوِّدُ وَجْهَكَ فيهِ يَدُكْ",180,"ك",1,0],["وَمَا حَاجَةٌ أُدْلي إليكُ بِحُجَّةٍ","وَقَلبُكَ لِلوَرَّاقِ أَعْدَلُ شَاهِدِ",181,"د",1,0],["وَما حَجَبتَني عَن مَلالٍ وَإِنِّما","لِمَعنىً لِأَهلِ العِشقِ فيهِ جَوابُ",182,"ب",1,0],["وَما حيلة اللاحي بِمَن عَمّ فَضله","وَأَضرب صَفحاً عَن سَماع فُضولهِ",183,"ل",2,0],["وما حائماتٌ حمن يوماً وليلةً","على الماء يغشين العِصيَّ حوانِ",184,"ن",1,1],["وَما حَرَّكَتني لِلدَناءَةِ هِمَّتي","وَلي عِفَّة مَطبوعَة لا تعفف",185,"ف",1,0],["وما حُلْتُ عن عَهْد من البِشْرِ سابقٍ","فتَشمتَ بي حاشا معاليك لُوّامي",186,"م",2,0],["وما حالُ مَن يبغي اصطياداً بكَفِّهِ","إذا لاح نَوءٌ والوَسائقُ نُور",187,"ر",1,0],["وما حِليةُ الأَشرافِ إلاّ مآثرٌ","وهل حِلْيةٌ للمشرفيِّ سوى الأثر",188,"ر",1,0],["وما حَسُنَ النَّيروزُ إلا لأنّه","أجَدّ طُلوعاً فيه وجهُك بالسَّعْد",189,"د",1,0],["وما حِليةُ الأملاكِ مِمّا أَصوغُه","سِوى دُرَرٍ أسماؤهُنَّ قصيد",190,"د",1,0],["وما حلية الأعمارِ إلا مُعارةٌ","فخلِّ لها خَيلَ البَطالةِ تَمْعَج",191,"ج",1,0],["وما حادَ عن جَمعَي نَهاوَندَ جَمعُنا","وما زال قومي يمنعون المَواليا",192,"ي",2,0],["وَما حُسنُ السَلامَةِ فَوقَ بَرٍّ","وَيا قُبحَ الشَماتَةِ بِالغَريقِ",193,"ق",1,0],["وما حِيلةُ الباني إذا كانَ دَهرُهُ","أبَا البِشرِ لا ينفَكُّ يَهدِمُ ما يَبنِي",194,"ن",2,0],["وَما حَدَثَ عَن سُبُلِ الوَفا حَسب طاقَتي","وَلَكنما الأَيام جارَت عَن القَصدِ",195,"د",1,0],["وَما حِيلَتي في الهَوى وَالهَوى","يَجور عَلى النَفس سُلطانُهُ",196,"ن",2,0],["وَما حِمامي غَير إِن","أَراكَ تَصُب البَصَر",197,"ر",1,0],["وما حياة كثيب قلبُه أَسَفاً","قد بانَ عن جسدٍ للسّقم لَمْ يبنِ",198,"ن",1,0],["وَما حُسن هَذا الشِعر إِلّا لنفثِهِ","لَهُ في فَمي من قبل قطع وِصالِهِ",199,"ل",2,0],["وَما حَنَّ مِن وَجدٍ بِنَجدٍ وَإِنَّما","يَحِن إِلى نَجد لِمَن حَلَّ في نَجدِ",200,"د",1,0],["وما حوَتْ أيديهِمُ فَهو في","مثلِ لَهاةِ الأسَدِ الجائِعِ",201,"ع",1,0],["وما حَطّني أخذُهُ ما استَعادَ","ولا زادَني رِفعةً ما وَهبْ",202,"ب",1,0],["وما حاق مكر السَّوء إلا بأهله","وبعد فما يدريك ما الله فاعل",203,"ل",1,0],["وما حصل المعتوهُ ظنًّا يظنُّه","ومن فعله فيها وما هو فاعل",203,"ل",1,0],["وما حيلة الإِنسان فيما ينوبه","إذا كانَ أمر الله فيه مقدَّرا",204,"ر",2,0],["وما حَمَلَتْهُ غيرُ أُمٍّ نجيبةٍ","وإن كانَ من قوم أغرّ ممجد",205,"د",1,0],["وما حلها غاد ألمّ به الأسى","من البؤس إلّا وهو بالبر صادر",206,"ر",1,0],["وما حَفِظُوا أعلامها ونِظامَها","بِمِثْلِكَ من مولىً ومِثلِيَ من عَبْدِ",207,"د",1,0],["وما حاكَمَتْ فِيهِ السيوفُ وحازهُ","إليكَ أَبو الأَملاكِ جدُّكَ مرْوانُ",208,"ن",1,0],["وما حازم من لم تكن سبقت له","لطائف إقبالٍ من اللَه حازم",209,"م",1,0],["وما حرقة إلا ويبرد حرها","وحرقة قلبي بعده ليس تبرد",210,"د",1,0],["وما حلم النيام وإن تغالى","كحلم الصحو مؤتلقا سريا",211,"ي",2,0],["وما حواه الحصى نشوان مؤتلقا","كأنما هو من تيجان ربات",212,"ت",1,0],["وما حطَّك الدهرُ في سؤددٍ","تسامَوْا له ووفاءٍ وخِيمِ",213,"م",1,0],["وما حسدُ النجومِ على المعالي","ولو ذابَ الحصا حسدا بمُجدي",214,"د",2,0],["وما حَوَى وأيُّ فضلٍ ما حوى","ذاك العتيقُ البارزُ المحجَّبُ",215,"ب",1,0],["وما حبُّ ميٍّ غيرُ بُرْدٍ طويتُهُ","على الكُرهِ طيَّ الرَّثِّ وهو قشيبُ",216,"ب",1,0],["وما حملتْك الخيلُ إلا مُغيرةً","على حيِّ فُتَّاكٍ وغزْوة سيد",217,"د",1,0],["وما حالةٌ في الدهر إِلا ستنقضي","ويُعْقبُها بعد البَقاء زوالُ",218,"ل",1,0],["وما حملتْمُ به تمراً إلى هَجَرٍ","إذْ كلُّ زاويةٍ من أرضكم هَجر",219,"ر",1,0],["وما حلمت مني إليه بضاعةٌ","من الفضل إلاّ أحمدتْ صفقة الربح",220,"ح",1,0],["وما حان عصر الشيب لكن أتاحه","لقاء عدوٍّ وازورارُ صديق",221,"ق",1,0],["وما حُلَّ في الأطلالُ خيطُ مدامعي","فلا عاقها خيطُ الغمام بحله",222,"ل",2,0],["وما حاز ودّي غيرُ خلٍّ ولم تكن","لغير حبيبٍ ذلّتي وخضوعي",223,"ع",2,0],["وما حملت من كلّ أشعث وجهه","إلى الله يرجو أن يكون قبول",224,"ل",1,0],["وما حسبتُ أنكمْ","تَنْسَوْنَ حَقَّ وُدي",225,"د",2,0],["وما حلَّ مِن خيطِ الغمامِ فأدمعي","تُخَجِّلُ ماجادَ الغمامُ بحلِّهِ",226,"ل",2,0],["وما حماماتٌ بوادي الغَضا","مِن لحنها يَخْجَلُ اسحاقُ",227,"ق",1,0],["وما حيلتي واللطف منها استمالني","اليها وإن غشت أشعته السحب",228,"ب",1,0],["وما حيوان في الرياض ممايلا","معاين ضراب بجولتي",229,"ت",2,1],["وما حال صب بالعراق فؤاده","أسير وثاو في خراسان سائره",230,"ر",2,0],["وما حُبِّي لها إلّا عذاب","عليه من نضارتها نعيمُ",231,"م",1,0],["وما حلّ بحوّاءَ","وآدمَ بعد أنْ هانا",232,"ن",2,0],["وما حسن فوق الحسين وإنما","تأخر عنه بالولادة عصره",233,"ر",2,0],["وما حسدت جهولاً فضل ثروته","والريش ينبت فوق النسر والرخم",234,"م",1,0],["وَما حملتْ يُمناه إلّا صوارماً","لِكُلّ وريدٍ من كميٍّ بواتكا",235,"ك",2,0],["وَما حَنينِيَ إلّا لِلعَلاءِ إِذا","حنّ الرّجالُ إلى هذي الطّراميسِ",236,"س",1,0],["وما حيلتِي أن كنتُ في سرّ أُسرَتي","ولم يشركوا في صفوتي ولُبابي",237,"ب",2,0],["وما حدا باسمكم حادٍ فأطربني","إلا وَجُدْتُ له بالروح والمال",238,"ل",1,0],["وما حل في الأمواج بحر ولا به","قد اتحدت بل تلك عنه لها البر",239,"ر",1,0],["وما حُسنُ البِداءَةِ شرطُ حُبٍّ","ولكن شرطُهُ حسنُ الخِتامِ",240,"م",1,0],["وما حَكمَتْ فيهم فشُلَّتْ يدُ البلى","فيا ليت من أَبلاهمُ أَبلاني",241,"ن",2,0],["وما حولي انقَضَّ ذاك الغرام","وما انقَضّ إِلاَّ وقد أَنْقضَا",242,"ض",2,0],["وما حملت منَّةً للسحا","بِ إِلاَّ ومِنَّتُها أَكْبَرُ",243,"ر",1,0],["وما حَدُّه مَا في يَديْه وضِعْفُه","سيُبلِغ ما لا يبلغ الرُّمْحُ جَدَّه",244,"د",2,0],["وما حن رعد أو تألق بارق","وما انهل صوب ودقة يتحلب",245,"ب",1,0]]}