04,"لك الحمد","https://www.poetsgate.com/ViewPoem.aspx?id=37376",""],[106,"أنا وابناي","https://www.poetsgate.com/ViewPoem.aspx?id=179447",""],[106,"دواوين","https://www.poetsgate.com/ViewPoem.aspx?id=179554",""],[50,"عفَا بَعْدَ «سَلْمَى » حَاجرٌ فَذُنَابُ","https://www.poetsgate.com/ViewPoem.aspx?id=17123",""],[96,"إلي أبناء الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=15720",""],[45,"أرَى بَينَ مُلْتَفّ الأرَاكِ مَنَازِلا","https://www.poetsgate.com/ViewPoem.aspx?id=32191",""],[45,"سَلاها كيْفَ ضَيّعَتِ الوِصَالا","https://www.poetsgate.com/ViewPoem.aspx?id=32096",""],[51,"قد كنتُ أبكي على من ماتَ من سَلَفي","https://www.poetsgate.com/ViewPoem.aspx?id=27185",""]],"verses":[["وَما حَمَلَتني العيسُ إِلّا مُشَمِّراً","لِأَخرُقَ لَيلاً أَو لِأَقطَعَ وادِيا",0,"ي",2,0],["وَما حَمَلَتكَ الخَيلُ إِلّا رَدَدتَها","عَنِ الرَوعِ حُمراً بِالدِماءِ قَوانِيا",0,"ي",2,0],["وَما حائِماتٌ يَلتَقينَ مِنَ الصَدى","إِلى الماءِ قَد موطِلنَ بِالرَشَفانِ",1,"ن",1,0],["وَما حَمَلَت مِثلَ تِلكَ البُدو","رِ بَينَ الذَوائِبِ أَغصانُهُ",2,"ن",2,0],["وَما حِليَةُ البيضِ صَوغُ اللُجَينِ","وَلَكِن حِلاها دِماءُ القِمَم",3,"م",1,0],["وَما حَطَّ الأَعادي لي مَحَلّا","وَلَكِن حَطَّ عَنّي الدَهرُ كَلّا",4,"ل",2,0],["وَما حاجَتي إِلّا المَعالي وَقَلَّما","يَضيعُ رَجائي وَالطِعانُ رَسولي",5,"ل",2,0],["وَما حُطِمَت ذَوابِلُهُ","وَلا قُرِعَت مَحاضِرُه",6,"ر",2,0],["وَما حَرَّكوها لِلطِعانِ كَأَنَّما","زِجاجُ قَناها عُلِّقَت بِالأَشاعِرِ",7,"ر",1,0],["وَما حَبَسَتكَ مَنقَصَةٌ وَلَكِن","كَريمُ الزادِ يُحرِزُهُ الوِعاءُ",8,"ا",2,0],["وَما حَنّوا عَلى مَن خَلَّفوهُ","بِوادي الرَملِ مُنطَرِحاً جَديلا",9,"ل",2,0],["وَما حَمَلَت ذَوُو الأَنسابِ ضَيم","وَلا سَمِعَت لِداعيها مَقالا",10,"ل",2,0],["وَما حائِماتٌ حُمنَ يَوماً وَلَيلَةً","عَلى الماءِ يَخشَينَ العِصِيَّ حَوارِ",11,"ر",1,1],["وَمَا حَالُ زَنْدٍ لَمْ يُؤيَدْ بِسَاعِدٍ","وَمَا حَالُ طَرْفٍ قَدْ أُصِيبَ بِإِنْسَانِ",12,"ن",1,0],["وَمَا حَالُ مَنْ شَطَّتْ بِغَرْبٍ دِيَارُهُ","وَفِي الشَّرْقِ أَهْلُوهُ وَثَمَّ حِلاَلُهُ",13,"ل",2,0],["وما حالُ جِسْمٍ ظاعِنٍ حالَ بينَهُ","قَضاءٌ جَرى حَتْمًا وبيْنَ فُؤادِهِ",14,"د",2,0],["وَمَا حَصَلَتْ نَفْسي عَلَيْهَا بِطَائِلٍ","وَلاَ ظَفِرَتْ كَفِّي ببَعْضِ طِلاَبِ",15,"ب",1,0],["وَما حَمَّلتُها إِلّا شَقاءً","تُقاضيني بِهِ يَومَ الحِسابِ",16,"ب",1,0],["وَما حَكَمَت أَشواقُنا في نُفوسِنا","بِأَيسَرَ مِن حُكمِ السَماحَةِ وَالنَدى",17,"د",2,0],["وَما حَيوانٌ يَتَّقي الناسُ شَرَّهُ","عَلى أَنَّهُ واهي القُوى واهِنُ البَطشِ",18,"ش",1,1],["وَما حائِماتٌ تَمَّ في الصَيفِ ظَمؤُها","فَجاءَت وَلِلرَمضاءِ غَليُ المَراجِلِ",19,"ل",1,1],["وَما حَسَبَت ضَمرِيَّةٌ جَدَوِيَّةٌ","سِوى التَيسِ ذي القَرنَينِ أَنَّ لَها بَعلا",20,"ل",2,0],["ومَا حَلَّ فِي أَثْنَائِهِ مِنْ كَرِيهَةٍ","بِدَوْلَتِنَا الْكُبْرَى تَرُوعُ وَتُؤْلِمُ",21,"م",1,0],["وَما حُسنُ الوُجوهِ لَهُم بِزَينٍ","إِذا كانَت خَلائِقُهُم قِباحا",22,"ح",2,1],["وما حالُ من يستودع الريح سرَّهُ","ويطلبها وهي النموم بكتمانِ",23,"ن",1,0],["وما حلّه مستوحش النفس واجم","من الناس إلاّ تمّ بالضحك انسه",24,"س",2,0],["وما حادثات الدهر إلا خوابط","كعَشواء تمشيِ مشية المُتَرهوِك",25,"ك",1,0],["وما حكم هذا الدهر إلاّ تحكُّمٌ","كحكم فُصوص النرد في نقل مُهرَك",25,"ك",1,0],["وما حُبّها إلا لأجل تحرّر","يكون إلى العَلياء بالناس مُنْجَرّا",26,"ر",2,0],["وما حسنها إلاّ بأنّ سماءها","تضاحك من أحرارها أنجماً زُهرا",26,"ر",2,0],["وما حادثات الدهر إلاّ قصائد","يفوه بها للسامعين فم الدهر",27,"ر",1,0],["وَما حَمَلَت تَيمِيَّةٌ نِصفَ لَيلَةٍ","مِنَ الدَهرِ إِلّا اِزدادَ لُؤماً جَنينُها",28,"ن",3,0],["وَما حَفَلَت هِندٌ تَعَرُّضَ حاجَتي","وَلا نَومَ عينَيَّ الغِشاشَ المُرَوَّعا",29,"ع",2,0],["وما حملوا الحمير على عتاق","مطهرة فيلفوا مبغلينا",30,"ن",2,0],["وَمَا حَمَلُوا الحَميرَ عَلَى عتَاقٍ","مُطَهَّمَةٍ فَيُلفَوا مُبغلينَا",31,"ن",2,0],["وَما حاجَتي بِالمالِ أَبغي وُفورَهُ","إِذا لَم أَفِر عِرضي فَلا وَفَرَ الوَفرُ",32,"ر",1,0],["وَما حُبُّها لَو وَكَّلَتني بِوَصلِهِ","وَلَو صَرَمَ الخُلّانُ بِالمُتَصَرِّمِ",33,"م",1,0],["وما حسبتُ كفّي نوالك كثرة","ولكنْ المحذورِ الرَّدى كنتُ أحسب",34,"ب",1,0],["وما حَقُّ باغيك المزيدَ انتقاصُهُ","ولاسيما والمالُ جَمُّ الحلائبِ",35,"ب",1,0],["وما حركاتُ الدهر في كل طَرفةٍ","بلاهيةٍ عن هذه الحركاتِ",36,"ت",1,0],["وما حياةُ امرئٍ أَضحَتْ مَدَامِعُهُ","مقسومةً بين أحيَاءٍ وأمواتِ",37,"ت",1,0],["وما حَسَدِي وشأَنُكَ غَيْرُ شأني","أيَحْسُدُ صائداً ما لا يصيدُ",38,"د",1,0],["وما حِكاية شيْءٍ لا خَفاء به","جاء العيانُ فألْوَى بالأسانِيدِ",39,"د",1,0],["وما حار لي حاشاه بل كان سيداً","أبى لي أن يدعونني شحمة الصّهر",40,"ر",1,0],["وما حربيَ بالصفو","ولا سلميَ بالكدْرِ",41,"ر",1,0],["وما حمدُ من سدَّدتَه ورفدتَه","وما قال إلا ما يقول عداكا",42,"ك",2,0],["وما حرمةٌ يؤْوونُها بمصونةٍ","ولا درهمٌ يوعونَهُ بمُذالِ",43,"ل",1,0],["وما حمسي من دونه أن رأيتني","وإياه في الهيجاء أمضي وينكُلُ",44,"ل",1,0],["وما حربهُ حربٌ إذ نابذ العدا","ولكنها أرضٌ عليهم تُدمْدِمُ",45,"م",1,0],["وما حسدي امرءاً ما زال يُغْرِي","بي الحُسَّادَ وهْوَ علَيَّ حاني",46,"ي",1,0],["وما حُمِّلَ البُختِيُّ عامَ غِيارِهِ","عَلَيهِ الوُسوقُ بُرُّها وَشَعيرُها",47,"ر",3,1],["وَما حَزِنَت أُمٌّ لِفَقدِ وَحيدِها","بِأَعظَمَ مِن حُزني عَلَيك وَلَوعَتي",48,"ي",1,0],["وَما حَواني غَيرُ مَغناكِ","وَلَم أَفُح حَتّى تَكوني مَعي",49,"ي",1,0],["وَما حَبَبتُ مِنَ الأَشجارِ قُلتُ لَهُم","إِنّي اِفتَتَنتُ بِكاسيها وَعاريها",50,"ي",3,0],["وَما حَلَّ عِندي غَيرُكُم في مَحَلِّكُم","لِكُلِّ حَبيبٍ في الفُؤادِ مَكانُ",51,"ن",1,0],["وَما حَسُنَت عِندي وَحَقِّكَ إِذ غَدَت","هِيَ التِبرُ مَسبوكاً أَوِ الدُرُّ مُنتَقى",52,"ق",2,0],["وَما حارَبَتنا مِن مَعَدٍّ قَبيلَةٌ","فَنَترُكَها حَتّى تُقِرّوا عَلى وِترِ",53,"ر",1,0],["وما حواليهِ إلاَّ الخَ","رابُ يُشجي صُماتُهْ",54,"ه",1,0],["وما حب المعيشة في ديارٍ","لأحرار النفوس بها جفاءُ",55,"ا",2,0],["وما حافظ إلا بناء مكارم","وزاخر عرفان وهضبة سؤدد",56,"د",1,0],["وما حاولت من عصر عظيم","من الآداب للوطن العظيم",57,"م",1,0],["وَما حَطَّ مِن رَبِّ القَصائِدِ مادِحاً","وَأَنزَلَهُ عَن رُتبَةِ الشِعرِ هاجِيا",58,"ي",2,0],["وَما حَمِدتُكَ في هَولٍ ثَبَتَّ لَهُ","حَتّى بَلَوتُكَ وَالأَبطالُ تَمتَصِعُ",59,"ع",1,0],["وَما حارَتِ الأَوهامُ في عُظمِ شَأنِهِ","بِأَكثَرَ مِمّا حارَ في حُسنِهِ الطَرفُ",60,"ف",1,0],["وَما حاجَةُ الأَظعانِ حَولَكِ في الدُجى","إِلى قَمَرٍ ما واجِدٌ لَكِ عادِمُه",61,"م",2,0],["وَما حَبَوتَ أَبا العَبّاسِ مَنقَبَةً","في المَدحِ حَتّى اِستَحَقَّتها مَناقِبُهُ",62,"ب",2,0],["وَما حَظَرَ المَعروفَ إيصادُ ضَيقَةٍ","مِنَ الدَهرِ إِلّا كُنتَ فاتِحَ بابِها",63,"ب",3,0],["وَما حَسَنٌ وَهوَ القَريبُ مَحَلَّةً","بِأَقرَبِ مِن وَفرٍ مَنالاً وَزِبرَجِ",64,"ج",1,0],["وَما حَبَسَت بَغدادُ مِنّا عَزيمَةً","بِمَكتومِ مانَهوى بِها وَمُذاعِهِ",65,"ع",2,0],["وَما حَكاهُ ذُروثُيوسُ وَبَطلَم","يوسُ مِن واضِحٍ لَكُم وَخفي",66,"ف",2,0],["وَما حَمِدَ الفِتيانُ مِثلَ مُحَمَّدٍ","سَناماً لِعَلياءِ الفَعالِ وَكاهِلا",67,"ل",2,0],["وَما حَسُنَت نَواحي الأَرضِ حَتّى","مَلَكتَ السَهلَ مِنها وَالجِبالا",68,"ل",2,0],["وَما حَمَدَ الأَقوامُ كَاِبنِ مُحَمَّدٍ","لِنَعماءَ نوليها وَبُؤسى يُزيلُها",69,"ل",3,0],["وَما حَمَلَ الرُكبانُ شَرقاً وَمَغرِباً","وَأَنجَدَ في أَعلى البِلادِ وَأَتهَما",70,"م",2,0],["وَما حَسَنٌ بِأَن تُهديهِ فَذّاً","سَليبَ السَرجِ مَنزوعَ اللِجامِ",71,"م",1,0],["وَما حَمَلَت أَيديهِمُ مِن جَنازَةٍ","وَلا أَلبَسَت أَثوابَها مِثلَ مَخلَدِ",72,"د",1,0],["وَما حُمِّلَت أَضغانُنا مِن قَبيلَةٍ","فَتَحمِلَ ما يُلقى عَلَيها ظُهورُها",73,"ر",3,0],["وَما حُلَّ مِن جَهلٍ حُبى حُلَمائِنا","وَلا قائِلٌ بِالعُرفِ فينا يُعَنَّفُ",74,"ف",1,0],["وَما حَجَرٌ يُرمى بِهِ أَهلُ جانِبٍ","لِفِتنَتِهِم مِثلَ الَّذي بِالمَشارِقِ",75,"ق",1,0],["وَما حَلَبَ المِصرَينِ مِثلَكَ حالِبٌ","وَلا ضَمَّها مِمَّن جَنا في الحَقائِقِ",76,"ق",1,0],["وَما حَمَلَت أُمُّ اِمرِئٍ في ضُلوعِها","أَعَقَّ مِنَ الجاني عَلَيها هِجائِيا",77,"ي",2,0],["وما حُرِمْناه ففي ذِمامِه","حتى يذوقَ المُرَّ من حِمامِه",78,"م",2,0],["وما حيلَةُ الأعمى القبيحِ إذا التَوتْ","عليه حِسانُ الآنساتِ العقائِلِ",79,"ل",1,0],["وَما حاجَةٌ لَكَ مِن خارِجٍ","وَفِكرُكَ فيكَ وَما تُصدِرُ",80,"ر",1,0],["وَما حُبُّ دارٍ لَيسَ يُؤ","مَنُ سَيلُها وَحَريقُها",81,"ق",3,0],["وَما حادِثاتُ الدَهرِ إِلّا لِعُروَةٍ","تَفُتُّ قُواها أَو لِمُلكٍ تُزيلُهُ",82,"ل",2,0],["وما حسَنٌ إلّا مليكٌ مُتَوَّجٌ","أفاضَ الغنى من راحتيه فلا فقرُ",83,"ر",1,0],["وما حَمَلتْهُ من أنواع طيبٍ","فَمَدْحٌ عَرْفُهُ لَكَ وافتِخارُ",84,"ر",1,0],["وما حِمْيرٌ إلّا الغطارفة الأُلى","أياديهمُ تُسْدَى وأيديكُمُ تسدي",85,"د",2,0],["وَما حَكاهُ وَلا نَعيمَ لَهُ","في جيدِهِ بَل حَكاهُ في جَيَدِه",86,"د",2,0],["وما حالُ الجنودِ بغيرِ سيفٍ","وما حالُ الوجودِ بلا أمينِ",87,"ن",1,0],["وما حدباتُ الأذكياءِ نقيصةٌ","عليهم ولكنْ تلكَ للعلمِ أحملُ",88,"ل",1,0],["وَما حُبَّها إِلّا تَمَكَّنَ في الحَشا","وَأورِثَ في الأَكبادِ مِنهُ سَعيرُ",89,"ر",1,0],["وَما حُبُّ الدِيارِ شَغَفنَ قَلبي","وَلَكِن حُبُّ مَن سَكَنَ الدِيارا",90,"ر",2,0],["وَما حَلَقوا مِن رَأسِ كُلِّ مُلَبِّئٍ","صَبيحَةَ عَشرٍ قَد مَضَينَ مِنَ الشَهرِ",91,"ر",1,0],["وما حَسَبُ الأديبِ وإن تناهَى","بِمُسْتَغنٍ عنِ الأدبِ الحسيبِ",92,"ب",1,0],["وما حقُّ الحياةِ لنا بحقِّ","إذا خِفنا وعيدَ المُبطلينا",93,"ن",2,0],["وَما حادِثٌ يَوماً وَإِن راعَ وَقعُهُ","بِماحٍ هَواها أَو يُطاوِلُها ذِكرا",94,"ر",2,0],["وَما حَجَبَ الدَهرُ مِن سِرِّها","فَخافيهِ عِندَكَ لا يُحجَبُ",95,"ب",1,0],["وَما حاجَتي أَن أَرتَعي العَيش ناضِراً","أُعَلُّ بِماءِ الخَفضِ فيهِ وَأُنهَلُ",96,"ل",1,0],["وما حسرتي إلاَّ على متعفِّف","يقومُ لوجه الله بالنهضة الكبرى",97,"ر",2,0],["وَما حُمِّلَ الإِنسانُ مِثلَ أَمانَةٍ","أَشَقَّ عَلَهيِ حينَ يَحمِلُها حِملا",98,"ل",2,1],["ومَا حَوَى الغارُ مِنْ خَيرٍ وَمِنْ كَرَمٍ","وكلُّ طَرْفٍ مِنَ الكُّفَّارِ عنه عَمِي",99,"م",2,0],["وَما حامَت عَنِ الأَحسابِ إِلّا","لِتَرفَعَ ذِكرَها بِأَبي نُواسِ",100,"س",1,0],["وَما حاجَتي لَو ساعَدَ الدَهرُ بِالمُنى","كَعابٌ عَلَيها لُؤلُؤٌ وَشَكولُ",101,"ل",1,0],["وَما حاوَلتُما بِقِيادِ خَيلٍ","يَصولُ الوَردُ فيها وَالكُمَيتُ",102,"ت",1,1],["وَما حَكَينَ النَصارى في لِباسِهِمُ","وَلا بَغَينَ كَأَهلِ السَبتِ إِسباتا",103,"ت",2,0],["وَما حَفِظَ الخَريدَةَ مِثلُ بَعلٍ","تَكونُ بِهِ مِن المُتَحَرِماتِ",104,"ت",1,0],["وَما حِرصُهُ في العِلمِ يَدرُسُ كُتبَهُ","وَقَد شاهَدَ الآثارَ تُمحى وَتُدرَسُ",105,"س",1,0],["وَما حَمى عَن صَليلِ السَيفِ هامَتَهُ","إِن باتَ يَصدَحُ في أَيديهِم الجَرَسُ",106,"س",1,0],["وَما حَمدي لِأَدَمَ أَوبَنيهِ","وَأَشهَدُ أَن كُلَّهُم خَسيسُ",107,"س",1,0],["وَما حَزَنَ الإِسلامَ مَغداكَ زارِياً","عَليهِ وَلَكِن رُحتَ رَوحَةَ فارِقِ",108,"ق",1,0],["وَما حَظُّهُ في حِزامٍ يُشَدُّ","لِيُركَبَ أَو في لِجامٍ أُلِك",109,"ك",1,0],["وَما حَفَلَت حَضارِ وَلا سُهَيلٌ","بِأَبشارٍ يَمانِيَةٍ يُدَسنَه",110,"ن",2,0],["وَما حَمَلا رَحلَينِ طَوراً فَيُؤنِسا","إِذا حَفَزَ الوَشكُ الرِحالَ يَئِطّانِ",111,"ن",1,0],["وَما حَقَنَت دَمَ الإِنسانِ فيها","رُموسٌ في الرَغامِ تَفَوَّقَتهُ",112,"ت",2,0],["وَما حَمِدتُ كَبيراً في تَحَدَّ بِهِ","وَلا عَذَلتُ صَغيراً في تَجافيهِ",113,"ف",3,0],["وما حمدتك في هولٍ ثبتّ له","حتى بولتك والأبطال تمتصع",114,"ع",1,0],["وما حكمةُ الصَّمْتِ في عالمٍ","تضجُّ المطامعُ فيهِ اقتتالا",115,"ل",2,0],["وما حلَّ داراً فيكِ يوماً ولا هفتْ","على قلبه ذكراكِ من عهد إِسرَالِ",116,"ل",1,0],["وما حياةُ الفتى فيه أتسليةٌ","وراحةٌ أم فُجاءاتٌ وأخطارُ",117,"ر",1,0],["وما حَيَوانُ البَرّ فيها بِسالِمٍ","إذا لم يُغِثْهُ سِيفُها أو سَفينُها",118,"ن",3,0],["وَما حَمَلَت أُنثى وَما خَبَّ ذِعلِبٌ","وَما طَفَحَ الآذِيُّ في لُجَجِ البَحرِ",119,"ر",1,0],["وَما حَمَلَت ذَوُو الأَنسابِ ضَيماً","وَلا سَمِعَت لِداعيها مَقالا",120,"ل",2,0],["وَمَا حَرَكَاتُ النَّفْسِ إِلَّا دَلالَةٌ","عَلَى صِدْقِ مَا قَالُوا بِهِ فِي التَّعَيُّفِ",121,"ف",1,0],["وَمَا حَمَلَ السَّيْفَ الْكَمِيُّ لِزِينَةٍ","وَلَكِنْ لأَمْرٍ أَوْجَبَتْهُ الْمَفَاخِرُ",122,"ر",1,0],["وما حدثتني بالفرار عزيمتي","وكم حدثتني بالفرار من الوِزرِ",123,"ر",1,0],["وما حاجتي لغذاء وماء؟","بحسبيَ طفلاي زادًا، ورِيَّا",124,"ي",2,0],["وما حلموا في النوم إلا برتبةٍ","تُساقُ إليهم، أو زيادةِ راتب",125,"ب",1,0],["وَمَا حُبُّ مَشْغُوفَيْن بُثَّ هَوَاهُما","إذا لم يكن فيه نثاً وعتابُ",126,"ب",1,0],["وما حكمة الصّمت في عالم","تضجّ المعالم فيه اقتتالا",127,"ل",2,0],["وَما حَمدَ الفيتانُ، مثلَ مُحَمّد،","سَنَاماً لعَلْيَاء الفَعَالِ، وَكاهلا",128,"ل",2,0],["وَما حُسِبَتْ نَوَاحي الأرْضِ، حتى","مَلَكْتَ السهْلَ، منها، وَالجِبالا",129,"ل",2,0],["وما حياة ُ امرىء ٍ أَضْحَتْ مَدَامِعُهُ","مقسومة ً بين أحيَاءٍ وأمواتِ",130,"ت",1,0]]}