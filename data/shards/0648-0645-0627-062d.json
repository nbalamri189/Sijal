ر القلب عند تغزلي","https://www.aldiwan.net/poem58144.html","الطويل"],[303,"بسعيك تبلغ الرتب العظام","https://www.aldiwan.net/poem56409.html","الوافر"],[307,"فعقبى كل شيء نحن فيه","https://www.aldiwan.net/poem50319.html","الوافر"],[346,"لكل فؤاد من هواك نصيب","https://www.aldiwan.net/poem19853.html","الطويل"],[346,"إذا جدت فيها قالت السحب غيرة","https://www.aldiwan.net/poem19859.html","الطويل"],[346,"أيا خاضب الشيب حتى متى","https://www.aldiwan.net/poem20144.html","المتقارب"],[346,"إذا ثبتت بين القلوب مودة","https://www.aldiwan.net/poem20161.html","الطويل"],[347,"لعلوة دون العاشقين حجاب","https://www.aldiwan.net/poem15533.html","الطويل"],[351,"أدار سلاف الراح من سلسبيله","https://www.aldiwan.net/poem39999.html","الطويل"],[353,"وما حائمات حمن يوما وليلة","https://www.aldiwan.net/poem61023.html","الطويل"],[359,"لقد شاقني هذا القوام المهفهف","https://www.aldiwan.net/poem68090.html","الطويل"],[362,"تصرف أحوالي على حكم أيامي","https://www.aldiwan.net/poem60644.html","الطويل"],[362,"ألم تريا أن الحمول تسير","https://www.aldiwan.net/poem60891.html","الطويل"],[362,"هم منعوا منا الخيال الذي يسري","https://www.aldiwan.net/poem60909.html","البسيط"],[362,"أضم على قلبي يدي من الوجد","https://www.aldiwan.net/poem60941.html","الطويل"],[362,"من القاتلات الصب بالهجر في الهوى","https://www.aldiwan.net/poem60956.html","الطويل"],[362,"طربن لترجيع الغناء المهزج","https://www.aldiwan.net/poem60970.html","الطويل"],[363,"حضض قومي باللقاء ومعشري","https://www.aldiwan.net/poem44374.html","الطويل"],[364,"على ذكراه أيام الفنيق","https://www.aldiwan.net/poem17048.html","الوافر"],[369,"أرى نوب الأيام تجني ولا أرى","https://www.aldiwan.net/poem57007.html","الطويل"],[377,"ترى عندكم في الحب بعض الذي عندي","https://www.aldiwan.net/poem49198.html","الطويل"],[377,"تعفى العقيق وكثبانه","https://www.aldiwan.net/poem49200.html","المتقارب"],[377,"لا واِختلاس النظر","https://www.aldiwan.net/poem49232.html","مجزوء الرجز"],[399,"بلغت ما شئت من حزني ومن كمدي","https://www.aldiwan.net/poem46749.html","البسيط"],[403,"هبوا أن سجني مانع لوصاله","https://www.aldiwan.net/poem50136.html","الطويل"],[403,"بدا البرق من نجد فحن إلى نجد","https://www.aldiwan.net/poem50190.html","الطويل"],[406,"من مبلغ المعتر والقانع","https://www.aldiwan.net/poem31879.html","السريع"],[406,"أيحسب دهري أني جزعت","https://www.aldiwan.net/poem32154.html","المتقارب"],[413,"تبين حق للعباد وباطل","https://www.aldiwan.net/poem53998.html","الطويل"],[413,"لفقدان عبد الواحد الدمع قد جرى","https://www.aldiwan.net/poem54022.html","الطويل"],[413,"إلى العز خوري يا نياقي وأنجدي","https://www.aldiwan.net/poem54159.html","الطويل"],[426,"أبرق نراه أم سنا الصبح حاضر","https://www.aldiwan.net/poem41427.html","الطويل"],[436,"تصدت لوشك البين من جفوة الصد","https://www.aldiwan.net/poem34776.html","الطويل"],[436,"هنيئا لهذا الدهر روح وريحان","https://www.aldiwan.net/poem34894.html","الطويل"],[438,"أما من بني حوا خليل محالم","https://www.aldiwan.net/poem14383.html","الطويل"],[438,"حرائق حزن في فؤادي تجدد","https://www.aldiwan.net/poem14448.html","الطويل"],[451,"تنادينا بنكهتها فهيا","https://www.aldiwan.net/poem61298.html","الوافر"],[451,"الموحيات حيالي لا عداد لها","https://www.aldiwan.net/poem61582.html","البسيط"],[456,"أعلل فيكِ ببرد النسيمِ","https://www.aldiwan.net/poem55876.html","المتقارب"],[456,"سلمت وما الديار بسالمات","https://www.aldiwan.net/poem56232.html","الوافر"],[456,"لعلها واليأس منها أغلب","https://www.aldiwan.net/poem56283.html","الرجز"],[456,"هوى لي وأهواء النفوس ضروب","https://www.aldiwan.net/poem56294.html","الطويل"],[459,"أأهجع أم آوي إلى لين مرقد","https://www.aldiwan.net/poem15111.html","الطويل"],[459,"تعنفني في شرب كأسي ضلالة","https://www.aldiwan.net/poem16049.html","الطويل"],[459,"أهلا بغر قوافيكم لقد طلعت","https://www.aldiwan.net/poem16069.html","البسيط"],[462,"هوى قمر العلياء يا ساري الجنح","https://www.aldiwan.net/poem3298.html","عموديه"],[462,"سقى الله أطلال ما صبا","https://www.aldiwan.net/poem3384.html","عموديه"],[462,"أحب الحمى والبان وجداً بأهله","https://www.aldiwan.net/poem3405.html","عموديه"],[462,"رسوم ديار باللوى وربوع","https://www.aldiwan.net/poem3499.html","عموديه"],[462,"ألمت سليمى والنسيم عليل","https://www.aldiwan.net/poem3634.html","عموديه"],[475,"خل المطي تخدي","https://www.aldiwan.net/poem15190.html","مجزوء الرجز"],[475,"هو الوجد ما بالي أنؤ بحمله","https://www.aldiwan.net/poem15255.html","الطويل"],[475,"بي من جوى التبريح اشفاق","https://www.aldiwan.net/poem15351.html","السريع"],[477,"أساءت لمن لم يبد منه لها ذنب","https://www.aldiwan.net/poem36914.html","الطويل"],[480,"وما حيوان في الرياض ممايلا","https://www.aldiwan.net/poem24324.html","عموديه"],[493,"شماسة قلب ليس يألف طائره","https://www.aldiwan.net/poem9854.html","الطويل"],[496,"مشت كالغصن يثنيه النسيم","https://www.aldiwan.net/poem3706.html","الوافر"],[503,"اليقِينيّة","https://www.aldiwan.net/poem27893.html","مجزوء الوافر"],[513,"هي الصدمة الأولى فمن بان صبره","https://www.aldiwan.net/poem12130.html","الطويل"],[513,"العلم مذ كان محتاج إلى العلم","https://www.aldiwan.net/poem12262.html","البسيط"],[549,"دع الجزع عن يمناك لا عن شمالكا","https://www.aldiwan.net/poem47348.html","الطويل"],[549,"قد زرت ليلة هومنا على العيس","https://www.aldiwan.net/poem47744.html","البسيط"],[549,"عتاب لدهر لا يمل عتابي","https://www.aldiwan.net/poem48065.html","الطويل"],[556,"يا قلب أحبابنا جسمي بهم بالي","https://www.aldiwan.net/poem34245.html","البسيط"],[556,"دوائر أوهام بها شغل الفكر","https://www.aldiwan.net/poem34532.html","الطويل"],[560,"وفاء العهد من شيم الكرام","https://www.aldiwan.net/poem52793.html","الوافر"],[573,"أيا دمع عيني لا تكن بعد إخواني","https://www.aldiwan.net/poem2776.html","الطويل"],[573,"أضاء بثغرك وادي أضا","https://www.aldiwan.net/poem3054.html","المتقارب"],[573,"أناخ بها البارق الممطر","https://www.aldiwan.net/poem3067.html","المتقارب"],[573,"سلام عليه لا على الدهر بعده","https://www.aldiwan.net/poem3075.html","الطويل"],[585,"إلى الله في كشف المهمات نرغب","https://www.aldiwan.net/poem11511.html","عموديه"]],"verses":[["وَما حَمَلَتني العيسُ إِلّا مُشَمِّراً","لِأَخرُقَ لَيلاً أَو لِأَقطَعَ وادِيا",0,"ي",2,0],["وَما حَمَلَتكَ الخَيلُ إِلّا رَدَدتَها","عَنِ الرَوعِ حُمراً بِالدِماءِ قَوانِيا",0,"ي",2,0],["وَما حائِماتٌ يَلتَقينَ مِنَ الصَدى","إِلى الماءِ قَد موطِلنَ بِالرَشَفانِ",1,"ن",1,0],["وَما حَمَلَت مِثلَ تِلكَ البُدو","رِ بَينَ الذَوائِبِ أَغصانُهُ",2,"ن",2,0],["وَما حِليَةُ البيضِ صَوغُ اللُجَينِ","وَلَكِن حِلاها دِماءُ القِمَم",3,"م",1,0],["وَما حَطَّ الأَعادي لي مَحَلّا","وَلَكِن حَطَّ عَنّي الدَهرُ كَلّا",4,"ل",2,0],["وَما حاجَتي إِلّا المَعالي وَقَلَّما","يَضيعُ رَجائي وَالطِعانُ رَسولي",5,"ل",2,0],["وَما حُطِمَت ذَوابِلُهُ","وَلا قُرِعَت مَحاضِرُه",6,"ر",2,0],["وَما حَرَّكوها لِلطِعانِ كَأَنَّما","زِجاجُ قَناها عُلِّقَت بِالأَشاعِرِ",7,"ر",1,0],["وَما حَبَسَتكَ مَنقَصَةٌ وَلَكِن","كَريمُ الزادِ يُحرِزُهُ الوِعاءُ",8,"ا",2,0],["وَما حَنّوا عَلى مَن خَلَّفوهُ","بِوادي الرَملِ مُنطَرِحاً جَديلا",9,"ل",2,0],["وَما حَمَلَت ذَوُو الأَنسابِ ضَيم","وَلا سَمِعَت لِداعيها مَقالا",10,"ل",2,0],["وَما حائِماتٌ حُمنَ يَوماً وَلَيلَةً","عَلى الماءِ يَخشَينَ العِصِيَّ حَوارِ",11,"ر",1,1],["وَمَا حَالُ زَنْدٍ لَمْ يُؤيَدْ بِسَاعِدٍ","وَمَا حَالُ طَرْفٍ قَدْ أُصِيبَ بِإِنْسَانِ",12,"ن",1,0],["وَمَا حَالُ مَنْ شَطَّتْ بِغَرْبٍ دِيَارُهُ","وَفِي الشَّرْقِ أَهْلُوهُ وَثَمَّ حِلاَلُهُ",13,"ل",2,0],["وما حالُ جِسْمٍ ظاعِنٍ حالَ بينَهُ","قَضاءٌ جَرى حَتْمًا وبيْنَ فُؤادِهِ",14,"د",2,0],["وَمَا حَصَلَتْ نَفْسي عَلَيْهَا بِطَائِلٍ","وَلاَ ظَفِرَتْ كَفِّي ببَعْضِ طِلاَبِ",15,"ب",1,0],["وَما حَمَّلتُها إِلّا شَقاءً","تُقاضيني بِهِ يَومَ الحِسابِ",16,"ب",1,0],["وَما حَكَمَت أَشواقُنا في نُفوسِنا","بِأَيسَرَ مِن حُكمِ السَماحَةِ وَالنَدى",17,"د",2,0],["وَما حَيوانٌ يَتَّقي الناسُ شَرَّهُ","عَلى أَنَّهُ واهي القُوى واهِنُ البَطشِ",18,"ش",1,1],["وَما حائِماتٌ تَمَّ في الصَيفِ ظَمؤُها","فَجاءَت وَلِلرَمضاءِ غَليُ المَراجِلِ",19,"ل",1,1],["وَما حَسَبَت ضَمرِيَّةٌ جَدَوِيَّةٌ","سِوى التَيسِ ذي القَرنَينِ أَنَّ لَها بَعلا",20,"ل",2,0],["ومَا حَلَّ فِي أَثْنَائِهِ مِنْ كَرِيهَةٍ","بِدَوْلَتِنَا الْكُبْرَى تَرُوعُ وَتُؤْلِمُ",21,"م",1,0],["وَما حُسنُ الوُجوهِ لَهُم بِزَينٍ","إِذا كانَت خَلائِقُهُم قِباحا",22,"ح",2,1],["وما حالُ من يستودع الريح سرَّهُ","ويطلبها وهي النموم بكتمانِ",23,"ن",1,0],["وما حلّه مستوحش النفس واجم","من الناس إلاّ تمّ بالضحك انسه",24,"س",2,0],["وما حادثات الدهر إلا خوابط","كعَشواء تمشيِ مشية المُتَرهوِك",25,"ك",1,0],["وما حكم هذا الدهر إلاّ تحكُّمٌ","كحكم فُصوص النرد في نقل مُهرَك",25,"ك",1,0],["وما حُبّها إلا لأجل تحرّر","يكون إلى العَلياء بالناس مُنْجَرّا",26,"ر",2,0],["وما حسنها إلاّ بأنّ سماءها","تضاحك من أحرارها أنجماً زُهرا",26,"ر",2,0],["وما حادثات الدهر إلاّ قصائد","يفوه بها للسامعين فم الدهر",27,"ر",1,0],["وَما حَمَلَت تَيمِيَّةٌ نِصفَ لَيلَةٍ","مِنَ الدَهرِ إِلّا اِزدادَ لُؤماً جَنينُها",28,"ن",3,0],["وَما حَفَلَت هِندٌ تَعَرُّضَ حاجَتي","وَلا نَومَ عينَيَّ الغِشاشَ المُرَوَّعا",29,"ع",2,0],["وما حملوا الحمير على عتاق","مطهرة فيلفوا مبغلينا",30,"ن",2,0],["وَمَا حَمَلُوا الحَميرَ عَلَى عتَاقٍ","مُطَهَّمَةٍ فَيُلفَوا مُبغلينَا",31,"ن",2,0],["وَما حاجَتي بِالمالِ أَبغي وُفورَهُ","إِذا لَم أَفِر عِرضي فَلا وَفَرَ الوَفرُ",32,"ر",1,0],["وَما حُبُّها لَو وَكَّلَتني بِوَصلِهِ","وَلَو صَرَمَ الخُلّانُ بِالمُتَصَرِّمِ",33,"م",1,0],["وما حسبتُ كفّي نوالك كثرة","ولكنْ المحذورِ الرَّدى كنتُ أحسب",34,"ب",1,0],["وما حَقُّ باغيك المزيدَ انتقاصُهُ","ولاسيما والمالُ جَمُّ الحلائبِ",35,"ب",1,0],["وما حركاتُ الدهر في كل طَرفةٍ","بلاهيةٍ عن هذه الحركاتِ",36,"ت",1,0],["وما حياةُ امرئٍ أَضحَتْ مَدَامِعُهُ","مقسومةً بين أحيَاءٍ وأمواتِ",37,"ت",1,0],["وما حَسَدِي وشأَنُكَ غَيْرُ شأني","أيَحْسُدُ صائداً ما لا يصيدُ",38,"د",1,0],["وما حِكاية شيْءٍ لا خَفاء به","جاء العيانُ فألْوَى بالأسانِيدِ",39,"د",1,0],["وما حار لي حاشاه بل كان سيداً","أبى لي أن يدعونني شحمة الصّهر",40,"ر",1,0],["وما حربيَ بالصفو","ولا سلميَ بالكدْرِ",41,"ر",1,0],["وما حمدُ من سدَّدتَه ورفدتَه","وما قال إلا ما يقول عداكا",42,"ك",2,0],["وما حرمةٌ يؤْوونُها بمصونةٍ","ولا درهمٌ يوعونَهُ بمُذالِ",43,"ل",1,0],["وما حمسي من دونه أن رأيتني","وإياه في الهيجاء أمضي وينكُلُ",44,"ل",1,0],["وما حربهُ حربٌ إذ نابذ العدا","ولكنها أرضٌ عليهم تُدمْدِمُ",45,"م",1,0],["وما حسدي امرءاً ما زال يُغْرِي","بي الحُسَّادَ وهْوَ علَيَّ حاني",46,"ي",1,0],["وما حُمِّلَ البُختِيُّ عامَ غِيارِهِ","عَلَيهِ الوُسوقُ بُرُّها وَشَعيرُها",47,"ر",3,1],["وَما حَزِنَت أُمٌّ لِفَقدِ وَحيدِها","بِأَعظَمَ مِن حُزني عَلَيك وَلَوعَتي",48,"ي",1,0],["وَما حَواني غَيرُ مَغناكِ","وَلَم أَفُح حَتّى تَكوني مَعي",49,"ي",1,0],["وَما حَبَبتُ مِنَ الأَشجارِ قُلتُ لَهُم","إِنّي اِفتَتَنتُ بِكاسيها وَعاريها",50,"ي",3,0],["وَما حَلَّ عِندي غَيرُكُم في مَحَلِّكُم","لِكُلِّ حَبيبٍ في الفُؤادِ مَكانُ",51,"ن",1,0],["وَما حَسُنَت عِندي وَحَقِّكَ إِذ غَدَت","هِيَ التِبرُ مَسبوكاً أَوِ الدُرُّ مُنتَقى",52,"ق",2,0],["وَما حارَبَتنا مِن مَعَدٍّ قَبيلَةٌ","فَنَترُكَها حَتّى تُقِرّوا عَلى وِترِ",53,"ر",1,0],["وما حواليهِ إلاَّ الخَ","رابُ يُشجي صُماتُهْ",54,"ه",1,0],["وما حب المعيشة في ديارٍ","لأحرار النفوس بها جفاءُ",55,"ا",2,0],["وما حافظ إلا بناء مكارم","وزاخر عرفان وهضبة سؤدد",56,"د",1,0],["وما حاولت من عصر عظيم","من الآداب للوطن العظيم",57,"م",1,0],["وَما حَطَّ مِن رَبِّ القَصائِدِ مادِحاً","وَأَنزَلَهُ عَن رُتبَةِ الشِعرِ هاجِيا",58,"ي",2,0],["وَما حَمِدتُكَ في هَولٍ ثَبَتَّ لَهُ","حَتّى بَلَوتُكَ وَالأَبطالُ تَمتَصِعُ",59,"ع",1,0],["وَما حارَتِ الأَوهامُ في عُظمِ شَأنِهِ","بِأَكثَرَ مِمّا حارَ في حُسنِهِ الطَرفُ",60,"ف",1,0],["وَما حاجَةُ الأَظعانِ حَولَكِ في الدُجى","إِلى قَمَرٍ ما واجِدٌ لَكِ عادِمُه",61,"م",2,0],["وَما حَبَوتَ أَبا العَبّاسِ مَنقَبَةً","في المَدحِ حَتّى اِستَحَقَّتها مَناقِبُهُ",62,"ب",2,0],["وَما حَظَرَ المَعروفَ إيصادُ ضَيقَةٍ","مِنَ الدَهرِ إِلّا كُنتَ فاتِحَ بابِها",63,"ب",3,0],["وَما حَسَنٌ وَهوَ القَريبُ مَحَلَّةً","بِأَقرَبِ مِن وَفرٍ مَنالاً وَزِبرَجِ",64,"ج",1,0],["وَما حَبَسَت بَغدادُ مِنّا عَزيمَةً","بِمَكتومِ مانَهوى بِها وَمُذاعِهِ",65,"ع",2,0],["وَما حَكاهُ ذُروثُيوسُ وَبَطلَم","يوسُ مِن واضِحٍ لَكُم وَخفي",66,"ف",2,0],["وَما حَمِدَ الفِتيانُ مِثلَ مُحَمَّدٍ","سَناماً لِعَلياءِ الفَعالِ وَكاهِلا",67,"ل",2,0],["وَما حَسُنَت نَواحي الأَرضِ حَتّى","مَلَكتَ السَهلَ مِنها وَالجِبالا",68,"ل",2,0],["وَما حَمَدَ الأَقوامُ كَاِبنِ مُحَمَّدٍ","لِنَعماءَ نوليها وَبُؤسى يُزيلُها",69,"ل",3,0],["وَما حَمَلَ الرُكبانُ شَرقاً وَمَغرِباً","وَأَنجَدَ في أَعلى البِلادِ وَأَتهَما",70,"م",2,0],["وَما حَسَنٌ بِأَن تُهديهِ فَذّاً","سَليبَ السَرجِ مَنزوعَ اللِجامِ",71,"م",1,0],["وَما حَمَلَت أَيديهِمُ مِن جَنازَةٍ","وَلا أَلبَسَت أَثوابَها مِثلَ مَخلَدِ",72,"د",1,0],["وَما حُمِّلَت أَضغانُنا مِن قَبيلَةٍ","فَتَحمِلَ ما يُلقى عَلَيها ظُهورُها",73,"ر",3,0],["وَما حُلَّ مِن جَهلٍ حُبى حُلَمائِنا","وَلا قائِلٌ بِالعُرفِ فينا يُعَنَّفُ",74,"ف",1,0],["وَما حَجَرٌ يُرمى بِهِ أَهلُ جانِبٍ","لِفِتنَتِهِم مِثلَ الَّذي بِالمَشارِقِ",75,"ق",1,0],["وَما حَلَبَ المِصرَينِ مِثلَكَ حالِبٌ","وَلا ضَمَّها مِمَّن جَنا في الحَقائِقِ",76,"ق",1,0],["وَما حَمَلَت أُمُّ اِمرِئٍ في ضُلوعِها","أَعَقَّ مِنَ الجاني عَلَيها هِجائِيا",77,"ي",2,0],["وما حُرِمْناه ففي ذِمامِه","حتى يذوقَ المُرَّ من حِمامِه",78,"م",2,0],["وما حيلَةُ الأعمى القبيحِ إذا التَوتْ","عليه حِسانُ الآنساتِ العقائِلِ",79,"ل",1,0],["وَما حاجَةٌ لَكَ مِن خارِجٍ","وَفِكرُكَ فيكَ وَما تُصدِرُ",80,"ر",1,0],["وَما حُبُّ دارٍ لَيسَ يُؤ","مَنُ سَيلُها وَحَريقُها",81,"ق",3,0],["وَما حادِثاتُ الدَهرِ إِلّا لِعُروَةٍ","تَفُتُّ قُواها أَو لِمُلكٍ تُزيلُهُ",82,"ل",2,0],["وما حسَنٌ إلّا مليكٌ مُتَوَّجٌ","أفاضَ الغنى من راحتيه فلا فقرُ",83,"ر",1,0],["وما حَمَلتْهُ من أنواع طيبٍ","فَمَدْحٌ عَرْفُهُ لَكَ وافتِخارُ",84,"ر",1,0],["وما حِمْيرٌ إلّا الغطارفة الأُلى","أياديهمُ تُسْدَى وأيديكُمُ تسدي",85,"د",2,0],["وَما حَكاهُ وَلا نَعيمَ لَهُ","في جيدِهِ بَل حَكاهُ في جَيَدِه",86,"د",2,0],["وما حالُ الجنودِ بغيرِ سيفٍ","وما حالُ الوجودِ بلا أمينِ",87,"ن",1,0],["وما حدباتُ الأذكياءِ نقيصةٌ","عليهم ولكنْ تلكَ للعلمِ أحملُ",88,"ل",1,0],["وَما حُبَّها إِلّا تَمَكَّنَ في الحَشا","وَأورِثَ في الأَكبادِ مِنهُ سَعيرُ",89,"ر",1,0],["وَما حُبُّ الدِيارِ شَغَفنَ قَلبي","وَلَكِن حُبُّ مَن سَكَنَ الدِيارا",90,"ر",2,0],["وَما حَلَقوا مِن رَأسِ كُلِّ مُلَبِّئٍ","صَبيحَةَ عَشرٍ قَد مَضَينَ مِنَ الشَهرِ",91,"ر",1,0],["وما حَسَبُ الأديبِ وإن تناهَى","بِمُسْتَغنٍ عنِ الأدبِ الحسيبِ",92,"ب",1,0],["وما حقُّ الحياةِ لنا بحقِّ","إذا خِفنا وعيدَ المُبطلينا",93,"ن",2,0],["وَما حادِثٌ يَوماً وَإِن راعَ وَقعُهُ","بِماحٍ هَواها أَو يُطاوِلُها ذِكرا",94,"ر",2,0],["وَما حَجَبَ الدَهرُ مِن سِرِّها","فَخافيهِ عِندَكَ لا يُحجَبُ",95,"ب",1,0],["وَما حاجَتي أَن أَرتَعي العَيش ناضِراً","أُعَلُّ بِماءِ الخَفضِ فيهِ وَأُنهَلُ",96,"ل",1,0],["وما حسرتي إلاَّ على متعفِّف","يقومُ لوجه الله بالنهضة الكبرى",97,"ر",2,0],["وَما حُمِّلَ الإِنسانُ مِثلَ أَمانَةٍ","أَشَقَّ عَلَهيِ حينَ يَحمِلُها حِملا",98,"ل",2,1],["ومَا حَوَى الغارُ مِنْ خَيرٍ وَمِنْ كَرَمٍ","وكلُّ طَرْفٍ مِنَ الكُّفَّارِ عنه عَمِي",99,"م",2,0],["وَما حامَت عَنِ الأَحسابِ إِلّا","لِتَرفَعَ ذِكرَها بِأَبي نُواسِ",100,"س",1,0],["وَما حاجَتي لَو ساعَدَ الدَهرُ بِالمُنى","كَعابٌ عَلَيها لُؤلُؤٌ وَشَكولُ",101,"ل",1,0],["وَما حاوَلتُما بِقِيادِ خَيلٍ","يَصولُ الوَردُ فيها وَالكُمَيتُ",102,"ت",1,1],["وَما حَكَينَ النَصارى في لِباسِهِمُ","وَلا بَغَينَ كَأَهلِ السَبتِ إِسباتا",103,"ت",2,0],["وَما حَفِظَ الخَريدَةَ مِثلُ بَعلٍ","تَكونُ بِهِ مِن المُتَحَرِماتِ",104,"ت",1,0],["وَما حِرصُهُ في العِلمِ يَدرُسُ كُتبَهُ","وَقَد شاهَدَ الآثارَ تُمحى وَتُدرَسُ",105,"س",1,0],["وَما حَمى عَن صَليلِ السَيفِ هامَتَهُ","إِن باتَ يَصدَحُ في أَيديهِم الجَرَسُ",106,"س",1,0],["وَما حَمدي لِأَدَمَ أَوبَنيهِ","وَأَشهَدُ أَن كُلَّهُم خَسيسُ",107,"س",1,0],["وَما حَزَنَ الإِسلامَ مَغداكَ زارِياً","عَليهِ وَلَكِن رُحتَ رَوحَةَ فارِقِ",108,"ق",1,0],["وَما حَظُّهُ في حِزامٍ يُشَدُّ","لِيُركَبَ أَو في لِجامٍ أُلِك",109,"ك",1,0],["وَما حَفَلَت حَضارِ وَلا سُهَيلٌ","بِأَبشارٍ يَمانِيَةٍ يُدَسنَه",110,"ن",2,0],["وَما حَمَلا رَحلَينِ طَوراً فَيُؤنِسا","إِذا حَفَزَ الوَشكُ الرِحالَ يَئِطّانِ",111,"ن",1,0],["وَما حَقَنَت دَمَ الإِنسانِ فيها","رُموسٌ في الرَغامِ تَفَوَّقَتهُ",112,"ت",2,0],["وَما حَمِدتُ كَبيراً في تَحَدَّ بِهِ","وَلا عَذَلتُ صَغيراً في تَجافيهِ",113,"ف",3,0],["وما حمدتك في هولٍ ثبتّ له","حتى بولتك والأبطال تمتصع",114,"ع",1,0],["وما حكمةُ الصَّمْتِ في عالمٍ","تضجُّ المطامعُ فيهِ اقتتالا",115,"ل",2,0],["وما حلَّ داراً فيكِ يوماً ولا هفتْ","على قلبه ذكراكِ من عهد إِسرَالِ",116,"ل",1,0],["وما حياةُ الفتى فيه أتسليةٌ","وراحةٌ أم فُجاءاتٌ وأخطارُ",117,"ر",1,0],["وما حَيَوانُ البَرّ فيها بِسالِمٍ","إذا لم يُغِثْهُ سِيفُها أو سَفينُها",118,"ن",3,0],["وَما حَمَلَت أُنثى وَما خَبَّ ذِعلِبٌ","وَما طَفَحَ الآذِيُّ في لُجَجِ البَحرِ",119,"ر",1,0],["وَما حَمَلَت ذَوُو الأَنسابِ ضَيماً","وَلا سَمِعَت لِداعيها مَقالا",120,"ل",2,0],["وَمَا حَرَكَاتُ النَّفْسِ إِلَّا دَلالَةٌ","عَلَى صِدْقِ مَا قَالُوا بِهِ فِي التَّعَيُّفِ",121,"ف",1,0],["وَمَا حَمَلَ السَّيْفَ الْكَمِيُّ لِزِينَةٍ","وَلَكِنْ لأَمْرٍ أَوْجَبَتْهُ الْمَفَاخِرُ",122,"ر",1,0],["وما حدثتني بالفرار عزيمتي","وكم حدثتني بالفرار من الوِزرِ",123,"ر",1,0],["وما حاجتي لغذاء وماء؟","بحسبيَ طفلاي زادًا، ورِيَّا",124,"ي",2,0],["وما حلموا في النوم إلا برتبةٍ","تُساقُ إليهم، أو زيادةِ راتب",125,"ب",1,0],["وَمَا حُبُّ مَشْغُوفَيْن بُثَّ هَوَاهُما","إذا لم يكن فيه نثاً وعتابُ",126,"ب",1,0],["وما حكمة الصّمت في عالم","تضجّ المعالم فيه اقتتالا",127,"ل",2,0],["وَما حَمدَ الفيتانُ، مثلَ مُحَمّد،","سَنَاماً لعَلْيَاء الفَعَالِ، وَكاهلا",128,"ل",2,0],["وَما حُسِبَتْ نَوَاحي الأرْضِ، حتى","مَلَكْتَ السهْلَ، منها، وَالجِبالا",129,"ل",2,0],["وما حياة ُ امرىء ٍ أَضْحَتْ مَدَامِعُهُ","مقسومة ً بين أحيَاءٍ وأمواتِ",130,"ت",1,0],["وَما حَكى السَلَف الماضي وَحَدثنا","بِهِ مِن الفَضل بَعضٌ مِن مَعاليكا",131,"ك",2,0],["وما حب الديار شغفن قلبي","ولا هبهن أجج في نارا",132,"ر",2,0],["وما حلا مِنهُ صابٌّ كانَ جرعه","وإنما شابَ إحلاءً بإمرارِ",133,"ر",1,0],["وما حال طفلٍ ضامر ظامئ الحشا","إذا غاله سهم المنايا الجوائر",134,"ر",1,0],["وما حَنَّ مشتاقٌ وما ناحَ طائرٌ","وما سارت العِيس الهِجانُ براكبِ",135,"ب",1,0],["وما حُسْن قصر كلّ من فيه خائف","بجانب قبر فيه بيت محرّمُ",136,"م",1,0],["وما حاجةُ الغَيْرَانِ فيهم إلى القنا","وقد منعتْ منهم عِصِىُّ حِجالِ",137,"ل",1,0],["وَما حامِلي أَن أَستَزيدَ مُصَرِّحاً","سِوى أَنَفي أَن يَجدَعَ الدَهرُ لي أَنفا",138,"ف",2,0],["وَما حَمَّلتَ نَفسَكَ فيهِ وِزراً","وَلا حَمَّلتَ عِزَّكَ فيهِ ثِقلا",139,"ل",2,0],["وما حاتم قل لي وما حلم أحنف","وما زهد ابراهيم أدهم ما الصبر",140,"ر",1,0],["وما حاليطيق إذا انتحالي","فكيف يلذ لي طعم وشرب",141,"ب",1,0],["وما حال الطعام من انتحالي","وإن مرام هذا الحب صعب",141,"ب",1,0],["وما حجر إسماعيل لولا محمدٌ","تداركه حجراً معدا لذي حجرِ",142,"ر",1,1],["وما حكته الريح في اقداحها","من رقة الماء ولون الخمر",143,"ر",1,0],["وما حممت لمكروهِ تُساء به","لكنْ ليُعلم فضلٌ فيك قد جُهلا",144,"ل",2,0],["وما حسبوه في الهوى جاء ناقصا","فليس يفي للعاشقين حساب",145,"ب",1,0],["وما حسدت على كوني أحبكم","لكن على كونه حبا جرى مثلا",146,"ل",2,0],["وما حفظ العليا ووفها حقوقها","فتى لم يطاعن دونها ويضارب",147,"ب",1,0],["وما حالة إلا تحول بأهلها","وهذا هو المعهود من خلق الدهر",148,"ر",1,0],["وَما حُسَينٌ وَبَدرٌ إِن ذَكَرتُهُما","إِلّا هُمامانِ فاقَ الناسَ مَجدُهُما",149,"م",2,0],["وما حُبُّ أُمِّ الغَمرِ إِلاّ سَجِيَّةٌ","عليها بَرانى اللهُ ثُمَّ طَوَانِى",150,"ن",2,0],["وما حان وقتُ الشيبِ منه وإنما","له عِلَّةٌ من وَجْدِه واكْتئابه",151,"ب",2,0],["وما حَظُّه من كسْبه غيرُ قُوتِه","ويَجمع للوُرّاثِ كلَّ حَرام",152,"م",1,0],["وما حرّمت شرب الراح زهدا","ولكن خوف وجاببة الرضاع",153,"ع",1,0],["وما حضك النصيحة والتواني","وليس على مودته مزيد",154,"د",1,0],["وَما حَجَبت عَن قومهِ غير شخصهِ","وَأَنوارهُ قَد عمّتِ البرّ والبحرا",155,"ر",2,0],["وَما حُسَينَةُ إِذ قامَت تُوَدِّعُنا","لِلبَينِ وَاِعتَقَدَت شَذراً وَمُرجانا",156,"ن",2,0],["وما حيلتي إن لم تكنْ ليَ حيلةٌ","وهل بعدَ ما ترمينَ لحظكِ أتقي",157,"ي",1,0],["وما حَسَنٌ في كلِّ يوم تعاتُبٌ","ولا يحسن التفنيد في الجدِّ والهَزلِ",158,"ل",1,0],["وما حبهم للحرب والدهر كله","عليهم جحيمٌ ثائر يتغول",159,"ل",1,0],["وما حاربْتَك التُّرْك إلاّ وبينها","وبين الهُدَى والمَكْرُماتِ حروب",160,"ب",1,0],["وما حال من يدني إليه عداته","تدس له في الشهد سما فيشرب",161,"ب",1,0],["وما حيلةُ المَحزُونِ إلا لواعجٌ","تفيضُ بها الأحشاءُ أو عبرَةٌ تَجري",162,"ر",2,0],["وَما حَسَدتُ بَني بَدرٍ نَصيبَهُمُ","في الخَيرِ دامَ لَهُم مِن غَيرِيَ الحَسَدُ",163,"د",1,0],["وَما حَيٌّ نَحُلُّ بِعَقوَتَيهِم","مِنَ الحَربِ العَوانِ بِمُستَراحِ",164,"ح",1,0],["وما حيلتي إِن لم يُدارِك بعفوِهِ","إله كريم طالَما وهبَ العَفوَا",165,"و",2,0],["وما حَمدَ الإفرنجُ قلباً وساعداً","ولكنَّهم قد يجمدونَ السنوَّرا",166,"ر",2,0],["وَما حَشْوُ الضُّلُوعِ سِوى أُوارٍ","وَما نَوْمُ الجُفون سِوى غِرارِ",167,"ر",1,0],["وما حظ من قد غره نصل صارمٍ","رجا نصره من غمده والحمائل",168,"ل",1,0],["وَما حَسَنٌ عَن ذَلِكَ الحُسنِ سَلوَةٌ","وَلا الصَّبرُ عَن ذاكَ الجَمالِ جَميلُ",169,"ل",1,0],["وما حفظت عيناي من شؤم بختي","على كثرةِ الأشعار إلا قفا نبك",170,"ك",1,0],["وَما حُزتَ الرئاسة باِكتسابٍ","كَما يسعى لنا فيها لئامُ",171,"م",1,0],["وَما حُزناهُ مِن حلٍّ وَحُرمٍ","يُوَزَّعُ في البَنينِ وَفي البَناتِ",172,"ت",1,0],["وَمَا حَدَّثَتْني النَّفْسُ عنكَ بِسَلْوَةٍ","كَأَنَّ الهَوَى مِنّي عَلَيَّ رَقِيبُ",173,"ب",1,0],["وَمَا حَجَبَ الأمْلاكَ تَاللّهِ مِثلُهُ","فَلا زَالَ عَن عَيْنِ الخُطُوب محجَّبَا",174,"ب",2,0],["وَمَا حَاجَةٌ لِشبابٍ غَدَتْ","تُسَوِّدُ وَجْهَكَ فيهِ يَدُكْ",175,"ك",1,0],["وَمَا حَاجَةٌ أُدْلي إليكُ بِحُجَّةٍ","وَقَلبُكَ لِلوَرَّاقِ أَعْدَلُ شَاهِدِ",176,"د",1,0],["وَما حَجَبتَني عَن مَلالٍ وَإِنِّما","لِمَعنىً لِأَهلِ العِشقِ فيهِ جَوابُ",177,"ب",1,0],["وَما حيلة اللاحي بِمَن عَمّ فَضله","وَأَضرب صَفحاً عَن سَماع فُضولهِ",178,"ل",2,0],["وما حائماتٌ حمن يوماً وليلةً","على الماء يغشين العِصيَّ حوانِ",179,"ن",1,1],["وَما حَرَّكَتني لِلدَناءَةِ هِمَّتي","وَلي عِفَّة مَطبوعَة لا تعفف",180,"ف",1,0],["وما حُلْتُ عن عَهْد من البِشْرِ سابقٍ","فتَشمتَ بي حاشا معاليك لُوّامي",181,"ي",1,0],["وما حالُ مَن يبغي اصطياداً بكَفِّهِ","إذا لاح نَوءٌ والوَسائقُ نُور",182,"ر",1,0],["وما حِليةُ الأَشرافِ إلاّ مآثرٌ","وهل حِلْيةٌ للمشرفيِّ سوى الأثر",183,"ر",1,0],["وما حَسُنَ النَّيروزُ إلا لأنّه","أجَدّ طُلوعاً فيه وجهُك بالسَّعْد",184,"د",1,0],["وما حِليةُ الأملاكِ مِمّا أَصوغُه","سِوى دُرَرٍ أسماؤهُنَّ قصيد",185,"د",1,0],["وما حلية الأعمارِ إلا مُعارةٌ","فخلِّ لها خَيلَ البَطالةِ تَمْعَج",186,"ج",1,0],["وما حادَ عن جَمعَي نَهاوَندَ جَمعُنا","وما زال قومي يمنعون المَواليا",187,"ي",2,0],["وَما حُسنُ السَلامَةِ فَوقَ بَرٍّ","وَيا قُبحَ الشَماتَةِ بِالغَريقِ",188,"ق",1,0],["وما حِيلةُ الباني إذا كانَ دَهرُهُ","أبَا البِشرِ لا ينفَكُّ يَهدِمُ ما يَبنِي",189,"ن",2,0],["وَما حَدَثَ عَن سُبُلِ الوَفا حَسب طاقَتي","وَلَكنما الأَيام جارَت عَن القَصدِ",190,"د",1,0],["وَما حِيلَتي في الهَوى وَالهَوى","يَجور عَلى النَفس سُلطانُهُ",191,"ن",2,0],["وَما حِمامي غَير إِن","أَراكَ تَصُب البَصَر",192,"ر",1,0],["وما حياة كثيب قلبُه أَسَفاً","قد بانَ عن جسدٍ للسّقم لَمْ يبنِ",193,"ن",1,0],["وَما حُسن هَذا الشِعر إِلّا لنفثِهِ","لَهُ في فَمي من قبل قطع وِصالِهِ",194,"ل",2,0],["وَما حَنَّ مِن وَجدٍ بِنَجدٍ وَإِنَّما","يَحِن إِلى نَجد لِمَن حَلَّ في نَجدِ",195,"د",1,0],["وما حوَتْ أيديهِمُ فَهو في","مثلِ لَهاةِ الأسَدِ الجائِعِ",196,"ع",1,0],["وما حَطّني أخذُهُ ما استَعادَ","ولا زادَني رِفعةً ما وَهبْ",197,"ب",1,0],["وما حاق مكر السَّوء إلا بأهله","وبعد فما يدريك ما الله فاعل",198,"ل",1,0],["وما حصل المعتوهُ ظنًّا يظنُّه","ومن فعله فيها وما هو فاعل",198,"ل",1,0],["وما حيلة الإِنسان فيما ينوبه","إذا كانَ أمر الله فيه مقدَّرا",199,"ر",2,0],["وما حَمَلَتْهُ غيرُ أُمٍّ نجيبةٍ","وإن كانَ من قوم أغرّ ممجد",200,"د",1,0],["وما حلها غاد ألمّ به الأسى","من البؤس إلّا وهو بالبر صادر",201,"ر",1,0],["وما حَفِظُوا أعلامها ونِظامَها","بِمِثْلِكَ من مولىً ومِثلِيَ من عَبْدِ",202,"د",1,0],["وما حاكَمَتْ فِيهِ السيوفُ وحازهُ","إليكَ أَبو الأَملاكِ جدُّكَ مرْوانُ",203,"ن",1,0],["وما حازم من لم تكن سبقت له","لطائف إقبالٍ من اللَه حازم",204,"م",1,0],["وما حرقة إلا ويبرد حرها","وحرقة قلبي بعده ليس تبرد",205,"د",1,0],["وما حلم النيام وإن تغالى","كحلم الصحو مؤتلقا سريا",206,"ي",2,0],["وما حواه الحصى نشوان مؤتلقا","كأنما هو من تيجان ربات",207,"ت",1,0],["وما حطَّك الدهرُ في سؤددٍ","تسامَوْا له ووفاءٍ وخِيمِ",208,"م",1,0],["وما حسدُ النجومِ على المعالي","ولو ذابَ الحصا حسدا بمُجدي",209,"ي",1,0],["وما حَوَى وأيُّ فضلٍ ما حوى","ذاك العتيقُ البارزُ المحجَّبُ",210,"ب",1,0],["وما حبُّ ميٍّ غيرُ بُرْدٍ طويتُهُ","على الكُرهِ طيَّ الرَّثِّ وهو قشيبُ",211,"ب",1,0],["وما حملتْك الخيلُ إلا مُغيرةً","على حيِّ فُتَّاكٍ وغزْوة سيد",212,"د",1,0],["وما حالةٌ في الدهر إِلا ستنقضي","ويُعْقبُها بعد البَقاء زوالُ",213,"ل",1,0],["وما حملتْمُ به تمراً إلى هَجَرٍ","إذْ كلُّ زاويةٍ من أرضكم هَجر",214,"ر",1,0],["وما حلمت مني إليه بضاعةٌ","من الفضل إلاّ أحمدتْ صفقة الربح",215,"ح",1,0],["وما حان عصر الشيب لكن أتاحه","لقاء عدوٍّ وازورارُ صديق",216,"ق",1,0],["وما حُلَّ في الأطلالُ خيطُ مدامعي","فلا عاقها خيطُ الغمام بحله",217,"ل",2,0],["وما حاز ودّي غيرُ خلٍّ ولم تكن","لغير حبيبٍ ذلّتي وخضوعي",218,"ع",2,0],["وما حملت من كلّ أشعث وجهه","إلى الله يرجو أن يكون قبول",219,"ل",1,0],["وما حسبتُ أنكمْ","تَنْسَوْنَ حَقَّ وُدي",220,"ي",1,0],["وما حلَّ مِن خيطِ الغمامِ فأدمعي","تُخَجِّلُ ماجادَ الغمامُ بحلِّهِ",221,"ل",2,0],["وما حماماتٌ بوادي الغَضا","مِن لحنها يَخْجَلُ اسحاقُ",222,"ق",1,0],["وما حيلتي واللطف منها استمالني","اليها وإن غشت أشعته السحب",223,"ب",1,0],["وما حيوان في الرياض ممايلا","معاين ضراب بجولتي",224,"ت",2,1],["وما حال صب بالعراق فؤاده","أسير وثاو في خراسان سائره",225,"ر",2,0],["وما حُبِّي لها إلّا عذاب","عليه من نضارتها نعيمُ",226,"م",1,0],["وما حلّ بحوّاءَ","وآدمَ بعد أنْ هانا",227,"ن",2,0],["وما حسن فوق الحسين وإنما","تأخر عنه بالولادة عصره",228,"ر",2,0],["وما حسدت جهولاً فضل ثروته","والريش ينبت فوق النسر والرخم",229,"م",1,0],["وَما حملتْ يُمناه إلّا صوارماً","لِكُلّ وريدٍ من كميٍّ بواتكا",230,"ك",2,0],["وَما حَنينِيَ إلّا لِلعَلاءِ إِذا","حنّ الرّجالُ إلى هذي الطّراميسِ",231,"س",1,0],["وما حيلتِي أن كنتُ في سرّ أُسرَتي","ولم يشركوا في صفوتي ولُبابي",232,"ي",1,0],["وما حدا باسمكم حادٍ فأطربني","إلا وَجُدْتُ له بالروح والمال",233,"ل",1,0],["وما حل في الأمواج بحر ولا به","قد اتحدت بل تلك عنه لها البر",234,"ر",1,0],["وما حُسنُ البِداءَةِ شرطُ حُبٍّ","ولكن شرطُهُ حسنُ الخِتامِ",235,"م",1,0],["وما حَكمَتْ فيهم فشُلَّتْ يدُ البلى","فيا ليت من أَبلاهمُ أَبلاني",236,"ي",1,0],["وما حولي انقَضَّ ذاك الغرام","وما انقَضّ إِلاَّ وقد أَنْقضَا",237,"ض",2,0],["وما حملت منَّةً للسحا","بِ إِلاَّ ومِنَّتُها أَكْبَرُ",238,"ر",1,0],["وما حَدُّه مَا في يَديْه وضِعْفُه","سيُبلِغ ما لا يبلغ الرُّمْحُ جَدَّه",239,"ه",1,0],["وما حن رعد أو تألق بارق","وما انهل صوب ودقة يتحلب",240,"ب",1,0]]}