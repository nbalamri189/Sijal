{"poems":[[30,"أخرقاء للبين استقلت حمولها","https://www.aldiwan.net/poem29537.html","الطويل"],[30,"أشاقتك أخلاق الرسوم الدواثر","https://www.aldiwan.net/poem29579.html","الطويل"],[83,"لو كنت أعطي من لقائك سولا","https://www.aldiwan.net/poem54262.html","الكامل"],[88,"نجيت بالسد بغدادا من الغرق","https://www.aldiwan.net/poem44443.html","البسيط"],[88,"هي دنيا بقاؤها مستحيل","https://www.aldiwan.net/poem45050.html","الخفيف"],[72,"ليل وصل معطر الأرجاء","https://www.aldiwan.net/poem18169.html","الخفيف"],[51,"أحمد الله نية وثناء","https://www.aldiwan.net/poem7941.html","الخفيف"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"شاب رأسي ولات حين مشيب","https://www.aldiwan.net/poem8148.html","الخفيف"],[51,"ومن العجائب يا أبا الفياض","https://www.aldiwan.net/poem64948.html","الكامل"],[92,"يا أيها الشادي المغرد ههنا","https://www.aldiwan.net/poem38941.html","الكامل"],[85,"آذار أقبل قم بنا يا صاح","https://www.aldiwan.net/poem7257.html","الكامل"],[85,"قالوا تمايز حمزة","https://www.aldiwan.net/poem8057.html","مجزوء الكامل"],[85,"يا عزيزاً لنا بمصر علمنا","https://www.aldiwan.net/poem8061.html","الخفيف"],[85,"قد كنت أوثر أن تقول رثائي","https://www.aldiwan.net/poem62927.html","الكامل"],[85,"حف كأسها الحبب","https://www.aldiwan.net/poem63726.html","المقتضب"],[45,"أقصرا ليس شأني الإقصار","https://www.aldiwan.net/poem63558.html","الخفيف"],[45,"ها هو الشيب لائما فأفيقي","https://www.aldiwan.net/poem65182.html","الخفيف"],[66,"تركتنا لواحظ الأتراك بين","https://www.aldiwan.net/poem40647.html","الخفيف"],[74,"أرأيك أمضى أم حسامك يقطع","https://www.aldiwan.net/poem13174.html","الطويل"],[105,"كذب الملوك ومن يحاول عندهم","https://www.aldiwan.net/poem43400.html","الكامل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[50,"بكرا صاحبي قبل الهجير","https://www.aldiwan.net/poem63820.html","الخفيف"],[50,"أعبدة قد غلبت على فؤادي","https://www.aldiwan.net/poem63875.html","الوافر"],[76,"ألحاظ عيني تلتهي","https://www.aldiwan.net/poem38861.html","مجزوء الكامل"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/66042","الرمل"],[121,"ليالي سلمى ترتقي لي وتراقيا","https://www.aldiwan.net/poem23827.html","الطويل"],[160,"رتب لهم حطت فما رفعت","https://www.aldiwan.net/poem58705.html","أحذ الكامل"],[185,"مجد تقاصر عن سماه الفرقد","https://www.aldiwan.net/poem14509.html","الكامل"],[226,"رقية الحب","https://www.aldiwan.net/poem24235.html","عموديه"],[271,"يا جيرة الحي في ذا الاثل والبان","https://www.aldiwan.net/poem52066.html","البسيط"],[328,"رتل البلبل الطروب لحونه","https://www.aldiwan.net/poem55066.html","الخفيف"],[353,"رتب العز والتقى","https://www.aldiwan.net/poem40027.html","مجزوء الخفيف"],[353,"أنت هام العز للرتب","https://www.aldiwan.net/poem40773.html","المديد"],[353,"مستهام رق وانتحبا","https://www.aldiwan.net/poem40811.html","المديد"],[364,"سل صدور الركاب ماذا الحنين","https://www.aldiwan.net/poem60627.html","الخفيف"],[364,"من رأي قبل ثناياك مداما","https://www.aldiwan.net/poem60646.html","الرمل"],[364,"قسما لقد رجع النسيم عليلا","https://www.aldiwan.net/poem60803.html","الكامل"],[364,"زد علوا في كل يوم ورفعه","https://www.aldiwan.net/poem60844.html","الخفيف"],[366,"زارت فزارك في الظلام ضياء","https://www.aldiwan.net/poem16913.html","الكامل"],[403,"مرحبا يا مرحبا يا مرحبا","https://www.aldiwan.net/poem34127.html","الرمل"],[437,"أي طود هوى من الأطواد","https://www.aldiwan.net/poem2497.html","البسيط"],[439,"أقدمت دون معالم الإسلام","https://www.aldiwan.net/poem34781.html","الكامل"],[458,"ما المجد إلا بالعزيمة فاعزِمِ","https://www.aldiwan.net/poem55904.html","الكامل"],[458,"ما جد السعي أتاه ما سعى له","https://www.aldiwan.net/poem55933.html","الرمل"],[458,"جاء بها والخير مجلوب","https://www.aldiwan.net/poem56277.html","السريع"],[461,"علقته والصبا غض الأديم","https://www.aldiwan.net/poem15087.html","الرمل"],[464,"لا تلمني فلات حين ملام","https://www.aldiwan.net/poem3141.html","عموديه"],[464,"اخذ الكرى مني وأعطاني الأسف","https://www.aldiwan.net/poem3425.html","عموديه"],[515,"يا من أدل يبسط العذر من جارا","https://www.aldiwan.net/poem12138.html","البسيط"],[515,"رتبة الحكم السنيه","https://www.aldiwan.net/poem12308.html","مجزوء الرمل"],[538,"رتب العز وعز الرتب","https://www.aldiwan.net/poem47425.html","عموديه"],[558,"ظهر الحق للعيان وبينا","https://www.aldiwan.net/poem33801.html","الخفيف"],[558,"كنت بالأمس عند نفسي كثيفا","https://www.aldiwan.net/poem34352.html","الخفيف"],[558,"عدم للوجود كالأمواج","https://www.aldiwan.net/poem34687.html","الخفيف"]],"verses":[["رِتاجَ الصَلا مَكنوزَةَ الحاذِ يَستَوي","عَلى مِثلِ خَلقاءِ الصَفاةِ شَليلُها",0,"ل",3,0],["رَتوعَينِ أَدنى مَرتَعٍ حَلَّتا بِهِ","بِلا زَمٍ تَقييدٍ وَلا صَوتِ زاجِرِ",1,"ر",1,0],["رتعت به حولي الظباء أوانساً","فنعمت فيه معرْساً ومقيلا",2,"ل",2,0],["رتبتها حيث كل الناس تقرؤها","سطراً بمدحك مكتوباً على الأفق",3,"ق",1,0],["رتّلت ألسن اللذائذ آي ال","عيش فيها فغرّنا الترتيل",4,"ل",1,0],["رتعتْ في حماك ثم استراحت","من ألِيمَين الرحلِ والبيداء",5,"ا",2,0],["رُتَباً لم تَشِد لنا مثلها الآ","باءُ نرجو توريثَها الأبناءَ",6,"ا",2,0],["رَتَعوا في وخِيمة الغيب مني","لا تَلَقَّى مَنِ ارْتعاها مَرَاءَ",7,"ا",2,0],["رتّبتهُ الملوكُ مرتبةَ المِدْ","رَهِ لا مُخطئين في الترتيبِ",8,"ب",1,0],["رتَّبْتَ قدْرَك دونَ ما مُلِّكتَه","لا ظُلمَ أنت عليه أعدل قاضي",9,"ض",2,0],["رتِّل على سَمْع الرَّبيعِ نشيدَهُ","واصْدَحْ بفيْضِ فؤادك المَسْجورِ",10,"ر",1,0],["رتّلن في أوراقهن ملاحنا","كالراهبات صبيحة الإفصاح",11,"ح",1,0],["رُتَبٌ كَرائِمُ في العُلا","وُجِّهنَ مِنكَ إِلى كَريمِ",12,"م",1,0],["رُتبَةً أَلسُنُ العُلا أَرَّختَها","أَنتَ مَحمودُ في العُلا المُتَمايِزِ",13,"ز",1,0],["رُتَبُ الشَجاعَةِ في الرِجالِ جَلائِلٌ","وَأَجَلُّهُنَّ شَجاعَةُ الآراءِ",14,"ا",2,0],["رُتبَةُ الجُدودِ لَهُ","تَستَوي بِها الرُتَبُ",15,"ب",1,0],["رُتبَةٌ مِن خِلافَةِ اللَهِ قَد طا","لَت بِها رَقبَةٌ لَهُ وَاِنتِظارُ",16,"ر",1,0],["رَتَقَتهُ سُيوفُنا وَهوَ ثَغرٌ","بَينَ أَعدائِهِ كَثيرُ الفُتوقِ",17,"ق",1,0],["رُتبَةٌ جاوَزَت مَقامَ ذَوي العِل","مِ وَفاقَت مَراتِبَ النُسّاكِ",18,"ك",1,0],["رَتَعَت عَلى حُكمِ السَماحِ بِرَبعِهِ","وَمَربَعُ أَبناءِ السَماحَةِ مَرتَعُ",19,"ع",1,0],["رُتبٌ وَأَلقابٌ تَغُرُّ وَما بِها","فَخرٌ لِحامِلِها وَلا اِستِعلاءُ",20,"ا",2,0],["رُتَبٌ تَسْقُط الأَمانيُّ حَسْرَى","دونَها ما وراءهن وَرَاءُ",21,"ا",2,0],["رُتَّقٌ لِلثَّأي مَراجيحُ في النَد","وَةِ يَشفونَ غُلَّةَ المُستَجيرِ",22,"ر",1,0],["رَتَقتِ لَهُنَّ يا عَبّادَ عِندي","وَإِن كُنَّ المَلائِحَ بِالكَسادِ",23,"د",1,0],["رَتَعتْ بها وتَنزَّهتْ","فيها ألذَّ تَنزُّهِ",24,"ه",1,0],["رَتَّلَ الرَّعْدُ نَشيداً","رَدَّدَتْهُ الكائِناتْ",25,"ت",1,0],["رتعت ودوني رَوحٌ ريحان روحه","لعل الذي اشتاق يدني بذاتيا",26,"ي",2,0],["رتب لهم حطت فما رفعت","منعوا فما نالوا الذي طلبوا",27,"ب",3,1],["رُتَبٌ خُصِصْتَ بها وما صادفتها","لكنْ أَفادَكها الحِجَا والسؤدد",28,"د",1,0],["رتّل الحب رقاه","في سكون لتنامي",29,"ي",1,0],["رتعن آمالنا في ريف رأفته","فنحن بنت رجاء وَهو هتان",30,"ن",1,0],["رتل البلبل الطروب لحونَه","شاديا يسمع الغناء غصونه",31,"ن",2,1],["رتبُ العزِّ وَالتُقى","بِكَ عزَّت تَحقّقا",32,"ق",2,1],["رُتبة زانَها الكَما","ل جَمالاً وَرَونَقا",32,"ق",2,0],["رُتبة التَدريس فيك لَقَد","نَجَبُت يا أَنجب النجبِ",33,"ب",1,0],["رَتّلت مَدحي مَناقبهُ","مَن رأى تَرتيله اِعتَجَبا",34,"ب",2,0],["رُتَبٌ من عُلاً بدَتْ وهْيَ عُنوا","نٌ ويأتي من بَعْدِه المَضْمون",35,"ن",1,0],["رُتَبّ منها ومن عَلْيائها","تَملِكُ الحاسدَ أنفاً ورَغاما",36,"م",2,0],["رُتَبٌ بها زيدَتْ عُلاك نَباهةً","من غيرِ أن كنتَ اشتكَيْتَ خُمولا",37,"ل",2,0],["رُتَبٌ لم تُبِتْ حَسودَك إلاّ","ساهراً ما تَخيطُ عَينَيْهِ هَجْعه",38,"ع",2,0],["رَتَعَت جُفوني مِن سَناكَ بِجَنَّةٍ","فَتَبَوَّأَت مِنهُ بِحَيثُ تَشاءُ",39,"ا",2,0],["رتب المجد بجود هاطل","من يديه دائماً منسكبا",40,"ب",2,0],["رتبة الظاهر الإمام ومن را","ح لدين الإسلام خير عماد",41,"د",1,0],["رُتَباً رفَعْتَ ثناءها وسَناءَها","بِشَبا الرِّماحِ وألسُنِ الأقلامِ",42,"م",1,0],["رتقاء يزلَق بالأسنّة سردُها","زلَقَ الصفاةِ بليلةً بالمنسِمِ",43,"م",1,0],["رتبةٌ لم تقتعدْها غَلطاً","ومُقامٌ لم ترثْه عن كَلالَهْ",44,"ل",2,0],["رتبةُ عِزٍّ فخرُها عاجلٌ","وأجرُها ذُخرٌ وتعقيبُ",45,"ب",1,0],["رتبٌ غادرنه ذا شغلٍ","بهواها عن هوى ظبيٍ وريم",46,"م",1,0],["رتعوا من ثنائه بشميمٍ","حين لاذوا من حكمهِ بشمامِ",47,"م",1,0],["رتعت بوجنته سوام لحاظنا","وبها الزُّلال الكوثري لمن رشفْ",48,"ف",1,0],["رتب على الباب إنساناً له أدب","وعشرة يلتقي بالبشر من زارا",49,"ر",2,0],["رتبة الحكم السنيه","هدمت هدم البنيه",50,"ن",3,1],["رتب العز وعز الرُتَبِ","همم العليا وعليا الهمم",51,"م",1,1],["رُتَبٌ تنقضي وأخرى توافي","باعتبار منه لهنَّ يقينا",52,"ن",2,0],["رتب في وجوده نحن عنه","قد ظهرنا به له توصيفا",53,"ف",2,0],["رتبة الذات قبل رتبة علم","بعدها رتبة الكلام المناجي",54,"ي",1,0]]}