لُها",0,"ل",3,0],["رَتوعَينِ أَدنى مَرتَعٍ حَلَّتا بِهِ","بِلا زَمٍ تَقييدٍ وَلا صَوتِ زاجِرِ",1,"ر",1,0],["رتعت به حولي الظباء أوانساً","فنعمت فيه معرْساً ومقيلا",2,"ل",2,0],["رتبتها حيث كل الناس تقرؤها","سطراً بمدحك مكتوباً على الأفق",3,"ق",1,0],["رتّلت ألسن اللذائذ آي ال","عيش فيها فغرّنا الترتيل",4,"ل",1,0],["رتعتْ في حماك ثم استراحت","من ألِيمَين الرحلِ والبيداء",5,"ا",2,0],["رُتَباً لم تَشِد لنا مثلها الآ","باءُ نرجو توريثَها الأبناءَ",6,"ا",2,0],["رَتَعوا في وخِيمة الغيب مني","لا تَلَقَّى مَنِ ارْتعاها مَرَاءَ",7,"ا",2,0],["رتّبتهُ الملوكُ مرتبةَ المِدْ","رَهِ لا مُخطئين في الترتيبِ",8,"ب",1,0],["رتَّبْتَ قدْرَك دونَ ما مُلِّكتَه","لا ظُلمَ أنت عليه أعدل قاضي",9,"ض",2,0],["رتِّل على سَمْع الرَّبيعِ نشيدَهُ","واصْدَحْ بفيْضِ فؤادك المَسْجورِ",10,"ر",1,0],["رتّلن في أوراقهن ملاحنا","كالراهبات صبيحة الإفصاح",11,"ح",1,0],["رُتَبٌ كَرائِمُ في العُلا","وُجِّهنَ مِنكَ إِلى كَريمِ",12,"م",1,0],["رُتبَةً أَلسُنُ العُلا أَرَّختَها","أَنتَ مَحمودُ في العُلا المُتَمايِزِ",13,"ز",1,0],["رُتَبُ الشَجاعَةِ في الرِجالِ جَلائِلٌ","وَأَجَلُّهُنَّ شَجاعَةُ الآراءِ",14,"ا",2,0],["رُتبَةُ الجُدودِ لَهُ","تَستَوي بِها الرُتَبُ",15,"ب",1,0],["رُتبَةٌ مِن خِلافَةِ اللَهِ قَد طا","لَت بِها رَقبَةٌ لَهُ وَاِنتِظارُ",16,"ر",1,0],["رَتَقَتهُ سُيوفُنا وَهوَ ثَغرٌ","بَينَ أَعدائِهِ كَثيرُ الفُتوقِ",17,"ق",1,0],["رُتبَةٌ جاوَزَت مَقامَ ذَوي العِل","مِ وَفاقَت مَراتِبَ النُسّاكِ",18,"ك",1,0],["رَتَعَت عَلى حُكمِ السَماحِ بِرَبعِهِ","وَمَربَعُ أَبناءِ السَماحَةِ مَرتَعُ",19,"ع",1,0],["رُتبٌ وَأَلقابٌ تَغُرُّ وَما بِها","فَخرٌ لِحامِلِها وَلا اِستِعلاءُ",20,"ا",2,0],["رُتَبٌ تَسْقُط الأَمانيُّ حَسْرَى","دونَها ما وراءهن وَرَاءُ",21,"ا",2,0],["رُتَّقٌ لِلثَّأي مَراجيحُ في النَد","وَةِ يَشفونَ غُلَّةَ المُستَجيرِ",22,"ر",1,0],["رَتَقتِ لَهُنَّ يا عَبّادَ عِندي","وَإِن كُنَّ المَلائِحَ بِالكَسادِ",23,"د",1,0],["رَتَعتْ بها وتَنزَّهتْ","فيها ألذَّ تَنزُّهِ",24,"ه",1,0],["رَتَّلَ الرَّعْدُ نَشيداً","رَدَّدَتْهُ الكائِناتْ",25,"ت",1,0],["رتعت أوابد كل عارفة بسا","حته فهن لمن اراد مصائد",26,"د",1,0]