{"poems":[[30,"أخرقاء للبين استقلت حمولها","https://www.aldiwan.net/poem29537.html","الطويل"],[30,"أشاقتك أخلاق الرسوم الدواثر","https://www.aldiwan.net/poem29579.html","الطويل"],[83,"لو كنت أعطي من لقائك سولا","https://www.aldiwan.net/poem54262.html","الكامل"],[88,"نجيت بالسد بغدادا من الغرق","https://www.aldiwan.net/poem44443.html","البسيط"],[88,"هي دنيا بقاؤها مستحيل","https://www.aldiwan.net/poem45050.html","الخفيف"],[72,"ليل وصل معطر الأرجاء","https://www.aldiwan.net/poem18169.html","الخفيف"],[51,"أحمد الله نية وثناء","https://www.aldiwan.net/poem7941.html","الخفيف"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"شاب رأسي ولات حين مشيب","https://www.aldiwan.net/poem8148.html","الخفيف"],[51,"ومن العجائب يا أبا الفياض","https://www.aldiwan.net/poem64948.html","الكامل"],[92,"يا أيها الشادي المغرد ههنا","https://www.aldiwan.net/poem38941.html","الكامل"],[85,"آذار أقبل قم بنا يا صاح","https://www.aldiwan.net/poem7257.html","الكامل"],[85,"قالوا تمايز حمزة","https://www.aldiwan.net/poem8057.html","مجزوء الكامل"],[85,"يا عزيزاً لنا بمصر علمنا","https://www.aldiwan.net/poem8061.html","الخفيف"],[85,"قد كنت أوثر أن تقول رثائي","https://www.aldiwan.net/poem62927.html","الكامل"],[85,"حف كأسها الحبب","https://www.aldiwan.net/poem63726.html","المقتضب"],[45,"أقصرا ليس شأني الإقصار","https://www.aldiwan.net/poem63558.html","الخفيف"],[45,"ها هو الشيب لائما فأفيقي","https://www.aldiwan.net/poem65182.html","الخفيف"],[66,"تركتنا لواحظ الأتراك بين","https://www.aldiwan.net/poem40647.html","الخفيف"],[74,"أرأيك أمضى أم حسامك يقطع","https://www.aldiwan.net/poem13174.html","الطويل"],[105,"كذب الملوك ومن يحاول عندهم","https://www.aldiwan.net/poem43400.html","الكامل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[50,"بكرا صاحبي قبل الهجير","https://www.aldiwan.net/poem63820.html","الخفيف"],[50,"أعبدة قد غلبت على فؤادي","https://www.aldiwan.net/poem63875.html","الوافر"],[76,"ألحاظ عيني تلتهي","https://www.aldiwan.net/poem38861.html","مجزوء الكامل"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/66042","الرمل"]],"verses":[["رِتاجَ الصَلا مَكنوزَةَ الحاذِ يَستَوي","عَلى مِثلِ خَلقاءِ الصَفاةِ شَليلُها",0,"ل",3,0],["رَتوعَينِ أَدنى مَرتَعٍ حَلَّتا بِهِ","بِلا زَمٍ تَقييدٍ وَلا صَوتِ زاجِرِ",1,"ر",1,0],["رتعت به حولي الظباء أوانساً","فنعمت فيه معرْساً ومقيلا",2,"ل",2,0],["رتبتها حيث كل الناس تقرؤها","سطراً بمدحك مكتوباً على الأفق",3,"ق",1,0],["رتّلت ألسن اللذائذ آي ال","عيش فيها فغرّنا الترتيل",4,"ل",1,0],["رتعتْ في حماك ثم استراحت","من ألِيمَين الرحلِ والبيداء",5,"ا",2,0],["رُتَباً لم تَشِد لنا مثلها الآ","باءُ نرجو توريثَها الأبناءَ",6,"ا",2,0],["رَتَعوا في وخِيمة الغيب مني","لا تَلَقَّى مَنِ ارْتعاها مَرَاءَ",7,"ا",2,0],["رتّبتهُ الملوكُ مرتبةَ المِدْ","رَهِ لا مُخطئين في الترتيبِ",8,"ب",1,0],["رتَّبْتَ قدْرَك دونَ ما مُلِّكتَه","لا ظُلمَ أنت عليه أعدل قاضي",9,"ض",2,0],["رتِّل على سَمْع الرَّبيعِ نشيدَهُ","واصْدَحْ بفيْضِ فؤادك المَسْجورِ",10,"ر",1,0],["رتّلن في أوراقهن ملاحنا","كالراهبات صبيحة الإفصاح",11,"ح",1,0],["رُتَبٌ كَرائِمُ في العُلا","وُجِّهنَ مِنكَ إِلى كَريمِ",12,"م",1,0],["رُتبَةً أَلسُنُ العُلا أَرَّختَها","أَنتَ مَحمودُ في العُلا المُتَمايِزِ",13,"ز",1,0],["رُتَبُ الشَجاعَةِ في الرِجالِ جَلائِلٌ","وَأَجَلُّهُنَّ شَجاعَةُ الآراءِ",14,"ا",2,0],["رُتبَةُ الجُدودِ لَهُ","تَستَوي بِها الرُتَبُ",15,"ب",1,0],["رُتبَةٌ مِن خِلافَةِ اللَهِ قَد طا","لَت بِها رَقبَةٌ لَهُ وَاِنتِظارُ",16,"ر",1,0],["رَتَقَتهُ سُيوفُنا وَهوَ ثَغرٌ","بَينَ أَعدائِهِ كَثيرُ الفُتوقِ",17,"ق",1,0],["رُتبَةٌ جاوَزَت مَقامَ ذَوي العِل","مِ وَفاقَت مَراتِبَ النُسّاكِ",18,"ك",1,0],["رَتَعَت عَلى حُكمِ السَماحِ بِرَبعِهِ","وَمَربَعُ أَبناءِ السَماحَةِ مَرتَعُ",19,"ع",1,0],["رُتبٌ وَأَلقابٌ تَغُرُّ وَما بِها","فَخرٌ لِحامِلِها وَلا اِستِعلاءُ",20,"ا",2,0],["رُتَبٌ تَسْقُط الأَمانيُّ حَسْرَى","دونَها ما وراءهن وَرَاءُ",21,"ا",2,0],["رُتَّقٌ لِلثَّأي مَراجيحُ في النَد","وَةِ يَشفونَ غُلَّةَ المُستَجيرِ",22,"ر",1,0],["رَتَقتِ لَهُنَّ يا عَبّادَ عِندي","وَإِن كُنَّ المَلائِحَ بِالكَسادِ",23,"د",1,0],["رَتَعتْ بها وتَنزَّهتْ","فيها ألذَّ تَنزُّهِ",24,"ه",1,0],["رَتَّلَ الرَّعْدُ نَشيداً","رَدَّدَتْهُ الكائِناتْ",25,"ت",1,0]]}