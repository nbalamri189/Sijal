{"poems":[[79,"أمولاي خذها بنت فكري تغيبت","https://www.aldiwan.net/poem36346.html","الطويل"],[88,"سلام على الإسلام بعد محمد","https://www.aldiwan.net/poem10494.html","الطويل"],[95,"لكيرللس المفضال راعي رعاتنا","https://www.aldiwan.net/poem11338.html","الطويل"],[90,"أتى من مصر طلعتها بن حرب","https://www.aldiwan.net/poem44397.html","الوافر"],[87,"تعذرت الركائب والمطايا","https://www.aldiwan.net/poem6816.html","الوافر"],[99,"غرامك لي معبد طاهر","https://www.aldiwan.net/poem24859.html","المتقارب"],[107,"محمد يا ابن مسلمة سلام","https://www.aldiwan.net/poem43990.html","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202535","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54867","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55122","الوافر"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54206","الطويل"],[105,"ملكنا هذه الدنيا قرونا","https://www.poetsgate.com/ViewPoem.aspx?id=1234",""],[215,"شاعر البحر إلى البحر يعود","https://www.aldiwan.net/poem46604.html","الرمل"],[242,"شربنا من سري يحمدي","https://www.aldiwan.net/poem19758.html","الوافر"],[280,"يقر بعيني أن قلبي ما قرا","https://www.aldiwan.net/poem25560.html","الطويل"],[449,"تقول غدا هل تدري ما يلد الغد","https://www.aldiwan.net/poem55970.html","عموديه"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48832","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48902","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48834","الطويل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109225","الطويل"],[1403,"","https://poetry.dctabudhabi.ae/diwan/poem/115363","الوافر"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48947","الطويل"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101722","الطويل"],[2697,"","https://poetry.dctabudhabi.ae/diwan/poem/107165","الطويل"],[2836,"","https://poetry.dctabudhabi.ae/diwan/poem/203442","الطويل"],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136979",""],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122487","البسيط"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45814","الطويل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136948",""],[5186,"تسآءلني فتاة الحي ما بي","https://www.poetsgate.com/ViewPoem.aspx?id=156495",""],[5701,"هذا هو العيد فلتصف النفوس به","https://www.poetsgate.com/ViewPoem.aspx?id=164630",""],[5956,"أنا والشعر والعالم","https://www.poetsgate.com/ViewPoem.aspx?id=185582",""],[5956,"اللغة العربية الفصحى ولهجاتها العامية","https://www.poetsgate.com/ViewPoem.aspx?id=202206",""]],"verses":[["تَعَهَّدْتَنِي بِالْجُودِ بَدْءً وَعَوْدَةً","وَأَلْبَسْتَنِي عِزًّا يُرُوقُ جَمَالُهُ",0,"ل",2,0],["تَعَهَّدَها فَضلُ الإِمامِ وَحاطَها","بِإِحسانِهِ وَالدَهرُ غَيرُ مُواتي",1,"ت",2,0],["تَعَهَّدَ هَذَا الصَّرْحَ بَعْدَ دُثورِهِ","فَجَدَّدَهُ مُسْتَكْمِلُ الوَضْعِ وَالرَّسْمِ",2,"م",1,0],["تعهّد بالمساعي الغر مصراً","فبدّل جدب تربتها بخصب",3,"ب",1,0],["تعَّهدَ ظلك الصحراء حتى","غدت رمضاؤها برد النعيم",4,"م",1,0],["تعهدتُ محرابه بالوفاء","وأوقدتُ فيه الهوى من شموعي",5,"ع",2,0],["تَعهَّدَهُ كَرِيمٌ أرْيَحِيٌّ","لهُ في كلِّ آونةٍ لِمامُ",6,"م",1,0],["تعهدوا الفتح بالاختطاط","ووصلوا الكوفة بالفسطاط",7,"ط",1,0],["تَعَهَّدْ ثُغُورَ المُلْكِ أَيّاً تَحُلُّهُ","فَذَاكَ لَهُ قَلْبٌ وَسَائِرُهُ الثَّغرُ",8,"ر",1,0],["تَعهَّدْهَا تَكُنْ فِي خَيْرِ مَعْنّى","لِحَبْلِ الخَيْرِ فِي الدنْيَا وُصُولاَ",9,"ل",2,0],["تَعَهَّدْتَه كالزَّارعِ الطَّب نَوْمُه","غِرَارٌ إلى أن يُبْصِرَ الزَّرْعَ أَحْصَدا",10,"د",2,0],["تعهدهم فأنبتهم نباتا","كريما طاب في الدنيا غصونا",11,"ن",2,0],["تعهدوا أن يتوبوا من غوايتهم","والتوب في بعض معناه من العار",12,"ر",1,0],["تَعَهَّدَهَا وَلَمْ يَجْدِبْ ثَرَاهَا","بِِوَسْمِيِّ التَّوَدُّدِ وَالْوَلِِيِّ",13,"ي",1,0],["تَعَهّدَها كَرُّ الجَدِيدَيْنِ بالبِلَى","فَيَا كَرْبَ نَفسي المُسْتَهامَة ما كَرَّا",14,"ر",2,0],["تعهدها ريح الصبا في فصولها","فلا حرها يقسو ولا البرد يشتد",15,"د",1,0],["تعهَّدِ الملك أدناه وأقصاهُ","وامْدُد من الحكم أوفاه وأبقاهُ",16,"ا",2,1],["تعهدت وحدي من تبنَّيت منهمُ","فكنت الأب الأعلى وكنت المعلما",17,"م",2,0],["تعهدتَه مستكملاً خيرَ أهله","وزار الأوداءَ الكرامَ ودود",18,"د",1,0],["تعهَّد بالروح العزيزة روضه","وقطّرها من فوقه بدل الندى",19,"د",2,1],["تعهَّدَ داركم صوبُ العهادِ","وروّها من النسم البراد",20,"د",1,1],["تعهّدها رِضوانُ في الشرق مرةً","فسالت وبات الدمع في العين باقيا",21,"ي",2,0],["تعهده صوب العهاد بأوطف","من المزن محلول الوكاء سجوم",22,"م",1,0],["تَعَهَّد بإِحسانٍ فَقِيراً وَعالِماً","فأَكرَمُ جَذبِ الناسِ ما كانَ عَن نَدى",23,"د",2,0],["تعهَّدتني بالبر يا ثاني البحر","ويا ثالث الشمس المنيرة والبدر",24,"ر",1,1],["تعهد الزهر بالري النقي فتى","محراثه ما التوى يوما ولا ثلما",25,"م",2,0],["تعَهَّدَاهَا بعدلٍ ثابِتٍ عَمِمٍ","فالخَيرُ في العدلِ لاَ فِي العَضبِ والأسلِ",26,"ل",1,0],["تَعَهدت مِن يَثني عَلَيك وَإِن نَأى","فَمنُّك أَثمار وَمِنا الحَمائم",27,"م",1,0],["تعهّد غرس الحب في روض قلبها","زماناً إلى ان جاء بالثمر الخضل",28,"ل",1,0],["تعهد كل عصر كل مصر","طوى صحف الفضيلة بالتباب",29,"ب",1,0],["تعهدوا الناس فيه من أضر به","ريب الزمان ومن كانوا لكم تبعا",30,"ع",2,0],["تَعَهَّدَ الدهرُ أن يرعى روائعنا","فهي الهداية بعد الدِّين في الظُّلَمِ",31,"م",1,0],["تعهد الله في صونٍ لمصحفه","وقد تحدَّى الذين استعذبوا العضا",32,"ض",2,0]]}