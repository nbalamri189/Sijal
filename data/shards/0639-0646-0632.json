{"poems":[[47,"أتراه يظنني أو يراني","https://www.aldiwan.net/poem66786.html","الخفيف"],[50,"قد أغتدي والصبح محمر الطرر","https://www.aldiwan.net/poem63417.html","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54950","السريع"],[287,"جيب الربيع على الإحسان مزرور","https://www.aldiwan.net/poem32762.html","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109406","الخفيف"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88644","البسيط"],[4802,"انخذلت","https://www.poetsgate.com/ViewPoem.aspx?id=36909",""],[5956,"نزهة","https://www.poetsgate.com/ViewPoem.aspx?id=182044",""],[5956,"في الذكرى* الأولى لوفاة شقيقي محمد","https://www.poetsgate.com/ViewPoem.aspx?id=192406",""],[6004,"خيال النَّدامى","https://www.poetsgate.com/ViewPoem.aspx?id=59141",""]],"verses":[["عَن زُحوفٍ مِنَ الأَعادي وَيَومٍ","مِن أَبي الساجِ فيهِم أَرونانِ",0,"ن",1,0],["عَن زَفِّ مِلحاحٍ بَعيدِ المُنكَدَر","أَقنى يَظَلُّ طَيرُهُ عَلى حَذَر",1,"ر",1,0],["عَنْ زَهَرٍ حُمِّلَ رِيحَ الصَّبَا","تَبَسُّماً مُسْتَتِراً فِي عَبِيرْ",2,"ر",1,0],["عَن زَعفَرانٍ رَنَت أَحداقُ نَرجِسِهِ","عَلى الزُمُرُّدِ وَالأَجفانُ كافورُ",3,"ر",1,0],["عن زفافٍ أرخت فاق بيمنٍ","وبهِ طالع السعود استنارا",4,"ر",2,0],["عن زهد عيسى وعلم الخضر مبتدلا","شبليه فاِعتاض عن علم وعن عمل",5,"ل",1,0],["عنْزّ..على الناس النشامى المسمّين","أهل البيوت النايفات المطلة",6,"ل",2,0],["عن زوايا قد شعُرْنا في ليالي","ها بإحساسٍ ملاكيٍّ جميلْ",7,"ل",1,0],["عن زوجة شربتْ مرارة فرقة","وسمومَ غَصات كألفِ حِمامِ",8,"م",1,0],["عَنْ زمَانٍ ينعِي زَوَالِ الْأَمََاني","كَيفَ آخَي الحبُُّ الجوَى وَتَحَابَا",9,"ب",2,0]]}