e.com/ViewPoem.aspx?id=162750",""],[5957,"لماذا عدتَ؟","https://www.poetsgate.com/ViewPoem.aspx?id=55378",""],[6031,"أكفُّ البَرَايَا مِنْ تُرَاثِهِمُ صُفْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=46279",""],[6068,"أ أُجْمع بالقبر عند محبٍّ -07-","https://www.poetsgate.com/ViewPoem.aspx?id=175889",""],[6069,"أما والذي أهدى الغرام إلى القلب","https://www.poetsgate.com/ViewPoem.aspx?id=105645",""],[6075,"على بوابة الأقصى","https://www.poetsgate.com/ViewPoem.aspx?id=190650",""],[549,"الفارس والصهيل المكسر","https://www.poetsgate.com/ViewPoem.aspx?id=203001",""],[6152,"احفظي قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=203115",""],[1719,"فلن ينسى النبي له صنيعاً","https://diwany.org/%D9%81%D9%84%D9%86-%D9%8A%D9%86%D8%B3%D9%89-%D8%A7%D9%84%D9%86%D8%A8%D9%8A-%D9%84%D9%87-%D8%B5%D9%86%D9%8A%D8%B9%D8%A7%D9%8B/","الوافر"],[6213,"نداء العجوز","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76265&r=&rc=22",""],[6225,"تقويم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80905&r=&rc=174",""],[6280,"لندبكَ أحزانٌ وسابقُ عبة ٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27924&r=&rc=79",""],[557,"أحزان مصر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67203&r=&rc=65",""],[2220,"إذا وصفَ الشرعُ المبينُ إلها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11872&r=&rc=741",""],[5567,"المجد بابها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82078&r=&rc=131",""]],"verses":[["فيا قاصداً تلك المناسك والربى","بمرقالة يحدو بها السير واخد",0,"د",1,0],["فيا قلب لا هانت عليك مواجعٌ","ويا عين لا ضمت كراك المراقد",0,"د",1,0],["فيا قائماً قد دثرته يد القضى","أما لك من نجوى لقبرٍ مزمل",1,"ل",1,0],["فَيا قَلبُ إِن يَفنَ العَزاءُ فَطالَما","عَهِدتُكَ بَعدَ الظاعِنينَ تَصَدَّعُ",2,"ع",1,0],["فَيا قائِليهِ لوْ بَلَغْتُم بهِ المَدى","عَرَفْتُمْ مَنِ المَسْبوق في حَلَباتِهِ",3,"ت",2,0],["فَيا قَلبُ خَبِّرني إِذا شَطَّتِ النَوى","بِلُبنى وَصَدَّت عَنكَ ما أَنتَ صانِعُ",4,"ع",1,0],["فَيا قَلبُ صَبراً وَاِعتِرافاً لِما تَرى","وَيا حُبَّها قَع بِالَّذي أَنتَ واقِعُ",5,"ع",1,1],["فَيَاقَاضِي الْقُضَاةِ فَدَتْكَ نَفْسِي","أَقَرَّ الْخَصْمُ فَارْتَفَعَ الْكَلاَمُ",6,"م",1,0],["فيا قَلْبِ صَبْراً إنّ للدّهْرِ رجْعَةً","لعلّ لعَهْدِ الوصْلِ عوْدَةَ عائِدِ",7,"د",1,0],["فَيا قلْبُ صبْراً في الغَرامِ وحِسْبَةً","لمَنْ تشْتَكي بالدّاءِ والمُمْرِضُ الآسي",8,"س",2,0],["فَيا قَلبُ لا تَجزَع إِذا عَضَّكَ الأَسى","فَإِنّكَ بَعدَ اليَومِ لَن تَتَأَلَّما",9,"م",2,0],["فَيا قَصرَ الدُبارَةِ لَستُ أَدري","أَحَربٌ في جِرابِكَ أَم سَلامُ",10,"م",1,0],["فَيا قَريضُ أَجِبني","وَيا بَيانُ أَعِنّي",11,"ن",2,0],["فَيا قَلبُ خَبِّرني فَلَستَ بِفاعِلٍ","إِذا لَم تَنَل وَاِستَأسَرَت كَيفَ تَصنَعُ",12,"ع",1,0],["فَيا قَلبُ كُن عَنها صَبوراً فَإِنَّها","يُشَيِّعُها بِالصَبرِ قَلبٌ مُشَيَّعُ",13,"ع",1,0],["فيا قومنا أين المساواة عندكم","فقد طال عنها في مواطنكم بحثي",14,"ث",2,0],["فيا قوم أن شئتم بقاءً فنازعوا","سواكم من الأقوام حبل بقاء",15,"ا",2,0],["فيا قومنا أن العلوم تجدّدت","فإن كنتم تهوَوْنا فتجدّدوا",16,"د",3,0],["فَيا قُبحَهُم في الَّذي خُوِّلوا","وَيا حُسنَهُم في زَوالِ النِعَمِ",17,"م",1,0],["فيا قلبُ جهداً في التحرق بعدهم","وهذا لعمري جهدُ منْ لا له جهدُ",18,"د",1,0],["فيا قلب خنساء القويّ وأدمعي","على مثلك العينان تجري على صخر",19,"ر",1,0],["فيا قمراً ينير بلا أفولٍ","ويا شمساً تضيء بلا غروبِ",20,"ب",1,0],["فيا قائل السوءَى لتُطفِئَ نورَه","وذلك نورٌ لا تبوخ مَقابسه",21,"س",2,0],["فَيا قُلوبَ الكاشِحينَ اِسكُني","وَيا عُيونَ الحاسِدينَ اِرقُدي",22,"د",2,0],["فَيا قَلبُ لا تَغتَرِر بِالشَبابِ","وَيا نَفسُ بِالخُلدِ لا تَطمَعي",23,"ع",2,0],["فَيا قائِلاً قَولاً يَسوءُ سَماعُهُ","بِحَقِّكَ نَزِّهنا عَنِ الفُحشِ وَالخَنا",24,"ن",2,0],["فَيا قَبرَ الحَبيبِ وَدِدتُ أَنّي","حَمَلتُ وَلَو عَلى عَيني ثَراكا",25,"ك",2,0],["فَيا قَمَري مُذ غِبتَ أَوحَشتَ ناظِري","لَعَلَّكَ لَيلاً مُؤنِسي بِطُلوعِ",26,"ع",1,0],["فَيا قَلبُ دَع ذِكرى بُثَينَةَ إِنَّها","وَإِن كُنتَ تَهواها تَضَنَّ وَتَبخَلُ",27,"ل",1,0],["فيا قبر سعد إنما أنت حفرة","قد احتضنت عن مصر خير مجاهد",28,"د",1,0],["فَيا قَبرُ كُن رَوضَةً مِن رِضىً","عَلَيهِ وَكُن باقَةً مِن زَهَر",29,"ر",1,0],["فَيا قَومُ أَينَ الجَيشُ فيما زَعَمتُمُ","وَأَينَ الجَواري وَالدِفاعُ المُرَكَّبُ",30,"ب",1,0],["فَيَا قَبْرَهُ جُدْ كُلَّ قَبْرٍ بِجُودِهِ","فَفيكَ سَمَاءٌ ثَرَّةٌ وسَحَائِبُ",31,"ب",1,0],["فيا قلبُ عاودْ ما عهدْتَ من الجَوى","معاذَ الهَوى أنْ تُصبِحَ اليومَ ساليا",32,"ي",2,0],["فيا قَمَراً قد بانَ عَنِّيَ ضَوؤهُ","لياليَّ والأيامُ بعدَك سُودُ",33,"د",1,0],["فَيا قِبلَةَ الجودِ الَّتي لِبَني الرَجا","رُكوعٌ إِلى أَركانِها وَسُجودُ",34,"د",1,0],["في اقترابِ الدّارِ أَشكو بُعدها","واقترابُ الدّارِ بالهَجرِ انتِزاح",35,"ح",1,0],["فَيَا قَلْبُ صَبْرَاً إِنْ جَزِعْتَ فَرُبَّمَا","جَرَتْ سُنُحاً طَيْرُ الْحَوَادِثِ بِالْيُمْنِ",36,"ن",1,0],["فيا قبحَهُمْ في الذي خُوِّلوا","ويا حسنهم عندما يُنزعُ",37,"ع",1,0],["فيا قاضي القضاةِ دعاءَ صبٍّ","برغمي أن يغيّركَ الرغامُ",38,"م",1,0],["فَيا قَلبُ مُت حُزناً وَلا تَكُ جازِعا","فَإِنَّ جَزوعَ القَومِ لَيسَ بِخالِدِ",39,"د",1,1],["فَيا قُربَ ما بَينَ الحَياةِ وَبَينَنا","إِذا ما تَبَدَّلنا مَطاراً بِمَوقِفِ",40,"ف",1,0],["فَيا قَينُ هَل حُدِّثتَ يَومَ اِبنِ مِلقَطٍ","وَيَومَيكَ لِاِبنِ مُضرِطِ الحجرِ الصَلدِ",41,"د",1,0],["فَيا قائِدَ الجَيشِ خَفِّض عَلَيكَ","في غَيرِ حَظِّكَ يَعلو الرَهَج",42,"ج",1,0],["فَيا قَسُّ وَقِّع بِرِزقِ الخَطي","بِ وَاُنظُر بِمَسجِدِنا يا مُنَش",43,"ش",1,0],["فيا قبرُ واهٍ مِنْ تُرابكَ لَيّناً","علَيهِ وآهٍ مِنْ جنادِلِكَ الخُشنِ",44,"ن",1,0],["فيا قلبُ لا تُلْحِقْ بثُكْلِ محَمّدٍ","ليَبقى ثُكْلُهُ بَيّنَ الوَسْمِ",45,"م",1,0],["فَيا قَبرَ النَبِيِّ وَصاحِبَيهِ","أَلاَ يا غَوثَنا لَو تَسمَعُونا",46,"ن",2,0],["فَيا قوم من شر الجهالات فلنخف","فهن لنا هن الذئاب النواهس",47,"س",1,0],["فَيا قَبر أَنتَ اليوم أَكرم بقعة","من الأرض ذاتَ العرض فيها اِنطوى حر",48,"ر",1,0],["فيا قلوب الكاشحين اكني","ويا عيون الحاسدين ارقدي",49,"د",2,0],["فيا قلبُ لا تُلْحِقْ بثُكْلِ محَمّدٍ","سِواهُ ليَبقى ثُكْلُهُ بَيّنَ الوَسْمِ",50,"م",1,0],["فَيَا قَاتَلَ اللهُ الْهَوَى مَا أَشَدَّهُ","عَلَى المَرْءِ إِذْ يَخْلُو بِهِ فَيُغِيرُ",51,"ر",1,0],["فَيَا قَلْبُ صَبْرَاً إِنْ أَلَمَّ بِكَ النَّوَى","فَكُلُّ فِراقٍ أَوْ تَلاقٍ لَهُ حَدُّ",52,"د",1,0],["فَيَا قَلْبُ مَا أَشْجَى إِذَا الدَّارُ بَاعَدَتْ","وَيَا دَمْعُ مَا أَجْرَى وَيَا بَيْنُ مَا أَرْدَى",53,"د",2,0],["فَيَا قَوْمُ هُبُّوا إِنَّمَا الْعُمْرُ فُرْصَةٌ","وَفِي الدَّهْرِ طُرْقٌ جَمَّةٌ وَمَنافِعُ",54,"ع",1,0],["فَيَا قَلْبِي وَشِيمَتُك التَّأَسِّي","نَهَيْتُكَ عَنْ نُهَاكَ فَكُنْ جَزُوعَا",55,"ع",2,0],["فَيا قَتيلاً وَلَم تُصِبهُ","سُمرُ العَوالي وَلا السُيوفُ",56,"ف",1,0],["فيا قلبي صبرا إن للدهر رجعة","لعل زمانا للوصال بعائد",57,"د",1,0],["فيا قلب فيك الرّاحلون وإن نأوا","وفيك النّدامى والرّياحين والخمر",58,"ر",1,0],["فيا قارئي .. يا رفيقَ الطريقِ","سألتُكَ بالله .. كُنْ ناعِماً",59,"ا",1,0],["فيا قارئي .. يا رفيقَ الطريقِ","أنا الشفتانِ .. وأنتَ الصَدَى",59,"ا",1,0],["فيا قائل السُّوءَى لتُطفِيء نورَهُ","وذلك نورٌ لا تبوخُ مَقابسه",60,"س",2,0],["فيا قطب هذا الدين ياغوث ملكه","فديتك ما عن ذا الحمام محيد",61,"د",1,0],["فيا قلب خل الفانيات فانما","هو الدهر لاخل يدوم ولا اخ",62,"خ",1,0],["فيا قرب ما يعدو على الرأي غيره","وسرعان ما تبلى الظنون شجون",63,"ن",1,0],["فيا قاتلي مَهْلا ورِمْقاً بعاشِق","فلا شكَّ داءُ العاشقين دَخِيلُ",64,"ل",1,0],["فَيا قَومَنا لا تَظلِمونا فَإِنَّنا","مَتى ما نَخَف ظُلمَ العَشيرَةِ نَغضَبِ",65,"ب",1,0],["فيا قلبُ ما هذا التذلل في الهوى","وكيفَ بِهونِ الحبِ ترضى وبالكدِ",66,"د",1,0],["فيا قلبي المجروح بالبعد واللقا","دواك عزيز لست تنفكّ ولهانا",67,"ن",2,0],["فَيا قَومِ وَالآمالُ تُحسِنُ ظَنَّها","قِفوا العيسَ في أَعلامِ يَثرِبَ إِنَّها",68,"ه",2,0],["فيا قبرها لا فارقتك غمامة","تبل ثرى ذاك الضريح بمائها",69,"ا",3,0],["فَيا قاصِدَ البَحرَينِ يُزجي شِمِلَّةً","كَأَنَّ عَلى أَشداقِها الهُدلِ كرسُفا",70,"ف",2,0],["في أقْدسِ النَّبْضِ بِنتُ القَلْبِ مَسْكَنُها","لَها ومِنْها وفيها الخَفْقُ قَدْ خَفَقا",71,"ق",2,0],["فيا قلب صبرا ما استطعت ومن يطق","على فقد من يهوى وهجرانه صبرا",72,"ر",2,0],["فَيا قومِ هذا يومُ أحزانِكم أما","لَديكم عقولٌ تفرقُ الخير والشرّا",73,"ر",2,0],["فيا قبحَ الليلُ من قادمٍ","بوجهِ الكذوبِ ومرأى العذولْ",74,"ل",1,0],["فيا قمرَ الأفقِ ماذا الزمان","جيلٌ تخلَّى وجيلٌ غبرْ",75,"ر",1,0],["ف