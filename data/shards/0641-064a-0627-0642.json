لطويل"],[380,"تباعدت عن ألفي فيا حر أشجاني","https://www.aldiwan.net/poem48777.html","الطويل"],[380,"بكيت لتغريد الحمائم في الفجر","https://www.aldiwan.net/poem49260.html","الطويل"],[402,"تنبه حظي بعد طول منام","https://www.aldiwan.net/poem46935.html","الطويل"],[403,"أجابت دموع العين وامتنع الصبر","https://www.aldiwan.net/poem33930.html","الطويل"],[403,"أحقا جرى ما يسبل العبرات","https://www.aldiwan.net/poem34106.html","الطويل"],[405,"قصدتك أركب البيد القفار","https://www.aldiwan.net/poem49934.html","الوافر"],[409,"أجيرة قلبي إن تدانوا وإن شطوا","https://www.aldiwan.net/poem32447.html","الطويل"],[410,"لندبك أحزان وسابق عبرة","https://www.aldiwan.net/poem67460.html","الطويل"],[416,"أعالج قلبا في هواكم معذبا","https://www.aldiwan.net/poem54034.html","الطويل"],[416,"تنفس عن وجد توقد جمره","https://www.aldiwan.net/poem54071.html","الطويل"],[416,"أدار الكأس مترعة شرابا","https://www.aldiwan.net/poem54184.html","الوافر"],[441,"حرائق حزن في فؤادي تجدد","https://www.aldiwan.net/poem14448.html","الطويل"],[452,"خفقت نسمة الصبا في الرياض","https://www.aldiwan.net/poem13822.html","الخفيف"],[452,"لك الطائر الميمون فاسرج به طرفا","https://www.aldiwan.net/poem13844.html","الطويل"],[464,"نعم نفحة الوادي التي تتأرج","https://www.aldiwan.net/poem3143.html","عموديه"],[464,"لأمر أطعت الحكم في جانب الجهل","https://www.aldiwan.net/poem3427.html","عموديه"],[464,"سقى العهد مالي بالجزيرة من عهد","https://www.aldiwan.net/poem3586.html","عموديه"],[477,"هوى بين أحناء الضلوع دفين","https://www.aldiwan.net/poem15260.html","الطويل"],[477,"كفى حزنا أني أبثك ما عندي","https://www.aldiwan.net/poem15281.html","الطويل"],[495,"شماسة قلب ليس يألف طائره","https://www.aldiwan.net/poem9854.html","الطويل"],[513,"أبى لي الوفاء دوام الجفا","https://www.aldiwan.net/poem67694.html","المتقارب"],[529,"فؤادك يا بن ودي من حديد","https://www.aldiwan.net/poem37455.html","الوافر"],[536,"أشاقتك أطلال بوجرة درس","https://www.aldiwan.net/poem23852.html","الطويل"],[551,"إلام أرامي في المنى وأُرادي","https://www.aldiwan.net/poem47847.html","الطويل"],[551,"ألا هل أتاها كيف حزني بعدها","https://www.aldiwan.net/poem47860.html","الطويل"],[551,"لو انك عرجت في منزل","https://www.aldiwan.net/poem48112.html","المتقارب"],[559,"أرى طالبا منا الزيادة لا الحسنى","https://www.aldiwan.net/poem69340.html","الطويل"],[559,"سهرت غراما والخليون نوم","https://www.aldiwan.net/poem69344.html","الطويل"],[575,"أرى كل شيء في البسيطة قد نما","https://www.aldiwan.net/poem3021.html","الطويل"],[586,"فيا قاضي القضاة متى يوفي","https://www.aldiwan.net/poem17410.html","الوافر"]],"verses":[["فَيا قَلبُ إِن يَفنَ العَزاءُ فَطالَما","عَهِدتُكَ بَعدَ الظاعِنينَ تَصَدَّعُ",0,"ع",1,0],["فَيا قائِليهِ لوْ بَلَغْتُم بهِ المَدى","عَرَفْتُمْ مَنِ المَسْبوق في حَلَباتِهِ",1,"ت",2,0],["فَيا قَلبُ خَبِّرني إِذا شَطَّتِ النَوى","بِلُبنى وَصَدَّت عَنكَ ما أَنتَ صانِعُ",2,"ع",1,0],["فَيا قَلبُ صَبراً وَاِعتِرافاً لِما تَرى","وَيا حُبَّها قَع بِالَّذي أَنتَ واقِعُ",3,"ع",1,1],["فَيَاقَاضِي الْقُضَاةِ فَدَتْكَ نَفْسِي","أَقَرَّ الْخَصْمُ فَارْتَفَعَ الْكَلاَمُ",4,"م",1,0],["فيا قَلْبِ صَبْراً إنّ للدّهْرِ رجْعَةً","لعلّ لعَهْدِ الوصْلِ عوْدَةَ عائِدِ",5,"د",1,0],["فَيا قلْبُ صبْراً في الغَرامِ وحِسْبَةً","لمَنْ تشْتَكي بالدّاءِ والمُمْرِضُ الآسي",6,"س",2,0],["فَيا قَلبُ لا تَجزَع إِذا عَضَّكَ الأَسى","فَإِنّكَ بَعدَ اليَومِ لَن تَتَأَلَّما",7,"م",2,0],["فَيا قَصرَ الدُبارَةِ لَستُ أَدري","أَحَربٌ في جِرابِكَ أَم سَلامُ",8,"م",1,0],["فَيا قَريضُ أَجِبني","وَيا بَيانُ أَعِنّي",9,"ي",1,0],["فَيا قَلبُ خَبِّرني فَلَستَ بِفاعِلٍ","إِذا لَم تَنَل وَاِستَأسَرَت كَيفَ تَصنَعُ",10,"ع",1,0],["فَيا قَلبُ كُن عَنها صَبوراً فَإِنَّها","يُشَيِّعُها بِالصَبرِ قَلبٌ مُشَيَّعُ",11,"ع",1,0],["فيا قومنا أين المساواة عندكم","فقد طال عنها في مواطنكم بحثي",12,"ي",1,0],["فيا قوم أن شئتم بقاءً فنازعوا","سواكم من الأقوام حبل بقاء",13,"ا",2,0],["فيا قومنا أن العلوم تجدّدت","فإن كنتم تهوَوْنا فتجدّدوا",14,"د",3,0],["فَيا قُبحَهُم في الَّذي خُوِّلوا","وَيا حُسنَهُم في زَوالِ النِعَمِ",15,"م",1,0],["فيا قلبُ جهداً في التحرق بعدهم","وهذا لعمري جهدُ منْ لا له جهدُ",16,"د",1,0],["فيا قلب خنساء القويّ وأدمعي","على مثلك العينان تجري على صخر",17,"ر",1,0],["فيا قمراً ينير بلا أفولٍ","ويا شمساً تضيء بلا غروبِ",18,"ب",1,0],["فيا قائل السوءَى لتُطفِئَ نورَه","وذلك نورٌ لا تبوخ مَقابسه",19,"س",2,0],["فَيا قُلوبَ الكاشِحينَ اِسكُني","وَيا عُيونَ الحاسِدينَ اِرقُدي",20,"ي",1,0],["فَيا قَلبُ لا تَغتَرِر بِالشَبابِ","وَيا نَفسُ بِالخُلدِ لا تَطمَعي",21,"ي",1,0],["فَيا قائِلاً قَولاً يَسوءُ سَماعُهُ","بِحَقِّكَ نَزِّهنا عَنِ الفُحشِ وَالخَنا",22,"ن",2,0],["فَيا قَبرَ الحَبيبِ وَدِدتُ أَنّي","حَمَلتُ وَلَو عَلى عَيني ثَراكا",23,"ك",2,0],["فَيا قَمَري مُذ غِبتَ أَوحَشتَ ناظِري","لَعَلَّكَ لَيلاً مُؤنِسي بِطُلوعِ",24,"ع",1,0],["فَيا قَلبُ دَع ذِكرى بُثَينَةَ إِنَّها","وَإِن كُنتَ تَهواها تَضَنَّ وَتَبخَلُ",25,"ل",1,0],["فيا قبر سعد إنما أنت حفرة","قد احتضنت عن مصر خير مجاهد",26,"د",1,0],["فَيا قَبرُ كُن رَوضَةً مِن رِضىً","عَلَيهِ وَكُن باقَةً مِن زَهَر",27,"ر",1,0],["فَيا قَومُ أَينَ الجَيشُ فيما زَعَمتُمُ","وَأَينَ الجَواري وَالدِفاعُ المُرَكَّبُ",28,"ب",1,0],["فَيَا قَبْرَهُ جُدْ كُلَّ قَبْرٍ بِجُودِهِ","فَفيكَ سَمَاءٌ ثَرَّةٌ وسَحَائِبُ",29,"ب",1,0],["فيا قلبُ عاودْ ما عهدْتَ من الجَوى","معاذَ الهَوى أنْ تُصبِحَ اليومَ ساليا",30,"ي",2,0],["فيا قَمَراً قد بانَ عَنِّيَ ضَوؤهُ","لياليَّ والأيامُ بعدَك سُودُ",31,"د",1,0],["فَيا قِبلَةَ الجودِ الَّتي لِبَني الرَجا","رُكوعٌ إِلى أَركانِها وَسُجودُ",32,"د",1,0],["في اقترابِ الدّارِ أَشكو بُعدها","واقترابُ الدّارِ بالهَجرِ انتِزاح",33,"ح",1,0],["فَيَا قَلْبُ صَبْرَاً إِنْ جَزِعْتَ فَرُبَّمَا","جَرَتْ سُنُحاً طَيْرُ الْحَوَادِثِ بِالْيُمْنِ",34,"ن",1,0],["فيا قبحَهُمْ في الذي خُوِّلوا","ويا حسنهم عندما يُنزعُ",35,"ع",1,0],["فيا قاضي القضاةِ دعاءَ صبٍّ","برغمي أن يغيّركَ الرغامُ",36,"م",1,0],["فَيا قَلبُ مُت حُزناً وَلا تَكُ جازِعا","فَإِنَّ جَزوعَ القَومِ لَيسَ بِخالِدِ",37,"د",1,1],["فَيا قُربَ ما بَينَ الحَياةِ وَبَينَنا","إِذا ما تَبَدَّلنا مَطاراً بِمَوقِفِ",38,"ف",1,0],["فَيا قَينُ هَل حُدِّثتَ يَومَ اِبنِ مِلقَطٍ","وَيَومَيكَ لِاِبنِ مُضرِطِ الحجرِ الصَلدِ",39,"د",1,0],["فَيا قائِدَ الجَيشِ خَفِّض عَلَيكَ","في غَيرِ حَظِّكَ يَعلو الرَهَج",40,"ج",1,0],["فَيا قَسُّ وَقِّع بِرِزقِ الخَطي","بِ وَاُنظُر بِمَسجِدِنا يا مُنَش",41,"ش",1,0],["فيا قبرُ واهٍ مِنْ تُرابكَ لَيّناً","علَيهِ وآهٍ مِنْ جنادِلِكَ الخُشنِ",42,"ن",1,0],["فيا قلبُ لا تُلْحِقْ بثُكْلِ محَمّدٍ","ليَبقى ثُكْلُهُ بَيّنَ الوَسْمِ",43,"م",1,0],["فَيا قَبرَ النَبِيِّ وَصاحِبَيهِ","أَلاَ يا غَوثَنا لَو تَسمَعُونا",44,"ن",2,0],["فَيا قوم من شر الجهالات فلنخف","فهن لنا هن الذئاب النواهس",45,"س",1,0],["فَيا قَبر أَنتَ اليوم أَكرم بقعة","من الأرض ذاتَ العرض فيها اِنطوى حر",46,"ر",1,0],["فيا قلوب الكاشحين اكني","ويا عيون الحاسدين ارقدي",47,"ي",1,0],["فيا قلبُ لا تُلْحِقْ بثُكْلِ محَمّدٍ","سِواهُ ليَبقى ثُكْلُهُ بَيّنَ الوَسْمِ",48,"م",1,0],["فَيَا قَاتَلَ اللهُ الْهَوَى مَا أَشَدَّهُ","عَلَى المَرْءِ إِذْ يَخْلُو بِهِ فَيُغِيرُ",49,"ر",1,0],["فَيَا قَلْبُ صَبْرَاً إِنْ أَلَمَّ بِكَ النَّوَى","فَكُلُّ فِراقٍ أَوْ تَلاقٍ لَهُ حَدُّ",50,"د",1,0],["فَيَا قَلْبُ مَا أَشْجَى إِذَا الدَّارُ بَاعَدَتْ","وَيَا دَمْعُ مَا أَجْرَى وَيَا بَيْنُ مَا أَرْدَى",51,"د",2,0],["فَيَا قَوْمُ هُبُّوا إِنَّمَا الْعُمْرُ فُرْصَةٌ","وَفِي الدَّهْرِ طُرْقٌ جَمَّةٌ وَمَنافِعُ",52,"ع",1,0],["فَيَا قَلْبِي وَشِيمَتُك التَّأَسِّي","نَهَيْتُكَ عَنْ نُهَاكَ فَكُنْ جَزُوعَا",53,"ع",2,0],["فَيا قَتيلاً وَلَم تُصِبهُ","سُمرُ العَوالي وَلا السُيوفُ",54,"ف",1,0],["فيا قلبي صبرا إن للدهر رجعة","لعل زمانا للوصال بعائد",55,"د",1,0],["فيا قلب فيك الرّاحلون وإن نأوا","وفيك النّدامى والرّياحين والخمر",56,"ر",1,0],["فيا قارئي .. يا رفيقَ الطريقِ","سألتُكَ بالله .. كُنْ ناعِماً",57,"ا",1,0],["فيا قارئي .. يا رفيقَ الطريقِ","أنا الشفتانِ .. وأنتَ الصَدَى",57,"ا",1,0],["فيا قائل السُّوءَى لتُطفِيء نورَهُ","وذلك نورٌ لا تبوخُ مَقابسه",58,"س",2,0],["فيا قلب خل الفانيات فانما","هو الدهر لاخل يدوم ولا اخ",59,"خ",1,0],["فيا قرب ما يعدو على الرأي غيره","وسرعان ما تبلى الظنون شجون",60,"ن",1,0],["فيا قاتلي مَهْلا ورِمْقاً بعاشِق","فلا شكَّ داءُ العاشقين دَخِيلُ",61,"ل",1,0],["فَيا قَومَنا لا تَظلِمونا فَإِنَّنا","مَتى ما نَخَف ظُلمَ العَشيرَةِ نَغضَبِ",62,"ب",1,0],["فيا قلبُ ما هذا التذلل في الهوى","وكيفَ بِهونِ الحبِ ترضى وبالكدِ",63,"د",1,0],["فيا قلبي المجروح بالبعد واللقا","دواك عزيز لست تنفكّ ولهانا",64,"ن",2,0],["فَيا قَومِ وَالآمالُ تُحسِنُ ظَنَّها","قِفوا العيسَ في أَعلامِ يَثرِبَ إِنَّها",65,"ه",2,0],["فيا قبرها لا فارقتك غمامة","تبل ثرى ذاك الضريح بمائها",66,"ا",3,0],["فَيا قاصِدَ البَحرَينِ يُزجي شِمِلَّةً","كَأَنَّ عَلى أَشداقِها الهُدلِ كرسُفا",67,"ف",2,0],["في أقْدسِ النَّبْضِ بِنتُ القَلْبِ مَسْكَنُها","لَها ومِنْها وفيها الخَفْقُ قَدْ خَفَقا",68,"ق",2,0],["فيا قلب صبرا ما استطعت ومن يطق","على فقد من يهوى وهجرانه صبرا",69,"ر",2,0],["فَيا قومِ هذا يومُ أحزانِكم أما","لَديكم عقولٌ تفرقُ الخير والشرّا",70,"ر",2,0],["فيا قبحَ الليلُ من قادمٍ","بوجهِ الكذوبِ ومرأى العذولْ",71,"ل",1,0],["فيا قمرَ الأفقِ ماذا الزمان","جيلٌ تخلَّى وجيلٌ غبرْ",72,"ر",1,0],["فيا قلبُ اعصِ كلَّ هوىً سواها","ويا نفسي سواها لا تطيعي",73,"ع",2,0],["فيا قمراً أزرى على قمر الدجى","برعتَ بحسنٍ ما نطيق له وصفا",74,"ف",2,0],["فيا قاتل الله العواذل انهم","اتوا في الهوى شيئا بلومهم تكرا",75,"ر",2,0],["فيا قمرا اضحى له السعد طالعا","واشرقت الدنيا بطلعته الغرا",75,"ر",2,0],["فيا قمرا لو قابل البدر وجهه","ولاح لولى البدر في الافق واختفى",76,"ف",2,0],["فيا قلبي أفق يوما لعلى","أدافع ما بدهرى من صروف",77,"ف",1,0],["فيا قلب إن رمت الغداة سلامة","من الفتن الصم الصلاب به عذ",78,"ذ",1,0],["فَيا قَبرُ ما بَينَ الصَراةِ وَدَجلَةٍ","إِلى نَهرِ عيسى جادَكَ الغَيثُ مِن قَبرِ",79,"ر",1,0],["فَيا قَلبُ إِن تَجزَع لِماضٍ مِنَ الصِبى","حَميدٍ وَعادٍ مِن هَوى الخُرَّدِ الغيدِ",80,"د",1,0],["فيا قرير العين في دهره","عش ناعماً في جدكِ المُقبلِ",81,"ل",1,0],["فيا قلب واصله بأعظم رحمةٍ","ويا عين فاسقيه بأغزر وابل",82,"ل",1,0],["فَيا قَبْراً حَوى الشَّرَفَ الْمُعَلَّى","وَضُمِّنَ لَحْدَهُ الْمَجْدُ الأَثِيلُ",83,"ل",1,0],["فَيا قَلْبُ كَمْ تَشْفى بِدانٍ وَنازِحٍ","فَشاكٍ إِلى خَصْمٍ وَباكٍ عَلَى رَسْمِ",84,"م",1,0],["فَيا قَمَراً يَمَنِيَّ الْمَغِيبِ","وَإِنْ كانَ مَطْلِعُهُ بِالشآمِ",85,"م",1,0],["في اِقتِحامٍ يَملأُ الأُفقَ قتاماً","وَمَقامٍ يَملأُ السَمعَ 