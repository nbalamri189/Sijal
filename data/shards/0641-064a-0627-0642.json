et/poem16923.html","الطويل"],[380,"أراك غني الفضل تنتهر البوسا","https://www.aldiwan.net/poem59381.html","الطويل"],[383,"تباعدت عن ألفي فيا حر أشجاني","https://www.aldiwan.net/poem48777.html","الطويل"],[383,"بكيت لتغريد الحمائم في الفجر","https://www.aldiwan.net/poem49260.html","الطويل"],[405,"تنبه حظي بعد طول منام","https://www.aldiwan.net/poem46935.html","الطويل"],[406,"أجابت دموع العين وامتنع الصبر","https://www.aldiwan.net/poem33930.html","الطويل"],[406,"أحقا جرى ما يسبل العبرات","https://www.aldiwan.net/poem34106.html","الطويل"],[408,"قصدتك أركب البيد القفار","https://www.aldiwan.net/poem49934.html","الوافر"],[412,"أجيرة قلبي إن تدانوا وإن شطوا","https://www.aldiwan.net/poem32447.html","الطويل"],[413,"لندبك أحزان وسابق عبرة","https://www.aldiwan.net/poem67460.html","الطويل"],[419,"أعالج قلبا في هواكم معذبا","https://www.aldiwan.net/poem54034.html","الطويل"],[419,"تنفس عن وجد توقد جمره","https://www.aldiwan.net/poem54071.html","الطويل"],[419,"أدار الكأس مترعة شرابا","https://www.aldiwan.net/poem54184.html","الوافر"],[444,"حرائق حزن في فؤادي تجدد","https://www.aldiwan.net/poem14448.html","الطويل"],[454,"خفقت نسمة الصبا في الرياض","https://www.aldiwan.net/poem13822.html","الخفيف"],[454,"لك الطائر الميمون فاسرج به طرفا","https://www.aldiwan.net/poem13844.html","الطويل"],[466,"نعم نفحة الوادي التي تتأرج","https://www.aldiwan.net/poem3143.html","عموديه"],[466,"لأمر أطعت الحكم في جانب الجهل","https://www.aldiwan.net/poem3427.html","عموديه"],[466,"سقى العهد مالي بالجزيرة من عهد","https://www.aldiwan.net/poem3586.html","عموديه"],[479,"هوى بين أحناء الضلوع دفين","https://www.aldiwan.net/poem15260.html","الطويل"],[479,"كفى حزنا أني أبثك ما عندي","https://www.aldiwan.net/poem15281.html","الطويل"],[497,"شماسة قلب ليس يألف طائره","https://www.aldiwan.net/poem9854.html","الطويل"],[515,"أبى لي الوفاء دوام الجفا","https://www.aldiwan.net/poem67694.html","المتقارب"],[531,"فؤادك يا بن ودي من حديد","https://www.aldiwan.net/poem37455.html","الوافر"],[538,"أشاقتك أطلال بوجرة درس","https://www.aldiwan.net/poem23852.html","الطويل"],[553,"إلام أرامي في المنى وأُرادي","https://www.aldiwan.net/poem47847.html","الطويل"],[553,"ألا هل أتاها كيف حزني بعدها","https://www.aldiwan.net/poem47860.html","الطويل"],[553,"لو انك عرجت في منزل","https://www.aldiwan.net/poem48112.html","المتقارب"],[561,"أرى طالبا منا الزيادة لا الحسنى","https://www.aldiwan.net/poem69340.html","الطويل"],[561,"سهرت غراما والخليون نوم","https://www.aldiwan.net/poem69344.html","الطويل"],[577,"أرى كل شيء في البسيطة قد نما","https://www.aldiwan.net/poem3021.html","الطويل"],[588,"فيا قاضي القضاة متى يوفي","https://www.aldiwan.net/poem17410.html","الوافر"],[728,"","https://poetry.dctabudhabi.ae/diwan/poem/84970","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/21399","الطويل"]],"verses":[["فيا قاصداً تلك المناسك والربى","بمرقالة يحدو بها السير واخد",0,"د",1,0],["فيا قلب لا هانت عليك مواجعٌ","ويا عين لا ضمت كراك المراقد",0,"د",1,0],["فيا قائماً قد دثرته يد القضى","أما لك من نجوى لقبرٍ مزمل",1,"ل",1,0],["فَيا قَلبُ إِن يَفنَ العَزاءُ فَطالَما","عَهِدتُكَ بَعدَ الظاعِنينَ تَصَدَّعُ",2,"ع",1,0],["فَيا قائِليهِ لوْ بَلَغْتُم بهِ المَدى","عَرَفْتُمْ مَنِ المَسْبوق في حَلَباتِهِ",3,"ت",2,0],["فَيا قَلبُ خَبِّرني إِذا شَطَّتِ النَوى","بِلُبنى وَصَدَّت عَنكَ ما أَنتَ صانِعُ",4,"ع",1,0],["فَيا قَلبُ صَبراً وَاِعتِرافاً لِما تَرى","وَيا حُبَّها قَع بِالَّذي أَنتَ واقِعُ",5,"ع",1,1],["فَيَاقَاضِي الْقُضَاةِ فَدَتْكَ نَفْسِي","أَقَرَّ الْخَصْمُ فَارْتَفَعَ الْكَلاَمُ",6,"م",1,0],["فيا قَلْبِ صَبْراً إنّ للدّهْرِ رجْعَةً","لعلّ لعَهْدِ الوصْلِ عوْدَةَ عائِدِ",7,"د",1,0],["فَيا قلْبُ صبْراً في الغَرامِ وحِسْبَةً","لمَنْ تشْتَكي بالدّاءِ والمُمْرِضُ الآسي",8,"س",2,0],["فَيا قَلبُ لا تَجزَع إِذا عَضَّكَ الأَسى","فَإِنّكَ بَعدَ اليَومِ لَن تَتَأَلَّما",9,"م",2,0],["فَيا قَصرَ الدُبارَةِ لَستُ أَدري","أَحَربٌ في جِرابِكَ أَم سَلامُ",10,"م",1,0],["فَيا قَريضُ أَجِبني","وَيا بَيانُ أَعِنّي",11,"ن",2,0],["فَيا قَلبُ خَبِّرني فَلَستَ بِفاعِلٍ","إِذا لَم تَنَل وَاِستَأسَرَت كَيفَ تَصنَعُ",12,"ع",1,0],["فَيا قَلبُ كُن عَنها صَبوراً فَإِنَّها","يُشَيِّعُها بِالصَبرِ قَلبٌ مُشَيَّعُ",13,"ع",1,0],["فيا قومنا أين المساواة عندكم","فقد طال عنها في مواطنكم بحثي",14,"ث",2,0],["فيا قوم أن شئتم بقاءً فنازعوا","سواكم من الأقوام حبل بقاء",15,"ا",2,0],["فيا قومنا أن العلوم تجدّدت","فإن كنتم تهوَوْنا فتجدّدوا",16,"د",3,0],["فَيا قُبحَهُم في الَّذي خُوِّلوا","وَيا حُسنَهُم في زَوالِ النِعَمِ",17,"م",1,0],["فيا قلبُ جهداً في التحرق بعدهم","وهذا لعمري جهدُ منْ لا له جهدُ",18,"د",1,0],["فيا قلب خنساء القويّ وأدمعي","على مثلك العينان تجري على صخر",19,"ر",1,0],["فيا قمراً ينير بلا أفولٍ","ويا شمساً تضيء بلا غروبِ",20,"ب",1,0],["فيا قائل السوءَى لتُطفِئَ نورَه","وذلك نورٌ لا تبوخ مَقابسه",21,"س",2,0],["فَيا قُلوبَ الكاشِحينَ اِسكُني","وَيا عُيونَ الحاسِدينَ اِرقُدي",22,"د",2,0],["فَيا قَلبُ لا تَغتَرِر بِالشَبابِ","وَيا نَفسُ بِالخُلدِ لا تَطمَعي",23,"ع",2,0],["فَيا قائِلاً قَولاً يَسوءُ سَماعُهُ","بِحَقِّكَ نَزِّهنا عَنِ الفُحشِ وَالخَنا",24,"ن",2,0],["فَيا قَبرَ الحَبيبِ وَدِدتُ أَنّي","حَمَلتُ وَلَو عَلى عَيني ثَراكا",25,"ك",2,0],["فَيا قَمَري مُذ غِبتَ أَوحَشتَ ناظِري","لَعَلَّكَ لَيلاً مُؤنِسي بِطُلوعِ",26,"ع",1,0],["فَيا قَلبُ دَع ذِكرى بُثَينَةَ إِنَّها","وَإِن كُنتَ تَهواها تَضَنَّ وَتَبخَلُ",27,"ل",1,0],["فيا قبر سعد إنما أنت حفرة","قد احتضنت عن مصر خير مجاهد",28,"د",1,0],["فَيا قَبرُ كُن رَوضَةً مِن رِضىً","عَلَيهِ وَكُن باقَةً مِن زَهَر",29,"ر",1,0],["فَيا قَومُ أَينَ الجَيشُ فيما زَعَمتُمُ","وَأَينَ الجَواري وَالدِفاعُ المُرَكَّبُ",30,"ب",1,0],["فَيَا قَبْرَهُ جُدْ كُلَّ قَبْرٍ بِجُودِهِ","فَفيكَ سَمَاءٌ ثَرَّةٌ وسَحَائِبُ",31,"ب",1,0],["فيا قلبُ عاودْ ما عهدْتَ من الجَوى","معاذَ الهَوى أنْ تُصبِحَ اليومَ ساليا",32,"ي",2,0],["فيا قَمَراً قد بانَ عَنِّيَ ضَوؤهُ","لياليَّ والأيامُ بعدَك سُودُ",33,"د",1,0],["فَيا قِبلَةَ الجودِ الَّتي لِبَني الرَجا","رُكوعٌ إِلى أَركانِها وَسُجودُ",34,"د",1,0],["في اقترابِ الدّارِ أَشكو بُعدها","واقترابُ الدّارِ بالهَجرِ انتِزاح",35,"ح",1,0],["فَيَا قَلْبُ صَبْرَاً إِنْ جَزِعْتَ فَرُبَّمَا","جَرَتْ سُنُحاً طَيْرُ الْحَوَادِثِ بِالْيُمْنِ",36,"ن",1,0],["فيا قبحَهُمْ في الذي خُوِّلوا","ويا حسنهم عندما يُنزعُ",37,"ع",1,0],["فيا قاضي القضاةِ دعاءَ صبٍّ","برغمي أن يغيّركَ الرغامُ",38,"م",1,0],["فَيا قَلبُ مُت حُزناً وَلا تَكُ جازِعا","فَإِنَّ جَزوعَ القَومِ لَيسَ بِخالِدِ",39,"د",1,1],["فَيا قُربَ ما بَينَ الحَياةِ وَبَينَنا","إِذا ما تَبَدَّلنا مَطاراً بِمَوقِفِ",40,"ف",1,0],["فَيا قَينُ هَل حُدِّثتَ يَومَ اِبنِ مِلقَطٍ","وَيَومَيكَ لِاِبنِ مُضرِطِ الحجرِ الصَلدِ",41,"د",1,0],["فَيا قائِدَ الجَيشِ خَفِّض عَلَيكَ","في غَيرِ حَظِّكَ يَعلو الرَهَج",42,"ج",1,0],["فَيا قَسُّ وَقِّع بِرِزقِ الخَطي","بِ وَاُنظُر بِمَسجِدِنا يا مُنَش",43,"ش",1,0],["فيا قبرُ واهٍ مِنْ تُرابكَ لَيّناً","علَيهِ وآهٍ مِنْ جنادِلِكَ الخُشنِ",44,"ن",1,0],["فيا قلبُ لا تُلْحِقْ بثُكْلِ محَمّدٍ","ليَبقى ثُكْلُهُ بَيّنَ الوَسْمِ",45,"م",1,0],["فَيا قَبرَ النَبِيِّ وَصاحِبَيهِ","أَلاَ يا غَوثَنا لَو تَسمَعُونا",46,"ن",2,0],["فَيا قوم من شر الجهالات فلنخف","فهن لنا هن الذئاب النواهس",47,"س",1,0],["فَيا قَبر أَنتَ اليوم أَكرم بقعة","من الأرض ذاتَ العرض فيها اِنطوى حر",48,"ر",1,0],["فيا قلوب الكاشحين اكني","ويا عيون الحاسدين ارقدي",49,"د",2,0],["فيا قلبُ لا تُلْحِقْ بثُكْلِ محَمّدٍ","سِواهُ ليَبقى ثُكْلُهُ بَيّنَ الوَسْمِ",50,"م",1,0],["فَيَا قَاتَلَ اللهُ الْهَوَى مَا أَشَدَّهُ","عَلَى المَرْءِ إِذْ يَخْلُو بِهِ فَيُغِيرُ",51,"ر",1,0],["فَيَا قَلْبُ صَبْرَاً إِنْ أَلَمَّ بِكَ النَّوَى","فَكُلُّ فِراقٍ أَوْ تَلاقٍ لَهُ حَدُّ",52,"د",1,0],["فَيَا قَلْبُ مَا أَشْجَى إِذَا الدَّارُ بَاعَدَتْ","وَيَا دَمْعُ مَا أَجْرَى وَيَا بَيْنُ مَا أَرْدَى",53,"د",2,0],["فَيَا قَوْمُ هُبُّوا إِنَّمَا الْعُمْرُ فُرْصَةٌ","وَفِي الدَّهْرِ طُرْقٌ جَمَّةٌ وَمَنافِعُ",54,"ع",1,0],["فَيَا قَلْبِي وَشِيمَتُك التَّأَسِّي","نَهَيْتُكَ عَنْ نُهَاكَ فَكُنْ جَزُوعَا",55,"ع",2,0],["فَيا قَتيلاً وَلَم تُصِبهُ","سُمرُ العَوالي وَلا السُيوفُ",56,"ف",1,0],["فيا قلبي صبرا إن للدهر رجعة","لعل زمانا للوصال بعائد",57,"د",1,0],["فيا قلب فيك الرّاحلون وإن نأوا","وفيك النّدامى والرّياحين والخمر",58,"ر",1,0],["فيا قارئي .. يا رفيقَ الطريقِ","سألتُكَ بالله .. كُنْ ناعِماً",59,"ا",1,0],["فيا قارئي .. يا رفيقَ الطريقِ","أنا الشفتانِ .. وأنتَ الصَدَى",59,"ا",1,0],["فيا قائل السُّوءَى لتُطفِيء نورَهُ","وذلك نورٌ لا تبوخُ مَقابسه",60,"س",2,0],["فيا قلب خل الفانيات فانما","هو الدهر لاخل يدوم ولا اخ",61,"خ",1,0],["فيا قرب ما يعدو على الرأي غيره","وسرعان ما تبلى الظنون شجون",62,"ن",1,0],["فيا قاتلي مَهْلا ورِمْقاً بعاشِق","فلا شكَّ داءُ العاشقين دَخِيلُ",63,"ل",1,0],["فَيا قَومَنا لا تَظلِمونا فَإِنَّنا","مَتى ما نَخَف ظُلمَ العَشيرَةِ نَغضَبِ",64,"ب",1,0],["فيا قلبُ ما هذا التذلل في الهوى","وكيفَ بِهونِ الحبِ ترضى وبالكدِ",65,"د",1,0],["فيا قلبي المجروح بالبعد واللقا","دواك عزيز لست تنفكّ ولهانا",66,"ن",2,0],["فَيا قَومِ وَالآمالُ تُحسِنُ ظَنَّها","قِفوا العيسَ في أَعلامِ يَثرِبَ إِنَّها",67,"ه",2,0],["فيا قبرها لا فارقتك غمامة","تبل ثرى ذاك الضريح بمائها",68,"ا",3,0],["فَيا قاصِدَ البَحرَينِ يُزجي شِمِلَّةً","كَأَنَّ عَلى أَشداقِها الهُدلِ كرسُفا",69,"ف",2,0],["في أقْدسِ النَّبْضِ بِنتُ القَلْبِ مَسْكَنُها","لَها ومِنْها وفيها الخَفْقُ قَدْ خَفَقا",70,"ق",2,0],["فيا قلب صبرا ما استطعت ومن يطق","على فقد من يهوى وهجرانه صبرا",71,"ر",2,0],["فَيا قومِ هذا يومُ أحزانِكم أما","لَديكم عقولٌ تفرقُ الخير والشرّا",72,"ر",2,0],["فيا قبحَ الليلُ من قادمٍ","بوجهِ الكذوبِ ومرأى العذولْ",73,"ل",1,0],["فيا قمرَ الأفقِ ماذا الزمان","جيلٌ تخلَّى وجيلٌ غبرْ",74,"ر",1,0],["فيا قلبُ اعصِ كلَّ هوىً سواها","ويا نفسي سواها لا تطيعي",75,"ع",2,0],["فيا قمراً أزرى على قمر الدجى","برعتَ بحسنٍ ما نطيق له وصفا",76,"ف",2,0],["فيا قاتل الله العواذل انهم","اتوا في الهوى شيئا بلومهم تكرا",77,"ر",2,0],["فيا قمرا اضحى له السعد طالعا","واشرقت الدنيا بطلعته الغرا",77,"ر",2,0],["فيا قمرا لو قابل البدر وجهه","ولاح لولى البدر في الافق واختفى",78,"ف",2,0],["فيا قلبي أفق يوما لعلى","أدافع ما بدهرى من صروف",79,"ف",1,0],["فيا قلب إن رمت الغداة سلامة","من الفتن الصم الصلاب به عذ",80,"ذ",1,0],["فَيا قَبرُ ما بَينَ الصَراةِ وَدَجلَةٍ","إِلى نَهرِ عيسى جادَكَ الغَيثُ مِن قَبرِ",81,"ر",1,0],["فَيا قَلبُ إِن تَجزَع لِماضٍ مِنَ الصِبى","حَميدٍ وَعادٍ مِن هَوى الخُرَّدِ الغيدِ",82,"د",1,0],["فيا قرير ال