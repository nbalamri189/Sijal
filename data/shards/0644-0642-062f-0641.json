wan.net/poem35073.html","الوافر"],[274,"كفى الحر أن يشقى وأن يتألما","https://www.aldiwan.net/poem35217.html","الطويل"],[274,"هو الحب فليشق المحبون بالذكر","https://www.aldiwan.net/poem35635.html","الطويل"],[274,"هو الملك تبنيه الجيوش الخضارم","https://www.aldiwan.net/poem35646.html","الطويل"],[275,"تطاول ليلي بعد ليلى بثهمد","https://www.aldiwan.net/poem52073.html","الطويل"],[275,"أنسمة طيب أم صبا طيبة هبا","https://www.aldiwan.net/poem52104.html","الطويل"],[279,"من الملك المحيا في الرواق","https://www.aldiwan.net/poem25475.html","الوافر"],[302,"تلاقوا بعد ما افترقوا طويلا","https://www.aldiwan.net/poem36818.html","عموديه"],[309,"دليل اصطفاء الله للعبد علمه","https://www.aldiwan.net/poem56414.html","الطويل"],[330,"لقد فاز موسى بالخلافة والهدى","https://www.aldiwan.net/poem44286.html","البسيط"],[333,"ليبك أبا الجدعاء ضيف معيلُ","https://www.aldiwan.net/poem412.html",""],[368,"كان المنى إذ تقضى ما عهدناه","https://www.aldiwan.net/poem60577.html","البسيط"],[368,"ألحظ في جفونك أم صوارم","https://www.aldiwan.net/poem60650.html","الوافر"],[395,"ألا يا ابن العفيف يا","https://www.aldiwan.net/poem54588.html","عموديه"],[406,"أغيرك يرجى لخطب نزل","https://www.aldiwan.net/poem46914.html","المتقارب"],[407,"ولا جبل يبقى وإن طال مكثه","https://www.aldiwan.net/poem33475.html","الطويل"],[407,"فؤادي إلى لقياكم الدهر مشتاق","https://www.aldiwan.net/poem33630.html","الطويل"],[407,"لقد خلطت بالإبتداع عقائد","https://www.aldiwan.net/poem33688.html","الطويل"],[420,"سقى الله هذا القبر من صيب الحيا","https://www.aldiwan.net/poem53817.html","الطويل"],[420,"أما والعين تبكيها طلول","https://www.aldiwan.net/poem53867.html","الوافر"],[420,"محوت بسيف سطوتك الفسادا","https://www.aldiwan.net/poem53896.html","الوافر"],[420,"قدمت فحياك المهيمن بندرا","https://www.aldiwan.net/poem53902.html","الطويل"],[420,"يا قبر محمود لا جازتك غادية","https://www.aldiwan.net/poem53903.html","البسيط"],[420,"لأسماء دار حيث منقطع الرمل","https://www.aldiwan.net/poem53930.html","الطويل"],[420,"عفا الله عن ذاك الحبيب وإن جنى","https://www.aldiwan.net/poem54002.html","الطويل"],[433,"لقد فتكت أسابرنا وأضحت","https://www.aldiwan.net/poem40808.html","الوافر"],[436,"لهن ربوع بالعقيق دواثر","https://www.aldiwan.net/poem12468.html","الطويل"],[445,"لقد فاز قوم باللباب من العلم","https://www.aldiwan.net/poem14385.html","الطويل"],[445,"على تالد الأيام لي طارف الحزن","https://www.aldiwan.net/poem14484.html","الطويل"],[447,"سألنا فقالوا هذه جنة الورد","https://www.aldiwan.net/poem55934.html","عموديه"],[461,"شوارد حظ لا يقر نفورها","https://www.aldiwan.net/poem56200.html","الطويل"],[467,"سري وعقود الأفق منثالة النظم","https://www.aldiwan.net/poem3173.html","عموديه"],[485,"أسحر السحر في جفن الغزال","https://www.aldiwan.net/poem24467.html","عموديه"],[485,"سواطع التولي في أكتاف ذروته","https://www.aldiwan.net/poem24479.html","عموديه"],[503,"رأى حاسدي شأني فخامره عمى","https://www.aldiwan.net/poem37777.html","الطويل"],[517,"أما ومواضي مقلتيها الفواصل","https://www.aldiwan.net/poem20797.html","الطويل"],[517,"أفي طي الصبا نشر التصابي","https://www.aldiwan.net/poem20824.html","الوافر"],[517,"أتنكر بأس أحداق العذارى","https://www.aldiwan.net/poem20826.html","الوافر"],[532,"تهدم من ربع المعارف جانبه","https://www.aldiwan.net/poem37537.html","الطويل"],[554,"قطعت بها يا دهر حبل وتيني","https://www.aldiwan.net/poem47164.html","الطويل"],[554,"حلفت بمعشر عسفوا المطايا","https://www.aldiwan.net/poem47223.html","الطويل"],[554,"خيالك يا أميمة كيف زارا","https://www.aldiwan.net/poem47801.html","الوافر"],[561,"سريت ولا رد هناك ولا منع","https://www.aldiwan.net/poem34387.html","الطويل"],[565,"صبرا بني سكزان الأكرمين على","https://www.aldiwan.net/poem52523.html","البسيط"],[565,"بناء العلى بين القنا والبوارق","https://www.aldiwan.net/poem52969.html","الطويل"],[573,"تعلم أن خير الناس ميت","https://www.aldiwan.net/poem59477.html","البسيط"],[745,"","https://poetry.dctabudhabi.ae/diwan/poem/67362","الطويل"],[879,"","https://poetry.dctabudhabi.ae/diwan/poem/204419","الوافر"]],"verses":[["لَقَد فُضِّلَت لُبنى عَلى الناسِ مِثلَ ما","عَلى أَلفِ شَهرٍ فُضِّلَت لَيلَةُ القَدرِ",0,"ر",1,0],["لَقَدْ فَاءَ ظِلُّ اللهِ مِنْهُ عَلَى الْوَرَى","فَأَيَّمُهُ مَكْفِيَّةٌ وَيَتِيمُهُ",1,"م",2,0],["لَقَدْ فُزْتَ بِالْقِدْحِ الْمُعَلَّى مِنَ الْهُدَى","وَسَلَّمَ فِي الْحَقِّ الصَّرِيحِ لَكَ الْخَصْمُ",2,"م",1,0],["لَقَد فازَ بِالمُلكِ المُعَظَّمِ أُمَّةٌ","إِلى عَدلِهِ المَشهورِ رُدَّت أُمورُها",3,"ر",3,0],["لَقَدَ فَدَحَ الْخَطْبُ فِي قَاسِمِ","فَيَا لَكَ مِنْ زَمَنٍ غاشِمِ",4,"م",1,1],["لقد فخر الإسلام منك ببَيْعَةٍ","وزال بها عنه الأسى والتخوّفُ",5,"ف",1,0],["لقد فاز من بارى جديده جدّةً","وخار الذي في جدّة لم يباره",6,"ر",2,0],["لَقَد فاضَت دُموعُكَ يَومَ قَوٍّ","لَبينٍ كانَ حاجَتُهُ اِدِّكارا",7,"ر",2,0],["لَقَد فَقَدتُ أَبي طِفلاً فَكانَ أَبي","مِنَ الرِجالِ كَريمُ العودِ ناضِرُهُ",8,"ر",2,0],["لقد فجعتْ منكِ الليالي نُفوسها","بمحييةِ الأسحار حافظةِ العتمْ",9,"م",1,0],["لَقَد فَنِيَت ياهاجِرونَ رَسائِلي","وَمَلَّ رَسولٌ بَينَنا وَشَفيعُ",10,"ع",1,0],["لَقَد فَنِيَت روحي عَلَيكَ صَبابَةً","فَما أَنتَ يا روحي العَزيزَةَ صانِعُ",11,"ع",1,0],["لَقَد فاقَ أَيّامَ الزَمانِ بِأَسرِها","وَأَنسى حَديثاً عَن حُنَينٍ وَعَن بَدرِ",12,"ر",1,0],["لَقَد فَرِحَ الواشونَ أَن صَرَمَت حَبلي","بُثَينَةُ أَو أَبدَت لَنا جانِبَ البُخلِ",13,"ل",1,1],["لقد فقدت مصرِّفها حنينا","وبات مكانه منها خليا",14,"ي",2,0],["لَقَد فَتَحتُم فَأَعرَضتُم عَلى شَبَعٍ","وَالفَتحُ يَعتَرِضُ الدَولاتِ بِالتُخَمِ",15,"م",1,0],["لَقَد فَنِيَت أَرزاقُهُم وَرِجالُهُم","وَليسَ بِفانٍ طَيشُهُم وَالتَقَلُّبُ",16,"ب",1,0],["لقد فاتَ قَرْنُ الشمسِ راحةَ لامسٍ","وأعيا مناطُ النَّسْرِ كفّةَ قانصِ",17,"ص",1,0],["لَقَد فَرَجَت سُيوفُ بَني تَميمٍ","عَنِ البَصرِيِّ مُكتَظِمَ الخِناقِ",18,"ق",1,1],["لقد فلَّ شَبا الصَّمصا","مِ من بأسِك صَمصَامَا",19,"م",2,0],["لَقَد فَكَّرتُ حَتّى حارَ فِكري","وَقَد نَقَّبتُ حَتّى عيلَ صَبري",20,"ر",2,0],["لَقَد فَلَلتَ جُموعَ العاشِقينَ بِهِ","في وَقعَةِ الظَبيِ لا في وَقعَةِ الجَمَلِ",21,"ل",1,0],["لقد فاضَ الجلالُ عليه حتى","كأن عليه من نورٍ إزارَا",22,"ر",2,0],["لَقَد فَخَرت مِنهُ العلى بِسَمَيْذَعٍ","لإحسانه وَجْهٌ تَبَرْقَعَ بالبِشرِ",23,"ر",1,0],["لَقَد فُجِعَت عَتّابُهُ وَزُهَيرُهُ","وَتَغلِبُهُ أُخرى اللَيالي وَوائِلُه",24,"ل",2,0],["لَقَدْ فَجَعَتْنَا أُمُّ دَفْرٍ وَمَا دَرَتْ","بِأَرْوَعَ مِنْ نَسْلِ النَّبِيِّ هِجَانِ",25,"ن",1,0],["لَقَدْ فَوَّقَا سَهْمَيْهِمَا وَتَطَاوَلا","إِلَى فَلَكٍ عَالٍ مُحَاطٍ بِأَنْجُمِ",26,"م",1,0],["لقدْ فعلَتْ أقلامُكَ الحمرُ فيهم","منَ الحقِّ ما لا تفعلُ البيضُ والسمرُ",27,"ر",1,0],["لَقَد فُضِّلَت لَيلى عَلى الناسِ مِثلَ ما","عَلى أَلفِ شَهرٍ فُضِّلَت لَيلَةُ القَدرِ",28,"ر",1,0],["لقد فَجعَ المُروءةَ فيكِ دَهرٌ","أصابَكِ في ذَويكِ الأوّلينا",29,"ن",2,0],["لَقَد فَتَقَ المَدَّاحُ مِسكَةَ حَمدِهِ","فَطَارت بِرَيَّاهَأ الريَاحُ النَّواسِمُ",30,"م",1,0],["لَقَد فَضَحَت دُموعُ العَينِ سِرّي","وَأَحرَقَني هَواهُ بِغَيرِ نارِ",31,"ر",1,0],["لقد فازَ منْهُ مشرقُ الأرضِ بالّتي","تَفيضُ لها من مغرِبِ الأرض أدمُع",32,"ع",1,0],["لقد فُزتُ يوم النابضين بنظرةٍ","فلم تَلْقَ إلاّ بَدْرَ تّمٍ وهَودَجا",33,"ج",2,0],["لَقَد فَكَّ أَغلالَ العَناءِ مُحَمَّدٌ","وَأَنزَلَ أَهلَ الخَوفِ في كَنَفِ الأَمنِ",34,"ن",1,0],["لَقَد فَخَروا بِالمُلحَقين عَشِيَّةً","فَقُلتُ اِفخَروا إِن كانَ في اللُؤمِ مَفخَر",35,"ر",1,0],["لَقَد فَدَّيتُهُ أَلفاً","وَلَو كَلَّمَني زِدتُه",36,"ت",2,0],["لَقَد فُزتَ إِن كُنتَ تُعطى الجِنانَ","بِمَكَّةَ إِذ زُرتَها أَو مِنى",37,"ن",2,0],["لَقَد فَرَسَت تِلكَ الأُسودُ طَوائِفاً","أَنيساً وَوَحشاً ثُمَّ أَدرَكَها الفَرسُ",38,"س",1,0],["لَقَد فَرَّعَتنا قُدرَةٌ أَزَليَّةٌ","فَعِشنا وَعُدنا راجِعينَ إِلى القِنسِ",39,"س",1,0],["لَقَد فَعَلوا الخَيرَ القَليلَ تَكَلُّفاً","وَجاؤُوا الَّذي جاؤُوهُ مِن شَرِّهِم طَبعا",40,"ع",2,0],["لَقَد فَنَيتَ وَّهَل تَبقى إِذا عَمَرَت","جَوّالَةٌ بَينَ تَغريبٍ وَاِشراقِ",41,"ق",1,1],["لَقَد فُقِدَ الخَيرُ بَينَ الأَنا","مِ وَالشُرُّ في كُلِّ وَجهٍ يَعِن",42,"ن",1,1],["لقد فُجعَ الإسلامُ منهُ بناصرٍ","كما فُجعَ الأيتامُ منه بوالدِ",43,"د",1,1],["لقد فنيَتْ فيك أرواحهن","وها أنتِ أيتها الخالدهْ",44,"ه",1,0],["لقد فارقَ البشرُ غُرَّ الوجوهِ","وشاعَ الذبولُ بوردِ الشفاهْ",44,"ه",1,0],["لَقَد فضّلَت حُسناً عَلى الناسِ مِثلَما","عَلى أَلفِ شَهرٍ فُضِّلَت لَيلَةُ القَدرِ",45,"ر",1,0],["لَقَد فَخَرَت شَعوبُ بِأَخذِها اِبني","وَقالَت في يَدي أَغلى أَخيذِ",46,"ذ",1,1],["لقد فجع الإسلام منك وأهله","بذخر بعيد الصيت مشتهر الذكر",47,"ر",1,0],["لقد فَقَدَ العُرْبُ حريةٍ","كما الروحُ خلاّه جُثمانه",48,"ن",2,0],["لقد فاتَ بالسبقِ كلَّ الجيادِ","في الشعر هذا الجوادُ الأغرّ",49,"ر",1,0],["لقد فاظ مظلوما بطعنة فاجر","له الويل لا زال الشقي المبهلا",50,"ل",2,0],["لَقَد فَرَّ الرَعيل وَمَن يَقودُ","وَما نَفَع الدلاص وَلا الحَديدُ",51,"د",1,1],["لقد فقدته القوم حينا لطيه","وفي الليلة الظلماء يفتقد البدر",52,"ر",1,0],["لقد فضلتْ بنتاً على أخواتها","كما فضلتَ آيُ الكتاب المنزَّلِ",53,"ل",1,0],["لقد فَاق الأنامَ ندًى وجودا","كما قد فاقهم أصلا وفَرْعَا",54,"ع",2,0],["لَقَد فازَ مَن أَلقى إِلَيكَ عَصِيَّهُ","كَما خابَ مَن لَم يُبقِ لِلعَفوِ مَوضِعا",55,"ع",2,0],["لَقَد فَتَحوا بابَ العُقوقِ جَهالَةً","وَما زالَ بِالإِغضاءِ وَالصَفحِ مُقفَلا",56,"ل",2,0],["لَقَد فاقَ هَذا الفَرعُ في الرُتبَةِ الأَصلا","تَواضَعَتِ الأَقدارُ دونَ مَكانِهِ",57,"ه",1,0],["لَقَد فازَ مَن كانَ الرَسولُ إِمامَهُ","يَقودُ بِهِ نَحوَ النَجاةِزِمامَهُ",58,"ه",1,0],["لَقَدْ فَتَحَ الشَّوْقُ لِي مِنْ هَوَا","كَ بَاباً مِنَ الشَّوْقِ لا يُغْلَقُ",59,"ق",1,0],["لقد فتكت بالتبر كفك فتكة","محت جود من يدلى بنحر البهائم",60,"م",1,0],["لقد فرج الباري بملكك غمةً","عن الخلق تنسى عندها الولد الامُ",61,"م",1,0],["لقد فُزتُم ثواب لا يكافي","وملكٌ لا ترون له ضَريبا",62,"ب",2,0],["لَقَد فُجعَت غُنمٌ وَبَكرٌ وَطُوطِئَت","لِمَهلِكِهِ أَكتادُها وَالقَبائِعُ",63,"ع",1,0],["لَقَد فُجَعَت بِهِ مَصرٌ وَأَلقَت","عَلى بَيروتَ أَشجانَ النَحيبِ",64,"ب",1,0],["لَقَد فقتَ الورى في كلِّ وصفٍ","جَميلٍ واِنفردتَ علاً وعقلا",65,"ل",2,0],["لقد فاتني كلُّ المنى حين فاتني","مشاهدُك الحسنى ومنطقُك العذبُ",66,"ب",1,0],["لقد فتحت فتحا جديدا مباركا","فلا غرو ان ابديت رأيا مسددا",67,"د",2,0],["لقد فرقت اسوان بيني وبينها","تبارك من أحيا التواصل ثانيا",68,"ي",2,0],["لقد فرض الحب الحبيب وسنّه","فمارست دين الحب فيه وفنه",69,"ه",1,1],["لقد فَعَلت أيدي السوافي بنؤيها","وأحجارها ما يفعل الدهر بالحر",70,"ر",1,0],["لقد فاز باللذّات من كان أخرساً","وفي فرق نطق الحقّ حقَّ له الجمع",71,"ع",1,0],["لقد فقدوا الشعورَ فلا تراهم","بليلٍ يشعرونَ ولا نهار",72,"ر",1,0],["لقد فسد المعروفُ والمنُّ واقعٌ","على منَّةٍ كانت من الموتِ أعظَما",73,"م",2,0],["لقد فاحَ من شِعري هواها وذكرُها","كما فاحَ عطرُ الوَردِ من ألطَفِ الصرر",74,"ر",1,0],["لقد فضَلوا القوّادَ من كلِّ أمّةٍ","كما فَضَلت كلَّ السِّباعِ الضّياغم",75,"م",1,0],["لَقَد فرق الهجران شملا تجمعا","وَهيج اشجان النفوس واوجعا",76,"ع",2,0],["لَقَد فضلت كل الحسان بحسنها","كَما فَضل السادات يحيى بِن أَحمَدِ",76,"د",1,0],["لَقَد فضل الاملاك والرسل رفعة","عليهم وَساد الجن وَالعجم وَالعربا",77,"ب",2,0],["لَقَدْ فَدَحَ العَزَاءُ فلَم يُطِقْهُ","رَحِيلٌ ما أرَاهُ بالمُطَاقِ",78,"ق",1,0],["لقد فرغوا من الدنيا فهمّوا","إلى الأفلاك يبغون الوصولا",79,"ل",2,0],["لَقَد فاتَنا في بادئِ الرأي صوبُنا","وَأشفى لَعمري أَن يفوّتَ ختمهُ",80,"م",2,0],["لَقَد فازَ موسى بِالخِلافَةِ وَالهُدى","وَماتَ أَميرُ المُؤمِنينَ مُحَمَّدُ",81,"د",1,1],["لقدْ فَجَعتْ شَيْبَانُ قَومِي بفَارِسٍ","مُحَامٍ على عَوْرَاتِهِمْ لَيْسَ يَنْكُلُ",82,"ل",1,0],["لقد فقَدْناهُ مَعْدوماً مُقارِنُه","وجئْتَنا فكأنّا ما فَقدْناه",83,"ا",2,0],["لقد فَتنَتْ لحاظُكِ كُلَّ قلبٍ","فما في النّاسِ من عَينَيْكِ سالم",84,"م",1,0],["لقد فاز الذي من","عجائبها أشيا أعاجيب",85,"ب",1,0],["لقد فاز الذي من","عجائبها تزود",85,"د",1,0],["لقد فاز من كان في أمرِه","على ربّه وعليكَ اتّكلْ",86,"ل",1,0],["لقد فاز عبد نال خاتمة الرضا","وطاب نوال يعدها ومآل",87,"ل",1,0],["لقد فتكت أيدي النوى بمتيم","فمنهن إرعاد عليه وإبراق",88,"ق",1,0],["لقد فاض بحر الابتداع وأصبحت","قلوب ذوي التقليد منه المصانع",89,"ع",1,0],["لقد فاز بعد الموت بالعفو والرضا","من الله يوفى عفوَه وثوابُه",90,"ب",2,0],["لقد فتكت بي الأحداق حتَّى","جُنِنْتُ وما الهوى إلاَّ جنون",91,"ن",1,0],["لقد فازَ المشيرُ بك اتّكالاً","عَلَيْك بما يُؤَمّل واعتمادا",92,"د",2,0],["لقد فازَ من أصبحْتَ في النَّاس شيخَهم","ومن كنتَ فيه هادياً ومدبّرا",93,"ر",2,0],["لقد فَقَدْتُ بك المعروفَ أجمَعَهُ","يا خيرَ من راحَ مفقوداً لموجود",94,"د",1,0],["لقد فَتَكَتْ بي أعينٌ بابليَّةٌ","فويحك يا قلبي من الأَعين النجل",95,"ل",1,0],["لقد فَتَنَتْني منك عينٌ كحيلةٌ","وما خُلِقت عيناك إلاَّ لتفتنا",96,"ن",2,0],["لقد فتكت أسابرنا وأضحت","من الحجلات تخترق السفينه",97,"ه",1,1],["لقد فقدَتْ عيني المنامَ لفقدِهم","فهل أنا يوماً للأحبّة ناظرُ",98,"ر",1,0],["لقد فاز قومٌ باللباب من العلم","وبالمنهل الصافي المريء من الحلم",99,"م",1,1],["لقد فقدت عيني الضياء لفقده","وقلبي بديهاتي وسمعي من أذني",100,"ن",2,0],["لقد فتحت ازرار ذا الورد فتنة","بسر لفتح الله حوط بالسعد",101,"د",1,0],["لقد فخر النادي أبٌ عَدَلَ ابنَهُ","إذا خاف خجلاتِ الرجالِ فَخورُها",102,"ر",3,0],["لقد فغم الآفاق طبياً ثناؤه","وعم مع الأواء بالنائل الفعم",103,"م",1,0],["لقد فاق البدور بطلع وجد","وفيتم في الهوى صب الدوال",104,"ل",1,0],["لقد فشا ذكره في الناس كلهم","والناس يدعونه للحق يأبهم",105,"م",1,0],["لقد فُلَّ للرَّأيِ السَّقيمِ حِزامُهُ","ونحن بنورِ الشَّرْعِ ساعَدَنا الحزمُ",106,"م",1,0],["لقد فُقْتَ آباءَ الكِرامِ بوالِدٍ","به خُتِمَتْ غُرُّ الكِرامِ الأفاضِلِ",107,"ل",1,0],["لقد فلّقْتَ هاماتِ الرّزايا","وقُدتَ أبيّةَ النّوَبِ الصِعابِ",108,"ب",1,0],["لَقَد فتكَتْ بنا الأجفانُ حتّى","شكَتْ ضعفاً لذلك واِنكِسارا",109,"ر",2,0],["لَقَدْ فَجِعَ الدّينُ الحَنِيفُ بمُفْرَدٍ","تَناهَتْ بِهِ غَاياتُهُ وَمَرَاكِبُهْ",110,"ب",2,0],["لقد فاتَنِي منه الّذي كنتُ أَرْتجي","وَأخلَفتِني فيه الّذي تَعِدِيني",111,"ن",2,0],["لقد فَضَل القبائلَ آلُ موسى","كما فضلتْ على العَطَبِ السَّلامَهْ",112,"م",2,0],["لقد فُقتَ الأُلى سلفوا ملوكاً","كما فاقتْ يمينُهُمُ اليَسارا",113,"ر",2,0],["لقد فاز باللذات من كان أخرسا","وخُصص بالراحات من لا له سمعُ",114,"ع",1,0],["لقد فَقَدتم كريماً كانَ جوهرةً","بالرُّوحِ تُفدَى ولكنْ ذاكَ يمتَنِعُ",115,"ع",1,0],["لقد فُقتَ أهلَ الفضلِ فالقومُ فضلةٌ","ومن لي بوَصفٍ مثلِ فَضْلِكَ فائقِ",116,"ق",1,0],["لقد فجعت به قيس جميعاً","موالي القوم والقومُ الصميمُ",117,"م",1,0],["لَقَدْ فُجِعَ الأنْصَارُ طُرَّا بِسَيِّدِ","أخي ثِقَةٍ في الصَّالحِينَ مُجَرَّبَا",118,"ب",2,0],["لقد فضلتم بالأكل فينا","ولكن ذاك يعقبكم سقاما",119,"م",2,0]]}