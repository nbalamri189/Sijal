,"الطويل"],[271,"هو الحب فليشق المحبون بالذكر","https://www.aldiwan.net/poem35635.html","الطويل"],[271,"هو الملك تبنيه الجيوش الخضارم","https://www.aldiwan.net/poem35646.html","الطويل"],[272,"تطاول ليلي بعد ليلى بثهمد","https://www.aldiwan.net/poem52073.html","الطويل"],[272,"أنسمة طيب أم صبا طيبة هبا","https://www.aldiwan.net/poem52104.html","الطويل"],[276,"من الملك المحيا في الرواق","https://www.aldiwan.net/poem25475.html","الوافر"],[299,"تلاقوا بعد ما افترقوا طويلا","https://www.aldiwan.net/poem36818.html","عموديه"],[306,"دليل اصطفاء الله للعبد علمه","https://www.aldiwan.net/poem56414.html","الطويل"],[327,"لقد فاز موسى بالخلافة والهدى","https://www.aldiwan.net/poem44286.html","البسيط"],[330,"ليبك أبا الجدعاء ضيف معيلُ","https://www.aldiwan.net/poem412.html",""],[365,"كان المنى إذ تقضى ما عهدناه","https://www.aldiwan.net/poem60577.html","البسيط"],[365,"ألحظ في جفونك أم صوارم","https://www.aldiwan.net/poem60650.html","الوافر"],[392,"ألا يا ابن العفيف يا","https://www.aldiwan.net/poem54588.html","عموديه"],[403,"أغيرك يرجى لخطب نزل","https://www.aldiwan.net/poem46914.html","المتقارب"],[404,"ولا جبل يبقى وإن طال مكثه","https://www.aldiwan.net/poem33475.html","الطويل"],[404,"فؤادي إلى لقياكم الدهر مشتاق","https://www.aldiwan.net/poem33630.html","الطويل"],[404,"لقد خلطت بالإبتداع عقائد","https://www.aldiwan.net/poem33688.html","الطويل"],[417,"سقى الله هذا القبر من صيب الحيا","https://www.aldiwan.net/poem53817.html","الطويل"],[417,"أما والعين تبكيها طلول","https://www.aldiwan.net/poem53867.html","الوافر"],[417,"محوت بسيف سطوتك الفسادا","https://www.aldiwan.net/poem53896.html","الوافر"],[417,"قدمت فحياك المهيمن بندرا","https://www.aldiwan.net/poem53902.html","الطويل"],[417,"يا قبر محمود لا جازتك غادية","https://www.aldiwan.net/poem53903.html","البسيط"],[417,"لأسماء دار حيث منقطع الرمل","https://www.aldiwan.net/poem53930.html","الطويل"],[417,"عفا الله عن ذاك الحبيب وإن جنى","https://www.aldiwan.net/poem54002.html","الطويل"],[430,"لقد فتكت أسابرنا وأضحت","https://www.aldiwan.net/poem40808.html","الوافر"],[433,"لهن ربوع بالعقيق دواثر","https://www.aldiwan.net/poem12468.html","الطويل"],[442,"لقد فاز قوم باللباب من العلم","https://www.aldiwan.net/poem14385.html","الطويل"],[442,"على تالد الأيام لي طارف الحزن","https://www.aldiwan.net/poem14484.html","الطويل"],[444,"سألنا فقالوا هذه جنة الورد","https://www.aldiwan.net/poem55934.html","عموديه"],[459,"شوارد حظ لا يقر نفورها","https://www.aldiwan.net/poem56200.html","الطويل"],[465,"سري وعقود الأفق منثالة النظم","https://www.aldiwan.net/poem3173.html","عموديه"],[483,"أسحر السحر في جفن الغزال","https://www.aldiwan.net/poem24467.html","عموديه"],[483,"سواطع التولي في أكتاف ذروته","https://www.aldiwan.net/poem24479.html","عموديه"],[501,"رأى حاسدي شأني فخامره عمى","https://www.aldiwan.net/poem37777.html","الطويل"],[515,"أما ومواضي مقلتيها الفواصل","https://www.aldiwan.net/poem20797.html","الطويل"],[515,"أفي طي الصبا نشر التصابي","https://www.aldiwan.net/poem20824.html","الوافر"],[515,"أتنكر بأس أحداق العذارى","https://www.aldiwan.net/poem20826.html","الوافر"],[530,"تهدم من ربع المعارف جانبه","https://www.aldiwan.net/poem37537.html","الطويل"],[552,"قطعت بها يا دهر حبل وتيني","https://www.aldiwan.net/poem47164.html","الطويل"],[552,"حلفت بمعشر عسفوا المطايا","https://www.aldiwan.net/poem47223.html","الطويل"],[552,"خيالك يا أميمة كيف زارا","https://www.aldiwan.net/poem47801.html","الوافر"],[559,"سريت ولا رد هناك ولا منع","https://www.aldiwan.net/poem34387.html","الطويل"],[563,"صبرا بني سكزان الأكرمين على","https://www.aldiwan.net/poem52523.html","البسيط"],[563,"بناء العلى بين القنا والبوارق","https://www.aldiwan.net/poem52969.html","الطويل"],[571,"تعلم أن خير الناس ميت","https://www.aldiwan.net/poem59477.html","البسيط"]],"verses":[["لَقَد فُضِّلَت لُبنى عَلى الناسِ مِثلَ ما","عَلى أَلفِ شَهرٍ فُضِّلَت لَيلَةُ القَدرِ",0,"ر",1,0],["لَقَدْ فَاءَ ظِلُّ اللهِ مِنْهُ عَلَى الْوَرَى","فَأَيَّمُهُ مَكْفِيَّةٌ وَيَتِيمُهُ",1,"م",2,0],["لَقَدْ فُزْتَ بِالْقِدْحِ الْمُعَلَّى مِنَ الْهُدَى","وَسَلَّمَ فِي الْحَقِّ الصَّرِيحِ لَكَ الْخَصْمُ",2,"م",1,0],["لَقَد فازَ بِالمُلكِ المُعَظَّمِ أُمَّةٌ","إِلى عَدلِهِ المَشهورِ رُدَّت أُمورُها",3,"ر",3,0],["لَقَدَ فَدَحَ الْخَطْبُ فِي قَاسِمِ","فَيَا لَكَ مِنْ زَمَنٍ غاشِمِ",4,"م",1,1],["لقد فخر الإسلام منك ببَيْعَةٍ","وزال بها عنه الأسى والتخوّفُ",5,"ف",1,0],["لقد فاز من بارى جديده جدّةً","وخار الذي في جدّة لم يباره",6,"ر",2,0],["لَقَد فاضَت دُموعُكَ يَومَ قَوٍّ","لَبينٍ كانَ حاجَتُهُ اِدِّكارا",7,"ر",2,0],["لَقَد فَقَدتُ أَبي طِفلاً فَكانَ أَبي","مِنَ الرِجالِ كَريمُ العودِ ناضِرُهُ",8,"ر",2,0],["لقد فجعتْ منكِ الليالي نُفوسها","بمحييةِ الأسحار حافظةِ العتمْ",9,"م",1,0],["لَقَد فَنِيَت ياهاجِرونَ رَسائِلي","وَمَلَّ رَسولٌ بَينَنا وَشَفيعُ",10,"ع",1,0],["لَقَد فَنِيَت روحي عَلَيكَ صَبابَةً","فَما أَنتَ يا روحي العَزيزَةَ صانِعُ",11,"ع",1,0],["لَقَد فاقَ أَيّامَ الزَمانِ بِأَسرِها","وَأَنسى حَديثاً عَن حُنَينٍ وَعَن بَدرِ",12,"ر",1,0],["لَقَد فَرِحَ الواشونَ أَن صَرَمَت حَبلي","بُثَينَةُ أَو أَبدَت لَنا جانِبَ البُخلِ",13,"ل",1,1],["لقد فقدت مصرِّفها حنينا","وبات مكانه منها خليا",14,"ي",2,0],["لَقَد فَتَحتُم فَأَعرَضتُم عَلى شَبَعٍ","وَالفَتحُ يَعتَرِضُ الدَولاتِ بِالتُخَمِ",15,"م",1,0],["لَقَد فَنِيَت أَرزاقُهُم وَرِجالُهُم","وَليسَ بِفانٍ طَيشُهُم وَالتَقَلُّبُ",16,"ب",1,0],["لقد فاتَ قَرْنُ الشمسِ راحةَ لامسٍ","وأعيا مناطُ النَّسْرِ كفّةَ قانصِ",17,"ص",1,0],["لَقَد فَرَجَت سُيوفُ بَني تَميمٍ","عَنِ البَصرِيِّ مُكتَظِمَ الخِناقِ",18,"ق",1,1],["لقد فلَّ شَبا الصَّمصا","مِ من بأسِك صَمصَامَا",19,"م",2,0],["لَقَد فَكَّرتُ حَتّى حارَ فِكري","وَقَد نَقَّبتُ حَتّى عيلَ صَبري",20,"ر",2,0],["لَقَد فَلَلتَ جُموعَ العاشِقينَ بِهِ","في وَقعَةِ الظَبيِ لا في وَقعَةِ الجَمَلِ",21,"ل",1,0],["لقد فاضَ الجلالُ عليه حتى","كأن عليه من نورٍ إزارَا",22,"ر",2,0],["لَقَد فَخَرت مِنهُ العلى بِسَمَيْذَعٍ","لإحسانه وَجْهٌ تَبَرْقَعَ بالبِشرِ",23,"ر",1,0],["لَقَد فُجِعَت عَتّابُهُ وَزُهَيرُهُ","وَتَغلِبُهُ أُخرى اللَيالي وَوائِلُه",24,"ل",2,0],["لَقَدْ فَجَعَتْنَا أُمُّ دَفْرٍ وَمَا دَرَتْ","بِأَرْوَعَ مِنْ نَسْلِ النَّبِيِّ هِجَانِ",25,"ن",1,0],["لَقَدْ فَوَّقَا سَهْمَيْهِمَا وَتَطَاوَلا","إِلَى فَلَكٍ عَالٍ مُحَاطٍ بِأَنْجُمِ",26,"م",1,0],["لقدْ فعلَتْ أقلامُكَ الحمرُ فيهم","منَ الحقِّ ما لا تفعلُ البيضُ والسمرُ",27,"ر",1,0],["لَقَد فُضِّلَت لَيلى عَلى الناسِ مِثلَ ما","عَلى أَلفِ شَهرٍ فُضِّلَت لَيلَةُ القَدرِ",28,"ر",1,0],["لقد فَجعَ المُروءةَ فيكِ دَهرٌ","أصابَكِ في ذَويكِ الأوّلينا",29,"ن",2,0],["لَقَد فَتَقَ المَدَّاحُ مِسكَةَ حَمدِهِ","فَطَارت بِرَيَّاهَأ الريَاحُ النَّواسِمُ",30,"م",1,0],["لَقَد فَضَحَت دُموعُ العَينِ سِرّي","وَأَحرَقَني هَواهُ بِغَيرِ نارِ",31,"ر",1,0],["لقد فازَ منْهُ مشرقُ الأرضِ بالّتي","تَفيضُ لها من مغرِبِ الأرض أدمُع",32,"ع",1,0],["لقد فُزتُ يوم النابضين بنظرةٍ","فلم تَلْقَ إلاّ بَدْرَ تّمٍ وهَودَجا",33,"ج",2,0],["لَقَد فَكَّ أَغلالَ العَناءِ مُحَمَّدٌ","وَأَنزَلَ أَهلَ الخَوفِ في كَنَفِ الأَمنِ",34,"ن",1,0],["لَقَد فَخَروا بِالمُلحَقين عَشِيَّةً","فَقُلتُ اِفخَروا إِن كانَ في اللُؤمِ مَفخَر",35,"ر",1,0],["لَقَد فَدَّيتُهُ أَلفاً","وَلَو كَلَّمَني زِدتُه",36,"ت",2,0],["لَقَد فُزتَ إِن كُنتَ تُعطى الجِنانَ","بِمَكَّةَ إِذ زُرتَها أَو مِنى",37,"ن",2,0],["لَقَد فَرَسَت تِلكَ الأُسودُ طَوائِفاً","أَنيساً وَوَحشاً ثُمَّ أَدرَكَها الفَرسُ",38,"س",1,0],["لَقَد فَرَّعَتنا قُدرَةٌ أَزَليَّةٌ","فَعِشنا وَعُدنا راجِعينَ إِلى القِنسِ",39,"س",1,0],["لَقَد فَعَلوا الخَيرَ القَليلَ تَكَلُّفاً","وَجاؤُوا الَّذي جاؤُوهُ مِن شَرِّهِم طَبعا",40,"ع",2,0],["لَقَد فَنَيتَ وَّهَل تَبقى إِذا عَمَرَت","جَوّالَةٌ بَينَ تَغريبٍ وَاِشراقِ",41,"ق",1,1],["لَقَد فُقِدَ الخَيرُ بَينَ الأَنا","مِ وَالشُرُّ في كُلِّ وَجهٍ يَعِن",42,"ن",1,1],["لقد فُجعَ الإسلامُ منهُ بناصرٍ","كما فُجعَ الأيتامُ منه بوالدِ",43,"د",1,1],["لقد فنيَتْ فيك أرواحهن","وها أنتِ أيتها الخالدهْ",44,"ه",1,0],["لقد فارقَ البشرُ غُرَّ الوجوهِ","وشاعَ الذبولُ بوردِ الشفاهْ",44,"ه",1,0],["لَقَد فضّلَت حُسناً عَلى الناسِ مِثلَما","عَلى أَلفِ شَهرٍ فُضِّلَت لَيلَةُ القَدرِ",45,"ر",1,0],["لَقَد فَخَرَت شَعوبُ بِأَخذِها اِبني","وَقالَت في يَدي أَغلى أَخيذِ",46,"ذ",1,1],["لقد فجع الإسلام منك وأهله","بذخر بعيد الصيت مشتهر الذكر",47,"ر",1,0],["لقد فَقَدَ العُرْبُ حريةٍ","كما الروحُ خلاّه جُثمانه",48,"ن",2,0],["لقد فاتَ بالسبقِ كلَّ الجيادِ","في الشعر هذا الجوادُ الأغرّ",49,"ر",1,0],["لَقَد فَرَّ الرَعيل وَمَن يَقودُ","وَما نَفَع الدلاص وَلا الحَديدُ",50,"د",1,1],["لقد فقدته القوم حينا لطيه","وفي الليلة الظلماء يفتقد البدر",51,"ر",1,0],["لقد فضلتْ بنتاً على أخواتها","كما فضلتَ آيُ الكتاب المنزَّلِ",52,"ل",1,0],["لقد فَاق الأنامَ ندًى وجودا","كما قد فاقهم أصلا وفَرْعَا",53,"ع",2,0],["لَقَد فازَ مَن أَلقى إِلَيكَ عَصِيَّهُ","كَما خابَ مَن لَم يُبقِ لِلعَفوِ مَوضِعا",54,"ع",2,0],["لَقَد فَتَحوا بابَ العُقوقِ جَهالَةً","وَما زالَ بِالإِغضاءِ وَالصَفحِ مُقفَلا",55,"ل",2,0],["لَقَد فاقَ هَذا الفَرعُ في الرُتبَةِ الأَصلا","تَواضَعَتِ الأَقدارُ دونَ مَكانِهِ",56,"ه",1,0],["لَقَد فازَ مَن كانَ الرَسولُ إِمامَهُ","يَقودُ بِهِ نَحوَ النَجاةِزِمامَهُ",57,"ه",1,0],["لَقَدْ فَتَحَ الشَّوْقُ لِي مِنْ هَوَا","كَ بَاباً مِنَ الشَّوْقِ لا يُغْلَقُ",58,"ق",1,0],["لقد فتكت بالتبر كفك فتكة","محت جود من يدلى بنحر البهائم",59,"م",1,0],["لقد فرج الباري بملكك غمةً","عن الخلق تنسى عندها الولد الامُ",60,"م",1,0],["لقد فُزتُم ثواب لا يكافي","وملكٌ لا ترون له ضَريبا",61,"ب",2,0],["لَقَد فُجعَت غُنمٌ وَبَكرٌ وَطُوطِئَت","لِمَهلِكِهِ أَكتادُها وَالقَبائِعُ",62,"ع",1,0],["لَقَد فُجَعَت بِهِ مَصرٌ وَأَلقَت","عَلى بَيروتَ أَشجانَ النَحيبِ",63,"ب",1,0],["لَقَد فقتَ الورى في كلِّ وصفٍ","جَميلٍ واِنفردتَ علاً وعقلا",64,"ل",2,0],["لقد فاتني كلُّ المنى حين فاتني","مشاهدُك الحسنى ومنطقُك العذبُ",65,"ب",1,0],["لقد فتحت فتحا جديدا مباركا","فلا غرو ان ابديت رأيا مسددا",66,"د",2,0],["لقد فرقت اسوان بيني وبينها","تبارك من أحيا التواصل ثانيا",67,"ي",2,0],["لقد فرض الحب الحبيب وسنّه","فمارست دين الحب فيه وفنه",68,"ه",1,1],["لقد فَعَلت أيدي السوافي بنؤيها","وأحجارها ما يفعل الدهر بالحر",69,"ر",1,0],["لقد فاز باللذّات من كان أخرساً","وفي فرق نطق الحقّ حقَّ له الجمع",70,"ع",1,0],["لقد فقدوا الشعورَ فلا تراهم","بليلٍ يشعرونَ ولا نهار",71,"ر",1,0],["لقد فسد المعروفُ والمنُّ واقعٌ","على منَّةٍ كانت من الموتِ أعظَما",72,"م",2,0],["لقد فاحَ من شِعري هواها وذكرُها","كما فاحَ عطرُ الوَردِ من ألطَفِ الصرر",73,"ر",1,0],["لقد فضَلوا القوّادَ من كلِّ أمّةٍ","كما فَضَلت كلَّ السِّباعِ الضّياغم",74,"م",1,0],["لَقَد فرق الهجران شملا تجمعا","وَهيج اشجان النفوس واوجعا",75,"ع",2,0],["لَقَد فضلت كل الحسان بحسنها","كَما فَضل السادات يحيى بِن أَحمَدِ",75,"د",1,0],["لَقَد فضل الاملاك والرسل رفعة","عليهم وَساد الجن وَالعجم وَالعربا",76,"ب",2,0],["لَقَدْ فَدَحَ العَزَاءُ فلَم يُطِقْهُ","رَحِيلٌ ما أرَاهُ بالمُطَاقِ",77,"ق",1,0],["لقد فرغوا من الدنيا فهمّوا","إلى الأفلاك يبغون الوصولا",78,"ل",2,0],["لَقَد فاتَنا في بادئِ الرأي صوبُنا","وَأشفى لَعمري أَن يفوّتَ ختمهُ",79,"م",2,0],["لَقَد فازَ موسى بِالخِلافَةِ وَالهُدى","وَماتَ أَميرُ المُؤمِنينَ مُحَمَّدُ",80,"د",1,1],["لقدْ فَجَعتْ شَيْبَانُ قَومِي بفَارِسٍ","مُحَامٍ على عَوْرَاتِهِمْ لَيْسَ يَنْكُلُ",81,"ل",1,0],["لقد فقَدْناهُ مَعْدوماً مُقارِنُه","وجئْتَنا فكأنّا ما فَقدْناه",82,"ا",2,0],["لقد فَتنَتْ لحاظُكِ كُلَّ قلبٍ","فما في النّاسِ من عَينَيْكِ سالم",83,"م",1,0],["لقد فاز الذي من","عجائبها أشيا أعاجيب",84,"ب",1,0],["لقد فاز الذي من","عجائبها تزود",84,"د",1,0],["لقد فاز من كان في أمرِه","على ربّه وعليكَ اتّكلْ",85,"ل",1,0],["لقد فاز عبد نال خاتمة الرضا","وطاب نوال يعدها ومآل",86,"ل",1,0],["لقد فتكت أيدي النوى بمتيم","فمنهن إرعاد عليه وإبراق",87,"ق",1,0],["لقد فاض بحر الابتداع وأصبحت","قلوب ذوي التقليد منه المصانع",88,"ع",1,0],["لقد فاز بعد الموت بالعفو والرضا","من الله يوفى عفوَه وثوابُه",89,"ب",2,0],["لقد فتكت بي الأحداق حتَّى","جُنِنْتُ وما الهوى إلاَّ جنون",90,"ن",1,0],["لقد فازَ المشيرُ بك اتّكالاً","عَلَيْك بما يُؤَمّل واعتمادا",91,"د",2,0],["لقد فازَ من أصبحْتَ في النَّاس شيخَهم","ومن كنتَ فيه هادياً ومدبّرا",92,"ر",2,0],["لقد فَقَدْتُ بك المعروفَ أجمَعَهُ","يا خيرَ من راحَ مفقوداً لموجود",93,"د",1,0],["لقد فَتَكَتْ بي أعينٌ بابليَّةٌ","فويحك يا قلبي من الأَعين النجل",94,"ل",1,0],["لقد فَتَنَتْني منك عينٌ كحيلةٌ","وما خُلِقت عيناك إلاَّ لتفتنا",95,"ن",2,0],["لقد فتكت أسابرنا وأضحت","من الحجلات تخترق السفينه",96,"ه",1,1],["لقد فقدَتْ عيني المنامَ لفقدِهم","فهل أنا يوماً للأحبّة ناظرُ",97,"ر",1,0],["لقد فاز قومٌ باللباب من العلم","وبالمنهل الصافي المريء من الحلم",98,"م",1,1],["لقد فقدت عيني الضياء لفقده","وقلبي بديهاتي وسمعي من أذني",99,"ن",2,0],["لقد فتحت ازرار ذا الورد فتنة","بسر لفتح الله حوط بالسعد",100,"د",1,0],["لقد فخر النادي أبٌ عَدَلَ ابنَهُ","إذا خاف خجلاتِ الرجالِ فَخورُها",101,"ر",3,0],["لقد فغم الآفاق طبياً ثناؤه","وعم مع الأواء بالنائل الفعم",102,"م",1,0],["لقد فاق البدور بطلع وجد","وفيتم في الهوى صب الدوال",103,"ل",1,0],["لقد فشا ذكره في الناس كلهم","والناس يدعونه للحق يأبهم",104,"م",1,0],["لقد فُلَّ للرَّأيِ السَّقيمِ حِزامُهُ","ونحن بنورِ الشَّرْعِ ساعَدَنا الحزمُ",105,"م",1,0],["لقد فُقْتَ آباءَ الكِرامِ بوالِدٍ","به خُتِمَتْ غُرُّ الكِرامِ الأفاضِلِ",106,"ل",1,0],["لقد فلّقْتَ هاماتِ الرّزايا","وقُدتَ أبيّةَ النّوَبِ الصِعابِ",107,"ب",1,0],["لَقَد فتكَتْ بنا الأجفانُ حتّى","شكَتْ ضعفاً لذلك واِنكِسارا",108,"ر",2,0],["لَقَدْ فَجِعَ الدّينُ الحَنِيفُ بمُفْرَدٍ","تَناهَتْ بِهِ غَاياتُهُ وَمَرَاكِبُهْ",109,"ب",2,0],["لقد فاتَنِي منه الّذي كنتُ أَرْتجي","وَأخلَفتِني فيه الّذي تَعِدِيني",110,"ن",2,0],["لقد فَضَل القبائلَ آلُ موسى","كما فضلتْ على العَطَبِ السَّلامَهْ",111,"م",2,0],["لقد فُقتَ الأُلى سلفوا ملوكاً","كما فاقتْ يمينُهُمُ اليَسارا",112,"ر",2,0],["لقد فاز باللذات من كان أخرسا","وخُصص بالراحات من لا له سمعُ",113,"ع",1,0],["لقد فَقَدتم كريماً كانَ جوهرةً","بالرُّوحِ تُفدَى ولكنْ ذاكَ يمتَنِعُ",114,"ع",1,0],["لقد فُقتَ أهلَ الفضلِ فالقومُ فضلةٌ","ومن لي بوَصفٍ مثلِ فَضْلِكَ فائقِ",115,"ق",1,0],["لقد فجعت به قيس جميعاً","موالي القوم والقومُ الصميمُ",116,"م",1,0]]}