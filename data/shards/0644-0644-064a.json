{"poems":[[35,"عفا رابغ من أهله فالظواهر","https://www.aldiwan.net/poem39152.html","الطويل"],[51,"يا ابن كسرى كسرى الملوك أنوشر","https://www.aldiwan.net/poem66329.html","الخفيف"],[91,"وطن النجوم","https://www.aldiwan.net/poem49843.html","عموديه"],[91,"وطن النجوم أنا هنا","https://www.aldiwan.net/poem62783.html","عموديه"],[92,"ههنا في خمائل الغاب تحت الزا","https://www.aldiwan.net/poem38901.html","المديد"],[89,"لليائسين ارى طريقا","https://www.aldiwan.net/poem44690.html","مجزوء الكامل"],[45,"فؤاد ملاه الحزن حتى تصدعا","https://www.aldiwan.net/poem65135.html","الطويل"],[99,"القصيدة الدمشقية","https://www.aldiwan.net/poem6529.html","عموديه"],[69,"فقيه إذا طال هجرانه","https://www.aldiwan.net/poem28322.html","المتقارب"],[33,"تعشقت ليلى وابتليت بحبها","https://www.aldiwan.net/poem25818.html","الطويل"],[40,"خليلي عوجا نحي نباعا","https://www.aldiwan.net/poem42311.html","المتقارب"],[19,"لليلى بأعلى ذي معارك منزلُ","https://www.aldiwan.net/poem358.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85339","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43733","الخفيف"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/142074","البسيط"],[185,"هناك الفخر يا شهر الصيام","https://www.aldiwan.net/poem14663.html","الوافر"],[275,"لبانة المستهام لبنى","https://www.aldiwan.net/poem25508.html","مخلع البسيط"],[337,"رأيت وقد أتى نجران دوني","https://www.aldiwan.net/poem45430.html","الوافر"],[416,"يا إمام الهدى ويا صفوة الله","https://www.aldiwan.net/poem54171.html","الخفيف"],[464,"ليست قدوداً ولكن هذه أسل","https://www.aldiwan.net/poem3144.html","عموديه"],[551,"تقاسم الليل والإصباح بينهما","https://www.aldiwan.net/poem47703.html","البسيط"]],"verses":[["لِلَيلى وَجاراتٍ لِلَيلى كَأَنَّها","نِعاجُ المَلا تُحدى بِهنَّ الأَباعِرُ",0,"ر",1,0],["للئامِ الرجال لا لي وجوهٌ","عانياتٌ وآنُفٌ مخزومه",1,"م",2,0],["لليلِ فيكَ مُصلّيا،","للصبحِ فيكَ مُؤذِّنا",2,"ن",2,0],["لِلَّيلِ فيكَ مُصَلِّياً","لِلصُبحِ فِكَ مُؤَذِّنا",3,"ن",2,0],["للينابيعِ للعصافيرِ للظِّلِّ","لهذا الثَّرى لتلكَ الغُصونِ",4,"ن",1,0],["لليائسين ارى طري","قا للخلاص من الاذيه",5,"ه",1,1],["لِلَيلاكَ إِذ لَيلى تُعِلُّكَ ريقَها","وَتَسقيكَ مِن فيها الرَحيقَ المُشَعشَعا",6,"ع",2,0],["للياسمين حقوقٌ في منازلنا..","وقطة البيت تغفو حيث ترتاح",7,"ح",1,0],["لليلي وعينيَ في حبِّهِ","كتابُ الطهارةِ بابُ المياهِ",8,"ه",1,0],["لِلَيلى عَلى قَلبي مِنَ الحُبِّ حاجِزٌ","مُقيمٌ وَلَكِنَّ اللِسانُ عَقيمُ",9,"م",1,0],["لِلَيلى فُؤادَكَ في خَلوَةٍ","وَفي مَجلِسٍ أَو سَمِعتَ السَماعا",10,"ع",2,0],["لِلَيلى بِأَعلى ذي مَعارِكَ مَنزِلُ","خَلاءٌ تَنادى أَهلُهُ فَتَحَمَّلوا",11,"ل",3,1],["لليل صبح سوف يسفر بادياً","بعد الظَلام وَللنهار مساء",12,"ا",2,0],["لِلَّيالي عِندي قَناً وَنِبالٌ","خيَّلت أَنَّهُنّ عُربٌ وَتُركُ",13,"ك",1,0],["للياسمينِ حقولٌ في منازلنا","وقطّةُ البيتِ تغفو حيثُ ترتاحُ",14,"ح",1,0],["لَليلةُ قَدْرِك الغراءُ تحكِى","طريقةَ قَدْرِهِ بين الأَنام",15,"م",1,0],["لِلْيُسْرِ واليُمْنِ مِن يَدَيْهِ","يُسْرَى تَسُرُّ العُلَى ويُمْنَى",16,"ن",2,0],["لِلَيلى بِالغُمَيِّمِ ضَوءَ نارٍ","يَلوحُ كَأَنَّهُ الشِعرى العَبورُ",17,"ر",1,0],["لليالي قياماً","واكتحلتم من القيام السهادا",18,"د",2,0],["لليلهِ آيةٌ في صبح وجنتها","من لي بها لو محاها اللَّثم والقبل",19,"ل",1,0],["لِلّيلِ سودِي وللصّبحِ المنيرِ إذا","جَلاهُ شيبي فلُومِي فيه أوْ فَدَعِي",20,"ع",2,0]]}