{"poems":[[35,"عفا رابغ من أهله فالظواهر","https://www.aldiwan.net/poem39152.html","الطويل"],[51,"يا ابن كسرى كسرى الملوك أنوشر","https://www.aldiwan.net/poem66329.html","الخفيف"],[91,"وطن النجوم أنا هنا","https://www.aldiwan.net/poem62783.html","عموديه"],[92,"ههنا في خمائل الغاب تحت الزا","https://www.aldiwan.net/poem38901.html","المديد"],[89,"لليائسين ارى طريقا","https://www.aldiwan.net/poem44690.html","مجزوء الكامل"],[45,"فؤاد ملاه الحزن حتى تصدعا","https://www.aldiwan.net/poem65135.html","الطويل"],[99,"القصيدة الدمشقية","https://www.aldiwan.net/poem6529.html","عموديه"],[69,"فقيه إذا طال هجرانه","https://www.aldiwan.net/poem28322.html","المتقارب"],[33,"تعشقت ليلى وابتليت بحبها","https://www.aldiwan.net/poem25818.html","الطويل"],[40,"خليلي عوجا نحي نباعا","https://www.aldiwan.net/poem42311.html","المتقارب"],[19,"لليلى بأعلى ذي معارك منزلُ","https://www.aldiwan.net/poem358.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85339","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43733","الخفيف"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/142074","البسيط"],[183,"هناك الفخر يا شهر الصيام","https://www.aldiwan.net/poem14663.html","الوافر"],[273,"لبانة المستهام لبنى","https://www.aldiwan.net/poem25508.html","مخلع البسيط"],[335,"رأيت وقد أتى نجران دوني","https://www.aldiwan.net/poem45430.html","الوافر"],[413,"يا إمام الهدى ويا صفوة الله","https://www.aldiwan.net/poem54171.html","الخفيف"],[462,"ليست قدوداً ولكن هذه أسل","https://www.aldiwan.net/poem3144.html","عموديه"],[549,"تقاسم الليل والإصباح بينهما","https://www.aldiwan.net/poem47703.html","البسيط"]],"verses":[["لِلَيلى وَجاراتٍ لِلَيلى كَأَنَّها","نِعاجُ المَلا تُحدى بِهنَّ الأَباعِرُ",0,"ر",1,0],["للئامِ الرجال لا لي وجوهٌ","عانياتٌ وآنُفٌ مخزومه",1,"م",2,0],["لِلَّيلِ فيكَ مُصَلِّياً","لِلصُبحِ فِكَ مُؤَذِّنا",2,"ن",2,0],["للينابيعِ للعصافيرِ للظِّلِّ","لهذا الثَّرى لتلكَ الغُصونِ",3,"ن",1,0],["لليائسين ارى طري","قا للخلاص من الاذيه",4,"ه",1,1],["لِلَيلاكَ إِذ لَيلى تُعِلُّكَ ريقَها","وَتَسقيكَ مِن فيها الرَحيقَ المُشَعشَعا",5,"ع",2,0],["للياسمين حقوقٌ في منازلنا..","وقطة البيت تغفو حيث ترتاح",6,"ح",1,0],["لليلي وعينيَ في حبِّهِ","كتابُ الطهارةِ بابُ المياهِ",7,"ه",1,0],["لِلَيلى عَلى قَلبي مِنَ الحُبِّ حاجِزٌ","مُقيمٌ وَلَكِنَّ اللِسانُ عَقيمُ",8,"م",1,0],["لِلَيلى فُؤادَكَ في خَلوَةٍ","وَفي مَجلِسٍ أَو سَمِعتَ السَماعا",9,"ع",2,0],["لِلَيلى بِأَعلى ذي مَعارِكَ مَنزِلُ","خَلاءٌ تَنادى أَهلُهُ فَتَحَمَّلوا",10,"ل",3,1],["لليل صبح سوف يسفر بادياً","بعد الظَلام وَللنهار مساء",11,"ا",2,0],["لِلَّيالي عِندي قَناً وَنِبالٌ","خيَّلت أَنَّهُنّ عُربٌ وَتُركُ",12,"ك",1,0],["للياسمينِ حقولٌ في منازلنا","وقطّةُ البيتِ تغفو حيثُ ترتاحُ",13,"ح",1,0],["لَليلةُ قَدْرِك الغراءُ تحكِى","طريقةَ قَدْرِهِ بين الأَنام",14,"م",1,0],["لِلْيُسْرِ واليُمْنِ مِن يَدَيْهِ","يُسْرَى تَسُرُّ العُلَى ويُمْنَى",15,"ن",2,0],["لِلَيلى بِالغُمَيِّمِ ضَوءَ نارٍ","يَلوحُ كَأَنَّهُ الشِعرى العَبورُ",16,"ر",1,0],["لليالي قياماً","واكتحلتم من القيام السهادا",17,"د",2,0],["لليلهِ آيةٌ في صبح وجنتها","من لي بها لو محاها اللَّثم والقبل",18,"ل",1,0],["لِلّيلِ سودِي وللصّبحِ المنيرِ إذا","جَلاهُ شيبي فلُومِي فيه أوْ فَدَعِي",19,"ع",2,0]]}