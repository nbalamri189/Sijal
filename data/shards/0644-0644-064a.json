{"poems":[[37,"عفا رابغ من أهله فالظواهر","https://www.aldiwan.net/poem39152.html","الطويل"],[53,"يا ابن كسرى كسرى الملوك أنوشر","https://www.aldiwan.net/poem66329.html","الخفيف"],[93,"وطن النجوم","https://www.aldiwan.net/poem49843.html","عموديه"],[93,"وطن النجوم أنا هنا","https://www.aldiwan.net/poem62783.html","عموديه"],[94,"ههنا في خمائل الغاب تحت الزا","https://www.aldiwan.net/poem38901.html","المديد"],[91,"لليائسين ارى طريقا","https://www.aldiwan.net/poem44690.html","مجزوء الكامل"],[47,"فؤاد ملاه الحزن حتى تصدعا","https://www.aldiwan.net/poem65135.html","الطويل"],[101,"القصيدة الدمشقية","https://www.aldiwan.net/poem6529.html","عموديه"],[71,"فقيه إذا طال هجرانه","https://www.aldiwan.net/poem28322.html","المتقارب"],[35,"تعشقت ليلى وابتليت بحبها","https://www.aldiwan.net/poem25818.html","الطويل"],[42,"خليلي عوجا نحي نباعا","https://www.aldiwan.net/poem42311.html","المتقارب"],[19,"لليلى بأعلى ذي معارك منزلُ","https://www.aldiwan.net/poem358.html",""],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85339","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43733","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/142074","البسيط"],[189,"هناك الفخر يا شهر الصيام","https://www.aldiwan.net/poem14663.html","الوافر"],[280,"لبانة المستهام لبنى","https://www.aldiwan.net/poem25508.html","مخلع البسيط"],[342,"رأيت وقد أتى نجران دوني","https://www.aldiwan.net/poem45430.html","الوافر"],[422,"يا إمام الهدى ويا صفوة الله","https://www.aldiwan.net/poem54171.html","الخفيف"],[469,"ليست قدوداً ولكن هذه أسل","https://www.aldiwan.net/poem3144.html","عموديه"],[556,"تقاسم الليل والإصباح بينهما","https://www.aldiwan.net/poem47703.html","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64048","المنسرح"],[1824,"","https://poetry.dctabudhabi.ae/diwan/poem/95390","الطويل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96025","الكامل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110630","الكامل"],[2683,"","https://poetry.dctabudhabi.ae/diwan/poem/132505","الرجز"],[2888,"","https://poetry.dctabudhabi.ae/diwan/poem/46733","الكامل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65104","الطويل"],[3394,"","https://poetry.dctabudhabi.ae/diwan/poem/123878","الكامل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52984","الكامل"],[4011,"","https://poetry.dctabudhabi.ae/diwan/poem/45531","الطويل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125833","البسيط"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119448","الرجز"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90825","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136550",""],[4391,"","https://poetry.dctabudhabi.ae/diwan/poem/114046","المتقارب"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139287","المجتث"],[4702,"الوقت ياعزام بانت غوايبه","https://www.poetsgate.com/ViewPoem.aspx?id=155114",""],[4782,"مواسم البشرى","https://www.poetsgate.com/ViewPoem.aspx?id=198506",""],[4854,"لَن نُوقِفَ الشََدوَ","https://www.poetsgate.com/ViewPoem.aspx?id=216066",""],[4866,"خواطر ليل","https://www.poetsgate.com/ViewPoem.aspx?id=194768",""],[4869,"الاميره","https://www.poetsgate.com/ViewPoem.aspx?id=151633",""],[4929,"نقل مباشر","https://www.poetsgate.com/ViewPoem.aspx?id=200157",""],[182,"شَيْطانةُ الشّعر","https://www.poetsgate.com/ViewPoem.aspx?id=72793",""],[5032,"كمان اللّيل","https://www.poetsgate.com/ViewPoem.aspx?id=191770",""],[5046,"أرى جناحك","https://www.poetsgate.com/ViewPoem.aspx?id=197903",""],[5151,"مطرٌ وشباكٌ ولوح زجاج","https://www.poetsgate.com/ViewPoem.aspx?id=184920",""],[5277,"نخلةُ (الصوبين)","https://www.poetsgate.com/ViewPoem.aspx?id=185564",""],[5294,"بعت عيالى","https://www.poetsgate.com/ViewPoem.aspx?id=60750",""],[5295,"أمير الروح","https://www.poetsgate.com/ViewPoem.aspx?id=210573",""],[5376,"لليل في سكناته أملُ","https://www.poetsgate.com/ViewPoem.aspx?id=188544",""],[5376,"للقلبِ في أحزانِه أنَّاتُ","https://www.poetsgate.com/ViewPoem.aspx?id=193284",""],[5376,"يا شام أهلوك في أحشائِهم وجعُ","https://www.poetsgate.com/ViewPoem.aspx?id=214063",""],[5409,"طرق الباب حالماً بلقاها","https://www.poetsgate.com/ViewPoem.aspx?id=155363",""],[5455,"الرساله","https://www.poetsgate.com/ViewPoem.aspx?id=34576",""],[5490,"غفلة العمر","https://www.poetsgate.com/ViewPoem.aspx?id=176296",""],[5525,"موت وميلاد","https://www.poetsgate.com/ViewPoem.aspx?id=7256",""],[5525,"العمر احبك","https://www.poetsgate.com/ViewPoem.aspx?id=957",""],[5526,"الياس","https://www.poetsgate.com/ViewPoem.aspx?id=192390",""],[470,"هذي ذُرى مصر","https://www.poetsgate.com/ViewPoem.aspx?id=63614",""],[5608,"من جرحك تعلمت","https://www.poetsgate.com/ViewPoem.aspx?id=33182",""],[5732,"محد يلومك","https://www.poetsgate.com/ViewPoem.aspx?id=177929",""],[5758,"شهقة المعنى","https://www.poetsgate.com/ViewPoem.aspx?id=200502",""],[5773,"لليالي في عكس حالي عظات","https://www.poetsgate.com/ViewPoem.aspx?id=186892",""],[402,"صدقت في عتبكم أو يصدق الشمم","https://www.poetsgate.com/ViewPoem.aspx?id=36829",""],[5794,"صمت المدينة ..","https://www.poetsgate.com/ViewPoem.aspx?id=122799",""],[5850,"رأيتُ وقد أتى نَجْرانُ دوني","https://www.poetsgate.com/ViewPoem.aspx?id=19706",""],[5910,"لِلَّيلِ في أعيُني","https://www.poetsgate.com/ViewPoem.aspx?id=206317",""],[5956,"‏ رثاء حب الطفولة","https://www.poetsgate.com/ViewPoem.aspx?id=182240",""],[5956,"مبدأ يرضي السماء","https://www.poetsgate.com/ViewPoem.aspx?id=183704",""],[5956,"أقصوصة شاعر وحانوت","https://www.poetsgate.com/ViewPoem.aspx?id=193640",""],[5956,"قصائدي عفوية","https://www.poetsgate.com/ViewPoem.aspx?id=201542",""],[6056,"مثل الجبل رآسي","https://www.poetsgate.com/ViewPoem.aspx?id=130339",""],[6128,"معراج القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=213720",""],[6142,"هي المضامير إن توجف مذاكيها","https://www.poetsgate.com/ViewPoem.aspx?id=155708",""]],"verses":[["لِلَيلى وَجاراتٍ لِلَيلى كَأَنَّها","نِعاجُ المَلا تُحدى بِهنَّ الأَباعِرُ",0,"ر",1,0],["للئامِ الرجال لا لي وجوهٌ","عانياتٌ وآنُفٌ مخزومه",1,"م",2,0],["لليلِ فيكَ مُصلّيا،","للصبحِ فيكَ مُؤذِّنا",2,"ن",2,0],["لِلَّيلِ فيكَ مُصَلِّياً","لِلصُبحِ فِكَ مُؤَذِّنا",3,"ن",2,0],["للينابيعِ للعصافيرِ للظِّلِّ","لهذا الثَّرى لتلكَ الغُصونِ",4,"ن",1,0],["لليائسين ارى طري","قا للخلاص من الاذيه",5,"ه",1,1],["لِلَيلاكَ إِذ لَيلى تُعِلُّكَ ريقَها","وَتَسقيكَ مِن فيها الرَحيقَ المُشَعشَعا",6,"ع",2,0],["للياسمين حقوقٌ في منازلنا..","وقطة البيت تغفو حيث ترتاح",7,"ح",1,0],["لليلي وعينيَ في حبِّهِ","كتابُ الطهارةِ بابُ المياهِ",8,"ه",1,0],["لِلَيلى عَلى قَلبي مِنَ الحُبِّ حاجِزٌ","مُقيمٌ وَلَكِنَّ اللِسانُ عَقيمُ",9,"م",1,0],["لِلَيلى فُؤادَكَ في خَلوَةٍ","وَفي مَجلِسٍ أَو سَمِعتَ السَماعا",10,"ع",2,0],["لِلَيلى بِأَعلى ذي مَعارِكَ مَنزِلُ","خَلاءٌ تَنادى أَهلُهُ فَتَحَمَّلوا",11,"ل",3,1],["لليل صبح سوف يسفر بادياً","بعد الظَلام وَللنهار مساء",12,"ا",2,0],["لِلَّيالي عِندي قَناً وَنِبالٌ","خيَّلت أَنَّهُنّ عُربٌ وَتُركُ",13,"ك",1,0],["للياسمينِ حقولٌ في منازلنا","وقطّةُ البيتِ تغفو حيثُ ترتاحُ",14,"ح",1,0],["لَليلةُ قَدْرِك الغراءُ تحكِى","طريقةَ قَدْرِهِ بين الأَنام",15,"م",1,0],["لِلْيُسْرِ واليُمْنِ مِن يَدَيْهِ","يُسْرَى تَسُرُّ العُلَى ويُمْنَى",16,"ن",2,0],["لِلَيلى بِالغُمَيِّمِ ضَوءَ نارٍ","يَلوحُ كَأَنَّهُ الشِعرى العَبورُ",17,"ر",1,0],["لليالي قياماً","واكتحلتم من القيام السهادا",18,"د",2,0],["لليلهِ آيةٌ في صبح وجنتها","من لي بها لو محاها اللَّثم والقبل",19,"ل",1,0],["لِلّيلِ سودِي وللصّبحِ المنيرِ إذا","جَلاهُ شيبي فلُومِي فيه أوْ فَدَعِي",20,"ع",2,0],["للَّيل فجرٌ يَسُرُّ منظرُهُ","وليلُها فجرُهُ سوالفها",21,"ف",3,0],["لليلة أحظا بالكنافة إنها","هي الليلة الغراء عندي من الدهر",22,"ر",1,0],["لليوم من أنواره وقد انكفت","بنهاره الهبوات خير نهار",23,"ر",1,0],["لليل فجر غب غيهبه","وليال رزئك ما لها فجر",24,"ر",1,0],["لليَاسَمين الغضِ عطرٌ زاكي","يحكي ضياء الزهر في الأفلاكِ",25,"ك",1,0],["لِلياسمينِ تَطلُّعٌ في عَرشِهِ","مِثل المَليكِ عراهُ زَهوٌ مُطرِقُ",26,"ق",1,0],["لليلي طولٌ من عذار بخدّه","وطول الدّجى والشمس في القوس أجدرُ",27,"ر",1,0],["لليث صولته على أعدائه","بل دونه إن صال ليث الغاب",28,"ب",1,0],["لليل يَطوِي والنهار","وبه ازدهى الزمنُ الأخير",29,"ر",1,0],["لليلى خيالٌ قَلَّ ما يتَعرَّجُ","يهيّج من أحزاننا ما يهيّجُ",30,"ج",1,1],["لليوم ما بعده إما إلى سعة","من الحياة واما الموتِ والعدمِ",31,"م",1,0],["لليف في تنظيف","جسم المستحمِّ معجزَهْ",32,"ز",2,1],["لليلة لقياها المنيرة ليلة","علمت يقينا أنها ليلة القدر",33,"ر",1,0],["لليلِ عندي يدٌ ما زلتُ أشكرها","يسود وجه نهَاري حين أذكرها",34,"ر",3,1],["للي ذات حسن ايطالية","يجول بخدها ما أسكرا",35,"ر",2,0],["لليأس بردٌ فمن لم","يذقه لم يتهنا",36,"ن",2,0],["للي توجّه بالدعا له ويطلبه","ماردّ نفسٍ تدعُ باخلاص خايبه",37,"ب",2,0],["لليل فيكَ نسائمٌ تسري","للنائمين وكلّ من سهروا",38,"ر",3,0],["لِلَّيلِ هَمٌّ أَصَاخَ السَّمعَ مُستَرِقَا","صَوتَ الوَجِيفِ لِقَلبٍ مُثقَلٍ خَفَقَا",39,"ق",2,1],["للي أسافر فيه قاعد وقايم","ما للسفر آخِر ولو بعض وقفات!",40,"ت",1,0],["للي يبي يعرف .. واسكت عشاني","ادري عن اللحظات لآجت خطيره",41,"ر",2,0],["لِلَّيْلِ يدفعُ مبلغاً من مالِهِ","وضميرُه من دفعِهِ مرتاحُ",42,"ح",1,0],["لليل يهمسها شوقاً يدندنها","ترضى فتطلبه ثوبا بالوان",43,"ن",1,0],["للّيل في هذا المكانِ كَمانُ","وتغَرّبٌ في العزف واستيطانُ",44,"ن",1,1],["للّيلِ في هذا المكانِ حِكايةٌ","أُخرى،و للحدَثِ الغريبِ مكانُ",44,"ن",1,0],["لليل لحنٌ إذا يُوحِي بخفقتِه","يمتدّ نحوَك أنغاماً ذوت عطشا",45,"ش",2,0],["لليتمٍ في عينيه نَظرةُ والدٍ","طافت كتلبيةٍ من الحُجّاجِ",46,"ج",1,0],["لليلى باقصى القلب وجد يقودني","لدار عليها اليوم ادنى رجائيا",47,"ي",2,0],["للى حنكهم جيفة ملهاطى","يبأألع كل ما يقابله ابن الواطى",48,"ا",1,0],["لَليْلٌ كانَ قبلكَ كلّ عمْري","ومن كفيك قد أطلقت فجرهْ",49,"ر",2,0],["لليل في سكناته أملُ","وكأن صمتك كله قُبَلُ",50,"ل",1,1],["لليلِ بدرٌ لا يغيبُ سماؤه","ما حلَّقتْ كبدَ السما النجْماتُ",51,"ت",1,0],["للياسمينة حلمٌ لا يفارقها","قبل الصباح بأيدي الغل تقتطعُ",52,"ع",1,0],["لليلة مدلهمة صادفته","ورياح قد مسهن جنون",53,"ن",1,0],["للي سبتني وانا من قبلها سالي","أبيك توقف معي وتروح تسألها",54,"ل",3,0],["لليل حَدّ كحدّ الموت بيدَ له","غمدٌ من الشمس عند الفجر يندغمُ",55,"م",1,0],["لليل في دمعي سنا .. نجمتين","وللصبح في جفني شفق هم وسهاد",56,"د",1,0],["لليل احبك مابقى في السما نور","والى ضواني الليل .. للصبح أحبك",57,"ك",1,1],["‏للياس فينا يا الامل رفّت اعلام","رفّت ولاهي عن منانا خجوله",58,"ل",2,1],["لِليَومِ مُعْجِزَة ُالأهرامِ زائِرُها","إذا رَنا رَدَّ عَنها الطَّرْفُ مَذهولا",59,"ل",2,0],["للي رخص فيني .. قولي له تغيّرت","السيل ما عاد له .. مغرم وولهان",60,"ن",1,0],["للي تبي لعل دربك سميحي","وما كاد يا شبل الضواري لكم هان",61,"ن",1,0],["لِلَيْلَى قُلُوبُ العَاشِقِينَ تمِيلُ","وَقَلْبِي ( بِهَذَا شَاهِدٌ وَدَلِيلُ )1",62,"ل",1,1],["لليالي في عكس حالي عظات","ليس تخفى على ذوي الألباب",63,"ب",1,1],["لليرز العلم من تلك الصفوف لنا","علام يمكث فيها وهو ملتثم",64,"م",1,0],["لليلةٍ ماتشبه إلا صمت مابين البيوت","غادروها للحضاره بدو في رحله حزينه",65,"ن",2,0],["لليلى بالفحيمِ ضوءَ نارٍ","يلوحُ كأنّهُ الشِّعرى العَبورُ",66,"ر",1,0],["لِلَّيلِ في أعيُني حكمٌ تعهَّدها","وللفراقِ إذا ما بِنْتِ تنفيذُ",67,"ذ",1,0],["لليوم لَمْ أُسْقَ الهوى من نبعه","وحواسيَ الشعثا تضم براعمي",68,"م",2,0],["لليوم ما زلت المريضَ من الأذى","وغدوتُ من كل الرفاهة مُعْدَما",69,"م",2,0],["لليوم ما زالتْ قعيدةَ تَخْتِها","والزوجُ في (خُبَرٍ) يئِنُّ مُحَطّما",69,"م",2,0],["لليوم هذا ما استطعتُ تخلصاً","من ذكريات كلهنّ نوائبُ",70,"ب",1,0],["لليوم هذا في الفؤاد رواسبٌ","تفري عُراهُ وما تزول رواسبُ",70,"ب",1,0],["لليوم هذا لم أزل متألماً","ما رُدّ حقّي بل أظل أطالبُ",70,"ب",1,0],["لليومِ لم أشهدْ مجاهلَ داخلي","لم أمضِ في غاباته أتروَّحُ",71,"ح",1,0],["للي بصدره ، مثل ، طلع التفافيح","إلى إنهصر قده كما هزعة الآس",72,"س",1,0],["لليل ما اقترفَ النهار من الألم","وله العيون العاشقات إذ احتدَمْ",73,"م",1,1],["لليوم حظ ببيض من محاسنها","لليل حظ بسود من مساويها",74,"ي",3,0]]}