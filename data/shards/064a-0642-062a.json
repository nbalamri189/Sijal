tps://www.poetsgate.com/ViewPoem.aspx?id=11265",""],[5943,"أعمار شتى","https://www.poetsgate.com/ViewPoem.aspx?id=34568",""],[5943,"تشطير لقصيدة ( صوت الشغاف )","https://www.poetsgate.com/ViewPoem.aspx?id=92987",""],[5956,"يُقتل الهمُّ بمثلِكْ","https://www.poetsgate.com/ViewPoem.aspx?id=182024",""],[5956,"شبيه وجهك","https://www.poetsgate.com/ViewPoem.aspx?id=182221",""],[5956,"ديمقراطية أمريكا وحلفائها","https://www.poetsgate.com/ViewPoem.aspx?id=192213",""],[5956,"لولا السباحةُ في البحار وفي الغناء","https://www.poetsgate.com/ViewPoem.aspx?id=193935",""],[6031,"لَعِبتْ بعطفيهِ الشمولُ فَمَادَا","https://www.poetsgate.com/ViewPoem.aspx?id=46254",""],[6068,"يَقْتَاتُ قَلْبِي -06-","https://www.poetsgate.com/ViewPoem.aspx?id=175874",""],[6093,"مُشَرَّدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=198050",""],[6093,"الحب في الرعشات والألحاظ","https://www.poetsgate.com/ViewPoem.aspx?id=203141",""],[6124,"أنباء","https://www.poetsgate.com/ViewPoem.aspx?id=159462",""],[242,"كل يوم لك عيد الودود","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563737",""],[6259,"عصرت معدا معك الأناة ُ المعصرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59379&r=&rc=27",""],[6344,"مُرافعةُ مِصباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87962&r=&rc=2",""],[572,"شَمْسُ الضّحَى في الغَمَامِ مُسْتَتِرَهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9290&r=&rc=147",""],[572,"عَجَبِي مِمَّن تَعَالَتْ حَالُهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9170&r=&rc=27",""]],"verses":[["يَقتادُ مَخشِيَّ الرِجالِ مُرادَهُ","عَفواً وَيُظلَمُ كُلُّ مَن لا يَظلِمُ",0,"م",1,0],["يَقتادُ مُثقَلَةَ الغَمامِ كَأَنَّما","يَنهَضنَ بِالعَقَداتِ وَالأَنقاءِ",1,"ا",2,0],["يَقتَطِفُ الزَهرَ وَيَختارُهُ","كَالنَحلِ لا يَعفو عَنِ الأَينَعِ",2,"ع",1,0],["يُقَتِّلُنا بِلا قَوَدٍ","وَلا دِيَةٍ وَلا رَهَبِ",3,"ب",1,0],["يَقُتنَ جِيادَنا وَيَقُلنَ لَستُم","بُعولَتَنا إِذا لَم تَمنَعونا",4,"ن",2,0],["يقتادها من كل مشتمل الدجى","وكأنما عيناه جذوة نارِ",5,"ر",1,0],["يُقتّر ع