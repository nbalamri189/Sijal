ViewPoem.aspx?id=142759",""],[4978,"تشطير من الكفيل","https://www.poetsgate.com/ViewPoem.aspx?id=178201",""],[4984,"بشرى العيد","https://www.poetsgate.com/ViewPoem.aspx?id=189552",""],[5136,"بمن يستغيث العبد إلا بمولاه","https://www.poetsgate.com/ViewPoem.aspx?id=121766",""],[5183,"أقصوصة الروض","https://www.poetsgate.com/ViewPoem.aspx?id=180289",""],[5237,"هو السعد كم من وضيع رفع","https://www.poetsgate.com/ViewPoem.aspx?id=113113",""],[5385,"عهدنا بغرب مطلع البدر مشرقا","https://www.poetsgate.com/ViewPoem.aspx?id=144220",""],[5431,"فبشرى لك صنعاء بشراكِ في غدٍ...","https://www.poetsgate.com/ViewPoem.aspx?id=197406",""],[5442,"تبدت وقد مدت عليها ستورها","https://www.poetsgate.com/ViewPoem.aspx?id=114743",""],[5442,"بلغت مرادي ونلت المني","https://www.poetsgate.com/ViewPoem.aspx?id=114741",""],[5628,"رثاء العملاق","https://www.poetsgate.com/ViewPoem.aspx?id=178489",""],[5653,"فَبَشِّرْ سَمَاءَ السَّنَا والسَّنَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=26398",""],[5691,"روح المدائن","https://www.poetsgate.com/ViewPoem.aspx?id=206312",""],[402,"عهدتك لا تهوى ثناء لقائل","https://www.poetsgate.com/ViewPoem.aspx?id=36162",""],[5840,"فيك برحت بالعذول إباء","https://www.poetsgate.com/ViewPoem.aspx?id=181437",""],[6024,"الجاهل","https://www.poetsgate.com/ViewPoem.aspx?id=186349",""],[6127,"عذبٌ لَمَاك","https://www.poetsgate.com/ViewPoem.aspx?id=188486",""],[5309,"أنا من سكر هواهم ثمل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573771",""],[6202,"الشعر والسيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86705&r=&rc=6",""],[6247,"بطاقة عيد إلى أمتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80270&r=&rc=9",""]],"verses":[["فَبَشِّرْ أَهَالِي هَذِي الضَّوَاحِي","بِيَقْظَةٍ أَعْيَانِهَا المُصْلِحِينْ",0,"ن",1,0],["فبشرى للبلاد إذن وبشرى","لمصر والعراق بما هوينا",1,"ن",2,0],["فبشِّروها بمليك رضاً","وبشِّروه بغلام حليم",2,"م",1,0],["فبشرى لهم والعالمين عواقباً","لأهل الهنا تبقي وأهل الشقا تفني",3,"ن",2,0],["فَبَشَّرتُ نَفسي بِالسُرورِ وَلَم أَزَل","أُهَنّي بِكَ القَلبَ الَّذي أَنتَ قوتُهُ",4,"ت",2,0],["فَبَشَّرتُ آمَالِي بِحَضرةِ أوحَدٍ","تُبَاعُ المُنَى فِيهَا وتُحمَى المحارِمُ",5,"م",1,0],["فَبَشَّرَ صَدري بِقَلبي المُضاعِ","وَهَنَّأ بِالنَومِ عَيني القَريحَه",6,"ح",2,0],["فبشر به البيتَ المحرَّمَ عاجِلاً","إذا أوجفَ التطوافُ بالناس والنَّفر",7,"ر",1,0],["فبَشيري لو جاء منكَ بعَطْفٍ","وَوُجُودي في قَبْضَتِي قلتُ هاكا",8,"ك",2,0],["فَبَشِّر بِسَعْدٍ أُمةً كَثُرَتْ بِهَا","مَنَازِلُ أَبْرَارٍ كَهَذِي المَنَازِلِ",9,"ل",1,0],["فَبُشرى نِقسُها رَطبٌ وَأُخرى","تُخَطُّ وَأُختُها في الحالِ تُملا",10,"ل",2,0],["فبشرى للمراتب والمعالي","بأشرف من بهم رتبا يهنا",11,"ن",2,0],["فبشراك يا ارضا علاك بنعله","اذا ما اقام اليوم عندك او غدا",12,"د",2,0],["فَبِشرٌ مَرجِعُ الفُرسانِ فينا","وَحامينا إِذا الجَوُّ أَكفَهَرّا",13,"ر",2,0],["فبشّرني خير الأنام بميتتي","على سنة بيضاء بالحق تشرع",14,"ع",1,0],["فبشراه نجم السعد قد ذرّ شارقاً","ولا غرو إن غارت به أنجم النحس",15,"س",1,0],["فبشرى لمن أمسى لها متعرّضاً","بتجريد توحيد الصبابة يشطح",16,"ح",1,0],["فبشّري بكتابِ الله ناشرةً","لسانَهُ واهدمي للرومِ أنقابا",17,"ب",2,0],["فبشّت لهُ الدنيا وهشّت كطفلةٍ","رأت أُمّها تحنو وتكشفُ عن نهد",18,"د",1,0],["فَبُشْرَى لِمَنْ لَمْ يَتَّخِذْ غَيْرَ حُبِّهِم","عَتاداً وزَاداً لِلمَمَاتِ وَلِلحَيَا",19,"ي",2,0],["فبُشرَى ثُم بُشرَى ثُمَّ بُشرَى","مُكرّرَةً عَلى كَرِّ العُصورِ",20,"ر",1,0],["فبشرى لهم كم خولوا من كرامةٍ","فكانت لما قد قدموه نتائجا",21,"ج",2,0],["فبشَّرتْ وَأنذرتْ","بنثرِها والخطب",22,"ب",1,0],["فَبَشِّرني بِالبِشرِ قَلبي وَعِندَما","دَعَتني بِعَبدٍ صِرتُ مَولىص لِرِفقَتي",23,"ي",1,0],["فَبُشرايَ قَد صَحَّت الكيميا","ءُ بِأَنّي إِلى بابِهِ واصِلُ",24,"ل",1,0],["فبَشِّرْهُ أنَّ اللهَ أولاهُ فِتنَةً","تُغَشِّيهِ حِرماناً وتُوسِعُهُ حُزْنا",25,"ن",2,0],["فبشر بنبلك طيب الحياةِ","لينا وبأس يريك المعادا",26,"د",2,0],["فَبَشَّرَ عنها بِبَذْلِ الغِنى","وأَعذر فِيهَا ببذل الغناءِ",27,"ا",2,0],["فبُشْرَاكِ يَا دُنيا سَمِيُّ الَّذِي بِهِ","عَلا صوتُ جِبْرِيلٍ بَشيراً ومِيكالِ",28,"ل",1,0],["فبشرى لدين أنت بدرُ سمائه","لقد فقت بدر الأفق ضوءَ جبين",29,"ن",1,0],["فبشرى لدينٍ قيّمٍ أنت تاجهُ","بتاج فخار درُّ أوصافهِ رصف",30,"ف",1,0],["فبشره قبل الموت بالخزي وصمة","تذيقه من كأس المعرة علقما",31,"م",2,0],["فبشرى وبشرى بالأمان وبالرضا","لكلِّ محبٍ خالص السير أحمدي",32,"د",2,0],["فَبَشِّر أَهلَ مِصر فَقَد أَتاهُم","مَع النيل الَّذي في مِصر نيل",33,"ل",1,0],["فَبَشَّرَهُم وَأَنذَرَهُم","وَأَكثَرَ فيهِمُ الجَدَلا",34,"ل",2,0],["فبشّرْ بوالي العهدِ قومَك عاجلاً","فَلا طَرْفَ إلّا نَحو ذلك سامِ",35,"م",1,0],["فبشرى بما بُلّغته من إرادةٍ","وشكراً لما أُوتيتَهُ من نَجائكا",36,"ك",2,0],["فبشراكَ يا مولَى الأَنامِ بقادمٍ","إِلى قمةِ العلياءِ تُطْوَى مراحِلُه",37,"ل",2,0],["فبشرى آل زاخر فالأماني","قد ابتسمت لكم مع آل خوري",38,"ر",2,0],["فبشرى للسقيم إذا نحاه","شفاه اذن رحمان رحيم",39,"م",1,0],["فبشخصك المبرور زار منيحنا","بيتاً لهم بيمينه يتقدس",40,"س",1,0],["فبُشراكمُ أيّها الشاربون","بماءٍ يُزيل الضنا والسَقَم",41,"م",1,0],["فبشمس حسنك كل يوم مشرق","وببدر وجهك كل ليل مقمر",42,"ر",1,0],["فبشراكم بإنعامٍ عظيمٍ","حكت بشراهُ أزهارَ الجنانِ",43,"ن",1,0],["فَبُشرى لِمَولود بِأَكرَم والد","حَليم كَميٍّ عارف وَعَميد",44,"د",1,0],["فَبُشراه مخدوماً وَبُشراك خادِماً","يَجلُّ عَن الإِحصاء بَعض مَناقبه",45,"ب",2,0],["فَبُشرى لَنا بِالهاشميّ رفاعة","أَبي العَزم مَن يَحيا بِهِ النَظم وَالنَثر",46,"ر",1,0],["فَبُشراه مَولوداً وَبُشراك والِداً","لَكَ الفَضل يُقضى بِالعلا وَالتَفَرُّد",47,"د",1,0],["فَبشرى لَها لَما سَمَت بِوجوده","وَعزت بِهِ مُذ صار خَير مُشير",48,"ر",1,0],["فَبَشِّرْ سماءَ السَّنَا والسَّناءِ","بنجم هُدىً لاَحَ في آلِ هُوْدِ",49,"د",1,1],["فَبُشْراكَ كلَّ البشرِ فيما حَويتَهُ","فَها أَنتَ مَحمودٌ كَما أَنتَ حامدُ",50,"د",1,0],["فَبَشِّرِ شيعَةَ المُختارِ إِمّا","مَرَرتَ عَلى الكُوَيفَةِ بِالصَغارِ",51,"ر",1,0],["فبشهبك الغراء طاب تغزلى","ولسان حالى مفصحا حياك",52,"ك",1,0],["فَبَشَّرتُ نَفسِي أَنَّ حُكماً أَثارَها","لِسَعدٍ وَمِن آثارِهِ بُرءُ عِلَّتِي",53,"ت",2,0],["فبشاشة في نجده وسماحة","في عفة وشراسة في لينِ",54,"ن",1,0],["فَبَشَّت به إِذ كان حياً وسَبقُها","دُجًى قد أَظلَّتها ولما تُجَلَّلِ",55,"ل",1,0],["فبشراك من مولاك بالخلف الذي","يسرك نسلا فيه يبقى لك الذكر",56,"ر",1,0],["فبشرني بخير واعف عني","وخذ بيدي كفى بك لي وكيلا",57,"ل",2,0],["فبشراهم وطوبى ثم طوبى","لهم بدوام ملك مستمر",58,"ر",1,0],["فبشروا عبادنا بالفضل","ووسعه وحذروا من عدل",59,"ل",1,0],["فبشرهم على الايمان خيرا","وحذر جمعهم دهم انتقام",60,"م",1,0],["فبشر باحسان عظيم ملاذنا","وظفر بما فوق المراد لكي أرا",61,"ر",2,0],["فَبَشَّرَها رَبّي بِميلاد قاسِمٍ","فَأَرسَلَ جِبريلاً إِلَيها فَحَلَّها",62,"ه",2,0],["فبشرى سرير الملك أم مليكه","تنزل منه منزل الروح في النفس",63,"س",1,0],["فبشعب ذاك الحي مثل غزاله","وفي غنجه وهلاله في تمه",64,"م",2,0],["فبُشراكَ يا لبنانُ بُشراك إذا غدا","بعَود أمير الشرقِ يرتقبُ الغد",65,"د",1,0],["فبشر جلقاً بأغر منها","وأطيب من حدائقها نسيما",66,"م",2,0],["فبشراي ان زرت ذاك الفنا","وأدركت ونلت المراد",67,"د",1,0],["فبشراه ممدوحا وبشراى مادحا","بأبهى نثار في بديع نظام",68,"م",1,0],["فَبَشَّرتهَا عَلى شَوقٍ بِأنَّ عَلى","ظَهرِ الدَّوَارةِ خَلقاً لِلرَّدَى قَربُوا",69,"ب",3,0],["فَبُشرَى لَنا نِعمَ الرَّسُولُ الَّذِى لَنا","وَنِعمَ لَنا أَهلاً وَسَهلاً وَسَرمَدَا",70,"د",2,0],["فبشراك منها موقف عز موقفا","تنال به الزلفى ويغفر ذنبكا",71,"ك",2,0],["فبشرى لأبكار البلاد فإنها","على ثقة عما قليل تراسله",72,"ل",2,0],["فبشرك أغراهم وغَرَّ ولم تزل","تدل على الغيث البروق اللوامع",73,"ع",1,0],["فَبَشِّر بَني مِصر بَخطبٍ يَروعُهُم","وَمَحلٍ عَلَى مَحلٍ وَكَربٍ عَلَى كَربِ",74,"ب",1,0],["فبشراهما بالفوز في نيل غاية","تقاصرت التيجان دون منالها",75,"ل",3,0],["فَبشراه في عميه ساعة اقبلا","على كل حرف تنبري عَن ظلالها",75,"ل",3,0],["فبُشراكَ يا مولى بمن به","سيغدو لنا غُصنُ الفخار رطيبا",76,"ب",2,0],["فبشراك فالنصر المبين محقق","من الله والفوز الجميل موطدُ",77,"د",1,0],["فبشراك من دنياك ادركت كل ما","اردت ومن خدر اتيت الى خدر",78,"ر",1,0],["فبشرِ الناسَ بالويلاتِ إن لبثت","لا تقرع الناسُ أبواب الصناعاتِ",79,"ت",1,0],["فبشِّرِ العُودَ من قبلِ الذبولِ به","إِذا ترَعرعَ فى بستانهُ ونَمَا",80,"م",2,0],["فبشرى بها لا زلت تجنى على المدا","هناء وتسدى للبرايا تفصلا",81,"ل",2,0],["فبشرى لها بشرى بتوفيقها