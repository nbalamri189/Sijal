gate.com/ViewPoem.aspx?id=175953",""],[5595,"الفنّ الجميل","https://www.poetsgate.com/ViewPoem.aspx?id=176740",""],[5720,"لأجلكَ أُستاذي","https://www.poetsgate.com/ViewPoem.aspx?id=199596",""],[5725,"وماعجبي بوجهك من صفاء","https://www.poetsgate.com/ViewPoem.aspx?id=185402",""],[402,"أبقى ويرفض حولي عقد خلاني","https://www.poetsgate.com/ViewPoem.aspx?id=36429",""],[5790,"أيا قلب دع عشق الحبيب المبرقع","https://www.poetsgate.com/ViewPoem.aspx?id=111873",""],[5839,"ويا قلبا","https://www.poetsgate.com/ViewPoem.aspx?id=62089",""],[5848,"ما أشجعك","https://www.poetsgate.com/ViewPoem.aspx?id=50624",""],[5963,"إِذا كنتَ وادي النمل","https://www.poetsgate.com/ViewPoem.aspx?id=187379",""],[6070,"غَريبٌ يبوحُ السرَّ في سِجنِ صدرهِ","https://www.poetsgate.com/ViewPoem.aspx?id=188678",""],[6102,"قبلة الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=184634",""],[6149,"بأرض الحمى لا زال قلبي عاكف","https://www.poetsgate.com/ViewPoem.aspx?id=169625",""],[6175,"عبيدكَ ليسوا حَجَرْ!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72850&r=&rc=75",""]],"verses":[["وَيا قُربَ ما أَنكَرتُمُ العَهدَ بَينَنا","نَسيتُم وَما اِستَودَعتُمُ الوُدَّ ناسِيا",0,"ي",2,0],["وَيا قَمراً دُجاهُ ما","تُثيرُ لَهُ مَناسِرُه",1,"ر",2,0],["وَيا قَمَراً رَجَوتُ السَيرَ فيهِ","فَلَثَّمَهُ الدُجى عَني بِجِنحِ",2,"ح",1,0],["وَياقُوتَةً قَدْ مَحَّصَ الدَّهْرُ سِنْخَهَا","صَلِيّاً فَلاَ ثَلْبٌ لَدَيْهَا وَلاَ ثَلْمُ",3,"م",1,0],["ويا قلْبُ لا تطْرَحْ سِلاحَكَ رهْبَةً","فهَلْ هيَ إلا أنّةٌ وزَفيرُ",4,"ر",1,0],["وَيَا قَادحَ الزَّنْدِ الشَّحَاحِ تَرَفُّقاً","عَلَيْكَ فَشَوْقِي الْخَارِجِيُّ شَبِيبُ",5,"ب",1,0],["ويا قَلْبُ لا تُلْقِ السّلاحَ فربّما","تعذّرَ في الدّهْرِ اطِّرادُ المَقاييسِ",6,"س",1,0],["وَيا قَبرَ زَيدانٍ طَوَيتَ مُؤَرِّخاً","تَجَلّى لَهُ ما أَضمَرَ الفَتَيانِ",7,"ن",1,0],["وَيا قَدَمي ما سِرتِ بي لِمَذَلَّةٍ","وَلَم تَرتَقي إِلّا إِلى العِزِّ سُلَّما",8,"م",2,0],["وَيا قَبرُ لا تَبخَل بِرَدِّ تَحِيَّةٍ","عَلى صاحِبٍ أَوفى عَلَينا وَسَلَّما",8,"م",2,0],["وَيا قَدَمي سيري حِذاراً وَخافِتي","مِنَ المَشيِ لَو يُنجي الأَثيمَ حِذارُ",9,"ر",1,0],["وَيَا قَرِيضِي دَعَا دَاعِي الوَفَاءِ إِلَى","رَعْيِ الذِّمَامِ فَكُنْ لِي خَيْرَ مِعْوَانِ",10,"ن",1,0],["ويا قلبُ صبراً في عطاها ومنعها","فلا بدَّ من يسرٍ ولا بد من عسر",11,"ر",1,0],["وَيا قَمَرَ الأُفقِ عُد راجِعاً","فَقَد باتَ في الأَرضِ عِندي قَمَر",12,"ر",1,0],["ويا قبر سعد فيك آمال أمة","فحافظ عليها ثم حافظ وهاود",13,"د",1,0],["وَيا قَومُ هَذا مَن يُقامُ لِمِثلِهِ","مِثالٌ لِباغي قُدوَةٍ مُتَعَلِّمِ",14,"م",1,0],["وَيا قَبرَ لَيلى أَكرِمَنَّ مَحَلَّها","يَكُن لَكَ ما عِشنا عَلَينا بِها نِعَم",15,"م",1,0],["وَيا قَبرَ لَيلى إِنَّ لَيلى غَريبَةٌ","بِأَرضِكَ لا خالٌ لَدَيها وَلا اِبنُ عَم",15,"م",1,0],["وَيا قَبرَ لَيلى ما تَضَمَّنتَ قَبلَها","شَبيهاً لِلَيلى ذا عَفافٍ وَذا كَرَم",15,"م",1,0],["وَيا قَبرَ لَيلى غابَتِ اليَومَ أُمُّها","وَخالَتُها وَالحافِظونَ لَها الذِمَم",15,"م",1,0],["وَيا قَلبِ صَبراً عِندَ كُلِّ مُلِمَّةٍ","وَخَلِّ عِنانَ الدَهرِ فَهُوَ حَرونُ",16,"ن",1,0],["وَياقوتُ العَصيرِ بِها","يُلاعِبُ لُؤلُؤَ الحَبَبِ",17,"ب",1,0],["وَيا قَضيباً ناعِماً في نَقاً","أَحَسَّ ريحاً فَاِنثَنى وَاِستَوى",18,"و",2,0],["وَيا قارونُ في الكِبرِ","وَيا عُرقوبُ في الوَعدِ",19,"د",1,0],["وَيا قِراهُ العَدُوَّ مُرهَفَةً","بيضاً وَيا لينَهُ إِذا صَحِبا",20,"ب",2,0],["وَيا قوارع اهدَئي","وَيا زوابع اهجَعي",21,"ع",2,0],["وَيَا قَمَرَيْ مَرَابِعنَا هَنِيئاً","قِرَانُكُمَا فَدُومَا فِي سُرُورِ",22,"ر",1,0],["وياقبرهُ جدْ كلَّ قبرٍ بجودهِ","ففيكَ سماءٌ ثرة ٌ وسحائبُ",23,"ب",1,0],["ويا قُصُوراً يرتديها الخَنَى","وترتدي وجهَ النبيِّ الكذوب",24,"ب",1,0],["ويا قبَساً من لهيب الحياة","خَبا حين شبَّ له مَضْرَم",25,"م",1,0],["وياقلبي اللّي وساويسك تنجّي غريق","الله لايصغر أبليسك .. ولا يلعنه",26,"ن",2,0],["ويا قبرَ ليلى إنَّ لَيْلَى غريبَة ٌ","بأرضك لا خل لديها ولاابن عم",27,"م",1,0],["ويا قلبُ أقرِرْ بالذي كنتَ جاحدا","فقد ضجِر اللاحى وقد فنِىَ العذلُ",28,"ل",1,0],["وَيا قاسِماً شَطرينِ حَظَّ نَواظِري","فَيُؤنِسُها لَيلاً وَيَجفو نَهارَهْ",29,"ر",2,0],["وَيا قَبرُ فيكَ اليَومَ أَنضرُ زَهرَةٍ","غَنيتَ بِها عَن زَهرِكَ المتضَوِّعِ",30,"ع",1,0],["ويا قلبه صبرا على ألم الهوى","فكلّ عظيم إنّما نيل بالصبر",31,"ر",1,0],["وَيا قاتلَ اللَّهُ اليهودَ فَإنّهم","أَشدُّ الوَرى كُفراً وَأَخبثُهم مَكرا",32,"ر",2,0],["ويا قضبَ البانِ مياسةٌ","ترنحُ كالأهيفِ المحتسي",33,"س",2,0],["ويا قمراً اسمه يوسفٌ","وفي الحسن تشبيهه يوسفا",34,"ف",2,0],["ويا قمراً ينير الحيل ليلاً","وشمساً تشرق الكلا نهارا",35,"ر",2,0],["ويا قلب تشتاق من تشتهيه","وأنت لديه فكيف جفاك",36,"ك",1,0],["ويا قباب حمى سلع حويت على","رقى بما أسلفت عندي أياديكي",37,"ك",2,0],["وَيَا قَفاهُ تَقدَّمْ","حَتَّى تَصيرَ بْجَنْبِي",38,"ب",2,0],["ويا قُدوداً وَقاها","منَ الحريرِ الثمين",39,"ن",1,0],["وَيا قَلْبُ إِنْ أَخْلَقَ الْوَجْدُ مِنْكَ","فَأَنى لِيَ الْيَوْمَ قَلْبٌ جَدِيدُ",40,"د",1,0],["وَيا قَبرَهُ وارَيتَ مِنهُ أَنامِلاً","إِذا المُزنُ ضَنَّت بِالحَيا كانَتِ المُزنا",41,"ن",2,0],["وَيا قلبي الذي ما زال مضنى","ليزددْ فيك يا قلبي الخفوق",42,"ق",1,0],["ويا قلب ناجِ الزعيم الشهيد","وضمي رفاتك يا أضلع",43,"ع",1,0],["وَيا قَمَراً رَسول اللَحظ عَنهُ","رَمى قَلبي بِمُعجزة اِنشِقاقِ",44,"ق",1,0],["ويا قَلبُ أنتَ معَ الظّاعنِينَ","تُسايِرُهمْ فإلى مَن تَتوق",45,"ق",1,0],["ويا قَمِناً عَهْدُه بالوفَاء","إذا ما اشْرأَبّتْ إليه حُقوق",45,"ق",1,0],["وَيا قَسوَرَ الكُتّابِ بَدِّد صُفوفَهُم","إِذا وَشَّحَت كَفّاكَ مِن قَلَمٍ رُمحا",46,"ح",2,0],["وَيا قَلب ما هَذا اللَهيب أَكلما","نَضجت عَلَيك الماء صَيرَتهُ جَمرا",47,"ر",2,0],["وياقريب الفرج فرج","على الذي خزنه قدبان",48,"ن",1,0],["ويا قلبُ إن ساعدتَ من لامَ في الهوى","فلا زلتَ في نارِ الصَّبابة والهجرِ",49,"ر",1,0],["ويا قلبي الولهان صبراً فإنه","إذا لم يكن صبر فأين التجلُّدُ",50,"د",1,0],["ويا قَدَمي جَنَيْتِ عليَّ كسراً","فظيعاً لا أرى مِنه انجبارا",51,"ر",2,0],["وَيا قَبرَ مَعنٍ كَيفَ وارَيتَ جودُهُ","وَقَد كانَ مِنهُ البَرُّ وَالبَحرُ مُترَعا",52,"ع",2,0],["ويا قلباً يذوبُ عليك وجداً","أرى هذا الغرام على وبالك",53,"ك",1,0],["ويا قاتل الله جند الهوى","تذِلّ العزيز وتوهي الحسب",54,"ب",1,0],["ويا قُضُبَ الحديدِ خَلاَكِ ذَمٌّ","بما أَحْرَزْتِ من قَصَبِ اللُّجَيْنِ",55,"ن",1,0],["ويا قُطْبَ العُلا مُلِّيتَ نُعْمى","تَمَلّاها بقُرْبِ الفَرْقَدَيْنِ",55,"ن",1,0],["ويا قائد الخيل العتاق لوفده","ويا مغنياً من ماله كل عادم",56,"م",1,0],["ويا قلَّما أُعطي الهوى فضلَ مِقودِي","فإن أعتلقْ حبّاً فيا قلَّما أسلو",57,"ل",2,0],["ويا قلبُ إن قادك الغانياتُ","فكم رسَنٍ فيك لم ينقدِ",58,"د",1,0],["ويا قلبُ قبلكَ ضلَّ القلو","بُ لو كنت أملك أن تُنشَدا",59,"د",2,0],["وَياقوتُ العَصيرِ بِها","يلاعِبُ لُؤلُؤَ الحَبيبِ",60,"ب",1,0],["ويا قمَر الزّمانِ ولا أُكَنّي","وشمسَ ضُحى المُلوكِ ولا أغالي",61,"ل",2,0],["وياقوتِ فِيها إنّ جوهرَ جِسمِها","لَكَالماءِ إلّا أنّه غيرُ سائلِ",62,"ل",1,0],["وياقوتة في سلك عقد مداره","على خرزات من عقيق مجزع",63,"ع",1,0],["ويا قديماً تجلَّى والمدى عدمٌ","فمَهَّدَ الأرضَ حتَّى أصبحتْ سَكَنَا",64,"ن",2,0],["وَيا قَلب ما أزمعتَ عَوْداً إلى الصِّبا","فتطمعَ في أنْ تَزْدَهِيك المطامعُ",65,"ع",1,0],["ويا قابض اقبضني على الحق مسلماً","ويا باسط ابسطني وكن لي مصافيا",66,"ي",2,0],["ويا قادر اجعل لي على الخير قدرة","ومقتدرُ اجْعل عنك سمعي واعيا",66,"ي",2,0],["ويا قبرَ إبراهيمَ أكرِمْ منعَّماً","عزيزاً على أُمٍّ مُخدَّشةِ الصَّدرِ",67,"ر",1,0],["ويا قبره لا شكَّ أَنك جَنَّةٌ","ولكِنْ بِها مِن أَدمعِ الخلقِ أَنْهَارُ",68,"ر",1,0],["ويا قريش النَّدى من جَبَّ غاربكم","ومن رمى نارَ عدنانٍ بإِخْمَاد",69,"د",1,0],["ويا قلْبُ لما لم يكن ذا أَمانةٍ","فِلمْ كنت لمّا خَانَ غيرَ أَمين",70,"ن",1,0],["ويا قلبُ لا تَأْسَفْ على فقدِ رَوْضَة","سَيَذْوِي بها وَرْدٌ ويذبُل نَرجِسُ",71,"س",1,0],["ويا قُربَ ما يَلقَى الهَوانَ كَريمها","وَيرأَمُ مُرَّ الضَّيمِ كَرهاً أنوفُها",72,"ف",3,0],["وَيا قطب دائرة الادارة وَالذَكا","وَيا كَعبة الطلاب يا طَيب الذكر",73,"ر",1,0],["وَيا قَلبِ لا تَقبل شَهادَة لائِمي","فَما قلت يَوماً في هَوايَ بِشاهِدِ",74,"د",1,0],["ويا قاضِي الوصالِ متى يُؤدِّي","بعدِلكَ صدُّه ممطولَ دَيني",75,"ن",2,0],["ويا قَتَّالُ كم تقتُ","لني عشقاً وتحييني",76,"ن",2,0],["ويَا قاربَ العمْرِ ملَّ الشِرَاع","أتبقى تُغَامرُ بالراحِلِ",77,"ل",1,0],["وَيَا قَلّمَا قدْ مَشَى نَخْلُهَا","وَيَا قلّمَا قدْ مَشَى رَافِدَاهَا",78,"ا",3,0],["ويا قرب ما بين الجوى وجوانحي","إذا أنا عانَيت ا