{"poems":[[55,"توقعي أن يقال قد ظعنا","https://www.aldiwan.net/poem29653.html","المنسرح"],[94,"يا ربة الشعر والأحلام غنيني","https://www.aldiwan.net/poem38900.html","الكامل"],[107,"أطلقوا قيدها وحلوا العقالا","https://www.aldiwan.net/poem43051.html","الخفيف"],[50,"دعني من الناس ومن لومهم","https://www.aldiwan.net/poem63425.html","السريع"],[50,"ومجلس ما له شبيه","https://www.aldiwan.net/poem64501.html","مجزوء البسيط"],[50,"لا تمزج الخمر على حال","https://www.aldiwan.net/poem64504.html","السريع"],[50,"يا ليلة بتها أسقاها","https://www.aldiwan.net/poem66170.html","البسيط"],[136,"آي أطلال الأوداء","https://www.aldiwan.net/poem54896.html","المديد"],[307,"عودي للهوكِ","https://www.aldiwan.net/poem65692.html","الكامل"],[308,"حدثنا فيما مضى صاحب","https://www.aldiwan.net/poem57617.html","السريع"],[463,"بكرت هيما تحل الربطا","https://www.aldiwan.net/poem56142.html","الرمل"],[508,"ويحك يابن العاصي","https://www.aldiwan.net/poem21736.html","منهوك المنسرح"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87266","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55936","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100297","الرجز"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68030","البسيط"],[4682,"خبز الشعير","https://www.poetsgate.com/ViewPoem.aspx?id=64804",""],[5302,"ليل ونهار","https://www.poetsgate.com/ViewPoem.aspx?id=200550",""],[5626,"عجبي عل كل المحاسن","https://www.poetsgate.com/ViewPoem.aspx?id=189694",""],[5756,"الدنيا بخير","https://www.poetsgate.com/ViewPoem.aspx?id=5434",""],[5997,"طيرٌ ذبيحٌ","https://www.poetsgate.com/ViewPoem.aspx?id=215430",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""]],"verses":[["نَأخُذُ مِن جُمَّةِ العُلى أَبَداً","ما أَخَذَ الضَربُ مِن جَماجِمِنا",0,"ن",2,0],["نَاختْ بنفسي مآسيها وما وَجَدَتْ","قلباً عطوفاً يُسَلِّيها فَعَزِّيني",1,"ن",2,0],["نأخذُ الفارسَ الكميَّ صِراعاً","حين يأبى الكماةُ إلا احتيالا",2,"ل",2,0],["نَأخُذُ مِن صَهباءَ كَرخِيَّةٍ","نَكتالُها وَزناً بِمِقياسِ",3,"س",1,0],["نَأخُذُ صَهباءَ بِنتَ كَرمٍ","عَذراءَ لَم تُؤوِها الحِجالُ",4,"ل",1,0],["نَأخُذُها مِن كَفِّ ذي غُنَّةٍ","كَأَنَّما خُطَّ بِتِمثالِ",5,"ل",1,0],["نَأخُذُها تارَةً وَتَأخُذُنا","مَوتورَةً نَقتَضي وَنَبداها",6,"ا",3,0],["نَأخُذُ المعنَى البديعَ بِلاَ","كُلفَةٍ في نَهجِهِ الجَائِى",7,"ا",2,0],["ناختْ بروحي من صدودك آفةٌ","والرأسُ بالشيبِ المهللِ يُشعلُ",8,"ل",1,0],["نأخذ عنه من وصاياه ما","ينفع من يسحب ذيل الفسوق",9,"ق",1,0],["نأخذُ الأرفعَ من طُرْق العلا","ونعدِّي المنحنى والمهبِطا",10,"ط",2,0],["نَأخُذُ بِالنَّواصِي","لاَ نَحذَرُ التَّنَاصِي",11,"ص",2,0],["ناخوس مِن قبل العربْ","حَفرُ الخَليج لَهُ غَلبْ",12,"ب",1,0],["ناخوذة الأيام نخبة عصره","فردٌ عزيزٌ في الوجود وحيدُ",13,"د",1,0],["نأخذ عن هاروت أو","ماروت سحر السحرا",14,"ر",2,0],["ناختْ ركائبُنا والطيرُ تهتف مَا","بَيْنَ الغصونِ لَهَا بالسَّجْعِ ألحان",15,"ن",1,0],["ناخذ من حطامها الشي الكثير","والحلال مع الحرام نطبّعه",16,"ع",2,0],["نأخذ البر عن كرام ونرعى","في نداه الأولاد والأحفادا",17,"د",2,0],["ناخَتْ عُطورُ الوَرْدِ تَحْتَ أريجِها","والزّهْرُ قَدْ نَزَعَ الخِمارَ وَ مالا",18,"ل",2,0],["ناخذ اطراف القضية في عيون الاعتبار","ونرسم دروب النجاة وخطة الفوز الكبير",19,"ر",1,0],["ناخت بقارعةِ السنينِ حبيبةٌ","وتعفَّرتْ بيدٍ تحلُّ وتمنعُ",20,"ع",1,0],["ناخَت وَشالَت رغم بهظ حمالها","وَحظوا الظَلايم فَوقَها وَشيلونها",21,"ن",3,0]]}