{"poems":[[55,"حييا دون الكثيب","https://www.aldiwan.net/poem30763.html","مجزوء الرمل"],[88,"ثلاثة من سراة النيل قد حبسوا","https://www.aldiwan.net/poem10357.html","البسيط"],[95,"أرن سهم الردى إرنان منتحب","https://www.aldiwan.net/poem9788.html","عموديه"],[68,"أما ترى الأنواء والسحائبا","https://www.aldiwan.net/poem40945.html","الرجز"],[50,"أيري لا يعدمني عرابدا","https://www.aldiwan.net/poem66258.html","الرجز"],[234,"ناعورة أنة أنين الهوى","https://www.aldiwan.net/poem50993.html","السريع"],[242,"رد صفوها يا أخي مندوصه","https://www.aldiwan.net/poem19298.html","مجزوء البسيط"],[275,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[398,"قد ظل يجرح صدري","https://www.aldiwan.net/poem53660.html","المجتث"],[422,"هاج القرام وهيجا بلبالي","https://www.aldiwan.net/poem54163.html","الكامل"],[463,"خذ من يدي صفقة الأماني","https://www.aldiwan.net/poem55855.html","مخلع البسيط"],[556,"عل الهوى يهفو به العذل","https://www.aldiwan.net/poem47341.html","أحذ الكامل"],[563,"دار ريا يا حسنها دار ريا","https://www.aldiwan.net/poem33565.html","الخفيف"],[563,"لا رؤية ولا شهود","https://www.aldiwan.net/poem34577.html","مجزوء الرجز"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101018","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101015","الطويل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106839","الكامل"],[2607,"","https://poetry.dctabudhabi.ae/diwan/poem/34885","الرجز"],[4246,"","https://poetry.dctabudhabi.ae/diwan/poem/103267","الخفيف"],[5953,"لاح ضياء القمر الزاهر","https://www.poetsgate.com/ViewPoem.aspx?id=93849",""],[6124,"لا نامتْ","https://www.poetsgate.com/ViewPoem.aspx?id=159892",""]],"verses":[["تَقذِفُ المَوتَ إِذا حُش","شَ لَظاها بِالكُعوبِ",0,"ب",1,0],["تَقذى عُيونُ بَني مِصرٍ بِمَظهَرِهِم","في الرَملِ حيناً وَفي حُلوانَ أَحيانا",1,"ن",2,0],["تَقْذَى عُيُونُ الأُولَى يَغْشَوْنَ أَرْبُعَهَا","بِكُلِّ عَارِي الشَّوَى فِي مَسْكَنٍ خَرِبِ",2,"ب",1,0],["تَقذِفُ مِن أَكبادِها كَواكِبا","ما خَيَبَت يَوماً لَنا مَساعِيا",3,"ي",2,0],["تقذفُ فيه واحداً فواحدا","فاستولج الناسُ له المساجدا",4,"د",2,0],["تَقذِف بالماء إلى روضةٍ","كأنها ريش طواويسِها",5,"س",3,0],["تَقْذَى بِهِ أَعْيُنُ الأَعَادِي","قَذىً لِأَعْيُنِهَا الْمَبْخُوصَهْ",6,"ص",2,0],["تقذّفُ نيرانَ الجحيمِ بطونُها","إذا فغَرت فوهاتِها وازبأرّ ت",7,"ت",1,0],["تَقذِف بِعُصبَةِ نَصبٍ","في قعرِ جَهلٍ وَمَكرِ",8,"ر",1,0],["تقذى نواظره بأوجه معشر","لا يعثرون بصالح الأَعمال",9,"ل",1,0],["تقذِفها ليلةٌ جمادٌ","في يومِ رمضاءَ معمعانِ",10,"ن",1,0],["تَقذِي جفوني كلُّ رائقةٍ","ويَمُرُّ في لَهَواتِيَ العَسَلَ",11,"ل",1,0],["تقذف الروح من مكان خفيٍّ","لا ترى مثله مقاماً حفيا",12,"ي",2,0],["تقذفهم من غيبها","على عماء أو شهود",13,"د",1,0],["تقذفهم بين المتالع والربى","ونلقى بهم من كل حصنٍ وجوسق",14,"ق",1,0],["تقذِّفه في زاخر البأس همةً","جدير بها الليث الهصور المقذَّف",15,"ف",1,0],["تقذي وتحمرُّ العيون به","فكأنما بجفونها شرر",16,"ر",1,0],["تَقذِفُ عَيناهُ لَدى ال","حَربِ بِنارِ الوَقَدِ",17,"د",1,0],["تقذف الموت كالبراكين ناراً","يخلط البحر في الهوا بالقتام",18,"م",1,0],["تقذفه ثم تنادي به","أمرت أن أقذف بالكافر",19,"ر",1,0],["تقذفُ عرشًا للظلمةِ في القعرِ","ويشبُّ الحلمُ عن الطوقِ.",20,"ق",1,0]]}