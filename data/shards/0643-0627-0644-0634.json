e.com/ViewPoem.aspx?id=210802",""],[5759,"عودة الرَشاد","https://www.poetsgate.com/ViewPoem.aspx?id=213721",""],[5776,"دفنوه حيا","https://www.poetsgate.com/ViewPoem.aspx?id=199402",""],[5781,"أحلامٌ مُفكَّكةٌ ووِسادةٌ خالية","https://www.poetsgate.com/ViewPoem.aspx?id=202844",""],[5804,"الحب والغيب","https://www.poetsgate.com/ViewPoem.aspx?id=190654",""],[5818,"ماذا عسى","https://www.poetsgate.com/ViewPoem.aspx?id=181337",""],[5898,"ومحجب بحجاب عز شامخ","https://www.poetsgate.com/ViewPoem.aspx?id=181068",""],[5952,"جمرٌ على الجمر","https://www.poetsgate.com/ViewPoem.aspx?id=202360",""],[5956,"لله درُّ فراسنا المتفاني","https://www.poetsgate.com/ViewPoem.aspx?id=193205",""],[5956,"تتسلق عيناي عيونَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=193890",""],[6093,"أشجار أشجان","https://www.poetsgate.com/ViewPoem.aspx?id=196883",""],[6093,"ما زال حبك في الضمائر ساكنا","https://www.poetsgate.com/ViewPoem.aspx?id=201519",""],[6093,"ترتاح نفسي إن نظرت لحسنها","https://www.poetsgate.com/ViewPoem.aspx?id=202896",""],[6093,"(أوجزتُ كلَّ قضيتي في المطلعِ)*","https://www.poetsgate.com/ViewPoem.aspx?id=205546",""],[6142,"هي القلاص المراسيم المراسيل","https://www.poetsgate.com/ViewPoem.aspx?id=155707",""],[5309,"ألشعر عاطفة بروحك تلمع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573519",""],[6237,"أحمد أمين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77883&r=&rc=25",""],[6323,"قتامة الحروف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82176&r=&rc=7",""],[572,"لي صاحِبٌ لا يجْتَنِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9277&r=&rc=134",""]],"verses":[["كَالشاءِ يُعذَلُ مِنّا غَيرُ مُكتَرِثٍ","عَيّاً وَيوعَظُ مِنّا غَيرُ مُستَمِعِ",0,"ع",1,0],["كالشّمسِ إنْ غابَ عنا فهْيَ طالِعَةٌ","وإنْ أطَلَّ عَلَينا غالَها الطَّفَلُ",1,"ل",1,0],["كَالشَمسِ لَمّا أَن بَدَت","لِلناسِ مِن خَلَلِ الغَمامِ",2,"م",1,0],["كالشمس يبقى رسمها بعدها","حيناً وقد بانت وراء الحجاب",3,"ب",1,0],["كالشَّمْسِ يَأْكُلُ مِنْهَا ظِل سُفْعَتِهَا","حَتَّى يَبِيدَ شُعَاعُ الشَّمْسِ وَالضَّرَمُ",4,"م",1,0],["كالشمس في الأُفُقِ الأعلى مَجَرَّتُها","والنُّور منها إلى الأبصار قد وَضَحَا",5,"ح",2,0],["كالشهد لفظ علاء الدِّين نرقبه","والسمّ عند عداة الدِّين نسترجي",6,"ج",2,0],["كالشمسِ طابت ربيع وقت","واعْتدل الليل والنهار",7,"ر",1,0],["كالشمسِ ما سَفَرَتْ والبدر ما انتقبتْ","ناهيكَ من مُسفِرٍ حُسْناً ومُنتَقِبِ",8,"ب",1,0],["كالشمس في حسنها وبهجتها","فإن تورّعْتَ قلتَ كالبدرِ",9,"ر",1,0],["كالشمس في كبد السماء محلها","وشعاعها في سائر الآفاق",10,"ق",1,0],["كالشمسِ لا تبدو فَضِيلتُها","حتى تَغَشَّى الأرضُ بالظُّلَمِ",11,"م",1,0],["كَالشاعِرِ الباكي عَلى طَلَلٍ","أَو قارِئٍ حَيرانَ في سِفرِ",12,"ر",1,0],["كَالشاةِ تُساقُ إِلى القَتلِ","بِعَصا جَبّارٍ ذي بَطشِ",13,"ش",1,0],["كالشُّعاعِ الجميلِ أَسْبَحُ في الأُفْقِ","وأُصْغي إلى خَريرِ المياهِ",14,"ه",1,0],["كالشمس قد حفت بنور ساطع","ليس السواد هناك من الوانه",15,"ن",2,0],["كالشعر معناه يتم بلفظه","فكأنه خود عليها مطرف",16,"ف",1,0],["كَالشَمسِ في كَبِدِ السَماءِ وَضَوؤُها","يَغشى البِلادَ مَشارِقاً وَمَغارِبا",17,"ب",2,0],["كَالشَمسِ لا تَبتَغي بِما صَنَعَت","مَنفَعَةً عِندَهُم وَلا جاها",18,"ا",3,0],["كَالشَمسِ إِلّا أَنَّهُ لا يَختَفي","وَالبَدرِ إِلّا إِنَّهُ لا يُمحَقُ",19,"ق",1,0],["كالشمسِ نأتْ عن مبصرها","بُعْداً وسناها منه دنا",20,"ن",2,0],["كالشمسِ سناها مُقْتَرِبٌ","وذراها مِنكَ عَلى بُعُدِ",21,"د",1,0],["كَالشَّمسِ يَبْعُدُ في السماءِ مَحَلُّها","وشُعاعُها في الأَرضِ غَيرُ بَعيدِ",22,"د",1,0],["كَالشيعَةِ اِلتَفَّت عَلى النَقيبِ","آخِذَةً بِطاعَةِ الجَنوبِ",23,"ب",1,0],["كالشمسِ لوْ أنَّ شمسَ الأفقِ ناطقةٌ","في دفِّها سعةٌ قدّامُها مِيلُ",24,"ل",1,0],["كالشمسِ تدنو بهجةً وسنا","ومتى أردتَ منالَهُ بَعُد",25,"د",1,0],["كالشمسِ ما حطَّ مِنْ عُلاها","قميصُها الواهِنُ المهلهلْ",26,"ل",1,0],["كالشمسِ ما يعيبُها","قميصها المهلهلُ",27,"ل",1,0],["كَالشَمسِ بِالأَسعُدِ إِذ أَشرَقَت","في يَومِ دَجنٍ بارِدٍ مُقتِمِ",28,"م",1,0],["كَالشَمسِ تُعجِبُ مَن رَأى وَيُزَينُها","حَسَبٌ أَغَرُّ إِذا تُريدُ فِخارا",29,"ر",2,0],["كَالشَمسِ صورَتُها غَرّاءُ واضِحَةٌ","تُعشي إِذا بَرَزَت مِن حُسنِها السُرُجا",30,"ج",2,0],["كَالشَمسِ يَومَ الدَجنِ تَندى مُجتَنى","ظِلٍّ وَتَحسُنُ مُجتَلى إِشراقِ",31,"ق",1,0],["كَالشَمسِ مَطلَعُها السَماءُ وَضَوءُها","قَد عَمَّ أَقطارَ البَسيطَةِ أَنؤُرا",32,"ر",2,0],["كَالشَمسِ تَختَشِعُ الكَواكِبُ حَولَها","وَالشَمسُ لَم تَكُ قَبلَ ذَلِكَ تُدلِجُ",33,"ج",1,0],["كالشِّمْسِ تَظْهَرُ لِلْعَيْنينِ مِنْ بُعُدٍ","صَغِيرةً وَتُكِلُّ الطَّرْفَ مِنْ أُمَمِ",34,"م",1,0],["كالشِّيْبِ يُغْدِقَ بالهُمومِ ذَنُوبَهُ","والذَّنْبُ فيهِ لكَثْرَةِ الأَعْوامِ",35,"م",1,0],["كَالشَمسِ بَينَ الزِبرِجِ المُنقَدِّ","سُلطانَ مُبيَضِّ عَلى مُسوَدِّ",36,"د",1,0],["كَالشَمسِ إِن بَرَقَت مَجاسِدُها","تَحكي لَنا الياقوتَ وَالذَهَبا",37,"ب",2,0],["كَالشَمسِ لَم يَدنُ مِن أَضوائِها دَنَسٌ","وَالبَدرُ قَد جَلَّ عَن ذَمٍّ وَإِن ثُلِبا",38,"ب",2,0],["كالشمسِ تدنو بهجةً وسنا","ومتى أردتَ منالَهُ بَعُدا",39,"د",2,0],["كالشمس في كبد السماء وضوءها","يغشى البلاد مشارقاً ومغاربا",40,"ب",2,0],["كالشمس في الشرق زهتْ ضحاها","والغرب لا يخرج عن رحاها",41,"ه",2,0],["كالشمس بنت الفلك المدار","وكم على الأرض لها من دار",42,"ر",1,0],["كَالشَّاعِرِ الضِّلِّيلِ أَوْ","قُسِّ بْنِ سَاعِدَةَ الإِيَادِي",43,"د",2,0],["كَالشَّمْسِ يَسْطُعُ نورُهَا فِي حَمْأَةٍ","فَيُحِيلُ قَاتِمَ لَوْنَِهَا تَذْهِيبَا",44,"ب",2,0],["كَالشَّمْسِ مَا آبَتْ أَتَتْ بِمُجَدَّدٍ","مُتَنَوَّعٍ مِنْ زِينَةٍ وَضِيَاءِ",45,"ا",2,0],["كَالشُّعْلَةِ الْحَمْراءِ لَوْ نَكَّسْتَها","لأَضَفْتَ إِشْعَالاً إِلَى إِشْعَالِ",46,"ل",1,0],["كالشمس بين العميان","تمل مدحاً قد زان",47,"ن",1,0],["كالشمس تترك خلفها","شفقًا إذا حان الغروب",48,"ب",1,0],["كالشُهد أوّلَ ما تذوَّقَه فمٌ","ما زالَ بين لُهاه طعمُ الصاب",49,"ب",1,0],["كالشمسِ غامتْ يومَها حتى الطَّفل","ثم انجلتْ والشطرُ منها قد أفل",50,"ل",1,0],["كَالشَّمْسِ صُورَتُها غَرّاءُ وَاضِحَة ٌ","تغشي، إذا برزت، من حسنها، السرجا",51,"ج",2,0],["كالشمس عمّ ضياه كلّ ناحيةٍ","من البلاد مقيما غير خنّاس",52,"س",1,0],["كالشمس غاربةً طوراً وطالعة","عوداً لبدء وما للشمس أيهان",53,"ن",1,0],["كالشمس أفُق الغرب ودّعها ولَمْ","يمض الدجى حتى حواها المشرقُ",54,"ق",1,0],["كالشَّموسِ الصَّعبِ إن ذلَّلوه","زادهم ذُعرا ولَجَّ قِماصا",55,"ص",2,0],["كَالشَّمْسِ حُسْناً وَالحُسَامِ خُشُونَةً","وَالمُزْنِ جُوداً وَالأَرَاكَةِ لِينا",56,"ن",2,0],["كالشمس ما كوكب يبدو ولا قمر","إلا ومن نورها النور الذي يهم",57,"م",1,0],["كَالشَمسِ شاقَت طَرفَ ناظِرِها فَما","سَمحت لَهُ إَلّا بأَوَّلِ مَنظَرِ",58,"ر",1,0],["كالشمسِ في الأفقِ الأعلى أبو حسنٍ","ومِن معاويةٍ في الأرض قنديلُ",59,"ل",1,0],["كالشمسِ من فوق السماءِ محلها","وشعاعُها تحتَ الثرى مخزونُ",60,"ن",1,0],["كالشمسِ في ثباتها","وظلِّها المتنقلِ",61,"ل",1,0],["كالشمسِ للعاشقِ","والشعرُ لهُ كزحلِ",61,"ل",1,0],["كالشّيء يَسْتهديه منّيَ ربُّه","أنتَ الأحقّ بها وبالإهداء",62,"ا",2,0],["كَالشَمسِ مَطبوعٌ عَلى الشِماس","يُخجِلُهُ ما بي مِنَ الوَسواسِ",63,"س",1,0],["كَالشَهدِ طَوراً وَهوَ لِل","أَعداءِ كَالسَمِّ المَدوفِ",64,"ف",1,0],["كَالشَّمْسِ تَقْذِفُ نُوراً","لِذِي ثَنَاءٍ وَقَذْفِ",65,"ف",1,0],["كالشَمس في كَبِد السَماء مَحلُّها","مُتَباعِدٌ وَضياؤُها مُتَقارِبُ",66,"ب",1,0],["كالشمس تسفر من أَقصى مطالعها","حسنا وَكالبَدر ملء العين مرآه",67,"ا",2,0],["كَالشَمعِ الأَخضَرِ قُضبانُهُ","وَالنّورُ فيهِ نورُهُ وَالذُبال",68,"ل",1,0],["كالشمسِ تحسَبُها دنتْ","للغربِ وهي أَشدُّ بعدا",69,"د",2,0],["كالشامةِ الخضراء فوق الوجنة ال","حمراء تحت المقلةِ السوداء",70,"ا",2,0],["كَالشَمسِ في مَغرِبِها شُروقُها","كَما لَها في شَرقِها غَربُ",71,"ب",1,0],["كَالشَمسِ يُبدي عَينَها نورُها","وَهوَ لَنا عَن كَنهِها ساتِرُ",72,"ر",1,0],["كالشّمعِ يَقبلُ نقْشَ الفَصّ مُنعكساً","مَكتوبهُ ليُريهِ النّاسَ مُسْتَويا",73,"ي",2,0],["كالشّمسِ دار على البسيطةِ دَوْرةً","علياءَ فامتلأتْ بهِ الدُّنْيا سَنا",74,"ن",2,0],["كالشّمسِ يَمْتنعُ اجْتلاؤك وَجْهَها","فإنِ اكتسَتْ برَقيقِ غَيْمٍ أمْكَنا",75,"ن",2,0],["كالشّمسِ لا كالبَدْرِ يَطلُعُ دائماً","فالبَدْرُ يَنقُصُ كُلّما قالوا كَمَل",76,"ل",1,0],["كالشمس إلّا أنها لمنيرةٌ","كالنجم إلّا أنَّه لضئيل",77,"ل",1,0],["كالشمس في كبد السماء إذا اختفت","من عارض قَذفَت إليك العارضا",78,"ض",2,0],["كالشمس إن طلعت أزاح ضياؤها ال","سامي من الأفق الرفيع ثواقبا",79,"ب",2,0],["كالشاعر المُقويّ طوراً مُهتدٍ","فيه وطوراً يركب الإ