{"poems":[[55,"عند قلبي علاقة ما تقضى","https://www.aldiwan.net/poem30174.html","الخفيف"],[55,"إلى كم الطرف بالبيداء معقود","https://www.aldiwan.net/poem30637.html","البسيط"],[65,"رنت إلي وظل النقع ممدود","https://www.aldiwan.net/poem46194.html","البسيط"],[65,"بشراك قد ظفر الراعي بما ارتادا","https://www.aldiwan.net/poem46210.html","البسيط"],[74,"رمى حشاي ويا شوقي إلى الرامي","https://www.aldiwan.net/poem19676.html","البسيط"],[53,"نجاك يا ابن الحاجب الحاجب","https://www.aldiwan.net/poem8294.html","السريع"],[53,"أيها السيد الذي اختاره السيد","https://www.aldiwan.net/poem65973.html","الخفيف"],[91,"أحمد كان مثل بحر رحيب","https://www.aldiwan.net/poem44619.html","الخفيف"],[87,"يا ثرى النيل في نواحيك طير","https://www.aldiwan.net/poem62831.html","الخفيف"],[87,"اختلاف النهار والليل ينسي","https://www.aldiwan.net/poem63713.html","الخفيف"],[45,"قد علم البين منا البين أجفانا","https://www.aldiwan.net/poem10588.html","البسيط"],[47,"قلب مشوق عناه البث والكمد","https://www.aldiwan.net/poem62734.html","البسيط"],[47,"لا يبعد اللهو في أيامنا المودي","https://www.aldiwan.net/poem63451.html","البسيط"],[63,"محسن الأخلاق والخلق","https://www.aldiwan.net/poem51345.html","السريع"],[2,"هل في تذكر أيام الصبا فند","https://www.aldiwan.net/poem25036.html","البسيط"],[82,"لم نؤت ليلتنا الغراء من قصر","https://www.aldiwan.net/poem31448.html","البسيط"],[53,"أيّها السيدُ الذي اختاره السيْ","https://www.poetsgate.com/ViewPoem.aspx?id=30337",""],[146,"وعيشكم لا ورد الحوم","https://www.aldiwan.net/poem58424.html","السريع"],[146,"من رأى المجد يثير القلاصا","https://www.aldiwan.net/poem58437.html","الخفيف"],[264,"زدت يا بيروت نورا","https://www.aldiwan.net/poem35790.html","مجزوء الرمل"],[310,"عبده محمود قابادو ما","https://www.aldiwan.net/poem56421.html","المديد"],[327,"آذن اليوم جيرتي بارتحال","https://www.aldiwan.net/poem56350.html","الخفيف"],[369,"إلى خيال خيال في الظلام سرى","https://www.aldiwan.net/poem60879.html","البسيط"],[369,"اليوم عاد رجائي مورق العود","https://www.aldiwan.net/poem60929.html","البسيط"],[396,"محسن أحسن عسى ربك يجازيك بإحسان","https://www.aldiwan.net/poem54462.html","عموديه"],[409,"أحسن ما يبدي به الكلام","https://www.aldiwan.net/poem33344.html","الرجز"],[438,"راح يوافي طراده طرده","https://www.aldiwan.net/poem12432.html","المنسرح"],[463,"عسى معرض وجهه مقبل","https://www.aldiwan.net/poem55971.html","المتقارب"],[469,"عشت دهراً منعماً بالأماني","https://www.aldiwan.net/poem3506.html","عموديه"],[469,"يا من لابيض كل جفن اسود","https://www.aldiwan.net/poem3536.html","عموديه"],[473,"محسن بن الملح من جهله","https://www.aldiwan.net/poem59540.html","السريع"],[473,"محسن بن الملح مأبون","https://www.aldiwan.net/poem59591.html","السريع"],[473,"محسن ما لحمقه مثل","https://www.aldiwan.net/poem59761.html","الخفيف"],[473,"محسن بن الملك شر بلى","https://www.aldiwan.net/poem60045.html","السريع"],[556,"ما لك في ربة الغلائل","https://www.aldiwan.net/poem47285.html","الرجز"],[556,"فخرا فإنك من قوم إذا افتخروا","https://www.aldiwan.net/poem47863.html","البسيط"],[563,"قد هدينا بالخاطر المستقيم","https://www.aldiwan.net/poem34080.html","الخفيف"],[580,"سلام عليه لا على الدهر بعده","https://www.aldiwan.net/poem3075.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122644","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122773","البسيط"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34424","الطويل"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101982","البسيط"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52094","الرمل"],[1901,"","https://poetry.dctabudhabi.ae/diwan/poem/216574","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69374","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69342","البسيط"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89543","البسيط"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109433","البسيط"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47166","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88638","الخفيف"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106878","الرمل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60859","البسيط"],[3083,"","https://poetry.dctabudhabi.ae/diwan/poem/138015",""],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89416","الرجز"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66577","الخفيف"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135737","الرجز"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95335","الرجز"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94394","الكامل"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119559","الخفيف"],[1901,"ترى على العهدِ أهلُ الودِّ أم خانوا","https://www.poetsgate.com/ViewPoem.aspx?id=160421",""],[5582,"عَرِّجْ فَهَذِي ( رُسُومُ ) الأَثْلِ وَالبانِ","https://www.poetsgate.com/ViewPoem.aspx?id=187310",""],[5596,"فنجاء","https://www.poetsgate.com/ViewPoem.aspx?id=206476",""],[5725,"مدينة الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=184314",""],[5725,"شمس الصبيحة","https://www.poetsgate.com/ViewPoem.aspx?id=185895",""],[5764,"الواقع المر","https://www.poetsgate.com/ViewPoem.aspx?id=137045",""],[5956,"ريثما الموت يجىء","https://www.poetsgate.com/ViewPoem.aspx?id=181921",""]],"verses":[["مُحسِناتٌ إِلى الغَريمِ مِطالاً","مَنَعَ الدَلُّ دَينَها أَن يُقَضّى",0,"ض",2,0],["مُحَسَّدُ المَجدِ مَغبوطٌ مَناقِبُهُ","مُتَيَّمُ القَلبِ بِالعَلياءِ مَعمودُ",1,"د",1,0],["مُحَسَّدُ المَجْدِ لم يَطلُعْ ثَنيّتَهُ","إلا أغرُّ على العَلياءِ مَحسودُ",2,"د",1,0],["مُحَسَّدُ المَجْدِ لمْ تُطْلَعْ ثَنيَّتُهُ","إنَّ المكارِمَ لا يَعْدَمْنَ حُسّادا",3,"د",2,0],["محسّن الخلق والأخلاق تألفه","عقائل الفضل عن وجدٍ وتهيام",4,"م",1,0],["مُحسنةً ليست بخطَّاءة","طائرُها الهادِلُ لا الناعبُ",5,"ب",1,0],["محسنٌ مجملٌ وليس ببِدعٍ","ذاك مِنْ مثلهِ ولا بمحالِ",6,"ل",1,0],["محسن للتجديد احمد في البد","ء فمن ذا سيحسن الاتماما",7,"م",2,0],["مُحسِنٌ بِالبَنينِ في حاضِرِ العَي","شِ وَفي سالِفِ الزَمانِ الطَويلِ",8,"ل",1,0],["مُحسِناتِ الفُصولِ لا ناجِرٌ في","ها بِقَيظٍ وَلا جُمادى بِقَرسِ",9,"س",1,0],["مُحَسَّدُ الفَضلِ مَكذوبٌ عَلى أَثَري","أَلقى الكَمِيَّ وَيَلقاني إِذا حانا",10,"ن",2,0],["مُحَسَّدٌ بِخِلالٍ فيهِ فاضِلَةٍ","وَلَيسَ تَفتَرِقُ النَعماءُ وَالحَسَدُ",11,"د",1,0],["مُحَسَّدٌ وَكَأَنَّ المَكرُماتُ أَبَت","أَن توجِدَ الدَهرَ إِلّا عِندَ مَحسودِ",12,"د",1,0],["محسن الأخلاق والخلق","أحسن من صلى إلى الشرق",13,"ق",1,1],["مُحَسَّدونَ عَلى ما كانَ مِن نِعَمٍ","لا يَنزِعُ اللَهُ مِنهُم ما لَهُ حُسِدوا",14,"د",3,0],["محسودةُ الحسن لا تنفكّ في شَغَفٍ","منها بصبحٍ صقيل الليل في الشَّعَرِ",15,"ر",1,0],["محسنٌ مجملٌ وليس ببِدعٍ","ذاك مِنْ مثلهِ ولا بمجالِ",16,"ل",1,0],["محسَّدٌ يغبِط أقلامَه","على يديه الرمحُ والمِخذَمُ",17,"م",1,0],["محسنٌ بالرأي ضربا وطعنا","يُخجل البيضَ ويُخزِى الخِراصا",18,"ص",2,0],["محسنٌ قد فاز بالحس","نى لديه وزياده",19,"د",2,0],["مُحسنُ الظنّ بهِ قائِلاً","حَسبُنا اللّه ونعمِ الوكيل",20,"ل",1,0],["مُحسِنٌ مُجمَلٌ تَقِيٌّ قَوِيٌّ","وَهُوَ أَهلُ الإِحسانِ وَالإِجمالِ",21,"ل",1,0],["مُحسَّدُ المجدِ والعُلْيا إذا رُمِقَتْ","مُحمّدُ الإِسْمِ والأوصافِ إن ذُكرا",22,"ر",2,0],["مُحَسَّدُ الفَضلِ ما بَينَ الوَرى أَبَداً","وَما سَمِعنا بِفَضلٍ غَيرِ مَحسودِ",23,"د",1,0],["محسن أحسن عسى ربك يجازيك بإحسان","واعمل الخير تحمد في عواقبك والآن",24,"ن",1,1],["محسناً تخليصه من ذنبه","مصلياً على النبي وحزبه",25,"ه",1,0],["محسناً للاتباع فيما","ألفه أهل الذكا قديما",25,"م",2,0],["مُحَسَّدٌ يَوْمُهُ ثَنَى نَظَرَ ال","أَمْسِ إِلى حُسْنِهِ ومدَّ يَدَه",26,"د",2,0],["محسّدة العين سهلُ اللحا","ظِ يصبغها مثلَه الأكحلُ",27,"ل",1,0],["محسناتٌ إليك والدهر جانٍ","باسمات الوجوه عند القطوب",28,"ب",1,0],["محسودة الإحسان راع جمالها","إنَّ الجمال مطيَّةٌ للحسّد",29,"د",1,0],["مُحَسِّنٌ بنُ المِلحِ مِن جَهلِهِ","يَدخُلُ فيما لَيسَ يَعنيهِ",30,"ه",1,1],["مُحَسَّنُ بنُ المِلحِ مَأبونُ","لَيسَ لَهُ دُنيا وَلا دينُ",31,"ن",1,1],["مُحَسِّنٌ ما لِحُمقِهِ مِثلُ","أَكثَرُ ما في طِباعِهِ الجَهلُ",32,"ل",1,1],["مُحَسِّنُ بِنُ المِلكِ شَرُّ بَلى","لَهُ أَخٌ جُملَتُهُ خَيرُ",33,"ر",1,1],["محسودةٌ مضبوطةٌ ظواهري","لكنَّها مرحومةٌ دواخلي",34,"ل",2,0],["مُحَسَّدين وهذا الفضل مَرقَبةٌ","تَجرّ قِدْماً على طُلّاعِها الحَسدا",35,"د",2,0],["محسنات بأمره يقذف الخل","ق كقذف المدادِ صورةَ ميم",36,"م",1,0],["محسِنٌ حسَّن العُلاَ ويزيدُ الب","يتَ حُسْناً حَلاوَةُ الإِنْشَادِ",37,"د",1,0],["مَحَسّاها إذا لَقَحَت كِشافا","وقُطباها إذا حَميت وطيسا",38,"س",2,0],["مُحَسَّدُ الفَضلِ مَعرُوفٌ بِشُهرَتِه","في المَجدِ أَشهَرُ مِن نارٍ عَلى عَلَمِ",39,"م",1,0],["محسَّدَةٌ لا قَدح فيها لعائب","عَلى أَن زندَ الفضل مِن أَهلِها واري",40,"ر",2,0],["محسد في مزايا قد تقمصها","وصاحب الفضل لا يخلو من الحسد",41,"د",1,0],["مُحسنُ العشرَةِ صَافٍ","مَنْ تَلقَاهُ أحَبهْ",42,"ب",2,0],["محسدَّينِ على ما ليس في يَدهم","ذُلاًّ لهم معشراً دِينوا وما دانوا",43,"ن",3,0],["مُحسِنٌ نَستَفيدُ مِن يَدِهِ الثَر","وَةَ فَضلاً وَحِكمَةً مِن كَلامِه",44,"م",2,0],["مُحسِنٌ بِالعِبادِ مَن سَأَلَ الل","هَ لَهُم في بِقائِهِ وَدَوامِه",44,"م",2,0],["مُحَسَّدُونَ وَلَو لَم يَعلُ قَدرُهُم","عَن قَدرِ كُلِّ جَليلِ القَدرِ ما حُسِدُوا",45,"د",3,0],["مُحَسَّدِ الفَضلِ مَضروبٍ سُرادِقُهُ","عَلى أَشَمَّ عَظيمِ القَدرِ وَالهِمَمِ",46,"م",1,0],["محسنات العلى بالجد والتعب","يحوزها المرء لا بالهزل واللعب",47,"ب",1,1],["محسودةً كَعُقابِ جوٍّ مَنْعَةً","بشموخها وكَمِيِّها الضّرغام",48,"م",1,0],["محسن الفعل من عليه المعالي","ابدا لم يزل يرف لواها",49,"ا",3,0],["محسناً يُرعي عليها","ضامنَ الذكر مديدا",50,"د",2,0],["مُحَسَّدون علىَ ما كان من نَعمٍ","كاسون من كرم عارون من بخل",51,"ل",1,0],["محسوب في الأحياء وفي الميتين","عاقل ولكن كالمجانين",52,"ن",1,0],["محسنا لهم ما كان من قبح","يرجون رحمة مولاهم يزعمهم",53,"م",1,0],["مُحسَّبٌ مُنسَّبٌ وجيهٌ","يقلّ فيه قول لوذعي",54,"ي",1,0],["مُحْسنٌ لِلْمُسِيْءِ يَعفو بِقَلْبٍ","فِيهِ كِبْرٌ عَنْ حَمْلِ حِقْدٍ وَكِبْرِ",55,"ر",1,0],["مُحسنُ يا مفضلُ يا منَّانُ","تطيعني بفضلك الأكوانُ",56,"ن",1,0],["محسبه وكسر سين قد ورد","أيضاً وحسباناً كثيراً لا يُرد",57,"د",1,0],["محسودةً باتَت ولكن لَم يكن","ضرٌّ عليها وَالهمام نصيرها",58,"ر",3,0],["محسن في كلامه","ومسيءٌ فعاله",59,"ل",2,0],["محسدَّينِ على ما ليس في يَدهم","ذُلاًّ لهم معشرَ دِينوا ومادانوا",60,"ن",3,0],["مُحَسَّدُ الفَضْلِ سُلْطانٌ يَجِلُّ إِذا","عُدَّتْ فَضائِلُهُ عَنْ كُلِّ سُلْطانِ",61,"ن",1,0],["( محسن ١٢) المحسن الذي طال فيها","كل قاماتها بخير قيام",62,"م",1,0],["محسّدة ولو رأت الثكالى","جمالاً لارتجتْ رميا ببينِ",63,"ن",1,0],["محسدة المحاسن فيك قالوا","ومن حسد المحاسن مات غلا",64,"ل",2,0],["محسوبتك كل يوم تنام محتاره","وأدناة حاجة تزعلها وترضيها",65,"ي",3,0],["مُحْسنٌ في كل شيء","وعفيفٌ وبريىء",66,"ا",1,0]]}