ا بعضُ أصحابي الغيارى","https://www.poetsgate.com/ViewPoem.aspx?id=193816",""],[5956,"لا تحسبوا قدَماً لديَّ وحيدة كُسِرتْ","https://www.poetsgate.com/ViewPoem.aspx?id=205169",""],[6079,"سنن الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=212718",""],[6102,"طالق ..","https://www.poetsgate.com/ViewPoem.aspx?id=184436",""],[520,"يهوى الحبيبين من بأس ومن كرم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577609",""]],"verses":[["فصدَّقَ ظنّي صدّقَ اللهُ ظنّهُ","بِما لا تُناجيهِ المُنى منْ هِباتِهِ",0,"ت",2,0],["فصَدَدْتُ عنها إذ نَباني مَعْشَري","وبَغى عليَّ منَ الأراذِلِ مَعْشَرُ",1,"ر",1,0],["فصدق من قادته سَابِقَةُ الْهُدَى","وَسَاعَدَهُ الإسْعَادُ فِي سَالِفِ الْحُكْمِ",2,"م",1,0],["فَصَدَّ فَأَضحى بِالسَليلِ كَأَنَّهُ","سَليبُ رِجالٍ فَوق عَلياءَ قائِمُ",3,"م",1,0],["فَصَدِّق ظُنوناً لي وَفِيَّ فَإِنَّني","لَأَهلُ اليَدِ البَيضاءَ مِنكَ وَلا فَخرُ",4,"ر",1,0],["فَصَدَّقتِهِ في كُلِّ حَقٍّ وَباطِلٍ","أَتاكِ بِهِ نَمُّ الأَحاديثِ خائِنُ",5,"ن",1,0],["فصدّق الله ظنّا فيك أحسنه","قومٌ وكذب ظنّ الجاهل الخرق",6,"ق",1,0],["فصدّق ما للعرب من تالد العلا","وما لهم في العلم من خالد الذكر",7,"ر",1,0],["فَصَدَّهُم مَنطِقُ الدَجاجِ عَنِ العَه","دِ وَضَربُ الناقوسِ فَاِجتُنِبا",8,"ب",2,0],["فَصَدَدتُ عَن أَطلالِهِنَّ بِجَسرَةٍ","عَيرانَةٍ كَالعَقرِ ذي البُنيانِ",9,"ن",1,0],["فَصَدَّقهُمْ مِنْهُ لَعَشْرٍ كَوَامِلٍ","خَلَوْنَ لَهُ طَوْدٌ بِهِ الأرضُ تُوتَدُ",10,"د",1,0],["فصدَّت ملياً ثم جادت بريقة","يزيد لها سكر المحب فيضعف",11,"ف",1,0],["فصدَّرْتُ أعجازَ الهجاءِ مناسباً","تحُطُّ الوعولَ من رؤوس المعاقل",12,"ل",1,0],["فصدَّقني جزاهُ اللَّه خيراً","وأكْذَبَهم وألزمهم مغارمْ",13,"م",1,0],["فصدَّعَتِ الأَرضُ من فوقها","وأَبْصرتِ الكونَ عذبَ الصُّوَرْ",14,"ر",1,0],["فَصَدتَ في النَوروزِ عِرقاً وَقَد","تُخِيِّرَ الوَقتُ وَطابَ الأَوان",15,"ن",1,0],["فُصِدتَ والسعدُ في أعلى مطالِعه","مُقابلٌ منك سَعداً غيرَ مُنتقِلِ",16,"ل",1,0],["فُصِدْتَ فلا عَراكَ الهمُّ فيه","ولا عُرِّيتَ من ثَوبِ السُّعودِ",17,"د",1,0],["فَصَدَّقَ مِنْ ظَنِّ الصديقِ وأكذَبتْ","مواقعُه ظَنَّ العدوِّ المُحاربِ",18,"ب",1,0],["فَصَدَدتُ حينَ تَرَكتُهُ مُتَجَدِّلاً","كَالجِذعِ بَينَ دَكادِكٍ وَرَوابي",19,"ب",2,0],["فَصَدَدتَ عَنّي نَخوَةً","وَتَجَبُّراً وَلَوَيتَ شِدقا",20,"ق",2,0],["فصدور الغيد سيَّا","ن وأنياب السباع",21,"ع",1,0],["فَصَدَّت وَعاضَتهُ أَسىً وَصَبابَةً","وَما عائِضٌ مِنها وَإِن جَلَّ عائِضُ",22,"ض",1,0],["فَصَدَّقتَهُ لَم أَستَطِع أَن أَوَدَّهُ","وَلَم أَملِكِ الأَعداءَ أَن يَتَكَلَّموا",23,"م",3,0],["فَصَدَّت وَقالَت كاذِبٌ وَتَجَهَّمَت","فَنَفسي فِداءُ المُعرِضِ المُتَجَهِّمِ",24,"م",1,0],["فَصَدَّت وَقالَت ما تَزالُ مُتَيَّماً","بِنَجدٍ وَإِن كُنتُ الصَحيحَ قَتيلا",25,"ل",2,0],["فَصَدَّت صُدودَ الرِئمِ ثُمَّ تَبَسَّمَت","وَقالَت لِتِربَيها اِسمَعا لَيسَ يَرفَقُ",26,"ق",1,0],["فَصَدَّت وَقالَت بَل تُريدُ فَضيحَتي","فَأَحبِب إِلى قَلبي بِها مُتَغَضِّبا",27,"ب",2,0],["فَصَدَدنَ خَوفاً عن سِنانَي باسِلٍ","بَطَلٍ أَشاحَ عَلى الوَغى مِغوارِ",28,"ر",1,0],["فَصَدَدنَ عَنهُ وَقَد عَصَفنَ بِنَعجَةٍ","خَذَلَت وَأَفرَدَها فَريرٌ مُفرَدُ",29,"د",1,0],["فَصُدّوا صُدودَ الوانِ أَبقى عَلَيكُمُ","بَني مالِكٍ إِذ سُدَّ كُلُّ سَبيلِ",30,"ل",1,0],["فصَدتْكَ كفّاهُ وما دَرَتَا ولو","يَدْري غَداةَ المشهد المشهود",31,"د",1,0],["فَصَدَّقَ ظَنّي صَدَّقَ اللَهُ ظَنُّهُ","إِذا ظَنَّ خَيراً وَالظُنونُ فُنونُ",32,"ن",1,0],["فصدامٌ كما تصادمُ أجبا","لٌ رَواس ومثلهنَّ بحور",33,"ر",1,0],["فصَدَفْتَ عن ذاتِ السّوَا","رِ ولم تُرِدْ خَلْخَالَها",34,"ل",3,0],["فَصَدَّقْتُها في البَيْنِ مِن غَيْرِ عَبْرةٍ","وكَمْ مِن كَثيرِ الدّمْعِ غَيْرِ مُصَدَّقِ",35,"ق",1,0],["فَصَدَّقَ لَكِنّهُ","تَجَاهَلَ لَمَّا عَرَفْ",36,"ف",1,0],["فَصَدَّقْتَهُ، لَمْ أَسْتَطِعْ أَنْ أَرُدَّهُ،","وَلَمْ أَمْلِكِ الأَعْداءَ أَنْ يَتَكَلَّمُوا",37,"م",3,0],["فصدتْ وقالت: كاذربٌ! وتجهمتْ،","فَنَفْسي فِداءُ المُعْرِضِ المُتَجَهِّمِ",38,"م",1,0],["فصدَّق من بني الوطن الظنونا","واضحى سيف قائده المفدى",39,"ا",1,0],["فصدقتهم عقلا وقلت كقولهم","وليس لمن حاكى النساء يمين",40,"ن",1,0],["فصديقه يبكي عليه تشوقاً","وعدوه في فرحة لنكاله",41,"ل",2,0],["فَصَدرُ مَلكِهِمُ مِمّا جَرى حَرِجٌ","وَقَلبُ مَلكِهِمُ مّما يَرى يَجِبُ",42,"ب",1,0],["فَصَدَّقتَ مَن سَمّاكَ مِن قَبلُ سابِقاً","بِكَونِكَ سَبّاقاً إِلى رُتَبِ العُلا",43,"ل",2,0],["فصدق بالميعاد كل مكذب","وقرت نفوس نحوه وأطمأنت",44,"ت",1,0],["فصدّق حينا ثم ايقن أَنه","غرور أماني ما لهن تمامُ",45,"م",1,0],["فصدرك قلب البحر ان ناب معضل","وقلبك صدر البحر ان عظم الأمر",46,"ر",1,0],["فصددتم عنه وقلتم ما جرى","شرك ولا للشرك من وجدان",47,"ن",1,0],["فَصَدَ الطَبيبُ ذِراعَهُ","فَجَرى لَهُ دَمعي ذَريعا",48,"ع",2,0],["فَصَدِّق مَدحَتي وَأَجِز كَريماً","إِذا ما عَفَّ عَن بَلَدٍ أَطالا",49,"ل",2,0],["فصُدْغك كيف انثنى","وخَصْرك كيف انعقد",50,"د",1,0],["فَصَدِّق يا فَدَتكَ النَّفسُ رُؤيَا","رَأَتها في المنام كَذَاك عَيني",51,"ن",2,0],["فَصُدغُهُ صَولَجانٌ خالُهُ كُرَةٌ","وَالخالُ حَبَّةُ قَلبي لا أُخَلّيهِ",52,"ي",2,0],["فَصَدَّ عَنّي زَمَني إِذ كَسى","حالِيَ تَحسيناً وَتَحصينا",53,"ن",2,0],["فصدورُها جاشَتْ بها حُرَقُ الأسى","في صدرِه وَرويُّها أرنانه",54,"ن",2,0],["فَصَدَّقَ ما أَقولُ بِحَبحَبِيٍّ","كَفَرخِ الصَعوِ في العامِ الجَديبِ",55,"ب",1,0],["فَصدّقَ الغوثُ مَغزاه وقال لَقَد","تَفرّس اِبني ولمّا يبلغ الحلمُ",56,"م",1,0],["فَصَدَّ بَها عَن ثادِقٍ وَحِسابِهِ","وَصَدَّ بِها عَن ماءِ ذاتِ العَشائِرِ",57,"ر",1,0],["فَصَدَدنَ عَنهُ إِذ وَحِمنَ عَواذِلاً","حَتّى اِستَمَرَّ وَأَنكَرَ الأَخلاقا",58,"ق",2,0],["فَصدَّقُوهُ أَنَّهُ مُرْسَلٌ","أَرْسَلُ مِن شَنْفٍ لِخَلْخالِ",59,"ل",1,0],["فصَدِّقِ الجِدَّ في مَعْنىً رآك له","أهْلاً وحَقِّقْ له ما كان يَعْنيه",60,"ي",2,0],["فَصُدَنْ عن الماءِ الأجاج تصوُّناً","فكم موردٍ غصت عليكم مشاربه",61,"ب",2,0],["فَصَدقتَهُم حَرباً غَدت نيرانُها","ثُمَّ اِنثَنَت وَالمُشرِكونَ رمادُ",62,"د",1,0],["فَصَدَّت وقالَت والكَبيرُ بسُهمَة","متى يَبكِ يوماً للتصابي يُعَنَّفِ",63,"ف",1,0],["فصدقت عيني ما كذبت","إذ ذكرت من لونها ما نسيت",64,"ت",1,0],["فصدعْتَ عنه الجوْرَ صَدْعَةَ ثائِرٍ","ونظمتَ فِيهِ العَدْلَ أَيَّ نظامِ",65,"م",1,0],["فَصَدَعْتَ أَحشاءَ الظَّلامِ بِعَزْمَةٍ","تَسْرِي البصائِرُ فِي سَنَا مِصباحِها",66,"ح",3,0],["فصدَفتْ أمس لها","واليوم عنها تصدِفُ",67,"ف",1,0],["فَصَدِّروهُ مَعَ اللِئامِ وَلا","تَحتَقِروهُ 