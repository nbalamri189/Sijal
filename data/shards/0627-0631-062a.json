{"poems":[[53,"ما مقامي على الهوان وعندي","https://www.aldiwan.net/poem29624.html","الخفيف"],[53,"سيدي أنت ليس كلل","https://www.aldiwan.net/poem29953.html","مجزوء الخفيف"],[53,"تمضي العلى وإلى ذراكم ترجع","https://www.aldiwan.net/poem30156.html","الكامل"],[53,"ألهاك عنا ربة البرقع","https://www.aldiwan.net/poem30157.html","السريع"],[53,"أرتاح إن أخذ الصفصاف زينته","https://www.aldiwan.net/poem30436.html","البسيط"],[77,"نفحت فشبت لافح التذكار","https://www.aldiwan.net/poem36518.html","الكامل"],[83,"سل الأفق بالزهر الكواكب حاليا","https://www.aldiwan.net/poem54224.html","الطويل"],[51,"أغر مخيلات الأماني لموعها","https://www.aldiwan.net/poem65406.html","الطويل"],[91,"قالت سكت وما سكت سدى","https://www.aldiwan.net/poem8813.html","عموديه"],[89,"ليس البليد الجاهل","https://www.aldiwan.net/poem45078.html","مجزوء الرجز"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[85,"اجعل رثاءك للرجال جزاء","https://www.aldiwan.net/poem62936.html","الكامل"],[85,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[62,"لا أدعي أني وفيت بعهدكم","https://www.aldiwan.net/poem52494.html","الكامل"],[45,"أن دعاه داعي الصبا فأجابه","https://www.aldiwan.net/poem10667.html","الخفيف"],[45,"مخبرتي برقة أحواج","https://www.aldiwan.net/poem62672.html","السريع"],[45,"هين ما يقول فيك اللاحي","https://www.aldiwan.net/poem62696.html","الخفيف"],[61,"كملن فأطلعن البدور كواملا","https://www.aldiwan.net/poem51486.html","الطويل"],[61,"يروع هجرها قلبا مروعا","https://www.aldiwan.net/poem51573.html","الوافر"],[61,"أناشد دهري أن يعود كما بدا","https://www.aldiwan.net/poem51709.html","الطويل"],[2,"شطت أميمة بعدما صقبت","https://www.aldiwan.net/poem25042.html","الكامل"],[66,"كذا فليصبر الرجل النجيب","https://www.aldiwan.net/poem40117.html","الوافر"],[87,"يا ناعس الطرف إلى كم تنام","https://www.aldiwan.net/poem8287.html","السريع"],[90,"‏كل ما في الكون حب وجمال","https://www.aldiwan.net/poem26553.html","الرمل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[50,"دعني أمت بالهوى لا يلحني لاح","https://www.aldiwan.net/poem63970.html","البسيط"],[50,"قاس الهموم تنل بها نجحا","https://www.aldiwan.net/poem63980.html","الكامل"],[46,"إذا ما غضوب غاضبت كل ريبة","https://www.aldiwan.net/poem22817.html","الطويل"],[46,"ارتاحت النفس بتطهيرها","https://www.aldiwan.net/poem22848.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85750","الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85374","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85555","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147472","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42734","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54727","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55168","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54327","المنسرح"],[90,"أبو العلاء المعري","https://www.poetsgate.com/ViewPoem.aspx?id=179199",""]],"verses":[["أَرتَضي بِالأَذى وَلَم يَقِفِ العَز","مُ قُصوراً وَلَم تَعِزُّ المَطِيُّ",0,"ي",1,0],["أَرتَقي غايَةَ الكُهو","لِ بِسِنِّ المُراهِقِ",1,"ق",1,0],["أَرتِق لَها فَتقَ النَوائِبِ بِالنَدى","أَو بِالقَنا وَلِكُلِّ خَرقٍ مَرقَعُ",2,"ع",1,0],["اِرتَضَعوا وَالعارَ مِن فيقَةٍ","وَنَزَعوا وَاللُئمُ مِن مَنزِعِ",3,"ع",1,0],["أَرتاحُ إِن أَخَذَ الصَفصافُ زينَتَهُ","مِنَ الرَبيعِ وَقالَ الرَكبُ قَد مُطِرا",4,"ر",2,1],["أرْتاحُ فيكَ للَوْمِ لُوّامي كَما","يرْتاحُ نجْديٌّ لشمِّ عَرارِ",5,"ر",1,0],["أَرتنا طباعَ الجود وهي وليدة","ولم ترضَ في الإحسان أَلاَّ تُغاليا",6,"ي",2,0],["أرتني سعودي ذلك اليوم أنه","برود نفوس حُلِّئت ونُقوعها",7,"ع",3,0],["أَرتاعُ إِن أَبصَرتُ واحِدَهُم","ذُعرَ الشُوَيهَةِ أَبصَرَت أَسَدا",8,"د",2,0],["ارتفعت عن العرا","قين به نوازل",9,"ل",1,0],["اِرتَدَ عَن مَصرَ هَزيماً جُندُهُ","يَشكو مِن الإِخشيدِ مُرَّ المُشتَكى",10,"ا",1,0],["اِرتَدَّتِ العاهاتُ عَن أَخلاقِهِ","لِسُمُوِّهِنَّ وَحَلَّتِ الأَعضاءَ",11,"ا",2,0],["اِرتَدى بُرنُسَهُ وَاِلتَثَما","وَخَطا خُطوَةَ شَيخٍ مُرعَسِ",12,"س",1,0],["أَرتاحُ إنْ لاحَ الوميضُ وأنثني","نشوانَ إن هبَّتْ عليَّ جَنُوبُ",13,"ب",1,0],["أَرتَجي عِندَهُ فَواضِلَ نُعمى","ما اِرتَجاها الشَمّاخُ عِندَ عَرابَه",14,"ب",2,0],["أَرتَجتَ لَمّا فَتَحوا بابَها","بِالسَيفِ صَلتاً أَيَّ إِرتاجِ",15,"ج",1,0],["إِرتِياحاً لِلطالِبينَ وَبَذلاً","وَالمَعالي لِلباذِلِ المُرتاحِ",16,"ح",1,0],["أرتك ملوك الروم رايات ملكهم","فأعملت في الروم الظبا والعواملا",17,"ل",2,0],["أَرَتْها الأَبعونَ هَشيمَ رَوْضٍ","وقبلَ الأربعينَ رَأَتْ رَبيعا",18,"ع",2,0],["أرَتْنا اللَّيالي قَصْدَها دونَ جَوْرِها","وشأنُ اللّيالي أن تجورَ وتَقْصِدا",19,"د",2,0],["اِرتاعَ يَذكُرُ مَشرَباً بِثِمادِهِ","مِن دونِهِ خُشُعٌ دَنونَ وَأَنقُبُ",20,"ب",1,0],["أَرَتكَ بِفَقدِ فَخرِ الدينِ رُزءاً","تُشَقُّ لَهُ المَرائِرُ لا الجُيوبُ",21,"ب",1,0],["أَرْتَاحُ إِنْ مَرَّ نَسِيمُ الصَّبَا","وَالْبُرْءُ لِي فِيهِ مَعَاً وَالسَّقَامْ",22,"م",1,0],["أرتجيها صفوة منكم وأن","زَعَموها بغيةً ليست تنال",23,"ل",1,0],["أرْتَجِي التَّوْبَةَ النَّصُوحَ وفِي القَلْ","بِ نفَاقٌ وفي اللسانِ رِياءُ",24,"ا",2,0],["أَرتاحُ لِلريحِ إِن هَبَّت يَمانِيَةً","وَأَنتَ عِندي رَخيمٌ غَيرُ مُرتاحِ",25,"ح",1,0],["اِرتَجَّ وَاِندَفَعَت تُعارِضُهُ","غَنّاءَ خالَطَ صَوتُها بُحَحا",26,"ح",2,0],["أَرَتكَ بِرُغمِ الأَنفِ سَيفَ اِبنِ ظالِمٍ","حَمائِلُهُ مَوصولَةٌ بِفَتى الحُمسِ",27,"س",1,0],["اِرتاحَت النَفسُ بِتَطهيرِها","وَرَبُّها قاضٍ بِتَدنيسِها",28,"س",3,1],["ارتحل عن بلد","أَنت فيه مهملُ",29,"ل",1,1],["اِرتاب في نبأ به","يفضي إليَّ المخبر",30,"ر",1,0],["اِرتقت سلم التقدم ناس","ووقفنا في أَسفل الدرجات",31,"ت",1,0],["أرتهُ السماءُ أعاجيبَها","ورَوَّتهُ من كلِّ فنٍّ بديعْ",32,"ع",1,0],["أرتك عم رسول الله منتقباً","أبا حذيفة يحكي أو أبا حمل",33,"ل",1,0],["أَرْتَاحُ إِنْ مَرَّ مِنْ تِلْقَائِهِمْ نَسَمٌ","تَسْرِي بِهِ فِي أَرِيجِ الْعَنْبَرِ الأُصُلُ",34,"ل",1,0],["أَرَتِ النِّهَايَةَ فِي تَجِلَّةِ أُمَّةٍ","لِمُلُوكِهَا مَا أَخْلَصُوا وَأَفَادُوا",35,"د",3,0],["أَرَتْنَا وُجُوه الحَقِّ فِي كُلِّ مُعْضِلٍ","وَمِنْ دُوِنهَا الاسْتَارُ مُحْكَمَةُ السَّبْلِ",36,"ل",1,0],["أَرَتْنِيَ الدنْيَا وَبِي","عَنْهَا جَلاَلٌ وَكِبَرْ",37,"ر",1,0],["ارتاعَ قرصانهُ وساستهُ","وأعوَلت من رياحه جزره",38,"ر",2,0],["أرتهُمُ خيرَ ما في السّحْرِ من بُدءٍ","وأضمرتْ شَرَّ ما قد أضمرتْ عُقبا",39,"ب",2,0]]}