{"poems":[[53,"ما مقامي على الهوان وعندي","https://www.aldiwan.net/poem29624.html","الخفيف"],[53,"سيدي أنت ليس كلل","https://www.aldiwan.net/poem29953.html","مجزوء الخفيف"],[53,"تمضي العلى وإلى ذراكم ترجع","https://www.aldiwan.net/poem30156.html","الكامل"],[53,"ألهاك عنا ربة البرقع","https://www.aldiwan.net/poem30157.html","السريع"],[53,"أرتاح إن أخذ الصفصاف زينته","https://www.aldiwan.net/poem30436.html","البسيط"],[77,"نفحت فشبت لافح التذكار","https://www.aldiwan.net/poem36518.html","الكامل"],[83,"سل الأفق بالزهر الكواكب حاليا","https://www.aldiwan.net/poem54224.html","الطويل"],[51,"أغر مخيلات الأماني لموعها","https://www.aldiwan.net/poem65406.html","الطويل"],[91,"قالت سكت وما سكت سدى","https://www.aldiwan.net/poem8813.html","عموديه"],[89,"ليس البليد الجاهل","https://www.aldiwan.net/poem45078.html","مجزوء الرجز"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[85,"اجعل رثاءك للرجال جزاء","https://www.aldiwan.net/poem62936.html","الكامل"],[85,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[62,"لا أدعي أني وفيت بعهدكم","https://www.aldiwan.net/poem52494.html","الكامل"],[45,"أن دعاه داعي الصبا فأجابه","https://www.aldiwan.net/poem10667.html","الخفيف"],[45,"مخبرتي برقة أحواج","https://www.aldiwan.net/poem62672.html","السريع"],[45,"هين ما يقول فيك اللاحي","https://www.aldiwan.net/poem62696.html","الخفيف"],[61,"كملن فأطلعن البدور كواملا","https://www.aldiwan.net/poem51486.html","الطويل"],[61,"يروع هجرها قلبا مروعا","https://www.aldiwan.net/poem51573.html","الوافر"],[61,"أناشد دهري أن يعود كما بدا","https://www.aldiwan.net/poem51709.html","الطويل"],[2,"شطت أميمة بعدما صقبت","https://www.aldiwan.net/poem25042.html","الكامل"],[66,"كذا فليصبر الرجل النجيب","https://www.aldiwan.net/poem40117.html","الوافر"],[87,"يا ناعس الطرف إلى كم تنام","https://www.aldiwan.net/poem8287.html","السريع"],[90,"‏كل ما في الكون حب وجمال","https://www.aldiwan.net/poem26553.html","الرمل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[50,"دعني أمت بالهوى لا يلحني لاح","https://www.aldiwan.net/poem63970.html","البسيط"],[50,"قاس الهموم تنل بها نجحا","https://www.aldiwan.net/poem63980.html","الكامل"],[46,"إذا ما غضوب غاضبت كل ريبة","https://www.aldiwan.net/poem22817.html","الطويل"],[46,"ارتاحت النفس بتطهيرها","https://www.aldiwan.net/poem22848.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85750","الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85374","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85555","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147472","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42734","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54727","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55168","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54327","المنسرح"],[90,"أبو العلاء المعري","https://www.poetsgate.com/ViewPoem.aspx?id=179199",""],[167,"أرتها المآقي ما تكن الجوانح","https://www.aldiwan.net/poem1611.html",""],[167,"سما لك من أم العبيد خيال","https://www.aldiwan.net/poem1660.html",""],[209,"أسافر في يوم الثلاثاء ليتني","https://www.aldiwan.net/poem46608.html","الطويل"],[219,"أرت أم عباس أعجوبة","https://www.aldiwan.net/poem55282.html","المتقارب"],[227,"تميط الأذى عن حامليها الصوارم","https://www.aldiwan.net/poem50832.html","الطويل"],[227,"أعذلا وما عذلتني النهى","https://www.aldiwan.net/poem51276.html","المتقارب"],[233,"وخيال سرى إلي فأدنا","https://www.aldiwan.net/poem31738.html","الخفيف"],[244,"نأتك بليلى دارها لا تزورها","https://www.aldiwan.net/poem56333.html","الطويل"],[248,"ألقت أشعتها عليك الراح","https://www.aldiwan.net/poem14939.html","الكامل"],[250,"أما كفاك تلافي في تلافيكما","https://www.aldiwan.net/poem1474.html",""],[259,"نعم هذه الزوراء لاحت قصورها","https://www.aldiwan.net/poem38136.html","الطويل"],[259,"لقد آن إعراضي عن الغي جانبا","https://www.aldiwan.net/poem38364.html","الطويل"],[259,"سقاك الحيا ريا وحياك أربعا","https://www.aldiwan.net/poem38378.html","الطويل"],[269,"عاهدوا الربع ولوعا وغراما","https://www.aldiwan.net/poem52089.html","الرمل"],[280,"حي على أثلات يبرينا","https://www.aldiwan.net/poem32396.html","السريع"],[280,"غبتم فلم يغب الغرام","https://www.aldiwan.net/poem32469.html","مجزوء الكامل"],[280,"سري بألسنة الدموع يباح","https://www.aldiwan.net/poem32814.html","الكامل"],[285,"أرتك بذات الضال منها معاصماً","https://www.aldiwan.net/poem1893.html","الطويل"],[296,"أدال الله (جلق) من عداها","https://www.aldiwan.net/poem36817.html","عموديه"],[301,"ارتاض قلبي فيكم وارتضى","https://www.aldiwan.net/poem58103.html","السريع"],[308,"حي المعاهد كانت قبل تحييني","https://www.aldiwan.net/poem59516.html","البسيط"],[326,"أأبكى هوى أم فرحة أم أمانيا","https://www.aldiwan.net/poem55003.html","الطويل"],[335,"عفت ذروة من أهلها فجفيرها","https://www.aldiwan.net/poem45429.html","الطويل"],[340,"يا ظبية البان ما رددت ذكراك","https://www.aldiwan.net/poem55313.html","البسيط"],[346,"أرتني هنا يملأ الراحتين","https://www.aldiwan.net/poem20368.html","المتقارب"],[362,"أصح عيون البابلية ما اعتلا","https://www.aldiwan.net/poem60796.html","الطويل"],[362,"روحا ساعة متون القلاص","https://www.aldiwan.net/poem60864.html","الخفيف"],[369,"حتى متى كل مشتك زاجر","https://www.aldiwan.net/poem57427.html","المنسرح"],[369,"أرته الليالي كل مستقبل ذاهب","https://www.aldiwan.net/poem57531.html","الطويل"],[374,"أيا أغنياء الروح صونوا كنوزَكم","https://www.aldiwan.net/poem59426.html","الطويل"],[377,"لمن العيس تختفي وتبين","https://www.aldiwan.net/poem49253.html","الخفيف"],[388,"أدركوني أدركوني","https://www.aldiwan.net/poem54460.html","عموديه"],[400,"مرحبا يا مرحبا يا مرحبا بنسيم","https://www.aldiwan.net/poem34146.html","الرمل"],[406,"سل المدائن عمن كان يملكها","https://www.aldiwan.net/poem31702.html","عموديه"],[406,"أرته غرته في الهجر مصلحتي","https://www.aldiwan.net/poem32605.html","البسيط"],[413,"شام برقا راعه مبتسما","https://www.aldiwan.net/poem53999.html","الرمل"],[413,"سقى الطلل الغمام وجاد رسما","https://www.aldiwan.net/poem54028.html","الوافر"],[413,"أنيخاها فقد بلغت مناها","https://www.aldiwan.net/poem54083.html","الوافر"],[413,"بكت بدم من بعد عيسى وبندر","https://www.aldiwan.net/poem54120.html","الطويل"],[413,"حييت من قادم حل السرور به","https://www.aldiwan.net/poem54138.html","البسيط"],[426,"أمن خدها الوردي افتنك الخال","https://www.aldiwan.net/poem40062.html","الطويل"],[426,"أتت مثل خوط البان تهتز أو أرقى","https://www.aldiwan.net/poem40712.html","الطويل"],[426,"يهيجني تذكار خل كما البدر","https://www.aldiwan.net/poem41069.html","الطويل"],[434,"إن داراً بين اللوى والعفيق","https://www.aldiwan.net/poem2547.html","الخفيف"],[456,"أمنك خيال ضوع الركب موهنا","https://www.aldiwan.net/poem55831.html","الطويل"],[456,"أتمنى والمنى جهد المقل","https://www.aldiwan.net/poem55996.html","الرمل"],[456,"آنس برقا بالشريف لامعا","https://www.aldiwan.net/poem56123.html","الرجز"],[456,"حيها أوجها على السفح غرا","https://www.aldiwan.net/poem56191.html","الخفيف"],[456,"نديمي وما الناس إلا السكارى","https://www.aldiwan.net/poem56204.html","المتقارب"],[475,"ربع وقفت عليه بعد أهليه","https://www.aldiwan.net/poem15251.html","البسيط"],[475,"آليت لا حلت ولا حلتم","https://www.aldiwan.net/poem15270.html","السريع"],[491,"ذو قصر أحدب من غير كبر","https://www.aldiwan.net/poem67295.html","عموديه"],[498,"جاء البشير ليعقوبي بيوسفه","https://www.aldiwan.net/poem38078.html","البسيط"],[536,"أنا من اسمى نعيمه","https://www.aldiwan.net/poem47933.html","عموديه"],[536,"عرفت مقام القوم إذ بت تجهد","https://www.aldiwan.net/poem48236.html","عموديه"],[544,"ألا يا اسلمي لا صرم لي اليوم فاطما","https://www.aldiwan.net/poem1864.html","الطويل"],[560,"أطوف الأرض في شرق وغرب","https://www.aldiwan.net/poem52849.html","الوافر"],[561,"أثار الهوى سجع الحمام المغرد","https://www.aldiwan.net/poem13598.html","الطويل"],[565,"أرتك يد الغيث آثارها","https://www.aldiwan.net/poem69674.html","المتقارب"],[571,"يا برق برقاً بين مروة والصفا","https://www.aldiwan.net/poem3646.html","الكامل"],[573,"لقد ذهبت نفسي وقد صفرت يدي","https://www.aldiwan.net/poem2970.html","الطويل"]],"verses":[["أَرتَضي بِالأَذى وَلَم يَقِفِ العَز","مُ قُصوراً وَلَم تَعِزُّ المَطِيُّ",0,"ي",1,0],["أَرتَقي غايَةَ الكُهو","لِ بِسِنِّ المُراهِقِ",1,"ق",1,0],["أَرتِق لَها فَتقَ النَوائِبِ بِالنَدى","أَو بِالقَنا وَلِكُلِّ خَرقٍ مَرقَعُ",2,"ع",1,0],["اِرتَضَعوا وَالعارَ مِن فيقَةٍ","وَنَزَعوا وَاللُئمُ مِن مَنزِعِ",3,"ع",1,0],["أَرتاحُ إِن أَخَذَ الصَفصافُ زينَتَهُ","مِنَ الرَبيعِ وَقالَ الرَكبُ قَد مُطِرا",4,"ر",2,1],["أرْتاحُ فيكَ للَوْمِ لُوّامي كَما","يرْتاحُ نجْديٌّ لشمِّ عَرارِ",5,"ر",1,0],["أَرتنا طباعَ الجود وهي وليدة","ولم ترضَ في الإحسان أَلاَّ تُغاليا",6,"ي",2,0],["أرتني سعودي ذلك اليوم أنه","برود نفوس حُلِّئت ونُقوعها",7,"ع",3,0],["أَرتاعُ إِن أَبصَرتُ واحِدَهُم","ذُعرَ الشُوَيهَةِ أَبصَرَت أَسَدا",8,"د",2,0],["ارتفعت عن العرا","قين به نوازل",9,"ل",1,0],["اِرتَدَ عَن مَصرَ هَزيماً جُندُهُ","يَشكو مِن الإِخشيدِ مُرَّ المُشتَكى",10,"ا",1,0],["اِرتَدَّتِ العاهاتُ عَن أَخلاقِهِ","لِسُمُوِّهِنَّ وَحَلَّتِ الأَعضاءَ",11,"ا",2,0],["اِرتَدى بُرنُسَهُ وَاِلتَثَما","وَخَطا خُطوَةَ شَيخٍ مُرعَسِ",12,"س",1,0],["أَرتاحُ إنْ لاحَ الوميضُ وأنثني","نشوانَ إن هبَّتْ عليَّ جَنُوبُ",13,"ب",1,0],["أَرتَجي عِندَهُ فَواضِلَ نُعمى","ما اِرتَجاها الشَمّاخُ عِندَ عَرابَه",14,"ب",2,0],["أَرتَجتَ لَمّا فَتَحوا بابَها","بِالسَيفِ صَلتاً أَيَّ إِرتاجِ",15,"ج",1,0],["إِرتِياحاً لِلطالِبينَ وَبَذلاً","وَالمَعالي لِلباذِلِ المُرتاحِ",16,"ح",1,0],["أرتك ملوك الروم رايات ملكهم","فأعملت في الروم الظبا والعواملا",17,"ل",2,0],["أَرَتْها الأَبعونَ هَشيمَ رَوْضٍ","وقبلَ الأربعينَ رَأَتْ رَبيعا",18,"ع",2,0],["أرَتْنا اللَّيالي قَصْدَها دونَ جَوْرِها","وشأنُ اللّيالي أن تجورَ وتَقْصِدا",19,"د",2,0],["اِرتاعَ يَذكُرُ مَشرَباً بِثِمادِهِ","مِن دونِهِ خُشُعٌ دَنونَ وَأَنقُبُ",20,"ب",1,0],["أَرَتكَ بِفَقدِ فَخرِ الدينِ رُزءاً","تُشَقُّ لَهُ المَرائِرُ لا الجُيوبُ",21,"ب",1,0],["أَرْتَاحُ إِنْ مَرَّ نَسِيمُ الصَّبَا","وَالْبُرْءُ لِي فِيهِ مَعَاً وَالسَّقَامْ",22,"م",1,0],["أرتجيها صفوة منكم وأن","زَعَموها بغيةً ليست تنال",23,"ل",1,0],["أرْتَجِي التَّوْبَةَ النَّصُوحَ وفِي القَلْ","بِ نفَاقٌ وفي اللسانِ رِياءُ",24,"ا",2,0],["أَرتاحُ لِلريحِ إِن هَبَّت يَمانِيَةً","وَأَنتَ عِندي رَخيمٌ غَيرُ مُرتاحِ",25,"ح",1,0],["اِرتَجَّ وَاِندَفَعَت تُعارِضُهُ","غَنّاءَ خالَطَ صَوتُها بُحَحا",26,"ح",2,0],["أَرَتكَ بِرُغمِ الأَنفِ سَيفَ اِبنِ ظالِمٍ","حَمائِلُهُ مَوصولَةٌ بِفَتى الحُمسِ",27,"س",1,0],["اِرتاحَت النَفسُ بِتَطهيرِها","وَرَبُّها قاضٍ بِتَدنيسِها",28,"س",3,1],["ارتحل عن بلد","أَنت فيه مهملُ",29,"ل",1,1],["اِرتاب في نبأ به","يفضي إليَّ المخبر",30,"ر",1,0],["اِرتقت سلم التقدم ناس","ووقفنا في أَسفل الدرجات",31,"ت",1,0],["أرتهُ السماءُ أعاجيبَها","ورَوَّتهُ من كلِّ فنٍّ بديعْ",32,"ع",1,0],["أرتك عم رسول الله منتقباً","أبا حذيفة يحكي أو أبا حمل",33,"ل",1,0],["أَرْتَاحُ إِنْ مَرَّ مِنْ تِلْقَائِهِمْ نَسَمٌ","تَسْرِي بِهِ فِي أَرِيجِ الْعَنْبَرِ الأُصُلُ",34,"ل",1,0],["أَرَتِ النِّهَايَةَ فِي تَجِلَّةِ أُمَّةٍ","لِمُلُوكِهَا مَا أَخْلَصُوا وَأَفَادُوا",35,"د",3,0],["أَرَتْنَا وُجُوه الحَقِّ فِي كُلِّ مُعْضِلٍ","وَمِنْ دُوِنهَا الاسْتَارُ مُحْكَمَةُ السَّبْلِ",36,"ل",1,0],["أَرَتْنِيَ الدنْيَا وَبِي","عَنْهَا جَلاَلٌ وَكِبَرْ",37,"ر",1,0],["ارتاعَ قرصانهُ وساستهُ","وأعوَلت من رياحه جزره",38,"ر",2,0],["أرتهُمُ خيرَ ما في السّحْرِ من بُدءٍ","وأضمرتْ شَرَّ ما قد أضمرتْ عُقبا",39,"ب",2,0],["أَرَتها المَآقي ما تُكِنُّ الجَوانِحُ","فَبُح فالمُعَنّى بِالصَّبابَةِ بائِحُ",40,"ح",1,1],["أرَتني دِيارَ الحَيِّ قَومي وَدُونَها","وِهادٌ وَأَطوادٌ عَلَت وَرِمالُ",41,"ل",1,0],["أرتل قرآناً عن العشق فاتناً","وللعشق في روحي كتاب منزّل",42,"ل",1,0],["أرت أم عباس أعجوبة","تضل كبير الحجى بالودع",43,"ع",1,1],["أَرَتْهُمُوني قليلا هِمّةٌ بَلغتْ","بِحَيْثُ لا يَنْتهيه الهَمُّ والهمَمُ",44,"م",1,0],["أرَتني التَّجاربُ ما قد بَدَا","فقِسْتُ بِه كلَّ ما قد خَفا",45,"ا",1,0],["أَرتَجي فَضلَ ناقِصٍ وَأُداري","كُلَّ جِنسٍ ما في سَجاياهُ لينُ",46,"ن",1,0],["أرتنا حياضَ الموتِ ليلى وراقنا","عُيونٌ نقّياتُ الحواشي تُديرُها",47,"ر",3,0],["أرتاحُ إن ذكرَ العذيبُ وبارقٌ","شوقاً إليه وكيف لا أرتاحُ",48,"ح",1,0],["أَرت مَساعيك سُبلَ المَجدِ جاهِلَها","فَلَو سَعى كانَ أَيضاً مِن مَساعيكا",49,"ك",2,0],["ارتك سماء الحسن تبدو بروجها","جهاراً ولا تبدو جهاراً بدورها",50,"ر",3,0],["ارتنا المعالي فيك كل غريبة","ولم تزل الأيام تدبي الغرائبا",51,"ب",2,0],["أرتنا الليالي حاليات ضيعها","فلما اختبرناهن كان تصنعا",52,"ع",2,0],["اِرتَضاه اللَه نوراللهدى","واِنتضاه لدم الاعدا حساما",53,"م",2,0],["أَرتاحُ إِن لاحَ بَريقُ الحِمى","إِلى عُرَيبٍ ثَمَّ نائينا",54,"ن",2,0],["أَرتاحُ وَجداً كُلَّما","غَنَّت عَلى البانِ الحَمامُ",55,"م",1,0],["أَرتاحُ أَن يَسري إِلَيَّ خَيالُهُم","لَيلاً وَكُلُّ مُتَيَّمٍ يَرتاحُ",56,"ح",1,0],["أَرَتكَ بِذاتِ الضالِ مِنها مَعاصِماً","وَخَدّاً أَسيلاً كَالوَذيلَةِ ناعِما",57,"م",2,1],["أرتنيها المحبةُ بيتَ نارٍ","يلوح (لموبذ) وَهْناً سناها",58,"ا",3,0],["ارتاض قلبي فيكم وارتضى","أن ينقضي الود وأن ينقضا",59,"ض",2,1],["ارتاد منها ملياً لا يماطلني","وعداً وأرجو كريماً لا يعنيني",60,"ي",1,0],["أُرَتّل أشعاري حنيناً وصبوةً","وأسكب روحي في الظلام مراثيا",61,"ي",2,0],["أَرَتنا حِياضَ المَوتِ ثُمَّتَ قَلَّبَت","لَنا مُقلَةً كَحلاءَ ظَلَّت تُديرُها",62,"ر",3,0],["ارتل الشعر في جوف الدجى صوراً","من الخيال عليها لوعة الشاكي",63,"ك",2,0],["أَرَتْني هَناً يَملأُ الرَّاحَتينِ","وَأُخفِي هَناً لي فَرْطَ الصِّغَرْ",64,"ر",1,1],["أرَتْهُ من الأيّامِ عزّةُ نَفْسِه","سَواءً بعَيْنَيهِ الوِلايةَ والعَزْلا",65,"ل",2,0],["أرتَجِي منكَ ما يُرجَّى منَ الغَيْ","ث إذا سَحَّ وهْو داني النَّشاص",66,"ص",1,0],["أرتعُ في زَهرِها وأذكرُ ما","يذكرُه الناسُ عن أبي طاهِر",67,"ر",1,0],["أرته اللّيالي كلَّ مستقبلٍ ذاهب","وأعلَمنه أنّ النوى للنوى صاحِب",68,"ب",1,1],["أرتك المزايا البيض حتى تحسرت","أرتك المنايا السود بالأسيُفِ الحمر",69,"ر",1,0],["أَرتَجي مِن يَد الحَما اِنفِلاتاً","وَهَوى الشَوق بِالرَدى مَقرون",70,"ن",1,0],["أرتجيكم يا رجائي","بالفضائل تعمروني",71,"ن",2,0],["أرتضي تعذيب قلبي في الهوى","ليس قلبي عنكم منقلبا",72,"ب",2,0],["أرتهم العبر الدنيا فما اعتبروا","فصيرتهم لقوم بعدهم عبرا",73,"ر",2,0],["أَرتْه غِرَّتُه في الهَجْر مَصْلَحتي","جهلاً فأفسدَ منِّي كلَّ ما صَلَحا",74,"ح",2,1],["أرتقي فيه العُلى لم أتخذ","مَدْحَه للمجد إلاَّ سلَّما",75,"م",2,0],["أرَتني من حوادثها اللَّيالي","أعاجيباً لها العَبرات تدمى",76,"م",2,0],["أرَته زينةَ الأمجاد تزهو","بأرديةِ المحاسن فارتداها",77,"ا",3,0],["أرتنا المنايا كيف تُصمي سهامها","وكيف تصول النائبات وتجتري",78,"ر",2,0],["أرَتْك صِدْقَ مَوَدَّات الرجال بها","وبانَ عِندَك صِدْقُ القولِ والزُّورُ",79,"ر",1,0],["ارتنا كثيياً فوقه خيزرانة","بروحي تلك الخيزرانة والخال",80,"ل",1,0],["أرتني من السحر المبين معانياً","وما كنت أدري الشحر من قبلها حقا",81,"ق",2,0],["ارتنا من الأجفان سحرا كأنه","أساطير عبد الله ذي القلم البحري",82,"ر",2,0],["أرتجي الطيف أن يلمّ ومن أع","جب شيء زور الخيال الطروق",83,"ق",1,0],["أرتنا به ظمياءُ وصلا مموّها","على سفهِ المسرَى وزُوراً مميَّنا",84,"ن",2,0],["أرتعوني والأنابيبُ سَفاً","وسَقَوني والقراراتُ وشَلْ",85,"ل",1,0],["أرتضعُ الدهرَ بها ضرورةً","يا سَرَعانَ ما فُطمتُ راضعا",86,"ع",2,0],["اِرتجِعْها يا دهرُ لا زلتَ تستَرْ","جِعُ لؤماً ما كنتَ أعطيتَ نَزْرا",87,"ر",2,0],["أرتك بدائعَها هِمّةٌ","تُهينُ عليك العظيمَ احتقارا",88,"ر",2,0],["أرتاحُ طوراً إلى ترجيعهِ طرباً","وأذكرُ العهدَ أحياناً فأبكيهِ",89,"ي",2,0],["أرتاحُ للريحِ إذا ماسرتْ","مشمولةً تُخبِرُني عنكمُ",90,"م",1,0],["ارتاب بالحنطة ما بين المدر","ولم يزل بين الرجاء والحذر",91,"ر",1,0],["أَرتاحُ هذا قَميصُ الوعدِ مسَّ به","على عُيونِ فُؤادي كفُّ مَحْبوبي",92,"ي",1,0],["أرتَوي مِن حَوضِ عِلمٍ","ولأَسفاري نَدِيمَه",93,"م",2,0],["أرَت كيفَ تُوفي المُخلصينَ حقُوقهم","وكيفَ تُجازِي من لها ليسَ يَجحَدُ",94,"د",1,0],["أَرَتْكَ بِذاتِ الضَّالِ منها مَعاصِماً","وخَدّاً أَسِيلاً كالوَذِلَةِ ناعِما",95,"م",2,0],["أرَتْني من خِلالِ السّجْفِ طَرْفاً","قرأتُ عليهِ إنَّ اللهَ حسْبي",96,"ي",1,0],["أَرَت مِن رَياحينِ الثَناءِ أَنيقَها","وَمِن زَهرِ الأَدابِ ما لَم يُخضَّدِ",97,"د",1,0],["أَرتْكَ يَدُ الغَيْثِ آثَارَهَا","وَأَعْلَنَتْ الأَرْضُ أَسْرَارَهَا",98,"ر",3,1],["أَرَتِ الشَماتَةُ بِالوَصِيَّ أُمَيَّةً","لا سَرَّها قَتلُ الوَصِيِّ وَلا شَقى",99,"ق",2,0],["أَرتْني بها الأَيَّامُ كلَّ عجيبةٍ","إِلى أَن جنيتُ النارَ من جَنَّة الخُلْدِ",100,"د",1,0]]}