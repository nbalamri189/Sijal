em.aspx?id=210906",""],[6127,"البشرى","https://www.poetsgate.com/ViewPoem.aspx?id=204472",""],[6149,"سبحان من صاغه وكون","https://www.poetsgate.com/ViewPoem.aspx?id=169628",""],[6167,"بيت الشجون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85564&r=&rc=47",""],[1583,"القبلة الأولى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73011&r=&rc=2",""],[6213,"سؤال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76275&r=&rc=32",""],[6237,"آذان الفجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77887&r=&rc=29",""],[4792,"جَمالٌ ينحتُ القصيدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86320&r=&rc=2",""],[6262,"بقسوةٍ رُبَّما قصدوها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80106&r=&rc=4",""],[6262,"لغةٌ أخرى لمرايا البحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80107&r=&rc=5",""],[6312,"البؤرُ المتحركةُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82949&r=&rc=4",""],[5567,"أبدو .. ولا أبدو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81749&r=&rc=21",""],[5567,"عتم الآهات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81816&r=&rc=66",""]],"verses":[["أَرتَضي بِالأَذى وَلَم يَقِفِ العَز","مُ قُصوراً وَلَم تَعِزُّ المَطِيُّ",0,"ي",1,0],["أَرتَقي غايَةَ الكُهو","لِ بِسِنِّ المُراهِقِ",1,"ق",1,0],["أَرتِق لَها فَتقَ النَوائِبِ بِالنَدى","أَو بِالقَنا وَلِكُلِّ خَرقٍ مَرقَعُ",2,"ع",1,0],["اِرتَضَعوا وَالعارَ مِن فيقَةٍ","وَنَزَعوا وَاللُئمُ مِن مَنزِعِ",3,"ع",1,0],["أَرتاحُ إِن أَخَذَ الصَفصافُ زينَتَهُ","مِنَ الرَبيعِ وَقالَ الرَكبُ قَد مُطِرا",4,"ر",2,1],["أرْتاحُ فيكَ للَوْمِ لُوّامي كَما","يرْتاحُ نجْديٌّ لشمِّ عَرارِ",5,"ر",1,0],["أَرتنا طباعَ الجود وهي وليدة","ولم ترضَ في الإحسان أَلاَّ تُغاليا",6,"ي",2,0],["أرتني سعودي ذلك اليوم أنه","برود نفوس حُلِّئت ونُقوعها",7,"ع",3,0],["أَرتاعُ إِن أَبصَرتُ واحِدَهُم","ذُعرَ الشُوَيهَةِ أَبصَرَت أَسَدا",8,"د",2,0],["ارتفعت عن العرا","قين به نوازل",9,"ل",1,0],["اِرتَدَ عَن مَصرَ هَزيماً جُندُهُ","يَشكو مِن الإِخشيدِ مُرَّ المُشتَكى",10,"ا",1,0],["اِرتَدَّتِ العاهاتُ عَن أَخلاقِهِ","لِسُمُوِّهِنَّ وَحَلَّتِ الأَعضاءَ",11,"ا",2,0],["اِرتَدى بُرنُسَهُ وَاِلتَثَما","وَخَطا خُطوَةَ شَيخٍ مُرعَسِ",12,"س",1,0],["أَرتاحُ إنْ لاحَ الوميضُ وأنثني","نشوانَ إن هبَّتْ عليَّ جَنُوبُ",13,"ب",1,0],["أَرتَجي عِندَهُ فَواضِلَ نُعمى","ما اِرتَجاها الشَمّاخُ عِندَ عَرابَه",14,"ب",2,0],["أَرتَجتَ لَمّا فَتَحوا بابَها","بِالسَيفِ صَلتاً أَيَّ إِرتاجِ",15,"ج",1,0],["إِرتِياحاً لِلطالِبينَ وَبَذلاً","وَالمَعالي لِلباذِلِ المُرتاحِ",16,"ح",1,0],["أرتك ملوك الروم رايات ملكهم","فأعملت في الروم الظبا والعواملا",17,"ل",2,0],["أَرَتْها الأَبعونَ هَشيمَ رَوْضٍ","وقبلَ الأربعينَ رَأَتْ رَبيعا",18,"ع",2,0],["أرَتْنا اللَّيالي قَصْدَها دونَ جَوْرِها","وشأنُ اللّيالي أن تجورَ وتَقْصِدا",19,"د",2,0],["اِرتاعَ يَذكُرُ مَشرَباً بِثِمادِهِ","مِن دونِهِ خُشُعٌ دَنونَ وَأَنقُبُ",20,"ب",1,0],["أَرَتكَ بِفَقدِ فَخرِ الدينِ رُزءاً","تُشَقُّ لَهُ المَرائِرُ لا الجُيوبُ",21,"ب",1,0],["أَرْتَاحُ إِنْ مَرَّ نَسِيمُ الصَّبَا","وَالْبُرْءُ لِي فِيهِ مَعَاً وَالسَّقَامْ",22,"م",1,0],["أرتجيها صفوة منكم وأن","زَعَموها بغيةً ليست تنال",23,"ل",1,0],["أرْتَجِي التَّوْبَةَ النَّصُوحَ وفِي القَلْ","بِ نفَاقٌ وفي اللسانِ رِياءُ",24,"ا",2,0],["أَرتاحُ لِلريحِ إِن هَبَّت يَمانِيَةً","وَأَنتَ عِندي رَخيمٌ غَيرُ مُرتاحِ",25,"ح",1,0],["اِرتَجَّ وَاِندَفَعَت تُعارِضُهُ","غَنّاءَ خالَطَ صَوتُها بُحَحا",26,"ح",2,0],["أَرَتكَ بِرُغمِ الأَنفِ سَيفَ اِبنِ ظالِمٍ","حَمائِلُهُ مَوصولَةٌ بِفَتى الحُمسِ",27,"س",1,0],["اِرتاحَت النَفسُ بِتَطهيرِها","وَرَبُّها قاضٍ بِتَدنيسِها",28,"س",3,1],["ارتحل عن بلد","أَنت فيه مهملُ",29,"ل",1,1],["اِرتاب في نبأ به","يفضي إليَّ المخبر",30,"ر",1,0],["اِرتقت سلم التقدم ناس","ووقفنا في أَسفل الدرجات",31,"ت",1,0],["أرتهُ السماءُ أعاجيبَها","ورَوَّتهُ من كلِّ فنٍّ بديعْ",32,"ع",1,0],["أرتك عم رسول الله منتقباً","أبا حذيفة يحكي أو أبا حمل",33,"ل",1,0],["أَرْتَاحُ إِنْ مَرَّ مِنْ تِلْقَائِهِمْ نَسَمٌ","تَسْرِي بِهِ فِي أَرِيجِ الْعَنْبَرِ الأُصُلُ",34,"ل",1,0],["أَرَتِ النِّهَايَةَ فِي تَجِلَّةِ أُمَّةٍ","لِمُلُوكِهَا مَا أَخْلَصُوا وَأَفَادُوا",35,"د",3,0],["أَرَتْنَا وُجُوه الحَقِّ فِي كُلِّ مُعْضِلٍ","وَمِنْ دُوِنهَا الاسْتَارُ مُحْكَمَةُ السَّبْلِ",36,"ل",1,0],["أَرَتْنِيَ الدنْيَا وَبِي","عَنْهَا جَلاَلٌ وَكِبَرْ",37,"ر",1,0],["ارتاعَ قرصانهُ وساستهُ","وأعوَلت من رياحه جزره",38,"ر",2,0],["ارتاح فيها الى \"خل\" فيبهرني","صدق وقصد ومعروف وعرفان",39,"ن",1,0],["ارتنى هدى زيد وفي العلم قلة","وضلة عمرو والعلوم بحور",40,"ر",1,0],["أرتهُمُ خيرَ ما في السّحْرِ من بُدءٍ","وأضمرتْ شَرَّ ما قد أضمرتْ عُقبا",41,"ب",2,0],["أَرَتها المَآقي ما تُكِنُّ الجَوانِحُ","فَبُح فالمُعَنّى بِالصَّبابَةِ بائِحُ",42,"ح",1,1],["أرَتني دِيارَ الحَيِّ قَومي وَدُونَها","وِهادٌ وَأَطوادٌ عَلَت وَرِمالُ",43,"ل",1,0],["أرتل قرآناً عن العشق فاتناً","وللعشق في روحي كتاب منزّل",44,"ل",1,0],["أرت أم عباس أعجوبة","تضل كبير الحجى بالودع",45,"ع",1,1],["أَرَتْهُمُوني قليلا هِمّةٌ بَلغتْ","بِحَيْثُ لا يَنْتهيه الهَمُّ والهمَمُ",46,"م",1,0],["أرَتني التَّجاربُ ما قد بَدَا","فقِسْتُ بِه كلَّ ما قد خَفا",47,"ا",1,0],["أَرتَجي فَضلَ ناقِصٍ وَأُداري","كُلَّ جِنسٍ ما في سَجاياهُ لينُ",48,"ن",1,0],["أرتنا حياضَ الموتِ ليلى وراقنا","عُيونٌ نقّياتُ الحواشي تُديرُها",49,"ر",3,0],["أرتاحُ إن ذكرَ العذيبُ وبارقٌ","شوقاً إليه وكيف لا أرتاحُ",50,"ح",1,0],["أَرت مَساعيك سُبلَ المَجدِ جاهِلَها","فَلَو سَعى كانَ أَيضاً مِن مَساعيكا",51,"ك",2,0],["ارتك سماء الحسن تبدو بروجها","جهاراً ولا تبدو جهاراً بدورها",52,"ر",3,0],["ارتنا المعالي فيك كل غريبة","ولم تزل الأيام تدبي الغرائبا",53,"ب",2,0],["أرتنا الليالي حاليات ضيعها","فلما اختبرناهن كان تصنعا",54,"ع",2,0],["اِرتَضاه اللَه نوراللهدى","واِنتضاه لدم الاعدا حساما",55,"م",2,0],["أَرتاحُ إِن لاحَ بَريقُ الحِمى","إِلى عُرَيبٍ ثَمَّ نائينا",56,"ن",2,0],["أَرتاحُ وَجداً كُلَّما","غَنَّت عَلى البانِ الحَمامُ",57,"م",1,0],["أَرتاحُ أَن يَسري إِلَيَّ خَيالُهُم","لَيلاً وَكُلُّ مُتَيَّمٍ يَرتاحُ",58,"ح",1,0],["أَرَتكَ بِذاتِ الضالِ مِنها مَعاصِماً","وَخَدّاً أَسيلاً كَالوَذيلَةِ ناعِما",59,"م",2,1],["أرتنيها المحبةُ بيتَ نارٍ","يلوح (لموبذ) وَهْناً سناها",60,"ا",3,0],["ارتاض قلبي فيكم وارتضى","أن ينقضي الود وأن ينقضا",61,"ض",2,1],["ارتاد منها ملياً لا يماطلني","وعداً وأرجو كريماً لا يعنيني",62,"ن",2,0],["أُرَتّل أشعاري حنيناً وصبوةً","وأسكب روحي في الظلام مراثيا",63,"ي",2,0],["أَرَتنا حِياضَ المَوتِ ثُمَّتَ قَلَّبَت","لَنا مُقلَةً كَحلاءَ ظَلَّت تُديرُها",64,"ر",3,0],["ارتل الشعر في جوف الدجى صوراً","من الخيال عليها لوعة الشاكي",65,"ك",2,0],["أَرَتْني هَناً يَملأُ الرَّاحَتينِ","وَأُخفِي هَناً لي فَرْطَ الصِّغَرْ",66,"ر",1,1],["أرَتْهُ من الأيّامِ عزّةُ نَفْسِه","سَواءً بعَيْنَيهِ الوِلايةَ والعَزْلا",67,"ل",2,0],["أرتَجِي منكَ ما يُرجَّى منَ الغَيْ","ث إذا سَحَّ وهْو داني النَّشاص",68,"ص",1,0],["أرتعُ في زَهرِها وأذكرُ ما","يذكرُه الناسُ عن أبي طاهِر",69,"ر",1,0],["أرته اللّيالي كلَّ مستقبلٍ ذاهب","وأعلَمنه أنّ النوى للنوى صاحِب",70,"ب",1,1],["أرتّبُ الحُلْمَ روضا في تَوَرُدّهِ","فيُصبحُ الحلمُ روضا في مُعَادَلتي",71,"ت",2,0],["أرتك المزايا البيض حتى تحسرت","أرتك المنايا السود بالأسيُفِ الحمر",72,"ر",1,0],["أَرتَجي مِن يَد الحَما اِنفِلاتاً","وَهَوى الشَوق بِالرَدى مَقرون",73,"ن",1,0],["أرتجيكم يا رجائي","بالفضائل تعمروني",74,"ن",2,0],["أرتضي تعذيب قلبي في الهوى","ليس قلبي عنكم منقلبا",75,"ب",2,0],["أرتهم العبر الدنيا فما اعتبروا","فصيرتهم لقوم بعدهم عبرا",76,"ر",2,0],["أَرتْه غِرَّتُه في الهَجْر مَصْلَحتي","جهلاً فأفسدَ منِّي كلَّ ما صَلَحا",77,"ح",2,1],["أرتقي فيه العُلى لم أتخذ","مَدْحَه للمجد إلاَّ سلَّما",78,"م",2,0],["أرَتني من حوادثها اللَّيالي","أعاجيباً لها العَبرات تدمى",79,"م",2,0],["أرَته زينةَ الأمجاد تزهو","بأرديةِ المحاسن فارتداها",80,"ا",3,0],["أرتنا المنايا كيف تُصمي سهامها","وكيف تصول النائبات وتجتري",81,"ر",2,0],["أرَتْك صِدْقَ مَوَدَّات الرجال بها","وبانَ عِندَك صِدْقُ القولِ والزُّورُ",82,"ر",1,0],["ارتنا كثيياً فوقه خيزرانة","بروحي تلك الخيزرانة والخال",83,"ل",1,0],["أرتني من السحر المبين معانياً","وما كنت أدري الشحر من قبلها حقا",84,"ق",2,0],["ارتنا من الأجفان سحرا كأنه","أساطير عبد الله ذي القلم البحري",85,"ر",2,0],["أرتجي الطيف أن يلمّ ومن أع","جب شيء زور الخيال الطروق",86,"ق",1,0],["أرتنا به ظمياءُ وصلا مموّها","على سفهِ المسرَى وزُوراً مميَّنا",87,"ن",2,0],["أرتعوني والأنابيبُ سَفاً","وسَقَوني والقراراتُ وشَلْ",88,"ل",1,0],["أرتضعُ الدهرَ بها ضرورةً","يا سَرَعانَ ما فُطمتُ راضعا",89,"ع",2,0],["اِرتجِعْها يا دهرُ لا زلتَ تستَرْ","جِعُ لؤماً ما كنتَ أعطيتَ نَزْرا",90,"ر",2,0],["أرتك بدائعَها هِمّةٌ","تُهينُ عليك العظيمَ احتقارا",91,"ر",2,0],["أرتاحُ طوراً إلى ترجيعهِ طرباً","وأذكرُ العهدَ أحياناً فأبكيهِ",92,"ي",2,0],["أرتاحُ للريحِ إذا ماسرتْ","مشمولةً تُخبِرُني عنكمُ",93,"م",1,0],["ارتاب بالحنطة ما بين المدر","ولم يزل بين الرجاء والحذر",94,"ر",1,0],["أَرتاحُ هذا قَميصُ الوعدِ مسَّ به","على عُيونِ فُؤادي كفُّ مَحْبوبي",95,"ب",2,0],["أرتَوي مِن حَوضِ عِلمٍ","ولأَسفاري نَدِيمَه",96,"م",2,0],["أرَت كيفَ تُوفي المُخلصينَ حقُوقهم","وكيفَ تُجازِي من لها ليسَ يَجحَدُ",97,"د",1,0],["أَرَتْكَ بِذاتِ الضَّالِ منها مَعاصِماً","وخَدّاً أَسِيلاً كالوَذِلَةِ ناعِما",98,"م",2,0],["أرَتْني من خِلالِ السّجْفِ طَرْفاً","قرأتُ عليهِ إنَّ اللهَ حسْبي",99,"ب",2,0],["أَرَت مِن رَياحينِ الثَناءِ أَنيقَها","وَمِن زَهرِ الأَدابِ ما لَم يُخضَّدِ",100,"د",1,0],["أَرتْكَ يَدُ الغَيْثِ آثَارَهَا","وَأَعْلَنَتْ الأَرْضُ أَسْرَارَهَا",101,"ر",3,1],["أَرَتِ الشَماتَةُ بِالوَصِيَّ أُمَيَّةً","لا سَرَّها قَتلُ الوَصِيِّ وَلا شَقى",102,"ق",2,0],["أَرتْني بها الأَيَّامُ كلَّ عجيبةٍ","إِلى أَن جنيتُ النارَ من جَنَّة الخُلْدِ",103,"د",1,0],["أرتاح للأقمار وهي طوالع","وشموس راح للمغارب تجنح",104,"ح",1,1],["ارتاعَ طاوُوسُ الجما","ل فَمَدَّ أجْنِحةً وطارْ",105,"ر",1,0],["أرتنا الليالي جمرة في فؤادها","علينا فقلنا من نداه تبرد",106,"د",1,0],["أرتل آيات المديح مبكراً","وخير الطيور المطربات المُبَكِّر",107,"ر",1,0],["أَرتَجي أَن يرى أَباً ثمَّ جَدّاً","وَأَبوهُ مَديدُ عمرٍ طويلُ",108,"ل",1,0],["أَرتَجي الوَصلَ لَم أَزَل مُستَعيذاً","مِن عَذولي إِذ عاذِلي شَيطانُ",109,"ن",1,0],["أرَتنا شموساً في الكؤوس تطلّعت","بمقلة حورٍ قد عُدِمنَ منَ أفولا",110,"ل",2,0],["أرتنا بك الأقدار كيف اقتدارها","وكيف ابتكار الخطب يطرق مفزعا",111,"ع",2,0],["أَرتع في الخَلا مَع الغُزلان","وَأَتَّقي مَجالِسَ الإِنسان",112,"ن",1,0],["أرتد عن ظلمات يأسي خارقا","بحجارة الغضب الوليد حصاره",113,"ر",2,0],["أ