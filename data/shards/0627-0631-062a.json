{"poems":[[55,"ما مقامي على الهوان وعندي","https://www.aldiwan.net/poem29624.html","الخفيف"],[55,"سيدي أنت ليس كلل","https://www.aldiwan.net/poem29953.html","مجزوء الخفيف"],[55,"تمضي العلى وإلى ذراكم ترجع","https://www.aldiwan.net/poem30156.html","الكامل"],[55,"ألهاك عنا ربة البرقع","https://www.aldiwan.net/poem30157.html","السريع"],[55,"أرتاح إن أخذ الصفصاف زينته","https://www.aldiwan.net/poem30436.html","البسيط"],[79,"نفحت فشبت لافح التذكار","https://www.aldiwan.net/poem36518.html","الكامل"],[85,"سل الأفق بالزهر الكواكب حاليا","https://www.aldiwan.net/poem54224.html","الطويل"],[53,"أغر مخيلات الأماني لموعها","https://www.aldiwan.net/poem65406.html","الطويل"],[93,"قالت سكت وما سكت سدى","https://www.aldiwan.net/poem8813.html","عموديه"],[91,"ليس البليد الجاهل","https://www.aldiwan.net/poem45078.html","مجزوء الرجز"],[87,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[87,"اجعل رثاءك للرجال جزاء","https://www.aldiwan.net/poem62936.html","الكامل"],[87,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[64,"لا أدعي أني وفيت بعهدكم","https://www.aldiwan.net/poem52494.html","الكامل"],[47,"أن دعاه داعي الصبا فأجابه","https://www.aldiwan.net/poem10667.html","الخفيف"],[47,"مخبرتي برقة أحواج","https://www.aldiwan.net/poem62672.html","السريع"],[47,"هين ما يقول فيك اللاحي","https://www.aldiwan.net/poem62696.html","الخفيف"],[63,"كملن فأطلعن البدور كواملا","https://www.aldiwan.net/poem51486.html","الطويل"],[63,"يروع هجرها قلبا مروعا","https://www.aldiwan.net/poem51573.html","الوافر"],[63,"أناشد دهري أن يعود كما بدا","https://www.aldiwan.net/poem51709.html","الطويل"],[2,"شطت أميمة بعدما صقبت","https://www.aldiwan.net/poem25042.html","الكامل"],[68,"كذا فليصبر الرجل النجيب","https://www.aldiwan.net/poem40117.html","الوافر"],[89,"يا ناعس الطرف إلى كم تنام","https://www.aldiwan.net/poem8287.html","السريع"],[92,"‏كل ما في الكون حب وجمال","https://www.aldiwan.net/poem26553.html","الرمل"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[52,"دعني أمت بالهوى لا يلحني لاح","https://www.aldiwan.net/poem63970.html","البسيط"],[52,"قاس الهموم تنل بها نجحا","https://www.aldiwan.net/poem63980.html","الكامل"],[48,"إذا ما غضوب غاضبت كل ريبة","https://www.aldiwan.net/poem22817.html","الطويل"],[48,"ارتاحت النفس بتطهيرها","https://www.aldiwan.net/poem22848.html","السريع"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85750","الرمل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85374","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85555","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/147472","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42734","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54727","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55168","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54327","المنسرح"],[111,"تلك البوارق حاديهن مرنان","https://www.poetsgate.com/ViewPoem.aspx?id=100",""],[111,"سميري وهل للمستهام سميرُ ( النهروانية )","https://www.poetsgate.com/ViewPoem.aspx?id=511",""],[92,"أبو العلاء المعري","https://www.poetsgate.com/ViewPoem.aspx?id=179199",""],[173,"أرتها المآقي ما تكن الجوانح","https://www.aldiwan.net/poem1611.html",""],[173,"سما لك من أم العبيد خيال","https://www.aldiwan.net/poem1660.html",""],[215,"أسافر في يوم الثلاثاء ليتني","https://www.aldiwan.net/poem46608.html","الطويل"],[225,"أرت أم عباس أعجوبة","https://www.aldiwan.net/poem55282.html","المتقارب"],[233,"تميط الأذى عن حامليها الصوارم","https://www.aldiwan.net/poem50832.html","الطويل"],[233,"أعذلا وما عذلتني النهى","https://www.aldiwan.net/poem51276.html","المتقارب"],[239,"وخيال سرى إلي فأدنا","https://www.aldiwan.net/poem31738.html","الخفيف"],[250,"نأتك بليلى دارها لا تزورها","https://www.aldiwan.net/poem56333.html","الطويل"],[254,"ألقت أشعتها عليك الراح","https://www.aldiwan.net/poem14939.html","الكامل"],[256,"أما كفاك تلافي في تلافيكما","https://www.aldiwan.net/poem1474.html",""],[265,"نعم هذه الزوراء لاحت قصورها","https://www.aldiwan.net/poem38136.html","الطويل"],[265,"لقد آن إعراضي عن الغي جانبا","https://www.aldiwan.net/poem38364.html","الطويل"],[265,"سقاك الحيا ريا وحياك أربعا","https://www.aldiwan.net/poem38378.html","الطويل"],[275,"عاهدوا الربع ولوعا وغراما","https://www.aldiwan.net/poem52089.html","الرمل"],[286,"حي على أثلات يبرينا","https://www.aldiwan.net/poem32396.html","السريع"],[286,"غبتم فلم يغب الغرام","https://www.aldiwan.net/poem32469.html","مجزوء الكامل"],[286,"سري بألسنة الدموع يباح","https://www.aldiwan.net/poem32814.html","الكامل"],[291,"أرتك بذات الضال منها معاصماً","https://www.aldiwan.net/poem1893.html","الطويل"],[302,"أدال الله (جلق) من عداها","https://www.aldiwan.net/poem36817.html","عموديه"],[307,"ارتاض قلبي فيكم وارتضى","https://www.aldiwan.net/poem58103.html","السريع"],[314,"حي المعاهد كانت قبل تحييني","https://www.aldiwan.net/poem59516.html","البسيط"],[332,"أأبكى هوى أم فرحة أم أمانيا","https://www.aldiwan.net/poem55003.html","الطويل"],[341,"عفت ذروة من أهلها فجفيرها","https://www.aldiwan.net/poem45429.html","الطويل"],[346,"يا ظبية البان ما رددت ذكراك","https://www.aldiwan.net/poem55313.html","البسيط"],[352,"أرتني هنا يملأ الراحتين","https://www.aldiwan.net/poem20368.html","المتقارب"],[368,"أصح عيون البابلية ما اعتلا","https://www.aldiwan.net/poem60796.html","الطويل"],[368,"روحا ساعة متون القلاص","https://www.aldiwan.net/poem60864.html","الخفيف"],[375,"حتى متى كل مشتك زاجر","https://www.aldiwan.net/poem57427.html","المنسرح"],[375,"أرته الليالي كل مستقبل ذاهب","https://www.aldiwan.net/poem57531.html","الطويل"],[380,"حبيبتي دبي","https://www.aldiwan.net/poem965.html","عموديه"],[381,"أيا أغنياء الروح صونوا كنوزَكم","https://www.aldiwan.net/poem59426.html","الطويل"],[384,"لمن العيس تختفي وتبين","https://www.aldiwan.net/poem49253.html","الخفيف"],[395,"أدركوني أدركوني","https://www.aldiwan.net/poem54460.html","عموديه"],[407,"مرحبا يا مرحبا يا مرحبا بنسيم","https://www.aldiwan.net/poem34146.html","الرمل"],[413,"سل المدائن عمن كان يملكها","https://www.aldiwan.net/poem31702.html","عموديه"],[413,"أرته غرته في الهجر مصلحتي","https://www.aldiwan.net/poem32605.html","البسيط"],[420,"شام برقا راعه مبتسما","https://www.aldiwan.net/poem53999.html","الرمل"],[420,"سقى الطلل الغمام وجاد رسما","https://www.aldiwan.net/poem54028.html","الوافر"],[420,"أنيخاها فقد بلغت مناها","https://www.aldiwan.net/poem54083.html","الوافر"],[420,"بكت بدم من بعد عيسى وبندر","https://www.aldiwan.net/poem54120.html","الطويل"],[420,"حييت من قادم حل السرور به","https://www.aldiwan.net/poem54138.html","البسيط"],[433,"أمن خدها الوردي افتنك الخال","https://www.aldiwan.net/poem40062.html","الطويل"],[433,"أتت مثل خوط البان تهتز أو أرقى","https://www.aldiwan.net/poem40712.html","الطويل"],[433,"يهيجني تذكار خل كما البدر","https://www.aldiwan.net/poem41069.html","الطويل"],[441,"إن داراً بين اللوى والعفيق","https://www.aldiwan.net/poem2547.html","الخفيف"],[461,"أمنك خيال ضوع الركب موهنا","https://www.aldiwan.net/poem55831.html","الطويل"],[461,"أتمنى والمنى جهد المقل","https://www.aldiwan.net/poem55996.html","الرمل"],[461,"آنس برقا بالشريف لامعا","https://www.aldiwan.net/poem56123.html","الرجز"],[461,"حيها أوجها على السفح غرا","https://www.aldiwan.net/poem56191.html","الخفيف"],[461,"نديمي وما الناس إلا السكارى","https://www.aldiwan.net/poem56204.html","المتقارب"],[480,"ربع وقفت عليه بعد أهليه","https://www.aldiwan.net/poem15251.html","البسيط"],[480,"آليت لا حلت ولا حلتم","https://www.aldiwan.net/poem15270.html","السريع"],[496,"ذو قصر أحدب من غير كبر","https://www.aldiwan.net/poem67295.html","عموديه"],[503,"جاء البشير ليعقوبي بيوسفه","https://www.aldiwan.net/poem38078.html","البسيط"],[541,"أنا من اسمى نعيمه","https://www.aldiwan.net/poem47933.html","عموديه"],[541,"عرفت مقام القوم إذ بت تجهد","https://www.aldiwan.net/poem48236.html","عموديه"],[549,"ألا يا اسلمي لا صرم لي اليوم فاطما","https://www.aldiwan.net/poem1864.html","الطويل"],[565,"أطوف الأرض في شرق وغرب","https://www.aldiwan.net/poem52849.html","الوافر"],[566,"أثار الهوى سجع الحمام المغرد","https://www.aldiwan.net/poem13598.html","الطويل"],[570,"أرتك يد الغيث آثارها","https://www.aldiwan.net/poem69674.html","المتقارب"],[576,"يا برق برقاً بين مروة والصفا","https://www.aldiwan.net/poem3646.html","الكامل"],[578,"لقد ذهبت نفسي وقد صفرت يدي","https://www.aldiwan.net/poem2970.html","الطويل"],[845,"","https://poetry.dctabudhabi.ae/diwan/poem/21465","الطويل"],[845,"","https://poetry.dctabudhabi.ae/diwan/poem/21442","الطويل"],[913,"","https://poetry.dctabudhabi.ae/diwan/poem/31512","الطويل"]],"verses":[["أَرتَضي بِالأَذى وَلَم يَقِفِ العَز","مُ قُصوراً وَلَم تَعِزُّ المَطِيُّ",0,"ي",1,0],["أَرتَقي غايَةَ الكُهو","لِ بِسِنِّ المُراهِقِ",1,"ق",1,0],["أَرتِق لَها فَتقَ النَوائِبِ بِالنَدى","أَو بِالقَنا وَلِكُلِّ خَرقٍ مَرقَعُ",2,"ع",1,0],["اِرتَضَعوا وَالعارَ مِن فيقَةٍ","وَنَزَعوا وَاللُئمُ مِن مَنزِعِ",3,"ع",1,0],["أَرتاحُ إِن أَخَذَ الصَفصافُ زينَتَهُ","مِنَ الرَبيعِ وَقالَ الرَكبُ قَد مُطِرا",4,"ر",2,1],["أرْتاحُ فيكَ للَوْمِ لُوّامي كَما","يرْتاحُ نجْديٌّ لشمِّ عَرارِ",5,"ر",1,0],["أَرتنا طباعَ الجود وهي وليدة","ولم ترضَ في الإحسان أَلاَّ تُغاليا",6,"ي",2,0],["أرتني سعودي ذلك اليوم أنه","برود نفوس حُلِّئت ونُقوعها",7,"ع",3,0],["أَرتاعُ إِن أَبصَرتُ واحِدَهُم","ذُعرَ الشُوَيهَةِ أَبصَرَت أَسَدا",8,"د",2,0],["ارتفعت عن العرا","قين به نوازل",9,"ل",1,0],["اِرتَدَ عَن مَصرَ هَزيماً جُندُهُ","يَشكو مِن الإِخشيدِ مُرَّ المُشتَكى",10,"ا",1,0],["اِرتَدَّتِ العاهاتُ عَن أَخلاقِهِ","لِسُمُوِّهِنَّ وَحَلَّتِ الأَعضاءَ",11,"ا",2,0],["اِرتَدى بُرنُسَهُ وَاِلتَثَما","وَخَطا خُطوَةَ شَيخٍ مُرعَسِ",12,"س",1,0],["أَرتاحُ إنْ لاحَ الوميضُ وأنثني","نشوانَ إن هبَّتْ عليَّ جَنُوبُ",13,"ب",1,0],["أَرتَجي عِندَهُ فَواضِلَ نُعمى","ما اِرتَجاها الشَمّاخُ عِندَ عَرابَه",14,"ب",2,0],["أَرتَجتَ لَمّا فَتَحوا بابَها","بِالسَيفِ صَلتاً أَيَّ إِرتاجِ",15,"ج",1,0],["إِرتِياحاً لِلطالِبينَ وَبَذلاً","وَالمَعالي لِلباذِلِ المُرتاحِ",16,"ح",1,0],["أرتك ملوك الروم رايات ملكهم","فأعملت في الروم الظبا والعواملا",17,"ل",2,0],["أَرَتْها الأَبعونَ هَشيمَ رَوْضٍ","وقبلَ الأربعينَ رَأَتْ رَبيعا",18,"ع",2,0],["أرَتْنا اللَّيالي قَصْدَها دونَ جَوْرِها","وشأنُ اللّيالي أن تجورَ وتَقْصِدا",19,"د",2,0],["اِرتاعَ يَذكُرُ مَشرَباً بِثِمادِهِ","مِن دونِهِ خُشُعٌ دَنونَ وَأَنقُبُ",20,"ب",1,0],["أَرَتكَ بِفَقدِ فَخرِ الدينِ رُزءاً","تُشَقُّ لَهُ المَرائِرُ لا الجُيوبُ",21,"ب",1,0],["أَرْتَاحُ إِنْ مَرَّ نَسِيمُ الصَّبَا","وَالْبُرْءُ لِي فِيهِ مَعَاً وَالسَّقَامْ",22,"م",1,0],["أرتجيها صفوة منكم وأن","زَعَموها بغيةً ليست تنال",23,"ل",1,0],["أرْتَجِي التَّوْبَةَ النَّصُوحَ وفِي القَلْ","بِ نفَاقٌ وفي اللسانِ رِياءُ",24,"ا",2,0],["أَرتاحُ لِلريحِ إِن هَبَّت يَمانِيَةً","وَأَنتَ عِندي رَخيمٌ غَيرُ مُرتاحِ",25,"ح",1,0],["اِرتَجَّ وَاِندَفَعَت تُعارِضُهُ","غَنّاءَ خالَطَ صَوتُها بُحَحا",26,"ح",2,0],["أَرَتكَ بِرُغمِ الأَنفِ سَيفَ اِبنِ ظالِمٍ","حَمائِلُهُ مَوصولَةٌ بِفَتى الحُمسِ",27,"س",1,0],["اِرتاحَت النَفسُ بِتَطهيرِها","وَرَبُّها قاضٍ بِتَدنيسِها",28,"س",3,1],["ارتحل عن بلد","أَنت فيه مهملُ",29,"ل",1,1],["اِرتاب في نبأ به","يفضي إليَّ المخبر",30,"ر",1,0],["اِرتقت سلم التقدم ناس","ووقفنا في أَسفل الدرجات",31,"ت",1,0],["أرتهُ السماءُ أعاجيبَها","ورَوَّتهُ من كلِّ فنٍّ بديعْ",32,"ع",1,0],["أرتك عم رسول الله منتقباً","أبا حذيفة يحكي أو أبا حمل",33,"ل",1,0],["أَرْتَاحُ إِنْ مَرَّ مِنْ تِلْقَائِهِمْ نَسَمٌ","تَسْرِي بِهِ فِي أَرِيجِ الْعَنْبَرِ الأُصُلُ",34,"ل",1,0],["أَرَتِ النِّهَايَةَ فِي تَجِلَّةِ أُمَّةٍ","لِمُلُوكِهَا مَا أَخْلَصُوا وَأَفَادُوا",35,"د",3,0],["أَرَتْنَا وُجُوه الحَقِّ فِي كُلِّ مُعْضِلٍ","وَمِنْ دُوِنهَا الاسْتَارُ مُحْكَمَةُ السَّبْلِ",36,"ل",1,0],["أَرَتْنِيَ الدنْيَا وَبِي","عَنْهَا جَلاَلٌ وَكِبَرْ",37,"ر",1,0],["ارتاعَ قرصانهُ وساستهُ","وأعوَلت من رياحه جزره",38,"ر",2,0],["ارتاح فيها الى \"خل\" فيبهرني","صدق وقصد ومعروف وعرفان",39,"ن",1,0],["ارتنى هدى زيد وفي العلم قلة","وضلة عمرو والعلوم بحور",40,"ر",1,0],["أرتهُمُ خيرَ ما في السّحْرِ من بُدءٍ","وأضمرتْ شَرَّ ما قد أضمرتْ عُقبا",41,"ب",2,0],["أَرَتها المَآقي ما تُكِنُّ الجَوانِحُ","فَبُح فالمُعَنّى بِالصَّبابَةِ بائِحُ",42,"ح",1,1],["أرَتني دِيارَ الحَيِّ قَومي وَدُونَها","وِهادٌ وَأَطوادٌ عَلَت وَرِمالُ",43,"ل",1,0],["أرتل قرآناً عن العشق فاتناً","وللعشق في روحي كتاب منزّل",44,"ل",1,0],["أرت أم عباس أعجوبة","تضل كبير الحجى بالودع",45,"ع",1,1],["أَرَتْهُمُوني قليلا هِمّةٌ بَلغتْ","بِحَيْثُ لا يَنْتهيه الهَمُّ والهمَمُ",46,"م",1,0],["أرَتني التَّجاربُ ما قد بَدَا","فقِسْتُ بِه كلَّ ما قد خَفا",47,"ا",1,0],["أَرتَجي فَضلَ ناقِصٍ وَأُداري","كُلَّ جِنسٍ ما في سَجاياهُ لينُ",48,"ن",1,0],["أرتنا حياضَ الموتِ ليلى وراقنا","عُيونٌ نقّياتُ الحواشي تُديرُها",49,"ر",3,0],["أرتاحُ إن ذكرَ العذيبُ وبارقٌ","شوقاً إليه وكيف لا أرتاحُ",50,"ح",1,0],["أَرت مَساعيك سُبلَ المَجدِ جاهِلَها","فَلَو سَعى كانَ أَيضاً مِن مَساعيكا",51,"ك",2,0],["ارتك سماء الحسن تبدو بروجها","جهاراً ولا تبدو جهاراً بدورها",52,"ر",3,0],["ارتنا المعالي فيك كل غريبة","ولم تزل الأيام تدبي الغرائبا",53,"ب",2,0],["أرتنا الليالي حاليات ضيعها","فلما اختبرناهن كان تصنعا",54,"ع",2,0],["اِرتَضاه اللَه نوراللهدى","واِنتضاه لدم الاعدا حساما",55,"م",2,0],["أَرتاحُ إِن لاحَ بَريقُ الحِمى","إِلى عُرَيبٍ ثَمَّ نائينا",56,"ن",2,0],["أَرتاحُ وَجداً كُلَّما","غَنَّت عَلى البانِ الحَمامُ",57,"م",1,0],["أَرتاحُ أَن يَسري إِلَيَّ خَيالُهُم","لَيلاً وَكُلُّ مُتَيَّمٍ يَرتاحُ",58,"ح",1,0],["أَرَتكَ بِذاتِ الضالِ مِنها مَعاصِماً","وَخَدّاً أَسيلاً كَالوَذيلَةِ ناعِما",59,"م",2,1],["أرتنيها المحبةُ بيتَ نارٍ","يلوح (لموبذ) وَهْناً سناها",60,"ا",3,0],["ارتاض قلبي فيكم وارتضى","أن ينقضي الود وأن ينقضا",61,"ض",2,1],["ارتاد منها ملياً لا يماطلني","وعداً وأرجو كريماً لا يعنيني",62,"ن",2,0],["أُرَتّل أشعاري حنيناً وصبوةً","وأسكب روحي في الظلام مراثيا",63,"ي",2,0],["أَرَتنا حِياضَ المَوتِ ثُمَّتَ قَلَّبَت","لَنا مُقلَةً كَحلاءَ ظَلَّت تُديرُها",64,"ر",3,0],["ارتل الشعر في جوف الدجى صوراً","من الخيال عليها لوعة الشاكي",65,"ك",2,0],["أَرَتْني هَناً يَملأُ الرَّاحَتينِ","وَأُخفِي هَناً لي فَرْطَ الصِّغَرْ",66,"ر",1,1],["أرَتْهُ من الأيّامِ عزّةُ نَفْسِه","سَواءً بعَيْنَيهِ الوِلايةَ والعَزْلا",67,"ل",2,0],["أرتَجِي منكَ ما يُرجَّى منَ الغَيْ","ث إذا سَحَّ وهْو داني النَّشاص",68,"ص",1,0],["أرتعُ في زَهرِها وأذكرُ ما","يذكرُه الناسُ عن أبي طاهِر",69,"ر",1,0],["أرته اللّيالي كلَّ مستقبلٍ ذاهب","وأعلَمنه أنّ النوى للنوى صاحِب",70,"ب",1,1],["أرتّبُ الحُلْمَ روضا في تَوَرُدّهِ","فيُصبحُ الحلمُ روضا في مُعَادَلتي",71,"ت",2,0],["أرتك المزايا البيض حتى تحسرت","أرتك المنايا السود بالأسيُفِ الحمر",72,"ر",1,0],["أَرتَجي مِن يَد الحَما اِنفِلاتاً","وَهَوى الشَوق بِالرَدى مَقرون",73,"ن",1,0],["أرتجيكم يا رجائي","بالفضائل تعمروني",74,"ن",2,0],["أرتضي تعذيب قلبي في الهوى","ليس قلبي عنكم منقلبا",75,"ب",2,0],["أرتهم العبر الدنيا فما اعتبروا","فصيرتهم لقوم بعدهم عبرا",76,"ر",2,0],["أَرتْه غِرَّتُه في الهَجْر مَصْلَحتي","جهلاً فأفسدَ منِّي كلَّ ما صَلَحا",77,"ح",2,1],["أرتقي فيه العُلى لم أتخذ","مَدْحَه للمجد إلاَّ سلَّما",78,"م",2,0],["أرَتني من حوادثها اللَّيالي","أعاجيباً لها العَبرات تدمى",79,"م",2,0],["أرَته زينةَ الأمجاد تزهو","بأرديةِ المحاسن فارتداها",80,"ا",3,0],["أرتنا المنايا كيف تُصمي سهامها","وكيف تصول النائبات وتجتري",81,"ر",2,0],["أرَتْك صِدْقَ مَوَدَّات الرجال بها","وبانَ عِندَك صِدْقُ القولِ والزُّورُ",82,"ر",1,0],["ارتنا كثيياً فوقه خيزرانة","بروحي تلك الخيزرانة والخال",83,"ل",1,0],["أرتني من السحر المبين معانياً","وما كنت أدري الشحر من قبلها حقا",84,"ق",2,0],["ارتنا من الأجفان سحرا كأنه","أساطير عبد الله ذي القلم البحري",85,"ر",2,0],["أرتجي الطيف أن يلمّ ومن أع","جب شيء زور الخيال الطروق",86,"ق",1,0],["أرتنا به ظمياءُ وصلا مموّها","على سفهِ المسرَى وزُوراً مميَّنا",87,"ن",2,0],["أرتعوني والأنابيبُ سَفاً","وسَقَوني والقراراتُ وشَلْ",88,"ل",1,0],["أرتضعُ الدهرَ بها ضرورةً","يا سَرَعانَ ما فُطمتُ راضعا",89,"ع",2,0],["اِرتجِعْها يا دهرُ لا زلتَ تستَرْ","جِعُ لؤماً ما كنتَ أعطيتَ نَزْرا",90,"ر",2,0],["أرتك بدائعَها هِمّةٌ","تُهينُ عليك العظيمَ احتقارا",91,"ر",2,0],["أرتاحُ طوراً إلى ترجيعهِ طرباً","وأذكرُ العهدَ أحياناً فأبكيهِ",92,"ي",2,0],["أرتاحُ للريحِ إذا ماسرتْ","مشمولةً تُخبِرُني عنكمُ",93,"م",1,0],["ارتاب بالحنطة ما بين المدر","ولم يزل بين الرجاء والحذر",94,"ر",1,0],["أَرتاحُ هذا قَميصُ الوعدِ مسَّ به","على عُيونِ فُؤادي كفُّ مَحْبوبي",95,"ب",2,0],["أرتَوي مِن حَوضِ عِلمٍ","ولأَسفاري نَدِيمَه",96,"م",2,0],["أرَت كيفَ تُوفي المُخلصينَ حقُوقهم","وكيفَ تُجازِي من لها ليسَ يَجحَدُ",97,"د",1,0],["أَرَتْكَ بِذاتِ الضَّالِ منها مَعاصِماً","وخَدّاً أَسِيلاً كالوَذِلَةِ ناعِما",98,"م",2,0],["أرَتْني من خِلالِ السّجْفِ طَرْفاً","قرأتُ عليهِ إنَّ اللهَ حسْبي",99,"ب",2,0],["أَرَت مِن رَياحينِ الثَناءِ أَنيقَها","وَمِن زَهرِ الأَدابِ ما لَم يُخضَّدِ",100,"د",1,0],["أَرتْكَ يَدُ الغَيْثِ آثَارَهَا","وَأَعْلَنَتْ الأَرْضُ أَسْرَارَهَا",101,"ر",3,1],["أَرَتِ الشَماتَةُ بِالوَصِيَّ أُمَيَّةً","لا سَرَّها قَتلُ الوَصِيِّ وَلا شَقى",102,"ق",2,0],["أَرتْني بها الأَيَّامُ كلَّ عجيبةٍ","إِلى أَن جنيتُ النارَ من جَنَّة الخُلْدِ",103,"د",1,0],["أَرَتهُ ظِلالَ المَوتِ عَجلى كأَنَّها","مواشِكَةٌ رجعَ الجَناح خَفوقُ",104,"ق",1,0],["أَرَتها بِخدَّيها غُضوناً كأَنّها","مَجَرُّ غُصونِ الطلحِ ما ذُقنَ فَدفَدا",105,"د",2,0],["أَرَتهُ مِنَ الجَرباءِ في كُلِّ مَنظَرٍ","طِباباً فَمَثواهُ النَهارَ المَراكِدُ",106,"د",1,0]]}