{"poems":[[469,"شهرت علي صوارم العذل","https://www.aldiwan.net/poem3349.html","عموديه"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83258","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122675","الخفيف"]],"verses":[["وأسغ لناقع غلَّةٍ كلمي","هذا الزلال ونازع الغلّ",0,"ل",1,0],["وَأَسغَت في نَهلِ الشَفاهِ وَعَلَّها","ما لَيسَ يَعذَبُ بَعدَهُ مِن مَكرَعِ",1,"ع",1,0],["وأَسِغ غُصَّةَ الكُلافَةِ فالحُر","إذا جُرِّعَ الدَّواءَ أساغَه",2,"غ",2,0]]}