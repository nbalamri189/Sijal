{"poems":[[72,"يا مذكري بيت السعيد بأنعم","https://www.aldiwan.net/poem18265.html","الكامل"],[72,"أقسمت من فرعها المسبول بالداجي","https://www.aldiwan.net/poem18455.html","البسيط"],[72,"قلب بمصر وقالب بالشام","https://www.aldiwan.net/poem19990.html","الكامل"],[72,"يا مذكري بندى يديه وبابه","https://www.aldiwan.net/poem20525.html","الكامل"],[85,"يا مذنبا كل يوم نحو مغرمه","https://www.aldiwan.net/poem7364.html","البسيط"],[52,"لا ورمان النهود","https://www.aldiwan.net/poem27094.html","مجزوء الرمل"],[76,"ما أقرب اليأس من رجائي","https://www.aldiwan.net/poem39504.html","مخلع البسيط"],[183,"يا مذنبا أضحت لدى ذنوبه","https://www.aldiwan.net/poem14699.html","الكامل"],[374,"قدك البعاد فهل إليك سبيل","https://www.aldiwan.net/poem59293.html","الكامل"],[434,"صلت بالهجر فبالرحمن صلني","https://www.aldiwan.net/poem2541.html","الرمل"],[446,"يا مذهبين بجسمي","https://www.aldiwan.net/poem53747.html","المجتث"]],"verses":[["يا مذكري بيت السعيد بأنعم","أتتِ السعادةُ والعُلى من بابِها",0,"ه",2,1],["يا مذكري من كريمِ الدِّين أنعمه","بمصر دُمْ أنت تاجيُّ العلى ناجي",1,"ج",2,0],["يا مذكري بكرام قد فقدتهُم","فكان أكرم وجدان على عدم",2,"م",1,0],["يا مذكري بندى يديه وبابه","شهوات مصر لنا وطيب حماها",3,"ه",2,1],["يا مذنبا كل يوم نحو مغرمه","أذنب كما شئت قلبي عنك معتذر",4,"ر",1,1],["يا مُذِلَّ البَغيَ يا قا","تِلَ حَيّاتِ الحُقودِ",5,"د",1,0],["يَا مُذْكِيَ النَّارِ في فُؤادي","أَنْتَ دَوائي وأنْتَ دَائي",6,"ي",1,0],["يا مُذْنِبا أضحتْ لدىّ ذنوبه","حسنا وإحساني إليه جرائرْ",7,"ر",1,1],["يا مذبحاً فيه البَخور وتحته","ظهرت نفوس الأصفياء تقول",8,"ل",1,0],["يا مذيب الجسم جدلي بالكرى","وابعث الطيف بعد إن لم تعدني",9,"ي",1,0],["يا مذهبين بجسمي","وذاهبين بقلبي",10,"ب",2,1]]}