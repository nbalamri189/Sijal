{"poems":[[74,"يا مذكري بيت السعيد بأنعم","https://www.aldiwan.net/poem18265.html","الكامل"],[74,"أقسمت من فرعها المسبول بالداجي","https://www.aldiwan.net/poem18455.html","البسيط"],[74,"قلب بمصر وقالب بالشام","https://www.aldiwan.net/poem19990.html","الكامل"],[74,"يا مذكري بندى يديه وبابه","https://www.aldiwan.net/poem20525.html","الكامل"],[87,"يا مذنبا كل يوم نحو مغرمه","https://www.aldiwan.net/poem7364.html","البسيط"],[54,"لا ورمان النهود","https://www.aldiwan.net/poem27094.html","مجزوء الرمل"],[78,"ما أقرب اليأس من رجائي","https://www.aldiwan.net/poem39504.html","مخلع البسيط"],[189,"يا مذنبا أضحت لدى ذنوبه","https://www.aldiwan.net/poem14699.html","الكامل"],[382,"قدك البعاد فهل إليك سبيل","https://www.aldiwan.net/poem59293.html","الكامل"],[443,"صلت بالهجر فبالرحمن صلني","https://www.aldiwan.net/poem2541.html","الرمل"],[453,"يا مذهبين بجسمي","https://www.aldiwan.net/poem53747.html","المجتث"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64334","الخفيف"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99985","المديد"],[1317,"","https://poetry.dctabudhabi.ae/diwan/poem/146945","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64551","الخفيف"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132244","البسيط"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104671","الرمل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36725","الكامل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85164","الرمل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66532","الكامل"],[5848,"أغرق","https://www.poetsgate.com/ViewPoem.aspx?id=53458",""]],"verses":[["يا مذكري بيت السعيد بأنعم","أتتِ السعادةُ والعُلى من بابِها",0,"ه",2,1],["يا مذكري من كريمِ الدِّين أنعمه","بمصر دُمْ أنت تاجيُّ العلى ناجي",1,"ج",2,0],["يا مذكري بكرام قد فقدتهُم","فكان أكرم وجدان على عدم",2,"م",1,0],["يا مذكري بندى يديه وبابه","شهوات مصر لنا وطيب حماها",3,"ه",2,1],["يا مذنبا كل يوم نحو مغرمه","أذنب كما شئت قلبي عنك معتذر",4,"ر",1,1],["يا مُذِلَّ البَغيَ يا قا","تِلَ حَيّاتِ الحُقودِ",5,"د",1,0],["يَا مُذْكِيَ النَّارِ في فُؤادي","أَنْتَ دَوائي وأنْتَ دَائي",6,"ي",1,0],["يا مُذْنِبا أضحتْ لدىّ ذنوبه","حسنا وإحساني إليه جرائرْ",7,"ر",1,1],["يا مذبحاً فيه البَخور وتحته","ظهرت نفوس الأصفياء تقول",8,"ل",1,0],["يا مذيب الجسم جدلي بالكرى","وابعث الطيف بعد إن لم تعدني",9,"ن",2,0],["يا مذهبين بجسمي","وذاهبين بقلبي",10,"ب",2,1],["يا مذيبي بخاله اللازوردي","على خده القيل المضرج",11,"ج",1,0],["يَا مُذِيقِي غُصَّةَ الْكَمَدِ","مُشْعِلاً لِلنَّارِ في كَبِدِي",12,"د",2,1],["يا مذنباً ويقول إني مذنب","ما إن سمعت بظالم يتظلم",13,"م",1,1],["يا مذل الجبار ذا القوة المن","تقم الغالب انتقم لي وكد لي",14,"ل",2,0],["يا مذهب الغم كاشف الكروب أيا","مولاي جيشي ملاذي ملجئي عضدي",15,"د",2,0],["يا مُذيدينَ المَطايا غُوَّصا","في سَرابِ البيدِ تَجفو العَطَنا",16,"ن",2,0],["يا مُذكري زَمَن الصَبابة وَالصِبا","ذَكَرتُكَ ذِكري هاطلاتِ رهامِ",17,"م",1,0],["يا مذلي من تجاف مقلق","باعتزاز الوصل جدلى يا خرود",18,"د",1,0],["يَا مُذْنِبينَ بِها ضَعُوا أَوْزارَكُمْ","وَتَطَهَّرُوا بِترابِها وَتَهَجَّدُوا",19,"د",3,0],["يا مذوّبني ب حسنك كل هذا نورك","القمر غيران منك ويوم شافك أطرق",20,"ق",1,0]]}