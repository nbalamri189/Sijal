منسرح"],[438,"منازلهم بين اللوى فالدكادك","https://www.aldiwan.net/poem2528.html","الطويل"],[459,"لعل الركب أن خلصوا نجيا","https://www.aldiwan.net/poem55813.html","الوافر"],[459,"ما ليلتي على أقر","https://www.aldiwan.net/poem56186.html","مجزوء الرجز"],[462,"جزى الله خيرا من امام تخيرت","https://www.aldiwan.net/poem15392.html","الطويل"],[465,"ليست قدوداً ولكن هذه أسل","https://www.aldiwan.net/poem3144.html","عموديه"],[466,"شدوا اليك نياط القلب والعصبا","https://www.aldiwan.net/poem54193.html","عموديه"],[469,"تمتعت من شعرك الباهر","https://www.aldiwan.net/poem60131.html","المتقارب"],[478,"تعطر من دياركم النسيم","https://www.aldiwan.net/poem15337.html","الوافر"],[483,"سقتني بثغر الوصل قهوة حسنها","https://www.aldiwan.net/poem24322.html","عموديه"],[483,"عرج أخي حمى ليلى ومنعرج","https://www.aldiwan.net/poem24331.html","عموديه"],[483,"أسحر السحر في جفن الغزال","https://www.aldiwan.net/poem24467.html","عموديه"],[501,"والله لولا الله ما اهتدينا","https://www.aldiwan.net/poem37563.html","الرجز"],[501,"هو البدر أم وجه الحبيب الذي يبدو","https://www.aldiwan.net/poem38023.html","الطويل"],[505,"صفا شهد ذوقي من ممازجة الهوى","https://www.aldiwan.net/poem38414.html","الطويل"],[515,"هذا الحمى يا فتى فانزل بحومته","https://www.aldiwan.net/poem20832.html","البسيط"],[516,"أمنت من الغرام على فؤادي","https://www.aldiwan.net/poem12064.html","الوافر"],[516,"لكل مقام في علاك مقال","https://www.aldiwan.net/poem12200.html","الطويل"],[516,"لئن قل صبر فالمصاب عظيم","https://www.aldiwan.net/poem12255.html","الطويل"],[517,"اهاج هواك المنزل المتقادم","https://www.aldiwan.net/poem48608.html","الطويل"],[539,"يغادر مراكشا فرج","https://www.aldiwan.net/poem48252.html","عموديه"],[563,"لقد رحلت عن بيت عودة مريم","https://www.aldiwan.net/poem52628.html","الطويل"],[563,"من عاشر الدهر لا يخلو من الهوس","https://www.aldiwan.net/poem52815.html","البسيط"]],"verses":[["لَقَد رُسَّت حَفائِرُهُم جَميعاً","عَلى هامِ المَكارِمِ وَالمَعالي",0,"ل",2,0],["لَقَد رَبَّنا مِن غِياثِ الأَنامِ","مُقيمُ الصَغا وَدَليلُ الضَلالِ",1,"ل",1,0],["لَقَد رَأى بِعارِضَي","كَ ما أَحَبَّ العاذِلُ",2,"ل",1,0],["لَقَد راضَني حُبّيكِ حَتّى أَذَلَّني","وَقَد كُنتُ قَبلَ الحُبِّ ذا مَنعَةٍ صَعبا",3,"ب",2,0],["لَقَدْ رَامَ كَتْمَ الْوَجْدِ يَوْمَ ارْتِحَالِهِ","وَلَكِنَّ دَمْعَ الْعَيْنِ بَاحَ بِحَالِهِ",4,"ل",2,1],["لقَد رسَخَتْ آيُ الجَوى في جَوانِحي","كَما رسَخَ الإنْجيلُ في قلْبِ قِسّيسِ",5,"س",1,0],["لَقَد رَحَلَ اِبنُ موسى بِالمَعالي","وَسارَ بِسَيرِهِ العِلمُ الشَريفُ",6,"ف",1,1],["لقد رضي العلم عن فعله","وإن أخذ الجاهلين الغضب",7,"ب",1,0],["لَقَد رَحَلَ اِبنُ شِعرَةَ نابَ سَوءٍ","تَعَضُّ عَلى المَوارِكِ وَالزِمامِ",8,"م",1,0],["لقد رقت وقد راقت لسمعي","نظائر منه كالروض النضير",9,"ر",1,0],["لقد رحمنا بقومٍ","زهر الوجوه أثمّه",10,"ه",1,1],["لقد رفعا قواعد بيت جودٍ","دعا حجّ المقاصد واسْتمالا",11,"ل",2,0],["لَقَد رَكِبتُ عَلى التَغريرِ وَاِعجَبا","مِمَّن يُريدُ النَجا في المِسلَكِ الخَطِرِ",12,"ر",1,0],["لقد رأينا عَجَباً من العَجَبْ","بين جُمادى وجُمادى ورجبْ",13,"ب",1,1],["لقد رجَّيْتُ في عملي رجاء","فلا أصدُر بلا عملٍ مُثابِ",14,"ب",1,0],["لقد رأبَ الله الثَّأى وجلا العمى","بمعْتَضِدٍ بالله للدين عاضدِ",15,"د",1,0],["لقد رماه الفجر في","الصدر بسهم صائب",16,"ب",1,0],["لقد روى وما افترى","ولا غلا ولا كذب",17,"ب",1,0],["لقد رقد السمار حتى خلا النادي","ولم تبق يقضى غير عصفورة الوادي",18,"د",2,1],["لقد رفعت كل الثعالى تهانئاً","إلى الذئب إذ أمسى وصيا على الشاة",19,"ه",1,1],["لقد رمت عنا رحلة أبدية","أمالك عن هذا المرام عدول",20,"ل",1,0],["لقد رَبطت منا القلوب بحبكم","حبائلُ حتى الموت لا تتقطع",21,"ع",1,0],["لَقَد رَأَيتُ حَولَ صَن","عاءَ وَفي ظِلِّ عَدَن",22,"ن",1,0],["لَقَد رَكَّبَ اللهُ في ساعِدَيكَ","يَمينَ الجُدودِ وَشيمالَها",23,"ل",3,0],["لَقَد رَأَت كُلُّ عَينٍ مِنكَ مالِئَها","وَجَرَّبَت خَيرَ سَيفٍ خَيرَةُ الدُوَلِ",24,"ل",1,0],["لَقَد رَفَعَ اللَهُ مِن دَولَةٍ","لَها مِنكَ يا سَيفَها مُنصُلُ",25,"ل",1,0],["لَقَد رَأَتِ النَواظِرُ يَومَ سُعدى","زِيالاً تُستَهَلُّ لَهُ المَآقي",26,"ق",2,0],["لَقَد رَقَأَت مِنها العُيونُ وَنَوَّمَت","وَكانَت بِلَيلِ النائِحِ المُتَحَوِّبِ",27,"ب",1,0],["لَقَد رُزِئتُم بَني تَيمٍ وَغَيرُكُمُ","عَلى بَوائِبِها الخَيرَينِ مِن مُضَرا",28,"ر",2,0],["لَقَد رُزِئَت حَزماً وَحِلماً وَنائِلاً","تَميمُ بنُ مُرٍّ يَومَ ماتَ وَكيعُ",29,"ع",1,1],["لَقَد رَفَعَت كَفَّي بِلالٍ وَأَشرَقَت","بِهِ لِلعُلى أَيدٍ كَريمٌ فِعالُها",30,"ل",3,0],["لَقَد رَجَعَت شَيبانُ وَهيَ أَذِلَّةٌ","خَزايا فَفاظَت في الوِثاقِ وَفي الأَزلِ",31,"ل",1,1],["لَقَد رَكِبَت هَوازِنُ مِن هِجائي","عَلى حَدباءَ يابِسَةِ العُقومِ",32,"م",1,0],["لَقَد رَأَيتُ وَما عَيني بِراقِدَةٍ","نَبلَ الحَوادِثِ بَينَ الخَلقِ تَختَرِقُ",33,"ق",1,0],["لَقَد رَأَيتَ يَدَ الدُنيا مُفَرَّقَةً","لا تَأمَنَنَّ يَدَ الدُنيا عَلى اِثنَينِ",34,"ن",1,0],["لَقَد رَفَعتُم بِإِسداءِ الجَميلِ لَكُم","ذِكراً إِذا قَبَضَ اللَهُ الأَنامَ بَقي",35,"ق",2,0],["لَقَدَّرَت أَرضي أن تَعُودَ لِقَوْمِهَا","فَساءَتْ ظُنوني ثُمَّ أصبحتُ يائسا",36,"س",2,0],["لَقَد رَادَني رَوضاً مِنَ الحُسنِ نَاظِري","فَلي مَحْلُ جِسمٍ جَرّهُ خِصْبُ رائِدي",37,"د",2,0],["لقد رُدَّ تفويفُ الكلامِ موشَّعاً","لهم مثلما رُدَّتْ ليوشَعَ يوحُها",38,"ح",3,0],["لَقَد رَكِبَت ظَهرَ السُرى بي نَومَةٌ","فَأَصبَحتُ في أَرضٍ وَقَد بِتُّ في أُخرى",39,"ر",2,0],["لقد رزئت أم اللغات صديقها","فإن لم تكنه فالأب البر والجدا",40,"د",2,0],["لقد رمانا بخطبٍ من رسالتِه","ما مسَّنا مثله خطبٌ ولا قرعا",41,"ع",2,0],["لقد رِيعَ سِربُ الدّهرِ ممّا تجرّعوا","بأيدي الأعادي من بَلاءٍ ومن حَتْفِ",42,"ف",1,0],["لَقَد رُمتَ ما يُدنيكَ مِنهُ وَإِنَّما","أَتى قَدَرٌ وَاللَهُ مُعطٍ وَمانِعُ",43,"ع",1,0],["لقد رَتَعَتْ آمالُنَا من جَنَابِهِ","بِغَيرِ وَبِيِّ المَرتَعِ المُتَوَخِّم",44,"م",1,0],["لَقَد رَبِحَت تِجارَةُ كُلِّ صَبٍّ","تُهاديهِ حَبيبَتُهُ السَلاما",45,"م",2,0],["لَقَد رُحتُ وَما أَدري","أَسِحرٌ ذاكَ أَم ليتُ",46,"ت",1,0],["لَقَد رَجَّتِ اللَهَ النُفوسُ لِكَشفِهِ","أُموراً فَأَعطى أَنفُساً ما تَرَجَّتِ",47,"ت",1,1],["لَقَد رابَني مَغدى الفَقيرِ بِجَهلِهِ","عَلى العَيرِ ضَرباً ساءَ ما يَتَقَلَّدُ",48,"د",1,0],["لَقَد رَكَزوا الأَرماحَ غَيرَ حَميدَةٍ","فَبُعداً لِخَيلٍ في الوَغى لَم تُطارِدِ",49,"د",1,1],["لَقَد رَقَدَ المَعاشِرُ في ثَراهُم","فَما هَبَّ الجِعادُ وَلا السِباطُ",50,"ط",1,0],["لقد رَمَاني بسهمِ من لواحِظِهِ","أصْمى فؤادي فوا شوقي إلى الرامي",51,"م",2,0],["لَقَد روّعوها ثم نامَت عيونهم","وَلَيسَ سواءً نائم وَمروع",52,"ع",1,0],["لقد راق قَلبي العندليب وشدوه","وراق عيوني تحته الفنن اللدن",53,"ن",1,0],["لَقَد رفعت لي راية النصر أُمَّةٌ","فمثلك في وقت لها ليس يخفض",54,"ض",1,0],["لَقَد ركبوا كور المَطايا يحثّهم","إلى الموت من وادي الحَياة رَحيل",55,"ل",1,0],["لقد ربطتهم بالوفاء مودة","حبائلها للموت لا تتقطع",56,"ع",1,0],["لَقَد رأَيتك يا لَيلى بمشرفة","وَكانَ شعرك فوق الجيد ينسدل",57,"ل",1,0],["لقد رُعتمانِي بهذا المزاح","وأبدَعْتما نبأً مُغرِبا",58,"ب",2,0],["لقد رآني لابِساً نَثْرَةً","أسحَبُ منها في الوغى فَضْلَ ذَيْل",59,"ل",1,0],["لَقَدْ رَمى أَيَّ مَرْمَى","بِعَوْنِ مَنْ لَفَّ لَفَّهْ",60,"ف",2,0],["لَقَدْ رَاعَتْ فِعالُكُمُ فحَقٌّ","عَلَيْنَا حِفْظُهَا فِي كلِّ صَدرِ",61,"ر",1,0],["لَقَدْ رَأَيْنَا بِكَ فِي عَسْرِنَا","مَا كَانَتِ السَّادَاتُ فِي يَعْرُبِ",62,"ب",1,0],["لقد رويتَ فهل من فضلةٍ بقيَت","في الكأس أفعلها في النفس باقيها",63,"ي",3,0],["لقَد رتعَ القومُ في جيفةٍ","يبينُ لذي العقلِ أنتانُها",64,"ن",3,0],["لقد رأى البانَ لا تسعَى به قدمٌ","فيا لدَهْشتِه لمّا مشى البَانُ",65,"ن",1,0],["لقد رثيتَ له إذ قلَّ ناصره","وكنتَ من عَنَت الأيام تحميه",66,"ي",2,0],["لقد رَقَّ؛ حتى حسبناه سال","رَحِيقًا عتيقًا؛ وعذْبًا نميرا",67,"ر",2,0],["لقد ركب اللهُ في ساعديك","يمين الجدود وشمآلها",68,"ل",3,0],["لقد رقص الزمان مع الاداني","وجرأها فاكبرت المقالا",69,"ل",2,0],["لقد رقت حواشيه ولكن","قسا قلبا فاكسبني انتحالا",70,"ل",2,0],["لقد رقت به اجزاء جسمي","كما رقت له تلك الحواشي",71,"ش",2,0],["لَقَد راضَهُ حَتّى لَأَنفَذَ حُكمَهُ","وَلَو لَم يُرَض لَم يَرضَ بِالتُربِ مَضجَعا",72,"ع",2,0],["لَقَد راعَهُم لَيثُ الشَرى وَهوَ وَحدَهُ","فَكَيفَ إِذا لاقَوهُ مُستَصحِباً شِبلا",73,"ل",2,0],["لَقَد رَأى طُغلُبَكٍّ في تَخَوُّفِها","رَأياً بَعيداً مِنَ التَثريبِ وَالخَطَلِ",74,"ل",1,0],["لَقَد رَوّى وَهادِيَ وَالرَوابي","حَياً قَبلَ اِنتِجاعيهِ سَقاني",75,"ن",2,0],["لقد رأت الخلافة من بنيها","بحمد الله ما كانت تمنى",76,"ن",2,0],["لَقَد رَأَوا في الفِكرِ تَعساً لَهُم","رَأيَ قُدارٍ رَأَيُهُم فَيَصدَعِ",77,"ع",1,0],["لَقَدْ رَامَ صَعْبًا لَمْ يَرُمْهُ شَبِيهُهُ","وَرَاضَ شَمُوساً لا يَذِلُّ لِرَاكِبِ",78,"ب",1,0],["لَقَد راعَني بِدرُ الدُجى بِصدودِهِ","وَوَكَّلَ أَجفاني برعيِ كَواكِبِهِ",79,"ه",1,1],["لقد راح عنه رهطُهُ وعشيرُهُ","وغادَرَهُ خُلْطانُهُ وهو مُفْرَدُ",80,"د",1,0],["لقد رحم الرحمنُ رقَّةَ جسمِه","فجلله من نورِه برداءِ",81,"ا",2,0],["لقد ركز الشيطان بند جيوشه","ببندي فكل الجيش يأوي الى بندي",82,"د",2,0],["لقد رامت الخمسون ما رام بغيها","فلا تسألوني عن حياتي وعن سنى",83,"ن",2,0],["لقد رشت أهلَ الأرض يا أيها البحر","وريشي تبريه الحَبْوكَرُ والدَّهْرُ",84,"ر",1,1],["لَقَد رثَّ ثَوبٌ خَلَعتَ عَلَينا","وَنَحن نَميلُ إِلى الجِدَّه",85,"د",2,0],["لَقَد رَعَيتُ المُنى دَهراً وَمَربَعُها","كَما عَلِمتُ وَبيلٌ رَعيُهُ وَخِمُ",86,"م",1,0],["لَقَد رَكَضَت خَيلُ المَنايا فَأَوجَفَت","بِهِم وَلَها فيمَن بَقي مِنهُمُ كَرُّ",87,"ر",1,0],["لَقَد رُمِيَ الناسُ مِن خُلقِهِ ال","ذَميمِ بِأَقبَحَ مِن صورَتِه",88,"ت",2,0],["لَقَدْ رَجَوْتُ لَكُمْ شِفَاءً","يَبْدَأُ زَهْوَكَ خَيْرَ بَدْءِ",89,"ا",1,0],["لقد راعها ما راعني من حوادث","ولم تدر ان الصبر آخره شهد",90,"د",1,0],["لقد رَفعتهُ ثم فدَّتهُ حُرَّةٌ","وشامَت بهِ برقاً تألَّقَ مُمطرا",91,"ر",2,0],["لقد راعَني ليلٌ يخافُ سُكُونَه","عَليلٌ ويخفى في دُجاه قتيل",92,"ل",1,0],["لَقَد رَاقَبَتْ عام الجَماعَةِ بُرْهَةً","فَلَمْ يَعْدُها إِقرارُ عَيْنِ المُراقِبِ",93,"ب",1,0],["لَقَدْ رَمَتْ بِي مَرامِيها النَّوى زَمناً","فَالْيَوْمَ لا أَنْتَحِي فِي الأَرْضِ مُضْطَرَبا",94,"ب",2,0],["لَقَد راعَني يَومُ الفِراقِ فَلَم أُطِق","وَداعَهُم إِنَّ الفِراقَ يَروعُ",95,"ع",1,0],["لقد رفعوا سرادقَها سماءً","به الأَضواءُ تزدهرُ ازدهارا",96,"ر",2,0],["لقد رأيت بمصرٍ مذ حللت بها","عجائباً من رآها الناس في جيل",97,"ل",1,1],["لَقَد رَفَضوا الدُنيا الغَرورُ وَما سَعوا","لَها وَالَّذي يَأتي يُبادِرُ بِالبَذلِ",98,"ل",1,0],["لَقَد ريعَ وفدُ العجمِ منهم بِأمّةٍ","إِذا اِنتَسب الإسلامُ كانوا لهُ رَهطا",99,"ط",2,0],["لَقد راضَهم خوضُ الحروبِ تمثّلاً","فَما دونَهم 