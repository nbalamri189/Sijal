{"poems":[[74,"سائلي عن شرح حالي","https://www.aldiwan.net/poem18221.html","مجزوء الرمل"],[53,"لي صديق إذا رأت","https://www.aldiwan.net/poem62008.html","مجزوء الخفيف"],[53,"كان أناس يرون أني في","https://www.aldiwan.net/poem65695.html","المنسرح"],[93,"لوعة في الضلوع مثل جهنم","https://www.aldiwan.net/poem8809.html","عموديه"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55010","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54842","الكامل"],[119,"فرطت لا تنحرف عن منهج الادب","https://www.aldiwan.net/poem41217.html","عموديه"],[211,"أعددت صوبة والصموت ومارنا","https://www.aldiwan.net/poem27917.html","الكامل"],[214,"فرطت في ذا الحريق حتى","https://www.aldiwan.net/poem13447.html","مخلع البسيط"],[280,"لم يخن في الحب تأويلي","https://www.aldiwan.net/poem25541.html","المديد"],[310,"عظم الأجر عن عظيم المصاب","https://www.aldiwan.net/poem56609.html","الكامل"],[369,"أيا ولي الدولة المرتجى","https://www.aldiwan.net/poem60856.html","السريع"],[385,"قلبي بحبك يا ظلوم مولع","https://www.aldiwan.net/poem49242.html","الكامل"],[466,"جعلت من الحدثان أحصن أدرع","https://www.aldiwan.net/poem15148.html","الكامل"],[473,"أصبحت أنشر من شعري بكل يد","https://www.aldiwan.net/poem59625.html","البسيط"],[484,"لست الإله ولست بالشيطان","https://www.aldiwan.net/poem36946.html","الكامل"],[580,"فرطت فيك فلوعتي لا تنقضي","https://www.aldiwan.net/poem2921.html","الكامل"],[580,"فرطت فيك بسوء تدبيري","https://www.aldiwan.net/poem2951.html","الهزج"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122754","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122827","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63935","الخفيف"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96585","الطويل"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79465","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77845","الكامل"],[1877,"","https://poetry.dctabudhabi.ae/diwan/poem/115281","المنسرح"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69318","الكامل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121216","الخفيف"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45556","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93783","الكامل"],[2940,"","https://poetry.dctabudhabi.ae/diwan/poem/113697","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200490","الخفيف"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103466","الرجز"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110115","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91198","الخفيف"],[4083,"","https://poetry.dctabudhabi.ae/diwan/poem/147650","الخفيف"],[4330,"","https://poetry.dctabudhabi.ae/diwan/poem/122967","البسيط"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139249","الرمل"],[1901,"أنساك ما سَرَّكَ من بُعدِه","https://www.poetsgate.com/ViewPoem.aspx?id=160412",""],[5277,"العفوُّ جلّ جلاله","https://www.poetsgate.com/ViewPoem.aspx?id=189515",""],[5409,"أقسمت بالشرف الغا","https://www.poetsgate.com/ViewPoem.aspx?id=155364",""],[470,"دنيا الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=201295",""],[402,"لله قوم بالثبات تدرعوا","https://www.poetsgate.com/ViewPoem.aspx?id=36222",""]],"verses":[["فرط إسهالٍ وفقرٍ","إنَّ ذا حالُ خراء",0,"ا",2,0],["فرَّطتْ منك دعوةٌ","تأملُ النفس كرَّها",1,"ر",3,0],["فرطت فيك ثلاثٌ","آخذات بالخناق",2,"ق",1,0],["فَرطَ البَينُ عِقدَها المَنسوقا","أَم لِما بي أَرى البَياضَ سَوادا",3,"ا",1,0],["فَرَّطْتُ فِي تَشْبِيهِ مِصْرَ بِدَوْحَةٍ","هِيَ رَوْضَةٌ وَنَبَانُهَا مُتَنَوِّعُ",4,"ع",1,0],["فَرَط تَقَدَّمَ صَالِحاً","بِشَفَاعَةِ القلبِ الطَّهُورِ",5,"ر",1,0],["فرطت لا تنحرف عن منهج الادب","واحفظ مقامات اهل المجد والحسب",6,"ب",1,1],["فُرُطَ العِنانِ كَأَنَّ مُلجِمَها","في رَأسِ نابِيَةٍ مِنَ النَخلِ",7,"ل",1,0],["فرّطت في ذا الحريق حتى","مني قد استهلك الحطاما",8,"م",2,1],["فَرَّطُوا وَامْتَازَ دُونَهُمُ","فَرْطَ تَحْسينٍ وَتَحْصِيلِ",9,"ل",1,0],["فرطٌ خارها لك اللّه ذخراً","فهيَ نعم زلفى لحسن المآبِ",10,"ب",1,0],["فَرْطُ الحجابِ الصّعبِ ما وَجْهُه","على صديقٍ زادَ في فَرط",11,"ط",1,0],["فَرط الدُنو أَضَرَّ بي وَلربما","جَهل المُتَيم ما يَضُرُّ وَيَنفَع",12,"ع",1,0],["فرَطاً لمُؤتلفٍ كأنَّ رُكامَهُ","في جمِّهِ عَقِداتُ رملِ الأجرعِ",13,"ع",1,0],["فَرَطبُهُ لِلصَديقِ الرَطبِ يَلبِسُهُ","وَما تَحَسَّنَ مِنهُ كانَ لِلحُسنِ",14,"ن",1,0],["فرطت فيمن كنت بدر سمائه","فمحوت نور ودادك الروحاني",15,"ن",2,0],["فرَّطتُ فيكَ فَلوْعَتي لا تَنْقَضِي","وذُهِلْتُ عَنْكَ فحسرتي لا تَنْقَضِي",16,"ض",2,1],["فرطتُ فيكِ بسوءِ تَدْبِيري","فجرى القضاءُ بعكسِ تَقْدِيري",17,"ر",2,1],["فَرَّطتُ فيكَ وَأيامي مُساعِدَةٌ","والدّارُ جامِعَةٌ والشَّملُ مُلتَئِمُ",18,"م",1,0],["فَرَّطتُمُ في قاسِمٍ فَتَدارَكُوا","هَفَواتِكُم بِشُهُورِهِ وَسَنيهِ",19,"ي",2,0],["فَرطُ غُتْميَّةٍ سبقتمْ بها بَرْ","كشَ أو باكَ باكَ أو خُرخاشا",20,"ش",2,0],["فرطن فلا ردٌّ لما فات فانقضى","ولكن تَعَوَّض أَن يُقَالَ عديمُ",21,"م",1,0],["فرطُ الفظاظَةِ والصلابةِ دأْبُهُ","وأنا لديهِ بذُلَّةٍ وصَغَارِ",22,"ر",1,0],["فرطّ أبر طيب ماحٍ هدىً","فن غَريب من فنون فنون",23,"ن",1,0],["فرط هواني في حبكم كرم","وذلّتي في هواكم شرف",24,"ف",1,0],["فَرَطَ الكِرامُ وَجِئتَ أَنتَ مُؤَخَّراً","فَأَخَذتَ شَأوَ الفارِطِ المُتَقَدِّمِ",25,"م",1,0],["فرط هجر وفرق وامتحان","ان ايام وصلنا كل آن",26,"ن",1,0],["فَرطّت في خَتم بُرٍّ قَد سَمَحَت بِهِ","فَدبّر اللَصُّ فيهِ أَمسِ ما شاءَ",27,"ا",2,0],["فرّطت إذ بذروا التقى","فعدمت في الحصد الجرين",28,"ن",1,0],["فرَّطتم في عقود الودِّ فاغتنموا","تفريطكم إنه ما ليس ينتظمُ",29,"م",1,0],["فرّ طفل من غادةٍ وأتاني","قلت إني يا طفل أصبو للثمكْ",30,"ك",1,1],["فُرِّطَ حُسناً بِلالٍ أَربَعِ","وَعقد دُرٍّ حَول جيدٍ أتلَعِ",31,"ع",1,0],["فَرطُ التداوي بالتوالي آفةٌ","للجِسم فَهوَ بفرطِهِ يُضنِيهِ",32,"ي",2,1],["فرّطوا في الوقار إِذ أَفرطوا الغي","ي وَسدّوا كل باب يؤمّل",33,"ل",1,0],["فرط حبي وفرط حبك إلاّ","أنَّ عينيك بالفتور نوافث",34,"ث",1,0],["فرطت في إرثهم تفريط ذي سفه","لا يستقر له جد على اللعب",35,"ب",1,0],["فرط حب الشيء يعمي ويصم","فليكن حبك قصدا لا يصم",36,"م",1,1],["فرَّطْت في منفوسِ عهد الصبيَ","فلتعمل اليوم على ردهِ",37,"د",2,0],["فرَّطتُ في جنبِكَ الداني بما أثِمَتْ","نفسي منَ الذنبِ..إنَّ الذنبَ كالدرنِ",38,"ن",1,0],["فرط الخائن فيما","لم يَرِثه من أبيه",39,"ي",2,0],["فَرْطُ السّكوتِ على فَرطِ الأذى سَقَمُ","قد يسكتُ الجرحُ لكن˚ يَنطقُ الألمُ !",40,"م",1,1],["فَرْطُ السّكوتِ على فَرطِ الأذى سَقَمُ","قد یسكت العقل لكن تصُرخ الشیَم !",40,"م",1,0],["فرطت في تشبيه مصر بدوحة","هي روضة ونباتها متنوع",41,"ع",1,0]]}