{"poems":[[63,"ولوعة بت أخفيها وأظهرها","https://www.aldiwan.net/poem45795.html","البسيط"],[93,"أول ما تلهى به البطون","https://www.aldiwan.net/poem11071.html","الرجز"],[54,"يا معشر الأجناد لا تقنطوا","https://www.aldiwan.net/poem29387.html","السريع"],[88,"عهد الصبا سقيا لأيام الصبا","https://www.aldiwan.net/poem44447.html","الرجز"],[88,"أقوى مصيف القوم والمربع","https://www.aldiwan.net/poem45066.html","السريع"],[51,"لقد رأينا عجبا من العجب","https://www.aldiwan.net/poem8315.html","الرجز"],[51,"عجبت من معشر بعقوتنا","https://www.aldiwan.net/poem8517.html","المنسرح"],[51,"ما القلب في إثرهم بمختطف","https://www.aldiwan.net/poem65441.html","المنسرح"],[91,"يا رب ليل بلا سناء","https://www.aldiwan.net/poem62711.html","عموديه"],[89,"ما للحياة وراء الموت تجديد","https://www.aldiwan.net/poem44788.html","البسيط"],[85,"صحوت واستدركتني شيمتي الأدب","https://www.aldiwan.net/poem7890.html","البسيط"],[85,"ألم عصفور بمجرى صاف","https://www.aldiwan.net/poem8048.html","الرجز"],[43,"قد علم البين منا البين أجفانا","https://www.aldiwan.net/poem10588.html","البسيط"],[62,"ميقات موسى يوم تدبيرنا","https://www.aldiwan.net/poem52172.html","السريع"],[66,"برق المشيب قد أضا","https://www.aldiwan.net/poem40981.html","مجزوء الرجز"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[46,"فويحهم بئس ما ربوا وما حضنوا","https://www.aldiwan.net/poem22385.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85556","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85360","البسيط"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39561","السريع"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[50,"يَا عَبْدَ بَاهِلة َ الذي يَتوعَّدُ","https://www.poetsgate.com/ViewPoem.aspx?id=21776",""],[90,"في اربعين السعدون","https://www.poetsgate.com/ViewPoem.aspx?id=179042",""],[90,"الفرات الطاغي","https://www.poetsgate.com/ViewPoem.aspx?id=179148",""],[112,"الحمد لله على ما الهما","https://www.aldiwan.net/poem2368.html","الرجز"],[129,"قد جاء ذلك في القرآن معناه","https://www.aldiwan.net/poem50485.html","البسيط"],[129,"لا خير في عجلة الإنسان يا ثقتي","https://www.aldiwan.net/poem50518.html","البسيط"],[161,"إليك ما يقطع للسعله","https://www.aldiwan.net/poem58690.html","السريع"],[187,"أهوى الملاح وأهوى أن أجالسهم","https://www.aldiwan.net/poem43766.html","البسيط"],[190,"الحمد لله حمدا أستعد به","https://www.aldiwan.net/poem35094.html","البسيط"],[190,"حمد امرئ أخلص في آدائه","https://www.aldiwan.net/poem35279.html","الرجز"],[198,"لا الأنس أنس ولا الأفراح أفراح","https://www.aldiwan.net/poem39809.html","البسيط"],[200,"كيف فؤادي والهوى شاغل","https://www.aldiwan.net/poem45637.html","السريع"],[222,"ظهرت والفريق في دعة","https://www.aldiwan.net/poem55271.html","المنسرح"],[223,"أول ما ما يقوله ابن زكري","https://www.aldiwan.net/poem55391.html","الرجز"],[230,"جلت مساعي عن الفخر","https://www.aldiwan.net/poem51081.html","السريع"],[262,"صب بلا لوعة ولا كمد","https://www.aldiwan.net/poem38340.html","المنسرح"],[271,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[283,"إلمام طيف شنيب الثغر ألماه","https://www.aldiwan.net/poem32309.html","البسيط"],[286,"أهديت يا بدر من أقوالكم غررا","https://www.aldiwan.net/poem39387.html","البسيط"],[298,"أهكذا دوحة العلياء تنقصف","https://www.aldiwan.net/poem32965.html","البسيط"],[306,"يا أكرم الناس أخلاقا وأحسنهم","https://www.aldiwan.net/poem56593.html","الكامل"],[321,"شكرا بالنصر عين العز ترقبكم","https://www.aldiwan.net/poem67182.html","البسيط"],[321,"قل للمعالي ترطب مسمعي طربا","https://www.aldiwan.net/poem67218.html","البسيط"],[321,"أرى المعالي بمن يرجى لها عنيت","https://www.aldiwan.net/poem67220.html","الكامل"],[321,"عاد العزيز فاهلا","https://www.aldiwan.net/poem67227.html","المجتث"],[321,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[350,"بدت لعيني بالستور والكلل","https://www.aldiwan.net/poem15861.html","الرجز"],[354,"الحمد لله أَتم الحمد","https://www.aldiwan.net/poem38727.html","الرجز"],[354,"وفى لنا الدهر إسعادا بما وعدا","https://www.aldiwan.net/poem40401.html","البسيط"],[362,"هل ذاك ثغر تبسم","https://www.aldiwan.net/poem68065.html","المجتث"],[372,"باتت أساطير الهوى تتلى","https://www.aldiwan.net/poem57176.html","السريع"],[381,"استغر الله العظيم العفو","https://www.aldiwan.net/poem47411.html","الرجز"],[394,"حمدا لرب جل عن نديد","https://www.aldiwan.net/poem53683.html","الرجز"],[403,"سقى العقيق فالديار فاللوى","https://www.aldiwan.net/poem46428.html","الرجز"],[403,"وافاك يصحبه الإسعاد والظفر","https://www.aldiwan.net/poem46940.html","البسيط"],[430,"يا يوم بحفوفة والشهب هائلة","https://www.aldiwan.net/poem40807.html","البسيط"],[454,"مؤسس الدولة المرهوب جانبها","https://www.aldiwan.net/poem61383.html","البسيط"],[478,"قد حال عما تعهده","https://www.aldiwan.net/poem15187.html","مجزوء الرجز"],[479,"لوركا","https://www.aldiwan.net/poem2292.html","عموديه"],[480,"بشراكمو بازديادي","https://www.aldiwan.net/poem37053.html","المجتث"],[480,"بالشاعرين نحيي ندوة الأدب","https://www.aldiwan.net/poem37191.html","البسيط"],[480,"يا سفر سيفر وإن خطوك بالذهب","https://www.aldiwan.net/poem37206.html","البسيط"],[501,"ماذا يضر البدر وهو في السما","https://www.aldiwan.net/poem37630.html","الرجز"],[530,"مولاي ذا الكرامه","https://www.aldiwan.net/poem37163.html","منهوك المنسرح"],[539,"سجنت نفسي بيدي","https://www.aldiwan.net/poem47500.html","عموديه"],[559,"إني أنا وبينما","https://www.aldiwan.net/poem33772.html","مجزوء الرجز"],[559,"ما لابن مريم في تلك الأساطين","https://www.aldiwan.net/poem33794.html","البسيط"],[559,"لا تظلم الله بما لا يليق","https://www.aldiwan.net/poem34298.html","السريع"],[559,"يا صاحبي في الرخا وفي الضيق","https://www.aldiwan.net/poem34307.html","المنسرح"],[559,"فيه أنا ميت ومقبور","https://www.aldiwan.net/poem34481.html","السريع"],[559,"وجود كوني من تجلي الجواد","https://www.aldiwan.net/poem34632.html","السريع"],[559,"إن قلت يا روحي لسبوحي","https://www.aldiwan.net/poem34673.html","السريع"],[559,"قد قال من قال من جهل وإغواء","https://www.aldiwan.net/poem35078.html","البسيط"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["وَهَكَذا كُنتَ تَبكي يَومَ ذي بَقَرٍ","وَلَيلَةَ الجِزعِ وَالمَثوى عَلى إِضَمِ",0,"م",1,0],["وهكذا تصفو لنا الأسمار","من بعد أن ينقضي النهار",1,"ر",1,0],["وَهَكذا يَرزُقُ أَصحابَهُ","خَليفَةٌ مُصحَفُهُ البَربَطُ",2,"ط",1,0],["وهكذا أنهار أعمار الورى","تجري فتنصبّ إلى بحر الردى",3,"ا",1,0],["وهكذا الظلمة تتلو الضيا","والضوء للظلمة يستتبع",4,"ع",1,0],["وهكذا كلُّ ارتقاءٍ في العلا","قريبُ عهدٍ بارتقاء في الكُرَبْ",5,"ب",1,0],["وهكذا الجاهلُ قِدماً لم يزل","من جهلِهِ في تَعبٍ وفي نصَبْ",5,"ب",1,0],["وهَكذا هذه الجدودُ لها","إكسير صدقٍ يُعرِّبُ النسبا",6,"ب",2,0],["وهكذا سيرة الجواد إذا","لم يؤت من هجنة ولا قرف",7,"ف",1,0],["وَهَكَذا المُجرِمُ الفِدائي","في عُرفِهِم فاتِحٌ عَظيمُ",8,"م",1,0],["وهكذا المرء شلو في نهايته","وهكذا المرء منه الركن مهدود",9,"د",1,0],["وهكذا أنا في همى وفي هممي","إن الرجال إذا ما حاولوا دأبوا",10,"ب",3,0],["وَهَكَذا العَهدُ بِوُدِّ الناسي","وَقيمَةُ المُحسِنِ عِندَ الناسِ",11,"س",1,0],["وَهَكَذا كُنتُ في أَهلي وَفي وَطَني","إِنَّ النَفيسَ غَريبٌ حَيثُما كانا",12,"ن",2,0],["وهكذا أحجارنا سبعة","لا شك في ذاك ولا لبسُ",13,"س",1,0],["وَهَكَذا جَدَّ أَبو ال","خَيرِ لِإِدراكِ المُنى",14,"ا",1,0],["وَهَكَذا عاقَبَهُ الطُغيانِ","وَطاعَةُ الأَنفُسِ لِلشَيطانِ",15,"ن",1,0],["وَهَكَذا كانَ أَهلُ الأَرضِ مُذ فُطِروا","فَلا يَظُنُّ جَهولٌ أَنَّهُم فَسَدوا",16,"د",3,0],["وهكذا أنا بالأحداث مرتهنٌ","أقطِّع العمر بين الجد واللعبِ",17,"ب",1,0],["وَهَكَذا الأرض حول الشمس دائرة","كَما يَدورُ حَوالي أَرضنا القَمر",18,"ر",1,0],["وَهَكَذا شمسنا صارَت لحالتها","شَمساً تصاعد مِنها النار وَالشرر",18,"ر",1,0],["وهكذا الدنيا خداعٌ عجيب","إذا خلت أيامها من حبيب",19,"ب",1,0],["وهكذا يومٌ ويومٌ سواه","ينكرها القلب الصَّبور الحمول",19,"ل",1,0],["وهكذا يذهب طِيب الحياه","بين التمنّي واعتذار الرسول",19,"ل",1,0],["وهكذا نمضي وتمضي السنون","وهكذا دارت رحاها الطحون",19,"ن",1,0],["وهكذا تمضي ليالي الحياهْ","والقبرُ ما زال على حالهِ",20,"ه",1,0],["وهكذا إنْ قِسْتَهُ التعاقبُ","وليسَ مثلَ ذلكَ التَّراقبُ",21,"ب",1,0],["وة كذاك عبد السوء يشتم ربه","سَفَهاً، ولكِنْ هلْ تُجابُ الأَعْبُدُ؟",22,"د",1,0],["وهكذا الدمع بريئاً يُرى","وهكذا الحزنُ بليغاً يكون",23,"ن",1,0],["وهكذا الناسُ يُغريهم تخيُّلُهم","حتى يَجيئوا الى البَلْوى فيختبروا",24,"ر",3,0],["وهكذا رَكب عَلَيهِ أَبَدا","مَا بَلَغت ومَأ تَناهَت عَدَدا",25,"د",2,0],["وهكذا قد أنى معنى كذلك في","الآيات فافهمه حقا لاح مرآه",26,"ا",2,0],["وهَكَذا في الونى في غيرِ موضعِه","في كلِّ حالٍ وهذا القولُ مَفْهُومُ",27,"م",1,0],["وهكذا العاقل إن مسها","ردت له من خالف عقله",28,"ل",2,0],["وهكذا الحبّ لا إتيانُ معصيةٍ","لا خير في لذّة من بعدها سقَرُ",29,"ر",1,0],["وَهكذا كلّ لفظٍ موهمٍ شبهاً","فَوِّضهُ للّه أو أوّل بلا شبهِ",30,"ب",2,0],["وَهَكذا أبناءُ شيثٍ بعدهُ","أَوصوا بَنيهم لازمينَ حدّهُ",31,"ه",1,0],["وهكذا الحبّ شوقٌ ملحفٌ وأسى","مضنٍ ودمع وهمٌّ فيه ملحاح",32,"ح",1,0],["وهكذا الدنيا انتقاضٌ وما","يكونُ فيها فرحٌ كاملُ",33,"ل",1,0],["وهكذا يرسل المهيمن بالرحمة","والفضل للورى رسله",34,"ل",2,0],["وهكذا فعل بفتح الأوَّل","وكسره وضمه مع فعل",35,"ل",1,0],["وهكذا يُخْذَل في دهره","كلُّ دعِيٍّ صَدّ عن نصري",36,"ر",2,0],["وهكذا الدهر لست أنكره","إن سرني اليوم ساءني بغد",37,"د",1,0],["وهكذا يفقدُ السلطانُ هيبتَهُ","إن أكثرَ القومُ بالفوضى السلاطينا",38,"ن",2,0],["وَهَكَذا الدَهرُ ما أَصفى مَشارِبَهُ","إِلّا وَكَدَّرَ ما قَد كانَ أَصفاهُ",39,"ا",2,0],["وهكذا ديدن الاسلاف نعرفهم","لذا بك افتخر الاسلام والزمن",40,"ن",1,0],["وَهَكَذا ظُبَةُ الماضي تُفلُّ شَباً","من بعد ما زانَها الإمضاءُ والرَهفُ",41,"ف",1,0],["وَهَكَذا بهجةُ العليا وَنضرَتها","يزري بمُشرقِها الإظلامُ والسَدَفُ",41,"ف",1,0],["وَهَكَذا دُرَّةُ المجد الأثيل غَدَتِ","يضمُّها بعدَ حُسنٍ الحليةِ الصَدفُ",41,"ف",1,0],["وَهَكذا الوعد والظنّ الجميل بكم","لا زال مثلكم أهل المروءاتِ",42,"ت",1,0],["وَهَكَذا كانَ فَالعَبّاسُ سَيِّدُنا","رَبِّ المَكارِمِ لا نَعدِمُ أَياديهِ",43,"ي",2,0],["وَهَكَذا كُلُّ حَيٍّ رامَ يُسعِدُهُ","بِحَيث أَصبَحَ لِلحُسنى أَخاً وَأَبا",44,"ب",2,0],["وَهَكَذا فَليَكُن صَوناً لِكُلِّ سَناً","ما ضاعَ دُرٌّ لَهُ في الكَنزِ إِحرازُ",45,"ز",1,0],["وَهَكَذا أَخواتٌ","لَهُ ذَواتُ اِحتِشامِ",46,"م",1,0],["وَهَكَذا عَزَّزوا مَرهوبَ جانِبِهِم","حَتّى غَدَت مِلَّةُ الإِسلامِ وَهيَ بِهِم",47,"م",1,0],["وَهَكَذا كانَ جَيشُ اللَهِ فَكَّرتَهُ","أَن يَهزِمَ الجَمعَ لا تُجديهِ كَثرَتُهُ",47,"ه",1,0],["وَهَكَذا رُحتُ مَغبوناً بِشارَتِها","فَيا خَسارَةَ نَفسٍ في تِجارَتِها",47,"ه",2,0],["وَهَكَذا اِشرَح يا رَسولي قِصَّتي","لِكُلِّ مَن عَن حالَتي مِنهُم سَأَل",48,"ل",1,0],["وَهَكذا وَحيد هَذا العَصر","الشَهم عبَد اللَه أَعني النَصري",49,"ي",1,0],["وَهَكَذا مَن أَحَبَّ اللَهُ حَبّبنا","فيهِ فَكُنّا بِهِ مِن جُملة السعدا",50,"د",2,0],["وَهكَذا الفَضل يَبدو","بِالفَحصِ وَالجَهلِ يَكتم",51,"م",1,0],["وهكَذا الناسُ إِذا فُتِّشوا","أكبرهُم أكبرهُم فِعلا",52,"ل",2,0],["وهكذا الحرُّ يرى المنية","أولى به من خطةٍ دَنيَّه",53,"ه",1,0],["وهكذا حوادثُ الأيَّامش","تلعبُ بالحُرِّ بلا احتشامِ",53,"م",1,0],["وهكذا الشأنُ وما الإنسان","بالذَّات إِلا القلبُ واللَّسان",53,"ن",1,0],["وَهكَذا السامِعُ لِلأَصواتِ","لَيسَ كَقَولِ فرقة الصفات",54,"ت",1,0],["وهكذا كلّ جوادٍ سابقٍ","مِن الورى تعيده إلى الورا",55,"ا",1,0],["وهكذَا لَم تَزَلْ في كُلّ مَلْحَمَةٍ","غرّاء يُسْعدُكَ الإقبالُ والظَّفَرُ",56,"ر",1,0],["وهكذا يومها الثاني لقد شهر ال","بزاة فيه مناسيراَ كما التبر",57,"ر",1,0],["وهكذا سيرة الأبطال ملحمة","الخلد شاعرها والدهر راويها",58,"ي",3,0],["وهكذا عاداتُهُ","مِن حيث كرَّتْ مُدَدُه",59,"د",2,0],["وهكذا الشاعر , زلزال.. وإعصار مياه","ورياح , إن زأر",60,"ر",1,0],["وهكذا من تردى","مستبسلا ثوب حر",61,"ر",1,0],["وهكذا الفخر إن فاخترم افتخروا","بمثل هذا فليس الفخر بالحسب",62,"ب",1,0],["وهكذا الحق لولا السيف يظهره","لم يحترم ربه فينا ولم يهب",63,"ب",1,0],["وهكذا الله جَرَت عاداته","وهو آله الأرض جلَّ والسما",64,"م",2,0],["وَهكذا جَرَى القَلَمْ","طَلَبْتُ نَثْراً فَنَظَمْ",65,"م",1,0],["وهكَذا قَضَيتُ تِل","كَ السَّاعتَين يا أخِي",66,"ي",1,0],["وهكذا الكون جمي","عاً كل وقتٍ مثلنا",67,"ن",2,0],["وهكذا هي ألقاب محققة","للعيسويين من تلك الأساطين",68,"ن",1,0],["وهكذا يؤذونه دائماً","وهو صبور ماءهم لا يريق",69,"ق",1,0],["وهكذا الحادثات أجمعها","من حين تغريبها لتشريق",70,"ق",1,0],["وهكذا الكل ولكن هنا","يظهر مخذول ومنصور",71,"ر",1,0],["وهكذا الكل لها راجع","والكون كون والبلاد البلاد",72,"د",1,0],["وهكذا كل البريات لو","تدري بحال منه مشروح",73,"ح",1,0],["وهكذا سائر الأسماء منه لها","قوابل كظلالات وأفياء",74,"ا",2,0],["وهكذا تصير في الأعقاب","بالفضل والسبق وإلى الأصلاب",75,"ب",1,0]]}