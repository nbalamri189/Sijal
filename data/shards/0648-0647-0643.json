https://poetry.dctabudhabi.ae/diwan/poem/111496","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69919","البسيط"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77088","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77114","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77070","الرجز"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44724","الرجز"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125799","البسيط"],[4248,"","https://poetry.dctabudhabi.ae/diwan/poem/105547","الرجز"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83199","الرجز"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83195","الرجز"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83201","الرجز"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83197","الرجز"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83185","الرجز"],[520,"","https://poetry.dctabudhabi.ae/diwan/poem/199652","الرجز"],[4755,"العَمَّارُ الغَريب","https://www.poetsgate.com/ViewPoem.aspx?id=184179",""],[4755,"حكايةُ لَون","https://www.poetsgate.com/ViewPoem.aspx?id=184492",""],[4767,"هدية","https://www.poetsgate.com/ViewPoem.aspx?id=96133",""],[4767,"صفحة الخير","https://www.poetsgate.com/ViewPoem.aspx?id=125022",""],[4858,"سفرة وشعر","https://www.poetsgate.com/ViewPoem.aspx?id=155076",""],[4888,"عشرون عاما من العطاء","https://www.poetsgate.com/ViewPoem.aspx?id=207743",""],[4927,"تحية البلاد","https://www.poetsgate.com/ViewPoem.aspx?id=4573",""],[4927,"معلقة أمير الشهداء المعاصرين صَدّام يرحمه الله","https://www.poetsgate.com/ViewPoem.aspx?id=36731",""],[5001,"غُرْبةُ رُوْح","https://www.poetsgate.com/ViewPoem.aspx?id=176230",""],[5032,"خيال رجائي","https://www.poetsgate.com/ViewPoem.aspx?id=189500",""],[5121,"هَدِيَّتِي إِلَيْكَ","https://www.poetsgate.com/ViewPoem.aspx?id=209063",""],[5145,"عودوا ببعض عشيات الحمى عودوا","https://www.poetsgate.com/ViewPoem.aspx?id=108065",""],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""],[5409,"تاريخ كل زمان ما يسطره","https://www.poetsgate.com/ViewPoem.aspx?id=155375",""],[5409,"أهزةٌ أيقظت من روعها البلدا","https://www.poetsgate.com/ViewPoem.aspx?id=155458",""],[5410,"العشق الخالد","https://www.poetsgate.com/ViewPoem.aspx?id=141977",""],[5582,"لِغِبْطَةِ العَيْشِ عِلاَّتٌ وَآفاتُ","https://www.poetsgate.com/ViewPoem.aspx?id=186754",""],[5582,"هَلْ لِلنَّوَى ذلِكَ الظَّبْيُ الأَغَنُّ سَرَى","https://www.poetsgate.com/ViewPoem.aspx?id=63509",""],[5582,"شاقَتْكَ هِنْدٌ وَأَمْسَى الحَبْلُ مُنْصَرِمَا","https://www.poetsgate.com/ViewPoem.aspx?id=63568",""],[5690,"هذا الصباح بدا أم ذا محياكِ","https://www.poetsgate.com/ViewPoem.aspx?id=172170",""],[5720,"العُلا","https://www.poetsgate.com/ViewPoem.aspx?id=199853",""],[5953,"وباكي يبكي على ربه","https://www.poetsgate.com/ViewPoem.aspx?id=93796",""],[5956,"البِرُّ بالوالدَيْن","https://www.poetsgate.com/ViewPoem.aspx?id=192713",""],[5997,"جمر في ذاكرة الرماد","https://www.poetsgate.com/ViewPoem.aspx?id=214424",""],[6052,"روضة الايمان","https://www.poetsgate.com/ViewPoem.aspx?id=35138",""],[6142,"بنت النبوة أخت الذكر أم هدا","https://www.poetsgate.com/ViewPoem.aspx?id=155741",""],[6225,"ملجأ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81041&r=&rc=278",""]],"verses":[["وَهَكَذا كُنتَ تَبكي يَومَ ذي بَقَرٍ","وَلَيلَةَ الجِزعِ وَالمَثوى عَلى إِضَمِ",0,"م",1,0],["وهكذا تصفو لنا الأسمار","من بعد أن ينقضي النهار",1,"ر",1,0],["وَهَكذا يَرزُقُ أَصحابَهُ","خَليفَةٌ مُصحَفُهُ البَربَطُ",2,"ط",1,0],["وهكذا أنهار أعمار الورى","تجري فتنصبّ إلى بحر الردى",3,"ا",1,0],["وهكذا الظلمة تتلو الضيا","والضوء للظلمة يستتبع",4,"ع",1,0],["وهكذا كلُّ ارتقاءٍ في العلا","قريبُ عهدٍ بارتقاء في الكُرَبْ",5,"ب",1,0],["وهكذا الجاهلُ قِدماً لم يزل","من جهلِهِ في تَعبٍ وفي نصَبْ",5,"ب",1,0],["وهَكذا هذه الجدودُ لها","إكسير صدقٍ يُعرِّبُ النسبا",6,"ب",2,0],["وهكذا سيرة الجواد إذا","لم يؤت من هجنة ولا قرف",7,"ف",1,0],["وَهَكَذا المُجرِمُ الفِدائي","في عُرفِهِم فاتِحٌ عَظيمُ",8,"م",1,0],["وهكذا المرء شلو في نهايته","وهكذا المرء منه الركن مهدود",9,"د",1,0],["وهكذا أنا في همى وفي هممي","إن الرجال إذا ما حاولوا دأبوا",10,"ب",3,0],["وَهَكَذا العَهدُ بِوُدِّ الناسي","وَقيمَةُ المُحسِنِ عِندَ الناسِ",11,"س",1,0],["وَهَكَذا كُنتُ في أَهلي وَفي وَطَني","إِنَّ النَفيسَ غَريبٌ حَيثُما كانا",12,"ن",2,0],["وهكذا أحجارنا سبعة","لا شك في ذاك ولا لبسُ",13,"س",1,0],["وَهَكَذا جَدَّ أَبو ال","خَيرِ لِإِدراكِ المُنى",14,"ا",1,0],["وَهَكَذا عاقَبَهُ الطُغيانِ","وَطاعَةُ الأَنفُسِ لِلشَيطانِ",15,"ن",1,0],["وَهَكَذا كانَ أَهلُ الأَرضِ مُذ فُطِروا","فَلا يَظُنُّ جَهولٌ أَنَّهُم فَسَدوا",16,"د",3,0],["وهكذا أنا بالأحداث مرتهنٌ","أقطِّع العمر بين الجد واللعبِ",17,"ب",1,0],["وَهَكَذا الأرض حول الشمس دائرة","كَما يَدورُ حَوالي أَرضنا القَمر",18,"ر",1,0],["وَهَكَذا شمسنا صارَت لحالتها","شَمساً تصاعد مِنها النار وَالشرر",18,"ر",1,0],["وهكذا الدنيا خداعٌ عجيب","إذا خلت أيامها من حبيب",19,"ب",1,0],["وهكذا يومٌ ويومٌ سواه","ينكرها القلب الصَّبور الحمول",19,"ل",1,0],["وهكذا يذهب طِيب الحياه","بين التمنّي واعتذار الرسول",19,"ل",1,0],["وهكذا نمضي وتمضي السنون","وهكذا دارت رحاها الطحون",19,"ن",1,0],["وهكذا تمضي ليالي الحياهْ","والقبرُ ما زال على حالهِ",20,"ه",1,0],["وهكذا إنْ قِسْتَهُ التعاقبُ","وليسَ مثلَ ذلكَ التَّراقبُ",21,"ب",1,0],["وة كذاك عبد السوء يشتم ربه","سَفَهاً، ولكِنْ هلْ تُجابُ الأَعْبُدُ؟",22,"د",1,0],["وهكذا الدمع بريئاً يُرى","وهكذا الحزنُ بليغاً يكون",23,"ن",1,0],["وهكذا الناسُ يُغريهم تخيُّلُهم","حتى يَجيئوا الى البَلْوى فيختبروا",24,"ر",3,0],["وهكذا رَكب عَلَيهِ أَبَدا","مَا بَلَغت ومَأ تَناهَت عَدَدا",25,"د",2,0],["وهكذا قد أنى معنى كذلك في","الآيات فافهمه حقا لاح مرآه",26,"ا",2,0],["وهَكَذا في الونى في غيرِ موضعِه","في كلِّ حالٍ وهذا القولُ مَفْهُومُ",27,"م",1,0],["وهكذا العاقل إن مسها","ردت له من خالف عقله",28,"ل",2,0],["وهكذا الحبّ لا إتيانُ معصيةٍ","لا خير في لذّة من بعدها سقَرُ",29,"ر",1,0],["وَهكذا كلّ لفظٍ موهمٍ شبهاً","فَوِّضهُ للّه أو أوّل بلا شبهِ",30,"ب",2,0],["وَهَكذا أبناءُ شيثٍ بعدهُ","أَوصوا بَنيهم لازمينَ حدّهُ",31,"ه",1,0],["وهكذا الحبّ شوقٌ ملحفٌ وأسى","مضنٍ ودمع وهمٌّ فيه ملحاح",32,"ح",1,0],["وهكذا الدنيا انتقاضٌ وما","يكونُ فيها فرحٌ كاملُ",33,"ل",1,0],["وهكذا يرسل المهيمن بالرحمة","والفضل للورى رسله",34,"ل",2,0],["وهكذا فعل بفتح الأوَّل","وكسره وضمه مع فعل",35,"ل",1,0],["وهكذا يُخْذَل في دهره","كلُّ دعِيٍّ صَدّ عن نصري",36,"ر",2,0],["وهكذا الدهر لست أنكره","إن سرني اليوم ساءني بغد",37,"د",1,0],["وهكذا يفقدُ السلطانُ هيبتَهُ","إن أكثرَ القومُ بالفوضى السلاطينا",38,"ن",2,0],["وَهَكَذا الدَهرُ ما أَصفى مَشارِبَهُ","إِلّا وَكَدَّرَ ما قَد كانَ أَصفاهُ",39,"ا",2,0],["وهكذا ديدن الاسلاف نعرفهم","لذا بك افتخر الاسلام والزمن",40,"ن",1,0],["وَهَكَذا ظُبَةُ الماضي تُفلُّ شَباً","من بعد ما زانَها الإمضاءُ والرَهفُ",41,"ف",1,0],["وَهَكَذا بهجةُ العليا وَنضرَتها","يزري بمُشرقِها الإظلامُ والسَدَفُ",41,"ف",1,0],["وَهَكَذا دُرَّةُ المجد الأثيل غَدَتِ","يضمُّها بعدَ حُسنٍ الحليةِ الصَدفُ",41,"ف",1,0],["وَهَكذا الوعد والظنّ الجميل بكم","لا زال مثلكم أهل المروءاتِ",42,"ت",1,0],["وَهَكَذا كانَ فَالعَبّاسُ سَيِّدُنا","رَبِّ المَكارِمِ لا نَعدِمُ أَياديهِ",43,"ي",2,0],["وَهَكَذا كُلُّ حَيٍّ رامَ يُسعِدُهُ","بِحَيث أَصبَحَ لِلحُسنى أَخاً وَأَبا",44,"ب",2,0],["وَهَكَذا فَليَكُن صَوناً لِكُلِّ سَناً","ما ضاعَ دُرٌّ لَهُ في الكَنزِ إِحرازُ",45,"ز",1,0],["وَهَكَذا أَخواتٌ","لَهُ ذَواتُ اِحتِشامِ",46,"م",1,0],["وَهَكَذا عَزَّزوا مَرهوبَ جانِبِهِم","حَتّى غَدَت مِلَّةُ الإِسلامِ وَهيَ بِهِم",47,"م",1,0],["وَهَكَذا كانَ جَيشُ اللَهِ فَكَّرتَهُ","أَن يَهزِمَ الجَمعَ لا تُجديهِ كَثرَتُهُ",47,"ه",1,0],["وَهَكَذا رُحتُ مَغبوناً بِشارَتِها","فَيا خَسارَةَ نَفسٍ في تِجارَتِها",47,"ه",2,0],["وَهَكَذا اِشرَح يا رَسولي قِصَّتي","لِكُلِّ مَن عَن حالَتي مِنهُم سَأَل",48,"ل",1,0],["وَهَكذا وَحيد هَذا العَصر","الشَهم عبَد اللَه أَعني النَصري",49,"ي",1,0],["وَهَكَذا مَن أَحَبَّ اللَهُ حَبّبنا","فيهِ فَكُنّا بِهِ مِن جُملة السعدا",50,"د",2,0],["وَهكَذا الفَضل يَبدو","بِالفَحصِ وَالجَهلِ يَكتم",51,"م",1,0],["وهكَذا الناسُ إِذا فُتِّشوا","أكبرهُم أكبرهُم فِعلا",52,"ل",2,0],["وهكذا الحرُّ يرى المنية","أولى به من خطةٍ دَنيَّه",53,"ه",1,0],["وهكذا حوادثُ الأيَّامش","تلعبُ بالحُرِّ بلا احتشامِ",53,"م",1,0],["وهكذا الشأنُ وما الإنسان","بالذَّات إِلا القلبُ واللَّسان",53,"ن",1,0],["وَهكَذا السامِعُ لِلأَصواتِ","لَيسَ كَقَولِ فرقة الصفات",54,"ت",1,0],["وهكذا كلّ جوادٍ سابقٍ","مِن الورى تعيده إلى الورا",55,"ا",1,0],["وهكذَا لَم تَزَلْ في كُلّ مَلْحَمَةٍ","غرّاء يُسْعدُكَ الإقبالُ والظَّفَرُ",56,"ر",1,0],["وهكذا يومها الثاني لقد شهر ال","بزاة فيه مناسيراَ كما التبر",57,"ر",1,0],["وهكذا سيرة الأبطال ملحمة","الخلد شاعرها والدهر راويها",58,"ي",3,0],["وهكذا عاداتُهُ","مِن حيث كرَّتْ مُدَدُه",59,"د",2,0],["وهكذا الشاعر , زلزال.. وإعصار مياه","ورياح , إن زأر",60,"ر",1,0],["وهكذا من تردى","مستبسلا ثوب حر",61,"ر",1,0],["وهكذا الفخر إن فاخترم افتخروا","بمثل هذا فليس الفخر بالحسب",62,"ب",1,0],["وهكذا الحق لولا السيف يظهره","لم يحترم ربه فينا ولم يهب",63,"ب",1,0],["وهكذا الله جَرَت عاداته","وهو آله الأرض جلَّ والسما",64,"م",2,0],["وَهكذا جَرَى القَلَمْ","طَلَبْتُ نَثْراً فَنَظَمْ",65,"م",1,0],["وهكَذا قَضَيتُ تِل","كَ السَّاعتَين يا أخِي",66,"ي",1,0],["وهكذا الكون جمي","عاً كل وقتٍ مثلنا",67,"ن",2,0],["وهكذا هي ألقاب محققة","للعيسويين من تلك الأساطين",68,"ن",1,0],["وهكذا يؤذونه دائماً","وهو صبور ماءهم لا يريق",69,"ق",1,0],["وهكذا الحادثات أجمعها","من حين تغريبها لتشريق",70,"ق",1,0],["وهكذا الكل ولكن هنا","يظهر مخذول ومنصور",71,"ر",1,0],["وهكذا الكل لها راجع","والكون كون والبلاد البلاد",72,"د",1,0],["وهكذا كل البريات لو","تدري بحال منه مشروح",73,"ح",1,0],["وهكذا سائر الأسماء منه لها","قوابل كظلالات وأفياء",74,"ا",2,0],["وهكذا تصير في الأعقاب","بالفضل والسبق وإلى الأصلاب",75,"ب",1,0],["وهكذا الغرض الأعمى يقود إلى","جور بكى الحرّ من جراه وانتحبا",76,"ب",2,0],["وهكذا كان إسماعيل في هممم","كل رعى الشعب والإصلاح يقظانا",77,"ن",2,0],["وهكذا بينكم يقضي الزمان بما","لم تقضه بينكم قربى ولا نسب",78,"ب",1,0],["وَهَكَذا رَبَّ الجِدالِ يَلبثُ","فينا عَلى جِدالِهِ وَيُبعث",79,"ث",1,0],["وَهَكَذا في كُلِّ شَيءٍ تَمّا","إِن باتَ يَوماً اِستَحالَ سُمّا",80,"م",2,0],["وَهَكَذا العاقلُ مَن يَحتَجُّ","عَلى خلاصِ نَفسِهِ وَيَنجو",81,"و",1,0],["وَهَكَذا في حادِثٍ أَصابا","رُبَّ حَديثٍ يعتق الرِقابا",82,"ب",2,0],["وَهَكَذا صحبةُ غَير الجنس","موجبةٌ إِلى هَلاك النَفس",83,"س",1,0],["وَهَكَذا في الناسِ كُل مَن بَدا","بِالخبثِ لا يَخرج إِلّا نكدا",84,"د",2,0],["وَهَكَذا مَطامِعُ الإِنسان","تنزله في الذُلِّ وَالهَوانِ",85,"ن",1,0],["وَهَكذا المُنَجِّمون سُحقوا","وَكَذبوا في القَول مَهما صَدَقوا",86,"ق",3,0],["وَهَكَذا العريان بَينَ القافِلَه","في راحَةٍ وَالناسُ عَنهُ غافِلَه",87,"ه",1,0],["وَهَكَذا كُلُّ شَقِيّ في الوَرى","ما إِن يُرى مصدِّقا حَتّى يَرى",88,"ر",2,0],["وَهَكَذا قَد تَفعَلُ الحَميرُ","وَمِنهُم بَينَ الوَرى كَثيرُ",89,"ر",1,0],["وَهَكذا التَدبير في إِست الحمل","ما لَم يَجد مَقدرةً عَلى العَمل",90,"ل",1,0],["وَهَكذا في الأُصول قالوا","كَما يدين الفَتى يدان",91,"ن",1,0],["وَهَكذا في أَغنياء الناس","المال وَالزخرف في اللباسِ",92,"س",1,0],["وَهَكَذا العتوُّ شَأن الأُمرا","أَظلم مِنهُم في الأَنام لَم أَر",93,"ر",1,0],["وَهَكَذا في الناس مَن تَنازَعا","عِندَ المَضيق في المَهاوي وَقَعا",94,"ع",2,0],["وَهَكَذا بِالسَعي في التَعليم","نَأكُل خَير رزقنا السَليم",95,"م",1,0],["وَهَكذا إِن قلَّت الأَمانَه","وَكَثُرَت في البَلَدِ الخِيانَه",96,"ه",1,0],["وَهَكَذا فَقِس عَلى ذا القاضي","نَظيرَهُ في سائِر الأَراضي",97,"ي",1,0],["وَهَكَذا كُلُّ أَمير عاقل","ينزل كُل الناس في مَنازل",98,"ل",1,0],["وَهَكَذا فَضيلة الإِنسانِ","وَفَخره بِالعَقلِ وَاللِسان",99,"ن",1,0],["وَهَكَذا حاد عَن الفَلاح","مَن يَبتَني قَصراً عَلى الرِياح",100,"ح",1,0],["وَهَكَذا كَم أَكلَةٍ","أَودَت بِنَفس الآكِلِ",101,"ل",1,0],["وَهَكَذا في الناس كُلُّ ظالِم","بِمثله يُصرع بَين العالم",102,"م",1,0],["وَهَكَذا فَلتَكُن الفتوَّه","وَالجود بِالنَفس هُوَ المُروَّه",103,"ه",1,0],["وَهَكَذا مِن شدة الحرص رُموا","بِالقَتل عَن آخِرهم وَأعدموا",104,"م",3,0],["وَهَكَذا كانَت طِباع الأمرا","أَلون مِنهُم لِلمُلوكِ لا أَرى",105,"ر",2,0],["وَهَكذا مَفاسد الكِبار","تَؤول بِالأَذى إِلى الصِغار",106,"ر",1,0],["وهكذا الحب بحر لا حدود له","وليس فيه لمن يغشاه شطآن",107,"ن",1,0],["وَهكَذا كنّا بِكلّ مَوطِن","مِنحَة فَضلٍ مِن عَميم المنَنِ",108,"ن",1,0],["وهكذا حكمة الجبار ما اختلفت","قوم على رسلهم إلا بهم خسفا",109,"ف",2,0],["وهكذا كف ابن عفرا الفتى","أعادها من بعد قطع الحسام",110,"م",1,0],["وَهَكذا الجعلُ لم يصلح له أبداً","للشمّ من مستشمّ الريح ريحانُ",111,"ن",1,0],["وَهكَذا مَنْكَحُهُمْ وَما أَتى","بِذاكَ نَصٌّ عِنْدَ مَنْ تَثَبَّتا",112,"ت",2,0],["وَهكَذا ما فِعْلُهُ لِلْحائِطَهْ","مُوافِقٌ فإنَّ ذَاكَ ضابِطَهْ",112,"ه",1,0],["وَهكَذا لَمْ يُعْتَبَرْ عِنْدَ الْعَرَبْ","كَما هُوَ الظَّاهِرُ عِنْدَ ذِىي الاََدَبْ",113,"ب",1,0],["وَهَكذا نَحنُ في الدُنيا إِلى أَمَدٍ","نَسعي وَنَركُض وَالآجالُ في الطَلَبِ",114,"ب",1,0],["وهكذا الدهر يُري","في كل يوم عجبا",115,"ب",2,0],["وهكذا العقلاء الراسخون لهم","مسايلٌ عند أهل العلم معتبرَهْ",116,"ر",2,0],["وهكذا القوم منه عند حملته","لا يلتقون سبيلاً منه للهربِ",117,"ب",1,0],["وهكذا يوم جدّ الهول همتهُ","عزومةٌ لا تبالي قط بالنصبِ",117,"ب",1,0],["وَهَكَذا الجن أَغاثوا الإِنسا","لأنهم رَعوا بِذاكَ الجنسا",118,"س",2,0],["وَهَكذا مِنك بِيَوم آمدِ","عَلَيهِمُ فَضلٌ فَهَل مِن جاحد",119,"د",1,0],["وَهَكذا خَليقة الصَّياد","لا يَقبَل الصحيح للكياد",120,"د",1,0],["وَهَكَذا تريد أَن تَخدَعني","بِقَولك الحُلو وَإِن تَصرَعني",120,"ي",1,0],["وَهَكذا لابُدَ لي مِن حيله","تَكون لي إِلى العُلا وَسيله",121,"ه",1,0],["وهكذا عادتُه فافطَنُوا","يَقُودُ في السِّرِّ على مَن يَلِيه",122,"ي",2,0],["وَهَكَذا لَو تَفهَمون الأنس","يبركم أَرفقهم لِيَقسو",123,"و",1,0],["وَهَكَذا الطبيب إِذ يُداوي","بِالقَطع وَالمسهل وَالمكاوى",123,"ا",3,0],["وَهَكَذا صبيح يا رِجال","أنهضه إِلى العَلاء المال",124,"ل",1,0],["وَهكَذا الحازم إِذ يَكيدُ","يبلغ في الأعداء ما يريدُ",124,"د",1,0],["وَهَكَذا الحمير وَالبِغال","وَالحَرث للثيران وَالأَعمال",125,"ل",1,0],["وَهَكَذا إِذ بيت الشراة","وَكانَ مِن عاداتِها البيات",126,"ت",1,0],["وَهَكَذا أَنتَ تَعيب الناسا","بِكُل فَضل فاعكس القِياسا",127,"س",2,0],["وهكذا الذئب صار ظبياً","وهكذا أضحت القلوب",128,"ب",1,0],["وهكذا الدنيا بنا","تجري على هذا النمط",129,"ط",1,0],["وهكذا أبو الحصين الثعلب","وأمّ عريط كذاك العقرب",130,"ب",1,0],["وهكذا ثلاثة المقاربه","في جملة رافعة وناصبه",130,"ه",1,0],["وهكذا معموله ومنه لا","يبدلُ موجب وتكرير خلا",130,"ل",2,0],["وهكذا قول النبي أحمدا","في اصبع منها دم له بدا",131,"د",2,0],["وهكذا تفعل في البواقي","على اختلاف الوضع باتفاق",131,"ق",1,0],["وهكذا زيد أخذت عنه","ورحت عنه جائز ومنه",131,"ه",1,0],["وهكذا تفعل في المضارعِ","لكلِّ حرف باطراد تابع",132,"ع",1,0],["وهكذا الحكم في العضو الرئيس إذا","خصته هبةُ نفعٍ عمت الجسدا",133,"د",2,0],["وهكذا من اراد المجدَ يبلُغُه","لا ينعم الْقلبُ حتَّى يألمَ الجَسدُ",134,"د",1,0],["وهكذا الحبُّ بجور حُكمِهِ","مُسلِّطٌ على القلوب الحدَقا",135,"ق",2,0],["وهكذا جسومنا إِضافةً","موجودةٌ في عالمِ الوهم فقط",136,"ط",1,0],["وهكذا ارتفع الدّانون وانخفض","العالون لمّا بدا عصر الصّعاليك",137,"ك",1,0],["وهكذا الخالة مثل العمة","ما اختلف الحكم هنا وثمه",138,"ه",1,0],["وهكذا فعلها بي في صداقتها","فكيف تفعل ان عادت من اعدائي",139,"ا",2,0],["وهكذا الناسُ دُنْياهم تُبدِّدُهم","وهكذا قد مضى من قَبْلنا أُمم",140,"م",1,0],["وهكذا العُمر فيكُم","ألا يا أحمد",141,"د",1,0],["وهكذا حتى ليوم النبا","صلوا عليه",142,"ل",3,0],["وهكذا طلت لمن عاهدت","حليفةً مفيدة نافعه",143,"ع",2,0],["وهكذا الزهد في اهليه يقنعهم","عن مال كسرى وعن أموال قارون",144,"ن",1,0],["وهكذا الايام تُطوى بنا","سبحانك اللهمّ ما اعظمك",145,"ك",1,0],["وهكذا الأمر بالمعروف كان بهم","كالنهي عن منكر الأعمال يُعتمد",146,"د",1,0],["وهكذا الأمر إذا لم يكن","كالنصِّ في الأمر الذي يفشي",147,"ش",2,0],["وهكذا يعطى مقاما وفي","صحيحه جاء بها مسلم",148,"م",1,0],["وهكذا ينقضي عيشي على نكد","وكدَّرته بك الأيام وهو هني",149,"ن",2,0],["وهكذا حالة الدنيا تكون على","كل البرية تفصيلاً واجمالا",150,"ل",2,0],["وَهَكذا جبروت القَوم أَقعدَهُم","عن حق شعب تجافى موقد الفتن",151,"ن",1,0],["وهكذا يقْضِي زَمانِي به","لا حولَ لي ما شاءَ ربِّي قضَاهْ",152,"ا",2,0],["وَهَكَذا الاقدار حيثما جرت","تجري ولا تصغي للوم لائم",153,"م",1,0],["وَهَكَذا حامض النومي مثلهما","فاحفظ واياك ان تنسى مقاديري",154,"ر",2,0],["وهكذا العمر أكاذيبه","متاع هذي الأمم الفانيه",155,"ي",2,0],["وهكذا بدابة التوكل","تتبعها نهاية المكمّل",156,"ل",1,0],["وهكَذا المُرَبَّعُ الفوقَاني","والجاهُ في سَيرِهِ يَا إخوانِي",157,"ي",1,0],["وَهَكَذَا المَعقِلُ مَع سُهَيلِ","ينقُصُ رُبعاً فآستَمِع مِن قيلي",157,"ي",1,0],["وَهَكَذا التِّيرُ والرامح وَفَرقَدُهُم","والسِّلِّبَارُ فَلاَ تُغري الأَبَاطيلُ",158,"ل",1,0],["وهكذا العقربُ يا إخواني","فَهُو كَمِثلِ البار في الأوزانِ",159,"ن",1,0],["وهكذا قِبلَةُ بيتِ المَقدِسِ","بالطولِ والعرضِ أيَا مُهَندسِي",160,"ي",1,0],["وَهَكذا صَلُّوا بأرضٍ السِّندِ","والبَعضِ قيلَن مِنَ أرضِ الهندِ",160,"د",1,0],["وهَكَذا كَرمَانُ والقطيفُ","قد قدَّرَ المُهَيمِنُ اللطيفُ",160,"ف",1,0],["وَهَكَذا يَغرُبنَ خَلفَ القايم","على الغَضَاريفِ مُديماً دايم",160,"م",1,0],["وَهَكَذا في جَنُوبي عَيرَبَا","وبرِّها عن أهلِهَا مُغتربَا",160,"ب",2,0],["وهَكَذا سهيلُ والحمَارِ","بالكلِّ إجرِ بالسَّواكُن داري",161,"ي",1,0],["وهكذا يميلُ للهيرانِ","بلا زياداتٍ ولا نُقصَانِ",162,"ن",1,0],["وهكذا تفعل في كل ذي","فضيلة أو همة عالية",163,"ي",2,0],["وَهَكَذا فَلتَكُن سُوّاسُ جامِعَةٍ","ذِكراً وَإِلّا فَفي الماضي مِنَ العِبَرِ",164,"ر",1,0],["وهكذا تمضي الليالي بنا","ونلتقي بعد طوال العصر",165,"ر",1,0],["وهكذا سنة الأحباب ما برحت","ترقى بكل محب فوق رتبته",166,"ت",2,0],["وهكذا مذهب الاسلاف قدوتنا","يا صاحبي لم نزع عنه ولم نحد",167,"د",1,0],["وهكذا كلّ دأبي","أدني وأرفع قدرا",168,"ر",2,0],["وهكذا الحرب السجال بيننا","حتى إذا نور الصباح انبلجا",169,"ج",2,0],["وهكذا التفاح فاح عرفه","ولا كعود قد ذكا في مجمر",170,"ر",1,0],["وهكذا الحب إن صحَّت قواعدهُ","ليس التكحل في العينين كالكَحلِ",171,"ل",1,0],["وهكذا أنجاله الكرام","ما راق بدء ورقى ختام",172,"م",1,0],["وهكذا نثني على آبائنا","خير ثناء لاعتنائهم بنا",173,"ن",2,0],["وهكذا من أسسوا ذي المدرسة","فكم لهم من همم مقدسه",174,"ه",1,0],["وهكذا موسى الكليم فادر","أنظر لابراهيم ذي الإرشاد",175,"د",1,0],["وهكذا الإنجيلُ جاء يطري","موسى بعم عمران رفيع الجاه",175,"ه",1,0],["وهكذا أبناؤكم فلينهوا","لولدهم أخذ النساء الغر",175,"ر",1,0],["وهكذا البطيخ والرقي","كلاهما مستعذب شهي",176,"ي",1,0],["وهكذا الخوف من الممات","يبيد ظل العيش والحياة",177,"ه",1,0],["وهكذا قد رأيناهم ببلدتنا","وفي الحديث اشارات لفعلهم",178,"م",1,0],["وهكذا حكم سنجاب ففروته","ان لم يمت باخناق منه لم يقم",178,"م",1,0],["وهكذا الحكم في باب الاخوة خذ","من غير فرق بحبل الله واعتصم",178,"م",1,0],["وهكذا ازر لما طغى وبغى","جفا الخليل له والقوم لم يرم",178,"م",1,0],["وهكذا الغيد كم جرّت مَحاسنها","لِعاشقيها صنوفَ الهمّ والغيرِ",179,"ر",1,0],["وَهَكَذا كل امرٍ لَيسَ فيهِ لنا","رأَيٌ سَديدٌ فَلَن يَنجو من الخَللِ",180,"ل",1,0],["وَهَكَذا نقمة المولى كنعمتهِ","محيطةٌ بِجَميع الناس تكتنفُ",181,"ف",1,0],["وهكذا فليكُنِ الإيمانُ","والحبُ والوفاءُ والعرفانُ",182,"ن",1,0],["وهكذا الدهر لم تؤمن عواقبه","له إلينا إساءات وإحسان",183,"ن",1,0],["وهكذا الحكم فيمن صار مشتهراً","بالبغي لا يبتغي عن بغيه حولا",184,"ل",2,0],["وهكذا حصن من يأوى البغاة ولا","ضمان فيه إذا عن أمره دخلا",184,"ل",2,0],["وهكذا وارث في الصورتين ومن","غدا يعاملهم كالمشتري مثلا",184,"ل",2,0],["وهكذا النجلُ النجيبُ يُبدي","عظائمَ الأسلافِ باقتحام",185,"م",1,0],["وَهكذَا زِيَادَتَا فَعلاَنَا","مِن بَعدِ أربَعٍ كَزَعفَرَانَا",186,"ن",2,0],["وَهَكَذَا بَدلُ عَينِ الفِعلِ إن","يَؤُل إلَى فِلتُ كَمَاضِى خَف وَدِن",186,"ن",1,0],["وَهَكذَا هَمزٌ وَمِيمٌ سَبقاً","ثَلاثَةً تَأصِيلُهَا تحَقَّقاً",186,"ق",2,0],["وهكذا الظر بان والظب كذا","محظنبي والحظبى واللحيم بظا",187,"ظ",2,0],["وهكذا كل من تهواه تحسبهُ","معفىً من الموت مأموناً من العطب",188,"ب",1,0],["وهكذا ما أحسوا هول صولتها","إلا إذا فتكت بالسيد السند",189,"د",1,0],["وَهَكَذا شيم الشَهم الَّذي اِبتَسَمَت","مَباسم الحَمد عَن أَوصافِهِ الغرر",190,"ر",1,0],["وهكذا أتباعه","باؤوا بسوء مكرهم",191,"م",1,0],["وهكذا فليكن أهل النهى صفة","إن الصفات ثياب للذي لبسا",192,"س",2,1],["وَهَكذا نحن أَبناء الزَمان عَلى","سَعيِ الأنوق إِلى أَشراك مقتنص",193,"ص",1,0],["وَهَكذا الدَهرُ هَمٌّ وَانشراحُ فما","حالٌ يَدوم عَلى صَفوٍ وَلا كدر",194,"ر",1,0],["وَهكذا نحن تترى في تصرفها","الدين ينذرُ وَالدنيا تمنّينا",195,"ن",2,0],["وَهكذا الدَهر مرهوبٌ بوادرُه","وَالنَفس بِالحَق لا بالخلق مسعوده",196,"د",2,0],["وَهَكذا الدَهر يُبكي ذا وَيُضحكُ ذا","وَكلُّها حلمٌ لَو أَنهم علموا",197,"م",3,0],["وَهَكذا نَحنُ أَربابَ الهَوى سِيَرٌ","نَفنَى فَنَبقى عَلى الدُنيا لمدَّكر",198,"ر",1,0],["وَهَكذا الحرّ في الصَعب الجليّ يُرَى","إِن الحَوادثَ للأَبطال ميزان",199,"ن",1,0],["وهكذا الأملاك في حضرة","تنزهت عن حاجة وارتهاب",200,"ب",1,0],["وَهَكَذا أَلفاظُها","كَاللؤلؤِ المُنتَظمِ",201,"م",1,0],["وهكذا بعضُ الذَّواتِ رُوحُ","والبعضُ منها في الحشَا قُروحُ",202,"ح",1,0],["وهكذا ظللت بي","ن سقم وسأم",203,"م",1,0],["وهكذا الايام تطوي بنا","طي سجل بيد القدرة",204,"ه",1,0],["وهكذا الموجبة الجزئي","ضمت مع السالبة الكليه",205,"ه",1,0],["وهكذا من موعد","لموعد لموعد",206,"د",1,0],["وهكذا لكلِّ حِبٍّ طالبِ","وبلِّغَن يا شاهدٌ للغائبِ",207,"ب",1,0],["وهكذا ذنوب أحبابي بجاهْ","شفيعِنا عليه أفضل صلاهْ",208,"ه",1,0],["وهكذا الديباج ثم الديوان","والفكر والإِصبع ثم النسيان",209,"ن",1,0],["وهكذا السرجين والسهريز","للتمر والشيم أتت تجوز",209,"ز",1,0],["وهكذا مِعزابه مطرابه","في مدحه فإِن أَردت عابه",210,"ه",1,0],["وهكذا مَن تعالَى","في حُسْنِه يتغالَى",211,"ل",2,0],["وهكذا تجاذب القومان","جثة فطرقل بجهد العاني",212,"ي",1,0],["وَهَكطورُ ما زالَ حَيُ اِندَفَع","بِهِم أَوَّلاً وَالصِفاقَ اِقتَلَع",213,"ع",1,0],["وَهَكطورُ بَينَ الطَلائِعِ هام","يُسائِلُ عَن هيلِنوسَ الهُمام",213,"م",1,0],["وَهَكطورُهُم عِدُّ آريسَ في","زَعامَتِهِم باهِرٌ الشَرَفِ",213,"ف",1,0],["وَهَكطُورُ عَن حَزمهِ ما انثَنى","وَلَكِن لَوجهِ الحَضِيضِ انحَنى",214,"ن",2,0],["وَهَكطُورُ وَالقَرعُ يَعلُو صَدِيدُه","بِهِم صاحَ كالرَّعدِ يَدوِي هَدِيدُه",215,"ه",1,0],["وَهَكطُورُ هَيَّاجُ التَّرائكِ مُقبِلٌ","بإِثرِهِما يُنمِي الفَخَارَ مُظَفَّرا",216,"ر",2,0],["وَهَكطُورُ صَدرَ الجَيشِ يَجري وَيَلغَبُ","وَيَكسَأُ في الأَردَافِ مَن يَتَعَقَّبُ",216,"ب",1,0],["وَهَكطُورُ لا يَنفَكُّ يَرمي وَيرتَمي","ِإلى أن يَهُبًّ القَرمُ آخِيلُ فِيهِمِ",216,"م",1,0],["وهَكطُورُ ابنُهُ وأُذِيسُ قاما","وقاسا فَسحَةَ البَونِ القَصِيرِ",217,"ر",1,0],["وهكطور الحبيب دعا","ووجداً قلبه فارا",218,"ر",2,0],["وهكطورٌ يصد كأنه","بأبيه ما شعرا",218,"ر",2,0],["وهكطورٌ لرؤيته","تقطع وصل عزمته",218,"ه",1,0],["وهكطورٌ وراه أخيل","ظل يجد في الطلب",218,"ب",1,0],["وَهَكطُرٌ في صَدرِهِم يَدورُ","في يَدِهِ مِجَنُّهُ الكَبيرُ",219,"ر",1,0],["وَهكَذا فَالأَخوانِ اِنحَدَرا","لِدارِ آذِيسَ بِحُكمٍ قُدِّرا",219,"ر",2,0],["وَهَكَذا هُكطورُ عِدُّ آرِسِ","أَثارَ طُرواداً عَلى الأَراغِسِ",219,"س",1,0],["وَهَكَذا أوذيسُ بِالرُمحِ وَثَب","وَذِيُّفيتَ بَينَ كِنفَيهِ ضَرَب",219,"ب",1,0],["وَهَكطُرٌ في ثَغرِ إِسكامَندَرِ","يَصولُ في صَدرِ الجَناحِ الأَيسَرِ",219,"ر",1,0],["وَهَكطُرُ لِلفَتكِ يَصلى نارا","فغارَ ما بَينَ العِدى وَثارا",219,"ر",2,0],["وَهَكَذا أَياسُ مُلتاعاً نَأى","عَن ساحَةِ القِتالِ وَالعَودَ اِرتَأى",219,"ا",2,0],["وهكطور طرّاً وافقوا يغفلون ما","لهم فولداماسٌ بحكمته أبدى",220,"د",2,0],["وهكطور وافى بقلب الحديد","يؤج فصاح بصوتٍ شديد",221,"د",1,0],["وهكطور في باب إسكيةٍ","على جرده فاكرٌ بالدرك",221,"ك",1,0],["وهكطور عن خيله نزلا","وفي طلب الجثة اقتتلا",221,"ل",2,0],["وهكطور لما رآه جريحاً","تقفاه بينهم ورماه",221,"ه",1,0],["وهكطور ما زال يزري به","علام بحتفي كنت النذير",221,"ر",1,0],["وَهَكطُرٌ إِثرَهُ الفِتيانُ لاغِبَةٌ","وَإِثرَ فوليدَماسٍ تَحتَ إِمرَتِهِ",222,"ه",1,0],["وَهَكَذا فَلَئِن نَظفَر بِسورِهِمِ","وَخَرقِ أَبوابِهِ خَرقاً بِرَغمِهِمِ",222,"م",1,0],["وَهَكَذا اِنقَضَّ سَرفيدونُ مُمتَحِنا","خَرقَ المَراقِبِ وَالسورِ الذي حَصُنا",222,"ن",2,0],["وَهَكطُرٌ في البابِ قَد ثَقُلا","مُحَدَّدَ الرَأسِ ضَخمٌ قَعرُهُ حَمَلا",222,"ل",2,0],["وهكطور ألقى ببأسٍ شديد","يبيد به أو حياتي يبيد",223,"د",1,0],["وهكطور تصمي وللسفن","تعود بمجدٍ رفيعٍ سني",223,"ي",1,0],["وَهكَذا اختارَ للانجيل اربعةً","ممَّن غذاهم لبانَ العلم مِن يَفعوا",224,"ع",3,0],["وَهكًَذَا يَلزَمُ فِى نَفى البَقَا","وبهذَا يُجزَمُ",225,"م",1,0],["وهَكَذَ الحِسابُ وَالمِيزَانُ","من مَأ به قَد وَجَبَ الإِيمَانُ",225,"ن",1,0],["وهكذا حال امرىء قد عشقا","من يسعف العبد بضد القصد",226,"د",1,0],["وَهكَذا المَجدُ ما شادَت دَعائِمُه","شَبا المَواضي وَأَطرافُ القَنا الذبل",227,"ل",1,0],["وَهكَذا المَجدُ ما أَعلَت دَعائِمُه","أَنامِلَ السُمرِ إِذ مَدَت بِلا أَوَد",228,"د",1,0],["وَهكَذا أَيضاً بِكُلِّ مالي","مِن كُلِّ مَنثور وَنظم حالي",229,"ي",1,0],["وَهَكَذا في غالبِ الأَجناسِ","فَاِعتَبِروا في حكمةِ القياسِ",230,"س",1,0],["وهكذا الزهد فيما أنت تملكه","ما الزهد تعليل عجز يطفئ النهما",231,"م",2,0],["وهكذا شرافة الحساس","على سواه عند كل الناس",232,"س",1,0],["وَهَكَذا المَرءُ إِذا ما كَرُما","تَراهُ يَخشى أَن يُقالَ لؤُما",233,"م",2,0],["وَهَكذا غايَةُ كُلِّ حَيٍّ","تَشابَهَ الأَشيَبُ بِالصَبيّ",234,"ي",1,0],["وَهَكذا كُلُّ عَظيم القَدرِ","دانٍ إِلى الناسِ قَليلُ الفَخرِ",235,"ر",1,0],["وَهَكذا مَن أَمِنَ الأَصحابا","مِثلُ الشِياهِ تَأمَنُ الذِئابا",236,"ب",2,0],["وَهَكذَا المَحامدُ","مِن دُونِها الشَدائدُ",237,"د",1,0],["وهكذا عزم الفتى فليصنع","ذكرك في الدنيا عظيم الموقع",238,"ع",1,0],["وهكذا ظَلَّ يَبنِي غَيرَهُ ويَرَى","دِيارَهُ شاخِصاتٍ تَجتَدِي الغُرَبَا..",239,"ب",2,0],["وهكذا أنفَقتُ وَقتِي سُدًى","أُعَلِّمُ الفُرشاةَ أنْ تَفهَمَا",240,"م",2,0],["وهكذا حتى بدت قربَنا","مخلوقةٌ صغيرةٌ زاحفة",241,"ف",2,0],["وهكذا فانطوت بالخير صفحته","واختاره الله كالماضين فانتقلا",242,"ل",2,0],["وهكذا كرّتِ الأيّامُ قاسيةً","بُعدي عن الزّوج , والحُمّى بلوناها",243,"ا",3,0],["وهكذا الدَّهرُ يُعلي مَن يَجِدُّ لهُ","فما تَقَرُّ بنا أحداثُهُ الطُّرُقُ",244,"ق",1,0],["وَهَكَذَاْ يَنْجَحُ الأَعْدَاْءُ فِيْ بَلَدٍ","سَوَّاْقُهَا الْقِرْدُ، وَالْقَرَّاْدُ حَاْدِيْهَاْ",245,"ي",3,0],["وَهَكَذَاْ كَاْنَ صَدَّاْمُ الْفَتَىْ بَطَلاً","وَآلُ صَدَّاْمِ لِلأَوْطَاْنِ خُدَّمُ",246,"م",1,0],["وهَكَذا النَّاسُ حُبُّ المالِ أفْقَدهُمْ","حُلْوَ الخِصَالِ.. فَمَغْدُورٌ وغَدَّارُ",247,"ر",1,0],["وهَكذا كُلَّما حَاولتُ ارْسُمُها","حَمامَةً يَطْلقُ الرَّامي فَتَختَلِفُ",248,"ف",1,0],["وَهَكَذَا أَلْقَاكَ يَا غَائِباً","عَلَى جِدَارٍ مَلَّ مِنْ مَوْقِفِي",249,"ف",2,0],["وهكذا ما حدا حادٍ وما صدحت","ورق لها في غصون الأيك تغريد",250,"د",1,0],["وهكذا من غره نعيمه","فبات في غفلته رهن العمى",251,"ا",1,0],["وهكذا من قديم الدهر قد نسجت","حياةُ دنياك من زورٍ ومن كذب",252,"ب",1,0],["وهكذا الدهر يمضي في عقوبة من","عاشوا طرائق في أوطانهم قددا",253,"د",2,0],["وهكذا يتولى الأقوياء بهم","تنفيذها دون أن يرجو لهم مددا",253,"د",2,0],["وهكذا فرضت دنياك قاعدةً","كن في الحياة قوياً تأمن القودا",253,"د",2,0],["وهكذا صَهَرَتْ نفسي مَحَبَّتُهُ","فأحيَتِ العَزمَ والآمالَ والفِكَرا",254,"ر",2,0],["وَهكَذا النَّاسُ مُذْ كانُوا وَمُذْ خُلِقُوا","وَكُلُّ دَهْرٍ لَهُ قَوْمٌ وَدَوْلاتُ",255,"ت",1,0],["[ وَهكَذا هؤلاءِ المُعْتَدِينَ غَدَوْا","يَوْمَ الكِفاحِ لِذُوبانِ الفَلا جَزَرا ]",256,"ر",2,0],["وَهكَذا الهائِمُ المُشْتاقُ دَيْدَنُهُ","فِي الحُبِّ يَسْتَعْذِبُ التَّعْذِيبَ وَالأَلَما",257,"م",2,0],["وهكذا تم حملي وانتبهت ولم","أفز بشيءٍ سوى شوقي لمرآكِ",258,"ك",1,0],["وهكذا حينما أوفىٰ بعادتِهِ","فاختارَ شهماً له مجدٌ .. وخاطبَهُ",259,"ه",1,0],["وهكذا عيسى جرى أمره","وما رآه القوم من صلبه",260,"ب",2,0],["وهكذا شيمةُ الآباءِ تنكشفُ","هم يعملون لتوحيدِ الألى اختلفوا",261,"ف",3,0],["وهكذا قد قضيناها على أملٍ","نسوحُ والصبر إقبالاً وإدبارا",262,"ر",2,0],["وهكذا عزّنا بالدين يجمعنا","فلا نريد على أثارهم نثبُ",263,"ب",1,0],["وهكذا بقيت حتى الردى لقيت","أوصت توارى بليل في حشى الترب",264,"ب",1,0],["وهكذا تنتهي الأعمارُ تائهة","تُردَى فتوحاتُها الكبرى بأنفاقِ",265,"ق",1,0]]}