{"poems":[[63,"ولوعة بت أخفيها وأظهرها","https://www.aldiwan.net/poem45795.html","البسيط"],[93,"أول ما تلهى به البطون","https://www.aldiwan.net/poem11071.html","الرجز"],[54,"يا معشر الأجناد لا تقنطوا","https://www.aldiwan.net/poem29387.html","السريع"],[88,"عهد الصبا سقيا لأيام الصبا","https://www.aldiwan.net/poem44447.html","الرجز"],[88,"أقوى مصيف القوم والمربع","https://www.aldiwan.net/poem45066.html","السريع"],[51,"لقد رأينا عجبا من العجب","https://www.aldiwan.net/poem8315.html","الرجز"],[51,"عجبت من معشر بعقوتنا","https://www.aldiwan.net/poem8517.html","المنسرح"],[51,"ما القلب في إثرهم بمختطف","https://www.aldiwan.net/poem65441.html","المنسرح"],[91,"يا رب ليل بلا سناء","https://www.aldiwan.net/poem62711.html","عموديه"],[89,"ما للحياة وراء الموت تجديد","https://www.aldiwan.net/poem44788.html","البسيط"],[85,"صحوت واستدركتني شيمتي الأدب","https://www.aldiwan.net/poem7890.html","البسيط"],[85,"ألم عصفور بمجرى صاف","https://www.aldiwan.net/poem8048.html","الرجز"],[43,"قد علم البين منا البين أجفانا","https://www.aldiwan.net/poem10588.html","البسيط"],[62,"ميقات موسى يوم تدبيرنا","https://www.aldiwan.net/poem52172.html","السريع"],[66,"برق المشيب قد أضا","https://www.aldiwan.net/poem40981.html","مجزوء الرجز"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[46,"فويحهم بئس ما ربوا وما حضنوا","https://www.aldiwan.net/poem22385.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85556","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85360","البسيط"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39561","السريع"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[50,"يَا عَبْدَ بَاهِلة َ الذي يَتوعَّدُ","https://www.poetsgate.com/ViewPoem.aspx?id=21776",""],[90,"في اربعين السعدون","https://www.poetsgate.com/ViewPoem.aspx?id=179042",""],[90,"الفرات الطاغي","https://www.poetsgate.com/ViewPoem.aspx?id=179148",""]],"verses":[["وَهَكَذا كُنتَ تَبكي يَومَ ذي بَقَرٍ","وَلَيلَةَ الجِزعِ وَالمَثوى عَلى إِضَمِ",0,"م",1,0],["وهكذا تصفو لنا الأسمار","من بعد أن ينقضي النهار",1,"ر",1,0],["وَهَكذا يَرزُقُ أَصحابَهُ","خَليفَةٌ مُصحَفُهُ البَربَطُ",2,"ط",1,0],["وهكذا أنهار أعمار الورى","تجري فتنصبّ إلى بحر الردى",3,"ا",1,0],["وهكذا الظلمة تتلو الضيا","والضوء للظلمة يستتبع",4,"ع",1,0],["وهكذا كلُّ ارتقاءٍ في العلا","قريبُ عهدٍ بارتقاء في الكُرَبْ",5,"ب",1,0],["وهكذا الجاهلُ قِدماً لم يزل","من جهلِهِ في تَعبٍ وفي نصَبْ",5,"ب",1,0],["وهَكذا هذه الجدودُ لها","إكسير صدقٍ يُعرِّبُ النسبا",6,"ب",2,0],["وهكذا سيرة الجواد إذا","لم يؤت من هجنة ولا قرف",7,"ف",1,0],["وَهَكَذا المُجرِمُ الفِدائي","في عُرفِهِم فاتِحٌ عَظيمُ",8,"م",1,0],["وهكذا المرء شلو في نهايته","وهكذا المرء منه الركن مهدود",9,"د",1,0],["وهكذا أنا في همى وفي هممي","إن الرجال إذا ما حاولوا دأبوا",10,"ب",3,0],["وَهَكَذا العَهدُ بِوُدِّ الناسي","وَقيمَةُ المُحسِنِ عِندَ الناسِ",11,"س",1,0],["وَهَكَذا كُنتُ في أَهلي وَفي وَطَني","إِنَّ النَفيسَ غَريبٌ حَيثُما كانا",12,"ن",2,0],["وهكذا أحجارنا سبعة","لا شك في ذاك ولا لبسُ",13,"س",1,0],["وَهَكَذا جَدَّ أَبو ال","خَيرِ لِإِدراكِ المُنى",14,"ا",1,0],["وَهَكَذا عاقَبَهُ الطُغيانِ","وَطاعَةُ الأَنفُسِ لِلشَيطانِ",15,"ن",1,0],["وَهَكَذا كانَ أَهلُ الأَرضِ مُذ فُطِروا","فَلا يَظُنُّ جَهولٌ أَنَّهُم فَسَدوا",16,"د",3,0],["وهكذا أنا بالأحداث مرتهنٌ","أقطِّع العمر بين الجد واللعبِ",17,"ب",1,0],["وَهَكَذا الأرض حول الشمس دائرة","كَما يَدورُ حَوالي أَرضنا القَمر",18,"ر",1,0],["وَهَكَذا شمسنا صارَت لحالتها","شَمساً تصاعد مِنها النار وَالشرر",18,"ر",1,0],["وهكذا الدنيا خداعٌ عجيب","إذا خلت أيامها من حبيب",19,"ب",1,0],["وهكذا يومٌ ويومٌ سواه","ينكرها القلب الصَّبور الحمول",19,"ل",1,0],["وهكذا يذهب طِيب الحياه","بين التمنّي واعتذار الرسول",19,"ل",1,0],["وهكذا نمضي وتمضي السنون","وهكذا دارت رحاها الطحون",19,"ن",1,0],["وهكذا تمضي ليالي الحياهْ","والقبرُ ما زال على حالهِ",20,"ه",1,0],["وهكذا إنْ قِسْتَهُ التعاقبُ","وليسَ مثلَ ذلكَ التَّراقبُ",21,"ب",1,0],["وة كذاك عبد السوء يشتم ربه","سَفَهاً، ولكِنْ هلْ تُجابُ الأَعْبُدُ؟",22,"د",1,0],["وهكذا الدمع بريئاً يُرى","وهكذا الحزنُ بليغاً يكون",23,"ن",1,0],["وهكذا الناسُ يُغريهم تخيُّلُهم","حتى يَجيئوا الى البَلْوى فيختبروا",24,"ر",3,0]]}