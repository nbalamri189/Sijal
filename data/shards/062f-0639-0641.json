{"poems":[[74,"يا عذولي خلني أغنم عمري","https://www.aldiwan.net/poem18701.html","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55054","الكامل"],[139,"دع في الغرام مقالة السفهاء","https://www.aldiwan.net/poem49114.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122580","الخفيف"],[1200,"","https://poetry.dctabudhabi.ae/diwan/poem/111174","الرمل"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202148","الرمل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53089","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204950","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86294","المتدارك"],[3740,"","https://poetry.dctabudhabi.ae/diwan/poem/123529","الرجز"],[5187,"نغم عذري","https://www.poetsgate.com/ViewPoem.aspx?id=33002",""]],"verses":[["دَع فؤادي والذي يختاره","ما على ظهرك يا عاذلُ وزري",0,"ر",2,0],["دَعْ فَضْلَ ذَاكَ الْعَبْقَرِيَّ وَعِلْمَهُ","وَذَكَاءَهُ وَلِسَانَهُ المِنْطِيقَا",1,"ق",2,0],["دع في الغرام مقالة السُّفَهاءِ","واخلع عذاركَ في هوى العذراءِ",2,"ا",2,1],["دَع فُؤادي بِقُربِه ذَكَّرتني","نَجدَ أيّامُه سَقَى اللهُ نجدا",3,"د",2,0],["دع فؤادي وسنا وجنته","فهو جاء النار كيما يصطلي",4,"ل",2,0],["دع فلسطين لأهليها فما","أنت كفءاً لأباة صادقين",5,"ن",1,0],["دع في المدامة مولع التفنيد","فلقلما تَثْنِي الملامة جيدي",6,"د",2,1],["دع فلسفات من الوجدان فارغةً","تزيد دارسها جهلاً على جهل",7,"ل",1,0],["دَع فَخرَ الآلِ وَذِكرَتهُم","وَاجهد بِمَسيرٍ في الطَلَبِ",8,"ب",1,0],["دَعْ في الأمورِ الحَدْسَ والظُّنونَا","لابُدَّ للمقْدورِ أن يكونَا",9,"ن",2,0],["دعْ فؤادي أينما رحلا","لنْ أرى في حسنها مثلا",10,"ل",2,1]]}