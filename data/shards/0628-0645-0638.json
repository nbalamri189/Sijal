{"poems":[[264,"الشدة عنوان الفرج","https://www.aldiwan.net/poem35545.html","المتدارك"],[264,"قم واستنشق نفح الفرج","https://www.aldiwan.net/poem35830.html","المتدارك"],[264,"باسمك يا الله ربي ابتدي","https://www.aldiwan.net/poem35938.html","الرجز"],[280,"طنب قبابك هذا العز والشرف","https://www.aldiwan.net/poem25479.html","البسيط"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120036","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109400","السريع"],[2747,"","https://poetry.dctabudhabi.ae/diwan/poem/31512","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93887","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91023","الطويل"],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"]],"verses":[["بمظاهر أسماء الحبِّ","بحقيقتك العظمى ربّي",0,"ي",1,0],["بمظاهر أسماءٍ برزت","من فيض الذات إلى الحبج",1,"ج",1,0],["بمَظهَر الأسماء في التجلّي","ومُظهِر الإيماء في التدلّي",2,"ي",1,0],["بِمَظْهَر العَالَمِ العُلْوِيِّ مُتَّصِلٌ","وَباتباعِ هُدى المَهْدِيِّ مُتَّصِفُ",3,"ف",1,0],["بمظهر روح الروح بروح حياته","وأسماؤه أنوار غيب صفاته",4,"ه",1,0],["بمظفر الرايات يشرق رأيه","في كل خطب مظلم الديجورِ",5,"ر",1,0],["بمظهر العرس الذي قد بدا","منهُ على وجه الزمان ابتسام",6,"م",1,0],["بِمَظمَأَةٍ لَيسَت إِلَيها مَفازَةٌ","عَلَيها رُماةُ الوَحشِ مَثنى وَواحِدُ",7,"د",1,0],["بمظهر الجود طابت فيه مختتماً","ومظهري الاصطفا والصدق مفتتحا",8,"ح",2,0],["بمظهر مولود بأشرف طالع","وأبهر معدود من الانجم الزهر",9,"ر",1,0],["بمظهَرَيْ رحمتك الحفيه","من اسمك الرحمن للبريه",10,"ه",1,0],["بمظهر الوحدة اسم الواحد","بالأحد المشهود في المشاهد",10,"د",1,0]]}