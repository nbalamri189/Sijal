{"poems":[[79,"يا مصطفى الرحمان والنور الذي","https://www.aldiwan.net/poem36534.html","الكامل"],[53,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[88,"","https://poetry.dctabudhabi.ae/diwan/poem/20248","الكامل"],[79,"هاجتك إذ جئت اللوى فزرودا","https://www.poetsgate.com/ViewPoem.aspx?id=34092",""],[173,"العز ما خضعت لهيبته العدى","https://www.aldiwan.net/poem1618.html",""],[426,"أبل الرجال أردت إخاءهم","https://www.aldiwan.net/poem4851.html","الكامل"],[463,"وجد الجميم فعافه وتبقلا","https://www.aldiwan.net/poem55960.html","الكامل"],[677,"","https://poetry.dctabudhabi.ae/diwan/poem/198761","الكامل"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90562","الكامل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52034","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27806","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27686","الكامل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130088","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131073",""],[5324,"آه لو تعلم..","https://www.poetsgate.com/ViewPoem.aspx?id=211157",""],[5409,"صوني جمالك بالحياء","https://www.poetsgate.com/ViewPoem.aspx?id=155249",""]],"verses":[["فإذا ظلامُ اللّيلِ مدّ جَناحَهُ","كحّلوا جُفونَ عُيونِهمْ تسْهيدا",0,"د",2,0],["فإذا ظَفِرتَ بحادرٍ","ذي كُدْنَةٍ تَرْضَى وِثابهْ",1,"ب",2,0],["فَإِذا ظَفِرتُ بِكِسرَةٍ","فَإِدامُها مِنّي لُعاب",2,"ب",1,0],["فإذا ظلام الليل مد جناحه","كحلوا عيونهم تسهيدا",3,"د",2,0],["فَإِذا ظَفَرتَ مِن العَدُوِّ بِغرَّةٍ","فاِفتِك فَفَتكُ اليَومُ مَنجاةٌ غَدا",4,"د",2,0],["فَإِذا ظَفَرتَ بِذي اللَبابَةِ وَالتُقى","فيهِ اليَدَينِ قَريرَ عَيٍ فَاِشدُدِ",5,"د",1,0],["فإذا ظفرتَ من الزمانِ بماجدٍ","فأنخْ إليه وكنْ عليه معوِّلا",6,"ل",2,0],["فإِذا ظمئت اليوم بعدك يا أبي","من ذا لسد غليلي اللهفان",7,"ن",1,0],["فإذا ظفِرتَ بِزلَّةٍ فافتَح لها","بابَ التَّجاوُزِ فالتجاوزُ أجدرُ",8,"ر",1,0],["فإذا ظَفِرْتُ بِهِ فإنِّي آمِنٌ","لاأختَشِي جَورَ الزَّمَانِ وإن غَلَبْ",9,"ب",1,0],["فإذا ظفرت به فلست بظافرٍ","وتقول فيما تدعيه محالا",10,"ل",2,0],["فإذا ظهرت لمستوى نعتي له","لم تبد أعلامٌ هناك فواصل",11,"ل",1,0],["فإذا ظهرتَ فأنت قبلة أمّةٍ","وإذا اِستترت ففي قلوبهمُ المَقَر",12,"ر",1,0],["فإذا ظلل الخضم ظلام","خلت أن الكرات فيه بدور",13,"ر",1,0],["فإذا ظاميء القلب رماني","بشواطيك اشتياقي لحياتي",14,"ت",2,0],["فإذا ظللت عن الطريق","أذاق أسرتك العقابا",15,"ب",2,0]]}