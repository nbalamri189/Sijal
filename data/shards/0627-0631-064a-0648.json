{"poems":[[110,"سطا حُسناً","https://www.shoaraa.com/p13815",""],[55,"أرى وجوها وأيمانا مقفلة","https://www.aldiwan.net/poem30515.html","البسيط"],[65,"لحى الله دهرا لا نزال دريئة","https://www.aldiwan.net/poem46103.html","الطويل"],[91,"أرى وجوها غير معروفة","https://www.aldiwan.net/poem44682.html","السريع"],[47,"شهي إلى الأيام تقليلها وفري","https://www.aldiwan.net/poem63634.html","الطويل"],[63,"عفاء على اللذات من بعد فارس","https://www.aldiwan.net/poem51595.html","الطويل"],[83,"عميد أصيب عن عمد","https://www.aldiwan.net/poem61406.html","الطويل"],[48,"وجدت الموت للحيوان داء","https://www.aldiwan.net/poem23353.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85575","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39637","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[121,"الرياض","https://www.aldiwan.net/poem24038.html","البسيط"],[124,"ألا ليت شعري هل لمافات مرجع","https://www.aldiwan.net/poem49309.html","الطويل"],[139,"سلام على عبد السلام ولعنة","https://www.aldiwan.net/poem48851.html","الطويل"],[197,"أرى وصالك لا يصفو لآمله","https://www.aldiwan.net/poem13047.html","البسيط"],[215,"يا جيرة السين يحيا في مرابعكم","https://www.aldiwan.net/poem46332.html","البسيط"],[275,"بكت لفتى يفني قواه تعمدا","https://www.aldiwan.net/poem35632.html","الطويل"],[303,"إذا الشعر لم ينفث به ربه السحرا","https://www.aldiwan.net/poem36848.html","عموديه"],[333,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[411,"أرى وحدة المرء كربا له","https://www.aldiwan.net/poem49789.html","المتقارب"],[580,"أرى واحدا في الحسن ثاني عطفه","https://www.aldiwan.net/poem3050.html","الطويل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39231","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96721","الوافر"],[1317,"","https://poetry.dctabudhabi.ae/diwan/poem/146949","الطويل"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93106","المتقارب"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49983","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108564","الوافر"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66258","المتقارب"],[2105,"","https://poetry.dctabudhabi.ae/diwan/poem/101787","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93599","الوافر"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93566","البسيط"],[2621,"","https://poetry.dctabudhabi.ae/diwan/poem/199844","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205081","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205003","الوافر"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100790","الطويل"],[3585,"","https://poetry.dctabudhabi.ae/diwan/poem/104860","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110059","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91919","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114344","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72490","الطويل"],[4755,"لَقَد عادُوا .. لِماذا لا نَعُودُ ؟!","https://www.poetsgate.com/ViewPoem.aspx?id=187865",""],[5013,"نعى الدين والدنيا فعم ظلامها","https://www.poetsgate.com/ViewPoem.aspx?id=170966",""],[5190,"الطين والماء","https://www.poetsgate.com/ViewPoem.aspx?id=82169",""],[5363,"طوبي ليبيا ابْتسمي","https://www.poetsgate.com/ViewPoem.aspx?id=144294",""],[5444,"كُرَةُ اللَّهَب","https://www.poetsgate.com/ViewPoem.aspx?id=205082",""],[5574,"لقاءٌ بعد فراق السنين!","https://www.poetsgate.com/ViewPoem.aspx?id=206025",""],[5596,"وادي الكرام","https://www.poetsgate.com/ViewPoem.aspx?id=206177",""],[5639,"أرى وطني كعشّ لي ولكن","https://www.poetsgate.com/ViewPoem.aspx?id=89872",""],[5853,"ومض الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=202391",""],[5956,"أرى وجه الإله على الزهورِ..","https://www.poetsgate.com/ViewPoem.aspx?id=192602",""],[572,"أَرى وِصَالَكَ لا يصفُو لآمِلِهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9324&r=&rc=181",""]],"verses":[["أُرى والغيظ فيّ يغيظ حلماً","ويحسب أن جبنا فيّ رابا",0,"ب",2,0],["أَرى وُجوهاً وَأَيماناً مُقَفَّلَةً","فَمُغلَقُ البِشرِ مِنها مُغلَقُ الجودِ",1,"د",1,1],["أَرَى وَجْهَهُ طَلْقاً يُضيءُ جَبينَهُ","وَأَحْسَبُ أَنَّ الصَّدْرَ مِنْهُ رَحيبُ",2,"ب",1,0],["أرى وجوها غير معروفة","كأنني في عالم الرؤيا",3,"ي",2,1],["أَرى وَكدَ دَهري أَن أُقِلَّ وَلا أَرى","لِدَهري جَمالاً ظاهِراً مِثلَ أَن أُثري",4,"ر",2,0],["أرى وَرْدَها ما بين مُودٍ وذابلٍ","وريحانَها ما بين ذاوٍ ويابِسِ",5,"س",1,0],["أَرى وَردَ خَدِّها وَرَّد","دُموعي فَهيَ دَمٌ صِرفُ",6,"ف",1,0],["أَرى وَلَدَ الفَتى عِبئاً عَلَيهِ","لَقَد سَعِدَ الَّذي أَمسى عَقيما",7,"م",2,0],["أَرى وجوهاً لعمري لست أَعرفها","تكاد من غيظها تغلي وتلتهب",8,"ب",1,0],["أرى وجهَها مُشرقاً بالجمالِ","يُطلُّ من الشَّاطئِ الآخرِ",9,"ر",1,0],["أرى ومْضَةَ الشرِّ في جوِّكنَّ","وأسمعُ صوتاً كأنِّي أراهْ",10,"ه",1,0],["أرى، ولكن أرى أبراجَ شامخةً","أعناقُها في خمارِ السُّحْبِ تَمْتَدُّ",11,"د",1,0],["أرى ورق الآمال يذوي فروه","بقربك إن القرب لليأس مصرع",12,"ع",1,0],["أرى وجهك الكسبيَّ ينضح سيرَجاً","ومبسمكَ الألمي مجاري الطحينةِ",13,"ه",1,0],["أَرى وِصالَكَ لا يَصفُو لآملِهِ","وِالهَجرُ يَتبَعُهُ رَكضاً عَلى الأَثَرِ",14,"ر",1,1],["أرى وجوها بصدق الود واعدةً","ولا أرى ظل قلب غير ختّار",15,"ر",1,0],["أرى وجنتيها جنّتين وثغرَها","من الكوثرِ المُحيي ألذَّ وأبردا",16,"د",2,0],["أَرى وَحقيقٌ بالقبول الذي أَرى","بشيئين أَضحى الشعر قد فضل النثرا",17,"ر",2,0],["أرى وجهَها المظلم المدلهم","فمن لي بوجه لها آخر",18,"ر",1,0],["أرى وَحدةَ المرء كَرْباً لَهُ","وعِشْرَةُ ذي النَّقصِ عَينُ الخَبالِ",19,"ل",1,1],["أَرى واحداً في الحسنِ ثانِيَ عِطْفه","يتيه بطرفٍ أَو بتصحيفِ طَرْفِه",20,"ف",2,1],["أُرِي وُشاتيَ أنِّي لَسْتُ مُكْتَرِثاً","لِمَا جَرى وصميمُ القَلْبِ مَصْدوعُ",21,"ع",1,0],["أَرى وصبَ العذابِ من ال","هَوى عذباً لأجلِكُما",22,"م",2,0],["أرى وانياً من عبرة كيف لا يني","وعلَّمَ طرفاً راقداً كيف يسهر",23,"ر",1,0],["أرى واحدي مركزاً للرماح","ومن بعد يوجس قلبي اصطبارا",24,"ر",2,0],["أرى وأنا المغضي كأني لا أرى","وأدري ولا أبدي كأني لا أدري",25,"ر",2,0],["أرى وجناته فتفيض نوراً","فأحسب أنها ملئت جراحا",26,"ح",2,0],["أرى وأجدي مركزاً للرماح","ومَن بعد يوجس قلبي اصطبارا",27,"ر",2,0],["أرى ولد الطائي أصبح يومه","تعظمه الأقوام أكثر من أمس",28,"س",1,1],["أَرى وَرد الشَرائع ساغ فيهِ","وَأَحكم مِن قَواعدها القَرارا",29,"ر",2,0],["أَرى وِشاحك لَم يَبرح بِهِ قَلق","أَهل بَقَلب المَعنىّ جلتَ مُتشحا",30,"ح",2,0],["أرى وجودك هذا لم يكن عبثاً","إلا لتكمل منك النفس فانتبه",31,"ب",2,1],["أرى وجودي ظلما في مجالسهم","إذ أغتدي فوقهم عقلا وهم دوني",32,"ن",2,0],["أرى واديك ممتلئا بحور","فهل واديك جنات النعيم",33,"م",1,0],["أرى وجهه طلقا تجول به المنى","اذا افتر ثغر باسم وجبين",34,"ن",1,0],["أرى وعن اللوم سدت مسامعي","يرق لعيني ما يريق مدامعي",35,"ي",1,0],["أَرَى وجَهَهُ كالشمسِ مزدهرَ الضيا","يَغُضُّ سَناهُ طَرفَ مَن هو شائِمُ",36,"م",1,0],["أَرى واجباً حُزني عَلى غَير جائزٍ","وَجيبَ حشا صبٍّ عَلى الحبِّ جائزِ",37,"ز",1,1],["أرَى وُجُودِي لِقَومٍ لاَ عَدِمتُهُمُ","حَيَاتَهُم وَشِفَاءَهُم مِنَ العِلَلِ",38,"ل",1,1],["أرى وجه صبح العدل بالنور ساطعا","وأقمار آفاق المعالي طوالعا",39,"ع",2,0],["أَرَى وَجهَ الأسيرِ هُناكَ يَرنُو","بطَرفٍ لا يَكِلُّ ولا يَؤودُ",40,"د",1,0],["أرى واحدا كالألف لكن كواحد","الوف وإن لم تحص عدا قتامها",41,"م",3,0],["أَرَى وَجهَكَ الوَضَّاءَ قَد صَارَ شَاحِباً","ومَا بِكَ مِن ضَعفٍ ، ولا هَدَّكَ الوَبَأْ",42,"ا",1,0],["أرى والله بسمتهم","ونور الوجه متَّقدِ",43,"د",1,0],["أرى وَجهَ أُمٍ كان كالبدرِ مُشرِقا","ولكنَّه خلفَ المُعاناة قد غَرب",44,"ب",1,0],["٤- أرى وجْهَ البراءةِ مثلَ طفْلٍ","لهُ انْكسرَتْ عصايَ فجِئْتُ ركْضا",45,"ض",2,0],["أرى ( وادي سمائل (٦) وهو يجري","من ( العليا (٧) الى ( الشهبا (٨) مَصبّا",46,"ب",2,0],["أرى وطني كعشّ لي ولكن","أسافر عنه في طلب المعاش",47,"ش",1,1],["أرى ومض الصباح وقد تبدى","ولكن يمنع الإشراق ليل",48,"ل",1,0],["أرى وجه الإله على الزهورِ","وفي ضوء الكواكب والبُحورِ",49,"ر",1,1],["أَرى وِصَالَكَ لا يصفُو لآمِلِهِ","والهجرُ تتُِبْعُهُ ركضاً على الأَثَرِ",50,"ر",1,1]]}