لَطافَةِ خَصْرِهِ",3,"ر",2,1],["ومُهَنّدٍ تندىً مَضارِبُهُ دَماً","بيدٍ يَنُمُّ بجودِها الإحسانُ",4,"ن",1,0],["ومهَّدَ الأمرَ حتى هزَّ مِنْ طَرَبٍ","إليهِ عِطْفَيهِ ما ولَّى مِنَ الدُّوَلِ",5,"ل",1,0],["وَمَهما يَكُن فَالقَلبُ يا لُبنَ ناشِرٌ","عَلَيكِ الهَوى وَالجَيبُ ما عِشتُ ناصِحُ",6,"ح",1,0],["ومَهْما أفاقَتْ فافْتَحوا لاعتِبارِها","مَصاريعَ أبْوابٍ وأقْفالَ أغْلاقِ",7,"ق",1,0],["وَمَهْمَا تسَاَوى مُطْنِبٌ وَمُقَصِّرٌ","بِحَالٍ فَحُكْمُ النُطْقِ وَالَّصْمِت سِيَّانِ",8,"ن",1,0],["وَمَهْمَا تَعَجَّلتُ الْحُقُوقَ لأَهْلِهَا","فَإِنَّكَ مَوْلاَيَ الْحَقِيقُ وَسُلْطَانِي",9,"ي",1,0],["وَمَهْمَا سَارَ فِي أَمْرٍ مُهِمٍّ","وَجَدَّ السَّيْرَ بُورِكَ مِنْ هُمَامِ",10,"م",1,0],["وَمَهْمَا اسْتَلَّتْ فِي الرِّقَابِ حُقُوقُهُ","فَلاَ يُعْدَمُ الإِبْرَاءُ فِيهَا وَلاَ الْهَضْمُ",11,"م",1,0],["وَمَهِّدِي لِي لَدَيْكِ مُضْطَجَعَاً","فَعَنْ قَرِيبٍ يَكُونُ تَرْحَالِي",12,"ي",1,0],["ومَهْما استَعَنْتَ اللهَ في الأمر وحْدَهُ","أتاكَ بهِ منْ كُلِّ أمرٍ نَجاحُهُ",13,"ح",2,0],["وَمَهِّدِ السُّلْطَانَ فِعْلَ امْرِىءٍ","يُخَلِّفُ الْمُلْكَ لأَعْقَابِهِ",14,"ب",2,0],["وَمَهمَهٍ نازِحٍ قَفرٍ مَسارِبُهُ","كَلَّفتُ أَعيَسَ تَحتَ الرَحلِ نَعّابا",15,"ب",2,0],["وَمَهاً تَرِفُّ غُروبُهُ","يَشفي المُتَيَّمَ ذا الحَرارَه",16,"ر",2,0],["وَمَهِّدي لِيَ قَبراً","عَلى ذُرا لُبنانِ",17,"ن",1,0],["وَمُهَندِسٍ لِلنيلِ باتَ بِكَفِّهِ","مِفتاحُ رِزقِ العامِلِ المِطراقِ",18,"ق",1,0],["وَمُهَفهَفٍ رَقَّت حَواشي خَدِّهِ","فَقُلوبُنا وجداً عَلَيهِ رِقاقُ",19,"ق",1,1],["وَمهينٍ ما زالَ في الناسِ مَحفو","ظاً مناهُ مِن كُلِّهِم حَرفُ جَرِّ",20,"ر",1,1],["وَمُهَوَّسٍ بِالكيمياءِ يُقَطّعُ ال","أَوقاتَ بِالآمالِ وَالتَسويفِ",21,"ف",1,0],["وَمَهمَهٍ طامِسِ الأَعلامِ مُتَّصِلٍ","تَواهَقَت بِيَ في أَجوازِهِ النُجُبُ",22,"ب",1,0],["وَمُهَنَّدٍ يَبدو عَلى صَفحاتِهِ","رَقراقُ ماءٍ فَوقَ نَملٍ ساعِ",23,"ع",1,0],["وَمَهما هَزَزتُ إِلَيكِ العِتابَ","ظاهَرتِ بَينَ ضُروبِ العِلَل",24,"ل",1,0],["وَمُهَنْدِسُ الأَمْصَارِ تَحْكُمُهَا","أُسُساً وَلا تُوَطِّدُهَا",25,"د",3,0],["وَمَهْمَا تَكُنْ عِنْدَ امْرِيءٍ حَاجَةٌ لَهُ","فَلَيْسَ يُدَاجِيهِ وَلَيْسَ يَمِينُ",26,"ن",1,0],["وَمُهَيِّئٍ سَبَبَ لِبَعْضٍ دُونَهُ","مَنْ صَاغَ آيَاتٍ مِنَ الشُّكْرَانِ",27,"ن",1,0],["وَمَهْمَا يَجِدَّ الوَجْدُ فِيهِ فَبَالِغِي","بِهَزْلِكِ حَتَّى تَقْتُلِيهِ تَهَكُّمَا",28,"م",2,0],["وَمَهمَهٍ دَليلُهُ مُطَوَّحُ","يَدأَبُ فيهِ القَومُ حَتّى طَلَحوا",29,"ح",3,1],["وَمَهمَهٍ دَوِّيَّةٍ مِثكالِ","تَقَمَّسَت أَعلامُها في الآلِ",30,"ل",1,0],["وَمُهمُهٍ ناءٍ لِمَن تَأَكدا","مُشتَبَهٍ يُعيي النِعاجَ الأُبَّدا",31,"د",2,0],["وَمهمَهٍ طامِس الأَعلامِ في صَخَبِ ال","أَصداءِ مُختَلِطٍ بِالتُربِ دَيجوجِ",32,"ج",1,0],["وم هنيل إذا انكمل","فبا لمحاسن قد اشتمل",33,"ل",1,0],["ومهما غدا سفّاح سيفك عاريا","يغادر وجهَ الأرض بالدم كاسيا",34,"ي",2,0],["ومُهاجرِ الدين الحنيف وأهلِهِ","حيث استقر به الأمان دخيلا",35,"ل",2,0],["ومهما سألت البرق يهفو من الحمى","يبادرُهُ دمعي مُجيباً وسائلا",36,"ل",2,0],["ومهما أغاروا منجدين صريخَهُمُ","يشبُّون نارَ الحرب في الغور والنَّجدِ",37,"د",1,0],["ومهذّب لم تلق في","أوصاف سيرته غميزه",38,"ز",2,0],["ومّهدت الأمور لنا ففزنا","من الآمال بالغرر العزاز",39,"ز",1,0],["وَمُهري لايَمَسُّ الأَرضَ زَهواً","كَأَنَّ تُرابَها قُطبُ النِبالِ",40,"ل",1,0],["ومهابةٍ سكنَ الزمانُ بها","عن خائفيهِ وكانَ ذا شغب",41,"ب",1,0],["ومهجتي في ضلوعي من جوى وضنا","حمَّالة الهمِّ أو حمَّالة الحطب",42,"ب",1,0],["ومهاة تعدّ نعمان داراً","واللوى والعقيقَ صدغاً وخدَّا",43,"د",2,0],["ومهيبٌ لو يلمح الدّمَ لم يخ","رج من العرق حين يفصد فصدا",43,"د",2,0],["ومهما وضعت المنّ في مستحقه","فوالله ما مدت إليك يد الأذى",44,"ذ",2,0],["ومهابة ذابت لها الفرسان ذوْ","ب مدامع فلأجل ذا تتفطر",45,"ر",1,1],["ومهجةٌ ليَ كم ألقت بمسمعها","إلى الملامِ ولا والله ما قبلت",46,"ت",1,0],["ومهجة كلَّما فاهت بلوعتها","قالت رزيَّة مولاها لها إيه",47,"ي",2,0],["ومهما تَبَّ من عملٍ وقولٍ","فما عملُ ابنِ مدحِك للتَّبابِ",48,"ب",1,0],["ومهما شكا الشاكون من جور دهرهم","فليس مُريباً معشراً دون معشر",49,"ر",1,0],["ومهما يصنْه الناس عن غير أهله","فغير مصون عنك يا ابن المدبرِ",50,"ر",1,0],["ومهَفهَفٍ تمت محاسِنُهُ","حتى تجاوز منيةَ النفسِ",51,"س",1,1],["ومهّدت مضجعي يداهُ فقد","لاءمَ جنبيّ بعد إقضاضه",52,"ض",2,0],["ومهما أقلْ فيكم فإني أخوكُمُ","على كلّ حالٍ من مريرٍ ومن سحلِ",53,"ل",1,0],["ومهما فعلتَ فأنكرته","فأنت أبا الصقر في الجملَهْ",54,"ل",2,0],["ومهما أخِمْ عنه فلست عن التي","تُبلِّغني آمالَ نفسي بخائمِ",55,"م",1,0],["وَمَهمَهٍ طامِسٍ تُخشى غَوائِلُهُ","قَطَعتُهُ بِكَلوءِ العَينِ مِسهارِ",56,"ر",1,0],["وَمُهراقُ الدِماءِ بِوارِداتٍ","تَبيدُ المُخزِياتُ وَلا تَبيدُ",57,"د",1,0],["وَمُهَفهَفٍ بَينَ القُلو","بِ وَبَينَ مُقلَتِهِ هَزاهِز",58,"ز",1,0],["وَمُهَفهَفٍ كَالغُصنِ في حَرَكاتِهِ","حُلوِ القَوامِ رَشيقِهِ مَيّادِهِ",59,"د",2,1],["وَمَهدُ المَرءِ في أَيدي الرَواقي","كَنَعشِ المَرءِ بَينَ النائِحاتِ",60,"ت",1,0],["وَمُهاجِرينَ تَنَكَّرَت أَوطانُهُم","ضَلّوا السَبيلَ مِنَ الذُهولِ وَهاموا",61,"م",3,0],["وَمَهدَ العُلومِ الخَطيرَ الجَلالِ","وَعَهدِ الفُنونِ الجَليلَ الخَطَر",62,"ر",1,0],["وَمَهمَهٍ جُبتُهُ عَلى قَدَمي","تَعجِزُ عَنهُ العَرامِسُ الذُلُلُ",63,"ل",1,0],["وَمُهجَةٍ مُهجَتي مِن هَمِّ صاحِبِها","أَدرَكتُها بِجَوادٍ ظَهرُهُ حَرَمُ",64,"م",1,0],["وَمُهَذَّبٌ أَمَرَ المَنايا فيهِمِ","فَأَطَعنَهُ في طاعَةِ الرَحمَنِ",65,"ن",1,0],["ومهما صفا من ظلام الرسوب","طار إلى الجو نورا لطيفا",66,"ف",2,0],["ومهِّد لنا في عريشِ الكُروم","فَثمَّ لعمري عروشُ الكرامِ",67,"م",1,0],["ومَهابةٌ ممزوجةٌ بمحبَّةٍ","دانتْ لها الأشرارُ والأخيَارُ",68,"ر",1,0],["وَمَهيبٌ عِندَ المُناجينَ لَولا","كَرَمُ الأُنسِ كانَ هَولاً خِطابُه",69,"ب",2,0],["وَمَهما تَنَم في ظِلِّ بَيتِكَ عاجِزاً","تُصِبكَ خُطوبُ الدَهرِ مِن حَيثَ لا تَدري",70,"ر",2,0],["وَمُهتَزَّةِ الأَعطافِ نازِحَةِ العَطفِ","مُنَعَّمَةِ الأَطرافِ فاتِرَةِ الطَرفِ",71,"ف",1,1],["وَمُهَذَّبُ الأَخلاقِ يَعطِفُهُ النَدى","عَطفَ الجَنوبِ مِنَ القَضيبِ المورِقِ",72,"ق",1,0],["وَمَهزوزَةٍ هَزَّ القَضيبِ إِذا مَشَت","تَثَنَّت عَلى دَلٍّ وَحُسنِ قَوامي",73,"م",2,0],["وَمُهيجُ هَيجاءٍ يُبَلِّغُ رُمحَهُ","صَفَّ العِدى وَالرُمحُ خَمسَةُ أَذرُعِ",74,"ع",1,0],["وَمَهاوِلٍ دونَ العُلا كَلَّفتَها","خُلُقاً إِذا ضَرَّ النَدى لَم يَنفَعِ",74,"ع",1,0],["وَمُهمِلَةٍ لَمّا أَتاها نَعِيُّهُ","أَراحَت عَلَيها مُهمِلاتِ التَنايِفِ",75,"ف",1,0],["ومهذب الأخلاق تكثر عنده","تحف المدائح هذبت تهذيبا",76,"ب",2,0],["ومَهاً تُريكَ اللَّيلَ صُبْحاً مُشْرِقاً","بجمالِها والصُّبحَ ليلاً مُظْلِما",77,"م",2,0],["ومهنَّدٌ كلُّ الضَّرا","ئبِ عندَ هَزَّتِهِ مَفاصِل",78,"ل",1,0],["ومُهَفهَفٍ لو كنتُ أَملِكُ أمرَه","بدَّلْتُ سُحْمَ مُسوحِه بقَراطقِ",79,"ق",1,0],["ومُهَفْهَفٍ كالشَّمسِ سالَمَ نورُه","ظُلَمَ الدُّجى أو كالقضيبِ تَعَطُّفا",80,"ف",2,0],["ومهفهَفٍ هفَتِ العقولُ به","شَغَفاً تخيَّرَهُنَّ أحورُه",81,"ر",2,0],["ومهاً تَكتُمُ البَراقِعُ مِنْها","صُوَراً هُنَّ للعُيونِ صِوارُ",82,"ر",1,0],["وَمَهما تَكُن عِندَ اِمرِئٍ مِن خَليقَةٍ","وَإِن خالَها تَخفى عَلى الناسِ تُعلَمِ",83,"م",1,0],["وَمَهما دَمتُ في الدُنيا حَريصاً","فَإِنّي لا أُوَفَّقُ لِلصَوابِ",84,"ب",1,0],["وَمَهمَهٍ قَد قَطَعتُ طامِسَهُ","قَفرٍ عَلى الهَولِ وَالمُحاماةِ",85,"ه",1,1],["وَمَهما لَم يَكُن في السَيفِ أَصلٌ","لِجَوهَرِهِ فَما يُجدي الصِقالُ",86,"ل",1,0],["وَمَهمَهٍ كَسَماءِ الدَجنِ مُعتَكِرٍ","نَواظِرُ الأُسدِ في ظَلمائِهِ شُهُبُ",87,"ب",1,0],["ومهاً نَظَرَتْ ونواظرُها","وَصَلتْ دمناً وجفت دمنا",88,"ن",2,0],["ومهاً نَظَرَتْ ونَوَاظرُها","خُلِقَتْ لنواظرنا فتنا",88,"ن",2,0],["وَمَهمَهٍ مُتَّصِلٍ بِمَهمَهٍ","مَرْتٍ بِموَّاجِ السراب مُتْرعِ",89,"ع",1,0],["ومُهنّدٍ عَجَنَ الحَديد لقينه","في الطّبع نيرانٌ مُلِئْنَ رياحَا",90,"ح",2,1],["ومهما كبَا بي فمن نشوَةٍ","يوافِقُها بين كأسٍ وكوبِ",91,"ب",1,0],["ومهنّدٍ مثلِ الخليجِ تَصَفّقَتْ","طُرُقُ النسيمِ عليه من تَشْطِيبهِ",92,"ب",2,0],["وَمَهاً مِن مَهى الخُدورِ وَآجا","لِ ظِباءٍ يُسرِعنَ في الآجالِ",93,"ل",1,0],["وَمُهَفهَفِ الساقي قَريبِ جَنى النَدى","عَفِّ النَديمِ سَريعِ سَعيِ الطاهي",94,"ه",2,0],["ومهفهفٍ يَسقي السلافَ كأنما","مِنْ مقلتيهِ ووجنتيهِ يديرُها",95,"ر",3,0],["وَمُهَفهَفٍ طاوي الحَشا","خَنِثِ المَعاطِفِ وَالنَظَر",96,"ر",1,1],["وَمَهما نَأى غامَت عَلَيَّ سَماؤُهُ","وَجادَت بِصَوبٍ لِلغَضاضَةِ هامِرِ",97,"ر",1,0],["وَمَهما لَثَمتُ الأَرضَ شَوقاً لِلَحدِهِ","وَجَدتُ ثَراها طَيِّبَ المُتَنَشَّقِ",98,"ق",1,0],["وَمَهَبُّ نَفحَةِ رَوضَةٍ مَطلولَةٍ","في جَلهَتَيها لِلنَسيمِ مَجالُ",99,"ل",1,0],["وَمَهما نَبغِ مِن شَرَفٍ وَمَجدٍ","فَأَنتَ بِهِ كَفيلٌ أَو ضَمينُ",100,"ن",1,0],["وَمَهما حَمِدنا مِن عُهودٍ وَأَعصُرٍ","فَلَن نَحمَدَ العَهدَ البَغيضَ المُذَمَّما",101,"م",2,0],["وَمَهلاً فَإِنّي العامَ إِن أَهجُ نَشَلاً","وَجَدِّكَ لا يَسلَم عَلَيَّ أَديمُها",102,"م",3,0],["وَمَهمَهٍ كَرِداءِ العَصبِ مُشتَبِهٍ","قَطَّعتُهُ وَالدُجى وَالصُبحُ خَيطانِ",103,"ن",1,0],["وَمُهَنَّداً مِن عَهدِ عادٍ صارِماً","إِن يَطَّلِب إِتلافَ نَفسٍ يَبلُغِ",104,"غ",1,0],["وَمَهمَهٍ رَحيبٍ","ظَمآنَ يُضني السَفَرا",105,"ر",2,0],["وَمُهلِكَةٍ لامِعٍ آلُها","قَطَعتُ بِحَرفٍ أَمونِ الخُطا",106,"ا",1,0],["ومَهَّدَهُ للسَّالِكِينَ مِنَ الأَذَى","فليسَ به الأعمى إذا سارَ يَعْثُرُ",107,"ر",1,0],["ومُهَنّدٌ فيهِ الفِرنْدُ كأنّهُ","ذِمْرٌ لَهُ خَلفَ الغِرار كَمين",108,"ن",1,0],["ومهما طلبتَ دليلَ الكرامِ","فإنّ الدّليلَ ائِتلافُ الهوَى",109,"ا",1,0],["وَمُهَفهَفٍ نَبَّهتُهُ لَمّا هَدا","وَتَغَلَّقَت عَيناهُ بِالإِغفاءِ",110,"ا",2,0],["وَمَهمَهٍ جِزتُهُ مُخاطَرَةً","بِصَحصَحانِ السَرابِ قَد سُربِل",111,"ل",1,0],["وَمَهمَهٍ نازِحٍ تَعوي الذِئابُ بِهِ","نائي المِياهِ عَنِ الوُرّادِ مِقفارِ",112,"ر",1,0],["وَمَهلِكُ دَولَةٍ وَقِيامُ أُخرى","كَذاكَ الدَهرُ أَمرٌ بَعدَ أَمرِ",113,"ر",1,0],["وَمَهما يَكُن فَاللَهُ لَيسَ بِزائِلٍ","وَيَجني الفَتى مِن بَعدُ ماهُوَ غارِسُ",114,"س",1,0],["وَمَهما كانَ في دُنياكَ أَمرٌ","فَما تُخليكَ مِن قَمَرٍ وَشَمسِ",115,"س",1,0],["وَمَها الصَوّانِ أَدالَها مُتَخَتِّلٌ","وَرَأى المَليكُ عَدُوَّها فَأَدالَها",116,"ل",3,0],["وَمَهلاً بَني الوَرهاءَ ما كانَ فيكُمُ","رَشيدٌ وَلا أَنتُم بِأَهلِ مَعالي",117,"ي",1,0],["وَمَهمَهٍ مُقفِرِ الأَعلامِ مُنجَرِدٍ","نائي المَناهِلِ جَدبِ القاعِ مِنزاحِ",118,"ح",1,0],["وَمَهما يَقُل فِينَا العَدُوُّ فَإِنَّهُم","يَقُولُونَ مَعرُوفاً وَآخَرَ مُنكَرا",119,"ر",2,0],["وَمَهاما يَقُل فينا العَدُوُّ فَإِنَّهُم","يَقولونَ مَعروفاً وَآخَرَ مُنكِرا",120,"ر",2,0],["ومهاجرٍ ضاقتْ به أوطانُه","وتأثَّرتْهُ مخاوفُ الطرداءِ",121,"ا",2,0],["ومهما يكن يحسبْه حشاً على الندى","فيغدو على أمواله بالغوائل",122,"ل",1,0],["وَمَهْمَا تُجَشِّمْهُمُ الوَاجِبَا","تُ مِنَ المَطْلَبِ الصَّعْبِ لا يُحْجِمُوا",123,"م",3,0],["وَمَهْمَا يُعَدْ فِي صَيْغَةٍ بَعْدَ صِيغَةٍ","مُقَارِبَةٍ لَمْ نَشْكُ مِنْ مُسْتَعَادِهِ",124,"د",2,0],["ومهلهلَ الطرفِ الحسانِ","كأنها مرت بلا إثم على الأقداح",125,"ح",1,0],["وَمَهما خِلتَني يَنساكَ قَلبي","فَخُذ عَهدي وَلا تَخَف اِنتِقاضا",126,"ض",2,0],["وَمَهما كُنتُ في شَكٍّ","مِنَ الأَشياءِ أَيقَنَها",127,"ن",3,0],["وَمُهجَتُهُ مِن مُهجَتي فَمَدامِعي","سلوهُنَّ أَيُّ المُهجَتَينِ تَسيلُ",128,"ل",1,0],["وَمُهَفهَفٍ عَقَدَ الشَرابُ لِسانَهُ","فَحَديثُهُ بِالرَمزِ وَالإيماءِ",129,"ا",2,0],["ومهبطَ الحكمةِ، والفنون","كوني مقرِّي، أو فلا تكوني",130,"ن",2,0],["ومهرُ المجد -إن تَخْطُبْه- غَال","وبَعْضُ المَهْرِ مَوْتٌ واحتضار",131,"ر",1,0],["ومهلاً فظلمٌ لهذا الجمال","نمر عليه بلحظٍ سريع",132,"ع",1,0],["ومهدِّدي بالشرِّ يُنذرني","إن لم أُطِعْه بسوءِ مُنقلَب",133,"ب",1,0],["ومَُهدُكِ وهو مهبِطُ كُلِّ وحيٍ","كنعشكِ وهو مُشتَجرُ الرِماح",134,"ح",1,0],["ومهدتُ لي عيشاً أنيقاً بظلها","ومتعتُ نفسي منه ثم الأقاربا",135,"ب",2,0],["ومهونٍ وجدي عَدَتْهُ لواعجٌ","اخرسن ناطقَ عذله لو ذاقها",136,"ق",3,0],["ومهر المنى سوق من الموت حرة","بها يرخص النفس العزيزة بائع",137,"ع",1,0],["وَمَهْزُوزَةٍ، هَزَّ القَضِيبِ، إذا مشتْ","تَثَنّتْ على دَلٍّ، وَحُسْنِ قَوَامِ",138,"م",1,0],["ومهما تنم في ظل بيتك عاجراً","تصبك خطوب الدهر من حيث لا تدري",139,"ر",2,0],["ومهما كبا بي فمن نسوة","يوافِقُها بين كأسٍ وكوبِ",140,"ب",1,0],["ومهند مثل الخليج تصفقت","طُرُقُ النسيمِ عليه من تَنْشِيطهِ",141,"ه",1,0],["ومهَّدَ للجُنوب بخير كفٍّ","مَضاجعَها فكلُّ الأرض مَهْدُ",142,"د",1,0],["ومَهْلاً فَإِنِّي العَامَ إِنْ أهْجُ نَهْشَلاً","وجدِّكَ لاَ يسلمْ عليَّ أديمُها",143,"م",3,0]]}