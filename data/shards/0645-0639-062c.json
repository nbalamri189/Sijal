{"poems":[[55,"ما للبياض والشعر","https://www.aldiwan.net/poem30486.html","مجزوء الرجز"],[55,"كربلا لا زلت كربا وبلا","https://www.aldiwan.net/poem30772.html","الرمل"],[74,"بنوا وسكنا ثم نبني ويسكنوا","https://www.aldiwan.net/poem20202.html","الطويل"],[93,"طوي العام كما يطوى الرقيم","https://www.aldiwan.net/poem8820.html","عموديه"],[91,"انت في شعر كان فتحا مبينا","https://www.aldiwan.net/poem44626.html","الخفيف"],[91,"ما انت الا نادره","https://www.aldiwan.net/poem44632.html","مجزوء الرجز"],[45,"وزيارة عن غير موعد","https://www.aldiwan.net/poem9545.html","مجزوء الكامل"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140912",""],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54935","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54860","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54933","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142069","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43862","الرمل"],[113,"وقاريء يمعن في درسه","https://www.aldiwan.net/poem16474.html","السريع"],[136,"يالدهر قمنا به في أمان","https://www.aldiwan.net/poem54711.html","الخفيف"],[136,"رسم ربع بجانب الينبوع","https://www.aldiwan.net/poem54803.html","الخفيف"],[164,"أهلا بطرس من إمام مدته","https://www.aldiwan.net/poem59120.html","الرجز"],[333,"هو ناي حرم الشدو","https://www.aldiwan.net/poem55025.html","مجزوء الرمل"],[369,"زد علوا في كل يوم ورفعه","https://www.aldiwan.net/poem60844.html","الخفيف"],[369,"كلما اشتقت يا خليلي نجدا","https://www.aldiwan.net/poem60932.html","الخفيف"],[396,"الحمدلله لا يحصى على الله ثناه","https://www.aldiwan.net/poem54453.html","عموديه"],[422,"من لصب مستطار القلب هائم","https://www.aldiwan.net/poem53954.html","الرمل"],[449,"عوذت بالله إمام العصر","https://www.aldiwan.net/poem56033.html","عموديه"],[463,"لعلها واليأس منها أغلب","https://www.aldiwan.net/poem56283.html","الرجز"],[466,"سأبعثها بين البيوت شوازيا","https://www.aldiwan.net/poem15127.html","الطويل"],[520,"خاطر فإن الحظ للمخاطر","https://www.aldiwan.net/poem12123.html","الرجز"],[556,"يا صاح ليس لسر منك كتمان","https://www.aldiwan.net/poem47188.html","البسيط"],[563,"سنة نبي مختار","https://www.aldiwan.net/poem34235.html","منهوك المنسرح"],[566,"أما ورب البيت لو لم أشغل","https://www.aldiwan.net/poem27840.html","الرجز"],[567,"لا تلوميه في الهوى واعذريه","https://www.aldiwan.net/poem52968.html","الخفيف"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[580,"مرت كبارقة السحاب","https://www.aldiwan.net/poem3100.html","مجزوء الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122825","الكامل"],[879,"","https://poetry.dctabudhabi.ae/diwan/poem/107038","الكامل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25345","الرجز"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56694","الخفيف"],[1467,"","https://poetry.dctabudhabi.ae/diwan/poem/136777",""],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128698","الخفيف"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82654","الخفيف"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87834","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96026","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53174","الخفيف"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100915","الطويل"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93405","الرمل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140096",""],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104680","الرمل"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147339","البسيط"],[3337,"","https://poetry.dctabudhabi.ae/diwan/poem/203546","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88915","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74062","الخفيف"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101225","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216785","الخفيف"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59493","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40103","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86495","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123506","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123498","المنسرح"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123495","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123484","الرمل"],[4203,"","https://poetry.dctabudhabi.ae/diwan/poem/105533","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90884","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83545","السريع"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133170","الكامل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83119","الخفيف"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83148","الرجز"],[3163,"","https://poetry.dctabudhabi.ae/diwan/poem/123455","الخفيف"],[4755,"الكَفُّ، والجَوَّالُ، والمَبسَمُ","https://www.poetsgate.com/ViewPoem.aspx?id=191248",""],[4926,"يا دليل الرَّكب إلى نجدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=171110",""],[5081,"إِنَّ بَعْدَ الْعُسْرِ يُسْرَا","https://www.poetsgate.com/ViewPoem.aspx?id=187727",""],[5136,"صافحت ريح الصبا روض الخزامى","https://www.poetsgate.com/ViewPoem.aspx?id=121655",""],[5277,"لا تمسحِ الدمعَ","https://www.poetsgate.com/ViewPoem.aspx?id=195072",""],[5338,"« يا رسول الله خذ بيدي »","https://www.poetsgate.com/ViewPoem.aspx?id=187760",""],[5442,"ليس بعد السبعين إلا الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=114787",""],[5461,"لا تملين الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=5023",""],[5675,"ما روضة دبج أزهارها ال","https://www.poetsgate.com/ViewPoem.aspx?id=170615",""],[5722,"النهر الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=12693",""],[5848,"معجبك هالحال","https://www.poetsgate.com/ViewPoem.aspx?id=52023",""],[119,"ضارعت زفرة الذنوب بكائي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55607&r=&rc=4",""],[463,"لعلها واليأسُ منها أغلبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59974&r=&rc=30",""]],"verses":[["مُعِجِلَةٌ فُرسانُها","حَتّى عَنِ الدَرعِ تُزَر",0,"ر",1,0],["مُعجَلاتٍ لا يُوارينَ ضُحى","سُنَنَ الأَوجُهِ أَو بيضَ الطُلى",1,"ا",1,0],["معجّل نعمى حيث شكو مؤمل","وأنى يوفي دينه المتدين",2,"ن",1,0],["مُعجِزاتٍ ما أَتاها الأَنبِياء","لا وَلَم يَطمَح إِلَيها الأَقدَمون",3,"ن",1,0],["معجزات وراءها معجزات","آمنت اعجابا بها الألباب",4,"ب",1,0],["معجب بالهزار كل بني الارض وان","لم يكن سوى عصفور",4,"ر",1,0],["معجزة بالغة","من معجزات القاهره",5,"ر",2,0],["مَعَجَت بِنا فيها الجِيا","دُ مَعَ الأَميرِ أَبي مُحَمَّد",6,"د",1,0],["مُعجزُ القَوْلِ والفِعَالِ كريمُ ال","خلقِ وَالخُلْقِ مُقْسِطٌ مِعْطاءُ",7,"ا",2,0],["معجت بنا فيا الجيا","د مع الأمير أبي محمد",8,"د",1,0],["مُعْجِزَاتٌ فِي كلِّ آن تَرَاهَا","بَاهِرَاتِ التنْويعِ وَالتَّغْيِيرِ",9,"ر",1,0],["مُعْجِزَةٌ جَاءَ بِهَا مُقْدِمٌ","لاَ فَائِلُ الرَّأْيِ وَلاَ غِمْرُ",10,"ر",1,0],["مُعْجِزَاتٌ مِنَ البِنَاءِ كِبَارٌ","لأُنَاسٍ مِلْءَ الزَّمَانِ كِبَارِ",11,"ر",1,0],["معجزات الزَّمان منكم ومنِّا،","زِنَّ جيد الوجوه والدَّهْرُ طفل",12,"ل",1,0],["مُعجَبٌ كَالمُتَنَبّي","وَهوَ لا يَحسُنُ شَيّا",13,"ي",2,1],["معجم يَشبَه بَدر الدُجى","مُكور الشَمس عَلى رَأسِهِ",14,"س",2,0],["مَعَ جَيدَاءَ لا تُذِيقُ حَمِيماً","غَيرَهُ مِن صَابِ الصَّرِيمَةِ آنِ",15,"ن",1,0],["مَعَ جَهلِ البَيَانِ والعَقدِ والنَّحوِ","وَجهلٍ لِلُّغَى وجَهلِ الفُرُوعِ",16,"ع",1,0],["معجبا من سائل قد جاءه","محولقا محسبلا من حرقته",17,"ت",2,0],["معجز الباكين وهو العب","قريّ الضحكات",18,"ت",1,0],["مُعْجِزٌ آمنَتْ به فُضَلاءُ الدْ","دَهْرِ طُرّاً له وللفَضْلِ شِرْعه",19,"ع",2,0],["مُعجِزاتٌ للنّاطِقين فلولا","ما لَهُ من ديانةٍ لتَحَدّى",20,"د",2,0],["مع جنان خلقها ربنا لأولياه","ثم على الشخص فرض أن يعلم نساه",21,"ا",2,0],["مُعْجَبٌ من حُسنْه مبتسمٌ","يُودعُ اللؤلؤَ هاتيك المباسم",22,"م",1,0],["مع جوها إلى النجوم الزهر","إلى اقاصي ما جرى في فكر",23,"ر",1,0],["معجِزةٌ جاء الزمانُ غلطاً","بها وآيٌ كلهُّنَّ عَجَبُ",24,"ب",1,0],["معجْنَ بفتيانٍ كأنَّ قُلوبهمْ","إذا عصفوا بالدارعين الجلامدُ",25,"د",1,0],["معجزة في مدين وخيبر","صارت له برهان فصل باهر",26,"ر",1,0],["معجّلِ الخيلِ والهيجاءُ ضاحيةٌ","عن أن تُناط بها لُجْمٌ وأرسانُ",27,"ن",1,0],["مع جملة الأطهارْ","آل وصحب ثمْ",28,"م",1,0],["مَعجَ المَرامي عَن قياسِ الأِشكَلِ","مِن قُلقُلاتٍ وَطُوالٍ قُلقُلِ",29,"ل",1,0],["مُعجِزاتٌ في الفِعلِ مُمكِنةٌ في ال","قَولِ لكن بعيدةُ التشبيه",30,"ي",2,0],["مع جملة الناس وراء الوادي","وقال للصائح قم فنادي",31,"ي",1,0],["معجزُ القولِ منه قد طَبَّق الآ","فاق بالسِّير تَارَةً والوَثْبِ",32,"ب",1,0],["مَعَجَت بِنا لُغبُ المُطيِّ بِأَجوَفٍ","مَرتٍ بِهَزَّةِ رَكبِهِ وَمَطيِّهِ",33,"ي",2,0],["مع جده الهادي النبي وآله","في أنعم تترى بفيض اجزل",34,"ل",1,0],["مَعْجاً وَإِن أَغْرَقْنَ شَدّاً أَغْرَقَا","يَجِدْنَهُ فِي وَلْقِهِنَّ مِيلَقا",35,"ق",2,0],["مع جد مسيره لارتفاع","وشباب مصيره لانحدار",36,"ر",1,0],["معجزاتٌ كلها حكمٌ","بيناتٌ لم تكن بدعا",37,"ع",2,0],["معجز اللفظ ذو بيان بديع","ومعان جلّت عن الإحصاء",38,"ا",2,0],["مُعجَبٌ عِند نَفسهِ","وَهو لي غَير مُعجِبِ",39,"ب",1,1],["مُعجِزاتٌ مِنَ البَيانِ تَجَلَّت","في قَريضٍ يَسبي النُهى بِجَمالِه",40,"ل",2,0],["معجزات ملؤ العوالم لكن","كن من نفسه نظير ابتلاها",41,"ا",3,0],["معجباً بالذي اتاه من الخطب","وقد يعجب السفيه السفاها",42,"ا",3,0],["معجزات نار الجوانح منها","تتلظى بالأدمع الهطاله",43,"ل",2,0],["معجلةٌ فى نفسها لمريدِها","بأكثرَ ممَّا عجَّلت كفُّ مجتدى",44,"د",2,0],["مُعجَمُ الحُسنِ بِخالينِ عَلى","ثَغرِهِ الأَصغَر وَالخَدِّ الأَجل",45,"ل",1,1],["مع جعفر مع زيد كيف تقتلوا","وابن الوليد واخذه بالراية",46,"ه",1,0],["معجزٌ للإنس والجن معاً","عصمة اللَه لمن رام اعتصاما",47,"م",2,0],["مَعْجُونَةٌ بِكِتَابِ اللهِ أَنْفُسُهُمْ","وفِيْ السَّمَاءِ بِحُورِ اللهِ رُصِّعَتِ",48,"ت",1,0],["معجزة للمصطفى محمد","واضحة تقمع كل معتد",49,"د",1,0],["معجم مهمل لنصفيهما تا","ريخ زاك برب خير بيدر",50,"ر",1,1],["معجزاتُ الأَقوالِ لَم تَكُ شَيئاً","وَزنوها بمعجزاتِ فعاله",51,"ل",2,0],["معجزات في الطرس آيات قدس","حل في طيها مني الأرواح",52,"ح",1,0],["معجزات على يديك نراها","كل يوم ولا نحاول عدّا",53,"د",2,0],["مَعجِتَ به هوجُ الرياح الزُّجلِ","وبه اسبكرَّ بفيض كلّ مجلجلِ",54,"ل",1,0],["معجزٌ صَحَّ لي به إن تنَبَّأْ","تُ وما قد أتيتُ بالبرهانِ",55,"ن",1,0],["معجز من محمد الحسن الندب","حمى الركب من حمى الركب ريعا",56,"ع",2,0],["معجزات النبي من شامها الحصر","فباالحصر صار في حاص باص",57,"ص",1,0],["معجزة أعجز الورى عددا","فمن بغى حصر بعضها حصرا",58,"ر",2,0],["معجزات النبىّ جلت عن الحصر","بلفظ أو رقمها بمداد",59,"د",1,0],["معجزات المصطفى خير الورى","معجزات كلّ من قد حسبا",60,"ب",2,0],["معجز ثبت النبوة لو لا","أنها في النبي أحمد تختم",61,"م",1,0],["معجزات أتت من ابن نبي","عجزت عن تبيانه الثقلان",62,"ن",1,0],["مُعجِزَةٌ لِلسَّيدِ الأعظَمِ","شَهدتُها وَالغَيرُ عَنها عمي",63,"م",2,1],["مع جملة الأصحاب والآل كذا","أتباعهم أهل المثاني والثنا",64,"ن",2,0],["مُعجِزاتُ النبي علمٌ وَهَذا","مُعجِزٌ بِالجَهالَةِ المَفتونَه",65,"ن",2,0],["مُعجِزَةُ الحُسنِ بِها","لكُلِّ عَينٍ ظاهِرَه",66,"ر",2,0],["معجزاتٌ عن مثلها كلَّ ذي زعمٍ","كما أعجزتْ عن الإحصاء",67,"ا",2,0],["مَعجُونَةٌ بالعِطرِ تَهمِي كَمَا","يَهمِي شَذَاهُ (الرَّنْدُ) و(العَنْدَمُ)",68,"م",1,0],["معجزات المختار لا تحصى","كم صدورٍ منها إكتست شرحا",69,"ح",2,0],["مُعْجِزَاتٌ سَابِحَاتٌ","فِي فُيُوضِ الْحُبِّ تَتْرَى",70,"ر",2,0],["معجزات جحدوها حسداً","وعلى علم تعامى من لغاما",71,"م",2,0],["معجلٌّ فيك مهرُ العمرِ,وا كبدي","يموتُ جوعاً وما وافيتَ منقلبا",72,"ب",2,0],["مُعْجِزَاتٍ مِنْهُ ظَاهِرَةً","لَمْ يَحُزْهَا قَبْلُ مِنْ أَحَدِ",73,"د",1,0],["معجزات لا يدرك العدا أدنا","ها وهل يدرك الغمام الهطول",74,"ل",1,0],["مع جميع الناس وافكاري وحيده","شالوا ألحاني وانا شلت المعاني",75,"ن",2,0],["معجز شعر محكم آيه","أبياتها منها عليها شهود",76,"د",1,0],["معجباتٍ أنقى من الفن لألآ","ءً وأبهى من سطعةِ العلم فكرا",77,"ر",2,0],["معجبك هالحال ؟؟ أنا ماهوب معجبني !","تغيب وآغيب وانسى انك بتنساني",78,"ن",2,1],["معجزات أفحمن كل عدو","وأفضن الإحسان للأولياء",79,"ا",2,0],["معجزة ٌ جاء الزمانُ غلطا","بها وآوى ٌ كلهنَّ عجبُ",80,"ب",1,0]]}