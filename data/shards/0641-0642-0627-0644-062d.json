{"poems":[[87,"قد سمع الثعلب أهل القرى","https://www.aldiwan.net/poem8006.html","السريع"],[87,"فأر رأى القط على الجدار","https://www.aldiwan.net/poem8031.html","الرجز"],[275,"نراودها عجوزا دردبيسا","https://www.aldiwan.net/poem35298.html","الوافر"],[447,"يا عارضا بات مثل العرق بارقه","https://www.aldiwan.net/poem14429.html","البسيط"],[458,"حلمت ولم أعلم أحلمى يقظة","https://www.aldiwan.net/poem61799.html","الطويل"],[543,"جرى الدمع في مقلتي إذ جرت","https://www.aldiwan.net/poem48278.html","عموديه"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86821","البسيط"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126123","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46509","الرجز"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89538","البسيط"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121182","البسيط"],[2446,"","https://poetry.dctabudhabi.ae/diwan/poem/21212","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94564","البسيط"],[4429,"","https://poetry.dctabudhabi.ae/diwan/poem/138862",""],[5183,"أقصوصة الروض","https://www.poetsgate.com/ViewPoem.aspx?id=180289",""],[5191,"زائرُ المنام","https://www.poetsgate.com/ViewPoem.aspx?id=212020",""],[5410,"رأيت وجدي لقلبي إرث إعمار","https://www.poetsgate.com/ViewPoem.aspx?id=151722",""],[5413,"لست أدري","https://www.poetsgate.com/ViewPoem.aspx?id=208618",""],[5703,"اللقاء الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=206134",""],[6117,"سطوة الحمى","https://www.poetsgate.com/ViewPoem.aspx?id=183708",""],[6147,"عيون الورق.","https://www.poetsgate.com/ViewPoem.aspx?id=151504",""]],"verses":[["فَقالَ حَقّاً هَذِهِ غايَةٌ","في الفَخرِ لا تُؤتى وَلا تُطلَبُ",0,"ب",1,0],["فَقالَ حَقّاً هَذِهِ كَرامَه","غَنيمَةٌ وَقَبلَها سَلامَه",1,"ه",1,0],["فقالَ حَبَستُها دَهراً فلانت","وكانت قبلُ ثائرةً شَمُوسا",2,"س",2,0],["فقال حرمته عندي كحرمتكم","لا تقتلوه فإِني الآن عاتقه",3,"ق",2,0],["فقال حرام أنَّ مثلك كادحا","يُضام ويُجزَى التيه ما بين ألغام",4,"م",1,0],["فقال حبيبي ماذا البكا","وأنت ضجيعي وماذا النحيبُ",5,"ب",1,0],["فَقال حينَ بَدا مَجدي يُؤرخه","محمد قَد أَتى بِاليُمن وَالبِشر",6,"ر",1,0],["فقال حمدالله خير نطق","وشكره فرض مبين الحق",7,"ق",1,0],["فَقالَ حَتَّى يَسمَع الصَّياد","لنفسه وَفَهمُه المُرادُ",8,"د",1,0],["فَقالَ حاشا وَكَلّا لا أَقولُ بهِ","لِأَنَّهُم وَزَرا جَدّي وَأَصهارُ",9,"ر",1,0],["فقال حدثني الشيخ المؤرخ عن","جدى المحدث عن ابائه النجبا",10,"ب",2,0],["فقال حين أتانا منطقاً عجباً","يقِفُّ منه أعالي الجلدِ والشعر",11,"ر",1,0],["فقال حيي أفد لبنان مُذَّكراً","عمّا سمعت وما عاينت أخبارا",12,"ر",2,0],["فقال حطو ففي هذي الفلات لقد","نبئت انا نلاقي اعظم النوب",13,"ب",1,0],["فقال حسبك فاختاري لنفسك من","ترضينه لا لقيت العمر مكروها",14,"ه",2,0],["فقال: حلمٌ ووهمٌ","ما أبعدَ الحبَّ مِنّا!!",15,"ن",2,0],["فقال: حَسْبُكَ إني جنّة عَبَرَتْ","كلَّ القيود بأحلامٍ وأنوارِ",16,"ر",1,0],["فقال حين تخطى درب حيرته","\"في اللاهنا \"أوقفوني وقفة الرسل",17,"ل",1,0],["فقالَ حُبُّكِ مثلَ الشمسِ يَغْمُرني","فما استطعتُ لشَمسِ العشْقِ كتْمانا",18,"ن",2,0],["فقال: حُمَّى وداءٌ لستُ أعْرِفُهُ","حتَّى أُحلِّل ما فِي الْقَلْبِ والكَبِدِ",19,"د",1,0],["فقال حبيبي بكل ارتياح:","إذا ما كتمْتَ لسان الشفقْ",20,"ق",1,0]]}