{"poems":[[51,"لاح شيب الرأس مني فاتضح","https://www.aldiwan.net/poem62030.html","الرمل"],[113,"أصبح الملك للذي فطر الخلق","https://www.aldiwan.net/poem16182.html","الخفيف"],[208,"أشموس أم بدور","https://www.aldiwan.net/poem53299.html","مجزوء الرمل"],[369,"طلعت نجوم الدين فوق الفرقد","https://www.aldiwan.net/poem60958.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138340",""],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87272","الرمل"],[783,"","https://poetry.dctabudhabi.ae/diwan/poem/145549","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63867","الرجز"],[1183,"","https://poetry.dctabudhabi.ae/diwan/poem/18218","الرمل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132384","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94289","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93993","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201767","الوافر"],[3369,"","https://poetry.dctabudhabi.ae/diwan/poem/117044","الرمل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74078","المنسرح"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109986","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77086","الخفيف"],[4530,"","https://poetry.dctabudhabi.ae/diwan/poem/20958","الرمل"],[4767,"النهج الأصيل","https://www.poetsgate.com/ViewPoem.aspx?id=179919",""],[4814,"طعم الغزل","https://www.poetsgate.com/ViewPoem.aspx?id=195095",""],[5190,"هو التاريخ شاهدنا","https://www.poetsgate.com/ViewPoem.aspx?id=175249",""],[5431,"لليمن الحبيب /لزوم مالا يلزم","https://www.poetsgate.com/ViewPoem.aspx?id=196908",""],[5470,"كتبتُ عينيك","https://www.poetsgate.com/ViewPoem.aspx?id=10983",""],[5895,"عُيُونُكِ قالَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=202651",""],[5956,"الحمد لله على إرساله لمحمد","https://www.poetsgate.com/ViewPoem.aspx?id=192571",""],[5957,"غَرِيبة","https://www.poetsgate.com/ViewPoem.aspx?id=12235",""],[6038,"الاقصى","https://www.poetsgate.com/ViewPoem.aspx?id=27219",""],[6102,"وَمَضَينا!","https://www.poetsgate.com/ViewPoem.aspx?id=182771",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"]],"verses":[["بِنَبيٍّ فَتَحَ اللَهُ بِهِ","كُلَّ خَيرٍ نِلتُموهُ وَشَرَح",0,"ح",1,0],["بِنَبي بَعثَتهُ فَهَدانا","لِصِراط مِن الهُدى مُستَقيمِ",1,"م",1,0],["بنبات النَّرجس الغَض","ضِ لنا تمَّ السرورُ",2,"ر",1,0],["بِنَبِيِّنا الهادي وسلطان الورى","ووزيره القرمِ الكريم المَحتِد",3,"د",1,0],["بنبوغهم وبجدهم ظفرت بما","يصبو الفؤاد إلى اجتناه شيقا",4,"ق",2,0],["بِنبال مِن سُمومِ","لِلحَشا في الحَرب تفري",5,"ي",1,0],["بنبي الهدى وحق ذويه","ساءني ما رأيتك اليوم فيه",6,"ي",2,1],["بِنَبَزٍ أقْبِح بذاك من نَبَز","واعتاضَ حجَّاماً أذُلاَّ بعد عِزّ",7,"ز",1,0],["بِنَبِيِّ اللَهِ وَاِبنَي عَمِّهِ","وَبِعَبّاسِ بنِ عَبدِ المُطَّلِب",8,"ب",1,0],["بِنِبالِ اليراعِ أدركَ ما لَم","تدركَنهُ المُلُوكُ بالمُرَّانِ",9,"ن",1,0],["بنبال الأهداب يصمي الرمايا","ويبيح الدماء سفحا وسفكا",10,"ك",2,0],["بن بالسلامة من بانات ذي سلم","ودع غدائر ذات الغدر لو سبغت",11,"ت",1,0],["بنبذ الشعر قد باهت ولكن","تتاجر باسم تذكار المعرّي",12,"ر",2,0],["بنبي قرشي","شافع يوم الأمان",13,"ن",1,0],["بن بالأيادي جسامها وأجب","غرّك يوم السؤال يختَبئُ",14,"ا",1,0],["بُنبي بأَنَّ الجِسمَ لم يَخضَع لهُ","بل انهُ شَرِسٌ وليسَ مروَّضا",15,"ض",2,0],["بِنُبل أَلحاظِهِ وَلَمعِ الثَنايا","تِلكَ سِيافَة وَذي طِعانَه",16,"ن",2,0],["بِنِبالٍ كُلُّها مَذروبَةٌ","لَم يُطِق صَنعَتَها إِلاّ صَنَع",17,"ع",1,0],["بنبعٍ ماؤه يجري زلالاً","ليحيي غرسه بعد الذبول",18,"ل",1,0],["بنبضي أرصّعُ ثوبَ الحروفِ","فينضجُ شِعري بطعمِ الغزلْ",19,"ل",1,0],["بِنَبضِ القَلبِ قُلنَاهَا","وأَغلَقَ شَانِؤوهُ فَمَا",20,"م",2,0],["بنبوغٍ مميزٍ لايُضاهى","دررٌ في عباءة الخطباء",21,"ب",3,0],["بِنَبضِ قَلبي كَتبتُ الشِّعرَ, لاقَلَمِي","في صَفحَةِ الوجدِ لا في صَفحَةِ الكُتُبِ",22,"ب",1,0],["بِنَبْضٍ تَوحَّدَ بينَ الحَنَايا","وَصَمْتٍ تمزقَ وَقْتَ الغُروبْ",23,"ب",1,0],["بنبيٍّ خاتَمٍ للأنبياءْ","بِنَقِيٍّ مثلِ غيمات الفضاءْ",24,"ا",2,0],["بنبضيَ تسري بقايا احتراق","وقلبي يئن ودمعي يثور",25,"ر",1,0],["بنبرة حزن يا عساف ماني بخير","واكيد العلم اللي صار جالك",26,"ك",1,0],["بِنَبِيذِ اللَّثمِ حَتَّى سَكِرَتْ","تِلكُمُ الأَنجُمُ مِمَّا سَكِرا",27,"ر",2,0],["بِنَبيّ يملي عليه وَيقري","وهو طوع القضاء بالعزم يجري",28,"ي",1,0]]}