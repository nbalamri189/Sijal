{"poems":[[110,"خليلي","https://www.shoaraa.com/p11134",""],[55,"طلاب العز من شيم الشجاع","https://www.aldiwan.net/poem30155.html","الوافر"],[65,"سرى البرق وهنا فاستحنت جماليا","https://www.aldiwan.net/poem45947.html","الطويل"],[65,"أتيحت لداء في الفؤاد عضال","https://www.aldiwan.net/poem46130.html","الطويل"],[65,"أثرها وهي تنتعل الظلالا","https://www.aldiwan.net/poem46214.html","الوافر"],[57,"ألا فانظري بالله يا سكني الوعدا","https://www.aldiwan.net/poem26406.html","الطويل"],[57,"تجافى مرفقاي عن الوساد","https://www.aldiwan.net/poem26422.html","الوافر"],[56,"أمطلب دع دعاوى الكماة","https://www.aldiwan.net/poem27635.html","المتقارب"],[56,"غصبت عجلا على فرجين في سنة","https://www.aldiwan.net/poem28546.html","البسيط"],[29,"بان الخليط غداة الجناب","https://www.aldiwan.net/poem5783.html","المتقارب"],[29,"ألا حي المنازل والخياما","https://www.aldiwan.net/poem6017.html","الوافر"],[74,"أذات الحجى إن الحجاب ليمنع","https://www.aldiwan.net/poem19171.html","الطويل"],[53,"ليوقن من يعارضني بأني","https://www.aldiwan.net/poem65446.html","الوافر"],[53,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[87,"سلو قلبي غداة سلا وثابا","https://www.aldiwan.net/poem63783.html","الوافر"],[64,"بنفسي من أودعتها الترب راغما","https://www.aldiwan.net/poem52284.html","الطويل"],[30,"إليك سمت يا ابن الوليد ركابنا","https://www.aldiwan.net/poem5010.html","الطويل"],[68,"سلوا بعد تسآل الورى عنكم عني","https://www.aldiwan.net/poem41581.html","الطويل"],[82,"بلى جر أذيال الصبا وتصابى","https://www.aldiwan.net/poem31543.html","الطويل"],[82,"هل أقصر الدهر عن تعنيت ذي أدب","https://www.aldiwan.net/poem31565.html","البسيط"],[83,"شكا بالعتب مضناك","https://www.aldiwan.net/poem61407.html","الهزج"],[41,"طربت وشاقك البرق اليماني","https://www.aldiwan.net/poem53730.html","الوافر"],[41,"ألا إن سلمى عن هوانا تسلت","https://www.aldiwan.net/poem53811.html","الطويل"],[77,"هنالك عهدي بالخليط المزايل","https://www.aldiwan.net/poem69044.html","الطويل"],[48,"قبيح أن يحس نحيب باك","https://www.aldiwan.net/poem22339.html","الوافر"],[48,"أرى كل أم عبرها غير مبطئ","https://www.aldiwan.net/poem22528.html","الطويل"],[48,"أواني هم فألقى أواني","https://www.aldiwan.net/poem23545.html","المتقارب"],[70,"شربنا على ذكر الحبيب مدامة","https://www.aldiwan.net/poem1525.html",""],[1,"","https://poetry.dctabudhabi.ae/diwan/poem/199405","الطويل"],[111,"ألا هل لداعي الله في الأرض سامع","https://www.poetsgate.com/ViewPoem.aspx?id=103",""],[92,"احمد شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=179129",""],[56,"غصبتَ عجلاً على فرجينِِ في سنة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=13989",""],[82,"بلى ، جرّ أذيال الصبا وتصابى","https://www.poetsgate.com/ViewPoem.aspx?id=3019",""],[124,"أناديك لو رد النداء رميم","https://www.aldiwan.net/poem49281.html","الطويل"],[147,"سما بك دهرك فليفتخر","https://www.aldiwan.net/poem11765.html","المتقارب"],[154,"حروب النوى والقرب فيك سجال","https://www.aldiwan.net/poem68535.html","الطويل"],[164,"إذا كان من عاداك يصبح نادما","https://www.aldiwan.net/poem58900.html","الطويل"],[164,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[170,"إذا كان من عزمي التقدم في العلا","https://www.aldiwan.net/poem47133.html","الطويل"],[189,"إذا كان عقبى ما يسوء التصبر","https://www.aldiwan.net/poem14545.html","الطويل"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[202,"شهدت بأن الورد لو أعطي المنى","https://www.aldiwan.net/poem51961.html","الطويل"],[207,"دعوت إلى خطة خالدا","https://www.aldiwan.net/poem68167.html","المتقارب"],[234,"يا عذبة الرشف هل لمكتئب","https://www.aldiwan.net/poem50892.html","المنسرح"],[275,"جبينك لاح فجرا في حماك","https://www.aldiwan.net/poem35421.html","الوافر"],[285,"يقيني يقيني حادثات النوائب","https://www.aldiwan.net/poem60788.html","الطويل"],[368,"سمونا بالجياد إلى أعاد","https://www.aldiwan.net/poem1714.html","الوافر"],[369,"بما عن من شكوى زمان تعرضا","https://www.aldiwan.net/poem60860.html","الطويل"],[443,"سرى الطيف وهنا والرقاد مرنق","https://www.aldiwan.net/poem2618.html","الطويل"],[449,"فؤاد ما تعداكم","https://www.aldiwan.net/poem55963.html","عموديه"],[520,"هي الصدمة الأولى فمن بان صبره","https://www.aldiwan.net/poem12130.html","الطويل"],[556,"تلوم وقد لاحت طوالع شيبتي","https://www.aldiwan.net/poem47861.html","الطويل"],[580,"تنزه طرفي بين زاه وزاهر","https://www.aldiwan.net/poem3073.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122722","المتقارب"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87207","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48752","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48518","الوافر"],[918,"","https://poetry.dctabudhabi.ae/diwan/poem/107323","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64687","المتقارب"],[1296,"","https://poetry.dctabudhabi.ae/diwan/poem/178097","الوافر"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132850","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49976","الطويل"],[1838,"","https://poetry.dctabudhabi.ae/diwan/poem/104119","الطويل"],[1873,"","https://poetry.dctabudhabi.ae/diwan/poem/73011","الوافر"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52028","الطويل"],[1993,"","https://poetry.dctabudhabi.ae/diwan/poem/199033","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28514","الطويل"],[2404,"","https://poetry.dctabudhabi.ae/diwan/poem/32585","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93666","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203046","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65482","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100774","الوافر"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130125","الطويل"],[3451,"","https://poetry.dctabudhabi.ae/diwan/poem/123481","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62838","الوافر"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138601",""],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45743","الطويل"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34658","الوافر"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114490","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114058","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135234","الطويل"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4739,"ذنوب الجفا","https://www.poetsgate.com/ViewPoem.aspx?id=28115",""],[4819,"إتعلم","https://www.poetsgate.com/ViewPoem.aspx?id=27932",""],[4927,"حَدِيْثُ الدُّمُوْع","https://www.poetsgate.com/ViewPoem.aspx?id=29724",""],[557,"في عينيك عنواني","https://www.poetsgate.com/ViewPoem.aspx?id=7677",""],[5431,"وما أحلى فنائيَ في هواكم","https://www.poetsgate.com/ViewPoem.aspx?id=185660",""],[5582,"أَمِنْ دِمَنٍ مَعالِمُها قِفارُ","https://www.poetsgate.com/ViewPoem.aspx?id=63510",""],[5956,"الذبحُ الرَّاحم ‏","https://www.poetsgate.com/ViewPoem.aspx?id=183394",""],[6031,"أكفُّ البَرَايَا مِنْ تُرَاثِهِمُ صُفْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=46279",""],[6069,"وقفت مع العشاق في كل موقفٍ","https://www.poetsgate.com/ViewPoem.aspx?id=105709",""],[6224,"طواف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88194&r=&rc=9",""]],"verses":[["ولو خبر الآحاد ينسخ آية","لساغ لنا طعن الصحيح بمرسل",0,"ل",1,0],["وَلَو خَلَّيتَ عَنّا في رِهانٍ","تَبَيَّنَتِ البِطاءُ مِنَ السِراعِ",1,"ع",1,0],["وَلَوْ خَالفَتْ في الحُبِّ وَهْيَ كَريمَةٌ","عَلَيَّ يَمِيني فَارَقَتْها شِمَالِيا",2,"ل",3,0],["ولو خالَفَتْني في مُتابعةِ الهَوى","يَميني ما واصَلْتُها بِشمالي",3,"ل",2,0],["ولَو خَبِرَ البَرِيّةَ مَنْ رَجاهُمْ","لَشَد على مَطِيَّتِه العِقالا",4,"ل",2,0],["وَلَو خَيَّرونيها وَخُلداً مُنَعَّماً","تَخَيَّرَها قَلبي وَلم يَختَرِ الخُلدا",5,"د",2,0],["وَلَو خِفتُ القَطيعَةَ حَيثُ حَلَّت","رَضيتُ بِأَن تُقيمَ عَلى البُعادِ",6,"د",1,0],["وَلَو خَصَّ بِالرِزقِ نَجلُ الكِرامِ","لَما نِلتَ خَيطاً وَلا هُدبَه",7,"ب",2,0],["وَلَو خَطَبتَ إِلى طَوقٍ وَأُسرَتِهِ","فَزَوَّجوكَ لِما زادوكَ في حَسَبِك",8,"ك",1,0],["وَلَو خُيِّرَ القَينُ بَينَ الحَياةِ","وَبَينَ المَنيَّةِ لَاِختارَها",9,"ر",3,0],["وَلَو خَرَجَت أُمامَةُ يَومَ عيدٍ","لَمَدَّ الناسُ أَيدِيَهُم قِياما",10,"م",2,0],["ولو خيِّرت لم ترضَ إلاَّ بقاءَه","ونقلتها فليهنها القصد أجمع",11,"ع",1,0],["ولو خصم سواك أراد ظلمي","لأسمعت الأصمَّ له حفيفا",12,"ف",2,0],["ولو خفت فوتاً بادرتْ بي عزيمةٌ","لها فرسٌ عندي من الجدّ مُلْجَمُ",13,"م",1,0],["وَلَو خُلِقَت قُلوبٌ مِن حَديدٍ","لَما حَمَلَت كَما حَمَلَ العَذابا",14,"ب",2,0],["ولو خيَّروني بين كفِّي وبينَها","لآثرتُ أن تبقَى وأُصبِحَ أجذمَا",15,"م",2,0],["وَلَو خَلَّدَ الفَخرُ اِمرَأً في حَياتِهِ","خَلَدتَ وَما بَعدَ النَبِيُّ مُخَلَّدُ",16,"د",1,0],["وَلَو خَطَّ صَرفُ الدَهرِ طِرساً لِقَصدِهِ","لَخَطَّ عَلى العُنوانِ مِن عَبدِهِ القِنِّ",17,"ن",1,0],["ولو خضبَ الأيدي نداهُ رأيتمُ","لكلّ يدٍ بالتّبرِ منْه خضابا",18,"ب",2,0],["ولو خلا الدّهرُ ذو الأبناءِ من عَجَبٍ","أكثرْتُ منه ومن أبنائِهِ عَجبي",19,"ب",2,0],["وَلَو خُيِّرتُ في الشَكوى","إِذَن أَودَعتُها فاك",20,"ك",1,0],["وَلَو خَلَّيتُ لِلشُعراءِ وَجهي","لَما اِكتَبَلوا يَدَيَّ وَلا لِساني",21,"ن",2,0],["وَلَو خَرَجَ الدَجّالُ يَنشُدُ ذِمَّةً","لَزافَت تَميمٌ حَولَهُ وَاِحزَأَلَّتِ",22,"ت",1,0],["ولو خُلِّدَتْ لم أقضِ منْها لُبانَةً","وكيْفَ ولم تَخْلُدْ لبكرِ بن وائل",23,"ل",1,0],["وَلَو خُيِّرتُ لَم أَترُك مَحَلّي","فَأَسكُنَ في مَضيقٍ بَعدَ رَحبِ",24,"ب",1,0],["وَلَو خُلِقَت أَجسادُنا مِن صَبارَةٍ","لَقَلَّ عَلى كَرِّ الحَوادِثِ صَبرُها",25,"ر",3,0],["وَلَو خُلِقا مِثلَ خَلقِ الجِيادِ","رَأَيتَهُما في المَدى يَكبُوانِ",26,"ن",1,0],["ولو خُضِبت من كأسِها كفُّ لامسٍ","لمَا ضَلّ في لَيْلٍ وفي يَدِهِ النجم",27,"م",1,0],["ولو خطرت أبناء قرآن حوله","لأضحى على ما كان يطلب قادرا",28,"ر",2,0],["ولو خالست منه العلائق لفتة","كفاها من التوفيق عنه ممانع",29,"ع",1,0],["ولو خافَ مثلَ سِواه العُبُور","لخابَ وزلَّ ولكنْ عَبَر",30,"ر",1,0],["ولو خطبتَ إلى طوقٍ وأسرتهِ","وَزَوَّجوكَ لما زَادُوكَ في حَسَبِكْ",31,"ك",1,0],["ولو خضب الأيدي نداه رأيتم","ولم أرَ كالدّنيا خؤوناً لصاحبٍ",32,"ب",1,0],["ولو خير الأموات ما اختار واحدٌ","حياةً ولا قال الحمام ذميم",33,"م",1,0],["وَلَو خُلِقَت قَبلَ أَن يَنزِلَ ال","كِتابُ أَتى ذِكرُها في السُوَر",34,"ر",1,0],["ولو خفَّ شجوى لمحةً طرتُ نحوكم","ولكن أعباءَ الفراقِ ثٍِقَال",35,"ل",1,0],["ولو خلى الباغي عليك ورايه","لما كان إلا ناصحا لك خادما",36,"م",2,0],["ولو خلته ميتا وكنت دفنته","لخيف عليها منك قطع الدوابر",37,"ر",1,0],["ولو خاف تهديدَ الفرزدقِ مِرْبعٌ","لخفتُ ولكن لا يُرى الخوفُ من دَأبي",38,"ب",2,0],["ولو خَلَّف الموتُ امرأً لجَلاله","لكان بها أَوْلَى وأَحْرَى المُظَفَّر",39,"ر",1,0],["وَلَو خيّروا في فعلِ ذلكَ مُسلماً","وَأُنثاهُ لاِختارا على فعلهِ القَبرا",40,"ر",2,0],["وَلَو خُيّرَت نَفسي بهجركِ والغِنى","لَكان اِختياري فيكِ أَن أصحبَ الفقرا",40,"ر",2,0],["ولو خُيِّر الرَّيْحانُ لاختارَ صُدْغَهُ","وإنْ أصبحَ الريحانُ يحكي الزبرجدا",41,"د",2,0],["وَلَو خالِدٌ عادَ في مِثلِها","لَتابَعَهُ عُنُقٌ وارِدُ",42,"د",1,0],["ولو خَشِيتِ الإلهَ ما فَتَكت","بابن وَصِيِّ النَّبي عيناكِ",43,"ك",1,0],["ولو خُيِّرتُ في سَعدي ونحسي","دخلتُ جهنَّماً ولثمتُ فاك",44,"ك",1,0],["وَلَوْ خَطَرتْ بِي فِي ضَمِيرِكَ خَطْرَةٌ","لَعَادَتْ بِتَصْدِيقِ الظُّنُونِ الكَواذبِ",45,"ب",1,0],["وَلَو خِفناكَ ما كُنّا بِضُعفٍ","بِذي خُشُبٍ نُعَرِّبُ وَالكُلابِ",46,"ب",1,0],["ولو خَلصتْ لي من فؤاديَ شُعبةٌ","من الهمِّ لَم أَذكُرْ سوى ساكني الغَضا",47,"ض",2,0],["ولو خفقت عيني به لم تفض له","دموعي ولا قلبي لذكراه يخفق",48,"ق",1,0],["ولو خيرت ما جور","ت في العالم إلا كم",49,"م",1,0],["ولو خلف ابناً واحداً سيد الورى","لما حاز ميراث الخلافة صهره",50,"ر",2,0],["وَلَو خلّدتْ لي خالةٌ معْ تولّع ال","ليالي بأحوالي لكنتُ المخلّدا",51,"د",2,0],["ولو خَاطَرونِي أَنَّ فِي الدَّهر مثلَهم","لكَان مآلي أَخْذَ رَهْنِ الْمُخاطرِ",52,"ر",1,0],["وَلَو خَرَجُوا مَعَكُم في الجِهادِ","مازادَكُم ذَاكَ إلا خَبالا",53,"ل",2,0],["وَلَو خَيروني بَين أَهلي وَبَينه","لَما اِختَرتُ في شَرع الصَبابة إِلّا هو",54,"ا",3,0],["ولو خلت لكمُ أوطانكم لرضوا","لكنها لغزاة حولها ضربوا",55,"ب",3,0],["ولو خان البلاد اعتضْنَ عنه","محيَّاك المبارك والبنانا",56,"ن",2,0],["ولو خُيِّرَت نهدُ المكارمِ في فتىً","لكانَ لِعَبدِ اللَهِ يَبدُو اختِيارُها",57,"ر",3,0],["وَلَوْ خالَطَتْ حُرُقاتُ الجَوى","لَهَبَّ لَها في ضُلوعي لَهَبْ",58,"ب",1,0],["ولو خُيِّرت في أمرٍ أمَّرُ","من المُرِ لما اخترت أمري",59,"ر",2,0],["ولو خانَه فرعونُ آمناً طائعاً","وإن لم يُعد موسى العصا حيَّةً تَسعىَ",60,"ع",2,0],["ولو خلتَ أعلى منه قدراً وشيمةً","لكنتَ عليه دونَ غَيرك أقدرا",61,"ر",2,0],["ولو خفت أني أن كففت تحيتي","تنكب عني رمت أن يتنكبا",62,"ب",2,0],["وَلَو خَوَّفتُمُ أَعلامَ رَضوى","لَما سَكَنَت وَلا وَجَدَت قَرارا",63,"ر",2,0],["ولو خَفيِتْ أعدَادُهَا عَنْ عِداتِهَا","لما غَالَطُوا إذْ أوقَدوا نارَ كَاذِبِ",64,"ب",1,0],["ولو خفقت تحت العجاج بنودهم","لكانت لها الشم الرعان تهايل",65,"ل",1,0],["وَلَو خالَفَت أَفلاكُها ما تُريدُهُ","لأَنزَلَها قَسراً إِلَيكَ مُديرُها",66,"ر",3,0],["وَلَو خِفتُ شَرّاً فَاِستَترِتُ بِظُلمَةٍ","لَأَقبَلَ ضوءُ الشَمسِ مِن حَيثُ تَغرُبُ",67,"ب",1,0],["وَلو خَلَت مِنكُم الأَيام لانقلبت","تسوي السَما بِها وَالأَرض تَنخسف",68,"ف",1,0],["ولو خبروا السكر المقدس مزقت","محاكمهم والحكم والكتب والهذر",69,"ر",1,0],["ولو خيّرت بين الجحيم وبينهُ","أولي النّار لاختارُوا الجحيم عليه",70,"ه",1,0],["ولو خيرتنا من قبل كانت","نفوس الخلق اجمعهم فداء",71,"ا",2,0],["ولو خالَطت شَخصاً لرفعةِ قدرهِ","نجومٌ لأضحى في ذراكَ وجودُها",72,"د",3,0],["ولو خرجت عما به قد تعودت","لنالت شفاء الروح من كل علة",73,"ه",1,0],["ولو خيّرتنا ما اخترتُ عَيْشاً","يكونُ له فَناءٌ وانقِضاءُ",74,"ا",2,0],["ولو خيروني في المقام أو السرى","اقمت ولم اخش السباع الضواريا",75,"ي",2,0],["وَلَو خالَفوكم ما تَخلف مِنهُم","عَلى الأَرض إِلا صارِخات النَوادب",76,"ب",1,0],["ولو خالفته لم يخش قتلي","وقنعني سريعاً بالحُسام",77,"م",1,0],["ولو خمرُها بغيرِ ذكرِك مزجُهُ","لما ساغَ لي وكُنتُ عنِّي مدافعه",78,"ع",2,0],["وَلَو خَلاَئِقُهُ عَلَى الخَلاَئِقِ قَد","فُضَّت لَمَا طَلَبَ الشَّيطَانُ إِنسَاءَ",79,"ا",2,0],["ولو خوف تطويل من القول زدتكم","ولكنّه ما ضرّ ذو الحقِّ بالعدِّ",80,"د",1,0],["وَلَو خَطَرَت في أَسوَدِ اللَيلِ نَملَةٌ","عَلى صَخرَةٍ صَمّا فَإِنّي مُطالِعُ",81,"ع",1,0],["ولو خُطا الوقت تظما بدرب الأمل","باقي في السما غيمة ممطره",82,"ر",2,0],["ولو خيرك عليه سابق","وكان عايش بإحسانك",83,"ك",1,0],["وَلَوْ خَيَّبَ الأَحْبَاْبُ  فِي الْحُبِّ  ظَنَّهُ","كَمَاْ خَيَّبَ الْعُذَّاْلُ  بِالْعَذْلِ  مُدْنَفَاْ",84,"ف",2,0],["ولو خيرت في وطن","لقلت هواك أوطاني",85,"ن",2,0],["ولو خُيّرْتُ بين لظى حنيني","وبرئي منك لأخترتُ العذابا",86,"ب",2,0],["[ وَلَو خُلِقَتْ عُلاكَ لَنا سَماءً","لَما فِي البَعْثِ حَلَّ لَها انْفِطارُ ]",87,"ر",1,0],["ولو خَيَّرْتني من قبلِ خَلْقي","لقلتُ إليك : لا ، أَرجوكَ ربِّي",88,"ب",2,0],["ولو خَلَّدَ المعروفُ في الناسِ وَاحِداً","لَخلَّدَ عبدَاللهِ نَائِلُهُ الغَمْرُ",89,"ر",1,0],["ولو خاف من يسري إلى ظل مجده","ضلالاً لناداه الندى من أمامه",90,"م",2,0],["ولو خُيّرت يمنايَ بينكِ والدنا","لأقبلتُ نحوَ العشقِ لا أتحيَّرُ",91,"ر",1,0]]}