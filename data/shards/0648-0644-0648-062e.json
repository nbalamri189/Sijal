{"poems":[[53,"طلاب العز من شيم الشجاع","https://www.aldiwan.net/poem30155.html","الوافر"],[63,"سرى البرق وهنا فاستحنت جماليا","https://www.aldiwan.net/poem45947.html","الطويل"],[63,"أتيحت لداء في الفؤاد عضال","https://www.aldiwan.net/poem46130.html","الطويل"],[63,"أثرها وهي تنتعل الظلالا","https://www.aldiwan.net/poem46214.html","الوافر"],[55,"ألا فانظري بالله يا سكني الوعدا","https://www.aldiwan.net/poem26406.html","الطويل"],[55,"تجافى مرفقاي عن الوساد","https://www.aldiwan.net/poem26422.html","الوافر"],[54,"أمطلب دع دعاوى الكماة","https://www.aldiwan.net/poem27635.html","المتقارب"],[54,"غصبت عجلا على فرجين في سنة","https://www.aldiwan.net/poem28546.html","البسيط"],[27,"بان الخليط غداة الجناب","https://www.aldiwan.net/poem5783.html","المتقارب"],[27,"ألا حي المنازل والخياما","https://www.aldiwan.net/poem6017.html","الوافر"],[72,"أذات الحجى إن الحجاب ليمنع","https://www.aldiwan.net/poem19171.html","الطويل"],[51,"ليوقن من يعارضني بأني","https://www.aldiwan.net/poem65446.html","الوافر"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[85,"سلو قلبي غداة سلا وثابا","https://www.aldiwan.net/poem63783.html","الوافر"],[62,"بنفسي من أودعتها الترب راغما","https://www.aldiwan.net/poem52284.html","الطويل"],[28,"إليك سمت يا ابن الوليد ركابنا","https://www.aldiwan.net/poem5010.html","الطويل"],[66,"سلوا بعد تسآل الورى عنكم عني","https://www.aldiwan.net/poem41581.html","الطويل"],[80,"بلى جر أذيال الصبا وتصابى","https://www.aldiwan.net/poem31543.html","الطويل"],[80,"هل أقصر الدهر عن تعنيت ذي أدب","https://www.aldiwan.net/poem31565.html","البسيط"],[81,"شكا بالعتب مضناك","https://www.aldiwan.net/poem61407.html","الهزج"],[39,"طربت وشاقك البرق اليماني","https://www.aldiwan.net/poem53730.html","الوافر"],[39,"ألا إن سلمى عن هوانا تسلت","https://www.aldiwan.net/poem53811.html","الطويل"],[75,"هنالك عهدي بالخليط المزايل","https://www.aldiwan.net/poem69044.html","الطويل"],[46,"قبيح أن يحس نحيب باك","https://www.aldiwan.net/poem22339.html","الوافر"],[46,"أرى كل أم عبرها غير مبطئ","https://www.aldiwan.net/poem22528.html","الطويل"],[46,"أواني هم فألقى أواني","https://www.aldiwan.net/poem23545.html","المتقارب"],[68,"شربنا على ذكر الحبيب مدامة","https://www.aldiwan.net/poem1525.html",""],[1,"","https://poetry.dctabudhabi.ae/diwan/poem/199405","الطويل"],[90,"احمد شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=179129",""],[54,"غصبتَ عجلاً على فرجينِِ في سنة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=13989",""],[80,"بلى ، جرّ أذيال الصبا وتصابى","https://www.poetsgate.com/ViewPoem.aspx?id=3019",""],[120,"أناديك لو رد النداء رميم","https://www.aldiwan.net/poem49281.html","الطويل"],[143,"سما بك دهرك فليفتخر","https://www.aldiwan.net/poem11765.html","المتقارب"],[150,"حروب النوى والقرب فيك سجال","https://www.aldiwan.net/poem68535.html","الطويل"],[160,"إذا كان من عاداك يصبح نادما","https://www.aldiwan.net/poem58900.html","الطويل"],[160,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[166,"إذا كان من عزمي التقدم في العلا","https://www.aldiwan.net/poem47133.html","الطويل"],[185,"إذا كان عقبى ما يسوء التصبر","https://www.aldiwan.net/poem14545.html","الطويل"],[189,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[198,"شهدت بأن الورد لو أعطي المنى","https://www.aldiwan.net/poem51961.html","الطويل"],[203,"دعوت إلى خطة خالدا","https://www.aldiwan.net/poem68167.html","المتقارب"],[229,"يا عذبة الرشف هل لمكتئب","https://www.aldiwan.net/poem50892.html","المنسرح"],[270,"جبينك لاح فجرا في حماك","https://www.aldiwan.net/poem35421.html","الوافر"],[280,"يقيني يقيني حادثات النوائب","https://www.aldiwan.net/poem60788.html","الطويل"],[363,"سمونا بالجياد إلى أعاد","https://www.aldiwan.net/poem1714.html","الوافر"],[364,"بما عن من شكوى زمان تعرضا","https://www.aldiwan.net/poem60860.html","الطويل"],[437,"سرى الطيف وهنا والرقاد مرنق","https://www.aldiwan.net/poem2618.html","الطويل"],[443,"فؤاد ما تعداكم","https://www.aldiwan.net/poem55963.html","عموديه"],[515,"هي الصدمة الأولى فمن بان صبره","https://www.aldiwan.net/poem12130.html","الطويل"],[551,"تلوم وقد لاحت طوالع شيبتي","https://www.aldiwan.net/poem47861.html","الطويل"],[575,"تنزه طرفي بين زاه وزاهر","https://www.aldiwan.net/poem3073.html","الطويل"]],"verses":[["وَلَو خَلَّيتَ عَنّا في رِهانٍ","تَبَيَّنَتِ البِطاءُ مِنَ السِراعِ",0,"ع",1,0],["وَلَوْ خَالفَتْ في الحُبِّ وَهْيَ كَريمَةٌ","عَلَيَّ يَمِيني فَارَقَتْها شِمَالِيا",1,"ل",3,0],["ولو خالَفَتْني في مُتابعةِ الهَوى","يَميني ما واصَلْتُها بِشمالي",2,"ي",1,0],["ولَو خَبِرَ البَرِيّةَ مَنْ رَجاهُمْ","لَشَد على مَطِيَّتِه العِقالا",3,"ل",2,0],["وَلَو خَيَّرونيها وَخُلداً مُنَعَّماً","تَخَيَّرَها قَلبي وَلم يَختَرِ الخُلدا",4,"د",2,0],["وَلَو خِفتُ القَطيعَةَ حَيثُ حَلَّت","رَضيتُ بِأَن تُقيمَ عَلى البُعادِ",5,"د",1,0],["وَلَو خَصَّ بِالرِزقِ نَجلُ الكِرامِ","لَما نِلتَ خَيطاً وَلا هُدبَه",6,"ب",2,0],["وَلَو خَطَبتَ إِلى طَوقٍ وَأُسرَتِهِ","فَزَوَّجوكَ لِما زادوكَ في حَسَبِك",7,"ك",1,0],["وَلَو خُيِّرَ القَينُ بَينَ الحَياةِ","وَبَينَ المَنيَّةِ لَاِختارَها",8,"ر",3,0],["وَلَو خَرَجَت أُمامَةُ يَومَ عيدٍ","لَمَدَّ الناسُ أَيدِيَهُم قِياما",9,"م",2,0],["ولو خيِّرت لم ترضَ إلاَّ بقاءَه","ونقلتها فليهنها القصد أجمع",10,"ع",1,0],["ولو خصم سواك أراد ظلمي","لأسمعت الأصمَّ له حفيفا",11,"ف",2,0],["ولو خفت فوتاً بادرتْ بي عزيمةٌ","لها فرسٌ عندي من الجدّ مُلْجَمُ",12,"م",1,0],["وَلَو خُلِقَت قُلوبٌ مِن حَديدٍ","لَما حَمَلَت كَما حَمَلَ العَذابا",13,"ب",2,0],["ولو خيَّروني بين كفِّي وبينَها","لآثرتُ أن تبقَى وأُصبِحَ أجذمَا",14,"م",2,0],["وَلَو خَلَّدَ الفَخرُ اِمرَأً في حَياتِهِ","خَلَدتَ وَما بَعدَ النَبِيُّ مُخَلَّدُ",15,"د",1,0],["وَلَو خَطَّ صَرفُ الدَهرِ طِرساً لِقَصدِهِ","لَخَطَّ عَلى العُنوانِ مِن عَبدِهِ القِنِّ",16,"ن",1,0],["ولو خضبَ الأيدي نداهُ رأيتمُ","لكلّ يدٍ بالتّبرِ منْه خضابا",17,"ب",2,0],["ولو خلا الدّهرُ ذو الأبناءِ من عَجَبٍ","أكثرْتُ منه ومن أبنائِهِ عَجبي",18,"ي",1,0],["وَلَو خُيِّرتُ في الشَكوى","إِذَن أَودَعتُها فاك",19,"ك",1,0],["وَلَو خَلَّيتُ لِلشُعراءِ وَجهي","لَما اِكتَبَلوا يَدَيَّ وَلا لِساني",20,"ي",1,0],["وَلَو خَرَجَ الدَجّالُ يَنشُدُ ذِمَّةً","لَزافَت تَميمٌ حَولَهُ وَاِحزَأَلَّتِ",21,"ت",1,0],["ولو خُلِّدَتْ لم أقضِ منْها لُبانَةً","وكيْفَ ولم تَخْلُدْ لبكرِ بن وائل",22,"ل",1,0],["وَلَو خُيِّرتُ لَم أَترُك مَحَلّي","فَأَسكُنَ في مَضيقٍ بَعدَ رَحبِ",23,"ب",1,0],["وَلَو خُلِقَت أَجسادُنا مِن صَبارَةٍ","لَقَلَّ عَلى كَرِّ الحَوادِثِ صَبرُها",24,"ر",3,0],["وَلَو خُلِقا مِثلَ خَلقِ الجِيادِ","رَأَيتَهُما في المَدى يَكبُوانِ",25,"ن",1,0],["ولو خُضِبت من كأسِها كفُّ لامسٍ","لمَا ضَلّ في لَيْلٍ وفي يَدِهِ النجم",26,"م",1,0],["ولو خطرت أبناء قرآن حوله","لأضحى على ما كان يطلب قادرا",27,"ر",2,0],["ولو خافَ مثلَ سِواه العُبُور","لخابَ وزلَّ ولكنْ عَبَر",28,"ر",1,0],["ولو خطبتَ إلى طوقٍ وأسرتهِ","وَزَوَّجوكَ لما زَادُوكَ في حَسَبِكْ",29,"ك",1,0],["ولو خضب الأيدي نداه رأيتم","ولم أرَ كالدّنيا خؤوناً لصاحبٍ",30,"ب",1,0],["ولو خير الأموات ما اختار واحدٌ","حياةً ولا قال الحمام ذميم",31,"م",1,0],["وَلَو خُلِقَت قَبلَ أَن يَنزِلَ ال","كِتابُ أَتى ذِكرُها في السُوَر",32,"ر",1,0],["ولو خفَّ شجوى لمحةً طرتُ نحوكم","ولكن أعباءَ الفراقِ ثٍِقَال",33,"ل",1,0],["ولو خلى الباغي عليك ورايه","لما كان إلا ناصحا لك خادما",34,"م",2,0],["ولو خلته ميتا وكنت دفنته","لخيف عليها منك قطع الدوابر",35,"ر",1,0],["ولو خاف تهديدَ الفرزدقِ مِرْبعٌ","لخفتُ ولكن لا يُرى الخوفُ من دَأبي",36,"ي",1,0],["ولو خَلَّف الموتُ امرأً لجَلاله","لكان بها أَوْلَى وأَحْرَى المُظَفَّر",37,"ر",1,0],["وَلَو خيّروا في فعلِ ذلكَ مُسلماً","وَأُنثاهُ لاِختارا على فعلهِ القَبرا",38,"ر",2,0],["وَلَو خُيّرَت نَفسي بهجركِ والغِنى","لَكان اِختياري فيكِ أَن أصحبَ الفقرا",38,"ر",2,0],["ولو خُيِّر الرَّيْحانُ لاختارَ صُدْغَهُ","وإنْ أصبحَ الريحانُ يحكي الزبرجدا",39,"د",2,0],["وَلَو خالِدٌ عادَ في مِثلِها","لَتابَعَهُ عُنُقٌ وارِدُ",40,"د",1,0],["ولو خَشِيتِ الإلهَ ما فَتَكت","بابن وَصِيِّ النَّبي عيناكِ",41,"ك",1,0],["ولو خُيِّرتُ في سَعدي ونحسي","دخلتُ جهنَّماً ولثمتُ فاك",42,"ك",1,0],["وَلَوْ خَطَرتْ بِي فِي ضَمِيرِكَ خَطْرَةٌ","لَعَادَتْ بِتَصْدِيقِ الظُّنُونِ الكَواذبِ",43,"ب",1,0],["وَلَو خِفناكَ ما كُنّا بِضُعفٍ","بِذي خُشُبٍ نُعَرِّبُ وَالكُلابِ",44,"ب",1,0],["ولو خَلصتْ لي من فؤاديَ شُعبةٌ","من الهمِّ لَم أَذكُرْ سوى ساكني الغَضا",45,"ض",2,0],["ولو خفقت عيني به لم تفض له","دموعي ولا قلبي لذكراه يخفق",46,"ق",1,0],["ولو خيرت ما جور","ت في العالم إلا كم",47,"م",1,0],["ولو خلف ابناً واحداً سيد الورى","لما حاز ميراث الخلافة صهره",48,"ر",2,0],["وَلَو خلّدتْ لي خالةٌ معْ تولّع ال","ليالي بأحوالي لكنتُ المخلّدا",49,"د",2,0],["ولو خَاطَرونِي أَنَّ فِي الدَّهر مثلَهم","لكَان مآلي أَخْذَ رَهْنِ الْمُخاطرِ",50,"ر",1,0]]}