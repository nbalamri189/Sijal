لظبية لحظا وجيد","https://www.poetsgate.com/ViewPoem.aspx?id=181267",""],[402,"عباس يا أوفى أخ","https://www.poetsgate.com/ViewPoem.aspx?id=35967",""],[5795,"يرنو بعين الانتقاد أن رأى","https://www.poetsgate.com/ViewPoem.aspx?id=167912",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[5956,"نُقَّادٌ ومعجَبون","https://www.poetsgate.com/ViewPoem.aspx?id=185609",""],[6147,"مشروع حلال","https://www.poetsgate.com/ViewPoem.aspx?id=151492",""],[6248,"تراتيل العزلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86018&r=&rc=4",""]],"verses":[["مَتى رَجَتِ اِمرُؤُ القَيسِ السَرايا","مِنَ الأَخلاقِ أَو حَمَتِ الذِمارا",0,"ر",2,0],["متى راعيتَه من جانبيه","رعاك بعينه من جانبيكا",1,"ك",2,0],["مَتى رَأَيتَ صُروفَ الدهرِ تارِكَةً","إِذا اِنبَرَت لِذَوي الأَخطارِ أَرماقا",2,"ق",2,0],["مَتى رَضينا مِثلَ هَذي الحالِ","مَتى مَدَدنا الكَفَّ لِلسُؤالِ",3,"ل",1,0],["مَتى رَبَّدَتها عِزَّةٌ أَوحَفيظَةٌ","أُعيدَ إِلَيها بِالسُؤالِ صِقالُها",4,"ل",3,0],["متى رأيتُمْ وهلْ سمعتم","بأن قاضي القضاةِ حَمْري",5,"ي",1,0],["مَتى رَفَعَ الرَجاءُ بِناءَ مُلكٍ","وَكانَ عِمادُهُ قالاً وَقيلا",6,"ل",2,0],["مَتَى رُمتُ نُصرَةً مِنْ شَفيعي،","فَشفيعي عَنْ نُصْرَتي مَشْغُولُ",7,"ل",1,0],["مَتى رُفِعَت لِلمَجدِ رايَةُ غايَةٍ","فَما أَحَدٌ قُدامَهُ يَتَقَدَّمُ",8,"م",1,0],["مَتى رُمتَ النُهوضَ تَعَلَّقَت بي","هُمُومٌ لا تُنيمُ وَلا تَنامُ",9,"م",1,0],["متى رمت الغواني رمن هجري","راين تحانفي فقطعن حبلي",10,"ل",2,0],["متى رمت النزول بذات عرق","أبي إلا النزول على الشقوق",11,"ق",1,0],["متى رأيتهم عفّوا فمصيدةٌ","حتى إذا اصطبحوا في السوءة اغتبقوا",12,"ق",3,0],["متى رمت إنصافا رجعت بخيبة","وإن رمت إسعادا رجعت بزور",13,"ر",1,0],["متى رمت إلزام الصديق تحفّظا","خسا مازكامنه العتاب فما يربو",14,"ب",2,0],["متى روَّحَتْ منه المطا وتَغَشْمَرَتْ","تَبوعُ الفيافي بالخُطا وتَقِيسُ",15,"س",1,0],["متَى رَامَ أمراً فالمُلوكُ أمامَه","لإنْجازه قَبْلَ المَلائكِ في حَفْدِ",16,"د",1,0],["متى رُمتُ في استغراق وصفك حَدَّه","أبى العجز إلا أن يقول ليَ ارفُقِِ",17,"ق",1,0],["مَتى رَنَت مُتلِعَةً جيدَها","وَالتَفَتَت فَاللَيثُ صَيدُ الغَزال",18,"ل",1,0],["مَتى رَنَوا وَمَتى اِفتَرّوا حَنَوا وَحَبَوا","بِالسِحرِ مِن بابِلٍ وَالدُرِّ مِن كيشِ",19,"ش",1,0],["مَتى رَأَيتَ المُحِبَّ مُلتَفِتاً","إِلى الأَحاديثِ مِن ذَوي النُصحِ",20,"ح",1,0],["متَى رآني الشّامتُون ضَرِعاً","لنكبةٍ تَعرُقُنِي عَرق المُدَى",21,"د",2,0],["متى راوحتِها خَبَراً","على البَيْضاتِ في الخِيَمِ",22,"م",1,0],["متى رمتها فهي من راحتي","ك بين الرواجب والأشجعِ",23,"ع",1,0],["متى رُفعتْ لها بالغور نارُ","وقرَّ بذي الأراكِ بها قَرارُ",24,"ر",1,1],["متى رأتِ البروقَ بروقَ حُزْوَى","تَحِنُّ فلن تَعُبَّ ولن تَلُسّا",25,"س",2,0],["متى رمت منه رقة وجزالة","فإن كلامي ماؤه وصفاته",26,"ت",2,0],["متى رأيت شجاعاً مات بالأجل","ونال من لذّة الدنيا مدى الأمل",27,"ل",1,0],["مَتَى رَحَلَ الأَحْبَابُ وَالدَّمْعُ سَائِلُ","سُؤَالَ مُحِبٍّ فِي حَشَاهُ بَلاَبِلُ",28,"ل",1,0],["متى رحلوا واين ثووا وقاموا","على هجري أم اقترحوا ودادي",29,"د",2,0],["متى رأيتكَ شيئا كنت محتجبا","برُؤية الشيءِ عما أنت ناويه",30,"ي",2,0],["متى رأت جرّا بها هذيل","لعلّ قد جرّت بها عقيل",31,"ل",1,0],["مَتَى رُمتَ بِي نَصراً تُجِبكَ ثَلاثَةٌ","لِسَانِي وَودِّي وَالسُّريجِيُّ ثَالِثُ",32,"ث",1,0],["متى رام فضلا بين حق وباطل","تناجيه من آي الكتاب فواصل",33,"ل",1,0],["مَتى رَفَعَت لَكَ السودانُ رَأساً","وَقَد خَلّاهُمُ مِثلَ الزِقاقِ",34,"ق",1,0],["متى رأى أحد قبلي مطوقة","إذا تغنت بلحن جاوب الفنن",35,"ن",1,0],["متى راكبٌ من أهل مِصْرَ وأهلُه","بمَكّةَ مِنْ مِصْرَ العَشِيّةَ راجعُ",36,"ع",1,1],["متى رأى الليثُ أخا حافرٍ","تجده ذا فشّ وذا جزر",37,"ر",1,0],["مَتى رُمت أَن الصُبح لَيل فَقَد بَدا","إِلى كُل ذي عَينين أَنك كاذب",38,"ب",1,0],["متى رمضان ينقضى بسلام","فأحظى بمحبوب لديه مرامي",39,"م",2,1],["متى رضيت نفسي المذلة ملبساً","كبيراً وفي حالات صغري وصبوتي",40,"ي",1,0],["متى رمت تحليقاً الى العالم الثاني","تخدت جناح النفس آية قرآن",41,"ن",1,1],["متى رُمتُ ابهام الهوى عن عواذلي","فكشّافُها للمبهمات مُفسّرُ",42,"ر",1,0],["متى رمقته وهو ملقى على الثرى","يقل محياه الشريف ثقيف",43,"ف",1,0],["مَتى رمت مِن عَلياه تَفسير آية","وَجَدت خَبيراً بِالبَيان مُفَسِرا",44,"ر",2,0],["متى رأيتك شيئاً كنت محتجّاً","وعدت بعد صعود الطور في التيه",45,"ي",2,0],["متى ردد السمار في الحشد ذكرها","حبا الروض عرفاً مسكها المتفتق",46,"ق",1,0],["متى رُمتَ أن تُحصي عُلاه وفخره","فقد رمته إحصاء الحصى والأنجم",47,"م",1,0],["متى رقت يكاد الحبر منها","يضيء فيبهر المتأملينا",48,"ن",2,0],["متى رَدَّ حَقًّا؟! متى","كَفَى المؤمنِينَ القِتالْ؟!",49,"ل",1,0],["متى رأيت لأهل العز بارقة","فاستصرخ القوم هل في القوم معتصم ؟",50,"م",1,0],["متى رأيتَ بلادًا تلكَ حالتُها","- ورُمتَ خيرًا - فهاجرْ ..لا تَعِشْ فيها !",51,"ي",3,0],["متى رأى طرفك قتل امرئ","بأسهم اللحظ فقيد الفقيد",52,"د",1,0],["متى رى الفاتنة","البيضاء تطفيء الحرق",53,"ق",1,0],["متى رأى فضلاً أذاع وروى","وإن رأى ميلاً أجنّ وطوى",54,"ا",1,0],["متى رمت سلوانا وأملت راحة","أهاجت بي الذكرى لواعج علةِ",55,"ه",1,0],["متى رمضانُ يمضي ثم يأتي","زمانُ الفِطْر أصطحبُ النجوما ؟",56,"م",2,0],["متى رضَع الذليلُ لِبَا ذليلٍ","ففَطْمُ العزِ.. مشروعٌ حلال.",57,"ل",1,0],["متى ؟! .. ربما يصغي إلى صوت وحشتي","ملاذٌ بهِ أنجو .. ومن فيهِ أُولدُ",58,"د",1,0]]}