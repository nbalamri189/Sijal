{"poems":[[93,"مازال يمشي في الأمور بفكره","https://www.aldiwan.net/poem62771.html","عموديه"],[94,"أيها الحب أنت سر بلائي","https://www.aldiwan.net/poem38975.html","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43800","الكامل"],[92,"ذكرى الهاشمي","https://www.poetsgate.com/ViewPoem.aspx?id=179163",""],[113,"سعدت دمشق بطالع الشعراني","https://www.aldiwan.net/poem16211.html","الكامل"],[242,"مهلا على القلب إن القلب قد لسبا","https://www.aldiwan.net/poem18037.html","البسيط"],[354,"عذلوا ولو وجدوا بكم وجدي","https://www.aldiwan.net/poem15612.html","أحذ الكامل"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110384","الكامل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53880","البسيط"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48981","الكامل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47191","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204454","البسيط"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139923","الكامل"],[409,"","https://poetry.dctabudhabi.ae/diwan/poem/60358","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133242","الكامل"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103555","الكامل"],[4755,"كَأسُ بُنٍّ ل آشُوربانيبال","https://www.poetsgate.com/ViewPoem.aspx?id=210752",""],[4578,"حكم العيون من الظماء الغيد","https://www.poetsgate.com/ViewPoem.aspx?id=49401",""],[4858,"الطيرُ في بلدي","https://www.poetsgate.com/ViewPoem.aspx?id=33864",""],[4927,"العاشق التائه","https://www.poetsgate.com/ViewPoem.aspx?id=29653",""],[5198,"شظايا","https://www.poetsgate.com/ViewPoem.aspx?id=135065",""],[5458,"ملكة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=72162",""],[5533,"اِرْتفاعُ ضَغْطِ الدَّم","https://www.poetsgate.com/ViewPoem.aspx?id=176252",""],[5688,"قالت حبيبتي:","https://www.poetsgate.com/ViewPoem.aspx?id=200940",""],[5704,"كما تدين تدان","https://www.poetsgate.com/ViewPoem.aspx?id=191598",""],[6068,"قال العواذل هل نسيت غرامها -20-","https://www.poetsgate.com/ViewPoem.aspx?id=175899",""],[6093,"قصيدة وأخرس","https://www.poetsgate.com/ViewPoem.aspx?id=207200",""],[6203,"يابحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88029&r=&rc=6",""]],"verses":[["لَكِنَّ طَردي مِنَ جَهَنَّمَ إِنَّهُ","ما دارَ في خُلدي وَلا حِسباني",0,"ن",2,0],["لكنَّ طَيْفُ الموتِ قاسٍ","والدُّجى طَيفٌ رَحيمْ",1,"م",1,0],["لكِن طَوَتكَ يَدٌ شَديدٌ بَطشها","سِيّانِ مَرؤوسٌ بِها وَرَئيسُ",2,"س",1,0],["لكن طموحٌ ليس يَرْضي أهلُهُ","أن تستمرَّ سياسةُ الترميم",3,"م",1,0],["لَكنَّ طَرفي عافَهُ عَن سيرهِ","قَدرٌ مُتاح آخذ بِعِتاني",4,"ن",2,0],["لَكِنْ طَرِبْنَا بِمَا أَبْدَيْتَ مِنْ نُكَتٍ","نَفِيسَةٍ أَوْرَثَتْنِي ضَحِكاً طَرَبَا",5,"ب",2,0],["لَكِن طَغى سَكَري بِكُم فَطَوى","سَتري فَبانَ لِعُذَّلي قَصدي",6,"د",2,0],["لكن طمعتُ بعودةٍ","تُرجَى إذا غابَ القمر",7,"ر",1,0],["لكنَّ طاقةَ مثلي غيرُ خافيةٍ","والذَّرُّ يَعْذُرُهُ في خِسَّةِ الجَلَبِ",8,"ب",1,0],["لكنَّ طِرفَك كان أولَ سابقٍ","يا ليتَه لم يَسبُقِ الأَترابا",9,"ب",2,0],["لكنّ طَوْدَ ثَبَاتِه لم يهتزز","بعواصفٍ من غيّهم أصناف",10,"ف",1,0],["لكن طريقة أهل الريف واحدة","بيضاء حتى الدجى في أفقها شفق",11,"ق",1,0],["لكنْ طمعت بأن أرى الحسن الذي","زوّرن لي فدممتُ سوءَ مطامعي",12,"ع",2,0],["لكن طلبت الحق من طرق","معوجة ليست على سنن",13,"ن",1,0],["لكن طوت أيدى البخار بساطها","طي السجل وذاك في لمح البصر",14,"ر",1,0],["لكن طويت من الهموم لظىً","أضحى لها في عارضي شرر",15,"ر",1,0],["لكنَّ طَودًا كالعِراقِ أَشَدُّ مِن","عَصفِ الرِّمالِ، وأَبعَدُ استِسلاما",16,"م",2,0],["لكن طرابلسٌ عليه تقدمت","بنوال فضل جل عن تحديدِ",17,"د",1,0],["لكنَّ طيورَكِ يا بلَدي","كطريدِ غشومٍ مُقْتَحِمِ!",18,"م",1,0],["لَكِنَّ طَيْفَكِ في خَيالِيْ سَافِرٌ","كَالشَّمْسِ تَسْطَعُ فِيْ نَهَاْرِ تَبُوْكِ",19,"ك",1,0],["لكن طول الصمت جمر ولظايا","صمتك لهيب يحرّق الجوف تحريق",20,"ق",1,0],["لكن طفلاً كان يلهو بالدمى","لما رأى الصنديد أجهش ثم بال",21,"ل",1,0],["لكنَّ طبيبَكَ قَدْ يُوْصِي","بدَوَاءٍ فازَ بِبُرْهانِ",22,"ن",1,0],["لكنْ طباع وأخلاق لك اجتمعت","بدت لعيني وما لي غيرُها سبب",23,"ب",1,0],["لكن طبْعَ الغدرِ فيك سجيةٌ","واصلتني زيفًا وبُعْد قطعتني",24,"ن",2,0],["لكن طردتِ مُهيجة أودعتها","في مهجة بانت لها أسواها",25,"ا",3,0],["لكن طبعك توأم لحديثكم","وكلاهما غلبا اصطبار الكيِّسِ",26,"س",1,0],["لكنّ طبع الحبِّ يفضح نفسَهُ","فتكاد تحسبهُ صبيّاً أحمقَا",27,"ق",2,0]]}