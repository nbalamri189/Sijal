{"poems":[[73,"ليهن الهدى إنجاح سعيك في العدا","https://www.aldiwan.net/poem11949.html","الطويل"],[23,"ماذا أردتم من أخي الخير باركت","https://www.aldiwan.net/poem21427.html","الطويل"],[51,"أبو عثمان والرومي","https://www.aldiwan.net/poem64019.html","الهزج"],[45,"بأي أسى تثنى الدموع الهوامل","https://www.aldiwan.net/poem65575.html","الطويل"],[33,"شريت بشاتي شبه ليلى ولو أبوا","https://www.aldiwan.net/poem25951.html","الطويل"],[23,"حسان بن ثابت يرثي عثمان رضي الله عنهما","https://www.poetsgate.com/ViewPoem.aspx?id=32628",""],[124,"لقد كان لي قلب شفوق وأدته","https://www.aldiwan.net/poem23805.html","الطويل"],[169,"سما لك من أم العبيد خيال","https://www.aldiwan.net/poem1660.html",""],[235,"عسى قاعد الحظ يوما يثب","https://www.aldiwan.net/poem32180.html","المتقارب"],[280,"أفيض دموع أم سيول تموج","https://www.aldiwan.net/poem60699.html","الطويل"],[280,"إذا عز نفسي عن هواك قصورها","https://www.aldiwan.net/poem60737.html","الطويل"],[364,"إذا ضربوا بكاظمة الخياما","https://www.aldiwan.net/poem60656.html","الوافر"],[439,"أهل بالبين فانهلت مدامعه","https://www.aldiwan.net/poem34880.html","البسيط"],[464,"نعم نفحة الوادي التي تتأرج","https://www.aldiwan.net/poem3143.html","عموديه"],[477,"أرى العيش بعد المالكية لا يحلو","https://www.aldiwan.net/poem15218.html","الطويل"],[515,"سرت نفحة كالمسك أزهى وأعطر","https://www.aldiwan.net/poem12119.html","الطويل"],[515,"عنان الليالي في يديك مسلم","https://www.aldiwan.net/poem12275.html","الطويل"]],"verses":[["فَلا ظافِرٌ إِلّا إِلى سَعدِكَ اِعتَزى","وَلا سائِسٌ إِلّا بِتَدبيرِكَ اِقتَدى",0,"د",2,0],["فَلا ظَفِرَت أَيمانُ قَومٍ تَظاهَرَت","عَلى قَتلِ عُثمانَ الرَشيدِ المُسَدَّدِ",1,"د",1,0],["فلا ظهرٌ سوى بطن","ولا بطن سوى ظهر",2,"ر",1,0],["فَلا ظَفِرَت تِلكَ الغَزاةُ بِمَغنَمٍ","وَلا قَفَلَت بِالنُجحِ تِلكَ القَوافِلُ",3,"ل",1,0],["فَلا ظَفَرَت كَفّاكُما بِكَريمَةٍ","وَجُنِّبتُما صَوبَ الغَمامِ الرَواعِدِ",4,"د",1,0],["فلا ظفرت أيمان قوم تبايعوا","على قتل عثمان الرسيد المسدد",5,"د",1,0],["فلا ظبية الوادي تعن بباله","ولا وده بالقصر لمياء تخطب",6,"ب",1,0],["فَلا ظَفِرَت مِنكَ الأَعادي بِغِرَّةٍ","وَلا زِلتَ تَغزُو أَرضَها فَتُدالُ",7,"ل",1,0],["فَلا ظَلُّ إِحسانِهِ قالِصٌ","وَلا شَمسُ مَعروفِهِ تَحتَجِب",8,"ب",1,0],["فَلا ظِلُّهُ عَنْ مُسْتَظِلٍّ بِقاصِرٍ","وَلا بابُهُ عَنْ مُرْتجِي الْخَيْرِ مُرْتَجُ",9,"ج",1,0],["فَلا ظَلَّ يُوْماً مُصْحِباً لِي أَبِيُّها","وَلا باتَ لَيْلاً آنِساً بِي نَفُورُها",10,"ر",3,0],["فلا ظَمِئتْ بلادُكَ من كريمٍ","نداهُ الدَّهْرَ يَنْسَجِمُ انْسِجاما",11,"م",2,0],["فلا ظَلامُ قَرارٍ أَنتَ ساكِنُهُ","ولا نَهارُ مُغارٍ أَنتَ وادعُهُ",12,"ع",2,0],["فلا ظلهُ ضاحٍ ولا بابُ جوده","إذا ما بغاهُ مرتجٍ هو موتج",13,"ج",1,0],["فلا ظلَّ إلا ما تظلَّلُه القنا","أو النقعُ أن الموتَ تحتَهما فَضْلُ",14,"ل",1,0],["فلا ظله الضافي عليه مقلص","ولا منه الصافي بمن يكدر",15,"ر",1,0],["فلا ظفر إلا بسيفك يجتنى","ولا عدم إلا بسيبك يعدم",16,"م",1,0]]}