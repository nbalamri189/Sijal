spx?id=27063",""],[402,"رب البيان وسيدا لقلم","https://www.poetsgate.com/ViewPoem.aspx?id=36326",""],[5809,"أسف","https://www.poetsgate.com/ViewPoem.aspx?id=205397",""],[5842,"ندعوك يا خير من مُدَّت إليه يَدُ \\ محمد حسام الدين","https://www.poetsgate.com/ViewPoem.aspx?id=127639",""],[5956,"أنانياتها","https://www.poetsgate.com/ViewPoem.aspx?id=182455",""],[5956,"الرسالة المحمدية","https://www.poetsgate.com/ViewPoem.aspx?id=184653",""],[5956,"رأيتُ بأسرتنا والأسَرْ","https://www.poetsgate.com/ViewPoem.aspx?id=193534",""],[5970,"حبست نفسي على العلياء أطلبها","https://www.poetsgate.com/ViewPoem.aspx?id=130658",""],[6024,"الجد","https://www.poetsgate.com/ViewPoem.aspx?id=186353",""],[6068,"قوام الحب -05-","https://www.poetsgate.com/ViewPoem.aspx?id=175901",""],[6102,"يَارَا","https://www.poetsgate.com/ViewPoem.aspx?id=185333",""],[6142,"سل كربلا والوغى والبيض والأسلا","https://www.poetsgate.com/ViewPoem.aspx?id=155747",""],[6182,"قَدْر ما يَتَنَهَّدُ الربّانُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86105&r=&rc=2",""]],"verses":[["وَاِسوَدَّ شَطرُ اليَومِ تَرجُفُ شَمسُهُ","قَلَقاً وَجَرَّ ضِياؤُهُ الظَلماءَ",0,"ا",2,0],["وَآسٌ وَخيرِيٌّ وَمَروٌ وَسَوسَنٌ","إِذا كانَ هِنزَمنٌ وَرُحتُ مُخَشَّما",1,"م",2,0],["وَأَسوَدَ مَيّالٍ عَلى جيدِ ظَبيَةٍ","مِنَ الُدمِ حَوراءِ المَدامِعِ مُغزِلِ",2,"ل",1,0],["وَأَسَوْتَ مَكْلُومَ النُّفُوسِ إِسَا","مِنْ يَقْرِنُ التَّضْمِيدَ بِالنَّغَمِ",3,"م",1,0],["وَأَسوَدَ وَلاّجٍ بِغَيرِ تَحِيَّةٍ","عَلى الحَيِّ لَم يُحرِم وَلَم يَحتَمِل وِزرا",4,"ر",2,0],["واسَوأَتا ثُمَّ يا وَيلا وَيا حَرَبا","إِنّي أَخو الجِسمِ فيه السُقمُ وَالكُرَبُ",5,"ب",1,0],["واسودْ وجه الكفر من خزي متى","ما احْمَرَّ وجه الأبيض البتّارِ",6,"ر",1,0],["واسوأتا للحكيمِ همتُهُ","إشباعُهُ بنتَهُ من الكمر",7,"ر",1,0],["وا سَوْأَتا إن ضاقَ ذَرْعُك بالغنى","عِند ادِّراع قميصه الفضْفاض",8,"ض",1,0],["واسوأتي والله من تطفيفه","إذ لا تخاف هناك من تطفيفه",9,"ف",2,0],["وأسودُ الناسِ لهم سيّدٌ","مُسْتَنْهَضٌ في الحاجِ مُستَخدَمُ",10,"م",1,0],["وأَسوءُ السيئات سلُّكَ بال","جهل حُساماً عليك مسنونا",11,"ن",2,0],["وَأَسوَدُ شَيخٍ في الثَمانينَ سِنُّهُ","غَدا وَجهُهُ مِن أَبيَضِ الشَيبِ أَبلَقا",12,"ق",2,1],["وَأَسوَدَ عارٍ أَنحَلَ البَردُ جِسمَهُ","وَما زالَ مِن أَوصافِهِ الحِرصُ وَالمَنعُ",13,"ع",1,1],["وَأَسوَدَ مافيهِ مِنَ الخَيرِ خَصلَةٌ","لَهُ زَفرَةٌ مِن شَرِّهِ وَشُواظُ",14,"ظ",1,1],["وَأَسوَدَ مَيّالٍ عَلى جيدِ مُغزِلٍ","دَعاها طَلىً أَحوى بِرَمّانَ راشِحُ",15,"ح",1,0],["وأَسْودَ لَهْذَمِ السّيْرَينِ جَوْنٍ","وأَزْرقَ مِنْسَرٍ أَقْنَى نَهُوسِ",16,"س",1,0],["وَأَسوَدُ مِشفَرُهُ نِصفُهُ","يُقالُ لَهُ أَنتَ بَدرُ الدُجى",17,"ا",1,0],["وأسوتَ جُرْحَ الحادثاتِ وطالما","كنَّا وجُرْحُ الحادثاتِ جُبَارُ",18,"ر",1,0],["واسَوأَتا مِن رَأيِكَ العازِبِ","وَعَقلِكَ المُستَهتِرِ الذاهِبِ",19,"ب",1,1],["وَاِسوَدَّ ثُمَّ صَفَت لِعَينَي ناظِرٍ","جَنَباتُهُ فَأَضاءَ في إِظلامِهِ",20,"م",2,0],["وَاسوَدَّ وَجهُ الشَمسِ وَاحمَرَّت ظُبا","بيضِ الصِفاحِ وَبَلَّدَ البَطَلانِ",21,"ن",1,0],["وَأَسوَدٍ عَنَّ لَنا سابِحٍ","في لُجَّةٍ تَطفَحُ بَيضاءِ",22,"ا",2,1],["وَأَسوَدٍ يَسبَحُ في لُجَّةٍ","لاتَكتِمُ الحَصباءَ غُدرانُها",23,"ه",2,1],["وأَسودُ وَمدلَهِمَّ اللَونِ حَشلاً","بَدَهنِ البانِ وَالغالِي غُذينا",24,"ن",2,0],["وَأُسوداً عَوادياً وَفيولاً","وَسِباعاً وَالنَملَ وَالخِنزيرا",25,"ر",2,0],["وَأَسوَدَ في كَفِّ مَجدولَةٍ","لَطيفٍ لَهُ خِلقَةٌ مُنكَرَه",26,"ه",1,1],["وأسود لهذم الشفرين يفري","وأزرقَ منسَرٍ أقنىً هموس",27,"س",1,0],["وأسْوَدَ لم تَعْرِفْ له الإنْسُ والِداً","كَسانيَ منه حُلّةً وخِمارا",28,"ر",2,0],["وأسواقٌ تُباع بها وتُشْرى","ضمائرُ هُنَّ للأهواءِ نَهْبُ",29,"ب",1,0],["وأَسْودَ مبيَضِّ القبَاءِ كأَنَّمَا","يَطِيرُ به نَحْوَ الكَرِيهةِ عَقْعَقُ",30,"ق",1,0],["وَاسُوا الفَقِيرَ وَأَصْلِحُوا مِنْ شَأْنِهِ","أَوْلاَ فَإِنَّ غَداً لَجِدُّ مُرِيبِ",31,"ب",1,0],["وَأُسُوداً يُخْشَى التَّحَفزُ مِنْهَا","وَيَرُوعُ السَّكُوتُ كَالتَّزْآرِ",32,"ر",1,0],["واسواق تباع بها وتشترى","ضمائر هنّ للأهواء نهب",33,"ب",1,0],["واسوْدّ بالنِيات سوداً خاطرٌ","ومَشَى على البعضِ الصفاءُ فبيَّضا",34,"ض",2,0],["وأسودُ الناسِ لهم سيّدٌ","فمُسْتَنْهَضٌ في الحاجِ مُستَخدَم",35,"م",1,0],["واسويس والوجه الذي بهْ قد نُعي","رحم الإله محمداً بِهْ فارحما",36,"م",2,0],["وَأُسودُ هَيجاءٍ إِذا قَصَدَت وَغىً","حَمَلَت عَلى أَكتافِها الآجاما",37,"م",2,0],["وأسودُ كالأسودِ المستطيل","يَلْدَغُ ذاك وذا يَلْسَب",38,"ب",1,0],["وأسوَدَ يحكي الليل نُقْبة لونِهِ","حَكَى أمَّه في كلّ تركيبِها لِينا",39,"ن",2,1],["وأسودَّ للحسن فَرْقُ لِمَّتها","واحمرَّ مُبيضُّها ليستعرا",40,"ر",2,0],["وَأُسودٍ مِن غِلمَةِ التُركِ لا تَأ","لَفُ إِلّا غيلَ القَنا المَشجورِ",41,"ر",1,0],["واسوَدَّ ذاكَ الجونُ من جِلده","وابيضَ ذاك الجَونُ من فَودِه",42,"د",2,0],["واسوأتا من أناسٍ ظلت أطمعهم","أن الذي التمسوه منك قد حصلا",43,"ل",2,0],["وأُسودُ الأيامِ لا ترتضى الأج","سامَ قوتاً وتأكلُ الحَوْباءَ",44,"ا",2,0],["وَأَسومُها بِالمَالِ نيلَ رِضائِها","حَتّى حَلَلتِ يَمينَها بِيَساري",45,"ر",2,0],["وَاِسوَدَّ حَظّي عِندَهُم لَمّا سَرى","يَبغي الضِياءَ وَخانَهُ الأَمحاقُ",46,"ق",1,0],["وَأسوَاقُ المَتَاجِرِ كَاسِدَاتٌ","فَلَيتَ كَذَاكَ أسوَاقَ الدَّقِيقِ",47,"ق",1,0],["وَاِسوَدَّ مِن بَعدِ البَياضِ القُنَنُ","فَشَبَّ مِن بَعدِ المَشيبِ الزَمَنُ",48,"ن",1,0],["وَأَسوَدٍ شَيَّفوا مَحاجِرَهُ","وَدَمعُهُ في الشِيافِ قَد ذَرَفا",49,"ف",2,1],["وأسود لَيسَ يندَى مِنهُ كفّ","لطالبه إذا سِيمَ النّوالاَ",50,"ل",2,1],["وا سَوأتي ن أَفْردَتْنِي حائراً","أَهْلي وأسْلمني هنالك مَعْشري",51,"ر",2,0],["وَاسوء حَالي فِي غدٍ","لَقَبيحِ ما قَد كان مِنّي",52,"ن",2,1],["وَأَسودها في القَلبِ أَسود سالِخٍ","وَأَبيضها في الجسم أَبيَضُ مقضَبُ",53,"ب",1,0],["وأُسودٍ خافَ سطوَتَها","كلّما حازَتْهُ خَفانُ",54,"ن",1,0],["وأُسُودِ غابٍٍ مَا تَلَذُّ حَياتَها","حَتَّى تُدِيرَ بِهَا كؤوسَ حِمامِ",55,"م",1,0],["وَأُسْوَةً برَسُولِ اللهِ والِدِهِ","فيمنْ تخَيَّرَ أنصاراً وجيرانا",56,"ن",2,0],["واسوّدت الأيام بعدكم أسىً","فلذا ليالى المستهام طوال",57,"ل",1,0],["وأسودَ اللَّون وافانا وقد جنحتْ","شمسُ الأصيل فوافى وافدُ الظُّلمِ",58,"م",1,1],["وَأَسوَدَ مَيّادٍ عَلى جَيدِ عَوهَجٍ","جَعادِ النَواحي غَيرُ زُعرٍ ذَوائِبُه",59,"ه",1,0],["وأسوأ الناسِ تدبيراً لعاقبِةٍ","من انفقَ العمر فيما ليس ينفعه",60,"ع",2,0],["وأُسوداً تهبّ مثلَ النّعامى","في ظُهورِ النّعامِ يومَ وَغاها",61,"ا",3,0],["وأسَوْتِ بالتّوديع في","يوم النّوى نفساً عليلهْ",62,"ل",2,0],["واِسودّ منّي كلُّ ما هو أبيضٌ","بالرّغمِ لمّا اِبيضّ منّي المَفْرقُ",63,"ق",1,0],["وأسود غربيبٌ وأخضر ناضرٌ","وأحمر قاني ثم أصفر فاقع",64,"ع",1,0],["وَاِسْوَدَّ حَظِّي عِنْدَهُم لَمَّا سَرى","فيهِ بِنَارِ صَبابتِي إِحْرَاقُ",65,"ق",1,0],["وا سوأتاه إذا وقفت بموقف","ما تخجل فيه سوى الأقدار",66,"ر",1,1],["وأسود تذبّ عنها وتحمي","شرفَ العربِ ليس تخشى اللوائِم",67,"م",1,0],["واسَوأتاهُ نَعيشُ بَعَدَك هَذهِ","سِمَةٌ تَرُدُّ الوَجهَ أسوَدَ أسفَعا",68,"ع",2,0],["وأسود الخال فوق الخد حين سجا","بحبّة القلب جئناه نسامره",69,"ر",2,0],["واسود وجه الليل لو عارضت","أنجمه ألفاظ هذي السطور",70,"ر",1,0],["وأسوق القريض نحوك إذ كا","ن بناديك نافق الأسواقِ",71,"ق",1,0],["وَأسُودٌ تَسُودُ كُلَّ هُمَامٍ","عَزَّ قَدْراً فَيَالَهُمْ مِنْ أسُودِ",72,"د",1,0],["وأسومه سوم العذاب كعادتي","فيه وأسلمه لشر مقيل",73,"ل",1,0],["وأَسوَدُ الخلقِ مَغمورٌ وأَحْمَرُهمْ","في أَسَودٍ مِنْ ظَلامٍ الظُّلْمِ غِربيبِ",74,"ب",1,0],["واسَوأَتا إِن خابَ ظَنّي غَداً","وَلَم تَسَعني رَحمَةُ اللَهِ",75,"ل",2,0],["وا سَوأَتا إِن كُنتُ سُكَّيتاً بِهِ","أَرجو اللِحاقَ عَلى هَجينٍ عاثِرِ",76,"ر",1,0],["واسودَّ مشرقُها ومغربها","بالنقع حتَّى ماتت الشمسُ",77,"س",1,0],["وأسودُ غيلٍ في المهابة لو حموا","مأوى الظباءِ لكانَ غيل أسود",78,"د",1,0],["وَاِسوَدَّ خَدّاهُ فَقُلت اِقصِروا","لَولا الدُجى ما حَسُنَ البَدرُ",79,"ر",1,0],["وأُسْوَتُكَ الرسولُ وإن يَشُكُّوا","فعندَ جُهَيْنَةَ الخبرُ اليقين",80,"ن",1,0],["وأسود نهد الوجنتين حديثه","بجحفلة تنهال عن شدقٍ أفوق",81,"ق",1,0],["وأسودِ شاذِروانِه","تهمي مياهاً كوثريّه",82,"ي",2,0],["وأسود القلب لم تحمد مآثره","ولو زهت ببياض اللون عمته",83,"ت",2,0],["وا سوأتاه أبا عتيق ما الذي","في قصتي جاءت به الأخبار",84,"ر",1,1],["واسؤتاكم تعز بي بلدٌ","أخرى وكم ذا أهان في بلدي",85,"د",2,0],["واسودّت الدنيا عليه وأوحشت","من بعده رتب العلا والسؤدد",86,"د",1,0],["واسودت الدنيا علينا بعده","واغبرت الغبراء والخضراء",87,"ا",2,0],["وَأسود غاب إِذ نمتهم نسبة","مِن حَي