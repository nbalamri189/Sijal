{"poems":[[53,"أي العيون تجانب الأقذاء","https://www.aldiwan.net/poem30780.html","الكامل"],[9,"ألم خيال من قتيلة بعدما","https://www.aldiwan.net/poem21981.html","الطويل"],[35,"ألما على سلمى نسلم ونسأل","https://www.aldiwan.net/poem39099.html","الطويل"],[93,"رب البيان وسيد القلم","https://www.aldiwan.net/poem11371.html","أحذ الكامل"],[30,"لقد جشأت نفسي عشية مشرف","https://www.aldiwan.net/poem29594.html","الطويل"],[30,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[83,"هي نفحة هبت من الأنصار","https://www.aldiwan.net/poem54284.html","الكامل"],[51,"قد عجلت لي عقوبة الخور","https://www.aldiwan.net/poem63996.html","المنسرح"],[51,"ومن العجائب يا أبا الفياض","https://www.aldiwan.net/poem64948.html","الكامل"],[51,"وقف الهوى بك بعد طول وجيفه","https://www.aldiwan.net/poem65460.html","الكامل"],[51,"ركبتك الخير التي لم يزل","https://www.aldiwan.net/poem66038.html","السريع"],[51,"قل لفتى لم يزل بصورته","https://www.aldiwan.net/poem66450.html","المنسرح"],[70,"وأسود شيخ في الثمانين سنه","https://www.aldiwan.net/poem42792.html","الطويل"],[70,"وأسود عار أنحل البرد جسمه","https://www.aldiwan.net/poem42828.html","الطويل"],[70,"وأسود مافيه من الخير خصلة","https://www.aldiwan.net/poem42837.html","الطويل"],[38,"ألم تدر ما قال الظباء السوانح","https://www.aldiwan.net/poem7696.html","الطويل"],[56,"وأحمر مذبح وقرا وزور","https://www.aldiwan.net/poem58563.html","الطويل"],[43,"ألا كل ماشية الخيزلى","https://www.aldiwan.net/poem9448.html","المتقارب"],[62,"لجلال قدرك تخضع الأقدار","https://www.aldiwan.net/poem52392.html","الكامل"],[45,"واسوأتا من رأيك العازب","https://www.aldiwan.net/poem10893.html","السريع"],[45,"طفقت تلوم ولات حين ملامه","https://www.aldiwan.net/poem65666.html","الطويل"],[45,"رحلت وأودعت الفؤاد لواحظا","https://www.aldiwan.net/poem66839.html","الكامل"],[74,"وأسود عن لنا سابح","https://www.aldiwan.net/poem12822.html","السريع"],[74,"وأسود يسبح في لجة","https://www.aldiwan.net/poem13265.html","السريع"],[21,"غدا جيران أهلك ظاعنينا","https://www.aldiwan.net/poem36142.html","الوافر"],[21,"مجدوا الله فهو للمجد أهل","https://www.aldiwan.net/poem36210.html","الخفيف"],[52,"وأسود في كف مجدولة","https://www.aldiwan.net/poem26942.html","المتقارب"],[48,"خذ العيش الهني من المجوس","https://www.aldiwan.net/poem66598.html","الوافر"],[46,"تخيرت جهدي لو وجدت خيارا","https://www.aldiwan.net/poem23644.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39661","الوافر"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30475","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54564","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54933","الخفيف"],[90,"معرض العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179147",""],[51,"رِكْبتُك الخيرُ التي لم يزل","https://www.poetsgate.com/ViewPoem.aspx?id=30400",""],[119,"جف الكرى عكس الدموع معاً دما","https://www.aldiwan.net/poem23824.html","الكامل"],[141,"دم بالصيام مهنأ ما داما","https://www.aldiwan.net/poem11821.html","الكامل"],[183,"عتبت الزمان عسى يعتب","https://www.aldiwan.net/poem14122.html","المتقارب"],[227,"وأسود يحكي الليل نقبة لونه","https://www.aldiwan.net/poem50767.html","الطويل"],[227,"معصمها من سوارها اعتقرا","https://www.aldiwan.net/poem51094.html","المنسرح"],[233,"من عذيري فيه وهل من عذير","https://www.aldiwan.net/poem32017.html","الخفيف"],[239,"يا صاحب القصر الذي شاده","https://www.aldiwan.net/poem45754.html","السريع"],[254,"يا سيدي جودك المشهور ما فعلا","https://www.aldiwan.net/poem48367.html","البسيط"],[301,"لا قبلنا في ذا المصاب عزاء","https://www.aldiwan.net/poem58419.html","الخفيف"],[318,"ولرب غانية رداح مذ رأت","https://www.aldiwan.net/poem61740.html","الكامل"],[318,"لا تخف ما صنعت بك الأشواق","https://www.aldiwan.net/poem67108.html","الكامل"],[355,"رعاك الله هذا وقت ضيق","https://www.aldiwan.net/poem4156.html","الوافر"],[362,"لما تراءت راية الربيع","https://www.aldiwan.net/poem60555.html","الرجز"],[364,"وأسود شيفوا محاجره","https://www.aldiwan.net/poem17381.html","المنسرح"],[399,"وأسود ليس يندى منه كف","https://www.aldiwan.net/poem46467.html","الوافر"],[399,"وا طول حزني في غد وتحسري","https://www.aldiwan.net/poem47004.html","الطويل"],[399,"واسوء حالي في غد","https://www.aldiwan.net/poem47009.html","الكامل"],[403,"ألم وليلي بالكواكب أشيب","https://www.aldiwan.net/poem50207.html","الطويل"],[429,"أنا من عينيك نشوان","https://www.aldiwan.net/poem12743.html","المديد"],[436,"نعم يبشر بدؤها بتمام","https://www.aldiwan.net/poem34866.html","الكامل"],[436,"بشراك أيتها الدنيا وبشرانا","https://www.aldiwan.net/poem34881.html","البسيط"],[446,"أترى لداء صبابتي ابلال","https://www.aldiwan.net/poem53722.html","الكامل"],[462,"وأسود اللون وافانا وقد جنحت","https://www.aldiwan.net/poem3157.html","عموديه"],[464,"يقول خليلي باللوى من حفارة","https://www.aldiwan.net/poem50474.html","الطويل"],[504,"عجبت للمرء في دنياه تطمعه","https://www.aldiwan.net/poem2419.html","البسيط"],[512,"نظر البدر وجهها فتلاها","https://www.aldiwan.net/poem20822.html","الخفيف"],[549,"يا أسم إن صبابتي","https://www.aldiwan.net/poem47301.html","مجزوء الكامل"],[549,"ما للخيال ببطن مر يطرق","https://www.aldiwan.net/poem47378.html","الكامل"],[556,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[584,"لا تخف ما صنعت بك الأشواق","https://www.aldiwan.net/poem17611.html","الكامل"]],"verses":[["وَاِسوَدَّ شَطرُ اليَومِ تَرجُفُ شَمسُهُ","قَلَقاً وَجَرَّ ضِياؤُهُ الظَلماءَ",0,"ا",2,0],["وَآسٌ وَخيرِيٌّ وَمَروٌ وَسَوسَنٌ","إِذا كانَ هِنزَمنٌ وَرُحتُ مُخَشَّما",1,"م",2,0],["وَأَسوَدَ مَيّالٍ عَلى جيدِ ظَبيَةٍ","مِنَ الُدمِ حَوراءِ المَدامِعِ مُغزِلِ",2,"ل",1,0],["وَأَسَوْتَ مَكْلُومَ النُّفُوسِ إِسَا","مِنْ يَقْرِنُ التَّضْمِيدَ بِالنَّغَمِ",3,"م",1,0],["وَأَسوَدَ وَلاّجٍ بِغَيرِ تَحِيَّةٍ","عَلى الحَيِّ لَم يُحرِم وَلَم يَحتَمِل وِزرا",4,"ر",2,0],["واسَوأَتا ثُمَّ يا وَيلا وَيا حَرَبا","إِنّي أَخو الجِسمِ فيه السُقمُ وَالكُرَبُ",5,"ب",1,0],["واسودْ وجه الكفر من خزي متى","ما احْمَرَّ وجه الأبيض البتّارِ",6,"ر",1,0],["واسوأتا للحكيمِ همتُهُ","إشباعُهُ بنتَهُ من الكمر",7,"ر",1,0],["وا سَوْأَتا إن ضاقَ ذَرْعُك بالغنى","عِند ادِّراع قميصه الفضْفاض",8,"ض",1,0],["واسوأتي والله من تطفيفه","إذ لا تخاف هناك من تطفيفه",9,"ف",2,0],["وأسودُ الناسِ لهم سيّدٌ","مُسْتَنْهَضٌ في الحاجِ مُستَخدَمُ",10,"م",1,0],["وأَسوءُ السيئات سلُّكَ بال","جهل حُساماً عليك مسنونا",11,"ن",2,0],["وَأَسوَدُ شَيخٍ في الثَمانينَ سِنُّهُ","غَدا وَجهُهُ مِن أَبيَضِ الشَيبِ أَبلَقا",12,"ق",2,1],["وَأَسوَدَ عارٍ أَنحَلَ البَردُ جِسمَهُ","وَما زالَ مِن أَوصافِهِ الحِرصُ وَالمَنعُ",13,"ع",1,1],["وَأَسوَدَ مافيهِ مِنَ الخَيرِ خَصلَةٌ","لَهُ زَفرَةٌ مِن شَرِّهِ وَشُواظُ",14,"ظ",1,1],["وَأَسوَدَ مَيّالٍ عَلى جيدِ مُغزِلٍ","دَعاها طَلىً أَحوى بِرَمّانَ راشِحُ",15,"ح",1,0],["وأَسْودَ لَهْذَمِ السّيْرَينِ جَوْنٍ","وأَزْرقَ مِنْسَرٍ أَقْنَى نَهُوسِ",16,"س",1,0],["وَأَسوَدُ مِشفَرُهُ نِصفُهُ","يُقالُ لَهُ أَنتَ بَدرُ الدُجى",17,"ا",1,0],["وأسوتَ جُرْحَ الحادثاتِ وطالما","كنَّا وجُرْحُ الحادثاتِ جُبَارُ",18,"ر",1,0],["واسَوأَتا مِن رَأيِكَ العازِبِ","وَعَقلِكَ المُستَهتِرِ الذاهِبِ",19,"ب",1,1],["وَاِسوَدَّ ثُمَّ صَفَت لِعَينَي ناظِرٍ","جَنَباتُهُ فَأَضاءَ في إِظلامِهِ",20,"م",2,0],["وَاسوَدَّ وَجهُ الشَمسِ وَاحمَرَّت ظُبا","بيضِ الصِفاحِ وَبَلَّدَ البَطَلانِ",21,"ن",1,0],["وَأَسوَدٍ عَنَّ لَنا سابِحٍ","في لُجَّةٍ تَطفَحُ بَيضاءِ",22,"ا",2,1],["وَأَسوَدٍ يَسبَحُ في لُجَّةٍ","لاتَكتِمُ الحَصباءَ غُدرانُها",23,"ه",2,1],["وأَسودُ وَمدلَهِمَّ اللَونِ حَشلاً","بَدَهنِ البانِ وَالغالِي غُذينا",24,"ن",2,0],["وَأُسوداً عَوادياً وَفيولاً","وَسِباعاً وَالنَملَ وَالخِنزيرا",25,"ر",2,0],["وَأَسوَدَ في كَفِّ مَجدولَةٍ","لَطيفٍ لَهُ خِلقَةٌ مُنكَرَه",26,"ه",1,1],["وأسود لهذم الشفرين يفري","وأزرقَ منسَرٍ أقنىً هموس",27,"س",1,0],["وأسْوَدَ لم تَعْرِفْ له الإنْسُ والِداً","كَسانيَ منه حُلّةً وخِمارا",28,"ر",2,0],["وأسواقٌ تُباع بها وتُشْرى","ضمائرُ هُنَّ للأهواءِ نَهْبُ",29,"ب",1,0],["وأَسْودَ مبيَضِّ القبَاءِ كأَنَّمَا","يَطِيرُ به نَحْوَ الكَرِيهةِ عَقْعَقُ",30,"ق",1,0],["وَاسُوا الفَقِيرَ وَأَصْلِحُوا مِنْ شَأْنِهِ","أَوْلاَ فَإِنَّ غَداً لَجِدُّ مُرِيبِ",31,"ب",1,0],["وَأُسُوداً يُخْشَى التَّحَفزُ مِنْهَا","وَيَرُوعُ السَّكُوتُ كَالتَّزْآرِ",32,"ر",1,0],["واسوْدّ بالنِيات سوداً خاطرٌ","ومَشَى على البعضِ الصفاءُ فبيَّضا",33,"ض",2,0],["وأسودُ الناسِ لهم سيّدٌ","فمُسْتَنْهَضٌ في الحاجِ مُستَخدَم",34,"م",1,0],["واسويس والوجه الذي بهْ قد نُعي","رحم الإله محمداً بِهْ فارحما",35,"م",2,0],["وَأُسودُ هَيجاءٍ إِذا قَصَدَت وَغىً","حَمَلَت عَلى أَكتافِها الآجاما",36,"م",2,0],["وأسودُ كالأسودِ المستطيل","يَلْدَغُ ذاك وذا يَلْسَب",37,"ب",1,0],["وأسوَدَ يحكي الليل نُقْبة لونِهِ","حَكَى أمَّه في كلّ تركيبِها لِينا",38,"ن",2,1],["وأسودَّ للحسن فَرْقُ لِمَّتها","واحمرَّ مُبيضُّها ليستعرا",39,"ر",2,0],["وَأُسودٍ مِن غِلمَةِ التُركِ لا تَأ","لَفُ إِلّا غيلَ القَنا المَشجورِ",40,"ر",1,0],["واسوَدَّ ذاكَ الجونُ من جِلده","وابيضَ ذاك الجَونُ من فَودِه",41,"د",2,0],["واسوأتا من أناسٍ ظلت أطمعهم","أن الذي التمسوه منك قد حصلا",42,"ل",2,0],["وأُسودُ الأيامِ لا ترتضى الأج","سامَ قوتاً وتأكلُ الحَوْباءَ",43,"ا",2,0],["وَأَسومُها بِالمَالِ نيلَ رِضائِها","حَتّى حَلَلتِ يَمينَها بِيَساري",44,"ر",2,0],["وَاِسوَدَّ حَظّي عِندَهُم لَمّا سَرى","يَبغي الضِياءَ وَخانَهُ الأَمحاقُ",45,"ق",1,0],["وَأسوَاقُ المَتَاجِرِ كَاسِدَاتٌ","فَلَيتَ كَذَاكَ أسوَاقَ الدَّقِيقِ",46,"ق",1,0],["وَاِسوَدَّ مِن بَعدِ البَياضِ القُنَنُ","فَشَبَّ مِن بَعدِ المَشيبِ الزَمَنُ",47,"ن",1,0],["وَأَسوَدٍ شَيَّفوا مَحاجِرَهُ","وَدَمعُهُ في الشِيافِ قَد ذَرَفا",48,"ف",2,1],["وأسود لَيسَ يندَى مِنهُ كفّ","لطالبه إذا سِيمَ النّوالاَ",49,"ل",2,1],["وا سَوأتي ن أَفْردَتْنِي حائراً","أَهْلي وأسْلمني هنالك مَعْشري",50,"ي",1,0],["وَاسوء حَالي فِي غدٍ","لَقَبيحِ ما قَد كان مِنّي",51,"ن",2,1],["وَأَسودها في القَلبِ أَسود سالِخٍ","وَأَبيضها في الجسم أَبيَضُ مقضَبُ",52,"ب",1,0],["وأُسودٍ خافَ سطوَتَها","كلّما حازَتْهُ خَفانُ",53,"ن",1,0],["وأُسُودِ غابٍٍ مَا تَلَذُّ حَياتَها","حَتَّى تُدِيرَ بِهَا كؤوسَ حِمامِ",54,"م",1,0],["وَأُسْوَةً برَسُولِ اللهِ والِدِهِ","فيمنْ تخَيَّرَ أنصاراً وجيرانا",55,"ن",2,0],["واسوّدت الأيام بعدكم أسىً","فلذا ليالى المستهام طوال",56,"ل",1,0],["وأسودَ اللَّون وافانا وقد جنحتْ","شمسُ الأصيل فوافى وافدُ الظُّلمِ",57,"م",1,1],["وَأَسوَدَ مَيّادٍ عَلى جَيدِ عَوهَجٍ","جَعادِ النَواحي غَيرُ زُعرٍ ذَوائِبُه",58,"ه",1,0],["وأسوأ الناسِ تدبيراً لعاقبِةٍ","من انفقَ العمر فيما ليس ينفعه",59,"ع",2,0],["وأُسوداً تهبّ مثلَ النّعامى","في ظُهورِ النّعامِ يومَ وَغاها",60,"ا",3,0],["وأسَوْتِ بالتّوديع في","يوم النّوى نفساً عليلهْ",61,"ل",2,0],["واِسودّ منّي كلُّ ما هو أبيضٌ","بالرّغمِ لمّا اِبيضّ منّي المَفْرقُ",62,"ق",1,0],["وأسود غربيبٌ وأخضر ناضرٌ","وأحمر قاني ثم أصفر فاقع",63,"ع",1,0],["وَاِسْوَدَّ حَظِّي عِنْدَهُم لَمَّا سَرى","فيهِ بِنَارِ صَبابتِي إِحْرَاقُ",64,"ق",1,0]]}