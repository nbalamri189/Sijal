{"poems":[[55,"لبست الوغى قبل ثوب الغبار","https://www.aldiwan.net/poem30457.html","المتقارب"],[79,"أشارت غداة البين من خلل السجف","https://www.aldiwan.net/poem35976.html","الطويل"],[79,"إذا فاتني ظل الحمى ونعيمه","https://www.aldiwan.net/poem36117.html","الطويل"],[79,"تخطت وفود الليل بان به الوخط","https://www.aldiwan.net/poem36395.html","الطويل"],[79,"سلا هل لديها من مخبرة ذكر","https://www.aldiwan.net/poem36463.html","الطويل"],[53,"حتى متى يوري سواي وأقتدح","https://www.aldiwan.net/poem9423.html","الكامل"],[87,"سلو قلبي غداة سلا وثابا","https://www.aldiwan.net/poem63783.html","الوافر"],[63,"أفق من سكرة الأمل المحال","https://www.aldiwan.net/poem51465.html","الوافر"],[82,"أمسك الصبا أهدت إلي صبا نجد","https://www.aldiwan.net/poem31482.html","الطويل"],[82,"ومنغمس في صبغة الليل يمتطي","https://www.aldiwan.net/poem31488.html","الطويل"],[41,"هل يدنيك من أجارع واسط","https://www.aldiwan.net/poem53778.html","الكامل"],[96,"البلبل الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=12827",""],[133,"أنامل النسيان مري على","https://www.aldiwan.net/poem67432.html","السريع"],[147,"ذد بالعزاء الهم عن طلباته","https://www.aldiwan.net/poem11739.html","الكامل"],[154,"ماذا أقول ولا عتب على القدر","https://www.aldiwan.net/poem68476.html","البسيط"],[186,"أمنازل الأحباب ما فعل الألى","https://www.aldiwan.net/poem67039.html","الكامل"],[194,"وان يعمهُم حياً مطبقُ","https://www.aldiwan.net/poem1158.html",""],[203,"شكوت هواها فاشتكتني إلى هجر","https://www.aldiwan.net/poem45650.html","الطويل"],[228,"لمن يا ترى أشكو بمدمعي الهمل","https://www.aldiwan.net/poem41906.html","الطويل"],[309,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[310,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[347,"حيه ما حييت يا قلب واهدا","https://www.aldiwan.net/poem55329.html","الخفيف"],[358,"بالفتح لاح لنا الهناء مبشرا","https://www.aldiwan.net/poem40350.html","الكامل"],[408,"فيك أما في سواك فلا","https://www.aldiwan.net/poem46911.html","المديد"],[408,"أتت تفتر عن زهر الأقاح","https://www.aldiwan.net/poem46912.html","الوافر"],[409,"مرحبا يا مرحبا يا مرحبا بنسيم","https://www.aldiwan.net/poem34146.html","الرمل"],[412,"بدا البرق من نجد فحن إلى نجد","https://www.aldiwan.net/poem50190.html","الطويل"],[463,"سل بسلع شجنا كان وكنا","https://www.aldiwan.net/poem55822.html","الرمل"],[484,"خذ الكاسات واشرب من مدامي","https://www.aldiwan.net/poem37598.html","الوافر"],[487,"سلام كما حيتك عاطرة النشر","https://www.aldiwan.net/poem24379.html","عموديه"],[505,"أبدر الحي غلغلت الستاره","https://www.aldiwan.net/poem38010.html","الوافر"],[510,"المفر","https://www.aldiwan.net/poem27797.html","الوافر"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138215",""],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63741","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62618","المتقارب"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119870","الوافر"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31558","الوافر"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1356,"","https://poetry.dctabudhabi.ae/diwan/poem/200251","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49967","البسيط"],[1653,"","https://poetry.dctabudhabi.ae/diwan/poem/32558","الرجز"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108627","الوافر"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108758","الطويل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124716","الطويل"],[2306,"","https://poetry.dctabudhabi.ae/diwan/poem/144437","الوافر"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134024","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134193","الوافر"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101633","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48323","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48320","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206140","الطويل"],[3802,"","https://poetry.dctabudhabi.ae/diwan/poem/141066","الرمل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66553","الطويل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40117","الخفيف"],[2979,"","https://poetry.dctabudhabi.ae/diwan/poem/107042","المتقارب"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119618","الطويل"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45929","الطويل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97088","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94532","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94539","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94439","الطويل"],[4767,"عين الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=93516",""],[4940,"سهام الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=210455",""],[5121,"بُلْبُلٌ وَلَكِنْ","https://www.poetsgate.com/ViewPoem.aspx?id=33586",""],[5365,"عصف روح","https://www.poetsgate.com/ViewPoem.aspx?id=190405",""],[1547,"قالوا بدا في خدِّه الشَّعرُ","https://www.poetsgate.com/ViewPoem.aspx?id=16767",""],[5790,"من مبلغ عني المليك الأروعا","https://www.poetsgate.com/ViewPoem.aspx?id=111886",""],[5956,"الرَّصيفُ ذو الحصى العسليّ","https://www.poetsgate.com/ViewPoem.aspx?id=184884",""],[5974,"مرافئ الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=214988",""],[6124,"أتلفت قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=194527",""],[6164,"أطوار..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66060&r=&rc=69",""],[6300,"في رحاب الذات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82837&r=&rc=8",""],[5190,"أُحمِّلك السلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78312&r=&rc=25",""]],"verses":[["وَأُسدٍ إِذا شَعَرَت بِالحَمامِ","رَأَت عَيشَها خَلفَ ذاكَ الشِعارِ",0,"ر",1,0],["وأُسْدٍ غِضابٍ إنْ تذكّرْنَ يومَها","عضَضْنَ بأطْرافِ البَنانِ منَ اللّهْفِ",1,"ف",1,0],["وَأُسْدُ جِهَادٍ أَذْعَنَتْ لِسُيُوفِهِمْ","جَلاَلِقَةُ الثَّغْرِ الْغَرِيبِ وَرُومُهُ",2,"م",2,0],["وَأَسْدُ نِزَالٍ مِنْ ذُؤَابَةِ خَزْرَجٍ","بِهَاليلُ لاّ رُومُ الْقَدِيم وَلاَ قِبْطُ",3,"ط",1,0],["وأسْدُ رِجالٍ منْ مَرينٍ مُخيفَةٌ","عَمائِمُها بيضٌ وآسالُها سُمْرُ",4,"ر",1,0],["واسْدُدْ به خَلَلي ولمَّا أَنْهَتِكْ","وَأَزِحْ به عِلَلي ولمَّا أفْتَضِحْ",5,"ح",1,0],["وَأَسدَت لِلبَرِيَّةِ بِنتُ وَهبٍ","يَداً بَيضاءَ طَوَّقَتِ الرِقابا",6,"ب",2,0],["وأُسدٍ من أُسودِ الراحِ تَسطُو","شَمائلُها على أُسدِ الشَّمالِ",7,"ل",1,0],["وأُسْدٍ على مثل السّعَالي عوابسٍ","لها لَبَدٌ من صَنعَةِ الحَلَق السّرْدِ",8,"د",1,0],["وأُسْدٍ تصيرُ الأُسْدُ كالبَهْمِ عِندَها","إذا ما الظُّبى خَطّتْ رُبوعَ القلائِدِ",9,"د",1,0],["وَأَسَدَّ بَعدَ ثَأىً لِوَهيِ عَظيمَةٍ","وَأَفَكَّ في قَنَعٍ لِكُلِّ إِسارِ",10,"ر",1,0],["وأسدل أجفاني غطاء يظلّه","وياليتها كانت أحنّ وأحدبا",11,"ب",2,0],["واسدُلي سِيترَ ما مَضى","وافتحي كُوَّةَ الرِضى",12,"ض",2,0],["وَأَسَدُّ مَن أَسدى يَداً مَأثورَةً","مَن أَودَعَ المَعروفَ عِندَ ثِقاتِهِ",13,"ت",2,0],["وأسد رغبة تردي أعوجيتها","بحيث لم تُبق إنساناً ولم تذر",14,"ر",1,0],["وَأسدُّ مَن عَرك الأُمورَ تَصَرُّفاً","في حينِ لا يَجدُ اللَبيبَ مِعوَّلا",15,"ل",2,0],["وَاُسدُ غابٍ فَوقَهُنَّ الخَلَقُ","وَالتَّركُ مِن فَوقِ الرُّؤُوسِ تَبرُقُ",16,"ق",1,0],["وأسديتَ لي ذا الشعرَ حتى كأنما","لقطتُ نفيسَ الدرِّ من ساحل البحرِ",17,"ر",1,0],["وَأَسد مَع الأَحرارِ أُغنيَّةَ العَلى","فَما الحُرُّ إِلّا بُلبُلُ المَجدِ وَالنُبلِ",18,"ل",1,0],["وأسد كلاما في السماع لاهله","وقيد حديثا في العيان بابان",19,"ن",1,0],["وَأسدٍ عَلى جُردٍ تجرّ ذُيولَها","عَلى أوجهِ الأجواءِ أردية نهبا",20,"ب",2,0],["واسده يا فؤاد شكراً وحمداً","واهده يا نسيم عطراً وندا",21,"د",2,0],["وَاِسدل عَلَيهِ ظلال عزّتك الَّتي","هِيَ لَم تَزَل دِرعاً تَقيهِ وَمغفرا",22,"ر",2,0],["وأسدُّ الأذنَ إن عذلوا","فيك كيلا أسمع العَدَلاّ",23,"ل",2,0],["وأسد الحرب إذ لا غاب إلاّ","سيوف الهند أو سمر الرّماح",24,"ح",1,0],["وأسدّ الأذن عن أخباره","فهي لا تتحف سمعاً بنبا",25,"ب",2,0],["وَأَسدٍ عَلى جُردٍ مِنَ الخَيلِ ضُمَّرٍ","وَهَيهات مَن يَحميكَ أَسداً عَلى جردِ",26,"د",1,0],["واسدوهُ كابرا عن كابرٍ","كلَّما مات أبٌ ورّثَه ابْنا",27,"ن",2,0],["واسدل في السؤال ذيول لطف","فخلته وهو يسألني غلامي",28,"م",2,0],["وأسدي سلاما للحبيب محمد","سيد الدنا والأخرى بلا نكر",29,"ر",1,0],["وأُسْدِلَ من سِتارَتِهِ سُتورٌ","وحُقِّقتِ الأِشارَةُ والبِشارَهْ",30,"ر",2,0],["وأسْدُ العُرْبِ في الغرْبِ تُسبُّ","وحُمْرُ الغربِ في العُرْبِ تُبرُّ",31,"ر",1,0],["وإسداء المبرة والزكاةِ","وإيلاء المراحم والصلات",32,"ت",1,0],["وأُسدِ هذا الحيِّ من نزار","رَهْطِ الرسولِ المصطفى المختار",33,"ر",1,0],["وأسدل على زلتي من عظيم","عفوك ما لذنوبي ستر",34,"ر",1,0],["وأسدا غابها الأرماح تهوي","بها خيل كامثال الأجادل",35,"ل",1,0],["وأُسْداً في مَرابِضِها ظِباءٌ","تُقابِلُها على حَالِ اسْتِواءِ",36,"ا",2,0],["واسدس مفاعلتن السباعي","لوافر تفز بالأتباع",37,"ع",1,0],["وأسدلت حمراء الملابس فوقها","بمفرق تاج المجد والشرف المحض",38,"ض",1,0],["وأسدتِ الأَزْدُ عندى اليوم منِ نعَمٍ","ما لا ربيعةُ أسدتهُ ولا مُضَرُ",39,"ر",1,0],["وَأَسدِ نُعماكَ إِلَيهِم وَاِتَّخِذ","حَمداً وَشُكراً كُلَّ ذاكَ عِندَهُم",40,"م",1,0],["وأسداها نضار الشمس لوناً","وصاغ لها لجين الصبح نحرا",41,"ر",2,0],["وأسداه سوريا فأحيا مواتها","وثبت من أركانها ما تزعزعا",42,"ع",2,0],["وأسدُ بني النجار تخطرُ حولَهُ","بأسيافهم كالأسدِ تخطرُ في الأجمِ",43,"م",1,0],["وأسداً حبيسها سمر العوالي","إذا ما الأسد حاولت الكفاحا",44,"ح",2,0],["واسدى وسام الامتياز إليك من","مواهبه العليا ويا حبذا البر",45,"ر",1,0],["واسداه بنيشان","ترصع واعتلى قيما",46,"م",2,0],["وأسدس من الصخر الأصم تخالها","تهم بوثبٍ ثم تربض عن كبر",47,"ر",1,0],["وأُسْدِ رِجالٍ من ذَوي الحَزْمِ لم تَزَلْ","لحَرْبِ العِدَى مأخوذَةً أُهُباتُها",48,"ت",3,0],["وأُسْدِ رِجالٍ منْ جُنودِكَ كلّما","أُزيحُوا عنِ الهَيْجاءِ لمْ يتزَحْزَحوا",49,"ح",3,0],["وأسديك في نجواي شكر لذاذة","لعلك لو تدري بها كنت تبخَل",50,"ل",1,0],["واسدِلي الليل على بدر الدُّجَى","فحديثُ الشوقِ يحلو في الظلام",51,"م",1,0],["وَأُسْدِ عَلى جُرْدٍ لَهَا مِثْلُ صَبْرِهِمْ","إِذْا ما تَجَلَّى الْمَوْتُ فِي الْحُلَلِ الْحُمْرِ",52,"ر",1,0],["وأَسَدُّ الأنام قولاً وأَفعا","لاً وَنَفساً وَنِيّةً وَيَقينا",53,"ن",2,0],["وأسدت اليه ثياب الفخار","بأيد يمد نداها البحورا",54,"ر",2,0],["وأسد عرين في الوغى قد تعودت","صيالاً إذ جل الكماة تأخروا",55,"ر",3,0],["وَأَسدى إِلَينا مِن مَواهِبِ عِلمِهِ","أَيادِيَ لا تُحصى فَأَعظِمْ بِها يَدا",56,"د",2,0],["وأسداً متى هاجت تدرك بعزمها","مغارب أعدها بأقصى المشارق",57,"ق",1,0],["وأسدل فوق الناس أمناً وراحةً","وعدلاً وانصافاً ورُحماً مع السُرِّ",58,"ر",1,0],["وأسدل فوق بحر الروح عدلاً","يلوح بأفقهِ منهُ سناءُ",59,"ا",2,0],["وأسدى تحيّاتٍ إلى المنزل الَّذي","يُنادي بتصغيرٍ كُريماً تحببا",60,"ب",2,0],["وأسدَى النصح إشفاقاً عليهم","فسَدُّوا عن سَماعِ النصح بابا",61,"ب",2,0],["وأسدلت الستارَ على الحكايا","وأعلنت النهاية ما ابتدينا",62,"ن",2,0],["وَأَسْدَلْتُ جَفْنِي مِنْ دُمُوعٍ بَكَيْتُهَا","فَأَطْلَقْتُ رُوحِي فِي سُجُونِي وَفِي طَمْسِي",63,"س",2,0],["وأسدَلتُ السّتارَ على الحكايا","كحُزن النّخل في يَبَسِ السّعوفِ",64,"ف",1,0],["واسد خدّاهُ فقلتء اقصروا","لولا الدجى ما حسنَ البدرُ",65,"ر",1,0],["وأسد آراء وأثقب فكرةً","وأشد عارضةً وألطف موقعا",66,"ع",2,0],["وأُسدي إليهم جميع الحقوق","من الوُدِّ والمال دون عقوقْ",67,"ق",1,0],["وأسدل الليل في عينيّ بردته","وتاه في غيهب الأمواج إبحاري",68,"ر",2,0],["وَأَسْدَلْتُ سِتْرًا بَيْنَ شَوقِي وقلبِهَا","وبينَ الذي يَغْفُو بِدَمْعِي الخَضِيْبِ",69,"ب",1,0],["وأَسْدُرُ في غَيِّ الحياة وأَرْعَوي","فَاَبْكِي.. وتَطْوِيني رُؤاها وتَنْشُرُ!",70,"ر",1,0],["وأ ُسدِلَ النُّورُ في مِحْرابِ قافيتي","فكنتُ مَنْ عَانقَ الألحانَ وانْجَذَبَا",71,"ب",2,0],["وأسدَلَتْ الدروبُ ستارَ شجوٍ","على الأحلامِ في الليلِ العسير",72,"ر",1,0]]}