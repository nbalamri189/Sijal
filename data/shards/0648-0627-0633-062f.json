{"poems":[[53,"لبست الوغى قبل ثوب الغبار","https://www.aldiwan.net/poem30457.html","المتقارب"],[77,"أشارت غداة البين من خلل السجف","https://www.aldiwan.net/poem35976.html","الطويل"],[77,"إذا فاتني ظل الحمى ونعيمه","https://www.aldiwan.net/poem36117.html","الطويل"],[77,"تخطت وفود الليل بان به الوخط","https://www.aldiwan.net/poem36395.html","الطويل"],[77,"سلا هل لديها من مخبرة ذكر","https://www.aldiwan.net/poem36463.html","الطويل"],[51,"حتى متى يوري سواي وأقتدح","https://www.aldiwan.net/poem9423.html","الكامل"],[85,"سلو قلبي غداة سلا وثابا","https://www.aldiwan.net/poem63783.html","الوافر"],[61,"أفق من سكرة الأمل المحال","https://www.aldiwan.net/poem51465.html","الوافر"],[80,"أمسك الصبا أهدت إلي صبا نجد","https://www.aldiwan.net/poem31482.html","الطويل"],[80,"ومنغمس في صبغة الليل يمتطي","https://www.aldiwan.net/poem31488.html","الطويل"],[39,"هل يدنيك من أجارع واسط","https://www.aldiwan.net/poem53778.html","الكامل"],[94,"البلبل الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=12827",""],[129,"أنامل النسيان مري على","https://www.aldiwan.net/poem67432.html","السريع"],[143,"ذد بالعزاء الهم عن طلباته","https://www.aldiwan.net/poem11739.html","الكامل"],[150,"ماذا أقول ولا عتب على القدر","https://www.aldiwan.net/poem68476.html","البسيط"],[182,"أمنازل الأحباب ما فعل الألى","https://www.aldiwan.net/poem67039.html","الكامل"],[190,"وان يعمهُم حياً مطبقُ","https://www.aldiwan.net/poem1158.html",""],[199,"شكوت هواها فاشتكتني إلى هجر","https://www.aldiwan.net/poem45650.html","الطويل"],[223,"لمن يا ترى أشكو بمدمعي الهمل","https://www.aldiwan.net/poem41906.html","الطويل"],[304,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[305,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[342,"حيه ما حييت يا قلب واهدا","https://www.aldiwan.net/poem55329.html","الخفيف"],[353,"بالفتح لاح لنا الهناء مبشرا","https://www.aldiwan.net/poem40350.html","الكامل"],[402,"فيك أما في سواك فلا","https://www.aldiwan.net/poem46911.html","المديد"],[402,"أتت تفتر عن زهر الأقاح","https://www.aldiwan.net/poem46912.html","الوافر"],[403,"مرحبا يا مرحبا يا مرحبا بنسيم","https://www.aldiwan.net/poem34146.html","الرمل"],[406,"بدا البرق من نجد فحن إلى نجد","https://www.aldiwan.net/poem50190.html","الطويل"],[458,"سل بسلع شجنا كان وكنا","https://www.aldiwan.net/poem55822.html","الرمل"],[479,"خذ الكاسات واشرب من مدامي","https://www.aldiwan.net/poem37598.html","الوافر"],[482,"سلام كما حيتك عاطرة النشر","https://www.aldiwan.net/poem24379.html","عموديه"],[500,"أبدر الحي غلغلت الستاره","https://www.aldiwan.net/poem38010.html","الوافر"],[505,"المفر","https://www.aldiwan.net/poem27797.html","الوافر"]],"verses":[["وَأُسدٍ إِذا شَعَرَت بِالحَمامِ","رَأَت عَيشَها خَلفَ ذاكَ الشِعارِ",0,"ر",1,0],["وأُسْدٍ غِضابٍ إنْ تذكّرْنَ يومَها","عضَضْنَ بأطْرافِ البَنانِ منَ اللّهْفِ",1,"ف",1,0],["وَأُسْدُ جِهَادٍ أَذْعَنَتْ لِسُيُوفِهِمْ","جَلاَلِقَةُ الثَّغْرِ الْغَرِيبِ وَرُومُهُ",2,"م",2,0],["وَأَسْدُ نِزَالٍ مِنْ ذُؤَابَةِ خَزْرَجٍ","بِهَاليلُ لاّ رُومُ الْقَدِيم وَلاَ قِبْطُ",3,"ط",1,0],["وأسْدُ رِجالٍ منْ مَرينٍ مُخيفَةٌ","عَمائِمُها بيضٌ وآسالُها سُمْرُ",4,"ر",1,0],["واسْدُدْ به خَلَلي ولمَّا أَنْهَتِكْ","وَأَزِحْ به عِلَلي ولمَّا أفْتَضِحْ",5,"ح",1,0],["وَأَسدَت لِلبَرِيَّةِ بِنتُ وَهبٍ","يَداً بَيضاءَ طَوَّقَتِ الرِقابا",6,"ب",2,0],["وأُسدٍ من أُسودِ الراحِ تَسطُو","شَمائلُها على أُسدِ الشَّمالِ",7,"ل",1,0],["وأُسْدٍ على مثل السّعَالي عوابسٍ","لها لَبَدٌ من صَنعَةِ الحَلَق السّرْدِ",8,"د",1,0],["وأُسْدٍ تصيرُ الأُسْدُ كالبَهْمِ عِندَها","إذا ما الظُّبى خَطّتْ رُبوعَ القلائِدِ",9,"د",1,0],["وَأَسَدَّ بَعدَ ثَأىً لِوَهيِ عَظيمَةٍ","وَأَفَكَّ في قَنَعٍ لِكُلِّ إِسارِ",10,"ر",1,0],["وأسدل أجفاني غطاء يظلّه","وياليتها كانت أحنّ وأحدبا",11,"ب",2,0],["واسدُلي سِيترَ ما مَضى","وافتحي كُوَّةَ الرِضى",12,"ض",2,0],["وَأَسَدُّ مَن أَسدى يَداً مَأثورَةً","مَن أَودَعَ المَعروفَ عِندَ ثِقاتِهِ",13,"ت",2,0],["وأسد رغبة تردي أعوجيتها","بحيث لم تُبق إنساناً ولم تذر",14,"ر",1,0],["وَأسدُّ مَن عَرك الأُمورَ تَصَرُّفاً","في حينِ لا يَجدُ اللَبيبَ مِعوَّلا",15,"ل",2,0],["وَاُسدُ غابٍ فَوقَهُنَّ الخَلَقُ","وَالتَّركُ مِن فَوقِ الرُّؤُوسِ تَبرُقُ",16,"ق",1,0],["وأسديتَ لي ذا الشعرَ حتى كأنما","لقطتُ نفيسَ الدرِّ من ساحل البحرِ",17,"ر",1,0],["وَأَسد مَع الأَحرارِ أُغنيَّةَ العَلى","فَما الحُرُّ إِلّا بُلبُلُ المَجدِ وَالنُبلِ",18,"ل",1,0],["وأسد كلاما في السماع لاهله","وقيد حديثا في العيان بابان",19,"ن",1,0],["وَأسدٍ عَلى جُردٍ تجرّ ذُيولَها","عَلى أوجهِ الأجواءِ أردية نهبا",20,"ب",2,0],["واسده يا فؤاد شكراً وحمداً","واهده يا نسيم عطراً وندا",21,"د",2,0],["وَاِسدل عَلَيهِ ظلال عزّتك الَّتي","هِيَ لَم تَزَل دِرعاً تَقيهِ وَمغفرا",22,"ر",2,0],["وأسدُّ الأذنَ إن عذلوا","فيك كيلا أسمع العَدَلاّ",23,"ل",2,0],["وأسد الحرب إذ لا غاب إلاّ","سيوف الهند أو سمر الرّماح",24,"ح",1,0],["وأسدّ الأذن عن أخباره","فهي لا تتحف سمعاً بنبا",25,"ب",2,0],["وَأَسدٍ عَلى جُردٍ مِنَ الخَيلِ ضُمَّرٍ","وَهَيهات مَن يَحميكَ أَسداً عَلى جردِ",26,"د",1,0],["واسدوهُ كابرا عن كابرٍ","كلَّما مات أبٌ ورّثَه ابْنا",27,"ن",2,0],["واسدل في السؤال ذيول لطف","فخلته وهو يسألني غلامي",28,"م",2,0],["وأسدي سلاما للحبيب محمد","سيد الدنا والأخرى بلا نكر",29,"ر",1,0],["وأُسْدِلَ من سِتارَتِهِ سُتورٌ","وحُقِّقتِ الأِشارَةُ والبِشارَهْ",30,"ر",2,0],["وأسْدُ العُرْبِ في الغرْبِ تُسبُّ","وحُمْرُ الغربِ في العُرْبِ تُبرُّ",31,"ر",1,0]]}