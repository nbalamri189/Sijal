net/poem3411.html","عموديه"],[464,"لو عاد طيفكم فعاد عليلا","https://www.aldiwan.net/poem3602.html","عموديه"],[477,"كم دون مسراك من بيد وأخطار","https://www.aldiwan.net/poem15202.html","البسيط"],[477,"ربع وقفت عليه بعد أهليه","https://www.aldiwan.net/poem15251.html","البسيط"],[479,"ظلموك يا جدي ولست ظلوما","https://www.aldiwan.net/poem37194.html","الكامل"],[514,"هذا الحمى يا فتى فانزل بحومته","https://www.aldiwan.net/poem20832.html","البسيط"],[515,"لا وعيون لحظها ساهر","https://www.aldiwan.net/poem12116.html","السريع"],[551,"يا حامل الكأس ناولني مشعشعة","https://www.aldiwan.net/poem47138.html","البسيط"],[551,"يا دار دار الصوم القوم","https://www.aldiwan.net/poem47200.html","السريع"],[551,"أرأيت ما صنعت بنا الأيام","https://www.aldiwan.net/poem47248.html","الكامل"],[551,"أما ترى الدهر لا يبقي على حال","https://www.aldiwan.net/poem47289.html","البسيط"],[551,"هبت تلوم على الندى هند","https://www.aldiwan.net/poem47877.html","أحذ الكامل"],[551,"أجر المدامع كيف شيتا","https://www.aldiwan.net/poem48033.html","مجزوء الكامل"],[551,"من عذيري من سقام","https://www.aldiwan.net/poem48076.html","مجزوء الرمل"],[551,"شد غروض المطي مغتربا","https://www.aldiwan.net/poem48085.html","المنسرح"],[558,"كلامنا غير ما تعطى العبارات","https://www.aldiwan.net/poem34718.html","البسيط"],[558,"يا صاحب الجهل المركب","https://www.aldiwan.net/poem34920.html","مجزوء الكامل"],[562,"أسفا لمن قد مات قبل مماته","https://www.aldiwan.net/poem52864.html","الكامل"],[567,"خرجت أقبح المخارج منه","https://www.aldiwan.net/poem69532.html","الخفيف"],[575,"عمموها طينو آدم طين","https://www.aldiwan.net/poem2730.html","الخفيف"]],"verses":[["لَم يَدَع مِنكَ حادِثُ الدَهرِ إِلّا","عِبراً لِلعُيونِ وَاِستِعبارا",0,"ر",2,0],["لَم يَدرِ هَل ذاقَ بِها","جَمرَ غَضاً أَو بَرَدا",1,"د",2,0],["لمْ يَدْفَعِ الحَدَثانِ عَن حَوبائِهِ","مَجْدٌ أشَمُّ وعِزّةٌ قَعْساءُ",2,"ا",2,0],["لمْ يُدْعَ غِمدُ السّيْفِ جَفْناً باطِلاً","إلاّ لشِبْهِ اللّحْظِ يُغْمَدُ فِيهِ",3,"ه",1,0],["لمْ يدَعْ هجْرُكَ لي منْ رمَقٍ","آهٍ مما فعلَ البَيْنُ وآهُ",4,"ا",2,0],["لَمْ يَدْرِ إِسْمَاعيلُ مَا طَوَّقْتَهُ","مِنْ مِنَّةٍ لَوْ كَانَ مِمَّنْ يَعْقِلُ",5,"ل",1,0],["لَمْ يَدَعْ بَيْتَكَ الْمَنِيعَ حِمَاهُ","لِسِوَاهُ إِلاَّ إِلَى بَيْتِ رَبِّكْ",6,"ك",1,0],["لَم يَدَعوا بَعدَهُم عَريباً","فَغَنِيَت بَعدَهُم نِزارُ",7,"ر",1,0],["لَم يَدَع مِنكَ غَيرَ قُوَّةِ نَفسٍ","تَتَجَلّى في هَيكَلٍ مِن خَيالِ",8,"ل",1,0],["لَم يَدَع آسيكَ جُهداً إِنَّما","غابَ عِلمُ اللَهِ عَن عِلمِ الطَبيبِ",9,"ب",1,0],["لَم يَدرِ ما قَصمُ الظُهو","رِ وَلا اِنخِزالُ المَفصِلِ",10,"ل",1,0],["لَم يَدرِ حينَ دَنا لِيَبلُوَ قَلبَها","دَقّاتِ قَلبٍ أَم دَبيبَ نِمالِ",11,"ل",1,0],["لَم يَدرِ ناظِرُهُ أَعُرياناً يَرى","أَم كاسِياً في تِلكُمُ الأَسمالِ",11,"ل",1,0],["لَمْ يَدَعْ نَأَيُكَ الْوَشِيكُ سُرُوراً","بِبَقَاءٍ لأَلْمَعِيٍّ مُقِيمِ",12,"م",1,0],["لم يدر ما مخرومة وجريده","سبحان رازقه بغير حساب",13,"ب",1,0],["لم يَدْعهُمْ مُستنجدٌ","إلا ودعوتُه المُجابهْ",14,"ب",2,0],["لم يدَّكرها المحبُّ إلا","طار اشتياقاً بلا جناحِ",15,"ح",1,0],["لم يَدَعْ لي عزّ القَنوع ولا جا","د برفدٍ يَعُدُّهُ الناس رِفدا",16,"د",2,0],["لم يدع منه عذارا","ك هوى غير اختلاق",17,"ق",1,0],["لم يدعُ إذ فار صدرُه غضباً","إلا بما الحظُّ فيه إن قُسِما",18,"م",2,0],["لَم يَدرِ خَلفَ النَعشِ مِن حَرِّ الجَوى","أَيَشُقُّ جَيباً أَم يَشُقُّ وَتينا",19,"ن",2,0],["لَم يَدرِ إِلّا اللَهُ ما","خَبَّأَت لَكَ الدُنيا وَلي",20,"ل",2,0],["لَم يَدَع ظِلّاً لِقَصرِ المُنيَةِ","وَكَذا عُمرُ الأَمانِيِّ قَصير",21,"ر",1,0],["لَم يَدَّخِر إِلّا رِضاكَ وَلا اِقتَنى","إِلّا وَلاءَكَ أَنفَسَ الأَعلاقِ",22,"ق",1,0],["لَم يَدرِ قائِدُهُم لَمّا أَحَطَّت بِهِ","هَبَطتَ مِن صُعُدٍ أَم جِئتَ مِن صَبَبِ",23,"ب",1,0],["لَم يَدرِ مَن بِالرَيِّ أَنَّهُمُ","فَصَلوا وَلا يَدري إِذا قَفَلوا",24,"ل",3,0],["لَم يَدَع بَينَنا التَباعُدُ إِلّا","ذَكرَةً أَو زِيارَةً عَن جَنابَه",25,"ب",2,0],["لم يدع عندي هماً","ومحا عنك الشقاء",26,"ا",2,0],["لم يدْرِ ما أَلقى من الحبّ","لاحٍ خليّ العينِ والقلبِ",27,"ب",1,1],["لم يدرِ أنَّا دُفِنَّا تحتَ جاحِمها","مطالعٌ يتملاها بَراكينا",28,"ن",2,0],["لم يَدْرِ أنَّا على الحالين يُرمضنا","مِن بؤس خَلْقٍ سوانا يعنِّينا",28,"ن",2,0],["لم يَدْرِ أنَّ النفوسَ العامراتُ بُنًى","تبقى على نكَدِ الدُّنيا عناوينا",28,"ن",2,0],["لَم يَدرِ إِلّا يَومَ مَوتِكَ ما الأَسى","فَكَأَنَّ مَوتَكَ لِلأَسى ميلادُ",29,"د",1,0],["لَم يَدرِ قَيصَرُ إِذ تَحَوَّلَ مُلكُهُ","وَمَضى الكَبيرُ الفَخمُ مِن أَيّامِهِ",30,"م",2,0],["لَم يَدَع مِن سَلامِها غَيرَ ما أَب","قَت إِغاراتُ جُندِها مِن سَلامِكْ",31,"ك",1,0],["لم يَدْرِ مأْرَبهم إذ يسخرونَ بهِ","وإذ يُريدونَها دَهماءَ تُلتحَفُ",32,"ف",1,0],["لم يَدَعْهُ أبو بَصيرٍ وَرَامِي ال","موتِ يُلقي عليهِ سَهْماً فسهما",33,"م",2,0],["لَم يَدَع أَرضاً مِنَ المَحلِ إِلّا","جادَ أَو مَدَّ عَلَيها جَناحا",34,"ح",2,0],["لَمْ يَدْرِ أنّي كلَّما اسْتَعطَفْتُهُ","كانَ الحَديدَ وكنتُ مِغْناطِيسا",35,"س",2,0],["لمْ يَدْعُهُ ذُو فاقَةٍ وضَرُورَةٍ","إِلَّا ونالَ بِجُودِهِ المَأْمُولا",36,"ل",2,0],["لَم يَدعُهُم إِلَّا لِمَا يُحييهُمُ","أبداً كما يَدعُوا الطَّبِيبُ عَليلا",37,"ل",2,0],["لم يَدْرِ ما رَجْمُ الظّنونِ وإنّما","دُفِعَ القضاء إليْهِ وهو يقين",38,"ن",1,0],["لم يَدَّخرْ عنك المديحَ الجَزْلَ مَن","وَفّاكَ غايتَهُ من المجهود",39,"د",1,0],["لَم يَدرِ حَتّى رَمَوا مَطِيَّهُمُ","ثُمَّ اِستَمَرّوا بِجَنَّةِ الخُلُدِ",40,"د",1,0],["لَم يَدرِ ما قُلتُ مَسعودٌ فَضَيَّعَهُ","يا سَوأَتا مِن طِلابي جودَ مَسعودِ",41,"د",1,1],["لَم يَدعُ حَظّي يا لَسَعدٍ في الوَغى","بَل صاحَ في الأَيّامِ يا لَمُقاعِسِ",42,"س",1,0],["لم يَدْرِ هَلْ باتَ فِيهِ نَاعِماً جَذِلاً","أو باتَ في جَنّةِ الفِردوسِ سامِرُهُ",43,"ر",2,0],["لَم يَدرِ لما راءَها مصروعة","تَبدو بأَحسن منظر مزدان",44,"ن",1,0],["لَم يَدعُ مِسماحاً إِلى","إِنعاشِها إِلّا أَجاب",45,"ب",1,0],["لَمْ يَدْرِ مَنْ بَاتَ مَسْرُوراً بِلَذَّتِهِ","أَنِّي بِنَارِ الأَسَى مِنْ هَجْرِهِ صَالِي",46,"ي",1,0],["لَمْ يَدْرِ مَنْ كَحَلَ الْكَرَى أَجْفَانَهُ","مَاذَا يُكَابِدُ فِي الْهَوَى مَنْ يَسْهَرُ",47,"ر",1,0],["لَمْ يَدْعُهُ دَاعٍ لأمْرٍ وَاجِبٍ","إِلاَّ تَشَمَّرَ مُسْرِعاً وَأَجَابَا",48,"ب",2,0],["لَمْ يَدَّخِرْ وَسعاً لإِنْهَاضِهَا","وَحَيثُما أَلقَى عِثاراً أَقَالْ",49,"ل",1,0],["لَمْ يَدْعُ دَاعٍ لَمْ يَجِبْهُ","ذَلِكَ الْوَحْيُ المُلَبِّي",50,"ي",1,0],["لَم يَدَع فَقدُهُ لِمَغنايَ مَعنىً","فَخَلا آهِلاً وَضاقَ رَحيبا",51,"ب",2,0],["لَم يَدرِ ما تَحتَ التَجَمُّلِ حاسِدٌ","بِالغَيظِ يَقعُدُ مَرَّةً وَيَقومُ",52,"م",1,0],["لم يدْعُ «آل محمدٍ» لوليمةٍ","يومًا، ويبرىَ هامَهُمْ بنصالِهِ",53,"ل",2,0],["لم يدقَّ الفؤاد في الجو خَوفًا","أو سرورًا بقرب يوم الإياب",54,"ب",1,0],["لم يَدعْ حبُّهم مكانًا لحبٍّ","في فؤادي تحتلُّه حسناءُ",55,"ا",2,0],["لمْ يدعُهُمْ إلاَّ لما يحييهمُ","أبداً كما يَدْعُو الطَّبيبُ عَليلا",56,"ل",2,0],["لم يَدْرِ حتى الآنَ شِيمتَها","حسِبَ الهوى نَغَماً يُردِّده",57,"د",2,0],["لم يَدرِ مَن كَحَلَ الكَرى أجفانَهُ","ماذا يُكابدُ الهوى مَن يَسهَرُ",58,"ر",1,0],["لَم يَدَع لي تَجارُب الناس خلّاً","يُصطَفى لي أَو يُرتَجى لِمُصابي",59,"ي",1,0],["لَم يَدرِ ما بِي العاذِلون لِأَنَّني","أَشكو الأَخ الجافي لعذل أَخيهِ",60,"ي",2,0],["لَم يَدر لذة نَعماهُ الشَحيح كَما","لَم يَدرِ عود نَبات طَعم سُكره",61,"ه",1,0],["لم يدع بيننا الجفاء ولا البعد","سوى زورة على غير ود",62,"د",1,0],["لَم يَدرِ مَا فِيهِ مَاذَا","إِلاَّ كَبَغلٍ زَفُوفِ",63,"ف",1,0],["لم يدرِ حقَّ مقامِهِ من لا يرى","من دُونِ حقِّ مقامِهِ الإطنابا",64,"ب",2,0],["لم يدرِ حامِى سِربهِ أنِّى إذا","حُرمَ الكلامُ له لساني الإِصبعُ",65,"ع",1,0],["لَم يَدَع حاسِداً يَفوهُ بِإِخفا","قي وَقَد جِئتُ حاشِداً آمالي",66,"ل",2,0],["لَمْ يَدَعْ سُكْرُ الغَرامِ","فِيَّ حَظّاً لِلْمُدامِ",67,"م",1,1],["لم يدر قبرك ماحواه بل درا","بالأمر من أنهاره وعيونه",68,"ن",2,0],["لَم يَدَّخِر غَيرَ ما آباؤُهُ اِدَّخُروا","مِن أَنفُسٍ وَجَميع المالِ قَد وَهَبُوا",69,"ب",3,0],["لَم يَدع في الدينِ وَالدُنيا طريق","لهُدانا ما له فيها مقال",70,"ل",1,0],["لمْ يدعِ فيَّ الغرامُ دماً","وأرى في الكاسِ مثل دمي",71,"ي",1,0],["لم يدرِ إسراري ولا إعلاني","إلا الذي بحبِّه ابتلاني",72,"ن",2,0],["لم يدنني الشوق يوماً من منازلهم","إلا تولّوا مع الأيام إقصائي",73,"ي",1,0],["لم يدم كوكب النحوس بها","لا ولا دام طالع السعد",74,"د",1,0],["لَم يَدرِ طَعمَ العَيشِ شُب","بانٌ ولم يُدرِكه شيبُ",75,"ب",1,1],["لم يَدرِ أنّ ملامَه أَغراكا","إذ لجَّ في بُهتانه وَنَهاكا",76,"ك",2,1],["لَم يَدعُ نَصرَكَ في مَقامِ كَريهَةٍ","إِلّا وَقُمتَ مُلَبِياً لِدُعائِهِ",77,"ا",3,0],["لَم يَدفَعِ الحَدَثانَ ما","جَمَعوهُ مِن وَرَقٍ وَعَينِ",78,"ن",1,0],["لَم يَدُر في خَلَدي قَط","طُ وَلا جالَ بِفِكري",79,"ر",2,0],["لَم يدرعني ذو المَحاسن أَنَّني","اودعته روحي ورحت متيما",80,"م",2,0],["لَم يَدْنُ مِن بابِهِ مُسْتَشْعِرٌ وَجَلاً","إلا دنا مِن أمانِ اللّهِ وَاقْتربا",81,"ب",2,0],["لَمْ يُدْرِكِ الشَّيْبُ إِلاّ فَضْلَ صَبْوَتِه","كَما يُغادِرُ فَضْلَ الْكَأْسِ مَنْ شَرِبا",82,"ب",2,0],["لم يدرِ ما كتبت ير","أعته مشوقا ذو ارتياع",83,"ع",1,0],["لَم يَدنُ مِن نارِي الخُمو","دُ وَلا مِنَ الدَّمعِ الجُمودُ",84,"د",1,0],["لم يدر عن بلواك","فاصبر على الأقدار",85,"ا",2,0],["لم يدع صافياً من العيش إلا","كدّرَ الصفو فيه بعد ليانه",86,"ن",2,0],["لم يدر ما شأن الهوى","بين الموالي والعبيد",87,"د",1,0],["لم يدر ما يصنع","من شدة الحيرة",88,"ه",1,0],["لم يدعهم بخلهم أن ينفقوا","في سبيل اللَه معطى الخلفا",89,"ف",2,0],["لَم يُدرَ هل في أوّلٍ أم آخر","مختارهُ فَتشابه الطرفانِ",90,"ن",1,0],["لَم يَدَّخِر قَط ديناراً إِلى عَوزِ","وَلَم يُضنِ بِإِسعافٍ لَدى سُؤلِ",91,"ل",1,0],["لَم يُدخِلِ الشورى عَلى رَأيِهِ","وَالحَزمُ لا يُمضيهِ رَأيانِ",92,"ن",1,0],["لم يدع لي الهيام شيئا من الع","قل فقبّلت جامحا شفتيك",93,"ك",1,0],["لم يدع في جوانحي نبع حزن","لم تفجّره بالبكاء شجيّا",94,"ي",2,0],["لَم يَدرِ ما مَعنى المُسَمّي وَاِسمُهُ","لَكِنَّهُ بِحَديثِهِ يَتَشَبَّثُ",95,"ث",1,0],["لم يُدْرَ أَيُّهما أَوفَى بها تَعَباً","فُؤادُ حاسدِها أَم كَفُّ مُحْصِيها",96,"ي",3,0],["لم يَدْرِ ناعيكَ مَنْ إليَّ نَعَى","ولا مُواليكَ ما الّذي سَمِعا",97,"ع",2,1],["لم يدعْ في فؤادِيَ الدَّهرُ سُؤْراً","لهوى أغَيدٍ ولا غَيدْاء",98,"ا",2,0],["لَم يَدرِ ما لاقَى فلو وَصَفوا له","ماذا يُلاقي ماتَ عِند صِفاتِهِ",99,"ت",2,0],["لم يَدَعها الجُودُ تَملِكُه","والنَّدى وَقتاً من الزَّمَنِ",100,"ن",1,0],["لَم يَدرِ مَن قَد كانَ عا","صَرها وَلا باني أَرَم",101,"م",1,0],["لَم يَدرِ لي السُلوّ يَوماً بِبال","وَبِذاك العُيون مِنكَ ضَميني",102,"ي",1,0],["لم يُدْرَ حينَ تكِرُّ في آثارهم","أهي السّهامُ أمِ الجيادُ الضمَّرُ",103,"ر",1,0],["لم يدر جهلاً أن باطنها","أن الشريعة ما لها أصل",104,"ل",1,0],["لم يدرِ ما القصدُ في جُودٍ ويُعجبُهُ","في بَذْلِ أموالِه الإِفراطُ والسَّرَفُ",105,"ف",1,0],["لم يَدَّخِرْ في النَّدى مالاً ولا نشباً","إنَّ المكارم لا تُبقي له نشبا",106,"ب",2,0],["لم يدر ما مرض الفؤاد وما الَّذي","أخْفَيْتُه عنه من الآلام",107,"م",1,0],["لم يدمْ عيشٌ لنا في ظلِّكم","أيّ عيش قبله كانَ فداما",108,"م",2,0],["لم يدر واللمسِ الممنع طبّه","أن الدواء بمقتضى الأدواء",109,"ا",2,0],["لم يدعْ منه موقفُ البينِ إلا","كبِداً يستكنّ فيها الهُمومُ",110,"م",1,0],["لم يدر أن الموت يح","دوه حدا رعب السحاب",111,"ب",1,0],["لم يدعْ حُسنْهُ فؤاداً خليّاً","من هواه إِلاّ وأضرمَ ناره",112,"ر",2,0],["لم يدره من أولعوا ببهارج","للصيف يمرح كالمليك العاتي",113,"ي",1,0],["لم يدع شيئا بلا إتقانه","أو جمالا لم ينله شغفه",114,"ف",2,0],["لم يَدَع الكمالُ فيك خَلّةً","يقال فيها ليت ذا النقصانَ تمّْ",115,"م",1,0],["لم يدرِ من أين أصيبَ قلبُه","وإنما الرامي درَى كيف رمَى",116,"م",2,0],["لم يدرِ من أين أتى سؤددُه","فهو غريبُ الوجه فيه محتشِمْ",117,"م",1,0],["لم يدر لحظُ ضابطٍ","ما رجلُها وما اليدُ",118,"د",1,0],["لم يدرِ جهدُ الغائصين وكيدُهم","من أيّ أصداف البحار استُخرِجتْ",119,"ت",1,0],["لم يُدرِّجْهُ إِلى منصبهِ","كَسِواهُ عَمَلٌ بعد عَمَلْ",120,"ل",1,1],["لم يدم خديه سوى قتلي ولا","أدمى خدود الورد إلا الخجل",121,"ل",1,0],["لم يدجُ ليلُ النّقع إلاّ أطلعوا","زهرَ النّجوم على الوشيج الذّابل",122,"ل",1,0],["لم يدرِ ما لوعة الفراق ولا","قبيح وجه الغرام من حسنه",123,"ن",2,0],["لم يدر ذو القلب الخليّ بأنني","أمسيتُ ذا كلفٍ به مشغولا",124,"ل",2,0],["لم يدرِ عن أيَّ أرضٍ لاحَ مومِضُها","تحتَ الدُّجُنَّةِ لمّا لاحَ يا حارِ",125,"ر",1,0],["لم يدعُني منه حُسْنٌ مِن محاسنهِ","اِلاّ وباردَةٌ وجَدي يُلَبيِّهِ",126,"ي",2,0],["لم يدر منطقك البذاء ولا درى","فمك الرحيق ولا اصطحبت نديما",127,"م",2,0],["لم يدْرِ يفرحُ في فتحِ الحُسينِ له","إذ حازَهُ أم يعزّى في أعزَّتِهِ",128,"ت",2,0],["لم يدر من سكرة إعجابه","أساحر الألفاظ أم شاعر",129,"ر",1,0],["لم يدر أنّ مشيبَ الرّأس من فكري","لَم يَسْرِ رَكْبُ مشيبٍ في نواحيها",130,"ي",3,0],["لم يدعِ الإسآدُ هاماتِها","إلّا سَقيطاتٍ على المَنْسِمِ",131,"م",1,0],["لم يدنُ منهنّ النُّزول ولم يَغِبْ","عنهنّ إِسراجٌ ولا إِلجامُ",132,"م",1,0],["لم يدفنوك به لكنّهمْ هَرَقوا","وما دَرَوْا سَجْلَ إحسانٍ وإجمالِ",133,"ل",1,0],["لَم يُدرِكوا بَعدِي الطِلابَ ولا","سدّوا بمثْلِي الخَرْقَ إنّ سدّوا",134,"د",3,0],["لم يُدعَ تفضيلاً له","من بينهمْ حتّى دُعِيتا",135,"ت",2,0],["لَم يَدعْ في القَلب منّي","لِلمَسرّاتِ نَصيبا",136,"ب",2,0],["لَم يَدرِ وَالجهلُ من سجيّتِهِ","أَنَّكَ أَحرزتَ قبله القَصَبا",137,"ب",2,0],["لم يدره ذو انتقاد في تعنته","لنفسه زعم علم واجتهادات",138,"ت",1,0],["لم يدرني ويظنني","أنا مثله وعلى هكَّبْ",139,"ب",1,0],["لم يَدْرِ طَعْمَ العَيشِ مُنتبِهاً لهُ","كالحَيِّ حَتَّى ذاقَ طَعْمَ وَفاتِهِ",140,"ت",2,0],["لَمْ يَدَعْهَا تَطُولُ حَتَّى عَلاَهَا","وَضَحُ الشَّيْبِ فِي الزَّمَانِ الطَّوِيْلِ",141,"ل",1,0],["لم يَدع شُرْبَها الأَمينُ وإِن كا","نَ إِمَام الهُدَى ولا المأْمُونُ",142,"ن",1,0]]}