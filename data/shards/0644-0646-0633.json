{"poems":[[53,"ومدامة كحشاشة النفس","https://www.aldiwan.net/poem64569.html","أحذ الكامل"],[93,"كم خفضنا الجناح للجاهلينا","https://www.aldiwan.net/poem62791.html","عموديه"],[76,"حدر القناع عن الصباح المسفر","https://www.aldiwan.net/poem12956.html","الكامل"],[50,"أنعت ديكا من ديوك الهند","https://www.aldiwan.net/poem63251.html","الرجز"],[52,"قل لفرخ الزنجي لا تشك ليثا","https://www.aldiwan.net/poem64736.html","الخفيف"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[333,"سألقاك حين تنام النجوم","https://www.aldiwan.net/poem54999.html","المتقارب"],[382,"يا قلب طِر من وكنة الأحشاء","https://www.aldiwan.net/poem66956.html","الكامل"],[435,"هناء لديكم والهناء بكم لنا","https://www.aldiwan.net/poem40500.html","الطويل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138175",""],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128712","المديد"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130045","الكامل"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26114","الوافر"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82830","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89007","الوافر"],[3836,"","https://poetry.dctabudhabi.ae/diwan/poem/99260","المديد"],[4516,"","https://poetry.dctabudhabi.ae/diwan/poem/66857","الهزج"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72426","الرجز"],[4968,"صديقي","https://www.poetsgate.com/ViewPoem.aspx?id=206951",""],[5135,"هلال السعد","https://www.poetsgate.com/ViewPoem.aspx?id=204492",""],[5277,"قسمةٌ ضيزى","https://www.poetsgate.com/ViewPoem.aspx?id=186525",""],[5410,"أمل","https://www.poetsgate.com/ViewPoem.aspx?id=142234",""],[5431,"قد خُلقنا ملائكا في الطراز","https://www.poetsgate.com/ViewPoem.aspx?id=200154",""],[5791,"نصٌّ مقلوب ..!","https://www.poetsgate.com/ViewPoem.aspx?id=213016",""],[6043,"مرثيّة الأرض العالقة","https://www.poetsgate.com/ViewPoem.aspx?id=215591",""],[6056,"كبش الفداء","https://www.poetsgate.com/ViewPoem.aspx?id=156713",""],[6070,"رَأَيتُ الدُّموعَ بوجهِ القَمَرْ","https://www.poetsgate.com/ViewPoem.aspx?id=188865",""]],"verses":[["لنسيمها في قلبِ شاربها","رَوْح الرجاءِ وراحة اليأس",0,"س",1,0],["لَنَسَيتُم شُهورَكُم وَالسِنينا","لَو دَخَلتُم هَياكِلَ الإِلهامِ",1,"م",1,0],["لَنَسَختُ أَسطارَ الكِتابِ كَتائِباً","مُصطَفَّةً وَطَرَقتُهُ في عَسكَرِ",2,"ر",1,0],["لِنِسبَةٍ لَيسَت إِلى مَعَدٍّ","وَلا قُضاعِيٍّ وَلا في الأَزدِ",3,"د",1,0],["لِنِساءِ الزِنجِيِّ فيمَن يُصَلّي","صَدَقاتٌ فَضَحنَ بِنتاً وَأُختا",4,"ت",2,0],["لِنَسيمِها أَرجٌ يَفوقُ لَطيمَة","مِن مِسكِ داريٍّ بِخَيرِ بَنانِ",5,"ن",1,0],["لنَسرِقَ من عمرِنا ساعةً","نعيش الحياة على ذكرها",6,"ر",3,0],["لنُسَبِّحَنَّ نقاك يا خبزَ الهنا","قوتَ الجياعِ وقوةَ الضعفاء",7,"ا",2,0],["لنسبتك الغرا شهاب محامدٍ","بدا في سماءِ الفخر مرتفع السنا",8,"ن",2,0],["لنسيتُ عهدكِ فانطوت صفحاته","ولفتَّ هذا اليأس في أعضادي",9,"ي",1,0],["لنسيبي بالحمى نسبٌ","لكم ترعى به ذممي",10,"م",2,0],["لنسودَ ما شِئنا وشاء لنا الزمن","ونُعيد في العلياءِ مجدَ الأوّلين",11,"ن",1,0],["لِنسَوَتِكَ اللِئامِ الوَيلُ مِمّا","أَفَدتَ لَهُنَّ أَو ما تَستَفيدُ",12,"د",1,0],["لنسا بِعُبّاد أَشخاصٍ نُقَدِّسُهُم","لَسنا نُقَدِّسُ إِلّا مَبدَأَ الرَجُلِ",13,"ل",1,0],["لنسل المصطفى الدنيا فداءٌ","وإن قلت فداء في الهبات",14,"ت",1,0],["لِنُسائلْ مِعْصَمَيْنا فإِنَّا","ما نطقنا مذ عرفنا الفراقا",15,"ق",2,0],["لنستفتيه هل صحت","بهذا الشكل تقوانا",16,"ن",2,0],["لنسخها عطارد المجد برى","بحد شفرة الهلال القلما",17,"م",2,0],["لنسرعْ إذن في دروب العلا","فأعمارنا تنتهي بالعدمْ",18,"م",1,0],["لِنَسْعدَ باللقا ونَقَرَّ عَيْناً","بَأَنْ بَلَّغْتَنَا رَبِّي مُنَانَا",19,"ن",2,0],["لنسكبَ فيضَ الروحِ فيمنْ نُحبُّهُ","ونشركَ بوحَ الشعرِ فيمنْ نُكاتمُهْ",20,"م",2,0],["لنستزيد على الآمال بيدرنا","نثري خطانا إلى أمجادنا المثل",21,"ل",1,0],["لنسور تسابق النور دربا","في سموّ مشرّفٍ بامتياز",22,"ز",1,0],["لنستجيرَ بنا .. منّا .. على وجعٍ","غيلانهُ ملأتْ أضلاعَنا .. نهشا",23,"ش",2,0],["لنسماتِ الربيعِ وللأغاني","إذا طفنا بها مُتراقصينا",24,"ن",2,0],["لنسيانه ، معاندني ..! خفوق ٍ ما يطيع الشور","يحبه ، رغم مايفعل , ولأجله دوم ، يشتاقي",25,"ق",2,0],["لِنَسقيَ طفلاً ونسقيَ حباً","فتحيا الحياةُ بطيبِ الثمرْ",26,"ر",1,0]]}