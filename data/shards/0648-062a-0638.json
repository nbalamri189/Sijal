{"poems":[[53,"بني عامر ما العز إلا لقادر","https://www.aldiwan.net/poem29773.html","الطويل"],[53,"إلى كم لا تلين على العتاب","https://www.aldiwan.net/poem30701.html","الوافر"],[53,"أي العيون تجانب الأقذاء","https://www.aldiwan.net/poem30780.html","الكامل"],[63,"ويوم طوينا أبرديه بروضة","https://www.aldiwan.net/poem45917.html","الطويل"],[63,"ومتيم زهرت بواقصة له","https://www.aldiwan.net/poem46148.html","الكامل"],[3,"وتظل عبلة في الخدور تجره","https://www.aldiwan.net/poem200.html",""],[93,"إهنأ بما أهدى المليك","https://www.aldiwan.net/poem9675.html","عموديه"],[93,"هي زهرة بسمت بها","https://www.aldiwan.net/poem11469.html","مجزوء الكامل"],[83,"أتعطش أولادي وأنت غمامة","https://www.aldiwan.net/poem54228.html","الطويل"],[27,"ألم يك لا أبا لك شتم تيم","https://www.aldiwan.net/poem6008.html","الوافر"],[72,"أخفي الأسى ولسان دمعي يعلن","https://www.aldiwan.net/poem20150.html","الكامل"],[51,"نشر آذار في الثرى حللا","https://www.aldiwan.net/poem8118.html","الخفيف"],[51,"أمامك فانظر أي نهجيك تنهج","https://www.aldiwan.net/poem9253.html","الطويل"],[51,"لشنطف كعثب خلق","https://www.aldiwan.net/poem65727.html","مجزوء الوافر"],[29,"صرمت أمامة حبلها ورعوم","https://www.aldiwan.net/poem6063.html","الكامل"],[91,"هم ألم به مع الظلماء","https://www.aldiwan.net/poem8725.html","عموديه"],[91,"لا تقلقي يوم النوى أو فاقلقي","https://www.aldiwan.net/poem8985.html","عموديه"],[92,"قضيت أدوار الحياة مفكرا","https://www.aldiwan.net/poem38916.html","الكامل"],[92,"يا أيها الطفل الذي قد","https://www.aldiwan.net/poem38926.html","مجزوء الكامل"],[92,"أيها الشعب ليتني كنت حطابا","https://www.aldiwan.net/poem38934.html","الخفيف"],[92,"عش بالشعور وللشعور فإنما","https://www.aldiwan.net/poem38938.html","البسيط"],[89,"الأغاني تصبي ولست بدار","https://www.aldiwan.net/poem44756.html","الكامل"],[85,"به هجر يتيمه","https://www.aldiwan.net/poem7140.html","مجزوء الوافر"],[85,"من أي عهد في القرى تتدفق","https://www.aldiwan.net/poem63707.html","الكامل"],[43,"في الخد أن عزم الخليط رحيلا","https://www.aldiwan.net/poem10125.html","الكامل"],[45,"أبا حسن أنت وشك الأجل","https://www.aldiwan.net/poem65566.html","البسيط"],[45,"أهلا بذالكم الخيال المقبل","https://www.aldiwan.net/poem65577.html","الكامل"],[28,"إن التي نظرت إليك بفادر","https://www.aldiwan.net/poem5215.html","الكامل"],[102,"يا حلوة العينين يا قاسيه","https://www.aldiwan.net/poem32927.html","السريع"],[52,"أنزلت من ليل كظل حصاة","https://www.aldiwan.net/poem27192.html","الكامل"],[75,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[75,"فتقت لكم ريح الجلاد بعنبر","https://www.aldiwan.net/poem69080.html","الكامل"],[50,"ألا طرقت موهنا مهدد","https://www.aldiwan.net/poem63884.html","الوافر"],[50,"يا عبد باهلة الذي يتوعد","https://www.aldiwan.net/poem63931.html","الكامل"],[46,"قد أصبحت ونعاتها نعاتها","https://www.aldiwan.net/poem22158.html","الكامل"],[46,"لا شام للسلطان إلا أن يرى","https://www.aldiwan.net/poem22488.html","الرجز"],[46,"أريد من الدنيا خمود شرورها","https://www.aldiwan.net/poem22612.html","الطويل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140869",""],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9970","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55197","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55189","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55113","الكامل"],[90,"الشهيد قيس","https://www.poetsgate.com/ViewPoem.aspx?id=179228",""],[91,"ضرة جلق","https://www.poetsgate.com/ViewPoem.aspx?id=53143",""],[92,"عِشْ بالشُّعورِ، وللشُّعورِ، فإنَّما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14582&r=&rc=27",""],[122,"إن الزمان ولا أقول زماني","https://www.aldiwan.net/poem23705.html","الكامل"],[130,"قال ابن عبدم مجيب السائل","https://www.aldiwan.net/poem54349.html","الرجز"],[133,"أعيذك من شر الحوادث يا مصر","https://www.aldiwan.net/poem49038.html","الطويل"],[153,"إذا نظرت نحونا جردت","https://www.aldiwan.net/poem55526.html","المتقارب"],[153,"يدافع زهو التيه أعطاف دلها","https://www.aldiwan.net/poem55694.html","الطويل"],[153,"بدر تقنع بالظلام","https://www.aldiwan.net/poem55793.html","مجزوء الكامل"],[210,"لقد هجرتني أم سعد وحبها","https://www.aldiwan.net/poem37826.html","الطويل"],[210,"أجيران وادي الأثل هل منكم وصل","https://www.aldiwan.net/poem37843.html","الطويل"],[219,"جلسنا عشاء بقرب النهر","https://www.aldiwan.net/poem55259.html","المتقارب"],[235,"صلاة السميع العليم","https://www.aldiwan.net/poem19788.html","المتقارب"],[257,"الحمد للمذكور وهو الذاكر","https://www.aldiwan.net/poem35951.html","الرجز"],[269,"ألف التذكر مبدئا ومعيدا","https://www.aldiwan.net/poem52063.html","الكامل"],[311,"إذا ما كنت ملتمسا لرزق","https://www.aldiwan.net/poem59506.html","الوافر"],[347,"سررت موهنا نحوي فأبدت مسرتي","https://www.aldiwan.net/poem15550.html","الطويل"],[359,"عج بالعقيق وقف بذات الاجرع","https://www.aldiwan.net/poem68093.html","الكامل"],[362,"بكل يمين للورى وشمال","https://www.aldiwan.net/poem60804.html","الكامل"],[369,"أتسكن بعد فراق السكن","https://www.aldiwan.net/poem57056.html","المتقارب"],[369,"جعلت على الطرف السهور","https://www.aldiwan.net/poem57441.html","مجزوء الكامل"],[369,"منتك نفسك أن تطيل فتقصر","https://www.aldiwan.net/poem57462.html","الكامل"],[369,"أرأيت إن أخذ الغرام على يدي","https://www.aldiwan.net/poem57502.html","الكامل"],[374,"إن الذي تخشاه أول وهلة","https://www.aldiwan.net/poem59110.html","الكامل"],[374,"لو كان للأفلاك نطق أو فم","https://www.aldiwan.net/poem59270.html","الكامل"],[374,"هبطت إليك من المحل الأرفع","https://www.aldiwan.net/poem59343.html","الكامل"],[397,"لله در بلادنا","https://www.aldiwan.net/poem6709.html","عموديه"],[397,"أغلى الهدايا","https://www.aldiwan.net/poem6722.html","عموديه"],[399,"لو كان يعلم أنها الأحداق","https://www.aldiwan.net/poem46984.html","الكامل"],[400,"زارت فكان لها الفؤاد مقيلا","https://www.aldiwan.net/poem33489.html","الكامل"],[402,"أرى منك طول الدهر إقبال قابل","https://www.aldiwan.net/poem49779.html","الطويل"],[407,"ذهب الفرزدق بالفخار وإنما","https://www.aldiwan.net/poem67499.html","الكامل"],[413,"من معيد لي من عهد الألى","https://www.aldiwan.net/poem53974.html","الرمل"],[413,"أحبتنا أنتم على السخط والرضا","https://www.aldiwan.net/poem53975.html","الطويل"],[429,"شخص معاوي المعي","https://www.aldiwan.net/poem12588.html","مجزوء الكامل"],[434,"لك يا محمد نائل","https://www.aldiwan.net/poem2594.html","مجزوء الكامل"],[438,"يا من له وسط الفؤاد","https://www.aldiwan.net/poem14306.html","مجزوء الكامل"],[438,"هذا المحصب يا قلوصي من منى","https://www.aldiwan.net/poem14320.html","الكامل"],[441,"في إثر سعيد يا أسعد","https://www.aldiwan.net/poem55931.html","عموديه"],[451,"هذي وصيتك النفيسة لم تزل","https://www.aldiwan.net/poem61640.html","الكامل"],[451,"هل كان قانون ابن سينا","https://www.aldiwan.net/poem61763.html","مجزوء الكامل"],[456,"ألا يا خليلي المجتبى من خزيمة","https://www.aldiwan.net/poem56184.html","الطويل"],[462,"نعم نفحة الوادي التي تتأرج","https://www.aldiwan.net/poem3143.html","عموديه"],[462,"نعم هذه آثارهم والمنازل","https://www.aldiwan.net/poem3164.html","عموديه"],[462,"عاثت فكل دم ومال ضائع","https://www.aldiwan.net/poem3372.html","عموديه"],[462,"يا مخجل القمر المنير","https://www.aldiwan.net/poem3502.html","عموديه"],[462,"حكمت بلوعتك الظباء الغيد","https://www.aldiwan.net/poem3597.html","عموديه"],[498,"جرى دمعي السياح من جفني البالي","https://www.aldiwan.net/poem37821.html","الطويل"],[498,"ما للقلوب عن الحبيب غطاء","https://www.aldiwan.net/poem38105.html","الكامل"],[513,"يا خير من نظم المديح لمجده","https://www.aldiwan.net/poem12063.html","الكامل"],[536,"رعى الله أيام الصبا واللياليا","https://www.aldiwan.net/poem47491.html","عموديه"],[536,"إني بعثت لسيدي بكتابي","https://www.aldiwan.net/poem48294.html","عموديه"],[549,"جزعت أمامة من مشيب","https://www.aldiwan.net/poem47222.html","مجزوء الكامل"],[549,"لقد ضل من يسترق الهوى","https://www.aldiwan.net/poem48120.html","المتقارب"],[565,"إلى الله أشكو أخا جافيا","https://www.aldiwan.net/poem69600.html","المتقارب"],[567,"تلفى عروبتهن وهي ضعيفة","https://www.aldiwan.net/poem52027.html","البسيط"],[573,"راحت وحق الله روحي","https://www.aldiwan.net/poem3090.html","مجزوء الكامل"],[574,"ألك السدير وبارق","https://www.aldiwan.net/poem1782.html","مجزوء الكامل"]],"verses":[["وَتَظمى عَلى الإِغذاذِ أَشداقُ خَيلِهِ","وَتَشرَبُ مِن أَفواهِهِنَّ الشَكائِمُ",0,"م",1,0],["وَتُظهِرُ أُسرَةً مِن سِرِّ قَومي","تَمُدُّ إِلى اِنتِظاري بِالرَقابِ",1,"ب",1,0],["وَتَظُنُّ كُلَّ غَمامَةٍ وَقَفَت بِهِ","تَبكي عَلَيهِ تَوَدُّداً وَوَلاءَ",2,"ا",2,0],["وَتُظْهِرُهُ طَوْراً وطَوْراً تُجِنُّهُ","فَتَحْسِبُه سَيْفاً يُسَلُّ وَيُغْمدُ",3,"د",1,0],["وتُظِلُّ منهُ السّمْهَريّةُ ضَيْغَماً","قَلِقَ الصّوارِمِ مُطمَئِنَّ الجاشِ",4,"ش",1,0],["وَتَظَلُّ عَبلَةُ في الخُدورِ تَجُرُّه","وَأَظَلُّ في حَلَقِ الحَديدِ المُبهَمِ",5,"م",1,1],["وَتَظَلُّ فِيهَا مُلْتَقَى","الآمَالِ إِنْ خَطْبٌ حَزَبْ",6,"ب",1,0],["وَتَظَلُّ عَاطِفَةً عَلَيْهِمْ","فِي اليَسِيرِ وَفِي الجَلِيلْ",7,"ل",1,0],["وتُظلم أوقاتي ووجهك نيّرٌ","تفيض به الأنوار للدين والدنيا",8,"ي",2,0],["وَتُظعَنُ عَن مَقامِكَ يا اِبنَ تَيمٍ","وَما أَظعَنتَ مِن أَحَدٍ مُقيمِ",9,"م",1,0],["وتظل تعدي الغانيات مدامعي","فمدامعي كعهودها تتلوَّن",10,"ن",1,0],["وتظهرُ الشمسُ في النَّشاص لنا","من خَلَلِ الغيم إذ تَغَشَّاها",11,"ا",3,0],["وتظعن خوفَ السَّبي بعد إقامة","ظَعائنُ لم يُضرب عليهنَّ هودجُ",12,"ج",1,0],["وتظهر عفة وتمي","ل نحو فتى شبق",13,"ق",1,0],["وَتَظَلُّ تَنصُفُنا بِها قَرَوِيَّةٌ","إِبريقُها بِرِقاعِها مَلثومُ",14,"م",1,0],["وَتَظَلُّ تَرفُلُ بِالحَريرِ أَمامَهُ","في حينِ قَد أَمسى بِغَيرِ كِساءِ",15,"ا",2,0],["وَتَظَلُّ صورَتُها تَلوحُ لِخاطِري","بَعضُ الرُأى سَلوى وَإِن تَصدُقِ",16,"ق",1,0],["وتِظِلُّ سَائِرةً كأنَّ فقيدها","مَا كانَ يوماً صاحباً وحميما",17,"م",2,0],["وتُظِلُّهُ سُحُبُ الظَّلامِ","فلا سكونَ ولا إياةْ",18,"ه",1,0],["وتَظَلُّ ترقُصُ للأَسى","للَّهْوِ أَشباحُ الدُّهُورْ",18,"ر",1,0],["وتَظَلُّ تُورِقُ ثمَّ تُزْهِرُ","ثمَّ يَنْشُرُها الصَّباحْ",18,"ح",1,0],["وتظلُّ تخفقُ ثمَّ تشدُو","ثمَّ يطويها التُّرابْ",18,"ب",1,0],["وتظلُّ تمشي في جِوارِ","الموتِ أَفراحُ الحَيَاةْ",18,"ه",1,0],["وتظَلُّ الطُّيورُ تلغو على قَبْرِيَ","ويشدو النَّسيمُ فوقي بهمسِ",19,"س",1,0],["وتظلُّ الفُصولُ تمشي حوالَيَّ","كما كُنَّ في غَضَارَةِ أَمسي",19,"ي",1,0],["وتَظَلُّ جامِدَةَ الجمالِ كئيبةً","كالهيكلِ المتهدِّم المهجورِ",20,"ر",1,0],["وتَظَلُّ قاسيَةَ الملامِحِ جهْمةً","كالموتِ مُقْفِرَةً بغيرِ سُرورِ",20,"ر",1,0],["وتظل الابصار شاخصة والسمع","في لهفة الى التكرار",21,"ر",1,0],["وتظلمه فلا يشكو","إلى من ليس يظلمه",22,"م",2,0],["وَتَظَلُّ بَينَ قُوى الحَياةِ جَوائِلاً","لا تَستَقِرُّ دَوائِلاً لا تُمحَقُ",23,"ق",1,0],["وَتَظُنُّهُ مِمّا يُزَمجِرُ نَفسُهُ","عَنها لِشِدَّةِ غَيظِهِ مَشغولا",24,"ل",2,0],["وَتُظهِرُ في آلِ وَهبٍ هَوىً","وَأَنتَ نَحَستَهُمُ يا زُحَل",25,"ل",1,0],["وَتَظُنُّ رَيعانَ الشَبابِ يَروعُهُ","مِن جَنَّةٍ أَو نَشوَةٍ أَو أَفكَلِ",26,"ل",1,0],["وَتَظَلُّ تَحسِبَ ظِلِّها شَيطانَةً","وَتَخالُ نافِرَةً وَإِن لَم تَنفِرِ",27,"ر",1,0],["وتظفئ النار التي حُرّ كتْ","فارجعتها زفرة حاميه",28,"ي",2,0],["وَتَظَلُّ غِربانُ الفَلا فيما اِدَّعَت","يَأكُلنَ لَحمَ الأَرضِ مُبتَدِراتِ",29,"ت",1,0],["وتَظُنُّ في لَهَواتِنا أسيافَنَا","وتَخالُ في تاجِ المعزِّ رسولا",30,"ل",2,0],["وتَظُنُّهُ مُتَخَمِّطاً من كِبْرِهِ","وتَخَالُهُ متنمِّراً لِيَصُولا",30,"ل",2,0],["وتظَلُّ تسبَحُ في الدماء قِبابُهُمْ","فكأنّهُنَّ سفائنٌ في أبحر",31,"ر",1,0],["وَتُظهِرُ حُبَّ نَبِيِّ الهُدى","وَأَنتَ بِهِ كافِرٌ تَشهَدُ",32,"د",1,0],["وَتَظَلُّ تُرعَدُ مِن هَديلِ حَمامَةٍ","وَإِذا دُعيتَ لِسَوأَةٍ لا تُرعَدُ",33,"د",1,0],["وَتَظَلُّ حَبّاتُ القُلوبِ زَرائِعاً","كَالأَرضِ وَالصَهَواتُ مُزدَرَعاتُها",34,"ت",3,0],["وَتَظَلُّ أَبياتٌ لَهُم شَعَريّةٌ","كَبُيوتِ شِعرٍ في البِلادِ شَوارِدِ",35,"د",1,0],["وَتُظهِرُ لي مَقتاً وَأَضمُرُ حُبَّها","كَأَنّي جَهولٌ ما عَرَفتُ شَنارَها",36,"ر",3,0],["وتظنه مما يزمجر نفسه","عنها بشدة غيظة مشغولا",37,"ل",2,0],["وَتَظَلُّ عَبلَةُ في الخُدورِ تَجُرُّها","وَأَظَلُّ في حَلَقِ الحَديدِ المُبهَمِ",38,"م",1,1],["وتَظلُّ عَنْ مَجْرَى الحَياةِ بِمَعْزِلٍ","وَتُنَافِسُ العُمْرَانَ بِالأَطْلاَلِ",39,"ل",1,0],["وَتَظَلَّ تؤْنِسُهَا النَّجُومُ بِنَبْاةٍ","مهْمَا تُطِلْ فَاللَّيْلُ غَيْرُ طَويلِ",40,"ل",1,0],["وتَظَلُّ مُتَّقِياً هَوَا","كَ مُشَاوِراً فِيهِ رَشَادك",41,"ك",1,0],["وتظَلُّ تسألُ مَخْدَعاً","لك عن هجوعِك والهُبوب",42,"ب",1,0],["وتظلّ صورتها تلوح لخاطري","بعض الرؤى سلوى وإن لم تصدق",43,"ق",1,0],["وَتَظَلُّ قاسية َ الملامحِ، جهْمة ً","كالموتِ..، مُقْفِرة ً، بغير يرورِ",44,"ر",1,0],["وتظاهر المتصدرين لبيعهم","لا عن تقى بحماية الأديان",45,"ن",1,0],["وتظهر العَوَّا ليل خمسِ","منه وعشرين بغير لبسِ",46,"س",1,0],["وتظهر للأيام منهم براعة","يكون بها بين البلاد لك الفخرُ",47,"ر",1,0],["وَتُظْهِرُ لِلْحُسْنِ إِنْ أَسْفَرَتْ","هِلالَ المُنى في سَحابِ الظُّنُونِ",48,"ن",1,0],["وَتُظْهِرُ لي من تَحْتِ أَزْرارِ جَيْبِها","إِذا ما بَدَتْ من كُلِّ ناحِيةٍ بَدْرَا",49,"ر",2,0],["وتظلَّمت وجناتُنا","بيد الدُّموع من النَّحيبِ",50,"ب",1,0],["وتُظْهِر لي نُصْحاً ونُصْحُكَ قاتلي","ونَفْسي صُدُوْدُ الباكرينَ شَجَاها",51,"ا",3,0],["وَتُظهِرُ حكمَ الجَوْرِ فيه قدودُكم","وفي سَعْيكم لانَتْ وبانَ لها عَدْلُ",52,"ل",1,0],["وتظهر في الجزر النائيا","ت كآمالنا الخابيات النؤر",53,"ر",1,0],["وَتُظْفِرُهُ مِنْ مَوْلاَهْ","بِكُلِّ طَوِيلٍ مَدِيدِ",54,"د",1,0],["وتظهر الأسماء فيك مضمرَهْ","مقامَ كنتُ سمعَهُ وبصرَهْ",55,"ه",1,0],["وَتظل تنشدهم فؤادا لم يكن","مع غير غزلان الحمى منشودا",56,"د",2,0],["وتظفر بالذي ترجو سريعاً","وتأمن من مخالفة وعذر",57,"ر",1,0],["وَتُظهِرُ في حالِ المُكافاةِ فَضلَها","عَلى عَدلِها في مُستَحَقَّ العُقوبَةِ",58,"ه",1,0],["وَتَظاهَرت أَعلام هاتيكَ الربا","وَبَدا لعينك نور تِلكَ الاربَع",59,"ع",1,0],["وتَظْهرُ في زِيِّ السّوادِ حُروفُها","شِعاراً وإلاّ فهْي بيضُ لآل",60,"ل",1,0],["وتُظهرُ صَبراً عَلى بُعدِهِ","وقلبُكَ في يَدِه مُرتَهَن",61,"ن",1,0],["وتظلُّ تَبكي مُقلَتي","بدمٍ على مرِّ الدُّهورِ",62,"ر",1,0],["وتظنُّ أن الدهرَ شيَّب لمني","هيهات قد صارت تشيبُ الأدهُرُ",63,"ر",1,0],["وتظنُّها دارت عليكَ وإنما","دارت على نوبِ الزمان بمرقدِ",64,"د",1,0],["وتظل تخبط شائداً ومقوِّضاً","ديراً فديراً كي تُصاد فتقتلا",65,"ل",2,0],["وتظاهر متشابهين فأذهلا","نسطورَ ذيّاك اللعينُ المُجرم",66,"م",1,0],["وتظل ساجعةً على الدِّمَن التي","ألفت بها لذّات عيشٍ أَشنَع",67,"ع",1,0],["وتظلُّ تهنأ بالربتيع رياضُها","وتزفُّ أشذاء الرضا أزهارها",68,"ر",3,0],["وتَظَلُّ شمسُ الحقِّ ذاتَ توهُّجٍ","يرْتدُّ عنها جيشُ كلِّ ظلامِ",69,"م",1,0],["وتظلّ تذْرِفُ بالدِّما آمَاقُهم","لِلْكَربِ لا رَقأَتْ لَهُمْ آماق",70,"ق",1,0],["وتظنهم بشراً فإن فتشتهم","أيقنت أن من الرجال طبولا",71,"ل",2,0],["وتُظهِرُ وُدِّي ثم تَرمي مقاتِلي","بسَهمِ اغتيابٍ دوَنهُ سَهمُ نابِلِ",72,"ل",1,0],["وَتَظلُّ لِلإِحسانِ ضامِنَةَ القَرى","مِن كُلِّ تامِكَةِ السَنامِ عَقيري",73,"ر",2,0],["وتظَلَّمْتُ من الحبِّ إلى","جائرٍ في حكمه ما عدلا",74,"ل",2,0],["وتظهر أسرار وتبدو لواعج","ويشكو محبٌّ ما جناه حبيب",75,"ب",1,0],["وتظنه بلعا لشد","دة بلعه لو كان سعدا",76,"د",2,0],["وتظلّ محسودا علي","يّ وحاسديّ عليك أكثر",77,"ر",1,0],["وتظن أني واقف","عن مكة وتوسوس",78,"س",1,0],["وتظن ومض سهيلها قبساً على","كف تمسح بالتراب لمن رنا",79,"ن",2,0],["وتظنهما لحيائهما","مما رفدا كمن استرفد",80,"د",1,0],["وتظل في بحر الأثيرِ مصونةً","ولو أنها هبطت لنا من حالقِ",81,"ق",1,0],["وتظل ذكراه تدو","رُ على الخواطر والشفاه",82,"ا",2,0],["وتُظلمَ آمالي عليك ومطلبي","ووجهُك من تحت اللثام أخو البدرِ",83,"ر",1,0],["وتظهر آثارُ العتاب بخّدها","كما بثَّ في الورد الجنَي البنفسج",84,"ج",1,0],["وتظمأ أطراف القني إلى العدى","وقد قذفت ماءَ الحديد القساطل",85,"ل",1,0],["وتظنُّ أنك ذو جمالٍ بارعٍ","والقردُ أحسن منك في التكوين",86,"ن",1,0],["وتظنُّ ذلك هيّناً","عندي وليس بهيّن",87,"ن",1,0],["وتظلُّ تسال عن دمي","عمداً وأنتَ قتلتني",87,"ي",1,0],["وتظلُّ تهتف بالعيون وإنما","بيضُ الجفون هي الجفون السود",88,"د",1,0],["وتظهَرُ لي الأَشياءُ من كلِّ بترِزٍ","لتُسلِيَني عنكُمْ وما أنا بالسَّالي",89,"ي",1,0],["وتظلُّ مُزْواةً فإنْ راجعتَها","كرَّتْ عليكَ هُنالِكَ الأَنباءُ",90,"ا",2,0],["وتظن لامعة البوارق في الدجى","بيضاً تجردها فوارس جرده",91,"د",2,0],["وتَظمَأُ والماءُ النَّمِيرُ مُدَفق","أمَامَكَ يَجرِي في الجَدَاولِ صَافِيا",92,"ي",2,0],["وتَظلُّ منتقِلا بخَير عواصِمٍ","في خيرِ حاشِية وخَيرِ رِكاب",93,"ب",1,0],["وتظلَّمتْ منه على","أنْ ليس تنفعها الظُّلامَهْ",94,"م",2,0],["وتُظْلِمُ دونِيَ طُرْقُ الصّواب","وَمِنّي اِستَعارَ النَّهار السَّنا",95,"ا",1,0],["وَتَظْهَرُ لِي مِنْهُ فِي كُلِّ يَوِمٍ","خَلاَئِقُ مُسْتَنْكَرَاتٌ فَظِيْعَهْ",96,"ع",2,0],["وَتظل خاشعةَ تضائل طرفها","للمكر وهي تُفِّق الجلمودا",97,"د",2,0],["وتَظَلُّ تَجْري لِلوَرى","مِنْ راحتَيه بِكُلِّ ريح",98,"ح",1,0],["وَتَظَلُّ في دُوّامَةِ ال","مَولودِ يُظلَمُها تَحَرَّق",99,"ق",1,0]]}