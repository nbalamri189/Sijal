{"poems":[[53,"بني عامر ما العز إلا لقادر","https://www.aldiwan.net/poem29773.html","الطويل"],[53,"إلى كم لا تلين على العتاب","https://www.aldiwan.net/poem30701.html","الوافر"],[53,"أي العيون تجانب الأقذاء","https://www.aldiwan.net/poem30780.html","الكامل"],[63,"ويوم طوينا أبرديه بروضة","https://www.aldiwan.net/poem45917.html","الطويل"],[63,"ومتيم زهرت بواقصة له","https://www.aldiwan.net/poem46148.html","الكامل"],[3,"وتظل عبلة في الخدور تجره","https://www.aldiwan.net/poem200.html",""],[93,"إهنأ بما أهدى المليك","https://www.aldiwan.net/poem9675.html","عموديه"],[93,"هي زهرة بسمت بها","https://www.aldiwan.net/poem11469.html","مجزوء الكامل"],[83,"أتعطش أولادي وأنت غمامة","https://www.aldiwan.net/poem54228.html","الطويل"],[27,"ألم يك لا أبا لك شتم تيم","https://www.aldiwan.net/poem6008.html","الوافر"],[72,"أخفي الأسى ولسان دمعي يعلن","https://www.aldiwan.net/poem20150.html","الكامل"],[51,"نشر آذار في الثرى حللا","https://www.aldiwan.net/poem8118.html","الخفيف"],[51,"أمامك فانظر أي نهجيك تنهج","https://www.aldiwan.net/poem9253.html","الطويل"],[51,"لشنطف كعثب خلق","https://www.aldiwan.net/poem65727.html","مجزوء الوافر"],[29,"صرمت أمامة حبلها ورعوم","https://www.aldiwan.net/poem6063.html","الكامل"],[91,"هم ألم به مع الظلماء","https://www.aldiwan.net/poem8725.html","عموديه"],[91,"لا تقلقي يوم النوى أو فاقلقي","https://www.aldiwan.net/poem8985.html","عموديه"],[92,"قضيت أدوار الحياة مفكرا","https://www.aldiwan.net/poem38916.html","الكامل"],[92,"يا أيها الطفل الذي قد","https://www.aldiwan.net/poem38926.html","مجزوء الكامل"],[92,"أيها الشعب ليتني كنت حطابا","https://www.aldiwan.net/poem38934.html","الخفيف"],[92,"عش بالشعور وللشعور فإنما","https://www.aldiwan.net/poem38938.html","البسيط"],[89,"الأغاني تصبي ولست بدار","https://www.aldiwan.net/poem44756.html","الكامل"],[85,"به هجر يتيمه","https://www.aldiwan.net/poem7140.html","مجزوء الوافر"],[85,"من أي عهد في القرى تتدفق","https://www.aldiwan.net/poem63707.html","الكامل"],[43,"في الخد أن عزم الخليط رحيلا","https://www.aldiwan.net/poem10125.html","الكامل"],[45,"أبا حسن أنت وشك الأجل","https://www.aldiwan.net/poem65566.html","البسيط"],[45,"أهلا بذالكم الخيال المقبل","https://www.aldiwan.net/poem65577.html","الكامل"],[28,"إن التي نظرت إليك بفادر","https://www.aldiwan.net/poem5215.html","الكامل"],[102,"يا حلوة العينين يا قاسيه","https://www.aldiwan.net/poem32927.html","السريع"],[52,"أنزلت من ليل كظل حصاة","https://www.aldiwan.net/poem27192.html","الكامل"],[75,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[75,"فتقت لكم ريح الجلاد بعنبر","https://www.aldiwan.net/poem69080.html","الكامل"],[50,"ألا طرقت موهنا مهدد","https://www.aldiwan.net/poem63884.html","الوافر"],[50,"يا عبد باهلة الذي يتوعد","https://www.aldiwan.net/poem63931.html","الكامل"],[46,"قد أصبحت ونعاتها نعاتها","https://www.aldiwan.net/poem22158.html","الكامل"],[46,"لا شام للسلطان إلا أن يرى","https://www.aldiwan.net/poem22488.html","الرجز"],[46,"أريد من الدنيا خمود شرورها","https://www.aldiwan.net/poem22612.html","الطويل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140869",""],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9970","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55197","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55189","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55113","الكامل"],[90,"الشهيد قيس","https://www.poetsgate.com/ViewPoem.aspx?id=179228",""],[91,"ضرة جلق","https://www.poetsgate.com/ViewPoem.aspx?id=53143",""],[92,"عِشْ بالشُّعورِ، وللشُّعورِ، فإنَّما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14582&r=&rc=27",""]],"verses":[["وَتَظمى عَلى الإِغذاذِ أَشداقُ خَيلِهِ","وَتَشرَبُ مِن أَفواهِهِنَّ الشَكائِمُ",0,"م",1,0],["وَتُظهِرُ أُسرَةً مِن سِرِّ قَومي","تَمُدُّ إِلى اِنتِظاري بِالرَقابِ",1,"ب",1,0],["وَتَظُنُّ كُلَّ غَمامَةٍ وَقَفَت بِهِ","تَبكي عَلَيهِ تَوَدُّداً وَوَلاءَ",2,"ا",2,0],["وَتُظْهِرُهُ طَوْراً وطَوْراً تُجِنُّهُ","فَتَحْسِبُه سَيْفاً يُسَلُّ وَيُغْمدُ",3,"د",1,0],["وتُظِلُّ منهُ السّمْهَريّةُ ضَيْغَماً","قَلِقَ الصّوارِمِ مُطمَئِنَّ الجاشِ",4,"ش",1,0],["وَتَظَلُّ عَبلَةُ في الخُدورِ تَجُرُّه","وَأَظَلُّ في حَلَقِ الحَديدِ المُبهَمِ",5,"م",1,1],["وَتَظَلُّ فِيهَا مُلْتَقَى","الآمَالِ إِنْ خَطْبٌ حَزَبْ",6,"ب",1,0],["وَتَظَلُّ عَاطِفَةً عَلَيْهِمْ","فِي اليَسِيرِ وَفِي الجَلِيلْ",7,"ل",1,0],["وتُظلم أوقاتي ووجهك نيّرٌ","تفيض به الأنوار للدين والدنيا",8,"ي",2,0],["وَتُظعَنُ عَن مَقامِكَ يا اِبنَ تَيمٍ","وَما أَظعَنتَ مِن أَحَدٍ مُقيمِ",9,"م",1,0],["وتظل تعدي الغانيات مدامعي","فمدامعي كعهودها تتلوَّن",10,"ن",1,0],["وتظهرُ الشمسُ في النَّشاص لنا","من خَلَلِ الغيم إذ تَغَشَّاها",11,"ا",3,0],["وتظعن خوفَ السَّبي بعد إقامة","ظَعائنُ لم يُضرب عليهنَّ هودجُ",12,"ج",1,0],["وتظهر عفة وتمي","ل نحو فتى شبق",13,"ق",1,0],["وَتَظَلُّ تَنصُفُنا بِها قَرَوِيَّةٌ","إِبريقُها بِرِقاعِها مَلثومُ",14,"م",1,0],["وَتَظَلُّ تَرفُلُ بِالحَريرِ أَمامَهُ","في حينِ قَد أَمسى بِغَيرِ كِساءِ",15,"ا",2,0],["وَتَظَلُّ صورَتُها تَلوحُ لِخاطِري","بَعضُ الرُأى سَلوى وَإِن تَصدُقِ",16,"ق",1,0],["وتِظِلُّ سَائِرةً كأنَّ فقيدها","مَا كانَ يوماً صاحباً وحميما",17,"م",2,0],["وتُظِلُّهُ سُحُبُ الظَّلامِ","فلا سكونَ ولا إياةْ",18,"ه",1,0],["وتَظَلُّ ترقُصُ للأَسى","للَّهْوِ أَشباحُ الدُّهُورْ",18,"ر",1,0],["وتَظَلُّ تُورِقُ ثمَّ تُزْهِرُ","ثمَّ يَنْشُرُها الصَّباحْ",18,"ح",1,0],["وتظلُّ تخفقُ ثمَّ تشدُو","ثمَّ يطويها التُّرابْ",18,"ب",1,0],["وتظلُّ تمشي في جِوارِ","الموتِ أَفراحُ الحَيَاةْ",18,"ه",1,0],["وتظَلُّ الطُّيورُ تلغو على قَبْرِيَ","ويشدو النَّسيمُ فوقي بهمسِ",19,"س",1,0],["وتظلُّ الفُصولُ تمشي حوالَيَّ","كما كُنَّ في غَضَارَةِ أَمسي",19,"ي",1,0],["وتَظَلُّ جامِدَةَ الجمالِ كئيبةً","كالهيكلِ المتهدِّم المهجورِ",20,"ر",1,0],["وتَظَلُّ قاسيَةَ الملامِحِ جهْمةً","كالموتِ مُقْفِرَةً بغيرِ سُرورِ",20,"ر",1,0],["وتظل الابصار شاخصة والسمع","في لهفة الى التكرار",21,"ر",1,0],["وتظلمه فلا يشكو","إلى من ليس يظلمه",22,"م",2,0],["وَتَظَلُّ بَينَ قُوى الحَياةِ جَوائِلاً","لا تَستَقِرُّ دَوائِلاً لا تُمحَقُ",23,"ق",1,0],["وَتَظُنُّهُ مِمّا يُزَمجِرُ نَفسُهُ","عَنها لِشِدَّةِ غَيظِهِ مَشغولا",24,"ل",2,0],["وَتُظهِرُ في آلِ وَهبٍ هَوىً","وَأَنتَ نَحَستَهُمُ يا زُحَل",25,"ل",1,0],["وَتَظُنُّ رَيعانَ الشَبابِ يَروعُهُ","مِن جَنَّةٍ أَو نَشوَةٍ أَو أَفكَلِ",26,"ل",1,0],["وَتَظَلُّ تَحسِبَ ظِلِّها شَيطانَةً","وَتَخالُ نافِرَةً وَإِن لَم تَنفِرِ",27,"ر",1,0],["وتظفئ النار التي حُرّ كتْ","فارجعتها زفرة حاميه",28,"ي",2,0],["وَتَظَلُّ غِربانُ الفَلا فيما اِدَّعَت","يَأكُلنَ لَحمَ الأَرضِ مُبتَدِراتِ",29,"ت",1,0],["وتَظُنُّ في لَهَواتِنا أسيافَنَا","وتَخالُ في تاجِ المعزِّ رسولا",30,"ل",2,0],["وتَظُنُّهُ مُتَخَمِّطاً من كِبْرِهِ","وتَخَالُهُ متنمِّراً لِيَصُولا",30,"ل",2,0],["وتظَلُّ تسبَحُ في الدماء قِبابُهُمْ","فكأنّهُنَّ سفائنٌ في أبحر",31,"ر",1,0],["وَتُظهِرُ حُبَّ نَبِيِّ الهُدى","وَأَنتَ بِهِ كافِرٌ تَشهَدُ",32,"د",1,0],["وَتَظَلُّ تُرعَدُ مِن هَديلِ حَمامَةٍ","وَإِذا دُعيتَ لِسَوأَةٍ لا تُرعَدُ",33,"د",1,0],["وَتَظَلُّ حَبّاتُ القُلوبِ زَرائِعاً","كَالأَرضِ وَالصَهَواتُ مُزدَرَعاتُها",34,"ت",3,0],["وَتَظَلُّ أَبياتٌ لَهُم شَعَريّةٌ","كَبُيوتِ شِعرٍ في البِلادِ شَوارِدِ",35,"د",1,0],["وَتُظهِرُ لي مَقتاً وَأَضمُرُ حُبَّها","كَأَنّي جَهولٌ ما عَرَفتُ شَنارَها",36,"ر",3,0],["وتظنه مما يزمجر نفسه","عنها بشدة غيظة مشغولا",37,"ل",2,0],["وَتَظَلُّ عَبلَةُ في الخُدورِ تَجُرُّها","وَأَظَلُّ في حَلَقِ الحَديدِ المُبهَمِ",38,"م",1,1],["وتَظلُّ عَنْ مَجْرَى الحَياةِ بِمَعْزِلٍ","وَتُنَافِسُ العُمْرَانَ بِالأَطْلاَلِ",39,"ل",1,0],["وَتَظَلَّ تؤْنِسُهَا النَّجُومُ بِنَبْاةٍ","مهْمَا تُطِلْ فَاللَّيْلُ غَيْرُ طَويلِ",40,"ل",1,0],["وتَظَلُّ مُتَّقِياً هَوَا","كَ مُشَاوِراً فِيهِ رَشَادك",41,"ك",1,0],["وتظَلُّ تسألُ مَخْدَعاً","لك عن هجوعِك والهُبوب",42,"ب",1,0],["وتظلّ صورتها تلوح لخاطري","بعض الرؤى سلوى وإن لم تصدق",43,"ق",1,0],["وَتَظَلُّ قاسية َ الملامحِ، جهْمة ً","كالموتِ..، مُقْفِرة ً، بغير يرورِ",44,"ر",1,0]]}