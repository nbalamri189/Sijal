رقّ قلوبا","https://www.poetsgate.com/ViewPoem.aspx?id=197518",""],[5135,"لُغةُ الخُلُود","https://www.poetsgate.com/ViewPoem.aspx?id=202027",""],[5145,"أعوز الصبر فهل لي من طريق","https://www.poetsgate.com/ViewPoem.aspx?id=108199",""],[5150,"العاشقه ...!","https://www.poetsgate.com/ViewPoem.aspx?id=204341",""],[5168,"ارض الحضارات","https://www.poetsgate.com/ViewPoem.aspx?id=33570",""],[5183,"الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=186473",""],[5186,"أيهذا البناء لو كنت حرا","https://www.poetsgate.com/ViewPoem.aspx?id=156469",""],[5285,"زهر الشجون","https://www.poetsgate.com/ViewPoem.aspx?id=203539",""],[5351,"القادم أولاً وثانياً","https://www.poetsgate.com/ViewPoem.aspx?id=202236",""],[5413,"أيها الحاضر المنسي","https://www.poetsgate.com/ViewPoem.aspx?id=208594",""],[5419,"تباريح الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=32266",""],[5425,"شَفَتِي الغَلِيْلُ وَثَغْرُكِ المُتَبَرَّضُ","https://www.poetsgate.com/ViewPoem.aspx?id=207511",""],[5431,"ولم أزل ممشيا!","https://www.poetsgate.com/ViewPoem.aspx?id=192762",""],[5444,"رسالةٌ إلى نجم آفل","https://www.poetsgate.com/ViewPoem.aspx?id=205071",""],[5447,"جيش المرسى القديم","https://www.poetsgate.com/ViewPoem.aspx?id=208357",""],[5447,"شبيهة","https://www.poetsgate.com/ViewPoem.aspx?id=208662",""],[5470,"وشايةُعطر","https://www.poetsgate.com/ViewPoem.aspx?id=10889",""],[5538,"ترفع عن وضيع النفس تسلم","https://www.poetsgate.com/ViewPoem.aspx?id=142622",""],[5561,"سفر الروح","https://www.poetsgate.com/ViewPoem.aspx?id=192757",""],[5582,"مُذْ حُلْنَ دُونَكِ يا سُعادُ فَراسِخُ","https://www.poetsgate.com/ViewPoem.aspx?id=186855",""],[5582,"( نَفْسُ ) المُتَيَّمِ فِي الصَّبابَةِ شانُها","https://www.poetsgate.com/ViewPoem.aspx?id=63591",""],[5621,"قِبلةُ الأرواح","https://www.poetsgate.com/ViewPoem.aspx?id=24566",""],[5633,"ضَوْءٌ وَتِلَاوَةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=208630",""],[5689,"ارك بقلبي بت غير موسوس","https://www.poetsgate.com/ViewPoem.aspx?id=143394",""],[5720,"مَاذَا يُرِيْدُ الحَاقِدُونَ ؟!","https://www.poetsgate.com/ViewPoem.aspx?id=200254",""],[5723,"ينابيع للشهادة والزيتون","https://www.poetsgate.com/ViewPoem.aspx?id=190280",""],[5751,"قُبْلةٌ بَينَ عَينَيكْ","https://www.poetsgate.com/ViewPoem.aspx?id=214767",""],[5790,"آيات سحرٍ من لحاظك تنزل","https://www.poetsgate.com/ViewPoem.aspx?id=112104",""],[5837,"سجين المحبة","https://www.poetsgate.com/ViewPoem.aspx?id=181854",""],[845,"إلى أبي تراب","https://www.poetsgate.com/ViewPoem.aspx?id=159622",""],[5897,"من وحي ال21","https://www.poetsgate.com/ViewPoem.aspx?id=158793",""],[5952,"آخر الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=204836",""],[5953,"الله أكبر قددنا الفتح","https://www.poetsgate.com/ViewPoem.aspx?id=93791",""],[5953,"لاح ضياء القمر الزاهر","https://www.poetsgate.com/ViewPoem.aspx?id=93849",""],[5956,"الغجرية سارقة الطفل *","https://www.poetsgate.com/ViewPoem.aspx?id=184538",""],[6031,"كَفُّ الحِمَامِ وَتَرْتِ أيَّ جَوَادِ","https://www.poetsgate.com/ViewPoem.aspx?id=46281",""],[6052,"بطاقات حمراء من غزة","https://www.poetsgate.com/ViewPoem.aspx?id=47578",""],[6069,"ولنا إذا انبجست أهاضيب الحيا","https://www.poetsgate.com/ViewPoem.aspx?id=105664",""],[4442,"وجهك أم بدر السماء إتلق","https://www.poetsgate.com/ViewPoem.aspx?id=171023",""],[523,"ما أصعب الكلام (رثاء ناجي العلي)","https://www.poetsgate.com/ViewPoem.aspx?id=304",""],[6189,"بهو الفيروز","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83569&r=&rc=36",""],[6367,"أشواق حجازية الإيقاع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80598&r=&rc=1",""]],"verses":[["وَتَظمى عَلى الإِغذاذِ أَشداقُ خَيلِهِ","وَتَشرَبُ مِن أَفواهِهِنَّ الشَكائِمُ",0,"م",1,0],["وَتُظهِرُ أُسرَةً مِن سِرِّ قَومي","تَمُدُّ إِلى اِنتِظاري بِالرَقابِ",1,"ب",1,0],["وَتَظُنُّ كُلَّ غَمامَةٍ وَقَفَت بِهِ","تَبكي عَلَيهِ تَوَدُّداً وَوَلاءَ",2,"ا",2,0],["وَتُظْهِرُهُ طَوْراً وطَوْراً تُجِنُّهُ","فَتَحْسِبُه سَيْفاً يُسَلُّ وَيُغْمدُ",3,"د",1,0],["وتُظِلُّ منهُ السّمْهَريّةُ ضَيْغَماً","قَلِقَ الصّوارِمِ مُطمَئِنَّ الجاشِ",4,"ش",1,0],["وَتَظَلُّ عَبلَةُ في الخُدورِ تَجُرُّه","وَأَظَلُّ في حَلَقِ الحَديدِ المُبهَمِ",5,"م",1,1],["وَتَظَلُّ فِيهَا مُلْتَقَى","الآمَالِ إِنْ خَطْبٌ حَزَبْ",6,"ب",1,0],["وَتَظَلُّ عَاطِفَةً عَلَيْهِمْ","فِي اليَسِيرِ وَفِي الجَلِيلْ",7,"ل",1,0],["وتُظلم أوقاتي ووجهك نيّرٌ","تفيض به الأنوار للدين والدنيا",8,"ي",2,0],["وَتُظعَنُ عَن مَقامِكَ يا اِبنَ تَيمٍ","وَما أَظعَنتَ مِن أَحَدٍ مُقيمِ",9,"م",1,0],["وتظل تعدي الغانيات مدامعي","فمدامعي كعهودها تتلوَّن",10,"ن",1,0],["وتظهرُ الشمسُ في النَّشاص لنا","من خَلَلِ الغيم إذ تَغَشَّاها",11,"ا",3,0],["وتظعن خوفَ السَّبي بعد إقامة","ظَعائنُ لم يُضرب عليهنَّ هودجُ",12,"ج",1,0],["وتظهر عفة وتمي","ل نحو فتى شبق",13,"ق",1,0],["وَتَظَلُّ تَنصُفُنا بِها قَرَوِيَّةٌ","إِبريقُها بِرِقاعِها مَلثومُ",14,"م",1,0],["وَتَظَلُّ تَرفُلُ بِالحَريرِ أَمامَهُ","في حينِ قَد أَمسى بِغَيرِ كِساءِ",15,"ا",2,0],["وَتَظَلُّ صورَتُها تَلوحُ لِخاطِري","بَعضُ الرُأى سَلوى وَإِن تَصدُقِ",16,"ق",1,0],["وتِظِلُّ سَائِرةً كأنَّ فقيدها","مَا كانَ يوماً صاحباً وحميما",17,"م",2,0],["وتُظِلُّهُ سُحُبُ الظَّلامِ","فلا سكونَ ولا إياةْ",18,"ه",1,0],["وتَظَلُّ ترقُصُ للأَسى","للَّهْوِ أَشباحُ الدُّهُورْ",18,"ر",1,0],["وتَظَلُّ تُورِقُ ثمَّ تُزْهِرُ","ثمَّ يَنْشُرُها الصَّباحْ",18,"ح",1,0],["وتظلُّ تخفقُ ثمَّ تشدُو","ثمَّ يطويها التُّرابْ",18,"ب",1,0],["وتظلُّ تمشي في جِوارِ","الموتِ أَفراحُ الحَيَاةْ",18,"ه",1,0],["وتظَلُّ الطُّيورُ تلغو على قَبْرِيَ","ويشدو النَّسيمُ فوقي بهمسِ",19,"س",1,0],["وتظلُّ الفُصولُ تمشي حوالَيَّ","كما كُنَّ في غَضَارَةِ أَمسي",19,"س",2,0],["وتَظَلُّ جامِدَةَ الجمالِ كئيبةً","كالهيكلِ المتهدِّم المهجورِ",20,"ر",1,0],["وتَظَلُّ قاسيَةَ الملامِحِ جهْمةً","كالموتِ مُقْفِرَةً بغيرِ سُرورِ",20,"ر",1,0],["وتظل الابصار شاخصة والسمع","في لهفة الى التكرار",21,"ر",1,0],["وتظلمه فلا يشكو","إلى من ليس يظلمه",22,"م",2,0],["وَتَظَلُّ بَينَ قُوى الحَياةِ جَوائِلاً","لا تَستَقِرُّ دَوائِلاً لا تُمحَقُ",23,"ق",1,0],["وَتَظُنُّهُ مِمّا يُزَمجِرُ نَفسُهُ","عَنها لِشِدَّةِ غَيظِهِ مَشغولا",24,"ل",2,0],["وَتُظهِرُ في آلِ وَهبٍ هَوىً","وَأَنتَ نَحَستَهُمُ يا زُحَل",25,"ل",1,0],["وَتَظُنُّ رَيعانَ الشَبابِ يَروعُهُ","مِن جَنَّةٍ أَو نَشوَةٍ أَو أَفكَلِ",26,"ل",1,0],["وَتَظَلُّ تَحسِبَ ظِلِّها شَيطانَةً","وَتَخالُ نافِرَةً وَإِن لَم تَنفِرِ",27,"ر",1,0],["وتظفئ النار التي حُرّ كتْ","فارجعتها زفرة حاميه",28,"ي",2,0],["وَتَظَلُّ غِربانُ الفَلا فيما اِدَّعَت","يَأكُلنَ لَحمَ الأَرضِ مُبتَدِراتِ",29,"ت",1,0],["وتَظُنُّ في لَهَواتِنا أسيافَنَا","وتَخالُ في تاجِ المعزِّ رسولا",30,"ل",2,0],["وتَظُنُّهُ مُتَخَمِّطاً من كِبْرِهِ","وتَخَالُهُ متنمِّراً لِيَصُولا",30,"ل",2,0],["وتظَلُّ تسبَحُ في الدماء قِبابُهُمْ","فكأنّهُنَّ سفائنٌ في أبحر",31,"ر",1,0],["وَتُظهِرُ حُبَّ نَبِيِّ الهُدى","وَأَنتَ بِهِ كافِرٌ تَشهَدُ",32,"د",1,0],["وَتَظَلُّ تُرعَدُ مِن هَديلِ حَمامَةٍ","وَإِذا دُعيتَ لِسَوأَةٍ لا تُرعَدُ",33,"د",1,0],["وَتَظَلُّ حَبّاتُ القُلوبِ زَرائِعاً","كَالأَرضِ وَالصَهَواتُ مُزدَرَعاتُها",34,"ت",3,0],["وَتَظَلُّ أَبياتٌ لَهُم شَعَريّةٌ","كَبُيوتِ شِعرٍ في البِلادِ شَوارِدِ",35,"د",1,0],["وَتُظهِرُ لي مَقتاً وَأَضمُرُ حُبَّها","كَأَنّي جَهولٌ ما عَرَفتُ شَنارَها",36,"ر",3,0],["وتظنه مما يزمجر نفسه","عنها بشدة غيظة مشغولا",37,"ل",2,0],["وَتَظَلُّ عَبلَةُ في الخُدورِ تَجُرُّها","وَأَظَلُّ في حَلَقِ الحَديدِ المُبهَمِ",38,"م",1,1],["وتَظلُّ عَنْ مَجْرَى الحَياةِ بِمَعْزِلٍ","وَتُنَافِسُ العُمْرَانَ بِالأَطْلاَلِ",39,"ل",1,0],["وَتَظَلَّ تؤْنِسُهَا النَّجُومُ بِنَبْاةٍ","مهْمَا تُطِلْ فَاللَّيْلُ غَيْرُ طَويلِ",40,"ل",1,0],["وتَظَلُّ مُتَّقِياً هَوَا","كَ مُشَاوِراً فِيهِ رَشَادك",41,"ك",1,0],["وتظل تموت لكي تحيا","وتموت لكي تحيا أكثر",42,"ر",1,0],["وتظلم شعبا على علمه","ويغضبها أنّه يعلمُ",43,"م",1,0],["وتظَلُّ تسألُ مَخْدَعاً","لك عن هجوعِك والهُبوب",44,"ب",1,0],["وتظلّ صورتها تلوح لخاطري","بعض الرؤى سلوى وإن لم تصدق",45,"ق",1,0],["وَتَظَلُّ قاسية َ الملامحِ، جهْمة ً","كالموتِ..، مُقْفِرة ً، بغير يرورِ",46,"ر",1,0],["وتظاهر المتصدرين لبيعهم","لا عن تقى بحماية الأديان",47,"ن",1,0],["وتظهر العَوَّا ليل خمسِ","منه وعشرين بغير لبسِ",48,"س",1,0],["وتظهر للأيام منهم براعة","يكون بها بين البلاد لك الفخرُ",49,"ر",1,0],["وَتُظْه