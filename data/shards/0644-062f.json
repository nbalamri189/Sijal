نّاءَ أَزْهَرَ جانِباهَا","يُرَنِّحُنا بِها نَزَقُ المِراحِ",3,"ح",1,0],["لدى مُتوَقِّدِ العَزَماتِ طَلْقِ ال","خَليقَةِ والمُحَيّا والبَنانِ",4,"ن",1,0],["لدَيْهِنّ منْ رألِ الرِّمالِ إذا انثَنَتْ","تَليلُ ومِنْ ظَبْي الفَلاةِ أَسارِعُ",5,"ع",1,0],["لَدى اِبنِ يَزيدٍ أَو لَدى اِبنِ مُعَرِّفٍ","يَفُتُّ لَها طَوراً وَطَوراً بِمِقلَدِ",6,"د",1,0],["لَدُن غُدوَةً حَتّى أَتى اللَيلُ دونَهُ","وَجَشَّمَ صَبراً رَوقَهُ فَتَجَشَّما",7,"م",2,0],["لَدى غَيرِ مِصرَ لَهُ حُظوَةٌ","فَكَم راحَ يَلهو بِهِ مَن لَها",8,"ا",1,0],["لَدَيها وُفودُ اللَفظِ تَنساقُ خَلفَها","وُفودُ المَعاني خُشَّعاً عِندَ خُشَّعِ",9,"ع",1,0],["لَدى كُلِّ شَعبٍ في الحَوادِثِ عُدَّةٌ","وَعُدَّتُنا نَدبُ التُراثِ المُضَيَّعِ",9,"ع",1,0],["لَدَهاكُما وَرَماكُما وَذَراكُما","ماحي الحُصونِ وَماسِحُ البُلدانِ",10,"ن",1,0],["لَدى راكِدٍ يُصبيكَ مِن صَفَحاتِهِ","قَواريرُ خُضرٍ خِلتَها مُرِّدَت صَرحا",11,"ح",2,0],["لَدى تُرعَةٍ تَرنو بِأَحداقِ نَرجِسِ","بِطاحُ هَواءٍ مُطمِعِ الحالِ مُؤيِسِ",12,"س",1,0],["لَدَيهِ رِياضٌ لِلسَجايا أَنيقَةٌ","تَغَلغَلُ فيها لِلعَطايا جَداوِلُ",13,"ل",1,0],["لَدى زَهَراتِ الرَوضِ عَنها بِشارَةٌ","وَفي نَفَحاتِ المِسكِ مِن طيبِها وَفدُ",14,"د",1,0],["لَدَى أَمِيرَةِ فَضْلٍ","مَصُونَةٍ وَهَّابَهْ",15,"ب",2,0],["لَدُنْ هَجَمَ الْقُرْصَانُ يَغْزُونَ غَرْبَهَا","كَما كَانَتِ الْجُهَّالُ فِي الْبَدْوِ تَهْجُمُ",16,"م",1,0],["لَدى مَلِكٍ يَعلو الرِجالَ بِضَوئِهِ","كَما يَبهَرُ البَدرُ النُجومَ السَوارِيا",17,"ي",2,0],["لَدى كُلِّ نَقضٍ يَشتَكي مِن خِشاشِهِ","وَنِسعَيهِ أَو سَجراءَ حُرٍّ قَذالُها",18,"ل",3,0],["لَدُن غُدوَةٍ حَتّى إِذا اِمتَدَّتِ الضُحى","وَحَثَّ القَطينَ الشَحشَحانُ المُكَلَّفُ",19,"ف",1,0],["لَدى كُلِّ مِثلِ الجَفنِ تَهوي بِآلِهِ","بَقايا مُصاصِ العِتقِ وَالمُخُّ بارِدُ",20,"د",1,0],["لدى محفِل في القدس بالقوم حافلٍ","تبَّوأه هرير صموئيل في الصدر",21,"ر",1,0],["لدي الجدث الفرد الذي فيه قد ثوى","من الملك الفرد ابن أيوب رئبال",22,"ل",1,0],["لدار شِنِلَّر في القدس فضل","به تَنْسَى تَيَتُّمها اليتامى",23,"م",2,1],["لَدى قَطَرِيّاتٍ إِذا ما تَغَوَّلَت","بِنا البيدُ غاوَلنَ الحُزونَ القَياقِيا",24,"ي",2,0],["لَدُن أَن دَعا ديكُ الصَباحِ بِسُحرَةٍ","إِلى قَدرِ وِردِ الخامِسِ المُتَأَوِّبِ",25,"ب",1,0],["لَدَى الرَحمَنِ يَصدَعُ بالمَثَانِي","وكَانَ له أَبُو حَسَنٍ مُطِيعَاً",26,"ع",2,0],["لَدى كُلِّ بُنيانٍ رَفيعٍ وَمَجلِسٍ","نَشاوى وَكَأسٍ أُخلِصَت لَم تَصَوَّمِ",27,"م",1,0],["لِدَعوَةِ مَعشَرٍ كانوا جَميعاً","كَأَسنانِ الحِمارِ مِنَ السَنامِ",28,"م",1,0],["لدار النحاس به حلية","فدار النحاس كدار الذهب",29,"ب",1,0],["لدن المعاطف يمناه ومقلته","تسقيكَ إن حملت راحاً وإن لمحت",30,"ت",1,0],["لدجلةَ خَبٌّ ليس لليمِّ إنها","تُرائي بحلمٍ تحته جهلُ واثبِ",31,"ب",1,0],["لَدْنَةُ الغُصْن مُكْتَساها رشيقٌ","والمعَرَّى مُطَهَّرٌ رُعْبُوبُ",32,"ب",1,0],["لَدرى هلْ مُذكَّرٌ","فوقَها أم مؤنَّثُ",33,"ث",1,0],["لدَّدتني شدائدٌ فأجِرْني","لا أطالتْ شدائدٌ تلديدَكْ",34,"ك",1,0],["لدى ملك يأبَى له الزَّهوَ قَدْرُهُ","ويُزهَى به جُلاسه ومَجالسه",35,"س",2,0],["لديهمُ الدهرَ تصريحٌ بفضلهمُ","إذ ما لهم بتقاضي الشكرِ تَعريض",36,"ض",1,0],["لدن من الأغصان في روضة","من نرجس تنظر أحداقه",37,"ق",2,0],["لدى روضةٍ فيها من النَّوْرِ أعينٌ","تُرقرق دمعاً بل ثغورٌ تبسَّمُ",38,"م",1,0],["لَدُن غُدوَةً حَتّى إِذا ما تَيَقَّظَت","هَواجِرُ مِن شَعبانَ حامٍ أَصيلُها",39,"ل",3,0],["لَدَيكَُم كَوكَب وَبِنا ظَلامٌ","وَأَنتُمُ تَكرَونَ لَنا العِثارا",40,"ر",2,0],["لَدَيَّ لَكُم ذاكَ الوَفاءُ بِعَينِهِ","وَعِندي لَكُم ذاكَ الوِدادُ يُصانُ",41,"ن",1,0],["لَدى مَلِكٍ رَحبِ الخَليقَةِ قاهِرٍ","فَمَجلِسُهُ الدُنيا وَخادِمُهُ الدَهرُ",42,"ر",1,0],["لَدُن غُدوَةً حَتّى نَروحَ عَشِيَّةً","نُحَيّا وَأَيدينا بِأَيدٍ نُصافِحُ",43,"ح",1,0],["لَدى ساعِدَي مَهرِيَّةٍ شَدَنِيَّةٍ","أُنيخَت قَليلاً وَالعَصافيرُ تَنطُقُ",44,"ق",1,0],["لَدى مُغلَقٍ أَيدي الخُصومِ تَنوشُهُ","وَأَمرٍ يُحِبُّ المَرءُ فيهِ المَوالِيا",45,"ي",2,0],["لديّ لَك العُتبى تُزاحُ عَن العتبِ","وَسَعيُك عِندي لا يُضاف إِلى ذَنبِ",46,"ب",1,1],["لدغت رجله على","غرة حية ذكر",47,"ر",1,0],["لِدودَةِ القَزِّ عِندي","وَدودَةِ الأَضواءِ",48,"ا",2,1],["لَدى مَلِكٍ لا يَمنَعُ الظِلَّ لائِذاً","وَلا الصَفحَ تَوّاباً وَلا العَفوَ راجِيا",49,"ي",2,0],["لَدى البابِ جِبريلُ الأَمينُ بِراحِهِ","رَسائِلُ رَحمانِيَّةُ النَفَحاتِ",50,"ت",1,0],["لَدى رَوضَةٍ جادَ الرَبيعُ نَباتَها","بِغُرِّ الغَوادي تَستَهِلُّ وَتَسكُبُ",51,"ب",1,0],["لَدى خُلُقٍ جاسي النَواحي كَأَنَّني","أُصارِعُ مِنهُ هادِيَ الأَسَدِ الوَردِ",52,"د",1,0],["لِدارِكِ يا لَيلى سَماءٌ تَجودُها","وَأَنفاسُ ريحٍ كُلَّ يَومٍ تَعودُها",53,"د",3,1],["لَدُن هَجَرَتهُ زَحزَحَتهُ عَنِ الصَبرِ","سَواءٌ عَلَيهِ المَوتُ أَو لَوعَةُ الهَجرِ",54,"ر",1,1],["لَدى مَلِكٍ أَثرى مِنَ المَجدِ وَالغِنى","بِأَن لَم يَرَ الإِثراءَ أَن يَفِرَ الوَفرُ",55,"ر",1,0],["لَدى أَشعَرِيٍّ يَعلَمُ الشَعرُ أَنَّهُ","سَيَنزِعُ في تَصديقِهِ ثُمَ يُغرِقُ",56,"ق",1,0],["لَدَيكَ هَوى النَفسِ اللَجوجِ وَسولُها","وَفيكَ المُنى لَو أَنَّ وَصلاً يُنيلُها",57,"ل",3,1],["لَدُن غُدوَةٍ حَتّى أَرى الأُفقَ ناشِراً","عَلى شَرقِهِ عُرفاً مِنَ اللَيلِ أَسحَما",58,"م",2,0],["لَدُن قُتِلَ المَظلومُ أَن يَطلُبوا بِهِ","وَمَولى دَمِ المَظلومِ مِنهُم وَثائِرُه",59,"ر",2,0],["لَدى مَلِكٍ وَاِبنِ المُلوكِ كَأَنَّهُ","تَمامُ بُدورٍ ضَوءُهُ غَيرُ كاسِفِ",60,"ف",1,0],["لَدُن غَدوَةً حَتّى نَروحَ وَتاجُهُ","عَلَينا وَذاكي المِسكِ فَوقَ المَفارِقِ",61,"ق",1,0],["لَدُن جاوَرَ النيلَ اِبنُ لَيلى فَإِنَّهُ","يَفيضُ عَلى أَيدي المَساكينِ نايِلُه",62,"ل",2,0],["لَدى الحَبلِ مَن يُسرى ذِراعَي شِمِلَّةٍ","أُنيخَت فَأَلقَت فَوقَهُ بِجِرانِ",63,"ن",1,0],["لَدى أَسَدٍ شاكي السِلاحِ مُقَذَّفٍ","لَهُ لِبَدٌ أَظفارُهُ لَم تُقَلَّمِ",64,"م",1,0],["لِدوا لِلمَوتِ وَاِبنوا لِلخَرابِ","فَكُلُّكُمُ يَصيرُ إِلى ذَهابِ",65,"ب",1,1],["لِدَواعي الخَيرِ وَالشَر","رِ دُنُوٌّ وَنُزوحُ",66,"ح",1,0],["لِدِفاعِ دائِرَةِ الرَدى","يَتَضايَقُ الرَأيُ الأَصيلُ",67,"ل",1,0],["لِدِيارِ مِصرَ الهَناءُ وَإِن غَدا","لِلزَومِ بُعدِكَ وَالعِراقِ تَعازي",68,"ي",1,0],["لَدَيَّ تَصِحُّ ثِمارُ الوَفاءِ","لِصَبرِيَ عِندَ اِنقِلابِ الهَوى",69,"و",2,1],["لِدوا لِلمَوتِ وَاِبنوا لِلخَرابِ","فَما فَوقَ التُرابِ إِلى التُرابِ",70,"ب",1,1],["لَدى مَعرَكٍ خاضَت بِهِ الخَيلُ في الوَغى","مِنَ الدَمِ فيما خاضَتِ البيضُ وَالسُمرُ",71,"ر",1,0],["لَدى مَلِكٍ كَالرَم