 على الشِعرِ بيضاءُ","بما زيَّنَتْ له من مَواسِم",138,"م",1,0],["لدنٌ إذا ما الدهرُ جّد فهزَّة","في طِرسه تكفيكَ ردَّ صُروفه",139,"ف",2,0],["لديكم كوكب وبنا ظلام","وأنتم تكرهون لنا العثارا",140,"ر",2,0],["لديكَ بل أحسنت ظني سامدا","مُراغماً للشُّبُهات طاردا",141,"د",2,0],["لدجلة َ خَبٌّ ليس لليمِّ، إنها","تَراءى بحلمٍ تحته جهْلُ واثب",142,"ب",1,0],["لدى كلِّ مثلِ الجفنِ تهوي بآلهِ","بَقَايَا مُصَاصِ العِتْقِ وَالمُحُّ بَارِدُ",143,"د",1,0],["لدى الذّاعي إذا رُفِع اللّواء","إذا نزل الشّتاء بجار قومٍ",144,"م",1,0]]}