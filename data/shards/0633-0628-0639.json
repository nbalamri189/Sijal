.poetsgate.com/ViewPoem.aspx?id=151697",""],[6160,"أَجنِحَةُ الضَّوء ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87084&r=&rc=1",""],[6200,"غَابَةُ الأَطْفالِ وَ الحِجَارَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81373&r=&rc=15",""],[6202,"انفض السامر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86710&r=&rc=11",""],[6202,"سبعون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86728&r=&rc=29",""],[6339,"وطن النماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87894&r=&rc=6",""]],"verses":[["سَبعٌ وَتِسعونَ اِهتَبَلنَ لَكَ العِدا","حَتّى مَضَوا وَغَبَرتَ غَيرَ مُذَمَّمِ",0,"م",1,0],["سَبعٌ وَعُشرونَ اِهتَصَرنَ شَبيبَتي","وَأَلَنَّ عودي لِلزَمانِ الكاسِرِ",1,"ر",1,0],["سبْعٌ مضَتْ منْ زَمانِ اللّيْلِ وا أسَفي","هلْ لي من العُمرِ المَسروقِ منْ خلَفِ",2,"ف",1,1],["سَبعونَ مِليوناً إِذا وَزَّعتَها","بَينَ الحَواضِرِ نالَنا مِليونُ",3,"ن",1,0],["سبعون مليون ممن جدهم عرب","عليك في الشرق يا بلفور غضبان",4,"ن",1,0],["سَبعونَ لَيثاً أُحرِقوا أَو أُغرِقوا","يا لَيتَهُم قُتِلوا عَلى طَبَروكِ",5,"ك",1,0],["سبعٌ وخمسونَ لو مرَّتْ على حَجَرٍ","لبانَ تأثيرُها في صفحةِ الحَجَرِ",6,"ر",1,0],["سَبْعِينَ إن خُنتم قَضينا أمرَنا","فيهم ولن يَجدوا هُنالِكَ فاديا",7,"ي",2,0],["سبعين عاماً إذا طاح","عسكرٌ ثابَ عسكر",8,"ر",1,0],["سبعون أولها لهوٌ وآخرُها","لو يعرِفُ المرءُ لاقى الموتَ مرتاحا",9,"ح",2,0],["سبعٌ طباقٌ له الرحمن ذلَّلَها","وكيف لا، وهْو طاويها بيمناه؟",10,"ا",2,0],["سبعون عامًا في احتلالٍ دائمٍ","يا لَلْكنانِة من سنينَ عِجَاف!",11,"ف",1,0],["سبعونَ عامًا وأنتْم تطبعون على","حبِّ الحمى وإباء الضَّيْم أولادي",12,"د",2,0],["سبعون عامًا، كان من أهوالها:","أن يهرَمَ الهَرَمُ الذي لم يَهْرَم",13,"م",1,0],["سبعونَ عاماً جُلتَ في جَنَباتها","تبكي حريباً أو تُسامرُ واصبا",14,"ب",2,0],["سبع سنواتن وأنا روحك ومحبوبك","وسبع اسنواتن تفضفضني وتكناني",15,"ن",2,0],["سَبعاً بِالإحرَامِ بِالاُولَى كَبِّرَا","وَبِالقِيَامِ سِتَّةً بِلاَ مِرَا",16,"ر",2,0],["سبعون جزءا كأزهار السماء بدت","كالشهب تنقضّ من بعد ومن كثب",17,"ب",1,0],["سَبعٌ وَعِشرونُ لَم يُفجَع بِها أَدَبٌ","وَلَم يُخَيِّم عَلى فِتيانِها نَزَقُ",18,"ق",1,0],["سَبعينَ أَلفاً فَضَّها في مَجلِس","لَم يَبقَ مِنها عِندَهُ فلسانِ",19,"ن",1,0],["سَبعونَ وَفداً سَوفَ أَذكُرُ بَعضَ ما","قَد كانَ مَشهوراً مِنَ الوفدانِ",19,"ن",1,0],["سَبعونَ أَلفاً كُلَّما عَرَجوا أَتى","سَبعونَ أَلفاً في الصَّباحِ الثاني",19,"ن",2,0],["سَبعونَ أَلفاً لا حِسابَ عَلَيهِم","مَعَ أَلفِها سَبعونَ أَلفَ مُعاني",19,"ن",2,0],["سبعالمثاني ثناء يمدحون به","وَمدح غيرهم سجع واشعار",20,"ر",1,0],["سبع جوزات وتينه","فتحوا باب المدينه",21,"ه",1,1],["سبعٌ وعشرون بيوتا خاليةُ","تُعَدَّ من جِهاتها الثمانية",22,"ه",1,0],["سبعونَ عاما في الحياة وسبعة","صارتْ لعُمرك عندنا عنوانا",23,"ن",2,0],["سبعون عاماً في لذاذةٍ شهوةٌ","لا يستقر معالجاً أنزالها",24,"ل",3,0],["سبعون ألف ذؤابة من خلفها","مثل الشموس وصائفاً حمالها",24,"ل",3,0],["سَبعينَ عاما ً مَلأتَ الكَونَ أجنِحَة ً","خَفْقَ الشَّرارِ تَلاشَتْ وهيَ تَشتَعِلُ",25,"ل",1,0],["سَبعونَ عاما ً..وهذا أنتَ مُرتَحِلٌ","ولَستَ تَدري لأيِّ الأرض ِتَرتَحِلُ !",25,"ل",1,0],["سَبعينَ عاما ًطَوَينا نُستَفَزُّ دَما ً","فَتَملأ ُ الأرضَ أرحاما ً مَنايانا",26,"ن",2,0],["سَبعينَ عاما ً، وَتَدري السُّوحُ أجمَعُها","أنَّا أقَمنا بِجُرفِ المَوتِ مَرسانا",26,"ن",2,0],["سبع المثاني التي لِلّه قُمتَ بها","عليك من سرِّها معنى وتقديمُ",27,"م",1,0],["سبعون عاماً بألف كذبةٍ زُرعتْ","ما أثمرتْ غيرَ حبرٍ أرضهُ ورقُ",28,"ق",1,0],["سبعون عاماً بألف كذبةٍ فُضِحتْ","كم كذّبت نفسها وصدّق الخرِقُ",28,"ق",1,0],["سبعون مرّت ورأسُ هيئةٍ قصَمتْ","ظهرَ الشّعوبِ علىْ أوضاعِنا قلِقُ",28,"ق",1,0],["سبعون والحقُّ أسْدٌ كلّما زأرتْ","باض ونقّ المهرولونَ أو نهَقوا",28,"ق",3,0],["سبعون عاماً وظلُّ جدّةٍ نفقتْ","من دورةِ الإنتظارِ ليس ينْعتِقُ",28,"ق",1,0],["سبع تليت على السبع الشداد بها","قواعداً للمعالي فاقت الأفقا",29,"ق",2,0],["سبعونَ أو مئةٌ من الأحزابِ في","خُلْفٍ عَلَى لَزَمٍ وما لم يَلَزَمِ",30,"م",1,0],["سبعة شبهت بها الأنجم السب","عة ذات الأنوار والأضواءِ",31,"ا",2,0],["سَبْعٌ لِيَ اليَوْمَ أيا بُغْيَتي","لَم يَبْدُ لي مَنْظَرُكَ الأبْدَعُ",32,"ع",1,1],["سَبْعٌ لِيَ اليَوْمَ أيا بُغْيَتي","لَم يَبْدُ لي مَنْظَرُكَ المُشْرِقُ",33,"ق",1,1],["سَبْعٌ لِيَ اليَوْمَ أيا بُغْيَتي","لَم يَبْدُ لي مَنْظَرُكَ الأحْسَنُ",34,"ن",1,1],["سَبْعٌ لِيَ اليَوْمَ أيا بُغْيَتي","لَم يَبْدُ لي مَنْظَرُكَ الأوْسَمُ",35,"م",1,1],["سَبْعٌ لِيَ اليَوْمَ أيا بُغْيَتي","لَم يَبْدُ لي مَنْظَرُكَ الأظْرَفُ",36,"ف",1,1],["سَبْعٌ لِيَ اليَوْمَ أيا بُغْيَتي","لَم يَبْدُ لي مَنْظَرُكَ الأوْضَحُ",37,"ح",1,1],["سَبْعٌ لِيَ اليَوْمَ أيا بُغْيَتي","لَم يَبْدُ لي مَنْظَرُكَ الأسْعَدُ",38,"د",1,1],["سَبْعٌ لِيَ اليَوْمَ أيا بُغْيَتي","لَم يَبْدُ لي مَنْظَرُكَ الأجْمَلُ",39,"ل",1,1],["سَبْعٌ لِيَ اليَوْمَ أيا بُغْيَتي","لَم يَبْدُ لي مَنْظَرُكَ الأقْمَرُ",40,"ر",1,1],["سَبْعٌ لِيَ اليَوْمَ أيا بُغْيَتي","لَم يَبْدُ لي مَنْظَرُكَ الأعْجَبُ",41,"ب",1,1],["سَبْعَةٌ مِنْ خَلاَئِفِ ولَدُوهُ","لَمْ يكُنْ ذَا لغيره مِنْ رَئِيسِ",42,"س",1,0],["سَبعُ تمرُ دامِيَا","تٌ والعِراقُ ضائِعُ",43,"ع",1,0],["سَبعون لا سَبع نَرجوها وَتأَملها","بِالخَير وَاليَمَن وَالإِقبال في العَمَلِ",44,"ل",1,0],["سبع وعشرون انقضت أعيادها","ومللت أنت تعاقب الاعياد",45,"د",1,0],["سبع من الإعراب ما لها محل","ومثلها لها محل في الجمل",46,"ل",1,0],["سبعٌ من النقطِ لذي نصبٍ جُعل","من خطه ورأسُه منها عُمِل",47,"ل",1,0],["سبعة أصناف من الأنساب","قد حرمت في محكم الكتاب",48,"ب",1,0],["سَبعَ سِنينَ بَعدَها ثَمانِيَه","كامِلَة مِن الشُهورِ وافِيَه",49,"ه",1,0],["سبعون عاما بين كل اثنين من","ها قدّرت بالعد والحسبان",50,"ن",1,0],["سبعون من حلل عليها لا تعو","ق الطرق عن مخ ورا الساقان",50,"ن",1,0],["سَبعونَ عاماً عاشَها","مَلِكاً تَقَضَّت فَهيَ رِيح",51,"ح",1,0],["سبعٌ وعشرٌ وشهور خمسه","وأصبحت حياتهُ منبسَّه",52,"ه",1,0],["سَبعٌ كَمِثلِ الجاهِ عِندَ الصرفَه","بَل هُم يَضِقنَ فَآفهَمِ الوصفَه",53,"ه",1,0],["سَبعَةُ إلا رُبعٌ يا إخوانُ","قِياسُ عادَه ما بِهِ نُقصانُ",54,"ن",1,0],["سبعون مَع سبعين مَع سبعينا","وأربعٌ مَع عَشر يَحسِبُونا",55,"ن",2,0],["سَبعٌ وَرُبعٌ قَطُّ ما فيهِ مِرَا","والحوتُ هُو أربَعَةٌ مُشتَهِرَا",56,"ر",2,0],["سَبعَةُ أخنانٍ لَهُنَّ جُملَه","أحدَ وَعِشرونَ كُفِيتَ الغَفلَه",57,"ه",1,0],["سَبعَه وخَمسُونَ وَأربَعُونَا","لِنَاكِ باري سَبعُ مَع تسعينَا",57,"ن",2,0],["سبعاً ونصف تراهما شَمَالاَ","بِمَيلِ للمَشرقِ لا مَحَالاَ",57,"ل",2,0],["سبعةُ أزوامٍ تزيدُ نصفا","فوق الثلاثين فهاكَ الوصفَا",58,"ف",2,0],["سبعونَ زاماً وحسابٌ ثاني","يَحكُم بها أَقَل رُبِّانِ",58,"ن",1,0],["سَبعَةٌ إلاّ ثُلثَ تَحقِيقَا","فَقِس عَلَيهِ تَعرِفِ الطَّرِيقَا",59,"ق",2,0],["سَبع الوجوه وَالتاج","هِيَ مُنيةُ الأَفراح",60,"ح",1,0],["سبعةٌ كالبدور فيها جمالاً","كيف تنجو من سحرهن القلوب",61,"ب",1,0],["سبعا كوامل لم تدع من آية","الاكوحي أو كوشم كعاب",62,"ب",1,0],["سبعة أشياء بدت مهمه","تلزم للمأموم بالأئمه",63,"ه",1,0],["سبعين مولىً كريماً ما بكى لهم","باكٍ ولا أحد يوماً لهم وارى",64,"ر",2,0],["سَبعَة عَشر مِن متاريس بَنوا","وَالناس في أَعيُنِهِم هذا رَأوا",65,"ا",3,0],["سَبعَة أَيّام مَع اللَيالي","يَرمونَ نيراناً عَلى التَوالي",65,"ي",1,0],["سبعون ألف كل يوم عدهم","خبر صحيح جآنا في السنة",66,"ه",1,0],["سبعٌ وعشرون لو مرَّت على جبلٍ","لراح يختال منها ذلك الجبلُ",67,"ل",1,0],["سبعون حولا لقد مرَّت وما وجدت","نفسى مقرًّا لها في العالم الثانى",68,"ن",2,1],["سبعينَ مَرّةً لو أني أقتَلُ","أُحرَقُ مِثلَهاب نارِ تُشعَلُ",69,"ل",1,0],["سَبْعين مليونٍ لاهَالِيْك","وسبعين مِنّي لِكْ انْعَامِ",70,"م",1,0],["سبعةٌ كالنجومِ تهدى إلى النْ","نَظْمِ ابتداء من قائل أو أجازهْ",71,"ز",2,0],["سبعة من آلِ شِمرٍ قُتلوا","كلُّهم تاجٌ عليهِ وسِوَارُ",72,"ر",1,0],["سبعون عطشان قاوموا الأعدا وهم","سبعون الفاً والحشى تلتهب",73,"ب",1,0],["سبعون عطشى قابلوا في الوغى","سبعين الفاً عند شداتها",74,"ت",3,0],["سَبعاً تماماً كلما الغَيثُ اغْتدى","يهمي بها أذن الإِلهُ فراحا",75,"ح",2,0],["سبعٌ لأبوابِ نيرانٍ مغلقَةٌ","وهنَّ روضةُ جنَّاتٍ لمغتنمِ",76,"م",1,0],["سبع سنين قيل أو تسعَ عشرْ","وقيل أربعين هكذا الخبرْ",77,"ر",1,0],["سَبعين عاماً قَضى بالعلمِ مجتهداً","لَيلاً نَهاراً وَاضنى جفنهُ السهرُ",78,"ر",1,0],["سبعة في سبعة قد قرنا","إن هذا لهو الخلق العجيب",79,"ب",1,0],["سبعون ميلاً كنَّا نجول بها","بين جسورٍ وبين أَدواح",80,"ح",1,0],["سبعون ألفاً قُتِّلُوا واستأسَرُوا","مثلاً ومنه استوحَشَ الأمصار",81,"ر",1,0],["سبعون ألفاً يوم صفِّينٍ مضى"