{"poems":[[55,"متى أنا قائم أعلى مقام","https://www.aldiwan.net/poem29753.html","الوافر"],[55,"بحيث انعقد الرمل","https://www.aldiwan.net/poem29854.html","الهزج"],[57,"يا موقد النار بالهندي والغار","https://www.aldiwan.net/poem26369.html","البسيط"],[79,"حديث على رغم العلا غير كاذب","https://www.aldiwan.net/poem36768.html","الطويل"],[95,"هذا الرثاء الذي تمليه أشجاني","https://www.aldiwan.net/poem11189.html","البسيط"],[53,"قد قلت بيتا لك تلقاءه","https://www.aldiwan.net/poem65524.html","السريع"],[53,"أبا العباس ما هذا التواني","https://www.aldiwan.net/poem66343.html","الوافر"],[47,"عست دمن بالأبرقين خوال","https://www.aldiwan.net/poem65567.html","الكامل"],[30,"أناخ إليكم طالب طال ما نأت","https://www.aldiwan.net/poem5601.html","الطويل"],[35,"فما وجد أعرابية قذفت بها","https://www.aldiwan.net/poem25978.html","الطويل"],[48,"عجبت لورقاء الجناحين شأنها","https://www.aldiwan.net/poem22529.html","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62240","المتقارب"],[135,"أبلغ نعيماً وأوفى إن لقيتهما","https://www.aldiwan.net/poem23982.html","البسيط"],[147,"أما وظلك مما خفته وزر","https://www.aldiwan.net/poem11759.html","البسيط"],[186,"ما في زمانك من ترجو مودته","https://www.aldiwan.net/poem67048.html","البسيط"],[190,"شربت بالمكاره في نهاري","https://www.aldiwan.net/poem43265.html","الوافر"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[214,"فؤادي منك ملآن","https://www.aldiwan.net/poem13344.html","الهزج"],[214,"فؤاد قد أضر به التنائي","https://www.aldiwan.net/poem13441.html","الوافر"],[240,"سقى صوب الحيا دمنا","https://www.aldiwan.net/poem31915.html","مجزوء الوافر"],[240,"رمتني الليالي من مصابك يا أخي","https://www.aldiwan.net/poem32106.html","الطويل"],[264,"سلام كأزهار الرياض النوافح","https://www.aldiwan.net/poem35781.html","الطويل"],[362,"أنوماً وقد بان الخليط تذوق","https://www.aldiwan.net/poem4159.html","الطويل"],[382,"أيا أغنياء الروح صونوا كنوزَكم","https://www.aldiwan.net/poem59426.html","الطويل"],[422,"أهاج الجوى برقا أغار وأنجدا","https://www.aldiwan.net/poem54165.html","الطويل"],[447,"أموت الحليلات عرس جديد","https://www.aldiwan.net/poem14452.html","المتقارب"],[463,"لعل الركب أن خلصوا نجيا","https://www.aldiwan.net/poem55813.html","الوافر"],[473,"يا راحتي وعذابي","https://www.aldiwan.net/poem60424.html","المجتث"],[519,"أما ومواضي مقلتيها الفواصل","https://www.aldiwan.net/poem20797.html","الطويل"],[568,"أحداج تلك الجمال","https://www.aldiwan.net/poem13601.html","المجتث"],[569,"أجودُ ابن زين أو غيوثُ سواجم","https://www.aldiwan.net/poem890.html",""],[794,"","https://poetry.dctabudhabi.ae/diwan/poem/101199","الوافر"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72291","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136250","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136308","البسيط"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105419","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69383","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53142","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53066","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27458","الوافر"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28509","البسيط"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137394",""],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139975","المتقارب"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62871","الوافر"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103908","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91073","البسيط"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202371","المجتث"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59476","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77152","الطويل"],[4081,"","https://poetry.dctabudhabi.ae/diwan/poem/67680","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83429","السريع"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72703","الوافر"],[4767,"جرح البحرين","https://www.poetsgate.com/ViewPoem.aspx?id=178432",""],[5030,"يا أعز الناس","https://www.poetsgate.com/ViewPoem.aspx?id=215812",""],[1021,"تبدى يملأ الناظر","https://www.poetsgate.com/ViewPoem.aspx?id=47834",""],[5582,"سُطُورُ هَوَىً ما فِي حَقِيقَتِها لَغْوُ","https://www.poetsgate.com/ViewPoem.aspx?id=187334",""],[5725,"مدينة الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=184314",""]],"verses":[["فَما أَخشى الزَمانَ وَلَو تَلاقَت","يَداهُ مِن وَرائي أَو أَمامي",0,"م",2,0],["فَما أَخلَفَكُم جارٌ","مِنَ الماقينَ مُنهَلُّ",1,"ل",1,0],["فَما أَخو سَفَرٍ في البيد مُرتَهَنٍ","قَد كانَ في رُفَقٍ شَتّى لِأَمصارِ",2,"ر",1,0],["فَمَا اخْتَصَّتِ الأَمْلاَكُ مِثْلَ مُحَمَّدٍ","وَمَا افْتَخَرَتْ طُولَ الزَّمَانِ بِحَاجِبِ",3,"ب",1,0],["فَمَا أَخَافُ عَلَى مَنْ يُسْتَغَاثُ لَهُ","وَفِيكُمْ كُلُّ مِسْمَاحٍ وَمِعْوَانِ",4,"ن",1,0],["فما أخو ودي بتلعابة","يلعب بالنار لإحراقي",5,"ق",2,0],["فما أخْلَيْتُهُ من نَهْشِ لحم","ولا أخليتُه من حَطْمِ عظْم",6,"م",1,0],["فَما اِختارَكَ السُلطانُ إِلّا اِستِنامَةً","إِلى رَجُلٍ يُغني غَناءَ رِجالِ",7,"ل",1,0],["فَما إِخوَةٌ مِنّا نُبايِعُكُم بِهِم","بِحَبسٍ عَلىالمَولى وَتَنكيلِ ظالِمِ",8,"م",1,0],["فَما أَخَّرَت إِذ هَيَّجَت مِن صَبابَتي","غَداةَ أَشاعَت لِلهَوى وَاِرفَأَنَّتِ",9,"ت",1,0],["فَما أَخَذَت إِلّا ثَلاثاً وَنَحوَها","مِنَ الحُبِّ حَتّى جاءَ بِالحَتفِ صَقرُها",10,"ر",3,0],["فَمَا أُخْفِ يَخْفَ عَلَى عِفَّةٍ","ومَا أُبْدِ يَعْلُن إِذَا مَا عَلَنْ",11,"ن",1,0],["فَما أَخي بِأَخي سَوءٍ فَيَنقُصَهُ","إِذا تَقارَبَ بِاِبنِ الصادِرِ القِسمُ",12,"م",1,0],["فَما أَخَذتَ مِنَ الإِحمادِ ما تَرَكوا","حَتّى وَصَلتَ مِنَ الإِنعامِ ما هَجَروا",13,"ر",3,0],["فَما أَخو اللُؤم لِلحُرِّ الكَريمِ أَخٌ","وَلا صَديقٌ إِذا خانَ الزَّمانَ وَفى",14,"ف",2,0],["فما أخلو على الحالين مما","ثغمّ ولو ثملت من المدام",15,"م",1,0],["فَما اِختَلفوا في الدينِ إلّا لحكمةٍ","وَما اِبتدَعوا في الدينِ نَهياً ولا أمرا",16,"ر",2,0],["فما أخشى ومن رؤيا","ك لي روح وريحان",17,"ن",1,0],["فما اخلى الاله لكم ربوعا","وصيرها ربيعا بالهناء",18,"ا",2,0],["فَما اِختَلَطَ الصَوابُ عَلى","بَديهَتِهِ وَلا اِلتَبَسا",19,"س",2,0],["فَما اِختَلَسَتهُ مِن يَدي كَفُّ ضَيغَمٍ","وَلا اِختَطَفَتهُ كَفُّ أَقتَمَ أَفسَخِ",20,"خ",1,0],["فما اخترتُ بعدي عن حماكم بخاطري","ولكن لعذرٍ فيه أقضي مصالحي",21,"ح",2,0],["فَما أَخفَقَت لِلسَّفرِ نَحوَكَ رِحلَةٌ","وَلا كَسَدَت لِلحَمدِ عِندَك سوقُ",22,"ق",1,0],["فما أخبث الدهر الكذوب بأهله","وما أكثر الآفات في الدهر والعمر",23,"ر",1,0],["فما اختار إلاَّ منزل العزِّ منزلاً","ولا اختار إلاَّ مقعد المجد مقعدا",24,"د",2,0],["فما أخطأ الموت عصم الجبال","ولا في الأجام سلمن الأُسود",25,"د",1,0],["فما اختارت سوى المختارِ خِدناً","كفيلا في الصّعاب لها كفيَّا",26,"ي",2,0],["فَما أَخَذتَ أَماناً","مِن أَن تَرى بِكَ ما بي",27,"ب",2,0],["فَما اِختالَ ظبيٌ قبلَها في مَدارِعٍ","ولا مالَ غُصنٌ يانعٌ في غَلائِلِ",28,"ل",1,0],["فَما اِختِيالي اِطَّباها","وَلا لَطيفُ اِحتِيالي",29,"ل",2,0],["فما أخصبت غلا بغيثٍ مرابع","من الزمن أو ممن نمته الأكارم",30,"م",1,0],["فما اختارت بقائي الدار إلا","لا وحي بالهوى عنها وتوحي",31,"ح",2,0],["فما اخضر ترب الأرض إلا لأنها","عليه إذا زارت بأقدامها تخطو",32,"ط",2,0],["فما اخالك تدري ما بمهجته","من شاهد منه دمع العين قد ذرفا",33,"ف",2,0],["فما اخالك بالتسويف تدرك ما","ترومه وحسام العجز مفلول",34,"ل",1,0],["فما أخذوا إلا بغرة كتبهم","فسحقاً وخسراناً لمرسلة الكتب",35,"ب",1,0],["فَما أَخلُو إِلَيكُم مِن غَرامٍ","وَلا أَخلُو إَلَيكُم مِن نِزاعِ",36,"ع",1,0],["فما أخذوه عنوة غير أنه","تأخر عني حين راح يودع",37,"ع",1,0],["فما أخشى وقد أعليت قدري","وذكري من يبالغ في اطّراحي",38,"ح",2,0],["فما أخفاه مضمرها","لقد أبداه كائنها",39,"ن",3,0],["فَما أَخافُ مَطالَ الحَظِّ تَحرِمُني","نَداكَ إِن طالَ في أَيّامِكَ العُمُرُ",40,"ر",1,0],["فما اختفى قمر الا واتبعه","صبح له بضياء البشر إسفار",41,"ر",1,0],["فما اختار إلا رفيقاً علا","ولا اعتام إلا جواراً فضل",42,"ل",1,0],["فما أَخشىَ الذي نطقتْ عدِي","ولو مَلأَتْ عليَّ الأرضَ زاراَ",43,"ر",2,0],["فما أخرت حرب مراتب سؤددي","ولا قعدت بي عن ذرى المجد فارس",44,"س",1,0],["فَما أَخسَّ حَياةً لَيسَ نصرفُها","في حبه حيث يدعونا فَلم نُجب",45,"ب",1,0],["فما أخذت به غي","ر بغلة ولحاف",46,"ف",1,0],["فما أخطأتني منذ كنتُ مَحامدٌ","ولا دَّنستني مذ نشأت المطامعُ",47,"ع",1,0],["فَما اِختَرتَ لي غَيرَ الصَبابَةِ مَذهَباً","وَحَسبُكَ عِلمي بِالغَرامِ فَكُن كَما",48,"م",2,0],["فَما أَخطَأت مِنهُ الفُؤاد بعَمدها","فَلا أَبصَرَت تِلكَ العُيون الرَوامقُ",49,"ق",1,0],["فَما اِختيارُ المرءِ إِلّا عمى","بهِ فَجانِب شَأنَ قَومٍ عَمين",50,"ن",1,0],["فما أخطت ولكن قد اصابت","به قلبي الكئيب فراح دامي",51,"م",2,0],["فما أخفت ليالي الدهرِ نوراً","كسا البيداء ثوباً والبحارا",52,"ر",2,0],["فما أخشى مماتا ياحياتي","كما أخشى شرودي وقتَ فرْضي",53,"ض",2,0],["فما أخذل والصاح","ب مجد الدين لي ناصر",54,"ر",1,0],["فَما أَخْطَأَتْها مُحْكَماتُ قَرِيضِها","وَلا انْعاجَ عَنْ قَصْدٍ لِتَصْرِيحِها النَّحْوُ",55,"و",1,0],["فما اخفى السواد سطوع وجه","اذا ضمّ الخسوف النيرين",56,"ن",1,0]]}