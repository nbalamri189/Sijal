{"poems":[[88,"أحمد الله إذ سلمت لمصر","https://www.aldiwan.net/poem68901.html","الخفيف"],[51,"قل لذي الوجه الطرر","https://www.aldiwan.net/poem64193.html","مجزوء الرمل"],[68,"سلبتنا فواتك اللفتات","https://www.aldiwan.net/poem40646.html","الخفيف"],[54,"قل لذات النقاب إن محبا","https://www.aldiwan.net/poem26838.html","الخفيف"],[50,"قل لذي الطرف الخلوب","https://www.aldiwan.net/poem10816.html","مجزوء الرمل"],[50,"قل لذا الوجه الطرير","https://www.aldiwan.net/poem63335.html","مجزوء الرمل"],[50,"قل لذي الوجه الرقيق","https://www.aldiwan.net/poem64430.html","مجزوء الرمل"],[50,"قل لذي الوجه المترك","https://www.aldiwan.net/poem66290.html","مجزوء الرمل"],[50,"قل لذي الدل تولب","https://www.aldiwan.net/poem66563.html","مجزوء الخفيف"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/8996","الرمل"],[129,"سبيئتان اثنتان هذي","https://www.aldiwan.net/poem4070.html","مخلع البسيط"],[164,"يزداد هجرا كل ما كلما","https://www.aldiwan.net/poem58866.html","السريع"],[369,"سيف عينيك عازم الانتضاء","https://www.aldiwan.net/poem61004.html","الوافر"],[411,"قل لذي العز والمحل النبيه","https://www.aldiwan.net/poem49431.html","الخفيف"],[463,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122559","الخفيف"],[766,"","https://poetry.dctabudhabi.ae/diwan/poem/98006","السريع"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62592","الرمل"],[1390,"","https://poetry.dctabudhabi.ae/diwan/poem/117138","الخفيف"],[1471,"","https://poetry.dctabudhabi.ae/diwan/poem/18365","الخفيف"],[288,"","https://poetry.dctabudhabi.ae/diwan/poem/200300","الخفيف"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110334","الرمل"],[2546,"","https://poetry.dctabudhabi.ae/diwan/poem/33915","الرمل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129851","الخفيف"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35511","الرمل"],[4537,"","https://poetry.dctabudhabi.ae/diwan/poem/96069","الطويل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52167","الرمل"],[2546,"قلْ لذي الطرّة ِ","https://www.poetsgate.com/ViewPoem.aspx?id=17176",""]],"verses":[["قُل لِذاكَ الأَثيمِ وَالفاتِكِ المَف","تونِ لا كُنتَ كَيفَ تَرمي السِماكا",0,"ك",2,0],["قُل لِذي الوَجهِ الطَرِرِ","وَلِذي الرَدفِ الوَثيرِ",1,"ر",1,1],["قُل لِذاتِ الجَمالِ إِذ رُمتُ إِنجا","زَ عِداتي فَأَصبَحَت مِن عِداتي",2,"ي",1,0],["قُل لِذاتِ النِقابِ إِنَّ مُحِبّاً","قَد قَرا مِن سُطورِ حُسنِكِ حَرفا",3,"ف",2,1],["قُل لِذي الطَرفِ الخَلوبِ","وَلِذي الوَجهِ الغَضوبِ",4,"ب",1,1],["قُل لِذا الوَجهِ الطَريرِ","وَلِذا الرِدفِ الوَثيرِ",5,"ر",1,1],["قُل لِذي الوَجهِ الرَقيقِ","وَلِذي الحُسنِ الدَقيقِ",6,"ق",1,1],["قل لذي الوجهِ المترّك","ولذي الصدغِ الممسّك",7,"ك",1,1],["قل لذي الدلّ تولَبِ","يا فداكَ الردى أبي",8,"ب",2,1],["قُل لِذاتِ اللَحظَةِ المُخَنَّثَه","وَلَئِن أَمسَت بِلَوني عَبِثَه",9,"ه",1,1],["قُل لذوي العلمِ خَبّروني","ما الحلّ مِنها وما الحَرامُ",10,"م",1,0],["قل لذوي الكفرِ أسلموا واحذروا","فليس يحيى مسلماً مسلما",11,"م",2,0],["قُل لذُخْرِ الإسلامِ يا أيها الفا","رِجُ عنه للكُرْبةِ السّوداء",12,"ا",2,0],["قلْ لذي العِزِّ والمَحَلِّ النِّبيهِ","لأبي رَوْحٍ الفَقيهِ الوَجيهِ",13,"ه",1,1],["قل لذوِي الحاجاتِ مطرودةً","وابنِ السبيل الضيِّقِ المَذهبِ",14,"ب",1,0],["قل لذاتِ الوِشاحِ حَسبُكِ قد أن","ضجتِ في الكَيِّ أيما إنضاج",15,"ج",1,0],["قل لذوي العلم وأهلِ النهى","وَيْحَكُمُ لا تَبْذُلُوا دفترا",16,"ر",2,1],["قل لذي العقل يحسِّنْ سعيه","في الورى فالدهر حرب وسَلَمْ",17,"م",1,0],["قل لذات القناع هل جئت ذنبا","فيك حتى اسبلت دوني القناعا",18,"ع",2,0],["قُل لِذي الوُدِّ وَالصَفاءِ حُسَينٍ","أَقدِرِ الوُدَّ بَينَنا قَدَرَه",19,"ر",2,1],["قُلْ لذا الآكِل المُرَارِ خُذِ المُلْ","كَ ولا تَبْكِيَنْ قَتِيلَ الكُلاَبِ",20,"ب",1,1],["قُل لذي العلم إذا رام العُلى","إن مجد العلم في أن تعملا",21,"ل",2,1],["قُل لِذي الطُرَّةِ وَالأَص","داعِ وَالوَجهِ المَليحِ",22,"ح",1,1],["قل لذي المفخرِ الحديثِ تأخّر","ليس مهرٌ في شأوهِ مثل قارح",23,"ح",1,0],["قُل لِذي الوَجه المَليح","وَلِذي الفِعل القَبيحِ",24,"ح",1,1],["قُل لذوي سيفٍ وسيف ألستُم","أقلَّ بني سعدٍ حصاداً ومزرعا",25,"ع",2,1],["قل لذاك النسر والموت","لمن هان وتاها",26,"ا",3,0],["قلْ لذي الطرّة ِ والأص","داغِ والوجهِ المليحِ",27,"ح",1,1]]}