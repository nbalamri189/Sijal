{"poems":[[102,"وحدي هنا","https://www.aldiwan.net/poem24837.html","عموديه"],[95,"إلياس باقتك الصغيرة جنة","https://www.aldiwan.net/poem11251.html","الكامل"],[95,"فداحة الخطب أبكتني عليك دماً","https://www.aldiwan.net/poem11349.html","البسيط"],[95,"صدقت في عتبكم أو يصدق الشمم","https://www.aldiwan.net/poem11361.html","البسيط"],[74,"قوامك تحت شعرك يا أمامه","https://www.aldiwan.net/poem19681.html","الوافر"],[30,"وطارق ليل من علية زارنا","https://www.aldiwan.net/poem5142.html","الطويل"],[30,"إليك أبا الأشبال سارت مطيتي","https://www.aldiwan.net/poem5146.html","الطويل"],[51,"أما من الموت لحي نجا","https://www.aldiwan.net/poem10321.html","السريع"],[46,"إلياس كن في ضمان الله والذمم","https://www.aldiwan.net/poem30346.html","البسيط"],[46,"حل الأمير محل رفد الرافد","https://www.aldiwan.net/poem30525.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85598","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54995","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54811","المجتث"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54832","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55029","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55126","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54782","المجتث"],[92,"اليأس المنشود","https://www.poetsgate.com/ViewPoem.aspx?id=179218",""],[96,"العذراء الخائنة","https://www.poetsgate.com/ViewPoem.aspx?id=15617",""],[327,"اليأس من طول الثواء رواح","https://www.aldiwan.net/poem56342.html","الكامل"],[382,"عيني لتلك الناحيه","https://www.aldiwan.net/poem59167.html","مجزوء الكامل"],[458,"الياس عساف لم تبرح روائعه","https://www.aldiwan.net/poem61731.html","البسيط"],[463,"أمنك خيال ضوع الركب موهنا","https://www.aldiwan.net/poem55831.html","الطويل"],[463,"أنشد من عهد ليلى غير موجود","https://www.aldiwan.net/poem56215.html","البسيط"],[520,"حسبت الدهر في ولدي","https://www.aldiwan.net/poem12294.html","الهزج"],[556,"من عذيري من سقام","https://www.aldiwan.net/poem48076.html","مجزوء الرمل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138250",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138312",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138208",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138413",""],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101540","الكامل"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129530","الطويل"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/20001","المنسرح"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87685","المجتث"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137322",""],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205785","الوافر"],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11287","البسيط"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145043","المجتث"],[3394,"","https://poetry.dctabudhabi.ae/diwan/poem/123879","الخفيف"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125934","الكامل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76437","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111520","الطويل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136913",""],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139287","المجتث"],[4571,"","https://poetry.dctabudhabi.ae/diwan/poem/99113","البسيط"],[4679,"الياس شحود إلى دار البقا","https://www.poetsgate.com/ViewPoem.aspx?id=142792",""],[4690,"مَا ضَلَّ رَكْبٌ هَدْيُهُ السَمْحاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=120306",""],[4978,"رفح والأمة المشبورة","https://www.poetsgate.com/ViewPoem.aspx?id=177177",""],[5092,"أنا وليلٌ بعينيها","https://www.poetsgate.com/ViewPoem.aspx?id=147140",""],[5092,"مسافة يأس","https://www.poetsgate.com/ViewPoem.aspx?id=177002",""],[5111,"رَقصَةٌ للألَقِ","https://www.poetsgate.com/ViewPoem.aspx?id=212772",""],[5121,"دُرَّةُ الوَفَاء / أختي إبتهال","https://www.poetsgate.com/ViewPoem.aspx?id=49549",""],[5147,"للفوز أجهزة تداول صرفها","https://www.poetsgate.com/ViewPoem.aspx?id=166743",""],[5158,"لا تاخذين الجرح","https://www.poetsgate.com/ViewPoem.aspx?id=58967",""],[5183,"خميلة الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=185682",""],[5252,"تبي تسكتني","https://www.poetsgate.com/ViewPoem.aspx?id=36105",""],[5413,"ديغول عادَ","https://www.poetsgate.com/ViewPoem.aspx?id=208605",""],[5452,"الشّعر","https://www.poetsgate.com/ViewPoem.aspx?id=148452",""],[5459,"طال الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=205766",""],[5533,"ما بَيْنَ بُرْدَيَّ","https://www.poetsgate.com/ViewPoem.aspx?id=181664",""],[5573,"الياس جمره تشتعل داخل الجوف","https://www.poetsgate.com/ViewPoem.aspx?id=200075",""],[5573,"ياهجسُ مالكَ لاتميلُ لراحتي","https://www.poetsgate.com/ViewPoem.aspx?id=213731",""],[5628,"الخروج من القمقم","https://www.poetsgate.com/ViewPoem.aspx?id=178500",""],[5732,"اقطف زهر مالاق","https://www.poetsgate.com/ViewPoem.aspx?id=177908",""],[402,"الياس أثلث جدا","https://www.poetsgate.com/ViewPoem.aspx?id=35483",""],[402,"صدقت في عتبكم أو يصدق الشمم","https://www.poetsgate.com/ViewPoem.aspx?id=36829",""],[5823,"بكائية لياسمين دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=59163",""],[5859,"عودي","https://www.poetsgate.com/ViewPoem.aspx?id=29413",""],[5956,"أقصوصة امرأة بوصلتها الجنس","https://www.poetsgate.com/ViewPoem.aspx?id=182704",""],[5956,"سلبيّات الحب","https://www.poetsgate.com/ViewPoem.aspx?id=184230",""],[5956,"لله أكتب أشعاري","https://www.poetsgate.com/ViewPoem.aspx?id=192029",""],[6108,"أحتاج بعدك","https://www.poetsgate.com/ViewPoem.aspx?id=192589",""],[6171,"عَزْفٌ عَلَى وَتَرِ الَيأسِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86326&r=&rc=9",""],[6213,"لا لم أيأس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76309&r=&rc=57",""]],"verses":[["اليأس يسلبني عن ال","عليا ولا الآمال تجدي",0,"د",2,0],["إِليَاسُ بَاقَتُكَ الصَّغِيرةُ جَنَّةٌ","فِيها صُنُوفُ الوَرْدِ وَالرَّيْحَانِ",1,"ن",1,1],["إِليَاسُ لَيْسَ بِسَهْلٍ مَا أَلَمَّ بِنَا","لَمَّا هَوَيْتَ وَكُنْتَ المُفْرَد العَلَما",2,"م",2,0],["إِليَاسُ مَا دُمْتُمْ وَالله يَحْفَظُكُمْ","بَاقٍ بِأَعْقَابِهِ فَالعِقْدُ مَا انْفَصَمَا",2,"م",2,0],["أَليَأْسُ مَنْهَكَةٌ لِلقَوْمِ مُوبِقَةٌ","فِي حَمْأَةٍ تَتَلاشَى عِنْدَهَا الشِّيَمُ",3,"م",1,0],["إلى أسد لها نسبٌ ولكن","محاسنها إلى آرام رامهْ",4,"م",2,0],["إِلى أَسَدٍ سيري فَإِنَّ لِقاءَهُ","حَيا الغَيثِ يُحيِي مَيِّتَ الأَرضِ ماطِرُه",5,"ر",2,0],["إِلى أَسَدٍ سارَت بِرَحلي وَخاطَرَت","عَوادِيَ مِن غُلبٍ يَكادُ زَئيرُها",6,"ر",3,0],["اليَأسُ يَحمي لِلفَتى عِرضَهُ","وَالطَمَعُ الكاذِبُ داءٌ عَيا",7,"ا",1,0],["إِلياسُ كُن في ضَمانِ اللَهِ وَالذِمَمِ","ذا مُهجَةٍ عَن مُلِمّاتِ النَوى حَرَمِ",8,"م",1,1],["اليَأسُ أَلزَمَني مَحَلَّ القاعِدِ","إِذ لَيسَ جَدّي في الجُدودِ بِصاعِدِ",9,"د",1,0],["اليأس بالأمس من بغداد أخرجني","واليوم جاء إلى بيروت بي الأمل",10,"ل",1,0],["إِلْيَاسُ مِنْ آلِ نَصْرٍ قَضَى","إِلَى الأَعِزَّاءِ نَعْيُ مَنْ نَعَى",11,"ع",2,1],["إِلَى اسْمِ طَلْعَتِ حَرْبٍ","أَضَفْتَ فَخْراً جَدِيدَا",12,"د",2,0],["إِلْيَاسُ دُمْ وَبَدِيعَةٌ","مَثْلَى مُصَافَاةٍ وَبِرْ",13,"ر",1,1],["إلْيَاسُ يَا ابْنَ سَلِيمٍ أَيُّ مَفْخَرَةٍ","كَأَنْ تَكُونَ لَهُ فِي قَوْمِهِ خَلَفَا",14,"ف",2,1],["إِلَى أُسْتَاذِنَا الْعَلَمِ الجَلِيلِ","تَوَلَّيْ يَا تَحِيَّاتِ الخَلِيلِ",15,"ل",1,1],["الْياسُ أَثثَ جَدّاً","قَدْ سَرَّنَا ذَاكَ جِدَّا",16,"د",2,1],["اليأسُ أطعَمَ بالأشْلاءِ مِقصَلةً","عَدْلاً وطوَّحَ \" بالبستيل \" فاقتَلَعا",17,"ع",2,0],["اليأس في أجفانها والمنى","والضحك في ألحانها والأنين",18,"ن",1,0],["اليَأسُ مِن طولِ الثَواءِ رَواحُ","وَالمُكثُ فيهِ تَثَبُّتٌ وَنَجاحُ",19,"ح",1,1],["إلياسُ قبلَك كَفَّها","والأرضُ كانت ظاميه",20,"ي",2,0],["الياسُ عسَّافُ لم تبرح روائعهُ","نفحاً من الفنّ في نفحٍ من الدين",21,"ن",1,1],["إلى أُسرةٍ لا يأكل الضيمُ جارَهم","وإن هو أثرى في ذَراهم وأسمنا",22,"ن",2,0],["اليأسُ أروحُ لي والصبرُ أرفقُ بي","من نومِ ليلكِ عن همّي وتسهيدي",23,"د",2,0],["إلى إسماعيل أشواقي","تزيد على مدى الزمن",24,"ن",1,0],["آل ياسين وَمَنْ فَض","لُهُم أَعيا اللّبيبا",25,"ب",2,0],["إلى أسعد العرفانُ عن خير والد","سرى وعن الاجداد من قدم المدى",26,"د",2,0],["الياس صار العيش بعدك في شقا","قد جل عن وزن وعن مقياس",27,"س",1,0],["الياس هل من نظرة فالقلب في","كأب ودمع العين في احلاس",27,"س",1,0],["إلياس أنك نابه وأديب","وبكل فنّ حاذق وأريب",28,"ب",1,1],["الياس طاب به نفساً فأرخه","ها فلادمير ابشروا باليمن ضاء لنا",29,"ن",2,0],["اليأس كل اليأس من هذا الورى","فبهِ اللبيبُ ينال راحة لبّهِ",30,"ب",2,0],["إلى أسد الدين الذي دون غابه","كواعب أطراف الوشيج الممدد",31,"د",1,0],["أَليَأسُ عِزٌّ وَالذِلَّةُ الطَمَعُ","يَضيقُ أَمرٌ يَوماً وَيَتِّسِعُ",32,"ع",1,1],["أَليَأسُ مالي وَجُنَّتي كَرَمٌ","وَالصَبرُ والٍ عَلَيَّ لا الجَزَعُ",32,"ع",1,0],["الياسَمينُ المندّى","وَالوَردُ في الوَجنَتينِ",33,"ن",1,0],["الياس طب نفساً فنجلك حظه","بالسعد طول زمانه معقود",34,"د",1,1],["إلى أسوان أزمعت الرحيلا","أشاهد ذلك العمل الجليلا",35,"ل",2,1],["اليَأسُ خَيرٌ وَما لِلناسِ مِن ثَمَرٍ","هاتِ اِمرَءاً ذَلَّ بَعدَ اليَأسِ لِلناسِ",36,"س",1,0],["اليأس داء عسيف","والبرء منه عسير",37,"ر",1,0],["إلى أسرة لا يجهل الناس","قدرها ويحمد بين العالمين فعالها",38,"ل",3,0],["اليأس رائدها وتلك مشيئة","للدهر لانقض ولا ابرام",39,"م",1,0],["الياس يبعث في النُفوس عقاربا","تَقضي عليها بِما لديك من الحيل",40,"ل",1,0],["إلي أسروا بسيارٍ نظيرك ذي","قدٍّ وحسن وعقل نادر المثل",41,"ل",1,0],["اليأس مدرجة النفوس إلى الردى","والمرء مفقود بفقد رجائه",42,"ا",3,0],["اليأس أسلى وأغنى","من نيل ما يتمنى",43,"ن",2,1],["اليأس وردي إذا سحبُ المنى هطلت","والصبر زادي إذا أهل الحمى بانوا",44,"ن",3,0],["الياس شحود إلى دار البقا","ولي فاحرز في السماء نعيما",45,"م",2,1],["اليَأْسُ مِنْ طولِ البَقَاءِ هَنََاءُ","والرَّكْضُ خَلْفَ الفانَِيَاتِ بَلاءُ",46,"ا",2,1],["اليأس لو الله جل جلاله","قد كاد يطمس ليله الأنوارا",47,"ر",2,0],["اليأسُ نازلني على أملٍ","أشهرتُ حُلْميَ كاشفاً صدرا",48,"ر",2,0],["اليأسُ ينمو على أرجاء فاتنتي","يلفُّ زهرَ المنى غابٌ وزُمّارُ",49,"ر",1,0],["اليَاسَمِيْنُ يَضُوعُ الْحُلْمُ مِنْ فَمِهِ","فِيْ مَوْجَةِ اللونِ وَالسَّاعَات وَالْفَلقِ",50,"ق",1,0],["الْيَاسَمِيِنُ صَفَاءُ قَلْبِكِ لَوْنُهُ","يَا رَوْعَةَ الأَلْوَانِ فِي مِصْفَاتِهَا",51,"ت",3,0],["اليأس عنصره وشكل كيانه","ما بين أشفار الظبا وفعالها",52,"ل",3,0],["الياس يرمي .. أسود الهم .. بحشاي","والحلم بيدي .. / لليالي / .. رميته !!",53,"ت",2,0],["اليأس يملأ قلبه فيميته","ويد الرجاء تعوده فتؤاسي",54,"س",2,0],["الياس فيني هز نفسي وغلبها","وانا اللي أمعلق قلبه ومقضوب",55,"ب",1,0],["اليأس قال أبي إن حلَّ في وطنٍ","فلنْ يُحقِّقَ مهما حاولَ الحُلُما",56,"م",2,0],["الياسمين بليله متيقظ","ورحيق أنجم خاطري بإنائهِ",57,"ا",3,0],["اليأسُ ينهشُ منهم كلَّ إمَّعةٍ","ويدعَسُ الخوفُ مَن تهوي به الرُّكَبُ",58,"ب",1,0],["اليَأْسُ شَرَّدَهُمْ فاحتارَ مَقْصِدُهُمْ","\"ما أَضْيقَ العَيْشَ\" إِنْ زلَّتْ بِنا القَدَمُ",59,"م",1,0],["الياس جمره تشتعل داخل الجوف","والعجز يدفع داخل الجمر وقاد",60,"د",1,1],["اليأسُ يزرعُ بالنفوسِ مواجعٌ","والعجزُ يخطِفُ وارفَ البسماتِ",61,"ت",1,0],["الياسمينُ يُثيرُ وجْدي والهوى","يخضرُّ إذْ يتفتّحُ القدّاحُ",62,"ح",1,0],["الياس لا يبعدك يا ذرب الافعال","اتعب قدم رجلك على ما شتهتها",63,"ت",3,0],["الياس أثلث جدا","قد سرنا ذاك جدا",64,"د",2,1],["أليأس منهكة للقوم موبقة","في حماة تتلائشى عندها الشيم",65,"م",1,0],["الياسمينُ بكى رفيقَ دروبه","والأوفياءُ بحبّهم أبرارُ",66,"ر",1,0],["اليأس ينهش -جائعاً- أحلامه","والنار تأكل روحه بروية",67,"ي",2,0],["الياسمينة عقلها أضحى بلا‎","زهر جميل بالبراءة سادا‎",68,"د",2,0],["اليَأْس ينمو في اضطرادٍ دائم","مقدار دفق الظّلم حتى نستكينْ",69,"ن",1,0],["اليأس عشَّش في ذات الصدور فهل","مِن أي صوت عروبيٍّ يُبَشّرني؟",70,"ن",2,0],["الياسمينةُ ليس تكره شوكَها","وتظل تسقي قلَبه الحجريا",71,"ي",2,0],["اليَأسُ فَتَتَ مُهْجَتِي وَفُؤادِي","وَطَغَى عَلَى الأَمَلِ القَرِيبِ سَوَادِي",72,"د",2,1],["اليأس يسبح في النفوس ويرتوي","من كل نبع في الجمود ويستوي",73,"و",2,1]]}