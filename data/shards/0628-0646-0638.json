{"poems":[[110,"حتام يا قلب","https://www.shoaraa.com/p11133",""],[95,"وافى الكتاب فأحيا","https://www.aldiwan.net/poem9828.html","عموديه"],[90,"حي هل يا أخا مصر","https://www.aldiwan.net/poem44435.html","مجزوء الخفيف"],[53,"رمين فؤادي من عيون الوصاوص","https://www.aldiwan.net/poem64935.html","الطويل"],[53,"يا كريما لم يزل محتمِا","https://www.aldiwan.net/poem66525.html","الرمل"],[63,"ألبرق سرى بأعلى البراق","https://www.aldiwan.net/poem51520.html","الخفيف"],[35,"ألا يا غرابا صاح من نحو أرضها","https://www.aldiwan.net/poem25778.html","الطويل"],[48,"أعكرم إن غنيت ألفيت نادبا","https://www.aldiwan.net/poem23341.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85388","البسيط"],[128,"وهمت فليس ما سمي","https://www.aldiwan.net/poem23710.html","الهزج"],[264,"رفع الآله مقام إبراهيما","https://www.aldiwan.net/poem35741.html","الكامل"],[276,"أعلمت من ركب البراق عتيما","https://www.aldiwan.net/poem52097.html","الكامل"],[366,"بنظمك هذا العلم زاد ابتهاجه","https://www.aldiwan.net/poem68127.html","الطويل"],[369,"حيتك غادية الحيا من مربع","https://www.aldiwan.net/poem60850.html","البسيط"],[409,"كل أخبار الهوى قد رويت","https://www.aldiwan.net/poem34111.html","الرمل"],[415,"علقت هواكم في بلهنية الصبا","https://www.aldiwan.net/poem31655.html","عموديه"],[520,"إن كنت أزمعت على المسير","https://www.aldiwan.net/poem12128.html","الرجز"],[543,"حبيبة بحبها الحسن أمر","https://www.aldiwan.net/poem48126.html","عموديه"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122306","الرجز"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38209","الرمل"],[886,"","https://poetry.dctabudhabi.ae/diwan/poem/203593","المتقارب"],[949,"","https://poetry.dctabudhabi.ae/diwan/poem/124748","الرجز"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100149","الكامل"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87870","الطويل"],[1892,"","https://poetry.dctabudhabi.ae/diwan/poem/96210","الكامل"],[2038,"","https://poetry.dctabudhabi.ae/diwan/poem/123687","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93651","الكامل"],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84512","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76023","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201943","الوافر"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115533","المنسرح"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134065","الوافر"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132679","السريع"],[3341,"","https://poetry.dctabudhabi.ae/diwan/poem/139075",""],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68005","البسيط"],[3452,"","https://poetry.dctabudhabi.ae/diwan/poem/28871","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88980","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89361","الوافر"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118002","الرمل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125805","الكامل"],[4234,"","https://poetry.dctabudhabi.ae/diwan/poem/203443","الطويل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117246","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139669",""],[5057,"لكل حادثةٍ حديثُ","https://www.poetsgate.com/ViewPoem.aspx?id=197235",""],[5397,"أيرمي سواد الليل عيني بالغمض","https://www.poetsgate.com/ViewPoem.aspx?id=157930",""],[5431,"وبعض الشعر أخلطه بجمري!!","https://www.poetsgate.com/ViewPoem.aspx?id=186750",""],[6090,"بدت لنا بمحيا أخجل البدرا","https://www.poetsgate.com/ViewPoem.aspx?id=170914",""],[6102,"قبلة الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=184634",""],[6277,"توبة عن التوبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64442&r=&rc=1",""]],"verses":[["بنظرةٍ أحرمت للطف تلبية","من الحجاز على عهدٍ له برموا",0,"م",3,0],["بِنَظْرَةٍ مِنْ صَدِيقٍ","عَنْ أَعْيُنِي مَحْجُوبِ",1,"ب",1,0],["بنظام هو النهى","وحروف هي الدرر",2,"ر",1,0],["بنظمي لك الدرّ الثمين قلائداً","وغوصي عليه في عميق المغاوص",3,"ص",1,0],["بنظير الشمس والبدر الذي","زانه اللَّهُ بمنفوس الزِّين",4,"ن",1,0],["بِنظامٍ واهي القُوى مُستَحيلٍ","لم يَرُضْهُ رياضَةَ الحُذَّاقِ",5,"ق",1,0],["بِنَظرَةِ أَقنى الأَنفِ أَمسى وَدونَهُ","مُتالِفُ تُهوي الطَيرَ غَيرُ دَواني",6,"ن",2,0],["بِنَظمٍ شَجا في الجاهِليَّةِ أَهلَها","وَراقَ مَعَ البَعثِ الحَنيفَ المُخَضرَما",7,"م",2,0],["بنظرة كانَت اِختلاسا","أحبها كاعباً رداحا",8,"ح",2,0],["بنظرة شبه حسناء","تطلع في محيانا",9,"ن",2,0],["بنظام دولته السعيدة من غدت","عقداً فريداً بالسعود نظيما",10,"م",2,0],["بنظام نثر كالجواهر فصلا","أهديه من نيابَتي برع الى",11,"ل",2,0],["بِنُظمك هذا العِلم زادَ اِبتَهاجَه","وَمِن ذِهنِكَ الوَقاد ضاء سَراجُه",12,"ج",2,1],["بنظامِ دينِ اللهِ والمُلْكِ الّذي","ما دامَ حامي سِلْكِه لم يُقْطَع",13,"ع",1,0],["بنظام لم يدعني زمني","أصطفي أبياته إذ بنيت",14,"ت",1,0],["بنظرة عين أو برد تحية","ألذ من الماء الزلال على الظما",15,"م",2,0],["بنظرة في هذه الأمور","واغضب وقل يا نار غيظي فوري",16,"ر",2,0],["بِنظرةٍ إليكِ أغنَت فَقري","ألحُسنُ شيءٌ ما لَه مثيلٌ",17,"ل",1,0],["بنظرة جالبة الوداد","ودعوة قامعة الفساد",18,"د",1,0],["بِنِظامٍ يَزدَري زَهرَ الرّبيع","وَاِمتِداحٍ بِالجَمالِ المُعتلي",19,"ي",1,0],["بنظمٍ رقيق رشيق إلى","جميع القلوب الرقاق اقترب",20,"ب",1,0],["بنظرة اليك أغنت فقري","يا حاضرا في القلب لا يغيب",21,"ب",1,0],["بنظام عقد فرائد","تأريخها العقد المنظم",22,"م",1,0],["بنظارة الأَوهام عشقٌ مكبَّرٌ","وعينُ الحجا كنهاً تراهُ مصغّرا",23,"ر",2,1],["بنظام لفظ كالثغور","وكالعقود على النحور",24,"ر",1,0],["بنظم كسلك الدرّ بل هو جوهر","يلوح على القرطاس من رصفه أضوا",25,"و",2,0],["بِنَظيرها مِن قَبل ألا يُوشع","يا مَن بِكُل عويصة هُوَ ممتحن",26,"ن",1,0],["بنظمى وَنثرى أَبتَغي شكر فضله","عَلىّ لأن الشكر أَسى المَكاسِب",27,"ب",1,0],["بِنظمٍ كَزُهرٍ في المَجرة سُبَّحٍ","وَنَثرٍ كَزَهرٍ غبَّ أَو كَف مُغدِقِ",28,"ق",1,0],["بنظم الشعر أُنقص من وجودي","ولكني أُزيدُ به الوجودا",29,"د",2,0],["بنظرةُ لم أزل بها قلقا","قلبٌ كئيبٌ ومدمَعٌ يجري",30,"ر",2,0],["بنظمك صغتَ يا ذا الفضل لغزا","بمجدك قد بدا سامي المقام",31,"م",1,1],["بنظم عصر النور في عهدهم","من ظلمة الظلم بديع الطباق",32,"ق",1,0],["بنظم لا مخلٍ بالمعاني","ولا بسط فيورثكم ملالا",33,"ل",2,0],["بنظرةٍ من مليكٍ لا نظيرَ لَهُ","يظَلُّ منه الدجى والصبحُ فِي سَهَد",34,"د",1,0],["بِنَظرَةِ أَزرَقَ العَينَينِ بازٍ","عَلى عَلياءَ يَطَّرِدُ اليَفوعا",35,"ع",2,0],["بنظم لآل منه تصفر خجلة","دراري عقود لو تبدى وتغرب",36,"ب",1,0],["بنظم فوق صدر الفضل عقدٌ","ونثر ذاك منه النيران",37,"ن",1,0],["بنظام ينثر الهام إذا","هاجت الهيجاء عن أبدانها",38,"ن",3,0],["بنظامه وجنوده وعتاده","رمز المنى ونهاية المأمول",39,"ل",1,0],["بنظمٍ سمَا قدراً ودار بخمرة","فدع عنك ثغراً للملاح شنيبا",40,"ب",2,0],["بنظرة منك يا مُنائي","تسعد آمالي السعود",41,"د",1,0],["بنظم لجيد النظم در قلائد","ونثر لهام المجد تاجق وللفخر",42,"ر",1,0],["بنظرةِ شاردٍ علّقتَ قلبي","وها أنتَ الغداةَ بهِ تعيثُ !!",43,"ث",1,0],["بنظم ثنائي اقرض الله فيهما","فيربح فيه العمر في ساعة القرض",44,"ض",1,0],["بنظرته جنان الروض تسري","وتغمرني الزهور بكل شبرِ",45,"ر",1,0],["بنظرة سحرت قلب الخلى فهل","هارون من مقلتيها حصل السحرا",46,"ر",2,0],["بِنَظرَةِ عَينَيها سَقَتْنِي خُمُورَها","كُؤُوسَ غَرامٍ فَعَّ مِنها ذُكاؤُها",47,"ا",3,0],["بنظرة شبه حسناء تطلع في محيانا","فهل وبهذه الأسعار شارية \" بعمانا \" ؟",48,"ن",2,0]]}