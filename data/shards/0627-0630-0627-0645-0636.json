{"poems":[[55,"هو الدهر فينا خليع اللجام","https://www.aldiwan.net/poem29771.html","المتقارب"],[55,"إذا مضى يوم على هدنة","https://www.aldiwan.net/poem30674.html","السريع"],[65,"أهاجك شوق بعدما هجع الركب","https://www.aldiwan.net/poem46205.html","الطويل"],[32,"خليلي لا ربع بوهبين مخبر","https://www.aldiwan.net/poem29588.html","الطويل"],[74,"مبلبل الأصداغ والطره","https://www.aldiwan.net/poem18697.html","السريع"],[74,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[40,"على الدار بالرمانتين تعوج","https://www.aldiwan.net/poem7693.html","الطويل"],[87,"وإن موليير نجم لا أفول له","https://www.aldiwan.net/poem7042.html","البسيط"],[45,"عقبى اليمين على عقبى الوغى ندم","https://www.aldiwan.net/poem10529.html","البسيط"],[47,"أبلغ لديك عبيد الله مألكة","https://www.aldiwan.net/poem63449.html","البسيط"],[30,"إذا زخرت قيس وخندف والتقى","https://www.aldiwan.net/poem5516.html","الطويل"],[30,"أهاج لك الشوق القديم خياله","https://www.aldiwan.net/poem5604.html","الطويل"],[63,"أعاذل إن النائبات بمرصد","https://www.aldiwan.net/poem51707.html","الطويل"],[71,"إذا مضى للمرء من عمره","https://www.aldiwan.net/poem28705.html","السريع"],[50,"إذا مضى من رمضان النصف","https://www.aldiwan.net/poem64397.html","الرجز"],[48,"مطيتي الوقت الذي ما امتطيته","https://www.aldiwan.net/poem23497.html","الطويل"],[164,"في الله سبحانه عمن مضى خلف","https://www.aldiwan.net/poem58711.html","البسيط"],[164,"ما الفخر في الطعن بالعسالة الذبل","https://www.aldiwan.net/poem58998.html","البسيط"],[186,"بعزمك لذ إذا عز النصير","https://www.aldiwan.net/poem67071.html","الوافر"],[347,"قلبي يحدثني","https://www.aldiwan.net/poem55325.html","منهوك البسيط"],[463,"طاف عليه بالرقمتينِ","https://www.aldiwan.net/poem55834.html","مخلع البسيط"],[463,"أروم الوفاء الصعب بالمطلب السهل","https://www.aldiwan.net/poem56064.html","الطويل"],[463,"أمن أسماء والمسرى بعيد","https://www.aldiwan.net/poem56226.html","الوافر"],[466,"حماك حمى الرحمن من كل حادث","https://www.aldiwan.net/poem16151.html","الطويل"],[520,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[567,"يا أيها الناس هذا مولد القمر","https://www.aldiwan.net/poem52829.html","البسيط"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25308","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46539","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69419","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/141734","الطويل"],[2660,"","https://poetry.dctabudhabi.ae/diwan/poem/203396","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117844","الطويل"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75680","البسيط"],[5376,"أذاك من شفقٍ أم حُمْرةِ القبلِ","https://www.poetsgate.com/ViewPoem.aspx?id=203505",""],[5399,"يرى مآخير ما يبدو أوائله","https://www.poetsgate.com/ViewPoem.aspx?id=181166",""]],"verses":[["إِذا مُضَرٌ ظَلَّلَتني القَنا","وَسالَت قَبائِلُها مِن أَمامي",0,"م",2,0],["إِذا مَضى يَومٌ عَلى هِدنَةٍ","وَأَنتَ في سِلمٍ مِنَ النائِبات",1,"ت",1,1],["إذا مَضَغَتْ غِبَّ الكَرى عُودَ إسْحِلٍ","وفاخَ عَلِمْنا أنّ مَشْرَبَهُ عَذْبُ",2,"ب",1,0],["إِذا مُضَرُ الحَمراءُ عَبَّ عُبابُها","فَمَن يَتَصدَّى مَوجَها حِينَ تَطحَرُ",3,"ر",1,0],["إذا مضى في الدرعِ إفرنده","عجبت للمرِّيخ في النثره",4,"ر",2,0],["إذا مضت جملتها المعترضه","تواصلت خيوطها المنقرضه",5,"ه",1,0],["إِذا مَضَغَت مِسواكَها عَبِقَت بِهِ","سُلافٌ تَغالاها التِجارُ مَزيجُ",6,"ج",1,0],["إذا مضى يعرض الأخلاق عارية","أراك من كل نفس صورة عجبا",7,"ب",2,0],["إِذا مَضى عَلَمُ مِنها بَدا عَلَمٌ","وَإِن مَضى عَلَمٌ مِنهُ بَدا عَلَمُ",8,"م",1,0],["إِذا مَضى اليَومُ لا نَلقاهُ فيهِ مَضى","سُرورُنا وَتَرَقَّبنا مَجيءَ غَدِ",9,"د",1,0],["إِذا مُضَرُ الحَمراءُ حَولي تَعَطَّفَت","عَلَيَّ وَقَد دَقَّ اللِجامَ شَكيمي",10,"م",2,0],["إِذا مُضَرُ الحَمراءُ يَوماً تَعَطَّفَت","عَلَيَّ وَقَد دَقَّ اللِجامَ شَكيمي",11,"م",2,0],["إذا مضى يومٌ من العيشِ صَالحٌ","فَصِلْهُ بيومٍ صالحِ العيشِ مُرغِدِ",12,"د",1,0],["إذا مضى للمرءِ مِنْ عمرِهِ","خمسونَ عاشَ العيشةِ السيئهْ",13,"ه",1,1],["إِذا مَضى مِن رَمَضانَ النِصفُ","تَشَوَّقَ القَصفُ لَنا وَالعَزفُ",14,"ف",1,1],["إِذا مَضَيا لَم يَرجِعا وَتَلاهُما","نَظيرانِ بِالمُستَودَعاتِ يُلِطّانِ",15,"ن",1,0],["إذا مضى معشرٌ أنشأت غيرهم","هذا يجيء وهذا عنك منصرفُ",16,"ف",1,0],["إذا مضى ملك منا بدا ملك","من نسله غير رعديد ولا وكل",17,"ل",1,0],["إِذا مَضَتِ الحَياةُ عَلى رُقادٍ","تَشابَهَتِ المَضاجعُ وَالقُبورُ",18,"ر",1,0],["اذا مضت نوب","حاقت به نوب",19,"ب",1,0],["إذا مضى في وغىً وشُورَى","نزا فقدَّ الضريبتينِ",20,"ن",1,0],["إذا مضغ الأعراضَ كان عدوُّه","ومولاه في فيه خليقين بالأكلِ",21,"ل",1,0],["إذا مُضَرٌ تَطَامَنَ كلُّ بيتٍ","لها وعلا بربوتها الصعيدُ",22,"د",1,0],["إذا مُضَرُ الحمراءِ مَدَّ أتِيُّها","فخِنْدِفُها آذِيُّهُ وغَوارِبُهْ",23,"ب",2,0],["إذا مضى كافل فهذا كفيل","أو وزير ولى فهذا وزير",24,"ر",1,0],["إذا مَضَى كوكبٌ منها أتى قَمَرٌ","وإن مَضَى قَمَرٌ فالشَّمسُ في الأثَرِ",25,"ر",1,0],["إِذَا مَضَى نَهْب أَعَدْتَ نَهْبا","تُنْزِلُ رَكْباً وَتُؤَدِّي رَكْبا",26,"ب",2,0],["إِذا مَضى الأَعيان","وَذَهَبَ الأَقران",27,"ن",1,0],["إذا مضاف الجملة الفعليّة","والفعل منويّ مع الاسميّه",28,"ه",1,0],["إِذا مُضَرٌ طالَت بِذِكراك أَشرَفَت","عَلى الناسِ إشرافَ الذُرى مِن يَلَملَمِ",29,"م",1,0],["إذا مضمض الإنسان فاه ولم يكن","بريّا من الدعوى وفتيا بما ادّعى",30,"ا",1,0],["إذا مَضَغَ الإنسانُ مِنْهُ وُرَيْقَةً","تَقَلَّبَ في فِيهِ عَقِيقاً وياقُوتا",31,"ت",2,0],["إذا مضت العشرون من رمضانه","تصدّع فيها كل قلب تذكرا",32,"ر",2,0],["إِذا مَضى الفحل منهم قامَ يخلفه","فحل إِذا صال عاد البر مضطَرِبا",33,"ب",2,0],["إذا مضيت بهذا الوجد أزمنةً","أعاد بي الشوق من أيامه الأولِ",34,"ل",1,0],["إذا مضى العزم لم ينكث عزيمته","ريب ولا خيف منه نقض ما فتلا",35,"ل",2,0]]}