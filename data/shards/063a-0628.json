s://poetry.dctabudhabi.ae/diwan/poem/94785","الرمل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73284","الرمل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83663","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83588","الخفيف"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66149","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58116","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33306","الرجز"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120200","الكامل"],[4691,"توضأ قلبي بماء الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=59823",""],[4755,"لم يَجئْ بَعدُ مَوطني كي يَرُوحا","https://www.poetsgate.com/ViewPoem.aspx?id=187862",""],[4858,"شوق وحنين إلى فلذات كبدي","https://www.poetsgate.com/ViewPoem.aspx?id=33747",""],[4869,"نغمة الموبايل","https://www.poetsgate.com/ViewPoem.aspx?id=151536",""],[4869,"ارفعي خشم قلبك","https://www.poetsgate.com/ViewPoem.aspx?id=151713",""],[4883,"قرية سمراء","https://www.poetsgate.com/ViewPoem.aspx?id=48355",""],[4883,"عتب","https://www.poetsgate.com/ViewPoem.aspx?id=48362",""],[4883,"من يوم حبيتك","https://www.poetsgate.com/ViewPoem.aspx?id=48358",""],[4929,"غثاء الحداثة","https://www.poetsgate.com/ViewPoem.aspx?id=208719",""],[3271,"دمعة وفاء","https://www.poetsgate.com/ViewPoem.aspx?id=104119",""],[585,"أتطوي الليل تهتف بالنشيد","https://www.poetsgate.com/ViewPoem.aspx?id=161881",""],[5092,"بعض الحكايا","https://www.poetsgate.com/ViewPoem.aspx?id=163045",""],[5183,"لن تراني","https://www.poetsgate.com/ViewPoem.aspx?id=180161",""],[5277,"صريخُ الشوقِ","https://www.poetsgate.com/ViewPoem.aspx?id=206801",""],[5296,"وحدي أنا","https://www.poetsgate.com/ViewPoem.aspx?id=155353",""],[5307,"","https://www.poetsgate.com/ViewPoem.aspx?id=10549",""],[5387,"وقفة مع الذات","https://www.poetsgate.com/ViewPoem.aspx?id=53778",""],[5408,"عروبيٌّ صوتي","https://www.poetsgate.com/ViewPoem.aspx?id=190873",""],[5410,"رسالة الغفران","https://www.poetsgate.com/ViewPoem.aspx?id=133058",""],[5410,"أيها الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=144511",""],[5411,"لا تَسْتَهِنْ بِعَواطِفي","https://www.poetsgate.com/ViewPoem.aspx?id=186124",""],[5411,"أنْتَ وحْدُكَ","https://www.poetsgate.com/ViewPoem.aspx?id=191863",""],[5413,"أيها الحاضر المنسي","https://www.poetsgate.com/ViewPoem.aspx?id=208594",""],[5431,"هذا بعلي!!....","https://www.poetsgate.com/ViewPoem.aspx?id=201150",""],[5431,"أغنية الخليج 3","https://www.poetsgate.com/ViewPoem.aspx?id=202771",""],[3294,"يا راكب الجسرة للجسر","https://www.poetsgate.com/ViewPoem.aspx?id=173269",""],[5495,"مو جيتك","https://www.poetsgate.com/ViewPoem.aspx?id=175438",""],[5582,"أَبْدَلَتْهُ النَّوَى بَعْدَ خُرَّدِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=186882",""],[5616,"عدنا","https://www.poetsgate.com/ViewPoem.aspx?id=203479",""],[5616,"حرص","https://www.poetsgate.com/ViewPoem.aspx?id=207652",""],[2110,"غاض صبري والهوى قد بلغا","https://www.poetsgate.com/ViewPoem.aspx?id=156281",""],[5652,"ياغايبه عن شوف عيني فقدتك","https://www.poetsgate.com/ViewPoem.aspx?id=135934",""],[5776,"الجبينُ والمخدة","https://www.poetsgate.com/ViewPoem.aspx?id=199341",""],[5830,"كل الشرائع في محرابك اجتمعت","https://www.poetsgate.com/ViewPoem.aspx?id=204642",""],[5838,"دع الصب يصلى بالأذى من حبيبه","https://www.poetsgate.com/ViewPoem.aspx?id=200856",""],[5851,"ويهتفون بحياة الرداءة","https://www.poetsgate.com/ViewPoem.aspx?id=175276",""],[5885,"حلمي","https://www.poetsgate.com/ViewPoem.aspx?id=195058",""],[5956,"غبي أنت","https://www.poetsgate.com/ViewPoem.aspx?id=193529",""],[5970,"آه لو كانت تفيد النفس آه","https://www.poetsgate.com/ViewPoem.aspx?id=130619",""],[5970,"تمجلت في عهد الشباب إلى القبر","https://www.poetsgate.com/ViewPoem.aspx?id=130674",""],[6152,"غب ما تشاء","https://www.poetsgate.com/ViewPoem.aspx?id=203015",""],[6152,"ولاّدة العصر","https://www.poetsgate.com/ViewPoem.aspx?id=203139",""],[5309,"ليس من يدعو الى ال","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573821",""],[6255,"الحُزْنُ جَادَ أَبًا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80883&r=&rc=11",""],[572,"من لِذَاك الطبرزدِ المدقوقِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9412&r=&rc=269",""]],"verses":[["غَباوَةُ هاجِرِ الدُنيا وَكَيدٌ","وَلا كَيدُ الفَواجِرِ وَالبَغايا",0,"ا",3,0],["غِبتُ وَشَوقي عِندَها حاضِرٌ","شَيَّعَهُ القَلبُ وَراءَ الحَريم",1,"م",1,0],["غُبِقَتْ حواشي التُّرْبِ منْ أمْواهِهِ","راحاً تَصوغُ حَبابَها الغُدْرانُ",2,"ن",1,0],["غبت عن قصدي ! .. رفيقي غائب","من ليال ، رأيه في الحبس (جهمي)",3,"م",2,0],["غِبتُم وَغِبنا فَلَمّا كانَ أَوبُكُمُ","أُبنا فَنَحنُ وَأَنتُم رَهنُ أَسفارِ",4,"ر",1,0],["غِبْتَ فَلاَ عَيْنٌ وَلاَ مَخْبَرٌ","وَلاَ انْتِظَارٌ مِنْكَ مَرْقُوبُ",5,"ب",1,1],["غَبراءَ خاضِعَةِ الصُوى جاوَزتُها","لَيلاً بِكاتِمةِ السُرى مِذعانِ",6,"ن",1,0],["غبطنا ميتة قد أعقبتكم","حياةً ليس يدركها الفناء",7,"ا",2,0],["غِبنا فَلَم نَشهَد بِبَطحاءِ مَكَّةٍ","دُعاءَ بَني كَعبٍ تُحَزُّ رِقابُها",8,"ب",3,1],["غبتمْ فغابتْ مسرَّاتُ القلوبِ فلا","أنتم بزعمي ولا تلك المسرَّات",9,"ت",1,0],["غِبتَ وَما غِبتَ عَن ضَميري","فَما زَجَت تَرحَتي سُروري",10,"ر",2,1],["غِبت فغاب النوم عن ناظري","وسامني طيفُك هِجرانا",11,"ن",2,0],["غِبتَ عَنّي وَجَرَت بَع","دَكَ وَاللَهِ قَضايا",12,"ا",3,0],["غِبتُم فَما لِيَ مِن أُنسٍ لِغَيبَتِكُم","سِوى التَعَلُّلِ بِالتَذكارِ وَالأَمَلِ",13,"ل",1,0],["غِبتَ عَنّي فَما الخَبَر","ما كَذا بَينَنا اِشتَهَر",14,"ر",1,1],["غَبراءَ يَهماءَ يَخشى المُدلِجونَ بِها","زيغَ الهُداةِ بِأَرضٍ أَهلُها شِيَعُ",15,"ع",1,0],["غِبَّ عَيشٍ بِها غَريرٍ وَكانَ ال","عَيشُ في عَهدِ تُبَّعٍ أَفياءَ",16,"ا",2,0],["غِبتُ عَنهُ فَغابَ عَنّي سُروري","إِنَّما يَجمَعُ السُرورَ مَعانُه",17,"ن",2,0],["غَبينَةٌ سُمتَنيها لَو سَمَحتُ بِها","يَوماً لَأَكفَلتُها لَخماً وَغَسّانا",18,"ن",2,0],["غَبَنَتني الأَيّامُ عَقلي وَمالي","وَشَبابي وَصِحَّتي وَفَراغي",19,"غ",2,0],["غِب عَنِ الهَمِّ يَصفُ عَيشُكَ يا صا","حِ وَلا تَنثَنِ إِلى الفُرّاغِ",20,"غ",1,0],["غَبَطَتهُ فيها الخَلائِقُ إِذ بِت","تُ وَدَهرُ مُصغٍ إِلَيَّ وَصاغِ",20,"غ",1,0],["غِبَّ النَعيمِ الَّذي مِن بَعدِهِ شَقِيَت","فَيا سَحاباً بِهِ كُلُّ الوَرى سُقِيَت",21,"ت",1,0],["غبتُ وجداً مِنْ حاضرٍ في سماعي","وكذا الدهرُ غيبةٌ وحضورُ",22,"ر",1,1],["غبْ عنِ النمّامِ واهجرْهُ فما","بلَّغَ المكروهَ إلاّ مَنْ نقلْ",23,"ل",1,0],["غِبْ وزُرْ غِبّاً تزدْ حباً فَمَنْ","أكثرَ التردادَ أضناهُ المللْ",23,"ل",1,0],["غَبَطتُ مسواكَ حِبي","فقال إني مفارِقْ",24,"ق",1,1],["غَبَرنا زَمانا بِاللِوى ثُمَّ أَصبَحَت","بِراقِ اللِوى مِن أَهلِها قَد تَخَلَّتِ",25,"ت",1,0],["غبينةٌ بُدّلت بخردها","أو الف الرحل من خواذلها",26,"ل",3,0],["غَبِيُّ العَينِ عَن طَلَبِ المَعالي","وَفي السَوآتِ شَيطانٌ مَريدُ",27,"د",1,0],["غَبَرتُ أَسيراً في يَدَيهِ وَمَن يَكُن","لَهُ كَرَمٌ تُكرَم بِساحَتِهِ الأَسرى",28,"ر",2,0],["غُبِقنا الأَذى وَالجاشِرِيَّةُ هَمُّنا","وَنادى ظَلامٌ لا سَبيلَ إِلى الجَشرِ",29,"ر",1,1],["غُبِنْتِ يا أيام لم يلتمسْ","عذركِ حتى المستضامُ الغبينْ",30,"ن",1,0],["غَبَرَتْ لتُبّعِ الهُمامِ ورأيُه","أنّ البقاءَ يَكونُ من أتْباعِها",31,"ع",3,0],["غَبَروا فأضْحتْ بالثّناءِ كَفيلةً","فمتى بَدَتْ أثْنَتْ على صُنَّاعها",31,"ع",3,0],["غبطتم صاحب الثرو","ة والزاهد لا يغبط",32,"ط",1,0],["غِبْتُمْ فَأَظْلَمَ يَوْمِي بَعْدَ فُرْقَتِكُمْ","وَسَاءَ صُنْعُ اللَّيَالِي بَعْدَ إِجْمَالِ",33,"ل",1,0],["غِبْتَ عَنِّي مَدَى ثَلاثٍ فَزَادَتْ","حَسَرَاتِي وَغَابَ أُنْسِي وَحَظِّي",34,"ظ",2,0],["غَبْنٌ عَلَى هَذِي العُيُو","نِ تُعَاضُ بِالتُّرْبِ اكْتِحَالاَ",35,"ل",2,0],["غُبِنْتْ فِي الْخِيَارِ غَبْناً جَسِيماً","لَكِنِ اعْتَاضَتِ اعْتِياضاً كَرِيما",36,"م",2,0],["غَبرَتْ وَقَائِعُ لَمْ تَكُنْ مُسْتَنْشَداً","فِيهَا وَلاَ اسْمُكَ مَالِيءَ الأَنْبَاءِ",37,"ا",2,0],["غُبارُ رحَى الهيجاء في لَهَواتِهم","من الشهْدِ أحْلَى أو من المسكِ أضْوَع",38,"ع",1,0],["غبتم ، فأظلم يومي بعد فُرقَتِكم","وساء صُنعُ الليالي بعد إجمالي",39,"ل",2,0],["غبرت بي في صباح باكر","فتنة العين وشغل الخاطر",40,"ر",1,1],["غَبْرَ حُبٍّ لسُلَيْمَى، لمْ يَزِدْ","فيهِ إسْعافٌ، وَلم يَنقُصْهُ ضَنّ",41,"ن",1,0],["غِبْتَ وما غبتَ عن ضميري","وصرْتَ فرحتي وسروري",42,"ر",2,1],["غب إلا إلى مليك السماء","الى من يزيده بالتَوَاه",43,"ا",2,0],["غِب ما كُنت 