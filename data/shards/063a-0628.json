{"poems":[[53,"أتذهل بعد إنذار المنايا","https://www.aldiwan.net/poem29623.html","الوافر"],[53,"لا عادت الكأس عليل النسيم","https://www.aldiwan.net/poem29774.html","السريع"],[63,"وله تشف وراءه الأشجان","https://www.aldiwan.net/poem46179.html","الكامل"],[55,"يا موقد النار بالهندي والغار","https://www.aldiwan.net/poem26369.html","البسيط"],[77,"غبت فلا عين ولا مخبر","https://www.aldiwan.net/poem36711.html","السريع"],[24,"بكرت علي بسحرة تلحاني","https://www.aldiwan.net/poem21887.html","الكامل"],[88,"قضوا شهداء ليس لهم بواء","https://www.aldiwan.net/poem45035.html","الوافر"],[23,"غبنا فلم نشهد ببطحاء مكة","https://www.aldiwan.net/poem21413.html","الطويل"],[72,"قضى وما قضيت منكم لبانات","https://www.aldiwan.net/poem18384.html","البسيط"],[64,"غبت وما غبت عن ضميري","https://www.aldiwan.net/poem67642.html","مخلع البسيط"],[51,"لم يبق لي صبر ولكنما","https://www.aldiwan.net/poem66695.html","السريع"],[70,"يا مليحا لي منه","https://www.aldiwan.net/poem42402.html","مجزوء الرمل"],[70,"عندي أحاديث أشواق أضن بها","https://www.aldiwan.net/poem42758.html","البسيط"],[70,"غبت عني فما الخبر","https://www.aldiwan.net/poem42903.html","مجزوء الخفيف"],[38,"عاد الهموم وما يدري الخلي بها","https://www.aldiwan.net/poem7725.html","البسيط"],[45,"يا أخا الأزد ما حفظت الإخاء","https://www.aldiwan.net/poem10196.html","الخفيف"],[45,"لاجديد الصبا ولا ريعانه","https://www.aldiwan.net/poem66799.html","البسيط"],[45,"أعن جوار أبي إسحاق تطمع أن","https://www.aldiwan.net/poem66813.html","البسيط"],[49,"أي عيش يكون أبلغ من عي","https://www.aldiwan.net/poem62174.html","الخفيف"],[66,"غير مجد مع صحة وفراغ","https://www.aldiwan.net/poem38483.html","الخفيف"],[66,"كان الزمان بلقياكم يمنينا","https://www.aldiwan.net/poem40132.html","البسيط"],[69,"غبت وجدا من حاضر في سماعي","https://www.aldiwan.net/poem28294.html","الخفيف"],[69,"اعتزل ذكر الأغاني والغزل","https://www.aldiwan.net/poem28334.html","الرمل"],[69,"غبطت مسواك حبي","https://www.aldiwan.net/poem28870.html","المجتث"],[33,"فما وجد أعرابية قذفت بها","https://www.aldiwan.net/poem25978.html","الطويل"],[75,"هل تملك الدار رجع سائلها","https://www.aldiwan.net/poem69023.html","البسيط"],[50,"أعادك طيفها وبما يعود","https://www.aldiwan.net/poem63923.html","الوافر"],[46,"يعلم إلهي يوجد الضعف شيمتي","https://www.aldiwan.net/poem22051.html","الطويل"],[46,"غبقنا الأذى والجاشرية همنا","https://www.aldiwan.net/poem22647.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39631","السريع"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16703","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147495","الهزج"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42731","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42681","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55125","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54674","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54272","الطويل"],[87,"الهجران","https://www.poetsgate.com/ViewPoem.aspx?id=14050",""],[96,"سارية الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=17505",""],[45,"قَلّمَا لا تَتَصَبّاني الدّمَنْ","https://www.poetsgate.com/ViewPoem.aspx?id=32010",""],[64,"غِبْتَ وما غبتَ عن ضميري","https://www.poetsgate.com/ViewPoem.aspx?id=8512",""],[51,"يا أخي يا أخا الدماثة والرقة","https://www.poetsgate.com/ViewPoem.aspx?id=25882",""],[107,"كبد من سنان لحظك جرحى","https://www.aldiwan.net/poem16239.html","الخفيف"],[107,"غب استلام مواطيء الأستاذ","https://www.aldiwan.net/poem16255.html","الكامل"],[107,"أحمد ابني إليك طال اشتياقي","https://www.aldiwan.net/poem16346.html","الخفيف"],[107,"غب لثم الشفاه موضع نعلي","https://www.aldiwan.net/poem16549.html","الخفيف"],[107,"غبت عن ذاتي فما شأن السوى","https://www.aldiwan.net/poem16674.html","الرمل"],[113,"مد من عينيك للقلب شرك","https://www.aldiwan.net/poem41101.html","عموديه"],[118,"أهواك والحب داء أيما داء","https://www.aldiwan.net/poem49314.html","البسيط"],[118,"يا أسفا للربيع يذهب بالورد","https://www.aldiwan.net/poem49327.html","المنسرح"],[158,"غبطت جوارحنا عليك الأعينا","https://www.aldiwan.net/poem58876.html","الكامل"],[158,"إذا ابطات عنا من المحسن الحسنى","https://www.aldiwan.net/poem59008.html","الطويل"],[158,"على من بالهدى يا ابن الإمامه","https://www.aldiwan.net/poem59206.html","الوافر"],[171,"أنكر العبد بزه وحلاه","https://www.aldiwan.net/poem4381.html","عموديه"],[184,"غبن الضرير من النذاله","https://www.aldiwan.net/poem43483.html","مجزوء الكامل"],[184,"سكنت إلى حسن التوكل والصم","https://www.aldiwan.net/poem43867.html","الطويل"],[193,"إن الخليط أجدوا البين فانقذفوا","https://www.aldiwan.net/poem54398.html","البسيط"],[195,"أشجى الرفاق تأوهي وتوجعي","https://www.aldiwan.net/poem39946.html","الكامل"],[219,"مولاي زغت عن الصواب","https://www.aldiwan.net/poem55269.html","مجزوء الكامل"],[250,"أما وجفونك المرضى الصحاح","https://www.aldiwan.net/poem1418.html",""],[252,"اُعف عني","https://www.aldiwan.net/poem24945.html","مجزوء الرمل"],[257,"غب دعاء عاطر","https://www.aldiwan.net/poem35755.html","مجزوء الرجز"],[257,"شنف السمع مطربا بالسماع","https://www.aldiwan.net/poem35817.html","الخفيف"],[257,"في المقادير تحكم الأقدار","https://www.aldiwan.net/poem35947.html","الخفيف"],[257,"في دياجي الحروف من كلماتك","https://www.aldiwan.net/poem35950.html","الخفيف"],[269,"حياك يا ربع ليلى كل هطال","https://www.aldiwan.net/poem52075.html","البسيط"],[280,"غبتم فلم يغب الغرام","https://www.aldiwan.net/poem32469.html","مجزوء الكامل"],[280,"غبتم فأوحشتم مذ غبتم الدارا","https://www.aldiwan.net/poem32774.html","البسيط"],[295,"سقى تلك الأباطح والرمالا","https://www.aldiwan.net/poem33190.html","الوافر"],[301,"لا قبلنا في ذا المصاب عزاء","https://www.aldiwan.net/poem58419.html","الخفيف"],[302,"كم بقلبي فيك من شجن","https://www.aldiwan.net/poem16838.html","المديد"],[362,"أحضر الليل منك عقدا وثغرا","https://www.aldiwan.net/poem60893.html","الخفيف"],[406,"أيا غائبا يدنيه شوقي على النوى","https://www.aldiwan.net/poem32328.html","الطويل"],[406,"لا غرو إن هجر الخيال الزائر","https://www.aldiwan.net/poem32484.html","الكامل"],[406,"يا نازحين واصطباري والأسى","https://www.aldiwan.net/poem32501.html","الرجز"],[436,"إن تفخر الدنيا فأنت فخارها","https://www.aldiwan.net/poem34810.html","الكامل"],[441,"وشب بأرض بوليفا","https://www.aldiwan.net/poem55925.html","عموديه"],[456,"طاف عليه بالرقمتينِ","https://www.aldiwan.net/poem55834.html","مخلع البسيط"],[456,"ذكر العيش بالحمى فبكى له","https://www.aldiwan.net/poem55940.html","الخفيف"],[456,"أمرتكم أمري بنعمان ناصحا","https://www.aldiwan.net/poem56253.html","الطويل"],[459,"بت حيث شئت ولا يرعك المنزل","https://www.aldiwan.net/poem16015.html","الكامل"],[459,"ولينة الأعطاف خوارة","https://www.aldiwan.net/poem16084.html","السريع"],[462,"غير سهل فيك يا لمياء حزني","https://www.aldiwan.net/poem3194.html","عموديه"],[462,"وأغن ساجي الطرف أغيد","https://www.aldiwan.net/poem3324.html","عموديه"],[475,"آليت لا حلت ولا حلتم","https://www.aldiwan.net/poem15270.html","السريع"],[475,"حقيق بأن يبكي الديار غريبها","https://www.aldiwan.net/poem15295.html","الطويل"],[477,"غب التحية أنهي","https://www.aldiwan.net/poem36939.html","المجتث"],[512,"لا بر في الحب يا أهل الهوى قسمي","https://www.aldiwan.net/poem20785.html","البسيط"],[512,"ما بال وتر صلاتكم لا يشفع","https://www.aldiwan.net/poem20809.html","الكامل"],[512,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[513,"دانت لأمرك طاعة الأقدار","https://www.aldiwan.net/poem12106.html","الكامل"],[533,"غبتم فما لي في التصبر مطمع","https://www.aldiwan.net/poem4121.html","الكامل"],[536,"غبت عني فكدت شوقا أذوب","https://www.aldiwan.net/poem48264.html","عموديه"],[536,"آه بشرى لنا بعودة باشا","https://www.aldiwan.net/poem48295.html","عموديه"],[556,"غيم الحوادث حال دون البازغ","https://www.aldiwan.net/poem33541.html","الكامل"],[556,"غب عن وجودك ترى في وسط قلبك رسم","https://www.aldiwan.net/poem34189.html","المواليا"],[565,"من لذاك الطبرزذ المسحوق","https://www.aldiwan.net/poem69574.html","الخفيف"],[565,"ألقي في حبك القناع","https://www.aldiwan.net/poem69611.html","مخلع البسيط"],[573,"لا تسل عنه كيف أصبح حاله","https://www.aldiwan.net/poem3028.html","الخفيف"],[573,"أمورد يا ناظري أم وريد","https://www.aldiwan.net/poem3088.html","الرجز"],[584,"أهلا بمعتل النسيم ومرحبا","https://www.aldiwan.net/poem17427.html","الكامل"],[584,"يا راقدا لم يدر عمر الدجى","https://www.aldiwan.net/poem17514.html","السريع"]],"verses":[["غَباوَةُ هاجِرِ الدُنيا وَكَيدٌ","وَلا كَيدُ الفَواجِرِ وَالبَغايا",0,"ا",3,0],["غِبتُ وَشَوقي عِندَها حاضِرٌ","شَيَّعَهُ القَلبُ وَراءَ الحَريم",1,"م",1,0],["غُبِقَتْ حواشي التُّرْبِ منْ أمْواهِهِ","راحاً تَصوغُ حَبابَها الغُدْرانُ",2,"ن",1,0],["غِبتُم وَغِبنا فَلَمّا كانَ أَوبُكُمُ","أُبنا فَنَحنُ وَأَنتُم رَهنُ أَسفارِ",3,"ر",1,0],["غِبْتَ فَلاَ عَيْنٌ وَلاَ مَخْبَرٌ","وَلاَ انْتِظَارٌ مِنْكَ مَرْقُوبُ",4,"ب",1,1],["غَبراءَ خاضِعَةِ الصُوى جاوَزتُها","لَيلاً بِكاتِمةِ السُرى مِذعانِ",5,"ن",1,0],["غبطنا ميتة قد أعقبتكم","حياةً ليس يدركها الفناء",6,"ا",2,0],["غِبنا فَلَم نَشهَد بِبَطحاءِ مَكَّةٍ","دُعاءَ بَني كَعبٍ تُحَزُّ رِقابُها",7,"ب",3,1],["غبتمْ فغابتْ مسرَّاتُ القلوبِ فلا","أنتم بزعمي ولا تلك المسرَّات",8,"ت",1,0],["غِبتَ وَما غِبتَ عَن ضَميري","فَما زَجَت تَرحَتي سُروري",9,"ر",2,1],["غِبت فغاب النوم عن ناظري","وسامني طيفُك هِجرانا",10,"ن",2,0],["غِبتَ عَنّي وَجَرَت بَع","دَكَ وَاللَهِ قَضايا",11,"ا",3,0],["غِبتُم فَما لِيَ مِن أُنسٍ لِغَيبَتِكُم","سِوى التَعَلُّلِ بِالتَذكارِ وَالأَمَلِ",12,"ل",1,0],["غِبتَ عَنّي فَما الخَبَر","ما كَذا بَينَنا اِشتَهَر",13,"ر",1,1],["غَبراءَ يَهماءَ يَخشى المُدلِجونَ بِها","زيغَ الهُداةِ بِأَرضٍ أَهلُها شِيَعُ",14,"ع",1,0],["غِبَّ عَيشٍ بِها غَريرٍ وَكانَ ال","عَيشُ في عَهدِ تُبَّعٍ أَفياءَ",15,"ا",2,0],["غِبتُ عَنهُ فَغابَ عَنّي سُروري","إِنَّما يَجمَعُ السُرورَ مَعانُه",16,"ن",2,0],["غَبينَةٌ سُمتَنيها لَو سَمَحتُ بِها","يَوماً لَأَكفَلتُها لَخماً وَغَسّانا",17,"ن",2,0],["غَبَنَتني الأَيّامُ عَقلي وَمالي","وَشَبابي وَصِحَّتي وَفَراغي",18,"غ",2,0],["غِب عَنِ الهَمِّ يَصفُ عَيشُكَ يا صا","حِ وَلا تَنثَنِ إِلى الفُرّاغِ",19,"غ",1,0],["غَبَطَتهُ فيها الخَلائِقُ إِذ بِت","تُ وَدَهرُ مُصغٍ إِلَيَّ وَصاغِ",19,"غ",1,0],["غِبَّ النَعيمِ الَّذي مِن بَعدِهِ شَقِيَت","فَيا سَحاباً بِهِ كُلُّ الوَرى سُقِيَت",20,"ت",1,0],["غبتُ وجداً مِنْ حاضرٍ في سماعي","وكذا الدهرُ غيبةٌ وحضورُ",21,"ر",1,1],["غبْ عنِ النمّامِ واهجرْهُ فما","بلَّغَ المكروهَ إلاّ مَنْ نقلْ",22,"ل",1,0],["غِبْ وزُرْ غِبّاً تزدْ حباً فَمَنْ","أكثرَ التردادَ أضناهُ المللْ",22,"ل",1,0],["غَبَطتُ مسواكَ حِبي","فقال إني مفارِقْ",23,"ق",1,1],["غَبَرنا زَمانا بِاللِوى ثُمَّ أَصبَحَت","بِراقِ اللِوى مِن أَهلِها قَد تَخَلَّتِ",24,"ت",1,0],["غبينةٌ بُدّلت بخردها","أو الف الرحل من خواذلها",25,"ل",3,0],["غَبِيُّ العَينِ عَن طَلَبِ المَعالي","وَفي السَوآتِ شَيطانٌ مَريدُ",26,"د",1,0],["غَبَرتُ أَسيراً في يَدَيهِ وَمَن يَكُن","لَهُ كَرَمٌ تُكرَم بِساحَتِهِ الأَسرى",27,"ر",2,0],["غُبِقنا الأَذى وَالجاشِرِيَّةُ هَمُّنا","وَنادى ظَلامٌ لا سَبيلَ إِلى الجَشرِ",28,"ر",1,1],["غُبِنْتِ يا أيام لم يلتمسْ","عذركِ حتى المستضامُ الغبينْ",29,"ن",1,0],["غَبَرَتْ لتُبّعِ الهُمامِ ورأيُه","أنّ البقاءَ يَكونُ من أتْباعِها",30,"ع",3,0],["غَبَروا فأضْحتْ بالثّناءِ كَفيلةً","فمتى بَدَتْ أثْنَتْ على صُنَّاعها",30,"ع",3,0],["غبطتم صاحب الثرو","ة والزاهد لا يغبط",31,"ط",1,0],["غِبْتُمْ فَأَظْلَمَ يَوْمِي بَعْدَ فُرْقَتِكُمْ","وَسَاءَ صُنْعُ اللَّيَالِي بَعْدَ إِجْمَالِ",32,"ل",1,0],["غِبْتَ عَنِّي مَدَى ثَلاثٍ فَزَادَتْ","حَسَرَاتِي وَغَابَ أُنْسِي وَحَظِّي",33,"ظ",2,0],["غَبْنٌ عَلَى هَذِي العُيُو","نِ تُعَاضُ بِالتُّرْبِ اكْتِحَالاَ",34,"ل",2,0],["غُبِنْتْ فِي الْخِيَارِ غَبْناً جَسِيماً","لَكِنِ اعْتَاضَتِ اعْتِياضاً كَرِيما",35,"م",2,0],["غَبرَتْ وَقَائِعُ لَمْ تَكُنْ مُسْتَنْشَداً","فِيهَا وَلاَ اسْمُكَ مَالِيءَ الأَنْبَاءِ",36,"ا",2,0],["غُبارُ رحَى الهيجاء في لَهَواتِهم","من الشهْدِ أحْلَى أو من المسكِ أضْوَع",37,"ع",1,0],["غبتم ، فأظلم يومي بعد فُرقَتِكم","وساء صُنعُ الليالي بعد إجمالي",38,"ل",2,0],["غبرت بي في صباح باكر","فتنة العين وشغل الخاطر",39,"ر",1,1],["غَبْرَ حُبٍّ لسُلَيْمَى، لمْ يَزِدْ","فيهِ إسْعافٌ، وَلم يَنقُصْهُ ضَنّ",40,"ن",1,0],["غِبْتَ وما غبتَ عن ضميري","وصرْتَ فرحتي وسروري",41,"ر",2,1],["غب إلا إلى مليك السماء","الى من يزيده بالتَوَاه",42,"ا",2,0],["غِب ما كُنت لا أَزال وَحَظي","عَن طَريق النَجاح يَضرب صَفحا",43,"ح",2,0],["غب اِستَلام مَواطيء الأُستاذِ","كافي الكفاة وَمَرجَعي وَعياذي",44,"ذ",2,1],["غَبرت في وُجوه سَعي اللَيالي","وَرُمت بَدر طالِعي بِالمحاق",45,"ق",1,0],["غب لَثم الشِفاه مَوضع نَعلي","ك وَوَضع الجِباه فَوق الرغام",46,"م",1,1],["غِبت عَن ذاتي فَما شَأن السِوىِّ","وَقَطَعت الشَك عَني بِاليَقين",47,"ن",1,1],["غبت عن عيني ولم تعلم بأن","ن فوأدي ضمنه قد احضرك",48,"ك",1,0],["غبوقنا بين أغصان مهدلة","ومن صبوحي تقبيل الأحباء",49,"ا",2,0],["غبا فهل عند بعضكم خبر","وهل ترى ينقضي تساؤلنا",50,"ن",2,0],["غبطت جوارحنا عليك الأعينا","لما اجتلت تلكَ المحاسنُ والثنا",51,"ن",2,1],["غبنت رجالا عاصروا غير أحمد","فما جاوروا البحر المحيط ولا المزنا",52,"ن",2,0],["غبي أو شويطين رجيم","تزندق فهو يركب ما أمامه",53,"م",2,0],["غِبتُ عَنهُ فَسَالَ عَنِّي احتِفَاءً","كَيفَ حَالُ الفَقِيهِ مِن شَكوَاهُ",54,"ا",2,0],["غبنُ الضرير من النذاله","والنصح للأعمى عداله",55,"ل",2,1],["غبناهم والله في كل أمرنا","وفزنا بترويج القلوب من الفكر",56,"ر",1,0],["غبنت إذن عيشي وضاعت فراستي","وأسلمني سوء القضاء إلى الصبر",56,"ر",1,0],["غَبراءَ تَنقُضُهُ حَتّى يُصاحِبَها","مِن زَفِّهِ قَلِقُ الأَرصافِ مُنتَتِفُ",57,"ف",1,0],["غبنٌ يشفُّ الروحَ أن تتفَتَّحَ","الأورادُ بين الوحلِ والمستنقَعِ",58,"ع",1,0],["غبن وحقك أن تكل","أمري الى شر الصحاب",59,"ب",1,0],["غَبرتُ مَدى الزَمانِ حَليف فَقرٍ","خَميصاً عارياً ظَمآن ضاحي",60,"ح",2,0],["غبتَ عني، ثم هاقد","جئتَ، هَلَّا رُمْتَ حضني",61,"ن",2,0],["غبَّ دعاءٍ عاطرِ","من روض سرٍّ زاهرِ",62,"ر",1,1],["غب غراماً بها تشاهد بديع ال","حسن فيها الجميل في الإبداع",63,"ع",1,0],["غبت فيها عن الرشاد وقد فا","ت المراد الّذي عليه المدار",64,"ر",1,0],["غب عن الغيب في شهودٍ وطب في ال","ورد وجداً ومت بعين حياتك",65,"ك",1,0],["غبار تربتهم تمحى الذنوب به","فَكَم بتربتهم من حط أَثقال",66,"ل",1,0],["غِبتُم فَلَم يَغِبِ الغَرامُ","فَالنَومُ بَعدَكُمُ حَرامُ",67,"م",1,1],["غِبتُم فَأَوحَشتُمُ مُذ غِبتُمُ الدارا","فَشَوقُنا واقِعٌ وَالصَبرُ قَد طارا",68,"ر",2,1],["غَبطتُ الركبَ حين بها اِستقلّوا","فَكَم حملت جِمالُهم جمالا",69,"ل",2,0],["غبرَت هذه الليالي فلو يُس","ئلن أنكرن ما دها الأذواءَ",70,"ا",2,0],["غبت عني يا مدي أملي","فامتلى قلبي من الوجل",71,"ل",1,0],["غِبتُ عنكْم ليلَ الشّبابِ على نُسْ","خةِ أقطارِه فَضّيعْتُ عُمرا",72,"ر",2,0],["غَبْطتُك نُعْمَى فُزتَ دُونِي بنَيْلِها","وفخراً له ذيلُ على السّحبِ يُسْحَبُ",73,"ب",1,0],["غَبِرتْ على دَخَلٍ وروْعاتُ النّوى","يَقْرِفن ما دَمَلَ الزّمانُ الغَابرُ",74,"ر",1,0],["غِبتُم وأَشباحُكُمُ بِنَاظِري","كأَنَّها إِنسانُهُ لا تَبرحُ",75,"ح",1,0],["غُبِقُوا بخمرِ الحربِ صِرْفاً فاغتَدتْ","تِلْكَ الحفائِظَ والحتوفَ خُمارُها",76,"ر",3,0],["غباوة جاهل قد حك","موه في ذوي القيم",77,"م",1,0],["غبتم وغاب السرور عنها","فقلبها بين غائبينِ",78,"ن",1,0],["غبت عنه نجماً وغاب أخوك ال","بدرُ فالتيهُ سيرُهُ والضلالَهْ",79,"ل",2,0],["غَبرتُ زماناً أمنع الناسَ مِقوَدي","حَروناً إلى غير المطامع طامحا",80,"ح",2,0],["غَبْراءُ رَيعْانُ الربيعِ كقيْظِها","في المَحْلِ لا مرعىً ولا مُتبقَّلُ",81,"ل",1,0],["غَبْراءُ لا تبْرحُ ممْطُورةً","وهي على الغُبْرةِ لا تُورقُ",82,"ق",1,0],["غبتمُ عن جلّقٍ لا عدمتْ","منكمُ بهجةَ إحسانٍ وحسن",83,"ن",1,0],["غبث النسيم بما علاهُ","من الغدير فقد تجعَّد",84,"د",1,0],["غبتمْ فما لذَّ لنا عيشُنا","ولا استُحِثَّ الكاسُ مذ غِبتُمُ",85,"م",1,0],["غبرَ الزمانُ وما أرى مِن وعدِهمْ","شيئاً سوى التعليلِ والتسويفِ",86,"ف",1,0],["غب التحية أنهي","الى العليم بكنهي",87,"ي",1,1],["غِبْتُمْ فغيّبْتُمُ صُبحي فلسْتُ أرى","إلّا بقايا ألمّتْ فيهِ منْ لِمَمي",88,"م",2,0],["غِبْتُم وصيّرتُ الحَمائمَ بعدَكُم","إلْفاً ولكنّي أنوحُ وتَسجَعُ",89,"ع",1,0],["غبَطَتْها أنجُمُ الأفْقِ فَها","هيَ في الإشراقِ فيها لا تُضاهى",90,"ا",3,0],["غبرت في وجه الملوك بسيرة","لم يكتحل أحد لها بغبار",91,"ر",1,0],["غِبتُم فما لي في التَصبُّر مَطمعٌ","عَظُم الجوى وَاِشتَدَّت الأَشواقُ",92,"ق",1,1],["غِبتَ عني فكدتُ شوقا أذُوبُ","ومن الشَّوقِ قد تذُوبُ القلوب",93,"ب",1,1],["غِبتَ عنِّي وأنتَ إنسَانُ عَينِي","أيُّ نُورٍ أراه حِينَ تَغيبُ",93,"ب",1,0],["غِبتَ عني وأنتَ إنسانُ عينِي","فتركتَ الأحشاءَ ذاتَ اضطرابِ",94,"ب",1,0],["غبنا وقد حضر الحبيب كائننا","إذ لم نكن ما القول قول مبالغ",95,"غ",1,0],["غب عن وجودكْ ترى في وسط قلبكْ رسمْ","به حبيبك قسمْ لكْ من شهودُهْ قسمْ",96,"م",1,1],["غِبْتَ عَنِّي فَغَابَ عَنِّي نَصِيْبِي","أَنْتَ عِنْدِي بِذَاكَ غَيْرُ خَلِيْقِ",97,"ق",1,0],["غُبِطْتُ مَا عِشْتَ فِي شُجَاعٍ","وَعَاشَ فِي غِبْطَةٍ شُجَاعُ",98,"ع",1,0],["غبت عن عَبدِك الَّذي غَاب عَنْه","سعدُه واعتلاؤُه واعتِدالُه",99,"ل",2,0],["غبتَ فيا شَوْقِي إِلى وَقْفَةٍ","فيه أُوَالي بالمديحِ النَّشِيدْ",100,"د",1,0],["غَبْتُمْ وأَنْتُمْ حَاضِرُونَ بِمُهْجَتِي","فَبِمُهْجَتِي أَفْدِي الحُضُورَ الغُيَّبا",101,"ب",2,0],["غِبْتَ فَلَا وَاللَّهِ لَمْ يَبْقَ لِي","قَلْبٌ وَلَا سَمْعٌ وَلَا نَاظِرُ",102,"ر",1,0]]}