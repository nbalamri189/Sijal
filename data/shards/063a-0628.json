wan.net/poem49314.html","البسيط"],[120,"يا أسفا للربيع يذهب بالورد","https://www.aldiwan.net/poem49327.html","المنسرح"],[160,"غبطت جوارحنا عليك الأعينا","https://www.aldiwan.net/poem58876.html","الكامل"],[160,"إذا ابطات عنا من المحسن الحسنى","https://www.aldiwan.net/poem59008.html","الطويل"],[160,"على من بالهدى يا ابن الإمامه","https://www.aldiwan.net/poem59206.html","الوافر"],[173,"أنكر العبد بزه وحلاه","https://www.aldiwan.net/poem4381.html","عموديه"],[186,"غبن الضرير من النذاله","https://www.aldiwan.net/poem43483.html","مجزوء الكامل"],[186,"سكنت إلى حسن التوكل والصم","https://www.aldiwan.net/poem43867.html","الطويل"],[195,"إن الخليط أجدوا البين فانقذفوا","https://www.aldiwan.net/poem54398.html","البسيط"],[197,"أشجى الرفاق تأوهي وتوجعي","https://www.aldiwan.net/poem39946.html","الكامل"],[221,"مولاي زغت عن الصواب","https://www.aldiwan.net/poem55269.html","مجزوء الكامل"],[252,"أما وجفونك المرضى الصحاح","https://www.aldiwan.net/poem1418.html",""],[254,"اُعف عني","https://www.aldiwan.net/poem24945.html","مجزوء الرمل"],[259,"غب دعاء عاطر","https://www.aldiwan.net/poem35755.html","مجزوء الرجز"],[259,"شنف السمع مطربا بالسماع","https://www.aldiwan.net/poem35817.html","الخفيف"],[259,"في المقادير تحكم الأقدار","https://www.aldiwan.net/poem35947.html","الخفيف"],[259,"في دياجي الحروف من كلماتك","https://www.aldiwan.net/poem35950.html","الخفيف"],[271,"حياك يا ربع ليلى كل هطال","https://www.aldiwan.net/poem52075.html","البسيط"],[282,"غبتم فلم يغب الغرام","https://www.aldiwan.net/poem32469.html","مجزوء الكامل"],[282,"غبتم فأوحشتم مذ غبتم الدارا","https://www.aldiwan.net/poem32774.html","البسيط"],[297,"سقى تلك الأباطح والرمالا","https://www.aldiwan.net/poem33190.html","الوافر"],[303,"لا قبلنا في ذا المصاب عزاء","https://www.aldiwan.net/poem58419.html","الخفيف"],[304,"كم بقلبي فيك من شجن","https://www.aldiwan.net/poem16838.html","المديد"],[364,"أحضر الليل منك عقدا وثغرا","https://www.aldiwan.net/poem60893.html","الخفيف"],[409,"أيا غائبا يدنيه شوقي على النوى","https://www.aldiwan.net/poem32328.html","الطويل"],[409,"لا غرو إن هجر الخيال الزائر","https://www.aldiwan.net/poem32484.html","الكامل"],[409,"يا نازحين واصطباري والأسى","https://www.aldiwan.net/poem32501.html","الرجز"],[439,"إن تفخر الدنيا فأنت فخارها","https://www.aldiwan.net/poem34810.html","الكامل"],[443,"وشب بأرض بوليفا","https://www.aldiwan.net/poem55925.html","عموديه"],[458,"طاف عليه بالرقمتينِ","https://www.aldiwan.net/poem55834.html","مخلع البسيط"],[458,"ذكر العيش بالحمى فبكى له","https://www.aldiwan.net/poem55940.html","الخفيف"],[458,"أمرتكم أمري بنعمان ناصحا","https://www.aldiwan.net/poem56253.html","الطويل"],[461,"بت حيث شئت ولا يرعك المنزل","https://www.aldiwan.net/poem16015.html","الكامل"],[461,"ولينة الأعطاف خوارة","https://www.aldiwan.net/poem16084.html","السريع"],[464,"غير سهل فيك يا لمياء حزني","https://www.aldiwan.net/poem3194.html","عموديه"],[464,"وأغن ساجي الطرف أغيد","https://www.aldiwan.net/poem3324.html","عموديه"],[477,"آليت لا حلت ولا حلتم","https://www.aldiwan.net/poem15270.html","السريع"],[477,"حقيق بأن يبكي الديار غريبها","https://www.aldiwan.net/poem15295.html","الطويل"],[479,"غب التحية أنهي","https://www.aldiwan.net/poem36939.html","المجتث"],[514,"لا بر في الحب يا أهل الهوى قسمي","https://www.aldiwan.net/poem20785.html","البسيط"],[514,"ما بال وتر صلاتكم لا يشفع","https://www.aldiwan.net/poem20809.html","الكامل"],[514,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[515,"دانت لأمرك طاعة الأقدار","https://www.aldiwan.net/poem12106.html","الكامل"],[535,"غبتم فما لي في التصبر مطمع","https://www.aldiwan.net/poem4121.html","الكامل"],[538,"غبت عني فكدت شوقا أذوب","https://www.aldiwan.net/poem48264.html","عموديه"],[538,"آه بشرى لنا بعودة باشا","https://www.aldiwan.net/poem48295.html","عموديه"],[558,"غيم الحوادث حال دون البازغ","https://www.aldiwan.net/poem33541.html","الكامل"],[558,"غب عن وجودك ترى في وسط قلبك رسم","https://www.aldiwan.net/poem34189.html","المواليا"],[567,"من لذاك الطبرزذ المسحوق","https://www.aldiwan.net/poem69574.html","الخفيف"],[567,"ألقي في حبك القناع","https://www.aldiwan.net/poem69611.html","مخلع البسيط"],[575,"لا تسل عنه كيف أصبح حاله","https://www.aldiwan.net/poem3028.html","الخفيف"],[575,"أمورد يا ناظري أم وريد","https://www.aldiwan.net/poem3088.html","الرجز"],[586,"أهلا بمعتل النسيم ومرحبا","https://www.aldiwan.net/poem17427.html","الكامل"],[586,"يا راقدا لم يدر عمر الدجى","https://www.aldiwan.net/poem17514.html","السريع"]],"verses":[["غَباوَةُ هاجِرِ الدُنيا وَكَيدٌ","وَلا كَيدُ الفَواجِرِ وَالبَغايا",0,"ا",3,0],["غِبتُ وَشَوقي عِندَها حاضِرٌ","شَيَّعَهُ القَلبُ وَراءَ الحَريم",1,"م",1,0],["غُبِقَتْ حواشي التُّرْبِ منْ أمْواهِهِ","راحاً تَصوغُ حَبابَها الغُدْرانُ",2,"ن",1,0],["غبت عن قصدي ! .. رفيقي غائب","من ليال ، رأيه في الحبس (جهمي)",3,"م",2,0],["غِبتُم وَغِبنا فَلَمّا كانَ أَوبُكُمُ","أُبنا فَنَحنُ وَأَنتُم رَهنُ أَسفارِ",4,"ر",1,0],["غِبْتَ فَلاَ عَيْنٌ وَلاَ مَخْبَرٌ","وَلاَ انْتِظَارٌ مِنْكَ مَرْقُوبُ",5,"ب",1,1],["غَبراءَ خاضِعَةِ الصُوى جاوَزتُها","لَيلاً بِكاتِمةِ السُرى مِذعانِ",6,"ن",1,0],["غبطنا ميتة قد أعقبتكم","حياةً ليس يدركها الفناء",7,"ا",2,0],["غِبنا فَلَم نَشهَد بِبَطحاءِ مَكَّةٍ","دُعاءَ بَني كَعبٍ تُحَزُّ رِقابُها",8,"ب",3,1],["غبتمْ فغابتْ مسرَّاتُ القلوبِ فلا","أنتم بزعمي ولا تلك المسرَّات",9,"ت",1,0],["غِبتَ وَما غِبتَ عَن ضَميري","فَما زَجَت تَرحَتي سُروري",10,"ر",2,1],["غِبت فغاب النوم عن ناظري","وسامني طيفُك هِجرانا",11,"ن",2,0],["غِبتَ عَنّي وَجَرَت بَع","دَكَ وَاللَهِ قَضايا",12,"ا",3,0],["غِبتُم فَما لِيَ مِن أُنسٍ لِغَيبَتِكُم","سِوى التَعَلُّلِ بِالتَذكارِ وَالأَمَلِ",13,"ل",1,0],["غِبتَ عَنّي فَما الخَبَر","ما كَذا بَينَنا اِشتَهَر",14,"ر",1,1],["غَبراءَ يَهماءَ يَخشى المُدلِجونَ بِها","زيغَ الهُداةِ بِأَرضٍ أَهلُها شِيَعُ",15,"ع",1,0],["غِبَّ عَيشٍ بِها غَريرٍ وَكانَ ال","عَيشُ في عَهدِ تُبَّعٍ أَفياءَ",16,"ا",2,0],["غِبتُ عَنهُ فَغابَ عَنّي سُروري","إِنَّما يَجمَعُ السُرورَ مَعانُه",17,"ن",2,0],["غَبينَةٌ سُمتَنيها لَو سَمَحتُ بِها","يَوماً لَأَكفَلتُها لَخماً وَغَسّانا",18,"ن",2,0],["غَبَنَتني الأَيّامُ عَقلي وَمالي","وَشَبابي وَصِحَّتي وَفَراغي",19,"غ",2,0],["غِب عَنِ الهَمِّ يَصفُ عَيشُكَ يا صا","حِ وَلا تَنثَنِ إِلى الفُرّاغِ",20,"غ",1,0],["غَبَطَتهُ فيها الخَلائِقُ إِذ بِت","تُ وَدَهرُ مُصغٍ إِلَيَّ وَصاغِ",20,"غ",1,0],["غِبَّ النَعيمِ الَّذي مِن بَعدِهِ شَقِيَت","فَيا سَحاباً بِهِ كُلُّ الوَرى سُقِيَت",21,"ت",1,0],["غبتُ وجداً مِنْ حاضرٍ في سماعي","وكذا الدهرُ غيبةٌ وحضورُ",22,"ر",1,1],["غبْ عنِ النمّامِ واهجرْهُ فما","بلَّغَ المكروهَ إلاّ مَنْ نقلْ",23,"ل",1,0],["غِبْ وزُرْ غِبّاً تزدْ حباً فَمَنْ","أكثرَ التردادَ أضناهُ المللْ",23,"ل",1,0],["غَبَطتُ مسواكَ حِبي","فقال إني مفارِقْ",24,"ق",1,1],["غَبَرنا زَمانا بِاللِوى ثُمَّ أَصبَحَت","بِراقِ اللِوى مِن أَهلِها قَد تَخَلَّتِ",25,"ت",1,0],["غبينةٌ بُدّلت بخردها","أو الف الرحل من خواذلها",26,"ل",3,0],["غَبِيُّ العَينِ عَن طَلَبِ المَعالي","وَفي السَوآتِ شَيطانٌ مَريدُ",27,"د",1,0],["غَبَرتُ أَسيراً في يَدَيهِ وَمَن يَكُن","لَهُ كَرَمٌ تُكرَم بِساحَتِهِ الأَسرى",28,"ر",2,0],["غُبِقنا الأَذى وَالجاشِرِيَّةُ هَمُّنا","وَنادى ظَلامٌ لا سَبيلَ إِلى الجَشرِ",29,"ر",1,1],["غُبِنْتِ يا أيام لم يلتمسْ","عذركِ حتى المستضامُ الغبينْ",30,"ن",1,0],["غَبَرَتْ لتُبّعِ الهُمامِ ورأيُه","أنّ البقاءَ يَكونُ من أتْباعِها",31,"ع",3,0],["غَبَروا فأضْحتْ بالثّناءِ كَفيلةً","فمتى بَدَتْ أثْنَتْ على صُنَّاعها",31,"ع",3,0],["غبطتم صاحب الثرو","ة والزاهد لا يغبط",32,"ط",1,0],["غِبْتُمْ فَأَظْلَمَ يَوْمِي بَعْدَ فُرْقَتِكُمْ","وَسَاءَ صُنْعُ اللَّيَالِي بَعْدَ إِجْمَالِ",33,"ل",1,0],["غِبْتَ عَنِّي مَدَى ثَلاثٍ فَزَادَتْ","حَسَرَاتِي وَغَابَ أُنْسِي وَحَظِّي",34,"ظ",2,0],["غَبْنٌ عَلَى هَذِي العُيُو","نِ تُعَاضُ بِالتُّرْبِ اكْتِحَالاَ",35,"ل",2,0],["غُبِنْتْ فِي الْخِيَارِ غَبْناً جَسِيماً","لَكِنِ اعْتَاضَتِ اعْتِياضاً كَرِيما",36,"م",2,0],["غَبرَتْ وَقَائِعُ لَمْ تَكُنْ مُسْتَنْشَداً","فِيهَا وَلاَ اسْمُكَ مَالِيءَ الأَنْبَاءِ",37,"ا",2,0],["غُبارُ رحَى الهيجاء في لَهَواتِهم","من الشهْدِ أحْلَى أو من المسكِ أضْوَع",38,"ع",1,0],["غبتم ، فأظلم يومي بعد فُرقَتِكم","وساء صُنعُ الليالي بعد إجمالي",39,"ل",2,0],["غبرت بي في صباح باكر","فتنة العين وشغل الخاطر",40,"ر",1,1],["غَبْرَ حُبٍّ لسُلَيْمَى، لمْ يَزِدْ","فيهِ إسْعافٌ، وَلم يَنقُصْهُ ضَنّ",41,"ن",1,0],["غِبْتَ وما غبتَ عن ضميري","وصرْتَ فرحتي وسروري",42,"ر",2,1],["غب إلا إلى مليك السماء","الى من يزيده بالتَوَاه",43,"ا",2,0],["غِب ما كُنت لا أَزال وَحَظي","عَن طَريق النَجاح يَضرب صَفحا",44,"ح",2,0],["غب اِستَلام مَواطيء الأُستاذِ","كافي الكفاة وَمَرجَعي وَعياذي",45,"ذ",2,1],["غَبرت في وُجوه سَعي اللَيالي","وَرُمت بَدر طالِعي بِالمحاق",46,"ق",1,0],["غب لَثم الشِفاه مَوضع نَعلي","ك وَوَضع الجِباه فَوق الرغام",47,"م",1,1],["غِبت عَن ذاتي فَما شَأن السِوىِّ","وَقَطَعت الشَك عَني بِاليَقين",48,"ن",1,1],["غبت عن عيني ولم تعلم بأن","ن فوأدي ضمنه قد احضرك",49,"ك",1,0],["غبوقنا بين أغصان مهدلة","ومن صبوحي تقبيل الأحباء",50,"ا",2,0],["غبا فهل عند بعضكم خبر","وهل ترى ينقضي تساؤلنا",51,"ن",2,0],["غبطت جوارحنا عليك الأعينا","لما اجتلت تلكَ المحاسنُ والثنا",52,"ن",2,1],["غبنت رجالا عاصروا غير أحمد","فما جاوروا البحر المحيط ولا المزنا",53,"ن",2,0],["غبي أو شويطين رجيم","تزندق فهو يركب ما أمامه",54,"م",2,0],["غِبتُ عَنهُ فَسَالَ عَنِّي احتِفَاءً","كَيفَ حَالُ الفَقِيهِ مِن شَكوَاهُ",55,"ا",2,0],["غبنُ الضرير من النذاله","والنصح للأعمى عداله",56,"ل",2,1],["غبناهم والله في كل أمرنا","وفزنا بترويج القلوب من الفكر",57,"ر",1,0],["غبنت إذن عيشي وضاعت فراستي","وأسلمني سوء القضاء إلى الصبر",57,"ر",1,0],["غَبراءَ تَنقُضُهُ حَتّى يُصاحِبَها","مِن زَفِّهِ قَلِقُ الأَرصافِ مُنتَتِفُ",58,"ف",1,0],["غبنٌ يشفُّ الروحَ أن تتفَتَّحَ","الأورادُ بين الوحلِ والمستنقَعِ",59,"ع",1,0],["غبن وحقك أن تكل","أمري الى شر الصحاب",60,"ب",1,0],["غَبرتُ مَدى الزَمانِ حَليف فَقرٍ","خَميصاً عارياً ظَمآن ضاحي",61,"ح",2,0],["غبتَ عني، ثم هاقد","جئتَ، هَلَّا رُمْتَ حضني",62,"ن",2,0],["غبَّ دعاءٍ عاطرِ","من روض سرٍّ زاهرِ",63,"ر",1,1],["غب غراماً بها تشاهد بديع ال","حسن فيها الجميل في الإبداع",64,"ع",1,0],["غبت فيها عن الرشاد وقد فا","ت المراد الّذي عليه المدار",65,"ر",1,0],["غب عن الغيب في شهودٍ وطب في ال","ورد وجداً ومت بعين حياتك",66,"ك",1,0],["غبار تربتهم تمحى الذنوب به","فَكَم بتربتهم من حط أَثقال",67,"ل",1,0],["غِبتُم فَلَم يَغِبِ الغَرامُ","فَالنَومُ بَعدَكُمُ حَرامُ",68,"م",1,1],["غِبتُم فَأَوحَشتُمُ مُذ غِبتُمُ الدارا","فَشَوقُنا واقِعٌ وَالصَبرُ قَد طارا",69,"ر",2,1],["غَبطتُ الركبَ حين بها اِستقلّوا","فَكَم حملت جِمالُهم جمالا",70,"ل",2,0],["غبرَت هذه الليالي فلو يُس","ئلن أنكرن ما دها الأذواءَ",71,"ا",2,0],["غبت عني يا مدي أملي","فامتلى قلبي من الوجل",72,"ل",1,0],["غِبتُ عنكْم ليلَ الشّبابِ على نُسْ","خةِ أقطارِه فَضّيعْتُ عُمرا",73,"ر",2,0],["غَبْطتُك نُعْمَى فُزتَ دُونِي بنَيْلِها","وفخراً له ذيلُ على السّحبِ يُسْحَبُ",74,"ب",1,0],["غَبِرتْ على دَخَلٍ وروْعاتُ النّوى","يَقْرِفن ما دَمَلَ الزّمانُ الغَابرُ",75,"ر",1,0],["غِبتُم وأَشباحُكُمُ بِنَاظِري","كأَنَّها إِنسانُهُ لا تَبرحُ",76,"ح",1,0],["غُبِقُوا بخمرِ الحربِ صِرْفاً فاغتَدتْ","تِلْكَ الحفائِظَ والحتوفَ خُمارُها",77,"ر",3,0],["غباوة جاهل قد حك","موه في ذوي القيم",78,"م",1,0],["غبتم وغاب السرور عنها","فقلبها بين غائبينِ",79,"ن",1,0],["غبت عنه نجماً وغاب أخوك ال","بدرُ فالتيهُ سيرُهُ والضلالَهْ",80,"ل",2,0],["غَبرتُ زماناً أمنع الناسَ مِقوَدي","حَروناً إلى غير المطامع طامحا",81,"ح",2,0],["غَبْراءُ رَيعْانُ الربيعِ كقيْظِها","في المَحْلِ لا مرعىً ولا مُتبقَّلُ",82,"ل",1,0],["غَبْراءُ لا تبْرحُ ممْطُورةً","وهي على الغُبْرةِ لا تُورقُ",83,"ق",1,0],["غبتمُ عن جلّقٍ لا عدمتْ","منكمُ بهجةَ إحسانٍ وحسن",84,"ن",1,0],["غبث النسيم بما علاهُ","من الغدير فقد تجعَّد",85,"د",1,0],["غبتمْ فما لذَّ لنا عيشُنا","ولا استُحِثَّ الكاسُ مذ غِبتُمُ",86,"م",1,0],["غبرَ الزمانُ وما أرى مِن وعدِهمْ","شيئاً سوى التعليلِ والتسويفِ",87,"ف",1,0],["غب التحية أنهي","الى العليم بكنهي",88,"ي",1,1],["غِبْتُمْ فغيّبْتُمُ صُبحي فلسْتُ أرى","إلّا بقايا ألمّتْ فيهِ منْ لِمَمي",89,"م",2,0],["غِبْتُم وصيّرتُ الحَمائمَ بعدَكُم","إلْفاً ولكنّي أنوحُ وتَسجَعُ",90,"ع",1,0],["غبَطَتْها أنجُمُ الأفْقِ فَها","هيَ في الإشراقِ فيها لا تُضاهى",91,"ا",3,0],["غبرت في وجه الملوك بسيرة","لم يكتحل أحد لها بغبار",92,"ر",1,0],["غِبتُم فما لي في التَصبُّر مَطمعٌ","عَظُم الجوى وَاِشتَدَّت الأَشواقُ",93,"ق",1,1],["غِبتَ عني فكدتُ شوقا أذُوبُ","ومن الشَّوقِ قد تذُوبُ القلوب",94,"ب",1,1],["غِبتَ عنِّي وأنتَ إنسَانُ عَينِي","أيُّ نُورٍ أراه حِينَ تَغيبُ",94,"ب",1,0],["غِبتَ عني وأنتَ إنسانُ عينِي","فتركتَ الأحشاءَ ذاتَ اضطرابِ",95,"ب",1,0],["غبنا وقد حضر الحبيب كائننا","إذ لم نكن ما القول قول مبالغ",96,"غ",1,0],["غب عن وجودكْ ترى في وسط قلبكْ رسمْ","به حبيبك قسمْ لكْ من شهودُهْ قسمْ",97,"م",1,1],["غِبْتَ عَنِّي فَغَابَ عَنِّي نَصِيْبِي","أَنْتَ عِنْدِي بِذَاكَ غَيْرُ خَلِيْقِ",98,"ق",1,0],["غُبِطْتُ مَا عِشْتَ فِي شُجَاعٍ","وَعَاشَ فِي غِبْطَةٍ شُجَاعُ",99,"ع",1,0],["غبت عن عَبدِك الَّذي غَاب عَنْه","سعدُه واعتلاؤُه واعتِدالُه",100,"ل",2,0],["غبتَ فيا شَوْقِي إِلى وَقْفَةٍ","فيه أُوَالي بالمديحِ النَّشِيدْ",101,"د",1,0],["غَبْتُمْ وأَنْتُمْ حَاضِرُونَ بِمُهْجَتِي","فَبِمُهْجَتِي أَفْدِي الحُضُورَ الغُيَّبا",102,"ب",2,0],["غِبْتَ فَلَا وَاللَّهِ لَمْ يَبْقَ لِي","قَلْبٌ وَلَا سَمْعٌ وَلَا نَاظِرُ",103,"ر",1,0]]}