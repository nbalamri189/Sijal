{"poems":[[53,"أتذهل بعد إنذار المنايا","https://www.aldiwan.net/poem29623.html","الوافر"],[53,"لا عادت الكأس عليل النسيم","https://www.aldiwan.net/poem29774.html","السريع"],[63,"وله تشف وراءه الأشجان","https://www.aldiwan.net/poem46179.html","الكامل"],[55,"يا موقد النار بالهندي والغار","https://www.aldiwan.net/poem26369.html","البسيط"],[77,"غبت فلا عين ولا مخبر","https://www.aldiwan.net/poem36711.html","السريع"],[24,"بكرت علي بسحرة تلحاني","https://www.aldiwan.net/poem21887.html","الكامل"],[88,"قضوا شهداء ليس لهم بواء","https://www.aldiwan.net/poem45035.html","الوافر"],[23,"غبنا فلم نشهد ببطحاء مكة","https://www.aldiwan.net/poem21413.html","الطويل"],[72,"قضى وما قضيت منكم لبانات","https://www.aldiwan.net/poem18384.html","البسيط"],[64,"غبت وما غبت عن ضميري","https://www.aldiwan.net/poem67642.html","مخلع البسيط"],[51,"لم يبق لي صبر ولكنما","https://www.aldiwan.net/poem66695.html","السريع"],[70,"يا مليحا لي منه","https://www.aldiwan.net/poem42402.html","مجزوء الرمل"],[70,"عندي أحاديث أشواق أضن بها","https://www.aldiwan.net/poem42758.html","البسيط"],[70,"غبت عني فما الخبر","https://www.aldiwan.net/poem42903.html","مجزوء الخفيف"],[38,"عاد الهموم وما يدري الخلي بها","https://www.aldiwan.net/poem7725.html","البسيط"],[45,"يا أخا الأزد ما حفظت الإخاء","https://www.aldiwan.net/poem10196.html","الخفيف"],[45,"لاجديد الصبا ولا ريعانه","https://www.aldiwan.net/poem66799.html","البسيط"],[45,"أعن جوار أبي إسحاق تطمع أن","https://www.aldiwan.net/poem66813.html","البسيط"],[49,"أي عيش يكون أبلغ من عي","https://www.aldiwan.net/poem62174.html","الخفيف"],[66,"غير مجد مع صحة وفراغ","https://www.aldiwan.net/poem38483.html","الخفيف"],[66,"كان الزمان بلقياكم يمنينا","https://www.aldiwan.net/poem40132.html","البسيط"],[69,"غبت وجدا من حاضر في سماعي","https://www.aldiwan.net/poem28294.html","الخفيف"],[69,"اعتزل ذكر الأغاني والغزل","https://www.aldiwan.net/poem28334.html","الرمل"],[69,"غبطت مسواك حبي","https://www.aldiwan.net/poem28870.html","المجتث"],[33,"فما وجد أعرابية قذفت بها","https://www.aldiwan.net/poem25978.html","الطويل"],[75,"هل تملك الدار رجع سائلها","https://www.aldiwan.net/poem69023.html","البسيط"],[50,"أعادك طيفها وبما يعود","https://www.aldiwan.net/poem63923.html","الوافر"],[46,"يعلم إلهي يوجد الضعف شيمتي","https://www.aldiwan.net/poem22051.html","الطويل"],[46,"غبقنا الأذى والجاشرية همنا","https://www.aldiwan.net/poem22647.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39631","السريع"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16703","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147495","الهزج"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42731","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42681","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55125","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54674","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54272","الطويل"],[87,"الهجران","https://www.poetsgate.com/ViewPoem.aspx?id=14050",""],[96,"سارية الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=17505",""],[45,"قَلّمَا لا تَتَصَبّاني الدّمَنْ","https://www.poetsgate.com/ViewPoem.aspx?id=32010",""],[64,"غِبْتَ وما غبتَ عن ضميري","https://www.poetsgate.com/ViewPoem.aspx?id=8512",""],[51,"يا أخي يا أخا الدماثة والرقة","https://www.poetsgate.com/ViewPoem.aspx?id=25882",""]],"verses":[["غَباوَةُ هاجِرِ الدُنيا وَكَيدٌ","وَلا كَيدُ الفَواجِرِ وَالبَغايا",0,"ا",3,0],["غِبتُ وَشَوقي عِندَها حاضِرٌ","شَيَّعَهُ القَلبُ وَراءَ الحَريم",1,"م",1,0],["غُبِقَتْ حواشي التُّرْبِ منْ أمْواهِهِ","راحاً تَصوغُ حَبابَها الغُدْرانُ",2,"ن",1,0],["غِبتُم وَغِبنا فَلَمّا كانَ أَوبُكُمُ","أُبنا فَنَحنُ وَأَنتُم رَهنُ أَسفارِ",3,"ر",1,0],["غِبْتَ فَلاَ عَيْنٌ وَلاَ مَخْبَرٌ","وَلاَ انْتِظَارٌ مِنْكَ مَرْقُوبُ",4,"ب",1,1],["غَبراءَ خاضِعَةِ الصُوى جاوَزتُها","لَيلاً بِكاتِمةِ السُرى مِذعانِ",5,"ن",1,0],["غبطنا ميتة قد أعقبتكم","حياةً ليس يدركها الفناء",6,"ا",2,0],["غِبنا فَلَم نَشهَد بِبَطحاءِ مَكَّةٍ","دُعاءَ بَني كَعبٍ تُحَزُّ رِقابُها",7,"ب",3,1],["غبتمْ فغابتْ مسرَّاتُ القلوبِ فلا","أنتم بزعمي ولا تلك المسرَّات",8,"ت",1,0],["غِبتَ وَما غِبتَ عَن ضَميري","فَما زَجَت تَرحَتي سُروري",9,"ر",2,1],["غِبت فغاب النوم عن ناظري","وسامني طيفُك هِجرانا",10,"ن",2,0],["غِبتَ عَنّي وَجَرَت بَع","دَكَ وَاللَهِ قَضايا",11,"ا",3,0],["غِبتُم فَما لِيَ مِن أُنسٍ لِغَيبَتِكُم","سِوى التَعَلُّلِ بِالتَذكارِ وَالأَمَلِ",12,"ل",1,0],["غِبتَ عَنّي فَما الخَبَر","ما كَذا بَينَنا اِشتَهَر",13,"ر",1,1],["غَبراءَ يَهماءَ يَخشى المُدلِجونَ بِها","زيغَ الهُداةِ بِأَرضٍ أَهلُها شِيَعُ",14,"ع",1,0],["غِبَّ عَيشٍ بِها غَريرٍ وَكانَ ال","عَيشُ في عَهدِ تُبَّعٍ أَفياءَ",15,"ا",2,0],["غِبتُ عَنهُ فَغابَ عَنّي سُروري","إِنَّما يَجمَعُ السُرورَ مَعانُه",16,"ن",2,0],["غَبينَةٌ سُمتَنيها لَو سَمَحتُ بِها","يَوماً لَأَكفَلتُها لَخماً وَغَسّانا",17,"ن",2,0],["غَبَنَتني الأَيّامُ عَقلي وَمالي","وَشَبابي وَصِحَّتي وَفَراغي",18,"غ",2,0],["غِب عَنِ الهَمِّ يَصفُ عَيشُكَ يا صا","حِ وَلا تَنثَنِ إِلى الفُرّاغِ",19,"غ",1,0],["غَبَطَتهُ فيها الخَلائِقُ إِذ بِت","تُ وَدَهرُ مُصغٍ إِلَيَّ وَصاغِ",19,"غ",1,0],["غِبَّ النَعيمِ الَّذي مِن بَعدِهِ شَقِيَت","فَيا سَحاباً بِهِ كُلُّ الوَرى سُقِيَت",20,"ت",1,0],["غبتُ وجداً مِنْ حاضرٍ في سماعي","وكذا الدهرُ غيبةٌ وحضورُ",21,"ر",1,1],["غبْ عنِ النمّامِ واهجرْهُ فما","بلَّغَ المكروهَ إلاّ مَنْ نقلْ",22,"ل",1,0],["غِبْ وزُرْ غِبّاً تزدْ حباً فَمَنْ","أكثرَ التردادَ أضناهُ المللْ",22,"ل",1,0],["غَبَطتُ مسواكَ حِبي","فقال إني مفارِقْ",23,"ق",1,1],["غَبَرنا زَمانا بِاللِوى ثُمَّ أَصبَحَت","بِراقِ اللِوى مِن أَهلِها قَد تَخَلَّتِ",24,"ت",1,0],["غبينةٌ بُدّلت بخردها","أو الف الرحل من خواذلها",25,"ل",3,0],["غَبِيُّ العَينِ عَن طَلَبِ المَعالي","وَفي السَوآتِ شَيطانٌ مَريدُ",26,"د",1,0],["غَبَرتُ أَسيراً في يَدَيهِ وَمَن يَكُن","لَهُ كَرَمٌ تُكرَم بِساحَتِهِ الأَسرى",27,"ر",2,0],["غُبِقنا الأَذى وَالجاشِرِيَّةُ هَمُّنا","وَنادى ظَلامٌ لا سَبيلَ إِلى الجَشرِ",28,"ر",1,1],["غُبِنْتِ يا أيام لم يلتمسْ","عذركِ حتى المستضامُ الغبينْ",29,"ن",1,0],["غَبَرَتْ لتُبّعِ الهُمامِ ورأيُه","أنّ البقاءَ يَكونُ من أتْباعِها",30,"ع",3,0],["غَبَروا فأضْحتْ بالثّناءِ كَفيلةً","فمتى بَدَتْ أثْنَتْ على صُنَّاعها",30,"ع",3,0],["غبطتم صاحب الثرو","ة والزاهد لا يغبط",31,"ط",1,0],["غِبْتُمْ فَأَظْلَمَ يَوْمِي بَعْدَ فُرْقَتِكُمْ","وَسَاءَ صُنْعُ اللَّيَالِي بَعْدَ إِجْمَالِ",32,"ل",1,0],["غِبْتَ عَنِّي مَدَى ثَلاثٍ فَزَادَتْ","حَسَرَاتِي وَغَابَ أُنْسِي وَحَظِّي",33,"ظ",2,0],["غَبْنٌ عَلَى هَذِي العُيُو","نِ تُعَاضُ بِالتُّرْبِ اكْتِحَالاَ",34,"ل",2,0],["غُبِنْتْ فِي الْخِيَارِ غَبْناً جَسِيماً","لَكِنِ اعْتَاضَتِ اعْتِياضاً كَرِيما",35,"م",2,0],["غَبرَتْ وَقَائِعُ لَمْ تَكُنْ مُسْتَنْشَداً","فِيهَا وَلاَ اسْمُكَ مَالِيءَ الأَنْبَاءِ",36,"ا",2,0],["غُبارُ رحَى الهيجاء في لَهَواتِهم","من الشهْدِ أحْلَى أو من المسكِ أضْوَع",37,"ع",1,0],["غبتم ، فأظلم يومي بعد فُرقَتِكم","وساء صُنعُ الليالي بعد إجمالي",38,"ل",2,0],["غبرت بي في صباح باكر","فتنة العين وشغل الخاطر",39,"ر",1,1],["غَبْرَ حُبٍّ لسُلَيْمَى، لمْ يَزِدْ","فيهِ إسْعافٌ، وَلم يَنقُصْهُ ضَنّ",40,"ن",1,0],["غِبْتَ وما غبتَ عن ضميري","وصرْتَ فرحتي وسروري",41,"ر",2,1],["غب إلا إلى مليك السماء","الى من يزيده بالتَوَاه",42,"ا",2,0]]}