{"poems":[[99,"لا البرء زار ولا خيالك عادا","https://www.aldiwan.net/poem24991.html","الكامل"],[92,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[107,"بني الملوح لا حام ولا واق","https://www.aldiwan.net/poem43577.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54915","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54641","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54267","المجتث"],[121,"يوم الشَّنق","https://www.aldiwan.net/poem24032.html","الكامل"],[215,"يا مخلفا ودموع القلب تتبعه","https://www.aldiwan.net/poem46292.html","البسيط"],[230,"يا راميا من تحت أج","https://www.aldiwan.net/poem55195.html","مجزوء الكامل"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[612,"","https://poetry.dctabudhabi.ae/diwan/poem/82799","الكامل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80236","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27664","البسيط"],[2284,"","https://poetry.dctabudhabi.ae/diwan/poem/143054","البسيط"],[4755,"وَطَنًا أرِيدُ الآنَ يا خَوَنَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=191998",""],[5410,"ثورة أنين","https://www.poetsgate.com/ViewPoem.aspx?id=133057",""],[5861,"كأس زادني سكرا","https://www.poetsgate.com/ViewPoem.aspx?id=188262",""],[6327,"لامية الهمج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86571&r=&rc=6",""]],"verses":[["ماذا صنعت بناظر لا ينثني","متطلعاً متلفتاً مرتادا",0,"د",2,0],["ماذا صنعتُ بنفسي قد أحَقْتُ بها","ما لم يُحقْهُ ب«روما» عسفُ «نيرون»",1,"ن",1,0],["ماذا صنعتم بخيلِ اللهِ حين دعا","يَسْتَصرِخُ الحيَّ منكم كلُّ نَعَّاقِ",2,"ق",1,0],["مَاذَا صَنَعْتَ وَقَدْ وَرِثْتَ صَحِيفَةً","تحيَا بِهَا فِي بَسْطَةٍ وَيَسَارِ",3,"ر",1,0],["مَاذَا صَنَعْتِ لإِنْصَافِ النِّسَاءِ وَكَمْ","دَفَعْتِ عَنْهُنَّ مِنْ كَيْدٍ وَمِنْ رِيَبِ",4,"ب",1,0],["مَاذا صَنَعْتِ وَلَمْ تُخْطِئْكِ مَأْثِرَةٌ","لِلْعِلْمِ وَالفَنِّ وَالأَخْلاَقِ والأَدَبِ",4,"ب",1,0],["ماذا صنعتَ بعلْمٍ","وما صنعتَ بفَنّ",5,"ن",1,0],["ماذا صَنَعْتُمْ يا رِفاقُ؟ وما عسى","أن تَصنعوا؟ وَزْنُ العَميلِ ذُبابُ",6,"ب",1,0],["ماذا صنعت أجبنى هل صنعت سوى","ما يأمر الحب من فتك وإغواء",7,"ا",2,0],["ماذا صَنَعتَ ودونَ ما","حاوَلتَ أَسيافٌ تُسَلُّ",8,"ل",1,0],["ماذا صَنَعتَ بِما جاهَدتَ تُبدِعُهُ","تَحتَ النَصيحَةِ مِن لَومٍ تَرقَعُهُ",9,"ه",1,0],["ماذا صَنَعنَ بِفاتن وَمُنعم","وَجَليل شَيب جاءَها وَصَغير",10,"ر",1,0],["ماذا صَنَعتُم قَد أَثَرتُم فِتنَةً","بَيني وَبَينَكُمُ وَبَينَ فُؤادي",11,"د",2,0],["ماذا صفاتُ رجالي إنهم صبروا","على المكاره في نور وفي غسق",12,"ق",1,0],["ماذا صنعتُ لكي تأبى محاورتي","وكيف ترضى باحزاني وأتعابي",13,"ب",2,0],["ماذا صَنَعتُمْ؟ إنَّ أطهَرَكُم","مَن لَم يُقَشِّرْ مَرَّةً عَفَنَهْ",14,"ن",2,0],["ماذا صنعنا سوى تفنيد نائحةٍ...؟","ماذا جنينا سوى الأحقاد والكذبا...؟",15,"ب",2,0],["ماذا صنعْتَ بحبِّنا","كأسُ العذابِ يزيدُ سُكرا",16,"ر",2,0],["ماذا صَنعتَ سِوى الأَحقادِ تَقْتُلُنا","ماذا بَنَيْتَ سِوى التَزييفِ والزَّلَلِ",17,"ل",1,0]]}