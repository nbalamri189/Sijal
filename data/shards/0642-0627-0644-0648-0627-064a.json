{"poems":[[71,"قالوا يجوز خمول شخص في الصبا","https://www.aldiwan.net/poem29014.html","الكامل"],[102,"قتيلان .. هما القاتل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85961&r=&rc=231",""],[128,"عفا الصفا وانتفى من كوخ ندماني","https://www.aldiwan.net/poem23777.html","البسيط"],[228,"الليل في صدري بدا يظلم","https://www.aldiwan.net/poem41631.html","السريع"],[409,"يافخر دين الله يا من نظمه","https://www.aldiwan.net/poem33981.html","الكامل"],[458,"ست من السنوات جاوز عمرها","https://www.aldiwan.net/poem61591.html","الكامل"],[534,"وصل النظام بقيت يا نجل الأولى","https://www.aldiwan.net/poem37252.html","الكامل"],[534,"قالوا يعاديك جميع الورى","https://www.aldiwan.net/poem37327.html","السريع"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37812","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62507","الرجز"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11943","البسيط"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26425","السريع"],[2261,"","https://poetry.dctabudhabi.ae/diwan/poem/105649","الكامل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28554","البسيط"],[2789,"","https://poetry.dctabudhabi.ae/diwan/poem/21604","الكامل"],[2940,"","https://poetry.dctabudhabi.ae/diwan/poem/113673","المنسرح"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130075","البسيط"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130080","الكامل"],[3637,"","https://poetry.dctabudhabi.ae/diwan/poem/106807","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91848","الكامل"],[4767,"جرح الحيدرية","https://www.poetsgate.com/ViewPoem.aspx?id=178725",""],[4883,"كأس من بُرتقال","https://www.poetsgate.com/ViewPoem.aspx?id=48401",""],[5022,"البردة المالكية","https://www.poetsgate.com/ViewPoem.aspx?id=186512",""],[5792,"ماقال احبك","https://www.poetsgate.com/ViewPoem.aspx?id=180338",""],[5975,"في ولاء آل بيت الرسول","https://www.poetsgate.com/ViewPoem.aspx?id=53465",""],[6102,"قالت لها ..","https://www.poetsgate.com/ViewPoem.aspx?id=184632",""],[6213,"لا لم أيأس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76309&r=&rc=57",""],[6129,"وسقط صدام ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74362&r=&rc=0",""]],"verses":[["قالوا يجوزُ خمولُ شخصٍ في الصِّبا","وعُلاهُ بعدَ الشيبِ قلت يجوزُ",0,"ز",1,1],["قَالُوْا : يَعْتُو ك «أَبِيْ لَهَبٍ»","وَيُصَلِّيْ كَ «الحَسَنَ الْبَصْرِيْ»",1,"ر",2,0],["قالوا يحب أَجل إِنى أَحب متى","كان الهوى سبة يا أهل عمان",2,"ن",1,0],["قالَ وَأَينَ اللَهُ قلتُ اِقتَضى","في الشَرعِ أَلّا يُرحَمُ المغرمُ",3,"م",1,0],["قالَ وَأَينَ العَدل قُلتُ اِنثَنى","مِن هذِهِ الدُنيا فَلا يقدُمُ",3,"م",1,0],["قالوا يجوز لنا بها تأمينه","أبداً بجزيته إذا ما ساعدوا",4,"د",3,0],["قالوا يحف بكَ النعيمُ ألا ترى","بعضَ الحنينِ هو الجحودُ لنائي",5,"ي",1,0],["قَالُوا يَسُبُّ صَحابَةَ الْمُخْتارِ مُجْ","تَهِداً وبالخُلَفاءِ يَفْتَتحُ الْمَقَالْ",6,"ل",1,0],["قَالُوا يُعَادِيكَ جَميعُ الْوَرَى","وأَنْتَ لا تَخْشَى ولا تَفْزَعُ",7,"ع",1,1],["قالوا يُحلِّلُ قُلنا قَتلَ عاشقِهِ","قالوا يُحِرِّم قلنا وَصْلَ مُغرَمِهِ",8,"ه",1,0],["قالوا يحاكي البحر والغَ","يث فقلت أجودُ",9,"د",1,0],["قالوا يَسُبُّكَ طُغريلُ وَتُهمِلُهُ","فَقُلتُ أَخشى عَلى عِرضي مِنَ الواشي",10,"ش",2,1],["قالَ وَأَينَ البَحرُ مِن جودِهِ","قُلتُ وَلا أَضعافُهُ أَبحُرُ",11,"ر",1,0],["قالوا يحاذر قلت مما","قيل من هذا الرنين",12,"ن",1,0],["قالوا يُغَرُّ بِهِم جَهلاً وَعِندَهُمُ","مِنَ المَواعِظِ فيكِ المَوتُ وَالخَرَفُ",13,"ف",1,0],["قالوا يناك فَقُلتُ في جَوفِ اِستِهِ","وَبِذاكَ خَبَّرَني الصَدوقُ الفاضِحَه",14,"ح",2,0],["قالوا يد المنجكيِّ ذو الرُّتَبِ","آلمها النار قلت من عَجَبِ",15,"ب",1,1],["قالوا ينال نصيباً كلُّ مجتهدٍ","وها نصيبك من نصب ومن عطلِ",16,"ل",1,0],["قالوا يئستِ وليس هذا حكمةً","والحزنُ لا يجدي لديه ملامُ",17,"م",1,0],["قَالُوا يُحِبُّكَ مضن تُحِبُّ فَهِمتُ حُب","باً فُهتُ ذَاكَ ومِستُ كالنَّشوَانِ",18,"ن",1,1],["قالوا يقال الشعرُ يرفعُ أَهلَه","وَيُجِلّ ناظمَه فيُعطَى ما سألْ",19,"ل",1,1],["قالوا: يدُ الإرهاب والفكرُ الذي","تعلو بنشر ضلاله الأصوات",20,"ت",1,0],["قالوا: ياسهل السؤال الصعب يا بوخليل","جاوب ولا تترك الغارب عليه الحبال؟!",21,"ل",1,0],["قالوا يذمّونه لا مرحبا بهوى","فقلت (بل أنتمو لا مرحبا بكمِ",22,"م",1,0],["قالوا يحبك قلت لاتظلمونه","قالو يبيك وقلت ياناس تكفون",23,"ن",1,1],["قالوا يقولُ الشعرَ مفتوناً به","والشعرُ للغاوينَ في القرآنِ",24,"ن",1,0],["قالُوا : يُدَوِّرُ ناهِدَيكِ بِكَفِّهِ","فَرَجِعتُ أَضرِبُ بِالكُفُوفِ عَلَى الثَّرَى !",25,"ر",2,0],["قالُوا : يُضِيءُ بِوَجنَتَيكِ بُدُورَها","فَرَجِعتُ أَشكُو مِنْ دَياجِيرِ الكَرَى !",25,"ر",2,0],["قالوا يئستَ فقلت لا لم أيأسِ","ما زلت أؤمن بالطريق التربوي",26,"و",2,0],["قالوا يموت بحب الشعب بل كذبوا","بل قاتل الشعب ملعون وما ولدا!",27,"د",2,0]]}