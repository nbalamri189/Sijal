{"poems":[[55,"لواعج الشوق تخطيهم وتصميني","https://www.aldiwan.net/poem29744.html","البسيط"],[29,"لقد نادى أميرك باحتمال","https://www.aldiwan.net/poem5957.html","الوافر"],[64,"رأيت رجالا يطلبون مساءتي","https://www.aldiwan.net/poem52413.html","الطويل"],[107,"","https://poetry.dctabudhabi.ae/diwan/poem/49158","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85455","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42644","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54620","البسيط"],[189,"لا أظلم البين حالي كالذي كانا","https://www.aldiwan.net/poem14679.html","البسيط"],[409,"يا سعد خذ بأبي وأمي","https://www.aldiwan.net/poem33426.html","مجزوء الكامل"],[409,"وقفت على السؤال وما حواه","https://www.aldiwan.net/poem34131.html","الوافر"],[445,"مكارمك اغتباقي واصطباحي","https://www.aldiwan.net/poem34896.html","الوافر"],[463,"يا صاحبي شكواي هل ناصر","https://www.aldiwan.net/poem55841.html","السريع"],[463,"ظن غداة الخيف أن قد سلِما","https://www.aldiwan.net/poem55900.html","الرجز"],[463,"خيلك من صفا لك في البعاد","https://www.aldiwan.net/poem56233.html","الوافر"],[466,"يعجز في مدحه وقد علمت","https://www.aldiwan.net/poem15447.html","المنسرح"],[469,"صفاتك تفغم الآفاق طيبا","https://www.aldiwan.net/poem3170.html","عموديه"],[520,"العلم مذ كان محتاج إلى العلم","https://www.aldiwan.net/poem12262.html","البسيط"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34424","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38928","البسيط"],[440,"","https://poetry.dctabudhabi.ae/diwan/poem/47497","الوافر"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111878","البسيط"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87867","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100974","الوافر"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124720","السريع"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124742","البسيط"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71068","البسيط"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71052","البسيط"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89533","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27274","الرمل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28013","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202722","المتقارب"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89270","الوافر"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85278","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131015",""],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66558","الكامل"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88568","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111496","البسيط"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136693",""],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104517","المجتث"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147299","الرمل"],[4778,"بلاد الله واسعة","https://www.poetsgate.com/ViewPoem.aspx?id=193472",""],[4954,"ألْمَحتُ بَدْرًا","https://www.poetsgate.com/ViewPoem.aspx?id=207791",""],[5183,"ملغزة رق299م","https://www.poetsgate.com/ViewPoem.aspx?id=186408",""],[5183,"الخال","https://www.poetsgate.com/ViewPoem.aspx?id=186611",""],[5302,"ملهوف","https://www.poetsgate.com/ViewPoem.aspx?id=200778",""],[5913,"جريمة حب","https://www.poetsgate.com/ViewPoem.aspx?id=177073",""]],"verses":[["فَإِن أُصَب فَمَقاديرٌ مُحَجَّزَةٌ","وَإِن أُصِب فَعَلى الطَيرِ المَيامينِ",0,"ن",1,0],["فَإِن أَصبَحتَ تَطلُبُ ذاكَ فَاِنقُل","شَماماً وَالمِقَرَّ إِلى وِعالِ",1,"ل",1,0],["فانْ أَصطلِحْ والدهرَ أَجعَلْ مودَّتِي","ويُسري لمن واسَى وساعدَ في العُسْرِ",2,"ر",1,0],["فإن أُصِبْتَ فمن سَمَّى على قدرٍ","وليس للنفسِ إلا غايةُ الأَجَلِ",3,"ل",1,0],["فإن أَصبت فَهَذا نافع حسنٌ","أَو كنت أَخطأت فيها فليردوني",4,"ن",2,0],["فَإِنْ أَصَبْتُ فَعَنْ رَأْيٍ مَلَكْتُ بِهِ","عِلْمَ الْغُيُوبِ وَرَأْيُ الْمَرْءِ نَاظِرُهُ",5,"ر",2,0],["فَإِنْ أَصَاخُوا لِمَا تُمْلِيهِ وَاسْتَمَعُوْا","فَاخْبِرْهُمُ عَنْ بَنِي السُّودَانِ خَيْرَ نَبَا",6,"ب",2,0],["فإن أصِل فهْي عاداتٌ عُرِفت بها","أو لا فلم تبقِ للإِحسان إمكانا",7,"ن",2,0],["فأنا صريع رضابها","من غير عصيان وإثم",8,"م",1,0],["فإن أصغى لفطرته قليلاً","رأى الأقوال في موج اضطراب",9,"ب",1,0],["فإِنْ أَصبحتُ مُنْتَشِياً بنُعْمى","تُواليها فشُكْرُ الحُرِّ صَاحِ",10,"ح",1,0],["فإن أصاختْ لي فقولا لها","عنِّي عسى صَعْبتها أن تَلينْ",11,"ن",1,0],["فإن أصاب فرصةً بشمتِهِ","عدوُّكم فطالما قد رُغِما",12,"م",2,0],["فإن أصبْر ولم أصبر رُجوعاً","إلى جَلدٍ ولم أحمل بآدِ",13,"د",1,0],["فان أصبْتُ الصَّوابَ في مِدَحي","فللقوافي وخاطِري طَرَبُ",14,"ب",1,0],["فان أصبحت عن طرفي بعيداً","لقد أصبحت من قلبي قرينا",15,"ن",2,0],["فإن أصبت فلي حظ المصيب وإن","أخطأت قصدك فاعذرني ولا تلم",16,"م",1,0],["فَإِن أَصبحَت مَن هامَ قَلبي بحسنها","مهاجرةً أَمسَت دموعيَ أَنصاري",17,"ر",2,0],["فَإِنْ أَصِلْهُ بِتَقبيلٍ فَلا عَجب","فَإِنّما الخالُ مِن لَحمي وَمِن دمِيا",18,"ي",2,0],["فَإِنْ أَصْبِرْ فَعَنْ إِفْراطِ جَهْدٍ","وَانْ أَقْلَقْ فَحَسْبُكَ مِنْ قَلوقِ",19,"ق",1,0],["فان اصبتُ فما لي مَن يقاسمني","صفوي ولا كدري ان كنت لم أَصبِ",20,"ب",1,0],["فان أُصيب الحشا تضدوى عناصرُهُ","والجسم ينحطُّ إِن تطغيهِ شهوتُهُ",21,"ه",1,0],["فإن أصبحت في ركب كرام","بذاك الرفرف الأعلى أراحوا",22,"ح",3,0],["فإن أصاب الثوب شيءٌ فقد","ألزمه النقض بلا عذرِ",23,"ر",1,0],["فإن أصبت بها زيفاً أخذت به","جزءا مسمى من الدينار ما نسبا",24,"ب",2,0],["فإِنْ أُصادِفْ بهذا النُّجْحَ فُزْتُ وإِنْ","أُحْرَمْ فأَقْرَبُ ما أَنْوي خُراسانُ",25,"ن",1,0],["فإِنْ أَصِرْ مِثْل من قد صيَّرتْهُ يدي","فالله أكبر وَهْوَ العادِلُ الحَكَمُ",26,"م",1,0],["فَإِن أَصحَروا فَالخَيلُ قَيدُ شَريدِهِم","وَإِن حَصَنوا ذابوا لُحوماً وَأَعظُما",27,"م",2,0],["فأنا صخرٌ ومني","تتفجر المعاني",28,"ن",2,0],["فإن أصبتُ فذاك الظنُّ بي وبه","أو لم أصب فهو مني لا من الأحد",29,"د",1,0],["فإن أصحُ لم ألق منها سوى","حديثٍ مضى أو رسوم الدِّمن",30,"ن",1,0],["فإن اصروا على العصيان والجرم","فخل ودا لهم واقطع لوصلهم",31,"م",1,0],["فإن أصبحت لم ترشد لرأيٍ","جلاه في المِسالك في المَسالك",32,"ك",1,0],["فإن أصل الهدى توحيد خالقنا","لا الاتحاد فبالغ في تجنبه",33,"ب",2,0],["فإن أصلحت بالعلم حوران أصبحت","بلادا يراها جنة من يرودها",34,"د",3,0],["فإِنَ اصْطفاكَ لِنَفْسِهِ","فَلَيَسْعَدَنَّ بِمَنْ تَخَيَّرْ",35,"ر",1,0],["فإنا صابرون ومنظوركم","إلى يوم التغابن والخصام",36,"م",1,0],["فَإِنَّ أَصلَهُما في الأَرضِ يَنتَشِرُ","وَلا يَروعُهُما ريحٌ وَلا مَطَرُ",37,"ر",1,0],["فان أصبتُ علواً في الأنام فقد","جئتُ المعالي وجاءتني على قدر",38,"ر",1,0],["فإن أصيبت بصدع","رفته أخلاق جعفر",39,"ر",1,0],["فأنا صرت مثالا","للذي يبغي التأسي",40,"س",2,0],["فإن أصدرت لا تأتم فيه","وإن أوردت يغشاه الذهولُ",41,"ل",1,0],["فإن أصْغرتْني وادَّعتْ قِلّةَ الْغنَى","فإنّي وربّي ما قدَ اسْخطتُ حالِيَا",42,"ي",2,0],["فإن أصر على ذنب أتاه ولم","يرجِع فعاقبةُ الإصرار خسران",43,"ن",1,0],["فإن أصب ثغرات الحق فيه فقد","وفقت أما سواه فهو مجتنب",44,"ب",1,0],["فإن أصخت أتاك القلب في وله","والنفس طامعة في أي تخفيف",45,"ف",1,0],["فإن أصبحت ترقبني الليالي","فأخفض خشية منهن همسي",46,"س",2,0]]}