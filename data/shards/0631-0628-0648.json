2,"ن",1,0],["ربُّوا بَنِيكُمْ فَقَدْ صِرْنَا إِلَى زَمَنٍ","طَارَتْ بِهِ النَّاسُ كَالْعِقْبَانِ والرَّخَمِ",3,"م",1,0],["ربّوا البنين مع التعليم تربية","يُمسي بها ناقص الأخلاق مُكتَمِلا",4,"ل",2,0],["ربَّ وجناء ضامر تقطعُ البي","دَ على أثرِ ضامر وجناء",5,"ا",2,0],["ربوة الحلم قد أدار عليها","منطقي قهوة المدائح مزّه",6,"ز",2,0],["رب وامعتصماه انطلقت","ملء أفواه البنات اليتم",7,"م",1,0],["رُبَّ وعدٍ مُقَدَّمٍ لَعَليٍّ","نَتَجَ اللّه منه غوثاً ورفداً",8,"د",2,0],["رُبّ وانينَ أيْقظُوكَ لأمرٍ","ثُم نامُوا وأنت في إيفاض",9,"ض",1,0],["رب واد أحلَّ من بعد إحرا","م فأضحى عفاؤه محلوقا",10,"ق",2,0],["ربّوه بالله فيما","يشرف المسلمينا",11,"ن",2,0],["رَبّوا عَلى الإِنصافِ فِتيانَ الحِمى","تَجِدوهُمُ كَهفَ الحُقوقِ كُهولا",12,"ل",2,0],["رُبَّ واهي الجَأشِ فيهِ قَصَفٌ","ماتَ بِالجُبنِ وَأَودى بِالحَذَر",13,"ر",1,0],["ربوعٌ تُمرُّ الريح فيها فتكتسي","بها أَرَجاً هوجُ الرياحِ الهواجمِ",14,"م",1,0],["رُبَّ وَصلٍ بَعدَ صَدٍّ","وَقِلاً بَعدَ وِصالِ",15,"ل",1,0],["رَبَوا لَدَيكَ فَلَولا أَنَّ بَعضَهُمُ","تُجَلَّ عَنهُ لَقُلنا يا أَبا البَشَرِ",16,"ر",1,0],["رُبوعُكَ بَعدَ بَهجَتِها طُلولٌ","وَحاليها مِنَ الأَنوارِ خالِ",17,"ل",1,0],["ربوعٌ رَبَعْتُ اللهوَ والكاسَ والصِّبا","بها مُكْرَماً بالوصلِ عند الكرائمِ",18,"م",1,0],["ربوعٌ بعثتُ الطرفَ فيهنّ خاشعاً","وإن كان بُعْد العزّ يمتنح القربا",19,"ب",2,0],["رَبِّ وَفِّقني وَكُن عَوني عَلى","شُكرِ ما أَولَيتَني مِن مِنَنِ",20,"ن",1,0],["رُبوعُ المَساعي عامِراتٌ بِسَعيِهِ","وَيُقفِرُ مِنهُ غِمدُهُ وَحَمائِلُه",21,"ل",2,0],["رب وادٍ كأنّه النَّهَرُ الأَخ","ضر يختال في برودِ الجمال",22,"ل",1,0],["ربوع تَغشَّاها البلى وَمنازل","تغير بعد الظاعنين عهودها",23,"د",3,0],["رَبُّوا كَما رَبَّى وصَانُوا وُلْدَهُمْ","أدَباً كَمَا هُو صَانَهُمْ مِنْ عَابِ",24,"ب",1,0],["رَبِّ وَما لي سِواكَ رَبٌّ","ردَّ رُقادي أَقل عثاري",25,"ر",2,0],["رب وامعتصماه انطلقت","ملء أفواه الصبايا اليتّم",26,"م",1,0],["رَبُّوهُ يَنْمو ثَمَراً طيِّباً","لا ييأسُ الزراعُ من بَذْرِهِ",27,"ر",2,0],["ربُّوه في الريفِ لعلَّ القرَى","تُصْلِحُ ما أَعْضَلَ من أمْرِه",27,"ر",2,0],["ربوعٌ تلوح وراءَ حروفٍ","تريك مآذَنها والقبابا",28,"ب",2,0],["رَبُّوا على الخُلُق الشَّبِيبَةَ واصقُلُوا","نَزَعاتِها ومُيُولَها بصِقالِهِ",29,"ل",2,0],["رَبُّوا الشَّبابَ على الفَضيلة؛ إنَّها","هي زَينُ مُزْدَانٍ، وحِلْيَةُ حَالِ",30,"ل",1,0],["ربوا لكم بالظبي والسمر ملتكم","وأنتم الآن تجار ورهبان",31,"ن",1,0],["ربوع بحمد الله نور \"محمد\"","عليها بنور الله أبلج ساطع",32,"ع",1,0],["ربوعُ مسرَّةٍ طابت مُناخاً","وراقت مَربعاً ، وحلَتْ مَقيلا",33,"ل",2,0],["رُبَّ \" وادٍ \" بادي المقاتِلِ تعلوهُ","الأخاديدُ كالجروح الرِّغاب",34,"ب",1,0],["رب وقت صفا لخصم جهول","وكواه ذاك الصفاء بنار",35,"ر",1,0],["ربوعٌ خَلا منها مكاني وما خَلَتْ","رسومٌ لها من خاطرِي ورُبوع",36,"ع",1,0],["ربُّوا لذا الشرق يا قومي ممرِّضةً","تحنو عليهِ بإِحساس ووجدان",37,"ن",1,0],["رَبُّوا له الأَّمَّ يا قومي فلو وُجدت","في الشرق ما طاح في ذلّ واهوانِ",37,"ن",1,0],["رُبوعُ ديارٍ بالعزيز عزيزةٌ","يطاول فيها مجدُه الأَنجمَ الزُهْرا",38,"ر",2,0],["رُبَّ وَجْدٍ بعدَ هَجْرٍ","باتَ شرّاً مستطيرا",39,"ر",2,0],["ربّ وفّقني لرشدٍ","ثمّ هب لي منك ملكا",40,"ك",2,0],["ربوافى ربا روض النَعيم وظله","فجدد لهم من جودك النعمة الخضرا",41,"ر",2,0],["رُبوعُ الهَوى أَمّا الهَواءُ فَشَمأَلٌ","بِهِنَّ وَأَمّا الماءُ فَهوَ شَمولُ",42,"ل",1,0],["ربوعُ الشآمِ","بروجُ العلاءْ",43,"ا",2,0],["رب وأدخلنا جميعاً","في العباد الصالحينا",44,"ن",2,0],["رب وأدخلنا جنانا","أزلفت للمتقينا",44,"ن",2,0],["ربّ وعّث مَن رام جفواً لمجدٍ","ربّ أَفعم مُروج منثال جودِ",45,"د",1,0],["ربّ وعّث مَن راعَ مجدا جفاهُ","وَاِنصرِ المجدَ واِطف ربث جمودِ",46,"د",1,0],["ربّ واِرفَع مَنجى مؤثّل مجدٍ","رَفع ربوٍ ما جمّ منثال جودِ",46,"د",1,0],["رب والكون كله صفحات لك","فيها الأسرار والآلاءُ",47,"ا",2,0],["ربّ والكائنات روحك فيها فم","داها صيرورةٌ لا فناءُ",47,"ا",2,0],["رب والناس كالقطيع وهذي الدار","الدنيا لها صحراء",47,"ا",2,0],["رُبوع فَضل إِذا ما بِتّ أَذكُرُها","يَلتَذّ سَمعي كَما يَشتاقُها نَظَري",48,"ر",2,0],["رُبَّ وَعدِ مِنكَ جِئتُ إِلى","نَيلِهِ جَهراً فَلَم أَجِدِ",49,"د",1,1],["ربوعٌ حكت روض الجنان وأهلها","ملائكةٌ في المجمع المتشارك",50,"ك",1,0],["رب وفقنا وسدد واهدنا سبل الجماعه","من صحابي وولى في فعاله واستماعه",51,"ع",2,0],["رب وفقنا وسددنا وخذ","بنواصينا إلى أعلى مقام",52,"م",1,0],["رب وفقنا لما","ترتضي عند القفول",53,"ل",1,0],["رب وفقنا وسددنا لما","ترضه منا على أحسن حال",54,"ل",1,0],["رب وفقنا وسددنا له","واكفنا ياربنا شر العواف",55,"ف",1,0],["رب واصلح للفواد واعطني فوق المراد","أنك الرب الجواد",56,"د",1,0],["رُبُوا في جحور المجد حتَّى ترعرعوا","وفوق جياد الخيل والضمَّرِ الجُرْد",57,"د",1,0],["ربَّ ورقاءَ غَرَّدَتْ فشجتني","وكذاك الحزين يشجي الحزينا",58,"ن",2,0],["ربوع ببرج المجد تسمو كما سمت","بوصف العلي الأسعدي المدايح",59,"ح",1,0],["ربوع الندى من بعد فقدك بلقع","وحقّ العلى والمكرمات مضيّع",60,"ع",1,1],["ربَّ وافي الجمالِ قد زاد فيه","رونقٌ في قميصهِ والعمَّهْ",61,"م",2,0],["رُبَّ وحاشا الكرما","ء سامعٍ لم يسمعِ",62,"ع",1,0],["ربوعٌ وأوطانٌ بها وبأهِلها","بلغتُ لُباناتٍ وقضَّيتُ أوطارا",63,"ر",2,0],["ربِّ وَفِّقنا جَميعاً","واهدِنا سُبلَ الرَّشادِ",64,"د",1,0],["ربوع النيل هذا خير شهمٍ","عَلا لِسما العلى شرفاً وقَدرا",65,"ر",2,0],["رَبَوا في ظِلِّهِ فَهُمُ قَناةٌ","غَداةَ الطَّعنِ وَهُوَ لَها سِنانُ",66,"ن",1,0],["ربوع الشّآمِ بروجُ العُلا","تُحاكي السّماءَ بعالي السَّنا",67,"ن",2,0],["ربوة الفخر بهجة الدهر شم","س المجد بدر الإصدار والإيراد",68,"د",1,0],["رَبِّ وَعَجِّل قَطعَهم","بِسَيفِ قَهرِكَ المُبيرْ",69,"ر",1,0],["رَبِّ وَهَبنا يا سَلامْ","حُسنَ الرّضاءِ وَالخِتامْ",69,"م",1,0],["رَبِّ وَاِمْنَحْهُ نَعيماً","ما لَهُ مِنكَ اِنقِضاءُ",70,"ا",2,0],["رُب وصل قد جاء إثر فراق","وصدود أدلته بتلاق",71,"ق",1,1],["ربوع عافها قلبي بكره","كما عافت مواردها الحمام",72,"م",1,0],["رَبِّ واحْرُسْ إيمانَهُ بِكَ رَبًّا","وإلهًا يَا ذَا الصِّفاتِ الحَنُونَةْ",73,"ن",2,0],["ربوع لدفع المستهام فواقع","وصفوا وداد العامرية صفاها",74,"ا",3,0],["ربوع الجامعين استوقفيني","سقاك مضاعف الغيث الهتون",75,"ن",1,1],["رُبُوع إذَا مَا اللَّيْلُ أظْلَمَ أشْرَقَتْ","بِآفَاقِهَا تِلْكَ النُّجُومُ الزَّوَاهِرُ",76,"ر",1,0],["ربوع كم بها جرّر","تُ أذيالاً وأردانا",77,"ن",2,0],["ربوعٌ بها كم كنت قمتُ ملبّياً","لِداعٍ دعاني للهوى ومعادِ",7