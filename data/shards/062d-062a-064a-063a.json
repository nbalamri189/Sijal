{"poems":[[86,"لم يبق شيء من الدنيا بأيدينا","https://www.aldiwan.net/poem10507.html","البسيط"],[86,"ما لي أرى بحر السياسة","https://www.aldiwan.net/poem10920.html","مجزوء الكامل"],[88,"أن بليلا من نسيم السحر","https://www.aldiwan.net/poem44414.html","الرجز"],[88,"لقيتها ليتني ما كنت القاها","https://www.aldiwan.net/poem44448.html","البسيط"],[88,"يا موطنا ما انتضيناها مهندة","https://www.aldiwan.net/poem44465.html","البسيط"],[88,"هي المواطن أدنيها وتقصيني","https://www.aldiwan.net/poem44815.html","البسيط"],[37,"حتى غدا ورضاب الماء يتبعه","https://www.aldiwan.net/poem6896.html","البسيط"],[37,"حتى غدا وغدا له ذو بردة","https://www.aldiwan.net/poem7459.html","الكامل"],[72,"ما زلت أقلع شيبة نسخت بها","https://www.aldiwan.net/poem18541.html","الكامل"],[72,"ديار شعري سقاك السعد ماطره","https://www.aldiwan.net/poem18709.html","البسيط"],[72,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[51,"بان شبابي فعز مطلبه وانبت بيني وبينه نسبه","https://www.aldiwan.net/poem8518.html","المنسرح"],[51,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[51,"الدين والعلم والنعماء والشرف","https://www.aldiwan.net/poem65471.html","البسيط"],[38,"بان الأحبة بالعهد الذي عهدوا","https://www.aldiwan.net/poem7699.html","البسيط"],[38,"فلا يكونن موعودا وأيت به","https://www.aldiwan.net/poem7816.html","البسيط"],[92,"بيت بنته لي الحياة من الشذى","https://www.aldiwan.net/poem38908.html","الكامل"],[78,"زهر الأسنة في الهيجا غدت زهري","https://www.aldiwan.net/poem14261.html","البسيط"],[43,"لا خيل عندك تهديها ولا مال","https://www.aldiwan.net/poem10136.html","البسيط"],[28,"فقلت للنفس هذي منية صدقت","https://www.aldiwan.net/poem5099.html","البسيط"],[28,"تمسي الرياح بها وقد لغبت","https://www.aldiwan.net/poem5127.html","الكامل"],[44,"رقت حواشي الدهر فهي تمرمر","https://www.aldiwan.net/poem30510.html","الكامل"],[102,"برقت له مسنونة تتلهب","https://www.aldiwan.net/poem33042.html","الكامل"],[102,"رأيتها ألف مرة","https://www.aldiwan.net/poem33121.html","المجتث"],[67,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[75,"قولا لمعتقل الرمح الرديني","https://www.aldiwan.net/poem69026.html","الطويل"],[48,"أمنك للمكتوم اظهار","https://www.aldiwan.net/poem63369.html","السريع"],[48,"بدير بهرذان لي مجلس","https://www.aldiwan.net/poem65291.html","السريع"],[50,"يا شوق من بات مشغوفا ومجتنبا","https://www.aldiwan.net/poem64811.html","البسيط"],[7,"بانت سعاد وأمسى حبلها انجذما","https://www.aldiwan.net/poem1973.html","البسيط"],[8,"إما تري ظلل الأيام قد حسرت","https://www.aldiwan.net/poem21815.html","البسيط"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/141022",""],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55232","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55144","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54584","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54949","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54327","المنسرح"],[106,"أدب الوزراء","https://www.poetsgate.com/ViewPoem.aspx?id=179506",""],[45,"أأفاق صَبٌّ مِنْ هَوىً، فأُفِيقَا","https://www.poetsgate.com/ViewPoem.aspx?id=32851",""],[88,"إذا انقضى مارْتُ فاكسر خلفه الكوزا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19529&r=&rc=32",""],[113,"قلب تفطر من فراقك","https://www.aldiwan.net/poem41527.html","مجزوء الكامل"],[118,"حثا شرابهما في ظل حسان","https://www.aldiwan.net/poem49285.html","البسيط"],[124,"هذا الربيع بنور الحسن وافانا","https://www.aldiwan.net/poem805.html",""],[130,"أني على هيمى مى تلحاني","https://www.aldiwan.net/poem54712.html","البسيط"],[131,"هذا ابن حجاج تفاقم أمره","https://www.aldiwan.net/poem4201.html","الكامل"],[141,"ما في المعالي مطمع لسواكا","https://www.aldiwan.net/poem11788.html","الكامل"],[183,"انظر إلى مستنزه الأنفس","https://www.aldiwan.net/poem14704.html","السريع"],[187,"الحمد لله الغني الأحد","https://www.aldiwan.net/poem35111.html","الرجز"],[187,"حياك يا طيبة حياك","https://www.aldiwan.net/poem35152.html","السريع"],[227,"يا من به تزهى الدهور","https://www.aldiwan.net/poem51062.html","مجزوء الكامل"],[227,"قد أغتدي قبل طلوع الفجر","https://www.aldiwan.net/poem51066.html","الرجز"],[233,"يا من جلا بقدومه ال","https://www.aldiwan.net/poem31609.html","مجزوء الكامل"],[233,"ما كنت أول حافظ لمضيع","https://www.aldiwan.net/poem31823.html","الكامل"],[233,"شكري لسيب نوالك الغمر","https://www.aldiwan.net/poem31998.html","الكامل"],[280,"يا راكب الناقة الوجناء يزجيها","https://www.aldiwan.net/poem32302.html","البسيط"],[295,"هذا الحجاز وذاك ضاله","https://www.aldiwan.net/poem33196.html","مجزوء الكامل"],[318,"كانت دمنهور لنا","https://www.aldiwan.net/poem61672.html","مجزوء الكامل"],[326,"الحمد للَه على ماق ضى","https://www.aldiwan.net/poem54955.html","الكامل"],[326,"كبرت للروح الأمين","https://www.aldiwan.net/poem55004.html","مجزوء الكامل"],[348,"أقفر من سلمى يناضيبُ","https://www.aldiwan.net/poem641.html",""],[351,"يا مالك الملك العزيز","https://www.aldiwan.net/poem39573.html","مجزوء الكامل"],[351,"أرجى الوسائل طه أكرم الرسل","https://www.aldiwan.net/poem39998.html","البسيط"],[351,"جلت لنا هذه الآداب والصور","https://www.aldiwan.net/poem40190.html","البسيط"],[362,"لما تراءت راية الربيع","https://www.aldiwan.net/poem60555.html","الرجز"],[362,"ورد الخدود ودونه شوك القنا","https://www.aldiwan.net/poem60636.html","الكامل"],[369,"مازال ينحلني أبو الجيش اسمه","https://www.aldiwan.net/poem56945.html","الكامل"],[369,"ما زلت تركبها عتاقا سبقا","https://www.aldiwan.net/poem56983.html","الكامل"],[374,"دنت العناصر من علائك","https://www.aldiwan.net/poem59306.html","مجزوء الكامل"],[374,"ثق إنما الأحزان سبك ضيق","https://www.aldiwan.net/poem59318.html","الكامل"],[374,"أفنظم در ما أره نفيسا","https://www.aldiwan.net/poem59382.html","الكامل"],[374,"قالت إليك فقلت طرفي أرمد","https://www.aldiwan.net/poem66873.html","الكامل"],[374,"يا صاح إسمع مذ سمت","https://www.aldiwan.net/poem66909.html","مجزوء الرجز"],[390,"يا أهل سارية السلام عليكم","https://www.aldiwan.net/poem53632.html","الكامل"],[399,"عيد ثغور الأماني فيه تبتسم","https://www.aldiwan.net/poem46932.html","البسيط"],[400,"أشغلت بالورقا عن الأوراق","https://www.aldiwan.net/poem33625.html","الكامل"],[436,"هل يجهل السمت من يستوضح الطرقا","https://www.aldiwan.net/poem34833.html","البسيط"],[438,"عرج على وادي العقيق","https://www.aldiwan.net/poem14319.html","مجزوء الكامل"],[438,"خل الكئيب بدائه في ذاته","https://www.aldiwan.net/poem14341.html","الكامل"],[445,"لمن الديار عرفتها وكأنها","https://www.aldiwan.net/poem2172.html","الكامل"],[451,"وددت أهدي طويل العمر من أدبي","https://www.aldiwan.net/poem61568.html","البسيط"],[451,"الشاعر القروي في تكريمنا","https://www.aldiwan.net/poem61569.html","الكامل"],[491,"كأنما ادخر الرحمن معظمة","https://www.aldiwan.net/poem67336.html","البسيط"],[513,"جاوز بمجدك أنجم الجوزاء","https://www.aldiwan.net/poem11996.html","الكامل"],[513,"لا وعيون لحظها ساهر","https://www.aldiwan.net/poem12116.html","السريع"],[527,"قل لعلي نالا","https://www.aldiwan.net/poem37249.html","مجزوء الرجز"],[527,"هذا العقيق فقف على أبوابه","https://www.aldiwan.net/poem37529.html","الكامل"],[556,"يا طلعة الشمس أو يا طلعة القمر","https://www.aldiwan.net/poem34551.html","البسيط"],[562,"يا من هواه بقلبي قد حجى ورسى","https://www.aldiwan.net/poem900.html",""]],"verses":[["حَتّى غَدَونا وَلا جاهٌ وَلا نَشَبٌ","وَلا صَديقٌ وَلا خِلُّ يُواسينا",0,"ن",2,0],["حَتّى غَدَوتَ أَباً لَهُ","أَضحَت عِيالُ القُطرِ وُلدا",1,"د",2,0],["حتى غدا البلبل منذ الصغر","في حبّها منطلق المقول",2,"ل",1,0],["حتى غدا جسمها بالبرد مرتجفا","كالغصن في الريح واصطكّت ثناياها",3,"ا",3,0],["حتى غدا جُلُّه للنار مَأكلةً","وما تزحزح شبراً عن مكانته",4,"ت",2,0],["حتى غدَوْت طريداً للغراب بها","وما غدوت طريداً للشواهين",5,"ن",1,0],["حتى غدا ورُضابُ الماء يتبعه","طيَّانَ لا سَأمٌ فيه ولا خَضَدُ",6,"د",1,1],["حتى غدا وغدا له ذو بُرْدَةٍ","شثن البنان عَدَبَّس الأوصالِ",7,"ل",1,1],["حتَّى غدت صفحات وجهي آيةً","لا ناسخ فيها ولا منسوخ",8,"خ",1,0],["حتَّى غدا بخمارِ القربِ في طربٍ","بعد البعاد الذي قد كان خامره",9,"ر",2,0],["حتَّى غدت دامية النحور","ساقطة منها على الخبيرِ",10,"ر",1,0],["حتى غدت تلك الضواري صرعى","مجموعة لدى التراب جمْعا",10,"ع",2,0],["حتى غدا بعد المِرا","ح عليه سِربالُ الكآبهْ",11,"ب",2,0],["حتى غدا في ذَراهُ مضطَربٌ","رحبٌ وقد كان ضاقَ مُضطرَبُهْ",12,"ب",2,0],["حتى غدا في حِماهُ مُعتصمٌ","مُغْنٍ وقد كان طال مُنزَرَبُهْ",12,"ب",2,0],["حتى غدا الطرف الأقصى به وسطاً","من بعد ما كانت الأوساط أطرافا",13,"ف",2,0],["حتى غدوتم لآمال الورى قِبَلاً","لها عليها طوال الدهر معتكف",14,"ف",1,0],["حَتّى غَدَت في بَياضِ الصُبحِ طَيِّبَةً","ريحَ المَباءَةَ تَخدي وَالثَرى عَمِدُ",15,"د",1,0],["حَتّى غَدا خَرِصاً طَلّاً فَرائِصُهُ","يَرعى شَقائِقَ مِن عَلقى وَبِركانِ",16,"ن",1,0],["حتَّى غَدَا قلبي كنايٍ متْرعٍ","ثَملٍ من الأَلحانِ والأَنغامِ",17,"م",1,0],["حَتّى غَدَوتُ وَأَعدائي تُخاطِبُني","يا قاتِلَ الناس بِالأَجنادِ وَالفِكَرِ",18,"ر",1,0],["حَتّى غَدَوتَ وَلِلأَخبارِ تَجوالُ","وَلِلكَواكِبِ في كَفَّيكَ آمالُ",19,"ل",1,0],["حَتّى غَدا لَحِماً مِن فَوقِ رابِيَةٍ","في لَيلَةٍ كَفَّتِ الأَظفارَ وَالبَصَرا",20,"ر",2,0],["حَتّى غَبَطنا كُلَّ مُحتَمَلٍ","يُمشى بِأَعظُمِهِ إِلى القَبرِ",21,"ر",1,0],["حَتّى غَدَت وَهَداتُها وَنِجادُها","فِئَتَينِ في خِلَعِ الرَبيعِ تَبَختَرُ",22,"ر",1,0],["حتى غَلَتْ بي ريبة فسألتُهمْ","خانَ السّلاحُ أم المنيَّةُ تكذب",23,"ب",1,0],["حَتّى غَدَوتُ وَما لي","عَلى التَجلُّد قدره",24,"ر",2,0],["حَتى غدا عَنْ طَرِيقِ الوَحْيِ مُنْهَزِمٌ","من الشياطِينِ يَقْفُو إثْرَ مَنْهَزِمِ",25,"م",1,0],["حتَّى غَدَتْ مَلَّةُ الإسلامِ وهِيَ بِهِمْ","مِنْ بَعْدِ غُرْبَتِها مَوْصُولَةَ الرَّحِمِ",25,"م",1,0],["حتى غدوا من طريدٍ في الشعابِ ومن","مُضَرَّجٍ بدَمٍ وردِ الأساريّ",26,"ي",1,0],["حَتّى غَدا أَوطَفَ ما إِن لَهُ","دونَ اِعتِناقِ الأَرضِ إِقصارُ",27,"ر",1,0],["حَتّى غَدا السَكرانُ مِن سُكرِهِ","كَالمَيتِ في بَعضِ أَحايِينِهِ",28,"ن",2,0],["حَتّى غَدا عَبَ عَبّاسٍ وَلا سَبَقٍ","يَتلو يَداً قَدَحَت عَن وَجهِهِ الحُجُبا",29,"ب",2,0],["حَتّى غَدا مِثلَ نَصلِ السَيفِ مُنصَلِتاً","يَقرو الأَماعِزَ مِن لُبنانَ وَالأَكَما",30,"م",2,0],["حَتّى غَلَبنا وَلَولا نَحنُ قَد عَلِمُوا","حَلَّت سَليلاً عَذارِيهِم وَجُمّالا",31,"ل",2,0],["حتّى غدوت وللأخيار تجوالُ","وللكواكب في كفّيك آمال",32,"ل",1,0],["حَتَّى غَدَتْ بِفُنُونِهَا","فِي عِزَّةٍ فَوْقَ المَرَامِ",33,"م",1,0],["حَتَّى غَدَا نُورَ هُدّى","وَمَعْقِداً لِلأَمَلِ",34,"ل",1,0],["حَتَّى غَدَتْ قُدْوَةً فِي العَصْرِ صَالِحَةٍ","لِلْغَانِيَاتِ ذَوَاتِ الجِدِّ وَالدَّأَبِ",35,"ب",1,0],["حَتَّى غَدَا بَيْنَ حُلِيِّ الْعَصْر","مَنَاطُكُمْ مَنَاطَ عِقْدِ الدّرِ",36,"ر",1,0],["حتى غدا صرخةً على فمها","وداع من لن يردّه سفره",37,"ر",2,0],["حتى غدت بطحاءَ مكة تشتهي","في كل عام أن تحج وتحرما",38,"م",2,0],["حتّى غَدَتْ جُشَمُ بنُ بَكْرٍ تبْتغي","إرْثَ النبيّ، وتدّعِيهِ حُقُوقَا",39,"ق",2,0],["حتى غدت وهي في تمور ناكسة","رايات شاه رماه الخلع مجنوزا",40,"ز",2,0],["حتى غدت أرواح أه","ل الحب تحسب من صداقك",41,"ك",1,0],["حتى غدوت وألفاظي لها وقدٌ","كأنما هي من أحشاء بركان",42,"ن",1,0],["حتى غدت من بقايا الصوت مائلة","نشوى وقد حملت ورداً وريحانا",43,"ن",2,0],["حَتَّى غَلَت زَفَرَاتِى في الحَشَا وَعَلَت","هَدَّ إرعِوَائِى رُنوي صَوبَ أظعَانِ",44,"ن",1,0],["حتى غدا ملقى ذبيحاً حاكياً","للناس رقدته إذا هجر الوسن",45,"ن",1,0],["حَتّى غَدَوتَ تَأُمُّها مُستَنهِجاً","قَصدَ السَبيلِ وَجارَ مَن جاراكا",46,"ك",2,0],["حتى غَدْت كالشمس عند الضحى","والبدرِ حسنا في دُجَى الحِنْدِس",47,"س",1,0],["حتّى غَدا في سلكهِ محرّرا","وَصارَ عِقداً لعلاهُ مُحكما",48,"م",2,0],["حتّى غَدا الدينُ به خالصاً","مُنزّهاً عن إفكِ أفّاكِ",49,"ك",1,0],["حتى غدوتُ وناظري","عن كل مرأىً لي حَسِير",50,"ر",1,0],["حتى غلت فوق الأثافي قِدْرِي","يالكَ من طَرْد كحرّ الجمر",51,"ر",1,0],["حَتّى غَدَت لا يَستَبي","نُ صَباحُها لِيَ مِن مَساها",52,"ا",3,0],["حَتّى غَدَت مُبيَضَّةً مُخضَرَّةً","بِنَدى يَديهِ مَطالِبي وَرُبوعي",53,"ع",2,0],["حَتّى غَدَوتُ بِوَصفِ جودِكَ مَك","دودَ القَريحَةِ مُتعَبَ الفِكرِ",54,"ر",1,0],["حَتّى غَدا سائِرُ الأَمصارِ يَحسُدُها","فَاللَهُ مِن عَينِ مَن فيها يُوَقّيها",55,"ي",3,0],["حتّى غدوتَ وأَنتَ بَد","رُ سمائه وأَنا هلالُه",56,"ل",2,0],["حَتّى غَدَت مَوبوءَةً","بِوُجودِهِ وَالكُلُّ واجِفِ",57,"ف",1,0