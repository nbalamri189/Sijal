دبٍ","وحسن رأي وعقل جل واهبه",88,"ب",2,0],["حتى غدا كل له","أصفى ولي أو مريد",89,"د",1,0],["حتى غدت تلك الإدارة والنظا","م حليفها تتلو مديحك أسطرا",90,"ر",2,0],["حتى غدوت وكل ما أبغيه من","حسن الختام ثواب رب أجودا",91,"د",2,0],["حَتّى غَدَا مُنْعَماً بِالْعِلْمِ يُسْعِدُهُ","أَصْلَحْتَ كُلَّ الذِي قَاسَاهُ مِنْ أَلَمِ",92,"م",1,0],["حتى غَدَتْ بعيونِ كلِّ مُشَاهدٍ","جَنَّات رَوْضٍ تَحْتَهَا الأنهارُ",93,"ر",1,0],["حتى غدت كعروس الحسن جمَّلها","تاج المحامد فواح بها عطر",94,"ر",1,0],["حتى غدا فيها بأعظم منعةٍ","ليست ترى بسوابغ الأدراع",95,"ع",1,0],["حتى غدا الروحان روحاً واحداً","يتجاذبان الوصل ما الجسم انفصَل",96,"ل",1,0],["حتى غدوا جثثاً وإطلاقاتنا","تنقض فيهم كإنقاض شهاب",97,"ب",1,0],["حتى غَدَا حَمَلُ السَّمَاءِ وثَوْرُها","حَذِرَيْنِ مما حَلَّ بالحُمْلانِ",98,"ن",1,0],["حتى غدا بدمائهم مُتخضّباً","انَّ النّجيعَ خِضابُ كفِّ الفارسِ",99,"س",1,0],["حتى غدا حبي يقول لكيسه","ضل الذي زهم الخلا متعذرا",100,"ر",2,0],["حَتّى غَوى مِن مَكرِهِ فَريقُ","وَشبَّ مِن شَراره حَريقُ",101,"ق",1,0],["حَتّى غَدا صُفرَ اليَدين جَيبُهُ","وَزالَ فَضله وَبانَ عَيبُهُ",102,"ه",1,0],["حتى غدَوْا عِبْرةً وموعظةً","يا صاح كنْ للعظاتِ مسْتمعا",103,"ع",2,0],["حتى غدت جارحاتُ الطير خائفةً","من البُغاثِ فيا لَلْمُعْجِب العجَب",104,"ب",1,0],["حتى غدتْ ليَ أسبابُ الهوى شرَكاً","وصُيِّرتْ لي أشراكُ الهوى وُثُقا",105,"ق",2,0],["حتى غدا الحاسد المقالي أخا كمدٍ","في الهم والغم ما مرَّ الجديدانِ",106,"ن",1,0],["حتى غدونا على حَرْدٍ ومقدُرةٍ","مع السلامةِ مِنْ رُعْبٍ ووَسواس",107,"س",1,0],["حتى غدت أيدي الفراق تقودني","لتحيط بي من بعد ذاك فروق",108,"ق",1,0],["حتى غدا وكأنه","في وجنة الشهباء شامه",109,"م",2,0],["حتى غدا حَبِقاً وحقّق ذُعرَه","عارى الأشاجِع ما يزالَ ضَريرا",110,"ر",2,0],["حَتّى غَدَوتَ بِأُفقِ المَجدِ بَدرَ هُدىً","بِلا نَظير عَلَيهِ أَشرَفَ الحُلَلِ",111,"ل",1,0],["حَتّى غَرَرت بِآمال مُزَخرَفة","وَجودها إِن ترم تَحصيله عَدَم",112,"م",1,0],["حتى غدا ذا عيلةٍ يشكو الأسى","ويكابد البلوى وأنواع التلفْ",113,"ف",1,0],["حتى غدت أحكامه بين الورى","ضرباً من المثل العجيب السايرِ",114,"ر",1,0],["