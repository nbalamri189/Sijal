poetsgate.com/ViewPoem.aspx?id=188226",""],[5943,"تشطير ( يا صاحِبِي مالي وللأُنْسِ )","https://www.poetsgate.com/ViewPoem.aspx?id=138278",""],[5977,"يا أحلى حكايانا","https://www.poetsgate.com/ViewPoem.aspx?id=213075",""],[6004,"الخَطِيئة","https://www.poetsgate.com/ViewPoem.aspx?id=59138",""],[6075,"طَيْفُ الْغَرَامِ","https://www.poetsgate.com/ViewPoem.aspx?id=192917",""],[6102,"ثأر الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=183321",""],[6134,"غصن النقا قد خجل لما رأى قدك","https://www.poetsgate.com/ViewPoem.aspx?id=169597",""],[6202,"استبد الهوى عشقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86702&r=&rc=3",""],[2638,"بغداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87865&r=&rc=22",""],[6301,"مبارك هذا النجاح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80679&r=&rc=43",""],[6345,"تيه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78655&r=&rc=26",""],[6367,"أين الطريق إليك ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80597&r=&rc=0",""]],"verses":[["حَتّى غَدَونا وَلا جاهٌ وَلا نَشَبٌ","وَلا صَديقٌ وَلا خِلُّ يُواسينا",0,"ن",2,0],["حَتّى غَدَوتَ أَباً لَهُ","أَضحَت عِيالُ القُطرِ وُلدا",1,"د",2,0],["حتى غدا البلبل منذ الصغر","في حبّها منطلق المقول",2,"ل",1,0],["حتى غدا جسمها بالبرد مرتجفا","كالغصن في الريح واصطكّت ثناياها",3,"ا",3,0],["حتى غدا جُلُّه للنار مَأكلةً","وما تزحزح شبراً عن مكانته",4,"ت",2,0],["حتى غدَوْت طريداً للغراب بها","وما غدوت طريداً للشواهين",5,"ن",1,0],["حتى غدا ورُضابُ الماء يتبعه","طيَّانَ لا سَأمٌ فيه ولا خَضَدُ",6,"د",1,1],["حتى غدا وغدا له ذو بُرْدَةٍ","شثن البنان عَدَبَّس الأوصالِ",7,"ل",1,1],["حتَّى غدت صفحات وجهي آيةً","لا ناسخ فيها ولا منسوخ",8,"خ",1,0],["حتَّى غدا بخمارِ القربِ في طربٍ","بعد البعاد الذي قد كان خامره",9,"ر",2,0],["حتَّى غدت دامية النحور","ساقطة منها على الخبيرِ",10,"ر",1,0],["حتى غدت تلك الضواري صرعى","مجموعة لدى التراب جمْعا",10,"ع",2,0],["حتى غدا بعد المِرا","ح عليه سِربالُ الكآبهْ",11,"ب",2,0],["حتى غدا في ذَراهُ مضطَربٌ","رحبٌ وقد كان ضاقَ مُضطرَبُهْ",12,"ب",2,0],["حتى غدا في حِماهُ مُعتصمٌ","مُغْنٍ وقد كان طال مُنزَرَبُهْ",12,"ب",2,0],["حتى غدا الطرف الأقصى به وسطاً","من بعد ما كانت الأوساط أطرافا",13,"ف",2,0],["حتى غدوتم لآمال الورى قِبَلاً","لها عليها طوال الدهر معتكف",14,"ف",1,0],["حَتّى غَدَت في بَياضِ الصُبحِ طَيِّبَةً","ريحَ المَباءَةَ تَخدي وَالثَرى عَمِدُ",15,"د",1,0],["حَتّى غَدا خَرِصاً طَلّاً فَرائِصُهُ","يَرعى شَقائِقَ مِن عَلقى وَبِركانِ",16,"ن",1,0],["حتَّى غَدَا قلبي كنايٍ متْرعٍ","ثَملٍ من الأَلحانِ والأَنغامِ",17,"م",1,0],["حَتّى غَدَوتُ وَأَعدائي تُخاطِبُني","يا قاتِلَ الناس بِالأَجنادِ وَالفِكَرِ",18,"ر",1,0],["حَتّى غَدَوتَ وَلِلأَخبارِ تَجوالُ","وَلِلكَواكِبِ في كَفَّيكَ آمالُ",19,"ل",1,0],["حَتّى غَدا لَحِماً مِن فَوقِ رابِيَةٍ","في لَيلَةٍ كَفَّتِ الأَظفارَ وَالبَصَرا",20,"ر",2,0],["حَتّى غَبَطنا كُلَّ مُحتَمَلٍ","يُمشى بِأَعظُمِهِ إِلى القَبرِ",21,"ر",1,0],["حَتّى غَدَت وَهَداتُها وَنِجادُها","فِئَتَينِ في خِلَعِ الرَبيعِ تَبَختَرُ",22,"ر",1,0],["حتى غَلَتْ بي ريبة فسألتُهمْ","خانَ السّلاحُ أم المنيَّةُ تكذب",23,"ب",1,0],["حَتّى غَدَوتُ وَما لي","عَلى التَجلُّد قدره",24,"ر",2,0],["حَتى غدا عَنْ طَرِيقِ الوَحْيِ مُنْهَزِمٌ","من الشياطِينِ يَقْفُو إثْرَ مَنْهَزِمِ",25,"م",1,0],["حتَّى غَدَتْ مَلَّةُ الإسلامِ وهِيَ بِهِمْ","مِنْ بَعْدِ غُرْبَتِها مَوْصُولَةَ الرَّحِمِ",25,"م",1,0],["حتى غدوا من طريدٍ في الشعابِ ومن","مُضَرَّجٍ بدَمٍ وردِ الأساريّ",26,"ي",1,0],["حَتّى غَدا أَوطَفَ ما إِن لَهُ","دونَ اِعتِناقِ الأَرضِ إِقصارُ",27,"ر",1,0],["حَتّى غَدا السَكرانُ مِن سُكرِهِ","كَالمَيتِ في بَعضِ أَحايِينِهِ",28,"ن",2,0],["حَتّى غَدا عَبَ عَبّاسٍ وَلا سَبَقٍ","يَتلو يَداً قَدَحَت عَن وَجهِهِ الحُجُبا",29,"ب",2,0],["حَتّى غَدا مِثلَ نَصلِ السَيفِ مُنصَلِتاً","يَقرو الأَماعِزَ مِن لُبنانَ وَالأَكَما",30,"م",2,0],["حَتّى غَلَبنا وَلَولا نَحنُ قَد عَلِمُوا","حَلَّت سَليلاً عَذارِيهِم وَجُمّالا",31,"ل",2,0],["حتّى غدوت وللأخيار تجوالُ","وللكواكب في كفّيك آمال",32,"ل",1,0],["حَتَّى غَدَتْ بِفُنُونِهَا","فِي عِزَّةٍ فَوْقَ المَرَامِ",33,"م",1,0],["حَتَّى غَدَا نُورَ هُدّى","وَمَعْقِداً لِلأَمَلِ",34,"ل",1,0],["حَتَّى غَدَتْ قُدْوَةً فِي العَصْرِ صَالِحَةٍ","لِلْغَانِيَاتِ ذَوَاتِ الجِدِّ وَالدَّأَبِ",35,"ب",1,0],["حَتَّى غَدَا بَيْنَ حُلِيِّ الْعَصْر","مَنَاطُكُمْ مَنَاطَ عِقْدِ الدّرِ",36,"ر",1,0],["حتى غدا صرخةً على فمها","وداع من لن يردّه سفره",37,"ر",2,0],["حتى غدت بطحاءَ مكة تشتهي","في كل عام أن تحج وتحرما",38,"م",2,0],["حتّى غَدَتْ جُشَمُ بنُ بَكْرٍ تبْتغي","إرْثَ النبيّ، وتدّعِيهِ حُقُوقَا",39,"ق",2,0],["حتى غدت وهي في تمور ناكسة","رايات شاه رماه الخلع مجنوزا",40,"ز",2,0],["حتى غدت أرواح أه","ل الحب تحسب من صداقك",41,"ك",1,0],["حتى غدوت وألفاظي لها وقدٌ","كأنما هي من أحشاء بركان",42,"ن",1,0],["حتى غدت من بقايا الصوت مائلة","نشوى وقد حملت ورداً وريحانا",43,"ن",2,0],["حَتَّى غَلَت زَفَرَاتِى في الحَشَا وَعَلَت","هَدَّ إرعِوَائِى رُنوي صَوبَ أظعَانِ",44,"ن",1,0],["حتى غدا ملقى ذبيحاً حاكياً","للناس رقدته إذا هجر الوسن",45,"ن",1,0],["حَتّى غَدَوتَ تَأُمُّها مُستَنهِجاً","قَصدَ السَبيلِ وَجارَ مَن جاراكا",46,"ك",2,0],["حتى غَدْت كالشمس عند الضحى","والبدرِ حسنا في دُجَى الحِنْدِس",47,"س",1,0],["حتّى غَدا في سلكهِ محرّرا","وَصارَ عِقداً لعلاهُ مُحكما",48,"م",2,0],["حتّى غَدا الدينُ به خالصاً","مُنزّهاً عن إفكِ أفّاكِ",49,"ك",1,0],["حتى غدوتُ وناظري","عن كل مرأىً لي حَسِير",50,"ر",1,0],["حتى غلت فوق الأثافي قِدْرِي","يالكَ من طَرْد كحرّ الجمر",51,"ر",1,0],["حَتّى غَدَت لا يَستَبي","نُ صَباحُها لِيَ مِن مَساها",52,"ا",3,0],["حَتّى غَدَت مُبيَضَّةً مُخضَرَّةً","بِنَدى يَديهِ مَطالِبي وَرُبوعي",53,"ع",2,0],["حَتّى غَدَوتُ بِوَصفِ جودِكَ مَك","دودَ القَريحَةِ مُتعَبَ الفِكرِ",54,"ر",1,0],["حَتّى غَدا سائِرُ الأَمصارِ يَحسُدُها","فَاللَهُ مِن عَينِ مَن فيها يُوَقّيها",55,"ي",3,0],["حتّى غدوتَ وأَنتَ بَد","رُ سمائه وأَنا هلالُه",56,"ل",2,0],["حَتّى غَدَت مَوبوءَةً","بِوُجودِهِ وَالكُلُّ واجِفِ",57,"ف",1,0],["حتى غدا في موجهم ذائبا","كأنه سمع لهم أو بصر",58,"ر",1,0],["حتى غدَوا حرباً علي","نا لا على المستعمرين",59,"ن",1,0],["حَتّى غَدا يَكلأُ أَقطارَهُ","من كُلِّ وَجهٍ وَهوَ مَرعوبُ",60,"ب",1,0],["حَتّى غَدَت كُلّ المُلوك","تثني عَلى عَلياه حَمدا",61,"د",2,0],["حَتّى غَدا وَمَباني ال