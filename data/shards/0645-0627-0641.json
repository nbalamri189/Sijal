كامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54894","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54858","الكامل"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12695","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54218","البسيط"],[106,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[106,"من وحي البحر","https://www.poetsgate.com/ViewPoem.aspx?id=179317",""],[106,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179289",""],[77,"يا سراج الجمالِ يا بن سِراج","https://www.poetsgate.com/ViewPoem.aspx?id=33799",""],[50,"يَا حُبَّ عَبْدَة َ قَدْ رَجَعْتَ جَدِيدَا","https://www.poetsgate.com/ViewPoem.aspx?id=21700",""],[90,"الشباب المر","https://www.poetsgate.com/ViewPoem.aspx?id=178970",""],[91,"ضرة جلق","https://www.poetsgate.com/ViewPoem.aspx?id=53143",""],[94,"الحبّ والله","https://www.poetsgate.com/ViewPoem.aspx?id=15625",""]],"verses":[["ما فيكُمُ إِلّا أَلَد","دُ عَلى عَظائِمِها مَرونُ",0,"ن",1,0],["ما في الرَجاءِ بَعدَكُم","وَلا البَقاءِ طائِلُ",1,"ل",1,0],["ما في اللَيالي غَيرَكُم","شَيءٌ بِهِ العَينُ تَقَرّ",2,"ر",1,0],["ما فاتَ عارِمَ لَحظي رَيْثَ رَجْعَتِهِ","إلا وجَفني على ما ساءَ مَردودُ",3,"د",1,0],["ما في المَقامِ لِذي عَقلٍ وَذي أَدَبِ","مِن راحَةٍ فَدَعِ الأَوطانَ وَاِغتَرِبِ",4,"ب",1,1],["ما فيكَ لي جَدْوى ولا أرْعَوي","شُحٌ مُطاعٌ وهَوىً مُتّبَعْ",5,"ع",1,0],["مَا فَوْقَ وَجْهِ الأَرْضِ نُفْسٌ حَيَّةٌ","إِلاَّ قَدِ انْقَضَى عَلَيْهَا أَجَلُ",6,"ل",1,0],["ما فؤادي بغَيْرِ حُبِّكَ عانٍ","ولِغَيْرِ اغْتِنامِ وَصْلِكَ راجِي",7,"ي",1,0],["ما فَوقَ بَيتِكَ مِن بَيتٍ عَلِمتُ بِهِ","وَفي أَرومَتِهِ ما مَنبِتُ العودِ",8,"د",1,0],["ما في نِفاقِ أَبي سُفيانَ مُختَلَفٌ","قَد كانَ أَوفى قُرَيشٍ لِلنَّبِيِّ أّذى",9,"ذ",2,0],["ما في أَبي بَكرٍ لِمُعتَقِدِ الهُدى","شَكٌّ يُريبُ بِأَنَّهُ خَيرُ الوَرى",10,"ر",2,0],["ما في محبيه","امرؤأقض به وساده",11,"د",2,0],["مَا فِيكِ إلاَّ أُمْةٌ مِصرِيَّةٌ","يَا مِصرُ وَلْيُبْتَرْ لِسَانُ الشَّانِي",12,"ن",2,0],["مَا فِيكَ إِلاَّ أُمَّةٌ مِصْرِيَّةٌ","يَا مِصْرُ مِنْ أَهْلٍ وَمِنْ إِخْوَانِ",13,"ن",1,0],["ما فاز قط بوصلها من عاشق","إلاّ وكان لعارفيه عشيقا",14,"ق",2,0],["ما في دِيارِ مُقامِ تَغلِبَ مَسجِدٌ","وَتَرى مَكاسِرَ حَنتَمٍ وَدِنانِ",15,"ن",1,0],["ما في فُؤادِكَ مِن داءٍ يُخامِرُهُ","إِلّا الَّتي لَو رَآها راهِبٌ سَجَدا",16,"د",2,0],["ما في مُعاوَدَتي الفَرَزدَقَ فَاِعلَموا","لِمُجاشِعٍ ظَفَرٌ وَلا اِستِبشارُ",17,"ر",1,0],["ما فيكُمُ حَكَمٌ تُرضى حُكومَتُهُ","لِلمُسلِمينَ وَلا مُستَشهَدٌ شاري",18,"ي",1,0],["ما في قُلوبِهِمُ نَكثٌ وَلا مَرَضٌ","إِذا قَذَفتَ مُحِلّاً خالِعاً قَذَفوا",19,"ف",3,0],["مافي دِيارِهِمُ لِلخَمرِ مُعتَصَرٌ","وَلا بُيوتُهُمُ لِلسوءِ مُعتَصَمُ",20,"م",1,0],["ما فاضَ من جفنهِ يومَ الرحيل دمٌ","إلاَّ وفي قلبهِ منكم جراحات",21,"ت",1,0],["ما في زمانك ما يسّر مؤملاً","فاذهب كما ذهب الخيال الساري",22,"ر",2,0],["ما فاخرته العرب إلاَّ هاشماً","فغدت إليه هشيمةَ الآناف",23,"ف",1,0],["ما فيه من عيب ويا طالما","قد ردّه في حكمه مالك",24,"ك",1,0],["ما فطمت من كرم كفّه","من قبل ما أدرك سنّ الفطيم",25,"م",1,0],["ما فتحتُ يوماً على مثلكم","في مثلها مقالة ذي شان",26,"ن",1,0],["ما فقدنا أما خلَفتَ جنايا","كانَ للمعتفي وكانَ تقيَّا",27,"ي",2,0],["ما فيهِ غَيرُكَ مِن سِرٍّ عَلِمت بِهِ","فَاِنظُر بِعَينِكَ هَل في الدارِ دَيّارُ",28,"ر",1,0],["ما فعلتْ خيلٌ له قد ضُمِّرتْ","أما لديها هربٌ ولا طَلَبْ",29,"ب",1,0],["ما فيه من مُستمتَعٍ خِلْتُهُ","إذا امرؤٌ جدَّ ولم يلعبِ",30,"ب",1,0],["ما في حبائل كيدِهنَّ رَثاثةٌ","لكنْ حبالُ وصَالهنَّ رِثاثُ",31,"ث",1,0],["ما في الحُسَامَيْن مأمُورٌ بصاحبه","عليكما بِرِقابِ العُنَّدِ الحِيدِ",32,"د",1,0],["ما فيك موضع لسْعة لبعوضةٍ","إلا وفيه نطْفَةٌ من واحدِ",33,"د",1,0],["ما في مجرد بيت الله مثْلبةٌ","كلّا وإن كان مستوراً بأستار",34,"ر",1,0],["ما فات حسنَك لا شمسٌ ولا قمرٌ","إلا نباهة ذكر الشمس والقمرِ",35,"ر",1,0],["ما في قعودك عنه عند غنىً","مَنَحتْكَه أيامُه عُذْرُ",36,"ر",1,0],["ما فيهمُ عن مُنكَرٍ","ناهٍ ولا بالعرف آمر",37,"ر",1,0],["ما فتَّرتْ في قتلنا","تلك المكحَّلةُ الفَواتر",38,"ر",1,0],["ما في حياة عبيد الله منفعةٌ","عندي سوى أنه تعويذُ عباس",39,"س",1,1],["ما في فِراق مفارقٍ نَغَصٌ","حسبي بذكري حُقرتي نغصا",40,"ص",2,0],["ما في خلائق مَنْ مدحتُ نقيصةٌ","أبغي لها بوسيلة تكميلا",41,"ل",2,0],["ما في قِراه لطارقٍ","ولمستميح من عُتوم",42,"م",1,0],["ما في النهار وقد فقدتك مِنْ","أنْسٍ ولا في الليل لي سَكنُ",43,"ن",1,0],["ما فوق ظاهِر وُدِّي ظاهرٌ حسن","وإنَّ أحسنَ منه للذي بطَنا",44,"ن",2,0],["ما فيهِ معنىً لمشتهيهِ","عجبْتُ من جهلِ عاشقيه",45,"ه",1,1],["ما في مَعَدٍّ فَتىً يُغني رَباعَتَهُ","إِذا يَهُمُّ بِأَمرٍ صالِحٍ عَمِلا",46,"ل",2,0],["ما في أَكُفِّهِم مِنَ الدُنيا سِوى","أَن يُكثِروا الأَحلامَ بِالنَعماءِ",47,"ا",2,0],["ما فيكَ قَر وَلا هَجيرٌ","ذَهَبتَ بِالقَر وَالهَجيرِ",48,"ر",1,0],["ما في الوَداعِ سِوى تَلَعثُمِ أَلسُنٍ","وَذُهولِ أَرواحٍ وَهَمٍّ مُطبِقِ",49,"ق",1,0],["ما في الشَرائِعِ لا وَلا في أَهلِها","مَن يَستَحِلُّ الأَخذَ مِن جانيكِ",50,"ك",1,0],["مافيهِ مِن عَيبٍ سِوى","فُتورِ عَينَيهِ فَقَط",51,"ط",1,0],["ما فيهِ غَيرُكَ أَو سِرٌّ عَلِمتَ بِهِ","وَاِنظُر بِعَينَيكَ هَل في الدارِ دَيّارُ",52,"ر",1,0],["مَا فازَ في ماضِغِيها","إلاَّ شَديدُ المِراسْ",53,"س",1,0],["مَا في الحَيَاةِ من المسرَّةِ والأَسى","والسِّحْر واللَّذّاتِ والتغريرِ",54,"ر",1,0],["مَا في وجود النَّاسِ من شيءٍ به","يَرضَى فؤادي أو يُسَرُّ ضَميري",55,"ر",2,0],["مَا في فؤاديْنا من","الأَحْلامِ أَو حُلْوُ الغرورْ",56,"ر",1,0],["ما في الرزية للمرزوء منتعش","لا يرقص الطير مذبوحا من الطرب",57,"ب",1,0],["ما في استطاعته الحراك كأنه","متقيد فيه ولم يتقيد",58,"د",1,0],["ما في طريق الموت من","عارضة تعترض",59,"ض",1,1],["ما في المساواة التي نشدو بها","ان الوهاد تطاول الآكاما",60,"م",2,0],["ما في الذي لم يلن للشعر من صمم","وانما عنده الاحساس مفقود",61,"د",1,0],["ما في النهار شعاعة","تهدى ولا لليل فجر",62,"ر",1,0],["ما في العظام الباليا","ت لدولة الفتيان فخر",62,"ر",1,0],["ما في الطبيعة ارضها وسمائها","غير الطبيعة ما يضر وينفع",63,"ع",1,0],["ما في هواي لليلى من مصانعة","أليس تأمرني ليلى وامتثل",64,"ل",1,0],["ما في السفور لمن تر","بتها الثقافة ما يضير",65,"ر",1,0],["ما في سبيل الموت وجه صعوبة","من مات يمشي في طريق مهيع",66,"ع",1,0],["ما في ثياب حدادها","إلا مصلِّية صبور",67,"ر",1,0],["ما في بلاد أنتم نزلاؤها","إلا قضية أمة وبلاد",68,"د",1,0],["ما فيه عصرىّ ولا دارس","الدهر عمر للقريض الأصيل",69,"ل",1,0],["ما فات من بؤس البسوس وشؤمها","أحيت مساوئ عهده الورقاء",70,"ا",2,0],["ما في الجريدة من نرجيه سوى","لطفى فردّوه لنا وكلوها",71,"ه",2,0],["ما فلّ حدّهم عَن المَنصورِ","سِوى أَبي مسلم الهَصورِ",72,"ر",1,0],["ما فَلَّ ساعِدَهُ الزَمانُ وَلَم يَنَل","مِنهُ اِختِلافُ جَوارِفٍ وَذَوارِ",73,"ر",1,0],["ما في كِتابِكَ طَفرَةٌ","تُنعى عَلَيكَ وَلا غُرور",74,"ر",1,0],["ما فيهِ إِن قُلِّبَت يَوماً جَواهِرُهُ","إِلّا قَرائِحُ مِن رادٍ وَأَذهانُ",75,"ن",1,0],["ما فَوقَ راحاتِكُم يَومَ السَماحِ يَدٌ","وَلا كَأَوطانِكُم في البِشرِ أَوطانُ",75,"ن",1,0],["ما في الحَياةِ لِأَن تُعا","تِبَ أَو تُحاسِبَ مُتَّسَع",76,"ع",1,0],["ما في هَوادِجِكُم مِن مُهجَتي عِوَضٌ","إِن مُتُّ شَوقاً وَلا فيها لَها ثَمَنُ",77,"ن",1,0],["ما في حَشاها ولا في جَفْنِهَا أثرٌ","من نارِ قلبي ولا من ماءِ أجفاني",78,"ي",1,0],["ما فَقَدنا الإِعدامَ حَتّى مَدَدنا","سَبَباً نَحوَ سيبِكَ المَمدودِ",79,"د",1,0],["ما في الخِلافَةِ مِن وَهيٍ فَيُجبِرَهُ","آسٍ وَلا في قَناةِ المُلكِ مِن أَوَدِ",80,"د",1,0],["ما فَوقَ ذا مَجدٌ يَصولُ بِهِ امرُؤٌ","فَرَّ المُماجِدُ مِن مُدى الأَحراسِ",81,"س",1,0],["ما في مُعاشَرَةِ اِبنُ أَكثَمَ ساعَةً","خَطَرٌ لِذي عَقلٍ وَلا مَجنونِ",82,"ن",1,1],["ما فَرَّثَت كَبِدي مِنِ اِمرَأَةٍ لَها","عَينانِ مِن عَرَبٍ وَلا مِن أَعجَمِ",83,"م",1,0],["ما فَوَّقَ الدَّهرُ لي سَهْماً جَزِعْتُ له","إلاّ وَجَدتُكَ لي دِرْعاً وتِجفافا",84,"ف",2,0],["ما فيهِ مَوعِظَةً لِكُلِ مُفَكِّرٍ","إِن كانَ ذا عَقلٍ وَإِن لَم يَعقِلِ",85,"ل",1,0],["ما فَعَلَ التارِكونَ مُلكَهُمُ","أَهلُ القِبابِ العِظامِ وَالحُجَرِ",86,"ر",1,0],["ما فَعَلَت مِنهُمُ الوُجوهُ أَقَد","بُدِّدَ عَنها مَحاسِنُ الصُوَرِ",86,"ر",1,0],["ما فاتَني خَيرُ اِمرِئٍ وَضَعتَ","عَنّي يَداهُ مَؤونَةَ الشُكرِ",87,"ر",1,0],["ما في المَقابِرِ وَجهٌ","عَنِ التُرابِ مَصونُ",88,"ن",1,0],["ما في الدُنيا إِلّا مُذنِب","هَذا عُذرُ القاضي وَاِقلِب",89,"ب",1,0],["ما في بَني شَيبانَ أَهلِ الحِجا","جارِيَةٌ واحِدَةٌ مِثلي",90,"ل",2,0],["ما فَوقَ حُبِّكِ حُبّاً لَستُ أَعلَمُهُ","فَلا يَضُرُّكِ أَن لا تَستَزيديني",91,"ن",2,0],["ما في نِظامي غَيرَ تَركِ مَدائِحي","نَقصٌ وَذاكَ النَقصُ غَيرُ كَمالي",92,"ي",1,0],["ما فَقدُ فَردٍ مِنَ الأَنامِ كَمَن","إِن ماتَ ماتَت لِفَقدِهِ أُمَمُ",93,"م",1,0],["ما فَكَّ مَدحي فيكَ قَيدَ تَعَبُّدي","إِلّا وَضَعتَ مِنَ النَوالِ قُيودا",94,"د",2,0],["ما في طلائعنا الضعي","ف ولا الذليل المستكن",95,"ن",1,0],["ما في طبائعنا الخصا","م ولا الحفيظة والضغن",95,"ن",1,0],["ما في عتابِكِ من عُتْبَى فأرقبها","هل يُسْتَدَلّ على سلمٍ بِهَيْجاءِ",96,"ا",2,0],["ما في الكواكب من شمس الضحى عوَضٌ","ولا لأسماءَ في أترابِ أسماءِ",96,"ا",2,0],["ما فِكرَتي فيهِ وَلَكِن فِكرَتي","في أَيرِ جَيّافٍ يَقومُ عَلَيهِ",97,"ي",2,0],["ما فِراقُ الدُنيا أُبالي وَلَكِن","في فِراقِ الدُنيا فِراقُ هَواكا",98,"ك",2,0],["ما فَوقَ مَجدِكَ مُرتَقى مَجدٍ وَلا","كُلُّ اِفتِخارٍ دونَ فَخرِكَ دونُ",99,"ن",1,0],["ما في النُجومِ سِوى تَعِلَّةِ باطِلٍ","قَدُمَت وَأُسِّسَ إِفكُها تَأسيسا",100,"س",2,0],["ما في وُقوفِكَ ساعَةً مِن باسِ","نَقضي ذِمامَ الأَربُعِ الأَدراسِ",101,"س",1,1],["مَا فِيَّ مَنْبِتُ شَعْرَةٍ","إِلَّا بِهِ أَثَرٌ لِسَهْمِكْ",102,"ك",1,0],["ما في سويدا القلبِ إلا النسا","ما حيلتي ما في السويدا رجال",103,"ل",1,0],["ما في الملاحِ نظيرُهُ","ريانُ باهٍ باهرُ",104,"ر",1,0],["ما في الصَّوادعِ وهي شَتَّى كالذي","صَدَعَ القُوَى من أمرِكِ المُتَقَسَّمِ",105,"م",1,0],["ما في النّوابِغِ من لبيبٍ حاذقٍ","إلا وأنتَ ألبُّ منه وأحذقُ",106,"ق",1,0],["ما في الطبائعِ أن تُساوَمَ أُمّةٌ","في عِرضها وتَدينَ للمُسْتعبِدِ",107,"د",1,0],["ما فيهِ مِن زَرعٍ وَلا لِظِمائِهِم","في جانِبَيهِ سِوى الأَذى مِن مَشرَعِ",108,"ع",1,0],["ما في القَواضِبِ وَالكَتائِبِ إِن مَضى","وَمَضَيتَ غَيرَ مُفَلَّلٍ وَجَبانِ",109,"ن",1,0],["ما في صَنيعِكَ من بِدْعٍ ولا عَجَبٍ","قَيسٌ ووالدُهُ في الجودِ سِيّانِ",110,"ن",1,0],["ما فيه من شكٍّ وليس كمثلِهِ","لِلعالَمينَ مُعلِّمٌ ومُهَذِّبُ",111,"ب",1,0],["ما في الهوادجِ والديباجُ يملؤها","للِخزيِ ملءَ وجوهِ القومِ تبديل",112,"ل",1,0],["ما فيه عند ذوي الألبابِ منقصةٌ","ولا به من سجايا السوء ما يصمُ",113,"م",1,0],["ما في جهادكِ أمَّ زيدٍ ريبةٌ","نار الوغى احتدمت وأنتِ الجحفلُ",114,"ل",1,0],["ما في العَناقيد من أشعارهم حببٌ","والخمر من بعدهم في دنها صابُ",115,"ب",1,0],["ما فيهِ مِن غَيرِ التُقى رَهَبٌ وَلا","فيهِ لِغَيرِ الجودِ شيمَةُ مُسرِفِ",116,"ف",1,0],["ما في يَدي مِنهُ غَيرُ عَضُّ يَدي","وَرُبَّ بَختٍ في الحُبِّ مَنحوسِ",117,"س",1,0],["ما فيهمُ لسنانِ عَيْبٍ مَطْعَنٌ","كَلَّا وَلا لحُسامِ رَيْبٍ مَضْرِبُ",118,"ب",1,0],["ما فِي الزَّمانِ جَوادٌ","يُرْجَى لِدَفْعِ العَظائِمْ",119,"م",1,1],["ما في قُعودِكَ عُذرٌ عَن مُعَتَّقَةٍ","كَاللَيلِ والِدُها وَالأُمُّ خَضراءُ",120,"ا",2,0],["ما في يَدي مِنكَ إِلّا","مُنى الغُرورِ تُنيلُ",121,"ل",1,0],["ما في النَبيذِ مَعَ المُعَربِدِ لَذَّةٌ","وَاِبنٌ لِيَحيى لاطِمٌ بِيَدَينِ",122,"ن",1,1],["ما فَرخُ مُعلَجَةٍ كَنَجلِ مُتَوَّجٍ","هَيهاتَ ذا مَلِكٌ وَذا ناطورُ",123,"ر",1,0],["ما في اِتِّباعِكَ إِن تَبِعتُكَ راحَةٌ","وَلَئِن فَقَدتُ لَأَفقِدَنَّ مَجودا",124,"د",2,0],["ما فيهُمُ بَرٌّ وَلا ناسِكٌ","إِلّا إِلى نَفعٍ لَهُ يَجذِبُ",125,"ب",1,0],["ما فَسَخوا بِالقَبيحِ عَهدَهُمُ","ضَنّوا وَأَمّا بِسِرَّهُمُ فَسَخوا",126,"خ",3,0],["ما فاتَ أَعيا وَلَم تَرجِع إِلى مُضَرٍ","عَينٌ وَجَوَّلَ في الآفاقِ أَنمارُ",127,"ر",1,0],["ما فِضَّةُ الإِنسانِ إِلّا فَضَّةٌ","وَالتِبرُ تَتبيرٌ وَجَدُّكَ ظاهِرُ",128,"ر",1,0],["ما في جَميعِ الناسِ إِلّا خاسِرٌ","فَإِلَيهِمُ رَجَعَ القَبيحُ وَحاقا",129,"ق",2,0],["ما في بَني آدَمٍ غَنِيٌّ","بَل كُلُّهُم مُقَتِّرٌ عَديمُ",130,"م",1,0],["ما فرحَ الناسُ مثلَ فرحتِهمْ","لمّا أُقيلَ الأديبُ واستُوزِرْ",131,"ر",1,0],["ما في الوجود سوى أَثير واسِع","فهو القوى وَالروح والأجسامُ",132,"م",1,1],["ما في قوى الإنسان أَو تركيبه","شيء إِلى غير الطَبيعة ينتَمي",133,"م",2,0],["مافي اجتماع صديقي","ن ساعة ما يخلُّ",134,"ل",1,0],["ما في التوقف من سَلامِ","فإلى الأمام إِلى الأمامِ",135,"م",1,1],["ما في الطبيعة أرضها وسمائها","والله تطلبه العقول فترجع",136,"ع",1,0],["ما فاز فوق الأرض باستقلاله","شعب يعالج قلبه الأوجالا",137,"ل",2,0],["ما فازَ بالظفر امرؤٌ","في الحرب إلا بالثبات",138,"ت",1,1],["ما في حياتكَ من سلوى تلوذ بها","لكنهُ الحبُّ ذاك القاهرُ العاتي",139,"ي",1,0],["ما فَعَلَتْ دِرْعُ والِدي أجَرَتْ","في نَهَرٍ أمْ مَشَتْ على قَدَمِ",140,"م",1,1],["ما في البسيطة من عبد ولا ملك","إلا حليف عناءٍ يخدم الأملا",141,"ل",2,1],["ما في الطُّلُولِ مِن الأَحِبَّةِ مُخْبِرُ","فَمَن الَّذِي عن حالِها نَسْتَخْبِرُ",142,"ر",1,1],["ما فَلْسَفَ النَّيطسُ جالينوسُ","وصاحبُ القانونِ بَطْليْموسِ",143,"س",1,0],["مَا فِي الأُولَى عَرفُوكَ إِلاَّ وَاجِمٌ","لِفَدَاحَةِ البَلْوَى وَإلاَّ جَازِعُ",144,"ع",1,0],["مَا فِي القَضَاءِ وَلاَ الإِدَارةِ عَامِلٌ","إِلاَّ واسْتَمَدَّ شُعَاعَ ذَاكَ النَّيِّرِ",145,"ر",1,0],["مَا فَاتَهَا الحُسْنُ وَأَوْقاتُهَا","أَشْبَاهُ مَا فيهَا منَ الدُّرُّ",146,"ر",1,0],["مَا فُتُوحُ الآرَاءِ وَالجُبْنُ يَطْوِ","يهَا كَطَيِّ النِّصَالِ فِي الأغْمَادِ",147,"د",1,0],["مَا فِي مَسَاعِيهِ الجِسَامِ تَكَلُّفٌ","لَكِنْ بَدَاهَةُ وَارِثٍ مُتَعَوِّدِ",148,"د",1,0],["مَا فِي مُحِبِّيهِ امْرُؤٌ","إِلاَّ أُقِضَّ بِهِ وِسَادُهْ",149,"د",2,0],["مَا فِي الشَّقَاءِ مِنَ العَزَا","ءِ وَفِي الْبَقَاءِ مِنَ السُّرُورْ",150,"ر",1,0],["مَا فِي الصُّدورِ وَفِي الْوُجُوهِ سِوَى","قَلْبٍ يَذُوبُ وَمُقْلَةٍ شَكْرَى",151,"ر",2,0],["ما في النِساءِ سِوى فَوزٍ لَنا أَرَبٌ","فَاِرضَي بِذَلِكَ أَو عَضّي عَلى حَجَرِ",152,"ر",1,0],["ما في يدي غيرُ أوتارٍ محطَّمةٍ","يبكي لها العُودُ أو تبكي على العودِ",153,"د",1,0],["ما فات ليس بعائد","أين اللحودُ من المهود؟",154,"د",1,0],["ما فيك شيء ليس بالجَذَّاب","حتى اصطدامُ موجك الصَّخَّاب",155,"ب",1,0],["ما في العراق افتراقٌ بعد ثورته","أكرادُه عَرَبٌ، والعُرْبُ أكراد",156,"د",1,0],["ما فُؤادي بغير حبِّكَ عان","ولغير اغتنامِ وصلك راجِ",157,"ج",1,0],["مَا فِي اتَّبَاعِكَ إِنْ تَبِعْتُكَ رَاحَة","ٌ ولئن ففقدت لأفقدن مجودا",158,"د",2,0],["ما في يديْ هي مهجةٌ وهفا بها","داءٌ ألّح ، وَعبرةٌ وأراقها",159,"ق",3,0],["ما في الوداع سوى تعلثم ألسن","وذهول أرواح وهمّ مطبق",160,"ق",1,0],["ما فارق الريّ قلبا أنت جذوته","ولا النعيم محبّا أنت بلواه",161,"ا",2,0]]}