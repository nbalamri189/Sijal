{"poems":[[63,"دعت أم عمرو ويلها ثم أقبلت","https://www.aldiwan.net/poem46075.html","الطويل"],[48,"إبخل على الدار بتكليم","https://www.aldiwan.net/poem65104.html","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54658","الرمل"],[158,"ليتهم كانوا يهودا","https://www.aldiwan.net/poem59208.html","مجزوء الرمل"],[158,"برغم سنة خير العجم والعرب","https://www.aldiwan.net/poem59217.html","البسيط"],[280,"متى حثني الشوق يا ناقتي","https://www.aldiwan.net/poem32679.html","المتقارب"],[536,"أبخير عيد أم بخير إمام","https://www.aldiwan.net/poem47940.html","عموديه"]],"verses":[["أَبُخْلاً وَبَيْتِي مِنْ أُمَيَّةَ في الذُّرا","وَعِرْقِي بِغَيْرِ المَجْدِ لَمْ يَتَلَبَّسِ",0,"س",1,0],["إِبخَل عَلى الدارِ بِتَكليمِ","فَما لَدَيها رَجعُ تَسليمِ",1,"م",1,1],["أَبِخَوْف الغُولِ يُرْجَى عِنْدَهُمْ","خُلُقُ البَأْسِ وَتُرْجَى العَظَمَاتُ",2,"ت",1,0],["أبخير الخلق ترضو","ن من الخلق الشرارا",3,"ر",2,0],["أبخس وأقبح بذي علم يزيغ به","هوى عن الحق أو يلقيه في تبب",4,"ب",1,0],["أَبُخلاً وَقَومُكَ أَهلُ النَدى","وَغَدراً وَما شان غَدرٌ أَباكِ",5,"ك",1,0],["أبِخَيرِ عيدٍ أم بِخيرِ إِمامِ","نَزهو بهذا اليومِ في الأيامِ",6,"م",1,1]]}