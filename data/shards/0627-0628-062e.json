{"poems":[[65,"دعت أم عمرو ويلها ثم أقبلت","https://www.aldiwan.net/poem46075.html","الطويل"],[50,"إبخل على الدار بتكليم","https://www.aldiwan.net/poem65104.html","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54658","الرمل"],[164,"ليتهم كانوا يهودا","https://www.aldiwan.net/poem59208.html","مجزوء الرمل"],[164,"برغم سنة خير العجم والعرب","https://www.aldiwan.net/poem59217.html","البسيط"],[287,"متى حثني الشوق يا ناقتي","https://www.aldiwan.net/poem32679.html","المتقارب"],[543,"أبخير عيد أم بخير إمام","https://www.aldiwan.net/poem47940.html","عموديه"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122562","الهزج"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59620","الطويل"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105465","البسيط"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129829","الطويل"],[3452,"","https://poetry.dctabudhabi.ae/diwan/poem/28839","الطويل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45018","الكامل"],[4394,"","https://poetry.dctabudhabi.ae/diwan/poem/117202","الطويل"],[4797,"ذالليل كن نجومه شوي واشتات","https://www.poetsgate.com/ViewPoem.aspx?id=132228",""],[5087,"أيها اللائمي لحبي عليا","https://www.poetsgate.com/ViewPoem.aspx?id=96364",""],[5629,"صاحبي","https://www.poetsgate.com/ViewPoem.aspx?id=184608",""],[5725,"تفيض ملاحةً","https://www.poetsgate.com/ViewPoem.aspx?id=215490",""],[6038,"الاقصى","https://www.poetsgate.com/ViewPoem.aspx?id=27219",""]],"verses":[["أَبُخْلاً وَبَيْتِي مِنْ أُمَيَّةَ في الذُّرا","وَعِرْقِي بِغَيْرِ المَجْدِ لَمْ يَتَلَبَّسِ",0,"س",1,0],["إِبخَل عَلى الدارِ بِتَكليمِ","فَما لَدَيها رَجعُ تَسليمِ",1,"م",1,1],["أَبِخَوْف الغُولِ يُرْجَى عِنْدَهُمْ","خُلُقُ البَأْسِ وَتُرْجَى العَظَمَاتُ",2,"ت",1,0],["أبخير الخلق ترضو","ن من الخلق الشرارا",3,"ر",2,0],["أبخس وأقبح بذي علم يزيغ به","هوى عن الحق أو يلقيه في تبب",4,"ب",1,0],["أَبُخلاً وَقَومُكَ أَهلُ النَدى","وَغَدراً وَما شان غَدرٌ أَباكِ",5,"ك",1,0],["أبِخَيرِ عيدٍ أم بِخيرِ إِمامِ","نَزهو بهذا اليومِ في الأيامِ",6,"م",1,1],["أبُخلاً بسلامِ اللهِ","يا صاحبَةَ الهودج",7,"ج",1,0],["أُبخلا علينا ما أرى أم قطيعة","فعن أي غايات البلا أنتَ تقصر",8,"ر",1,0],["إبخل بهجرك واسمح بالوصال فما","عليك يا مهجتي بالوصل من باس",9,"س",1,0],["أبخلٌ عليّ ما سوايَ يصيخُ لي","فهل ليَ ممّا كدّرَ العيشَ مهرَبٌ",10,"ب",1,0],["أَبُخلاً إِذا تَدنو وَشَوقاً إِذا نَأَت","عَناءٌ وَبَرْحٌ مِن أمامة بارِحُ",11,"ح",1,0],["أَبَخيلَةً بالطيف مَن لمُتَيَّم","قَد كانَ طالِب خلّةٍ وَوداد",12,"د",1,0],["أبُخلاً علينا كلُّ ذا وقطيعةً","قضَيتُ لدُنيا بالقطيعةِ والبُخلِ",13,"ل",1,0],["ابختصر وصفي له بخمس كلمات","دله....صباح وليل...سيف وفناجيل",14,"ل",1,0],["أبخير الأنام عرضت لا زل","ت مذودا عن الهدى مزويا",15,"ي",2,0],["أبخل بحالة / على غيري بنيت","سلم أمالك / أنا اصبح بك بخيل",16,"ل",1,0],["أبخل علموه له الشحاحُ","فلي في ثغره شهد وراحُ",17,"ح",1,1],["ابختم كلامي بشطر البيت الاخير","الله يذله يا اقصى من اراد اذلالك",18,"ك",1,0]]}