{"poems":[[9,"بانت سعاد وأمسى حبلها انقطعا","https://www.aldiwan.net/poem21951.html","البسيط"],[51,"لعَمْرُكَ، ما الدّنيا بدارِ بَقَاءِº","https://www.poetsgate.com/ViewPoem.aspx?id=13166",""],[382,"نصحتك نصحا قل من شأنه النصح","https://www.aldiwan.net/poem66888.html","الطويل"],[396,"الحمدلله لا يحصى على الله ثناه","https://www.aldiwan.net/poem54453.html","عموديه"],[396,"الحمدلله على ما أولى","https://www.aldiwan.net/poem54480.html","عموديه"],[487,"سقتني بثغر الوصل قهوة حسنها","https://www.aldiwan.net/poem24322.html","عموديه"],[520,"ولاؤك مفروض على كل مسلم","https://www.aldiwan.net/poem12246.html","الطويل"],[556,"إن قطعتني علتي عن قصدي","https://www.aldiwan.net/poem47845.html","الرجز"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48898","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62458","الوافر"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105463","المتقارب"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25350","الرجز"],[1268,"","https://poetry.dctabudhabi.ae/diwan/poem/198347","المتقارب"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108600","الوافر"],[2076,"","https://poetry.dctabudhabi.ae/diwan/poem/105254","البسيط"],[2358,"","https://poetry.dctabudhabi.ae/diwan/poem/123475","المتقارب"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87322","الرجز"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65985","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65939","الطويل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103931","البسيط"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89567","الوافر"],[4984,"خُرَافَةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=201624",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""]],"verses":[["وَكُلُّ زَوجٍ مِنَ الديباجِ يَلبَسُهُ","أَبو قُدامَةَ مَحبوّاً بِذاكَ مَعا",0,"ع",2,0],["وكلُّ زَمانٍ واصِلٌ بصَريمَة ٍ،","وكلُّ زَمانٍ مُلطَفٌ بجَفَاءِ",1,"ا",2,0],["وكل زمانٍ خضت فيه وقائعاً","وكل مكان رابني وجهه الكلح",2,"ح",1,0],["وكل زارع سيحصد في غد ماذراه","فمن ذرى برجاله بر أو شوك جاه",3,"ا",2,0],["وكل زهر ونور فائق أنق","ورد وآس وكافور وريحان",4,"ن",1,0],["وكل زوايا الكون أضحت مقري مذ","وسعت جمال الحق حقا بجملة",5,"ه",1,0],["وكل زمان أو مكان رضيتم","به فهو في الإسلام أكرم موسم",6,"م",1,0],["وكلُّ زندٍ غير زندي يُكدِي","ما مسّهمْ فهْوَ إليَّ يُعدِي",7,"د",2,0],["وكل زعيم سار سيرك في الحمى","فآثاره أشياعه فيه والحزب",8,"ب",1,0],["وكل زماننا بك في ربيع","فكيفَ الخير يُحمد في جُمادى",9,"د",2,0],["وكل زمان نرى منهم","بأفق العلى كوكباً مزهرا",10,"ر",2,0],["وَكُلُّ زَجَّاجٍ سُخامِ الخَمْلِ","تَبْرِي لَهُ زَعِلاتٍ خُطْلِ",11,"ل",1,0],["وَكُلُّ زَمَانٍ لَهُ شَكْلُهُ","فَخَلِّ قِفَا نَبْكِ للأَكْؤُسِ",12,"س",1,1],["وكل زمانك المحمود عيدٌ","ينادي أحمد الأعياد أحمد",13,"د",1,0],["وكل زاد وان أبقيته فان","وان صفى لك دهر غير مؤتمن",14,"ن",1,0],["وكلُّ زمانٍ له خُلَّةٌ","فألفِ دلاءَكَ بين العَام",15,"م",1,0],["وكلُّ زامٍ فَلَهُ المَنازِلُ","ثلاثُ أيضا ثمَّ نِصفٌ كامِلُ",16,"ل",1,0],["وكل زمان فيه حكم وإنهم","يخونونك الميثاق والعهد والدما",17,"م",2,0],["وكل زمان بعد ذاك فإنما","له حكم إن كان من أهل حكمة",18,"ه",1,0],["وكل زارع خير عند مضطهد","فسوف يحصد ما قد كان يزرعه",19,"ع",2,0],["وَكُلٌّ زائِلٌ واللَهُ باقٍ","إِلَهُ الكُلِّ يَفعَلُ ما يَشاءُ",20,"ا",2,0],["وكل زمان له خمره","خيال فيعصر منه سلافة",21,"ف",2,0],["وكل زمانٍ بل وفي كل موضعٍ","كما ليس مخصوصاً لذي القبر بالصمد",22,"د",1,0]]}