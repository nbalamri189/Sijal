Poem.aspx?id=193673",""],[4859,"سيّد العميان","https://www.poetsgate.com/ViewPoem.aspx?id=187531",""],[669,"خف يا محمد فالق الأصباح","https://www.poetsgate.com/ViewPoem.aspx?id=18411",""],[5064,"ما لم تَستطِعْهُ المحابِرُ","https://www.poetsgate.com/ViewPoem.aspx?id=200052",""],[5072,"أغنية الحنان","https://www.poetsgate.com/ViewPoem.aspx?id=52563",""],[5092,"إلى الفاتنة","https://www.poetsgate.com/ViewPoem.aspx?id=139721",""],[5121,"حنين ودموع","https://www.poetsgate.com/ViewPoem.aspx?id=33628",""],[5277,"معارضة داليّة الحصري القيرواني","https://www.poetsgate.com/ViewPoem.aspx?id=198895",""],[5314,"خلجات","https://www.poetsgate.com/ViewPoem.aspx?id=214746",""],[5324,"حبك مأساة الماساة","https://www.poetsgate.com/ViewPoem.aspx?id=211056",""],[5327,"سَجَنُوك ! إلى سَجينِ السَّكَر","https://www.poetsgate.com/ViewPoem.aspx?id=156015",""],[592,"الحمد لله حمداً دائماً وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=128796",""],[5376,"في الأرضِ جاذرةٌ نفسي وباسقةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=196643",""],[5464,"طاوي الديار","https://www.poetsgate.com/ViewPoem.aspx?id=33886",""],[5620,"فِي الْمَقْهَى","https://www.poetsgate.com/ViewPoem.aspx?id=196939",""],[5638,"فلسفتي في الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=197919",""],[5674,"شموخ صمتك هزته القوارير","https://www.poetsgate.com/ViewPoem.aspx?id=207901",""],[5691,"روح المدائن","https://www.poetsgate.com/ViewPoem.aspx?id=206312",""],[5790,"عذلوا عليك فأكثروا","https://www.poetsgate.com/ViewPoem.aspx?id=112043",""],[5829,"دعوة الى الستر","https://www.poetsgate.com/ViewPoem.aspx?id=157070",""],[5912,"ذكرى الأمس","https://www.poetsgate.com/ViewPoem.aspx?id=202553",""],[5956,"أنا والجمال حكاياتُ حُبٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=181885",""],[5956,"تعال نحترق","https://www.poetsgate.com/ViewPoem.aspx?id=182069",""],[5956,"أتأّمّلك","https://www.poetsgate.com/ViewPoem.aspx?id=182643",""],[5956,"تسجيل وتصوير ليلة دخلة عريس","https://www.poetsgate.com/ViewPoem.aspx?id=182669",""],[5956,"دعوتُ للإنسانية","https://www.poetsgate.com/ViewPoem.aspx?id=194884",""],[5976,"شفته مع الصبيان","https://www.poetsgate.com/ViewPoem.aspx?id=32095",""],[6093,"لا تعبثن بلحية الأسد","https://www.poetsgate.com/ViewPoem.aspx?id=207829",""],[6102,"معلمة الموسيقى ..","https://www.poetsgate.com/ViewPoem.aspx?id=185060",""],[5490,"العمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81965&r=&rc=52",""],[5190,"عندما تعاتبني ابنتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78339&r=&rc=52",""]],"verses":[["أغوى الهوى كلَّ ذي عقل فلست ترى","إلا صحيحاً له أفعالُ مجنون",0,"ن",1,0],["أغويتني من بعد ما استدرجتني","مستحوذاً حتى على أنفاسي",1,"س",2,0],["أَغْوَيْنَنِي فَتَبِعْتُ شَيْطَانَ الْهَوَى","إِنَّ النِّسَاءَ حَبَائِلُ الشَّيْطَانِ",2,"ن",1,0],["أَغواك جَهلُكَ حَتَّى","لَقيتَ في النَّارِ رُشْدَكْ",3,"ك",1,0],["أَغوى زيجُ ناظِرٍ في مَعاني ال","شُهبِ أَم حَلَّ بِالمَنايا الغَوازي",4,"ز",2,0],["أغوثي وا غوثُ غوثي الأمين","عبيدك من ذنبه لحزين",5,"ن",1,0],["أغوَتهُ إذ كان المساءُ مُزَخرَفاً","لألذَّ أحلامٍ تزين كرانا",6,"ن",2,0],["أَغووا بِظاهِرِ ما رَووا جُلَّ الوَرى","وَلَدَيهِمُ طَرقَ البَواطِنِ سَدَّدوا",7,"د",3,0],["أَغوصُ عَلى الدُرِّ الَّذي لَو طَلَبتُهُ","اَبى بَحرُ فِكري أَن يَكونَ لَهُ حَبسا",8,"س",2,1],["أغوث أغوث يا إلهي وناصري","وأهتف أين رباه كلبك في العسرى",9,"ر",2,0],["أَغْواهُ إبْليسٌ فَمَنْ ذا أَنَا ال","مِسْكينُ إنْ إِبْليسُ أَغْواهُ",10,"ه",1,0],["أغويتَ أمّي وهي جِدُّ ضعيفةٍ","فَجَرَتْ بقاعِ الغَيِّ جَريَ جِماحِ",11,"ح",1,0],["أغوى بها إبليسُ قِدماً آدَماً","وهي السَّريرة في هواها الباقي",12,"ق",2,0],["أَغوُصُ في لُجِّ بَحرٍ مِن مَديحِكُمُ","فَما أُصادِفُ إِلّا الدُرَّ لا الصَدَفا",13,"ف",2,0],["أغور بفكرتي في بحر هم","أرى امواجه متلاطمات",14,"ت",1,0],["أغوص منه بقلب","من التبخر واق",15,"ق",1,0],["أغوَالُهُ وقفٌ عَلضى أرجَائِهِ","فالرِّيحُ إن مرَّت بِهِ تترنَّمُ",16,"م",1,0],["أَغِواراً أَمْ غَيرةً أَنْ يُرى اللي","لُ لضوءِ الصباحِ منكَ خُشُوعَا",17,"ع",2,0],["أغوصُ عليْهِ للمدائِحِ فيكَ لا","لِيُنظمَ في مَثْنى العُقودِ ويُنْسَقا",18,"ق",2,0],["أَغوَى عقولَ الشعب فانقادوا إلى","آرائِهِ كالعُصبةِ العُميانِ",19,"ن",1,0],["إغواء ذات الدلالِ صينت","في ذروة المعقل الحصين",20,"ن",1,0],["أغويه أغراه أم في قلبه","مرض سقاه نقيع سم قاتل",21,"ل",1,0],["أغواه عاذله في أن يماطلني","من لي بوصل رشا أغراه عاذله",22,"ل",2,0],["أَغْوَتْهُمُ فِي مَصَالِي الغَرْبِ شِرْذِمَةٌ","لا يُبْصِرُونَ جَمَالاً غَيْرَ مَا اتَّضَعَا",23,"ع",2,0],["أغويتني بالدل صرت ُ أرى","أمم َ الدلال إليك ِ تحتكم ُ",24,"م",1,0],["أغوت بنات البِكرْ بالتقوى","وبنيها بالأموال واحتلَّتْ",25,"ت",1,0],["أغويتَ ليلي كي يطولَ شجىً","ورَجوتَهُ أنْ يذبَحَ الفجْرا",26,"ر",2,0],["أغويت قلبي أن تراه سويعة","لتغوصَ في بحرِ الغرامِ ثوانِ",27,"ن",1,0],["أغويت أمي وهي جد ضعيفة","فجرت بقاع البغي جري جماح",28,"ح",1,0],["أَغُوصُ إِلى عُمقِي لعلَّ محَارَةً","إِلى الخَاطِرِ المكنُونِ فِيهَا أُخاطِرُ",29,"ر",1,0],["أغواني َ الأمل ُ الركيك ُ بقصّتي","ونفاني َ الإيقاع ُ والتزمير ُ",30,"ر",1,0],["أغويتُ شعري بالحروفِ تدلُّلاً","لكنَّهُ قد حَارَ في إغوائيهْ",31,"ي",2,0],["أغوصُ ووجهيَ الشَّفافُ يحبو","فتغْرقُ ذي الوسائِدُ بالمُذيبِ",32,"ب",1,0],["اغواهُ زنيمٌ ذو سَفَهٍ","برطينِ الحرفِ يُشرِّدُهُ",33,"د",2,0],["أغويتني ببريق كنت أجهله","حتى تراءى لعيني غير براق",34,"ق",1,0],["أغواني قلبي ..أوهمني","أرهقني حدّ الأسكاتِ",35,"ت",1,0],["أَغْوَى بِها إبْلِيسُ عُبَّادَ الهَوَى","وَحَثَا التَّباغُضَ بَيْنَهُم حَثْوَ الثَّرَى",36,"ر",2,0],["أغواه قوم طغاةً لا خلاق لهم","فوازروه فأبدى جهله السرفا",37,"ف",2,0],["أغوارُها من دموعِ العينِ مغرقةٌ","والمزْنُ فيها فما جفَّتْ مآقيها",38,"ي",3,0],["أغوى الشبابُ فسائلي يا ليتني","لم أتَّخذهُ لحقل ِأُنس ٍ مَوضِعا",39,"ع",2,0],["أَغْوَيْتَ فُؤَادِي يَا رَجُلاً","قَدْ تَنْزِفُ مِنِّي قِصَّتُهُ",40,"ت",2,0],["أَغُوصُ بِيَمِّكِ اللُّجِّيِّ كَيْمَا","أَحُوزَ الدُّرَّ أَصْنَعَ مِنْهُ كَأْسِي",41,"س",2,0],["أغوتكَ بالحبِّ.. صارتْ فيكَ آمرةً","شموخُ صَمتكَ هزَّتهُ القواريرُ",42,"ر",1,0],["(إغو شَلَاييمُ) وهْيَ الأصْلُ لِاسْمي","لَآرامِيَّةٌ معْنىً وجَرْسا",43,"س",2,0],["أغويتني وهديتهم","فعميت لما أبصروا",44,"ر",3,0],["أغوى اللعين جذورنا لما صغوا","وكذا سيردي ههنا الإصغاء",45,"ا",2,0],["أغوص بعمق قافيتي","وفيكَ البحرُ .. ينكسرُ",46,"ر",1,0],["أغوص بعيني أغوص بأنفي","أغوص بروحي إلى المستترْ",47,"ر",1,0],["‏أغوص بحسنك الوافي","‏ ‏ وما إن أرتوي أظما",48,"م",2,0],["أغور أعوم، وكم أتملَّى","وأهْنا بسرِّ هواك وأشقى",49,"ق",2,0],["أغوص هُنا وأعوم هناك","وأهوِي وأعلو ولا أستقرّْ",50,"ر",1,0],["أغوص بعيداً عن همومي لمنظر","من الماء في الأحجار يرقص جاريا",51,"ي",2,0],["اغووه غيّ ٍ ممتلي غلّي","حقد ٍ مدسّس بالشراييني",52,"ن",2,0],["أغواكم حقد وزينه","خبل بكم يا آل ذي حسد",53,"د",1,0],["أَغوَيتَنِي, فَجَرَرتَني (قِيثارَةً)","وَقَرَعتَني بِالغَدرِ, فاشَّقَّقتُ (طَبلا)",54,"ل",2,0],["أغوصُ إلى مكمن الدر فيه","أسامرُ أصدافه الوادعاتْ",55,"ت",1,1],["أغوصُ فأقطفُ المرجانَ منهُ","وأجني دون خوفٍ مُستطابَهْ",56,"ب",2,0]]}