5956,"وُدٌّ وصدٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=215205",""],[6093,"شيطان صعدة","https://www.poetsgate.com/ViewPoem.aspx?id=198391",""],[5561,"قل لي من تكون ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86133&r=&rc=1",""]],"verses":[["حَتَّى عَدِمْنَاهَا فَعِزَّتُنَا","كَالذلِّ وَالإِثْرَاءِ كَالعَدَمِ",0,"م",1,0],["حتى عَلا بَيتُك المُهَذَّبُ من","خِندِفَ عَليَاءَ تَحتَها العَرَبُ",1,"ب",1,0],["حتَّى عن الظليل حجّبت الهدى","وسخرت بالمتنبئ المتأله",2,"ه",1,0],["حتى علمنا علم مستيقِنٍ","أن الثريا من شَمَاريخه",3,"خ",2,0],["حتى علوتهُمُ بالسيف فانتبهوا","من رقْدةٍ لم يَنَمْها قبلَهم أحدُ",4,"د",1,0],["حتى علوْتُهُم بالسيف فانتبهوا","من بعد أن كان قد هَبُّوا كأنْ هَجدوا",5,"د",3,1],["حتى عثوا في نساء كالدمى عُرُبٍ","إذ لم يكن بينهم باب بمغلاق",6,"ق",1,0],["حَتّى عَبَرنَ بِأَرسَناسَ سَوابِحاً","يَنشُرنَ فيهِ عَمائِمَ الفُرسانِ",7,"ن",1,0],["حتى علا الجوَّ دجىً لم يَغْتَبِقْ","فيه الثّرَى من الحيا كما اصطَبَح",8,"ح",1,0],["حَتّى عَلا الحَقُّ في الآفاقِ وَاِطَّرَدَت","بيضُ الشَرائِعِ تَهدي كُلَّ ضِلّيلِ",9,"ل",1,0],["حَتّى عَدانا كاشِحٌ شامِتٌ","يَجعَلُ نارَ الحُبِّ نِيرانا",10,"ن",2,0],["حَتّى عَلا رَأسَ القَناةِ رَأسُهُ","وَزالَ عَنهُ كَيدُهُ وَبَأسُهُ",11,"ه",1,0],["حَتّى عَلا في الجَوِّ مِن شِياطِهِ","حَتّى عَلا في الجَوِّ مِن شِياطِهِ",12,"ط",2,0],["حتى علاني وأنا تحته","أدعو على الحرمات باللعنِ",13,"ن",1,0],["حَتّى عَطَفناهُمُ عَطفَ الضَرَّوسِ وَهُم","يَلقَونَ مِمّا تخافُ النَفسُ بَلبالا",14,"ل",2,0],["حتى علا التاج على العمامهْ","وعاد ملكاً نسق الإمامهْ",15,"ه",1,0],["حتى على الموت الزؤام نومكم","وليته موت على حفظ الحمى",16,"ا",1,0],["حتى عرّاها إخوتها","من اكفان الحسب الأعلى",17,"ل",2,0],["حتّى عميت فكاد يعميها البكا","وحنانها الباكي يشاركني العمى",18,"م",2,0],["حَتّى عَلَوتَ بِأَفعالٍ أَمِنتَ بِها","مِن أَن يَقولَ حَسودٌ حافَ مَن قَسَما",19,"م",2,0],["حتى عصوكَ وغرْتهم سلامُتهم","وذكر عفوك المحيي فما ذكروا",20,"ر",3,0],["حَتّى عَفَونَ جَدِيدُهُنَّ مَعَ البِلَى","إِنَّ الجَدِيدَ إِلى بِلىً وزَوالِ",21,"ل",1,0],["حتى علت راية الاسلام وانتصبت","في الحال واندرست تلك التماثيل",22,"ل",1,0],["حتى عقدت دولة لم تُعْقَد","قبلك يا بن الخُلفاء المُجَّد",23,"د",1,0],["حَتّى عَلَوتُ بِحُجَّتي","وَالناسُ كُلُّهُمُ خُصومُ",24,"م",1,0],["حتى على أقصرِ اللذّاتِ تحسدُنا","وقد غَصَصنا بما في الهمِّ نجرعه",25,"ع",2,0],["حَتّى عَلَوا سورَها مِن كُلِّ ناحِيَةٍ","وَحانَ مَن كانَ فيها فَهوَ مَلهوفُ",26,"ف",1,0],["حتى عثرتَ بما عثر","تَ به وقلبك فيه هاجس",27,"س",1,0],["حتى عرفت بني الزما","ن بالاختلاط والامتزاج",28,"ج",1,0],["حتَّى عن الشَّمس وأضوائها","بذلك التَّاريخ حال الغبار",29,"ر",1,0],["حتَّى علمتُ ولم أكن بكَ جاهلاً","يا ثالثَ القمرين أنَّك مفرد",30,"د",1,0],["حتَّى عفت أطلال كلّ فضيلة","فليبك من يبكي على الأَطلال",31,"ل",1,0],["حتى علِقْتُ بأستارِ الجمالِ به","وقلتُ رُحماكَ يا مستعذِبَ التّيهِ",32,"ي",2,0],["حَتَّى عَبَرْنَ خليجَ دُويْرُ كَأَنَّها","سُفُنٌ ترامى بالحتوفِ بِحارُها",33,"ر",3,0],["حتى علقتُ بساهرٍ","حبُّ الضيوف يؤرّقُهْ",34,"ق",2,0],["حتى علت من بيته سحابةٌ","جفَّ لها ما قبلها وأقشعا",35,"ع",2,0],["حتى عهدت لضفدع","فجعلته بشراً سويا",36,"ي",2,0],["حتى عليه فتى من أهل ملتنا","قد قال في رده نظماً بإنشاء",37,"ا",2,0],["حتى عَصانيَ صَبري بعدَ طاعتهِ","وطاعني بذلُ دَمعٍ كانَ في عِصَمِ",38,"م",1,0],["حتىّ علاها تامك","شبهته وانتص فِندا",39,"د",2,1],["حتى علمتُ بأَنَّ ما أَرْثي به","دُونٌ ولو رثَّيتُه بِقُرَان",40,"ن",1,0],["حتى عَتوا وتمرّدوا وسطَوْا بها","بَطَراً فأسرَعَ في شَواها المُنْصُلُ",41,"ل",1,0],["حَتَّى عَلِقْتُ فَتىً أفْنَى الفُؤَاد بِمَا","حَوَتْهُ عَيْنَاهُ مِنْ غُنْجٍ وَتَفْتِيرِ",42,"ر",1,0],["حتى علاني الشيبُ قبل تحلّم","وأبرّ ما سبق المشيب المولد",43,"د",1,0],["حتى علمنا موقعَ الأقدار","وَضَبَّتي فجمرةُ الجمار",44,"ر",1,0],["حَتّى عَنِ الغَيداءِ لَو أَيقَنتَها","تُبدي هَواكَ وَلَو لَدى لَحَظاتِها",45,"ت",3,0],["حَتّى عَفا مِن هَمّه وَغَمِّه","وَمِن أَبيه يَشتَكي وَأمِّه",46,"ه",1,0],["حَتّى عَفا كُلٌّ بِداء الجوعِ","وَمالَت الروح إِلى الطُلوعِ",47,"ع",1,0],["حَتّى عَلَيهِ أذهب الأَموالا","وَانحَط مِن فَقرٍ بِهِ وَمالا",48,"ل",2,0],["حتى علمتُ بكل مخلوقٍ على الدْ","دُنْيا وإن طال المدى يتغيرَّ",49,"ر",1,0],["حتى عُطَاسُكَ صرتَ تَعطِسُهُ متى","لَمَسَتْ يَدَا (إيرانِكَ) الأزرَارا",50,"ر",2,0],["حتى علقت من بني هلال","جارية حسناء كالتمثال",51,"ل",1,0],["حتى عرته صروف الدهر جايزةً","عليه واقتلعت من قلبه الفرحا",52,"ح",2,0],["حَتّى عَلَتني مِن لَبِيدٍ لَطمَةٌ","خَطَأً لِحامي حَرِّها العَينانِ",53,"ن",1,0],["حتى عدت ايدي المنون وبددت","شملي بمصرع خيرة الصلحاء",54,"ا",2,0],["حتَّى عليه الثريَّا لم تطأ قدمٌ","ذو منظرٍ عنه ثغرُ الدهرِ مبتسمٌ",55,"م",1,0],["حتَّى على رزء الهدى بقلبه","أرزاءُ كل آله أعادها",56,"د",3,0],["حتَّى عن الديمةِ الوطفاء","كم رقَّ ديباجُ نظمي وشيا",57,"ي",2,0],["حتَّى علمنا بأنَّ الابتلاءَ به","ما للنبيينَ عندَ اللهِ للعلما",58,"م",2,0],["حتى عثرت بحلة","دب الفساد بها دبكْ",59,"ك",1,0],["حتى عثرتُ بمطلبي فغدوتُ من","طرب المسَرَّةِ راقصَ الأقدامِ",60,"م",1,0],["حتى عرفت بأن الناس إن شربوا","لم ينقصوه ولو جاؤوا بالفيل",61,"ل",1,0],["حَتّى عَلَتنِي مِن لَبِيدٍ لَطمَةٌ","سُجِرَت لَها مِن حَرِّها العَينانِ",62,"ن",1,0],["حَتَّى عَلى غَفلَةٍ خَلَستُ سُبحَتَها","لتذكرَنِّي بِهَا أو عهدِ إيناسِ",63,"س",1,0],["حَتّى عَلَوتُ بِهِ مَشَقَّ ثَنِيَّةٍ","طَوراً أَغورُ بِها وَطَوراً أُنجِدُ",64,"د",1,0],["حَتَّى عَلِقتُ النَّيِّرَيْنِ فأَعْلقَا","مَثنى يَدِي مَلِكَ الملوكِ النَّيِّرا",65,"ر",2,0],["حتى عبرت إليك البحر منتصراً","أيام عدت بما أوليت جذلانا",66,"ن",2,0],["حتى على الأرض ضعفا","كاد لا يقف",67,"ف",1,0],["حتى عدت سدرةً للمنتهى وبه","تسري إلى العرش لا فخراً ولا تيها",68,"ي",3,0],["حتى عرجت إلى ثجاجةٍ نطفٍ","ما كان يدركها سمع ولا بصرُ",69,"ر",1,0],["حتى عقايد هذا العصر قد فسدت","الا القليل كشامات على بهم",70,"م",1,0],["حتى عفا ذاك الغرا","م وغاية النار الرماد",71,"د",1,0],["حتى عني الأحياء من آلا ودي","وأقر أن من عرفت مني السلاما",72,"م",2,0],["حتى على اسمها الفتان يشمت بي","اذا ذكرت اسمها الفتان في كلمي",73,"م",2,0],["حتى عرفت فقلت يا مصر ابشري","سترين سعداً من رجالك قادما",74,"م",2,0],["حَتّى عَدا طَورَهُ وَحُقَّ لِمَن","يَكفُر نُعمى بِقُربِ تَغييرِ",75,"ر",1,0],["حتى على العجم حلَّت","من جورك الأهوال",76,"ل",1,0],["حتى عرفنا بأن العقل رائدنا","نرعى الجميل لمن بالمثل يرعانا",77,"ن",2,0],["حتى علت إيذة في الصعيد","فأعملوا مناصل الحديد",78,"د",1,0],["حَتّى عَلَيهِ التَوى بِالعُنفِ يَلسَعُهُ","في بارِزِ الصَدرِ حَيثُ التَفَّتِ العُنُقُ",79,"ق",1,0],["حتى عيون الزهر في الجنات","ولم أزل وذاته حياتي",80,"ي",1,0],["حَتّى عَشِقتُ لِحُسنِ لَفتَتِكَ الظَبا","وَلَكم رَأَيت مِنَ الهَوى مُستَغرِباً",81,"ب",2,0],["حتّى عثرتَ وأَخجل","ت باِفتضاح السآمَه",82,"م",2,0],["حتى على الديجور سل","الصبح صارمه وجرد",83,"د",1,0],["حتى على المروة حطوا الأرجلا","وفعلوا ذلك سبعاً كملا",84,"ل",2,0],["حتى علقت بحب آل بني","الزهراء فاستوى بي الخبل",85,"ل",1,0],["حتى عيونَ ظباءِ لا تَشيمُ ظُباً","وإنَّما تقتلُ العشّاقَ بالنَّظرِ",86,"ر",1,0],["حتى على رُوما التي تملا","مدائحها المسامع",87,"ع",1,0],["حتى علتني من لبيد لطمة","سدرت لحامي حرها العينان",88,"ن",1,0],["حتى على الحِقدِ تَبدُو غيرَ قادِرَةٍ","أَروَاحُنا، فهو نارٌ، والأَسَى طِينِي",89,"ن",2,0],["حتى على الزلات /وياه في صفه","مقدر اعارض / مصدرٍ حيل يرويني",90,"ن",2,0],["حتى عليه أقبلتْ لا ترى","غيرَ الذي يمشي به طيبا",91,"ب",2,0],["حتى عبيد البرِّ قد سخروا","بنا مع من سخر",92,"ر",1,0],["حتى عرفت حقيقة الحال التي","تعريفها عنه تجلى الغيهب",93,"ب",1,0],["حتى عمدت الدين يا ابن عماده","بقنا أسنتها عليه منار",94,"ر",1,0],["حتى عمرت بكل قلب صدره","حين الصدور في القلوب قفار",94,"ر",1,0],["حتى عدونا بالفسادِ نجرّهُ","نرميهِ للمستقبلِ استقبالا .",95,"ل",2,0],["حتى عراكَ من الهزيمة عارضٌ","حطَّمتَ منه يراعك المسلولا",96,"ل",2,0],["حتّى عن البيتِ العتيقِ تفرّقوا","فإذا الطوافُ عن الورى محجوبُ",97,"ب",1,0],["حتى عجزْتِ فما انتضيتِ لعزةٍ","من بؤسِها يبكي النجيعُ خضابَها",98,"ب",3,0],["حتى على الشمس لي بصمه وليه ظلال","وأصرف من الراس بعد الله ثم الكمر",99,"ر",1,0],["حتى علت أ ' لام ملتك التي","عمت حزوناً في السرى وسهولا",100,"ل",2,0],["حتى عرجتَ إلى السماءِ تجوبُها","فملائكٌ تُثني عليكَ معاليا",101,"ي",2,0],["حتى عجبت له غداة جلوته","يختال في حلل بها حليته",102,"ت",2,0],["حتىٰ علتْ فوق الأنام بهديها","تهدي .. ليُسعِدَ هديُها الإنسانا",103,"ن",2,0],["حتّى على حُفرةٍ في الأرضِ قد حُسدَتْ","هل يُهلِك الناسَ إلّا الغِلُّ والحسدُ",104,"د",1,0],["حتى عرفته زين والحين مذهول","وقت انهزامي صار وقت انتصارة",105,"ر",2,0],["حتى عرفتك أدركت الحقائق ذي","باب الحقائق كم نلقاه موصودا",106,"د",2,0],["حتى علاه من الحديد مطارد","من طائرات الفتك والأمراس",107,"س",1,0],["حتى عرفتُكَ في ظلام النفسِ غوثَ السالكينْ","طُهْرُ النفوسِ بلا ذنوبٍ شرعةٌ للخائفينْ",108,"ن",1,0]]}