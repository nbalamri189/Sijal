{"poems":[[93,"يا نعمة عظمت فلم تدم","https://www.aldiwan.net/poem11297.html","أحذ الكامل"],[37,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[72,"محراب صدغيه يحث توجهي","https://www.aldiwan.net/poem20511.html","الكامل"],[51,"يا ذا الذي ضن بآزاذه","https://www.aldiwan.net/poem9437.html","السريع"],[51,"أدركت بالحزم والتدبير ما عجزت","https://www.aldiwan.net/poem61926.html","البسيط"],[51,"حتى علوتهم بالسيف فانتبهوا","https://www.aldiwan.net/poem61927.html","البسيط"],[51,"لا يكشف الله عن وهب بن إسحاق","https://www.aldiwan.net/poem65708.html","البسيط"],[43,"الرأي قبل شجاعة الشجعان","https://www.aldiwan.net/poem10580.html","الكامل"],[80,"أي نعيم في الصبا والمقترح","https://www.aldiwan.net/poem31521.html","الرجز"],[105,"حيوا الهلال وحيوا أمة النيل","https://www.aldiwan.net/poem43087.html","البسيط"],[40,"هاج محل الحي أحزانا","https://www.aldiwan.net/poem42277.html","السريع"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[48,"أنعت كلبا جال في رباطه","https://www.aldiwan.net/poem64372.html","البسيط"],[48,"أصبح أيري معرضا عني","https://www.aldiwan.net/poem66284.html","السريع"],[8,"إما تري ظلل الأيام قد حسرت","https://www.aldiwan.net/poem21815.html","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202541","الرجز"],[141,"إني وإن كنت في الأقوال محتكما","https://www.aldiwan.net/poem11816.html","البسيط"],[158,"يا من عطاياه منها النصر والظفر","https://www.aldiwan.net/poem58802.html","البسيط"],[179,"يا صاحبى قفا على الأطلال","https://www.aldiwan.net/poem58842.html","الكامل"],[208,"رأى العقيق فأجرى دمعه لولو","https://www.aldiwan.net/poem13306.html","البسيط"],[227,"وصامت الجو بعيد الفرقد","https://www.aldiwan.net/poem51126.html","الكامل"],[233,"حتام مطلك يا ظلوم","https://www.aldiwan.net/poem31762.html","مجزوء الكامل"],[268,"حتام يشفى الفتى والدهر يدفعه","https://www.aldiwan.net/poem35620.html","البسيط"],[320,"إن الوليد أمير المؤمنين له","https://www.aldiwan.net/poem56352.html","البسيط"],[374,"قلب يقلبه النوى","https://www.aldiwan.net/poem59383.html","مجزوء الكامل"],[400,"وافت على وفق احتياجي","https://www.aldiwan.net/poem34096.html","مجزوء الكامل"],[413,"غير وجه الجو في حمرة","https://www.aldiwan.net/poem54009.html","السريع"],[413,"أنا في هواكم مطلق ومقيد","https://www.aldiwan.net/poem54136.html","الكامل"],[413,"هاج القرام وهيجا بلبالي","https://www.aldiwan.net/poem54163.html","الكامل"],[429,"خذوا لقلبي أمانا من تجنيه","https://www.aldiwan.net/poem12768.html","البسيط"],[436,"إن تفخر الدنيا فأنت فخارها","https://www.aldiwan.net/poem34810.html","الكامل"],[456,"سلك الخيال بحاجر","https://www.aldiwan.net/poem56096.html","مجزوء الكامل"],[456,"حب إليها بالغضا مرتبعا","https://www.aldiwan.net/poem56125.html","السريع"],[462,"أفتى علي لم تزل","https://www.aldiwan.net/poem3121.html","عموديه"],[556,"قد قال من قال من جهل وإغواء","https://www.aldiwan.net/poem35078.html","البسيط"],[560,"عاج المتيم بالأطلال في العلم","https://www.aldiwan.net/poem52913.html","البسيط"],[567,"حتى علاها تامك","https://www.aldiwan.net/poem52026.html","مجزوء الكامل"],[573,"أصبحت بعدك في الحياة كفان","https://www.aldiwan.net/poem2773.html","الكامل"]],"verses":[["حَتَّى عَدِمْنَاهَا فَعِزَّتُنَا","كَالذلِّ وَالإِثْرَاءِ كَالعَدَمِ",0,"م",1,0],["حتى عَلا بَيتُك المُهَذَّبُ من","خِندِفَ عَليَاءَ تَحتَها العَرَبُ",1,"ب",1,0],["حتَّى عن الظليل حجّبت الهدى","وسخرت بالمتنبئ المتأله",2,"ه",1,0],["حتى علمنا علم مستيقِنٍ","أن الثريا من شَمَاريخه",3,"خ",2,0],["حتى علوتهُمُ بالسيف فانتبهوا","من رقْدةٍ لم يَنَمْها قبلَهم أحدُ",4,"د",1,0],["حتى علوْتُهُم بالسيف فانتبهوا","من بعد أن كان قد هَبُّوا كأنْ هَجدوا",5,"د",3,1],["حتى عثوا في نساء كالدمى عُرُبٍ","إذ لم يكن بينهم باب بمغلاق",6,"ق",1,0],["حَتّى عَبَرنَ بِأَرسَناسَ سَوابِحاً","يَنشُرنَ فيهِ عَمائِمَ الفُرسانِ",7,"ن",1,0],["حتى علا الجوَّ دجىً لم يَغْتَبِقْ","فيه الثّرَى من الحيا كما اصطَبَح",8,"ح",1,0],["حَتّى عَلا الحَقُّ في الآفاقِ وَاِطَّرَدَت","بيضُ الشَرائِعِ تَهدي كُلَّ ضِلّيلِ",9,"ل",1,0],["حَتّى عَدانا كاشِحٌ شامِتٌ","يَجعَلُ نارَ الحُبِّ نِيرانا",10,"ن",2,0],["حَتّى عَلا رَأسَ القَناةِ رَأسُهُ","وَزالَ عَنهُ كَيدُهُ وَبَأسُهُ",11,"ه",1,0],["حَتّى عَلا في الجَوِّ مِن شِياطِهِ","حَتّى عَلا في الجَوِّ مِن شِياطِهِ",12,"ط",2,0],["حتى علاني وأنا تحته","أدعو على الحرمات باللعنِ",13,"ن",1,0],["حَتّى عَطَفناهُمُ عَطفَ الضَرَّوسِ وَهُم","يَلقَونَ مِمّا تخافُ النَفسُ بَلبالا",14,"ل",2,0],["حتى علا التاج على العمامهْ","وعاد ملكاً نسق الإمامهْ",15,"ه",1,0],["حَتّى عَلَوتَ بِأَفعالٍ أَمِنتَ بِها","مِن أَن يَقولَ حَسودٌ حافَ مَن قَسَما",16,"م",2,0],["حتى عصوكَ وغرْتهم سلامُتهم","وذكر عفوك المحيي فما ذكروا",17,"ر",3,0],["حَتّى عَفَونَ جَدِيدُهُنَّ مَعَ البِلَى","إِنَّ الجَدِيدَ إِلى بِلىً وزَوالِ",18,"ل",1,0],["حتى علت راية الاسلام وانتصبت","في الحال واندرست تلك التماثيل",19,"ل",1,0],["حتى عقدت دولة لم تُعْقَد","قبلك يا بن الخُلفاء المُجَّد",20,"د",1,0],["حَتّى عَلَوتُ بِحُجَّتي","وَالناسُ كُلُّهُمُ خُصومُ",21,"م",1,0],["حتى على أقصرِ اللذّاتِ تحسدُنا","وقد غَصَصنا بما في الهمِّ نجرعه",22,"ع",2,0],["حَتّى عَلَوا سورَها مِن كُلِّ ناحِيَةٍ","وَحانَ مَن كانَ فيها فَهوَ مَلهوفُ",23,"ف",1,0],["حتى عثرتَ بما عثر","تَ به وقلبك فيه هاجس",24,"س",1,0],["حتى عرفت بني الزما","ن بالاختلاط والامتزاج",25,"ج",1,0],["حتَّى عن الشَّمس وأضوائها","بذلك التَّاريخ حال الغبار",26,"ر",1,0],["حتَّى علمتُ ولم أكن بكَ جاهلاً","يا ثالثَ القمرين أنَّك مفرد",27,"د",1,0],["حتَّى عفت أطلال كلّ فضيلة","فليبك من يبكي على الأَطلال",28,"ل",1,0],["حتى علِقْتُ بأستارِ الجمالِ به","وقلتُ رُحماكَ يا مستعذِبَ التّيهِ",29,"ي",2,0],["حَتَّى عَبَرْنَ خليجَ دُويْرُ كَأَنَّها","سُفُنٌ ترامى بالحتوفِ بِحارُها",30,"ر",3,0],["حتى علقتُ بساهرٍ","حبُّ الضيوف يؤرّقُهْ",31,"ق",2,0],["حتى علت من بيته سحابةٌ","جفَّ لها ما قبلها وأقشعا",32,"ع",2,0],["حتى عهدت لضفدع","فجعلته بشراً سويا",33,"ي",2,0],["حتى عليه فتى من أهل ملتنا","قد قال في رده نظماً بإنشاء",34,"ا",2,0],["حتى عَصانيَ صَبري بعدَ طاعتهِ","وطاعني بذلُ دَمعٍ كانَ في عِصَمِ",35,"م",1,0],["حتىّ علاها تامك","شبهته وانتص فِندا",36,"د",2,1],["حتى علمتُ بأَنَّ ما أَرْثي به","دُونٌ ولو رثَّيتُه بِقُرَان",37,"ن",1,0]]}