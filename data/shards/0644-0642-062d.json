{"poems":[[63,"نبأ تقاصر دونه الأنباء","https://www.aldiwan.net/poem46201.html","الكامل"],[73,"أقدم كما قدم الربيع الباكر","https://www.aldiwan.net/poem11942.html","الكامل"],[27,"صرم الخليط تباينا وبكورا","https://www.aldiwan.net/poem5774.html","الكامل"],[39,"يا دار أقوت بعد أصرامها","https://www.aldiwan.net/poem53746.html","السريع"],[233,"عد نصحا ملامي العذال","https://www.aldiwan.net/poem31788.html","الخفيف"],[233,"لمن الركائب تستقي","https://www.aldiwan.net/poem31796.html","مجزوء الكامل"],[273,"أذنت أرض العدى بافتتاح","https://www.aldiwan.net/poem25601.html","المديد"],[459,"قربا مني حسامي وجوادي","https://www.aldiwan.net/poem15102.html","الرمل"]],"verses":[["لَقِحَتْ بهِ الأرضُ العَقيمُ وأُسْقِيَتْ","سَبَلَ الحَيا فكأنَّها عُشَراءُ",0,"ا",2,0],["لَقَّحتَ ذِهني فَاِجنِ غَضَّ ثِمارِهِ","فَالنَخلُ يُحرِزُ مُجتَناهُ الآبِرُ",1,"ر",1,0],["لَقِحَت لِأَشهَبَ بِالكُناسَةِ داجِنٍ","خِنزيرَةٌ فَتَوالَدا خِنزيرا",2,"ر",2,0],["لَقَّحَها الأَبّارُ فَاِستَوسَقَت","قِنوانُها مِن قَبلِ إِتمامِها",3,"م",3,0],["لَقِحَت عِندَهُ الأَماني وَعَهدي","بِأَماني الصُدورِ وَهيَ حِيالُ",4,"ل",1,0],["لَقِحَت عَلى طولِ الحَيا","لِ وَرَوَّضَت بَعدَ المُحولِ",5,"ل",1,0],["لَقِحَتْ حَرْبُهُمُ عَن حِيَالٍ","أنِسُوا إلْحَاقَهُم باللقَاح",6,"ح",1,0],["لقحتْ حربُ بني فاعلةٍ","جهلوا حقِّي ولم يرعوا ودادي",7,"د",2,0]]}