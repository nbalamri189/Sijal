{"poems":[[65,"نبأ تقاصر دونه الأنباء","https://www.aldiwan.net/poem46201.html","الكامل"],[75,"أقدم كما قدم الربيع الباكر","https://www.aldiwan.net/poem11942.html","الكامل"],[29,"صرم الخليط تباينا وبكورا","https://www.aldiwan.net/poem5774.html","الكامل"],[41,"يا دار أقوت بعد أصرامها","https://www.aldiwan.net/poem53746.html","السريع"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62223","الكامل"],[238,"عد نصحا ملامي العذال","https://www.aldiwan.net/poem31788.html","الخفيف"],[238,"لمن الركائب تستقي","https://www.aldiwan.net/poem31796.html","مجزوء الكامل"],[278,"أذنت أرض العدى بافتتاح","https://www.aldiwan.net/poem25601.html","المديد"],[463,"قربا مني حسامي وجوادي","https://www.aldiwan.net/poem15102.html","الرمل"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/21489","الكامل"]],"verses":[["لَقِحَتْ بهِ الأرضُ العَقيمُ وأُسْقِيَتْ","سَبَلَ الحَيا فكأنَّها عُشَراءُ",0,"ا",2,0],["لَقَّحتَ ذِهني فَاِجنِ غَضَّ ثِمارِهِ","فَالنَخلُ يُحرِزُ مُجتَناهُ الآبِرُ",1,"ر",1,0],["لَقِحَت لِأَشهَبَ بِالكُناسَةِ داجِنٍ","خِنزيرَةٌ فَتَوالَدا خِنزيرا",2,"ر",2,0],["لَقَّحَها الأَبّارُ فَاِستَوسَقَت","قِنوانُها مِن قَبلِ إِتمامِها",3,"م",3,0],["لَقِحَتْ حَوَائِلُ حُوللٍ لِتَمَامِهِ","رقب ودبر كَبْشَةَ عِرْمِسِ",4,"س",1,0],["لَقِحَت عِندَهُ الأَماني وَعَهدي","بِأَماني الصُدورِ وَهيَ حِيالُ",5,"ل",1,0],["لَقِحَت عَلى طولِ الحَيا","لِ وَرَوَّضَت بَعدَ المُحولِ",6,"ل",1,0],["لَقِحَتْ حَرْبُهُمُ عَن حِيَالٍ","أنِسُوا إلْحَاقَهُم باللقَاح",7,"ح",1,0],["لقحتْ حربُ بني فاعلةٍ","جهلوا حقِّي ولم يرعوا ودادي",8,"د",2,0],["لَقِحَ العجافُ لَهُ لِسابعِ سَبعَةٍ","وَشَرِبنَ بَعدَ تَحَلُّؤٍ فَرَوينا",9,"ن",2,0]]}