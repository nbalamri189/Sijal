{"poems":[[65,"نبأ تقاصر دونه الأنباء","https://www.aldiwan.net/poem46201.html","الكامل"],[75,"أقدم كما قدم الربيع الباكر","https://www.aldiwan.net/poem11942.html","الكامل"],[29,"صرم الخليط تباينا وبكورا","https://www.aldiwan.net/poem5774.html","الكامل"],[41,"يا دار أقوت بعد أصرامها","https://www.aldiwan.net/poem53746.html","السريع"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62223","الكامل"],[240,"عد نصحا ملامي العذال","https://www.aldiwan.net/poem31788.html","الخفيف"],[240,"لمن الركائب تستقي","https://www.aldiwan.net/poem31796.html","مجزوء الكامل"],[280,"أذنت أرض العدى بافتتاح","https://www.aldiwan.net/poem25601.html","المديد"],[466,"قربا مني حسامي وجوادي","https://www.aldiwan.net/poem15102.html","الرمل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101018","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53132","الكامل"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21489","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100246","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74178","الرمل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62885","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102940","الكامل"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111048","الكامل"]],"verses":[["لَقِحَتْ بهِ الأرضُ العَقيمُ وأُسْقِيَتْ","سَبَلَ الحَيا فكأنَّها عُشَراءُ",0,"ا",2,0],["لَقَّحتَ ذِهني فَاِجنِ غَضَّ ثِمارِهِ","فَالنَخلُ يُحرِزُ مُجتَناهُ الآبِرُ",1,"ر",1,0],["لَقِحَت لِأَشهَبَ بِالكُناسَةِ داجِنٍ","خِنزيرَةٌ فَتَوالَدا خِنزيرا",2,"ر",2,0],["لَقَّحَها الأَبّارُ فَاِستَوسَقَت","قِنوانُها مِن قَبلِ إِتمامِها",3,"م",3,0],["لَقِحَتْ حَوَائِلُ حُوللٍ لِتَمَامِهِ","رقب ودبر كَبْشَةَ عِرْمِسِ",4,"س",1,0],["لَقِحَت عِندَهُ الأَماني وَعَهدي","بِأَماني الصُدورِ وَهيَ حِيالُ",5,"ل",1,0],["لَقِحَت عَلى طولِ الحَيا","لِ وَرَوَّضَت بَعدَ المُحولِ",6,"ل",1,0],["لَقِحَتْ حَرْبُهُمُ عَن حِيَالٍ","أنِسُوا إلْحَاقَهُم باللقَاح",7,"ح",1,0],["لقحتْ حربُ بني فاعلةٍ","جهلوا حقِّي ولم يرعوا ودادي",8,"د",2,0],["لقحن بأسباب الخراب وإنما","لقين بها حتف الولود المطرق",9,"ق",1,0],["لقحت بضربك عقمها فنتاجها","شر أذل من الطغاة الأصعرا",10,"ر",2,0],["لَقِحَ العجافُ لَهُ لِسابعِ سَبعَةٍ","وَشَرِبنَ بَعدَ تَحَلُّؤٍ فَرَوينا",11,"ن",2,0],["لقحت بك الامال وهي عقائم","إذا كنت للأمر العقام لقاحا",12,"ح",2,0],["لَقحت مِنهُ فَأَلقت أَنجُما","كَقِباب الدر لا تَخشى الفِطاما",13,"م",2,0],["لَقحوا الحروبَ بكل مُلْجَمَةٍ","تَتَقَحَّمُ الغَمراتِ أَو تُخلَى",14,"ل",2,0],["لقحت به عقم الممالك وارعوى","بعد المشيب لها الشباب الأشرخ",15,"خ",1,0],["لقح الزمان وقد وفت ميعادها","وسخا فكابدت العدى أحقادها",16,"د",3,1]]}