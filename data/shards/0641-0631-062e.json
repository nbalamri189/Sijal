{"poems":[[44,"أتينا الزبير فدانى الكلام","https://www.aldiwan.net/poem50298.html","المتقارب"],[88,"أيا قبر هذا الضيف آمال أمة","https://www.aldiwan.net/poem10493.html","الطويل"],[47,"قلت للائم في الحب أفق","https://www.aldiwan.net/poem65180.html","الرمل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141976","الرجز"],[190,"فرخ الحرف وزقا","https://www.aldiwan.net/poem43563.html","مجزوء الرمل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62620","الرمل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136186","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77863","المنسرح"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199813","المسحوب"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103478","الرجز"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110000","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216422",""],[3995,"","https://poetry.dctabudhabi.ae/diwan/poem/143838","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90814","الخفيف"],[5225,"أسمع صدى صوتك","https://www.poetsgate.com/ViewPoem.aspx?id=18627",""],[5232,"ثورة غزل","https://www.poetsgate.com/ViewPoem.aspx?id=212586",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[5309,"فرخ من الجن بين المجرمين ربي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573553",""]],"verses":[["فَرَخّوا الخِناقَ وَلا تَعجَلوا","فَإِنَّ غَداً لَكُمُ مَوعِدُ",0,"د",1,0],["فَرَخِّص لَنا اليَومَ البُكاءَ وَفي غَدٍ","تَرانا كَما تَهوى جِبالاً رَواسِيا",1,"ي",2,0],["فَرخُ مَجهولاتِ طَيرٍ كُلُّها","قَد رَعى في مَسرَحِ الذَمِّ وَزَق",2,"ق",1,0],["فرخان في وكر تلاقى جانح","وجانح ومنقر ومنقر",3,"ر",1,0],["فرّخَ الحرف وزقا","وتربّى الحرف حقا",4,"ق",2,1],["فرَّخ الأمن عليها زمناً","فاطارتهُ أيادي من سكن",5,"ن",1,0],["فرخ الحمامة ناح في الاسحار","فشجي الوحيد بحسرة التذكار",6,"ر",1,1],["فَرخ المَعاني صب الجنان","روح الزَمان عين العيان",7,"ن",1,1],["فرخ حرّ ٍ مخلبه شرسا","في الجوارح هوب جرناسه",8,"س",2,0],["فَرخاً صغيراً ما أقلَ موفا","زَيَّنَهُ برأيه شَفيقا",9,"ق",2,0],["فرَخّم على غيرِ القياسِ وقُل إِذاً","بِلادٌ بلا دالٍ وشرقٌ بلا قافِ",10,"ف",1,0],["فرخصت من فرط الغلوْ","وخبتُ فيما أحسب",11,"ب",1,0],["فرِّخ وعشِّش في المسر","رة منه وأستأنس وطب",12,"ب",1,0],["فرخ باز في مهده هم أن يص","طاد نسر السماء دون النسور",13,"ر",1,0],["فرخ الحرار امذهّب الرّيش طلماس","أشقر عليه امن النّداره هيوسي",14,"س",2,0],["فرخا حَمَامِ الصَّدرِ مُذ رجفا","زَقتهما نقرا ًحَسَاسِيني",15,"ن",2,0],["فرخ شامٍ صاقرٍ كل الطيور",". الصقور الاوله والتاليات",16,"ت",1,0],["فَرخٌ مِنَ الجِنِّ بَينَ المُجرِمينَ رَبِي","يُثيرُ بِالكذِبِ المَفضوحِ كُلَّ غَبي",17,"ب",2,1]]}