{"poems":[[55,"ما للبياض والشعر","https://www.aldiwan.net/poem30486.html","مجزوء الرجز"],[57,"قالت مرضت فعدتها فتبرمت","https://www.aldiwan.net/poem26418.html","الكامل"],[79,"أبدى لداعي الفوز وجه منيب","https://www.aldiwan.net/poem36767.html","الكامل"],[95,"مر في بالنا فأحيانا","https://www.aldiwan.net/poem11201.html","الخفيف"],[95,"تمضي وأنت مضنة الأوطان","https://www.aldiwan.net/poem11245.html","الكامل"],[32,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[53,"أصل نما بك ربه فرعه","https://www.aldiwan.net/poem65410.html","أحذ الكامل"],[45,"ومنزل ليس لنا بمنزل","https://www.aldiwan.net/poem10111.html","الرجز"],[63,"وفتية تعلو بها أخطارها","https://www.aldiwan.net/poem51622.html","الرجز"],[46,"يا ربع لو ربعوا على ابن هموم","https://www.aldiwan.net/poem30351.html","الكامل"],[104,"بيض الحمائم حسبهنه","https://www.aldiwan.net/poem33133.html","مجزوء الكامل"],[42,"إن امرءا تعتاده ذكر","https://www.aldiwan.net/poem42269.html","أحذ الكامل"],[77,"وهب الدهر نفيسا فاسترد","https://www.aldiwan.net/poem69086.html","الطويل"],[50,"أنعت ديكا من ديوك الهند أحسن","https://www.aldiwan.net/poem63253.html","الرجز"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85751","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[102,"التاريخ السري .. للجدار العتيق","https://www.poetsgate.com/ViewPoem.aspx?id=50343",""],[177,"ومن عجب أني إذا قمت قانتاً","https://www.aldiwan.net/poem4377.html","عموديه"],[228,"تذكرني وحقك ما نسيت","https://www.aldiwan.net/poem39692.html","الوافر"],[310,"بصادق عزم تفخر الدولة الوسطى","https://www.aldiwan.net/poem56490.html","الطويل"],[371,"لا تقبلوا قول الوشاة فإنهم","https://www.aldiwan.net/poem16909.html","الكامل"],[396,"ألا يا ابن العفيف يا","https://www.aldiwan.net/poem54588.html","عموديه"],[396,"يا تاركين الصلاة","https://www.aldiwan.net/poem54601.html","عموديه"],[400,"يقعده في النهوض ردف","https://www.aldiwan.net/poem3663.html","مخلع البسيط"],[412,"نفسي الفِداء لِلحظِها من رامِ","https://www.aldiwan.net/poem50116.html","الكامل"],[445,"كذا تتجلى الشمس بعد كسوفها","https://www.aldiwan.net/poem34867.html","الطويل"],[463,"لعلك بالشعب تعلو اليفاعا","https://www.aldiwan.net/poem56128.html","المتقارب"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/77454","السريع"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123387","الرجز"],[2003,"","https://poetry.dctabudhabi.ae/diwan/poem/136896","الرمل"],[2468,"","https://poetry.dctabudhabi.ae/diwan/poem/117814","الطويل"],[2595,"","https://poetry.dctabudhabi.ae/diwan/poem/31453","الطويل"],[2772,"","https://poetry.dctabudhabi.ae/diwan/poem/199404","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109895","الوافر"],[3662,"","https://poetry.dctabudhabi.ae/diwan/poem/45553","الطويل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81283","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73133","الخفيف"],[4797,"ذالليل كن نجومه شوي واشتات","https://www.poetsgate.com/ViewPoem.aspx?id=132228",""],[402,"تمضي وأنت مضنة الأوطان","https://www.poetsgate.com/ViewPoem.aspx?id=36490",""],[5956,"في عمق وادي الحُسْن","https://www.poetsgate.com/ViewPoem.aspx?id=196805",""],[6023,"يقعد النقع فوقها سحباً كال","https://www.poetsgate.com/ViewPoem.aspx?id=123913",""]],"verses":[["يُقعي بِنَجدٍ وُالحِمى","مِن وَثبَةٍ عَلى غِرَر",0,"ر",1,0],["يَقَعُ البَلاءُ وَيَنقَضي عَن أَهلِهِ","وَبَلاءُ حُبِّكَ كُلَّ يَومٍ زائِدُ",1,"د",1,0],["يَقَعُ الْحَرِيصُ عَلَى الرَّدَى وَلكَمَ غَدَا","تَرْكُ التَّسَبُّبِ أَنْفَعَ التَّسْبِيبِ",2,"ب",1,0],["يَقَعُ الخَطْبُ قَاسِياً فَإذَا","مَا تَوَلَّى مِرَاسَهُ لانَا",3,"ن",2,0],["يَقَعُ اخْتِلاَطُ الرَّأيِ إلاَّ حَيْثُمَا","يَبْدُو سَنَاهُ لِمُقْلَةِ الحيْرَانِ",4,"ن",1,0],["يَقَعنَ بِالسَفحِ مِمّا قَد رَأَينَ بِهِ","وَقعاً يَكاد حَصى المَعزاءِ يَلتَهِبُ",5,"ب",1,0],["يقع الربيع وجود سيدنا","فإليه تصرف دونه النجعه",6,"ع",2,0],["يُقعي جُلوسَ البَدَوِيِّ المُصطَلي","بِأَربَعٍ مَجدولَةٍ لَم تُجدَلِ",7,"ل",1,0],["يَقَعْنَ فيما وَقَعَتْ أبصارُها","حتى إذا الشمسُ خَبا استعارُها",8,"ر",3,0],["يَقَعُ اِنبِساطُ الرِزقِ في لَحَظاتِها","نَسَقاً إِذا وَقَعَت عَلى مَحرومِ",9,"م",1,0],["يقعُ الرَّشاشُ إذا انتفضْ","نَ لآلئاً لرؤوسهنَّه",10,"ن",2,0],["يَقعُدنَ في التَطوافِ آوِنَةً","وَيطُفنَ أَحياناً عَلى فَترِ",11,"ر",1,0],["يقَعُ الطَّلُّ عليَها مِثلما","قطَعَتْ عَذراءُ عِقداً فانسرَد",12,"د",1,0],["يُقعينَ مِنهُ خيفَةً لِلسَفدِ","لَهُ سِقاعٌ كَدَوِيِّ الرَعدِ",13,"د",1,0],["يقع الظلم وَلا","تدرأ الظلمَ يدُ",14,"د",1,0],["يَقَعُ الزَّيْنُ مِنْهُ فِي مَوْقِعِ الزَّيْ","نِ وَيَنْبُو بِالشَّيْنِ نَبْوَ سَدَادِ",15,"د",1,0],["يقعي كجديين ، عادا بلا","نصر يبولان ، دم الانتصار",16,"ر",1,0],["يُقَعقِعُ فِي رجِلي الحَديدُ كأَنَّمَا","يُعارِضُ صَوتِي بالأَذَانِ فَيَلحَنُ",17,"ن",1,0],["يُقَعقِعُ في مَشافِرِها سَميجٌ","وَأَدرَدُ أَشنَعُ الدَعوى هَريتُ",18,"ت",1,0],["يُقعقعُ مِنها نابها لِتحيّةٍ","ويهوي لإجلال بها مخلباً سلطا",19,"ط",2,0],["يَقَعُ العِقابُ لِغَيرِ ذَنبٍ مِنهُمُ","وَلَرُبَّما وَقَعَ العِقابُ جَزاءَ",20,"ا",2,0],["يقع له كل مطلو","ب في الدنيا وفي غد",21,"د",1,0],["يقع لهم كل سول","ولا يرون التراث",22,"ث",1,0],["يقعده في النهوض ردف","قيامتي دونه تقوم",23,"م",1,1],["يَقعونَ من هَذا الزَمان وَأَهله","كَمواقِعِ الأَعيادِ في الأَيّامِ",24,"م",1,0],["يُقَعْقِعُ رَعْدُ النَّصْرِ من جَنَباتِها","ويُومِضُ بَرْقُ الفَتْحِ بَيْنَ صُفُوفِها",25,"ف",3,0],["يقعن بعيداً إذا ما قطعن","بأوعية الشِّعر خَرقاً وقاعا",26,"ع",2,0],["يَقعد للكُتب إِلى وَقت الضُحى","ثُم يصليها كَفعل الصلحا",27,"ح",2,0],["يُقعِده عند القيام رِدفُه","وفي الحَشا منه المُقيمُ المُقعِدُ",28,"د",1,0],["يقع الحق على قرطاسه","أخذا تلعب باللب الرزين",29,"ن",1,0],["يَقَعنَ معاً فيهم بأيدي كُماتِنا","كأنَّ للأسنّةِ مَوعِدُ",30,"د",1,0],["يَقَعنَ مَعاً فيهِم بِأَيدي كُماتِنا","كَأَنَّ المَنونَ لِلأَسِنَّةِ مَوعِدُ",31,"د",1,0],["يُقَعْقِع نَحْوي بالشِّنان وهَلْ تَرى","عُوى الكَلبِ يُخْفي زَأْرَة الأَسَدِ الْوَرْد",32,"د",1,0],["يَقَع وَشكاً بأَيدي عدلِ ربٍّ","فيُسلِمُهُ إلى سيف القَضاءِ",33,"ا",2,0],["يَقَعنَ فَما يُبقينَ إِلّا قُطاعَةً","وَخَيَّبنَ ما أَبقَينَ كُلَّ مُخَيَّبِ",34,"ب",1,0],["يَقع الوَهم دونَ إِغواره السُو","د وَيَقعي فَما يُصيب عَيانه",35,"ن",2,0],["يقعٌ الوهمُ حينَ يَرمي فلم ند","رِ يداهُ أم عينُه النَّبَّالَه",36,"ل",2,0],["يقعد يذكرني ديار ومحلات","ويعيد لي ما فات جمله وتفصيل",37,"ل",1,0],["يقع اختلاط الراي غلا حيثما","يبدو سناه لمقلة الحيران",38,"ن",1,0],["يقع التكبر في النفوس كغيمةٍ","ثلجيةٍ تهمي على مقرورِ",39,"ر",1,1],["يقعد النقع فوقها سحباً كال","ليل فيه السيوف أضحت نجوما",40,"م",2,1]]}