{"poems":[[65,"سرى البرق والليل يدني خطاه","https://www.aldiwan.net/poem46183.html","المتقارب"],[63,"يورقه إذا البرق استنارا","https://www.aldiwan.net/poem51678.html","الوافر"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43706","الرجز"],[371,"لعمري لئن أضحى عن الغيد عاديا","https://www.aldiwan.net/poem17304.html","الطويل"],[470,"يا نائي الدار","https://www.aldiwan.net/poem36226.html","عموديه"],[534,"ولكن إذا جزت الصراط فإنني","https://www.aldiwan.net/poem37464.html","الطويل"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132801","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49549","البسيط"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106894","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48313","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86339","البسيط"]],"verses":[["وأيَّ غُلامٍ سَما نَحْوَهُ","ولَم يَسأَلِ المَجْدَ عنْ مُنْتَماهْ",0,"ا",2,0],["وأيُّ غريبَةٍ للشِّعرِ لاقَتْ","عُلاكَ فحاولَتْ عنها اصطِبارا",1,"ر",2,0],["وَأَيّ غَيثٍ دونَهُ","مِن عبراتي غَمَرَك",2,"ك",1,0],["وَأَيُّ غُرابٍ يَجمَعُ الشَملَ غَيرُها","وَيَرجو الغَريبُ الدارِ مِنها التَدانِيا",3,"ي",2,0],["وأيُّ غائِلَة ٍ غالَتْ مَحارِمَهُ","وما لَدَيهِ على إقصائِها قِبَلُ ؟",4,"ل",1,0],["وأَيُّ غَناءٍ لامْرىءٍ ذي بَلاغَةٍ","وما ذَاكَ يُغْنِي طارِفٌ وتَلِيدُ",5,"د",1,0],["وَأَيُّ غيورٍ لا يجيبُ وقد رأى","مكارمَك اللاتي أَتَينَ خواطِبا",6,"ب",2,0],["وأي غرب مصاب لا يكو كفه","دمعي الهتون ولا أنفاسي الصعدا",7,"د",2,0],["وإيغار صدري بالسعايات بيننا","كما يلقم النيران موقدها وقدا",8,"د",2,0],["وأيُّ غَمامِ الأفْقِ ليسَ يُمِدُّهُ","ندَى يدِكَ العُليا ببَحْرٍ منَ العَطا",9,"ط",2,0],["وَايغدٍ قَد جَنينا وَردَ وُجنَتِهِ","بِاللَحظِ يَومَ اللُقا اِذ جاءَ نادينا",10,"ن",2,0]]}