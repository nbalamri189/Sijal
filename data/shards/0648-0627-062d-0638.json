{"poems":[[65,"خليلي إن الأرض ضاقت برحبها","https://www.aldiwan.net/poem45853.html","الطويل"],[136,"على الله في القصد المعول وحده","https://www.aldiwan.net/poem54857.html","الطويل"],[463,"من العار لولا أن طيفك يطرق","https://www.aldiwan.net/poem56098.html","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63937","المنسرح"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67826","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67822","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112765","الطويل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78187","الوافر"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102059","الوافر"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125429","الرمل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75913","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134023","الخفيف"],[3439,"","https://poetry.dctabudhabi.ae/diwan/poem/130865","الخفيف"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133244","الوافر"],[4927,"كَيْدُ الْعُذَّاْل","https://www.poetsgate.com/ViewPoem.aspx?id=30197",""],[5003,"سقى الله ربعا لم يزل متيمما","https://www.poetsgate.com/ViewPoem.aspx?id=120393",""],[6093,"يَا هَاجِريْ ! عينٌ لبَعْضيَ أنكرتْ ( الكامل)","https://www.poetsgate.com/ViewPoem.aspx?id=176195",""]],"verses":[["وَأَحْظى بِمُلْكٍ مِنْ جُدودِي وَرِثْتُهُ","فَزَنْدِي وَرِيٌّ وَهْوَ في كَفِّ قادِحِ",0,"ح",1,0],["وأحظَى بِإجلاَلِ وحُسنِ ضِيافَةٍ","وَينجُزَ مِن سالفِ الوَعدِ وَعدَهُ",1,"د",2,0],["وأحظى لديَّ من صحيحٍ ببُطئهِ","مَخيطٌ له ريحٌ بنشرك يَفتُقُ",2,"ق",1,0],["واحظ بها من أخص ذي ثقة","بمثل ما خص قبل لم تخصص",3,"ص",1,0],["وَأَحْظى بِمَنْ قَدْ سَادَ عَنْ كُلِّ سَيِّدِ","لَهَ الشَّرَفُ الْعَالي بِفَخْرٍ وَسُودَدِ",4,"د",1,0],["وَأَحْظى بِرَبَّاتِ الْحُلى وَالدَّمَالِجِ","عَشِيَّةَ سَارُوا واسْتَقَلوا بِنُجِبِهمْ",5,"م",1,0],["وأحظى برضةان الإله واكتفي","به إذ هو الكافي وللخير موهب",6,"ب",1,0],["وَأَحظى بِاللُقا بَعدَ البُعادِ","وَأَشهَد نورَهُ مَلأَ البَوادي",7,"ي",1,0],["وأحظى في فناها كل آن","أصيحاب وأحباب العشائر",8,"ر",1,0],["واحظي عهدَ غرامي إنني","يا رجاءَ العينِ أوفى من صَبَر",9,"ر",1,0],["وَأَحظى بِحُسنٍ مِن حَديثكِ إِنَّما","حَديثُكِ أُنسُ القَلبِ وَالسَمعِ وَالبَصَر",10,"ر",1,0],["واحظ بالإقبال الذي قال ارخ","لرياض سعود ارقى نشان",11,"ن",1,0],["واحظ بالمهرجان وابل جديد الد","هر في نعمة بغير زوال",12,"ل",1,0],["وأحظى في حماك بكل عز","وفضل لا يزحزحه افتقار",13,"ر",1,0],["وَأَحْظَىْ بِالْحَبِيْبَةِ بَعْدَ صَبْرٍ","مَرِيْرٍº طَعْمُهُ طَعْمٌ رَهِيْبُ",14,"ب",1,0],["وأحظى بآثار النبي وانثني","إلى عرفات للوقوف متمما",15,"م",2,0],["25. وأحظُّ مِنْ مُثْرٍ تكاثرَ مَالُهُ","رجَلٌ يعلمُ للوَرَى الآياتِ",16,"ت",1,0]]}