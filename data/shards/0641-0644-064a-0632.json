{"poems":[[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[234,"لم يسمع القلب فيه للناهي","https://www.aldiwan.net/poem50734.html","المنسرح"],[310,"برق به أفق الرجاء أنارا","https://www.aldiwan.net/poem56540.html","الكامل"],[443,"إذا بارق من بارق لاح مومضاً","https://www.aldiwan.net/poem2536.html","الطويل"],[447,"ألا من لصب بالحجاز غريب","https://www.aldiwan.net/poem14297.html","الطويل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49912","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93674","الخفيف"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65940","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201711","الخفيف"],[3066,"","https://poetry.dctabudhabi.ae/diwan/poem/104398","الخفيف"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68003","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86445","الطويل"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45940","الطويل"],[5387,"مطاردة","https://www.poetsgate.com/ViewPoem.aspx?id=53768",""],[6102,"اغضبي","https://www.poetsgate.com/ViewPoem.aspx?id=182847",""]],"verses":[["فَليَزدَدِ الرُّكنُ تِيهاً حَيثُ نالَ بِهِ","فَخراً أَقامَ لَهُ الدُّنيا عَلَى قَدَمِ",0,"م",1,0],["فليُزْهَ وليَسْتَطِل عليَّ فما","أعشَق إلاّ الظَّلومَ والزّاهي",1,"ي",1,0],["فليزوِ هذا الدهرُ عنّي صرفه","فَلَكم سُقيتُ بِه المرار مرارا",2,"ر",2,0],["فلى زفرات أعربت إن في الحشا","لهيبا غدا من دونه لهب الغضا",3,"ض",2,0],["فلي زفرات حطمت أصل أضلعي","ولي عبرات عندمت بهدوبي",4,"ب",2,0],["فل يزل وأمره معمّى","حتى إذا انتهى إليه سما",5,"م",2,0],["فليزدْدِ الأزدُ تمجيداً بسعيهم","فإنَّما سعيُهم مجدٌ وعلياءُ",6,"ا",2,0],["فَليزرني وَلَو خَيالك لَولا","أَرق يَمنَع الخَيال الطَروقا",7,"ق",2,0],["فليزدد الحساد غيظاً أنني","ما حالة لم تخش من حالاتي",8,"ت",2,0],["فليزيدوا جموعهم عَلّ عيني","إن رأتهم رأت كثيف هباء",9,"ا",2,0],["فليزرفي العراق قبر أخي القا","سم وليحسن الثناء عليه",10,"ي",2,0],["فلِي زَفَراتٌ بالفؤادِ أُطيلها","وأنَّةُ مهمومٍ حنيني يَزيدها",11,"د",3,0],["فلي زفرة وجه النهار وزفرة","أسامر فيها الليل دون سميري",12,"ي",1,1],["فَلي زَوجَةٌ غابَت عَلَيَّ وَلَم أَكُن","حَياتَها أَدري أَم أَحاطَ بِها البَلا",13,"ل",2,0],["فلي زوج وأطفال وبيتٌ","ستهدمه الشكوك بسوء ظني",14,"ن",2,0],["فَلْيَزِدْ كُلُّ حَاقِدٍ - لَيتَ شِعرِي -","وَ لْيَقُولُوا ؛ مِنْ قَولِهمْ لِستُ أَعجَبْ",15,"ب",1,0]]}