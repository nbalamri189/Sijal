{"poems":[[95,"أرن سهم الردى إرنان منتحب","https://www.aldiwan.net/poem9788.html","عموديه"],[48,"ما لي رأيتك معرضا","https://www.aldiwan.net/poem22991.html","مجزوء الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43870","الوافر"],[440,"تأذى بلحظي من أحب وقال لي","https://www.aldiwan.net/poem25694.html","الطويل"],[1350,"","https://poetry.dctabudhabi.ae/diwan/poem/202214","الوافر"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101049","البسيط"],[2671,"","https://poetry.dctabudhabi.ae/diwan/poem/79772","الوافر"],[463,"بكرتْ هيماً تحلُّ الرَّبطا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60115&r=&rc=171",""]],"verses":[["تَأذَّنَتْ بِانْقِرَاضٍ بَعْدَ مَنْعَتِهَا","وَنُفِّرَتْ عَنْ حِيَاضِ العِلمِ وَالأَدَبِ",0,"ب",1,0],["تَأَذّى الأُصولُ الثابِتا","تُ فَيُحسَدُ الغُصنُ القَصيفُ",1,"ف",1,0],["تَأَذَّتْ فيهما بفَمِي فقالتْ","شمائلُ عاشِقٍ وفعال جافِ",2,"ف",1,0],["تأَذَّى بِلَحْظي مَنْ أُحِبُّ وَقالَ لي","أَخافُ منَ الْجُلاَّسِ أَنْ يَفْطِنوا بِنا",3,"ن",2,1],["تأذى بي الأقارب بعد أنس","كأني فيهم فرخ شجير",4,"ر",1,0],["تأذن اللَه أن تغشى كتائبه","منازل الشرك في نجد وفي تهم",5,"م",1,0],["تأَذَّى بي الأقاربُ إذ رأوْني","بَقيِتُ وأين مني اليومَ موتي",6,"ت",2,0],["تأذخذُ الأبصارُ مني شارة ًُ","تدعْ الشَّيخَ فتى ً مستشرطا",7,"ط",2,0]]}