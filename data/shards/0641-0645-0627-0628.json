ق وتقسو بالغوير قلوب","https://www.aldiwan.net/poem56279.html","الطويل"],[456,"أجدك بعد أن ضم الكثيب","https://www.aldiwan.net/poem56288.html","الوافر"],[459,"طوت ما طوت في سهل أرض ووعرها","https://www.aldiwan.net/poem15314.html","الطويل"],[459,"زمان كله هجر","https://www.aldiwan.net/poem16093.html","الهزج"],[459,"يا آل جعفر الفياض جودكم","https://www.aldiwan.net/poem16418.html","البسيط"],[461,"أكسف من سماء ساقط أم","https://www.aldiwan.net/poem927.html",""],[462,"أرى الغيث في الآفاق خرقاء كفه","https://www.aldiwan.net/poem3347.html","عموديه"],[462,"صبر قلبي عان ودمعي طليق","https://www.aldiwan.net/poem3398.html","عموديه"],[466,"قم نصطبح صهباء يسعى بها","https://www.aldiwan.net/poem59618.html","السريع"],[468,"فما بيضة بات الظليم يحفها","https://www.aldiwan.net/poem4775.html","الطويل"],[475,"يذكرني ثناياهنلما","https://www.aldiwan.net/poem15199.html","الوافر"],[475,"هو الوجد ما بالي أنؤ بحمله","https://www.aldiwan.net/poem15255.html","الطويل"],[475,"أشد الهوى ما يمنع العين أن تكرى","https://www.aldiwan.net/poem15349.html","الطويل"],[514,"أهاج البكا ربع باسفل ذي السدر","https://www.aldiwan.net/poem48671.html","الطويل"],[527,"إلهي كن يا إلهي معيني","https://www.aldiwan.net/poem37112.html","المتقارب"],[538,"إني امرؤ من رعى عيني رعيت له","https://www.aldiwan.net/poem56645.html","الوافر"],[538,"ألم تر أن القول يخلص صدقه","https://www.aldiwan.net/poem56712.html","الطويل"],[549,"أمن أجل أن أعفاك دهرك تطمع","https://www.aldiwan.net/poem47720.html","الطويل"],[549,"ألا هل لما فات من مطلب","https://www.aldiwan.net/poem48061.html","المتقارب"],[549,"على مثل هذا اليوم تحنى الرواجب","https://www.aldiwan.net/poem48099.html","الطويل"],[551,"استمطر العين أن أحبابه احتملوا","https://www.aldiwan.net/poem68393.html","البسيط"],[551,"أديري على الراح ساقية الخمر","https://www.aldiwan.net/poem68421.html","الطويل"],[551,"طلائع شيب سير أسرعها رسل","https://www.aldiwan.net/poem68424.html","الطويل"],[565,"شدت فجلت أسماعنا بمخفف","https://www.aldiwan.net/poem69770.html","الطويل"],[565,"ومنزل قينة سهل الجناب","https://www.aldiwan.net/poem69805.html","الوافر"],[573,"نحافة الغصن غيظ من تثنيكا","https://www.aldiwan.net/poem3044.html","البسيط"],[573,"نسيم ربعك أفديه بأنفاسي","https://www.aldiwan.net/poem3057.html","البسيط"],[577,"خليلي طب على الأيام حالا","https://www.aldiwan.net/poem28337.html","الوافر"],[584,"تداركه قبل البين فاليوم عهده","https://www.aldiwan.net/poem17487.html","الطويل"]],"verses":[["فَما بَكَتِ الحَمامُ عَليكَ إِلّا","كَما غَنَّتكَ أَصواتُ الحَمامِ",0,"م",1,0],["فَما بالُ بَغدادٍ إِذا اِشتَقتُ رِحلَةً","تَشَبَّثَ بي غيطانُها وَفِجاجُها",1,"ج",3,0],["فَما بَرِحَت حَلبَةُ السابِقا","تِ تورِدُنا عَفَواتِ المَدى",2,"ا",1,0],["فَما بِهوىً بَينَ الضُّلوعِ أُجِنُّهُ","لِغَيرِ هُذَيمٍ صاحِبي أَو لَهُ عِلمُ",3,"م",1,0],["فَما بِهِ ماءٌ روىً","وَلا مَرادٌ مُمرِعُ",4,"ع",1,0],["فَما بالُها تَرمي إِلَيَّ بِنَظرَةٍ","تُغازِلُها البَغضاءُ وَهيَ تُريبُ",5,"ب",1,0],["فما بِكُما دونَ الذي بي منَ الهَوى","ولكن أبَى أن يَجْزَعَ الأسَدُ الوَرْدُ",6,"د",1,0],["فما بالُنا نُجْفَى ومنكَ تعلَّمَتْ","صُروف اللّيالي أن يَدومَ لها عَهْدُ",6,"د",1,0],["فما بالُ زَوْراءِ العِراقِ مُنيخَةً","بمُعْتَرَكٍ تَدْمى لديهِ الكَلاكِلُ",7,"ل",1,0],["فَما بالُ لاحِيهِ يَلومُ على الندىً","بِفيهِ إذا ما تابَعَ العَذْلَ كِثْكِثُ",8,"ث",1,0],["فَما بالُ عَيني إِذا ما رَأَت","كَ لَم يَملُكِ الدَمعُ أَن يَنسَجِم",9,"م",1,0],["فَما بَكَيتُ لِيَومٍ مِنكِ أَسخَطَني","إِلا بَكَيتُ عَلَيهِ بَعدَما ذَهَبا",10,"ب",2,0],["فَما بَرِحَ الواشونَ حَتّى بَدَت لَهُم","بُطونُ الهَوى مَقلوبَةً لِظُهورِ",11,"ر",1,0],["فَما بِالمَشرِقَينِ لَهُ نَظيرٌ","وَلا بِالمَغرِبَينِ وَلا بِكوفَه",12,"ف",2,0],["فَما بَرِحوا حَتّى اِستُحِثَّت نِساؤُهُم","وَأَجرَوا عَلَيها بِالسِهامِ فَذَلَّتِ",13,"ت",1,0],["فَما بَرَزَت لِفَضاءِ الجَهادِ","فَتَترُكَهُ بَعدَ إِشرادِها",14,"د",3,0],["فَما بالُ قَومِيَ لا يَأخُذونَ","لِتِلكَ الجِنانِ طَريقاً سَوا",15,"ا",1,0],["فَما بَلَغَت مِنهُ الحَضارَةُ مَأرَباً","وَلا نالَ مِنهُ العِلمُ ما كانَ يَزعُمُ",16,"م",1,0],["فَما بَلَغوا سُؤلاً وَلا بَلَغوا مُنىً","كَذَلِكَ يَشقى الخائِنُ المُتَقَلِّبُ",17,"ب",1,0],["فَما بَسَطت كَفُّ الخَضيبِ بِنانَها","عَلى الأَرضِ إِلّا وَهيَ مَوشِيَّةُ الأُزرِ",18,"ر",1,0],["فَما بَرِحَت سُمرُ الرِماحِ تَنوشُهُم","بِأَطرافِها حَتّى اِستَجاروا بِنا مِنّا",19,"ن",2,0],["فَما بَرِحَت مَجالَ الشِربِ حَتّى","تَغالوها وَقالوا قَد رَوينا",20,"ن",2,0],["فَما بَينَ شَرقِ الأَرضِ وَالغَربِ كُلِّها","مُنادٍ يُنادي مِن فَصيحٍ وَأَعجَمِ",21,"م",1,0],["فَما بِرِباعِ الدارِ أَن كُنتُ عالِماً","وَلا بِمَحَلِّ الغانِياتِ أَهيمُ",22,"م",1,0],["فَما بَلَغَت كَفُّ اِمرِئٍ مُتَناوِلٍ","مِنَ المَجدِ إِلّا حَيثُ ما نِلتَ أَطوَلُ",23,"ل",1,0],["فَمَا بَلَغَتْ شِغَافَ القَلْبِ إِلاَّ","وَقَدْ فَاضَتْ مِنَ الحُزْنِ العُيُونُ",24,"ن",1,0],["فَما بَلَغَتني الكَأسُ إِلّا شَرِبتُها","وَإِلّا سَقَيتُ الأَرضَ كَأساً مِنَ الدَمعِ",25,"ع",1,0],["فَما بَكَيتُ عَلَيهِ حينَ فارَقَني","وَلا وَجَدتُ لَهُ بَينَ الحَشا مَضَضا",26,"ض",2,0],["فَما بَلَّغَتكَ العيسُ حَيثُ تَقَرَّبَت","مِنَ البُعدِ إِلا جَهدُها وَجَريضُها",27,"ض",3,0],["فما بال قوم غدوا يصرخو","ن صراخاً به يقصدون الشغب",28,"ب",1,0],["فما بين مكذوب عليه وكاذب","وما بين مجحودٍ عليه وجاحد",29,"د",1,0],["فما باله يُمسي ويُصبح شاكياً","ولا يتحاشى عن ظُلامته الخلق",30,"ق",1,0],["فما بالكم لا تُحسنون وواجب","على الابن للام الكريمة أحسان",31,"ن",1,0],["فما بال هذا عُدَّ في مصر مارقاً","وما بال هذا عدّ في مصر كافرا",32,"ر",2,0],["فما بال هذا العقل أمسى معطَّلاً","لدينا كأن الله أوجده سُدى",33,"د",2,0],["فما بلغ المقاصد غيرُ ساع","يردّد في غدٍ نظراً سديدا",34,"د",2,0],["فَما بَلَغَ الفَرَزدَقُ في تَميمٍ","تَخَيُّرِيَ المَضارِبَ وَاِنتِخابي",35,"ب",2,0],["فَما بالَيتِ لَيلَتَنا بِنَجدٍ","وَدَمعُ العَينِ يَنحَدِرُ اِنسِكابا",36,"ب",2,0],["فَما بَرِحَ الوَجدُ الَّذي قَد تَلَبَّسَت","بِهِ النَفسُ حَتّى كادَ لِلشَوقِ يَذبَحُ",37,"ح",1,0],["فَما بُقياً عَلَيَّ تَرَكتُماني","وَلَكِن خِفتُما صَرَدَ النِبالِ",38,"ل",1,1],["فَما بَدَّلوا حَتّى تَوافَوا جَماعَةً","وَلا يَقطَعُ الآجالَ إِلّا المَصارِعُ",39,"ع",1,0],["فَما بَرَحوا بِنَقضِ العَهدِ حَتّى","غَزاهُم في دِيارِهِمِ الرَسولُ",40,"ل",1,0],["فما بال رأسي كلما ضاء شيبه","تجدّد في ذكرِ الحبيب ضلالي",41,"ي",1,0],["فما برحتْ عين العِبْرَيْن حتَّى","رُددْنَ إلى الأُبُلَّة من قريبِ",42,"ب",1,0],["فما بالها نفرُ الأغرَّاء نفرُها","وقد أُنذِرت من قبلُ بالمَثُلاتِ",43,"ت",1,0],["فما بالي أُقَوِّمُ متْنَ شعري","إذا يَمَّمْتُ بابك لامْتِيَاحِ",44,"ح",1,0],["فما بال أيديكم على الناس ثَرَّةٌ","سواي فإني من نوالكُمُ مُكْدي",45,"ي",1,0],["فما بعد رأيك من مُنيَةٍ","وما بعد عتبك من لائع",46,"ع",1,0],["فما بردت للاغبين ظلالها","ولا عذبت للسائغين نبوعها",47,"ع",3,0],["فما برحتْ تُهدي إلينا عجائبٌ","عجائبَ تُصبي كلَّ صابٍ وناسك",48,"ك",1,0],["فمَا بالُ الجفاء جفاءُ سالٍ","وما بالُ اللقاء لقاءُ قالي",49,"ي",1,0],["فَما بَرِحَت في الناسِ حَتّى تَبَيَّنَت","ثَقيفاً بِزَيزاءِ الأَشاةِ قِبابُها",50,"ب",3,0],["فَما بِهِ غَيرُ موشِيٍّ أُكارِعُهُ","إِذا أَحَسَّ بِشَخصٍ نابِئٍ مَثَلا",51,"ل",2,0],["فَما بَلَّغَتها الجُردُ حَتّى تَحَسَّرَت","وَلا العيسُ حَتّى اِنضَمَّ مِنها ثَميلُها",52,"ل",3,0],["فَما بالُكُم لَم تُكرِموا اللَيلَ وَالضُحى","وَلَم تَنصُبوا التِمثالَ لِلشَمسِ وَالقَمَر",53,"ر",1,0],["فَما بِكَ مِن ضُرٍّ لِنَفسِكَ وَحدَها","وَضِحكُكَ وَالإِناسُ لِلجارِ وَالخِدنِ",54,"ن",1,0],["فَما بَلَغتُ مَغاني مَن شُغِفتُ بِها","إِلّا وَقَد بَلَغَت نَفسي تَراقيها",55,"ي",3,0],["فَما بالُ دَواعيكَ","إِلى الخَيراتِ لا تَجنَح",56,"ح",1,0],["فَما بَرِحا حَتّى أَجَنّا فُروجَها","وَضَمّا مِنَ العيدانِ رُطباً وَذارِيا",57,"ي",2,0],["فَما بَرِحَت سَجواءَ حَتّى كَأَنَّما","تُغادِرُ بِالزيزاءِ بُرساً مُقَطَّعا",58,"ع",2,1],["فما بكاهُ فَتَاهُ","ولا بكتْهُ فتاتُهْ",59,"ه",1,0],["فَما بَرِحَ الواشونَ حَتّى بَدَت لَنا","بُطونُ الهَوى مَقلوبَةً بِظُهورِ",60,"ر",1,0],["فما بان لي إلا شجاً متكاثف","ولا لاح لي إلا دجى متراكب",61,"ب",1,0],["فما بها مشاغب","ولا بها غوائل",62,"ل",1,0],["فَما بِالعِيِّ في الدُنيا التَحَلّي","وَلا خَرَسُ الفَتى فَضلاً عَظيما",63,"م",2,0],["فَما بالُهُ صارَ في الهامِدينَ","وَأَمسى عَفاءً كَأَن لَم يَكُن",64,"ن",1,0],["فَما بَرَحَت مِن خاطِري مِصرُ ساعَةً","وَلا أَنتِ في ذي الدارِ زايَلتِ لي هَمّا",65,"م",2,0],["فَما بالُها نَكِرَتها 