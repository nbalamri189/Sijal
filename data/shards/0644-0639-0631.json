{"poems":[[95,"هدايا الناس من زهر الجنان","https://www.aldiwan.net/poem11187.html","الوافر"],[32,"خليلي عوجا اليوم حتى تسلما","https://www.aldiwan.net/poem29528.html","الطويل"],[32,"أللربع ظلت عينك الماء تهمل","https://www.aldiwan.net/poem29546.html","الطويل"],[53,"دع الأجمال مرتحله","https://www.aldiwan.net/poem65935.html","مجزوء الوافر"],[31,"لخولة بالدومي رسم كأنه","https://www.aldiwan.net/poem6210.html","الطويل"],[42,"ألا أيها الربع الذي خف أهله","https://www.aldiwan.net/poem42340.html","الطويل"],[193,"لعرب النقا أكرم بهم عربا أهوى","https://www.aldiwan.net/poem35148.html","الطويل"],[203,"ألا عاطني الخمر إن الزمان","https://www.aldiwan.net/poem45361.html","المتقارب"],[242,"أقول لمن يصيخ إلى اصطراخي","https://www.aldiwan.net/poem18130.html","الوافر"],[353,"وكانت لك الدنيا فعشت سعيدا","https://www.aldiwan.net/poem20072.html","الطويل"],[463,"أجاذبها لو أمكنت من زِمامها","https://www.aldiwan.net/poem55889.html","الطويل"],[592,"تذكرت والذكرى تهيج البواكيا","https://www.aldiwan.net/poem11512.html","عموديه"],[657,"","https://poetry.dctabudhabi.ae/diwan/poem/200323","الكامل"],[710,"","https://poetry.dctabudhabi.ae/diwan/poem/104427","الطويل"],[828,"","https://poetry.dctabudhabi.ae/diwan/poem/124038","الطويل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128711","المتدارك"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108756","الكامل"],[1775,"","https://poetry.dctabudhabi.ae/diwan/poem/124605","الطويل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66285","الكامل"],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/198878","الطويل"],[1955,"","https://poetry.dctabudhabi.ae/diwan/poem/45426","الطويل"],[2121,"","https://poetry.dctabudhabi.ae/diwan/poem/143009","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94195","الكامل"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79725","الرمل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102389","الطويل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69907","البسيط"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127095","الطويل"],[4205,"","https://poetry.dctabudhabi.ae/diwan/poem/22079","الكامل"],[4502,"","https://poetry.dctabudhabi.ae/diwan/poem/75853","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139586",""],[5121,"عِرَاقُ الْإِبَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=209030",""],[6068,"سؤال وجواب (الغرام)؟ -05-","https://www.poetsgate.com/ViewPoem.aspx?id=175914",""],[6160,"أَجنِحَةُ الضَّوء ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87084&r=&rc=1",""],[6319,"الجنوب الصعب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86563&r=&rc=5",""]],"verses":[["لِعُرْسِ فَتَاتِكَ المَشْهُورِ يَوْمٌ","غَدَا بِرُوائِهِ عُرْسَ الزَّمَانِ",0,"ن",1,0],["لِعِرفانِها وَالعَهدُ ناءٍ وَقَد بَدا","لِذي نُهيَةٍ أَن لا إِلى أُمِّ سالِمِ",1,"م",1,0],["لِعِرفانِ أَطلالٍ كَأَنَّ رُسومَها","بِوَهبينَ وَشيٌ أَو رِداءٌ مُسَلسَلُ",2,"ل",1,0],["لعرضِ الجار صائنةٌ","لعرضِ المالِ مُبتذِلَهْ",3,"ل",2,0],["لِعِرفانِ آياتٍ وَمَلعَبَةٍ لَنا","لَيالِيَنا إِذ أَنا لِلجَهلِ صاحِبُ",4,"ب",1,0],["لِعِرّانَ سارُوا أَم لِحَربٍ تَيَمَّمُوا","لَكَ الوَيلُ أَم حَلُّوُا بِقَرنِ المَنازِلِ",5,"ل",1,0],["لِعربِ النقا أكرِم بهم عَرباً أهوى","وَما مُنيتي ميٌّ ولا أرَبي أروى",6,"و",2,1],["لعرشِ السماءِ ارتقتْ أمُها","وفي الأرضِ أعراشُ آبائها",7,"ا",3,0],["لَعُرْقًوبٌ يَجِيءُ الشَّرُّ يَوْماً","لِمُخَّتِهِ فَيُمْرَى بِامْتِخَاخِ",8,"خ",1,0],["لِعِرضِكَ تَعْلُو رَايَةٌ يَمَنِيَّةٌ","تُنِيرُ وُجُوهاً لِلحَوَادِثِ سُودا",9,"د",2,0],["لِعرضِك منها نَثرةٌ سابغيَّةٌ","وأعراضُ قومٍ عُرضةٌ لسهامِها",10,"م",3,0],["لعرمي لأن كانت أصيبت قلوبنا","وأوجعها فقدان تلك المعاليا",11,"ي",2,0],["لعرفت من أي فارس بهمة","قرط وقومك في العجاج الأصهب",12,"ب",1,0],["لعرفاتها قصدي فسارت مجدة","بقطع الفيافي كالسهام إذا سرت",13,"ت",1,0],["لعرفان رسم بالعجيماء ماثل","نزحت دموع العين إذ نزح الصبر",14,"ر",1,0],["لعروض جفاك بحور هوى","بدوائر هجرك تضطرب",15,"ب",1,0],["لعرفت كيف أقول إلّا أنني","رجلٌ جبلت على الوفا المتتابع",16,"ع",1,0],["لعرفان رسم أو توهم دمنة","كستها البلى أيدي الليالي الغوابر",17,"ر",1,0],["لعريش أحمد مثل لطفٍ سابغٍ","كعريش أحمد ذلك المتقدمِ",18,"م",1,1],["لعرشي تقدم وادن واقرب إلى العلا","وسلني فإني بالعطاء كفيل",19,"ل",1,0],["لَعَرمُكَ ما اِستَخلَفتُ بَكراً لِيَشغَبوا","عَلَيَّ وَما في حِلفَكُم مِن مُعَلَّقِ",20,"ق",1,0],["لعرفت أشجاني تعذِّبني","وأنا أداري في الحشا السهما",21,"م",2,0],["لعروس كنز قد بدت","تزهو بمنثور الدرر",22,"ر",1,0],["لعرفت الدهر كم يشقى النسم","وسكبت الدمع ممزوجاً بدم",23,"م",1,0],["لعِرفانِكَ الرَّبْعَ الذي صدعَ العصا","بهِ البَين صَدعاً ليسَ بالمُتلائمِ",24,"م",1,0],["لعرسِ الفونس ده كوبا يُؤَرّخهُ","جاهٌ كَبرجٍ يَضمُّ الشَمسَ وَالقَمرا",25,"ر",2,0],["لعرس صباح المجد من في نسيمه","لكل الورى بحر السماح تموجا",26,"ج",2,0],["لَعَرفتُ مَغناها بِما احتَمَلَت","مِنّي الضُلوعُ لِأَهلِها قَبلُ",27,"ل",1,0],["لعَرفِتنا من خَيرِ أَهلِ نَدىً","بعد الهُدوءِّ لطارقٍ يَسري",28,"ر",2,0],["لعرش فضلٍ به شمسا علاً بهما","زال الدجى وتجلّى الرشد واتضحا",29,"ح",2,0],["لِعِرَاقِ الإِبَاءِ حَرْفِي اسْتَصَحَّا","بِشُعُورٍ مُجَاهِدٍ نَزَّ سَرْحَا",30,"ح",2,1],["لعرفتِ أنّي مغرم","في سابق أو لاحقِ",31,"ق",1,0],["لِعُروجِ ذَاكِرَةٍ حَضَنْتُ سَمَاءَهَا","مَدَّت أَصابِعَهَا لِغَيرِ سَمَائِي ...",32,"ا",3,0],["لعرْسٍ يا بيارق أم لزحفٍ","يُبيحُ حمى سهيلَ ويستبيحُ",33,"ح",1,0]]}