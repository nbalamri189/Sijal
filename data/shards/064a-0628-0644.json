,[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66128","الخفيف"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77695","الكامل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35103","الطويل"],[4680,"على نَغَمات الريح","https://www.poetsgate.com/ViewPoem.aspx?id=190640",""],[4692,"تنأين مني","https://www.poetsgate.com/ViewPoem.aspx?id=200246",""],[4883,"شارع شعول","https://www.poetsgate.com/ViewPoem.aspx?id=48365",""],[4929,"مليكة اللغات","https://www.poetsgate.com/ViewPoem.aspx?id=201110",""],[4940,"سطوة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=205547",""],[4119,"أيا عاذلي في الحب مالي وللعذل","https://www.poetsgate.com/ViewPoem.aspx?id=16210",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5183,"نداء الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=180192",""],[5376,"طار الفؤاد كأنَّ الطير ساكنه","https://www.poetsgate.com/ViewPoem.aspx?id=188319",""],[5376,"بي لوعة العشاق تهمي خافقي","https://www.poetsgate.com/ViewPoem.aspx?id=188476",""],[5431,"مجنون ذئبة ...","https://www.poetsgate.com/ViewPoem.aspx?id=207159",""],[5431,"رسالة عروبية","https://www.poetsgate.com/ViewPoem.aspx?id=210257",""],[5434,"بالسلك يندار","https://www.poetsgate.com/ViewPoem.aspx?id=37624",""],[5444,"حيث لهيب الجمر","https://www.poetsgate.com/ViewPoem.aspx?id=205073",""],[5444,"عصامي العلا","https://www.poetsgate.com/ViewPoem.aspx?id=205517",""],[5582,"أَنَوارُ هَلْ مِنْ زَوْرَةٍ أَنَوارُ","https://www.poetsgate.com/ViewPoem.aspx?id=63507",""],[5717,"فالقول بالعدل أساس يبتنى","https://www.poetsgate.com/ViewPoem.aspx?id=170603",""],[5736,"يبلل الدمع وجهي","https://www.poetsgate.com/ViewPoem.aspx?id=208225",""],[5751,"بيت الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=214721",""],[5781,"فاتِحةُ الجمالِ وأولُ جرحٍ ...أنت","https://www.poetsgate.com/ViewPoem.aspx?id=208986",""],[5953,"بإسماعيل تهتم يا رعاء","https://www.poetsgate.com/ViewPoem.aspx?id=93799",""],[6152,"سراييفو حلم متجدد","https://www.poetsgate.com/ViewPoem.aspx?id=203271",""],[6257,"المجازي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87187&r=&rc=12",""]],"verses":[["يَبُلُّ دَريسَيْهِ الندىً وتَلُفُّهُ","على الكُورِ منْ هُوجِ الرّياحِ بَليلُها",0,"ل",3,0],["يبلغها شاكر الجميل كما","تبلغنا في جنابه النّعم",1,"م",1,0],["يَبلعُ ما يَبْلعُ حُوتُ يُونُسا","لو انتحاهُ سَهْمُ أعْمى قَرطسا",2,"س",2,0],["يبلع الفيل والبعي","ر وفيه تلهُّف",3,"ف",1,0],["يَبلُغُ الشُكْرُ والثناءُ بك الغا","يةَ لا ينتهي إليها عتاقُك",4,"ك",1,0],["يبلعُ الحوتُ بعضه كلَّ يوم","ليْتَه يبلعُ المسكينَ جُمْله",5,"ه",1,0],["يبلو بها اللَّهُ قوماً كيْ يبينَ لهُ","ذو الطاعةِ البر ممَّنْ فيهِ عِصيان",6,"ن",1,0],["يبلى الميكن الفخم ن آثارها","يوما وآثار الخيل قيام",7,"م",1,0],["يُبَلِّغُني الفَتحَ بنِ خاقانَ إِنَّهُ","نِهايَةُ آمالي وَغايَةُ مَطلَبي",8,"ب",2,0],["يُبَلِّغُنا عَنها بِغَيرِ كَلامِها","إِلَينا مِنَ القَصرِ البَنانُ المُطَرَّفُ",9,"ف",1,0],["يَبلى الشَبابُ وَيُفني الشَيبُ نَضرَتَهُ","كَما تَساقَطُ عَن عيدانِها الوَرَقُ",10,"ق",1,0],["يَبلى الجَديدُ وَأَنتَ في تَجديدِهِ","وَجَميعُ ما جَدَّدتَ مِنهُ فَبالِ",11,"ل",1,0],["يَبلى لِكُلِّ مُسَلعَنٍ سُلطانُهُ","وَاللَهُ لا يَبلى لَهُ سُلطانُ",12,"ن",1,0],["يُبلي الزَمانُ حَديثاً بَعدَ بَهجَتِهِ","وَالدَهرُ يَقطَعُ ما بَينَ القَريبَينِ",13,"ن",1,0],["يَبلى مَعَ المَيتِ ذِكرُ الذاكِرينَ لَهُ","مَن غابَ غَيبَةَ مَن لا يُرتَجى نُسِيا",14,"ي",2,0],["يبلّ صَدى الأرْماق في القيظِ رَكبُهُ","بمُلْتَقَطٍ يثْني القَطَا عن جمامِهِ",15,"م",2,0],["يَبُلَّ أَعالي الثَوبِ قَطرٌ وَتَحتَهُ","شُعاعٌ بَدا يُعشي العُيونَ وَيُشرِقُ",16,"ق",1,0],["يَبلغُ الحقُّ مُبتغاهُ وتزدا","دُ قُواهُ تَمادِياً واطِّرادا",17,"د",2,0],["يَبُلُّ بِمَعصورٍ جَناحَي ضَئيلَةٍ","أَفاويقَ مِنها هَلَّةٌ وَنُقوعُ",18,"ع",1,0],["يَبلوغُ ما تَبلُغُهُ الريحُ وَلا","تَبلوغُ ما يَبلُغُهُ إِذا طَلَب",19,"ب",1,0],["يَبلى المَكينُ الفَخمُ مِن آثارِها","يَوماً وَآثارُ الخَليلِ قِيامُ",20,"م",1,0],["يَبْلَغُ الْمَرْءُ بِالصَّلاَةِ وَبِالتَّوبَةِ","أَسْنَى مَرَاتِبَ الأَبْرَارِ",21,"ر",1,0],["يَبْلُغُ القَصْدَ بِالمُحَاوَلَةِ المُثْلَى","وَمِنْ دُونِهِ صِعَابٌ تَحُولُ",22,"ل",1,0],["يَبْلُغُ الأَمْرَ بِالتَّقَاصُرِ لاَ يَبْ","لُغُهُ غَيْرُهُ بِطُولِ النِّجَادِ",23,"د",1,0],["يَبلُغُ مِن بَرِّهِ وَرَأفَتِهِ","حُملانِ أَضيافِهِ عَلى حُرَمِه",24,"ه",1,0],["يُبلُّ على التداوي كلُّ جُرْحٍ","وجُرْحُ القلبِ دامٍ لا يُبِلّ",25,"ل",1,0],["يبلى الزمان ولا تبلى محامدكم","ما دام يحمد مطعام ومطعان",26,"ن",1,0],["يُبلى الزَمان وَذِكرَهُ مُتَجدِدٌ","إِن الزَمان بِفَضلِهِ مَشجونُ",27,"ن",1,0],["يبلى من الحسن عشق العاشقيه ولا","يبلى جمال فتىً بالشعر يزدان",28,"ن",1,0],["يبلّغهُ النسيم إلى","حليفِ الفضلِ والمجدِ",29,"د",1,0],["يبلغ المرء ما يروم ولكن","بعد تحريكه يكون السكونُ",30,"ن",1,0],["يبلُغنَ كلَّ العُنفِ في لَطَفٍ","ويَنلنَ أقصى الجِدِّ بالهزلِ",31,"ل",1,0],["يبلي الزمان وأهله","ومحبتي أبداً جديده",32,"د",2,0],["يَبلَى الزَّمانُ وَأَشواقي مُجَدَّدَةٌ","تَجولُ مِنِّي مَجالَ السَّمعِ وَالبَصَرِ",33,"ر",1,0],["يبلى الفتى في صميم الأرض مدفنهُ","والكتب مدفنها باقٍ على الحقب",34,"ب",1,0],["يُبلِّغُنا عن زَهْرِها وافدُ الصَّبا","سَلاما تَولَّى المسكُ رَدَّ جوابهِ",35,"ب",2,0],["يبلى شبابي في الهوى وعذابُه","متجدِّدٌ من هجرك المتجدِّدِ",36,"د",1,0],["يُبلي الدُهورَ جَديدُها وَتَكُرُّ عا","ئِدَةً عَلَيكَ بِمِثلِها أَعوامُها",37,"م",3,0],["يَبُلُّ فيهِ غَليلَ صَدري","شَرابُكَ المُسكِرُ العَتيقُ",38,"ق",1,0],["يبلغني المولى الأمير محمداً","وحسبي مُني منهن ما كنت اسأل",39,"ل",1,0],["يبلى بكرّ الجديدين القشيب كما","ينهَدُّ ما كان مرصوصا بتأسيس",40,"س",1,0],["يَبُلُّ بِالسَلحِ ساقَيهِ وَذَلِكَ مِن","عاداتِهِ وَهوَ تَحتي يَلثُمُ التُرُبا",41,"ب",2,0],["يبلبل بالي لا لنوح حمامة","وينهل دمعي لا لإيماض برقة",42,"ه",1,0],["يُبلي الجَديدَ وَيَعتَقي أَيدَ الفَتى","لَيلٌ يَكُرُّ عَلَيهِمُ وَصَباحُ",43,"ح",1,0],["يَبُلُّ مِنها الذِفرى وَدَنَّسَها","مِن قُنفُذِ اللِيتِ حالِكٌ نَتِحُ",44,"ح",1,0],["يَبلى الشَبابُ وَيَنفي الشَيبُ بَهجَتَهُ","وَالدَهرُ ذو العَوصِ يَأتي بِالأَعاجيبِ",45,"ب",1,0],["يُبَلُّ كَنَعلِ السِبتِ طوراً وَتارَةً","يَكُفُّ الشَذا مِنها خَرِيعٌ وَأَفرَقُ",46,"ق",1,0],["يبلغ الهزل مسمعيه فيمضى","عن دواعي الهوى مضي الشهاب",47,"ب",1,0],["يُبلي هَوى الصُوَرِ الحِسانِ بَلاها","وَهَوى المَعاني خالِدٌ بِبَقاها",48,"ه",2,1],["يَبُلُّ البُكا خَدِّي وفي القلبِ غُلّتي","وكم مُطِرَتْ أرضٌ شَكتْ غيرُها المَحْلا",49,"ل",2,0],["يَبُلُّ البُكا خَدّي وفي القلبِ غُلَّتي","وكم سُقِيتْ أَرضٌ وفي غَيرِها القَحْط",50,"ط",1,0],["يبلبل فيها النهر حتى كأنه","يترجم أصوات البلابل إذ تملى",51,"ل",2,0],["يُبلي الزّمانُ هَوَى القلوبِ وحبُّهُم","لا يَضمَحِلُّ ولا يَرِثُّ جَديدُهُ",52,"د",2,0],["يبلُّ غليل الشَّوق من ذي صبابة","يذكّره المنسيَّ في الحبّ ذاكر",53,"ر",1,0],["يبلّ غليلي منجب وابن منجب","فيا ليت شعري هل أراني بموكب",54,"ب",1,0],["يُبلي جَوَانِحَها بنفسِ مخاطِرٍ","ويُنيمُ أَعيُنَها بعَيْنِ مُسَهَّدِ",55,"د",1,0],["يَبلَى بلايَ ولو إليه لسانُه","لشكا اشتكايَ وأنَّ مثلَ أنيني",56,"ن",2,0],["يبلّغُ من بعدِ السلام رسالةً","عساه على أخطارهَا بيَ يَسلَمُ",57,"م",1,0],["يبلُغنَ لا ضَيِّقَ الخِناق من ال","عَيِّ ولا مسنداً من السأمِ",58,"م",1,0],["يُبْلِغُني إِمرةَ الأمير وإن","جار وحُكمَ المولَى وإن ظَلَما",59,"م",2,0],["يُبْلِغُ عني حَمَلتْ ناجية","ما ضمّ في عِيابه وحملا",60,"ل",2,0],["يبلغ اقصى منك معتذراً","والعذر ممَّن سواه تنويل",61,"ل",1,0],["يَبُلُّ الأُوامَ بحبسِ المطيَّ","لعلّي أراها ويَروى الغليلا",62,"ل",2,0],["يَبلى الحبيبُ وحُزنُهُ يَتَجدَّدُ","فكأنَّهُ في كُلِّ يومٍ يُفقَدُ",63,"د",1,1],["يُبَلِّغُ مَن يشاءُ فَكَم غريبٍ","يُرجِّي خطوةً قُصوَى خَطاها",64,"ا",3,0],["يُبَلِّجُ مِن أَنوارِها كُلَّ ساطِعٍ","وَقَد يُنكِرُ الأَنوارَ مِن رِزقِ العَمى",65,"م",2,0],["يبلى الجديدان اللذان تعاقبا","لَبِلى الجديد وحسرتي تتجددُ",66,"د",1,0],["يُبلبِلُها إلى الصُّبح إشتياقٌ","ويَجذبُها انقياد",67,"د",1,0],["يُبلّغُ حاضرُكم غائباً","وأُشهِدُ رَبّي السميعَ البَصيرا",68,"ر",2,0],["يبلغن المهدي عني شكوى","قلَّ في أَنَّها تضيق الصدورا",69,"ر",2,0],["يبلوهمُ بفراقه حتى إذا","جزعوا عليه أراحهم بلقاء",70,"ا",2,0],["يَبُلُّ بِهَا الصَّادِي وَيَرْوى بِهَا رِيَّا","إلَى حُجْرَةِ الْهَادِي قَطَعْنَا مَسَافَةً",71,"ه",1,0],["يُبَلْبِلُنِي نَوْحُ الْحَمَامِ عَلىَ اللَّوى","سُحَيْراً فَيَزْدَادُ التَّحَرُّقُ وَالْجَوى",72,"ج",3,0],["يبلُغُها المجهود سوق عناية","لها سبقت من ربها أزلية",73,"ي",2,0],["يبلي الزمان ولا تبلى مآثرها","فهي البواقي الجديدات العديدات",74,"ت",1,0],["يبلى الزمان ولا تبلى مآثرها","لأنها برزت في معهد قدما",75,"م",2,0],["يبلى الزمان قديمهُ وجديدهُ","وَهوايَ فيها طائلٌ متجدّدُ",76,"د",1,0],["يبلبلُ منّي العقلَ صدغٌ مبلبلٌ","ويملكُ منّي القلبَ أغيدُ أسمرُ",77,"ر",1,1],["يَبلغ بِالأَعداءِ","في الخطب وَاللأواء",78,"ا",2,0],["يبلع الطيبات بلعاً بلا مض","غ ويحسو النبيذ كالثعبان",79,"ن",1,0],["يبلو العباد فمن أطا","ع حظى بولدان وحور",80,"ر",1,0],["يَبلى وَتُفنيهِ الدُهورُ كَما","يَبلى وَيَنضو الجِدَّةَ الخَلَقُ",81,"ق",1,0],["يبلون قَلبي إِذا بانوا بغيرهم","كيما أقر بأن القَلب مَشغول",82,"ل",1,0],["يبلغ بالجسر على طبعه","ما يسحر المختال ذا الكبر",83,"ر",1,0],["يَبلِى الزَّمَانُ وَخَلْقُهَا مُتَجَدّدٌ","يَروِي الغَبِيُّ حَدِيثَهَا وَالأشْدَق",84,"ق",1,0],["يَبلى الزَمانُ وَلا يَزالُ حَدِيثُها","حَتّى تَزُولَ الراسِياتُ جَديدا",85,"د",2,0],["يَبلُغِ الجَهدُ ذا الحَصاةِ مِنَ القَو","مِ وِمَن يُلفَ واهِياً فَهوَ مودي",86,"د",2,0],["يبلبل قلب السامعين كأنما","بأشطره ناح الحمام المطوق",87,"ق",1,0],["يُبلي الجَديدَ الجَدي","دانِ ثُمَّ ما يَبلَيانِ",88,"ن",1,0],["يَبل الطل مِنهُ رِياض خَد","فَتثمر للمقبل جلنارا",89,"ر",2,0],["يبلغ القصد من بكم لاذ يوماً","وإليه يشير طرف البنان",90,"ن",1,0],["يبلبلُ شعرهُ عقلي إذا ما","تبلبل حول صدغيه جنانى",91,"ن",2,0],["يُبَلِّغُهُنَّ الحاجَ كُلُّ مُكاتَبٍ","طَويلِ العَصا أَو مُقعَدٌ مُتَزَحِّفُ",92,"ف",1,0],["يبلغكم أَقصى الأَماني وان علت","فَإِنَّ لمسعاكم لَدى القَلب موقع",93,"ع",1,0],["يَبلى بِلى البُردِ يَوماً بَعدَ قُوَّتِهِ","وَهنٌ وَبَعدَ ثَناءٍ خُطوهِ رَمَلُ",94,"ل",1,0],["يُبلَّغُ ممَّن ذابَ شوقاً وحُرقةً","لمن ليسَ يُحصِي فضلَهُ الحدُّ والعدُّ",95,"د",1,0],["يُبلّغ بَعضَ ما يَحوي ضَميري","وَنطقُ الصامتات من العجاب",96,"ب",1,0],["يَبلُغنَ أُمَّ قاسِمٍ وَقاسِما","خَوداً كأَنَّ البوصَ والمآكِما",97,"م",2,0],["يبلّغ أمير المؤمنين رسالةً","تنحّلها مملٍ وآخرُ يكتب",98,"ب",1,0],["يبل بمائها شفتيه ظم","آناً على ظمإ",99,"م",2,0],["يبلغها إلى دارِ 