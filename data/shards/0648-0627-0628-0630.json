{"poems":[[55,"مقيم من الهم لا يقلع","https://www.aldiwan.net/poem29974.html","المتقارب"],[88,"نبئاني إن كنتما تعلمان","https://www.aldiwan.net/poem10953.html","الخفيف"],[90,"لا يبلغ المرء منتهى أربه","https://www.aldiwan.net/poem45001.html","المنسرح"],[4,"أنبئت أن أبا حنيف","https://www.aldiwan.net/poem21209.html","مجزوء الكامل"],[49,"أفر من السوء لا أفعله","https://www.aldiwan.net/poem25201.html","المتقارب"],[23,"بطيبة رسم للرسول ومعهد","https://www.aldiwan.net/poem21547.html","الطويل"],[53,"تتجافى جنوبهم","https://www.aldiwan.net/poem65083.html","مجزوء الخفيف"],[53,"ما القلب في إثرهم بمختطف","https://www.aldiwan.net/poem65441.html","المنسرح"],[53,"يا من جلا دهرنا دجاه به","https://www.aldiwan.net/poem65808.html","المنسرح"],[53,"يا من سكون النفس في تأميله","https://www.aldiwan.net/poem66004.html","الكامل"],[53,"وأشهد ما يكون عل هجاء","https://www.aldiwan.net/poem66727.html","الوافر"],[64,"لا تتهم من شق فاك فإنه","https://www.aldiwan.net/poem52471.html","الكامل"],[33,"وما ظبية من ظباء الأراك","https://www.aldiwan.net/poem42611.html","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55093","الكامل"],[53,"أشهدُ ما يكونُ على هجاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=30749",""],[53,"ما القلبُ في إثْرِهم بمختطَفِ","https://www.poetsgate.com/ViewPoem.aspx?id=29597",""],[4,"أُنْبئْتُ أنَّ أبَا حَنِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10958&r=&rc=53",""],[119,"حي المنازل اذ ترى شيخونا","https://www.aldiwan.net/poem40473.html","عموديه"],[132,"شمر الذيل وبادر للعمل","https://www.aldiwan.net/poem50540.html","الرمل"],[136,"صبغت بدمع عاشقك الخدودا","https://www.aldiwan.net/poem54860.html","الوافر"],[151,"أقاسي الحب من قاسي الفؤاد","https://www.aldiwan.net/poem47683.html","الوافر"],[151,"تساءلني أم البنين وإنها","https://www.aldiwan.net/poem47690.html","الطويل"],[173,"خلياني من وطاء ووساد","https://www.aldiwan.net/poem1619.html",""],[228,"حين أقبلت والهوى فيك يحبو","https://www.aldiwan.net/poem39723.html","الخفيف"],[234,"الآن قد الفؤاد نصفين","https://www.aldiwan.net/poem50780.html","المنسرح"],[242,"أبناء فاس من يفارقهم","https://www.aldiwan.net/poem19524.html","السريع"],[246,"أودى بي الحزن واغتال الجوى جلدي","https://www.aldiwan.net/poem45759.html","البسيط"],[358,"رتب العز والتقى","https://www.aldiwan.net/poem40027.html","مجزوء الخفيف"],[409,"وافى نظامك وهو خير نظام","https://www.aldiwan.net/poem33424.html","الكامل"],[409,"فاروعني يا صفي الدين ما","https://www.aldiwan.net/poem33983.html","الرمل"],[411,"الناس أشكال فمن يك راشدا","https://www.aldiwan.net/poem49663.html","الكامل"],[519,"عج بالعقيق وناد أسد سراته","https://www.aldiwan.net/poem20807.html","الكامل"],[520,"لك أن تقول إذا أردت وتفعلا","https://www.aldiwan.net/poem12207.html","الكامل"],[564,"قد كساني لباس سقم وذله","https://www.aldiwan.net/poem69349.html","الخفيف"],[592,"ألا أيها الغادي مجداً بنجداً","https://www.aldiwan.net/poem11509.html","عموديه"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62552","الرمل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62532","الرمل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62474","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62563","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120053","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59420","الطويل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/90463","الخفيف"],[1112,"","https://poetry.dctabudhabi.ae/diwan/poem/122389","البسيط"],[1181,"","https://poetry.dctabudhabi.ae/diwan/poem/204061","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136101","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112757","الرمل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112890","الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46508","الرجز"],[1806,"","https://poetry.dctabudhabi.ae/diwan/poem/198375","الوافر"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76793","البسيط"],[2082,"","https://poetry.dctabudhabi.ae/diwan/poem/22576","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53082","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109768","الطويل"],[2404,"","https://poetry.dctabudhabi.ae/diwan/poem/32591","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93515","الوافر"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137390",""],[2888,"","https://poetry.dctabudhabi.ae/diwan/poem/46729","الكامل"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118829","الخفيف"],[3344,"","https://poetry.dctabudhabi.ae/diwan/poem/146495","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/63010","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48340","الطويل"],[3582,"","https://poetry.dctabudhabi.ae/diwan/poem/45268","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205604","البسيط"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132158","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118005","البسيط"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85007","الكامل"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202343","البسيط"],[3832,"","https://poetry.dctabudhabi.ae/diwan/poem/202306","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59500","الوافر"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59463","الوافر"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114310","الرمل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77036","الرمل"],[4030,"","https://poetry.dctabudhabi.ae/diwan/poem/20885","الكامل"],[4767,"استجارة","https://www.poetsgate.com/ViewPoem.aspx?id=184946",""],[4973,"حكم","https://www.poetsgate.com/ViewPoem.aspx?id=188674",""],[5050,"خل عن ذكرى حبيب واللوى","https://www.poetsgate.com/ViewPoem.aspx?id=38200",""],[5092,"سؤال","https://www.poetsgate.com/ViewPoem.aspx?id=190569",""],[3591,"أتسكن باريس على ذلك المحل","https://www.poetsgate.com/ViewPoem.aspx?id=149470",""],[5183,"بين الهيمنة والهينمة","https://www.poetsgate.com/ViewPoem.aspx?id=180155",""],[5277,"نبتة الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=185021",""],[5302,"سأمضي","https://www.poetsgate.com/ViewPoem.aspx?id=200676",""],[592,"أهاجك أزماة تسامى بها الخلف","https://www.poetsgate.com/ViewPoem.aspx?id=128857",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5587,"هيا نتسامح","https://www.poetsgate.com/ViewPoem.aspx?id=194341",""],[5701,"راقب وحاسب وأدب فالنساء وإن","https://www.poetsgate.com/ViewPoem.aspx?id=164663",""],[5873,"السعادة المسبية","https://www.poetsgate.com/ViewPoem.aspx?id=215416",""],[5906,"أجراس الحكمة","https://www.poetsgate.com/ViewPoem.aspx?id=188073",""],[6125,"هَجَرتُ النَّاسَ واستَوطَنتُ دَارَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=210724",""],[6177,"شرايين التراب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79077&r=&rc=20",""],[6257,"رحيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87183&r=&rc=8",""]],"verses":[["وَأَبذُلُ قَلباً بِأَمثالِهِ","تَضَنُّ الجَوانِحُ وَالأَضلُعُ",0,"ع",1,0],["وَأَبٍ ذاهِلٍ إِلى النارِ يَمشي","مُستَميتاً تَمتَدُّ مِنهُ اليَدانِ",1,"ن",1,0],["وأبذُل له ما ملكت من نَشَب","فالعلم أبقى للمرء من نشبه",2,"ب",2,0],["وَاِبذُل سَنامَ القِدرِ إِن","نَ سَوائَها دُهماً وَجونا",3,"ن",2,0],["وَأَبذُلُ عَدلِيَ لِلأَضعَفينَ","وَلِلشامِخِ الأَنفِ لا أَبذُلُه",4,"ل",2,0],["وَأَبذَلَ مِنهُ لِلطَريفِ وَتالِدِ","إِذا ضَنَّ مِعطاءُ بِما كانَ يُتلَدُ",5,"د",1,0],["وابذلوا لي نفوسكم","إنها في ودائعي",6,"ع",2,0],["وأبذل البلغة الكفاف من ال","قوت إذا المستضيف لم يضف",7,"ف",1,0],["وابذلْ ليَ العفو والتجاوزَ وال","إغضاءَ حتى يُقالَ ما اتَّركا",8,"ك",2,0],["وابذلْ لعبدِك ما تيسَّر إنه","في حالةٍ تقذى جفونَ خليلِهِ",9,"ل",2,0],["وأبذأُ ما تُصادِفُ مِنْ هجاء","إذا ولّيتَ عفوكَ قائليه",10,"ي",2,0],["وابذُلْ فانّ المالَ شَعْرٌ كلَّما","أوسعتَهُ حلْقاً يزيدُ نباتا",11,"ت",2,0],["وَأَبذِلُ مالي لِمَرضاتِكُم","وَأُعتِبُ مَن جاءَني عاتِبا",12,"ب",2,0],["وَابْذُلْ حَيَاتَكَ فِي فِدَا","هُ وَلاَ تَضَن بِمُقْتَنَاكْ",13,"ك",1,0],["وأبذأُ ما تُصادِفُ مِنْ هجاء","إذا ولّيتَ عفوكَ قاتليه",14,"ي",2,0],["وأبذل البلغة َ الكفاف من ال","قوت إذا ما المستضيف لم يُضف",15,"ف",1,0],["وابْذُلْ سَنَامَ القِدْرِ إ","نَّ سواءَها دُْماً وجُونا",16,"ن",2,0],["وابذل بمتكين الدموع فكم لها","لصميم وجد قد بكى الباكونا",17,"ن",2,0],["وابذل المعروفَ وفرّقه علَى","كلِّ ذى فقرٍ ومَنْ عَنْكَ سَأَلْ",18,"ل",1,0],["وأبذَلَها وأرجَحَها وَقَاراً","وأَجرَاهَا على الصَافِينَ جُودَا",19,"د",2,0],["وأبذل مهجتي في لثم فيها","فتمنعني وأرجع منه صاد",20,"د",1,0],["وأبذل يوم الروع نفسا كريمة","على أنها في السلم أغلى من الغالي",21,"ل",2,0],["وَاِبذُلا في العِزِّ مَجهودَكُما","لا يُلامُ المَرءُ بَعدَ الاِجتِهادِ",22,"د",1,0],["وَأَبذُلُ مِن قَلبي وَلا أَبتَغي جَدوى","وَقَد كُنتُ أَهوى فيكِ حُسناً أَنا لَهُ",23,"ه",1,0],["وأبذلُ النُّصحَ غيرَ متَّهَمٍ","دون النَّصوحَيْن والمحِبَّين",24,"ن",1,0],["وَأَبْذُلَ النُّصْحَ لِكُلِّ فَتىً","غِرّاً نَبَتْ عَنْهُ حَقَائِقُهُمْ",25,"م",1,0],["وأَبذُلَنَّ مَصُونَ الدمع مُطَّرِداً","وَجداً عليكَ وحُزناً فيكَ لم يَبِدِ",26,"د",1,0],["وَاِبذل الفَضل لا تَكُن","مِن تَلاشيهِ مُشفِقا",27,"ق",2,0],["وابذل لهم نصحاً حبوتك أصله","يا فرع أحمد يا بن خير إمام",28,"م",1,0],["وابذل العلم ولا تبخل به","ما الثنا والأجر إلا للسميح",29,"ح",1,0],["وابذُلْ لوِدِّكَ صَفْوَ وُدِّكَ وانحَرِفْ","عن كُلِّ مَنْ ينحازُ عنكَ وَينَزوي",30,"و",2,0],["واِبذُلْ به نقدَ الدموعِ عساهُمُ","أن يُطلِقوها رشوةً لقُضاتِهِ",31,"ت",2,0],["وابذل لمن أصفاك محض ولائه","بشراً تحسن عنده حسن الولا",32,"ل",2,0],["وابْذُل الرُّوحَ فهْي فينَا قليلٌ","راضيَا لا تقل دمي مَنْ احَلَّهْ",33,"ل",2,0],["وأبذلهم للجود طبعاً وعادةً","واكمل أوصاف الفتى ما تعودا",34,"د",2,0],["وابذل الفانيَ في الباقي ولا","تجعل العسجد ذخراً واللجينْ",35,"ن",1,0],["وابذلوا الفانيَ بالباقي فما","يطلب الأشرفَ إلاَّ النُّجَبا",36,"ب",2,0],["وأبذل نفسي للنسيم لأنَّه","يمرّ بأرض مرَّ فيها غُلامُها",37,"م",3,0],["وابذل النفس للنسيم الذي هبَّ","فقد مسّكتُه ريح الغواني",38,"ن",2,0],["وأبذلهم لدرهمه","وامنعهم عراس حمى",39,"م",2,0],["وأبذل روحي للمبشر باللقا","وأهون بروحي أن تكون له بشرى",40,"ر",2,0],["وَابذُلي الصافِيَ المُطهَّر منهُ","لهُداةِ السَرائِرِ المُرشِدينا",41,"ن",2,0],["وابذل قواك وبادر في أوامرهِ","إلى الوفاقِ وبالغ في مراضيه",42,"ي",2,0],["وابذلْ لهم كتب الأمان ليسرعوا","متزاحمين على ورود الباب",43,"ب",1,0],["وابذل عزيز كان حاولت نيل عزي","ز المجد واجهد وجد بالروح والنشب",44,"ب",1,0],["وابذرن في أرض قلبي","بالرضا والفضل حبا",45,"ب",2,0],["وابذر بقلبك جنة الاشواق واسق","جميعها بتأرق وتلهف",46,"ف",1,0],["وَأَبذل لَهُ نَفائس الأَموال","تَدفع بِها شَدائد الأَهوال",47,"ل",1,0],["وأبذل في الحوادث صلب مالي","لجاري والمحالف إن دعيت",48,"ت",1,1],["وابذلوا النفسَ في صيانةِ عرضٍ","كي يُوارى عن العيونِ البغاءُ",49,"ا",2,0],["وَابذُل دُموعَكَ واعذُل كُلَّ مُصطَبِرٍ","وَالحَق بِمَن سارَ وَالحَظ ما عَلى العَلَمِ",50,"م",1,0],["وَأَبذُلُ في الهَيجاءِ وَجهي وَإِنَّني","لَهُ في سِوى الهَيجاءِ غَيرُ بَذولِ",51,"ل",1,0],["وابذخ بمجد أبٍ بنى لك رتبةً","جازت محل الفرقدين صعودا",52,"د",2,0],["وابذل روحي في هواه ويغضبُ","وكم دهمتني كربة البين والنوى",53,"ن",3,0],["وأبْذُلُ معروفي وتصفو خليقتي","إذا كُدِّرَتْ أخلاقُ كلّ فتىً محْض",54,"ض",1,0],["وَأَبذلهم وَأَمنعهم جِواراً","وَأَوصَلَهُم وَأَفصلهم قَضاءا",55,"ا",3,0],["وابذلك قصارى اجتهاد أنت حائزه","في نيله واجتنا أشهى مجانيه",56,"ي",2,0],["وَاِبذُل لِمُلتَمِسِ القِرى أَزكى القِرى","وَتَلَقَّ مَقدَمَهُ بِوَجهٍ مَسفِرِ",57,"ر",1,0],["وابذل الروح فهو فينا قليلٌ","راضياً لا تقل دمي من أحلَّه",58,"ل",2,0],["وأبذلُ جُهدي في مُدارِاةِ قَلبه","ولولا الهوَى يقتادُني لم أُدارِه",59,"ر",2,0],["وابذرُ التبرَ في صفراءَ صافيةٍ","كأَنَّ في الكأسِ ما قد كانَ في الكيسِ",60,"س",1,0],["وأبْذُلُ ما تهْوَى النفوسُ تكرُّما","فمالِي أنادي الظبْيَ واللحْظُ قد رَمى",61,"ا",1,0],["وَأَبذُلُ نَفسي في مَواطِنَ غَيرِها","أَحَقُّ وَأَعصي في هَواكَ الأَدانِيا",62,"ي",2,0],["وابذل زهيدك للصناعة تجتمع","لبني بلادك ثروة لم تزهدِ",63,"د",1,0],["وابذل فما انتقل النضا","ر مع الجسوم إلى الحفر",64,"ر",1,0],["وابذل قواك وبادر في أوامره","بالامتثال وسر في سير أهليه",65,"ي",2,0],["وَاِبذُل غَريرَ الدَمعِ في أَرجائِهِ","حَتّى تَسيرَ السُفُنُ في غُدرانِهِ",66,"ن",2,0],["وأبذل ا