id=184906",""],[5115,"هل إلي وصل عزة من سبيل","https://www.poetsgate.com/ViewPoem.aspx?id=189289",""],[5121,"رعشة","https://www.poetsgate.com/ViewPoem.aspx?id=33585",""],[5189,"متى الريادة أيها العرب","https://www.poetsgate.com/ViewPoem.aspx?id=201758",""],[5376,"ساموا بقومي بالقنا التعذيبا","https://www.poetsgate.com/ViewPoem.aspx?id=196894",""],[5411,"هذا نَصيبك منْ شِعْري","https://www.poetsgate.com/ViewPoem.aspx?id=185429",""],[3294,"يا راكب الجسرة للجسر","https://www.poetsgate.com/ViewPoem.aspx?id=173269",""],[5493,"يا دواءً جئتُه","https://www.poetsgate.com/ViewPoem.aspx?id=196963",""],[5574,"غمامة أغدقت فوق الربى","https://www.poetsgate.com/ViewPoem.aspx?id=205991",""],[2110,"قل لي بحقك أيهذا الساقي","https://www.poetsgate.com/ViewPoem.aspx?id=156283",""],[5691,"تحجر العُرْبُ","https://www.poetsgate.com/ViewPoem.aspx?id=206096",""],[5691,"بشائر النور","https://www.poetsgate.com/ViewPoem.aspx?id=206731",""],[5910,"حيِّ الطلولَ ونبِّ عن أخبارِها","https://www.poetsgate.com/ViewPoem.aspx?id=206239",""],[5956,"أبواشٌ وشارونيّون","https://www.poetsgate.com/ViewPoem.aspx?id=192363",""]],"verses":[["قَد أَصحَرَ الضَيغَمُ مِن غيلِهِ","أُظفورُهُ مِنكِ عَلى مَطمَعِ",0,"ع",1,0],["قَد أَصبَحَ الرِزقُ ما لَهُ سَبَبٌ","في الناسِ إِلّا البِغاءُ وَالكَذِبُ",1,"ب",1,1],["قَد أَصبَحَت أُمُّ البَنِينِ مَرِيضَةً","نَخشَى ونُشفِقُ أَن يَكُونَ حِمَامَا",2,"م",2,0],["قد أصبحت بك أحفاضي مسدمَّة","زهراً بلا دَبَرٍ فيها ولا نَقَبِ",3,"ب",1,1],["قَد أَصبَحَ القَلبُ عَنها كادَ يَصرِفُهُ","عَنها تَتَرُّعُ قَولٍ غَيَّرَ الشَعَرا",4,"ر",2,1],["قد أصاخُوا وأنت تَيْعَرُ كالتي","سِ وهم ضامِزون مثلُ الشاءِ",5,"ا",2,0],["قَد أَصبَحوا وَقفاً عَلى شَهَواتِهِم","يستَسلِمونَ لَها وَلا تَستَسلِمُ",6,"م",1,0],["قَد أَصبَحَ الماءُ يَحميهِ وَيَمنَعُهُ","الوَيلُ لِلماءِ مِنّا إِنَّهُ جانِ",7,"ن",1,0],["قَد أَصونُ الحَديثَ دونَ أَخٍ","لا أَخافُ الأَذاةَ مِن قِبَلِه",8,"ل",2,0],["قد اصبح الصيداح من فلج به","في روضة الآداب غير مغرد",9,"د",1,0],["قَد أَصبَحوا في بَرزَخٍ","وَمَحَلَّةٍ مُتَراخِيَه",10,"ي",2,0],["قد أصبحا الأصل مما يشبهان فقل","هما كذلك حقا لا كأنهما",11,"م",2,0],["قَد أَصبَحَ الإِسلامُ في سُلطانِها","وَالهِندُ بَعضُ ثُغورِها وَالصينُ",12,"ن",1,0],["قدْ أصبحتْ في الحسنِ سلطانةً","تفرِّقُ التبرَ على الحاشيَهْ",13,"ه",1,0],["قَد أَصابَ القَلبَ مِن نُعمِ","سُقمُ داءٍ لَيسَ كَالسُقمِ",14,"م",1,1],["قَد أَصبَحَ المُلكُ بِالمُنى ظَفِرا","كَأَنَّما كانَ عاشِقاً قَدِرا",15,"ر",2,1],["قَد أَصَبنا مِنهُ فَنَستَغفِرُ اللا","هَ كَثيراً وَقَد يُصابُ الجَليسُ",16,"س",1,0],["قَد أَصبَحَت وَنُعاتُها نُعّاتُها","وَكَذَلِكَ الدُنيا تَخيبُ سُعاتُها",17,"ت",3,1],["قَد أَصبَحَ الدينُ مُضمَحِلّاً","وَغَيَّرَت آيَهُ الدُهورُ",18,"ر",1,0],["قَد أَصابَت يد المَنيَّة رأَساً","عقد المجد فوقه إكليلا",19,"ل",2,0],["قَد أَصبحَ الوطن المحبوب تربته","ألعوبةً في يد الأحداث والنوب",20,"ب",1,0],["قد أصبح القاعُ بها صفصفا","فما عليها من حياةٍ أثرْ",21,"ر",1,0],["قَدِ اصطَلَى نارَهُ حِيناً ويُضرِمُها","إذا خَبَا ضَوءُها الهِنديَّ والغارا",22,"ر",2,0],["قَدْ أَصْبَحُوا للدَّهْرِ سُبَّةَ ناقِمٍ","فِي كُلِّ مَصْدَرِ مِحْنَةٍ وَبَلاءِ",23,"ا",2,0],["قَدْ أَصَابَت قُلُوبَنَا","بِالسِّهامِ الْخَواطِئْ",24,"ط",2,0],["قد أصْبَحَتْ مَنْهلاً يَسْعَى لِطالِبِه","فاعجبْ إِلى مَنْهلٍ يَسْعَى لِظَمْآن",25,"ن",1,0],["قد أصبح الجوعان ، يا روحه","شبعان ، تزدان له المائده",26,"د",2,0],["قد أصبحوا ولهم عليه دخالة","يالَلظليمةِ من قضاء قاسي",27,"س",2,0],["قد أصاخوا وأنت تيعر كالتَّي س","وهم ضامرون مثل الشاء",28,"ا",2,0],["قَدْ أَصَابَ القَلْبَ مِنْ نُعْمِ","سُقْمُ داءٍ، لَيْسَ كَکلسُّقْم",29,"م",1,1],["قَد أَصبَحَت بِكَ دُنيانا عَلى ظَمأً","مِن الأَكارم في رَيٍّ مِن النِعَم",30,"م",1,0],["قد أصليت نارها العداةُ","وأنجزت فيهم العداتُ",31,"ت",1,1],["قَد أَصَمَّ الخُطوبَ مِن حَيثُ نادى","مَلِكٌ بِالنَدى يُجيبُ النَداءَ",32,"ا",2,0],["قَد أَصبَحَ اِسمُكَ عَن قِراعِكَ نائِباً","وَكَفى العَدُوَّ مُرَوِّعاً أَن تُذكَرا",33,"ر",2,0],["قَد أَصبَحَت صَفَحاتُ المُلكِ مُشرِقَةً","وَصافَحَتكَ بِتَسليمٍ يَدُ الدُوَلِ",34,"ل",1,0],["قد اصفَرَّ لوني في هواها ولم تَزَلْ","دموعي لذكراها زَرَتْ بالمَخَايلِ",35,"ل",1,0],["قد اصفَرَّ لَوْني من هَواءٍ دَفَنْتُهُ","وقد عَمِيَتْ عَيني وأعْيَتْ أساتُها",36,"ت",3,0],["قد أَصبَحَت ظُلُماتُ الجهلِ حالِكةً","لمّا تَغيَّبَ عن آفاقِنا القَمَر",37,"ر",1,0],["قد أصبحوا كما ترى","ما بين نومٍ وخرا",38,"ر",2,1],["قد أصاب المرمى وأثخن جرحاً","قلب صبٍّ وما لذي الوجد ترسُ",39,"س",1,0],["قد اصطفى بين كل الناسِ أمته","كما غدا المصطفى بين النبيينا",40,"ن",2,0],["قَد أَصبَحَت لِلصاحِبِ الدُّنيا وَما","فيها وَما شَيءٌ يُخافُ حِرانُهُ",41,"ن",2,0],["قَد أَصبَحَ الصاحِبُ أَولى الناس بال","مَدحِ بِنَثرٍ مُطرِبٍ وَنَظمِ",42,"م",1,0],["قَد أَصحَبَت لِلصاحِبِ بنِ عَلِيّ ال","دُنيا فَلَو جَمَحَت عَفَتها الزَلزَلَه",43,"ل",2,0],["قَد أَصبَحَ اِبنُ عَلِيٍّ راقِياً رُتَباً","حُسّادُهُنَّ عَلى البَأوِ السَماواتُ",44,"ت",1,0],["قد أصبنا وبلينا يا لها","قصة عمت ببلواها الهوا",45,"و",2,0],["قَدْ أَصَمَّ النَّاعِي بِكَ اليومَ حَتَّى","رَجَباً فاسْمُهُ الأَصَمُّ مُناسِبْ",46,"ب",1,0],["قَدْ أَصلَحَ الجُوعُ بَينَ القِطِّ وَالفَارِ","عِندِي لإدبارِي حَظّي أَيَّ إِدْبارٍ",47,"ر",1,1],["قَد أَصبَحَت قَوسُ الزَمانِ سَهما","وَقُد رَمى الأَرضَ بِهِ فَأَصمى",48,"م",2,0],["قد أصبحَ اليومَ خُوزِسْتانُ جِيدَ عُلاً","بِعِقْدِ أَيّامهِ أَضحَى يُحَلّيه",49,"ي",2,0],["قد أصبحتْ سُوقُ الزّما","نِ وما بها للشِّعرِ سِعر",50,"ر",1,0],["قد أصبح ابنَ الفضل فهْو يبرُّه","برَّ البنين لما جِدِ الآباء",51,"ا",2,0],["قَد أَصَبنا العَيشَ عَيشاً ناعِماً","وَأَصَبنا العَيشَ عَيشاً رَنقا",52,"ق",2,0],["قد أصبح الحبل من أسماء مصروما","بعد ائتلافٍ وحب كان مكتوما",53,"م",2,1],["قد أصبحَ الدين نهباً بين زعنفةٍ","لا يرقبونَ إلهَ النَّاسِ في النّاسِ",54,"س",1,1],["قد أصبتم يا سيدي بالجواب","ورميتم واللّه عين الصواب",55,"ب",1,1],["قد أصبحت أيدين لما جئتها","دار السرور واخصبت أقطارها",56,"ا",1,0],["قد أصبحت أوقاتنا","بسناء عدلك زاهيه",57,"ي",2,0],["قد أصبح الفضل فيه ينجلي طربا","والمجد يثني عليه عالي الهمم",58,"م",1,0],["قد أصبحتْ في جفنِها","كالصارمِ المهنّدِ",59,"د",1,0],["قد أصبح الملك فذا في دعارته","ورمزه بين إجرام وفحشاء",60,"ا",2,0],["قد اصطلح الرجالُ على التجافِي","وقد نُسيَ التعاطُفُ والتحَاني",61,"ن",2,0],["قد أصلح الناسَ سعيُكم لهمُ","وأفسد الناسَ لطفُكم بهِمِ",62,"م",1,0],["قَد أَصبَحَت ساحاتُ أَخلاقِهِ","آهِلَةً بِالتيهِ وَالكِبرِ",63,"ر",1,0],["قَد أُصِبنَا وَقَد أُصِيبَ لَنَا اليَو","مَ رِجَالٌ بُزلٌ حُمَاةٌ صُقُورُ",64,"ر",1,0],["قد أصاب الثريُّ منها اللّبوبَ","وانْتهى إلينا النّوى والقشورُ",65,"ر",1,0],["قدْ أصابتْهم فتنةُ المالِ والوُلْ","دِ فصاروا في دأبِهم كالجمادِ",66,"د",1,0],["قَد اصطفَى مَنِ اصطَفى","في الخَلقِ واجتَبَاه",67,"ا",2,0],["قد أصَمَّتنا بِصَوتٍ","مُذهِبٍ عنا المَسَرَّه",68,"ر",2,1],["قد اصْطَفاَكَ السَّناَ واختارَكَ الأَلَقُ","فكيف يسمو إلى تكوينِكَ، العَلَقُ!",69,"ق",1,1],["قد أصبح قلبي في وهجِ","ومدامع عيني كاللججِ",70,"ج",1,1],["قد أصبَحَتْ جَنَّةً قامتْ بها غُرَفٌ","مِن فوقِها قامَ في تأْريخها غُرَفُ",71,"ف",1,0],["قَدِ اصطَفاكَ فُؤادُ المُلكِ مُنتخِباً","وَهْوَ الدليلُ على ما فيكَ من شِيمَ",72,"م",1,0],["قد أصبَحَتْ كلُّ البِلادِ عِيالَهُ","إذ كان يَرزُقُ كلَّها إمدادَهُ",73,"د",2,0],["قَدْ أَصْبَحَ آخِرُ الهَوى أَوَّلَهُ","فَالعَاذِلُ فِي هَواكَ ما لِي وَلهُ",74,"ه",1,1],["قد اصطفتك فريدا يا ابن بجدتها","فلحت بدراً بلوج المجد مكتملا",75,"ل",2,0],["قد أصبحت لمن استهدى شموس هدى","تنير منهاج كل إينما سارا",76,"ر",2,0],["قَد أَصبَحت كَعبةً للعلم تُقصَدُ من","أَقصى البِلاد كَما في الأعصُرِ الأُوَل",77,"ل",1,0],["قَد اِصفرّ في يَوم القِلى منك جسمهُ","وَما اِخضرَّ في يَوم اللقا بك عودُهُ",78,"د",2,0],["قَد اِصفَرَّ مِن سَفعِ الدُخانِ لِحاهُمُ","كَما لاحَ مِن هُدبِ المُلاءِ جِسادُها",79,"د",3,0],["قد أصبح الإحسان من","ك مخيما في خير خيمِ",80,"م",1,0],["قد أصبح الشعر بين الناس مبتذلا","وقام بالشعر نظام ووزان",81,"ن",1,0],["قَد أَصلَحَ الشام البَهيج بِنعمَةٍ","بَعدَ المَصائِبِ وَازِدَهى لُبنانُ",82,"ن",1,0],["قد اصبحت لها قلو","ب عاشقيه غرضا",83,"ض",2,0],["قد أصبح العلم لا يبغي به بدلا","وكيف يبغي بيسوب الهدى بدلا",84,"ل",2,0],["قَد أَصابَتك في التقرّب عين","فاِستَنارَت لشبهها الفلك برقا",85,"ق",2,0],["قد أصبح الفضل مرتاحاً وانتشعت","بحال صحتك الأرواح والهمم",86,"م",1,0],["قد اصطفاه المصطفى لشرعه","والمرتضى قد ارتضاه وَلدا",87,"د",2,0],["قد اصبحت