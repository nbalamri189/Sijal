{"poems":[[87,"كأس من الدنيا تدار","https://www.aldiwan.net/poem62885.html","مجزوء الكامل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30506","البسيط"],[189,"قم نصطبح عند نقرات النواقيس","https://www.aldiwan.net/poem14702.html","البسيط"],[193,"أقبل على مدح النبي مفخما","https://www.aldiwan.net/poem35104.html","الكامل"],[199,"إن الخليط أجدوا البين فانقذفوا","https://www.aldiwan.net/poem54398.html","البسيط"],[230,"لو أن أطلال المنازل تنطق","https://www.aldiwan.net/poem55213.html","الكامل"],[458,"مهد الحضارة للعروبة كلها","https://www.aldiwan.net/poem61290.html","الكامل"],[463,"لو كنت تبلو غداة السفح أخباري","https://www.aldiwan.net/poem56179.html","البسيط"],[563,"أنا دائما يا نور كل مليح","https://www.aldiwan.net/poem34680.html","الكامل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59759","الكامل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138090",""],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45895","البسيط"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45810","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91306","الكامل"],[4767,"طود الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=178888",""],[4935,"أضحى خطيب العلم فوق المنبر","https://www.poetsgate.com/ViewPoem.aspx?id=129451",""]],"verses":[["حَتّى اِهتَدى مَن كانَ ضَل","لَ وَثابَ مَن قَد كانَ ثار",0,"ر",1,0],["حتَّى أَهِمَّ بقتلي كُلَّ داجِيَةٍ","يا قَوْم هل رامَ هذا قَبْلُ إِنسِيُّ",1,"ي",1,0],["حتى اهتديتُ إلى دير القَصير فما","قَصَرتُ دمعي بشيء غير تَعْريس",2,"س",1,0],["حتّى اِهتدى أنصارهُ فاِستحكما","اللَّهُ قَد صلّى عليهِ وسلّما",3,"م",2,0],["حَتّى اِهتَدَوا لِلَّتي كُنّا نَظُنُّ بِهِم","وَأَنسَلوا الحاجَةَ القَلبَ الَّذي شَعَفوا",4,"ف",3,0],["حتى اهتَديتَ إلى الصَوابِ وَلم يَزَل","بينَ الصَواب وَبينَ رَأيك موثِقُ",5,"ق",1,0],["حتى أهزّ السادرين لعلّهم","يتنبهون إلى عواقب قتلها",6,"ل",3,0],["حتى أهلُّوا فلبَّوا حاسرين إلى ال","دَاعي مباذلَ أشعارٍ وأبشارِ",7,"ر",1,0],["حتى أهاج بنا الغرام فيا لَهُ","في الحب من خبرٍ رواه صحيح",8,"ح",1,0],["حتى أهزَّ العضب وهو مُشتهرٌ","فأراهُ يزهي بالنجيع ويكتسي",9,"س",2,0],["حتى أهاب به داعى المنون فما","بكوا عليه وولى غير محمود",10,"د",1,0],["حَتّى اِهتَديت لِأَنوار مَتى سَفرت","لِلناظِرين وَسر السَمع وَالبَصَر",11,"ر",1,0],["حَتّى اِهتَديت إِلى النور المُبين وَقَد","لاحَ الصَباح وَأَبدى ثَغر مُبتَسم",12,"م",1,0],["حَتّى اِهتَدوا مني بِنارِ جَوانِحي","وَاستسلموا لي حين حَقّقت النَبا",13,"ب",2,0],["حتى اهتدى ساعٍ به","في ليلهِ وتَنوَّرا",14,"ر",2,0],["حتى اهتديت بهدى دين نبينا","رب الشفاعة واللوا والكوثر",15,"ر",1,0]]}