{"poems":[[53,"أعاد لي عيد الضنى","https://www.aldiwan.net/poem29729.html","مجزوء الرجز"],[53,"يا دار ما طربت إليك النوق","https://www.aldiwan.net/poem29956.html","الكامل"],[93,"لحق اليوم بالرفاق أمين","https://www.aldiwan.net/poem11209.html","الخفيف"],[93,"تحية أيها القتلى وتسليماً","https://www.aldiwan.net/poem11387.html","البسيط"],[93,"أبيت والسيف يعلو الرأس تسليماً","https://www.aldiwan.net/poem11419.html","البسيط"],[88,"لا يبلغ المرء منتهى أربه","https://www.aldiwan.net/poem45001.html","المنسرح"],[88,"عبد المجيد قضى فوا حربا","https://www.aldiwan.net/poem45048.html","أحذ الكامل"],[51,"صبرا على أشياء كلفتها أعقبتها الآن وسلفتها","https://www.aldiwan.net/poem8691.html","السريع"],[51,"أما الزمان إلى سلمى فقد جنحا","https://www.aldiwan.net/poem9264.html","البسيط"],[51,"لهف نفسي على العيون المراض","https://www.aldiwan.net/poem64947.html","الخفيف"],[51,"نبكي الشباب لحاجات النساء ولي","https://www.aldiwan.net/poem66769.html","البسيط"],[91,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[78,"الأكثرين مسودا ومملكا","https://www.aldiwan.net/poem14192.html","الكامل"],[85,"يا راحلا عنا وذكرك خالد","https://www.aldiwan.net/poem7267.html","الكامل"],[28,"ما أصبحت أرض العراق بها","https://www.aldiwan.net/poem5128.html","الكامل"],[28,"وإذا نظرت رأيت فوقك دارما","https://www.aldiwan.net/poem5253.html","الكامل"],[28,"فاربط لأمك عن ربيك أتانه","https://www.aldiwan.net/poem5256.html","الكامل"],[61,"شيخ لنا من شيوخ بغداد","https://www.aldiwan.net/poem51688.html","المنسرح"],[66,"كم قد أفضنا من دموع ودما","https://www.aldiwan.net/poem41378.html","الرجز"],[44,"السيف أصدق أنباء من الكتب","https://www.aldiwan.net/poem30591.html","البسيط"],[69,"سحائب البرد المرفض صائلة","https://www.aldiwan.net/poem29121.html","البسيط"],[69,"برية بحرية حزنية","https://www.aldiwan.net/poem29299.html","الكامل"],[39,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[52,"من يذود الهموم عن مكروب","https://www.aldiwan.net/poem27241.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85525","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85430","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85591","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85479","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54760","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[106,"صدى الجمهورية","https://www.poetsgate.com/ViewPoem.aspx?id=179586",""],[106,"ثغر لا يتبسم","https://www.poetsgate.com/ViewPoem.aspx?id=179422",""],[106,"عرش الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=179473",""],[106,"زيارة طرابلس","https://www.poetsgate.com/ViewPoem.aspx?id=179604",""],[106,"نيسان","https://www.poetsgate.com/ViewPoem.aspx?id=179310",""],[106,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[51,"نبكي الشبابَ لحاجاتِ النساءِ ولي","https://www.poetsgate.com/ViewPoem.aspx?id=30798",""]],"verses":[["كَم كَبِدٍ مَعقورَةٍ","لِلعاقِرينَ البُدُنا",0,"ن",2,0],["كَم كاهِلٍ لِلشِعرِ أَثقَلَ نَعتُهُ","عِطفَيهِ وَهوَ لِما يَؤُدُّ مُطيقُ",1,"ق",1,0],["كَمْ كِتَابٍ أَبَحْتَ فِيهِ كُنُوزاً","كَانَ فِي الغَيْبِ ذُخْرُهَا المَكْنُونُ",2,"ن",1,0],["كَمْ كُبِّلَ الحَقُّ بِالأَصْفَادِ مِنْ ثِدَمٍ","ثُمَّ انْطَوَيْنَ وَبَاءَ البُطْلُ مَهْزُومَا",3,"م",2,0],["كَمْ كُبِّلَ الحَقُّ بِالأصْفَادِ من قِدَمٍ","فَلَمْ تَضِرْهُ وَرُدَّ البُطْلُ مَهْزُوما",4,"م",2,0],["كم كذب الدهر في فعائله","وسؤدد الجاهلين من كَذِبه",5,"ب",2,0],["كم كنت تكشف فيه محتجبا","وتنال أقصى الأمر من كثب",6,"ب",1,0],["كم كلماتٍ حكْتُ أبْرادَهَا","وَسَّطْتُها الحسْنَ وطَرَّفْتُهَا",7,"ت",3,0],["كم كاشح لك لا تُجدي عداوته","عليه ما عاش إلا الوَريَ والكَشَحا",8,"ح",2,0],["كم كَفوْنا من السنين جَرُوزاً","تَحْطُمُ العظمَ بعد بَرى النِّحاض",9,"ض",1,0],["كم كان يُونقُ من عين تَقَرُّ به","وكان يونقُ من أخرى يبكّيها",10,"ي",3,0],["كم كان يجلو قذى عينٍ برونقهِ","حتى إذا جال فيها عاد يقذيها",10,"ي",3,0],["كَم كِيانٍ قَد تَلاشى في كِياني وَاِستَحال","كَم كِيانٍ فيهِ شَيءٌ مِن كِياني لَستُ أَدري",11,"ي",1,0],["كَم كانَ من أسدٍ هُنالِك خادرِ","لَكَ حارِسٌ بِأَسِنَّة وَشِفارِ",12,"ر",1,0],["كم كان قبلك من دعىّ يرتجى","طمس الضياء فما أصاب مراما",13,"م",2,0],["كَم كانَ مِن قِسٍّ يُخَبِّرُنا","بِخِلافَةِ المَهدِيِّ أَو حَبرِ",14,"ر",1,0],["كَم كانَ مِن مَلِكٍ وَطِئنَ وَسوقَةٍ","أَطلَقنَهُ وَبِساعِدَيهِ إِسارُ",15,"ر",1,0],["كَم كانَ قَبلَكَ مِن لَئيمٍ خائِنٍ","تُرِكَت مَسامِعُهُ وَهُنَّ صِغارُ",16,"ر",1,0],["كم كَبِدٍ بالعِراقِ ناجيةٍ","منها وأُخرى بجَزِّ أفلاذِ",17,"ذ",1,0],["كَم كانَ فيها مِن فَتاةٍ وَفَتىً","كُلُّ لِقَلبِ المُستَهامِ قَد فَتَن",18,"ن",1,0],["كَم كانَ في قَطعِ أَسبابِ الرِقابِ بِها","إِلى المُخَدَّرَةِ العَذراءِ مِن سَبَبِ",19,"ب",1,0],["كَمْ كسَّرتْ أصلَ تفاحٍ وكم حَطَمَتْ","ورداً وعضت على العنَّاب بالزرد",20,"د",1,0],["كمْ كان فيها للفرنجِ كواعبٌ","كانتْ إناثاً واللحاظُ ذكورُها",21,"ر",3,0],["كَمُكَدَّمٍ لَم يُبقِ قا","نِصُهُ لَهُ غَيرَ الحَبائِل",22,"ل",1,0],["كَم كَريمٍ يَرى الوَعدَ بُخلاً","مِنهُ قَلَّ لِكَثرَةِ المَوهوبِ",23,"ب",1,0],["كم كانَ لي فيه دون ال","مقلدين اختراع",24,"ع",1,0],["كَم كانَ فيهم من خَطيب مصقع","طلب البيان ولات حين بيان",25,"ن",1,0],["كَم كنت تطلع قبلي","وَكَم ستطلع بعدي",26,"ي",1,0],["كَم كال لي سباً","في الصحف أَضداد",27,"د",1,0],["كَمْ كَانَ فِي الشِّيَمِ الَّتِي ذَهَبَتْ","بِوَفَاتهِ كَنْزٌ لِذِي وُدِّ",28,"د",1,0],["كمْ كِتَابٍ بَرَزت أَحْرُفُهُ","سَاطِعَاتٍ وَلِسَانُ النارِ يَقْرَا",29,"ر",2,0],["كَمْ كِتَابٍ دَوَّنَتْ أَخْبارُهُ","مِنَناً كان فؤادٌ مُبْتَداها",30,"ا",3,0],["كم كنتُ أضحَكُ من نفسي وأُضحِكُها","إِذ أَلبسُ البُومَ ريشَ الطائِر الغرِدِ",31,"د",1,0],["كم كنت أغشاه فأنسى عنده","نفسي ويسبح بي الخيال وأحلم",32,"م",1,0],["كم كاعبٍ ملك قلوبا أصبحت","أمَةً تباع إذا أردتِ وتشتري",33,"ر",2,0],["كم كربةٍ بالحمى اشتدَّت ففرّجها","وكم على يده الداءُ العضالُ أُسِى",34,"س",2,0],["كم كَهْرب الجوَّ فصلٌ غيرُ معتدلٍ","تعاورَتْه زياداتٌ ونقصان!",35,"ن",1,0],["كم كُنتُ أحبُوهم بَعْطِفي دائِمًا","لا فرقَ بَيْنَهُمُو وبَيْن عِيالِي",36,"ل",2,0],["كم كان يُونقُ من عين تَقَرُّ","وكان يونقُ من أخرى يبكّيها",37,"ي",3,0]]}