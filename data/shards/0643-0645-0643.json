{"poems":[[53,"أعاد لي عيد الضنى","https://www.aldiwan.net/poem29729.html","مجزوء الرجز"],[53,"يا دار ما طربت إليك النوق","https://www.aldiwan.net/poem29956.html","الكامل"],[93,"لحق اليوم بالرفاق أمين","https://www.aldiwan.net/poem11209.html","الخفيف"],[93,"تحية أيها القتلى وتسليماً","https://www.aldiwan.net/poem11387.html","البسيط"],[93,"أبيت والسيف يعلو الرأس تسليماً","https://www.aldiwan.net/poem11419.html","البسيط"],[88,"لا يبلغ المرء منتهى أربه","https://www.aldiwan.net/poem45001.html","المنسرح"],[88,"عبد المجيد قضى فوا حربا","https://www.aldiwan.net/poem45048.html","أحذ الكامل"],[51,"صبرا على أشياء كلفتها أعقبتها الآن وسلفتها","https://www.aldiwan.net/poem8691.html","السريع"],[51,"أما الزمان إلى سلمى فقد جنحا","https://www.aldiwan.net/poem9264.html","البسيط"],[51,"لهف نفسي على العيون المراض","https://www.aldiwan.net/poem64947.html","الخفيف"],[51,"نبكي الشباب لحاجات النساء ولي","https://www.aldiwan.net/poem66769.html","البسيط"],[91,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[78,"الأكثرين مسودا ومملكا","https://www.aldiwan.net/poem14192.html","الكامل"],[85,"يا راحلا عنا وذكرك خالد","https://www.aldiwan.net/poem7267.html","الكامل"],[28,"ما أصبحت أرض العراق بها","https://www.aldiwan.net/poem5128.html","الكامل"],[28,"وإذا نظرت رأيت فوقك دارما","https://www.aldiwan.net/poem5253.html","الكامل"],[28,"فاربط لأمك عن ربيك أتانه","https://www.aldiwan.net/poem5256.html","الكامل"],[61,"شيخ لنا من شيوخ بغداد","https://www.aldiwan.net/poem51688.html","المنسرح"],[66,"كم قد أفضنا من دموع ودما","https://www.aldiwan.net/poem41378.html","الرجز"],[44,"السيف أصدق أنباء من الكتب","https://www.aldiwan.net/poem30591.html","البسيط"],[69,"سحائب البرد المرفض صائلة","https://www.aldiwan.net/poem29121.html","البسيط"],[69,"برية بحرية حزنية","https://www.aldiwan.net/poem29299.html","الكامل"],[39,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[52,"من يذود الهموم عن مكروب","https://www.aldiwan.net/poem27241.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85525","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85430","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85591","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85479","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54760","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[106,"صدى الجمهورية","https://www.poetsgate.com/ViewPoem.aspx?id=179586",""],[106,"ثغر لا يتبسم","https://www.poetsgate.com/ViewPoem.aspx?id=179422",""],[106,"عرش الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=179473",""],[106,"زيارة طرابلس","https://www.poetsgate.com/ViewPoem.aspx?id=179604",""],[106,"نيسان","https://www.poetsgate.com/ViewPoem.aspx?id=179310",""],[106,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[100,"الحكم للشعب","https://www.poetsgate.com/ViewPoem.aspx?id=50179",""],[51,"نبكي الشبابَ لحاجاتِ النساءِ ولي","https://www.poetsgate.com/ViewPoem.aspx?id=30798",""],[128,"وعليك نفسك لا تعب أحدا ولا","https://www.aldiwan.net/poem50568.html","الكامل"],[135,"ليدع المدعون العلم والأدبا","https://www.aldiwan.net/poem49171.html","البسيط"],[160,"من عوض الصبر عما فاته ربحا","https://www.aldiwan.net/poem58909.html","البسيط"],[160,"يوم سرور وشفاء صدر","https://www.aldiwan.net/poem59024.html","الرجز"],[197,"يا طائر الفجرِ من بالراح أغرانا","https://www.aldiwan.net/poem39886.html","البسيط"],[223,"من أنت يا بنت الألى وجدوك","https://www.aldiwan.net/poem41640.html","الكامل"],[229,"الآن قد الفؤاد نصفين","https://www.aldiwan.net/poem50780.html","المنسرح"],[270,"أبكي على الصيف كالباكي على الطلل","https://www.aldiwan.net/poem35661.html","البسيط"],[275,"ما العيد بعدك بالأماني عائد","https://www.aldiwan.net/poem25592.html","الكامل"],[279,"يا ماطلاً لا يرى غليلي","https://www.aldiwan.net/poem2649.html","مخلع البسيط"],[297,"قم هاتها كالنار ذات الوقود","https://www.aldiwan.net/poem33291.html","السريع"],[320,"أديت واجبك المقدس كاملا","https://www.aldiwan.net/poem61624.html","الكامل"],[320,"اسم العزيز وقى المهيمن ذاته","https://www.aldiwan.net/poem67228.html","الكامل"],[326,"قد عزني الداء فما لي دواء","https://www.aldiwan.net/poem44294.html","السريع"],[338,"اغتنم غفلة المنية واعلم","https://www.aldiwan.net/poem68772.html","الكامل"],[364,"شاق الحمام إليك لما ناحا","https://www.aldiwan.net/poem60965.html","الكامل"],[371,"حبل الهوى ملقى على الغارب","https://www.aldiwan.net/poem57530.html","السريع"],[377,"إن تسل عن روميا قل","https://www.aldiwan.net/poem59229.html","مجزوء الرمل"],[391,"يا طالب السكنى بوادي الأحقاف","https://www.aldiwan.net/poem54551.html","عموديه"],[403,"منعت عن مقلة الصب كراها","https://www.aldiwan.net/poem33364.html","الرمل"],[416,"خذ بالمسرة واغنم لذة الطرب","https://www.aldiwan.net/poem54116.html","البسيط"],[429,"أقبلت تنجلي وتسحب ذيلا","https://www.aldiwan.net/poem40711.html","الخفيف"],[432,"لمن ربوع مقفرات باللوى","https://www.aldiwan.net/poem12472.html","الرجز"],[434,"كم كان فيها من كرام سادة","https://www.aldiwan.net/poem25692.html","الكامل"],[441,"ألق العصي فهذا مقتضى الأرب","https://www.aldiwan.net/poem14330.html","البسيط"],[443,"كم كشف العلم لأهل النهى","https://www.aldiwan.net/poem56013.html","عموديه"],[453,"خطرت آسيا بعيد أبيها","https://www.aldiwan.net/poem61621.html","الخفيف"],[458,"أين تريد يا مثير الظعن","https://www.aldiwan.net/poem55836.html","الرجز"],[458,"مل معي لا عليك ضري ونفعي","https://www.aldiwan.net/poem56120.html","الخفيف"],[464,"ظبيات الحمى تخيف الأسودا","https://www.aldiwan.net/poem3169.html","عموديه"],[477,"دم أريق بأسياف الهوى هدر","https://www.aldiwan.net/poem15236.html","البسيط"],[479,"قل ما بدا لك تلق السمع صاغيه","https://www.aldiwan.net/poem37039.html","البسيط"],[479,"يا راكب الرتل السريع","https://www.aldiwan.net/poem37043.html","مجزوء الكامل"],[479,"أترافق الخود الحسان وتدعي","https://www.aldiwan.net/poem37179.html","الكامل"],[479,"ظلموك يا جدي ولست ظلوما","https://www.aldiwan.net/poem37194.html","الكامل"],[479,"قالوا حبست فقلت ليس بضائري","https://www.aldiwan.net/poem37597.html","الكامل"],[482,"كم كنت في غمرات الحب أستبق","https://www.aldiwan.net/poem24456.html","عموديه"],[493,"كم كربة ضاق صدري عن تحملها","https://www.aldiwan.net/poem67353.html","البسيط"],[495,"ما للخزامى تعود نسرينا","https://www.aldiwan.net/poem10279.html","المنسرح"],[551,"كتمت من أسماء ما كان علن","https://www.aldiwan.net/poem47149.html","الرجز"],[551,"خل عنها منيحة للئام","https://www.aldiwan.net/poem47202.html","الخفيف"],[551,"أي فتى ووري في الترب","https://www.aldiwan.net/poem48059.html","السريع"],[575,"من للريب هفت به الفكر","https://www.aldiwan.net/poem2726.html","أحذ الكامل"],[575,"قدمت بالنصر وبالمغنم","https://www.aldiwan.net/poem3014.html","السريع"],[575,"لست الملوم بما تجني علي بصري","https://www.aldiwan.net/poem3066.html","البسيط"],[586,"خافت من الرقباء يوم وداعي","https://www.aldiwan.net/poem17593.html","الكامل"],[586,"قابلت عز هواكم بتذلل","https://www.aldiwan.net/poem17666.html","الكامل"]],"verses":[["كَم كَبِدٍ مَعقورَةٍ","لِلعاقِرينَ البُدُنا",0,"ن",2,0],["كَم كاهِلٍ لِلشِعرِ أَثقَلَ نَعتُهُ","عِطفَيهِ وَهوَ لِما يَؤُدُّ مُطيقُ",1,"ق",1,0],["كَمْ كِتَابٍ أَبَحْتَ فِيهِ كُنُوزاً","كَانَ فِي الغَيْبِ ذُخْرُهَا المَكْنُونُ",2,"ن",1,0],["كَمْ كُبِّلَ الحَقُّ بِالأَصْفَادِ مِنْ ثِدَمٍ","ثُمَّ انْطَوَيْنَ وَبَاءَ البُطْلُ مَهْزُومَا",3,"م",2,0],["كَمْ كُبِّلَ الحَقُّ بِالأصْفَادِ من قِدَمٍ","فَلَمْ تَضِرْهُ وَرُدَّ البُطْلُ مَهْزُوما",4,"م",2,0],["كم كذب الدهر في فعائله","وسؤدد الجاهلين من كَذِبه",5,"ب",2,0],["كم كنت تكشف فيه محتجبا","وتنال أقصى الأمر من كثب",6,"ب",1,0],["كم كلماتٍ حكْتُ أبْرادَهَا","وَسَّطْتُها الحسْنَ وطَرَّفْتُهَا",7,"ت",3,0],["كم كاشح لك لا تُجدي عداوته","عليه ما عاش إلا الوَريَ والكَشَحا",8,"ح",2,0],["كم كَفوْنا من السنين جَرُوزاً","تَحْطُمُ العظمَ بعد بَرى النِّحاض",9,"ض",1,0],["كم كان يُونقُ من عين تَقَرُّ به","وكان يونقُ من أخرى يبكّيها",10,"ي",3,0],["كم كان يجلو قذى عينٍ برونقهِ","حتى إذا جال فيها عاد يقذيها",10,"ي",3,0],["كَم كِيانٍ قَد تَلاشى في كِياني وَاِستَحال","كَم كِيانٍ فيهِ شَيءٌ مِن كِياني لَستُ أَدري",11,"ي",1,0],["كَم كانَ من أسدٍ هُنالِك خادرِ","لَكَ حارِسٌ بِأَسِنَّة وَشِفارِ",12,"ر",1,0],["كم كان قبلك من دعىّ يرتجى","طمس الضياء فما أصاب مراما",13,"م",2,0],["كَم كانَ مِن قِسٍّ يُخَبِّرُنا","بِخِلافَةِ المَهدِيِّ أَو حَبرِ",14,"ر",1,0],["كَم كانَ مِن مَلِكٍ وَطِئنَ وَسوقَةٍ","أَطلَقنَهُ وَبِساعِدَيهِ إِسارُ",15,"ر",1,0],["كَم كانَ قَبلَكَ مِن لَئيمٍ خائِنٍ","تُرِكَت مَسامِعُهُ وَهُنَّ صِغارُ",16,"ر",1,0],["كم كَبِدٍ بالعِراقِ ناجيةٍ","منها وأُخرى بجَزِّ أفلاذِ",17,"ذ",1,0],["كَم كانَ فيها مِن فَتاةٍ وَفَتىً","كُلُّ لِقَلبِ المُستَهامِ قَد فَتَن",18,"ن",1,0],["كَم كانَ في قَطعِ أَسبابِ الرِقابِ بِها","إِلى المُخَدَّرَةِ العَذراءِ مِن سَبَبِ",19,"ب",1,0],["كَمْ كسَّرتْ أصلَ تفاحٍ وكم حَطَمَتْ","ورداً وعضت على العنَّاب بالزرد",20,"د",1,0],["كمْ كان فيها للفرنجِ كواعبٌ","كانتْ إناثاً واللحاظُ ذكورُها",21,"ر",3,0],["كَمُكَدَّمٍ لَم يُبقِ قا","نِصُهُ لَهُ غَيرَ الحَبائِل",22,"ل",1,0],["كَم كَريمٍ يَرى الوَعدَ بُخلاً","مِنهُ قَلَّ لِكَثرَةِ المَوهوبِ",23,"ب",1,0],["كم كانَ لي فيه دون ال","مقلدين اختراع",24,"ع",1,0],["كَم كانَ فيهم من خَطيب مصقع","طلب البيان ولات حين بيان",25,"ن",1,0],["كَم كنت تطلع قبلي","وَكَم ستطلع بعدي",26,"ي",1,0],["كَم كال لي سباً","في الصحف أَضداد",27,"د",1,0],["كَمْ كَانَ فِي الشِّيَمِ الَّتِي ذَهَبَتْ","بِوَفَاتهِ كَنْزٌ لِذِي وُدِّ",28,"د",1,0],["كمْ كِتَابٍ بَرَزت أَحْرُفُهُ","سَاطِعَاتٍ وَلِسَانُ النارِ يَقْرَا",29,"ر",2,0],["كَمْ كِتَابٍ دَوَّنَتْ أَخْبارُهُ","مِنَناً كان فؤادٌ مُبْتَداها",30,"ا",3,0],["كم كنتُ أضحَكُ من نفسي وأُضحِكُها","إِذ أَلبسُ البُومَ ريشَ الطائِر الغرِدِ",31,"د",1,0],["كم كنت أغشاه فأنسى عنده","نفسي ويسبح بي الخيال وأحلم",32,"م",1,0],["كم كاعبٍ ملك قلوبا أصبحت","أمَةً تباع إذا أردتِ وتشتري",33,"ر",2,0],["كم كربةٍ بالحمى اشتدَّت ففرّجها","وكم على يده الداءُ العضالُ أُسِى",34,"س",2,0],["كم كَهْرب الجوَّ فصلٌ غيرُ معتدلٍ","تعاورَتْه زياداتٌ ونقصان!",35,"ن",1,0],["كم كُنتُ أحبُوهم بَعْطِفي دائِمًا","لا فرقَ بَيْنَهُمُو وبَيْن عِيالِي",36,"ل",2,0],["كم كابد الشعب في أشواطه محنا","ماذا ترى ؟ أنضجته هذه المحن !",37,"ن",1,0],["كم كان يُونقُ من عين تَقَرُّ","وكان يونقُ من أخرى يبكّيها",38,"ي",3,0],["كَمْ كَمْ وكَمْ من عالمٍ ومعلمٍ","كنِجار موسى سَفّهُوه وسَفْسَفُوا",39,"ف",3,0],["كم كان يجرف بالآداب سامعه","فلا يملّ ولو أصنى له حقبا",40,"ب",2,0],["كم كربةٍ ضاقٌ منها المرءُ فانفرجت","عنهُ وأصبح مسروراً بها فرحا",41,"ح",2,0],["كم كر في الأعدا وما لجسمه","درع سوى قميصه والكر",42,"ر",1,0],["كم كاشفتها بما ضمت جوانحها","فتذرف الدمع إشفاقا وتحنانا",43,"ن",2,0],["كَم كُنتُ أَنشدتُ القَريضَ مسلسَلاً","لَو كانَ في العِشرينَ عمر أَخيكِ",44,"ك",1,0],["كم كَفَرا بالإِلهِ إذ منعَا","مُلكَك كالطالِبَيْه دَيْنين",45,"ن",1,0],["كم كنتُ أقطفهُ أو كنتُ أنشقُه","والعطرُ والنضرُ مثلُ الحبّ والأمل",46,"ل",1,0],["كَمْ كُنْتُ في أمْثَالِه بكَ رَاغِباً","والآنَ مِثلِي فيه دُونَك زاهِد",47,"د",1,0],["كم كتبَ الدَّمعُ فوق خدي","إِليك شكوى بلا جواب",48,"ب",1,0],["كَم كَرَمٍ نَتلوهُ من فَضلِهِ","كرامةً لا يَعتَريها جُحود",49,"د",1,0],["كَم كان خصمك خاذلاً ليقينه","وأبيتَ أن تلفىَ لخصمك خاذلا",50,"ل",2,0],["كَم كُنتَ أَتلوهُ وَأَلحَظُ أَنَّهُ","سَيَكونُ مالِكَ مِصرِنا غَيرَ حَزَرِ",51,"ر",1,0],["كَم كُربَةٍ قَد مَسَّني ضُرُّها","نادَيتُ فيها عَمرَ بنَ العَلاءِ",52,"ا",2,0],["كَم كَبيرٍ يَومَ القِيامَةِ يُقصى","وَصَغيرٌ لَهُ هُنالِكَ قَدرُ",53,"ر",1,0],["كم كان من عُسْرٍ ومِن يُسرٍ","فما ألفِيتُ مِجْزاعاً ولا مِفراحا",54,"ح",2,0],["كم كذّبا من حذرٍ صادقٍ","وصدَّقا من أملٍ كاذبِ",55,"ب",1,0],["كم كفورٍ حلَّ فيها","عاد بالإيمان راكن",56,"ن",1,0],["كم كف عنا كف حاسد حاف","يا ربنا استرنا بسترك الضاف",57,"ف",1,0],["كم كلم من دعوة نافعة","كشفت عن كل نفس ما عراها",58,"ا",3,0],["كم كربة نفّست للجيش همته","فحقّه أنّ يسمى كاشف الكرب",59,"ب",1,0],["كم كمي أرداه يوم نزالٍ","وخميس من فتك يمناه ولّى",60,"ل",2,0],["كم كان فيها من أغنَّ شادنٍ","يرعى القلوبَ لا الأراكَ والغَضا",61,"ا",1,0],["كَمْ كانَ فِيها منْ كِرامٍ سادَة","بِيضِ الْوُجوهِ شَوامخِ الإِيمانِ",62,"ن",1,1],["كم كم قطعت إليه أنجداً وفضا","وكم ركبت جواري قصده ونصا",63,"ص",2,0],["كم كشف العلم لأهل النهى","من حجب عن منظر