{"poems":[[79,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[95,"يا حسنها حين تجلت على","https://www.aldiwan.net/poem11300.html","السريع"],[32,"ما هاج عينيك من الأطلال","https://www.aldiwan.net/poem29544.html","الرجز"],[53,"صبا من شاب مفرقه تصابي","https://www.aldiwan.net/poem8494.html","الوافر"],[68,"وشحيح من لؤمه يخبز البخ","https://www.aldiwan.net/poem38592.html","الخفيف"],[41,"أمن دمن بشاجنة الحجون","https://www.aldiwan.net/poem53733.html","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39655","الكامل"],[52,"يا صاح قل في حاجتي:","https://www.poetsgate.com/ViewPoem.aspx?id=21609",""],[147,"لك السعي ما ينفك يخدمه السعد","https://www.aldiwan.net/poem11747.html","الطويل"],[242,"يا حسنه والحسن قيد","https://www.aldiwan.net/poem18133.html","مجزوء الكامل"],[396,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[422,"أكرم بطيف خيالكم من زائر","https://www.aldiwan.net/poem54150.html","الكامل"],[438,"عقدوا شعورهم عمائم","https://www.aldiwan.net/poem12340.html","مجزوء الكامل"],[445,"أرحلي محمول على العتق النجب","https://www.aldiwan.net/poem34886.html","الطويل"],[469,"لا تلمني فلات حين ملام","https://www.aldiwan.net/poem3141.html","عموديه"],[534,"قل لإمام الزمن","https://www.aldiwan.net/poem37130.html","الرجز"],[543,"أينما كنت كنت رمز الكمال","https://www.aldiwan.net/poem47986.html","عموديه"],[543,"أنت ماذا دهاك قل لي حتى","https://www.aldiwan.net/poem48307.html","عموديه"],[556,"من على هذه الديار أقاما","https://www.aldiwan.net/poem47232.html","الخفيف"],[673,"","https://poetry.dctabudhabi.ae/diwan/poem/137338",""],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64164","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37882","الخفيف"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123401","الكامل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16741","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79862","الخفيف"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111819","الطويل"],[1652,"","https://poetry.dctabudhabi.ae/diwan/poem/67379","الطويل"],[1782,"","https://poetry.dctabudhabi.ae/diwan/poem/128734","الخفيف"],[1895,"","https://poetry.dctabudhabi.ae/diwan/poem/74990","الرمل"],[2358,"","https://poetry.dctabudhabi.ae/diwan/poem/123475","المتقارب"],[2708,"","https://poetry.dctabudhabi.ae/diwan/poem/80426","الرجز"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127368","الرمل"],[3060,"","https://poetry.dctabudhabi.ae/diwan/poem/67590","المتقارب"],[3484,"","https://poetry.dctabudhabi.ae/diwan/poem/216399",""],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45805","البسيط"],[3640,"","https://poetry.dctabudhabi.ae/diwan/poem/141900","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77156","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83670","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28620","الكامل"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139217","الوافر"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66116","المتقارب"],[4679,"يا ربع ته بقدوم أشرف زائر","https://www.poetsgate.com/ViewPoem.aspx?id=142736",""],[4702,"نار الغبن","https://www.poetsgate.com/ViewPoem.aspx?id=155214",""],[4764,"اربع سنين","https://www.poetsgate.com/ViewPoem.aspx?id=28330",""],[4119,"وشحنة كالهلال في ياعوا","https://www.poetsgate.com/ViewPoem.aspx?id=16181",""],[5055,"هد القصايد","https://www.poetsgate.com/ViewPoem.aspx?id=109398",""],[5198,"نجمة الصبح","https://www.poetsgate.com/ViewPoem.aspx?id=135527",""],[5225,"أذهلتني","https://www.poetsgate.com/ViewPoem.aspx?id=24310",""],[5376,"دُسْ عليها واهْرسِ الجسْمَ النحيلا","https://www.poetsgate.com/ViewPoem.aspx?id=188451",""],[5510,"يا هاجري","https://www.poetsgate.com/ViewPoem.aspx?id=205706",""],[5510,"جرح المسافات","https://www.poetsgate.com/ViewPoem.aspx?id=206066",""],[5573,"ياهن وش فيهم علينا الموارد","https://www.poetsgate.com/ViewPoem.aspx?id=200453",""],[5573,"صلوا في رحالكم","https://www.poetsgate.com/ViewPoem.aspx?id=210867",""],[5652,"خلي عيوني بالغلا تذرف دموع","https://www.poetsgate.com/ViewPoem.aspx?id=136101",""],[5652,"ماغير صوتك لا ندهني ولبيت","https://www.poetsgate.com/ViewPoem.aspx?id=136695",""],[5652,"نوت الدفينه","https://www.poetsgate.com/ViewPoem.aspx?id=192040",""],[5732,"الملحمة الزايدية","https://www.poetsgate.com/ViewPoem.aspx?id=177865",""],[5732,"لزيت نفسي مير عيت تلزا","https://www.poetsgate.com/ViewPoem.aspx?id=177849",""],[5732,"يا معذبي بالحب","https://www.poetsgate.com/ViewPoem.aspx?id=177938",""],[5747,"البث المباشر","https://www.poetsgate.com/ViewPoem.aspx?id=61658",""],[5848,"ليلة خميس","https://www.poetsgate.com/ViewPoem.aspx?id=48969",""],[5862,"البُ ع د يرضي .. جَنابِكْ ... !!!","https://www.poetsgate.com/ViewPoem.aspx?id=31906",""],[5897,"قم يا عراق","https://www.poetsgate.com/ViewPoem.aspx?id=156690",""],[5309,"وشحرور ايك كم تغنى بألحاني","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573789",""]],"verses":[["وشحَنتَهُ بالبُرِّ في سُبُلِ الرِّضا","والبِرُّ قارَبَ قاعُها القامُوسا",0,"س",2,0],["وشحَذْتَ حدّاً كان قبْلُ مثَلّماً","ونعَشْتَ جَدّاً كانَ قبْلُ تعيسا",0,"س",2,0],["وَشَحُبَ النُّورُ كَأَنْ قَدْ عَرَا","مِنْ غَيْرِهِ شَمْسِ الأَصِيلِ السَّقَامْ",1,"م",1,0],["وَشَحشَحانِ الباكِرِ الحَجّالِ","في أُخرَياتِ حالِكٍ مُنجالِ",2,"ل",1,0],["وشُحَّ الغانِياتِ عليهِ إلّا","عن ابن شَبيبةٍ جَوْنِ الغُرابِ",3,"ب",1,0],["وَشَحيحٍ مِن لُؤمِهِ يَخبِزُ البُخ","لَ بِبَسطِ الأَخلاقِ بَينَ الرِفاقِ",4,"ق",1,1],["وَشَحواءِ المَقامِ بَلَلتُ مِنها","بِسَجلٍ بَطنَ مُطَّرِقٍ دَفينِ",5,"ن",1,0],["وشحوبِ وجهكَ إِن أرِقتَ صبابةً","حيرانَ بين قطيعةٍ ولقاءِ",6,"ا",2,0],["وشح لبانة صاحبٍ","واذكر بها ما كنت قلتا",7,"ت",2,0],["وَشَحطُ النَوى أَبدى سَرائِرَ أَهلِها","وَقَد يُعرَفُ الشَيءُ الخَفِيُّ بِما يَبدو",8,"د",2,0],["وَشَحَا الرَّدَى أُفْوَاهَهُ","فُضَّتْ لِبَلْعِ وُلاَةِ أَحْمَدْ",9,"د",1,0],["وشح بل وبخل","ومكر والخديعات",10,"ت",1,0],["وشحذت عزمك للمجيء غراره","ولرب عزم كالحسام الباتر",11,"ر",1,0],["وشَّحْتُها بفصاحَةِ ال","أعرابِ في ظَرفِ الأَعاجِم",12,"م",1,0],["وَشُحّاً بباقي ماءِ وَجْهٍ بذلتُه","لَعلِّيَ أَقضي قبلَ إِنفادِهِ نَحْبِي",13,"ب",2,0],["وشَّحَ الذيل والخريدة منهُ","بفريدةٍ مثل اسمهِ وتؤامِ",14,"م",1,0],["وشحَنُوا خُصُومَهُمْ","في عالِياتِ الْقِنَنِ",15,"ن",1,0],["وشَّحوا صدرَكَ الرَّحيبَ ونادَوا","أنتَ بين الرِّجالِ فذُّ الرجالِ",16,"ل",1,0],["وشَحاريرُها تغنِّي ولكن","في غنىً نحنُ عن سمَاع الغِناء",17,"ا",2,0],["وشحيحاً جَعْدَ اليدين بخيلاً","وجواداً مخوِّلاً مِطعاما",18,"م",2,0],["وشحذتَ بالحُجَج القواطع غربهُ","فانسلَّ جيشُ البُطل حين شحذتهُ",19,"ت",2,0],["وشَّحَتْها يداهُ من خالص التب","رِ بسطرٍ يجولُ جَولَ الوشاح",20,"ح",1,0],["وَشَّحتنا مِن لَفظهِ بِلآلٍ","يَزدري نَظمها بِعقدٍ نَضيدِ",21,"د",1,0],["وشَّحْتُ ألفاظي به","وشُغِلت عن ذات الوِشاح",22,"ح",1,0],["وَشُحوبَ جِسمي مِن مُواصَلَةِ السَرى","هَل مِن هِلالٍ لَيسَ فيهِ شُحوبُ",23,"ب",1,0],["وشحنتَ الزمانَ هدياً ونسكا","وقضيتَ الحقوقَ فرضاً ونفلا",24,"ل",2,0],["وشحَّذتُ سيف الصبر والوجد قاتلي","فأَصبحتُ شحَّاذاً واقبلتُ استجدي",25,"د",2,0],["وَشَحْنَاءَ دبَّتْ بَيْنَ سَعْدٍ وَبَيْنَهُ","فأصْبَحَتْ كَالْحَادِي بِغَيرِ بَعِيرِ",26,"ر",1,0],["وشحته اذكان للمجد اهلا","للمعالي من آل فهر سرات",27,"ت",1,0],["وشح اللاحي ضلالا بالهدى","وَيحه بالعذل مِثلي يبتزل",28,"ل",1,0],["وشحّت وضنَّت بما يَنبغي","منَ المكرُماتِ وهمس السّلام",29,"م",1,0],["وَشَحْمُه مُنّعِشٌ لِلْقَلْبِ","وَمُجْلِي مَا دَاخِلَهُ مِنْ كَرْبِ",30,"ب",1,0],["وشحارير ضناها الاشتياق","وبخاتي وقعاري وكنار",31,"ر",1,0],["وشحَّبَها فأجَارَ المليكُ","فصَيَّرها في صباحٍ خَصِرْ",32,"ر",1,0],["وِشْ حياتي كان ما اجيك يا زين الصباح","يا شِفا كَبدي يلي من غَشاها أمرارها",33,"ر",3,0],["وَشَحتُ نَظمي بدُرّ المَدح في قَمَر","بِالحُسن مُشتَمل بِالنور مُلتَثم",34,"م",1,0],["وشحّ في الكأس فاصطّفت عليه من ال","حباب حبات در رائق حسن",35,"ن",1,0],["وَشَحوب لَونِكَ بَعدَ مُنصَرِف الصِبا","وَذبول جسمِكَ إِذ وَهَت عَزماته",36,"ت",2,0],["وَشّحتُها بِفَصاحَة وَكَسَوتُها","حُللَ المَعاني من أَديبٍ عالِمِ",37,"م",1,0],["وَشَحَنتَ بِالأُسدِ الخَوادِر بِالقنا","وَالمُرهفاتِ شِعابَهُ وَرعونَهُ",38,"ن",2,0],["وشُحٌّ لا يزال يطاح دأباً","وعجب ظاهر في كل حاله",39,"ه",1,0],["وشَحْناءُ في العُرْبِ تَزْدادُ وَيْلا","تَسُرُّ العِدَى وتَسُوءُ الخَلِيلا",40,"ل",2,0],["وشحتها برد المسرة فانبرت","مختالةً تهتز هزّةَ فاخرِ",41,"ر",1,0],["وش حيلة القلب حب وراح محبوبه","والحال من بعدها من سُوّ في سُوّي",42,"و",2,1],["وش حامل ليومك لدفتر حسابك","وشهو خفوقك يا عسى بس تسمع",43,"ع",1,0],["وشحنة كالهلال في ياعوا","عيناه جند له وأشياع",44,"ع",1,1],["وش حدها ورقا تثنّى بتصديح","ما دام كل الناس حطْت وسايد",45,"د",1,0],["وش حداني على ليل وضباب","وقل زاد وطريقٍ اعوجي",46,"ج",2,0],["وش حيلتي والرماح مظلّله","لا حول عندي ولا عنها محال",47,"ل",1,0],["وشِحِ الوجْهَ حقوداً وكريهاً","عابثا فيها وما تخشى قتيلا",48,"ل",2,0],["وشّحتُ ظلَّكَ بالندى حين اكتوى","بالبُعدِ غصنُكَ كيف عني يُسعدُ",49,"د",1,0],["وشّحتُ من ورد الوصال قصائدي","لأعيشَ طيباً في هواكَ يُصوَّرُ",50,"ر",1,0],["وش حيلتي لو طول الليل بارد","ووش حيلتي لو قصر الوقت باعه",51,"ع",2,0],["وش حالهم حينما يطرق مسامعهم","صوت الاذان العزيز الشامخ العالي",52,"ل",2,0],["وش حيلتي لاصار هالقلب موجوع","واسم الوجع كله فعايل يدينك",53,"ك",1,0],["وش حيلتي ياصاحبي لو تناسيت","شخصٍ هويته اصبح اليوم مذبوح",54,"ح",1,0],["وش حيلتي ياجوع قاسي ومعدوم","وين الامل لا قلت عنهم توارا",55,"ر",2,0],["وش حل بالاشراف غالب وراجح","اقفو كما صيد حدته إضراه",56,"ا",2,0],["وش حيلتي لاصار فكري مجزا","وقته رماه وفرقه مثل عناز",57,"ز",1,0],["وش حيلتك يا منتهى كل شكواي","ان صار مالي غير جوده حمايه",58,"ا",3,0],["وش حيلة اللي فالكتيبه يستعد ويستريح","حسب الأوامر يجتهد مير الليالي لاعته",59,"ت",2,0],["وش حيلتي لا صرت مشدود الاعصاب","مثل الثرى لا من ترجّى السحايب",60,"ب",1,0],["وش حيلتي لا صرت بالحب ملزوم","مابي اخونك ولابي اطعن سرابك",61,"ك",1,0],["وشحوب أطلالٍ تحنّ إلى","عهدٍ بتلك الأرض منصرمِ",62,"م",1,0],["وَشُحرورِ أَيكٍ كَم تَغَنَّى بِأَلحاني","وَشَيَّدَ عِشّا من حَناني عَلَى البانِ",63,"ن",1,1]]}