{"poems":[[37,"أللشوق لما هيجتك المنازل","https://www.aldiwan.net/poem39114.html","الطويل"],[47,"نصيب عينيك من سح وتسجام","https://www.aldiwan.net/poem66640.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85377","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54756","الطويل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100913","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131217",""],[6305,"وَشَيْطانٍ يُقاسِمُني نَصِيبي !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87329&r=&rc=2",""]],"verses":[["أَلِلشَوقِ لَمّا هَيَّجَتكَ المَنازِلُ","بِحَيثُ التَقَت مِن بَينَتَينِ الغَياطِلُ",0,"ل",1,1],["أَلِلشَبيبَةِ لَمّا كانَ آخِرُها","خَلفي وَلِلشَيبِ لَمّا كانَ قُدّامي",1,"م",2,0],["أللشيخ تهدى وَهيَ ترغب في فَتى","يُسمَّى نعيماً نور خديه يسطع",2,"ع",1,0],["أَلِلشَّرْقِ سَلْوَى بِالبَيَانِ المُخَلَّدِ","إِذَا مَا غَدَا رَبُّ البَيَانِ بِلاَ غَدِ",3,"د",1,1],["أللشِّعرِ من بعدِ الرقادِ هبوبُ","فيسمعنى بعد السكوت حبيبُ",4,"ب",1,1],["أللشر أم للخير مخترعاتكم","وللحرب أم للسلم تلك العجائب",5,"ب",1,0],["أ للشيطان ِرأيٌ في قريضٍ؟","إذنْ آلَ الطبيبُ إلى الطبيب",6,"ب",1,0]]}