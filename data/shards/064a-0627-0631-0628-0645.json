ه أشكو ذلّتي","https://www.poetsgate.com/ViewPoem.aspx?id=182498",""],[5956,"فاجعُ المحبة","https://www.poetsgate.com/ViewPoem.aspx?id=182538",""],[5956,"قوافل الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=192294",""],[5956,"عالم الأطفالِ","https://www.poetsgate.com/ViewPoem.aspx?id=193155",""],[5956,"مهما اجتمعنا لا نطيق تباعداً","https://www.poetsgate.com/ViewPoem.aspx?id=193941",""],[5956,"يا ربِّ مُدَّ يديكَ لي يا ربي","https://www.poetsgate.com/ViewPoem.aspx?id=207128",""],[6093,"أدعياء الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=198902",""],[6152,"مناجاة ودعاء","https://www.poetsgate.com/ViewPoem.aspx?id=203757",""],[6202,"روحي هنالك لا هنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86727&r=&rc=28",""],[6228,"ابتهال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85970&r=&rc=7",""],[5616,"أمي ..!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1926&r=&rc=1",""]],"verses":[["يا رَبِّ مَتِّعنِي بطُولِ بَقَائِها","واجبُر بِها الأَرمَالَ والأَيتَامَا",0,"م",2,0],["يا ربّ ما حيلتي فيها وقد ذبلت","كزهرة الروض فقد الغيث أظماها",1,"ا",3,0],["يا رَبُّ مُكتَإِبٍ لَو قَد نُعيتُ لَهُ","باكٍ وَآخَرَ مَسرورٍ بِمَنعانا",2,"ن",2,0],["يا رُبَّما قُذِفَ العَدُوُّ بِعارِضٍ","فَخمِ الكَتائِبِ مُستَحيرِ الكَوكَبِ",3,"ب",1,0],["يا رُبَّ ما اِرتادَكُم رَكبٌ لِرَغبَتِهِم","فَأَحمَدوا الغَيثَ وَاِنقادوا لِرُوّادِ",4,"د",1,0],["يا رُبَّ مُعضِلَةٍ دَفَعنا بَعدَما","عَيَّ القُيونُ بِحيلَةِ المُحتالِ",5,"ل",1,0],["يارَبُّ مُضطَغِنِ الفُؤادِ لَقيتُهُ","بِطَلاقَةٍ فَسَلَلتُ مافي صَدرِهِ",6,"ر",2,0],["يا ربَّ مكرمةٍ وربَّ كريهةٍ","أضحى معيد حياتها قتَّالها",7,"ل",3,0],["يا رُبَّ معروفٍ له قيمةٌ","كُدِّرَ صافيهِ بأنْ يُطلبا",8,"ب",2,0],["يا ربِّ ما أطولَ البلاءَ وما","أكثرَ في أن بُليتُ لُوَّامي",9,"م",2,1],["يا رُبَّ مَعرَكَةٍ تَرَكَمَ نَقعُها","حَتّى اِختَفى في ظِلِّها الجَيشانِ",10,"ن",1,0],["يا رَبُّ ما أَكثَرَ ما","كَثَّرتَ عِندي نِعَمَك",11,"ك",1,0],["يا رب متروك يموت بدائه","لو عاش أقعد أمة وأقامها",12,"م",3,0],["يا رَبِّ ما حُكمُكَ ماذا تَرى","في ذَلِكَ الحُلمِ العَريضِ الطَويل",13,"ل",1,1],["يا رُبَّ مقَنعةٍ حمراءَ تَلبَسُها","سَوداءُ للَّيلِ من تركيبِها قَارُ",14,"ر",1,1],["يا رَبُّ مَن كانَ مُغتَرّاً بِناصِرِهِ","أَمسى وَأَصبَحَ في الأَجداثِ مَجدولا",15,"ل",2,0],["يا رُبَّ مُقتَصِدٍ عَن غَيرِ تَجرِبَةٍ","وَمُعتَدٍ بَعدَ تَجريبٍ وَإِحكامِ",16,"م",1,0],["يا رب ما أعجب هذي البلاد","لا ليلَ فيها كل ليلٍ صباح",17,"ح",1,1],["يا ربّ مجلس لذّةٍ شاهَدتُها","كَرْهاً وجُنْحُ الليلِ مدّ جناحَا",18,"ح",2,1],["يا رُبَّ مُصطَبِحٍ بِالبَثِّ مُغتَبِقٍ","ضُحىً وَمُشتَجِرٍ لَيلاً وَمُرتَفِقِه",19,"ق",2,0],["يا رُبَّ مَكرُمَةٍ تُجفى إِذا نَزَلَت","قَد عُرِّفَت في ذَراكَ البِرَّ وَاللَطَفا",20,"ف",2,0],["يا رُبَّ مائِسَةِ المَعاطِفِ تَزدَهي","مِن كُلِّ غُصنٍ خافِقٍ بِوِشاحِ",21,"ح",1,1],["يا ربَّ ماذا في كتابك بعدها","لِبَني المشارقِ من أذىً وعُرامِ",22,"م",1,0],["يا رَبِّ ما ذَنبُ الَّذينَ تَتابَعوا","يَستَرسِلونَ إِلى المَنونِ سِراعا",23,"ع",2,0],["يا رَبَّ مِصرَ تَوَلَّ مصرَ وَهَب لَها","شَعباً يُريدُ لَها الحَياةَ شُجاعا",23,"ع",2,0],["يا رُبَّ مُثرٍ لَو أَطاعَ إِلَهَهُ","وَأَبى الدَنايا فاتَهُ الإِثراءُ",24,"ا",2,0],["يا رُبَّ مَنزِلَ خَمّارٍ أَطَفتُ بِهِ","وَاللَيلُ حُلَّتُهُ كَالقارِ سَوداءُ",25,"ا",2,0],["يا رُبَّ مَجلِسِ فِتيانٍ سَمَوتُ لَهُ","وَاللَيلُ مُحتَبِسٌ في ثَوبِ ظَلماءِ",26,"ا",2,1],["يا رَبُّ مِن راسِبٍ فَتُهجى","شَبيهَةُ الفَقعِ بِالفَيافي",27,"ف",2,0],["يا ربّ ماليَ أمشي","على الرخام فأعثر",28,"ر",1,0],["يا ربِّ ما أشقيتني في الوجودْ","إلَّا بقلبي ليتهُ لم يكنْ",29,"ن",1,0],["يا رُبَّما نبأٌ أثارَ بوقعه","ما لا تُثيرُ مَلاحِمُ الأجنادِ",30,"د",1,0],["يا رُبَّ مَعنىً قَد اِستَنبَطتهُ فَهماً","فَقيلَ يَحفَظُ تَفسيرُ اِبن سَلامِ",31,"م",1,0],["يا رُبَّ مخترع يروح ضحيةً","للكشف عن سر من الأسرار",32,"ر",1,0],["يا رُبَّ مُلك بنته كفُّ طاغيةٍ","تحصى النجومُ، ولا تُحصى ضحاياه",33,"ا",2,0],["يا رُبَّ مُلْكٍ أسَّتَتْه قوّةٌ","عَصَفَت به في الجو هُوجُ رياح",34,"ح",1,0],["يا ربما فاتح الممالكَ فاتحٌ","بمعاهد التعليم عالية الذُّرا",35,"ر",2,0],["يا رُبَّ مفتخر علي","ك يبيت مجد ما بناه",36,"ا",2,0],["يا ربَّ مظلومٍ له","كُتبت على يدك النجاة",36,"ا",2,0],["يا رُبَّ ماءٍ وَرَدتُّ آجِنٍ","سَبيلُهُ خائفٌ جَدِيبُ",37,"ب",1,0],["يا ربّ مجلس لذّة ٍ شاهدتها","كرهاً، وجُنحُ الليل مدّ جناها",38,"ه",2,1],["يا رب ماذا في كتابك بعدها","لنبي المشارق من أذى وعرام",39,"م",1,0],["يارُبَّ مَصلوبٍ عَلَى جِذْعٍ لهُ","شَبَهُ المحبِّ إِذا رأَى أَحبابَهُ",40,"ه",1,1],["يا رب ما استخلفت يحيى عبثا","كف يجود وحسام يبتك",41,"ك",1,0],["يا ربَّ مائسةِ الأعطافُ مُخْطَفَةٍ","إذا دنا نَزْعُها فالعيشُ مُنْتَزِحُ",42,"ح",1,1],["يا رب ماذا تريد","يا رب ماذا تشاء",43,"ا",2,0],["يا رَبِّ مِن جَورِ النَوى","جُدلي فَأَنتَ الحَكَمُ",44,"م",1,0],["يَا رَبِّ مَا عُذْرِي وَقَدْ عَلِمْتُ","عَلَيْهِ صَلَّيْتُ وَقَدْ سَلَّمْتُ",45,"ت",1,0],["يا رب من كان سن هذا","فزده ضعفاً من العذاب",46,"ب",1,0],["يا رب مسرورٍ بمقتلِ مالكٍ","ولسوف يصرفه لشر محارِ",47,"ر",1,0],["يا ربِّ منهم نجِّنا واغفر لنا","إن كان منكَ النصرُ والإعزاز",48,"ز",1,0],["يا رُبَّ مالٍ لِغَيرِ مَن جَمَعَه","وَرُبَّ زَرعٍ لِغَيرِ مَن زَرَعَه",49,"ع",2,1],["يَارُبَّ مَغرورٍ بدُنياهُ ما","وَقْتٌ لهُ آخِذةٌ بَارِكَه",50,"ه",1,1],["يا رَبّ ما لَنا سِواك مَلجأ","يا مَن لَه في كُلّ هَولٍ يُلتَجا",51,"ا",1,0],["يا رَبّ ما لِلمُذنِبين راحِمٌ","سِواكَ يا مَن هوَ رَحمَن السَما",51,"ا",1,0],["يا رَبّ ما لِلخائِفين مَأمَن","سِوى حِمى حصنك يا سامي الذرى",51,"ا",1,0],["يا ربّ مكسورِ اللوا","حِظِ لا يزالُ الدهرُ كاسِر",52,"ر",1,0],["يا رَب ما زالَ الرَقيب يَسوءَني","فاِرم الرَقيب بِعاجل الضَرّاءِ",53,"ا",2,0],["يارب مامعنا عمل وكسبنا كله زلل","لكن لنافيك أمل",54,"ل",1,0],["يا رَبَّ مَعنىً بَعيد الشأوِ أَسلُكُهُ","في سلك لَفظ قَريب الفَهمِ مُختَصَرِ",55,"ر",1,0],["يا رُبَّ مبتسم بكيتُ له","ما كلُّ ثغرٍ فُضَّ للّثمِ",56,"م",1,0],["يا رَبِّ مَنْ ذا يُجيرُ مَنْ ذا","يُغِيثُ مَنْ ذَا يُعِينُ غَيْرُكْ",57,"ك",1,1],["يا رَبِّ مُنَّ لَنَا بِها","بِكَ يُرتَجَى إحْرازُها",58,"ه",2,0],["يا رُبَّ ما يُخشى وَلا يَضيرُ","شَيئاً وَقَد ضاقَت بِهِ الصُدورُ",59,"ر",1,1],["يا رُبَّ مَكرُمَةٍ أَصبَحتَ واحِدَها","أَعيَت صَناديدَ راموها فَلَم تُنَلِ",60,"ل",1,0],["يَا رُبَّ مُهْدٍ هَدِيَّةً لَطُفَتْ","قَدْرَاً وَلَكِنْ مَحَلُّهَا جَلَلُ",61,"ل",1,1],["يا رَب ما نَفعت رقىً في مدنفٍ","بِالبَهنَسا الغرّا وَلا أهناس",62,"س",1,0],["يا رَب ما نجع العِلاج وَلا هَوا","بوشٍ وَلا قوصٍ وَلا أَبناسِ",62,"س",1,0],["يا رَب مالي في الخلاص وَسيلة","إِلا نبيك طَيِّب الأَنفاس",62,"س",1,0],["يا ربّ مِنهُم فَطَهِّرْ كلَّ بَلدَتِنا","أَفشِ الرّدى فيهمُ يا ربّ وَالوتغا",63,"غ",2,0],["يا ربَّما فرسٌ إِن رمتُ أَمدَحُهُ","رَأيتُهُ لا يُساوي الباعَ من مَرسِ",64,"س",1,1],["يا ربَّ مِثلك في النساء غريرةٍ","بيضاء قد صَبَّحتُها بطلاقِ",65,"ق",1,1],["يا رب مسِّ الصاحب بن الصاحب","بعلو مرتبة وسعد راتب",66,"ب",1,1],["يا رب ما للغانيات ولامرئ","تفنى تجلّدُه إذا يتجلّدُ",67,"د",1,0],["يا رب من كل الجهات تضيقت","واشتد في كل الجهات المخرج",68,"ج",1,1],["يا ربِّ ما لي قِبَلٌ","من قبلٍ على القِبَل",69,"ل",1,0],["يا ربّ مالي غير فضلك ملجأ","يا مَن يرى ما في الضمير ويسمع",70,"ع",1,0],["يا ربِّ من بِشره لم يحوه بَشَرُ","بشره يا رب بُشرى دونها البشر",71,"ر",1,1],["يا ربِّ ميمونَ حُطها حوطَ مُقتدر","واحفَظ مُيَيمينَ حفظاً ليسَ ممنونا",72,"ن",2,0],["يا رب ما لي طبيبٌ","سواك أشكو إليه",73,"ي",2,1],["يا رب ما حيلتي قد قل مصطبري","أفي الربيع يغيب الوردُ عن بصري",74,"ر",2,1],["يا رب ما بال المدامع حالفت","حرقي عليَّ كأنها من جمره",75,"ر",2,0],["يا رب ما لي ما خلوتُ بسلوةٍ","وتخال ذات الخال أني خالي",76,"ل",2,0],["يا رب ماسفرت لتص","لح شعرها يوم السفر",77,"ر",1,0],["يا رب ما عملي بنار صبابةٍ","تزداد بالدمع الهتون تسعُّرا",78,"ر",2,0],["يا رب منك لعله ان يأتني","مدد عظيم يغتني ويكن لكا",79,"ك",2,0],["يا رب مصر بك استجار ضعيفها","في عبرة تذري الدموع سجالا",80,"ل",2,0],["يا رُبَّ مَضْحَكَةٍ تَبَجَّسَ ماؤُها","من حَرِّ جَمْرِ مَغائِظٍ تَتَضَرَّمُ",81,"م",1,0],["يا ربِّ ما لي شفيعٌ أرتجيه سوى","مولىً شفاعتُهُ كَنزٌ ومُذَّخَرُ",82,"ر",1,0],["يا رب ما طال زمان الصبا","كأنه طيف سرى وانهمك",83,"ك",1,0],["يا رب ما لي على نار الهوى جلد","وقد بليت بقاسي القلب تياه",84,"ه",1,0],["يا رب مثقلة تنوء بحملها","تسقي البلاد بوابل غيداق",85,"ق",1,1],["يا رب ما أنا من","لا ولا الفساد",86,"د",1,0],["يا رَبِّ من وافاك أَحْوَجُ بائس",