15.html","عموديه"],[462,"يا من لابيض كل جفن اسود","https://www.aldiwan.net/poem3536.html","عموديه"],[462,"حكمت بلوعتك الظباء الغيد","https://www.aldiwan.net/poem3597.html","عموديه"],[463,"يا صبر أيوب","https://www.aldiwan.net/poem36227.html","عموديه"],[466,"يوم أغر من الزمان أنيق","https://www.aldiwan.net/poem59817.html","الكامل"],[475,"أرقت من بارق بالجزع لماع","https://www.aldiwan.net/poem15184.html","البسيط"],[475,"أعرفت من داء الصبابة شافيا","https://www.aldiwan.net/poem15185.html","الكامل"],[475,"برق تألق من تهامه","https://www.aldiwan.net/poem15205.html","مجزوء الكامل"],[475,"ذنبي إلى البيض ذنب غير مغتفر","https://www.aldiwan.net/poem15246.html","البسيط"],[475,"قد خان أهل الهوى قل لي بمن أثق","https://www.aldiwan.net/poem15254.html","البسيط"],[475,"حييت من دمن ومن أطلال","https://www.aldiwan.net/poem15352.html","الكامل"],[477,"الموت درس وعزرائيل ملقيه","https://www.aldiwan.net/poem36869.html","البسيط"],[477,"عاقبتني بالصد وهو عصيب","https://www.aldiwan.net/poem36947.html","الكامل"],[477,"في اليم عمت وفي الدموع أعوم","https://www.aldiwan.net/poem36994.html","الكامل"],[498,"مر حبيبي ووقف","https://www.aldiwan.net/poem37955.html","مجزوء الرجز"],[498,"ما هفهفتني نسمة الربيع","https://www.aldiwan.net/poem37979.html","السريع"],[512,"هذا الحمى يا فتى فانزل بحومته","https://www.aldiwan.net/poem20832.html","البسيط"],[513,"لو كان ينفع أن تجود بمائها","https://www.aldiwan.net/poem11998.html","الكامل"],[513,"من كان لا يعشق الأجياد والحدقا","https://www.aldiwan.net/poem12182.html","البسيط"],[513,"ما هاج مزنة دمعه المترقرق","https://www.aldiwan.net/poem12188.html","الكامل"],[522,"ما زال نور محمد متنقلا","https://www.aldiwan.net/poem13285.html","الكامل"],[522,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[527,"قل لعلي نالا","https://www.aldiwan.net/poem37249.html","مجزوء الرجز"],[536,"قدك يا جميل","https://www.aldiwan.net/poem47914.html","عموديه"],[556,"بدت الحقيقة من خلال ستورها","https://www.aldiwan.net/poem34461.html","الكامل"],[556,"ما هذه عندنا الأجسام والصور","https://www.aldiwan.net/poem34482.html","البسيط"],[556,"لك قد رمت وجودا فأبى","https://www.aldiwan.net/poem34921.html","الرمل"],[562,"مضى زمان ولم توفوا وعودكموا","https://www.aldiwan.net/poem866.html",""],[562,"حر تربى مستقلاً جاهداً","https://www.aldiwan.net/poem902.html",""],[565,"عرش العلا منهدم مؤتفك","https://www.aldiwan.net/poem69561.html","الرجز"],[573,"نسيت في أسماء حتى اسمي","https://www.aldiwan.net/poem3012.html","السريع"],[573,"قدمت بالنصر وبالمغنم","https://www.aldiwan.net/poem3014.html","السريع"],[573,"ما هزة الغصن إلا ملك هزته","https://www.aldiwan.net/poem3094.html","البسيط"]],"verses":[["ما هَمُّ مَن حُرِمَ الثَراءَ إِذا سَما","وَأَحَظُّ مِن شَرَفٍ وَمِن إِعظامِ",0,"م",1,0],["ما هَيَّجَتني العِدا إِلّا وَكُنتُ لَها","سَماءَ كُلِّ جَوادٍ أَرضُهُ القُلَلُ",1,"ل",1,0],["ما هَكَذا مَن كانَ يَزعُمُ أَنَّهُ","عَينُ الصَديقِ وَلا كَذا مَن صافى",2,"ف",2,0],["ما هَزَّ فَرعَكُمُ يَأسٌ وَلا طَمَعٌ","وَلا مَرى دَرَّكُم لينٌ وَلا عَنَفُ",3,"ف",1,0],["ما هاجَ مِن ذي طَرَبٍ مِخماصِ","لَيلُ أَبي العَوامِ وَالقِلاصِ",4,"ص",1,1],["ما هُوَ إِنعامٌ وَلَكِنَّهُ","ما خَلَعَ الغَيثُ عَلى الزَهرِ",5,"ر",1,0],["ما هَيبَةُ السَيفِ بِالغُمودِ وَلا","أَهيَبَ مِن أَن تَراهُ مَسلوبا",6,"ب",2,0],["ما هَبّ ريحُ الصّرِّ في بُقْعَةٍ","وارْتَفَعَ الثّلْجُ على مَرْجِ",7,"ج",1,0],["ما هانَ خَطبُكَ وَالأَخلاقُ والِهَةٌ","تَبكي عَلَيكَ إِذا خَطبُ اِمرِئٍ هانا",8,"ن",2,0],["ما هَدَّ عَزمَ القادِري","نَ بِمِصرَ إِلّا قَولُ باكِر",9,"ر",1,0],["ما هو الحزم في إتقاء المهاوي","ما هو العزم في إرتقاء المعالي",10,"ل",2,0],["مَا هَذِهِ الدُّنْيَا بِمَأْمُونَةٍ","لا تَفْتَرِرْ بِالسَّاعَةِ السَّانِحَهُ",11,"ح",2,1],["مَا هَذِهِ الدُّنْيَا وَمَا أَوْطَارُنَا","عِنْدَ الزَّمَانِ وَإِنَّهُ لَزَمَانُ",12,"ن",1,0],["ما هاجَ عَينَيكَ مِنَ الأَطلالِ","المُزمِناتِ بَعدَكَ البَوالي",13,"ل",2,1],["ماه فن يا رقيعا","غير نمدح ونهنّي",14,"ي",1,0],["ما هبَ خفاق النسيم مع السحرْ","إلا وقد شاق النفوس وقد سحرْ",15,"ر",1,0],["ما هكذا يا قوم ما هكذا","يأمرنا الأسلام في المسلمه",16,"م",2,0],["ما هَوَّمَ القَومُ مُذ شَدّوا رِحالَهُمُ","إِلّا غِشاشاً لَدى أَعضادِها اليُسُرِ",17,"ر",1,0],["ما هاجَ شَوقَكَ مِن رُسومِ دِيارِ","بِلِوى عُنَيِّقَ أَو بِصُلبِ مَطارِ",18,"ر",1,1],["ما هاجَ شَوقَكَ مِن عُهودِ رُسومِ","بادَت مَعارِفُها بِذي القَيصومِ",19,"م",1,1],["ما هاجَ حَسّانَ رُسومُ المَقام","وَمَظعَنُ الحَيِّ وَمَبنى الخِيام",20,"م",1,1],["ما هذه فأجبتهم","صدقات سرٍّ والسلام",21,"م",1,0],["ما هكذا يرعى الصديقُ صديقَهُ","ورفيقَهُ وشقيقَهُ ونسيبَهُ",22,"ب",2,0],["ما هنَاتٌ تعرَّضتْ لك فَلَّتْ","منك شُؤبوبَ سابحٍ وَثَّابِ",23,"ب",1,0],["ما هذه الوقفات فيما تَرْتَئي","ولك البصيرةُ والزِّماعُ الأرْشَد",24,"د",1,0],["ما هازِباء مَصيدٌ في فنائكُمُ","مثل السبائك أشبارٌ وأفتارُ",25,"ر",1,0],["ما هَنَةٌ عمَّت بني آدمٍ","يعير الناس بها الناسا",26,"س",2,0],["ما هذه النُّفَخُ التي أغفلْتَها","يا من يفوقُ بطبِّه بُقراطا",27,"ط",2,0],["ما هكذا يفعل الأريبُ من ال","ناس إذا كان ناقصاً فنما",28,"م",2,0],["ما همَّ بالدينِ والدنيا فنالَهُما","إلا قريعُكُمُ يا آل همَّامِ",29,"م",1,0],["ما هُمَا للْوَليِّ إلا كغِمْدَيْ","ن لديه كصارم صمصام",30,"م",1,0],["ما هُوَ إلا نعْمةٌ من النِّعمْ","ما أحسن الشكل وما أذكى النَّسمْ",31,"م",1,0],["ما هكذا بكَ كان حي","نَ بدأتَني بالوصل ظنِّي",32,"ن",2,0],["ما هَجَرناكِ إِذ هَجَرناكِ طَوعاً","لا تَظُنّي العُقوقَ في الأَبناءِ",33,"ا",2,0],["ما هَذِهِ البيضُ الَّتي أَبصَرتُها","في لِمَّتي إِلّا اللَيالي السودا",34,"د",2,0],["ما هُوَ الشِعرُ إِنَّني ما رَأَي","تُ اِثنَينِ إِلّا وَفيهِ يَختَصِمانِ",35,"ن",1,0],["ما هَذِهِ لِلبَينِ أَوَّلَةٌ","ذا الخَدُّ مِنهُ مُعَوَّدُ اللَطمِ",36,"م",1,0],["ما هَذِهِ أَوَّلَ ما مَرَّ بي","كَم مِثلِها مَرَّ عَلى راسي",37,"ي",1,0],["ما هَذِهِ شِيَمُ الحَرا","ئِرِ لا وَلا شِيَمُ القِحابِ",38,"ب",1,0],["مَا هذه الدُّنيا وهذا الوَرَى","وذلكَ الأُفْقُ وتِلْكَ النُّجُومْ",39,"م",1,0],["ما هذه الدُّنيا الكريهةُ ويلَها","حَقّتْ عليها لَعْنَةُ الأحقابِ",40,"ب",1,0],["ما هاجَ شَوقكَ مِن بِلَى الأَطلالِ","بِالبَرقِ مَرَّ صَبَا وَمرَّ شَمَالِ",41,"ل",1,1],["ما هذه الارض قد قا","مت فوقها الشاهقات",42,"ت",1,0],["ما هذه السدم البي","ض حشوها النيرات",42,"ت",1,0],["ما هذه الحرب في زىّ السلام لكم","إلا صليبيّة والكل صاليها",43,"ي",3,0],["ما هو عام الكف لو انصفوا","لكنه بالحق عام القفا",44,"ف",2,0],["ما هذه الكف التي قد كفت","ونالها من نال بالراحة",45,"ح",2,1],["مأهولة أحشاؤها","معمورة منها المحاسر",46,"ر",1,0],["ما هيج البسفور مثلك شاعرا","بين الطبيعة فيه والتاريخ",47,"خ",1,1],["ما همتُ في روض الحمى","إلا واسكرني شذاك",48,"ك",1,0],["ما هَذِهِ الغُرَفُ الزَواهِرُ كَالضُحى","الشامِخاتُ كَأَنَّها الأَعلامُ",49,"م",1,0],["ما هَكَذا الدُنيا وَلَكِن نُقلَةٌ","دَمعُ القَريرِ وَعَبرَةُ المُلتاعِ",50,"ع",1,0],["ما هَيكَلُ الهَرَمِ الجيزِيِّ مِن ذَهَبٍ","في العَينِ أَزيَنَ مِن بُنيانِها الحالي",51,"ل",2,0],["ماهٌ ومِهرٌ وكِيوانٌ وكاتبه","والمشتري وأناهيدٌ وبَهرامُ",52,"م",1,0],["ما هو الشعر إن غدا بهلوان","يتسلى برقصه الخلفاء",53,"ا",2,0],["ما هو الشعر.. حين يصبح فأر","كسرة الخبز –همه والغذاء",53,"ا",2,0],["ما هاجَ عَهْدَ الشَّوقِ إلا مَعْهَدٌ","رامَتْ بقلبي في الهَوى آرامُه",54,"م",2,0],["ما هَذِهِ الدُنيا وَطالِبُها","إِلّا عَناءً وَهوَ لا يَدري",55,"ي",1,1],["ما هَبَّ أَو دَبَّ يَفنى لا بَقاءَ لَهُ","وَالبَرُّ وَالبَحرُ وَالأَقطارُ وَالأُفُقُ",56,"ق",1,0],["ما هانَتِ الدُنيا عَلى","أَحَدٍ كَما هانَت عَلَيكا",57,"ك",2,0],["ما هَوينا مَغنى الدِيارِ وَلَكِن","بِالمَعاني نَهيمُ لا بِالمَغاني",58,"ي",1,0],["ما هَبَّتِ الريحُ إِلّا هَزَّني الطَرَبُ","إِذ كانَ لِلقَلبِ في مَرِّ الصَبا أَرَبُ",59,"ب",1,1],["ما هاته النُسُمُ التي هبَّت على","وجهِ الغدير عليلةَ الأنفاسِ",60,"س",1,0],["ما هاته النارُ التي قد أوهنت","جَلَدِي وهدَّت قوتي ومراسي",60,"ي",1,0],["ما هي إلا شُعَلٌ فانيه","نصيبها مثل شعاع النهار",61,"ر",1,0],["ما هذه الدنيا التي اقتربت","فيها المنى والظلّ والثمر",62,"ر",1,0],["ما هذه الفتكات في مهجاتنا","هَل كانَ عِندَكِ قَتلهنَّ حلالا",63,"ل",2,0],["ما هَذِهِ القُربى الَّتي لا تُصطَفى","ما هَذِهِ الرَحِمُ الَّتي لا تُرحَمُ",64,"م",1,0],["ما هو العزيز النهاية","ولو بداية مدوَّنهْ",65,"ه",1,0],["ما هَكَذا أَحبَبتَ قَبلَهُمُ","مِمَّن يُجَدُّ وِصالُهُ أَحَدا",66,"د",2,0],["ما هذه الأربابُ ما لِعبادها","جَهلوه ربّاً واحداً قَيُّوما",67,"م",2,0],["ماهاجَني شَجَنٌ بِالشامِ أَطلُبُهُ","وَإِنَّما هاجَني الإِسلامُ وَالأَدَبُ",68,"ب",1,0],["ما هذه المُثُلُ التي لا تَنتهِي","هذا هو المَثلُ الأبَرُّ الأطيب",69,"ب",1,0],["ما هُنا إِنَّها رُسومُ دُموعٍ","وَهُنا آه آنها قبلاتُ",70,"ت",1,0],["ما هاجَ قَلبَكَ يَومَ العَرجِ مِن ظُعُنِ","جَدَّدنَ بِالرَيطِ وَالسِيجانِ مِن شَجَني",71,"ن",2,1],["ما هَكَذا رَميُ البَشَر","صارَ حَصى الأَرضِ مَدَر",72,"ر",1,0],["ما هَمَّ يَخْضِبُ شَيْبَهُ مُتَشَوِّقاً","زَمَنَ الصِّبا إلّا اتَّقَى التَّدْلِيسا",73,"س",2,0],["ما هَزَّتِ القُضبَ النَّسِيمُ وَرَجَّعَتْ","وَرقَاءُ فِي فَنَنِ الأَراكِ هَدِيلا",74,"ل",2,0],["ما هاجهُ أنْ كُنتَ لم تَنْحِتْ لهُ","ظُفُراً وما خَطبُ الفريص المُفرَص",75,"ص",1,0],["ما هَوىً إِلّا لَهُ سَبَبُ","يَبتَدي مِنهُ وَيَنشَعِبُ",76,"ب",1,1],["ما هَبَّتِ الريحُ مِن تِلقاءِ أَرضِكُمُ","إِلّا وَجَدتُ لَها بَرداً عَلى الكَبِدِ",77,"د",1,0],["ما هَزَّ سَيفَكَ تيهٌ بَل مُقَلَّدُهُ","لَمّا أَنارَ لَهُ التَأثيرُ وَالأُثُرُ",78,"ر",1,0],["ما هاجَ لِلحازِمِ الماضي سِوى حَزَنٍ","عودٌ يُجاوِبُهُ في الشَربِ مِزمارُ",79,"ر",1,0],["ما هِنَةُ الجِسمِ هِيَ الرِجلُ وَال","خَلخالُ في المَنزِلِ عِندَ القَدَم",80,"م",1,0],["ما هاجَني البارِقُ مِن بارِقٍ","يَوماً وَلا هَزَّ لِهَزّانِ",81,"ن",1,1],["ما هُوَ القصد وَالمزار بَعيد","يا تُرى من زيارة الحسناء",82,"ا",2,0],["ما هو إلاّ حيةٌ بزقُها","بالسمِّ هذا المغربيُّ الزَغَل",83,"ل",1,0],["ما هو إلَّا آدميٌّ شقي","سمَّوْهُ بين الناسِ بالشاعرِ",84,"ر",1,0],["ما هو إلا صوتُكِ المرسلُ","وروحُكِ المستعبَدُ المرهَقُ",84,"ق",1,0],["ما هوَ إلَّا كومةٌ من هباء","تمحقهُ اللمسةُ من غضبتِكْ",84,"ك",1,0],["ما هي إلَّا لحظاتٌ قصارْ","تَمُرُّ مِثْلَ الومضِ في عينهِ",84,"ه",1,0],["ما هي إلا صرخاتُ الفزعْ","وصيحةُ المقتولِ والقاتلِ",84,"ل",1,0],["ما هَمَّ في الرّوْعِ بها ذائِقٌ","إلا انْثَنى عنها بفِي أهْتَم",85,"م",1,0],["ما هَزَأوا فيها بِمُستَحِقِّ","وَلا أَرادوا أَولِياءَ الحَقِّ",86,"ق",1,0],["مَا هِلالُ السَّماءِ مَا الظَّبْيُ مَا الْوَرْ","دُ جَنِيَّاً ما الْغُصْنُ إِذْ يَتَهَدَّى",87,"د",2,0],["مَا هَذِهِ الآ