{"poems":[[53,"هي سلوة ذهبت بكل غرام","https://www.aldiwan.net/poem29797.html","الكامل"],[53,"حب العلى شغل قلب ما له شغل","https://www.aldiwan.net/poem29895.html","البسيط"],[53,"جرعتني غصصا ورحت مسلما","https://www.aldiwan.net/poem29966.html","الكامل"],[53,"بالجد لا بالمساعي يبلغ الشرف","https://www.aldiwan.net/poem29972.html","البسيط"],[53,"ما هاج من ذي طرب مخماص","https://www.aldiwan.net/poem30179.html","الرجز"],[53,"قرت عيون المجد والفخر","https://www.aldiwan.net/poem30478.html","السريع"],[53,"كان قضاء الإله مكتوبا","https://www.aldiwan.net/poem30741.html","المنسرح"],[77,"قل للأشوني ولا تحتشم","https://www.aldiwan.net/poem36657.html","السريع"],[86,"أما أمين فقد ذقنا لمصرعه","https://www.aldiwan.net/poem10377.html","البسيط"],[86,"قعدت شعوب الشرق","https://www.aldiwan.net/poem10860.html","مجزوء الكامل"],[93,"يا لعهد الصبا تقضي وشيكا","https://www.aldiwan.net/poem9159.html","الخفيف"],[93,"ما هذه الدنيا بمأمونة","https://www.aldiwan.net/poem11147.html","السريع"],[93,"فجع القريض وقد ثوى حسان","https://www.aldiwan.net/poem11217.html","البسيط"],[30,"ما هاج عينيك من الأطلال","https://www.aldiwan.net/poem29544.html","الرجز"],[83,"ذيب نرهن ذا الغفاره","https://www.aldiwan.net/poem54202.html","مجزوء الرمل"],[83,"نفسي الفداء لشادن مهما خطر","https://www.aldiwan.net/poem54307.html","الكامل"],[88,"لم أر بين الناس ذا مظلمه","https://www.aldiwan.net/poem44840.html","السريع"],[27,"لجت أمامة في لومي وما علمت","https://www.aldiwan.net/poem5769.html","البسيط"],[27,"ما هاج شوقك من رسوم ديار","https://www.aldiwan.net/poem5785.html","الكامل"],[27,"ما هاج شوقك من عهود رسوم","https://www.aldiwan.net/poem6009.html","الكامل"],[23,"ما هاج حسان رسوم المقام","https://www.aldiwan.net/poem21255.html","السريع"],[72,"يا سيدي نفحات جو","https://www.aldiwan.net/poem20003.html","مجزوء الكامل"],[51,"لي صاحب قد كنت آمل نفعه","https://www.aldiwan.net/poem8496.html","الكامل"],[51,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[51,"مالي أسل من القراب وأغمد","https://www.aldiwan.net/poem61901.html","الكامل"],[51,"أبلغ فتى آل بشر بل مؤملهم","https://www.aldiwan.net/poem62001.html","البسيط"],[51,"حاجيت فضلا وهو ذو فطنة","https://www.aldiwan.net/poem64660.html","السريع"],[51,"هبت لوهب ريح سوء عاصف","https://www.aldiwan.net/poem65016.html","الكامل"],[51,"لم يبكني رسم منزل طسما","https://www.aldiwan.net/poem66036.html","المنسرح"],[51,"اسعد بعيد أخي نسك وإسلام","https://www.aldiwan.net/poem66052.html","البسيط"],[51,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[51,"للنرجس الفضل برغم من رغم","https://www.aldiwan.net/poem66369.html","الطويل"],[51,"يا مانعي باليأس من","https://www.aldiwan.net/poem66701.html","مجزوء الكامل"],[91,"مهبط الوحي مطلع الأنبياء","https://www.aldiwan.net/poem8724.html","عموديه"],[91,"ليت الذي خلق العيون السودا","https://www.aldiwan.net/poem8816.html","عموديه"],[91,"ما لقلبي يلج من الخفقان","https://www.aldiwan.net/poem62761.html","عموديه"],[70,"يا من أفارقه على رغمي","https://www.aldiwan.net/poem42709.html","الكامل"],[70,"وصاحب أصبح لي لائما","https://www.aldiwan.net/poem42857.html","السريع"],[70,"كم ذا التصاغر والتصابي","https://www.aldiwan.net/poem43006.html","مجزوء الكامل"],[92,"لو كانت الأيام في قبضتي","https://www.aldiwan.net/poem38924.html","السريع"],[92,"في الليل ناديت الكواكب ساخطا","https://www.aldiwan.net/poem38967.html","الكامل"],[32,"ما هاج شوقك من بلى الأطلال","https://www.aldiwan.net/poem27704.html","الكامل"],[89,"هاتوا اذكروا لي هاتوا","https://www.aldiwan.net/poem44906.html","المجتث"],[85,"عش للخلافة ترضاها وترضيها","https://www.aldiwan.net/poem7528.html","البسيط"],[85,"سموه عام الكف وهو الذي","https://www.aldiwan.net/poem7538.html","السريع"],[85,"ما هذه الكف التي قد كفت","https://www.aldiwan.net/poem7562.html","السريع"],[85,"لمن المساكن كالمقابر","https://www.aldiwan.net/poem7768.html","مجزوء الكامل"],[85,"ما هيج البسفور مثلك شاعرا","https://www.aldiwan.net/poem7778.html","الكامل"],[85,"مضنى وليس به حراك","https://www.aldiwan.net/poem7884.html","مجزوء الكامل"],[85,"تاج البلاد تحية وسلام","https://www.aldiwan.net/poem8106.html","الكامل"],[85,"اخترت يوم الهول يوم وداع","https://www.aldiwan.net/poem62860.html","الكامل"],[85,"قف بالممالك وانظر دولة المال","https://www.aldiwan.net/poem63752.html","البسيط"],[62,"نجومنا سبعة في الكتب قد وضعت","https://www.aldiwan.net/poem52171.html","البسيط"],[99,"إفادة في محكمة الشعر","https://www.aldiwan.net/poem6630.html","عموديه"],[61,"إن عاده بعد السلو غرامه","https://www.aldiwan.net/poem51427.html","الكامل"],[58,"ما هذه الدنيا وطالبها","https://www.aldiwan.net/poem31058.html","السريع"],[49,"الرفق يبلغ ما لا يبلغ الخرق","https://www.aldiwan.net/poem62187.html","الكامل"],[49,"الله هون عندك الدنيا","https://www.aldiwan.net/poem64257.html","مجزوء الكامل"],[66,"إن ثنت عنكم الخطوب عناني","https://www.aldiwan.net/poem40972.html","الخفيف"],[66,"ما هبت الريح إلا هزني الطرب","https://www.aldiwan.net/poem40984.html","البسيط"],[97,"أنت التي بعثت إلي خيالها","https://www.aldiwan.net/poem24414.html","الكامل"],[97,"جلست يوما حين حل المساء","https://www.aldiwan.net/poem24794.html","السريع"],[97,"مرت حياتي دون أمنية","https://www.aldiwan.net/poem24923.html","أحذ الكامل"],[80,"نهت الكواشح عنه والعذالا","https://www.aldiwan.net/poem31323.html","الكامل"],[44,"أرض مصردة وأخرى تثجم منها","https://www.aldiwan.net/poem30363.html","الكامل"],[69,"أذاه شامل وشرو","https://www.aldiwan.net/poem29163.html","عموديه"],[31,"إن الخليط مودعوك غدا","https://www.aldiwan.net/poem42570.html","الكامل"],[105,"الكون أشرق نضرة ونعيما","https://www.aldiwan.net/poem42064.html","الكامل"],[105,"يا غاديا ببريد الشام ينتحب","https://www.aldiwan.net/poem43094.html","الكامل"],[105,"هو مرتمى الأبطال مالك دونه","https://www.aldiwan.net/poem44209.html","الكامل"],[102,"اغفري لي إذا اتهمتك بالغد","https://www.aldiwan.net/poem33102.html","الخفيف"],[40,"ما هاج قلبك يوم العرج من ظعن","https://www.aldiwan.net/poem42333.html","البسيط"],[52,"لا صيد إلا بوتر","https://www.aldiwan.net/poem26974.html","مجزوء الرجز"],[67,"إن تحي آمالي برؤية عيسى","https://www.aldiwan.net/poem18073.html","الكامل"],[67,"وسلن حبقوق المصرح باسمه","https://www.aldiwan.net/poem18080.html","الكامل"],[75,"أحبب به قنصا إلى متقنص","https://www.aldiwan.net/poem69068.html","الكامل"],[48,"ما هوى إلا له سبب","https://www.aldiwan.net/poem10784.html","المديد"],[50,"يا حب طال تمنينا زيارتكم","https://www.aldiwan.net/poem63933.html","البسيط"],[46,"منازل المجد من سكانها دثر","https://www.aldiwan.net/poem22540.html","البسيط"],[46,"سم الهلال إذا عاينته قمرا","https://www.aldiwan.net/poem22544.html","البسيط"],[46,"روحي كالنار أذابت دمي","https://www.aldiwan.net/poem23431.html","السريع"],[46,"ما هاجني البارق من بارق","https://www.aldiwan.net/poem23536.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[69,"","https://poetry.dctabudhabi.ae/diwan/poem/56828","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16681","السريع"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/19310","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42580","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55024","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141915","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54297","الكامل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/205861","الكامل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/205801","الخفيف"],[106,"في ذكرى الكواكبي","https://www.poetsgate.com/ViewPoem.aspx?id=179601",""],[98,"أرق الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=12939",""],[90,"وفى الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=179021",""],[45,"عهدي بربعك للغواني معهداً","https://www.poetsgate.com/ViewPoem.aspx?id=31299",""],[99,"لا تحبيني","https://www.poetsgate.com/ViewPoem.aspx?id=196733",""],[99,"إفادة في محكمة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=581",""],[51,"أبلغْ فتى آل بشر بل مؤمَّلهُمْ","https://www.poetsgate.com/ViewPoem.aspx?id=28587",""]],"verses":[["ما هَمُّ مَن حُرِمَ الثَراءَ إِذا سَما","وَأَحَظُّ مِن شَرَفٍ وَمِن إِعظامِ",0,"م",1,0],["ما هَيَّجَتني العِدا إِلّا وَكُنتُ لَها","سَماءَ كُلِّ جَوادٍ أَرضُهُ القُلَلُ",1,"ل",1,0],["ما هَكَذا مَن كانَ يَزعُمُ أَنَّهُ","عَينُ الصَديقِ وَلا كَذا مَن صافى",2,"ف",2,0],["ما هَزَّ فَرعَكُمُ يَأسٌ وَلا طَمَعٌ","وَلا مَرى دَرَّكُم لينٌ وَلا عَنَفُ",3,"ف",1,0],["ما هاجَ مِن ذي طَرَبٍ مِخماصِ","لَيلُ أَبي العَوامِ وَالقِلاصِ",4,"ص",1,1],["ما هُوَ إِنعامٌ وَلَكِنَّهُ","ما خَلَعَ الغَيثُ عَلى الزَهرِ",5,"ر",1,0],["ما هَيبَةُ السَيفِ بِالغُمودِ وَلا","أَهيَبَ مِن أَن تَراهُ مَسلوبا",6,"ب",2,0],["ما هَبّ ريحُ الصّرِّ في بُقْعَةٍ","وارْتَفَعَ الثّلْجُ على مَرْجِ",7,"ج",1,0],["ما هانَ خَطبُكَ وَالأَخلاقُ والِهَةٌ","تَبكي عَلَيكَ إِذا خَطبُ اِمرِئٍ هانا",8,"ن",2,0],["ما هَدَّ عَزمَ القادِري","نَ بِمِصرَ إِلّا قَولُ باكِر",9,"ر",1,0],["ما هو الحزم في إتقاء المهاوي","ما هو العزم في إرتقاء المعالي",10,"ل",2,0],["مَا هَذِهِ الدُّنْيَا بِمَأْمُونَةٍ","لا تَفْتَرِرْ بِالسَّاعَةِ السَّانِحَهُ",11,"ح",2,1],["مَا هَذِهِ الدُّنْيَا وَمَا أَوْطَارُنَا","عِنْدَ الزَّمَانِ وَإِنَّهُ لَزَمَانُ",12,"ن",1,0],["ما هاجَ عَينَيكَ مِنَ الأَطلالِ","المُزمِناتِ بَعدَكَ البَوالي",13,"ل",2,1],["ماه فن يا رقيعا","غير نمدح ونهنّي",14,"ي",1,0],["ما هبَ خفاق النسيم مع السحرْ","إلا وقد شاق النفوس وقد سحرْ",15,"ر",1,0],["ما هكذا يا قوم ما هكذا","يأمرنا الأسلام في المسلمه",16,"م",2,0],["ما هَوَّمَ القَومُ مُذ شَدّوا رِحالَهُمُ","إِلّا غِشاشاً لَدى أَعضادِها اليُسُرِ",17,"ر",1,0],["ما هاجَ شَوقَكَ مِن رُسومِ دِيارِ","بِلِوى عُنَيِّقَ أَو بِصُلبِ مَطارِ",18,"ر",1,1],["ما هاجَ شَوقَكَ مِن عُهودِ رُسومِ","بادَت مَعارِفُها بِذي القَيصومِ",19,"م",1,1],["ما هاجَ حَسّانَ رُسومُ المَقام","وَمَظعَنُ الحَيِّ وَمَبنى الخِيام",20,"م",1,1],["ما هذه فأجبتهم","صدقات سرٍّ والسلام",21,"م",1,0],["ما هكذا يرعى الصديقُ صديقَهُ","ورفيقَهُ وشقيقَهُ ونسيبَهُ",22,"ب",2,0],["ما هنَاتٌ تعرَّضتْ لك فَلَّتْ","منك شُؤبوبَ سابحٍ وَثَّابِ",23,"ب",1,0],["ما هذه الوقفات فيما تَرْتَئي","ولك البصيرةُ والزِّماعُ الأرْشَد",24,"د",1,0],["ما هازِباء مَصيدٌ في فنائكُمُ","مثل السبائك أشبارٌ وأفتارُ",25,"ر",1,0],["ما هَنَةٌ عمَّت بني آدمٍ","يعير الناس بها الناسا",26,"س",2,0],["ما هذه النُّفَخُ التي أغفلْتَها","يا من يفوقُ بطبِّه بُقراطا",27,"ط",2,0],["ما هكذا يفعل الأريبُ من ال","ناس إذا كان ناقصاً فنما",28,"م",2,0],["ما همَّ بالدينِ والدنيا فنالَهُما","إلا قريعُكُمُ يا آل همَّامِ",29,"م",1,0],["ما هُمَا للْوَليِّ إلا كغِمْدَيْ","ن لديه كصارم صمصام",30,"م",1,0],["ما هُوَ إلا نعْمةٌ من النِّعمْ","ما أحسن الشكل وما أذكى النَّسمْ",31,"م",1,0],["ما هكذا بكَ كان حي","نَ بدأتَني بالوصل ظنِّي",32,"ن",2,0],["ما هَجَرناكِ إِذ هَجَرناكِ طَوعاً","لا تَظُنّي العُقوقَ في الأَبناءِ",33,"ا",2,0],["ما هَذِهِ البيضُ الَّتي أَبصَرتُها","في لِمَّتي إِلّا اللَيالي السودا",34,"د",2,0],["ما هُوَ الشِعرُ إِنَّني ما رَأَي","تُ اِثنَينِ إِلّا وَفيهِ يَختَصِمانِ",35,"ن",1,0],["ما هَذِهِ لِلبَينِ أَوَّلَةٌ","ذا الخَدُّ مِنهُ مُعَوَّدُ اللَطمِ",36,"م",1,0],["ما هَذِهِ أَوَّلَ ما مَرَّ بي","كَم مِثلِها مَرَّ عَلى راسي",37,"ي",1,0],["ما هَذِهِ شِيَمُ الحَرا","ئِرِ لا وَلا شِيَمُ القِحابِ",38,"ب",1,0],["مَا هذه الدُّنيا وهذا الوَرَى","وذلكَ الأُفْقُ وتِلْكَ النُّجُومْ",39,"م",1,0],["ما هذه الدُّنيا الكريهةُ ويلَها","حَقّتْ عليها لَعْنَةُ الأحقابِ",40,"ب",1,0],["ما هاجَ شَوقكَ مِن بِلَى الأَطلالِ","بِالبَرقِ مَرَّ صَبَا وَمرَّ شَمَالِ",41,"ل",1,1],["ما هذه الارض قد قا","مت فوقها الشاهقات",42,"ت",1,0],["ما هذه السدم البي","ض حشوها النيرات",42,"ت",1,0],["ما هذه الحرب في زىّ السلام لكم","إلا صليبيّة والكل صاليها",43,"ي",3,0],["ما هو عام الكف لو انصفوا","لكنه بالحق عام القفا",44,"ف",2,0],["ما هذه الكف التي قد كفت","ونالها من نال بالراحة",45,"ح",2,1],["مأهولة أحشاؤها","معمورة منها المحاسر",46,"ر",1,0],["ما هيج البسفور مثلك شاعرا","بين الطبيعة فيه والتاريخ",47,"خ",1,1],["ما همتُ في روض الحمى","إلا واسكرني شذاك",48,"ك",1,0],["ما هَذِهِ الغُرَفُ الزَواهِرُ كَالضُحى","الشامِخاتُ كَأَنَّها الأَعلامُ",49,"م",1,0],["ما هَكَذا الدُنيا وَلَكِن نُقلَةٌ","دَمعُ القَريرِ وَعَبرَةُ المُلتاعِ",50,"ع",1,0],["ما هَيكَلُ الهَرَمِ الجيزِيِّ مِن ذَهَبٍ","في العَينِ أَزيَنَ مِن بُنيانِها الحالي",51,