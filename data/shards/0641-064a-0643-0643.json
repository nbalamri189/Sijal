{"poems":[[99,"هذه الكعبة كنا طائفيها","https://www.aldiwan.net/poem24799.html","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54202","الخفيف"],[580,"أوحشني الأوانس","https://www.aldiwan.net/poem3056.html","مجزوء الرجز"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101610","الخفيف"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114568","الرمل"]],"verses":[["فيك كف الله عنى غربتي","ورسا رحلي على أرض الوطن",0,"ن",1,0],["فِيكَ كَنْزٌ لَمْ تَحْوِ أَرْضُ الْفَرَاعِينِ","لَهُ بَيْنَ لاَبَتَيْهَا مَثيلاَ",1,"ل",2,0],["فيكَ كَلامي مُصْحَبٌ","وفي سِوَاك شَامِسْ",2,"س",1,0],["فيك كنزٌ لم تعط إلا قليلاً","منه والحسن لا يزال يلح",3,"ح",1,0],["فيكَ كُلُّ ما اشتهى","عاشقٌ يا مُشتَهَى",4,"ه",2,0]]}