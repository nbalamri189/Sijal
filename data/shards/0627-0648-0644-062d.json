{"poems":[[53,"أنجز الوعد إن خير مواعي","https://www.aldiwan.net/poem65788.html","الخفيف"],[45,"ما سدكت علة بمورود","https://www.aldiwan.net/poem9527.html","المنسرح"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54659","السريع"],[119,"بالله ضع قدميك فوق مهاجري","https://www.aldiwan.net/poem40866.html","عموديه"],[280,"طلعت عليك مع المساء صباحا","https://www.aldiwan.net/poem25602.html","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79843","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74065","المتدارك"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127170","السريع"],[4134,"","https://poetry.dctabudhabi.ae/diwan/poem/100565","الكامل"],[4816,"سابق الوقت","https://www.poetsgate.com/ViewPoem.aspx?id=8469",""]],"verses":[["أو لحقْتَ المبرّزينَ فأصبحْ","تَ قليلاً إلى العُلا سُبَّاقُك",0,"ك",1,0],["أَوَّلُ حَرفٍ مِنِ اِسمِهِ كَتَبَت","سَنابِكُ الخَيلِ في الجَلاميدِ",1,"د",1,0],["أَوَّلُ حَرْفٍ مِنْ حُرُوفِ اسْمِهَا","أَوَّلُ حَرْفٍ قَدْ تَعَلَّمْتِ",2,"ت",1,0],["اولح باستار الكرى لي مؤنسا","فلقد قنعت من الوصال بذاكا",3,"ك",2,0],["أو لُحْن مَرْضَى لا شِفاءَ لِسُقْمِها","فَالآن لما صحَّ رُحْن صَحاحا",4,"ح",2,0],["أَو لحاها قسّيسها لأتت تو","قد فيها ناقوسَها والصليبا",5,"ب",2,0],["أَو لِحاقِدٍ","كَيفَ شئت ذمّ",6,"م",1,0],["أو لحظها النرجس من فرحة","يجول فيه للندى أدمع",7,"ع",1,0],["أو لحظ عينك أم كنائن أسهمٍ","وشذا رضابك أم شميم العنبر",8,"ر",1,0],["اول حياته انورتله وبهتله","وتاليه اسقته علاجيم وسموم",9,"م",1,0]]}