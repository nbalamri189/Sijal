,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"]],"verses":[["بِمَولِدِ غَرّاءَ أَعطَيتَها","بُدُوَّ الأَهِلَّةِ بَعدَ السِرارِ",0,"ر",1,0],["بِمَولِدٍ صَقَلَ الآباءُ حِليَتَهُ","فَطَوَّقَ المَجدُ أَعناقَ المَواليدِ",1,"د",1,0],["بمَوقِفٍ لا تَرى فيه سِوى دَنِفٍ","دامي الجُفونِ طليحِ الشّوقِ مَحزونِ",2,"ن",1,0],["بِمَوقِفِ ذُلّي دونَ عِزَّتِكَ العُظمى","بِمَخفِيِّ سِرٍّ لا أُحيطُ بِهِ علِما",3,"م",2,1],["بمَوْلِدِكَ اهْتزّ الوجودُ وأشْرَقَتْ","قُصورٌ ببُصْرى ضاءَتِ الهضْبَ والوَهْدا",4,"د",2,0],["بِمُؤْتَمَرِ النِّسَاءِ جلَوْتِ وَجْهاً","يَقِرُّ بِنَظْرَةٍ مِنْهُ المُحيِّي",5,"ي",1,0],["بِمَوتِ النَبِيِّ وَقَتلِ الوَصِيِّ","وَذَبحِ الحُسَينِ وَسَمِّ الحَسَن",6,"ن",1,0],["بِمَوجٍ كَالجِبالِ فَإِن تَرُمهُ","تُغَرَّق ثُمَّ يَرمِ بِكَ الجَنابا",7,"ب",2,0],["بموسى أستجر وسليمان عذْ","فنعمَ الوزيرُ ونعمَ الأمير",8,"ر",1,1],["بمُونِقة الرُّواد حُوٍّ تِلاعُها","تُراعي بها الأُدمانُ آمنَةَ السَّربِ",9,"ب",1,0],["بمَوَدَّتِيكَ وحُرمتي بِكَ أنَّها","سَبَقَتْ قَرَابَتَها بِوَجْهٍ ما قُبحْ",10,"ح",1,0],["بِموْلِيَّةٍ خضراء يُنْغَم وسْطَها","ويُهْدَلُ في أرجَائها ويُهَدْهَدُ",11,"د",1,0],["بموليةٍ يأوي القطا في جنابها","إلى كالئِ المرعى دميثِ المفاحص",12,"ص",1,0],["بموالاةٍ لكم صادقةٍ","سلكت مسلك روح في بدن",13,"ن",1,0],["بِمَولودِهِم صَمتُ اللِسانِ كَغَيرِهِ","وَلَكِنَّ في أَعطافِهِ مَنطِقَ الفَضلِ",14,"ل",1,0],["بمؤيدِ المُلْكِ انجلتْ غُمَمٌ","أنْحَت عليَّ وأقلعتْ كُرَبُ",15,"ب",1,0],["بِمُوَفَّقٍ لِلصالِحاتِ مُيَسَّرٍ","وَمُحَبَّبٍ في الصالِحينَ مُؤَمَّلِ",16,"ل",1,0],["بمواهب ضاعفن من أمواله","ومذاكرات زدن في آدابه",17,"ه",1,0],["بمَولودٍ يَراه اللهُ لَيثاً","وغَيثاً يَستَهِلُّ علَى البَرايا",18,"ا",3,0],["بِمُؤنِسَتي في الرُبوع","وَفاجِعَتي بِالهُجوع",19,"ع",1,0],["بمؤلَّلاتٍ تستديرُ كَأَنّها","أقلامُ مُبتدعِ الكتابةِ ماشقِ",20,"ق",1,0],["بموتِ عبّود ابنِ جبرٍ","قَدْ أيس القلبُ منْ أبيهِ",21,"ه",1,1],["بِموسى إِذا ماشِئتَ سُكرِيَ غَنِّ لي","وَأَدهِق