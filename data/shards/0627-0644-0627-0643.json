75156",""],[5186,"أرقت وهاجتني وقد هجع الركب","https://www.poetsgate.com/ViewPoem.aspx?id=156457",""],[5206,"مَرثاة الصديق الغِشْرِيْ","https://www.poetsgate.com/ViewPoem.aspx?id=187432",""],[5246,"ألا كل من في هذه الدار يُفقدُ","https://www.poetsgate.com/ViewPoem.aspx?id=187089",""],[5277,"لثمُ الأمس","https://www.poetsgate.com/ViewPoem.aspx?id=187699",""],[5277,"أمام وجهك","https://www.poetsgate.com/ViewPoem.aspx?id=188096",""],[5277,"روح خناسيّة","https://www.poetsgate.com/ViewPoem.aspx?id=191836",""],[5277,"أمّي..وتنتهي الأسماءُ","https://www.poetsgate.com/ViewPoem.aspx?id=213398",""],[592,"الحق شمس لأهل الحق قد بانا","https://www.poetsgate.com/ViewPoem.aspx?id=128820",""],[5376,"في الغوطة الغراء دمع نازف","https://www.poetsgate.com/ViewPoem.aspx?id=197288",""],[5411,"مُتَغَرّبٌ نِسرين بَوحي","https://www.poetsgate.com/ViewPoem.aspx?id=190992",""],[1149,"أَلاَ قُلْ لعبد اللهِ ، واخصُصْ مُحمّداً","https://www.poetsgate.com/ViewPoem.aspx?id=22294",""],[5431,"ولانور إلا الله عنك يُدافعُ","https://www.poetsgate.com/ViewPoem.aspx?id=198629",""],[5431,"خيانة الأوراق...","https://www.poetsgate.com/ViewPoem.aspx?id=202740",""],[5431,"من شعر الحكمة ...","https://www.poetsgate.com/ViewPoem.aspx?id=211087",""],[5436,"العى بنا الشوق يابغداد","https://www.poetsgate.com/ViewPoem.aspx?id=185987",""],[5463,"قصه كذوبه","https://www.poetsgate.com/ViewPoem.aspx?id=25529",""],[5536,"رساله الى امرأه مسافره","https://www.poetsgate.com/ViewPoem.aspx?id=22807",""],[5536,"رسالة إلى إمرأة مسافرة..!!","https://www.poetsgate.com/ViewPoem.aspx?id=19885",""],[5546,"أرخ لها زمامها والأنسعا","https://www.poetsgate.com/ViewPoem.aspx?id=181006",""],[5561,"ومضة شوق","https://www.poetsgate.com/ViewPoem.aspx?id=193806",""],[5582,"أَلا كُلُّ عَيْشٍ صَفْوُهُ يَتَكَدَّرُ","https://www.poetsgate.com/ViewPoem.aspx?id=187148",""],[5582,"حَلِيفُ غَرامٍ عَزَّ مِنْهُ اصْطِبارُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=63515",""],[5593,"ألا هل قائل مني لخمره","https://www.poetsgate.com/ViewPoem.aspx?id=181058",""],[5612,"موْلايَ في ذُلّي إليْكَ تَحَرُّري","https://www.poetsgate.com/ViewPoem.aspx?id=179434",""],[243,"مرئية الآلهة","https://www.poetsgate.com/ViewPoem.aspx?id=50562",""],[5720,"أيها العالَم","https://www.poetsgate.com/ViewPoem.aspx?id=200139",""],[5720,"الجَائحَة","https://www.poetsgate.com/ViewPoem.aspx?id=211296",""],[5725,"ودق السما","https://www.poetsgate.com/ViewPoem.aspx?id=215842",""],[5751,"إيقاعُ اُنثى","https://www.poetsgate.com/ViewPoem.aspx?id=214769",""],[5818,"نفَس الرحمان","https://www.poetsgate.com/ViewPoem.aspx?id=182713",""],[5879,"كل النساء","https://www.poetsgate.com/ViewPoem.aspx?id=215463",""],[5956,"العمق","https://www.poetsgate.com/ViewPoem.aspx?id=183933",""],[5957,"يا حبيَ الخالدَ","https://www.poetsgate.com/ViewPoem.aspx?id=12540",""],[6102,"معلمة الموسيقى ..","https://www.poetsgate.com/ViewPoem.aspx?id=185060",""],[6127,"البطولة يصنعها فذٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=215168",""],[6144,"الغش والغلا","https://www.poetsgate.com/ViewPoem.aspx?id=13802",""],[6228,"أمّة المجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85973&r=&rc=10",""],[6312,"البؤرُ المتحركةُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82949&r=&rc=4",""],[5064,"نرجِسَةُ المعَانِي الزُّجاجِيَّة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87539&r=&rc=34",""]],"verses":[["أَلا كَتَبَت تَنهى وَتَأَمُرُ بِالهَجرِ","فَقُلتُ لَها يالَيتَ قَلبَكِ في صَدري",0,"ر",2,1],["أَلا كُلُّ شَيءٍ كانَ أَوهُوَكائِنٌ","يَكونُ بِعِلمٍ سابِقٍ وَكِتابِ",1,"ب",1,0],["إِلّا كَخارِجَةَ المُكَلِّفِ نَفسَهُ","وَاِبنَي قَبيصَةَ أَن أَغيبَ وَيَشهَدا",2,"د",2,0],["إِلّا كَوَجهِكِ لَمّا","أَضاءَ تَحتَ النِقابِ",3,"ب",1,0],["أَلا كُلُّ رَجوى في سِواكَ عُلالَةٌ","وَكُلُّ مَديحٍ لَم يَكُن فيكَ باطِلُ",4,"ل",1,0],["إِلّا كَشَفتِ اليَومَ عَنّي ما بي","جاءَ مَشيبي وَمَضى شَبابي",5,"ب",2,0],["ألاَ كلُّ من صلّى وضحّى ومن دعا","ومدَّ يدَيْهِ ضارعاً متوسِّلا",6,"ل",2,0],["الآكِلونَ خَبيثَ الزادِ وَحدَهُمُ","وَالنازِلونَ إِذا واراهُمُ الخَمَرُ",7,"ر",1,0],["إِلّا كَشَيءٍ عاقَهُ العَوائِقُ","وَأَنتَ حاسٍ حَسوَةً فَذائِقُ",8,"ق",1,0],["أَلا كُلُّ شَيءٍ ما خَلا اللَهَ باطِلُ","وَكُلُّ نَعيمٍ لا مَحالَةَ زائِلُ",9,"ل",1,0],["إلاّ كبيت الله في فضله","على بيوت الله والكل بيت",10,"ت",1,0],["إلا كأنَّ اللَّه ذل","لَلَ عامداً لهمُ صِعابهْ",11,"ب",2,0],["ألا كان كالغربال يَنْفِي زُؤانَهُ","وما كان من قَصْرٍ ويحتبسُ الحَبَّا",12,"ب",2,0],["ألا كان مثل القِدْرِ تنفي غُثاءها","وتَقْنَى عُرَاقَ اللحمِ والمرقَ العذبا",12,"ب",2,0],["ألا كلٌ حيٍّ ما خلا الله مَيِّتٌ","وإن زعمَ التأميلَ ذو الإفك ما زعمْ",13,"م",1,0],["ألا كم أذلَّ الدهرُ من متعززٍ","وكم زمَّ من أنف حَمِيٍّ وكم خطمْ",13,"م",1,0],["الآكِلونَ خَبيثَ الزادِ وَحدَهُمُ","وَالسائِلونَ بِظَهرِ الغَيبِ ما الخَبَرُ",14,"ر",1,0],["الأَكثَرينَ حَصىً وَالأَطيَبينَ ثَرىً","وَالأَحمَدينَ قِرىً في شِدَّةِ اللِزَبِ",15,"ب",1,0],["الآكِلينَ اللَوايا دونَ ضَيفِهِمُ","وَالقِدرُ مَخبوأَةٌ مِنها أَثافيها",16,"ي",3,0],["الأَكثَرين مُسَوّداً وَمُملَّكا","وَمُتَوّجا في سالِف الأَعصارِ",17,"ر",1,1],["أَلا كَرَمٌ يُنعِشُ السمهريّ","وَيُشفيه مِن كُلّ داءِ دَفينِ",18,"ن",1,0],["أَلا كُلُّ ذَنبٍ لِلَّيالي لِأَجلِهِ","سَدَلنا عَلَيهِ صَفحَنا وَالتَناسِيا",19,"ي",2,0],["أَلا كُلُّ ماشِيَةِ الخَيزَلى","فِدا كُلُّ ماشِيَةِ الهَيذَبى",20,"ا",1,1],["أَلا كُلُّ سَمحٍ غَيرَكَ اليَومَ باطِلٌ","وَكُلُّ مَديحٍ في سِواكَ مُضَيَّعٌ",21,"ع",1,0],["أَلا كُلُّ بَيتٍ باهِلِيٍّ أَمامَهُ","حِمارٌ وَعِدلا نِحيِ سَمنٍ وَرايِبِ",22,"ب",1,0],["أُلاكَ وَعيرِ أُمَّكَ لَو تَراهُم","بِعَينِكَ ما اِستَطَعتَ لَهُم خِطابا",23,"ب",2,0],["أُلاكَ لِدارِمٍ وَبَناتُ عَوفٍ","لِخَيراتٍ وَأَكرَمِ أُمَّهاتِ",24,"ت",1,0],["أَلا كُلُّ أَمرٍ يا اِبنَ مَروانَ ضائِعٌ","إِذا لَم تَكُن في رَحَتَيكَ مَرائِرُه",25,"ر",2,0],["أَلا كُلُّ شَيءٍ في يَدِ اللَهِ بالِغٌ","لَهُ أَجَلٌ عَن يَومِهِ لا يُحَوَّلُ",26,"ل",1,0],["أَلا كُلُّ نَفسٍ سَوفَ يَأتي وَراءَها","إِلى يَومِ يَلقاها الكِتابُ المُؤَجَّلُ",26,"ل",1,0],["الأَكثَرونَ إِذا يُعَدُّ حَصاهُمُ","وَالأَكرَمونَ إِذا يُعَدُّ الأَوَّلُ",27,"ل",1,0],["أَلا كَيفَ البَقاءُ لِباهِلِيٍّ","هَوى بَينَ الفَرَزدَقِ وَالجَحيمِ",28,"م",1,1],["أُلاكَ أَخِلائي إِذا ما ذَكَرتُهُم","بَكَيتُ بِعَينٍ ماءُ عَبرَتِها كُحلي",29,"ل",2,0],["أَلا كُلُّ نَفسٍ طالَ في الغَيِّ عُمرُها","تَموتُ وَإِن كانَت عَنِ المَوتِ حادَتِ",30,"ت",1,0],["أَلا كُلُّ مَولودٍ فَلِلمَوتِ يولَدُ","وَلَستُ أَرى حَياً لِشَيءٍ يُخَلَّدُ",31,"د",1,1],["أَلا كُلُّ شَيءٍ زالَ فَاللَهُ بَعدَهُ","كَما كُلُّ شَيءٍ كانَ فَاللَهُ قَبلُهُ",32,"ل",2,0],["أَلا كُلُّ شَيءٍ ما سِوى اللَهِ زائِلٌ","أَلا كُلُّ ذي نَسلٍ يَموتُ وَنَسلُهُ",32,"ل",2,0],["أَلا كُلُّ مَخلوقٍ يَصيرُ إِلى البِلى","أَلا إِنَّ يَومَ المَيتِ لِلحَيِّ مِثلُهُ",32,"ل",2,0],["ألا كلُّ حسنٍ في البريةِ خادمٌ","لسلطانَةِ العينينِ والجيدِ والقدِّ",33,"د",1,0],["ألا كمْ تُسْمِعُ الزمن العتابا","تخاطبُهُ ولا يدري الخطابا",34,"ب",2,1],["إِلّا كِتاباً لَنا قَد كُنتَ جُدتَ بِهِ","فُضَّ الخِتامُ وَفَحوى لَفظِهِ زورُ",35,"ر",1,0],["أُلاكَ زُهرُ النُجومِ لَيسَ كَمَن","أَمسى دَعِيّاً في الشِعرِ وَالنَسَبِ",36,"ب",1,0],["الآكلين بلحمي سُمَّ أغرِبَةٍ","وغُصَّةً في حلاقين الشواهين",37,"ن",1,0],["ألاَ كُلُ يَومٍ في جَنَابِكَ مَوسِمٌ","جَدِيدٌ وَلَكِن أنتَ لِلضَّيفِ قَابِلُ",38,"ل",1,0],["ألاَ كُلُّ مُلكٍ لَم تَسُسهُ مُضَيَّعٌ","وَكُلُّ إحتجَاجٍ لَم يَقُم بكَ بَاطِلُ",38,"ل",1,0],["الأَكاليل لَم تَزَل غَضة الزَهر","وَلَم تَنقطع أَغاني الغَواني",39,"ن",2,0],["أَلا كُلُ شَيءٍ هالِكٌ غَيرَ رَبِّنا","وَلِلَّهِ مِيراثُ الَّذي كانَ فانِيا",40,"ا",1,0],["أَلا كُلُّ أَرماحٍ قِصارٍ أَذِلَّةٍ","فِداءٌ لِأَرماحٍ رُكِزنَ عَلى الغَمرِ",41,"ر",1,1],["الأكثرينَ تخمُّطاً وتكبُّراً","ما لم تُهَزّ أسِنّةٌ ونُصُول",42,"ل",1,0],["ألا كلُّ عَيشٍ دونَهُ فمحرَّمٌ","وكلُّ حريمٍ بعده فمضيَّع",43,"ع",1,0],["ألا كلُّ آتٍ قريبُ المَدى","وكلُّ حياةٍ إلى مُنْتَهَى",44,"ا",1,1],["أَلا كُلِّ بَصرِيٍّ يَرى أَنَّما العُلى","مُكَمَّهَةٌ سُحقٌ لَهُنَّ جَرينُ",45,"ن",1,1],["أُلاكَ الأُلى شَقّوا العَمى بِسُيوفِهِم","عَنِ الغَيِّ حَتّى أَبصَرَ الحَقَّ طالِبُه",46,"ب",2,0],["إِلاَّ كَمُعرِضٍ المُحسِّرِ بَكرَهُ","عَمداً يُسَبَّبُني عَلى الظُّلمِ",47,"م",1,0],["إِلا كَساهُ الذُّلَّ والصَّغارا","وعَمَّهُ وأَهلهُ دَمارا",48,"ر",2,0],["إلا كمثل ذرة","حَقيرة في بلقع",49,"ع",1,0],["إلا كحبة رمل","مدفوعة بالرياحِ",50,"ح",1,0],["ألا كلّ ماشية الخيزلى","فدى كلّ ماشية الهيدبى",51,"ا",1,1],["ألا كم تألَّقنَ فوق الغصون","زواهرَ في روعةٍ واتقادْ",52,"د",1,0],["ألا كلُّ ما قالَ الرُّواةُ وأَنْشدوا","بها غيرَ ما قالَ السَّلُوليُّ بَهْرَجُ",53,"ج",1,1],["الأكرمين نسبا مطهرا","الأرفعين حسبا ومظهرا",54,"ر",2,0],["إِلاَّ كَمَا تُجْلَى وُرُو","دُ الرَّوْضِ أَوْ تُجْنَى شِهَادُهْ",55,"د",2,0],["إلاك يا ضهر الشوير فأنت من","حدث الليالى والخلود بموثق",56,"ق",1,0],["الأكف اللذان من شغف الغيد","فحدد منهن للحق نصلا",57,"ل",2,0],["أَلا كُلُّ ما هُوَ آتٍ قَريبُ","وَلِلأَرضِ مِن كُلِّ حَيٍّ نَصيبُ",58,"ب",1,1],["الآكلون قلوبهم حقدا على","ترف القصور وثروة البخلاء",59,"ا",2,0],["الآكلون جراح الشعب تخبرنا","ثيابهم أنّهم آلات أشرار",60,"ر",1,0],["ألا كل ماشية الخيزلى","فدا كل ماشية الهيدبى",61,"ا",1,1],["الأكرمين أهل العقل والحماقه","الجيّدين مزبّنين الجلوّه",62,"و",2,0],["ألا كُلُّ أمْرٍ يا ابنَ مَرْوَانَ ضَائِعٌ","إذا لمْ تَكُنْ في رَاحَتَيكَ مَرَائِرُهْ",63,"ر",2,0],["الآكلينَ اللّوايا دونَ ضيفهمُ","والقدرُ مخبوءة ٌ منها أثافيها",64,"ي",3,0],["ألا كان كالغربال يُنفي زُؤانهُ","وما كان من قِصْرى ويحتبس الحَبَّا",65,"ب",2,0],["إلا كل حي في يد الموت حاصل","فماذا بكاء الفاقدين يفيد",66,"د",1,0],["ألا كُلُّ مَاشِيَةِ الخَيْزَلَى","فِدَى كلِّ ماشِيَةِ الهَيْذَبَى",67,"ا",1,1],["ألاَ كلُّ ذِي مُلْكٍ سِواكم سَبَهْلَلُ","وكل مَديحٍ غير مدحىَ ضائعُ",68,"ع",1,0],["أُلاَكَ النَّاسُ إِنَّ لَهم حُلُوماً","رَوَاسِىَ إِذ تُحَلُّ حُبَ الحُلُومِ",69,"م",1,0],["أُلاَكَ أَخِلاَّئِى الذينَ جِوَارُهُم","بِهِ المَرءُ عَن أهلٍ وَعَن وَطَنٍ يَسلُو",70,"ل",2,0],["أُلاَكَ النَّاسُ بالقُربِ استَبَدُّوا","وقَد جَفَوُا الضلالةَ والهَوَاءَ",71,"ا",2,0],["ألا كم جرت طلقا بنا تحت غيهبٍ","وخاضت بحار الآلِ من شدّة الجوى",72,"و",2,0],["الآكلينَ صريحَ قومِهما","أكلَ الحُبارى بُرعُم الرُطبِ",73,"ب",1,0],["إلاّ كشعرِ صَديقي الْ","فيّاضِ فاشدُد بهِ وغنِّ",74,"ن",1,0],["إلا كما راضي المحبّ إذا","هجرَ الحبيب بأيسرِ الولع",75,"ع",1,0],["ألا كتبت ك