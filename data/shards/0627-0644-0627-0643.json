54,"د",1,1],["ألا كلّ خال سوف يحبو ابن أخته","وأنبئت خالي قد حبا بالقصائد",155,"د",1,1],["ألا كاملٌ في الناس يبدو به نقصي","فقد غرّني بالنفس بين الورى فحصي",156,"ي",1,1],["ألا كل الذي عدد","ت قد أصبح مقرونا",157,"ن",2,0],["ألا كلُّ علم إن أردت عزيزهُ","يعودُ ذليلاً طول فهمك لا يُكدي",158,"د",2,1],["ألا كم تَيَّمت مصر فريدا","وودَّ القلبُ فيها أن يعودا",159,"د",2,1],["ألا كل شيء له آفة","تغير من طبعه والصور",160,"ر",1,0],["إِلاكَ يا بَحرَ السَماحِ فَجُد بِما","قَسَمَ الإِلَهُ الحَقُّ فَهوَ العادِلُ",161,"ل",1,0],["الاكمل الشهم الهمام الفرد","ومعه عبد الرحيم السعدي",162,"ي",1,0],["اِلاَّ كَسَتْهُ الجيادَ تخبِطه","خَبطاً تُشطي أديمه زيمَا",163,"م",2,0],["ألا كلُّ بُرءٍ بعدَ رَامة مُسقِمي","وكلُّ نعيمٍ لا أقولُ لهُ دُمِ",164,"م",1,1],["أَلا كريمٌ يَذودُ عنه كما","يذودُ عن أَهِله وعن نَشبِهْ",165,"ب",2,0],["أُلاكَ القاتلاتُ بغيرِ جُرمٍ","وما يقتلْنَ غيرَ فتىً حُسامِ",166,"م",1,0],["أَلا كَيفَ أُخفي الحبَّ وَالدمعُ قَد وَشى","عَلى الوجدِ وَاللاحي بهِ اليَومَ قَد دَرى",167,"ر",2,0],["أَلا كَيفَ لا وَهو ابنُ من طارَ صيتُهُ","فَاِضحى فَريد العَصرِ وَهو زَعيمُ",168,"م",1,0],["أَلا كَيفَ اخفي الحُب وَالدَمعُ قدوشي","عَلَيهِ فَاِضحى وَهو في الناسِ شائِع",169,"ع",1,0],["أَلا كَيفَ اِنجو وَاللحاظُ صَقيلُها","غَدا عامِلاً بِالظُلمِ منهُ عَلى نَحري",170,"ي",1,0],["أَلا كف عَن وردٍ لِتِلكَ المَناهِلِ","فَقُلتُ لَهم وَالحُب بِالوجدِ قاتِلي",171,"ي",1,0],["أَلا كَيفَ لا وَاليَومَ قاضي قُضاتُها","اخو الفَضلِ عَبد اللَهِ من جل راقِيا",172,"ي",2,0],["أَلا كَيفَ لا وَهي الَّتي قَد تَزَيَّنَت","بِحُسن صِفاتٍ فيكَ جَلت عَن الحَصر",173,"ر",1,0],["إِلا كَفورٌ لِلهدَى متنكِّبٌ","أَو جاهلٌ في غيِّهِ متردِّدُ",174,"د",1,0],["الاَّك اذ انت ربي","وفي الخلاص محبي",175,"ب",2,0],["أَلا كُلُّ صَعبٍ دون ذا الخَطبِ هَيِّنٌ","وكل أجيجٍ دونَ هذا اللَظَى بَردُ",176,"د",1,0],["الأَكرمونَ الأمجدونَ الأفضلو","نَ الأكملونَ الأشرفونَ المُجَّدُ",177,"د",1,0],["إِلّا كَذا خلساً وَآوِنَةً","حَذَرَ العِقابِ فَهُم عَلى ذُعرِ",178,"ر",1,0],["أَلا كُلُّ الصحاب صحابُ سُوءٍ","فَحاذر من يَشوقُ من الصحابِ",179,"ب",1,1],["أَلا كُلُّ حسنٍ شانُه النأيُ وَالأَسى","وَها كُل غُصنٍ عاد شبهَ هَشيم",180,"م",1,0],["أَلا كلُّ شيءٍ للأنامِ مُحَبَّبٌ","إِليَّ بغيضٌ والحبيبُ حَبيبُ",181,"ب",1,1],["إلا كشفتَ الضرَّ عن شيخٍ لنا","لكَ مدَّ كَفَّ ضراعَةٍ يا شافِ",182,"ف",1,0],["أَلا كُلُّ ما هَبَّت بِهِ الريحُ ذاهِبُ","وَكُلُّ فَتىً بَعدَ السَلامَةِ شاجِبُ",183,"ب",1,1],["ألاكَم يَغَصُّ خَطِيبُ المَرامِد","حَكِيمُهُمُ الهِمُّ فِيلا المُجَاهِد",184,"د",1,0],["ألا كل شَيءٍ جاءَ مِن غَيرِ أَهلِهِ","قَبيحُ وَمَمقوت لَدى كُل عاقِل",185,"ل",1,1],["إلا كلهم نجب كرام ثوابت","لدى الروع حتى إن أصغرهم طود",186,"د",1,0],["الأَكبَرِ المَولى الحُلاحَلِ مُصطَفى","قَيدَ النَواظِرِ وَالثَنا وَالأَعيُنا",187,"ن",2,0],["إِلَّا كَمِثلي وَإِن جَلَّت رَزِيتُّها","إِذا أَزعَجَ البَينُ مَن أَهواهُ فَاِنزَعَجا",188,"ج",2,0],["ألا كلُّ شيء ما خلا اللهَ هالكٌ","وما عاش مملوكٌ عليها ومالكُ",189,"ك",1,1],["ألا كلنا راع ومسئولٌ فاعلمن","ألا فتفقَّد للورى بالرعاية",190,"ه",1,0],["ألا كلُّنا دَاءُ الجنونِ برأسِه","سوى السادةِ الزهَّادِ من كل أشهمِ",191,"م",1,0],["ألا كلُّ طاعاتِ الإله حميدةٌ","وليسَ كَبذلِ النفسِ طوعاً لخالقِ",192,"ق",1,0],["إلا كنيران قومي فوق أعلام","لي دارة تنزل العليا بجانبها",193,"ه",2,0],["ألا كلُّ حىٍّ للحياة مجانبُ","وكلُّ فتىً كاسَ المنية شاربُ",194,"ب",1,1],["ألا كم دجى ليلٌ على الكون مطبقٌ","وكم ديس تاريخٌ وكم ساد جاهلُ",195,"ل",1,0],["ألا كم تجرّعنا مرارة هولها","وكم قُرعتْ للنائبات طبولُ",196,"ل",1,0],["ألا كمْ جميل العلم ِ هلَّ هلالُهُ","وكمْ مِنْ قبيح ِ الجهل ِ ضلَّ ضلالُهُ",197,"ل",2,1],["إِلَّاكِ يا مَن هَرِمْنا وهْيَ بَعْدُ على","جُفُونِها يَستَحِمُّ البَحرُ والسُّفُنُ",198,"ن",1,0],["إلاك يا منقذَ الإنسانِ من ظُلَمٍ","بالنور منكم دجاها سوف تنزجر",199,"ر",1,0],["إلاكِ يَرْجوها وَيَطْلبُ وِدَّها","وَيَموتُ إنْ يوماً تَمَلُّ وَتَرْحَلُ",200,"ل",1,0],["الا كم قد طربنا بالعرائي","وتحيي حفلنا كل الاناجم",201,"م",1,0],["الا كم من كبار الروس في رجوى طواريقه","تجيله من مراسيل الكبار وهو بغمراته",202,"ت",2,0],["الا كم علّم العملاق مثْله","وصار بحده العملاق رزنا",203,"ن",2,0],["الا كم عاثين يبغا حمانا","اشوف عدانا جونا حايفينا",204,"ن",2,0],["الا كم ضيّعت ليث ٍ طموحه","غدى باسبابها من الغاديينا",204,"ن",2,0],["الاكيد انه ما حد يعيش عمرين","لكن ممكن يعيش عمر محتاس",205,"س",1,0],["إِلَّاكِ فَاحْتَرِسي انْثِيالَ مَدارِنا","وَتَكَوَّري قَبْلَ انْطِفا مَنْ كانَنا",206,"ن",2,0],["إلّاكَ ما عادَ يحييني وأحسَبُني","نسيتُ إسمي وماالعنوانُ يختلفُ",207,"ف",1,0],["أَلَا كَمْ سَقَيْتِ الْقَلْبَ مِنْ لَذَّةٍ سُكْرَا","وَجَرَّعْتِ قَلْبِي الْوَجْدَ وَالْجَهْدَ وَالْهَجْرَا",208,"ر",2,1],["ألا كم ترامت بالس بمسافر","وكم حافر أدميت يا دير حافر",209,"ر",1,1],["إِلَّاكِ أَنْتِ وَمَنْ أَنْتِ سِوَاكِ لَهُ","فَوْقَ العِتَاْبِ عَنَاْءَاً دَمْعُهُ لُوَمُ",210,"م",1,0],["إِلّاكِ يَا عَيْنَ الْهَوَى لَا تَغْمُضِي","إِيَّاكِ لَنْ أَقْوَى عَلَى مَا يَصْطَلِي",211,"ل",2,0],["إلاك يا ربي فحُبُّكَ أولٌ","فارحمْ عُبيدك واعفُ يا حنّانُ",212,"ن",1,0],["\"ألا كذبوا من قال \"\"ربوا لتتعبوا\"\"\"","وقولوا لهم ربوا فخيراتكم تربو",213,"ب",2,0],["أَلَا كُلُّ حَيٍّ غَيرَ ذِي العَرْشِ مَيِّتٌ","وعَنْ عَالَمِ الأدْنَى فلا بُدَّ مَزْعُوجُ",214,"ج",1,0],["ألا كل من في هذه الدار يُفقدُ","سوى الله والنعما بها سوف تَنفدُ",215,"د",1,1],["إلاك يا نبض قلبي والعراق دماً","وخافقي من بروق العصف يرتعدُ",216,"د",1,0],["إلاك يا نبض قلبي والعراق دماً","وخافقي من بروق الوجدِ يرتعدُ",217,"د",1,0],["إلاكِ يا نبضَ قلبي والفراقُ دمٌ","وخافقي من بروقِ العصفِ يرتعدُ",218,"د",1,0],["إلاّكِ يا أمّ طهري والعراقُ دمٌ","وخافقي من بروق العصفِ يرتعدُ",219,"د",1,0],["إلا كرامته لا غير فانزجروا","عن مهيع الكفر إذ قد كان طغيانا",220,"ن",2,0],["إلاك ما قصدوا الأنام بدعوة","إلاك ما نصف الخلائق ناصف",221,"ف",1,0],["إلاّكَ أنْتَ وَكَمْ جَرَحْتَ مَشاعري!","لِيَظَلّ بي شِعْرٌ حَزينٌ حائِسُ",222,"س",1,0],["إلا كخبرونا والحوادث جمّة","ٌ وما الناس إلا بين ناج وهالك",223,"ك",1,0],["ألا كلّ مادون الإله ضلالة","سرابٌ هي الأهواء حين تُشايعُ",224,"ع",1,0],["إلاك أنت ويعوي الوجدُ مفترسا","كم يستباحُ بشرع الغاب عشاقُ!",225,"ق",1,0],["ألا كلّ نفس دون ردعٍ تُخادع","وكلٌّ لتسويف الحماقات خاضعُ",226,"ع",1,0],["الاك ياملتقى كل القلوب هوى","ماابعد الوصل حين الوصل ينذلق",227,"ق",1,0],["الاك يانخلة بالقلب باسقة","اشجت بلابلها مامرها قلق",227,"ق",1,0],["الأكاذيب ف\" علاقة حُبْ \" آخرها قطاعه","تنتهي اب \" واهمين(ن) \" إبتدوا قصه كذوبه.. ! !",228,"ب",2,1],["إلاك أنتي وأنتي أعظم زورق","قذفت به الأمواج فوق بحوري",229,"ر",2,0],["إلاك ِأنتِ وأنتِ أعظم زورقٍ","قذفت به ِالأمواجُ فوقَ بُحوري",230,"ر",2,0],["الأكثرين في المساعي عددا","والأطولين في الضراب أذرعا",231,"ع",2,0],["إلاّك أنت تحامي أمّة ً نُسبتْ","إليكَ إيمانها التوحيد والصبر",232,"ر",1,0],["أَلا كُلُّ عَيْشٍ صَفْوُهُ يَتَكَدَّرُ","وَكُلُّ نَعِيمٍ حالُهُ يَتَغَيَّرُ",233,"ر",1,1],["أَلا كُلُّ جارٍ سَوْفَ يَلْقَى مُفاجَأً","كَما قَدْ لَقِي مِنْ حادِثِ الدَّهْرِ جارُهُ",234,"ر",2,0],["ألا كل النوى في البسر يخفى","وقد أخفت نواتك كل بسره",235,"ر",2,0],["إلّاكَ ربّي كُلُّ شئٍ هالِكٌ","وسِواكَ يا موْلايَ ذَرُّ رمادِ",236,"د",1,0],["ألا كم رفعنا من إله وكم هوى","إله وأضحى ثالث وهو رابع",237,"ع",1,0],["إلا كما يهمي على","أرضٍ غَمامٌ دَائمُ",238,"م",1,0],["إلاكَ .. تكبحُ مَدَّها","لتعودَ عَنَّا نازحَةْ",239,"ح",2,0],["إلّاك من يبكيه يا ودق السما","قد نث قبل العين بالأعتابِ",240,"ب",1,0],["ألا كلُّ القصائدِ يا عبيرُ","بلا إيقاعِكِ الأسمى تَبورُ",241,"ر",1,0],["إلّاكِ يا طُهرًا يُغلّفهُ الأسى","يستقبلُ الجوعى ولا يجدُ الكفنْ",242,"ن",1,0],["إِلّاَكِ في دَوْحَةِ الأَحْزَانِ فَرْحَتَنَا","تَحْمِي فَتِيلَ الهَوَى في ذِرْوَةِ اللّهَبِ",243,"ب",1,0],["ألَا كَسِّري كلَّ نغمةِ عودٍ","وكلَّ غناءٍ فما مِن سَمَرْ",244,"ر",1,0],["إلاكَ ما عَرفَتْ رُوحي وَ ما سكنت","في أرض أشواقنا توقا لرؤياكا",245,"ك",2,0],["إِلَّاكَ- يَا عَطَشَ الغَرَامِ- أَزَلَّنِي","وَرَفَضتُ, لَكِنَّ الغَرَامَ لَنَا أَزَلّا",246,"ل",2,0],["إلاكَ أنت وحيداً رُزْتَ جحفلها","كنتَ الحريَّ بها، ما أنكرتْ طاها",247,"ا",3,0],["الأكل والشرب فى إيد اللومنجية","والطماعين اللى غلوا الملح والميه",248,"ي",2,1],["ألا كونوا لدين الله حصناً","وسدُّوا الثغر ولتحموا حمانا",249,"ن",2,0],["الآكليكَ، المُطعمينَ لُحومَنا","باسمِ ازدِهارِكَ ألأمَ الأغرابِ!",250,"ب",1,0],["إلاَّ كقلبِي إِذَا مَا جِئتُ مُنكفِئًا","أُرِيدُ شرحَكِ فِي الدُّنيَا الكِتابِيَّةْ",251,"ي",2,0]]}