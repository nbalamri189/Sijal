{"poems":[[55,"ألا كتبت تنهى وتأمر بالهجر","https://www.aldiwan.net/poem26313.html","الطويل"],[55,"ذري عنك يا ذلفاء طول عتابي","https://www.aldiwan.net/poem26532.html","الطويل"],[9,"أثوى وقصر ليلة ليزودا","https://www.aldiwan.net/poem21927.html","الكامل"],[73,"متى أبثك ما بي","https://www.aldiwan.net/poem11862.html","المجتث"],[73,"مرادهم حيث السلاح خمائل","https://www.aldiwan.net/poem11930.html","الطويل"],[54,"يا سلم ذات الوضح العذاب","https://www.aldiwan.net/poem27652.html","الرجز"],[83,"أمولاي يا ابن السابقين إلى العلا","https://www.aldiwan.net/poem54264.html","الطويل"],[27,"قل للديار سقى أطلالك المطر","https://www.aldiwan.net/poem5764.html","البسيط"],[4,"ربيع لا يسقك نحوي سائق","https://www.aldiwan.net/poem21180.html","الرجز"],[4,"ألا تسألان المرء ماذا يحاول","https://www.aldiwan.net/poem21189.html","الطويل"],[72,"شكرا لنعماك وإن أفحمت","https://www.aldiwan.net/poem18393.html","السريع"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[51,"رأيتك شبهت الضمير وحفظه","https://www.aldiwan.net/poem8296.html","الطويل"],[51,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[29,"خف القطين فراحوا منك أو بكروا","https://www.aldiwan.net/poem6040.html","البسيط"],[29,"حي المنازل بين السفح والرحب","https://www.aldiwan.net/poem6045.html","البسيط"],[38,"إن ابن مغراء عبد ليس نائلنا","https://www.aldiwan.net/poem7823.html","البسيط"],[78,"الأكثرين مسودا ومملكا","https://www.aldiwan.net/poem14192.html","الكامل"],[78,"كذا يهلك السيف في جفنه","https://www.aldiwan.net/poem14220.html","المتقارب"],[85,"سقى الله بالكفر الأباظي مضجعا","https://www.aldiwan.net/poem8107.html","الطويل"],[43,"ألا كل ماشية الخيزلى","https://www.aldiwan.net/poem9448.html","المتقارب"],[43,"حشاشة نفس ودعت يوم ودعوا","https://www.aldiwan.net/poem9720.html","الطويل"],[28,"إن هجاء الباهلين دارماً","https://www.aldiwan.net/poem1280.html",""],[28,"أنا ابن العاصمين بني تميم","https://www.aldiwan.net/poem4949.html","الوافر"],[28,"بناها الأقرع الباني المعالي","https://www.aldiwan.net/poem4959.html","الوافر"],[28,"وحلت بدهناها تميم وألجأت","https://www.aldiwan.net/poem5114.html","الطويل"],[28,"لفلج وصحراواه لو سرت فيهما","https://www.aldiwan.net/poem5389.html","الطويل"],[28,"ولنا قراسية تظل خواضعا","https://www.aldiwan.net/poem5475.html","الكامل"],[28,"ألا كيف البقاء لباهلي","https://www.aldiwan.net/poem5530.html","الوافر"],[58,"ألا قد أرى والله أن لست منكم","https://www.aldiwan.net/poem30890.html","الطويل"],[49,"ألا من لنفس في الهوى قد تمادت","https://www.aldiwan.net/poem10840.html","الطويل"],[49,"ألا كل مولود فللموت يولد","https://www.aldiwan.net/poem62039.html","الطويل"],[49,"سل القصر أودى أهله أين أهله","https://www.aldiwan.net/poem63097.html","الطويل"],[97,"أليلاى ما أبقى الهوى في من رشد","https://www.aldiwan.net/poem24350.html","الطويل"],[80,"ألا كم تسمع الزمن العتابا","https://www.aldiwan.net/poem31566.html","الوافر"],[44,"إما حججت فمقبول ومبرور","https://www.aldiwan.net/poem29981.html","البسيط"],[44,"شعري أنى هربت في الطلب","https://www.aldiwan.net/poem30070.html","المنسرح"],[90,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[81,"تجلى شهاب للسعادة آفل","https://www.aldiwan.net/poem61333.html","الطويل"],[102,"هادئ القلب مطبق الأجفان","https://www.aldiwan.net/poem33126.html","الخفيف"],[21,"ثم لوط أخو سدوم أتاها","https://www.aldiwan.net/poem36138.html","الخفيف"],[22,"ألا كل أرماح قصار أذلة","https://www.aldiwan.net/poem21671.html","الطويل"],[75,"يوم عريض في الفخار طويل","https://www.aldiwan.net/poem69050.html","الكامل"],[75,"رأيت بعيني فوق ما كنت أسمع","https://www.aldiwan.net/poem69065.html","الطويل"],[75,"ألا كل آت قريب المدى","https://www.aldiwan.net/poem69106.html","المتقارب"],[48,"ألا كل بصري يرى أنما العلى","https://www.aldiwan.net/poem66154.html","الطويل"],[50,"جفا وده فازور أو مل صاحبه","https://www.aldiwan.net/poem64818.html","الطويل"],[8,"أيا دار سلمى بالحرورية اسلمي","https://www.aldiwan.net/poem21840.html","الطويل"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85366","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85723","المجتث"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/141020",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39628","المتقارب"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72194","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202526","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55509","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141988","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141959","الخفيف"],[49,"","https://poetry.dctabudhabi.ae/diwan/poem/2612","المتقارب"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142340","الكامل"],[43,"ألا كل ماشية الخيزلى","https://www.poetsgate.com/ViewPoem.aspx?id=82",""],[28,"كم من مناد والشريفان دونه","https://www.poetsgate.com/ViewPoem.aspx?id=21089",""],[38,"إنَّ ابنَ مغراءَ عبدٌ ليسَ نائلنا","https://www.poetsgate.com/ViewPoem.aspx?id=21240",""],[51,"رأيتك شبَّهْتَ الضمير وحفظَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=26822",""],[43,"ألا كل ماشية الخيزلى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=5436&r=&rc=7",""]],"verses":[["أَلا كَتَبَت تَنهى وَتَأَمُرُ بِالهَجرِ","فَقُلتُ لَها يالَيتَ قَلبَكِ في صَدري",0,"ي",1,1],["أَلا كُلُّ شَيءٍ كانَ أَوهُوَكائِنٌ","يَكونُ بِعِلمٍ سابِقٍ وَكِتابِ",1,"ب",1,0],["إِلّا كَخارِجَةَ المُكَلِّفِ نَفسَهُ","وَاِبنَي قَبيصَةَ أَن أَغيبَ وَيَشهَدا",2,"د",2,0],["إِلّا كَوَجهِكِ لَمّا","أَضاءَ تَحتَ النِقابِ",3,"ب",1,0],["أَلا كُلُّ رَجوى في سِواكَ عُلالَةٌ","وَكُلُّ مَديحٍ لَم يَكُن فيكَ باطِلُ",4,"ل",1,0],["إِلّا كَشَفتِ اليَومَ عَنّي ما بي","جاءَ مَشيبي وَمَضى شَبابي",5,"ب",2,0],["ألاَ كلُّ من صلّى وضحّى ومن دعا","ومدَّ يدَيْهِ ضارعاً متوسِّلا",6,"ل",2,0],["الآكِلونَ خَبيثَ الزادِ وَحدَهُمُ","وَالنازِلونَ إِذا واراهُمُ الخَمَرُ",7,"ر",1,0],["إِلّا كَشَيءٍ عاقَهُ العَوائِقُ","وَأَنتَ حاسٍ حَسوَةً فَذائِقُ",8,"ق",1,0],["أَلا كُلُّ شَيءٍ ما خَلا اللَهَ باطِلُ","وَكُلُّ نَعيمٍ لا مَحالَةَ زائِلُ",9,"ل",1,0],["إلاّ كبيت الله في فضله","على بيوت الله والكل بيت",10,"ت",1,0],["إلا كأنَّ اللَّه ذل","لَلَ عامداً لهمُ صِعابهْ",11,"ب",2,0],["ألا كان كالغربال يَنْفِي زُؤانَهُ","وما كان من قَصْرٍ ويحتبسُ الحَبَّا",12,"ب",2,0],["ألا كان مثل القِدْرِ تنفي غُثاءها","وتَقْنَى عُرَاقَ اللحمِ والمرقَ العذبا",12,"ب",2,0],["ألا كلٌ حيٍّ ما خلا الله مَيِّتٌ","وإن زعمَ التأميلَ ذو الإفك ما زعمْ",13,"م",1,0],["ألا كم أذلَّ الدهرُ من متعززٍ","وكم زمَّ من أنف حَمِيٍّ وكم خطمْ",13,"م",1,0],["الآكِلونَ خَبيثَ الزادِ وَحدَهُمُ","وَالسائِلونَ بِظَهرِ الغَيبِ ما الخَبَرُ",14,"ر",1,0],["الأَكثَرينَ حَصىً وَالأَطيَبينَ ثَرىً","وَالأَحمَدينَ قِرىً في شِدَّةِ اللِزَبِ",15,"ب",1,0],["الآكِلينَ اللَوايا دونَ ضَيفِهِمُ","وَالقِدرُ مَخبوأَةٌ مِنها أَثافيها",16,"ي",3,0],["الأَكثَرين مُسَوّداً وَمُملَّكا","وَمُتَوّجا في سالِف الأَعصارِ",17,"ر",1,1],["أَلا كَرَمٌ يُنعِشُ السمهريّ","وَيُشفيه مِن كُلّ داءِ دَفينِ",18,"ن",1,0],["أَلا كُلُّ ذَنبٍ لِلَّيالي لِأَجلِهِ","سَدَلنا عَلَيهِ صَفحَنا وَالتَناسِيا",19,"ي",2,0],["أَلا كُلُّ ماشِيَةِ الخَيزَلى","فِدا كُلُّ ماشِيَةِ الهَيذَبى",20,"ا",1,1],["أَلا كُلُّ سَمحٍ غَيرَكَ اليَومَ باطِلٌ","وَكُلُّ مَديحٍ في سِواكَ مُضَيَّعٌ",21,"ع",1,0],["أَلا كُلُّ بَيتٍ باهِلِيٍّ أَمامَهُ","حِمارٌ وَعِدلا نِحيِ سَمنٍ وَرايِبِ",22,"ب",1,0],["أُلاكَ وَعيرِ أُمَّكَ لَو تَراهُم","بِعَينِكَ ما اِستَطَعتَ لَهُم خِطابا",23,"ب",2,0],["أُلاكَ لِدارِمٍ وَبَناتُ عَوفٍ","لِخَيراتٍ وَأَكرَمِ أُمَّهاتِ",24,"ت",1,0],["أَلا كُلُّ أَمرٍ يا اِبنَ مَروانَ ضائِعٌ","إِذا لَم تَكُن في رَحَتَيكَ مَرائِرُه",25,"ر",2,0],["أَلا كُلُّ شَيءٍ في يَدِ اللَهِ بالِغٌ","لَهُ أَجَلٌ عَن يَومِهِ لا يُحَوَّلُ",26,"ل",1,0],["أَلا كُلُّ نَفسٍ سَوفَ يَأتي وَراءَها","إِلى يَومِ يَلقاها الكِتابُ المُؤَجَّلُ",26,"ل",1,0],["الأَكثَرونَ إِذا يُعَدُّ حَصاهُمُ","وَالأَكرَمونَ إِذا يُعَدُّ الأَوَّلُ",27,"ل",1,0],["أَلا كَيفَ البَقاءُ لِباهِلِيٍّ","هَوى بَينَ الفَرَزدَقِ وَالجَحيمِ",28,"م",1,1],["أُلاكَ أَخِلائي إِذا ما ذَكَرتُهُم","بَكَيتُ بِعَينٍ ماءُ عَبرَتِها كُحلي",29,"ي",1,0],["أَلا كُلُّ نَفسٍ طالَ في الغَيِّ عُمرُها","تَموتُ وَإِن كانَت عَنِ المَوتِ حادَتِ",30,"ت",1,0],["أَلا كُلُّ مَولودٍ فَلِلمَوتِ يولَدُ","وَلَستُ أَرى حَياً لِشَيءٍ يُخَلَّدُ",31,"د",1,1],["أَلا كُلُّ شَيءٍ زالَ فَاللَهُ بَعدَهُ","كَما كُلُّ شَيءٍ كانَ فَاللَهُ قَبلُهُ",32,"ل",2,0],["أَلا كُلُّ شَيءٍ ما سِوى اللَهِ زائِلٌ","أَلا كُلُّ ذي نَسلٍ يَموتُ وَنَسلُهُ",32,"ل",2,0],["أَلا كُلُّ مَخلوقٍ يَصيرُ إِلى البِلى","أَلا إِنَّ يَومَ المَيتِ لِلحَيِّ مِثلُهُ",32,"ل",2,0],["ألا كلُّ حسنٍ في البريةِ خادمٌ","لسلطانَةِ العينينِ والجيدِ والقدِّ",33,"د",1,0],["ألا كمْ تُسْمِعُ الزمن العتابا","تخاطبُهُ ولا يدري الخطابا",34,"ب",2,1],["إِلّا كِتاباً لَنا قَد كُنتَ جُدتَ بِهِ","فُضَّ الخِتامُ وَفَحوى لَفظِهِ زورُ",35,"ر",1,0],["أُلاكَ زُهرُ النُجومِ لَيسَ كَمَن","أَمسى دَعِيّاً في الشِعرِ وَالنَسَبِ",36,"ب",1,0],["الآكلين بلحمي سُمَّ أغرِبَةٍ","وغُصَّةً في حلاقين الشواهين",37,"ن",1,0],["ألاَ كُلُ يَومٍ في جَنَابِكَ مَوسِمٌ","جَدِيدٌ وَلَكِن أنتَ لِلضَّيفِ قَابِلُ",38,"ل",1,0],["ألاَ كُلُّ مُلكٍ لَم تَسُسهُ مُضَيَّعٌ","وَكُلُّ إحتجَاجٍ لَم يَقُم بكَ بَاطِلُ",38,"ل",1,0],["الأَكاليل لَم تَزَل غَضة الزَهر","وَلَم تَنقطع أَغاني الغَواني",39,"ن",2,0],["أَلا كُلُ شَيءٍ هالِكٌ غَيرَ رَبِّنا","وَلِلَّهِ مِيراثُ الَّذي كانَ فانِيا",40,"ا",1,0],["أَلا كُلُّ أَرماحٍ قِصارٍ أَذِلَّةٍ","فِداءٌ لِأَرماحٍ رُكِزنَ عَلى الغَمرِ",41,"ر",1,1],["الأكثرينَ تخمُّطاً وتكبُّراً","ما لم تُهَزّ أسِنّةٌ ونُصُول",42,"ل",1,0],["ألا كلُّ عَيشٍ دونَهُ فمحرَّمٌ","وكلُّ حريمٍ بعده فمضيَّع",43,"ع",1,0],["ألا كلُّ آتٍ قريبُ المَدى","وكلُّ حياةٍ إلى مُنْتَهَى",44,"ا",1,1],["أَلا كُلِّ بَصرِيٍّ يَرى أَنَّما العُلى","مُكَمَّهَةٌ سُحقٌ لَهُنَّ جَرينُ",45,"ن",1,1],["أُلاكَ الأُلى شَقّوا العَمى بِسُيوفِهِم","عَنِ الغَيِّ حَتّى أَبصَرَ الحَقَّ طالِبُه",46,"ب",2,0],["إِلاَّ كَمُعرِضٍ المُحسِّرِ بَكرَهُ","عَمداً يُسَبَّبُني عَلى الظُّلمِ",47,"م",1,0],["إِلا كَساهُ الذُّلَّ والصَّغارا","وعَمَّهُ وأَهلهُ دَمارا",48,"ر",2,0],["إلا كمثل ذرة","حَقيرة في بلقع",49,"ع",1,0],["إلا كحبة رمل","مدفوعة بالرياحِ",50,"ح",1,0],["ألا كلّ ماشية الخيزلى","فدى كلّ ماشية الهيدبى",51,"ا",1,1],["ألا كم تألَّقنَ فوق الغصون","زواهرَ في روعةٍ واتقادْ",52,"د",1,0],["ألا كلُّ ما قالَ الرُّواةُ وأَنْشدوا","بها غيرَ ما قالَ السَّلُوليُّ بَهْرَجُ",53,"ج",1,1],["الأكرمين نسبا مطهرا","الأرفعين حسبا ومظهرا",54,"ر",2,0],["إِلاَّ كَمَا تُجْلَى وُرُو","دُ الرَّوْضِ أَوْ تُجْنَى شِهَادُهْ",55,"د",2,0],["إلاك يا ضهر الشوير فأنت من","حدث الليالى والخلود بموثق",56,"ق",1,0],["الأكف اللذان من شغف الغيد","فحدد منهن للحق نصلا",57,"ل",2,0],["أَلا كُلُّ ما هُوَ آتٍ قَريبُ","وَلِلأَرضِ مِن كُلِّ حَيٍّ نَصيبُ",58,"ب",1,1],["الآكلون قلوبهم حقدا على","ترف القصور وثروة البخلاء",59,"ا",2,0],["ألا كل ماشية الخيزلى","فدا كل ماشية الهيدبى",60,"ا",1,1],["ألا كُلُّ أمْرٍ يا ابنَ مَرْوَانَ ضَائِعٌ","إذا لمْ تَكُنْ في رَاحَتَيكَ مَرَائِرُهْ",61,"ر",2,0],["الآكلينَ اللّوايا دونَ ضيفهمُ","والقدرُ مخبوءة ٌ منها أثافيها",62,"ي",3,0],["ألا كان كالغربال يُنفي زُؤانهُ","وما كان من قِصْرى ويحتبس الحَبَّا",63,"ب",2,0],["ألا كُلُّ مَاشِيَةِ الخَيْزَلَى","فِدَى كلِّ ماشِيَةِ الهَيْذَبَى",64,"ا",1,1]]}