{"poems":[[32,"خليلي عوجا عوجة","https://www.aldiwan.net/poem29570.html","الطويل"],[87,"ضج الحجاز وضج البيت والحرم","https://www.aldiwan.net/poem63747.html","البسيط"],[41,"برت لك حماء العلاط سجوع","https://www.aldiwan.net/poem53769.html","الطويل"],[1,"فليت لنا مكان الملك عمرو","https://www.aldiwan.net/poem33998.html","الوافر"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16642","الطويل"],[119,"متى يا سعد تسعدنا الليالي","https://www.aldiwan.net/poem40630.html","عموديه"],[119,"حجت لمنعرج الحي المصاليت","https://www.aldiwan.net/poem41204.html","عموديه"],[136,"يقال للشمس الكسوف والخسوف","https://www.aldiwan.net/poem54661.html","الرجز"],[186,"هذا ضريح كريم قوم فوقه","https://www.aldiwan.net/poem61132.html","الكامل"],[186,"زر مضجعا حل فيه فارس فغدا","https://www.aldiwan.net/poem61181.html","البسيط"],[214,"علاك إليه ناظر السعد ناظر","https://www.aldiwan.net/poem13334.html","الطويل"],[275,"أمن عربية تشتاق دارا","https://www.aldiwan.net/poem35647.html","الوافر"],[285,"خذا من صبا نجد أمانا لقلبه","https://www.aldiwan.net/poem60719.html","الطويل"],[287,"قوامك ثم لحظك يا غلام","https://www.aldiwan.net/poem32625.html","الوافر"],[447,"ألا إن آلات المداد فتسعة","https://www.aldiwan.net/poem14418.html","الطويل"],[463,"تربعت بين العذيب فالنقا","https://www.aldiwan.net/poem56093.html","الرجز"],[563,"في الكون للحق أمثال بها نطقا","https://www.aldiwan.net/poem34300.html","البسيط"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110460","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62658","الرجز"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119880","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79839","الطويل"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102053","الوافر"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128000","البسيط"],[2543,"","https://poetry.dctabudhabi.ae/diwan/poem/123743","الرجز"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130760","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65945","الطويل"],[2922,"","https://poetry.dctabudhabi.ae/diwan/poem/105326","الطويل"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111045","الكامل"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119496","المجتث"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36474","الدوبيت"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105131","الوافر"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54410","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94965","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72790","الطويل"],[4767,"النهج الأصيل","https://www.poetsgate.com/ViewPoem.aspx?id=179919",""],[4578,"عُرب اللوى عن عهود الود قد حالوا","https://www.poetsgate.com/ViewPoem.aspx?id=49505",""],[5081,"مَنْ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=191363",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[5816,"( العبيرية ) في وصف الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=125964",""],[5953,"سئمت المقام بأرض الشّام","https://www.poetsgate.com/ViewPoem.aspx?id=93800",""],[5956,"من الزهر وضوء القمر","https://www.poetsgate.com/ViewPoem.aspx?id=182449",""]],"verses":[["مِنَ الزُرقِ أَو صُقعٍ كَأَنَّ رُؤوسَها","مِنَ القِهزِ وَالقوهِيِّ بيضُ المَقانِعِ",0,"ع",1,0],["مِنَ الزِيادَةِ في البَلوى وَإِن عَظُمَت","أَن يَعلَمَ الشامِتونَ اليَومَ ما عَلِموا",1,"م",3,0],["مِنَ الزُلِّ هِزلاجٌ كَأَنَّ بِرِجلِهِ","شِكالاً مِنَ الإِقعاءِ وَهوَ مَلوعُ",2,"ع",1,0],["مِنَ الزَمِراتِ أَسبَلَ قادِماها","وَضَرَّتُها مُرَكَّنَةٌ دَرورُ",3,"ر",1,0],["من الزّنْجِ كَهلٌ شابَ مفرِقُ رأسِه","وأُوثِقَ حتى نَهْضُهُ مُتثاقِل",4,"ل",1,0],["من الزهر الغطارفة استقرت","بظل فنائهم زهر المعالي",5,"ل",2,0],["من الزيانب يدلي للفواطم ح","تى صا شيخا له منهن تنبيت",6,"ت",1,0],["مِنَ الزَّوَالِ لِلضُّحَى فَانتَبِهَا","وَلاَ أذَانَ لاَ إقَامَةَ لها",7,"ه",2,0],["مِن آلِ زِلزلَ مِن سراةِ عَشيرةٍ","قَد كانَ فيهِم دُرَّةَ الأكليلِ",8,"ل",1,0],["مِن آلِ زَلزلَ مِن قَومٍ قَد اِشتَهَروا","بِكُلِّ فَضلٍ فَكانوا خَيرَ أَقوامِ",9,"م",1,0],["من الزرد المنظوم احكمت نسجها","فكانت دروعا للقا ومغافر",10,"ر",1,0],["من الزبّاءِ صانَ الحصنُ حُسناً","بهِ ازدادت علوّاً واقتِدارا",11,"ر",2,0],["مِنَ الزُّهْرِ لا يُلْفَيْنَ إِلاّ كَواكباً","طَوالِعَ فِي شَرْقِ الزَّمانِ وَغَرْبِهِ",12,"ب",2,0],["مِنَ الزَّرَدِ المُضاعَفِ في لِثامٍ","يُضاعِفُ حُسنَهُ ذاكَ اللِّثامُ",13,"م",1,0],["من الزاج أَوزاناً ثلاث دراهم","لئلا يصير اللون أَغبر أَقتما",14,"م",2,0],["من الزكيّ طينةً ودوحةً","وثمراً وخِلقةً وخُلُقا",15,"ق",2,0],["من الزجاج أو الفولاذ ليس بها","شيء وفيها يلوح الشيء متسقا",16,"ق",2,0],["من آل زخور يوحنا مَضَى ولَقَد","اَجرى الدموعَ دماءً يومَ مصرَعهِ",17,"ه",1,1],["من الزمان قد غدا","نصيب كل نصبَا",18,"ب",2,0],["من الزينبين الذين تقبلوا","ظلل المعالي واستقلوا العواليا",19,"ي",2,0],["من الزهرةِ الغرَّاء قد بات يجتلي","عروساً جلاها الحسن أن تتبرقعا",20,"ع",2,0],["من الزور طابت طاب سوحا","بها اذ حلها الصفو الرحيم",21,"م",1,0],["من الزمرذ قد صيغت منابرهم","بالدر قد رصعت سبحان من منحا",22,"ح",2,0],["من الزمانِ عُلِّقَته محَنٌ","قد شعَّبَت بقلبه شعوبا",23,"ب",2,0],["من الزهر والاغصان والطير والربى","وحسن بضوء الشمس في الروض ساطع",24,"ع",1,0],["من الزرع نصف العشر والغرس إِن سقي","بغرب وإِلاَّ عشر ما اقتات ذو الكد",25,"د",1,0],["من الزنجبيل العذب كان مزاجها","وياما احيلاها وأحلى مزاجها",26,"ج",3,0],["من الزمان على الورى بسروركم","فغدا يطوق بالجميل رقابا",27,"ب",2,0],["من الزجاج القد","يم المستعمل المرواني",28,"ن",2,0],["مَن أَلزمَها اِمتِثالَ حكم الواشي","يا واخذها اللَهُ بجرم الواشي",29,"ي",1,0],["من الزفرات يشوي الأرض لكن","من العبرات يخضلّ الهشيم",30,"م",1,0],["مَن أَلزم اللّه كلَّ الخلقِ طاعته","مُخوّفاً منه عصياناً وشقّ عصا",31,"ص",2,0],["من آل زخيا نقابٌ مذ قضى أجلاً","فصار لبنان يهمي الدمع ملهوفا",32,"ف",2,1],["من الزائدينَ الروع والخطبُ فادح","وافئدةُ الآسادِ ترقُص كالآل",33,"ل",1,0],["من الزهراء فالزهراء شمس","أزالت ظلمة الليل الطويل",34,"ل",1,0],["من الزمان لمن قد أم ساحتهُ","براءة قد تلتها منه أنفال",35,"ل",1,0],["مَنْ أَلْزَمَ النَّجْمَ السُّجُودَ وَطَاعَةً","كِي يَبْدَأَ الْإِشْرَاقَ أَوْ أَنْ يَأْفُلَا ؟",36,"ل",2,0],["من الزور والبهتان ليس بثابت","وليس له أصل فدع عنك ما يردي",37,"د",2,0],["من الزعفران الرطب والمسك أنشئت","على قدر من رحمة الله حورها",38,"ر",3,0],["من الزينبيّ ويحيى ومن","أبي خالد الكابليّ القوام",39,"م",1,0],["من الزهرِ صيغتْ وضوءِ القَمَرْ","رفاهُ الجميلة ذاتُ الحَوَرْ",40,"ر",1,1]]}