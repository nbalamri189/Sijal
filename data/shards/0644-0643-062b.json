{"poems":[[37,"من لقلب متيم مستهام","https://www.aldiwan.net/poem7649.html","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43754","الطويل"],[197,"أي وعينيك فاض كأس غرامي","https://www.aldiwan.net/poem39807.html","الخفيف"],[432,"يا بن عدلان يا أخس الرجال","https://www.aldiwan.net/poem12457.html","الخفيف"],[437,"ليس لي من بعدهم جلد","https://www.aldiwan.net/poem2546.html","المديد"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["لكثيرينَ طَيّبينَ من النَّا","سِ وبَرِّينَ صادقينَ كشرامِ",0,"م",1,0],["لِكَثرَةُ رُزء أَو لِقِلَّةِ فُرصَةٍ","تعرُّ بِعارٍ أَو تَهونُ بِهانِ",1,"ن",1,0],["لك ثغر يفترّ عن بسمات","ضوؤها أيقظ الشعور السامي",2,"ي",1,0],["لك ثغرٌ مثل الكنيف وهذا","فوق أسنانِه كنيف الكعال",3,"ل",1,0],["لك ثفر لؤلؤُ نظم","وحديث لؤلؤ بدد",4,"د",1,0],["لكثرة العدد في المحلة","أثبت منك حجة في القلة",5,"ه",1,0]]}