{"poems":[[39,"من لقلب متيم مستهام","https://www.aldiwan.net/poem7649.html","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43754","الطويل"],[201,"أي وعينيك فاض كأس غرامي","https://www.aldiwan.net/poem39807.html","الخفيف"],[438,"يا بن عدلان يا أخس الرجال","https://www.aldiwan.net/poem12457.html","الخفيف"],[443,"ليس لي من بعدهم جلد","https://www.aldiwan.net/poem2546.html","المديد"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37974","الرجز"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67832","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59254","الخفيف"],[1067,"","https://poetry.dctabudhabi.ae/diwan/poem/138060","الرجز"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106830","الخفيف"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137127",""],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132689","الرمل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73136","الخفيف"],[5472,"مالبرّ الأمير قصّر عنى","https://www.poetsgate.com/ViewPoem.aspx?id=200465",""],[5747,"الجرح العظيم","https://www.poetsgate.com/ViewPoem.aspx?id=61671",""],[5956,"ذكرياتُ مشاهدَ من حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=184838",""],[5956,"بالتجاوب لن أعابا","https://www.poetsgate.com/ViewPoem.aspx?id=192424",""],[5956,"لِكثيرِ من صادفتهم أنذالا","https://www.poetsgate.com/ViewPoem.aspx?id=193418",""],[6115,"كيف حالك يايميني","https://www.poetsgate.com/ViewPoem.aspx?id=180460",""]],"verses":[["لكثيرينَ طَيّبينَ من النَّا","سِ وبَرِّينَ صادقينَ كشرامِ",0,"م",1,0],["لِكَثرَةُ رُزء أَو لِقِلَّةِ فُرصَةٍ","تعرُّ بِعارٍ أَو تَهونُ بِهانِ",1,"ن",1,0],["لك ثغر يفترّ عن بسمات","ضوؤها أيقظ الشعور السامي",2,"م",2,0],["لك ثغرٌ مثل الكنيف وهذا","فوق أسنانِه كنيف الكعال",3,"ل",1,0],["لك ثفر لؤلؤُ نظم","وحديث لؤلؤ بدد",4,"د",1,0],["لكثرة العدد في المحلة","أثبت منك حجة في القلة",5,"ه",1,0],["لكثرةٍ في خيرها","تضيقُ فيها النفقَهْ",6,"ق",2,0],["لِكَثْرَةِ شَوْقي سَلْوَتي قَدْ تَبَاعَدَتْ","وَعِنْدِي كُلُومٌ وَهيَ أَزْكى مِنَ الْكُلِّ",7,"ل",1,0],["لَكَ ثَغْرٌ سَبَا الخَلائِق ذوْقَا","فَتَفَانَوْا بطيبِ ريَّاهُ عِشْقَا",8,"ق",2,1],["لِكَثْرَةِ اخْتِلاطِهِمْ بِالشّيْعَهْ","فَحُلِّلَ الْخُمْسُ لِذِيْ الذَّرِيْعَهْ",9,"ه",1,0],["لك ثغرٌ غضٌّ على جانبيه","طَبعَ الحسنُ آتيه رواءَ",10,"ا",2,0],["لك ثاقب إما هززت شباته","فكانما منه هززت يمانيا",11,"ي",2,0],["لك ثغر دونه سيف المقل","يحرس الورد وورد اللعس",12,"س",1,0],["لكَ ثغرٌ كلُؤلُؤِ في عَقيقِ","ورُضابٌ كالشهُّدِ أو كالرَّحيقِ",13,"ق",1,1],["لكثير عندى ولم يك عهدى","أن أرى الرزق عنده محظورا",14,"ر",2,0],["لك ثلاث سنين يالجرح العظيم","وانت تنزف من طعونٍ موجعه",15,"ع",2,0],["لكثرة ما أنا أرهقُ نفسي","وأنتج ذخراً يحاكي المُحالا",16,"ل",2,0],["لكثرةِ ما طلبتَ المدحَ منّي","ولم أنظمْ لكيلا تسترابا",17,"ب",2,0],["لِكثيرِ من صادفتُهم أنذالا","إني افترضتُه مثلهم دجالا",18,"ل",2,1],["لك ثلاث سنين في وضع حزيني","عند وقت النوم في جنبك وساده",19,"د",2,0]]}