{"poems":[[9,"أتهجر غانية أم تلم","https://www.aldiwan.net/poem21984.html","المتقارب"],[47,"أراك عصي الدمع شيمتك الصبر","https://www.aldiwan.net/poem25258.html","الطويل"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[51,"صرمت اليوم حبلك من لميس","https://www.aldiwan.net/poem64658.html","الوافر"],[45,"اسمع هديت أبا يحيى مقال أخ","https://www.aldiwan.net/poem64548.html","البسيط"],[61,"سألت الله مما كان عفوا","https://www.aldiwan.net/poem51398.html","الوافر"],[61,"أبا جعفر كانت يداك سحائبا","https://www.aldiwan.net/poem51667.html","الطويل"],[66,"أجرد كي أجرد سيف مدحي","https://www.aldiwan.net/poem41350.html","الوافر"],[66,"ما بين طيفك والجفون مواعد","https://www.aldiwan.net/poem41369.html","الكامل"],[74,"شراب الأماني لو علمت سراب","https://www.aldiwan.net/poem12869.html","الطويل"],[50,"يا دار أقوت بالأجالد","https://www.aldiwan.net/poem63942.html","مجزوء الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54639","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55049","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54637","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54626","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43853","البسيط"]],"verses":[["فَأَظعَنتَ وِترَكَ مِن دارِهِم","وَوِترُكَ في دارِهِم لَم يُقِم",0,"م",1,0],["فَأَظمَأُ حَتّى تَرتَوي البيضُ وَالقَنا","وَأَسغَبُ حَتّى يَشبَعَ الذِئبُ وَالنَسرُ",1,"ر",1,0],["فاظلموا جُهدَكم فلن تستطيعوا","أبداً أن تُوغِّروا الأحْشاءَ",2,"ا",2,0],["فاظنُن بكلبٍ شامَ في","ه الليثُ مِخْلَبَهُ ونابهْ",3,"ب",2,0],["فأظهره الإله لنا بعمرٍو","أبي الخرطوم ذي الأنفِ الرئيس",4,"س",1,0],["فَأَظهَرَ التيهَ مِن جَهلٍ وَقابَلَني","بِسَيِّئٍ لَم يَكُن مِن حَقِّ مِقدارِ",5,"ر",1,0],["فأظهرتَ الزَّمانةَ في زَمانٍ","حَزَزتَ به من اللَّذَّاتِ عُضوا",6,"و",2,0],["فأظلمَتِ الآفاقُ بعدَ محمدٍ","فسِيَّانِ منها ليلُها ونَهارُها",7,"ر",3,0],["فَأُظهِرُ حَيرَةً في بَسطِ عُذري","وَأُخفي ما يُجِنُّ لَكُمُ جَناني",8,"ن",2,0],["فَأَظَلُّ أَقنَعُ بِالخَيالِ وَإِنَّهُ","طَمَعٌ يُوَلِّدُهُ الخَيالُ الفاسِدُ",9,"د",1,0],["فَأَظلَمَ قَرنُ الشَمسِ وَهيَ مُنيرَةٌ","وَضاقَت بِلادُ اللَهِ وَهيَ رِحابُ",10,"ب",1,0],["فَاِظفِر بِحَظِّكَ مِن أَخٍ","مُتَدَفِّقِ الشَرَباتِ ماجِد",11,"د",1,0],["فَاظْنُنْ بِعَال مَنْصِباً وَوَظِيفَةً","مَا اغْتَابَهُ الحُسَّادُ أَوْ مَا اغْتَابَا",12,"ب",2,0],["فَاظْفَرِ الْيَوْمَ مِنْ بَنِيهَا وَمِنْهَا","خَالدَ الذِّكْرِ بِالْجَزَاءِ الْوِفَاقِ",13,"ق",1,0],["فَاظْنُنْ بِمَنْ يَغْتَابُ مَقْتُولاً وَقَدْ","أَعْيَا فَمَا يَسْطِيعُ نُبْسَةَ عَاقِبِ",14,"ب",1,0],["فَاظْنُنْ بِرَوْعَتِهَا وَسُرْعَةِ عَدْوِهَا","نحْوَ العَقِيقِ وَدَمْعِهَا المُتَسَاكِبِ",15,"ب",1,0],["فاظَ الَّذي كُنتُ أَرتَجي أَن","يَقوى بِهِ رُكني الضَعيفُ",16,"ف",1,0]]}