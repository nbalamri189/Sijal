{"poems":[[9,"أتهجر غانية أم تلم","https://www.aldiwan.net/poem21984.html","المتقارب"],[47,"أراك عصي الدمع شيمتك الصبر","https://www.aldiwan.net/poem25258.html","الطويل"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[51,"صرمت اليوم حبلك من لميس","https://www.aldiwan.net/poem64658.html","الوافر"],[45,"اسمع هديت أبا يحيى مقال أخ","https://www.aldiwan.net/poem64548.html","البسيط"],[61,"سألت الله مما كان عفوا","https://www.aldiwan.net/poem51398.html","الوافر"],[61,"أبا جعفر كانت يداك سحائبا","https://www.aldiwan.net/poem51667.html","الطويل"],[66,"أجرد كي أجرد سيف مدحي","https://www.aldiwan.net/poem41350.html","الوافر"],[66,"ما بين طيفك والجفون مواعد","https://www.aldiwan.net/poem41369.html","الكامل"],[74,"شراب الأماني لو علمت سراب","https://www.aldiwan.net/poem12869.html","الطويل"],[50,"يا دار أقوت بالأجالد","https://www.aldiwan.net/poem63942.html","مجزوء الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54639","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55049","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54637","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54626","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43853","البسيط"],[161,"سطوت بسلطان الجمال على الصب","https://www.aldiwan.net/poem58871.html","الطويل"],[161,"ما أنت في منزل يخشى به الرجل","https://www.aldiwan.net/poem58934.html","البسيط"],[190,"حمد امرئ أخلص في آدائه","https://www.aldiwan.net/poem35279.html","الرجز"],[196,"طال الكرى وألم الهم فاكتنعا","https://www.aldiwan.net/poem54402.html","البسيط"],[232,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[236,"أيا عضد الدين يا من غدا","https://www.aldiwan.net/poem31612.html","المتقارب"],[238,"لك البشرى بتيسير المرام","https://www.aldiwan.net/poem19087.html","الوافر"],[262,"قسما هذه القوافي الحسان","https://www.aldiwan.net/poem38167.html","الخفيف"],[262,"لو لم أطل أمل التلاق","https://www.aldiwan.net/poem38226.html","مجزوء الكامل"],[271,"هزئتم بنفس تجهلون خلالها","https://www.aldiwan.net/poem35616.html","الطويل"],[283,"نوح الحمام الورق في أوراقها","https://www.aldiwan.net/poem32291.html","الرجز"],[306,"لصادق رعيه القصر السعيد","https://www.aldiwan.net/poem56577.html","الوافر"],[338,"فأظهر ودا والعداوة سره","https://www.aldiwan.net/poem45306.html","الطويل"],[364,"لعمري لقد زار العبيدي رهطه","https://www.aldiwan.net/poem1726.html","الطويل"],[404,"عبر الصبا سحرا بكيرة حاجر","https://www.aldiwan.net/poem33917.html","الكامل"],[417,"ألا يا فؤادا قد أضر به النوى","https://www.aldiwan.net/poem53875.html","الطويل"],[417,"أبى الله إلا إن تعز وتكرما","https://www.aldiwan.net/poem54043.html","الطويل"],[440,"أخو ظمأ يمص حشاه سبع","https://www.aldiwan.net/poem34835.html","الوافر"],[442,"وتمنع كل موطأة بست","https://www.aldiwan.net/poem14411.html","الوافر"],[444,"الرقة البيضاء تشكو ولا","https://www.aldiwan.net/poem56022.html","عموديه"],[464,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[501,"تبرقعت في مرط الخفا عن فصائلي","https://www.aldiwan.net/poem37756.html","الطويل"],[507,"صلاح الدين انت له نظام","https://www.aldiwan.net/poem2399.html","الوافر"],[537,"صحا من سكره وسلا","https://www.aldiwan.net/poem23848.html","مجزوء الوافر"],[537,"قال النبي ولم أجزع يوقرني","https://www.aldiwan.net/poem23854.html","البسيط"],[559,"إن السيادة والريا","https://www.aldiwan.net/poem34634.html","مجزوء الكامل"],[568,"تزداد فيك مصيبتي","https://www.aldiwan.net/poem69633.html","مجزوء الكامل"],[568,"نفسي الفداء لمن إذا جرح الأسى","https://www.aldiwan.net/poem69820.html","الكامل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[580,"نفسي تميل إِلى الهوى فأَردها","https://www.aldiwan.net/poem56776.html","الكامل"],[587,"أبدا بذكرك تنقضي أوقاتي","https://www.aldiwan.net/poem17455.html","الكامل"],[588,"معالي الأمور الساميات المعالم","https://www.aldiwan.net/poem11520.html","عموديه"]],"verses":[["فَأَظعَنتَ وِترَكَ مِن دارِهِم","وَوِترُكَ في دارِهِم لَم يُقِم",0,"م",1,0],["فَأَظمَأُ حَتّى تَرتَوي البيضُ وَالقَنا","وَأَسغَبُ حَتّى يَشبَعَ الذِئبُ وَالنَسرُ",1,"ر",1,0],["فاظلموا جُهدَكم فلن تستطيعوا","أبداً أن تُوغِّروا الأحْشاءَ",2,"ا",2,0],["فاظنُن بكلبٍ شامَ في","ه الليثُ مِخْلَبَهُ ونابهْ",3,"ب",2,0],["فأظهره الإله لنا بعمرٍو","أبي الخرطوم ذي الأنفِ الرئيس",4,"س",1,0],["فَأَظهَرَ التيهَ مِن جَهلٍ وَقابَلَني","بِسَيِّئٍ لَم يَكُن مِن حَقِّ مِقدارِ",5,"ر",1,0],["فأظهرتَ الزَّمانةَ في زَمانٍ","حَزَزتَ به من اللَّذَّاتِ عُضوا",6,"و",2,0],["فأظلمَتِ الآفاقُ بعدَ محمدٍ","فسِيَّانِ منها ليلُها ونَهارُها",7,"ر",3,0],["فَأُظهِرُ حَيرَةً في بَسطِ عُذري","وَأُخفي ما يُجِنُّ لَكُمُ جَناني",8,"ن",2,0],["فَأَظَلُّ أَقنَعُ بِالخَيالِ وَإِنَّهُ","طَمَعٌ يُوَلِّدُهُ الخَيالُ الفاسِدُ",9,"د",1,0],["فَأَظلَمَ قَرنُ الشَمسِ وَهيَ مُنيرَةٌ","وَضاقَت بِلادُ اللَهِ وَهيَ رِحابُ",10,"ب",1,0],["فَاِظفِر بِحَظِّكَ مِن أَخٍ","مُتَدَفِّقِ الشَرَباتِ ماجِد",11,"د",1,0],["فَاظْنُنْ بِعَال مَنْصِباً وَوَظِيفَةً","مَا اغْتَابَهُ الحُسَّادُ أَوْ مَا اغْتَابَا",12,"ب",2,0],["فَاظْفَرِ الْيَوْمَ مِنْ بَنِيهَا وَمِنْهَا","خَالدَ الذِّكْرِ بِالْجَزَاءِ الْوِفَاقِ",13,"ق",1,0],["فَاظْنُنْ بِمَنْ يَغْتَابُ مَقْتُولاً وَقَدْ","أَعْيَا فَمَا يَسْطِيعُ نُبْسَةَ عَاقِبِ",14,"ب",1,0],["فَاظْنُنْ بِرَوْعَتِهَا وَسُرْعَةِ عَدْوِهَا","نحْوَ العَقِيقِ وَدَمْعِهَا المُتَسَاكِبِ",15,"ب",1,0],["فاظَ الَّذي كُنتُ أَرتَجي أَن","يَقوى بِهِ رُكني الضَعيفُ",16,"ف",1,0],["فأظهرت فيه عزة الملك والعلا","ولم تلغِ حقَّ الحمد والشكر للربِّ",17,"ب",1,0],["فاظفر بها يا بن قطبٍ وامض لما","أُمرت فيها فعقبي صابها عسلُ",18,"ل",1,0],["فَأَظهرت مِن قربهِ الإباءَ","فَقيلَ أدّ مَهرها سواءَ",19,"ا",2,0],["فَأَظهَرَ اللَهُ نَصرَ المُسلِمينَ بِهِ","وَكُلُّ فاحِشَةٍ عَن دينِهِم دَفَعا",20,"ع",2,0],["فَأَظَلَّتاهُ وَعادَتا فَإِذا هُما","فَوقَ العُروقِ الخُضرِ قائِمَتانِ",21,"ن",1,0],["فَأَظَلَّهُ ملكٌ بِفَضلِ جَناحِهِ","فَاِنصاعَتِ اللَكعاء بِالحِرمانِ",21,"ن",1,0],["فَأَظلَّهُ سَفرٌ فَخافَ دُعاءَهُ","فَدَعا بِمَن مَعَهُ مِنَ الأَخدانِ",21,"ن",1,0],["فَأُظلَمُ دونَ الوَرى وَالأَنامِ","بِدَعوَتِكَ المَلِكَ العادِلا",22,"ل",2,0],["فَأَظْفَرَكَ الإِلَهُ بِكُلِّ بَاغٍ","وَأَخْدَمَكَ الْمُلُوكَ مِنَ الأَنَامِ",23,"م",1,0],["فأظل الزمان أدأب ادلاجا","ودأبي في فيحها الامتحان",24,"ن",1,0],["فأظل كالمسلوع من أفعى","النوي ورجاي وافي",25,"ي",1,0],["فأظفرَ من دنيايَ بالحبِّ والغِنى","وأملكَ حيناً مالها وجمالها",26,"ل",3,0],["فَأَظهَرَ الدَمعَ وَأَخفى زَفرَةً","خافَ عَلى الباناتِ مِن إِحراقِها",27,"ق",3,0],["فَأَظفارٌ مقلّمة وأيدي","مُغلّلةٌ وَجَمرات خمودُ",28,"د",1,0],["فَأَظهَرَ وُدّاً وَالعَداوَةُ سِرُّهُ","لِحاجَتِهِ كانَت إِلَيَّ فَأَسرَفا",29,"ف",2,1],["فَأَظعَنتَ مَن يَرجو الكَرامَةَ مِنهُمُ","وَخَيَّبتَ مَن يُعطي العَطاءَ المُكَرَّما",30,"م",2,0],["فأظن أن العلم قال لدهره","أفرده ينظر في رياض دفاتري",31,"ر",2,0],["فأظْهَرْتَ ممَّا أضمَرَتْهُ أضالع","ولله وَجْدٌ أضْمَرَتْه ضلوع",32,"ع",1,0],["فأَظْهَرَ مستوراً وأَبْرَزَ خافياً","وأَعرَب عمَّا في الضمير وتَرْجَما",33,"م",2,0],["فأَظْلَمَ بعدَنا الإِصباحُ فِيهَا","وكم دهرٍ أَضاءَ بِهَا المساءُ",34,"ا",2,0],["فإظهار وإيلاء وحيض","وصوم ثم حج واعتكاف",35,"ف",1,0],["فاظهر التوبة عن جرمه","لكنه استبطن عصيانها",36,"ن",3,0],["فاظلم منه الوجه والقلب كله","ويصلي غدا ناراً لظاها تسعرا",37,"ر",2,0],["فأَظْهَرَني رَبِّي بسِرٍّ مُطَلْسَمٍ","وبالمَدَدِ المَحْضِ الإِلهيِّ رَبَّاني",38,"ي",1,0],["فأظهر سُنة الله احتساباً","فقد ظهرت بها البِدعُ العظام",39,"م",1,0],["فَأَظفَرَ كُلَّ ذي أَمَلٍ","يُسَرُّ بِهِ بِما أَمَلا",40,"ل",2,0],["فَأَظهَرَ اللَهُ إِذ يَدعو حَوافِرَهُ","وَفازَ فارِسُهُ مِن هَولِ أَخطارِ",41,"ر",1,0],["فاظهر لهم منهم بهم","واشهدْ تكن عين الشهيد",42,"د",1,0],["فَأَظَلُّ فِيْكَ مُخَالِفَاً","أَهْلَ التَّسَلِّيَ والتَّأَسِّي",43,"س",2,0],["فأظل أبهج في النهار بقربه","وأُريه كيف تناقُلُ العلياءِ",44,"ا",2,0],["فأظهروا السمع له والطاعة","وبايعوه بيعة الجماعة",45,"ه",1,0],["فأظهر الفسوق والمعاصي","وكان بالحجاز عنه قاصي",45,"ي",1,0],["فَاظْفِرْ إِباءَكَ إِنْ أَمِنْتَ قِيَادَها","أَمْنَ الْجَسُورِ؛ فَقَدْ ضَمِنْتَ هُدَاها",46,"ا",3,0],["فأَظنُّهُمْ ظَنُّوا طَرِيقَكَ وَاحِداً","وَنَسوا بِأَنَّكَ جَامِعُ الأَشْتَاتِ",47,"ت",1,0],["فأظلمت بعدهم أجراؤه وعفت","واستحكم الجهل في الأقطار حين طما",48,"م",2,0]]}