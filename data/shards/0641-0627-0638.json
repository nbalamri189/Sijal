ttps://poetry.dctabudhabi.ae/diwan/poem/33209","الطويل"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104948","الوافر"],[4670,"","https://poetry.dctabudhabi.ae/diwan/poem/143617","الكامل"],[4689,"دوح المدائح","https://www.poetsgate.com/ViewPoem.aspx?id=152847",""],[4767,"دوحة الخلد","https://www.poetsgate.com/ViewPoem.aspx?id=179942",""],[4767,"ارحميني","https://www.poetsgate.com/ViewPoem.aspx?id=212596",""],[1012,"لقد دارت على رغم الحسود","https://www.poetsgate.com/ViewPoem.aspx?id=124956",""],[4852,"هل شيء يخفي بالفتاة حنينها","https://www.poetsgate.com/ViewPoem.aspx?id=214694",""],[4858,"غفلة وتوبة","https://www.poetsgate.com/ViewPoem.aspx?id=30104",""],[4858,"من وحي حُلُم","https://www.poetsgate.com/ViewPoem.aspx?id=137597",""],[4888,"مدرسة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=207751",""],[5183,"بين الهيمنة والهينمة","https://www.poetsgate.com/ViewPoem.aspx?id=180155",""],[5239,"عرس بجزين يا مستعبد النجف","https://www.poetsgate.com/ViewPoem.aspx?id=190941",""],[5277,"صريخُ القوافي..","https://www.poetsgate.com/ViewPoem.aspx?id=206053",""],[592,"لعمرك ما يدري الغبي بأنه","https://www.poetsgate.com/ViewPoem.aspx?id=128805",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5376,"النفسُ تسعى الى اللذات تقصدُها","https://www.poetsgate.com/ViewPoem.aspx?id=188408",""],[5376,"قد زاد شوقي كما النيران فاحتدما","https://www.poetsgate.com/ViewPoem.aspx?id=188561",""],[5381,"رياح طيبة","https://www.poetsgate.com/ViewPoem.aspx?id=215670",""],[5442,"دع الصب يدمع منه المآقيا","https://www.poetsgate.com/ViewPoem.aspx?id=114761",""],[5596,"مجاراة قصيدة الحاسد","https://www.poetsgate.com/ViewPoem.aspx?id=206695",""],[5650,"امْلأْ فُؤادَكَ بِالْحَبيب","https://www.poetsgate.com/ViewPoem.aspx?id=131222",""],[5818,"الحبّ بيتٌ بابه الإحساس","https://www.poetsgate.com/ViewPoem.aspx?id=199974",""],[6090,"هدمت للمجد والعلياء أركانا","https://www.poetsgate.com/ViewPoem.aspx?id=170920",""],[6093,"إنِّيْ وإنْ كُنْتَ كُلِّيْ","https://www.poetsgate.com/ViewPoem.aspx?id=204933",""],[463,"سألَ اللِّوى وسؤالهُ إلحافُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60147&r=&rc=203",""]],"verses":[["فَأَظعَنتَ وِترَكَ مِن دارِهِم","وَوِترُكَ في دارِهِم لَم يُقِم",0,"م",1,0],["فَأَظمَأُ حَتّى تَرتَوي البيضُ وَالقَنا","وَأَسغَبُ حَتّى يَشبَعَ الذِئبُ وَالنَسرُ",1,"ر",1,0],["فاظلموا جُهدَكم فلن تستطيعوا","أبداً أن تُوغِّروا الأحْشاءَ",2,"ا",2,0],["فاظنُن بكلبٍ شامَ في","ه الليثُ مِخْلَبَهُ ونابهْ",3,"ب",2,0],["فأظهره الإله لنا بعمرٍو","أبي الخرطوم ذي الأنفِ الرئيس",4,"س",1,0],["فَأَظهَرَ التيهَ مِن جَهلٍ وَقابَلَني","بِسَيِّئٍ لَم يَكُن مِن حَقِّ مِقدارِ",5,"ر",1,0],["فأظهرتَ الزَّمانةَ في زَمانٍ","حَزَزتَ به من اللَّذَّاتِ عُضوا",6,"و",2,0],["فأظلمَتِ الآفاقُ بعدَ محمدٍ","فسِيَّانِ منها ليلُها ونَهارُها",7,"ر",3,0],["فَأُظهِرُ حَيرَةً في بَسطِ عُذري","وَأُخفي ما يُجِنُّ لَكُمُ جَناني",8,"ن",2,0],["فَأَظَلُّ أَقنَعُ بِالخَيالِ وَإِنَّهُ","طَمَعٌ يُوَلِّدُهُ الخَيالُ الفاسِدُ",9,"د",1,0],["فَأَظلَمَ قَرنُ الشَمسِ وَهيَ مُنيرَةٌ","وَضاقَت بِلادُ اللَهِ وَهيَ رِحابُ",10,"ب",1,0],["فَاِظفِر بِحَظِّكَ مِن أَخٍ","مُتَدَفِّقِ الشَرَباتِ ماجِد",11,"د",1,0],["فَاظْنُنْ بِعَال مَنْصِباً وَوَظِيفَةً","مَا اغْتَابَهُ الحُسَّادُ أَوْ مَا اغْتَابَا",12,"ب",2,0],["فَاظْفَرِ الْيَوْمَ مِنْ بَنِيهَا وَمِنْهَا","خَالدَ الذِّكْرِ بِالْجَزَاءِ الْوِفَاقِ",13,"ق",1,0],["فَاظْنُنْ بِمَنْ يَغْتَابُ مَقْتُولاً وَقَدْ","أَعْيَا فَمَا يَسْطِيعُ نُبْسَةَ عَاقِبِ",14,"ب",1,0],["فَاظْنُنْ بِرَوْعَتِهَا وَسُرْعَةِ عَدْوِهَا","نحْوَ العَقِيقِ وَدَمْعِهَا المُتَسَاكِبِ",15,"ب",1,0],["فاظَ الَّذي كُنتُ أَرتَجي أَن","يَقوى بِهِ رُكني الضَعيفُ",16,"ف",1,0],["فأظهرت فيه عزة الملك والعلا","ولم تلغِ حقَّ الحمد والشكر للربِّ",17,"ب",1,0],["فاظفر بها يا بن قطبٍ وامض لما","أُمرت فيها فعقبي صابها عسلُ",18,"ل",1,0],["فَأَظهرت مِن قربهِ الإباءَ","فَقيلَ أدّ مَهرها سواءَ",19,"ا",2,0],["فَأَظهَرَ اللَهُ نَصرَ المُسلِمينَ بِهِ","وَكُلُّ فاحِشَةٍ عَن دينِهِم دَفَعا",20,"ع",2,0],["فَأَظَلَّتاهُ وَعادَتا فَإِذا هُما","فَوقَ العُروقِ الخُضرِ قائِمَتانِ",21,"ن",1,0],["فَأَظَلَّهُ ملكٌ بِفَضلِ جَناحِهِ","فَاِنصاعَتِ اللَكعاء بِالحِرمانِ",21,"ن",1,0],["فَأَظلَّهُ سَفرٌ فَخافَ دُعاءَهُ","فَدَعا بِمَن مَعَهُ مِنَ الأَخدانِ",21,"ن",1,0],["فَأُظلَمُ دونَ الوَرى وَالأَنامِ","بِدَعوَتِكَ المَلِكَ العادِلا",22,"ل",2,0],["فَأَظْفَرَكَ الإِلَهُ بِكُلِّ بَاغٍ","وَأَخْدَمَكَ الْمُلُوكَ مِنَ الأَنَامِ",23,"م",1,0],["فأظل الزمان أدأب ادلاجا","ودأبي في فيحها الامتحان",24,"ن",1,0],["فأظل كالمسلوع من أفعى","النوي ورجاي وافي",25,"ي",1,0],["فأظفرَ من دنيايَ بالحبِّ والغِنى","وأملكَ حيناً مالها وجمالها",26,"ل",3,0],["فَأَظهَرَ الدَمعَ وَأَخفى زَفرَةً","خافَ عَلى الباناتِ مِن إِحراقِها",27,"ق",3,0],["فَأَظفارٌ مقلّمة وأيدي","مُغلّلةٌ وَجَمرات خمودُ",28,"د",1,0],["فَأَظهَرَ وُدّاً وَالعَداوَةُ سِرُّهُ","لِحاجَتِهِ كانَت إِلَيَّ فَأَسرَفا",29,"ف",2,1],["فَأَظعَنتَ مَن يَرجو الكَرامَةَ مِنهُمُ","وَخَيَّبتَ مَن يُعطي العَطاءَ المُكَرَّما",30,"م",2,0],["فأظن أن العلم قال لدهره","أفرده ينظر في رياض دفاتري",31,"ر",2,0],["فأظْهَرْتَ ممَّا أضمَرَتْهُ أضالع","ولله وَجْدٌ أضْمَرَتْه ضلوع",32,"ع",1,0],["فأَظْهَرَ مستوراً وأَبْرَزَ خافياً","وأَعرَب عمَّا في الضمير وتَرْجَما",33,"م",2,0],["فأَظْلَمَ بعدَنا الإِصباحُ فِيهَا","وكم دهرٍ أَضاءَ بِهَا المساءُ",34,"ا",2,0],["فإظهار وإيلاء وحيض","وصوم ثم حج واعتكاف",35,"ف",1,0],["فاظهر التوبة عن جرمه","لكنه استبطن عصيانها",36,"ن",3,0],["فاظلم منه الوجه والقلب كله","ويصلي غدا ناراً لظاها تسعرا",37,"ر",2,0],["فأَظْهَرَني رَبِّي بسِرٍّ مُطَلْسَمٍ","وبالمَدَدِ المَحْضِ الإِلهيِّ رَبَّاني",38,"ي",1,0],["فأظهر سُنة الله احتساباً","فقد ظهرت بها البِدعُ العظام",39,"م",1,0],["فَأَظفَرَ كُلَّ ذي أَمَلٍ","يُسَرُّ بِهِ بِما أَمَلا",40,"ل",2,0],["فَأَظهَرَ اللَهُ إِذ يَدعو حَوافِرَهُ","وَفازَ فارِسُهُ مِن هَولِ أَخطارِ",41,"ر",1,0],["فاظهر لهم منهم بهم","واشهدْ تكن عين الشهيد",42,"د",1,0],["فَأَظَلُّ فِيْكَ مُخَالِفَاً","أَهْلَ التَّسَلِّيَ والتَّأَسِّي",43,"س",2,0],["فأظل أبهج في النهار بقربه","وأُريه كيف تناقُلُ العلياءِ",44,"ا",2,0],["فأظهروا السمع له والطاعة","وبايعوه بيعة الجماعة",45,"ه",1,0],["فأظهر الفسوق والمعاصي","وكان بالحجاز عنه قاصي",45,"ي",1,0],["فَاظْفِرْ إِباءَكَ إِنْ أَمِنْتَ قِيَادَها","أَمْنَ الْجَسُورِ؛ فَقَدْ ضَمِنْتَ هُدَاها",46,"ا",3,0],["فأَظنُّهُمْ ظَنُّوا طَرِيقَكَ وَاحِداً","وَنَسوا بِأَنَّكَ جَامِعُ الأَشْتَاتِ",47,"ت",1,0],["فأظلمت بعدهم أجراؤه وعفت","واستحكم الجهل في الأقطار حين طما",48,"م",2,0],["فَاِظعَني فَاِلحَقي بِقَومِكِ إِنّي","لا أَرى أَن أُقيمَ فيكُم غَريبا",49,"ب",2,0],["فأظهروا اليوم رشف الخد","ود والرشف يشفي",50,"ف",2,0],["فَأظلمت مُذ مَضى عَنا مساجدُنا","وَكُلُّها مِن مَصابيح القِيام خَلا",51,"ل",2,0],["فأظلمَ اليومُ عِندي","وكدتُ في الحال أُمْسي",52,"س",2,0],["فأظهر لي مَحضَ الضّياءِ ظلامُهُ","كحِبرِ بليغٍ في افادتهِ مَعنَى",53,"ن",2,0],["فاظَت إلى تلك الليالي مُهجَتي","شوقاً وكان على يديك فُواظي",54,"ظ",2,0],["فَأَظهَرَ مِن آياتِهِ آيةً لَنا","وَهاتيكَ خطف العَقلِ مِن داخِلِ القَلبِ",55,"ب",1,0],["فأظهرت سرورها إظهارا","وفككت من طوقها الأزرارا",56,"ر",2,0],["فَأَظَلّ بَينَ رِضىً وَسُخطٍ واقِفاً","أَرجو مَواعِدَها وَأَكرَهُ بُخلَها",57,"ل",3,0],["فأظلُّ في تلكَ المهامهِ ناشداً","بِغرائبِ الأشعارِ فوق رحالهِ",58,"ل",2,0],["فأظهره المختارُ بعد خفائه","فقامت به أجزاؤه تتركَّب",59,"ب",1,0],["فَأظهرا المَوت فَألقى البوما","وَقالَ مَن يَأخُذ ذا المَشؤوما",60,"م",2,0],["فأظهرت منه ما تحرك أو سكن","ولم يك إلا ما تكونه ولن",61,"ن",1,0],["فأظلمتِ الدّنيا غداةَ مسيرِكم","إلى أن تساوى كلُّ صُبحٍ وغَيهب",62,"ب",1,0],["فأظلم يومهم في الطف يقظى","وأصبح صبحه وهم رقود",63,"د",1,0],["فأظهرتم له الأضغان منكم","وكنتم من حجاه ساخرينا",64,"ن",2,0],["فأظهره قهرا على الدين كله","برغم على أهل النفاق ومن كفر",65,"ر",1,0],["فَأَظلَمَ في ذاكَ المَكانِ نَهارُهُ","وَأَشرَقَ في ذاكَ المَكانِ ظَلامُهُ",66,"م",2,0],["فَاظهَر بِما سَيشُدُّ ظَهرَكَ وَاِصطَنِع","ظَهراءَ مِن أَهلِ التُّقى فَهُمُ هُمُ",67,"م",1,0],["فَأَظلُّ حُرّاً مِن مَذّلَّتِها","وَالحُرُّ حينَ يُطيعُها عَبدُ",68,"د",1,0],["فاظهر علينا قبل أن","يظهر بالدين العفا",69,"ف",2,0],["فأظهرتُها للعينِ شمساً منيرةَ","على صِفة تفني الزوائدَ فاضله",70,"ل",2,0],["فأظهرن وجداً كامنا في خليسة","ودمعا ً له فوق الخدود حدودُ",71,"د",1,0],["فأظهرت نَورَ نَيلو","فَرٍ مُنيرٍ أَغرِّ",72,"ر",1,0],["فاظفر بصفو الأفق قبلَ غروبِها","واستنطقِ المثنى وحثّ الراحا",73,"ح",2,0],["فأظلاَّ شاطئيه واطلعا","مطلعَ السُّحبِ وسوقاها رهاما",74,"م",2,0],["فأظهر العطف على عبده","بمنطق يزري بنظم اللآل",75,"ل",1,0],["فاظهر سراً كان منتظراً له","نتائج قامت قأقوم برهان",76,"ن",1,0],["فأظهر الحق وهو خاف","في حجج لم تكد تبين",77,"ن",1,0],["فأظهَرَ الدُّرَّ مِن مكنُونِ جَوهَرِهِ","مِن كُلِّ عِلمٍ وَمِن أسحارِ الأشعَار",78,"ر",1,0],["فأظلُّ إن نقدوه أنكرُ قربتي","منه وان مدحوه قلت قريبي",79,"ب",2,0],["فأظلّ أسأل كل من لاقيته","أأخي على أهلي بربك دُلّني",80,"ن",2,0],["فأظل حيراناً أجوب مناهجاً","علي أوفق للطريق الموصل",81,"ل",1,0],["فَأَظلَمَ لَيلي بَعدَ ما كُنتُ مُظهِراً","وَفاضَت دُموعي لا يُهِبنَ بِأَضرَعا",82,"ع",2,0],["فأظلمت الدنيا عليهم واحدقت","بأرضهم الاخطار حشداً على حشد",83,"د",1,0],["فأظفر تارة وأخيب أخرى","ولا أستاء من طول اجتهاد",84,"د",1,0],["فاظفر بدينك لا تطلب به بدلا","وفارق الاهل والاوطان لا ترم",85,"م",1,0],["فأظهر سلوانا وأضمر لوعةً","إذا طفئت نيرانها وقدت وقدا",86,"د",2,0],["فأظهرت للأعداء وجه سماحة","وأبرزت للأحباب وجها من النكر",87,"ر",1,0],["فأظهر سلواني بهذا وتارة","بهذا بتمويه وغيرهما قصدي",88,"د",2,0],["فأظْهَرَ منهُم كلَّ بدْرٍ مُتمَّمٍ","وأضْحى إلى شمْسِ الضحى أيَّ كاتِمِ",89,"م",1,0],["فاظلمت كل الجهات بعده","والدهر حزناً حسنه مستلب",90,"ب",1,0],["فاظَ قلبي وفاضَ حُزناً فراعا","هُ وعَزَّ النظيرُ جفنٌ طَفُوحُ",91,"ح",1,0],["فَأَظنّ الدوّ بَيتي","وَإِخالُ الوَحشَ آلي",92,"ل",2,0],["فأظلمت في عصره الآفاق","وعمها الشقاق والنفاق",93,"ق",1,0],["فاظفر بذات الدين فالدين عن","جماحهن الوازع الأكبر",94,"ر",1,0],["فَأظهرَ وَالحربا يَنوفُ بِعودِهِ","مولٍ فقاهُ الشَمسَ يَخدينَ رُفَّعا",95,"ع",2,0],["فأظهر الحق يزهو وجه طلعته","وأخمد الشرك والطغيان إخمادا",96,"د",2,0],["فأظهره للذي يفهمُ","وأكتمه خوف مقت الجهولْ",97,"ل",1,0],["فاظت نفوسهم عليك خلاعة","للَه أدمية يباح حرامها",98,"م",3,0],["فأظهر سلواناً وأضمر لوعةً","إذا أطفئت نيرانها وقدت وقدا",99,"د",2,0],["فاظهر اليه تحسرا","لَو كن