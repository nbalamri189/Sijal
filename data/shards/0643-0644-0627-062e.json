{"poems":[[95,"عشيرة الأحرار في مأتم","https://www.aldiwan.net/poem11353.html","السريع"],[72,"لنا صديق ولا نسميه","https://www.aldiwan.net/poem42421.html","المنسرح"],[47,"كل أخلاق علي","https://www.aldiwan.net/poem66643.html","مجزوء الرمل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140990",""],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[409,"كل أخبار الهوى قد رويت","https://www.aldiwan.net/poem34111.html","الرمل"],[519,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131987","الكامل"],[4708,"صرخة غضب","https://www.poetsgate.com/ViewPoem.aspx?id=12191",""],[5187,"ضحايا بين الألم","https://www.poetsgate.com/ViewPoem.aspx?id=29258",""],[5953,"يدعون بالناس إخواناً وقد كذبوا","https://www.poetsgate.com/ViewPoem.aspx?id=93815",""]],"verses":[["كُلُّ أَخٍ مِنْهُمْ لَهُ مُهْجَةٌ","تَدْمَى عَلَى ذَاكَ الأَخِ الأَكْرَمِ",0,"م",1,0],["كُلُّ اِختِلافٍ وَكُلُّ مَخرَقَةٍ","فيهِ فَيا لَيتَهُ بِلا فيهِ",1,"ه",1,0],["كُلُّ أَخلاقِ عَليٍّ","نَجتَويها وَنَذُمُّه",2,"م",2,1],["كل آخائه كرام بنى الدّن","يا ولكنّه كريم الكرام",3,"م",1,0],["كُلُّ أَخٍ زَوَّارُ","وإِن تَناءَت دارُ",4,"ر",1,0],["كل أخبار الهوى قد رويت","عن غرامي وإليه عزيت",5,"ت",1,1],["كلُّ أخبارِ المعالي والنّدى","عنكمُ صحّتْ ومنكُم مُبتداها",6,"ا",3,0],["كل أخي ألف الغرا","م وكلنا في الحسن صب",7,"ب",1,0],["كل أخلاقه فضايل ساطعة بنور سنيا","للأمم صارت دروس وللحضارة منهجية",8,"ي",2,0],["كلُّ أُخواني تَحامى جَهلُها","ليسَ فيهمْ مَن يُراعي زَلَّتي",9,"ت",2,0],["كل أخ نفسه من دون صاحبه","فما ترى أحداً منهم أخا أحد",10,"د",1,0]]}