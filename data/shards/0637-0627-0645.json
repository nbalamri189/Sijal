{"poems":[[55,"قعد الراضون بالذل فقم","https://www.aldiwan.net/poem29750.html","الرمل"],[55,"من شافعي وذنوبي عندها الكبر","https://www.aldiwan.net/poem30415.html","البسيط"],[4,"إن تقوى ربنا خير نفل","https://www.aldiwan.net/poem21191.html","الرمل"],[53,"ولع الزمان بأن يحرك ساكنا","https://www.aldiwan.net/poem66698.html","الكامل"],[46,"يا دهر قدك وقلما يغني قدي","https://www.aldiwan.net/poem30317.html","الكامل"],[107,"رب أحببني وأحبب أسرتي","https://www.aldiwan.net/poem43384.html","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202528","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/29753","الرجز"],[107,"رب أحببني وأحبب أسرتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54874&r=&rc=44",""],[124,"غذائي الحب يا من فيه حرمان","https://www.aldiwan.net/poem49336.html","البسيط"],[147,"هل للأماني عن جنابك مدفع","https://www.aldiwan.net/poem11771.html","الكامل"],[231,"طليعة الضحايا","https://www.aldiwan.net/poem24202.html","عموديه"],[259,"أقبلي","https://www.aldiwan.net/poem25015.html","مجزوء الرمل"],[280,"عبر البحر يؤم الأبحرا","https://www.aldiwan.net/poem25568.html","الرمل"],[369,"أحضر الليل منك عقدا وثغرا","https://www.aldiwan.net/poem60893.html","الخفيف"],[369,"في الجيرة الغادين بدر","https://www.aldiwan.net/poem60895.html","مجزوء الكامل"],[463,"أنذرتني أم سعد أن سعدا","https://www.aldiwan.net/poem56214.html","الرمل"],[463,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[466,"تنيخ منه معمل المطي","https://www.aldiwan.net/poem16161.html","الرجز"],[563,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87272","الرمل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87228","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64367","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120067","السريع"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216916","الخفيف"],[2231,"","https://poetry.dctabudhabi.ae/diwan/poem/124056","الكامل"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126215","الخفيف"],[133,"","https://poetry.dctabudhabi.ae/diwan/poem/104647","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100211","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132608","السريع"],[3411,"","https://poetry.dctabudhabi.ae/diwan/poem/79758","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74065","المتدارك"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62939","المنسرح"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205484","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72350","الخفيف"],[4884,"الخط صنعة","https://www.poetsgate.com/ViewPoem.aspx?id=210386",""],[194,"ما بالُ عَينٍ شَوقُها استَبكاها","https://www.poetsgate.com/ViewPoem.aspx?id=51514",""],[6031,"قُلْ لِمَنْ فَاقَتِ البُدُورَ كَمَالا","https://www.poetsgate.com/ViewPoem.aspx?id=46311",""]],"verses":[["طامِحَ الرَأسِ عَلى أَعوادِهِ","أَو عَلى عالِيَةِ الرُمحِ الأَصَمّ",0,"م",1,0],["طَأمِن رَجاءَكَ لا الأَطوادُ مورِقَةٌ","يَوماً وَلا جَندَلُ البَقعاءِ مُعتَصَرُ",1,"ر",1,0],["طامِيَ العَرمَضِ لا عَهدَ لَهُ","بِأَنيسٍ بَعدَ حَولٍ قَد كَمَل",2,"ل",1,0],["طامِنْ حشاكَ أخا البقاء لدائهِ","فلتَزجُرنَّ أشائماً وأَيامنا",3,"ن",2,0],["طامِن حَشاكَ أَبا الحُبابِ فَإِنَّها","نُوَبٌ تَروحُ عَلى الأَنامِ وَتَغتَدي",4,"د",2,0],["طامِياتٍ يَتَرامى مَوجُها","بِالأَماني حائِراتِ السُفُنِ",5,"ن",1,0],["طام من الوحي فرات المشرع","في زاخر من الحديث مترع",6,"ع",1,0],["طامي العُبابِ صَخِبَ الأواذي","ندىً قُواماً في عُلاً أفْذاذِ",7,"ذ",1,0],["طامياتٍ بترامى موجها","بالأماني حائرات السفن",8,"ن",1,0],["طامن رجاءك لا الآمال نافعةٌ","يوماً ولا لربيع الحب غشيان",9,"ن",1,0],["طامٍ وَما يُخشى عَلى رُكّابِهِ","غَرَقٌ وَمَركَبُهُ مُقيمٌ مُقلِعُ",10,"ع",1,0],["طامس الآثار مجهول الخطى","لا دليل ، لا شعاع ، لا ضياء",11,"ا",2,0],["طامعٌ في يومِ وَصْلٍ","لا يُحاكي يوم َ غَيْبِ",12,"ب",1,0],["طَامِحَ الهِمّة لا مُقْتَصِداً","في تَرَقِّيهِ وَلا مُقْتَصِرا",13,"ر",2,0],["طامعاً في فُضولِ عيشٍ أَحُثُّ ال","عيسَ والعُمْرُ شَطْرُه الغَضُّ مَرّا",14,"ر",2,0],["طامي عُبابِ العِلمِ حتْ","تَى ليس يُدرَكُ منه قَعر",15,"ر",1,0],["طَأْمنَ الجوُّ لها وانحدرت","قُلل الأجبال حتى كنّ وُهْدا",16,"د",2,0],["طامَنَ في الرمل له قانصٌ","أعجفُ لم يُحمِض ولم يُرطِبِ",17,"ب",1,0],["طامحةً للرَّغَدِ الرِّيفِيِّ","إلى كريم النَّجْرِ خِنْدِفِيِّ",18,"ي",1,0],["طامي الندا للبرايا قايد الكرم","قامي العدا بالعطايا زايد الهممِ",19,"م",1,0],["طامعٍ في نَقض أَمرِ","قاصمٌ ظَهرَ الخُصومِ",20,"م",1,0],["طامِعاً في نجاز وَعد كَريم","مِنهُ أَضحى عَلى السؤال جريا",21,"ي",2,0],["طامحاً طرفه إلى","أهله حين يطمحُ",22,"ح",1,0],["طامي بحار الجود هامي الندى","عالي منار المجد زاكي الحسب",23,"ب",1,0],["طامِحُ الطّرْفِ لا يُدَنّسُ عِرْضِي","طَمَعٌ عندَ ناقِصٍ مَرْزُوقِ",24,"ق",1,0],["طامي الغوارب قاذف أرجاؤُه","بالدر والياقوت والمرجان",25,"ن",1,0],["طامِعاً فى مُنَاىَ لستُ بِكُفوِى","نِلتُهُ الخلقَ ملكَةً تَسلِيطاً",26,"ط",2,0],["طامحاتٍ تَطلُبُ الشيءَ","وتأبى حينَ تَلقى",27,"ق",2,0],["طامح ينشد القطيع مضل","عارض الركب شارداً مستريبا",28,"ب",2,0],["طامعة في نيل اخطارها","آمنة من هول اخطارها",29,"ه",2,0],["طامحُ الطّرفِ لا يدنّسُ عِرضي","طَمعٌ في مدى الكرامِ رفيقُ",30,"ق",1,0],["طامِعٌ كَوى","بطنَهُ القَرَم",31,"م",1,0],["طامِنْ لها الصَّاد من نواظرِها","واكبحْ لها من شَكِيمِهَا الحكَمَا",32,"م",2,0],["طامع الغرب رعى الدنيا وهامْ","أنا أرعاها ولكن لا أهيمْ",33,"م",1,0],["طامعاً منهم ومن لدن هكطو","ر بكسب الثنا ونيل الفخار",34,"ر",1,0],["طامع من نواله بكثير","ما أنا منه قانع بقليل",35,"ل",1,0],["طامعاً أَسعى لأَمْرٍ","مازجاً أَختارُ جَمْعَهْ",36,"ع",2,0],["طامِسَةِ الأعلامِ قَد مَحاها","تَقادُم مِن عَهدِها أَبلاها",37,"ا",3,0],["طَامِحاً في جَهَالتِي لا أرَى الرُّشْ","دَ صَلاحاً ولا الفَسَادَ ضَلالا",38,"ل",2,0]]}