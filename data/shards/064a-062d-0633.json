70",""],[5664,"الدستور","https://www.poetsgate.com/ViewPoem.aspx?id=176682",""],[5672,"ما لم يقله رؤبة بن العجاج","https://www.poetsgate.com/ViewPoem.aspx?id=213612",""],[5712,"يا لقريش بينوا الكلاما","https://www.poetsgate.com/ViewPoem.aspx?id=52745",""],[5725,"حينما شد للمفاتن عضدا","https://www.poetsgate.com/ViewPoem.aspx?id=210589",""],[5770,"صديقي الصامت","https://www.poetsgate.com/ViewPoem.aspx?id=178683",""],[5770,"حُلُم","https://www.poetsgate.com/ViewPoem.aspx?id=178691",""],[5776,"الجبينُ والمخدة","https://www.poetsgate.com/ViewPoem.aspx?id=199341",""],[5848,"طعنة احباب","https://www.poetsgate.com/ViewPoem.aspx?id=50596",""],[5956,"إليك تفتحتْ ورداتُ حبٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=182073",""],[5956,"أرجو أن يزيد الله وعيي","https://www.poetsgate.com/ViewPoem.aspx?id=185669",""],[5956,"الظلم والطيبون","https://www.poetsgate.com/ViewPoem.aspx?id=192334",""],[5956,"بلالُ بلبلٌ غرّيدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=193095",""],[5956,"قد ازداد فقهاً بمعنى العمل","https://www.poetsgate.com/ViewPoem.aspx?id=193568",""],[5970,"يوقد النقمة في قلب الكريم","https://www.poetsgate.com/ViewPoem.aspx?id=130620",""],[5970,"سر هذا الدهر قد أعيا طلابي","https://www.poetsgate.com/ViewPoem.aspx?id=130576",""],[5976,"خالي راشد (مرثيّه)","https://www.poetsgate.com/ViewPoem.aspx?id=33700",""],[6041,"لَا تغبطن كل موفور الْغنى","https://www.poetsgate.com/ViewPoem.aspx?id=189050",""],[6044,"بوصلة","https://www.poetsgate.com/ViewPoem.aspx?id=18610",""],[6056,"نجاحي بعيد الإحتمال .....!","https://www.poetsgate.com/ViewPoem.aspx?id=130158",""],[6115,"الخطيه يوم ترسل علينا من سفيه","https://www.poetsgate.com/ViewPoem.aspx?id=185770",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577061",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577067",""],[5309,"يحسب المرء في ربيع شبابه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573878",""],[6229,"ليلى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65190&r=&rc=16",""],[6229,"مرآةُ عصرنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65213&r=&rc=36",""],[572,"وزائرٍ زَارَ وقد تَعَطَّرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9308&r=&rc=165",""]],"verses":[["يَحِسّونَ مِن أَعوادِهِ ثِقلَ وَطئِهِ","وَما أَثقَلَ الأَعناقَ إِلّا المَناقِبُ",0,"ب",1,0],["يحسُّ نبوغَ الحزن، من كلِّ حفرةٍ","يُشيرُ: سيرقى آخرُ الدَّفن أنبغا",1,"غ",2,0],["يَحسُدنَ وَجهَكِ يا ظَلومُ جَمالَهُ","هَيهاتَ ما لَكِ في الجَمالِ قَسيمُ",2,"م",1,0],["يُحسِنُ الظَنَّ بِهِ أَعداؤُهُ","حينَ لا يَحسُنُ ظَنٌّ بِقَريبِ",3,"ب",1,0],["يَحسَبُ الدارَ دارَهُ وَهوَ يَمشي","فَوقَ زاهي بِساطِكَ الأَحمَدِيِّ",4,"ي",1,0],["يُحسَب من درّ بتَمْوِيهه","وهو إذا حققته من سِخاب",5,"ب",1,0],["يَحسُبنَ لي في السنين خمسينَ تَك","بِيرِي والأربعينَ أحتَسِبُ",6,"ب",1,0],["يحسب لي في السنين خمسين","تكبيري والأربعين احتسب",7,"ب",1,0],["يَحسَبُ الحظَّ كله في يديه","وهو منه على مدى الجَوزاءِ",8,"ا",2,0],["يَحْسَبُه مَنْ بكاكِ مُمْتثلاً","مُنْسَكَبَ الدمعِ فيك مُنْسَكَبُهْ",9,"ب",2,0],["يَحْسُدُوني فضيلتي مثلَ مَا يَحْ","سُدُ بَعْلَ العَقِيلَة المجْبُوبُ",10,"ب",1,0],["يحسن في التجريد إثماره","وفي الشفوف الخضر إيراقه",11,"ق",2,0],["يُحِسُّ البلى مَيْتُ الحياةِ ولم يكُنْ","يُحِسُّ البِلى مَيْتُ المماتِ إذا أرمْ",12,"م",1,0],["يُحسَبُ الفَجرُ قَبسَةً مِن سَناها","وَنُجومُ السَماءِ بَعضَ حَلها",13,"ا",1,0],["يَحسُنُ أَن يُحسِنَ قَولاً وَعَمَل","يَذكُرُ إِن قالَ وَيَنسى ما فَعَل",14,"ل",1,0],["يَحسُدُها الخِنزيرُ إِذ","يُبصِرها مُنتَشِرَه",15,"ر",2,0],["يُحَسِّنُ عَقلَنا أَنّا","نَصيدُ البازَ بِالحُرَبِ",16,"ب",1,0],["يِحسدُ البعض بالمكاسب بعضا","حسدا كلكم به مقتول",17,"ل",1,0],["يحس القلب للقلب","صبابات وأشجانا",18,"ن",2,0],["يُحسبن من لين الكلام فواحشا","ويصدهن عن الخنا الإسلام",19,"م",1,0],["يَحسُنُ الدَهرُ بِهِم ما طَلَعوا","وَبِهِم يَزدادُ حُسناً آفِلين",20,"ن",1,0],["يَحسَبُ الظالِمونَ أَن سَيَسودو","نَ وَأَن لَن يُؤَيَّدَ الضُعَفاءُ",21,"ا",2,0],["يُحسَبُ الأُفقُ في جَناحَيهِ نورٌ","سُلِبَتهُ النُجومُ وَالجَوزاءُ",21,"ا",2,0],["يَحسَبُهُ دافِنُهُ وَحدَهُ","وَمَجدُهُ في القَبرِ مِن صَحبِهِ",22,"ب",2,0],["يَحسُنُ الذِكرُ عَنهُم وَالأَحادي","ثُ إِذا حَدَّثَ الحَديدُ الحَديدا",23,"د",2,0],["يَحسُدُ الطَيرَ فيهِ ضَبعُ البَوادي","وَهُوَ في غَيرِ حالَةِ المَحسودِ",24,"د",1,0],["يُحسَبُ الواحِدُ مِنهُم فِأَةً","جَمَّةً وَالعَينُ أَثمانُ الوَرِق",25,"ق",1,0],["يُحَسِّنُ مِن مَديحي فيكَ أَنّي","مَتى أَعدُد عُلاكَ أَجِد مَقالا",26,"ل",2,0],["يَحسِبُ الأَرطى زُها الجَيشِ وَمَن","تَنهَشِ الحَيَّةُ يُفزِعُهُ الرَسَن",27,"ن",1,0],["يُحسَدُ المَرءُ في النَعيمِ صَباحاً","ثُمَّ يُمسي وَعَيشُهُ مَذمومُ",28,"م",1,0],["يحسب الضيق آخذاً في حماه","بخناق ويحسب القوم أسرى",29,"ر",2,0],["يحسب الطودَ حصاةً حلمُهُ","وتظنّ البحرَ نعماهُ ثُغَب",30,"ب",1,0],["يَحْسَبُونَ الْحَيَاةَ فِي الذُّلِّ عَيْشاً","وَهْوَ مَوْتٌ يَعِيشُ فِيهِ اللِّئَامُ",31,"م",1,0],["يَحُسُّ مِن رِياحِهِ الشَمائِلِ","صَوارِماً تَرسُبُ في المَفاصِلِ",32,"ل",1,0],["يُحسَبنَ في القَناةِ شائِلاتِ","أَذنابَ خِرفانٍ مُرَكَّباتِ",33,"ت",1,0],["يَحْسُدُ الأولُ الأخيرَ وما زا","لَ كذا المُحْدَثُونَ وَالقُدَمَاءُ",34,"ا",2,0],["يُحسَبنَ مِن لينِ الحَديثِ زَوانِياً","وَيَصُدُّهُنَّ عَنِ الخَنا الإِسلامُ",35,"م",1,0],["يَحسُرُ الذَمَّ عَلى أَعطافِهِ","وَتَرى الحَمدَ عَلَيهِ كَالعَوَر",36,"ر",1,0],["يَحسُدنَ فَضلَ جَمالِها","لا تَعدَمي حَسَدَ الحَواسِد",37,"د",1,0],["يَحسُدنَ مِنها قَصَباً مالِئاً","لِلقُلبِ وَالخَلخالِ وَالمِعضَدِ",38,"د",1,0],["يَحسُدنَها ذاكَ إِلى صورَةٍ","قامَت بِها عِندي وَلَم تَقعُدِ",38,"د",1,0],["يُحسِدُ السَيِّدَ الجَوادَ عَلَيهِ","شِيَمٌ دونَها يَهيمُ الشَبابُ",39,"ب",1,0],["يَحسُنُ مَرأى لِبَني آدَمٍ","وَكُلُّهُم في الذَوقِ لا يَعذُبُ",40,"ب",1,1],["يَحسِبُ أَنَّ الصُبحَ بادٍ لَهُ","وَهوَ نَهاراً خابِطٌ في الظُلَم",41,"م",1,0],["يُحِسّ إذا الخَيَالُ دنا إلينا","فيَمْنَعُ من تَعَهّدِنا الخَيالا",42,"ل",2,0],["يُحِسّ وطءَ الرّزايا وهْيَ نازلةٌ","فيُنْهِبُ الجرْيَ نفْسَ الحادثِ المَكِرِ",43,"ر",1,0],["يحس لهم بالشكر قَلبي على الرضى","فيبدي لساني ما يحس به قَلبي",44,"ب",2,0],["يحسن الشاعر المبرز شدواً","مثلما الطير يحسن الألحانا",45,"ن",2,0],["يحسبُ الناظرون في الأفق منه","حُمرة الورس أو مزيجَ السُّلافِ",46,"ف",1,0],["يحُسُّ الخيالَ إذا ما سَرَى","ويلمسُ ما في ضميرِ الخفاء",47,"ا",2,0],["يَحْسَبُهَا الضّبُّ إذا أُلْقِيَتْ","في أرْضِها الغَبَرَاءِ عُثْنونَ سَيْل",48,"ل",1,0],["يَحْسَبُ تِيهاً أَنَّهُ","غَزَا الخُلُودَ فَانْتَصَرْ",49,"ر",1,0],["يَحْسُو دَمَ الْقَتْلَى فَأَظْمِىءْ بِهِ","ويَنْهَشُ اللَّحْمَ فما أَجْشَعَا",50,"ع",2,0],["يحسُدُ القصرُ كوخَه! رُبَّ كُوخ","هو للأمن والسلام مثابة",51,"ب",2,0],["يَحسَب الشَربُ أنهم علموا الغيب","وهم يخطئون ظَنّاً وَحدْسا",52,"س",2,0],["يُحْسَبُ الوَاحِدُ مِنْهُمْ فِئَةً","جَمّةً، والعَينُ أثْمانُ الوَرِقْ",53,"ق",1,0],["يَحْسِبُ الأرْطَي زُها الخيْلِ، وَمَنْ","تَنْهَسُ الحَيَّةُ يُفْزِعْهُ الرَّسَنْ",54,"ن",1,0],["يَحسَبُهَا أنها مِن فَضْلِ رُتْبَتِها","تُعدُّ واحدةً والبَحرُ ثانيها",55,"ي",3,0],["يحسب الفجر قبسه من سناها","ونجوم السماء بعض حلاها",56,"ا",3,0],["يحسبُهُ عطاردٌ عُطاردا","قولاً وحولاً صادراً وواردا",57,"د",2,0],["يَحْسَب العاشقون من شدةِ","التعذيبِ لا يبعثونَ خلقاً جديدا",58,"د",2,0],["يَحسِبُ الرِيحَ عَسكَرَه","وَنَعقَةَ اليَومِ نشيدَ القِيان",59,"ن",1,0],["يَحسَبُ الرَائِي المَرَايَا آلَها","حَيثُمَا الآلُ بِها خَبَّ وأَل",60,"ل",1,0],["يحسَبُ الهِمُّ عمرَه كلَّ حولٍ","فإذا استكثر الحسابَ تمنَّى",61,"ن",2,0],["يُحسّنُ بينَ الناسِ قُبحَ فِعالهم","وَمَهما أَساؤوا راحَ يلتمسُ العُذرا",62,"ر",2,0],["يَحسِبُ الناظِرونَ ما لَم يَفِرّوا","أَنَّها جِلَّةٌ وَهُنَّ فِتاءُ",63,"ا",2,0],["يحسدنا الناسُ على شعرهِ","وليسَ إلا في هواهُ وفي",64,"ف",2,0],["يحسرُ الشيخُ على شبابه","أزهى بهِ وكنتُ لا أزهى بهْ",65,"ب",2,0],["يحسبُ الناسُ طيبها نفسُ الصب","حِ على زهرةِ روضةٍ معطارِ",66,"ر",1,0],["يحسبُ الطفلُ أنه زمنُ الهمِّ","وما الهَمُّ يعرفُ الأطفالا",67,"ل",2,0],["يحسد الأتراك فيه العربُ","درمليٌّ للهوى ينتسبُ",68,"ب",1,0],["يحسُّ فَراديس الحَياةِ بِروحِهِ","وَليسَ يَرى إِلا جَحيماً يُهَدِّدُ",69,"د",1,0],["يَحسُنُ إيداعُ الجَمي","لِ عِندَهُ وَيَجمُلُ",70,"ل",1,0],["يَحسُدُني الناسُ عَلى مَورِدٍ","مُكَدَّرٍ يَنزَحُهُ الراشِفُ",71,"ف",1,0],["يُحسِنونَ الكَرَّ في يَو","مي سَماحٍ وَكِفاحِ",72,"ح",1,0],["يحسبُ النقد للقصيدةِ نَقداً","ويرى البيتَ في القصيدةِ دَارا",73,"ر",2,0],["يحسن لي الحلال فنحن طول ال","نهار اجتمعنا في جدال",74,"ل",1,0],["يُحَسِّنُ صَقلُنا ذَهباً ودرّاً","وليس يُغَيِّرُ الصَّقلُ الحديدا",75,"د",2,0],["يَحسَبُ البَحرَ طَريقاً يَبساً","فَهوَ يُجرِيهِ كَطرْف أجْرَدِ",76,"د",1,0],["يحسن الصبر من لو كان يعرف ما","ألقاه قال بحسن الصبر واعترفا",77,"ف",2,0],["يحسبُ أَنَّ البَركه","قد وَقَعَت في الشَبكَه",78,"ه",1,0],["يَحسدُ الروضُ لآلي نَظمِها","إِذ حَكاها من سَقيط الطَلِّ رشحُ",79,"ح",1,0],["يحسدُ الرَوضُ شذاها سَحَراً","فَترى الأَغصانَ سِرّاً تَتَناجى",80,"ج",2,0],["يحسُّ دبيبَها قلبي","وَيلمح رَيْبَها لبّي",81,"ي",1,0],["يَحسبُ المرءُ كلّ يوم أموراً","وَيفاجي ما ليس في الحسبانِ",82,"ن",1,0],["يَحسدُ الروضُ طرسَها وهي أدرى","بِمُداراةِ صارمٍ وعنانِ",83,"ن",1,0],["يحسَبُ الناس وهو منهم شياها","جهلوا أنّه إله الرعاة",84,"ه",1,0],["يحسُّ كأنّ له بالوجود","عهداً شطوناً طوته السماء",85,"ا",2,0],["يُحسِنُ القَولَ إِذا قالَ وَلا","يَتَحَرّى حَسَناً فيما فَعَل",86,"ل",1,0],["يَحسد الوَسميُّ نائِلهُ","وَأَخُو العَلياء مَحسودُ",87,"د",1,0],["يُحسبُ سكرانَ إذا كفُّه","سحَّت فما يَصحو ولا يُصحي",88,"ح",2,0],["يحسب الدهر عاقلاً","كامل الرأي مُحْذِقا",89,"ق",2,0],["يَحسر الطَرف ثَغرَهُ وَمَحيا","هُ بِفَرط الإِبراق وَالأَتلاق",90,"ق",1,0],["يحسب الصاحي مثل الثمل","ويرى أن الشجي مثل الخلي",91,"ل",2,0],["يَحسبهُ الجاني إذا ما بَدا","في كَفِّهِ النّارنجُ ناراً جَنى",92,"ن",2,0],["يحسبوني إذ رأوني وافداً","قد أتاهم من بقايا قوم عاد",93,"د",1,0],["يُحْسِنَّ لا عمدَا ويأ","تينَ الإساءَةَ باعتمادِ",94,"د",1,0],["يحسم الداء من الجهل وكم","حًسِم الجهل به فانحسما",95,"م",2,0],["يحسَبُ الليلَ قسْطَلاً ويظنّ ال","بَرْقَ والشُهْبَ أنصُلاً ورِماحا",96,"ح",2,0],["يحسدُ أهل العلوم قاطبةً","يسُبّ من فوقهُ بلا سبَبِ",97,"ب",1,0],["يحسب الدنيا له قد خلقت","يتباهى بفاد وفجور",98,"ر",1,0],["يحسب النصر مع الجمع الكبير","لم يدر في فكره ان الثبات",98,"ت",1,0],["يُحسَبنَ مِن لينِ الكَلامِ زَوانِيا","وَيَصُدُّهُنَّ