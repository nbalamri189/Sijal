{"poems":[[32,"تعرفت أطلالا فهاجت لك الهوى","https://www.aldiwan.net/poem29521.html","الطويل"],[91,"أحاطت بليل اليأس مني غياهب","https://www.aldiwan.net/poem44938.html","الطويل"],[2,"أمن أم أوفى دمنة لم تكلم","https://www.aldiwan.net/poem25065.html","الطويل"],[21,"جلبنا النصح تحمله المطايا","https://www.aldiwan.net/poem36188.html","الوافر"],[50,"تحدر ماء مقلته","https://www.aldiwan.net/poem62471.html","مجزوء الوافر"],[50,"إذا أجرى أمين الله","https://www.aldiwan.net/poem63434.html","الهزج"],[52,"فلما ودعونا واستقلوا","https://www.aldiwan.net/poem63852.html","الوافر"],[7,"ألا أبلغا ذبيان عني رسالة","https://www.aldiwan.net/poem1992.html","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62244","الطويل"],[136,"أشاقتك ورق اللوى هتفا","https://www.aldiwan.net/poem54796.html","المتقارب"],[164,"أتاها رسولي فاسمعوا ما جرا له","https://www.aldiwan.net/poem58988.html","الطويل"],[185,"ألا يا سلم عوجى تخبرينا","https://www.aldiwan.net/poem58837.html","الوافر"],[211,"ألم تر أني كرهت الحروب","https://www.aldiwan.net/poem27984.html","المتقارب"],[387,"ودار يقول لها الرائدو","https://www.aldiwan.net/poem434.html",""],[415,"ومن علقت بالصالح الملك كفه","https://www.aldiwan.net/poem32218.html","الطويل"],[415,"ألمياء إن شطت بنا الدار عنوة","https://www.aldiwan.net/poem32511.html","الطويل"],[460,"حللنا آمنين بخير عيش","https://www.aldiwan.net/poem26618.html","الوافر"],[500,"ألم ترني فارقت قيسي وخندفي","https://www.aldiwan.net/poem9856.html","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65096","السريع"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79501","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69350","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69326","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69336","المتقارب"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69329","المتقارب"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27445","الطويل"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67871","الهزج"],[2758,"","https://poetry.dctabudhabi.ae/diwan/poem/31506","المتقارب"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100736","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92378","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131272",""],[3591,"أظلّ أقول الشعر فيك توهّما","https://www.poetsgate.com/ViewPoem.aspx?id=149464",""],[5183,"فخري","https://www.poetsgate.com/ViewPoem.aspx?id=186477",""],[5190,"الطين والماء","https://www.poetsgate.com/ViewPoem.aspx?id=82169",""],[5786,"يميناً بها إن كنت للصبّ مُسعِدا","https://www.poetsgate.com/ViewPoem.aspx?id=50660",""],[5997,"الْأثَرُ","https://www.poetsgate.com/ViewPoem.aspx?id=214281",""]],"verses":[["فَلَمّا وَرَدنَ الماءَ في طَلَقِ الضُحى","بَلَلنَ أَداوى لَيسَ خَرزٌ يَبينُها",0,"ن",3,0],["فلما وصلنا ساء عينيَ أن ترى","هنالك أجداثاً عفاهن حاصب",1,"ب",1,0],["فَلَمّا وَرَدنَ الماءَ زُرقاً جِمامُهُ","وَضَعنَ عِصِيَّ الحاضِرِ المُتَخَيِّمِ",2,"م",1,0],["فَلَمّا واقَعَت صَنعاءَ صارَت","بِدارِ المُلِكِ وَالحَسَبِ العَريقِ",3,"ق",1,0],["فَلَمّا وَسَّدَتهُ الكَأ","سُ حَلَّ رِباطَ جُبَّتِهِ",4,"ت",2,0],["فَلَمّا وَدَّجَ الدَنَّ","وَسالَت خَمرُهُ راسا",5,"س",2,0],["فَلَمّا وَدَّعونا وَاِستَقَلّوا","عَلى صُهبٍ هَواديهِنَّ قودُ",6,"د",1,1],["فَلَمّا وَقاها اللَهُ ضَربَةَ فَأسِهِ","وَلِلبِرِّ عَينٌ لا تُغَمِّضُ ناظِرَه",7,"ر",2,0],["فَلَمَّا وَلَجْنَا أَمْكَنَتْ مِنْ عِنَانِهَا","وأَمْسَكْتُ عَنْ بَعْضِ الخِلاَطِ عِنَانِي",8,"ن",2,0],["فَلَمَّا وَنَوا سَلَّمُوا وأنثَنَوا","وظَلَّوا بِحَافَاتِهِ عُكَّفَا",9,"ف",2,0],["فلما وعت ما قال قالت قتلته","وان دام هذا راح لالي ولاله",10,"ل",2,0],["فَلمَّا واجَهُونا أَسلَمُوهُم","وَهَابُوا جانِباً مِنها زَبُونَا",11,"ن",2,0],["فَلَم أوقِدِ الحَربَ حَتّى رَمى","خُفافٌ بِأَسهُمِهِ مَن رَمى",12,"ا",1,0],["فَلَمّا وَضَعنا بِها بَيتَنا","نَتَجنا حُواراً وَصِدنا حِمارا",13,"ر",2,0],["فلمّا ورَى زندُ المعالي بِكفِّهِ","وقال نَداهُ للوفُودِ ألَا حُطّوا",14,"ط",3,0],["فلَمّا وصلْنَا بَرقَعيدَ تَحاشدت","عليَّ صَبَاباتِي وعنّفَني الرّكبُ",15,"ب",1,0],["فَلَمّا وَدَّعونا وَاِستَقَلَّت","بِهِم قُلُصٌ هَواديهِنَّ قودُ",16,"د",1,0],["فلما وردنا موسم الملك أقبلت","وفود الغنى واستقبلتنا بوادره",17,"ر",2,0],["فلَم أُؤخِّرْ خِدْمتي هذِهِ","تَأْخيرَ جانٍ يستَحِقُّ العِقاب",18,"ب",1,0],["فلما وهى من صيِّبِ المزنِ عقدُهُ","وأقبلَ يروي غلَّةَ النبتِ بل يشفي",19,"ف",2,0],["فلَمّا وَصَلنا المُدرِكيَّ ابنَ صالِحٍ","وَصَلنا إِلى باني عُروشِ المَكارِمِ",20,"م",1,0],["فَلَمّا وَصَلنَ المُدرِكي ابنَ صالِحٍ","وَصَلنَ أَجَلَّ الناسِ قَدراً وَأَفضَلا",21,"ل",2,0],["فَلمّا وَصَلنا أَبا صالِحٍ","وَصَلنا أَجَلّ مُلُوكِ الوَرى",22,"ا",1,0],["فَلَمّا وَجَدتُ بَني صالِحٍ","وَجَدتُ الغِنى وَعَدِمتُ العَدَم",23,"م",1,0],["فلم أو فسلم فالأمور كما ترى","وما هو عن حَدسِ وما هو عن ظنِّ",24,"ن",1,0],["فلمَّا وردَ الشَّيبُ","بِنَوعينِ من الوِردِ",25,"د",1,1],["فَلَمّا وَرَدنَ اِبتَدَرنَ الشُرو","عَ بَسطَ الأَكُفِّ لِأَخذِ العَوالي",26,"ل",2,0],["فَلَمّا وَرَدنَ صَدَرنَ النَقيلَ","كَأَوبِ مَرامي غَوِيٍّ مُغالي",26,"ل",2,0],["فلما وعى قمبيز ما قال لم يصخ","إلى النصح واستولى عليه ذهول",27,"ل",1,0],["فلم أَوقَّ الَّذي قَد كُنتُ أَجزعُهُ","لَكنّني لم أصاحب عبرةً حُبِست",28,"ت",1,0],["فلما وعى شيخها قولها","تيقن أن لها مأربا",29,"ب",2,0],["فلم أو أن أهوى سواك ولم أجد","عقيببك غصناً في اغصون متيّمي",30,"م",2,0],["فلم أوت ذا المال للإدخا","ر كما تحسب العادة الطاديه",31,"ي",2,0],["فَلَمَّا وَطِئتَ الأَرضَ واْنصَبَّ مِلحُهَا","بِفِيكَ .. وأَنتَ العَذبُ .. أَغرَتْكَ بِالظَّمَأْ",32,"ا",1,0],["فلمّا وعى عن هالت الخير ما وعى","وأصبح في علم الدّيانة أوحدا",33,"د",2,0],["فَلَمَّا وَصَلَنَا بَعْثُنَا الْوَصَايَا","وَصِيلًا محنَّىْ وَجَاءَ الْخبرْ",34,"ر",1,0]]}