{"poems":[[63,"خضاب على فودي للدهر ما نضا","https://www.aldiwan.net/poem46185.html","الطويل"],[3,"سأضمر وجدي في فؤادي وأكتم","https://www.aldiwan.net/poem202.html",""],[55,"إذا كان من يهوى يكاتم حبه","https://www.aldiwan.net/poem26114.html","الطويل"],[57,"سأضرب في طول البلاد وعرضها","https://www.aldiwan.net/poem24723.html","الطويل"],[49,"من الناس ميت وهو حي بذكره","https://www.aldiwan.net/poem10842.html","الطويل"],[88,"تجنب من سقيم الرأي قرباً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19584&r=&rc=87",""],[186,"هل المجد إلا دون ما أنت رافع","https://www.aldiwan.net/poem14573.html","الطويل"],[200,"أرى عقلي كساقية تدار","https://www.aldiwan.net/poem45403.html","الوافر"],[224,"بينما كان فتى المستقبل","https://www.aldiwan.net/poem41633.html","الرمل"],[276,"تمكن من مسامعه العذول","https://www.aldiwan.net/poem25544.html","الوافر"],[365,"أراقب من طيف البخيلة موعدا","https://www.aldiwan.net/poem60959.html","الطويل"],[459,"أدمعك أم عارض ممطر","https://www.aldiwan.net/poem56182.html","المتقارب"],[462,"خذوا من ذمامي عدة للعواقب","https://www.aldiwan.net/poem15082.html","الطويل"]],"verses":[["سأضْرِبُ أكْبادَ المَطِيِّ على الوجى","إِلى خَيْرِ مَنْ يُرْجى إذا الخَطْبُ نَضْنَضا",0,"ض",2,0],["سَأُضمِرُ وَجدي في فُؤادي وَأَكتُمُ","وَأَسهَرُ لَيلي وَالعَواذِلُ نُوَّمُ",1,"م",1,1],["سَأُضمِرُ صَبري عَنكِ لا عَن تَجَلُّدِ","وَلَكِنَّني أَطوي ضَميري عَلى رُغَمِ",2,"م",1,0],["سَأَضرِبُ في طولِ البِلادِ وَعَرضِها","أَنالُ مُرادي أَو أَموتُ غَريبا",3,"ب",2,1],["سَأَضرِبُ أَمثالاً لِمَن كانَ عاقِلاً","يَسيرُ بِها مِنّي رَوِيٌّ مُبَيَّتُ",4,"ت",1,0],["سأضرم فيك يا لُكعُ الأهاجي","كنيران تُشب تجاهَ ريح",5,"ح",1,0],["سأُضحِك أحبابي بَجدْواك عائِدا","كما خَنَّقتْهم في المسير المَدامع",6,"ع",1,0],["سأضربُ في البلادِ فأيُّ فجٍّ","تلتاني فذلكَ لي قرارُ",7,"ر",1,0],["سَأُضَحّي كلَّ ما عِندي فَلا","بُدَّ لي من قَلبِهِ لا بُدَّ لي",8,"ل",2,0],["سَأَضْمَنُ للغليلِ الرِّي منها","فذاتُ الخالِ مَبْسِمُها مُخِيلُ",9,"ل",1,0],["سأُضمِرُ في الأحشاء منكم تَحرُّقاً","وأُظهِرُ للواشين عنكم تَجَلُّدا",10,"د",2,0],["سأضربُ عنك صدورَ المطيِّ","وفي الأرض مَغنىً ومستمطَرُ",11,"ر",1,0],["سأَضرمُها حمراءَ ينزو شرارُها","على جنابِ القاع نَزْوُ الجنادبِ",12,"ب",1,0]]}