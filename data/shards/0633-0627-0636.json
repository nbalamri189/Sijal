{"poems":[[65,"خضاب على فودي للدهر ما نضا","https://www.aldiwan.net/poem46185.html","الطويل"],[3,"سأضمر وجدي في فؤادي وأكتم","https://www.aldiwan.net/poem202.html",""],[57,"إذا كان من يهوى يكاتم حبه","https://www.aldiwan.net/poem26114.html","الطويل"],[59,"سأضرب في طول البلاد وعرضها","https://www.aldiwan.net/poem24723.html","الطويل"],[51,"من الناس ميت وهو حي بذكره","https://www.aldiwan.net/poem10842.html","الطويل"],[90,"تجنب من سقيم الرأي قرباً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19584&r=&rc=87",""],[189,"هل المجد إلا دون ما أنت رافع","https://www.aldiwan.net/poem14573.html","الطويل"],[203,"أرى عقلي كساقية تدار","https://www.aldiwan.net/poem45403.html","الوافر"],[228,"بينما كان فتى المستقبل","https://www.aldiwan.net/poem41633.html","الرمل"],[280,"تمكن من مسامعه العذول","https://www.aldiwan.net/poem25544.html","الوافر"],[369,"أراقب من طيف البخيلة موعدا","https://www.aldiwan.net/poem60959.html","الطويل"],[463,"أدمعك أم عارض ممطر","https://www.aldiwan.net/poem56182.html","المتقارب"],[466,"خذوا من ذمامي عدة للعواقب","https://www.aldiwan.net/poem15082.html","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70684","الطويل"],[983,"","https://poetry.dctabudhabi.ae/diwan/poem/114044","الكامل"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119263","الطويل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138133",""],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96648","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96636","الطويل"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6758","الطويل"],[1564,"","https://poetry.dctabudhabi.ae/diwan/poem/84974","الوافر"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101724","الطويل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87691","المتقارب"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100885","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204480","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216374",""],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117882","الطويل"],[3855,"","https://poetry.dctabudhabi.ae/diwan/poem/32670","المديد"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78311","الوافر"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72823","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72788","الطويل"],[5219,"تاهت حروفي","https://www.poetsgate.com/ViewPoem.aspx?id=194907",""],[5257,"أنين الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=185245",""],[5324,"ماكان مرفأي الاخير لقاؤها.","https://www.poetsgate.com/ViewPoem.aspx?id=212231",""],[5512,"عجاف الدَّهر ( أنا الشَّام )","https://www.poetsgate.com/ViewPoem.aspx?id=204281",""],[5720,"قراري ..","https://www.poetsgate.com/ViewPoem.aspx?id=198925",""],[5720,"رسالةُ حُب","https://www.poetsgate.com/ViewPoem.aspx?id=207170",""],[5952,"غنائي ندائي","https://www.poetsgate.com/ViewPoem.aspx?id=205982",""],[5956,"تسجيل وتصوير ليلة دخلة عريس","https://www.poetsgate.com/ViewPoem.aspx?id=182669",""],[5956,"الغجرية سارقة الطفل *","https://www.poetsgate.com/ViewPoem.aspx?id=184538",""],[5956,"لسامية السّالك اسم آخر هو: عناية بالنازح","https://www.poetsgate.com/ViewPoem.aspx?id=207515",""],[6093,"الشَّعرُ صورةُ روحي","https://www.poetsgate.com/ViewPoem.aspx?id=199274",""],[6152,"موت روح","https://www.poetsgate.com/ViewPoem.aspx?id=201743",""],[6152,"جار الطير","https://www.poetsgate.com/ViewPoem.aspx?id=205855",""],[5126,"ملل ويأس وأفكار سوداء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87789&r=&rc=4",""]],"verses":[["سأضْرِبُ أكْبادَ المَطِيِّ على الوجى","إِلى خَيْرِ مَنْ يُرْجى إذا الخَطْبُ نَضْنَضا",0,"ض",2,0],["سَأُضمِرُ وَجدي في فُؤادي وَأَكتُمُ","وَأَسهَرُ لَيلي وَالعَواذِلُ نُوَّمُ",1,"م",1,1],["سَأُضمِرُ صَبري عَنكِ لا عَن تَجَلُّدِ","وَلَكِنَّني أَطوي ضَميري عَلى رُغَمِ",2,"م",1,0],["سَأَضرِبُ في طولِ البِلادِ وَعَرضِها","أَنالُ مُرادي أَو أَموتُ غَريبا",3,"ب",2,1],["سَأَضرِبُ أَمثالاً لِمَن كانَ عاقِلاً","يَسيرُ بِها مِنّي رَوِيٌّ مُبَيَّتُ",4,"ت",1,0],["سأضرم فيك يا لُكعُ الأهاجي","كنيران تُشب تجاهَ ريح",5,"ح",1,0],["سأُضحِك أحبابي بَجدْواك عائِدا","كما خَنَّقتْهم في المسير المَدامع",6,"ع",1,0],["سأضربُ في البلادِ فأيُّ فجٍّ","تلتاني فذلكَ لي قرارُ",7,"ر",1,0],["سَأُضَحّي كلَّ ما عِندي فَلا","بُدَّ لي من قَلبِهِ لا بُدَّ لي",8,"ل",2,0],["سَأَضْمَنُ للغليلِ الرِّي منها","فذاتُ الخالِ مَبْسِمُها مُخِيلُ",9,"ل",1,0],["سأُضمِرُ في الأحشاء منكم تَحرُّقاً","وأُظهِرُ للواشين عنكم تَجَلُّدا",10,"د",2,0],["سأضربُ عنك صدورَ المطيِّ","وفي الأرض مَغنىً ومستمطَرُ",11,"ر",1,0],["سأَضرمُها حمراءَ ينزو شرارُها","على جنابِ القاع نَزْوُ الجنادبِ",12,"ب",1,0],["سأضحكُ في يومٍ الحوادثِ راجيا","إذا ما بكى فيه قنوطُ ومُبْلِسُ",13,"س",1,0],["سأضمها قيثارتي متغنيا","أشدو بذكر هواك في تلحيني",14,"ن",2,0],["سأضرب بالعضب الخليل مقوماً","أخا صغر ظن المسيح صليبا",15,"ب",2,0],["ساضرب في الأرض الفضاء لعلني","أكفّر عن ذنبي وما كنت عاصيا",16,"ي",2,0],["سَأَضربُ في شرقِ البلادِ وغربها","لمبلغِ عزٍّ أَو لكسبِ محامدِ",17,"د",1,0],["سَأَضرب في شرقِ البلادِ وَغربها","لصحبةِ عزٍّ أَو بلوغِ مرادِ",18,"د",1,0],["سَأَضرِبُ فُسطاطي عَلى عَسكَرِ البِلى","وَأَركُزُ فيهِ لِلنُزولِ قَناتي",19,"ت",2,0],["سأضرب في العلوج بكل عضب","شديد البأس ذي حد صقيل",20,"ل",1,1],["سأضرب صفح القول عنهم نزاهة","وأطويه طيّ الا تحميّ المسهم",21,"م",1,0],["سَأَضحى لِمختلفات الشُجون","إِلى أَن أَسجى لَديكَ بِضاح",22,"ح",1,0],["سأضربُ فى البلاد ولا أبالى","أصبتُ الدهرَ فيها أم أصابا",23,"ب",2,0],["سأضحك من سخافتها زماناً","كما ضحكت على عقلي وذقني",24,"ن",2,0],["سأضمه رفقًا، وأوسعه","برًّا وأملك قلبه حدبا",25,"ب",2,0],["سأضرب عنهم لا لعجز وإنما","أرى الكف عن صيد الثعالب أولى بي",26,"ب",2,0],["سَأُضيعُ النَومَ كَيما تَرَيني","وَمُضيفي مُعظِمٌ لي مُجِلُّ",27,"ل",1,0],["سَأَضرَعُ بِالشَقاءِ لكل خل","لِمَن ما دُمتُ عائِشَة شَفاني",28,"ن",2,0],["سأضرب وجه البيد أبغى بها العلا","إلى أن يؤول الآل والآل آيل",29,"ل",1,0],["سأضربُ وجهَ البيدِ أبغي بها العلا","إلى أن ترى ريّا من الآل هيمهُ",30,"م",2,0],["سأضم طيفك علني","بعد الجفا ألقى الهناء",31,"ا",2,0],["سَأضُمُّ طَيفَكَ فِي اللَّيَالِي بَاكِيًا","أدعُ إلَاهِي رَاجِيًا مُتَضَرِّعَا",32,"ع",2,0],["سأضمد القلب الجريح مواسيا","وأعوض المفقود من أعوامي",33,"م",2,0],["سأضربُ كلَّ من آذى ربوعي","سأقصمُ من تمادى في احتقاري",34,"ر",2,0],["سأضلُ أكتبُ فيكَ أشعاري","مهما نأتْ بي عنكَ أقداري",35,"ر",2,1],["سأضلُ أذكرُ ما بقيتُ محبتي","في كل أبياتي .. لتعلم منزلَكْ",36,"ك",1,0],["سأضحك حتى ولو قيلَ إنّ","الفتى منك جُنّ مصابٌ بداء",37,"ا",2,0],["سأضغط حتى انهراس اللحوم","وأمخر حتى انتهاء الجُدُرْ",38,"ر",1,0],["سأضُمّه لعباءتي في خلسةٍ","وأطيرُ والأفراح فوقَ الأشمُسِ",39,"س",1,0],["سأضيف لاسمك ليس ساميةً فقط","أيضاً وباْسمِ (عنايةٍ) بالنازحِ..",40,"ح",1,0],["سأضْمنُ القلبَ في وُدٍّ يبادِلكُمْ","أما اللقاءُ فأمرٌ غيرُ مضمونِ",41,"ن",1,0],["سأضحك للجميع فلا تخافي","ولن أبدي لهم يوما مصابا",42,"ب",2,0],["سأضحك للهموم ولن أبالي","وأجعل بسمتي دوما شعارا",43,"ر",2,0],["سَأُضْمِرُهَا حِينًا وَلَوْ قَدْ أَذَعْتُهَا","لَمَا عَدِمَتْ بَيْنَ الأَنَامِ مُفَنِّدَا",44,"د",2,0]]}