"يداويني حبيبي لا طبيبي","https://www.poetsgate.com/ViewPoem.aspx?id=202611",""],[4888,"دعوني أحلق","https://www.poetsgate.com/ViewPoem.aspx?id=207763",""],[4926,"تحيّات إجلال عن الحصر جلَّت","https://www.poetsgate.com/ViewPoem.aspx?id=171107",""],[5002,"قال... وقالت!","https://www.poetsgate.com/ViewPoem.aspx?id=202699",""],[5183,"بين القبر والمنبر","https://www.poetsgate.com/ViewPoem.aspx?id=180164",""],[5213,"وكنت اذا ما الدهر يوما أساء لي","https://www.poetsgate.com/ViewPoem.aspx?id=170541",""],[5240,"هذي مضاجع فهر أم مغانيها","https://www.poetsgate.com/ViewPoem.aspx?id=171240",""],[5277,"دنيا زحلْ..","https://www.poetsgate.com/ViewPoem.aspx?id=194698",""],[5302,"ملحمة الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=200060",""],[5397,"أهل بسط كف تحجب الشمس والبدرا","https://www.poetsgate.com/ViewPoem.aspx?id=157931",""],[5431,"العراق -انتفاضة الشعب","https://www.poetsgate.com/ViewPoem.aspx?id=207055",""],[5444,"الوزارة","https://www.poetsgate.com/ViewPoem.aspx?id=205448",""],[5493,"جيدُ الدُّجى","https://www.poetsgate.com/ViewPoem.aspx?id=201941",""],[5616,"كيف","https://www.poetsgate.com/ViewPoem.aspx?id=203335",""],[5616,"عتاب","https://www.poetsgate.com/ViewPoem.aspx?id=203486",""],[5637,"دع الدّنيا لعاشِقِها","https://www.poetsgate.com/ViewPoem.aspx?id=94756",""],[5638,"حكم الخنازير","https://www.poetsgate.com/ViewPoem.aspx?id=206324",""],[5691,"عكاظُ الفيسِبوك...!","https://www.poetsgate.com/ViewPoem.aspx?id=207585",""],[1513,"أَتَصبِرُ يا قَلبُ أَم تَجزَع","https://www.poetsgate.com/ViewPoem.aspx?id=92498",""],[5725,"اتى العيد","https://www.poetsgate.com/ViewPoem.aspx?id=189675",""],[5733,"مَرَرْتُ بِزاهٍ عَلىَ بِاِبه","https://www.poetsgate.com/ViewPoem.aspx?id=201640",""],[5844,"كان لها عنوان","https://www.poetsgate.com/ViewPoem.aspx?id=139719",""],[5956,"المغرور جدير بالشفقة","https://www.poetsgate.com/ViewPoem.aspx?id=184440",""],[5956,"شعري ورقابة المطبوعات","https://www.poetsgate.com/ViewPoem.aspx?id=185624",""],[5956,"تربيتي الجديدة","https://www.poetsgate.com/ViewPoem.aspx?id=194887",""],[5956,"تنوح المزامير فور نواك","https://www.poetsgate.com/ViewPoem.aspx?id=199932",""],[6031,"أَلا تَسْتنطقُ الدِمَنَ الخَوَالي","https://www.poetsgate.com/ViewPoem.aspx?id=46291",""],[6189,"قراءة في جسد اللؤلؤة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83584&r=&rc=51",""],[5567,"إسراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81756&r=&rc=20",""]],"verses":[["فَما دُمتَ فَالمُلكُ واري الزِنا","دِ صافي المَوارِدِ عالي المَباني",0,"ن",2,0],["فَما دَفَعَ المَنايا عَنهُ وَفرٌ","وَلا هَزَمَ النَوائِبَ عَنهُ جُندُ",1,"د",1,0],["فَما دونَها في الناسِ لِلقَلبِ مَطلَبٌ","وَلا خَلفَها في الناسِ لِلقَلبِ مَذهَبُ",2,"ب",1,0],["فَمَا دَعَوْتَ بِبَدْرٍ غَيْرَ مُبْتَدِرٍ","وَلاَ أَمَرْتَ بِأَمْرٍ غَيْرِ مُحْتَمَلِ",3,"ل",1,0],["فَمادَتِ الأَرضُ بِأَوتادِها","حينَ اِلتَقى الأَبيَضُ وَالأَصفَرُ",4,"ر",1,0],["فَمادِدهُم حِبالَ الوُدِّ وَاِنهَض","بِنا فَقِيادُنا لِلخَيرِ سَهلُ",5,"ل",1,0],["فما دعواه في الحَيَدان إلا","كدعوى العفّةِ المتهتّكونا",6,"ن",2,0],["فما دارت الأفلاك إلا وقُطبها","بحكم الهوى حُبّ الكَعاب المفلّك",7,"ك",1,0],["فما دمعي على العادات جارٍ","ولا قلبي على التبريح وقف",8,"ف",1,0],["فَما ديمَةٌ صَبَّت عَلى الصَخرِ مائَها","فَما أَنبَتَت زَهراً وَلا أَطلَعَت بَقلا",9,"ل",2,0],["فَما دونَها لِلقَلبِ في الناسِ مَطلَبٌ","وَلا خَلفَها لِلقَلبِ في الناسِ مَهرَبُ",10,"ب",1,0],["فَما دامَ الحَبيبُ عَلى وِصالٍ","وَلا أَدّى أَمانَتَهُ خَليلُ",11,"ل",1,0],["فما دعائي عنده","إلا نهيق عير",12,"ر",1,0],["فما دَفَعَتْ عنه جنودُ جنودِهِ","على أنّها في القرب كاليد للفمِ",13,"م",1,0],["فَما دَبَّ إِلّا في بُيوتِهِمُ النَدى","وَلَم تَربُ إِلّا في جُحورِهِمُ الحَربُ",14,"ب",1,0],["فَمَا دفَنُوا عُثمَان حَتَّى لِدفنِهِم","دفَنتُ مَسَرَّاتِي وَأحيَيتُ أحزانِي",15,"ن",2,0],["فَمَا دام للِسَّيفِ المُهَنَّدِ قَائِمُ","بِكَفِّكَ فَالتَّوحِيدُ بِالأرضِ قَائِمُ",16,"م",1,0],["فَما دِرهَمي إِن مَرَّ بي مُتَلَبِّثاً","وَلا طَفلَ لي حَتّى تَرى الشَمسَ مُطفِلا",17,"ل",2,0],["فما دُونَ اللقَاءِ سِوَى ليالِ","وَيَفتحُ مَكَةَ الجيشُ اللُّهامُ",18,"م",1,0],["فَمَا دَرَتْ مِنْهَا وَلاَ عَنْهَا سِوَى","ما كَانَ مَلْهَى طَاهِراً ومَلْعَبا",19,"ب",2,0],["فَما درَى المُطْلِقُ إِلاَّ وَقَدْ","أَصْبَحَ فِي أَصْفَادِ مُسْتَأْسِرِ",20,"ر",1,0],["فَما دَرَيتُ وَثَوبَ اللَيلِ يَشمَلُني","نَضا النَهارُ إِزارَ اللَيلِ أَم لاثا",21,"ث",2,0],["فمآدب عربية وقصائد","همزية ووسائد وحباب",22,"ب",1,0],["فَمَا دَخَلنَا فِي بَاب جاه","وَلَا خرجنَا عَن الشحاذة",23,"ه",1,0],["فما دعاني الهاشمي أجبتهُ","ولا خير في المملوك غير مجيب",24,"ب",1,0],["فَما دَامَ الحَبيبُ عَلى وِصَالٍ،","وَلاَ أدّى أمَانَتَهُ الخَليلُ",25,"ل",1,0],["فما ديمة صبّت على الصخر ماءها","فما أنبتت زهرا ولا أطلعت بقلا",26,"ل",2,0],["فما دامَ حُكمٌ للتجاريب راهن","فليس لنا غيرُ انتظارِ العواقب",27,"ب",1,0],["فَما دونَ العِراقِ اليَومَ خَصمٌ","يُلِطُّ وَقَد تَخَيَّرتَ الضَمينا",28,"ن",2,0],["فَما دامَ فَخرُ الدينِ يَبقى وَنَسلُهُ","فَلا تَسأَلوا عَمَّن مَضى أَو تَخَلَّفا",29,"ف",2,0],["فما دليل على حرّ يصاحبني","بالعدل أثني عليه خنصر العدد",30,"د",1,0],["فَما دَفَّق الشِعرَ مِن أَصغريك","تجمَّع في هذِهِ الناحِيَه",31,"ي",2,0],["فَما دَفَعوهُ عَن حَسَبٍ كَريمٍ","وَلا ذادوهُ عَن خُلقٍ رَضِيِّ",32,"ي",1,0],["فَماد قَرير العين في خلع الرضا","وَقَد شملته بهجة وَحبور",33,"ر",1,0],["فَمَا دَمْعِي عَلَى الأَطْلاَل وَقْفٌ","وَلاَ قَلْبي مَعَ الظُّعْنِ الْغَوَادِي",34,"د",2,0],["فما دمت حلمي واثقا بلوائه","فانت لمصر التاج والسيف والبدر",35,"ر",1,0],["فَما درَى أَو جَعلْتُ الأرضَ من دَمهِ","يَحمَرُّ مِن خَجَل خَدٌّ لها قَانِ",36,"ن",1,0],["فما دَرَجَ الزّمانُ بها قليلاً","وللكُفّارِ تُطْرِقُ مُقْلَتان",37,"ن",1,0],["فما دونَ دُرِّ الدّمعِ خِيفةَ نَهْبه","إذا بِتُّ من جَفنَيَّ يُغلَقُ باب",38,"ب",1,0],["فَما دُروعُهُمُ إِلّا مَقاتِلُهُم","لَكِنَّهُم بِسُيوفِ اللَهِ قَد ضُرِبوا",39,"ب",3,0],["فما دون هذا الشهم للوفد مقنع","ولا بعده في البرّ للناس مغنم",40,"م",1,0],["فما دَعَتْ غَيْرَكَ الآمالُ حينَ دَعَتْ","ولا رَجا غيرَكَ الإِسلامُ حينَ رَجَا",41,"ج",2,0],["فما دَجَا لِيَ خطبٌ","إِلّا لَمَحْتُكَ فَجْرَا",42,"ر",2,0],["فما دَويَ الثغرُ إلا بَعثتَ","إليهِ شمائلَ تشفي سقامَهْ",43,"م",2,0],["فما دعوا لولاة الفرس ذاكرة","عن المجوسية الرعناء إذ وثبوا",44,"ب",3,0],["فما دنياهموا إلا خرابٌ","ويبقى الحب بعد وما أظلا",45,"ل",2,0],["فما دفعوا العدوَّ بمدِّ صوتٍ","ولا نقعوا الأُوَامَ برشْح شَنِّ",46,"ن",1,0],["فمادت بمن لم تسر الخمر نشوة","من الطيب في عرنينه والمناشق",47,"ق",1,0],["فمادَتْ بي الأرض العَزازُ مخافةً","وأصبح لُبِّي في قوادمِ طائرِ",48,"ر",1,0],["فما دانَ اللِّئامُ لغير بأسٍ","ولا لانَ الحديدُ بغيرِ نارِ",49,"ر",1,0],["فَمادِحُها بِالحُسنِ والطِّيب ما افْتَرى ال","حَديثَ وراوِي فَضْلِها ما تَلَجْلَجَا",50,"ج",2,0],["فما دام وادي النيل يحوي نظيره","فما أشرف الوادي وما أعظم النهرا",51,"ر",2,0],["فَما دُمتَ حَيّاً في الزَمانِ فَلَم تَزَل","عَلى حُقوقٍ لَيسَ مِنهُنَّ أَوجَبُ",52,"ب",1,0],["فَما دُفِنتَ وَأيمُ الله في جَدَثٍ","وَإنَّما دُفِنَ المَعرُوفُ والكَرَمُ",53,"م",1,0],["فَما دُمتَ فالدّينُ الحَنيفُ وَلَو وَهَى","قَوائم مُلكٍ غَيرَ واهي الدَّعائِمِ",54,"م",1,0],["فَما دُونَ حَليٍ غَيرَ ما دُونَ لَيّةٍ","ولا دُونَ بَيشٍ غيرَ ما دون تَعشَر",55,"ر",1,0],["فَما دَجَت ليلة سار وهم","لخابطيها يوقدون ناره",56,"ر",2,0],["فما درى النّاسُ ما أُكاتِمُهُ","ولا شكوْتُ الهَوى إلى أَحَدِ",57,"د",1,0],["فما دمتَ فينا يا محمدُ لم نَخَفْ","ظلوماً ولم نرْهبْ غلاءَ ولا محلا",58,"ل",2,0],["فمادرى إلا وقد أغرقت","سيُول دمعي عضلَه ثم ساحْ",59,"ح",1,0],["فما دامَ لي عقدٌ بعيني خزنته","من التبر حتى ضاع بين اللوامعِ",60,"ع",1,0],["فما دُرَّةٌ تُتَوافى النّجارُ","إلى غائصٍ عندَه تُطلَبُ",61,"ب",1,0],["فَما دار اِبن دارا في علاهُ","يُطاولهُ ولا كِسرى بن كسرى",62,"ر",2,0],["فما دائر منه لي دائرا","بما فيه نَفْعٌ سوى ما يضرُ",63,"ر",1,0],["فما دونكم إلا انغلاب ترونه","ولا ريب من قد لاعب الليث يُغلبُ",64,"ب",1,0],["فما دام هذا الحال يا قوم حالكم","خذو حذركم إذ فيكم اليوم شاعرُ",65,"ر",1,0],["فماد العرش والكرسي حزناً","عليه وناب كل الخلق خطب",66,"ب",1,0],["فمادت تحتنا لما وطئنا","عليها وطأة المتثاقلينا",67,"ن",2,0],["فما دحى شمس الضحى عدة","بين مقلٍ فيه أو مكثر",68,"ر",1,0],["فَمَادَتْ لَهُ الغَبرا فَلاَ النَّبتُ ثَابِتٌ","وغَطَّتْ بِهِ الخَضرا فَما انبَعَثَ القَطرُ",69,"ر",1,0],["فما دون الثنية من ذباحٍ","لذي نسك فيدرك بالوجود",70,"د",1,0],["فما دار في دار ولا حل حلةً","فأبقى بها يوماً مدار نعيم",71,"م",1,0],["فما دون التفاني غير كاف","لصَبٍّ عن هواه غير كافف",72,"ف",1,0],["فما دِيمة وطفاء دانٍ سحابها","لهيدبه فوق البسيطة أذيال",73,"ل",1,0],["فما دفعت أسوارُها عنهم الذى","دهَاهُم ولا ما شيَّدُوه ورمَّموا",74,"م",3,0],["فما داركم هذي بدار إقامة","ولكنّها دار ابتلا وتزود",75,"د",1,0],["فما دَعوا للغَيثِ يوماً وبكوا","إلّا أجاب قبلَ أن نُجيبا",76,"ب",2,0],["فَما دَنَستُ آمالي بِمالٍ","لَهُم يَوماً وَلا علِموا بِحالي",77,"ل",2,0],["فَما دَنَّسَت فاها بِغيبَةِ غائِبٍ","وَلا مَنَعَت رفداً لِمَن جاءَ يَحتَذي",78,"ذ",2,0],["فما دنَّست عرضك المخزيات","ولا ضمَّ برد علائك فحشا",79,"ش",2,0],["فَما دعوتُ به من عيشِ مملكة","ولم نعش يومنا عيش المساكينِ",80,"ن",1,0],["فما دُمتَ في جنبي زمانيَ مُسعدٌ","وما دمت في قلبي شبابيَ باق",81,"ق",1,0],["فما دمتُ حياً ستحيا معي","وإن متُّ يحفظْك ربّ القدر",82,"ر",1,0],["فما دأبه إلا السعاية دائماً","ولا سيما بين الأحيباب والصَّحب",83,"ب",1,0],["فما دمع الفتى إلا سلاح","يجرده على الدهر العنيد",84,"د",1,0],["فمادح موهباتي مهدر شرقي","الغصن في راحتيه نصل سفّاك",85,"ك",1,0],["فما دار السعادة غير قطب","بإسلام البسيطة مستدير",86,"ر",1,0],["فَمَا دَرَى صَاعِدٌ بِمُنْحَدِرٍ","وَلاَ الْتَقَى ذَاهِبٌ وَمُنْقَلِبُ",87,"ب",1,0],["فما دَرَيْنا أَوُجوهُ الدُّمى","أَحْسَنُ أَمْ تِلْكَ التَصاويرُ",88,"ر",1,0],["فما دام شجو لامرىء أو مسرّة","أرى الدهر من هذا وهذاك أكثرا",89,"ر",2,0],["فما دفع الموتَ مَنْ غابَ عن","هُ يومَ الطِّرادِ ولا مَنْ شَهِدْ",90,"د",1,0],["فما دفعت عنه الفيالق عندما","رأى كل حرف منك وافاه فيلقا",91,"ق",2,0],["فَما دَهرنا الا كَغَفوَة راقِد","وَفيها الَينا المَوت يَأتي كَسارِق",92,"ق",1,0],["فما دُونَها رصمٌ وهذه حقيقةٌ","وشتَّانَ ما بين الحقيقة والرسمِ",93,"م",1,0],["فما دعاك لهذا","إلا الخنا والخبال",94,"ل",1,0],["فَما دار لَيلَى بَعدَ لَيلى كدارها","وَلا حال من فيها كما مرّ من حال",95,"ل",1,0],["فمادت راسياتُ الأَرض رَوعاً","وَنثَّرت السَما زُهرَ النُجوم",96,"م",1,0],["فما دون من يبغيك في