{"poems":[[53,"ضلالا لسائل هذي المغاني","https://www.aldiwan.net/poem29720.html","المتقارب"],[53,"تفوز بنا المنون وتستبد","https://www.aldiwan.net/poem30604.html","الوافر"],[55,"ألم تعلمي يا فوز أني معذب","https://www.aldiwan.net/poem26544.html","الطويل"],[77,"أبشر فقد نلت ما ترجو على عجل","https://www.aldiwan.net/poem36369.html","البسيط"],[86,"أساحة للحرب أم محشر","https://www.aldiwan.net/poem10697.html","السريع"],[86,"هنيئا أيها الملك الأجل","https://www.aldiwan.net/poem68929.html","الوافر"],[88,"أطالوا الحرب طاحنة زبونا","https://www.aldiwan.net/poem44459.html","الوافر"],[88,"سأبدي لدهري ناج المتضحك","https://www.aldiwan.net/poem45011.html","الطويل"],[72,"وكنت إذا جفوتم أو كدرتم","https://www.aldiwan.net/poem19313.html","الوافر"],[91,"بكيت الصبا من قبل أن يذهب الصبا","https://www.aldiwan.net/poem62665.html","عموديه"],[45,"ألم تعلمي يا علو أني معذب","https://www.aldiwan.net/poem11437.html","الطويل"],[45,"بمثل لقائها شفي الغليل","https://www.aldiwan.net/poem65600.html","الوافر"],[61,"متى يقال قد دنا","https://www.aldiwan.net/poem51360.html","مجزوء الرجز"],[80,"رمى الموت في عين التصبر بالدم","https://www.aldiwan.net/poem31279.html","الطويل"],[44,"لقد أخذت من دار ماوية الحقب","https://www.aldiwan.net/poem30580.html","الطويل"],[81,"جرى من جفوني ما أذاب أجفاني","https://www.aldiwan.net/poem61307.html","الطويل"],[81,"هو الفتح حقا ما على الشمس كاتم","https://www.aldiwan.net/poem61322.html","الطويل"],[46,"دع الراح في راح الغواة مدارة","https://www.aldiwan.net/poem23160.html","الطويل"],[105,"","https://poetry.dctabudhabi.ae/diwan/poem/49159","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54635","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54912","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43679","البسيط"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/205861","الكامل"],[72,"كُنَّا من الشّعْر قد هربنا","https://www.poetsgate.com/ViewPoem.aspx?id=189429",""],[50,"ذكرت شبابي اللذَّ غير قريبِ","https://www.poetsgate.com/ViewPoem.aspx?id=19932",""],[45,"بِمِثْلِ لِقَائِهَا شُفيَ الغَليلُ","https://www.poetsgate.com/ViewPoem.aspx?id=32059",""],[91,"الشباب والحب","https://www.poetsgate.com/ViewPoem.aspx?id=53231",""],[90,"لعبة التجارب...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66767&r=&rc=175",""],[143,"أما وبديع ما تأتي يمينا","https://www.aldiwan.net/poem11835.html","الوافر"],[169,"دعوه فخير الرأي أن لا يعنفا","https://www.aldiwan.net/poem1639.html",""],[186,"أقول والهم يأسوني ويمرضني","https://www.aldiwan.net/poem43922.html","البسيط"],[223,"حبيبي على هذه الرابيه","https://www.aldiwan.net/poem41445.html","المتقارب"],[235,"أرقت للمع برق حاجري","https://www.aldiwan.net/poem31628.html","الوافر"],[271,"فؤادي بربع الظاعنين أسير","https://www.aldiwan.net/poem52084.html","الطويل"],[280,"أمني النفس وصلا من سعاد","https://www.aldiwan.net/poem60785.html","الوافر"],[285,"تفتح روض الأنس وابتسم الثغر","https://www.aldiwan.net/poem39416.html","الطويل"],[348,"أنضيت هرتي الغضبى وجدياني","https://www.aldiwan.net/poem20761.html","البسيط"],[364,"إذا لم تقدرا أن تسعداني","https://www.aldiwan.net/poem60633.html","الوافر"],[364,"إذا لم يخن صب ففيم عتاب","https://www.aldiwan.net/poem61000.html","الطويل"],[366,"أما ومنك على أعدائك الطلب","https://www.aldiwan.net/poem17155.html","البسيط"],[416,"متى يشتفي هذا الفؤاد المتيم","https://www.aldiwan.net/poem54074.html","الطويل"],[439,"ما أطبق الهم إلا ريثما انفرجا","https://www.aldiwan.net/poem34794.html","البسيط"],[439,"اقبل ثناء وشكرا","https://www.aldiwan.net/poem34832.html","المجتث"],[439,"سلام وهنيت فيك السلامه","https://www.aldiwan.net/poem34883.html","المتقارب"],[449,"إن العروبة بالإسلام عزتها","https://www.aldiwan.net/poem996.html",""],[453,"صفية في حنانك لي عزاء","https://www.aldiwan.net/poem61585.html","الوافر"],[458,"تركتك يا زمان قلى فدعني","https://www.aldiwan.net/poem55826.html","الوافر"],[461,"لمن جيرة دون اللوى والشقائق","https://www.aldiwan.net/poem15088.html","الطويل"],[461,"ونبئت والرحمن أكرم دافع","https://www.aldiwan.net/poem16059.html","الطويل"],[461,"وجوه لا يحمرها عتاب","https://www.aldiwan.net/poem16078.html","الوافر"],[575,"سجا ليل همي بالعذار الذي سجا","https://www.aldiwan.net/poem3092.html","الطويل"]],"verses":[["فَما دُمتَ فَالمُلكُ واري الزِنا","دِ صافي المَوارِدِ عالي المَباني",0,"ي",1,0],["فَما دَفَعَ المَنايا عَنهُ وَفرٌ","وَلا هَزَمَ النَوائِبَ عَنهُ جُندُ",1,"د",1,0],["فَما دونَها في الناسِ لِلقَلبِ مَطلَبٌ","وَلا خَلفَها في الناسِ لِلقَلبِ مَذهَبُ",2,"ب",1,0],["فَمَا دَعَوْتَ بِبَدْرٍ غَيْرَ مُبْتَدِرٍ","وَلاَ أَمَرْتَ بِأَمْرٍ غَيْرِ مُحْتَمَلِ",3,"ل",1,0],["فَمادَتِ الأَرضُ بِأَوتادِها","حينَ اِلتَقى الأَبيَضُ وَالأَصفَرُ",4,"ر",1,0],["فَمادِدهُم حِبالَ الوُدِّ وَاِنهَض","بِنا فَقِيادُنا لِلخَيرِ سَهلُ",5,"ل",1,0],["فما دعواه في الحَيَدان إلا","كدعوى العفّةِ المتهتّكونا",6,"ن",2,0],["فما دارت الأفلاك إلا وقُطبها","بحكم الهوى حُبّ الكَعاب المفلّك",7,"ك",1,0],["فما دمعي على العادات جارٍ","ولا قلبي على التبريح وقف",8,"ف",1,0],["فَما ديمَةٌ صَبَّت عَلى الصَخرِ مائَها","فَما أَنبَتَت زَهراً وَلا أَطلَعَت بَقلا",9,"ل",2,0],["فَما دونَها لِلقَلبِ في الناسِ مَطلَبٌ","وَلا خَلفَها لِلقَلبِ في الناسِ مَهرَبُ",10,"ب",1,0],["فَما دامَ الحَبيبُ عَلى وِصالٍ","وَلا أَدّى أَمانَتَهُ خَليلُ",11,"ل",1,0],["فما دعائي عنده","إلا نهيق عير",12,"ر",1,0],["فما دَفَعَتْ عنه جنودُ جنودِهِ","على أنّها في القرب كاليد للفمِ",13,"م",1,0],["فَما دَبَّ إِلّا في بُيوتِهِمُ النَدى","وَلَم تَربُ إِلّا في جُحورِهِمُ الحَربُ",14,"ب",1,0],["فَمَا دفَنُوا عُثمَان حَتَّى لِدفنِهِم","دفَنتُ مَسَرَّاتِي وَأحيَيتُ أحزانِي",15,"ي",1,0],["فَمَا دام للِسَّيفِ المُهَنَّدِ قَائِمُ","بِكَفِّكَ فَالتَّوحِيدُ بِالأرضِ قَائِمُ",16,"م",1,0],["فَما دِرهَمي إِن مَرَّ بي مُتَلَبِّثاً","وَلا طَفلَ لي حَتّى تَرى الشَمسَ مُطفِلا",17,"ل",2,0],["فما دُونَ اللقَاءِ سِوَى ليالِ","وَيَفتحُ مَكَةَ الجيشُ اللُّهامُ",18,"م",1,0],["فَمَا دَرَتْ مِنْهَا وَلاَ عَنْهَا سِوَى","ما كَانَ مَلْهَى طَاهِراً ومَلْعَبا",19,"ب",2,0],["فَما درَى المُطْلِقُ إِلاَّ وَقَدْ","أَصْبَحَ فِي أَصْفَادِ مُسْتَأْسِرِ",20,"ر",1,0],["فَما دَرَيتُ وَثَوبَ اللَيلِ يَشمَلُني","نَضا النَهارُ إِزارَ اللَيلِ أَم لاثا",21,"ث",2,0],["فمآدب عربية وقصائد","همزية ووسائد وحباب",22,"ب",1,0],["فَمَا دَخَلنَا فِي بَاب جاه","وَلَا خرجنَا عَن الشحاذة",23,"ه",1,0],["فما دعاني الهاشمي أجبتهُ","ولا خير في المملوك غير مجيب",24,"ب",1,0],["فَما دَامَ الحَبيبُ عَلى وِصَالٍ،","وَلاَ أدّى أمَانَتَهُ الخَليلُ",25,"ل",1,0],["فما ديمة صبّت على الصخر ماءها","فما أنبتت زهرا ولا أطلعت بقلا",26,"ل",2,0],["فما دامَ حُكمٌ للتجاريب راهن","فليس لنا غيرُ انتظارِ العواقب",27,"ب",1,0],["فَما دونَ العِراقِ اليَومَ خَصمٌ","يُلِطُّ وَقَد تَخَيَّرتَ الضَمينا",28,"ن",2,0],["فَما دامَ فَخرُ الدينِ يَبقى وَنَسلُهُ","فَلا تَسأَلوا عَمَّن مَضى أَو تَخَلَّفا",29,"ف",2,0],["فما دليل على حرّ يصاحبني","بالعدل أثني عليه خنصر العدد",30,"د",1,0],["فَما دَفَّق الشِعرَ مِن أَصغريك","تجمَّع في هذِهِ الناحِيَه",31,"ي",2,0],["فَما دَفَعوهُ عَن حَسَبٍ كَريمٍ","وَلا ذادوهُ عَن خُلقٍ رَضِيِّ",32,"ي",1,0],["فَماد قَرير العين في خلع الرضا","وَقَد شملته بهجة وَحبور",33,"ر",1,0],["فَمَا دَمْعِي عَلَى الأَطْلاَل وَقْفٌ","وَلاَ قَلْبي مَعَ الظُّعْنِ الْغَوَادِي",34,"ي",1,0],["فما دمت حلمي واثقا بلوائه","فانت لمصر التاج والسيف والبدر",35,"ر",1,0],["فَما درَى أَو جَعلْتُ الأرضَ من دَمهِ","يَحمَرُّ مِن خَجَل خَدٌّ لها قَانِ",36,"ن",1,0],["فما دَرَجَ الزّمانُ بها قليلاً","وللكُفّارِ تُطْرِقُ مُقْلَتان",37,"ن",1,0],["فما دونَ دُرِّ الدّمعِ خِيفةَ نَهْبه","إذا بِتُّ من جَفنَيَّ يُغلَقُ باب",38,"ب",1,0],["فَما دُروعُهُمُ إِلّا مَقاتِلُهُم","لَكِنَّهُم بِسُيوفِ اللَهِ قَد ضُرِبوا",39,"ب",3,0],["فما دون هذا الشهم للوفد مقنع","ولا بعده في البرّ للناس مغنم",40,"م",1,0],["فما دَعَتْ غَيْرَكَ الآمالُ حينَ دَعَتْ","ولا رَجا غيرَكَ الإِسلامُ حينَ رَجَا",41,"ج",2,0],["فما دَجَا لِيَ خطبٌ","إِلّا لَمَحْتُكَ فَجْرَا",42,"ر",2,0],["فما دَويَ الثغرُ إلا بَعثتَ","إليهِ شمائلَ تشفي سقامَهْ",43,"م",2,0],["فما دعوا لولاة الفرس ذاكرة","عن المجوسية الرعناء إذ وثبوا",44,"ب",3,0],["فما دنياهموا إلا خرابٌ","ويبقى الحب بعد وما أظلا",45,"ل",2,0],["فما دفعوا العدوَّ بمدِّ صوتٍ","ولا نقعوا الأُوَامَ برشْح شَنِّ",46,"ن",1,0],["فمادت بمن لم تسر الخمر نشوة","من الطيب في عرنينه والمناشق",47,"ق",1,0],["فمادَتْ بي الأرض العَزازُ مخافةً","وأصبح لُبِّي في قوادمِ طائرِ",48,"ر",1,0],["فما دانَ اللِّئامُ لغير بأسٍ","ولا لانَ الحديدُ بغيرِ نارِ",49,"ر",1,0],["فَمادِحُها بِالحُسنِ والطِّيب ما افْتَرى ال","حَديثَ وراوِي فَضْلِها ما تَلَجْلَجَا",50,"ج",2,0]]}