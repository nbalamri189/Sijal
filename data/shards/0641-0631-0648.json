م",1,0],["فَروحِيَ مِن هَذا المَقامِ مُطِلَّةٌ","تُشارِفُكُم عَنّي وَإِن كُنتُ بالِيا",2,"ي",2,0],["فَروضَةُ أَلجامٍ تَهيجُ لِيَ البُكا","وَرَوضاتُ شوطىعَهدُهُنَّ قَديمُ",3,"م",1,0],["فَرَوْضُ حمدك يُزهى","مني بسجع الحمامَهْ",4,"ه",1,0],["فُروعٍ وَأَصلٍ مِن بَجيلَةَ في الذُرى","إِلى اِبنِ نِزارٍ كانَ عَمّاً وَوالِدِ",5,"د",1,0],["فَرَوَّحَها يَقلو النِجادَ عَشِيَّةً","أَقَبُّ كَكَرِّ الأَندَرِيِّ شَتيمُ",6,"م",1,0],["فَرَّ وَأَلقى لَنا رُمحَهُ","لَعَلَّكَ عِكرِمَ لَم تَفعَلِ",7,"ل",1,1],["فرؤياكَ رؤيا للسماح صحيحة","وبابك بابٌ للنجاحِ مجرَّب",8,"ب",1,0],["فروحُهُ تُزعَجُ عن جسمه","وجسمُه عن بيته يُزعجُ",9,"ج",1,0],["فَروق لألباس الأمور فَصولها","ضَموم لأشتات الأمور جَموعها",10,"ع",3,0],["فَرَّوحَها مِن ذي المَجازِ عَشِيَّةً","يُبادِرُ أَولى السابِقاتِ إِلى الحَبلِ",11,"ل",1,0],["فَرَوَّيتَ مِنهُم ظامِئَ البيضِ وَالقَنا","وَأَشبَعتَ مِنهُم طاوِيَ الذِئبِ وَالنَسرِ",12,"ر",1,0],["فَرُوحاً بفَجْرِ الخُلُودِ البهيجِ","وما حَوْلَهُ مِنْ بَنَاتِ النُّجومْ",13,"م",1,0],["فَروقُ اِضحَكي وَاِبكي فَخاراً وَلَوعَةً","وَقومي إِلى نَعشِ الفَقيدِ المُعَظَّمِ",14,"م",1,0],["فَرُؤوسُ الرِماحِ أَذهَبُ لِلغَي","ظِ وَأَشفى لِغِلِّ صَدرِ الحَقودِ",15,"د",1,0],["فَرَوّاكَ صَوبُ الحَمدِ في كُلِّ مَوطِنٍ","وَجادَكَ غَيثُ الدَهرِ في كُلِّ مَربَعِ",16,"ع",1,0],["فَروعُ الثَنايا ما يُغِبُّ فِجاجَها","تَطَلُّعَ مَضّاءٍ عَلى أَوَّلِ العَزمِ",17,"م",1,0],["فَرَونَقُ الشَمسِ أَحياناً يُضاحِكُها","وَرَيِّقُ الغَيثِ أَحياناً يُباكيها",18,"ي",3,0],["فَرَوَّحتُ القَلوصَ إِلى سَعيدٍ","إِذا ما الشاةُ في الأَرطاةِ قالا",19,"ل",2,0],["فَرَوَّحَ ظِلُّهُ روحَ الأَماني","وَأَخمَدَ بَردُهُ نَفسَ السَمومِ",20,"م",1,0],["فَرَوَّى ضَريحاً من كفاحٍ عن الثرى","له وابلٌ بالخصب ما خُطّ بالمَحلِ",21,"ل",1,0],["فَرَوِيَت هاماتُهُ الصَوادي","كَم حَمَلَت لِمُقتِرٍ مِن زادِ",22,"د",1,0],["فُروعٌ لا تَرِفُّ عَلَيكَ إِلّا","شَهِدتَ لَها عَلى طيبِ الأَرومِ",23,"م",1,0],["فَرَوَّعَ حَتّى نُجومَ العَلاءِ","وَضَعضَعَ حَتّى سَماءَ الكَرَم",24,"م",1,0],["فَرَواها الدَهر فيما قَد رَوى","فَاِسمَعوها وَاِجعَلوها سننا",25,"ن",2,0],["فَرَوّى قَليلاً ثُمَّ أَجحَمَ بُرهَةً","وَإِن هُوَ لَم يَذبَح فَتاهُ فَقَد هَمّا",26,"م",2,0],["فروِّ صداها من جيوشك إنّما","هي القلب مهجوراً وهنّ الضراغم",27,"م",1,0],["فَرَوَّحتُ عَنها مُعسِراً غَيرَ مَوسِرٍ","أُقَرطِسُ في الإِفلاسِ مِن مِئَتَينِ",28,"ن",1,0],["فَروحاً عَلى مالي كُلا مِن فُضولِهِ","فَما تُجمَعُ الأَموالُ إِلاّ لِآكلِ",29,"ل",1,0],["فُرودُ السَواري وَالتَوائِمُ في الدُجى","تُقِرُّ لِرَبٍّ صاغَها بِفُرودِ",30,"د",1,0],["فَرَوائِحٌ وَبَواكِرٌ وَمَعارِفٌ","وَمَناكِرٌ وَحَواضِرٌ وَبَوادِ",31,"د",1,0],["فَرودي حَيثُ شِئتِ بِغَيرِ أَزلٍ","وَلَيسَ عَلَيكِ مِن جَدبٍ حِذارُ",32,"ر",1,0],["فرُوّع الشاعرُ مما رآهُ","وهامَ في الأرض على وجههِ",33,"ه",1,0],["فَرَوَّى قُلَّةَ الأَدحالِ وَبلٌ","فَفلجاً فالنَّبيَّ فَذا كَريب",34,"ب",1,0],["فَرَوَّيْتُ شَيْئَاً ثُمَّ جِئْتُ بِمَنْطِقٍ","ذَكِيٍّ يَفُوقُ الْمِسْكَ وَهْوَ فَتِيقُ",35,"ق",1,0],["فِروا وعظكم، أيها الواعظونَ","فكم في المنايا لنا من عِبَر",36,"ر",1,0],["فروا إلى الله واستبقوا بجهدهم","بقية الله ذخرا خير مدخر",37,"ر",1,0],["فروت اليه الريح ، خفقة","معزف ونحيب عازف",38,"ف",1,0],["فرويداً يا موت انك قد","أسرفت في القتل ثم في التدمير",39,"ر",1,0],["فَرَوّى قُلَّةَ الأَدخالِ وَبلاً","فَفَلجاً فَالنَبِيَّ فَذا كَريبِ",40,"ب",1,0],["فروع من أصول طيبات","فأكرم بالفروع وبالأصول",41,"ل",1,0],["فُروعُها والغصونُ جُزءٌ","بدا ولكنَّه حَقير",42,"ر",1,0],["فروض عليَّ أديتها","إكمنَّها م الحُول للحول",43,"ل",1,0],["فَرُوَيداً فَقَد تَجاوَزَ حَظّي","مِن لُهاكَ التَتميمَ وَالتَكميلا",44,"ل",2,0],["فرؤياك لا يخشى على الشرع شرها","وان كان فيها بعض تشويش خاطري",45,"ر",2,0],["فَرُوزاً فرقدٌ اسما أَخوهُ","فَوا أَسَفاً لَفَقَدِ الفرقدينِ",46,"ن",1,0],["فرِواقُه بالحمدِ مرتِفع","وأساسُه بالجود والكرم",47,"م",1,0],["فروَّعَهُنَّ من سيفي وميضٌ","وأيقظهنَّ من طِرْفي صهيل",48,"ل",1,0],["فرؤيتي لك تُحييني وتقتلني","ومهجتي منك في موتٍ وفي وَهَجِ",49,"ج",1,0],["فَروْضُكَ مَطْلُولٌ وأمرُكَ نافِذٌ","وعَدْلُكَ مَبْسُوطٌ وعِزُّكَ دائِمُ",50,"م",1,0],["فَروحُ بِلادِكَ لَمّا يَزَل","وَإِن راغَ مِنهُ صِباغُ الطُرَر",51,"ر",1,0],["فُروقُ يحرسُها البوسفورُ مَنظَره","يَفيقُ في كلِّ صَدرٍ مجدَ آباءِ",52,"ا",2,0],["فَرووا وَأَنَّ مَزادَتَيها شُدَّتا","وَهُما بِأَزكى الماءِ وافِرَتانِ",53,"ن",1,0],["فَرَووا جَميعاً وَالفَتاةُ وَغادَرَت","مِلءَ الإِناءِ لزَوجِها الغرثانِ",53,"ن",1,0],["فَرَووا بِخالِصِ دَرِّها ثُمَّ اِغتَدَت","مِن حَيثُ جاءَت لَم تُصَب بِمَكانِ",53,"ن",1,0],["فَروَةٍ تُكسِبُني حَو","لاً عَلى البَردِ وَقُوَّه",54,"و",2,0],["فَروَةٍ تَصلُحُ أَن يُه","ديها مِثلُكَ كُسوَه",54,"و",2,0],["فُروعُ مَجدٍ جَلَّت مَآثِرُهُم","مِنَ العُلى في الفُروعِ وَالقِمَمِ",55,"م",1,0],["فَرَوَّى جَيْشَهُ أَلْفاً وَنِصْفاً","وَأَفْضَلَ فَضْلَ هَاتِيكَ الْعُيُونِ",56,"ن",1,0],["فروحي مع الأرواحِ في دارِ أنسِها","وجسمي مع الأجسامِ في دارِ وحشتي",57,"ي",1,0],["فروحي وروحُ الله في كلِّ عالمٍ","على وجههِ سيمى التُّقى والفضيلة",57,"ه",1,0],["فروحي لها تعليلةٌ من تحيَّةٍ","ومن بسمةٍ تُحيي الرجاءَ رماما",58,"م",2,0],["فروحي لها من كلّ روحٍ صبابةٌ","ترجِّعُ في قلبي رنينَ المعازِف",59,"ف",1,0],["فَرَوْضَةُ الأَمْنِ في أَفْنَانِها غَضَفٌ","ودِيمَةُ المَنِّ في أَثنائِها وَطَفُ",60,"ف",1,0],["فَروى أَحسنَ الحَديث صَحيحاً","مُسنداً عنهُمُ وأَدّى الرِسالَه",61,"ل",2,0],["فروعُ النارِ قد طالتْ ذراها","وَبالدمِ لم يزلْ رطْباً ثراها",62,"ا",3,0],["فُروعُها مِن بَديعِ الخَطِّ في اللَقَمِ","وَلَم تَزَل زُمرَةَ الكُفّارِ ناكِرَةً",63,"ه",1,0],["فروّعني أن أري العالمين","مقابرَ تنبضُ فيها الرِمَم",64,"م",1,0],["فَرَوَّحَها الرَجافَ خَوصاءَ تَحتَذي","عَلى اليَمِّ بارِيَّ العِراقِ المُضَفَّرا",65,"ر",2,0],["فُرُوعٌ ذَوَتْ لمَّا ذَوَيتَ وإنَّما","يكونُ بَقاءُ الفَرْعِ مَا بَقِيَ الأَصْلُ",66,"ل",1,0],["فَروحُ النُفوسِ بَرراحِ الكُؤوسِ","وَشَمَلِ النَدامى إِذا ما التَأَم",67,"م",1,0],["فروعٌ سَمتْ من جِذْمِ نَبْت بنِ مالكٍ","سُمُوّاً على حُدْثِ الأُصولِ نوابت",68,"ت",1,0],["فروَّى ضارِجاً فَذَواتِ خَيمٍ","فَحَزَّةَ فالمدافعَ من قَنَانِ",69,"ن",1,0],["فِرّوا فَهَذا القَرُّ قُل","نا قَد سُبِقتَ بِذا الكَلامِ",70,"م",1,0],["فروح اللَه إن قرت أقرَّت","وشاهده العزيز اليوسفي",71,"ي",1,0],["فَرّوا مِن الْخَوفِ فما قصّرتْ","خيلكَ في أَدبارها ركْضا",