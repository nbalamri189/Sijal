208925",""],[5000,"حنين الحنايا","https://www.poetsgate.com/ViewPoem.aspx?id=5072",""],[3591,"أحبكمَ والشاهداتُ الحواسدُ","https://www.poetsgate.com/ViewPoem.aspx?id=149376",""],[5155,"حرب.... وانتصار","https://www.poetsgate.com/ViewPoem.aspx?id=176309",""],[5264,"ياللى بتنادى","https://www.poetsgate.com/ViewPoem.aspx?id=151178",""],[5302,"بلغوا هندا سلامي","https://www.poetsgate.com/ViewPoem.aspx?id=200950",""],[592,"الحمد لله حمداً دائماً وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=128796",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5410,"ألوان باهتة","https://www.poetsgate.com/ViewPoem.aspx?id=133055",""],[5410,"إلامَ الصَبر...؟!","https://www.poetsgate.com/ViewPoem.aspx?id=141849",""],[5410,"هواجس على أسوار بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=152248",""],[5410,"خفقة في بداية المطاف","https://www.poetsgate.com/ViewPoem.aspx?id=154943",""],[5431,"ويملكني جميل الروح سهلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=187535",""],[5431,"للقدس...للحبيبة...","https://www.poetsgate.com/ViewPoem.aspx?id=194944",""],[5436,"حديثُ الموت والنصر (تركي عبد الغني )","https://www.poetsgate.com/ViewPoem.aspx?id=33447",""],[5542,"غدا يتحدث الرطب","https://www.poetsgate.com/ViewPoem.aspx?id=10030",""],[5544,"حاضرة المعالي","https://www.poetsgate.com/ViewPoem.aspx?id=213443",""],[5545,"فراتيّ المواطن","https://www.poetsgate.com/ViewPoem.aspx?id=184748",""],[5616,"الجوع.. الجوع!","https://www.poetsgate.com/ViewPoem.aspx?id=205221",""],[5626,"أنا وأنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=189593",""],[5628,"الكهوف","https://www.poetsgate.com/ViewPoem.aspx?id=178799",""],[5632,"برآة طفل","https://www.poetsgate.com/ViewPoem.aspx?id=178124",""],[5663,"فلينبت القمح","https://www.poetsgate.com/ViewPoem.aspx?id=200907",""],[5804,"قصيدة من مساجلة 3","https://www.poetsgate.com/ViewPoem.aspx?id=180670",""],[5845,"قفا برياضِ الشعبِ شعبِ القرنفلِ","https://www.poetsgate.com/ViewPoem.aspx?id=198491",""],[5873,"أحلى الأماني","https://www.poetsgate.com/ViewPoem.aspx?id=215305",""],[5943,"رعودُ الشَّرِّ تفزعنا","https://www.poetsgate.com/ViewPoem.aspx?id=34330",""],[5956,"الرسالة المحمدية","https://www.poetsgate.com/ViewPoem.aspx?id=184653",""],[5956,"إذا استبصرتَ نيّاتي","https://www.poetsgate.com/ViewPoem.aspx?id=194411",""],[5956,"السجين برضائه","https://www.poetsgate.com/ViewPoem.aspx?id=207195",""],[5956,"مناجاةُ أبٍ موَسوَسٍ على ابنته العُزَّى","https://www.poetsgate.com/ViewPoem.aspx?id=207206",""],[5957,"أحبكَ أكثر","https://www.poetsgate.com/ViewPoem.aspx?id=11393",""],[5970,"طلبت العلا حتى استلان لي الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=130656",""],[6070,"حبيبُ الله تهواكَ السماءُ","https://www.poetsgate.com/ViewPoem.aspx?id=188831",""],[6097,"خُطى القَدَر","https://www.poetsgate.com/ViewPoem.aspx?id=197430",""],[6237,"رصيد الحياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77886&r=&rc=28",""]],"verses":[["وَنَنْهَضُ لِلْعَلْياءِ وَالجَدُّ عاثِرٌ","وَنَحْنُ بِمُسْتَنِّ الهَوانِ وُقوعُ",0,"ع",1,0],["وَنُنعِلُ خَيلَنا في كُلِّ حَربٍ","عِظاماً دامِياتٍ أَو جُلودا",1,"د",2,0],["وَنُنعِلُ خَيلَنا في كُلِّ حَربٍ","مِنَ الساداتِ أَقحافاً دَمِيَّه",2,"ي",2,0],["وَنُنادي كُلَّ مَأمولٍ وَما","غَيرُ أَصداءِ المُنادي مِن مُجيبِ",3,"ب",1,0],["ونُنْهضكم في منهج العلم نهضةً","مقَوّمةً مَا اعْوَجّ فيكم من الأمر",4,"ر",1,0],["ونناديه نحنُ كيف أبو الحا","رثِ أم كيفَ صبرُهُ للعذابِ",5,"ب",1,0],["وَنَنقُلُ عَنكُمُ أَخبارَ صِدقٍ","تُحاكي النِدَّ في الرَوضِ اِنتِشارا",6,"ر",2,0],["ونُناجي روحَ الطَّبيعَةُ في الكونِ","ونُصغي لقلبِها المتغنِّي",7,"ي",1,0],["وَنَنشُقُ الجَنَّةَ مِن","أَعوادِهِ المُنَضَّرَه",8,"ر",2,0],["وَنُنكِرُ أَن تُطَرِّقَنا المَنايا","كَأَنّا قَد خُلِقنا لِلخُلودِ",9,"د",1,0],["وننقضه عند مر الشتاء","إذا كان عنا قليل الغناء",10,"ا",2,0],["وَنُنكِرُ إِن شِئنا عَلى الناسِ قَولَهُم","وَلا يُنكِرونَ القَولَ حينَ نَقولُ",11,"ل",1,0],["ونَنهضُ لِلجهادِ إذا تَولَّوْا","وظَلُّوا في مَجاثِمهم قُعودا",12,"د",2,0],["ونَنْأَى والقلوبُ هَوىً وشوقاً","قُلوبُ الجيرةِ المُتزاوِرينا",13,"ن",2,0],["ونَنْحَرُهَا مَثنىً إِذَا الرِّيحُ أَعْصَفَتْ","وخِلْتَ بُيُوتَ الحَيِّ مَنْزِلَةً مَحْلاَ",14,"ل",2,0],["وننصُّ رايةَ مصرَ أنَّى تشتهي","مصرٌ ويرضاهُ لها الهرمانِ",15,"ن",1,0],["وَنَنْتَزِعُ العُروشَ بِبَطْنِ وجٍّ","وتصبحُ دُورُكم منكمُ خَلُوفَا",16,"ف",2,0],["وننفح الناس بأعرافها","فيعرف الفضل لنا الناشقون",17,"ن",1,0],["وننظمه أُنشودةً وطنيةً","تحمِّس رِعْدِيدًا، وتُوقِظُ غافيا",18,"ي",2,0],["وننشده للمخلصين مدائحًا","وللزُّعماء الراحلين مَرَاثِيا",18,"ي",2,0],["وننسى المنايا وقد انفذت","مقاتلنا الأسهم الصادره",19,"د",3,0],["وننهل في ورد اللماغلة الظما","فيالك من ري لغلة وارد",20,"د",1,0],["وننعم من وصل الحبيب بجنة","هي الخلد لكن الفتى غير خالد",20,"د",1,0],["وننالَ منهُ غيرَ واحدة","ٍ إِنَّ السَّمَاعَ لأَهْوَنُ الْخَطْبِ",21,"ب",1,0],["وننُكِّسَ يومَ الطفّ تاريخُ أمة","مشى قبلَها ذا صولةٍ متبخِترا",22,"ر",2,0],["وَنَنشَقُ أنفاس النسيم بليلةً","معطرة بين المذانب والزهر",23,"ر",1,0],["وَنَنعَمُ بِاِجتِماعٍ لَيسَ يُخشى","عَلَيهِ البَينُ وَالدَهرُ الغَشومُ",24,"م",1,0],["ونناغي الطيور وهي على الشاطىء","تشدو وتعلين الأفراحا",25,"ح",2,0],["وننشده كل ما يشتهيه","فشعر بصهبائه لاعب",26,"ب",1,0],["وَنُنْشِدُ حُرَّ الْكَلاَمْ","وَنَنْسِقُ دُرَّ النِّظَامْ",27,"م",1,0],["ونَنصُرُكُم وأنتم من عُدانا","فنؤخذَ بالخَّديعةِ من دَهِيِّ",28,"ي",1,0],["وَننزل منزل الخلان منها","وَنَروي منمناهلها العذاب",29,"ب",1,0],["وَننزلَ عن أَيدي الركاب نُريحها","وَنشكرَ فينا ما بقينا اِصطناعَها",30,"ع",3,0],["وننساه ويذكرنا فنطغى","ونسعى في الضلالة دون قصد",31,"د",1,0],["وننسى أننا كنا","وفي أيامنا جدب",32,"ب",1,0],["وَنَنسُبُ تَهذِيبَ تَأْدِيبهنَّ","لِتَهذِيبِ فُرسانِهِنَّ الكِرامِ",33,"م",1,0],["ونُنيخُ في البيداء نَعلَمُ أنّهُ","يوماً تَعوُدُ تُنيخُنا البيداء",34,"ا",2,0],["وننعمُ بالملاح بخفض عيش","مدى الأَوقات من بمٍّ وزير",35,"ر",1,0],["وننتظر العقبى فإنَّ وراءها","من اللُّطف ما يحظى به سائرُ الملا",36,"ل",2,0],["ونَنْصِبُ للصَّواخِدِ كلَّ وَجْهٍ","بعيدٍ أَن يُحَيَّا بالسَّلامِ",37,"م",1,0],["وننبش عهدة الخنزي","ر فرنكلين ذي الوخم",38,"م",1,0],["وننسى زمانا قد أساء بيتنا","وفرقنا عما عهدنا بأوطان",39,"ن",1,0],["ونندمُ وقتما لا ينفعُ الندَمو","ونندبُ حظّنا والموتُ يقتربُ",40,"ب",1,0],["وننزِل مع اللّي ما يِمِلّونه الجيران","ولا تسْمعَه مَغْثي هَلَهْ يوم باتَلْفيه",41,"ي",2,0],["وَننشر فَخره ما قُلت مَدحاً","جَدير بِالثَنا حبر أَجلُّ",42,"ل",1,0],["وَنُنكِرُ إِن شِئنا عَلى النّاس قَولَهم","وَإِنّا إِلى قَولِ الصّوابِ نَميلُ",43,"ل",1,0],["وننحَتُه ُشارعَا ًشارعَاً","ونزرَع ُفي أرضِهِ الزيزفونْ",44,"ن",1,0],["وننكر فضل أشبال","ميامين لهُ غُرِّ",45,"ر",1,0],["ونُنعِم ولا يُنعم علينا ومن يَقِس","ندانا بأَندى من تكلَّمَ نُفضِلِ",46,"ل",1,0],["وننكر ان شئنا خلائق معشر","فقل للئام القوم ما ينكروا منا",47,"ن",2,0],["وَننشدُ كلّ شعر لي","سَ في الأشعارِ مملولُ",48,"ل",1,0],["وننهض نحو الكافرين بعزمة","بأمثاله تحوي البلاد وتقسمُ",49,"م",1,0],["ونناجيك بالمهمات إذ أنت","بالقائها اليك خليق",50,"ق",1,0],["وننثني همسات","على لُها الأدغال",51,"ل",1,0],["وننثر الطيبَ نثر","الشموس وهجَ الآل",51,"ل",1,0],["وننظر ذلك الفصح المرجّى","ويشفى ضعفنا ذاك القيامُ",52,"م",1,0],["وننشق منه طيب عبير نشرٍ","حكى معطاره مسكاً وندَّا",53,"د",2,0],["وَنَنَالُ فِيهَا مِن تَأَلُّفِنَا وَلَو","مَا فيه سُخنَةُ أَعيُنِ الرُّقَبَاءِ",54,"ا",2,0],["وننادي على الدَّوامِ","عاشَ لبنانُ مجدُنا",55,"ن",2,0],["وننعى على الزعماء البلاءَ","ونزداد دون الزعيم انقساما",56,"م",2,0],["وننصر مظلوماً ونهلك ظالماً","يفاخر بالدنيا ويحتقر الأخرى",57,"ر",2,0],["ونُنِيخُ بالبطحا فيَحطِمُ كُلَّ ما","حَطَمَت عليهِنَّ النُّفُوسَ حَطِيمُهَا",58,"م",3,0],["وَنَنظُرُ مِن أَنوَارِ أَنوَاعِ حُسنِهم","سَطَايعَ حُسن لِلمُهَيَّمِ تَفتِنُ",59,"ن",1,0],["ونُنْشِدُهُ مدائحَهُ اقتضاباً","فيعطينا مَنائحَهُ ارْتِجالاَ",60,"ل",2,0],["وننوح للمطويِّ في أكفانه","أم للطريح لقىً بلا أكفان",61,"ن",1,0],["وننشقُ ملء الفؤادِ الهواء","فتُنعشنا النسمُ العاطره",62,"ر",2,0],["وننسى كل ما قالو","هُ خيرا كان أو شرا",63,"ر",2,0],["وننسج الشمس إن مدّت أشعتها","أثواب عطر على أعطاف أبكار",64,"ر",1,0],["وننشر في تلك المحاني تحية","ونطوي على البرحا ضلوعاً حوانيا",65,"ي",2,0],["وَنَنالُ مِن غُرَفِ الجِنانِ عَلِيَّها","وَنجاوِزُ الوِلدانَ وَالأَترابا",66,"ب",2,0],["وَنَنحر هَدياً لِلحَبيب قُلوبنا","فَمَوت القِلى وَالبُعد أَدهى وَأَعظم",67,"م",1,0],["وَننشق مِن رَوض الحجاز وَشعبه","أَريجاً يحاكي المسك وَهوَ بشام",68,"م",1,0],["وَنَنصُرُ مَولانا وَنَمنَعُ سِربَنا","وَيَذهَبُ عافينا لَنا غَيرَ لائِمِ",69,"م",1,0],["وننثر الخير في دنيا مؤقتة","لكي ننال نعيما دائم النعم",70,"م",1,0],["وَنُنظّفُ الأيدي كذا","وَنُزيلُ بالماءِ القَذَر",71,"ر",1,0],["وننحوا نحوهم في كل نادِ","ونقفُوا فضلهم في كل وادِ",72,"د",1,0],["ونُنشئُ من دمائِهم سَحاباً","تُكشِّفُ من قَساطِلها نُحولا",73,"ل",2,0],["وَنَنظُر أَهل الجَهل في جَمع قلة","وَننظمهم في سلك خرس البَهائم",74,"م",1,0],["وَنُنفدُ العمر في لَهو وَفي لعب","وَالترب ننسى كمتعوب على سَفر",75,"ر",1,0],["وَننشدََه عن أُسْد غابٍ تكنفت","بعيصِ العَوالي مَكنَسَ الرشأ الأَلمى",76,"م",2,0],["وننقش الفصوص بالنصوص","ونعرف العموم بالخصوص",77,"ص",1,0],["وننذركم من بعدها أن من عصى","فافسد أو شق العصى دمه هدر",78,"ر",1,0],["وننشد في سكون اللي","ل في أشجى التلاحين",79,"ن",1,0],["وننتظر الرزايا والبلايا","وبعد فبالوعيد لنا انتظار",80,"ر",1,0],["ونُنفِذ في طغاةِ القوم أمراً","يذوبُ بِسيره قلَبُ الجَمادِ",81,"د",1,0],["وننغزوهم فنقتلُ كلَّ خرقٍ","ونسبي كل آنسةِ الدلال",82,"ل",1,0],["وَنَنقُلُ الكَلاَمَ لِلمُؤَّثِّرِ","مُنحَصِراً وَمَاسِوَى المُنحَصِرِ",83,"ر",1,0],["وننصبُ الخياما","ونصحبُ الانعاما",84,"م",2,0],["وننظر العدل مبسوطاً ومنتشراً","وفي الأعادي غراب البين قد نعبا",85,"ب",2,0],["وننبذ عنا الخلف فالخلف مهلك","ويشمت فيه حاسد ومعاند",86,"د",1,0],["وَنَنصُرُ مَولانا وَنَعلَمُ أَنَّهُ","كَمَا النّاسُ مَجرومٌ عَلَيهِ وَجارِمُ",87,"م",1,0],["وننبَرى لنجعةِ الرَوضِ إذا","ما هَبَّ مَطلُولُ النسيمِ وانبرَى",88,"ا",1,0],["وننثني إلى اجتلاءِ سَمَكٍ","في شَبَكٍ أَعجِب بشهِ مِن مُجتَلى",88,"ا",1,0],["وَنَندبُ أَوقاتاً تََقضَّت بِظلِّهِ","لنا مَع ظِباءٍ كالظُّبَا في الهَياكلِ",89,"ل",1,0],["وننصر دين الله في كل مشهد","بفتيان صدق من كرام الأعارب",90,"ب",1,0],["وننعى حزننا بنشيد ود","فتظهر بسمة وسط النحيب",91,"ب",1,0],["وننكر قول العاذلين لنا به","ولاينكرون القول حين نقول",92,"ل",1,0],["وننهز الفرقة الرعناء , نخنقها","إن عضّنا رهبٌ في الزِّنْد أو لَسَبَا",93,"ب",2,0],["ونَنْصِبُ مِنْ ثَرى الأوطان جسْرا","يُمَهّدُ للأبَاةِ العابرينا",94,"ن",2,0],["وننثر السعد َ في الأجواء كل ضحى ً","نُسقى السرور َ وعقل الحزن مخلوسُ",95,"س",1,0],["وننفثُ تعويذةً للقلوبِ","تحرِّكُ ليلاتِنا الجامدة",96,"د",2,0],["ونَنْسفها جِبالاً من همومٍ","سنَنْسِفُها جِبالَ الحُزْنِ نَسفا",97,"ف",2,0],["وننكر قولَ متَّهِم","بما قد كان ينهمل",98,"ل",1,0],["وننشر ما نرى خُطباً","فتؤسرنا ونُعتقلُ",98,"ل",1,0],["وننسى ان موعدَنا قريبٌ","أليس الموت ميقات البرايا؟",99,"ا",3,0],["وننسجُ ثوبَ أمنيةٍ","يطرّزُ من سنا الفَجرِ",100,"ر",1,0],["وننشدُ الوصلَ أن يبقى لنا وطناً","يحفّه الأمنُ لا خوفٌ ولاترحُ!",101,"ح",1,0],["وَنَنْعَمَ بِالْعِشْقِ الْمُكَلَّلِ بِالْلِقَاْ","وَنَزْدَاْدَ مِنْ إِلْفِ الأَلِيْفِ تَأَلُّفَاْ",102,"ف",2,0],["وَنَنْهَبُ لَذَّاْتِ الْغَرَاْمِ جَمِيْعَهَاْ","لأنَّ لَذِيْذَ الْحُبِّ بِالنَّهْبِ يَصْلُحُ",103,"ح",1,0],["وَنَنْعَمُ بِاللِّقَاْءِ بِلاْ رَقِيْبٍ","وَتَنْتَعِشُ الْقُلُوْبُ كَمَاْ تَشَاْءُ",104,"ا",2,0],["وننسى أنَّه فرحٌ أتانا","من الرحمن ربّ العالمينا",105,"ن",2,0],["وننسى التلاوة مما التزمنا","تقلَّص منها أداء وأجر",106,"ر",1,0],["وننسى أَننا أصلاً","خُلِقنا للمعاناةِ",107,"ه",1,0],["ونُنُشِدُ للحُبِّ أحلى قَصيدٍ","يَغيظُ حَسودي ويُشجِي عِداكا",108,"ك",2,0],["وننظر أعواد المابر كلما","اغتليت ذراها وهي نشوى موائدُ",109,"د",1,0],["وننسف قلعة الطغيان حتى","نحرر ارضنا بعد احتلال",110,"ل",1,0],["وننتفع من خير بلادنا","يا حبايب افهمونا",111,"ن",2,0],["وننسل إن زلت خطانا لفكرة","تفرق قلبينا فننأى ونقرف",112,"ف",1,0],["وننثني بعد هذا نحو قبلتنا","ندعو الإله ما يدعونه الحنفا",113,"ف",2,0],["وننفع من زرنا ببذل دعائنا","ولا ندعه حاشا فذا الجعل للند",114,"د",1,0],["وننهاه عن طغيانه وضلاله","فلا ينتهي عما يرى ويحاوله",115,"ل",2,0],["ونناجي الغرب وما حصدوا","كي نحظى بِفُتاتٍ قُلِبا",116,"ب",2,0],["وننسى أنّ في الإيمان عزماً","يحقق في مدى العيش احتراما",117,"م",2,0],["وننسى 