{"poems":[[63,"أرقنا وأسراب النجوم هجوع","https://www.aldiwan.net/poem45921.html","الطويل"],[3,"ألا يا عبل ضيعت العهود","https://www.aldiwan.net/poem144.html",""],[3,"لقينا يوم صهباء سريه","https://www.aldiwan.net/poem224.html",""],[86,"آذنت شمس حياتي بمغيب","https://www.aldiwan.net/poem10474.html","الرمل"],[88,"خطاب يهودا قد دعانا إلى الفكر","https://www.aldiwan.net/poem44821.html","الطويل"],[51,"لهف نفسي على رصاص مذاب","https://www.aldiwan.net/poem8508.html","الخفيف"],[91,"سرى يطوي بنا الأميال طيا","https://www.aldiwan.net/poem8858.html","عموديه"],[92,"قد سكرنا بحبنا واكتفينا","https://www.aldiwan.net/poem38928.html","الخفيف"],[85,"حلفت بالمستره","https://www.aldiwan.net/poem62862.html","مجزوء الرجز"],[45,"أجز من غلة الصدر العميد","https://www.aldiwan.net/poem62751.html","الوافر"],[61,"وبيت نشيده للمصيف","https://www.aldiwan.net/poem51393.html","المتقارب"],[66,"أراك إذا ما قلت قولا قبلته","https://www.aldiwan.net/poem38767.html","الطويل"],[105,"أميطي الغيب وادرعي الشهودا","https://www.aldiwan.net/poem42134.html","الوافر"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39550","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67325","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141925","السريع"],[106,"حنين إلى الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=179322",""],[77,"نعمنا بوصل من حبيب مساعد","https://www.poetsgate.com/ViewPoem.aspx?id=34091",""],[50,"أَفِدَ الرَّحِيلُ وحثَّنِي صَحْبِي","https://www.poetsgate.com/ViewPoem.aspx?id=17118",""],[90,"عاشوراء","https://www.poetsgate.com/ViewPoem.aspx?id=179150",""],[148,"بأوجد مني مذ نأيت وإنما","https://www.aldiwan.net/poem68468.html","الطويل"],[191,"ألا ليت الركاب غدون وقفا","https://www.aldiwan.net/poem13131.html","الوافر"],[195,"أسفر الصبح قم نحيي الصباحا","https://www.aldiwan.net/poem39883.html","الخفيف"],[209,"حضرنا إلى نهرنا نستقيه","https://www.aldiwan.net/poem46235.html","المتقارب"],[235,"صلاة السميع العليم","https://www.aldiwan.net/poem19788.html","المتقارب"],[268,"رأيت الشرق ملكا للنبي","https://www.aldiwan.net/poem35655.html","الوافر"],[269,"مضى زمن الصبا فدع التصابي","https://www.aldiwan.net/poem52055.html","الوافر"],[295,"سريرة شوق في الهوى من أذاعها","https://www.aldiwan.net/poem33229.html","الطويل"],[326,"تعاليت لا مولى سواك خلقتني","https://www.aldiwan.net/poem54954.html","الطويل"],[326,"تعالي يابنة الأحلام","https://www.aldiwan.net/poem54976.html","الهزج"],[346,"أمير له طلعة طالما","https://www.aldiwan.net/poem20720.html","المتقارب"],[362,"هل في عتاب الحادثات غناء","https://www.aldiwan.net/poem61013.html","الكامل"],[413,"أقول لصاحبي ورضيع كأسي","https://www.aldiwan.net/poem54079.html","الوافر"],[413,"قدمت قدوم الخير من بعد غيبة","https://www.aldiwan.net/poem54122.html","الطويل"],[436,"إليك سبقت أقدار الحمام","https://www.aldiwan.net/poem34862.html","الوافر"],[441,"وشب بأرض بوليفا","https://www.aldiwan.net/poem55925.html","عموديه"],[480,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[503,"العار","https://www.aldiwan.net/poem42463.html","البسيط"]],"verses":[["وَنَنْهَضُ لِلْعَلْياءِ وَالجَدُّ عاثِرٌ","وَنَحْنُ بِمُسْتَنِّ الهَوانِ وُقوعُ",0,"ع",1,0],["وَنُنعِلُ خَيلَنا في كُلِّ حَربٍ","عِظاماً دامِياتٍ أَو جُلودا",1,"د",2,0],["وَنُنعِلُ خَيلَنا في كُلِّ حَربٍ","مِنَ الساداتِ أَقحافاً دَمِيَّه",2,"ي",2,0],["وَنُنادي كُلَّ مَأمولٍ وَما","غَيرُ أَصداءِ المُنادي مِن مُجيبِ",3,"ب",1,0],["ونُنْهضكم في منهج العلم نهضةً","مقَوّمةً مَا اعْوَجّ فيكم من الأمر",4,"ر",1,0],["ونناديه نحنُ كيف أبو الحا","رثِ أم كيفَ صبرُهُ للعذابِ",5,"ب",1,0],["وَنَنقُلُ عَنكُمُ أَخبارَ صِدقٍ","تُحاكي النِدَّ في الرَوضِ اِنتِشارا",6,"ر",2,0],["ونُناجي روحَ الطَّبيعَةُ في الكونِ","ونُصغي لقلبِها المتغنِّي",7,"ي",1,0],["وَنَنشُقُ الجَنَّةَ مِن","أَعوادِهِ المُنَضَّرَه",8,"ر",2,0],["وَنُنكِرُ أَن تُطَرِّقَنا المَنايا","كَأَنّا قَد خُلِقنا لِلخُلودِ",9,"د",1,0],["وننقضه عند مر الشتاء","إذا كان عنا قليل الغناء",10,"ا",2,0],["وَنُنكِرُ إِن شِئنا عَلى الناسِ قَولَهُم","وَلا يُنكِرونَ القَولَ حينَ نَقولُ",11,"ل",1,0],["ونَنهضُ لِلجهادِ إذا تَولَّوْا","وظَلُّوا في مَجاثِمهم قُعودا",12,"د",2,0],["ونَنْأَى والقلوبُ هَوىً وشوقاً","قُلوبُ الجيرةِ المُتزاوِرينا",13,"ن",2,0],["وننصُّ رايةَ مصرَ أنَّى تشتهي","مصرٌ ويرضاهُ لها الهرمانِ",14,"ن",1,0],["وَنَنْتَزِعُ العُروشَ بِبَطْنِ وجٍّ","وتصبحُ دُورُكم منكمُ خَلُوفَا",15,"ف",2,0],["وننفح الناس بأعرافها","فيعرف الفضل لنا الناشقون",16,"ن",1,0],["وننظمه أُنشودةً وطنيةً","تحمِّس رِعْدِيدًا، وتُوقِظُ غافيا",17,"ي",2,0],["وننشده للمخلصين مدائحًا","وللزُّعماء الراحلين مَرَاثِيا",17,"ي",2,0],["وننهل في ورد اللماغلة الظما","فيالك من ري لغلة وارد",18,"د",1,0],["وننعم من وصل الحبيب بجنة","هي الخلد لكن الفتى غير خالد",18,"د",1,0],["وننالَ منهُ غيرَ واحدة","ٍ إِنَّ السَّمَاعَ لأَهْوَنُ الْخَطْبِ",19,"ب",1,0],["وننُكِّسَ يومَ الطفّ تاريخُ أمة","مشى قبلَها ذا صولةٍ متبخِترا",20,"ر",2,0],["وَنَنشَقُ أنفاس النسيم بليلةً","معطرة بين المذانب والزهر",21,"ر",1,0],["وَنَنعَمُ بِاِجتِماعٍ لَيسَ يُخشى","عَلَيهِ البَينُ وَالدَهرُ الغَشومُ",22,"م",1,0],["ونناغي الطيور وهي على الشاطىء","تشدو وتعلين الأفراحا",23,"ح",2,0],["وننشده كل ما يشتهيه","فشعر بصهبائه لاعب",24,"ب",1,0],["وَنُنْشِدُ حُرَّ الْكَلاَمْ","وَنَنْسِقُ دُرَّ النِّظَامْ",25,"م",1,0],["ونَنصُرُكُم وأنتم من عُدانا","فنؤخذَ بالخَّديعةِ من دَهِيِّ",26,"ي",1,0],["وَننزل منزل الخلان منها","وَنَروي منمناهلها العذاب",27,"ب",1,0],["وَننزلَ عن أَيدي الركاب نُريحها","وَنشكرَ فينا ما بقينا اِصطناعَها",28,"ع",3,0],["وننساه ويذكرنا فنطغى","ونسعى في الضلالة دون قصد",29,"د",1,0],["وننسى أننا كنا","وفي أيامنا جدب",30,"ب",1,0],["وَنَنسُبُ تَهذِيبَ تَأْدِيبهنَّ","لِتَهذِيبِ فُرسانِهِنَّ الكِرامِ",31,"م",1,0],["ونُنيخُ في البيداء نَعلَمُ أنّهُ","يوماً تَعوُدُ تُنيخُنا البيداء",32,"ا",2,0],["وننعمُ بالملاح بخفض عيش","مدى الأَوقات من بمٍّ وزير",33,"ر",1,0],["وننتظر العقبى فإنَّ وراءها","من اللُّطف ما يحظى به سائرُ الملا",34,"ل",2,0],["ونَنْصِبُ للصَّواخِدِ كلَّ وَجْهٍ","بعيدٍ أَن يُحَيَّا بالسَّلامِ",35,"م",1,0],["وننبش عهدة الخنزي","ر فرنكلين ذي الوخم",36,"م",1,0],["وننسى زمانا قد أساء بيتنا","وفرقنا عما عهدنا بأوطان",37,"ن",1,0],["ونندمُ وقتما لا ينفعُ الندَمو","ونندبُ حظّنا والموتُ يقتربُ",38,"ب",1,0]]}