{"poems":[[53,"من رأى أعينا حذفن","https://www.aldiwan.net/poem29625.html","مجزوء الخفيف"],[53,"أما آن للدمع أن يستجم","https://www.aldiwan.net/poem29769.html","المتقارب"],[77,"سبق القضاء وأبرم المحتوم","https://www.aldiwan.net/poem36093.html","الكامل"],[77,"زحفت إلي ركائب البرغوث","https://www.aldiwan.net/poem36669.html","الكامل"],[88,"بغداد حسبك رقدة وسبات","https://www.aldiwan.net/poem45007.html","الكامل"],[72,"يا سائلي بدمشق عن أحوالي","https://www.aldiwan.net/poem19484.html","الكامل"],[72,"زحفت بيض الظبا لما رنا","https://www.aldiwan.net/poem20619.html","الرمل"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[51,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[29,"بئس الفوارس عند معترك القنا","https://www.aldiwan.net/poem6062.html","الكامل"],[91,"زحزحت عن صدرها الغيم السماء","https://www.aldiwan.net/poem8732.html","عموديه"],[91,"خير ما يكتبه ذو مرقم","https://www.aldiwan.net/poem8865.html","عموديه"],[91,"لمن الديار تنوح فيها الشمأل","https://www.aldiwan.net/poem9061.html","عموديه"],[85,"شرفاً نصير ارفع جبينك عالياً","https://www.aldiwan.net/poem8081.html","الكامل"],[85,"الله أكبر كم في الفتح من عجب","https://www.aldiwan.net/poem63785.html","البسيط"],[43,"باد هواك صبرت أم لم تصبرا","https://www.aldiwan.net/poem9608.html","الكامل"],[45,"خطته فلم تحفل به الأعين الوطف","https://www.aldiwan.net/poem65143.html","الطويل"],[45,"قد لعمري يا ابن المغيرة أصبحت","https://www.aldiwan.net/poem64687.html","الخفيف"],[61,"أسعيد هل لك في زيارة منزل","https://www.aldiwan.net/poem51625.html","الكامل"],[66,"زحاف الشعر قبض ثم كف","https://www.aldiwan.net/poem38648.html","الوافر"],[74,"ركضوا الجياد إلى الجلاد صباحا","https://www.aldiwan.net/poem12884.html","الكامل"],[74,"طاف الظلام به فأسرج أدهما","https://www.aldiwan.net/poem13248.html","الكامل"],[105,"يا بني سعد بن بكر مرحبا","https://www.aldiwan.net/poem43987.html","الرمل"],[105,"دعا فأجابوا والقلوب صوادف","https://www.aldiwan.net/poem44224.html","الطويل"],[46,"أمر الخالق فاقبل ما أمر","https://www.aldiwan.net/poem22740.html","الرمل"],[46,"غير مجد في ملتي واعتقادي","https://www.aldiwan.net/poem23625.html","الخفيف"],[76,"عجبت للفظ منك ذاب نحافة","https://www.aldiwan.net/poem38876.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142018","المديد"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54251","الخفيف"],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"الشباب المر","https://www.poetsgate.com/ViewPoem.aspx?id=178970",""]],"verses":[["زَحَمَت مِنهُمُ المَنو","نُ الجِبالَ الرَواسِيا",0,"ي",2,0],["زَحَمنَ بِنا اللَيلَ في ثَوبِهِ","فَكادَت مَناكِبُهُ تَنحَطِم",1,"م",1,0],["زَحَفَتْ إِلى حَرْبِي وَعُمْرِيَ مَعْقِلٌ","وَمُخَلّصِي مِنْ بَأسِهَا مَعْدُومُ",2,"م",1,0],["زَحَفَتْ إليّ رَكائِبُ البُرْغوثِ","نَمَّ الظّلامُ بركْبِها المَحْثوثِ",3,"ث",1,1],["زَحَفت جيوش السَيل حتى أصبحت","بالكرخ نازلة لها ضَوْضاة",4,"ه",1,0],["زحلٌ يقارن حاجتي وقد انحنى","ظهري من الهمِّ انحناء الدال",5,"ل",1,0],["زحفتْ بيضُ الظُّبا لما رنا","فتلقاها سريعاً مقتلي",6,"ي",1,1],["زَحَمَ الأيورَ على الفرو","جِ مَعاً فسدَّ بها نِقابهْ",7,"ب",2,0],["زَحوف لدى الممسى كأنّ سحيفهُ","إذا انساب في جنْح الظلامِ نَشيشُ حمْ",8,"م",1,0],["زَحَفَ الأَراقِمُ بِالمَجازِ لِوِردِها","كَالنَهيِ سالَ بِأَبطَحَيهِ سُيولُ",9,"ل",1,0],["زَحزَحَت عَن صَدرِها الغَيمَ السَماء","وَأَطَلَّ النورُ مِن كَهفِ الشِتاء",10,"ا",2,1],["زَحزَحَ الأُمَّةَ عَن مَركَزِها","وَطَوى رايَتِها المُنتَشِرَه",11,"ر",2,0],["زَحَفَ الجَرادُ بِقَضِّهِ وَقَضيضِهِ","سَيرَ الغَمامِ إِذا زَفَتهُ الشَمأَلُ",12,"ل",1,0],["زَحزَحتَهُ فَتَخاذَلَت أَجلادُهُ","وَطَرَحتَهُ أَرضاً فَصَلَّ صَليلا",13,"ل",2,0],["زَحَفتَ زَحفَ أَتِيٍّ غَيرِ ذي شَفَقٍ","عَلى الوِهادِ وَلا رِفقٍ عَلى الهِضَبِ",14,"ب",1,0],["زُحَلٌ عَلى أَنَّ الكَواكِبَ قَومُهُ","لَو كانَ مِنكَ لَكانَ أَكرَمَ مَعشَرا",15,"ر",2,0],["زُحوفٌ إِذا ما مَعشَرٌ زاغَ رَأيُهُم","فَلَم يَستَقيموا سارَ تِلقاءَهُم زَحفُ",16,"ف",1,0],["زُحَلِيٌّ قَدِ اِستَفادَ مِنَ الشُؤ","مِ جَليساً وَمُؤنِساً وَضَجيعا",17,"ع",2,0],["زَحفانِ لم يَحْظَ العزيزُ برُتبَةٍ","فيهم ولا آبَ الذّليلُ بعارِ",18,"ر",1,0],["زُحافُ الشِعرِ قَبضٌ ثُمَّ كَفٌّ","بِهِنَّ لِأَحرُفِ الأَجزاءِ نَقصُ",19,"ص",1,1],["زَحَمَت مَناكِبُهُ الأَعادي زَحمَةً","بَسَطتَهُمُ فَوقَ البِطاحِ بِطاحا",20,"ح",2,0],["زَحَمَ الدُجى مِنهُ بِرُكنَي هَيكَلٍ","لَو كانَ زاحَمَ شاهِقاً لَتَهَدَّما",21,"م",2,0],["زحَفَ الجيشُ فَذُبْتُم فَرَقاً","وَارْتَمَى البأسُ فَطِرْتُم هَرَبا",22,"ب",2,0],["زَحالفُ سُوءٍ ما يَكفُّ دبيبُها","وأهونُ شيءٍ أن تَدُبَّ الزّحالِفُ",23,"ف",1,0],["زُحَليٌّ واجِمٌ يَصحَبُهُ","زُهَرِيُّ الطَبعِ غَنّى وَزَمَر",24,"ر",1,0],["زُحَلٌ أشرَفُ الكَواكبِ داراً","مِنْ لِقاءِ الرّدَى على ميعادِ",25,"د",1,0],["زَحمْتَ به غُنجها مُقَلَ الدُّمى","وَعلَّمتَ سُمْرَ النَّفْثِ كيف يكونُ",26,"ن",1,0],["زحفوا ثائرين من كل صوبٍ","في صفوفٍ كأنهنَّ سطور",27,"ر",1,0],["زَحَفتْ رَابِيَةٌ مُضْرَمَةٌ","تلْتَقِيهَا فِي عِناقِ الوَهْجِ أَخْرَى",28,"ر",2,0],["زحم الصبح الظلاما فإلاما..","قم ننهنه شفتينا",29,"ن",2,0],["زُحِمتْ مصرُ بالبُغاثِ من الطي","رِ وعِيقَ الشادي عن الطيران",30,"ن",1,0],["زَحَمَ الأرضَ بالجِيادِ وغَشَّى","صَفْحَةَ الجَوِّ بالظُبا والعَوالي",31,"ل",2,0],["زَحَموا الصُّفوفَ \" مشَيَّعين \" كأنَّهم","بين المواكبِ قادةٌ أعلام",32,"م",1,0],["زحفت بمدرجة الخُطوب ففاتها","شأو المُجِدِّ من الشعوب وفاقها",33,"ق",3,0]]}