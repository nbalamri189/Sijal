{"poems":[[87,"النيل العذب هو الكوثر","https://www.aldiwan.net/poem7929.html","المتدارك"],[199,"لمن الدار مثل خط الكتاب","https://www.aldiwan.net/poem54424.html","الخفيف"],[240,"يا جلال الدين يامو","https://www.aldiwan.net/poem32130.html","مجزوء الرمل"],[484,"أبت الوداع فبكرت برحيل","https://www.aldiwan.net/poem36916.html","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63935","الخفيف"],[2607,"","https://poetry.dctabudhabi.ae/diwan/poem/34888","الرمل"]],"verses":[["حَبَشِيُّ اللَونِ كَجيرَتِهِ","مِن مَنبَعِهِ وبُحَيرَتِهِ",0,"ه",1,0],["حَبَشِيٌّ يُلاعِبُ السَقبَ مِنها","فَرَحاً أَن يَعَضَّهُ بِالثِيابِ",1,"ب",1,0],["حَبَشِيٌّ شَرِسُ الأَخ","لاقِ كَالصِلِّ نَفوثُ",2,"ث",1,0],["حب شريف لا يدنس عرضنا","فيه ولا نخشى ملام عذول",3,"ل",1,0],["حبَّش المأزِقَ الممزَّق بالسي","فِ وبالرّمح دونَه الأحباشا",4,"ش",2,0],["حَبَشِيٌّ يَقتُلُ النا","سَ عَلى قِطعَةِ خَيشِ",5,"ش",1,0]]}