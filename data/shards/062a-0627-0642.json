{"poems":[[87,"نبذ الهوى وصحا من الأحلام","https://www.aldiwan.net/poem8104.html","الكامل"],[68,"تاب الزمان من الذنوب فوات","https://www.aldiwan.net/poem38499.html","الكامل"],[266,"أعطى سرائرك النحول اللوما","https://www.aldiwan.net/poem38193.html","الكامل"],[275,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[280,"مهج تساق إلى الردى فتشاق","https://www.aldiwan.net/poem25476.html","الكامل"],[382,"حاشاكم من وصمة تزري بكم","https://www.aldiwan.net/poem59368.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138401",""],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96988","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86709","الكامل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133868","المجتث"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108554","الكامل"],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84513","البسيط"],[2799,"","https://poetry.dctabudhabi.ae/diwan/poem/121144","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74304","الخفيف"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138567",""],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76516","البسيط"],[4079,"","https://poetry.dctabudhabi.ae/diwan/poem/142512","الرمل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117248","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139628",""],[4680,"حنين الطين","https://www.poetsgate.com/ViewPoem.aspx?id=185077",""],[4715,"دمعة وطن","https://www.poetsgate.com/ViewPoem.aspx?id=208560",""],[4767,"الرسالة","https://www.poetsgate.com/ViewPoem.aspx?id=179781",""],[4836,"أمي وهذا القلب يقتربُ","https://www.poetsgate.com/ViewPoem.aspx?id=211139",""],[4852,"مرام","https://www.poetsgate.com/ViewPoem.aspx?id=214442",""],[4929,"حرٌّ في زمن العبيد الجزء (2) ( حوار)","https://www.poetsgate.com/ViewPoem.aspx?id=204919",""],[5149,"لحنُ الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=214445",""],[5149,"يا إخوة العرب","https://www.poetsgate.com/ViewPoem.aspx?id=215291",""],[5190,"الجوزاء والبحر","https://www.poetsgate.com/ViewPoem.aspx?id=68758",""],[4045,"يا عزيز النّدى ويا جوهر الجو","https://www.poetsgate.com/ViewPoem.aspx?id=200265",""],[5277,"حشرجة","https://www.poetsgate.com/ViewPoem.aspx?id=190908",""],[5436,"فجّر الثورة ( أيمن أحمد رؤوف القادري )","https://www.poetsgate.com/ViewPoem.aspx?id=35273",""],[5443,"جنَّة الدُّنيا","https://www.poetsgate.com/ViewPoem.aspx?id=185139",""],[5496,"أنت واحدها","https://www.poetsgate.com/ViewPoem.aspx?id=212780",""],[5537,"ال( أنا ) وال( هو )","https://www.poetsgate.com/ViewPoem.aspx?id=207858",""],[5561,"هو خيرةٌ من خيرةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=193807",""],[5621,"صلاة الفتح","https://www.poetsgate.com/ViewPoem.aspx?id=24567",""],[5736,"مملكة على الأهداب","https://www.poetsgate.com/ViewPoem.aspx?id=208452",""],[5736,"مواسم البوح والحب","https://www.poetsgate.com/ViewPoem.aspx?id=208870",""],[5781,"تسكُنني طُيوفكَ والحنينُُ إليْ","https://www.poetsgate.com/ViewPoem.aspx?id=202848",""],[5848,"محمد بن زايد","https://www.poetsgate.com/ViewPoem.aspx?id=48970",""],[5848,"اخر مسامير نعشي","https://www.poetsgate.com/ViewPoem.aspx?id=51961",""],[6093,"الخَيْرُ كَلُّ الخَيْرِ يَا شِعْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=179284",""]],"verses":[["تاقوا إِلى أَوطانِهِم فَتَحَمَّلوا","وَهَوى الدِيارِ وَراءَ كُلِّ غَرامِ",0,"م",1,0],["تاقَت إِلى شُربِ المُدامِ نُفوسُنا","لا تَذهَبَنَّ بَطالَةُ الأَوقاتِ",1,"ت",1,0],["تاقَت إِلَيكَ قُلوبُ قومٍ أَصبَحَت","تُلقي إِلَيكَ مَعارِقَ الفَلَواتِ",1,"ت",1,0],["تاقت إليك فترجمت عن شوقها","وأخو الهوى لا يستطيع تكتما",2,"م",2,0],["تاقت إلى اللغةِ الفصحى وقد حفظت","منها كلاماً بدت فيه معانينا",3,"ن",2,0],["تَاقَتْ إليْهِ وإنَّهُ لَيَلُمُّهَا","بالصِّدِ مِنْ أَمْلائِهِ تَوَّاقُ",4,"ق",1,0],["تاقوا لضوء سيوفكم فاستَهلكوا","فكأنكم نارٌ وهم كفَراش",5,"ش",1,0],["تاقوا إلى مرآى مليك مقسط","بذّ الملوك ندى ورفعة شان",6,"ن",1,0],["تاقت إلى نيل العسلا حوباؤه","في اللَه لم يحتج لقول مرغب",7,"ب",1,0],["تاقت إِلى جَنات عَدنٍ نَفسه","فَسَعى إِلى مَولاه وَهوَ مُوَحّد",8,"د",1,0],["تاقت إليه العيون","حنّت إليه الغصون",9,"ن",1,0],["تاقت لصور ركائبي وتقدمت","لتزور ما فيها من الجنات",10,"ت",1,1],["تاقَت لَها النفس من دون الملاح فمذ","دَرَت بحالي بدت منها التفاتات",11,"ت",1,0],["تاقت اليك نفوس ابناء البلاد","الغر في الروض المنير الممرع",12,"ع",1,0],["تاقَت النَفس لِلحَبيب فَأَجرَت","مِن جُفوني يَوم النَوى عبراتي",13,"ت",2,0],["تاقت له الخلد وقد كادت لظى","غيظاً على الأعداء أن تميزا",14,"ز",2,0],["تاقي عَلى المَرء احيان تحيره","يَلقى سَعادته فيها بقوله لا",15,"ل",2,1],["تاقَ للحُريَّةِ الزرقا فَصَفَّقْ","في فضاءٍ رائعِ الأجواءِ مُطلَقْ",16,"ق",1,1],["تاقت له فتزودت أوجالها","واستصغرت في حبّه آجالها",17,"ل",3,0],["تاقت لك الأعياد ما عيدٌ مضى","إلا ومن شوقٍ اليك يعود",18,"د",1,0],["تاقت ليوم الإنعتاق من الردى","روحي ومن زيف الحياة حياتي",19,"ت",2,0],["تاقف بأول صفّ بين المُصلين","وتلقى النميمه بالقفا من شيمها",20,"م",3,0],["تاقت للذكرى أفئدةٌ","والفكر له تاق القلم",21,"م",1,1],["‏تاقت إلى قدميك رحلتُهُ","وعَرَاهُ من شطِّ النوى نَصَبُ",22,"ب",1,0],["تاقتْ وصالًا .. يا حبيبًا كوثرًا","روحٌ بيَادٍ قاحلاتٌ .. شاسعهْ",23,"ع",2,0],["تأقلمْ مع التعبيد فالرقُّ نعمةٌ","على من له انساقوا وفي حبلِهِ جُرُّوا",24,"ر",3,0],["تاقَتْ إلَيكَ كَسيرَةً فَرِضَاؤُهَا","شَطرٌ مِنَ الحُبِّ العَتيقِ، لُبَابِهِ",25,"ب",2,0],["تَاقَتْ لِخَيْرٍ عَلَى أَعْتَابِكُمْ أُمَمٌ","فَزَانَهَا الْخَيْرُ وَاكْتَالَتْ مِنَ الصَّبَبِ",26,"ب",1,0],["تَاقَت لَهَا النَّفسُ مِن بَعدِ اْنتِفَاضَتِهَا","مِن الرَّمَادِ ، كَمَا الفِينِيقِ أَغرَانَا",27,"ن",2,0],["تاقت النفس يا خليل السماح","نحو بحر الندي مجاري الرّياح",28,"ح",1,0],["تاقَ الفؤادُ إلى إلفٍ حلاوتُهُ","نداوةُ الوردِ لمّا فاحَ بالأرجِ",29,"ج",1,0],["تاقتِ الأنفُسُ، للنصرِ فآبا","واغْرزِ الرايةَ في عزْمِ فتىً",30,"ا",1,0],["تاقت إلى الحورِ والفردوسِ أنفسُهم","فذلَّلوا دربَهم للخُلدِ تذليلا",31,"ل",2,0],["تاقت لطرفة عين عز مرسلها","هامت بضحكة ثغر كنت ترميها",32,"ي",3,0],["تاقت لألوان ال(هو) فرشاتي","ولهن تاقت سابقا ..لوحاتي",33,"ت",2,1],["تاقتْ للُقياكَ القلوبُ شواكيا","ألم الفراقِ على الزمانِ بدى ليا",34,"ي",2,0],["تاقتْ صباحاتُ الأنينِ لفرحَةٍ","وهَفَتْ ليالي العمْرِ للأعيادِ",35,"د",1,0],["تاقت حروفي إلى منْ كانَ مُلهمها","يومًا وما زال للإبداعِ إلهاما",36,"م",2,1],["تاقت حروفي لهذا الحبر يغزلها","مواسم البوح بالعشاق تحتفل",37,"ل",1,0],["تاقَتْ إلَيْهِ طَواحينُ الضُّلوعِ، أَبَى","فِيَّ الجَوى زَفَراتًا فاغْتَدَى نُحُبا",38,"ب",2,0],["تاقف وقلبي يبتسم لك نخيله","وان طحت .. قلبي من قبل طيحتك طاح",39,"ح",1,0],["تاقف عليك ايام عمري وتمشي","قبل ارمي سنيني بدونك ورايه",40,"ا",3,0],["تَاقتْ إلى رؤياهُ رُوْحٌ لَهَا","شَوقٌ عَظِيْمٌ عزَّها الصَّبْرُ",41,"ر",1,0]]}