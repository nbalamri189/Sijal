oem69365.html","الخفيف"],[560,"كيف هذي الدنيا وهذا الزمان","https://www.aldiwan.net/poem52761.html","الخفيف"],[560,"ويلاه من عرس تحول مأتما","https://www.aldiwan.net/poem52772.html","الكامل"],[560,"أجمل الله في فؤادك صبرا","https://www.aldiwan.net/poem52990.html","الخفيف"],[565,"يا ريم كم أدنو وأنت تريم","https://www.aldiwan.net/poem69526.html","الكامل"],[565,"تزداد فيك مصيبتي","https://www.aldiwan.net/poem69633.html","مجزوء الكامل"],[565,"ما ترى في الصبوح أيدك الله","https://www.aldiwan.net/poem69743.html","الخفيف"],[573,"جلست ببستان الجليس وداره","https://www.aldiwan.net/poem2724.html","الطويل"],[573,"جاءت بحسن مطمئن","https://www.aldiwan.net/poem3000.html","مجزوء الكامل"],[573,"شربت شرب الهيم","https://www.aldiwan.net/poem3010.html","مجزوء الرجز"],[573,"باتت معانقتي ولكن في الكرى","https://www.aldiwan.net/poem3062.html","الكامل"],[573,"عاد قلب الشوق إذ عدت عيده","https://www.aldiwan.net/poem3077.html","الخفيف"],[583,"عروس الكأس يجلوها نديمي","https://www.aldiwan.net/poem1566.html",""],[584,"يا حبذا نهر القصير ومغربا","https://www.aldiwan.net/poem17431.html","الكامل"]],"verses":[["وَسَقَت ثَراهُنَّ الدُموعُ مُرِشَّةً","فَغَنينَ عَن قَطرِ الغَمائِمِ وَالسُمِي",0,"م",2,0],["وَسَقَتكَ أَوعِيَةُ الدُموعِ فَجاوَزَت","قَطَراتِ ذاكَ العارِضِ المِدرارِ",1,"ر",1,0],["وَسَقاكَ فَضلُكَ إِنَّهُ أَروى حَياً","مِن رائِحٍ مُتَعَرِّسٍ أَو غادِ",2,"د",1,0],["وَسُقْناهُمُ وَالخَيْرُ فينا سَجِيَّةٌ","إِلى نِعَمٍ لا يُسْتَطاعُ جُحودُها",3,"د",3,0],["وسُقْتُمْ إِلى أحْسابِهِ منْ خِيارِكُمْ","عَقائِلَ لا تَشْرونَها بالأباعِرِ",4,"ر",1,0],["وسَقِّ الثّرى للنُّسْكِ منْ نَعَمٍ دَماً","ورَوِّ الظُّبا للمُلْكِ منْ بُهَمٍ دَما",5,"م",2,0],["وسقّيْتُها بدُموعِ الجُفونِ","فقدْ أيْنَعَ الغَرْسُ لمّا ارْتَوى",6,"و",2,0],["وسُقْيا لغُصْنٍ من قَوامِكَ مائِلٍ","كما مالَ لُدْنُ القُطْبِ بيْنَ الحَدائِقِ",7,"ق",1,0],["وسَقَى شَلّةَ عهْدٌ مُغْدِق","هَمى في الرّبْعِ منْها وهَمَعْ",8,"ع",1,0],["وَسَقَى بِثَغْرِ الْغَرْبِ إِنْ عَارِضٌ هَمىً","مَعَالِمَ قَدْ عَلَّمن جَفْنِيَ يَنْهَمِي",9,"م",2,0],["وَسُقْيَا ثُمَّ سُقْيَا ثُمَّ سُقْيَا","يَصُوبُ بِدَمْعِهَا جَفْنُ الْغَمَامِ",10,"م",1,0],["وَسَقَاكَ عِيدُ الْفِطْرِ كَأَسَ شَهَادَةٍ","فِيهَا مِنَ الأَجَلِ الْوُحِيِّ مُدَامُ",11,"م",1,0],["وَسَقَيْتَهُمْ كَأْسَ الرَّدَى مَمْزُوجَةً","سُمَّ الأَسَاوِدِ فِي نَقِيعِ الْعَلْقَمِ",12,"م",1,0],["وَسَقَى بِكَأَسِ الْحَيْنِ قَيْساً بَعْدَهُ","وَاللهُ يُمْلِي للِطُّغَاةِ وَيُمْهِلُ",13,"ل",1,0],["وسقَتْني كأسَ الفِراقِ دِهاقا","في اغْتِباقٍ مُواصَلٍ باصْطِباحِ",14,"ح",1,0],["وَسِقاءٍ يوكى عَلى تَأَقِ المَل","ءِ وَسَيرٍ وَمُستَقى أَوشالِ",15,"ل",1,0],["وسُقاةٍ صَفَّقَت أَكوابَها","بَعضُها البَلّورُ وَالبَعضُ لُجَين",16,"ن",1,0],["وَسَقَّيتَني مِن بَحرِ فَضلِكَ شُربَةً","مُقَدَّسَةً صِرفاً حَمَتنِيَ أَن أَظما",17,"م",2,0],["وَسَقَيتُها سَلسالَ سِحرٍ مُسكِرٍ","لِلسامِعينَ وَسُقتها كَعَروسِ",18,"س",1,0],["وَسَقَيتِني مِن ماءِ هَجرِكِ ما لَهُ","أَصبَحتُ أَشرَقُ بِالزُلالِ البارِدِ",19,"د",1,0],["وَسُقنا لِرائِمِهِم سُجَّداً","بِأَحداجِها وَذَواتِ الحِزامِ",20,"م",1,0],["وَسَقَيْتُهُ وَسَقَيْتُ مِنْهُ نَاظِرِي","حَتَّى تَمَلَّيْنَا وَكُلُّ ظَامِي",21,"ي",1,0],["وَسِقطٍ كَعَينِ الديكِ عاوَرتُ صاحِبي","أَباها وَهَيَّأنا لِمَوقِعِها وَكرا",22,"ر",2,0],["وسقى زمانك يا ديار بحنّسٍ","صوب المسرة دائم التهتان",23,"ن",1,0],["وَسَقاكَ مِن نَوءِ الثُرَيّا عارِضٌ","تَنهَلُّ مِنهُ ديمَةٌ مِدرارُ",24,"ر",1,0],["وَسَقى الغَمامُ مُنَيزِلاً بِعُنَيزَةٍ","إِمّا تُصافُ جَداً وَإِمّا تُربَعُ",25,"ع",1,0],["وَسُقتُ رَبيعاً بِالفَناءِ كَأَنَّهُ","قَريعُ هِجانٍ يَبتَغي مَن يُخاطِرُ",26,"ر",1,0],["وَسُقناهُم إِلى الحيرانِ سَوقاً","كَما نَستاقُ آبالاً صِعابا",27,"ب",2,0],["وسقتْني مياهُ جودِك سقياً","رفعتْني على ابن ماء السماء",28,"ا",2,0],["وسقى الله أصلهُم فلقد أثم","رَ من نسله بكلِّ نجيب",29,"ب",1,0],["وسقى البنان يراعه حتَّى ارْتوى","فلذاك يهزأ بالوشيحِ الدابل",30,"ل",1,0],["وسقى عهدها وإن","عهدت بالشقا لي",31,"ي",1,0],["وسقامٌ أغصَّ مُحتَسَيَ المغ","تصِّ من مُسمعاته بالبواكي",32,"ك",2,0],["وَسَقَينا مِمّا شَرِبنا الرِفاقا","فَتَرَناهُمُ حَيارى سُكارى",33,"ر",2,0],["وَسَقى عَهدَ حَبيبٍ","لا أُسَمّيهِ الغَمامُ",34,"م",1,0],["وَسُقاةٌ مِثلَ ما نَه","وى شُموسٌ وَبُدورُ",35,"ر",1,0],["وسَقَتْني من التَّعاسَةِ أَكْواباً","تَجَرَّعْتُها فيَا شدَّ تَعْسي",36,"ي",1,0],["وسقيمة الأجفان لا من علة","تحيى العميد بنظرة وتميته",37,"ت",2,1],["وسقاة أولو نهى","وكؤوس تَنَقَّل",38,"ل",1,0],["وسقى من المهجات أك","بادا أحرّ من الهواجر",39,"ر",1,0],["وَسَقَت قُريشَ عَلى لِسانِ مُحَمَّدٍ","بِالبابِلِيِّ مِنَ البَيانِ المُمتِعِ",40,"ع",1,0],["وسقينا البزور ماء حياة","فامتلأ نبتها البهيج منها سرورا",41,"ر",2,0],["وَسُقتَ الَّذي فَوقَ المَعاقِلِ مِنهُمُ","فَلَم يَبقَ إِلّا أَن تَسوقَ المَعاقِلا",42,"ل",2,0],["وَسَقيمٍ يُخشى بَلاهُ وَلا يُر","جى مِنَ السُقمِ وَالبِلى إِبلالُه",43,"ل",2,0],["وسُقيتُ من جَدواك خمسَ سحائبٍ","جادَت عليَّ بهنَّ خمسُ أنامِلِ",44,"ل",1,0],["وسَقَتْ دموعُ الغَيْثِ رَبعَكَ ما سَقَتْ","منَّا لذِكْراكَ الدموعُ مَدامِعا",45,"ع",2,0],["وسقاةٌ إن سَقوا حيْ","يَوْا برَيحانِ الصُّدورِ",46,"ر",1,0],["وسقَتْكَ طَيِّبةَ النَّسيمِ كأنَّما","تَهمي عليك بها حياضُ الكَوْثَرِ",47,"ر",1,0],["وسَقَوه محتَفِلَ الحَيا رَيَّانَه","ورأَوا ذُنوباً سقيَه بذنابِ",48,"ب",1,0],["وسقَتْ غَمائمُهُ الرِّياضَ كأنما","جُودُ الأميرِ سقى رياضَ ثَنائِه",49,"ا",3,0],["وَسَقاةٌ وَحُداةٌ وَغِناً","وَجُنوكٌ وَطُبولٌ وَزُمورُ",50,"ر",1,0],["وَسَقَت قَبرَكَ الغَوادي وَإِن كا","نَت دُموعي رَوائِحاً وَغَوادي",51,"د",2,0],["وَسَقَتنِيَ الدُنيا غَداةَ أَتَيتُهُ","رَيّاً وَما مَطَرَت عَلَيَّ مَصائِبا",52,"ب",2,0],["وسُقيتَ من كأسٍ تطوف بها يدٌ","محتومة الأقداح والأدوارِ",53,"ر",1,0],["وسقانا فانتفضنا لحظة","لغبارٍ آدمي مسنا",54,"ن",2,0],["وسُقوطِ هاماتٍ بِضَربِ مَناصِلٍ","وصعودُ أرواحٍ بِطَعنِ صِعادِ",55,"د",1,0],["وسَقاهُ الريَّ من وكّافَةٍ","فَتَحَ البرقُ بها اللّيلَ وسَد",56,"د",1,0],["وسَقَيتَني من صَوْبِ مزنك فوْق ما","يَرْوَى به قلبُ الثرى الملتاحُ",57,"ح",1,0],["وَسَقِّني من قهوَةٍ كاساتُها","تُسْرِجُ في الأيدي مصابيحَ الصّبح",58,"ح",1,0],["وَسَقيمِ الطَرفِ قَد غَص","صَصَ بِالهَجرِ وَأَشجى",59,"ج",2,0],["وسقى قبرَ جدِّهِ وأبيهِ","وأخيهِ غيثاً تبسَّمَ مزنا",60,"ن",2,0],["وَسَقاكَ وابِلُ رَحمَةٍ يَغشى بِ