{"poems":[[88,"أجدك يا كواكب لا ترينا","https://www.aldiwan.net/poem45071.html","الوافر"],[49,"ألا أين الألى سلفوا","https://www.aldiwan.net/poem62179.html","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39573","البسيط"],[94,"البلبل الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=12827",""],[306,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"]],"verses":[["ترصَّدك الأنام وما أتانا","بعلم كيانك المترصدونا",0,"ن",2,0],["تُرَصُّ عَلَيهِمُ حُفَرٌ","وَتُبنى ثُمَّ تَنخَسِفُ",1,"ف",1,0],["ترصَّدتكَ مراميهِ ولو وقَعَتْ","عليهِ عيناكَ لم تُنقذهُ أقدارُ",2,"ر",1,0],["ترصّد نجم الصبح منهنّ نظرة","وأشرف من عليائه وترقّبا",3,"ب",2,0],["ترصّع من رأس الرئاسةِ تاجهُ","وَمن معصمِ العزّ الأساور والقلبا",4,"ب",2,0]]}