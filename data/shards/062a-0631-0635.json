{"poems":[[90,"أجدك يا كواكب لا ترينا","https://www.aldiwan.net/poem45071.html","الوافر"],[51,"ألا أين الألى سلفوا","https://www.aldiwan.net/poem62179.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39573","البسيط"],[96,"البلبل الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=12827",""],[310,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67210","الرجز"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100214","الوافر"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100224","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139669",""],[3271,"من مرج عبقر","https://www.poetsgate.com/ViewPoem.aspx?id=104125",""],[5183,"عسعس الليل","https://www.poetsgate.com/ViewPoem.aspx?id=186373",""],[5910,"للهِ أشكو شجونًا","https://www.poetsgate.com/ViewPoem.aspx?id=206879",""]],"verses":[["ترصَّدك الأنام وما أتانا","بعلم كيانك المترصدونا",0,"ن",2,0],["تُرَصُّ عَلَيهِمُ حُفَرٌ","وَتُبنى ثُمَّ تَنخَسِفُ",1,"ف",1,0],["ترصَّدتكَ مراميهِ ولو وقَعَتْ","عليهِ عيناكَ لم تُنقذهُ أقدارُ",2,"ر",1,0],["ترصّد نجم الصبح منهنّ نظرة","وأشرف من عليائه وترقّبا",3,"ب",2,0],["ترصّع من رأس الرئاسةِ تاجهُ","وَمن معصمِ العزّ الأساور والقلبا",4,"ب",2,0],["ترصيفُه ايصاله مُتصلا","بما يليه ان اتى منفصلا",5,"ل",2,0],["ترصُدها لحاظُها وإن غفت","ترصدها أراقُم الذوائب",6,"ب",1,0],["ترصد رقدة الرقباء حتى","ذا ما هومت عين الرقيب",7,"ب",1,0],["ترصع بالسبع الواري فأرخوا","نعم فتح الشبلي لحيدرة بابا",8,"ب",2,0],["ترصَّع في مدح النبي وحيدرٍ","وزوجته الزهراء فاطمة الطهر",9,"ر",1,0],["ترصّدت موكب الدنيا فأزعجها","أ شلّ خطوتها في الذّر تأييدُ",10,"د",1,0],["ترصد الليل عن مطالع أقما","ر عليها من الهدى شؤبوب",11,"ب",1,0],["ترصَّدتْها عوادي الرِّيح في لُججٍ","يأبقن مِن لججٍ قد رابها الجَرَشُ",12,"ش",1,0]]}