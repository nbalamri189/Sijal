{"poems":[[49,"ألا أين الألى سلفوا","https://www.aldiwan.net/poem62179.html","البسيط"],[88,"","https://poetry.dctabudhabi.ae/diwan/poem/55641","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39573","البسيط"],[303,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"]],"verses":[["تُرَصُّ عَلَيهِمُ حُفَرٌ","وَتُبنى ثُمَّ تَنخَسِفُ",0,"ف",1,0],["ترصّدك الأنام وما أتانا","بعلمِ كيانك المترصّدونا",1,"ن",2,0],["ترصَّدتكَ مراميهِ ولو وقَعَتْ","عليهِ عيناكَ لم تُنقذهُ أقدارُ",2,"ر",1,0],["ترصّع من رأس الرئاسةِ تاجهُ","وَمن معصمِ العزّ الأساور والقلبا",3,"ب",2,0]]}