82","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85446","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85374","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85495","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85456","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39616","الرمل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202526","الرجز"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30496","الكامل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30442","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54719","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55024","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54868","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54772","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54633","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54573","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54521","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54674","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141915","البسيط"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199488","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43661","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43809","الرمل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43692","المديد"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54204","الخفيف"],[106,"عودة إلى مصر","https://www.poetsgate.com/ViewPoem.aspx?id=179678",""],[106,"تجار العقائد","https://www.poetsgate.com/ViewPoem.aspx?id=179441",""],[106,"لا نكسة","https://www.poetsgate.com/ViewPoem.aspx?id=179333",""],[106,"بطل الريف","https://www.poetsgate.com/ViewPoem.aspx?id=179606",""],[78,"فيما مضى كنت بالأعياد مسرورا","https://www.poetsgate.com/ViewPoem.aspx?id=1465",""],[45,"لَوْلاَ تُعَنّفُني لَقُلْتُ: المُنْزِلُ","https://www.poetsgate.com/ViewPoem.aspx?id=32097",""],[45,"أقصِرْ، فإنّ الدّهرَ ليسَ بمُقْصِرِ","https://www.poetsgate.com/ViewPoem.aspx?id=31214",""],[64,"الحبّ ما دام مكتوماً على خطرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=3139",""],[51,"لعدوّك الحدُّ الأفلُّ","https://www.poetsgate.com/ViewPoem.aspx?id=30262",""],[51,"لا يُعدمُ اللهُ يديك الصَّولا","https://www.poetsgate.com/ViewPoem.aspx?id=30269",""],[51,"لا تَصدِفا عن دِمن المنازلِ","https://www.poetsgate.com/ViewPoem.aspx?id=30265",""],[98,"أرق الحسن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65555&r=&rc=0",""],[53,"أيُّ العُيُونِ تُجَانِبُ الأقْذاءَ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9806&r=&rc=3",""],[72,"سهرت عليكِ لواحظُ الرقباء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=57649&r=&rc=7",""]],"verses":[["مِن بَعدِ ما خَشَعَت غَوا","رِبُها وَقَد قَلِقَ الوَضينُ",0,"ن",1,0],["مِن بَطنِ مُرٍّ وَالسُرى","تَؤُمُّ عُسفانَ بِنا",1,"ن",2,0],["مِن بَعدِ ما كانَ رَبُّ المُلكِ مُبتَسِماً","إِلَيَّ أَدنوهُ في النَجوى وَيُدنيني",2,"ي",1,0],["مِن بَعدِ ما مُدَّت حَيازيمُهُم","عَلى قُلوبٍ دامِياتِ الكُلوم",3,"م",1,0],["مِن بَعدِ ما أَظمى الغَليلُ جَوانِحي","وَأَطالَ مِن مَلَلِ الزُلالِ أُوامي",4,"م",2,0],["مِن بازِلٍ قَد مَنَعَ الخِطاما","وَأَعجَزَ الوِراكَ وَالزِماما",5,"م",2,0],["مَنبِتٌ تَحرُزُ عَن أَعراقِهِ","حَسَبٌ لا يَقبَلُ العارَ قُداما",6,"م",2,0],["مِن بَينِ مَجروحٍ بِحَدِّ نُيوبِهِ","يَدمى وَبَينَ مُبَضَّعٍ مَأكولِ",7,"ل",1,0],["مِن بَعدِ ما دَعَموا القِبابَ وَخَيَّسوا","ذُلُلَ المَطيِّ وَدَمَّنوا الأَطلالا",8,"ل",2,0],["مِن بَعدِ ما خَلَطوا العَجاجَ وَجَلجَلوا","تِلكَ الزَعازِعَ وَالقَنا العَسّالا",8,"ل",2,0],["مِن بَعدِ ما كانَت عَلى ال","أَيّامِ مَربَأَةً زَلولا",9,"ل",2,0],["مِن بَعدِ ما حَلَّتُكُمُ ال","عَلياءُ جَوهَرَها النَفيسا",10,"س",2,0],["مِن بَعدِ ما كُنتُ أَستَسبي المَها شَغَفاً","أَمسَت تَروعُ بِيَ الغِزلانُ وَالبَقَرُ",11,"ر",1,0],["مِن بَعدِ ما رَدَّ أَطرافَ الرِماحِ بِهِ","قَلبٌ فَسيحٌ وَرَأيٌ غَيرُ مَحصورِ",12,"ر",1,0],["مِن بَعدِ ما اِصطَفَقَت فيها صَواعِقُها","وَشاغَبَ البَرقَ في أَطرافِها المَطَرُ",13,"ر",1,0],["مِن بَعدِ ما صَهِبَ الرَكا","ئِبَ لا يَعِفُّ عَنِ المَسيرِ",14,"ر",1,0],["مِن بَني ساسانَ أَقنىً ضُرِبَت","حُجَرُ المُلكِ عَليهِ وَالسُدَد",15,"د",1,0],["مِن بَعدِ ما خَطَرَ الصِبا بِمَقادَتي","وَجَرى إِلى الأَمَدِ البَعيدِ جِماحي",16,"ي",1,0],["مِن بَعدِ ما أَوضَعتُ في طُرُقِ العُلى","وَأَضَرَّ بِالأَعداءِ طولُ كِفاحي",16,"ي",1,0],["مَن بايَعَ الحُبَّ لَم تَربَح تِجارَتُهُ","إِذا رَماهُ الَّذي يَهواهُ بِالياسِ",17,"س",1,0],["مِنْ بَعْدِ لُقْيَاكَ لاَ آسَى عَلَى وَطَرٍ","مَهْمَا تَعَذَّرَ أَوْ أَبْكِي عَلَى وَطَنِ",18,"ن",1,0],["مِنْ بَعْدِ مَا خَلَصَتْ نَحْوِي الشَّفَاعَةُ مَا","بَيْنَ الْفَلاَ وَالدُّجَى وَالْبِيضِ وَالأَسَلِ",19,"ل",1,0],["مِنْ بَعْدِ مَا اشْتَهَرَتْ حَالِي بِهِ وَسَرَتْ","بِهَا الرَّكَائِبُ فِي سَهْلٍ وَفِي جَبَلِ",19,"ل",1,0],["من بعدِ ما فتحَ الفُتوحَ ودوّخ ال","مَعْمورَ حتى أذْعَنَتْ أقْطارُهُ",20,"ر",2,0],["منْ بعدِ ما خلَفَ الغَمائمَ جودُهُ","عنْدَ الهطولِ فأغْدِقَتْ أمْطارُهُ",20,"ر",2,0],["منْ بعدِ ما قضَتِ النّذورَ رِماحُهُ","منْ بعدِ ما شفَتِ الصّدور شفارُهُ",20,"ر",2,0],["مِنْ بَعْدِ مَا قَعَدَتْ بِهِ أَنْصَارُهُ","رَهَباً وَأَبْصَرَ وَعْدَهُمْ مَكْذُوبَا",21,"ب",2,0],["مِن بَعدِ خَمسينَ قَرناً","لَم تَستَرِح في الرُموسِ",22,"س",1,0],["مِنْ بَعِيْدِ الهَمِّ مُشْتَغِلٍ","في انْصِدَاعِ الشَّمْلِ بِالرَّأْبِ",23,"ب",1,0],["مَنْ بَعْدَهُ يُشْكِي إِذَا العَافِي شَكَا","بُرَحَاءهُ وَيَفَكُّ قَيْدَ العَانِي",24,"ن",2,0],["مَنْ بَعْدَهُ مُشْكِي الفَقِيرِ إذا شَكَا","وَعَلَى الضَّعِيفِ إذَا تَظَلَّمَ حَانِي",25,"ن",2,0],["مِنْ بَنَاتٍ مُثَقَّفَاتٍ وَأَبْنَاءٍ","كَأَزْكَى مَا يَنْبُتُ الفُتْيَانُ",26,"ن",1,0],["مُنَبِّيءٍ بِسَنَاهُ عَنْ سَنَى قَمَرٍ","مَاحِي الظَّلامِ نَبِيٍّ حَاطِمِ الصَّنَمِ",27,"م",1,0],["مَنْ بَرَّ بِرَّكِ بِالأيَامَى وَانْتَحَى","مَنْحَاكِ مِنْ حَدَبٍ عَلَى الأَيْتَامِ",28,"م",1,0],["مِن بَنَاتِ الكَرِيمِ داذَ وفي كِن","دَةَ يُنسَبنَ مِن أُبَاةِ اللَّعنِ",29,"ن",1,0],["من بعد ما كانت","مغيب ذات إشفاق",30,"ق",1,0],["من بعد ما بدت المنى","للقوم باسمة الثغور",31,"ر",1,0],["مِن بَعدِ صَكَّتِيَ البَعيثَ كَأَنَّهُ","خَرَبٌ تَنَفَّجَ مِن حِذارِ الأَجدَلِ",32,"ل",1,0],["مِن بَعدِ ما جاوَزَت شَقائِقَ فَالدَه","نا وَغُلبَ الصُمّانِ وَالخُشُبا",33,"ب",2,0],["مِن بَعدِ إِذ نَحنُ عَاكِفُونَ لَهَا","بالعَترِ تِلكَ المَناسِكُ الخَيَبُ",34,"ب",1,0],["مِن بَعدِ ما سَرَّ مَشوقاً شائِقُه","وَنَعَقَت بِبَينِهِ نَواعِقُه",35,"ق",2,0],["مِن بَحرِ شِعرِكَ أَغتَرِف","وَبِفَضلِ عِلمِكَ أَعتَرِف",36,"ف",1,1],["مِن بَعدِ ما قَنِطوا فَفَرَّجَ عَنهُمُ","تَنزيلُ نَصِّ مَليكِنا الوَهّابِ",37,"ب",1,0],["من بيت فضل صحيح الوزن قد رجحت","به مفاخرُ آباءٍ وأبناءِ",38,"ا",2,0],["من بعد ما ولع الزمانُ بمهجتي","فردعتَهُ وحبوني حوبائي",39,"ا",2,0],["من بياضٍ باكرتها","سحراً بالسفحِ سفحه",40,"ح",2,0],["من بركة الحبّ حتَّى بئر زمزم لا","محلٌ بنعماه إلاَّ وهو ممطور",41,"ر",1,0],["من بعد ما غابت بنو أيوب عن","داعٍ تحارف بعدهم وتحرشفا",42,"ش",3,0],["من بركة القطن لكتانها","فقال هذا طلبٌ ملجم",43,"م",1,0],["من بيوت الترك ترمي","عن قسيٍّ عربيَّه",44,"ي",2,0],["مَن بَنى لي دارا في دُنيا البَقا","لَيسَ يَبني دارا في دُنيا الفَنا",45,"ن",2,0],["مِن بَعدِ ما حَضَرَ السَجّانُ وَاِجتمع ال","تَمَعَ أَعوانُ وَاِختَطَّ اِسمي صاحِبُ الخَبَرِ",46,"ر",1,0],["من بناءٍ يَكِنُّنا ولَبُوسٍ","ودواء يحارب الأدواءَ",47,"ا",2,0],["من بناتِ الروم لا يَكْذِبُنا","لونُها المُشرق عن مَنْصبِها",48,"ب",3,0],["من باتَ يحتطِبُ الأفا","عِيَ لَيلَهُ ذَمَّ احتطابهْ",49,"ب",2,0],["مِنْ بعد ما انْتُقيتْ أواخِرُ مُخِّه","وَخَوتْ مَحَاجرُهُ من التقديحِ",50,"ح",1,0],["من بأْسهم يقع الردى وبحلمهم","تتماسك الأرواح في الأشباحِ",51,"ح",1,0],["مِنْ بين مَذْبُوحٍ لِنَاجُودِهِمْ","وبيْنَ حَيٍّ غيْرِ مَذْبُوحِ",52,"ح",1,0],["من بين باكٍ له عينٌ تساعده","وبين آخر مَطْويٍّ على كمدِ",53,"د",1,0],["من بني هاشمٍ ومن آل عبَّا","سٍ بَنى اللَّه بيْتَه في الدَخيس",54,"س",1,0],["منبلج الرأي غزير الندى","صاحب يوم مُمْطرٍ مُشمس",55,"س",1,0],["من بين نابٍ إنما هو بَيْرمٌ","عِظَماً وبين ثنيةٍ كالشَاحط",56,"ط",1,0],["من باسطٍ كفَّ الدُّعاءِ وقابضٍ","كفّ الدواءِ حِذار موتٍ ذاعط",56,"ط",1,0],["