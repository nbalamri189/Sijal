{"poems":[[63,"هو طيفها وطروقه تعليل","https://www.aldiwan.net/poem46153.html","الكامل"],[3,"لقينا يوم صهباء سريه","https://www.aldiwan.net/poem224.html",""],[51,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[91,"يا أيها الشادي المغرد في الضحى","https://www.aldiwan.net/poem8797.html","عموديه"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9994","الوافر"],[155,"قم فاجل همي يا غلام","https://www.aldiwan.net/poem55556.html","مجزوء الكامل"],[160,"برغم سنة خير العجم والعرب","https://www.aldiwan.net/poem59217.html","البسيط"],[199,"ليت أهل الغرام ما عشقوا","https://www.aldiwan.net/poem45222.html","المنسرح"],[204,"أحب فمن ذا الذي أخلفه","https://www.aldiwan.net/poem53251.html","المتقارب"],[353,"زفت على بدر العلى الأفراح","https://www.aldiwan.net/poem40541.html","الكامل"],[364,"رأيت الطريق إلى الوصل وعرا","https://www.aldiwan.net/poem60911.html","الطويل"],[380,"سرى البرق في الأفق الشمالي معتنا","https://www.aldiwan.net/poem48756.html","الطويل"],[437,"عدتنا عواد من تناء ومن هجر","https://www.aldiwan.net/poem2588.html","الطويل"],[551,"أما الشباب فقد مضت أيامه","https://www.aldiwan.net/poem47253.html","الكامل"],[551,"إني الشجاع وقد جزعت كما ترى","https://www.aldiwan.net/poem47701.html","الكامل"],[570,"أينجو بنو بدر بمقتل مالك","https://www.aldiwan.net/poem59464.html","الطويل"]],"verses":[["وكأنّ زَوْرَتَهُ تألُّقُ بارِقٍ","هَتَفَتْ بهِ النّكْباءُ وهْيَ بَليلُ",0,"ل",1,0],["وَكانَ زَعيمُهُم إِذ ذاكَ لَيث","هِزَبراً لا يُبالي بِالرَزِيَّه",1,"ي",2,0],["وكان زْيناً لكل من نفر ال","سؤددَ إقراره لمن نَفره",2,"ر",2,0],["وَكَأَنَّ زَورَكَ فيهِ أَلفُ كَمَنجَةٍ","وَكَأَنَّ صَدرَكَ فيهِ أَلفُ مُرَدِّدِ",3,"د",1,0],["وَكانَ زَيدُ النار في أَيامهم","وَالآخرُ الجَزّار عاث وَعَتا",4,"ا",1,0],["وَكانَ زَعيمُهُم إِذ ذاكَ لَيثاً","هِزَبراً لا يُبالي بِالرَزِيَّه",5,"ي",2,0],["وَكأنَّ زُرْقَ نُجُومِها","حَدَقٌ مُفَتَّحَةٌ نِيَامُ",6,"م",1,0],["وكان زهدهم أضعاف حرصكم","على الفخار وحب الجاه والنسب",7,"ب",1,0],["وكانَ زمانٌ كليلةٍ حلكتْ","هواكَ عندي لصبحها فلقُ",8,"ق",1,0],["وكان زكيّاً كما قد علمتُ","فما ذا التعدّي وما ذا السَّفَه",9,"ف",2,0],["وَكَأنَّ زَهر الياسمين سُحيرةً","زهرُ النُجوم زَهابها الإِصباحُ",10,"ح",1,0],["وكان زمانُ لئامِ الوُلاةِ","ومَنْ بسوى الشّرِّ لم يُبْقِ ذِكرا",11,"ر",2,0],["وَكانَ زَماني قَد أَماتَ قَرائِحي","وَغَيبُها في لَحد قسوتِهِ دُفِنا",12,"ن",2,0],["وكان زماني قد علا بي وصانني","فكنتُ أصونُ النفس عن عمل الشعرِ",13,"ر",1,0],["وكأنّ زُوراً لفّقتْ ألفاظُهُ","سِلْكٌ وَهى فَاِنحلّ عنه نظامُهُ",14,"م",2,0],["وكأنّ زَمْجَرَةَ الرُّعودِ خلالَهُ","دوحٌ تقصّفَ أو زئيرُ سِباعِ",15,"ع",1,0],["وكان زيادٌ قبله يتقى به","من الدهر ان يوم المَّ فظيع",16,"ع",1,0]]}