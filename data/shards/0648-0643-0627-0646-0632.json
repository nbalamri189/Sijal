{"poems":[[65,"هو طيفها وطروقه تعليل","https://www.aldiwan.net/poem46153.html","الكامل"],[3,"لقينا يوم صهباء سريه","https://www.aldiwan.net/poem224.html",""],[53,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[93,"يا أيها الشادي المغرد في الضحى","https://www.aldiwan.net/poem8797.html","عموديه"],[87,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9994","الوافر"],[159,"قم فاجل همي يا غلام","https://www.aldiwan.net/poem55556.html","مجزوء الكامل"],[164,"برغم سنة خير العجم والعرب","https://www.aldiwan.net/poem59217.html","البسيط"],[203,"ليت أهل الغرام ما عشقوا","https://www.aldiwan.net/poem45222.html","المنسرح"],[208,"أحب فمن ذا الذي أخلفه","https://www.aldiwan.net/poem53251.html","المتقارب"],[358,"زفت على بدر العلى الأفراح","https://www.aldiwan.net/poem40541.html","الكامل"],[369,"رأيت الطريق إلى الوصل وعرا","https://www.aldiwan.net/poem60911.html","الطويل"],[385,"سرى البرق في الأفق الشمالي معتنا","https://www.aldiwan.net/poem48756.html","الطويل"],[443,"عدتنا عواد من تناء ومن هجر","https://www.aldiwan.net/poem2588.html","الطويل"],[556,"أما الشباب فقد مضت أيامه","https://www.aldiwan.net/poem47253.html","الكامل"],[556,"إني الشجاع وقد جزعت كما ترى","https://www.aldiwan.net/poem47701.html","الكامل"],[575,"أينجو بنو بدر بمقتل مالك","https://www.aldiwan.net/poem59464.html","الطويل"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44580","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96629","الكامل"],[1090,"","https://poetry.dctabudhabi.ae/diwan/poem/96462","الطويل"],[1892,"","https://poetry.dctabudhabi.ae/diwan/poem/96223","الكامل"],[3474,"","https://poetry.dctabudhabi.ae/diwan/poem/144876","الكامل"],[3871,"","https://poetry.dctabudhabi.ae/diwan/poem/145928","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119604","البسيط"],[4338,"","https://poetry.dctabudhabi.ae/diwan/poem/99893","الكامل"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62137","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141678","الطويل"],[5183,"خميلة الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=185682",""],[5219,"المتهمة البريئة","https://www.poetsgate.com/ViewPoem.aspx?id=194914",""],[5751,"شَكوى مُسافر","https://www.poetsgate.com/ViewPoem.aspx?id=214716",""],[6125,"تُدمِي بقلبي هِجرَةٌ وجَفَاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=208593",""]],"verses":[["وكأنّ زَوْرَتَهُ تألُّقُ بارِقٍ","هَتَفَتْ بهِ النّكْباءُ وهْيَ بَليلُ",0,"ل",1,0],["وَكانَ زَعيمُهُم إِذ ذاكَ لَيث","هِزَبراً لا يُبالي بِالرَزِيَّه",1,"ي",2,0],["وكان زْيناً لكل من نفر ال","سؤددَ إقراره لمن نَفره",2,"ر",2,0],["وَكَأَنَّ زَورَكَ فيهِ أَلفُ كَمَنجَةٍ","وَكَأَنَّ صَدرَكَ فيهِ أَلفُ مُرَدِّدِ",3,"د",1,0],["وَكانَ زَيدُ النار في أَيامهم","وَالآخرُ الجَزّار عاث وَعَتا",4,"ا",1,0],["وَكانَ زَعيمُهُم إِذ ذاكَ لَيثاً","هِزَبراً لا يُبالي بِالرَزِيَّه",5,"ي",2,0],["وَكأنَّ زُرْقَ نُجُومِها","حَدَقٌ مُفَتَّحَةٌ نِيَامُ",6,"م",1,0],["وكان زهدهم أضعاف حرصكم","على الفخار وحب الجاه والنسب",7,"ب",1,0],["وكانَ زمانٌ كليلةٍ حلكتْ","هواكَ عندي لصبحها فلقُ",8,"ق",1,0],["وكان زكيّاً كما قد علمتُ","فما ذا التعدّي وما ذا السَّفَه",9,"ف",2,0],["وَكَأنَّ زَهر الياسمين سُحيرةً","زهرُ النُجوم زَهابها الإِصباحُ",10,"ح",1,0],["وكان زمانُ لئامِ الوُلاةِ","ومَنْ بسوى الشّرِّ لم يُبْقِ ذِكرا",11,"ر",2,0],["وَكانَ زَماني قَد أَماتَ قَرائِحي","وَغَيبُها في لَحد قسوتِهِ دُفِنا",12,"ن",2,0],["وكان زماني قد علا بي وصانني","فكنتُ أصونُ النفس عن عمل الشعرِ",13,"ر",1,0],["وكأنّ زُوراً لفّقتْ ألفاظُهُ","سِلْكٌ وَهى فَاِنحلّ عنه نظامُهُ",14,"م",2,0],["وكأنّ زَمْجَرَةَ الرُّعودِ خلالَهُ","دوحٌ تقصّفَ أو زئيرُ سِباعِ",15,"ع",1,0],["وكان زيادٌ قبله يتقى به","من الدهر ان يوم المَّ فظيع",16,"ع",1,0],["وَكَأَنَّ زَهرَ الباقِلاءِ دَراهِمٌ","قَد ضُمِّخَت أَوساطُها بِالعَنبَرِ",17,"ر",1,0],["وكأنّ زهرَ الورد وا","ضح خدّها المتورّدِ",18,"د",1,0],["وَكَانَ زَعِيمَ القَومِ فِيمَا يَنُوبُهُم","إِذَا عَىَّ مَن يَومَ ذَاكَ بِغَائِبِ",19,"ب",1,0],["وكان زهرة أرضه","فرشت بأحسن مفرش",20,"ش",1,0],["وكأن زهر اللوز صب عاشق","قد هزه شوق إلى أحبابه",21,"ه",1,1],["وكأن زهر اللوز أحداق إلى ال","زوار من خلل الغصون تحدق",22,"ق",1,0],["وكان زهرُ رباه دائماً نضراً","وظلّت الطير تثنيه على الشجر",23,"ر",1,0],["وكأنّ زهر رياضها من بشره","يهدي الضياء لكلِّ ناظر عين",24,"ن",1,0],["وكأن زورتها ربابة ياسر","لزت بأربعة من الأزلام",25,"م",1,0],["وكان زماني مازحاً فمزحته","فلما تعاطى الجدَّ ملت عن المزح",26,"ح",1,0],["وكأن زغردة الهزار بغصنه","نغم الحسان تهيم في الأجراس",27,"س",1,0],["وكان زفافها حفلا عظيما","زغاريدا وأفراحا طوالا",28,"ل",2,0],["وكانَ زريابُ يبني الشوقَ في وَتَرٍ","فظلَّ يخترقُ الأزمانَ مُتَّقِدا",29,"د",2,0],["وكَأنَّ زَهرًا في الخُدُودِ تَنَوَّرَتْ","وتَخَضَّلَتْ مِنْ رِيقِهَا الرَّمضَاءُ",30,"ا",2,0]]}