{"poems":[[63,"ومكاشح نهنهته عن غاية","https://www.aldiwan.net/poem46081.html","الكامل"],[63,"نهج الثناء إلى ناديك مختصر","https://www.aldiwan.net/poem46122.html","البسيط"],[63,"ألفت الندى والعامرية تعذل","https://www.aldiwan.net/poem46139.html","الطويل"],[77,"نبه نديمك للصبوح وهاتها","https://www.aldiwan.net/poem36703.html","الكامل"],[42,"نبئت أن زيادا ظل يشتمني","https://www.aldiwan.net/poem50452.html","البسيط"],[88,"اليوم قري يا مواطن أعينا","https://www.aldiwan.net/poem44458.html","الكامل"],[27,"غدا باجتماع الحي نقضي لبانة","https://www.aldiwan.net/poem5735.html","الطويل"],[47,"أتعز أنت على رسوم مغان","https://www.aldiwan.net/poem25112.html","الكامل"],[47,"غيري يغيره الفعال الجافي","https://www.aldiwan.net/poem25226.html","الكامل"],[72,"دمعي عليك مجانس قلبي","https://www.aldiwan.net/poem18235.html","أحذ الكامل"],[72,"البرق في كانونه قد نفخ","https://www.aldiwan.net/poem18532.html","السريع"],[72,"مذ قيل فرعك بالذوائب عرشا","https://www.aldiwan.net/poem19056.html","الكامل"],[72,"يا ابن الأولى اتخذوا السماء مطامحا","https://www.aldiwan.net/poem19691.html","الكامل"],[51,"تركنا لكم دنياكم وتخاضعت","https://www.aldiwan.net/poem61913.html","الطويل"],[29,"طرق الكرى بالغانيات وربما","https://www.aldiwan.net/poem6174.html","الكامل"],[85,"ممات في المواكب أم حياة","https://www.aldiwan.net/poem62910.html","الوافر"],[85,"اختلاف النهار والليل ينسي","https://www.aldiwan.net/poem63713.html","الخفيف"],[85,"تلك الطبيعة قف بنا يا ساري","https://www.aldiwan.net/poem63715.html","الكامل"],[85,"رضي المسلمون والإسلام","https://www.aldiwan.net/poem63740.html","الخفيف"],[43,"أهلا بدار سباك أغيدها","https://www.aldiwan.net/poem9531.html","المنسرح"],[45,"ما أنت للكلف المشوق بصاحب","https://www.aldiwan.net/poem10671.html","الكامل"],[45,"يضحكن عن برد ونور أقاح","https://www.aldiwan.net/poem62719.html","الكامل"],[45,"ما لذا الظبي لاينال إقتناصه","https://www.aldiwan.net/poem64618.html","الخفيف"],[45,"أما الشباب فقد سبقت بغضه","https://www.aldiwan.net/poem64623.html","الكامل"],[45,"فؤاد بذكر الظاعنين موكل","https://www.aldiwan.net/poem65589.html","الطويل"],[45,"يهون عليها أن أبيت متيما","https://www.aldiwan.net/poem65665.html","الطويل"],[45,"هويناك من لوم على حب تكتما","https://www.aldiwan.net/poem65682.html","الطويل"],[45,"ألمت وهل إلمامها لك نافيع","https://www.aldiwan.net/poem64706.html","الطويل"],[28,"ألا زعمت عرسي سويدة أنها","https://www.aldiwan.net/poem1243.html",""],[28,"لا قوم أكرم من تميم إذ غدت","https://www.aldiwan.net/poem5479.html","الكامل"],[61,"الله جارك ظاعنا ومقيما","https://www.aldiwan.net/poem51442.html","الطويل"],[61,"ما سره أن ذاع من أسراره","https://www.aldiwan.net/poem51672.html","الكامل"],[61,"عفر الظباء لدى الكثيب الأعفر","https://www.aldiwan.net/poem51686.html","الكامل"],[61,"أبا العمر خيم أم بالحشاء","https://www.aldiwan.net/poem51834.html","المتقارب"],[80,"خطب يهز شواهق الأطواد","https://www.aldiwan.net/poem31498.html","الكامل"],[44,"يا سمي الذي تبهل يدعو","https://www.aldiwan.net/poem30270.html","الخفيف"],[44,"طلل الجميع لقد عفوت حميدا","https://www.aldiwan.net/poem30553.html","الكامل"],[69,"ومكاري ماطلته","https://www.aldiwan.net/poem28290.html","مجزوء الكامل"],[81,"ومكرر سحر اللواحظ أهيف","https://www.aldiwan.net/poem61316.html","الكامل"],[102,"أدموع النساء والأطفال","https://www.aldiwan.net/poem33120.html","الخفيف"],[52,"نهى الجهل شيب الرأس بعد نزاع","https://www.aldiwan.net/poem26864.html","الطويل"],[75,"ومكلل بالدر من إفرنده","https://www.aldiwan.net/poem69084.html","الكامل"],[50,"ومكللات بالعيوب","https://www.aldiwan.net/poem62365.html","مجزوء الكامل"],[50,"ألا يا حبذا والله","https://www.aldiwan.net/poem63814.html","الهزج"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140802","المنسرح"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39622","الكامل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30451","الرمل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9879","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54868","الكامل"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/13598","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43800","الكامل"],[106,"هل عاد قيس؟","https://www.poetsgate.com/ViewPoem.aspx?id=179386",""],[84,"اصبيح شيم أم برق بدا","https://www.poetsgate.com/ViewPoem.aspx?id=26319",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[90,"أجب أيُّها القلب","https://www.poetsgate.com/ViewPoem.aspx?id=179171",""],[45,"هُوَيْنَاكَ مِنْ لَوْمٍ على حُبٍّ تَكَتّمَا","https://www.poetsgate.com/ViewPoem.aspx?id=32085",""],[45,"يَهُونُ عَلَيْهَا أنْ أبِيتَ مُتَيَّما","https://www.poetsgate.com/ViewPoem.aspx?id=31883",""]],"verses":[["وَمُكاشِحٍ نَهْنَهْتُهُ عَنْ غايَةٍ","زَأَرَ الأُسودُ الغُلْبُ دونَ عَرينِها",0,"ن",3,1],["ومَكْرُماتٌ منَ المَهْديّ تَنْشُرُها","وأيَّ هَدْيٍ إِلى العَلياءِ تَفْتَقِرُ",1,"ر",1,0],["ومُكْتَحِلاتٌ بالظّلامِ أُثيرُها","وهُنّ كأشْباحِ الأهِلّةِ نُحَّلُ",2,"ل",1,0],["وَمَكَارِمٌ قَدْ أَعْجَزَتْ مَنْ رَامَهَا","تَسْتَغْرِقُ الدُّنْيَا أَقَلُّ هِبَاتِهَا",3,"ت",3,0],["وَمُكفِلُ اللَهَ بِالعُتبى وَمُعتَرِفٌ","أَن قَد ظُلِمتُ وَمُستَعِفٍ وَمُعتَذِلُ",4,"ل",1,0],["ومكائد السفهاء واقعة بهم","وعداوة الشعراء بئس المقتنى",5,"ن",2,0],["وَمُكتَبَلاً في القَدِّ لَيسَ بِنازِعٍ","لَهُ مِن مِراسِ القِدِّ رِجلاً وَلا يَدا",6,"د",2,0],["وَمَكانَ كُلِّ مُهَنَّدٍ وَمَجَرَّ كُل","لِ مُثَقَّفٍ وَمَجالَ كُلِّ حِصانِ",7,"ن",1,0],["وَمَكارِمي عَدَدُ النُجومِ وَمَنزِلي","مَأوى الكِرامِ وَمَنزِلُ الأَضيافِ",8,"ف",1,0],["ومكارمٍ من دونِ غايتها","خفيت وما بلغت قوَى كعب",9,"ب",1,0],["ومكنت فيه مدى برقه","حتَّى أرى من جلدهِ ما انْسلخ",10,"خ",1,0],["ومكانة في العلمِ شبَّ بقاعها","نارُ الهدى فهشا إليها من عشا",11,"ش",2,0],["ومكارم تكفي السؤال وهيبة","تكفي روائع ذكرها أن تبطشا",11,"ش",2,0],["ومكارم ما لاح بشرك بارقاً","إلاَّ اسْتهلَّت للوفودِ غماما",12,"م",2,0],["ومكَّنْتُمُ أذقانَكُمْ من نُحوركُمْ","كأنَّكُمُ أولادُ يَحيَى بن خالدِ",13,"د",1,0],["وَمَكَرِّ مُعتَرَكٍ تَرَكنَ حُماتَهُ","لِلطَيرِ بَينَ سَوافِلٍ وَعَوالي",14,"ل",2,0],["وَمَكروهٍ عَلى أَخَذاتِ ظَنٍّ","تُحَبِّبُهُ إِلَيكَ التَجرُباتُ",15,"ت",1,0],["وَمَكانُ الكِتابِ يُغريكَ رَيّا","وَردِهِ غائِباً فَتَدنو لِلَمسِ",16,"س",1,0],["وَمُكَذِّبٍ بِالجِنِّ ريعَ لِصَوتِها","في الماءِ مُنحَدِراً وَفي التَيّارِ",17,"ر",1,0],["وَمَكانُ الإِمامِ أَعلى وَلَكِن","بِأَحاديثِهِ يَتيهُ الأَنامُ",18,"م",1,0],["وَمَكرُماتٍ مَشَت عَلى قَدَمِ ال","بِرِّ إِلى مَنزِلي تُرَدِّدُها",19,"د",3,0],["وَمَكارِمٌ مَعمورَةٌ بِصَنائِعٍ","فَكَأَنَّها مَمطورَةٌ بِسَحائِبِ",20,"ب",1,0],["وَمَكانِهِم مِن فارِسٍ حَيثُ التَقَت","غُرَرُ الجِيادِ تُعانُ بِالأَوضاحِ",21,"ح",1,0],["وَمَكَرٍّ شَهَدتَهُ فَغَدا قِر","نُكَ فيهِ مُغَلِّساً إِقعاصُه",22,"ص",2,0],["وَمُكايِدٍ لي بِالمَغيبِ رَمَيتُهُ","بِصَريمَةٍ كَالنَجمِ في مُنقَضِّهِ",23,"ض",2,0],["وَمَكرُمَةِ الدُنيا الَّتي لَيسَ دونَها","مُرادٌ وَلا عَن ظِلِّها مُتَحَوَّلُ",24,"ل",1,0],["وَمُكتَسِبٌ فِيَّ المَلامَةَ ماجِدٌ","يَرى الحَمدَ غُنماً وَالمَلامَةَ مَغرَم",25,"م",1,0],["وَمَكرُمَةٍ لَم يَبتَدِ القَومُ صَوغُها","وَلَم يَتَلافَوا مُبتَناها تَعَلُّما",26,"م",2,0],["وَمُكتَتِمُ التَدبيرِ لَيسَ بِظاهِرٍ","عَلى سِرِّهِ الرَأيُ الَّذي هُوَ تابِعُ",27,"ع",1,0],["وَمُكثِرَةٍ يا سَودَ وَدَّت لَوَ أَنَّها","مَكانَكِ وَالأَقوامُ عِندَ الضَرايِبِ",28,"ب",1,0],["وَمُكَبَّلٍ تَرَكَ الحَديدُ بِساقِهِ","أَثَراً مِنَ الرَسَفانِ في الأَحجالِ",29,"ل",1,0],["ومكارمٌ أنصَفتَ فيهِنَّ العُلى","وتركتَ مالَك بينها مَظْلوما",30,"م",2,0],["ومكارمٌ تُعْلي ذُرى أطوادِه","في الأزدِ أو تُذْكي سَنا أقمارِه",31,"ر",2,0],["ومَكارِماً يسعَى إليهنَّ المُنى","سعيَ الحجيجِ إلى الصَّفا والمَشْعَرِ",32,"ر",1,0],["ومكرُمةٌ لو غَدَتْ مُزنةً","لأيقنَ منها الثَّرى بالثَّراءِ",33,"ا",2,0],["ومكارمٌ بُذِلَتْ لِصَونِ نُفوسهِم","معدودةٌ بالفضلِ في الأَعدادِ",34,"د",1,0],["وَمُكَنّىً تَتوقُ نَفسي إِلَيهِ","بِالرَسولِ الكَريمِ بَعدَ المَسيحِ",35,"ح",1,0],["وَمَكارِماً عُتُقَ النِجارِ تَليدَةً","إِن كانَ هَضبُ عَمايَتَينِ تَليدا",36,"د",2,0],["ومَكاريٍّ ماطلْتُهُ","بِكِراه قال مُذكِّرا",37,"ر",2,1],["ومُكَرّرٍ سِحر اللَّواحِظِ أهيَفِ","قَلبِي بموسَى ناظِريهِ كَلِيمُ",38,"م",1,1],["ومكبّ على بنيه بوجهٍ","خلط الدمع بالثرى المنهال",39,"ل",1,0],["وَمَكرُمَةٍ عِندَ السَماءِ مُنيفَةٍ","تَناوَلَها مِنّي بِأَطوَلِ باعِ",40,"ع",1,0],["ومُكَلَّلٍ بالدُّرِّ من إفرِنْدِهِ","فيهِ أكالِيلٌ من الفُولاذِ",41,"ذ",1,1],["وَمُكلَّلاتُ بِالعُيو","نِ طَرَقنَنا وَرَجَعنَ مَلَسا",42,"س",2,1],["وَمِكسالُ الضُحى كَالري","مِ لا بَل تُشبِهُ البَدرا",43,"ر",2,0],["ومكرماتٍ مشت على قدم البر","ر إلى منزلي ترددها",44,"د",3,0],["ومكرتِ مكرَكِ يا حبيبةُ وانقضى","ليلي وأنتِ لديَّ ساهرةٌ معي",45,"ي",1,0],["ومَكانٍ عازِبٍ مِن جِيرَةٍ","أَصْدِقَاءٍ وهُم عَيْنُ العِدَا",46,"د",2,0],["وَمَكروبٍ كَشَفتُ الكَربَ عَنهُ","بِضَربَةِ فَيصَلٍ لَمّا دَعاني",47,"ي",1,0],["وَمكَارِمٌ تحْيِي المَكَارِمَ فِي الملاَ","كَالبَحْرِ مِنْهُ الصَّيِّبُ المِدْرَارُ",48,"ر",1,0],["وَمَكيدَةٍ أَشلى عَليكَ نُيوبِها","غَضبانُ لِلقُربى القَريبَةِ ناسِ",49,"س",1,0],["وَمُكبّراً مُذ كانَ لا صغرٌ بِهِ","وَمُطهّراً لَم يَدرِ ما التَدنيسِ",50,"س",1,0],["ومكفَّنٌ في مهده","يوم الولادة يُحْتَضَر",51,"ر",1,0],["ومكان عازب عن جيرة","أصدقاء وهم عين العدى",52,"د",2,0],["ومكابدٍ كَرْبَ المماتِ شركتَهُ","- إذْ لم تَحِدْ منجىً – عناءاً كارِبا",53,"ب",2,0],["ومكبْوتةٍ لم يشفَعِ الصَّفْحُ عندَها","مددتُ إليها مِنْ أناةٍ بشافِع",54,"ع",1,0],["وَمَكرُمَةٍ لمْ يَبْتَدِ القَوْمُ صَوْغَها،","وَلَمْ يَتَلاَفَوْا مُبْتغَاهَا تَعَلُّما",55,"م",2,0],["وَمُكتَسِبٌ في المَلامَةَ ماجِدٌ،","يَرَى الحَمدَ غُنْماً، والمَلاَمَةَ مَغرَمَا",56,"م",2,0]]}