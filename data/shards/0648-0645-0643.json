"إن المنية في الورى أسباب","https://www.aldiwan.net/poem14436.html","الكامل"],[459,"أخوي والعشاق إخوه","https://www.aldiwan.net/poem55820.html","مجزوء الكامل"],[459,"ومكنونة بين الخدور أقامها","https://www.aldiwan.net/poem55980.html","الطويل"],[459,"طرقت على خطر السرى المركوب","https://www.aldiwan.net/poem56281.html","الكامل"],[462,"بت حيث شئت ولا يرعك المنزل","https://www.aldiwan.net/poem16015.html","الكامل"],[465,"أقام الوجد بعدهم وساروا","https://www.aldiwan.net/poem3209.html","عموديه"],[465,"قم نديمي فاسفك دم الزق","https://www.aldiwan.net/poem3306.html","عموديه"],[465,"بالله يا رسل الرياح","https://www.aldiwan.net/poem3515.html","عموديه"],[469,"أدب يهرول خلفه السمع","https://www.aldiwan.net/poem59908.html","أحذ الكامل"],[487,"أرسم ديار بالستارين تعرفُ","https://www.aldiwan.net/poem482.html",""],[501,"إلهي بنور الذات في القدم الأسمى","https://www.aldiwan.net/poem37803.html","الطويل"],[515,"خطرت فمال الغصن وهو ممنطق","https://www.aldiwan.net/poem20823.html","الكامل"],[516,"قدومك أفرح قلب الهدى","https://www.aldiwan.net/poem12068.html","المتقارب"],[516,"سجوداً فهذا صاحب الركن والحجر","https://www.aldiwan.net/poem12107.html","الطويل"],[516,"خذ حديثي فإنه معسول","https://www.aldiwan.net/poem12218.html","الخفيف"],[530,"ألا هكذا من يروم الفخارا","https://www.aldiwan.net/poem37413.html","المتقارب"],[541,"ومكاشح لولاك أصبح جانحا","https://www.aldiwan.net/poem56886.html","الكامل"],[552,"من أين لي معد على الأيام","https://www.aldiwan.net/poem47204.html","الكامل"],[552,"أيا حادي الأظعان لم لا تعرس","https://www.aldiwan.net/poem47754.html","الطويل"],[552,"شطت عليك لبانة الصدر","https://www.aldiwan.net/poem47783.html","أحذ الكامل"],[562,"بكيت والمحتزن البكي","https://www.aldiwan.net/poem27848.html","الرجز"],[568,"ومكابد حالا يسددها","https://www.aldiwan.net/poem69481.html","أحذ الكامل"],[568,"أمسك ديف بالقهوة","https://www.aldiwan.net/poem69769.html","الهزج"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[570,"رب أمور قد بريت لحاءها","https://www.aldiwan.net/poem52036.html","الطويل"]],"verses":[["وَمُكاشِحٍ نَهْنَهْتُهُ عَنْ غايَةٍ","زَأَرَ الأُسودُ الغُلْبُ دونَ عَرينِها",0,"ن",3,1],["ومَكْرُماتٌ منَ المَهْديّ تَنْشُرُها","وأيَّ هَدْيٍ إِلى العَلياءِ تَفْتَقِرُ",1,"ر",1,0],["ومُكْتَحِلاتٌ بالظّلامِ أُثيرُها","وهُنّ كأشْباحِ الأهِلّةِ نُحَّلُ",2,"ل",1,0],["وَمَكَارِمٌ قَدْ أَعْجَزَتْ مَنْ رَامَهَا","تَسْتَغْرِقُ الدُّنْيَا أَقَلُّ هِبَاتِهَا",3,"ت",3,0],["وَمُكفِلُ اللَهَ بِالعُتبى وَمُعتَرِفٌ","أَن قَد ظُلِمتُ وَمُستَعِفٍ وَمُعتَذِلُ",4,"ل",1,0],["ومكائد السفهاء واقعة بهم","وعداوة الشعراء بئس المقتنى",5,"ن",2,0],["وَمُكتَبَلاً في القَدِّ لَيسَ بِنازِعٍ","لَهُ مِن مِراسِ القِدِّ رِجلاً وَلا يَدا",6,"د",2,0],["وَمَكانَ كُلِّ مُهَنَّدٍ وَمَجَرَّ كُل","لِ مُثَقَّفٍ وَمَجالَ كُلِّ حِصانِ",7,"ن",1,0],["وَمَكارِمي عَدَدُ النُجومِ وَمَنزِلي","مَأوى الكِرامِ وَمَنزِلُ الأَضيافِ",8,"ف",1,0],["ومكارمٍ من دونِ غايتها","خفيت وما بلغت قوَى كعب",9,"ب",1,0],["ومكنت فيه مدى برقه","حتَّى أرى من جلدهِ ما انْسلخ",10,"خ",1,0],["ومكانة في العلمِ شبَّ بقاعها","نارُ الهدى فهشا إليها من عشا",11,"ش",2,0],["ومكارم تكفي السؤال وهيبة","تكفي روائع ذكرها أن تبطشا",11,"ش",2,0],["ومكارم ما لاح بشرك بارقاً","إلاَّ اسْتهلَّت للوفودِ غماما",12,"م",2,0],["ومكَّنْتُمُ أذقانَكُمْ من نُحوركُمْ","كأنَّكُمُ أولادُ يَحيَى بن خالدِ",13,"د",1,0],["وَمَكَرِّ مُعتَرَكٍ تَرَكنَ حُماتَهُ","لِلطَيرِ بَينَ سَوافِلٍ وَعَوالي",14,"ل",2,0],["وَمَكروهٍ عَلى أَخَذاتِ ظَنٍّ","تُحَبِّبُهُ إِلَيكَ التَجرُباتُ",15,"ت",1,0],["وَمَكانُ الكِتابِ يُغريكَ رَيّا","وَردِهِ غائِباً فَتَدنو لِلَمسِ",16,"س",1,0],["وَمُكَذِّبٍ بِالجِنِّ ريعَ لِصَوتِها","في الماءِ مُنحَدِراً وَفي التَيّارِ",17,"ر",1,0],["وَمَكانُ الإِمامِ أَعلى وَلَكِن","بِأَحاديثِهِ يَتيهُ الأَنامُ",18,"م",1,0],["وَمَكرُماتٍ مَشَت عَلى قَدَمِ ال","بِرِّ إِلى مَنزِلي تُرَدِّدُها",19,"د",3,0],["وَمَكارِمٌ مَعمورَةٌ بِصَنائِعٍ","فَكَأَنَّها مَمطورَةٌ بِسَحائِبِ",20,"ب",1,0],["وَمَكانِهِم مِن فارِسٍ حَيثُ التَقَت","غُرَرُ الجِيادِ تُعانُ بِالأَوضاحِ",21,"ح",1,0],["وَمَكَرٍّ شَهَدتَهُ فَغَدا قِر","نُكَ فيهِ مُغَلِّساً إِقعاصُه",22,"ص",2,0],["وَمُكايِدٍ لي بِالمَغيبِ رَمَيتُهُ","بِصَريمَةٍ كَالنَجمِ في مُنقَضِّهِ",23,"ض",2,0],["وَمَكرُمَةِ الدُنيا الَّتي لَيسَ دونَها","مُرادٌ وَلا عَن ظِلِّها مُتَحَوَّلُ",24,"ل",1,0],["وَمُكتَسِبٌ فِيَّ المَلامَةَ ماجِدٌ","يَرى الحَمدَ غُنماً وَالمَلامَةَ مَغرَم",25,"م",1,0],["وَمَكرُمَةٍ لَم يَبتَدِ القَومُ صَوغُها","وَلَم يَتَلافَوا مُبتَناها تَعَلُّما",26,"م",2,0],["وَمُكتَتِمُ التَدبيرِ لَيسَ بِظاهِرٍ","عَلى سِرِّهِ الرَأيُ الَّذي هُوَ تابِعُ",27,"ع",1,0],["وَمُكثِرَةٍ يا سَودَ وَدَّت لَوَ أَنَّها","مَكانَكِ وَالأَقوامُ عِندَ الضَرايِبِ",28,"ب",1,0],["وَمُكَبَّلٍ تَرَكَ الحَديدُ بِساقِهِ","أَثَراً مِنَ الرَسَفانِ في الأَحجالِ",29,"ل",1,0],["ومكارمٌ أنصَفتَ فيهِنَّ العُلى","وتركتَ مالَك بينها مَظْلوما",30,"م",2,0],["ومكارمٌ تُعْلي ذُرى أطوادِه","في الأزدِ أو تُذْكي سَنا أقمارِه",31,"ر",2,0],["ومَكارِماً يسعَى إليهنَّ المُنى","سعيَ الحجيجِ إلى الصَّفا والمَشْعَرِ",32,"ر",1,0],["ومكرُمةٌ لو غَدَتْ مُزنةً","لأيقنَ منها الثَّرى بالثَّراءِ",33,"ا",2,0],["ومكارمٌ بُذِلَتْ لِصَونِ نُفوسهِم","معدودةٌ بالفضلِ في الأَعدادِ",34,"د",1,0],["وَمُكَنّىً تَتوقُ نَفسي إِلَيهِ","بِالرَسولِ الكَريمِ بَعدَ المَسيحِ",35,"ح",1,0],["وَمَكارِماً عُتُقَ النِجارِ تَليدَةً","إِن كانَ هَضبُ عَمايَتَينِ تَليدا",36,"د",2,0],["ومَكاريٍّ ماطلْتُهُ","بِكِراه قال مُذكِّرا",37,"ر",2,1],["ومُكَرّرٍ سِحر اللَّواحِظِ أهيَفِ","قَلبِي بموسَى ناظِريهِ كَلِيمُ",38,"م",1,1],["ومكبّ على بنيه بوجهٍ","خلط الدمع بالثرى المنهال",39,"ل",1,0],["وَمَكرُمَةٍ عِندَ السَماءِ مُنيفَةٍ","تَناوَلَها مِنّي بِأَطوَلِ باعِ",40,"ع",1,0],["ومُكَلَّلٍ بالدُّرِّ من إفرِنْدِهِ","فيهِ أكالِيلٌ من الفُولاذِ",41,"ذ",1,1],["وَمُكلَّلاتُ بِالعُيو","نِ طَرَقنَنا وَرَجَعنَ مَلَسا",42,"س",2,1],["وَمِكسالُ الضُحى كَالري","مِ لا بَل تُشبِهُ البَدرا",43,"ر",2,0],["ومكرماتٍ مشت على قدم البر","ر إلى منزلي ترددها",44,"د",3,0],["ومكرتِ مكرَكِ يا حبيبةُ وانقضى","ليلي وأنتِ لديَّ ساهرةٌ معي",45,"ع",2,0],["ومَكانٍ عازِبٍ مِن جِيرَةٍ","أَصْدِقَاءٍ وهُم عَيْنُ العِدَا",46,"د",2,0],["وَمَكروبٍ كَشَفتُ الكَربَ عَنهُ","بِضَربَةِ فَيصَلٍ لَمّا دَعاني",47,"ن",2,0],["وَمكَارِمٌ تحْيِي المَكَارِمَ فِي الملاَ","كَالبَحْرِ مِنْهُ الصَّيِّبُ المِدْرَارُ",48,"ر",1,0],["وَمَكيدَةٍ أَشلى عَليكَ نُيوبِها","غَضبانُ لِلقُربى القَريبَةِ ناسِ",49,"س",1,0],["وَمُكبّراً مُذ كانَ لا صغرٌ بِهِ","وَمُطهّراً لَم يَدرِ ما التَدنيسِ",50,"س",1,0],["ومكفَّنٌ في مهده","يوم الولادة يُحْتَضَر",51,"ر",1,0],["ومكان عازب عن جيرة","أصدقاء وهم عين العدى",52,"د",2,0],["ومكابدٍ كَرْبَ المماتِ شركتَهُ","- إذْ لم تَحِدْ منجىً – عناءاً كارِبا",53,"ب",2,0],["ومكبْوتةٍ لم يشفَعِ الصَّفْحُ عندَها","مددتُ إليها مِنْ أناةٍ بشافِع",54,"ع",1,0],["وَمَكرُمَةٍ لمْ يَبْتَدِ القَوْمُ صَوْغَها،","وَلَمْ يَتَلاَفَوْا مُبْتغَاهَا تَعَلُّما",55,"م",2,0],["وَمُكتَسِبٌ في المَلامَةَ ماجِدٌ،","يَرَى الحَمدَ غُنْماً، والمَلاَمَةَ مَغرَمَا",56,"م",2,0],["ومكنة في رمال الخليج","وشبت عن يديك ، وأنت أختفت",57,"ت",1,0],["وَمَكاني مِن الفَخار مَكان","حَسدتهُ الشُموس وَالأَقمارُ",58,"ر",1,0],["ومكثت اقطع ليل انس لم يمل","نحو الكرى من وجده سهاره",59,"ر",2,0],["ومِكنَة عندى ذى العرش استقل بها","ورتبة دونها الجوزاءُ والأسد",60,"د",1,0],["وَمَكرٌ بِحَمدِ اللَهِ حاقَ بِأَهلِهِ","وَعارِضُ بَغيٍ قَبلَ أَن يُمطِرَ اِنجابا",61,"ب",2,0],["ومكانة طرف الحسود لها","وبنانه في الغض والعضّ",62,"ض",1,0],["ومكارمٍ غرٍّ وفضل باهر","ومناقبٍ طابت لطيبِ أَساس",63,"س",1,0],["ومكن من قطر وشم شوامخ","تطاها كما يطا الفتى شمل البرد",64,"د",1,0],["وَمَكارِمٌ تَرنو إِلى عَليائِها","عَينُ الحَسودِ وَقَلبُهُ مُغتاظُ",65,"ظ",1,0],["ومُكرِّرِ الزَّفَرَاتِ في مِحْرابه","يَقْرأ ويركع للإله ويسجد",66,"د",1,0],["ومكان يتأوا","ه ويرضيه مبيته",67,"ت",2,0],["وَمُكثِرٍ كانَ ذا مالٍ فَأَذهَبَهُ","تَفريقُ ما يُذهِبُ الأَموالَ فَاِفَتَقَرا",68,"ر",2,0],["ومكانةٌ في المجدِ أنتَ عَمَرْتَها","بعُلاكَ وهيَ من الأنامِ خَلاءُ",69,"ا",2,0],["ومكارماً تابعتَهنَّ كأنما","تقرا بهنَّ على الأنام كتابا",70,"ب",2,0],["وَمَكارما منك اِستَمَدَّ","جَمالها غَضّا وَنَضرا",71,"ر",2,0],["ومكتفيا فاعدد ومقتدراً وقد","تلا قاهراً راض لمتقي تلا",72,"ل",2,0],["ومكانهم وضعوا الكلاب بدلِّها","ما بين تقبيل ودفء عناق!!",73,"ق",1,0],["وَمَكارِم قد عمت الدنيا نَدى","وَهدى وأخرى أخرت للمحشر",74,"ر",1,0],["وَمَكثت في النيابَتين متيما","وَلَقَد رَضيت بأن أَعيش متيما",75,"م",2,0],["وَمكارم موصولة بمكارم","وَلطائف وَعَواطِف وَأَيادي",76,"د",2,0],["وَمَكِينَةٍ لَوْ أَمكَنَتْ زُحَلاً إِذاً","لَغَدا لَها مُتَرَشِّحاً مُتَعَرِّضا",77,"ض",2,0],["وَمَكْرَمَةٍ وَالَيْتَها وَصَنيعَةٍ","زَكَتْ لَكَ عِنْدِي حِدْثُها وَعَتِيقُها",78,"ق",3,0],["وَمكارمٍ لولاك لَم يطرق بها","سَمعٌ ولا كحل العيان بميسمِ",79,"م",1,0],["وَمُكابِرٌ إِحساسَهُ في أَنَّهُ","وَسِواهُ مِن أَضدادِهِ مَتَوَحِّدُ",80,"د",1,0],["وَمُكَلِّفٌ وَمُرَفَّهٌ وَمُبَصَّرٌ","وَمَبَصِّرٌ وَمُقَلِّدٌ وَمُقَلَّدُ",80,"د",1,0],["وَمَكرُ فِكري في خَفِيِّ مَكرِهِ","مِن خاطِري فيهِ أَنا عَلى خَطَر",81,"ر",1,0],["ومُكْرِمُ مثْلي مُكْرِمٌ بي نفسَه","إذا أَعملَ الفِكْرَ الفقيهُ المُناظر",82,"ر",1,0],["ومكرمةٍ بكرٍ بنَيتَ أساسَها","وهُمْ عَنْ بناءِ المكرمات رقودُ",83,"د",1,0],["ومكتِئبٍ أَخْفى هواهُ صبابةً","ولم أدْرِ ما دينُ الصَّبابةِ لولاهُ",84,"ه",1,0],["ومكتئِبٍ أَخْفى هواهُ صبابةً","زَماناً فأضْناهُ سقاماً وأحفَاهَ",84,"ه",1,0],["ومُكْتَئبٍ يشكو الزّمانَ وقد غَدَتْ","مشارقُه مَسْلوكةً ومغارِبُهْ",85,"ب",2,0],["ومكحولة الأجفان مخضوبة الشوا","ولم ندر ما لون الخضاب من الكحل",86,"ل",1,0],["ومكارم نشرت فلو سبقت","لم يبق للطائيّ من نشر",87,"ر",1,0],["وَمكان سوطي في المسير إِرادَتي","في سيرها وَاللَيلُ بحر ظَلامِ",88,"م",1,0],["وَمُكَلِّف الأَيامِ ضِدَّ طِباعِها","مُتَطَّلِب في الماءِ جَذوة نارِ",89,"ر",1,0],["وَمُكَرِّماً لِلوافِدينَ وَمالِهِ","وَفدٌ وَلَيسَ مكرمً كَوفودِهِ",90,"د",2,0],["ومكّنه الله من عِزَّةٍ","من الأمن غاية إمكانها",91,"ن",3,0],["ومكرمة وإحسان وفضل","وما فيها سعى ولها تصدَّى",92,"د",2,0],["ومُكابدٍ تَعَباً إِلى أَكَمٍ","وافَى عليها كُلُّ مُرْتَكِمِ",93,"م",1,0],["ومكارمٌ غُصِبَتْ بواجبِ حقّها","ما صاغَهُ حسانُ في غسانِ",94,"ن",1,0],["ومكارم كرمت أصولاً في العلى","ومناقب لمتوجبن كرام",95,"م",1,0],["ومكارم تطوى مآ","ثر للأكارم حين تنشر",96,"ر",1,0],["ومكانُهُم من قلبِ كُلِّ كَتيبةٍ","كمكانِهِمْ من قلبِ كُلِّ مُوَحِّدِ",97,"د",1,0],["ومكارم بقيت خلاف مماته","كالغيث يبقى روضه المعشاب",98,"ب",1,0],["ومكانِ أسمنتِ المفا","خرُ كاهلا ضخما وذِروَهْ",99,"و",2,0],["ومكنونةٍ بين الخدور أقامها","هواي ونُصحي حالتين على رِجلِ",100,"ل",1,1],["ومَكرَّماتُ النسلِ تُهوِن في القِرى","بالمصطفى منها وبالمجنوبِ",101,"ب",1,0],["ومكارمٍ لولا شَواغِلُ عَصْرِها","خَجلَ الخِضَمُّ لجودها والهُطَّل",102,"ل",1,0],["ومكّة والحطيم وساكنيها","لقد حكموا على ضعفي فجاروا",103,"ر",3,0],["ومكانُ الهلال في السبع كا","لقبضة لكنَّها بلا مسمار",104,"ر",1,0],["ومكسر الخطيَّ","في الفرسان تكسير الصّحاح",105,"ح",1,0],["وَمُكاتَباتٌ ما يَمُرُّ لَها","فَصلٌ وَلَيسَ لِبَرقِها لَمعُ",106,"ع",1,0],["وَمَكنونَةٌ سودُ المَجاثِمِ لَم يَزَل","يُهَيِّرَها لِلعَيكَتَينِ التَلَهُّفِ",107,"ف",1,0],["ومكِّنْ سُيوفَ البطشِ منكَ تفرُّداً","بقومٍ عَلينا قدْ بَغَوْا سيِّدي ظُلْمَا",108,"م",2,0],["ومكارمٌ فيه تدلُّك أنّها","خُلُقٌ وفي طبعِ الغَمامِ تخلُّقُ",109,"ق",1,0],["ومكرمة أمرت رغبتي","وظني في الناس أن يزهدا",110,"د",2,0],["ومكرمة بين المثوبة والعلى","قسمت العلى فيها الحمد والأجر",111,"ر",1,0],["ومكان مخيم حيث وجه الب","در تاج والمشتري إكليل",112,"ل",1,0],["ومَكِّنْ صَوارِمَهُ حِيْث ما","أَرادَ وصَيِّرْ لَهُ الأَرْضَ دَارا",113,"ر",2,0],["وَمُكاشِحٍ لَولاكَ أَصبَحَ جانِحاً","لِلسِّلمِ يَرقى حَيَّتي وَضِبابي",114,"ي",1,1],["وَمكارمٌ مَشكورةٌ حينَ اِفتَدتْ","فينا طويلَ لِزامها بِلمامِ",115,"م",1,0],["وَمَكْرُمةٍ أَعطيتُها متطلّقاً","وقد ضنّ بالبذل الخسيس المُعبِّسُ",116,"س",1,0],["ومكارمٍ تدعُ الزَّمان بلا","شيءٍ من الإملاقِ والفقرِ",117,"ر",1,0],["وَمَكنِسٌ يَنتابُهُ قَيظِيُّ","أَجوَفُ جافٍ فَوقَهُ بَنِيُّ",118,"ي",1,0],["وَمُكَابِدٍ حَالاً يُسَدِّدُهَا","وَيَرُمُّ ظَاهِرَهَا بِبَاطِنِهَا",119,"ن",3,1],["وَمَكْنُونٌ من الوَجْدِ","بِهِ الأَحْشَاءُ مَنْضُوجَهْ",120,"ج",2,0],["ومكن الله لأوليائه","وطهر البلاد من أعدائه",121,"ه",1,0],["ومكره يبلغه ويلحقه","وعينه بما يخافترمقه",121,"ه",1,0],["ومكرمةٍ كانَت رعاية والدي","فعلمنيها والدي ففعلتها",122,"ت",3,0]]}