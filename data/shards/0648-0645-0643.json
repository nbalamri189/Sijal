iewPoem.aspx?id=205517",""],[5544,"عبري","https://www.poetsgate.com/ViewPoem.aspx?id=213406",""],[5638,"رسول الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=199078",""],[5786,"بريقٌ أضا بالغَضَا مُوهِن","https://www.poetsgate.com/ViewPoem.aspx?id=50653",""],[5897,"حلم","https://www.poetsgate.com/ViewPoem.aspx?id=156535",""],[5897,"زارنا الغيث","https://www.poetsgate.com/ViewPoem.aspx?id=160573",""],[5939,"لصة الأفئدة","https://www.poetsgate.com/ViewPoem.aspx?id=195293",""],[1920,"محبة ووفاء","https://www.poetsgate.com/ViewPoem.aspx?id=191449",""],[5956,"الطيبة الفلتة","https://www.poetsgate.com/ViewPoem.aspx?id=192376",""],[5956,"هي رمزُ عقلانية وتبصر","https://www.poetsgate.com/ViewPoem.aspx?id=193992",""],[5956,"من دون أن نرجوك قمت بالواجب","https://www.poetsgate.com/ViewPoem.aspx?id=194186",""],[6068,"أعواذلي كفِّي اللوائم واعدلي -28-","https://www.poetsgate.com/ViewPoem.aspx?id=175792",""],[6142,"هلم نصفق معا كفي مبايعةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155725",""],[6185,"غزو الهموم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87032&r=&rc=18",""],[6225,"شهر الهدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80903&r=&rc=172",""],[6251,"أتيتك بالبشر لا بالعزاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76474&r=&rc=14",""],[6259,"أتروم تغطية َ الهوى بجحوده","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59366&r=&rc=14",""]],"verses":[["وَمُكاشِحٍ نَهْنَهْتُهُ عَنْ غايَةٍ","زَأَرَ الأُسودُ الغُلْبُ دونَ عَرينِها",0,"ن",3,1],["ومَكْرُماتٌ منَ المَهْديّ تَنْشُرُها","وأيَّ هَدْيٍ إِلى العَلياءِ تَفْتَقِرُ",1,"ر",1,0],["ومُكْتَحِلاتٌ بالظّلامِ أُثيرُها","وهُنّ كأشْباحِ الأهِلّةِ نُحَّلُ",2,"ل",1,0],["وَمَكَارِمٌ قَدْ أَعْجَزَتْ مَنْ رَامَهَا","تَسْتَغْرِقُ الدُّنْيَا أَقَلُّ هِبَاتِهَا",3,"ت",3,0],["وَمُكفِلُ اللَهَ بِالعُتبى وَمُعتَرِفٌ","أَن قَد ظُلِمتُ وَمُستَعِفٍ وَمُعتَذِلُ",4,"ل",1,0],["ومكائد السفهاء واقعة بهم","وعداوة الشعراء بئس المقتنى",5,"ن",2,0],["وَمُكتَبَلاً في القَدِّ لَيسَ بِنازِعٍ","لَهُ مِن مِراسِ القِدِّ رِجلاً وَلا يَدا",6,"د",2,0],["وَمَكانَ كُلِّ مُهَنَّدٍ وَمَجَرَّ كُل","لِ مُثَقَّفٍ وَمَجالَ كُلِّ حِصانِ",7,"ن",1,0],["وَمَكارِمي عَدَدُ النُجومِ وَمَنزِلي","مَأوى الكِرامِ وَمَنزِلُ الأَضيافِ",8,"ف",1,0],["ومكارمٍ من دونِ غايتها","خفيت وما بلغت قوَى كعب",9,"ب",1,0],["ومكنت فيه مدى برقه","حتَّى أرى من جلدهِ ما انْسلخ",10,"خ",1,0],["ومكانة في العلمِ شبَّ بقاعها","نارُ الهدى فهشا إليها من عشا",11,"ش",2,0],["ومكارم تكفي السؤال وهيبة","تكفي روائع ذكرها أن تبطشا",11,"ش",2,0],["ومكارم ما لاح بشرك بارقاً","إلاَّ اسْتهلَّت للوفودِ غماما",12,"م",2,0],["ومكَّنْتُمُ أذقانَكُمْ من نُحوركُمْ","كأنَّكُمُ أولادُ يَحيَى بن خالدِ",13,"د",1,0],["وَمَكَرِّ مُعتَرَكٍ تَرَكنَ حُماتَهُ","لِلطَيرِ بَينَ سَوافِلٍ وَعَوالي",14,"ل",2,0],["وَمَكروهٍ عَلى أَخَذاتِ ظَنٍّ","تُحَبِّبُهُ إِلَيكَ التَجرُباتُ",15,"ت",1,0],["وَمَكانُ الكِتابِ يُغريكَ رَيّا","وَردِهِ غائِباً فَتَدنو لِلَمسِ",16,"س",1,0],["وَمُكَذِّبٍ بِالجِنِّ ريعَ لِصَوتِها","في الماءِ مُنحَدِراً وَفي التَيّارِ",17,"ر",1,0],["وَمَكانُ الإِمامِ أَعلى وَلَكِن","بِأَحاديثِهِ يَتيهُ الأَنامُ",18,"م",1,0],["وَمَكرُماتٍ مَشَت عَلى قَدَمِ ال","بِرِّ إِلى مَنزِلي تُرَدِّدُها",19,"د",3,0],["وَمَكارِمٌ مَعمورَةٌ بِصَنائِعٍ","فَكَأَنَّها مَمطورَةٌ بِسَحائِبِ",20,"ب",1,0],["وَمَكانِهِم مِن فارِسٍ حَيثُ التَقَت","غُرَرُ الجِيادِ تُعانُ بِالأَوضاحِ",21,"ح",1,0],["وَمَكَرٍّ شَهَدتَهُ فَغَدا قِر","نُكَ فيهِ مُغَلِّساً إِقعاصُه",22,"ص",2,0],["وَمُكايِدٍ لي بِالمَغيبِ رَمَيتُهُ","بِصَريمَةٍ كَالنَجمِ في مُنقَضِّهِ",23,"ض",2,0],["وَمَكرُمَةِ الدُنيا الَّتي لَيسَ دونَها","مُرادٌ وَلا عَن ظِلِّها مُتَحَوَّلُ",24,"ل",1,0],["وَمُكتَسِبٌ فِيَّ المَلامَةَ ماجِدٌ","يَرى الحَمدَ غُنماً وَالمَلامَةَ مَغرَم",25,"م",1,0],["وَمَكرُمَةٍ لَم يَبتَدِ القَومُ صَوغُها","وَلَم يَتَلافَوا مُبتَناها تَعَلُّما",26,"م",2,0],["وَمُكتَتِمُ التَدبيرِ لَيسَ بِظاهِرٍ","عَلى سِرِّهِ الرَأيُ الَّذي هُوَ تابِعُ",27,"ع",1,0],["وَمُكثِرَةٍ يا سَودَ وَدَّت لَوَ أَنَّها","مَكانَكِ وَالأَقوامُ عِندَ الضَرايِبِ",28,"ب",1,0],["وَمُكَبَّلٍ تَرَكَ الحَديدُ بِساقِهِ","أَثَراً مِنَ الرَسَفانِ في الأَحجالِ",29,"ل",1,0],["ومكارمٌ أنصَفتَ فيهِنَّ العُلى","وتركتَ مالَك بينها مَظْلوما",30,"م",2,0],["ومكارمٌ تُعْلي ذُرى أطوادِه","في الأزدِ أو تُذْكي سَنا أقمارِه",31,"ر",2,0],["ومَكارِماً يسعَى إليهنَّ المُنى","سعيَ الحجيجِ إلى الصَّفا والمَشْعَرِ",32,"ر",1,0],["ومكرُمةٌ لو غَدَتْ مُزنةً","لأيقنَ منها الثَّرى بالثَّراءِ",33,"ا",2,0],["ومكارمٌ بُذِلَتْ لِصَونِ نُفوسهِم","معدودةٌ بالفضلِ في الأَعدادِ",34,"د",1,0],["وَمُكَنّىً تَتوقُ نَفسي إِلَيهِ","بِالرَسولِ الكَريمِ بَعدَ المَسيحِ",35,"ح",1,0],["وَمَكارِماً عُتُقَ النِجارِ تَليدَةً","إِن كانَ هَضبُ عَمايَتَينِ تَليدا",36,"د",2,0],["ومَكاريٍّ ماطلْتُهُ","بِكِراه قال مُذكِّرا",37,"ر",2,1],["ومُكَرّرٍ سِحر اللَّواحِظِ أهيَفِ","قَلبِي بموسَى ناظِريهِ كَلِيمُ",38,"م",1,1],["ومكبّ على بنيه بوجهٍ","خلط الدمع بالثرى المنهال",39,"ل",1,0],["وَمَكرُمَةٍ عِندَ السَماءِ مُنيفَةٍ","تَناوَلَها مِنّي بِأَطوَلِ باعِ",40,"ع",1,0],["ومُكَلَّلٍ بالدُّرِّ من إفرِنْدِهِ","فيهِ أكالِيلٌ من الفُولاذِ",41,"ذ",1,1],["وَمُكلَّلاتُ بِالعُيو","نِ طَرَقنَنا وَرَجَعنَ مَلَسا",42,"س",2,1],["وَمِكسالُ الضُحى كَالري","مِ لا بَل تُشبِهُ البَدرا",43,"ر",2,0],["ومكرماتٍ مشت على قدم البر","ر إلى منزلي ترددها",44,"د",3,0],["ومكرتِ مكرَكِ يا حبيبةُ وانقضى","ليلي وأنتِ لديَّ ساهرةٌ معي",45,"ع",2,0],["ومَكانٍ عازِبٍ مِن جِيرَةٍ","أَصْدِقَاءٍ وهُم عَيْنُ العِدَا",46,"د",2,0],["وَمَكروبٍ كَشَفتُ الكَربَ عَنهُ","بِضَربَةِ فَيصَلٍ لَمّا دَعاني",47,"ن",2,0],["وَمكَارِمٌ تحْيِي المَكَارِمَ فِي الملاَ","كَالبَحْرِ مِنْهُ الصَّيِّبُ المِدْرَارُ",48,"ر",1,0],["وَمَكيدَةٍ أَشلى عَليكَ نُيوبِها","غَضبانُ لِلقُربى القَريبَةِ ناسِ",49,"س",1,0],["وَمُكبّراً مُذ كانَ لا صغرٌ بِهِ","وَمُطهّراً لَم يَدرِ ما التَدنيسِ",50,"س",1,0],["ومكفَّنٌ في مهده","يوم الولادة يُحْتَضَر",51,"ر",1,0],["ومكان عازب عن جيرة","أصدقاء وهم عين العدى",52,"د",2,0],["ومكابدٍ كَرْبَ المماتِ شركتَهُ","- إذْ لم تَحِدْ منجىً – عناءاً كارِبا",53,"ب",2,0],["ومكبْوتةٍ لم يشفَعِ الصَّفْحُ عندَها","مددتُ إليها مِنْ أناةٍ بشافِع",54,"ع",1,0],["وَمَكرُمَةٍ لمْ يَبْتَدِ القَوْمُ صَوْغَها،","وَلَمْ يَتَلاَفَوْا مُبْتغَاهَا تَعَلُّما",55,"م",2,0],["وَمُكتَسِبٌ في المَلامَةَ ماجِدٌ،","يَرَى الحَمدَ غُنْماً، والمَلاَمَةَ مَغرَمَا",56,"م",2,0],["ومكنة في رمال الخليج","وشبت عن يديك ، وأنت أختفت",57,"ت",1,0],["وَمَكاني مِن الفَخار مَكان","حَسدتهُ الشُموس وَالأَقمارُ",58,"ر",1,0],["ومكثت اقطع ليل انس لم يمل","نحو الكرى من وجده سهاره",59,"ر",2,0],["ومِكنَة عندى ذى العرش استقل بها","ورتبة دونها الجوزاءُ والأسد",60,"د",1,0],["وَمَكرٌ بِحَمدِ اللَهِ حاقَ بِأَهلِهِ","وَعارِضُ بَغيٍ قَبلَ أَن يُمطِرَ اِنجابا",61,"ب",2,0],["ومكانة طرف الحسود لها","وبنانه في الغض والعضّ",62,"ض",1,0],["ومكارمٍ غرٍّ وفضل باهر","ومناقبٍ طابت لطيبِ أَساس",63,"س",1,0],["ومكن من قطر وشم شوامخ","تطاها كما يطا الفتى شمل البرد",64,"د",1,0],["وَمَكارِمٌ تَرنو إِلى عَليائِها","عَينُ الحَسودِ وَقَلبُهُ مُغتاظُ",65,"ظ",1,0],["ومُكرِّرِ الزَّفَرَاتِ في مِحْرابه","يَقْرأ ويركع للإله ويسجد",66,"د",1,0],["ومكان يتأوا","ه ويرضيه مبيته",67,"ت",2,0],["وَمُكثِرٍ كانَ ذا مالٍ فَأَذهَبَهُ","تَفريقُ ما يُذهِبُ الأَموالَ فَاِفَتَقَرا",68,"ر",2,0],["ومكانةٌ في المجدِ أنتَ عَمَرْتَها","بعُلاكَ وهيَ من الأنامِ خَلاءُ",69,"ا",2,0],["ومكارماً تابعتَهنَّ كأنما","تقرا بهنَّ على الأنام كتابا",70,"ب",2,0],["وَمَكارما منك اِستَمَدَّ","جَمالها غَضّا وَنَضرا",71,"ر",2,0],["ومكتفيا فاعدد ومقتدراً وقد","تلا قاهراً راض لمتقي تلا",72,"ل",2,0],["ومكانهم وضعوا الكلاب بدلِّها","ما بين تقبيل ودفء عناق!!",73,"ق",1,0],["وَمَكارِم قد عمت الدنيا نَدى","وَهدى وأخرى أخرت للمحشر",74,"ر",1,0],["وَمَكثت في النيابَتين متيما","وَلَقَد رَضيت بأن أَعيش متيما",75,"م",2,0],["وَمكارم موصولة بمكارم","وَلطائف وَعَواطِف وَأَيادي",76,"د",2,0],["وَمَكِينَةٍ لَوْ أَمكَنَتْ زُحَلاً إِذاً","لَغَدا لَها مُتَرَشِّحاً مُتَعَرِّضا",77,"ض",2,0],["وَمَكْرَمَةٍ وَالَيْتَها وَصَنيعَةٍ","زَكَتْ لَكَ عِنْدِي حِدْثُها وَعَتِيقُها",78,"ق",3,0],["وَمكارمٍ لولاك لَم يطرق بها","سَمعٌ ولا كحل العيان بميسمِ",79,"م",1,0],["وَمُكابِرٌ إِحساسَهُ في أَنَّهُ","وَسِواهُ مِن أَضدادِهِ مَتَوَحِّدُ",80,"د",1,0],["وَمُكَلِّفٌ وَمُرَفَّهٌ وَمُبَصَّرٌ","وَمَبَصِّرٌ وَمُقَلِّدٌ وَمُقَلَّدُ",80