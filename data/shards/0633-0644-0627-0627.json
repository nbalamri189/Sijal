{"poems":[[3,"سلا القلب عما كان يهوى","https://www.aldiwan.net/poem128.html",""],[37,"عجبت لبرئي منك يا عز بعدما","https://www.aldiwan.net/poem39170.html","الطويل"],[82,"سلا أي سلواني أرى مصرع ابنه","https://www.aldiwan.net/poem31504.html","الطويل"],[107,"قل للألى رقدوا والعدل يقظان","https://www.aldiwan.net/poem42055.html","البسيط"],[119,"يا رفقتي كأسي حلا","https://www.aldiwan.net/poem40422.html","عموديه"],[119,"سلا القلب وجدي وهو للحب ما سلا","https://www.aldiwan.net/poem40424.html","عموديه"],[186,"جهد الحزين إذا صرف القضا نزلا","https://www.aldiwan.net/poem67038.html","البسيط"],[230,"أقصر فؤادي فما الذكرى بنافعة","https://www.aldiwan.net/poem55169.html","البسيط"],[285,"أخلاقه أحلى من الأمن","https://www.aldiwan.net/poem60560.html","السريع"],[409,"سلا إن مررتم عن فؤادي على سلع","https://www.aldiwan.net/poem33647.html","الطويل"],[412,"سلا أحبته من لم يذق كمدا","https://www.aldiwan.net/poem50103.html","البسيط"],[463,"أيقظني للبرقِ وهو نائم","https://www.aldiwan.net/poem55863.html","الرجز"],[482,"هو الدمع أضحى بالغرام يترجم","https://www.aldiwan.net/poem15192.html","الطويل"],[545,"سلا القلب إلا من تذكر ليلة","https://www.aldiwan.net/poem56883.html","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101045","الوافر"],[3477,"","https://poetry.dctabudhabi.ae/diwan/poem/132997","الطويل"],[3854,"","https://poetry.dctabudhabi.ae/diwan/poem/47370","المتقارب"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102755","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94548","الوافر"],[4363,"","https://poetry.dctabudhabi.ae/diwan/poem/121512","البسيط"],[5183,"هو العيد","https://www.poetsgate.com/ViewPoem.aspx?id=180231",""],[6270,"كأنما شمْعة الرقرَاق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69083&r=&rc=7",""]],"verses":[["سَلا القَلبُ عَمّا كانَ يَهوى وَيَطلُبُ","وَأَصبَحَ لا يَشكو وَلا يَتَعَتَّبُ",0,"ب",1,1],["سَلا القَلبُ عَن كِبراهُما بَعدَ حِقبَةٍ","وَلُقّيتُ مِن صُغراهُما اِبنَ بَريحِ",1,"ح",1,0],["سلا أيَّ سلواني أرَى مَصْرَعَ ابْنِهِ","وطالَ لفقد المالِ طولُ نياحهِ",2,"ه",1,1],["سلا المحبُّونَ فابتلَّتْ جوانحُهم","وما لهم عنه طولَ الدهرِ سُلوانُ",3,"ن",1,0],["سلا الغرام جسمه","وللغزال ما سلا",4,"ل",2,0],["سلا القلب وجدي وهو للحب ما سلا","عفا الله عن قلب اضر به القلا",5,"ل",2,1],["سَلا المحبُّونَ بَعدَ اليَأسِ فَاِتَّخَذوا","تِلكَ الشُجونُ إِلى سَلوانهم سُبُلا",6,"ل",2,0],["سلا الفُؤادُ الذي شاطَرتهُ زمناً","حملَ الصَبابَةِ فاِخفِق وَحدكَ الآنا",7,"ن",2,0],["سَلا الْعُذْرِيُّ عَمَّنْ باتَ يَهْوى","وَلَسْتَ عَنِ النَّدى يَوْماً بِسالِ",8,"ل",1,0],["سلا إن مررتم عن فؤادي على سلع","وقولا له طال الوقوف بذا الربع",9,"ع",1,1],["سَلا أَحِبَّتَه من لَم يَذُق كَمَدا","يَومَ الفِراقِ وَلَو أَذرى الدُموعَ دَما",10,"م",2,1],["سلا المحبّون وعندي زفرةٌ","عسراءُ لا تنقضها العزائمُ",11,"م",1,0],["سلا البانَ مِن نَعْمانَ هل لَعِبَتْ به","رياحُ صَباً يُحيا بها ويقوَّمُ",12,"م",1,0],["سَلا القَلبُ إِلّا مِن تَذَكُّرِ لَيلَةٍ","بِجَمعٍ وَأُخرى أَسعَفَت بالمُحَصَّبِ",13,"ب",1,1],["سلا ابن الخيبرية يوم وافى","وليث اللَه يرقبه رعاما",14,"م",2,0],["سَلا الدَّمعَ على قلبي المعذَّبِ هل سَلا","فما للسانِ الدمعِ أن يتقوَّلا",15,"ل",2,1],["سَلا الْخَلْقُ جَمْعاً عَن الْمَكْرُماتِ","وَأمّا الْعَمِيدُ فَصَبٌّ عَمِيدُ",16,"د",1,0],["سلا الركب عن قلبي الذي قد ترحلا","وعوجا نحى الرسم فالربع قد خلا",17,"ل",2,1],["سلا أهلوهُ أحزاناً وقهراً","وقد سرّوا بواليهم جمارى",18,"ر",2,0],["سلا المنازِلَ والأطلالُ والحلَلا","هل بعدَ سكانِها قلبي المشوقُ سلا",19,"ل",2,1],["سلا الراحلين التاركين أخاهما","وراءهما والدهر وعر وراؤه",20,"ا",3,0],["سلا أمن عمرها عمري الذي رحلا","أم أنني وترٌ منها بما انسبلا",21,"ل",2,1]]}