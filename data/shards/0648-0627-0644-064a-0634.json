{"poems":[[74,"والى شهي الرشف وقتا وفي","https://www.aldiwan.net/poem18959.html","السريع"],[15,"إن الحوادث قد يجيء بها الغد","https://www.aldiwan.net/poem45274.html","الكامل"],[190,"كلح الزمان إلى الورى","https://www.aldiwan.net/poem43983.html","مجزوء الكامل"],[435,"بسم السرور فسرت الأحياء","https://www.aldiwan.net/poem40833.html","الكامل"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105660","الكامل"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135731","الرجز"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44904","الخفيف"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81926","الخفيف"],[5573,"برد وسلام","https://www.poetsgate.com/ViewPoem.aspx?id=200218",""],[5582,"أَفْراحُ أَهْلِ الهَوَى فِي الهَجْرِ أَحْزانُ","https://www.poetsgate.com/ViewPoem.aspx?id=187308",""],[5848,"الى حال دون الباب","https://www.poetsgate.com/ViewPoem.aspx?id=48847",""],[5848,"حلم با الألوان","https://www.poetsgate.com/ViewPoem.aspx?id=53185",""],[5190,"للأرض وجهٌ آخر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78324&r=&rc=37",""]],"verses":[["وَالى شهيّ الرشف وقتاً وفي","وقتٍ له التحكيم والقهر",0,"ر",1,1],["وَإِلى شَراحيلَ الهُمامِ بِنَصرِهِ","نَصرَ الأَشاءَ سَرِيُّهُ مُستَرغَدُ",1,"د",1,0],["وإلى شكاية صاحب","والذم بعد مديحه",2,"ح",2,0],["وإلى شهامتك السنية إذ عنت","رتب العلى والهمة القعساءُ",3,"ا",2,0],["وإلى شهي حديثك الفتان","كلي بت أذنا صاغيه",4,"ه",1,0],["واليشبكيّ قرب دار العدل","في اليشبكية وريف الظل",5,"ل",1,0],["والي شهيد يا مبينُ برهانْ","رؤوف لا يضرّني إنسانْ",6,"ن",1,0],["وَإِلى شَعبيَ المَهيضِ جَناحاً","وَإِلى أُمةِ النَبِيِّ مُحَمَّدْ",7,"د",1,0],["وإلى شامخ النخيل فيطفي","نار قلبي بالسيسبانة ماء",8,"ا",2,0],["والي شكالك دمعته تشرح مدا الحزن السقيم","وأنت أعلم بحاله وشاكي حالته لك مايضام",9,"م",1,0],["وَاليَشْجُبِيُّ الَّذِي لَمْ يَرْقَ رُتْبَتَهُ","مِنْ غايَةِ المَجْدِ حَسَّانٌ وَنُعْمانُ",10,"ن",1,0],["والى شفت فوق الباب قفلٍ ومزلاج","أبرجع واقول الله علينا يفرجّها",11,"ج",3,0],["والى شعرت انه بلحظه رواني","اصب شعري في فناجيل الاوزان",12,"ن",1,0],["وإلى شريدٍ أرهقتهُ مسالكٌ","ورماه .. دون الناسِ .. حظٌّ عاثرُ",13,"ر",1,0]]}