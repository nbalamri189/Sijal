{"poems":[[89,"الفن روض أنيق غير مسؤوم","https://www.aldiwan.net/poem44743.html","البسيط"],[31,"تشط غدا دار جيراننا","https://www.aldiwan.net/poem42585.html","المتقارب"],[106,"يا راعي الفصحى","https://www.poetsgate.com/ViewPoem.aspx?id=179702",""],[31,"َلمِم بِجورٍ في الصِفاحِ حِسانِ","https://www.poetsgate.com/ViewPoem.aspx?id=23392",""],[117,"إلى البحرين","https://www.aldiwan.net/poem24039.html","الطويل"],[342,"شارد اللب والفكر","https://www.aldiwan.net/poem55314.html","مجزوء الخفيف"],[393,"قد ظل يجرح صدري","https://www.aldiwan.net/poem53660.html","المجتث"],[551,"أرني العجائب يا أباها","https://www.aldiwan.net/poem47144.html","مجزوء الكامل"]],"verses":[["لممت شمل الاغاني بعد تفرقة","لها فلم يبق شمل غير ملموم",0,"م",1,0],["لم منك نفسا اضاعت ويك فرصتها","ولا تعاتب على ما فاتك القدرا",0,"ر",2,0],["لَمِمّا شَقائي تَعَلَّقتُكُم","وَقَد كانَ لي عِندَكُم مَقعَدُ",1,"د",1,0],["لَمْ مأَلقَ إلا شاكرًا، أو حامدًا","مذ قيل: قيَّضَت العنايةُ حامدًا",2,"د",2,1],["َلمِم بِجورٍ في الصِفاحِ حِسانِ","هَيَّجنَ مِنكَ رَوائِعَ الأَحزانِ",3,"ن",1,1],["لِمَمْلَكةِ البَحرينِ شَعْبًا ودَولةً","حَمَلْتُ أَرِيجِيَّ النَّسِيمِ يَمانِيا",4,"ي",2,0],["لمَ ما لي نظيرها","لمَ أسعى فأندحر",5,"ر",1,0],["لَمَمتُ عَقدَ مَديحٍ","يُزَفُّ في عِقدِ شِعر",6,"ر",1,0],["لِمْ ملّها من غير جُر","مٍ كان منها لِمْ قَلاها",7,"ا",3,0]]}