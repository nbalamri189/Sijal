{"poems":[[91,"الفن روض أنيق غير مسؤوم","https://www.aldiwan.net/poem44743.html","البسيط"],[33,"تشط غدا دار جيراننا","https://www.aldiwan.net/poem42585.html","المتقارب"],[108,"يا راعي الفصحى","https://www.poetsgate.com/ViewPoem.aspx?id=179702",""],[33,"َلمِم بِجورٍ في الصِفاحِ حِسانِ","https://www.poetsgate.com/ViewPoem.aspx?id=23392",""],[121,"إلى البحرين","https://www.aldiwan.net/poem24039.html","الطويل"],[347,"شارد اللب والفكر","https://www.aldiwan.net/poem55314.html","مجزوء الخفيف"],[398,"قد ظل يجرح صدري","https://www.aldiwan.net/poem53660.html","المجتث"],[556,"أرني العجائب يا أباها","https://www.aldiwan.net/poem47144.html","مجزوء الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72345","الكامل"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105426","الخفيف"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106887","السريع"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86529","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139490",""],[4978,"تحية لأستاذتي نادية بوغرارة","https://www.poetsgate.com/ViewPoem.aspx?id=189774",""],[5561,"حُكْمُ القضاء","https://www.poetsgate.com/ViewPoem.aspx?id=192908",""],[5751,"مممم فيسبوكية","https://www.poetsgate.com/ViewPoem.aspx?id=215027",""],[5956,"ذَبُلَ الحب الكبير","https://www.poetsgate.com/ViewPoem.aspx?id=182133",""],[6355,"بلاد قتلت صبراً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66617&r=&rc=77",""]],"verses":[["لممت شمل الاغاني بعد تفرقة","لها فلم يبق شمل غير ملموم",0,"م",1,0],["لم منك نفسا اضاعت ويك فرصتها","ولا تعاتب على ما فاتك القدرا",0,"ر",2,0],["لَمِمّا شَقائي تَعَلَّقتُكُم","وَقَد كانَ لي عِندَكُم مَقعَدُ",1,"د",1,0],["لَمْ مأَلقَ إلا شاكرًا، أو حامدًا","مذ قيل: قيَّضَت العنايةُ حامدًا",2,"د",2,1],["َلمِم بِجورٍ في الصِفاحِ حِسانِ","هَيَّجنَ مِنكَ رَوائِعَ الأَحزانِ",3,"ن",1,1],["لِمَمْلَكةِ البَحرينِ شَعْبًا ودَولةً","حَمَلْتُ أَرِيجِيَّ النَّسِيمِ يَمانِيا",4,"ي",2,0],["لمَ ما لي نظيرها","لمَ أسعى فأندحر",5,"ر",1,0],["لَمَمتُ عَقدَ مَديحٍ","يُزَفُّ في عِقدِ شِعر",6,"ر",1,0],["لِمْ ملّها من غير جُر","مٍ كان منها لِمْ قَلاها",7,"ا",3,0],["لمم بنور الدين","واعلمه بهاتيك القضية",8,"ي",2,0],["لم مينة النفس إن نأى عن سواد ال","عين لم ينأ عن سويد الفؤاد",9,"د",1,0],["لممت أشعاثهم فاغتدوا","وليس فهم بك نكسٌ لئيم",10,"م",1,0],["لمملكة الهلال نريد عزّاً","نشيده على ركنٍ ركين",11,"ن",1,0],["لمم الذنوب كأنما أمواله","وندى يديه مستجاب دعاء",12,"ا",2,0],["لمَمْتِ للمنتدى شملا وجُدت بما","حباك ربك من خير وتوجيه",13,"ي",2,0],["لَمَمْتُ همومَ القلبِ عنكِ ترحُّما","فحبُّكِ باقٍ في الفؤادِ يجوب",14,"ب",1,0],["لممّكِ قلبي يرنّ غراما","ويسجد حبا عليه تسامى",15,"م",2,1],["لمَ منك الحب هذا","لا يرى وجه السرورْ؟",16,"ر",1,0],["لمَ مَلَّتْ صوتك النفسُ وضَاقتْ بك ذرْعا؟","أين للنصر نجومٌ سطعتْ في الأفقِ زُهرا؟",17,"ر",2,0]]}