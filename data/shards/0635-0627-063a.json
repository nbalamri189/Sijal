ف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139623",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139749",""],[4679,"من مجيري من سهام المقلِ","https://www.poetsgate.com/ViewPoem.aspx?id=142747",""],[4767,"صفحة الخير","https://www.poetsgate.com/ViewPoem.aspx?id=125022",""],[4868,"عمان في عيدها الوطني","https://www.poetsgate.com/ViewPoem.aspx?id=178425",""],[4896,"وحشة الليل","https://www.poetsgate.com/ViewPoem.aspx?id=180896",""],[4927,"عدوية","https://www.poetsgate.com/ViewPoem.aspx?id=80805",""],[4119,"نافرته البيضاء في البيضاء","https://www.poetsgate.com/ViewPoem.aspx?id=16048",""],[5038,"رحماك خذني","https://www.poetsgate.com/ViewPoem.aspx?id=195431",""],[5106,"يَا مِسْكَةَ العَرَبِ ..","https://www.poetsgate.com/ViewPoem.aspx?id=154846",""],[5155,"أين الفتى السياب!؟","https://www.poetsgate.com/ViewPoem.aspx?id=176271",""],[5183,"فتاة النيل","https://www.poetsgate.com/ViewPoem.aspx?id=185689",""],[5219,"حرف ذو شجون","https://www.poetsgate.com/ViewPoem.aspx?id=194086",""],[5277,"حادي الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=190988",""],[5281,"ليلة المعراج","https://www.poetsgate.com/ViewPoem.aspx?id=199707",""],[5409,"خسرتك البلادُ ركنا قويا","https://www.poetsgate.com/ViewPoem.aspx?id=155487",""],[5431,"ولكن ربّة الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=197908",""],[5431,"تونس الحب...","https://www.poetsgate.com/ViewPoem.aspx?id=198948",""],[5542,"مادلين اولبرايت","https://www.poetsgate.com/ViewPoem.aspx?id=10194",""],[5596,"إلى ابن مكتوم","https://www.poetsgate.com/ViewPoem.aspx?id=206174",""],[5596,"مجلس الدولة","https://www.poetsgate.com/ViewPoem.aspx?id=206753",""],[5605,"اللَّعُوبُ","https://www.poetsgate.com/ViewPoem.aspx?id=204566",""],[2110,"صرف راح ما مسها كف عاصي","https://www.poetsgate.com/ViewPoem.aspx?id=156276",""],[5644,"دلل فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=207324",""],[5691,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=207079",""],[5722,"الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=12682",""],[5751,"أنثى الماس","https://www.poetsgate.com/ViewPoem.aspx?id=214776",""],[5956,"يستشرف ابني بالحِجى المستقبَلا","https://www.poetsgate.com/ViewPoem.aspx?id=193298",""],[4442,"فقه الشريعة أول","https://www.poetsgate.com/ViewPoem.aspx?id=171209",""],[4442,"أنفت أن تميس إلا دلالا","https://www.poetsgate.com/ViewPoem.aspx?id=171224",""],[4442,"نزعت تخط بكل نفنف","https://www.poetsgate.com/ViewPoem.aspx?id=171225",""],[6075,"الأميرة والفتى العاشق","https://www.poetsgate.com/ViewPoem.aspx?id=213306",""],[5051,"يا عنترة !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87708&r=&rc=2",""]],"verses":[["صاغَ قَلبي لَكِ حُباً مِن ذَهَب","لَم أَشُب يا سِحرُ صِدقي بِالكَذِب",0,"ب",1,1],["صَاغَ لِي غَانِمٌ لآلِيءَ وَالغَانِمُ","مَنْ زَانَهُ بِتِلْكَ الَّلآلِي",1,"ل",2,0],["صاغنا ثم قاتنا ووَقانا","بالتي نتَّقي بها الأَسواءَ",2,"ا",2,0],["صاغها صائغٌ من الجن لا الإنْ","س يروغ بِكرَ الكلام نَكوتُ",3,"ت",1,0],["صاغه صَوَّاغُه صِيَغاً","بِدَعاً لم تُلقَ في خَلَدِ",4,"د",1,0],["صاغَكِ اللَهُ شُعلَةً مِن ضِياءٍ","وَبَرا المَرءَ شُعلَةً مِن ذَكاءِ",5,"ا",2,0],["صاغَ مِنها الرَبيعُ شَكلاً لِأَخلا","قِ حُسَينٍ ذي الجودِ وَالإِحسانِ",6,"ن",1,0],["صاغَ المِزاجُ لَها فَواقِعَ فِضَّةٍ","مِثلَ اللَآلي وَهيَ تِبرٌ مُخلَصُ",7,"ص",1,0],["صاغَهُمُ ذو الجَلالِ مِن جَوهَرِ المَج","دِ وَصاغَ الأَنامَ مِن عَرَضِه",8,"ض",2,0],["صَاغَ الْقَرِيضَ بِإِتْقَانٍ فَلَوْ تُلِيَتْ","صُدُورُهُ عُلِمَتْ مِنْهَا قَوَافِيهِ",9,"ف",3,0],["صاغَ المِزاجُ لَها مِثالَ زَبَرجَدٍ","مُتَأَلِّقٍ بِبَدائِعِ الأَضواءِ",10,"ا",2,0],["صاغَهُ رَبُّهُ عَلى الجودِ وَالحِل","مِ وَما شِئتَ مِن حَياءٍ وَخَيرِ",11,"ر",1,0],["صاغَ النّهارُ حُجُولَهُ فكأنّما","قَطعتْ له الظّلماءُ ثوبَ الأدهَمِ",12,"م",1,0],["صاغَتهُ من آمالِها ودمائها","وأجلّهُنَّ دمُ الشباب المهْرَقُ",13,"ق",1,0],["صاغك الله للجمال بقلب","معرض عن نصيحة ليس يصغي",14,"غ",2,1],["صَاغَتِ الفِطْنَةُ البَديعَةُ فِيه","أَنْفَسَ الدُّرِّ فِي قَلائِدِ تِبْرِ",15,"ر",1,0],["صَاغَ مَا صَاغَهُ مُقِلاًّ مُجِيداً","شَأْنُ مَنْ يَنْتَقِي فَرِيدَ الدُّرِّ",15,"ر",1,0],["صاغَتْ سَوَائِرُهُ لَهُمْ","تَاجَيْنِ مِنْ مَجْدٍ وَخُلْدِ",16,"د",1,0],["صاغه الله من نَدًى، وظِلاَل","يشبه الروضُ زهرَهُ، وغصونه",17,"ن",2,0],["صاغته مصرُ فلم تصُغه معدنا","بل كان من أهرامها مقدودا",18,"د",2,0],["صاغوا لك الشعرَ من زهر ونُوارِ","وصغتُه لك من حانوت خَمَّار",19,"ر",1,1],["صاغه الخير من الخير لبابا واصطفاه","معرق الأمجاد والأنساب ، طابت نبعتاه",20,"ا",2,0],["صاغ الهلال لتاج الملك لؤلؤة","وأنجم اللّيل ياقوتا ومرجانا",21,"ن",2,0],["صاغ الاكابر بالنظام علومهم","وتنوعت بشؤُنها الافهام",22,"م",1,1],["صاغوا وسامك بعدَ أن","قدَروكَ يا مطرانُ قَدركْ",23,"ك",1,0],["صاغها ربُّها لتكوين رأي","من جميع القرى وتكوين مال",24,"ل",1,0],["صاغَ الغَمامُ لَها عُيُونَ جَوَاهِرٍ","وَأَجَادَ جَلْوَتَها لِعَيْنِ المُجْتَلي",25,"ل",2,0],["صاغ لما قلنا وعاء زانه","والسيف بالحلية يسمو قدره",26,"ر",2,0],["صاغَ الحُلى للعُلا أيامَ دَولتِهِ","حتىّ سلكنَ الشّوى منهنّ في مسكِ",27,"ك",1,0],["صاغها اللهُ كالنسيمِ فلا غر","وإذا ما النسيمُ حلّ جنانهْ",28,"ن",2,0],["صاغه الله نباتا حسنا","ورعاه من نبات وكلا",29,"ل",2,0],["صاغني ذو العُلاَ حسنٍ","لوحيد الدنيا العزيز نزار",30,"ر",1,0],["صاغني الله واصطفانيَ لمَّا","صاغني فَرْدة الجَمَال لِفَرْد",31,"د",1,0],["صاغَ لها المَزْجُ حين شِيبَتْ","نَطاقَ دُرّ من الحَبَابِ",32,"ب",1,0],["صَاغُوا مُبَالَغَةً لِجَرْيِهِمُ","فِي الْفَضْلِ فَعَّالاً مِنَ الْجَرْيِ",33,"ي",1,0],["صاغه الضيغم الّذي","في الوغى غالِبُ العدا",34,"د",2,0],["صاغَهُ الخالِقُ الَّذي إِن يُرِد شَي","ئاً يَكُن مِنهُ بَينَ كافٍ وَنونِ",35,"ن",1,0],["صاغَتهُ قَريحَةُ ذي نَهَل","مِن جَورِ الدَهرِ وَذي عَلَلِ",36,"ل",1,0],["صاغَت بِهِ الأَيدي أَكُفّاً مِن يَوا","قيتٍ نُظِمنَ فَحَبَّذا المَنثورُ",37,"ر",1,0],["صَاغَت لَهُ كَيمِياءُ الجودِ إِذ وَرَدَت","مِنهَا نُضاراً وَكَانَت قبلَهَا كُتُبا",38,"ب",2,0],["صاغَ بِرّاً وصُغْتُ شُكْراً ولكنْ","ظَلَّ قَولي لفِعْلِه يَتَقَفّى",39,"ف",2,0],["صاغت لكم آلاؤها من ربِّكم","دون الأنام قلائداً وعقودا",40,"د",2,0],["صاغَ البَيان عُقودَها وَأَجادَها","فَغَدَت تَغير قَلائد الأَجياد",41,"د",1,0],["صاغ من جهله كتاباً تراءَى","فيه إِبليسُ صاحباً وقَرينا",42,"ن",2,0],["صاغها ملحمةً قُدسيَّةً","ذكَّرتنا بشموخ الفاتحين",43,"ن",1,0],["صاغه الله لقوم أرباً","ولقومٍ حَسَدوه عطبا",44,"ب",2,0],["صاغها فِكْرُ عَلِيٍّ","صاغَها فِكْرُ عَلِيمِ",45,"م",1,0],["صاغه اللّه من عناصر جود","وسقاه الإحسان كاسا طهورا",46,"ر",2,0],["صاغ لك الأفقَ ذاتَ طوقٍ","هلالها بين كوكبينِ",47,"ن",1,0],["صاغها الأصيل حلى","عسجديّة ذهبا",48,"ب",2,0],["صاغَها عسجَداً ورصّع دُرّاً","في حَشاها وبالحَريرِ كَساها",49,"ا",3,0],["صاغه فيك خبير لم يزل","حاذقاً في نظم در بدد",50,"د",1,0],["صاغوا عقودَ مدائحٍ وأنا الذي","قد صُغتُ من حَبَّاتِ قلبىَ جوهرا",51,"ر",2,0],["صاغَ القلائدَ للأَعناقِ نائلهُ","وبالمدائِح صاغ النَّاسُ أَشْنَاقا",52,"ق",2,0],["صَاغَتْ عِبارتُهُمْ حُسْنَ البديع بها","مِنَ البلاغَةِ في أَسْنى القَوالِيبِ",53,"ب",1,0],["صاغت لك الناس أكليلا لتهديه","لعالم فضله في العالم اشتهرا",54,"ر",2,0],["صاغت لنا درر الألفاظ تنظمها","عقداً علا بمعانيهِ على الشُّهُبِ",55,"ب",1,0],["صاغت لنا من نفيسِ الشعرِ أَحسنهُ","نظماً واجوَدَهُ في المدح والحِكَمِ",56,"م",1,0],["صاغها الفكر من نضار فللنا","ظر فيهن نظرة وسرور",57,"ر",1,0],["صاغَ فيها آذارُ هذا صنوفاً","لم يَصُغها آذارُ ذاك الماضي",58,"ض",2,0],["صَاغ آذرْيُونُها إذ","صاغ من تبر ثراها",59,"ا",3,0],["صاغه صائغُ الملاحةِ من ما","ءٍ ولكنَّ خدَّهُ من رحيق",60,"ق",1,0],["صاغَها اللَّه مِنَ الحُسنِ وَصَانْ","حُسنَها عَن أَن يُضاهى بِمِثالْ",61,"ل",1,0],["صاغَت بَلاغَتُهُ البَيانَ جُمانةً","في حُسنِها ماءُ اللَّطافَةِ مودَعُ",62,"ع",1,0],["صاغت أناملهم بأعناق الورى","أطواق فضل لا تُقدّ مدى الحقبْ",63,"ب",1,0],["صاغ الغمامُ من الندى","درراً بأجياد البَهارْ",64,"ر",1,0],["صاغ الندى في رقاب","الأحرار طَوقاً وعِقدا",65,"د",2,0],["صاغت أناملُهُ بأجياد الورى","دُرراً فلا زالت تضيءُ بحمده",66,"د",2,0],["صاغه الله من بهاء ونور","فغدا كاملا جليلا جميلا",67,"ل",2,0],["صاغَتْ شِبَاكَ حَبَابِهَا مِنْ لُؤْلؤٍ","لِتَصِيدَ بِالأحْدَاقِ وَالأقْداحِ",68,"ح",1,0],["صاغه الله قبل كل وجود","من جمال ومن جلال ونور",69,"ر",1,0],["صَاغَ المِزَاجُ لها حَبَاباً فاغْتَدَتْ","شَرَكَ العُقُولِ وحَيْرَةَ الأفْهامِ",70,"م",1,0],["صَاغَ لَهَا بِالْمِزَاجِ تَاجًا","ثُمَّ لَهَا بِالْحَبَابِ قَلَّدْ",71,"د",1,0],["صاغه الله قبل كل وجود","من جمال وعزة ورشاد",72,"د",1,0],["صاغه الله عين كل جمال","وكساه محبة ووقارا",73,"ر",2,0],["صاغت لَها شَمس الأَصيل سوارها","يا حسنه مِن عسجد في عَسجد",74,"د",1,0],["صاغتك آيات العلى","صدفاً وجعفر فيك درا",75,"ر",2,0],["صاغَت لأوساطِ الوِهادِ مناطقاً","منها وتيجاناً لهاماتِ الرُّبا",76,"ب",2,0],["صاغَكَ اللَهُ أَبا دُلَفٍ","صِبغَةً في الخَلقِ مِن خِيَرِه",77,"ر",2,0],["صاغَهُ اللَهُ مُطعِمَ الناسِ في الأَر","ضِ وَصاغَ السَحابَ لِلإِسقاءِ",78,"ا",2,0],["صاغها بدرا وصوّرها","مخرج الأشيا من العدم",79,"م",1,0],["صاغ كلتيهما بقدرتِه الصا","ئغُ من نورِه وقال أنيرا",80,"ر",2,0],["صاغَ الهوى بين الجفون عُقودا","فتناثرتْ فوقَ الخدودِ وُرودا",81,"د",2,0],["صاغته فكرة سار","إلى العلى غير سالي",82,"ل",2,0],["صاغ النشاط طباقاً في معاطفها","لما تبين أن الردف في كسل",83,"ل",1,0],["صاغ فيها من اللجين عموداً","ساق للحور لؤلؤاً منثورا",84,"ر",2,0],["صاغ السوارَ لها الهلالُ وطَوَّقَت","ذاتُ البروج بنانَها بسهاها",85,"ا",3,0],["صاغه ضامر الحشا","ناعم الكف والقدم",86,"م",1,0],["صاغه الله شمس نور تجلّت","تحفة الخلق الشرعة البيضاء",87,"ا",2,0],["صاغ الجمالَ جبيناً منكِ فازدَهَرَت","بالحُسنِ آياتُهُ في وجهكِ النَّضِرِ",88,"ر",1,0],["صَاغَ النُّحَاةُ اللَّفظَ وَقتَ نَباتِهِ","وَظَلِلتَ تُصلحُ فيه حتى نَوَّرَا",89,"ر",2,0],["صاغَ الجمالُ جبينها مُتعبداً","فأتى كبسمِ اللَه في العنوانِ",90,"ن",1,0],["صاغها الفكر والبيان فجاءت","نزهة للقلوب والابصار",91,"ر",1,0],["صَاغَتْ مِن الَّليلِ أطرَافاً لِهَيكَلِهَا","وَمِن حُلى الشَّمْسِ حَلياً حين تحتَجبُ",92,"ب",1,0],["صَاغَ الإمَامُ العَالِمُ ابْنُ الحَاجِبُ","دُرَراً مَعَانيهَا كَغَمزِالحَاجِبِ",93,"ب",1,1],["صاغ الجميع لكم من عمق مهجتهم","تاجا من الحب يزهو ملء دنيانا",94,"ن",2,0],["صاغُوهُ مِن سامِ النُضارِ لِماجِدٍ","كَفّاهُ حَربٌ مُنذُ كانَ لِسامِهِ",95,"م",2,0],["صاغَ النسيمُ له وسَيْفُ العيِّ قد","سَلَّتْهُ يومئذٍ يمينُ الغَيْهَبِ",96,"ب",1,0],["صاغ فيك النور من تسليمه","في صلاة الحب دراً رصعك",97,"ك",1,0],["صاغَها الرحمنُ منه بضعةً","فإذا 