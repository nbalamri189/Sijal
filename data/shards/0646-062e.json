{"poems":[[53,"نخطو وما خطونا إلا إلى الأجل","https://www.aldiwan.net/poem29884.html","البسيط"],[53,"مسيري إلى ليل الشباب ضلال","https://www.aldiwan.net/poem29909.html","الطويل"],[53,"أراك ستحدث للقلب وجدا","https://www.aldiwan.net/poem30614.html","المتقارب"],[63,"رنا وناظره بالسحر مكتحل","https://www.aldiwan.net/poem46198.html","البسيط"],[93,"حي الكنانة غدوة استقلالها","https://www.aldiwan.net/poem11126.html","الكامل"],[93,"لم يخطيء التوفيق صاحبه","https://www.aldiwan.net/poem11208.html","أحذ الكامل"],[4,"طلل لخولة بالرسيس قديم","https://www.aldiwan.net/poem21193.html","الكامل"],[47,"نفى النوم عن عيني خيال مسلم","https://www.aldiwan.net/poem25134.html","الطويل"],[47,"إن زرت خرشنة أسيرا","https://www.aldiwan.net/poem25260.html","مجزوء الكامل"],[51,"عزاؤك أن الدهر ذو فجعات","https://www.aldiwan.net/poem8699.html","الطويل"],[29,"دعاني امرؤ أحمى على الناس عرضه","https://www.aldiwan.net/poem6058.html","الطويل"],[85,"مرحبا بالربيع في ريعانه","https://www.aldiwan.net/poem62943.html","الخفيف"],[45,"تفتأ عجبا بالشيء تدكره","https://www.aldiwan.net/poem63626.html","المنسرح"],[45,"سقى دار ليلى حيث حلت رسومها","https://www.aldiwan.net/poem65675.html","الطويل"],[28,"نظر الدلهمس نظرة ما ردها","https://www.aldiwan.net/poem5252.html","الكامل"],[66,"نعم لقلوب العاشقين عيون","https://www.aldiwan.net/poem38477.html","الطويل"],[105,"أعدوا لأعلام البيان المنابرا","https://www.aldiwan.net/poem42086.html","الطويل"],[105,"أميطي الغيب وادرعي الشهودا","https://www.aldiwan.net/poem42134.html","الوافر"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[105,"أمن صلف صدودك أم دلال","https://www.aldiwan.net/poem43412.html","الطويل"],[39,"يا دار أقوت بعد أصرامها","https://www.aldiwan.net/poem53746.html","السريع"],[75,"كذب السلو العشق أيسر مركبا","https://www.aldiwan.net/poem69104.html","الكامل"],[48,"ما لي بدار خلت من أهلها شغل","https://www.aldiwan.net/poem64514.html","البسيط"],[46,"نخشى السعير ودنيانا وإن عشقت","https://www.aldiwan.net/poem22536.html","البسيط"],[46,"صنعة عزت الأنام بلطف","https://www.aldiwan.net/poem22771.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85359","المجتث"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/1673","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67357","المتقارب"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67325","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43800","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54229","الكامل"],[106,"فيلسوف الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=179354",""],[106,"أعياد النصر","https://www.poetsgate.com/ViewPoem.aspx?id=179343",""],[90,"شدة لندن!..","https://www.poetsgate.com/ViewPoem.aspx?id=179068",""],[39,"أعرفتَ ربعاً غيرَ آهلْ","https://www.poetsgate.com/ViewPoem.aspx?id=4267",""]],"verses":[["نَخطو وَما خَطوُنا إِلّا إِلى الأَجَلِ","وَنَنقَضي وَكَأَنَّ العُمرَ لَم يَطُلِ",0,"ل",1,1],["نَخِفُّ عَلى ظَهرِ الثَرى وَبُطونُهُ","عَلَينا إِذا حَلَّ المَماتُ ثِقالُ",1,"ل",1,0],["نُخالِسُها مِن خِلالِ القَنا","سَلاماً وَنَعلَمُ أَن لا تَرُدّا",2,"د",2,0],["نخْشى عُيونَ العِدا يَعتادُها شَوَسٌ","تَكادُ مِنْ وَقَداتِ الحِقْدِ تَشتَعِلُ",3,"ل",1,0],["نُخَبٌ مِنَ النخَبِ الأَعِزَّةِ عُوجِلَتْ","مِنْ أَجْلِ هَذَا اليَوْمِ فِي آجَالِهَا",4,"ل",3,0],["نُخْبٌ مِنَ الزُّعَمَاءِ ضَمَّهُمُ","عِقْدٌ فَضَمَّ الزَّمَنِ",5,"ن",1,0],["نَخلٌ كَوارِعُ في خَليجِ مُحَلِّمٍ","حَمَلَت فَمِنها موقِرٌ مَكمومُ",6,"م",1,0],["نَخِفُّ إِذا ضاقَت عَلَينا أُمورُنا","بِأَبيَضِ وَجهِ الرَأيِ وَالخَطبِ مُظلِمُ",7,"م",1,0],["نَختارُ مِنهُ الغادَةَ ال","حَسناءَ وَالظَبيَ الغَريرا",8,"ر",2,0],["نُخلِّف مأمولاتنا وكأننا","نسيرُ إليها لا إلى الغَمراتِ",9,"ت",1,0],["نَخَستَ بِيَربوعٍ لِتُدرِكَ دارِماً","ضَلالاً لِمَن مَنّاكَ تِلكَ الأَمانِيا",10,"ي",2,0],["نَخلَةٌ لا تَزالُ في الشَرقِ مَعنىً","مِن بَداواتِهِ وَمِن عُمرانِه",11,"ن",2,0],["نُخيلُ حَتّى نَرى النَجاحَ عَلى","ظاهِرِ بِشرٍ مُبينَةٍ بُشَرُه",12,"ر",2,0],["نُخَبِّرُ عَن تِلكَ الخَوارِجِ أَنَّهُ","هَوى مُكرَهاً تَحتَ السُيوفِ عَظيمُها",13,"م",3,0],["نَخلٌ يَكادُ ذُراهُ مِن قِنوانِهِ","بِذُريعَتَينِ يُميلُهُ الإيقارُ",14,"ر",1,0],["نَخِيٌّ لَهُ العَزمُ الشَديدُ مُصاحِبٌ","سَخِيٌّ لَهُ الرَأيُ السَديدُ قَرينُ",15,"ن",1,0],["نُخادِعُ أحزانَ النّفوسِ ونَدّعي","من الصبرِ ما يُفني القُوى والعناصرا",16,"ر",2,0],["نَخُصُّكِ بالوَلاءِ المحضِ منّا","ونُؤثرُ بالهَوى الشّعبَ الوَدودا",17,"د",2,0],["نخاف الواحدَ القهّارَ فيها","ونَرقُبُ وعدَه حتّى يحينا",18,"ن",2,0],["نَخونُ بِلادَنا وَنَنامُ عَنها","وَنَخذُلُها لَدى النُوَبِ الثِقالِ",19,"ل",1,0],["نَخلُ القُرى شالَت مَراجيحُهُ","بِالوِقرِ فَاِنزالَت بِأَكمامِها",20,"م",3,0],["نُخبَتْ قَوافي الشعرِ فيك فما لها","لم تأتِ من مدحِ الملوكِ الأوجَبا",21,"ب",2,0],["نَخلٌ إِذا جُلِيَت إِبّانَ زينَتِها","لاحَت بِأَعناقِها أَعذاقُها النُحُلُ",22,"ل",1,0],["نَخشى السَعيرَ وَدُنيانا وَإِن عُشِقَت","مِثلُ الوَطيسِ تَلَظّى مِلؤُهُ سُعُرُ",23,"ر",1,1],["نَخبِطُ اللَيلَ وَالبَوازِلُ كا","لخُمَّسِ ريعَت مِنَ البُزاةُ البَوازي",24,"ي",1,0],["نَخشى المنون وَشرٌّ","من المنون الهوان",25,"ن",1,0],["نَخافُ لَها إِمّا مُسِرّاً شَناءَةً","وَإِمّا شَتيماً ذا مُجاهَرَةٍ وَردا",26,"د",2,0],["نخبَةٌ قلَّمَا أَتِيحَ لِعَصْرٍ","مِثل مَجْمُوعِهِمْ مِنَ الأفْرَادِ",27,"د",1,0],["نُخْصُّ بما كَانَ مِنْ فَضْلِهِ","وَكَانَ سِرَاجاً لَنَا فِي الدُّجَى",28,"ا",1,0],["نُخَيّرُهَا وَلَوْ نَطَقَتْ لَقَالَتْ","قواطِعُهُنَّ دوساً أو ثَقيفَا",29,"ف",2,0],["نَختالُ فَوقَ الخَيلِ في ظَلَلِ القَنا","أسداً وَقَد وَقَدَ الغداةَ وَطيسُ",30,"س",1,0],["نَخْتَالُ بَيْنَ هِبَاتِهِ","في ظِلِّ إِحْسَانٍ وَجُودِ",31,"د",1,0],["نخلةٌ دَبَّتْ عليها نَمْلَةٌ","وَخضَمٌ فيه نَقَّتْ ضِفْدَعه",32,"ع",2,0],["نخوض الحروب إذا أُوقِدَتْ","وإن نكُ نكره إيقادها",33,"د",3,0],["نَخر الجهل أُمّتي نخرة السوس","فأينَ المجامعُ العلميه",34,"ي",2,0],["نَ خِلاَلَ ذِي قَطَنٍ فَحَامِلْ","وَصَغَا العَشِيُّ، وَبَانَ أَلْ",35,"ل",1,0]]}