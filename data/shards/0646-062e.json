ِينِي !!","https://www.poetsgate.com/ViewPoem.aspx?id=183607",""],[199,"ما هاجَ شوقكَ من مغاني دمنة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=20777",""],[6124,"يا نفس","https://www.poetsgate.com/ViewPoem.aspx?id=159910",""],[6124,"فاضت على الأرض","https://www.poetsgate.com/ViewPoem.aspx?id=201227",""],[6177,"الهجير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79065&r=&rc=12",""],[6189,"شهادة حياة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83554&r=&rc=21",""],[6213,"أفي السلم نحيا!!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76302&r=&rc=50",""],[6225,"شراع وريح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80914&r=&rc=183",""],[5567,"وسواس الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81769&r=&rc=37",""],[6355,"عام رحل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66623&r=&rc=83",""],[6359,"نخلة الوادي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69091&r=&rc=5",""]],"verses":[["نَخطو وَما خَطوُنا إِلّا إِلى الأَجَلِ","وَنَنقَضي وَكَأَنَّ العُمرَ لَم يَطُلِ",0,"ل",1,1],["نَخِفُّ عَلى ظَهرِ الثَرى وَبُطونُهُ","عَلَينا إِذا حَلَّ المَماتُ ثِقالُ",1,"ل",1,0],["نُخالِسُها مِن خِلالِ القَنا","سَلاماً وَنَعلَمُ أَن لا تَرُدّا",2,"د",2,0],["نخْشى عُيونَ العِدا يَعتادُها شَوَسٌ","تَكادُ مِنْ وَقَداتِ الحِقْدِ تَشتَعِلُ",3,"ل",1,0],["نُخَبٌ مِنَ النخَبِ الأَعِزَّةِ عُوجِلَتْ","مِنْ أَجْلِ هَذَا اليَوْمِ فِي آجَالِهَا",4,"ل",3,0],["نُخْبٌ مِنَ الزُّعَمَاءِ ضَمَّهُمُ","عِقْدٌ فَضَمَّ الزَّمَنِ",5,"ن",1,0],["نَخلٌ كَوارِعُ في خَليجِ مُحَلِّمٍ","حَمَلَت فَمِنها موقِرٌ مَكمومُ",6,"م",1,0],["نَخِفُّ إِذا ضاقَت عَلَينا أُمورُنا","بِأَبيَضِ وَجهِ الرَأيِ وَالخَطبِ مُظلِمُ",7,"م",1,0],["نَختارُ مِنهُ الغادَةَ ال","حَسناءَ وَالظَبيَ الغَريرا",8,"ر",2,0],["نُخلِّف مأمولاتنا وكأننا","نسيرُ إليها لا إلى الغَمراتِ",9,"ت",1,0],["نَخَستَ بِيَربوعٍ لِتُدرِكَ دارِماً","ضَلالاً لِمَن مَنّاكَ تِلكَ الأَمانِيا",10,"ي",2,0],["نَخلَةٌ لا تَزالُ في الشَرقِ مَعنىً","مِن بَداواتِهِ وَمِن عُمرانِه",11,"ن",2,0],["نُخيلُ حَتّى نَرى النَجاحَ عَلى","ظاهِرِ بِشرٍ مُبينَةٍ بُشَرُه",12,"ر",2,0],["نُخَبِّرُ عَن تِلكَ الخَوارِجِ أَنَّهُ","هَوى مُكرَهاً تَحتَ السُيوفِ عَظيمُها",13,"م",3,0],["نَخلٌ يَكادُ ذُراهُ مِن قِنوانِهِ","بِذُريعَتَينِ يُميلُهُ الإيقارُ",14,"ر",1,0],["نَخِيٌّ لَهُ العَزمُ الشَديدُ مُصاحِبٌ","سَخِيٌّ لَهُ الرَأيُ السَديدُ قَرينُ",15,"ن",1,0],["نُخادِعُ أحزانَ النّفوسِ ونَدّعي","من الصبرِ ما يُفني القُوى والعناصرا",16,"ر",2,0],["نَخُصُّكِ بالوَلاءِ المحضِ منّا","ونُؤثرُ بالهَوى الشّعبَ الوَدودا",17,"د",2,0],["نخاف الواحدَ القهّارَ فيها","ونَرقُبُ وعدَه حتّى يحينا",18,"ن",2,0],["نَخونُ بِلادَنا وَنَنامُ عَنها","وَنَخذُلُها لَدى النُوَبِ الثِقالِ",19,"ل",1,0],["نَخلُ القُرى شالَت مَراجيحُهُ","بِالوِقرِ فَاِنزالَت بِأَكمامِها",20,"م",3,0],["نُخبَتْ قَوافي الشعرِ فيك فما لها","لم تأتِ من مدحِ الملوكِ الأوجَبا",21,"ب",2,0],["نَخلٌ إِذا جُلِيَت إِبّانَ زينَتِها","لاحَت بِأَعناقِها أَعذاقُها النُحُلُ",22,"ل",1,0],["نَخشى السَعيرَ وَدُنيانا وَإِن عُشِقَت","مِثلُ الوَطيسِ تَلَظّى مِلؤُهُ سُعُرُ",23,"ر",1,1],["نَخبِطُ اللَيلَ وَالبَوازِلُ كا","لخُمَّسِ ريعَت مِنَ البُزاةُ البَوازي",24,"ز",2,0],["نَخشى المنون وَشرٌّ","من المنون الهوان",25,"ن",1,0],["نَخافُ لَها إِمّا مُسِرّاً شَناءَةً","وَإِمّا شَتيماً ذا مُجاهَرَةٍ وَردا",26,"د",2,0],["نخبَةٌ قلَّمَا أَتِيحَ لِعَصْرٍ","مِثل مَجْمُوعِهِمْ مِنَ الأفْرَادِ",27,"د",1,0],["نُخْصُّ بما كَانَ مِنْ فَضْلِهِ","وَكَانَ سِرَاجاً لَنَا فِي الدُّجَى",28,"ا",1,0],["نُخَيّرُهَا وَلَوْ نَطَقَتْ لَقَالَتْ","قواطِعُهُنَّ دوساً أو ثَقيفَا",29,"ف",2,0],["نَختالُ فَوقَ الخَيلِ في ظَلَلِ القَنا","أسداً وَقَد وَقَدَ الغداةَ وَطيسُ",30,"س",1,0],["نَخْتَالُ بَيْنَ هِبَاتِهِ","في ظِلِّ إِحْسَانٍ وَجُودِ",31,"د",1,0],["نخلةٌ دَبَّتْ عليها نَمْلَةٌ","وَخضَمٌ فيه نَقَّتْ ضِفْدَعه",32,"ع",2,0],["نخوض الحروب إذا أُوقِدَتْ","وإن نكُ نكره إيقادها",33,"د",3,0],["نَخر الجهل أُمّتي نخرة السوس","فأينَ المجامعُ العلميه",34,"ي",2,0],["نَ خِلاَلَ ذِي قَطَنٍ فَحَامِلْ","وَصَغَا العَشِيُّ، وَبَانَ أَلْ",35,"ل",1,0],["نخدعهم جهراً كما خادعوا","وعن جواد البغض لم ننزل",36,"ل",1,0],["نخص به الزاكينَ أهلَ نفوسةٍ","فما شذَّ شيخٌ منهمُ وغلامُ",37,"م",1,0],["نخصك بالتسليمِ نجلٌ مباركٌ","سلاماً وتسليما مدىً مُتقَاربَا",38,"ب",2,0],["نخضعْ ونسمعْ ونتبعْ ما يقولُ بهِ","من المقالِ ولا يجمحْ بنا العَذَلُ",39,"ل",1,0],["نختال في أمنٍ ونمرح في صفاً","ونسير تحت كواكب وشموسِ",40,"س",1,1],["نَخا وَسَخى في المُمحِلاتِ فَجارُهُ","بِخَيرٍ فَلا يُعصى وَعافيهِ يُعتَفا",41,"ف",2,0],["نَخوَةٌ إِن عَدَت أَذَلَّت عَزيزاً","وَإِذا أَنجَدَت أَعَزَّت ذَليلا",42,"ل",2,0],["نَخفى إِذا خِفْنا وَنَبْدُو تارَةً","فيهِ وَأَحْياناً يَغِيبُ ويُشْرِقُ",43,"ق",1,0],["نخوض الفلا منه بأغلب ضيغم","يقينا من حسن الثناء صوانا",44,"ن",2,0],["نخلي الديار ولا تبقى إذا امتلأت","غيظاً لروح امرئ في جسمه وطنا",45,"ن",2,0],["نخبةُ اللَّه مِن جميعِ البرايا","زبدةُ الخلقِ صفوةُ القدّوسِ",46,"س",1,0],["نَخلٌ تَبيتُ عَناقَ الطَير أَمِنَةً","بِحَيثُ يَنبُثُ مِنهُ اليُسرُ وَالسَعَفُ",47,"ف",1,0],["نُخِسَت بِهِ عَجزٌ كَأَنَّ مَحالَها","دَرَجٌ سُلَيمانُ النَبِيُّ بَناها",48,"ا",3,0],["نخاله كلما اقتربنا","في سيرنا من حماه أبعد",49,"د",1,0],["نَخشاهُ في الخَلَواتِ أَن نَرِدَ الخَنا","وَنَخافُهُ في اللَيلِ ذي الإِسدافِ",50,"ف",1,0],["نخالُ دَوىَّ الرِّيح في الجوِّ واشياً","بِنَا وضياءَ البرقِ عيناً فَنَفزَعُ",51,"ع",1,0],["نُخَبٌ عَيَّ البُلَغاءُ بها","عَجزاً ومآخِذُهم نُخَبُ",52,"ب",1,0],["نَخافُ أن تسفَهَ أحلامُنا","فنخمُلَ الدهرَ مع الخامِلِ",53,"ل",1,0],["نَخبِطُ لا نَدري الطَريقَ إِلى النَجا","وَبِالجَورِ نَمحو سَنَةَ البِرِّ وَالعَدلِ",54,"ل",1,0],["نُخَوّي صُدورَالمَشرَفِيَّةِ مِنهُمُ","وَكُلَّ شُراعِيٍّ مِنَ الهِندِ شَرعَبِ",55,"ب",1,0],["نُخليه من دمِه وحي","نَ يعود مملوءاً نعودُ",56,"د",1,0],["نَخَلاتٌ مِن نَخلِ بَيسانَ أَينَع","نَ جَميعاً وَنَبتُهُنَّ تُؤامُ",57,"م",1,0],["نَخيب وَاِن عدّوهُ نخبةَ عَسكَرٍ","وَكلُّ أَبِيٍّ في القِراعِ خَنيبُ",58,"ب",1,0],["نخوض بها في كل فن بفطنة","وذهن يرى أمضى من الصارم الهندي",59,"د",2,0],["نخالفك القصدَ اعتماداً وكنت من","تساق إلى أهوائنا فتوافقُ",60,"ق",1,0],["نخلد في الناس ذكرا جميلا","ولا نرتضي عيشة النكد",61,"د",1,0],["نَخْرُجُ أو نَدْخُلُ في مصْرنا","في ذِمَّ