oetsgate.com/ViewPoem.aspx?id=190646",""],[4119,"هذا الذي ولدت له الأفكار","https://www.poetsgate.com/ViewPoem.aspx?id=16139",""],[5039,"الورده","https://www.poetsgate.com/ViewPoem.aspx?id=48142",""],[5121,"خميلتي","https://www.poetsgate.com/ViewPoem.aspx?id=33597",""],[5136,"ومهاة ذات صد وملل","https://www.poetsgate.com/ViewPoem.aspx?id=121643",""],[5145,"من للأرامل واليتامى","https://www.poetsgate.com/ViewPoem.aspx?id=108053",""],[5183,"أم هابيل","https://www.poetsgate.com/ViewPoem.aspx?id=186487",""],[5213,"ما هز عطف الصب صبوه","https://www.poetsgate.com/ViewPoem.aspx?id=170568",""],[5273,"مدرِّسة","https://www.poetsgate.com/ViewPoem.aspx?id=184341",""],[5367,"شُهود","https://www.poetsgate.com/ViewPoem.aspx?id=197191",""],[5401,"هات القلم","https://www.poetsgate.com/ViewPoem.aspx?id=142369",""],[5419,"بين الشعراء أنا عجبٌ","https://www.poetsgate.com/ViewPoem.aspx?id=31465",""],[5463,"أبي تعتقني من حبّك","https://www.poetsgate.com/ViewPoem.aspx?id=35643",""],[5561,"صراع الذات","https://www.poetsgate.com/ViewPoem.aspx?id=194666",""],[5616,"واصلوا","https://www.poetsgate.com/ViewPoem.aspx?id=203478",""],[5790,"أعشق البيض ولكن","https://www.poetsgate.com/ViewPoem.aspx?id=112098",""],[5897,"يا طيبة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=156357",""],[5897,"إيه .. يا جنة الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=176413",""],[5956,"قضية العدل","https://www.poetsgate.com/ViewPoem.aspx?id=192032",""],[5960,"أنا حاكمٌ عربيٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=31108",""],[5993,"جيت لك كلي غلا ودموع","https://www.poetsgate.com/ViewPoem.aspx?id=186540",""],[6037,"وإذا قصدت سواكم بشكاية","https://www.poetsgate.com/ViewPoem.aspx?id=186098",""],[6093,"لك في الشعر ثبات ورسوخ","https://www.poetsgate.com/ViewPoem.aspx?id=197662",""],[6160,"في سُقُوطِ الظِّلِّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87083&r=&rc=0",""],[6167,"القلب الذاكر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85479&r=&rc=8",""]],"verses":[["وَإِذا اِنقَضى إِقبالُهُ","رَجَعَ الشَفيعُ لَهُ خَصيما",0,"م",2,0],["وَإِذا اِنتَهى العَياءُ بِأَهلِهِ","يَوماً فِداءُ أَخي الهَوى الأَدوى",1,"و",2,0],["وَإِذا أَنَّ كادَ يَنصَدِعُ الأُف","قُ وَتَعتَلُّ دَورَةَ الأَجرامِ",2,"م",1,0],["وَإِذا أَنتَ لَم تُعَجِّل جَوابي","كانَ هَذا الكِتابُ بَيضَةَ عُقرِ",3,"ر",1,0],["وإذا أنشدت عن الهجر جاءت","بلحون تدعو إلى الأحزان",4,"ن",1,0],["وإذا انبرى لك شاتماً","فاربأ بنفسك عن جوابه",5,"ب",2,0],["وإذا أنشط الجبان لحرب","صال يرغو حماسة وحمازه",6,"ز",2,0],["وَإِذا اِنتَسَبتَ إِلى شَنوءَةَ تَدَّعي","قالوا اِدِّعاءُ أَبي سُراقَةَ زورُ",7,"ر",1,0],["وَإِذا انتَحَيتُكُمُ جَميعاً كُنتُمُ","لا مُسلِمينَ وَلا عَلَيَّ كِراما",8,"م",2,0],["وإذا أنْبَضَتْهُ للشَّرْبِ يوماً","أيقنَ القومُ أنها ستَصيدُ",9,"د",1,0],["وإذا أنتم وأنتم أنتمُ","لم تُوَلُّوني وتُولُوني فَمَن",10,"ن",1,0],["وَإِذا أَنجُمُ آمالي تَوارَت في الحِجابِ","وَإِذا لَم يَبقَ في غَيمي ماءٌ لِاِنسِكابِ",11,"ب",1,0],["وَإِذا اِنحَلَّ في الشُعاعِ كَياني","فَأَنا في الضُحى عَبيرُ",12,"ر",1,0],["وَإِذا اِنقَضى عَهدُ التَعَلُّلِ بِالمُنى","فَالنَفسُ يَشفيها الَّذي يُرديها",13,"ي",3,0],["وَإِذا اِنتَسَبتُ بِخِدمَتي لَكَ سابِقاً","فَكَأَنَّها لِيَ مَعشَرٌ وَقَبيلُ",14,"ل",1,0],["واذا انكر النبوغ على الشرذ","ق قريق فانت انت الجواب",15,"ب",1,0],["وإذا أنست بوحدتي فلأنها","سببي إليك وسلّمى ومنارى",16,"ر",2,0],["وَإِذا أَنشَئوا التَماثيلَ غُرّاً","فَإِلَيكِ الرُموزُ وَالإيماءُ",17,"ا",2,0],["وَإِذا اِنتَضاكَ عَلى العِدى في مَعرَكٍ","هَلَكوا وَضاقَت كَفُّهُ بِالقائِمِ",18,"م",1,0],["وَإِذا أُنكِرَ البَخيلُ مِنَ القَو","مِ فَأَنتَ المَعروفُ بِالمَعروفِ",19,"ف",1,0],["وَإِذا اِنشَعَبتَ أَخَذتَ خَيرَ فُروعِها","وَإِذا رَجَعتَ أَخَذتَ خَيرَ أُصولِها",20,"ل",3,0],["وَإِذا انتَجَعتُكَ بِالرُجوعِ فَغَيرُهُ","أَولى وَأَبعَدُ مِن جَوى الحَدَثانِ",21,"ن",1,0],["وَإِذا أَنامُ أَلَمَّ طائِفُها","حَتّى يُنَبِّهَ أَعيُنَ السَفرِ",22,"ر",1,0],["وإذا أناطَ بكَ الرَّجاءَ مُؤَمِّلٌ","صَدَقَتْ مُناه وحُقِّقَتْ أحلامُه",23,"م",2,0],["وإذا انتضَتْ يُمناه نِضْوَ سيوفِه","أَذْكَى ضِرامَ الحربِ غيرَ مُحاربِ",24,"ب",1,0],["وَإِذا أَنَلتَ أَخاً فَلا","تَستَكثِرَنَّ لَهُ الجَزيلا",25,"ل",2,0],["وَإِذا انتَمى خالٌ فَما","خالٌ بِأَكرَمَ مِن يَزيدِ",26,"د",1,0],["وإذا انثى سهمٌ على الرّامي به","غَرَضاً له فالجُرْحُ منه جبارُ",27,"ر",1,0],["وَإِذا اِنتَمى في قُلَّةٍ مِن سُؤدَدٍ","قالَت لَهُ الأُخرى بَلَغتَ تَقَدَّمِ",28,"م",1,0],["وَإِذا اِنحَنَت وَالسَهمُ مِنها خارِجٌ","فَهِيَ الهِلالُ اِنقَضَّ مِنهُ شِهابُ",29,"ب",1,0],["وإذا انتَهَيتَ إلى مدَى أملٍ","دَرْكاً فيومٌ واحدٌ عُمُر",30,"ر",1,0],["وإذا انهَلَّتْ سماءٌ فَعَلى","ما رفَعْتُمْ من سماءٍ وعِماد",31,"د",1,0],["وَإِذا أُنادِمُ عُصبَةً عَرَبِيَّةً","بَدَرَت إِلى ذِكرِ الفَخارِ تَميمُ",32,"م",1,0],["وَإِذا اِنتَسَبتَ فَقُلتَ إِنّي واحِدٌ","مِن خَلقِهِ فَكَفى بِذاكَ تَنَسُّبا",33,"ب",2,0],["وإذا انحَطَّ زمانٌ لم تَجِد","عالياً ذا رفعَةٍ إلا الألم",34,"م",1,0],["وإذا أنتَ ، لا ترى غيرَ رأسٍ","مُطرِقٍ وارمِ المحاجرِ واجم",35,"م",1,0],["وإذا أنّ جَريحٌ دَنِفٌ","لطبيبٍ قيل لا تشكُ الْجِرَاح",36,"ح",1,0],["وإِذا أَنْعُمُ الإِلَهِ تَوَالَى","بعميم الإِحسانِ والإِفضال",37,"ل",1,0],["وإذا انقضت حاميم قام محمد","للاستقامة طالعا مسعودا",38,"د",2,0],["وإذا انقضَى هَمُّ امرىء ٍ فقد انقضَى","، إنَّ الهُمُومَ أشَدُّهُنَّ الأحْدَثُ",39,"ث",1,1],["وإذا انفضى عهد التعلّل بالمنى","فالنّفس يشفقيها الذي يرديها",40,"ي",3,0],["وإذا أنتم وأنتم أنتُم","لم تولُّوني ونولُوني فمنْ",41,"ن",1,0],["وَإِذا اِنتَضَيت عَزائِماً","لَكَ فَاِنتَضَيت مهندا",42,"د",2,0],["وإذا أنشدت شعراً من لظى","تفهمين الشوق فيه والحنين",43,"ن",1,0],["وإِذَا أُنشِدَت غَدوتَ وإِن كُن","تَ طَرُوباً على اضطِرَابٍ كَظِيمَا",44,"م",2,0],["وإذا انثنت يا خجلة الغصن الرطي","بِ ويا شقاء الصعدةِ السمراءِ",45,"ا",2,0],["وإذا انصرفتُ فإنما جسدى","ولىَّ وقلبي غيرُ متصرِف",46,"ف",1,0],["وإذا انتهى نسبٌ إليك فإنه","فَلَقُ الصباح مع الضُّحى موصولُ",47,"ل",1,0],["وَإِذا اِنتَمى يَومَ الوَغى ثُمَّ اِكتَنى","فَالنَصرُ فيهِ مُبدِئٌ وَمُعيدُ",48,"د",1,0],["وَإِذا اِنجَلَت عَنهُم دَياجيرُ الوَغى","عَدَلوا بِقَتلِهِمُ إِلى الأَموالِ",49,"ل",1,0],["وَإِذا اِنتَهى دَهرٌ فَهُم أَعيانُهُ","وَإِذا أَتى خَيرٌ فَهُم أَعوانُهُ",50,"ن",2,0],["وإذا انقضى شهرُ الصّيام ولم تَتُب","فمن البعيد متاب باقي العام",51,"م",1,0],["وَإِذا اِنتَضى العضبَ المُهَنَّدَ وَاِعِتَزى","أَيقَنت أَنَّ اليَومَ يَومُ صِدامِ",52,"م",1,0],["وَإِذا أَنتَ لَم تُعَذَّب وَتَغمِس","قَلَماً في قُرارَةِ الآلامِ",53,"م",1,0],["وَإِذا أَنكَرَ الحَقيقَة قَومٌ","لم يَرُقهُم بِاِبنٍ لمصرَ علاء",54,"ا",2,0],["وَإِذا اِنتَهى التَرتيلُ يَختِمُ قائِماً","تَعظيمَ عَبدٍ عارِفٍ خشيانِ",55,"ن",1,0],["وَإِذا اِنتَدَيتُم لِلفَخارِ فَأَنتُمُ","عُمّالُها عُلَماؤُها أَعلامُها",56,"م",3,0],["وَإِذا اِنتَضاهُ عَلى الخُطوبِ تَضاءَلَت","بيضٌ بِأَيدي المُصلِتينَ مَواضِ",57,"ض",1,0],["وَإِذَا انْتَضَى مِنْ هَدْيِهِ","عَضْباً رَأَيْتَ الزَّيْغَ يُحْصَدْ",58,"د",1,0],["وَإذا انْتَضَوْا يَوْمَ الكَريهَة بيضَهُمْ","أبْصَرْت فيهم قَطْعها وَمَضاءَها",59,"ا",3,0],["وَإِذا اِنجَلَت في اللَيلَةِ الليلاءِ","هَزَمَت ظَلامَ اللَيلِ بِالآلاءِ",60,"ا",2,0],["وإِذا اِندَفَقَت من دَنِّها","في الدُجى قالوا طِرازٌ مُذهَبُ",61,"ب",1,0],["وإذا أنت حيث كنت غريقٌ","في بحار الشكوك والأوهام",62,"م",1,0],["وَإِذا أنًا مَغرورٌ عَلَى الجَهلِ فِي الهَوَى","وَشَأوُ ارتِكَاضِي في النََّشَاطِ عَمِيقُ",63,"ق",1,0],["وإذا انقطَعْتُ لِمدْحةٍ","تُهْدَى فَعْنك بِها اشْتِغالي",64,"ل",2,0],["وإذا انتَهى مَجْرَى الخُيولِ وكُفَّ من","غُلَوائها انحَطَّ القَتامُ المُعْتلَي",65,"ل",2,0],["وإذا انقضَى فأقَلُّ من نَفَسٍ","فيه يَعود ذليلاً الصَّعب",66,"ب",1,0],["وإذا انتَضى الحدثانُ بعض سيوفِه","فأبو الحُسين بمثلِه متقلِّدُ",67,"د",1,0],["وَإِذا انثَنَيتُ إِلى العُلوم رَأَيتُهُ","قَرمَ القُرومِ يَفوقُ كلَّ البُزَّل",68,"ل",1,0],["وَإِذا اِنتَضى قَلَماً رأَيت بكتبه","نار العداة وَجَنَّةِ الأُخوانِ",69,"ن",1,0],["وَإِذا انتَضى قلماً لِدَفعِ كَريهَةٍ","خَضَعت لَهُ الأَشبال في الآجامِ",70,"م",1,0],["وإذا أناخ السائلون بجوهم","عادوا ثقال الظهر بالإنعام",71,"م",1,0],["وإذا انتقدت بني الزَّمان وَجَدْتَه","رَجُلَ الزَّمان وواحداً برجاله",72,"ل",2,0],["وإذا انجرت أحاديثُهُم","لا تسل عن مقلتي عمَّا جرى",73,"ر",2,0],["وإذا انحلّ فتلُ جيبِك فاعْقِدْ","عُقدةً لا تلينُ للحلاّلِ",74,"ل",1,0],["وإذا انتهى ال