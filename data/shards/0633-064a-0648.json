ها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60156&r=&rc=212",""]],"verses":[["سُيوفُ إِباءٍ في أَكُفٍّ أَبيَّةٍ","وَكُلُّ طَويلٍ في يَمينِ طَويلِ",0,"ل",1,0],["سُيوفٌ تُطيلُ قِراعاً وَقَرعاً","وَخَيلٌ تُعيدُ طِراداً وَطَردا",1,"د",2,0],["سُيودٌ عَلى الأَعداءِ تَمضي نُفوسُها","وَلَم تَتَبَدَّلهُنَّ أَيدٍ ضَوارِبُ",2,"ب",1,0],["سُيُوفُكَ فِي أَغْمَادِهَا مُطْمَئِنَّة","وَلِكْنَّ سَيْفَ اللهِ دَامِي الْمَضَاربِ",3,"ب",1,0],["سُيُوفاً تُبْرِيءُ الأحْقَادْ","وَتُحْيِي مَيَّتَ الآمَالْ",4,"ل",1,0],["سيوفٌ محلاَةً على عاتق الهدى","إذا تُنْتَضى تمضي وتنبو المناصلُ",5,"ل",1,0],["سيوف لحاظ أم قسيّ حواجب","تريش إلى قلبي سهام المعاطب",6,"ب",1,1],["سُيوفُ الخالِدينَ صَدَعنَ بَيضاً","عَلى الأَعداءِ في لَجَبٍ وَهاما",7,"م",2,0],["سُيُوفٌ ما تَزَالُ ضلاَلاَ قَومٍ","يُهَتِّكنَ البُيُوتض وَيَبتَنِينَا",8,"ن",2,0],["سيولٌ دعاها مستقَرٌّ وقادها","مَسيلٌ فجاءت مُفْعَمات طواميا",9,"ي",2,0],["سيُوقِظُ منهمْ كلّ منْ هوَ نائمٌ","ويُنطِقُ منهمْ كلَّ من هو واجِمُ",10,"م",1,0],["سيوف أبيه من خمسين عاما","لواصق بالجدار بغير سَل",11,"ل",1,1],["سُيوفٌ لَها في عُمرِ كُلِّ عِدىً رَدىً","وَخَيلٌ لَها في دارِ كُلِّ عِدىً نَهبُ",12,"ب",1,0],["سُيوفاً بِها كانَت حَنيفَةُ تَبتَني","مَكارِمَ أَيّامٍ تُشيبُ الحَزَوَّرا",13,"ر",2,0],["سُيوفٌ إِذا الأَغمادُ عَنهُنَّ أُلقِيَت","وَكانَ بِهاماتِ الرِجالِ صِقالُها",14,"ل",3,0],["سُيوفَ نَعامٍ غَيرَ أَنَّ لِحاهُمُ","عَلى ذَقَنِ الأَحناكِ مِثلُ الفَلائِلِ",15,"ل",1,0],["سُيوفُكُمُ بحَمدِ اللهِ نَفْعٌ","إذا كانت سيوفُ الناسِ ضُرَّا",16,"ر",2,1],["سيوفُكَ من شَكاةِ الثَّغرِ بُرءٌ","ولكن للعِدا فيها بَوارُ",17,"ر",1,0],["سيوفُك أبقتْ في الأعادي أبدْتَهُمْ","مآتمَ أحزانٍ بغير مآثمِ",18,"م",1,0],["سيوفُكَ للجهادِ الحقِّ شتَّى","وإنّ لنا لأَصْدَقَها ضِرابا",19,"ب",2,0],["سُيوفُ الجُندِ مَظهرُ كلِّ حقِّ","ورأيُ كُرومَرَ الرأيُ السَّديدُ",20,"د",1,0],["سيوفُ اللهِ ليس له سواه","وراياتُ الهُداةِ المُلهَمينا",21,"ن",2,0],["سُيوفٌ لِغَير اللَهِ سُلَّت عَليهمو","تُطبِّقُ فيهم مَرَّةً وَتُصمِّمُ",22,"م",1,0],["سُيوفٌ بَقينَ طِوالَ العُصورِ","ودائعَ للوارثينَ الأُمَمْ",23,"م",1,0],["سُيوفُ مُحمّدٍ جُعلتْ جَزاءَ","فما البَغْيُ الذَّميمُ وما العُرامُ",24,"م",1,0],["سُيوفُهُ وَالقَنا في الحَربِ فاتِكَةٌ","كَفَتكِ مُقلَتِهِ في القَلبِ بِالنَظَرِ",25,"ر",1,0],["سيُوفٌ كأغمادِ السّيوفِ ودولَةٌ","تَثَنّى دلالاً كالقضيب المُنَعَّم",26,"م",1,0],["سيوفُنا وردُها ونرجسُها","وشتمُنا اللفظُ من مغنّيها",27,"ي",3,0],["سُيوفٌ بِها جَونانِ جارٍ وَجاسِدٌ","وَخَيلٌ عَلَيها الماءُ رَطبٌ وَيابِسُ",28,"س",1,0],["سيوفٌ يقيلُ الموتُ تحتَ ظُباتِها","لها في الكُلَى طُعْمٌ وبينَ الكُلى شُرْبُ",29,"ب",1,1],["سيوافي مدى التقدم قوم","وسعت فيه منهم الخطوات",30,"ت",1,0],["سُيُوفُه تَعْشَقُ الرّقابَ فما","يُنْجَزُ حتى اللّقاء مَوْعِدُها",31,"د",3,0],["سَيُورِقُ عُودِي إِنْ سَكنتُ بريَّةٍ","وَيسودُّ من فَوْدَيَّ كلُّ بياضِ",32,"ض",1,0],["سُيُوفُهم كُنَّ للطغيَانِ ماحِقَةً","وعدْلُهُمْ كانَ للدنيا مَوازِينَا",33,"ن",2,0],["سيوفها وعواليها وأسهمها","وهم اذا افتخر الفرسان فرسان",34,"ن",1,0],["سيوقفني من رقدة اللهو ناعب","يحط بمحتوم الردى ويطير",35,"ر",1,0],["سيوفكم يا قوم سيفان خاذل","لحق وسيف في المحقين خازم",36,"م",1,0],["سيُوقِفها للردى زائرٌ","ثقيلُ الورودِ بغيضُ الصَّدر",37,"ر",1,0],["سيورق يا خليلي كل غصن","سقاه الظامئون إلى الكمال",38,"ل",1,0],["سَيوشِكُ إِلحاقٌ بِكُم وَزِيادَةٌ","وَأَعطِيَةٌ تَأتي تِباعاً فَتُشفَعُ",39,"ع",1,0],["سُيوفُكُمُ تَدمى بِكُلِّ كَريهَةٍ","وَأَيديكُمُ في كُلِّ مَسأَلَةٍ تَندا",40,"د",2,0],["سيوف لحظ يشتهى الموت بها","في أعين مكحولة بالسحر",41,"ر",1,0],["سيوف ألفن الضرب لكن تعافُه","إِذا لم تجد داءً له الضرب مَرهما",42,"م",2,0],["سيوف ألحاظك روعنني","تالله لا أنسي التي انسلت",43,"ت",1,0],["سيُؤخَذ منّا ليس رضوان تاركاً","على الأرض حوريّاً ربيب سماءِ",44,"ا",2,0],["سُيولُ الجَدِيَّةِ جادَت","مُراشاةِ كُلِّ قَتيلٍ قَتيلا",45,"ل",2,1],["سيوفهم كلما صلت لها سجدت","هام العدا ولما أمضته تمتثل",46,"ل",1,0],["سيوفهم ذكرها في السلم لو خطرت","يوما على خاطر امسى على خطر",47,"ر",1,0],["سيوطيةٌ في سنتريس مهادها","وقد ينفع الحسن الأصيل التنقل",48,"ل",1,0],["سيوفُ الشرقِ ماضيةٌ ظُباها","وأمضاها شباةُ محَمدي",49,"ي",1,0],["سُيوفُ بَني أَبي حَفْصٍ نَفَتهُ","وَقادَتْهُ إِلى سُوءِ المَصيرِ",50,"ر",1,0],["سُيُوفٌ مِنَ التَّدْبِيرَ والْفَتْكِ لَمْ يَزَلْ","وَمُغْمَدُها فِي كَفِّهِ وَشَهِيرُها",51,"ر",3,0],["سيوف اجفانه المرضى سفكن دمى","ولم يطق دفعها حيلى ولا حيلي",52,"ي",1,1],["سَيُؤنِسُها باللّه حسنُ رَجائِها","وَيوحِشُها ممّا سِوى اللّه يَأسُها",53,"س",3,0],["سُيوفُ أَلحاظِها في الجَفنِ مُغمَدَةً","قَتَلنَنا ثُمَّ لَم يُحيينَ قَتلانا",54,"ن",2,0],["سيوستبول بِفتحها نِلنا المُنى","حَتّى اِرتَقى داعي المَسَرَّة منبَرا",55,"ر",2,0],["سُيوفُه البيضُ ما لم تُجْرِ بَحْرَ دمٍ","في عَيْنه كَسرابٍ عند ظَمْآن",56,"ن",1,0],["سُيوفُها ماصِيَةٌ","في الناصِبين لا تُفل",57,"ل",1,0],["سيُؤخَذُ مِنكَ غداً كلَه","وتُسأَلُ من بعدُ عَن كَلِّهِ",58,"ه",1,0],["سيوفي إذا ما نازلتني ملمة","حصوني إذا خفت الردى ومعاقلي",59,"ل",2,0],["سيوفٌ بأَعناق اللئام صليلها","أَحِنُّ إلى يومٍ عبوسٍ عصبصبِ",60,"ب",1,0],["سَيُورِدُكَ الْعَذْبَ الزُّلالَ مُجَرِّبٌ","عَليمٌ بِتَدْبِيرِ الوَرَى كَيْفَ يُصْدِرُكْ",61,"ك",1,0],["سيوفٌ تنيرُ الحقَّ أنَّى انْتَضَيْتَها","وخيلٌ يجولُ النصرُ حَيْثُ تَجولُ",62,"ل",1,0],["سيوفٌ عَلَى الجُرْدِ العِتاقِ عَزِيزَةٌ","وَأَرْضٌ إِلَى البَيْتِ العَتيقِ ذَلُولُ",62,"ل",1,0],["سيوسعها لي حسنُ رأيك آجلاً","فلا يحرجنّي عاجلاً منك ضيقُها",63,"ق",3,0],["سُيوفُه في الوغى والسَّلْم كافِلَةٌ","منه بحتْفٍ كُماةِ الرَّوع والبُدُن",64,"ن",1,0],["سيوفهمُ للشاغرات مفالغٌ","وهنَّ لأغرق البلاد مفاتيح",65,"ح",1,0],["سيوف حمتْ أن تنال الجفونُ","أتحمي الصوارم أغمادها",66,"د",3,0],["سيوفٌ تطير الهام عن وكناتها","بحيث جناح النقع وجفُ القوائمِ",67,"م",1,0],["سيوفهم سفاكة ونفوسهم","من البعد قد أودت بنار الزلازل",68,"ل",1,0],["سُيُوفٌ مِنَ النَّظمِ مَطبُوعَةً","مُقَلِّلة عَركَ كُلِّ انتِقَاد",69,"د",1,0],["سُيوفُ حقٍّ لدين اللَّه قد نصَروا","لا يَطْهُرُ الرِّجْسُ إلّا في حُدودِهمِ",70,"م",1,0],["سُيوفُهُم في مَضاها مثلُ أعيُنِهم","سُودُ الجُفونِ ولكنْ فاتَها الهُدُبُ",71,"ب",1,0],["سيوف إذا ضاق المجال عن القنا","فهن لهامات الخصوم خصوم",72,"م",1,0],["سُيوفُ غِوارٍ بَيننا وتسلّطٍ","كهوفُ قرارٍ بيننا وتمهّدِ",73,"د",1,0],["سيوفُهُمُ أَلحاظُهم وقناتهُمْ","سواعدُهمْ مهما اِستَحرَّ ضِرابُ",74,"ب",1,0],["سيوفهم تحت غيم النقع بارقة","جادت بغيث من الهامات منسجم",75,"م",1,0],["سُيُوفٌ مَوَاضٍ مُرْهَفَاتٌ قَوَاطِعٌ","قَوَاضٍ يَروحُ المَوْتُ فِيهَا ويَغْتَدِي",76,"ي",1,1],["سُيوفِ نَضاها اللَهُ إِذا حَمَّسَ الوَغى","وَنادى مُنادي الدينِ لِلرَميِ وَالنَضحِ",77,"ح",1,0],["سُيوفٌ بِايديها سُيوفٌ جُفُونُها","إذا فارَقَتهُنَّ الجُفُونُ المَفارِقُ",78,"ق",1,0],["سيول عن حياء عن بحور","عن الأفضال عن كف مليّ",79,"ي",1,0],["سيوفٌ إذا اعتلت جهات ثغورها","فمنهن في أعناقهن تمائمُ",80,"م",1,0],["سيؤلف القدر المحتم شملهم","ويعود نائيهم ويصفو الأكدر",81,"ر",1,0],["سُيوفٌ مَواضٍ أَربعٌ وَقعها الحَشا","فَأيّ معنّىً غاب عنه حِمامُهُ",82,"م",2,0],["سيوفُكَ، أعناقَ العُداة تُميلُ","وخوفُكَ آفاق البلاد يَجولُ",83,"ل",1,1],["سُيُوفُ الْمَنَايَا مِنْ دِمَاهُمْ ذَوَارِفُ","أَحَاطَ بِأَهْلِ الْبَغْيِ مِنْهَا زَوَاحِفُ",84,"ف",1,0],["سُيُوفاً لأَقْوَامِ الشَّرِيعَةِ سُلَّتِ","أَجَلُّ الوَرى قَدْراً وأَصدَقُ لَهْجَةٍ",85,"ه",1,0],["سيوفهم تجري دماً","كفُوفهم سيلٌ هَما",86,"م",2,0],["سيوف إذا ركعت في الحرو","ب رأيت الرؤوس لها سجدا",87,"د",2,0],["سيوف لها في كل درع وجنة","إذا ما اعتلت قدُّ أو اعترضت قط",88,"ط",1,0],["سيوف الله إن سلت","فلا تبقي ولا تذر",89,"ر",1,0],["سيوفك يا ذا البطش والأخذ سلها","على الخصم أنا بينهم بمضيعة",90,"ه",1,0],["سيوفهمُ في جميع النّواحي","تكفّ الظّلوم وتنهى الجَهولا",91,"ل",2,0],["سيوفُ صبرى عن سيو","ف مُقلتيكِ قد نبَت",92,"ت",1,0],["سُيوفٌ لَها في يَومِ بَدرٍ وَقائِعٌ","وَيَومَ حُنينٍ وَالقَنا يَتَقَصَّفُ",93,"ف",1,0],["سيوفُ عِداكَ في الأَغماد تنبو","وسيفُ عُلاكَ ليس له انثلام",94,"م",1,0],["سيوفي بَني عَبد العَزيزِ وَما أَنا","بِنابٍ إِذا اِلتَفَّت عِداً وَنَوائِبُ",95,"ب",1,1],["سيوفكم في الحقّ ماضية الظبى","تقدّ صدور الظّلم قد القوا ضب",96,"ب",1,0],["سيوف نضاها اللضه فهي إلى الطلى","جياعٌ إلى ورد النفوس ظماء",97,"ا",2,0],["سُيوفهم عزّ الذليلِ وخيلهم","سهامُ الأعادي في الأمور الفظائعِ",98,"ع",1,0],["سيوفي من ورائي ومن أمامي","ولوحي غالبٌ صفّ القتالِ",99,"ل",1,0],["سيوفه من الصباح تُنْتَضَى","ونقعه من الظلام ي