[5431,"غيومٌ به سكرى...","https://www.poetsgate.com/ViewPoem.aspx?id=198423",""],[482,"أشاقكَ مِن غرامِكَ ما يشوقُ","https://www.poetsgate.com/ViewPoem.aspx?id=111409",""],[5616,"قلم وقرطاس","https://www.poetsgate.com/ViewPoem.aspx?id=203337",""],[5670,"ولي قلبٌ..","https://www.poetsgate.com/ViewPoem.aspx?id=215259",""],[5725,"قابيل الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=186343",""],[5730,"شوق","https://www.poetsgate.com/ViewPoem.aspx?id=210353",""],[5736,"أنين قلب","https://www.poetsgate.com/ViewPoem.aspx?id=208863",""],[5804,"التحدّي","https://www.poetsgate.com/ViewPoem.aspx?id=190658",""],[5809,"قلمي","https://www.poetsgate.com/ViewPoem.aspx?id=205081",""],[5956,"سارقُ الطبيعة","https://www.poetsgate.com/ViewPoem.aspx?id=183309",""],[5956,"نُقَّادٌ ومعجَبون","https://www.poetsgate.com/ViewPoem.aspx?id=185609",""],[6089,"تسامرُني الأشواقُ في غارِ وحشتي","https://www.poetsgate.com/ViewPoem.aspx?id=214639",""],[6093,"سؤال يبحث عن جواب","https://www.poetsgate.com/ViewPoem.aspx?id=204280",""],[6152,"سليل بيت النبوة","https://www.poetsgate.com/ViewPoem.aspx?id=203279",""],[6152,"قلبي بغيرك لا يبالي","https://www.poetsgate.com/ViewPoem.aspx?id=213178",""],[520,"هم الأحبة ان جاروا وإن عدلوا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577619",""],[119,"يعاركني الزمان كما يشاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55606&r=&rc=3",""],[572,"الحَمْدُ للهِ نَالَ النَّاسُ حَظَّهُمُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9169&r=&rc=26",""],[572,"أخٌ لي عادَ من بعدِ اجتِنَابِهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9180&r=&rc=37",""]],"verses":[["ولي قلب إذا قالوا عليٌ","كطير نام وانتبه ارتيابا",0,"ب",2,0],["وَلي قُربى رَؤومٌ كُنتُ أَرجو","يَمينَكَ أَن تُقَرِّبَ لي مَرامي",1,"م",2,0],["وَلي قَلبٌ إِذا ذَكَرَ التَلاقي","تَظَلَّمَ مِن يَدِ البَينِ المُشِتِ",2,"ت",1,0],["وَلي قَبرانِ بِالزَوراءِ أَشفي","بِقُربِهِما نِزاعي وَاِكتِئابي",3,"ب",2,0],["وَلي قَصائِدُ تَحْكي رَوْضَةً أُنُفاً","تَبَسَّمَتْ في حَواشِيها الأَزاهِيرُ",4,"ر",1,0],["وليقُلْ ما شاء في شتمي له","إن طبعي شيمةٌ لا مُكتَسبْ",5,"ب",1,0],["وليقبلنَّ صحيح وُدِّك إنه","لا يدفع الحسنى بما هو أسمجُ",6,"ج",1,0],["ولَّى قَفَاه عبيدَهُ","واعتاد ذاك فصار عادَهْ",7,"د",2,0],["وَليُقَبِّل فَمُ الصَباحِ جَبيني","وَليُعَطِّر أَريجُهُ جِلبابي",8,"ب",2,0],["وَلي قَلَمٌ كَالرُمحِ يَهتَزُّ في يَدي","إِلى الخَيرِ يَسعى وَالرِماحُ إِلى الشَرِّ",9,"ر",1,0],["وَليَقذِفَنَّ بِهِ المَلالُ","مِنَ القُصورِ إِلى القِفار",10,"ر",1,0],["وَلي قَلبٌ بِأَن يَهوى يُجازى","وَمالِكُهُ بِأَن يَجني يُثابُ",11,"ب",1,0],["ولي قِبَلَ الأيامِ منذ صِحِبْتُها","مواعيدُ قد أعلقنَها شرَكَ المطلِ",12,"ل",1,0],["وَلِيٌّ قَفا بَعدَ وَسمِيِّهِ","فَهَمُّكَ مِن كَمأَةٍ مَعدَه",13,"د",2,0],["ولي قَولةٌ في الناسِ لا أَبتغي بها","منَ الناسِ إلا أن يقالَ صديقُ",14,"ق",1,0],["ولي قصةٌ يُشجي القلوبَ حديثُها","ويعجز عن تصويرها اليوم واصفُ",15,"ف",1,0],["وَلي قَلبٌ أَشَدُّ مِنَ الرَواسي","وَذِكري مِثلُ عَرفِ المِسكِ نامي",16,"م",2,0],["ولي قلب حر عصيُّ الزمام","فإن راضه حبُّكم يسلس",17,"س",1,0],["وَلْيَقْنَ تُفّاحُ الخُدودِ، فلَستُ من","تَقبيلِهِ غَزِلاً، وَلاَ مِنْ عَضّهِ",18,"ض",2,0],["ولي قبلات بين نهديك أودعت","شبابي وآمالي العذاب وآلامي",19,"م",2,0],["ولي قبور على الفيحاء غافية","زوّارها الطير والأشواق والقمر",20,"ر",1,0],["ولي قلب يقلب فوق جمر","هواه الخيف والبلد الحرام",21,"م",1,0],["ولي قلب بحبي ذا ولوه","وفكر في الهوى رهن اندهاش",22,"ش",1,0],["ولى قُرباتٌ عندهم غير أنني","أضَنُّ على أفضالهم بفضائلي",23,"ي",1,0],["وَلِي قَلَمٌ إِذَا استَفهَمت عَنهُ","أَشَادَ بِهِ وَأَنشَدَ عَن جَنَانِي",24,"ن",2,0],["ولي قدح أسميّه تغارا","ويشبهه بهيئته التغار",25,"ر",1,0],["ولي قلمٌ كالنابِ ما زالَ مرهفاً","ولكنْ متى ما مسَّهُ الدمعُ يورقِ",26,"ق",1,0],["ولي قلبُ برقٍ تحت رعدِ فكاهةٍ","فأستمطر اللذات بالبرق والرعدِ",27,"د",1,0],["وليقبلوا البشرى بكل بشاشه","من نخبة عدوا بألف عنان",28,"ن",1,0],["ولي قلبٌ إذا ذكر الليالي ال","لتي نلنا بها الاوطار طارا",29,"ر",2,0],["وَلي قَلَمٌ في عَصْرِكُمْ جَفَّ رِيقُهُ","وَيَكفيهِ مِن دُنْياهُ نُغْبَةُ طائرِ",30,"ر",1,1],["وَلي قدم في مَذهَب الحُبّ راسِخ","به في دَواوين الهَوى أَتَصَرَّف",31,"ف",1,0],["وَلي قَلَمٌ مِنهُ عَينُ الكَلا","مِ تَجري فَتَنظُرُ عَينَ الكَمالِ",32,"ل",1,0],["ولي قلمٌ يملي عليك إذا جرى","وترجمَ عمّا في الضَّمير وأعربا",33,"ب",2,0],["ولي قلبٌ تَوَقَّدَ في التهابٍ","ولي دمع توالى بانسكاب",34,"ب",1,0],["ولي قلب توجهه عيون","تخلى عنه مرشده وعني",35,"ن",2,0],["ولي قلبٌ يبتهج هواه نجدٌ","وقدماً كان يطربهُ الحيار",36,"ر",1,0],["وليقم كل بواجبه","وليصافح كف عافيه",37,"ي",2,0],["وليقطع الخائنين واغلط عليهم","إنَّما أهلُ دِينِنا الأَمَناءُ",38,"ا",2,0],["وليقبضوا اللوم عن قلبي ببسطتهم","فقد طويت بساطاً مده العذل",39,"ل",1,0],["وليقف لحظُكَ بالأرضِ أُختهَا","تنسَابُ في مُنعَرَجاتِ الطُّرقِ",40,"ق",1,0],["ولي قوادمُ لو أني جدفت بها","لأنهضتْني ولكن أفرُض زُغُبُ",41,"ب",1,0],["ولي قَلَمٌ في أَنْمُلي إِن هَزْزْتُه","فما ضرَّني أَلاَّ أَهُزَّ المُهنَّدا",42,"د",2,0],["ولْيقصِدوا قلبي المقصودَ قبلَهُم","مِنه فقلبي المُعَنَّى دارُ هِجْرَته",43,"ت",2,0],["وليقطع الشَّيبُ من فودَيَّ مَطْمَعه","فإِنَّني مُستَقِرُّ وسْط جَنَّتِه",43,"ت",2,0],["وَلي قَمرٌ ما بَدا في الدُّجَى","وَأَبصرَهُ البَدْرُ إلّا أَفلْ",44,"ل",1,0],["ولي قلبٌ جريءٌ لا يُبالي","ببذل الروح إِن خطبٌ دهاكا",45,"ك",2,0],["ولي قائِدٌ يَطْوي المراحلَ دَائباً","لِزَورةِ مَثْواهُ ولكنَّ مِنْ حُبّي",46,"ي",1,0],["وليقدرونا مثل قدرِهمُ فلا","يعتز إنسان على إنسان",47,"ن",1,0],["ولي قلم إذا كاتمتُ ما بي","تبين في انتحابي وانتحابه",48,"ب",2,0],["ولي قال ما ترحل ترى إلاّ بحاله","بْعهد الوفا لي منْه نأمل تأميل",49,"ل",1,0],["ولي قلب ولكن غير فظ","شكوت إلى الحبيبة سُوء حظي",50,"ي",1,0],["وَلي قلبٌ كئيبٌ في ال","هَوى قد ذابَ واِحتَرقا",51,"ق",2,0],["ولي قَصائدُ في مَدْحيهِ باهِرَةٌ","تُزهِّدُ البَحْرَ في أَبْهَى جواهِرِهِ",52,"ر",2,0],["وليقولوا بما احبوا وان كنت","وصولا ولم ترعني بصد",53,"د",1,0],["ولي قلم آليتُ أن لا أمدَّه","بفتل مُوارٍ أو بختل موارِب",54,"ب",1,0],["ولي قلب لشقوته ألوف","ينغص عيشتي طول الليالي",55,"ي",1,1],["ولي قلب عليك لما يلاقي","يكافح من سعير الوجد جمرا",56,"ر",2,0],["ولي قلب به قد هام حباً","وجسم في هواه لقد تلاشى",57,"ش",2,0],["وَلْيُقَلِ المَكروبُ فِي كَربِهِ","يَا أكْرَمَ الخَلقِ عَلَى رَبِهِ",58,"ه",1,0],["ولِى قِصَّةٌ فِى الحُبِّ لَو حُكِيَت على","فُحُولِ رِجالٍ لاَستضمالوا بِقِصتَّى",59,"ت",2,0],["ولي قلبٌ شكا بلواهُ حتى","تفطر لوعةً مما شكاه",60,"ا",2,0],["ولي قلم مجيد ضمن كفي","ولولا جود كفك ما أجادا",61,"د",2,0],["ولي قلم تبارك من براه","وعلمه افانين الصياغه",62,"غ",2,0],["وَلي قَدَمٌ عَلى الدُنيا وَأُخرى","وَقَفتُ بِها عَلى جِسرِ المَآلِ",63,"ل",1,0],["ولي قواف إذا أنزلتها بلداً","طارت بهن شياطيي إلى بلد",64,"د",1,0],["ولي قرينان مالي منهما خَلَفٌ","طُولُ الحميمِ وعينٌ دمعها يَكِف",65,"ف",1,0],["ولي قلم يبرى إذا هاج غيظه","يراعي ذمام السيف من شدة الخوف",66,"ف",1,0],["ولي قلب غداة البين عانٍ","بسفح الجزع اشجته الرسوم",67,"م",1,0],["ولي قلم يسيل الحبر منه","كشيخ قد أصيب بضعف ظهر",68,"ر",1,1],["ولي قلبٌ أليمٌ من","صدودك دائم الضَّرمِ",69,"م",1,1],["ولي قصبات السبق في كل حلبة","دفعت اليها بالقوافي النجائب",70,"ب",1,0],["وليقصدوا سائسا للحرب همته","وبأسه ينزلان النجم والجبلا",71,"ل",2,0],["ولي قائد نحو المنايا وسائق","يسوق اليها أو اليّ يسوقها",72,"ه",2,1],["وَلِي قَلبٌ يَذوبُ أسىً وَشَوقاً","وَجِسمِي مِن جَفَاهُ في نُحُولِ",73,"ل",1,0],["وليقنعنك من خلّ إشارته","وفي الإشارة ما يغني عن الكلم",74,"م",1,0],["ولي قمر سماوي المعانيي","تشكل للعيون بشكل ريم",75,"م",1,0],["ولِيقُومُ فُريُونٍ وكلٌّ مُؤَمَّرٌ","عَلى مِئِةٍ مِنهُم تَقِلُّ العَوَالِيا",76,"ي",2,0],["وليقون رام فنيلا وكلٌّ","رمى وكلا العاملين نبا",77,"ب",2,0],["وليقُم بَعضُكُم بِحُرمهِ بَعضِ","فَلَكُم بِالوِفاقِ خَيرُ قَرِينِ",78,"ن",1,0],["وليقم بعضكم بحزمة بعضٍ","وتوالوا في فادح الأدعار",79,"ر",1,0],["وَليقطفنَّ المرَّ وَالطيب الَّذي","عَبقَت رَوائحهُ عَلى خرسانِهِ",80,"ن",2,0],["وَلِيَقضِيَ المُشتاقُ كُلَّ لُبانَة","مِمّا أَكن لَها الفُؤادَ وَأَعلَنا",81,"ن",2,0],["ولي قلم ساب كالأفعوان","على الطرس يقذف دراً نثيرا",82,"ر",2,0],["وليقلوا الأعلام تخفق سوداً","بأيادي في الطعن غير قصار",83,"ر",1,0],["وليقبِسوا منك الضِّياءَ كأنَّهم","شُهُبٌ ووجهُكَ يا أميرُ ذُكاءُ",84,"ا",2,0],["وَلي قَلبٌ تُقَلِّبُهُ شُجُونِى","وَتَمَنعُهُ السَّكينَة وَالهُجُوعَا",85,"ع",2,0],["ولي قلم ان لم يكن في جوائب","يكن في سواها حيثما كنت جائبا",86,"ب",2,0],["ولي قلبٌ عزيزٌ ليس يرضى","بأن يشكو إلى المحبوب حالي",87,"ل",2,0],["ولي قلمٌ إذا جدّ الهجاءُ","يصيرُ كسيفِ جلادٍ شديدِ",88,"د",1,0],["ولِي قَلبٌ يَعُودُ بلا دَوَاءٍ","إِذا جاسَ الطَّبيبُ بهِ وجَسَّا",89,"س",2,0],["وليقرع الدهر سناً ببعده فيه","هام الفضائل والمعروف قد قرعا",90,"ع",2,0],["ولي قلب ألاطفه فيحنو","وإن أسديته نصحا أنابا",91,"ب",2,1],["‏وَ لِي قلبٌ يراكَ وفَقرُ عَينٍ","تَهِيمُ بعجزها في كل وادي",92,"د",2,0],["ولي قلبٌ يرى في الثَّلج لوناً","بديعاً إن سهتْ عنهُ المُقَلْ",93,"ل",1,0],["وَلِي قَلْبٌ تَقَلَّبَ فِى جِهَاتٍ","وَمَا فِي النَّهْرِ شَطٌّ أَوْ سَبِيلُ !",94,"ل",1,0],["ولي قلبٌ يباعدني اغترابا","ويفقدني رشاديَ والصوابا",95,"ب",2,1],["ولي قلبٌ يصلي فيه صمتي","وما سهوًا لسرٍّ قد أذاعا",96,"ع",2,0],["ولْيُقرِئِ الشّوقَ اللذيذَ قصيدةً","عَبَدَتْ يديْهِ وقلبَهُ ولسانَهْ",97,"ن",2,0],["وَلِي قَعْرُ الجَحِيمِ نَعِيمُ جِسْمٍ","أُقَاتِلُهَا قِتَالًا خَالِدِيَّا",98,"ي",2,0],["ولي قلبٌ رقيقٌ مُستهامٌ","لكمْ نزفَ الجراحَ وكمْ تنزَّى",99,"ز",2,0],["ولي قلبٌ على العلَّاتِ جلدٌ","بغيرِ الغيدِ ما إنْ بالعليلِ",100,"ل",1,0],["ولي قلبٌ بهِ تختصُّ (ربحى)","إذا نادتْ بنبضتِهِ يَرُدُّ",101,"د",1,0],["ولي قهوتي السمراء طعم صبابتي","وسيجارة الأفكار رمشٌ كحيلُ",102,"ل",1,0],["ولي قلبٌ على وجعٍ تسامى","ويحسنُ بالإله الحق ظنّا",103,"ن",2,0],["ولي قلبٌ كريمٌ لايُحابي","ويأنفُ في ترفعه اغتيابا",104,"ب",2,0],["ولي قلب يعقوبٍ شجيٌ وصابرٌ","إلى ريحه يهفو لتحيا به النفسُ",105,"س",1,0],["ولي قلبٌ بنارٍ الشوقِ صالٍ","وطرفٌ في مدامعِه غريقُ",106,"ق",1,0],["ولي قدسٌ تركت الناسَ فيها","على خطر ونبض القلب قدسُ",107,"س",1,0],["ولي قلبٌ ‏إذا عصفتْ","به الأشواق يحترقُ",108,"ق",1,1],["ولي قلب من الاهات مضنى","رماه الشوق في كلفٍ فذابا",109,"ب",2,0],["‏وليْ قلبٌ يُعذّبُ باشتياق ٍ","وأصعبُ من خروجِ الروحِ شوقُ",110,"ق",1,1],["ولي قلب يضج به الأنينُ","اذا ذُكَرَ الأحبة يستكينُ",111,"ن",1,1],["ولي قِصَّةٌ ما رواها الورى","فلا عَجَبٌ ليَ أنْ أنبِسا",112,"س",2,0],["ولي قلمٌ يفوق السيفَ فضلاً","ينافحُ في السلامِ وفي القتالِ",113,"ل",1,1],["ولي قصصٌ وأسرابِ الحبارى","فكم تجري وكم أسعى إليها",114,"ي",3,0],["ولي قرّاءُ عنِّي في دفاع","وقاهم ربُّهم شراً أليما",115,"م",2,0],["ولي قمرٌ في آخر الليلِ طالعٌ","بأنوارِهِ لا غيرها أتزمّلُ",116,"ل",1,0],["ولي قلبٌ يحنُّ إليكَ دَوماً","كما حنَّ الغيابُ إلى الإيابِ",117,"ب",1,0],["ولي قلب إنسان بعزم كتيبة","ولستُ لمن عادى الإله أًسالم",118,"م",1,0],["ولي قلب بغيركِ لا يبالي","وحاشا أن تُغيره النساء!",119,"ا",2,1],["وليقبض اللوم عن قلبي تبسطه","فقد طويت بساطاً مده العذل",120,"ل",1,0],["ولي قلب عبثن به الليالي","بفقد أحبتي والفقد داء",121,"ا",2,0],["ولي قَوَادِمُ لَو أنِّي حَذَفْتُ بها","لأَنهَضْتِني ولكنْ أفْرُخي زَغَبُ",122,"ب",1,0],["وَلِي قلَمٌ إذا كاتَمْتُ مَا بِي","تبيَّنَ في انتخابِي وانتخابِهْ",123,"ب",2,0]]}