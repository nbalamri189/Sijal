{"poems":[[108,"سطا حُسناً","https://www.shoaraa.com/p13815",""],[53,"متى أنا قائم أعلى مقام","https://www.aldiwan.net/poem29753.html","الوافر"],[53,"أحن إلى لقائك كل يوم","https://www.aldiwan.net/poem30671.html","الوافر"],[53,"ألا لله بادرة الطلاب","https://www.aldiwan.net/poem30747.html","الوافر"],[63,"حتام تشكو الصدى بيض مباتير","https://www.aldiwan.net/poem45934.html","البسيط"],[51,"للحريثي أبي بكر غبب","https://www.aldiwan.net/poem8500.html","الرمل"],[51,"يا داعيا نحو العلاء مثوبا","https://www.aldiwan.net/poem9252.html","الكامل"],[51,"يا سائلي بأميرنا","https://www.aldiwan.net/poem10871.html","مجزوء الكامل"],[91,"سئمت نفسي الحياة مع الناس","https://www.aldiwan.net/poem8747.html","عموديه"],[91,"كأني في روض أرى الماء جاريا","https://www.aldiwan.net/poem8854.html","عموديه"],[91,"نسي الكنار نشيده","https://www.aldiwan.net/poem8878.html","عموديه"],[85,"على قدر الهوى يأتي العتاب","https://www.aldiwan.net/poem63681.html","الوافر"],[62,"هم الحي ما بين العذيب إلى الرمل","https://www.aldiwan.net/poem52322.html","الطويل"],[48,"ودار يؤدب فيها البزاة","https://www.aldiwan.net/poem62610.html","المتقارب"],[76,"أرقت وقلبي عنك ليس يفيق","https://www.aldiwan.net/poem39255.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39566","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9981","الوافر"],[90,"بين النجف وأمريكا","https://www.poetsgate.com/ViewPoem.aspx?id=178944",""],[45,"أمّا الشّبَابُ فَقَدْ سُبِقْتَ بغَضّهِ","https://www.poetsgate.com/ViewPoem.aspx?id=31122",""],[94,"الكنز المقدّس","https://www.poetsgate.com/ViewPoem.aspx?id=15624",""],[94,"وفاء القبور","https://www.poetsgate.com/ViewPoem.aspx?id=13790",""],[116,"الا يا من به يجلى الظلام","https://www.aldiwan.net/poem40599.html","عموديه"],[116,"تمحضني النصيحة يا عذولي","https://www.aldiwan.net/poem40923.html","عموديه"],[143,"تقاعست عن أبناء دهرى عائفا","https://www.aldiwan.net/poem58353.html","الطويل"],[174,"أمين الله حبك في فؤادي","https://www.aldiwan.net/poem4400.html","عموديه"],[187,"وأفردني الزمان وكل حر","https://www.aldiwan.net/poem43870.html","الوافر"],[200,"تعالي وإن لم تجملي فترفقي","https://www.aldiwan.net/poem45346.html","الطويل"],[205,"يقولون صف حرب الرعية والجند","https://www.aldiwan.net/poem53322.html","الطويل"],[286,"سعد الأمين وأزهرت أفراحه","https://www.aldiwan.net/poem39418.html","الكامل"],[304,"بنفسي من إذا ادكر اكتآبي","https://www.aldiwan.net/poem58250.html","الوافر"],[349,"ولي قلم في عصركم جف ريقه","https://www.aldiwan.net/poem20375.html","الطويل"],[362,"لقد شاقني هذا القوام المهفهف","https://www.aldiwan.net/poem68090.html","الطويل"],[367,"قضى نحبه الصوم بعد المطال","https://www.aldiwan.net/poem17310.html","المتقارب"],[417,"أعالج قلبا في هواكم معذبا","https://www.aldiwan.net/poem54034.html","الطويل"],[417,"ذكرت على النوى عهد التصابي","https://www.aldiwan.net/poem54047.html","الوافر"],[450,"حديث الحب","https://www.aldiwan.net/poem1016.html",""],[465,"أقام الوجد بعدهم وساروا","https://www.aldiwan.net/poem3209.html","عموديه"],[480,"عارف ما الشعر صاغيه","https://www.aldiwan.net/poem37208.html","مجزوء الرمل"],[501,"رقمت في معارفي الأشياء","https://www.aldiwan.net/poem38098.html","الخفيف"],[516,"هم الأحبة إن جاروا وإن عدلوا","https://www.aldiwan.net/poem12223.html","البسيط"],[539,"دعنى من ذكر حداة الأينق","https://www.aldiwan.net/poem47549.html","عموديه"],[568,"الحمد لله نال الناس حظهم","https://www.aldiwan.net/poem69812.html","البسيط"],[576,"سواي يخاف الدهر أو يرهب الردى","https://www.aldiwan.net/poem2749.html","الطويل"],[576,"ما هزة الغصن إلا ملك هزته","https://www.aldiwan.net/poem3094.html","البسيط"],[587,"خذوا قودي من أسير الكلل","https://www.aldiwan.net/poem17697.html","المتقارب"]],"verses":[["ولي قلب إذا قالوا عليٌ","كطير نام وانتبه ارتيابا",0,"ب",2,0],["وَلي قُربى رَؤومٌ كُنتُ أَرجو","يَمينَكَ أَن تُقَرِّبَ لي مَرامي",1,"م",2,0],["وَلي قَلبٌ إِذا ذَكَرَ التَلاقي","تَظَلَّمَ مِن يَدِ البَينِ المُشِتِ",2,"ت",1,0],["وَلي قَبرانِ بِالزَوراءِ أَشفي","بِقُربِهِما نِزاعي وَاِكتِئابي",3,"ب",2,0],["وَلي قَصائِدُ تَحْكي رَوْضَةً أُنُفاً","تَبَسَّمَتْ في حَواشِيها الأَزاهِيرُ",4,"ر",1,0],["وليقُلْ ما شاء في شتمي له","إن طبعي شيمةٌ لا مُكتَسبْ",5,"ب",1,0],["وليقبلنَّ صحيح وُدِّك إنه","لا يدفع الحسنى بما هو أسمجُ",6,"ج",1,0],["ولَّى قَفَاه عبيدَهُ","واعتاد ذاك فصار عادَهْ",7,"د",2,0],["وَليُقَبِّل فَمُ الصَباحِ جَبيني","وَليُعَطِّر أَريجُهُ جِلبابي",8,"ب",2,0],["وَلي قَلَمٌ كَالرُمحِ يَهتَزُّ في يَدي","إِلى الخَيرِ يَسعى وَالرِماحُ إِلى الشَرِّ",9,"ر",1,0],["وَليَقذِفَنَّ بِهِ المَلالُ","مِنَ القُصورِ إِلى القِفار",10,"ر",1,0],["وَلي قَلبٌ بِأَن يَهوى يُجازى","وَمالِكُهُ بِأَن يَجني يُثابُ",11,"ب",1,0],["ولي قِبَلَ الأيامِ منذ صِحِبْتُها","مواعيدُ قد أعلقنَها شرَكَ المطلِ",12,"ل",1,0],["وَلِيٌّ قَفا بَعدَ وَسمِيِّهِ","فَهَمُّكَ مِن كَمأَةٍ مَعدَه",13,"د",2,0],["ولي قَولةٌ في الناسِ لا أَبتغي بها","منَ الناسِ إلا أن يقالَ صديقُ",14,"ق",1,0],["ولي قصةٌ يُشجي القلوبَ حديثُها","ويعجز عن تصويرها اليوم واصفُ",15,"ف",1,0],["وَلي قَلبٌ أَشَدُّ مِنَ الرَواسي","وَذِكري مِثلُ عَرفِ المِسكِ نامي",16,"م",2,0],["ولي قلب حر عصيُّ الزمام","فإن راضه حبُّكم يسلس",17,"س",1,0],["وَلْيَقْنَ تُفّاحُ الخُدودِ، فلَستُ من","تَقبيلِهِ غَزِلاً، وَلاَ مِنْ عَضّهِ",18,"ض",2,0],["ولي قبلات بين نهديك أودعت","شبابي وآمالي العذاب وآلامي",19,"م",2,0],["ولي قبور على الفيحاء غافية","زوّارها الطير والأشواق والقمر",20,"ر",1,0],["ولي قلب يقلب فوق جمر","هواه الخيف والبلد الحرام",21,"م",1,0],["ولي قلب بحبي ذا ولوه","وفكر في الهوى رهن اندهاش",22,"ش",1,0],["ولى قُرباتٌ عندهم غير أنني","أضَنُّ على أفضالهم بفضائلي",23,"ي",1,0],["وَلِي قَلَمٌ إِذَا استَفهَمت عَنهُ","أَشَادَ بِهِ وَأَنشَدَ عَن جَنَانِي",24,"ن",2,0],["ولي قدح أسميّه تغارا","ويشبهه بهيئته التغار",25,"ر",1,0],["ولي قلمٌ كالنابِ ما زالَ مرهفاً","ولكنْ متى ما مسَّهُ الدمعُ يورقِ",26,"ق",1,0],["ولي قلبُ برقٍ تحت رعدِ فكاهةٍ","فأستمطر اللذات بالبرق والرعدِ",27,"د",1,0],["وليقبلوا البشرى بكل بشاشه","من نخبة عدوا بألف عنان",28,"ن",1,0],["ولي قلبٌ إذا ذكر الليالي ال","لتي نلنا بها الاوطار طارا",29,"ر",2,0],["وَلي قَلَمٌ في عَصْرِكُمْ جَفَّ رِيقُهُ","وَيَكفيهِ مِن دُنْياهُ نُغْبَةُ طائرِ",30,"ر",1,1],["وَلي قدم في مَذهَب الحُبّ راسِخ","به في دَواوين الهَوى أَتَصَرَّف",31,"ف",1,0],["وَلي قَلَمٌ مِنهُ عَينُ الكَلا","مِ تَجري فَتَنظُرُ عَينَ الكَمالِ",32,"ل",1,0],["ولي قلمٌ يملي عليك إذا جرى","وترجمَ عمّا في الضَّمير وأعربا",33,"ب",2,0],["ولي قلبٌ تَوَقَّدَ في التهابٍ","ولي دمع توالى بانسكاب",34,"ب",1,0],["ولي قلب توجهه عيون","تخلى عنه مرشده وعني",35,"ن",2,0],["ولي قلبٌ يبتهج هواه نجدٌ","وقدماً كان يطربهُ الحيار",36,"ر",1,0],["وليقم كل بواجبه","وليصافح كف عافيه",37,"ي",2,0],["وليقطع الخائنين واغلط عليهم","إنَّما أهلُ دِينِنا الأَمَناءُ",38,"ا",2,0],["وليقبضوا اللوم عن قلبي ببسطتهم","فقد طويت بساطاً مده العذل",39,"ل",1,0],["وليقف لحظُكَ بالأرضِ أُختهَا","تنسَابُ في مُنعَرَجاتِ الطُّرقِ",40,"ق",1,0],["ولي قوادمُ لو أني جدفت بها","لأنهضتْني ولكن أفرُض زُغُبُ",41,"ب",1,0],["ولي قَلَمٌ في أَنْمُلي إِن هَزْزْتُه","فما ضرَّني أَلاَّ أَهُزَّ المُهنَّدا",42,"د",2,0],["ولْيقصِدوا قلبي المقصودَ قبلَهُم","مِنه فقلبي المُعَنَّى دارُ هِجْرَته",43,"ت",2,0],["وليقطع الشَّيبُ من فودَيَّ مَطْمَعه","فإِنَّني مُستَقِرُّ وسْط جَنَّتِه",43,"ت",2,0],["وَلي قَمرٌ ما بَدا في الدُّجَى","وَأَبصرَهُ البَدْرُ إلّا أَفلْ",44,"ل",1,0]]}