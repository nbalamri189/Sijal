etsgate.com/ViewPoem.aspx?id=202804",""],[5174,"أُمَّ الْبَيَانِ","https://www.poetsgate.com/ViewPoem.aspx?id=188618",""],[5183,"هبة العليم","https://www.poetsgate.com/ViewPoem.aspx?id=180194",""],[5189,"له في العشق أذواقا","https://www.poetsgate.com/ViewPoem.aspx?id=213143",""],[5219,"إليك يا سيدي يا رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=193700",""],[5232,".. الشاعرة الحسناء ..","https://www.poetsgate.com/ViewPoem.aspx?id=211254",""],[5271,"يا كلَّ البخلِ !!","https://www.poetsgate.com/ViewPoem.aspx?id=62009",""],[5277,"ما زلتُ..ولم أزلْ","https://www.poetsgate.com/ViewPoem.aspx?id=197880",""],[5277,"جوريّة قيسية","https://www.poetsgate.com/ViewPoem.aspx?id=200587",""],[5324,"أطلق لجام الغيظ.","https://www.poetsgate.com/ViewPoem.aspx?id=210996",""],[5376,"أتاك قلبي ببعضِ الصمتِ يختصرُ","https://www.poetsgate.com/ViewPoem.aspx?id=214061",""],[5410,"الصبر من صبري اشتكى","https://www.poetsgate.com/ViewPoem.aspx?id=141974",""],[5419,"أنت الأميرة","https://www.poetsgate.com/ViewPoem.aspx?id=32268",""],[5458,"رحم الله أم ديبو","https://www.poetsgate.com/ViewPoem.aspx?id=72164",""],[5561,"كما تشائين","https://www.poetsgate.com/ViewPoem.aspx?id=201390",""],[5596,"لطف الاعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=206379",""],[5628,"أميرة الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=178481",""],[5628,"ابتهالات في محراب الورد","https://www.poetsgate.com/ViewPoem.aspx?id=178665",""],[5628,"عيناك مرفئي","https://www.poetsgate.com/ViewPoem.aspx?id=179812",""],[5829,"العبد التائب","https://www.poetsgate.com/ViewPoem.aspx?id=148784",""],[5829,"سعير الوجد","https://www.poetsgate.com/ViewPoem.aspx?id=152056",""],[5956,"الحب العاقرُ","https://www.poetsgate.com/ViewPoem.aspx?id=182020",""],[5956,"يا خالقَ الأكوان","https://www.poetsgate.com/ViewPoem.aspx?id=194028",""],[5956,"طمئنّي عنك","https://www.poetsgate.com/ViewPoem.aspx?id=194621",""],[161,"قَلْنَا لِغَزَّةَ : ...","https://www.poetsgate.com/ViewPoem.aspx?id=175084",""],[6235,"معزوفة الصدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77692&r=&rc=7",""],[6273,"قواف ٍ في ركب السراة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78507&r=&rc=5",""],[5190,"ما كنت محض قصيدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78368&r=&rc=76",""]],"verses":[["أنت الإمام ابنُ الإمام ابنِ الإما","م ابنِ الإمام وفخرها لا يُعدَلُ",0,"ل",1,0],["أَنتَ الأَمينُ أَمينُ اللَهِ لا سَرِفٌ","فيما وَليتَ وَلا هَيّابَةٌ وَرَعُ",1,"ع",1,0],["أنتَ الإمام وربّ كلّ رسالة","يوم الفخار وراءك المأموم",2,"م",1,0],["أنتَ الأميرُ الذي ولَّتْهُ هِمَّتُهُ","بغير عهدٍ من السلطان معْهُودِ",3,"د",1,0],["أنتَ الأميرُ وغيرُكُ المأمورُ","وعظيمُ شغلٍ في جداكَ يسيرُ",4,"ر",1,0],["أَنتِ الأَميرَةُ فَاِسمَعي لِمَقالَتي","وَتَفَهَّمي مِن بَعضِ ما لَم تَفهَمي",5,"م",2,0],["أنتَ الأميرُ على الأُلى اتّبعوا الهُدَى","والحقَّ من هَمْدانَ أو أنتَ الأبُ",6,"ب",1,0],["أنت الأذلُّ فَقُلْها غيرَ كاذبةٍ","إن كنتَ حُرّاً فبئس الكاذبُ الأشِرُ",7,"ر",1,0],["أَنتَ الأَمينُ الَّذي مِن بَعدِ صاحِبِهِ","أَلقَت إِلَيكَ مَقاليدَ النُهى البَشَرُ",8,"ر",1,0],["أَنْتَ الأميرُ المُعيدُ أَلْسُنَنا","كالعُودِ منه بِذِكْرِهِ رَطْبَهْ",9,"ب",2,0],["أَنتِ الأَميرَةُ في روحي وَفي جَسَدي","فَاِبري وَريشي بِكَفَّيكِ الأَقاليدُ",10,"د",1,0],["أَنتِ الأَميرَةُ في الهَوى","وَأَنا المُسيءُ المُذنِبُ",11,"ب",1,0],["أَنْتِ الأَمِيرَةُ مَنْ أَسْمَى بِهَا أَحداً","فَقَدْ عَنَاكِ بِهَا وَصْفاً وَأَسْمَاكِ",12,"ك",1,0],["أَنْتَ الأَمِيرُ وَمَنْ يَكُنْهُ بِالْحِجَى","فَلَهُ بِهِ تِيهٌ عَلَى الأُمَرَاءِ",13,"ا",2,0],["أَنْتَ الأَمِينُ البِرُّ","مَحْمُودُ المَنَاقِبِ وَالخِصَالِ",14,"ل",1,0],["أنتَ الأديبُ ولم أَعثرُ على لقبٍ","في معجم المجد يحكي ذلك اللَّقَبا",15,"ب",2,0],["أَنتَ الأَمين عَلى العُلوم وَمِن بِهِ","يَثق الرَجاءُ وَتَأمن الأَسرارُ",16,"ر",1,0],["أَنتَ الإِمامُ الَّذي قَد كُنتُ آمُلُهُ","وَذا الزَمانُ الَّذي قَد كُنتُ أَرتَقِبُ",17,"ب",1,0],["أَنتَ الأَسيرُ الخافِقُ","كَخفوقِ قَلبي في البَدن",18,"ن",1,0],["أنت الإمام المبينُ حكمتَه","والعالمُ الفردُ ذو الِّلسانين",19,"ن",1,0],["أَنتَ آلُ العُفاةِ أَرسَلَكَ اللَ","هُ لَنا رَحمَةً وَغَيرُكَ آلُ",20,"ل",1,0],["أَنتَ الإِمامُ المَهدِيُّ لَيسَ لَنا","إِمامُ حَقِّ سِواكَ يُنتَظَرُ",21,"ر",1,0],["أنت الإمام على الأئمة كلّهم","في ساحة الأقصى بخير رفاق",22,"ق",1,0],["أَنتَ الأَميرُ فَعِشتَ أَطيَبَ عيشَةٍ","وَالناسُ كُلُّهُم لَكَ المَأمورُ",23,"ر",1,0],["أنت الامام بك العوالم تقتدي","أنت الوحيد الشهم أنت الأهيب",24,"ب",1,0],["أنت الامين بك الحدود تأمنت","وغدا العدو بذوق كاس هوان",25,"ن",1,0],["أَنتَ الأَميرُ الَّذي تَحنو الرُؤوسُ لَهُ","قَماقِمُ القَومِ مِن بَرٍّ وَآفاقِ",26,"ق",1,0],["أَنتَ الاِمام المُفَدّى","اِن سلم الضدّ أَو لَم",27,"م",1,0],["أنتَ الأميرُ بأرضي والزَّمان بِها","عادٍ وقَد جِئتُ أستَعدي على العادي",28,"ي",1,0],["أنت الإله الحي وال","قيوم في معنى بقائك",29,"ك",1,0],["أَنتَ الاِمامُ وَمَنظورُ الأُنامِ فَمن","يرد ما قُلتُهُ يُقمَع براهينا",30,"ن",2,0],["أنت الأخير زمانه ونظامه","أربى على أهل الطراز الأول",31,"ل",1,0],["أنت الأمير ووجه الشمس مُلْتثمٌ","واليوم ليلٌ بركض الخيل غربيب",32,"ب",1,0],["أنتَ الإمامُ السَّمْحُ ، والعَلَمُ الذي","أبَدا ً مَعالِمُ وَجْهِه ِ تَستَبشِرُ",33,"ر",1,0],["أنت الأمير على الحقيق","ة أن يكنُهْ سواك نبزا",34,"ز",2,0],["أنتَ الأميرُ على الأنامِ كما على ال","أيامِ يَومُكَ يا أميرُ أميرُ",35,"ر",1,0],["أَنتَ الأَمينُ الَّذي عَمَّت مَكارِمُهُ","مَن حَلَّ في الأَرضِ مِن عُجمٍ وَمِن عَرَبِ",36,"ب",1,0],["أَنتَ الأَميرُ الذي مازالَ يأْمرُ بال","معروفِ نفساً عَنِ الأَوزارِ ناهيها",37,"ي",3,0],["أنتِ الأمينُ على هذا الأمينِ فلا","تُسلِّمي نُورَ ذاكَ الوَجهِ للدُودِ",38,"د",1,0],["أَنت الأَخيرُ هوىً وأَنت الأَولُ","فلذاكَ أَنت عَلى الملاحِ مفَضَّلُ",39,"ل",1,1],["أنتَ الأمينُ وفيك العزّ قد ثبتت","منهُ القواعد بالإقدامِ والهممِ",40,"م",1,0],["أنتَ الأميرُ على الملاح ومن يجُر","في حكمه إلّا جفونك يعزل",41,"ل",1,0],["أَنتَ الإِمام العَدل وَالعلَمُ الَّذي","يَهدي إِلى دين الهُدى إِيمانه",42,"ن",2,0],["أَنت الإمامُ الذي اِنقاد الأنام له","وملّكته مقاليد النهى الأممُ",43,"م",1,0],["أنْتِ الأميرُ وأنْتِ خَصمي فاحْكُمي","لِي أو عَلَيَّ فَلنْ أُسائِلَ ذا لِمَهْ",44,"م",2,0],["أنت الأمير لمن تلب","بيه وتنجد إذ دعاك",45,"ك",1,0],["أنت الأحق بها وإن لم تستطع","سبقاً إليها يا ابنَ ديني فالْحَقِ",46,"ق",1,0],["أنت الأحق بأن تعين حماتها","وتجيرها إن خانها أمناؤها",47,"ا",3,0],["أنتِ الإماراتُ رايَاتٌ مرفرفةٌ","إذا التقتْ لا تُضَاهى في تلاقيها",48,"ي",3,0],["أنتِ الإماراتُ سَيفٌ كلما لمَعَتْ","بُروقُهُ فزعَتْ خوْفاً أعادِيهَا",48,"ي",3,0],["أنتَ الإمامُ ابنُ الإمامِ لأُمَّةٍ","أضحى ببكفِّكَ فَقرُها وغِناها",49,"ا",3,0],["أنْتَ الإمَامُ وَمَنْ عَدَاكَ رَعِيَّةٌ","أنْتَ المُقَدَّمُ وَالوَرَى أعْوَانُ",50,"ن",1,0],["أَنتَ الأَمينُ عَلى الدُنيا فَكَيفَ غَدَت","بِلُطفِكَ الساحر الأَرواحُ تَنتَهِبُ",51,"ب",1,0],["أنت الأمين على أمانتنا التي","ثقلت على الأفلاك والأطواد",52,"د",1,0],["أَنت الأجلُّ الأوحدُ","والنَّاسُ أَلقوا رَحلَهُمْ",53,"م",1,0],["أنت الأمين على البلاد فَشُدْ قَوا","نينَ العبادِ برأيك الضوّاء",54,"ا",2,0],["أنت الإله ابن الإله وما","في الله أنت عليه مشتمل",55,"ل",1,0],["أنْت الاكرم لَوْ تسامح يَا سموح","عمر قَلْبك بالسماحه مَا بخل",56,"ل",1,0],["أنتَ الأخِيرُ زَمَانُهُ وَقَدِ اعتَدى","مَنْ قَالَ إنَّ الفَضْلَ لِلمُتَقَدّمٍ",57,"م",1,0],["أَنتَ إِلا نَجل فرا","ءٍ تَغذى بِشَقاء",58,"ا",2,0],["أنتَ الإمامُ الذي نَرجو بطاعته","خُلدَ الجنانِ إذا النيران تستَعرُ",59,"ر",1,0],["أنتَ الإمامُ الذي بالبرّ نعرفُهُ","إعتامَهُ لدَوامِ النعمَةِ القدَرِ",60,"ر",1,0],["انت الامام المستضاء بنوره","في ملة قد ثم فيك مرامها",61,"م",3,0],["أَنتَ الأَبِيُّ لَكُم في كُلِّ بارِحَةٍ","رَأيٌ حَصيفٌ يُعَزّي كُلَّ ذي شَجَنِ",62,"ن",1,0],["أنت الأمير بحسنه","ما الحسن الا بعض جندك",63,"ك",1,0],["أَنتَ الأَحق بِتَقديم الملاك له","وَالرسل تَقديم مخدوم عَلى خدم",64,"م",1,0],["أنْتَ الأمِيرُ عَلى الشّآمِ وَثَغرِها","وَالرّقّتَينِ وَما حَوَاهُ المَشْرِقُ",65,"ق",1,0],["أنت الإمام المجتبى","واللَه خصك بالتصرف",66,"ف",1,0],["أنت الأخير زمانه لكن تلت","سور التقدم همة لا تحجم",67,"م",1,0],["أنت الاحق بعقد بيعتها ضحى","وهو الاحق بان يعيش وحيدا",68,"د",2,0],["انت الأَديبُ كَما سُميتَ وحبذا","إِسمٌ نَراهُ عليك قام دَليلا",69,"ل",2,0],["انتَ الامين على وداد خليلهِ","وانا كذلك للأمين خَليلُ",70,"ل",1,0],["أنت الامام لكل من أم الهدى","والدين بالاجماع والاصفاق",71,"ق",1,0],["أنتَ الإمامُ لبعض السهو تحملُه","وبعضُه يُحبط الأعمال والحرما",72,"م",2,0],["أنت الإمام فمن أدعو وحضرتك ال","دنيا فأين أقضي بعض أوطاري",73,"ي",1,0],["أنتَ الالهُ الكَريمُ الواحِد الصَمَدُ","فَهَلّا عَلى غَيرِ عَون مِنكَ يَعتَمِدُ",74,"د",1,1],["انت الامام المصطفى وكفى بذا","علماً لوصفٍ جاء في ميعادهِ",75,"د",2,0],["أنت الإمَامُ المُرتضَى الشَّيخُ الرِّضى","وابنُ الرَّسُولِ المُصطَفَى المُحتارِ",76,"ر",1,0],["انت الأميرُ وإِنَّ امرك نافذٌ","فينا بلا ردٍّ وحُكمُكَ مُطلَق",77,"ق",1,0],["انتِ الأَمانُ لخائفٍ","في مَوقِفِ العدلِ الفزيعِ",78,"ع",1,0],["أنت الاسير الخافق","وأنا كذلك مرتهن",79,"ن",1,0],["أنت الأمين عليه وهو معتقد","أن الأمانة ضرب من مزاياكا",80,"ك",2,0],["أنت الأمين على شريعة أحمد ال","هادي ونافي الشك عن أحكامها",81,"م",3,0],["انتَ الامين عَلى الأَنام","فارأف بِنا نحنُ العَبيد",82,"د",1,0],["انتَ الامين المُرتَضى","وَشعاع مصباح أَضا",82,"ض",2,0],["انتَ الأَمين الَّذي نادى مورخهُ","قَد نالَ حَتماً رِضى المَولى محاسبهُ",83,"ه",1,0],["انتَ الامين عَلى خَزائن رَبهِ","وَموزّع الوَزنات كَي تتضعفا",84,"ف",2,0],["أَنت الأَثير لك الوجود ضرورة","وعلى وجودك ضدك المصداق",85,"ق",1,0],["أنتَ الأمين على العهود بلا مرا","بصفاءِ ودٍّ ليس يدركُه عكر",86,"ر",1,0],["أنت الأسيرُ على المجازِ وإنَّني","لعلي الحقيقة في هواكَ أسيرُ",87,"ر",1,0],["أنت الإِمامُ المستبينُ لنا به","نهجُ الهداية والسَّبيلُ اللاحِب",88,"ب",1,0],["أنتَ الأَنيسُ إذا عَرتنِيَ وَحشةٌ","وَبكَ الملاذُ إذا تَغيَّر حالي",89,"ل",2,0],["أَنت الإِمام الهمام المُرتَضى أَبَداً","عندَ الحَبيب فأدرِكني بِنَيل وَطر",90,"ر",1,0],["أَنتَ الأَجَلّ الجَليل","أَنتَ الخَليل الكَفيل",91,"ل",1,0],["أنت الامين على جمي","ع خزائن الاسرار سرَّا",92,"ر",2,0],["أنت الأمير حقيقة فإذا","قيل الأمير لك ارتقى الفكر",93,"ر",1,0],["أنتِ الأميرة ُ في قلبي فلا تقفي","تقدمي فبكِ الجنّاتُ غنّاءُ",94,"ا",2,0],["أنت الأميرة فاحكمي وتملكي","قلبي المتيم فهو من أسراك",95,"ك",1,0],["أنتَ الأراضي والقُرى وسَماؤها","عِزُّ النَّخيلِ ونكهةُ الدُّرَّاقِ",96,"ق",1,0],["انت الأمل والحال والمال