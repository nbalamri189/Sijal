{"poems":[[77,"ما لقلبي إذا هفا البرق حنا","https://www.aldiwan.net/poem36076.html","الخفيف"],[0,"لمن طلل بين الجدية والجبل","https://www.aldiwan.net/poem84.html","الطويل"],[70,"يا من لعين أرقت","https://www.aldiwan.net/poem43000.html","المجتث"],[77,"ما لقلبي إذا هفا البرق حنا","https://www.poetsgate.com/ViewPoem.aspx?id=34163",""],[0,"لمن طللٌ بين الجُديةِ والجَبلْ","https://www.poetsgate.com/ViewPoem.aspx?id=52172",""],[126,"يا أميم انظري عذاب المشوق","https://www.aldiwan.net/poem50565.html","الخفيف"],[133,"لمهندس الكون العظيم","https://www.aldiwan.net/poem49099.html","مجزوء الكامل"],[184,"يا قاتلا نفسه باللوم والعذل","https://www.aldiwan.net/poem43482.html","البسيط"],[195,"حب تغلغل في الصميم","https://www.aldiwan.net/poem39893.html","مجزوء الكامل"],[268,"ركبت فهزني طربي","https://www.aldiwan.net/poem35269.html","مجزوء الوافر"],[326,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[362,"شاق الحمام إليك لما ناحا","https://www.aldiwan.net/poem60965.html","الكامل"],[466,"أدب يهرول خلفه السمع","https://www.aldiwan.net/poem59908.html","أحذ الكامل"],[493,"أنعت جهما لم أجد فيما مضى","https://www.aldiwan.net/poem10223.html","الرجز"]],"verses":[["لِمَّةٌ وَدَّهَا الْخِضَابُ وَغُصْنٌ","هَزَّ مِنْهُ الشَّبَابُ غَضّاً لَدْنَا",0,"ن",2,0],["لِمَه تَقتُلى المَشهُورَ والفَارِسَ الذي","يُفَلِّقُ هَامَاتِ الرِّجَالِ بِلَا وَجَل",1,"ل",1,0],["لِمُهجَتي وَعَبرَتي","قَد قَيَّدَت وَأَطلَقَت",2,"ت",1,0],["لمة ودها الخضاب وغصن","هز منه الشباب غصنا لدنا",3,"ن",2,0],["لِمَهْ تقتلى المشهور والشاعر الذى","يفلّق هامَات الرجال بلا وَجَلْ",4,"ل",1,0],["لَم هذا الغرامُ فيمَنْ جفاني","ودَعاني وَوَجْدى وخلَّى طريقي",5,"ق",2,0],["لمهندس الكون العظيم","كل المحامد والثناءْ",6,"ا",2,1],["لمها فمن طبعها إن سومحت نزلت","إلى القبائح في الأفعال والكسل",7,"ل",1,0],["لمهفهف الحسن رص","ع وجنتيه بالنجوم",8,"م",1,0],["لمهرِكَ مَرجُنا ولكَ ال","ضيافةُ فاستَجب طلبي",9,"ي",1,0],["لم هذا الإسراف في الخلق يا رب","أهديا تريدهُ أم ضلالا",10,"ل",2,0],["لِمُهَلّبٍ بكُم وأنْصارِ النّبِي","حَقٌ إذا استَوضَحْتَه استيضاحا",11,"ح",2,0],["لِمُهَذَّبٍ تَعلو أَنامِلُهُ","ما إِن يَثورُ لِنَظمِهِ نَقعُ",12,"ع",1,0],["لمهجة لو رمت منها عوضا","لم تكن الأرض وما فيها رضى",13,"ض",2,0]]}