{"poems":[[79,"ما لقلبي إذا هفا البرق حنا","https://www.aldiwan.net/poem36076.html","الخفيف"],[0,"لمن طلل بين الجدية والجبل","https://www.aldiwan.net/poem84.html","الطويل"],[72,"يا من لعين أرقت","https://www.aldiwan.net/poem43000.html","المجتث"],[79,"ما لقلبي إذا هفا البرق حنا","https://www.poetsgate.com/ViewPoem.aspx?id=34163",""],[0,"لمن طللٌ بين الجُديةِ والجَبلْ","https://www.poetsgate.com/ViewPoem.aspx?id=52172",""],[132,"يا أميم انظري عذاب المشوق","https://www.aldiwan.net/poem50565.html","الخفيف"],[139,"لمهندس الكون العظيم","https://www.aldiwan.net/poem49099.html","مجزوء الكامل"],[190,"يا قاتلا نفسه باللوم والعذل","https://www.aldiwan.net/poem43482.html","البسيط"],[201,"حب تغلغل في الصميم","https://www.aldiwan.net/poem39893.html","مجزوء الكامل"],[275,"ركبت فهزني طربي","https://www.aldiwan.net/poem35269.html","مجزوء الوافر"],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[369,"شاق الحمام إليك لما ناحا","https://www.aldiwan.net/poem60965.html","الكامل"],[473,"أدب يهرول خلفه السمع","https://www.aldiwan.net/poem59908.html","أحذ الكامل"],[500,"أنعت جهما لم أجد فيما مضى","https://www.aldiwan.net/poem10223.html","الرجز"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138252",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48559","الرمل"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96568","الطويل"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101980","الكامل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109202","الكامل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96032","الكامل"],[2491,"","https://poetry.dctabudhabi.ae/diwan/poem/115087","الوافر"],[2684,"","https://poetry.dctabudhabi.ae/diwan/poem/131460",""],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79704","الخفيف"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79725","الرمل"],[3291,"","https://poetry.dctabudhabi.ae/diwan/poem/106694","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89319","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91250","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114374","المتقارب"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2543","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111455","الطويل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44890","الرمل"],[4110,"","https://poetry.dctabudhabi.ae/diwan/poem/101161","البسيط"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136412",""],[4831,"العَيْنانِ الخَضْراوانِ","https://www.poetsgate.com/ViewPoem.aspx?id=208014",""],[5376,"دَهُرْتَ أمْ بَلَغَتْ روحٌ تراقيها","https://www.poetsgate.com/ViewPoem.aspx?id=197734",""],[5409,"أضحكتنا ورب ضحكٍ بكاء","https://www.poetsgate.com/ViewPoem.aspx?id=155244",""],[5431,"خرّتْ لأجلك خيلُ الشوق لاجبةً","https://www.poetsgate.com/ViewPoem.aspx?id=184526",""],[5431,"حشد الرعاع ...","https://www.poetsgate.com/ViewPoem.aspx?id=202871",""],[5720,"حِبْر","https://www.poetsgate.com/ViewPoem.aspx?id=214577",""],[5790,"لمهيار مصرٍ أسجل الفضل عندنا","https://www.poetsgate.com/ViewPoem.aspx?id=111915",""]],"verses":[["لِمَّةٌ وَدَّهَا الْخِضَابُ وَغُصْنٌ","هَزَّ مِنْهُ الشَّبَابُ غَضّاً لَدْنَا",0,"ن",2,0],["لِمَه تَقتُلى المَشهُورَ والفَارِسَ الذي","يُفَلِّقُ هَامَاتِ الرِّجَالِ بِلَا وَجَل",1,"ل",1,0],["لِمُهجَتي وَعَبرَتي","قَد قَيَّدَت وَأَطلَقَت",2,"ت",1,0],["لمة ودها الخضاب وغصن","هز منه الشباب غصنا لدنا",3,"ن",2,0],["لِمَهْ تقتلى المشهور والشاعر الذى","يفلّق هامَات الرجال بلا وَجَلْ",4,"ل",1,0],["لَم هذا الغرامُ فيمَنْ جفاني","ودَعاني وَوَجْدى وخلَّى طريقي",5,"ق",2,0],["لمهندس الكون العظيم","كل المحامد والثناءْ",6,"ا",2,1],["لمها فمن طبعها إن سومحت نزلت","إلى القبائح في الأفعال والكسل",7,"ل",1,0],["لمهفهف الحسن رص","ع وجنتيه بالنجوم",8,"م",1,0],["لمهرِكَ مَرجُنا ولكَ ال","ضيافةُ فاستَجب طلبي",9,"ب",2,0],["لم هذا الإسراف في الخلق يا رب","أهديا تريدهُ أم ضلالا",10,"ل",2,0],["لِمُهَلّبٍ بكُم وأنْصارِ النّبِي","حَقٌ إذا استَوضَحْتَه استيضاحا",11,"ح",2,0],["لِمُهَذَّبٍ تَعلو أَنامِلُهُ","ما إِن يَثورُ لِنَظمِهِ نَقعُ",12,"ع",1,0],["لمهجة لو رمت منها عوضا","لم تكن الأرض وما فيها رضى",13,"ض",2,0],["لمهارة في الطب ضم حصافة","وذكاء فهم كان فيه الأوحدا",14,"د",2,0],["لم هذا النوم عن حفظ الحمى","وهو يدعوكم ويشكو الألما",15,"م",2,0],["لمَهرِيّةٍ ما بين مقبِصِها الحصى","وبين الذُرى منها مهاوٍ متالِفُ",16,"ف",1,0],["لمهذب زاكي الأرومة ماجد","من يومه عشق العلى فأصابها",17,"ب",3,0],["لمهمة بلدية ولَيتها","إذ كنت أدرى العارفين بحالها",18,"ل",3,0],["لمهاجرين إلى المهيمن حسبة","جعلوا الشهادة للسعادة سلما",19,"م",2,0],["لِمَهلِكِ فِتيةٍ تَركُوا أَباهُم","وأصغَرُ ما بِهِ مِنهُم عَظيمُ",20,"م",1,0],["لمه شأظلم وانت عادل القد","وسيرتك في الناس طالبيه",21,"ي",2,0],["لم هذي الغصون ترقص دوني","ولم الطير مولع بالغناء",22,"ا",2,0],["لم هذي الأزهار تبسم في الروض","كأن لم تكن مع الأحياء",22,"ا",2,0],["لم هذا الطير صداح شج","لم هذا النجم خفاق برم",23,"م",1,0],["لم هذا الغصن كالشيخ الهرم","لم هذا الزهر كالقلب السقم",23,"م",1,0],["لم هذا الروض يمسي مسرحا","للبلايا ومحلا للندم",23,"م",1,0],["لِمهبِطِ وحيِ اللهِ والمرتبَعِ الذي","يُغادِيه من عَينِ اليَقينِ سِجَامُ",24,"م",1,0],["لمهجتي ذمة في طيبةٍ شُغِفت","فهل تطيب بأوفى الخلق للذمم",25,"م",1,0],["لمهفهفٍ وَدّعتُه","وَسَرى وسرّ شَوامتي",26,"ت",2,0],["لمهدي صلاتٍ","رسولِ السلام",27,"م",1,0],["لِمَهلَكِ أَفراسٍ أُصِبنَ وَرُبَّما","أَصابوا بِها أَمثالَها ثُمَّ أَكثَرا",28,"ر",2,0],["لِمُهجَةِ هَكطُورَ الحَدِيثُ مُؤَلِّماً","جَرَى جَرَى جَريَ سَهمٍ بِالمَفَاصِلِ يَنشَبُ",29,"ب",1,1],["لِمَ هَذا ما الَّذي جَدَّ عَلَيك","فَمضَيتَ اليَومَ تُحيي ما اِندَثَرْ",30,"ر",1,0],["لَمَ هَذا أَفلا زِلتَ سَجينا","أَفَلَم تَجعل هَواكَ اليَومَ دينا",30,"ن",2,0],["لمهدي ابن علي كل مكرمة","لو رام أخمصها العيوق لم ينل",31,"ل",1,0],["لمهرجان الفرس كيف انتظار","وليس لي عنك إليه اصطبار",32,"ر",1,1],["لمَةٌ مُنَمْنَمةٌ عَلاها شامِخٌ","أنِفٌ فيا لَلْرِفْعَةِ الشمَّاءِ",33,"ا",2,0],["لِمهجةِ المرءِ أنفاسٌ وعاطفةٌ","لا تكْبَحَنَّ بها فالحبُّ يُحييها",34,"ي",3,0],["لمةٌ من بني الشوارع عاشت","حيث عاش الأعيارُ واللقطاء",35,"ا",2,0],["لمهجة القلب أنغامٌ أرتلها","وهبته الروح علّ الروح تكفيه؟",36,"ي",2,0],["لمهانة الإنسان وهْو","يظنّها خير اختراع!!",37,"ع",1,0],["لِمَ هٰكذا يا سائلَ الإبداعِ ؟","رَوَّعتني في مَلْبَسِي وَيَرَاعِيْ",38,"ي",1,1],["لمهيار مصرٍ أسجل الفضل عندنا","وأبطلت الدعوى لمهيار فارس",39,"س",1,1]]}