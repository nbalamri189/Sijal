5745",""],[520,"عسى منجد الأظعان يوما يغيرها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577553",""],[5724,"ما رفرفت فوق هام العرب رايات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55140&r=&rc=7",""],[6264,"مولد النور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79129&r=&rc=37",""],[6339,"وطن النماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87894&r=&rc=6",""]],"verses":[["يَومَ بَني الصِمَّةِ في عَرضِ اللَوى","وَيَومَ بِساطامِ بنِ قَيسٍ بِالحَسَن",0,"ن",1,0],["يَؤُمُّ بِنا أرْضَ العِراقِ رَكائِبٌ","تَقُدُّ بأيْديها أديمَ الفَلا نُجْبُ",1,"ب",1,0],["يوم به كل عين غير مبصرة","إذ كان إنسانها في الدمع منغمرا",2,"ر",2,0],["يوم به البرق رجّ الرافدين أسىّ","غداة أدّى إلى أقصاهما الخبرا",2,"ر",2,0],["يوم به فاض فيض الشعر منتظماً","كما به فاض فيض الدمع منتثرا",2,"ر",2,0],["يؤُمُّ بها أرضَ العراق مُشَاوِرٌ","وقد عاثَ في السَّرْحِ المسَيَّبِ ذيبُ",3,"ب",1,0],["يَومٌ بِغُمّى تُجلى بِطَلعَتِهِ ال","غَمّاءُ أَو لَيلَةٌ بِقُطرُبُلِ",4,"ل",1,0],["يَؤُمُّ بِها المَوماةَ مِن لَن تَرى لَهُ","إِلى اِبنِ أَبي سُفيانَ جاهاً وَلا عُذرا",5,"ر",2,0],["يَومَ بُزاخاتٍ وَرَدنَ وِردا","وَعُدَّ لي بَدراً وَعُدَّ أُحدا",6,"د",2,0],["يَومُ بَكرِ بنِ وائِلٍ بِقِضاتٍ","دونَ يَومِ المُحَمَّرِ الزِنديقِ",7,"ق",1,0],["يَومٌ بِهِ أَخَذَ الإِسلامُ زينَتَهُ","بِأَسرِها وَاِكتَسى فَخراً بِهِ الأَبَدُ",8,"د",1,0],["يَومٌ بِهِ أَرَّخَ الإِسلامُ غُرَّتَهُ","وَأَدرَكَ الدِّينُ فيهِ ذِروَةَ النُّجُمِ",9,"م",1,0],["يَؤُمُّ بِها أَرضاً عَلَيَّ كَريمَةً","وَمُرتَبَعاً فيها إِلَيَّ حَبيبا",10,"ب",2,0],["يومَ بدرٍ وأنت أعلى مَقاما","إن ذكرنا من بعدِكَ الأيّاما",11,"م",2,1],["يومٌ بداجية الزَّمان ضياءُ","وبَهاؤه للخافقيْن بهاءُ",12,"ا",2,1],["يَؤُمَ بِرِبعِيٍّ كَأَنَّ زُهائَهُ","إِذا هَبَطَ الصَحراءَ حَرَّةُ راجِلِ",13,"ل",1,0],["يؤمُّ بها ربُّ الجزيرة مصره","وما هيَ إلَّا فرحةٌ وأغاني",14,"ن",2,0],["يَوْمٌ بِهِ طَنَّتِ الأَسْمَاعُ مِنْ طَرَبٍ","كَأَنَّ فِي كُلِّ أُذْنٍ سِلْكَ طُنْبُورِ",15,"ر",1,0],["يَومٌ به بَسَطَ السُّرُورُ شُعَاعَه","وأَعَار ثَوْبَ صَباحِه لِمَسَائه",16,"ا",3,0],["يَوْمَ بَيْعي النَّفْسَ منها أَرَبُونا","لاأقالَ اللهُ لي منْ حبِّها",17,"ه",2,0],["يَؤمّ برِبْعّيٍ، كأنّ زُهاءَهُ،","إذا هَبَطَ الصّحراءَ، حَرّة ُ راجلِ",18,"ل",1,0],["يومٌ بأرواحٍ يباعُ ويشتَرى","وأخوه ليس يُسامُ فيه دِرهمُ",19,"م",1,0],["يَومٌ بِهِ اِعتَلَّت مَصابيحُ الدُجى","بِعارِضٍ مِنَ الضَلالِ مُفزِعِ",20,"ع",1,0],["يَومٌ بِهِ لَم يَبقَ مِن دَعامَةٍ","تَشُدُّ رُكنَ الدِينِ لَم تُضَعضَعِ",20,"ع",1,0],["يَومٌ بِهِ لَم يَبقَ مِن داعِيَةٍ","تَدعُو إِلى الشَيطانِ لَم تُبتَدَعِ",20,"ع",1,0],["يَومٌ بِهِ لَم تَبقَ مِن غَمامَةٍ","تُحيي ثَرى الإِسلامِ لَم تُشَيَّعِ",20,"ع",1,0],["يَومٌ بِهِ لَم تَبقَ قَطُّ رايَةٌ","تَهدي إِلى ضَلالَةٍ لَم تُرفَعِ",20,"ع",1,0],["يَومٌ بِهِ لَم يَبقَ قَطُّ مارِنٌ","وَمَعطِسٌ لِلحَقِّ لَم يَنجَدِعِ",20,"ع",1,0],["يَومٌ بِهِ لَم تَبقَ مِن وَسيلَةٍ","حقّاً لِآلِ المُصطَفى لَم تُقطَعِ",20,"ع",1,0],["يَومٌ بِهِ الكَلبُ الدَريعُ يَعتَدِي","عَلى هِزبَرِ الغابَةِ المُدَرَّعِ",20,"ع",1,0],["يَومٌ بِهِ غُودِرَ سِبطُ المُصطَفى","لِلعاسِلاتِ وَالضِباعِ الخُمَّعِ",20,"ع",1,0],["يومٌ بهذي الليالي يشبهُ القمرا","فإن رأى حلكاً في أفقها سفرا",21,"ر",2,1],["يومٌ بِطابَعِ يُمنهِ","وجهُ الزمان غدا أَغرّا",22,"ر",2,0],["يوم بُلَّ الثرى عليه من الدّم","ع وقُدّت على القلوب الصدور",23,"ر",1,0],["يؤُمُّ بها إمامَ العَدْلِ يَحْيَى","سرَاجاً كالسّريجِي الشّهيرِ",24,"ر",1,0],["يَوم بيضُ الظُبا وَسُمرُ القنا حي","نَ سَوادُ القَتامِ لَيلاً نجومُ",25,"م",1,0],["يوم به أصبح الاسلام مبتهجا","والدين مرتفعا والكفر في ضرم",26,"م",1,0],["يوم به خصنا المولى وفضلنا","منا وفضلا وبالبيتين والحرم",26,"م",1,0],["يوم به الإسلام أضحى لا با","تاج الفخار ونال عزاً لا يبيد",27,"د",1,0],["يوم به ساد الهنا وازينت","بعقوده غرر الزمان وكل جيد",27,"د",1,0],["يوم به ابتهج الأنام وقلدت","فيه الخليقة أمرها عبد الحميد",27,"د",1,0],["يوم به نلت الوقوف بمنبر","لشبيبة العصر المنيرة كي أفيد",27,"د",1,0],["يَومٌ بِه اِهتَزَّ عَرشُ اللَه من حَزَنٍ","على دَمٍ لرَسول اللَه مَهدورِ",28,"ر",1,0],["يَومٌ بِهِ كُسفت شَمسُ العُلى أَسَفاً","وأَصبح الدين فيه كاسِفَ النورِ",28,"ر",1,0],["يَومٌ به ذهبت أَبناءُ فاطِمَةٍ","للبَين ما بين مَقتولٍ ومأسورِ",28,"ر",1,0],["يوم بعث الخلق محشرهم","للإله الحق خير ولي",29,"ل",2,0],["يَؤمّ بِوفدِ الرومِ مِن شطّ عيلمٍ","إِلى عَيلمٍ لا جزرَ فيهِ ولا شطّا",30,"ط",2,0],["يَومٌ بِهِ القُطرُ ما أَحلاهُ آنِسَنا","بِسَيِّدِ القُطرِ حَتّى عَمَّنا النورِ",31,"ر",1,0],["يَومَ بانوا بِكُلِّ هَيفاءَ بِكرٍ","وَرَداحٍ وَطِفلَةٍ كَالغَزالِ",32,"ل",1,0],["يَؤُمُّ بِهِنَّ مِن بَطحاءِ نَخلٍ","مَراكِضَ حائِرٍ عَذبٍ مَعينِ",33,"ن",1,0],["يَوم بِهِ اِلتبسَ الدُجا بِنَهارِهِ","وَنَهاره بِدُجاه أَشبَه ما يَرى",34,"ر",2,0],["يَومٌ بِهِ تَقِفُ النَكباءُ مِن دَهش","وَالشَمس تَجري فَتَعيا فيهِ مِن لَغبِ",35,"ب",1,0],["يومٌ به قد قيل أَرِّخ","مَضى إلى ربّه النقيبُ",36,"ب",1,0],["يومٌ به سلمان وافى مقبلاً","قد كانَ للمشتاق أكبرَ عيده",37,"د",2,0],["يومٌ بعدلك مات الظلمُ فيه إلى","ليلٍ بنورك ماتت تحته الظُّلَمُ",38,"م",1,0],["يؤمُّ به طعن النحور حين تنتضى","إلى رفد معدام وحرب منازل",39,"ل",1,0],["يوم بظاهره السكوت مخيّم","نطقت ولكن بالصموت الألسن",40,"ن",1,0],["يومٌ به أعيُنُ الأعداءِ باكيةٌ","والسّيفُ يبسِمُ مخضوباً بعزّتِهِ",41,"ت",2,0],["يؤم بها الفسطاط منها متوج","له أبداً عير العلى ونفيرها",42,"ر",3,0],["يومٌ بيومِ أبي جَبرٍ وإخوتِهِ","والنفسُ نفسان منها الهَولُ والشَّفَقُ",43,"ق",1,0],["يومٌ بل اسبوعٌ تبسم ثغرُه","فتبسمت في العالمين ثُغورُ",44,"ر",1,0],["يَومٌ بِحُلوَانَ نَقضِيهِ عَلى ظَمإٍ","يَا لَيتَ أيَّامنَا كُلا بِحُلوَانا",45,"ن",2,1],["يَومٌ به احتفلت رِجَالُ حُكُومةٍ","فَأتَاهُ مِن قَاصٍ وكَم مِن دَانِ",46,"ن",1,0],["يومٌ به نبضَت قلوبُ رعيَّةٍ","فوُجوده هو لِلحياةِ لِزامُ",47,"م",1,0],["يومٌ بهِ الناسُ قد شَحَّتْ قُلوبُهمُ","بالصَبرِ إذْ جادتِ الأجفانُ بالدُرَرِ",48,"ر",1,0],["يومٌ بهِ العُجْمُ قبلَ العُرْبِ نادِبةٌ","تقولُ أينَ كريمُ البَدْوِ والحَضَرِ",48,"ر",1,0],["يَؤُمُّ بِهِنَّ الحَزمَ خِرقٌ سَمَيدَعٌ","أَحَذُّ كَصَدرِ الهندوانِيِّ مِخفَقُ",49,"ق",1,0],["يومٌ بهيمُ الزمانِ يَخْطِرُ من","جمالِهِ في الحُجُولِ والغُرَرِ",50,"ر",1,0],["يوم به عم البكاء عليك اذ","في كل ناد مأتم وعويل",51,"ل",1,0],["يومٌ به جليت شمس الجلال على","بدر الس