{"poems":[[90,"لقد جمع الشيخ هذي الكتب","https://www.aldiwan.net/poem44432.html","المتقارب"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70152","البسيط"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136902",""],[4978,"اللسان","https://www.poetsgate.com/ViewPoem.aspx?id=177173",""],[5163,"أمطري يا سماء","https://www.poetsgate.com/ViewPoem.aspx?id=33942",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[5461,"إرفعي سهم المنايا","https://www.poetsgate.com/ViewPoem.aspx?id=1305",""]],"verses":[["أ للسّوس أوقفها الواقفو","ن أن للعناكب أم للترب",0,"ب",1,0],["اللسنُ تخطبُ وَالاقلامُ جارِيَةٌ","وَالفكرُ يَنظمُ عِقدَ المَدحِ منتقَدا",1,"د",2,0],["أ للسياسةِ أم للدين دعوتهث","إنَّ النبوَّة اشكالٌ مراميها",2,"ي",3,0],["اللسان في التقسيم كالميزان","لطعوم من سائر الألوان",3,"ن",1,1],["اللسانُ الذي يُرائِي هدوئي","ذا اللسانُ الذي دعاكِ إليا",4,"ي",2,0],["أللسادة الامجاد من كل فاضل","نذم ونستوشي المقال المذمما",5,"م",2,0],["اللسان يخون والبسمه كُذُوب","واصدق التعبير نظرات العيون",6,"ن",1,0]]}