{"poems":[[23,"كم للمنازل من شهر وأحوال","https://www.aldiwan.net/poem21423.html","البسيط"],[72,"من عذيري من الطلا والأغاني","https://www.aldiwan.net/poem20180.html","الخفيف"],[91,"طوى بعض نفسي إذ طواك الثرى عني","https://www.aldiwan.net/poem62780.html","عموديه"],[70,"عندي أحاديث أشواق أضن بها","https://www.aldiwan.net/poem42758.html","البسيط"],[89,"اغتنم كل فرصة في الحياة","https://www.aldiwan.net/poem44633.html","الخفيف"],[89,"فقدت مصر فهي سكرى المآقي","https://www.aldiwan.net/poem44745.html","الخفيف"],[85,"كل اللي حب اتنصف","https://www.aldiwan.net/poem6798.html","عموديه"],[85,"أنتم عزيز يا أخي في أزمة","https://www.aldiwan.net/poem6964.html","الرجز"],[85,"ردت الروح على المضنى معك","https://www.aldiwan.net/poem7134.html","الرمل"],[85,"صرح على الوادي المبارك ضاحي","https://www.aldiwan.net/poem62982.html","الكامل"],[85,"حف كأسها الحبب","https://www.aldiwan.net/poem63726.html","المقتضب"],[49,"أحمد الله على كل حال","https://www.aldiwan.net/poem63085.html","المديد"],[80,"تدرعت صبري جنة للنوائب","https://www.aldiwan.net/poem31551.html","الطويل"],[44,"قد عرفنا دلائل المنع أو ما","https://www.aldiwan.net/poem29711.html","الخفيف"],[105,"اسألي يا نجد أهل الميفعه","https://www.aldiwan.net/poem43578.html","الرمل"],[48,"يا نفس كيف لطفت","https://www.aldiwan.net/poem62465.html","المجتث"],[48,"يا بني النقص والعبر","https://www.aldiwan.net/poem63405.html","مجزوء الخفيف"],[46,"هل يغسل الناس عن وجه الثرى مطر","https://www.aldiwan.net/poem22793.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85942","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202545","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42514","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142013","الخفيف"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116991","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54266","السريع"],[106,"في الحجاب","https://www.poetsgate.com/ViewPoem.aspx?id=179557",""],[106,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[90,"في اربعين السعدون","https://www.poetsgate.com/ViewPoem.aspx?id=179042",""],[90,"على دربند","https://www.poetsgate.com/ViewPoem.aspx?id=179051",""],[28,"وآلفة برد الحجال احتويتها","https://www.poetsgate.com/ViewPoem.aspx?id=17965",""],[100,"شاعر .. ووطنه في الغربة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67707&r=&rc=194",""],[187,"مناسب الناس تخفى في مغارسهم","https://www.aldiwan.net/poem44157.html","البسيط"],[224,"أشعة من مقلتيك ملهبه","https://www.aldiwan.net/poem39698.html","الرجز"],[257,"يا أبا أحمد بنفسي أفديك","https://www.aldiwan.net/poem48571.html","الخفيف"],[262,"ما راعني الليل ولا السبسب","https://www.aldiwan.net/poem38366.html","السريع"],[281,"أحتى إلى العلياء يا خطب تطمح","https://www.aldiwan.net/poem60783.html","الطويل"],[407,"الآن قد صح لي حقا بلا كذب","https://www.aldiwan.net/poem50209.html","البسيط"],[459,"أفلح قوم إذا دعوا وثبوا","https://www.aldiwan.net/poem56299.html","المنسرح"],[469,"يا أيها العبد الذي كل ما","https://www.aldiwan.net/poem60502.html","السريع"],[478,"قد حق للمشتاق أن يتوجعا","https://www.aldiwan.net/poem15217.html","الكامل"],[478,"حقيق بأن يبكي الديار غريبها","https://www.aldiwan.net/poem15295.html","الطويل"],[539,"يا له حبا اتحد","https://www.aldiwan.net/poem48224.html","عموديه"],[539,"لا مصاب في هذه الدنياء","https://www.aldiwan.net/poem48312.html","عموديه"]],"verses":[["أَحتالُ لِلمالِ إِن أَودى فَأَجمَعُهُ","وَلَستُ لِلعِرضِ إِن أَودى بِمُحتالِ",0,"ل",1,0],["أحتسي الراح لا بكيلٍ وأعطي","كرماً ذا وذا بلا ميزان",1,"ن",1,0],["أَحَتّى وَداعُ الأَهلِ يُحرَمُهُ الفَتى","أَيا دَهرُ هَذا مُنتَهى الحَيفِ وَالغَبنِ",2,"ن",1,0],["أَحتالُ في النَومِ كَي أَلقى خَيالَكُمُ","إِنَّ المِحِبَّ لَمُحتاجٌ إِلى الحِيَلِ",3,"ل",1,0],["احتفظ بالحياة فهي لعمري","لك ما عشت من اجل الهبات",4,"ت",1,0],["احتججنا لما عصفت بشوقي","انا والشعر والهوى باتفاق",5,"ق",1,0],["احترت والله واحتار دليلي ياناس","يارب أمرك بِالِّلى كتبه أنا رضيت",6,"ت",1,0],["احتجب القوم وراء ظلها","لا يُسأل البوّاب إلا قال لا",7,"ا",1,0],["احتكم في الروح والمال وخذ","نور عينيَّ عسى أن ينفعك",8,"ك",1,0],["اِحتَلَّ حِصنَ الحَقِّ غَيرُ جُنودِهِ","وَتَكالَبَت أَيدٍ عَلى المِفتاحِ",9,"ح",1,0],["اِحتَفى الحُضورُ بِها","وَاِكتَفى بِها الغَيَبُ",10,"ب",1,0],["إِحتِيالُ المَرءِ تَأتي عَلَيهِ","ساعَةٌ تَقطَعُ كُلَّ احتِيالِ",11,"ل",1,0],["أَحتّى خَيالٌ كُنتُ أَحظى بزَوْرِهِ","لَه في الكَرى عن مَضجعي صدّ عاتِبِ",12,"ب",1,0],["إِحتِساباً بَذَلتَها أَم تَصَدَّق","تَ بِها رَحمَةً عَلى اِبنِ السَبيلِ",13,"ل",1,0],["احترسْ ما الظنُّ إلا شُبهةٌ","تتَّقِيها كلُّ نَفْسٍ وَرِعَهْ",14,"ع",2,0],["اِحتَجتُ يَوماً إِلَيهِ","فَقالَ ذا يَومُ سَبتِ",15,"ت",1,0],["أَحتِساءً مِنَ الحَرا","مِ وَخَتماً عَلى الصُرَر",16,"ر",1,0],["إِحتَجَّ في الغَيِّ بِالنِسيانِ والِدُهُم","وَقَد غَوَوا بِاِدّكارٍ لا أَقولُ نَسوا",17,"س",3,0],["احتط ولا تلجنَّ في غمر الهوى","إني نصحتك يا فؤادي لو تعى",18,"ع",2,0],["احتازها من الجريء القلّبُ","وغلب الليثَ عليها الثعلبُ",19,"ب",1,0],["أَحْتَمِلُ الْمَكْرُوهَ مِنْ أَجْلِهِ","وَأَبْذُلُ الْمَالَ عَلَى حُبِّهِ",20,"ب",2,0],["اِحْتَمِلنِي وَلَا تَخَفْ بِي مَلَاماً","مَا عَلَى صَانِعِ الجَميلِ مَلامُ",21,"م",1,0],["اِحِتَمِلنِي تَحمِلْ بَقِيَّةَ رُوحٍ","تَرَكَتْهَا لِشَقْوَتِي الآلامُ",21,"م",1,0],["احتلتَ للدنيا ولذّاتها","بحيلةٍ تذهبُ بالدين",22,"ن",1,0],["احتَبَسَتْ أوَّاهُ في قَلْبِهِ","واختنقت ويْلاهُ في صَدْرِه",23,"ر",2,0],["احتجبْ كيف شئت، يأيها الكو","كب، إلا عن أعين الطلاب",24,"ب",1,0],["أحتَّى الماءُ ليس لديك ماءٌ","فلَيس لمن يَغَصُّ بك اعتصار؟",25,"ر",1,0],["احتلَّت الوحشةُ أطرافَه","ورفرفَ الحزنُ به والسكون",26,"ن",1,0],["أحتىَّ لدى الجنَّاتِ أهفو إليكمُ","ويسمعني داعي الصبابة أنْ دعا",27,"ع",2,0],["احْتَوَيْتُها،وَآلِفَةٍ بَرْدَ الحِجَالِ احْتَوَيْتُها،","وَقد نامَ مَنْ يَخشَى عليها وَأسْحَرَا",28,"ر",2,1],["أحتسي موطني لظّى ، يحتسي","من فم النار جرعة إثر جرعه",29,"ع",2,0],["أحتف الرجلين محتقر","ساقط في الناس ذي ذنبِ",30,"ب",1,0],["إِحتَفِظي بِقُدسِ تَذكارِ الشَقا","فَهو طَريقٌ لِلعَفافِ وَالتُقى",31,"ق",2,0],["احترس إنها نصحية شيخٍ","حنكته تجارب الآراء",32,"ا",2,0],["أحتسب اللَه وإياك لي","من نائبات فيه لا تحسب",33,"ب",1,0],["أَحَتّى إِلى الْعَلْياءِ يا خَطْبُ تَطْمَحُ","وَحَتّى فُؤَادَ الْمَجْدِ يا حُزْنُ تَجْرَحُ",34,"ح",1,1],["أَحتَلُّها وَالمَنايا في مَساكِنَها","مِثلَ ابن قفرة إِذ يَهوي إِلى سَربِ",35,"ب",1,0],["أحتشم البدرَ أن أراه فأل","حاظِيَ عنه بالدمع تحتجبُ",36,"ب",1,0],["اِحتَل بِزادٍ فَالطَريقُ الَّذي","لا بُدَّ أَن تَغشاهُ تَخشاهُ",37,"ا",2,0],["أحتثُّها تحتَ الظلامِ طلائحاً","عُجْفاً إذا شِمْتُ البروقَ اللمَّعا",38,"ع",2,0],["أحتثُّها شوقاً إلى بانِ الحمى","وظِلالِه والمنزلِ المألوفِ",39,"ف",1,0],["احتِفاءٍ الأبِ الحَنُو","نِ أوِ الأُمِّ بِالوَلَد",40,"د",1,0],["إحتسب هذه الرَّزيةَ للهِ","وعندَ الإلهِ حُسنُ الجَزاء",41,"ا",2,0]]}