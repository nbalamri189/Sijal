com/modules.php?name=Sh3er&doWhat=shqas&qid=88066&r=&rc=1",""]],"verses":[["أَحتالُ لِلمالِ إِن أَودى فَأَجمَعُهُ","وَلَستُ لِلعِرضِ إِن أَودى بِمُحتالِ",0,"ل",1,0],["أحتسي الراح لا بكيلٍ وأعطي","كرماً ذا وذا بلا ميزان",1,"ن",1,0],["أَحَتّى وَداعُ الأَهلِ يُحرَمُهُ الفَتى","أَيا دَهرُ هَذا مُنتَهى الحَيفِ وَالغَبنِ",2,"ن",1,0],["أَحتالُ في النَومِ كَي أَلقى خَيالَكُمُ","إِنَّ المِحِبَّ لَمُحتاجٌ إِلى الحِيَلِ",3,"ل",1,0],["احتفظ بالحياة فهي لعمري","لك ما عشت من اجل الهبات",4,"ت",1,0],["احتججنا لما عصفت بشوقي","انا والشعر والهوى باتفاق",5,"ق",1,0],["احترت والله واحتار دليلي ياناس","يارب أمرك بِالِّلى كتبه أنا رضيت",6,"ت",1,0],["احتجب القوم وراء ظلها","لا يُسأل البوّاب إلا قال لا",7,"ا",1,0],["احتكم في الروح والمال وخذ","نور عينيَّ عسى أن ينفعك",8,"ك",1,0],["اِحتَلَّ حِصنَ الحَقِّ غَيرُ جُنودِهِ","وَتَكالَبَت أَيدٍ عَلى المِفتاحِ",9,"ح",1,0],["اِحتَفى الحُضورُ بِها","وَاِكتَفى بِها الغَيَبُ",10,"ب",1,0],["إِحتِيالُ المَرءِ تَأتي عَلَيهِ","ساعَةٌ تَقطَعُ كُلَّ احتِيالِ",11,"ل",1,0],["أَحتّى خَيالٌ كُنتُ أَحظى بزَوْرِهِ","لَه في الكَرى عن مَضجعي صدّ عاتِبِ",12,"ب",1,0],["إِحتِساباً بَذَلتَها أَم تَصَدَّق","تَ بِها رَحمَةً عَلى اِبنِ السَبيلِ",13,"ل",1,0],["احترسْ ما الظنُّ إلا شُبهةٌ","تتَّقِيها كلُّ نَفْسٍ وَرِعَهْ",14,"ع",2,0],["اِحتَجتُ يَوماً إِلَيهِ","فَقالَ ذا يَومُ سَبتِ",15,"ت",1,0],["أَحتِساءً مِنَ الحَرا","مِ وَخَتماً عَلى الصُرَر",16,"ر",1,0],["إِحتَجَّ في الغَيِّ بِالنِسيانِ والِدُهُم","وَقَد غَوَوا بِاِدّكارٍ لا أَقولُ نَسوا",17,"س",3,0],["احتط ولا تلجنَّ في غمر الهوى","إني نصحتك يا فؤادي لو تعى",18,"ع",2,0],["احتازها من الجريء القلّبُ","وغلب الليثَ عليها الثعلبُ",19,"ب",1,0],["أَحْتَمِلُ الْمَكْرُوهَ مِنْ أَجْلِهِ","وَأَبْذُلُ الْمَالَ عَلَى حُبِّهِ",20,"ب",2,0],["اِحْتَمِلنِي وَلَا تَخَفْ بِي مَلَاماً","مَا عَلَى صَانِعِ الجَميلِ مَلامُ",21,"م",1,0],["اِحِتَمِلنِي تَحمِلْ بَقِيَّةَ رُوحٍ","تَرَكَتْهَا لِشَقْوَتِي الآلامُ",21,"م",1,0],["احتلتَ للدنيا ولذّاتها","بحيلةٍ تذهبُ بالدين",22,"ن",1,0],["احتَبَسَتْ أوَّاهُ في قَلْبِهِ","واختنقت ويْلاهُ في صَدْرِه",23,"ر",2,0],["احتجبْ كيف شئت، يأيها الكو","كب، إلا عن أعين الطلاب",24,"ب",1,0],["أحتَّى الماءُ ليس لديك ماءٌ","فلَيس لمن يَغَصُّ بك اعتصار؟",25,"ر",1,0],["احتلَّت الوحشةُ أطرافَه","ورفرفَ الحزنُ به والسكون",26,"ن",1,0],["أحتىَّ لدى الجنَّاتِ أهفو إليكمُ","ويسمعني داعي الصبابة أنْ دعا",27,"ع",2,0],["احْتَوَيْتُها،وَآلِفَةٍ بَرْدَ الحِجَالِ احْتَوَيْتُها،","وَقد نامَ مَنْ يَخشَى عليها وَأسْحَرَا",28,"ر",2,1],["أحتسي موطني لظّى ، يحتسي","من فم النار جرعة إثر جرعه",29,"ع",2,0],["أحتف الرجلين محتقر","ساقط في الناس ذي ذنبِ",30,"ب",1,0],["إِحتَفِظي بِقُدسِ تَذكارِ الشَقا","فَهو طَريقٌ لِلعَفافِ وَالتُقى",31,"ق",2,0],["احترس إنها نصحية شيخٍ","حنكته تجارب الآراء",32,"ا",2,0],["أحتسب اللَه وإياك لي","من نائبات فيه لا تحسب",33,"ب",1,0],["أَحَتّى إِلى الْعَلْياءِ يا خَطْبُ تَطْمَحُ","وَحَتّى فُؤَادَ الْمَجْدِ يا حُزْنُ تَجْرَحُ",34,"ح",1,1],["أَحتَلُّها وَالمَنايا في مَساكِنَها","مِثلَ ابن قفرة إِذ يَهوي إِلى سَربِ",35,"ب",1,0],["أحتشم البدرَ أن أراه فأل","حاظِيَ عنه بالدمع تحتجبُ",36,"ب",1,0],["اِحتَل بِزادٍ فَالطَريقُ الَّذي","لا بُدَّ أَن تَغشاهُ تَخشاهُ",37,"ا",2,0],["أحتثُّها تحتَ الظلامِ طلائحاً","عُجْفاً إذا شِمْتُ البروقَ اللمَّعا",38,"ع",2,0],["أحتثُّها شوقاً إلى بانِ الحمى","وظِلالِه والمنزلِ المألوفِ",39,"ف",1,0],["احتِفاءٍ الأبِ الحَنُو","نِ أوِ الأُمِّ بِالوَلَد",40,"د",1,0],["إحتسب هذه الرَّزيةَ للهِ","وعندَ الإلهِ حُسنُ الجَزاء",41,"ا",2,0],["احتملتم أعباءَها ومضيتم","بمقاليدها وراءَ البحار",42,"ر",1,0],["أَحَتمٌ عَلَيهِ في الهَوى صُحبَةُ الأَسَى","لَعَمرُكَ هَذا ما تَوَدُّ عِداتُهُ",43,"ت",2,0],["احتجت من خبر إلى سقية","فأمدد لنا منه فديناكا",44,"ك",2,1],["أَحَتَّى حُطَامَ الأَرْضِ أَصْبَحَ كَاسِياً","لَهَا وَأَرَاهَا رِفْعَةَ الشَّأْنِ وَالْقَدْرِ",45,"ر",1,0],["احتذى أخمُصاك خصمك يا بن","النفرِ البيض والكرام الخِماص",46,"ص",1,0],["احتجن تكليم الأجانب وهي لم","تفكك لهم أفواهها بشظاظ",47,"ظ",1,0],["أحتاج إنْ غبتي عَنْ العَيْن تفسير","وِشْ هُوْ يخَلِّي الجُوْ مظلم وجلَّاد",48,"د",1,0],["أحتسي الصبرَ في هواك وأرضَى","أن يكونَ العذابُ والمُرُّ زادِي",49,"د",2,0],["احتكمت فيه كل نائبه","حكم المداد الذي على قلمك",50,"ك",1,0],["أحتَاجُهُ بالعَينِ لا بالإسم","إذ شِيتَ فَآدخُل أو فَظَل غادي",51,"ي",1,0],["إِحتفالاً بشعرة ذكرتنا","كُل فَخر بِخَير خَير البَريه",52,"ه",1,0],["إحتَلْت للدُنيا فحصّلتها","والرأيُ أن تحتالَ للآخرهْ",53,"ه",1,0],["أحتاط من اهداء ديواني كما","احتاط حين أزورُ من لم أَخبُرِ",54,"ر",1,1],["أحتقر الناس وإعجابهم","ومن هم لاشيء إلاه",55,"ا",2,0],["أحتسي الماء وأبغي شربه","إن عداني الريق من ذات الدلال",56,"ل",1,0],["أحتى إذا قدمت مستكرها دمى","لشعبي أسام البغض منه فلا يرضى",57,"ض",2,0],["أحتَّامَ تصبو للتصابي وتَهزِلُ","وتنمو بهِ والنفسُ بالهزلِ تُهزَلُ",58,"ل",1,1],["أحتمٌ عليَّ البينُ عن كل معشرٍ","أجوبُ بلادَ اللَه شرقاً ومغربا",59,"ب",2,1],["احتمل صَرف الليالي إنها","حادثاتُ الدَهر تَأتي بالبدعْ",60,"ع",1,0],["أَحتال في مجلسي كَالشَمس في فلك","وَكُل فَرد يَرى ما يُنكر الثاني",61,"ن",2,0],["احتل لنفسك أيها المحتالُ","فمن المروءة أن يُرَى لك مالُ",62,"ل",1,1],["احتل لنفسكَ في الخلاصِ من شركٍ","إن كنتَ صدقتَ بالقرآنِ تصديقا",63,"ق",2,0],["اِحتَوَتهُ الأَنوارُ في رَكبِها الضا","في وَداني طَرفَ الأَواذي شُعاعُه",64,"ه",1,0],["احتل لأيرك في درع مضعفة","فبين فخذيه أرماح من الشعر",65,"ر",1,1],["أَحتاج إِلى الوَصلِ وَعَطفٍ مِنها","كَي أَجعَلَ صُدرَةً قَميصَ اللَيلِ",66,"ل",1,0],["احتجبَ الكاتبُ في دهرِنا","وكانَ لا يحتجبُ الكاتبُ",67,"ب",1,1],["أحتاجُ في بريّتي","وحشيّةً نتشاطر ُ",68,"ر",1,0],["أحتاجها القبلة فهي المنى","أحتاجها من شفةٍ باسلة",69,"ل",2,0],["أحتاج اِمرأة لا تنتقي لغة","للحبّ كيْ لا تكنْ هيْ من أعاديهِ",70,"ي",2,0],["أحتاج ألف حديث دفء أغنية","ووجه أنثى وحلما لا يضاهيه",70,"ي",2,0],["أحتاج معجزة أخرى بلا لغةٍ","كي تستريح على الدنيا أمانيهِ",70,"ي",2,0],["أحتاج امرأة تبتزني ولهًا","وتنثني خجلا ممًا انا فيهِ",70,"ي",2,0],["احترت ياغاليه باحساسك الغالي","مابين كثر الجروح وقلب يشفعلك",71,"ك",1,0],["احتضني في حدودك وانسني","اقهر الآمال لكن لا تغيب",72,"ب",1,0],["احتل طيش المشاعر واخلف اسلوبي","وجميع ما مرني منه اتهجابه",73,"ب",2,0],["أَحتاجُ عِشرينَ عامًا كَي أَعُودَ إِلى","أَمسِي, وعِشرينَ أُخرَى كَي أَرَى 