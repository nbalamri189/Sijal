{"poems":[[65,"من أغفل الحزم أدمى كفه ندما","https://www.aldiwan.net/poem46181.html","البسيط"],[90,"أما آن أن يغشى البلاد سعودها","https://www.aldiwan.net/poem44836.html","الطويل"],[93,"بكيت الصبا من قبل أن يذهب الصبا","https://www.aldiwan.net/poem62665.html","عموديه"],[87,"الملك بين يديك في إقباله","https://www.aldiwan.net/poem63756.html","الكامل"],[47,"كأن تشكي السفر الحيارى","https://www.aldiwan.net/poem10216.html","الوافر"],[48,"أدنى الفوارس من يغير لمغنم","https://www.aldiwan.net/poem23639.html","الكامل"],[47,"كأن تشتكي السفر الحيارى","https://www.poetsgate.com/ViewPoem.aspx?id=31588",""],[93,"الشباب والحب","https://www.poetsgate.com/ViewPoem.aspx?id=53231",""],[185,"فما شنتا خرقاء واه كلاهما","https://www.aldiwan.net/poem58855.html","الطويل"],[199,"أتعرف الدار أم لا تعرف الطللا","https://www.aldiwan.net/poem54422.html","البسيط"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[275,"تنزهت في روض خضيل مطلل","https://www.aldiwan.net/poem35662.html","الطويل"],[354,"داء ثوى بفؤاد شفه سقم","https://www.aldiwan.net/poem15640.html","البسيط"],[371,"كلفت بتعنيفي بلا طلب عذري","https://www.aldiwan.net/poem17192.html","الطويل"],[1017,"","https://poetry.dctabudhabi.ae/diwan/poem/45183","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59422","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59411","البسيط"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61152","الطويل"],[1562,"","https://poetry.dctabudhabi.ae/diwan/poem/178039","المجتث"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104807","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200231","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89018","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111427","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111392","الوافر"],[5026,"المنتهى","https://www.poetsgate.com/ViewPoem.aspx?id=208073",""],[592,"تلألأ نور الحق في الخلق وانتشر","https://www.poetsgate.com/ViewPoem.aspx?id=128721",""],[5786,"ما الغيث لمّا جرى بالسَّيل واديه","https://www.poetsgate.com/ViewPoem.aspx?id=50656",""],[199,"أَتَعْرِفُ الدارَ أَمْ لا تعرفُ الطَّلَلاَ","https://www.poetsgate.com/ViewPoem.aspx?id=20770",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[6241,"احتجاج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77051&r=&rc=9",""]],"verses":[["باضَ النَّعامُ على هاماتِهمْ وهُمْ","أشْباهُهُ والوَغى يَستَرْجِفُ اللِّمَما",0,"م",2,0],["بأضيعَ منكم حيث لاذو شهامة","يذبّ الرزايا عنكم ويذودها",1,"د",3,0],["بِأَضيَعَ مِن بُردِ الشَبابِ عَلى اِمرِئٍ","إِذا اِستَطعَمَتهُ النَفسُ أَطعَمَها العَذلا",2,"ل",2,0],["بِأَضَلَّ عَقلاً وَهيَ في أَيمانِكُم","مِمَّن يُحاوِلُ أَخذَها بِشِمالِهِ",3,"ل",2,0],["بِأَضرَطَ حينَ يُصبِحُ مِن حِمارٍ","وَأَسلَحَ حينَ يُمسي مِن حُبارى",4,"ر",2,0],["باضَ النّسورُ به وخيّمَ مُصْعِداً","حتى تَرَعْرَعَ فيه فَرْخُ القَشْعَمِ",5,"م",1,0],["بأضراط حين يصبح من حمار،","وأسلح حين يمسى من حبارى",6,"ر",2,0],["بأضيع من برد الشباب على امرىء","اذا استطعمته النفس أطعمها العذلا",7,"ل",2,0],["بِأَضيَعَ مِن عينَيكَ لِلدَّمعِ كُلَّما","تَوَهَّمتَ رَسماً أو تَبَيَّنتَ مَنزِلا",8,"ل",2,0],["باضَت بِحَزمِ سُبَيعٍ أَو بِمَرفَضِهِ","ذي الشَيحِ حَيثُ تَلاقى التَلعُ فَاِنسَجَلا",9,"ل",2,0],["باضَت عَلى البابِ الحَمامَةُ وَاِغتَدى","يَهِنُ العَناكِبَ طامِس الأَكنانِ",10,"ن",1,0],["بإضمامةِ جاء القُرنفلُ خاضعاً","وفي راحة بيضاءَ راحةُ مُثقَل",11,"ل",1,0],["بِأَضلُعي لَهَبٌ تَكوي حَرارَتُهُ","مِنَ الضَنا في مَحَلِّ الرَوحِ بِالجَسَدِ",12,"د",1,0],["بِأَضوَأَ مِن بَرقٍ وَأَزيَدَ في السَنا","وَأَهيَبَ مِن سَيفٍ وَأَملَأَ لِلصَدرِ",13,"ر",1,0],["بِأَضعَفَ حِيلَةٍ مِنّا إِذا ما","لَقيناهُ وَذا مِنّا عَجيبُ",14,"ب",1,0],["باض الحمام وحاك العنكبوت على","غار حمى المصطفى من كيد أعداه",15,"ا",2,0],["باض الحمام وحاك العنكبوت على","غار عليه لستر الله تجليل",16,"ل",1,0],["بِأَضبط ما يَلقى الحَديث محدث","وَأَقرب إِسناد لأَشرف صاحب",17,"ب",1,0],["باضَ الهوى في فؤادي","وفرخَ التذْكارُ",18,"ر",1,1],["باضَ الحَمامُ لَهُ فى غارِهِ وَكَذَا","قَد حَنَّ جِذعٌ لَهُ وَالضَّبُّ قَد نَطَقا",19,"ق",2,0],["بأضعافٍ أقابل كلّ صُنعٍ","أتاني من لئيم أو كريم",20,"م",1,1],["بأضيق ما يكون من المعاني","يسير الرأي منه في فجاج",21,"ج",1,0],["باضطَرَابٍ تَبَرقعَت بِنقابٍ","ناصِعٍ تَصطَلي لَظى الأَشجانِ",22,"ن",1,0],["بأَضعَافٍ مُثَلَّثَةٍ وأَوفى","نُجيزُكَ فاعتَبِر حَرِجَ المَقامِ",23,"م",1,0],["باضَ السَّحابُ وعُشُّ أرضِ المنتهى","شَيئان:مَرْغَدَة وآخَرُ شِدَّه",24,"د",2,0],["بأضغاث أحلام وتمويه مفتر","وتخبيط معتوه وتخليط من سكر",25,"ر",1,0],["باضعتُ بالعقلِ إحداهنَّ فاستلبَتْ","لبّي بدقَةِ معنى لست أفشيه",26,"ي",2,0],["بَاضَتْ بِحَزْمِ سُبَيْعٍ أَوْ بِمَرْفَضِهِ","ذي الشيحِ حيث تلاقى التلعُ فانسحلاَ",27,"ل",2,0],["باِضطهاد فَما اِعتَراه صَغار","مذ تَلظى بصدرهم إِيغار",28,"ر",1,0],["باضت ديوك العدى في كل مكرمة","وكان للعقم أمر في دجاجاتك",29,"ك",1,0]]}