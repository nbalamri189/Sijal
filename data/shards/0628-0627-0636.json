{"poems":[[63,"من أغفل الحزم أدمى كفه ندما","https://www.aldiwan.net/poem46181.html","البسيط"],[88,"أما آن أن يغشى البلاد سعودها","https://www.aldiwan.net/poem44836.html","الطويل"],[91,"بكيت الصبا من قبل أن يذهب الصبا","https://www.aldiwan.net/poem62665.html","عموديه"],[85,"الملك بين يديك في إقباله","https://www.aldiwan.net/poem63756.html","الكامل"],[45,"كأن تشكي السفر الحيارى","https://www.aldiwan.net/poem10216.html","الوافر"],[46,"أدنى الفوارس من يغير لمغنم","https://www.aldiwan.net/poem23639.html","الكامل"],[45,"كأن تشتكي السفر الحيارى","https://www.poetsgate.com/ViewPoem.aspx?id=31588",""],[91,"الشباب والحب","https://www.poetsgate.com/ViewPoem.aspx?id=53231",""],[181,"فما شنتا خرقاء واه كلاهما","https://www.aldiwan.net/poem58855.html","الطويل"],[195,"أتعرف الدار أم لا تعرف الطللا","https://www.aldiwan.net/poem54422.html","البسيط"],[231,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[270,"تنزهت في روض خضيل مطلل","https://www.aldiwan.net/poem35662.html","الطويل"],[349,"داء ثوى بفؤاد شفه سقم","https://www.aldiwan.net/poem15640.html","البسيط"],[366,"كلفت بتعنيفي بلا طلب عذري","https://www.aldiwan.net/poem17192.html","الطويل"]],"verses":[["باضَ النَّعامُ على هاماتِهمْ وهُمْ","أشْباهُهُ والوَغى يَستَرْجِفُ اللِّمَما",0,"م",2,0],["بأضيعَ منكم حيث لاذو شهامة","يذبّ الرزايا عنكم ويذودها",1,"د",3,0],["بِأَضيَعَ مِن بُردِ الشَبابِ عَلى اِمرِئٍ","إِذا اِستَطعَمَتهُ النَفسُ أَطعَمَها العَذلا",2,"ل",2,0],["بِأَضَلَّ عَقلاً وَهيَ في أَيمانِكُم","مِمَّن يُحاوِلُ أَخذَها بِشِمالِهِ",3,"ل",2,0],["بِأَضرَطَ حينَ يُصبِحُ مِن حِمارٍ","وَأَسلَحَ حينَ يُمسي مِن حُبارى",4,"ر",2,0],["باضَ النّسورُ به وخيّمَ مُصْعِداً","حتى تَرَعْرَعَ فيه فَرْخُ القَشْعَمِ",5,"م",1,0],["بأضراط حين يصبح من حمار،","وأسلح حين يمسى من حبارى",6,"ر",2,0],["بأضيع من برد الشباب على امرىء","اذا استطعمته النفس أطعمها العذلا",7,"ل",2,0],["بِأَضيَعَ مِن عينَيكَ لِلدَّمعِ كُلَّما","تَوَهَّمتَ رَسماً أو تَبَيَّنتَ مَنزِلا",8,"ل",2,0],["باضَت بِحَزمِ سُبَيعٍ أَو بِمَرفَضِهِ","ذي الشَيحِ حَيثُ تَلاقى التَلعُ فَاِنسَجَلا",9,"ل",2,0],["باضَت عَلى البابِ الحَمامَةُ وَاِغتَدى","يَهِنُ العَناكِبَ طامِس الأَكنانِ",10,"ن",1,0],["بإضمامةِ جاء القُرنفلُ خاضعاً","وفي راحة بيضاءَ راحةُ مُثقَل",11,"ل",1,0],["بِأَضلُعي لَهَبٌ تَكوي حَرارَتُهُ","مِنَ الضَنا في مَحَلِّ الرَوحِ بِالجَسَدِ",12,"د",1,0],["بِأَضوَأَ مِن بَرقٍ وَأَزيَدَ في السَنا","وَأَهيَبَ مِن سَيفٍ وَأَملَأَ لِلصَدرِ",13,"ر",1,0]]}