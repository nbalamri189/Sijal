{"poems":[[1011,"","https://poetry.dctabudhabi.ae/diwan/poem/124610","الوافر"],[1011,"","https://poetry.dctabudhabi.ae/diwan/poem/124611","الطويل"],[1738,"","https://poetry.dctabudhabi.ae/diwan/poem/124295","الرجز"],[3466,"","https://poetry.dctabudhabi.ae/diwan/poem/124615","الطويل"],[3489,"","https://poetry.dctabudhabi.ae/diwan/poem/131366","البسيط"],[4984,"أَيُعْقَلُ أَنْ أَنْسَى","https://www.poetsgate.com/ViewPoem.aspx?id=201808",""],[4984,"الْعَرَبَةُ","https://www.poetsgate.com/ViewPoem.aspx?id=201917",""],[5003,"سقى الله ربعا لم يزل متيمما","https://www.poetsgate.com/ViewPoem.aspx?id=120393",""]],"verses":[["وءال ثم صحب ما توقى","شبا العادي بجُنّته مريد",0,"د",1,0],["وءال وصحب ثم نال سبيله","إلى موقف فيه الصحائف تنشَر",1,"ر",1,0],["وءاله وصحبه وزوجه وحزبه","وكل ءال حبّه مع السلام الاكمل",2,"ل",1,0],["وءالٍ وصحب في الهداية أنجم","وأسد إذا تدمى القنا والخياضعُ",3,"ع",1,0],["وءالهِ الطاهرين الطيبين مع الص","حب الكرام ومن أمسى لهم تبَعا",4,"ع",2,0],["وَءَامَنْتُ لما حَطَّمَتْ قفص النوى","بأن انعتاقي ليس شكلا لرِدَّتِي",5,"ت",2,0],["وءامنوا قبلها أن الرهان لهم","وأنهم وحدهم في ساحة الحلبة",6,"ب",2,0],["وءال وأصحاب وسلم جل ما","حبا حبهم ما قد تمنى وفوق ما",7,"م",2,0]]}