{"poems":[[95,"لو كان مما ربك عاصم","https://www.aldiwan.net/poem11333.html","الكامل"],[53,"لي صاحب قد كنت آمل نفعه","https://www.aldiwan.net/poem8496.html","الكامل"],[53,"أأبي يوسف دعوة المستصغر","https://www.aldiwan.net/poem63998.html","الكامل"],[45,"باد هواك صبرت أم لم تصبرا","https://www.aldiwan.net/poem9608.html","الكامل"],[47,"وصل تقارب منه ثم تباعد","https://www.aldiwan.net/poem63466.html","الكامل"],[47,"هبل الواشي بها أنى أفك","https://www.aldiwan.net/poem65215.html","الرمل"],[30,"أنسيت صحبتها ومن يك مقرفا","https://www.aldiwan.net/poem5255.html","الكامل"],[48,"عجبي للطبيب يلحد في الخا","https://www.aldiwan.net/poem22293.html","الخفيف"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/141028",""],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/205861","الكامل"],[396,"أيها العبد إن شئت الأمان","https://www.aldiwan.net/poem54475.html","عموديه"],[466,"شكرا لدهري بالضمير وبالفم","https://www.aldiwan.net/poem15142.html","الكامل"],[505,"ما بين جرعاء اليلملم والعلم","https://www.aldiwan.net/poem37799.html","الكامل"],[556,"هل أنت من وصب الصبابة ناصري","https://www.aldiwan.net/poem47790.html","الكامل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101509","الكامل"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104063","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48748","الكامل"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216887","الخفيف"],[1376,"","https://poetry.dctabudhabi.ae/diwan/poem/118072","الكامل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113953","الخفيف"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109347","الكامل"],[345,"","https://poetry.dctabudhabi.ae/diwan/poem/124712","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45779","الكامل"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[4755,"الغُوْلُ, والعَنْقاءُ, والتِّنِّينُ","https://www.poetsgate.com/ViewPoem.aspx?id=184098",""],[4755,"لا شَأنَ لِي","https://www.poetsgate.com/ViewPoem.aspx?id=204158",""],[5219,"جفف دموعك","https://www.poetsgate.com/ViewPoem.aspx?id=194802",""],[5338,"إلى البرلمان العراقي العابث","https://www.poetsgate.com/ViewPoem.aspx?id=187953",""],[5351,"وجع الجبال","https://www.poetsgate.com/ViewPoem.aspx?id=202145",""],[5431,"قابيل ومصيدة الشهوة!","https://www.poetsgate.com/ViewPoem.aspx?id=197877",""],[5956,"من مزايا البنك الإسلامي للتنمية","https://www.poetsgate.com/ViewPoem.aspx?id=193485",""],[6102,"خَانتْ سُعادُ ..","https://www.poetsgate.com/ViewPoem.aspx?id=183983",""],[1376,"وحديقة مطلولة باكرتها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=599338",""],[6189,"قصيدة عن حب قديم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67119&r=&rc=4",""]],"verses":[["يَتَكَافَأُ الحِدْثَانِ فِي الدُّنْيَا سِوَى","أَنْ نِمْتَ عَنْهُ وَمَنْ تَخَلَّفَ قَائِمُ",0,"م",1,0],["يتكلَّف المتكلفون رياضتي","لِيُطِلْ بذاك مُعَجِّبٌ تعجيبَهُ",1,"ب",2,0],["يتكافآن الرهزَ من جِهتيهما","فكلاهما في ذاك غيرمقصر",2,"ر",1,0],["يَتَكَسَّبُ القَصَبُ الضَعيفُ بِكَفِّهِ","شَرَفاً عَلى صُمِّ الرِماحِ وَمَفخَرا",3,"ر",2,0],["يَتَكَفَّلُ الأَدنى وَيُدرِكُ رَأيُهُ ال","أَقصى وَيَتبَعُهُ الأَبِيُّ العانِدُ",4,"د",1,0],["يَتَكَفّا النَخلُ في حافاتِها","بِالقَمارى تُغَنّى أَو تُبَك",5,"ك",1,0],["يَتَكَلَّمونَ مَعَ الرِجالِ تَراهُمُ","زُبَّ اللِحى وَقُلوبُهُم أَصفارُ",6,"ر",1,0],["يَتَكَنّى أَبا الوَفاءِ رِجالٌ","ما وَجَدنا الوَفاءَ إِلّا طَريحا",7,"ح",2,0],["يتكسّب القصب الضّعيف بخطّه","شرفاً على صمّ الرّماح ومفخرا",8,"ر",2,0],["يتكلمون مع الفارغ فما هم","عجم إذا نطقوا ولا أعراب",9,"ب",1,0],["يتكلم بكلمه لم يقل","غيرها شؤمها يبقى الزمان",10,"ن",1,0],["يتكلمُ الإيجازَ في لحظاته","فدوام نظرته حروفُ المُعجم",11,"م",1,0],["يَتَكاتَمونَ عنِ الوَرَى أَسْرارَهُمْ","لَهَفاً لجِيرانِ اللِّوا أَهلِ الخِيَمْ",12,"م",1,0],["يَتكالَبونَ عَلى القَبائح بَينهمْ","كَلَبَ الذّئابِ رأين عَقْرَ العاقِرِ",13,"ر",1,0],["يتكلفون بهِ ثناءً كاذباً","مع أن حبل الكاذبين قصيرُ",14,"ر",1,0],["يتكسرُّ الماشي بها فترى لهُ","خُيَلاءَ جبّارٍ وخِفّةَ أولقِ",15,"ق",1,0],["يتكلفون الصالحا","ت لها وتأباها السليقه",16,"ق",2,0],["يتكشّفْنَ عنْ صرايعَ ستٍّ","قُسّمَتْ بينهُنّ كأسٌ عُقَارُ",17,"ر",1,0],["يتكسر الماء الزلالُ على الحصى","فإذا غدا بين الرياضِ تشعبا",18,"ب",2,0],["يتَكَنَّفنَها كبَيضةِ دغصٍ","دارَ يوماً بها نعاجُ دوارِ",19,"ر",1,0],["يتكلف الصبر الجميل بها على","فقد الخليل وثمّ سُمّ حياته",20,"ت",2,0],["يتكأد الرزقُ العبادَ وإنه","فيها على باغيِه غير عسيرِ",21,"ر",1,0],["يَتَكَلف البَدر الكَمال وَينثَني","صُفر اليَدين يُدير وَجهاً أَصفَرا",22,"ر",2,0],["يَتَكالبانِ عَلى الحَرامِ وَأَهلِهِ","فِعلَ الكِلابِ بِجيفَةِ اللُحمانِ",23,"ن",1,0],["يَتَكَالَبُونَ على البِلادِ ولَم يَعُد","لِلمَوتِ فَوقَ تُرابها تَقنِينُ",24,"ن",1,0],["يَتَكَالَبُونَ على جِرَاحِ شُعُوبِهِم","كَتَكَالُبِ الحُمَّى على المَطعُونِ",25,"ن",1,0],["يتكالبون على نعيم زائل","للظلم ما وهنوا فكانوا الأسرعا",26,"ع",2,0],["يَتَكَالَبونَ عَلَى الْمَنَاصِبِ خَيْرُهُمْ","لَوْ شُمْتَ بَيْنَهُمُ التَّقِيَّ الْخَيِّرَا",27,"ر",2,0],["يتكلم الفصحى وقد","أعيأ لغات المفصحين",28,"ن",1,0],["يتكاثرون على الرذيلة نفسهم","سوداء تأكل باللحوم ..برابره!!",29,"ر",2,0],["يتكفل الإبداع بل يسمو به","من حيثما يأتي نقياً طيبا",30,"ب",2,0],["يَتَكَدَّسُ الوَجَعُ المُقِيمُ جَهَنَّمًا","وَ تَذُوبُ فِيها قُوَّتِي وَ تَهُونُ",31,"ن",1,0],["يتكسر الماء الزلال على الحصى","فاذا عدا بين الرياض تشعبا",32,"ب",2,0],["يتكالبون على جِراحِكِ ، ما دَرَوْا","أنَّ الكريمةَ دونها العيُّوقُ",33,"ق",1,0]]}