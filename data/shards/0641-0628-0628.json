{"poems":[[80,"لله در أبي السنان","https://www.aldiwan.net/poem14076.html","مجزوء الكامل"],[80,"لِلَّهِ دَرّ أَبي السِّنانْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86632&r=&rc=127",""],[287,"جاء الربيع وروضه الممطور","https://www.aldiwan.net/poem32758.html","الكامل"],[353,"الغوث قد أكل الصيام ثيابي","https://www.aldiwan.net/poem19871.html","الكامل"],[505,"وحي السماء منزل ببيوتنا","https://www.aldiwan.net/poem37804.html","الكامل"],[580,"قتلي لحبكم شهادة","https://www.aldiwan.net/poem3076.html","مجزوء الكامل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35404","الكامل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128704","الكامل"],[1563,"","https://poetry.dctabudhabi.ae/diwan/poem/203761","الكامل"],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84841","الكامل"],[2954,"","https://poetry.dctabudhabi.ae/diwan/poem/138923",""],[119,"","https://poetry.dctabudhabi.ae/diwan/poem/105962","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138614",""],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86454","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123519","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123483","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83464","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58110","الكامل"],[4852,"جهرة","https://www.poetsgate.com/ViewPoem.aspx?id=215147",""],[460,"أَمِنْ حُبِّ سُعْدَى وتَذْكارِها","https://www.poetsgate.com/ViewPoem.aspx?id=22211",""]],"verses":[["فَبِبَأسِهِ يُشقي العِدى","وَبِحُسنِهِ يُصبي الحيانْ",0,"ن",1,0],["فَبِبَأسِهِ يُشقي العِدا","وَبِحُسنِهِ يُصبي الحسانْ",1,"ن",1,0],["فَبِبَأسِهِ فيهِم تُهَدُّ مَعاقِلٌ","شُمُّ الذُرى وَبِهِ تُسَدُّ ثُغورُ",2,"ر",1,0],["فَبِبَاطِني أَلَم الخَوَاءِ وَظاهِري","أَلَمُ الهَوَاءِ فَلا تَسَلْ عَمَّا بي",3,"ب",2,0],["فبِبَيْتِهِ سيقومُ من أَسْرارِنا","فوقَ المِنَصَّةِ للحُقيقةِ مُحْفَلُ",4,"ل",1,0],["فببأْسِهِ أَسَدُ العِدَى","ذِئبٌ وبَازِيهم جَرادَه",5,"د",2,0],["فَبِبابِهِ عَكَفَ العُفاةُ كَأَنَّهُم","وَفدُ الحَجيجِ بأَبطَحٍ وَحَجونِ",6,"ن",1,0],["فبباب فضلك قد وقفت ولم أزل","بعظيم قدرك في الورى أتضرع",7,"ع",1,0],["فببأس سيفك أمّنت فلواتها","وببث سيبك أمّلت اسعادها",8,"د",3,0],["فَببشر مَولده أَتى","تاريخه الزاهي تَراه",9,"ا",2,0],["فببهجة حسن بهاء سنا","ء ضياء أبي حسن أفخر",10,"ر",1,0],["فببابه تقضي الحوائج والغنى","من رحبه متدفق لفقيره",11,"ر",2,0],["فببشر اللقاء تنسى أذى السير","ذهاباً وبالمنى في اياب",12,"ب",1,0],["فببيض طوراً وطوراً بحمر","أنقش الترب من ورائك نقشا",13,"ش",2,0],["فببابه لذ خاضعا","متذللا تلقى الكرامه",14,"م",2,0],["فببابه قل مستقيلا ثم قل","يا سيدا تعلو به العلياء",15,"ا",2,0],["فَببابهِ تنحطّ أَو","زارُ الوَرى من كلّ وازِر",16,"ر",1,0],["فببعض ما كسبوه من أفعالِهم","هذا من الإسرافِ في الأفعالِ",17,"ل",1,0],["فَبِبَْطن حوت .. أستكينُ بظلمة","من فوقِها ظُلمٌ ثلاثُ .. كما ترى",18,"ر",2,0],["فبَّبت قوى الحبل مصبوبة","ً على نقضها بعدَ إمرارها",19,"ر",3,0]]}