{"poems":[[53,"أبدا نحن في خلاف فمني","https://www.aldiwan.net/poem64986.html","الخفيف"],[53,"ومعاشر بصقوا على ما قلته","https://www.aldiwan.net/poem65725.html","الطويل"],[53,"حي المعاهد والمنازل","https://www.aldiwan.net/poem65977.html","مجزوء الكامل"],[190,"أبا طالب لله در مناقب","https://www.aldiwan.net/poem43271.html","الطويل"],[193,"حي يا سعد قبابا بالحمى","https://www.aldiwan.net/poem35099.html","الرمل"],[201,"هات يا ساق هات بنت النخيل","https://www.aldiwan.net/poem39944.html","الخفيف"],[354,"بدر بم من القبا","https://www.aldiwan.net/poem15778.html","مجزوء الخفيف"],[415,"فما أنت إلا الشمس لولاك لم تزل","https://www.aldiwan.net/poem31712.html","عموديه"],[463,"من دل ربات العيون النجل","https://www.aldiwan.net/poem56067.html","الرجز"],[541,"تولى الجود وانقرض الكرام","https://www.aldiwan.net/poem23847.html","الوافر"],[1467,"","https://poetry.dctabudhabi.ae/diwan/poem/136783",""],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77403","الخفيف"],[2420,"","https://poetry.dctabudhabi.ae/diwan/poem/95979","الرجز"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102509","الكامل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130816",""],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48455","الكامل"],[5411,"لست أنت حبيبي..","https://www.poetsgate.com/ViewPoem.aspx?id=192204",""],[5956,"طمئنّي عنك","https://www.poetsgate.com/ViewPoem.aspx?id=194621",""]],"verses":[["فبصدغيكَ فوق خَطِّ عذارٍ","ظُلماتٌ وبعضُها فوقَ بعضِ",0,"ض",1,0],["فبصقت في الأحراح من نسوانهم","وطعنتهن بأيما مزراق",1,"ق",1,0],["فبصُرْن فيك بفارسٍ","يغْشى الحروبَ ولا يُقاتلْ",2,"ل",1,0],["فبصّرته رشد الحليم وقد رأى","بعين الهوى أو رام هتك المحارم",3,"م",1,0],["فبصبحُ الحقِّ منه اِبتَسما","مُشرقاً من نوره لم يعبسِ",4,"س",1,0],["فبصدرِ المكروبِ نارٌ تلظّى","أوقَدتَها الأشجان عند الرحيل",5,"ل",1,0],["فَبَصيراً بِهِ غَدَو","تُ وَسَمعي سَميعُهُ",6,"ع",2,0],["فبصرتهم بعد الغواية والعمى","وأرشدتهم تحت الضلال إلى الهدى",7,"د",2,0],["فبصَّرتْني منه نفسٌ حرّةٌ","شاب الإباءُ شهدَها بحنظلِ",8,"ل",1,0],["فَبَصَّرَنا وَأَسمَعَنا وَكُنّا","قُبَيلُ كَأَنَّنا الإِبِلُ الهِيامُ",9,"م",1,0],["فبصرنا صنعاً إتقانها","حير الإدراك منا والفهامه",10,"م",2,0],["فَبِصِدقِ اليَقينِ أُلقِيَ إِبرا","هامُ في رَوضَةٍ مِن النيرانِ",11,"ن",1,0],["فَبَصَرَت بَعَزَبٍ مُلأمِ","فَأَخذت من رادنٍ وكركم",12,"م",1,1],["فبصائر أهل الاقتدا","والاهتدا يكشف لها",13,"ل",3,0],["فبصونه شرف الأبي مكملا","يرقى بقمات الفخار منيفا",14,"ف",2,0],["فبِصُبْحِ هدْيكَ يهْتَدي فلَقُ الضُحى","والفجْرُ قد فلَقَ الظّلامَ عَمودا",15,"د",2,0],["فبَصيصُ الخَيالِ فيَّ تَراءى","وَلُغات الْهَوَى مَعي تَتَماشى",16,"ش",2,0],["فبصورة لك يا كريم تُعيد لي","جوّاً يُخالف زمجراتِ بنادقِ..",17,"ق",1,0]]}