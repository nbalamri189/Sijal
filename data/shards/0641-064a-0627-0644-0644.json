ViewPoem.aspx?id=202166",""],[5936,"هذاك إبن ناشي","https://www.poetsgate.com/ViewPoem.aspx?id=184773",""],[5953,"متى فلكلي يقوم فأستريح","https://www.poetsgate.com/ViewPoem.aspx?id=93795",""],[5956,"تغرد لي الملائكة","https://www.poetsgate.com/ViewPoem.aspx?id=181898",""],[5956,"على ضفّة","https://www.poetsgate.com/ViewPoem.aspx?id=192404",""],[5956,"دعوت له بخيراتٍ كباراً","https://www.poetsgate.com/ViewPoem.aspx?id=194174",""],[5956,"تكاد البنت نحو الموت أن تثبا","https://www.poetsgate.com/ViewPoem.aspx?id=194711",""],[5961,"يسير بك المهيمن","https://www.poetsgate.com/ViewPoem.aspx?id=199772",""],[6075,"الأميرة والفتى العاشق","https://www.poetsgate.com/ViewPoem.aspx?id=213306",""],[6082,"حالة ايثار","https://www.poetsgate.com/ViewPoem.aspx?id=59125",""],[6089,"شموع الوصل","https://www.poetsgate.com/ViewPoem.aspx?id=213859",""],[6093,"يَا هَاجِريْ ! عينٌ لبَعْضيَ أنكرتْ ( الكامل)","https://www.poetsgate.com/ViewPoem.aspx?id=176195",""],[6102,"خرف أنا","https://www.poetsgate.com/ViewPoem.aspx?id=183985",""],[6125,"لأنَّ سواكِ لنْ يَحظَىٰ بِقَلبِي","https://www.poetsgate.com/ViewPoem.aspx?id=208755",""],[406,"في الليل اسرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1114&r=&rc=58",""],[6262,"الرجفةُ تبدأُ من يدِها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80104&r=&rc=2",""],[6285,"أغنيات على أبواب القدس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86824&r=&rc=17",""]],"verses":[["فَيا لِلَّهِ كَم تُجرَ","حُ يا قَلبِيَ مِن عَيني",0,"ن",2,0],["فَيا لِلناسِ أوقِرُهُ تُراباً","وَأَستَسقي لِأَعظُمِهِ العِهادا",1,"د",2,0],["فيا للعقول لهذا الغبا","ويا للفحول لهذا العجب",2,"ب",1,0],["فياَ لله يوم نعاه ناعٍ","لمرزئة محت كل المرازي",3,"ز",2,0],["فيا لله من عاداتِ برٍّ","أتتني بالتمام والكمال",4,"ل",1,0],["فيا لله من غصنٍ فريدٍ","وفي خدَّيه كلتا الجنتين",5,"ن",1,0],["فيا للهِ من لقمٍ هُناكم","تجاوبُ بالشَّحيج وبالغطيط",6,"ط",1,0],["في الليلِ كافٍ والنهارِ إذا","هرجاهُمُ بمناحس الفلكِ",7,"ك",1,0],["فَيا لِلحُروب وَأَهوالِها","أَما حانَ يا قَومُ أَن تُشجَبا",8,"ب",2,0],["في اللَيلِ وَفي وَضحِ الفَجرِ","وَالخَمرَةُ فيهِ وَالكَأسُ",9,"س",1,0],["في اللَهِ وَالوَطَنِ العَزيزِ عِصابَةٌ","نَكِبوا فَذا عانٍ وَذاكَ قَتيلُ",10,"ل",1,0],["فَيا لِلَّهِ حَتّى السُف","نُ مِثلي ما لَها مُسلِ",11,"ل",1,0],["فَيا لِلناسِ كَيفَ غَلَبتُ نَفسي","عَلى شَيءٍ وَيَكرَهُهُ ضَميري",12,"ر",2,0],["فَيا لِلَّهِ ما أَحلى","وَما أَشهى وَما أَندى",13,"د",2,0],["في اللَّيل نادَيتُ الكَواكِبَ ساخطاً","متأجِّجَ الآلامِ والآرابِ",14,"ب",1,1],["في اللَه مِن كُلِّ مَفقودٍ مَضى عِوَضٌ","فأشَعر القَلبَ سُلوانا وَإِيمانا",15,"ن",2,0],["في الليل مجرى السيل ليس بمأمن","اما الامان ففوق ظهر الوادي",16,"د",2,0],["في الليل قد ادجى اذا برق بدا","شهق الهزار وزغرد الكروان",17,"ن",1,0],["فَيا لِلمُسلِمينَ وَلِلنَصارى","وَقَيصَرَ وَالمُلوكِ الآخَرينا",18,"ا",1,0],["فَيا لِلَّهِ ما تَلقى القُلوبُ ال","هَوائِمُ مِن جِناياتِ العُيونِ",19,"ن",1,0],["فيا للقلوبِ الصابراتِ وقد غفت","على نعمةِ الإِيمانِ والشكرِ والحمدِ",20,"د",1,0],["في الليل مدَّ رواقه وثوى","كجوانحٍ طُويت على حسدِ",21,"د",1,0],["في اللَهِ يُنجِزُ وَعدَهُ وَوَعيدَهُ","لِلمُعتَفينَ وَلِلعَنودِ المُترَفِ",22,"ف",1,0],["فَيَا لِلْعُلَى كَيْفَ اسْتُبِيحَ ذِمَارُهَا","وَلِلْفَضْلِ إِذْ يُرْمَى بِهِ الرَّجَوَانِ",23,"ن",1,0],["فيا لله ماذا ضمَّ لحدٌ","ويا للهِ ما غطَّى البساطُ",24,"ط",1,0],["في اللّوائَيْنِ ضياءٌ منهما","واضحُ المطلعِ طَلقُ المَشرِقِ",25,"ق",1,0],["في اللّهِ تصْديقُ ما في النفس من أمَلٍ","وفي المُعِزّ مُعِزِّ البأس والجُود",26,"د",1,0],["في اللّهِ يسري جودُهُ وجنُودُهُ","وعَديدُهُ والعزْمُ والآراءُ",27,"ا",2,0],["فَيا لِلنَصارى إِذا أَمسَكوا","وَيا لِليَهودِ إِذا أَسبَتوا",28,"ت",3,0],["فَيا للقلوب الخادِرات من الضنى","وَيا للعيون المغمضات الهواجع",29,"ع",1,0],["فيا للشَّراهةِ ماذا أرى","لِسانكَ في ثورةٍ واهتياجْ",30,"ج",1,0],["فيا للبريئةِ ماذا جَنَتْ","فتحملُ ما لا يُطاقُ احتمالا",31,"ل",2,0],["في اللّه في الحقّ في الإِسلام كلُّ دمٍ","يسيل فيها وجُرحٍ ليس يلتامُ",32,"م",1,0],["في اللاذقية فتنة","ما بين أحمد والمسيح",33,"ح",1,1],["فى الليل لما خلي","إلاّ من الباكي",34,"ي",1,1],["فَيَا للهِ كَمْ لِي مِنْ لَيَالٍ","بِهِ سَلَفَتْ وَأَيَّامٍ عِذَابِ",35,"ب",1,0],["فَيَا لَلْمَعَانِي مِنْ بَدِيعٍ وَرَائِعٍ","وَيَا لَلْمَبَانِي مِنْ رَفِيقٍ وَمِن جَزْلِ",36,"ل",1,0],["في اللَّيْل يُسْتَنْبَتُ زَهْرُ المُنَى","وَتُجْتَلَى البيضُ منَ الزَّهْرِ",37,"ر",1,0],["فَيَا لِلأَسَى أَنْ فَرّقَ اليَوْمَ بَيْنهُمْ","زَمَانٌ إِذا أَلْفَى وَفاءً رَمَى غَدْرا",38,"ر",2,0],["فيا لله من حمَل","يريك مصارع الأُسْد",39,"د",1,0],["فيا للمعارف حسن العزا","لقد أصبحت سوقها راكده",40,"د",2,0],["في الله جدوا فجدوا في مفاخرهم","ومدحه الله فيهم حسب مفتخر",41,"ر",1,0],["في الله حق جهاده","فأذعن عاصيه وذل عنيده",42,"د",2,0],["فيا للصّبي الهاني شجاني أنّه","حزين ومن طبع الصبي اللهو اللّعب",43,"ب",1,0],["في الله صَوَّامٌ له قوامُ","لا يعتريه الأيْنُ والسَّآمُ",44,"م",1,0],["فيا لله من غوث","به للامة الفخر",45,"ر",1,0],["فيا للَه من قطع بوصل","به وجداً طلع الصباح بلا مرام",46,"م",1,0],["فيا للهِ حيث وضعتُ جنبى","أمارسُ عَقربا منهم وصِلاَّ",47,"ل",2,0],["في اللهِ سبحانهُ عمن مضى خلفُ","فلا ينل منك فرطُ الحزنِ والأسفُ",48,"ف",1,1],["فيا لله من زفراتِ شوقٍ","تسل الروح من جنبيَّ سلاّ",49,"ل",2,0],["فَيا لِلناسِ ما الزَيمُ","إِذا فُصِّلَ أَو دُهدِق",50,"ق",1,0],["فيا لله لم أكسب أثاما","ولم أهتك لذي رحم حجابا",51,"ب",2,0],["في اللَحدِ مِن آلِ الشَهابِ أَميرةٌ","رَحَلَت فَأَبَكت بَعدَها مُقَلَ المَلا",52,"ل",2,1],["فَيا لِلّهِ مِن حَدَثٍ مُريبٍ","بِهِ تُشجَى المَآقي وَالصُدورُ",53,"ر",1,0],["فيال لها رتبة جَلَّت بلا طلبٍ","ولا حسود ولا ذل ولا كَلَل",54,"ل",1,0],["فيا للهِ أي فتىً اراهُ","كما انعطفتْ بشاربها الخمورُ",55,"ر",1,0],["فَيا لِلَّهِ يَومَ نَعوهُ ماذا","وَعا سَمعُ الرَسولِ مِنَ النَعِيِّ",56,"ي",1,0],["فَيا لِلَّهِ ما أَشأَر","نَ عِندي مِن جَوىً وَأَسا",57,"س",2,0],["فَيا لِلَّهِ ما تَنفَكُّ صَبّاً","يَشوقُكَ مَنزِلٌ أَقوى وَدارُ",58,"ر",1,0],["فَيا لَلناسِ لِلرَجُلِ المُعَنّى","بِطولِ الحَبسِ إِذ طالَ الحِصارُ",59,"ر",1,0],["فَيا لِلناسِ إِنَّ قَناةَ قَومي","أَبَت بِثَقافِها إِلّا اِنقِلابا",60,"ب",2,0],["فيا لله من بدر","به الأقمار تكتمل",61,"ل",1,0],["في الله ما يَنويه من إدراكها","بكلاءةٍ يفدي أبي كلاءها",62,"ا",3,0],["فَيا لِله أَيُّ جَلِيلِ خَطبٍ","دَقِيقٌ عِنْدَهُ الْخَطْبُ الْجَلِيلُ",63,"ل",1,0],["فَيا لَلْمَعالِي وَالْعَوالِي لِهالِكٍ","لَهُ الْمَجْدُ باكٍ وَالْمَكارِمُ نُوَّحُ",64,"ح",1,0],["فَيا لَلَّيالِي كَيْفَ أَنْجُو مِنَ الرَّدى","وَخَلْفِي وَقُدَّامِي لَهُ أَيْنَ أَسْرَحُ",64,"ح",1,0],["فَيا لِلناسِ للريمِ المُفَدّى","بِروحي فَهوَ ريمٌ لا يُرامُ",65,"م",1,0],["فَيا للناس للداعي بِلَفظٍ","فَصيحٍ جاءَ بِالمَعنى الصَحيحِ",66,"ح",1,0],["فَيا لِلَّهِ عصرُ هوىً تقضّى","بأَفنانِ الحقيقة وَالمجازِ",67,"ز",1,0],["فيا لله ما لاقى","فؤادُ الصبِّ من كتبكْ",68,"ك",1,0],["في اللّه منك وَمِن جميع قرابتي","خَلفٌ وللّه اللجا والمرجعُ",69,"ع",1,0],["فيا للّهِ مِن عصر ومصر","طَريفهُما به ينسى التليدُ",70,"د",1,0],["في اللّه من كلّ الفوائت خالفٌ","واللّه رُجعاناً فلا مشؤوجه",71,"ج",2,0],["فَيا لِلّه مَجلِسُ رَوض أُنسٍ","هُوَ الفردوس وَالدُنيا جنانُ",72,"ن",1,0],["فَياللَه مِن حَرَم مَنيع","لِحُرمتهِ تَضاءلتِ النُجومُ",73,"م",1,0],["فَياللَه مِن نَفحات قُدس","بِها تَحيا النُفوس لَدى اِنتِشاقِ",74,"ق",1,0],["فَيا للهَوى مِن مُعرب غنج لحظه","عَلى أَنّ مبنيّ الجُفون عَلى الكسرِ",75,"ر",1,0],["فيا للهِ زائدتي غراماً","بزَوْرتها وقاتلَتي دَلالا",76,"ل",2,0],["في اللُّبابِ اللُّبابِ من كرمِ الأح","سابِ يُلْفَي وفي المُصاصِ المُصاص",77,"ص",1,0],["فَيا لَلَهِ مِن هَمٍّ طَويلاٍ","وَيا لِلناسِ مِن جَفنٍ قَصيرِ",78,"ر",1,0],["فيا للّه كم علم حوته","فليس على معارفها مزيد",79,"د",1,0],["فيا للّه ما أحلى معان","وألفاظ أرق من الشراب",80,"ب",1,0],["فَيا لِلَّهِ دَرّك من حُسام","تقلَّد من عَزائمه حُساما",81,"م",2,0],["فيا للهِ من يأسٍ مُبينٍ","يخالفُ حالَه الصبرُ الجميلُ",82,"ل",1,0],["فيا لله من والٍ مشيرٍ","عظيم الشأن عالي القدر سامي",83,"م",2,0],["فيا للَه كم فتكت وأضحت","مخضبة المخالِ والحجالِ",84,"ل",1,0],["فيا للّه من ظبيٍ","رمى الأساد بالأسرِ",85,"ر",1,0],["فيا للشبابِ الغَضِّ أَنْهَجَ بُرْدُهُ","ويا لرياضِ اللهو جَفَّ سَفَاها",86,"ا",3,0],["فياللَه ما هذي كهذي","ولا كالنفس تبغض من نهاها",87,"ا",3,0],["فى الليل بيت الشعر منزله به","من كل ناحية ترى انواره",88