{"poems":[[55,"أعلى الغور تعرفت الخياما","https://www.aldiwan.net/poem29816.html","الرمل"],[65,"عرضت والنجم واه عقده","https://www.aldiwan.net/poem45808.html","الرمل"],[88,"آذنت شمس حياتي بمغيب","https://www.aldiwan.net/poem10474.html","الرمل"],[75,"أيها الظافر أبشر بالظفر","https://www.aldiwan.net/poem11957.html","الرمل"],[74,"كل يوم سعادة مستهله","https://www.aldiwan.net/poem19475.html","الخفيف"],[53,"ذكر الأخفش القديم فقلنا","https://www.aldiwan.net/poem65885.html","الخفيف"],[91,"جف روض المنى وشح الربيع","https://www.aldiwan.net/poem44612.html","الخفيف"],[47,"كلما شاءت الرسوم المحيله","https://www.aldiwan.net/poem65542.html","الخفيف"],[68,"صال فينا الردى جهارا نهارا","https://www.aldiwan.net/poem40126.html","الخفيف"],[99,"بي نزوع إلى الدموع الهوامي","https://www.aldiwan.net/poem24764.html","الخفيف"],[89,"حي مغنى الهوى بوادي الشآم","https://www.aldiwan.net/poem8286.html","الخفيف"],[54,"صاح بالوعظ شيب رأس مضي","https://www.aldiwan.net/poem26582.html","الخفيف"],[50,"غننا بالطلول كيف بلينا","https://www.aldiwan.net/poem65279.html","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39586","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42507","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142000","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54330","الخفيف"],[92,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179170",""],[91,"جف روض المنى وشح الربيع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=567172",""],[113,"غبت عن ذاتي فما شأن السوى","https://www.aldiwan.net/poem16674.html","الرمل"],[136,"ربع أسماء إذ هي الأنس آلا","https://www.aldiwan.net/poem54778.html","الطويل"],[147,"ما نرى للثناء عنك عدولا","https://www.aldiwan.net/poem11801.html","الخفيف"],[366,"يا لحبر مضى وأخلى الديارا","https://www.aldiwan.net/poem68103.html","الخفيف"],[369,"من رأي قبل ثناياك مداما","https://www.aldiwan.net/poem60646.html","الرمل"],[385,"أخلق الدار بالعقيق الدثور","https://www.aldiwan.net/poem49208.html","الخفيف"],[415,"ما يريد الشوق من قلب مغنى","https://www.aldiwan.net/poem32369.html","الرمل"],[422,"لهذي النوق تنحط كلالا","https://www.aldiwan.net/poem54004.html","الرمل"],[422,"عد عن من لج في قال وقيل","https://www.aldiwan.net/poem54131.html","الرمل"],[463,"دع ملامي باللوى أورح ودعني","https://www.aldiwan.net/poem55844.html","الرمل"],[463,"ما على منجد رأى ما أهمه","https://www.aldiwan.net/poem55903.html","الخفيف"],[463,"أنذرتني أم سعد أن سعدا","https://www.aldiwan.net/poem56214.html","الرمل"],[505,"طرق السر من البرهان ما","https://www.aldiwan.net/poem37802.html","الرمل"],[563,"أيها السائر بالركبان حي","https://www.aldiwan.net/poem33571.html","الرمل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59772","الرمل"],[966,"","https://poetry.dctabudhabi.ae/diwan/poem/146422","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62601","الرمل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138076",""],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56622","الخفيف"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109182","الخفيف"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133873","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79871","الرمل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108775","الخفيف"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108838","الخفيف"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100960","الرمل"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87834","الخفيف"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87825","الخفيف"],[1838,"","https://poetry.dctabudhabi.ae/diwan/poem/104136","المديد"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125371","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69418","الخفيف"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46495","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53044","الرمل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28605","الرمل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67256","الرمل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93736","الرمل"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/198651","الرمل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129861","الرمل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76051","الخفيف"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205789","الخفيف"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205433","الخفيف"],[3206,"","https://poetry.dctabudhabi.ae/diwan/poem/145879","الرمل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112409","الرمل"],[3477,"","https://poetry.dctabudhabi.ae/diwan/poem/132913","الخفيف"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85205","الخفيف"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127077","الخفيف"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83146","الرمل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120506","الخفيف"],[4733,"عتاب","https://www.poetsgate.com/ViewPoem.aspx?id=189631",""],[4750,"الطيب","https://www.poetsgate.com/ViewPoem.aspx?id=180398",""],[4782,"يَمَن الأسى","https://www.poetsgate.com/ViewPoem.aspx?id=199200",""],[4791,"السراب","https://www.poetsgate.com/ViewPoem.aspx?id=35918",""],[4984,"أَنْتَ مَنْ فَضَّلَ الإله","https://www.poetsgate.com/ViewPoem.aspx?id=201626",""],[4987,"ويش استفيد","https://www.poetsgate.com/ViewPoem.aspx?id=49581",""],[5121,"بَيْرُوتُ الْحُبُّ","https://www.poetsgate.com/ViewPoem.aspx?id=215332",""],[5410,"والتقينا","https://www.poetsgate.com/ViewPoem.aspx?id=152249",""],[5414,"بكائية بين يدي بشار بن برد","https://www.poetsgate.com/ViewPoem.aspx?id=12926",""],[5442,"ألف الصبوة واستحلى الغرما","https://www.poetsgate.com/ViewPoem.aspx?id=114748",""],[5573,"كل ماقلت هانت واحتكمها حكيم","https://www.poetsgate.com/ViewPoem.aspx?id=200089",""],[5616,"صرخة","https://www.poetsgate.com/ViewPoem.aspx?id=204843",""],[5732,"كلما قلت","https://www.poetsgate.com/ViewPoem.aspx?id=177952",""],[5739,"الوتين ...!","https://www.poetsgate.com/ViewPoem.aspx?id=155469",""],[5751,"بينَ موتٍ وموت","https://www.poetsgate.com/ViewPoem.aspx?id=214771",""],[5843,"احزان المواني","https://www.poetsgate.com/ViewPoem.aspx?id=51283",""],[5937,"لا يُجيدُ الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=211809",""],[5956,"الاصطباح بالأفراح","https://www.poetsgate.com/ViewPoem.aspx?id=193167",""],[6056,"البارعة","https://www.poetsgate.com/ViewPoem.aspx?id=156701",""],[6096,"ياترى","https://www.poetsgate.com/ViewPoem.aspx?id=202963",""],[6102,"حُداءُ الجَثامِين !!","https://www.poetsgate.com/ViewPoem.aspx?id=183615",""],[6115,"ياوجودي على طفل تهمل عيونه","https://www.poetsgate.com/ViewPoem.aspx?id=180490",""],[6189,"عاهة مستديمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83601&r=&rc=68",""],[463,"ما على منجد رأى ما أهمَّهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60295&r=&rc=351",""]],"verses":[["كُلَّما شَيَّخَ عِندي ضَيفُها","رَجَّعَتهُ جُدُدُ الطولِ غُلاما",0,"م",2,0],["كُلَّما شِئتُ تَأَمَّلتُ لَهُ","مَنظَراً أَصبو إِلَيهِ حَسَنا",1,"ن",2,0],["كُلَّما شارَفَهُ مِنّا فَتىً","غالَهُ المِقدارُ مِن قَبلِ الوُثوبِ",2,"ب",1,0],["كُلَّما شاءَ تَأَتّى أَن يَرى","خُلُقَ البِرجيسِ في خَلقِ القَمَر",3,"ر",1,0],["كلما شدَّت الوزارة إزراً","حمل الجيش في المعاند حمله",4,"ل",2,0],["كلّما شذَّتِ الفروعُ عن الأص","لِ ثناها فألحقَ الفرعَ أصلا",5,"ل",2,0],["كلما شاعدت المقابر حولي","أخذتني مهابة وخشوع",6,"ع",1,0],["كُلَّما شاءَتِ الرُسومُ المَحيلَه","هَيَّجَت مِن مَشوقِ صَدرٍ غَليلَه",7,"ل",2,1],["كُلَّما شامَ بَرقٌ مَغناكَ قَلبي","أَرسَلَت سُحبُ أَدمُعي أَمطارا",8,"ر",2,0],["كلّما شارف الثرى فيض نور","مرسل من جبينك الوضّاح",9,"ح",1,0],["كُلَّمَا شِمْتُ بَارِقاً خِلْتُ ثَغْراً","بَاسِماً مِنْ خِلالِ تِلْكَ الْخِيَامِ",10,"م",1,0],["كُلَّما شَمَّ لاقِحاً شَمَّ مِنها","رَأسَ فَحلٍ بِرِجلِها مَغلِيُّ",11,"ي",1,0],["كُلَّما شِئتُ عَلَّني بِرُضابٍ","يَترُكُ القَلبَ لِلسُرورِ خَدينا",12,"ن",2,0],["كلما شمتُ بارقاً من جمالٍ","طِرتُ في أثرهِ أشقُّ طريقي",13,"ق",2,0],["كُلَّما شَافَهَ النَّسِيمُ ثَراهُ","عَادَ مِنْهُ بِنَفْحَةٍ كَالْمَلابِ",14,"ب",1,0],["كُلَّمَا شَطَّتِ المَنَاصِبُ أَدْنا","هَا وَقَدْ رَاضَ صَعْبَهَا الاِعْتِزَامُ",15,"م",1,0],["كلما شبّبَ خداك","بخمر أو بطيب",16,"ب",1,0],["كلما شدّني المزارُ إليه","طالعتني صحائِفُ الديوان",17,"ن",1,0],["كلَّما شاقني التأملُ لفتَّني مجاري","المياهِ بينَ الشِّعاب",18,"ب",1,0],["كلما شاهدت المقابر حولي","اخذتني مهابة وخشوع",19,"ع",1,0],["كُلَّما شامَت بُدوراً مُقلَتي","قالَ قَلبي لا أُحب الآفلين",20,"ن",1,0],["كُلُّ مَا شَاهَدُوا وهُمُ جَاهِلُوهُ","أنكَرُوُهُ وعَيَّروُا الجُهَّالا",21,"ل",2,0],["كُلَّما شِمتَها لِسَفكِ الدَمِ المَم","نوعِ أَضحى بِحَدِّها مَطلولا",22,"ل",2,0],["كُلَّما شامَ بَرق مَعناكَ قَلبي","أَرسَلت سجب أَدمُعي أَمطارا",23,"ر",2,0],["كلّما شِيمَ سقاني أَدمُعي","وسقَى المِسكَ سِواكاً والمُداما",24,"م",2,0],["كُلَما شُفّنا الغَرام فنُجتا","قيل غَنوا وَأَينَ مِنا السُرورُ",25,"ر",1,0],["كلَّما شاهَد شملاً جَامِعاً","طارَ شوقاً وهفَا وجْداً وأنّا",26,"ن",2,0],["كلَّما شامتْ سناً من بارق","قذفت لوعتها دمعاً مذالا",27,"ل",2,0],["كلّما شام سنا بارقه","جَدّ جدّ الوجد بالدمع الهمول",28,"ل",1,0],["كلَّما شارفَ عمريْه أبٌ","منهمُ آزرهُ الإقبالُ بابنِ",29,"ن",1,0],["كلما شذَّ عنك فائت حظٍّ","ضمِنتْ ذمّةُ المقادير غُرْمَهْ",30,"م",2,0],["كلّما شُدّتْ بظهري هَجمةٌ","ركب الشرَّ لها ركضاً وشدّا",31,"د",2,0],["كلَّما شارَقَ مَجْلاها الخَفَا","هَيَّجَ القلبَ المُعَنَّى كلَّما",32,"م",2,0],["كلما شمت بريقاً لامعاً","من حمى نجد شواني الشوق شي",33,"ي",1,0],["كلما شئنا غرقنا فيه عن","كل شيءٍ ولنا الداءُ دُوَيّ",33,"ي",1,0],["كلما شَحَّ غمام","أنا بالورْد حَري",34,"ي",1,0],["كلما شاب ينحني","بيّض الله وجهه",35,"ه",1,0],["كلما شلنا قفيزاً","طاح منا طاح ثوجُ",36,"ج",1,0],["كلما شِمتُها أكفكف من دم","عي وأبكى على عهود الوداد",37,"د",1,0],["كلما شئت أن أزورك يا إسما","عيل عاق السقام عما أشاء",38,"ا",2,1],["كلما شاءَ فاستفزَّ","ته بالغمز كهربا",39,"ب",2,0],["كلما شقق مجد رخي ال","بال لم يعنه الذي عناني",40,"ن",2,0],["كلَّما شَعشها تحتَ الدُجى","خلتهُ أوقد منها لَهبا",41,"ب",2,0],["كلما شنفت بألفاظه الآ","ذان تاهت على حلَى الأعناق",42,"ق",1,0],["كلما شام باكياً","من جناياته ابتسم",43,"م",1,0],["كلما شام لها برقا سرى","مَوهِناً مرّت جَهاما خُلّبا",44,"ب",2,0],["كُلَّما شامَ بارِقاً مِن جَمالٍ","راحَ يَشدو بِسِحرِهِ وَدَلالِه",45,"ل",2,0],["كُلَّما شامَ بارِقاً مِن رَجاءٍ","فَجَعَ اليَأسُ قَلبَهُ بِرَجائِه",46,"ا",3,0],["كلما شئت لقيت امرءاً","يشتكي شكوى تحز الضميرا",47,"ر",2,1],["كلَّما شَبَّ من بنيها هُمامٌ","مُخلِصُ القلبِ صادِقُ الوجدَانِ",48,"ن",1,0],["كُلَّما شِمتَ مِن أَنامِلِهِ العَش","رِ نَدىً خِلتَها مِنَ السُحبِ عَشرا",49,"ر",2,0],["كُلَما شَفها النحول تَقوّت","فَاعجبوا مِن ضَعيفَةٍ وَقَويه",50,"ي",2,0],["كلما شادت له قصر علا","حُطِمت منها صدور وكعوب",51,"ب",1,0],["كُلَّما شُنَّت عَلَيهم غارَة","أَغمَدوا البيضَ وَسَلوا الأَعيُنا",52,"ن",2,0],["كلّما شعشعها قال احتسِ","بنتَ كرمٍ شُفعت باللَعس",53,"س",1,0],["كُلَّما شبَّت ضراماً","زدت فيها أَريحيّه",54,"ي",2,0],["كلما شامت غراري حده","خفقت خفق فؤاد الفرق",55,"ق",1,0],["كلّما شئتُ الذي قد شاءَهُ","فحنى لي كأسَهُ أفتَتِحُ",56,"ح",1,0],["كُلُّ ما شاءهُ إلَهُ البَرايا","كَونَهُ فَهوَ كائِنٌ لا مَحالا",57,"ل",2,0],["كلما شاق ناظريكِ جمال","أو هفا في سماك روح غريب",58,"ب",1,0],["كلما شاقة الجمال تغنى","فسمعنا غناءه إلهاما",59,"م",2,0],["كلما شدت غريقا","فلتت دون ثبات",60,"ت",1,0],["كلّما شاهدتُ تلكَ النّيّرات","وجمال الله فيها يَنجلي",61,"ي",1,0],["كلما شئتُ أسبَلت دَمَ قَلبي","فَأَرى فيه صورَةَ الأحِبابِ",62,"ب",1,0],["كلما شبب النسيم لديها","راح بالوجد نهرها في النظام",63,"م",1,0],["كلما شئت من مديح فقل فيه","وجانب مزالق الاشراك",64,"ك",1,0],["كُلَّما شَدَّت عَلى أَطرافِها","أَمعَنت في النَفس بِالسحر خُطاها",65,"ا",3,0],["كلما شمت في الأبارق برقا","بثق الدمع من جفوني بثقا",66,"ق",2,1],["كلُّ ما شَاء المُعادي فليكن","ما تمَادى الصَّحبُ في الظنِّ خِتاما",67,"م",2,0],["كل ماشبيت نار المحّبه مع حبيب","قام يسحب في مشاهيبها ويرشها",68,"ش",3,0],["كلما شعَّ لليمانيّ أنسٌ","حجبَ الحزنُ بالمآسي السرورا",69,"ر",2,0],["كلّ ما شفت برقٍ من بعيد يلوح","قلت لأهل الركايب أبشروا بالشراب",70,"ب",1,0],["كل ما شُدَّ من بنود بحزم","طالها قانص الحروب برشق",71,"ق",1,