{"poems":[[29,"لمن الديار رسومهن خوالي","https://www.aldiwan.net/poem5974.html","الكامل"],[100,"مؤتمر الجماد","https://www.poetsgate.com/ViewPoem.aspx?id=55343",""],[96,"من كسعد ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66301&r=&rc=19",""],[520,"أقسمت لا كشفت لمصر غمة","https://www.aldiwan.net/poem12089.html","الكامل"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/66973","الطويل"],[5152,"لِمَ تَضيق؟","https://www.poetsgate.com/ViewPoem.aspx?id=208827",""],[5186,"رب خير يولى ولا من بشير","https://www.poetsgate.com/ViewPoem.aspx?id=156485",""],[5354,"لا تعتذر","https://www.poetsgate.com/ViewPoem.aspx?id=187205",""],[5431,"قطوف عشقٍ دانيه!!...","https://www.poetsgate.com/ViewPoem.aspx?id=200580",""],[5431,"دورة الشرّ","https://www.poetsgate.com/ViewPoem.aspx?id=213762",""],[5829,"ما كان ينقصنا سوى الكيماوي","https://www.poetsgate.com/ViewPoem.aspx?id=152739",""],[5881,"تلقاء مدين","https://www.poetsgate.com/ViewPoem.aspx?id=184317",""]],"verses":[["حَمَّمتَ وَجهَكَ فَوقَ كيرِكَ قائِماً","وَسَقَيتَ أُمَّكَ فَضلَةَ الجِريالِ",0,"ل",1,0],["حمم ظمأى متى ما انطلقت","فدم الإنسان أروى منهل",1,"ل",1,0],["حمم كالجحيم مستعرات","ردّها حلمه سلاما وبردا",2,"د",2,0],["حمم لو اكتحل الحسان بلونه","لم يفتقرن إلى اكتحال الإثمد",3,"د",1,0],["حُمَمٌ فوقها من البيضِ نارٌ","كُلُّ مَنْ أُرْسِلَتْ عليه رَمَادُ",4,"د",1,0],["حِمَمٌ ..وتقذِفُها المجاهلُ من فمٍ","يُرغِي ويجمعُ رَغْيَهُ التَّحْرِيقُ",5,"ق",1,0],["حمم النار قد تذوب وما ذابت","حقود تأججت في الصدور",6,"ر",1,0],["حممٌ تَقاذَفُني وأخرى تعْتلي","صدري فأمسي واللهيب رعافُ",7,"ف",1,0],["حممٌ تؤججُ من يقين بارد","وجدا ليصهرنا دموعا جاريهْ!",8,"ي",2,0],["حممٌ في حشاشتي الآن تغلي","مثل بركانَ عمّدته السماء",9,"ا",2,0],["حمم تفجَّر والسقوط سماوي","ما كان ينقصنا سوى الكيماوي",10,"ا",3,1],["حممت في زيت السؤال قصيدي","وصنعت من لحن الهوى قنديلي",11,"ل",2,1]]}