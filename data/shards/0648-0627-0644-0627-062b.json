{"poems":[[2,"فيم لحت إن لومها ذعر","https://www.aldiwan.net/poem25030.html","المنسرح"],[1,"ما تنظرون بحق وردة فيكم","https://www.aldiwan.net/poem20966.html","الكامل"],[382,"بشراك بشراك قد أدناكم النائي","https://www.aldiwan.net/poem66985.html","البسيط"],[396,"إن تطلب الهم كله يا فتى والغم","https://www.aldiwan.net/poem54524.html","عموديه"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64576","الرجز"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124723","السريع"],[1948,"","https://poetry.dctabudhabi.ae/diwan/poem/29555","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60951","الكامل"],[3637,"","https://poetry.dctabudhabi.ae/diwan/poem/106796","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91770","الكامل"],[4209,"","https://poetry.dctabudhabi.ae/diwan/poem/105541","الرمل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133068","البسيط"],[5039,"عفرى","https://www.poetsgate.com/ViewPoem.aspx?id=48141",""],[5121,"طير الحقول","https://www.poetsgate.com/ViewPoem.aspx?id=37478",""],[6031,"مَعَاهِدُهُمْ بالأبْرقَيْنِ هَوَامِدُ","https://www.poetsgate.com/ViewPoem.aspx?id=46280",""]],"verses":[["وَالإِثمُ مِن شَرِّ ما يُصالُ بِهِ","وَالبِرُّ كَالغَيثِ نَبتُهُ أَمِرُ",0,"ر",1,0],["وَالإِثمُ داءٌ لَيسَ يُرجى بُرؤُهُ","وَالبِرُّ بُرءٌ لَيسَ فيهِ مَعطَبُ",1,"ب",1,0],["والإثم قد نَسَخَت آياتِ سورتِهِ","رياتُ مطلَعِ غُفرانٍ وَإِرضاءِ",2,"ا",2,0],["والإثم والسم في دينك وذه مع ثم","تسمع أقوال أهل الوقت والأحوال",3,"ل",1,0],["والاثم والبغي وطارق المحن","سبحانه يكفي من استكفاه",4,"ه",1,0],["والاثنان إن علت بعدها","فيها ثلاثٌ غنمٌ رتعُ",5,"ع",1,0],["وَالأَثلُ مِن سَعيا وَحَليَةَ مُنزَلٌ","وَالدَومُ جاءَ بِهِ الشُجونُ وَفَعُليَبُ",6,"ب",1,0],["والأثل غير الأثْل أيْمنَ رَادع","هيهاتَ قَلّص ظُلُه الممدودُ",7,"د",1,0],["والإثنَانِ اللَّذَانِ قَدِ استَطَالاَ","نَهَارٌ كانَ فِيهِ ألفُ يَومِ",8,"م",1,0],["وَالإثمد المَعروف أَعماه الهَوى","فَلأيّ عَين بَعدَ ذاكَ جَلاء",9,"ا",2,0],["والأثيلات المظلات بها","أيها الأثل سقيني الغماما",10,"م",2,0],["والأثل والبان والخزامى","والنخل والراك في البديد",11,"د",1,0],["وإلا ثغرها مكنز ٍ للهوايل","مايلحق يرد الشهاده قتيله",12,"ل",2,0],["وَالأَثِيِرُ انْسَابَ فِي حُضْنِ الْلُّقَيَّا","صَافَحَ الْوِجْدَانَ بِالْحِسِّ الْنَّبِيِلِ",13,"ل",1,0],["وإلاّ ثلاثاً كالحَمَائِمِ جُثَّماً","ونُؤْياً عَفَتْهُ الدَّاهِيَاتُ العَوائِدُ",14,"د",1,0]]}