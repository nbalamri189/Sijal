oem56139.html","المنسرح"],[459,"ألفتك سراء على الأين في العلى","https://www.aldiwan.net/poem15093.html","الطويل"],[459,"اعيذ قريشا أن تصيخ لكاشح","https://www.aldiwan.net/poem15463.html","الطويل"],[462,"ليست قدوداً ولكن هذه أسل","https://www.aldiwan.net/poem3144.html","عموديه"],[462,"لقد سل سيفا والغدار الحمائل","https://www.aldiwan.net/poem3189.html","عموديه"],[462,"كيف السكون من الدنيا إلى سكن","https://www.aldiwan.net/poem3393.html","عموديه"],[462,"لله أية ليلة قضيتها","https://www.aldiwan.net/poem3510.html","عموديه"],[475,"بي من جوى التبريح اشفاق","https://www.aldiwan.net/poem15351.html","السريع"],[493,"دعا فأجابه القدح","https://www.aldiwan.net/poem9811.html","مجزوء الوافر"],[512,"هلم بنا إلى أرض الحجون","https://www.aldiwan.net/poem20805.html","الوافر"],[527,"إلى الدرعية الغراء تسري","https://www.aldiwan.net/poem37443.html","الوافر"],[549,"يا حادي العيس عرج بي على الدمن","https://www.aldiwan.net/poem47163.html","البسيط"],[549,"لنا من ثناياك الغريض المرشف","https://www.aldiwan.net/poem47403.html","الطويل"],[549,"ألا ماذا يريبك من همومي","https://www.aldiwan.net/poem47740.html","الوافر"],[556,"كم غادة كاملة في حسنها","https://www.aldiwan.net/poem34207.html","الرجز"],[560,"تحت الثرى سيصير من فوق الثرى","https://www.aldiwan.net/poem52774.html","الكامل"],[561,"غرام سقى قلبي مدامته صرفا","https://www.aldiwan.net/poem13596.html","الطويل"],[573,"يا معرضاً قد آن أن تقبلا","https://www.aldiwan.net/poem2887.html","السريع"],[573,"أقاموا بالمواخير","https://www.aldiwan.net/poem2950.html","الهزج"],[573,"أمجلس لهوي ليس لي منك مجلس","https://www.aldiwan.net/poem3058.html","الطويل"],[584,"رأى الحسن في العشاق ممتثل الأمر","https://www.aldiwan.net/poem17532.html","الطويل"],[584,"إذا بعدوا وافوك أسرى وإن دنوا","https://www.aldiwan.net/poem17704.html","الطويل"]],"verses":[["وَلي في عَدوّي إِن مَشى المَوتُ نَحوَهُ","عَزاءٌ إِذا أَودى الرَدى بِخَليلِ",0,"ل",1,0],["ولي في دُعائِكَ ظنٌ جَميلٌ","وكلُّ امْرِئٍ فلَهُ ما نَوى",1,"و",2,0],["ولي فيكَ وُدٌّ واعْتِدادٌ غرَسْتُهُ","فراقَت بِه منْ يانِعِ الحمْدِ أوْراقُ",2,"ق",1,0],["وَلي في الهَوى شِعرانِ شِعرٌ أُذيعُهُ","وَآخَرُ في طَيِّ الفُؤادِ سَتيرُ",3,"ر",1,0],["ولي فيه دمع يلذع الخدّ حره","وحزن كما امتدّ الظلام طويل",4,"ل",1,0],["وَلي في كُلِّ يَومٍ مِنكَ عَتبٌ","أَقومُ بِهِ مَقامَ الإِعتِذارِ",5,"ر",1,1],["وَلي فيكِ مِن فَرطِ الصَبابَةِ آمِرٌ","وَدونَكِ مِن حُسنِ الصَيانَةِ زاجِرُ",6,"ر",1,0],["ولي في بديع الوصف كالصخر قوة","ولكنه سيل على الأرضِ سائح",7,"ح",1,0],["ولي فرسٌ قد بات ضيفاً لطرفه","فبات كلانا وهوَ بيتُ جواد",8,"د",1,0],["وليفاخر بكَ الملوك مليك","هو والله والورى عنك راضي",9,"ض",2,0],["ولي في الذي أهوى هوىً فلو أنه","تكلَّف لي عطفاً لناديته مهلا",10,"ل",2,0],["ولي فضلٌ عليك لأن فعلي","بغير أذى عليك فلِمْ كرهتَهْ",11,"ت",2,0],["ولي فيك آمال وقد عَلَقَتْ يدي","بعروتك الوثقى فهل أنا مُسْلَمُ",12,"م",1,0],["وَلّى فَوَدَّعَتِ السَماءَ بَهائَها","مِن بَعدِهِ وَهَوى النَهارُ عَليلا",13,"ل",2,0],["وَلي في الحُبِّ أَخلاقٌ كِرامٌ","فَسَل مَن شِئتَ عَنّي وَاِمتَحِنّي",14,"ن",2,0],["وَلي في بِلادِ اللَهِ مَسرىً وَمَسرَحٌ","وَلي مِن عَطاءِ اللَهِ مَغنىً وَمَغنَمُ",15,"م",1,0],["وَلي فَرَسٌ أَنتَ العَليمُ بِحالِها","وَبِالرَغمِ مِنّي رَبطُها وَمُقامُها",16,"م",3,0],["وَلي فيهِ قَلبٌ بِالغَرامِ مُقَيَّدٌ","لَهُ خَبَرٌ يَرويهِ دَمعِيَ مُطلَقا",17,"ق",2,0],["وَلي فيهِ إِمّا واصِلٌ مُتَدَلِّلٌ","عَلَيَّ وَإِمّا هاجِرٌ مُتَصَلِّفُ",18,"ف",1,0],["وَلي فُؤادٌ عَنكَ لا يَرعَوي","وَلي لِسانٌ عَنكَ لا يَفتُرُ",19,"ر",1,0],["وَلي فيكَ ما لَم يَقُل قائِلٌ","وَما لَم يَسِر قَمَرٌ حَيثُ سارا",20,"ر",2,0],["وَليَفخَرِ الفَخرُ إِذ غَدَوتُ بِهِ","مُرتَدِياً خَيرَهُ وَمُنتَعِلَه",21,"ل",2,0],["وَلي فُؤادٌ إِذا طالَ العَذابُ بِهِ","طارَ اِشتِياقاً إِلى لُقيا مُعَذِّبِهِ",22,"ب",2,0],["وَلي فُؤادٌ دَنَت إِفاقَتُهُ","فَاِنزاحَ إِلّا صُبابَةً سُكرُه",23,"ر",2,0],["وَليَفنَ تُفّاحُ الخُدودِ فَلَستُ مِن","تَقبيلِهِ غَزِلاً وَلا مِن عَضُّهِ",24,"ض",2,0],["وَلي فُؤادٌ إِذا نَهنَهتُ صَبوَتَهُ","أَبى وَدَمعٌ إِذا كَفكَفتُهُ وَكَفا",25,"ف",2,0],["وَليَفدِهِ مِن كُلِّ ما يُختَشى","كُلُّ مَصونِ المالِ مَخزونِهِ",26,"ن",2,0],["ولي فيكَ التي تُلغي القَوافي","إذا ذُكِرَتْ ويُمتَهَنُ الكَلامُ",27,"م",1,0],["ولي في ساحَتْيكَ غديرُ نُعمى","صفا مَتناه واطَّرَدَ الحُبابُ",28,"ب",1,0],["وَلي في خِصالِ الخَيرِ ضِدٌّ مُعانِدٌ","يُثَبِّطُني عَنها إِذا ما نَوَيتُها",29,"ت",3,0],["وَلَيُفنِيَنَّكَ بِالَّذي","أَفنى أَباكَ بِهِ وَجَدَّك",30,"ك",1,0],["وَلي فُؤادٌ إِذا طالَ العَذابُ بِهِ","هامَ اِشتِياقاً إِلى لُقيا مُعَذِّبِهِ",31,"ه",1,1],["وَلي فَرَسٌ لَيسَت شَكوراً وَإِنَّما","بِها نُضرَبُ الأَمثالُ في العَضِّ وَالرَفسِ",32,"س",1,1],["وَلَيُفنِيَنَّ ثَراكَ عَن صَوبِ الحَيا","صَوبُ المَدامِعِ إِن طَلَبتَ مَزيدا",33,"د",2,0],["ولي في سماء الشرقِ مَطلَعُة كَوكَبٍ","جلا من طلوعي بينَ زهرِ الكواكِبِ",34,"ب",1,0],["وَلَيَفضَحَنَّكَ في المَحافِلِ كُلِّها","صَدري كَما فَضَحَت يَداكَ وُرودي",35,"د",2,0],["وَلِي فِي الأَرْبَعِينَ مَجَالُ لَهْوٍ","تَنَالُ يَدِي بِهِ عَقْدَ الرِّهَانِ",36,"ن",1,0],["وَلِي فِي سَرْنَسُوفَ مَقَامُ صِدْقٍ","أَقَرَّ بِهِ إِلَيَّ الْخَافِقَانِ",36,"ن",1,0],["ولي فؤادٌ متى تفخرْ سوى مُضرٍ","فؤادُ وجناءَ مثلُ الطائرُ الحذرِ",37,"ر",1,0],["وَلي فُؤادٌ يَكادُ الشَوقُ يَصدَعُهُ","إِذا تَذَكَّرَ مِن مَكنونِهِ الذِكَرا",38,"ر",2,0],["وَلي في مُمِضّاتِ الهِجاءِ عَنِ الخَنا","مَناديحُ في جَوزٍ مِنَ القَولِ أَوقَصدِ",39,"د",1,0],["وَلِي فُؤَادٌ ونُطْقٌ بالوِدادِ لَهُمْ","وبالمدَائِحِ مَشْغُوفٌ ومَشْغولُ",40,"ل",1,0],["ولي فُؤَادُ مُحِبِّ ليسَ يُقْنِعُهُ","غيرُ اللَّقاءِ وَلا يَشْفِيهِ تَعْلِيلُ",40,"ل",1,0],["وَليُفرِغِ السَعدَ فيها قادِرٌ صَمَدٌ","فَلَستُ أَقنَعُ مِن دَجنٍ بِإِفراغِ",41,"غ",1,0],["وَلَيَفنَيَن هَذا وَذاكَ كِلاهُما","إِلّا الإِلَهَ وَوَجهَهُ المَعبودا",42,"د",2,0],["ولي في الهوى عِلْمٌ تَجِلّ صفاتُهُ","ومن لم يُفَقّهه الهوى فهْو في جهل",43,"ل",1,0],["وليفخر الفخر إذا غدوت به","مرتدياً خيره ومنتعله",44,"ل",2,0],["ولي فم ناضبٌ وقلبٌ","فارغةٌ كأسهُ صديعَه",45,"ع",2,0],["ولي في المُنى ألاّ يُعرّجَ راكبي","وَيحْبِسَ عنها كُلَّ شيءٍ مُتَرَّبِ",46,"ب",1,0],["وَلي في كُلِّ مَعرَكَةٍ حَديثٌ","إِذا سَمِعَت بِهِ الأَبطالُ ذَلّوا",47,"ل",3,0],["وَلي فَرَسٌ يَحكي الرِياحَ إِذا جَرى","لِأَبعَدِ شَأوٍ مِن بَعيدِ مَرامِ",48,"م",1,0],["ولي فيك قبل اليوم غُرُّ قصائدٍ","كفاها سموّا أنها بعضُ منطقي",49,"ق",2,0],["ولي في سماء الشرق مطلع كوكب","جلا من طلوعي بين زهر الكواكب",50,"ب",1,0],["ولّى، فودّعت السماء بهاءها","من بعده ،هوى النّهار عليلا",51,"ل",2,0],["وَلي فُؤاد عَلى الهَوى جلد","بِغَير خَد الحِسان ما جَرَحا",52,"ح",2,0],["ولي في الهوى علم تجل صفاته","عن الظلم والعدوان والحقد والغل",53,"ل",1,0],["ولى في معالِى مجدِكم وعلائِكم","وفي عزكم دون الأنام مآلفُ",54,"ف",1,0],["ولي فيك آمالٌ في الثناءِ مدائحٌ","يقصِّر عن أشباهِها النظمُ والنثرُ",55,"ر",1,0],["ولِي فيك أنصارٌ عريضٌ طويلُها","بعيدٌ كآمالي بسيطٌ مديدُها",56,"د",3,0],["ولي في الشرقِ مضطرب وإني","بأقصى الغرب لي أقصى مجالِ",57,"ل",1,0],["ولي في اقتصاري فيه عذر ولم أكن","لأحصي نجوم الأفقِ أو أحسبُ القطرا",58,"ر",2,0],["وليفخر اليوم قوم باليراع ولا","حوفٌ عليهم فمن يخشونه ذهبا",59,"ب",2,0],["ولي في بيوتِ العامريّةِ حاجةٌ","هي الماءُ في عَضْبٍ حديثِ صِقالِ",60,"ل",1,0],["وَليُفرَعِ النَجمَ بِالقُربى الَّتي جَمَعَت","شَملَ الفَخارَ لَهُ وَالسُؤدُدَ البَدَدا",61,"د",2,0],["ولي في الحب رايٌُ غير اني","أغيرهُ متى أجدُ الوفيا",62,"ي",2,0],["ولّى فعدتَ وعاد أنسٌ وانجلت","ظلمٌ وعاش هوى وماتت حسَّدُ",63,"د",1,0],["ولي فيك عما فوتوه إعاضة","وأنت لمثلي موئل ومآب",64,"ب",1,0],["ولي فيك آمال كثير عديدها","وما أنا فيها يعلم الله أشعب",65,"ب",1,0],["ولي في صَنْعتي بُرهانُ موسى","وعندَ سوايَ تزويرُ الخيالِ",66,"ل",1,0],["وَلِي في الغِنى سَهمٌ إِذا ما أَفَدتُهُ","وَلِلدَفعِ عَن أَحسابِها مِنهُ أَسهُمُ",67,"م",1,0],["ولي في سُوايدا قلبِك الرَّحْبِ فَضْلةٌ","من الودِّ تَبْقَى حين تَفْنَى الوَدائع",68,"ع",1,0],["ولَّى فلا طمعٌ بعَطْفَةِ هاجرٍ","منه ولا أَمَلٌ لأَوْبَةِ راحل",69,"ل",1,0],["ولي في عكبَرا إخوان صدق","توافوا لي بأخلاق الظراف",70,"ف",1,1],["ولي في حشا التقويم يوم وإن خفى","عليّ مكانُ اليوم بين سطوره",71,"ه",1,0],["وليُّ فَضلٍ فاضلٌ مفضّلُ","الواعدُ الناجزُ والمؤمّلُ",72,"ل",1,0],["ولي في يا أفعى دموع بعيد ما","أثار ابن جنبي فارعوى ما سأخفيه",73,"ي",2,0],["ولي في الهوى شمسٌ إذا هيَ اشرقتْ","رأيتُ بها سحبَ الأسى كيفَ تُقشعُ",74,"ع",1,0],["ولي فكر كبستانٍ نضيرٍ","شهيُّ معارفي فيهِ ثمارُ",75,"ر",1,0],["وَلي في الأَرضِ مُضطَرَبٌ وَسيعٌ","وَمُرتَكَضٌ إِذا هِيَ لَم تَسَعني",76,"ي",1,0],["وَلي فيكُم مِدَحٌ كَالرِياضِ","باكَرَها العارِضُ الهاطِلُ",77,"ل",1,0],["ولي فيك اشعار تبلبل بابلا","وتذهل من الفاظهن بنو ذهل",78,"ل",1,0],["ولي فيه اشعار تبلبل بابلا","وهاروت منها ذاهب العقل ذاهل",79,"ل",1,0],["ولي فيك ما يسطو على القلب لفظه","ويقتسر الألباب وهو لطيف",80,"ف",1,0],["وَلي فيك يا بدر الدجى أحسن الرجا","فأَنتَ ثمال الخير وَالخَير يرتَجى",81,"ج",2,0],["وَلي في مَحَلَّةِ بابِ الصَغيرِ","غَزالٌ لَهُ الخَطبُ عِندي كَبيرُ",82,"ر",1,0],["وليفتخر ذا العصر وليسعد فذا","عبد الحميد على الجواد الرافل",83,"ل",1,0],["ولي فيك ود باقي كذا قد شددته","بأمراس كتان إلى صم جندل",84,"ل",1,0],["وَلي في العَرشِ جَلَساتٌ","عَلى الخُلُقِ بِها أَقضي",85,"ي",1,0],["وَلِيُّ فَضلٌ عَلى البَرايا","يَنشُرُني كُلَّما طَواني",86,"ن",2,0],["وَلي في هَواها مِن كِلاب عَواذلٌ","مَلامتهم في السَمع تعزى إِلى مرّه",87,"ر",2,0],["وَلي فيكَ يا قطب الوَرى أَمل عَسى","يَزول بِلَحظ مِنكَ عَن فِكرَتي رُعبي",88,"ي",1,0],["وَلي فيكَ يا هاجِري صَبوة","تحير في وَصفِها كل صَبّ",89,"ب",1,0],["ولي في الأرضِ غُرٌّ سائراتٌ","تَهاداها الأياسِرُ والأيامن",90,"ن",1,0],["ولي في الحَضْرةِ العَلْياءِ رَسْمٌ","إليه بأيْنقُي طالَ الرَّسيم",91,"م",1,0],["ولي فيه آمالٌ وقد صار مُقْنِعي","منَ البِرِّ تَوقيعٌ بصَدْرٍ منَ البُرّ",92,"ر",1,0],["ولى فِكَرٌ يُشتارُ من كَلماتها","مُجاجٌ إذا ما شِئْتُ أبدعْتُ نَضْده",93,"د",2,0],["وَلي فِكرَةٌ تَحتَ الدُجى في مُلِمَّةٍ","دَجَت فَتَوارَت في دُجاها الكَواكِبُ",94,"ب",1,0],["وَلي فيهِ آمالٌ إِذا ما تَأَخَّرَت","كَفانِيَ عَنها ما تَقَدَّمَها مِنهُ",95,"ن",2,0],["وَلي فَتكَةٌ تُطفي الوَهيجَ مُضَرَّما","وَلي عَزمَةٌ تَلقى الوَشيجَ مُصَمِّما",96,"م",2,0],["ولي في زَماني إن تأمَّلتُ أَمرنا","مَعاني جَريرِ أَو هجاءُ الفَرزدَقِ",97,"ق",1,0],["ولى فأبرزَ لي مَسي","حاً من يدَي عبدِ المسيحِ",98,"ح",1,0],["ولي فؤاد به الأمراض فاشية","أسألك ياشافي الأمراض تشفيها",99,"ي",3,0],["ولي فيكمُ يومَ الوداع مُهَفْهَفٌ","جفاني فأغْرى بالمدامع أجفاني",100,"ي",1,0],["ولي فيهِ تَعَالى حُسْنُ ظَنٍ","وذَنبي عِندَ رَحْمتِه يسيرُ",101,"ر",1,0],["ولي في أمير المؤمنين قصائد","بها تطرب الأسماعُ من كلُّ منشد",102,"د",1,0],["ولي فيها سماعات على مَنْ","تَزَيَّنَ من وجودهم الوجود",103,"د",1,0],["ولي في الهوى العذريِّ أرفع برتبةٍ","إلى مثلها أهل الصبابة تَقْصِدُ",104,"د",1,0],["ولي فَرَسٌ من نَسلِ أعوجَ رائعٌ","ولكِنْ على قَدرِ الشَّعيرِ يُحَمحِمُ",105,"م",1,0],["ولي في الموتِ يأسٌ مُستبينٌ","ولكن حالُ وَجدي لا تَحولُ",106,"ل",1,0],["ولي فيك ملء الخافقين مدائح","ولي غُرَرٌ ما قالها أحدٌ قبلي",107,"ي",1,0],["ولي في بلاد الله شرقاً ومغرباً","نوادر من حُرِّ الكلام سوائر",108,"ر",1,0],["ولي فيك من حُرّ الكلام وصفْوِه","قصائدُ تروي عن علاك خلالا",109,"ل",2,0],["ولي في حيّهم رشَأ غرير","تخاف لحاظَهُ بالفتك أُسْد",110,"د",1,0],["ولي في البصرة الفيحاء قوم","أصولُ بهم على الخطب الجسيم",111,"م",1,0],["ولي في أبيه قبلَه وهو أهْلُها","محاسنُ أوصاف تضيق عن الحصر",112,"ر",1,0],["ولي فؤادٌ لم يكن غادراً","والغدر لا يحسن في كل دين",113,"ن",1,0],["وَلِي فيكَ ما اسْتَنْبَطْتُهُ بقَرَائِحِي","ورُبَّ نَبَاتٍ ضُمِّنَتْهُ نبائثُ",114,"ث",1,0],["ولى في البديعِ الحُسْنِ كلُّ بديعةٍ","ولولا البديعُ الحسنِ ما كنتُ مُبْدِعا",115,"ع",2,0],["ولي في جَفنِ من أهواهُ طَرْفٌ","أحدُّ عليّ من طرَفِ الحُسامِ",116,"م",1,0],["ولى فأسرع في الفراق وما شفى","صبّا أقام من السقام على شفا",117,"ف",2,1],["ولي في سبيل الذنب جري مبرز","وعن سابقات السابقين قطوف",118,"ف",1,0],["ولي في حبِّ من أهواه سَبْقٌ","تقصّر عنه غايات السوابِقْ",119,"ق",1,0],["وليفرح العالم المنكوب عن سفه","فقد تعالت على الضوضاء أشذاء",120,"ا",2,0],["وليفدِ كفّيك مغلقُ اليد مخ","فورُ النواحي بالبخل ممتنعُ",121,"ع",1,0],["ولي فيك ما لم أحْبُهُ لمنوِّلٍ","وإن جادَ لي بالوفر وبالدَّثر",122,"ر",1,0],["ولي فيك ما لم يره الموت بعدهُ","اِذِ العمر أذْكارُ الرجال وخيرها",123,"ر",3,0],["ولّى فؤادي فجسمي لا أنيس بهِ","ولا يردُّ جوابَ السائلِ الطَّلل",124,"ل",1,0],["ولي في الورى مندوحةٌ غير أنني","رأيتكَ أَهلاً للَّذي أنا قائل",125,"ل",1,0],["ولى فللوجد ما أبديه من جزعٍ","باقٍ وللصبر مات أخفيه من شجن",126,"ن",1,0],["ولي في هواهُ وفي محاسن وجهه","نفسٌ مقيدةٌ وطرفٌ مطلق",127,"ق",1,0],["ولي فؤادٌ مِن حذارِ النوى","ورحلةِ الأحبابِ خَفّاقُ",128,"ق",1,0],["ولي في كل جارحة","لفضل الشيخ ممتدح",129,"ح",1,0],["ولي في الخَيْفِ أحبابٌ كِرامٌ","لديّ وإنْ همُ لم يُكرِموني",130,"ي",1,0],["وَلِي في ذَا كِتابٌ قُمْتُ فِيهِ","مَقاماً لَيْسَ يُنْكِرُهُ الحَسودُ",131,"د",1,0],["ولي فُؤادٌ إِذا أصبحتَ تأمُرُه","بالصّبرِ أمسى بغير الصَّبْرِ يأمرني",132,"ن",2,0],["ولي فَوقَ أَسماكِ المجرّةِ منزلٌ","وفي موقف الزُّهرِ الكواكبِ موقفُ",133,"ف",1,0],["وَلِي في كلّ شارقةٍ خليلٌ","أفارقُهُ بلا نَزَواتِ واشِ",134,"ش",1,0],["ولي فؤاد بالحسان مغرم","يَدكُّه محبوبه دكَّ الجبلْ",135,"ل",1,0],["ولَّى فكانَ كأنَّهُ في الأرضِ لم","يُولَد ولكن عاشَ مولودَ السَّما",136,"ا",1,0],["وَلي فيكَ عَينٌ ما إِنِ العَينُ ثَرَّةً","حَكَتها وَلا هامي الحَيا مِثلُها وَكفا",137,"ف",2,0],["ولي فَمٌ صَادَفَ مَنْ بَعْدِهِ","سلاسلَ الدمْعِ به سَلْسَلا",138,"ل",2,0],["ولي فيه أَحاديثٌ","ولي فيه أَخَابِيرْ",139,"ر",1,0],["ولي فيه إِمَّا ناطقٌ بِمَلامَتي","فأَعْمَى وإِمَّا مُبْصِرٌ فَهْو أَخْرَسُ",140,"س",1,0],["وَلِي فِيكَ بَيْنَ القُرْبِ وَالبُعْدِ مَشْهدٌ","يُريني صِدْقَ الهَجْرِ في كَذِبِ السِّرِّ",141,"ر",1,0],["وَلي فيكَ آمالٌ عَلَيْك بُلوغُها","فَلا دافِعٌ دُون الَّذي أَنْتَ حَاكِمُ",142,"م",1,0]]}