49",""],[5431,"وكلّ دروب الأرض ضربٌ من القُبل!","https://www.poetsgate.com/ViewPoem.aspx?id=197577",""],[5464,"طاوي الديار","https://www.poetsgate.com/ViewPoem.aspx?id=33886",""],[5464,"يا هند","https://www.poetsgate.com/ViewPoem.aspx?id=6842",""],[5464,"أوصيك بي شراً اذا خنت الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=7560",""],[5574,"يا أيّها الرّسام","https://www.poetsgate.com/ViewPoem.aspx?id=206043",""],[5626,"اتركْ هواها","https://www.poetsgate.com/ViewPoem.aspx?id=189468",""],[5650,"عَائِشَة... وَحْيُ الْقَصِيد!","https://www.poetsgate.com/ViewPoem.aspx?id=131223",""],[5661,"خليلي قد اتسعت محنتي","https://www.poetsgate.com/ViewPoem.aspx?id=181396",""],[5685,"قبلة الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=36763",""],[5956,"إنْ تَحْنِ ظهرك","https://www.poetsgate.com/ViewPoem.aspx?id=184366",""],[5956,"مناجاتي لابنتي هنادي","https://www.poetsgate.com/ViewPoem.aspx?id=192383",""],[5957,"صباح الحبّ يا شادي","https://www.poetsgate.com/ViewPoem.aspx?id=176992",""],[6056,"رحيق الذات","https://www.poetsgate.com/ViewPoem.aspx?id=130317",""],[6069,"يا باكي الدار بكاظمةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=105659",""],[6102,"قولي: ( ظلمته )","https://www.poetsgate.com/ViewPoem.aspx?id=182747",""],[6124,"فرشاة الأسنان","https://www.poetsgate.com/ViewPoem.aspx?id=159888",""],[6251,"عزة النفس .. إلى الرئيس إبراهيم الحمدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76482&r=&rc=22",""],[6304,"يقظان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1616&r=&rc=6",""]],"verses":[["فَرِشني أَكُن لَكَ سَهمَ النِضالِ","وَاِغصِب عَلَيَّ يَدَي مَن بَراني",0,"ن",2,0],["فَرُشدي لا يُغَيِّبُهُ مُدامٌ","وَلا أُصغي لِقَهقَهَةِ القَناني",1,"ن",2,0],["فَرُشّوا عَلى وَجهي أُفِق مِن بَليَّتي","يُثيبُكُمُ ذو العَرشِ خَيرُ مُثيبِ",2,"ب",1,0],["فَرُشّوا عَلى قَبري مِنَ الماءِ وَاِندُبوا","قَتيلَ كَعابٍ لا قَتيلَ حُروبِ",2,"ب",1,0],["فَرَشَفتُ الرُضابَ أَعذَبَ رَشفٍ","وَهَصرتُ القَضيبَ أَلطَفَ هَصرِ",3,"ر",1,0],["فَرَشَ الرَّبِيعُ لَكَ الطَّرِيقَ أَزَاهِراً","وَمَضَى يُبَشِّرُ بِالغَمَامِ غَمَامُ",4,"م",1,0],["فَرِش لي جَناحي وَاِتَّخِذنِيَ بازِياً","تَخَطَّفُ حَبّاتِ القُلوبِ أُجادِلُه",5,"ل",2,0],["فرشتُ لها خدِّي وقبَّلْتُ كفَّها","خضوعاً ولا تقبيلَ مستلمِ الرُّكْنِ",6,"ن",1,0],["فرشت فوق ثراك الطاهر الهدب","فيا دمشق... لماذا نبدأ العتبا؟",7,"ب",2,1],["فرشْتُ لك البسيطةَ منه جَمراً","يَضُرُّ بذي الحِذاءِ وأنتَ حافي",8,"ف",2,0],["فرشت له الأحلام واحتفل الهدو","ء يد ومد له الجمال وسادا",9,"د",2,0],["فَرَشاها عَلى الرِسالَةِ طوقاً","وَخِضاباً عَلامَةً غَيرَ بالي",10,"ل",2,0],["فَرَشَت كُلَّ مُنيفِ القَرى","فَوقَ مَتنَي كُلِّ خاظي الفِئام",11,"م",1,0],["فَرَشتُ لَها صَدري فَزَلَّ عَنِ الصَفا","بِهِ جُؤجُؤٌ عَبلٌ وَمَتنٌ مُخَصَّرُ",12,"ر",1,0],["فَرَشنا لَكُم مِنّا جَناحَ مَوَدَّةٍ","وَأَنتُم زَماناً تُلجِثونَ الدَواهِيا",13,"ي",2,0],["فَرَشَفتُ ثَغرَ المَوتِ فيهِ أَشنَبا","وَلَثَمْتُ خَدَّ المَشْرَفِيِّ أَسِيلا",14,"ل",2,0],["فرَشَتْ له أيدي الليوثِ خدودَها","ورَضينَ ما يأتي وكنّ غِضابا",15,"ب",2,0],["فَرِش مُعدِماً إِن كانَ يُمكِنُ رَيشُهُ","وَلا تَفخَرَن بَينَ الأَنامِ بِما رِشتا",16,"ت",2,0],["فرشت له صُمُّ الصفا أذيالها","وتفتحَّت ثَغَراتُها أحضانا",17,"ن",2,0],["فرشتُ فوقَ ثراكِ الطاهرِ الهدبا","فيا دمشقُ... لماذا نبدأ العتبا؟",18,"ب",2,1],["فرشنَ بِكافورِ السماء لك الربىَ","فشابهنَه لونا وخالفنَه قِشرا",19,"ر",2,0],["فرشتُ لجنبِ الحبّ صدرى وإنما","تهابُ الهوى نفسٌ تخاف من الردى",20,"د",2,0],["فرشت خدِّي لِمَمْشاها وقلتُ لها","أخشى عليك الطريقَ الوعرَ فانتعَلِي",21,"ل",2,0],["فرَشادِي في الهوى سَفَهٌ","وسَفاهِي في الهوى رَشدي",22,"د",2,0],["فَرَشَ الهَجرُ في بُيوتِ هُمومِ","تَحتَ رَأسي وَسادَةَ البَرحاءِ",23,"ا",2,0],["فَرَشَ البَحرُ لي بُيوتَ مَسوح","مُتَكاها مُطاوِعُ الحَصباءِ",23,"ا",2,0],["فرشت له فيه بسط الحدي","ث من باب بيتي إلى صفتي",24,"ت",2,0],["فرشت للربيع فينا مهاده","فاستنارت حزونه ووهاده",25,"د",2,1],["فرش جناحي ببذل المكرمات وصل","حبلي فاني الى نعماك غرثان",26,"ن",1,0],["فرش حسن ظني بالعَوارِق واكنى","وَقَضَّ لَباناتِي وَوَدَّع وَزَوَّدِ",27,"د",1,0],["فَرشّحهما للمعلواتِ محاضراً","وَأوطئهما أعقابَ فضلٍ تؤمّهُ",28,"م",2,0],["فرَشوا بديباجِ الخُدودِ طريقَه","حُبّاً له من قادمٍ مُستَقْبَل",29,"ل",1,0],["فرَشوا بديباجِ الخُدودِ طَريقَه","حُبّاً غدا لِمَصونِهنَّ مُذِيلا",30,"ل",2,0],["فَرشْتُ لها خَدّي لتَخْطو كرامةً","عليه فلم تَمْلِكْ من التِّيهِ أن تَخْطو",31,"ط",2,0],["فرشت له من قلبها وفؤادها","إستبرقاً ونمارقاً تَتَسوَّم",32,"م",1,0],["فرشتْ له قلباً كأنَّ حنانَه","ظِلٌّ على خير الأَنامِ مَدِيدُ",33,"د",1,0],["فرشفته بمسامعي وأجبته","بقياس فهمي لم أقل قد قيلا",34,"ل",2,0],["فرشَ الرَّبيعُ لنا خمائِلَ سُنْدُسٍ","خضرٍ تَفوحُ برنده وعراره",35,"ر",2,0],["فرشفت خمر رضابه","ممزوجة بشمول كاسه",36,"س",2,0],["فرشني كما أبريتني حيث رشتني","وأوسع لعذري من رضاك المسالكا",37,"ك",2,0],["فرشْتهمُ مُستهزمين كأنهمْ","طرائدُ صيد الجحفل المُتساوقِ",38,"ق",1,0],["فرشفنا سلاف ريقٍ على تر","جس عينين يجتني وردَ خدِّ",39,"د",1,0],["فَرَشتُ بِقيلٍ كادَ يَشفي مِنَ الهَوى","تَكادُ لَهُ أَكبادُنا أَن تَقَطَّعا",40,"ع",2,0],["فرشْنا خُدوداً في الثَّرى حُرمَةً لها","رُبوضاً على الأَعْتابِ في الحضرَةِ العُظْمى",41,"م",2,0],["فَرَشْتُ لَها بِيضَ القُصورِ مَطارِفاً","فلم تَرْضَ إلاّ أسودَ القَلبِ للسُكنى",42,"ن",2,0],["فَرِشني وَمَن راشَت يَداكَ جَناحَهُ","يَكُن آمِناً ما عاشَ في دَهرِهِ النَتفا",43,"ف",2,0],["فرشُوا الخدودَ طريقَه وكأَنَّما","زَفراتُهم لِقدومِه تَطْرِيق",44,"ق",1,0],["فَرَشَتهُ عَلى النَما","رِقِ سُعدى وَزَينَبُ",45,"ب",1,0],["فرشاقة وملاحة ولطافة","وعذوبة منها يسيل السكر",46,"ر",1,0],["فرشت له مزيج المس","ك والكافور والعربا",47,"ب",2,0],["فَرَشتُ لَها رَدايَ وَلَيسَ نَصفاً","لأنَّ النَّصفَ مِن شيَمي وَخيمي",48,"م",2,0],["فُرِشَ الفَضاءُ بِأَحمَرٍ وَبِأَصفَرِ","وَبَدَت لَنا حُلَلُ الرَبيعِ المُزهِرِ",49,"ر",1,1],["فرشْف ريقك أشهى","من الرحيق الشهي",50,"ي",1,0],["فَرَشَّت بِقَولٍ كادَ يُشفى مِنَ الجَوى","تَلُمُّ بِهِ أَكبادَنا أن تَصَدَّعا",51,"ع",2,0],["فَرَشْتُ لَهَا خَدّي وِطَاءً على الثرى","وَأغْنَيْتُهَا بِالدمع عَنْ وَاكِفِ السُّحْبِ",52,"ب",1,0],["فُرِشَت فَوقَها فَرائِدُ طَلٍّ","عَلِقَت بِالنَباتِ وَالأَشِجارِ",53,"ر",1,0],["فَرَشتُ لَهُ قَريحَ المِس","كِ وَالنِسرينَ وَالغَرَبا",54,"ب",2,0],["فَرَشَتْ حماةُ لوطءِ نعلِكَ خدَِّها","فَوطِئْتَ عينَ الشَّمسِ مِنْ مَفْروشِها",55,"ش",3,0],["فرشفت من شَفتيه أشنَب صَافياً","شَبِما نازعني سُلافاً قَرْقَفا",56,"ف",2,0],["فَرَشتَ الجِهادَ ظُهورَ الجِيادِ","بِأَبنائِهِ وَبِأَبنائِها",57,"ا",3,0],["فرشَ الأرضَ بهاراً بَهَرا","ودَنانيراً عليها نَثَرا",58,"ر",2,0],["فرشوا بساحة أرضه القمرين وات","كأوا على زهر النجوم قعودا",59,"د",2,0],["فَرش النيّرين كفّ الثريَّا","في سماطي نادي عُلاه وثيرا",60,"ر",2,0],["فرش وَعرش باذخ","مستمسك بيد البقا",61,"ق",2,0],["فرشت له ورد الخدود وأسبلت","عوض الحرير عليه آس عذار",62,"ر",1,0],["فرشنها سوسناً أيدي الربيع فان","فوفن بالورد وشاها بنوار",63,"ر",1,0],["فرش القاع لؤلؤاً وتهيا","يستحث البشرى فجاءت نعيا",64,"ي",2,0],["فَرَشَفْتُ خَمْرَةَ رِيقهِ","وقَطفْتُ وَرْدَةَ خَدِّهِ",65,"د",2,0],["فرشفتُ ثغراً ما برحتُ معربداً","بمدامةٍ أزري بكلِّ مُعَرْبِدِ",66,"د",1,0],["فَرشَتْ بالورود بُسطاً من الزه","رِ فلم نَعْبَأْ بهجةً بالكراسي",67,"س",2,0],["فَرشت أَحشاي لَها لَكنَّني","خَشيت أَن تَضجر مِن لَهيبها",68,"ب",3,0],["فرش جناحي وما قرأت فقل","قوالب السحر هكذا تفرغ",69,"غ",1,0],["فرشت لشيبي أجل البساط","فلم يستطب مجلساً غير راسي",70,"ي",1,1],["فَرَشفتُ مِن لُماهُ سَلسَلاً","وَحَلالي ذَلِكَ الرَشفُ وَلَذ",71,"ذ",1,0],["فرشت لنعله بصري وخدي","كأني قد بسطت له ازارا",72,"ر",2,0],["فرشني وثق نفسا بأنك واحدٌ","وأنّك قطب في الزمان زمانا",73,"ن",2,0],["فَرَشَ الناسُ ظِلَّهم واحْتَذَوْهُ","عندما قام للنّهارِ اسْتِواءُ",74,"ا",2,0],["فرَش الرَّبيعُ لنا خَمائِلَ سُنْدُسٍ","مِن حولها غُدْرانُهُنَّ فَراوِزُ",75,"ز",1,1],["فرشتُ لها خدي لترتع مثلما","على ورد خديها المحاسن ترتعُ",76,"ع",1,0],["فرشفتها رشفا لما قد أودعت","من نكتة وبديعة لم تنكر",77,"ر",1,0],["فرشفت الشهد من مبسمه","علني أطفىء به ذاك اللهيب",78,"ب",1,0],["فرشفتها فإذا هي","تزرى بما ولد العنب",79,"ب",1,0],["فرشفتُها وشفعتُها من ظَلمِها","بمدامةٍ عزّت عَلى الأَرواح",80,"ح",1,0],["فَرَشَفتُ مِن مَعسولِ ذَياكَ اللُمى","ضَرب الرِضابِ فَكانَ أَهنا مُجتَنى",81,"ن",2,0],["فرشنا له حب القلوب فلم يطأ","إذا ما مشى إلا الحرير المحبرا",82,"ر",2,0],["فرشفت منه الكاس ثغرا باسمه","وهصرت منه الغصن قدا أهيفا",83,"ف",2,0],["فرَّ شبابي مما بكيتُ وفي","الرأس مَشيبي شماتةً ضحكا",84,"ك",2,0],["فَرَشْفُ ريقتها ترياقُ علَّته","بذاك قال الطبيبُ الحاذقُ الآسِي",85,"س",2,0],["فَرِشني بِخَيرٍ طالَما قَد بَرَيتَني","وَخَيرُ المَوالي مضن يَريشُ وَلا يَبري",86,"ي",1,1],["فرشيدها من رأيه وأمينها","من فعله ومعزها تصميما",87,"م",2,0],["فرشوا فيها من الدر حصى","ضربوا فيها من المسك خياما",88,"م",2,0],["فرشوها لآلئاً ونُضارا","ثمّ قالوا هذي الطريقُ فسارا",89,"ر",2,1],["فرشت لك الترب التي باشرتها","بشفائها من كهلها أو طفلها",90,"ل",3,0],["فَرَشوا القلوبَ لضيفِهمْ","اِنْ جاءَهُمْ منها الشِّعابْ",91,"ب",1,0],["فرشت على المسك منه شذاها","فضاع ببهو الصبايا ذكيا",92,"ي",2,0],["فَرَشَ الحُسْنُ خدَّها وَتَمَلَّى","مُذْ رَأَى فيهِ سِدْرَةً تَتَدَلَّى",93,"ل",2,1],["فرشتُ بساطي للهوى وطويته","ولم أَر فيما قد طويتُ ودائِعا",94,"ع",2,0],["فرشَتُ سجَادّةَ الآمَالِ مُنتصِبًا","مُستدبِرًا كُلَّ يأسٍ ظَلَّ يُبكِيني",95,"ن",2,0],["فرشفت من ريق المليحة خمرةً","هي خمرة الأحبار في القداس",96,"س",1,0],["فرشةٌ ميتةٌ طارت بها عنقاً","فوق النسور وجدت في تعاليها",97,"ي",3,0],["فرشتُ ضوئي على جهلي فأخبرني","بعض الجهالةِ صار اليومَ (نورانا )",98,"ن",2,0],["فَرَّشَتْ وَرْدًا وُحُبَّا فِي الْمَدَى","لِبَنَاتِ الْفِكْرِ تَشْدُو وتُغَنِّيْ",99,"ن",2,0],["فرشتْ بساطَ دموعِها بمرارةٍ","أكلتْ ثمارَ حديقةٍ شربتْ دَما",100,"م",2,0],["فَرَشَاقَتِي يَخْتَالُ فِيِهَا فَارِسٌ","وَفِرَاسَتِي عَرَبِيَّةٌ تَتَجَوَّلُ",101,"ل",1,0],["فرش المسالك والممالك كلّها","بجنيّ ورد العدل والنسرين",102,"ن",1,1],["فَرَشَت لَهُ فَوقَ الأَدِيمِ بِسَاطَهَا","دَانَت لَهُ يَومَ اللِّقَا بِوَلَائِهَا",103,"ا",3,0],["فرشتها في الكرى عشبا أراودها","فولولت ْ واستحالت ديمةً وقرى",104,"ر",2,0],["فرشتُ له قلبي ورودا على عجلْ","واشعلتُ أحداقي شموعا ولم أزلْ",105,"ل",1,1],["فرَشَتْ لهُ بالوردِ دَغْلَ فِراشِه ِ","طمَعا ً بِشَهْدِ لذاذة ٍ فَتَمَنَّعا",106,"ع",2,0],["فَرَشَ الفؤادُ لها منازله","فهيَ المليكُ وأضلعي الجندُ",107,"د",1,0],["فَرَشَتْ لك الأحداقُ عُشْبَ حقولِها","أَمّا الفؤاد ف