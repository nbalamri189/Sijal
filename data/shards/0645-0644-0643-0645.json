y.dctabudhabi.ae/diwan/poem/72791","الرمل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139658",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139707",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139749",""],[4119,"لله عزمك أي سيف وغى","https://www.poetsgate.com/ViewPoem.aspx?id=16156",""],[5205,"ملك محاسنه جنوده","https://www.poetsgate.com/ViewPoem.aspx?id=121000",""],[5582,"صَدَحَ الحَمامُ عَلَى الفُنُونِ وَناحَا","https://www.poetsgate.com/ViewPoem.aspx?id=186829",""],[5582,"لا تُكْثِرا فِي اللَّوْمِ مِنْ تَفْنِيدِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63502",""],[402,"عاد عهد المدير في اعين الناس","https://www.poetsgate.com/ViewPoem.aspx?id=36831",""],[5956,"بعدالةٍ من أحمد الطعمينا","https://www.poetsgate.com/ViewPoem.aspx?id=194285",""],[6142,"ملك ميت بسكتةِ قلبٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155688",""]],"verses":[["مَلِكٌ مُقسِطٌ وَأَكمَلُ مَن يَم","شي وَمِن دونَ ما لَدَيهِ الثَناءُ",0,"ا",2,0],["مَلكٌ مَتى اِستَسقَيتَ بَحرَ يَمينِهِ","جادَت عَلَيكَ بِديمَةٍ لَم تُقلَعِ",1,"ع",1,0],["مَلَكٌ مَرَّ بِالْحَيَاةِ كَرِيماً","وَتَوَلَّى عَنْهَا تَوَلِّيَ غَانِمْ",2,"م",1,0],["ملكٌ من آل أيوبٍ له","في تكاليف العلى ميراث صبري",3,"ر",2,0],["ملك من ارقى الملوك عظيم","لاسمه في سمع الزمان دوى",4,"د",3,0],["مَلِكٌ مِنَ الأَخلاقِ كانَ بِناؤُهُ","مِن نَحتِ أَوَّلِكُم وَمِن صَوّانِهِ",5,"ن",2,0],["مَلِكٌ مُنشِدُ القَريضِ لَدَيهِ","واضِعُ الثَوبِ في يَدَي بَزّازِ",6,"ز",1,0],["مَلِكٌ ما تَغُبُّنا مِن نَداهُ","نَفَحاتٌ تَغدو عَلَينا وَتَسري",7,"ر",2,0],["مَلِكٌ ما بَدا لِعَينَيكَ إِلّا","قُلتُ بَحرٌ طَما وَبَدرٌ تَجَلّى",8,"ل",2,0],["ملكٌ ما انتضى المهنَّدَ إلا","خِيلَ بدراً يسطو بحدِّ شِهابِ",9,"ب",1,0],["مَلكٌ مَعانيهِ","لِلوَرى حَرَمُ كَوكَب",10,"ب",1,0],["مَلِكٌ مَفَاخِرُهُ تُعَدّ مفاخراً","لمآثرِ الآباءِ والأجدادِ",11,"د",1,0],["مَلِكٌ مَفاتيحُ الرَدى بِشِمالِهِ","وَيَمينُهُ إِقليدُ قُفلِ المُعسِرِ",12,"ر",1,0],["مُلكٌ مِنَ الجاهِ لَم يُرفَع لِذي خَطَرٍ","مِنَ المُلوكِ وَلَم يُجمَع لِخاقانِ",13,"ن",1,0],["مَلكٌ مِنَ المَلِكِ الهُما","مِ لِكَفِّهِ وُصِلَت بِساعِد",14,"د",1,0],["مَلِكٌ مِن مُلوكِ قَحطانَ تَجري","مِن يَدَيهِ لَنا العَطايا الرِغابُ",15,"ب",1,0],["ملكٌ منشد القريض لديه","يضع الثوب في يدي بزاز",16,"ز",1,0],["مُلْكُ مِصْرَ القَدِيمُ عَادَ جَدِيداً","مُسْتَنِبّاً جَلالُهُ وَالنِّظَامُ",17,"م",1,0],["مَلِكٌ مِنْ عَلٍ أَطَلَّ عَلَيْهِمْ","فَإِذَا كُلُّ غَمَّةِ تَتَبَدَّدْ",18,"د",1,0],["مَلِكٌ مَدَّ لِلْفُنُونِ يَمِيناً","عَلَّمَتْ كُلَّ مُحْسِنٍ إِحْسَانَهْ",19,"ن",2,0],["مُلْكٌ مِنَ النُّورِ قَدْ ضَاءَتْ دَعَائِمُهُ","كَأَنَّمَا شِيدَ مِنْ هَالاَت أَقْمَارِ",20,"ر",1,0],["ملك مقدسة هيولياته","من أن يضاف لفطرة أعظامها",21,"م",3,0],["ملكٌ مقسطٌ وأفضل من يم","شي ومن دون ما لديه الثناء",22,"ا",2,0],["مَلِكٌ ما بَدَا لعَيْنِكَ إلاّ","قُلتَ بَحرٌ طَمَا، وَبَدرٌ تَجَلّى",23,"ل",2,0],["مُلك مروانَ لكم وحدكم","قد جلا الإيمانُ كلَّ الشركاء",24,"ا",2,0],["مَلك مِن الإِيمان جَرد صارِماً","بِالحَق حَتّى الكُفر أَصبَحَ مُسلِما",25,"م",2,0],["مَلِكٌ مُقيمٌ في دِمَشقَ وَذِكرُهُ","في الخافِقينِ بَعيدَةٌ أَسفارُهُ",26,"ر",2,0],["ملك متى ما ترضهِ فهو الحيا","جوداً وإِن تسخطه فهو النارُ",27,"ر",1,0],["ملكُ ملا الدنيا علا ومتى رأى","أدنى السنا نادى العلى ملى بهِ",28,"ب",2,0],["ملك متى تدعو به لملمة","ملأ البلاد صفائحا ونصولا",29,"ل",2,0],["مَلْكٌ من الزنجِ قد وافى على شَرَفٍ","والرومُ قد أَضرمتْ نارا لتحرِقَهُ",30,"ه",1,0],["مَلكٌ معاليه غَدت جمَّةً","تَعُمُّ كلَّ الناسِ بِالرِفد",31,"د",1,0],["مَلِكٌ من بَنِي الوصيِّ عَزِيزٌ","نَبَويٌ الهُدَى كَرِيم الفِعَالِ",32,"ل",1,0],["ملِكٌ منذ قام لم يُلْفَ إلاّ","فوق طِرْفٍ أو مِنبْر أو سَريرِ",33,"ر",1,0],["مَلِكٌ مَناقِبُهُ تَجِل","لُ عَنِ النَظائِرِ وَالشُكولِ",34,"ل",1,0],["مَلِكٌ ما اِجتَدَيتُهُ قَطُّ إِلّا","رُحتُ مِن بابِهِ أُثيبُ وَأَجدي",35,"د",2,0],["مَلِكٌ مُدّ لَهُ النّصْرُ بِمَنْ","في السّمواتِ العُلَى مِنْ مَدَدِ",36,"د",1,0],["مَلِكٌ مُلكُهُ سَما بِوَزيرٍ","شَأنُهُ في الزَمانِ شَأنٌ عَظيمُ",37,"م",1,0],["مَلِكٌ ما اِهتَدَت إِلى عُشرِ مِعشا","رِ نَداهُ يَوماً عُقولُ الكِرامِ",38,"م",1,0],["مَلكٌ مِنَ الدَهرِ يُجيرُ ناسَهُ","وَلا يُجارُ مِنهُ غُلبُ الأسدِ",39,"د",1,0],["ملك منابرُهُ رؤوسُ عداتهِ","وَسيوفه من فوقها خطباءُ",40,"ا",2,0],["مُلكُ مَرجِعِ الأُمرِ إِلَيهِ","فَالحُروبُ وَالسِلمِ بَينَ يَدَيهِ",41,"ه",1,0],["مَلِكٌ مَديحي المُستجادُ مُطيعُه","أبداً ونائلُه الجزيلُ مُطيعي",42,"ع",2,0],["ملك ما كان بي من فاقة","بل من الصرّ تولى إذ تولّى",43,"ل",2,0],["ملك ما زال جود يديه","بالعطايا للبرايا يفيض",44,"ض",1,0],["ملك متى وأرمت وصفا له","قصّرت عنه في فصيح المقال",45,"ل",1,0],["ملكٌ متى أَرْمِ الحوادِثَ باسمهِ","تقتُلْ أَفاعِيها سُمُومُ عقارِبي",46,"ب",2,0],["ملك من آل أيوب له","كرم الفرع وطيب المحتد",47,"د",1,0],["ملِكٌ ملوكُ الأَرضِ تَروِي فضلَه","حُبّاً ومن أَفْعالِه تَسْتَملي",48,"ل",2,0],["مَلكٌ مُلُوك الأَرْضِ في أَسْرهِ","بالجودِ أَو بالصَّارِم الْبَاتر",49,"ر",1,0],["ملك ملوك الأرض في أمره","بالجود أو بالصارم البتر",49,"ر",1,0],["ملك محبته في صدرنا غُرست","وتلك اثمارها في العرب والعجم",50,"م",1,0],["مِلِكٌ مِنَ العَرنينش يَقصُرُ قَيصَرٌ","عَن شَأوِهِ وَيَقِلُّ شاهٌ شاهُ",51,"ا",2,0],["مَلِكٌ ما يَزالُ يَعتِدُلُ البي","ضُ عَلَى مَفرِقَيهِ والتّيجانُ",52,"ن",1,0],["ملك مضى وأتى سواه موفقاً","لبلاده فهُما له سيان",53,"ن",1,0],["ملكٌ ما هريقتِ المُزنُ إِلا","من ندى جودِ كفهِ المُهَراق",54,"ق",1,0],["ملك ممدوحُ فضلٍ","فعليه الدهرَ يُثنى",55,"ن",2,0],["ملك ملوك الشوس قاد زمامها","في أبيض عضب ولدن أسمر",56,"ر",1,0],["ملك مكارمه وسا","ئل مجتد منا وسائل",57,"ل",1,0],["ملك مرهوب يوم ال","بأس مرهوف العزيمِ",58,"م",1,0],["ملك مباح حمى المكارم حامل","ماشئت إلا الوتر والاحقادا",59,"د",2,0],["ملك مردى بالفخار معدل","رطب الغرار مردد الإحسان",60,"ن",1,0],["ملك من بني الأزدِ مفخره","في سماءِ المعالي سمَا وعلا",61,"ل",2,0],["ملكٌ مَتى تنسبهُ تلقى عرفهُ","مِن عرق قحطان يؤول وهودهِ",62,"د",2,0],["مَلِك ملائكةُ السماء جنوده","ومُلوك منْ فوق الثَّرى عُبْدانه",63,"ن",2,0],["مَلِكٍ مُهابٍ في المُلوكِ مُبَجَّلٍ","سَمْحٍ رحيمٍ بالضُّرِيكِ رَؤوفِ",64,"ف",1,0],["ملكٌ من سادةٍ فاقوا جميع العالمين","جده أكرم خلق الله خير المرسلين",65,"ن",1,0],["مَلكٌ مِن مَخافَةِ اللَهِ مغضٍ","وَهوَ مغضٍ لَهُ مِنَ الإِعظامِ",66,"م",1,0],["مَلِكٌ مِنهُ في الخِطابِ إِذا شاءَ","خَطيبٌ وَفي النِزالِ خُطوبُ",67,"ب",1,0],["ملكٌ محبَّته سلافة مزنةٍ","ملكت مع الأرواح في الأجساد",68,"د",1,0],["ملك متى قام للرحمن منتصراً","أمات بالروع قبل السيف من ظلما",69,"م",2,0],["مَلكٌ مالك عنان الأعادي","ليس يجري إلاَّ بما أجراها",70,"ا",3,0],["مَلِكٌ مِنْ مَلِكٍ مِنْ مَلِك","أنشَطَ المُلكَ بِه مِنْ عَقَلِ",71,"ل",1,0],["مَلِكٌ مُنى فلك السماء لو انّهن","بجلاله بدل الكواكب زُيِّنا",72,"ن",2,0],["مَلِكٌ مَراتِبُهُ أَجَلُّ مَراتِبٍ","وَنِصابُهُ في المَجدِ خَيرُ نِصابِ",73,"ب",1,0],["مَلِكٌ ما شافَ بِناظِرِهِ","إِلّا وَأَنافَ عَلى الأُفُقِ",74,"ق",1,0],["مَلِكٌ مِن بَني المُلوكِ وَقَيلٌ","رَهِبَتهُ في الخافِقينِ القُيولُ",75,"ل",1,0],["مَلِكٌ مِن بَني المُلوكِ نَدِيُّ ال","وَجهِ مُستَبشِرٌ نَدِيُّ البَنانِ",76,"ن",1,0],["ملكٌ من نداهُ في كل نادٍ","يسحبُ الإزْدَرا على سُحبانِ",77,"ن",1,0],["ملك ما حملت همته","ما يؤود الطود إلا نهضا",78,"ض",2,0],["ملك ما افترع الملك إلى","أن رآه اللَّه كفؤاً مُرْتَضَى",78,"ض",2,0],["ملك ملكه الممالك لا بل","هو قيومها الذي يرعاها",79,"ا",3,0],["ملك مهد البلاد برأي","هُوَ أَمضى مِن مُرهفات السُيوف",80,"ف",1,0],["ملك مذ كان بالسط","وةممنوع حماه",81,"ا",2,0],["ملك متى هبطَتْ عروقُ أرومةٍ","بمُمَلّكٍ بسقَتْ به العِرقانِ",82,"ن",1,0],["ملك مصر ازدهى بفخر مليك","ياله فيه من عزيز حميد",83,"د",1,1],["ملكَ ما تراه يوماً عبوساً","عند بذل الندى ولا قمطريرا",84,"ر",2,0],["ملكٌ ما انتشت غمائمُ حرب","عنهُ إلا انجلت بصرع الأُسود",85,"د",1,0],["ملكُ ما انثنى عن الطّرد إلا","بعدُوّ في إثره مصفود",85,"د",1,0],["ملكٌ ماجدٌ حليمٌ كريمٌ","جُودُهُ ناسخٌ لكلّ وُجود",85,"د",1,0],["مَلكٌ مَناطُ الشُّهبِ مِن دُونِ مَا","تطَا رِجلاَهُ كُلَّ البِطَاح",86,"ح",1,0],["ملِكٌ مَواقِعُ سيفِه أو سَيْبِهِ","تكْفي عدُوّاً أو تكُفُّ حَسودا",87,"د",2,0],["ملك مكارمه غيث ونجدته","غوث وايامه أمنٌ وإيمان",88,"ن",1,0],["مَلِك مُذْ جُرِّدَتْ هَيْبَتُهُ","أَغْمَدَ الأسْيافَ حَتَّى صَدِيَتْ",89,"ت",1,0],["ملك من ملكٍ من ملكٍ","من ملوك تُرعَد الأرضَ فَرقْ",90,"ق",1,0],["ملك متى طلعت طلائع رأيه","نكصت على أعقابها الآراء",91,"ا",2,0],["ملك متى أو ما بخاتمه تجد","أعصى العصاة لديه أطوع طيّع",92,"ع",1,0],["ملك متى يممته للبانة","ضربت بأودية النجاح خيامها",93,"م",3,0],["مَلكٌ مَجالسُ لهوه شدَّاتُه","ومشُوقُهُ بين الصُّفوف شذاتُهُ",94,"ت",2,0],["ملكٌ ما أَذَلَّ بِالفَتح أرضاً","قَطُّ إلّا أعزَّها إغلاقُهْ",95,"ق",2,1],["ملك مآثره سعودٌ كاسمه","العدل ملء إهابه والجود",96,"د",1,0],["ملك مواهبه العظام كأنها","شهب تسير بجنح ليل أدهم",97,"م",1,0],["ملك ما إن تجلى أو بدا","سجد الدهر على أرجله",98,"ه",1,0],["ملك ما إن تجلى وبدا","سجد الدهر على أقدامه",99,"ه",1,0],["ملك من بني النبي وجدنا","ما بآبائه به موجودا",100,"د",2,0],["ملك مساعيه عرجن إلى السما","حتى وطأن على السهى بمناسم",101,"م",1,0],["ملك ملائكة السماء له غدت","في الأرض بعض جنوده الأبطال",102,"ل",1,0],["ملك ملائكة السماء تود لو","كانوا لخدمته هم الوزراء",103,"ا",2,0],["ملك مِن بَني الضِياء وَجَنى","سَليل الظَلام مِن أَرض عَبقر",104,"ر",1,0],["ملك مِن جَناحه يَهب الوَر","د وَيَنشو النَعيم مِن أَعضائِهِ",105,"ا",3,0],["مَلكٌ مَدحُه يُرَتِّلهُ را","ويهِ حتَّى يَظنُّهُ تَنزيلا",106,"ل",2,0],["ملكٌ ما زال يولي","ني تقريباً وبرا",107,"ر",2,0],["ملكٌ ما اسطاعَ يخفي جودَه","وشذا راحتِهِ بالجودِ باحا",108,"ح",2,0],["ملكٌ ممالكه الفضائل والعلى","والمكرمات الغرُّ بعض جنوده",109,"د",2,0],["ملكٌ ملكه المعالي ولكن","هو مَع قومه بملك مشاع",110,"ع",1,0],["ملكٌ مُلِّكَ المعالي وفيها","لا الأيادي العظام عاد ضنينا",111,"ن",2,0],["ملك مهابته طليعته","أبدا أمام جيوشه تسري",112,"ر",2,0],["ملك محاسنه جنوده","وزهور حديه شهوده",113,"د",2,1],["مَلِكٌ مَتَى ما تأْتِهِ لَمْ تَلْقَهُ","إِلاَّ مَلِيكاً لِلنَّدَى مُرْتاحَا",114,"ح",2,0],["مَلِكٌ مَتَى تَنْسِبْهُ تَلْقَ عُرُوقَهُ","مِنْ عِرْقِ قَحْطانٍ يَؤُولُ وَهُودِهِ",115,"د",2,0],["ملك مصر القديم عاد جديدا","مستتبا جلاله والنظام",116,"م",1,0],["ملَكٌ من العلياءِ جاء يدلهم","سبُلَ العُلا ويزيدهم تمدينا",117,"ن",2,0],["ملك ميت بسكتةِ قلبٍ","حملت نعشه رقاب الجنود",118,"د",1,1]]}