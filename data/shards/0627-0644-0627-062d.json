يبِ إِنَّ طُروقَهُ","رَسولُ الرَدى قُدّامَهُ وَدَليلُهُ",0,"ه",1,1],["أُلاحِظُ خَلّاتِ الكِرامِ بِغُصَّةٍ","وَيَقصُرُ مالي عَن بُلوعِ الَّذي يُرضي",1,"ض",2,0],["أُلاحِظُ في جَوانِبِها رِجالاً","فَأَعرِفُ مَن أَرى غَيرَ النَظيرِ",2,"ر",1,0],["أَلا حَيِّها رَبَّ العُلى مِن غَوارِبِ","تَعَرَّقُني بَينَ العُلى وَالمَطالِبِ",3,"ب",1,1],["أَلا حَيِّ لُبنى اليَومَ إِن كُنتَ غادِياً","وَأَلمِم بِها مِن قَبلِ أَن لا تَلاقِيا",4,"ي",2,1],["ألا حدِّثَنْ عنّي الأحبّةَ أنّني","حطَطْتُ بحَيٍّ لا يَلينُ على قَسْرِ",5,"ر",1,0],["أَلاَ حَدِّثَاهَا فَهْيَ أُمُّ الْعَجَائِب","وَمَا حَاضِرٌ في وَصْفِهَا مِثْلُ غَائِبِ",6,"ب",1,1],["أَلا حَيِّ مَيّاً إِذ أَجَدَّ بُكورُها","وَعَرِّض بِقَولٍ هَل يُفادى أَسيرُها",7,"ر",3,1],["أَلا حَيِّيا لَيلى أَجَدَّ رَحيلي","وَآذَنَ أَصحابي غَداً بِقُفولِ",8,"ل",1,1],["أَلا حَبَّذَا تِلْكَ البُيُوتُ وَحَبَّذَا","نَباتٌ جمِيعٌ حَوْلَهَا وَمُقَسَّمُ",9,"م",1,0],["أَلا حَبَّذا أَهلُ المَلا غَيرَ أَنَّهُ","إِذا ذُكِرَت مَيٌّ فَلا حَبَّذا هِيا",10,"ي",2,1],["أَلا حَيّ بِالزُرقِ الرُسومَ الخَواليا","وَإِن لَم تَكُن إِلّا رَميما بَواليا",11,"ي",2,1],["أَلا حَيِّيا بِالزُرقِ دارَ مُقامِ","لِمَيٍّ وَإِن هاجَت رَجيعَ سَقامي",12,"م",2,1],["أَلا حَيِّ المَنازِلَ بِالسَلامِ","عَلى بُخلِ المَنازِلِ بِالكَلامِ",13,"م",1,1],["أَلا حَيِّ داراً قَد أَبانَ مُحيلُها","وَهاجَ الهَوى مِنها الغَداةَ طُلولُها",14,"ل",3,1],["أَلا حَيِّ أَطلالا كَحاشِيَةِ البُردِ","لِمَيَّةَ أَيهاتَ المُحَيّا مِنَ العَهدِ",15,"د",1,1],["ألَا حَيّ الدارِ قَفراً جُنوبُها","بِحَيثُ اِنحَنى مِن قِنعِ حَوضى كَثيبُها",16,"ب",3,1],["أَلا حَيِّ رَهبى ثُمَّ حَيِّ المَطالِيا","فَقَد كانَ مَأنوساً فَأَصبَحَ خالِيا",17,"ي",2,1],["أَلا حَيِّ رَبعَ المَنزِلِ المُتَقادِمِ","وَما حَلَّ مُذ حَلَّت بِهِ أُمُّ سالِمِ",18,"م",1,1],["أَلا حَيِّ المَنازِلَ بِالجِنابِ","فَقَد ذَكَّرنَ عَهدَكَ بِالشَبابِ",19,"ب",1,1],["أَلا حَيِّ لَيلى إِذ أَجَدَّ اجتِنابُها","وَهَرَّكَ مِن بَعدِ اِئتِلافٍ كِلابُها",20,"ب",3,1],["أَلا حَيِّ الدِيارَ بِسَعدَ إِنّي","أُحِبُّ لِحُبِّ فاطِمَةَ الدِيارا",21,"ر",2,1],["أَلا حَيِّ أَطلالَ الرُسومِ الدَوارِسِ","وَآرِيَّ أَمهارٍ وَمَوقِدَ قابِسِ",22,"س",1,1],["أَلا حَبَّ بِالوادي الَّذي رُبَّما نَرى","بِهِ مِن جَميعِ الحَيِّ مَرأىً وَمَسمَعا",23,"ع",2,0],["أَلا حَيِّيا الأَعرافَ مِن مَنبِتِ الغَضا","وَحَيثُ حَبا حَولَ الصَريفِ الأَجارِعُ",24,"ع",1,0],["أَلا حَيِّ أَهلَ الجَوفِ قَبلَ العَوائِقِ","وَمِن قَبلِ رَوعاتِ الحَبيبِ المُفارِقِ",25,"ق",1,1],["أَلا حَيِّ دارَ الهاجِرِيَّةِ بِالزُرقِ","وَأَحبِب بِها داراً عَلى البُعدِ وَالسُحقِ",26,"ق",1,1],["أَلا حَيِّ الدِيارَ وَإِن تَعَفَّت","وَقَد ذَكَّرنَ عَهدَكَ بِالخَميلِ",27,"ل",1,1],["أَلا حَبَّذا أَيّامَ يَحتَلُّ أَهلُنا","بِذاتِ الغَضا وَالحَيُّ في الدارِ آهِلُ",28,"ل",1,0],["أَلا حَيِّ المَنازِلَ وَالخِياما","وَسَكناً طالَ فيها ما أَقاما",29,"م",2,1],["أَلا حَيِّ بِالبُردَينِ داراً وَلا أَرى","كَدارٍ بِقَوٍّ لا تُحَيّا رُسومُها",30,"م",3,1],["الا حييت عنا يا مدينا","وهل بأس بقول مسلَّمينا",31,"ن",2,1],["ألا حبَّذا منه العبور لبدئِه","أطالَ على الشعرى العبور قبابها",32,"ب",3,0],["إلا حَمَامُ الأَيك في أيكِهِ","أو عازفٌ للشَّرب أو قاصبُ",33,"ب",1,0],["ألا حاولتَ أن تُدعى غُلاماً","بحلقِ العارضين إذا التحيتا",34,"ت",2,0],["ألا حبذا الأعمال في كل حالةٍ","إذا كان منها وجهُ نفعٍ مُيَسَّر",35,"ر",1,0],["ألاحَ بُروق البشرِ تدعُو عُفاتَهُ","فجاءوا فأعفى بالرغابِ الوشائك",36,"ك",1,0],["الأحسنَين ظِهارةً وبِطانةً","والأطْيبين مَشارباً ومَطاعما",37,"م",2,0],["أَلا حَيِّيا داراً لِأُمِّ هِشامِ","وَكَيفَ تُنادى دِمنَةٌ بِسَلامِ",38,"م",1,1],["أَلا حَبَّذا يا صاحِبي المَوتُ هَهُنا","إِذا لَم يَكُن مِن تَذَوُّقِ الرَدى بُدُّ",39,"د",1,0],["أَلا حَبَّذا الأَجنادُ غَوثاً لِخائِفٍ","وَيا حَبَّذا الأَحرارُ وَرداً لِمُستَقِ",40,"ق",1,0],["أَلا حَبَّذا مِن سالِفِ العَيشِ ما مَضى","وَيا حَبَّذا لَو كانَ يَرجِعُ ثانِيا",41,"ي",2,0],["ألا حيّ أَوطاني بِشِلبٍ أَبا بَكرٍ","وَسَلهُنّ هَل عَهدُ الوِصال كَما أَدري",42,"ر",2,1],["أَلا حَنَّةٌ لابن مَحنيَّة","شَديد الحَنين ضَعيف الأَنينِ",43,"ن",1,0],["أَلا حَبَّذا في المَجدِ اِتلافُ طارِفي","وَبَذليَ عِندَ الحَمدِ نَفسي وَماليا",44,"ي",2,0],["إِلّا حَلَلتَ عَنِ السَجينِ وَثاقَهُ","إِنَّ الوِثاقَ عَلى الأُسودِ ثَقيلُ",45,"ل",1,0],["أَلا حَبَّذا صُحبَةَ المَكتَبِ","وَأَحبِب بِأَيّامِهِ أَحبِبِ",46,"ب",1,1],["الأَحمَرانِ عَنِ الدَمِ ال","غالي وَحُرمَتِهِ كِنايَه",47,"ا",3,0],["أَلا حَبَّذا قَومٌ نَداماهُمُ القَنا","يُسَقّونَها رَيّاً وَساقيهِمُ العَزمُ",48,"م",1,0],["ألاحَهُمُ الهمُّ المخامِرُ والسُّرى","ووَخْدُ المهارى وارتكابُ المجاشمِ",49,"م",1,0],["ألا حبّذا شَدُّ الركائبِ ضَحْوةً","وللظِلِّ في أخفافهِنَّ مَقِيلُ",50,"ل",1,0],["ألا حبَّذَا ظِلٌّ بنَعمانَ سَجْسَجٌ","يُزاحِفُه عَذْبُ المذاقةِ أُثعوبُ",51,"ب",1,0],["أُلاحِظُها فَتَعلَمُ ما أُريدُ","وَتَلحَظُني فَيَرمُقُها الحَسودُ",52,"د",1,1],["الأَحسَنونَ مِنَ النُجومِ وُجوهُهُم","بَهَروا بِأَكرَمِ عُنصُرٍ وَنُحاسِ",53,"س",1,0],["أَلا حَبَّذا البَيتُ الَّذي أَنتَ هايِبُه","تَزورُ بُيوتاً حَولَهُ وَتُجانِبُه",54,"ب",2,1],["أَلا حَيِّ إِذ أَهلي وَأَهلُكَ جيرَةٌ","مَحَلّاً بِذاتِ الرَمثِ قَد كانَ يَدرُسُ",55,"س",1,1],["الأَحلَمونَ فَما خَفَّت حُلومُهُمُ","وَالأَثقَلونَ عَلى الأَعداءِ ميزانا",56,"ن",2,0],["ألا حَيِّ مَفقودَ الشَّمائلِ ماثلا","غَدَا هَاجِرَ الدنيا وإن كان واصِلا",57,"ل",2,1],["ألا حَبَّذا المَرْجُ العَليلُ نسيمُه","إذا نَبَّهتَنْي للصَّبُوحِ النَّواقِسُ",58,"س",1,0],["ألاحظُها لَحْظَ الطّريدِ مَحلَّه","وأذكُرُها ذِكْرَ البَغيِّ شبابَها",59,"ب",3,0],["أَلا حُقَّ لِلعاني بِما هُوَ صائِرٌ","إِلَيهِ وَشيكاً أَن يَبيتَ مُؤَرِّقا",60,"ق",2,0],["أَلا حبَّذا العيدُ الَّذي عكفت به","على كفّك الأمواهُ تُمْطُرها قُبلا",61,"ل",2,0],["أَلا حَبّذا تِلكَ الدِّيارُ أواهلاً","ويا حبّذا منها رُسومٌ وأَطلالُ",62,"ل",1,0],["أُلاحِظُ حُسنَ وَجنَتِهِ","فَتَجرَحُني وَأَجرَحُها",63,"ه",2,0],["أَلا حَيِّ بِالْمِقْيَاسِ رَيَّا الْمَعَالِمِ","وَقَلَّ لَهَا مِنَّا تَحِيَّةُ قَادِمِ",64,"م",1,1],["أَلا حَيِّ الَّتي قامَت","عَلى خَوفٍ تُحَيِّينا",65,"ن",2,1],["أَلا حَبَّذا حَبَّذا حَبَّذا","حَبيبٌ تَحَمَّلتُ مِنهُ الأَذى",66,"ذ",2,1],["أَلا حَبَّذا عيدٌ تَلاقَت بِهِ المُنى","فَجَدَّدَ مِن عَهدِ الشَبابِ مَشيبُ",67,"ب",1,1],["أَلا حَبَذا يَومَ يَقَرُّ بِهِ الصَبا","لَنا وَعَشِيّاتٌ تَجَلَّت غُيومُها",68,"م",3,1],["أَلا حُجِبَت لَيلى وَآلى أَميرُها","عَلَيَّ يَميناً جاهِداً لا أَزورُها",69,"ر",3,1],["أَلا حَبَّذا نَجدٌ وَطيبُ تُرابِهِ","وَأَرواحُهُ إِن كانَ نَجدٌ عَلى العَهدِ",70,"د",1,0],["أَلا حَزمٌ مِنَ المَكروهِ واقٍ","فَإِنَّ الحَزمَ داعِيَةُ الوِقايَهْ",71,"ا",3,0],["أَلا حُرمةٌ وافى بِها الدّينُ تُتَّقى","أَلا رَحِمٌ أَوصى بِها اللَهُ تُرحَمُ",72,"م",1,0],["إِلّا حَديثاً رَسلاً يُضَلِّلُ بِال","عِزهاتِ وَالمُستَنيعُ فيهِ دَدُه",73,"د",2,0],["أَلا حَبَّذا هِندٌ وَأَرضٌ بِها هِندُ","وَهِندٌ أَتى مِن دونِها النَأيُ وَالبُعدُ",74,"د",1,0],["أَلا حَبَّذا الناعي وَأَهلاً وَمَرحَباً","كَأَنَّكَ قَد بَشَّرتَني بِغُلامِ",75,"م",1,1],["أَلا حَيِّ مِن أَهلِ المَحَبَّةِ مَنزِلا","تَبَدَّلَ مِن أَيّامِهِ ما تَبَدَّلا",76,"ل",2,1],["أَلا حَيِّ أَطلالاً بِسَيحانَ فَالعَذبِ","إِلى بُرَعٍ فَالبِئرِ بِئرِ أَبي زُغبِ",77,"ب",1,1],["أَلا حَيِّ الحَبيبَةَ بِالسَلامِ","وَإِن هِيَ لَم تُطِق رَجعَ الكَلامِ",78,"م",1,0],["أَلا حَبَّذا عَيشُ الرَجاءِ وَرَجعَةٌ","إِلى دُفِّ مِقلاقِ الوَضينِ سَعومِ",79,"م",1,0],["ألا حيّ المنازلَ بالعقيق","تحيةَ عاشقٍ صبّ شفيقِ",80,"ق",1,1],["إِلّا حَديثاً كَالخَمرِ لَذَّتُهُ","تَكونُ سُكراً في الروحِ وَالجَسَدِ",81,"د",1,0],["إِلّا حَديثاً مُعَجِباً أُنسُهُ","أَكبَرتُهُ غُنماً وَأَرباحا",82,"ح",2,0],["أَلا حَيِّ ذا البَيتَ الَّذي لَستُ ناظِراً","إِلى أَهلِهِ إِلّا بَكَيتُ إِلى صَحبي",83,"ب",2,1],["أَلاحَ فَلَم يَعُج بِغَرارِ نَومٍ","لِبَيضاتٍ وَضِعنَ عَلى غِرارِ",84,"ر",1,0],["ألاحَ وقد رأى بَرْقاً مُلِيحاً","سَرَى فأتَى الحِمى نِضْواً طَليحا",85,"ح",2,1],["أَلا حَيِّيَا لَيلى وَقُولا لَها هَلا","فَقَد رَكِبَت أَمراً أَغَرَّ محجَّلا",86,"ل",2,1],["ألا حبذا الأرضُ مغدىً لنا","وإن بشَّرَتها المنايا بنَا",87,"ن",2,0],["أَلا حَيِّ رَبعاً بِاللَوى ذَكَرَ العَهدا","مَحَتهُ الصَبا جَرَّ اليَمانِيَّةِ البُردا",88,"د",2,1],["أَلا حَبَّذا نَجدٌ وَطيبُ تُرابِها","وَأَرواحُها إِن كانَ نَجدٌ عَلى العَهدِ",89,"د",1,1],["أَلا حَبَّذا البيضُ الأَوانِسُ كَالدُمى","وَإِن كُنَّ يُسكِرنَ الفَتى أَيَّما سُكرِ",90,"ر",1,0],["أَلا حَبَّذا أَطلالُ لَيلى عَلى البِلى","وَما بَذَلَت لي مِن نَوالٍ وَإِن قَلّا",91,"ل",2,0],["أَلا حَيِّ مِنْ أَسْمَاءَ رَسْمَ الْمَنَازِلِ","وَإِنْ هِيَ لَمْ تَرْجِعْ بَيَانَاً لِسَائِلِ",92,"ل",1,1],["أَلاَ حُبَّتِ الزِّينَاتُ إِنْ كُسِيَتْ بِهَا","مَعَانٍ كَمَا تَهْوَى النُّفُوسُ مِلاَحُ",93,"ح",1,0],["أَلاحَ بِهِ الرُعافُ وَكانَ فيهِ","مَخايِلُ جَدِّهِ البَطَلِ الجَوادِ",94,"د",1,0],["ألا حُلُّوا عن الوادي","قتلتم أهلَه خَنْقًا",95,"ق",2,0],["ألا حبذا نفحات نجد","ورَيَّا رَوْضِهِ غِبَّ القِطَارِ",96,"ر",1,0],["ألاحظها فتعلم ما أريد","وتلحظني فيرمقها لحسود",97,"د",1,1],["ألا حَيِّ إذ أهلي وأهلك جِيرَةٌ،","مَحلاًّ بذاتِ الرِّمثِ قد كادَ يدرُسُ",98,"س",1,1],["إِلاَّ حَدِيثاً رَسْلاً يُضَلِّلُ بالْ","عزهاة ِ، والمستنيعُ فيهِ ددُهْ",99,"د",2,0],["ألا حبذا نجدٌ،","ومن أسكنها أرضا",100,"ض",2,1],["ألا حبذا أطلال ليلى على البلا","وما بذلت لي من نوال وإن قلا",101,"ل",2,0],["ألا حجبت ليلى وآلى أميرها","علي يميناً جاهلاً لا أزورها",102,"ر",3,1],["الا حبذا عهد الكئيب وناعم","من الروض عطري النسيم شممناه",103,"ا",2,0],["ألاحمدي الخالدي المرتجى","لدفاع صائلة الزمان العادي",104,"د",2,0],["ألا حييا دورَ الحبيب واحيينا","زمان التصابي والصِّبا المتقضيا",105,"ي",2,1],["أَلا حَبَّذا سَفري وَإِن قيلَ إِنَّني","كَلَفتُ بِنَصرانِيَّةٍ تَشرَبُ الخَمرا",106,"ر",2,1],["ألا حيّ لي من ليلة القبر إنه","مآب وإن أكرهتُه أناآيبه",107,"ب",2,1],["ألا حفظ الله المصيخ لسمعه","إذا ما أتاه وعده أو وعيده",108,"د",2,0],["أَلا حَبَّذا مِنْ حُبِّ عفراءَ مُلْتقى","نَعَمْ وألا لا حيث يَلْتَقِيانِ",109,"ن",1,0],["ألا حَبَّذا الماءُ الذِى قابَلَ النَّقا","ويا حَبّذا مِن أَجلِ ظَمياءَ حاضِرُه",110,"ر",2,1],["أَلا حَبَّ بِالبَيتِ الّذِى أَنتَ هاجِرُهُ","وَأَنتَ بِتَلماحٍ مِن الطَّرفِ زائِرُه",111,"ر",2,1],["أَلاَ حَيِّيا الأطلالَ بالجَرعِ العُفرِ","سَقاهُنَّ رِيّاً صَوبُ ذِى نَضَدٍ غَمرِ",112,"ر",1,1],["إلا حديثاً مثلَ ما سَرتِ الصَّبا","سَحَرا تُنبِّه زاهِرا رَياّنا",113,"ن",2,0],["الأحنف بن محمّد يشكو الضوى","وتفاوتا في خطوه وبيانه",114,"ن",2,1],["إلا حديث بني القري","ظة من مسنّ أو غلام",115,"م",1,0],["أَلا حبّذا بينَ النخيلِ نزولُ","وظلٌّ بأكنافِ العقيق ظليلُ",116,"ل",1,1],["ألاحتِ الشمسُ تغرِي العاذلينَ بنا","كليلةُ الطرفِ أم راحتْ تحيينا",117,"ن",2,0],["ألاحظ ما أعانيه فتجرى","ينابيع المدامع في شئوني",118,"ن",2,0],["أَلا حرَّروا هذا الوَرى من عُبودَةٍ","هيَ الذِئبُ كم غالَ الوَرى بِالمَخالِبِ",119,"ب",1,0],["أَلا حرقٌ بِحُبِّكَ في فُؤادي","أَبَيتُ بِحَرِّها قَلِقَ الوِسادِ",120,"د",1,1],["أَلا حَيِّ لَيلى إِذ أَلَمَّ لِمامُها","وَكانَ مَعَ القَومِ الأَعادي كَلامُها",121,"م",3,1],["أَلا حَبَّذا بِالبانِ مَغنىً وَمَلعَبٌ","عَصَيتُ بِهِ عَصرَ البَطالَةِ عُذّالي",122,"ل",2,0],["أَلا حَبَّذا وادي الأَراكِ وَقَد وَشَت","بِرَيّاكَ ريحاً شَمأَلٍ وَقُبولِ",123,"ل",1,0],["ألا حبّذا بردٌ يَفوحُ عبيرُه","ويا حبّذا حسنٌ يدلّ على الهُدى",124,"د",2,0],["ألا حبّذا نومي على جَوهَرِ الحَصى","لأغفي على الألحانِ من طَيركَ الشادي",125,"د",2,0],["أَلا حَبَّذا فُلْكٌ مَواخرُ زَاحَمَتْ","غَوارِبَ طامٍ لا يُنَهْنَهُ طامِح",126,"ح",1,0],["أَلا حَبَّذا عَهْدُ الْكَثِيبِ وَناعِمٌ","مِنَ الْعَيْشِ مَجْرُورُ الذُّيُولِ لَبِسْناهُ",127,"ا",2,0],["أَلاّ حَبَّذا دَهْرٌ إِلَيْكَ أَصارَنِي","وَخَطْبٌ إِلى جَدْوى يَدَيكَ دَعانِي",128,"ن",2,0],["أَلا حَبَّذا عَيشٌ هَنيءٌ قَطَعتُهُ","بِظِلِّكُما يا أَيُّها الجَبَلانِ",129,"ن",1,0],["أَلاحَ أَن لاحَ بُرَيقٌ يَمان","يَخفِقُ وَهناً كَجَنانِ الحَنان",130,"ن",1,1],["أَلا حَبَّذا أَنفاسُ ظاهِرِ جلَّق","وَقَد نَفَحَت غِبَّ الحَيا المُتَدَفِّقِ",131,"ق",1,1],["أَلاحَ لَمّا لاحَ مِن حاجِرِ","سَنا البَريقِ المُنجِدِ الغائِرِ",132,"ر",1,1],["ألا حبذا يا ليلُ من فيك قبلةً","تقوم مقام الخمر للكبد الظامي",133,"م",2,1],["إلّا حسينٌ عَينُ أَع","يان العُلى صَدر الصُدورِ",134,"ر",1,0],["ألا حَيّا الحَيا زَمَنَ التَصابي","فَكَم بِالأُنس كانَ أَخا اِتِّصالِ",135,"ل",1,0],["أَلا حَدِّثا مَولاي ذا المَنزل الرَحبِ","بِأَنّي وَأَعوان الزَمان عَلى حَربِ",136,"ب",1,1],["أُلاحِظُ أحوالَ الأنامِ بمُقْلةٍ","تَغُضُّ جُفونَ العارِفِ المُتَجاهل",137,"ل",1,0],["أَلا حَبَّذا عَصرُ اللِوى وَزَمانُهُ","إِذِ الدَهرُ سَلمٌ وَالجَميعُ حُلولُ",138,"ل",1,1],["أَلا حَيِّيا الدارَ المُحيلَ رُسومُها","تَهيجُ عَلَينا ما يَهيجُ قَديمُها",139,"م",3,1],["ألا حيّ سلمى في الخليط المُفارق","وألمم بها أن جدَّ بين الحزائِق",140,"ق",1,1],["ألا حُرُّ إذا ما انحَصَّ ريشي","أرَجِّيه لتَثميرِ الرِّياشِ",141,"ش",1,0],["أُلاحِظُ منه البدر في غسق الدُّجى","يَميسُ به قدٌّ من البان ميَّال",142,"ل",1,0],["إلا حكى لحن الربيع وسحره","أو كان عن سحر الربيع مترجما",143,"م",2,0],["إلا حبذا عصر تقضى بروضة","وحادث عهد مر فيه وقادمه",144,"م",2,0],["ألا حيّي بكاسك واستنيري","شهاب النصر من وجه البشيرِ",145,"ر",1,1],["ألاحَ فجِلبابُ الظّلامِ ممزّقٌ","كما مزّق النّقْعَ المُثارَ الصّفائح",146,"ح",1,0],["أَلا حَبَّذا نَوْرُ الْبَنَفْسَجِ إِذْ بَدا","كآثارِ قَرْصٍ في جُسُومٍ نَواعِمِ",147,"م",1,1],["أَلاحَ وميضُ البرقِ عندَ ابتسامه","ولاحَ سفورُ الصبحِ تحتَ لثامِه",148,"ه",1,1],["أَلاَّ حبَّذا شجراء جِلَّق عُرِّيَتْ","من الحَلْي أوْ لم تَعْرَ فهيَ على السَوَا",149,"و",2,1],["ألا حبَّذا مسعى تميم بن خنْدفٍ","وما شادهُ صيفيُّها ومُجاشعُ",150,"ع",1,1],["أَلا حَبَّذا عَيناكِ يا أُمَّ شَنبَلٍ","إِذا الكُحلُ في جَفنَيهِما جالَ جائِلُه",151,"ل",2,0],["أَلا حَيِّيا الأَطلالَ وَالمُتَطَنَّبا","وَمَربِطَ أَفلاءٍ وَخَيماً مُنَصَّبا",152,"ب",2,1],["أَلا حَبَّذا سَلمى الفؤادِ وَحَبَّذا","زيارَتُها لَو يُستَطاعُ التَزاوُرُ",153,"ر",1,0],["ألا حيَّ آثارَ الرسومِ الدوائرِ","سَقَتْها شآبيبُ الغيوثِ البواكرِ",154,"ر",1,1],["ألاحظه في كل شيء رأيته","وأدعوه سرا بالمنى فيجيب",155,"ب",1,1],["ألا حَبّذا عصْراً مضى ولَيالياً","عرائسُ أُنسٍ يبتَسِمْنَ عن البِشْرِ",156,"ر",1,0],["إلا حبذا دست الخلافة كلما","غدا باسماً عن ثغره عاضد الطهر",157,"ر",1,0],["ألا حبذا في البان منك وفي النقا","وذائب شهد من ثناياك يقطر",158,"ر",1,0],["ألا حبذا فيكم مشقة شقة","يظل سواء هجركم وهجيرها",159,"ر",3,0],["ألا حبذا في العمر يوم وليلة","يهب لنا بالقرب منك نسيم",160,"م",1,0],["ألا حيّ قَبلَ البين أم حَبيب","وَإن لَم تَكُن منا غَداً بِقَريب",161,"ب",1,1],["ألا حركا لي أبرويز بن هرمزٍ","وقولا له قُم تَلقَ أعجوبةً قمِ",162,"م",1,1],["أَلا حَبَّذا وَجْهٌ تُرِينا بَياضَهُ","ومُنْسَدِلاتٍ كالمَثانِي واحِما",163,"م",2,0],["ألا حبّذا زمنُ الحاجرِ","وإِذ أنَا في الورق النّاضرِ",164,"ر",1,1],["ألا حيِّ يا صاحي على سكرةٍ بها","ودع عنك من هُمْ دونَها عندهم وهم",165,"م",1,0],["ألا حَبَّذا مِن أرضِ نجدٍ نُسَيمةٌ","وجُرعةُ ماءٍ من شُبيَثِ الجآذِرِ",166,"ر",1,0],["الأحول الأثعل المشؤوم طائره","أبو حذيفة شر الناس في الدين",167,"ن",1,1]]}