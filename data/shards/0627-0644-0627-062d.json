ظلم","https://www.aldiwan.net/poem43423.html","الطويل"],[39,"طال في رسم مهدد أبده","https://www.aldiwan.net/poem53781.html","المنسرح"],[22,"ألا طرقتنا بعدما هجدوا هند","https://www.aldiwan.net/poem21643.html","الطويل"],[52,"ألا حبذا الناعي وأهلا ومرحبا","https://www.aldiwan.net/poem26691.html","الطويل"],[52,"ألا حي من أهل المحبة منزلا","https://www.aldiwan.net/poem26719.html","الطويل"],[48,"ألا حي أطلالا بسيحان فالعذب","https://www.aldiwan.net/poem62430.html","الطويل"],[48,"ألا خذها كمصباح الظلام","https://www.aldiwan.net/poem65116.html","الوافر"],[48,"لمن دمن تزداد حسن رسوم","https://www.aldiwan.net/poem65257.html","الطويل"],[48,"ألا حي المنازل بالعقيق","https://www.aldiwan.net/poem66579.html","الوافر"],[50,"أذكرت نفسي عشية الأحد","https://www.aldiwan.net/poem63909.html","المنسرح"],[50,"أنى دعاه الشوق فارتاحا","https://www.aldiwan.net/poem63965.html","السريع"],[50,"ألا حي ذا البيت الذي لست ناظرا","https://www.aldiwan.net/poem64858.html","الطويل"],[46,"وجدت الناس كالأرضين شتى","https://www.aldiwan.net/poem22693.html","الوافر"],[46,"ألاح وقد رأى برقا مليحا","https://www.aldiwan.net/poem23637.html","الوافر"],[8,"ألا حييا ليلى وقولا لها هلا","https://www.aldiwan.net/poem21818.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/1673","الطويل"],[33,"","https://poetry.dctabudhabi.ae/diwan/poem/10763","الطويل"],[33,"","https://poetry.dctabudhabi.ae/diwan/poem/10815","الطويل"],[33,"","https://poetry.dctabudhabi.ae/diwan/poem/10900","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42733","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54688","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43696","الوافر"],[106,"سُحقًا لها","https://www.poetsgate.com/ViewPoem.aspx?id=179644",""],[33,"أقول لصاحبي والعيس تهوي بنا","https://www.poetsgate.com/ViewPoem.aspx?id=2664",""],[45,"ألاحظها فتعلم ما أريد","https://www.poetsgate.com/ViewPoem.aspx?id=31322",""],[28,"ألا حي إذ أهلي وأهلك جيرة","https://www.poetsgate.com/ViewPoem.aspx?id=17001",""],[39,"طَالَ في رَسْمِ مَهْدَدٍ رَبَدُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=4253",""],[31,"ألا حبذا نجدٌ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18930&r=&rc=193",""],[33,"يَجِيشونَ في لَيْلَى عَلَيَّ ولم أنَلْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14142&r=&rc=76",""],[33,"ألا حجبت ليلى وآلى أميرها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14169&r=&rc=103",""]],"verses":[["أَلا حَيِّ ضَيفَ الشَيبِ إِنَّ طُروقَهُ","رَسولُ الرَدى قُدّامَهُ وَدَليلُهُ",0,"ه",1,1],["أُلاحِظُ خَلّاتِ الكِرامِ بِغُصَّةٍ","وَيَقصُرُ مالي عَن بُلوعِ الَّذي يُرضي",1,"ي",1,0],["أُلاحِظُ في جَوانِبِها رِجالاً","فَأَعرِفُ مَن أَرى غَيرَ النَظيرِ",2,"ر",1,0],["أَلا حَيِّها رَبَّ العُلى مِن غَوارِبِ","تَعَرَّقُني بَينَ العُلى وَالمَطالِبِ",3,"ب",1,1],["أَلا حَيِّ لُبنى اليَومَ إِن كُنتَ غادِياً","وَأَلمِم بِها مِن قَبلِ أَن لا تَلاقِيا",4,"ي",2,1],["ألا حدِّثَنْ عنّي الأحبّةَ أنّني","حطَطْتُ بحَيٍّ لا يَلينُ على قَسْرِ",5,"ر",1,0],["أَلاَ حَدِّثَاهَا فَهْيَ أُمُّ الْعَجَائِب","وَمَا حَاضِرٌ في وَصْفِهَا مِثْلُ غَائِبِ",6,"ب",1,1],["أَلا حَيِّ مَيّاً إِذ أَجَدَّ بُكورُها","وَعَرِّض بِقَولٍ هَل يُفادى أَسيرُها",7,"ر",3,1],["أَلا حَيِّيا لَيلى أَجَدَّ رَحيلي","وَآذَنَ أَصحابي غَداً بِقُفولِ",8,"ل",1,1],["أَلا حَبَّذَا تِلْكَ البُيُوتُ وَحَبَّذَا","نَباتٌ جمِيعٌ حَوْلَهَا وَمُقَسَّمُ",9,"م",1,0],["أَلا حَبَّذا أَهلُ المَلا غَيرَ أَنَّهُ","إِذا ذُكِرَت مَيٌّ فَلا حَبَّذا هِيا",10,"ي",2,1],["أَلا حَيّ بِالزُرقِ الرُسومَ الخَواليا","وَإِن لَم تَكُن إِلّا رَميما بَواليا",11,"ي",2,1],["أَلا حَيِّيا بِالزُرقِ دارَ مُقامِ","لِمَيٍّ وَإِن هاجَت رَجيعَ سَقامي",12,"م",2,1],["أَلا حَيِّ المَنازِلَ بِالسَلامِ","عَلى بُخلِ المَنازِلِ بِالكَلامِ",13,"م",1,1],["أَلا حَيِّ داراً قَد أَبانَ مُحيلُها","وَهاجَ الهَوى مِنها الغَداةَ طُلولُها",14,"ل",3,1],["أَلا حَيِّ أَطلالا كَحاشِيَةِ البُردِ","لِمَيَّةَ أَيهاتَ المُحَيّا مِنَ العَهدِ",15,"د",1,1],["ألَا حَيّ الدارِ قَفراً جُنوبُها","بِحَيثُ اِنحَنى مِن قِنعِ حَوضى كَثيبُها",16,"ب",3,1],["أَلا حَيِّ رَهبى ثُمَّ حَيِّ المَطالِيا","فَقَد كانَ مَأنوساً فَأَصبَحَ خالِيا",17,"ي",2,1],["أَلا حَيِّ رَبعَ المَنزِلِ المُتَقادِمِ","وَما حَلَّ مُذ حَلَّت بِهِ أُمُّ سالِمِ",18,"م",1,1],["أَلا حَيِّ المَنازِلَ بِالجِنابِ","فَقَد ذَكَّرنَ عَهدَكَ بِالشَبابِ",19,"ب",1,1],["أَلا حَيِّ لَيلى إِذ أَجَدَّ اجتِنابُها","وَهَرَّكَ مِن بَعدِ اِئتِلافٍ كِلابُها",20,"ب",3,1],["أَلا حَيِّ الدِيارَ بِسَعدَ إِنّي","أُحِبُّ لِحُبِّ فاطِمَةَ الدِيارا",21,"ر",2,1],["أَلا حَيِّ أَطلالَ الرُسومِ الدَوارِسِ","وَآرِيَّ أَمهارٍ وَمَوقِدَ قابِسِ",22,"س",1,1],["أَلا حَبَّ بِالوادي الَّذي رُبَّما نَرى","بِهِ مِن جَميعِ الحَيِّ مَرأىً وَمَسمَعا",23,"ع",2,0],["أَلا حَيِّيا الأَعرافَ مِن مَنبِتِ الغَضا","وَحَيثُ حَبا حَولَ الصَريفِ الأَجارِعُ",24,"ع",1,0],["أَلا حَيِّ أَهلَ الجَوفِ قَبلَ العَوائِقِ","وَمِن قَبلِ رَوعاتِ الحَبيبِ المُفارِقِ",25,"ق",1,1],["أَلا حَيِّ دارَ الهاجِرِيَّةِ بِالزُرقِ","وَأَحبِب بِها داراً عَلى البُعدِ وَالسُحقِ",26,"ق",1,1],["أَلا حَيِّ الدِيارَ وَإِن تَعَفَّت","وَقَد ذَكَّرنَ عَهدَكَ بِالخَميلِ",27,"ل",1,1],["أَلا حَبَّذا أَيّامَ يَحتَلُّ أَهلُنا","بِذاتِ الغَضا وَالحَيُّ في الدارِ آهِلُ",28,"ل",1,0],["أَلا حَيِّ المَنازِلَ وَالخِياما","وَسَكناً طالَ فيها ما أَقاما",29,"م",2,1],["أَلا حَيِّ بِالبُردَينِ داراً وَلا أَرى","كَدارٍ بِقَوٍّ لا تُحَيّا رُسومُها",30,"م",3,1],["الا حييت عنا يا مدينا","وهل بأس بقول مسلَّمينا",31,"ن",2,1],["ألا حبَّذا منه العبور لبدئِه","أطالَ على الشعرى العبور قبابها",32,"ب",3,0],["إلا حَمَامُ الأَيك في أيكِهِ","أو عازفٌ للشَّرب أو قاصبُ",33,"ب",1,0],["ألا حاولتَ أن تُدعى غُلاماً","بحلقِ العارضين إذا التحيتا",34,"ت",2,0],["ألا حبذا الأعمال في كل حالةٍ","إذا كان منها وجهُ نفعٍ مُيَسَّر",35,"ر",1,0],["ألاحَ بُروق البشرِ تدعُو عُفاتَهُ","فجاءوا فأعفى بالرغابِ الوشائك",36,"ك",1,0],["الأحسنَين ظِهارةً وبِطانةً","والأطْيبين مَشارباً ومَطاعما",37,"م",2,0],["أَلا حَيِّيا داراً لِأُمِّ هِشامِ","وَكَيفَ تُنادى دِمنَةٌ بِسَلامِ",38,"م",1,1],["أَلا حَبَّذا يا صاحِبي المَوتُ هَهُنا","إِذا لَم يَكُن مِن تَذَوُّقِ الرَدى بُدُّ",39,"د",1,0],["أَلا حَبَّذا الأَجنادُ غَوثاً لِخائِفٍ","وَيا حَبَّذا الأَحرارُ وَرداً لِمُستَقِ",40,"ق",1,0],["أَلا حَبَّذا مِن سالِفِ العَيشِ ما مَضى","وَيا حَبَّذا لَو كانَ يَرجِعُ ثانِيا",41,"ي",2,0],["ألا حيّ أَوطاني بِشِلبٍ أَبا بَكرٍ","وَسَلهُنّ هَل عَهدُ الوِصال كَما أَدري",42,"ر",2,1],["أَلا حَنَّةٌ لابن مَحنيَّة","شَديد الحَنين ضَعيف الأَنينِ",43,"ن",1,0],["أَلا حَبَّذا في المَجدِ اِتلافُ طارِفي","وَبَذليَ عِندَ الحَمدِ نَفسي وَماليا",44,"ي",2,0],["إِلّا حَلَلتَ عَنِ السَجينِ وَثاقَهُ","إِنَّ الوِثاقَ عَلى الأُسودِ ثَقيلُ",45,"ل",1,0],["أَلا حَبَّذا صُحبَةَ المَكتَبِ","وَأَحبِب بِأَيّامِهِ أَحبِبِ",46,"ب",1,1],["الأَحمَرانِ عَنِ الدَمِ ال","غالي وَحُرمَتِهِ كِنايَه",47,"ا",3,0],["أَلا حَبَّذا قَومٌ نَداماهُمُ القَنا","يُسَقّونَها رَيّاً وَساقيهِمُ العَزمُ",48,"م",1,0],["ألاحَهُمُ الهمُّ المخامِرُ والسُّرى","ووَخْدُ المهارى وارتكابُ المجاشمِ",49,"م",1,0],["ألا حبّذا شَدُّ الركائبِ ضَحْوةً","وللظِلِّ في أخفافهِنَّ مَقِيلُ",50,"ل",1,0],["ألا حبَّذَا ظِلٌّ بنَعمانَ سَجْسَجٌ","يُزاحِفُه عَذْبُ المذاقةِ أُثعوبُ",51,"ب",1,0],["أُلاحِظُها فَتَعلَمُ ما أُريدُ","وَتَلحَظُني فَيَرمُقُها الحَسودُ",52,"د",1,1],["الأَحسَنونَ مِنَ النُجومِ وُجوهُهُم","بَهَروا بِأَكرَمِ عُنصُرٍ وَنُحاسِ",53,"س",1,0],["أَلا حَبَّذا البَيتُ الَّذي أَنتَ هايِبُه","تَزورُ بُيوتاً حَولَهُ وَتُجانِبُه",54,"ب",2,1],["أَلا حَيِّ إِذ أَهلي وَأَهلُكَ جيرَةٌ","مَحَلّاً بِذاتِ الرَمثِ قَد كانَ يَدرُسُ",55,"س",1,1],["الأَحلَمونَ فَما خَفَّت حُلومُهُمُ","وَالأَثقَلونَ عَلى الأَعداءِ ميزانا",56,"ن",2,0],["ألا حَيِّ مَفقودَ الشَّمائلِ ماثلا","غَدَا هَاجِرَ الدنيا وإن كان واصِلا",57,"ل",2,1],["ألا حَبَّذا المَرْجُ العَليلُ نسيمُه","إذا نَبَّهتَنْي للصَّبُوحِ النَّواقِسُ",58,"س",1,0],["ألاحظُها لَحْظَ الطّريدِ مَحلَّه","وأذكُرُها ذِكْرَ البَغيِّ شبابَها",59,"ب",3,0],["أَلا حُقَّ لِلعاني بِما هُوَ صائِرٌ","إِلَيهِ وَشيكاً أَن يَبيتَ مُؤَرِّقا",60,"ق",2,0],["أَلا حبَّذا العيدُ الَّذي عكفت به","على كفّك الأمواهُ تُمْطُرها قُبلا",61,"ل",2,0],["أَلا حَبّذا تِلكَ الدِّيارُ أواهلاً","ويا حبّذا منها رُسومٌ وأَطلالُ",62,"ل",1,0],["أُلاحِظُ حُسنَ وَجنَتِهِ","فَتَجرَحُني وَأَجرَحُها",63,"ه",2,0],["أَلا حَيِّ بِالْمِقْيَاسِ رَيَّا الْمَعَالِمِ","وَقَلَّ لَهَا مِنَّا تَحِيَّةُ قَادِمِ",64,"م",1,1],["أَلا حَيِّ الَّتي قامَت","عَلى خَوفٍ تُحَيِّينا",65,"ن",2,1],["أَلا حَبَّذا حَبَّذا حَبَّذا","حَبيبٌ تَحَمَّلتُ مِنهُ الأَذى",66,"ذ",2,1],["أَلا حَبَّذا عيدٌ تَلاقَت بِهِ المُنى","فَجَدَّدَ مِن عَهدِ الشَبابِ مَشيبُ",67,"ب",1,1],["أَلا حَبَذا يَومَ يَقَرُّ بِهِ الصَبا","لَنا وَعَشِيّاتٌ تَجَلَّت غُيومُها",68,"م",3,1],["أَلا حُجِبَت لَيلى وَآلى أَميرُها","عَلَيَّ يَميناً جاهِداً لا أَزورُها",69,"ر",3,1],["أَلا حَبَّذا نَجدٌ وَطيبُ تُرابِهِ","وَأَرواحُهُ إِن كانَ نَجدٌ عَلى العَهدِ",70,"د",1,0],["أَلا حَزمٌ مِنَ المَكروهِ واقٍ","فَإِنَّ الحَزمَ داعِيَةُ الوِقايَهْ",71,"ا",3,0],["أَلا حُرمةٌ وافى بِها الدّينُ تُتَّقى","أَلا رَحِمٌ أَوصى بِها اللَهُ تُرحَمُ",72,"م",1,0],["إِلّا حَديثاً رَسلاً يُضَلِّلُ بِال","عِزهاتِ وَالمُستَنيعُ فيهِ دَدُه",73,"د",2,0],["أَلا حَبَّذا هِندٌ وَأَرضٌ بِها هِندُ","وَهِندٌ أَتى مِن دونِها النَأيُ وَالبُعدُ",74,"د",1,0],["أَلا حَبَّذا الناعي وَأَهلاً وَمَرحَباً","كَأَنَّكَ قَد بَشَّرتَني بِغُلامِ",75,"م",1,1],["أَلا حَيِّ مِن أَهلِ المَحَبَّةِ مَنزِلا","تَبَدَّلَ مِن أَيّامِهِ ما تَبَدَّلا",76,"ل",2,1],["أَلا حَيِّ أَطلالاً بِسَيحانَ فَالعَذبِ","إِلى بُرَعٍ فَالبِئرِ بِئرِ أَبي زُغبِ",77,"ب",1,1],["أَلا حَيِّ الحَبيبَةَ بِالسَلامِ","وَإِن هِيَ لَم تُطِق رَجعَ الكَلامِ",78,"م",1,0],["أَلا حَبَّذا عَيشُ الرَجاءِ وَرَجعَةٌ","إِلى دُفِّ مِقلاقِ الوَضينِ سَعومِ",79,"م",1,0],["ألا حيّ المنازلَ بالعقيق","تحيةَ عاشقٍ صبّ شفيقِ",80,"ق",1,1],["إِلّا حَديثاً كَالخَمرِ لَذَّتُهُ","تَكونُ سُكراً في الروحِ وَالجَسَدِ",81,"د",1,0],["إِلّا حَديثاً مُعَجِباً أُنسُهُ","أَكبَرتُهُ غُنماً وَأَرباحا",82,"ح",2,0],["أَلا حَيِّ ذا البَيتَ الَّذي لَستُ ناظِراً","إِلى أَهلِهِ إِلّا بَكَيتُ إِلى صَحبي",83,"ي",1,1],["أَلاحَ فَلَم يَعُج بِغَرارِ نَومٍ","لِبَيضاتٍ وَضِعنَ عَلى غِرارِ",84,"ر",1,0],["ألاحَ وقد رأى بَرْقاً مُلِيحاً","سَرَى فأتَى الحِمى نِضْواً طَليحا",85,"ح",2,1],["أَلا حَيِّيَا لَيلى وَقُولا لَها هَلا","فَقَد رَكِبَت أَمراً أَغَرَّ محجَّلا",86,"ل",2,1],["ألا حبذا الأرضُ مغدىً لنا","وإن بشَّرَتها المنايا بنَا",87,"ن",2,0],["أَلا حَيِّ رَبعاً بِاللَوى ذَكَرَ العَهدا","مَحَتهُ الصَبا جَرَّ اليَمانِيَّةِ البُردا",88,"د",2,1],["أَلا حَبَّذا نَجدٌ وَطيبُ تُرابِها","وَأَرواحُها إِن كانَ نَجدٌ عَلى العَهدِ",89,"د",1,1],["أَلا حَبَّذا البيضُ الأَوانِسُ كَالدُمى","وَإِن كُنَّ يُسكِرنَ الفَتى أَيَّما سُكرِ",90,"ر",1,0],["أَلا حَبَّذا أَطلالُ لَيلى عَلى البِلى","وَما بَذَلَت لي مِن نَوالٍ وَإِن قَلّا",91,"ل",2,0],["أَلا حَيِّ مِنْ أَسْمَاءَ رَسْمَ الْمَنَازِلِ","وَإِنْ هِيَ لَمْ تَرْجِعْ بَيَانَاً لِسَائِلِ",92,"ل",1,1],["أَلاَ حُبَّتِ الزِّينَاتُ إِنْ كُسِيَتْ بِهَا","مَعَانٍ كَمَا تَهْوَى النُّفُوسُ مِلاَحُ",93,"ح",1,0],["أَلاحَ بِهِ الرُعافُ وَكانَ فيهِ","مَخايِلُ جَدِّهِ البَطَلِ الجَوادِ",94,"د",1,0],["ألا حُلُّوا عن الوادي","قتلتم أهلَه خَنْقًا",95,"ق",2,0],["ألا حبذا نفحات نجد","ورَيَّا رَوْضِهِ غِبَّ القِطَارِ",96,"ر",1,0],["ألاحظها فتعلم ما أريد","وتلحظني فيرمقها لحسود",97,"د",1,1],["ألا حَيِّ إذ أهلي وأهلك جِيرَةٌ،","مَحلاًّ بذاتِ الرِّمثِ قد كادَ يدرُسُ",98,"س",1,1],["إِلاَّ حَدِيثاً رَسْلاً يُضَلِّلُ بالْ","عزهاة ِ، والمستنيعُ فيهِ ددُهْ",99,"د",2,0],["ألا حبذا نجدٌ،","ومن أسكنها أرضا",100,"ض",2,1],["ألا حبذا أطلال ليلى على البلا","وما بذلت لي من نوال وإن قلا",101,"ل",2,0],["ألا حجبت ليلى وآلى أميرها","علي يميناً جاهلاً لا أزورها",102,"ر",3,1]]}