{"poems":[[53,"قرت عيون المجد والفخر","https://www.aldiwan.net/poem30478.html","السريع"],[53,"طلوع هداه إلينا المغيب","https://www.aldiwan.net/poem30758.html","المتقارب"],[9,"ما تعيف اليوم في الطير الروح","https://www.aldiwan.net/poem21921.html","الرمل"],[93,"ترى تعرف الشمس من ذا تشبه","https://www.aldiwan.net/poem11385.html","المتقارب"],[30,"أحادرة دموعك دار مي","https://www.aldiwan.net/poem29531.html","الوافر"],[88,"رويدك غورو أيهذا الجنيرال","https://www.aldiwan.net/poem44823.html","الطويل"],[72,"وقطايف رقت جسوما مثل ما","https://www.aldiwan.net/poem18270.html","الكامل"],[72,"عذيري من ساجي اللواحظ أغيد","https://www.aldiwan.net/poem18545.html","الطويل"],[51,"قرأت على أهلي كتابك إذا أتى","https://www.aldiwan.net/poem62922.html","الطويل"],[85,"ويوم من صبا آذار حلو","https://www.aldiwan.net/poem7044.html","الوافر"],[85,"فداها نساء الأرض من جركسية","https://www.aldiwan.net/poem7895.html","الطويل"],[43,"الحب ما منع الكلام الألسنا","https://www.aldiwan.net/poem10585.html","الكامل"],[62,"يا طالبا لنهايات العلوم ولم","https://www.aldiwan.net/poem52183.html","البسيط"],[45,"أمواهب هاتيك أم أنواء","https://www.aldiwan.net/poem10197.html","الكامل"],[45,"سهر أصابك بعد طول نعاس","https://www.aldiwan.net/poem64605.html","الكامل"],[45,"سقاني القهوة السلسل","https://www.aldiwan.net/poem65570.html","المنسرح"],[45,"أغدا يشت المجد وهو جميع","https://www.aldiwan.net/poem64713.html","الكامل"],[61,"غدا تبدي مدامعنا الخفايا","https://www.aldiwan.net/poem51397.html","الوافر"],[61,"قد أظلتك يا أبا إسحاق","https://www.aldiwan.net/poem51509.html","الخفيف"],[61,"بكرت عليك مغيرة الأعراب","https://www.aldiwan.net/poem51793.html","الكامل"],[61,"أحوال مجدك في العلو سواء","https://www.aldiwan.net/poem51833.html","الكامل"],[66,"سعة العذر لي وضيق الحجاب","https://www.aldiwan.net/poem38784.html","الخفيف"],[80,"فعوضت شيبا من شبابي كأنني","https://www.aldiwan.net/poem31211.html","الطويل"],[80,"أخذت سفاقس منك عهد أمان","https://www.aldiwan.net/poem31263.html","الكامل"],[80,"تقول وقد لاحت لها في مفارقي","https://www.aldiwan.net/poem31523.html","الطويل"],[69,"أحل الضيوف على سطحه","https://www.aldiwan.net/poem28822.html","المتقارب"],[31,"ألا ليت حظي منك أني كلما","https://www.aldiwan.net/poem42549.html","الطويل"],[52,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[46,"سمعت نعيها صما صمام","https://www.aldiwan.net/poem23631.html","الكامل"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85418","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39648","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54745","الخفيف"],[90,"الفرات الطاغي","https://www.poetsgate.com/ViewPoem.aspx?id=179148",""],[90,"المحرقة","https://www.poetsgate.com/ViewPoem.aspx?id=179110",""],[99,"إلى بيروت الأنثى مع الإعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=215333",""],[32,"وآخر عهدي بها","https://www.poetsgate.com/ViewPoem.aspx?id=114",""],[31,"ألا ليتَ حظي منكِ أنيَ كلما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18854&r=&rc=117",""]],"verses":[["وَقَطَّروا الخَيلَ بِفُرسانِها","خارِجَةً عَن حَلقَةِ الخُضرِ",0,"ر",1,0],["وَقَطعِكَ كُلَّ بَعيدِ النِياطِ","كَأَنَّ الجَوادَ بِهِ مُستَريبُ",1,"ب",1,0],["وَقَطَعتُ ناظِرَيهِ ظاهِراً","لا يَكونُ مِثلَ لَطمٍ وَكَمَح",2,"ح",1,0],["وَقُطْبٌ عَلَيْهِ تَدُورُ النُّهَى","كَمَا تَابَعَتْ شَمْسَهَا الأَنْجُمُ",3,"م",1,0],["وَقَطعُ مَفازَةٍ وَرُكوبُ أُخرى","تَكِلُّ بِها الضُبارِمَةُ الرَّسومُ",4,"م",1,0],["وقطبت الأيام حتى تشابهت","بها غُدُواتٌ كالحاتٌ وآصال",5,"ل",1,0],["وقطايف رقت جسوماً مثل ما","غلظت قلوباً فهي لي أحساب",6,"ب",1,1],["وقطَّعت أسباب الحوادثِ بعدما","علقتَ بحبل من حبال محمد",7,"د",1,0],["وقطرةَ غيثٍ كنتَ أنبأتَ أنها","سيتبعُها قطرٌ مُلثٌّ على قطر",8,"ر",1,0],["وقطَّعن الثلوج لكل روض","وكل خميلة منها ثيابا",9,"ب",2,0],["وقطعة خد بينما هي جنة","لعينيك يا رائي إذا هي نار",10,"ر",1,0],["وَقَطَعتُ في الدُنيا الفَلا وَرَكائِبي","فيها وَوَقتَيَّ الضُحى وَالمَوهِنا",11,"ن",2,0],["وقطعك الماء عنه طول مدته","قبل الحصاد فساد فاسقِ في قَدَرِ",12,"ر",1,0],["وَقَطَعتَني بِالجودِ حَتّى إِنَّني","مُتَخَوِّفٌ أَلّا يَكونَ لِقاءُ",13,"ا",2,0],["وَقَطَعتُ أَطوالَ البِلادِ وَعَرضَها","ما بَينَ سِندانٍ وَبَينَ سِجاسِ",14,"س",1,0],["وَقَطعُ التِكَّةِ الرَأيُ","إِذا التَكَّةُ لَم تُحلَل",15,"ل",1,0],["وَقَطيعَةِ الحَسَنِ بنِ سَهلٍ إِنَّها","تَغدو وَوَصلي دونَها مَقطوعُ",16,"ع",1,0],["وقَطَّعَ أنفُسَ الحُسَّادِ غَيظاً","بسُؤدُدِه فَطيَّرَها شَظايا",17,"ا",3,0],["وقطَعْتَ الشَّبابَ فيه إلى أن","هَمَّ بُرْدُ الشَّبابِ بالإخلاقِ",18,"ق",1,0],["وقطعتُ فيه شبيبةً لم تَشتغلْ","عن حُسْنِه بِصَباً ولا بتصابي",19,"ب",2,0],["وقطعتَها والليلُ يصدعُ قلبَه","ضدانِ نارٌ تستنيرُ وماءُ",20,"ا",2,0],["وَقُطوبُ الخُطوبِ أَهوَنُ عِندي","مَوقِعاً مِن تَقَطُّبِ الحُجّابِ",21,"ب",1,0],["وقَطْعي بعيشٍ بعد ستّين حجّةً","أرى فيه لَبْساً والتخوّف في اللبسِ",22,"س",1,0],["وقطوفُ اللهوِ من قاطفها","دانياتٌ ببنيّاتِ الدّنان",23,"ن",1,0],["وقَطعِيَ غَولَ القَفرِ في مَتنِ سابِحٍ","وخوضيَ هَوْلَ البَحرِ في بَطنِ سابِحه",24,"ح",2,0],["وقطَّعَ بالجوعِ أكبادَهم","وإنْ يستغيثوا يغاثوا بما",25,"م",2,0],["وَقَطَّعتِ قَلبي بِالمَواعِدِ وَالمُنى","وَغُصتِ عَلى قَلبي فَأَوثَقتِهِ أَسرا",26,"ر",2,0],["وَقَطَّعَ المَجلِسَ في اِكتِئابِ","وَذِكرِ حَرقِ النارِ لِلثِيابِ",27,"ب",1,0],["وقَطْرٌ كالبِحارِ فلسْتُ أرْضَى","بقَطْرٍ صابَ مِن خَلَلِ الغَمامِ",28,"م",1,0],["وقطَّع الكُرومَ منها والشجرْ","ولم يُبايع عِلجُها ولا ظهَرْ",29,"ر",1,0],["وَقَطيع الأغنام من وجهة الشر","قِ إلى جانب الخيام يؤوب",30,"ب",1,0],["وقطفنا من زهرها وانثنيْنا","فجنيْنا تُفاحَها بيدينا",31,"ن",2,0],["وَقَطِينِ الْبُيُوتِ مِنْ وَبَرٍ أَوْ","مَدَرٍ فِي النُّجُوعِ أَوْ فِي النُّجُودِ",32,"د",1,0],["وقطَّبت بعد تهليل أسرَّتُه","وبان فوق خُطاه الضعفُ والخَوَر",33,"ر",1,0],["وَقَطَّعتُ كفَّيْ من يمدُّ يمينَهُ","يَصافحني في حين تَطعنُني اليسرى",34,"ر",2,0],["وِقَطَفتمُ مِن رَوَابِيهِ الخُزَامَى","وَالعُيُونَ الخُضرَ وِ الخَدَّ الأَسِيلاَ",35,"ل",2,0],["وقطّعني فيك الصديق ملامة","وإني لأعصي نهيهم حين أُزْجَر",36,"ر",1,0],["وَقَطَّعْتِ قَلْبي بِکلْمَوَاعِيدِ والمُنَى","وغصتِ على قلبي، فأوثقتهِ أسرا",37,"ر",2,0]]}