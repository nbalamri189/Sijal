{"poems":[[53,"قرت عيون المجد والفخر","https://www.aldiwan.net/poem30478.html","السريع"],[53,"طلوع هداه إلينا المغيب","https://www.aldiwan.net/poem30758.html","المتقارب"],[9,"ما تعيف اليوم في الطير الروح","https://www.aldiwan.net/poem21921.html","الرمل"],[93,"ترى تعرف الشمس من ذا تشبه","https://www.aldiwan.net/poem11385.html","المتقارب"],[30,"أحادرة دموعك دار مي","https://www.aldiwan.net/poem29531.html","الوافر"],[88,"رويدك غورو أيهذا الجنيرال","https://www.aldiwan.net/poem44823.html","الطويل"],[72,"وقطايف رقت جسوما مثل ما","https://www.aldiwan.net/poem18270.html","الكامل"],[72,"عذيري من ساجي اللواحظ أغيد","https://www.aldiwan.net/poem18545.html","الطويل"],[51,"قرأت على أهلي كتابك إذا أتى","https://www.aldiwan.net/poem62922.html","الطويل"],[85,"ويوم من صبا آذار حلو","https://www.aldiwan.net/poem7044.html","الوافر"],[85,"فداها نساء الأرض من جركسية","https://www.aldiwan.net/poem7895.html","الطويل"],[43,"الحب ما منع الكلام الألسنا","https://www.aldiwan.net/poem10585.html","الكامل"],[62,"يا طالبا لنهايات العلوم ولم","https://www.aldiwan.net/poem52183.html","البسيط"],[45,"أمواهب هاتيك أم أنواء","https://www.aldiwan.net/poem10197.html","الكامل"],[45,"سهر أصابك بعد طول نعاس","https://www.aldiwan.net/poem64605.html","الكامل"],[45,"سقاني القهوة السلسل","https://www.aldiwan.net/poem65570.html","المنسرح"],[45,"أغدا يشت المجد وهو جميع","https://www.aldiwan.net/poem64713.html","الكامل"],[61,"غدا تبدي مدامعنا الخفايا","https://www.aldiwan.net/poem51397.html","الوافر"],[61,"قد أظلتك يا أبا إسحاق","https://www.aldiwan.net/poem51509.html","الخفيف"],[61,"بكرت عليك مغيرة الأعراب","https://www.aldiwan.net/poem51793.html","الكامل"],[61,"أحوال مجدك في العلو سواء","https://www.aldiwan.net/poem51833.html","الكامل"],[66,"سعة العذر لي وضيق الحجاب","https://www.aldiwan.net/poem38784.html","الخفيف"],[80,"فعوضت شيبا من شبابي كأنني","https://www.aldiwan.net/poem31211.html","الطويل"],[80,"أخذت سفاقس منك عهد أمان","https://www.aldiwan.net/poem31263.html","الكامل"],[80,"تقول وقد لاحت لها في مفارقي","https://www.aldiwan.net/poem31523.html","الطويل"],[69,"أحل الضيوف على سطحه","https://www.aldiwan.net/poem28822.html","المتقارب"],[31,"ألا ليت حظي منك أني كلما","https://www.aldiwan.net/poem42549.html","الطويل"],[52,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[46,"سمعت نعيها صما صمام","https://www.aldiwan.net/poem23631.html","الكامل"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85418","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39648","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54745","الخفيف"],[90,"الفرات الطاغي","https://www.poetsgate.com/ViewPoem.aspx?id=179148",""],[90,"المحرقة","https://www.poetsgate.com/ViewPoem.aspx?id=179110",""],[99,"إلى بيروت الأنثى مع الإعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=215333",""],[32,"وآخر عهدي بها","https://www.poetsgate.com/ViewPoem.aspx?id=114",""],[31,"ألا ليتَ حظي منكِ أنيَ كلما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18854&r=&rc=117",""],[113,"يا رفقتي كأسي حلا","https://www.aldiwan.net/poem40422.html","عموديه"],[116,"ما بالرزايا وما بالنأي من باس","https://www.aldiwan.net/poem492.html",""],[130,"تخطى ركبه الظلل القواء","https://www.aldiwan.net/poem54900.html","الوافر"],[133,"سواي بهذه الدنيا يبالي","https://www.aldiwan.net/poem48852.html","الوافر"],[133,"وقطب الجو وجها كله عقد","https://www.aldiwan.net/poem48941.html","البسيط"],[141,"ما في المعالي مطمع لسواكا","https://www.aldiwan.net/poem11788.html","الكامل"],[158,"إليك فقد حملت قلبي من الهوي","https://www.aldiwan.net/poem59013.html","الطويل"],[163,"نأت سلمى وأمست في عدو","https://www.aldiwan.net/poem719.html",""],[183,"تولى شباب واقتراب فأمعنا","https://www.aldiwan.net/poem14733.html","الطويل"],[184,"مشي الثقيل إذا مشى","https://www.aldiwan.net/poem43689.html","مجزوء الكامل"],[184,"فرضت علي يا مولاي حجا","https://www.aldiwan.net/poem43847.html","الوافر"],[184,"سكنت إلى حسن التوكل والصم","https://www.aldiwan.net/poem43867.html","الطويل"],[197,"يا من لنضو طريح","https://www.aldiwan.net/poem45153.html","المجتث"],[197,"على الطرسين من خد وجيد","https://www.aldiwan.net/poem45223.html","الوافر"],[227,"يا كانيا عن دمعه","https://www.aldiwan.net/poem50932.html","مجزوء الكامل"],[233,"أتظنني ما عشت أنعم بالا","https://www.aldiwan.net/poem31787.html","الكامل"],[233,"أتجزع للفراق وهم جوار","https://www.aldiwan.net/poem31988.html","الوافر"],[259,"سلا عن ربي سلع فأعين عينها","https://www.aldiwan.net/poem38135.html","الطويل"],[259,"إنا لتقتلنا العيون","https://www.aldiwan.net/poem38164.html","مجزوء الكامل"],[259,"يا ابن السرى والليل والبيداء","https://www.aldiwan.net/poem38377.html","الكامل"],[269,"أتأمرني بالصبر والطبع أغلب","https://www.aldiwan.net/poem52082.html","الطويل"],[273,"عديني بوصل وامطلي بنجازه","https://www.aldiwan.net/poem25411.html","الطويل"],[273,"لمن وقعة بالغرب ضعضعت الشرقا","https://www.aldiwan.net/poem25477.html","الطويل"],[279,"اسمع حديثي فإن الصدق مقبول","https://www.aldiwan.net/poem1382.html",""],[362,"كلما اشتقت يا خليلي نجدا","https://www.aldiwan.net/poem60932.html","الخفيف"],[362,"بيض طوالع من خيام سود","https://www.aldiwan.net/poem60954.html","الكامل"],[364,"أبا قرب النعي من البشير","https://www.aldiwan.net/poem17345.html","الوافر"],[400,"عذرا على ما جرى مني من الزلل","https://www.aldiwan.net/poem33488.html","البسيط"],[403,"أوقد البين في الخميس خميسا","https://www.aldiwan.net/poem50154.html","الخفيف"],[405,"وقطيع حوى شراب حكيم","https://www.aldiwan.net/poem4188.html","الخفيف"],[436,"بشير يوم بملك دهر","https://www.aldiwan.net/poem34907.html","مخلع البسيط"],[438,"هذا المحصب يا قلوصي من منى","https://www.aldiwan.net/poem14320.html","الكامل"],[438,"هذي المنازل ها هيه","https://www.aldiwan.net/poem14399.html","مجزوء الكامل"],[450,"يا ليالي السفح من عهد الصبا","https://www.aldiwan.net/poem13926.html","الرمل"],[459,"ملأ العصر بل الدهر علا","https://www.aldiwan.net/poem15397.html","الرمل"],[459,"قل للكمال مقال مولي حلفة","https://www.aldiwan.net/poem15459.html","الكامل"],[462,"يا خليلي تلك أعلام نجد","https://www.aldiwan.net/poem3489.html","عموديه"],[463,"شدوا اليك نياط القلب والعصبا","https://www.aldiwan.net/poem54193.html","عموديه"],[480,"عرج بمنعرج الكثيب الأخضد","https://www.aldiwan.net/poem24364.html","عموديه"],[498,"قد تداعت من الأقاح خيوط","https://www.aldiwan.net/poem37784.html","الخفيف"],[503,"المفر","https://www.aldiwan.net/poem27797.html","الوافر"],[512,"خفرت بسيف الغنج ذمة مغفري","https://www.aldiwan.net/poem20789.html","الكامل"],[512,"سفرت فبرقعها حجاب جمال","https://www.aldiwan.net/poem20814.html","الكامل"],[512,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[513,"تبسم في ليل الشباب مشيب","https://www.aldiwan.net/poem12010.html","الطويل"],[527,"تهدم من ربع المعارف جانبه","https://www.aldiwan.net/poem37537.html","الطويل"],[549,"قل للنوائب قد أصبت المقتلا","https://www.aldiwan.net/poem47316.html","الكامل"],[549,"أمن أجل أن أعفاك دهرك تطمع","https://www.aldiwan.net/poem47720.html","الطويل"],[549,"أظنك من جدوى الأحبة قانطا","https://www.aldiwan.net/poem47729.html","الطويل"],[549,"شطت عليك لبانة الصدر","https://www.aldiwan.net/poem47783.html","أحذ الكامل"],[549,"أدلت بحسن خولت ولو انها","https://www.aldiwan.net/poem48035.html","الطويل"],[551,"ما للغواني لا يدين فؤادي","https://www.aldiwan.net/poem68360.html","الكامل"],[557,"أيا سعد قل للقس من داخل الدير","https://www.aldiwan.net/poem69361.html","الطويل"],[560,"لاحت بوجه بديع الأنس ميمون","https://www.aldiwan.net/poem52847.html","البسيط"]],"verses":[["وَقَطَّروا الخَيلَ بِفُرسانِها","خارِجَةً عَن حَلقَةِ الخُضرِ",0,"ر",1,0],["وَقَطعِكَ كُلَّ بَعيدِ النِياطِ","كَأَنَّ الجَوادَ بِهِ مُستَريبُ",1,"ب",1,0],["وَقَطَعتُ ناظِرَيهِ ظاهِراً","لا يَكونُ مِثلَ لَطمٍ وَكَمَح",2,"ح",1,0],["وَقُطْبٌ عَلَيْهِ تَدُورُ النُّهَى","كَمَا تَابَعَتْ شَمْسَهَا الأَنْجُمُ",3,"م",1,0],["وَقَطعُ مَفازَةٍ وَرُكوبُ أُخرى","تَكِلُّ بِها الضُبارِمَةُ الرَّسومُ",4,"م",1,0],["وقطبت الأيام حتى تشابهت","بها غُدُواتٌ كالحاتٌ وآصال",5,"ل",1,0],["وقطايف رقت جسوماً مثل ما","غلظت قلوباً فهي لي أحساب",6,"ب",1,1],["وقطَّعت أسباب الحوادثِ بعدما","علقتَ بحبل من حبال محمد",7,"د",1,0],["وقطرةَ غيثٍ كنتَ أنبأتَ أنها","سيتبعُها قطرٌ مُلثٌّ على قطر",8,"ر",1,0],["وقطَّعن الثلوج لكل روض","وكل خميلة منها ثيابا",9,"ب",2,0],["وقطعة خد بينما هي جنة","لعينيك يا رائي إذا هي نار",10,"ر",1,0],["وَقَطَعتُ في الدُنيا الفَلا وَرَكائِبي","فيها وَوَقتَيَّ الضُحى وَالمَوهِنا",11,"ن",2,0],["وقطعك الماء عنه طول مدته","قبل الحصاد فساد فاسقِ في قَدَرِ",12,"ر",1,0],["وَقَطَعتَني بِالجودِ حَتّى إِنَّني","مُتَخَوِّفٌ أَلّا يَكونَ لِقاءُ",13,"ا",2,0],["وَقَطَعتُ أَطوالَ البِلادِ وَعَرضَها","ما بَينَ سِندانٍ وَبَينَ سِجاسِ",14,"س",1,0],["وَقَطعُ التِكَّةِ الرَأيُ","إِذا التَكَّةُ لَم تُحلَل",15,"ل",1,0],["وَقَطيعَةِ الحَسَنِ بنِ سَهلٍ إِنَّها","تَغدو وَوَصلي دونَها مَقطوعُ",16,"ع",1,0],["وقَطَّعَ أنفُسَ الحُسَّادِ غَيظاً","بسُؤدُدِه فَطيَّرَها شَظايا",17,"ا",3,0],["وقطَعْتَ الشَّبابَ فيه إلى أن","هَمَّ بُرْدُ الشَّبابِ بالإخلاقِ",18,"ق",1,0],["وقطعتُ فيه شبيبةً لم تَشتغلْ","عن حُسْنِه بِصَباً ولا بتصابي",19,"ب",2,0],["وقطعتَها والليلُ يصدعُ قلبَه","ضدانِ نارٌ تستنيرُ وماءُ",20,"ا",2,0],["وَقُطوبُ الخُطوبِ أَهوَنُ عِندي","مَوقِعاً مِن تَقَطُّبِ الحُجّابِ",21,"ب",1,0],["وقَطْعي بعيشٍ بعد ستّين حجّةً","أرى فيه لَبْساً والتخوّف في اللبسِ",22,"س",1,0],["وقطوفُ اللهوِ من قاطفها","دانياتٌ ببنيّاتِ الدّنان",23,"ن",1,0],["وقَطعِيَ غَولَ القَفرِ في مَتنِ سابِحٍ","وخوضيَ هَوْلَ البَحرِ في بَطنِ سابِحه",24,"ح",2,0],["وقطَّعَ بالجوعِ أكبادَهم","وإنْ يستغيثوا يغاثوا بما",25,"م",2,0],["وَقَطَّعتِ قَلبي بِالمَواعِدِ وَالمُنى","وَغُصتِ عَلى قَلبي فَأَوثَقتِهِ أَسرا",26,"ر",2,0],["وَقَطَّعَ المَجلِسَ في اِكتِئابِ","وَذِكرِ حَرقِ النارِ لِلثِيابِ",27,"ب",1,0],["وقَطْرٌ كالبِحارِ فلسْتُ أرْضَى","بقَطْرٍ صابَ مِن خَلَلِ الغَمامِ",28,"م",1,0],["وقطَّع الكُرومَ منها والشجرْ","ولم يُبايع عِلجُها ولا ظهَرْ",29,"ر",1,0],["وَقَطيع الأغنام من وجهة الشر","قِ إلى جانب الخيام يؤوب",30,"ب",1,0],["وقطفنا من زهرها وانثنيْنا","فجنيْنا تُفاحَها بيدينا",31,"ن",2,0],["وَقَطِينِ الْبُيُوتِ مِنْ وَبَرٍ أَوْ","مَدَرٍ فِي النُّجُوعِ أَوْ فِي النُّجُودِ",32,"د",1,0],["وقطَّبت بعد تهليل أسرَّتُه","وبان فوق خُطاه الضعفُ والخَوَر",33,"ر",1,0],["وَقَطَّعتُ كفَّيْ من يمدُّ يمينَهُ","يَصافحني في حين تَطعنُني اليسرى",34,"ر",2,0],["وِقَطَفتمُ مِن رَوَابِيهِ الخُزَامَى","وَالعُيُونَ الخُضرَ وِ الخَدَّ الأَسِيلاَ",35,"ل",2,0],["وقطّعني فيك الصديق ملامة","وإني لأعصي نهيهم حين أُزْجَر",36,"ر",1,0],["وَقَطَّعْتِ قَلْبي بِکلْمَوَاعِيدِ والمُنَى","وغصتِ على قلبي، فأوثقتهِ أسرا",37,"ر",2,0],["وقط ما ارخصني","تدللا الا غلا",38,"ل",2,0],["وقطعت سبل الساعين واتخذت","من بغيها كل جبّاء ومكّاس",39,"س",1,0],["وقُطبٍ دَاسَ أخمُصه الثَّرَيَا","فَجَاوَزَ في سُمُوَّتِهِ السماءَ",40,"ا",2,0],["وقطبت الكماةُ لها وجوهاً","وخاض الموتَ أبطالُ النزالِ",41,"ل",1,0],["وقطّب الجو وجهاً كلّه عقد","وبدَّلَ الأفق منه النور بالظلمِ",42,"م",1,1],["وَقَطَعتَ دابِرَ مَن طَغى في أَرضِهِ","فَحَظيتَ مِنهُ بِفَوقِ ما أَرضاكا",43,"ك",2,0],["وقطعت خفض العيش أحسب ما مضى","من العمر مثل اليوم من ظنه سهوى",44,"و",2,0],["وقطع وصلها سيفي وإني","فجعت بخالد عمدا كلابا",45,"ب",2,0],["وقطرُ الندى فيهن أنصاف لؤلؤ","فلو جَمَدت كانت تُصان وتُقتَنى",46,"ن",2,0],["وقطعته لتعذّر","فبدا يشبب بالعويص",47,"ص",1,0],["وقطع الشيخ في حنف وفقر","مسالك ذات مهلكة غرور",48,"ر",1,0],["وقطع قفار بالبقيعة كلما","تذكرتها طار الفؤاد عن الصدر",49,"ر",1,0],["وقطعة من جفاء","في قطعة من سلام",50,"م",1,0],["وقطَّعني الأسى والدمعُ بحرٌ","فعادَ بسيطُ هميّ في المديدِ",51,"د",1,0],["وقطفتَ من خدّ الحبي","ب بلحظ عينيك الشقِيقا",52,"ق",2,0],["وَقَطَعتَ آمالَ العُفاةِ وَلَم تَكُن","لَكَ شيمَةً أَن تَقطَعَ الآمالا",53,"ل",2,0],["وَقُطِّعَتِ المَواثِقُ مِن سُلَيمى","وَشَطَّ بِها وَجيرَتِها المَزارُ",54,"ر",1,0],["وقطعي بقطع الليل كل تنوفةٍ","يضل الغطاط النهج بين حزونها",55,"ن",3,0],["وقطنت ارضهم وعند","جوارهم يرعى القطين",56,"ن",1,0],["وقطعت باليأس الرجاء لديهم","واليأس يجدع أنف كل رجاء",57,"ا",2,0],["وَقطعت الايام أَسباب بيننا","وَلكن اليكم يَلجأ المتسبب",58,"ب",1,0],["وَقَطع حِبال الودِّ عارٌ وَأَنتُمُ","أَعَز جَنابا أَن يَنالُكُم العَذل",59,"ل",1,0],["وقُطَّت