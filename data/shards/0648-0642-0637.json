{"poems":[[55,"قرت عيون المجد والفخر","https://www.aldiwan.net/poem30478.html","السريع"],[55,"طلوع هداه إلينا المغيب","https://www.aldiwan.net/poem30758.html","المتقارب"],[9,"ما تعيف اليوم في الطير الروح","https://www.aldiwan.net/poem21921.html","الرمل"],[95,"ترى تعرف الشمس من ذا تشبه","https://www.aldiwan.net/poem11385.html","المتقارب"],[32,"أحادرة دموعك دار مي","https://www.aldiwan.net/poem29531.html","الوافر"],[90,"رويدك غورو أيهذا الجنيرال","https://www.aldiwan.net/poem44823.html","الطويل"],[74,"وقطايف رقت جسوما مثل ما","https://www.aldiwan.net/poem18270.html","الكامل"],[74,"عذيري من ساجي اللواحظ أغيد","https://www.aldiwan.net/poem18545.html","الطويل"],[53,"قرأت على أهلي كتابك إذا أتى","https://www.aldiwan.net/poem62922.html","الطويل"],[87,"ويوم من صبا آذار حلو","https://www.aldiwan.net/poem7044.html","الوافر"],[87,"فداها نساء الأرض من جركسية","https://www.aldiwan.net/poem7895.html","الطويل"],[45,"الحب ما منع الكلام الألسنا","https://www.aldiwan.net/poem10585.html","الكامل"],[64,"يا طالبا لنهايات العلوم ولم","https://www.aldiwan.net/poem52183.html","البسيط"],[47,"أمواهب هاتيك أم أنواء","https://www.aldiwan.net/poem10197.html","الكامل"],[47,"سهر أصابك بعد طول نعاس","https://www.aldiwan.net/poem64605.html","الكامل"],[47,"سقاني القهوة السلسل","https://www.aldiwan.net/poem65570.html","المنسرح"],[47,"أغدا يشت المجد وهو جميع","https://www.aldiwan.net/poem64713.html","الكامل"],[63,"غدا تبدي مدامعنا الخفايا","https://www.aldiwan.net/poem51397.html","الوافر"],[63,"قد أظلتك يا أبا إسحاق","https://www.aldiwan.net/poem51509.html","الخفيف"],[63,"بكرت عليك مغيرة الأعراب","https://www.aldiwan.net/poem51793.html","الكامل"],[63,"أحوال مجدك في العلو سواء","https://www.aldiwan.net/poem51833.html","الكامل"],[68,"سعة العذر لي وضيق الحجاب","https://www.aldiwan.net/poem38784.html","الخفيف"],[82,"فعوضت شيبا من شبابي كأنني","https://www.aldiwan.net/poem31211.html","الطويل"],[82,"أخذت سفاقس منك عهد أمان","https://www.aldiwan.net/poem31263.html","الكامل"],[82,"تقول وقد لاحت لها في مفارقي","https://www.aldiwan.net/poem31523.html","الطويل"],[71,"أحل الضيوف على سطحه","https://www.aldiwan.net/poem28822.html","المتقارب"],[33,"ألا ليت حظي منك أني كلما","https://www.aldiwan.net/poem42549.html","الطويل"],[54,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[48,"سمعت نعيها صما صمام","https://www.aldiwan.net/poem23631.html","الكامل"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/29338","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85418","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39648","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54745","الخفيف"],[102,"مآتم وأعراس","https://www.poetsgate.com/ViewPoem.aspx?id=50173",""],[92,"الفرات الطاغي","https://www.poetsgate.com/ViewPoem.aspx?id=179148",""],[92,"المحرقة","https://www.poetsgate.com/ViewPoem.aspx?id=179110",""],[101,"إلى بيروت الأنثى مع الإعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=215333",""],[34,"وآخر عهدي بها","https://www.poetsgate.com/ViewPoem.aspx?id=114",""],[33,"ألا ليتَ حظي منكِ أنيَ كلما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18854&r=&rc=117",""],[96,"من كسعد ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66301&r=&rc=19",""],[118,"يا رفقتي كأسي حلا","https://www.aldiwan.net/poem40422.html","عموديه"],[121,"ما بالرزايا وما بالنأي من باس","https://www.aldiwan.net/poem492.html",""],[135,"تخطى ركبه الظلل القواء","https://www.aldiwan.net/poem54900.html","الوافر"],[138,"سواي بهذه الدنيا يبالي","https://www.aldiwan.net/poem48852.html","الوافر"],[138,"وقطب الجو وجها كله عقد","https://www.aldiwan.net/poem48941.html","البسيط"],[146,"ما في المعالي مطمع لسواكا","https://www.aldiwan.net/poem11788.html","الكامل"],[163,"إليك فقد حملت قلبي من الهوي","https://www.aldiwan.net/poem59013.html","الطويل"],[168,"نأت سلمى وأمست في عدو","https://www.aldiwan.net/poem719.html",""],[188,"تولى شباب واقتراب فأمعنا","https://www.aldiwan.net/poem14733.html","الطويل"],[189,"مشي الثقيل إذا مشى","https://www.aldiwan.net/poem43689.html","مجزوء الكامل"],[189,"فرضت علي يا مولاي حجا","https://www.aldiwan.net/poem43847.html","الوافر"],[189,"سكنت إلى حسن التوكل والصم","https://www.aldiwan.net/poem43867.html","الطويل"],[202,"يا من لنضو طريح","https://www.aldiwan.net/poem45153.html","المجتث"],[202,"على الطرسين من خد وجيد","https://www.aldiwan.net/poem45223.html","الوافر"],[232,"يا كانيا عن دمعه","https://www.aldiwan.net/poem50932.html","مجزوء الكامل"],[238,"أتظنني ما عشت أنعم بالا","https://www.aldiwan.net/poem31787.html","الكامل"],[238,"أتجزع للفراق وهم جوار","https://www.aldiwan.net/poem31988.html","الوافر"],[264,"سلا عن ربي سلع فأعين عينها","https://www.aldiwan.net/poem38135.html","الطويل"],[264,"إنا لتقتلنا العيون","https://www.aldiwan.net/poem38164.html","مجزوء الكامل"],[264,"يا ابن السرى والليل والبيداء","https://www.aldiwan.net/poem38377.html","الكامل"],[274,"أتأمرني بالصبر والطبع أغلب","https://www.aldiwan.net/poem52082.html","الطويل"],[278,"عديني بوصل وامطلي بنجازه","https://www.aldiwan.net/poem25411.html","الطويل"],[278,"لمن وقعة بالغرب ضعضعت الشرقا","https://www.aldiwan.net/poem25477.html","الطويل"],[284,"اسمع حديثي فإن الصدق مقبول","https://www.aldiwan.net/poem1382.html",""],[367,"كلما اشتقت يا خليلي نجدا","https://www.aldiwan.net/poem60932.html","الخفيف"],[367,"بيض طوالع من خيام سود","https://www.aldiwan.net/poem60954.html","الكامل"],[369,"أبا قرب النعي من البشير","https://www.aldiwan.net/poem17345.html","الوافر"],[406,"عذرا على ما جرى مني من الزلل","https://www.aldiwan.net/poem33488.html","البسيط"],[409,"أوقد البين في الخميس خميسا","https://www.aldiwan.net/poem50154.html","الخفيف"],[411,"وقطيع حوى شراب حكيم","https://www.aldiwan.net/poem4188.html","الخفيف"],[442,"بشير يوم بملك دهر","https://www.aldiwan.net/poem34907.html","مخلع البسيط"],[444,"هذا المحصب يا قلوصي من منى","https://www.aldiwan.net/poem14320.html","الكامل"],[444,"هذي المنازل ها هيه","https://www.aldiwan.net/poem14399.html","مجزوء الكامل"],[454,"يا ليالي السفح من عهد الصبا","https://www.aldiwan.net/poem13926.html","الرمل"],[463,"ملأ العصر بل الدهر علا","https://www.aldiwan.net/poem15397.html","الرمل"],[463,"قل للكمال مقال مولي حلفة","https://www.aldiwan.net/poem15459.html","الكامل"],[466,"يا خليلي تلك أعلام نجد","https://www.aldiwan.net/poem3489.html","عموديه"],[467,"شدوا اليك نياط القلب والعصبا","https://www.aldiwan.net/poem54193.html","عموديه"],[484,"عرج بمنعرج الكثيب الأخضد","https://www.aldiwan.net/poem24364.html","عموديه"],[502,"قد تداعت من الأقاح خيوط","https://www.aldiwan.net/poem37784.html","الخفيف"],[507,"المفر","https://www.aldiwan.net/poem27797.html","الوافر"],[516,"خفرت بسيف الغنج ذمة مغفري","https://www.aldiwan.net/poem20789.html","الكامل"],[516,"سفرت فبرقعها حجاب جمال","https://www.aldiwan.net/poem20814.html","الكامل"],[516,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[517,"تبسم في ليل الشباب مشيب","https://www.aldiwan.net/poem12010.html","الطويل"],[531,"تهدم من ربع المعارف جانبه","https://www.aldiwan.net/poem37537.html","الطويل"],[553,"قل للنوائب قد أصبت المقتلا","https://www.aldiwan.net/poem47316.html","الكامل"],[553,"أمن أجل أن أعفاك دهرك تطمع","https://www.aldiwan.net/poem47720.html","الطويل"],[553,"أظنك من جدوى الأحبة قانطا","https://www.aldiwan.net/poem47729.html","الطويل"],[553,"شطت عليك لبانة الصدر","https://www.aldiwan.net/poem47783.html","أحذ الكامل"],[553,"أدلت بحسن خولت ولو انها","https://www.aldiwan.net/poem48035.html","الطويل"],[555,"ما للغواني لا يدين فؤادي","https://www.aldiwan.net/poem68360.html","الكامل"],[561,"أيا سعد قل للقس من داخل الدير","https://www.aldiwan.net/poem69361.html","الطويل"],[564,"لاحت بوجه بديع الأنس ميمون","https://www.aldiwan.net/poem52847.html","البسيط"],[159,"","https://poetry.dctabudhabi.ae/diwan/poem/200307","الوافر"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/21471","الطويل"],[852,"","https://poetry.dctabudhabi.ae/diwan/poem/31366","الطويل"],[916,"","https://poetry.dctabudhabi.ae/diwan/poem/31506","المتقارب"]],"verses":[["وَقَطَّروا الخَيلَ بِفُرسانِها","خارِجَةً عَن حَلقَةِ الخُضرِ",0,"ر",1,0],["وَقَطعِكَ كُلَّ بَعيدِ النِياطِ","كَأَنَّ الجَوادَ بِهِ مُستَريبُ",1,"ب",1,0],["وَقَطَعتُ ناظِرَيهِ ظاهِراً","لا يَكونُ مِثلَ لَطمٍ وَكَمَح",2,"ح",1,0],["وَقُطْبٌ عَلَيْهِ تَدُورُ النُّهَى","كَمَا تَابَعَتْ شَمْسَهَا الأَنْجُمُ",3,"م",1,0],["وَقَطعُ مَفازَةٍ وَرُكوبُ أُخرى","تَكِلُّ بِها الضُبارِمَةُ الرَّسومُ",4,"م",1,0],["وقطبت الأيام حتى تشابهت","بها غُدُواتٌ كالحاتٌ وآصال",5,"ل",1,0],["وقطايف رقت جسوماً مثل ما","غلظت قلوباً فهي لي أحساب",6,"ب",1,1],["وقطَّعت أسباب الحوادثِ بعدما","علقتَ بحبل من حبال محمد",7,"د",1,0],["وقطرةَ غيثٍ كنتَ أنبأتَ أنها","سيتبعُها قطرٌ مُلثٌّ على قطر",8,"ر",1,0],["وقطَّعن الثلوج لكل روض","وكل خميلة منها ثيابا",9,"ب",2,0],["وقطعة خد بينما هي جنة","لعينيك يا رائي إذا هي نار",10,"ر",1,0],["وَقَطَعتُ في الدُنيا الفَلا وَرَكائِبي","فيها وَوَقتَيَّ الضُحى وَالمَوهِنا",11,"ن",2,0],["وقطعك الماء عنه طول مدته","قبل الحصاد فساد فاسقِ في قَدَرِ",12,"ر",1,0],["وَقَطَعتَني بِالجودِ حَتّى إِنَّني","مُتَخَوِّفٌ أَلّا يَكونَ لِقاءُ",13,"ا",2,0],["وَقَطَعتُ أَطوالَ البِلادِ وَعَرضَها","ما بَينَ سِندانٍ وَبَينَ سِجاسِ",14,"س",1,0],["وَقَطعُ التِكَّةِ الرَأيُ","إِذا التَكَّةُ لَم تُحلَل",15,"ل",1,0],["وَقَطيعَةِ الحَسَنِ بنِ سَهلٍ إِنَّها","تَغدو وَوَصلي دونَها مَقطوعُ",16,"ع",1,0],["وقَطَّعَ أنفُسَ الحُسَّادِ غَيظاً","بسُؤدُدِه فَطيَّرَها شَظايا",17,"ا",3,0],["وقطَعْتَ الشَّبابَ فيه إلى أن","هَمَّ بُرْدُ الشَّبابِ بالإخلاقِ",18,"ق",1,0],["وقطعتُ فيه شبيبةً لم تَشتغلْ","عن حُسْنِه بِصَباً ولا بتصابي",19,"ب",2,0],["وقطعتَها والليلُ يصدعُ قلبَه","ضدانِ نارٌ تستنيرُ وماءُ",20,"ا",2,0],["وَقُطوبُ الخُطوبِ أَهوَنُ عِندي","مَوقِعاً مِن تَقَطُّبِ الحُجّابِ",21,"ب",1,0],["وقَطْعي بعيشٍ بعد ستّين حجّةً","أرى فيه لَبْساً والتخوّف في اللبسِ",22,"س",1,0],["وقطوفُ اللهوِ من قاطفها","دانياتٌ ببنيّاتِ الدّنان",23,"ن",1,0],["وقَطعِيَ غَولَ القَفرِ في مَتنِ سابِحٍ","وخوضيَ هَوْلَ البَحرِ في بَطنِ سابِحه",24,"ح",2,0],["وقطَّعَ بالجوعِ أكبادَهم","وإنْ يستغيثوا يغاثوا بما",25,"م",2,0],["وَقَطَّعتِ قَلبي بِالمَواعِدِ وَالمُنى","وَغُصتِ عَلى قَلبي فَأَوثَقتِهِ أَسرا",26,"ر",2,0],["وَقَطَّعَ المَجلِسَ في اِكتِئابِ","وَذِكرِ حَرقِ النارِ لِلثِيابِ",27,"ب",1,0],["وقَطْرٌ كالبِحارِ فلسْتُ أرْضَى","بقَطْرٍ صابَ مِن خَلَلِ الغَمامِ",28,"م",1,0],["وقطَّع الكُرومَ منها والشجرْ","ولم يُبايع عِلجُها ولا ظهَرْ",29,"ر",1,0],["وقطعٌ دجوجيّ من الليل ملبس","على الأرض منه اكسرٌ وخوالف",30,"ف",1,0],["وَقَطيع الأغنام من وجهة الشر","قِ إلى جانب الخيام يؤوب",31,"ب",1,0],["وقطفنا من زهرها وانثنيْنا","فجنيْنا تُفاحَها بيدينا",32,"ن",2,0],["وَقَطِينِ الْبُيُوتِ مِنْ وَبَرٍ أَوْ","مَدَرٍ فِي النُّجُوعِ أَوْ فِي النُّجُودِ",33,"د",1,0],["وقطيعا من البراءات يهوى","من يديّ ذابح إلى شدق لاقم",34,"م",1,0],["وقطَّبت بعد تهليل أسرَّتُه","وبان فوق خُطاه الضعفُ والخَوَر",35,"ر",1,0],["وَقَطَّعتُ كفَّيْ من يمدُّ يمينَهُ","يَصافحني في حين تَطعنُني اليسرى",36,"ر",2,0],["وِقَطَفتمُ مِن رَوَابِيهِ الخُزَامَى","وَالعُيُونَ الخُضرَ وِ الخَدَّ الأَسِيلاَ",37,"ل",2,0],["وقطّعني فيك الصديق ملامة","وإني لأعصي نهيهم حين أُزْجَر",38,"ر",1,0],["وَقَطَّعْتِ قَلْبي بِکلْمَوَاعِيدِ والمُنَى","وغصتِ على قلبي، فأوثقتهِ أسرا",39,"ر",2,0],["وقطيع من الشياه ورعيان","وأغنّية ترقّ فتردى",40,"د",2,0],["وقط ما ارخصني","تدللا الا غلا",41,"ل",2,0],["وقطعت سبل الساعين واتخذت","من بغيها كل جبّاء ومكّاس",42,"س",1,0],["وقُطبٍ دَاسَ أخمُصه الثَّرَيَا","فَجَاوَزَ في سُمُوَّتِهِ السماءَ",43,"ا",2,0],["وقطبت الكماةُ لها وجوهاً","وخاض الموتَ أبطالُ النزالِ",44,"ل",1,0],["وقطّب الجو وجهاً كلّه عقد","وبدَّلَ الأفق منه النور بالظلمِ",45,"م",1,1],["وَقَطَعتَ دابِرَ مَن طَغى في أَرضِهِ","فَحَظيتَ مِنهُ بِفَوقِ ما أَرضاكا",46,"ك",2,0],["وقطعت خفض العيش أحسب ما مضى","من العمر مثل اليوم من ظنه سهوى",47,"و",2,0],["وقطع وصلها سيفي وإني","فجعت بخالد عمدا كلابا",48,"ب",2,0],["وقطرُ الندى فيهن أنصاف لؤلؤ","فلو جَمَدت كانت تُصان وتُقتَنى",49,"ن",2,0],["وقطعته لتعذّر","فبدا يشبب بالعويص",50,"ص",1,0],["وقطع الشيخ في حنف وفقر","مسالك ذات مهلكة غرور",51,"ر",1,0],["وقطع قفار بالبقيعة كلما","تذكرتها طار الفؤاد عن الصدر",52,"ر",1,0],["وقطعة من جفاء","في قطعة من سلام",53,"م",1,0],["وقطَّعني الأسى والدمعُ بحرٌ","فعادَ بسيطُ هميّ في المديدِ",54,"د",1,0],["وقطفتَ من خدّ الحبي","ب بلحظ عينيك الشقِيقا",55,"ق",2,0],["وَقَطَعتَ آمالَ العُفاةِ وَلَم تَكُن","لَكَ شيمَةً أَن تَقطَعَ الآمالا",56,"ل",2,0],["وَقُطِّعَتِ المَواثِقُ مِن سُلَيمى","وَشَطَّ بِها وَجيرَتِها المَزارُ",57,"ر",1,0],["وقطعي بقطع الليل كل تنوفةٍ","يضل الغطاط النهج بين حزونها",58,"ن",3,0],["وقطنت ارضهم وعند","جوارهم يرعى القطين",59,"ن",1,0],["وقطعت باليأس الرجاء لديهم","واليأس يجدع أنف كل رجاء",60,"ا",2,0],["وَقطعت الايام أَسباب بيننا","وَلكن اليكم يَلجأ المتسبب",61,"ب",1,0],["وَقَطع حِبال الودِّ عارٌ وَأَنتُمُ","أَعَز جَنابا أَن يَنالُكُم العَذل",62,"ل",1,0],["وقُطَّتْ بإِتْيانِ الجَرَائِمِ هامُهُمْ","نَكَالاً كَما قَطَّت يَدُ الجَارِمِ العِذْقَا",63,"ق",2,0],["وقطَّع الوجد أحشائي فلي كبدٌ","نجيعُها في طلول البعد مطلول",64,"ل",1,0],["وقطَعْنا البلاد سَهْلاً وحَزْنا","وَبرَيْنا الرِّكابَ حَلاً وشَدّا",65,"د",2,0],["وقَطَعتُ في طَلَبِ النّجاةِ عَلائقي","وأرى مَضاءَ السّيفِ في التّجْريد",66,"د",1,0],["وَقَطفُكَ مِن ذُرا شَجَرِ العَوالي","تَسَرَّبَ بَينَها خُلُجُ الذُكورِ",67,"ر",1,0],["وقطعت بسكاكين الدواة يدي","ولطخت بمدادي بعده حللي",68,"ل",2,0],["وقطرة من معين البحث صافية","جاءت بسيل طغى في السهل والجبل",68,"ل",1,0],["وقطرت الدُموع إِذ قطر العيس","وَحمَّلت قطر دَمعي نُفوسا",69,"س",2,0],["وَقَطيعٍ حَوى شَرابَ حَكيمِ","طالَ ما كانَ خِدرَ بِنتِ الكُرومِ",70,"م",1,1],["وقطرةً من دمٍ سَتَمْرِي","دمَ العِدَى وابلاً بقَطْرِ",71,"ر",1,0],["وقطعت كل دوية لو أنها","سارت بها الحدواء عثرها الونى",72,"ن",2,0],["وقطوفها للأوليا","ء على الحقيقة دانيه",73,"ي",2,0],["وقطعنا فيه عيشاً أطيبا","للصبى لكنه لم يَدُم",74,"م",1,0],["وقَطوبٌ لأحاديثِ الخَنا","فاذا ما قطَّبَ الخطبُ ابتسمْ",75,"م",1,0],["وقطعتُ عامي ساغباً مُتلدِّداً","والقولُ سِلْمٌ والفؤادُ سليمُ",76,"م",1,0],["وقطار السماء ضاحكة البر","قِ وقد حثَّها حداءُ الرعد",77,"د",1,0],["وَقَطَّعَ الشَّكُّ أسباباً نَلوذ ُ بِها","في عاصِفٍ لم يَدَعْ مِن خَيمَةٍ طُنُبا",78,"ب",2,0],["وقطعت ما بين الشظا وتصاعدت","زفرات وجد من ضلوع القمهد",79,"د",1,0],["وقطعْتُ الزَّمانَ بالصِّدقِ فيهم","وقطعْتُ الفُؤادَ عمَّا وعَمَّا",80,"م",2,0],["وقطْراتٌ من الماءِ يمنُّ","بها الغُلُّ من الجمرِ أحَرُّ",81,"ر",1,0],["وقطعْتَ أنوار الفَخار بأنمُل ال","فِتيان من روضِ الجديد الأخضرِ",82,"ر",1,0],["وقطعْتُ من كلِّ الأنامِ علائِقي","ووصَلْتُ فيه وفي بَنيه حِبالي",83,"ل",2,0],["وقَطوفٍ من جُمانٍ ذُلِّلَتْ","عزَّ كلَّ العزِّ مُستَحلي جَناها",84,"ا",3,0],["وقطت بأطراف الرماح مطارف","عليه وغطت بالسيوف جيوب",85,"ب",1,0],["وقَطَّعَ أَنْساعَ الرَّواحِلِ رَاجِلٌ","وكَسَّرَ أَقْتاباً مِن الرَّحْلِ رَاكِبُهْ",86,"ب",2,0],["وقطعتَ في أَرَبٍ بهيماً مظلماً","وركبتَ في طَلَبٍ أغرَّ مُحَجَّلا",87,"ل",2,0],["وَقَطّع عنّي معشري وأصادِقي","وَشَملُ اِمرئٍ فاتَ الرّدى متقطّعُ",88,"ع",1,0],["وقطّع أقرانَ الورى دون همِّهِ","وَلَن تقطَعَ الأقدارُ ما كان نائطا",89,"ط",2,0],["وَقَطيعةٍ ما كُنتُ أَحذَرها","إلّا عَليك فلم يَفِدْ حِذْري",90,"ر",2,0],["وقطّعت الأسبابَ بينِي وبينها","ولَو كنتُ خِلْواً من هواها قطعتُها",91,"ت",3,0],["وَقَطَعتُ بِالعَزماءِ أَقرانَ الصِبا","وَحَلَلتُ مَنزِلَ نُهيَةً وَرَشادِ",92,"د",1,0],["وقطعُ ذوي الألبابِ عشق مراتب","من العالم الأدنى ويُسلبن كالسحرِ",93,"ر",1,0],["وقطَّبتْ عندَ زَجرِ الصَبِّ حاجِبَها","لأنَّها تَعهَدُ التأكيدَ بالنُّونِ",94,"ن",1,0],["وقطعنا مشافرها وخفنا","أجرتها فما اجترت بعود",95,"د",1,0],["وَقطعي إِلَيك اللَّيلَ حِضنَيه إِنَّني","لِذاكَ إِذا هابَ الرِّجالُ فَعولُ",96,"ل",1,0],["وَقَطَّعتُهُ بِاللَومِ حَتّى أَطاعني","وَأُلقي عَلى ظَهرِ الحَقيبَةِ أَو وَجَم",97,"م",1,0],["وَقَطَّعَ أَلواذَ داوِيَّةٍ","صَحارِيَ غُلّانِ طَلحٍ وَضالِ",98,"ل",1,0]]}