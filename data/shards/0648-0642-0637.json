134973",""],[1901,"خلعتُ رداءَ الشبابِ الجديدْ","https://www.poetsgate.com/ViewPoem.aspx?id=160411",""],[4859,"روض السماء","https://www.poetsgate.com/ViewPoem.aspx?id=201730",""],[4930,"مراعي البؤس","https://www.poetsgate.com/ViewPoem.aspx?id=213102",""],[4984,"مرَّ قطار صحبك","https://www.poetsgate.com/ViewPoem.aspx?id=175538",""],[5054,"‏ثورة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=213745",""],[3271,"راهب النخيل","https://www.poetsgate.com/ViewPoem.aspx?id=104128",""],[5136,"من في الملوك يقاس بالشمس","https://www.poetsgate.com/ViewPoem.aspx?id=121607",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5186,"غيد الهوى والجوى حاولن تجريبي","https://www.poetsgate.com/ViewPoem.aspx?id=156473",""],[5370,"عواذل","https://www.poetsgate.com/ViewPoem.aspx?id=81640",""],[5397,"يا سائق النوق عن الأربع","https://www.poetsgate.com/ViewPoem.aspx?id=157919",""],[5442,"يامن إليه بعزه اتشفع","https://www.poetsgate.com/ViewPoem.aspx?id=114749",""],[709,"أَتُنْكِرُ بَأْسَ أَحْدَاقِ الْعَذَارَى","https://www.poetsgate.com/ViewPoem.aspx?id=2929",""],[5473,"أَنِّي تركت لذا الورى دنياهم","https://www.poetsgate.com/ViewPoem.aspx?id=189606",""],[470,"هذي ذُرى مصر","https://www.poetsgate.com/ViewPoem.aspx?id=63614",""],[5658,"الهي قد أَعْطَيْتنِي مَا أحبه","https://www.poetsgate.com/ViewPoem.aspx?id=189653",""],[5691,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=207079",""],[5717,"بحار دم أجرت عيون محبيه","https://www.poetsgate.com/ViewPoem.aspx?id=170591",""],[5736,"مستاءة لغيابك","https://www.poetsgate.com/ViewPoem.aspx?id=203915",""],[5790,"لقد سرت البشائر والتهاني","https://www.poetsgate.com/ViewPoem.aspx?id=111875",""],[5881,"يا حامل المصباح","https://www.poetsgate.com/ViewPoem.aspx?id=183774",""],[5909,"إني إذا رحَلتْ إليكَ شجوني","https://www.poetsgate.com/ViewPoem.aspx?id=210415",""],[1920,"حجرٌ قلبُكْ","https://www.poetsgate.com/ViewPoem.aspx?id=191354",""],[5957,"لا تيأس يا ابن العرب..","https://www.poetsgate.com/ViewPoem.aspx?id=11423",""],[6034,"خطب ألم فسار في الآفاق","https://www.poetsgate.com/ViewPoem.aspx?id=169608",""],[6102,"أُمِّي وَأُمِّي","https://www.poetsgate.com/ViewPoem.aspx?id=182734",""],[6102,"جَنَّةُ الشِّعر ..","https://www.poetsgate.com/ViewPoem.aspx?id=183611",""],[6127,"أسد بابل","https://www.poetsgate.com/ViewPoem.aspx?id=188648",""],[6147,"أنا ودليلتي.. والطريق..","https://www.poetsgate.com/ViewPoem.aspx?id=151496",""],[6147,"عقيم العمر ينتظر الجنين","https://www.poetsgate.com/ViewPoem.aspx?id=151501",""],[6176,"رأيت جرحي واقفاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65154&r=&rc=5",""],[2220,"البرقُ يلمعُ والرعودُ تسبحُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11258&r=&rc=132",""],[6325,"معراج روح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88021&r=&rc=3",""],[5190,"الشعر والمشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78334&r=&rc=47",""],[5190,"إشارة حمراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85037&r=&rc=112",""]],"verses":[["وَقَطَّروا الخَيلَ بِفُرسانِها","خارِجَةً عَن حَلقَةِ الخُضرِ",0,"ر",1,0],["وَقَطعِكَ كُلَّ بَعيدِ النِياطِ","كَأَنَّ الجَوادَ بِهِ مُستَريبُ",1,"ب",1,0],["وَقَطَعتُ ناظِرَيهِ ظاهِراً","لا يَكونُ مِثلَ لَطمٍ وَكَمَح",2,"ح",1,0],["وَقُطْبٌ عَلَيْهِ تَدُورُ النُّهَى","كَمَا تَابَعَتْ شَمْسَهَا الأَنْجُمُ",3,"م",1,0],["وَقَطعُ مَفازَةٍ وَرُكوبُ أُخرى","تَكِلُّ بِها الضُبارِمَةُ الرَّسومُ",4,"م",1,0],["وقطبت الأيام حتى تشابهت","بها غُدُواتٌ كالحاتٌ وآصال",5,"ل",1,0],["وقطايف رقت جسوماً مثل ما","غلظت قلوباً فهي لي أحساب",6,"ب",1,1],["وقطَّعت أسباب الحوادثِ بعدما","علقتَ بحبل من حبال محمد",7,"د",1,0],["وقطرةَ غيثٍ كنتَ أنبأتَ أنها","سيتبعُها قطرٌ مُلثٌّ على قطر",8,"ر",1,0],["وقطَّعن الثلوج لكل روض","وكل خميلة منها ثيابا",9,"ب",2,0],["وقطعة خد بينما هي جنة","لعينيك يا رائي إذا هي نار",10,"ر",1,0],["وَقَطَعتُ في الدُنيا الفَلا وَرَكائِبي","فيها وَوَقتَيَّ الضُحى وَالمَوهِنا",11,"ن",2,0],["وقطعك الماء عنه طول مدته","قبل الحصاد فساد فاسقِ في قَدَرِ",12,"ر",1,0],["وَقَطَعتَني بِالجودِ حَتّى إِنَّني","مُتَخَوِّفٌ أَلّا يَكونَ لِقاءُ",13,"ا",2,0],["وَقَطَعتُ أَطوالَ البِلادِ وَعَرضَها","ما بَينَ سِندانٍ وَبَينَ سِجاسِ",14,"س",1,0],["وَقَطعُ التِكَّةِ الرَأيُ","إِذا التَكَّةُ لَم تُحلَل",15,"ل",1,0],["وَقَطيعَةِ الحَسَنِ بنِ سَهلٍ إِنَّها","تَغدو وَوَصلي دونَها مَقطوعُ",16,"ع",1,0],["وقَطَّعَ أنفُسَ الحُسَّادِ غَيظاً","بسُؤدُدِه فَطيَّرَها شَظايا",17,"ا",3,0],["وقطَعْتَ الشَّبابَ فيه إلى أن","هَمَّ بُرْدُ الشَّبابِ بالإخلاقِ",18,"ق",1,0],["وقطعتُ فيه شبيبةً لم تَشتغلْ","عن حُسْنِه بِصَباً ولا بتصابي",19,"ب",2,0],["وقطعتَها والليلُ يصدعُ قلبَه","ضدانِ نارٌ تستنيرُ وماءُ",20,"ا",2,0],["وَقُطوبُ الخُطوبِ أَهوَنُ عِندي","مَوقِعاً مِن تَقَطُّبِ الحُجّابِ",21,"ب",1,0],["وقَطْعي بعيشٍ بعد ستّين حجّةً","أرى فيه لَبْساً والتخوّف في اللبسِ",22,"س",1,0],["وقطوفُ اللهوِ من قاطفها","دانياتٌ ببنيّاتِ الدّنان",23,"ن",1,0],["وقَطعِيَ غَولَ القَفرِ في مَتنِ سابِحٍ","وخوضيَ هَوْلَ البَحرِ في بَطنِ سابِحه",24,"ح",2,0],["وقطَّعَ بالجوعِ أكبادَهم","وإنْ يستغيثوا يغاثوا بما",25,"م",2,0],["وَقَطَّعتِ قَلبي بِالمَواعِدِ وَالمُنى","وَغُصتِ عَلى قَلبي فَأَوثَقتِهِ أَسرا",26,"ر",2,0],["وَقَطَّعَ المَجلِسَ في اِكتِئابِ","وَذِكرِ حَرقِ النارِ لِلثِيابِ",27,"ب",1,0],["وقَطْرٌ كالبِحارِ فلسْتُ أرْضَى","بقَطْرٍ صابَ مِن خَلَلِ الغَمامِ",28,"م",1,0],["وقطَّع الكُرومَ منها والشجرْ","ولم يُبايع عِلجُها ولا ظهَرْ",29,"ر",1,0],["وقطعٌ دجوجيّ من الليل ملبس","على الأرض منه اكسرٌ وخوالف",30,"ف",1,0],["وَقَطيع الأغنام من وجهة الشر","قِ إلى جانب الخيام يؤوب",31,"ب",1,0],["وقطفنا من زهرها وانثنيْنا","فجنيْنا تُفاحَها بيدينا",32,"ن",2,0],["وَقَطِينِ الْبُيُوتِ مِنْ وَبَرٍ أَوْ","مَدَرٍ فِي النُّجُوعِ أَوْ فِي النُّجُودِ",33,"د",1,0],["وقطرة النفس في أيدي بصيرتها","فارم البصيرة حيث النفس تقتحم",34,"م",1,0],["وقطيعا من البراءات يهوى","من يديّ ذابح إلى شدق لاقم",35,"م",1,0],["وقطَّبت بعد تهليل أسرَّتُه","وبان فوق خُطاه الضعفُ والخَوَر",36,"ر",1,0],["وَقَطَّعتُ كفَّيْ من يمدُّ يمينَهُ","يَصافحني في حين تَطعنُني اليسرى",37,"ر",2,0],["وِقَطَفتمُ مِن رَوَابِيهِ الخُزَامَى","وَالعُيُونَ الخُضرَ وِ الخَدَّ الأَسِيلاَ",38,"ل",2,0],["وقطّعني فيك الصديق ملامة","وإني لأعصي نهيهم حين أُزْجَر",39,"ر",1,0],["وَقَطَّعْتِ قَلْبي بِکلْمَوَاعِيدِ والمُنَى","وغصتِ على قلبي، فأوثقتهِ أسرا",40,"ر",2,0],["وقطيع من الشياه ورعيان","وأغنّية ترقّ فتردى",41,"د",2,0],["وقط ما ارخصني","تدللا الا غلا",42,"ل",2,0],["وقطعت سبل الساعين واتخذت","من بغيها كل جبّاء ومكّاس",43,"س",1,0],["وقُطبٍ دَاسَ أخمُصه الثَّرَيَا","فَجَاوَزَ في سُمُوَّتِهِ السماءَ",44,"ا",2,0],["وقطبت الكماةُ لها وجوهاً","وخاض الموتَ أبطالُ النزالِ",45,"ل",1,0],["وقطّب الجو وجهاً كلّه عقد","وبدَّلَ الأفق منه النور بالظلمِ",46,"م",1,1],["وَقَطَعتَ دابِرَ مَن طَغى في أَرضِهِ","فَحَظيتَ مِنهُ بِفَوقِ ما أَرضاكا",47,"ك",2,0],["وقطعت خفض العيش أحسب ما مضى","من العمر مثل اليوم من ظنه سهوى",48,"و",2,0],["وقطع وصلها سيفي وإني","فجعت بخالد عمدا كلابا",49,"ب",2,0],["وقطرُ الندى فيهن أنصاف لؤلؤ","فلو جَمَدت كانت تُصان وتُقتَنى",50,"ن",2,0],["وقطعته لتعذّر","فبدا يشبب بالعويص",51,"ص",1,0],["وقطع الشيخ في حنف وفقر","مسالك ذات مهلكة غرور",52,"ر",1,0],["وقطع قفار بالبقيعة كلما","تذكرتها طار الفؤاد عن الصدر",53,"ر",1,0],["وقطعة من جفاء","في قطعة من سلام",54,"م",1,0],["وقطَّعني الأسى والدمعُ بحرٌ","فعادَ بسيطُ هميّ في المديدِ",55,"د",1,0],["وقطفتَ من خدّ الحبي","ب بلحظ عينيك الشقِيقا",56,"ق",2,0],["وَقَطَعتَ آمالَ العُفاةِ وَلَم تَكُن","لَكَ شيمَةً أَن تَقطَعَ الآمالا",57,"ل",2,0],["وَقُطِّعَتِ المَواثِقُ مِن سُلَيمى","وَشَطَّ بِها وَجيرَتِها المَزارُ",58,"ر",1,0],["وقطعي بقطع الليل كل تنوفةٍ","يضل الغطاط النهج بين حزونها",59,"ن",3,0],["وقطنت ارضهم وعند","جوارهم يرعى القطين",60,"ن",1,0],["وقطعت باليأس الرجاء لديهم","واليأس يجدع أنف كل رجاء",61,"ا",2,0],["وَقطعت الايام أَسباب بيننا","وَلكن اليكم يَلجأ المتسبب",62,"ب",1,0],["وَقَطع حِبال الودِّ عارٌ وَأَنتُمُ","أَعَز جَنابا أَن يَنالُكُم العَذل",63,"ل",1,0],["وقُطَّتْ بإِتْيانِ الجَرَائِمِ هامُهُمْ","نَكَالاً كَما قَطَّت يَدُ الجَارِمِ العِذْقَا",64,"ق",2,0],["وقطَّع الوجد أحشائي فلي كبدٌ","نجيعُها في طلول البعد مطلول",65,"ل",1,0],["وقطَعْنا البلاد سَهْلاً وحَزْنا","وَبرَيْنا الرِّكابَ حَلاً وشَدّا",66,"د",2,0],["وقَطَعتُ في طَلَبِ النّجاةِ عَلائقي","وأرى مَضاءَ السّيفِ في التّجْريد",67,"د",1,0],["وَقَطفُكَ مِن ذُرا شَجَرِ العَوالي","تَسَرَّبَ بَينَها خُلُجُ الذُكورِ",68,"ر",1,0],["وقطعت بسكاكين الدواة يدي","ولطخت بمدادي بعده حللي",69,"ل",2,0],["وقطرة من معين البحث صافية","جاءت بسيل طغى في السهل والجبل",69,"ل",1,0],["وقطرت الدُموع إِذ قطر العيس","وَحمَّلت قطر دَمعي نُفوسا",70,"س",2,0],["وَقَطيعٍ حَوى شَرابَ حَكيمِ","طالَ ما كانَ خِدرَ بِنتِ الكُرومِ",71,"م",1,1],["وقطرةً من دمٍ سَتَمْرِي","دمَ العِدَى وابلاً بقَطْرِ",72,"ر",1,0],["وقطعت كل دوية لو أنها","سارت بها الحدواء عثرها الونى",73,"ن",2,0],["وقطوفها للأوليا","ء على الحقيقة دانيه",74,"ي",2,0],["وقطعنا فيه عيشاً أطيبا","للصبى لكنه لم يَدُم",75,"م",1,0],["وقَطوبٌ لأحاديثِ الخَنا","فاذا ما قطَّبَ الخطبُ ابتسمْ",76,"م",1,0],["وقطعتُ عامي ساغباً مُتلدِّداً","والقولُ سِلْمٌ والفؤادُ سليمُ",77,"م",1,0],["وقطار السماء ضاحكة البر","قِ وقد حثَّها حداءُ الرعد",78,"د",1,0],["وَقَطَّعَ الشَّكُّ أسباباً نَلوذ ُ بِها","في عاصِفٍ لم يَدَعْ مِن خَيمَةٍ طُنُبا",79,"ب",2,0],["وقطعت ما بين الشظا وتصاعدت","زفرات وجد من ضلوع القمهد",80,"د",1,0],["وقطعْتُ الزَّمانَ بالصِّدقِ فيهم","وقطعْتُ الفُؤادَ عمَّا وعَمَّا",81,"م",2,0],["وقطْراتٌ من الماءِ يمنُّ","بها الغُلُّ من الجمرِ أحَرُّ",82,"ر",1,0],["وقطعْتَ أنوار الفَخار بأنمُل ال","فِتيان من روضِ الجديد الأخضرِ",83,"ر",1,0],["وقطعْتُ من كلِّ الأنامِ علائِقي","ووصَلْتُ فيه وفي بَنيه حِبالي",84,"ل",2,0],["وقَطوفٍ من جُمانٍ ذُلِّلَتْ","عزَّ كلَّ العزِّ مُستَحلي جَناها",85,"ا",3,0],["وقطت بأطراف الرماح مطارف","عليه وغطت بالسيوف جيوب",86,"ب",1,0],["وقَطَّعَ أَنْساعَ الرَّواحِلِ رَاجِلٌ","وكَسَّرَ أَقْتاباً مِن الرَّحْلِ رَاكِبُهْ",87,"ب",2,0],["وقطعتَ في أَرَبٍ بهيماً مظلماً","وركبتَ في طَلَبٍ أغرَّ مُحَجَّلا",88,"ل",2,0],["وَقَطّع عنّي معشري وأصادِقي","وَشَملُ اِمرئٍ فاتَ الرّدى متقطّعُ",89,"ع",1,0],["وقطّع أقرانَ الورى دون همِّهِ","وَلَن تقطَعَ الأقدارُ ما كان نائطا",90,"ط",2,0],["وَقَطيعةٍ ما كُنتُ أَحذَرها","إلّا عَليك فلم يَفِدْ حِذْري",91,"ر",2,0],["وقطّعت الأسبابَ بينِي وبينها","ولَو كنتُ خِلْواً من هواها قطعتُها",92,"ت",3,0],["وَقَطَعتُ بِالعَزماءِ أَقرانَ الصِبا","وَحَلَلتُ مَنزِلَ نُهيَةً وَرَشادِ",93,"د",1,0],["وقطعُ ذوي الألبابِ عشق مراتب","من العالم الأدنى ويُسلبن كالسحرِ",94,"ر",1,0],["وقطَّبتْ عندَ زَجرِ الصَبِّ حاجِبَها","لأنَّها تَعهَدُ التأكيدَ بالنُّونِ",95,"ن",1,0],["وقطوفها تدنو لقاطفها فلا","يبقى بمصر عن جناها قاصر",96,"ر",1,0],["وَقُطب لَما أَنكَر العَصر حَولَه","وَسارَت بِما لا يَشتَهيه شئون",97,"ن",1,0],["وَقَطفتَ مِن ثمَرِ العلوم فواكها","وَعقود درّ سَبكُها منظومُ",98,"م",1,0],["وقطّعوا أرحامَه بعدَهُ","فسوف يُجزون بما قطّعوا",99,"ع",3,0],["وَقطع الرَجا مِن ذي الوَفا متعذِّرٌ","وَأَنتَ أَميرٌ لِلمَطامع غالب",100,"ب",1,0],["وقُطّعتِ الأرحامُ بيني وبينهم","وجُوزيتُ عن عُرفِ الصّنائعِ بالنُّكرِ",101,"ر",1,0],["وقُطِّعَ منّي ما أُمرتُ بوصلِهِ","وأحلالُ أبعادِ القرابةِ يَحرُمُ",102,"م",1,0],["وقَطْعَ الدُّجى ورماحُ البطونِ","مركوزةٌ في تراسِ الظهور",103,"ر",1,0],["وقطعنا مشافرها وخفنا","أجرتها فما اجترت بعود",104,"د",1,0],["وقطع الشعر حتى ود أكثرنا","أن اللسان الذي في فيه مقطوع",105,"ع",1,0],["وقطع الأحشاء والأوصالا","حتى بجوره عليّ مالا",106,"ل",2,0],["وقطع أمعاء القريض لهوله","ورد القوافي وهي سود العمائم",107,"م",1,0],["وَقَطَّعَ ذو الفَقارِ فَقارَهُم بِال","ظباةِ وَلا فُلولَ وَلا كُلولا",108,"ل",2,0],["وقطعتم حبل اتصالي بينكم","فهلا عليكم غذ قطعتم وصلتم",109,"م",1,0],["وَقَطَعْتُ بَحْرَ دُجَائِهَا وَهِلاَلُهَا","مَا بَيْنَ فُلْكِ نُجُومِهَا كَالزَّوْرَقِ",110,"ق",1,0],["وقطع أوصاله وهو في","الحياة لسان لها مفصل",111,"ل",1,0],["وقطِّع من النار أثوابهم","فقد آن تقطيعُ أثوابها",112,"ب",3,0],["وقطعت ما بيني وبي","ن الأرض من صلة وود",113,"د",1,0],["وَقَطر النَدى خافٍ عَلى الحس وَقعه","يحوك مِن الأَزهار وَشياً محبرا",114,"ر",2,1],["وقطرةٌ منه تكفي الخلقَ لو طعموا","فيشطَحونَ على الأكوان بالتيه",115,"ي",2,0],["وقطع ثوبه وكشط جلده","ورجمه إذا زنى وجلده",116,"ه",1,0],["وقطر البقاع اعتزّ في وجه شبله","خليل العلا ذاك الشهاب المنوّرُ",117,"ر",1,0],["وقَطَعْتُ مُسْوَدَّ اللَّيالي أَبيضاً","في وَصْلِ مُبْيَضِّ المجرَّ