{"poems":[[65,"سواي يجر هفوته التظني","https://www.aldiwan.net/poem45941.html","الوافر"],[49,"أما لجميل عندكن ثواب","https://www.aldiwan.net/poem25376.html","الطويل"],[87,"جلوسك أم سلام العالمينا","https://www.aldiwan.net/poem7798.html","الوافر"],[47,"نفست قربها علينا كنود","https://www.aldiwan.net/poem62739.html","الخفيف"],[47,"ما تقضى لبانة عند لبنى","https://www.aldiwan.net/poem66658.html","الخفيف"],[82,"عسى للصبا علم برسم المعالم","https://www.aldiwan.net/poem31293.html","الطويل"],[107,"أعد الرجاء وجدد الأملا","https://www.aldiwan.net/poem42045.html","أحذ الكامل"],[41,"إن الفؤاد للبائن الغرد","https://www.aldiwan.net/poem53795.html","البسيط"],[48,"أزول وليس في الخلاق شك","https://www.aldiwan.net/poem23073.html","الوافر"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54195","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54260","البسيط"],[102,"نحن والحاكمون","https://www.poetsgate.com/ViewPoem.aspx?id=50118",""],[173,"إلام أناجي قلب حيران واجم","https://www.aldiwan.net/poem1668.html",""],[275,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[333,"بين همس الشفاه والأحداق","https://www.aldiwan.net/poem55024.html","الخفيف"],[371,"وأغيد شق لي فيه قميص تقى","https://www.aldiwan.net/poem16915.html","البسيط"],[409,"خطب عظيم فمنه الدمع ينحدر","https://www.aldiwan.net/poem33929.html","البسيط"],[449,"جنى قوم على الدنيا","https://www.aldiwan.net/poem55978.html","عموديه"],[463,"ليل السرى مثل نهار المقام","https://www.aldiwan.net/poem55886.html","السريع"],[463,"هل لكما من عِلمِ","https://www.aldiwan.net/poem55896.html","مجزوء الرجز"],[543,"يا من تكفل لمن دعاه","https://www.aldiwan.net/poem47447.html","عموديه"],[567,"أبكى الشيوخ بني تلحوق مرتحل","https://www.aldiwan.net/poem52551.html","البسيط"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72325","الطويل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80207","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55907","المجتث"],[1798,"","https://poetry.dctabudhabi.ae/diwan/poem/114919","الطويل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52078","السريع"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104974","السريع"],[2489,"","https://poetry.dctabudhabi.ae/diwan/poem/111230","الرجز"],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104685","السريع"],[3092,"","https://poetry.dctabudhabi.ae/diwan/poem/216356","الكان كان"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97073","الخفيف"],[4767,"علم الضاد","https://www.poetsgate.com/ViewPoem.aspx?id=178417",""],[4912,"سلاني وليس لباس السلو","https://www.poetsgate.com/ViewPoem.aspx?id=181782",""],[5183,"من قصص الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=180277",""],[5183,"الصاروخ","https://www.poetsgate.com/ViewPoem.aspx?id=180184",""],[592,"أقول هذا كله لا يعقل","https://www.poetsgate.com/ViewPoem.aspx?id=128804",""],[5751,"من منكنّ أحلى","https://www.poetsgate.com/ViewPoem.aspx?id=215030",""],[5815,"ألوان الطيف","https://www.poetsgate.com/ViewPoem.aspx?id=197798",""]],"verses":[["وَأَسْطو سَطْوَةَ الأَسَدِ المُحامِي","وَتَنْفِرُ نَفْرَةَ الرَّشَأِ الأَغَنِّ",0,"ن",1,0],["وَأَسطو وَحُبّي ثابِتٌ في صُدورِهِم","وَأَحلَمُ عَن جُهّالِهِم وَأُهابُ",1,"ب",1,0],["وأسطول رددت بغير حول","تشيِّعه الخلائق ساخرينا",2,"ن",2,0],["واسِطٌ مِن رَبيعَةَ بنِ نِزارٍ","حَيثُ تَعلو البُنى وَيَزكو العَديدُ",3,"د",1,0],["واسِطوا سُؤدُدٍ فَلَيسَ يُنادو","نَ إِلى المَجدِ مِن هُناكَ وَهَنّا",4,"ن",2,0],["وأسطارِ حزن يملأ الخدَّ خَطُّها","جراحاً بأقلام الدموع السواجمِ",5,"م",1,0],["واسْطَعْ بِدُنْيانا التي اعْتكَرَتْ","نُوراً على الأيّامِ مُتَّصِلا",6,"ل",2,0],["وَاِسطترَبَت ظُعنُهُم لَمّا اِحزَأَلَّ بِهِم","آلُ الضُحى ناشِطاً مِن داعِياتِ دَدِ",7,"د",1,0],["وَأَسطاراً تُمَثَّلُ فَوقَ طِرسٍ","وَتُطمَسُ بَعدَ ذَلِكَ أَو تُحَكُّ",8,"ك",1,0],["واسطَعي أيها المصابيحُ زُهْراً","واجعَلي شوقَنا إليك وَقودا",9,"د",2,0],["وأسْطُرٌ من تَواريخٍ مُخَلَّدةٍ","كانت لمجدِ بَني الفُصْحَى عَنَاوينَا",10,"ن",2,0],["وأسطورة من ليالي \" جديس \"","رواها إلى \" تغلب \" \" جرهمُ \"",11,"م",1,0],["وَأَسطُو عَلى أَحداثِهِ مِثلَ ما سَطا","عَلَيَّ فَتَبقى وَاهِياتِ الدَعائِمِ",12,"م",1,0],["وأسطولها المرصوفُ يحمي ثغورَها","فتأمنُ في أملاكِها فتحَ ثغرة",13,"ه",1,0],["واسطباحي لى الهوى واغتباق","ذبُلت زهرة الصبا والشباب",14,"ب",1,0],["وَأَسطُرُ الحُسنِ في عَينَيهِ واضِحَةٌ","وَزادَ إيضاحَها شَكلٌ مِنَ الهَدَبِ",15,"ب",1,0],["وأسطر أشعلت في القلب نار أسى","فالدمع منحدر والقلب مستعر",16,"ر",1,0],["واسطولا اعدوه","ليوم اسود اعمى",17,"ا",1,0],["واسطةٌ من بين هذا وذا","تكامَلَ السلكُ بها والنّظامْ",18,"م",1,0],["واسطة العقد معي","منهم وبدرُ التِّمِّ",19,"م",1,0],["واسطتي بيني وبينَ اللهِ","وبينَ خَيرِ أنبياءِ اللهِ",20,"ه",1,0],["وأسطُرُ اللَّوحِ مِن تأريخهِ نَطَقَتْ","محمودُ عند كرامِ النَّاسِ محمودُ",21,"د",1,0],["وأسطولنا أضعاف ما كان سائراً","اليهم فلا حصن لهم منه عاصم",22,"م",1,0],["وَاسطع عَلى الشضرق بِالإِفضال لامِعَةً","فَالشَمسُ في الشَرق تَهدي النور لِلنَظَرِ",23,"ر",1,0],["واسطراً منه اروت","تعطشي والغليلا",24,"ل",2,0],["وأَسطَعَ نُهَّاضٍ أَمينٍ فَقارُهُ","يعوم بصُلبٍ كالقناطر أحدبا",25,"ب",2,0],["وَاسِطَةٌ فِيهَا وَأصْلٌ لَهَا","يَعْلَمُ هَذا كَلُّ منْ يَعْقِلُ",26,"ل",1,0],["وأسطراً تحسبها أنجماً","طالعة في فلك الطرس",27,"س",1,0],["واسطة العقد التي خف بها","من جانبيها الشرف المؤبد",28,"د",1,0],["واسِطَة في جيد هذا الدَهرِ","حُسين آراء شَديد القَهرِ",29,"ر",1,0],["واسطة فيها وأصلٌ لها","ومنه هامى غيثها يهطل",30,"ل",1,0],["واسط مقام الفصاحه","بغداد دار الأذكيا",31,"ي",2,0],["وَاسِطَةٌ بَينَ الوُجُودِ وَالعَدَم","وَنَهجهَا تَشكُو الوَجَى فِيهِ القَدَم",32,"م",1,0],["واسطحوا من دم على الأرض أرضاً","وارفعوا للسماء سماء غبار",33,"ر",1,0],["واسْطَعْتَ كشفَ طلاسمٍ","بالشعر طوراً والحِكم",34,"م",1,0],["وأسطر سيناته سيرة","تسير أساطيرها كالبسوس",35,"س",1,0],["وأسطو على برعم الجلنا","ر وكفّى بروضته يسرح",36,"ح",1,0],["وأسطعت بعد تجارب وتضارب","إحكام أمرك مرهق الأفكار",37,"ر",1,0],["واسطة بوحيه يهديهمو","بما به الله الكريم ينزل",38,"ل",1,0],["وإسطنبولُ تشهدُ أنَّ حُبًّا","بَنَيناهُ بَنى للصُّبحِ شَكلا",39,"ل",2,0],["(وَاسِطْ) مَدِينَةُ عِزَّةٍ وثقافةٍ","وَالْمُلْتَقَى لِجَوانِبٍ وجِهَاتِ",40,"ت",1,0]]}