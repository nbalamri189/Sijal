{"poems":[[63,"سواي يجر هفوته التظني","https://www.aldiwan.net/poem45941.html","الوافر"],[47,"أما لجميل عندكن ثواب","https://www.aldiwan.net/poem25376.html","الطويل"],[85,"جلوسك أم سلام العالمينا","https://www.aldiwan.net/poem7798.html","الوافر"],[45,"نفست قربها علينا كنود","https://www.aldiwan.net/poem62739.html","الخفيف"],[45,"ما تقضى لبانة عند لبنى","https://www.aldiwan.net/poem66658.html","الخفيف"],[80,"عسى للصبا علم برسم المعالم","https://www.aldiwan.net/poem31293.html","الطويل"],[105,"أعد الرجاء وجدد الأملا","https://www.aldiwan.net/poem42045.html","أحذ الكامل"],[39,"إن الفؤاد للبائن الغرد","https://www.aldiwan.net/poem53795.html","البسيط"],[46,"أزول وليس في الخلاق شك","https://www.aldiwan.net/poem23073.html","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54195","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54260","البسيط"],[100,"نحن والحاكمون","https://www.poetsgate.com/ViewPoem.aspx?id=50118",""],[170,"إلام أناجي قلب حيران واجم","https://www.aldiwan.net/poem1668.html",""],[271,"طربت لرؤيا أشرقت فاضمحلت","https://www.aldiwan.net/poem35299.html","الطويل"],[329,"بين همس الشفاه والأحداق","https://www.aldiwan.net/poem55024.html","الخفيف"],[367,"وأغيد شق لي فيه قميص تقى","https://www.aldiwan.net/poem16915.html","البسيط"],[404,"خطب عظيم فمنه الدمع ينحدر","https://www.aldiwan.net/poem33929.html","البسيط"],[444,"جنى قوم على الدنيا","https://www.aldiwan.net/poem55978.html","عموديه"],[459,"ليل السرى مثل نهار المقام","https://www.aldiwan.net/poem55886.html","السريع"],[459,"هل لكما من عِلمِ","https://www.aldiwan.net/poem55896.html","مجزوء الرجز"],[539,"يا من تكفل لمن دعاه","https://www.aldiwan.net/poem47447.html","عموديه"],[563,"أبكى الشيوخ بني تلحوق مرتحل","https://www.aldiwan.net/poem52551.html","البسيط"]],"verses":[["وَأَسْطو سَطْوَةَ الأَسَدِ المُحامِي","وَتَنْفِرُ نَفْرَةَ الرَّشَأِ الأَغَنِّ",0,"ن",1,0],["وَأَسطو وَحُبّي ثابِتٌ في صُدورِهِم","وَأَحلَمُ عَن جُهّالِهِم وَأُهابُ",1,"ب",1,0],["وأسطول رددت بغير حول","تشيِّعه الخلائق ساخرينا",2,"ن",2,0],["واسِطٌ مِن رَبيعَةَ بنِ نِزارٍ","حَيثُ تَعلو البُنى وَيَزكو العَديدُ",3,"د",1,0],["واسِطوا سُؤدُدٍ فَلَيسَ يُنادو","نَ إِلى المَجدِ مِن هُناكَ وَهَنّا",4,"ن",2,0],["وأسطارِ حزن يملأ الخدَّ خَطُّها","جراحاً بأقلام الدموع السواجمِ",5,"م",1,0],["واسْطَعْ بِدُنْيانا التي اعْتكَرَتْ","نُوراً على الأيّامِ مُتَّصِلا",6,"ل",2,0],["وَاِسطترَبَت ظُعنُهُم لَمّا اِحزَأَلَّ بِهِم","آلُ الضُحى ناشِطاً مِن داعِياتِ دَدِ",7,"د",1,0],["وَأَسطاراً تُمَثَّلُ فَوقَ طِرسٍ","وَتُطمَسُ بَعدَ ذَلِكَ أَو تُحَكُّ",8,"ك",1,0],["واسطَعي أيها المصابيحُ زُهْراً","واجعَلي شوقَنا إليك وَقودا",9,"د",2,0],["وأسْطُرٌ من تَواريخٍ مُخَلَّدةٍ","كانت لمجدِ بَني الفُصْحَى عَنَاوينَا",10,"ن",2,0],["وأسطورة من ليالي \" جديس \"","رواها إلى \" تغلب \" \" جرهمُ \"",11,"م",1,0],["وَأَسطُو عَلى أَحداثِهِ مِثلَ ما سَطا","عَلَيَّ فَتَبقى وَاهِياتِ الدَعائِمِ",12,"م",1,0],["وأسطولها المرصوفُ يحمي ثغورَها","فتأمنُ في أملاكِها فتحَ ثغرة",13,"ه",1,0],["واسطباحي لى الهوى واغتباق","ذبُلت زهرة الصبا والشباب",14,"ب",1,0],["وَأَسطُرُ الحُسنِ في عَينَيهِ واضِحَةٌ","وَزادَ إيضاحَها شَكلٌ مِنَ الهَدَبِ",15,"ب",1,0],["وأسطر أشعلت في القلب نار أسى","فالدمع منحدر والقلب مستعر",16,"ر",1,0],["واسطولا اعدوه","ليوم اسود اعمى",17,"ا",1,0],["واسطةٌ من بين هذا وذا","تكامَلَ السلكُ بها والنّظامْ",18,"م",1,0],["واسطة العقد معي","منهم وبدرُ التِّمِّ",19,"م",1,0],["واسطتي بيني وبينَ اللهِ","وبينَ خَيرِ أنبياءِ اللهِ",20,"ه",1,0],["وأسطُرُ اللَّوحِ مِن تأريخهِ نَطَقَتْ","محمودُ عند كرامِ النَّاسِ محمودُ",21,"د",1,0]]}