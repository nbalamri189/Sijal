px?id=36080",""],[5307,"مرحبا يا حي فضل الله","https://www.poetsgate.com/ViewPoem.aspx?id=10545",""],[5414,"حوار مع منافق","https://www.poetsgate.com/ViewPoem.aspx?id=12929",""],[5458,"لا تدخن","https://www.poetsgate.com/ViewPoem.aspx?id=72390",""],[5561,"آثار الظل","https://www.poetsgate.com/ViewPoem.aspx?id=198219",""],[5582,"هَلْ ما عَهِدْتُ مِنَ البَشاشَةِ عائِدُ","https://www.poetsgate.com/ViewPoem.aspx?id=186883",""],[5606,"يامرحبا ترحيبة دايم الدوم","https://www.poetsgate.com/ViewPoem.aspx?id=195279",""],[5616,"إلى ممثلة","https://www.poetsgate.com/ViewPoem.aspx?id=205251",""],[5956,"يعفو لأنه مثلُنا متسامحُ","https://www.poetsgate.com/ViewPoem.aspx?id=213371",""],[6008,"من الجوف","https://www.poetsgate.com/ViewPoem.aspx?id=60806",""],[6093,"تَنَاص","https://www.poetsgate.com/ViewPoem.aspx?id=178313",""],[6115,"نوادر الشعر تشبه جمّ عذبٍ زلال","https://www.poetsgate.com/ViewPoem.aspx?id=186438",""],[6318,"مهرجان القصيد (1)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66156&r=&rc=6",""]],"verses":[["وَالمُعاوِيُّ إِذا رامَ العُلا","نَعِرُ النِّيَّةِ نَسَّالُ القَوافي",0,"ف",2,0],["والمَعَانِي قَدْ تَكُونُ لَها","كَالْغَوَانِي رَوْعَةٌ تَسْبِي",1,"ب",2,0],["وَالمَعبَدِيّاتُ لِقوّادِكُم","لا تَدخُلُ الكيسَ وَلا تُربَطُ",2,"ط",1,0],["وَالمُعتَدونَ إِذا رَأَوكَ تَخَشَّعوا","يَخشَونَ صَولَةَ ذي لُبودٍ حارِدِ",3,"د",1,0],["والمعتلي رتباً لم يفتخر بسوى","أقدامه الراءُ قبل التاء والباء",4,"ا",2,0],["والمعالي في آلِ أيوب إرثٌ","كالنبواتِ في آلِ يعقوب",5,"ب",1,0],["والمُعاب اطِّراحُك ابنك لا مَنْ","حُكَ جَنْبَيْ أخيه لِينَ مِهادِهْ",6,"د",2,0],["والمعدنيات كذا سبعة","يدركها العقل أو الحسُّ",7,"س",1,0],["والمعدنيات وأجسادها","رمز لدى القوم وتمثيلُ",8,"ل",1,0],["والمعدنيات والنبات وما","فيه حياة مما نما وحبا",9,"ب",2,0],["وَالمُعَنّى مَن تَمَنّى خالياً","نَقلَ أَخلاقيَ مِن بَعدِ الشَمَط",10,"ط",1,0],["وَالمُعجِلونَ قِرى الأَضيافِ إِن نَزِلوا","وَأَمنَعُ الناسِ يَومَ الرَوعِ جيرانا",11,"ن",2,0],["والمعالي رياضُ طَرْفِكَ والحم","دُ إذا راقَ زَهرُه رَيحانُكْ",12,"ك",1,0],["وَالمُعصِراتُ مِنَ الخِرادِ عَواصِفٌ","كَالمُعصِراتِ صَنيعُها إِعصارُ",13,"ر",1,0],["والمعتلي رتباً لم يفتخر بسوى","أقدامه الراءُ قبل التاء والياء",14,"ا",2,0],["والمعاني التي عن الكشف جلت","نكتة تستفيض من أطوارك",15,"ك",1,0],["والمعجزات تواترت","عن أحمد في كلِّ صوره",16,"ر",2,0],["والمعلى والوغد ثم سفيح","ومنيح وذي الثلاثة تهمل",17,"ل",1,0],["وَالمُعطِيانِ اِبتِغاءَ الحَمدِ مالَهُما","وَالحَمدُ لا يُشتَرى إِلّا بِأَثمانِ",18,"ن",1,0],["والمعاني مكتومة والمخازي","فلها راية وطبل وبوق",19,"ق",1,0],["والمعتلي فوقَ السماكِ أرومةً","والمزدري في الحلم بالأطواد",20,"د",1,0],["وَالمَعَرّي على الوَرى","ثائِراً في تَهَكُّمِه",21,"ه",1,0],["وَالمَعَرّي الضَرير ما زالَ حَيّاً","وَفَقيراً كانَ المَعرّي الضَريرُ",22,"ر",1,0],["والمَعْقِلِيُّونَ لَولا أنَّهُمْ عَقَلُوا","نَجَاءهم مَا نَجَوْا شِيباً وشُبَّانا",23,"ن",2,0],["والمعالى المحلِّقاتِ مع النَّس","رَيْن يُشرقنَ بُكرة ومَساءَ",24,"ا",2,0],["وَألمعيّةُ ندبٍ لا يُخادعهُ","عَنِ الحقائقِ تمويهٌ ولا وهمُ",25,"م",1,0],["والمعاني التي تلوح لفكري","لو تبدت حارت لها اللوام",26,"م",1,0],["والمَعالي أبا عليٍّ حصانٌ","حرَّةٌ لا تذِلُّ إلا لحُرِّ",27,"ر",1,0],["والمعالي ما بين فعلٍ وقَولٍ","بينَ مُستَكرهٍ إلى مستحبِّ",28,"ب",1,0],["والمعالي لا ترتضي حيث شاءت","غير أكفائها الكرام بعولا",29,"ل",2,0],["والمعالِي مثلُ الرماحِ ففيها","رُتَبٌ من سَوَافلٍ وعَوالِ",30,"ل",1,0],["والمَعبَرُ المُستمَدُّ منه","كالرّقْمِ في جانب المُلاءِ",31,"ا",2,0],["والمُعتَلى شرفاً يودّ","النجمُ جَهداً أن يكونَهْ",32,"ن",2,0],["والمعهَدُ المعهودُ من","حالِ الرِضا والغضَبِ",33,"ب",1,0],["والمعالي أنك استحليتها","طُعْمةً في سَنةٍ مرَّ جَناها",34,"ا",3,0],["والمُعَنَّى بأحاديثِ غدٍ","وبطيب الذكر مكدودٌ معنَّى",35,"ن",2,0],["والمعاني زينت بهن المعالي","فهي وشيٌ لعطفها ورقوم",36,"م",1,0],["والمعلمون وعظم الخيل لاحقة","مبتوتة كعجيم ترَّ عّنْ جَرَمِ",37,"م",1,0],["والمَعاني التي طَواها فُؤادي","قسَماً هزَّ من فُؤادي قسْمَا",38,"م",2,0],["والمُعْصَراتِ دَماً نَقيعاً أحْمَراً","من مُقْلَتي وزَفيرِ شَبَّةِ ناري",39,"ر",2,0],["والمَعالي قد حازَ منها المَزايا","وسواهُ ألقابُ تلكَ المَعالي",40,"ل",2,0],["والمعجلو الجُرْدِ العِتاقِ ولا ال","أَرْسانُ تمسكها ولا الجُدُلُ",41,"ل",1,0],["وَالمُعتلي قِمم العَلاء بهمّةٍ","قامَتْ وهمّاتُ الرّجالِ قُعودُ",42,"د",1,0],["والمعافى منْ لم يَقُدْه إلى اللّو","عةِ يوماً تفرّقُ الأحبابِ",43,"ب",1,0],["والمعاني كلها منا وعن","شاخصِ الإسم لشمس الذات فَيّ",44,"ي",1,0],["والمعاني التي تلوح وتخفى","من جميع الأنواع والألوان",45,"ن",1,0],["والمعالي والفخر والمجد فينا","والمزايا والعز والإحتشام",46,"م",1,0],["والمعاني كلها قاصرة","عنه والجرح عليه ما اندمل",47,"ل",1,0],["والمعاني كثيرة من ضلالٍ","وهدىً لكن الصواب قليل",48,"ل",1,0],["والمعاني جميعها لمحات","لبطون المنى بها إظهار",49,"ر",1,0],["والمعالي تَزينُ بعضاً وبعضٌ","تقتضي شَيْنَ عِرضِهِ فيُمزَّقْ",50,"ق",1,0],["والمَعالي اِبتهجت واِستبشرت","فَترى أفراحها ملء الصدورِ",51,"ر",1,0],["والمعالي تطيب إِن يقضِ يوماً","هيَ كانت على كمالي شُهودا",52,"د",2,0],["وَالمَعالي لَما بَدَت أَرّختها","خلقت زَينَب لأمّ بَهيّهْ",53,"ي",2,0],["وَالمعافاة مِن سِهام أَصابَت","مُهجَتي مِن قسيِّها كَالنبال",54,"ل",1,0],["والمعظمي أَسبابَ جا","رِهِمُ لإعظامِ الجوار",55,"ر",1,0],["وَالمَعالي وَأَهلُها مِثل جِسمٍ","هوَ فيهِ كَالرّوحِ ثمَّ الجنانِ",56,"ن",1,0],["والمعدِنُ الذي اختفى","تحتَ الغبارِ ناصِعُ",57,"ع",1,0],["والمعاني اللائي انى أنشدت","كلمات تسمع الصم الدعا",58,"ع",2,0],["والمعاني التي الصبا يستعي","ر اللطف منها والرقة الجريال",59,"ل",1,0],["والمعلنين لكِلَّمة التوحيد وال","معلين واجبها بأسمرَ عاسِلِ",60,"ل",1,0],["وألمع من فوق المجرة أبيضا","وأركب من فرع الأدجنة أدهما",61,"م",2,0],["والمعجمين حروف الجسم إذ كتبت","أقلام أرماحهم سطر الرزبات",62,"ت",1,0],["وألمع في أفق العلا برق أبيض","به ينجلي ليل من البغي معتم",63,"م",1,0],["والمعجمون حروف الجسم إن كتبت","رماحهم صحفا فيها البليات",64,"ت",1,0],["والمعاني ببابه موثقات","ترتجى حل قيدها من وثاق",65,"ق",1,0],["وَالمُعْرَبِ المعَرُوفِ لا اللجْلاجِ","وَكَسراتِ الحاجِبِ الخَلّاجِ",66,"ج",1,0],["وأَلْمعيَّةُ قَلْبٍ","على الغُيوبِ بمَرْصَدْ",67,"د",1,0],["والمعاني إذا تجلت بمرأى","للنهى قابلته عينا بحس",68,"س",1,0],["والمعاني إذا تجلت بقلب","كاد من فرط ما تلقى يطير",69,"ر",1,0],["وأل مع المفرد والمضاف","والعطف والتركيب غير خاف",70,"ف",1,0],["وَالمِعصان فَما يُرى لَهُما","مِن فَعمَةٍ وَبَضاضَةٍ زَندُ",71,"د",1,0],["والمُعَنَّى في غَيّه مُسْتَلذٌّ","بغرُورِ كلَذّةِ المجْروبِ",72,"ب",1,0],["والمعتفى فعَلاتِ السّالفين له","في حذو ما أَثروه فعل غيرانا",73,"ن",2,0],["وَالمُعْتَلِي لِلرُّومِ فِي رَجْرَاجَةٍ","عَاذَتْ بِهَا غُرُّ الفُتُوحِ عِيَاذَا",74,"ذ",2,0],["والمعالى توجعت نادبات","وبكته الغداة دنيا ودينُ",75,"ن",1,0],["والمعالي هنِّها أن سَتجد","منه في أُفقِ سناها شُهبا",76,"ب",2,0],["والمعالي ليُهنها أن تُقضّوا","طرباً في وِصالها الأوطارا",77,"ر",2,0],["والمعالي حسناءُ فاخطب وَلاها","واعطها من فضائل النفس مَهرا",78,"ر",2,0],["والمعرضُ الوطنيُّ ق","ام بوجهها إنسانُ ناظرْ",79,"ر",1,0],["والمعجِزاتِ اللاتِ أَعجَزَ ذِكرُها","ذِكرَ الحَكيمِ مَصاقِعِ البُلَغاءِ",80,"ا",2,0],["والمعالى سعودها قال أرخ","ختن عبد الهادى بحزبى وأحمد",81,"د",1,0],["والمعالي إذا تراءت لحرٍّ","فله صَبوة بها ونزوع",82,"ع",1,0],["وَالمِعصمان فَما يُرى لَهُما","مِن نَعمَةٍ وَبَضاضَةٍ زَندُ",83,"د",1,0],["والمعمل الرأي غدا","في عصمة من الزلل",84,"ل",1,0],["والمعالي كُلٌّ يراها وما يسم","وإليها غير الأغرِّ النَّخِيِّ",85,"ي",1,0],["والمعمل البيض الرقاق والقنا","إذا اكتنى في مأزق واشتهرا",86,"ر",2,0],["والمعالي لم ينل من وصلها","سؤلهُ من للدنايا وصلا",87,"ل",2,0],["والمعصمان فان تشأ شبههما","بسبيكتين عليهما كفان",88,"ن",1,0],["والمعنوي منه كالتسهيم","والجمع والتفريق والتقسيم",89,"م",1,0],["والمعاني لمن عنيت ولكن","بك عرضت فاسمعي يا جاره",90,"ر",2,0],["والمُعَانَاةُ في الأمُورِ كِفَاحٌ","عِندنا أحلى من كؤوس الرَّاحِ",91,"ح",1,0],["والمعاني بلفظه صرنَ لفظاً","ظاهراً والألفاظُ صارَت معاني",92,"ن",2,0],["والمعجزات بدت بصدق رسوله","وحقيقه بالمأثرات خليقه",93,"ق",2,0],["والمعقلُ المعروفُ والسهيلُ","هُم أَربَعٌ ونصفُ يا خليلُ",94,"ل",1,0],["والمَعقِلُ المشهورُ والسهيلُ","خَمسٌ ونصفٌ ليسَ فيهِ مَيلُ",95,"ل",1,0],["وَالمَعقِلُ المَذكُورُ وَالمرَبَّع","مَسيرُهُم كَالجَاهِ إصبَع بآصبَع",96,"ع",1,0],["والمعالي قالت وقد أرخته","بشر الأ