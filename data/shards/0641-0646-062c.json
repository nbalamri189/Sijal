"فِي الْمَقْهَى","https://www.poetsgate.com/ViewPoem.aspx?id=196939",""],[5720,"نَفَحَات","https://www.poetsgate.com/ViewPoem.aspx?id=204565",""],[5720,"سَتَصْلَاهُمْ جَهَنَّمُ","https://www.poetsgate.com/ViewPoem.aspx?id=204856",""],[5731,"تركت القريض لمن قَالَه","https://www.poetsgate.com/ViewPoem.aspx?id=189923",""],[5732,"يا بعد فرق الناس","https://www.poetsgate.com/ViewPoem.aspx?id=177919",""],[5732,"ينام منهو مايعرف الهمومي","https://www.poetsgate.com/ViewPoem.aspx?id=177856",""],[5732,"لزيت نفسي مير عيت تلزا","https://www.poetsgate.com/ViewPoem.aspx?id=177849",""],[5732,"يقول من عدا على رأس عالي","https://www.poetsgate.com/ViewPoem.aspx?id=34388",""],[402,"فنجانة أبرز في صنعها","https://www.poetsgate.com/ViewPoem.aspx?id=36158",""],[402,"بحمدون إن تنشق عليل نسيمها","https://www.poetsgate.com/ViewPoem.aspx?id=36323",""],[5829,"ما سواها زائل","https://www.poetsgate.com/ViewPoem.aspx?id=204861",""],[5953,"قد مسني الشيطان يا سيدي","https://www.poetsgate.com/ViewPoem.aspx?id=93882",""],[5956,"حبل اللقاء","https://www.poetsgate.com/ViewPoem.aspx?id=181965",""],[3304,"حواء أم جنية البحر","https://www.poetsgate.com/ViewPoem.aspx?id=135617",""],[6142,"حشدوا كل واحدٍ من قبيلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155696",""],[6234,"الربيع الفاتن في نجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=6538&r=&rc=5",""]],"verses":[["فنِجادُ سَيْفي مَسَّ ثِنْيَ وِشاحِها","بمَضاجِعٍ كَرُمَتْ وعَفَّ المِئْزَرُ",0,"ر",1,0],["فَنَجرانَ فَالسَروَ مِن حِميَرٍ","فَأَيَّ مَرامٍ لَهُ لَم أَرُم",1,"م",1,0],["فَنَجْدٌ إِلَى نَجْدٍ تَسَامَى فَهَضْبَةٌ","إِلَى هَضْبَةٍ وَالطَّوْدُ لِلطَّوْدِ سُلَّمُ",2,"م",1,0],["فنجوتَ من أيدي الأخابثِ سالماً","ورهنتَهم لهفاً عليك طويلا",3,"ل",2,0],["فَنَجا الداخِلُ سَبخاً بِالفُرات","تارِكَ الفِتنَةِ تَطغى وَتَنور",4,"ر",1,0],["فَنَجا وَلَو يَثقَفنَهُ لَتَرَكنَهُ","بِالقاعِ غَيرَ مُوَصَّلِ الأَوصالِ",5,"ل",1,0],["فَنَجتَنِبُ المَقاذِعَ حَيثُ كانَت","وَنَكتَسِبُ العَلاءَ مَعَ الكَسوبِ",6,"ب",1,0],["فنَجْزِيهَا على الحُسنى وأهْلٌ","لما ظَنّتْ خَلائقُك الحِسانُ",7,"ن",1,0],["فَنَجدَي مَريعِ فَوادِي الرَجاءِ","إِلى الخانِقَينِ إِلى أَخرُبِ",8,"ب",1,0],["فنجت بالفرار من مخلب الصق","رِ كعصفور بعد أَن ريع طارا",9,"ر",2,0],["فنجا الدّاخل سبحاً بالفرات","تارك الفتنة تطغى وتنور",10,"ر",1,0],["فِنْجَانَةٌ أَبْرَزَ فِي صُنْعِهَا","دِهْقَانُهَا فَنَّاً بدِيعَ المِثَالِ",11,"ل",1,1],["فنجيبٌ أطَلَّ منه هلالاً","ثم آوى إليه بعد الكمال",12,"ل",1,0],["فَنُجوم نَهديك لِلراح شُرباً","وَنُجوم عَلى الوُشاة رُجوم",13,"م",1,0],["فنجا وكيف نجاة قائد جحفل","متمطراً بطمرّة ولجام",14,"م",1,0],["فَنَجا وَصَدرُ الأَشرَفِيَّةِ واغِرٌ","مِنهُ وَقَلبُ الزاغِبِيَّةِ مُحنِقُ",15,"ق",1,0],["فنجيبٌ ذو حرمةٍ في البرايا","هي أحرى ياموتُ أن ترعاها",16,"ا",3,0],["فنجِّني من خطب دَهرٍ غدا","لِلجسم منّي أَبَداً يَنهَسُ",17,"س",1,0],["فنَجِّني يا فدتكَ النَفسُ من بَلَدٍ","أَضحت لِقاحُ العُلى فيهِ مَقاليتا",18,"ت",2,0],["فنجدة السلوان مهزومةٌ","إن رجع الوجد بلا حرب",19,"ب",1,0],["فَنجومٌ راقَت صعودك رجباً","فَرَقت منكَ أوجَ برجِ السعودِ",20,"د",1,0],["فنجانها بالمصطكي","جاء بلون عاجب",21,"ب",1,0],["فنجانها بالمصطكي","إذ جاء في لون عجب",22,"ب",1,0],["فَنجمك في بُرجِ السَعادَةِ بالِغٍ","وَمَجدك في أَعلى المَنازِلِ صاعِدُ",23,"د",1,0],["فنجَّت البُقيا عليهم من نجا","وأكلَ الحديدُ منهم من أكلْ",24,"ل",1,0],["فنجاحُهُ في كل مُطَّلَبٍ","فرضٌ على الأيام والدهرِ",25,"ر",1,0],["فنَجدةُ سُلطانِ الزمانِ وجُودُه","أجابا فولَّى ذُعْرُها وهُيامُها",26,"م",3,0],["فنجرٌ يباري مطلعَ الشمس بالضحى","وسعْيٌ أريجُ الذِّكر جمُّ المَناقب",27,"ب",1,0],["فنجم الدياجي قد أعار جفونه","لصب لدى الأطلال سهده دائم",28,"م",1,0],["فَنَجَّاهُ مِنِّي أَكلُهُ وَشَبَابُهُ","وَأنَّى شَيخٌ لَم أكُن مُتَمَاسِكَا",29,"ك",2,0],["فَنَجِّهِ سالِماً مِن شَرِّ دَعوَتِنا","وَمُهرَهُ مُطلَقاً مِن كَلمِ آثارِ",30,"ر",1,0],["فنجوتَ منها وهي بَرْ","دٌ لا يَضيرك أو سلامُ",31,"م",1,0],["فنجاتي بسيد الرسل طه","وبكائي أسبطه الظمان",32,"ن",1,0],["فنُجوا وإبراهيمُ يأمُرُ نفسَه","بالكَرِّ لا بالفَرِّ خوفَ العار",33,"ر",1,0],["فنجادِ توضَح فالنضائدِ فالشَّظا","فرياضِ سَنْحةَ فالنَّقا من جَوْنَبِ",34,"ب",1,0],["فَنُجُوْمُهُ زُهْرٌ ثَوَابِتُ لم يَرِمْ","تَعْدِيْلَها زِيْجٌ ولا قانونُ",35,"ن",1,0],["فنجا به الملك الكبير من الأذى","وتهلل الإسلام بعد بكائه",36,"ا",3,0],["فَنَجلاهُ نَجما السَعدِ والرُشدِ والعُلا","وآثارُهم للمَكرُماتِ مَنَارُها",37,"ر",3,0],["فَنَجع الدَوا بِإِذن رَبّي","وَحادَ ما قَد حَلَّ بي من كَربي",38,"ي",1,0],["فنجمك مسعود وعمرك سالم","وخصمك مجدولٌ بقدرة قادر",39,"ر",1,0],["فَنَجَوتَ لِلصَّحراءِ مِن","صَخَبِ المَزاهِرِ وَالزُمورِ",40,"ر",1,0],["فَنجومه زهر وَإِن شموسه","بهر وان بدوره لا تمحق",41,"ق",1,0],["فَنُجومُ العِلمِ وَالفَه","مِ تَهاوَت لِلغُروبِ",42,"ب",1,0],["فَنَجعل آدابه شرعة","وَلا نتَعَدى لَها معلما",43,"م",2,0],["فنجاحهم بوُلاتهم ونجاحهم","بسراتهم ونجاحهم بذواتهم",44,"م",1,0],["فنج من عدلك من يخشاه","بحقّ لا إله إلا اللّه",45,"ه",1,0],["فنجمُ الانس قد لاحا","بأَنوارٍ",46,"ر",1,0],["فنجت فارس بإحكام سعدٍ","وابن قيس من شرِّ ملكٍ عقيم",47,"م",1,0],["فَنَجا يَهمُزُ جَنبَي مُهرِهِ","وَقَناتي في قَفاة كَالشَطَن",48,"ن",1,0],["فَنَجا وَمُقلَتُهُ يُقَسِّمُ لَحظُها","فَنَّينِ بَينَ أَخادِعِ وَنُخاعِ",49,"ع",1,0],["فنجاة عمرو بالمذلة سُبَّةٌ","والفخر قَيلُ ربيعة بن مكدَّم",50,"م",1,0],["فنجا من الأمر الذي قد ضرَّه","عما أتاه به النبيُّ الأعدل",51,"ل",1,0],["فَنَجِيبُ بِالتَركِيبِ حِينَئِذٍ جَوَا","باً شَافِياَ فِيهَ هُدَى الحَيرَانِ",52,"ن",1,0],["فنجا وما زوَّدتُ من","هُ سوى التّزفر والصّدوع",53,"ع",1,0],["فَنجد فيكَ عادَت وَهِيَ مصر","وَأَنتَ خَصيبها وَيَداك نيل",54,"ل",1,0],["فَنَجمُ السَعودِ اِنثَنى آفِلاً","وَبُرجُ الصُعودِ ثَوى في الصَعيدِ",55,"د",1,0],["فنجم سعودي للسعادة يا مكائدي","لما أسهم فيمن رمينا صوائب",56,"ب",1,0],["فنجذبها رفقاً بنا وتجرّنا","إليكم من الشوق الذي اكتسبت منا",57,"ن",2,0],["فَنَجَوْتَ مِنْ أَرْمَاحِهِمْ مِنْ بَعْدِ مَا","جَاشَتْ إِلَيْكَ النَّفْسُ عِنْدَ الْمَأْزِمِ",58,"م",1,0],["فنجت خزانتها الَّتي قد اودَعت","فيها القلوبَ فصحتُ اينَ فؤادي",59,"ي",1,0],["فَنَجّى بِها حَوباءَ نَفسٍ كَريمَةٍ","وَقَد كادَ لَولا ذاكَ فيهِم يُقَطَّعُ",60,"ع",1,0],["فنجت وصحت بالعلاج وأصبحت","برعاية الإسعاف تحمد حالها",61,"ل",3,0],["فنجا بمهجته فلولا ذبنا","عنه تنشبَ في مخالبِ ضار",62,"ر",1,0],["فنجا الشبوب وثبته","نَ عليه بث الانتقامِ",63,"م",1,0],["فنجتْ محاذرةَ الحتوفِ وأوجستْ","رِكزاً فأقبل بالنّحاف رغامُها",64,"م",3,0],["فنجِّنا من كرباتْ","هذي الحياة والمماتْ",65,"ت",1,0],["فنجِّنا ربِّ من الأعداءِ","وكثِّرَنْ أرزاقَنا في الجائي",66,"ي",1,0],["فنجِّني والذي معي بلا محن","ومن نسبت لنا فلا نرى مِحَنا",67,"ن",2,0],["فَنَجِّهِمِ وما الأَربابُ طُراًّ","بِراضِيةٍ وإِن صَمَتُوا احتٍراما",68,"م",2,0],["فنجا ولكن صدره انتفضا","وأخيل صاح ودونه اعترضا",69,"ض",2,0],["فَنَجَدتهُم جَهدِي وأَلفَيتُ الزَّما","نَ بِمثلهِم في الرَّوعِ كانَ ضَنِينا",70,"ن",2,0],["فَنُجَشمِّ الطُّروَادَ قَبلَ مآبِنا","مَضَضاً يُذِيقُهُمُ النَّكالَ مُؤَبَّدا",71,"ا",1,0],["فنجزع ان يتلى الوعيد حوالنا","ونفرح حينا ان تلا الوعد من يتلو",72,"ل",2,0],["فن جفاه أو لان معطفه","فحظه يا حسنه ما ألطفه",73,"ه",1,0],["فنجانه الأبيض لما حوى","قهوة بن للدجى تحكي",74,"ي",1,1],["فنجلاك في مصر يذوبان لوعةً","ونجلاك في بيروت تنحب نائحه",75,"ح",2,0],["فنجا من دان فيها نفسه","عاد بالخسران جمع المسرفين",76,"ن",1,0],["فنجز الوفا بالعهد بعد انقضائهِ","فلم يكُ كالإيفاءِ منق بل وعدةِ",77,"ه",1,0],["فنجا الرسوُل ومن تجمهر عنده","فوق السنين وأُغرق الكفَّارُ",78,"ر",1,0],["فَنَجَا جريحاً مع رجالٍ ستة","وصحارُ فيها قبرُهُ المعطار",78,"ر",1,0],["فنجا من الشرك الكثي","ف مجرد العزمات مفرد",79,"د",1,0],["فنجيد في عبد المجيد تعازيا","ونعيد في عبد العزيز تهانيا",80,"ي",2,0],["فنجاره ما زال ملجأ لاجئ","يلقي الأماني عنده والسولا",81,"ل",2,0],["فنجوم عزك ليس تأفل ما بدا","قمر وشمس سعودكم لا تغرب",82,"ب",1,0],["فنجمك الذي أضاء في سَما","ئِه بدا بنوره مُحلِّقا",83,"ق",2,0],["فنجمُ القاسمِ الأبهَى جمالاً","إذا ما قيسَ بدرٌ أو شهاب",84,"ب",1,0],["فنجال همك على شانك تقهويته","متى متى بالوصل تقدر تقهويني",85,"ن",2,0],["فنجانها اﻻول على حد صقيل","من ﻻزمه في قبضة ما ندمها",86,"م",3,0],["فنجّنا ربّنا من كلِّ عاديةٍ","ومن شرور نفوسٍ نام قاضيها",87,"ي",3,0],["فَنَجْرِيْ دُوْنَ مَاْ وَعْيٍ","وَلاْ نَجْنِيْ سِوَى التَّعَبِ",88,"ب",1,0],["فنجانُ قهوتك الصفراء ذو جرسٍ","لقرعه تُوقَظُ الأشواقُ والجمرُ",89,"ر",1,0],["فنَجمعُ ما تفرّق مِنْ جُسومٍ","ونَنشرُ ما طوينا مِن عُهودِ؟!",90,"د",1,0],["فنجانه الثاني تجرّعه","وتجرّع الإسمنت والحجرا",91,"ر",2,0],["فنجال منها من الغفله يصحيني","من طبها مايزول الهم في باله",92,"ل",2,0],["فنجْهلُ مرَّاتٍ ونرْشُدُ مرَّةً","عَسَى ساترُ الزَّلَّاتِ يَعْفُو ويَغْفِرُ",93,"ر",1,0],["فنجاة الخاتم الماحي الذي","قلبه مهبط آيات السور",94,"ر",1,0],["فنجانُ قهوتِهِ بهِ غَزَلٌ","مِنْ سُكَّرِ الأشواقِ حلّاهُ",95,"ا",2,0],["فنجانُها في كَفِّها ثَمِلُ","مِثلي ولكنْ حَظُّهُ القُبَلُ",96,"ل",1,1],["فنجان صافيةٍ رمى فكرَهْ","كالنرد يرمي للنوى زهرَهْ",97,"ر",2,1],["فنجاني الخالي على حُزْنٍ","والقهوة السوداء مسترَّهْ",97,"ر",2,0],["فنجانُ لوعتيَ السمراءَ يسكبني","نهرَ انتظارٍ لمنْ مرُّوا ولمْ يصلوا",98,"ل",3,0],["فنجان القهوة ينشيني","وسيجارة كنت تغريني",99,"ن",2,1],["فنجعل من ندعوه واسطةً لنا","ليشفع عن الله في كل ما نبدي",100,"د",2,0],["فنجال قهوه مع تعاليل وهروج","مع إتساع حجاج ست الحبايب..",101,"ب",1,1],["فنجاحك فخرٌ زاد بنا","فُتحتْ بالعزِّ معاهده",102,"د",2,0],["فنجومها دارت على ولهٍ","هامت وضلّ الوجد مسعاه !!",103,"ا",2,0],["فنجان من قهوة البن مسقاي","مصقول من دلة بعد دله",104,"ل",2,0],["فنجاني المقلوبُ فيهِ حكايتي","فخذيهِ مني واقرأيهِ وفسري",105,"ر",2,0],["فنجومُ السماءِ تبقى نجوما","ورخامُ القبورِ فيها الحِمام",106,"م",1,0],["فِنْجَانُ الْقَهْوَةِ فِي يَدِهِ","تَشْتَاقُ إِلَيْهِ قُبْلَتُهُ",107,"ت",2,0],["فَنَجْمَعُ مِنْ رُبَهَا الزَّهْ","رَ مَمْزُوْجَاً رَيَاحِيْنَا",108,"ن",2,0],["فَنَجْعَلُ مَا جَنَوْا نَارَاً عَلَيْهِمْ","وَمَا فَعَلُوْهُ حَزْمَاً لَنْ يَلِيْنَا",109,"ن",2,0],["فنجل ابْن نَبهَان يَرْجُو الأله","يمحص عَنهُ الَّذِي قَالَه",110,"ل",2,0],["فنجال يغدي ما تصور على البال","يزيل هم بالفواد امتخفي",111,"ف",2,0],["فنجال بن مايحضره رخومي","مبهرن مابين الاجواد مقسوم",112,"م",1,0],["فنجالهن بين الشفايا يمزا","اشقر ومشروبه عن الخمر يمتاز",113,"ز",1,0],["فنجال يغدي ماتصور اببالي","روابع ناخذ بها اخماس واسداس",114,"س",1,0],["فنجانة أبرز في صنعها","دهفانها فنا بديع المثال",115,"ل",1,1],["فنجد إلى نجد تسامى فهضبة","إلى ضبة والطود للطود سلم",116,"م",1,0],["فنجاة نفسك تركها شهوتها","وهواك فاعلم: كل أمر باطل",117,"ل",1,0],["فنجني من كيده إنه","أذم مرجوم ومحصوب",118,"ب",1,0],["فنجوم الكون أدنى لك من حبل اللقاءْ","فجرى الدمعُ من العين التي ترعى الوفاء",119,"ا",2,0],["فنجوت منه وإنما عجبٌ","رائيك يغرقُ وهو في البر",120,"ر",1,0],["فنجا منهم بوضع أخيه المر","تَضى في فراشه الممهود",121,"د",1,0],["فنجد لبنان في فصل الربيع لذا","أمسى الجمال لنجد اليوم منسوبا",122,"ب",2,0]]}