{"poems":[[438,"تنفس الروض عن نواره الأرج","https://www.aldiwan.net/poem12315.html","البسيط"],[510,"البديل","https://www.aldiwan.net/poem56766.html","مخلع البسيط"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69351","البسيط"],[3334,"","https://poetry.dctabudhabi.ae/diwan/poem/31454",""],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135839","الرجز"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45113","الوافر"],[5431,"ألا أيها الكرب اليماني لاتطل","https://www.poetsgate.com/ViewPoem.aspx?id=188616",""]],"verses":[["وقاصِدٍ قَدْ تَلَقَّى السَّيْرَ نَحْوَكُمُ","بِحَمْدِ مُبْتَكِرٍ مِنْهُ ومُدَّلِجِ",0,"ج",1,0],["وقاصدُ السّهمِ لا يخيبُ","ودامعُ العيْنِ لا يَشوبُ",1,"ب",1,0],["وَقاصِفُ الرَّعدِ يُنادِي بهَلا","لَم تَرَ كالمُزنِ سَوَاماً بُهَّلا",2,"ل",2,0],["وَقاصِدٌ خَيرَ مَقصودٍ وَمُنتَجِعٌ","ريفَ العَزيزَينِ مِن قَيسٍ وَمِن أُدَدِ",3,"د",1,0],["وقاصد البغي إن لاقاه قاصده","أيضا وقد أخذ الأموال واختزلا",4,"ل",2,0],["وقاصدين ضُرَّنا فشَتِّتا","من قبلِ ضرِّنا يكونوا بُهَتا",5,"ت",2,0],["وَقاصِرَة الحِجالِ إِذا تَبَدَّت","تَرى التَقصيرَ في البيضِ القِصارِ",6,"ر",1,0],["وقاصمةٌ للعمر فيها المكائدُ","تراودنا عن نفسها وتعاودُ",7,"د",1,1]]}