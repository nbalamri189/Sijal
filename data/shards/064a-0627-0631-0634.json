{"poems":[[53,"شاب رأسي ولات حين مشيب","https://www.aldiwan.net/poem8148.html","الخفيف"],[93,"بورك الصمام من حكم","https://www.aldiwan.net/poem62717.html","عموديه"],[51,"يا رشيد الأمر أرشدني إلى","https://www.aldiwan.net/poem64151.html","الرمل"],[93,"فتنة 13 أبريل","https://www.poetsgate.com/ViewPoem.aspx?id=53245",""],[123,"يا رشأ السدرِ ولو أنني","https://www.aldiwan.net/poem4354.html","السريع"],[202,"يا رشأ مسكنه فاس","https://www.aldiwan.net/poem51936.html","السريع"],[214,"قلت مذ سل فؤادي","https://www.aldiwan.net/poem13399.html","مجزوء الرمل"],[303,"ردي علي رقادي فهو مختلس","https://www.aldiwan.net/poem36304.html","عموديه"],[358,"ويح قلبي كم يقاسي شجنا","https://www.aldiwan.net/poem40017.html","الرمل"],[366,"أيها الاهيف الذي أهواه","https://www.aldiwan.net/poem68044.html","الخفيف"],[409,"حسبك الله لم أطلت جفاكا","https://www.aldiwan.net/poem33611.html","الخفيف"],[422,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[435,"يا رشيد العلى ويا خير صدر","https://www.aldiwan.net/poem39836.html","الخفيف"],[454,"بوركت من نهضة","https://www.aldiwan.net/poem975.html",""],[511,"يا رشأ حظى إبعاده","https://www.aldiwan.net/poem2442.html","السريع"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39033","السريع"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39042","المنسرح"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39043","الرجز"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104600","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63755","السريع"],[905,"","https://poetry.dctabudhabi.ae/diwan/poem/146462","السريع"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/73970","السريع"],[1376,"","https://poetry.dctabudhabi.ae/diwan/poem/118077","المنسرح"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77857","الرمل"],[1782,"","https://poetry.dctabudhabi.ae/diwan/poem/128741","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125457","البسيط"],[1933,"","https://poetry.dctabudhabi.ae/diwan/poem/144319","الخفيف"],[2027,"","https://poetry.dctabudhabi.ae/diwan/poem/101858","الرجز"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199820","المسحوب"],[2256,"","https://poetry.dctabudhabi.ae/diwan/poem/216587",""],[2274,"","https://poetry.dctabudhabi.ae/diwan/poem/144753","السريع"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93674","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94252","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93952","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132596","الرجز"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71387","الخفيف"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97990","السريع"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108071","الخفيف"],[3778,"","https://poetry.dctabudhabi.ae/diwan/poem/89988","السريع"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86356","الرمل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86352","الرمل"],[4470,"","https://poetry.dctabudhabi.ae/diwan/poem/125356","الرجز"],[4908,"رشفة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=209088",""],[5121,"طير الحقول","https://www.poetsgate.com/ViewPoem.aspx?id=37478",""],[5356,"{حيّاك يا ورداً","https://www.poetsgate.com/ViewPoem.aspx?id=205791",""],[5725,"البيعة","https://www.poetsgate.com/ViewPoem.aspx?id=186954",""],[5725,"يا رشيقا","https://www.poetsgate.com/ViewPoem.aspx?id=195333",""],[5725,"أهون الطعنات","https://www.poetsgate.com/ViewPoem.aspx?id=211094",""],[5939,"مهلك","https://www.poetsgate.com/ViewPoem.aspx?id=178591",""],[6067,"بائع العسلية","https://www.poetsgate.com/ViewPoem.aspx?id=177158",""]],"verses":[["يا رِشاءً تَخْضَلُّ منه يد الما","تحِ قبل انغماسِهِ في القليبِ",0,"ب",1,0],["يا رَشادَ المُلكِ تَهنِأَةً","بِالَّذي أوتيتَ مِن نِعَمِ",1,"م",1,0],["يا رَشيدَ الأَمرِ أَرشِدني إِلى","وَجهِ نُجحِ لا عَدِمتَ الرَشَدا",2,"د",2,1],["يا رشاد الملك تهنئة","بالذي أوتيت من نعم",3,"م",1,0],["يا رشأ السدرِ ولو أنني","أنصفتُ ناديتُ رشا الصدرِ",4,"ر",1,1],["يا رشأً مسكنهُ فاس","أَلشمسُ مهما لُحتَ نبراسُ",5,"س",1,1],["يا رشيق القد رفقاً","بمحبّ مات سلا",6,"ل",2,0],["يا رشفةً مِنْ لمى (لمياءَ) باردةً","كم شبَّ من ذكرِها بين الحشا قبس",7,"س",1,0],["يا رَشيق القَدّ رِفقاً بِفَتىً","بِسِهام اللَحظ أَضحى يَرشقُ",8,"ق",1,0],["يا رَشيق القَوامِ يا ناعِسَ الطر","ف حنانا لِمَن جَفاه كراه",9,"ا",2,0],["يا رشيق القوام رقَّ لقلب","خافت لا يريد غير لِقَاكَا",10,"ك",2,0],["يا رشاً ملكته حشاشتي","فجار في حكم الغرام واعتدى",11,"ا",1,0],["يا رشيد العلى ويا خير صدر","ملأ الكون بهجةً واستناره",12,"ر",2,1],["يا رشاد وسبيل الرشد ينهجه","من آثر الخير دون الشر فاختارا",13,"ر",2,0],["يا رشأ حظِّىَ إبعادهُ","وحظ غَيرىَ منه إسعاده",14,"د",2,1],["يارَشأً مُفترساً للنُّهى","مثْلَ افْتِراس الأُسْدِ سِرْبَ النِّعاجْ",15,"ج",1,0],["يا رَشأً في الفُؤادِ مَكْنِسُهُ","لم يَنْتَقِلْ عَنه لا ولم يَرُمِ",16,"م",1,0],["يارَشأً يَعْطِفُني عِطْفُهُ","هَلْ عَطفةٌ لي منهُ بالوَصْلِ",17,"ل",1,0],["يا رشيقاً فديتُه مِن رشيقٍ","يَتثنى كالذابلِ السّمهريِّ",18,"ي",1,0],["يا رشأً تسحرُ ألحاظُهُ","وهنَّ لا يدرينَ ما السحرُ",19,"ر",1,0],["يا رشأ الأتراك عطفاً على","حلف غرام داؤه معضل",20,"ل",1,0],["يا رشأ آنسني بالأسى","لم أنت عني أبداً نافر",21,"ر",1,0],["يا رشأً كلما مررت به","يخفق قلبي له ويضطربُ",22,"ب",1,1],["يا رَشادي يا منادي","قم فَنادي في البلاد",23,"د",1,1],["يا رشيقاً قد راق للعين حتى","ما عليه من ناعمات المطارف",24,"ف",1,0],["يا رشفةً هي راحي في الغرام بها","يُهدى الدواءُ لقلبي من لماك فمي",25,"م",2,0],["يا رشيق القوام أخجلت بالبا","ن تثني غصونه المياده",26,"د",2,0],["يا رشأ وفي الحشى كناسة","خصرك أم جسم معناك أدق",27,"ق",1,0],["يا رشيد باب الوصل مغلوق","وش في حياتي غير لفراق",28,"ق",1,0],["يَا رْشيد يَاكْ الجِيْل واصطاخ","فِيْ الجَوّ بانْصب لِكْ كِواويخْ",29,"خ",1,1],["يا رَشَأً بالكُمِّ عنِّي أرَاهْ","يسترُ لَحْظاً فاتِكاً بالكُمَاهْ",30,"ا",2,0],["يا رَشيق القَوام يَفديك مَضنى","بروءه إِن يَرى القوام الرَشيقا",31,"ق",2,0],["يا رشا يقبل الرشا إذ تهادى","إن روحي مني إليك هديه",32,"ي",2,0],["يا رشا لم أجد بروحي إلا","كان بالوصل رب بخل وضن",33,"ن",1,0],["يا رشأ ليس له غير الحشا","مرعى وغير الدمع ورد وصدر",34,"ر",1,0],["يَا رَشِيقَ القَوَامِ كَيْفَ بِرُشْدِي","وَتَثَنِّى عِطْفَيْكَ أَتْلَفَ رُشْدِي",35,"د",2,0],["يا رشفة قد قطرتها المنى","ما ردها خمراً سوى ربها",36,"ب",3,0],["يا رشيقاً لاقيتُ فيكَ الذي لا","قيت فارحم من بعد ذا المستهاما",37,"م",2,0],["يارشاً من قَبلِ تقبيلهِ","وضَمِّه ما ذقتُ طَعمَ الحياه",38,"ا",2,0],["يا رشاً ما في هواه من سرف","لا ولا في حبه نخشى العذاب",39,"ب",1,0],["يا رشيقاً قلبه للقلب قد","أفلا ترحم صباً فيك شاب",40,"ب",1,0],["يا رشأ ألحاظه صيّرن روحى هدفا","يا قمراً ألفاظُه أورثن قلبي شرفا",41,"ا",1,0],["يا رشفتي في الحبِّ هيَّا قبِّلي","شفتايَ، صا حَ القلبُ: ما أحلاكا",42,"ك",2,0],["يَا رَشِيقَ الْخَطْوِ شُكْراً لَيْسَ تَكْفِي","خُذْ زُهُورِي رَونَقَ الشُّكْرِ الْجَزِيِلِ",43,"ل",1,0],["يا رشفةَ البنِّ التي سكنتْ دمي","مع ذلك الحبَّ الرقيقِ الأكبرِ",44,"ر",1,0],["يارشقة من سهام الموت عالقة","مازال عهد لها كالغلّ في عنقي",45,"ق",2,0],["يا رشيقا غصنه لم ينثني","شاكيا منك نحول البدنِ",46,"ن",1,1],["يا رشى رفقاً بنا من غفلةٍ","صيحةً تصدع قلب الجفلِ",47,"ل",1,0],["يا رَشًا شرَّفْتِ أهلَكْ","إنّني شارفتُ أهلَكْ!",48,"ك",1,1],["يا رشيد الحِسان، لستُ رشيدا،","يا خيالا، يا نفحةً قدسيةْ",49,"ي",2,0]]}