{"poems":[[85,"ما للحمول تحن للأطلال","https://www.aldiwan.net/poem54250.html","الكامل"],[47,"أمواهب هاتيك أم أنواء","https://www.aldiwan.net/poem10197.html","الكامل"],[47,"نكتم وديعة أردشير ولم يكن","https://www.aldiwan.net/poem65150.html","الكامل"],[107,"سرية أنت وحدك","https://www.aldiwan.net/poem43585.html","المجتث"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39553","الرمل"],[92,"الأنانية","https://www.poetsgate.com/ViewPoem.aspx?id=179128",""],[385,"تورد الدمع من توريد وجنته","https://www.aldiwan.net/poem48819.html","البسيط"],[385,"مزجت دموع جفونه بدماء","https://www.aldiwan.net/poem49210.html","الكامل"],[447,"يا ليت شعري بما ألقاه في حدثي","https://www.aldiwan.net/poem14356.html","البسيط"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112438","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64026","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59271","الرجز"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56568","الكامل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114798","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204580","المجتث"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95352","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111447","الكامل"],[4627,"","https://poetry.dctabudhabi.ae/diwan/poem/102007","البسيط"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204170","الكامل"],[4797,"ماكني أعرفه","https://www.poetsgate.com/ViewPoem.aspx?id=132236",""],[5431,"قصيدة وجودية ...","https://www.poetsgate.com/ViewPoem.aspx?id=207830",""],[5464,"سميرَ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=125410",""],[5652,"سمسر جميل الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=192041",""],[5721,"الرقص على حبال الموت","https://www.poetsgate.com/ViewPoem.aspx?id=214687",""],[5818,"احشر الكون في لهاث المضيقِ","https://www.poetsgate.com/ViewPoem.aspx?id=196652",""],[5837,"أعداء النجاح","https://www.poetsgate.com/ViewPoem.aspx?id=181808",""],[5997,"بيّاع الأضاحي","https://www.poetsgate.com/ViewPoem.aspx?id=215045",""]],"verses":[["أَحَشّى تذوب صبابة ومدامعٌ","تغري جفون المزن باستهلالِ",0,"ل",1,0],["أَحشَمتَني بِنَدى يَدَيكَ فَسَوَّدَت","ما بَينَنا تِلكَ اليَدُ البَيضاءُ",1,"ا",2,0],["أَحشَمتُمُ مَلِكَ المُلوكِ وَكِلتُمُ","تِلكَ الخَزايَةِ بِالقَفيزِ الوافي",2,"ف",2,0],["احْشُدْ قُواكَ وَخُذْهُ","فليس يَسْطِيعُ حَشدَكْ",3,"ك",1,0],["احشدوا الريحَ على ظهر الصخورْ","وابعثوها ذاتَ نقشٍ وزفيفْ",4,"ف",1,0],["أُحشّد فيه أصدقائي وأسرتي","كما ضمّ بيتٌ أُسرةً وصواحبا",5,"ب",2,0],["أَحشايَ في وَهجِ مِن بَرد ريقَتِهِ","كَأَنَّ قَلبيَ يَصلى نار وَجنَتِهِ",6,"ت",2,0],["أَحشاؤُهُم مَحشوة بِضَغائن","وَضُلوعَهُم تَطوى عَلَيَ الشَحناءِ",7,"ا",2,0],["أحشاي من ملهم الآصار مفعمةً","وهن من فقدها الخيرات في غرث",8,"ث",1,0],["أحشاؤه احترقت أسى فبكى دماً","حسبي أذى ألا تني عبراته",9,"ت",2,0],["أحُشاشَةَ الرَّبعِ الذش نَاغَيْتُه","فنغى البلى عنه وَحَقَّاً ما نغى",10,"غ",2,0],["أحْشَايَ فِيهِ كُوّرَتْ","وَدُمُوعُ عَيْنِي مُرْسَلَهْ",11,"ل",2,0],["أحشاؤهم حرى فما ابتردوا","وكبودهم ظمأى فما انتقعوا",12,"ع",3,0],["أحشاؤه مَوقُوذةٌ ولِسَانُه","يُهدِي إلى اللَه الكِتَابَ مُرَتَّلا",13,"ل",2,0],["أحشاهما باليات","كما بلت أحشائي",14,"ي",1,0],["أَحشفا وَيك وسُوء كيله","خذ ما صفا من هذه النخيله",15,"ه",1,0],["أَحشَاءَهُ بالرُّمحِ شَقَّ فَمُزِّقَت","وَعَلى الرِّمالِ بدَت لَدى الأَندادِ",16,"د",1,0],["أحشاك من لوعة الأحزان مشعلة","ودمع عينيك يحكي جدولي نهر",17,"ر",1,0],["أحشمتها بالعتب عند لقائها","فتلثمت من شدة استحيائها",18,"ا",3,1],["احشم قريبه حشمة له واداريه","واخشا يجي في خاطره شي وادرى",19,"ر",2,0],["أحشرته في لجّة شغفا ؟","وخرقته بالحب لا يُسرق!!!",20,"ق",1,0],["أُحَشِّمُ أَحْرُفِي فَتَفِرُّ مِنِّي","وَتَهْرُبُ مِنْ خُطَى قَلَمِي السُّطُوْرُ",21,"ر",1,0],["إحشم بنان الشعر لاجيت مشتاق","وأكتب كلامٍ .. صدق .. ماهوب زايف",22,"ف",1,0],["أَحْشُو الفَرَاغَ بِأحْلامٍ رَبَتْ شَجَناً","أُذَوِّبُ الشَّوْقَ فِي كَأْسٍ مِنَ السَّهَرِ",23,"ر",1,0],["احشر الكون في لهاث المضيقِ","واحرق الشهْد واستلذ بالحريقِ",24,"ق",1,1],["أحشم إنسان لاجل إنسان سمح السجايا","والقنيدي فهيم بمدخله وبخروجه",25,"ج",2,0],["أحشدوا للحربِ إنّي حاشدٌ","عزوتي والصرخة العدنانيه",26,"ي",2,0]]}