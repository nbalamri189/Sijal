{"poems":[[83,"ما للحمول تحن للأطلال","https://www.aldiwan.net/poem54250.html","الكامل"],[45,"أمواهب هاتيك أم أنواء","https://www.aldiwan.net/poem10197.html","الكامل"],[45,"نكتم وديعة أردشير ولم يكن","https://www.aldiwan.net/poem65150.html","الكامل"],[105,"سرية أنت وحدك","https://www.aldiwan.net/poem43585.html","المجتث"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39553","الرمل"],[90,"الأنانية","https://www.poetsgate.com/ViewPoem.aspx?id=179128",""],[377,"تورد الدمع من توريد وجنته","https://www.aldiwan.net/poem48819.html","البسيط"],[377,"مزجت دموع جفونه بدماء","https://www.aldiwan.net/poem49210.html","الكامل"],[438,"يا ليت شعري بما ألقاه في حدثي","https://www.aldiwan.net/poem14356.html","البسيط"]],"verses":[["أَحَشّى تذوب صبابة ومدامعٌ","تغري جفون المزن باستهلالِ",0,"ل",1,0],["أَحشَمتَني بِنَدى يَدَيكَ فَسَوَّدَت","ما بَينَنا تِلكَ اليَدُ البَيضاءُ",1,"ا",2,0],["أَحشَمتُمُ مَلِكَ المُلوكِ وَكِلتُمُ","تِلكَ الخَزايَةِ بِالقَفيزِ الوافي",2,"ف",2,0],["احْشُدْ قُواكَ وَخُذْهُ","فليس يَسْطِيعُ حَشدَكْ",3,"ك",1,0],["احشدوا الريحَ على ظهر الصخورْ","وابعثوها ذاتَ نقشٍ وزفيفْ",4,"ف",1,0],["أُحشّد فيه أصدقائي وأسرتي","كما ضمّ بيتٌ أُسرةً وصواحبا",5,"ب",2,0],["أَحشايَ في وَهجِ مِن بَرد ريقَتِهِ","كَأَنَّ قَلبيَ يَصلى نار وَجنَتِهِ",6,"ت",2,0],["أَحشاؤُهُم مَحشوة بِضَغائن","وَضُلوعَهُم تَطوى عَلَيَ الشَحناءِ",7,"ا",2,0],["أحشاي من ملهم الآصار مفعمةً","وهن من فقدها الخيرات في غرث",8,"ث",1,0]]}