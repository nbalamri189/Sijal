{"poems":[[85,"قف ناج أهرام الجلال وناد","https://www.aldiwan.net/poem63772.html","الكامل"],[97,"هل في العصيب المدلهم","https://www.aldiwan.net/poem24783.html","مجزوء الكامل"],[105,"سر فالسعادة حيث كنت تكون","https://www.aldiwan.net/poem43406.html","الكامل"],[75,"فتكات طرفك أم سيوف أبيك","https://www.aldiwan.net/poem69051.html","الكامل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30442","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54211","الخفيف"],[90,"عدِّ عنك الكؤوس","https://www.poetsgate.com/ViewPoem.aspx?id=179009",""],[161,"ما للعلى عتب على الأيام","https://www.aldiwan.net/poem58895.html","الكامل"],[161,"كانت أحادا عند غيرك لا ثنا","https://www.aldiwan.net/poem58919.html","الكامل"],[161,"خرقت عوائدها لك الأقدار","https://www.aldiwan.net/poem58921.html","الكامل"],[161,"لك كل يوم خارقات تبهر","https://www.aldiwan.net/poem58926.html","الكامل"],[161,"همم أتت بخوارق العادات","https://www.aldiwan.net/poem58979.html","الكامل"],[230,"ما تقاضت منا ليالي الزمان","https://www.aldiwan.net/poem50777.html","الخفيف"],[236,"ألفجر ليلك بالبنية مطلع","https://www.aldiwan.net/poem31891.html","الكامل"],[281,"شرفا لمجدك بانيا ومقوضا","https://www.aldiwan.net/poem60712.html","الكامل"],[401,"رسالة إلى فرعون مصر","https://www.aldiwan.net/poem10305.html","عموديه"],[430,"يا رشيد العلى ويا خير صدر","https://www.aldiwan.net/poem39836.html","الخفيف"],[496,"لك كعبتان ومشعرا","https://www.aldiwan.net/poem9852.html","مجزوء الكامل"],[563,"لم يبق شكرك في فؤادي موضعا","https://www.aldiwan.net/poem52760.html","الكامل"]],"verses":[["لَكِ كَالمَعابِدِ رَوعَةٌ قُدسِيَّةٌ","وَعَلَيكِ روحانِيَّةُ العُبّادِ",0,"د",1,0],["لك كل ما أوفى على","قدر النهاية واستتم",1,"م",1,0],["لَكَ كُلَّ عامٍ رِحلَةٌ تَبغي بِها","ما عَزَّ مِن آمالِنا فَيَهونُ",2,"ن",1,0],["لك كلُّ يوم لو تقدَّم عَصُرهُ","لم يَلْهَجِ العَدَوِيُّ باليَرموك",3,"ك",1,0],["لكَ كَفٌّ بالثُّرَيَّا فَيْضُها","ولها بَسْطُ النَّدَى مِن كَثَبِ",4,"ب",1,0],["لَكَ كَفّانِ تلك تُعْطي وهَذِي","تَتَلقّى مَثُوبةَ الْحَسَناتِ",5,"ت",1,0],["لك كفٌ كالركن فينا فأقصى","منيةِ النَفس عندنا ان تُمَسّا",6,"س",2,0],["لكَ كل يوم في المكارم بدعةٌ","لا تعتدى في فعلها بإمامِ",7,"م",1,0],["لك كل يَّوم صولةٌ فعل الوفا","بالغدر فيما قد أَقرَّ الأَعينا",8,"ن",2,0],["لكَ كلَّ يوم وقعةٌ في وصفها","تستغربُ الانباءُ والأخبارُ",9,"ر",1,0],["لكَ كلَّ يومٍ خارقاتٌ تبهرُ","يثني بهن على الإِله ويشكرُ",10,"ر",1,1],["لك كل يوم في عدو وقعة","ووديعة في بطن كل فلات",11,"ت",1,0],["لك كفٌّ تُجاوِدُ الغَيْثَ بَذلاً","وجَبِينٌ كأَنَّه القَمَرانِ",12,"ن",1,0],["لَكَ كُلَّ يَومٍ مَنزِلٌ مُتَقادِمٌ","يَعتادُكَ الأَسحارُ فيهِ وَمَربَعُ",13,"ع",1,0],["لَكَ كُلَّ يَوْمٌ عِيدُ مَجْدٍ عائِدٌ","لِلْحَمْدِ فيه أَنْ يَطُولَ ويَعْرُضا",14,"ض",2,0],["لكَ كلَّ يومٍ قَوْلةٌ تُلغي بها","ما قلتَ أمسِ ، وتحسن الترقيعا",15,"ع",2,0],["لك كل الأنام شرقاً وغرباً","شهدوا بالذكا وحسن الإداره",16,"ر",2,0],["لك كعبتان ومَشعرا","ن وقبلتان لمن يحاذِي",17,"ي",1,1],["لكَ كلَّ يومٍ مِنَّةٌ وصَنيعةٌ","عن مَحضِ وُدٍّ لم يكنْ مُتصنِّعا",18,"ع",2,0]]}