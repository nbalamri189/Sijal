{"poems":[[87,"قف ناج أهرام الجلال وناد","https://www.aldiwan.net/poem63772.html","الكامل"],[99,"هل في العصيب المدلهم","https://www.aldiwan.net/poem24783.html","مجزوء الكامل"],[107,"سر فالسعادة حيث كنت تكون","https://www.aldiwan.net/poem43406.html","الكامل"],[77,"فتكات طرفك أم سيوف أبيك","https://www.aldiwan.net/poem69051.html","الكامل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30442","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54211","الخفيف"],[92,"عدِّ عنك الكؤوس","https://www.poetsgate.com/ViewPoem.aspx?id=179009",""],[164,"ما للعلى عتب على الأيام","https://www.aldiwan.net/poem58895.html","الكامل"],[164,"كانت أحادا عند غيرك لا ثنا","https://www.aldiwan.net/poem58919.html","الكامل"],[164,"خرقت عوائدها لك الأقدار","https://www.aldiwan.net/poem58921.html","الكامل"],[164,"لك كل يوم خارقات تبهر","https://www.aldiwan.net/poem58926.html","الكامل"],[164,"همم أتت بخوارق العادات","https://www.aldiwan.net/poem58979.html","الكامل"],[234,"ما تقاضت منا ليالي الزمان","https://www.aldiwan.net/poem50777.html","الخفيف"],[240,"ألفجر ليلك بالبنية مطلع","https://www.aldiwan.net/poem31891.html","الكامل"],[285,"شرفا لمجدك بانيا ومقوضا","https://www.aldiwan.net/poem60712.html","الكامل"],[406,"رسالة إلى فرعون مصر","https://www.aldiwan.net/poem10305.html","عموديه"],[435,"يا رشيد العلى ويا خير صدر","https://www.aldiwan.net/poem39836.html","الخفيف"],[500,"لك كعبتان ومشعرا","https://www.aldiwan.net/poem9852.html","مجزوء الكامل"],[567,"لم يبق شكرك في فؤادي موضعا","https://www.aldiwan.net/poem52760.html","الكامل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103096","الكامل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101563","الكامل"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112428","الرمل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86864","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48691","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48671","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56192","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56189","الكامل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28608","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88643","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204577",""],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134029","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62825","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62798","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108047","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135626","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103057","الكامل"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105510","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73248","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72459","الكامل"],[4691,"أنتِ يا هيفُ شامة ٌ في فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=157675",""],[4926,"كيف يحصى عليك منا ثناء","https://www.poetsgate.com/ViewPoem.aspx?id=171114",""],[585,"الكاس واحدةٌ ونحن اثنان","https://www.poetsgate.com/ViewPoem.aspx?id=161930",""],[3591,"يا شاعر العرب الذين بشعره","https://www.poetsgate.com/ViewPoem.aspx?id=149514",""],[5183,"لن تراني","https://www.poetsgate.com/ViewPoem.aspx?id=180161",""],[5277,"نؤومُ المواجع","https://www.poetsgate.com/ViewPoem.aspx?id=191348",""],[5277,"وجعُ الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=200927",""],[5285,"لكِ ما أردتِ","https://www.poetsgate.com/ViewPoem.aspx?id=203190",""],[5397,"خضعت لعزة ذاتك الدول","https://www.poetsgate.com/ViewPoem.aspx?id=157897",""],[5431,"بنٌ أفّاك!...","https://www.poetsgate.com/ViewPoem.aspx?id=208853",""],[5628,"لو لمْ أحبّكِ","https://www.poetsgate.com/ViewPoem.aspx?id=178480",""],[5628,"عيناك مرفئي","https://www.poetsgate.com/ViewPoem.aspx?id=179812",""],[5720,"أنتَ الذي أحييتَ قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=207164",""],[5729,"ضاعت حروفي","https://www.poetsgate.com/ViewPoem.aspx?id=203997",""],[5790,"ما للجمال بوجنتيك معين","https://www.poetsgate.com/ViewPoem.aspx?id=112147",""],[5952,"مَوْسِقِ ال آهَ","https://www.poetsgate.com/ViewPoem.aspx?id=213572",""]],"verses":[["لَكِ كَالمَعابِدِ رَوعَةٌ قُدسِيَّةٌ","وَعَلَيكِ روحانِيَّةُ العُبّادِ",0,"د",1,0],["لك كل ما أوفى على","قدر النهاية واستتم",1,"م",1,0],["لَكَ كُلَّ عامٍ رِحلَةٌ تَبغي بِها","ما عَزَّ مِن آمالِنا فَيَهونُ",2,"ن",1,0],["لك كلُّ يوم لو تقدَّم عَصُرهُ","لم يَلْهَجِ العَدَوِيُّ باليَرموك",3,"ك",1,0],["لكَ كَفٌّ بالثُّرَيَّا فَيْضُها","ولها بَسْطُ النَّدَى مِن كَثَبِ",4,"ب",1,0],["لَكَ كَفّانِ تلك تُعْطي وهَذِي","تَتَلقّى مَثُوبةَ الْحَسَناتِ",5,"ت",1,0],["لك كفٌ كالركن فينا فأقصى","منيةِ النَفس عندنا ان تُمَسّا",6,"س",2,0],["لكَ كل يوم في المكارم بدعةٌ","لا تعتدى في فعلها بإمامِ",7,"م",1,0],["لك كل يَّوم صولةٌ فعل الوفا","بالغدر فيما قد أَقرَّ الأَعينا",8,"ن",2,0],["لكَ كلَّ يوم وقعةٌ في وصفها","تستغربُ الانباءُ والأخبارُ",9,"ر",1,0],["لكَ كلَّ يومٍ خارقاتٌ تبهرُ","يثني بهن على الإِله ويشكرُ",10,"ر",1,1],["لك كل يوم في عدو وقعة","ووديعة في بطن كل فلات",11,"ت",1,0],["لك كفٌّ تُجاوِدُ الغَيْثَ بَذلاً","وجَبِينٌ كأَنَّه القَمَرانِ",12,"ن",1,0],["لَكَ كُلَّ يَومٍ مَنزِلٌ مُتَقادِمٌ","يَعتادُكَ الأَسحارُ فيهِ وَمَربَعُ",13,"ع",1,0],["لَكَ كُلَّ يَوْمٌ عِيدُ مَجْدٍ عائِدٌ","لِلْحَمْدِ فيه أَنْ يَطُولَ ويَعْرُضا",14,"ض",2,0],["لكَ كلَّ يومٍ قَوْلةٌ تُلغي بها","ما قلتَ أمسِ ، وتحسن الترقيعا",15,"ع",2,0],["لك كل الأنام شرقاً وغرباً","شهدوا بالذكا وحسن الإداره",16,"ر",2,0],["لك كعبتان ومَشعرا","ن وقبلتان لمن يحاذِي",17,"ي",1,1],["لكَ كلَّ يومٍ مِنَّةٌ وصَنيعةٌ","عن مَحضِ وُدٍّ لم يكنْ مُتصنِّعا",18,"ع",2,0],["لك كل شيء إن بطنت منازل","وإذا ظهرت فكل شيء بائن",19,"ن",1,0],["لك كلَّ يومٍ كلُّ قافيةٍ","من كل معنًى شائقٍ بكرِ",20,"ر",1,0],["لك كف والندى ديدنها","لا تضاهيها أكف الديم",21,"م",1,0],["لَكَ كُل عام عِندَ مَصر وَأَهلِها","أَعياد خلّ بِالخُصوبة زائر",22,"ر",1,0],["لك كل يوم منه برهانٌ على","إعجاب مصر بعهدك الميمون",23,"ن",1,0],["لك كل يوم يا رشادُ شفاعةٌ","في القوم عند اللّه وهو غفور",24,"ر",1,0],["لك كل حولٍ دام يقبل عايداً","عقد الولا والموسم المعتادُ",25,"د",1,0],["لك كل حولٍ مقبل أداره","من سيد الوزراء مكرمة تجدْ",26,"د",1,0],["لَكَ كُلَّ يَوم غَضبَةٌ مُضَرِيَّةٌ","تُدني بِها الآجالَ قَبلَ أَوانِها",27,"ن",3,0],["لك كالصل نفثة بيد اني","ما توسمت في وجارك رملا",28,"ل",2,0],["لك كل ليل أنس مجتمع","برفاقه وعناء مفترق",29,"ق",1,0],["لك كل مدح دائم وتشكر","وتحية مشفوعة بسلام",30,"م",1,0],["لكَ كل يومٍ بِدعةٌ مشهورةٌ","يَعيا بها ويكلُّ كل لِسانِ",31,"ن",1,0],["لكَ كلُّ يومٍ في المكارمِ غايةٌ","تستصغِرُ الماضي لِما يُتَوقّعُ",32,"ع",1,0],["لك كل قافيةٍ تعد سفينة","في اليمي راسيةً لدكِّ رواس",33,"س",1,0],["لك كل كونٍ شاهد بتفرُّدِ","وتَنَزُّهٍ وتخالفٍ وتوحُّدِ",34,"د",1,1],["لك كل رائحة وغادية","أذنت بنشر دوارس رمم",35,"م",1,0],["لك كم أودع البلاغة سرا","قلم في الطروس بنفث سحرا",36,"ر",2,1],["لَكَ كالعَرائس تُجتَلى","عِندَ العِيانِ لِكُلِّ عَينِ",37,"ن",1,0],["لك كم رأينا للعلا","مدَّا وللبحرين جزرا",38,"ر",2,0],["لكِ كَمْ مَهَّدَ الوِدادَ طريقًا","فَلْتَسِيري بِهِ فلنْ يَتَعَرَّجْ",39,"ج",1,0],["لك كلتا الدّارين ما مسَّ ثوباً","عسلٌ قطُّ منهما ولا حلواء",40,"ا",2,0],["لك كل سحرٍ في الجمال وفتنةٍ","دفعت بني الدنيا إلى الإذعان",41,"ن",1,0],["لك كل قافيةٍ تعد سفينة","في اليم راسيةً لدكّ رواس",42,"س",1,0],["لك كل الأسماء علما من الل","ه وإذ أنت لم تسع إلاه",43,"ا",2,0],["لكَ كل فضلٍ لا تزال قصائدي","حيرى تردُّ من الجميلِ جميلَكْ",44,"ك",1,0],["لكَ كلُّ أشرعةِ البحورِ تحيلها","ذكرى..لمن مرّوا عليك وغابوا",45,"ب",3,0],["لكِ كلُّ وعدٍ من تباريحِ الصِبا","إن ساءلتْكِ عن الهوى عادتْ غريقةْ",46,"ق",2,0],["لك كل أملاك السما خدم","في الأفق إن صعدوا وإن نزلوا",47,"ل",3,0],["لك كوبٌ من اللذاذة محضٌ","وليَ الأمرُ : رحمةٌ أم هلاكُ !!",48,"ك",1,0],["لك كلُّ ما سطّرتُ في كتب الهوى","وسكبت فيه العطْرَ والأنوارا",49,"ر",2,0],["لك ِ كلُّ ما غنيتهُ","ولك ِ القوافي والسطورُ",50,"ر",1,0],["لك كلُّ حمدٍ فاض بين جوانحي","يرقىٰ بذكرك في المدىٰ ويحلِّقُ",51,"ق",1,0],["لك كل حرف قد كتبت بمدمعي","سبحان من جعل القصيدة تخشع",52,"ع",1,0],["لك كل يوم صبوة عذرية","أعليك نذرٌ أم عليك يمين",53,"ن",1,0],["لك كأسٌ ونقصها لكَ حاكٍ","يحْقر العيش إن تنل ما تشاء",54,"ا",2,0]]}