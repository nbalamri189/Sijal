{"poems":[[74,"ما لظبي الحمى إليه التفاته","https://www.aldiwan.net/poem18387.html","الخفيف"],[74,"كل يوم سعادة مستهله","https://www.aldiwan.net/poem19475.html","الخفيف"],[72,"قد تجاسرت وفيك المحتمل","https://www.aldiwan.net/poem42739.html","الرمل"],[94,"كل قلب حمل الخسف وما","https://www.aldiwan.net/poem38921.html","الرمل"],[87,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[107,"أعجزنا أن نجوب المشرقين","https://www.aldiwan.net/poem42090.html","الرمل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85446","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54871","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[111,"نكس العلام يا خير الملل","https://www.poetsgate.com/ViewPoem.aspx?id=67046",""],[119,"من لدمع طغى وقلب مهيم","https://www.aldiwan.net/poem40590.html","عموديه"],[119,"مد من عينيك للقلب شرك","https://www.aldiwan.net/poem41101.html","عموديه"],[193,"لست أنسى زمنا قد سلفا","https://www.aldiwan.net/poem35098.html","الرمل"],[234,"لو تقصيت وصف شوقي وتوقي","https://www.aldiwan.net/poem50809.html","الخفيف"],[240,"أولعت بالغدر في أيمانها","https://www.aldiwan.net/poem31728.html","الرمل"],[309,"خلها تجري بعين الله في","https://www.aldiwan.net/poem16878.html","الرمل"],[366,"بابي شادنا تجدر فازداد","https://www.aldiwan.net/poem68101.html","الخفيف"],[369,"قسما مني بأيام الصفاء","https://www.aldiwan.net/poem61005.html","الطويل"],[422,"ما قضينا حقا لرسم محيل","https://www.aldiwan.net/poem53816.html","الخفيف"],[556,"خلها إنها تريد الغميما","https://www.aldiwan.net/poem47231.html","الطويل"],[563,"نحن قوم ذنوبنا للأعادي","https://www.aldiwan.net/poem34639.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122728","الرمل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48781","الخفيف"],[1630,"","https://poetry.dctabudhabi.ae/diwan/poem/146588","الخفيف"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126206","الخفيف"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60820","الرمل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87767","الرمل"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105676","الرمل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140068",""],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74308","الخفيف"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68031","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74097","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74098","الرمل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103888","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91068","الخفيف"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103048","الخفيف"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76455","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[4122,"","https://poetry.dctabudhabi.ae/diwan/poem/111118","الرمل"],[4702,"قالن علام الشيب ناشك يا يابه","https://www.poetsgate.com/ViewPoem.aspx?id=155111",""],[4718,"الجرح","https://www.poetsgate.com/ViewPoem.aspx?id=137100",""],[4718,"الموت حق","https://www.poetsgate.com/ViewPoem.aspx?id=137154",""],[4718,"ياصاح انا قلبي من الهم طاويه","https://www.poetsgate.com/ViewPoem.aspx?id=137214",""],[4791,"خلها تلعب","https://www.poetsgate.com/ViewPoem.aspx?id=37104",""],[4797,"الناموس","https://www.poetsgate.com/ViewPoem.aspx?id=178129",""],[4802,"حكم القدر والقراده","https://www.poetsgate.com/ViewPoem.aspx?id=32636",""],[4869,"بسمة الظلم","https://www.poetsgate.com/ViewPoem.aspx?id=151576",""],[5055,"وأنا حي","https://www.poetsgate.com/ViewPoem.aspx?id=72818",""],[5122,"(( يامضيع العشاق..1))","https://www.poetsgate.com/ViewPoem.aspx?id=27095",""],[5122,"نصيحة في عجالة","https://www.poetsgate.com/ViewPoem.aspx?id=31515",""],[5136,"شرف باذخ رفيع منيف","https://www.poetsgate.com/ViewPoem.aspx?id=121621",""],[5335,"اكحل عينها","https://www.poetsgate.com/ViewPoem.aspx?id=36041",""],[5409,"نحن في كل غدوةٍ ورواح","https://www.poetsgate.com/ViewPoem.aspx?id=155258",""],[5442,"قد براها جذب البرى والأزمة","https://www.poetsgate.com/ViewPoem.aspx?id=114766",""],[5442,"حادي الركب لا تحث المطيا","https://www.poetsgate.com/ViewPoem.aspx?id=114762",""],[5455,"نديم الجرح","https://www.poetsgate.com/ViewPoem.aspx?id=34411",""],[5573,"عشنا عيال احرار","https://www.poetsgate.com/ViewPoem.aspx?id=201930",""],[5664,"خلف سيار","https://www.poetsgate.com/ViewPoem.aspx?id=176684",""],[5732,"يامشرف المرقاب","https://www.poetsgate.com/ViewPoem.aspx?id=177886",""],[5732,"الله من قلب","https://www.poetsgate.com/ViewPoem.aspx?id=177901",""],[5756,"الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=5184",""],[5848,"خل عندك دم","https://www.poetsgate.com/ViewPoem.aspx?id=52027",""],[5848,"الله لا يهينك","https://www.poetsgate.com/ViewPoem.aspx?id=53368",""],[5848,"مع المحبه لتركي رويع","https://www.poetsgate.com/ViewPoem.aspx?id=48979",""],[5893,"وش مسهرك","https://www.poetsgate.com/ViewPoem.aspx?id=141383",""],[5950,"عمر ومسافة ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128118",""],[5976,"يا بو سعد ..","https://www.poetsgate.com/ViewPoem.aspx?id=35084",""],[6113,"حراااامي","https://www.poetsgate.com/ViewPoem.aspx?id=35354",""]],"verses":[["خلّ هذا وانعَمْ بباب مليك","عمّ بالعدل والنوال عُفاته",0,"ت",2,0],["خلّ هذا واذْكر منازلَ قصرٍ","قاسميّ قد قسم السعد نزله",1,"ل",2,0],["خَلِّها عِندي يَداً مَشكورَةً","وَأَضِفها لِأَياديكَ الأُوَل",2,"ل",1,0],["خَلِّهِ للموتِ يَطْويهِ فمَا","حَظُّهُ غيرُ الفَنَاءِ الأَنْكَلِ",3,"ل",1,0],["خِلَّةٌ لِلبِلادِ يَشقى بِها النا","سُ وَتَشقى الدِيارُ وَالأَبناءُ",4,"ا",2,0],["خِلَّةُ الشّامتِ إلا أنّها","أبعدُ الخلّانِ عن عَيْبٍ وشيْنْ",5,"ن",1,0],["خلها في الخدود تَجري خفافاً","ساحبات وَراءهنَّ الذيولا",6,"ل",2,0],["خُلِّ هَذِي الأَفْلاكَ تجْرِي إِلى مَا","لَسْتَ تدَرِي وَغَن يَا عُصْفُورُ",7,"ر",1,0],["خَلِّها وَأَلسُنَها","مُنقضاتِ أَظهُرِها",8,"ر",3,0],["خلها يا ابن حميد تلتوي","فتنة عمياء كالليل المضل",9,"ل",1,0],["خله يا قليب لله واصبر","فلعدل الاله سر مطلسم",10,"م",1,0],["خله يا قلب في سكرته","فلقد يترك عمدا من ترك",11,"ك",1,0],["خلِّ هذا فبهِ القولُ فضول","عندَ مَن سُقتُ لهم هذا الكلام",12,"م",1,0],["خَلِّهم واِرجِع إِلى مدحِ الرَسول","صَفوةِ الرَحمنِ من كلِّ الأنام",12,"م",1,0],["خُلّة لا تحُولُ غَدْراً ولا تَطْ","مَع في حَلِّ عَقْدِها الأيّام",13,"م",1,0],["خَلِّها يا حادي العيسِ على","رِسلِها تَمرَحُ في أَرسانِها",14,"ن",3,0],["خلها تجري بعين اللَه في","بحر أقدار المهين ذي العلا",15,"ل",2,1],["خَلّ هذا الدَلال وَاِرحَم مَعنى","لَم يجد في الهَوى عَلَيكَ نَصيرا",16,"ر",2,0],["خَلِّها تَثْنِ إليهم نّظْرةً","ثمّ هَبْها عندهم للبُشَراء",17,"ا",2,0],["خلّها من لغويها أنْ يطاها","وأرِحها سُوَيْعَةً فمطاها",18,"ه",2,0],["خَلّها لا عدمتَ ذا اليوم خلاّ","إن تحاولْ بقطعك البيد وصلا",18,"ل",2,0],["خلِّها إنّها تريد الغميما","طالما أنجد الصّحيحُ سقيما",19,"م",2,1],["خلهم يا أخا المودة فينا","يطعنوا إن الله بالمرصاد",20,"د",1,0],["خَلِّها والدَّوحَ تَنحُو نَحوَهُ","عَلَّها تَنعَمُ ماءً وَظِلالا",21,"ل",2,0],["خلة يستوي هنالك من ول","لَوه في شرها ومن عزلوه",22,"و",2,0],["خلة الغانيات خلة سوء","فاتقوا الله يا أولي الألباب",23,"ب",1,1],["خِلّةٌ يَعبدُ الدَراهمَ وأهجُر","جِيفَ القلبِ بالعبيرِ تَضمَّخ",24,"خ",1,0],["خِلُّهُ صاحبُه مُؤنِسُه","هَلْ تمِلّ العينُ أنسَ النَّظرِ",25,"ر",1,0],["خَلّ هَذا الدَمع يَجري عِندَما","وَدَعِ القَلب تَلظّيه الشُجون",26,"ن",1,0],["خلها تعمل للمستقبل","علها تحفظ للشعب ثغور",27,"ر",1,0],["خلة حبرون التي برقها","كم قد رمى في مهجتي شعلة",28,"ل",2,0],["خلة اللَه وَالمَحبة حيزت","لِنَبي غَدا إِلى العَرش شامخ",29,"خ",1,0],["خَلِّها بالسرور تَنْزِف دمعاً","إنما هَيَّجَ السرورُ بُكاها",30,"ا",3,0],["خَلِّها تسكُب الدموعَ دِقاقاً","مِيسمُ الشوقِ باللِّقا قَدْ كَواها",30,"ا",3,0],["خَلِّها إِنْ بعينِها لن نُبَقِّي","دمعةً تسفحُ الدِّما مُقلتاها",30,"ا",3,0],["خلّها تكثر النجاء فَهذي","رسل البشر ما تقل النَجاءَ",31,"ا",2,0],["خلّه فَهوَ فَتىً يافِع","ثُمَّ ذرنا نَحتَفِظ ذاكَ الفتاءَ",32,"ا",2,0],["خلّه تنعم به أَوطانُه","واِبقه نحمد به هَذا البَقاءَ",32,"ا",2,0],["خل هذا وبادر الدهر وارحل","في رياض الربى مطي العقار",33,"ر",1,1],["خلها ترو وادياً بدموعٍ","طالما قد غذاها منه الكلاء",34,"ا",2,0],["خلها خلها تنوح وتبكي","كلنا في ادكارِ عهدٍ سواء",34,"ا",2,0],["خلّها في السرى تمد خطاها","فعساها ترى الثريا محلّا",35,"ل",2,0],["خلهم وَهوَ الوَفي","راحهم فاِصنَع من الان الكَفَن",36,"ن",1,0],["خلها واحتمل مجنّاً ورمحاً","ثم كرَّنَّ بالقنا الخطار",37,"ر",1,0],["خلها تدمي من السير يداها","لا تعقها فلقد شق مداها",38,"ا",3,1],["خله يذوق العافية في جنابه","يمشي يسولف يهتني بالرقادي",39,"د",2,0],["خله يطيب الجرح الاول ويمديك","تجرح اليامن طاب والقلب يفداك",40,"ك",1,0],["خله ابالك لو تطول المشاوير","لاتغفل اعيونك وفكرك حذاري",41,"ر",2,0],["خله مكانه لاتزّود بلاويه","يكفيني اللي من زماني حصلّي",42,"ل",2,0],["خلها تلعب مثل لعب الفرس","لا ربح عن دربها من ردها",43,"د",3,1],["خلها ترتاح وانا المستفيد","عادها اغلا فاللقايا والجذاع",44,"ع",1,0],["خله يعايش غربةٍ باسم الإحساس","منه على حاله وهذا مراده",45,"د",2,0],["خلّه صدى للي لفا يدوّر سموع","وخلني مثل من فآق / من صدمة الحلم",46,"م",1,0],["خلها على الله قوم صفْرّ مع الريح","ضرب القفى أصبح على الشاعر افضال",47,"ل",1,0],["خله يشعشع في سمانا بالنوار","نّور علينا جعلها لك مسا فير",48,"ر",1,0],["خله وخل ايجابته مع سواله","يضل ويحصل مظل يظله",49,"ل",2,0],["خل هلنا تشريفهم وأهنيك","بما اختصك الخبير اللطيف",50,"ف",1,0],["خل هقوات الصدور الممحلات تطيح دونك","شف عروس الشعر واكحل عينها وانقش يديها",51,"ي",3,0],["خلها للقوي أو كن قوياً","تستطيع استرجاع حق صراح",52,"ح",1,0],["خلها واشتياقها فهو كاف","همه الشوق لا تقاس بهمه",53,"م",2,0],["خلها تمتطي الحزون وغدها","بعدها بالحمي مهادا وطيا",54,"ي",2,0],["خلها تدفع ثمن غلطاتها ما دامها","همّّلت قلبي .. وراحت .. وأسرفت في حومها",55,"م",3,0],["خله يدور جمرته في رماده","الله كفاني من وذا كل مقرود",56,"د",1,0],["خلها تسيل الارض فعل وتماثيل","خلها تذكر دام فعلك ذكرته",57,"ت",2,0],["خله لمشطون ٍتزايد به طعون","على عشير ٍ زود الهجر فرقا",58,"ق",2,0],["خله وراد مقيط يتبع مهفه","ولياك يا قلب شقا به تحسف",59,"ف",1,0],["خل هقواتك كبيرة ونظراتك بعاد","كانك انت بكبرك تهون من اللي ما يهون ؟",60,"ن",1,0],["خلها تهتني لحظات حسب الظروف","لا تعكر هناها في سنين الشباب",61,"ب",1,0],["خلّها يا زمن بيني وبينك","دمعةٍ كل ما طاحت تعود !",62,"د",1,0],["خل هذا .. وقلي .. كيف امورك ؟ تمام !","وكيف حال الصغار وروحك المُلهمة",63,"م",2,0],["خلّه يروح وشف عمرك مع الجيل","تلقى بديله فيه حب وذرابه",64,"ب",2,0],["خلّها تقنب ورى العوج الرهيفة","الشعور أحيان موته في ضفافه",65,"ف",2,0],["خلّه يدقّ الطبل .. والا يِعَزْف الناي","خلّه يلاعب جنوبه .. لاطرى غربه ..",66,"ب",2,0],["خله يروح بعيد دامه على ايديك","لابد يرجع لك شفوقًً وضامي",67,"م",2,0]]}