{"poems":[[72,"ما لظبي الحمى إليه التفاته","https://www.aldiwan.net/poem18387.html","الخفيف"],[72,"كل يوم سعادة مستهله","https://www.aldiwan.net/poem19475.html","الخفيف"],[70,"قد تجاسرت وفيك المحتمل","https://www.aldiwan.net/poem42739.html","الرمل"],[92,"كل قلب حمل الخسف وما","https://www.aldiwan.net/poem38921.html","الرمل"],[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[105,"أعجزنا أن نجوب المشرقين","https://www.aldiwan.net/poem42090.html","الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85446","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54871","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[116,"من لدمع طغى وقلب مهيم","https://www.aldiwan.net/poem40590.html","عموديه"],[116,"مد من عينيك للقلب شرك","https://www.aldiwan.net/poem41101.html","عموديه"],[190,"لست أنسى زمنا قد سلفا","https://www.aldiwan.net/poem35098.html","الرمل"],[230,"لو تقصيت وصف شوقي وتوقي","https://www.aldiwan.net/poem50809.html","الخفيف"],[236,"أولعت بالغدر في أيمانها","https://www.aldiwan.net/poem31728.html","الرمل"],[305,"خلها تجري بعين الله في","https://www.aldiwan.net/poem16878.html","الرمل"],[362,"بابي شادنا تجدر فازداد","https://www.aldiwan.net/poem68101.html","الخفيف"],[365,"قسما مني بأيام الصفاء","https://www.aldiwan.net/poem61005.html","الطويل"],[417,"ما قضينا حقا لرسم محيل","https://www.aldiwan.net/poem53816.html","الخفيف"],[552,"خلها إنها تريد الغميما","https://www.aldiwan.net/poem47231.html","الطويل"],[559,"نحن قوم ذنوبنا للأعادي","https://www.aldiwan.net/poem34639.html","الخفيف"]],"verses":[["خلّ هذا وانعَمْ بباب مليك","عمّ بالعدل والنوال عُفاته",0,"ت",2,0],["خلّ هذا واذْكر منازلَ قصرٍ","قاسميّ قد قسم السعد نزله",1,"ل",2,0],["خَلِّها عِندي يَداً مَشكورَةً","وَأَضِفها لِأَياديكَ الأُوَل",2,"ل",1,0],["خَلِّهِ للموتِ يَطْويهِ فمَا","حَظُّهُ غيرُ الفَنَاءِ الأَنْكَلِ",3,"ل",1,0],["خِلَّةٌ لِلبِلادِ يَشقى بِها النا","سُ وَتَشقى الدِيارُ وَالأَبناءُ",4,"ا",2,0],["خِلَّةُ الشّامتِ إلا أنّها","أبعدُ الخلّانِ عن عَيْبٍ وشيْنْ",5,"ن",1,0],["خلها في الخدود تَجري خفافاً","ساحبات وَراءهنَّ الذيولا",6,"ل",2,0],["خُلِّ هَذِي الأَفْلاكَ تجْرِي إِلى مَا","لَسْتَ تدَرِي وَغَن يَا عُصْفُورُ",7,"ر",1,0],["خَلِّها وَأَلسُنَها","مُنقضاتِ أَظهُرِها",8,"ر",3,0],["خله يا قليب لله واصبر","فلعدل الاله سر مطلسم",9,"م",1,0],["خله يا قلب في سكرته","فلقد يترك عمدا من ترك",10,"ك",1,0],["خلِّ هذا فبهِ القولُ فضول","عندَ مَن سُقتُ لهم هذا الكلام",11,"م",1,0],["خَلِّهم واِرجِع إِلى مدحِ الرَسول","صَفوةِ الرَحمنِ من كلِّ الأنام",11,"م",1,0],["خُلّة لا تحُولُ غَدْراً ولا تَطْ","مَع في حَلِّ عَقْدِها الأيّام",12,"م",1,0],["خَلِّها يا حادي العيسِ على","رِسلِها تَمرَحُ في أَرسانِها",13,"ن",3,0],["خلها تجري بعين اللَه في","بحر أقدار المهين ذي العلا",14,"ل",2,1],["خَلّ هذا الدَلال وَاِرحَم مَعنى","لَم يجد في الهَوى عَلَيكَ نَصيرا",15,"ر",2,0],["خَلِّها تَثْنِ إليهم نّظْرةً","ثمّ هَبْها عندهم للبُشَراء",16,"ا",2,0],["خلّها من لغويها أنْ يطاها","وأرِحها سُوَيْعَةً فمطاها",17,"ه",2,0],["خَلّها لا عدمتَ ذا اليوم خلاّ","إن تحاولْ بقطعك البيد وصلا",17,"ل",2,0],["خلِّها إنّها تريد الغميما","طالما أنجد الصّحيحُ سقيما",18,"م",2,1],["خلهم يا أخا المودة فينا","يطعنوا إن الله بالمرصاد",19,"د",1,0]]}