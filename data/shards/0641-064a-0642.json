{"poems":[[53,"اسقني فاليوم نشوان","https://www.aldiwan.net/poem29667.html","المديد"],[53,"تعيف الطير فأنبأنه","https://www.aldiwan.net/poem29951.html","السريع"],[53,"في قتال كان للطي","https://www.aldiwan.net/poem30640.html","مجزوء الرمل"],[9,"أوصلت صرم الحبل من","https://www.aldiwan.net/poem21910.html","مجزوء الكامل"],[73,"للحب في تلك القباب مراد","https://www.aldiwan.net/poem11948.html","الكامل"],[93,"بني أخي هيا بنا نلعب","https://www.aldiwan.net/poem11081.html","السريع"],[93,"لذكراك يا حفني في النفس أشجان","https://www.aldiwan.net/poem11210.html","الطويل"],[93,"لانت صلاب العزائم","https://www.aldiwan.net/poem11341.html","المجتث"],[93,"عزمات نحاس إذا جاورتها","https://www.aldiwan.net/poem11354.html","الكامل"],[30,"ألم تسأل اليوم الرسوم الدوارس","https://www.aldiwan.net/poem29577.html","الطويل"],[30,"لمية أطلال بحزوى دوائر","https://www.aldiwan.net/poem29586.html","الطويل"],[4,"إن تقوى ربنا خير نفل","https://www.aldiwan.net/poem21191.html","الرمل"],[72,"ليل وصل معطر الأرجاء","https://www.aldiwan.net/poem18169.html","الخفيف"],[72,"أعدى بغيركم دمع المحبينا","https://www.aldiwan.net/poem20172.html","البسيط"],[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"شاب رأسي ولات حين مشيب","https://www.aldiwan.net/poem8148.html","الخفيف"],[51,"أرواح فيك سعوط لا يقام له","https://www.aldiwan.net/poem64950.html","البسيط"],[51,"أعقب القرب من حبيبك شحط","https://www.aldiwan.net/poem65005.html","الخفيف"],[51,"ألذ من فائقة الإبهط","https://www.aldiwan.net/poem65027.html","الرجز"],[51,"أمون من العظعاظ عند مروقها","https://www.aldiwan.net/poem65078.html","الطويل"],[51,"يا عصمة لست منها باغيا بدلا","https://www.aldiwan.net/poem65886.html","البسيط"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[51,"رب أطلق يدي في كل شيخ","https://www.aldiwan.net/poem66498.html","الخفيف"],[91,"هم ألم به مع الظلماء","https://www.aldiwan.net/poem8725.html","عموديه"],[91,"دبت وقد أرخى الظلام ستارا","https://www.aldiwan.net/poem8861.html","عموديه"],[91,"من الفرنسيس قيد العين صورتها","https://www.aldiwan.net/poem8873.html","عموديه"],[89,"يا مصر فيك الشعر مات اميره","https://www.aldiwan.net/poem44744.html","الكامل"],[89,"البحر يغلى كان البحر بركان","https://www.aldiwan.net/poem44779.html","البسيط"],[85,"بعدت ديار واحتوتك ديار","https://www.aldiwan.net/poem7354.html","الكامل"],[85,"أخذت نعشك مصر باليمين","https://www.aldiwan.net/poem8186.html","الرمل"],[56,"في قلبه نار شوق ليس يخمدها","https://www.aldiwan.net/poem58592.html","البسيط"],[43,"فهمت الكتاب أبر الكتب","https://www.aldiwan.net/poem9461.html","المتقارب"],[62,"في قديم الدهر قد كان لنا","https://www.aldiwan.net/poem52162.html","الرمل"],[62,"حكماؤنا وصفوا لنا صنما","https://www.aldiwan.net/poem52165.html","أحذ الكامل"],[62,"يا قاتل الله معشرا ظلموا الحكمة","https://www.aldiwan.net/poem52237.html","المنسرح"],[45,"كفاني الله شرك يا صدود","https://www.aldiwan.net/poem63528.html","البسيط"],[66,"في فساد الأحوال لله سر","https://www.aldiwan.net/poem38540.html","الخفيف"],[66,"لئن ثلمت حدي صروف النوائب","https://www.aldiwan.net/poem41586.html","الطويل"],[97,"أنا لا أظل وكل شي","https://www.aldiwan.net/poem24967.html","مجزوء الكامل"],[80,"خطاب عن لقائكم يعوق","https://www.aldiwan.net/poem31361.html","الوافر"],[80,"عجبي من سكينتي ووقاري","https://www.aldiwan.net/poem31439.html","الخفيف"],[44,"نثرت فريد مدامع لم ينظم","https://www.aldiwan.net/poem30353.html","الكامل"],[87,"في قائم السيف إن عز الرضا حكم","https://www.aldiwan.net/poem8249.html","البسيط"],[69,"يا سائلي عن الكلام المنتظم","https://www.aldiwan.net/poem28850.html","الرجز"],[102,"يوم كنا نقول عاكسنا الده","https://www.aldiwan.net/poem33096.html","الخفيف"],[52,"كم غدوة وعشيه","https://www.aldiwan.net/poem26570.html","المجتث"],[52,"ما ذقت طعم النوى لو تدري","https://www.aldiwan.net/poem26951.html","السريع"],[52,"لا ورمان النهود","https://www.aldiwan.net/poem27094.html","مجزوء الرمل"],[75,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[48,"أسأل القادمين من حكمان","https://www.aldiwan.net/poem65322.html","الخفيف"],[48,"يا ليلة بت في دياجيها","https://www.aldiwan.net/poem66173.html","المنسرح"],[46,"لا كانت الدنيا فليس يسرني","https://www.aldiwan.net/poem22411.html","الكامل"],[46,"دنياك مثل سراب إن ظننت بها","https://www.aldiwan.net/poem23134.html","البسيط"],[76,"كم ألحم السيف في أبناء ملحمة","https://www.aldiwan.net/poem39314.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85481","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85339","الكامل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125577","الرجز"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39674","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39683","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42540","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54781","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54717","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54653","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54722","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141937","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43748","الخفيف"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10238","الكامل"],[100,"سياح الرماد","https://www.poetsgate.com/ViewPoem.aspx?id=50398",""],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[80,"عجبي من سكينتي وَوَقَاري","https://www.poetsgate.com/ViewPoem.aspx?id=3243",""],[91,"معركة شمولبو","https://www.poetsgate.com/ViewPoem.aspx?id=53085",""],[100,"سياح الرماد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67651&r=&rc=138",""]],"verses":[["في قَميصِ اللَيلِ عَبقَةُ مَن","ظَنَّ أَنَّ الوَصلَ كِتمانُ",0,"ن",1,0],["في قُنَّةٍ عَيطاءَ مَمطولَةٍ","كَأَنَّها قُلَّةُ رَأسٍ حَليق",1,"ق",1,0],["في قِتالٍ كانَ لِلطَي","رِ عَلى قَتلاهُ صُلحُ",2,"ح",1,1],["في قُبَّةٍ حَمراءَ زَيَّ","نَها اِئتِلاقُ طِبابِها",3,"ب",3,0],["في قَصرِ مَلكٍ كَالسَديرِ أَو الَّذي","ناطَت بِهِ شُرُفاتِها سِندادُ",4,"د",1,0],["في قبع مدت إلى كتفه","وجبةً قدت إلى نصفه",5,"ه",1,0],["فَيَقْتَحِمُوا الأَخْطَارَ عُوْلاً وَمَا بِهِمْ","أَيُرْدَى كُهُولٌ أَوْ يُعَاجِلُ وِلَدانُ",6,"ن",1,0],["فِي قَيْدِ خَزٍّ رَقِيقٍ","وَقَدْ تُفَكُّ الأَدَاهِمْ",7,"م",1,0],["فِي قَلْبِ صَاحِبِهِ هَوىً هُوَ شُغْلُهُ","وَهْوَ الحَلالُ وَمَا عَدَاهُ حَرامُ",8,"م",1,0],["فَيُقبِلنَ إِرباباً وَيَعرِضنَ رَهبَةً","صُدودَ العَذارى واجَهَتها المَجالِسُ",9,"س",1,0],["فَيَقبِضنَ مِن عادٍ وسادٍ وَواخِدٍ","كَما اِنصاعَ بِالسيِّ النَعامُ النَوافِرُ",10,"ر",1,0],["في قُرومٍ سادَةٍ مِن قَومِهِ","نَظَرَ الدَهرُ إِلَيهِم فَاِبتَهَل",11,"ل",1,0],["في قفارٍ يخافُ في أُفقها البر","قُ سرًى فهو خافق الأحشاء",12,"ا",2,0],["في قبلة العشق أو ميدان حليته","نحن المصلون أو نحن المجلّونا",13,"ن",2,0],["فيقولان إنّ موضعَ مولا","ك عَميراً أشفُّ منه خلاءَ",14,"ا",2,0],["في قناعٍ من المشيبِ لَبيسٍ","ورداءٍ من الشباب قشيبِ",15,"ب",1,0],["في قفدِ رأسكَ تنجيشٌ لقافدِهِ","وفي التَغافل منا عنكَ إرماضُ",16,"ض",1,0],["فيقبضُ في عُثنونِه نفحاتِها","فيا لك من كبش على شكله رُبط",17,"ط",1,0],["في قريةٍ من قَرَياتِ القبْطِ","بسرَّ من را في نسيم الشط",18,"ط",1,0],["فيقضي المُذَكِّي في الصريع قضاءَهُ","وهاتيك يأبى غربُها أن تُوَرَّعا",19,"ع",2,0],["في قاسمٍ خادمٌ كافٍ كفاكَ به","كأنَّه لك من بين الوَرى جُبِلا",20,"ل",2,0],["في قريضٍ له على الرأي جزلٍ","قاله في هجاء عبدِ المدان",21,"ن",1,0],["في قَلَنْساتِهِ من القُطن ما يم","لأ عِدلاً يُخال من عُثنونه",22,"ن",2,0],["في قَلبِهِ نارُ الخَليلِ وَإِنَّما","في وَجنَتَيهِ أَدمُعُ الخَنساءِ",23,"ا",2,0],["في قَلبِهِ نار وَفي أَحشائِها","مِثلُ الَّذي في نَفسِهِ قَد ثارا",24,"ر",2,0],["في قَريَةٍ مِن قُرى باريسَ ما صَغُرَت","عَنِ الفَتاة وَلَكِن هَمُّها كَبُرا",25,"ر",2,0],["في قلب مصر وبالجزيرة ياس","كادت به تتقطع الانفاس",26,"س",1,0],["في قبره حكمة روعاء صامتة","وفوقه من صنوف الزهر الوان",27,"ن",1,0],["في قُلَّبٍ ما للرفاق وسيلة","فيه ولا لهمو عليه خيار",28,"ر",1,0],["فَيُقالُ الأُمُّ في مَوكِبِها","وَيُقالُ الحَرَمُ العالي المَصون",29,"ن",1,0],["في قَلْبِهِ نارُ شَوقٍ ليسَ يُخْمِدُهَا","بَحْرٌ أَحَاطَ بِهِ للدَّمْعِ مَسْجُورُ",30,"ر",1,1],["فَيَقلَقَ مِنهُ البَعيدُ الأَناةِ","وَيَغضَبَ مِنهُ البَطيءُ الغَضَب",31,"ب",1,0],["في قديم الدهر قد كان لنا","ملك رام دخول الظلمات",32,"ت",1,1],["في قدّ إنسانٍ عُلاوتُه","والمنكبان عليهما كرمُ",33,"م",1,0],["في قولهم تكوين ما طلبوا","إن قلبوا كل شيء انقلبا",34,"ب",2,0],["فَيُقبِلُ مُدبِرٌ وَلّى حَميداً","وَيَنقَطِعُ الصُدودُ فَلا يَعودُ",35,"د",1,0],["فَيَقولُ الجُهّالُ قَد فَسَدَ الأَم","رُ وَذاكَ الفَسادُ عَينُ الصَلاحِ",36,"ح",1,0],["فَيُقبِلُ في بُطءٍ كَخُطوَةِ سارِقٍ","وَيُدبِرُ في جَريٍ كَرَكضَةِ هارِبِ",37,"ب",1,0],["في قاتم محلولك","سدّت علي به المسالك",38,"ك",1,0],["فيقبض بُعْدَنا ليلٌ عَدوٌّ","ويبسط قُربَنا يومٌ صديقُ",39,"ق",1,0],["في قَميصِ الشَّرابِ مِنهُما شعاعٌ","يُبْرِدُ الهَمَّ وهوَ عَيْنُ الأوارِ",40,"ر",1,0],["في قُلِّهِ كُثرُ السِماكِ وَإِن غَدا","هَطِلاً وَعَفوُ يَديهِ جُهدُ المِرزَمِ",41,"م",1,0],["فِي قَائِمِ السَّيْفِ إِنْ عَزَّ الرِّضَا حَكَمُ","فَالْحُكْمُ لِلسَّيْفِ إِنْ لَمْ تَصْدَعِ الْكَلِمُ",42,"م",1,1],["في قدِّه ما هوَ في الأغصانِ","على اختلافِ الوضعِ والمباني",43,"ي",1,0],["فَيَقولون اِتّق اللَه وَاِقنَع","كَم تَظلّمت طامِعاً يا ظَلومُ",44,"م",1,0],["في قُرطَقٍ خَصَّرَتهُ","مَناطِقٌ ذَهَبِيَّه",45,"ي",2,0],["في قَمَرٍ مُشرِقٍ نِصفُهُ","كَأَنَّهُ مَحرَقَةُ العِطرِ",46,"ر",1,0],["في قَباءٍ فاخِتيِّ ال","لَونِ مِن لُبسٍ جَديدِ",47,"د",1,0],["فيَقرنَ الفصْلَ بالحَفل الجميع ضُحًى","وتُحْفَةَ الحربِ بالأسلابِ والنَّفَل",48,"ل",1,0],["فَيَقولونَ لي جِنانُ كَما سَر","رَكَ عَن حالِها فَسَل عَن جِنانِ",49,"ن",1,0],["في قُرطُقٍ زانَهُ تَخَرسُنُها","قَد عَقرَبَت صُدغَها مَداريها",50,"ي",3,0],["فَيَقولُ ناسٌ سَوفَ يُدرِكُها الرَدى","وَيَمينُ قَومٌ لا يَجوزُ هُمودُها",51,"د",3,0],["في قَبضَةِ اللَهِ أَعمارٌ مُقَسَّمَةٌ","لَها إِذا شاءَ تَقصيرٌ وَتَطويلُ",52,"ل",1,0],["في قَسطَلٍ مِنْ عَجاج الحَرْبِ مُدَّ لَهُ","بَينَ السَّماءِ وبَيْنَ الأَرْضِ أَسْتارُ",53,"ر",1,0],["فيقيم فيه حيث لَم","يك قبل ذلك بالمُقيم",54,"م",1,0],["في قَلب من يحيا عَلى ضيق به","يأس يخيم تارة وَرَجاء",55,"ا",2,0],["في قفصٍ يحلمُ بال","أفق فيلقَى القُضُبا",56,"ب",2,0],["في قصة مرّة حوتها","ملهاته الحلوة الطروب",57,"ب",1,0],["في قرية محصورة كسفينة","في لجة هاجت وماج غضوبها",58,"ب",3,0],["فِي قَفْرَةٍ لِلصِّلالِ مُزْدحَفٌ","فِيها ولِلضّارِياتِ مُضْطَرَبُ",59,"ب",1,0],["فِي قَلْبِهَا حُبُّ الْحَيَاةِ طَلِيقَةً","لَكِنَّهَا تَخْشَى أَذَى الإِظْهَارِ",60,"ر",1,0],["فِي قَوَافٍ بِهِنَّ تَنْطِقُ لَوْ أُوْ","تِيَتِ النطْقَ أَلسُنُ الأَحْقَادِ",61,"د",1,0],["فِي قُرَى الرَّيفِ حَيْثُ طُوِّ","فْتَ أَنْغَامَ سُرُورِ إِلى السَّمِاءِ تُصَعَّدْ",62,"د",1,0],["فِي قَوَافِيهِ كُلُّ آنِسَةٍ تُطمِ","عُ لُطْفاً وَكُلُّ رُودٍ شَرُودِ",63,"د",1,0],["فِي قَلْبِيَ الْبَدْرُ الَّذِي لَنْ يُجْتَلَى","مِنْهُ سِوَى شَفَقٌ بِوَجِهِي شَاحِبِ",64,"ب",1,0],["فِي قَوْلِهِ الرَّنَّانِ كُلُّ غَرِيبَةٍ","مِن جَأْرِ ذِي لُبَدٍ وَصَوْتِ مُغَردِ",65,"د",1,0],["في قبةٍ من جلالٍ أنت رافعُها","ورَيوَةٍ من جمالٍ أنتَ كاسيها",66,"ي",3,0],["فَيَقولونَ كُلّ بَدرٍ هِلالٌ","عِندَ هذا وَكُلُّ كَهلٍ غُلامُ",67,"م",1,0],["فَيَقولُ قائِلُهُم سَلوني قَبلَ أَن","تُدهَوا بِفِقداني وَحينَ وَفاتي",68,"ي",1,0],["فيقذفه سفر حالم ... إلى سفر ، من رؤى (شهرزاد)","وتجترّه من غيوم الصّديد ... بلاد من الطيب ، في لا بلاد",69,"د",1,0],["فيقولون: قد تطيحُ من العارِ","بيوتٌ وقد تثورُ حروب",70,"ب",1,0],["فيقولونَ : كلُّ شيءٍ صريحٍ","عندنا – عندكم خليطٌ مَشوب",70,"ب",1,0],["في قميص الشراب منها شعاعٌ","يُبْرِدُ الهمَّ وهو عَيْنُ الأوار",71,"ر",1,0],["في قبله نار وفي أحشائها","مثل الذي في نفسه قد ثارا",72,"ر",2,0],["فيقذفه سفر حالم","إلى سفر ، من رؤى (شهرزاد)",73,"د",1,0]]}