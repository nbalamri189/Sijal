.aldiwan.net/poem24486.html","عموديه"],[536,"سجنت نفسي بيدي","https://www.aldiwan.net/poem47500.html","عموديه"],[536,"عفوا إذا أكثرت من إنشادي","https://www.aldiwan.net/poem48209.html","عموديه"],[549,"أرني العجائب يا أباها","https://www.aldiwan.net/poem47144.html","مجزوء الكامل"],[549,"رضينا من عدانك بالمطال","https://www.aldiwan.net/poem47296.html","الوافر"],[549,"ما لي تطيح الدهر أخياري","https://www.aldiwan.net/poem47788.html","البسيط"],[556,"اصبر على ضر البلايا","https://www.aldiwan.net/poem33572.html","مجزوء الكامل"],[556,"أتعبتني بقر الشام","https://www.aldiwan.net/poem34182.html","المديد"],[556,"لبسنتني مليحة الغيب مرطا","https://www.aldiwan.net/poem34406.html","الخفيف"],[556,"إني أنا بك يا ودود","https://www.aldiwan.net/poem34580.html","مجزوء الكامل"],[560,"نحن التراب إلى تراب نرجع","https://www.aldiwan.net/poem52741.html","الكامل"],[560,"دعني فلست على الزمان بعاتب","https://www.aldiwan.net/poem52746.html","الكامل"],[560,"يستجمع الشمل في الدنيا وينصدع","https://www.aldiwan.net/poem52812.html","البسيط"],[560,"في قبة الأفلاك شمس تطلع","https://www.aldiwan.net/poem52820.html","الكامل"],[560,"لاحت بوجه بديع الأنس ميمون","https://www.aldiwan.net/poem52847.html","البسيط"],[560,"إن قلت ويحك فافعل أيها الرجل","https://www.aldiwan.net/poem52932.html","البسيط"],[560,"قد طلع البدر من المغرب","https://www.aldiwan.net/poem52981.html","السريع"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[571,"الله أكبر هذا وجه إسحاقا","https://www.aldiwan.net/poem3645.html","البسيط"],[573,"على كل حال ليس لي عنك مذهب","https://www.aldiwan.net/poem3109.html","الطويل"],[584,"ما عذلك في الهوى له مستند","https://www.aldiwan.net/poem17483.html","الدوبيت"]],"verses":[["في قَميصِ اللَيلِ عَبقَةُ مَن","ظَنَّ أَنَّ الوَصلَ كِتمانُ",0,"ن",1,0],["في قُنَّةٍ عَيطاءَ مَمطولَةٍ","كَأَنَّها قُلَّةُ رَأسٍ حَليق",1,"ق",1,0],["في قِتالٍ كانَ لِلطَي","رِ عَلى قَتلاهُ صُلحُ",2,"ح",1,1],["في قُبَّةٍ حَمراءَ زَيَّ","نَها اِئتِلاقُ طِبابِها",3,"ب",3,0],["في قَصرِ مَلكٍ كَالسَديرِ أَو الَّذي","ناطَت بِهِ شُرُفاتِها سِندادُ",4,"د",1,0],["في قبع مدت إلى كتفه","وجبةً قدت إلى نصفه",5,"ه",1,0],["فَيَقْتَحِمُوا الأَخْطَارَ عُوْلاً وَمَا بِهِمْ","أَيُرْدَى كُهُولٌ أَوْ يُعَاجِلُ وِلَدانُ",6,"ن",1,0],["فِي قَيْدِ خَزٍّ رَقِيقٍ","وَقَدْ تُفَكُّ الأَدَاهِمْ",7,"م",1,0],["فِي قَلْبِ صَاحِبِهِ هَوىً هُوَ شُغْلُهُ","وَهْوَ الحَلالُ وَمَا عَدَاهُ حَرامُ",8,"م",1,0],["فَيُقبِلنَ إِرباباً وَيَعرِضنَ رَهبَةً","صُدودَ العَذارى واجَهَتها المَجالِسُ",9,"س",1,0],["فَيَقبِضنَ مِن عادٍ وسادٍ وَواخِدٍ","كَما اِنصاعَ بِالسيِّ النَعامُ النَوافِرُ",10,"ر",1,0],["في قُرومٍ سادَةٍ مِن قَومِهِ","نَظَرَ الدَهرُ إِلَيهِم فَاِبتَهَل",11,"ل",1,0],["في قفارٍ يخافُ في أُفقها البر","قُ سرًى فهو خافق الأحشاء",12,"ا",2,0],["في قبلة العشق أو ميدان حليته","نحن المصلون أو نحن المجلّونا",13,"ن",2,0],["فيقولان إنّ موضعَ مولا","ك عَميراً أشفُّ منه خلاءَ",14,"ا",2,0],["في قناعٍ من المشيبِ لَبيسٍ","ورداءٍ من الشباب قشيبِ",15,"ب",1,0],["في قفدِ رأسكَ تنجيشٌ لقافدِهِ","وفي التَغافل منا عنكَ إرماضُ",16,"ض",1,0],["فيقبضُ في عُثنونِه نفحاتِها","فيا لك من كبش على شكله رُبط",17,"ط",1,0],["في قريةٍ من قَرَياتِ القبْطِ","بسرَّ من را في نسيم الشط",18,"ط",1,0],["فيقضي المُذَكِّي في الصريع قضاءَهُ","وهاتيك يأبى غربُها أن تُوَرَّعا",19,"ع",2,0],["في قاسمٍ خادمٌ كافٍ كفاكَ به","كأنَّه لك من بين الوَرى جُبِلا",20,"ل",2,0],["في قريضٍ له على الرأي جزلٍ","قاله في هجاء عبدِ المدان",21,"ن",1,0],["في قَلَنْساتِهِ من القُطن ما يم","لأ عِدلاً يُخال من عُثنونه",22,"ن",2,0],["في قَلبِهِ نارُ الخَليلِ وَإِنَّما","في وَجنَتَيهِ أَدمُعُ الخَنساءِ",23,"ا",2,0],["في قَلبِهِ نار وَفي أَحشائِها","مِثلُ الَّذي في نَفسِهِ قَد ثارا",24,"ر",2,0],["في قَريَةٍ مِن قُرى باريسَ ما صَغُرَت","عَنِ الفَتاة وَلَكِن هَمُّها كَبُرا",25,"ر",2,0],["في قلب مصر وبالجزيرة ياس","كادت به تتقطع الانفاس",26,"س",1,0],["في قبره حكمة روعاء صامتة","وفوقه من صنوف الزهر الوان",27,"ن",1,0],["في قُلَّبٍ ما للرفاق وسيلة","فيه ولا لهمو عليه خيار",28,"ر",1,0],["فَيُقالُ الأُمُّ في مَوكِبِها","وَيُقالُ الحَرَمُ العالي المَصون",29,"ن",1,0],["في قَلْبِهِ نارُ شَوقٍ ليسَ يُخْمِدُهَا","بَحْرٌ أَحَاطَ بِهِ للدَّمْعِ مَسْجُورُ",30,"ر",1,1],["فَيَقلَقَ مِنهُ البَعيدُ الأَناةِ","وَيَغضَبَ مِنهُ البَطيءُ الغَضَب",31,"ب",1,0],["في قديم الدهر قد كان لنا","ملك رام دخول الظلمات",32,"ت",1,1],["في قدّ إنسانٍ عُلاوتُه","والمنكبان عليهما كرمُ",33,"م",1,0],["في قولهم تكوين ما طلبوا","إن قلبوا كل شيء انقلبا",34,"ب",2,0],["فَيُقبِلُ مُدبِرٌ وَلّى حَميداً","وَيَنقَطِعُ الصُدودُ فَلا يَعودُ",35,"د",1,0],["فَيَقولُ الجُهّالُ قَد فَسَدَ الأَم","رُ وَذاكَ الفَسادُ عَينُ الصَلاحِ",36,"ح",1,0],["فَيُقبِلُ في بُطءٍ كَخُطوَةِ سارِقٍ","وَيُدبِرُ في جَريٍ كَرَكضَةِ هارِبِ",37,"ب",1,0],["في قاتم محلولك","سدّت علي به المسالك",38,"ك",1,0],["فيقبض بُعْدَنا ليلٌ عَدوٌّ","ويبسط قُربَنا يومٌ صديقُ",39,"ق",1,0],["في قَميصِ الشَّرابِ مِنهُما شعاعٌ","يُبْرِدُ الهَمَّ وهوَ عَيْنُ الأوارِ",40,"ر",1,0],["في قُلِّهِ كُثرُ السِماكِ وَإِن غَدا","هَطِلاً وَعَفوُ يَديهِ جُهدُ المِرزَمِ",41,"م",1,0],["فِي قَائِمِ السَّيْفِ إِنْ عَزَّ الرِّضَا حَكَمُ","فَالْحُكْمُ لِلسَّيْفِ إِنْ لَمْ تَصْدَعِ الْكَلِمُ",42,"م",1,1],["في قدِّه ما هوَ في الأغصانِ","على اختلافِ الوضعِ والمباني",43,"ي",1,0],["فَيَقولون اِتّق اللَه وَاِقنَع","كَم تَظلّمت طامِعاً يا ظَلومُ",44,"م",1,0],["في قُرطَقٍ خَصَّرَتهُ","مَناطِقٌ ذَهَبِيَّه",45,"ي",2,0],["في قَمَرٍ مُشرِقٍ نِصفُهُ","كَأَنَّهُ مَحرَقَةُ العِطرِ",46,"ر",1,0],["في قَباءٍ فاخِتيِّ ال","لَونِ مِن لُبسٍ جَديدِ",47,"د",1,0],["فيَقرنَ الفصْلَ بالحَفل الجميع ضُحًى","وتُحْفَةَ الحربِ بالأسلابِ والنَّفَل",48,"ل",1,0],["فَيَقولونَ لي جِنانُ كَما سَر","رَكَ عَن حالِها فَسَل عَن جِنانِ",49,"ن",1,0],["في قُرطُقٍ زانَهُ تَخَرسُنُها","قَد عَقرَبَت صُدغَها مَداريها",50,"ي",3,0],["فَيَقولُ ناسٌ سَوفَ يُدرِكُها الرَدى","وَيَمينُ قَومٌ لا يَجوزُ هُمودُها",51,"د",3,0],["في قَبضَةِ اللَهِ أَعمارٌ مُقَسَّمَةٌ","لَها إِذا شاءَ تَقصيرٌ وَتَطويلُ",52,"ل",1,0],["في قَسطَلٍ مِنْ عَجاج الحَرْبِ مُدَّ لَهُ","بَينَ السَّماءِ وبَيْنَ الأَرْضِ أَسْتارُ",53,"ر",1,0],["فيقيم فيه حيث لَم","يك قبل ذلك بالمُقيم",54,"م",1,0],["في قَلب من يحيا عَلى ضيق به","يأس يخيم تارة وَرَجاء",55,"ا",2,0],["في قفصٍ يحلمُ بال","أفق فيلقَى القُضُبا",56,"ب",2,0],["في قصة مرّة حوتها","ملهاته الحلوة الطروب",57,"ب",1,0],["في قرية محصورة كسفينة","في لجة هاجت وماج غضوبها",58,"ب",3,0],["فِي قَفْرَةٍ لِلصِّلالِ مُزْدحَفٌ","فِيها ولِلضّارِياتِ مُضْطَرَبُ",59,"ب",1,0],["فِي قَلْبِهَا حُبُّ الْحَيَاةِ طَلِيقَةً","لَكِنَّهَا تَخْشَى أَذَى الإِظْهَارِ",60,"ر",1,0],["فِي قَوَافٍ بِهِنَّ تَنْطِقُ لَوْ أُوْ","تِيَتِ النطْقَ أَلسُنُ الأَحْقَادِ",61,"د",1,0],["فِي قُرَى الرَّيفِ حَيْثُ طُوِّ","فْتَ أَنْغَامَ سُرُورِ إِلى السَّمِاءِ تُصَعَّدْ",62,"د",1,0],["فِي قَوَافِيهِ كُلُّ آنِسَةٍ تُطمِ","عُ لُطْفاً وَكُلُّ رُودٍ شَرُودِ",63,"د",1,0],["فِي قَلْبِيَ الْبَدْرُ الَّذِي لَنْ يُجْتَلَى","مِنْهُ سِوَى شَفَقٌ بِوَجِهِي شَاحِبِ",64,"ب",1,0],["فِي قَوْلِهِ الرَّنَّانِ كُلُّ غَرِيبَةٍ","مِن جَأْرِ ذِي لُبَدٍ وَصَوْتِ مُغَردِ",65,"د",1,0],["في قبةٍ من جلالٍ أنت رافعُها","ورَيوَةٍ من جمالٍ أنتَ كاسيها",66,"ي",3,0],["فَيَقولونَ كُلّ بَدرٍ هِلالٌ","عِندَ هذا وَكُلُّ كَهلٍ غُلامُ",67,"م",1,0],["فَيَقولُ قائِلُهُم سَلوني قَبلَ أَن","تُدهَوا بِفِقداني وَحينَ وَفاتي",68,"ي",1,0],["فيقذفه سفر حالم ... إلى سفر ، من رؤى (شهرزاد)","وتجترّه من غيوم الصّديد ... بلاد من الطيب ، في لا بلاد",69,"د",1,0],["فيقولون: قد تطيحُ من العارِ","بيوتٌ وقد تثورُ حروب",70,"ب",1,0],["فيقولونَ : كلُّ شيءٍ صريحٍ","عندنا – عندكم خليطٌ مَشوب",70,"ب",1,0],["في قميص الشراب منها شعاعٌ","يُبْرِدُ الهمَّ وهو عَيْنُ الأوار",71,"ر",1,0],["في قبله نار وفي أحشائها","مثل الذي في نفسه قد ثارا",72,"ر",2,0],["فيقذفه سفر حالم","إلى سفر ، من رؤى (شهرزاد)",73,"د",1,0],["في قَريض حَسَن الصو","رة بِالهَجو مُجذَّم",74,"م",1,0],["فيقول أيّ الحالتي","ن أشدُّ هجرٌ أم بعادُ",75,"د",1,0],["في قبضة القائم المنصور قائمُهُ","وشَفرتاهُ من الأعداء في القُللِ",76,"ل",1,0],["في قَتلِكَ الأَسَدَ الَّذي راعَ الوَرى","لَولا سَفاهَةُ شِبلِهِ ما يَردَعُ",77,"ع",1,0],["فيقول أرباب البطالة تنثني","ويقول أرباب الحقيقة تسجد",78,"د",1,0],["فَيَقرُبُ مِن دارِ الحَبيبِ بَعيدُها","وَمَهما طَلَبناها فَعِزَّ وُجودُها",79,"ه",2,0],["في قَمَرٍ كَأ