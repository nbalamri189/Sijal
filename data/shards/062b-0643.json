tabudhabi.ae/diwan/poem/72423","الوافر"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35097","الطويل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52167","الرمل"],[4775,"من ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=175185",""],[4778,"ثكالى في الفرات لها عويل","https://www.poetsgate.com/ViewPoem.aspx?id=188141",""],[4852,"يا عرَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=214452",""],[4935,"شرف الرجال فضائل العرفان","https://www.poetsgate.com/ViewPoem.aspx?id=129366",""],[5121,"عاصفة","https://www.poetsgate.com/ViewPoem.aspx?id=33598",""],[5121,"عَرُوسُ النُّورِ / بيروت","https://www.poetsgate.com/ViewPoem.aspx?id=215366",""],[5273,"حلب","https://www.poetsgate.com/ViewPoem.aspx?id=180619",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[592,"تلألأ نور الحق في الخلق واستما","https://www.poetsgate.com/ViewPoem.aspx?id=128815",""],[592,"ألا قل لأهل الجهل من كل من قد طغى","https://www.poetsgate.com/ViewPoem.aspx?id=128809",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[592,"هجاء غبي جاهل ذي حماقة","https://www.poetsgate.com/ViewPoem.aspx?id=128800",""],[5410,"ألوان باهتة","https://www.poetsgate.com/ViewPoem.aspx?id=133055",""],[5411,"ضجيج الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=185306",""],[5431,"كافكا والكابوس الوجودي المرعب....","https://www.poetsgate.com/ViewPoem.aspx?id=199352",""],[5431,"قد خُلقنا ملائكا في الطراز","https://www.poetsgate.com/ViewPoem.aspx?id=200154",""],[5605,"مرثية محمود درويش","https://www.poetsgate.com/ViewPoem.aspx?id=159623",""],[5626,"يحيا العراق","https://www.poetsgate.com/ViewPoem.aspx?id=189695",""],[2110,"ثقل الملام وطالت الأبحاث","https://www.poetsgate.com/ViewPoem.aspx?id=156266",""],[5660,"لَعَمرُكَ ما يُغني البُكى وَ التَوَجُّعُ","https://www.poetsgate.com/ViewPoem.aspx?id=28435",""],[5894,"ثبت الغرام وفي فؤادي يحدث","https://www.poetsgate.com/ViewPoem.aspx?id=131413",""],[6031,"أَبا هَاشمٍ أُنهِي إليكَ تحيةً","https://www.poetsgate.com/ViewPoem.aspx?id=46265",""],[6345,"جور الزمان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78653&r=&rc=24",""],[6355,"أسيرة الشك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66650&r=&rc=110",""]],"verses":[["ثكلى تلوى على وقع السياط ضناً","حرى تلظى على أطفالها الخيم",0,"م",1,0],["ثَكِلَتكَ أَرضٌ لَم تَلِد لَكَ ثانِياً","أَنّى وَمِثلُكَ مُعوَذُ الميلادِ",1,"د",1,0],["ثَكِلْتُ وَفائي وهْوَ أكرَمُ صاحِبٍ","وخالَطْتُ إيماني بإيمانِ مُلْبِسِ",2,"س",1,0],["ثَكِلَ الطَّوْدُ لَيْثَهُ","فَهْوَ فِي مَأْتَمٍ عَمَمْ",3,"م",1,0],["ثَكِلتُ اِبنَتي إِن لَم يُقَطِّعكَ ماجِدٌ","حُسامٌ يَرُدُّ العَيرَ مِثلَكَ واحِما",4,"م",2,0],["ثكلتهمُ أما علموا بأني","خليعٌ أشتهي شرب العتيق",5,"ق",1,0],["ثَكِلتُ سُرُوري كُلَّه إذْ ثَكلتُهُ","وأصبحتُ في لذَّاتِ عيْشي أَخَا زُهْدِ",6,"د",1,0],["ثكلت إخاءك فهو العزي","ز إن لم أصن رغبتي في غلاف",7,"ف",1,0],["ثكِلت أمُّ منْ تعادي وما كن","تَ تعادي إلا بني مِثكالِ",8,"ل",1,0],["ثَكِلتِ الظَرفَ عاذِلَتي","أَهَذا الحُسنُ يُجتَنَبُ",9,"ب",1,0],["ثَكِلَ الشَرقُ فَتاهُ","لَيتَني كُنتُ فِداه",10,"ه",1,1],["ثُكلُ البِلادِ لَهُ عَقلٌ وَنَكبَتُها","هِيَ النَجابَةُ في الأَولادِ لا العَدَدُ",11,"د",1,0],["ثُكلُ الرِجالِ مِنَ البَنينِ وَإِنَّما","ثُكلُ المَمالِكِ فَقدُها العُلَماءَ",12,"ا",2,0],["ثُكلٌ وفُرقةُ أحبابٍ ومَرزأةٌ","في المالِ والأهل والأتباع والخَوَلِ",13,"ل",1,0],["ثَكِلَتكَ كافِرَةٌ أَتَت بِكَ فَجرَةً","أَلّا اِجتَنَبتَ العارِضَ المَجنوبا",14,"ب",2,0],["ثَكِلَتكُمُ أُمّاتُكُم أَفَلا يَدٌ","تُرعى أَلا وَصلٌ أَلا إِلمامُ",15,"م",1,0],["ثَكِلَتْكَ داميَةُ القَرا مجلودَةٌ","نَبَذَتْكَ خائِفَةً بغَيِر قِماطِ",16,"ط",1,0],["ثَكِلَ الوَرى طَرفي المُسَهَّدَ فَاِبعَثوا","طَيفَ الخَيالِ إِلَيَّ أَو لا تَبعَثوا",17,"ث",3,0],["ثكلى إذا أنَّت أُحِسُّ كأنها","راحت تدَوِّي في صميمِ عظامي",18,"م",2,0],["ثَكِلتُكَ يا أَخي أَن كُنتَ عِندي","صَحيحَ الأَمرِ لَو نِكتَ البِغالا",19,"ل",2,0],["ثَكِلتُ قَصائِدي إِن مَرَّ يَومٌ","وَلَمّا أَقضِ فيهِ مِنكَ نَحبا",20,"ب",2,0],["ثكلتَ آخرَ أعمارٍ تضيع سدى","فما تزيد على أيامنا الأُخَرِ",21,"ر",1,0],["ثكالى نظمن الدمع فيك مفصلا","كعهدك قبل اليوم إذ تنظم العقدا",22,"د",2,0],["ثَكِلْتُ طوائِفَ المُسْتَخْدَمِينا","فَلَمْ أَرَ فِيهمُ رَجُلاً أَمِينا",23,"ن",2,1],["ثكلْتُكِ شَمْساً من وَرَاء غَمامَةٍ","وجَنّةَ خُلْدٍ دونَها حالَ بَرزَخ",24,"خ",1,0],["ثَكَلتُ الظُرفَ وَالآدابَ إِن لَم","أُقِم لي حُجَّةً يَومَ الحِسابِ",25,"ب",1,0],["ثكلتهم أمهم ما","ذا بهذا قد أَرادوا",26,"د",3,0],["ثَكِلْنا الدُّنا لما اسْتَقَلَّ وإِنَّما","فقَدْناكَ يا خَيْرَ البَريّةِ ناعِبَا",27,"ب",2,0],["ثَكِلَتْ مِصْرُ مَنْ جَزِعَتْ عَلَيْهِ","ثُكْلَ أُمٍّ فقَلْبُهَا مَفْطُورُ",28,"ر",1,0],["ثُكلي عَلَيكَ اِستِماحُ عَيني","وَمَلأ الكُتبِ بِالمَراثي",29,"ث",2,0],["ثَكلتُ أَحبّائي فَهَل كُلُّ شامِتٍ","عَلى ثِقَةٍ أَن لا يُغَشّى الَّذي غَشّوا",30,"ش",3,0],["ثكلنا الدجى لما استقل وإننا","فقدناك يا خير البرية ناعبا",31,"ب",2,0],["ثَكِلَتكَ كافِرَةٌ أتَتْ بكَ فَجْرَةً،","ألاّ اجتَنَبْتَ العَارِضَ المَجْنُونَا",32,"ن",2,0],["ثَكَلَتني ام الصَبابة إِن كُن","ت أَرى سالياً لَهُ أَو نَسيّا",33,"ي",2,0],["ثَكِلتِ دُرَيداً إِن أَتَت لَكِ شَتوَةٌ","سِوى هَذِهِ حَتّى تَدورَ الدَوائِرُ",34,"ر",1,1],["ثَكِلتُ فُؤادِي إن تألَّم للأسَى","عَلَى عِلمِهِ أنَّ الحَوادِثَ تَحدُثُ",35,"ث",1,0],["ثَكِلتهُمُ الأَعداءُ إِنَّ حَياتَهُم","غَمُّ الصَّديقِ وَفَرحَةُ الأَعداءِ",36,"ا",2,0],["ثَكِلتُهُم ثُكلَ عَينٍ ما تَبَطَّنَها","مِنَ القَذى أَو كَثُكلِ العُضوِ لِلوَجَعِ",37,"ع",1,0],["ثَكِلَتكَ أمُّكَ أيّ إثمٍ","في التمازجِ أيُّ عارِ",38,"ر",1,0],["ثكلتك ثُكْلَ المَشْرَفِيِّ غُروبَهُ","وبالغَرْبِ يَسطو المشرفيُّ المهند",39,"د",1,0],["ثكلتُ يراعي ان تركت على الشجى","ضنى كبدٍ لم استجدَّ لهُ وجدا",40,"د",2,0],["ثَكِلتُكَ أَيَّ جَميلٍ رَأَي","تَ مِن ذَلِكَ النَذلَ في صُحبَتِه",41,"ت",2,0],["ثكلتْ مقلتُهُ طيبَ الكرى","هَلْ عَلَى الثاكلِ لومٌ في البكا",42,"ا",1,1],["ثَكلى عَوانٍ بِدُوّارٍ مُؤَلَّفَةٍ","هاجَ القَنيصُ عَلَيها بَعدَما اِقتَرَبا",43,"ب",2,1],["ثكلت إذا نفسي وعزي وأسرتي","بفقدي ولا أدركت ما كنت أطلب",44,"ب",1,0],["ثكلت الهدى إن كان ذا فعل أهله","وذقت الردى إن كان ذا فعل حازم",45,"م",1,0],["ثكلتكم أين التناصح للهدى","وأين التسامي للعلى والمفاخر",46,"ر",1,0],["ثَكولٌ ولا دمعٌ لها إثرَ هالكٍ","وكلُّ رَقوبٍ ثاكلٍ دمعُها هَمْرُ",47,"ر",1,0],["ثكلتك ليس لي في اللهو عذر","وقد لاح المشيب على عذاري",48,"ر",2,0],["ثكلتُ محباً غيَّر النأي عهدهُ","وأم كان شيء لا يدوم على عهد",49,"د",1,0],["ثكلتُ الهوى لولاه لم أبعِ النهى","بجهلٍ ولا اخترت الضلال على الهدى",50,"د",2,0],["ثكلته بعدما صارت محاسنه","في العظم واللحم سير الماءِ في الغصنِ",51,"ن",1,0],["ثَكِلتُكُما إِن لَم أَكُن قَد رَأَيتُها","كَراديسَ يُهديها إِلى الحَيِّ كَوكَبُ",52,"ب",1,0],["ثكِلتْ خليلاً صِرْتُ من بَعْدِ ثُكْله","فُرَادَى وجاءَ الهمُّ من بَعدِه مَثْنَى",53,"ن",2,0],["ثكلتكِ بدراً في فؤادِي شروقُه","وفاكهةً في جنةِ الخلد نبْتُها",54,"ت",3,0],["ثكلتُكَ رَأْياً كان عقبي قبوله","سرورَ قلوبٍ للعِدَى وعُين",55,"ن",1,0],["ثَكِلَتكَ يا اِبنَ العَبدِ أُمُّكَ سادِراً","أَبِساحَةِ المَلِكِ الهُمامِ تَمَرَّسُ",56,"س",1,0],["ثَكَلتك أُمك إِنَّما فَخر الفَتى","بِإِغاثة المَلهوف عِند نداء",57,"ا",2,0],["ثكلتك مَن ذا بعدها يَرتجي الوفا","ويا رُبَّ مغرور يُخادَع بالبشر",58,"ر",1,0],["ثكل الشباب الغضَّ في ريعانه","وذوى كغصن الدوحة الصديان",59,"ن",1,0],["ثَكلت الخلي لَم يَذق لَوعة الجَوى","وَلَم يَدرِ أَن الصبر يُدعى فيخلف",60,"ف",1,0],["ثَكِلَتكُما الأَعداءُ ثُكلاً عاجِلاً","يا غُصَّةَ الإِخوانِ وَالجِيرانِ",61,"ن",1,0],["ثكلتك امك ان بقيت على الخطا","متماديا متعاميا متثبطا",62,"ط",2,1],["ثَكَلَتْكَ أُمُّكَ هَبْكَ مِنْ بَقَرِ الفَلا","ما كُنْتَ تَغْلَطُ مَرَّةً بِصَوابِ",63,"ب",1,0],["ثَكِلتُ القَوافي وَهيَ أَبناءُ خاطِري","وَغَيَّبَها الإِقحامُ عَنِّيَ في لَحدِ",64,"د",1,0],["ثكلته مناصب عاليات","كان فيها موفقا وحريّا",65,"ي",2,0],["ثكلته مناقب باكيات","مترعات بدمعها المدرارِ",66,"ر",1,0],["ثَكلى ثَلاثاً ثُمَّ تَظهَرُ بَعدَها","عَينٌ مُكحَّلَةٌ وَجيدٌ أَتلَعُ",67,"ع",1,0],["ثكلُ أمِّ القريض فيك عظيمٌ","ولأمّ الصلاح أعظم ثكلا",68,"ل",2,0],["ثكلتُكَ بسَّامَ المحيَّا طليقه","فبعدك وجهُ الدهر جهمٌ مقطَّبُ",69,"ب",1,0],["ثكلتك حين استعظلَ الخطبُ واحداً","أرى كلّ عضو منك يُغني عن الألفِ",70,"ف",1,0],["ثَكَلْتُ إن لم تكنْ تُعْزَى القناعةُ لي","فحرُّ وجْهِيَ ثوبٌ لستُ أُخْلِقُه",71,"ق",2,0],["ثَكالَى يُرَدِّدْنَ من شَجْوِهِنَّ","أسىً عزَّ فيه التأسي وَهَانا",72,"ن",2,0],["ثكلت من جللني رزؤه","خبلاً كما شاء الردى خابلا",73,"ل",2,0],["ثكلتك أمك قد جزر","ت عليك قاصمة الظهور",74,"ر",1,0],["ثكلتهُم إن قلباً نشا","على حب حيدر لا ينكث",75,"ث",1,0],["ثكلتك إن حدت عن نهجه","وعب بفي أمك الكثكث",75,"ث",1,0],["ثَكِلتُ اللَّيالي عِندَ غَيرِيَ سَلمُها","وَرَوقَةُ دُنياها وَعِندي قِتالُها",76,"ل",3,0],["ثكلتك أمك قد هتكت حريمنا","وفضحت أسرتنا بني النجار",77,"ر",1,0],["ثكلتك نفسي لم تقاعدت عنهم","إلى كم على كسب الماثم ألبث",78,"ث",1,0],["ثكالى حيارى والسيوف تسوقهم","وسادتهم فيها الأسنه تعبث",78,"ث",1,0],["ثكلته أم اللغات وقد كا","ن فتاها البر الجريء الوفيا",79,"ي",2,0],["ثكلتهمُ الأعشابُ ويحَ كبادِهم","لم يعلموا ما حلَّ في سودائِهِ",80,"ا",3,0],["ثكلى لها الوبل الطويل","شجاً وافراط العويل",81,"ل",1,0],["ثكلت الهوى لولاه ما كان غرني","غَرِير ولا راحت بصبري مِكْسَال",82,"ل",1,0],["ثكلت الهوى لولاه لم أبع النهى","بجهل ولا استبدلت غيّاً بإرشاد",83,"د",1,0],["ثُكِلتَ فما وَفَّيتَ حقاً لسائِلٍ","ولكن جَمَعتَ المالَ حَطماً لوارِثِ",84,"ث",1,0],["ثكِلَتكَ أمّكَ إن قتَلتَ لمسلِماً","حلَّت عليكَ عقوبةُ المُتَعَمّدِ",85,"د",1,0],["ثكِلتُك حيّاً بالعقوقِ وإنّما","مماتُك عندي من حياتِك أصلحُ",86,"ح",1,1],["ثكلَى علَى شوقِي تشُقُّ جُيُوبَها","أهرامُها وصعِيدُها والنِّيلُ",87,"ل",1,0],["ثكلتك أمك كيف حالك حينما","هجمت عليك وقد وردت ثراكا",88,"ك",2,0],["ثَكِلْتُ فُؤَادِي إِنْ تَأَلَّمْتُ لِلأَسَىَ","عَلَى عِلْمِي أَنَّ الحَوَادِثَ تَحْدُثُ",89,"ث",1,0],["ثكلتُ من الإخوانِ من كانَ قادراً","على رؤية القبر الشريفِ ويلبث",90,"ث",1,0],["ثَكَلَتكَ أُمّ المكرما","ت وَحيدها البرّ الأَمينا",91,"ن",2,0],["ثَكلَتكَ مَطبوعاً لمع","وجّ الطباع مقوّما",92,"م",2,0],["ثكلى تحن لشجوها عيس الفلا","وترق إن ناحت لها الورقاء",93,"ا",2,0],["ثكلت الروح مهدرة إذا ما","جرى منّي لسر هواك بث",94,"ث",1,0],["ثكلت حياتي أن أقمت ولم أقُد","مطية عزمي نحو منزل من أهوى