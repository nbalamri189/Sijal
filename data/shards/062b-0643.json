{"poems":[[53,"أعلمت من حملوا على الأعواد","https://www.aldiwan.net/poem30599.html","الكامل"],[77,"ألما على شط الفرات المقدس","https://www.aldiwan.net/poem35873.html","الطويل"],[93,"كيف قوضت يا علم","https://www.aldiwan.net/poem11343.html","مجزوء الخفيف"],[23,"يا راكبا إما عرضت فبلغن","https://www.aldiwan.net/poem21490.html","الطويل"],[72,"شربت مدامة الندمان يوما","https://www.aldiwan.net/poem19423.html","الوافر"],[51,"بكاؤكما يشفي وإن كان لا يجدي","https://www.aldiwan.net/poem10863.html","الطويل"],[51,"أبا الفضل لا تحتجب إنني","https://www.aldiwan.net/poem65466.html","المتقارب"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[91,"أقاح ذاك أم شنب وريق ذاك أم ضرب","https://www.aldiwan.net/poem8741.html","عموديه"],[91,"ثكل الشرق فتاه","https://www.aldiwan.net/poem62806.html","عموديه"],[85,"يموت في الغاب أو في غيره الأسد","https://www.aldiwan.net/poem62890.html","البسيط"],[85,"اجعل رثاءك للرجال جزاء","https://www.aldiwan.net/poem62936.html","الكامل"],[62,"يا رب إن كان عيشي هكذا غصصا","https://www.aldiwan.net/poem52309.html","البسيط"],[45,"حاشاك من ذكر ثنته كئيبا","https://www.aldiwan.net/poem10895.html","الكامل"],[45,"تبا للحمك أيها اللحام","https://www.aldiwan.net/poem66642.html","البسيط"],[61,"بين الشنوف الحمر والأقراط","https://www.aldiwan.net/poem51578.html","البسيط"],[66,"ثقتي بغير هواكم لا تحدث","https://www.aldiwan.net/poem38498.html","الكامل"],[97,"نزل الظلام فلات حين مقامي","https://www.aldiwan.net/poem24397.html","الكامل"],[44,"تعشقك الكبار يدل عندي","https://www.aldiwan.net/poem30007.html","الوافر"],[44,"أعتبة أجبن الثقلين عتبا","https://www.aldiwan.net/poem30071.html","الوافر"],[69,"أدر أحاديث سلع والحمى أدر","https://www.aldiwan.net/poem28789.html","البسيط"],[105,"أعندك أنا لم ندع بعدك الوجدا","https://www.aldiwan.net/poem41928.html","الطويل"],[67,"ثكلت طوائف المستخدمينا","https://www.aldiwan.net/poem18120.html","الوافر"],[75,"سرى وجناح الليل أقتم أفتخ","https://www.aldiwan.net/poem69093.html","الطويل"],[48,"أعاذل قد كبرت عن العتاب","https://www.aldiwan.net/poem10825.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85664","الرمل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30439","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54844","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43835","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43806","الطويل"],[84,"إذا لم تجد إلا الأسى لك صاحبا","https://www.poetsgate.com/ViewPoem.aspx?id=26307",""],[45,"حَاشَاكِ مِنْ ذِكَرٍ ثَنَتْهُ كَئِيبَا","https://www.poetsgate.com/ViewPoem.aspx?id=31694",""],[107,"كلما رحت ذاكرا ذكريا","https://www.aldiwan.net/poem16458.html","الخفيف"],[129,"ثكلت دريدا إن أتت لك شتوة","https://www.aldiwan.net/poem24015.html","الطويل"],[148,"ثوى لك في قلبي غرام مبرح","https://www.aldiwan.net/poem68573.html","الطويل"],[167,"كم أرجع الزفرات في أحشائي","https://www.aldiwan.net/poem1594.html",""],[167,"إلى م أورد عتباً غير مستمع","https://www.aldiwan.net/poem1637.html",""],[195,"قومي اسمعي يا بنت جاري","https://www.aldiwan.net/poem39947.html","مجزوء الكامل"],[196,"مصابك ما كر الجديدان سرمد","https://www.aldiwan.net/poem51953.html","الطويل"],[197,"مضى والتقى نجمين في أفق جدا","https://www.aldiwan.net/poem45160.html","الطويل"],[233,"لحى الله شيبان إن صح أن","https://www.aldiwan.net/poem32137.html","المتقارب"],[296,"ثكلت مقلته طيب الكرى","https://www.aldiwan.net/poem36847.html","عموديه"],[298,"ثكلى عوان بدوار مؤلفة","https://www.aldiwan.net/poem45499.html","البسيط"],[314,"عجبت لما بلغت عني باطلا","https://www.aldiwan.net/poem69445.html","الطويل"],[400,"أمثلك يرضى بارتكاب العظائم","https://www.aldiwan.net/poem33427.html","الطويل"],[400,"سماعا عباد الله أهل البصائر","https://www.aldiwan.net/poem33733.html","الطويل"],[406,"أعاتب فيك الدهر لو أعتب الدهر","https://www.aldiwan.net/poem31861.html","الطويل"],[413,"لقد عجب الحسان الغيد لما","https://www.aldiwan.net/poem53981.html","الوافر"],[462,"تعجب هند من حنيني إلى اللمي","https://www.aldiwan.net/poem3365.html","عموديه"],[462,"أرحها فقد ضاقت بها سعة المدى","https://www.aldiwan.net/poem3600.html","عموديه"],[525,"وصاحب لي لو حلت رزيته","https://www.aldiwan.net/poem46014.html","البسيط"],[546,"يُكذبُني العمران عمرُو بنُ جندبٍ","https://www.aldiwan.net/poem1172.html",""],[573,"بكيت فما أجدى حزنت فما أغنى","https://www.aldiwan.net/poem2777.html","الطويل"],[573,"بكيتك بالعين التي أنت أختها","https://www.aldiwan.net/poem2787.html","الطويل"],[573,"تركت حبيب القلب تهمي جفونه","https://www.aldiwan.net/poem2847.html","الطويل"],[574,"من مبلغ الشعراء عن أخويهم","https://www.aldiwan.net/poem1773.html","الكامل"]],"verses":[["ثَكِلَتكَ أَرضٌ لَم تَلِد لَكَ ثانِياً","أَنّى وَمِثلُكَ مُعوَذُ الميلادِ",0,"د",1,0],["ثَكِلْتُ وَفائي وهْوَ أكرَمُ صاحِبٍ","وخالَطْتُ إيماني بإيمانِ مُلْبِسِ",1,"س",1,0],["ثَكِلَ الطَّوْدُ لَيْثَهُ","فَهْوَ فِي مَأْتَمٍ عَمَمْ",2,"م",1,0],["ثَكِلتُ اِبنَتي إِن لَم يُقَطِّعكَ ماجِدٌ","حُسامٌ يَرُدُّ العَيرَ مِثلَكَ واحِما",3,"م",2,0],["ثكلتهمُ أما علموا بأني","خليعٌ أشتهي شرب العتيق",4,"ق",1,0],["ثَكِلتُ سُرُوري كُلَّه إذْ ثَكلتُهُ","وأصبحتُ في لذَّاتِ عيْشي أَخَا زُهْدِ",5,"د",1,0],["ثكلت إخاءك فهو العزي","ز إن لم أصن رغبتي في غلاف",6,"ف",1,0],["ثكِلت أمُّ منْ تعادي وما كن","تَ تعادي إلا بني مِثكالِ",7,"ل",1,0],["ثَكِلتِ الظَرفَ عاذِلَتي","أَهَذا الحُسنُ يُجتَنَبُ",8,"ب",1,0],["ثَكِلَ الشَرقُ فَتاهُ","لَيتَني كُنتُ فِداه",9,"ه",1,1],["ثُكلُ البِلادِ لَهُ عَقلٌ وَنَكبَتُها","هِيَ النَجابَةُ في الأَولادِ لا العَدَدُ",10,"د",1,0],["ثُكلُ الرِجالِ مِنَ البَنينِ وَإِنَّما","ثُكلُ المَمالِكِ فَقدُها العُلَماءَ",11,"ا",2,0],["ثُكلٌ وفُرقةُ أحبابٍ ومَرزأةٌ","في المالِ والأهل والأتباع والخَوَلِ",12,"ل",1,0],["ثَكِلَتكَ كافِرَةٌ أَتَت بِكَ فَجرَةً","أَلّا اِجتَنَبتَ العارِضَ المَجنوبا",13,"ب",2,0],["ثَكِلَتكُمُ أُمّاتُكُم أَفَلا يَدٌ","تُرعى أَلا وَصلٌ أَلا إِلمامُ",14,"م",1,0],["ثَكِلَتْكَ داميَةُ القَرا مجلودَةٌ","نَبَذَتْكَ خائِفَةً بغَيِر قِماطِ",15,"ط",1,0],["ثَكِلَ الوَرى طَرفي المُسَهَّدَ فَاِبعَثوا","طَيفَ الخَيالِ إِلَيَّ أَو لا تَبعَثوا",16,"ث",3,0],["ثكلى إذا أنَّت أُحِسُّ كأنها","راحت تدَوِّي في صميمِ عظامي",17,"ي",1,0],["ثَكِلتُكَ يا أَخي أَن كُنتَ عِندي","صَحيحَ الأَمرِ لَو نِكتَ البِغالا",18,"ل",2,0],["ثَكِلتُ قَصائِدي إِن مَرَّ يَومٌ","وَلَمّا أَقضِ فيهِ مِنكَ نَحبا",19,"ب",2,0],["ثكلتَ آخرَ أعمارٍ تضيع سدى","فما تزيد على أيامنا الأُخَرِ",20,"ر",1,0],["ثكالى نظمن الدمع فيك مفصلا","كعهدك قبل اليوم إذ تنظم العقدا",21,"د",2,0],["ثَكِلْتُ طوائِفَ المُسْتَخْدَمِينا","فَلَمْ أَرَ فِيهمُ رَجُلاً أَمِينا",22,"ن",2,1],["ثكلْتُكِ شَمْساً من وَرَاء غَمامَةٍ","وجَنّةَ خُلْدٍ دونَها حالَ بَرزَخ",23,"خ",1,0],["ثَكَلتُ الظُرفَ وَالآدابَ إِن لَم","أُقِم لي حُجَّةً يَومَ الحِسابِ",24,"ب",1,0],["ثكلتهم أمهم ما","ذا بهذا قد أَرادوا",25,"د",3,0],["ثَكِلْنا الدُّنا لما اسْتَقَلَّ وإِنَّما","فقَدْناكَ يا خَيْرَ البَريّةِ ناعِبَا",26,"ب",2,0],["ثَكِلَتْ مِصْرُ مَنْ جَزِعَتْ عَلَيْهِ","ثُكْلَ أُمٍّ فقَلْبُهَا مَفْطُورُ",27,"ر",1,0],["ثُكلي عَلَيكَ اِستِماحُ عَيني","وَمَلأ الكُتبِ بِالمَراثي",28,"ث",2,0],["ثَكلتُ أَحبّائي فَهَل كُلُّ شامِتٍ","عَلى ثِقَةٍ أَن لا يُغَشّى الَّذي غَشّوا",29,"ش",3,0],["ثكلنا الدجى لما استقل وإننا","فقدناك يا خير البرية ناعبا",30,"ب",2,0],["ثَكِلَتكَ كافِرَةٌ أتَتْ بكَ فَجْرَةً،","ألاّ اجتَنَبْتَ العَارِضَ المَجْنُونَا",31,"ن",2,0],["ثَكَلَتني ام الصَبابة إِن كُن","ت أَرى سالياً لَهُ أَو نَسيّا",32,"ي",2,0],["ثَكِلتِ دُرَيداً إِن أَتَت لَكِ شَتوَةٌ","سِوى هَذِهِ حَتّى تَدورَ الدَوائِرُ",33,"ر",1,1],["ثَكِلتُ فُؤادِي إن تألَّم للأسَى","عَلَى عِلمِهِ أنَّ الحَوادِثَ تَحدُثُ",34,"ث",1,0],["ثَكِلتهُمُ الأَعداءُ إِنَّ حَياتَهُم","غَمُّ الصَّديقِ وَفَرحَةُ الأَعداءِ",35,"ا",2,0],["ثَكِلتُهُم ثُكلَ عَينٍ ما تَبَطَّنَها","مِنَ القَذى أَو كَثُكلِ العُضوِ لِلوَجَعِ",36,"ع",1,0],["ثَكِلَتكَ أمُّكَ أيّ إثمٍ","في التمازجِ أيُّ عارِ",37,"ر",1,0],["ثكلتك ثُكْلَ المَشْرَفِيِّ غُروبَهُ","وبالغَرْبِ يَسطو المشرفيُّ المهند",38,"د",1,0],["ثكلتُ يراعي ان تركت على الشجى","ضنى كبدٍ لم استجدَّ لهُ وجدا",39,"د",2,0],["ثَكِلتُكَ أَيَّ جَميلٍ رَأَي","تَ مِن ذَلِكَ النَذلَ في صُحبَتِه",40,"ت",2,0],["ثكلتْ مقلتُهُ طيبَ الكرى","هَلْ عَلَى الثاكلِ لومٌ في البكا",41,"ا",1,1],["ثَكلى عَوانٍ بِدُوّارٍ مُؤَلَّفَةٍ","هاجَ القَنيصُ عَلَيها بَعدَما اِقتَرَبا",42,"ب",2,1],["ثكلت إذا نفسي وعزي وأسرتي","بفقدي ولا أدركت ما كنت أطلب",43,"ب",1,0],["ثكلت الهدى إن كان ذا فعل أهله","وذقت الردى إن كان ذا فعل حازم",44,"م",1,0],["ثكلتكم أين التناصح للهدى","وأين التسامي للعلى والمفاخر",45,"ر",1,0],["ثَكولٌ ولا دمعٌ لها إثرَ هالكٍ","وكلُّ رَقوبٍ ثاكلٍ دمعُها هَمْرُ",46,"ر",1,0],["ثكلتك ليس لي في اللهو عذر","وقد لاح المشيب على عذاري",47,"ي",1,0],["ثكلتُ محباً غيَّر النأي عهدهُ","وأم كان شيء لا يدوم على عهد",48,"د",1,0],["ثكلتُ الهوى لولاه لم أبعِ النهى","بجهلٍ ولا اخترت الضلال على الهدى",49,"د",2,0],["ثكلته بعدما صارت محاسنه","في العظم واللحم سير الماءِ في الغصنِ",50,"ن",1,0],["ثَكِلتُكُما إِن لَم أَكُن قَد رَأَيتُها","كَراديسَ يُهديها إِلى الحَيِّ كَوكَبُ",51,"ب",1,0],["ثكِلتْ خليلاً صِرْتُ من بَعْدِ ثُكْله","فُرَادَى وجاءَ الهمُّ من بَعدِه مَثْنَى",52,"ن",2,0],["ثكلتكِ بدراً في فؤادِي شروقُه","وفاكهةً في جنةِ الخلد نبْتُها",53,"ت",3,0],["ثكلتُكَ رَأْياً كان عقبي قبوله","سرورَ قلوبٍ للعِدَى وعُين",54,"ن",1,0],["ثَكِلَتكَ يا اِبنَ العَبدِ أُمُّكَ سادِراً","أَبِساحَةِ المَلِكِ الهُمامِ تَمَرَّسُ",55,"س",1,0]]}