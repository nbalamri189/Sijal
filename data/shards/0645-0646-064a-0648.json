te.com/ViewPoem.aspx?id=51953",""],[5848,"ثروة وثورة","https://www.poetsgate.com/ViewPoem.aspx?id=53369",""],[5848,"ممنوع الإزعاج","https://www.poetsgate.com/ViewPoem.aspx?id=48833",""],[5950,"أغاني الراحلين ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128337",""],[5956,"أرنو إليك","https://www.poetsgate.com/ViewPoem.aspx?id=182039",""],[5956,"تغَيُّب","https://www.poetsgate.com/ViewPoem.aspx?id=182145",""],[5956,"مولدِ الطفل أدهم إيهاب","https://www.poetsgate.com/ViewPoem.aspx?id=193097",""],[5956,"قدَرٌ عليك بأن تُخان دواما","https://www.poetsgate.com/ViewPoem.aspx?id=193214",""],[5956,"يا خالد الحُبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=193695",""],[5956,"رسالة جوابية منه لي على الوتس أب","https://www.poetsgate.com/ViewPoem.aspx?id=194394",""],[5956,"أصدقاء خالدون","https://www.poetsgate.com/ViewPoem.aspx?id=194831",""],[5956,"سبحانَه القيُّومُ سمّاعُ الدُّعا","https://www.poetsgate.com/ViewPoem.aspx?id=204194",""],[6038,"نون 2003","https://www.poetsgate.com/ViewPoem.aspx?id=25700",""],[6056,"إسمك وعنوانك بجوالي","https://www.poetsgate.com/ViewPoem.aspx?id=130335",""],[6102,"غَنِيمَةُ العُمر !!","https://www.poetsgate.com/ViewPoem.aspx?id=184543",""],[6203,"عاشق.. يتعثر في بردته!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88024&r=&rc=2",""],[6259,"ألمَّ خيالها بعد الهجوع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59388&r=&rc=36",""],[6280,"لاَمَ في أُمِّ مَالِكٍ عاذِلاكَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27897&r=&rc=52",""]],"verses":[["مَن يورِدُ السُمرَ الطِوا","لَ وَيُطعِمُ البيضَ النُصولا",0,"ل",2,0],["مِنِّيَ وَصلٌ وَمِنكَ هَجرٌ","وَفِيَّ ذُلٌّ وَفيكَ كِبرُ",1,"ر",1,1],["مَن يُؤَدّي قَولي إِلى الشاهِ وَالشا","هُ رَفيعُ الفَعالِ سَروٌ مُصاصُه",2,"ص",2,0],["مَن يومه يوم بلا أملٍ","وغدٌ بلا سلوى وبعد غدِ",3,"د",1,0],["مُنىً – وأتعِسْ بها – أنْ لا يكونَ على","توديعها وهيَ في تابُوتها رَصَد",4,"د",1,0],["مَن يُؤْثر الحقَّ يبذُلْ فيه مُهْجَتَهُ","ومن يكُنْ هَمُّهُ أقصَى المدَى يَصِلِ",5,"ل",1,0],["مِنّي وَمِنكِ عَلى حِذا","رِ رَدى المَصادِرِ وَالمَناهِل",6,"ل",1,0],["مِنّي وَمِنهُنَّ وَقَد نَوَّمَت","عَنّا عُيُونُ الكُشَّحِ الحُسَّد",7,"د",1,0],["مَن يُؤتَ حَظّاً يَبتَهِج وَيَكُن لَهُ","عِزٌّ فَتَرهَبَ ضَأنَه الآسادُ",8,"د",1,0],["مَن يوقَ لا يُكلَم وَإِن عَمَدَت لَهُ","نَبلٌ تُغادِرُ شَخصَهُ كَالقُنفُذِ",9,"ذ",1,1],["مُنىً وَمَعَانٍ أَبَى الحُسْنُ أَنْ","تُرَى فِي مِثَالِ التُّرَابِ الكَثِيفْ",10,"ف",1,0],["من يومِ أجْلاَه النبيُّ","عن المدينة وهُْوَ صاغر",11,"ر",1,0],["من يؤاويني؟ أيصغي منزلٌ","لو أنادي، أو يعي أي خباء؟",12,"ا",2,0],["من يومني صغير أعشقك وأتأملك","حتّى تفرعنبي غلاك ... وسادني",13,"ن",2,0],["منيوزٍ ومميسر وممخطر","ومركب ومنصّف أنواعا",14,"ع",2,0],["من يوم ما التقت الشفاه فحدثت","عن حبنا بسواحل الترتيل!",15,"ل",1,0],["مُنِّي ولو بالسّلامِ منعِمةً","ثم اخِلطي ما مَنَنْت بالمَنِّ",16,"ن",1,0],["مِنّي وَكُنتُ أُسيئُهُم وَأَسُبُّهُم","لَمّا رَأَيتُكَ مِثلَهُم قَرَّبتَهُم",17,"م",1,0],["مِن يَومٍ كُنّا التَقَينا ثُمَّ فَرَّقنا","ذا الدَهرُ ما فاتَني وَاللَهُ ذِكراكا",18,"ك",2,0],["مِن يَوم ذاك التَجنّي","وعهدِ ذاكَ الصُدود",19,"د",1,0],["من يؤذي المسلم","كان كمن يهدم",20,"م",1,0],["مِن يوسِفٍ في عِفَّةٍ وَصَباحَةٍ","مَن مِثلُهُ عَلماً لفَصل خِصامِ",21,"م",1,0],["مُنىً وَمَنيَّةٍ كالصِلِ يَطوي","عَلى الدِرياقِ وَالسُمِّ النَقيعِ",22,"ع",1,0],["مني وأطباقُ الصعيد حجابُهُ","عني فكيفَ تخاطُبٌ وتراسُلُ",23,"ل",1,0],["مِن يَوم ِكانَ العِراقُ الحُرُّ يَغمُرُهُم","حُبَّا ً إلى أن أتى مَوجُ الشَّعانين ِ!",24,"ن",1,0],["من يوم كنت عصا الوجدان تسيار","ما كان يختالها نجد وأغوار",25,"ر",1,1],["من يوم بالصبر ما تحصل مساعفتك","اذهب وهذي الصبابة والأسى عفتك",26,"ك",1,0],["من يوم أَن فارقت طرفَكَ أَسوداً","لم يكتحلْ طَرْفِي بِيَوْم أَبْيَضِ",27,"ض",1,0],["من يودُّ الزَّمَانُ مِنه الرِّضَا عَنه","ولا شَيءَ فِي الزَّمانِ يَؤُوده",28,"د",2,0],["من يوسف وشقيقه عبدالحلي","م الفرقدين أضاء كل نيرا",29,"ر",2,0],["مَن يُوازيه وَهوَ حرّ كَريم","وَطنيّ في بره بِالأَقارب",30,"ب",1,0],["مُنّي وَما شئت منّي","خُذي وَجافي خلافي",31,"ي",1,0],["من يوم غلّج بابه","يا ريلي ما وطت",32,"ت",1,0],["مِنّي وَبيضُ الهِندِ تَقطُرُ مِن دَمِ","مَسنونَةً يا ما أميلح سنّها",33,"ه",2,0],["مِن يَومِنا كُنّا بِجَدَّة وَفي","غَدٍ إِلى طيبَة سِرنا نَقتَفي",34,"ي",1,0],["من يوَعِّظهمْ يُجازى","بالذي يُخْزِى ويفضح",35,"ح",1,0],["من يُوسفٌ مَلكُ الإسلام مالكه","فعزمُه صادق تُهدى به الشُّهبُ",36,"ب",1,0],["من يوم عبَّرت غدت مقلتي","ساهية ساهرة عبرى",37,"ر",2,0],["من يوم مولده استبان كماله","حيث الاله بفضله ديانه",38,"ن",2,0],["من يوالي يَفُزْ وخصمُك لا شك","كَ وإِنْ عزَّ بالظُّبَا منحورُ",39,"ر",1,0],["من يؤازر جمعية الاسعاف","جاده اللَه بالجزاء الوافي",40,"ف",2,1],["من يوم يصمت والاعضا بسّ تحكي","يتكلمون بْما فعل من عَمالي",41,"ل",2,0],["من يوم إنس لم يكد","ر صفوه واش ولا حي",42,"ح",2,0],["منّى وأنتَ فى غِنى بذاتِكَ","عن وَصلِ نَفعٍ لك مع صِفاتِكَ",43,"ك",1,0],["من يؤل أن رضابه","ينسى الرحيق فغير حانث",44,"ث",1,0],["من يوسف الخياط يبدي لنا","جماله يوسف في كل ناد",45,"د",1,0],["منّي وإن جاوز الجوزاء والحملا","ذا شعرُ مرتجل متى له",46,"ا",3,0],["من يوقظ اليوم الضروس طماعة","فَهوَ الحريّ بناره أَن يضرسا",47,"س",2,0],["من يوم بدرٍ والوقائع بعده","حيث الوصي أطاع خير أمين",48,"ن",1,0],["من يومه للدين يوم وصفه","في آية من سورة المدثر",49,"ر",1,0],["من يوم حبٍّ بالحياة شاد","مدَّخرٍ منتظر الميعاد",50,"د",1,0],["من يوم أبعده العداة عن الحمى","بالطرف من مر الفراق سهاد",51,"د",1,0],["من يوم مينتيوس بي غرّاً سرى","لصرح فيلامن أفنطٍ مدبرا",52,"ر",2,0],["من يوقظ الحرب لا ينكر حوادثها","قد تحرق النار يوماً موقد النار",53,"ر",1,0],["منى ولو عدة بالوصل ثم به","منى فحسبى وعد منك لى بوفا",54,"ف",2,0],["من يوم بدر له الاملاك لم يذروا","غمرا عنيدا وجبارا وملاذا",55,"ذ",2,0],["مني ومنك تدلّل وتذلّل","والصبر عنك تعلّل وتجمّل",56,"ل",1,1],["من يوم ساعة بينهم لم اتخذ","الفا يكون إذا انفردت قريني",57,"ن",2,0],["مني وبيض الهند تقطر من دمي","لك قامة لا زلت أعشق لدنها",58,"ه",2,0],["من يوسف الحسن أم من دار بهجتهِ","في مصر بيروتَ نلقي منظراً حسنا",59,"ن",2,1],["من يوافق يعش هنيئاً قريراً","آمناً من أذية وملامه",60,"م",2,0],["من يؤت من مأمن لم يجده حذر","وقاتل نفسه ما أن له راد",61,"د",1,0],["من يوم لحتَ لناظري ما لاقنى","شيء ولم يملأ جمال الناظر",62,"ر",1,0],["من يوم شدتِنا ننحو حماك على","رومٍ لمرحمةٍ في موقف القَدَم",63,"م",1,0],["من يوم هجرته ساد الضياء على","مكامن الليل يستجلي خوافيها",64,"ي",3,0],["من يوم تنشى النفس عاشت ذليله","صمّا وبكما والغبن مرتحلها",65,"ل",3,0],["من يوم روّح بقدرة عالم الغيب","في داخلي كل ليله صيحة عواك",66,"ك",1,0],["من يوم أخذ (جن النبي) (عرش بلقيس)","عرفت (نوف) بنجمة (إبلاد فارس)",67,"س",1,0],["مِن يَومْ وَدَّعتَكْ.. بوجهي عَبَسْ","حَظِّي, وخَلَّانِي أَسِيرَةْ جَوَابْ",68,"ب",1,0],["من يوم زادت قناديلَك","والليل بالليل متْواصل",69,"ل",1,0],["مِن يوم يومي والهوى مِعجبني","ودور البُطولة ماخِذ(ن) أفكاري",70,"ر",2,1],["من يومِ مولدِنا نُناغَى باسْمِه","حتى استحال دماً بنا الإيناس",71,"س",1,0],["من يوم جاني ما تمشيت فالسوق","ولا شريت من المحلات تلواح",72,"ح",1,0],["من يوم ربي خلقني لين هالساعه","وأنا احمد لله لأني صرت نصراوي",73,"ا",3,1],["من يوم غبتي صار عقله غايب","وشانت طبوعه بعد زين طبوعه",74,"ع",2,0],["من يوم غبتي صرت اشوف السلم يشبه للدمار","غرقت بدموع العيون وجيت يمك معترف",75,"ف",1,1],["من يوم غابت شمسك وجيت بوضوح","وقلت لمتاهت سكتك احظنيني",76,"ن",2,0],["من يوم حبيتك أكثر عاجز ٍ لا اكره","والكره من (حُب) لاابطى جاب مكنونك!",77,"ك",1,0],["من يوم غبتي عن حياتي فلا عاد","للفرح ضيّ(ن) في مرابع فوادي",78,"د",2,1],["من يومها وانت قدام عيني ولوماظهرت","دايم وعيني تشوفك بين جلاسها",79,"س",3,0],["من يومها والليل في كف بواب","خايف يشوف الفجر ويرد فاني",80,"ن",2,0],["من يوم عاهدنا على الدين ما حاد","فينا ولا منا..... نخون المسارى",81,"ر",2,0],["مَنْ يُولِجُ الصُّبْحَ النَّدِيَّ بِنُورِهِ","مِنْ قَلْبِ لَيْلٍ بِالنُّجُومِ تَجَمَّلَا ؟",82,"ل",2,0],["مَنْ يُوَازِي فِي عَطَاءِ الْ","لَّهِ إِحْسَاناً وَأَجْرَا",83,"ر",2,0],["من يوم صار اتجاهه صوب رواده","قام أيتسابق مثل خيل بميداني",84,"ن",2,0],["من يومِ رأيتُ الطيفَ أعيشُ","حيالكِ مشدوهاً مبهوت",85,"ت",1,0],["من يومِ رحلتُ أفتشُ عنكِ","ولستُ أنامُ ولستُ أبيتْ",85,"ت",1,0],["مني ومن نحلتي السمحا ومجمعها","يسعى بها حُب قلب فيك مجبول",86,"ل",1,0],["من يؤخره يحيى في أجل غي","ر مسمى ومن يقدمه حُزا",87,"ز",2,0],["من يوم جيتي والحشى زحمة انوار","والسعد واطياف الفرح تحتويني",88,"ن",2,0],["من يواسي قلب أم أثكلت ؟","يا لقومي من بغى قد جمح",89,"ح",1,0],["من يواسي قلب صب","عاش عمرا بالتمني",90,"ن",2,1],["من يوم أسست في نور غدوت على","كل المنصات داعينا وحادينا",91,"ن",2,0],["من يومها ضايق تقل شايلن دين","وضيقي مع الايام يزداد شره..",92,"ر",2,0],["من يوم ما لوّحت لي كف يمناك","لليوم دمعي بالخفا ما حبسته",93,"ت",2,0],["من يوم قمت بخير من فوق السرير","الشر زايل عنك والخاسي ذَلَف",94,"ف",1,0],["من يومها متبعثر وكأنني","غيم تحول في السما أمطارا",95,"ر",2,0],["من يوم عيسى لم تزل أسطورة","نفخت بها روح الإله لتبدعه",96,"ع",2,0],["مِن يَومِ أبرهة ٌ أتى مُتهيِّئاً","ولِهدم بيتِ الله أسْرَجَ فِيلا",97,"ل",2,0],["مِنْ يَوْمِ أَنْ عَانَقْتُ وُدَّكْ","وَ ثَمِلْتُ حِينَ شَمَمْتُ وَرْدَكْ",98,"ك",1,1],["مني وممن فيك قد أحببتهم","آمين يا متقبل الدعواتِ",99,"ت",1,0],["من يوم بان القلب .. واخفيت بالموق","دمع .. وغدالي بالمحبه .. وعايد",100,"د",1,0],["مِن يوم فتَّحتُ عيني والعراقُ دمٌ","يُطوى، فتهتكُ عن طوفانهِ الحُجُبا",101,"ب",2,0],["من يوم عرفي ماوطت رجلي الفي","امشي على الرمضا ولالي محاري",102,"ر",2,0],["من يوم راسي قنّده","يقبل معه مافر به",103,"ب",2,0],["من يوم طيره لقا في داخلي وكره","وانا لو يغيب لحظه صرت منحاسي",104,"س",2,0],["مِنِّي وَمِنْهُمْ غَداةَ البَيْنِ إِذْ بَكَرُوا","كَمْ عَذَّبَ البَيْنُ أَرْواحاً وَأَرْواحَا",105,"ح",2,0],["من يوم جيتي، زانت الاقدار","بعدك، على درب الهُدا ساير",106,"ر",1,0],["من يوصل علمي الشيخ ويقله","صاحبك مرضان منهاره أعصابه",107,"ب",2,1],["من يوم خليتة ونادى بحسة","ياوين مقفي عن محبة ماهي تو !",108,"و",1,0],["من يوم هل العيد زادت جروحي","والشوق يطوي خافقي ياتلع الجيد",109,"د",1,0],["من يومها للحين بيّن شهرها","قصيدةٍ في وصفها مالها أمثال",110,"ل",1,0],["من يوم غاب وغاشيٍ جوي قتام","وأنا أصطبر وأقول (بتزين باكر)",111,"ر",1,0],["من يوم انا طفل على وقته صغير","ذاق العنا وهو بسن الطفولة",112,"ل",2,0],["منْ يوْمِها وحميرُ الأرْضِ مالِكَةٌ","أعْلى المناصبِ حكّاماً بألْقابِ",113,"ب",1,0],["من يومها تطبخ وتاكل ملايين","وتمسي تحد الناب والبطن خاوي",114,"ا"