//www.poetsgate.com/ViewPoem.aspx?id=101653",""],[5064,"المُشتاقُ حتفًا","https://www.poetsgate.com/ViewPoem.aspx?id=199098",""],[5183,"الحسناء","https://www.poetsgate.com/ViewPoem.aspx?id=186492",""],[5186,"لا تعد بي إلى ربوع الخيام","https://www.poetsgate.com/ViewPoem.aspx?id=156442",""],[5194,"ما يسوى غلاك","https://www.poetsgate.com/ViewPoem.aspx?id=32207",""],[5198,"هوى النفس","https://www.poetsgate.com/ViewPoem.aspx?id=155075",""],[5277,"فنجان قهوة بطعم العراق","https://www.poetsgate.com/ViewPoem.aspx?id=185397",""],[5277,"أخلّاءُ الفؤاد","https://www.poetsgate.com/ViewPoem.aspx?id=185552",""],[5370,"طفولة","https://www.poetsgate.com/ViewPoem.aspx?id=81393",""],[5461,"أنا تسّلى بالشعر لي توصّفت","https://www.poetsgate.com/ViewPoem.aspx?id=1310",""],[5648,"انا اسف","https://www.poetsgate.com/ViewPoem.aspx?id=155191",""],[5648,"كل عام والامه بخير وسلامه","https://www.poetsgate.com/ViewPoem.aspx?id=155977",""],[5664,"خلف سيار","https://www.poetsgate.com/ViewPoem.aspx?id=176684",""],[5840,"فيك برحت بالعذول إباء","https://www.poetsgate.com/ViewPoem.aspx?id=181437",""],[5848,"اهوا دا اللي مش معقول","https://www.poetsgate.com/ViewPoem.aspx?id=53357",""],[5976,"مخاوين إسْعدي","https://www.poetsgate.com/ViewPoem.aspx?id=33492",""],[6056,"راسي يافهد شابي","https://www.poetsgate.com/ViewPoem.aspx?id=130323",""],[6056,"مفهوم الأذواق","https://www.poetsgate.com/ViewPoem.aspx?id=130522",""],[6152,"مناجاة عاشق","https://www.poetsgate.com/ViewPoem.aspx?id=203313",""],[6152,"إشراقة قلب","https://www.poetsgate.com/ViewPoem.aspx?id=203712",""]],"verses":[["أَنا أَشكو إِلَيكَ جَورَ رَقيعٍ","لَقَّبوهُ الصَفعانَ تاجَ الخَزانَه",0,"ن",2,0],["إنا اشتركنا في الأما","ني والتقينا في المحن",1,"ن",1,0],["أنا أشكو صَبَابَةً لَذَعَتْني","بَرّدَ اللَّه حرَّ نَحري بِنَحرِك",2,"ك",1,0],["أنا أشدو لكلّ قلب طروب","أنا أبكي لكلّ قلب معنّى",3,"ن",2,0],["أنا أشقى كما شقيت ولكن :","لا تتمتم ... وأيّنا أشقانا ؟",4,"ن",2,0],["أنا أشعاري من أحسابكم","غرر الأحساب والشعر وضاء",5,"ا",2,0],["انا اشتركنا في الامالي","والتقينا في المحنْ",6,"ن",1,0],["أنا أشفقت أن أموت لأني","لا أحب البكا لتلك العيون",7,"ن",1,0],["أنا أشتاقُه إذا بات قُرْبي","مِثْل شوقي إليه في الهجران",8,"ن",1,0],["أنا أشكو إذا ابتليتُ وأشدو","حين يصفو الوجود في ناظريا",9,"ي",2,0],["أنا أشتاق قطرة من طلاها","والخليّ العربيدُ عافَ الشرابا",10,"ب",2,0],["أنا أشكو إليكَ يا مُشتكَي الأح","رار دَهْراً في خُلْقِه تَنْكِيد",11,"د",1,0],["أنا أشتهِي يا قومُ أن يُعطَى الغِنىَ","ذو النَقصِ فِيَّ ويُحْرَمَ الفُضلاء",12,"ا",2,0],["أنا أشعَرُ الفُقهاء غيرَ مُدافَعٍ","في العَصْرِ أو أنا أَفقَهُ الشعراء",13,"ا",2,0],["أنا أشكو وصل من تيمني","عكس ما يشكو منه الأدبا",14,"ب",2,0],["أنَا أشكُو إليكَ دهراً لحَا عُو","دي وأعرَاه فَهْوَ يَبْسٌ سَليبُ",15,"ب",1,0],["أنا أشقى به ويقضي لغيري","صدقوا فالهوى حظوظ وقسمهْ",16,"م",2,0],["أَنَا أَشْكو إِليك تقصيرَ شُكري","فكأَنِّي بالبِرِّ منك كَنُود",17,"د",1,0],["أَنا أشْكو إليكَ ما لم يَدُرْ لي","في حِسابٍ وأَنْتَ مِنْه حَسْبي",18,"ب",2,0],["أنا أشكو من الجَفا وأحاجي","كَ على كونهِ بتركِ الأحاجي",19,"ج",2,0],["أنا أشكو إليكَ قوماً تمالوا","في عُقوقي بَعيدُهم والقَريب",20,"ب",1,0],["أنا أشعر الفقهاء غير مدافع","في الدهر بل أنا افقه الشعراء",21,"ا",2,1],["أنا أشجى منه فؤاداً","وأضنى وأقرحُ",22,"ح",1,0],["أنا أشق بلطف","مني على السرطان",23,"ن",1,0],["أَنا أَشرَبُ بالكاسَينِ وَالثا","لِثُ الثغرُ فَما أَحلَى وَأَهنا",24,"ن",2,0],["أنا أشجيت يلمنى حوبائي","بمناحي حمامة الجرعاء",25,"ا",2,1],["أَنا أَشكو إِلَيكَ قَسوَةَ قَلبي","كَيفَ لَم يَنصَدِع وَأَنتَ عَليلُ",26,"ل",1,0],["أَنَا أَشكُو لِعِزَّةٍ منكَ ما أَل","بستَني الحبُّ من خُضوعٍ وَذِلَّه",27,"ل",2,0],["أنا أشهَدُ أنَّ الحُ","بَّ مِن قَلبي اذا دعوى",28,"ع",3,0],["أنا أشكوه وهو تل","هيه عني ملاعبه",29,"ب",2,0],["أنا أشكو من زمان غدا في","مضمر القلب خازنا آلامه",30,"م",2,0],["أنا أشتهي يحيي الفؤاد برشفة","من فيه وهو يُريدُ موت الشّاهي",31,"ي",1,0],["أنا أشكو اليك جور زمان","دأبه أن يعارض الأدباء",32,"ا",2,0],["أَنا أَشكو إِلَيك داياً أَداني ال","عَتْبَ فيما مَضى على عِمرانِ",33,"ن",1,0],["أَنا أَشكو مِن غيرَتي وَعَذابي","وَأَنانيَّتي الَّتي لا تَبينُ",34,"ن",1,0],["أنا أشكوه وهو منى يشكو","فكلانا يبدى مزيد اشتكاء",35,"ا",2,0],["أَنا أَشقى بِالحُب مِن حَيث ما يَن","عم قَلب وَكَم أَلَذ وَأَمتَع",36,"ع",1,0],["أنا أشكوكَ إلى حُبِ","بيكَ يا سؤلي وحسبي",37,"ب",2,0],["انا اشهد انك بالهوى لا تمكنت","تذبح ولكن من هو اللي يدينك",38,"ك",1,0],["أنا أشعلت في كفي شموعاً","وفوق الراس نصبت المنارة",39,"ر",2,0],["انا اشهد ان الوقت ضيقه وشده","يعلم الانسان ماكان يخفيه",40,"ي",2,1],["انا اشهد انك دايم رافع الجاه","ولو نروم راعي الاوله ما نرومه",41,"م",2,0],["انا اشهد ان اللي مخاويك ربحان","يا من تساما للمعالي فعاله",42,"ل",2,0],["انا اشهد انه تفتخر بك مواقف","المرجلة والتضحية والتصافي",43,"ف",2,0],["انا اشهد بان ربي قد عطاكم","سموت الطيب والعز المتينا",44,"ن",2,0],["انا اشهد ان الحظ يآصآحبي شين","ماتشوفني جآلس اعض الاظآفر",45,"ر",1,0],["انا اشهد ان الحب بي اتوآجد","وكل المشآعر .. بالخفى تتضرّع",46,"ع",1,0],["انا اشهد اني ماعزفت المواويل","إلا بعد ما صافح العبد واليه",47,"ي",2,0],["إنّا أشِقّاءُ ذاكَ الحُزْنُ سَيّدَتي","مهما أبتعدنا دَنَونا لِلأسى نَسبا",48,"ب",2,0],["انا اشهد ان هروجهم قرقعة طوس","والشيخ ما هو شيخ ! شيخ ن لثلّه",49,"ل",2,0],["انا اشهد انّك كامل الحق أدّيت","ودهام من بعدك مسارك مساره",50,"ر",2,0],["أنا اشهد اللي فاز بالأمس زيزوم","لكن على الأحرار فوز وفشيله",51,"ل",2,0],["أنا اْشوف الزهور اليانعة متجمعة في سلة الرمان","على كف الطفل ترسم عيون وفرحة الإكليل",52,"ل",1,1],["أنَا أشتَاقُ والذّكرَى رِيَاحٌ","تَسُومُ مدَائِنَ الأيَّامِ عَصْفَا",53,"ف",2,0],["أنَا أشتاقُ إنِّي مَحضُ رُوحٍ","أتَتكِ تَجُرُّ شَوقَ الأرضِ لَهفَى",53,"ف",2,0],["أنا أشكو الخيال لكن أناجي","فيه قلبي وأستلذّ الملاما",54,"م",2,0],["إنا أشكو سقمي إلى الله لكن","أنت والله أصل هذا السقام",55,"م",1,0],["أنا أشهد أن الله عطاك الجمال اللي يثير","جل سبحانه عن الغير كملك وعطاك",56,"ك",1,1],["انا اشهد ان الصلاة علاج من كل ضيق","للي يحافظ عليها ف اوّل اوقاتها",57,"ت",3,0],["أنا أشرب الأفكار من كأسٍ","عاطى الطروسَ بفكره حبرَه",58,"ر",2,0],["أنا أشتاق من ليست بقربي","وشوقي للتي تنأى جليلُ",59,"ل",1,0],["أنا اشوف لي روض امتلا بأجمل الغزلان","واشوف العدود اللي القطا من حواليها",60,"ي",3,0],["أنا أشهد إنّي في غرامه تطرّفت","وصلت حد الموت قصدي مناتى",61,"ت",2,0],["انا اشهد انك جنتي وانت تابوت","وانا الذي لو تدري تموت مقهور",62,"ر",1,0],["انا اشهد ان الضيم يرسل سهامه","الدين وينه والعفيفه بلا لثام",63,"م",1,0],["انا اشهد انك يالشهم تفضح الليل","وأنا اشهد انك للستر مافضحته",64,"ت",2,0],["أنا أشكو إليك جور زمانٍ","دأبه أن يعاند الأدباء",65,"ا",2,0],["انا اشهد شهاده ربي بلطفه اعطاني","حبيبه تغني للحدايق يطيح الطير",66,"ر",1,0],["انا اشهد انّي لو مسكتك في يدي","إمّا ضربتك !! أو بديتك بالسلام .. !!",67,"م",1,0],["أنا اشهد إن الهوى يازين مدخاله","نشوة فرح شوفة المحبوب تنسابي",68,"ب",2,0],["أنا أشهد إني بحق نفسي تجنيّت","وأضرمت نار ٍ بالحشا تحرق إحراق",69,"ق",1,0],["أنا أشتاق لكن لا تلمني","إذا بتًّ المُنى في كل كوني",70,"ن",2,0],["أنا اشتاقها وأتيه شوقا","وكل الكون مثلي يرتجيها",71,"ي",3,0]]}