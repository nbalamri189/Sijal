{"poems":[[110,"تأبط شرا","https://www.shoaraa.com/p12775",""],[95,"صدقت في عتبكم أو يصدق الشمم","https://www.aldiwan.net/poem11361.html","البسيط"],[87,"مضى الدهر بابن إمام اليمن","https://www.aldiwan.net/poem8111.html","المتقارب"],[82,"متى صدرت عيناك عن أرض بابل","https://www.aldiwan.net/poem31321.html","الطويل"],[119,"تأسد ثعلب والهر أيضا","https://www.aldiwan.net/poem40465.html","عموديه"],[119,"سهام هواك صائبة المرامي","https://www.aldiwan.net/poem40489.html","عموديه"],[154,"دليل علاك ليس على اعتراض","https://www.aldiwan.net/poem68471.html","الوافر"],[173,"دع الدار بالبحرين تعفو ربوعها","https://www.aldiwan.net/poem1634.html",""],[190,"أرى قوما شجيت بهم رذالا","https://www.aldiwan.net/poem43473.html","الوافر"],[203,"هي الأفلاك لا شم القباب","https://www.aldiwan.net/poem45404.html","الوافر"],[240,"ألا مبلغ عني المهين ابن عروة","https://www.aldiwan.net/poem31912.html","الطويل"],[240,"لحى الله شيبان إن صح أن","https://www.aldiwan.net/poem32137.html","المتقارب"],[242,"ذوي ودي ويا من عنفوني","https://www.aldiwan.net/poem19282.html","الوافر"],[280,"ألما بأشلاء العلى والمكارم","https://www.aldiwan.net/poem25526.html","الطويل"],[285,"سوى باكيك من ينهى العذول","https://www.aldiwan.net/poem60710.html","الوافر"],[358,"أصاحي ما لطير العز صاحا","https://www.aldiwan.net/poem40543.html","الوافر"],[376,"متى صارت الجرد المذاكي سفائنا","https://www.aldiwan.net/poem57079.html","الكامل"],[422,"ألا بلغ جناب الشيخ عني","https://www.aldiwan.net/poem54059.html","الوافر"],[454,"تذكر عهد ماضيه فحنا","https://www.aldiwan.net/poem1019.html",""],[482,"تضاعف ما ألقاه غير بديع","https://www.aldiwan.net/poem15269.html","الطويل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101471","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108648","المتقارب"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42473","الطويل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137364",""],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/140026","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86254","الطويل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35655","الطويل"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135087","الطويل"],[5431,"سأترك مهجتي في اليم طوعا...","https://www.poetsgate.com/ViewPoem.aspx?id=191602",""],[5431,"جدوى الحياة....","https://www.poetsgate.com/ViewPoem.aspx?id=205102",""],[5608,"متى صوتك .. ؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=32863",""],[402,"صدقت في عتبكم أو يصدق الشمم","https://www.poetsgate.com/ViewPoem.aspx?id=36829",""],[6125,"مَتَىٰ صَحَّ مِنِّي ومِنْكِ الحَدِيثُ","https://www.poetsgate.com/ViewPoem.aspx?id=210597",""],[454,"تذكر عهد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82637&r=&rc=1",""],[6290,"المُعَلّقَةُ الثّامِنَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85504&r=&rc=22",""]],"verses":[["متى صدعت نص الكتاب روايةٌ","ضربت بها عرض الكتاب مُرمما",0,"م",2,0],["مَتَى صَلَوْهَا وَفِي الْجَنَّاتِ مَوْعِدُهُمْ","فَالْهَوْلُ عُرْسٌ وَمِنْ زِينَاتِهِ الْخُدُمُ",1,"م",1,0],["مَتى صِرتَ يا بَحرُ غُمدَ السُيوفِ","وَكُنّا عَهِدناكَ غِمدَ السُفُن",2,"ن",1,0],["مَتى صَدَرَت عَيناكِ عن أرض بابلِ","فَسِحرُهُما في اللَّحظِ بادي المَخايِلِ",3,"ل",1,1],["متى صار النزال فكل جنس","يقوم بحكم مضمون الكيان",4,"ن",1,0],["متى صحب العلي دني اصل","غدى هدف الملام لكل رام",5,"م",1,0],["متى صَحَّت دعاوى كلِّ صعبٍ","بتزكية من الحدق المراض",6,"ض",1,0],["مَتى صُرِعَ الباغي فَعاشَ قَتيلُهُ","بَلى طالَما أَردى النُفوسَ هَلُوعُها",7,"ع",3,0],["متى صاحبتهم لسؤال برّ","تراهم يلتحون إلى السعال",8,"ل",1,0],["متى صاحَ الدجاجُ بثُعلُبانٍ","فليسَ سواهُ من داعٍ مجابِ",9,"ب",1,0],["مَتى صِرتَ تَأبى لا أَباكَ دَنِيَّةً","وَأَنتَ لَئيمُ الأَصلِ وَالفَرعِ وَالنَفسِ",10,"س",1,0],["مَتى صِرتَ تَعرِفُ حَقَّ الصَديقِ","عَليكَ وَتُجمِلُ في عِشرَتِه",11,"ت",2,0],["مَتَى صَافَحْتَ كَفَّ مَدِيحِ طَهَ","تُصَافِحْكَ السَّعَادَةُ بِالْيَمِينِ",12,"ن",1,0],["مَتَى صادَمَ الخَطْبَ المُلِمَّ بِخُطْبَةٍ","كَفَى صادِماً مِنْهُ بأكْبَر صادِمِ",13,"م",1,0],["مَتى صالَ الْحِمامُ عَلى ابْنِ بَأْسٍ","بِهِ فِي كُلِّ مَلْحَمَةٍ يَصُولُ",14,"ل",1,0],["مَتى صَدرت أَوامره لِأَمرٍ","قَضَتهُ كَأَنَّما كانَت سِلاحا",15,"ح",2,0],["مَتى صارَت الجُردُ المَذاكي سَفائِنا","لِما شِئتَ من برٍّ وبَحرٍ ضَوامِنا",16,"ن",2,1],["متى صارت هيازع من قريش","فعدِّدها لنا بطناً وظهرا",17,"ر",2,0],["متى صفو الزمان يعود يوم","فيخبركم بصدق الود عنا",18,"ن",2,0],["متى صُمَّ عن داعي الغرامِ عصابةٌ","فما فيهمُ في الوجدِ غيرُ سميعِ",19,"ع",1,0],["متى صحَّ بين اثنين حبٌّ تأكَّدت","مواثيقهُ فالموتُ آخرُ عهدهِ",20,"د",2,1],["متى صاحب السن يوم الدجى","وذا للظلام وذا للسحر",21,"ر",1,0],["متى صافحتْ سمعي رقائقُ لفظِهِ","ترى كُلَّ عضوٍ فيَّ داخلهُ السُّكرُ",22,"ر",1,0],["متى صدق الواشون في نصح عاشق","محب وشأن الحران يتبصرا",23,"ر",2,0],["متى صحَّ فضلُ السبق لولا محمدٌ","لقلنا لعلَّ الفضل للمتقدم",24,"م",1,0],["مَتى صافَحتَ راحاتِهِ كف لامس","إِلَيهِ جَرَت مِنها كُنوزُ الرَغائِب",25,"ب",1,0],["مَتى صَفَتِ الدُّنيا لِحرّ فَأَبتغي","بِها صَفوَ عَيشٍ أَو خلوّي مِنَ الحُزنِ",26,"ن",1,0],["متى صاغ دراً شاعر بتفكر","لنظم قواف سمطها من سنا الزهر",27,"ر",1,0],["متى صارت مشاعرنا ذنوبا","لكي تُردى طيور العشق نحرا ؟!",28,"ر",2,0],["متى صحوة الخيل الكرام مجددا ؟","فإني على عقد النواصي غدا أقوى",29,"و",2,0],["متى صوتك يفاجئني .. ويرجع لي زمانٍ كان","متى تضحك لي الدنيا .. واشوفك دايم قبالي",30,"ل",2,1],["متى صلوها وفي الجنات موعدهم","فالهول عرس ومن زيناته الخذم",31,"م",1,0],["مَتَىٰ صَحَّ مِنِّي ومِنْكِ الحَدِيثُ","فمَا ضَلَّتِ الحُبَّ فينا البُعُوثُ",32,"ث",1,1],["متى صفو الزمان يعود يوما","فيخبركم بصدق الود عنا",33,"ن",2,0],["مَتىَ صَدَقُوا يَوْماً فَمِنْ خَلْفِ صِدْقِهِمْ","مَغَانِمُ كُبْرَى دُونَهَا خُطَطٌ عُصْمُ",34,"م",1,0]]}