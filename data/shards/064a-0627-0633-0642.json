{"poems":[[74,"أعيذ ريم الترك بالروم","https://www.aldiwan.net/poem19684.html","السريع"],[74,"يا سقيم الجفن أسقمني","https://www.aldiwan.net/poem20136.html","المديد"],[99,"جئتُ أشكو لكِ روحي وجواها","https://www.aldiwan.net/poem24757.html","الرمل"],[46,"يا سقم الجفن من حبيبي","https://www.aldiwan.net/poem30122.html","مجزوء البسيط"],[78,"ودعتني بزفرة واعتناق","https://www.aldiwan.net/poem38834.html","الخفيف"],[70,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[113,"سائق الظعن بالحدوج تأنى","https://www.aldiwan.net/poem16294.html","الخفيف"],[113,"وغزال كناسه المران","https://www.aldiwan.net/poem16387.html","الخفيف"],[119,"أي يوم يا ريم عيني تراكا","https://www.aldiwan.net/poem40860.html","عموديه"],[186,"أيها النائح المبكر مهلا","https://www.aldiwan.net/poem67040.html","الخفيف"],[266,"يا بني الهادي الرسول","https://www.aldiwan.net/poem38207.html","مجزوء الرمل"],[280,"يا سقى الله شادنا بات يسقي","https://www.aldiwan.net/poem25473.html","الخفيف"],[280,"لا تصدوا فربما مات صدا","https://www.aldiwan.net/poem25575.html","الخفيف"],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[358,"بلغا عني ربوع الصالحيه","https://www.aldiwan.net/poem39576.html","الرمل"],[358,"يا سقى عهدي وسكان الغضا","https://www.aldiwan.net/poem39744.html","الرمل"],[371,"ما كنت أول من أحب ومات في","https://www.aldiwan.net/poem17038.html","الكامل"],[385,"لمن العيس تختفي وتبين","https://www.aldiwan.net/poem49253.html","الخفيف"],[409,"حسبك الله لم أطلت جفاكا","https://www.aldiwan.net/poem33611.html","الخفيف"],[422,"من لصب مستطار القلب هائم","https://www.aldiwan.net/poem53954.html","الرمل"],[422,"زيد لوما فزاد في الحب وجدا","https://www.aldiwan.net/poem54124.html","الخفيف"],[435,"صاح وافى داعي الهناء يشير","https://www.aldiwan.net/poem40995.html","الخفيف"],[435,"يا خليلا لم أكن عنه خلي","https://www.aldiwan.net/poem41022.html","الرمل"],[457,"خذ بنا في محاسن الأوصاف","https://www.aldiwan.net/poem13842.html","الخفيف"],[457,"يا ليالي السفح من عهد الصبا","https://www.aldiwan.net/poem13926.html","الرمل"],[505,"أي راح دارت به الأقداح","https://www.aldiwan.net/poem38045.html","الخفيف"],[519,"شرف الوجه في تراب زرود","https://www.aldiwan.net/poem20806.html","الخفيف"],[556,"قل لمن خده من اللحظ دام","https://www.aldiwan.net/poem47221.html","الخفيف"],[556,"من عذيري من سقام","https://www.aldiwan.net/poem48076.html","مجزوء الرمل"],[556,"يا سقى الله ليلتي ليلة السب","https://www.aldiwan.net/poem48082.html","الخفيف"],[563,"غصن بان فوقه البدر بدا","https://www.aldiwan.net/poem34653.html","الرمل"],[563,"يا سقى الله لذة الموت لما","https://www.aldiwan.net/poem34935.html","الخفيف"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110437","الرمل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96978","الخفيف"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88617","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38767","الرمل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120092","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120072","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56140","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56214","الرمل"],[1235,"","https://poetry.dctabudhabi.ae/diwan/poem/105223","الخفيف"],[1235,"","https://poetry.dctabudhabi.ae/diwan/poem/105219","الرمل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115885","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79871","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79913","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125462","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100301","الرمل"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122494","الخفيف"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104675","الرمل"],[3226,"","https://poetry.dctabudhabi.ae/diwan/poem/140161",""],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121599","المديد"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67997","الرمل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74080","الرمل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66351","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91521","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91992","الرمل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36790","الرمل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85156","الرمل"],[3995,"","https://poetry.dctabudhabi.ae/diwan/poem/143844","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90777","المديد"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136676",""],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136638",""],[4346,"","https://poetry.dctabudhabi.ae/diwan/poem/100665","الرمل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33146","السريع"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33567","الخفيف"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33167","الخفيف"],[5145,"من رأى البرق تعالى وسنا","https://www.poetsgate.com/ViewPoem.aspx?id=108060",""],[5145,"أعوز الصبر فهل لي من طريق","https://www.poetsgate.com/ViewPoem.aspx?id=108199",""],[5455,"القرايا","https://www.poetsgate.com/ViewPoem.aspx?id=40606",""],[5461,"الليالي فرقتنا","https://www.poetsgate.com/ViewPoem.aspx?id=22533",""],[5573,"وين اصبحت ياهارب","https://www.poetsgate.com/ViewPoem.aspx?id=200310",""],[5573,"ياخشف اشوف ان الهوى ماله حدود","https://www.poetsgate.com/ViewPoem.aspx?id=203090",""],[5690,"سر أريحَّ الشمال سرْ بسلام","https://www.poetsgate.com/ViewPoem.aspx?id=172187",""],[5704,"حُبٌّ وشِعْر","https://www.poetsgate.com/ViewPoem.aspx?id=191112",""],[6084,"يا سقى صوب الحيا الحي غيثاً","https://www.poetsgate.com/ViewPoem.aspx?id=170876",""],[6124,"سقيم الفراق","https://www.poetsgate.com/ViewPoem.aspx?id=159785",""],[456,"عروس الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84502&r=&rc=1",""]],"verses":[["يا سقمي من سقم أجفانه","زدني ويا لائمتي لومي",0,"م",2,0],["يا سقيم الجفن أسقمني","وحلا في حبه ألمي",1,"ي",1,1],["يا سقى الله لِليلى أيكةً","وجزاها الخيرَ عنّا ورعاهَا",2,"ا",3,0],["يا سَقَمَ الجَفنِ مِن حَبيبي","أَلبَسَني حُلَّةَ السَقامِ",3,"م",1,1],["يا سقيمَ الجفونِ من غيرِ سُقمٍ","بينَ عَينيكَ مَصرعُ العُشَّاقِ",4,"ق",1,0],["يا سَقى اللهُ عقيقاً باللّوَى","ورَعَى ثَمّ فريقاً مِن لؤي",5,"ي",1,0],["يا سقت دارَها السَحائب عَني","إِنَّ هَذا البُكاءِ لِلدَمع أَفنى",6,"ن",2,0],["يا سَقا ذَلِكَ الزَمان وَحَيا","ه مَلث مِن الرِضى هتان",7,"ن",1,0],["يا سقى الله بالسواكب حيا","يا حياة الولهان فيه حماكا",8,"ك",2,0],["يا سَقى اللَهُ مِن بُطونِ الغَوادي","مَضجَعاً فيهِ ذَلِكَ البَدرُ حَلا",9,"ل",2,0],["يا سقاة الحوض في","يوم الظما والسلسبيل",10,"ل",1,0],["يَا سَقَى اللَّهُ شَادِناً باتَ يَسْقِي","ما حَكاه لَمَاهُ صِرفاً عَتِيقا",11,"ق",2,1],["يا سقَى اللّه للرُّصافَة عَهْداً","كَنَسيم الصَّبا يَرِقُّ ويَنْدى",12,"د",2,0],["يا سقاة الغرام بالأعين النج","ل كئوسا مشبوبة القطرات",13,"ت",1,0],["يا سقى الرَحمن عَهداً قَد مَضى","بِكُؤوس المُزن أَقداحاً هَنيّه",14,"ي",2,0],["يا سقى عَهدي وَسُكّان الغَضا","وَزَماناً بِالتَصابي قَد مَضى",15,"ا",1,1],["يا سُقمَهُ رِفقاً بِمُدنَفِ جَفنِهِ","وَتَرَفُّقاً أَيضاً بِقَلبِ المُدنَفِ",16,"ف",1,0],["يا سَقى ذَلِكَ الجَناب وَعَهداً","قَد تَقَضى بِهِ سَحاب هَتون",17,"ن",1,0],["يا سقى اللّه عصر وصْلٍ تقضَّى","وعسى أن ترده لي عساكا",18,"ك",2,0],["يا سقى الله الحمى من موطنٍ","يزأَرُ اللَّيث به والظبي باغم",19,"م",1,0],["يا سقتها السماء وبل غوادٍ","حاملاتٍ للريّ برقاً ورعدا",20,"د",2,0],["يا سقاة الأقداح هبوا صباحا","بصبوح لها القلوب تطيرُ",21,"ر",1,0],["يا سقى الله أويقات مضت","معكم في خير ذاك المنزل",22,"ل",1,0],["يا سقي الله عهده بمُلِثٍّ","غير مستأخر ولا مخلاف",23,"ف",1,0],["يا سقى الوسميُّ مرجاً بَرَدتْ","فيه من حرِّ الهمومِ المهجُ",24,"ج",1,0],["يا سُقاةَ الكُؤوسِ دَوْراً فدوْراً","وحَناناً دينُ الغرامِ سَماحُ",25,"ح",1,0],["يا سَقى اللّهُ بالحِمى أهلَ بدرٍ","كم به بين حيّهم من شهيدِ",26,"د",1,0],["يا سقيمَ الجفون من غيرِ سُقْمٍ","لا تَلُمنِي إنْ متُّ منهنّ سُقْما",27,"م",2,0],["يا سَقَى اللَّهُ قُبوراً","لكمُ زِنَّ الكثيبا",28,"ب",2,0],["يا سَقى اللَّه لَيلتي لَيلة السّبْ","تِ زُلالاً لا بل سقاها شرابا",29,"ب",2,1],["يا سقى الله زمانا بالحمى","ورعى بالشعب عيشاً رغدا",30,"د",2,0],["يا سقى الله لذة الموت لما","يتلاقى المحب والمحبوبُ",31,"ب",1,1],["يا سَقَى اللهُ أُويقاتاً مَضَت","بينَ أَهليكَ الأَجلاَّءِ الكَرام",32,"م",1,0],["يا سقى اللَه معهداً قد شقته","سحب أجفاني الدموع السجاما",33,"م",2,0],["يا سقيناه وهو غير محيل","درة الجفن قبل سقيا الغمام",34,"م",1,0],["يا سَقاكَ العِزّ يا بُرجَ العُلى","غَيث مَجدٍ فَوقَك الدّهرَ يَسِحُّ",35,"ح",1,0],["يا سقي بلواحظ","لجفونها خلق السقامُ",36,"م",1,0],["يا سقيم الجفون قد خلق السق","م بجسمي وخصرك المخصورِ",37,"ر",1,0],["يا سقطة سقطت بجنبي حوّلي","عني وزوري صاحب الكفرانِ",38,"ن",1,1],["يا سقاها الله منه أنعما","كم سقتنا صفو صافي الأكوسِ",39,"س",1,0],["يا سقى اللَه تربة قد حوته","من سحاب العفو الملّث الهتون",40,"ن",1,0],["يا سقى اللَه ضريحاً ضمه","من سحاب العفو غيثاً مستهلا",41,"ل",2,0],["يا سقيمَ الجفونِ كُن لسقيمٍ","أنتَ ممَّا به سقيمٌ صحيحُ",42,"ح",1,1],["يا سقى اللهُ ضحيَّاتِ النقى","وكَساها الروضُ وشياً مونقا",43,"ق",2,0],["يا سقى عهدَها حياً من ثنايا","ها ودمعي لها وميضٌ وقطر",44,"ر",1,0],["يا سقيمَ الجُفون أشغلتَ بالي","ليتَ شعري متى تعودُ الليالي",45,"ل",2,1],["يا سقى الجرعاء من ربع نوار","موطف الغيث بمنهلّ القطار",46,"ر",1,1],["يا سَقَى اللهُ قبرهُ مَِن إمامٍ","كانَ للمتَّقِينَ طُرّاً إمامَا",47,"م",2,0],["يا سَقى اللَهُ نَواحي طيبَةً","وَعَقيقَيها حَيّاً مُنسَجِما",48,"م",2,0],["يا سقى الله ربعه من مقام","دام بالعلم آهلا مأنوسا",49,"س",2,0],["يا سقى وادي دِمشقَ حياً","طاب مغتبقاً ومصطبَحَا",50,"ح",2,0],["يَا سَقَى الله زماناً","جاد بالجَمْع وطابا",51,"ب",2,0],["يا سقى لَيلَتِنا بال","جزع وَكّاف العَزالي",52,"ل",2,0],["يا سقى الرحمن دهراً لم أخل","أنه يؤذن عنا بالزّوال",53,"ل",1,0],["يا سقى اللَه عَهدَ ذاكَ الوصالِ","ذكرُه لَم يَزَل أَنيساً بِبالي",54,"ل",2,1],["يا سقى الرَحمن أَيامَ الصبا","من دُموع العَين وَكّافُ الديم",55,"م",1,0],["يا سَقى اللَهُ حِماها وَابِلاً","مُسبِلَ الطَرفِ مِنَ الغَيثِ هَمُوعا",56,"ع",2,0],["يا سقيم الخصر يا من","خصره للجسم أسقم",57,"م",1,0],["يا سقيم الوعد والأج","فان كلي منك مسقم",57,"م",1,0],["يا سقيط الندى على الأقحوان","شأنك الآن في الصبوح وشاني",58,"ن",2,1],["يا سقاة الراح خمرتكم","حلق الأذكار موردنا",59,"ن",2,0],["يا سَقيم الجُفون صحَّ غَرامي","فيكَ لكن يَشكوك قلبي اعتلالا",60,"ل",2,0],["يا سقيمَ الجُفون جفني سَقيمٌ","وغرامي كما عَهدت مُقيم",61,"م",1,1],["يا سقى اللَه الحمى ثم رعى","يا رعى اللَه الحمى ثم سقى",62,"ق",2,0],["يا سقماً أسقمني منهما","هل لي إن لم ترثِ لي طالبُ",63,"ب",1,0],["يا سَقامِي من سُقمِ طرفٍ سَقيمِ","وبلائي من حُبِّ غيرِ رَحيمِ",64,"م",1,1],["يا سقيمَ الجفونِ أسقمتَ جسمي","فاشفِهِ كيفَ شئتَ لا بكَ ما بي",65,"ب",2,0],["يا سقي الله عشيّات الحمى","بين أكناف التقى فالمنحنى",66,"ن",2,0],["يا سقى الله عشيات الحمى","فلقد كانت من العيش أنيق",67,"ق",1,0],["ياسقى الله قبل اسافر عنك يالدار الثمينه","يوم انا طفل يشوف عيوب جدرانك مزايا",68,"ا",3,0],["ياسقى الله يوم كنت الريح والدنيا سفينه","قبل مالدنيا تكون الريح والسفن البرايا",68,"ا",3,0],["ياسقى الله او بلاش ازيد هذا الطين طينه","لي هنا والعمر مابه متسّع لاهل الرزايا",68,"ا",3,0],["يا سقى الله ليلة بك عرفتنا","في شعيب شهار عن غيرك سلينا",69,"ن",2,0],["ياسقم منهو طواه الياس ياحبيب","وأمسى مع الناس عايف نوم ومحارب",70,"ب",1,1],["ياسقم حالي ياعنا هذا الوجود","ياجرح قلبي ياشقاه وياعناه",71,"ا",2,0],["يا سقى اللّه ثغر بيروت قطراً","من مياه الحيوة لا من غمامِ",72,"م",1,0],["يا سقم قلبي والفراق أذلني","يا عمق جرحي ما الذي يبريه",73,"ي",2,0],["يا سقى صوب الحيا الحي غيثاً","ينعش الشبح فيحيي الاكاما",74,"م",2,1],["يا سقيمًا سلَّهُ طولُ الفراقِ","ما الذي كنت الليالي تبتغيهِ",75,"ي",2,1],["يا سقى اللهُ رُبُوعًا كُلَّها","من روايا المُزن ِ فوقَ الحَرَم",76,"م",1,0]]}