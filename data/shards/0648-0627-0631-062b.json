{"poems":[[65,"خليلي سيرا بارك الله فيكما","https://www.aldiwan.net/poem45686.html","الطويل"],[56,"وإني لأرثي للكريم إذا غدا","https://www.aldiwan.net/poem27412.html","الطويل"],[53,"وهب يا واهب الهبات اللواتي","https://www.aldiwan.net/poem8310.html","الخفيف"],[53,"عد عن دار وعن جار ظعن","https://www.aldiwan.net/poem66467.html","الرمل"],[87,"مرحبا بالفتى العظيم الشان","https://www.aldiwan.net/poem7532.html","الخفيف"],[47,"من عذيري من الظباء الغيد","https://www.aldiwan.net/poem63503.html","الخفيف"],[46,"سقى عهد الحمى سبل العهاد","https://www.aldiwan.net/poem30558.html","الكامل"],[71,"برغمي أن بيتكم يضام","https://www.aldiwan.net/poem29243.html","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39552","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202526","الرجز"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54325","الخفيف"],[111,"مدد الحق للقلوب الصواردي","https://www.poetsgate.com/ViewPoem.aspx?id=528",""],[111,"جرد النفس وانهها عن هواها","https://www.poetsgate.com/ViewPoem.aspx?id=530",""],[53,"وهبُ يا واهبَ الهباتِ اللواتي","https://www.poetsgate.com/ViewPoem.aspx?id=27040",""],[132,"بموتِ المرتضى الواكي الرضى","https://www.aldiwan.net/poem50216.html","الوافر"],[164,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[342,"أمن دمنتين عرج الركب فيهما","https://www.aldiwan.net/poem45419.html","الطويل"],[396,"يا علي ماتوا اللي مانباهم يموتون","https://www.aldiwan.net/poem54469.html","عموديه"],[422,"من لصب مستطار القلب هائم","https://www.aldiwan.net/poem53954.html","الرمل"],[422,"بارق الشام إلى الكرخ سرى","https://www.aldiwan.net/poem54164.html","الرمل"],[422,"هل تركتم غير الجوى لفؤادي","https://www.aldiwan.net/poem54177.html","الخفيف"],[443,"أي طود هوى من الأطواد","https://www.aldiwan.net/poem2497.html","البسيط"],[453,"شوقي إليكم مثل وجدي فيكم","https://www.aldiwan.net/poem53724.html","الكامل"],[463,"بكى النار سترا على الموقد","https://www.aldiwan.net/poem56223.html","المتقارب"],[466,"لمن الخيل كأمثال السعالي","https://www.aldiwan.net/poem15101.html","الرمل"],[473,"أنر بصبح الوصل عيشي فقد","https://www.aldiwan.net/poem59676.html","السريع"],[519,"غربت منكم شموس التلاقي","https://www.aldiwan.net/poem20786.html","الخفيف"],[532,"وأرثي له من موقف السوء عنده","https://www.aldiwan.net/poem46017.html","الطويل"],[563,"يا أبا مسلم الفتى الخولاني","https://www.aldiwan.net/poem33705.html","الخفيف"],[563,"نحن من المنسوبين","https://www.aldiwan.net/poem33814.html","مجزوء الرجز"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122540","الخفيف"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66691","الخفيف"],[673,"","https://poetry.dctabudhabi.ae/diwan/poem/137344",""],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38952","الرمل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70791","الخفيف"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35351","الخفيف"],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/69227","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64551","الخفيف"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49958","المنسرح"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2010,"","https://poetry.dctabudhabi.ae/diwan/poem/143780","المتقارب"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48267","الخفيف"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108476","الخفيف"],[2088,"","https://poetry.dctabudhabi.ae/diwan/poem/147746",""],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126195","الرجز"],[2610,"","https://poetry.dctabudhabi.ae/diwan/poem/22595","الرمل"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100509","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205010","الوافر"],[3083,"","https://poetry.dctabudhabi.ae/diwan/poem/137968",""],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132578","الرجز"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132574","الخفيف"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62935","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138643",""],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132087","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117862","الوافر"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118000","الرمل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85145","الخفيف"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85176","الخفيف"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135248","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111510","الرجز"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107493","الطويل"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33064","المديد"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73259","الخفيف"],[5061,"لبى العرب","https://www.poetsgate.com/ViewPoem.aspx?id=152994",""],[5273,"حلب","https://www.poetsgate.com/ViewPoem.aspx?id=180619",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5344,"عطره الشانيل ..","https://www.poetsgate.com/ViewPoem.aspx?id=180706",""],[5582,"هوَ الدَّهْرُ فِينا جائِدٌ غَيْرُ جائِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=186912",""],[5596,"وفاء وولاء","https://www.poetsgate.com/ViewPoem.aspx?id=209113",""],[5790,"إن هداني في ليل عنبر خاله","https://www.poetsgate.com/ViewPoem.aspx?id=112124",""],[5845,"لاقيتِ يا نفسُ حقاً ما حكى الحاكي","https://www.poetsgate.com/ViewPoem.aspx?id=16704",""],[5850,"أَمِنْ دِمْنتينِ عرَّجَ الركبُ فيهما","https://www.poetsgate.com/ViewPoem.aspx?id=14109",""],[5997,"لِرَبِّ الْعَالَمَيْنِ","https://www.poetsgate.com/ViewPoem.aspx?id=214257",""],[6202,"وقفة رجاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86759&r=&rc=60",""],[2944,"ابكِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86014&r=&rc=3",""]],"verses":[["وَأَرثي لِمَن يَشكو الهوى فكأَنَّهُ","بِهِ غَرَضٌ للعاذلينَ رَجيمُ",0,"م",1,0],["وَأَرثي لَهُ في مَوقِفِ السوءِ عِندَهُ","كَما قَد رَثَوا لِلطَرفِ وَالعِلجُ راكِبُه",1,"ه",1,0],["وارثيا لامرئٍ ألَحَّ عليه","للزمان الصَّؤول ظُفْرٌ ونابُ",2,"ب",1,0],["وارثَ النجدةِ عن ذي نجدةٍ","عُبِدَ اللَّهُ بها دون الوثن",3,"ن",1,0],["وارث النسر للسلام جناحا","ه وللحرب ذانك المِخلبان",4,"ن",1,0],["وارِثُ البُردِ وَالقَضيبِ وَحُكمِ ال","لَهِ في كُلِّ سَيِّدٍ وَمَسودِ",5,"د",1,0],["وَأَرَّثَ بَينَ حَيِّ بَني جُلاحٍ","سَنا حَربٍ وَحَيِّ بَني مَصادِ",6,"د",1,0],["وأرثيه رثاءً مستقيماً","ويمكنني القوافي والكلامُ",7,"م",1,0],["وأرثت أوتارَها فهي تبكي","من شجاها حبيسةَ النغماتِ",8,"ت",1,0],["وارث كل مالك وما ملكْ","ومهلك الحيّ ومحيي من هلكْ",9,"ك",1,0],["وارثُ الأصمعيّ في لغة الضا","د وفي الشعر وارث البحتريّ",10,"ي",1,0],["وارث الفيض والكمالات والحك","مة من جده الرسول الهادي",11,"د",2,0],["وارث الأنبياء علما وحكما","وسفير عنها الى من عداها",12,"ا",3,0],["وارثيا لامرىء ٍ ألَحَّ عليه","للزمان الصَّؤول ظُفْرٌ ونابُ",13,"ب",1,0],["وأرثت الخلائقَ كلَّ حزن","بموت من نقيرٍ أو غنِيّ",14,"ي",1,0],["وأرثى له إذ صار ردءاً لعصبة","على الله والدين الحنيف تعصبوا",15,"ب",3,0],["وَإِرثِ رَمادٍ كَالحَمامَةِ ماثِلٍ","وَنُؤيَينِ في مَظلومَتَينِ كُداهُما",16,"م",2,0],["وارثوا الأنبيا في علم مخزون مكنون","حبهم عندنا مفروض لا نفل مسنون",17,"ن",1,0],["وارثٌ بعد أَبيه في العُلى","من بني هاشم ما أَوْرَثَ هاشم",18,"م",1,0],["وارث القطب الرفاعيّ الَّذي","صيته أملى الملا واشتهرا",19,"ر",2,0],["وارثٌ علم جده سيد الر","سل وسر الآباء في الأولاد",20,"د",1,0],["وارث الهدي والدلالة والعص","مة عن أحمد به بعد اجتهاد",21,"د",1,0],["وارثوا وجودوا وارفقوا وتعطفوا","وادعوا ورقوا واستجيروا وارحموا",22,"م",3,0],["وإرثُ عليٍّ لأولاده","إذا آيةُ الإرثِ لم تُفسَد",23,"د",1,0],["وارثٌ للفخر من أشياخهِ","أخذ بِجالاً عن بِجال",24,"ل",1,0],["وَاِرثِ لِمَن أَفلاكُ أَجفانِهِ","تُطلِعُ مِن أَدمُعِها أَنجُما",25,"م",2,0],["وارِثُ البحرِ والهِزَبْرِ وصَلْتُ ال","بَدرِ كلّاً وعارِضُ الإنفاقِ",26,"ق",1,0],["وأرثي له من موقف السوء عنده","كمرثيتي للطرف والعلج راكبه",27,"ه",1,1],["وارثاً كنت علمَ خيرِ نبيٍّ","هو طه محمد العدناني",28,"ن",2,0],["وإرث من كلمه ال","حق بطور سينين",29,"ن",1,0],["وارثُ البُردِ والقَضيبِ وإن صا","را إلى الغَيرِ بُردهُ والقَضيبُ",30,"ب",1,0],["وارثُ السيف والعِمامةِ والرا","يةِ مطويّةً وذاتِ القيودِ",31,"د",1,1],["وأَرثاهُمُ للعيون الدوامي","وأَشعرهم بالخطوب الشِداد",32,"د",1,0],["وارِث الفَخرِ بِجدٍّ كأبِ","وَلَهُ في النّفسِ بِالفخرِ صفِ",33,"ف",1,0],["وارثٌ كلَّ خَصْلةٍ مِنْ جدودٍ","أهل فخرٍ تقدموا إقداما",34,"م",2,0],["وارِثِ المَجدِ مِن عَلِيٍّ وَمَن قَد","صَيَّرَ الكُفرَ لِلرَدى وَالتَبابِ",35,"ب",1,0],["وَأُرثي لَهُ مِن وَقفة عِندَ بابه","كمرثيتي للطِرف وَالعلجُ راكبه",36,"ب",2,0],["وارث الأرض خذهم وأبدهم","وانتصر لي منهم وخذ لي بذحلي",37,"ل",2,0],["وارثُ مجد الكرام عامِره","لهُ طريفُ العُلى ومُتلَدُهَا",38,"د",3,0],["وارث الارض والسماءِ جميعاً","يوم نادى القضاءُ آنَ أواني",39,"ن",2,0],["وأرث في كبدي غلةً","من الجوع نيرانها مضرمه",40,"م",2,0],["وارثاً من أبيه سالمَ مجداً","وفخاراً من جدِّه سُلطانِ",41,"ن",1,0],["وارث هذا الحبيب واندب صباه","حول رمس من قبل ضم حبيبا",42,"ب",2,0],["وارثِ لسُقمي وطول صبري","فقد وَهَت منّي العِظامُ",43,"م",1,0],["وارث علمِ الشاذِلّى حَقَّا","آخِذ أعلامِ الكمالِ صِدقَا",44,"ق",2,0],["وارِثَ المَجدِ قَديماً","سامِياً يَنمى اِرتِفاعا",45,"ع",2,0],["وارث الأنبياء بالقسط مس","تودع سر الأئمة الأعلام",46,"م",1,0],["وأرثي بالقريض قديم حبي","لو أن الميت يرجعه الرثاء",47,"ا",2,0],["وارثُ السر من أبيه جمال ال","دين والجد طاهر الأطهار",48,"ر",1,0],["وارث لصب ليله","عاد عليه سرمدا",49,"د",2,0],["وارث يا ناعس الجفون لصب","ليله مثل حبه لك سرمد",50,"د",1,0],["وارثه بالعهد والاسرار","وكان شهما عالي المقدار",51,"ر",1,0],["وأَرث جَسَّاسُ بنُ مُرَّةَ فيهم","سَنَا لَهَبٍ لا يَبرحُ الدهرَ ساطعَا",52,"ع",2,0],["وارث الأوصياء من آل طه","عيبة العلم علة الايجاد",53,"د",1,0],["وأرثيك حينا بالعبارات موجعا","وآونة أرثيك بالعبرات",54,"ت",1,0],["وإرث خلفته له أصول","كرامٌ من بني الزهراء صيد",55,"د",1,0],["وارث المختار في أسراره","والمقامات السميات المغاني",56,"ن",2,0],["وارث السر عن شيوخ كرام","سيما عن جدوده والقرابه",57,"ب",2,0],["وارث المصطفى ابيه وجده","وبعلياهما علا نجم جده",58,"ه",1,0],["وارثٌ هادي مؤخرٌ باقي","لي بك اجعلنْ لسان صِدقٍ أرافعْ",59,"ع",1,0],["وأرث النيران حيث تلتهم","وصاح والدمع سخيناً ينسجم",60,"م",1,0],["وأرثي لذيّاك الذكاء مُضيَّعاً","وأرثي لذيَّاك البناء مهدما",61,"م",2,0],["وَاِرثوا مَخزونِ عِلمٍ عَلَيهِ","كُلُّ ذي عِلمٍ عِيالٌ وَكَلُّ",62,"ل",1,0],["وارثِ للعاشِقِ الذي لا يرَاهُ ال","دَّهرُ يوماً يُصغي إِلى عُذالِه",63,"ل",2,0],["وارثهہ عادات واطبااع\\\" حميدهہ","#سطر_التاريخ عنها والكتب",64,"ب",1,0],["وأرْثي ضِياءَ الحَقِّ تَحْتَ نِفاقِنا","فآخرُ شَهْمٍ في النَّذالَةِ أوَّلُ",65,"ل",1,0],["وإرث ذوي الأرحام لبعضهم","وبعضهمو عن ذلك القول أحجما",66,"م",2,0],["وارثين أمجاد من جده وأبّه","حاصدين فعولنا لا جات ميله",67,"ل",2,0],["وَأَرْثِيكَ فِي نَسْقِ القَرِيضِ قَصائِداً","وَهَلْ عَنْكَ تُغْنِي مُبْكِياتُ القَصائِدِ",68,"د",1,0],["وارث العرش كابراً يتعلّى","بعُلاه من كابرٍ وأُباة",69,"ه",1,0],["وارث للعاشق الذي لا يراه الد","دهر يوماً يصغي إلى عذاله",70,"ل",2,0],["وارثي لقلبي بما في سحرِ عينكِ منْ","حبائلٍ مرصداتٌ لي وأشراكِ",71,"ك",1,0],["وإرثِ رمادٍ كالحملمة ِ ماثلٍ","ونؤيينِ في مظلومتينِ كداهما",72,"م",2,0],["وَارِثُ الْأيَّامِ مَوِّلَاي الْمُعَيَّنَ","فَالِقُ الْأَصْبَاحِ سُلْطَانُ الكرمْ",73,"م",1,0],["وأرثي لغيري ناسيا ما يحيطني","من الموت لا يبقى من الخلق حاييا",74,"ي",2,0],["وارث للشعر والدموع غراما","قد نعمنا به، ومات صبيّا",75,"ي",2,0]]}