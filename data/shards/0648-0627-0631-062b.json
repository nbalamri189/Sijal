{"poems":[[63,"خليلي سيرا بارك الله فيكما","https://www.aldiwan.net/poem45686.html","الطويل"],[54,"وإني لأرثي للكريم إذا غدا","https://www.aldiwan.net/poem27412.html","الطويل"],[51,"وهب يا واهب الهبات اللواتي","https://www.aldiwan.net/poem8310.html","الخفيف"],[51,"عد عن دار وعن جار ظعن","https://www.aldiwan.net/poem66467.html","الرمل"],[85,"مرحبا بالفتى العظيم الشان","https://www.aldiwan.net/poem7532.html","الخفيف"],[45,"من عذيري من الظباء الغيد","https://www.aldiwan.net/poem63503.html","الخفيف"],[44,"سقى عهد الحمى سبل العهاد","https://www.aldiwan.net/poem30558.html","الكامل"],[69,"برغمي أن بيتكم يضام","https://www.aldiwan.net/poem29243.html","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39552","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202526","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54325","الخفيف"],[51,"وهبُ يا واهبَ الهباتِ اللواتي","https://www.poetsgate.com/ViewPoem.aspx?id=27040",""],[129,"بموتِ المرتضى الواكي الرضى","https://www.aldiwan.net/poem50216.html","الوافر"],[161,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[338,"أمن دمنتين عرج الركب فيهما","https://www.aldiwan.net/poem45419.html","الطويل"],[392,"يا علي ماتوا اللي مانباهم يموتون","https://www.aldiwan.net/poem54469.html","عموديه"],[417,"من لصب مستطار القلب هائم","https://www.aldiwan.net/poem53954.html","الرمل"],[417,"بارق الشام إلى الكرخ سرى","https://www.aldiwan.net/poem54164.html","الرمل"],[417,"هل تركتم غير الجوى لفؤادي","https://www.aldiwan.net/poem54177.html","الخفيف"],[438,"أي طود هوى من الأطواد","https://www.aldiwan.net/poem2497.html","البسيط"],[449,"شوقي إليكم مثل وجدي فيكم","https://www.aldiwan.net/poem53724.html","الكامل"],[459,"بكى النار سترا على الموقد","https://www.aldiwan.net/poem56223.html","المتقارب"],[462,"لمن الخيل كأمثال السعالي","https://www.aldiwan.net/poem15101.html","الرمل"],[469,"أنر بصبح الوصل عيشي فقد","https://www.aldiwan.net/poem59676.html","السريع"],[515,"غربت منكم شموس التلاقي","https://www.aldiwan.net/poem20786.html","الخفيف"],[528,"وأرثي له من موقف السوء عنده","https://www.aldiwan.net/poem46017.html","الطويل"],[559,"يا أبا مسلم الفتى الخولاني","https://www.aldiwan.net/poem33705.html","الخفيف"],[559,"نحن من المنسوبين","https://www.aldiwan.net/poem33814.html","مجزوء الرجز"]],"verses":[["وَأَرثي لِمَن يَشكو الهوى فكأَنَّهُ","بِهِ غَرَضٌ للعاذلينَ رَجيمُ",0,"م",1,0],["وَأَرثي لَهُ في مَوقِفِ السوءِ عِندَهُ","كَما قَد رَثَوا لِلطَرفِ وَالعِلجُ راكِبُه",1,"ه",1,0],["وارثيا لامرئٍ ألَحَّ عليه","للزمان الصَّؤول ظُفْرٌ ونابُ",2,"ب",1,0],["وارثَ النجدةِ عن ذي نجدةٍ","عُبِدَ اللَّهُ بها دون الوثن",3,"ن",1,0],["وارث النسر للسلام جناحا","ه وللحرب ذانك المِخلبان",4,"ن",1,0],["وارِثُ البُردِ وَالقَضيبِ وَحُكمِ ال","لَهِ في كُلِّ سَيِّدٍ وَمَسودِ",5,"د",1,0],["وَأَرَّثَ بَينَ حَيِّ بَني جُلاحٍ","سَنا حَربٍ وَحَيِّ بَني مَصادِ",6,"د",1,0],["وأرثيه رثاءً مستقيماً","ويمكنني القوافي والكلامُ",7,"م",1,0],["وأرثت أوتارَها فهي تبكي","من شجاها حبيسةَ النغماتِ",8,"ت",1,0],["وارث كل مالك وما ملكْ","ومهلك الحيّ ومحيي من هلكْ",9,"ك",1,0],["وارثُ الأصمعيّ في لغة الضا","د وفي الشعر وارث البحتريّ",10,"ي",1,0],["وارثيا لامرىء ٍ ألَحَّ عليه","للزمان الصَّؤول ظُفْرٌ ونابُ",11,"ب",1,0],["وأرثت الخلائقَ كلَّ حزن","بموت من نقيرٍ أو غنِيّ",12,"ي",1,0],["وأرثى له إذ صار ردءاً لعصبة","على الله والدين الحنيف تعصبوا",13,"ب",3,0],["وَإِرثِ رَمادٍ كَالحَمامَةِ ماثِلٍ","وَنُؤيَينِ في مَظلومَتَينِ كُداهُما",14,"م",2,0],["وارثوا الأنبيا في علم مخزون مكنون","حبهم عندنا مفروض لا نفل مسنون",15,"ن",1,0],["وارثٌ بعد أَبيه في العُلى","من بني هاشم ما أَوْرَثَ هاشم",16,"م",1,0],["وارث القطب الرفاعيّ الَّذي","صيته أملى الملا واشتهرا",17,"ر",2,0],["وارثٌ علم جده سيد الر","سل وسر الآباء في الأولاد",18,"د",1,0],["وارث الهدي والدلالة والعص","مة عن أحمد به بعد اجتهاد",19,"د",1,0],["وارثوا وجودوا وارفقوا وتعطفوا","وادعوا ورقوا واستجيروا وارحموا",20,"م",3,0],["وإرثُ عليٍّ لأولاده","إذا آيةُ الإرثِ لم تُفسَد",21,"د",1,0],["وارثٌ للفخر من أشياخهِ","أخذ بِجالاً عن بِجال",22,"ل",1,0],["وَاِرثِ لِمَن أَفلاكُ أَجفانِهِ","تُطلِعُ مِن أَدمُعِها أَنجُما",23,"م",2,0],["وارِثُ البحرِ والهِزَبْرِ وصَلْتُ ال","بَدرِ كلّاً وعارِضُ الإنفاقِ",24,"ق",1,0],["وأرثي له من موقف السوء عنده","كمرثيتي للطرف والعلج راكبه",25,"ه",1,1],["وارثاً كنت علمَ خيرِ نبيٍّ","هو طه محمد العدناني",26,"ن",2,0],["وإرث من كلمه ال","حق بطور سينين",27,"ن",1,0]]}