{"poems":[[63,"من الحزم أن تلقى الهوى وهو مقبل","https://www.aldiwan.net/poem51490.html","الطويل"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104679","البسيط"]],"verses":[["وعُلَّ بماءِ الوَردِ خَيشٌ كأنَّه","على جُدْرهِ ثَوبُ العَروسِ المُصَندلُ",0,"ل",1,0],["وعلَّ بكلِّ قلب من جواه","لذاك الغيظ ناراً تجتوينا",1,"ن",2,0],["وعل بعدي محبّاً فيك يتبعها","قصائداً فيك زانتها قوافيها",2,"ي",3,0]]}