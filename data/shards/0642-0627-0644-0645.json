{"poems":[[77,"قال من يعنى بأمري","https://www.aldiwan.net/poem36625.html","مجزوء الرمل"],[88,"وضح الحق واستاقم السبيل","https://www.aldiwan.net/poem45025.html","الطويل"],[72,"بأبي غصن كبدر","https://www.aldiwan.net/poem20553.html","مجزوء الرمل"],[51,"علني أحمد من الدوشاب","https://www.aldiwan.net/poem8651.html","الخفيف"],[51,"هجرتني ظلما لتحميل واش","https://www.aldiwan.net/poem64929.html","الخفيف"],[51,"لا عرتك الخطوب يا ابن حريث","https://www.aldiwan.net/poem65778.html","الخفيف"],[51,"مدرك عاين أمه","https://www.aldiwan.net/poem66348.html","مجزوء الرمل"],[91,"خير ما يكتبه ذو مرقم","https://www.aldiwan.net/poem8865.html","عموديه"],[91,"رب ليل نجومه ضاحكات","https://www.aldiwan.net/poem62801.html","عموديه"],[70,"لو تراني وحبيبي عندما","https://www.aldiwan.net/poem42388.html","الرمل"],[85,"كان في الروم عظيم","https://www.aldiwan.net/poem7580.html","مجزوء الرمل"],[99,"هرة","https://www.aldiwan.net/poem5830.html","عموديه"],[66,"صاحب السيف الصقيل المحلا","https://www.aldiwan.net/poem39637.html","المديد"],[66,"ظن قومي أن الأساة ستبري","https://www.aldiwan.net/poem40115.html","الخفيف"],[69,"قال ما تطلب قل لي","https://www.aldiwan.net/poem28356.html","مجزوء الرمل"],[69,"لفلان الدين بغل","https://www.aldiwan.net/poem29040.html","مجزوء الرمل"],[31,"عاود القلب يا لقومي سقما","https://www.aldiwan.net/poem41338.html","الخفيف"],[105,"يا بني غنم بن عوف ما لكم","https://www.aldiwan.net/poem44018.html","الرمل"],[105,"مرحبا بالأحبة المقبلينا","https://www.aldiwan.net/poem44058.html","الخفيف"],[105,"سيد الرسل وأم المؤمنين","https://www.aldiwan.net/poem44196.html","الرمل"],[105,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[48,"اسقني الراح على وجه","https://www.aldiwan.net/poem64407.html","مجزوء الرمل"],[48,"أعرض عن الربع إن مررت به","https://www.aldiwan.net/poem66176.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[150,"زائر","https://www.aldiwan.net/poem17106.html","عموديه"],[187,"حي يا سعد قبابا بالحمى","https://www.aldiwan.net/poem35099.html","الرمل"],[197,"قلت صلني فإني لك باق","https://www.aldiwan.net/poem45573.html","الخفيف"],[221,"عين من هذه التي لا تنام","https://www.aldiwan.net/poem39708.html","الخفيف"],[303,"رفع المجد راية للتهاني","https://www.aldiwan.net/poem56387.html","الوافر"],[347,"أقبل صبحي وسفر","https://www.aldiwan.net/poem15721.html","مجزوء الرجز"],[364,"افترى في عذله كذبا","https://www.aldiwan.net/poem16928.html","المديد"],[364,"حيث ماء الشباب في وجنتيها","https://www.aldiwan.net/poem16937.html","الخفيف"],[369,"من رسولي إلى أبي الحسن الشيخ","https://www.aldiwan.net/poem57194.html","الطويل"],[388,"عجبا للزمان مع أهليه","https://www.aldiwan.net/poem54451.html","عموديه"],[400,"كم أقاسي في الهوى من شغل","https://www.aldiwan.net/poem33482.html","الرمل"],[400,"وعلى نظم وقفنا رائق","https://www.aldiwan.net/poem33596.html","الرمل"],[400,"وصديق لي صدوق","https://www.aldiwan.net/poem33661.html","مجزوء الرمل"],[413,"من لصب مستطار القلب هائم","https://www.aldiwan.net/poem53954.html","الرمل"],[413,"أترى في الوجود مثلك عالم","https://www.aldiwan.net/poem54119.html","الخفيف"],[429,"قال موسى إن فكري ديمة","https://www.aldiwan.net/poem12615.html","الرمل"],[441,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[536,"قال ما للسواد لبسك أضحى","https://www.aldiwan.net/poem48244.html","عموديه"],[556,"قل لعباد الخيال","https://www.aldiwan.net/poem34200.html","مجزوء الرمل"],[557,"غير ليلي لم يرى في الحي حي","https://www.aldiwan.net/poem69333.html","الرمل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["قال مَنْ يُعْنى بأمْري","لَيْتَ رَبّي قد أراحَكْ",0,"ك",1,1],["قال مستنكراً لما نحن فيه","ما بهذا قد جاءني جبريل",1,"ل",1,0],["قال من خدّيَ خذها","قلت بل من فيك أحلى",2,"ل",2,0],["قال ماذا نقِمتَ قلت له قوْ","لَك ماذا نِقمت سوءَ الحسابِ",3,"ب",1,0],["قال منه القفا وقد خافَ لطماً","رَبِّ سلِّم من الأكُفِّ الغواشي",4,"ي",1,0],["قال ما لي متى حَبِلتِ فقالت","لك لطمٌ أخفُّهُ التتريك",5,"ك",1,0],["قال ما هذا فقالتْ","في حرِي بعضُ المرمَّهْ",6,"م",2,0],["قالَ مالُكُمُ ما خَطبُكُم","أَيُّ كِنزٍ في الثَرى ىَو جَوهَرَه",7,"ر",2,0],["قالَ ما أَجمَلَ الكَواكِبَ ما","أَحلى سَناها فَقُلتُ ما أَحلاها",8,"ا",3,0],["قالَ ما تَرجَعُ عَنّي قُلتُ لا","قالَ ما تَطلُبُ مِنّي قُلتُ شَيَّ",9,"ي",1,0],["قال ما قبّلت رج","ليه ولكن أذنيه",10,"ي",2,0],["قال ما قال .. فالقميص جحيم","فوق صدري، والثوب يقطر نشوة",11,"و",2,0],["قالَ مَه لا تَعصِني قُلتُ مَهلا","لَستُ أَخشى مَع هَواهُ اِفتِضاحا",12,"ح",2,0],["قالَ ما كانَ أَصلُ دائِكَ هَذا","قُلتُ طَرفي وَذاكَ حالٌ شَديدُ",13,"د",1,0],["قالَ ما تطلبُ قل لي","قلتُ مِنْ ذي العرشِ حفْظَكْ",14,"ك",1,1],["قالَ ما أرشقَ قدي","قلتُ ما أرشقَ لَحْظَكْ",14,"ك",1,0],["قالَ مركوبيَ نحسٌ","قلتُ والراكبُ أيضاً",15,"ض",2,0],["قالَ مَهلاً فَلا تَظُنَّنَّ هَذا","عَمرَكَ اللَهُ ما قَتَلناهُ عِلما",16,"م",2,0],["قال مَولاهم هَلُمُّوا فاهْدِمُوا","مَسجدَ السُّوءِ جِدَاراً فَجِدارا",17,"ر",2,0],["قال ما عندَكم أما قال عِيسَى","سوفَ يأتي مِن بعدهِ من يلينا",18,"ن",2,0],["قال ما شئتِ هلمِّي فافعلي","لكِ يا صاحبتي ما تُؤثِرينْ",19,"ن",1,0],["قال ما في البلاد أكرمُ من مك","كةَ أرضاً ولا أحبُّ عشيرا",20,"ر",2,0],["قال ما يَنبغِي لمثلِ رَسولَ ال","لَهِ أن يَأَلُوَ البلادَ ظُهورا",20,"ر",2,0],["قالَ ما يَخفى عَلَيهِ","ذاكَ إِن كانَ ظَريفا",21,"ف",2,0],["قالَ مَنِ الخاطِبونَ قُلتُ لَهُ","فِتيانُ صِدقٍ فَقالَ أَكفاها",22,"ا",3,0],["قال من أنتَ وهو ينظر شزراً","قلت شيخٌ في لحده مقبورُ",23,"ر",1,0],["قال ماذا أتيتَ إذ كنت حياً","قلت كل الذي أتيت حقيرُ",23,"ر",1,0],["قال ما دينك الذي كنت في الدن","يا عليه وأنت شيخٌ كبيرُ",23,"ر",1,0],["قال من ذا الذي عبدت فقلت ال","لَهَ ربي وهو السميع البصيرُ",23,"ر",1,0],["قال مذا كانت حياتك قبلاً","يوم أنت الحر الطليق الغريرُ",23,"ر",1,0],["قال ماذا تقول في الحشر والمي","زان ثم الحساب وهو عسير",23,"ر",1,0],["قال ماذا رأيت في الجن قبلاً","ومن الجن صالح وشرير",23,"ر",1,0],["قال ماذا هو الإله فهل أن","ت مجيبي كما يجيب الخبير",23,"ر",1,0],["قال ما ذاته فقلت مجيباً","بلسانٍ قد خانه التفكير",23,"ر",1,0],["قال ما أنت أيها الرجسُ إلا","ملحدٌ قد ضلَّ السبيلَ كفور",23,"ر",1,0],["قال من بعد شرحه منشأ النا","ر وفي قوله إليها يشير",23,"ر",1,0],["قال ما أصبرَ الحقولَ على الناسِ","فقالتْ ومثلُهنَّ القلوب",24,"ب",1,0],["قَالَ مَهْلاً، وَانْظُرْ هُنَاكَ، فَأَبْصَرْ","تُ بَعِيدًا حَقْلاً مِنَ الأَلْغَامِ",25,"م",1,0],["قالَ ما أمّلتَ حتّى تغنَما","ومَتى تمّت أماني مفلسِ",26,"س",1,0],["قال من كانَ في الجمالِ وحيداً","لا يبالي بكثرةِ العشاق",27,"ق",1,0],["قالَ ما حَلَّ بِاللَيالي الخَوالي","كَيفَ عائَت بِها يَدُ الجَلّادِ",28,"د",1,0],["قالَ ماذا جزا البشارة فيه","قلت ما لي في حيّز الإمكانِ",29,"ن",1,0],["قالَ ماذا وجدتَ منها سروراً","قُلت بردَ الشرابِ للظمآنِ",29,"ن",1,0],["قالَ مَتى هَمَّت بِهِ","قُلتُ وَالأَكوانُ ذَر",30,"ر",1,0],["قالَ مَحجوبٌ فَقُلتُ لَهُ","رُبَّ بَختٍ يَخرِقُ الحُجُبا",31,"ب",2,0],["قالَ مَن لا أُحِبُّ ما لا أُحِبُّ","وَحَديثُ البَغيضِ بُغضٌ وَكِذبُ",32,"ب",1,0],["قالَ مالي حالٌ وهَذا الذي تَس","أَلُ عَنه جَوابُه في الحالِ",33,"ل",1,0],["قال من يسمعون قد قال صدقا","هذه عادة لمه تؤذيه",34,"ي",2,0],["قال من قلت له شمس الضحى","وعلى بن الحسين بن علي",35,"ل",2,0],["قال ما المذهب في قولكُمُ","عن عرى المذهب لا ينفصل",36,"ل",1,0],["قال ما تشكو أَبِنْ لي","قلت سبعين وسبعا",37,"ع",2,0],["قالَ من أبْصَرَهُ مستبشراً","هكذا فلْتَكُ أبناءُ الأَكارم",38,"م",1,0],["قال منهم للمكرمات قؤول","هكذا هكذا تكون المكارم",39,"م",1,0],["قال موسى إنّ فكري ديمةٌ","وقَريضي كلُّهُ روضٌ نَضِرْ",40,"ر",1,1],["قال ما هذا أدر أم ذهب","أم لأل نثرت فوق عروش",41,"ش",1,0],["قال من فيه بقل فهو بخيت","ثم قاد للطرف يأتم المقيل",41,"ل",1,0],["قالَ ما للسَّوادِ لُبُسك أضحَى","وَهوَ ما كان لُبسَكَ المُعتَادا",42,"د",2,1],["قال مع إنكاره ما","قلته يبغي جدالي",43,"ي",1,0],["قال مَن أشهدَ معنى حُسنها","إِنه منتشرُ والكل طيْ",44,"ي",1,0],["قال مقالا شنعا فتابعه","من اقتدى برأيه وشايعه",45,"ه",1,0]]}