4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81938","السريع"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28631","الخفيف"],[4691,"السيد المقيم 2","https://www.poetsgate.com/ViewPoem.aspx?id=175081",""],[4728,"قال مشتاق لقصيدك","https://www.poetsgate.com/ViewPoem.aspx?id=179712",""],[4757,"قَالَ محبوبي بقدي","https://www.poetsgate.com/ViewPoem.aspx?id=189299",""],[4830,"يالِقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=213988",""],[4984,"لا تلم حظك..","https://www.poetsgate.com/ViewPoem.aspx?id=175536",""],[3591,"يعبس الدهر ثم يبسم حيناً","https://www.poetsgate.com/ViewPoem.aspx?id=149406",""],[5121,"فرفوري","https://www.poetsgate.com/ViewPoem.aspx?id=37467",""],[5121,"شَاعِرُ الدُّنْيَا","https://www.poetsgate.com/ViewPoem.aspx?id=212038",""],[5183,"قسوة الأم غصه","https://www.poetsgate.com/ViewPoem.aspx?id=186495",""],[5183,"قال","https://www.poetsgate.com/ViewPoem.aspx?id=186485",""],[5213,"ان دين الله أضحى باكيا","https://www.poetsgate.com/ViewPoem.aspx?id=170395",""],[5219,"حرف ذو شجون","https://www.poetsgate.com/ViewPoem.aspx?id=194086",""],[5232,"سهرة مع الأخطل الصغير","https://www.poetsgate.com/ViewPoem.aspx?id=212497",""],[5302,"فؤاد شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=200489",""],[5409,"أقسمت بالشرف الغا","https://www.poetsgate.com/ViewPoem.aspx?id=155364",""],[5431,"سادن الحب","https://www.poetsgate.com/ViewPoem.aspx?id=209045",""],[5433,"ليل الهجاد","https://www.poetsgate.com/ViewPoem.aspx?id=36841",""],[5434,"الشاور غشاني","https://www.poetsgate.com/ViewPoem.aspx?id=37612",""],[5463,"خل من راح يرحل بكره شوقه يجيبه","https://www.poetsgate.com/ViewPoem.aspx?id=27213",""],[5525,"وسيم الناس","https://www.poetsgate.com/ViewPoem.aspx?id=7253",""],[5573,"ساقه الله فوق ساقه والقدم","https://www.poetsgate.com/ViewPoem.aspx?id=200221",""],[5763,"ِ شجيٌّ وخليٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=27066",""],[5776,"الحكيمُ الرابع","https://www.poetsgate.com/ViewPoem.aspx?id=199327",""],[5818,"يحمل الأشواق والحبّ الثقيلا","https://www.poetsgate.com/ViewPoem.aspx?id=199621",""],[5866,"قال من لا يعجزه نظم الحروف الابجدية","https://www.poetsgate.com/ViewPoem.aspx?id=182872",""],[5939,"واقفٌ في يَدي الزهورُ","https://www.poetsgate.com/ViewPoem.aspx?id=178612",""],[5984,"ان عثمان الكدود بن رشد","https://www.poetsgate.com/ViewPoem.aspx?id=200378",""],[6056,"نار الهجر","https://www.poetsgate.com/ViewPoem.aspx?id=156700",""],[6093,"جنِّبِ القولَ منكَ (لا ) ( مجزوء الخفيف)","https://www.poetsgate.com/ViewPoem.aspx?id=181654",""],[6225,"العروبة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80915&r=&rc=184",""]],"verses":[["قال مَنْ يُعْنى بأمْري","لَيْتَ رَبّي قد أراحَكْ",0,"ك",1,1],["قال مستنكراً لما نحن فيه","ما بهذا قد جاءني جبريل",1,"ل",1,0],["قال من خدّيَ خذها","قلت بل من فيك أحلى",2,"ل",2,0],["قال ماذا نقِمتَ قلت له قوْ","لَك ماذا نِقمت سوءَ الحسابِ",3,"ب",1,0],["قال منه القفا وقد خافَ لطماً","رَبِّ سلِّم من الأكُفِّ الغواشي",4,"ش",2,0],["قال ما لي متى حَبِلتِ فقالت","لك لطمٌ أخفُّهُ التتريك",5,"ك",1,0],["قال ما هذا فقالتْ","في حرِي بعضُ المرمَّهْ",6,"م",2,0],["قالَ مالُكُمُ ما خَطبُكُم","أَيُّ كِنزٍ في الثَرى ىَو جَوهَرَه",7,"ر",2,0],["قالَ ما أَجمَلَ الكَواكِبَ ما","أَحلى سَناها فَقُلتُ ما أَحلاها",8,"ا",3,0],["قالَ ما تَرجَعُ عَنّي قُلتُ لا","قالَ ما تَطلُبُ مِنّي قُلتُ شَيَّ",9,"ي",1,0],["قال ما قبّلت رج","ليه ولكن أذنيه",10,"ي",2,0],["قال ما قال .. فالقميص جحيم","فوق صدري، والثوب يقطر نشوة",11,"و",2,0],["قالَ مَه لا تَعصِني قُلتُ مَهلا","لَستُ أَخشى مَع هَواهُ اِفتِضاحا",12,"ح",2,0],["قالَ ما كانَ أَصلُ دائِكَ هَذا","قُلتُ طَرفي وَذاكَ حالٌ شَديدُ",13,"د",1,0],["قالَ ما تطلبُ قل لي","قلتُ مِنْ ذي العرشِ حفْظَكْ",14,"ك",1,1],["قالَ ما أرشقَ قدي","قلتُ ما أرشقَ لَحْظَكْ",14,"ك",1,0],["قالَ مركوبيَ نحسٌ","قلتُ والراكبُ أيضاً",15,"ض",2,0],["قالَ مَهلاً فَلا تَظُنَّنَّ هَذا","عَمرَكَ اللَهُ ما قَتَلناهُ عِلما",16,"م",2,0],["قال مَولاهم هَلُمُّوا فاهْدِمُوا","مَسجدَ السُّوءِ جِدَاراً فَجِدارا",17,"ر",2,0],["قال ما عندَكم أما قال عِيسَى","سوفَ يأتي مِن بعدهِ من يلينا",18,"ن",2,0],["قال ما شئتِ هلمِّي فافعلي","لكِ يا صاحبتي ما تُؤثِرينْ",19,"ن",1,0],["قال ما في البلاد أكرمُ من مك","كةَ أرضاً ولا أحبُّ عشيرا",20,"ر",2,0],["قال ما يَنبغِي لمثلِ رَسولَ ال","لَهِ أن يَأَلُوَ البلادَ ظُهورا",20,"ر",2,0],["قالَ ما يَخفى عَلَيهِ","ذاكَ إِن كانَ ظَريفا",21,"ف",2,0],["قالَ مَنِ الخاطِبونَ قُلتُ لَهُ","فِتيانُ صِدقٍ فَقالَ أَكفاها",22,"ا",3,0],["قال من أنتَ وهو ينظر شزراً","قلت شيخٌ في لحده مقبورُ",23,"ر",1,0],["قال ماذا أتيتَ إذ كنت حياً","قلت كل الذي أتيت حقيرُ",23,"ر",1,0],["قال ما دينك الذي كنت في الدن","يا عليه وأنت شيخٌ كبيرُ",23,"ر",1,0],["قال من ذا الذي عبدت فقلت ال","لَهَ ربي وهو السميع البصيرُ",23,"ر",1,0],["قال مذا كانت حياتك قبلاً","يوم أنت الحر الطليق الغريرُ",23,"ر",1,0],["قال ماذا تقول في الحشر والمي","زان ثم الحساب وهو عسير",23,"ر",1,0],["قال ماذا رأيت في الجن قبلاً","ومن الجن صالح وشرير",23,"ر",1,0],["قال ماذا هو الإله فهل أن","ت مجيبي كما يجيب الخبير",23,"ر",1,0],["قال ما ذاته فقلت مجيباً","بلسانٍ قد خانه التفكير",23,"ر",1,0],["قال ما أنت أيها الرجسُ إلا","ملحدٌ قد ضلَّ السبيلَ كفور",23,"ر",1,0],["قال من بعد شرحه منشأ النا","ر وفي قوله إليها يشير",23,"ر",1,0],["قال من الوجود أقوى من الأخطا","ر ؟ قالت : من يركب الأخطارا !",24,"ر",2,0],["قال ما أصبرَ الحقولَ على الناسِ","فقالتْ ومثلُهنَّ القلوب",25,"ب",1,0],["قال ما لكم ؟ ... ما خطبكم","أيّ كنز في الثرى أو جوهره ؟",26,"ر",2,0],["قَالَ مَهْلاً، وَانْظُرْ هُنَاكَ، فَأَبْصَرْ","تُ بَعِيدًا حَقْلاً مِنَ الأَلْغَامِ",27,"م",1,0],["قالَ ما أمّلتَ حتّى تغنَما","ومَتى تمّت أماني مفلسِ",28,"س",1,0],["قال من كانَ في الجمالِ وحيداً","لا يبالي بكثرةِ العشاق",29,"ق",1,0],["قالَ ما حَلَّ بِاللَيالي الخَوالي","كَيفَ عائَت بِها يَدُ الجَلّادِ",30,"د",1,0],["قالَ ماذا جزا البشارة فيه","قلت ما لي في حيّز الإمكانِ",31,"ن",1,0],["قالَ ماذا وجدتَ منها سروراً","قُلت بردَ الشرابِ للظمآنِ",31,"ن",1,0],["قالَ مَتى هَمَّت بِهِ","قُلتُ وَالأَكوانُ ذَر",32,"ر",1,0],["قالَ مَحجوبٌ فَقُلتُ لَهُ","رُبَّ بَختٍ يَخرِقُ الحُجُبا",33,"ب",2,0],["قالَ مَن لا أُحِبُّ ما لا أُحِبُّ","وَحَديثُ البَغيضِ بُغضٌ وَكِذبُ",34,"ب",1,0],["قالَ مالي حالٌ وهَذا الذي تَس","أَلُ عَنه جَوابُه في الحالِ",35,"ل",1,0],["قال من يسمعون قد قال صدقا","هذه عادة لمه تؤذيه",36,"ي",2,0],["قال من قلت له شمس الضحى","وعلى بن الحسين بن علي",37,"ل",2,0],["قال ما المذهب في قولكُمُ","عن عرى المذهب لا ينفصل",38,"ل",1,0],["قال ما تشكو أَبِنْ لي","قلت سبعين وسبعا",39,"ع",2,0],["قالَ من أبْصَرَهُ مستبشراً","هكذا فلْتَكُ أبناءُ الأَكارم",40,"م",1,0],["قال منهم للمكرمات قؤول","هكذا هكذا تكون المكارم",41,"م",1,0],["قال موسى إنّ فكري ديمةٌ","وقَريضي كلُّهُ روضٌ نَضِرْ",42,"ر",1,1],["قال ما هذا أدر أم ذهب","أم لأل نثرت فوق عروش",43,"ش",1,0],["قال من فيه بقل فهو بخيت","ثم قاد للطرف يأتم المقيل",43,"ل",1,0],["قالَ ما للسَّوادِ لُبُسك أضحَى","وَهوَ ما كان لُبسَكَ المُعتَادا",44,"د",2,1],["قال مع إنكاره ما","قلته يبغي جدالي",45,"ل",2,0],["قال مَن أشهدَ معنى حُسنها","إِنه منتشرُ والكل طيْ",46,"ي",1,0],["قال مقالا شنعا فتابعه","من اقتدى برأيه وشايعه",47,"ه",1,0],["قالَ ما قالَ ثُمَّ راغَ سَريعاً","أَدرَكَت نَفسَهُ المَنايا السِراعُ",48,"ع",1,0],["قال ما يمنع الشقي أما حان","شقاه يا رب عجل شقاه",49,"ا",2,0],["قال منْ أجل ذاكَ طار لي اسم","وألح الضيوف في غشياني",50,"ن",2,0],["قال من يستقى براوية قد","أصبحت مثل طليسان ابن حرب",51,"ب",1,0],["قالَ من لم يَنِكْ يُنَكْ قلتُ دع ذا","عنك هذا ضربٌ من التحريش",52,"ش",1,0],["قالَ ما هاتانِ أَومَأتُ لَهُ","هَذِهِ عَيني وَهَذي أُختُها",53,"ه",2,0],["قالَ ما السَبع إِنَّما هُوَ قِطٌّ","حكمه سائر عَلى الفيران",54,"ن",1,0],["قال مهلاً قلت سمعاً يا خليل","قد صفا الوقت وقد غاب الرقيب",55,"ب",1,0],["قال مُذ أقبل تيمور على","مسقط لم يبق بؤس وترحْ",56,"ح",1,0],["قالَ من هو قلتُ فلاح هو ال","غيثُ في الجود كالغيثِ إن هطلا",57,"ل",2,0],["قال ما راعني الفراق ولكن","قلت إني بما أطّباك خبير",58,"ر",1,0],["قال منكم فوق ما كان يروم","مذرآنا الرجس في ذل السباء",59,"ا",2,0],["قال منشا يوماً لسعدانه","وهي سحور العينين فتانه",60,"ن",2,1],["قالَ ما في سوالفِ الظغنِ سعدى","وتصابي الكبيرِ عينُ الضلالِ",61,"ل",1,0],["قال مَن تَعني وَقَد أَبرَزَ لي","مِن خبا البُرقعِ وَجهاً حَسَنا",62,"ن",2,0],["قال ما أنت وحدك اليوم باك","كل عين بدمعها مغمورة",63,"ر",2,0],["قال من أنت فقد أبرمتني","وتركت النّاس مثلي حائرة",64,"ه",1,0],["قال ماذا دهاك قلت حبيبي","لا تسلني وسل فؤادك عني",65,"ن",2,0],["قال ما تَعبدُونَ إلا خيالاً","قلَّدَتهُ وشاحَها الأَسماء",66,"ا",2,0],["قال ما بلهنَّ قطَّعن ايديه","نَّ من قبلُ أيها الوُزَراء",66,"ا",2,0],["قال ما معناه إذ قال ولو","بسط الرزق بغى فيها البشر",67,"ر",1,0],["قال منها صنوبرٌ في الشآم","مات ربي فادي جميع الأنام",68,"م",1,0],["قال من يشكو الى الله الامر","يا مفرّج همّ من قلبه صبور",69,"ر",1,1],["قال ما أظن في خَلَدي","أن تبيد هذه أبدّا",70,"د",2,0],["قال منهو بات ساهر ما رِقَدْ","والملا في النوم دَلْهينٍ رقود",71,"د",1,1],["قال من ذا الورود بع يا ضعيف","قلت للآن لم يبع ياسمين",72,"ن",1,0],["قالَ ما أَجرُ ذا هُديتِ فَقالَت","سَوفَ أُعطيكَ أَجرَهُ مَرَّتَينِ",73,"ن",1,0],["قال من أنت واشرأبَّ قليلاً","قلتُ سارٍ فقال مَن قلتُ سارِ",74,"ر",1,0],["قالَ ما تَبغِي فَقُلتُ قُبلَةً","تَشعَبُ القَلبَ الَّذي صارَ فِلَذ",75,"ذ",1,0],["قالَ مَوتٌ عاجِلٌ لِمُحِبٍّ","قُلتُ إِنّي راغِبٌ في الحِمام",76,"م",1,0],["قال محمد شهاب الدين","يستوهب الديان للمدين",77,"ن",1,1],["قال ما يغضب الجميع ويرضي","نفسه في حقيقة أو دين",78,"ن",1,0],["قال ما هذي وربي قُبَلٌ","إن هذي جمرات محرقات",79,"ت",1,0],["قال من أي علة أنت تشكو","قلت أشكو من علة الإفلاس",80,"س",1,0],["قال ما تستفيد من زهر خد","نلتَه في وجودك المفقود",81,"د",1,0],["قال ما ذقت قط جوعا لننسى","العشق إذ لا يعنيك الا الرغيف",82,"ف",1,0],["قال ما تحكم الطبيعة فينا","فهو عدل وحكمها لا يحيف",82,"ف",1,0],["قالَ مُغتاظاً وَفي أَلفاظِهِ","رَنّة الهزء أَنا ظلُّ القَدَر",83,"ر",1,0],["قال محتاراً أَنا الحُبّ الَّذي","لا يَنال العَيش إِلّا نائِلَه",83,"ه",1,0],["قالَ مُختالاً أَنا المَجد فَمَن","لَم يَنَلني ماتَ في عِلّتِهِ",83,"ه",1,0],["قالَ مُرتاباً أَنا السرّ الَّذي","يَتَهادى بَينَ رُوحٍ وَبَدَن",83,"ن",1,0],["قالَ مُلتاعاً كَفى تَسأَلني","مَن أَنا قلتُ أَفي السّؤل ملام",83,"م",1,0],["قالَ محجوباً أَنا أَنتَ فَلا","تَسأَلَنّ الأَرضَ عَنّي وَالسَّما",83,"م",2,0],["قال مستاهل لكل عقاب","وصدود وجفوة ومطالِ",84,"ل",1,0],["قال ما قالهُ وفرّ لفوره","يتوقّى تقرّبى",85,"ب",2,1],["قال مقدامهم هلم إلى الوا","لد نشكو مظالم الحكام",86,"م",1,0],["قالَ مني قُلتُ لَهُ","غَداً وَعينَّت الأَجل",87,"ل",1,0],["قالَ مخاطباً بني عقيل","حَسبُكُم مُسلِمُ من قتيل",88,"ل",1,0],["قال منها يُرتَجى الخير الكثير","فارتعوا في ظلّ هذي يا عبَاد",89,"د",1,0],["قال ماذا جَفا فؤادَك منها","قلتُ سهْمُ اللّحاظِ وهْوَ مُصيبُ",90,"ب",1,0],["قالَ ما رقّ منْكَ بعْدَ نَواها","قلتُ جسْمٌ وأدْمُعٌ ونَسيبُ",90,"ب",1,0],["قالَ محَمَّدٌ هُوَ ابنُ مالِك","أحمَدُ رَبِّى اللهَ خَيرَ مَالِكِ",91,"ك",1,1],["قال من أنت فقالت إنني","أخت ثيجين الأبيّ الشّمري",92,"ر",2,0],["قال من ريشي إذا الريش نما","ومن الوهم إذا جن الظلام",93,"م",1,0],["قال ما لليأس فيكم مأملُ","لا ولا يرجو مقاليد سقر",94,"ر",1,0],["قال: مه يا صاح أين ترى","كل ما استهولتَ وا عجبي",95,"ب",2,0],["قال مولانا نجيب النجبا","من لا خلاق البرايا جريا",96,"ا",1,1],["قال ما حيلتي فقال له ألزم","باب قصر الى غني جليل",97,"ل",1,0],["قال مِنِّي لكَ سَهمٌ قُلتُ كم","مَزَّقَ القلبَ فَرِفقاً بالمُعان",98,"ن",1,0],["قال ميدان جرى الحس","ن عليه فاستدارا",99,"ر",2,0],["قالَ مَتى همتَ بِهِ","قُلتُ مذ الأَكوانُ ذَر",100,"ر",1,0],["قالَ مِنْ أَحْمَدِ شَيءٍ في الهَوَى","عُقَبُ الصَّبْرِ وَتَأميلُ الخَلَفْ",101,"ف",1,0],["قال ما شئت فليكن وبهذا ال","حين نلوي عن الحروب الحرابا",102,"ب",2,0],["قالَ مُذ رامَ أن يُحدِّمَ هِيرا","ذَا مَنِيلابِرَبَّتَينِ تَحَجَّب",103,"ب",1,0],["قالَ مَهلاً وَحِلى النَومِ لَدَيه","أَيَّ رَبٍّ شِئتِ أَستَولي عَلَيه",104,"ه",1,0],["قال ما قال أياسٌ عالماً","قبل ذاك القول من كان قتل",104,"ل",1,0],["قالَ ما يُشجِيك يُولِيني الشَّجا","ِإنَّما المَوقِفُ أَضحى حَرِجا",105,"ج",2,0],["قال من أنت قال اني ضعيفٌ","مستجيرٌ بكم من الأَقوياءِ",106,"ا",2,0],["قال من هو أبوكَ قال هوَ اللي","ثُ بن يحيى بن أكرم الآباءِ",106,"ا",2,0],["قالَ من ذاكَ قال أني أنا ال","قاتلُ فاثأر واسفُك بعدلٍ دمائي",106,"ا",2,0],["قال ما الإنسانُ إلا","من على الغير يفوق",107,"ق",1,0],["قال من قال مثلك يا عمر ما يخلا","ما ترى ما ترى باهي المحيا تجلى",108,"ل",2,0],["قالَ ما أَطيبَ أَيامَ الصِّبا","قلتُ ما أَطيبَهُ لو ك