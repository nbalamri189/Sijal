,"ل",2,0],["دَنِفٌ لسيبُ حشىً سليبُ حُشاشةٍ","شَهِدَ السّهادُ بِشَفْعِه مِمْشاذا",149,"ذ",2,0],["دنا إليَّ بأيمان مغلظة","حتى إذا ما قَضى أَوطاره بانا",150,"ن",2,0],["دنيا تناقض ما تجيء بنفسها","كَم مأتم تلقى بها وَزَفاف",151,"ف",1,0],["دنوا فرقوها واحداً بعد واحد","وَقالوا وَجيزاً لَيسَ فيه فضول",152,"ل",1,0],["دَنَوتُم فَزادَ الشَوقُ عَمّا عَهِدتُه","وَزِدتُ لِقُربِ الدارِ كَرباً عَلى كَربِ",153,"ب",1,1],["دنَوت إلى باب الدُوَيرة مطرقاً","وأصغيت لا عن ريبة أتسمّع",154,"ع",1,0],["دنوتَ فقلنا رُؤى الحالمينَ","فلما بَعُدْتَ اتهمنا النظَرْ",155,"ر",1,0],["دنا الليلُ فهيا الآنَ يا ربَّةَ أحلامي","دعانا مَلَكُ الحبِّ إلى محرابه السامي",156,"ي",1,1],["دُنيا من الفِكرِ الطليقِ وعالمٌ","رَحْبُ الجوانبِ شاسعُ الآمادِ",157,"د",1,0],["دنيا من الوهمِ ودهرٌ تراهْ","يغَرِّرُ القلبَ بآمالهِ",158,"ه",1,0],["دنَتِ الدَّارُ يا سفينة إلَّا","شاطىءٌ حالتْ المنيةُ دونه",159,"ن",2,0],["دِنْتَ بالنُّبْلِ والوداعةِ قلباً","عجز البطش والأذى أن يُلينه",159,"ن",2,0],["دنياك غانية إذا عاهدتها","غدرت فكيف تروم حسن وفائها.",160,"ا",3,1],["دُنْياكَ تَحْدُو بالمُسا","فِرِ والمُقيمِ جِمالَها",161,"ل",3,1],["دنياهمو مسدودة المذاهب","ودورهم لواهب أو ناهب",162,"ب",1,0],["دَنَوْتُ إِلَيهِ على بُعْدِهِ","دُنُوَّ رَفِيقٍ دَرَى ما الْتَمَسْ",163,"س",1,0],["دَنَا ثُمَّ أَلْقَى النَّارَ بَيْنَ بُيُوتِهَا","فَطَارَتْ شَعَاعاً لا يَقِرُّ لَهَا رَحْلُ",164,"ل",1,0],["دَنَوْتُ أُفَدِّيهِ وَأَغْمِزُ كَفَّهُ","بِرِفْقٍ وَأَدْعُو بِاسْمِهِ وَهْوَ نَاعِسُ",165,"س",1,0],["دُنْيَا نَعِيمٍ لا بَقَاءَ لِحُسْنِهَا","وَنَعِيمُ دُنْيَا مَا لَهَا مِيثَاقُ",166,"ق",1,0],["دُنْيَا نَعِيمٍ تَكَادُ زَهْرَتُهَا","تَزْرِي عَلَى الشَّمْسِ وَهْيَ مُزْدَهِرَهْ",167,"ر",2,0],["دَنَا فَتَنَاوَلْنَا خَيَاشِيمَ مُزْنِهِ","قُعُوداً فَظَلَّتْ وَهْيَ بِالْمَاءِ تَرْعُفُ",168,"ف",1,0],["دَنَا وَالشَّمْسُ تَصْدِفُهُ","فمَا أَلْوَى وَمَا أَغْضَى",169,"ض",2,0],["دَنَا أَجَلِي فَيَا جَذَلِي","وَلَكِنْ أَنْتَ قَدْ تَبْقَى",170,"ق",2,0],["دُنْيَا تُخَالِفُ كُلَّ تَقْدِيرٍ","وَتَخْلِطُ فِي الحِسَابْ",171,"ب",1,0],["دنتُ لَهُ بِالوَفاءِ ثكلاً","ب