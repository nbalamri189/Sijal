/diwan/poem/43686","الوافر"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116977","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54235","الوافر"],[104,"دمع الخيل","https://www.poetsgate.com/ViewPoem.aspx?id=37377",""],[106,"ثغر لا يتبسم","https://www.poetsgate.com/ViewPoem.aspx?id=179422",""],[106,"موكب الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=179775",""],[77,"وفدت عقيلتك التي أهديتها","https://www.poetsgate.com/ViewPoem.aspx?id=34183",""],[50,"دَعِينِي يَا أَمِيرَة ُ منْ سِرَارِ","https://www.poetsgate.com/ViewPoem.aspx?id=22680",""],[50,"أ\"حارثَ\" علِّلني وإنْ كنتُ مسهَبا","https://www.poetsgate.com/ViewPoem.aspx?id=15957",""],[90,"يا فراتي","https://www.poetsgate.com/ViewPoem.aspx?id=178986",""],[54,"دنا رحيلي فهلْ في حاجتي نظرٌ","https://www.poetsgate.com/ViewPoem.aspx?id=14270",""],[45,"هَبِ الدّارَ رَدّتْ رَجْعَ ما أنتَ قائِلُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=32143",""],[80,"كَمُلَتْ ليَ الخمسونَ والخمسُ","https://www.poetsgate.com/ViewPoem.aspx?id=3324",""],[46,"دُنياكَ تُشبِهُ ناضِحاً مترَدداً،","https://www.poetsgate.com/ViewPoem.aspx?id=20123",""],[28,"فإن تفخر بنا فلرب قوم","https://www.poetsgate.com/ViewPoem.aspx?id=21747",""],[51,"سَمْعا أبا إسحق إنك ماجدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=30803",""],[44,"دنا سفرٌ والدر تنأى وتصقبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=15650&r=&rc=10",""],[105,"أقبل عليك من الشعوب سلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55093&r=&rc=263",""],[105,"هتف النعي فما ملكت بياني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55066&r=&rc=236",""],[96,"عدلي يكن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66356&r=&rc=32",""]],"verses":[["دَنا كَما اِعتَسَّ ذو طِمرَينِ لَمَّظَهُ","مِن فَضلَةِ الزادِ بِالبَيداءِ رُكبانُ",0,"ن",1,0],["دُنيا تَرَشَّفُ عَيشي وَهيَ كالحَةٌ","غَضبى وَأَبسِمُ فيها بادِيَ الكَظَمِ",1,"م",1,0],["دَنانيرُ تَلَمَّعُ مِن","مَواقِعِها دَباجِرُه",2,"ر",2,0],["دَنا طَرَبٌ وَالهَوى نازِحٌ","فَيا بُعدَ ذالَك وَيا قُربَ ذا",3,"ذ",2,0],["دَنا مِن أَعالي الرَقمَتَينِ وَما دَنا","وَصَدَّ وَقَد وَلَّى الظَلامُ وَما صَدّا",4,"د",2,0],["دُنيا تَضُرُّ وَلا تَسُرُّ وَذا الوَرى","كُلٌّ يُجاذِبُها وَكُلٌّ عاتِبُ",5,"ب",1,0],["دَنَتْ ونأَتْ إذْ أطْمَعَتْ ثمّ أيْأَسَتْ","وقد أحْزَنَ الرّاؤونَ فيها وأسْهَلوا",6,"ل",3,0],["دُنيا تُرَشِّحُ للرَّدى أبْناءَها","أُمٌّ لَعَمْرُ أبيهِمُ وَرْهاءُ",7,"ا",2,0],["دَنِفٌ تَناءَتْ بالأحبّةِ دارُهُ","حِقَباً ووجّهَ مَنْ يُحبُّ رَسولا",8,"ل",2,0],["دَنَا مَنْزِلاً مِنِّي وَشَطَّ مَزَارُهُ","فَأيْنَ لِقَلْبِي مِنْهُ بِالشَّاحِطِ الدَّانِي",9,"ي",1,0],["دُنْيَا خَدَعْتِ الَّذِي سَفَرْتِ لَهُ","عَنْ صَفْحَةِ لَمْ يَجُلْ بِهَا كَرَمُ",10,"م",1,1],["دُنْيَاكَ يَا هَذَا مَحلَّةُ نُقْلَةٍ","وَمُنَاخُ رَكْبٍ مَا لَدِيْهِ مَقَامُ",11,"م",1,0],["دُنيا لِزَهرَتِها شُعاعٌ مُذهَبٌ","لَو كانَ وَصفاً كانَ بَعضَ حُلاكا",12,"ك",2,0],["دُنُوَّكِ حَتّى يَذكُرَ الجاهِلُ الصِبا","وَدَفعُكِ أَسبابَ المُنى حينَ يَطمَعُ",13,"ع",1,0],["دُنْيَا يَعُودُ العَقْلُ فِي تَصْرِفِهَا","حَيْرَانَ بَيْنَ غَرِيمِهَا وَالغَانِمِ",14,"م",1,0],["دَنَا لِيُغِيثَهُ فَأَمَالَ رَأْساً","لَهُ عَنَتِ الْقَيَاصِرَةُ العِظَامُ",15,"م",1,0],["دَنا رَحيلي فَهَل في حاجَتي نَظَرٌ","أَم لا فَأَعلَمَ ما آتي وَما أَذَرُ",16,"ر",1,1],["دَنا البَينُ مِن مَيٍّ فَرُدَّت جِمالُها","فَهاجَ الهَوى تَقويضُها وَاِحتِمالُها",17,"ل",3,1],["دني هي تغبط وتحسد","والسروره فيه وال",18,"ل",1,0],["دنوت للخلق بالألطاف تمنحُها","والقلبُ في العالم العُلْويِّ ما بَرحَا",19,"ح",2,0],["دنّوت منها قليلاً وهي باكية","ومن بكاها بقلبي هاج بلبال",20,"ل",1,0],["دُنُوَّ عِتاقِ الخَيلِ لِلزَجرِ بَعدَما","شَمَسنَ وَوَلَّينَ الخُدودَ العَواصِيا",21,"ي",2,0],["دَنَوتَ مِنَ المَعَرَّةِ يا اِبنَ حُقرى","وَقَنَّعَكَ الفَرَزدَقُ ثَوبَ زاني",22,"ي",1,0],["دَنا ذاكَ الصَباحُ فَلَستُ أَدري","أَشَوقٌ كانَ مِنهُ أَم ضِرارُ",23,"ر",1,0],["دنت دارُه منِّي وشطَّ مزَارُهُ","فهل أبصرتْ عيناكَ ثغراً مفلَّجا",24,"ج",2,0],["دنت من صفات الفضل منك وإنها","لتفضل ما قالته طيُّ وبحترُ",25,"ر",1,0],["دنوت إليها وهو كالفرخ عاجز","فيا خجلي لما دنوت وإذلالي",26,"ي",1,1],["دنيا وأخرى كلّمت ذاته","فحبذا المبدأ والخاتمهْ",27,"م",2,0],["دنا رفدُه قيد الوريد وإنَّما","ترفَّع حتَّى خاطبَ النجم أسفلا",28,"ل",2,0],["دُنيا تُخادُعُني كَأَن","ني لَستُ أَعرِفُ حالَها",29,"ل",3,1],["دِنتَ بدينٍ من النذالة أد","دتْكَ إليه لطافةُ النظر",30,"ر",1,0],["دَنَّستَ يا ابن أبي أميةَ كُنيَةً","غَنِيتْ زماناً وهي غيرُ مُدَنَّسَهْ",31,"س",2,0],["دنيا علا شأن الوضيع بها","وهوى الشريف يحطه شرفُهْ",32,"ف",2,1],["دنيايَ ضيقٌ مذ سَخِطْتَ وَظُلْمَةٌ","والموتُ يتبَعُ ذاك أو تُحييني",33,"ن",2,0],["دَنا البَينُ مِن أَروى فَزالَت حُمولُها","لِتَشغَلَ أَروى عَن هَواها شُغولُها",34,"ل",3,1],["دَنِفٌ تُرَوِّعُهُ الغُصونُ إِذا اِنثَنَت","طَرَباً وَيُقلِقُهُ النَسيمُ إِذا جَرى",35,"ا",1,0],["دُنياكَ يا وَطَنَ العُروبَةِ غابَةٌ","حَشَدَت عَلَيكَ أَراقِما وَذِئابا",36,"ب",2,0],["دُنيا تَأَلَّقَ أَمسُها في يَومِها","فَاِستَجمَعَ الأَنساب وَالأَحسابا",36,"ب",2,0],["دُنيا مِنَ اللَذات وَالأَف","راحِ في دُنيا عَذاب",37,"ب",1,0],["دُنيا الوَرى ليلٌ وَصُبحٌ مُبين","وَلَيسَ في دُنياكِ إِلّا الضَباب",38,"ب",1,0],["دُنيا مُزَيَّفَةٌ وَدَهرٌ ماذِقٌ","ما في اِنفِلاتِكَ مِنهُما مِن باسِ",39,"س",1,0],["دُنياهُمُ دُنيايَ لَكِنَّما","أَعلامُهُم لَيسَت كَأَعلامي",40,"ي",1,0],["دنيا الى الاصلاح محتاجة","وأنت أنت المصلح الأكبر",41,"ر",1,0],["دنيا تطوف ذئابها بخرافها","وتعيث في تلك الخراف فسادا",42,"د",2,0],["دنياي لا ابرح صبا بها","فانما في ارضها غرسي",43,"ي",1,0],["دنيا كما تهوى النفوس جميلة","لو كان ذا ذوق بها الانسان",44,"ن",1,0],["دنيا جميلة قم خدها","سِتَّك وبالمعروف سيدها",45,"ه",2,0],["دنا فرأى فخَّر فكا","ن من قوسين مجثمه",46,"م",2,0],["دنياه دنيا الخاملي","ن ودينه دين الأصاغر",47,"ر",1,0],["دَنَت مِن أَبي الهَولِ مَشيَ الرَؤومِ","إِلى مُقعَدٍ هاجَ بَلبالَها",48,"ل",3,0],["دَنا مِنّي فَناوَلَني كِتاباً","أَحَسَّت راحَتايَ لَهُ جَلالا",49,"ل",2,0],["دَنَتِ الساعَةُ الَّتي أُنذِرَ النا","سُ وَحَلَّت أَشراطُها وَالعَلامَه",50,"م",2,0],["دُنياكَ مِن عاداتِها","أَلّا تَكونَ لِأَعزَلِ",51,"ل",1,0],["دَنانيرُ تُجزى بِالقَوافي كَأَنَّما","مُمَيِّزُها بِالقَسمِ عَدَّلَ أَو سَوّى",52,"و"