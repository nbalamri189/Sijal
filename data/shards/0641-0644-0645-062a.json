215.html","المتقارب"],[478,"أقفر من سكانه المعهد","https://www.aldiwan.net/poem15224.html","السريع"],[478,"ربع وقفت عليه بعد أهليه","https://www.aldiwan.net/poem15251.html","البسيط"],[480,"على ضفة الوادي بقتة شاهق","https://www.aldiwan.net/poem37574.html","الطويل"],[480,"أبى الله إلا أن تعظم مطلقا","https://www.aldiwan.net/poem37599.html","الطويل"],[487,"أرسم ديار بالستارين تعرفُ","https://www.aldiwan.net/poem482.html",""],[490,"خليلي عوجا فانظراني لعلني","https://www.aldiwan.net/poem403.html",""],[494,"وداية ترضع عبر درها","https://www.aldiwan.net/poem67294.html","عموديه"],[505,"هواك لا نوار الملامة ملمع","https://www.aldiwan.net/poem38404.html","الطويل"],[505,"أباهي بوجد قد تمكن في الحشا","https://www.aldiwan.net/poem38408.html","الطويل"],[514,"فإن تكن القلوب إذن تجازي","https://www.aldiwan.net/poem67693.html","الوافر"],[514,"يا مانعا مقلتي من لذة الوسن","https://www.aldiwan.net/poem67699.html","البسيط"],[515,"ما حركت سكنات الأعين النجل","https://www.aldiwan.net/poem20788.html","البسيط"],[515,"طلبت عظيم المجد بالهمة الكبرى","https://www.aldiwan.net/poem20833.html","الطويل"],[516,"لك المجد والفضل الذي ليس يجحد","https://www.aldiwan.net/poem12072.html","الطويل"],[516,"ولاؤك مفروض على كل مسلم","https://www.aldiwan.net/poem12246.html","الطويل"],[537,"صحا من سكره وسلا","https://www.aldiwan.net/poem23848.html","مجزوء الوافر"],[552,"قطعت بها يا دهر حبل وتيني","https://www.aldiwan.net/poem47164.html","الطويل"],[552,"كذا تكشف الغماء بعد ظلامها","https://www.aldiwan.net/poem47193.html","الطويل"],[552,"ومن سفه لما مررت على الحمى","https://www.aldiwan.net/poem47243.html","الطويل"],[552,"ألا ما لقلب بأيدي الغواة","https://www.aldiwan.net/poem47280.html","المتقارب"],[552,"لو كنت أملك للأقدار واقية","https://www.aldiwan.net/poem47362.html","البسيط"],[552,"تراءت لنا بالأبرقين بروق","https://www.aldiwan.net/poem47376.html","الطويل"],[552,"قصدت بيأسي منك إقذاء ناظري","https://www.aldiwan.net/poem47705.html","الطويل"],[552,"شبابك عني فالمشيب لباسي","https://www.aldiwan.net/poem47746.html","الطويل"],[552,"ما لي تطيح الدهر أخياري","https://www.aldiwan.net/poem47788.html","البسيط"],[552,"ما ضر طيفك لو والى زياراتي","https://www.aldiwan.net/poem48030.html","البسيط"],[552,"ولما التقينا والرقيب بنجوة","https://www.aldiwan.net/poem48108.html","الطويل"],[554,"تحملت هجر الشادن المتدلل","https://www.aldiwan.net/poem68417.html","الطويل"],[576,"هاجرني من هجره هجنه","https://www.aldiwan.net/poem2841.html","السريع"],[576,"أرى كل شيء في البسيطة قد نما","https://www.aldiwan.net/poem3021.html","الطويل"]],"verses":[["فلَمْ تَسألُوا عمّا تُجِنُّ نُفوسُنا","وتَمْنَعُنا مِنْ ذِكْرِهِ كِبْرياؤها",0,"ا",3,0],["فلمْ تَرْضَ إلا مَنْ يَحُلُّكَ مِنهُمُ","أظُنُّ أَديمَ الأرضِ بَعدَكَ عارِيا",1,"ي",2,0],["فَلَم تَزَل بِالرُقى حَتّى لَقَد تَرَكَت","ما بَينَنا مِثلَ حَربِ الثَورِ وَالأَسَدِ",2,"د",1,0],["فلمْ تبْقَ إلا مَنْ حمَتْها جُفونُها","أو الشّنَب المَعْسولُ والشّفَةُ اللّمْيا",3,"ي",2,0],["فلَمْ تَزْدَدْ برُتْبَتِها عُلُوّاً","ولمْ تزْدَدْ بنِعْمَتِها ارْتِفاقَا",4,"ق",2,0],["فَلَمْ تَخْشَ سَهْمَ الْقَوْسِ صَفْحَةُ بَدْرِهَا","وَلَمْ تَشْكُ فِيهَا الشَّمْسِ مِنْ نَحْسِ مِيزَانِ",5,"ن",1,0],["فَلمَ تَزَل كُلُّ غَنّاءِ البُغامِ بِهِ","مِنَ الظِباءِ تُراعي عاقِداً خَرِقا",6,"ق",2,0],["فَلَم تَستَبِق نَزوَةً في الصِبا","وَلَم تَستَبِح هَفوَةً في الكِبَر",7,"ر",1,0],["فَلَم تَرَ فيها عَلى طولِها","هُنَيهَةَ صَفوٍ خَلَت مِن كَدَر",7,"ر",1,0],["فَلَم تَثوِيا عَبدَ الحَليمِ بِحُفرَةٍ","وَلَكِن بِرَوضٍ مِن قَريضِكَ ناضِرِ",8,"ر",1,0],["فلم تَكَدْ تَسمَعُ الآياتِ بالِغةً","حتى انكَفَأْتَ تُناوي من يُناويها",9,"ي",3,0],["فَلَم تُخطِئِ المَرمى وَلا غَروَ أَن دَنَت","لَكَ الغايَةُ القُصوى فَإِنَّكَ مُلهَمُ",10,"م",1,0],["فَلَم تُبقِيا فَوقَ الجَزيرَةِ بائِساً","وَلَم تَترُكا في ساحَةِ البَيتِ مُعدِما",11,"م",2,0],["فَلَم تَكُ إِلّا مُدَّةٌ إِذ رَأَيتُهُ","وَعِزَّتُهُ قَد بُدِّلَت بِتَذَلُّلِ",12,"ل",1,0],["فَلَم تُطِق خيفَةَ الواشي تُوَدِّعُني","وَيحَ الوُشاةِ لَقَد لاموا وَقَد شَمَتوا",13,"ت",3,0],["فَلَم تُبدِ لي يأساً فَفي اليَأسِ راحَةٌ","وَلَم تُبدِ لي جوداً فَينفَعَ جودُها",14,"د",3,0],["فَلَمْ تُخْطِئْكِ فَهْماً وَاعْتِبَاراً","مَرَامِيهَا الجَلِيلَةِ وَالدَّقِيقَهْ",15,"ق",2,0],["فَلَمْ تَجِئْهُمْ عُلاهُمْ مِنْ شَوَامِخِهِمْ","وَلَمْ يَجِئْ خَفْضَنَا مِنْ خَفْضِ وَادِينَا",16,"ن",2,0],["فَلَم تَهبِط عَلى سَفوانَ حَتّى","طَرَحنَ سِخالَهُنَّ وَإِضنَ آلا",17,"ل",2,0],["فَلَم تَدَعِ البَوارِقَ بَطنَ عَرضٍ","رَغيبِ سَيلَهُ إِلّا مُسالا",17,"ل",2,0],["فَلَم تَبَق إِلاّ دِمنَةٌ هار نُؤيَها","وَجيفُ الحَصى بِالمُعِصفاتِ السَواهِكِ",18,"ك",1,0],["فلم تتّخذ غير التجارب منهجاً","لتحقيقها من جوهر العلم ما يجدي",19,"د",2,0],["فلم تَرَ غير الرفق فينا سجيّة","وإن كان بعض القوم أبدى لها عنُفا",20,"ف",2,0],["فَلَم تُدرِكوا بِالعَمِّ ثَأراً وَلَم يَكُن","لِيُدرَكَ ثَأرٌ بِالتَنابِلَةِ القُفدِ",21,"د",1,0],["فَلَم تُبقِ مِنهُم رايَةً يَرفَعونَها","وَلَم تُبقِ مِن آلِ المُهَلَّبِ عَسكَرا",22,"ر",2,0],["فَلَم تَرضَ ضَحلَ الماءِ حَتّى تَمَهَّرَت","وِشاحٌ لَها مِن عَرمَضٍ وَبَريمُ",23,"م",1,0],["فَلَم تَرَ إِلّا فالِقاً هامَ فَيلَقٍ","وَبَحراً لَهُ تَحتَ العَجاجَةِ ماخِرُ",24,"ر",1,0],["فَلَم تَرَ عُصبَةً في الناسِ أَنكى","لِمَن عادوا إِذا لَقِحَت كَشوفُ",25,"ف",1,0],["فلم تقم بكلال","ولم ترث عن كلاله",26,"ل",2,0],["فلم تزل قسينا الضَّواري","تصيبها بأعين النظَّارِ",27,"ر",1,0],["فلم تزل تسطو سطا الحجَّاج","على الكراكيّ أو الدرَّاج",27,"ج",1,0],["فلم تك حيلةٌ نرجو خلاصاً","بها إلا التضرُّعَ للمجيبِ",28,"ب",1,0],["فلم تَبْرُدِ العينانِ بالدَّمع حُرقةً","ولم تُطفئا حرَّ الهوى المتراكبِ",29,"ب",1,0],["فلم تُرِني الأيامُ خِلّاً يسرُّني","بَواديه إلا ساءني في العواقبِ",30,"ب",1,0],["فلم تزل بيَ حتى","إلى هواها ارعويتُ",31,"ت",1,0],["فلِمْ تعرَّضتَ لها طائعاً","ولِمْ تلطَّخْتَ ولم تُلْطَخِ",32,"خ",1,0],["فلم تَكُنْ راحَتي إلا مُلاحَظَتي","إيَّاكَ عن فكْر قلْب جدِّ مَجْهُودِ",33,"د",1,0],["فلم تزل عند كل مُظْلِمَةٍ","سوداء تَبْيَضُّ من يديك يدُ",34,"د",1,0],["فلمْ تصنعُوا الحُسنى ولمْ تفعلوا التي","أداوي بشكواها الحرارة في صدري",35,"ر",2,0],["فَلِمْ تجورُ عليه","وخدُّه لك أرض",36,"ض",1,0],["فلم تكالبت فيه","يا مشحذيّاً خُليقا",37,"ق",2,0],["فلم تسمحْ له بكَفافِ وجْهٍ","ولا شفَّعْتَ فيه أقْربيكا",38,"ك",2,0],["فَلَم تَزَل فَيلَقٌ خَضراءُ تَحطِمُهُم","تَنعى اِبنَ عَفّانَ حَتّى أَفرَخَ الصَيدُ",39,"د",1,0],["فَلَم تَنجُ إِلّا شَطبُةٌ بِلِجامِها","وَإِلّا طِمِرٌّ كَالقَناةِ نَجيبُ",40,"ب",1,0],["فَلَم تَتَناقَل صُنعَها أَلسُنُ الوَرى","وَلا قُرِعَت في الخافِقينَ طُبولُ",41,"ل",1,0],["فَلَم تُخَمِّشُني بِأَوراقِها","وَلَم تُهَلِّل لي سَواقيها",42,"ي",3,0],["فَلَم تَأمَنِ الأَسرارُ في السِلكِ سارِقاً","وَلَم تَأمَنِ الأَخبارُ في الطِرسِ ماحِيا",43,"ي",2,0],["فَلَم تَمنَعوا جاراً وَلَم تَنفَعوا أَخاً","وَلَم تَدفَعوا ضَيماً وَلَم تَرفَعوا راسا",44,"س",2,0],["فَلَم تُطِق خيفَةَ الواشي تُوَدِّعُني","وَيحَ الوُشاةِ لَقَد قالوا وَقَد شَمِتوا",45,"ت",3,0],["فَلَم تَكُ إِلّا نَبأَةً ثُمَّ هَوَّمَت","فَقُلنا قَطاةٌ ريعَ أَم رِيَعَ أَجدَلُ",46,"ل",1,0],["فلم تَتَكَلَّمْ شِفاهُ الظَّلامِ ولمْ","تترنَّمْ عَذارَى السَّحَرْ",47,"ر",1,0],["فَلَمْ تَرتشفْ من رُضابِ الحياة","ولم تصطَبحْ من رَحيق الوجودْ",48,"د",1,0],["فلم تر مصر أصدق من أمين","ولا أفوى إذا ريعت دفاعا",49,"ع",2,0],["فلم تخش بالأمس رب اللواء","ولا هِبت رب القوافي خليلا",50,"ل",2,0],["فَلَم تَنَل أَبا يَزيدٍ خَيلُهُ","وَلا قَنا لَهُ الكَنانَةَ القَنا",51,"ا",1,0],["فَلم تفُلَّ النائِباتُ عَزمَه","وَلَم يَكِلّ عَن لِقاءِ الأَزَمَه",52,"ه",1,0],["فَلَم تَبرِحِ القَصرَ إِلّا شَفيتَ","جُدوبَ العُقولِ وَإِمحالَها",53,"ل",3,0],["فَلَم تَلقَ اِبنَ إِبراهيمَ عَنسي","وَفيها قوتُ يَومٍ لِلقُرادِ",54,"د",1,0],["فَلَم تَدَع مِنها سِوى المُحالِ","في لا مَكانٍ عِندَ لا مَنالِ",55,"ل",1,0],["فَلَم تُتِمَّ سَروجٌ فَتحَ ناظِرِها","إِلّا وَجَيشُكَ في جَفنَيهِ مُزدَحِمُ",56,"م",1,0],["فَلَم تَرَ عَيني نِعمَتَينِ اِستَحَقَّتا","ثَناءَهُما في اِبنى مَعَدٍّ وَيَعرُبِ",57,"ب",1,0],["فَلَم تَخلُ مِن فَضلٍ يُبَلِّغُكَ الَّتي","تَرومُ وَمِن رَأيٍ يُريكَ المُغَيَّبا",58,"ب",2,0],["فَلَم تَبقَ إِلّا سَطوَةٌ مِن مُطالِبٍ","بِأَضغانِهِ أَو نِعمَةٌ مِن مُسامِحِ",59,"ح",1,0],["فَلَم تَكُ نِيَّتي عَنكَ اِختِياراً","وَكانَ اللَهُ أَولى بِالعَبيدِ",60,"د",1,0],["فَلَم تَسعَ فيها إِذ سَعَيتَ مُثَبِّطاً","وَلَم تَرمِ عَنها إِذ رَمَيتَ مُقَصِّرا",61,"ر",2,0],["فَلَم تَرَ إِلّا مُخبِراً عَن صَبابَةٍ","بِشَكوى وَإِلّا عَبرَةً تَتَرَقرَقُ",62,"ق",1,0],["فَلَم تَدَّعوا قِرياضَ فيها إِذا دَعَت","عَلى غَضَبٍ مِنها تَنوخٌ بَواصِلِ",63,"ل",1,0],["فَلَم تَرَ عَيني كَاِقتِضاءِ بَناتِهِم","لَوِترٍ لَدَينا أَو طِلابِ الطَوائِلِ",64,"ل",1,0],["فَلَم تَستَطِع دَفعَ المَنونِ حُماتُهُ","وَلَم تَستَطِع دَفعَ الحِمامِ تَمائِمُه",65,"م",2,0],["فَلَم تَكُن كَبنِ حُجرٍ حينَ ثارَ وَلا","أَخي كُلَيبٍ وَلا سَيفِ بنِ ذي يَزَنِ",66,"ن",1,0],["فَلَم تَرَ مِثلي ذائِداً عَن عَشيرَةٍ","وَلا ناصِراً مِنهُم أَعَزَّ وَأَكثَرا",67,"ر",2,0],["فَلَم تَطلُبِ السُقيا بِمِثلِ جُعالَةٍ","وَمُطلَنفِئٍ ضَخمٍ مُعَرّاهُ لازِقِ",68,"ق",1,0],["فَلَم تَدَعِ الأَيّامُ فَاِستَمِعا الَّتي","تُصَمُّ وَتُعمي بِالكِبارِ الخَواطِمِ",69,"م",1,0],["فلم تَدْنُ من شقِّ الجيوبِ ولم تَغِضْ","مَعَ الشَّربِ أسرابُ الدُّموعِ الهَوَامِلِ",70,"ل",1,0],["فلم تَبْعُدْ عليه له أَقاصٍ","ولم تَصعُبْ عليه له مَراقي",71,"ق",2,0],["فلم تُنسِني الأيَّامُ فيك وقد دَجَت","سَوالفَ أيامٍ مَضَتْ كالسَّوالفِ",72,"ف",1,0],["فلم تَزَلْ للفِراقِ غائِلَةٌ","تَلَذُّ في المَوْرِدِ الذي وَرَدا",73,"د",2,0],["فَلم تَدَعِ السُيوفُ لَنا عَدواً","وَلَم يَدَعِ السَخاءُ لَدَيَّ مالا",74,"ل",2,0],["فَلَم تُغنِ أَجنادُهُ حَولَهُ","وَلا المُسرِعونَ إِلى نَصرِهِ",75,"ر",2,0],["فَلَم تَقُل عَنكَ نَفسٌ في تَمَلمُلِها","ياجَنَّةَ الخُلدِ أَبدِلنا بِسِلسَلِها",76,"ه",2,0],["فَلَم تَلِدِ الدُنيا لَنا غَيرَ لَيلَةٍ","نَعِمتُ بِها ثُمَّ اِستَمَرَّت عَلى العُقمِ",77,"م",1,0],["فلم تَبقَ من أهل الضّلالِ بَقِيّةٌ","لقد عادتِ الأعراسُ فيهم مآتما",78,"م",2,0],["فَلَم تَرَ عَيْني مِثْلَهُمْ في كَتيبَةٍ","مضاربَ أبطالِ الحروبِ مَدَاعِسا",79,"س",2,0],["فَلَمْ تَرَ عَيني بَينها كَشَقائِقٍ","تُبَلبِلُها الأَرواحُ في القَضَبِ الخَضرِ",80,"ر",1,0],["فَلَم تَكرُمِ العَينانِ إِن لَم تُسامِحا","وَلا طابَ فَرعُ الشِعرِ إِن لَم يُساعِدِ",81,"د",1,0],["فَلَم تَرحَل كَناجِيَةِ المَهاري","وَلَم تُركَب هُمومَكَ كَالزَماعِ",82,"ع",1,0],["فَلَم تَنصَرِم إِلّا وَفي كُلِّ وَهدَةٍ","وَنَشزٍ لَها وادٍ مِنَ ا