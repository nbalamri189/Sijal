{"poems":[[74,"يوم صحو فاجعله لي يوم سكر","https://www.aldiwan.net/poem18694.html","الخفيف"],[72,"سلم الله على من","https://www.aldiwan.net/poem42705.html","مجزوء الرمل"],[58,"سمة الصبابة زفرة أو عبرة","https://www.aldiwan.net/poem58494.html","الكامل"],[68,"سفح المزاج على حميا الكاس","https://www.aldiwan.net/poem38490.html","الكامل"],[82,"أنكرت سقم مذاب الجسد","https://www.aldiwan.net/poem31487.html","الرمل"],[46,"وأبي المنازل إنها لشجون","https://www.aldiwan.net/poem30334.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39579","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141964","الطويل"],[92,"الريف الضاحك","https://www.poetsgate.com/ViewPoem.aspx?id=179018",""],[119,"رب دار بالغضا طال بلاها","https://www.aldiwan.net/poem40433.html","عموديه"],[303,"ما له في عظم الشأن قري","https://www.aldiwan.net/poem36860.html","عموديه"],[358,"ما للمتيم حائما حول الحمى","https://www.aldiwan.net/poem39959.html","الكامل"],[358,"ما ترى البدر حين حاز كماله","https://www.aldiwan.net/poem40002.html","الخفيف"],[382,"هذا التواضع إن أردت مواهبا","https://www.aldiwan.net/poem66936.html","الكامل"],[469,"طرقت ريح الصبا ميثاء وهنا","https://www.aldiwan.net/poem3594.html","عموديه"],[543,"أينما كنت كنت رمز الكمال","https://www.aldiwan.net/poem47986.html","عموديه"],[567,"أعرفت رسم الدار أم لم تعرف","https://www.aldiwan.net/poem52886.html","الكامل"],[580,"لا تسل عنه كيف أصبح حاله","https://www.aldiwan.net/poem3028.html","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38369","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120100","الرمل"],[1525,"","https://poetry.dctabudhabi.ae/diwan/poem/116111","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79812","الكامل"],[2003,"","https://poetry.dctabudhabi.ae/diwan/poem/136896","الرمل"],[2384,"","https://poetry.dctabudhabi.ae/diwan/poem/123655","الرمل"],[2583,"","https://poetry.dctabudhabi.ae/diwan/poem/128118","الرمل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100239","الكامل"],[3536,"","https://poetry.dctabudhabi.ae/diwan/poem/20615","الكامل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129380","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117860","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111487","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86373","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28721","الخفيف"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52147","الخفيف"],[4858,"إيهِ يا صاحِ","https://www.poetsgate.com/ViewPoem.aspx?id=138205",""],[4927,"ما هذه البنت","https://www.poetsgate.com/ViewPoem.aspx?id=29609",""],[5370,"مزاج","https://www.poetsgate.com/ViewPoem.aspx?id=85527",""],[5433,"سمها","https://www.poetsgate.com/ViewPoem.aspx?id=36233",""],[6102,"بَرزَخُ الأُمنِيات !!","https://www.poetsgate.com/ViewPoem.aspx?id=183167",""],[6102,"طيب","https://www.poetsgate.com/ViewPoem.aspx?id=184439",""]],"verses":[["سمه في الضمير إن ذُقت فقراً","وعليَّ الضمان أنك تثري",0,"ر",2,0],["سَمِّهِ إِن لُمتَني في","هِ يَطِب ذاكَ المَلامُ",1,"م",1,0],["سِمَةُ الصَّبَابَةِ زَفْرَةٌ أَوْ عَبْرَةٌ","مُتَكَفِّلٌ بهما حَشاً وشُؤون",2,"ن",1,1],["سُمها وَلا تَبخَل إِذا تَجلو بِها","خَوفاً مِنَ الإِقتارِ وَالإِفلاسِ",3,"س",1,0],["سَمهَريٌّ أَحرَقَتْ شُعْلَتُهُ","كُلَّ رُوحٍ في غَديرِ الزّرَدِ",4,"د",1,0],["سِمَةُ الصَبابَةِ زَفرَةٌ أَو عَبرَةٌ","مُتَكَفِّلٌ بِهِما حَشاً وَشُئونُ",5,"ن",1,0],["سِمَةُ الطائرِ المُعَذْ","ذَبِ في قيْدِهِ نقَرْ",6,"ر",1,0],["سمه الضفّةَ التي يعبرُ الأحياء","منها أو سمّ ذلك جسرا",7,"ر",2,0],["سمّه المصنعَ الذي يفعلُ التحليل","في جوفهش عجائبَ كبرى",7,"ر",2,0],["سمه المرقمَ العجيب الذي ما","انفكّ يمحو سطراً ويُثبشتُ سطرا",7,"ر",2,0],["سمّه المعوَلَ المطلسَمَ لا","يرجىء حفرا ولا يؤخّر طمرا",7,"ر",2,0],["سمه الهازىء العظيم إذا","راقك أو سمه إذا شئت قبرا",7,"ر",2,0],["سِمةٌ للشوقِ كانتْ سبباً","لسؤالِ الناسِ : مَنْ هذا النحيف؟",8,"ف",1,0],["سمة الحرباء فيها برزت","كلما احكمها ريب قواها",9,"ا",3,0],["سمةٌ ليس لها من غايةٍ","حسرتْ عنها عيونُ الناظرينْ",10,"ن",1,0],["سِمَةٌ بِها شَرَفُ الرُجولةِ لَم يَزَل","يَنمو كَما عِزُّ المَهابَةِ قَد نَما",11,"م",2,0],["سَمهريّ القوام يَطعن قَلبي","يا لَهُ طاعِناً سَما بِالعَداله",12,"ل",2,0],["سمةٌ لنا أن المسيح إلهنا","ولأجله ذقنا أسىً ومصائبا",13,"ب",2,0],["سمهريُّ القدِّ ما ثقّف ضماً","فلماذا لان أعطافاً ومتناً",14,"ن",2,0],["سَمِّه هيبةَ الأُسودِ خُصوصاً","بِقُلوبِ الجَحاجِح الأبطالِ",15,"ل",1,0],["سِمَةٌ تليقُ بهِ فنِعمَ المُصطَفى","منَّ الكريمُ بها فنِعمَ المُصطَفِي",16,"ف",2,0],["سمهريُّ أَما الرُّدَيْنيُّ تَثَنِّي","ه وأَمَّا عِناقُه فَاعْتِقَالُه",17,"ل",2,0],["سُمْها بِحُسنِ السَّومِ وَاِجبُر قَلبَها","لا تَبخَسَنْ أَشياءَها لا تبخَسِ",18,"س",1,0],["سمة الجود على صف","حة خدية تلوحُ",19,"ح",1,0],["سَمهَرِيٌّ يَنثني أم غصنُ بان","أم قَوام دونه صبري بَان",20,"ن",1,1],["سمةُ العبيدِ من الخشوع عليهم","لله إن ضمتهم الأَسحارُ",21,"ر",1,0],["سمة خالدة لا تمحي","في طلى الأيام دهر الداهرين",22,"ن",1,0],["سمة الظبي حوتها واسمه","فاحتواها الشبه منه واحتوش",23,"ش",1,0],["سمهريُّ القدِّ فضاح القنا","صدهُ قد علم الظبي النفار",24,"ر",1,0],["سمة لهم من قبل أعرفها","مذمومة يابئسما السمة",25,"ه",1,0],["سِمَةٌ لِذاكَ عَلَيَّ جِسمٌ شاحِبٌ","بادٍ تَحَسُّرُهُ وَلَونٌ أَسفَعُ",26,"ع",1,0],["سمة على شكل الثريا قارنت","قمراً بدا في ليل سعد مقمر",27,"ر",1,0],["سمةٌ وشنشنة وارث عنهم","والشبل يعرف مسرح الاساد",28,"د",1,0],["سِمةً بَغَى في جُنحِ ذَياكَ الدُّجى","لَهُما فلا تَخفَى بِهِ وَتُضَيَّعُ",29,"ع",1,0],["سمة الوقور إذا مشت تعتادها","لولا الصبا وتدلل المعشوق",30,"ق",1,0],["سِمَةُ العَجْزِ أَقعَدَتني عَنِ العَز","مِ وَقادَت بَعدَ الشِّماسِ عناني",31,"ن",2,0],["سمّها ما تشاء ليست كما أَعلم","إِلاّ مطامعَ الأسيادِ",32,"د",1,0],["سمِّهِ \" إسلامَ جرّارٍ \" فهل","هو في الفعل سوى ذاكَ الهصور",33,"ر",1,0],["سُمُّهَاْ بَلْسَمُ قَلْبٍ","رَاْغِبٍ فِيْ نَاْهِدَيْهَاْ",34,"ي",3,0],["سَمّه دلع،سمّه غرور وعوابه","سمّه مزاجٍ يعشق اللي يناحيه",35,"ي",2,1],["سمّه قساوة قلب، سمّه صلابه","سمّه لعانه... سمّه اللي تسمّيه",35,"ي",2,0],["سمها ذكرى مزوح اللي تسمي","انت ابو خضر الطعون وسمها",36,"م",3,1],["سِمَةُ الوَقتِ أَنَّهُ فِي زَوالٍ","وَ المَقادِيرُ فِي المَصِيرِ ثُبُوتُ",37,"ت",1,0],["سِمَةُ الغَدرِ لَمْ تَعُدْ تَتَخَفَّى","فَأَبُوها بِجُرأَةٍ صارَ بائِنْ !",38,"ن",1,0]]}