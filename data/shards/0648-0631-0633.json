{"poems":[[53,"من رأى أعينا حذفن","https://www.aldiwan.net/poem29625.html","مجزوء الخفيف"],[53,"ألا من يمطر السنة الجمادا","https://www.aldiwan.net/poem30602.html","الوافر"],[55,"من لي بمن أخشى الوشاة","https://www.aldiwan.net/poem26044.html","مجزوء الكامل"],[77,"حيى ربوع الحي من نعمان","https://www.aldiwan.net/poem36079.html","الكامل"],[77,"هدم السد وهو ما هو فار","https://www.aldiwan.net/poem36415.html","الخفيف"],[35,"يا لقومي لحبلك المصروم","https://www.aldiwan.net/poem38826.html","الخفيف"],[93,"مضى عصر الرجال الأعاظم","https://www.aldiwan.net/poem11326.html","الطويل"],[23,"ذهبت بابن الزبعرى وقعة","https://www.aldiwan.net/poem21243.html","الرمل"],[51,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[91,"إني مررت على الرياض الحاليه","https://www.aldiwan.net/poem62822.html","عموديه"],[70,"عرف الحبيب مكانه فتدللا","https://www.aldiwan.net/poem42731.html","الكامل"],[70,"يا حسن بعض الناس مهلا","https://www.aldiwan.net/poem42769.html","مجزوء الكامل"],[85,"علمت بالقلم الحكيم","https://www.aldiwan.net/poem63745.html","مجزوء الكامل"],[43,"باد هواك صبرت أم لم تصبرا","https://www.aldiwan.net/poem9608.html","الكامل"],[45,"يا ابن عمر والخير فيك قليل","https://www.aldiwan.net/poem65555.html","الخفيف"],[66,"من لصب أدنى البعاد وفاته","https://www.aldiwan.net/poem40641.html","الخفيف"],[31,"يا صاح هل تدري وقد جمدت","https://www.aldiwan.net/poem42572.html","الكامل"],[105,"نادى الشباب فهب من إغفائه","https://www.aldiwan.net/poem42094.html","الكامل"],[52,"لا ورمان النهود","https://www.aldiwan.net/poem27094.html","مجزوء الرمل"],[75,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[50,"طال في هند عتابي","https://www.aldiwan.net/poem64825.html","مجزوء الرمل"],[76,"يا هلالا قد تجلى","https://www.aldiwan.net/poem39330.html","مجزوء الرمل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/141028",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16661","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202530","الرجز"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141937","البسيط"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/8897","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54296","الخفيف"],[104,"دمع الخيل","https://www.poetsgate.com/ViewPoem.aspx?id=37377",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"إبن الشام","https://www.poetsgate.com/ViewPoem.aspx?id=178945",""]],"verses":[["وَرَسَوا في ظُهورِها","يَعلَقونَ النَواصِيا",0,"ي",2,0],["وَرَسّوا في فَواغِرِ كُلِّ خَطبٍ","صُدورَ البيضِ وَالزُرقَ الحِدادا",1,"د",2,0],["وَرَسولُهُ بِكِتابِهِ","قَد خَطَّهُ بِبَنانِهِ",2,"ن",2,0],["وَرَسَمْتُمُ تَارِيخَ كُلّ وَقِيعَةٍ","فِي مُهْرَقِ التَلْعَاتِ وَالْكُثْبَانِ",3,"ن",1,0],["ورَسولُ النّحوسِ تنْكَمِشُ الأوْ","جُهُ منْ فالِهِ ويُخْشى البَوارُ",4,"ر",1,0],["وَرُسومُ الدِيارِ تُعرَفُ مِنها","بِالمَلا بَينَ تَغلَمَينِ فَريمِ",5,"م",1,0],["وَرَسْم يَرَى الأَعْقَابَ فِيهِ دَلالَةً","عَلَى دِقَّةِ التَّمْثِيلِ فِي صُنْعِ رَاسِمِ",6,"م",1,0],["وَرَسولُ اللَهِ حَقّاً شاهِدٌ","يَومَ بَدرٍ وَالتَنابيلُ الهُبَل",7,"ل",1,0],["ورسا الراجحون من جِلَّةِ النا","س رسوَّ الجبال ذات الهضابِ",8,"ب",1,0],["وَرَسَمتُ يَوماً صورَةً في خاطِري","لِلحُسنِ إِنَّ الحوسنَ رَبُّ الشاعِرِ",9,"ر",1,0],["وَرُسومِ جِسمٍ كادَ يُحرِقُهُ الجَوى","لَو لَم تَدارَكهُ الدُموعُ لَأُشعِلا",10,"ل",2,0],["وَرُسومِ جِسمٍ لَم يَدَع","مِنهُ الهَوى إِلّا الأَقَلّا",11,"ل",2,0],["وَرَسائِلٍ مِثلِ السُلا","فِ إِذا تَمَشَّت في النَديمِ",12,"م",1,0],["وَرَسائِلٌ قَطَعَ العُداةُ سِحائَها","فَرَأَوا قَناً وَأَسِنَّةً وَسَنَوَّرا",13,"ر",2,0],["وَرَسولي لَحظٌ يُخَمِّشُ أَلفا","ظَكَ إِن لَم يوجَد إِلَيكَ رَسولُ",14,"ل",1,0],["وَرَسولٌ مِنكُم تَعَجَّبتُ مِنهُ","حينَ حانَت مِنّي إِلَيهِ التَفاتَه",15,"ت",2,0],["وَرِسالَةٍ مِنها تُعاتِبُني","فَرَدَدتُ مَعتَبَةٍ عَلى هِندِ",16,"د",1,0],["ورسولُ حقٍّ ما اسْتَبدَّ به الهَوى","يوماً ولا أعياهُ مُعضِلُ دائهِ",17,"ا",3,0],["وَرَسولٍ جاءَ بِالمي","عادِ مِن بَعدِ الوَعيدِ",18,"د",1,0],["ورَسَوْا حِجىً حتى استُخِفَّ متالعٌ","وهَمَوا نَدىً فاستحيتِ الأمطار",19,"ر",1,0],["وَرَسولاً باتَ يَسري","في هَواكُم بِالكِتابِ",20,"ب",1,0],["ورَسومُ الوَصْلِ قَدْ أَل","بَستَها ثَوبَ دُثورْ",21,"ر",1,0],["ورسائلٌ قطع العداة سحاءها","فرأوا قناً وأسنّةً وسنوّرا",22,"ر",2,0],["ورسَّامهم صَنَمٌ مُبْصِرٌ","فإنْ جُمِعوا فَهُمُ الشَّاعرُ",23,"ر",1,0],["ورَسولِ أحْلامٍ إليكِ بعَثْتُهُ","فأتى على يأسٍ بنُجْحِ المَطْلَب",24,"ب",1,0],["ورسم ما بان من الليالي","وأثرُ الأيام في الخيال",25,"ل",1,0],["ورُستمٌ هِرقُلُ الفرسِ الفحولِ إذا","ما انقضّ قلتَ عقابُ الحربِ مُذكيها",26,"ي",3,0],["وَرَسولٌ يَقولُ ما تَعجَزُ الأَل","فاظُ عَنهُ حُلوُ الحَديثِ أَديبُ",27,"ب",1,0],["ورَسَمنا بدائعَ الكونِ في لوْ","حٍ تعالى عن جَفْوَةِ الألواح",28,"ح",1,0],["ورسائل ريانة بدعابة","وعلى الدعابة يلتقي الأصحاب",29,"ب",1,0],["ورسالةٌ ندعو لها وأداؤُها","فرضٌ ، ورَعْيُ حقوقِها إلزام",30,"م",1,0],["ورسائل برقية مهزوزة","اسلاكها من قلبي الخفاق",31,"ق",1,0]]}