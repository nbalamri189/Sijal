{"poems":[[53,"من رأى أعينا حذفن","https://www.aldiwan.net/poem29625.html","مجزوء الخفيف"],[53,"ألا من يمطر السنة الجمادا","https://www.aldiwan.net/poem30602.html","الوافر"],[55,"من لي بمن أخشى الوشاة","https://www.aldiwan.net/poem26044.html","مجزوء الكامل"],[77,"حيى ربوع الحي من نعمان","https://www.aldiwan.net/poem36079.html","الكامل"],[77,"هدم السد وهو ما هو فار","https://www.aldiwan.net/poem36415.html","الخفيف"],[35,"يا لقومي لحبلك المصروم","https://www.aldiwan.net/poem38826.html","الخفيف"],[93,"مضى عصر الرجال الأعاظم","https://www.aldiwan.net/poem11326.html","الطويل"],[23,"ذهبت بابن الزبعرى وقعة","https://www.aldiwan.net/poem21243.html","الرمل"],[51,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[91,"إني مررت على الرياض الحاليه","https://www.aldiwan.net/poem62822.html","عموديه"],[70,"عرف الحبيب مكانه فتدللا","https://www.aldiwan.net/poem42731.html","الكامل"],[70,"يا حسن بعض الناس مهلا","https://www.aldiwan.net/poem42769.html","مجزوء الكامل"],[85,"علمت بالقلم الحكيم","https://www.aldiwan.net/poem63745.html","مجزوء الكامل"],[43,"باد هواك صبرت أم لم تصبرا","https://www.aldiwan.net/poem9608.html","الكامل"],[45,"يا ابن عمر والخير فيك قليل","https://www.aldiwan.net/poem65555.html","الخفيف"],[66,"من لصب أدنى البعاد وفاته","https://www.aldiwan.net/poem40641.html","الخفيف"],[31,"يا صاح هل تدري وقد جمدت","https://www.aldiwan.net/poem42572.html","الكامل"],[105,"نادى الشباب فهب من إغفائه","https://www.aldiwan.net/poem42094.html","الكامل"],[52,"لا ورمان النهود","https://www.aldiwan.net/poem27094.html","مجزوء الرمل"],[75,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[50,"طال في هند عتابي","https://www.aldiwan.net/poem64825.html","مجزوء الرمل"],[76,"يا هلالا قد تجلى","https://www.aldiwan.net/poem39330.html","مجزوء الرمل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/141028",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16661","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202530","الرجز"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141937","البسيط"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/8897","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54296","الخفيف"],[104,"دمع الخيل","https://www.poetsgate.com/ViewPoem.aspx?id=37377",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"إبن الشام","https://www.poetsgate.com/ViewPoem.aspx?id=178945",""],[115,"أهيم بخود عندها القلب قد فنى","https://www.aldiwan.net/poem41648.html","الطويل"],[115,"يا رسول الرضى بفضلك دارك","https://www.aldiwan.net/poem42172.html","الخفيف"],[117,"أشتات","https://www.aldiwan.net/poem24069.html","الكامل"],[160,"العلم بالإجماع معدنه ذهب","https://www.aldiwan.net/poem58716.html","الطويل"],[185,"لعل زماني بالعذيب يعود","https://www.aldiwan.net/poem14502.html","الطويل"],[186,"نفسي يخادعها الأمل","https://www.aldiwan.net/poem43464.html","مجزوء الكامل"],[189,"لمن ربع بأكناف المصلى","https://www.aldiwan.net/poem35174.html","الوافر"],[223,"ماذا تسر إلى القمر","https://www.aldiwan.net/poem41639.html","مجزوء الكامل"],[231,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[271,"قف بذات الاراك واندب طلولا","https://www.aldiwan.net/poem52065.html","الخفيف"],[275,"مرقوم الخد مورده","https://www.aldiwan.net/poem25586.html","المتدارك"],[275,"أحسنوا العطف عليها مهجا","https://www.aldiwan.net/poem25608.html","الرمل"],[304,"حي ظبي الرمال والأطلال","https://www.aldiwan.net/poem16833.html","الخفيف"],[305,"سائل النفس قبل فوت الأوان","https://www.aldiwan.net/poem56386.html","الخفيف"],[328,"رتل البلبل الطروب لحونه","https://www.aldiwan.net/poem55066.html","الخفيف"],[338,"اصطبح كأس شراب","https://www.aldiwan.net/poem68814.html","مجزوء الرمل"],[364,"هل أنت بطولك مسعده","https://www.aldiwan.net/poem60943.html","المتدارك"],[366,"مملوك مولانا ومملوك ابنه","https://www.aldiwan.net/poem17907.html","الكامل"],[400,"فجر في دجى الأحداث","https://www.aldiwan.net/poem10239.html","عموديه"],[416,"وقف الربع على مرتبع","https://www.aldiwan.net/poem53831.html","الرمل"],[416,"زيد لوما فزاد في الحب وجدا","https://www.aldiwan.net/poem54124.html","الخفيف"],[432,"أنجد الصب وغاروا","https://www.aldiwan.net/poem12645.html","مجزوء الرمل"],[443,"عجبا حللوا عذاب النفوس","https://www.aldiwan.net/poem56028.html","عموديه"],[468,"أمسيت في سبل الهوى متحيرا","https://www.aldiwan.net/poem59603.html","الكامل"],[479,"جنحت للغروب شمس الأصيل","https://www.aldiwan.net/poem37184.html","الخفيف"],[479,"قرنت قلوصك ربها بزميله","https://www.aldiwan.net/poem37580.html","الكامل"],[538,"إسألوني عما رأيت بعيني","https://www.aldiwan.net/poem47588.html","عموديه"],[538,"نلت عطفي وحناني","https://www.aldiwan.net/poem47925.html","عموديه"],[544,"هدهد لظاك","https://www.aldiwan.net/poem67254.html","عموديه"],[558,"عالم الحكمة هذا","https://www.aldiwan.net/poem34558.html","مجزوء الرمل"],[558,"يا من أرومهم بكل مرام","https://www.aldiwan.net/poem35091.html","الكامل"],[562,"القلب بين الصحب أعدل شاهد","https://www.aldiwan.net/poem52952.html","البسيط"],[563,"هو الأجل الموقوت لا يتخلف","https://www.aldiwan.net/poem13603.html","الطويل"],[587,"أعلى المنازل إذ عفت أعلامها","https://www.aldiwan.net/poem11516.html","عموديه"]],"verses":[["وَرَسَوا في ظُهورِها","يَعلَقونَ النَواصِيا",0,"ي",2,0],["وَرَسّوا في فَواغِرِ كُلِّ خَطبٍ","صُدورَ البيضِ وَالزُرقَ الحِدادا",1,"د",2,0],["وَرَسولُهُ بِكِتابِهِ","قَد خَطَّهُ بِبَنانِهِ",2,"ن",2,0],["وَرَسَمْتُمُ تَارِيخَ كُلّ وَقِيعَةٍ","فِي مُهْرَقِ التَلْعَاتِ وَالْكُثْبَانِ",3,"ن",1,0],["ورَسولُ النّحوسِ تنْكَمِشُ الأوْ","جُهُ منْ فالِهِ ويُخْشى البَوارُ",4,"ر",1,0],["وَرُسومُ الدِيارِ تُعرَفُ مِنها","بِالمَلا بَينَ تَغلَمَينِ فَريمِ",5,"م",1,0],["وَرَسْم يَرَى الأَعْقَابَ فِيهِ دَلالَةً","عَلَى دِقَّةِ التَّمْثِيلِ فِي صُنْعِ رَاسِمِ",6,"م",1,0],["وَرَسولُ اللَهِ حَقّاً شاهِدٌ","يَومَ بَدرٍ وَالتَنابيلُ الهُبَل",7,"ل",1,0],["ورسا الراجحون من جِلَّةِ النا","س رسوَّ الجبال ذات الهضابِ",8,"ب",1,0],["وَرَسَمتُ يَوماً صورَةً في خاطِري","لِلحُسنِ إِنَّ الحوسنَ رَبُّ الشاعِرِ",9,"ر",1,0],["وَرُسومِ جِسمٍ كادَ يُحرِقُهُ الجَوى","لَو لَم تَدارَكهُ الدُموعُ لَأُشعِلا",10,"ل",2,0],["وَرُسومِ جِسمٍ لَم يَدَع","مِنهُ الهَوى إِلّا الأَقَلّا",11,"ل",2,0],["وَرَسائِلٍ مِثلِ السُلا","فِ إِذا تَمَشَّت في النَديمِ",12,"م",1,0],["وَرَسائِلٌ قَطَعَ العُداةُ سِحائَها","فَرَأَوا قَناً وَأَسِنَّةً وَسَنَوَّرا",13,"ر",2,0],["وَرَسولي لَحظٌ يُخَمِّشُ أَلفا","ظَكَ إِن لَم يوجَد إِلَيكَ رَسولُ",14,"ل",1,0],["وَرَسولٌ مِنكُم تَعَجَّبتُ مِنهُ","حينَ حانَت مِنّي إِلَيهِ التَفاتَه",15,"ت",2,0],["وَرِسالَةٍ مِنها تُعاتِبُني","فَرَدَدتُ مَعتَبَةٍ عَلى هِندِ",16,"د",1,0],["ورسولُ حقٍّ ما اسْتَبدَّ به الهَوى","يوماً ولا أعياهُ مُعضِلُ دائهِ",17,"ا",3,0],["وَرَسولٍ جاءَ بِالمي","عادِ مِن بَعدِ الوَعيدِ",18,"د",1,0],["ورَسَوْا حِجىً حتى استُخِفَّ متالعٌ","وهَمَوا نَدىً فاستحيتِ الأمطار",19,"ر",1,0],["وَرَسولاً باتَ يَسري","في هَواكُم بِالكِتابِ",20,"ب",1,0],["ورَسومُ الوَصْلِ قَدْ أَل","بَستَها ثَوبَ دُثورْ",21,"ر",1,0],["ورسائلٌ قطع العداة سحاءها","فرأوا قناً وأسنّةً وسنوّرا",22,"ر",2,0],["ورسَّامهم صَنَمٌ مُبْصِرٌ","فإنْ جُمِعوا فَهُمُ الشَّاعرُ",23,"ر",1,0],["ورَسولِ أحْلامٍ إليكِ بعَثْتُهُ","فأتى على يأسٍ بنُجْحِ المَطْلَب",24,"ب",1,0],["ورسم ما بان من الليالي","وأثرُ الأيام في الخيال",25,"ل",1,0],["ورُستمٌ هِرقُلُ الفرسِ الفحولِ إذا","ما انقضّ قلتَ عقابُ الحربِ مُذكيها",26,"ي",3,0],["وَرَسولٌ يَقولُ ما تَعجَزُ الأَل","فاظُ عَنهُ حُلوُ الحَديثِ أَديبُ",27,"ب",1,0],["ورَسَمنا بدائعَ الكونِ في لوْ","حٍ تعالى عن جَفْوَةِ الألواح",28,"ح",1,0],["ورسائل ريانة بدعابة","وعلى الدعابة يلتقي الأصحاب",29,"ب",1,0],["ورسالةٌ ندعو لها وأداؤُها","فرضٌ ، ورَعْيُ حقوقِها إلزام",30,"م",1,0],["ورسائل برقية مهزوزة","اسلاكها من قلبي الخفاق",31,"ق",1,0],["ورسم محياها بلوح الحشا انطوى","وحق الهوى والخوف من ألم النوى",32,"ا",1,0],["ورسوم الورى ومن حل فيها","عند كشف الغطاء من آثارك",33,"ك",1,0],["ورسائلٌ عَتْبَى؛ لأنّكَ غِبتَ عن","سَفَرٍ لِمُؤتَمَرٍ، ولم تَحْضُرْ ولمْ",34,"م",1,0],["ورست بهم أمواجٍ بحر علومه","كيف التخلصُ والوقوع على الأدب",35,"ب",1,0],["ورُسْلُ المَنايا والمُنَى طوعُ ما تَرَى","لها في البَرايا رائدٌ وبريد",36,"د",1,0],["ورسمت نفسي بالقبي","ح من الفعال ولم أبل",37,"ل",1,0],["وَرُسلُ اللَّه سادوا الخلق طرّاً","وَفاقوا العالمينَ هدىً وفضلا",38,"ل",2,0],["وَرسوم هاتيك الطلول","وَزُهور تِلكَ الرابِيَه",39,"ه",1,0],["وَرَسَت عَلَيها الشامِخات بِإِذنِهِ","فَحَمَت جَوانِبَها مِنَ المَيَدانِ",40,"ن",1,0],["وَرسوب الماضي وَبَتّار الطُّلى","أَو في القِسيّ كَشوحطِ المرنانِ",40,"ن",1,0],["وَرسوما بالابلق الفرد أَضحَت","لمها الرمل مسمراوَمقيلا",41,"ل",2,0],["وَرَسَائِلُه وقَصَائِدُه","ما نَعْرِضُه إذْ نَقْصدُهُ",42,"د",2,0],["وَرِسالاتِ هَوىً جاءَتْ بِها","فَأفَادَت كُلّ قَلْبٍ ثَلَجا",43,"ج",2,0],["ورسيس على الفؤاد مقيم","من قديم يلوح لي في المثال",44,"ل",1,0],["وَرُسوخُ العلومِ لا يح","صُلُ إلّا بملحف الإدمانِ",45,"ن",1,0],["ورسول يرى النعيم على الذل","جحيما فليس يرضى سكونه",46,"ن",2,0],["وَرَسولٍ بِكِتابٍ","وَاِنتِظارٍ لجَوابِ",47,"ب",1,0],["ورسولُ أجَلِّ إمامِ هُدىً","في رُكْنٍ منهُ يُشَيِّده",48,"د",2,0],["وَرَسولي السُلطانُ في إِبلاغِها","وَالناسُ رُسلُهُمُ إِلى السُلطانِ",49,"ن",1,0],["ورَسَمْنا وجهَ الحضارة طَلْقاً","ومدَدْنا لها ظلال الغصون",50,"ن",1,0],["ورسومٍ رحت أستسقي لها","من عيون الركب منهلَّ الغوادي",51,"ي",1,0],["ورسوم من آل ميٍّ بوالٍ","أصبحَتْ فيه أعيُن الركب تندى",52,"د",2,0],["ورسومٌ زَجَروها","أين بالزجرِ انزجارُ",53,"ر",1,0],["ورسول إلى الوفا راح يدعو","ورسول إلى رضى بعد بؤس",54,"س",1,0],["ورسول معلل بوصال","ورسول بالبشر بعد عبوس",54,"س",1,0],["وَرُسومُ خَدِّيَ مَحَت آثارَها","بِسُيولِ أَدمُعِها غُيومُ جُفونِ",55,"ن",1,0],["ورست وجنة الفضا بضئيل","من سناها وبعد ذا بقليل",56,"ل",1,0],["ورسمت بالإحساسما استنتجته","من مذكرات لم تحن لمثيله",57,"ل",2,0],["وَرَسُولٌ منَ المَلِيكِ أتَاهُ","سَائِلاً أَن يُجِيبَهُ فِي الحِينِ",58,"ن",1,0],["ورُسومٍ لِرِفاقٍ","عُلِّقت في الجُدرانِ",59,"ن",1,0],["ورسالة النور التي انطلقت على","كفَّيك تاه بمدّها العنوان",60,"ن",1,0],["ورسولَ الله أيضاً","عند ما شذ شذاذا",61,"ذ",2,0],["ورسائل الإخوان فيما بيننا","مشمولة بتحية وسلام",62,"م",1,0],["ورِسالةٍ أَنِسَ الفُؤاد بوفدها","أُنْسَ المريضِ إلى الطبيب الوافدِ",63,"د",1,0],["وَرِسطا وَقِسطا وَاِبنُ وَهَرمُسٌ","وإِقليدِس ذو الجَوسَفَينِ وَاِسقُفُ",64,"ف",1,0],["ورست بها أطواد شرعة أحمد","وتأطدت بعد الوهاء دعمها",65,"م",3,0]]}