361&r=&rc=53",""],[6273,"قواف ٍ في ركب السراة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78507&r=&rc=5",""]],"verses":[["وَرَسَوا في ظُهورِها","يَعلَقونَ النَواصِيا",0,"ي",2,0],["وَرَسّوا في فَواغِرِ كُلِّ خَطبٍ","صُدورَ البيضِ وَالزُرقَ الحِدادا",1,"د",2,0],["وَرَسولُهُ بِكِتابِهِ","قَد خَطَّهُ بِبَنانِهِ",2,"ن",2,0],["وَرَسَمْتُمُ تَارِيخَ كُلّ وَقِيعَةٍ","فِي مُهْرَقِ التَلْعَاتِ وَالْكُثْبَانِ",3,"ن",1,0],["ورَسولُ النّحوسِ تنْكَمِشُ الأوْ","جُهُ منْ فالِهِ ويُخْشى البَوارُ",4,"ر",1,0],["وَرُسومُ الدِيارِ تُعرَفُ مِنها","بِالمَلا بَينَ تَغلَمَينِ فَريمِ",5,"م",1,0],["وَرَسْم يَرَى الأَعْقَابَ فِيهِ دَلالَةً","عَلَى دِقَّةِ التَّمْثِيلِ فِي صُنْعِ رَاسِمِ",6,"م",1,0],["وَرَسولُ اللَهِ حَقّاً شاهِدٌ","يَومَ بَدرٍ وَالتَنابيلُ الهُبَل",7,"ل",1,0],["ورسا الراجحون من جِلَّةِ النا","س رسوَّ الجبال ذات الهضابِ",8,"ب",1,0],["وَرَسَمتُ يَوماً صورَةً في خاطِري","لِلحُسنِ إِنَّ الحوسنَ رَبُّ الشاعِرِ",9,"ر",1,0],["وَرُسومِ جِسمٍ كادَ يُحرِقُهُ الجَوى","لَو لَم تَدارَكهُ الدُموعُ لَأُشعِلا",10,"ل",2,0],["وَرُسومِ جِسمٍ لَم يَدَع","مِنهُ الهَوى إِلّا الأَقَلّا",11,"ل",2,0],["وَرَسائِلٍ مِثلِ السُلا","فِ إِذا تَمَشَّت في النَديمِ",12,"م",1,0],["وَرَسائِلٌ قَطَعَ العُداةُ سِحائَها","فَرَأَوا قَناً وَأَسِنَّةً وَسَنَوَّرا",13,"ر",2,0],["وَرَسولي لَحظٌ يُخَمِّشُ أَلفا","ظَكَ إِن لَم يوجَد إِلَيكَ رَسولُ",14,"ل",1,0],["وَرَسولٌ مِنكُم تَعَجَّبتُ مِنهُ","حينَ حانَت مِنّي إِلَيهِ التَفاتَه",15,"ت",2,0],["وَرِسالَةٍ مِنها تُعاتِبُني","فَرَدَدتُ مَعتَبَةٍ عَلى هِندِ",16,"د",1,0],["ورسولُ حقٍّ ما اسْتَبدَّ به الهَوى","يوماً ولا أعياهُ مُعضِلُ دائهِ",17,"ا",3,0],["وَرَسولٍ جاءَ بِالمي","عادِ مِن بَعدِ الوَعيدِ",18,"د",1,0],["ورَسَوْا حِجىً حتى استُخِفَّ متالعٌ","وهَمَوا نَدىً فاستحيتِ الأمطار",19,"ر",1,0],["وَرَسولاً باتَ يَسري","في هَواكُم بِالكِتابِ",20,"ب",1,0],["ورَسومُ الوَصْلِ قَدْ أَل","بَستَها ثَوبَ دُثورْ",21,"ر",1,0],["ورسائلٌ قطع العداة سحاءها","فرأوا قناً وأسنّةً وسنوّرا",22,"ر",2,0],["ورسَّامهم صَنَمٌ مُبْصِرٌ","فإنْ جُمِعوا فَهُمُ الشَّاعرُ",23,"ر",1,0],["ورَسولِ أحْلامٍ إليكِ بعَثْتُهُ","فأتى على يأسٍ بنُجْحِ المَطْلَب",24,"ب",1,0],["ورسم ما بان من الليالي","وأثرُ الأيام في الخيال",25,"ل",1,0],["ورُستمٌ هِرقُلُ الفرسِ الفحولِ إذا","ما انقضّ قلتَ عقابُ الحربِ مُذكيها",26,"ي",3,0],["وَرَسولٌ يَقولُ ما تَعجَزُ الأَل","فاظُ عَنهُ حُلوُ الحَديثِ أَديبُ",27,"ب",1,0],["ورَسَمنا بدائعَ الكونِ في لوْ","حٍ تعالى عن جَفْوَةِ الألواح",28,"ح",1,0],["ورسائل ريانة بدعابة","وعلى الدعابة يلتقي الأصحاب",29,"ب",1,0],["ورسالةٌ ندعو لها وأداؤُها","فرضٌ ، ورَعْيُ حقوقِها إلزام",30,"م",1,0],["ورسائل برقية مهزوزة","اسلاكها من قلبي الخفاق",31,"ق",1,0],["ورسم محياها بلوح الحشا انطوى","وحق الهوى والخوف من ألم النوى",32,"ا",1,0],["ورسوم الورى ومن حل فيها","عند كشف الغطاء من آثارك",33,"ك",1,0],["ورسائلٌ عَتْبَى؛ لأنّكَ غِبتَ عن","سَفَرٍ لِمُؤتَمَرٍ، ولم تَحْضُرْ ولمْ",34,"م",1,0],["ورست بهم أمواجٍ بحر علومه","كيف التخلصُ والوقوع على الأدب",35,"ب",1,0],["ورُسْلُ المَنايا والمُنَى طوعُ ما تَرَى","لها في البَرايا رائدٌ وبريد",36,"د",1,0],["ورسمت نفسي بالقبي","ح من الفعال ولم أبل",37,"ل",1,0],["وَرُسلُ اللَّه سادوا الخلق طرّاً","وَفاقوا العالمينَ هدىً وفضلا",38,"ل",2,0],["وَرسوم هاتيك الطلول","وَزُهور تِلكَ الرابِيَه",39,"ه",1,0],["وَرَسَت عَلَيها الشامِخات بِإِذنِهِ","فَحَمَت جَوانِبَها مِنَ المَيَدانِ",40,"ن",1,0],["وَرسوب الماضي وَبَتّار الطُّلى","أَو في القِسيّ كَشوحطِ المرنانِ",40,"ن",1,0],["وَرسوما بالابلق الفرد أَضحَت","لمها الرمل مسمراوَمقيلا",41,"ل",2,0],["وَرَسَائِلُه وقَصَائِدُه","ما نَعْرِضُه إذْ نَقْصدُهُ",42,"د",2,0],["وَرِسالاتِ هَوىً جاءَتْ بِها","فَأفَادَت كُلّ قَلْبٍ ثَلَجا",43,"ج",2,0],["ورسيس على الفؤاد مقيم","من قديم يلوح لي في المثال",44,"ل",1,0],["وَرُسوخُ العلومِ لا يح","صُلُ إلّا بملحف الإدمانِ",45,"ن",1,0],["ورسول يرى النعيم على الذل","جحيما فليس يرضى سكونه",46,"ن",2,0],["وَرَسولٍ بِكِتابٍ","وَاِنتِظارٍ لجَوابِ",47,"ب",1,0],["ورسولُ أجَلِّ إمامِ هُدىً","في رُكْنٍ منهُ يُشَيِّده",48,"د",2,0],["وَرَسولي السُلطانُ في إِبلاغِها","وَالناسُ رُسلُهُمُ إِلى السُلطانِ",49,"ن",1,0],["ورَسَمْنا وجهَ الحضارة طَلْقاً","ومدَدْنا لها ظلال الغصون",50,"ن",1,0],["ورسومٍ رحت أستسقي لها","من عيون الركب منهلَّ الغوادي",51,"د",2,0],["ورسوم من آل ميٍّ بوالٍ","أصبحَتْ فيه أعيُن الركب تندى",52,"د",2,0],["ورسومٌ زَجَروها","أين بالزجرِ انزجارُ",53,"ر",1,0],["ورسول إلى الوفا راح يدعو","ورسول إلى رضى بعد بؤس",54,"س",1,0],["ورسول معلل بوصال","ورسول بالبشر بعد عبوس",54,"س",1,0],["وَرُسومُ خَدِّيَ مَحَت آثارَها","بِسُيولِ أَدمُعِها غُيومُ جُفونِ",55,"ن",1,0],["ورست وجنة الفضا بضئيل","من سناها وبعد ذا بقليل",56,"ل",1,0],["ورسمت بالإحساسما استنتجته","من مذكرات لم تحن لمثيله",57,"ل",2,0],["وَرَسُولٌ منَ المَلِيكِ أتَاهُ","سَائِلاً أَن يُجِيبَهُ فِي الحِينِ",58,"ن",1,0],["ورُسومٍ لِرِفاقٍ","عُلِّقت في الجُدرانِ",59,"ن",1,0],["ورسالة النور التي انطلقت على","كفَّيك تاه بمدّها العنوان",60,"ن",1,0],["ورسولَ الله أيضاً","عند ما شذ شذاذا",61,"ذ",2,0],["ورسائل الإخوان فيما بيننا","مشمولة بتحية وسلام",62,"م",1,0],["ورِسالةٍ أَنِسَ الفُؤاد بوفدها","أُنْسَ المريضِ إلى الطبيب الوافدِ",63,"د",1,0],["وَرِسطا وَقِسطا وَاِبنُ وَهَرمُسٌ","وإِقليدِس ذو الجَوسَفَينِ وَاِسقُفُ",64,"ف",1,0],["ورست بها أطواد شرعة أحمد","وتأطدت بعد الوهاء دعمها",65,"م",3,0],["وَرِسَتانِ تَميسُ في بُردَيهِما","مِن سَمهَريَّتِهِ وَمِن أقلامهِ",66,"م",2,0],["ورسول رب العالمين ومن له","حفظ العهود وصحة الميثاق",67,"ق",1,0],["ورسم ابن بيضا صحيفة بر","عليها خطوط التقى تستطر",68,"ر",1,0],["وَرَسولُهُ خَيرُ الوَرى","مُختارُه طهَ المُطهَّر",69,"ر",1,0],["ورسلي لحاجاتي وهُنَّ كثيرةٌ","إليكَ إشاراتٌ بها وزفيرُ",70,"ر",1,0],["وَرَسَمنا نوافذاً","وشموسَاً وسوسَنا",71,"ن",2,0],["ورست حلومك فاستخف","ف على رزانته شامُ",72,"م",1,0],["ورسمان لي لا بد لي منهما","عليك لا زلت لداع مجيب",73,"ب",1,0],["وَرسمتَ في وجهِ السماء كتابةً","عُنوانها يقراه من لا يكتبُ",74,"ب",1,0],["ورسول اللَّه جدي جده","وعلينا كان تنزيل الكتب",75,"ب",1,0],["ورسّها فتحة ردف سالك","من قبل تأسيس كميم مالك",76,"ك",1,0],["ورسمي محيلٌ وصبري عسير","أخفيت سرك في الفؤَاد فلاح لي",77,"ي",1,0],["ورست على أعتابه سفن الرجا","فنجت بها من آفة الحرمان",78,"ن",1,0],["ورسمه في بقش درهم ودينار","وطابع يمنه الخيل الضوامر",79,"ر"