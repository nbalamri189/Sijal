{"poems":[[90,"يعيش الناس في حال أجتماع","https://www.aldiwan.net/poem44982.html","الوافر"],[53,"صبا من شاب مفرقه تصابي","https://www.aldiwan.net/poem8494.html","الوافر"],[53,"أناديك يا من ليس في سمعه وقر","https://www.aldiwan.net/poem64064.html","الطويل"],[45,"أرى الشطرنج لو كانت رجالا","https://www.aldiwan.net/poem10610.html","الوافر"],[68,"بكى عليك الحسام والقلم","https://www.aldiwan.net/poem40290.html","المنسرح"],[46,"هو الدهر لا يشوي وهن المصائب","https://www.aldiwan.net/poem30323.html","الطويل"],[48,"أرى ابن أبي إسحاق أسحقه الردى","https://www.aldiwan.net/poem22645.html","الطويل"],[78,"أرى للصبا وداعا","https://www.aldiwan.net/poem39273.html","المضارع"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16629","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[108,"صفاء النفس!","https://www.poetsgate.com/ViewPoem.aspx?id=179324",""],[173,"قم فاسقنيها قبل صوت الحمام","https://www.aldiwan.net/poem1679.html",""],[234,"قد ظلموا إذ نسبوا ثغره","https://www.aldiwan.net/poem51143.html","السريع"],[261,"يا قوم عالجت أيري","https://www.aldiwan.net/poem48321.html","المجتث"],[309,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[369,"أهكذا يسري القمر","https://www.aldiwan.net/poem60902.html","مجزوء الرجز"],[369,"سرى كما يسري القمر","https://www.aldiwan.net/poem60914.html","مجزوء الرجز"],[435,"خود من الترك قد صالت على العرب","https://www.aldiwan.net/poem40050.html","البسيط"],[458,"أفى العرس تنعى يالها قسوة القدر","https://www.aldiwan.net/poem61712.html","الطويل"],[479,"تركت ابن الحريز على ذمام","https://www.aldiwan.net/poem2157.html","الوافر"],[482,"يذكرني ثناياهنلما","https://www.aldiwan.net/poem15199.html","الوافر"],[556,"بلغنا ليلة الشعب","https://www.aldiwan.net/poem48050.html","الهزج"],[580,"يا قلب ويحك إن ظبيك قد سنح","https://www.aldiwan.net/poem3091.html","الكامل"],[581,"خليلي إما مت يوما وزحزحت","https://www.aldiwan.net/poem1781.html","الطويل"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53744","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38772","المجتث"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77528","الرجز"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67842","الطويل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88644","البسيط"],[2375,"","https://poetry.dctabudhabi.ae/diwan/poem/130705","البسيط"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121181","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89424","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89118","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74046","المجتث"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117977","الوافر"],[3784,"","https://poetry.dctabudhabi.ae/diwan/poem/18575","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114153","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102985","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83401","الطويل"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35414","الطويل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76749","الطويل"],[4755,"مُغَرَّبٌ.. إِن حَلَّ, أَو هاجَرَا","https://www.poetsgate.com/ViewPoem.aspx?id=202602",""],[4783,"أ أسْلو؟","https://www.poetsgate.com/ViewPoem.aspx?id=185446",""],[5022,"غن الهو","https://www.poetsgate.com/ViewPoem.aspx?id=201037",""],[5050,"أرى الأيام لي حربا","https://www.poetsgate.com/ViewPoem.aspx?id=38212",""],[5448,"أطع ربك الباري وصفوة رحمان","https://www.poetsgate.com/ViewPoem.aspx?id=138060",""],[5616,"معذرة يا أبا العلاء","https://www.poetsgate.com/ViewPoem.aspx?id=204842",""],[6349,"صُورَة جماعِيَّة لِشَخْصٍ وَاحِد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85447&r=&rc=1",""]],"verses":[["ولم يَصْلُح فساد الناس إلا","بمال من مكاسبهم مُشاع",0,"ع",1,0],["ولم يصدُدنَ من خَفَرٍ ودَلٍّ","ولكن من بِعادٍ واجتنابِ",1,"ب",1,0],["ولم يصفُ من شيءٍ صفاءَ طَويتي","فلِمْ شرْبُهم صفو ولمْ مَشربي كدر",2,"ر",1,0],["ولم يُصدِرن حُمراً كُنَّ بيضاً","ولم يغشين من موت ظلالا",3,"ل",2,0],["وَلَم يَصِل وَالخَميسُ مُرتَكِبٌ","عَبابُهُ وَالعَجاجُ مُرتَكِمُ",4,"م",1,0],["وَلَم يَصدَعِ النادي بِلَفظَةِ فَيصَلٍ","سِنانِيَّةٍ في صَفحَتَيها التَجارِبُ",5,"ب",1,0],["وَلَم يَصنَعوا شَيئاً وَلَكِن تَنازَعوا","أَباطيلَ تُضحي مِثلَ هامِدَةِ الجَمرِ",6,"ر",1,0],["ولم يُصِبْنا سُروراً","وَلم يُلْهِنا سَماعا",7,"ع",2,0],["ولم يصرهن العز منه وإنما","صراهن منه أنهن ضئال",8,"ل",1,0],["وَلمْ يَصُنْهُ عَنْهُمُ","صَوْنَ بَخِيلٍ مَا ادَّخَرْ",9,"ر",1,0],["ولم يصرفكِ عن أُخْرَاكِ شَيْءُ","وغيرَ رضاء ربِّكِ لم تَرُومي",10,"م",2,0],["وَلَم يُصَعِّر خَدَّهُ مُعرِضاً","كِبراً وَلَم يَفضُض لِجُورٍ خِتام",11,"م",1,0],["ولم يَصُغْه الله إلا لكَيْ","يقدحَ في الأكباد نارَ الكَمَدْ",12,"د",1,0],["ولمْ يصحّ ودَادِي","من غادَةٍ مُذْ تَوَعَّكْ",13,"ك",1,0],["ولم يصب فيها آمل غير كفئها","أتهوى مقام الفضل أنفاس حمان",14,"ن",1,0],["ولم يَصِلْ حتّى هَجَر","وسبَقَ الوِرْدَ الصَّدر",15,"ر",1,0],["ولم يَصِلْ حتّى هَجَر","وزوَّد الصّبَّ الذِّكَر",16,"ر",1,0],["ولم يصد لثامٌ السحر مقلتها","ولا الغلائل فعل الأملد الرطب",17,"ب",1,0],["ولم يصطحب إلاّ السُّهادَ ببحثه","كذاك النجوم الزُّهرُ تصطحبُ السَّهر",18,"ر",1,0],["ولم يصرف صدور الخيل إلا","صوائِحُ من أيائيم ضعافِ",19,"ف",1,0],["ولم يصدحْوقد طاحَ النَّدامى","بهاقبلَ الصباحِ العُْترُفانُ",20,"ن",1,0],["ولم يُصْبَوْا بشنعاءَ","وفي الشّنعاءِ ما يُصبي",21,"ب",2,0],["ولَمىً صقيل في مَراشِف شادنٍ","لو شئتُ أَمسحُه بلثمي لانْمَسَحْ",22,"ح",1,0],["وَلَم يَصطَبِح في يَومِ حَرٍّ وَقِرَّةٍ","حُمَيّا فَدَبَّت في مَفاصلِهِ الخَمرُ",23,"ر",1,0],["ولم يَصْحُ من يَوْمٍ ولم يُمْسِ لَيْلَةً","بَغْيرِ اكتسابِ الحَمْدِ مُشتَغِلَ الفِكْرِ",24,"ر",1,0],["وَلَم يَصُنكَ وَيَحرُس","أَلَم يَجِدكَ يَتيما",25,"م",2,0],["وَلَم يُصبه مِن أَذىً وَلا ضَرَر","وَرُبَما كانَ الهِلال في الكبر",26,"ر",1,0],["وَلَمْ يَصْغَ سَمْعِي لِلْمَلاَمِ بَرَاءَةً","غَزَالٌ غَدَا يَقْرَا الصُّدُودَ قِرَاءَةً",27,"ه",1,0],["ولم يصن بذلة الراجي بعارفة","الا واردفها بالعارض الهطل",28,"ل",1,0],["ولم يصح له ما عاش من قدر","سوى معاش له في اللوح مستطر",29,"ر",1,0],["ولم يصد يوما قط مراة موعد","بمطل جوار حيثما قال يفعل",30,"ل",1,0],["ولم يصهل ولم يشرب هواء","ولم يُحمَر ولم يقلقه كي",31,"ي",1,0],["ولم يصل علوَّهم علوُّ","وفي الصنائع انتهى السموُّ",32,"و",1,0],["وَلَم يصل لك وَصلاً","من صدّ في الحبّ صدّك",33,"ك",1,0],["ولم يصدرن عن مثوى عدو","وفيه سوى اليتامى والأيامى",34,"م",2,0],["وَلَم يُصبِحِ الخيلَ الحلولَ بِخَيلِهِ","فَيَترُكَ مِنهُم ساحَةَ الدارِ بِلقَعا",35,"ع",2,0],["وَلَم يَصِل سِرُّ كُنهِكَ المَصُونِ وَلَم","يَقدُركَ قَدرَكَ إِلاَّ المُفرَدُ الصَّمَدُ",36,"د",1,0],["ولم يصيبك سوى سهم الألى غدروا","كجائر البيضلولا الكفّ لم يجر",37,"ر",1,0],["وَلم يصحُ إلّا والمفوّض حوله","ومن حوله بعضُ الجنود البَواسِلِ",38,"ل",1,0],["وَلَم يَصفُ زُهدٌ لا وَلا عَملٌ لِمَن","يَرى نَفسَهُ في زُهدِها قَد تَرَقَّتِ",39,"ت",1,0],["وَلَم يَصف أَي يُخلِص مِنَ الجَهلِ أَمرَهُ","وَلَم يُلفَ إِلّا في غَياهِبِ رَيبَةِ",39,"ه",1,0],["ولم يصدع النقع المثار سنانه","كما صدع الظلماء برق تضرّ ما",40,"م",2,0],["ولَم يَصِل حَتَّى إِلى نَفسِهِ","لِأَنَّهُ بِالوَهمِ قَد سافَرَا",41,"ر",2,0],["ولم يصفُ لي بعدكم مشربٌ","ولم يحلُ لي بعدكم مَشْهد",42,"د",1,0],["ولم يصلنا معان من ثمود ومن","عاد وفرعون من هامان قارون",43,"ن",1,0],["ولم يصغ إلى داع","ولم يسمع له ندبا",44,"ب",2,0],["ولم يصب فيها آمل غير كفئها","أتهوى مقام الفضل أنفاس حنان",45,"ن",1,0],["ولم يُصدِّرْ إلى الإفرنج عزَّتَهُ","ولم يبِعْ سيفه والحربُ تضطرمُ",46,"م",1,0],["ولم يَصِلْ بَعْضُ صَوْتٍ غَيْرُ زَقْزَقَةٍِ","لمِفْصَلٍ كانَ بابُ القَلْبِ يَرْتَجِفُ",47,"ف",1,0]]}