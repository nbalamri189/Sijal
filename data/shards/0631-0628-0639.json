.aspx?id=37043",""],[5344,"عطره الشانيل ..","https://www.poetsgate.com/ViewPoem.aspx?id=180706",""],[5344,"ربعي بني وايل ( قبيلة عنزه )..","https://www.poetsgate.com/ViewPoem.aspx?id=180837",""],[5397,"أبسفح حاجر منك يسفح محجر","https://www.poetsgate.com/ViewPoem.aspx?id=157963",""],[5397,"لا تسألن معالم الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=157918",""],[5401,"مهند وطوني","https://www.poetsgate.com/ViewPoem.aspx?id=85371",""],[5582,"لِمَنْ بِسِقْطِ اللِّوَى وَالمُنْحَنَى طَلَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=187219",""],[5582,"خَلِّ الكَئِيبَ يُقاسِي ما يُقاسِيهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63602",""],[5582,"كَمْ أَنْتَ تَجْحَدُ وَالمَدامِعُ تَشْهَدُ","https://www.poetsgate.com/ViewPoem.aspx?id=63498",""],[5677,"بني عزيز ..!","https://www.poetsgate.com/ViewPoem.aspx?id=179980",""],[5690,"نوائب الدهر إنذارٌ إلى الأممِ","https://www.poetsgate.com/ViewPoem.aspx?id=172180",""],[5732,"فتى بني وايل","https://www.poetsgate.com/ViewPoem.aspx?id=177900",""],[5759,"سنظلُّ نبكي","https://www.poetsgate.com/ViewPoem.aspx?id=212934",""],[5866,"مدح القبيلة","https://www.poetsgate.com/ViewPoem.aspx?id=182810",""],[5976,"ربعي بني خالد","https://www.poetsgate.com/ViewPoem.aspx?id=30387",""],[6008,"مهداه إلى الإمير نواف بن فواز الشعلان","https://www.poetsgate.com/ViewPoem.aspx?id=60802",""],[6035,"كم كان أَعْدَل لو أَزْرَى بنا الحَجرُ .. !","https://www.poetsgate.com/ViewPoem.aspx?id=177617",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577067",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577080",""],[406,"خيمة الظلماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63653&r=&rc=83",""]],"verses":[["رَبعٌ قَريبُ العَهدِ أَحسَبُهُ","بِالظاعِنينَ وَقَد مَضى عَهدي",0,"د",2,0],["رَبَعَت عَلى آثارِكُم نَجدِيَّةٌ","غَرّاءُ ذاتُ بَوارِقٍ وَرُعودِ",1,"د",1,0],["رُبَّ عَبرَةٍ نَضَحَتْ","وَردَ خَدِّكِ الخَجِلِ",2,"ل",1,0],["رَبَعيَّةُ الآباءِ إِن نُسِبَتْ","فَلَها أَراقِمُ وائِلٍ رَهْطُ",3,"ط",1,0],["رُبَّ عِشارٍ سَوفَ يَغتالُها","لا مُبطِئُ السَيرَ وَلا عائِجُ",4,"ج",1,0],["رَبعاً لِواضِهَةِ الجَبينِ غَريرَةٍ","كَالشَمسِ إِذ طَلَعَت رَخيمِ المَنطِقِ",5,"ق",1,0],["رُبَّ عانٍ أَطلَقتَهُ بَعدَ ما كا","نَ يُعاني في الأَسرِ قَيداً وَقِدّا",6,"د",2,0],["ربعكم وافر الرخاء أمين","غفلةٍ عن ثغوره الأيام",7,"م",1,0],["رَبْعُكُمْ فِي أَمَانَةٍ مُطْمَئِنٌّ","غَفَلَتْ عَنْ ثُغُورِهِ الأَيَّامُ",8,"م",1,0],["رَبَعنا وَأَردَفنا المُلوكَ فَظَلَّلوا","وِطابَ الأَحاليبِ الثُمامَ المُنَزَّعا",9,"ع",2,0],["ربَّ عيش طهرٍ على ذلك الس","فح غنمناهُ قبل يومِ التنائي",10,"ا",2,0],["رَبَّ عيش واصلتنا فيه غيدْ","أنا عبدٌ عربي فيها سعيد",11,"د",1,1],["رَبّ عمرهْ في رواة المعالي","فهو فيهم نعم السراجُ المعمَّر",12,"ر",1,0],["ربّ عيشٍ نصبت كأس مدامِهْ","ومليحٍ ضممت غصن قوامِهْ",13,"م",2,1],["ربع لعزَّة صامتٌ لا يفهم","وقلوبنا في رسمِهِ تتكلَّم",14,"م",1,1],["ربع سلواني خراب","وشجوني عامريَّه",15,"ي",2,0],["رُبَّ عِرْضٍ مُنزَّهٍ عن قبيحٍ","دنّستهُ مُعَرِّضاتُ الهجاءِ",16,"ا",2,1],["رب عرس مر للبر بها","ماج بالخيرِّ والسمح المنيل",17,"ل",1,0],["رب عين سمحة خاشعة","روت العشب ولم تنس النخيل",17,"ل",1,0],["رب عاث في الأرض لم يجعل الأر","ض له إن أقام أو سار وزنا",18,"ن",2,0],["رُبَّ عَدوٍّ عاقِلٍ أَشكاكا","وَرُبَّ وَدِّ جاهِلٍ أَبكاكا",19,"ك",2,0],["رُبَّ عامٍ أَنتَ فيهِ واجِدٌ","وَاِدَّخِر فيهِ لِعامٍ لا تَجِد",20,"د",1,0],["رُبَّ عاثٍ في الأَرضِ لَم تَجعَلِ الأَر","ضُ لَهُ إِن أَقامَ أَو سارَ وَزنا",21,"ن",2,0],["رُبَّ عَبدٍ قَدِ اِشتَراني بِمالٍ","وَغُلامٍ قَد ساقَ مِنّي غُلاما",22,"م",2,0],["رُبَّ عَيشٍ لَنا بِرامَةٍ رَطبٍ","وَلَيالٍ فيها طِوالٍ قِصارِ",23,"ر",1,0],["رَبعٌ خَلا مِن بَدرِهِ مَغناهُ","وَرَعَت بِهِ عينُ المَها الأَشباهُ",24,"ا",2,1],["رَبٌّ عَلَيهِ يَظَلُّ يَخطُبُ قائِماً","لِلناسِ يَشدَخُهُم بِمُلكٍ قَسوَرِ",25,"ر",1,0],["رَبْعٌ كأنَّ الرَّبيعَ ألبَسَه","غَرائبَ النَّوْرِ يانعاً خَضَدُه",26,"د",2,0],["رُبَّ عَيشٍ لِأُناسٍ سَلَفوا","كانَ ثُمَّ انقَرَضوا وَانقَرَضا",27,"ض",2,0],["ربِّ عفواً لحيرتي وارتيابي","وسؤالٍ في جانحي يتردّد",28,"د",1,0],["رُبَّ عينٍ دهشتْ وقدْ","نسيتُ في خدِّهِ إنسانَها",29,"ه",2,0],["رُبَّ عينٍ تتمنى رؤيتي","وزكيٍّ بحياتي يحلفُ",30,"ف",1,0],["رُبَّ عينٍ دُهِشَتْ منهُ فَقَدْ","نسيتْ في خدِّهِ إنسانها",31,"ه",2,0],["رَبعَةٌ أَو فُوَيقَ ذاكَ قَليلاً","وَنَؤُومُ الضُحى وَحَقُّ كَسولِ",32,"ل",1,0],["رَبعٌ لِهِندٍ مُقفِرٌ","قَد كانَ حيناً يُؤهَلُ",33,"ل",1,0],["رَبعٌ لِهِندٍ قَد عَفا","قَد كانَ حيناً يُعمَرُ",34,"ر",1,0],["رَبِّ عُلِّقتُها تُجَدِّدُ هَجري","ذاكَ وَاللَهِ مِن شَقاوَةِ جَدّي",35,"د",2,0],["رَب عَفواً إِن راعَنا فَقدُ نَدب","ضاحك الوَجه في قُطوب الزَمان",36,"ن",1,0],["رُبَّ عُذرٍ حُلوٍ أَبَيتُم وَعِبتُم","وَوَفاءٍ مُرٍّ صَبَرتُم عَلَيهِ",37,"ي",2,0],["رُبَّ عَيْنٍ تَفَلْتَ في مائها المِلْ","حِ فأضْحَى وَهْوَ الفُراتُ الرَّوَاءُ",38,"ا",2,0],["رَبعُ البَلى أَخرَسُ عِمّيتُ","مُستَلَبُ المَنطِقِ سِكّيتُ",39,"ت",1,1],["رُبَّ عَيشٍ عِندَنا عِشنا بِهِ","وَنَعيمٍ لَو خَلَدنا خَلَدا",40,"د",2,0],["رُبْعُه إن أَضَفْتَهُ لكَ منهُ","نِصْفُهُ إن حَسَبْتَهُ عن تمامِ",41,"م",1,0],["رب عَذراء لست تسمع منها","عند تحديثها سوى الزفرات",42,"ت",1,0],["رُبَّ عِرْضٍ دَبَّ الشَّقَاءُ إِلَيْهِ","وَمَشَى السُّوءُ خَلْفَهُ يَرْتادُ",43,"د",1,0],["رُبَّ عَارٍ بِقروحٍ يَكْتَسِي","وَبتولٍ تحْتَ سِتْرِ الْوِهْجِ تَعْرِى",44,"ر",2,0],["رَبِّ عُض وَاِجبُر مَهيضاً","ضَمَّ مِنهُ القَبرُ عُضوا",45,"و",2,0],["رُبَّ عيرٍ يَتَسَمّى صاهِلاً","فَإِذا صَوَّتَ قالوا قَد نَهَق",46,"ق",1,0],["رَبعٍ لِرَخصِ البِنانِ مُختَضِبٍ","طوبى لِمَن باتَ وَهوَ يَلتَثِمُه",47,"م",2,0],["ربعٌ تساوي بسطح الأرض شاهقه","قد صوَّح النبتُ فيه، واختفى الشجر",48,"ر",1,0],["ربَّ عبلِ الذراعِ أنحت عليه","لُجَجٌ ما له يهنَّ يدان",49,"ن",1,0],["رَبْعاً لواضِحَة ِ الجَبِينِ غَريرَة","ٍ كالشَّمسِ إذا طلعَتْ رَخيمِ المنطِقِ",50,"ق",1,0],["رُبَّ عامٍ أَنت فيه واجدٌ","فادَّخرْ فيه لعامٍ لا تجِدْ",51,"د",1,0],["رُبَّ عِشَارٍ سَوْفَ يَغْتَالُهَا","لا مبطىء ُ السَّيرِ ولا عائجُ",52,"ج",1,0],["ربع أُجرت الدموع بنحرِى","واستثارت بلابلاً وهموما",53,"م",2,0],["رَبعُ أسمَاءَ ِإذ هِي الأُنسُ آلا","مُقفِرَ الآيِ لا يُرُدُّ سُؤَالا",54,"ل",2,1],["رُبَّ عزمٍ إ يُحَكَّمْ له لم","تجد الأقدارُ عنه مَناصا",55,"ص",2,0],["رَبَعنا بِالكُلابِ وَما رَبَعتُم","وَأَنهَبنا الهَجائِنَ بِالصَّعيدِ",56,"د",1,1],["رَبعٌ إِذا رَبَعَت إِلَيهِ قَبيلَةٌ","عَلقَت بِحَبلٍ مِن غِنىً وَأَمانِ",57,"ن",1,0],["رَبِّ عَفواً لَقَد فَقَدتُ شُعوري","فَشُعوري يَهيمُ في تيهانِه",58,"ن",2,0],["رُبَّ عظَّمتهن النصارى ولم أزل","أعرّس باللذات فيهنّ تعرِيسا",59,"س",2,0],["ربعاً به غرر العلى مبذولة","للمشتري واللاري للمشتار",60,"ر",1,0],["ربع يجود على العفاة برفده","وبه يغاث العائذ المستصرخ",61,"خ",1,0],["ربع المنى بمنى نعمت صباحاً","وتبلجت فيك الوجوه صباحاً",62,"ح",2,1],["رَبْعُ الْمَوَدَّةِ بِالْحَشَا مَأْنُوسُ","بِهَوَى الأَحِبَّةِ مَا عَرَاهُ دُرُوسُ",63,"س",1,1],["ربع أسماء لا عداك عنان","فلكم قادني إليك عنان",64,"ن",1,1],["رُبَّ عمٍّ لي لو أَبصَرتَهُ","حَسَنِ المِشيَةِ في الدّرعِ الزعَف",65,"ف",1,1],["رب عليك اعتمادي","كما إليك استنادي",66,"ي",1,0],["رَبِّ عامِلنا بِلُطفِكَ وَاِكفِنا","بِجودِكَ وَاِعصِمنا مِنَ الزيغِ وَالفِتَنِ",67,"ن",1,0],["رُبَّ عُرْفٍ ما زالَ يَحمِلُ عنه الرْ","ركْبُ ذِكْراً كأنّه المِسْكُ عَرفا",68,"ف",2,0],["رَبْعٌ وقفْتُ به والسّمعُ مُرتَنِقٌ","عنِ الملامِ هوىً والدّمعُ مدرار",69,"ر",1,0],["ربْعٌ وقَفْتُ أرى وجوهَ أحِبّتي","فيه بعَيْنَيْ ذِكْريَ المُتَجَدّد",70,"د",1,0],["ربَّ عِتاقٍ ضمَّرٍ قادَها","حقدٌ له في النَّفس إضمارُ",71,"ر",1,0],["ربٌ عظيمٌ عزيز في الأنامِ يجي","في حلّة الجسمِ من بكرٍ وهوْ نارُ",72,"ر",1,1],["ربع التهاني بالمسرة زاهي","لما بدا بدر الجمال الباهي",73,"ا",3,1],["ربع يتثنى الغصن به","طربا لمغردة النغم",74,"م",1,0],["ربْعُهُ الكعبةُ التي افترضَ السُؤ","دَدَ حجّى لركنِها وطَوافي",75,"ف",2,0],["ربعٌ لبستُ به التصابي مَعلماً","ورفلتُ في المَسحوبِ من أردانِه",76,"ن",2,0],["ربْعٌ أيادي الرياحِ الهوجِ تهدِمُه","والحبُّ بين ضلوعِ الصّبِّ يَبْنيهِ",77,"ي",2,0],["رب عيش لما تذكرته في","ك غدت نحوه النفوس ظماء",78,"ا",2,0],["ربع يروح القلب فيه مروحا","والشوق نحو لقائه يتزيّد",79,"د",1,0],["ربع من الملك معمور وأفنية","بها العلا والندى والبأس والجلد",80,"د",1,0],["ربعا بسفح المصلى","واديه أطيب وادي",81,"د",2,0],["ربعية الوشي لا ينفكُّ زِبْرجها","يجلو لنا من حُلاها أحسنَ الصور",82,"ر",1,0],["رب عيش أخف منه الحمام","هو عيش يفر منه الحمام",83,"م",1,0],["ربعُ همّي عليهمُ طلَلٌ با","قٍ وتَبلى الهمومُ والأطلالُ",84,"ل",1,0],["ربَعيٌّ من بني جُشَمٍ","كل بيتٍ منه خفَّانُ",85,"ن",1,1],["ربعٌ صحبت به الشباب فلم يحلْ","للقرب مربعهُ ولا مصطافه",86,"ف",2,0],["ربعٌ ينوحُ على سكانهِ فاِذا","ما كظّهُ الشوقُ في أطلالهِ انتحبا",87,"ب",2,0],["ربعٌ وقفتُ عليه بعدَ أهليهِ","أسقيهِ مِنْ عَبَراتي ما يُروِّيهِ",88,"ي",2,1],["ربعٌ كانتِ الليلاتُ وهي ضحًى","بطيبِ عيشٍ قطعنا في ضواحيهِ",88,"ي",2,0],["ربعٌ نُواحي عليه قبلَ بينهمُ","قد كان قالَنواهمْ في نواحيهِ",88,"ي",2,0],["ربعٌ بلغتُ به نهاياتِ المنى","والقومُ لي قبلَ الرحيلِ جِوارُ",89,"ر",1,0],["رُبَّ عينٍ قد لفتْناها إلى","ذي انْكِسارٍ وهو المُنْجَبِرُ",90,"ر",1,0],["رُبُعُ العُمْرِ بالصِّبا قَدْ تَقَضَّى","وَيَلِيهِ رُبْعق بِرَبْعِ العُلُومِ",91,"م",1,1],["رَبَعَتْ مُذْ نفضتَ كفَّكَ منها","بين حقٍّ ثاوٍ وحقٍّ مضاعِ",92,"ع",1,0],["رَبعٌ إليهِ قُلوبُ النَّاسِ ظامِئَةٌ","من وَجْدِها وَهْوَ بالأنواءِ رَيَّانُ",93,"ن",1,0],["رَبعٌ هو الفَلَكُ الأعلَى فقد طَلَعتْ","فيهِ النُجومُ اللواتي تَصدَعُ الغَسقَا",94,"ق",2,0],["رَبعٌ يَسُرُّ الناظرينَ بحُسنهِ","ويُبشِّرُ العافي بُحسنِ نَجاحِهِ",95,"ح",2,0],["رَبْعٌ صَرَفْتُ العَينَ عنهُ أشهُراً","والقلبُ عنهُ ساعةً لا يُصرَفُ",96,"ف",1,0],["رَبعٌ كَستْه كلُّ غاديةٍ كما","تُكْسَى الوُفودُ بهِ طِرازاً مُعلَما",97,"م",2,0],["رَبعٌ وَقَفتُ منادياً أطلالَهُ","فبَلِيتُ حتى صِرتُ من أطلالِهِ",98,"ل",2,0],["رَبْعٌ تعفَّى فأعفى من جوى وَأَسى","قلبي وكان إلى اللَّذّات مُنقلَبِ",99,"ب",1,0],["رَبْعٌ قَطَعْتُ به اللَّيالي وَاصِلاً","خَمْرَ اللذاذةِ والهَوَى بِخُمارِ",100,"ر",1,0],["رَبعَةُ قَدُّهُ قَوِيٌّ عَريضُ","مَنكِباهُ وَأَذرُعٌ فَتَلاءُ",101,"ا",2,0],["ربعٌ كَربعِ اِصطِباري بَعدَ أَن رَحَلوا","تَجاوزَ اللَهُ عَنهُ قَد خَلا وَعَفا",102,"ف",2,0],["رب عوراء قد تعشقها المغر","ور حتى يقال قال بديها",103,"ي",3,0],["ربعنا بالكلاب وما ربعتم","وأنهينا الهجائن بالصعيد",104,"د",1,1],["ربعية حلت بأكناف الحشا","ودموعها