{"poems":[[215,"صورة ما أراه أم ذاك حلم","https://www.aldiwan.net/poem46762.html","الخفيف"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83231","الكامل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83229","الكامل"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107058","الكامل"],[3115,"","https://poetry.dctabudhabi.ae/diwan/poem/216339",""]],"verses":[["إني أزلزل أكبادي لأذكركم","إن كان لي بعد ذاك الغدر أكباد",0,"د",1,0],["إنّي أَزُفُّ إِلَيكَ دُرّاً صُغتُهُ","مِن رَوضِ شِعري حافِلاً بِثَنائي",1,"ا",2,0],["إِنّي أَزُفُّ وَقَد عَلاني واجِبٌ","ما عِشتُ تَهنِئَتي لِأَهلِ الوادي",2,"د",2,0],["اني أزف من القريض قصائداً","ببديع مدحك لا البديع تنمنم",3,"م",1,0],["إن ياز منها عمل والاّ تركناها","حياةٍ مثل ما لوّل انجزّيها",4,"ي",3,0]]}