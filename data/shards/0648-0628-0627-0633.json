://www.poetsgate.com/ViewPoem.aspx?id=155244",""],[5596,"لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=206694",""],[5776,"عامُ الأبابيلِ اليمانية...","https://www.poetsgate.com/ViewPoem.aspx?id=203647",""],[402,"دعا الوفاء وهذا وقت تبيان","https://www.poetsgate.com/ViewPoem.aspx?id=36473",""],[402,"أبقى ويرفض حولي عقد خلاني","https://www.poetsgate.com/ViewPoem.aspx?id=36429",""],[6142,"بسطت لشبك المرتضى راحة السؤل","https://www.poetsgate.com/ViewPoem.aspx?id=155757",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[6270,"لنا حجرٌ ودون الموت صدرٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69080&r=&rc=4",""]],"verses":[["وَبِأُسرَةٍ مِن هاشِمٍ","غَدَروا بِرَبّاتِ الخُدورِ",0,"ر",1,0],["وَباسِمٍ وَالجِيادُ عابِسَةٌ","وَالبِيضُ مُحْمَرَّةُ الظُّبا بِدَمِ",1,"م",1,0],["وبأسُ طَلْحَةَ في إقْدامِ أحْمَدَ إذْ","وشَتْ بسرِّ المَنايا البيضُ والسُّمُرُ",2,"ر",1,0],["وبأسٌ غَدا يرْتاعُ منْ خوْفِهِ الرّدى","وترْفُلُ في أثْوابِهِ الفَتْكَةُ البِكْرُ",3,"ر",1,0],["وباسمك تم للاسلام سلم","وغلب السلم نصر مستدام",4,"م",1,0],["وَبِاسْمِ آلافِ أَطْفَالٍ تُقَوِّمُهُمْ","عَلَى مَبَادئِ تَهْذِيبٍ وَإيْمانِ",5,"ن",1,0],["وَبِاسْمِ شَتَّى جَمَاعَاتٍ تُؤَازِرُهَا","عَلَى تَبَايُنِ أجْنَاسٍ وَأدْيَانِ",5,"ن",1,0],["وَبِاسْمِ آلافِ أَطْفَالٍ تُقَوِّمُهُمْ","عَلَى مَبَادِيءِ تَهْذِيبٍ وَعِرْفَانِ",6,"ن",1,0],["وَبِاسْمِ أَرْبَابِ عِيلاتٍ عَصَمْتَهُمُ","مِنَ افْتِضَاحٍ بَبَدْلٍ طَيَّ كِتْمَانِ",6,"ن",1,0],["وَبِاسْمِ طَائِفَةٍ كُنْتَ العَمِيدَ لَهَا","وَكُنْتَ حِصْناً لَهَا مِنْ كُلِّ عُدْوَانِ",6,"ن",1,0],["وَبِاسْمِ مَنْ لا يَكَادُ العَدُّ يَحْصُرُهُمْ","فِي مِصْرَ وَالشَّرْقِ مِنْ صَحْبٍ وَأَخْدَانِ",6,"ن",1,0],["وَباسِطَ خَيرٍ فيكُمُ بِيَمينِهِ","وَقابِضَ شَرٍّ عَنكُمُ بِشَمالِيا",7,"ي",2,0],["وباسطٍ يدهُ حكماً ومقدِرَةً","ووارِد الموت أدنى من فمٍ ليدِ",8,"د",1,0],["وبأسٌ يذيب الصخر لكن وراءه","عواطفُ من أحلامهِ حين يقدر",9,"ر",1,0],["وباسمك في الدنيا استقرّت محاسنٌ","وبأسٌ كما يمضي القضاء محتما",10,"م",2,0],["وبأس تبيت عيون الجرا","ح لهيبته في الوغى داميه",11,"ي",2,0],["وبأس ينزل الأجبال أرضا","ويركبها إلى الهيجا متونا",12,"ن",2,0],["وَباسِقَةٍ مِن بَناتِ الرِمالِ","نَمَت وَرَبَت في ظِلالِ الكُثُب",13,"ب",1,0],["وباسطُ الباعِ يَسقِي الغيثُ رِمَّتَه","قبلَ الأنامِ إذا ما فاضَ فانسجَما",14,"م",2,0],["وباسطٌ يَدَه بالعُرْفِ مُطلِقُها","بالحَتْفِ يُنعِمُ أحياناً وَينتَقمُ",15,"م",1,0],["وَبَأسُ مُلكٍ مَجدُهُ مِن عامِرٍ","وَفَيضُ جودِ كَفِّهِ مِن أَجوَدِ",16,"د",1,0],["وباسمِكَ تدعوهُ الأعادي فإنْهُمْ","يُقِرّونَ حَتْماً والمُرادُ جُحود",17,"د",1,0],["وباستك إذ خلفتني خلف شاعرٍ","من الناس لم أكفىء ولم أتنحّل",18,"ل",1,1],["وباسمكَ أيها الملكُ المفدّى","تَقَشَّعُ غُمَّةٌ ويزولُ كَرْبُ",19,"ب",1,0],["وباسمكَ لا يُضامُ لمصرَ حَقٌّ","وباسمكَ لا يُضارُ بمصرَ شَعْبُ",19,"ب",1,0],["وباسمكَ من عُضالِ الداءِ تُشْفَى","وباسمكَ كلُّ داءٍ يُسْتطبُّ",19,"ب",1,0],["وباسط اليمين والشمال","وتعرف الرجال عند المال",20,"ل",1,0],["وباسمه كم تاجر الفساق","وانقادت الناس لهم فساقوا",21,"ق",3,0],["وباسم الحنيفةِ سادوا؛ فكانَ","سواهم سُفوحًا، وكانوا الذُّرا",22,"ر",2,0],["وبأس حيدري موسوي","أذاق عدوه حر الحريق",23,"ق",1,0],["وباسمه تبرم القصيد","أمترف معاشه رغيد",24,"د",1,0],["وبأس لجبار وبشر لبائس","ولين لمستجْدٍ وقهر لمعتدِ",25,"د",1,0],["وَبَأسٌ كَبا عامِرٌ دونَهُ","وَقَصَّرَ عَنهُ اِبنُ مَعدي كَرِب",26,"ب",1,0],["وبأسٌ هل لمحت النَّار","لا تبقى ولا تذر",27,"ر",1,0],["وَبَأساً يُشابُ السُخطُ مِنهُ بِرَأفَةٍ","فَشِدَّتُهُ مَمزوجَةٌ بِلَيانِ",28,"ن",1,0],["وباسمك السامي السماك الأسمى","وكلّ رسمٍ أبرزته الأسما",29,"م",2,0],["وبأس لدى البأساء في كل حادث","به يسكن الدأماء ما ازعج الصخرا",30,"ر",2,0],["وبأس إذا لاقيته وهو اعزل","توهمته ينضى الصفيح المهندا",31,"د",2,0],["وباسيه هكذا في الفضل والفصل محسناً","فأحرز في الحالين حسن التناسب",32,"ب",1,0],["وَبأسٌ قَد تألّف فيه حلمٌ","كَما سُمَّ الحسامُ وراقَ صَقلا",33,"ل",2,0],["وبأسرار لطف قل يا عبادي","توّجوني وبالرضا جمّلوني",34,"ي",1,0],["وَبِإِسرِ إِسرائيلَ لي فيهِ آلِهِ","أَمسَيتُ في أَهلِ الهَوى مُتَرَتَّبا",35,"ب",2,0],["وَبِاِسمِ وَجدي مِن شَرِّ الغُواةِ عُذِ","وَاِصحَب لِمَن بِلَبّانِ الواجِدينَ غُذي",36,"ي",1,0],["وَباسِطاً يَدَ جودٍ بَعض أُنمُلَةٍ","مِنها يَنوبُ عَن الأَنواءِ وَالسُحُبِ",37,"ب",1,0],["وبأسكَ لا البيض الصوارم والقنا","وجودك لا ما تستهلُّ السحائبُ",38,"ب",1,0],["وبأسك لا أن صال عمروا وعامر","وجودك لا صوب من الغيثِ مغدِق",39,"ق",1,0],["وبأسٌ لَوِ استعطى الكماةُ فُضُولَهُ","لقُدَّ لهُم منه سيوفٌ وأرماحُ",40,"ح",1,0],["وبأْسٍ هل يُجيرُ الدهرُ منه","بعيدَ الشَّأْوِ أَوْ صعبَ المُرَامِ",41,"م",1,0],["وباسْمِكَ عَزَّتْ فِي الخِطابِ مَنابِرٌ","بأَسْعَدِ عِيدٍ عادَ بالسَّعْدِ أَوْ فِطْرِ",42,"ر",1,0],["وباسم العشب حولي في تفاؤله","رغم الهجير خيالاتي ومرآتي",43,"ت",2,0],["وباسم الوزير فعذ بالوزي","ر يُفتَح بابُ الندى المغلَقُ",44,"ق",1,0],["وباس حسام الدين إذْ حدُّ بأسه","جريءٌ إذا تنْبو الصَّوارمُ قاصلُ",45,"ل",1,0],["وبأسكَ غالبٌ حَدَّ المواضي","وجودكَ فاضلٌ صوبَ الغمامِ",46,"م",1,0],["وباسِمُ ثَغْرٍ والخُطوبُ كوالحٌ","وعن كلِّ فُحشٍ معْرضٌ وقطوب",47,"ب",1,0],["وباسم شمتُ في الظلماء بارقة","وغلَّةُ القلب في شؤبوبه البردِ",48,"د",1,1],["وباسمٍهٍ استسقى حَيَا الوسمي","ما ضرَّهُ هجو الخوارزميِّ",49,"ي",1,0],["وبأَسماعهمْ جرى فَرْطُ تقري","ظك والفَهمُ شافعٌ للسَّماعِ",50,"ع",1,0],["وباسم الله سافرنا","وعُدنا باسمهِ الأعظمْ",51,"م",1,0],["وباسْمِكَ قد حَلَّ فوق السَّما","ولولاكَ لَم يَسْمُ بل لم يُسَمْ",52,"م",1,0],["وباسْمِك من قبلِ الوغَى تُهزَمُ العِدا","وباسْمك قَبْل الحرْب تُنْصَرُ بالرُّعْب",53,"ب",1,0],["وباسليوسُ خلف خير شهم","هو المفضال والمحسان مكسبي",54,"س",3,0],["وَبِأَسيافِهِ طَرابُلسَ الغَربَ","أُجيرَت وَبُرقَةَ الحَمراءُ",55,"ا",2,0],["وَباسمي صارَ طالعها سَعيداً","وَقَد نالَت بِهِ شَأواً عَليا",56,"ي",2,0],["وَباسم اللَه قَبل الحَمد فَاِبدَأ","كَما أَمر النَبيّ بِهِ الخَبير",57,"ر",1,0],["وَبَأس شَديد في النِضال وَصَولة","عَلى كُل جَبار لَديد خصام",58,"م",1,0],["وَبَأس بِهِ أَوطانه عزَّ شَأنُها","وَذلَّ لَها في الحَرب كُلُّ عَنيد",59,"د",1,0],["وباسم أمير النيل لا باسم غيره","إذا زاد جيش أو تجدد أسطول",60,"ل",1,0],["وَباِسْمِكَ المَغرُورِ قَدْ","أَمْضَيْتَ فِيهِ مُوَقِّعَا",61,"ع",2,0],["وبأس فلو ترمي به جلمد الصفا","تداعى ولا يقوى له جنب جلمد",62,"د",1,0],["وباسمه فاز ذو النون التقي ونجا","من بطن حوت له في البحر توغيل",63,"ل",1,0],["وباسمه طار إلياس وصار من ال","أملاك حيث جناح العز مسدول",63,"ل",1,0],["وباسمه لاذ أيوب الرضا فشفى","من ضر جسم له في العظم تنخيل",63,"ل",1,0],["وباسمه اليسع البر التجى فنجا","وللعزيز بذاك الإسم تمثيل",63,"ل",1,0],["وباسمه زكريا استغاث فلم","يرهب لنشر له في العضو تفصيل",63,"ل",1,0],["وباسمه قرن الله اسمه فزكا","فضلا على كل خلق فيه تفضيل",63,"ل",1,0],["وباسمك الأعلى المعظم في العلى","يا حي يا قيوم اصرف باسي",64,"س",2,0],["وبأسنا محصوله قليل","منه لسان فخرنا كليل",65,"ل",1,0],["وباسمه اليمُّ صَار مُنْفَلِقَا","فجازَ موسى ومَنْ به اعتَصَما",66,"م",2,0],["وباسمك يا متعال أشدو مرتلاً","وفيه بتهليلي أذيع مبشرا",67,"ر",2,0],["وبَأْسُكَ يُعْدينا لِنَقْتَحِمَ الوَغَى","وأَنْتَ الذي لو أَنَّهُ وَحْدَهُ أَغْنَى",68,"ن",2,0],["وَبَأسُهُ في دِيار الكُفر صاعِقَةٌ","فِيها لِحِزبِ ذَوي الأَهواء تَنكيلُ",69,"ل",1,0],["وباستقرّ خصّ منويّ الصّله","لانّها من جملة محصّله",70,"ه",1,0],["وباسمك قد نادى الخليل فلم يخف","من النار هولا وهو في النار واقع",71,"ع",1,0],["وباستعين برَبٍ انشاكم","بالخلَف عَنكم يا مَضنونا",72,"ن",2,0],["وباسمك رب العالمين ومن يعذ","معاذي يوق المرديات الهواديا",73,"ي",2,0],["وبأساً يبيد الدهر رعباً وهمةً","تقود بها الأقدار إن أحجمت قسرا",74,"ر",2,0],["وبأس الكُماة وإقدامها","وحُلم الكفاة وإحسانها",75,"ن",3,0],["وبأسٍ بلا عجبٍ ونفع بلا أذىً","وبذل بلا منُّ ووعدٍ بلا مطلِ",76,"ل",1,0],["وبأس وبطش يحميان \"حمى الهدى\"","فحتى \"لقد ت\"لفى مع السرح أسْدُه",77,"د",2,0],["وبأسك ان يقطب منه وجها","فعندك عند رؤياه انشراح",78,"ح",1,0],["وبأسٌ في الكريهة حين نلقى","إذا كان النذير بها الحسام",79,"م",1,0],["وَبِاسْمِه أرَّخْتُهُ","زَكَا بِهِ البَاشَا عَلِي",80,"ل",2,0],["وباسمك الله العظيم الاعظم","تنمى له الاسما وليس ينتمى",81,"م",2,0],["وبأسرةٍ من آل جعفرٍ كلهم","أمسوا لمعروف الندى أربابا",82,"ب",2,0],["وبأس الحتوف ومقري الضيوف","ومنع المخوف ومعطي السؤولا",83,"ل",2