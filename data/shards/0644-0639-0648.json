{"poems":[[3,"لعوب بألباب الرجال كأنه","https://www.aldiwan.net/poem154.html",""],[52,"لعمر أبي زوارها الصيد إنهم","https://www.aldiwan.net/poem62348.html","الطويل"],[52,"أبا كرب كلني لهم المجاهد","https://www.aldiwan.net/poem63946.html","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9922","الطويل"],[113,"يروحي بل بآبائي الكرام","https://www.aldiwan.net/poem16392.html","الوافر"],[302,"أفي كل ربع للمطي بنا وقف","https://www.aldiwan.net/poem33218.html","الطويل"],[567,"أتتنا وهي سافرة الجبين","https://www.aldiwan.net/poem52938.html","الوافر"],[567,"مدامع جفن الصب إحدى الفواضح","https://www.aldiwan.net/poem52955.html","الطويل"],[572,"غدر الزمان وجار في أحكامه","https://www.aldiwan.net/poem69653.html","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108628","الوافر"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125445","الطويل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106896","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100325","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200044",""],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68017","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48312","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59462","المتقارب"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90952","الطويل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136381",""],[4859,"إدلب","https://www.poetsgate.com/ViewPoem.aspx?id=208582",""],[5121,"سَكِر الكَرَى","https://www.poetsgate.com/ViewPoem.aspx?id=33596",""],[5431,"أدمعيَ لُجّةٌ والشوقُ موجُ","https://www.poetsgate.com/ViewPoem.aspx?id=191648",""],[5939,"أنا فيها","https://www.poetsgate.com/ViewPoem.aspx?id=156540",""]],"verses":[["لَعوبُ بِأَلبابِ الرِجالِ كَأَنَّه","إِذا أَسفَرَت بَدرٌ بَدا في المَحاشِدِ",0,"د",1,1],["لَعوبٌ بِأَلبابِ الرِجالِ وَإِن دَنَت","أُطيعَ التُقى وَالغَيُّ غَيرُ مُطاعِ",1,"ع",1,0],["لَعوبٍ بِأَلبابِ الرِجالِ كَأَنَّها","إِذا سَفَرَت بَدرٌ بَدا في المَجاسِدِ",2,"د",1,0],["لَعوبُ بِأَلبابِ الرِجالِ كَأَنَّها","إِذا أَسفَرَت بَدرٌ بَدا في المَحاشِدِ",3,"د",1,1],["لَعوب بِإِصطِبار أَخى شُجون","طَليق الدَمع مَأثور الهيام",4,"م",1,0],["لعوبٌ إِذا عاطتكَ لهوَ حديثها","ثملتَ وما دارَت معتَّقةٌ صِرفُ",5,"ف",1,0],["لَعُوبٌ بالقُلُوبِ تَحِلُّ فيها","فَتنزلُ مَنزلَ السِرِّ المَصُونِ",6,"ن",1,0],["لَعُوبٌ بأطراف الكلام على الصِّبا","رأيتُ بهِ الممدوحَ في ثوبِ مادحِ",7,"ح",1,0],["لعوْنُ الغَمَامَةِ وَالْغَمَامَةُ لَوْنُهُ","وَمُنَاسِبُ الأَقْلاَمِ بِالْمِنْقَارِ",8,"ر",1,0],["لعوبٌ في فكاهتها مجونٌ","إذا سمرت ألذ من الثمار",9,"ر",1,0],["لعوبٌ لها من باهر الحسن طلعةٌ","إذا أشرقت أبصرتُ غُصناً تأَوَّدا",10,"د",2,0],["لعوباً بأسرار الوجود كأنما","يطلُّ عليها ناظري المتوسم",11,"م",1,0],["لعوب بالباب الرجال ولم يكن","حوى او حوى في العمر عشراً واربعا",12,"ع",2,0],["لعوالم البحر التي","فارقتها أتوهم",13,"م",1,0],["لَعوبٌ بسهم الغُنْجِ تَرشَقُ مهجتي","فأدنو وسهمُ البين يَحْنِي أَضالِعي",14,"ع",2,0],["لعَواليهِ في المَعالي حَديثٌ","صحّ إسْنادُهُ لأيْدي الفَوارِسْ",15,"س",1,0],["لَعوبٍ خلوبٍ تصيدُ الكِرامَ","وتسبي الحليم فَلم يُبصَرِ",16,"ر",1,0],["لعوب كما الصهبا بالباب أهلها","تروح بهم طورا وطوبا بهم تغدو",17,"د",2,0],["لعودة شاهنا الشهم المسمى بعبد","للعزيز من المسير",18,"ر",1,0],["‏لعويل(إدلب) تصرخ القدس","وتقول تفدي(إدلبي) النفس",19,"س",1,1],["لعواقب ِالزّمن ِالأسير ِضحيّة ٌ","سُجنتْ بقلبِ خريفِها فتهدَّما",20,"م",2,0],["لعوبٌ ليسَ يردعها احتراقٌ","ولا دمعٌ ولا للحبِ نهجُ",21,"ج",1,0],["لَعوبٌ وتَسْهو عن iiسَفِيهيها","وتَسْفِي المُنَى فيها iiسَوافيها",22,"ي",3,0]]}