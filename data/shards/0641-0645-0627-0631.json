 رِمْتَ حتّى وَلْجَتْ الصَّميمَ","وغادرتَ ما عزّ منها ذليلا",180,"ل",2,0],["فَما رمْتَ حتّى الطّيرُ تعترِقُ الطُّلى","وَحتّى جَبينُ التُّربِ بالدّمِ راشحُ",181,"ح",1,0],["فَما ردها فينا السباء وضيعة","ولا عريت فينا ولا طبخت قدرا",182,"ر",2,0],["فما رأَيْتُ حيَّةً","إِلاَّ رَأَيْتُ عَقْربَا",183,"ب",2,0],["فما رقأَتْ دموعي حين غابت","جواسقُها ولا اندملت كُلومي",184,"م",2,0]]}