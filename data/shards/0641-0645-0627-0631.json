الوافر"],[459,"أمرتكم أمري بنعمان ناصحا","https://www.aldiwan.net/poem56253.html","الطويل"],[459,"خصيماي من ظمياء واش وشامت","https://www.aldiwan.net/poem56262.html","الطويل"],[459,"إذا عم صحراء الغمير جدوبها","https://www.aldiwan.net/poem56293.html","الطويل"],[462,"هنيئا لأيام الزمان حلالها ال","https://www.aldiwan.net/poem15357.html","الطويل"],[465,"نعم نفحة الوادي التي تتأرج","https://www.aldiwan.net/poem3143.html","عموديه"],[465,"ألمت نع الظلماء يهدى سلامها","https://www.aldiwan.net/poem3195.html","عموديه"],[469,"وأكياس من الكاسات ملأى","https://www.aldiwan.net/poem60421.html","الوافر"],[478,"ربع وقفت عليه بعد أهليه","https://www.aldiwan.net/poem15251.html","البسيط"],[511,"أحبابنا ما زال داعي النوى","https://www.aldiwan.net/poem1588.html",""],[516,"هل القلب إلا مضغة تتقلب","https://www.aldiwan.net/poem12016.html","الطويل"],[552,"رقدت وأسهرت ليلا طويلا","https://www.aldiwan.net/poem47320.html","المتقارب"],[552,"سل الجزع أين المنزل المتنازح","https://www.aldiwan.net/poem47904.html","الطويل"],[570,"ونار دعوت المعتفين بضوئها","https://www.aldiwan.net/poem52006.html","الطويل"],[576,"لقد لقيت نصباً","https://www.aldiwan.net/poem2747.html","مجزوء الرجز"],[586,"عروس الكأس يجلوها نديمي","https://www.aldiwan.net/poem1566.html",""]],"verses":[["فما راعني في صلحه وجه عابس","كما راعني وجه له بش قاطبه",0,"ب",2,0],["فَما رَكِبَ العُلى إِلّا عَلِيٌّ","وَمَسَّحَ عِطفَها بَعدَ الحِرانِ",1,"ن",1,0],["فما رَعَتِ القُرْبى قُرَيْشٌ ولا اتّقَتْ","عِتابي ولمْ يَكْسِفْ لذلك بالي",2,"ل",2,0],["فَما راعَني إلا الخَيالُ وعَتْبُهُ","وفَجْرٌ نَضا بُرْدَ الظّلامِ ابتِسامُهُ",3,"م",2,0],["فما راعَنا إلا الصّباحُ كَما بَدا","مِنَ الغِمْدِ حَدُّ الهِنْدوانِيِّ ذي الأَثْرِ",4,"ر",1,0],["فما راعَهُمْ جَرْسُ الخَلاخيلِ والبُرى","ولا زالَ رُعْباً عنْ مَعاقِدِها الخُمْرُ",5,"ر",1,0],["فَما روْضَةٌ بالغَوْرِ عاهَدَها الحَيا","وحُلّتْ حُبا الأنْواءِ في ذلكَ العِقْدِ",6,"د",1,0],["فَما راحَةٌ إِلّا لَها فيهِ راحَةٌ","كَأَنَّ قَفاهُ مَشهَدُ الكَفِّ لِلكَفِّ",7,"ف",1,0],["فَما رَأَينا إِماماً قَبلَ رُؤيَتِهِ","يَرى النَوافِلَ فَرضاً فِعلُها يَجِبُ",8,"ب",1,0],["فَما رَوضَةٌ بِالحَزنِ طَيِّبَةَ الزَرع","يَمُجُّ النَدى جَثجاثُها وَعَرارُها",9,"ر",3,0],["فَما رحِمتِ المال فِي حرْبِهِما","وَمَا ادَّخَرْتِ عَزمَكِ القَوِيَّا",10,"ي",2,0],["فَمَا رَمَى عَنْ قَوْسِهِ حَادِثٌ","فِي بَلَدٍ إِلاَّ وَقَلْبِي رُمِي",11,"م",2,0],["فَما رَوضَةٌ مِن حُرِّ نَجدٍ تَهَلَّلَت","عَلَيها سَماءٌ لَيلَةً وَالصَبا تَسري",12,"ر",2,0],["فما روضة غناء عاهدها الحيا","تحوك بها وشيَ الربيع يدُ القطرِ",13,"ر",1,0],["فمارضوه بسيل من مكايدهم","قد سال فاكتسح الآمال واجترفا",14,"ف",2,0],["فَما رَضيَت بِذِمَّتِكُم قُرَيشٌ","وَما بَعدَ الزُبَيرِ بِهِ اِغتِرارُ",15,"ر",1,0],["فَما رَحَلَت شَيبانُ إِلّا رَأَيتَها","إِماماً وَإِلّا سائِرُ الناسِ تابِعُ",16,"ع",1,0],["فَما رُزِقتَ فَإِنَّ اللَهَ جالِبُهُ","وَما حُرِمتَ فَما يَجري بِهِ القَدَرُ",17,"ر",1,0],["فَما رُمتُهُ حَتّى أَزَحتُ عَويصَهُ","وَحَتّى عَلاهُ حالِكُ اللَونِ أَسوَدُ",18,"د",1,0],["فَما رُمتُهُ حَتّى تَرَكتُ عَويصَهُ","بَقِيَّةَ عَرفٍ يَحفِزُ التُربَ مِذوَدِ",19,"د",1,0],["فَما رَفَعتُ البازَ حَتّى طارا","آخَرُ عوداً يُحسِنُ الفِرارا",20,"ر",2,0],["فَما راعَهُم غَيرُ مَعجِ الخُيولِ","وَالزَحفُ مِن خَلفِهِم قَد دَهَم",21,"م",1,0],["فما رفعت إلاَّ عليهِ بيوتها","ولا نصبتْ إلاَّ إليه فجاجها",22,"ج",3,0],["فما رأيه عن قاصديه بغافلٍ","وما طرفه عن وافديه بغاف",23,"ف",1,0],["فما رِفدُ عبد اللَّه والقَرْمِ طاهرٍ","سواي بقاضٍ عنك حقي الذي وجبْ",24,"ب",1,0],["فما رأيْنا مَرْتعاً مُجْدِباً","إلا وفيه راتعٌ جادبُ",25,"ب",1,0],["فَمَا رُمْتَهُ حتى اسْتَقَلَّ برأْسِهِ","مكانَ قَنَاةِ الظَّهْر أسْمَرُ أجْرَدُ",26,"د",1,0],["فما رَفَدوا ولا وعدوا","ولا اعتلّوا ولا اعتذروا",27,"ر",3,0],["فما رثى لخُضُوعي","لكنْ قسا وهو غضُّ",28,"ض",1,0],["فما رام حتى أقبلتْ بشراؤه","مع الفتح فوق الشاحجاتِ الصلادمِ",29,"م",1,0],["فَما راعَني وَاللَهِ إِلّا وُقوفُهُ","فَقد كُنتُ أَخشى أَن يُفاجِأُنا وَغدُ",30,"د",1,0],["فَما رَشَفتِ سِوى عِطرٍ وَلا اِنفَتَحَت","إِلّا عَلى الحَسنِ المَحبوبِ عَيناكِ",31,"ك",1,0],["فَما رَقَبتُمُ فينا جِواراً","وَلا حَفِظَت لَنا يَدُكُم ذِماما",32,"م",2,0],["فَما راعَني إِلّا رَخيمُ كَلامِها","تَقولُ حَبيبي قُلتُ أَهلاً وَمَرحَبا",33,"ب",2,0],["فَما رابَهُ إِلّا دَماثَةُ مَنطِقِ","وَأَنِّيَ مَزّاحُ اللِسانِ لَعوبُ",34,"ب",1,0],["فَما رَوِيَت حَتّى اِستَبانَ سُقاتُها","قُطوعاً لِمَحبوكٍ مِنَ الليفِ حادِرِ",35,"ر",1,0],["فَما رَوضَةٌ بِالحَزنِ صادٍ قَرارُها","نَحاهُ مِنَ الوَسمِيِّ أَو دِيَمٌ هُطلُ",36,"ل",1,0],["فَما راعَني إِلّا عَذارى أَجَرنَني","وَرُبَّ ضَعيفٍ تَحتَمي فَيُجيرُ",37,"ر",1,0],["فَما راعَني إِلّا نِساءٌ لَقَينَني","يُبالِغنَ في زَجري وَيُسرِفنَ في نَهري",38,"ر",2,0],["فَما رَأَيتُ في حَياتي أَزيَنا","لِلمَرءِ بَينَ الناسِ مِن حُسنِ الثَنا",39,"ن",2,0],["فما روضةٌ بالحَزْنِ شعشَعَ نَوْرَها","طليقُ العزالى مستهلُّ الهواضبِ",40,"ب",1,0],["فَما رِمتَ حَتّى أَجلَتِ الحَربُ عَن طُلاً","مُقَطَّعَةٍ فيهِم وَهامٍ مُطَيَّرِ",41,"ر",1,0],["فَما رَفَعَ التَصَفُّحُ مِنكَ طَرفاً","وَلا مالَت بِأَخدَعِكَ الضِياعُ",42,"ع",1,0],["فَما رَقَأَت دُموعُ العَينِ حَتّى","شَفى نَفسي الفِراقُ مِنَ التَلاقي",43,"ق",2,0],["فَما رَقَأَت دُموعي إِذ مَراها","تَرَقّى مُهجَتي عِندَ التَراقي",44,"ق",2,0],["فَما رُمتُ حَتّى ماتَ مَن كُنتُ خائِفاً","وَطومِنَ مِن نَفسِ الفَروقِ وَجيبُها",45,"ب",3,0],["فَما راعَهُم إِلّا كَتائِبُ أَصبَحَت","تَدوسُهُمُ حَتّى أُنيمَ حَصيدُها",46,"د",3,0],["فَما راعَهُم إِلّا أَسِنَّةُ مازِنٍ","يُديرُ قَناها بِالأَكُفِّ مُديرُها",47,"ر",3,0],["فَما رَفَعَ العَينَينِ حَتّى أَقامَهُ","وَعيدي كَأَنّي بِالسِلاحِ أُقاتِلُه",48,"ل",2,0],["فَما رِمتُمُ حَتّى لَقيتُم حِمامَكُم","وَآبَ مُوَلّوكُم فِراراً مِنَ القَتلِ",49,"ل",1,0],["فَما رَقَّ مِن شَكوايَ غَيرُ خُدودِهِ","وَلا لانَ مِن نَجوايَ غَيرُ قَوامِهِ",50,"م",2,0],["فَما رَقى تَحتَ الطُيورِ صاعِدٌ","إِلّا اِغتَدى بِها البَلاءُ نازِلا",51,"ل",2,0],["فما راحةٌ لا راحةٌ للندى بها","ومالٌ عليه البذلُ ضَرْبةَ لازمِ",52,"م",1,0],["فَمَا رَوْضَةٌ غَنَّاءُ بَاكَرَهَا الْحَيَا","بِأَوْطَفَ سَاجٍ أَشْعَلِ الْبَرْقِ سَاجِمِ",53,"م",1,0],["فما رأينا مَنْ وَلي","بفضةٍ إلا ذَهَبْ",54,"ب",1,0],["فما روضةٌ بالحزنِ باكرَها الحيا","يمجُّ خزاماها نداهُ وشيحُها",55,"ح",