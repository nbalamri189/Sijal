,0],["فَما راعَها الّا سُقوطُ قِناعِها","وطُرَّتُها في كَفِّ ريح الصَبا نَهبُ",128,"ب",1,0],["فَما رَسمٌ شَجاني قَد","مَحَت آياتِ رَسمَيهِ",129,"ي",2,1],["فَما رامَ حَتّى مَسَّتِ الشَمسُ جِلدَهُ","وَلانَت عَلى الحافي رُؤوسَ الحَزاوِر",130,"ر",1,0],["فَما رَقَدَ الوَلَدانُ حَتّى رَأَيتُهُ","عَلى البَكرِ يَمريهِ بِساقٍ وَحافِرِ",131,"ر",1,0],["فَمَا رَعَدَتْ فيهِ لِظَبْيٍ فَرائِصٌ","وَلا نَشَبَتْ فيهِ لِلَيْثَ مَخَالِبُ",132,"ب",1,0],["فَما رَأى ما قَد رَأَيتُ غَيرُ مَن","مِن وَحشَةِ الإِنسِ إِلى الجِنِّ فَر",133,"ر",1,0],["فما رد الإجابة لي ولكن","حماه النطق لي عي اللسان",134,"ن",1,0],["فما رأَيتُ ولا قَبْلي رأَى أَحَدٌ","كحُسْنها وهْيَ تَبْهَى وَسْطَ نَاديه",135,"ي",2,0],["فما رأتْ عَينُ خَلْقٍ قبلَ رُؤْيتِها","أقاحياً وشقيقاً ضَمَّها غُصُن",136,"ن",1,0],["فما رأيتُ كتاباً قبلَ رُؤْيَتِه","على تقادُمِ أَزْمانٍ وأَحْراس",137,"س",1,0],["فما رائعي واللّيلُ يَقْضِي ذماءه","من الصُّبحِ إلاّ نَفثةٌ تُبطِلُ السِّحرا",138,"ر",2,0],["فما رأيُك فِيها أف","تِنا يَرحَمُكَ اللَّهُ",139,"ه",1,0],["فما رغبت لدار الخلد دار النعيم","ولارهبت لتذكار اللظى والجحيم",140,"م",1,0],["فما رويت سوى أخبار فضلكم","ولا تلوت سوى قول ابن زيدونا",141,"ن",2,0],["فما راعه إلا المطارق حوله","ففرَّ ونادى أن هذي صواعق",142,"ق",1,0],["فما رأيت وفياً","وما أبرىء نفسي",143,"ي",1,0],["فما راعهم إلا الرزايا تواثبت","عليهم وقامت في أذاهم تحشد",144,"د",1,0],["فما راعني إلا الرحيل بذاته","إلى منزل كل إليه سيأتي",145,"ت",2,0],["فما رامه من أي شيء يناله","فلو قال للسحب امطري أسكبت سكبا",146,"ب",2,0],["فما رأيتُ غيرَ ظلٍّ زائلٍ","كلٌّ يَمُدُّ نَحْوَهُ جَهْلاً يَدَا",147,"د",2,0],["فما رَقَّ لي فيها نسيمُ أصائِلي","ولا رَاقَ لي فيها من الهمّ مَشرَبُ",148,"ب",1,0],["فما راح من والاك إلاَّ منعّماً","ولا عاشَ من عاداك إلاَّ منكدا",149,"د",2,0],["فما رتبة إلّا إليه مآبها","ولا شرفٌ إلا إليه",150,"ه",1,0],["فَمَا رَأيتُ مَصَابِيحَ الهُدَى اجتَمَعُوا","إِلاَّ وَأَلقَوا إلَيهِ بِالمَقَالِيدِ",151,"د",1,0],["فما راق لي لمّا سمعت مشارب","ولا هنأتيني بعد ذاك مطاعمُ",152,"م",1,0],["فما رِمْتَ حَتَّى عَلَتْ جانِباها","بأَيدِي