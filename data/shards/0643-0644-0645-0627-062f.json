{"poems":[[57,"مجلس ينسب السرور إليه","https://www.aldiwan.net/poem26200.html","الخفيف"],[87,"قم سليمان بساط الريح قاما","https://www.aldiwan.net/poem63696.html","الرمل"],[68,"ثب إلى اللذات فالعمر قصير","https://www.aldiwan.net/poem39046.html","الرمل"],[50,"ضحك الشيب في نواحي الظلام","https://www.aldiwan.net/poem65114.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42625","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54315","الخفيف"],[203,"زعموني نسيت والهجر ينسي","https://www.aldiwan.net/poem45601.html","الخفيف"],[234,"حي شربا تفردوا بالرحيق","https://www.aldiwan.net/poem50903.html","الخفيف"],[326,"سكن الليل والأماني عذاب","https://www.aldiwan.net/poem26685.html","عموديه"],[333,"هذه دارها وتلك رباها","https://www.aldiwan.net/poem55027.html","الطويل"],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[369,"أسعداني في الحب ما تعلمان","https://www.aldiwan.net/poem60609.html","الخفيف"],[422,"شام برقا راعه مبتسما","https://www.aldiwan.net/poem53999.html","الرمل"],[438,"اجتل اللهو حمرة في بياض","https://www.aldiwan.net/poem12451.html","الخفيف"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108897","الخفيف"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87833","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69334","الخفيف"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/198651","الرمل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76072","الخفيف"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130757","الخفيف"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205783","الخفيف"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99443","الخفيف"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115581","الخفيف"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105110","الخفيف"],[4203,"","https://poetry.dctabudhabi.ae/diwan/poem/105524","الرمل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28650","الرمل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33286","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120416","المقتضب"],[4816,"بنات الشك","https://www.poetsgate.com/ViewPoem.aspx?id=8481",""],[4929,"تطريز (ذكريات)","https://www.poetsgate.com/ViewPoem.aspx?id=202406",""],[5219,"يا زمان الوصل","https://www.poetsgate.com/ViewPoem.aspx?id=194938",""],[5376,"يا رسولَ اللهِ ما طيرٌ شدا","https://www.poetsgate.com/ViewPoem.aspx?id=193785",""],[5411,"غربة..","https://www.poetsgate.com/ViewPoem.aspx?id=191552",""],[5525,"كل ما دعاني الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=7180",""],[5691,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=207079",""],[5739,"حالب النمله ..!","https://www.poetsgate.com/ViewPoem.aspx?id=155467",""],[5747,"الهجوس","https://www.poetsgate.com/ViewPoem.aspx?id=61679",""],[5783,"إنما \"هند\"إسم كل جميل","https://www.poetsgate.com/ViewPoem.aspx?id=53716",""],[6115,"كاتب الخط يفنى والقلم والدواه","https://www.poetsgate.com/ViewPoem.aspx?id=181837",""]],"verses":[["كُلَّما دارَتِ الزُجاجَةُ زَادَت","هُ اِشتِياقاً وَحُرقَةً فَبَكاكِ",0,"ك",1,0],["كُلَّما دارَ بِهِ دَورَتَهُ","أَبدَتِ الريحُ اِمتِثالاً وَاِرتِساما",1,"م",2,0],["كُلَّما دُرنا رَأَينا بَينَنا","شادِناً يَشدو وَكاساتٍ تَدورُ",2,"ر",1,0],["كُلَّما دارَتِ الكُؤوسُ تَغَنّى","مَن لِقَلبِ مُتَيَّمٍ مُستَهامِ",3,"م",1,0],["كُلَّمَا دُرْتُ لأَقْضِي حَاجَةً","قَالَتِ الظُّلْمَةُ مَهْلاً لا تَدُرْ",4,"ر",1,0],["كلّما دار دورةً نهض العق","لُ وألقى العتيقَ من أكفانه",5,"ن",2,0],["كلما دارتِ الشفاهُ بكأسٍ","دارَ خداهُ لي بكأسٍ وكأسِ",6,"س",1,0],["كلَّما دارتِ المدامُ عليهمْ","سَلَكوا لِلعلوم كُلَّ طَريق",7,"ق",1,0],["كُلَّما داعبَ الكرَى جَفنَ عيني","هزَّني الشَّوقُ وأضناني الغياب",8,"ب",1,0],["كلّما دقّ ساقها رقصَ النه","دُ وفاحت من جانبيها الطيوب",9,"ب",1,0],["كلّما داويتُ جرحى حنوناً","قذفوني بضَيعة الإحساس",10,"س",1,0],["كلّما دارَ في الخَواطرِ مَعْنىً","نظَموهُ فدار في الألحان",11,"ن",1,0],["كلّما داويت آلامي به","حُسِمَ الداءُ به فانحسما",12,"م",2,0],["كلما دبّ في المفاصِلِ باتَتْ","من حُميّاهُ وهْيَ ذاتُ انتِفاضِ",13,"ض",1,0],["كلما دك حادث الدهر بيتاً","قام في الحال جوده العام يبني",14,"ن",2,0],["كُلَّما دانَت الحَقيقَةَ أَلفَت","دونَ إِدراكِها سُجوفاً سَديلَه",15,"ل",2,0],["كُلَّما داسَتِ الحَصا خَضَبَتهُ","فَتَساوى عَقيقُهُ بِجُمانِه",16,"ن",2,0],["كلما دارت بها أبصارها","صورت فيها مثال الحدق",17,"ق",1,0],["كُلَّما دارَ قَبَّلُوهُ فَيحمَر","ر حَياءً كَأنَّهُ مَذمومُ",18,"م",1,0],["كلما داعبته بين الروابي","نسمات الصباح ناح الحمامُ",19,"م",1,0],["كلما دار ذكره في حديث","شاق عيني مرآه بعد الغياب",20,"ب",1,0],["كلما دبت المدامة في الأع","ضاء دب اشتياقه في العظام",21,"م",1,0],["كلّما دارت المدامُ عليهم","ألبَستهُم سكينةً ووقارا",22,"ر",2,0],["كلما دب عقرب الصدغ في الخ","د رماها بالورد والتفاح",23,"ح",1,0],["كلما دب إليها عقربا","وجدتها ملأت في حرس",24,"س",1,0],["كُلَّما دَلدَلتُ خِصيَيَّ إِلى","دارِكُم قَلَّص خِصيَيَّ الفَرَقْ",25,"ق",1,0],["كلما دارَ طرفُهُ قصَرتهُ","نظرةٌ فهو لا يكادُ يدورُ",26,"ر",1,0],["كلما دنت دنيا","زدت في الحشا كمدا",27,"د",2,1],["كلما دخل في دار يتلون بلون","يزحف وعيشه عالردى والفسادي",28,"د",2,0],["كلّما دق خاطري طيفُها با","باً يدقُّ الحنين في القب بابَهْ",29,"ب",2,0],["كلما داريت قلبي قال للي","ابتعد عنه سريعا وانسحب",30,"ب",1,0],["كلَّما دُقَّتْ طبولٌ حولنا","كانتِ الحرْبُ وكنا المُوْقَدا",31,"د",2,0],["كُلَّما دَشَّنَ الصَّباحَ ظِلالي","تَتَصَدَّى الرِّياحُ لي مُحْتَجَّهْ",32,"ج",2,0],["كل ما دعاني الشوق للقلب الأول","القى مكان القلب في الصدر تنهيد",33,"د",1,1],["كلما داعب الحنينُ شغافَ","القلب فاضت بالدمع مني الشؤونُ",34,"ن",1,0],["كل مادح لو تبي تبحث وراه.","عند غيرك روح ذاتك ذمها.",35,"م",3,0],["كل مادلهم سواد الليل اوني","ونة اللي فاقدٍ شوف الجماعه",36,"ع",2,0],["كل ما دار بيننا من أمور","لم تدُرْ في مداره الفحشاء",37,"ا",2,0],["كلما دوّن الكاتب بكفّه لقاه","بالصحايف موثّق من كثير وقليل",38,"ل",1,0]]}