{"poems":[[55,"أسل بدمعك وادي الحي إن بانوا","https://www.aldiwan.net/poem29743.html","البسيط"],[53,"بدر وشمس ولدا كوكبا","https://www.aldiwan.net/poem8321.html","السريع"],[48,"كلم بسيفك قوما إن دعوتهم","https://www.aldiwan.net/poem23391.html","البسيط"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74095","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114050","الخفيف"],[4303,"","https://poetry.dctabudhabi.ae/diwan/poem/110655","البسيط"],[4991,"يسأل البحر","https://www.poetsgate.com/ViewPoem.aspx?id=190281",""]],"verses":[["كُلمٌ بِقَلبي أُداويهِ وَيَقرِفُهُ","طَولُ إِدكاري لِمَن لي مِنهُ نِسيانُ",0,"ن",1,0],["كلِّم به مُلِّيتَهُ مِقْولاً","وازحَمْ به مُلّئته مَنْكِبا",1,"ب",2,0],["كَلِّم بِسَيفِكَ قَوماً إِن دَعَوتَهُمُ","مِنَ الكُلومِ فَما يُصغونَ لِلكَلِمِ",2,"م",1,1],["كلم بجيد الدهر منه قلادة","وَبسمعه نغم ترنّ تحمّسا",3,"س",2,0],["كُلُّ مَبعُوثٍ للأنَامِ تَجَلَّى","أخَذَ اللهُ مِنهُ عَهداً وَإِلاَّ",4,"ل",2,0],["كلم بقلب المعالي لا اندمال له","أعيى الأواسي ولم تبلغ مسابره",5,"ر",2,0],["كل مبعد حزني .. شوقي لك يجيبه","وانظر النجمات لين القى الصبوحي",6,"ح",2,0]]}