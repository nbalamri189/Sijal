{"poems":[[29,"طربت وما هذا الصبا والتكالف","https://www.aldiwan.net/poem5926.html","الطويل"],[87,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[64,"لك الله هل عهد الشبيبة يرجع","https://www.aldiwan.net/poem52358.html","الطويل"],[82,"أمسك الصبا أهدت إلي صبا نجد","https://www.aldiwan.net/poem31482.html","الطويل"],[35,"ليالي أصبو بالعشي وبالضحى","https://www.aldiwan.net/poem25837.html","الطويل"],[107,"ذراني أقم للشعر في مصر مأتما","https://www.aldiwan.net/poem43370.html","الطويل"],[42,"رأتني خضيب الرأس شمرت مئزري","https://www.aldiwan.net/poem42314.html","البسيط"],[22,"آثرت إدلاجي على ليل حرة","https://www.aldiwan.net/poem21644.html","الطويل"],[22,"نأتك أمامة إلا سؤالا","https://www.aldiwan.net/poem21647.html","المتقارب"],[69,"إلهي على كل الأمور لك الحمد","https://www.aldiwan.net/poem18053.html","الطويل"],[52,"تخليت من صفراء لا بل تخلت","https://www.aldiwan.net/poem64748.html","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202546","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54519","المتقارب"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/23993","الطويل"],[111,"معاهدة تذكاري سقتك الغمائم","https://www.poetsgate.com/ViewPoem.aspx?id=102",""],[52,"تَخَلَّيْتُ مِنْ صَفْرَاءَ، لا بَلْ تَخلَّتِ","https://www.poetsgate.com/ViewPoem.aspx?id=19973",""],[93,"فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=1208",""],[113,"لعمري ليس بالإشعار فخري","https://www.aldiwan.net/poem16511.html","الوافر"],[164,"إذا اومض البرق من أرضها","https://www.aldiwan.net/poem58689.html","المتقارب"],[170,"حبا من تحت ذيل الحبي","https://www.aldiwan.net/poem46824.html","المتقارب"],[185,"أمن طلل بالجزع قو المعارف","https://www.aldiwan.net/poem58844.html","الطويل"],[228,"أجيبيه أني ما أزال مقربا","https://www.aldiwan.net/poem41600.html","الطويل"],[308,"أفي كل يوم منك عتب يسوءني","https://www.aldiwan.net/poem58314.html","الطويل"],[325,"حنانا أخلائي فقد شفني البعد","https://www.aldiwan.net/poem67159.html","الطويل"],[409,"أتزعم حب أقوام وتنسى","https://www.aldiwan.net/poem33465.html","الوافر"],[463,"عسى معرض وجهه مقبل","https://www.aldiwan.net/poem55971.html","المتقارب"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83339","الوافر"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96748","الوافر"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133805","المتقارب"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101984","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77892","الطويل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128074","الطويل"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/201715","الطويل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71038","الطويل"],[2094,"","https://poetry.dctabudhabi.ae/diwan/poem/202652","الرمل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104971","المتقارب"],[2619,"","https://poetry.dctabudhabi.ae/diwan/poem/26590","الطويل"],[2758,"","https://poetry.dctabudhabi.ae/diwan/poem/31506","المتقارب"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205768","الخفيف"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101628","السريع"],[3102,"","https://poetry.dctabudhabi.ae/diwan/poem/113898","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48291","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91220","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216521","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117884","الوافر"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131270",""],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76452","الطويل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97066","الطويل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81266","الكامل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81272","المتقارب"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33069","المنسرح"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81921","الطويل"],[4858,"حبائلُ الشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=35576",""],[5277,"شعارُ الدموع","https://www.poetsgate.com/ViewPoem.aspx?id=204180",""],[5302,"تسائلني هيفا","https://www.poetsgate.com/ViewPoem.aspx?id=201269",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[5411,"وَزُلْفى يا حبيب","https://www.poetsgate.com/ViewPoem.aspx?id=185346",""],[5411,"رِسالَتك الوَحيدة","https://www.poetsgate.com/ViewPoem.aspx?id=185460",""],[5480,"هموم الحر","https://www.poetsgate.com/ViewPoem.aspx?id=9875",""],[5616,"اسمنت","https://www.poetsgate.com/ViewPoem.aspx?id=203432",""],[5690,"أجبرت بك الدنيا فأنت مجيرها","https://www.poetsgate.com/ViewPoem.aspx?id=172135",""],[5776,"الغلام والملكة","https://www.poetsgate.com/ViewPoem.aspx?id=199336",""],[6070,"حملتيني بأحضانِ الحنايا","https://www.poetsgate.com/ViewPoem.aspx?id=189159",""],[6124,"أراك","https://www.poetsgate.com/ViewPoem.aspx?id=102714",""],[6167,"حديث الغضب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85540&r=&rc=23",""],[6224,"طواف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88194&r=&rc=9",""],[6310,"السُّبات الدَّامي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74588&r=&rc=16",""]],"verses":[["وَتُرمى فَتُشويها الرُماةُ وَقَتَّلَت","قُلوباً بِنَبلٍ لَم تَشِنها المَراصِفُ",0,"ف",1,0],["وَتَرٌ مِن غَيرِ ضَربٍ رَنَّما","في الدُجى أَو شَرَرٌ مِن قَبَسِ",1,"س",1,0],["وترمي به أقصَى المكارمِ هِمَّةٌ","لها فوقَ مُسْتنِّ المجرَّةِ مربَعُ",2,"ع",1,0],["وتَرمي بِنَفطٍ نارُهُ في دُخانِهِ","بِهِ المَوتُ مُحمَرٌّ يَؤوبُ بمُسوَدِّ",3,"د",1,0],["وَتَرمي فَتَصطادُ القُلوبَ عُيونُها","وَأَطرافَها ما تُحسِنُ الرَميَ بِالنَبلِ",4,"ل",1,0],["وَتَرمي عُبابَ النيلِ مِنها بِزاخِرٍ","تَظَلُّ المَنايا فيه غَرقى وَعُوَّما",5,"م",2,0],["وَتَرمي بِعَينَيها القُلُوبَ إِذا بَدَت","لَها فِقرَةٌ لَم تُخطِ مِنهُنَّ مَقتَلا",6,"ل",2,0],["وَتَرمي يَداها بِالحَصى خَلفَ رِجلِها","وَتَرمي بِهِ الرِجلانِ دابِرَةَ اليَدِ",7,"د",1,0],["وَتَرمي بِعَينَيها إِذا تَلَعَ الضُحى","ذُباباً كَصَوتِ الشارِبِ المُتَغَرِّدِ",7,"د",1,0],["وَتَرمي الغُيوبَ بِماوِيَّتَينِ","أُحدِثَتا بَعدَ صَقلٍ صِقالا",8,"ل",2,0],["وَتَرْمِي إلى الجوِّ الصُّخورَ كأنّما","بِبَاطِنِهَا غيظٌ على الجَوِّ أَوْ حِقْدُ",9,"د",1,0],["وَتَرمي عُقَيلٌ كُلَّ عَينٍ وَجَبهَةٍ","وَتَنتَظِمُ الأَبدانَ حَيثُ اِحذَأَلَّتِ",10,"ت",1,0],["وتر من غير ضرب رنّما","في الدجى بيت الجوى والبرحا",11,"ح",2,0],["وَتَرمُقُنِي بِالعُيُونِ الَّتِي","تَفِيضُ مَحَاجِرُهَا بِالضِّيَاءْ",12,"ا",2,0],["وترمي الرمايا في المقاتل عادلاً","إذا أكثرت نبلُ الرُّماة العظاعظا",13,"ظ",2,0],["وترمي بقايا الصالحين نجيعها","فتمسحها حور الجنان النواعم",14,"م",1,0],["وَتَرْمِي عُقَيْلٌ كُلَّ عَيْنٍ وَجَبْهَة","ٍ وَتَنْتَظمُ الأَبْدَان حَيْثُ احْزَألَّت",15,"ت",1,0],["وترمونهمْ بقبيح الكلامِ","وكانوا أحقَّ بضافي الثنا",16,"ن",2,0],["وَتَرمي آل منجك بانتِقاص","وَهُم أَهل الفَضائل وَالكَمال",17,"ل",1,0],["وترمي باسمهم إلحاظها","فوأدي ويا حبذا الأسهم",18,"م",1,0],["وتَرمي قوائمَها كالسِّهام","وتُنبري هياكلُها كالقسيِّ",19,"ي",1,0],["وَتَرمِى بِعَينَى جُؤذَرٍ مُتَنَصِّبٍ","كَنضورِ أَقَاحِى المَحلِ بَينَ الأَحاقِفِ",20,"ف",1,0],["وَتَرمي بِها في حَمأةِ الوَيلِ وَالخنى","سُقاطَة عار تَلهم الخَوفَ وَالذُعرا",21,"ر",2,0],["وترمي على طول المدى متجنيا","بسهميك في اعشار قلب مقتل",22,"ل",1,0],["وَتَرمُقُهُ عَينُ العِنايَةِ بِالصَفا","فَيُمسي وَيَغدو وَالسَلامُ لَهُ مَهدُ",23,"د",1,0],["وترمي مَنْ سواك بكل داء","وأنت بما تفوه به جهول",24,"ل",1,0],["وترمي القبائل عن قوسهم","وأرمي ولكنك الأفضلُ",25,"ل",1,0],["وَتَرمي لِلمَطلِ عَلى حِماها","سِهاماً فَوقَ ما حَوَت الجِعابُ",26,"ب",1,0],["وَترمي بالأسودِ أسو","ده فيه مذاكيهِ",27,"ي",2,0],["وترمقُني فيَهُمُّ البياضُ","ويغمُرني ضؤه الأشنَبُ",28,"ب",1,0],["وترم أن تحصي مساعي صالح","المشرقات سوالفا وخدودا",29,"د",2,0],["وَتَرمي جمار البعد بالقرب وَالحصى","صَلاة تفيد الوصل من كان أَقطعا",30,"ع",2,0],["وترمى بنا الآمال أبعد غاية","فتدركنا الآجال في الكرّ والجد",31,"د",1,0],["وترمي قِسِيُّ الفجر أفئدةَ الدُّجى","فأشكو كما تشكو النجوم نبالها",32,"ل",3,0],["وترْمِيهمُ بالمُنْكرات ولا يرى","لهم أَبَداً حقَّ الإِمامة رائي",33,"ا",2,0],["وتَرُمْ رفْعَة قَدْرِ بِنُهىً","سِيَّما إن كنتَ فذّاً في الأدبْ",34,"ب",1,0],["وترمى الى الأرض من شاهق","ولم ترمِ أعداك شهبُ السما",35,"م",2,0],["وَتَرموا عُقَيلاً بِالَّتي لَيسَ بَعدَها","بَقاءَ فَكونوا كَالإِماءِ العَوائِرِ",36,"ر",1,0],["وَتَرمَدُّ هَملَجَةً زَعزَعا","كَما اِنخَرَطَ الحَبلُ فَوقَ المَحالِ",37,"ل",1,0],["وترٌ مطرب الأغاريد يبلي","وهزار يرثي الربيع نشيدا",38,"د",2,0],["وترمز الوردة عن موقد","في أضلعي نيرانه عالقه",39,"ه",1,0],["وترمي العدا رميا مصيبا بحكمة","وتسقي الفتى الظمآن من مائها العذب",40,"ب",1,0],["وترْمي بأعْلاها الحجارةَ آخِراً","كأنّ وفودَ الحجّ تُرْمَى جِمارُها",41,"ر",3,0],["وَتَرميهِ الظُبى بِسهام غمزٍ","معوّدةٍ عَلى صَيد الأُسود",42,"د",1,0],["وترميه في بئر عميق قرارها","وتسفكه فوق البطاح الغوامر",43,"ر",1,0],["وترميهم بشر إن أصروا","كما رميت جمار بالمحصب",44,"ب",1,0],["وترمقها من صاحب العرش مقلةٌ","لها نظرات في مواقعها الجد",45,"د",1,0],["وَتَرمي الى تَوديعها لعريسها","إِذا لَم يَكن من بعد هو المودع",46,"ع",1,0],["وتر مستفزاً آل فهر لثارها","وجرد مواضيها وقم كعابها",47,"ب",3,0],["وَتَر مِن الناس المقد","س مِن بَقايا المُرسَلين",48,"ن",1,0],["وَتَرمي بِنَفسك بَينَ الهَوا","جس في زاخر لِلأَماني خَضم",49,"م",1,0],["وَتَرَمَّلَت بِدَمٍ قَداماهُ وَقَد","أَوفى اللِحاقُ وَحانَ مَصرَعُهُ",50,"ع",2,0],["وترمي ملوك الأرض منه بهيبةٍ","مليك لظلماء المظالم كاشف",51,"ف",1,0],["وترمي بالعيونِ سهامَ سِحْرٍ","فتمنعُ جَفْنَنا حُلْوَ الرُّقادِ",52,"د",1,0],["وتُرمِلُهُ الجروحُ ولا ضمادٌ","سوى رملٍ يعاطيهِ الغبارا",53,"ر",2,0],["وترمي سؤالات وتجتازها ففي","مساءاتها وشي وتخشى له فقدا",54,"د",2,0],["وترميه بالبهتان والزور زاعماً","بأنك ذو نصح وتهدي وتستهدي",55,"د",2,0],["وَتَرْمِقني كَما المَبْهور دَوْمًا","وَتُمْسِكُ في الهَوى كَفَّا وَكَفّا",56,"ف",2,0],["وَتَرْمَحُ فِيَّ قافِلَةُ تهادتْ","إِلى قَمَرٍ عَلَى مُدُني يَدورُ",57,"ر",1,0],["وترمي صرحنا باللي جنينا من عصاب الراس","وتنسى عز ماضينا ولا ترفع قدر راسه",58,"س",2,0],["وترمقه عينا حبيب مسافر","أيبقى بلا ماء لديه ولا نبت؟",59,"ت",1,0],["وترمي كراتٍ في الأعادي سقوطها","كساعة يوم الحشر ينفخ صورها",60,"ر",3,0],["وترمي عنْ يديها دُميتيها","وتُنسيها الطّفولةُ كيفَ تصنعْ",61,"ع",1,0],["وترميها المشافيَ في برودٍ","جحدتَ اللهَ أقوالاً وآيا",62,"ا",3,0],["وَتَرْمِيْنِيْ خَرَابَاتٌ كَأَنّي","رواحي شبهُ بندولِ الثّواني",63,"ن",2,0],["وترمَّلتْ سُنَنُ الحياةِ بأنفُسٍ","نَهضَتْ تُنادِي ليتني لَم أُولَدِ",64,"د",1,0],["وتَرمي ثَلاثًا بالصَبابَةِ أَضْلُعي","فَنَذوي مِن الجمْراتِ وهي تُسَعَّرُ",65,"ر",1,0],["وتُرمَى بلجِّ الوحوش طعاما","ببيْروتَ غزَّةَ .. جيوسَ .. حَبْلهْ",66,"ل",2,0]]}