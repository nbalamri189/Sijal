{"poems":[[53,"لأمر يا بني جشم","https://www.aldiwan.net/poem29770.html","مجزوء الوافر"],[53,"تضيق صدور العتب والعذر أوسع","https://www.aldiwan.net/poem29976.html","الطويل"],[53,"تمنى رجال نيلها وهي شامس","https://www.aldiwan.net/poem30198.html","الطويل"],[88,"اليوم قري يا مواطن أعينا","https://www.aldiwan.net/poem44458.html","الكامل"],[88,"تريد لي الأيام أن أتقيد","https://www.aldiwan.net/poem45016.html","الطويل"],[72,"طيف تصيدته والليل محتبك","https://www.aldiwan.net/poem19439.html","البسيط"],[78,"قد زارنا النرجس الذكي","https://www.aldiwan.net/poem14040.html","مخلع البسيط"],[78,"يا ليت حربا ذاق الأعادي","https://www.aldiwan.net/poem14077.html","مخلع البسيط"],[61,"ولي خلة أرعى لها العهد صائفا","https://www.aldiwan.net/poem51369.html","الطويل"],[61,"شباب المرء ثوب مستعار","https://www.aldiwan.net/poem51666.html","الوافر"],[66,"أحب صديقا منصفا في ازدياده","https://www.aldiwan.net/poem38564.html","الطويل"],[97,"إن حان لحن الختام","https://www.aldiwan.net/poem24907.html","المجتث"],[48,"طاب الهوى لعميده","https://www.aldiwan.net/poem62606.html","مجزوء الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39568","الكامل"],[160,"أكلت اللحم حلا من أيادي","https://www.aldiwan.net/poem58683.html","الوافر"],[186,"إذا كنت لوجهي صائنا","https://www.aldiwan.net/poem43188.html","السريع"],[211,"نسيتم العهد واسترحتم","https://www.aldiwan.net/poem46639.html","مخلع البسيط"],[256,"وكم حديث كأنه سمر","https://www.aldiwan.net/poem48439.html","المنسرح"],[303,"أفي كل يوم منك عتب يسوءني","https://www.aldiwan.net/poem58314.html","الطويل"],[348,"ولي خدم سطرتها قبل هذه","https://www.aldiwan.net/poem20432.html","الطويل"],[364,"هم منعوا منا الخيال الذي يسري","https://www.aldiwan.net/poem60909.html","البسيط"],[364,"أذاكرة يوم الوداع نوار","https://www.aldiwan.net/poem60917.html","الطويل"],[437,"أأستجبر عليهم دمعي الجاري","https://www.aldiwan.net/poem2595.html","البسيط"],[461,"أظن ظلام الحظ حان نصوله","https://www.aldiwan.net/poem15389.html","الطويل"],[495,"ألم ترني فارقت قيسي وخندفي","https://www.aldiwan.net/poem9856.html","الطويل"],[538,"بما بيننا من حرمة ايها الصحب","https://www.aldiwan.net/poem48303.html","عموديه"],[551,"أقلا فشأنكما غير شاني","https://www.aldiwan.net/poem47155.html","المتقارب"],[567,"عذيري من صرف هذا الزمن","https://www.aldiwan.net/poem69497.html","المتقارب"]],"verses":[["وَلي خُلقانِ ما صَلُحا","لِغَيرِ السَيفِ وَالقَلَمِ",0,"م",1,0],["وَلي خاطِرٌ ما إِن سَلَكتُ مَضاءَهُ","عَلى الهَمَّ إِلّا كادَ في الدَهرِ يُقطَعُ",1,"ع",1,0],["وَلي خِدمَةٌ قَدَّمتُها لِتُعِزَّني","وَلَولا الجَنى ما رَجَّبَ الفَرعَ غارِسُ",2,"س",1,0],["وليخسؤوا إن البلاد جميعها","تقفو الزعيم وترتضيه ميهمنا",3,"ن",2,0],["ولي خُلُق يأبى عليّ انطباعه","على الخير تسليمي إلى الشرّ مِقْوَدا",4,"د",2,0],["ولي خصومٌ ولست الآن شاكيهم","لكنهم في غدٍ يدرون أينَ شكوا",5,"ك",3,0],["وَلي خَليلٌ غَدا سميّي","يا لَيتَهُ ساعَدَ السَميُّ",6,"ي",1,0],["وَليَخزَ من قال مِن حسود","إِن يَكُنِ الحَقُّ قَد أَلَمّا",7,"م",2,0],["ولي خلة أرعى لها العهد صائفا","ولست أراعي في الشتاء لها عهدا",8,"د",2,1],["ولي خِدْنانِ همُّهما المعالي","وشأُنهما السَّكينةُ والوَقارُ",9,"ر",1,0],["وَلي خَلَواتٌ لا أَبيعُ يَسيرَها","بِما مَلَكَت كَفّايَ مِن وافِرِ الوَفرِ",10,"ر",1,0],["ولّى خيالٌ وراح","وحلّ ظلٌّ غريب",11,"ب",1,0],["وَلي خُشوعُ المُصَلّي","في دَيرِهِ يَومَ عيدِه",12,"د",2,0],["وَلَّى خريفُ العام بعد ربيعه","ولَكَمْ ربيعٍ مرَّ بعد خريفِ",13,"ف",1,0],["ولي خمسون عاماً غير شيء","بصحبتكم على خيرٍ وغنم",14,"م",1,0],["ولي خيوط ومعي إبرةٌ","أرُمّه ثمّ أداريه",15,"ي",2,0],["ولّى خداع المنى وقّرت","مطامح الواجد الحزين",16,"ن",1,0],["ولي خصى لو خرجت أعرضه اش","تراه مني بروحه دري",17,"ي",1,0],["ولي خطرات فيك منها جوانحي","صبحن سلافا من رحيق مفلفل",18,"ل",1,0],["وَلي خِدَمٌ سَطَّرْتُها قَبَل هذهِ","وَلَمْ يَأْتِ عَنها بالجَوابِ مُشَرِّفُ",19,"ف",1,1],["ولي خاطرٌ يُغْري بِوأْدِ بناتِه","على حُسْنِها من فَقْدِه كرَمَ الصِّهر",20,"ر",1,0],["ولي خاطِرٌ أضحَى وأَدنَى بَيانِه","لأبناء آدابِ الزَّمانِ مَنار",21,"ر",1,0],["ولي خلائق ما تنفك من شرف","مثل النجوم التي يسري بها الساري",22,"ي",1,0],["ولي خطراتٌ بعد ذلك مُرَّةٌ","يُهيِّجُها وُدِّي لهُ وتَذكُّري",23,"ر",2,0],["ولي خادم فوق الخِوان هو الذي","تمر به الأقدار وهي تحاذره",24,"ر",2,0],["ولي خيرُ إخوانٍ يوَدُّون عِشرَتي","ولِي قَد تَصافَى منهُمُ الوُّدُّ والحُبُّ",25,"ب",1,0],["ولي خدمةٌ سلفتْ في الزّمان","صدعتُ بها غرّةً في زماني",26,"ي",1,0],["وَلِي خِدْمَةٌ يَكْتِشِفُ الامْتِحَانُ","عَنْهَا فَيَحْمَدُهُ المُمْتَحِنْ",27,"ن",1,0]]}