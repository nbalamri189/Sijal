{"poems":[[55,"لأمر يا بني جشم","https://www.aldiwan.net/poem29770.html","مجزوء الوافر"],[55,"تضيق صدور العتب والعذر أوسع","https://www.aldiwan.net/poem29976.html","الطويل"],[55,"تمنى رجال نيلها وهي شامس","https://www.aldiwan.net/poem30198.html","الطويل"],[90,"اليوم قري يا مواطن أعينا","https://www.aldiwan.net/poem44458.html","الكامل"],[90,"تريد لي الأيام أن أتقيد","https://www.aldiwan.net/poem45016.html","الطويل"],[74,"طيف تصيدته والليل محتبك","https://www.aldiwan.net/poem19439.html","البسيط"],[80,"قد زارنا النرجس الذكي","https://www.aldiwan.net/poem14040.html","مخلع البسيط"],[80,"يا ليت حربا ذاق الأعادي","https://www.aldiwan.net/poem14077.html","مخلع البسيط"],[63,"ولي خلة أرعى لها العهد صائفا","https://www.aldiwan.net/poem51369.html","الطويل"],[63,"شباب المرء ثوب مستعار","https://www.aldiwan.net/poem51666.html","الوافر"],[68,"أحب صديقا منصفا في ازدياده","https://www.aldiwan.net/poem38564.html","الطويل"],[99,"إن حان لحن الختام","https://www.aldiwan.net/poem24907.html","المجتث"],[50,"طاب الهوى لعميده","https://www.aldiwan.net/poem62606.html","مجزوء الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39568","الكامل"],[111,"أحسن امانتك التي قلدتها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66830&r=&rc=9",""],[164,"أكلت اللحم حلا من أيادي","https://www.aldiwan.net/poem58683.html","الوافر"],[190,"إذا كنت لوجهي صائنا","https://www.aldiwan.net/poem43188.html","السريع"],[215,"نسيتم العهد واسترحتم","https://www.aldiwan.net/poem46639.html","مخلع البسيط"],[261,"وكم حديث كأنه سمر","https://www.aldiwan.net/poem48439.html","المنسرح"],[308,"أفي كل يوم منك عتب يسوءني","https://www.aldiwan.net/poem58314.html","الطويل"],[353,"ولي خدم سطرتها قبل هذه","https://www.aldiwan.net/poem20432.html","الطويل"],[369,"هم منعوا منا الخيال الذي يسري","https://www.aldiwan.net/poem60909.html","البسيط"],[369,"أذاكرة يوم الوداع نوار","https://www.aldiwan.net/poem60917.html","الطويل"],[443,"أأستجبر عليهم دمعي الجاري","https://www.aldiwan.net/poem2595.html","البسيط"],[466,"أظن ظلام الحظ حان نصوله","https://www.aldiwan.net/poem15389.html","الطويل"],[500,"ألم ترني فارقت قيسي وخندفي","https://www.aldiwan.net/poem9856.html","الطويل"],[543,"بما بيننا من حرمة ايها الصحب","https://www.aldiwan.net/poem48303.html","عموديه"],[556,"أقلا فشأنكما غير شاني","https://www.aldiwan.net/poem47155.html","المتقارب"],[572,"عذيري من صرف هذا الزمن","https://www.aldiwan.net/poem69497.html","المتقارب"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122770","الوافر"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64043","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62493","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62474","الطويل"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203785","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64602","الكامل"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128070","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100967","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101037","الطويل"],[1824,"","https://poetry.dctabudhabi.ae/diwan/poem/95401","الوافر"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76676","الكامل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104779","الطويل"],[2053,"","https://poetry.dctabudhabi.ae/diwan/poem/132441","الرجز"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33869","الطويل"],[2371,"","https://poetry.dctabudhabi.ae/diwan/poem/142604","الهزج"],[2606,"","https://poetry.dctabudhabi.ae/diwan/poem/198980","الطويل"],[2824,"","https://poetry.dctabudhabi.ae/diwan/poem/200096","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202812","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202592","الطويل"],[3347,"","https://poetry.dctabudhabi.ae/diwan/poem/142289","السريع"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112364","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108070","البسيط"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45036","الكامل"],[4753,"بين يدي حديث الليل","https://www.poetsgate.com/ViewPoem.aspx?id=28907",""],[4797,"ماهو بكيفك عقب شيٍ حصلي","https://www.poetsgate.com/ViewPoem.aspx?id=178137",""],[5324,"والتين والزيتون","https://www.poetsgate.com/ViewPoem.aspx?id=211590",""],[5431,"ألوذ بها حيث الخراب يلفّني فأغفو وماحولي قتيلٌ وقاتلُ","https://www.poetsgate.com/ViewPoem.aspx?id=189529",""],[6088,"اقباس","https://www.poetsgate.com/ViewPoem.aspx?id=207586",""],[5377,"رثاء شعب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79547&r=&rc=1",""],[6351,"جواب يفتش عن سؤال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86046&r=&rc=6",""],[572,"عَذِيريَ منْ صرفِ هذا الزّمنْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9489&r=&rc=346",""],[572,"أَلاَ أَبْلِغْ أَبَا بَكْرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9291&r=&rc=148",""]],"verses":[["وَلي خُلقانِ ما صَلُحا","لِغَيرِ السَيفِ وَالقَلَمِ",0,"م",1,0],["وَلي خاطِرٌ ما إِن سَلَكتُ مَضاءَهُ","عَلى الهَمَّ إِلّا كادَ في الدَهرِ يُقطَعُ",1,"ع",1,0],["وَلي خِدمَةٌ قَدَّمتُها لِتُعِزَّني","وَلَولا الجَنى ما رَجَّبَ الفَرعَ غارِسُ",2,"س",1,0],["وليخسؤوا إن البلاد جميعها","تقفو الزعيم وترتضيه ميهمنا",3,"ن",2,0],["ولي خُلُق يأبى عليّ انطباعه","على الخير تسليمي إلى الشرّ مِقْوَدا",4,"د",2,0],["ولي خصومٌ ولست الآن شاكيهم","لكنهم في غدٍ يدرون أينَ شكوا",5,"ك",3,0],["وَلي خَليلٌ غَدا سميّي","يا لَيتَهُ ساعَدَ السَميُّ",6,"ي",1,0],["وَليَخزَ من قال مِن حسود","إِن يَكُنِ الحَقُّ قَد أَلَمّا",7,"م",2,0],["ولي خلة أرعى لها العهد صائفا","ولست أراعي في الشتاء لها عهدا",8,"د",2,1],["ولي خِدْنانِ همُّهما المعالي","وشأُنهما السَّكينةُ والوَقارُ",9,"ر",1,0],["وَلي خَلَواتٌ لا أَبيعُ يَسيرَها","بِما مَلَكَت كَفّايَ مِن وافِرِ الوَفرِ",10,"ر",1,0],["ولّى خيالٌ وراح","وحلّ ظلٌّ غريب",11,"ب",1,0],["وَلي خُشوعُ المُصَلّي","في دَيرِهِ يَومَ عيدِه",12,"د",2,0],["وَلَّى خريفُ العام بعد ربيعه","ولَكَمْ ربيعٍ مرَّ بعد خريفِ",13,"ف",1,0],["وليخلصن القصد للمأمور في","حفظ الحدود الباطنات وما ظهر",14,"ر",1,0],["ولي خمسون عاماً غير شيء","بصحبتكم على خيرٍ وغنم",15,"م",1,0],["ولي خيوط ومعي إبرةٌ","أرُمّه ثمّ أداريه",16,"ي",2,0],["ولّى خداع المنى وقّرت","مطامح الواجد الحزين",17,"ن",1,0],["ولي خصى لو خرجت أعرضه اش","تراه مني بروحه دري",18,"ر",2,0],["ولي خطرات فيك منها جوانحي","صبحن سلافا من رحيق مفلفل",19,"ل",1,0],["وَلي خِدَمٌ سَطَّرْتُها قَبَل هذهِ","وَلَمْ يَأْتِ عَنها بالجَوابِ مُشَرِّفُ",20,"ف",1,1],["ولي خاطرٌ يُغْري بِوأْدِ بناتِه","على حُسْنِها من فَقْدِه كرَمَ الصِّهر",21,"ر",1,0],["ولي خاطِرٌ أضحَى وأَدنَى بَيانِه","لأبناء آدابِ الزَّمانِ مَنار",22,"ر",1,0],["ولي خلائق ما تنفك من شرف","مثل النجوم التي يسري بها الساري",23,"ر",2,0],["ولي خطراتٌ بعد ذلك مُرَّةٌ","يُهيِّجُها وُدِّي لهُ وتَذكُّري",24,"ر",2,0],["ولي خادم فوق الخِوان هو الذي","تمر به الأقدار وهي تحاذره",25,"ر",2,0],["ولي خيرُ إخوانٍ يوَدُّون عِشرَتي","ولِي قَد تَصافَى منهُمُ الوُّدُّ والحُبُّ",26,"ب",1,0],["ولي خدمةٌ سلفتْ في الزّمان","صدعتُ بها غرّةً في زماني",27,"ن",2,0],["وَلِي خِدْمَةٌ يَكْتِشِفُ الامْتِحَانُ","عَنْهَا فَيَحْمَدُهُ المُمْتَحِنْ",28,"ن",1,0],["وَلي خَدُّ الغُلامَةِ بِنتُ عَشرٍ","وَاتِلَتي لَها صَدرُ الغُلامِ",29,"م",1,0],["ولي خُلُقانِ ذا أرْيٌ مَشُورٌ","وذا في هيئة السّمِ الذُّعاف",30,"ف",1,0],["ولي خَلَدٌ منكم رهينُ اندماله","ولي جسد لم يبق غيرُ خياله",31,"ل",2,0],["ولي خَطَرات تُضرم النار في الحشا","من الشوق في مَيدان قلبي زحامُها",32,"م",3,0],["ولي خافق من رقة الحلم نسجُهُ","تذوبُ، إذا ناح الحمام، جوانبه",33,"ب",2,0],["وليخلصن القصد للمأموم في","حفظ الحدود البطنات وما ظهر",34,"ر",1,0],["ولى خلفه لخير تجارة","سيرى بها بالفتح خير نفاق",35,"ق",1,0],["ولي خَلة تأبى الهوى ما أطعتُها","فيا ويح نفسي يومَ عاصيتُ خَلّتي",36,"ت",2,0],["ولي خلقٌ أندى من الروض في الضحى","رقيق به أسبى الحسان العقائلا",37,"ل",2,0],["ولي خاشوقة إلى اللبنيه","تجيب الكبتين بلا ارتجاعه",38,"ع",2,0],["وليخلصن اليك من أعلاقه","علق يشد عليك كف ظنين",39,"ن",1,0],["وَلِى خِلعَةٌ فِى الفَضلِ لَو نُشِرَت على","جُيُوشِ صُنُوفٍ مِن أُلوفٍ لَعَمَّتِ",40,"ت",1,0],["ولي خال في بني يربوع","في فَدك حلّ وفي ينبوعِ",41,"ع",1,0],["ولي خال في بني النجار","ممتنع الدار عزيز الجارِ",41,"ر",1,0],["وَلي خادِمٌ يَرنو بِطَرفِ غَزالِ","مُدِلٌّ بِحُسنٍ فائِقٍ وَجَمالِ",42,"ل",1,1],["ولي خيم سكون الليل","سرى بك دوم تفكيره",43,"ر",2,0],["ولي خلدٌ أضحى قنيص غرامه","ولا شركٌ يدني إليه ولا فخ",44,"خ",1,0],["ولي خط وللأيام خط","وبينهما مخالفة المداد",45,"د",1,0],["ولي خصلة في خلق شعري أنني","أكوّن مخلوقاً فيحيا واحياه",46,"ي",3,1],["ولي خطبوا الدنيا ولم أرَ وجهها","فكان سواءً عرسُها والمآتم",47,"م",1,0],["ولى خيال سارح بالمنى","يسوقنى حينا وحينا يحيد",48,"د",1,0],["ولي خَلَواتٌ قد عشقتُ بها الدّجى","ولولا الدّجى مالاحَ في الافق كوكبُ",49,"ب",1,0],["وليخطب اليومَ من يهوى فقد عبثت","أيدي الردى بالخطيب المصقع الغرد",50,"د",1,0],["وَليُخلِصِ الكُلّ الدعاءَ لِسَيِّد","غَرَسَ العُلا وَسَقاهُ حَتّى أَثمَرا",51,"ر",2,0],["وليخرج الصوتُ الجريءُ وتحتلقْ","أذنُ العروبةِ بالحقيقة ِ وَلْتُجِبْ",52,"ب",1,0],["ولي خاطر ٍ يسألْك من لي ياخلي؟","غيبتْك تلعب به وشوفتْك تبهجْه",53,"ج",2,0],["وليخسأ المارق واللعين","وباذر الفرقة في ارجائه",54,"ه",1,0],["ولي خيمة في قلب حبيْ أقمتها","بها جنّة الفردوس ..بحرٌ وساحلُ",55,"ل",1,0],["ولي خفيّون ما ناديتهم مددا","إلاّ وكان جناح الرّيح لي فرسا",56,"س",2,0],["وليختنقْ صوتُهُ في ضجّة اللهبِ الْ","أَعْمى وتحترقِ الأنفاسُ في فِيهِ",57,"ي",2,0],["ولي خيبة الفلاح.. أغرى الجراد أن","يطير.. وأغوى بالسنابل جدولَه",58,"ل",2,0],["ولي خِدْمَة ٌ يَكشِفُ الإمتحا","نُ عنها فتحمدُ ما تُمْتَحِنْ",59,"ن",1,0],["وَلِي خَدٌّ وبستانٌ","ونهرٌ فيهما يجري",60,"ر",2,0]]}