{"poems":[[74,"مدت إليك المعالي طرف مبتهج","https://www.aldiwan.net/poem18454.html","البسيط"],[74,"محراب صدغيه يحث توجهي","https://www.aldiwan.net/poem20511.html","الكامل"],[107,"قومي أهاب من الحياة بشير","https://www.aldiwan.net/poem42068.html","الكامل"],[107,"إيه بني مصر من صم وعميان","https://www.aldiwan.net/poem43098.html","البسيط"],[107,"فزع الدجى لأنينه المتردد","https://www.aldiwan.net/poem43163.html","الكامل"],[107,"كيف القرار ونار الحرب تستعر","https://www.aldiwan.net/poem43164.html","البسيط"],[107,"يا أمة أودت بها الأحلام","https://www.aldiwan.net/poem43369.html","الكامل"],[107,"أقبل فتلك ديار يثرب تقبل","https://www.aldiwan.net/poem44226.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39630","البسيط"],[92,"على الخالصي","https://www.poetsgate.com/ViewPoem.aspx?id=179083",""],[92,"يا بنت رسطاليس","https://www.poetsgate.com/ViewPoem.aspx?id=179219",""],[92,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[107,"يا أمة أودت بها الأحلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54891&r=&rc=61",""],[202,"ومرنة قدحت زناد صبابتي","https://www.aldiwan.net/poem51939.html","الكامل"],[228,"إيه برناس هيكل الشعراء","https://www.aldiwan.net/poem41899.html","الخفيف"],[280,"نادتك أندلس فلب نداءها","https://www.aldiwan.net/poem25647.html","الكامل"],[457,"ما آل برمك في ذرى بغداد","https://www.aldiwan.net/poem13714.html","الكامل"],[457,"أحبابنا عودوا علينا عودة","https://www.aldiwan.net/poem13932.html","الكامل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145856","الخفيف"],[173,"","https://poetry.dctabudhabi.ae/diwan/poem/29668","الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56582","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108612","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108645","المجتث"],[2358,"","https://poetry.dctabudhabi.ae/diwan/poem/123473","الكامل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205786","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205023","الخفيف"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101624","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92396","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111476","الكامل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107494","الخفيف"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125858","الرمل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83556","الخفيف"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52132","الكامل"],[4869,"ريح الانين","https://www.poetsgate.com/ViewPoem.aspx?id=137912",""],[5038,"البضعة الزهراء","https://www.poetsgate.com/ViewPoem.aspx?id=196622",""],[585,"ما للديار خلت لكل شريد","https://www.poetsgate.com/ViewPoem.aspx?id=161917",""],[585,"حييت من وطنٍ كالركن مستلم","https://www.poetsgate.com/ViewPoem.aspx?id=161912",""],[585,"لمن اللواء محلقاً يتهلل","https://www.poetsgate.com/ViewPoem.aspx?id=161887",""],[585,"حي الشريف وحي البيت والحرما","https://www.poetsgate.com/ViewPoem.aspx?id=161911",""],[5145,"لله درك من بناءٍ عالي","https://www.poetsgate.com/ViewPoem.aspx?id=108232",""],[5277,"بغداد..عشقنا الخالد","https://www.poetsgate.com/ViewPoem.aspx?id=190901",""],[5414,"بكائية بين يدي بشار بن برد","https://www.poetsgate.com/ViewPoem.aspx?id=12926",""],[5721,"أعظم من أسلافي الأول","https://www.poetsgate.com/ViewPoem.aspx?id=215232",""],[5880,"بغداد ودمشق","https://www.poetsgate.com/ViewPoem.aspx?id=208577",""]],"verses":[["إيهٍ بعيشك بدرَ الدِّين سدْ فلقدْ","أدلجت للفضلِ فينا كلّ مدّلج",0,"ج",1,0],["إيهٍ بعيشك يا بديع مقالها","قلْ كيفَ شئت عن الهوى لا أنتهي",1,"ه",2,0],["إيهٍ بني مصرَ انْظُروا ما حولكم","وتأهَّبوا إنّ الخُطوبَ كثيرُ",2,"ر",1,0],["إيهٍ بَني مِصرَ مِن صُمٍّ وَعُميانِ","ضَجَّ اللَهيفُ وَهَبَّت صَيحَةُ العاني",3,"ن",2,1],["إيهٍ بَني مِصرَ جازَ الأَمرُ غايَتَهُ","وَذاعَ سِرُّ اللَيالي بَعدَ كِتمانِ",3,"ن",1,0],["إيهٍ بَني مِصرٍ وَتِلكَ إِهابَةٌ","مِن عائِذٍ بِنوالِكُم مُستَنجِدِ",4,"د",1,0],["إيهٍ بَني مِصرَ إِنَّ اللَهَ يَندُبُكُم","فَسارِعوا قَبلَ أَن تودي بِنا الغِيَرُ",5,"ر",1,0],["إيهٍ بَني مِصرٍ أَما وَعَظتكُمُ","ما تَصنَعُ الأَحداثُ وَالأَيّامُ",6,"م",1,0],["إيهٍ بني النجَّارِ إنَّ محمَّداً","لأَشدُّ حُبّاً لِلَّتي هي أجْمَلُ",7,"ل",1,0],["إيهٍ بني الشرق فالأبصارُ شاخصةٌ","لما تُعدُّونَ والآذان إصغاءُ",8,"ا",2,0],["ايةٍ بلادي هل يَقيك الأذى","أني انتضيت المقول المِقْضبا",9,"ب",2,0],["إيهٍ \" بلاسمُ \" والمفاخرُ جَمةٌ","أحرزتَ مَنهُنَّ الطريفَ التالدا",10,"د",2,0],["إيهٍ \" بِشارةُ \" لم تكنْ لتَحُدَّ من","مهوى النفوسِ ولم تكنْ لتحولا",11,"ل",2,0],["إيهٍ بني مصر أما وعظتكمو","ما تصنع الأحداث والأيام",12,"م",1,0],["إيهٍ بعيشكِ يا حمامةُ خبِّري","كيف الكثيبُ ورَنْدُهُ وعَرارُهُ",13,"ر",2,0],["إيهِ برناسُ هَيكَلُ الشُعَراءِ","وَمصلّى الكَهّانِ وَالأَنبِياءِ",14,"ا",2,1],["إيه برناس وَالعَرائِسُ تَشدو","فيكَ أُغنيَّةَ الهَوى وَالرَجاءِ",14,"ا",2,0],["إيهٍ بَلَنْسيَةٌ وفي ذكراكِ ما","يمري الشؤون دماءَها لا ماءَها",15,"ا",3,0],["إِيهٍ بعيشك يا زمان فلاتِني","أبَداً بنشْر محاسنِ الأمجاد",16,"د",1,0],["إيهِ بعيشِكم فما حالَ الوَفا","من بعد ليّكمُ على الحدثانِ",17,"ن",1,0],["إيهِ بغدادُ يَا مَلاذاتُ عُمري","إذْ تسَاوى بَيَاضُهُ والسَّوَادُ",18,"د",1,0],["إيهِ بغدادُ يا جُنونَ النؤاسيِّ","وَكأساهُ عُرسُهُ وَالحِدَادُ",18,"د",1,0],["إِيِهٍ بَقايا عَبدِ قَيسٍ إِنَّهُ","لا خَيرَ في ماضٍ بِكَفِّ جَبانِ",19,"ن",1,0],["إيهٍ بني الشرق ن الشرق ينظركم","هذي النجوم التي في الأفق أنظارُ",20,"ر",1,0],["أيِّهْ بليلى من ربى نجد","فلعلها ملّت من البعد",21,"د",1,1],["أيِّهْ بحاسٍ وحاسر","فالروض زاهٍ وزاهر",22,"ر",1,1],["إيهٍ بني وطني ارعَووا وتذكّروا","هل من حكيمٍ مُسعِدٍ أو مُنجدِ",23,"د",1,0],["إيه بغداد والليالي كتاب","ضم أفراحنا وضم المآسي",24,"س",2,0],["ايه باخوس كم شربت قديما","من سلاف وكم سقيت ندامى",25,"م",2,0],["إيهٍ بني وطني والناس قاطبةً","لرفع أوطانها قامت لها أهب",26,"ب",1,0],["إيه برق الديار خبرني عن نج","دٍ فحيّى الإلهُ عنّيَ نَجدا",27,"د",2,0],["إِيهٍ بَنِيَّ خَفَرتُمُ فَتَيَقَّظُوا","أَولاً فَنُمسِي لِلأَعادي مَورِدا",28,"ا",1,0],["ايه بور ارثرٍ لقد","هزَّني نحوكِ الطَرب",29,"ب",1,0],["إيه بالصين لماذا","طأَطأَت منهم رؤوسُ",30,"س",1,0],["إِيه بَدرَ البُدورِ رُحماكَ أَقبِل","وَاِشفِ مَضناكَ وَاِكشِفِ الأَسرارا",31,"ر",2,0],["إيه بَدرَ البُدورِ زِدنِيَ نوراً","زادَكَ اللَهُ في العلى أَنوارا",31,"ر",2,0],["إيه بلادَ الشرقِ أنتِ عزيزةٌ","عندي وحبُّكِ راسخٌ أركانا",32,"ن",2,0],["إيه بآت بمحجر دروبي مزن","بس .. يآآآآليته يبل الدآلهين",33,"ن",1,0],["إِيْهٍ بَني فَهْرٍ ، تُصادَرُ بُلْغَتي ؟","وَأَنا سَليلَةُ أَفْضَلِ الْآباءِ",34,"ا",2,0],["إيهٍ بني الوطن الكرام وإنكم","خلف لخير أبوةٍ وجدود",35,"د",1,0],["إيه بني العرب الأحرار إن لكم","رأي الكهول وبأس الليث في الأجم",36,"م",1,0],["إيه بني العرب احذروا أن تنكروا","نسباً هو الحسب الصراح الأول",37,"ل",1,0],["إيهٍ بني العرب الأحرار إن لكم","فجراً أطل على الأكوان مبتسما",38,"م",2,0],["إيهٍ بهاء الدين إنك خير من","رميت السماء عليه بالإظلال",39,"ل",1,0],["إيهِ بغدادُ فذا القلبُ اكتوى","ودموعُ الوجدِ من عيني تجارتْ",40,"ت",1,0],["إيه (بشارُ) جُدْ بياناً وشعرا","من ضياء وحكمة وعطور",41,"ر",1,0],["إِيهٍ بِرَبِّكَ لَوْ نَصَّبْتَنِي مِلِكاً","أَقَمْتُ شَأْنَهُمُ فِي مُجْمَلِ الدُّوَلِ",42,"ل",1,0],["إيهِ بغدادُ، تذكرين عهوداً","راق فيها الهوى، وطاب الهيامُ؟",43,"م",1,0]]}