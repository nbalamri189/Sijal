{"poems":[[65,"تلك الحدوج يراعيهن غيران","https://www.aldiwan.net/poem46159.html","البسيط"],[32,"أمن دمنة جرت بها ذيلها الصبا","https://www.aldiwan.net/poem29607.html","الطويل"],[13,"وَشِعْبٍ كَشَلِّ الثَّوْبِ شَكْسٍ طَرِيقُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=180798",""],[1,"لِخَوْلَةَ أَطْلالٌ بِبُرْقَةِ ثَهْمَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=10033",""],[135,"فإن يك رأسي كالثغامة نسله","https://www.aldiwan.net/poem24160.html","الطويل"],[186,"حياة أسر العيش فيها مذمم","https://www.aldiwan.net/poem67033.html","الطويل"],[255,"قفا تبك من ذكرى قميصي وسروال","https://www.aldiwan.net/poem15019.html","الطويل"],[463,"أدمعك أم عارض ممطر","https://www.aldiwan.net/poem56182.html","المتقارب"],[567,"أتدري ما بقلبك من جراح","https://www.aldiwan.net/poem52911.html","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62558","الخفيف"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/201715","الطويل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106996","الرجز"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216835","الخفيف"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86519","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103058","الوافر"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40152","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[4797,"ودي بك وابيك","https://www.poetsgate.com/ViewPoem.aspx?id=50257",""],[4797,"الحباري","https://www.poetsgate.com/ViewPoem.aspx?id=180554",""],[4988,"سيرة بطل راحت معاه الكرامه","https://www.poetsgate.com/ViewPoem.aspx?id=186507",""],[4988,"للخالدية جابني الشوق من غاد","https://www.poetsgate.com/ViewPoem.aspx?id=214086",""],[5183,"وادي الخيال","https://www.poetsgate.com/ViewPoem.aspx?id=180171",""],[463,"أدمعكَ أمْ عارضٌ ممطرٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60076&r=&rc=132",""]],"verses":[["تبطّنوا عَقِداتِ الرّمْلِ منْ إضَمٍ","بحَيثُ يلثِمُ فرْعَ الضّالَةِ البانُ",0,"ن",1,0],["تَبَطَّنتُها وَالقَيظُ ما بَينَ جالِها","إِلى جالِها سِتراً مِن الآلِ ناصِحُ",1,"ح",1,0],["تَبَطَّنْتُهُ بِالْقَوْمِ لَمْ يَهْدِنِي لَهُ","دَلِيلٌ وَلَمْ يُثْبِتْ لِيَ النَّعْتَ خَابِرُ",2,"ر",1,0],["تبطيء عن الجلى سريعٍ إلى الخنا","ذلولٍ بأجماع الرجال ملهد",3,"د",1,0],["تَبَطَّنتُهُ تَعدو بِبِزِّيَ نَهدَةٌ","جُلالَةُ ما بَينَ الشَراسيفِ وَاللُبدِ",4,"د",1,0],["تَبطَّلَ كُلٌ بالأَماني وَلَم يَزَل","يَروحُ وَيَغدو وَهوَ لِلمَوتِ مَغنَمُ",5,"م",1,0],["تبطنت فيها بدر تم مشنَّف","ولم أتبطن كاعباً ذاتَ خلخالِ",6,"ل",1,0],["تبطَّنه خائضاً نفعَهُ","يُقَلَّص عن ساقه المِئزرُ",7,"ر",1,0],["تَبطَّنَ كلَّ وادٍ كلُّ نادٍ","تَطيرُ به المَطِيُّ بلا جَناحِ",8,"ح",1,0],["تبطل الدعوى من اللحظ ولا","بأسَ في وِرد الردى للبطلِ",9,"ل",1,0],["تَبطَّن غيًّا واستباح محرَّمًا","وحرَّم من هذي الحياة حلالها",10,"ل",3,0],["تبطن الوادي الأغن ملعبا","فيه تهادى بالحلي واحلل",11,"ل",1,0],["تبطنت منا الحب لا من مودة","ولكن جزاء السهد والبرحاء",12,"ا",2,0],["تبطن منثور الغبار جفونه","فضرج منها مقلةً تتحسف",13,"ف",1,0],["تبطنت السرى فتعاورتني","مقلبة القلوب على اضطرام",14,"م",1,0],["تَبَطَّنَها فَطَلّقَها ثَلاثاً","عَلى عِزِّ التَمَلُّقِ والخِلابِ",15,"ب",1,0],["تبطنه وتنقش فوقه","من وشيها غررا",16,"ر",2,0],["تبطي علي وانا هنا واتحراك","كبدي لواهيب الصبر تشتويها",17,"ي",3,0],["تبطي تفرق عن سبوقه شليله","لا قيل لك دونك حباري ٍ مخامير",18,"ر",1,0],["تبطي عظم واحلامها يا هي احلام","ما يدروا انّ الدين ربّي / أقامه",19,"م",2,0],["تبطي تجاريهم خفافيش الاضداد","مهما يحيكوا كل ابوها أماني",20,"ن",2,0],["تبطنته والليل يسودّ وجهه","وللغيم في أرجائه جيش نوبان",21,"ن",1,0],["تبطِّنهُ خائضاً نقعهُ","يقلَّصُ عنْ ساقهِ المئزرُ",22,"ر",1,0]]}