"],[5370,"ضايقه","https://www.poetsgate.com/ViewPoem.aspx?id=87582",""],[333,"نشيد الصفاء","https://www.poetsgate.com/ViewPoem.aspx?id=101256",""],[5421,"العيد..وبلادي","https://www.poetsgate.com/ViewPoem.aspx?id=213057",""],[5431,"مثل شمس لن تنطفي ياشآمُ","https://www.poetsgate.com/ViewPoem.aspx?id=197561",""],[5433,"جابك الله","https://www.poetsgate.com/ViewPoem.aspx?id=36260",""],[5455,"الحصاد","https://www.poetsgate.com/ViewPoem.aspx?id=36402",""],[5550,"أنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=211701",""],[5606,"الثقه متبادله بين الثقات","https://www.poetsgate.com/ViewPoem.aspx?id=196664",""],[5732,"ونات الحشا","https://www.poetsgate.com/ViewPoem.aspx?id=177861",""],[5747,"ياعطاشا عطشنا","https://www.poetsgate.com/ViewPoem.aspx?id=61669",""],[5751,"إطلالة","https://www.poetsgate.com/ViewPoem.aspx?id=214789",""],[5829,"إنما الله غفور","https://www.poetsgate.com/ViewPoem.aspx?id=171624",""],[5937,"لا يُجيدُ الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=211809",""],[5937,"بَين رِمشَين","https://www.poetsgate.com/ViewPoem.aspx?id=211818",""],[5956,"البعوضة","https://www.poetsgate.com/ViewPoem.aspx?id=183349",""],[5970,"إيه يا دنيا اخدعي من تخدعين","https://www.poetsgate.com/ViewPoem.aspx?id=130579",""],[4442,"بالأعالي فتنت لا بالأسافل","https://www.poetsgate.com/ViewPoem.aspx?id=171204",""],[6093,"لك يا سلوى بقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=176425",""],[6102,"هذه ليلتي","https://www.poetsgate.com/ViewPoem.aspx?id=182769",""],[6102,"ذَبح !!","https://www.poetsgate.com/ViewPoem.aspx?id=183996",""],[6152,"أمتي","https://www.poetsgate.com/ViewPoem.aspx?id=203274",""],[520,"هل لميعادك الكريم تمام","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577695",""],[6184,"رقصة في ازمير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78622&r=&rc=14",""],[6344,"شعلة من وقود الغياب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87982&r=&rc=22",""],[6355,"مناجاة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66603&r=&rc=63",""]],"verses":[["كُلَّما جَدَّ البُكاءُ بِهِ","دَبَّتِ الأَسقامُ في بَدَنِه",0,"ن",2,0],["كُلَّمَا جَدَّ ذِكْرُهُ بِيَ جَدَّتْ","يَقْظَةٌ فِي الجِرَاحِ مِنْ تَهْوِيمِ",1,"م",1,0],["كُلَّمَا جَدَّدَ الفِدَى جَدَّدْتَ فِيهِ","حَيَاةً لِبَالِيَاتِ العِظَامِ",2,"م",1,0],["كُلَّمَا جِئْتُهُ وَقَلْبِي بَاكٍ","رَقَّ دَمْعِي كَماَئِهِ فَهْوَ بَاسِمْ",3,"م",1,0],["كلما جال لحظها ترك النا","س سكارى وما هم بسكارى",4,"ر",2,0],["كلما جئتُ قاصداً لسلامٍ","ردَّني عن لقائكَ البوَّابُ",5,"ب",1,0],["كلّما جُدتَ لي تبعتُك في الجو","دِ فبذَّرتُ يمنةً وشمالا",6,"ل",2,0],["كُلَّما جاءَ إِلَيهِ خائِنٌ","واشِياً قَرَّبَه وَاِستَزوَرَه",7,"ر",2,0],["كُلَّما جَدَّت لِكَي تُدرِكَهُ","وَجَدَتهُ صارَ في الأَرضِ وَراها",8,"ا",3,0],["كلما جئت منه اقرأ فصلا","اسبلت عيني فوقه دمعتين",9,"ن",1,0],["كلما جستها الانامل منه","شملت ارواحا لنا الافراح",10,"ح",1,0],["كلما جئتكم بها","دية قلتم كفر",11,"ر",1,0],["كلما جئته مُلمّاً تجلّت","لي من تحت أسّه العلياء",12,"ا",2,0],["كلّما جال في مبانيه طرفي","لمعت لي من جُدره العلياء",12,"ا",2,0],["كُلَّما جِئتَهُ تَهَلَّلَ بِشراً","مِن جَميعِ الجِهاتِ وَاِفتَرَّ ثَغرا",13,"ر",2,0],["كُلَّما جَرَّدَ المُحاصِرُ سَيفاً","قَطَعَ السَيفَ رَأيُكَ الصَمصامُ",14,"م",1,0],["كُلَّما جادَتِ الظُنونُ بِوَعدٍ","عَنكَ جادَت يَداكَ بِالإِنجازِ",15,"ز",1,0],["كُلَّما جِئتُهُ تَعَرَّفتُ مَجداً","مُستَفاداً لِلطَرفِ فيهِ مَجالُ",16,"ل",1,0],["كُلَّما جِئتُ زائِراً","قالَ لي أَنتَ نائِمُ",17,"م",1,0],["كُلَّما جاءَتِ اللَيالي بِإِحسا","نٍ فَبادي إِحسانَها إِحسانُه",18,"ن",2,0],["كُلَّما جَمَّعَت شَمائِلُهُ الفَض","لَ تَداعَت أَموالُهُ بِالشَتاتِ",19,"ت",1,0],["كلما جَدَّ بها الوَجْدُ إلَى","غايَة لَمْ تَدْرِها إلاَّ ظُنُونا",20,"ن",2,0],["كُلَّما جاءَتِ الدَّنانيرُ","يَنْقَضُّ عليها البَهاءُ كالشَّيْطانِ",21,"ن",1,0],["كُلَّما جِئتُ أَبتَغي النَيلَ مِنهُم","بَدَروني قَبلَ السُؤالِ بِياسِ",22,"س",1,0],["كلّما جمّشكَ الإلحاحُ","أو إن رمتُ وصلَك",23,"ك",1,0],["كُلَّما جِئتُ لِوَعدٍ","كانَ مُمسىً في تَبابِ",24,"ب",1,0],["كلما جئتك راجعت الصبا","فأبت أيامه أن ترجعا",25,"ع",2,0],["كُلَّمَا جَازَ غَايَةً","رَامَ أُخْرَى بِلاَ صَلَفْ",26,"ف",1,0],["كُلَّمَا جُزْتَ فِي الْبلاغَةِ شَأْواً","وَاسْتَزَادُوا مَنَحْتَهُمْ مَا اسْتَزَادُوا",27,"د",3,0],["كُلَّمَا جَدَّ مَا يُصَوِّرُهَا لِي","أَو يُدَانِي ذَكْرُتُهَا بِارْتِعَادِ",28,"د",1,0],["كُلَّمَا جَالَ ذِكْرُهُ فِي مَقَامٍ","فَاحَ ذَاكَ الْمَقَامُ طِيباً وَنَدَّا",29,"د",2,0],["كُلَّما جَذَبوهُ","لِيُلاقي الرُشدَ هاما",30,"م",2,0],["كلُّ ما جاءَ به من معجزٍ","سحَر الألبابَ: قرأنٌ تلاه",31,"ا",2,0],["كلما جد أننا قد كشفنا","أوجها دلنا عليها اللثام",32,"م",1,0],["كُلّما جاءَتِ اللّيالي بإحْسَا","نٍ، فَبادي إحْسَانِهْ",33,"ن",2,0],["كلّما جاء إليه خائن","واشيا قرّبه واستوزره",34,"ر",2,0],["كلّما جدّل منّا بطل","زغردت في زحمة الهول النّساء",35,"ا",2,0],["كُلَّما جاءَ الدُّجى في ثَوبِهِ","غابَ نَجْمي وتَوارى في (الزَّمالِكْ)",36,"ك",1,0],["كلّما جادت الليالي بفنٍّ","منه صابت أيامُهنّ بضربِ",37,"ب",1,0],["كُلَّما جِئتُ أَشتَكي ضَعفَ شُكري","عَن عَطاياهُ لَجَّ في الإِضعافِ",38,"ف",1,0],["كلّما جدّدت عدّتها","جدّدت لي عدتي ألما",39,"م",2,0],["كل ما جمعت وأنت حيّ مال","ك في حال قادر",40,"ر",1,0],["كلَّما جاءَهم بآيةِ صدقٍ","كَذّبوه فيها وبالإفك جاؤوا",41,"ا",1,0],["كُلَّما جاءَها بعبءٍ ثقيلٍ","هوّنتهُ فخفّت الأعباءُ",41,"ا",2,0],["كلّما جئتها وعندي سؤال","جاءني حسنها بألف جواب",42,"ب",1,0],["كلما جاع ملهم أشبعتهُ","قبلات الهوى وروّاه شهد",43,"د",1,0],["كلّما جئتني تنادين يا عَب","دي وفي مقلتيك روح الولاءِ",44,"ا",2,0],["كلما جاءهم نبي سلام","رجموه بحاصب شهوي",45,"ي",1,0],["كلما جال بفكري خاطر","بددته خشيتي من فشلي",46,"ل",2,0],["كُلّما جَرَّدوا ظُبيً من غُمودٍ","بُدِّلَتْ من طُلي المُلوكِ غُمودا",47,"د",2,0],["كُلَّما جَدَّدتُ مَدحي فيكُمُ","قالَ ذو النَصبِ نَسيتَ السَلَفا",48,"ف",2,0],["كلَّما جالتْ به أفكارنا","من ثناءٍ وَجَدَتْ فيه مجالا",49,"ل",2,0],["كلّ ما جئت به مبتكر","من عموم النفع فعلاً يتعدَّى",50,"د",2,0],["كلَّما جرّدته من غمده","كانَ برقاً في أياديك ورعدا",50,"د",2,0],["كُلَّما جَيَّشَ الجيوشَ لحربٍ","أَقبلَتْ وَهْيَ تحمِلُ الإِقبالا",51,"ل",2,0],["كلما جُرِّدا بمعركة لم","يبقَ من باطلٍ ولا إبطالِ",52,"ل",1,0],["كلما جاء عيد عامي نادي","أنت عيدي وبهجتي والمراد",53,"د",1,0],["كلما جدَّدَ الشجيُّ ادِّكارَهْ","أزعج الشوق قلبه واستطارَهْ",54,"ر",2,1],["كُلَّما جاءَنا بِكافورِ غَيمٍ","جاءَ في عَقبِهِ بِمِسكِ رَذاذِ",55,"ذ",1,0],["كلَّما جازه غمامٌ نزيحٌ","جاءَه مُثقَلُ الرَّبابِ دَلوحُ",56,"ح",1,0],["كلما جدت المسير أعيقت","بأسارى أبصارهم أعماها",57,"ا",3,0],["كُلَّما جَفَّ نَضِيرٌ","أطلعَ الرَّوض بديلاً",58,"ل",2,0],["كُلَّما جَادَلني العا","ذِلُ فيهِ وَلَحاني",59,"ن",2,0],["كُلَّما جاوَزَت مِنَ الأَرضِ ميلاً","عَنَّ ميلٌ لَنا وَأَعرَضَ ميلُ",60,"ل",1,0],["كلَّما جئناه قالوا","شُغِلَ القاضي بصومهِ",61,"م",2,0],["كُلَّما جَرّ مُترَفُونَ ذُيولَ ال","فِسقِ تَيهاً جَرَرت ذَيلَ العَفافِ",62,"ف",1,0],["كُلّما جاءَ صَباحٌ","ظَلَّ يَتلوهُ المَساءُ",63,"ا",2,0],["كُلَّمَا جئْتُ حَالَ دُونِي حِجَابٌ","وَتَعالَتْ لَهُ عَلَيَّ الْهُمُمُ",64,"م",1,0],["كلما جدتم بطيف خيال","لا أبالي بمن تَمد حبالي",65,"ل",2,0],["كُلَّمَا جَرَّدَ الظُّبَى مِنْ غُمُودٍ","رَدَّهَا مِنْ طُلاَ العِدَى فِي غُمُودِ",66,"د",1,0],["كلما جدد يوماً","توبة ضيعت أخرى",67,"ر",2,0],["كلما جاس خليل خلالا","منع الرائد من ان يجوسا",68,"س",2,0],["كلما جئت قال لي","ما هو الآن جالس",69,"س",1,0],["كلَّما جدَّ في ركابكَ سيرٌ","جدَّ للاشتياقِ فيها اعتسافُ",70,"ف",1,0],["كلما جادها الإله بنورٍ","خاله من جبين عارف أشرق",71,"ق",1,0],["كلما جاءت الليالي بأنس","لست أنسى ما عشت ليلة أنسي",72,"ي",1,0],["كلما جال طرفه ترك النا","س سكارى وماهم بسكارى",73,"ر",2,0],["كلّما جنّ الدّجى تطلع من","جبهة الآفاق كالبدر الأتم",74,"م",1,0],["كلما جال منظر الفكر فيها","فرأى غير أنه ما رآها",75,"ا",3,0],["كُلَّما جَلَّ جَلَّ عَن شِيَمِ الكِب","رِ وَمَن جانَبَ التَكَبُّر جَلّا",76,"ل",2,0],["كلما جاذبت معاطفه الأرداف خ","اف الضعيف بطش القويِّ",77,"ي",1,0],["كلّ ما جئتُ به","عن خطيبٍ مصقعِ",78,"ع",1,0],["كلما جئتنا بعام جديد","كان للعصر فيك مجد جديد",79,"د",1,0],["كلما جن غيهب الشعر منها","أطلع الوجه من سناها شموسه",80,"س",2,0],["كلما جن غيهب الشعر أبدى","صبح زاهي جبينه لي بريقا",81,"ق",2,0],["كلما جاد لي الزمان بقرب","منعتني من العناق الدواعي",82,"ع",2,0],["كلما جادت الليالي بوعد","ماطلتني الدنيا مطال الغريم",83,"م",1,0],["كلما جال طرف طرفيَ فيه","رسم الطرف فوق خدك خالا",84,"ل",2,0],["كلما جاد لي الفكر بشعر","فهو جرحٌ في الحشا من يد دهري",85,"ي",1,1],["كل ما جاش بالنفوس فشعر","قيل أو لم يقل لديّ سواءُ",86,"ا",2,0],["كلما جاءني أخ أو صديق","رابه عند رؤيتي ما يريب",87,"ب",1,0],["كلما جمع اختياري حطاما","فرقته منى يد الأضطرار",88,"ر",1,0],["كلما جئتهم لأنشد شعري","طمعا من نوالهم باليسير",89,"ر",1,0],["كلما جبت طريقا شاسعا","ضاق بي ذرعا وأولاني غرورا",90,"ر",2,1],["كلما جاء خائضا لجج البح","ر يقول الأعداء جاء ثبير",91,"ر",1,0],["كلما جردت رأيا مغمدا","أصلح الله به ما أفسدا",92,"د",2,0],["كلما جولت عَيني هيجت","لهبا في وسط قَلبي قد وَقَد",93,"د",1,0],["كُلَّما جئتُ راغِباً في فُؤادٍ","قالَ مهلاً ما أَنتَ بِالمُستَطيعِ",94,"ع",1,0],["كلما جنَّ ليله سلسلته","عينه بالدموع إذ فيه جنه",95,"ن",2,0],["كلّما جنّ الدّجى تطلع من","جبهة الآفاق كالبدر الإثم",96,"م",1,0],["كُلَّمَا جئْتُ حَالَ دُونِي حِجَابٌ","وَتَعالَتْ لَهُ عَلَيَّ الْهُمُومُ",97,"م",1,0],["\"كلّما جئتُ لأطوي صفحة\"","فتحَ القلبُ جميعَ الصفحاتْ",98,"ت",1,1],["كُلَّمَاْ جَاْدَتْ يَطِيْبُ الْمُلْتَقَىْ","وَيَفِيْضُ الشُّهْدُ فِيْ بَحْرِ غَوَاْهَاْ",99,"ا",3,0],["كلما جَدَّ من جديدٍ يُلاقي","فيكِ حِضناً يَحنُو إليهِ وأُنسَا",100,"س",2,0],["كلما جلت في خرائط أمس","أقتفي من خطوطها الرسمَ درسا",101,"س",2,0],["كلما جتني ،،،وعزمت اهرج","القلم فالجيب والدفتر هنيه",102,"ي",2,0],["كُلَّمَا جِئْتَ بِالجِرَارِ تَدَلَّتْ","لَذَّةُ الكَرْمِ والْعَطَايَا اقْتِدَارُ",103,"ر",1,0],["كُلَّمَا جِئْتَ بِالشُّعُورِ نَسِيماً","أَتَمَاهَى بِأُقْحُوَانِ الْعَلِيلِ",104,"ل",1,0],["كل ماجيت اريح فالزمان اللدود","لدني وقتي اللي منه ذا الراس شاب",105,"ب",1,0],["كل ما جيت أتريّح وأرتكي","يزدحم في خاطري ألفين بيت",106,"ت",1,0],["كلّما جاءهم نبيّ سلام رجموه بحاصب شهويِّ","ليتهم حين قدّسوا الطينَ كَفُّوا عن أذى ناسك وإفناءِ حيِّ",107,"ي",1,0],["كُلما جئتُ يابلادي أغني","جاوبتني من المآسي رُعودُ",108,"د",1,0],["كلما جزّ رأسه زادَ رأسا","بينما الحق مفردٌ لا ازدحامُ",109,"م",1,0],["