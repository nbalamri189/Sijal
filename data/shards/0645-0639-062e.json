{"poems":[[302,"مزجت كأسها بخمر وريق","https://www.aldiwan.net/poem33212.html","الخفيف"],[487,"سما قدرا","https://www.aldiwan.net/poem24376.html","عموديه"],[543,"هل أريك النجوم صارت بدورا","https://www.aldiwan.net/poem48187.html","عموديه"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119981","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56291","الخفيف"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55888","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112832","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[3570,"","https://poetry.dctabudhabi.ae/diwan/poem/35912","الخفيف"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66376","الخفيف"],[3658,"","https://poetry.dctabudhabi.ae/diwan/poem/199178","الرمل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135490","المديد"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133067","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139758",""]],"verses":[["مَع خَلٍّ من الملام خليٍّ","وَرَفيقٍ مهذَّبٍ بي رَفيقِ",0,"ق",1,0],["مع خليل هو بدرا","قد حاز فخرا",1,"ا",1,0],["معَ خيرِ الوُفودِ من كلِّ شهمٍ","به طرفُ العَلياءِ باتَ قَريرا",2,"ر",2,0],["مع خود تثني نبحسن التثني","عزم صبري عن سلوة وإجتنابِ",3,"ب",1,0],["مع خرافٍ سعت ومع ثيرانٍ","بات كل لديه منها مُهذَّبْ",4,"ب",1,0],["مع خير تسليمٍ ونعم تحية","يزكو شذاها في الأنام ويعبقُ",5,"ق",1,0],["مع خير قرب مع شريف عناية","عظمى على سير على حسن السنن",6,"ن",1,0],["مع خبن جزءي الخفيف ثم كف","جزءي مضارع كطي ائتلف",7,"ف",1,0],["مع خمرة لذت لشاربها بلا","غول ولا داء ولا نقصان",8,"ن",1,0],["مَع خَطٍّ كَأَنَّهُ أَرجُلُ البَطّ","أَو الحَطِّ في ذَوي الفِتيانِ",9,"ن",1,1],["مع خل عن الحلّي غنّى","ليس للقلب غيره من حبيب",10,"ب",1,0],["مع خليل باش مصر وكذا","الصعيدي بيك والأفرنج الأخش",11,"ش",1,0],["مع خدٍّ مثل وردٍ","وعيونٍ فاتراتِ",12,"ت",1,0],["مع خل حالي التبسام","من فاق البدور",13,"ر",1,0],["مَع خامس النجباء من","أهل الكسا أضحى سميّا",14,"ي",2,0]]}