https://poetry.dctabudhabi.ae/diwan/poem/29274","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86453","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91046","الكامل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81242","المجتث"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136606",""],[4545,"","https://poetry.dctabudhabi.ae/diwan/poem/216346",""],[4691,"سُفُنُ الْوجْدِ","https://www.poetsgate.com/ViewPoem.aspx?id=60178",""],[4764,"فضه والماس","https://www.poetsgate.com/ViewPoem.aspx?id=27738",""],[4869,"موضه جديده","https://www.poetsgate.com/ViewPoem.aspx?id=151666",""],[4875,"مِيسَم العشّاق","https://www.poetsgate.com/ViewPoem.aspx?id=134919",""],[4927,"اِسْمُ عَفْرَاْء","https://www.poetsgate.com/ViewPoem.aspx?id=29841",""],[3271,"التائهة","https://www.poetsgate.com/ViewPoem.aspx?id=131013",""],[5121,"هَذَا أَبِي","https://www.poetsgate.com/ViewPoem.aspx?id=33665",""],[5185,"انتباه","https://www.poetsgate.com/ViewPoem.aspx?id=73863",""],[5277,"مذاكرة","https://www.poetsgate.com/ViewPoem.aspx?id=213621",""],[5351,"المتناثر في يد الضياع","https://www.poetsgate.com/ViewPoem.aspx?id=201919",""],[5431,"من ذا الذي في عشقه لاينزف؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=190744",""],[5431,"حرّة تتربع ...","https://www.poetsgate.com/ViewPoem.aspx?id=210279",""],[5596,"بين السبحية والحمراء","https://www.poetsgate.com/ViewPoem.aspx?id=206360",""],[5691,"بيت الغرابيب","https://www.poetsgate.com/ViewPoem.aspx?id=206248",""],[5717,"يهدي الى الدين وناهيك به","https://www.poetsgate.com/ViewPoem.aspx?id=170594",""],[5781,"أناقة العشق...وتصبُّري","https://www.poetsgate.com/ViewPoem.aspx?id=210380",""],[5783,"زوجتي الحبيبة","https://www.poetsgate.com/ViewPoem.aspx?id=61545",""],[5848,"أوقات","https://www.poetsgate.com/ViewPoem.aspx?id=48877",""],[5917,"يلذ بهذا العيش من ليس يعقل","https://www.poetsgate.com/ViewPoem.aspx?id=106531",""],[5956,"قممُ الوعي","https://www.poetsgate.com/ViewPoem.aspx?id=185610",""],[5992,"لَيِّنَةُ الأعطافِ لا","https://www.poetsgate.com/ViewPoem.aspx?id=41823",""],[6070,"ما أجملَ الشِّعرَ حِينَ الرُّوحُ تَسْكبُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=197535",""],[6124,"إلى لقاء","https://www.poetsgate.com/ViewPoem.aspx?id=154116",""],[6244,"ما هو الكون ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=510&r=&rc=3",""],[463,"هلْ لقتيلٍ على اللِّوى ثائرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60089&r=&rc=145",""]],"verses":[["يُنَهنَهُ بِالأَعداءِ وَهوَ مَصَمِّمٌ","وَيَزجَرُ بِالعُذّالِ وَهوَ مُنيلُ",0,"ل",1,0],["يَنها في حِماهُ وهي سارِحَةٌ","مِثلَ القُصور قد اهتَزَّت أعاليها",1,"ي",3,0],["يَنهى جَفاؤُكِ عَن زِيارَتِيَ الكَرى","كَيلا يَزورَ خَيالُكِ المُعتادُ",2,"د",1,0],["يَنهى العَواذِلَ يَأسٌ مِن مَلامَتِنا","وَالعيسُ عُرضَ الفِجاجِ الغُبرِ يَخدينا",3,"ن",2,0],["يَنهَضنَ في كُلِّ مَخشِيِّ الرَدى قَذَفٍ","كَما تَقاذَفَ في اليَمِّ المَرازيبُ",4,"ب",1,0],["يَنهَينَ مَن عَلِقَ الهَوى بِفُؤادِهِ","حَتّى اِستُبينَ بِسَمعِهِ تَوقيرُ",5,"ر",1,0],["ينهلّ منه القصد في منجحٍ","ويلجأ الجيش إلى منجع",6,"ع",1,0],["ينهي إلى همَّتك المشتكى","وإنَّما يشكو إلى العاليه",7,"ه",1,0],["يَنْهي النديم عن القبيح بلحظِه","وعلى المدامة والسماع مُساعدُ",8,"د",1,0],["ينهاه عن مأثمٍ تُقى ورعٍ","فيه وعن مدنس نُهى أَنِف",9,"ف",1,0],["يَنهَشنَهُ وَيَذُبُّهُنَّ وَيَحتَمي","عَبلُ الشَوى بِالطُرَّتَينِ مُوَلَّعُ",10,"ع",1,0],["يُنَهنِهُني الحُرّاسُ عَنها وَلَيتَني","قَطَعتُ إِلَيها اللَيلَ بِالرَسَفانِ",11,"ن",1,0],["يُنهِلُ الصَّعدَة حتّى إِذا مَا","نَهِلَت كانَ لَها مِنهُ عَلُّ",12,"ل",1,0],["ينهكني حملكم الثقيل","وليس عندي لكم جميل",13,"ل",1,0],["يُنهِضُ اللَهُ الصِناعاتِ بِهِ","مِن عِثارٍ لَبَثَت فيهِ الأَبَد",14,"د",1,0],["يَنهارُ الاِستِبدادُ حَولَ عِراصِهِ","مِثلَ اِنهِيارِ الشِركِ حَولَ صَلاحِ",15,"ح",1,0],["يَنهَضنَ بِالثِقلِ لا تُعطى النُهوضَ بِهِ","أَعناقُ مُجفَرَةِ الهوجِ الهَراجيبِ",16,"ب",1,0],["يَنهَسنَ أَذرُعُهُنَّ حينَ عَهِدنَها","وَمَكانُ جُثوَتِها لَهُنَّ دُوارُ",17,"ر",1,0],["يَنهَشُ في السَبقِ وَإِن لَم يَشغَبِ","حَتفِ الحُبارى وَعِقالِ الأَرنَبِ",18,"ب",1,0],["يَنهاهُ عن حِرصِ الغَبيِّ وَجُبْنِهِ","أنّ المحَارِمَ بالدّماءِ تُصانُ",19,"ن",1,0],["ينهَى عن الأصنامِ وَهْي بموضعٍ","تُمْحَى حَوالَيْهِ النُّفوسُ وتُمحَقُ",20,"ق",1,0],["يَنهَلُّ صَيِّبُها فَيثني عَطفَهُ","مَرَحاً وَيَزخرُ سَيلُها فَيُراحُ",21,"ح",1,0],["ينهاكما أن تفعلا ويَخافُها","مشبوبةً تَجرِي جَوانِبُها دما",22,"م",2,0],["يَنهى لِسانُكَ عَن شَيءٍ مُنافَقَةً","وَالسِرُّ بِالشَيءِ يَنهى عَنهُ أَمّارُ",23,"ر",1,0],["ينهض بالملك العظيم فاتحه","لأنه من الثرى مفاتحه",24,"ه",1,0],["يَنْهَلُّ صارِمُهُ حَتْفاً وَمنْطقُهُ","سِحْراً حَلالاً إِذَا ما صَالَ أَوْ خَطَبَا",25,"ب",2,0],["يُنْهَى إِلى ثَاوِي الْجِنَا","نِ فَيَسْتَجِيبُ وَقدْ دُعِي",26,"ع",2,0],["يُنَهْنَهُ عَنْ إِسْرَافِهِ غَيْرَ مُنْتَهٍ","كَأَنَّ بِهِ جَهْلاً وَلَيْسَ بِهِ جَهلُ",27,"ل",1,0],["ينهَى ويأمر هادياً","أفْدِيه من ناهٍ وآمرْ",28,"ر",1,0],["ينهي، ويأمر في الدنيا، وفي يده","بعد المقادير إشقاءُ وإِسعاد",29,"د",1,0],["ينهضُ الزرعُ بعدَ حصدٍ وقد","يُجتثُّ من أصله فؤادٌ كئيب",30,"ب",1,0],["ينهي ويأمر والدخان","يكاد أن يغشى عيونه",31,"ن",2,0],["ينهى ويأمر كلَّ حادثةٍ","فتطيع وهْي له من الخدم",32,"م",1,0],["ينهلُّ وابلُها كما ينهلُّ مِنْ","يُمْنى أبي الفضلِ الكريمِ أيادي",33,"د",2,0],["يُنَهْنِه قلبي ذِكرُكُم وحديثُكُم","وتُتْلِفُه يومَ الفراقِ لِحاظُ",34,"ظ",1,0],["يَنْهَب ياقوتُها العيونَ فما","يَكْملُ إلاَّ من حيث يَنْتَهب",35,"ب",1,0],["يَنهَبُهُ كَرُّ اللَيا","لي وَاِختِلافُ الحِقَبِ",36,"ب",1,0],["يُنَهْنِهُهَا مَتَى نَهَدَتْ لِحَرْبِي","ويَأْخُذُ لِي الأَمَانَ مِنَ الزَّمانِ",37,"ن",1,0],["يَنْهَدُ فَرداً للخَميسِ الناهِد","في بادِئ مِنْ بأسِه وعائِد",38,"د",1,0],["يُنهي إِليك سلاماً جارك الجنبُ","وَإن يكن غير قاض بعض ما يجبُ",39,"ب",1,1],["يَنهى محبك انَّهُ مشتاق","وَالى حماكَ تهزه الأَشواق",40,"ق",1,1],["ينهشنها نهش السراحين الطلا","وصديدها لشرافها وثقالها",41,"ل",3,0],["ينهركم من خلفكم اسود","والبربري الجلف يستنهض",42,"ض",1,0],["ينهِّضُه سعيٌ بفضلك آنسٌ","له ثقةٌ نحو الغنى وسكونُ",43,"ن",1,0],["يَنهَى البعوضَ إذا رآنيَ عن","جِلدي ويأكلُ غائبا لحمي",44,"م",2,0],["ينهلُّ منحلَّ المَزادة موقناً","أنّ الثرى الظمآنَ منه ناهلُ",45,"ل",1,0],["ينهال تحت الرِّجل القويمة جا","لاها بما عمّقتْ يدُ الحافرْ",46,"ر",1,0],["يُنهضِه الكمالُ من أثقالِهِ","بأوسُقٍ تلفِظها الجلامدُ",47,"د",1,0],["يُنهل الصعدةَ من أقرانه","ويلبي طارق الليل البهيم",48,"م",1,0],["ينهب صبري بيدٍ","ما ليدي بها قبل",49,"ل",1,0],["يُنَهْنِهُ الطَّرْفُ منها","جاماً ويملأُ جَامَهْ",50,"م",2,0],["ينهل بارق بشره منا ولم","يسمعك للوعد الجميل رعودا",51,"د",2,0],["يَنهَى عن السُّكْرِ المَعِيبِ جَليسَهُ","ويُبيحُ ذاك إذا تَفَنَّنَ مُنشِدا",52,"د",2,0],["يَنهَلُّ قَطرُ المَنايا مِن مَضارِبِهِ","كَأَنَّ مُزناً بِأَعلى مُزنِهِ سَكَبَه",53,"ب",2,0],["ينهار ما نبنيه في الدنيا ولا","ينهار صرح البرّ فهو وطيد",54,"د",1,0],["يَنهَى ويَأمُرُ حيثُ لا المَلِكُ الذي","تَعنوا لَهُ الثَّقلانِ ناهٍ آمر",55,"ر",1,0],["ينهلُّ كالدّر منثوراً فتنظمهُ","انفاسُ شعري عِقداً كالنجوم جَلي",56,"ل",2,0],["ينهل المعدم من منهلها","شيما أكرم به من شبم",57,"م",1,0],["ينهى ويأمر لا مشير سوى ذوي","رشد ولا حكم سوى الخلّاق",58,"ق",1,0],["ينهلُ في أديمه الظ","مآنُ من غيرِ ثأط",59,"ط",1,0],["ينهالُ في سَمْعِ الصديق فيكتسي","جَذلاً وفي سمعِ العدو فَيُصْعَق",60,"ق",1,0],["يَنهَى وَيَأمرُ بِالمَعروفِ مُحتسباً","بِلينِ قَولٍ لهُ التأثيرُ في الحجَرِ",61,"ر",1,0],["يَنهى وَيَأمرُ بِالمَعروفِ مُحتسباً","وَلَيسَ يَأخذهُ في ذاكَ مِن خجلِ",62,"ل",1,0],["يَنهى وَيَأمُرُ لا حَياءَ يَصدُّهُ","عَن قَولِ حَقٍّ في الأنامِ وَيَصدَعُ",63,"ع",1,0],["ينهي مآثرك الكريمة من يرى","بعداده أن ينهي الأعدادا",64,"د",2,0],["ينهى مآثرك الكريمة من يرى","في نفسه أن ينهي الأعدادا",65,"د",2,1],["ينهشن كاذَتَه ويمنعُ لحمه","طَعنٌ يُصيبُ فَرائصاً ونُحُورا",66,"ر",2,0],["ينهل جودا والاكف جوامد","ويضيء بشرا والوجوه كوالحُ",67,"ح",1,0],["يَنهى الوَجى أَمثالَهُ عَنِ السَرى","وَساعَدَتهُ ميعَةٌ تَنهى الوَجى",68,"ا",1,0],["يَنْهَضْ بِرِيشٍ رافِعاً مُدَوِّمُهْ","يَرْكُضُ في جَوِّ السَماءِ سُلَّمُهْ",69,"م",2,0],["يَنْهَمْنَ في الذارِ الحَصَى المَنْهُوما","حَتَّى إِذا ما خاضَتِ البَرِيما",70,"م",2,0],["ينهض كل منهم من حينه","ولم يبال بفوات دينه",71,"ه",1,0],["ينهى وكلٌّ إلى ما","يقولهُ ينقادُ",72,"د",1,0],["ينهي لكم ما فيه من شغف إلى","رؤيا سنا أنوار تلك الطلعةِ",73,"ه",1,0],["ينهي التهاني لكم مستخلفاً ويفي","مستوجبات الدعا ما بين كل ملا",74,"ل",2,0],["ينهي إليك اسير الشوق صادقه","بما يفيدك في التذكار ذايقه",75,"ق",2,1],["ينهى ويأْمرُ لا يُطاقُ خلافُه","ولديهِ ذو حَذرٍ وآخر آملُ",76,"ل",1,0],["ينهلُّ من أَنملِهْ","دَرُّ الغنى لآمِلهْ",77,"ه",1,0],["ينهلُّ بالجود كفّاهُ ولا عجبٌ","أن يزخر البحرُ أو أن تهمىَ الدِّيمُ",78,"م",1,0],["ينهاه عن توظيف عبد صادق","عف الرِدا لا يستبيح محرما",79,"م",2,0],["ينهلّ دمعي مدراراً يفيض على","رمس الحبيب فيرويه ويحييه",80,"ي",2,0],["ينهى ويأمر وهو أبكم ناطقٌ","روح التّقدّم بين شقّيه استقرْ",81,"ر",1,0],["ينهى ويأمر في الريا","ح هلا هلم ويد سيري",82,"ر",2,0],["ينهار من هذر والصمت يثبته","والفر قبل اللحاق للجبان شفا",83,"ف",2,0],["يُنهِلُ مِن فَضلِهِ وَنائِلِهِ","ثَناءَ نَبتِ الحَيا عَلى رِهَمِه",84,"م",2,0],["ينهل في الأزمات نوء يمينه","كرماً وضوء جبينه يتهلل",85,"ل",1,0],["ينهى ويأمر والايام طائعةٌ","لهُ وليس يرى للأمر اهمالا",86,"ل",2,0],["ينهي اشتياقاً بالفؤاد مُلَخَّصاً","لا يستطيع الْكَتْبُ شَرْحَ غرامه",87,"م",2,0],["ينهلُّ من كفيه وبل سماحة","ينمو به غصن الرجاء فيثمر",88,"ر",1,0],["يَنهلُّ مِنهُ الطل فَوقَ معندم","وَيَسيح مني الدَمع فَوقَ مورس",89,"س",1,0],["يَنهى وَيَأمر جائِراً فَكَأَنَّما","نَسي العَصا وَمَهامز الكرباج",90,"ج",1,0],["يَنهى وَيَأمر رَبُّ الأَمر عَن سَفهٍ","وَلَيسَ يَعلم رَبُّ العلمِ ما جَهِلا",91,"ل",2,0],["ينهش الوحشَ ويَفرِىِ لَحمها","فاذا لم يشفِهِ أنقَى العِظَاما",92,"م",2,0],["ينهاك عن ترشاف معسول اللمى","إن هز عسال القوام وحرجا",93,"ج",2,0],["ينهلُّ منه الجبين الصلت عن عرقٍ","كأنه لؤلؤ في النحر مبدود",94,"د",1,0],["ينهل إِن سرت النَكباء في سحر","وَأَومض البَرق في الظلماء مِن إِضم",95,"م",1,0],["ينهى ويأمر في هواهُ بما يشا","لا مانعٌ لأجلّ ما هو آمر",96,"ر",1,0],["ينهل في السلم والهيجاء من يده","وسيفه الواكفان الجود والعلق",97,"ق",1,0],["ينهى عن البث المريح لسانه","فيموتُ مطوياً على أشواقه",98,"ق",2,0],["ينهب ما بين يديه نهبا","ويشرب الماء القراح العذبا",99,"ب",2,0],["يُنَهْنِهُهُ 