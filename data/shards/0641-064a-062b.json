{"poems":[[72,"في ثغرها الحلو أو في جيدها الحالي","https://www.aldiwan.net/poem19473.html","البسيط"],[51,"اسلم على الأيام","https://www.aldiwan.net/poem66009.html","المجتث"],[92,"أيها الحب أنت سر بلائي","https://www.aldiwan.net/poem38975.html","الخفيف"],[69,"يا سائلي عن الكلام المنتظم","https://www.aldiwan.net/poem28850.html","الرجز"],[102,"في ثنايا العجاج","https://www.aldiwan.net/poem32914.html","المتدارك"],[102,"لا تبالي بألف خطب عراها","https://www.aldiwan.net/poem32997.html","الخفيف"],[52,"عرف الدار فحيا وناحا","https://www.aldiwan.net/poem27159.html","المديد"],[46,"يرومك والجوزاء دون مرامه","https://www.aldiwan.net/poem23642.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39552","الخفيف"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20203","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202540","الرجز"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/66003","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"]],"verses":[["في ثغرها الحلو أو في جيدها الحالي","لا أرغم الله إلاَّ أنف عذَّالي",0,"ي",1,1],["في ثوب نُعمى جديد","مُذيَّل بالتمامِ",1,"م",1,0],["فَيُثِيرُ في النَّفْسِ الكَئيبةِ","عَاصِفاً لا يَرْكُدُ",2,"د",1,0],["في ثغرِهِ جواهرٌ غوالي","جلوتُها منظومةَ اللآلي",3,"ي",1,0],["في ثَنايا العَجاج","وَالتحام السُيوف",4,"ف",1,1],["في ثيابٍ تُريكَ عِزاً ولكنْ","حَشْوُها الذُّلُّ والرّياءُ سَدَاها",5,"ا",3,0],["في ثَرىً كَالمِسكِ شيبَ بِراحٍ","كُلَّما أَنبَتَهُ القَطرُ لاحا",6,"ح",2,0],["فيُثْني عليه ضَيْغَمٌ بزَئِيرِهِ","ويُثْني عليه شادِنٌ ببُغامهِ",7,"م",2,0],["في ثراها الغبيِّ وسَّدتُ أحلا","مي وماضي الهنيِّ من أوقاتي",8,"ي",1,0],["في ثَنايا الأَمواجِ وَالزَبَدِ المَن","دوفِ لاحَت أَكفانُنا وَالقُبورُ",9,"ر",1,0],["في ثقةٍ بمن به لا يوثَقُ","ولا يدوم عهدُه والمَوْثِقُ",10,"ق",1,0],["فَيُثيرُ النَّشيدُ ذكرى حياةٍ","حَجَبَتْها غُيومُ دَهْرٍ كئيبِ",11,"ب",1,0],["في ثيابٍ من الطبيعة وشّا","ها كما شاء مُبدِعُ الألوان",12,"ن",1,0]]}