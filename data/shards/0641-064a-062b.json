{"poems":[[108,"بأيكما أبكي","https://www.shoaraa.com/p12758",""],[72,"في ثغرها الحلو أو في جيدها الحالي","https://www.aldiwan.net/poem19473.html","البسيط"],[51,"اسلم على الأيام","https://www.aldiwan.net/poem66009.html","المجتث"],[92,"أيها الحب أنت سر بلائي","https://www.aldiwan.net/poem38975.html","الخفيف"],[69,"يا سائلي عن الكلام المنتظم","https://www.aldiwan.net/poem28850.html","الرجز"],[102,"في ثنايا العجاج","https://www.aldiwan.net/poem32914.html","المتدارك"],[102,"لا تبالي بألف خطب عراها","https://www.aldiwan.net/poem32997.html","الخفيف"],[52,"عرف الدار فحيا وناحا","https://www.aldiwan.net/poem27159.html","المديد"],[46,"يرومك والجوزاء دون مرامه","https://www.aldiwan.net/poem23642.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39552","الخفيف"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20203","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202540","الرجز"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/66003","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[100,"بشرى النبوءة","https://www.poetsgate.com/ViewPoem.aspx?id=50187",""],[112,"أيها الفاسي أتى ريحك","https://www.aldiwan.net/poem2369.html","مجزوء الرمل"],[118,"مسقط","https://www.aldiwan.net/poem24041.html","الخفيف"],[133,"قال ابن عبدم مجيب السائل","https://www.aldiwan.net/poem54349.html","الرجز"],[133,"أذكى حديث الغادة الماميضه","https://www.aldiwan.net/poem54695.html","الطويل"],[175,"ومن مليح الذنوب إن ذكرت","https://www.aldiwan.net/poem46059.html","المنسرح"],[190,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[211,"علقت اهيف لدن القوام","https://www.aldiwan.net/poem13353.html","السريع"],[212,"شاعر البحر إلى البحر يعود","https://www.aldiwan.net/poem46604.html","الرمل"],[222,"قد عشقناك لا لأنك أنثى","https://www.aldiwan.net/poem55278.html","الخفيف"],[230,"رضيت بحكم سابقة القضاء","https://www.aldiwan.net/poem51267.html","الوافر"],[236,"لو أن قلبك مثل قلبي مغرم","https://www.aldiwan.net/poem31768.html","الكامل"],[236,"أياعضد الدين شكوى فتى","https://www.aldiwan.net/poem32171.html","المتقارب"],[257,"يا من به تتباهى","https://www.aldiwan.net/poem48355.html","المجتث"],[271,"الشام يقهر والعراق يضام","https://www.aldiwan.net/poem35641.html","الكامل"],[283,"في مدحي الصاحب ماض عزمي","https://www.aldiwan.net/poem32459.html","الرجز"],[343,"شارد اللب والفكر","https://www.aldiwan.net/poem55314.html","مجزوء الخفيف"],[343,"في كريم المرابع","https://www.aldiwan.net/poem55315.html","مجزوء الخفيف"],[343,"يا نفس ما لك تنشرين","https://www.aldiwan.net/poem55350.html","مجزوء الكامل"],[395,"القصر والكوخ","https://www.aldiwan.net/poem24308.html","عموديه"],[433,"بين اللوى فالجزع فالمتثلم","https://www.aldiwan.net/poem12473.html","الكامل"],[433,"أبعد شيبي لشبابي إياب","https://www.aldiwan.net/poem12559.html","السريع"],[442,"يا من له وسط الفؤاد","https://www.aldiwan.net/poem14306.html","مجزوء الكامل"],[465,"حال من دونك يا أخت الكلل","https://www.aldiwan.net/poem3613.html","عموديه"],[552,"ألا بكها أم الأسى والمصائب","https://www.aldiwan.net/poem48060.html","الطويل"],[587,"هذا الذي أحبه","https://www.aldiwan.net/poem17421.html","مجزوء الرجز"]],"verses":[["فيثنى لهم بالأرض شرق بمغرب","ويقرن بالجوزاء عنهم عطارد",0,"د",1,0],["في ثغرها الحلو أو في جيدها الحالي","لا أرغم الله إلاَّ أنف عذَّالي",1,"ل",2,1],["في ثوب نُعمى جديد","مُذيَّل بالتمامِ",2,"م",1,0],["فَيُثِيرُ في النَّفْسِ الكَئيبةِ","عَاصِفاً لا يَرْكُدُ",3,"د",1,0],["في ثغرِهِ جواهرٌ غوالي","جلوتُها منظومةَ اللآلي",4,"ي",1,0],["في ثَنايا العَجاج","وَالتحام السُيوف",5,"ف",1,1],["في ثيابٍ تُريكَ عِزاً ولكنْ","حَشْوُها الذُّلُّ والرّياءُ سَدَاها",6,"ا",3,0],["في ثَرىً كَالمِسكِ شيبَ بِراحٍ","كُلَّما أَنبَتَهُ القَطرُ لاحا",7,"ح",2,0],["فيُثْني عليه ضَيْغَمٌ بزَئِيرِهِ","ويُثْني عليه شادِنٌ ببُغامهِ",8,"م",2,0],["في ثراها الغبيِّ وسَّدتُ أحلا","مي وماضي الهنيِّ من أوقاتي",9,"ت",2,0],["في ثَنايا الأَمواجِ وَالزَبَدِ المَن","دوفِ لاحَت أَكفانُنا وَالقُبورُ",10,"ر",1,0],["في ثقةٍ بمن به لا يوثَقُ","ولا يدوم عهدُه والمَوْثِقُ",11,"ق",1,0],["فَيُثيرُ النَّشيدُ ذكرى حياةٍ","حَجَبَتْها غُيومُ دَهْرٍ كئيبِ",12,"ب",1,0],["في ثيابٍ من الطبيعة وشّا","ها كما شاء مُبدِعُ الألوان",13,"ن",1,0],["في ثغره لغة الحاني بأمّته","وفي يديه لها سكّين جزّار !",14,"ر",1,0],["في ثِياب كَرَبيع","قَد سَرى فيها المحرَّم",15,"م",1,0],["في ثُغُورِ الجِبالِ وشمُ القوافي","قُبَلٌ هَيَّجَتْ هُنا أشجاني",16,"ن",2,0],["في ثالثِا العشرين والزُّبانا","خامسَ إبريلٍ له قد كانا",17,"ن",2,0],["في ثَغرِهَا بَعد الكَرَى عَنبَرٌ","أو شُهدةٌ أو خمرَةٌ صَافِيه",18,"ي",2,0],["فِي ثَوْبِ لَيْلٍ أَبْلَيْتُ جِدَّتَهُ","وَجادَ لِي سَيْرُهُ بِزَوْرَتِهِ",19,"ت",2,0],["في ثناءِ المثنينَ نعماء لكن","منكَ كانت عليهم النعماءُ",20,"ا",2,0],["في ثغره الحالي وفي كأسه","ربق حلال ومدام حرام",21,"م",1,0],["في ثناياه خفيفٌ من نسيم","وأعاصيرُ من الكرب المقيم",22,"م",1,0],["فيثير الهوى كوامن نفسي","وبها من مثاره ضعفان",23,"ن",1,0],["فيثِلبُني ويَرْجِعُ سالمِاً لم","تَهِجْك عليه أسبابُ الإخاء",24,"ا",2,0],["في ثَنيِ بُردَتِهِ قَضيبُ نَقىً فَفي","الدِرعِ المُفاضَةِ مِنهُ طَودٌ أَيهَمُ",25,"م",1,0],["فَيُثني عَليكَ لِسانُ الحَسودِ","بِإِنشادِها وَفَمُ العاتِبِ",26,"ب",1,0],["في ثوب صحة جسمٍ","مطرزٍ بالشفاء",27,"ا",2,0],["في ثأرِكم فتكاً وبَطشاً مِنهما","يَشفى الصَّدى الزّاقي ويُروَى الهام",28,"م",1,0],["في ثَلمِ ثَغرِ سَلوَتي جَدَّ فَلَي","تَ ثَغرَهُ يَجودُ لي بِلَثمِ",29,"م",1,0],["في ثنيَّات صدره","زفرة الهم والكدر",30,"ر",1,0],["في ثنايا صدورهم","انة في الاضالع",31,"ع",1,0],["فيثير شجوَ الشاعرين","رمز الالم",32,"م",1,0],["في ثلوج الجبال أو لهب الشم","س يريقون مبهجات الحياة",33,"ه",1,0],["في ثغرها دُرٌّ وفي وجَناتِها","وردٌ نضيرٌ أحمرٌ كالعندمِ",34,"م",1,0],["في ثغرها الشّهْدُ لعمري مُذابْ","طُوبى لمنْ يرشُفُ ذاك الرُضابْ",35,"ب",1,0],["في ثاني عشر واصل","أنا رايح أو مغلس",36,"س",1,0],["في ثناياهُ لمنْ يرشفها","أثرٌ هنَّ مجارٍ للقبل",37,"ل",1,0],["فَيَثلمُني مَن لا أراهُ بِناظري","وَيَجرحُني مَن ليسَ لِي بمحارِبِ",38,"ب",1,0],["في ثَغْرهِ وَناظِرَيْ","هِ عَذْبُه وَعضْبُهُ",39,"ب",2,0]]}