{"poems":[[72,"في ثغرها الحلو أو في جيدها الحالي","https://www.aldiwan.net/poem19473.html","البسيط"],[51,"اسلم على الأيام","https://www.aldiwan.net/poem66009.html","المجتث"],[92,"أيها الحب أنت سر بلائي","https://www.aldiwan.net/poem38975.html","الخفيف"],[69,"يا سائلي عن الكلام المنتظم","https://www.aldiwan.net/poem28850.html","الرجز"],[102,"في ثنايا العجاج","https://www.aldiwan.net/poem32914.html","المتدارك"],[102,"لا تبالي بألف خطب عراها","https://www.aldiwan.net/poem32997.html","الخفيف"],[52,"عرف الدار فحيا وناحا","https://www.aldiwan.net/poem27159.html","المديد"],[46,"يرومك والجوزاء دون مرامه","https://www.aldiwan.net/poem23642.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39552","الخفيف"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20203","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202540","الرجز"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/66003","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[109,"أيها الفاسي أتى ريحك","https://www.aldiwan.net/poem2369.html","مجزوء الرمل"],[115,"مسقط","https://www.aldiwan.net/poem24041.html","الخفيف"],[130,"قال ابن عبدم مجيب السائل","https://www.aldiwan.net/poem54349.html","الرجز"],[130,"أذكى حديث الغادة الماميضه","https://www.aldiwan.net/poem54695.html","الطويل"],[172,"ومن مليح الذنوب إن ذكرت","https://www.aldiwan.net/poem46059.html","المنسرح"],[187,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[208,"علقت اهيف لدن القوام","https://www.aldiwan.net/poem13353.html","السريع"],[209,"شاعر البحر إلى البحر يعود","https://www.aldiwan.net/poem46604.html","الرمل"],[219,"قد عشقناك لا لأنك أنثى","https://www.aldiwan.net/poem55278.html","الخفيف"],[227,"رضيت بحكم سابقة القضاء","https://www.aldiwan.net/poem51267.html","الوافر"],[233,"لو أن قلبك مثل قلبي مغرم","https://www.aldiwan.net/poem31768.html","الكامل"],[233,"أياعضد الدين شكوى فتى","https://www.aldiwan.net/poem32171.html","المتقارب"],[254,"يا من به تتباهى","https://www.aldiwan.net/poem48355.html","المجتث"],[268,"الشام يقهر والعراق يضام","https://www.aldiwan.net/poem35641.html","الكامل"],[280,"في مدحي الصاحب ماض عزمي","https://www.aldiwan.net/poem32459.html","الرجز"],[340,"شارد اللب والفكر","https://www.aldiwan.net/poem55314.html","مجزوء الخفيف"],[340,"في كريم المرابع","https://www.aldiwan.net/poem55315.html","مجزوء الخفيف"],[340,"يا نفس ما لك تنشرين","https://www.aldiwan.net/poem55350.html","مجزوء الكامل"],[391,"القصر والكوخ","https://www.aldiwan.net/poem24308.html","عموديه"],[429,"بين اللوى فالجزع فالمتثلم","https://www.aldiwan.net/poem12473.html","الكامل"],[429,"أبعد شيبي لشبابي إياب","https://www.aldiwan.net/poem12559.html","السريع"],[438,"يا من له وسط الفؤاد","https://www.aldiwan.net/poem14306.html","مجزوء الكامل"],[462,"حال من دونك يا أخت الكلل","https://www.aldiwan.net/poem3613.html","عموديه"],[549,"ألا بكها أم الأسى والمصائب","https://www.aldiwan.net/poem48060.html","الطويل"],[584,"هذا الذي أحبه","https://www.aldiwan.net/poem17421.html","مجزوء الرجز"]],"verses":[["في ثغرها الحلو أو في جيدها الحالي","لا أرغم الله إلاَّ أنف عذَّالي",0,"ي",1,1],["في ثوب نُعمى جديد","مُذيَّل بالتمامِ",1,"م",1,0],["فَيُثِيرُ في النَّفْسِ الكَئيبةِ","عَاصِفاً لا يَرْكُدُ",2,"د",1,0],["في ثغرِهِ جواهرٌ غوالي","جلوتُها منظومةَ اللآلي",3,"ي",1,0],["في ثَنايا العَجاج","وَالتحام السُيوف",4,"ف",1,1],["في ثيابٍ تُريكَ عِزاً ولكنْ","حَشْوُها الذُّلُّ والرّياءُ سَدَاها",5,"ا",3,0],["في ثَرىً كَالمِسكِ شيبَ بِراحٍ","كُلَّما أَنبَتَهُ القَطرُ لاحا",6,"ح",2,0],["فيُثْني عليه ضَيْغَمٌ بزَئِيرِهِ","ويُثْني عليه شادِنٌ ببُغامهِ",7,"م",2,0],["في ثراها الغبيِّ وسَّدتُ أحلا","مي وماضي الهنيِّ من أوقاتي",8,"ي",1,0],["في ثَنايا الأَمواجِ وَالزَبَدِ المَن","دوفِ لاحَت أَكفانُنا وَالقُبورُ",9,"ر",1,0],["في ثقةٍ بمن به لا يوثَقُ","ولا يدوم عهدُه والمَوْثِقُ",10,"ق",1,0],["فَيُثيرُ النَّشيدُ ذكرى حياةٍ","حَجَبَتْها غُيومُ دَهْرٍ كئيبِ",11,"ب",1,0],["في ثيابٍ من الطبيعة وشّا","ها كما شاء مُبدِعُ الألوان",12,"ن",1,0],["في ثِياب كَرَبيع","قَد سَرى فيها المحرَّم",13,"م",1,0],["في ثُغُورِ الجِبالِ وشمُ القوافي","قُبَلٌ هَيَّجَتْ هُنا أشجاني",14,"ي",1,0],["في ثالثِا العشرين والزُّبانا","خامسَ إبريلٍ له قد كانا",15,"ن",2,0],["في ثَغرِهَا بَعد الكَرَى عَنبَرٌ","أو شُهدةٌ أو خمرَةٌ صَافِيه",16,"ي",2,0],["فِي ثَوْبِ لَيْلٍ أَبْلَيْتُ جِدَّتَهُ","وَجادَ لِي سَيْرُهُ بِزَوْرَتِهِ",17,"ت",2,0],["في ثناءِ المثنينَ نعماء لكن","منكَ كانت عليهم النعماءُ",18,"ا",2,0],["في ثغره الحالي وفي كأسه","ربق حلال ومدام حرام",19,"م",1,0],["في ثناياه خفيفٌ من نسيم","وأعاصيرُ من الكرب المقيم",20,"م",1,0],["فيثير الهوى كوامن نفسي","وبها من مثاره ضعفان",21,"ن",1,0],["فيثِلبُني ويَرْجِعُ سالمِاً لم","تَهِجْك عليه أسبابُ الإخاء",22,"ا",2,0],["في ثَنيِ بُردَتِهِ قَضيبُ نَقىً فَفي","الدِرعِ المُفاضَةِ مِنهُ طَودٌ أَيهَمُ",23,"م",1,0],["فَيُثني عَليكَ لِسانُ الحَسودِ","بِإِنشادِها وَفَمُ العاتِبِ",24,"ب",1,0],["في ثوب صحة جسمٍ","مطرزٍ بالشفاء",25,"ا",2,0],["في ثأرِكم فتكاً وبَطشاً مِنهما","يَشفى الصَّدى الزّاقي ويُروَى الهام",26,"م",1,0],["في ثَلمِ ثَغرِ سَلوَتي جَدَّ فَلَي","تَ ثَغرَهُ يَجودُ لي بِلَثمِ",27,"م",1,0],["في ثنيَّات صدره","زفرة الهم والكدر",28,"ر",1,0],["في ثنايا صدورهم","انة في الاضالع",29,"ع",1,0],["فيثير شجوَ الشاعرين","رمز الالم",30,"م",1,0],["في ثلوج الجبال أو لهب الشم","س يريقون مبهجات الحياة",31,"ه",1,0],["في ثغرها دُرٌّ وفي وجَناتِها","وردٌ نضيرٌ أحمرٌ كالعندمِ",32,"م",1,0],["في ثغرها الشّهْدُ لعمري مُذابْ","طُوبى لمنْ يرشُفُ ذاك الرُضابْ",33,"ب",1,0],["في ثاني عشر واصل","أنا رايح أو مغلس",34,"س",1,0],["في ثناياهُ لمنْ يرشفها","أثرٌ هنَّ مجارٍ للقبل",35,"ل",1,0],["فَيَثلمُني مَن لا أراهُ بِناظري","وَيَجرحُني مَن ليسَ لِي بمحارِبِ",36,"ب",1,0],["في ثَغْرهِ وَناظِرَيْ","هِ عَذْبُه وَعضْبُهُ",37,"ب",2,0]]}