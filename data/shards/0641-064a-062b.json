""],[5320,"صيحة الثأر","https://www.poetsgate.com/ViewPoem.aspx?id=40397",""],[5401,"الشيطنه والشقاوه","https://www.poetsgate.com/ViewPoem.aspx?id=85139",""],[5431,"في نهدها ثمر الفردوس ماتاها","https://www.poetsgate.com/ViewPoem.aspx?id=186031",""],[5431,"بات لثم الثغر أحلى","https://www.poetsgate.com/ViewPoem.aspx?id=189563",""],[5431,"علّي أرى علّي","https://www.poetsgate.com/ViewPoem.aspx?id=195184",""],[5431,"سقط النصيف...","https://www.poetsgate.com/ViewPoem.aspx?id=198368",""],[5431,"وعشقك السيل لاحدٌ ولا وسطُ","https://www.poetsgate.com/ViewPoem.aspx?id=199798",""],[5436,"صبح بغداد ( بدر عمر المطيري )","https://www.poetsgate.com/ViewPoem.aspx?id=53718",""],[5443,"مليكة الطُّهر","https://www.poetsgate.com/ViewPoem.aspx?id=185138",""],[5461,"يوم انا طالب","https://www.poetsgate.com/ViewPoem.aspx?id=5237",""],[5470,"معزوفة السرو","https://www.poetsgate.com/ViewPoem.aspx?id=11002",""],[5512,"المعلم","https://www.poetsgate.com/ViewPoem.aspx?id=204242",""],[243,"يوم ارتوى الثأر","https://www.poetsgate.com/ViewPoem.aspx?id=20960",""],[5691,"يوم يُبعثون","https://www.poetsgate.com/ViewPoem.aspx?id=206744",""],[5818,"ليس إلا اللظى والقهر والحطب","https://www.poetsgate.com/ViewPoem.aspx?id=193077",""],[5830,"طَيْفٌ وَ وَعْدٌ وَ أَمَلْ","https://www.poetsgate.com/ViewPoem.aspx?id=200906",""],[2765,"برح الخفا ما الحق فيه خفاء","https://www.poetsgate.com/ViewPoem.aspx?id=136825",""],[5957,"أنت الرصافة","https://www.poetsgate.com/ViewPoem.aspx?id=27115",""],[5980,"في ثغر بيروت قاضٍ","https://www.poetsgate.com/ViewPoem.aspx?id=146267",""],[6078,"في غربةِ القمرِ","https://www.poetsgate.com/ViewPoem.aspx?id=202773",""],[6148,"في رحاب الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=201654",""],[5075,"ولابد أن يستمر الحداء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82757&r=&rc=3",""],[5957,"أنت الرصافة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82437&r=&rc=75",""],[6247,"حروف مهاجرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80264&r=&rc=3",""],[549,"سيرةٌ إنسانيَّةٌ للرِّمال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87656&r=&rc=8",""],[6325,"الغياب الأخير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88020&r=&rc=2",""]],"verses":[["فيثنى لهم بالأرض شرق بمغرب","ويقرن بالجوزاء عنهم عطارد",0,"د",1,0],["في ثغرها الحلو أو في جيدها الحالي","لا أرغم الله إلاَّ أنف عذَّالي",1,"ل",2,1],["في ثوب نُعمى جديد","مُذيَّل بالتمامِ",2,"م",1,0],["فَيُثِيرُ في النَّفْسِ الكَئيبةِ","عَاصِفاً لا يَرْكُدُ",3,"د",1,0],["في ثغرِهِ جواهرٌ غوالي","جلوتُها منظومةَ اللآلي",4,"ي",1,0],["في ثَنايا العَجاج","وَالتحام السُيوف",5,"ف",1,1],["في ثيابٍ تُريكَ عِزاً ولكنْ","حَشْوُها الذُّلُّ والرّياءُ سَدَاها",6,"ا",3,0],["في ثَرىً كَالمِسكِ شيبَ بِراحٍ","كُلَّما أَنبَتَهُ القَطرُ لاحا",7,"ح",2,0],["فيُثْني عليه ضَيْغَمٌ بزَئِيرِهِ","ويُثْني عليه شادِنٌ ببُغامهِ",8,"م",2,0],["في ثراها الغبيِّ وسَّدتُ أحلا","مي وماضي الهنيِّ من أوقاتي",9,"ت",2,0],["في ثَنايا الأَمواجِ وَالزَبَدِ المَن","دوفِ لاحَت أَكفانُنا وَالقُبورُ",10,"ر",1,0],["في ثقةٍ بمن به لا يوثَقُ","ولا يدوم عهدُه والمَوْثِقُ",11,"ق",1,0],["فَيُثيرُ النَّشيدُ ذكرى حياةٍ","حَجَبَتْها غُيومُ دَهْرٍ كئيبِ",12,"ب",1,0],["في ثيابٍ من الطبيعة وشّا","ها كما شاء مُبدِعُ الألوان",13,"ن",1,0],["في ثغره لغة الحاني بأمّته","وفي يديه لها سكّين جزّار !",14,"ر",1,0],["في ثِياب كَرَبيع","قَد سَرى فيها المحرَّم",15,"م",1,0],["في ثُغُورِ الجِبالِ وشمُ القوافي","قُبَلٌ هَيَّجَتْ هُنا أشجاني",16,"ن",2,0],["في ثالثِا العشرين والزُّبانا","خامسَ إبريلٍ له قد كانا",17,"ن",2,0],["في ثَغرِهَا بَعد الكَرَى عَنبَرٌ","أو شُهدةٌ أو خمرَةٌ صَافِيه",18,"ي",2,0],["فِي ثَوْبِ لَيْلٍ أَبْلَيْتُ جِدَّتَهُ","وَجادَ لِي سَيْرُهُ بِزَوْرَتِهِ",19,"ت",2,0],["في ثناءِ المثنينَ نعماء لكن","منكَ كانت عليهم النعماءُ",20,"ا",2,0],["في ثغره الحالي وفي كأسه","ربق حلال ومدام حرام",21,"م",1,0],["في ثناياه خفيفٌ من نسيم","وأعاصيرُ من الكرب المقيم",22,"م",1,0],["فيثير الهوى كوامن نفسي","وبها من مثاره ضعفان",23,"ن",1,0],["فيثِلبُني ويَرْجِعُ سالمِاً لم","تَهِجْك عليه أسبابُ الإخاء",24,"ا",2,0],["في ثَنيِ بُردَتِهِ قَضيبُ نَقىً فَفي","الدِرعِ المُفاضَةِ مِنهُ طَودٌ أَيهَمُ",25,"م",1,0],["فَيُثني عَليكَ لِسانُ الحَسودِ","بِإِنشادِها وَفَمُ العاتِبِ",26,"ب",1,0],["في ثوب صحة جسمٍ","مطرزٍ بالشفاء",27,"ا",2,0],["في ثأرِكم فتكاً وبَطشاً مِنهما","يَشفى الصَّدى الزّاقي ويُروَى الهام",28,"م",1,0],["في ثَلمِ ثَغرِ سَلوَتي جَدَّ فَلَي","تَ ثَغرَهُ يَجودُ لي بِلَثمِ",29,"م",1,0],["في ثنيَّات صدره","زفرة الهم والكدر",30,"ر",1,0],["في ثنايا صدورهم","انة في الاضالع",31,"ع",1,0],["فيثير شجوَ الشاعرين","رمز الالم",32,"م",1,0],["في ثلوج الجبال أو لهب الشم","س يريقون مبهجات الحياة",33,"ه",1,0],["في ثغرها دُرٌّ وفي وجَناتِها","وردٌ نضيرٌ أحمرٌ كالعندمِ",34,"م",1,0],["في ثغرها الشّهْدُ لعمري مُذابْ","طُوبى لمنْ يرشُفُ ذاك الرُضابْ",35,"ب",1,0],["في ثاني عشر واصل","أنا رايح أو مغلس",36,"س",1,0],["في ثناياهُ لمنْ يرشفها","أثرٌ هنَّ مجارٍ للقبل",37,"ل",1,0],["فَيَثلمُني مَن لا أراهُ بِناظري","وَيَجرحُني مَن ليسَ لِي بمحارِبِ",38,"ب",1,0],["في ثَغْرهِ وَناظِرَيْ","هِ عَذْبُه وَعضْبُهُ",39,"ب",2,0],["فيثقبُ سُوسُ الهمِ جِذعَ فؤَادها","ويَقذف من حوليهِ موجاً من الذُّعر",40,"ر",1,0],["في ثَنا صَدر الزَمانِ","بِمَعان كَالخريدهْ",41,"ه",1,0],["في ثَنا هَذا المهذَّبْ","خَير مَقصود بذكرِ",42,"ر",1,0],["في ثريّا العِزّ كالدُّرِّ النّظيمْ","إِذ تَرَدَّى الفخرُ أَسنى صَدفِ",43,"ف",1,0],["في ثَغرِها الدرّيِّ أَسنى عقار","وَخَمرة تزري بِكلِّ الخُمور",44,"ر",1,0],["في ثَغرِهِ مِثلها بَل لا تُماثِلُهُ","في طَرْفِهِ خِدْنُها بَل لا تُناظِرُهُ",45,"ر",2,0],["في ثُريّا الحسنِ مِن أَسمى سَما","إِنْ بَدا يَمحو ضياءَ الخنَّسِ",46,"س",1,0],["في ثَغرِهِ الدُّرّ في الياقوتِ مُنغَرِس","غَرسَ الجَواهرِ في الإِبريزِ وَالذّهَبِ",47,"ب",1,0],["في ثُريّا الحُسنِ كَالبَدرِ سَما","فَمَحا ضَوءَ الجَواري الكُنّسِ",48,"س",1,0],["في ثَغرِكِ درٌّ وَفي الشّفاهِ عَقيق","وَالرّيق سُلافٌ حَلّت وَأَعذَب سلسال",49,"ل",1,0],["في ثلاثينَ زَغْرَعَتْها حُقُوقٌ","أصْبَحَتْ أَمُّ حَبْتَرٍ تَشكُوني",50,"ن",2,0],["فِي ثغرِك المِسْكُ وَالّلآلِي","وَالطَّلْعُ وَالبرقُ وَالصَّبَاحْ",51,"ح",1,0],["فِي ثَغْرِهَا الشَّهْدُ وَالحُمَيَّا","وَالدُّرُّ وَالْمِسْكُ وَالْحَلِيبْ",52,"ب",1,0],["فَيَثي إِلى اِحدى السُبَل","قَولاً وَعِلماً وَعَل",53,"ل",1,1],["في ثغره حانية عانية","تسبى العقول بها وليست تسبأ",54,"ا",1,0],["في ثاني اليوم من آب ثوى قمرٌ","باتت على فقده الاكباد محترقَةْ",55,"ق",2,1],["في ثَغرِكَ الياقوت","وَالدُر وَالمُرجان",56,"ن",1,0],["في ثغرها نار وفي كبدي ظماً","عبثاً ابلُّ صَداه بالإبحار",57,"ر",1,0],["في ثغرها بردٌ يقول إذا","ما ذاقه المحرور وا بردي",58,"د",2,0],["فيثلج ما بالمستهام من اللظى","ويوقد الخفا أخفى وأظهر ما ظهر",59,"ر",1,0],["في ثِيابٍ عِمادُهُنَّ رِماحٌ","عِندَ جُردٍ تَسمو سُمُوَّ الصيدِ",60,"د",1,0],["في ثنا من بنداه ملكا","طوق رقي والحشا من اضلعي",61,"ي",1,0],["في ثوبها الخمريّ قد أقبلت","بوجنة حمراءَ كالجَمرِيِّ",62,"ي",1,1],["في ثلثِ الليل لنا رحمة","بنا لكي يتلو أو يعلما",63,"م",2,0],["في ثَغْرِه العَذْبِ وسِلْكِ الجُمَا","نِ الرَّطْبِ فانْظُر للحُلَى في حُلاَهْ",64,"ا",2,0],["في ثيابِ الحدادِ بين لِداتٍ","هي سعدُ الحمى وهنَّ النعيم",65,"م",1,0],["في ثغرهَا بَرَدٌ في طيّهِ حَببٌ","في ريقه ضربٌ في طِعمِه شَبُمُ",66,"م",1,0],["في ثَنايا الهَضَبات","اليَوم أَبصَرتُ غَزالا",67,"ل",2,0],["في ثاني الإقليمِ تَخرُج صافِيَه","أمَّا بخطِّ الإستواءِ خافِيَه",68,"ه",1,0],["في ثَديِكَ اليُسرى طلوعُ الواقعِ","وخلفَكَ النجمُ يَغِب كُن سامعي",69,"ي",1,0],["فَيثبِتُ مَوضوعَ الأَحاديثِ جاهِلاً","وَيَعزُو إِلى المَعصومِ ما لَيسَ لائِقا",70,"ق",2,0],["في ثناياه صفحة من لجين","نم عن وشيها بتبرٍ ضرامُ",71,"م",1,0],["في ثغره در وشهد فقل","ما شيت في الدر وفي الشهد",72,"د",1,0],["في ثغره دُرٌّ وخمرٌ رائقٌ","من قبل خلق الدهر صار يُعتَّقُ",73,"ق",1,0],["فيثمر علماً يجنبه الجميع من","دنوّ قطوف بينها الكل يرتع",74,"ع",1,0],["في ثغره ذهب الكرى عن ناظرى","كلٌّ تراهُ مُشهّدٌ ومُسهّدُ",75,"د",1,0],["فيثبت قلبي والقلوب مروعة","ويشرق وجهي والوجوه كوالح",76,"ح",1,0],["في ثغره الدري كنز جوهر","عقارب الاصداغ باتت ترصده",77,"د",2,0],["فيثني على الجيسُ الأديب ولم","أدرِ إن كان بالصائب",78,"ب",1,0],["في ثامنٍ حَلَّ والعشرين ساحتَهم","من شهرِ شعبانَ نِعْمَ الشهر شعبانُ",79,"ن",1,0],["في ثغرها الخمر يَجري بَينَ دُرٍّ نبيت","تُميت بالصَّد تُحيي باللقا مَن تُميت",80,"ت",1,0],["فيثني قضيباً أثمر البدر مايساً","بحقف مسيل لفه السيل مظلما",81,"م",2,0],["فيثبت لاستقبالها الحلم والرضى","ويقضي عليها بالهزيمة والأجلا",82,"ل",2,0],["في ثَني بُردَيه إِمامُ تَقىً وَفي","حِقوَيه رَضوى بانَ بَعدَ إِبانِهِ",83,"ن",2,0],["في ثلاثٍ من بني الرو","م الى دار الحُسينِ",84,"ن",1,0],["فِي ثَغرِهِ لِلحَوَاسِ الخَمسِ لَذَّاتُ","وَمَا بِألحَاظِهِ إِلاَّ مُصِيبَاتُ",85,"ت",1,1],["فيثور الأوار ضمن فؤاده","وأخيل يشتدد داعي اشتداده",86,"ه",1,0],["فَيثلِمُ ثَلماً وَيَنثَنِيانِ","وَصَدراهُما عَرَقاً يَرشَحانِ",87,"ن",1,0],["في ثِيابٍ مُعصفَرا","تٍ عَلى الوَجهِ بارِكا",88,"ك",2,0],["في ثمد الروم أناخوا الإبلا","وسألوا اللَه الفالا",89,"ل",2,0],["في ثغرهِ والقَوامِ اللَّدنِ ألفُ غنىً","عن أبرقِ الجزعِ بل عن بانة الوادي",90,"د",2,0],["في ثنايا حفرة يخشى الورى","عند ذكراها لدى سوق الكلام",91,"م",1,0],["في ثنا سيدي أبي الفضل يحيى","من له في الكمال أوفر سهمِ",92,"م",1,0],["في ثنائي عليه لم أرجُ جوداً","لي منه الرضا ومنّى الثناء",93,"ا",2,0],["فيثملُ خافقٌ ويفيض عشقٌ","سحائب عطره عبقاً تفوحُ",94,"ح",1,0],["في ثنايا الليل يهتاج ويضي","من جنون الوقت ينفث اكثره !!",95,"ر",2,0],["في ثغره كنت حميا الراح","في تلك الرواشف",96,"ف",1,0],["في ثلّةٍ رَحِمُ الصحراءِ جادَ بها","أشجارَ رؤيا تروّتْ من مثانيهِ",97,"ي",2,0],["في ثغرها عين الشفاء ولم يزل","من دونه قلب المحب على شفا",98,"ف",2,0],["في ثغر بيروت بدا دراكماً","قد كان قبلا شامة في الشام",99,"م",1,0],["في ثغره بردٌ حماهُ بصارم","فغدا به المحميُّ وهو مثلج",100,"ج",1,0],["في ثاني يوم يرسل لي مسج لليوم ماشلته","سطر يتعذر ابذوقه ونهاية شوق في سطره",101,"ر",2,0],["في ثوبِها الفضفاضِ يمسحُ خطوَها","ينسابُ كالليلِ الطويلِ ويُهرَقُ",102,"ق",1,0],["فَيَثْأَرُ مِنِّيْ عَاذِلٌ، وَمُعَاْرِضٌ","وَوَغْدٌ بِإِعْدَاْمِ الْهَوَىْ يَتَبَجَّحُ",103,"ح",1,0],["في ثرىً لا يُحَسُّ في","ه بمن زارَ أو هَجَر",104,"ر",1,0],["فيثمر الربع بما أمَّلت","بكل خير من جنىً طيِّب",105,"ب",1,0],["فِي ثَوبْ عُرسِكِ تَختَالِينَ مَائِسَةً","تُغرِينَ أَعيُنَ قُرصَانٍ ومَلاَّحِ",106,"ح",1,0],["في ثالث الحرمين الجرح منع","بنكب