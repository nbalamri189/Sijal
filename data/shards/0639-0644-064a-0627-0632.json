{"poems":[[52,"أأحزنك الألى ظعنوا فساروا","https://www.aldiwan.net/poem63810.html","الوافر"],[1782,"","https://poetry.dctabudhabi.ae/diwan/poem/128759","المجتث"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199053","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133197",""],[5431,"أصابعه...","https://www.poetsgate.com/ViewPoem.aspx?id=198736",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577080",""]],"verses":[["عَلى أَزمانَ أَنتَ بِهِنَّ بَلٌّ","وَإِذ أَسماءُ آنِسَةٌ نُوارُ",0,"ر",1,0],["على ازاهر روضٍ","قد دبج الورد مرجه",1,"ج",2,0],["على ازدهار بدا والسعد يخدمه","فوق الحواجب والبشرى به تفد",2,"د",1,0],["على أزمان مرت في سرورٍ","مع إخوان صدقٍ في العشائر",3,"ر",1,0],["علّي أزيلُ بضمةٍ","مايستفيضُ مدامعَه",4,"ع",2,0],["عَلى أَزمير بِأَرض التُرك وَانحر مشرق","عاظاليا دخن وَطاب هَواه",5,"ا",2,0]]}