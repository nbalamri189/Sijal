ل","https://www.poetsgate.com/ViewPoem.aspx?id=153951",""],[5092,"ما بين بعدِ ولقاء","https://www.poetsgate.com/ViewPoem.aspx?id=178715",""],[5121,"رق الشعور","https://www.poetsgate.com/ViewPoem.aspx?id=37454",""],[5136,"يا ليلة جاءت على قدر","https://www.poetsgate.com/ViewPoem.aspx?id=121600",""],[5206,"أرى العدل عن لوم العذول هو العدل","https://www.poetsgate.com/ViewPoem.aspx?id=149039",""],[5225,"سبائك","https://www.poetsgate.com/ViewPoem.aspx?id=35558",""],[5273,"كبرياء عاشقة","https://www.poetsgate.com/ViewPoem.aspx?id=28546",""],[5277,"وشمُ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=185674",""],[5295,"شذا القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=210634",""],[592,"إلى الله نشكو إننا بمحلة","https://www.poetsgate.com/ViewPoem.aspx?id=128840",""],[5356,"أشكو بِعادك","https://www.poetsgate.com/ViewPoem.aspx?id=201904",""],[5370,"مفرق الدربين","https://www.poetsgate.com/ViewPoem.aspx?id=81634",""],[5377,"الأمن الزائف","https://www.poetsgate.com/ViewPoem.aspx?id=61898",""],[5387,"بلسم العيون","https://www.poetsgate.com/ViewPoem.aspx?id=46997",""],[5431,"فيك الحسُ يُختزلُ...","https://www.poetsgate.com/ViewPoem.aspx?id=198568",""],[5459,"إنذار","https://www.poetsgate.com/ViewPoem.aspx?id=202224",""],[5490,"ماغيبوك","https://www.poetsgate.com/ViewPoem.aspx?id=176355",""],[5518,"هو المختار (ﷺ)","https://www.poetsgate.com/ViewPoem.aspx?id=187373",""],[5551,"الشاي","https://www.poetsgate.com/ViewPoem.aspx?id=137149",""],[5582,"نَبا عضبُ السلوّ نبا","https://www.poetsgate.com/ViewPoem.aspx?id=63457",""],[5595,"وسَكرتُ فيك","https://www.poetsgate.com/ViewPoem.aspx?id=150151",""],[5650,"اعتذارٌ جديدٌ لخجلِ الخيول!","https://www.poetsgate.com/ViewPoem.aspx?id=134786",""],[5701,"أين المعز الفاطمي وجوهر","https://www.poetsgate.com/ViewPoem.aspx?id=164689",""],[5704,"يا روح الروح","https://www.poetsgate.com/ViewPoem.aspx?id=195152",""],[5725,"جحر ضب","https://www.poetsgate.com/ViewPoem.aspx?id=187234",""],[5736,"هدأة","https://www.poetsgate.com/ViewPoem.aspx?id=203829",""],[5790,"سلا خاطري عن زينبٍ ونوار","https://www.poetsgate.com/ViewPoem.aspx?id=111946",""],[5799,"تبسم فجر الحق وأنجابت الظلم","https://www.poetsgate.com/ViewPoem.aspx?id=124750",""],[5923,"إلى فرح","https://www.poetsgate.com/ViewPoem.aspx?id=146860",""],[5957,"لَكَ أنتَ","https://www.poetsgate.com/ViewPoem.aspx?id=12232",""],[6006,"مكناس","https://www.poetsgate.com/ViewPoem.aspx?id=214149",""],[6029,"رحلة","https://www.poetsgate.com/ViewPoem.aspx?id=189441",""],[6093,"لَوْ كَانَ عَرْشُكَ فِيْ السَّحَابْ (مجزوء الكامل)","https://www.poetsgate.com/ViewPoem.aspx?id=181552",""],[6102,"خرف أنا","https://www.poetsgate.com/ViewPoem.aspx?id=183985",""],[6102,"قبلة الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=184634",""],[6124,"نهر الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=174905",""],[6152,"سكنت اعماق الفؤاد","https://www.poetsgate.com/ViewPoem.aspx?id=213190",""],[5724,"فجعت لفرط فراقك الاخوان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55152&r=&rc=19",""],[6190,"حمَّى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87010&r=&rc=16",""],[6198,"غمز الشموس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79228&r=&rc=1",""],[5957,"دموع الانتظار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82572&r=&rc=116",""],[6237,"جبل فيفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77861&r=&rc=3",""],[406,"خيمة الظلماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63653&r=&rc=83",""],[454,"يارنج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82663&r=&rc=27",""],[2220,"الأمرُ أسماءٌ لهُ ونعوتُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11221&r=&rc=95",""],[6300,"على لسان الكره","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82874&r=&rc=45",""],[6323,"يا ساكن الأعماق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82169&r=&rc=0",""]],"verses":[["وسكَّنَ رَوْعَ النّائِباتِ بِعَزْمَةٍ","يَذِلُّ لَها في حَوْمَةِ الحَرْبِ أبْطالُ",0,"ل",1,0],["وَسَكَنتُمُ مِن بَطنِ دِجلَةَ مَنظَراً","أَنِقَ المَرابِعِ طَيِّبَ المُتَنَظَّرِ",1,"ر",1,0],["وَسَكَّنْتَ رِيحَ الْخَطْبِ بَعْدَ هُبُوبِهَا","وَلَوْلاَكَ كَانَتْ هُوجُهَا لِيَ حَاطِمَهْ",2,"م",2,0],["وسكّنْتَها بالقُرْبِ منكَ ولمْ تَزَلْ","تَهيمُ هَوىً منْ قَبْلِهِ وتَهيجُ",3,"ج",1,0],["وَسَكَّنْتَ بَحْرَ الْخَطْبِ وَاللَّجُّ مزْبِدٌ","وَمَوْجْ الرَّدَى آِتيُّهُ مُتَرَاكِبُ",4,"ب",1,0],["وَسَكَنتَ القُصورَ في بَيتِ خُلدٍ","وَسَكَنّا عَلَيكَ بَيتَ الحِدادِ",5,"د",1,0],["وَسَكَنّا إِلى الَّذي أَنزَلَ اللَ","هُ وَكُنّا مِن قَبلِهِ في اِرتِيابِ",6,"ب",1,0],["وَسَكَنتَ داراً مُلكُها لَكَ خالِدٌ","وَتَرَكتَ داراً مُلكُها لِنَفادِ",7,"د",1,0],["وسكنت قلباً طار فيك مسرةً","أرأيت وكراً قطّ أصبح طائرا",8,"ر",2,0],["وسكّنت البسيطةَ من هياجٍ","فما يهتزّ فرعٌ في دَبور",9,"ر",1,0],["وسكّنها حتى لو اختار لم تمس","غصون النقا تحت الرياح السواهك",10,"ك",1,0],["وسكّنت من جور الزمان محرّكاً","لأنك بالأفعال في الفضل جازم",11,"م",1,0],["وَسُكرٌ ثُمَّ بَسطٌ ثُمَّ شَوقٌ","وَقُربٌ ثُمَّ وَصلٌ ثُمَّ أُنسُ",12,"س",1,0],["وسكونُ الشجاع حين يداهي","ك مُداهٍ وسورةُ الأفْعُوان",13,"ن",1,0],["وَسَكَنَ الوَثّابُ في صَدرِهِ","مِن قَبلِ أَن يُدرِكَ كُلَّ المَرام",14,"م",1,0],["وَسَكَتَت فَصاحَتِ الجارِيَه","باكِيَةً مِن بُؤسِها شاكِيَه",15,"ه",1,0],["وسكتنا وغرَّدَ الحبُّ في الغا","بِ فأصغى حتَّى حَفيفُ الغُصونِ",16,"ن",1,0],["وسَكِرْنا هناكَ في عالمِ الأَح","لامِ تَحْتَ السَّماءِ تَحْتَ الغصونِ",16,"ن",1,0],["وَسَكَتُّ إِلّا أَن أُعَرِّضَ قائِلاً","نَزراً وَصَرَّحَ جُهدَهُ مَن عَرَّضا",17,"ض",2,0],["وَسُكرٌ مِثلَ ما أَسكَ","رَ طَرفٌ مِنهُ وَسنانُ",18,"ن",1,0],["وَسَكِرتُ سُكرَي قَهوَةٍ وَشَبيبَةٍ","وَسَحَبتُ مِن ذَيلَي هَوىً وَتَصابي",19,"ب",2,0],["وَسَكَّنتُ مِن نَفسٍ تَجيشُ مَروعَةٍ","وَمَسَّحتُ عَن عِطفٍ تَمايَلَ مُزوَرِّ",20,"ر",1,0],["وَسُكون الدُجى يَفك عَن القَل","بِ قيوداً وَيَبعث الآمالا",21,"ل",2,0],["وَسُكّانِ دارٍ لا تَواصُلَ بَينَهُم","عَلى قُربِ بَعضٍ في التَجاوُرِ مِن بَعضِ",22,"ض",1,1],["وَسَكرَةَ عَيشٍ فارِغٍ مِن هُمومِهِ","وَمَعروفَ حالٍ لَم نَخَف أَن يُنَكَّرا",23,"ر",2,0],["وَسَكنُ الأَرضِ كُلُّهُم ذَميمٌ","صَريحُهُمُ المُهَذَّبُ وَالسَبِيُّ",24,"ب",2,0],["وسكتنا فليس إلَّا عيونٌ","أفصحتْ عن جوانح وثغورِ",25,"ر",1,0],["وسُكِّنَ الآخر من باقِيهِ","ممَّا يُجيزونَ الزِّحافَ فيهِ",26,"ه",1,0],["وسَكَّنَ رَوْعَ الفَلاَ مَجْفِلاَتٍ","وَأَمَّنَ شَامِخَهَا أَصْعَرَا",27,"ر",2,0],["وسُكُونُ البِيدِ في رَهْبَتِها","جَرّدَ الرُّوحَ وبالنُّورِ كَسَاها",28,"ا",3,0],["وسكتُّ دهرًا خْوف لومة لائم","أو قولِ لاحٍ: أنت غيرُ جليد",29,"د",1,0],["وسكبنا في مهده دفء قلبي","نا وأحلامنا العذارى المشوّقه",30,"ق",2,0],["وسكبت في الأنغام قلبك دمعة","لا كالدّموع ورحمة تتنهّد",31,"د",1,0],["وسكينة الصحراء إلاّ هازجا","مرحا يعيد حداءه ويردّد",31,"د",1,0],["وسكرت من أحلامه بسلافة","عجب ومن آهاته بملاب",32,"ب",1,0],["وسكبت ما شاء الهوى بطلولها","حمر الدّموع . أما تخاف نفادها ؟",33,"د",3,0],["وسكينة والشعر ضيف نديّها","والحسن يبعث شجوه فيقولا",34,"ل",2,0],["وسكبت في نيرانك العبرات فابترد العذاب","تنهل في عدن فنوّر كوكب ونمت كعاب",35,"ب",1,0],["وسكر ثم صَحْوٌ ثم شوقٌ","وقرب ثم وفر ثم أُنْس",36,"س",1,0],["وسكون ولهفةٌ وولوع","واضطراب وسكرة وخبال",37,"ل",1,0],["وسكنتُم نَزْوَى وجندُكمُ في","الردع والحرب في أقاصي البلادِ",38,"د",1,0],["وُسكُوتاً وفِكرَةً وخِطَاباً","وَمَرَاماً وَرَائِماً ومَرُوماً",39,"م",2,0],["وَسَكَّنتَ عَن حَزمٍ زَعازِعَكَ الَّتي","إِذا عَصَفَت كانَت أَعاديكَ خَشرَما",40,"م",2,0],["وسكّن الروعَ والأكبادُ خافقةٌ","وعمَّ بالفرجات السهلَ والجبلا",41,"ل",2,0],["وَسَكَنتَ بَيتاً ذا غَمى","وَلَتَخرُجَنَّ مِنَ الغِماءِ",42,"ا",2,0],["وسكرتُ من خمرِ الفراقِ ورقّصَتْ","عَيني الدموعَ على غناءِ الحادِي",43,"د",2,0],["وَسُكنى البَوادي دارَهُنَّ وَإِنَّها","لَدَارُ اِمرِئٍ لا بِالحصورِ وَلا الخَطلِ",44,"ل",1,0],["وسكنتُ بالفُسْطاط مُغْترِبا","فلقد كسبتُ بغربتي شرفا",45,"ف",2,0],["وسُكْناي بالفسطاط عزٌّ وإنما","محلُّ فؤادي فيه أَسْنَى وأَشْرَف",46,"ف",1,0],["وسكبته من غور وجداني","وأعماق الضمير",47,"ر",1,0],["وسَكَبتُ لحناً عسكريّاً","دونهُ وقَفَ المُباري",48,"ر",2,0],["وسكَبتها شعراً رثيتُ","بهِ الروح الحَزينِ",49,"ن",1,0],["وسكرانة سكرى دلالٍ وقوَّةٍ","إذا هي قامت لم تَخُنها المفاصلُ",50,"ل",1,0],["وسكران اللواحظ وهو صاحي"