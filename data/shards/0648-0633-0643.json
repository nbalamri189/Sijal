{"poems":[[63,"نظرت خلال الركب والمزن هطال","https://www.aldiwan.net/poem46217.html","الطويل"],[55,"لما بدت فرأيتها في صفرة","https://www.aldiwan.net/poem26346.html","الكامل"],[77,"أخذت وأمواج الردى متلاطمة","https://www.aldiwan.net/poem36100.html","الطويل"],[77,"إذا سرت سار النور حيث تعوج","https://www.aldiwan.net/poem36660.html","الطويل"],[77,"سعودك لا ما تدعيه الكواكب","https://www.aldiwan.net/poem36771.html","الطويل"],[86,"أيهذا الثرى إلام التمادي","https://www.aldiwan.net/poem10499.html","الخفيف"],[86,"بكرا صاحبي يوم الإياب","https://www.aldiwan.net/poem68952.html","الخفيف"],[71,"لو أن غير الدهر كان العادي","https://www.aldiwan.net/poem4010.html","الكامل"],[72,"صيرت نومي مثل عطفك نافرا","https://www.aldiwan.net/poem18698.html","الكامل"],[72,"أما وتلفت الرشاء الغرير","https://www.aldiwan.net/poem18712.html","الوافر"],[72,"تصرمت الأيام دون وصالك","https://www.aldiwan.net/poem19437.html","الطويل"],[72,"ليهن بنو الآمال أنك قادم","https://www.aldiwan.net/poem19670.html","الطويل"],[64,"سكوت ثم صمت ثم خرس","https://www.aldiwan.net/poem67636.html","الوافر"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[91,"ما وعظ الإنسان مثل الحمام","https://www.aldiwan.net/poem62748.html","عموديه"],[91,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[92,"ههنا في خمائل الغاب تحت الزا","https://www.aldiwan.net/poem38901.html","المديد"],[45,"ترك السواد للابسيه وبيضا","https://www.aldiwan.net/poem64626.html","الكامل"],[45,"فؤادي منك ملآن","https://www.aldiwan.net/poem66687.html","الهزج"],[74,"يا لين عطفي واخضرار جنابي","https://www.aldiwan.net/poem12874.html","الكامل"],[74,"أما والتفات الروض عن أزرق النهر","https://www.aldiwan.net/poem12954.html","الطويل"],[102,"هو ذا البحر مزبدا يتعالى","https://www.aldiwan.net/poem33132.html","الخفيف"],[52,"وسكان دار لا تواصل بينهم","https://www.aldiwan.net/poem26877.html","الطويل"],[52,"أيا ويحه ما ذنبه إن تذكرا","https://www.aldiwan.net/poem27049.html","الطويل"],[46,"أرادوا الشر وانتظروا إماما","https://www.aldiwan.net/poem23606.html","الوافر"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39559","الخفيف"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54926","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54276","الرمل"],[106,"وحي العيد","https://www.poetsgate.com/ViewPoem.aspx?id=179512",""],[64,"مراحل على الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=3097",""],[113,"آه من فتك طرفها القتال","https://www.aldiwan.net/poem41688.html","الخفيف"],[126,"منعت مقلتى لذيذ الرقاد","https://www.aldiwan.net/poem50636.html","الخفيف"],[130,"لا تلوماه في الهوى أو لوما","https://www.aldiwan.net/poem54746.html","الخفيف"],[141,"قفوا في القلى حيث انتهيتم تذمما","https://www.aldiwan.net/poem11819.html","الطويل"],[158,"ما خيب الله فيه للورى أملا","https://www.aldiwan.net/poem58899.html","البسيط"],[162,"لا تركنن إلى الهوى","https://www.aldiwan.net/poem67809.html","مجزوء الكامل"],[164,"أقوت معاهدهم وشط الوادي","https://www.aldiwan.net/poem47098.html","الكامل"],[167,"إليكن عني فانصرفن على مهل","https://www.aldiwan.net/poem1643.html",""],[183,"إيه على تذكار ما سلفا","https://www.aldiwan.net/poem14591.html","أحذ الكامل"],[183,"عسى الجانب الغربي يهدي نسيمه","https://www.aldiwan.net/poem14714.html","الطويل"],[195,"يا من صهرت لهم شعوري","https://www.aldiwan.net/poem39818.html","مجزوء الكامل"],[195,"قومي اسمعي يا بنت جاري","https://www.aldiwan.net/poem39947.html","مجزوء الكامل"],[195,"كفي الملام وعلليني","https://www.aldiwan.net/poem39948.html","مجزوء الكامل"],[202,"رحلت وما شوقي عن الإلف راحل","https://www.aldiwan.net/poem53189.html","الطويل"],[202,"وسكران اللواحظ وهو صاحي","https://www.aldiwan.net/poem53341.html","الوافر"],[221,"إجرح القلب واسق شعرك منه","https://www.aldiwan.net/poem39702.html","الخفيف"],[248,"ألقت أشعتها عليك الراح","https://www.aldiwan.net/poem14939.html","الكامل"],[273,"أعد نظرا إلى الزمن النضير","https://www.aldiwan.net/poem25566.html","الوافر"],[280,"بكاء الحمائم ضحك الحمام","https://www.aldiwan.net/poem32419.html","المتقارب"],[314,"فداؤك نفسي من الحادثات","https://www.aldiwan.net/poem69436.html","المتقارب"],[347,"غزلي مديحي من وجودي جوده","https://www.aldiwan.net/poem15542.html","الكامل"],[347,"أأكشف حالا ستره في النهى شرط","https://www.aldiwan.net/poem15762.html","الطويل"],[355,"يا ويح من بالمغرب الأقصى ثوى","https://www.aldiwan.net/poem4157.html","الكامل"],[362,"عدد لكم أن سرت في تشييعي","https://www.aldiwan.net/poem60845.html","الكامل"],[364,"قضى نحبه الصوم بعد المطال","https://www.aldiwan.net/poem17310.html","المتقارب"],[391,"أجراس سوداء","https://www.aldiwan.net/poem17746.html","عموديه"],[397,"فجر في دجى الأحداث","https://www.aldiwan.net/poem10239.html","عموديه"],[397,"لا تسألوا عن جدة الأمطارا","https://www.aldiwan.net/poem10304.html","عموديه"],[400,"يا سعد خذ بأبي وأمي","https://www.aldiwan.net/poem33426.html","مجزوء الكامل"],[400,"مرحبا يا مرحبا يا مرحبا بنسيم","https://www.aldiwan.net/poem34146.html","الرمل"],[406,"أما في الهوى حاكم يعدل","https://www.aldiwan.net/poem32553.html","المتقارب"],[413,"على مثله تجري الدموع السواجم","https://www.aldiwan.net/poem54054.html","الطويل"],[413,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[429,"أبدى الفرند نجابة النصل","https://www.aldiwan.net/poem12430.html","أحذ الكامل"],[438,"أما من بني حوا خليل محالم","https://www.aldiwan.net/poem14383.html","الطويل"],[447,"والله ما يا رنج إلا العار","https://www.aldiwan.net/poem993.html",""],[459,"وفتيان صدق من تميم تناثلوا","https://www.aldiwan.net/poem15083.html","الطويل"],[462,"وقفت على قبر العزيز بن يوسف","https://www.aldiwan.net/poem3138.html","عموديه"],[462,"أرى سيرها عنقاً أو خيدا","https://www.aldiwan.net/poem3276.html","عموديه"],[462,"مضى صاحب الصدر الذي حازه الصدر","https://www.aldiwan.net/poem3394.html","عموديه"],[475,"قد حق للمشتاق أن يتوجعا","https://www.aldiwan.net/poem15217.html","الكامل"],[513,"مساعيك يهدي للنجاح طلابها","https://www.aldiwan.net/poem12018.html","الطويل"],[514,"ألا يا عقاب الوكر وكر ضرية","https://www.aldiwan.net/poem48672.html","الطويل"],[525,"وكم ليلة لا أعلم الدهر طيبها","https://www.aldiwan.net/poem45994.html","الطويل"],[527,"وفود حبيب أم ورود عهاد","https://www.aldiwan.net/poem37457.html","الطويل"],[549,"وحللت من قلبي وأنت بخيلة","https://www.aldiwan.net/poem47182.html","الكامل"],[549,"اسعد سعدت بساعة التحويل","https://www.aldiwan.net/poem47276.html","الكامل"],[549,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[556,"أنا العاشق السالي لوجهك يا علو","https://www.aldiwan.net/poem33585.html","الطويل"],[556,"أطلق الكاس بعد طول احتباس","https://www.aldiwan.net/poem34439.html","الخفيف"],[573,"أنا أمير العشاق","https://www.aldiwan.net/poem2905.html","مجزوء الرجز"],[573,"أخذت ضنى عينيك رهنا على قلبي","https://www.aldiwan.net/poem2991.html","الطويل"],[573,"أرى كل شيء في البسيطة قد نما","https://www.aldiwan.net/poem3021.html","الطويل"],[584,"خذوا قودي من أسير الكلل","https://www.aldiwan.net/poem17697.html","المتقارب"]],"verses":[["وسكَّنَ رَوْعَ النّائِباتِ بِعَزْمَةٍ","يَذِلُّ لَها في حَوْمَةِ الحَرْبِ أبْطالُ",0,"ل",1,0],["وَسَكَنتُمُ مِن بَطنِ دِجلَةَ مَنظَراً","أَنِقَ المَرابِعِ طَيِّبَ المُتَنَظَّرِ",1,"ر",1,0],["وَسَكَّنْتَ رِيحَ الْخَطْبِ بَعْدَ هُبُوبِهَا","وَلَوْلاَكَ كَانَتْ هُوجُهَا لِيَ حَاطِمَهْ",2,"م",2,0],["وسكّنْتَها بالقُرْبِ منكَ ولمْ تَزَلْ","تَهيمُ هَوىً منْ قَبْلِهِ وتَهيجُ",3,"ج",1,0],["وَسَكَّنْتَ بَحْرَ الْخَطْبِ وَاللَّجُّ مزْبِدٌ","وَمَوْجْ الرَّدَى آِتيُّهُ مُتَرَاكِبُ",4,"ب",1,0],["وَسَكَنتَ القُصورَ في بَيتِ خُلدٍ","وَسَكَنّا عَلَيكَ بَيتَ الحِدادِ",5,"د",1,0],["وَسَكَنّا إِلى الَّذي أَنزَلَ اللَ","هُ وَكُنّا مِن قَبلِهِ في اِرتِيابِ",6,"ب",1,0],["وَسَكَنتَ داراً مُلكُها لَكَ خالِدٌ","وَتَرَكتَ داراً مُلكُها لِنَفادِ",7,"د",1,0],["وسكنت قلباً طار فيك مسرةً","أرأيت وكراً قطّ أصبح طائرا",8,"ر",2,0],["وسكّنت البسيطةَ من هياجٍ","فما يهتزّ فرعٌ في دَبور",9,"ر",1,0],["وسكّنها حتى لو اختار لم تمس","غصون النقا تحت الرياح السواهك",10,"ك",1,0],["وسكّنت من جور الزمان محرّكاً","لأنك بالأفعال في الفضل جازم",11,"م",1,0],["وَسُكرٌ ثُمَّ بَسطٌ ثُمَّ شَوقٌ","وَقُربٌ ثُمَّ وَصلٌ ثُمَّ أُنسُ",12,"س",1,0],["وسكونُ الشجاع حين يداهي","ك مُداهٍ وسورةُ الأفْعُوان",13,"ن",1,0],["وَسَكَنَ الوَثّابُ في صَدرِهِ","مِن قَبلِ أَن يُدرِكَ كُلَّ المَرام",14,"م",1,0],["وَسَكَتَت فَصاحَتِ الجارِيَه","باكِيَةً مِن بُؤسِها شاكِيَه",15,"ه",1,0],["وسكتنا وغرَّدَ الحبُّ في الغا","بِ فأصغى حتَّى حَفيفُ الغُصونِ",16,"ن",1,0],["وسَكِرْنا هناكَ في عالمِ الأَح","لامِ تَحْتَ السَّماءِ تَحْتَ الغصونِ",16,"ن",1,0],["وَسَكَتُّ إِلّا أَن أُعَرِّضَ قائِلاً","نَزراً وَصَرَّحَ جُهدَهُ مَن عَرَّضا",17,"ض",2,0],["وَسُكرٌ مِثلَ ما أَسكَ","رَ طَرفٌ مِنهُ وَسنانُ",18,"ن",1,0],["وَسَكِرتُ سُكرَي قَهوَةٍ وَشَبيبَةٍ","وَسَحَبتُ مِن ذَيلَي هَوىً وَتَصابي",19,"ب",2,0],["وَسَكَّنتُ مِن نَفسٍ تَجيشُ مَروعَةٍ","وَمَسَّحتُ عَن عِطفٍ تَمايَلَ مُزوَرِّ",20,"ر",1,0],["وَسُكون الدُجى يَفك عَن القَل","بِ قيوداً وَيَبعث الآمالا",21,"ل",2,0],["وَسُكّانِ دارٍ لا تَواصُلَ بَينَهُم","عَلى قُربِ بَعضٍ في التَجاوُرِ مِن بَعضِ",22,"ض",1,1],["وَسَكرَةَ عَيشٍ فارِغٍ مِن هُمومِهِ","وَمَعروفَ حالٍ لَم نَخَف أَن يُنَكَّرا",23,"ر",2,0],["وَسَكنُ الأَرضِ كُلُّهُم ذَميمٌ","صَريحُهُمُ المُهَذَّبُ وَالسَبِيُّ",24,"ب",2,0],["وسكتنا فليس إلَّا عيونٌ","أفصحتْ عن جوانح وثغورِ",25,"ر",1,0],["وسُكِّنَ الآخر من باقِيهِ","ممَّا يُجيزونَ الزِّحافَ فيهِ",26,"ه",1,0],["وسَكَّنَ رَوْعَ الفَلاَ مَجْفِلاَتٍ","وَأَمَّنَ شَامِخَهَا أَصْعَرَا",27,"ر",2,0],["وسُكُونُ البِيدِ في رَهْبَتِها","جَرّدَ الرُّوحَ وبالنُّورِ كَسَاها",28,"ا",3,0],["وسكتُّ دهرًا خْوف لومة لائم","أو قولِ لاحٍ: أنت غيرُ جليد",29,"د",1,0],["وسكر ثم صَحْوٌ ثم شوقٌ","وقرب ثم وفر ثم أُنْس",30,"س",1,0],["وسكون ولهفةٌ وولوع","واضطراب وسكرة وخبال",31,"ل",1,0],["وسكنتُم نَزْوَى وجندُكمُ في","الردع والحرب في أقاصي البلادِ",32,"د",1,0],["وُسكُوتاً وفِكرَةً وخِطَاباً","وَمَرَاماً وَرَائِماً ومَرُوماً",33,"م",2,0],["وَسَكَّنتَ عَن حَزمٍ زَعازِعَكَ الَّتي","إِذا عَصَفَت كانَت أَعاديكَ خَشرَما",34,"م",2,0],["وسكّن الروعَ والأكبادُ خافقةٌ","وعمَّ بالفرجات السهلَ والجبلا",35,"ل",2,0],["وَسَكَنتَ بَيتاً ذا غَمى","وَلَتَخرُجَنَّ مِنَ الغِماءِ",36,"ا",2,0],["وسكرتُ من خمرِ الفراقِ ورقّصَتْ","عَيني الدموعَ على غناءِ الحادِي",37,"ي",1,0],["وَسُكنى البَوادي دارَهُنَّ وَإِنَّها","لَدَارُ اِمرِئٍ لا بِالحصورِ وَلا الخَطلِ",38,"ل",1,0],["وسكنتُ بالفُسْطاط مُغْترِبا","فلقد كسبتُ بغربتي شرفا",39,"ف",2,0],["وسُكْناي بالفسطاط عزٌّ وإنما","محلُّ فؤادي فيه أَسْنَى وأَشْرَف",40,"ف",1,0],["وسكبته من غور وجداني","وأعماق الضمير",41,"ر",1,0],["وسَكَبتُ لحناً عسكريّاً","دونهُ وقَفَ المُباري",42,"ي",1,0],["وسكَبتها شعراً رثيتُ","بهِ الروح الحَزينِ",43,"ن",1,0],["وسكرانة سكرى دلالٍ وقوَّةٍ","إذا هي قامت لم تَخُنها المفاصلُ",44,"ل",1,0],["وسكران اللواحظ وهو صاحي","لهَا بالراح عن طلب الرواحِ",45,"ح",1,1],["وَسَكِرتُم بِخَمرَةِ الاِنتِصارِ","وَشَربُتُم دَمَ الوَرى بِالجَماجِم",46,"م",1,0],["وسكرت من لحظاته وكؤوسه","فتسَاوت الأحداق والأقداحُ",47,"ح",1,0],["وَسُكّانُ الجَنوبِ وَجانِبَيْها","سَيُسحِتُهُم بِه عَصْفُ الدّبورِ",48,"ر",1,0],["وَسُكرُ الهَوى هُوَ صِرفٌ لَهُ","تَباريحُ لَيسَت لِسُكرِ المُدامِ",49,"م",1,0],["وسكان دارك ممن أعو","ل يلقين من برده كل شر",50,"ر",1,0],["وَسُكونُ نَفسي في هَواهُ مُحَرِّكي","وَثَباتُ عَزمي نَحوَهُ وَثَباتي",51,"ت",2,0],["وَسَكَراً بَسَطتُ القَولَ فيهِ وَعِندَما","يُعاوِدُني صَحوي بِهِ يُخرَقُ البَسطُ",52,"ط",1,0],["وَسَكَبتُ دَمعِي ثُمَّ قُلتُ لِسَكبِهِ","مَن لَم يَذُب مِن زَفرَتِي فَليَغرَقِ",53,"ق",1,0],["وسكنْتُ بين عِدايَ حصْنَ تَجمُّلٍ","أضحى على الحدَثانِ غيرَ مَنيع",54,"ع",1,0],["وَسَكرانَ كَرَّرَ مِن سُكرِهِ","زَمانٌ عَلى كُلِّ عَقلِ مُمالي",55,"ل",2,0],["وسكونُ الحياة في جَسَد الأح","لام لم يُبقِ قَطُّ للعيش معنى",56,"ن",2,0],["وسكنَّا من آيهِ في حصونٍ","شامخات الذُّرى وحرزٍ مكينِ",57,"ن",1,0],["وسكتُّ حين رأيتُ آلافاً على","حالي يرون الجِذْعَ والمنشارا",58,"ر",2,0],["وسكرت منه ولم أذق","ه بغير تخييلي ووهمي",59,"ي",1,0],["وسكنا بعدهم سامي الذرى","قد لمسنا من سناه الشهبا",60,"ب",2,0],["وسُكرِيَ من حُبِّهِ لا أُفِي","قُ منهُ فأعَلَمَ ما أَعمَلُ",61,"ل",1,0],["وسكَّن فعلاً ماضياً من غراره","وما دخلت يوماً عليه الجوازم",62,"م",1,0],["وسكر صباباتي بها وإفاقتي","حَلَفْتُ يميناً صادقاً جهد طاقتي",63,"ي",1,0],["وسكونُ خاشٍ صِيغَ من مَهَل","منه حَراكٌ صِيغ من مُهْل",64,"ل",1,0],["وسكران أو ذي حاجةٍ في خلائه","وذي العشق في بحر الهوى فهو عائم",65,"م",1,0],["وسكوت أمة يعرب عن حقه","كفر ومثوى الكافرين النار",66,"ر",1,0],["وسَكرى من الوجد الدخيل أبحتها","عَفافَ تقيٍّ لا عفاف مُخادعِ",67,"ع",1,0],["وسكن ندبي بعد طول جماحِهِ","على الجائدِ الوهابِ والفارس الندب",68,"ب",1,0],["وسكن حتى وجيف البلاد","فأطفالها لا تريد المهودا",69,"د",2,0],["وسكنّ علمي بعضَ ما أنا واجدٌ","بأنّا أناس من خلائقنا الصبر",70,"ر",1,0],["وسكبتُ دمعي في الديارِ وقد نأى","عنها الخليطُ مقوَّضاً ومودَّعا",71,"ع",2,0],["وسكنتها والسيف في الجفن نائم","ولولا حذار الضرب دام اضطرابها",72,"ب",3,0],["وَسَكَّنت ما بي مِن ملال وَمن كَرى","وَما بِالمَطايا من جُنوح وَلا فثر",73,"ر",1,0],["وسكر الهوى لو كان يحكيه لذةٌ","من الخمر سكرٌ لم يكن حُرِّم السكر",74,"ر",1,0],["وسَكِّنْ صَهِيلَ الْمُهْرِ وانْزَعْ شَكِيمَهُ","وَضَعْ لأمَتِي مِنْ فَوْقِ ظَهْرِ جَوَادِي",75,"ي",1,0],["وسكنتِ ممّن كلُّ جاريةٍ له","شوقاً إليكِ وصَبْوَةً لا تسكنُ",76,"ن",1,0],["وسكنّ ألْبابَ الرّجال وحيثما","كان القريض إليه غيرَ وَصولِ",77,"ل",1,0],["وسُكارى الزّمان بالطّمع الكا","ذب فيه أعيوا عليَّ السّكارى",78,"ر",2,0],["وسكر ولاسكر إذا ما شهدتها","وإن حجبت عني فصحو ولا صحو",79,"و",1,0],["وسكرنا براهب الدير لما","هب منها معطر الأنفاس",80,"س",1,0],["وسكَتُوا لأَنَّهُمْ","قد شَرِقُوا بالأَرْيَاقْ",81,"ق",1,0],["وسَكْرانةِ الأَعْطافِ صاحبة الصِّبا","تُميتُ وتُحيي بالبُعَاد وبالقُرب",82,"ب",1,0],["وسكتةُ حلم تُسْمع النَّهْيَ للنُّهى","وشكوةُ حَزْم يَخْفِض الدَّم للدِّمَا",83,"م",2,0],["وَسَكَّنْتَهُ في لَظَى مُهْجَتي","وَذاكَ لَعَمْرِي جَرا مَنْ قَتلْ",84,"ل",1,0]]}