جز"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70150","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69918","البسيط"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77694","البسيط"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52129","البسيط"],[4782,"يباس","https://www.poetsgate.com/ViewPoem.aspx?id=207551",""],[4790,"يا نخلة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=144354",""],[4815,"مياسة العود","https://www.poetsgate.com/ViewPoem.aspx?id=210424",""],[4927,"هاتفُ إيْمَان","https://www.poetsgate.com/ViewPoem.aspx?id=30188",""],[4983,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=21771",""],[4119,"يا نخيل العراق كن في أمان الله","https://www.poetsgate.com/ViewPoem.aspx?id=16050",""],[5106,"جَاْدَتْ غِيُوثُكَ ..","https://www.poetsgate.com/ViewPoem.aspx?id=137168",""],[5111,"جموحُ","https://www.poetsgate.com/ViewPoem.aspx?id=212077",""],[5174,"رَفيفٌ إِلى مِشكاةِ الضَّادِ","https://www.poetsgate.com/ViewPoem.aspx?id=185374",""],[5277,"ذكرى 1973 بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=198527",""],[5283,"بدر على الأرض","https://www.poetsgate.com/ViewPoem.aspx?id=207946",""],[5360,"يانخيل العراق","https://www.poetsgate.com/ViewPoem.aspx?id=33241",""],[5431,"وهل يموت كريم الأصل ياعمر","https://www.poetsgate.com/ViewPoem.aspx?id=188274",""],[5491,"ابنة النور","https://www.poetsgate.com/ViewPoem.aspx?id=196726",""],[5517,"أشجار وراء السياج","https://www.poetsgate.com/ViewPoem.aspx?id=199054",""],[5618,"في جبة التأويل ..عراق الصمود","https://www.poetsgate.com/ViewPoem.aspx?id=208921",""],[5674,"مزق الأكباد سيف الجاهلية","https://www.poetsgate.com/ViewPoem.aspx?id=185912",""],[5674,"نبضتي متوقده","https://www.poetsgate.com/ViewPoem.aspx?id=198686",""],[5674,"قال لها :","https://www.poetsgate.com/ViewPoem.aspx?id=207919",""],[5757,"سَعَفُ الحنينْ","https://www.poetsgate.com/ViewPoem.aspx?id=95116",""],[5829,"انت الشآم","https://www.poetsgate.com/ViewPoem.aspx?id=150260",""],[6126,"النَّخْلة","https://www.poetsgate.com/ViewPoem.aspx?id=190002",""],[6212,"أميرة الماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1629&r=&rc=10",""],[406,"أين بغداد عنا ؟!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=925&r=&rc=55",""]],"verses":[["يَا نُخْبَةً مَلَكُوا التَّجِلَّ","ةَ في فُؤَادِي وَالْحُبَابَا",0,"ب",2,0],["يَا نُخْبَةٌ يَشْهَدُونَ اليَوْمَ حَفْلَتَنَا","مِنْ كُلِّ مَسْعَدَةٍ أَوْ كُلِّ مِعْوَانِ",1,"ن",1,0],["يَا نَخْلَةَ الخَيْرِ قَوْلٌ","مِنْ صَاحِبٍ لاَ يُدَاجِي",2,"ج",2,1],["يا نخوة اللات والعزى خزيت ويا","جبرية الشرك جاء الله فانكسري",3,"ر",2,0],["يا نخبة الله للاسلام يا حمد ال","المعمور يا ابن ثويني المبدع الخططا",4,"ط",2,0],["يا نخلُ يا نَحلُ حظِّي منكَ ليسَ سِوى","شَوكٍ ولسعٍ فهل مِن أَطْيَبَيْكَ جَنى",5,"ن",2,0],["يا نخبة العصر الجديد وحزبه","ورجاله وحماته في القابل",6,"ل",1,0],["يا نخبة القلب علام الجفا","لنخبة الفكر وسفر العماد",7,"د",1,0],["يا نخبة الأحرار في خضرائنا","أنتم وإياه لها الأنجال",8,"ل",1,0],["يا نخلةً ذَهَبتْ بلا ثُمرٍ نَرى","كلُّ العِبادِ على صِباكَ تأسَّفَتْ",9,"ت",1,0],["يا نخبة الأعيان من أهل التقى","من مغرب حتى لأقصى الصينِ",10,"ن",1,0],["يَا نخلةَ العُمرِ التي","فرَشَتْ على الدُنيا الظِلالا",11,"ل",2,0],["يا نخلة َالعمر ِأيامي الوَلودَة ُقدْ","هزَّتك ِنادبَة ًفاسّاقطَ الحَشَفُ",12,"ف",1,0],["يا نخل كنا فيك نعتقد الصفا","والود أين مضى الذي بك نعهدُ",13,"د",1,0],["يا نخيل العراق، مَنْ في العراقِ","يرفع الهام بعد شد الوثاقِ؟!",14,"ق",1,1],["يا نخيل العراق، مالك تزهو","بجنان شهية الأعذاق",14,"ق",1,0],["يا نخيل العراق، لستُ بقومي","كافرا، رغم غصتي واحتراقي",14,"ق",2,0],["يا نخيل العراقِ، جرحك جرحي","والرفاق الأباة فيك رفاقي",14,"ق",2,0],["يا نخبة الأيام والفرد الذي","فوق النخود المفردين تعالى",15,"ل",2,0],["يا نخبة الأيام بل يا فخرها","وعزيزها الفرد الفريد الأوحدُ",16,"د",1,0],["يا نخبة الإخوان لا زلت في","صون الحمى من حافظ حاذق",17,"ق",1,0],["يا نخلتَيْ بحرَيْ بَلَرْمَ سُقيتُما","صوبَ الحيا بتواصلٍ لا يُصرَمُ",18,"م",1,0],["يا نخلةً كلما مرَّ النسيم بها","حنّت اماليدها خفضاً تحييه",19,"ي",2,1],["يانخلة الافضال ما من صاحب","نلقاه في هذه المصيبة صاحيا",20,"ي",2,0],["يا نخلة في طريقي اليوم عارضة","اكاد ألثمها: أهوي أعانقها",21,"ق",3,1],["يا نخلة في طريقي اليوم عارضة","قد عاد فيك من الأيام رائقها",21,"ق",3,0],["يا نُخبة الرحمان يا من نوره","من قبل طينة آدم المتقدم",22,"م",1,0],["يا نخبة الدهر في الدرايه","علما تعاضده الروايه",23,"ا",3,1],["يا نخلة المجد المحيط بأصله","عيشٌ لكل صد ومقتطف حلا",24,"ل",2,0],["يا نخبة النجباء مات عميدكم","فتسربلوا ثوب الحداد مفوفا",25,"ف",2,0],["يا نُخبَةَ الأَبطالِ جُندَ الباسِ","قِفوا اِدفَعوا الحِمامَ عَن أَياسِ",26,"س",1,0],["يا نخبةَ الدول الفخام","ووزيرنا واصه الهمام",27,"م",1,0],["يا نخبة الدَهر للشهباءِ يرمقها","بعينِ لطفٍ وَتحميها طَلائِعهُ",28,"ع",2,0],["يا نُخبَةً ضَمَّها تُربٌ وَلا عَجَب","إِنّ التراب قَديماً مَدفَن النُخَبِ",29,"ب",1,0],["يا نخلةً من ربى الأفضال قد قُصفت","أثمارها لم تزل تدنو مجانيها",30,"ي",3,0],["يانخيل العمر دُسّي غربتي","سعَفٌ أجدبَ منذ الأزل",31,"ل",1,0],["يا نَخْلَةَ الروحِ يا حُباً يُبَعْثِرُني","يا عالماً لمْ يَزَلْ بالعِشْقِ مُتَّقِدا",32,"د",2,0],["يا نَخْلَةَ الروحِ رُدي بَعْضَ ما سَرَقَتْ","مني الليالي فَعُمري قَدْ مَضَى بَدَدا",32,"د",2,0],["يا نخلةً فتَنَتْ أحلامَ قافيتي","فأرسَلتْ بالهوى أطيافَها الرُّطبُ",33,"ب",1,0],["يَا نَخْلَةً مِنْ بِلادِ الشَّامِ باسِقَةً","تُغْرِي الْحَلِيْمَº وَتَجْلُو الْهَمَّº وَالتَّعَبَاْ",34,"ب",2,0],["يَا نَخْلةً فِي سَمَاءِ المَجِد بَاسِقَة","لَمْ يَثْنِهَا صَلَفُ البَاغِينَ مِنْ قِدَمِ",35,"م",1,0],["يا نخيل العراق كن في أمان الله","مستودعا حيا الأنواء",36,"ا",2,1],["يَاْ نَخْلَةً لَوْ تَعْلَمِيَنَ مِنَ الظَّمَاْ !","لا تَنْضَحِيْنِيْ قَدْ تَرَيْنَ حَرَاْئِقَاْ",37,"ق",2,0],["يَا نَخْلَةً زُرِعَتْ فِيْ أرْضِ غُرْبَتِهَا","لاَ مِنْ يُعَانِقُنِي لاَ مَنْ يُدَارِينِيْ",38,"ن",2,0],["يا نَخلَةَ اللَّهِ في إِعجازِ جَنَّتِهِ","وَمَنطِقًا شَمَلَ الإِيجازَ فِيمَ شَمَلْ",39,"ل",1,0],["يا نخلة الشط هل لقياك راجعة","فنستزيد رحيقاً منك ريّانا",40,"ن",2,0],["يا نخلةً زرعَ الجمالُ جذورَها","وفروعُها غيضٌ لفيضِ بهاكِ",41,"ك",1,0],["يا نخيل العراق إن جراحي","راعفات وإن حرفي معاق",42,"ق",1,0],["يانخلة في رُبا الأمجاد شامخة","يافجر أمتنا قد جئتُ أعتذرُ",43,"ر",1,0],["يانخلةً في ضفاف النهر باسقةً","ممشوقة القدِّ تُهدي أجمل الرُّطَبِ",44,"ب",1,0],["يا نخلةً في البيدِ تسري وحدها","حلماً غريباً تاهَ في أجفانيا",45,"ي",2,0],["يانخلة الأمجاد جئتكَ عاشقا","في هيئةٍ نُساكُهَا أعراقُ",46,"ق",1,0],["يا نخلة أبهى وأعطر من شذى","ردي إليَّ النبض شوقا يا ندية",47,"ي",2,0],["يا نخلة الأعماق شاطيء غربتي","لمّي عثاري نبضتي متوقده",48,"د",2,0],["يا نخلة شماء باسقة الهوى","ما كنتُ أبحرُ في الهوى لولاها",49,"ا",3,0],["يا نخْلةَ العِزِّ º كمْ لِلتّمْرِ مِنْ ألَقٍ","مِلْءَ الشُّموخِ..الذِي في عُمقِ ؟",50,"ق",1,0],["يا نخلةَ العِزِّ º ذِي الأحلامُ رائِحةٌ","خلفَ الفُؤادِ أسًى، واسْتسلمَ الغادِي",50,"د",2,0],["يا نخلَ اندلس يحن لشرقنا","تُسقى من الاموي عذب الماء",51,"ا",2,0],["يا نخلةً فوق الأعالي سامقةْ","ذات الأصولِ الآمداتِ الواثقةْ",52,"ق",2,1],["يا نخلةً يلهو الهجيرُ بشَعرها","والصُّبحُ قَبَّلَ رأسَها بمعانقة",52,"ق",2,0],["يا نخلةَ الله التي أثداؤها","رُطَبُ الحياةِ وظِلُّها المُتَهَصِّرُ!",53,"ر",1,0],["يا نخيلاً ما زال يُنْتِجُ تَمْراً","ويُرينا بَشاشةَ الإِعذاقِ",54,"ق",1,0]]}