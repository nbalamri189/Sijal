{"poems":[[65,"سقى همذان حيا مزنة","https://www.aldiwan.net/poem45813.html","المتقارب"],[95,"أيزيدك التبجيل والتكريم","https://www.aldiwan.net/poem11415.html","الكامل"],[53,"ما مدمعي حذر النوى بقريح","https://www.aldiwan.net/poem9403.html","الكامل"],[53,"لهف نفسي على العيون المراض","https://www.aldiwan.net/poem64947.html","الخفيف"],[46,"برعت محاسنه فجل بها","https://www.aldiwan.net/poem30219.html","الكامل"],[76,"برعت فرعت فمن ذا حبيب","https://www.aldiwan.net/poem12875.html","المتقارب"],[107,"مصيبة أمة وأنا المصاب","https://www.aldiwan.net/poem41138.html","الوافر"],[83,"قبولك ريعان الشباب فلا ولى","https://www.aldiwan.net/poem61420.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54917","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54986","الخفيف"],[112,"المستحيل","https://www.poetsgate.com/ViewPoem.aspx?id=8394",""],[302,"ظبى وسهام أم رنا ولحاظ","https://www.aldiwan.net/poem33230.html","الطويل"],[412,"محل العلى أني حللت محلها","https://www.aldiwan.net/poem50133.html","الطويل"],[445,"نور الوفاء بأرضنا لك ساطع","https://www.aldiwan.net/poem34838.html","الكامل"],[463,"متى رفعت لها بالغور نار","https://www.aldiwan.net/poem56187.html","الوافر"],[505,"رفعت بسري كل أمري لسيدي","https://www.aldiwan.net/poem38020.html","الطويل"],[568,"أحداج تلك الجمال","https://www.aldiwan.net/poem13601.html","المجتث"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53779","الكامل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54115","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37859","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64586","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49929","البسيط"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128715","الكامل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128704","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108547","البسيط"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134009","الخفيف"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101609","الخفيف"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66457","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110064","الكامل"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105125","البسيط"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45028","الرمل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94586","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94550","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94399","البسيط"],[4929,"وضيفة الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=199553",""],[5183,"تأبين الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=180260",""],[5216,"قناة السويس","https://www.poetsgate.com/ViewPoem.aspx?id=187002",""],[5431,"برعشة الحب أهواه ..أمجده","https://www.poetsgate.com/ViewPoem.aspx?id=186384",""],[5759,"رحلت","https://www.poetsgate.com/ViewPoem.aspx?id=213550",""],[5956,"ديمقراطية الدمويِّين","https://www.poetsgate.com/ViewPoem.aspx?id=192364",""],[5956,"مولدِ الطفل أدهم إيهاب","https://www.poetsgate.com/ViewPoem.aspx?id=193097",""],[4442,"أرني في العلا نجوم سمائك","https://www.poetsgate.com/ViewPoem.aspx?id=170993",""],[6237,"اليتيم السعيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77872&r=&rc=14",""],[6259,"محلَّ العلى أنى حللتَ محلّها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59395&r=&rc=43",""]],"verses":[["بِرَعدٍ كَما جَرجَرَ الأَرحَبيُّ","وَبَرقٍ كَما بَصبَصَ الأُفعوانْ",0,"ن",1,0],["بِرِعايَةِ المَلِكِ ازْدَهَى عِيدٌ لَهُ","فِي المَشْرِقَيْنِ القَدْرُ وَالتَّقْوِيمُ",1,"م",1,0],["بَرَعَتْ محاسِنُه فَأقْسَمَ صادقاً","أنْ لا يُعَرِّضَهُنَّ للتّقْبِيحِ",2,"ح",1,0],["برع المجد فيهمُ فحباهُمْ","مدحَ ذي وُدِّهم وذي الإبغاض",3,"ض",1,0],["بَرَعَت مَحاسِنُهُ فَجَلَّ بِها","مِن أَن يَقومَ بِوَصفِهِ لَفظُ",4,"ظ",1,1],["بَرَعتَ فَرُعتَ فَمَن ذا حَبيبٌ","لَهُ الوَيلُ أَم مَن أَبو الطَيِّبِ",5,"ب",1,1],["برعت فكنت ملء الدهر خلدا","وكل براعة للخلد باب",6,"ب",1,0],["بَرَعتَ أَبا بَكرٍ فَلَستَ بِمُرتَضٍ","رَوَّيتَهُم شَمساً وَلا طَلَّهُم وَبلا",7,"ل",2,0],["بَرٌّ عَلَى رَغْمِ الفِرا","قِ بِعَبْدِهِ المُتَخَضِّعِ",8,"ع",1,0],["بَرَعَ البَارِعِينَ بِالنُّطْقِ وَالإِيمَاءِ","وَالصَّوْتِ بَيْنَ خَفْضٍ وَجَهْرِ",9,"ر",1,0],["بَرَعَتْ تحْلِيَاتُهَا صُوَراً","وَزَهَتْ تَحْشِيَاتُهَا نَقْشَا",10,"ش",2,0],["بر .. عزله .. توحّد .. هم ...ضيقه وليل","ضو .. دلّه .. بكت .. ولاّعه ومسبحه",11,"ح",2,1],["برعتُ على أَهل الغَرام بوصفها","كأَنّي قُسٌّ وَالغَرامُ عُكاظُ",12,"ظ",1,0],["برعت عَلى أَبناء سينِّكَ رِفعَةً","فَأَنتَ فَتاها في الفَخارِ وَكَهلُها",13,"ل",3,0],["برعايَةٍ لا هَدْيُ هُودٍ غائِبٌ","عنها ولا إِيصاءُ يَعْرُبَ ضائِعُ",14,"ع",1,0],["بَرعيِك فِيَّ حقَّ الفضلِ صحّت","قناةٌ كلُّها وصْمٌ وعارُ",15,"ر",1,0],["بِرعْدَتهِمْ ضِمنَ الجَنائبِ في السُّرى","إليكَ بَهاتيكَ العَزائِمِ في السَّيْرِ",16,"ر",1,0],["بَرَعَت في البَدءِ فَاِزدَن","بَراعَةً في الكَمالِ",17,"ل",1,0],["بَرَعتْ محاسنه فجلَّ لها","عن أن يقوم بوصفها لَفظُ",18,"ظ",1,1],["بِرَعْي عدول الوقتِ غيباً ومَشْهَداً","تَحُلُّ من الفردوسِ أعلى الأرائِكِ",19,"ك",1,1],["بَرٌّ عَلى بَحرِ المَكارِمِ مُنطوٍ","حُرٌّ عَلى كَرَمِ الطّبايِعِ مُحتوي",20,"و",2,0],["برعي لا إله إلا اللّه","ورعي أسمائك عجل المدد",21,"د",1,0],["بَرْعى العُفاة رياضاً من مواهبَهُم","قد أَطلَعوا من نَداهم فوقها سُحُبا",22,"ب",2,0],["بر عطوف بالحياء ملثّم","روف رحيم بالوقار متوج",23,"ج",1,0],["برّ عطوف طاهر ومطهّر","روف رحيم شافع ومشفّع",24,"ع",1,0],["برٌّ عفيفٌ حليمٌ قادرٌ سطعت","في الكون مثل سطوع الشمس حكمته",25,"ت",2,0],["بر عفو يجدي سلاماً وفوزاً","ونراه في الجود بحراً خضما",26,"م",2,0],["برعم الزهر ما وجدت لتبقى","بل ليمضي بك الخريف وتمضي",27,"ض",2,1],["برعت في اللوم هلا كنت مقتدياً","بقول من قال ما في العشق من باس",28,"س",1,0],["برعَ الختامُ بها بمسك ثنائِها","فاعظِم باللطائِمِ يُختَمُ",29,"م",1,0],["برعت مقتبساً لمح الكناية با","ستخدام من هو بالابداع مشهور",30,"ر",1,0],["بَرُعَت حُسناً لِذا أَرّختُها","بَرعَت بالقَيروان الصادِقيَّه",31,"ي",2,0],["برٌّ عطوف منعمٌ عَمِدُ الثرى","لرحابهِ كل العفاة تسيرُ",32,"ر",1,0],["برٌّ عطوفٌ عدولٌ في رعيَّتهِ","راعٍ رأوفٌ على شعبٍ يراعيهِ",33,"ي",2,0],["بَرٌّ عطوفٌ همام أروعٌ حكمٌ","شهمٌ رَؤوفٌ لَقَد جلَّت عناصرهُ",34,"ر",2,0],["بِِرَعْديْ سأُرعِبُ سُلطَانََهُ","وأَشْوِيْ الشَّيَاطِيْنَ صَعْقًا مَهُوْلَا",35,"ل",2,0],["برعت يد الأيام صبراً على الأذى","فبؤ بجميل الذكر خير ضليع",36,"ع",1,0],["برعتم فى البناءِ بعصر خوفو","فجِدّوا فى بناءِ المجدِ هيّا",37,"ي",2,0],["برعشة الحب أهواه ..أمجده","المجد للعشق يا سعدي ويامجدي",38,"د",2,0],["برعَ المليكُ بخلقها حتى لقد","وُلِدَت محاسنُها لغيرِ فناءِ",39,"ا",2,0],["برعوا بتدجينِ العروبة والقوى","لتظلَّ حالبة لهم مثل البقرْ",40,"ر",1,0],["برعاية الأبوين رباه الُعلا","ورعايةٍ من جَدَّتيه عُظمَى",41,"م",2,0],["برع الشيخ في الشفاء فبرهن","حين تدوي قلوبنا بشفائك",42,"ك",1,0],["(برعمٌ) من براعم الجيل ما زال","طرياً غُصينه الأملودُ",43,"د",1,0],["برعتَ على أبناء سنك رفعة ً","فأنت فتاها في الفخار وكهلُها",44,"ل",3,0]]}