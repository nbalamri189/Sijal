","الطويل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52168","السريع"],[4680,"أدرك حدود الصبر","https://www.poetsgate.com/ViewPoem.aspx?id=185014",""],[4927,"غضب دُجانة","https://www.poetsgate.com/ViewPoem.aspx?id=29643",""],[4988,"للخالدية جابني الشوق من غاد","https://www.poetsgate.com/ViewPoem.aspx?id=214086",""],[3271,"ويعيش أحرار العقول بظلها غرباء","https://www.poetsgate.com/ViewPoem.aspx?id=104120",""],[5206,"الجاهل والعارف","https://www.poetsgate.com/ViewPoem.aspx?id=187359",""],[5206,"غابة الغرايب","https://www.poetsgate.com/ViewPoem.aspx?id=187358",""],[5277,"نخلةُ (الصوبين)","https://www.poetsgate.com/ViewPoem.aspx?id=185564",""],[5277,"القصيدةُ القيسيّة","https://www.poetsgate.com/ViewPoem.aspx?id=199277",""],[5324,"فعلينا وعلى المجد السلام .","https://www.poetsgate.com/ViewPoem.aspx?id=207663",""],[5409,"أخرتنا نقائص عن سوانا","https://www.poetsgate.com/ViewPoem.aspx?id=155424",""],[5431,"دجلة الحب-للعراق الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=198264",""],[5464,"أوصيك بي شراً اذا خنت الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=7560",""],[5543,"ضجيعي في ليلى جوىً ونحيب","https://www.poetsgate.com/ViewPoem.aspx?id=181704",""],[5573,"مدية بارضها حقيقها","https://www.poetsgate.com/ViewPoem.aspx?id=200325",""],[5582,"بريقٌ بِأَعْلَى الأَبْرَقَيْنِ تأَلَّقَا","https://www.poetsgate.com/ViewPoem.aspx?id=63544",""],[5701,"ذهبت للنيل وقلبي على","https://www.poetsgate.com/ViewPoem.aspx?id=164610",""],[5732,"يا فزعة المظيوم","https://www.poetsgate.com/ViewPoem.aspx?id=177835",""],[5956,"منطق العدوان","https://www.poetsgate.com/ViewPoem.aspx?id=192221",""],[6102,"عي الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=184460",""],[6108,"نفاق","https://www.poetsgate.com/ViewPoem.aspx?id=192750",""],[463,"تمدُّ بالآذانِ والمناخرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60073&r=&rc=129",""],[572,"دَجَاجَة ٌ في سِمَنْ السّمَنْدِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9248&r=&rc=105",""],[6368,"","https://www.linga.org/varities-articles/NDEwMQ","المضارع"]],"verses":[["دجَتِ الخُطوبُ فكُنْتَ نورَ ظَلامِها","خفِيَ الرّشادُ فكُنْتَ أنْتَ مَنارُهُ",0,"ر",2,0],["دجا ليلُ نحسٍ في سرارٍ وأطبقتْ","عليه السواري فهو أسود أطولُ",1,"ل",1,0],["دَجَتِ الحَقائِقُ حِقبَةً ثُمَّ اِنبَرى","فَتَبَلَّجَت وَاِنجابَ عَنها الغَيهَبُ",2,"ب",1,0],["دُجونٌ يُسَمَّينَ الخُيولَ وتحتَها","رِياحٌ يُلقَّبنَ القوائمَ أربعُ",3,"ع",1,0],["دَجّالُنا أَحوَلُ مِن شُؤمِهِ","وَالناسُ دَجّالُهُمُ أَعوَرُ",4,"ر",1,1],["دَجَتِ العُصورُ فَما يَبينُ لِأَهلِها","نورُ الحَياةِ وَما يَحينُ صَباحُ",5,"ح",1,0],["دُجًى تتشابَهُ الأشْباحُ فيه","فيُجْهَلُ جِنسُها حتى يَصيحا",6,"ح",2,0],["دجلة لا تخرج من حوزنا","وَنَحن أَحياء عَلى الأرض",7,"ض",1,1],["دجلة دجلة فلم تتغير","وكذاك الفرات عين الفرات",8,"ت",1,0],["دجلة إِن درى بنو دجلة أَن","يَستَفيدوا منها تَفيض نضارا",9,"ر",2,0],["دَجا فتَلَهّبَ المِرّيخُ فيه","وألْبَسَ جَمْرَةَ الشمسِ الرّمادا",10,"د",2,0],["دَجا نَهاري فَكَيفَ لَيلي","مُنذُ هَوى كَوكَبُ السُعودِ",11,"د",1,0],["دُجى اللَيل صُبحٌ فيك إِذ أَنت مطلعٌ","لِكُلِّ هِلالٍ أَطلَعتهُ سُعودُ",12,"د",1,0],["دَجاجةٌ في شَبَهِ السَّمَنْدِ","تَليدَةٌ وفخرُها بالهندِ",13,"د",1,0],["دجت القرونُ؛ فقام دينُك حارسًا","يحمي ذمار حضارة الأسلاف",14,"ف",1,0],["دَجَا قَسْراً وسادَ ، وكان شَهماً","صريحاً أنَّه بالرُّغمِ سادا",15,"د",2,0],["دجلةٌ والنيلُ والشامُ معاً","و\" الصَّفا \" تندُبُ شجواً و\" الحَجون \"",16,"ن",1,0],["دُ جَنبَرُ قَد لاَح الذِّرَاعَانُ تِسعَهُ","وفي أثنَينِ مَع عِشرِينَ نَثرَةُ تَظهَرُ",17,"ر",1,0],["دُجايَ إذا واصَلتَ يَومٌ مُؤبَّدٌ","ويَومِي إذَا أبعَدتَ لَيلٌ مُسَرمَدُ",18,"د",1,0],["دُجى الشِرك جَلّاهُ عَنِ الدينِ وَالدُنا","هِلالٌ بِلألاءِ الهُدى يَتَوَقَّدُ",19,"د",1,0],["دُجَيلِيَّةٌ لَو حَطَّ غَيلانُ رَحلَهُ","بِها ساعَةً أَنسَتهُ حُزوى وَمُشرِفا",20,"ف",2,0],["دجا بك في بحر الخطوب ملالة","وصار لها عبدا يقول ويفعل",21,"ل",1,0],["دَجت أَيّامُنا مُذ غِبتَ عَنّا","وَكانَت مِنكَ مُشرِقَةً مُضِيّه",22,"ض",3,0],["دجا الظلامُ فيا لَيلَى أَمَا فينا","روح ام الموت مثل الرزق جافينا",23,"ن",2,1],["دجاجاتٌ يطيف بهن ديكٌ","يناجي بالصياح إذا يناجي",24,"ج",2,0],["دَجَا ما بَيْنَنا فَمَتَى وحَتَّى","يُنِيرُ وفِي إِجَابَتِها تَوانِ",25,"ن",1,0],["دَجاجُ أَبي عُثمانَ أَبعَدُ مَنظَراً","وَأَطوَلُ أَعماراً مِنَ الشَمسِ وَالقَمَر",26,"ر",1,1],["دَجاجاتٌ دَجىً جاءَت إِلَينا","بِبَيضِ البيضِ في حَضَنٍ بِحُضنِ",27,"ن",1,0],["دَجا لَيلَها إِلّا لِتَختِلَ عَقرَبٌ","أَضا صُبحُها إِلّا لِيَلسِبَ أَرقَمُ",28,"م",1,0],["دَجا لَيل هَمي فَأَجله بِابتِسامة","كَما يَكشف اللَيل البَهيم سَنا البَرق",29,"ق",1,0],["دُجوجيَّة الفَرعين شَمسِيَّة الرؤا","كَثيبية الأَردافِ خوطِيَّة القَدِّ",30,"د",1,0],["دجىً عارضَ الأقلامَ فيه وأومضت","بروقُ المَعاني بينَهُ فتألّقا",31,"ق",2,0],["دُجىً مثلَ جِلْبابِ السماءِ اسْتَمَرَّ بِي","فَقَنَّعَ فَوْدَيَّ المشيبَ وعَمَّما",32,"م",2,0],["دجلةُ والفرات أو","شالٌ لها ونُطَفُ",33,"ف",1,0],["دجَتْ ما دجت ثم انجلت وسيوفُكم","كواكبُ فيها أو وجوهكم الغُرُّ",34,"ر",1,0],["دَجَتْ ولكن أقشعتْ عن أنفُسٍ","سواكنٍ وأعينٍ قرائرِ",35,"ر",1,0],["دجا ليلُها وهي السهام تقامُصاً","فلم ينصرم إلا وهنَّ طَرائحُ",36,"ح",1,0],["دجا عنده ليلٌ من النَّقْع حالكٌ","فسيحُ النواحي والنجوم عوامله",37,"ل",2,0],["دجا صُبحهم من حظهم فرأوا به","تجاذُبهم آمالُهم وتناقُل",38,"ل",1,0],["دجا ليلُ همي واكفهرت بشاشتي","ورْحتُ بحالي واجماً أيَّ واجمِ",39,"م",1,1],["دَجا ليلهُ والصُّبْحُ في عُنْفوانه","بكل مُثارٍ بينَ خُفٍّ وحافرِ",40,"ر",1,0],["دَجْنٌ صَدوقُ الشَّيْمِ سَّحَّاحٌ","إذا خَوَتِ النُّجومُ",41,"م",1,0],["دجى نقعه يسودُّ منهُ سنا والضحى","وتخضرُّ من نعماه حتى الجلامد",42,"د",1,0],["دُجى أَنتَ بَدرٌ بِهِ وَالنُجو","مُ زَرقُكَ وَالظُلمَةُ القَسطَلُ",43,"ل",1,0],["دُجَى غَيْهب التفرِيقِ قد زال واشمطَّا","وَاقبْلَ صُبْحُ الجمع منْ بعد ما شَطَّا",44,"ط",2,1],["دجاً فكأنّي من حناياهُ أو أتى","جريمةَ سوءٍ في سريرةِ مُجرمِ",45,"م",1,0],["دجا الخطب حتى كاد ان يستشظنا","وضاق خناق الصبر واتسع الوهم",46,"م",1,0],["دُجى العجاج الذي انجابت جوانبُه","عن نبض بَرْقِ ظُبىً لم يخبُ إذ نبضا",47,"ض",2,0],["دجى شعرٍ أرتك يدُ الليالي","نجومَ الحلم تطلعُ في دجاه",48,"ه",1,0],["دجور الراس تانس فيه باس","هباب امّا ييودها الخزامي",49,"م",2,0],["دجاجُه المهداةُ قد أفصحتْ","إذ وَصلت عند اصفرار الأصيل",50,"ل",1,0],["دجى نقعه يسودُّ منهُ سنا الضحى","وتخضرُّ من نُعماه حتى الجلامد",51,"د",1,0],["دجىً مدلهمٌّ تحتهُ البدرُ بازغٌ","عَلى غصنِ بانٍ فوقَ دعصٍ من النقا",52,"ق",2,0],["دجىً فوقَ بدرٍ تحته غصنُ بانةٍ","يُجاذبهُ دعص من الرمل أهيلُ",53,"ل",1,0],["دجاهم وصبحهم واحد","وقد مزق الدود منهم جلودا",54,"د",2,0],["دِجلَةُ تَسقى وَأَبو غانِمٍ","يطعِم مَن تَسقى مِنَ الناسِ",55,"س",1,1],["دجّت ببؤسٍ فلم تَبرح تضاحِكُها","بوارقُ اللُّطفِ حتَّى أمطرت نِعما",56,"م",2,0],["دجىً لو سرت فيها الشياطين ترتقي","إلى السرِّ لم تخلص إليها النيازك",57,"ك",1,0],["دُجُنَّةٌ تصفُ الأنوارَ غُرَّتُها","وَنَبْعَةٌ يَدَّعي أعْطَافَها البانُ",58,"ن",1,0],["دجت يوم إعلان الحماية شمسه","فيا لك من يوم على مصر أورق",59,"ق",1,0],["دجا فاستكانوا تحته بين حائر","يشق بعينيه السماء ومطرق",59,"ق",1,0],["دجا ليله بأسا وقد طلعت به","نجوم نصال وهو بالبيض مقمر",60,"ر",1,0],["دجنت فشق لليلها من رأيه","فجراً تقشع في سناه ظلامها",61,"م",3,0],["دَجا اللَّيلُ واستَنَّ استناناً زَفيفُهُ","كَما استَنَّ في الغابِ الحَريقُ المُشَعشِعُ",62,"ع",1,0],["دِجلَةُ الفَيضِ علمُ نورِى بِبَحرِ","قد أسلَناهُ للفَتى المُستَجيتدُ",63,"د",1,0],["دُجى ظَلام الغَي فلتجله","يا مُرشد الناس بِذات الفقار",64,"ر",1,0],["دجمُ العشقِ والغرامِ مقيمٌ","بينها في الأشواق ذو عمهان",65,"ن",1,0],["دجى بمنى مناخ الركب لبثاً","تخالف اربعاً مثل السهام",66,"م",1,0],["دجاجةٌ تَغْتَذي من","في جملةِ الدجاجِ",67,"ج",1,0],["دجاجَةٌ صفارءُ من شحمِها","حمراءُ كالورد من الوهج",68,"ج",1,1],["دجى ليل النوائب فاستضيئوا","بانوار الكواكب والبدور",69,"ر",1,0],["دُجى الكفر يجلى كلَّ يوم بسيفه","ويجلو ظلام النقع نور المهنّد",70,"د",1,0],["دجاهُ إذا ما لاحت الشمس مُبطلٌ","سناها كمنٍّ مُبطلٍ مَنَّ مُسعفِ",71,"ف",1,0],["دجت لَيلةٌ حَتّى تَجلى صَباحُها","بِغَيث هَمى مِن بَعد زَأر الرَواعد",72,"د",1,0],["دجت الهُمومُ عَلى الهمو","م فَوفِّها نبراسها",73,"س",3,0],["دجى علمي الورى كتابٍ وحكمةٍ","أنارهُ لا يغشى نهاره مظلمُ",74,"م",1,0],["دَجَا لَيلُهُم بِالشَّمسِ لاَ عَجَبٌ فَقَد","تَضُرُّ الشُّمُوسُ الزُّهرُ بِالأعيُنِ الرُّمدِ",75,"د",1,0],["دِجلة لا باللام والقازوزه","قاقُزَّة لم يأت بل قاقوزه",76,"ه",1,0],["دَجا اللَّيلُ والاَربابُ والنَّاسُ نُوَّمٌ","وَلكنَّ زَفساً نابِدٌ سِنَةَ الكَرَى",77,"ر",2,1],["دجاجة يوقظني ديكها","قبل طلوع الفجر بالصايح",78,"ح",1,0],["دجى رَهَجٍ أُذْنُ الجوادِ دليلُهُ","بها ودليل السيِّد فيها خياشمه",79,"م",2,0],["دَجَى نهارُ الروضِ في فجرِهِ","هلاّ سألتَ الزهرَ عن عمرِهِ",80,"ر",2,1],["دجت الليالي يا عراق وما لنا","إلّا ابتسام سناك فجرٌ يطلعُ",81,"ع",1,0],["دُجَاْنَةُ! قَدْ غَضِبْتِ بِدُوْنِ حَقٍّ","وَقَدْ خَلَتِ الْبِلاْدُ مِنَ الْخَلِيْلِ",82,"ل",1,1],["دجت ابثراها وعشت الافراح واعياد","ذكرى تعيش ابوسط جوفي وكياني",83,"ن",2,0],["دجوان مصطخب الرياح تنوح في","قلب الدجى بالزعزع القصّافِ",84,"ف",1,0],["دَجَت مِن دَيَاجِي الجَهْلِ بِالجَهلِ نَفسِهِ","وبَاطِنُهُ مِنْ جَهْلِهِ كالدُّجَى دَجِي",85,"ي",1,0],["دَجَى مِن دُجَى دُنياهُ قَلبٌ لَهَا دَنَى","وَدَاجِيهِ مِنْ دَاجِي المَدَارِكِ دَارِكُ",86,"ك",1,0],["دجا شعرها كالليل ارخى غصونه","وﻻ زال هذا الليل بالشعر حانيا",87,"ي",2,0],["دَجا شعرْها كالليلِ أرخى غُصونَهُ","وما زالَ هذا الليلُ بالشّعرِ حانيا",88,"ي",2,0],["دجلة الرقراق ما عاد زكيّا","لم تعد بغداد أرضا للسلام",89,"م",1,0],["دجل أفسد الحياة وكانت","كنبات ثماره الأخلاق",90,"ق",1,0],["دجلة العزّ في العراء حُسينٌ","استباحوا خريره الكربلائي",91,"ا",2,0],["دجلة السعد ياعروس البراري","بدلوا العرس حائطا للبكاء!!",91,"ا",2,0],["دجلة الخير منبع القلب يزوي","في عروقي يجفّ نهر الدماء",91,"ا",2,0],["دجلة النور نورس العشق يرنو","لسلامٍ مرّفلٍ بالهناء ِ",91,"ا",2,0],["دَجَّنْتِ في جسدي ذئابَ رغائبي","وأَحَلْتِ جنَّ متاهتي أُنْسِيّا",92,"ي",2,0],["دجا ليل آمالي وأبطأ صبحه","وللمنذرات السود فيه نعيب",93,"ب",1,0],["دجى بها اذا دجة نقيقها","بكيرة صحوبها نعيقها",94,"ق",3,0],["دُجَىً مُدْلَهِمٌّ تَحْتَهُ البَدْرُ طالِعٌ","عَلَى غُصْنِ بانٍ فَوْقَ دِعْصٍ مِنَ النَّقَا",95,"ق",2,0],["دجلة ليس الشر من طبعها","لكنها تبكي على الشرق",96,"ق",1,0],["دجالة بالمكر والكذب نصاب","على الردي تمشي لعوج الطلايب",97,"ب",1,0],["دجَّنوا حكامنا فرخاً ففرخاً","في دويلاتٍ تعاني النُّوبا",98,"ب",2,0],["دِجلايَ ؛ يَا نَهرَ الهَوَى غَرِقتْ","فِيكَ المُنَى - خَنقًا - وَ مَا أَهوى",99,"و",2,0],["دَجَلٌ يمور بسرعة المكوكِ","وقصيدةٌ ' لحستْ' نعالَ ملوكِ",100,"ك",1,1],["دجتْ ولكنْ أقشعتْ عنء أنفسٍ","سواكنِ وأعينٍ قرائرِ",101,"ر",1,0],["دَجَاجَة ٌ في سِمَنْ السّمَنْدِ","بنَيْلِهِ وفخرِهَا بالهِنْدِ",102,"د",1,1],["دُجى مقلتيكِ أضفى","على شِعْريَ العُذوبهْ",103,"ب",2,0]]}