{"poems":[[77,"يا ربة البيت الممنع جاره","https://www.aldiwan.net/poem36516.html","الكامل"],[51,"تأمل أبا عبد الإله فإنه","https://www.aldiwan.net/poem66003.html","الطويل"],[70,"ركد الرجاء فما يهزك مأرب","https://www.aldiwan.net/poem43107.html","الكامل"],[62,"لك الله هل عهد الشبيبة يرجع","https://www.aldiwan.net/poem52358.html","الطويل"],[45,"دجالنا أحول من شؤمه","https://www.aldiwan.net/poem63643.html","السريع"],[105,"طغت الدماء وفاضت الأرواح","https://www.aldiwan.net/poem43145.html","الكامل"],[46,"ألاح وقد رأى برقا مليحا","https://www.aldiwan.net/poem23637.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85394","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85555","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85483","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16654","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43839","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43637","الطويل"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/50177","الرجز"],[106,"ذكرى محمد ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=179428",""],[90,"جمال الدين الأفغاني","https://www.poetsgate.com/ViewPoem.aspx?id=179201",""],[90,"الأحاديث شجون","https://www.poetsgate.com/ViewPoem.aspx?id=179020",""]],"verses":[["دجَتِ الخُطوبُ فكُنْتَ نورَ ظَلامِها","خفِيَ الرّشادُ فكُنْتَ أنْتَ مَنارُهُ",0,"ر",2,0],["دجا ليلُ نحسٍ في سرارٍ وأطبقتْ","عليه السواري فهو أسود أطولُ",1,"ل",1,0],["دَجَتِ الحَقائِقُ حِقبَةً ثُمَّ اِنبَرى","فَتَبَلَّجَت وَاِنجابَ عَنها الغَيهَبُ",2,"ب",1,0],["دُجونٌ يُسَمَّينَ الخُيولَ وتحتَها","رِياحٌ يُلقَّبنَ القوائمَ أربعُ",3,"ع",1,0],["دَجّالُنا أَحوَلُ مِن شُؤمِهِ","وَالناسُ دَجّالُهُمُ أَعوَرُ",4,"ر",1,1],["دَجَتِ العُصورُ فَما يَبينُ لِأَهلِها","نورُ الحَياةِ وَما يَحينُ صَباحُ",5,"ح",1,0],["دُجًى تتشابَهُ الأشْباحُ فيه","فيُجْهَلُ جِنسُها حتى يَصيحا",6,"ح",2,0],["دجلة لا تخرج من حوزنا","وَنَحن أَحياء عَلى الأرض",7,"ض",1,1],["دجلة دجلة فلم تتغير","وكذاك الفرات عين الفرات",8,"ت",1,0],["دجلة إِن درى بنو دجلة أَن","يَستَفيدوا منها تَفيض نضارا",9,"ر",2,0],["دَجا فتَلَهّبَ المِرّيخُ فيه","وألْبَسَ جَمْرَةَ الشمسِ الرّمادا",10,"د",2,0],["دَجا نَهاري فَكَيفَ لَيلي","مُنذُ هَوى كَوكَبُ السُعودِ",11,"د",1,0],["دُجى اللَيل صُبحٌ فيك إِذ أَنت مطلعٌ","لِكُلِّ هِلالٍ أَطلَعتهُ سُعودُ",12,"د",1,0],["دَجاجةٌ في شَبَهِ السَّمَنْدِ","تَليدَةٌ وفخرُها بالهندِ",13,"د",1,0],["دجت القرونُ؛ فقام دينُك حارسًا","يحمي ذمار حضارة الأسلاف",14,"ف",1,0],["دَجَا قَسْراً وسادَ ، وكان شَهماً","صريحاً أنَّه بالرُّغمِ سادا",15,"د",2,0],["دجلةٌ والنيلُ والشامُ معاً","و\" الصَّفا \" تندُبُ شجواً و\" الحَجون \"",16,"ن",1,0]]}