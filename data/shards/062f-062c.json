{"poems":[[79,"يا ربة البيت الممنع جاره","https://www.aldiwan.net/poem36516.html","الكامل"],[53,"تأمل أبا عبد الإله فإنه","https://www.aldiwan.net/poem66003.html","الطويل"],[72,"ركد الرجاء فما يهزك مأرب","https://www.aldiwan.net/poem43107.html","الكامل"],[64,"لك الله هل عهد الشبيبة يرجع","https://www.aldiwan.net/poem52358.html","الطويل"],[47,"دجالنا أحول من شؤمه","https://www.aldiwan.net/poem63643.html","السريع"],[107,"طغت الدماء وفاضت الأرواح","https://www.aldiwan.net/poem43145.html","الكامل"],[48,"ألاح وقد رأى برقا مليحا","https://www.aldiwan.net/poem23637.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85394","السريع"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85555","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85483","الخفيف"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16654","الوافر"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43839","البسيط"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43637","الطويل"],[63,"","https://poetry.dctabudhabi.ae/diwan/poem/50177","الرجز"],[108,"ذكرى محمد ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=179428",""],[92,"جمال الدين الأفغاني","https://www.poetsgate.com/ViewPoem.aspx?id=179201",""],[92,"الأحاديث شجون","https://www.poetsgate.com/ViewPoem.aspx?id=179020",""],[135,"ثلاث ليال حين جاز ينير","https://www.aldiwan.net/poem54674.html","الطويل"],[153,"دموعي أبت إلا انسكابا لعلها","https://www.aldiwan.net/poem68569.html","الطويل"],[153,"ألا فاذكروا المختار تحظوا بخيره","https://www.aldiwan.net/poem68598.html","الطويل"],[172,"دعوه فخير الرأي أن لا يعنفا","https://www.aldiwan.net/poem1639.html",""],[189,"وقالوا ابنة الحصري مالت بودها","https://www.aldiwan.net/poem43345.html","الطويل"],[196,"أبا بشر فقدت لذيذ عيشي","https://www.aldiwan.net/poem13161.html","الوافر"],[202,"دجا الظلام فيا ليلى أما فينا","https://www.aldiwan.net/poem45159.html","البسيط"],[265,"أمير المؤمنين فدتك نفسي","https://www.aldiwan.net/poem68179.html","الوافر"],[278,"جناني عامر بهوى جناني","https://www.aldiwan.net/poem25501.html","الوافر"],[341,"دجاج أبي عثمان أبعد منظرا","https://www.aldiwan.net/poem68780.html","الطويل"],[352,"شربت من الحميا ما سقتني","https://www.aldiwan.net/poem15973.html","الوافر"],[369,"أما فوقها إلا نجود وأنهم","https://www.aldiwan.net/poem17330.html","الطويل"],[383,"تغيب در الزهر في صدف الأفق","https://www.aldiwan.net/poem48822.html","الطويل"],[409,"بدا البرق من نجد فحن إلى نجد","https://www.aldiwan.net/poem50190.html","الطويل"],[435,"أزهر جنان من جنان تنمقا","https://www.aldiwan.net/poem12684.html","الطويل"],[442,"أهنيكما ما يهنئ الدين منكما","https://www.aldiwan.net/poem34766.html","الطويل"],[460,"لعلهم لو وقفوا","https://www.aldiwan.net/poem56108.html","مجزوء الرجز"],[460,"أفاق بها من طول سكرته الدهر","https://www.aldiwan.net/poem56161.html","الطويل"],[460,"تمد بالآذان والمناخر","https://www.aldiwan.net/poem56185.html","الرجز"],[460,"لمن صاغيات في الحبل طلائح","https://www.aldiwan.net/poem56246.html","الطويل"],[463,"أقول لقلب هاجه لاعج الهوى","https://www.aldiwan.net/poem15120.html","الطويل"],[463,"عفا ضارج من آل ليلى فعاقل","https://www.aldiwan.net/poem15298.html","الطويل"],[463,"دجا ليل همي واكفهرت بشاشتي","https://www.aldiwan.net/poem15384.html","الطويل"],[463,"الام يراك المجد في زي شاعر","https://www.aldiwan.net/poem15927.html","الطويل"],[463,"تخشى الصوارم بأسه","https://www.aldiwan.net/poem16138.html","مجزوء الكامل"],[466,"وباغ كفانا كل باغ من الأسى","https://www.aldiwan.net/poem3582.html","عموديه"],[495,"ويوم أغص أتساع الفضاء","https://www.aldiwan.net/poem67343.html","المتقارب"],[561,"دجى غيهب التفريق قد زال واشمطا","https://www.aldiwan.net/poem69352.html","الطويل"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/21461","الطويل"]],"verses":[["دجَتِ الخُطوبُ فكُنْتَ نورَ ظَلامِها","خفِيَ الرّشادُ فكُنْتَ أنْتَ مَنارُهُ",0,"ر",2,0],["دجا ليلُ نحسٍ في سرارٍ وأطبقتْ","عليه السواري فهو أسود أطولُ",1,"ل",1,0],["دَجَتِ الحَقائِقُ حِقبَةً ثُمَّ اِنبَرى","فَتَبَلَّجَت وَاِنجابَ عَنها الغَيهَبُ",2,"ب",1,0],["دُجونٌ يُسَمَّينَ الخُيولَ وتحتَها","رِياحٌ يُلقَّبنَ القوائمَ أربعُ",3,"ع",1,0],["دَجّالُنا أَحوَلُ مِن شُؤمِهِ","وَالناسُ دَجّالُهُمُ أَعوَرُ",4,"ر",1,1],["دَجَتِ العُصورُ فَما يَبينُ لِأَهلِها","نورُ الحَياةِ وَما يَحينُ صَباحُ",5,"ح",1,0],["دُجًى تتشابَهُ الأشْباحُ فيه","فيُجْهَلُ جِنسُها حتى يَصيحا",6,"ح",2,0],["دجلة لا تخرج من حوزنا","وَنَحن أَحياء عَلى الأرض",7,"ض",1,1],["دجلة دجلة فلم تتغير","وكذاك الفرات عين الفرات",8,"ت",1,0],["دجلة إِن درى بنو دجلة أَن","يَستَفيدوا منها تَفيض نضارا",9,"ر",2,0],["دَجا فتَلَهّبَ المِرّيخُ فيه","وألْبَسَ جَمْرَةَ الشمسِ الرّمادا",10,"د",2,0],["دَجا نَهاري فَكَيفَ لَيلي","مُنذُ هَوى كَوكَبُ السُعودِ",11,"د",1,0],["دُجى اللَيل صُبحٌ فيك إِذ أَنت مطلعٌ","لِكُلِّ هِلالٍ أَطلَعتهُ سُعودُ",12,"د",1,0],["دَجاجةٌ في شَبَهِ السَّمَنْدِ","تَليدَةٌ وفخرُها بالهندِ",13,"د",1,0],["دجت القرونُ؛ فقام دينُك حارسًا","يحمي ذمار حضارة الأسلاف",14,"ف",1,0],["دَجَا قَسْراً وسادَ ، وكان شَهماً","صريحاً أنَّه بالرُّغمِ سادا",15,"د",2,0],["دجلةٌ والنيلُ والشامُ معاً","و\" الصَّفا \" تندُبُ شجواً و\" الحَجون \"",16,"ن",1,0],["دُ جَنبَرُ قَد لاَح الذِّرَاعَانُ تِسعَهُ","وفي أثنَينِ مَع عِشرِينَ نَثرَةُ تَظهَرُ",17,"ر",1,0],["دُجايَ إذا واصَلتَ يَومٌ مُؤبَّدٌ","ويَومِي إذَا أبعَدتَ لَيلٌ مُسَرمَدُ",18,"د",1,0],["دُجى الشِرك جَلّاهُ عَنِ الدينِ وَالدُنا","هِلالٌ بِلألاءِ الهُدى يَتَوَقَّدُ",19,"د",1,0],["دُجَيلِيَّةٌ لَو حَطَّ غَيلانُ رَحلَهُ","بِها ساعَةً أَنسَتهُ حُزوى وَمُشرِفا",20,"ف",2,0],["دجا بك في بحر الخطوب ملالة","وصار لها عبدا يقول ويفعل",21,"ل",1,0],["دَجت أَيّامُنا مُذ غِبتَ عَنّا","وَكانَت مِنكَ مُشرِقَةً مُضِيّه",22,"ض",3,0],["دجا الظلامُ فيا لَيلَى أَمَا فينا","روح ام الموت مثل الرزق جافينا",23,"ن",2,1],["دجاجاتٌ يطيف بهن ديكٌ","يناجي بالصياح إذا يناجي",24,"ج",2,0],["دَجَا ما بَيْنَنا فَمَتَى وحَتَّى","يُنِيرُ وفِي إِجَابَتِها تَوانِ",25,"ن",1,0],["دَجاجُ أَبي عُثمانَ أَبعَدُ مَنظَراً","وَأَطوَلُ أَعماراً مِنَ الشَمسِ وَالقَمَر",26,"ر",1,1],["دَجاجاتٌ دَجىً جاءَت إِلَينا","بِبَيضِ البيضِ في حَضَنٍ بِحُضنِ",27,"ن",1,0],["دَجا لَيلَها إِلّا لِتَختِلَ عَقرَبٌ","أَضا صُبحُها إِلّا لِيَلسِبَ أَرقَمُ",28,"م",1,0],["دَجا لَيل هَمي فَأَجله بِابتِسامة","كَما يَكشف اللَيل البَهيم سَنا البَرق",29,"ق",1,0],["دُجوجيَّة الفَرعين شَمسِيَّة الرؤا","كَثيبية الأَردافِ خوطِيَّة القَدِّ",30,"د",1,0],["دجىً عارضَ الأقلامَ فيه وأومضت","بروقُ المَعاني بينَهُ فتألّقا",31,"ق",2,0],["دُجىً مثلَ جِلْبابِ السماءِ اسْتَمَرَّ بِي","فَقَنَّعَ فَوْدَيَّ المشيبَ وعَمَّما",32,"م",2,0],["دجلةُ والفرات أو","شالٌ لها ونُطَفُ",33,"ف",1,0],["دجَتْ ما دجت ثم انجلت وسيوفُكم","كواكبُ فيها أو وجوهكم الغُرُّ",34,"ر",1,0],["دَجَتْ ولكن أقشعتْ عن أنفُسٍ","سواكنٍ وأعينٍ قرائرِ",35,"ر",1,0],["دجا ليلُها وهي السهام تقامُصاً","فلم ينصرم إلا وهنَّ طَرائحُ",36,"ح",1,0],["دجا عنده ليلٌ من النَّقْع حالكٌ","فسيحُ النواحي والنجوم عوامله",37,"ل",2,0],["دجا صُبحهم من حظهم فرأوا به","تجاذُبهم آمالُهم وتناقُل",38,"ل",1,0],["دجا ليلُ همي واكفهرت بشاشتي","ورْحتُ بحالي واجماً أيَّ واجمِ",39,"م",1,1],["دَجا ليلهُ والصُّبْحُ في عُنْفوانه","بكل مُثارٍ بينَ خُفٍّ وحافرِ",40,"ر",1,0],["دَجْنٌ صَدوقُ الشَّيْمِ سَّحَّاحٌ","إذا خَوَتِ النُّجومُ",41,"م",1,0],["دجى نقعه يسودُّ منهُ سنا والضحى","وتخضرُّ من نعماه حتى الجلامد",42,"د",1,0],["دُجى أَنتَ بَدرٌ بِهِ وَالنُجو","مُ زَرقُكَ وَالظُلمَةُ القَسطَلُ",43,"ل",1,0],["دُجَى غَيْهب التفرِيقِ قد زال واشمطَّا","وَاقبْلَ صُبْحُ الجمع منْ بعد ما شَطَّا",44,"ط",2,1],["دَجا اللَّيلُ واستَنَّ استناناً زَفيفُهُ","كَما استَنَّ في الغابِ الحَريقُ المُشَعشِعُ",45,"ع",1,0]]}