{"poems":[[55,"أما آن للدمع أن يستجم","https://www.aldiwan.net/poem29769.html","المتقارب"],[91,"انظر إلى الكواكب","https://www.aldiwan.net/poem44667.html","مجزوء الرجز"],[87,"اختلاف النهار والليل ينسي","https://www.aldiwan.net/poem63713.html","الخفيف"],[47,"إعجب من الغيم كيف ارفض فانقشعا","https://www.aldiwan.net/poem65130.html","البسيط"],[50,"طفلة خود رداح","https://www.aldiwan.net/poem66180.html","مجزوء الرمل"],[119,"يا بعينيك طر الى بغداد","https://www.aldiwan.net/poem41168.html","عموديه"],[287,"عد عن العين واليعافير","https://www.aldiwan.net/poem32764.html","المنسرح"],[371,"ماضيات على الدمام دوامي","https://www.aldiwan.net/poem17703.html","الخفيف"],[463,"إن كنت ممن يلج الوادي فسل","https://www.aldiwan.net/poem55986.html","الرجز"],[469,"ته على النجم والمحل الأثيرِ","https://www.aldiwan.net/poem3281.html","عموديه"],[484,"زان طرفها الحور","https://www.aldiwan.net/poem36921.html","المقتضب"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120048","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120000","المنسرح"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133770","الخفيف"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67233","الرمل"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99080","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204503",""],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74304","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132763","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132730","السريع"],[3836,"","https://poetry.dctabudhabi.ae/diwan/poem/99214","الخفيف"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44687","الخفيف"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111064","الرمل"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62052","الخفيف"],[4816,"العيون","https://www.poetsgate.com/ViewPoem.aspx?id=8503",""],[4888,"غروب في ظلِّ الغُربةِ","https://www.poetsgate.com/ViewPoem.aspx?id=207740",""],[5111,"سَوَسَنُ","https://www.poetsgate.com/ViewPoem.aspx?id=212148",""],[5111,"مَرْحَى","https://www.poetsgate.com/ViewPoem.aspx?id=212337",""],[5111,"سعْدى","https://www.poetsgate.com/ViewPoem.aspx?id=212382",""],[5433,"جابك الله","https://www.poetsgate.com/ViewPoem.aspx?id=36260",""],[5497,"علل النفس بما يسعدها","https://www.poetsgate.com/ViewPoem.aspx?id=206747",""],[5691,"جارة القمر","https://www.poetsgate.com/ViewPoem.aspx?id=205881",""],[6056,"ياحيلة الله كيف ؟","https://www.poetsgate.com/ViewPoem.aspx?id=130568",""],[6148,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=201828",""],[6323,"لغة الشعور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82174&r=&rc=5",""],[6345,"أنشودة للناي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78652&r=&rc=23",""]],"verses":[["تَنَثَّرَ فيكَ سَحابُ الحَيا","فَطَوَّقَ جيدَكَ لَمّا اِنتَظَم",0,"م",1,0],["تنثر من ضيائها","تبراً على الجوانب",1,"ب",1,0],["تَنثُرُ الماءَ في الحِياضِ جُماناً","يَتَنَزّى عَلى تَرائِبَ مُلسِ",2,"س",1,0],["تَنثالُ أَنجِيَةُ الوادي إِلى خَبَرٍ","بَنو سُوَيدٍ عَلَيهِ عاكِفونَ مَعا",3,"ع",2,0],["تَنثُرُ الدُرَّ إِذا غَن","نَت عَلَينا شَفَتاها",4,"ا",3,0],["تنثر الدمع مقلتي كاللئالي","والملح الجاري كصوب الغوادي",5,"د",2,0],["تَنثُرُ دُراً مِن اللُجَينِ علا","عَلى بِساطٍ مِن الدَّنانيرِ",6,"ر",1,0],["تَنثُرُ الهامَ كَالحُروفِ فَما أَش","بَهَ هَذي السُيوفَ بِالأَقلامِ",7,"م",1,0],["تنثو العلاءَ سيِّداً فسيّداً","عنهم وتنعى بطَلاً بعدَ بطَلْ",8,"ل",1,0],["تنثرُ الهامَ فيك أو تنظم الحم","د فخل في تنظيمها والنثير",9,"ر",1,0],["تنثني به غصنا","حين يجتني الثمر",10,"ر",1,0],["تنثنى تثني الغصن الأهيف","راق العيون بالإيراقِ",11,"ق",1,0],["تنثر در الغناء مبدعة","في مجلس بالسرور منتظمِ",12,"م",1,0],["تنثرين الاباء والحلم في الشط","آن فوق السهول فوق الجبال",13,"ل",1,0],["تنثرُ الدمعَ على الخَدّ كما","ينثرُ الطلُّ على الوَرد دُرر",14,"ر",1,0],["تنثني منه إلى ذي","كرم رحب الجناب",15,"ب",1,0],["تنثني والفراخ تتبعها","وبأمر الفراخ مرتبكه",16,"ك",2,0],["تَنثَني للحداة حثوا وَجدوا","ثُم سيروا بِنا عَلى الهامات",17,"ت",1,0],["تنثني الريح مذ تجاريه حسرى","وهو زيافة المهب أمون",18,"ن",1,0],["تنثر درّ الدمع شوقاً إلى","در بهاتيك الثنايا انتظم",19,"م",1,0],["تنثني قامةً وتَجْرَحُ طَرْفاً","فهْيَ للسَّمْهَرِيَّةِ السَّمْراءُ",20,"ا",2,0],["تَنثَني بِالقَوامِ تِيهاً وَعُجباً","مِن جَمالٍ لَهُ النُفوسُ فِداءُ",21,"ا",2,0],["تنثني حتى خشينا قصفها","قومتها قدرة ممن براها",22,"ا",3,0],["تنثر الطل لؤلؤاً كأياد","نشرتها يد الأمير الوهوب",23,"ب",1,0],["تنثر النظرة تقل ورد ينف","او شذى معمول عود وانعتق",24,"ق",1,0],["تَنْثالُ ذِكراهُ الجميلةُ كالنَّدى","لا تَنْمحي من دَوْرةِ الأيّامِ",25,"م",1,0],["تَنْثُرُالألوَانَ سِحْرًا","قَوْسُ قُزْحٍ قَدْ سَبَانِيْ",26,"ن",2,0],["تَنْثُر اللقْيَا وُرُودًا","أيَّهَا الزَّائِرُ مَهْلاَ",27,"ل",2,0],["تنثرُ الأفكارَ فِيْ بَحْرِ المنَى","فيتوهُ الصّمت ُ فِيهَا فيْ تَرنِّي",28,"ن",2,0],["تنثني كنك النايف النبنوب","وانثني وأنشد الصبح وش جابك ؟",29,"ك",1,0],["‏تَنْثُرُ النَّجْمَاتِ فِي آفَاقِهَا","‏ وَسَوَادُ اللَّيْلِ مشتَدُّ الحَلَكْ",30,"ك",1,0],["تَنْثالُ أنْخاباً مُعَتَّقَةً","منْ شُهْدِ دالِيَةٍ لمُعْتَصِرِ",31,"ر",1,0],["تنثرغزير الدمع من غير مقياس","وتعبت مع قلب الخطأ من شقاها",32,"ا",3,0],["تنثالُ من غيم الكلام شموسه","وعلى ضفاف الأبجدية يَخطرُ",33,"ر",1,0],["تنثال في الإحساس مغدقةً ‍","وتثور في أرجائه القصوى",34,"و",2,0],["تنثال كهاطل ِ هائمة ٍ","تاهت ما بين الغيمات ِ",35,"ت",1,0]]}