{"poems":[[95,"ترى تعرف الشمس من ذا تشبه","https://www.aldiwan.net/poem11385.html","المتقارب"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16706","الوافر"],[124,"يا حسن واحسرتا على غرر","https://www.aldiwan.net/poem49263.html","المنسرح"],[170,"يذكرني الحمى عهد الوصال","https://www.aldiwan.net/poem46897.html","الوافر"],[216,"فمن مقلتي روحي جرت عبراتها","https://www.aldiwan.net/poem37908.html","الطويل"],[240,"قفوا تعجبوا من سوء حالي ومن ضري","https://www.aldiwan.net/poem31944.html","الطويل"],[287,"ترى تسمح الأيام لي أن أراكم","https://www.aldiwan.net/poem32677.html","الطويل"],[309,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[327,"إن الوليد أمير المؤمنين له","https://www.aldiwan.net/poem56352.html","البسيط"],[350,"أمولى بني تيم ألست مؤديا","https://www.aldiwan.net/poem4476.html","الطويل"],[409,"الواردات علينا كلها منن","https://www.aldiwan.net/poem33403.html","البسيط"],[520,"ألا قل لعز الدين لا زال جده","https://www.aldiwan.net/poem12206.html","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64194","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59666","الطويل"],[1132,"","https://poetry.dctabudhabi.ae/diwan/poem/121115","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108993","الوافر"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108985","البسيط"],[1786,"","https://poetry.dctabudhabi.ae/diwan/poem/121955","الطويل"],[1911,"","https://poetry.dctabudhabi.ae/diwan/poem/147646","الطويل"],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/198858","الطويل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123140","البسيط"],[2224,"","https://poetry.dctabudhabi.ae/diwan/poem/126381","الطويل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100908","البسيط"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130835",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91388","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123517","البسيط"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45976","الطويل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45117","الطويل"],[4560,"","https://poetry.dctabudhabi.ae/diwan/poem/118194","البسيط"],[5436,"حديثُ الموت والنصر (تركي عبد الغني )","https://www.poetsgate.com/ViewPoem.aspx?id=33447",""],[5596,"ابوسرور فقيد الفقه والأدب","https://www.poetsgate.com/ViewPoem.aspx?id=206773",""],[5689,"كم بذا بعاصمة الأنوار من لهب","https://www.poetsgate.com/ViewPoem.aspx?id=143425",""]],"verses":[["تُرَى تَعْرِفُ الشَّمْسُ مَنْ ذَا تُشَبِّ","هُ وَالظِّل أيّ فَتىً يَرْسُمُ",0,"م",1,1],["تَرى تَنّومَها وتَرى ثُغامي","فتَهْزَأُ مِن مُنَهْبَلَةٍ مُسِنّه",1,"ن",2,0],["ترى تريه الأحلام عاشقه","مزدهف اللب بين الصور",2,"ر",1,0],["تُرى تلكَ العهود تعودُ يوماً","وحال الوصلِ يلقحُ عن حِيالِ",3,"ل",1,0],["ترى تحتها الآسادُ تزأر حُسراً","وسُمْرُ القَنا ملتفةٌ أجماتُها",4,"ت",3,0],["تَرى تَسمَحُ الأَيّامُ مِنهُم بِعَودَةٍ","فَأُدرِكَ أَوطاري وَأوفي بِكُم نُذري",5,"ر",2,0],["تُرى تَسمَحُ الأَيّامُ لي أَن أَراكُمُ","وَأَشكو غَرامي مُنذُ شَطَّت نواكُمُ",6,"م",1,1],["ترى تجمع الأيام بيني وبينكم","وأحظى بكم من قبل تأتي منيتي",7,"ي",1,0],["تَرى تَهاويلَهُ مِن نَحوِ قِبلَتِنا","يَلوحُ فيهِ مِن الأَلوانِ تَفويفُ",8,"ف",1,0],["تَرى تَحتَها عَسَّ النُظارِ مُنَيِّفاً","سَما فَوقَهُ مِن بارِدِ الغَزرِ طامِحُ",9,"ح",1,0],["ترى تفكرنا في غير منفعة","إلا لتحصيل ما تحصيله فتن",10,"ن",1,0],["ترى تسعد الأيام بالجمع بيننا","وهل لي إلى برد اللقاء سبيل",11,"ل",1,0],["ترى ترباً شتى فتربٌ مصندلٌ","ينافسه في الحسن تُرْبٌ مزعفر",12,"ر",1,0],["ترى تسمح الأيام يا ربع بالمنى","ويطلع بدر طال منه أفول",13,"ل",1,0],["تُرى تسمح الدنيا ويسعدني القدر","فانظر من أهوى ويطربُ من حضر",14,"ر",1,1],["ترى تلك المحاسن يا حبيبي","كما كانت عليك اليوم دامت",15,"ت",1,0],["ترى ترى دام ذاك الحسن يكنفها","دوام قوَّتها في حفظ تقواها",16,"ا",3,0],["تُرَى تَجمعُ الأَيَّامُ بَيني وبَينَكُمْ","وأَشفِي فُؤَادِي إنْ ظَفَرْتُ بِكُمْ عَتْبا",17,"ب",2,0],["ترى ترجع الأيام تجمع بيننا","ويرجع وجه الدهر وهو صبيح",18,"ح",1,0],["ترى تجمع الأيام شملي بطيبة","لأسكب في تلك الأماكن عبرتي",19,"ت",2,0],["تُرى تَرى مقلتي أنوار حجرته","كيما أنادي فمن ناداه يعتصم",20,"م",1,0],["تُرى تسمح الأيام يوماً بزورة","فينعم مهجور ويُنعم هاجرُ",21,"ر",1,0],["تُرَى تضمَّنتَ لى فى النائلين مُنًى","فأرتجى نيلَهَا أم أنتَ معتذِر",22,"ر",1,0],["تُرى تفكر في أمر المصير وما","قضى المهيمن من باق ومن عدم",23,"م",1,0],["تُرى تُقرّبُنا بَعدَ البعادِ يدٌ","للدهر أَو لا فيهدي الطَيف لُقياكِ",24,"ك",1,0],["ترى ترى بعد بعد مشهدا شهدت","عينى ويطفى لقاك لوعة الشاكى",25,"ك",2,0],["تُرى تَسمَحُ الأَيّامُ مِن بَعدِ ذا الجَفا","وَيُصبِحُ شَملُ الوَصلِ جَمعاً بَلا كَسرِ",26,"ر",1,0],["تُرى تَسمَحُ الأَيّامُ مِنها بِزَورَةٍ","فَنَحظى بِها ما بَينَ نَهدٍ وَعاتِقِ",27,"ق",1,0],["ترى تصرفهم في الكل مطردا","يجرونه باقتدار في مجاريه",28,"ي",2,0],["تَرى تَحْتَ النِّعالِ الحُرَّ مِنْهُمْ","يَخِرُّ كَما لأَبْعُرِها الأيانِقْ",29,"ق",1,0],["ترى تبعثر أفكاري وحيرتها","بين القوافي ولم تنبس ببنت فم",30,"م",1,0],["ترى تسالمني الأيام يا أملي","حتى أراك كما أهواك عن كثب؟",31,"ب",1,0]]}