{"poems":[[53,"سيدي أنت ليس كلل","https://www.aldiwan.net/poem29953.html","مجزوء الخفيف"],[9,"بانت سعاد وأمسى حبلها انقطعا","https://www.aldiwan.net/poem21951.html","البسيط"],[4,"لله نافلة الأجل الأفضل","https://www.aldiwan.net/poem21186.html","الكامل"],[51,"أأبي يوسف دعوة المستصغر","https://www.aldiwan.net/poem63998.html","الكامل"],[51,"لا ترج يا بيهقي إفراشي","https://www.aldiwan.net/poem64925.html","المنسرح"],[51,"أسوغ لخلاني مساغ شرابهم","https://www.aldiwan.net/poem64944.html","الطويل"],[51,"أيها الأعور لم جشمتني","https://www.aldiwan.net/poem65790.html","الطويل"],[51,"يا خالد ابن الخالدات","https://www.aldiwan.net/poem65801.html","مجزوء الكامل"],[51,"حي المعاهد والمنازل","https://www.aldiwan.net/poem65977.html","مجزوء الكامل"],[51,"أسألت رسم الدارِ أم لم تسأل","https://www.aldiwan.net/poem65978.html","الكامل"],[70,"أحبابنا حاشاكم","https://www.aldiwan.net/poem42787.html","مجزوء الرجز"],[61,"يريك قوامها الغصن الرطيب","https://www.aldiwan.net/poem51809.html","الوافر"],[66,"لعل ليالي الربوتين تعود","https://www.aldiwan.net/poem41357.html","الطويل"],[48,"دع الأمطار تعتور الديارا","https://www.aldiwan.net/poem66573.html","الوافر"],[4,"لِلّهِ نافِلَة ُ الأجَلِّ الأفْضَلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10937&r=&rc=32",""],[116,"أغث يا أحمد البدوي وأدرك","https://www.aldiwan.net/poem41747.html","الوافر"],[129,"مهما جرى حين مل الوصل مت هوى","https://www.aldiwan.net/poem50590.html","البسيط"],[136,"بظلك كل شخص يستقيل","https://www.aldiwan.net/poem49110.html","الوافر"],[144,"علي لها أن أحفظ العهد والودا","https://www.aldiwan.net/poem11743.html","الطويل"],[144,"تخلف عنه الصبر فيمن تخلفا","https://www.aldiwan.net/poem11783.html","الطويل"],[144,"أما وسيفك في النفوس محكم","https://www.aldiwan.net/poem11810.html","الكامل"],[211,"آيات حسنك قد أبدت لنا عجبا","https://www.aldiwan.net/poem13309.html","البسيط"],[238,"يا هذه الزيتونه","https://www.aldiwan.net/poem19284.html","الرجز"],[260,"الشدة عنوان الفرج","https://www.aldiwan.net/poem35545.html","المتدارك"],[260,"قم نحو حماه وانصرف","https://www.aldiwan.net/poem35942.html","المتدارك"],[271,"أفي دار قومي يسكن الغرباء","https://www.aldiwan.net/poem35648.html","الطويل"],[282,"لم أكتحل إثمداً ولكن","https://www.aldiwan.net/poem1394.html",""],[298,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[365,"هم منعوا مني الخيال المسلما","https://www.aldiwan.net/poem60668.html","الطويل"],[365,"خفض عليك وإن أطلت تأملا","https://www.aldiwan.net/poem60805.html","الكامل"],[365,"رأينا عجيبا والزمان عجيب","https://www.aldiwan.net/poem61001.html","الطويل"],[378,"أجد يا راهبا سعيا","https://www.aldiwan.net/poem59169.html","مجزوء الوافر"],[433,"ضرب الناس في العلا الأمثالا","https://www.aldiwan.net/poem12373.html","الخفيف"],[539,"حبيت بظبي يصول بحسن","https://www.aldiwan.net/poem47609.html","عموديه"],[559,"أعط طرفا له وللكون طرفا","https://www.aldiwan.net/poem34343.html","الخفيف"],[568,"وطيب أهدى لنا طيبا","https://www.aldiwan.net/poem69460.html","السريع"]],"verses":[["بِظَلامِ الغُروبِ أَو","بِضِياءِ المَشارِقِ",0,"ق",1,0],["بِظُبىً تَخلُطُ الجُزو","رَ بِضَربِ المَفارِقِ",0,"ق",1,0],["بِظُلمِهِم بِنِطاعِ المَلكَ ضاحِيَةً","فَقَد حَسَوا بَعدُ مِن أَنفاسِهِم جُرَعا",1,"ع",2,0],["بِظُلوفِها وَرَقُ البَشامِ وَدونَها","صَعبٌ تَزِلُّ سَراتُهُ بِالأَجدَلِ",2,"ل",1,0],["بظراء عُنْبلها كعظم ذِراعها","بخراء ثم أتت بأعمى أبخرِ",3,"ر",1,0],["بظراءُ يلقى الزناة عُنْبَلُها","بمخلبٍ للأيور خَدّاش",4,"ش",1,0],["بظنٍّ كرأي العين لا متقسَّمٍ","ولا حين ترفضُّ الظنونُ بمرفضّ",5,"ض",1,0],["بظلامٍ تُسلم الكفَّ له","أبدَ الدهرِ إلى قائدتك",6,"ك",1,0],["بظلامةِ الشوكيّ نا","لك من عِقابي ما يَهُضُّك",7,"ك",1,0],["بظراء تُمسخُ لامُها","راءً إذا رأتِ الفياشِلْ",8,"ل",1,0],["بظراءُ لو نطحتْ بمُقدَمِ بظرها","ثهلانَ حلحله ولم يتحلحلِ",9,"ل",1,0],["بِظاهِرٍ مُزَوَّقِ","وَباطِنٍ مُمَزَّقِ",10,"ق",1,0],["بظبيٍ في الخيامِ له مُرادٌ","وبدرٍ في الخدورِ له مَغيبُ",11,"ب",1,0],["بِظَبيٍ مِنَ الأَتراكِ في رَوضِ خَدِّهِ","غَديرُ مِياهِ الحُسنِ فيهِ رَكودُ",12,"د",1,0],["بظبي كالهلال من النصارى","محاسنهُ تزهّدُ في العذارى",13,"ر",2,0],["بظُلُوفِها وَرَقُ البَشَامِ ودُونَها","صَعْبٌ تَزِلُّ سَرَاتُهُ بلأجدَلِ",14,"ل",1,0],["بظلك لذت لوذة مستجير","لأنك أنت حصن المستجير",15,"ر",1,0],["بظاهِرى ظاهرٌ فيه لهيبُ هوًى","سرَى فشَى كادَ قلبى أن يذوب أسَى",16,"س",2,0],["بظلك كل شخص يستقيلُ","ومن شطط الحوادث يستقيلُ",17,"ل",1,1],["بِظِلِّ كَريمِ النَجرِ وَاليَدِ لَم تَلِد","لَهُ مامَةٌ مِثلاً وَلا نَجَلَت سُعدا",18,"د",2,0],["بِظِلِّكَ يا عِزَّ المُلوكِ اِبنَ تاجِها","وَفى لي زَمانٌ قَبلَ قُربِكَ ما وَفا",19,"ف",2,0],["بِظُبىً إِذا خَرِسَ الكُماةُ بِمَوقِفٍ","فَلَها كَلامٌ في الجَماجِمِ يُفهَمُ",20,"م",1,0],["بظلها قد أمدتنا ونائلها","يوم الندا فحمدنا الروض والسحبا",21,"ب",2,0],["بِظِلِّكِ الذِي هَفَتْ","أَفْنَانُهُ الْمَوْضُونَهْ",22,"ن",2,0],["بظلام البعد تراه فُجِي","كم لي بالقرب لديك أملْ",23,"ل",1,0],["بظهورٍ لاح لنا بادٍ","ولشدّته قد كان خفي",24,"ف",2,0],["بظلّهما قد صارت الأرضُ جنّةً","لها العدلُ خَصبٌ والإخاءُ نماء",25,"ا",2,0],["بظلمة الظلمِ يوم أعلوا","رأسي حسينٍ على الرديني",26,"ن",2,0],["بِظاهرٍ مُمَوَّهِ","وَباطنٍ مُشوَّهِ",27,"ه",1,0],["بظلِّ عزيزِ الدِّينِ قد عَزَّ أهلُه","فهمْ في سماء العزِّ يَحكونَ أَنجُما",28,"م",2,0],["بظُبىً يَمانيَةِ النِّجارِ وفِتْيَةٍ","بيضٍ كذاكَ يُناسبونَ الأنْصُلا",29,"ل",2,0],["بظاهرِ قَرميسينَ والرَّكبُ مُحدقٌ","حَوالَيْهِ فيهم جَيئةٌ وذهُوب",30,"ب",1,0],["بظنك أريَهُ شَرْياً","وتحسب شريه أريا",31,"ي",2,0],["بظُباً تنكِرُ الكُلولَ ولا يع","رفُ أَيضاً مَنْ يَنْتَضِيها الكلالا",32,"ل",2,0],["بِظَبيٍ نَفورٍ ولَكن يَرى","شَقَائي شِفَائي بذاكَ بَراني",33,"ن",2,0],["بظهور في كل شيء مراد","للإله الذي تحققت كشفا",34,"ف",2,0],["بِظَاهِرٍ أَخْشَنَ مِنْ قُنْفُذٍ","وَبَاطِنٍ أَلْيَنَ مِنْ زُبْدِ",35,"د",1,0]]}