{"poems":[[55,"سيدي أنت ليس كلل","https://www.aldiwan.net/poem29953.html","مجزوء الخفيف"],[9,"بانت سعاد وأمسى حبلها انقطعا","https://www.aldiwan.net/poem21951.html","البسيط"],[4,"لله نافلة الأجل الأفضل","https://www.aldiwan.net/poem21186.html","الكامل"],[53,"أأبي يوسف دعوة المستصغر","https://www.aldiwan.net/poem63998.html","الكامل"],[53,"لا ترج يا بيهقي إفراشي","https://www.aldiwan.net/poem64925.html","المنسرح"],[53,"أسوغ لخلاني مساغ شرابهم","https://www.aldiwan.net/poem64944.html","الطويل"],[53,"أيها الأعور لم جشمتني","https://www.aldiwan.net/poem65790.html","الطويل"],[53,"يا خالد ابن الخالدات","https://www.aldiwan.net/poem65801.html","مجزوء الكامل"],[53,"حي المعاهد والمنازل","https://www.aldiwan.net/poem65977.html","مجزوء الكامل"],[53,"أسألت رسم الدارِ أم لم تسأل","https://www.aldiwan.net/poem65978.html","الكامل"],[72,"أحبابنا حاشاكم","https://www.aldiwan.net/poem42787.html","مجزوء الرجز"],[63,"يريك قوامها الغصن الرطيب","https://www.aldiwan.net/poem51809.html","الوافر"],[68,"لعل ليالي الربوتين تعود","https://www.aldiwan.net/poem41357.html","الطويل"],[50,"دع الأمطار تعتور الديارا","https://www.aldiwan.net/poem66573.html","الوافر"],[4,"لِلّهِ نافِلَة ُ الأجَلِّ الأفْضَلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10937&r=&rc=32",""],[119,"أغث يا أحمد البدوي وأدرك","https://www.aldiwan.net/poem41747.html","الوافر"],[132,"مهما جرى حين مل الوصل مت هوى","https://www.aldiwan.net/poem50590.html","البسيط"],[139,"بظلك كل شخص يستقيل","https://www.aldiwan.net/poem49110.html","الوافر"],[147,"علي لها أن أحفظ العهد والودا","https://www.aldiwan.net/poem11743.html","الطويل"],[147,"تخلف عنه الصبر فيمن تخلفا","https://www.aldiwan.net/poem11783.html","الطويل"],[147,"أما وسيفك في النفوس محكم","https://www.aldiwan.net/poem11810.html","الكامل"],[214,"آيات حسنك قد أبدت لنا عجبا","https://www.aldiwan.net/poem13309.html","البسيط"],[242,"يا هذه الزيتونه","https://www.aldiwan.net/poem19284.html","الرجز"],[264,"الشدة عنوان الفرج","https://www.aldiwan.net/poem35545.html","المتدارك"],[264,"قم نحو حماه وانصرف","https://www.aldiwan.net/poem35942.html","المتدارك"],[275,"أفي دار قومي يسكن الغرباء","https://www.aldiwan.net/poem35648.html","الطويل"],[286,"لم أكتحل إثمداً ولكن","https://www.aldiwan.net/poem1394.html",""],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[369,"هم منعوا مني الخيال المسلما","https://www.aldiwan.net/poem60668.html","الطويل"],[369,"خفض عليك وإن أطلت تأملا","https://www.aldiwan.net/poem60805.html","الكامل"],[369,"رأينا عجيبا والزمان عجيب","https://www.aldiwan.net/poem61001.html","الطويل"],[382,"أجد يا راهبا سعيا","https://www.aldiwan.net/poem59169.html","مجزوء الوافر"],[438,"ضرب الناس في العلا الأمثالا","https://www.aldiwan.net/poem12373.html","الخفيف"],[543,"حبيت بظبي يصول بحسن","https://www.aldiwan.net/poem47609.html","عموديه"],[563,"أعط طرفا له وللكون طرفا","https://www.aldiwan.net/poem34343.html","الخفيف"],[572,"وطيب أهدى لنا طيبا","https://www.aldiwan.net/poem69460.html","السريع"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96373","الوافر"],[1000,"","https://poetry.dctabudhabi.ae/diwan/poem/75741","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120153","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120094","الرمل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35412","المتقارب"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136206","السريع"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64558","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64628","الطويل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125364","الكامل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52123","الوافر"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110312","الطويل"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137927",""],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109503","السريع"],[2231,"","https://poetry.dctabudhabi.ae/diwan/poem/124055","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77227","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77301","الرمل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121189","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93589","البسيط"],[2444,"","https://poetry.dctabudhabi.ae/diwan/poem/105402","الخفيف"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111247","الكامل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137513",""],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137351",""],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140042",""],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109777","الطويل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87370","البسيط"],[3400,"","https://poetry.dctabudhabi.ae/diwan/poem/130613","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117879","البسيط"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36767","البسيط"],[3825,"","https://poetry.dctabudhabi.ae/diwan/poem/206310","المتقارب"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86504","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119615","السريع"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90907","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94389","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94886","الوافر"],[4649,"","https://poetry.dctabudhabi.ae/diwan/poem/101942","المتقارب"],[4764,"يرحم ابويه الي فطمني على الزين","https://www.poetsgate.com/ViewPoem.aspx?id=35480",""],[3591,"لنا الجرأة الكبرى على ذلك القدر","https://www.poetsgate.com/ViewPoem.aspx?id=149436",""],[5273,"الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=176204",""],[5277,"الذهول","https://www.poetsgate.com/ViewPoem.aspx?id=184871",""],[5277,"رقيا الحبّ","https://www.poetsgate.com/ViewPoem.aspx?id=206125",""],[5690,"بيمن سلطاننا عبد العزيز","https://www.poetsgate.com/ViewPoem.aspx?id=172150",""],[5956,"بِظِلال نخلهما أنخُّ رواحلي","https://www.poetsgate.com/ViewPoem.aspx?id=193693",""],[5991,"أبداً بكم منكم إليكم اهرب","https://www.poetsgate.com/ViewPoem.aspx?id=116382",""],[5561,"حلو الكلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86130&r=&rc=4",""]],"verses":[["بِظَلامِ الغُروبِ أَو","بِضِياءِ المَشارِقِ",0,"ق",1,0],["بِظُبىً تَخلُطُ الجُزو","رَ بِضَربِ المَفارِقِ",0,"ق",1,0],["بِظُلمِهِم بِنِطاعِ المَلكَ ضاحِيَةً","فَقَد حَسَوا بَعدُ مِن أَنفاسِهِم جُرَعا",1,"ع",2,0],["بِظُلوفِها وَرَقُ البَشامِ وَدونَها","صَعبٌ تَزِلُّ سَراتُهُ بِالأَجدَلِ",2,"ل",1,0],["بظراء عُنْبلها كعظم ذِراعها","بخراء ثم أتت بأعمى أبخرِ",3,"ر",1,0],["بظراءُ يلقى الزناة عُنْبَلُها","بمخلبٍ للأيور خَدّاش",4,"ش",1,0],["بظنٍّ كرأي العين لا متقسَّمٍ","ولا حين ترفضُّ الظنونُ بمرفضّ",5,"ض",1,0],["بظلامٍ تُسلم الكفَّ له","أبدَ الدهرِ إلى قائدتك",6,"ك",1,0],["بظلامةِ الشوكيّ نا","لك من عِقابي ما يَهُضُّك",7,"ك",1,0],["بظراء تُمسخُ لامُها","راءً إذا رأتِ الفياشِلْ",8,"ل",1,0],["بظراءُ لو نطحتْ بمُقدَمِ بظرها","ثهلانَ حلحله ولم يتحلحلِ",9,"ل",1,0],["بِظاهِرٍ مُزَوَّقِ","وَباطِنٍ مُمَزَّقِ",10,"ق",1,0],["بظبيٍ في الخيامِ له مُرادٌ","وبدرٍ في الخدورِ له مَغيبُ",11,"ب",1,0],["بِظَبيٍ مِنَ الأَتراكِ في رَوضِ خَدِّهِ","غَديرُ مِياهِ الحُسنِ فيهِ رَكودُ",12,"د",1,0],["بظبي كالهلال من النصارى","محاسنهُ تزهّدُ في العذارى",13,"ر",2,0],["بظُلُوفِها وَرَقُ البَشَامِ ودُونَها","صَعْبٌ تَزِلُّ سَرَاتُهُ بلأجدَلِ",14,"ل",1,0],["بظلك لذت لوذة مستجير","لأنك أنت حصن المستجير",15,"ر",1,0],["بظاهِرى ظاهرٌ فيه لهيبُ هوًى","سرَى فشَى كادَ قلبى أن يذوب أسَى",16,"س",2,0],["بظلك كل شخص يستقيلُ","ومن شطط الحوادث يستقيلُ",17,"ل",1,1],["بِظِلِّ كَريمِ النَجرِ وَاليَدِ لَم تَلِد","لَهُ مامَةٌ مِثلاً وَلا نَجَلَت سُعدا",18,"د",2,0],["بِظِلِّكَ يا عِزَّ المُلوكِ اِبنَ تاجِها","وَفى لي زَمانٌ قَبلَ قُربِكَ ما وَفا",19,"ف",2,0],["بِظُبىً إِذا خَرِسَ الكُماةُ بِمَوقِفٍ","فَلَها كَلامٌ في الجَماجِمِ يُفهَمُ",20,"م",1,0],["بظلها قد أمدتنا ونائلها","يوم الندا فحمدنا الروض والسحبا",21,"ب",2,0],["بِظِلِّكِ الذِي هَفَتْ","أَفْنَانُهُ الْمَوْضُونَهْ",22,"ن",2,0],["بظلام البعد تراه فُجِي","كم لي بالقرب لديك أملْ",23,"ل",1,0],["بظهورٍ لاح لنا بادٍ","ولشدّته قد كان خفي",24,"ف",2,0],["بظلّهما قد صارت الأرضُ جنّةً","لها العدلُ خَصبٌ والإخاءُ نماء",25,"ا",2,0],["بظلمة الظلمِ يوم أعلوا","رأسي حسينٍ على الرديني",26,"ن",2,0],["بِظاهرٍ مُمَوَّهِ","وَباطنٍ مُشوَّهِ",27,"ه",1,0],["بظلِّ عزيزِ الدِّينِ قد عَزَّ أهلُه","فهمْ في سماء العزِّ يَحكونَ أَنجُما",28,"م",2,0],["بظُبىً يَمانيَةِ النِّجارِ وفِتْيَةٍ","بيضٍ كذاكَ يُناسبونَ الأنْصُلا",29,"ل",2,0],["بظاهرِ قَرميسينَ والرَّكبُ مُحدقٌ","حَوالَيْهِ فيهم جَيئةٌ وذهُوب",30,"ب",1,0],["بظنك أريَهُ شَرْياً","وتحسب شريه أريا",31,"ي",2,0],["بظُباً تنكِرُ الكُلولَ ولا يع","رفُ أَيضاً مَنْ يَنْتَضِيها الكلالا",32,"ل",2,0],["بِظَبيٍ نَفورٍ ولَكن يَرى","شَقَائي شِفَائي بذاكَ بَراني",33,"ن",2,0],["بظهور في كل شيء مراد","للإله الذي تحققت كشفا",34,"ف",2,0],["بِظَاهِرٍ أَخْشَنَ مِنْ قُنْفُذٍ","وَبَاطِنٍ أَلْيَنَ مِنْ زُبْدِ",35,"د",1,0],["بظعنٍ لجَّجَت في يومِ صيفٍ","وقالوا ليس بالأنهى قِطارُ",36,"ر",1,0],["بظباء وآنسات غَوان","لَم يُدرن سوى اللَمى جريالا",37,"ل",2,0],["بَظراءُ تعملُ للايو","رِ إذا هي احَتَبَسَتُ رُتَيلَه",38,"ل",2,0],["بظبي تمسي إلى ها","م الأعادي جدّ هيمِ",39,"م",1,0],["بِظِلِّ الظُبى جَنَّةٌ عالِيَه","وَمِنّى لَكُم جُنَّةٌ واقِيَه",40,"ي",2,1],["بظالم يزداد في ظلمه","ومذنب تزداد أوزاره",41,"ر",2,0],["بظهر ذلك الاناءِ ماءَ ولا","تغفل فيسرى للفساد اولا",42,"ل",2,0],["بظهر اسم الذات عذت وكونه","بفردية التخصيص للجمع حاويا",43,"ي",2,0],["بظاهر بين الحزم والرأي جيشه","يشن له الغارات وهو قطين",44,"ن",1,0],["بظَريفِ عُرسِكَ طاهِرٌ وَقُدُومِهِ","أمَّ السُّرُورُ قِنا وَزارَ الأقصُرا",45,"ر",2,0],["بظاهر برّه نفع البرايا","وأضعاف المشاهد قد أجنّا",46,"ن",2,0],["بظل أبي الدنيا خليفة بطرسٍ","ليحي سعيداً والزمان له عبد",47,"د",1,0],["بظلّ حماتها الممدود عزت","على من رامها فانصاع قصرا",48,"ر",2,0],["بظلمه جار عليَّ الزمان","وراع قلبي بالهوى والهوان",49,"ن",1,1],["بظي بأجنحها الغطمطم مثل ما","تغلى المراجل من أجيج النار",50,"ر",1,0],["بِظُبا كُلِّ أَبيَضٍ مَصقولٍ","في قَفا كُلِّ أَشقَرٍ رِعديدِ",51,"د",1,0],["بِظُبا كُلِّ حُسامٍ مُرهَفٍ","يَفلِقُ الهامَ وَيَمضي لِلوَتين",52,"ن",1,0],["بظاهر محتاجا على تهب ماله","ومن عجب بذل على السؤال سابق",53,"ق",1,0],["بِظل أَمنك نام الناس في رغد","وَملوء عَينك تَأريق وَتَسهيد",54,"د",1,0],["بظلام من فاحم الشعر داج","وجبين ينجاب عنه الظلام",55,"م",1,0],["بظهور مهدي يقر عيوننا","بظهور تلك الطلعة الغراء",56,"ا",2,0],["بظل مليك العصر عباسنا الذي","تسامى على هام الفراقد شانه",57,"ن",2,0],["بظل أمير المؤمنين الذي غدا","يشيد ركن العدل في السهل والوعر",58,"ر",1,0],["بظاهر النص آمنا وباطنه","والكل من عنده يدعو إلى الرشد",59,"د",1,0],["بظل امير المؤمنين تفتحت","كمائمها عن مدحه وثنائه",60,"ا",3,0],["بظلِّ مولىً حميدٍ عادِلٍ نَدُسٍ","بَرٍّ خَطيرٍ سَعيدٍ باسلٍ بطلِ",61,"ل",1,0],["بظل علاها كل عالٍ وهابط","وقصد حماها كل ماشٍ وراكب",62,"ب",1,0],["بظلّه الوارف الممدود لا برحوا","مظفّرين ومن أنجاله النجبَا",63,"ب",2,0],["بِظلِّ أَفيح راقت فيهِ أَزهارُ","وَغَرّدت في رُبا مَغناه أَطيارُ",64,"ر",1,0],["بظهر به الجدب بادي الظهور","وجنب به الخصب جار الجُنُب",65,"ب",1,0],["بظل أمير المؤمنين الذي له","أريجة ذكر للقيامة خالد",66,"د",1,0],["بظعنكم عنها منار الهدى","أخفي فلا يطيع تبيانا",67,"ن",2,0],["بظهور مولود لأكرم والد","وحفيد عزما جد لأجل جد",68,"د",1,0],["بظلّ مَليكنا نلنا فخاراً","مَليكُ المُلكِ مالكنا العَظيمُ",69,"م",1,0],["بظل عزيزنا المَلِك المُفدّى","بنَوهُ والورى أضحى شَكورا",70,"ر",2,1],["بظل الكريم ومأوى الكرام","جوار العلي الامام الهمام",71,"م",1,0],["بظل انا بنتك وافخر انا مين","مهما يزيد الظيم تبقى سِماته",72,"ت",2,0],["بظلّك يابيشون أقضي منى العلى","ويصدح في أيك السعادة لي قمري",73,"ر",2,0],["بِظَلامِ رَمْسِكَ آنَسَتْكَ قَصائدٌ","وَبَكَتْ ليُمْسِيَ دَمْعُها قِنْديلا",74,"ل",2,0],["بظبيتهِ وهي زينُ الظباءِ","تَرامَتْ وَصَيّادُها في المَلا",75,"ل",2,0],["بظلِّ الوردِ عطرٌ عبقريٌّ","ورقيا الحبّ بالعقلِ الأريبِ",76,"ب",1,0],["بظله قد رتعنا والحسود لنا","أضحى رقيباً فدعهُ في تفتتهِ",77,"ت",2,0],["بظلال نخْلهما أنخُّ رواحلي","متزوّداً منه بتمْرٍ هائلِ",78,"ل",1,1],["بظهوركم ظل الطوى في نوركم","وبنوركم قد زال عني الغيب",79,"ب",1,0],["بظلمة قبر وغربة روح","هما لحياتك ليل وضي",80,"ي",1,0]]}