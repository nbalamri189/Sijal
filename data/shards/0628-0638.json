{"poems":[[53,"سيدي أنت ليس كلل","https://www.aldiwan.net/poem29953.html","مجزوء الخفيف"],[9,"بانت سعاد وأمسى حبلها انقطعا","https://www.aldiwan.net/poem21951.html","البسيط"],[4,"لله نافلة الأجل الأفضل","https://www.aldiwan.net/poem21186.html","الكامل"],[51,"أأبي يوسف دعوة المستصغر","https://www.aldiwan.net/poem63998.html","الكامل"],[51,"لا ترج يا بيهقي إفراشي","https://www.aldiwan.net/poem64925.html","المنسرح"],[51,"أسوغ لخلاني مساغ شرابهم","https://www.aldiwan.net/poem64944.html","الطويل"],[51,"أيها الأعور لم جشمتني","https://www.aldiwan.net/poem65790.html","الطويل"],[51,"يا خالد ابن الخالدات","https://www.aldiwan.net/poem65801.html","مجزوء الكامل"],[51,"حي المعاهد والمنازل","https://www.aldiwan.net/poem65977.html","مجزوء الكامل"],[51,"أسألت رسم الدارِ أم لم تسأل","https://www.aldiwan.net/poem65978.html","الكامل"],[70,"أحبابنا حاشاكم","https://www.aldiwan.net/poem42787.html","مجزوء الرجز"],[61,"يريك قوامها الغصن الرطيب","https://www.aldiwan.net/poem51809.html","الوافر"],[66,"لعل ليالي الربوتين تعود","https://www.aldiwan.net/poem41357.html","الطويل"],[48,"دع الأمطار تعتور الديارا","https://www.aldiwan.net/poem66573.html","الوافر"],[4,"لِلّهِ نافِلَة ُ الأجَلِّ الأفْضَلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10937&r=&rc=32",""]],"verses":[["بِظَلامِ الغُروبِ أَو","بِضِياءِ المَشارِقِ",0,"ق",1,0],["بِظُبىً تَخلُطُ الجُزو","رَ بِضَربِ المَفارِقِ",0,"ق",1,0],["بِظُلمِهِم بِنِطاعِ المَلكَ ضاحِيَةً","فَقَد حَسَوا بَعدُ مِن أَنفاسِهِم جُرَعا",1,"ع",2,0],["بِظُلوفِها وَرَقُ البَشامِ وَدونَها","صَعبٌ تَزِلُّ سَراتُهُ بِالأَجدَلِ",2,"ل",1,0],["بظراء عُنْبلها كعظم ذِراعها","بخراء ثم أتت بأعمى أبخرِ",3,"ر",1,0],["بظراءُ يلقى الزناة عُنْبَلُها","بمخلبٍ للأيور خَدّاش",4,"ش",1,0],["بظنٍّ كرأي العين لا متقسَّمٍ","ولا حين ترفضُّ الظنونُ بمرفضّ",5,"ض",1,0],["بظلامٍ تُسلم الكفَّ له","أبدَ الدهرِ إلى قائدتك",6,"ك",1,0],["بظلامةِ الشوكيّ نا","لك من عِقابي ما يَهُضُّك",7,"ك",1,0],["بظراء تُمسخُ لامُها","راءً إذا رأتِ الفياشِلْ",8,"ل",1,0],["بظراءُ لو نطحتْ بمُقدَمِ بظرها","ثهلانَ حلحله ولم يتحلحلِ",9,"ل",1,0],["بِظاهِرٍ مُزَوَّقِ","وَباطِنٍ مُمَزَّقِ",10,"ق",1,0],["بظبيٍ في الخيامِ له مُرادٌ","وبدرٍ في الخدورِ له مَغيبُ",11,"ب",1,0],["بِظَبيٍ مِنَ الأَتراكِ في رَوضِ خَدِّهِ","غَديرُ مِياهِ الحُسنِ فيهِ رَكودُ",12,"د",1,0],["بظبي كالهلال من النصارى","محاسنهُ تزهّدُ في العذارى",13,"ر",2,0],["بظُلُوفِها وَرَقُ البَشَامِ ودُونَها","صَعْبٌ تَزِلُّ سَرَاتُهُ بلأجدَلِ",14,"ل",1,0]]}