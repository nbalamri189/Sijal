{"poems":[[53,"لكل مجتهد حظ من الطلب","https://www.aldiwan.net/poem30753.html","البسيط"],[63,"سرى طيفها والملتقى متدان","https://www.aldiwan.net/poem46182.html","الطويل"],[3,"بين العقيق وبين بُرقة ثهمد","https://www.aldiwan.net/poem152.html",""],[9,"أرقت وما هذا السهاد المؤرق","https://www.aldiwan.net/poem21956.html","الطويل"],[86,"الشعب يدعو الله يا زغلول","https://www.aldiwan.net/poem68900.html","الكامل"],[93,"فاح ريحانها ولاح الخزام","https://www.aldiwan.net/poem11347.html","الخفيف"],[30,"أدارا بحزوى هجت للعين عبرة","https://www.aldiwan.net/poem29554.html","الطويل"],[4,"ألا تسألان المرء ماذا يحاول","https://www.aldiwan.net/poem21189.html","الطويل"],[72,"يا دار جيرتنا بسفح الأجرع","https://www.aldiwan.net/poem19161.html","الكامل"],[32,"ألا أيها الربع الذي غير البلى","https://www.aldiwan.net/poem27775.html","الطويل"],[45,"ربع خلا من بدره مغناه","https://www.aldiwan.net/poem66856.html","الكامل"],[61,"وطيب النشر عبق","https://www.aldiwan.net/poem51526.html","مجزوء الرجز"],[66,"بدت لنا الراح في تاج من الحبب","https://www.aldiwan.net/poem38500.html","البسيط"],[44,"يا سمي النبي في سورة الجن","https://www.aldiwan.net/poem30251.html","الخفيف"],[69,"باشر بالعدل والسكينه","https://www.aldiwan.net/poem27999.html","مخلع البسيط"],[31,"أصبح القلب مريضا","https://www.aldiwan.net/poem42471.html","مجزوء الرمل"],[48,"حماني وصل أبناء القسوس","https://www.aldiwan.net/poem66569.html","الوافر"],[8,"لمن الدار كأنضاء الخلل","https://www.aldiwan.net/poem21814.html","الرمل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16663","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9920","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142035","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141975","الكامل"],[106,"الكلب هول","https://www.poetsgate.com/ViewPoem.aspx?id=179445",""],[31,"أصبحَ القلبُ مريضا،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18927&r=&rc=190",""],[116,"علمتم بأني مغرم بكم صب","https://www.aldiwan.net/poem41234.html","عموديه"],[133,"أرى العذال في الهيمان لاموا","https://www.aldiwan.net/poem54654.html","الوافر"],[138,"فما مسك يعل بزنجبيل","https://www.aldiwan.net/poem68021.html","الوافر"],[165,"أماطت لثاما عن أقاح الدمائث","https://www.aldiwan.net/poem67812.html","الطويل"],[186,"يجل اشتياقي أن أقول له وصفا","https://www.aldiwan.net/poem14599.html","الطويل"],[233,"علمتم بأني مغرم بكم صب","https://www.aldiwan.net/poem14836.html","الطويل"],[271,"الشام يقهر والعراق يضام","https://www.aldiwan.net/poem35641.html","الكامل"],[271,"هو الملك تبنيه الجيوش الخضارم","https://www.aldiwan.net/poem35646.html","الطويل"],[283,"كفى حزنا أني عن الحي سآل","https://www.aldiwan.net/poem32671.html","الطويل"],[283,"ترجل عن شهبائه الظاهر الغازي","https://www.aldiwan.net/poem32741.html","الطويل"],[299,"من ضاق ذرعا بالبلية فليزر","https://www.aldiwan.net/poem36253.html","عموديه"],[354,"أدر راح الصفا ولك الأمان","https://www.aldiwan.net/poem39769.html","الوافر"],[365,"زمان قليل من بنيه نجيب","https://www.aldiwan.net/poem60998.html","الطويل"],[367,"زار الصباح فكيف حالك يا دجى","https://www.aldiwan.net/poem17148.html","الكامل"],[433,"يا بن عدلان يا أخس الرجال","https://www.aldiwan.net/poem12457.html","الخفيف"],[459,"طوى الليل راكب أخطاره","https://www.aldiwan.net/poem56164.html","المتقارب"],[462,"لقد علم الأحياء دان ونازح","https://www.aldiwan.net/poem15399.html","الطويل"],[462,"العز حيث البلدة الزوراء","https://www.aldiwan.net/poem16046.html","الكامل"],[471,"خمس دسسن إلي في لطف","https://www.aldiwan.net/poem4694.html","أحذ الكامل"],[494,"بأبي الغائب الذي لم يغب عن","https://www.aldiwan.net/poem67412.html","الخفيف"],[501,"يا إلهي يا معين العاجزين","https://www.aldiwan.net/poem37550.html","الرمل"],[516,"خذ يا زمان أماناً من يدي أملي","https://www.aldiwan.net/poem12211.html","البسيط"],[539,"بإيابك الميمون أشرق نور","https://www.aldiwan.net/poem47426.html","عموديه"],[539,"دعنى من ذكر حداة الأينق","https://www.aldiwan.net/poem47549.html","عموديه"],[539,"لما استقام ولم يفز بمرامه","https://www.aldiwan.net/poem48130.html","عموديه"],[552,"فما ماء مزن بات جفن سحابة","https://www.aldiwan.net/poem47897.html","الطويل"]],"verses":[["باشِر بِطَلعَتِها العَلياءَ مُقتَبِلاً","فَإِنَّها دُرَّةٌ في حِليَةِ النَسَبِ",0,"ب",1,0],["بأشْرَفِ بَيْتٍ في لُؤَيِّ بْنِ غالِبٍ","جَنوحٍ إِلى أبوابِهِ الثَّقَلانِ",1,"ن",1,0],["باشَرتُ مَوكِبَها وَخُضتُ غُبارَه","أَطفَأتُ جَمرَ لَهيبِها المُتَوَقِّدِ",2,"د",1,0],["بِأَشجَعَ أَخّاذٍ عَلى الدَهرِ حُكمَهُ","فَمِن أَيِّ ما تَجني الحَوادِثُ أَفرَقُ",3,"ق",1,0],["بِأَشَدِّنا بَأساً وَأَقدَمِنا عَلى","خَوضِ الشَدائِدِ وَالخُطوبُ مُثولُ",4,"ل",1,0],["بَاشِرُوا الْخَيْرَ يُدْفَعِ الشَّرُّ عَنْكُمْ","إِنَّمَا الْخَيْرُ عِصْمَةُ وَسَلامُ",5,"م",1,0],["بِأَشعَثَ مُنقَدِّ القَميصَ كَأَنَّهُ","صَفيحَةُ سَيفٍ جَفنَهُ مُتَخَرَّقُ",6,"ق",1,0],["بِأَشهَبَ مِن أَبكارِ مُزنِ سَحابَةٍ","وَأَريِ دَبورٍ شارَهُ النَحلَ عاسِلُ",7,"ل",1,0],["بأشدّ من شهد الوغى وأرقّ من","وقعت عواطف حلمه في موقع",8,"ع",1,0],["بِأَشهى مِنَ القَولِ الَّذي قُلتِ بَعدَما","تَمَكَّنَ مِن حَيزومِ ناقَتِيَ الرَحلُ",9,"ل",1,0],["بِأَشَدَّ مِنهُ في الزَعازِعِ مُقدِماً","وَالمَوتُ مُحتَدِمٌ يَشُبُّ لَظاهُ",10,"ا",2,0],["باشَرَ صحبي بَرْدَه","قبلَ تَباشيرِ الفَلَقْ",11,"ق",1,0],["باشِر غَرائِبَ أَشعاري فَقَد بَرَزَت","إِلَيكَ أَبكارُ أَفكاري مِنَ الحُجُبِ",12,"ب",1,0],["باشَرَ الماءَ فَهوَ في رِقَّةِ الصَن","عَةِ كَالماءِ غَيرَ أَن لَيسَ يَجري",13,"ر",2,0],["باشرَ بالعدلِ والسكينهْ","والسيرةِ البرةِ الأمينَهْ",14,"ه",1,1],["باشَرَ الأَنيابَ مِنها","بَعدَما ذُقتَ غُموضا",15,"ض",2,0],["بأشفَهرٍ ويا نيدٍ ونهر","وحقِّ الماهِ والمهرار بيسِ",16,"س",1,0],["باشَرَتهُ جَونَةٌ مَرشومَةٌ","أَو جَدِيدٌ حَدَثُ القارِ جَحَل",17,"ل",1,0],["بأشْنَبَ مِعْطارِ الغَريزَةِ مُقْسِمٌ","لسائفِه أنّ القَسِيمَةَ مِتْفال",18,"ل",1,0],["باشَرتُ مَوكِبَها وَخُضتُ غُبارَها","أَطفَأتُ جَمرَ لَهيبِها المُتَوَقِّدِ",19,"د",1,0],["بأشد من قول الرواة لعروة","عفراء امست زوجة لفلان",20,"ن",1,0],["بأشد من خفقان قلبي","يوم قيل: خفرت عهدك",21,"ك",1,0],["بإشارة منك الحيا","ةُ لمن تشاء، أو الوفاء",22,"ا",2,0],["بَاشَرَ الأَنْيَابَ مِنْهَا","بعدما ذاقت غموضا",23,"ض",2,0],["بأشوق من قلبي اليكم فليتني","يعفر وجهي من رحابكم الترب",24,"ب",1,0],["بأشهى أو بأحسنِ من ثنايا","مُقَبِّلِها إِذَا الرقباءُ ناموا",25,"م",3,0],["بِأَشهى مِن مُجاجَةِ ريقِ سَلمى","وَلا ما في الزِقاقِ مِن القِراحِ",26,"ح",1,0],["بِأَشباحِنا وَالجِنُّ تَعزِفُ بِالفَلا","هَثاهِثُها مَوصولَةُ بِهَثاهِثِ",27,"ث",1,0],["بأَشْوَقَ مني يوم شَطّتْ بك النَّوى","هوائيةً مائية تَسْبِق الطَّرْفا",28,"ف",2,0],["بِأَشوَقَ مِن قَلبي إِلَيكُم فَلَيتَني","قَضَيتُ أَسىً أَولَيتَ لَم يَكُنِ الحُبُّ",29,"ب",1,0],["بأشدِّ من هذاكَ ما بُليَ الوَرى","هل بَعدَهُ صَبرٌ أَو استِسلام",30,"م",1,0],["بأشداقِ أغوالٍ تَصولُ على العِدى","وفي اللّهواتِ الوبلُ والمتراكم",31,"م",1,0],["بِأَشجَعَ مِنهُ حينَ يُشهِرُ سَيفَهُ","وَيَهتَزُّ في يُمناهُ لِلطَّعنِ عَسّالُ",32,"ل",1,0],["بِأَشجَعَ مِنهُ في الكَريهَةِ مُقدِماً","وَراءَ هَزيمٍ بِالأَفاكِلِ قَفّازِ",33,"ز",1,0],["بأَشدَّ فجعاً من (سنية) إذ قضتْ","يجري لها من كل جفن ماؤه",34,"ا",3,0],["بِأَشبال ختانهمُ دَعانا","لِنَيل الفَوز دَعوَة من يَدانُ",35,"ن",1,0],["بأشوقَ مني نحوه غير أنّني","لِلُقياهُ من خوفِ العتابِ هيوب",36,"ب",1,0],["باشَرتُ بِشرَكَ لا بِمِنَّةِ شافِعٍ","فَغَنيتُ يا شَمسَ الضُحى أَن أُسرِجا",37,"ج",2,0],["باشرَتْ رأسُك الفِراءَ فلاقَتْ","جلدَها في صلابة السِّنْدالِ",38,"ل",1,0],["بأشنبَ يسمحُ للراشفين","بنهب ودائعِ خمَّارِهِ",39,"ر",2,0],["بأشجعَ من تاجِ المُلوكِ اذا دَجا","الصباح وغابت في النحور الشوارعُ",40,"ع",1,0],["بأشدَّ من بأسِ الإِمامِ إذا عَلا","صوتُ الصَّريخ وهاجت الهيْجاءُ",41,"ا",2,0],["بِأَشَمَّ مَعسولٍ فُكاهَتُهُ","غَضَّ الشَبابِ رِداؤُهُ غَمرُ",42,"ر",1,0],["باشَرَتهُ كَفُّ الطَبيبِ فَلَو نِل","تُ الأَماني قَبَّلتُ كَفَّ الطَبيبِ",43,"ب",1,0],["بإشارات رموز الأصفيا","وعبارات فهوم الأتقيا",44,"ي",2,0],["باشرتها بحسام غير منثلم","أبا الحسام ولم تسأل عن الأسل",45,"ل",1,0],["باشا المعالي والعوالي والعُلا","فلكٌ به زُهر النجوم تَدورُ",46,"ر",1,0],["باشا مَقامَه الملوكُ ترتَجِي","لِكَى تفوزَ بالمَقامِ الأليَقِ",47,"ق",1,0],["بأشَدَّ مَن حُزني على وَطَني الذي","هو ما عملتَ وربُّنا قَهَّارُ",48,"ر",1,0],["بِأَشجى شَجىً مِنِّي غداةَ ذكرتُكُمْ","ووادي مِنىً بالعيس والقومِ يطفحُ",49,"ح",1,0],["بِأَشهى وَأَحلى مِن لقائِكِ موهِناً","وألحاظُ مَنْ يبغِي النميمةَ نُزَّحُ",49,"ح",1,0]]}