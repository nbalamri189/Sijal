https://poetry.dctabudhabi.ae/diwan/poem/112357","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89133","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89113","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74049","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74095","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62946","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45751","البسيط"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45744","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131058",""],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59485","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59446","المتقارب"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40134","المتقارب"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75683","الكامل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136948",""],[4106,"","https://poetry.dctabudhabi.ae/diwan/poem/130741","الكامل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33675","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72430","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139637",""],[4717,"كفرتُ بأمنها القومي","https://www.poetsgate.com/ViewPoem.aspx?id=199698",""],[4869,"يا مطيّح الحر يوم ارمشت","https://www.poetsgate.com/ViewPoem.aspx?id=151562",""],[5102,"حنين..","https://www.poetsgate.com/ViewPoem.aspx?id=12883",""],[2365,"كان الذي خفت أن يكونا","https://www.poetsgate.com/ViewPoem.aspx?id=200665",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5431,"ارفق بقلبه .....","https://www.poetsgate.com/ViewPoem.aspx?id=210357",""],[5848,"عقارب تعبث","https://www.poetsgate.com/ViewPoem.aspx?id=53335",""],[5848,"ياشعل سيجارة","https://www.poetsgate.com/ViewPoem.aspx?id=48950",""],[6008,"احترتُ بالحاير","https://www.poetsgate.com/ViewPoem.aspx?id=59158",""],[6056,"وطفاء الحجاجين","https://www.poetsgate.com/ViewPoem.aspx?id=130183",""],[6056,"فخ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=156699",""],[6102,"طالق ..","https://www.poetsgate.com/ViewPoem.aspx?id=184436",""],[6128,"تصرَّف","https://www.poetsgate.com/ViewPoem.aspx?id=212858",""],[520,"أفخر فحسبك ما اوتيت من حسب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577444",""],[520,"يهوى الحبيبين من بأس ومن كرم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577609",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""]],"verses":[["باشِر بِطَلعَتِها العَلياءَ مُقتَبِلاً","فَإِنَّها دُرَّةٌ في حِليَةِ النَسَبِ",0,"ب",1,0],["بأشْرَفِ بَيْتٍ في لُؤَيِّ بْنِ غالِبٍ","جَنوحٍ إِلى أبوابِهِ الثَّقَلانِ",1,"ن",1,0],["باشَرتُ مَوكِبَها وَخُضتُ غُبارَه","أَطفَأتُ جَمرَ لَهيبِها المُتَوَقِّدِ",2,"د",1,0],["بِأَشجَعَ أَخّاذٍ عَلى الدَهرِ حُكمَهُ","فَمِن أَيِّ ما تَجني الحَوادِثُ أَفرَقُ",3,"ق",1,0],["بِأَشَدِّنا بَأساً وَأَقدَمِنا عَلى","خَوضِ الشَدائِدِ وَالخُطوبُ مُثولُ",4,"ل",1,0],["بَاشِرُوا الْخَيْرَ يُدْفَعِ الشَّرُّ عَنْكُمْ","إِنَّمَا الْخَيْرُ عِصْمَةُ وَسَلامُ",5,"م",1,0],["بِأَشعَثَ مُنقَدِّ القَميصَ كَأَنَّهُ","صَفيحَةُ سَيفٍ جَفنَهُ مُتَخَرَّقُ",6,"ق",1,0],["بِأَشهَبَ مِن أَبكارِ مُزنِ سَحابَةٍ","وَأَريِ دَبورٍ شارَهُ النَحلَ عاسِلُ",7,"ل",1,0],["بأشدّ من شهد الوغى وأرقّ من","وقعت عواطف حلمه في موقع",8,"ع",1,0],["بِأَشهى مِنَ القَولِ الَّذي قُلتِ بَعدَما","تَمَكَّنَ مِن حَيزومِ ناقَتِيَ الرَحلُ",9,"ل",1,0],["بِأَشَدَّ مِنهُ في الزَعازِعِ مُقدِماً","وَالمَوتُ مُحتَدِمٌ يَشُبُّ لَظاهُ",10,"ا",2,0],["باشَرَ صحبي بَرْدَه","قبلَ تَباشيرِ الفَلَقْ",11,"ق",1,0],["باشِر غَرائِبَ أَشعاري فَقَد بَرَزَت","إِلَيكَ أَبكارُ أَفكاري مِنَ الحُجُبِ",12,"ب",1,0],["باشَرَ الماءَ فَهوَ في رِقَّةِ الصَن","عَةِ كَالماءِ غَيرَ أَن لَيسَ يَجري",13,"ر",2,0],["باشرَ بالعدلِ والسكينهْ","والسيرةِ البرةِ الأمينَهْ",14,"ه",1,1],["باشَرَ الأَنيابَ مِنها","بَعدَما ذُقتَ غُموضا",15,"ض",2,0],["بأشفَهرٍ ويا نيدٍ ونهر","وحقِّ الماهِ والمهرار بيسِ",16,"س",1,0],["باشَرَتهُ جَونَةٌ مَرشومَةٌ","أَو جَدِيدٌ حَدَثُ القارِ جَحَل",17,"ل",1,0],["بأشْنَبَ مِعْطارِ الغَريزَةِ مُقْسِمٌ","لسائفِه أنّ القَسِيمَةَ مِتْفال",18,"ل",1,0],["باشَرتُ مَوكِبَها وَخُضتُ غُبارَها","أَطفَأتُ جَمرَ لَهيبِها المُتَوَقِّدِ",19,"د",1,0],["بأشد من قول الرواة لعروة","عفراء امست زوجة لفلان",20,"ن",1,0],["بأشد من خفقان قلبي","يوم قيل: خفرت عهدك",21,"ك",1,0],["بإشارة منك الحيا","ةُ لمن تشاء، أو الوفاء",22,"ا",2,0],["بَاشَرَ الأَنْيَابَ مِنْهَا","بعدما ذاقت غموضا",23,"ض",2,0],["بأشوق من قلبي اليكم فليتني","يعفر وجهي من رحابكم الترب",24,"ب",1,0],["بأشهى أو بأحسنِ من ثنايا","مُقَبِّلِها إِذَا الرقباءُ ناموا",25,"م",3,0],["بِأَشهى مِن مُجاجَةِ ريقِ سَلمى","وَلا ما في الزِقاقِ مِن القِراحِ",26,"ح",1,0],["بِأَشباحِنا وَالجِنُّ تَعزِفُ بِالفَلا","هَثاهِثُها مَوصولَةُ بِهَثاهِثِ",27,"ث",1,0],["بأَشْوَقَ مني يوم شَطّتْ بك النَّوى","هوائيةً مائية تَسْبِق الطَّرْفا",28,"ف",2,0],["بِأَشوَقَ مِن قَلبي إِلَيكُم فَلَيتَني","قَضَيتُ أَسىً أَولَيتَ لَم يَكُنِ الحُبُّ",29,"ب",1,0],["بأشدِّ من هذاكَ ما بُليَ الوَرى","هل بَعدَهُ صَبرٌ أَو استِسلام",30,"م",1,0],["بأشداقِ أغوالٍ تَصولُ على العِدى","وفي اللّهواتِ الوبلُ والمتراكم",31,"م",1,0],["بِأَشجَعَ مِنهُ حينَ يُشهِرُ سَيفَهُ","وَيَهتَزُّ في يُمناهُ لِلطَّعنِ عَسّالُ",32,"ل",1,0],["بِأَشجَعَ مِنهُ في الكَريهَةِ مُقدِماً","وَراءَ هَزيمٍ بِالأَفاكِلِ قَفّازِ",33,"ز",1,0],["بأَشدَّ فجعاً من (سنية) إذ قضتْ","يجري لها من كل جفن ماؤه",34,"ا",3,0],["بِأَشبال ختانهمُ دَعانا","لِنَيل الفَوز دَعوَة من يَدانُ",35,"ن",1,0],["بأشوقَ مني نحوه غير أنّني","لِلُقياهُ من خوفِ العتابِ هيوب",36,"ب",1,0],["باشَرتُ بِشرَكَ لا بِمِنَّةِ شافِعٍ","فَغَنيتُ يا شَمسَ الضُحى أَن أُسرِجا",37,"ج",2,0],["باشرَتْ رأسُك الفِراءَ فلاقَتْ","جلدَها في صلابة السِّنْدالِ",38,"ل",1,0],["بأشنبَ يسمحُ للراشفين","بنهب ودائعِ خمَّارِهِ",39,"ر",2,0],["بأشجعَ من تاجِ المُلوكِ اذا دَجا","الصباح وغابت في النحور الشوارعُ",40,"ع",1,0],["بأشدَّ من بأسِ الإِمامِ إذا عَلا","صوتُ الصَّريخ وهاجت الهيْجاءُ",41,"ا",2,0],["بِأَشَمَّ مَعسولٍ فُكاهَتُهُ","غَضَّ الشَبابِ رِداؤُهُ غَمرُ",42,"ر",1,0],["باشَرَتهُ كَفُّ الطَبيبِ فَلَو نِل","تُ الأَماني قَبَّلتُ كَفَّ الطَبيبِ",43,"ب",1,0],["بإشارات رموز الأصفيا","وعبارات فهوم الأتقيا",44,"ي",2,0],["باشرتها بحسام غير منثلم","أبا الحسام ولم تسأل عن الأسل",45,"ل",1,0],["باشا المعالي والعوالي والعُلا","فلكٌ به زُهر النجوم تَدورُ",46,"ر",1,0],["باشا مَقامَه الملوكُ ترتَجِي","لِكَى تفوزَ بالمَقامِ الأليَقِ",47,"ق",1,0],["بأشَدَّ مَن حُزني على وَطَني الذي","هو ما عملتَ وربُّنا قَهَّارُ",48,"ر",1,0],["بِأَشجى شَجىً مِنِّي غداةَ ذكرتُكُمْ","ووادي مِنىً بالعيس والقومِ يطفحُ",49,"ح",1,0],["بِأَشهى وَأَحلى مِن لقائِكِ موهِناً","وألحاظُ مَنْ يبغِي النميمةَ نُزَّحُ",49,"ح",1,0],["بِأشجَعَ مِن لَيثٍ وَأنفََعَ مِن حَيًا","وَأقطَعَ مِن سَيفٍ وَأَنفَذَ مِن سَهمِ",50,"م",1,0],["باشجع من ليث العرينة فاتك","واقطع من ماضي الغرارين صارم",51,"م",1,0],["باشر الحرب والهوى يبعث الإق","دام في قلبه فيسطو مغيرا",52,"ر",2,0],["باشرت فيه عدل حكمك شاملاً","وشهدت عقبى ما منحت جوادا",53,"د",2,0],["بِأَشرَفِ الرُّسلِ الكِرامْ","وَبِالكِرامِ الكَاتِبين",54,"ن",1,0],["بأشغل منى يوم زَمُّوا نياقَهم","وساروا وحادى الواخدات بهم حدا",55,"د",2,0],["بأشوق اليوم من عيني لرؤيتكم","وأخلص الود في جهر ومُعتقد",56,"د",1,0],["بأشم مصقول السجايا والحجى","غير ان معسول المزايا والشيم",57,"م",1,0],["بأشياءَ مما يأشِبُ الناسُ لو رَمَوا","بها البدرَ أَضحى لونه وهو كاسفُ",58,"ف",1,0],["بإشراق سلطان البرايا مليكنا","ومولانا محمود المزايا ضيا الهدى",59,"د",2,1],["بأَشْبَهِهِمْ في الجَدْبِ مَشْتىً وفي الوَغَى","مَصْيفَا إِذا أعْطَى وصالَ بِمَرْبَعِ",60,"ع",1,0],["بأشلاءِ أسفارٍ كأنّ وجوهَهُم","بلفح الحصا قطعٌ من الليل أسفعُ",61,"ع",1,0],["باشرا ذاك البناءَ بخُبر","لم يريدا إلاَّ اللطيفَ الخبيرا",62,"ر",2,0],["بِأَشوَقَ مِنّي وَلَكِن إِذا","تَناءَت جُسومٌ تَدانَت قُلوبُ",63,"ب",1,0],["بِإشارَةٍ جَاءَتْ كَفَجرٍ سَاطِعٍ","في صِدْقِهِ وَضِياؤُهُ يَتَزَيَّدُ",64,"د",1,0],["باشر سعودك ليس الوقت بالدون","واجعل صبوحك عند باب سعدون",65,"ن",1,1],["بأشفقَ مني مُذْ أطاحت بك النَّوَى","هوائيةٌ مائيةٌ تسبق الطَّرْفَا",66,"ف",2,0],["بأشمّ كم جُرم يمرّ بحمله","كمرور أنفاس الصَّبا بشَمَام",67,"م",1,0],["بِأَشأُمَ مِن باذِلٍ رَحَّلوا","لِيُحمَلَ مَن حُسنُهُ فائِقُ",68,"ق",1,0],["بأشوس الغدوة سامٍ نَظَرُهُ","يبادُر الناظرُ وهو يبدرُه",69,"ر",2,0],["بأَشعثَ مِن طُولِ السُرى عَسَفَت بِهِ","إِلَيكَ عَلَنداةٌ مِنَ العَيسِ عَيطَلُ",70,"ل",1,0],["باشارات بها الفقه اِنطَوى","وعلى منبره لما اِستوى",71,"ت",3,0],["بأشطار كأمثال اللئالي","تفوق الروض في حسن وطيب",72,"ب",1,0],["باشِيهما اصبَعَانِ بَل يزيدُ","ضدُّ الباجسُ يا حميدُ",73,"د",1,0],["باشيُّهُ ثلاثةٌ ونصفُ في","حسابِ جُزر حَسَنِ الوصفِ",73,"ف",1,0],["باشي اصبعين يا أخِي ونصفِ","فالميخُ والجاهُ سوا خُذ وصفي",73,"ي",1,0],["بإشراقها كل العوالم أشرقت","لما لاح في الكونين من نورها الساري",74,"ر",2,0],["باشَر ذا الأَمرَ نَعم بِنَفسِه","آنسَه اللَّهُ بِحُسن أُنسِهِ",75,"ه",1,0],["باشوق من قلبي عشية أنثني","أناديك أسوانا ولست تجيب",76,"ب",1,0],["باشراق سلطان الرشاد محمد","ترنح عطف الملك منشرحاً صدرا",77,"ر",2,0],["بأشعَرَ عند بعض الناس ممّن","يرقّعها على ضوءِ السّراجِ",78,"ج",1,0],["باشا له المجدُ خدنٌ والرشاد له","عبدٌ مطيع لما يهوي مدى العصر",79,"ر",1,0],["باشا جليل الفضل ذو","طبعٍ وفيٍّ يشكر",80,"ر",1,0],["بأَشدّ فَتكاً مِن نَظي","مك في فُؤاد رَفيضهِ",81,"ض",2,0],["بأشدّ ما عانيت من جرع الضَنى","دَهراً وَما قاسيت في مضض الأَسى",82,"س",2,0],["باشرتُ حد السيفِ لم أَحفل به","وزَهِدتُ بعدك في النضار الاحمرِ",83,"ر",1,0],["باشر لآليء أَلفاظ لَو اِنتَظَمَت","في مَدح غَيرك قالوا الآن قَد مَزَحا",84,"ح",2,0],["باشر بلاغة ألفاظ تهنئكم","بِما بلغتم وَهَذا بَعض ما يَجب",85,"ب",1,0],["بأشد وجدا منه حي","ن يشوقه ألف نأى",86,"ا",1,0],["بأشجع مني والأسنةُ شرَّعٌ","إذا فوجيءَ القرمُ الكميُّ بأوجالِ",87,"ل",1,0],["بأشجَعَ مني غَداةَ الحُبيلِ","إذا الروّعُ سُرّي بجِلبابِه",88,"ب",2,0],["بِأَشمَخَ مِن أَنفِها مَنكِباً","وَأَكثَر مَن عَدَّ تورابَها",89,"ب",3,0],["بأشد من ليث العَرينة جرأة","وَأَعز من زهر النجوم قَبيلا",90,"ل",2,0],["بأشرقَ منها مبسماً وهو جالسٌ","يباسطها بالجد حيناً وبالهزل",91,"ل",1,0],["باشر بِهَا المَذبُوح ثاني مرةٍ","وأنا الضمينُ بأن تَعُودَ حياتُهُ",92,"ه",1,0],["باشتِياقي إليكَ يا أحسنَ العا","لم وَجهاً لا تجفون حسنَ ظنِّي",93,"ن",2,0],["بأشكال تأسيس العناية هندست","قواعده في كل زاوية قطرا",94,"ر",2,0],["باشراق وجه الفضل قد أشرق السعدُ","وقد أقبل الإحسان والجود والمجدُ",95,"د",1,1],["(بأشعارٍ) كطعْناتٍ بقلبي","إذا جُرْحٌ مضى منها أتى (جُرْ..)",96,"ر",1,0],["باشربك لين افقد الافكار في كونك","وتصيري امي وابوي وكل من ليّه",97,"ي",2,0],["بأشعار خنساءَ صخرُ اشتهرْ","وخنساء ترثيه في كل حينْ",98,"ن",1,0],["باشر وجه الثرى بوجه","قد كان من قبله مصونا",99,"ن",2,0],["بأشعار مشببة بسعدي","وهند أو بربات الجمال",100,"ل",1,0],["بأشباه أفواه وشوقٍ معلّبٍ","وأحذية دقت ومالت لتوقفه",101,"ف",2,0],["باشوفك مثل ما ودك أشوفك لو بليّا عين !","وباحبك مثل ما ودي أحبك وادفي عظامي",102,"م",2,0],["باشعل سيجارة من انفاسك وابنفث كلام","يطير... لين يتجاوز سقف هذا المدى",103,"د",2,1],["باشاعة ليزرماتبين التقارير","لو عالجوه علاجهم مايلايم",104,"م",1,0],["بأشوف خل ٍ منتويني من سنين","من عقب ماشطتّ ، علينا دياره",105,"ر",2,0],["بأشتكي من ظلم خليّ بتعويده","كلما اسعى لقربه ، زاد في بعادي",106,"د",2,0],["بِإِشارَةٍ فُرَصُ النَّجاةِ تَمَزَّقَتْ","مِن إِصبَعٍ نُصِبَتْ عَلَيهِ مَشانِقُ",107,"ق",1,0],["بأشكالِ التَّعَلُّق كَي يَرانِي","مُعَلّقةً وقلبِيَ قَد تَهََفْهفْ",108,"ف",1,0],["باشورٍ وشجاعٍ عز نصرهما","عز على طارق الأيام والنوب",109,"ب",1,0],["باشرتها بحسام غير منثلم","ابا الحسام ولم تسل عن الأسل",110,"ل",1,0],["بأشواقي وما خمدت قليلا","وكنت أظن شوقي للخمود",111,"د",1,0]]}