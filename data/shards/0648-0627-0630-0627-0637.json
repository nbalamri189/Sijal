{"poems":[[53,"قضت المنازل يوم كاظمة","https://www.aldiwan.net/poem29962.html","الكامل"],[77,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[42,"حسدوا الفتى إذ لم ينالوا سعيه","https://www.aldiwan.net/poem50221.html","الكامل"],[42,"وإذا طلبت من الحوائج حاجة","https://www.aldiwan.net/poem50270.html","الكامل"],[88,"هي دنيا بقاؤها مستحيل","https://www.aldiwan.net/poem45050.html","الخفيف"],[91,"ليت الذي خلق العيون السودا","https://www.aldiwan.net/poem8816.html","عموديه"],[78,"وإذا توعرت المسالك لم ارد","https://www.aldiwan.net/poem14262.html","الكامل"],[85,"أمس انقضى واليوم مرقاة الغد","https://www.aldiwan.net/poem8102.html","الكامل"],[43,"لا الحلم جاد به ولا بمثاله","https://www.aldiwan.net/poem9931.html","الكامل"],[43,"حييت من قسم وأفدي المقسما","https://www.aldiwan.net/poem10564.html","الكامل"],[62,"قل لمن يطلب الحجر","https://www.aldiwan.net/poem52140.html","مجزوء الخفيف"],[62,"نظري إلى لمع الوميض حنين","https://www.aldiwan.net/poem52265.html","الكامل"],[62,"إن العيون إذا نطقت تخاوصت","https://www.aldiwan.net/poem52341.html","الكامل"],[62,"إني لأذكركم وقد بلغ الظما","https://www.aldiwan.net/poem52443.html","الكامل"],[45,"قل للخيال إذا أردت فعاود","https://www.aldiwan.net/poem63447.html","الكامل"],[45,"لله عهد سويقة ما أنضرا","https://www.aldiwan.net/poem63603.html","الكامل"],[28,"بين إذا نزلت عليك مجاشع","https://www.aldiwan.net/poem5311.html","الكامل"],[61,"أما الخيال فما يغب طروقا","https://www.aldiwan.net/poem51534.html","الكامل"],[61,"غضبان ينساني وأذكره","https://www.aldiwan.net/poem51669.html","أحذ الكامل"],[58,"صرمت حبالك بعد وصلك زينب","https://www.aldiwan.net/poem31129.html","الكامل"],[49,"أجل الفتى مما يؤمل أسرع","https://www.aldiwan.net/poem62149.html","الكامل"],[49,"حيل البلى تأتي على المحتال","https://www.aldiwan.net/poem63053.html","الكامل"],[80,"جاءتك أولاد الوجيه ولاحق","https://www.aldiwan.net/poem31363.html","الكامل"],[74,"جرر ملاءة كل يوم شامس","https://www.aldiwan.net/poem12971.html","الكامل"],[74,"أمقام وصل أم مقام فراق","https://www.aldiwan.net/poem13193.html","الكامل"],[105,"بعد التحية والكرامة كلها","https://www.aldiwan.net/poem43109.html","الكامل"],[102,"جزت بالحي في العشي فهبت","https://www.aldiwan.net/poem33098.html","الخفيف"],[75,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[7,"أمن آل مية رائح أو مغتد","https://www.aldiwan.net/poem2002.html","الكامل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140908",""],[7,"مِنَ آلِ مَيّة َ رائحٌ، أو مُغْتَدِ،","https://www.poetsgate.com/ViewPoem.aspx?id=17556",""],[85,"أَمسِ انقضى ، واليومُ مِرْقاة ُ الغدِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9642&r=&rc=132",""],[91,"الفاتحة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67968&r=&rc=246",""],[116,"رب دار بالغضا طال بلاها","https://www.aldiwan.net/poem40433.html","عموديه"],[161,"ما للعلى عتب على الأيام","https://www.aldiwan.net/poem58895.html","الكامل"],[179,"مفقود","https://www.aldiwan.net/poem50689.html","الكامل"],[329,"هذه الليلة من عمر الخلود","https://www.aldiwan.net/poem55022.html","الرمل"],[329,"هتف الليل فلب الهاتفا","https://www.aldiwan.net/poem55046.html","الرمل"],[365,"أهلا بوجهك من صباح مقبل","https://www.aldiwan.net/poem60681.html","الكامل"],[365,"أرغمت آنف حاسديك بسفرة","https://www.aldiwan.net/poem60682.html","الكامل"],[407,"أما الخيال فما يغيب طروقا","https://www.aldiwan.net/poem50145.html","الكامل"],[417,"فتن الأنام بطرفه وبجيده","https://www.aldiwan.net/poem53963.html","الكامل"],[417,"شرف البصرة مولانا المشير","https://www.aldiwan.net/poem54069.html","الرمل"],[417,"شرب القوم من لماك عقارا","https://www.aldiwan.net/poem54115.html","الخفيف"],[422,"فإذا نظرت بعين عقلك لم تجد","https://www.aldiwan.net/poem46405.html","الكامل"],[442,"شهدت بإخلاصي عذول قرائحي","https://www.aldiwan.net/poem14422.html","الكامل"],[454,"لي قلة في الأصدقاء حسبتهم","https://www.aldiwan.net/poem61268.html","الكامل"],[516,"سهلت حزونة وجده وغرامه","https://www.aldiwan.net/poem12254.html","الكامل"],[552,"من كان لا ترضيه منك مودة","https://www.aldiwan.net/poem47354.html","الكامل"],[552,"إِن كان غيبك التراب الأحمر","https://www.aldiwan.net/poem47823.html","الكامل"],[552,"يا مليح الوجه لم فعلك","https://www.aldiwan.net/poem47890.html","مجزوء الرمل"],[552,"خل المدامع في المنازل تسفح","https://www.aldiwan.net/poem47902.html","الكامل"],[559,"أقبل ودع عنك الكسل","https://www.aldiwan.net/poem34217.html","مجزوء الكامل"]],"verses":[["وَإِذا طَلَبتُ بِها السَلوَّ أَبى","إِلّا النِزاعَ إِلَيكَ مُدنِفُها",0,"ف",3,0],["وإذا طَغَى فِرْعَوْنُهُ فأنا الذي","منْ ضُرِّهِ وأذاهُ عُذْتُ بموسَى",1,"س",2,0],["وَإِذا طَلَبتَ إِلى كَريمٍ حاجَةً","فَلِقاؤُهُ يَكفيكَ وَالتَسليمُ",2,"م",1,0],["وَإِذا طَلَبتَ إِلى لَئيمٍ حاجَةً","فَأَلِحَّ في رِفقٍ وَأَنتَ مُديمُ",2,"م",1,0],["وَإِذا طَلَبتَ مِنَ الحَوائِجِ حاجَةً","فادعُ الإِلَهَ وَأَحسِنِ الأَعمالا",3,"ل",2,1],["وإذا طاشت الحلوم بيوم","فيه فارقتنا فماذا نقول",4,"ل",1,0],["وَإِذا طَلَبتَ مَعَ الصَبابَةِ لَذَّةً","فَلَقَد طَلبَتَ الضائِعَ المَوجودا",5,"د",2,0],["وَإِذا طَلَبتُ عَظيمةً فمفاتِحي","فيها العَزيمَةُ وَالسِنانُ السمهَري",6,"ي",1,0],["وَإِذا طَعِمتَ مِنَ الخَلِيَّةِ شَهدَها","فَاِشهَد لِقائِدِها وَلِلمُتَجَنِّدِ",7,"د",1,0],["وَإِذا طَما البَحرُ المُحيطُ فَقُل لَهُ","دَع ذا فَإِنَّكَ عاجِزٌ عَن حالِهِ",8,"ل",2,0],["وَإِذا طَلَبتُ رِضا الأَميرِ بِشُربِها","وَأَخَذتُها فَلَقَد تَرَكتُ الأَحرَما",9,"م",2,0],["وإذا طال كالسحا","ب والكنار إن قطر",10,"ر",1,0],["وإِذا طغَى بحرُ الزِماع فما لهُ","إِلّا القِلاصَ اليعملاتِ سَفِينُ",11,"ن",1,0],["وإِذا طفحتُ على الفلا بركائبي","فشهودُهنَّ على العَلاء مقانعُ",12,"ع",1,0],["وإِذا طرحتُ على جنابكَ أنْسُعي","فجناكَ معسولٌ وبشرُكَ رائِعُ",12,"ع",1,0],["وإِذا طويتُ هواكِ عنهم نَمَّ بي","وَجْدٌ يدلُّ على لسانٍ حامدِ",13,"د",1,0],["وَإِذا طَلَبتَ الفَيءَ طيرَ بِقائِمٍ","مِمَّن تُطالِبُهُ وَقيمَ بِقاعِدِ",14,"د",1,0],["وَإِذا طَلَعنَ مِنَ الرَفيفِ فَإِنَّنا","خُلَقاءُ أَن نَدَعَ العِراقَ وَنَهجُرا",15,"ر",2,0],["وَإِذا طُهَيَّةُ مِن وَرائي أَصبَحَت","أَجَمُ الرِماحِ عَلَيهِمُ يَتَزَعزَعُ",16,"ع",1,0],["وإذا طمى بحرُ الكَريهَةِ خاضَه","فأماتَ مَنْ عاداه فيه غَريقا",17,"ق",2,0],["وإذا طَمَى في البَرِّ بحرُ وغىً","لا شَئَ إلا السَّيفَ مَعبَرُه",18,"ر",2,0],["وَإِذا طَمِعتَ كُسيتَ ثَوبَ مَذَلَّةٍ","فَلَقَد كُسِي ثَوبَ المَذَلَةِ أَشعَبُ",19,"ب",1,0],["وَإِذا طَلَبتَ فَلا إِلى مُتَضايِقٍ","مَن ضاقَ عَنكَ فَرِزقُ رَبِّكَ أَوسَعُ",20,"ع",1,0],["وَإِذا طَمِعتَ لَبِستَ ثَوبَ مَذَلَّةٍ","إِنَّ المَطامِعَ مَعدَنُ الإِذلالِ",21,"ل",1,0],["وإِذا طَرَقت به انتَهى بكَ غايَة","أبداً تشقّ على الخيال الطارقِ",22,"ق",1,0],["وَإِذا طَعِمتَ فَمِن قَنيصٍ فِلذَةً","وَإِذا شَرِبتَ فَمِن غَمامٍ راجِسِ",23,"س",1,0],["وَإِذا طَرَقتَ جَنابَ قُرطُبَةٍ فَقِف","فَكَفاكَ مِن ناسٍ وَمِن آفاقِ",24,"ق",1,0],["وإِذا طَلَبتَ رِضى النُفوسِ بِغَيرِهِ","جَمَحَ الإِباءُ بِها وَعَزَّ المَطلَبُ",25,"ب",1,0],["وإذا طيّبٌ جَنيٌّ من الرّم","مان مثل النُّهودِ لو هي تُجنى",26,"ن",2,0],["وإذا طَوَيْتَ على الرِّضَى أهدى إلى","شمس الظَّهيرَةِ عارضاً مصْقولا",27,"ل",2,0],["وَإِذا طَعَنتَ طَعَنتَ في مُشَهدِفٍ","رابي المَجَسَّةِ بِالعَبيرِ مُقَرمَدِ",28,"د",1,0],["وإذا طلبت رضى الأمير بشربها","وأخذتها فلقد تركت الأحرما",29,"م",2,0],["وإذا طَعَنتَ طعنتَ في مستهدفٍ","، رابي الَمجَسّة ِ، بالعَبيرِ مُقَرْمَدِ",30,"د",1,0],["وإذا طمعتَ من الخليَّة ِ شهدها","فاشهَدْ لقائدها وللمُتجَنّد",31,"د",1,0],["وإذا طفت بكرمي زدته خصبا وأمنا","قد سكبت الخمر كي تشرب ، فاشرب مطمئنّا",32,"ن",2,0],["واذا طالت لها عن طمع","كف جان قطعت دون جناها",33,"ا",3,0],["وإذا طلعتَ على العدا في موكبٍ","ورأوا نجوماً حول بَدرٍ تَمامِ",34,"م",1,0],["وإذا طَوَتْكَ غَياهِبٌ في جُبِّها","لَمْ تُفْتَقَدْ قَدَرٌ قَضى أنْ تَفْتَقِدْ",35,"د",1,0],["وإذا طابَ لكفّيَ السجود","في سماءِ الصدر جنّا لعبا",36,"ب",2,0],["وإذا طاف بجفنيه خيالي","راجيا ساعة قرب ووصال",37,"ل",1,0],["وإذا طلبتُ النّصْرَ يومَ حفيظةٍ","جَرَّدْتَ دوني كُلَّ عَضْبٍ مِصْقَل",38,"ل",1,0],["وإذا طلَبْتُ النّصرَ يومَ حفيظةٍ","جَرّدْتَ دوني كُلَّ عَضْبٍ مِفْصَل",39,"ل",1,0],["وَإِذا طَما بَحرُ الكَريهة خاضَهُ","وَأَماتَ مَن عاداهُ فيهِ غَريقا",40,"ق",2,0],["وإذا طَلَعتْ على الأحبَّة بعدها","فمُوفَّقٌ كلُّ إلى مقصوده",41,"د",2,0],["وإذا طاشت رجال لم يَطِشْ","أينَ رضوى من علاه وثبير",42,"ر",1,0],["وإذا طاولتك أبواعُ قوم","أصبحتْ عن مدى علاك قصارا",43,"ر",2,0],["وإذا طلَبت حقيقة من غيرهِ","فبذيلِ جهلِك لا تزالُ معثَّرا",44,"ر",2,0],["وَإِذا طلبى عَلى الفؤاد شهادة","فاشهد فؤادك فهو أَخلص ناصح",45,"ح",1,0],["وإذا طعنت من الذي أحببته","فعليّ وزري لا عرفت تندمي",46,"م",2,0],["وإذا طرا خطب فليس معول","إلا على تشميره وقيامه",47,"م",2,0],["وإذا طلبتَ مودّةً ترضى بها","لم تُلْفِها من بين كلّ فريقِ",48,"ق",1,0],["وإذا طَوَتْ عنك العُداةُ كَنَهْوَراً","وافى ترابَك بالعشيّ كنَهْوَرُ",49,"ر",1,0],["وإذا طاوعتُ أمر ال","حُبِّ عاصيتُ نصيحي",50,"ح",2,0],["وإذا طلبتُ لِيَ الإخاءَ فليس لِي","مِن بَينهمْ إلّا السَّؤُولُ الأرسخُ",51,"خ",1,0],["وإذا طردت فعد إلى","ما كنت تطلبه وسل",52,"ل",1,0]]}