{"poems":[[55,"قضت المنازل يوم كاظمة","https://www.aldiwan.net/poem29962.html","الكامل"],[79,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[44,"حسدوا الفتى إذ لم ينالوا سعيه","https://www.aldiwan.net/poem50221.html","الكامل"],[44,"وإذا طلبت من الحوائج حاجة","https://www.aldiwan.net/poem50270.html","الكامل"],[90,"هي دنيا بقاؤها مستحيل","https://www.aldiwan.net/poem45050.html","الخفيف"],[93,"ليت الذي خلق العيون السودا","https://www.aldiwan.net/poem8816.html","عموديه"],[80,"وإذا توعرت المسالك لم ارد","https://www.aldiwan.net/poem14262.html","الكامل"],[87,"أمس انقضى واليوم مرقاة الغد","https://www.aldiwan.net/poem8102.html","الكامل"],[45,"لا الحلم جاد به ولا بمثاله","https://www.aldiwan.net/poem9931.html","الكامل"],[45,"حييت من قسم وأفدي المقسما","https://www.aldiwan.net/poem10564.html","الكامل"],[64,"قل لمن يطلب الحجر","https://www.aldiwan.net/poem52140.html","مجزوء الخفيف"],[64,"نظري إلى لمع الوميض حنين","https://www.aldiwan.net/poem52265.html","الكامل"],[64,"إن العيون إذا نطقت تخاوصت","https://www.aldiwan.net/poem52341.html","الكامل"],[64,"إني لأذكركم وقد بلغ الظما","https://www.aldiwan.net/poem52443.html","الكامل"],[47,"قل للخيال إذا أردت فعاود","https://www.aldiwan.net/poem63447.html","الكامل"],[47,"لله عهد سويقة ما أنضرا","https://www.aldiwan.net/poem63603.html","الكامل"],[30,"بين إذا نزلت عليك مجاشع","https://www.aldiwan.net/poem5311.html","الكامل"],[63,"أما الخيال فما يغب طروقا","https://www.aldiwan.net/poem51534.html","الكامل"],[63,"غضبان ينساني وأذكره","https://www.aldiwan.net/poem51669.html","أحذ الكامل"],[60,"صرمت حبالك بعد وصلك زينب","https://www.aldiwan.net/poem31129.html","الكامل"],[51,"أجل الفتى مما يؤمل أسرع","https://www.aldiwan.net/poem62149.html","الكامل"],[51,"حيل البلى تأتي على المحتال","https://www.aldiwan.net/poem63053.html","الكامل"],[82,"جاءتك أولاد الوجيه ولاحق","https://www.aldiwan.net/poem31363.html","الكامل"],[76,"جرر ملاءة كل يوم شامس","https://www.aldiwan.net/poem12971.html","الكامل"],[76,"أمقام وصل أم مقام فراق","https://www.aldiwan.net/poem13193.html","الكامل"],[107,"بعد التحية والكرامة كلها","https://www.aldiwan.net/poem43109.html","الكامل"],[104,"جزت بالحي في العشي فهبت","https://www.aldiwan.net/poem33098.html","الخفيف"],[77,"أتظن راحا في الشمال شمولا","https://www.aldiwan.net/poem69049.html","الكامل"],[7,"أمن آل مية رائح أو مغتد","https://www.aldiwan.net/poem2002.html","الكامل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140908",""],[7,"مِنَ آلِ مَيّة َ رائحٌ، أو مُغْتَدِ،","https://www.poetsgate.com/ViewPoem.aspx?id=17556",""],[87,"أَمسِ انقضى ، واليومُ مِرْقاة ُ الغدِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9642&r=&rc=132",""],[93,"الفاتحة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67968&r=&rc=246",""],[119,"رب دار بالغضا طال بلاها","https://www.aldiwan.net/poem40433.html","عموديه"],[164,"ما للعلى عتب على الأيام","https://www.aldiwan.net/poem58895.html","الكامل"],[182,"مفقود","https://www.aldiwan.net/poem50689.html","الكامل"],[333,"هذه الليلة من عمر الخلود","https://www.aldiwan.net/poem55022.html","الرمل"],[333,"هتف الليل فلب الهاتفا","https://www.aldiwan.net/poem55046.html","الرمل"],[369,"أهلا بوجهك من صباح مقبل","https://www.aldiwan.net/poem60681.html","الكامل"],[369,"أرغمت آنف حاسديك بسفرة","https://www.aldiwan.net/poem60682.html","الكامل"],[412,"أما الخيال فما يغيب طروقا","https://www.aldiwan.net/poem50145.html","الكامل"],[422,"فتن الأنام بطرفه وبجيده","https://www.aldiwan.net/poem53963.html","الكامل"],[422,"شرف البصرة مولانا المشير","https://www.aldiwan.net/poem54069.html","الرمل"],[422,"شرب القوم من لماك عقارا","https://www.aldiwan.net/poem54115.html","الخفيف"],[427,"فإذا نظرت بعين عقلك لم تجد","https://www.aldiwan.net/poem46405.html","الكامل"],[447,"شهدت بإخلاصي عذول قرائحي","https://www.aldiwan.net/poem14422.html","الكامل"],[458,"لي قلة في الأصدقاء حسبتهم","https://www.aldiwan.net/poem61268.html","الكامل"],[520,"سهلت حزونة وجده وغرامه","https://www.aldiwan.net/poem12254.html","الكامل"],[556,"من كان لا ترضيه منك مودة","https://www.aldiwan.net/poem47354.html","الكامل"],[556,"إِن كان غيبك التراب الأحمر","https://www.aldiwan.net/poem47823.html","الكامل"],[556,"يا مليح الوجه لم فعلك","https://www.aldiwan.net/poem47890.html","مجزوء الرمل"],[556,"خل المدامع في المنازل تسفح","https://www.aldiwan.net/poem47902.html","الكامل"],[563,"أقبل ودع عنك الكسل","https://www.aldiwan.net/poem34217.html","مجزوء الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138377",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122595","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48817","الخفيف"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104542","الكامل"],[995,"","https://poetry.dctabudhabi.ae/diwan/poem/96300","الكامل"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119247","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119863","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119932","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96760","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72329","الكامل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35368","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136275","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136200","الخفيف"],[1433,"","https://poetry.dctabudhabi.ae/diwan/poem/90727","الوافر"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49940","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48986","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48942","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48911","الخفيف"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87866","الكامل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49592","الخفيف"],[1890,"","https://poetry.dctabudhabi.ae/diwan/poem/89680","الكامل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124736","الرمل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124724","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124738","الرمل"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76676","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69378","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93928","الكامل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205438","الخفيف"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74336","الرمل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112555","الرمل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62931","الكامل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103865","الكامل"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3713,"","https://poetry.dctabudhabi.ae/diwan/poem/144989","الكامل"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199030","الرجز"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59514","الكامل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95370","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103003","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103015","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90957","الكامل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66182","الكامل"],[5145,"أعوز الصبر فهل لي من طريق","https://www.poetsgate.com/ViewPoem.aspx?id=108199",""],[5183,"نَبْعُ الفضلِ","https://www.poetsgate.com/ViewPoem.aspx?id=186454",""],[5364,"بلاد الشام تنخاكم","https://www.poetsgate.com/ViewPoem.aspx?id=177160",""],[5431,"الحاكم الجائر","https://www.poetsgate.com/ViewPoem.aspx?id=183066",""],[5582,"صَدَحَ الحَمامُ عَلَى الفُنُونِ وَناحَا","https://www.poetsgate.com/ViewPoem.aspx?id=186829",""],[5638,"عيد أمة هانت","https://www.poetsgate.com/ViewPoem.aspx?id=198128",""],[5848,"عيضه","https://www.poetsgate.com/ViewPoem.aspx?id=50584",""],[5913,"الحنين المكتَّمُ المفضوحُ","https://www.poetsgate.com/ViewPoem.aspx?id=183248",""],[6024,"الأماني","https://www.poetsgate.com/ViewPoem.aspx?id=186351",""],[6069,"خير ما أصبحت مخلوع العذار","https://www.poetsgate.com/ViewPoem.aspx?id=105669",""],[6075,"بسمة الذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=200329",""],[6145,"من نحن ؟","https://www.poetsgate.com/ViewPoem.aspx?id=7794",""],[5126,"الطائر الغريب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87826&r=&rc=41",""]],"verses":[["وَإِذا طَلَبتُ بِها السَلوَّ أَبى","إِلّا النِزاعَ إِلَيكَ مُدنِفُها",0,"ف",3,0],["وإذا طَغَى فِرْعَوْنُهُ فأنا الذي","منْ ضُرِّهِ وأذاهُ عُذْتُ بموسَى",1,"س",2,0],["وَإِذا طَلَبتَ إِلى كَريمٍ حاجَةً","فَلِقاؤُهُ يَكفيكَ وَالتَسليمُ",2,"م",1,0],["وَإِذا طَلَبتَ إِلى لَئيمٍ حاجَةً","فَأَلِحَّ في رِفقٍ وَأَنتَ مُديمُ",2,"م",1,0],["وَإِذا طَلَبتَ مِنَ الحَوائِجِ حاجَةً","فادعُ الإِلَهَ وَأَحسِنِ الأَعمالا",3,"ل",2,1],["وإذا طاشت الحلوم بيوم","فيه فارقتنا فماذا نقول",4,"ل",1,0],["وَإِذا طَلَبتَ مَعَ الصَبابَةِ لَذَّةً","فَلَقَد طَلبَتَ الضائِعَ المَوجودا",5,"د",2,0],["وَإِذا طَلَبتُ عَظيمةً فمفاتِحي","فيها العَزيمَةُ وَالسِنانُ السمهَري",6,"ي",1,0],["وَإِذا طَعِمتَ مِنَ الخَلِيَّةِ شَهدَها","فَاِشهَد لِقائِدِها وَلِلمُتَجَنِّدِ",7,"د",1,0],["وَإِذا طَما البَحرُ المُحيطُ فَقُل لَهُ","دَع ذا فَإِنَّكَ عاجِزٌ عَن حالِهِ",8,"ل",2,0],["وَإِذا طَلَبتُ رِضا الأَميرِ بِشُربِها","وَأَخَذتُها فَلَقَد تَرَكتُ الأَحرَما",9,"م",2,0],["وإذا طال كالسحا","ب والكنار إن قطر",10,"ر",1,0],["وإِذا طغَى بحرُ الزِماع فما لهُ","إِلّا القِلاصَ اليعملاتِ سَفِينُ",11,"ن",1,0],["وإِذا طفحتُ على الفلا بركائبي","فشهودُهنَّ على العَلاء مقانعُ",12,"ع",1,0],["وإِذا طرحتُ على جنابكَ أنْسُعي","فجناكَ معسولٌ وبشرُكَ رائِعُ",12,"ع",1,0],["وإِذا طويتُ هواكِ عنهم نَمَّ بي","وَجْدٌ يدلُّ على لسانٍ حامدِ",13,"د",1,0],["وَإِذا طَلَبتَ الفَيءَ طيرَ بِقائِمٍ","مِمَّن تُطالِبُهُ وَقيمَ بِقاعِدِ",14,"د",1,0],["وَإِذا طَلَعنَ مِنَ الرَفيفِ فَإِنَّنا","خُلَقاءُ أَن نَدَعَ العِراقَ وَنَهجُرا",15,"ر",2,0],["وَإِذا طُهَيَّةُ مِن وَرائي أَصبَحَت","أَجَمُ الرِماحِ عَلَيهِمُ يَتَزَعزَعُ",16,"ع",1,0],["وإذا طمى بحرُ الكَريهَةِ خاضَه","فأماتَ مَنْ عاداه فيه غَريقا",17,"ق",2,0],["وإذا طَمَى في البَرِّ بحرُ وغىً","لا شَئَ إلا السَّيفَ مَعبَرُه",18,"ر",2,0],["وَإِذا طَمِعتَ كُسيتَ ثَوبَ مَذَلَّةٍ","فَلَقَد كُسِي ثَوبَ المَذَلَةِ أَشعَبُ",19,"ب",1,0],["وَإِذا طَلَبتَ فَلا إِلى مُتَضايِقٍ","مَن ضاقَ عَنكَ فَرِزقُ رَبِّكَ أَوسَعُ",20,"ع",1,0],["وَإِذا طَمِعتَ لَبِستَ ثَوبَ مَذَلَّةٍ","إِنَّ المَطامِعَ مَعدَنُ الإِذلالِ",21,"ل",1,0],["وإِذا طَرَقت به انتَهى بكَ غايَة","أبداً تشقّ على الخيال الطارقِ",22,"ق",1,0],["وَإِذا طَعِمتَ فَمِن قَنيصٍ فِلذَةً","وَإِذا شَرِبتَ فَمِن غَمامٍ راجِسِ",23,"س",1,0],["وَإِذا طَرَقتَ جَنابَ قُرطُبَةٍ فَقِف","فَكَفاكَ مِن ناسٍ وَمِن آفاقِ",24,"ق",1,0],["وإِذا طَلَبتَ رِضى النُفوسِ بِغَيرِهِ","جَمَحَ الإِباءُ بِها وَعَزَّ المَطلَبُ",25,"ب",1,0],["وإذا طيّبٌ جَنيٌّ من الرّم","مان مثل النُّهودِ لو هي تُجنى",26,"ن",2,0],["وإذا طَوَيْتَ على الرِّضَى أهدى إلى","شمس الظَّهيرَةِ عارضاً مصْقولا",27,"ل",2,0],["وَإِذا طَعَنتَ طَعَنتَ في مُشَهدِفٍ","رابي المَجَسَّةِ بِالعَبيرِ مُقَرمَدِ",28,"د",1,0],["وإذا طلبت رضى الأمير بشربها","وأخذتها فلقد تركت الأحرما",29,"م",2,0],["وإذا طَعَنتَ طعنتَ في مستهدفٍ","، رابي الَمجَسّة ِ، بالعَبيرِ مُقَرْمَدِ",30,"د",1,0],["وإذا طمعتَ من الخليَّة ِ شهدها","فاشهَدْ لقائدها وللمُتجَنّد",31,"د",1,0],["وإذا طفت بكرمي زدته خصبا وأمنا","قد سكبت الخمر كي تشرب ، فاشرب مطمئنّا",32,"ن",2,0],["واذا طالت لها عن طمع","كف جان قطعت دون جناها",33,"ا",3,0],["وإذا طلعتَ على العدا في موكبٍ","ورأوا نجوماً حول بَدرٍ تَمامِ",34,"م",1,0],["وإذا طَوَتْكَ غَياهِبٌ في جُبِّها","لَمْ تُفْتَقَدْ قَدَرٌ قَضى أنْ تَفْتَقِدْ",35,"د",1,0],["وإذا طابَ لكفّيَ السجود","في سماءِ الصدر جنّا لعبا",36,"ب",2,0],["وإذا طاف بجفنيه خيالي","راجيا ساعة قرب ووصال",37,"ل",1,0],["وإذا طلبتُ النّصْرَ يومَ حفيظةٍ","جَرَّدْتَ دوني كُلَّ عَضْبٍ مِصْقَل",38,"ل",1,0],["وإذا طلَبْتُ النّصرَ يومَ حفيظةٍ","جَرّدْتَ دوني كُلَّ عَضْبٍ مِفْصَل",39,"ل",1,0],["وَإِذا طَما بَحرُ الكَريهة خاضَهُ","وَأَماتَ مَن عاداهُ فيهِ غَريقا",40,"ق",2,0],["وإذا طَلَعتْ على الأحبَّة بعدها","فمُوفَّقٌ كلُّ إلى مقصوده",41,"د",2,0],["وإذا طاشت رجال لم يَطِشْ","أينَ رضوى من علاه وثبير",42,"ر",1,0],["وإذا طاولتك أبواعُ قوم","أصبحتْ عن مدى علاك قصارا",43,"ر",2,0],["وإذا طلَبت حقيقة من غيرهِ","فبذيلِ جهلِك لا تزالُ معثَّرا",44,"ر",2,0],["وَإِذا طلبى عَلى الفؤاد شهادة","فاشهد فؤادك فهو أَخلص ناصح",45,"ح",1,0],["وإذا طعنت من الذي أحببته","فعليّ وزري لا عرفت تندمي",46,"م",2,0],["وإذا طرا خطب فليس معول","إلا على تشميره وقيامه",47,"م",2,0],["وإذا طلبتَ مودّةً ترضى بها","لم تُلْفِها من بين كلّ فريقِ",48,"ق",1,0],["وإذا طَوَتْ عنك العُداةُ كَنَهْوَراً","وافى ترابَك بالعشيّ كنَهْوَرُ",49,"ر",1,0],["وإذا طاوعتُ أمر ال","حُبِّ عاصيتُ نصيحي",50,"ح",2,0],["وإذا طلبتُ لِيَ الإخاءَ فليس لِي","مِن بَينهمْ إلّا السَّؤُولُ الأرسخُ",51,"خ",1,0],["وإذا طردت فعد إلى","ما كنت تطلبه وسل",52,"ل",1,0],["وإذا طلائع بشرهم لاحت لنا","أشجاننا تمسي فلولا تهزم",53,"م",1,0],["وإذا طَلبتَ الرزقَ فاطلب خيرَه","مِن كفِّ خالِده ومِن صَيّادِه",54,"د",2,0],["وإذا طالت الطريق فأنتم","في أمانٍ من أن تضيق وتلوى",55,"و",2,0],["واذا طَغَت وبَغَت بما خوَّلتَها","أقبلتُ نحوكَ خاضعاً أَستغفرُ",56,"ر",1,0],["وإذا طَلبتُ ثوابَ ما آتيتُهُ","فكفى بذاك لسائلي تذكيرا",57,"ر",2,0],["واذا طعنت فلا تكلف طاقتي","عند الرحيل مطية وجماء",58,"ا",2,0],["وإذا طلبت له الشبيه وجدته","فذاً ونعماه الجزيلة توأما",59,"م",2,0],["وإذا طمى بحر الهمو","م جعلت فيه الجسر جسرة",60,"ر",2,0],["وإذا طعنتَ طعنتَ في مستهدف","راني المجسَّة بالعبير مقرمدِ",61,"د",1,0],["وإذا طما بحر","المخاوف كان ودكم سفينا",62,"ن",2,0],["وَإِذا طَلَعتَ بِأَوجِها قَمَرَ العُلى","لا تَرتَضي غَيرَ النُجومِ جَليسا",63,"س",2,0],["وإذا طمعت بان تنال المرتجى","فاعقل قلوصك في حمى الاجلال",64,"ل",1,0],["وإذا طار علمها بهداها","زاد في حكمها القليل الحقير",65,"ر",1,0],["وإذا طرفنَ طرفنَ عن حدَقِ المها","وَفضلنهُنَّ محاجرا وجُفونا",66,"ن",2,0],["وإذا طاولَ الملوكَ نماه","شَرَفُ المنصِبِ اللُّبابِ الصُراحِ",67,"ح",1,0],["وإذا طلبتَ علىً فإنَّكَ موردٌ","للنفسِ مَوْرِدَ حلبةٍ وطِعان",68,"ن",1,0],["وإذا طرقتُ بلا حجاب دارَهم","خفّوا إليّ بسترةٍ وخِمار",69,"ر",1,0],["وإذا طرتَ من يكون كفيلاً","برجوعٍ مَنْ يكفلُ الاطيارا",70,"ر",2,0],["وإذا طَغَت بَطَراً مَشَاعِرُ سُنَّة","فيكُم فَأوعَزَ لِلفُجُورِ قواكُمُ",71,"م",1,0],["وإذا طابتِ الفروعُ وطالَتْ","كَفَتِ البحثَ عن زَكَاءِ الأروم",72,"م",1,0],["وَاِذا طَلَبت العِلمَ فَاِعلَم اِنَّهُ","حَمل فَاِبصِر اِي شَيء تَحمل",73,"ل",1,1],["وإذا طلقها واحدةً","باكتتامٍ أن تراه ضرعا",74,"ع",2,0],["وإذا طلقها واحدةً ثالثة","أدركته بعد خلعٍ تبعا",74,"ع",2,0],["وإذا طلقها واحدة فرأى","أو مس منها موضعا",74,"ع",2,0],["وإذا طوفت فحاضت ولم تركع","وقد جد أهلها ارتحالا",75,"ل",2,0],["وإذا طلقها حلت إذا","هي حاضت حيضتين لم تزد",76,"د",1,0],["وإذا طلقها اعتدت على","حملها والحيض حولا منفرد",76,"د",1,0],["وإذا طلق يوماً أمةً","فاشتراها لم يطأها إلى الأبد",76,"د",1,0],["وإذا طلق يوماً حرةً","ثم أخفاهُ وواراه اللحد",76,"د",1,0],["واذا طمى للذنب لم يسمع به","الا الدعاء يعان بالتأمين",77,"ن",1,0],["وَإِذا طَلَبتَ مِنَ الزَمانِ طِلابَةً","بِالسَيفِ لَم يَعذُب عَلَيكَ طِلابُ",78,"ب",1,0],["وإذا طلبت الوصل منه صدني","ونضامن الأجفان عضباً مرهفا",79,"ف",2,0],["وإذا طال في البلاد اغترابي","في سبيل العلا فأنت قصاري",80,"ر",2,0],["وَإِذا طالَ زَماناً","بِكُم طالَ قِواما",81,"م",2,0],["وإذا طالعت يوما معشرا","يتجافى بي ولي فيه الصحاب",82,"ب",1,0],["واذا طلبتَ بِضَحْلِهِ تَيَّارَهُ","أَوقعتَ رجلَكَ في العميقِ الطَّامي",83,"م",2,0],["وإذا طويل الهجر ما","معه من السلوان بد",84,"د",1,0],["وَإِذا طَلَبتَ طَبائِعاً مُستَسلِماً","فاِطلُب شواظَ النار في الغَدرانِ",85,"ن",1,0],["وإذا طلبتَ إلى كريم حاجة","فاصبر، ولا تكُ للِمِطال مَلُولاَ",86,"ل",2,1],["وإذ أطال القوم أسرى القدر","نحوهم خسفاً وما إن شعروا",87,"ر",3,0],["وإذا طعنتَ فألقِ نفسكَ عندها","حتى يثورَ بطعنها الخُرصانُ",88,"ن",1,0],["واذا طغى يا جوج مارقة","فالسد اتت ومالك القطر",89,"ر",1,0],["وإذا طلبت منىً فكن كمحمّد","يجد الجبالَ من الأمور خيالا",90,"ل",2,0],["وإذا طلبت منىً ولم أظفر بها","فالعضب قد ينبو نبو كهام",91,"م",1,0],["وإذا طمى بحر الخطوب عليك فال","تسليم فيه للسلامة قارب",92,"ب",1,0],["واذا طَغَى سَيْلُ العِدا في امَّةٍ","فَهْو الحَكِيمُ اذا غَوَى الحُكَماءُ",93,"ا",2,0],["وإذا طالعتها ارتبست فا","م تتحقق: أحريق أم رحيق",94,"ق",1,0],["وإذا طغى بك للزمان عِنانه","فاركب عِنانك إنه عداء",95,"ا",2,0],["واذا طال الصبر نصبر مدام ان الصبر مفتاح","ونشكي ضعفنا للّي .. عليم بكل حالتنا",96,"ن",2,0],["وإذا طلبت من الغزاة معونة","فاعلم بأنك داعمٌ للقاتلِ",97,"ل",1,0],["وَإِذا طَلَبْتَ مِنَ المُلُوكِ مَواهِباً","لا تَطْلُبَنْ إِلاَّ المَلِيكَ فَلاحَا",98,"ح",2,0],["وَإِذَا طَوَاغِيتُ الْوَرَى أُضْحِيَّةً","سَيَعُودُ عُمْرِي لِلصِّبَا وَالدِّينُ",99,"ن",1,0],["واذا طرى في لحظة البعد شوقي","باقول دين ولازم آسدد الدين",100,"ن",1,0],["وإذا طال ليلُ صبٍ كئيبٌ","مزق الليلَ فجرنا الملموح",101,"ح",1,0],["وإذا طمعتم في نفائس نيلهم","فأنا الذي فيما لديه أطمع",102,"ع",1,0],["وإذا طاف بها تحسبه","بدر ليلٍ حاملاً شمس نهار",103,"ر",1,0],["وَإِذَا طَيْفُكِ يَشْدُو بَاسِمًا","إِنَّ فِي الذِّكْرَى لِقَاءً مُدَّخَرْ",104,"ر",1,0],["وإذا طمى جرحُ الزمانِ فإننا","نحنُ الشّفاءُ لجُرحِهِ والبَلْسَمُ",105,"م",1,0],["وإذا طُفتُ حول غصنٍ أحييه","رمى زهره وأبدى الشُحوبَا",106,"ب",2,0]]}