x?id=194861",""],[5376,"يا ليتني قد طوتني البيضُ والسودُ","https://www.poetsgate.com/ViewPoem.aspx?id=196892",""],[5431,"لليمن الحبيب في العيد...","https://www.poetsgate.com/ViewPoem.aspx?id=191118",""],[5431,"ماكيافيلي والحصاد...","https://www.poetsgate.com/ViewPoem.aspx?id=205414",""],[5442,"حتام أبطائي بيوم متابي","https://www.poetsgate.com/ViewPoem.aspx?id=114775",""],[5444,"رسالةٌ إلى نجم آفل","https://www.poetsgate.com/ViewPoem.aspx?id=205071",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[5691,"وفاق","https://www.poetsgate.com/ViewPoem.aspx?id=206444",""],[5725,"اخفى الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=197618",""],[5725,"حينما شد للمفاتن عضدا","https://www.poetsgate.com/ViewPoem.aspx?id=210589",""],[5776,"أطوارُ ......عنكبوت الهولوكوست","https://www.poetsgate.com/ViewPoem.aspx?id=199338",""],[5781,"فاكهةُ الشِّتاءِ ومُتعةُ الليل","https://www.poetsgate.com/ViewPoem.aspx?id=185318",""],[5841,"شهريار وشهرزادي","https://www.poetsgate.com/ViewPoem.aspx?id=34907",""],[5956,"ما ذَلَّ حكمٌ إنْ يقربْ ناقدا","https://www.poetsgate.com/ViewPoem.aspx?id=184127",""],[5956,"الله بارك يا تراثُ زواجكا","https://www.poetsgate.com/ViewPoem.aspx?id=192378",""],[5956,"مِزاحٌ مع ابنتي آنَ النحيلة","https://www.poetsgate.com/ViewPoem.aspx?id=203443",""],[6031,"كَفُّ الحِمَامِ وَتَرْتِ أيَّ جَوَادِ","https://www.poetsgate.com/ViewPoem.aspx?id=46281",""],[6031,"يا نَسيمَ الشَمالِ أدِّ رِسَالا","https://www.poetsgate.com/ViewPoem.aspx?id=46264",""],[6031,"بعثَتْ طَيْفَها فَزَارَ طُرُوقَا","https://www.poetsgate.com/ViewPoem.aspx?id=46276",""],[4442,"لم يمت من يعيش في جناته","https://www.poetsgate.com/ViewPoem.aspx?id=171233",""],[6089,"إني أقمتُ جدارَ نسيانٍ على حبي","https://www.poetsgate.com/ViewPoem.aspx?id=214556",""],[6093,"يَسْألُ العذولُ لِمَه","https://www.poetsgate.com/ViewPoem.aspx?id=178556",""],[6097,"عَكّارُنا","https://www.poetsgate.com/ViewPoem.aspx?id=190700",""],[6143,"ربما كنت هباء","https://www.poetsgate.com/ViewPoem.aspx?id=33256",""],[6167,"بلا ندم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85556&r=&rc=39",""],[6225,"تسرُّب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78037&r=&rc=122",""]],"verses":[["أَوسَعتَ مِن خَطَواتِهِ في مَوقِفٍ","مُتَغَلغِلٍ بِتَضايُقِ الأَقدامِ",0,"م",1,0],["أَوسَعتَهُ فَرَأى الآمالَ واسِعَةً","وَكُلُّ ساكِنِ ضيقٍ واسِعُ الأَمَلِ",1,"ل",1,0],["أَو ساطِعاتٌ أَراها","وَاللَيلُ داجٍ أَزَبُّ",2,"ب",1,0],["أَوسَعتَهُ كَرَماً فَأَوغَرَ صَدرَهُ","أَنَّ الأَقارِبَ بَعدَها لَعَقارِبُ",3,"ب",1,0],["أو سَرَقَ الشّمسُ إليها نَظرَةً","فاسْتَلَبَتْ شُعاعَها رأْدَ الضُّحى",4,"ا",1,0],["أَوسَكَتُم عَنّا فَكُنّا كَمَن أَغ","مَضَ عَيناً في جَفنِها أَقذاءُ",5,"ا",2,0],["أو سيْفُ يوسُفَ يوْم الرّوْع سالَ بهِ","نَجيعُ أعْدائهِ المحمرُّ في الزُّرَقِ",6,"ق",1,0],["أَوْ سَيِّدي دَامَ يَرَى سَيِّدِي","حَقّاً لَهُ قُمْتَ بِإيجَابِهِ",7,"ب",2,0],["أَوْسَعَ البِرَّ فِي مَعَاهِدِهِ","مِنَحاً لَمْ يُشَبْن بِالمِنَنِ",8,"ن",1,0],["أو سامت الفرس الأوائل عزّه","لتقطّعت أكتاف ذي الأكتاف",9,"ف",1,0],["أو سُرى الشيب تحت ليل شباب","مُستحير في لِمِّة سَحماءِ",10,"ا",2,0],["أوسعتُها صبراً على لؤْمِها","إذا تَقَصَّتْهُ تَطرَّفْتُهَا",11,"ت",3,0],["أوسِعْه عذراً ولُمْ مُعذِّبه","وقلْ له عن أخٍ قد اعتقدَكْ",12,"ك",1,0],["أو سِواهُ من أهلِ وُدّكَ ممَّنْ","ليس في العلمِ جارياً مجراكا",13,"ك",2,0],["أوسعَ الراغبين فضلاً كما أو","سع أهلَ العنادِ نفْياً وَقَتْلا",14,"ل",2,0],["أوسعَ الأمرين فضلاً فأتت","صور الخلق تضاهي طِيَنَه",15,"ن",2,0],["أَو سُطورٌ بِالماءِ فَوقَ الماءِ","لَو سَكَنتُم قُصورَنا بَعضَ ساعَه",16,"ه",1,0],["أَوسَعتَنا يَومَ الوَداعِ إِهانَةً","أَدَبٌ لَعَمرُكَ لا يُصيبُ مَثيلا",17,"ل",2,0],["أَو سَخا بِالمالِ أَو قَد","دَمَ جاهاً وَاِنتِسابا",18,"ب",2,0],["أوسعتَهُ حِلْماً فأهلكَهُ","ولربما يُستوخَمُ الضَّرَبُ",19,"ب",1,0],["أَوسَعُ العالَمينَ ساحَةَ مَعرو","فٍ وَأَعلاهُمُ بَنِيَّةَ مَجدِ",20,"د",1,0],["أَو سارَ في إِقدامِكُم وَسَماحِكُم","شِعري فَتِلكَ مَناقِبي وَمآثِري",21,"ر",2,0],["أُوسِعُ الدَّهَر مذ تعتَّبْتَ ذَمّاً","بعدَما كنتُ أُوسعُ الدَّهرَ حَمْدا",22,"د",2,0],["أوسع غِناكَ وَكن لِفَقرِكَ صائِناً","يَضني حَشاكَ وَأَنتَ لا تُشفيهِ",23,"ي",2,0],["أَو سِهاماً نَصلُها ذَهَبٌ","لِسِوى الظَلماءِ لَم تُصِبِ",24,"ب",1,0],["أَوسَعتَ لِلعَبدِ مِن هِباتِكَ ما","أَضاقَ عَن حَملِ بَعضِهِ عَطَنَه",25,"ن",2,0],["أو ساجعٍ تحسَبُ ألحانَهُ","مِن كُلّ نَدمانٍ عَلَيهِ اقتراح",26,"ح",1,0],["أَوسَعتَهُم ضَرباً تُهَدُّ بِهِ الكُلى","وَيَخِفُّ مِنهُ المَرءُ وَهوَ رَكينُ",27,"ن",1,0],["أَو ساطِعٍ في حُمرَةٍ فَكَأَنَّ ما","يَدنو إِلَيهِ مِنَ الهَواءِ مُعَصفَرُ",28,"ر",1,0],["أَو سائلي تُخبَري إِن كُنتِ جاهِلَةً","هَل يَنقُضُ الحُرُّ عَهداً بَعدَ تَوكِيدِ",29,"د",1,0],["أوْسَعْتَ عبدَك من أيادٍ شُكرُهَا","حظّانِ من دنيا الشَّكور ودينه",30,"ن",2,0],["أَو سَرَّكُم إِذ لَحِقنا غَيرَ فَخرِكُمُ","بِأَنَّكُم بَينَ ظَهرَي دِجلَةَ السَمَكُ",31,"ك",1,0],["أَوْسَعنا إحسانُه وفضلُهُ","وعَزَّ أَن يكونَ شيءٌ مثلُهُ",32,"ه",1,0],["أَو سلوة في تأتّي","ها للهموم انقشاع",33,"ع",1,0],["أوسعني المؤمنون سبا","فكان بي يحسن السكوت",34,"ت",1,0],["أَوْسَعْتَ مِلْكَكَ تَعْزِيزاً وَمَكْرُمَةً","بَيْنَ الفِدَى وَالنَّدَى بِالبَأْسِ وَالنَّالِ",35,"ل",1,0],["أَوْ سِيرَةٍ سِيقَتْ مَسَاقَ رِوَايَةٍ","لِمَوَاقِفِ التَّمِثيلِ وَالإلقَاءِ",36,"ا",2,0],["أَوْ سَمَاءً عَرُوسُكَ الشَّمْسُ فِيهَا","وَالنُّجُومُ السُّعُودُ وَالأَوْلاَدُ",37,"د",1,0],["أَوْسَعْتَ يَا فَاروقُ شعبَكَ أَنْعُمَاً","في ظِلِّ غَيْرِكَ لَمْ تُتَحْ لِشُعُوبِ",38,"ب",1,0],["أَوْ سِكْرِهَا وَالأَجْرُ ضَاعَ بِهِ","زُهَّادُ زَحْلَةَ غَيْرُ زهَّادِ",39,"د",1,0],["أو سال جرحٌ من جبين مجاهدِ","إلا عصبتِ جراحهُ بجراح",40,"ح",1,0],["أو ساف نكهتها عن ألفِ مرحلَةِ","أبو نواسٍ لفدّاها نُواسيها",41,"ي",3,0],["أو سمّها كواكبا","تمنعت أن تغربا",42,"ب",2,0],["أو سرت أنفاسُنا في جانبيْ","مَلَكٍ ما كدّرت ذاك الصفاء",43,"ا",2,0],["أو سار وقتَ الحرب، صبَّ على","أعدائه سيلاً من الذُّعْر",44,"ر",1,0],["أو سلسلوك، فطالما","سلسلت أقدام العصاة",45,"ا",2,0],["أو سكتم عنا فكنا كمن أغ","مض عيناً في جفنها الأقذاء",46,"ا",2,0],["او سد جوعة مسكين بشبعته","في يوم مسغبة عم الغلا فيها",47,"ي",3,0],["او سارقٍ لا لقَعر السِجنِ مَرجِعهُ","لكنْ إلى الجاهِ وَثّاباً ومُرْتفِعا",48,"ع",2,0],["أوسَعْتَهم قارصاتِ النقدِ لاذعةً","وقلتَ فيهم مَقالاً صادقاً عجبا",49,"ب",2,0],["أو ساجعٍ تحسب ألحانه","من مكل ندمان عليه اقتراح",50,"ح",1,0],["أوسِعْه عذراً ولُمْ مُعدّبه","وقل له عن أخٍ قد اعتقدك",51,"ك",1,0],["أو سرى الشيب تحت ليل شباب","مستحيرٍ في لمة سمحاء",52,"ا",2,0],["أو سُلَّماً في السما ابتغيتُ أو نَفَقاً","في الأرض إن لم يجىءْ ضحىً مع الطَّفَلِ",53,"ل",1,0],["أو سيجة ما انفك يعمر سوقها","لهو الشيوخ ومتعة الشياب",54,"ب",1,0],["أو سنةِ المصطفى المتخارِ سيدنا","خيرِ البرايَا الذي دَانَتْ له الملكُ",55,"ك",1,0],["أوسائراً في رِكابِ ريحٍ","يَهرُبُ فيها من العِباد",56,"د",1,0],["أو سِوَى ذَاكَ مِن بَدِيعٍ بَدِيعٍ","حَسَنٍ في التَّسجِيعِ والتَّوقِيعِ",57,"ع",1,0],["أو سكارى تجهموا ذا وقار","أو وقور بدا له سكرانُ",58,"ن",1,0],["أَوسَعتَني حِلماً وَزِدتَ تَطَوُّلاً","وَعَطَفتَ عَفواً قَبلَ أَن تُستَعطَفا",59,"ف",2,0],["أَوسَعتَ قُوّالَ القَريضِ فَضائِلاً","فَلِذاكَ مَن أَثنى عَلَيكَ أَطالا",60,"ل",2,0],["أو سالك نهج السعادة والهدى","أو فاتكٍ في فتكه متطوّر",61,"ر",1,0],["أَو سارَ يَلتَمِسُ النُّجومَ بِصَولَةٍ","لَغَدَت دَرارِيهِنَّ مِن أُسَرائِهِ",62,"ا",3,0],["أوسعته بقنوع حافظ كرمي","وحاقن ماء وجهي ساتر خللي",63,"ل",2,0],["أوسط فيما بيننا صالح الرقى","ولا خير في حرب توسّطها العصب",64,"ب",1,0],["أو سرَّهُ إلّا نُحولي","في هواهُ واصفِراري",65,"ر",2,0],["أو سألناك كنتَ أَنْدَى من الغَيْ","ث وأَعْطَى لكلِّ شيءِ جزيل",66,"ل",1,0],["أَوسَعتَها نِعماً أَضيقُ بِحَملِحا","ذَرَعاً عَلى أَنّي أَقولُ فَأوسِعُ",67,"ع",1,0],["أَو سيمَ حَملَ الضَيمِ في","أَوطانِهِ فَتَغَرَّبا",68,"ب",2,0],["أَو سَلَّ يَومَ الرَوع أَبيضَ صارِماً","إِلّا وَعادَ مِن الأَعادي أَحمَرا",69,"ر",2,0],["أو ساد الرسل بطلعتهِ","أو ما فزنا بمحبّته",70,"ه",1,0],["أو سار الركب على السرجِ","أو ما نشروا فينا الطَولا",70,"ل",2,0],["أو سرب نحلٍ مثار من خليتَه","أو وابلٍ في مهب الريح سحّاح",71,"ح",1,0],["أَو سماءً أُفقُها قد أَطلعا","أَنجماً دارتْ بومضٍ واضطرام",72,"م",1,0],["أو سَمَا فِي السُّحبِ عنهَا مَطلَبٌ","عَلّقَت مِن كُلِّ هُدبٍ مَرَسا",73,"س",2,0],["أَوسَعْت أَهل الفَضْلِ إفْضالاَ فقد","ظَفِروا بعَيشٍ من نَداك رغيد",74,"د",1,0],["أوسَعْتُ قَوماً في الورى مِقةً","فإذا لِمَقْتٍ لي بها حَلب",75,"ب",1,0],["أوسعتُه عتباً فقال موارباً","أنا عاذلٌ وجنابكم معذول",76,"ل",1,0],["أَوسَعوهُم طَعناً وَضَرباً وَنَحراً","وَاِنتِهاباً يا ضلةً مِن سَبيل",77,"ل",1,0],["أَوْسَعْتُماهُ ملاماً في الغرامِ وما","وجدتُما في الهوى بعضَ الّذي وَجَدَا",78,"د",2,0],["أو سيرة لأناس أصبحوا رمماً","تحت التراب وكانوا ذوي همم",79,"م",1,0],["أو سريتم في خبت نعمان قلتم","ما بهذا يُكلِّفُ الجبار",80,"ر",1,0],["أَوسَع صَدري كُلَّ يَومٍ بِزَفرَةٍ","عَلى أَنَّهُ وسع يَضيقُ لَهُ الصَدرُ",81,"ر",1,0],["أو سأَلتَ السُّيوفَ والأَقلاما","لا يُضام النزيلُ فيهم بحالٍ",82,"ا",2,0],["أو سألتم بعد النوى عن فؤادي","فسَلوا الظاعنين والنازحينا",83,"ن",2,0],["أو سل لحرب باتره","حدث ما شئت بلا حرج",84,"ج",1,0],["أو سيّدٍ علّقْتُه","أملي فمال الى المَلالِ",85,"ل",1,0],["أَوْ سابَقَ الخيلَ أَعْطى الحُضْرَ مُتَّئِداً","والشَّدَّ والكَرَّ والتَّقْرِيبَ والخَببَا",86,"ب",2,0],["أو سوقة أو كل ما","قد كان من أهل الدنيه",87,"ي",2,0],["أو سره للبين توديع النهى","والمكرمات فهكذا التوديع",88,"ع",1,0],["أو سار ركب نحوهم","باتت دموعك تنسكب",89,"ب",1,0],["أو سَلوا أهلَ الدعارات فكم","بادُلوه الرِّجس في غيرِ مَلال",90,"ل",1,0],["أو سمعنا عن ضيعةِ العبقري","في بلادٍ تَرى الجهالةَ ذنبا",91,"ب",2,0],["أو سُلِّم الحسنُ للبياض لما","عُدَّ شفاءً بين الشفاه لَمَى",92,"م",2,0],["أو سجد الناسُ لأخ","لاقٍ فَكُنَّ قِبَلا",93,"ل",2,0],["أوسعْتهم كرماً فباتَ شَقيُّهُمْ","في ظلِّ نُعماك النَّضيرةِ يَنْعَمُ",94,"م",1,0],["أو سامهُ عافوهُ بُلغَةَ مائهِ","يومَ التَّصافُنِ صائفاً لم يَبْخَلِ",95,"ل",1,0],["أوسعتهم رغماً وجدعاً وما","خير حياةٍ ما بين رغمٍ وجدع",96,"ع",1,0],["اوسعتهم لعنةً وخزياً","وقلتَ بعداً لهم وسُحقَا",97,"ق",2,0],["أو ستر الليل نجوم الدجى","سرى على هدي نجوم الرماح",98,"ح",1,0],["أو سد مفتوح من الثغور","أو طلب لناقد بصير",99,"ر",1,0],["أو سده اليمين وكنت أرجو","وآمل أو يوسدني يميني",100,"ن",2,0],["أو ساحةِ النُّدمانِ طافَ بِكَأسِهِم","مَملوءَةٍ فيها رعيشُ بَنانِ",101,"ن",1,0