{"poems":[[53,"هي سلوة ذهبت بكل غرام","https://www.aldiwan.net/poem29797.html","الكامل"],[53,"أحظى الملوك من الأيام والدول","https://www.aldiwan.net/poem29908.html","البسيط"],[53,"يا دين قلبك من","https://www.aldiwan.net/poem30734.html","المجتث"],[53,"مثواي إما صهوة أو غارب","https://www.aldiwan.net/poem30756.html","الكامل"],[63,"واها لأيامي بأكناف اللوى","https://www.aldiwan.net/poem46135.html","الرجز"],[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[77,"زارت ونجم الدجى يشكو من الأرق","https://www.aldiwan.net/poem35921.html","البسيط"],[77,"مولاي يا خير ملوك الورى","https://www.aldiwan.net/poem36766.html","السريع"],[93,"بقي الذكر والرغام فني","https://www.aldiwan.net/poem11249.html","الخفيف"],[72,"قاسي الجوانح لين الأعطاف","https://www.aldiwan.net/poem19257.html","الكامل"],[51,"يا أخي أين ريع ذاك اللقاء","https://www.aldiwan.net/poem7944.html","الخفيف"],[51,"صبرا على أشياء كلفتها أعقبتها الآن وسلفتها","https://www.aldiwan.net/poem8691.html","السريع"],[51,"أصبحت عاديت للصبا رشدك","https://www.aldiwan.net/poem65760.html","المنسرح"],[51,"لامرئ يجهل الغريب سواكا","https://www.aldiwan.net/poem65794.html","الخفيف"],[51,"لاح شيب فنهنه الحلم جهلا","https://www.aldiwan.net/poem65914.html","الخفيف"],[51,"إنما يبكي شجي شجنه","https://www.aldiwan.net/poem66464.html","الرمل"],[91,"كم خفضنا الجناح للجاهلينا","https://www.aldiwan.net/poem62791.html","عموديه"],[85,"أيامكم أم عهد إسماعيلا","https://www.aldiwan.net/poem63755.html","الكامل"],[85,"أيها العمال أفنوا العمر","https://www.aldiwan.net/poem63778.html","مجزوء الرمل"],[62,"سعدت بطول بقائك الحقب","https://www.aldiwan.net/poem52479.html","أحذ الكامل"],[45,"خان عهدي معاودا خون عهدي","https://www.aldiwan.net/poem63452.html","الخفيف"],[45,"لازال محتفل الغمام الباكر","https://www.aldiwan.net/poem63617.html","الكامل"],[61,"رد جفني بسافح الدمع يندى","https://www.aldiwan.net/poem51724.html","الخفيف"],[58,"لا تعتبن على العباد فإنما","https://www.aldiwan.net/poem30802.html","الكامل"],[66,"جلت الظلماء بللهب","https://www.aldiwan.net/poem40672.html","المديد"],[66,"لا راجع الطرف باللقا وسنه","https://www.aldiwan.net/poem40971.html","المنسرح"],[80,"قم هاتها من كف ذات الوشاح","https://www.aldiwan.net/poem31520.html","السريع"],[44,"بذ الجلاد فهو دفين","https://www.aldiwan.net/poem30335.html","الرجز"],[44,"رقت حواشي الدهر فهي تمرمر","https://www.aldiwan.net/poem30510.html","الكامل"],[40,"يا من لقلب شديد الهم معمود","https://www.aldiwan.net/poem42280.html","البسيط"],[75,"متهلل والبدر فوق جبينه","https://www.aldiwan.net/poem69030.html","الكامل"],[19,"زعمتم أن غولا والرجام لكم","https://www.aldiwan.net/poem355.html",""],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85525","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85826","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55179","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54704","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54564","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54710","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141978","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141937","البسيط"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142327","الرجز"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54243","الرمل"],[106,"زمزم طليعة الأسطول المصري","https://www.poetsgate.com/ViewPoem.aspx?id=179646",""],[106,"الكلب هول","https://www.poetsgate.com/ViewPoem.aspx?id=179445",""],[6,"معلقة الحارث بن حلزة اليشكري","https://www.poetsgate.com/ViewPoem.aspx?id=11409",""],[58,"وصف الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=11530",""],[90,"اليأس المنشود","https://www.poetsgate.com/ViewPoem.aspx?id=179218",""],[90,"أبو العلاء المعري","https://www.poetsgate.com/ViewPoem.aspx?id=179199",""],[80,"قُمْ هَاتِها من كف ذاتِ الوِشاحْ","https://www.poetsgate.com/ViewPoem.aspx?id=3054",""],[51,"أصبحتَ عاديتَ للصبا رشدكْ","https://www.poetsgate.com/ViewPoem.aspx?id=30012",""],[51,"يا أخي يا أخا الدماثة والرقة","https://www.poetsgate.com/ViewPoem.aspx?id=25882",""]],"verses":[["أَوسَعتَ مِن خَطَواتِهِ في مَوقِفٍ","مُتَغَلغِلٍ بِتَضايُقِ الأَقدامِ",0,"م",1,0],["أَوسَعتَهُ فَرَأى الآمالَ واسِعَةً","وَكُلُّ ساكِنِ ضيقٍ واسِعُ الأَمَلِ",1,"ل",1,0],["أَو ساطِعاتٌ أَراها","وَاللَيلُ داجٍ أَزَبُّ",2,"ب",1,0],["أَوسَعتَهُ كَرَماً فَأَوغَرَ صَدرَهُ","أَنَّ الأَقارِبَ بَعدَها لَعَقارِبُ",3,"ب",1,0],["أو سَرَقَ الشّمسُ إليها نَظرَةً","فاسْتَلَبَتْ شُعاعَها رأْدَ الضُّحى",4,"ا",1,0],["أَوسَكَتُم عَنّا فَكُنّا كَمَن أَغ","مَضَ عَيناً في جَفنِها أَقذاءُ",5,"ا",2,0],["أو سيْفُ يوسُفَ يوْم الرّوْع سالَ بهِ","نَجيعُ أعْدائهِ المحمرُّ في الزُّرَقِ",6,"ق",1,0],["أَوْ سَيِّدي دَامَ يَرَى سَيِّدِي","حَقّاً لَهُ قُمْتَ بِإيجَابِهِ",7,"ب",2,0],["أَوْسَعَ البِرَّ فِي مَعَاهِدِهِ","مِنَحاً لَمْ يُشَبْن بِالمِنَنِ",8,"ن",1,0],["أو سامت الفرس الأوائل عزّه","لتقطّعت أكتاف ذي الأكتاف",9,"ف",1,0],["أو سُرى الشيب تحت ليل شباب","مُستحير في لِمِّة سَحماءِ",10,"ا",2,0],["أوسعتُها صبراً على لؤْمِها","إذا تَقَصَّتْهُ تَطرَّفْتُهَا",11,"ت",3,0],["أوسِعْه عذراً ولُمْ مُعذِّبه","وقلْ له عن أخٍ قد اعتقدَكْ",12,"ك",1,0],["أو سِواهُ من أهلِ وُدّكَ ممَّنْ","ليس في العلمِ جارياً مجراكا",13,"ك",2,0],["أوسعَ الراغبين فضلاً كما أو","سع أهلَ العنادِ نفْياً وَقَتْلا",14,"ل",2,0],["أوسعَ الأمرين فضلاً فأتت","صور الخلق تضاهي طِيَنَه",15,"ن",2,0],["أَو سُطورٌ بِالماءِ فَوقَ الماءِ","لَو سَكَنتُم قُصورَنا بَعضَ ساعَه",16,"ه",1,0],["أَوسَعتَنا يَومَ الوَداعِ إِهانَةً","أَدَبٌ لَعَمرُكَ لا يُصيبُ مَثيلا",17,"ل",2,0],["أَو سَخا بِالمالِ أَو قَد","دَمَ جاهاً وَاِنتِسابا",18,"ب",2,0],["أوسعتَهُ حِلْماً فأهلكَهُ","ولربما يُستوخَمُ الضَّرَبُ",19,"ب",1,0],["أَوسَعُ العالَمينَ ساحَةَ مَعرو","فٍ وَأَعلاهُمُ بَنِيَّةَ مَجدِ",20,"د",1,0],["أَو سارَ في إِقدامِكُم وَسَماحِكُم","شِعري فَتِلكَ مَناقِبي وَمآثِري",21,"ر",2,0],["أُوسِعُ الدَّهَر مذ تعتَّبْتَ ذَمّاً","بعدَما كنتُ أُوسعُ الدَّهرَ حَمْدا",22,"د",2,0],["أوسع غِناكَ وَكن لِفَقرِكَ صائِناً","يَضني حَشاكَ وَأَنتَ لا تُشفيهِ",23,"ي",2,0],["أَو سِهاماً نَصلُها ذَهَبٌ","لِسِوى الظَلماءِ لَم تُصِبِ",24,"ب",1,0],["أَوسَعتَ لِلعَبدِ مِن هِباتِكَ ما","أَضاقَ عَن حَملِ بَعضِهِ عَطَنَه",25,"ن",2,0],["أو ساجعٍ تحسَبُ ألحانَهُ","مِن كُلّ نَدمانٍ عَلَيهِ اقتراح",26,"ح",1,0],["أَوسَعتَهُم ضَرباً تُهَدُّ بِهِ الكُلى","وَيَخِفُّ مِنهُ المَرءُ وَهوَ رَكينُ",27,"ن",1,0],["أَو ساطِعٍ في حُمرَةٍ فَكَأَنَّ ما","يَدنو إِلَيهِ مِنَ الهَواءِ مُعَصفَرُ",28,"ر",1,0],["أَو سائلي تُخبَري إِن كُنتِ جاهِلَةً","هَل يَنقُضُ الحُرُّ عَهداً بَعدَ تَوكِيدِ",29,"د",1,0],["أوْسَعْتَ عبدَك من أيادٍ شُكرُهَا","حظّانِ من دنيا الشَّكور ودينه",30,"ن",2,0],["أَو سَرَّكُم إِذ لَحِقنا غَيرَ فَخرِكُمُ","بِأَنَّكُم بَينَ ظَهرَي دِجلَةَ السَمَكُ",31,"ك",1,0],["أَوْسَعنا إحسانُه وفضلُهُ","وعَزَّ أَن يكونَ شيءٌ مثلُهُ",32,"ه",1,0],["أَو سلوة في تأتّي","ها للهموم انقشاع",33,"ع",1,0],["أوسعني المؤمنون سبا","فكان بي يحسن السكوت",34,"ت",1,0],["أَوْسَعْتَ مِلْكَكَ تَعْزِيزاً وَمَكْرُمَةً","بَيْنَ الفِدَى وَالنَّدَى بِالبَأْسِ وَالنَّالِ",35,"ل",1,0],["أَوْ سِيرَةٍ سِيقَتْ مَسَاقَ رِوَايَةٍ","لِمَوَاقِفِ التَّمِثيلِ وَالإلقَاءِ",36,"ا",2,0],["أَوْ سَمَاءً عَرُوسُكَ الشَّمْسُ فِيهَا","وَالنُّجُومُ السُّعُودُ وَالأَوْلاَدُ",37,"د",1,0],["أَوْسَعْتَ يَا فَاروقُ شعبَكَ أَنْعُمَاً","في ظِلِّ غَيْرِكَ لَمْ تُتَحْ لِشُعُوبِ",38,"ب",1,0],["أَوْ سِكْرِهَا وَالأَجْرُ ضَاعَ بِهِ","زُهَّادُ زَحْلَةَ غَيْرُ زهَّادِ",39,"د",1,0],["أو سال جرحٌ من جبين مجاهدِ","إلا عصبتِ جراحهُ بجراح",40,"ح",1,0],["أو ساف نكهتها عن ألفِ مرحلَةِ","أبو نواسٍ لفدّاها نُواسيها",41,"ي",3,0],["أو سمّها كواكبا","تمنعت أن تغربا",42,"ب",2,0],["أو سرت أنفاسُنا في جانبيْ","مَلَكٍ ما كدّرت ذاك الصفاء",43,"ا",2,0],["أو سار وقتَ الحرب، صبَّ على","أعدائه سيلاً من الذُّعْر",44,"ر",1,0],["أو سلسلوك، فطالما","سلسلت أقدام العصاة",45,"ا",2,0],["أو سكتم عنا فكنا كمن أغ","مض عيناً في جفنها الأقذاء",46,"ا",2,0],["او سد جوعة مسكين بشبعته","في يوم مسغبة عم الغلا فيها",47,"ي",3,0],["او سارقٍ لا لقَعر السِجنِ مَرجِعهُ","لكنْ إلى الجاهِ وَثّاباً ومُرْتفِعا",48,"ع",2,0],["أوسَعْتَهم قارصاتِ النقدِ لاذعةً","وقلتَ فيهم مَقالاً صادقاً عجبا",49,"ب",2,0],["أو ساجعٍ تحسب ألحانه","من مكل ندمان عليه اقتراح",50,"ح",1,0],["أوسِعْه عذراً ولُمْ مُعدّبه","وقل له عن أخٍ قد اعتقدك",51,"ك",1,0],["أو سرى الشيب تحت ليل شباب","مستحيرٍ في لمة سمحاء",52,"ا",2,0]]}