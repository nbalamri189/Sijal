{"poems":[[53,"ولما بدا لي أن ما كنت أرتجي","https://www.aldiwan.net/poem29844.html","الطويل"],[53,"أسائل سيفي أي بارقة تجدي","https://www.aldiwan.net/poem30621.html","الطويل"],[63,"هفا بهوادي الخيل والليل أسحم","https://www.aldiwan.net/poem46209.html","الطويل"],[34,"عفا سرف من أهله فسراوع","https://www.aldiwan.net/poem4901.html","الطويل"],[77,"جعلت إليك الله والملأ الأعلى","https://www.aldiwan.net/poem35720.html","الطويل"],[88,"أطل صباح العيد في الشرق يسمع","https://www.aldiwan.net/poem45019.html","الطويل"],[47,"ألا من مبلغ سروات قومي","https://www.aldiwan.net/poem25151.html","الوافر"],[72,"ولما بعثت المال عفوا مهنأ","https://www.aldiwan.net/poem18654.html","الطويل"],[95,"في موسم الورد","https://www.aldiwan.net/poem60149.html","عموديه"],[51,"وقفنا فلولا أننا راضنا الهوى","https://www.aldiwan.net/poem8657.html","الطويل"],[51,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[32,"فلما طلعن ذا الغلالة وانتحت","https://www.aldiwan.net/poem27702.html","الطويل"],[85,"ولم أبت الشيخ وهو الغنى","https://www.aldiwan.net/poem7028.html","المتقارب"],[45,"لها منزل بين الدخول فتوضح","https://www.aldiwan.net/poem62693.html","الطويل"],[45,"لقد أمسك الله الخلافة بعد ما","https://www.aldiwan.net/poem63633.html","الطويل"],[45,"بقومي جمعا لا أحاشي ولا أكني","https://www.aldiwan.net/poem66812.html","الطويل"],[28,"أتصرف عن ليلى بنا أم تزورها","https://www.aldiwan.net/poem5110.html","الطويل"],[66,"بعثت بآيات الجمال فآمنت","https://www.aldiwan.net/poem39652.html","الطويل"],[66,"ولا رأي لي إلا إذا كنت حاقنا","https://www.aldiwan.net/poem41562.html","الطويل"],[66,"يلذ لنفسي بذل ما قد ملكته","https://www.aldiwan.net/poem41563.html","الطويل"],[33,"وعار من الأرياش كاس من الهوى","https://www.aldiwan.net/poem25858.html","الطويل"],[105,"أتنقم ما يريبك من خلالي","https://www.aldiwan.net/poem43165.html","الوافر"],[50,"أعبيد يا ذات الهوى النزر","https://www.aldiwan.net/poem63818.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85525","المجتث"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42733","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[90,"ثورة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=179144",""],[45,"لهَا مَنْزِلٌ بَينَ الدَّخولِ فَتُوضَحِ","https://www.poetsgate.com/ViewPoem.aspx?id=33040",""],[138,"ألم تر أني بينما أنا آمن","https://www.aldiwan.net/poem67922.html","الطويل"],[144,"حمى النوم أجفان صب وصب","https://www.aldiwan.net/poem11724.html","المتقارب"],[148,"توسد بمهد الأمن قد مرت النوى","https://www.aldiwan.net/poem47688.html","الطويل"],[151,"لم تبق معلوة إلا خصصت بها","https://www.aldiwan.net/poem68465.html","البسيط"],[170,"أأسكت عن مولى الورى أم أعاتبه","https://www.aldiwan.net/poem1603.html",""],[182,"ألا طرقت أميمة بعدض هدء","https://www.aldiwan.net/poem58888.html","الوافر"],[182,"أنخنا قلوصينا وأرسلت صاحبى","https://www.aldiwan.net/poem59073.html","الطويل"],[190,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[200,"أنت غرست الحب في اضلعي","https://www.aldiwan.net/poem45581.html","السريع"],[205,"ولما بدا لي منك ميل مع العدا","https://www.aldiwan.net/poem53018.html","الطويل"],[223,"عوارض آس ما أرى أم زبرجد","https://www.aldiwan.net/poem55411.html","الطويل"],[230,"توسع دهر لم يضق بك وسعه","https://www.aldiwan.net/poem51014.html","الطويل"],[236,"ترى الظاعن الغادي مقيما على العهد","https://www.aldiwan.net/poem32031.html","الطويل"],[250,"أمن ليلى وجارتها تروح","https://www.aldiwan.net/poem2123.html","الوافر"],[253,"وأهيف زاد الوعك سكرة طرفه","https://www.aldiwan.net/poem1437.html",""],[253,"إذا لاح برق من جنابك لامع","https://www.aldiwan.net/poem1475.html",""],[271,"تذكرت في الحمراء عهد الصبوة","https://www.aldiwan.net/poem35637.html","الطويل"],[272,"ذروني أبكي بعد جيرة ثهمد","https://www.aldiwan.net/poem52052.html","الطويل"],[272,"عسى من خفي اللطف سبحانه لطف","https://www.aldiwan.net/poem52135.html","الطويل"],[281,"هبوا طيفكم أعدى على النأي مسراه","https://www.aldiwan.net/poem60774.html","الطويل"],[299,"أضر بغادة هيفاء رود","https://www.aldiwan.net/poem36293.html","عموديه"],[304,"ولما بكى طرفي وثغرك ضاحك","https://www.aldiwan.net/poem57971.html","الطويل"],[349,"سقاها فهل أبصرت شمسا منيرة","https://www.aldiwan.net/poem20256.html","الطويل"],[350,"لو كان بارئنا تعالى","https://www.aldiwan.net/poem15599.html","مجزوء الكامل"],[354,"تصاحى نديم الحان من نشوة السكر","https://www.aldiwan.net/poem40344.html","البسيط"],[365,"دع العين مني تسكب الدمع أو تفنى","https://www.aldiwan.net/poem60624.html","الطويل"],[365,"طربت لإلمام الخيال المعاود","https://www.aldiwan.net/poem60962.html","الطويل"],[367,"تخوف منها أن يقول متى الوعد","https://www.aldiwan.net/poem16972.html","الطويل"],[367,"ولما بدا خط بخد معذبي","https://www.aldiwan.net/poem17009.html","الطويل"],[367,"هيهات لا أبتغي عن بابكم حولا","https://www.aldiwan.net/poem17252.html","البسيط"],[367,"قضى نحبه الصوم بعد المطال","https://www.aldiwan.net/poem17310.html","المتقارب"],[367,"أناس إلى الظل الإلهي هجروا","https://www.aldiwan.net/poem17765.html","الطويل"],[394,"ولما بدا التفاح أحمر مشرقا","https://www.aldiwan.net/poem53485.html","الطويل"],[406,"كان ينابيع الثرى ثدي مرضع","https://www.aldiwan.net/poem49510.html","الطويل"],[407,"فؤادي الفداء لها من قبب","https://www.aldiwan.net/poem50210.html","المتقارب"],[417,"بكيت الديار وأطلالها","https://www.aldiwan.net/poem53946.html","الطويل"],[417,"أتذكر دون الجزع بالخيف أربعا","https://www.aldiwan.net/poem54020.html","الطويل"],[417,"سقاها الهوى من راحة الوجد صرخدا","https://www.aldiwan.net/poem54030.html","الطويل"],[417,"ذكرت على النوى عهد التصابي","https://www.aldiwan.net/poem54047.html","الوافر"],[430,"أنرت أنرت الشرق يا خير ماجد","https://www.aldiwan.net/poem41004.html","الطويل"],[430,"سقيت ندى الغفران يا لحد يوسف","https://www.aldiwan.net/poem41033.html","الطويل"],[433,"شجته بظهر الصالحية دور","https://www.aldiwan.net/poem12786.html","الطويل"],[433,"ولما بدا ركب السحاب تسوقه","https://www.aldiwan.net/poem12796.html","الطويل"],[442,"أريقي الدمع يا مقلي أريقي","https://www.aldiwan.net/poem14467.html","الوافر"],[444,"سألنا فقالوا هذه جنة الورد","https://www.aldiwan.net/poem55934.html","عموديه"],[459,"على أي لائمة أربع","https://www.aldiwan.net/poem56136.html","المتقارب"],[459,"إذا صاح وفد السحب بالريح أوحدا","https://www.aldiwan.net/poem56243.html","الطويل"],[462,"عليها ذمام الله من كل ذاعر","https://www.aldiwan.net/poem15462.html","الطويل"],[465,"جلت عزماتك الفتح المبينا","https://www.aldiwan.net/poem3115.html","عموديه"],[465,"سقيت حياً جفني يا بانة الحمى","https://www.aldiwan.net/poem3501.html","عموديه"],[480,"إليك كما ارتضيته من بعيد","https://www.aldiwan.net/poem36874.html","الوافر"],[483,"سأبكي عليكم بالدموع السواكب","https://www.aldiwan.net/poem24285.html","الطويل"],[483,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[496,"لئن أحرزك الداعي","https://www.aldiwan.net/poem10238.html","الهزج"],[496,"حديقة الجو غضي هذه الحدقا","https://www.aldiwan.net/poem10251.html","البسيط"],[506,"التوبة","https://www.aldiwan.net/poem27892.html","الطويل"],[552,"أيا ظبية في ربى جاسم","https://www.aldiwan.net/poem47219.html","المتقارب"],[552,"أأغفل والدهر لا يغفل","https://www.aldiwan.net/poem47339.html","المتقارب"],[552,"هل العز إلا في متون السوابق","https://www.aldiwan.net/poem47358.html","الطويل"],[552,"لمن ضرم أعلى اليفاع تعلقا","https://www.aldiwan.net/poem47366.html","الطويل"],[552,"صبرت ومثلك لا يجزع","https://www.aldiwan.net/poem47722.html","المتقارب"],[552,"عرفت الديار كسحق البرود","https://www.aldiwan.net/poem47805.html","المتقارب"],[552,"رميت فما أصميتني وتراجعت","https://www.aldiwan.net/poem48028.html","الطويل"],[552,"وللغصن يرمى كل يوم بشاذب","https://www.aldiwan.net/poem48066.html","الطويل"],[559,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[559,"فديتك يا من قد خفيت فلاحا","https://www.aldiwan.net/poem34672.html","الطويل"],[576,"لئن كنت من عيني نقلت إلى قلبي","https://www.aldiwan.net/poem2789.html","الطويل"],[576,"من فر منك فما يلام","https://www.aldiwan.net/poem3009.html","مجزوء الكامل"],[587,"حديث غرامي في هواك قديم","https://www.aldiwan.net/poem17714.html","الطويل"]],"verses":[["وَلَمّا بَدا لي أَنَّ ما كُنتُ أَرتَجي","مِنَ الأَمرِ وَلّى بَعدَما قُلتُ أَقبَلا",0,"ل",2,1],["وَلَمّا بَعَثتُ الشِعرَ نَحوَكَ قالَ لي","الآنَ فَعُق إِلّا إِلى بابِهِ قَصدي",1,"د",2,0],["ولَمَّا بَدا التَّاجُ المُطِلُّ تَشاوَسَتْ","إلَيْهِ القَوافي والمَطِيُّ المُخَرَّمُ",2,"م",1,0],["وَلَمّا بَدا مِنها الفُراقُ كَما بَدا","بِظَهرِ السَفا الصَلدِ الشُقوقِ الشَوائِعُ",3,"ع",1,0],["ولمْ أُبْقِ أمّاً للشّفاعَةِ أو أبا","ولا ابْناً ولا جَدّاً لهُ خَبَرٌ يتْلَى",4,"ل",2,0],["ولما بدت حمراء أيقنت أنها","بها خجل مما تراه وتسمع",5,"ع",1,0],["وَلَم أَبذُل لِخَوفِهِمُ مَجَنّاً","وَلَم أَلبَس حِذارَ المَوتِ لاما",6,"م",2,0],["ولما بعثت المال عفواً مهنأً","تزيد هذا الشعر حسناً مجددا",7,"د",2,1],["ولم أبرحْ هنا،","في ظل هذا المّلتقى وحدي",8,"د",2,0],["ولما بَصُرنا بالرقيب ولحظهِ","ولحظي على عين الرقيب رقيبُ",9,"ب",1,0],["ولم أبْرمْ بعرفك غير أني","برمتُ بحملِ شكرك والسلامُ",10,"م",1,0],["وَلَما بَدا هَضبُ المِحَزِّ وأَعرَضَت","شَماريخُ من شَرعات يردَى بِها النَّحلُ",11,"ل",1,0],["ولم أبت الشيخ وهو الغنى","وكل ما في الزواج المهور",12,"ر",1,1],["وَلَمّا بَغى المَخظولُ أَيقَنتَ أَنَّهُ","فَريسَةُ مَشبوحِ الذِراعَينِ أَصبَحِ",13,"ح",1,0],["وَلَمّا بَدا مِن سُدَّةِ المُلكِ طالِعاً","ذَكَرنا بِهِ خَيرَ الخَلائِفِ جَعفَرا",14,"ر",2,0],["وَلَمّا بَدا صُبحُ اليَقينِ وَكُشِّفَت","بِهِ ظُلمَةُ الطَخياءِ عَن شُبهَةِ الظَنِّ",15,"ن",1,0],["وَلَمّا بَلَغنا الجَهدَ مِن ماجِداتِها","وَبَيَّنَ مِن أَنسابِهِنَّ شَجيرُها",16,"ر",3,0],["وَلَمّا بَدَت زُهرُ الثُغورِ وَتاهَتِ ال","خَواطِرُ وَاِمتَدَّت إِلَيكَ النَواظِرُ",17,"ر",1,0],["وَلَم أَبتَذِل عِرسَ المَديحِ لِخاطِبٍ","وَلَو أَرغَبوني بِالجَزيلِ مِنَ المَهرِ",18,"ر",1,0],["وَلَم أُبقِ بَعضَ المالِ إِلّا لِأَنَّني","أُسَرُّ بِما فيهِ الوَقائِذُ عَن عِرضي",19,"ي",1,0],["وَلَمّا بَلَغنا الحَيَّ وَالجِسمُ ناحِلٌ","وَقَلبِيَ مَوجوعٌ كَثيرُ الخَوافِقِ",20,"ق",1,0],["وَلَم أَبخَل بِذي خَطَرٍ عَلَيها","وَإِن بَخِلَت بِمَنزورِ النَوالِ",21,"ل",1,0],["وَلَما بَخِلتِ بِمَشرَبٍ خَصِرٍ","مِن ريقِ أَشنَبَ طَيِّبِ الثَغرِ",22,"ر",1,0],["ولَم أبع قط شعري","فالشعر لَيسَ يباع",23,"ع",1,0],["وَلَمْ أَبْعَثِ الْخَيْلَ الْمُغِيرَةَ فِي الضُّحَا","بِكُلِّ رَكُوبٍ لِلْكَرِيهَةِ بَاسِلِ",24,"ل",1,0],["وَلَمْ أُبالِ مُصْحَفاً","لِيَ انْطَوَى أَوِ انْتشَرْ",25,"ر",1,0],["وَلمْ أُبَالِ اسْمِيَ إِنْ","لَمْ يُشْتَهَرْ أَوِ اشْتُهِرْ",25,"ر",1,0],["ولما بدا لي أنه سدُّ مَخْرَجٍ","وقد أُرتِجَ البابُ الذي أنا داخل",26,"ل",1,0],["وَلَمّا بَغَى المَخذولُ أيقَنْتُ أنّهُ","فَرِيسَةُ مَشبُوحِ الذّرَاعَينِ، أصْبَحِ",27,"ح",1,0],["وَلَمّا بَدا لي أَنَّما هُوَ فارِسٌ","وَقَفتُ لَهُ حَتّى أَتى فَرَمانِيا",28,"ن",3,0],["وَلَمّا بَغوا غالَهُم بَغيُهُم","وَمَن غالَبَ الحَقَّ جَهلاً غُلِب",29,"ب",1,0],["ولما بدا قرني بيمناه حربة","وكفّي بها نارٌ بها الكبش قد شوى",30,"و",2,0],["ولم أبالِ بلومٍ في محبته","فاللوم في حبه ضربٌ من اللَّمم",31,"م",1,0],["وَلَم أُبدِ مِن نَفسي هلوعاً وَلَم أَقُم","مَقاماً مَضى عُمري وَإِنّي لَهائِبُهْ",32,"ب",2,0],["ولَم أَبخَل عَلَى ضَيفى وجارى","بِغالِى ما أُفيدُ ولا الرَّخِيصِ",33,"ص",1,0],["ولمّا بَدَالى مِنكِ مَيلٌ مَعَ العِدَى","عَلىَّ وَلَم يَحدُث سِوَاكِ خَليلُ",34,"ل",1,0],["وَلمّا بَدا للكونِ ذلّت لعزّه","كَعُصفورةٍ في الجوّ قد شاهَدت صقرا",35,"ر",2,0],["وَلمّا بَدا عجزُ النَصارى بدينهم","أَتَوا بدليلٍ يهذرونَ بهِ هذرا",35,"ر",2,0],["ولم أبتْ ليلةَ جافيتني","من مضجعٍ جافٍ إلى مضجعِ",36,"ع",1,0],["ولمّا بدا لي منك ميلٌ مع العِدا","سواي ولم يحدث سواك بديلُ",37,"ل",1,1],["ولما براه الشوق ألقى بنفسه","عليها كأن الحرب للوصل موعد",38,"د",1,0],["ولمَّا بلوتُ الناس ثم انتهيتُه","حللتُ بمن يعلو به الخبَرَ الخُبْرُ",39,"ر",1,0],["وَلَم أَبكِ أَطلالاً لِهِندٍ مَواثِلاً","بِذي الأَثلِ لَكِنّي بَكيتُ عَلى هِندِ",40,"د",1,0],["وَلَم أَبرَح رُسومَ الدارِ حَتّى","أَزاحَت عِلَّتي حَرَجٌ مَروحُ",41,"ح",1,0],["وَلَمّا بَدا بَدراً أَمِنتُ مَحاقَهُ","وَلَكِنَّ لي وَجداً عَلَيهِ لكسفِه",42,"ف",2,0],["وَلَمّا بَرَزنا لِلوَداعِ وَأَيقَنَت","نُفوسٌ دَهاها البَينُ ما اللَهُ صانِعُ",43,"ع",1,0],["ولما بدت تلك السواحلُ فجأةً","تفجّرَ شعري من حُبوري ودَهشتي",44,"ي",1,0],["وَلَم أَبغ منكم غير صالح دعوة","يَطول بها باعي وَتَعلو بها يدي",45,"د",2,0],["ولَم ابن حسن الظن في سيدى عَلى","شفا جرف هارفينها ربي الجر ف",46,"ف",1,0],["وَلَمّا بَلَغْناهُ بَلَغْنا بِهِ الْمُنى","وَشِيكاً وَأَعْطَيْنا الْغِنى مِن عَطَاياهُ",47,"ا",2,0],["وَلما بات دفعُ الدَيْنِ أَدنى","وَقيت الدين من حبلِ الوريد",48,"د",1,0],["ولما بكى طرفي وثغرك ضاحكٌ","تعجب منا عند هذا الخلائق",49,"ق",1,1],["وَلَمَّا بَدَتْ مِن فِيهِ هَامَتْ بِلثْمهِ","فَنُظِّمَ من ثَغْرِ الحَبابِ لها ثَغْرُ",50,"ر",1,0],["وَلَمّا بَدَت ثُمَّ اِستَحا","لَت ثُمَّ عادَ لَها إِعادَه",51,"د",2,0],["وَلمّا بلَغت الفَوز مِن كُلّ غايَةٍ","لَدى طيبة المُختار طيّبة النَشرِ",52,"ر",1,0],["ولمّا بدا في أُفْقِ عُلْياه طالعاً","يَبُثُّ سناً واللّيلُ كالدّهر قد جَنّا",53,"ن",2,0],["ولمّا بَلوْتُ النّاسَ أطلُبُ منهمُ","أخا ثقةٍ عندَ اعتراضِ الشَّدائد",54,"د",1,0],["وَلَمّا بَكَت عَيني لَها وَتَبَسَّمَت","تَكاثَرَ فيها بَينَنا الشَرحُ وَالسَردُ",55,"د",1,0],["وَلَمّا بَدا خَطٌّ بِخَدِّ مُعَذِّبي","كَظُلمَةِ لَيلٍ في ضِياءِ نَهارِ",56,"ر",1,1],["وَلَم أُبَل حينَ يُنشي المُزنُ عارِضَهُ","أَعارِضاً مَطِلاً أَم عارِضاً هَطِلا",57,"ل",2,0],["وَلَم أَبكِ عَهداً رَجاءَ الرُجوعِ","وَلَكِن أُحادِثُهُ بِالصِقالِ",58,"ل",1,0],["وَلَمّا بَدا الوَجهُ الكَريمُ مُشافِهاً","بِصُبحِ سُراهُم كَبَّروا لا تَكَبَّروا",59,"ر",3,0],["وَلَمّا بَدا التُفّاحُ أَحمَرَ مُشرِقاً","دَعَوتُ بِكَأسي وَهيَ مَلأى من الشَفَق",60,"ق",1,1],["ولمَّا بلوْناكًمتلوْنا مديحَكُمْ","فيا طِيبَ ما نَبلو ويا صِدْقَ ما نتلو",61,"ل",2,0],["وَلما بَدا نَبتُها بارِضاً","شَكيراً تَراهُ كَمِثلِ الزَغب",62,"ب",1,0],["ولما بَلَغْتُ المنى في العُلى","وبَلَّغْتُ نفسي آمالها",63,"ل",3,0],["ولمَّا بدا نور النَّبيِّ بوجهه","رأيتُ به سرّ النُّبوَّة مودعا",64,"ع",2,0],["ولمَّا بَدَتْ أَعلامُ دار بذي الفضا","أعاد لها الشَّوق القديم كما بدا",65,"د",2,0],["ولم أبلُغْ مقام العزّ إلاَّ","بعبد القادر العالي الجناب",66,"ب",1,0],["ولم أبْرَحْ أهيمُ بكلّ وادٍ","وأقْرَعُ في ثنائك كل باب",66,"ب",1,0],["ولما بدت للناس آيات وصفكم","فمالوا إليكم بالخواطر والقلب",67,"ب",1,0],["ولما بدا في جنة الخلد أرخوا","فضاءَ باخلاط الملائك يوسف",68,"ف",1,0],["ولمّا بدَتْ أسماءُ يخطُرُ حولَها","كواعبٌ يصرَعْنَ البيبَ وحورُ",69,"ر",1,0],["ولما بَدا ركْبُ السحابِ تسوقُه","حُداةُ الرياحِ الهوجِ وهي تُزمجِرُ",70,"ر",1,1],["ولم أبغض سوى سن ضحوك","على حزني ولو ضحك البروق",71,"ق",1,0],["ولما بلغنا ساحة الورد نالنا","من الدهش ما يلهي العطاش عن الورد",72,"د",1,0],["ولما برزتَ تُرائي الهلالَ","مضى آيساً منه مَن يَطمَعُ",73,"ع",1,0],["ولما بدت للعين وَقْصاءَ جهمةً","وكانت تريك البدرَ والظبيَ أجيدا",74,"د",2,0],["ولما براها الوخد من دلج السُّرى","وهُدِّم من طول السِّفار سَنامُها",75,"م",3,0],["ولما باكرتها منك نعمى","بنان تفضح الغيث الهتونا",76,"ن",2,0],["ولم أبك يوماً من صدودك حاديا","ولكنني أبكي وصالاً تقدّما",77,"م",2,0],["ولم أبخل به وبخلت عني","فلم تسمح بمقدمك السعيد",78,"د",1,0],["ولم أبد يوما للخلائق قصتي","وما زلت في ثوب الصبابة ساكب",79,"ب",1,0],["ولما بكى منه الكليم بدت له","مراجعة باللائحات الربانيه",80,"ي",2,0],["ولما بكر الناعي","وصمَّت اذن الواعي",81,"ع",2,0],["ولم أبت بيد الحسناء معتصما","حتى ظللت بعرف الليل معتنقا",82,"ق",2,0],["ولمّا بحثتُ عنك يوم تمرّدَتِ","الحياةُ وجدتُها بحضنكَ غافيهْ",83,"ي",2,0],["ولمّا بلَوْتُ الورى أنكرتْ","وَما ظلمتْ إصبعي خاتمي",84,"م",2,0],["ولمّا بدا شَمَطُ العارضين","لمن كان من قبله يَعذُلُ",85,"ل",1,0],["ولمّا بدا لِي الكاشحون فصرّحوا","تمنّيتُ أيّام العدوّ المنافقِ",86,"ق",1,0],["وَلمّا بنيتُمْ ذُرْوَةَ المجد والنّدى","هزأتُمْ بقومٍ يبتنون الخَوَرْنَقا",87,"ق",2,0],["ولمّا بُخِسْتَ بضيمِ الزّمانِ","قنِعْتَ وإنْ كنتَ لا تقنعُ",88,"ع",1,0],["وَلَمّا بَنيتَ بِساحاتِهِ","أَطلتَ الذُّرا وَرَفعتَ المَنارا",89,"ر",2,0],["وَلَمّا بَدا لي منك أنْ لا مودّةٌ","تناكصتُ أبكي من ضَياع مودّتِي",90,"ي",1,0],["وَلَمّا بَلَوْتُ الأَصدقاءَ ووُدَّهُم","خلصْتُ إِليهِ مِن خِلال التّجارِبِ",91,"ب",1,0],["ولما بدا من قلبهم حجر الهدى","له استلموا إذ منه بانت أصابع",92,"ع",1,0],["ولما بدا وجهٌ له من ورا الورى","رأيت جميع الكائنات ملاحا",93,"ح",2,0],["ولمْ أُبقِ مني العَين إِلاَّ لأَنها","تُريحُ ثرَاكِ الحُرَّ مِن مِنَّةِ السُّحْب",94,"ب",1,0],["ولَمَا بدا لَوْلاَكَ في","ثَغْرِ الزَّمانِ الإِبتسام",95,"م",1,0],["وَلَمّا بَدَتْ في طَوْرِ خَدِّكَ جَذْوَةٌ","وَلاحتْ لِقلبي عادَ وهُوَ كَليمُ",96,"م",1,0]]}