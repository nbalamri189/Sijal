"مجازر الأرواح","https://www.poetsgate.com/ViewPoem.aspx?id=185033",""],[4785,"عند الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=129739",""],[4927,"ضياع الرجاء","https://www.poetsgate.com/ViewPoem.aspx?id=30179",""],[5183,"لشيخ الشريعة","https://www.poetsgate.com/ViewPoem.aspx?id=180209",""],[5183,"سَعد وسُعَيد","https://www.poetsgate.com/ViewPoem.aspx?id=180217",""],[5264,"وليه أنكر ؟","https://www.poetsgate.com/ViewPoem.aspx?id=176531",""],[308,"تنوح حمامات اللوى فَأُجِيب","https://www.poetsgate.com/ViewPoem.aspx?id=189362",""],[5302,"تطاول ليلي","https://www.poetsgate.com/ViewPoem.aspx?id=201153",""],[5442,"تبدت وقد مدت عليها ستورها","https://www.poetsgate.com/ViewPoem.aspx?id=114743",""],[5689,"ذره يرن بضوء ذا السحر","https://www.poetsgate.com/ViewPoem.aspx?id=143405",""],[5691,"رسالة التعليم","https://www.poetsgate.com/ViewPoem.aspx?id=206587",""],[5881,"وحيداً في الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=183756",""],[5943,"كَشَفَتْ غطاها","https://www.poetsgate.com/ViewPoem.aspx?id=34277",""],[6070,"غَريبٌ يبوحُ السرَّ في سِجنِ صدرهِ","https://www.poetsgate.com/ViewPoem.aspx?id=188678",""],[5309,"سلام على ذكر العلى سالف العهد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573521",""],[3116,"ولما بنو اليونان سائت فعالهم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=612419",""],[463,"على أيّ لائمة ٍ أربعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60121&r=&rc=177",""],[463,"إذا صاحَ وفدُ السحبِ بالريح أو حدا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60015&r=&rc=71",""]],"verses":[["وَلَمّا بَدا لي أَنَّ ما كُنتُ أَرتَجي","مِنَ الأَمرِ وَلّى بَعدَما قُلتُ أَقبَلا",0,"ل",2,1],["وَلَمّا بَعَثتُ الشِعرَ نَحوَكَ قالَ لي","الآنَ فَعُق إِلّا إِلى بابِهِ قَصدي",1,"د",2,0],["ولَمَّا بَدا التَّاجُ المُطِلُّ تَشاوَسَتْ","إلَيْهِ القَوافي والمَطِيُّ المُخَرَّمُ",2,"م",1,0],["وَلَمّا بَدا مِنها الفُراقُ كَما بَدا","بِظَهرِ السَفا الصَلدِ الشُقوقِ الشَوائِعُ",3,"ع",1,0],["ولمْ أُبْقِ أمّاً للشّفاعَةِ أو أبا","ولا ابْناً ولا جَدّاً لهُ خَبَرٌ يتْلَى",4,"ل",2,0],["ولما بدت حمراء أيقنت أنها","بها خجل مما تراه وتسمع",5,"ع",1,0],["وَلَم أَبذُل لِخَوفِهِمُ مَجَنّاً","وَلَم أَلبَس حِذارَ المَوتِ لاما",6,"م",2,0],["ولما بعثت المال عفواً مهنأً","تزيد هذا الشعر حسناً مجددا",7,"د",2,1],["ولم أبرحْ هنا،","في ظل هذا المّلتقى وحدي",8,"د",2,0],["ولما بَصُرنا بالرقيب ولحظهِ","ولحظي على عين الرقيب رقيبُ",9,"ب",1,0],["ولم أبْرمْ بعرفك غير أني","برمتُ بحملِ شكرك والسلامُ",10,"م",1,0],["وَلَما بَدا هَضبُ المِحَزِّ وأَعرَضَت","شَماريخُ من شَرعات يردَى بِها النَّحلُ",11,"ل",1,0],["ولم أبت الشيخ وهو الغنى","وكل ما في الزواج المهور",12,"ر",1,1],["وَلَمّا بَغى المَخظولُ أَيقَنتَ أَنَّهُ","فَريسَةُ مَشبوحِ الذِراعَينِ أَصبَحِ",13,"ح",1,0],["وَلَمّا بَدا مِن سُدَّةِ المُلكِ طالِعاً","ذَكَرنا بِهِ خَيرَ الخَلائِفِ جَعفَرا",14,"ر",2,0],["وَلَمّا بَدا صُبحُ اليَقينِ وَكُشِّفَت","بِهِ ظُلمَةُ الطَخياءِ عَن شُبهَةِ الظَنِّ",15,"ن",1,0],["وَلَمّا بَلَغنا الجَهدَ مِن ماجِداتِها","وَبَيَّنَ مِن أَنسابِهِنَّ شَجيرُها",16,"ر",3,0],["وَلَمّا بَدَت زُهرُ الثُغورِ وَتاهَتِ ال","خَواطِرُ وَاِمتَدَّت إِلَيكَ النَواظِرُ",17,"ر",1,0],["وَلَم أَبتَذِل عِرسَ المَديحِ لِخاطِبٍ","وَلَو أَرغَبوني بِالجَزيلِ مِنَ المَهرِ",18,"ر",1,0],["وَلَم أُبقِ بَعضَ المالِ إِلّا لِأَنَّني","أُسَرُّ بِما فيهِ الوَقائِذُ عَن عِرضي",19,"ي",1,0],["وَلَمّا بَلَغنا الحَيَّ وَالجِسمُ ناحِلٌ","وَقَلبِيَ مَوجوعٌ كَثيرُ الخَوافِقِ",20,"ق",1,0],["وَلَم أَبخَل بِذي خَطَرٍ عَلَيها","وَإِن بَخِلَت بِمَنزورِ النَوالِ",21,"ل",1,0],["وَلَما بَخِلتِ بِمَشرَبٍ خَصِرٍ","مِن ريقِ أَشنَبَ طَيِّبِ الثَغرِ",22,"ر",1,0],["ولَم أبع قط شعري","فالشعر لَيسَ يباع",23,"ع",1,0],["وَلَمْ أَبْعَثِ الْخَيْلَ الْمُغِيرَةَ فِي الضُّحَا","بِكُلِّ رَكُوبٍ لِلْكَرِيهَةِ بَاسِلِ",24,"ل",1,0],["وَلَمْ أُبالِ مُصْحَفاً","لِيَ انْطَوَى أَوِ انْتشَرْ",25,"ر",1,0],["وَلمْ أُبَالِ اسْمِيَ إِنْ","لَمْ يُشْتَهَرْ أَوِ اشْتُهِرْ",25,"ر",1,0],["ولما بدا لي أنه سدُّ مَخْرَجٍ","وقد أُرتِجَ البابُ الذي أنا داخل",26,"ل",1,0],["وَلَمّا بَغَى المَخذولُ أيقَنْتُ أنّهُ","فَرِيسَةُ مَشبُوحِ الذّرَاعَينِ، أصْبَحِ",27,"ح",1,0],["وَلَمّا بَدا لي أَنَّما هُوَ فارِسٌ","وَقَفتُ لَهُ حَتّى أَتى فَرَمانِيا",28,"ن",3,0],["وَلَمّا بَغوا غالَهُم بَغيُهُم","وَمَن غالَبَ الحَقَّ جَهلاً غُلِب",29,"ب",1,0],["ولما بدا قرني بيمناه حربة","وكفّي بها نارٌ بها الكبش قد شوى",30,"و",2,0],["ولم أبالِ بلومٍ في محبته","فاللوم في حبه ضربٌ من اللَّمم",31,"م",1,0],["وَلَم أُبدِ مِن نَفسي هلوعاً وَلَم أَقُم","مَقاماً مَضى عُمري وَإِنّي لَهائِبُهْ",32,"ب",2,0],["ولَم أَبخَل عَلَى ضَيفى وجارى","بِغالِى ما أُفيدُ ولا الرَّخِيصِ",33,"ص",1,0],["ولمّا بَدَالى مِنكِ مَيلٌ مَعَ العِدَى","عَلىَّ وَلَم يَحدُث سِوَاكِ خَليلُ",34,"ل",1,0],["وَلمّا بَدا للكونِ ذلّت لعزّه","كَعُصفورةٍ في الجوّ قد شاهَدت صقرا",35,"ر",2,0],["وَلمّا بَدا عجزُ النَصارى بدينهم","أَتَوا بدليلٍ يهذرونَ بهِ هذرا",35,"ر",2,0],["ولم أبتْ ليلةَ جافيتني","من مضجعٍ جافٍ إلى مضجعِ",36,"ع",1,0],["ولمّا بدا لي منك ميلٌ مع العِدا","سواي ولم يحدث سواك بديلُ",37,"ل",1,1],["ولما براه الشوق ألقى بنفسه","عليها كأن الحرب للوصل موعد",38,"د",1,0],["ولمَّا بلوتُ الناس ثم انتهيتُه","حللتُ بمن يعلو به الخبَرَ الخُبْرُ",39,"ر",1,0],["وَلَم أَبكِ أَطلالاً لِهِندٍ مَواثِلاً","بِذي الأَثلِ لَكِنّي بَكيتُ عَلى هِندِ",40,"د",1,0],["وَلَم أَبرَح رُسومَ الدارِ حَتّى","أَزاحَت عِلَّتي حَرَجٌ مَروحُ",41,"ح",1,0],["وَلَمّا بَدا بَدراً أَمِنتُ مَحاقَهُ","وَلَكِنَّ لي وَجداً عَلَيهِ لكسفِه",42,"ف",2,0],["وَلَمّا بَرَزنا لِلوَداعِ وَأَيقَنَت","نُفوسٌ دَهاها البَينُ ما اللَهُ صانِعُ",43,"ع",1,0],["ولما بدت تلك السواحلُ فجأةً","تفجّرَ شعري من حُبوري ودَهشتي",44,"ي",1,0],["وَلَم أَبغ منكم غير صالح دعوة","يَطول بها باعي وَتَعلو بها يدي",45,"د",2,0],["ولَم ابن حسن الظن في سيدى عَلى","شفا جرف هارفينها ربي الجر ف",46,"ف",1,0],["وَلَمّا بَلَغْناهُ بَلَغْنا بِهِ الْمُنى","وَشِيكاً وَأَعْطَيْنا الْغِنى مِن عَطَاياهُ",47,"ا",2,0],["وَلما بات دفعُ الدَيْنِ أَدنى","وَقيت الدين من حبلِ الوريد",48,"د",1,0],["ولما بكى طرفي وثغرك ضاحكٌ","تعجب منا عند هذا الخلائق",49,"ق",1,1],["وَلَمَّا بَدَتْ مِن فِيهِ هَامَتْ بِلثْمهِ","فَنُظِّمَ من ثَغْرِ الحَبابِ لها ثَغْرُ",50,"ر",1,0],["وَلَمّا بَدَت ثُمَّ اِستَحا","لَت ثُمَّ عادَ لَها إِعادَه",51,"د",2,0],["وَلمّا بلَغت الفَوز مِن كُلّ غايَةٍ","لَدى طيبة المُختار طيّبة النَشرِ",52,"ر",1,0],["ولمّا بدا في أُفْقِ عُلْياه طالعاً","يَبُثُّ سناً واللّيلُ كالدّهر قد جَنّا",53,"ن",2,0],["ولمّا بَلوْتُ النّاسَ أطلُبُ منهمُ","أخا ثقةٍ عندَ اعتراضِ الشَّدائد",54,"د",1,0],["وَلَمّا بَكَت عَيني لَها وَتَبَسَّمَت","تَكاثَرَ فيها بَينَنا الشَرحُ وَالسَردُ",55,"د",1,0],["وَلَمّا بَدا خَطٌّ بِخَدِّ مُعَذِّبي","كَظُلمَةِ لَيلٍ في ضِياءِ نَهارِ",56,"ر",1,1],["وَلَم أُبَل حينَ يُنشي المُزنُ عارِضَهُ","أَعارِضاً مَطِلاً أَم عارِضاً هَطِلا",57,"ل",2,0],["وَلَم أَبكِ عَهداً رَجاءَ الرُجوعِ","وَلَكِن أُحادِثُهُ بِالصِقالِ",58,"ل",1,0],["وَلَمّا بَدا الوَجهُ الكَريمُ مُشافِهاً","بِصُبحِ سُراهُم كَبَّروا لا تَكَبَّروا",59,"ر",3,0],["وَلَمّا بَدا التُفّاحُ أَحمَرَ مُشرِقاً","دَعَوتُ بِكَأسي وَهيَ مَلأى من الشَفَق",60,"ق",1,1],["ولمَّا بلوْناكًمتلوْنا مديحَكُمْ","فيا طِيبَ ما نَبلو ويا صِدْقَ ما نتلو",61,"ل",2,0],["وَلما بَدا نَبتُها بارِضاً","شَكيراً تَراهُ كَمِثلِ الزَغب",62,"ب",1,0],["ولما بَلَغْتُ المنى في العُلى","وبَلَّغْتُ نفسي آمالها",63,"ل",3,0],["ولمَّا بدا نور النَّبيِّ بوجهه","رأيتُ به سرّ النُّبوَّة مودعا",64,"ع",2,0],["ولمَّا بَدَتْ أَعلامُ دار بذي الفضا","أعاد لها الشَّوق القديم كما بدا",65,"د",2,0],["ولم أبلُغْ مقام العزّ إلاَّ","بعبد القادر العالي الجناب",66,"ب",1,0],["ولم أبْرَحْ أهيمُ بكلّ وادٍ","وأقْرَعُ في ثنائك كل باب",66,"ب",1,0],["ولما بدت للناس آيات وصفكم","فمالوا إليكم بالخواطر والقلب",67,"ب",1,0],["ولما بدا في جنة الخلد أرخوا","فضاءَ باخلاط الملائك يوسف",68,"ف",1,0],["ولمّا بدَتْ أسماءُ يخطُرُ حولَها","كواعبٌ يصرَعْنَ البيبَ وحورُ",69,"ر",1,0],["ولما بَدا ركْبُ السحابِ تسوقُه","حُداةُ الرياحِ الهوجِ وهي تُزمجِرُ",70,"ر",1,1],["ولم أبغض سوى سن ضحوك","على حزني ولو ضحك البروق",71,"ق",1,0],["ولما بلغنا ساحة الورد نالنا","من الدهش ما يلهي العطاش عن الورد",72,"د",1,0],["ولما برزتَ تُرائي الهلالَ","مضى آيساً منه مَن يَطمَعُ",73,"ع",1,0],["ولما بدت للعين وَقْصاءَ جهمةً","وكانت تريك البدرَ والظبيَ أجيدا",74,"د",2,0],["ولما براها الوخد من دلج السُّرى","وهُدِّم من طول السِّفار سَنامُها",75,"م",3,0],["ولما باكرتها منك نعمى","بنان تفضح الغيث الهتونا",76,"ن",2,0],["ولم أبك يوماً من صدودك حاديا","ولكنني أبكي وصالاً تقدّما",77,"م",2,0],["ولم أبخل به وبخلت عني","فلم تسمح بمقدمك السعيد",78,"د",1,0],["ولم أبد يوما للخلائق قصتي","وما زلت في ثوب الصبابة ساكب",79,"ب",1,0],["ولما بكى منه الكليم بدت له","مراجعة باللائحات الربانيه",80,"ي",2,0],["ولما بكر الناعي","وصمَّت اذن الواعي",81,"ع",2,0],["ولم أبت بيد الحسناء معتصما","حتى ظللت بعرف الليل معتنقا",82,"ق",2,0],["ولمّا بحثتُ عنك يوم تمرّدَتِ","الحياةُ وجدتُها بحضنكَ غافيهْ",83,"ي",2,0],["ولمّا بلَوْتُ الورى أنكرتْ","وَما ظلمتْ إصبعي خاتمي",84,"م",2,0],["ولمّا بدا شَمَطُ العارضين","لمن كان من قبله يَعذُلُ",85,"ل",1,0],["ولمّا بدا لِي الكاشحون فصرّحوا","تمنّيتُ أيّام العدوّ المنافقِ",86,"ق",1,0],["وَلمّا بنيتُمْ ذُرْوَةَ المجد والنّدى","هزأتُمْ بقومٍ يبتنون الخَوَرْنَقا",87,"ق",2,0],["ولمّا بُخِسْتَ بضيمِ الزّمانِ","قنِعْتَ وإنْ كنتَ لا تقنعُ",88,"ع",1,0],["وَلَمّا بَنيتَ بِساحاتِهِ","أَطلتَ الذُّرا وَرَفعتَ المَنارا",89,"ر",2,0],["وَلَمّا بَدا لي منك أنْ لا مودّةٌ","تناكصتُ أبكي من ضَياع مودّتِي",90,"ي",1,0],["وَلَمّا بَلَوْتُ الأَصدقاءَ ووُدَّهُم","خلصْتُ إِليهِ مِن خِلال التّجارِبِ",91,"ب",1,0],["ولما بدا من قلبهم حجر الهدى","له استلموا إذ منه بانت أصابع",92,"ع",1,0],["ولما بدا وجهٌ له من ورا الورى","رأيت جميع الكائنات ملاحا",93,"ح",2,0],["ولمْ أُبقِ مني العَين إِلاَّ لأَنها","تُريحُ ثرَاكِ الحُرَّ مِن مِنَّةِ السُّحْب",94,"ب",1,0],["ولَمَا بدا لَوْلاَكَ في","ثَغْرِ الزَّمانِ الإِبتسام",95,"م",1,0],["وَلَمّا بَدَتْ في طَوْرِ خَدِّكَ جَذْوَةٌ","وَلاحتْ لِقلبي عادَ وهُوَ كَليمُ",96,"م",1,0],["ولما بدَا والليلُ أسْوَدُ فاحمٌ","قدْ انْتَشَرت في الخافقَينِ ذَوائبهْ",97,"ه",1,1],["ولما بدا للعين من جانب الحمى","لوامع برق شاق نحوك شائق",98,"ق",1,1],["وَلما بَدا مِن آسِتانة أَشرَقَت","بِأَنواره الأَرجاء في السَهل وَالوَفز",99,"ز",1,0],["ولمّا بدا لي منهما ما رأيتُه","من الضّعف لا يُرْوى ولا الدّهرُ يَنْسَخُ",100,"خ",1,0],["ولم أبك موتى العام منكم لأنني","سكبت على الأحياء دمعي وما يفي",101,"ف",2,0],["ولما بَدت للعينِ أعلامُ جِلّقٍ","ولاحَ مِن القصرِ المشيدِ قِبابُهُ",102,"ه",1,1],["وَلَمّا بِرَيحانِ العِذارِ تَطرَّزت","خُدودُ الّذي أَهوى وَهمتُ بِحُبِّهِ",103,"ه",1,1],["ولما بدا لي أنها قد تمنعت","وقد هان عرضي في الغرام ومالي",104,"ي",1,1],["ولما بكت عين السماء تبسمت","لها الأرض تُبدي عن وجوه رضاها",105,"ا",3,0],["وَلَمَّا بَلَغْنَ العِيسَ سَفْحَ مُفَرَّح","وَأبْدَيْنَ مَا أجْفَيْنَ منْ شِدَّةِ الحُبّ",106,"ب",1,1],["وَلَمَّا بدا كسرَى الضّيَا فَوْقَ أشْهَبٍ","وَوَلَّى نَجَاشِيُّ الدُّجَى فَوْقَ أدْهَمِ",107,"م",1,0],["وَلمّا بَدا وجهُ الصباح لنا وقد","تقضّى دجاه مُسرعاً في اِنزعاجهِ",108,"ج",2,0],["ولما بان لي منها كسقم","نبذت به إحتقاراً بالعراء",109,"ا",2,0],["ولم أَبَلْ حينَ نَبْتُ الخُضوعَ لَهُمْ","أَكُنْتُ في سعةٍ أَمْ كُنْتُ في ضِيقِ",110,"ق",1,0],["ولما بسطْنا للوداع أكفَّنا","وكلّ لِما يَلقاه قد ودَّع الصَّبرا",111,"ر",2,1],["وَلَم أَبِع رُشداً بِغَيٍّ وَلَم","أَرضَ بِعَقلي مِثلَ هَذا الغَبَن",112,"ن",1,0],["ولم أبتذل في خدمة العلمِ مُهجَتي","لأَخدمَ من لاقيتُ لكن لأُخدما",113,"م",2,0],["ولم أبك مربعَ العامِريَّةِ باللَّوى","ولا رَسمَ دارٍ بالثَّنيَّةِ مُقفِرا",114,"ر",2,0],["ولما بدا لي اليأسُ مِنهُ وأنزفَت","عُيونُ بَواكيه ومَلَّت نَوادبُه",115,"ب",2,0],["ولم أبت ليلتي وعيشك يا","مولاي حتى دعيت بالرسل",116,"ل",1,0],["وَلَمّا بَدا لي مِنكِ مَيلٌ مَعَ العِدى","سِوايَ وَلَم يَحدُث سِواكِ بَديلُ",117,"ل",1,1],["وَلِمّا بَدا جَعفَر في الخَمي","سِ بَينَ المطلّ وَبَين العَروسِ",118,"س",1,1],["وَلمّا بَدا بَينَ أَحبابه","وُلاةِ العُهود وَعزّ النفوسِ",118,"س",1,0],["ولما بدا أرّخْ وزانَ تمامُهُ","تحكَّمَ ما بينَ الجوانحِ عادل",119,"ل",1,0],["ولمّا بدا لي غيرَ شكٍّ منَ الذي","قد انذَرَنا الهادي الأمينُ المخايِلُ",120,"ل",1,0],["ولم أبق بعد الظاعنين فديتهم","لأبقى ولكني لأشقى وأكمدا",121,"د",2,0],["وَلَمّا بَدَت بَينَ الوُشاةِ كَأَنَّها","عِناقُ الفِراقِ يُشتَهى وَهُوَ يَقتُلُ",122,"ل",1,0],["ولما بدا صُبحُ اليَقينِ لناظري","جعلتُ فؤادي والحياةَ فداكِ",123,"ك",1,0],["ولما بدا ميقات إحرام حجنا","نزلنا به والعيس فيه أنخناه",124,"ن",3,0],["ولما بدا جزع العقيق رأيتنا","نشاوى سكارى فارحين برؤياه",124,"ه",1,0],["ولما بلغنا من زيارة أحمد","منانا حمدنا ربنا وشكرناه",124,"ن",3,0],["ولما بدت أعلامها وطلولها","تحدرت الركبان عما ركبناه",124,"ن",3,0],["ولمّا بلغت اليأس من نيل وصلها","فررت بنفسي لا عليها ولا لها",125,"ل",3,0],["ولما بدا كالغصن يهتز مثمرا","فقلت له أهلا وسهلا ومرحبا",126,"ب",2,0],["ولما بدا خلقي بعيني رأيتني","بأسمائه الحسنى وسبعة أسوار",127,"ر",1,0],["ولم أبع منه نفسي","إلا لجهلي بأسي",128,"س",2,0],["ولم أبرح بقلبٍ مُستكينِ","أطوفُ ببابكُم في كل حينٍ",129,"ن",1,0],["ولما بلغنا ذلك الحي خلتني","ظهرت من الفردوس فوق المظاهر",130,"ر",1,0],["ولما بها أحيا شريعة جده","وكان لها نورا وفخرا ومظهرا",131,"ر",2,0],["ولما بعمان تبلج بدره","شددت على ظهر المنا نحوها رحلى",132,"ل",2,0],["ولما برزتم للقتالِ بأعيُنٍ","لها في قلوبِ العاشقينَ هيامُ",133,"م",1,1],["ولما بدا تحقيق حالي وأشرقت","نتيجة صدقي عند خصمي تحيرا",134,"ر",2,0],["ولم أبده كي لا يساء لوقعه","صديقي ويأسي من تعسره جاري",135,"ر",2,0],["ولما به أسرى الإله إلى العلى","دنا فتدلى حيث لا حجب تستر",136,"ر",1,0],["ولَمَّا بَدَتْ تلْكَ السيوفُ جَداولاَ","غَدَتْ لنفوس الشِّرك بالموت مشَربا",137,"ب",2,1],["ولما بدا وجه الحقائق كالحاً","لعيني استحالت نعمتي لبلاء",138,"ا",2,0],["ولما بكى ساجني رحمة","أجابوا التشفع للأدمع",139,"ع",1,0],["ولما بدا في مغلطاي مقَندسٍ","غزالٌ حكى ضوءَ الصباح جبينُه",140,"ه",1,1],["وَلَما بَدا الصُبح المُنير وَأَقبَلَت","كَتائبه تَسعى بِرايته الشَقرا",141,"ر",2,0],["وَلم أبرئه عَن عَيب وَعَن دَنس","كَتمت سراً بَدا لي مِنهُ بِالكتم",142,"م",1,0],["ولما بدت أعلام صبح بذي الغضا","غضا الاثل من قبل الممات معادُ",143,"د",1,1],["ولما بدا للعين ميزانُ شعركم","وأعجبها إذا ما رأت فيه من شين",144,"ن",1,1],["ولما بدت غراء فند منصف","رأى كل وهم ساد حول قراها",145,"ا",3,0],["ولما بنو اليونان ساءت فعالهم","ولم يحفلوا منا بعتب ولا نصح",146,"ح",1,1],["ولما بدا لي أوحد الناس كلهم","بل الناس لاحوا كلهم في اسم أوحد",147,"د",1,0],["وَلِما بِهِ خيرُ البِلاد","كَي يَرفَعوا شَأنَ الوَطن",148,"ن",1,0],["ولما بدا مرخى الذوائب وانثنى","ضحوك الثنايا مرسل الصدغ في الخدّ",149,"د",1,1],["وَلمّا بَدا من خلال السُجو","فِ أَعشت نواظرنا الغاشيَه",150,"ي",2,0],["ولم أُبقِ فخْراً للعدو عليكم","بقتلي وقد أعرضتُم بالمناكِبِ",151,"ب",1,0],["وَلما بِحق في ضَروب سِياسَة","رَأَتكَ لها مولى فَاِلقَت لَكَ الاِمرا",152,"ر",2,0],["وَلما بَدا في وُجنَة الحُسنِ خالَها","وَتاه باِعجاب عَلِيَّ دَلالِها",153,"ه",2,0],["ولما بدت بالرأس شعلة قابس","لها جذوة في شعلة القلب تشعل",154,"ل",1,0],["ولما بدا خَطٌّ بخدّ معذِّبي","كظُلمةِ ليلٍ في بياضِ نهارِ",155,"ر",1,1],["ولما بحسادي مررت تغامزوا","وقالوا استحالت صرف خمرته خلا",156,"ل",2,0],["ولما بدا لي اعتياص الشؤون","وسد السبيل عن المطلب",157,"ب",1,0],["ولما بدا الليل من طرته","أرانا طوال الليالي قصارا",158,"ر",2,0],["ولما بدت للعين ساطعة الضحى","بدا موكب لا يستطاع له حصر",159,"ر",1,0],["ولما بشروا بالصلح قلنا","لكل رزيئة نزلت زوال",160,"ل",1,0],["ولما بدت في خدِّه أحرفٌ مزيدٌ","لجمال منه دمعي سجومُ",161,"م",1,1],["ولما بدا وجهُها في الصباحْ","بدا بالمحيا صباح الصباحْ",162,"ح",1,1],["ولم أبرح وأن رغمت أنوف","عزيزا حيث كنت من البلاد",163,"د",1,0],["وَلَمّا بِتِلكَ الصُفوفِ اِصطَدَم","عَلى رَغمِهِ ثَبَّطَتهُ القَدَم",164,"م",1,0],["ولمَّا بُلِّغا لِمُعَسكَرَيهِم","بها نَزَلا على الرَّوضِ النَّضِيرِ",165,"ر",1,0],["وَلِما بَدا فَرجُها جاثِماً","كَرَأسٍ حَليقٍ وَلَم يَعتَمِد",166,"د",1,1],["ولما بلغناه تهلل عارض","سقى صوبه الدنيا ومثواه فارس",167,"س",1,0],["وَلَم أَبخَل بِها حبا لِعَيش","وَعَيش المَرءِ مَهما طالَ فاني",168,"ن",2,0],["ولما بدا لي الناران في","حماها الذي في العلى لا يبارى",169,"ر",2,0],["ولما بدا الفسطاطُ بشرْتُ ناقتي","بمن يَتَلقى الوفدَ بالوَفْرِ والبشْرِ",170,"ر",1,0],["وَلَمّا بَدا ما تَمَّ مِن حُسنِ نَظمه","وَحازَ العُلى مَبداهُ ثُمَّ عَواقِبُه",171,"ب",2,0],["وَلَمّا بدا بالعدل كالبدر في الدجى","وتصدق آمالٌ بِهِ وَظنونُ",172,"ن",1,0],["ولما بدا آس العذار منمنما","رفعت يدي عنه وقلت قفا نبك",173,"ك",1,0],["ولما بَكرْتُمْ للمصلَّى تلألأت","بأنوارِكم ساحاتُه وجوانبه",174,"ب",2,0],["وَلَمَّا برزنا للَوَداعِ وأبرَزُوا","وُجُوهاً لنا منها بُدوُرُ وأَنجُمُ",175,"م",1,0],["ولما بعثتُ الرسلَ والكتَب نحوه","بخفي حُنينٍ عادت الرسلُ والكتب",176,"ب",1,0],["ولمّا بلوتُ الحبَ بعد فراقِها","قضَيتُ على أمِّ المحبّينَ بالثكلِ",177,"ل",1,0],["ولما بدا لي أنها لا تحبني","وأن هواها ليس عني بمنجلي",178,"ل",2,1],["ولم أبال في حلول رمسي","وصدني عن الصواب جهلي",179,"ي",1,0],["ولما بنو البلقان ساءت فعالهم","وجّلت خطاياهم عن العدو الصفح",180,"ح",1,1],["ولم أبِت قَطُّ من خَلقٍ على ثقةٍ","إِلاَّ وأصبحتُ من عقلي على غَرَرِ",181,"ر",1,0],["ولما برزت إلى الهمّ فيه","ولي بالسرور عليه اقتدارُ",182,"ر",1,0],["ولمّا بدا أن الفراق محتّم","صمتُّ وباتت أدمعي تتكلّمُ",183,"م",1,0],["ولمّا بلغنَ القلبَ فاض حنينهُ","وغنّتْ له رغمَ الضجيج بلابلُ",184,"ل",1,0],["ولمَّا بدا لك عزمي قنعْتِ","وهيهات يُجديك أن تَقنعي",185,"ع",2,0],["وَلَمَّاْ بَعُدْنَاْ!! أَبْعَدَ الْهَجْرُ حُبَّنَاْ","وَضَاْعَ بِصَحْرَاْءِ الْوَفَاْءِ رَجَاْئِيْ",186,"ا",2,0],["ولما بدت عرفات الولا","تجلى له ما وراء الحمى",187,"م",2,0],["ولما بدت أرض الفرزدق غدوة","حللت بقوم جارهم لن يهددا",188,"د",2,0],["ولما بيكى يوم أحلم","نفسى الحلم يتفسر",189,"ر",1,0],["وَلما بَكت عَيْني نواك تعلمت","دموع السَّحَاب الغر كَيفَ تصوب",190,"ب",1,0],["ولم أبذل الروح أو أحث في","عيون العواذل أو أصمد",191,"د",1,0],["ولما بدت أعلامها وتأرجت","أباطها منها ولآن سفورها",192,"ر",3,0],["ولما بخصراها الكئيبة من","وحي البيان وهاتف الفكر",193,"ر",1,0],["ولما ببيدائها العجيبة من","صحف العظات وأسطر العبر",193,"ر",1,0],["ولما بدأماها الرهيبة من","موج ومن لج ومن غمر",193,"ر",1,0],["ولمْ أبرَحِ التَّطويرَ للعقلِ دائِباً","على العلْمِ إثراءً له بسَدادِ !",194,"د",1,0],["ولم آبه وقد نزفت بقربي","جداول حبنا ودمي العتيق",195,"ق",1,0],["ولم أبرحْ أسائلُ كلَّ عينٍ","عنِ الإيمان مما قد حماها",196,"ا",3,0],["ولمْ أُبْقِ مملوكاً ولمْ أُبقِ مالكاً","فَكلٌ على الأكتافِ حَتماً لقََبْرِهِ",197,"ر",2,0],["وَلَمَّا بَنى أَعلى وَأَرخى لِظِلِّهِ","فَمَدَّ مِنَ الغَربِ القَصِيِّ إلى الهِندِ",198,"د",1,0],["ولما بنو اليونان سائت فعالهم","ولم يحفلوا منا بعتب ولا نصح",199,"ح",1,1],["ولمّا برزتَ ترأى الهلالَ","مضى آيساً منهُ منْ يطمعُ",200,"ع",1,0],["ولما بدت للعين وقضاءَ جهمة ً","وكانت تريك البدرَ والظبيَ أجيدا",201,"د",2,0]]}