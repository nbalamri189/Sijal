{"poems":[[109,"كم أظهر العشق من سر","https://www.aldiwan.net/poem58554.html","عموديه"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54310","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54327","المنسرح"],[92,"سامراء","https://www.poetsgate.com/ViewPoem.aspx?id=179132",""],[173,"بعض الذي نالنا يا دهر يكفينا","https://www.aldiwan.net/poem1686.html",""],[215,"يا قلب هذا نعيم","https://www.aldiwan.net/poem46564.html","المجتث"],[275,"يا بنت يعرب هل للكرب تنفيس","https://www.aldiwan.net/poem35307.html","البسيط"],[275,"حواء أمك حبها أشقانا","https://www.aldiwan.net/poem35584.html","الكامل"],[371,"مضى امرؤ القيس في دين الهوى سلفا","https://www.aldiwan.net/poem17952.html","البسيط"],[398,"حدق الحسان رمينني بتململ","https://www.aldiwan.net/poem53677.html","الكامل"],[447,"هذي ديارهم وذي أطلالها","https://www.aldiwan.net/poem14393.html","الكامل"],[447,"هذي المنازل ها هيه","https://www.aldiwan.net/poem14399.html","مجزوء الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122612","البسيط"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53871","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70789","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136264","الكامل"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132887","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48956","الكامل"],[1754,"","https://poetry.dctabudhabi.ae/diwan/poem/107350","الكامل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137399",""],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130762","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204743","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204637","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48439","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48316","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108272","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108371",""],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205548","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117914","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133292","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77114","البسيط"],[4288,"","https://poetry.dctabudhabi.ae/diwan/poem/95804","المنسرح"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120290","الكامل"],[4718,"السهم والقوس","https://www.poetsgate.com/ViewPoem.aspx?id=137156",""],[4767,"عودة الجنوب","https://www.poetsgate.com/ViewPoem.aspx?id=94471",""],[4843,"هذا الجريحُ الذي داوتْ عزائمهُ","https://www.poetsgate.com/ViewPoem.aspx?id=142688",""],[4908,"عدْ يا ضنايَ","https://www.poetsgate.com/ViewPoem.aspx?id=207337",""],[5038,"هذا الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=190132",""],[5052,"قالوا تغزّل","https://www.poetsgate.com/ViewPoem.aspx?id=205134",""],[3591,"هذا الجمال فسبّح الخلاّقا","https://www.poetsgate.com/ViewPoem.aspx?id=149503",""],[5232,"أنوثة","https://www.poetsgate.com/ViewPoem.aspx?id=211784",""],[5283,"بنت قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=207581",""],[5363,"رسالة إلى طبل","https://www.poetsgate.com/ViewPoem.aspx?id=199949",""],[5431,"عشقٌ بكليَّ قد ظفر !","https://www.poetsgate.com/ViewPoem.aspx?id=184890",""],[5618,"وردة في محراب عقبة","https://www.poetsgate.com/ViewPoem.aspx?id=208918",""],[5628,"ميادة الحناوي","https://www.poetsgate.com/ViewPoem.aspx?id=180395",""],[5704,"طربُ العشاق","https://www.poetsgate.com/ViewPoem.aspx?id=191318",""],[5720,"وَطَنِي رِجَالٌ","https://www.poetsgate.com/ViewPoem.aspx?id=207270",""],[5877,"سوّد الله قلب جوالي","https://www.poetsgate.com/ViewPoem.aspx?id=37474",""],[5912,"شام الياسمين","https://www.poetsgate.com/ViewPoem.aspx?id=205018",""],[5937,"مآذِنٌ ناسِفة","https://www.poetsgate.com/ViewPoem.aspx?id=211826",""],[5937,"اللّا وَرَقِيَّة","https://www.poetsgate.com/ViewPoem.aspx?id=211908",""],[1920,"الدوحة","https://www.poetsgate.com/ViewPoem.aspx?id=199884",""],[5956,"خريف حبك","https://www.poetsgate.com/ViewPoem.aspx?id=182012",""],[5956,"هذي الأنوثة ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182150",""],[5956,"حيويتان متبادَلتان ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182266",""],[5956,"مِثْل الفقير يرى القصور بعيدا","https://www.poetsgate.com/ViewPoem.aspx?id=182343",""],[5956,"نوع قرينتي بعد كِبَرها","https://www.poetsgate.com/ViewPoem.aspx?id=182346",""],[5956,"شعلة الوجود","https://www.poetsgate.com/ViewPoem.aspx?id=182637",""],[5956,"هذي الطبيعة","https://www.poetsgate.com/ViewPoem.aspx?id=183285",""],[5956,"الجهازُ النَّفْسِيُّ","https://www.poetsgate.com/ViewPoem.aspx?id=184027",""],[5960,"بغدادُ أغلى انتماءاتي","https://www.poetsgate.com/ViewPoem.aspx?id=30808",""],[5974,"فيالق النور","https://www.poetsgate.com/ViewPoem.aspx?id=200260",""],[6075,"النَّصْرُ آتٍ","https://www.poetsgate.com/ViewPoem.aspx?id=190501",""],[6125,"أبصرتُ دربي","https://www.poetsgate.com/ViewPoem.aspx?id=208512",""]],"verses":[["هذا الجمال الذي مهما قسى رحم","هذا الجمال الذي يستأنس الألما",0,"م",2,0],["هذا الجمالُ كأنّه","قد صِيغَ من خَطَراتِ شاعرْ",1,"ر",1,0],["هذا الجني من غراس جنتها","في كل واد مهدل ثمره",2,"ر",2,0],["هذا الجميلُ الغضُّ سوف يردُّه","شِعري إليكِ مُضاعفاً بجميله",3,"ل",2,0],["هَذا الجَزاءُ لِما سَنَّت أَسِنَّتُنا","يا لَلرِجالِ وَما أَمضَت مَواضينا",4,"ن",2,0],["هذا الجمال الجميل","وهذه الأزهار",5,"ر",1,0],["هذا الجمالُ عريقٌ في عروبتهِ","ما شامَهُ راهبٌ يوماً وقسِّيس",6,"س",1,0],["هذا الجمالُ حَفَظتِهِ وبَذلتِهِ","فأضلَّنا في حبِّهِ وهدانا",7,"ن",2,0],["هَذا الجَنى مِن عِتابِ الشَيبِ أَورَدَهُ","سَمعي فَأَصغي إِلَيهِ العِطفُ فَاِنعَطَفا",8,"ف",2,0],["هذا الجِهادُ وَما يُطيقُ بِجهده","خَصم دِفاعَ وُضوحِهِ بِتَأَوُّل",9,"ل",1,0],["هذا الجزاء ونعم فألا فألها","يا فوزها تحيت لها أنفالها",10,"ل",3,0],["هذا الجزاء لهم لأي","يام سوالف خاليه",11,"ي",2,0],["هَذا الجمالُ وهذا الحُسنُ في مَلَكٍ","في الخلق ما هكذا مَلكٌ ولا بشر",12,"ر",1,0],["هذا الجمادُ حنينُه لمحمّدٍ","بادٍ وقلبُك جاوزَ الأحجارَا",13,"ر",2,0],["هذا الجوابُ لسيِّدِ ساد الأنا","مَ بجوده وبفضلهِ والباسِ",14,"س",1,0],["هذا الجمال وهذه أسراره","والصدق ينبينا عن الصديق",15,"ق",1,0],["هذا الجسيمُ مَوَاهباً هذا الشري","ف مَنَاصِباً هذا المهذَّب خِيما",16,"م",2,0],["هذا الجماد يقو","ل للأحياء أصحابِ الضّمائر",17,"ر",1,0],["هذا الجميل وبالجميل أتى البرا","يا خلقهُ الباهي الجميل المنعم",18,"م",1,0],["هذا الجراد أبادته عنايته","لما أتى كسفا منه تلى قطعا",19,"ع",2,0],["هذا الجمال الذي في الحب أنجبني","وان مثلي به في الناس محسود",20,"د",1,0],["هذا الجنون اليوم أصبح نادرا","إذ عم فينا كل عقل ظالم",21,"م",1,0],["هذا الجمال عليك جر مصائبا","إن الجمال على ذويه وبال",22,"ل",1,0],["هذا الجِهادُ فلوْلا ما ألمّ بهِ","من التألُّمِ ما انحطّوا ولا عرَجوا",23,"ج",3,0],["هذا الجهادُ وإنّ مِثْلَك يقْتَدي","فيهِ بآثارِ النّبيّ المُرسَلِ",24,"ل",1,0],["هذا الجر يجيري ويكفيك اسمه","حتى يدُل على عجائب فعلهِ",25,"ل",2,0],["هذا الجدير بكل سامي منصب","والى ثناه ان أَحث نياقي",26,"ق",2,0],["هَذا الجُوَيهرُ وَالعُرَيضُ بِزَعمِكُم","أَهُما لِمَعرِفَةِ الهُدى أَصلانِ",27,"ن",1,0],["هذا الجحيم أحب لي من عالم","ما كان لي إلا رجاء خابا",28,"ب",2,0],["هذا الجزا في هذه الدّنيا وفي ال","أخرى سيفصلها القوي القاهر",29,"ر",1,0],["هذا الجهاد جهاد العلم قد رفعت","به لدين رسول الله أعلام",30,"م",1,0],["هذا الجَوادُ الَّذي قَد عَمَّ نائِلُهُ","مَن أَخلَصَ الوُدَّ مِن دانٍ وَمُبتَعَد",31,"د",1,0],["هذا الجَليس الذي بُليتُ به","أقسَم ألّا يُفارِقَ الصَلَفا",32,"ف",2,1],["هذا الجني الداني لكل مومل","متطلب منه الحظا ان يقطفا",33,"ف",2,0],["هذا الجمال الي على الارض محسوس","من يمها هبت جميع الاحاسيس",34,"س",1,0],["هذا الجنوب دعا إليه أحبةً","ما بين مغترب وبين مشرد",35,"د",1,0],["هذا الجريحُ الذي داوتْ عزائمهُ","كلومنا بعدَ إذْ عمّت مكارمهُ",36,"ه",1,1],["هذا الجنونُ... الليلُ أسدلَ ثوبه","قلبٌ يئنُ ودمعُ عينٌ قدْ همى",37,"م",2,0],["هذا الْجمالُ وهذا الخالُ لَمّاحُ","فيهِ الضّياءُ ومِنْهُ الْمِسْكُ فوّاحُ",38,"ح",1,1],["هذا الجمالُ يُجلّي سرَّ خالقِه","في كلّ فاتنةٍ جَلّ الّذي صنعا",39,"ع",2,0],["هذا الجمال فسبّح الخلاّقا","وقل السلام على جمالٍ فاقا",40,"ق",2,1],["هذا الجمالُ سينطوي","يوما ً، فلا تتمنعي",41,"ع",2,0],["هذا الجمالُ تفرَّعتْ أغصانُهُ","صبِّي مياهَ العشقِ تنجبُ طُولا",42,"ل",2,0],["هذا الجلندى والحدود تنال من","أهليه في خطبٍ عظيمٍ قاسي",43,"س",2,0],["هذا الجوى أكل الأنا","عشقٌ بكليَّ قد ظفر",44,"ر",1,0],["هذا الجنوب كتيبةٌ عقبيةٌ","المجد فيها للبواسل ..اُسْنَدا",45,"د",2,0],["هذا الجمالُ الذي قدْ كانَ يلهمني","وقدْ بدا الآن في سامي تجلّيهِ",46,"ي",2,0],["هذا الجمال وهذا الحسنُ ذَوَّبَنَا","بالعشْقِ قَبَّلَنَا .. بالشوقِ حَيَّانَا",47,"ن",2,0],["هذا الجنوب سما بهمتهم وقد","صانوه من ذلٍّ ومن خسران",48,"ن",1,0],["هذا الجسد من عليه الرمل ينهالي","ياعم دنيا تشيّب راس راغبها",49,"ب",3,0],["هذا الجَمالُ بِأَرْضِ الشَّامِ أَضْعَافُ","أقولُ يا روحُ هل في الشِّعرِ إنصافُ؟",50,"ف",1,1],["هذا الجنون بقلب كل مولّهٍ","هو محض يتمٍ فيه وهو الكافِلُ",51,"ل",1,0],["هذا الجمال غزيرٌ كيف أشربهُ !","وحلق حبي من قطر الندى شٙرِقٙا !",52,"ق",2,0],["هذا الجمال وأعيادٌ تخيط لهُ","ثوبَ الودادِ فما للحقد ينبحُه؟..",53,"ح",2,0],["هذا الجمال لغيري اْللهِ يحرُسُهُ","أمّا لنفسي فجيش الله زلزلَهُ",54,"ل",2,0],["‏هذا الجمال من الحبيبة وحدها","‏ ‏ قد أطرب الأكوانَ لا تطريبيا",55,"ي",2,0],["هذا الجمالُ على المحبِّ خصيبُ","وأنا الجديب على الجمال ألوبُ",56,"ب",1,1],["هذا الجمال لديك أعلى قمةٍ","قد حلّقتْ عيني لها تصعيدا",57,"د",2,0],["‏هذا الجمال الحرُّ أكنز صورة","‏ ‏ عنه بقلبي ضِعفَ ما سأقولُ",58,"ل",1,0],["‏ ‏هذا الجمال لمن بالله مكتنَزٌ","‏ ‏ أ ما لأفضل شعرٍ خَطَّه قلمي؟",59,"م",2,0],["هذا الجَمالُ حميمٌ لا أفارقهُ","إلا وأشعر رُمحاً غزَّ في كبدي",60,"د",2,0],["هذا الجهاز به السعادة والشقا","أصلحه فورا أو حياتك تَفسدُ",61,"د",1,0],["هذا الجَحيمُ , متى الفردوسُ نَعرفهُ ؟","أمِ الجحيمُ مَصيرٌ في الخياراتِ ؟",62,"ت",1,0],["هَذَا الْجَمَالُ أَتَى لِلْدَّرْبِ فِي دِعَةٍ","يُهْدِي الْجَمِيعَ ضِيَاءً يَرْتَقِي الْقِمَمَا",63,"م",2,0],["هَذَا الْجَمَالُ مُضَرَّجٌ بِدِمَائِنَا","لَمْ تَبْقَ غَيْرُ دِمَائِنَا بِرُوَاكِ",64,"ك",1,0],["هذا الجمال إذا أبصرته اكتحلتْ","عيني وسبَّحتُ من أنْشَا ومن بَرَأ",65,"ا",1,0]]}