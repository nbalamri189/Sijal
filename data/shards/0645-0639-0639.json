{"poems":[[170,"ظهرت على قمم البروج ثلوج","https://www.aldiwan.net/poem47108.html","الكامل"],[563,"الفرق سكر لأن العقل يستجدي","https://www.aldiwan.net/poem34614.html","البسيط"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107188","الخفيف"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49923","الكامل"],[2489,"","https://poetry.dctabudhabi.ae/diwan/poem/111229","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111505","الرجز"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133155","المجتث"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133104","الرجز"],[4797,"صباح الغلا المنقي من الشك والتزوير","https://www.poetsgate.com/ViewPoem.aspx?id=132230",""],[5050,"حدث أخي عن العجب","https://www.poetsgate.com/ViewPoem.aspx?id=38218",""],[5786,"ما الغيث لمّا جرى بالسَّيل واديه","https://www.poetsgate.com/ViewPoem.aspx?id=50656",""]],"verses":[["مع عصبةٍ رُزقوا الحِجى في دينهِم","لكنّهم عندَ الشرابِ عُلوجُ",0,"ج",1,0],["مع علمه أنما الجدوى بأجمعها","لربه الحق من قبل ومن بعد",1,"د",1,0],["مع عدة من أهل بدر وأحد","لهم بدار الخلد أيضا قد شهد",2,"د",1,0],["مَع عِلمِي بِأَنَّ أَبياتَكَ الغُرّ","اللآلِي تَزهُو ودُرٌّ نَضِيدُ",3,"د",1,0],["معَ علمِهم أنَّ الرَّزانةَ والتُقى","والجودَ والمعروفَ حشوُ إهابهِ",4,"ب",2,0],["مع عصبة الدين الذين عهدتهم","يوم الكفاح أساوداً واسودا",5,"د",2,0],["مع عراها الشائقات الغر","أمامه قد حمي الوطيس",6,"س",1,0],["مع عريب الصفا","ذا سلوة المستهام",7,"م",1,0],["مع عريب طالما خامرتهم","في شبابي حيث لا واشٍ ولاح",8,"ح",1,0],["مع عبرة فالحلق ما عينت تحرير","حجزها الحيا فالحلق والعين تسحبها",9,"ب",3,0],["مع عامر وبني ريا","م والقبائل تجتلب",10,"ب",1,0],["مع علمهِ أنَّ ذلّي في تغزّزه","وأنْ فرطَ تلافي في تلافيهِ",11,"ي",2,0]]}