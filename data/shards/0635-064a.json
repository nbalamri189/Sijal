ٌ لمُعَذَّرٍ عَنْ خَطْبِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=31561",""],[46,"صيّرْ عَتادَكَ تقوى اللَّهِ تَذخَرُها،","https://www.poetsgate.com/ViewPoem.aspx?id=18326",""],[28,"يا ظمي ويحك إني ذو محافظة","https://www.poetsgate.com/ViewPoem.aspx?id=22024",""],[99,"إلى عجوز","https://www.poetsgate.com/ViewPoem.aspx?id=17722",""],[51,"أبا حسنٍ قد قلتَ لو كان فَعّالٌ","https://www.poetsgate.com/ViewPoem.aspx?id=30293",""],[51,"وبديعٍ من البدائع يَسْبي","https://www.poetsgate.com/ViewPoem.aspx?id=29591",""],[87,"هو البينُ حتَّى لاسلامٌ ولا ردُّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23842&r=&rc=104",""]],"verses":[["صَيَّرَكِ الدَهرُ إِلى ما أَرى","أَستَنصِرُ اللَهَ عَلى الدَهرِ",0,"ر",1,1],["صَيَّرَني شَوقي وَوَجدي بِكُم","أَذُمُّ يَوماً وَهوَ مَحمودُ",1,"د",1,0],["صيّرْتَ حاتِمَ طَيّئٍ يُزْري بهِ","زارٍ ويسْخَرُ إنْ تُذوكِرَ ساخِرُ",2,"ر",1,0],["صَيدَ نائِيَّةُ المَناسِبِ لكِنَّ","أَباها إِذا اِعتَزى كانَ قاري",3,"ي",1,0],["صيدٌ إِذا اِنتَسَبوا سُحبٌ إِذا وَهَبوا","أُسدٌ إِذا وَثَبوا حَتفٌ إِذا غَضِبوا",4,"ب",3,0],["صِيدَ مِنَ المَاءِ وَلَوْ أَنْصَفُوا","لَظَلَّ فِي المَاءِ عَلَى وُدِّهِ",5,"د",2,0],["صَيَّرَهُ هارونَةُ","في قَومِهِ أَمينَهُ",6,"ه",1,0],["صِياماً تَذُبُّ البَقَّ عَن نُخَراتِها","بِنَهزٍ كَإيماءِ الرُؤوسِ المَوانِعِ",7,"ع",1,0],["صيَّرت بالإحسانِ دارك دارَهُ","مُتّعتَ بالحسنى وعُقبى الدارِ",8,"ر",1,0],["صيدك الأجر ودارُ ال","عدل لا تبرَحُ مرجك",9,"ك",1,0],["صيرت نومي مثل عطفك نافرا","وتركت عزمي مثل جفنك فاترا",10,"ر",2,1],["صيرت إيري واقفاً شرطه","إثبات عشقي واطِّراح مخالفي",11,"ي",1,1],["صيرني في كلِّ وادٍ أهيم","من حظّ قلبي منه هاءٌ وميم",12,"م",1,1],["صيرت فني في المدا","ئح إذ جعلت الجود فنّكْ",13,"ك",1,0],["صيد الملوك الصيد بالكواسر","والخيل في وجهِ الصباح السافرِ",14,"ر",1,0],["صَيَّرَني الحَقُّ بِالحَقيقَه","بِالعَهدِ وَالعَقدِ وَالَثيقَه",15,"ه",1,1],["صيغت وِفاقَ الهوى فما شُنِئت","من رَهَل عابها ولا قَفَرِ",16,"ر",1,0],["صيد حرمناه على إغراقنا","في النزع والحرمان في الإغراق",17,"ق",1,0],["صِيغَ الحجا من سُكُونِه صِيغاً","راقتْ وصيغَ الذكاءُ من حَرَكهْ",18,"ك",2,0],["صيَّرني جودُهُ إلى فُسح ال","عيشِ فأغنيتُ طالبي مُسكهْ",18,"ك",2,0],["صيامٌ وشُرْبٌ يستحثُّ كؤوسَه","أراعدُ بالخابور نوقٌ وأجمالُ",19,"ل",1,0],["صيانةُ وجهٍ لا أبا لك بذْلُهُ","لِما ذبَّ عنهُ الذُّلَّ يا أمَّ سالمِ",20,"م",1,0],["صيرتْ لي اللقاء في كُلِّ شهْرٍ","وأراه يصيرُ في كُلِّ عام",21,"م",1,0],["صِيغَ من طَبْع صوتها كلُّ لحن","معها من لحون تلك الأغاني",22,"ن",2,0],["صَيَّرَ الأَرضَ جَنَّةً دونَها الجَن","نَةُ في الحُسنِ وَالبَها وَالرُواءِ",23,"ا",2,0],["صَيفِيَّةٌ حَمَكٌ حُمرٌ حَواصِلُها","فَما تَكادُ إِلى النَقناقِ تَرتَفِعُ",24,"ع",1,0],["صَيَّرَت ريقَتَها الصا","بونَ وَالشارِبَ ليفَه",25,"ف",2,0],["صَيَّرتَ طينَتَهُ الخُلودَ وَجِئتَ مِن","وادي المُلوكِ بِجَندَلٍ وَرَغامِ",26,"م",1,0],["صَيّادَ آرامٍ رَماهُ الهَوى","بِشادِنٍ لا بُرءَ مِن حُبِّهِ",27,"ب",2,0],["صِيامٌ بِأَبوابِ القِبابِ جِيادُهُم","وَأَشخاصُها في قَلبِ خائِفِهِم تَعدو",28,"د",2,0],["صيدٌ لِأَصيَدَ لَستَ تُبصِرُ جَمرَةً","في الناسِ لَم تَكُ قَطرَةً مِن صُلبِهِ",29,"ب",2,0],["صَيَّرتَ مَجلِسَنا بِذِكرِكَ عامِراً","وَحَضَرتَ آخَرَ غَيرَهُ فَعَمَرتَهُ",30,"ت",2,0],["صَيَّرتِني غايَةَ العُشّاقِ كُلِّهِمِ","فَكُلُّهُم يَتَأَسّى بي إِذا هُجِرا",31,"ر",2,1],["صيغَ مِن صَفوَةِ الزُلالِ وَلَكِن","مِن زُلالٍ مُجَسَّدٍ لَيسَ يَجري",32,"ي",1,0],["صَيداءَ شَأمِيَّةٍ حَرفٍ كَمُشتَرِفٍ","إِلى الشِخاصِ مِنَ التَضغانِ مَبحومِ",33,"م",1,1],["صَيَّرَني نَأيُهُ غَريباً","في غَيرِ أَرضي وَلاسَمائي",34,"ا",3,0],["صَيَّرتَ أَسحارَ السَماحِ بَواكِراً","وَجَعَلتَ أَيّامَ الكِفاحِ لَيالي",35,"ي",1,0],["صَيَّرتَني في نارِ حُبِّكَ خالِداً","قَلبٌ يَذوبُ وَأَدمُعٌ تَتَحَدَّرُ",36,"ر",1,0],["صَيَّرتَ هاماتِ الكُماةِ صَوامِعاً","وَكَواسِرَ العِقبانِ كَالرَهبانِ",37,"ن",1,0],["صَيَّرتَ أَسحارَ السَماحِ بِواكِراً","وَجَعَلتَ أَيّامَ الكِفاحِ غَياهِبا",38,"ب",2,0],["صيّرت دعواه لتفنيدِ","وحطمته وهزمت حجّته",39,"ه",1,0],["صَيّرْتَ في الدّنْيا حديثك فيهمُ","مثلاً يمرّ بأهل كلّ زمانِ",40,"ن",1,0],["صِيدٌ إذا شهدوا النديّ همى الندى","فيه ونيط الحسن بالإحسانِ",41,"ن",1,0],["صَيَّرَني عَبداً لَهُ حُسنُهُ","وَالطَرفُ قَد صَيَّرَهُ عَبدي",42,"د",2,0],["صَيَّرتَني مُستَقَرّاً لِلهَوى وَطَناً","لِلحُزنِ يا مُستَقَرَّ الحُسنِ وَالطيبِ",43,"ب",1,0],["صَيَّرتُ لي مِن تَباري عَبرَتي سَكَناً","مُذ صِرتُ فَرداً بِلا إِلفٍ وَلا سَكَنِ",44,"ن",1,0],["صيغَت لَهُ شَيمَةٌ غَرّاءُ مِن ذَهَبٍ","لَكِنَّها أَهلَكُ الأَشياءِ لِلذَهَبِ",45,"ب",1,0],["صَيحاتُ تُونسَ مَا انْفكّتْ تجاوبُها","أنّاتُ بكين أو رَنّاتُ مِدارسِ",46,"س",1,0],["صيَالك حتف لا تَقُوم لَهُ العدا","وسِربُك وقَّادٌ وعُرفُكض سَاجِمُ",47,"م",1,0],["صَيدَحِيُّ الضُحى كَأَنَّ نَساهُ","حينَ يَجتَثُّ رِجلَهُ في إِباضِ",48,"ض",1,0],["صَيَّروا هامَتَهُم","في التُرابِ أَرجُلا",49,"ل",2,0],["صَيري إِلى عُذري فَإِنّي مُشتَرٍ","بِالجودِ مِن جودِ الإِلَهِ الأَسبَغِ",50,"غ",1,0],["صِيانَةً وَعَطفاً","لِرَحِمي وَغَفرا",51,"ر",2,0],["صَيحَةُ ساقٍ بِحابِسٍ قَدَحا","وَصَبرُ مُستَكرِهٍ لِمُنتَحِبِ",52,"ب",1,0],["صَيَّرَني عَبداً لَها مُذعِناً","حُبّي لَها وَالحُبُّ شَيءٌ عَجَب",53,"ب",1,0],["صيغَ هَذا الناسُ مِن حَمَأٍ","وَبَراهُ اللَهُ مِن ذَهَبِ",54,"ب",1,0],["صَيَّرتُها لِلَّتي أَحبَبتُها مَثَلاً","إِذ لا يَنالَهُما شَيءٌ مِنَ الحَدَقِ",55,"ق",1,0],["صَيَّرَت باءً مَكانَ ال","تاءِ تَصحيفاً عَيانا",56,"ن",2,0],["صيّرتُ ذا في غلافٍ","والرِجل في جوفِ سيرِ",57,"ر",1,0],["صَيِّر عَتادَكَ تَقوى اللَهِ تَذخَرُها","فَما يُنَجّيكَ مِنهُ السابِحُ العَتَدُ",58,"د",1,0],["صَيفُ الجنوبِ شتاءٌ للشَّمَالِ بها","قد صارَ بَينهما هذا وذا دُوَلا",59,"ل",2,0],["صيحة تحت الأرض ثُمَّ حوارٌ","بين أقساهما وبيني يدورُ",60,"ر",1,0],["صيّركَ الحسن أميرَ الوجود","والشعر من درّاته كَلَّلَك",61,"ك",1,1],["صَيْدَحٌ جُنَّ غراماً بالسَّحَرْ","أنطقتْهُ لهفةُ الروحِ المشوقْ",62,"ق",1,0],["صياد أسراب الجمال إذا رنا","جاءته ما عرفت لديه جماحا",63,"ح",2,0],["صَيِّبُ التَّعشيرِ زِمزامُ الضُّحَى","ناِسِلٌ عقَّتَهُ مِثلُ الَمسَد",64,"د",1,0],["صِيرِي إِلَى بَيْتِكِ الْجَدِيدِ","في رَوْنَقِ الطَّالِعِ السَّعِيدِ",65,"د",1,1],["صِينَتْ بِهِ غزَاةٍ فِي الدُّجَى انْسَرَبُوا","إِلى الحِمَى وَالسَّبِيلُ البِكْرُ مَفْرُوعُ",66,"ع",1,0],["صيروها لاختلاق العلل","ولجوا بطن الثرى فهو بهم",67,"م",1,0],["صيرت خمراً آسن الماء في","نفسك: خمراً ينعش الشاربين",68,"ن",1,0],["صيّرت دينَكَ شاهيناً تصيدُ بهِ","وليسَ يفلِحُ أصحابُ الشواهين",69,"ن",1,0],["صَيَّرتْ صَفْحَةَ الرِّياضِ سماءً","وَتَجنَّتْ فيها عَلَى النَّيِّراتِ",70,"ت",1,0],["صَيْحَةٌ قدْسِيَّةٌ إن سكتتْ","فلها في مِصْرَ رَجْعٌ ورَنينْ",71,"ن",1,0],["صيْدٌ ظفرتَ به فلم","تظفَرْ به أيدي الفهود",72,"د",1,0],["صيدُ القلوب -كصيد الطير- معركةٌ","لها: سهام، وأقواس، وأزمان",73,"ن",1,0],["صَيحَةٌ زلزَلَ الضلالَ صَداها","وَوَعَتْها أُذْنُ الهدى تغريدا",74,"د",2,0],["صيرت حاتم طي يزري به","زار ويسخر إن تذوكر ساخر",75,"ر",1,0],["صِيدٌ لأصْيدَ، لَستَ تُبصرُ جمرَةً","فيه النّاسِ لم تكُ قَطَرةً في صُلبِهِ",76,"ب",2,0],["صيّرْ عَتادَكَ تقوى اللَّهِ تَذخَرُها،","يُنَجّيكِ منه السّابحُ العَتَدُ",77,"د",1,1],["صَيْدَاءَ شأمِيّةٍ حَرْفٍ كمُشْتَرِفٍ","إلى الشِّخاصِ من التّضغانِ محْجومِ",78,"م",1,0],["صَيَّرتِ للزوّارِ ثَدْيَكِ مَوْرِداً","إمّا ارتوتْ فئةٌ عصرتِ إلى فئهْ",79,"ا",2,0],["صيامٌ شُرْبٌ يستحثُّ كؤوسَه","أراعدُ بالخابور نوقٌ وأجمال",80,"ل",1,0],["صيغ من جوهرٍ مصفّى ً طباعاً","لا علاجاً بكيمياء مُصَفِّ",81,"ف",1,0],["صَئُولٌ ولِلأَبْطَالِ هَمْسٌ مِنَ الْوَنَى","ضروبٌ وقلبُ القرنِ فى صدرهِ يعدو",82,"د",2,0]]}