],[585,"مهلاً فلست بجاحدٍ أو عات","https://www.poetsgate.com/ViewPoem.aspx?id=161934",""],[3859,"رنت بلابلُ في ودٍ من السلم","https://www.poetsgate.com/ViewPoem.aspx?id=124438",""],[5232,"موسمُ العشَّاق","https://www.poetsgate.com/ViewPoem.aspx?id=213610",""],[5268,"شروق","https://www.poetsgate.com/ViewPoem.aspx?id=207006",""],[5376,"لا تَسلْ عني فأنَّي","https://www.poetsgate.com/ViewPoem.aspx?id=198988",""],[5582,"لِمَنْ الظُّعْنُ تَرْسُبُ وَالقُبَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=186705",""],[5664,"هدير الماء","https://www.poetsgate.com/ViewPoem.aspx?id=176679",""],[5972,"متى مضر الحمراء تطلب ثارها","https://www.poetsgate.com/ViewPoem.aspx?id=170786",""],[6031,"هَوىً يَقُضُّ حَيازِيمَ الحَشَا وهَوىً","https://www.poetsgate.com/ViewPoem.aspx?id=46318",""],[6031,"يا سَاكِنِيْ الخَطِّ في قَلْبي لَكُمْ خِطَطٌ","https://www.poetsgate.com/ViewPoem.aspx?id=46308",""],[6102,"قاف قهر","https://www.poetsgate.com/ViewPoem.aspx?id=184627",""],[422,"بلغتُ بحمد الله ما أنا طالبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22247&r=&rc=3",""]],"verses":[["وَزَفرَةٍ لَم تَسَعْها أَضلُعِي عَلِقَتْ","بِغَضبَةٍ خِلتُها بَينَ الحَشى لَهَبا",0,"ب",2,0],["وَزَفيرٌ لَو عَلِمتَ بِهِ","خِلتَ نارَ الفُرسِ في بَدَني",1,"ن",2,0],["وَزَفرَةٌ تَعتَريهِ كُلَّما ذُكِرَت","مَيٌّ لَهُ أَو نَحا مِن نَحوِها البَصَرا",2,"ر",2,0],["وزَفّت لنا الدستور أحرارُ جيشنا","فأهلاً بما زفّت وشكراً لمن زقّا",3,"ق",2,0],["وزُفَّت إلى شَربِ كرام فمهْرجوا","بها مِهْرجاناً غاب عنه مَناحسه",4,"س",2,0],["وَزَفَّتِ الشَولُ مِن بَردِ العَشِيِّ كَما","زَفَّ النَعامُ إِلى حَفّانِهِ الروحُ",5,"ح",1,0],["وَزُفَّ الراحَ وَالراحا","تِ في أَيّامِكَ السَبعَه",6,"ع",2,0],["وَزِفَّ الراحِ لا زِلتَ","سَعيدَ الجَدِّ وَالبَختِ",7,"ت",1,0],["وزفرةٍ موصولةٍ بزفرةٍ","تَصْعَدُ عن نارِ حشىً مُلَذَّعِ",8,"ع",1,0],["وزَفُّوها مُقنَّعةً فزفُّوا","بها الأغلالَ شتَّى والقُيودا",9,"د",2,0],["وَزَفيرٌ تَظُنُّ منه صُدوراً","صادحاتٍ يَعْتادُهُنَّ زُقاءُ",10,"ا",2,0],["وزفَّ لنا زيْفَ الأماني عُلالةً","لعلَّ بنا حُبَّ السيادة يُودي",11,"د",2,0],["وزفّهُ بلبل لعوبٌ","في حضنه وردة خليعَه",12,"ع",2,0],["وزفزفتْ للزِّبانى منْ بوارحها","هيفٌ أنشَّتْ بها الأصناعَ والخبرا",13,"ر",2,0],["وزفرةٍ تحطم الضلوع لها","على زمان عريت من قشبه",14,"ب",2,0],["وزفرت عل زوافري","تجدي فزادت في ذواها",15,"ا",3,0],["وَزُفَّهُ تَرقُصُ مِن حَولِهِ","عَقارِبٌ كَالبُختِ أَو كَالنَعام",16,"م",1,0],["وزَفيري على المنى وشهيقي","وهيَ صرعى على يقيني القتيلِ",17,"ل",1,0],["وَزَفيرٍ أَمسى إِذا قَدَّسته الروحُ","ضَرباً من أَقدَسِ الأَنغامِ",18,"م",1,0],["وَزَفيرُ الفُؤادِ يَعلو تباعاً","فَتوافيهِ مُقلَتي بِالبُكاءِ",19,"ا",2,0],["وزُفّت إليه بأمرِ الإله","فأَلبسه الإله سِربالَها",20,"ل",3,0],["وزفت رياض الأنس في عرصاته","فاربت على نبت الرياض الحثاحث",21,"ث",1,0],["وَزَفَراتٍ تَكادُ وَجداً","تَنفَضُّ مِن حَرِّها الضُلوعُ",22,"ع",1,0],["وَزفرةِ وجدٍ رمت بالصَبر كظمَها","فَما كدتُ حتّى أَعقَبتني الأَسى ضِعفا",23,"ف",2,0],["وَزفرةٍ تلو أُخرى بت أَقذِفُها","يكاد ينشقُّ من تسعيرها الغلس",24,"س",1,0],["وَزَففتها لحماكَ ألطفَ تُحفةٍ","وَالطيبُ ليسَ يردّ مهما زارا",25,"ر",2,0],["وَزفّت وهيَ في حللٍ وحليٍ","يَغارُ الوشيُ منها والعقودُ",26,"د",1,0],["وزفَّ إليه القضاءُ العجيبُ","يدى مترَفٍ أعتَمتهُ الحياه",27,"ه",1,0],["وزفرات قلبك يا غادتي","هزيم الرياح على رابيه",28,"ي",2,0],["وَزَفَّ لِيَ الدُنيا عَقيلَةَ خاطِبٍ","فَما خِلتُهُ إِلّا كِتابَ صَداقِ",29,"ق",1,0],["وَزَفير كَرب راح يَن","فخ في أَنابيب العِظام",30,"م",1,0],["وزفرةٌ موصولةٌ بزفرةٍ","ومدمعٌ على الخدود سافح",31,"ح",1,0],["وزفَّت إليه كلَّ عذراء باكرٍ","كما زفَّت البيضُ الحسانُ الكواعبُ",32,"ب",1,0],["وزفاف خير عرس","زانها أمن وطهر",33,"ر",1,0],["وزفير أنفاس يرددها الأسى","كادت تقد بها الحشا والأضلع",34,"ع",1,0],["وزفّ إكليل زهر ليس ينفعني","كأنّه حجر من فوق أكفاني",35,"ن",2,0],["وزفرةٍ أَعدِي بها عاذلي","كم لسعةٍ قد أعيت الراقيا",36,"ي",2,0],["وزفيرٍ علَّمتُ منه حمامَ ال","دوح ما كان من حنينٍ وسجع",37,"ع",1,0],["وزفي إلى علياك كلَّ خريدة","من النظم بكرٍ ضاق عن كتمها الخدر",38,"ر",1,0],["وزفرةِ صدرٍ غداةَ النوى","وقد قوَّضَ الحيُّ لم تَبْرُدِ",39,"د",1,0],["وزفرةٍ مِن بعدِ أهلِ حاجرٍ","تكادُ أن تنقدَّ منها أضلُعي",40,"ع",2,0],["وزفرتي حيرة ما غادرت رمقا","إن الحشاشة باقيها من الحجج",41,"ج",1,0],["وزفرة الشوق مني زجل","فمقلتي هملت من فرط ذي أجج",41,"ج",1,0],["وزفرة يوم ساروا لو دلفت بها","إلى المودّع قيد الرمح لاحترقا",42,"ق",2,0],["وزَفرةٌ ملأَ الأكْوانَ لاهِبُها","وما سرَتْ وبِقلبي وحدهُ اشْتعلَتْ",43,"ت",1,0],["وزُفَّ الطّلا واِشرَب على وردِ خدِّها","فشُرْبُ الطِلا يحلو على الوجنةِ الحَمرا",44,"ر",2,0],["وزفت عروس القرب ليلة قدرنا","وفي ذَكَرِ الذكر استلذَّ المجامع",45,"ع",1,0],["وَزَفَرَت فيهِ السَواقي وَزَفَر","بَغرَةَ نَجمٍ هاجَ لَيلاً فَبَغَر",46,"ر",1,0],["وزفاف بهِ الأحبّة سُرّت","وسَرى بشرهُ بكلِّ بلادِ",47,"د",1,0],["وَزفاف فيه قد نل","نا معاً كلّ الأماني",48,"ن",2,0],["وَزَفَفْتُها تُهدى إِلَيهِ وإنّها","مِن أَحسَنِ الأَبكارِ في زيناتِها",49,"ت",3,0],["وزُفّها صِرْفاً علينا وإنْ","تبغ لنا فاصنعْ كما نبغي",50,"غ",2,0],["وزُفّوها علينا با","بليّاً غيرَ مُسْطارِ",51,"ر",1,0],["وزفت له الدنيا عروس حلابها","فقال لها ميلي فحلك يحرم",52,"م",1,0],["وَزُفَّتْ عَرُوسُ الرَّوْضِ في حَلْيٍ نَوْرِهَا","وَجَلَّلَهَا مِنْ آسِهَا الشَّعَرُ السَّبْطُ",53,"ط",1,0],["وزَفَّ الروضُ خَوداً لَوْ تَهَادَتْ","لَما ذُكَرتْ سُلَيْمى والرَّبابُ",54,"ب",1,0],["وزفت عروس الروض في ثوب سندس","يوشي بأنداء السماء ويوشم",55,"م",1,0],["وزفّت له الدنيا عروس جلالها","فقال لها ميلي فحبك يحرم",55,"م",1,0],["وَزَفَفتُها لِمَقامِكُم تَمشي عَلى اِس","تِحيا فَيُزعِجُها الوَنى تَرغيبا",56,"ب",2,0],["وَزَفرَتي تَنطِقُ عَن غُلَّةٍ","وَعَسكَرُ الصَبرِ لَدَيَّ فَريق",57,"ق",1,0],["وزَفَفْتُها زَفَّ الهُدِيِّ مُهَنِّئاً","بقُدومِ عِيدٍ سيقَ خَيْرَ مَساقِ",58,"ق",1,0],["وَزَفْرَةُ مُغْرًى بِالشُّجُونِ كَأَنَّمَا","لَهُ مُهْجَةٌ بِالشَّجْوِ يَنْعَمُ بَالُهَا",59,"ل",3,0],["وزفَّها تحت الدجى فاشتبهتْ","مدامهُ وخدّه المورَّد",60,"د",1,0],["وزفيري ثقّف حنايا ضلوعي","فعلى ودِّ مَن تبين حواني",61,"ن",2,0],["وَزَفَّت إليَ الأعدادِ من كلِّ وجهةٍ","أعاريبُها من كلِّ صرمٍ منجنَجِ",62,"ج",1,0],["وزف القريع أمام الافال","وينسى التخيل عند القطم",63,"م",1,0],["وزففت حرَّة مدحةٍ فخريةٍ","تركت عبيداً وهو بعض عبيدي",64,"د",2,0],["وزفرة محزون كأن ضرامها","لفيحة جمر في الجوانح ما يخبو",65,"ب",2,0],["وزفَّهُنَّ بشَمَّاسٍ إلى بِيَعٍ","تدقُّ إِن أذَّنَ النساكُ ناقوسا",66,"س",2,0],["وزفت ادال إليك فاضحى ال","سرور بيمن الزفاف لدينا عميم",67,"م",1,0],["وزفّة اللَّيْلِ بلا مُمَاثِل","تزيّنتْ بالشَّمْعِ والمَشاعِل",68,"ل",1,1],["وزففت أبكار المكارم للورى","إذ عز ءات منهم بعوان",69,"ن",1,0],["وزف من الاعراب بكرا تغزلت","وحاكت تسيما بعد ان طييت عطرا",70,"ر",2,0],["وَزفّت مِن عُمومته إِلَيهِ","فَتاةٌ ما رَأَت إِلا الخِباءا",71,"ا",3,0],["وزف في ريقه صهباء أبدلها","عن الحباب جماناً في لئاليه",72,"ي",2,0],["وزفوا للقياهم بجيش عرمرم","ولم يثبتوا عند اللقاء ولا اشتدوا",73,"د",3,0],["وزفها وقيان الورق قد صدحت","والطل نقطها بالؤلؤ الرطب",74,"ب",1,0],["وَزُفَّت نَحوَكَ الصَهباءُ صِرفاً","تَسيرُ بِها وَتَحمِلُها الدِنانُ",75,"ن",1,0],["وزفيرٍ حوّلته لصريرٍ","ملأ الخافقين غرباً وشرقا",76,"ق",2,0],["وزف إلى الشعر دنياي زوجة","أمتعها لكنما الزوج مفلس",77,"س",1,0],["وَزَفَفْتُهَا مِسكيَّةً","في ريطتي خَزٍّ وقَارِ",78,"ر",1,0],["وَزَفَّت كُؤسُ الراحِ راحَةً أَغيَدَ","فَسُرَّت وَغُمَّت حِزبَهُ وَكَواشِحُه",79,"ح",2,0],["وَزَفسُ إِلى الحَربِ حَثَّهُما","وَجَمعُ السُرى واحداً هَجَما",80,"م",2,0],["وَزَفسُ شَهِيدٌ عَلى تِي العُهُودِ","ومَدَّ عَصاهُ لآلِ الخُلُودِ",81,"د",1,0],["وزَفسُ بَلاهُ بِكَفِّ البَصَر","وَأَهلَكَهُ عِبرَةً لِلبَشَر",82,"ر",1,0],["وَزَفسُ غُلُوكُس رُشداً سَلَب","فَنَالَ نُحاساً وَأَعطى ذَهَب",82,"ب",1,0],["وَزَفَرَةُ مَقتُولٍ وَنَعرَةُ قاتِلٍ","وَسيلُ دِماءٍ فَوقَ أَرضٍ تَرَجرَجَت",83,"ت",1,0],["وَزَفسُ ارتَضَى طُروَادَةً فَتَأَثَّرُوا","أَعادِيَهُم حَتَّى الحَفِيرِ تَأَثُّرا",83,"ر",2,0],["وَزَفسُ غِلى الأُولِمبِ في طُورِايذَةٍ","لِمُجتَمَعِ الأَربَابِ في رَكبِهِ جَرى",83,"ر",2,0],["وزَفرَةُ مَقتُولٍ ونَعرَةُ قاتِلٍ","بِسَيلِ دِماءٍ بالأَسِنَّةِ مُهرَقِ",84,"ق",1,0],["وَزَفسُ بَينهُم أَثارَ اللَغبا","يُمطِرُ طَلّا بِدَمٍ مُخضَّبا",85,"ب",2,0],["وَزَفسُ هَكطورَ عَنِ النَقعِ حَجَب","وَعَن ضَجيجِ القَومِ في ذاكَ اللَجَب",85,"ب",1,0],["وَزَفسُ في إيذَةَ بِال