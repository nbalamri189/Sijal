",""],[68,"صد حمى ظمئي لماك لماذا","https://www.aldiwan.net/poem1495.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85442","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85318","الطويل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140900",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39562","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39641","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39629","المتقارب"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20203","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16705","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16620","البسيط"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202531","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202698","المتدارك"],[33,"","https://poetry.dctabudhabi.ae/diwan/poem/10980","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9979","الخفيف"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9955","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54531","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54517","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141936","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43650","الطويل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24804","الخفيف"],[77,"","https://poetry.dctabudhabi.ae/diwan/poem/71640","الكامل"],[72,"عذيري مِنْهُ معرضًا متجنباً","https://www.poetsgate.com/ViewPoem.aspx?id=189419",""],[106,"شبل بشبل","https://www.poetsgate.com/ViewPoem.aspx?id=179705",""],[106,"الطبيب يس","https://www.poetsgate.com/ViewPoem.aspx?id=179703",""],[106,"حي اللاجئين","https://www.poetsgate.com/ViewPoem.aspx?id=179618",""],[106,"صاحب آويته","https://www.poetsgate.com/ViewPoem.aspx?id=179660",""],[106,"مولد الهادي الأمين","https://www.poetsgate.com/ViewPoem.aspx?id=179620",""],[106,"الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=179448",""],[106,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[106,"بطل الريف","https://www.poetsgate.com/ViewPoem.aspx?id=179606",""],[77,"فتحت سعودك كل باب مبهم","https://www.poetsgate.com/ViewPoem.aspx?id=34204",""],[77,"وسواسُ حليكِ أم هم الرقباءُ","https://www.poetsgate.com/ViewPoem.aspx?id=3296",""],[98,"أيها العصر","https://www.poetsgate.com/ViewPoem.aspx?id=55344",""],[98,"مؤتمر الجماد","https://www.poetsgate.com/ViewPoem.aspx?id=55343",""],[90,"ذكرى الهاشمي","https://www.poetsgate.com/ViewPoem.aspx?id=179163",""],[90,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[90,"أجب أيُّها القلب","https://www.poetsgate.com/ViewPoem.aspx?id=179171",""],[45,"زَعَمَ الغُرَابُ مُنَبّىءُ الأنْبَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=32958",""],[51,"يا أبا الفضل ريعُ شامِطْياقي","https://www.poetsgate.com/ViewPoem.aspx?id=30445",""],[51,"أيُّها الحاسدِي على صُحْبتي العُسر","https://www.poetsgate.com/ViewPoem.aspx?id=30624",""],[97,"قسوة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63642&r=&rc=188",""],[88,"قسَماً بالإله عزَّ وجلاَّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19555&r=&rc=58",""],[85,"مضناك جفاهُ مرقده","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9547&r=&rc=37",""]],"verses":[["قَساطِلاً مِثلَ غَوادي المُزنِ","تَجري بِضَربٍ صادِقٍ وَطَعنِ",0,"ن",1,0],["قَسَماً بِرَبِّ الراقِصاتِ هَوىً","أَمَمَ البِناءِ العَودِ مَوجِفُها",1,"ف",3,0],["قَسَماً بِالأَشاعِثِ الشُمصِ أَدَّت","هُم إِلى المَأزَمينَ قودٌ وَخوصُ",2,"ص",1,0],["قَسماً بِشُعثٍ جَعجَعَت لَهُمُ","بِالمَأزِمَينِ ظَوالِعٌ خُصًّ",3,"ص",1,0],["قَسَمتُ زَفيرَ الوَجدِ بَيني وَبَينَهُ","دَواليكَ أَقريهِ اللَواعِجَ أَو يَقري",4,"ر",2,0],["قَسَماً بِالبَيتِ طُفتُ بِهِ","وَبِرَمي جَمرَةِ العَقَبَه",5,"ب",2,0],["قَسَموا السوءَ بَينَ عَيني وَقَلبي","لِم جَنى ناظِري فَعَذَّبَ قَلبي",6,"ب",2,0],["قَسيمُ النارِ جَدّي يَومَ يُلقى","بِهِ بابُ النَجاةِ مِنَ العَذابِ",7,"ب",1,0],["قَسَماً بخُوصٍ شَفَّها عَقْبُ السُّرى","حتى رَثى لابنِ اللَّبونِ البازِلُ",8,"ل",1,0],["قَسَماً بثَغْرٍ في رُضابِكِ كارِعٍ","فكأنَّهُ حَبَبٌ على صَهْباءِ",9,"ا",2,0],["قَسَماً يا عَبلَ يا أُختَ المَه","بِثَناياكِ العِذابِ القُبَلِ",10,"ل",1,0],["قَسَماً بِالَّذي أَماتَ وَأَحي","وَتَوَلّى الأَرواحَ وَالأَجساما",11,"م",2,0],["قَسَماً ما مَلَأَتُ عَينَيَّ مِن شَخ","صِكِ إِلّا ذَكَرتُ حورُ الجِنانِ",12,"ن",1,0],["قَسَماً بمَنْ رفَعَ السّماءَ بغيْرِ ما","عمَدٍ ورفّعَ فوقَها إدْريسا",13,"س",2,0],["قَسماً باللّيلِ وما وسَقا","وإيَاةِ البدْرِ إذا اتّسَقا",14,"ق",2,1],["قَسَماً بِالْكَوَاكِبِ الزُّه","رِ وَالزُّهْرُ عَاتِمَه",15,"ه",1,1],["قَسَماً بِجُودِكَ وَهْوَ أَيُّ أَلِيَّةٍ","وَبِعِزِّ مُلْكِكَ وَهْوَ أَسْمَى مُقْسَمِ",16,"م",1,0],["قَسَماً إِنَّهُ لَحَيٌّ َضنِينٌ","وَهَبَ الْبَاسَ شَأْنَه والْبَسَالَهْ",17,"ل",2,0],["قسِّمْ زَمانَكَ عَبْرَةً أو عِبْرَةً","هَذي ثَراهُ وهَذِهِ آثارُهُ",18,"ر",2,0],["قَسَماً بالدُّعاءِ في عَرَفاتٍ","ومِنىً حيثُ مَجْمَعُ الحُجّاجِ",19,"ج",1,0],["قَسَماً بِمُهْدِيْكِ الَّذِي أَنْوَارُهُ","كَالشَّمْسِ إلاَّ أَنَّهَا لاَ تَغْرُبُ",20,"ب",1,0],["قَسَماً بِرَبِّ البُزْلِ وَهْيَ طَلاَئِحٌ","نَحَتَتْ مَنَاسِمَ سُوقِهَا الْبَيْدَاءُ",21,"ا",2,0],["قَسَماً لأَنْتَ مَلاَذ كُلِّ رَعِيبَةٍ","وَمَأَمَّ مَنْ ضَاقَتْ بِهِ الغَبْراءُ",21,"ا",2,0],["قَسَّمتُها قِسمَينِ كُل","لَ مُوَجَّهٍ يُرمى بِها",22,"ب",3,0],["قَسَما الطارِفَ التَليدَ مِنَ الغُن","مِ فَآبا كِلاهُما ذو مالِ",23,"ل",1,0],["قَسَمتَ ما جَمَعَت كَفّاكَ مِن نَشَبٍ","عَلى بَنيكَ فَكُنتَ الوالِدَ الحاني",24,"ي",1,0],["قَسَماً لَو انَّ المَوتَ يَقبَلُ فِديَةً","عَزَّت لَكُنتُ بِمُهجَتي لَكَ فادي",25,"ي",1,0],["قسماً بِما بَينَ الحَطيمِ إِلى الصَفا","مِن طائِفٍ مُتَنَسِّكٍ أَو ساعِ",26,"ع",1,0],["قَسَماً بِمَن ضَمَّت أَباطِحُ مَكَّةٍ","وَبِمَن حَواهُ مِنَ الحَجيجِ المَوقِفُ",27,"ف",1,1],["قَسَماً لَقَد وَفّى المُنى وَنَفى الأَسى","مَن أَقدَمَ البُشرى بِأَنَّكَ صادِرُ",28,"ر",1,0],["قَسيمُ المُحَيّا ضَحوكُ السَماحِ","لَطيفُ الحِوارِ أَديبُ الجَدَل",29,"ل",1,0],["قَسِمَةُ الخَمْسَةِ لَوْ أُنْصِفَتْ","لَقَلَّ أَنْ تُوفَى بِخَمْسِينِ",30,"ن",1,0],["قُسِمَتْ حُظُوظُ النَّاسِ إِلاَّ أَنَّهُ","لا حَظَّ فِي الدُّنِيَا كَحَظِّ المُنْعِمِ",31,"م",1,0],["قَسيمُ الجَحيمِ فَهَذا لَهُ","وَهَذا لَها بِاِعتِدالِ القِسَم",32,"م",1,0],["قِستُ مَا كَانَ قَبلَنَا مِن هَوَى النَ","اسِ فَما قِستُ حُبَّها بمِثَالِ",33,"ل",1,0],["قسماً بوجهك في الضياء وإنه","شمسٌ تمدُّ الشمس بالأنوارِ",34,"ر",1,0],["قسماً بعزمك في المضاء فإنه","سيفٌ تجرّده يدُ الأقدارِ",34,"ر",1,0],["قسماً بهديك في الضياء وإنه","شمس تمدُّ الشهب بالأَنوارِ",35,"ر",1,0],["قسا صخره لكن تفجّر ماؤه","فلان بكفّ العيش منه مجسّه",36,"س",2,0],["قَسيمٌ مِن فُؤادِكِ حَيثُ حَلَّت","بِيَبرينَ الأَحِبَّةُ أَو وَبارِ",37,"ر",1,0],["قَسامَةُ أُمُّكُم إِن تَنسُبوها","إِلى نَسَبٍ فَتَأنَفُهُ الكِرامُ",38,"م",1,0],["قسماً بسورةِ عارضيكِ فإنها","كالنملِ عند بصائر الشعراء",39,"ا",2,0],["قسماً ما حلت عن عهدِ الوفاء","بعد مصرَ لا ولا نيلَ بكائي",40,"ي",1,1],["قسمتُ بين ظبا الملاح تغزّلي","ولمدح إنشاءِ الملوكِ ثنائي",41,"ا",2,1],["قسا فوقَ ما تقسو الجبالُ فلمْ يجبْ","نِدائِي وأصداءُ الجبالِ تجاوِب",42,"ب",1,0],["قسماً لقد أفردت في نظمٍ وفي","ودٍّ ففي الحالين أنتَ حبيب",43,"ب",1,0],["قسماً لوْ لم تضمّ على","كأسها طارت من العَبَثِ",44,"ث",1,0],["قسمت أغزالَ شعري والمديح لها","نظم الشذور ونظم الدر في التاج",45,"ج",1,0],["قسماً بسؤددك الجليّ فإنَّه","منهاجُ فضلٍ ما له من هاج",46,"ج",1,0],["قسماً لو أنَّ الفضل مثلك صورةً","لحللتَ منها في مكان الناظر",47,"ر",1,0],["قسماً بمن جعل الفناء مسافة","إنا على خطرٍ من الأخطار",48,"ر",1,0],["قستْ وقالت ترى حسني فقلتُ لها","غطِّي هواكِ وما ألقى على صبري",49,"ي",1,0],["قسماً بمجدك يا إمام زماننا","إن المدائح إذ رجتك لفائزه",50,"ه",1,1],["قسماً لقد رجعت بي الدُّنيا إلى","مغناك بعد النأي أحسن مرجع",51,"ع",1,0],["قسماً بمن جعل الأسى بك لذةً","والدمع راحة من يحبّ ويعشق",52,"ق",1,0],["قسماً بغصن قوامه المتمايل","إنِّي لتعجبني عليه بلابلي",53,"ل",2,1],["قسماً ببيتك في المعالي إنني","أولى ببيتِ سوايَ حيث يقول",54,"ل",1,0],["قسماً لو اسْتطاعت إليك جسومهم","بعثت دروج المدح من أوصالها",55,"ه",2,0],["قسماً لقد نقصت وأعوزت العلى","يا شوقها لتمامها وكمالها",56,"ه",2,0],["قسماً بمن أعلى 