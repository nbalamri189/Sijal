{"poems":[[23,"لك الخير غضي اللوم عني فإنني","https://www.aldiwan.net/poem21238.html","الطويل"],[23,"لقد عظمت فينا الرزية إننا","https://www.aldiwan.net/poem21507.html","الطويل"],[53,"أقول وقد قالت لطالب رفدها","https://www.aldiwan.net/poem65518.html","الطويل"],[93,"سيرت في فجر الحياة سفينتي","https://www.aldiwan.net/poem62730.html","عموديه"],[72,"ترى كم قد بدت منكم","https://www.aldiwan.net/poem42417.html","الهزج"],[63,"تناهى فاطمأن إلى العتاب","https://www.aldiwan.net/poem51802.html","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55161","الوافر"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67298","المتقارب"],[136,"وأشياوات جمع الشيء معها","https://www.aldiwan.net/poem54664.html","الوافر"],[147,"مساعيك لا تحصى فتدرك بالعد","https://www.aldiwan.net/poem11749.html","الطويل"],[164,"قد أوعدتني بالزيارة في الكرى","https://www.aldiwan.net/poem58874.html","الكامل"],[173,"أبى الدهر أن يلقاك إلا محارباً","https://www.aldiwan.net/poem1599.html",""],[214,"قسما بحفظ عهودكم وودادي","https://www.aldiwan.net/poem13298.html","الطويل"],[305,"وأشياء مما يعطف المرء ذا النهى","https://www.aldiwan.net/poem45450.html","الطويل"],[422,"هاج القرام وهيجا بلبالي","https://www.aldiwan.net/poem54163.html","الكامل"],[445,"هل تثنين غروب دمع ساكب","https://www.aldiwan.net/poem34884.html","الكامل"],[466,"أما اذا سلم الامام الأعظم","https://www.aldiwan.net/poem16018.html","الكامل"],[563,"بعيد الشبه يا عيني","https://www.aldiwan.net/poem34737.html","الهزج"],[592,"إلى الله في كشف المهمات نرغب","https://www.aldiwan.net/poem11511.html","عموديه"],[866,"","https://poetry.dctabudhabi.ae/diwan/poem/198794","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59413","الخفيف"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203792","الخفيف"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126188","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101062","الوافر"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60906","الطويل"],[345,"","https://poetry.dctabudhabi.ae/diwan/poem/124710","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100417","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201757","الطويل"],[3038,"","https://poetry.dctabudhabi.ae/diwan/poem/124277","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89385","الطويل"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46016","البسيط"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85123","الطويل"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44914","الكامل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97066","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90849","الكامل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136446",""],[4579,"","https://poetry.dctabudhabi.ae/diwan/poem/205455","المتقارب"],[4869,"غاب اتصاله","https://www.poetsgate.com/ViewPoem.aspx?id=151621",""],[4916,"لبيه ياهادم اللّذات","https://www.poetsgate.com/ViewPoem.aspx?id=135386",""],[4988,"أحفاد الاجداد","https://www.poetsgate.com/ViewPoem.aspx?id=196636",""],[5008,"فاقد حنان","https://www.poetsgate.com/ViewPoem.aspx?id=27311",""],[5030,"غزوة أحد","https://www.poetsgate.com/ViewPoem.aspx?id=215625",""],[592,"ألا قل لذي الجهل المركب إنما","https://www.poetsgate.com/ViewPoem.aspx?id=128806",""],[5488,"وآشيب رأسي وا محنتي والوسف","https://www.poetsgate.com/ViewPoem.aspx?id=100735",""],[5561,"على قارعة الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=195028",""],[5606,"أنا على عهدالوفاء","https://www.poetsgate.com/ViewPoem.aspx?id=194981",""],[5652,"نايح الورق","https://www.poetsgate.com/ViewPoem.aspx?id=208685",""],[5848,"عيضه","https://www.poetsgate.com/ViewPoem.aspx?id=50584",""],[5956,"سرقوا دارة ابنتي هنادي","https://www.poetsgate.com/ViewPoem.aspx?id=210650",""],[6046,"أنا بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=35208",""]],"verses":[["وَأَشيَبَ مَيمونَ النَقيبَةِ يُبتَغى","بِهِ الخَطَرُ الأَعلى وَطِفلاً مُؤَمَّلا",0,"ل",2,0],["وَأَشيَبَ ثَوباهُ الوَقارُ وَناشِقٍ","إِذا اِنقَشَعَت عَنهُ الضَبابَةُ كَالبَدرِ",1,"ر",1,0],["وأشياء شتى من قلى وملالة","ومن بَدَلٍ يحلى بعين فَيُعشق",2,"ق",1,0],["وَأُشيدُ مِثلَ الناسِ مَجداً زائِفاً","وَأَشُدُّ حَولَ الروحِ ثَوبَ رُغامِ",3,"م",1,0],["وَأَشياءٌ رَأَيناها","وَقُلنا ما رَأَيناها",4,"ا",3,0],["وأشيبَ عاينَ العلياءَ طِفْلاً","فقارعَ قبل تقريعِ العِتابِ",5,"ب",1,0],["وَأَشْيَاخٌ مَيَامِينٌ حِصَافٌ","تُزَكِّي مَا يَقُولُونَ الفِعَالُ",6,"ل",1,0],["وأشياعُ أَحْمَدَ إذ شايَعوا","على الحقِّ ذي النورِ والمَنْهَجِ",7,"ج",1,0],["وَأشيَاوَاتُ جَمعُ الشَّيءِ مَعهَا","إِشَاوَاتٌ وأَشيَاءُ أشَاوَى",8,"ا",3,1],["وَأَشياخُكَ الماضونَ في سَنَنِ العُلى","أَقاموا كِراماً وَاِستَقاموا عَلى حَردِ",9,"د",1,0],["وأشيَع أنك راكبٌ فتبادرت","لتراكَ أربابُ المدائنِ والقرى",10,"ر",2,0],["وَأَشياءُ لَو عَدَّدتُها طالَ شرحُها","وَلَم أُحصِها في مُحكَمِ النَّظمِ حاسِبا",11,"ب",2,0],["واشيم من نحو التنية بارقا","تضتر عنه عريب ذاك النادي",12,"د",2,0],["وَأَشياءُ مِمّا يُعطِفُ المَرءَ ذا النُهى","تَشُكُّ عَلى قَلبي فَما أَستَبينُها",13,"ه",2,1],["وأُشيمُ من برقِ الغُوَير لوامعاً","فإخاله تبسام ذات الخال",14,"ل",1,0],["وَأُشِيم بَرْقَ يمينه وجبينِهِ","وَيشُمُّ ريحَ أَوَاصِري ومَطالبي",15,"ب",2,0],["وأشيمُ برق الجودِ وهو على الورى","هامي السَّحابِ فلا يُبَلُّ صدائي",16,"ي",1,0],["وأشياخي إشاراتي","بدت من داخل الحجب",17,"ب",1,0],["وأشياء لا ندري بها غير أنها","يحار بها العقل السليم ويعجب",18,"ب",1,0],["وأشياخٌ كأنهمُ الثُريا","وتهديكَ النجوم إلى الرشادِ",19,"د",1,0],["وأشيرا بما يبلغ قصدي","ربما أرشد المشير المشارا",20,"ر",2,0],["وأشِيعي الحداد في دارنا البي","ضاء، واستعذبي ثياب الحداد",21,"د",1,0],["وأشيرَ نحوك والوجوه تحلِّقت","والنيلُ يعطي الخير من دفقاتهِ",22,"ت",2,0],["وأشياخ تولى الدهر عنها","فكانت في عداد الهالكينا",23,"ن",2,0],["وأشياخ قحطان وأشياخ يعربٍ","يُنفّض كلٌّ فَرْوَه ويُقمّل",24,"ل",1,0],["وأشياء ضاق النظم عنها وبعضها","يلوذ بظل الاستقالة شارحُه",25,"ح",2,0],["واشيعثُ من داب وعثاء السرى","حتى يعلَّ عواطش المران",26,"ن",1,0],["وأشياءَ أنساها الجَفا تذكرينها","وتأبي جروح القلب شرحاً وإسهابا",27,"ب",2,0],["وأشياخُنا والحال أفضل شاهد","على سيرة المختار سيرتُهم تبنى",28,"ن",2,0],["وأشياء من هذا القبيل جهلتها","وأضعاف أضعاف الحبوب فقيران",29,"ن",1,0],["واشٍ ينمُّ وَنَمامٌ يَشي أَبَداً","أَحبب بِذينكَ مِن واشٍ وَنَمامِ",30,"م",1,0],["وأشياخنا والمسلمين جيمعهم","فعفوك عني من خطاي أوسع",31,"ع",1,0],["وَأَشيدُ آمالي عَلى فَجواتِها","وَعَلى مَقاصِرِها وَلَكِن تَنهَدمْ",32,"م",1,0],["وأشياعكم ضاعت فحيت بوجهتٍ","رأت حرب قد سدت عليها رحابها",33,"ب",3,0],["وأشيم في الشام الشريفة كوكبا","إن قسته بالشمس فهي الدون",34,"ن",1,0],["واشياخه الاخيار قد شهدوا له","بفضل وزكتهم حقيقة أمره",35,"ر",2,0],["وأشياء قد ضفنني بالبلاد","ولست لهن بمستحلس",36,"س",1,0],["وآشيب عيني ما عرف حي او ميت","وآشيب عيني من يترجم معانيه",37,"ي",2,0],["واشيّد الحلم .. فوق حلوم","حلم الهنا / وابرك الحزّات",38,"ت",1,0],["واشيخهم اللي شيخته بشت وجناد","والشيخ لو بالبشت شاخت حليمه",39,"م",2,0],["واشيب عيني كل ماشفت لي زول","قمت اتذكر هاالغنج والفتوني",40,"ن",2,0],["وأشيعَ قتلُ محمّدٍ، لكنّما","يُحمى بأفئدةِ العبادِ الصالحة",41,"ح",2,0],["وأشياء أخرى لا تليق بعالم","أشعتم لها ذكراً وجهراً تجرثما",42,"م",2,0],["وآشيب رأسي وا محنتي والوسف","أقص كفي وأقطع صوابعه",43,"ع",2,1],["وأشياعٌ على جَسَدٍ تهاووا","مخالبُهم خطايا تستكينُ",44,"ن",1,0],["وأش ينفع التعبير لوكنت عبرت","مادام همي فاق كل أحتمالي",45,"ل",2,0],["وا شيب عين الي تلاوح سناها","لاقام تطري له على نايح الورق",46,"ق",1,0],["واشيل مع عيضه واريّح خفوقي","(( ابرّد الضيقه من الصدر بالعين ))",47,"ن",1,0],["وأشيم وجهك يا هنادي باسماً","وأرى حياتك ليس تشغل باليا",48,"ي",2,0],["وَأَشِيعِي الْمَجْدَ في كُلِّ الدُّنَى","بِسُيُوفٍ تَنْتَمِي لاِبْنِ الوليدْ",49,"د",1,0]]}