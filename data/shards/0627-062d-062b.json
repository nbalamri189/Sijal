{"poems":[[13,"قعقعت حضني حاجز وصحابه","https://www.aldiwan.net/poem2221.html","الطويل"],[46,"أدنياي اذهبي وسواي أمي","https://www.aldiwan.net/poem23401.html","الوافر"],[227,"كتبت يا واحد الأملاك والبشر","https://www.aldiwan.net/poem51013.html","البسيط"],[413,"متى ترني يا سعد والشوق مزعجي","https://www.aldiwan.net/poem53944.html","الطويل"],[456,"حملوك لو علموا من المحمول","https://www.aldiwan.net/poem56003.html","الكامل"],[475,"كم دون مسراك من بيد وأخطار","https://www.aldiwan.net/poem15202.html","البسيط"],[475,"هل في المنازل بعد القوم آثار","https://www.aldiwan.net/poem15240.html","البسيط"],[475,"كم رضت جامح قلبي عنكم فأبى","https://www.aldiwan.net/poem15242.html","البسيط"]],"verses":[["أَحُثُّ ثَلاثاً نِصفَ يَومٍ وَلَيلَةً","وَأَنتَ مُريحٌ عِندَ بَيتِكَ أَروَعُ",0,"ع",1,0],["أَحُثُّ الخَلقَ مِن ذَكَرٍ وَأُنثى","عَلى حُسنِ التَعبُّدِ وَالتَأَمّي",1,"ي",1,0],["أحثُّ نحوك آداباً مكلَّلَةً","بجوهرِ اللَّفْظِ فاشْرَبْها بلا كَدَرِ",2,"ر",1,0],["أحُثُّ إلى نجدٍ مطايا كأنَّها","لها قلبُ مفؤود الفؤاد إلى نجد",3,"د",1,0],["أحثو عيوناً بالتراب يروعني","بالأمس فيها الإثمد المكحولُ",4,"ل",1,0],["أحثُّ كلَّ عَفَرناةٍ هَمَلَّعَةٍ","مَوّارةٍ وأمونِ السيرِ مَوّارِ",5,"ر",1,0],["أحثُّهُ والهوى مِن فوقِ غاربهِ","يَحثُّني فهو في الحالينِ صبّارُ",6,"ر",1,0],["أحثُّ فيها علنداءً هملَّعةً","تفلي الفلاةَ إلى أبياتِها طَلَبا",7,"ب",2,0]]}