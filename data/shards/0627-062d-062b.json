{"poems":[[13,"قعقعت حضني حاجز وصحابه","https://www.aldiwan.net/poem2221.html","الطويل"],[48,"أدنياي اذهبي وسواي أمي","https://www.aldiwan.net/poem23401.html","الوافر"],[234,"كتبت يا واحد الأملاك والبشر","https://www.aldiwan.net/poem51013.html","البسيط"],[422,"متى ترني يا سعد والشوق مزعجي","https://www.aldiwan.net/poem53944.html","الطويل"],[463,"حملوك لو علموا من المحمول","https://www.aldiwan.net/poem56003.html","الكامل"],[482,"كم دون مسراك من بيد وأخطار","https://www.aldiwan.net/poem15202.html","البسيط"],[482,"هل في المنازل بعد القوم آثار","https://www.aldiwan.net/poem15240.html","البسيط"],[482,"كم رضت جامح قلبي عنكم فأبى","https://www.aldiwan.net/poem15242.html","البسيط"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112304","الطويل"],[3883,"","https://poetry.dctabudhabi.ae/diwan/poem/97677","الكامل"],[3996,"","https://poetry.dctabudhabi.ae/diwan/poem/114902","الطويل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81948","الطويل"],[5198,"على عيني","https://www.poetsgate.com/ViewPoem.aspx?id=135397",""],[6182,"قَدْر ما يَتَنَهَّدُ الربّانُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86105&r=&rc=2",""],[6189,"خميرة الممكنات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83561&r=&rc=28",""]],"verses":[["أَحُثُّ ثَلاثاً نِصفَ يَومٍ وَلَيلَةً","وَأَنتَ مُريحٌ عِندَ بَيتِكَ أَروَعُ",0,"ع",1,0],["أَحُثُّ الخَلقَ مِن ذَكَرٍ وَأُنثى","عَلى حُسنِ التَعبُّدِ وَالتَأَمّي",1,"م",2,0],["أحثُّ نحوك آداباً مكلَّلَةً","بجوهرِ اللَّفْظِ فاشْرَبْها بلا كَدَرِ",2,"ر",1,0],["أحُثُّ إلى نجدٍ مطايا كأنَّها","لها قلبُ مفؤود الفؤاد إلى نجد",3,"د",1,0],["أحثو عيوناً بالتراب يروعني","بالأمس فيها الإثمد المكحولُ",4,"ل",1,0],["أحثُّ كلَّ عَفَرناةٍ هَمَلَّعَةٍ","مَوّارةٍ وأمونِ السيرِ مَوّارِ",5,"ر",1,0],["أحثُّهُ والهوى مِن فوقِ غاربهِ","يَحثُّني فهو في الحالينِ صبّارُ",6,"ر",1,0],["أحثُّ فيها علنداءً هملَّعةً","تفلي الفلاةَ إلى أبياتِها طَلَبا",7,"ب",2,0],["أحُثّ مَطَايا الفِكرِ نحوَ ديارِهم","غَداةَ سَطَا دَهري فَقَصّ جَنَاحِيَا",8,"ي",2,0],["أَحثو الترابَ عَلى مفارقهِ","وَعَلى غضارة وجههِ النضرِ",9,"ر",1,0],["أحثَّ على خيرٍ وأسبغَ نائلاً","اذا راحَ كالسّيف الصَّقيل المُهَنَّدِ",10,"د",1,0],["أحث ركابي كالنعامة في الفلا","وأوردتها من كل مرٍّ وما حلا",11,"ل",2,0],["احث الخطا لك كلّما شفت برقٍ لاح","احس انّ هذا البرق بالذات يعنيني",12,"ن",2,0],["أحْثو دمي بين الأزقةِ بارداً","\"هلْ عُدتَ وحْدكَ\"؟ .. تسألُ البيبانُ",13,"ن",1,0],["أحثو حروفَ البوح كاكيَّةً","في كل فجٍ تلقف المَصرَعا",14,"ع",2,0]]}