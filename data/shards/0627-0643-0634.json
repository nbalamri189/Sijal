{"poems":[[95,"يا شاعر النيل جار النيل بالشيم","https://www.aldiwan.net/poem11298.html","البسيط"],[107,"في حمى الحق ومن حول الحرم","https://www.aldiwan.net/poem42091.html","الرمل"],[107,"حيوا الهلال وحيوا أمة النيل","https://www.aldiwan.net/poem43087.html","البسيط"],[69,"انظر بحقك في أمر الدواوين","https://www.aldiwan.net/poem18116.html","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54212","الرمل"],[447,"أراك يا زمني شططا","https://www.aldiwan.net/poem14457.html","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59433","الخفيف"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33850","الوافر"],[5198,"احساس الغروب","https://www.poetsgate.com/ViewPoem.aspx?id=135383",""],[5224,"يا حسن ما أجلاك في عيني وفي بصري","https://www.poetsgate.com/ViewPoem.aspx?id=121308",""],[5344,"تم إيداع الراتب ..!","https://www.poetsgate.com/ViewPoem.aspx?id=180711",""],[5688,"رحيل العشق","https://www.poetsgate.com/ViewPoem.aspx?id=200936",""],[5355,"حظي عنيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87130&r=&rc=25",""]],"verses":[["أَكْشِفْ بِحَزْمِكَ أَسْتَارَ الْحَفِيظَةِ عَنْ","فَخٍّ تُصادُ بِهِ الأَعْرابُ لِلْعَجَمِ",0,"م",1,0],["اكشفيها غُمّةً ليس لها","من كِفاءٍ غيرُ كشّافِ الغُمَمْ",1,"م",1,0],["اكشفِ البأساءَ وارحم أُمماً","تتلوَّى من مَلالٍ وسَأَمْ",1,"م",1,0],["اكشِف لَنا مِن خَفايا الغَيبِ ما كَتَمَت","حُجبُ الحَوادِثِ مِن مُرخىً وَمَسدولِ",2,"ل",1,0],["اكْشِفْ بِنَفْسِكَ أُسْوَاناً وَمَنْ مَعَها","مِنَ الصَّعِيدِ بَلاَ قَوْمِ مَسَاكِينِ",3,"ن",1,0],["اكْشفوا التُرْبَ عن الكَنْز الدفينْ","وارفعوا الستْرَ عن الصبح المبينْ",4,"ن",1,1],["أكشفت عني غطاء الصبر من حزن","والحزن يكشف عن ذي الصبر كل غطا",5,"ط",2,0],["أكشف الكرب واشف كل سقيم","واغفر الذنب واصح ليل العناد",6,"د",1,0],["أُكَشِّفُ مِنهُ كَلَّ صَباحِ يَومٍ","عُيوباً لَم تَكُن لي في حِسابي",7,"ب",2,0],["إكشف حسابك شوف كم لك في خفوقي من رصيد","جاتك مقاليدالحشا يالعذب نهاب القلوب",8,"ب",1,0],["اكشف ستاير عن سراير مخزونه","قد نالنا منها نفيحات على خطري",9,"ر",2,0],["اكشخ وسافر عن بلدكم بلادين","مسكين يحسب بالقرار اهتنينا..",10,"ن",2,0],["اكشف هموما على ذا القلب قد نزلت","وامنن بفتح لقلب غرّه الأمل",11,"ل",1,0],["أكشّفُ عن وجهِ صَبر جميلٍ","لعلّ الأمَاسِي تُريني غَدَا",12,"د",2,0]]}