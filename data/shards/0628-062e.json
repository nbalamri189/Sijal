"https://www.aldiwan.net/poem11521.html","عموديه"],[848,"","https://poetry.dctabudhabi.ae/diwan/poem/18011","الطويل"],[965,"","https://poetry.dctabudhabi.ae/diwan/poem/46009","الطويل"],[1132,"","https://poetry.dctabudhabi.ae/diwan/poem/18983","الطويل"]],"verses":[["بِخُفٍّ كَشِدقِ الأَعلَمِ اِسُصعِبَت بِهِ","عَلى ظِلِّ عُنقٍ ذي عَثانينَ مُرجِمِ",0,"م",1,0],["بِخِفافٍ فَوقَ أَيمانِ رِجالٍ","وَثِقالٍ فَوقَ أَعناقِ رِجالِ",1,"ل",1,0],["بَخيلٌ بِالسَلامِ إِذا اِلتَقَينا","وَلَكِنّي جَوادٌ بِالوَداعِ",2,"ع",1,0],["بِخَطوٍ يُمَزِّقُ بُردَ الصَعيدِ","وَرَكضٍ يُلَطِّمُ وَجهَ المَلا",3,"ا",1,0],["بخلائِقٍ نَفَحَتْ برَيّا رَوْضَةٍ","غَنّاءَ ذاتِ تبسُّمٍ ورَفيفِ",4,"ف",1,0],["بَخِلَ الغَيُورُ بِماءِ لِينَةَ فاحْتَمى","بِشَبا أسِنِّتِهِ الغَديرُ المُفْعَمُ",5,"م",1,0],["بَخِلَت بِإِرسالِ السَلامِ وَطِبُّها","لَو سَلَّمَت بِيَمينِها لَم تَجمُدِ",6,"د",1,0],["بخُطوبٍ أرَتْ حَديثَ سُلَيْما","نَ وجاءَتْ بالحادِثِ المُجْتاحِ",7,"ح",1,0],["بخَليفَةِ اللهِ المؤيَّدِ فارِسٍ","قَمَرِ المَعالي الأزْهَرِ الوضّاحِ",8,"ح",1,0],["بِخَلِيفةِ اللهِ الَّذِي فِي كَفِّهِ","غَيْثٌ يُرَوِّضُ سَاحَ كُلِّ جَدِيبِ",9,"ب",1,0],["بِخَيرِ خَليقَةٍ وَبِخَير خُلقٍ","خُلِقتَ فَزادَكَ اللَهُ الغَفيرَه",10,"ر",2,0],["بِخُدودِ الحِسانِ بِالأَعيُنِ النُج","لِ بِتِلكَ القُلوبِ وَالأَكبادِ",11,"د",1,0],["بَخَلتِ فَكانَ البُخلُ مِنكِ سَجيةً","فَلَيتَكِ ذو لونَينِ يُعطي وَيَمنَعُ",12,"ع",1,0],["بِخوصٍ مِنَ اِستِعراضِها البيدَ كُلَّما","حَدا الآلَ حَرُّ الشَمسِ فَوقِ الأَصالِفِ",13,"ف",1,0],["بِخَطمِهِ أَو مَسحَبِ التَصديرِ","بَينَ الحَشا وَظَلِفاتِ الكورِ",14,"ر",1,0],["بِخُبثِ البَذرِ يَنبُتُ حَرثُ تَيمٍ","فَما طابَ النَباتُ وَلا الحَصيدُ",15,"د",1,0],["بِخَيرِكُمُ نَفساً وَخَيرُكُمُ أَباً","أَعَزُّهُمُ حَيّاً عَلَيهِم وَهالِكا",16,"ك",2,0],["بِخَطيرَةٍ توفي الجَديلَ سَريحَةٍ","مِثلِ المَشوفِ هَنَأتَهُ بِعَصيمِ",17,"م",1,0],["بِخاتِمِكُم غصبَاً تَجُوزُ أُمورُهُم","فَلَم أرَ غَصبَاً مِثلَهُ يَتَغصَّبُ",18,"ب",1,0],["بَخِلتُ بِنَفسي أَن يُقالَ مُبَخِّلٌ","وَأَقدَمتُ جُبناً أَن يُقالَ جَبانُ",19,"ن",1,1],["بِخَمّارٍ مِنَ القَومِ","نَزَلنا أَم بِعَطّارِ",20,"ر",1,0],["بِخَيلٍ لاتُعانِدُ مَن عَلَيها","وَقَومٍ لايَرونَ المَوتَ عارا",21,"ر",2,0],["بِخَناطيلَ كَجِنّانِ المَلا","مَن يُلاقوهُ مِنَ الناسِ يُهَل",22,"ل",1,0],["بخلت بلُؤلُؤٍ ثغرها عن لاثمٍ","فتطوَّقت بمثال ما بخلت به",23,"ه",1,0],["بخوف السطا بالرعب ينصر والظبا","وداني الحيا في اليسر والعسر يهمر",24,"ر",1,0],["بخصرك والنهد نحو الهنا","فهذا أضم وذا أكسر",25,"ر",1,0],["بخدٍّ وخال على تبره","يشحّ على قبلةِ الوامق",26,"ق",1,0],["بخطوة ساعٍ مثابٍ إلى","حمى الفضل والكرم السابق",26,"ق",1,0],["بخلت بالشهدِ لا بالجبن تبعثه","لبئست الخلَّتان الجبن والبخل",27,"ل",1,0],["بَخْبَخٍ بَخْبَخٍ لأمِّك ما أسْ","وَرَ هِمّاتها إلى العليَاءِ",28,"ا",2,0],["بخيلٌ على إخوانهِ غيرَ أنهُ","يجود على من ناكَهُ بخَريبتِهْ",29,"ت",2,0],["بخ بَخ لإبراهيم من ضارِطٍ","ذي ضَرْطة مَرْهُوبة بَخ بَخِ",30,"خ",1,0],["بَخَسوني كبخس دهْري حُقوقي","واسْتعدُّوا عليّ كاستعدادِهْ",31,"د",2,0],["بخراءُ وقصاءُ في مغابنها","نَتنٌ مجيفٌ فكلها عَذِره",32,"ر",2,0],["بخَرٌ يصدعُ الصفا وخُشامٌ","وصُنانٌ فإنما هي حَشُّ",33,"ش",1,0],["بختريٌّ كأنه حين يمشي","يتثنى به من البان سبْط",34,"ط",1,0],["بِخِلَّيْنِ تمَّا بي ثلاثةَ إخوةٍ","جسومهم شتى وأرواحهم معا",35,"ع",2,0],["بخلن عنا بما يسألن من وتح","نزر وأجحفن بالألباب إجحافا",36,"ف",2,0],["بخبخٍ أيَّ سحاب","بخبخ ودقاً وبرقاً",37,"ق",2,0],["بُخِستُ وفُضّلوا حتى كأنيّ","حُبِيتُ بنقصِهم وحُبوا كمالي",38,"ل",2,0],["بخراء لو نكهتْ على صُمّ الصّفا","صدعتْ بنكهتها متونَ الجندلِ",39,"ل",1,0],["بخميسٍ له لجيبُ صهيلٍ","راغَ في عُرضهُ رُغاء الجمالِ",40,"ل",1,0],["بخيلٌ يُصَوِّمُ أضْيافَهُ","ويَبْخَلُ عنهمْ بأجرِ الصيامِ",41,"م",1,1],["بخيلٌ بجدواه بخيلٌ بأن يُرى","نسيم المُنى من نحوه يَتَنَسَّمُ",42,"م",1,0],["بخراءُ ذفراءُ ذاتُ قبحٍ","محلَّلٌ نيكُها محرّمْ",43,"م",1,0],["بخضابٍ فيه ابيضاض لوجهي","واسودادٌ لوجهك الملعون",44,"ن",1,0],["بَخِلتَ عليَّ بجدوى سواكَ","وضاق به بطنُك الأعكَنُ",45,"ن",1,1],["بِخَوصٍ كَأَعطالِ القِسِيِّ تَقَلقَلَت","أَجِنَّتُها مِن شُقَّةٍ وَدُؤوبِ",46,"ب",1,0],["بخُشُوعٍ واكتِئَابْ","لَسْتُ لأدري",47,"ي",1,0],["بخلاف العراق فهو لعمري","لضروبٍ من الجهالة مهد",48,"د",1,0],["بِخَيلِهم جابَ البِلادَ وَفَرى","قامَ بَعدَهُ اِبنُهُ مُظفّرا",49,"ر",2,0],["بِخَطبِكَ في القِطارِ أَبا حُسَينٍ","وَلَيسَ مِنَ الخُطوبِ الهَيِّناتِ",50,"ت",1,0],["بَخِلتِ عَلَيهِ في الحَياةِ بِمَوكِبٍ","فَتوبي إِلَيهِ في المَماتِ بِمَأتَمِ",51,"م",1,0],["بَخيلَةٌ بِمَآقيها فَلَو سُئِلَت","جَفناً يُعينُ أَخا الأَشواقِ لَم تُعِرِ",52,"ر",1,0],["بِخَيلٍ في الهِضابِ وَفي الرَوابي","وَنارٍ في القِلاعِ وَفي الطَوابي",53,"ا",3,0],["بخلنَ حتَّى بإهداءِ السلام لنا","والبخلُ فيهنَّ محسوبٌ من الكرمِ",54,"م",1,0],["بَخِلتَ عَنّا بِمُقرِفٍ عَطِبٍ","وَلَن تَراني ما عِشتُ أَطلُبُهُ",55,"ه",1,1],["بَخِلَت بِمَوجودِ النَوالِ وَإِنَّما","يَتَحَمَّلُ اللَومَ البَخيلُ الواجِدُ",56,"د",1,0],["بُخلٌ وَجَهلٌ وَحَسبُ المَرءِ واحِدَةٌ","مِن تينِ حَتّى يُعَفّى خَلفَهُ الأَثَرُ",57,"ر",1,0],["بَخِلَت جُفونُكَ أَن تَكونَ مُساعِدي","وَعَلِمتَ ما كَلَفي فَكُنتَ عَذولي",58,"ل",2,0],["بَخِعوا بِحَقِّ اللَهِ في أَعناقِهِم","لَمّا أُتيحَ لَهُم قَضاءً مُبرَما",59,"م",2,0],["بِخارَكَ لَم يَقُد فَرَساً وَلَكِن","يَقودُ الساجَ بَالمَرَسِ المُغارِ",60,"ر",1,0],["بَخ بَخ لَنا الشَرَفُ القَديمُ وَعِزُّنا","قَهَرَ البِلادَ فَما لَهُ تَنكيرُ",61,"ر",1,0],["بِخَيرِ عِبادِ اللَهِ بَعدَ مُحَمَّدٍ","لَهُ كانَ يَدعو اللَهَ كُلُّ الخَلايِقِ",62,"ق",1,0],["بِخَيرِ يَمينِ مَدعُوٍّ لِخَيرٍ","تُعاوِنُها إِذا نَهَضَت شِمالُ",63,"ل",1,0],["بِخِبرَينِ وَفراوَينِ صَيدٍ وَلَيسَتا","بِضَأنٍ وَلَم تُخرَز بِغَرفٍ كِلاهُما",64,"م",2,0],["بِخَيرِ يَدَي مَن كانَ بَعدَ مُحَمَّدٍ","وَجارَيهِ وَالمَظلومِ لِلَّهِ صائِمِ",65,"م",1,0],["بِخَيرِ أَبٍ وَاِسمٍ يُنادى لِرَوعَةٍ","سِوى اللَهِ قَد كانَت تُشيبُ النَواصِيا",66,"ي",2,0],["بخلت بما أبقته من أرماقنا","فاستأثرت بيقية الأرماق",67,"ق",1,0],["بَخِلْتُ بذكْرِ اللهِ من كلِّ جانبٍ","فهنّ بذكرِ اللهِ غيرُ خوالي",68,"ل",2,0],["بخيلٍ تَمُدُّ عليها الدُّجَى","وبِيضٍ تَرُدُّ عليها النَّهارا",69,"ر",2,0],["بخميسٍ كأنما حَجَبَ الشَّم","سَ وقد ثارَ نقعُه بضبَابِ",70,"ب",1,0],["بِخَيلٍ عَلَيها جِنَّةٌ عَبقَرِيَّةٌ","جَديرونَ يَوماً أَ