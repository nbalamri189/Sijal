.dctabudhabi.ae/diwan/poem/199413","الطويل"],[4085,"","https://poetry.dctabudhabi.ae/diwan/poem/105159","السريع"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127169","الوافر"],[4265,"","https://poetry.dctabudhabi.ae/diwan/poem/138723","البسيط"],[4278,"","https://poetry.dctabudhabi.ae/diwan/poem/144414","الرجز"],[4301,"","https://poetry.dctabudhabi.ae/diwan/poem/146706","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83638","الطويل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76715","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120322","الطويل"],[4691,"توضأ قلبي بماء الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=59823",""],[4702,"أبكم ومظلوم","https://www.poetsgate.com/ViewPoem.aspx?id=155208",""],[4829,"سنيني شيب","https://www.poetsgate.com/ViewPoem.aspx?id=34258",""],[5008,"ال رج ال","https://www.poetsgate.com/ViewPoem.aspx?id=34845",""],[5111,"لَوْعَةُ الشَّوْقِ","https://www.poetsgate.com/ViewPoem.aspx?id=212307",""],[5155,"من وحي المهرجان","https://www.poetsgate.com/ViewPoem.aspx?id=176557",""],[5183,"حد الطور","https://www.poetsgate.com/ViewPoem.aspx?id=186609",""],[5189,"إشراقة","https://www.poetsgate.com/ViewPoem.aspx?id=211849",""],[5219,"تشطير أبيات أبي نواس .. حامل الهوى تعب","https://www.poetsgate.com/ViewPoem.aspx?id=197680",""],[5277,"دع القيلَ..فلا بديل","https://www.poetsgate.com/ViewPoem.aspx?id=187711",""],[5277,"شمعةٌ في مهبّ الريحِ","https://www.poetsgate.com/ViewPoem.aspx?id=197557",""],[5302,"قرب الخليل","https://www.poetsgate.com/ViewPoem.aspx?id=200554",""],[5338,"نبهتني والكرى يطوي الدجى","https://www.poetsgate.com/ViewPoem.aspx?id=187811",""],[5387,"أميرة الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=53848",""],[5397,"تعجب الدهر من صبري ومن جلدي","https://www.poetsgate.com/ViewPoem.aspx?id=157958",""],[5651,"وفَينانةِ الفرْعِ فتّانةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=107001",""],[5691,"حمار الحطاب","https://www.poetsgate.com/ViewPoem.aspx?id=205825",""],[5701,"تعجبت حتى كدت لا أتعجب","https://www.poetsgate.com/ViewPoem.aspx?id=164590",""],[5725,"حملتك في قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=204867",""],[5742,"مولد النور","https://www.poetsgate.com/ViewPoem.aspx?id=206973",""],[5929,"لا تحسبي الحب لهوا","https://www.poetsgate.com/ViewPoem.aspx?id=196922",""],[5943,"تعجَّلَ بالرحيلِ","https://www.poetsgate.com/ViewPoem.aspx?id=61825",""],[5956,"تفتُّحُ قلب","https://www.poetsgate.com/ViewPoem.aspx?id=192126",""],[5973,"تعجلت الرحيل إلي الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=22123",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577061",""],[520,"الحمد لله على حالة","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577560",""],[6157,"وذات حنين تستهل دموعها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=558681",""],[463,"هل عند عينيك على غربِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59971&r=&rc=27",""],[463,"ألم أتحدّثْ والحديثُ شجونُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60200&r=&rc=256",""],[6350,"لاحَ وَعَقْدُ اللَّيْلِ مَسْلُوبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=24093&r=&rc=6",""],[6351,"جواب يفتش عن سؤال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86046&r=&rc=6",""]],"verses":[["تَعَجَّبَ صَحبي مِن بُكائي وَأَنكَروا","جَوابي لِما لَم تَسمَعِ الأُذُنانِ",0,"ن",1,0],["تَعَجَّبوا مِن تَمَنّي القَلبِ مُؤلَمُهُ","وَما دَرَوا أَنَّهُ خِلوٌ مِنَ الأَلَمِ",1,"م",1,0],["تَعَجَّبُ مِنها وُحوشُ الفَلاةِ","تَسري وَأَسرابُها رُتَّعُ",2,"ع",1,0],["تعجّلْتُ وخْطَ الشّيبِ في زَمَنِ الصِّبا","لخَوْضي غِمارَ الهَمِّ في طَلَبِ المَجْدِ",3,"د",1,1],["تعَجّبْتُ مِنْها في بَنادِقِ جَوْهَرٍ","يُزَيِّنُها ما احْمَرّ منها بِياقوتِ",4,"ت",1,0],["تَعَجَّبْتُ مِنْ سَيْفِي وَقَدْ جَاوَرَ الْغَضَا","بِقَلْبِي فَلَمْ يَسْبكْهُ مِنْهُ مُذِيبُ",5,"ب",1,0],["تَعَجَّبَ قَومٌ لِصَفعِ الرَشيدِ","وَذلِكَ مازالَ مِن دابِهِ",6,"ب",2,1],["تَعَجَّبَ أَصحابِي لَها حِينَ أُوقِدَت","وَلَلمُصطَلوها آخِرَ اللَيلِ أَعجَبُ",7,"ب",1,0],["تعجبني رؤية حوليكم","وقد تمطى جثماً كالجمل",8,"ل",1,1],["تُعَجِّلُ نَفْسِي مَا تَشْتَهِي","فَنُخْطِيءُ تَحْقِيقَ آرَابِهَا",9,"ه",2,1],["تَعَجَّبَت أَن رَأَت شَيبي فَقُلتُ لَها","لا تَعجَبي مَن يَطُل عُمرٌ بِهِ يَشِبِ",10,"ب",1,0],["تَعَجَّبُ أَن ناصى بِيَ الشَيبُ وَاِرتَقى","إِلى الرَأسِ حَتّى اِبيَضَّ مِنّي المَسائِحُ",11,"ح",1,0],["تعجلوا الفالَ في نحرِ العدى فغدوا","حمرَ الحلَى والمطايا والجلابيب",12,"ب",1,0],["تعجُّ طلاَّبه من حول ساحتهِ","فما تفهّمُ من ناديه أصوات",13,"ت",1,0],["تعجَّب الناس في صمتي وقد ذكرت","سلمى وقالوا تسلَّى قلب هيمان",14,"ن",1,1],["تعجَّل مولودٌ ليُمْهَل والدُ","ولا بِدْعَ قد يحمي العشيرةَ واحدُ",15,"د",1,1],["تُعجِّلُها موفورةً وتُديمها","ولا خيرَ في المعروفِ ليس بدائم",16,"م",1,0],["تَعجُّ فَتَدْوي حنايا الجبال","وتمشي فتهوي صُخورُ النُّجودْ",17,"د",1,0],["تعجل دقا وتنى","مثل فؤاد المدمن",18,"ن",1,0],["تُعجِلُ خَطواً تَني","فاتِنَةً بِالرَسَم",19,"م",1,0],["تَعجَبُ العُيونُ لَهُ","كَيفَ تَسكُنُ الشُهُبُ",20,"ب",1,0],["تُعَجِّلُ فِيَّ وُجوبَ الحُدودِ","وَحَدّي قُبَيلَ وُجوبِ السُجودِ",21,"د",1,0],["تَعَجَّبَتِ المُدامُ وَقَد حَساها","فَلَم يَسكَر وَجادَ فَما أَفاقا",22,"ق",2,0],["تَعَجَّبُ مِن خَطّي وَلَفظي كَأَنَّها","تَرى بِحُروفِ السَطرِ أَغرِبَةً عُصما",23,"م",2,0],["تَعَجَّلَ عَنهُ رَأسُهُ وَتَخَلَّفَت","لِطَيَّتِها أَوصالُهُ وَمَناكِبُه",24,"ب",2,0],["تَعَجَّبَ أَهلُ مَكَّةَ إِذ رَأَونا","وَحُقَّ لَهُم رَأَوا أَمراً عُجابا",25,"ب",2,1],["تَعَجَّلَ عَن ميقاتِهِ فَكَأَنَّهُ","أَبو صالِحٍ قَد بِتُّ مِنهُ عَلى وَعدِ",26,"د",1,0],["تَعجَزُ الريحُ عَن بُلوغِ مَداها","فَهِيَ حَسرى في شَأوِها المَمدودِ",27,"د",1,0],["تَعَجَّبتُ مِن فِرعَونَ إِذ ظَنَّ أَنَّهُ","إِلَهٌ لِأَنَّ النيلَ مِن تَحتِهِ يَجري",28,"ر",2,0],["تَعِجُّ إِلى القَتلى عَلَيها تَساقَطَت","عَجيجَ لِقاحٍ قَد تَجاوَبَ خورُها",29,"ر",3,0],["تُعَجِّلُ بِالمَغبوطِ عِجلٌ مِنَ القِرى","وَتَخضِبُ أَطرافَ العَوالي مِنَ الدَمِ",30,"م",1,1],["تعجَّبتُ لمّا ابتدا بالجميلِ","وما كانَ يعرِفُ فِعلَ الجَميلِ",31,"ل",1,0],["تَعَجَّبْتُ من غَفَلاتِ الوَرَى","وتَركِهِمُ العيشُ غَضّاً نَضيرا",32,"ر",2,0],["تَعَجَّلْتَ منها ما يُعَجَّلُ مثلُه","لكلِّ جَميلِ السَّعيِ عَفِّ المَذاهبِ",33,"ب",1,0],["تَعَجَّبتُ إِذ أَلهو وَلَم أَرَ طَرفَةً","لِعَينِ امرِئٍ مِن سَكرَةِ المَوتِ لا تَدني",34,"ن",2,0],["تَعجَبينَ مِن سَقَمي","صِحَّتي هِيَ العَجَبُ",35,"ب",1,0],["تعجَّبَ قومٌ كيفَ أترك منصبي","وأرفضُهُ عمداً وما أنا مضطرُّ",36,"ر",1,0],["تعجبتُ مِنْ نهدَيْهِ لو أنَّ لامساً","أرادَ انقباضاً لمْ تطعْهُ أناملُهْ",37,"ه",1,1],["تَعَجَّبتُ مِن إيجَازِهِ وَهوَ قَائِلُ","عَلَى كَثرَةِ استِغرَاقِهِ وَهوَ فَاعِلُ",38,"ل",1,0],["تَعَجَّلَ عَن جَريةِ الماذِيانِ","فَنَوَّرَ أَو بَعضُهُ المُشقِحُ",39,"ح",1,0],["تَعَجَّبَت جارَتي مِنّي وَقَد رَقَدَت","عَنّي العُيونُ وَباتَ الهَمُّ مُحتَشِدا",40,"د",2,1],["تَعَجُّباً مِمّا دَهاني بِهِ","أَقرَبُ جيراني لِذي الأَبعَدِ",41,"د",1,0],["تَعَجَّلَ مَيِّتٌ بِالهُلكِ نَقداً","فَمَرَّ وَعِندَهُ لِلبَعثِ وَعدُ",42,"د",1,0],["تعجبت زازا وقد","حَقَّ لها أن تعجبا",43,"ب",2,0],["تعجل في وجوب الحدود","وحدي قبل وجوب السجود!",44,"د",1,0],["تعَجّلْتُ إنْ لم أثْنِ جُهْدي عليكُمُ","سَحابَ الرّزايا وهي صائِبَةُ الوَقْع",45,"ع",1,0],["تُعْجِبُنِي رُؤَيةُ حُولِيِّكُمْ","وَقَدْ تَمَطَّى جَاثِماً كَالجَمَلِ",46,"ل",1,1],["تعَجَّبَ اللَّيْلُ مِنْها عِنْدَما بَرَزَتْ","تُسَلْسِلُ النُّورَ في عَيْنَيْهِ عَيْناها",47,"ا",3,1],["تَعَجَّبوا مِن خُشوعِ لَيثٍ","يَرهَبُهُ الجَمعُ وَالثباتُ",48,"ت",1,0],["تَعَجَّبتُ إِذ مَدَّ النَوى لِوَداعِنا","يَداً كَيفَ لَم تُشلَل هُناكَ وَتَبّتِ",49,"ت",1,0],["تعجب قوم أن تموت، وإنما","تعجبت أن تبقى إلى اليوم ناجيا!",50,"ي",2,0],["تعجبت من سيفي وقد جاوَرَ الغضا","لقلبي فلم يسبُكْهُ منه مُذيب",51,"ب",1,0],["تَعجبت نار قَلبي مِن تجلده","وَمِن جُفوني شَكا دَمع وَتَسهيدُ",52,"د",1,0],["تَعَجَّبت أَن رَأَت مَشِيبي","يَضحَكُ فِي مَفرِقِي سُمَيّه",53,"ه",1,1],["تعجَّبُ من حُسن بهجاتها","إلى أن ترى حسنَ آدابها",54,"ب",3,0],["تَعجَّبَ نَاسٌ لانقِيادِي مَعَ الهَوى","كذاكَ عِتَاقُ الخَيلِ طَوعُ الأعِنَّةِ",55,"ه",1,0],["تعجّبَ الناسُ من أشياءَ معجزةٍ","لكم بانتْ وما أَلقوا لها سَبَبا",56,"ب",2,0],["تعجبا من سجاياً ما سبقت بها","ولا أعترى ملك منها إلى خلق",57,"ق",1,0],["تعجب غر حيث يممت جعفرا","وعدت ولم تترك رباه بلاقعا",58,"ع",2,0],["تعجبهم من أنني قلت خطبة","أحاول نصر الدين من غير ناصر",59,"ر",1,0],["تُعجبُهُ غاشيةٌ يَحملُها","أمامَهُ في السُّوقِ بعضُ الحاشيَهْ",60,"ش",3,0],["تَعَجَّبَ قَومٌ مِن تَأخِّرِ حالِنا","وَلا عَجَبٌ في حالِنا إِن تَأَخَّرا",61,"ر",2,1],["تعجَّلَ منك إلطافٌ وبرٌّ","وأبطأ عنك إلطافي وبرّي",62,"ر",2,0],["تعجّب بحر أسكندرية من فتى","يثور على الأيام والدهر لائم",63,"م",1,0],["تعجبت للحمّى تزور جوانحي","وليس لها عندي إذا وفدت ورد",64,"د",1,0],["تَعَجَّبُ جارَتي لَمّا رَأَتني","كَذاتِ النوطِ مَخدِرَتي جِراحي",65,"ح",2,1],["تعجب قومي من بديع تغزُّلي","وقالوا لقد زفت إليك البدائع",66,"ع",1,1],["تُعجِبُهُم جُردٌ إِمامِيَّةٌ","مِثلُ وُجوهِ الغيدِ لَم تُخمَشِ",67,"ش",1,0],["تعجب كل الناس منك وأكبروا","وحق لهم أن يكبروك ويعجبوا",68,"ب",3,0],["تَعجَّب الناسُ مِن حُزني فَقُلتُ لَهم","ما مِثلُ رُزئي حزني كائِن أَبَدا",69,"د",2,0],["تعجَّبُ مِن شَيبٍ رَأَت بمفارِقي","وَهَل عَجَبٌ مِن أَن تَشيب المفارِقُ",70,"ق",1,0],["تعجبت كيف السيف يغمد في الثرى","وكيف يواري البحر في طية الكفن",71,"ن",1,0],["تعجبت من هذا الزمان وأهله","فما أحد من ألسن الناس يسلم",72,"م",1,0],["تَعَجَّبَتْ منْ حَيَاتي إذْ رَأَتْ دَنَفي","وَفِي يَدَيْهَا شِفَاءٌ لي وإبْلالُ",73,"ل",1,0],["تَعَجَّبُ مِنْ شَوْقِي وَما طالَ نَأْيُها","وغَيْرُ حَبِيبِ النَّفْسِ مَنْ لا يَشُوقُها",74,"ق",3,0],["تعجب صحبي حيث سرت ولم يكن","فؤادي معي مع حرقتي وحنيني",75,"ي",1,1],["تَعجّبَ صاحبي من طُولِ هَمّي","فقلتُ لِيَهْنِكَ البالُ الرَّخِيّ",76,"ي",1,0],["تُعُجِّبَ من ذا العامِ كيف تَرادفَتْ","له دِيَمٌ أَمطارُهُنَّ دَوائم",77,"م",1,0],["تَعجّبْتُ من راجي سِقاطي بعدما","غدا نَقْدُ فَضْلي هازئاً بالمُبَهْرَج",78,"ج",1,0],["تُعُجِّبَ منها كيف جُرَّ لِمثْلها","ذيولٌ لهم أم كيفَ زُرَّ جُيوب",79,"ب",1,0],["تعجَّبَ الناسُ لما أن رَأوا سنَد الإس","لامِ عَن طَرفِ الإسلامِ مُنصَرفا",80,"ف",2,1],["تعجبتي المنصوية الخفيفة","منها تكون الفتكة الحرِّيفة",81,"ه",1,0],["تَعجب مِن طَيران المطي","بِهم كَالأجادل عقيانُهُ",82,"ن",2,0],["تعجل نفسي ما تشتهي","فتخطيء تحقيق آرابها",83,"ه",2,1],["تعجب إذا ما خالفاه","وتحسب أن ذاك من الخراب",84,"ب",1,0],["تعجزُ الرَّاغبون فيها قياما","بأبي سيِّداً تهلّل طفلاً",85,"ا",1,0],["تعجّل في الدنيا عقوبة طامع","ومن نكبات المرء ما هو آجل",86,"ل",1,0],["تعجِزُ قِسّاً في أيادٍ بها","وتعتَلي سحبانَ في وائلِ",87,"ل",1,0],["تعجزُ الأبحر من جود يديه","وتعود السحب من كفّيه خجلى",88,"ل",2,0],["تَعجبُ من صبري على ألوانِها","في وصلها طوراً وفي هجرانِها",89,"ن",3,1],["تَعِجُّ بأثقال الرجاء كأنها","عوائمُ في بحر السراب سفينُ",90,"ن",1,0],["تعجّبوا من شكلها في حمله","وصفَك منظوماً ومنه أنظِمُهْ",91,"م",2,0],["تعجبُ الأحداثُ من حملي لها","وإذا أكره ذو العرِّ حَمَلْ",92,"ل",1,0],["تعجَّلتُ يوم اللوى نظرةً","ولم أتلفَّتْ إلى الآجلِ",93,"ل",1,0],["تعجَّبُ مني أختُ عذرةَ أن رأت","بحبلِ بني الدنيا رجائي معلَّقا",94,"ق",2,0],["تعجيله عن نفسه","سابقةً أمرَ القدَرْ",95,"ر",1,0],["تعجَّبُ من صبري وعندي خَلوبُها","ومُصعِقُها وعند غيري مَطيرُها",96,"ر",3,0],["تعجَّبَ لمّا ساد من حظِّ نفسه","وقد يُدرِك الجَدُّ الدنيَّ فيُفلِحُ",97,"ح",1,0],["تُعجِبُه الفضلةُ في ماله","ما لم تَشُبْها مِنّةُ الواهب",98,"ب",1,0],["تعجَّبَ الناسُ وقد وَلِيتَها","أُكرومةً فقلتُ لا لا عجبا",99,"ب",2,0],["تعجَبُ منها رباكِ حتَّى","يضحكَ فيها الوجهُ القَطوبُ",100,"ب",1,0],["تعجِلها زحمةُ ضِيفانِه","أن تتأنَّى حطبَ المُلهِبِ",101,"ب",1,0],["تعجل الفارس عن تحصينه","وجريح القوم عن شد الكلوم",102,"م",1,0],["تعجَّبَ الناسُ راويهمْ وعالمهُمْ","لما تكرَّرَ في العاداتِ والبِدَعِ",103,"ع",1,1],["تعجَّبَ صحبي أنْ كتمتُ فلم اُشع","عُلومي التي في بعضها شرفُ القدرِ",104,"ر",1,1],["تعجَّبوا منْ عِراقيٍّ بِلا سَفَهٍ","ولا نفاقٍ ولا خُبثٍ ولا كَذِبِ",105,"ب",1,1],["تعجَّبْتُم منْ فتحِ مصْرَ ودونها","فَناءُ المَطايا والتَّنائفُ والبَحْرُ",106,"ر",1,0],["تعجب لعقبان نمتها ثعالب","تظل أسوداً تحتهن أجادل",107,"ل",1,0],["تعجب عمروٌ أن وقفتُ بمنزلٍ","كلانا لفقدان الأحبّةِ ناحل",108,"ل",1,0],["تعجب له قائلاً فاعلاً","إذا ما انبرى مبدياً أو معيدا",109,"د",2,0],["تعجَّب قومٌ منهُ أطلع مثلهُ","ولا عجبٌ من كونهِ مطلع الشُّهب",110,"ب",1,0],["تعجَّبُ هندٌ من حنيني إلى