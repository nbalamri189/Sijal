{"poems":[[45,"جاء نيروزنا وأنت مراده","https://www.aldiwan.net/poem9556.html","الخفيف"],[63,"عش مدى الدهر يا أبا إسحاق","https://www.aldiwan.net/poem51505.html","الخفيف"],[77,"وهب الدهر نفيسا فاسترد","https://www.aldiwan.net/poem69086.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39683","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142058","الرمل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54305","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[63,"","https://poetry.dctabudhabi.ae/diwan/poem/50449","الرجز"],[189,"ويوم برد عقوده برد","https://www.aldiwan.net/poem14523.html","المنسرح"],[203,"نفرت والظباء ذات نفار","https://www.aldiwan.net/poem45535.html","الخفيف"],[203,"جارتي هل رأيت مثلي جارا","https://www.aldiwan.net/poem45631.html","الخفيف"],[228,"عذيرك من مستلهمين تصدروا","https://www.aldiwan.net/poem39687.html","الطويل"],[276,"عاهدوا الربع ولوعا وغراما","https://www.aldiwan.net/poem52089.html","الرمل"],[287,"كل مليح عبد عبد الرحيم","https://www.aldiwan.net/poem32443.html","السريع"],[366,"صاح في العاشقين بال كنانه","https://www.aldiwan.net/poem68049.html","الخفيف"],[376,"إنما حامد على الحمد وقف","https://www.aldiwan.net/poem57295.html","الخفيف"],[409,"مرحبا يا مرحبا يا مرحبا بنسيم","https://www.aldiwan.net/poem34146.html","الرمل"],[422,"قد ذكرناكم على بعد المزار","https://www.aldiwan.net/poem53843.html","الرمل"],[422,"من لصب في هواكم مستهام","https://www.aldiwan.net/poem54021.html","الرمل"],[435,"بلبل يشدو ويصدح","https://www.aldiwan.net/poem41415.html","مجزوء الرمل"],[457,"صح واني نسيمنا باعتلاله","https://www.aldiwan.net/poem13878.html","الخفيف"],[466,"ينثي برأفته ونجدته","https://www.aldiwan.net/poem16422.html","أحذ الكامل"],[469,"في لأذني عن كل لاح صمم","https://www.aldiwan.net/poem3159.html","عموديه"],[473,"الروض في فرحة وفي طرب","https://www.aldiwan.net/poem60475.html","المنسرح"],[556,"هبت تلوم على الندى هند","https://www.aldiwan.net/poem47877.html","أحذ الكامل"],[572,"شطت لليلى باللوى","https://www.aldiwan.net/poem69615.html","مجزوء الرجز"],[580,"أنا أمير العشاق","https://www.aldiwan.net/poem2905.html","مجزوء الرجز"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83315","الطويل"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112428","الرمل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104608","الرمل"],[949,"","https://poetry.dctabudhabi.ae/diwan/poem/124748","الرجز"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101977","الرمل"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130620","الرمل"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6774","السريع"],[1529,"","https://poetry.dctabudhabi.ae/diwan/poem/140211",""],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80052","الخفيف"],[1826,"","https://poetry.dctabudhabi.ae/diwan/poem/198976","الرمل"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33876","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93653","الرمل"],[2643,"","https://poetry.dctabudhabi.ae/diwan/poem/123800","المديد"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93791","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100345","الخفيف"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104680","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204576",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108337",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108021","الخفيف"],[3836,"","https://poetry.dctabudhabi.ae/diwan/poem/99264","الرمل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77086","الخفيف"],[4209,"","https://poetry.dctabudhabi.ae/diwan/poem/105541","الرمل"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33064","المديد"],[4593,"","https://poetry.dctabudhabi.ae/diwan/poem/130298","الخفيف"],[4764,"بقايا ليل","https://www.poetsgate.com/ViewPoem.aspx?id=28003",""],[4830,"أَهْيفُ الكَشْح","https://www.poetsgate.com/ViewPoem.aspx?id=195093",""],[4968,"هيا نعد للحب سالف مجده","https://www.poetsgate.com/ViewPoem.aspx?id=206760",""],[5106,"مِهْرَجَانُ الشَّمْس .","https://www.poetsgate.com/ViewPoem.aspx?id=153972",""],[5111,"سَلامَااااا","https://www.poetsgate.com/ViewPoem.aspx?id=212377",""],[5121,"بَديِعُ القَلْبِ","https://www.poetsgate.com/ViewPoem.aspx?id=215744",""],[5136,"ما للعواذل لا كانوا ولا خلقوا","https://www.poetsgate.com/ViewPoem.aspx?id=121637",""],[5170,"ضايق الصدر","https://www.poetsgate.com/ViewPoem.aspx?id=175541",""],[5283,"عشق فوق التعريف","https://www.poetsgate.com/ViewPoem.aspx?id=207577",""],[5459,"ضرع القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=202593",""],[5746,"انتظرني..","https://www.poetsgate.com/ViewPoem.aspx?id=207108",""],[5897,"يا طيبة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=156357",""],[5953,"أيها الزائرون مشهد نور","https://www.poetsgate.com/ViewPoem.aspx?id=93793",""],[5953,"عاذلتي في الشيب لو تعلم ما","https://www.poetsgate.com/ViewPoem.aspx?id=93807",""],[5974,"فيالق النور","https://www.poetsgate.com/ViewPoem.aspx?id=200260",""],[6096,"ياترى","https://www.poetsgate.com/ViewPoem.aspx?id=202963",""],[6102,"خلخال","https://www.poetsgate.com/ViewPoem.aspx?id=182738",""],[5309,"ينثر الشاعر ايات الغرام","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573855",""]],"verses":[["يَنثَني عَنكَ آخِرَ اليَومِ مِنهُ","ناظِرٌ أَنتَ طَرفُهُ وَرُقادُه",0,"د",2,0],["يَنثُرُ الرِّيحُ حَلْيَها فتَراه","نَهْبَ أيدي العُفاةِ والطُّرَّاقِ",1,"ق",1,0],["يَنْثَني الأيكُ على صَفحَته","وهو كالشعْرَى إذا لاحَ وَقَد",2,"د",1,0],["ينثرنَ بالريحان فوق رؤوسكم","طاقاتِ وردٍ ليس يذهبُ طيبها",3,"ب",3,0],["ينثُرُ الأنسَ على المجلسِ","من هنا وهنّا",4,"ن",2,0],["ينْثُرُ الزَّهرَ كالدنانيرِ غضّاً","أيْنَ حُرُّ النُّضارِ من زَهَراتهْ",5,"ت",2,0],["يُنْثَرُ الشعرُ فيه كالزهرِ ريّا","نَ بلحنٍ من الصبا ريّان",6,"ن",1,0],["ينثُرُ الدرَّ عبقريّاً عجيباً","ليس من مَسْقَطِ ولا من عُمان",6,"ن",1,0],["يَنثُرُ بالطَّعْنِ أنابيبَ القَنا","كما وَهى سِلكُ الفِرنْدِ المُنتَظِم",7,"م",1,0],["يَنْثُره الجوُّ ثم تنِظم من","ه الأرضُ في الحال كلَّ منتثِر",8,"ر",1,0],["ينثني خلفها من الخُرَّدِ العي","ن ِرياحينٌ طبنَ كالأزهارِ",9,"ر",1,0],["ينثني مرةً على الكبدِ الحرّا","ويبكي على الفؤادِ مرارا",10,"ر",2,0],["يُنَثَّرُ مِن حُلقومِهِ ذَهَبُ الربى","وَلبنانُ أَغنى الأَرضِ نوراً وَأَهَرُ",11,"ر",1,0],["ينثر الطل عليهم لؤلؤا","يشبه اللؤلؤ حسنا واِبتساما",12,"م",2,0],["يَنثُرُ إِن حَدَّثَني لُؤلُؤاً","مِن ثَغرِهِ وَالثَغرُ دُرٌّ نَظيم",13,"م",1,0],["يَنثَني الضَدّ مُفحَما من مَعاني","سِرّها مُفزِعا لَدَيها جَنانَه",14,"ن",2,0],["يَنثَني رمحُهُ فَيُثنَى علَيهِ","ولَه في يَدَيهِ حطمٌ وقَصفُ",15,"ف",1,0],["ينثر اللؤلؤ من أنبوبة","بنظام معجز للأدبا",16,"ب",2,0],["ينثر اللؤلؤ من ألفاظهم","فتراني في نظام ونثار",17,"ر",1,0],["ينثر اللؤلؤ من ألفاظهم","فترى من نثرهم حسن النظام",18,"م",1,0],["ينثني كالغصن عطفا","وعلى الخطيّ يرجح",19,"ح",1,0],["ينثني والدلال يقطر من عِطْ","فَيْهِ أحْبب بعطفهِ ودلاِلِهْ",20,"ل",2,0],["يُنْثي بِرَأفَتِهِ ونَجْدَتِهِ","ونَوالِهِ الأصْباحُ والأُصُلُ",21,"ل",1,1],["ينثر هاماتهم بسيفهِ","وللقلوب بقناهِ ينظم",22,"م",1,0],["يَنثُرُ مِن دَمعِ سُحبِهِ دُرُراً","عَلى بِهارٍ يَلوحُ كَالذَهَبِ",23,"ب",1,0],["يُنثْنِي عليها الحاسدون على","إحسانها وخصومُها اللدُّ",24,"د",1,0],["يَنْثُرُ مَا يُنْفَى وَمَا","يُخْتَارُ مِنْهَا يُلْتَقَطْ",25,"ط",1,0],["يَنْثَالُ لَثْمِي كلَّما انْ","ثالتْ عليه الأَشْوَاقْ",26,"ق",1,0],["يَنُثُّ عَلَيهِ الخافِقانِ بِعَدلِهِ","ثَناءً جَميلاً بِالدُعاءِ مُختِما",27,"م",2,0],["ينثرون الورد من إكبارهم","وتحييهم ضحوك المبسم",28,"م",1,0],["يَنثني عُجباً بجيدٍ","عاطلٍ بالحسنِ حالي",29,"ل",2,0],["ينثر للدّرهم والدينار","حتى كسا الارض بساط الزهر",30,"ر",1,0],["ينثني منه يميناً وشمال","ما سلاه القلب هجراً ووصال",31,"ل",1,0],["ينثني الساقي الينا كلما","اصدروا جاما له أورد جام",31,"م",1,0],["ينثني للوفد محمر الخدود","خجلا تحسبه عند القرى",32,"ر",2,0],["يَنثُرُ مِن فيهِ لَهُم جَوهَراً","مِن عِلمِهِ لَيسَ لَهُ مِن ثَمَن",33,"ن",1,0],["ينثرنَ مباهجَ أيّامي","ويسقنَ البشرَ فينساق",34,"ق",1,0],["ينثني العقلُ حين تتلى كأَنَّ ال","لفظ كأسٌ والسمع يرتاح سكرا",35,"ر",2,0],["ينثني الإخوان عنه جانباً","ويفل الدهر قصد العود",36,"د",1,0],["يَنَثَني كَأَنَّهُ صَولَجانٌ","أَو كَما عُرِّقَت مِنَ الخَطِّ نونُ",37,"ن",1,0],["يَنثر اللؤلؤ مِن أَلفاظه","إِن أَخَذنا بِأَحاديث الظرافه",38,"ف",2,0],["ينثني يفتَرُّ من هَيَفٍ","بقوامٍ زانَه المَيَلُ",39,"ل",1,0],["ينثني عطفه المهفهف لينا","وعلى الصب قلبه فيه قسوه",40,"و",2,0],["ينثني الخطب آنفا عن وضيعٍ","لذرى السامة الرفيع المنيفِ",41,"ف",1,0],["ينثر الطل عليهم لؤلؤاً","يخجل الدر صفاءً وانتظاما",42,"م",2,0],["ينثر من سقفها تراب","لولا غطائي به عميت",43,"ت",1,0],["ينثرون الالفاظ حبراً ولكن","ا نراها من المعاني جمانا",44,"ن",2,0],["ينثر الوردُ حولنا من يديها","فنخال الخدود منتثرات",45,"ت",1,0],["يَنْثُرُ الطَّلَّ كما يُنْثَرُ مِنْ","وَجْنَةِ المعشوق رَشْحُ العَرَقِ",46,"ق",1,1],["يُنثي الضِد مُفحَماً عَن مَعاني","ها وَقَد سَد لَفظَها إِمكانَه",47,"ن",2,0],["ينثر الطل عليهم لؤلؤاً","يفضح اللؤلؤ حسناً وابتساما",48,"م",2,0],["يَنثَني بِاللَومِ مِن عاذِليهِ","ما يُبالي أَكثَروا أَم أَقَلّوا",49,"ل",3,0],["ينثني الصارم المهند والرم","ح الرديني والشجاع الجري",50,"ي",1,1],["يَنثر عَذابه في .. الثنايا .. أقاويل","ولا تِعاويذٍ بها .. الروح ..يِغتال",51,"ل",1,0],["ينثني قدُّها أذا ما تهادتْ","نسمةُ الصبحِ رقَّةً ودلالا",52,"ل",2,0],["ينْثالُ سيْلُ الدّمْعِ بلّلَ وجْنَتي","لِتجاهلٍ مثْلِ الرَّدَى ما أصْعبهْ",53,"ب",2,0],["يَنْثُلُ الظِّلَّ مُدَىً وَرِمَاحَاً","يَلْبَسُ العَجْزَ رُؤَىً عُنْجُهِيَّا",54,"ي",2,0],["يَنْثُرُ الصُّبْحَ ورُودًا","عَطَّرَ الْوَادَ فَهَامَا",55,"م",2,0],["يَنْثُرُ الْعِطْرَ عَلَى جَنَّاتِهِ","لِيَذُوقَ الشَّهْدَ مِنْ نَبْعِ الْعَسَلْ",56,"ل",1,0],["ينثني إلى اللهو عطفينا نسيم هوى","كأنما هو مسك بيننا عبق",57,"ق",1,0],["ينثر الدمع ساعه وسط داره صويب","كل ما جف دمعه ، الفراق انثره",58,"ر",2,0],["ينثالُ منهُ رحيقُ الزهرِ ينفَحُنا","بالشَّهدِ سحرٌ على أعتابِنا مسَحا",59,"ح",2,0],["ينثرونَ النظيمَ كي يكثرَ اللّغ","وُ ويستبشرون بالإنحراف",60,"ف",1,0],["يَنْثُرُ الشِّعْرُ مَا أُكِنُّ وَيُفْشِيْ","نَبْضَ شَوْقِي وَلَا أَرَى مَكْنُونَكْ",61,"ك",1,0],["ينثال عَرفُ الطهر من ساحاته","فتهيم بالخطو الشجي وتبحرُ",62,"ر",1,0],["ينثر الدر اليواقيت في الشع","ر مشاباً في اللؤللؤ المنثور",63,"ر",1,0],["ينثر دراً في رياض فضة","وأرض مرجان وياقوت صبب",64,"ب",1,0],["ينثال عطرا إذا لاحت بوادركم","ويبسِمُ الشطُّ زهوًا إذ رأى القيما",65,"م",2,0],["ينثر النجم قصيداً","والمسا أرخى ظلالهْ",66,"ل",2,0],["يَنثُرُ الفُلَّ إِذ يَطِيرُ بِرُوحِي","ثُمَّ يَرتَدُّ فِي دَمِي- وَيكِ- عَوسَجْ",67,"ج",1,0],["يَنثُرُ الشّاعِرُ آياتِ الغَرام","وَهوَ لَم يَعشَق وَلا عانى السَّقام",68,"م",1,1]]}