{"poems":[[73,"ما عند مودود من قلت مثالبه","https://www.aldiwan.net/poem3785.html","البسيط"],[73,"ما قام لولا هواك المدنف الوصب","https://www.aldiwan.net/poem4015.html","البسيط"],[10,"يا عين جودي بالدموع","https://www.aldiwan.net/poem21072.html","مجزوء الكامل"],[85,"ما أملح مه فصل الربيع","https://www.aldiwan.net/poem54198.html","مجزوء الرجز"],[53,"ألوى بقلبك من غصون الناس","https://www.aldiwan.net/poem64593.html","الكامل"],[53,"يا رجلا أوفى على كل رجل","https://www.aldiwan.net/poem65868.html","الرجز"],[93,"قل للحمائم في ضفاف الوادي","https://www.aldiwan.net/poem8798.html","عموديه"],[87,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[87,"الأمر آل أحسن المآل","https://www.aldiwan.net/poem7912.html","الرجز"],[87,"في الموت ما أعيا وفي أسبابه","https://www.aldiwan.net/poem63779.html","الكامل"],[47,"يا من يماطلني وصلي بإنكار","https://www.aldiwan.net/poem64551.html","البسيط"],[47,"أمحلتي سلمى بكاظمة اسلما","https://www.aldiwan.net/poem65659.html","الكامل"],[68,"في مثل حضرتكم لا يزأر الأسد","https://www.aldiwan.net/poem41370.html","البسيط"],[107,"خلت المنازل منك والأوطان","https://www.aldiwan.net/poem41941.html","الكامل"],[107,"لك من تحيات القلوب مواكب","https://www.aldiwan.net/poem42053.html","الكامل"],[107,"أمل يزف مع السنين عروسا","https://www.aldiwan.net/poem42084.html","الكامل"],[107,"أمنارة الساري وأمن الوادي","https://www.aldiwan.net/poem42087.html","الكامل"],[107,"نادى الشباب فهب من إغفائه","https://www.aldiwan.net/poem42094.html","الكامل"],[107,"حي الخليل وطف بتلك الدار","https://www.aldiwan.net/poem43086.html","الكامل"],[107,"بني جذيمة ما في الأمر من عجب","https://www.aldiwan.net/poem43991.html","البسيط"],[107,"منك الحنين ومنه ما هو أعظم","https://www.aldiwan.net/poem44066.html","الكامل"],[107,"يا مطعم الجيش أشبعت السيوف دما","https://www.aldiwan.net/poem44069.html","البسيط"],[107,"سيري الهوينى دومة الجندل","https://www.aldiwan.net/poem44201.html","السريع"],[107,"أئن تولت جنود الشرك مدبرة","https://www.aldiwan.net/poem44211.html","البسيط"],[107,"أقبل فتلك ديار يثرب تقبل","https://www.aldiwan.net/poem44226.html","الكامل"],[104,"ديننا حبك يا هذا الوطن","https://www.aldiwan.net/poem32909.html","الرمل"],[21,"والحية الحتفة الرقشاء أخرجها","https://www.aldiwan.net/poem36160.html","البسيط"],[50,"أنت يا ابن الربيع ألزمتني النسك","https://www.aldiwan.net/poem62603.html","الخفيف"],[107,"","https://poetry.dctabudhabi.ae/diwan/poem/49384","الكامل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62212","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39678","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39581","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54697","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54234","البسيط"],[108,"تكلمي يا كتائب","https://www.poetsgate.com/ViewPoem.aspx?id=179636",""],[108,"قومي بين الشرق والغرب","https://www.poetsgate.com/ViewPoem.aspx?id=179442",""],[47,"يا من يماطلني وصلي بإنكار","https://www.poetsgate.com/ViewPoem.aspx?id=31180",""],[107,"حي الخليل وطف بتلك الدار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54974&r=&rc=144",""],[113,"دنف مذاب القلب من فرط الأسا","https://www.aldiwan.net/poem16497.html","الكامل"],[128,"لانت قناتك للمنون","https://www.aldiwan.net/poem23735.html","الكامل"],[146,"ما ضاع من أيامنا هل يغرم","https://www.aldiwan.net/poem58446.html","الكامل"],[193,"الحمد لله الغني الأحد","https://www.aldiwan.net/poem35111.html","الرجز"],[233,"أنا من رقة الهوى والهواء","https://www.aldiwan.net/poem51268.html","الخفيف"],[239,"حتام مطلك يا ظلوم","https://www.aldiwan.net/poem31762.html","مجزوء الكامل"],[239,"غاداك من بحر الرواعد مسبل","https://www.aldiwan.net/poem31795.html","الكامل"],[239,"وأغن معسول المراشف","https://www.aldiwan.net/poem31819.html","مجزوء الكامل"],[239,"مرت بجمع ليلة النفر","https://www.aldiwan.net/poem31993.html","السريع"],[243,"بمحمد صلوا عليه وسلموا","https://www.aldiwan.net/poem23835.html","الكامل"],[263,"بمحمد وببنته وببعلها","https://www.aldiwan.net/poem35542.html","الكامل"],[265,"عوفيت نضو هواك برح داؤه","https://www.aldiwan.net/poem38139.html","الكامل"],[269,"جوهرة العذاب","https://www.aldiwan.net/poem8570.html","عموديه"],[274,"الشام يقهر والعراق يضام","https://www.aldiwan.net/poem35641.html","الكامل"],[274,"أبدا أرى والغدر طبع فيك","https://www.aldiwan.net/poem35643.html","الكامل"],[274,"حبي الخليفة مولانا ومولاك","https://www.aldiwan.net/poem35652.html","البسيط"],[302,"إن كان باليمن هذا اليوم قد سنحا","https://www.aldiwan.net/poem36252.html","عموديه"],[397,"أنا من شيعة الرضا","https://www.aldiwan.net/poem53655.html","مجزوء الخفيف"],[406,"كيف يرضيك على الضيم المقام","https://www.aldiwan.net/poem46920.html","الرمل"],[420,"أنا في هواكم مطلق ومقيد","https://www.aldiwan.net/poem54136.html","الكامل"],[443,"الله جارك ظاعنا ومقيما","https://www.aldiwan.net/poem34799.html","الكامل"],[456,"مهد الحضارة للعروبة كلها","https://www.aldiwan.net/poem61290.html","الكامل"],[456,"رمضان يا حلو الشمائل","https://www.aldiwan.net/poem61335.html","مجزوء الكامل"],[456,"أربعاء الرماد يا عيد أحزا","https://www.aldiwan.net/poem61392.html","الخفيف"],[464,"أما اذا سلم الامام الأعظم","https://www.aldiwan.net/poem16018.html","الكامل"],[464,"رفقا بها يا أيها الزاجر","https://www.aldiwan.net/poem16434.html","السريع"],[518,"إذا قدرت على العلياء بالغلب","https://www.aldiwan.net/poem12009.html","البسيط"],[518,"مل وقد ملت إلى وداده","https://www.aldiwan.net/poem12065.html","الرجز"],[541,"الله بالذكر الجميل حباه","https://www.aldiwan.net/poem47509.html","عموديه"],[541,"آه إذ تعلو على متن جوا","https://www.aldiwan.net/poem48197.html","عموديه"],[541,"عفوا إذا أكثرت من إنشادي","https://www.aldiwan.net/poem48209.html","عموديه"],[554,"إن كنت يا عمرو قد أسأت فقد","https://www.aldiwan.net/poem47227.html","المنسرح"],[554,"خل المدامع في المنازل تسفح","https://www.aldiwan.net/poem47902.html","الكامل"],[652,"","https://poetry.dctabudhabi.ae/diwan/poem/216852","الهزج"]],"verses":[["المُستَشارُ عَفيفُ الدينِ قَد دَمِيَت","يَدي عَلى لَومِهِ مِمّا أُعاتِبُهُ",0,"ب",2,0],["المُستَقِلُّ بِما أَعيا المُلوكُ بِهِ","وَالمُستَقِلُّ لَنا الدُنيا إِذا يَهَبُ",1,"ب",1,0],["المُستَضافِ مِنَ السِنينَ","إِذا قَسا مِنها المَحارِد",2,"د",1,0],["المستعين نعم الإمام","اللّه يبقي دولت",3,"ت",1,0],["المستضاءُ الوجه في بُهَم الدجى","والمستضاء الرأي في الألباس",4,"س",1,0],["المستعينين بها ولا الجُهل","لا تجعلنّي عِظة مثلَ الفُتل",5,"ل",1,0],["المُسبِغينَ عَلى النَوابِغِ فَضلَهُم","كَالفَجرِ مُنبَسِطاً عَلى الأَطوادِ",6,"د",1,0],["المُسرجُ الخَيلُ نُضاراً خالِصاً","وَالمُنعِلُ الخَيلَ يَواقيت الوَغى",7,"ا",1,0],["المستبيح في دُخول البَيتِ","هَلاكَ حَيٍّ وَاِنتِهاكَ مَيت",8,"ت",1,0],["المُستَبِدُّ يُطاقُ في ناووسِهِ","لا تَحتَ تاجَيهِ وَفَوقَ وِثابِهِ",9,"ب",2,0],["المُستَجيرُ بِعَمرٍ عِندَ كُربَتِهِ","كَالمُستَجيرِ مِنَ الرَمضاءِ بِالنارِ",10,"ر",1,0],["المُستَضاءُ بِوَجهِهِ وَبِرَأيِهِ","إِن حَيرَةٌ وَقَعَت وَخَطبٌ أَظلَما",11,"م",2,0],["المُستَطيلَ وفي حَدَّ الظُبى قِصرٌ","وَالمُستَقيمُ وَفي قَدَّ القَنا أَوَدُ",12,"د",1,0],["المسجدُ الأقصَى لِموتِكَ خَاشِعٌ","والبيتُ بَعدَك جَازعٌ أَسْوَانُ",13,"ن",1,0],["المسجدُ الأقصى لسانٌ صارخٌ","يُهدِي تحيّتَهُ وقلبٌ واجبُ",14,"ب",1,0],["المُسلِمونَ على جَهالةِ بعضِهم","عَرفوا الحياةَ نَعيمَها والبُوسا",15,"س",2,0],["المُسلمونَ على هُدىً مِن رَبِّهم","ما دَامَ نُورُكَ عن يَمينِ الوادي",16,"د",2,0],["المُستعانِ على العدوِّ إذا طَغَى","المُستعين بِصبرِهِ وَإبائِهِ",17,"ا",3,0],["المُسلِمونَ الأَوَّلونَ بِغِبطَةٍ","وَالشَرقُ في فَرَحٍ وَفي اِستِبشارِ",18,"ر",1,0],["المُسلِمونَ دَمٌ للهِ أو عَصَبٌ","ما مِثلُه من دمٍ جارٍ ولا عَصَبِ",19,"ب",1,0],["المسلمون يُبايعونَ نبيَّهم","يَستمسكونَ بعُروةٍ ما تُفصَم",20,"م",1,0],["المسلمونَ يَدٌ للَّهِ عَامِلَةٌ","تَمضِي أصابعُها في شأنِها قُدُما",21,"م",2,0],["المسلمون استصرخوا ربَّهم","فاستعصمِي منه ولن تفعلي",22,"ل",2,0],["المسلمون حَيارى كيف يأخذُهم","بأسُ العدوِّ أما رَدُّوه فانقلبا",23,"ب",2,0],["المسجد الثَّاني يُقامُ بيثربٍ","ومحمدُ الباني يَجِدُّ ويَعملُ",24,"ل",1,0],["المسيحي أَخ للمسلم","يا فَلسطين بَقَلب وَفَم",25,"م",1,0],["المُسبِحُ الخُشبَ فَوقَ الماءِ سخَّرها","خِلالَ جَريَتِها كَأَنَّها عُوَمُ",26,"م",1,0],["المَسابيحُ في ذِراعي وَالمُص","حَفُ في لُبَّتي مَكانَ القِلادَه",27,"د",2,0],["المُستَبِدُّ بِنا يُريدُ فَنَرتَضي","وَيَسومُنا خَوضَ الحُتوفِ فَنَرتَمي",28,"م",2,0],["المُسْتَضَافِ وَلمّا تَفْنَ شِرَّتُهُ","مِنَ الكِلاَبِ وضيفِ الهَضْبَةِ الضِّرَرِ",29,"ر",1,0],["ألمساواةُ التي أعلنتها","أعلنتَه بنذير ووعيد",30,"د",1,0],["المسجدُ الأقصى يودُّ لو أنه","أسرى إليهِ بكَ الخيالُ الشيِّقُ",31,"ق",1,0],["الْمُسْتَسِرُّ شِعَارُ الْمُقْتَدِينَ بِهِ","الْعَامِلِينَ بِمَغْزىً مِنْهُ مَقْصُودِ",32,"د",1,0],["المسكُ مسْكٌ فإن تُبالغْ","في وَصْفهِ لم تَزِدْه طِيبا",33,"ب",2,0],["المستبدُّ بمصرَ يَلقى حتْفَه","والضيفُ إنْ يَنزلْ بِمِصِرٍ يُكْرم",34,"م",1,0],["المسلمون -على شتات ديارهم-","فرضَ الإلهُ خضوعهم لإمام",35,"م",1,0],["\"المستجير بعمرو عند كربته","كالمستجير من الرمضاء بالنار\"",36,"ر",1,0],["المسلمون الأولون بغيطة ٍ","والشرق في فرحٍ وفي استبشار",37,"ر",1,0],["المُسفِرات مِن الخدور أَهلة","المُرسَلات مِن الذَوائب حندسا",38,"س",2,0],["المسجد الأقصى وحق","بني أبيك بفلسطين",39,"ن",1,0],["المستجير من المذمَّة بالنَّدَى","والمستجار إذا أظلَّك مَغْرمُ",40,"م",1,0],["المُستعيذُ الضارعُ المتضرّعُ","الفرطُ الشافعُ والمشفّعُ",41,"ع",1,0],["المستقيمُ ذو الصراطِ المُستقيم","وهوَ المحيدُ صاحبُ الشرعِ القويم",41,"م",1,0],["أَلْمِسُ الأَوْجُهَ الحِسانَ وأستم","تِعُ من كلِّ وَجْنةٍ حمراء",42,"ا",2,0],["المُستَجِدُّ مَآثِراً","يَزهو بِها الشَرَفُ القَديمُ",43,"م",1,0],["المُستَضيءُ المُستَضاءُ بِهَديِهِ","وَالساجِدُ المُتَهَجِّدُ المُتَبَتِّلُ",44,"ل",1,0],["المُستَجابُ دُعاؤُهُ فَالغَيثُ ما","قَنِطَ الثَرى بِدُعائِهِ يَتَنَزَّلُ",44,"ل",1,0],["المُستَقِرُّ مِنَ الخِلافَةِ في ذُرىً","شَمّاءَ لا يَسطيعُها المُتَرَقِّلُ",44,"ل",1,0],["المُسمِحُ الصَعبُ العَبوسُ الباسِمُ اليَ","قِظُ الجَوادُ القُلَّبِيُّ الحُوَّلُ",44,"ل",1,0],["المُستَضيءَ وَمَن لَهُ","ظِلٌّ عَلى الإِسلامِ وارِف",45,"ف",1,0],["المُسمِحِ الصَعبِ الرَحيبِ القِرى","في المَكرُماتِ الضَيِّقِ العُذرِ",46,"ر",1,0],["المسلمون حياتهم في دينهم","ما أمسكوه وويلهم إن أحجموا",47,"م",3,0],["المستوين على عروش جلالة","وابنيهما السبطين أعلام الهدى",48,"د",2,0],["المستضاء من الخطوب برأيه","فكأنما شهب الدجا آراؤه",49,"ا",3,0],["ألْمَسُكِ ... فيضربُ الْلَسْعُ أصابعي","لماذا أنت حارّةٌ هكذا",50,"ذ",2,0],["المسلمون تساقَطت أعلامُهم","فكأنهم بينَ الشَّعوبِ سوام",51,"م",1,0],["المسلِمونَ ضرَبتِهم في جَهلِهم","بالمُسلِمينَ وخانهم غاويك",52,"ك",1,0],["المسلمونَ إِلى البطحاءِ مرجعُهم","وليسَ يجمعهم إِلا محيّاك",53,"ك",1,0],["المسلمون وَما يحصى لهم عددٌ","دارتْ عَلَى جمعهمْ للنائبات رحى",54,"ح",2,0],["المَساعي عَلَيهِ في","يَومِ بَدرٍ مُوَفَّره",55,"ر",2,0],["المساعير إذا جدّ اللّقا","المراجيحُ المساميحُ الكرَامُ",56,"م",1,0],["المسبغ النعماء ليس يشوبها","مَنُّ ولا فيما يؤمل موعد",57,"د",1,0],["المُسْرِعُونَ إِلَى النَّدى والطَّائِرُو","نَ إِلَى الوَغى والرَّاجِحُونَ حُلوما",58,"م",2,0],["المسهمين بعلمهم وبفنهم","في رفعة الإنسان أو في بذلها",59,"ل",3,0],["المستهين بكل وضع","جائر أو ماكر",60,"ر",1,0],["المسيح النبيل بارك ما","فيه من الوجد والرؤى والمعاني",61,"ن",2,0],["المُستهلُّ اذا تَجِنُّ شَديدةٌ","والمُسْتقلُّ اذا يَؤددُ المَغْرَمُ",62,"م",1,0],["المستضيءُ البَرُّ والمُجْتَبى","للأمْرِ والقاننِتُ والسَّاهِرُ",63,"ر",1,0],["المسرعون من المران أرشية","نابت قلوب أعاديها عن القلب",64,"ب",1,0],["المستبد بالعلى وحبذا","قرة عين لك باستبداده",65,"د",2,0],["ألمِسكُ فوَّاحُ الشذَا لكنَّه","بِتحَرُّكٍ يزدَادُ فوحُ شَذَاه",66,"ا",2,0],["المساكينَ امتَصِص من دَمِهِم","شاطراً كلَّ أجيرٍ ما أُجِر",67,"ر",1,0],["المسلمُون بمشرِقٍ ومبغرِبٍ","متآلِفون كعَاتِقٍ ونِجَاد",68,"د",1,0],["ألَمَّ سوءٌ وما أتمَّ وكمْ","أنشبَ أظفارَه وما عدما",69,"م",2,0],["المُسرِعون إلى الصّريخ فإِنْ قضَوْا","وَطَرَ الوَغى فهُمُ الجبالُ الرُّجحُ",70,"ح",1,0],["..المستَفْرِغ ِالمَيْعَ","ة بعْد النّزعِ والجذْبِ",71,"ب",1,0]]}