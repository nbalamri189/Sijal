ُستَضافِ مِنَ السِنينَ","إِذا قَسا مِنها المَحارِد",2,"د",1,0],["المستعين نعم الإمام","اللّه يبقي دولت",3,"ت",1,0],["المستضاءُ الوجه في بُهَم الدجى","والمستضاء الرأي في الألباس",4,"س",1,0],["المستعينين بها ولا الجُهل","لا تجعلنّي عِظة مثلَ الفُتل",5,"ل",1,0],["المُسبِغينَ عَلى النَوابِغِ فَضلَهُم","كَالفَجرِ مُنبَسِطاً عَلى الأَطوادِ",6,"د",1,0],["المُسرجُ الخَيلُ نُضاراً خالِصاً","وَالمُنعِلُ الخَيلَ يَواقيت الوَغى",7,"ا",1,0],["المستبيح في دُخول البَيتِ","هَلاكَ حَيٍّ وَاِنتِهاكَ مَيت",8,"ت",1,0],["المُستَبِدُّ يُطاقُ في ناووسِهِ","لا تَحتَ تاجَيهِ وَفَوقَ وِثابِهِ",9,"ب",2,0],["المُستَجيرُ بِعَمرٍ عِندَ كُربَتِهِ","كَالمُستَجيرِ مِنَ الرَمضاءِ بِالنارِ",10,"ر",1,0],["المُستَضاءُ بِوَجهِهِ وَبِرَأيِهِ","إِن حَيرَةٌ وَقَعَت وَخَطبٌ أَظلَما",11,"م",2,0],["المُستَطيلَ وفي حَدَّ الظُبى قِصرٌ","وَالمُستَقيمُ وَفي قَدَّ القَنا أَوَدُ",12,"د",1,0],["المسجدُ الأقصَى لِموتِكَ خَاشِعٌ","والبيتُ بَعدَك جَازعٌ أَسْوَانُ",13,"ن",1,0],["المسجدُ الأقصى لسانٌ صارخٌ","يُهدِي تحيّتَهُ وقلبٌ واجبُ",14,"ب",1,0],["المُسلِمونَ على جَهالةِ بعضِهم","عَرفوا الحياةَ نَعيمَها والبُوسا",15,"س",2,0],["المُسلمونَ على هُدىً مِن رَبِّهم","ما دَامَ نُورُكَ عن يَمينِ الوادي",16,"د",2,0],["المُستعانِ على العدوِّ إذا طَغَى","المُستعين بِصبرِهِ وَإبائِهِ",17,"ا",3,0],["المُسلِمونَ الأَوَّلونَ بِغِبطَةٍ","وَالشَرقُ في فَرَحٍ وَفي اِستِبشارِ",18,"ر",1,0],["المُسلِمونَ دَمٌ للهِ أو عَصَبٌ","ما مِثلُه من دمٍ جارٍ ولا عَصَبِ",19,"ب",1,0],["المسلمون يُبايعونَ نبيَّهم","يَستمسكونَ بعُروةٍ ما تُفصَم",20,"م",1,0],["المسلمونَ يَدٌ للَّهِ عَامِلَةٌ","تَمضِي أصابعُها في شأنِها قُدُما",21,"م",2,0],["المسلمون استصرخوا ربَّهم","فاستعصمِي منه ولن تفعلي",22,"ل",2,0],["المسلمون حَيارى كيف يأخذُهم","بأسُ العدوِّ أما رَدُّوه فانقلبا",23,"ب",2,0],["المسجد الثَّاني يُقامُ بيثربٍ","ومحمدُ الباني يَجِدُّ ويَعملُ",24,"ل",1,0],["المسيحي أَخ للمسلم","يا فَلسطين بَقَلب وَفَم",25,"م",1,0],["المُسبِحُ الخُشبَ فَوقَ الماءِ سخَّرها","خِلالَ جَريَتِها كَأَنَّها عُوَمُ",26,"م",1,0],["المَسابيحُ في ذِراعي وَالمُص","حَفُ في لُبَّتي مَكانَ القِلادَه",27,"د",2,0],["المُستَبِدُّ بِنا يُريدُ فَنَرتَضي","وَيَسومُنا خَوضَ الحُتوفِ فَنَرتَمي",28,"م",2,0],["المُسْتَضَافِ وَلمّا تَفْنَ شِرَّتُهُ","مِنَ الكِلاَبِ وضيفِ الهَضْبَةِ الضِّرَرِ",29,"ر",1,0],["ألمساواةُ التي أعلنتها","أعلنتَه بنذير ووعيد",30,"د",1,0],["المسجدُ الأقصى يودُّ لو أنه","أسرى إليهِ بكَ الخيالُ الشيِّقُ",31,"ق",1,0],["الْمُسْتَسِرُّ شِعَارُ الْمُقْتَدِينَ بِهِ","الْعَامِلِينَ بِمَغْزىً مِنْهُ مَقْصُودِ",32,"د",1,0],["المسكُ مسْكٌ فإن تُبالغْ","في وَصْفهِ لم تَزِدْه طِيبا",33,"ب",2,0],["المستبدُّ بمصرَ يَلقى حتْفَه","والضيفُ إنْ يَنزلْ بِمِصِرٍ يُكْرم",34,"م",1,0],["المسلمون -على شتات ديارهم-","فرضَ الإلهُ خضوعهم لإمام",35,"م",1,0],["\"المستجير بعمرو عند كربته","كالمستجير من الرمضاء بالنار\"",36,"ر",1,0],["المسلمون الأولون بغيطة ٍ","والشرق في فرحٍ وفي استبشار",37,"ر",1,0],["المُسفِرات مِن الخدور أَهلة","المُرسَلات مِن الذَوائب حندسا",38,"س",2,0],["المسجد الأقصى وحق","بني أبيك بفلسطين",39,"ن",1,0],["المستجير من المذمَّة بالنَّدَى","والمستجار إذا أظلَّك مَغْرمُ",40,"م",1,0],["المُستعيذُ الضارعُ المتضرّعُ","الفرطُ الشافعُ والمشفّعُ",41,"ع",1,0],["المستقيمُ ذو الصراطِ المُستقيم","وهوَ المحيدُ صاحبُ الشرعِ القويم",41,"م",1,0],["أَلْمِسُ الأَوْجُهَ الحِسانَ وأستم","تِعُ من كلِّ وَجْنةٍ حمراء",42,"ا",2,0],["المُستَجِدُّ مَآثِراً","يَزهو بِها الشَرَفُ القَديمُ",43,"م",1,0],["المُستَضيءُ المُستَضاءُ بِهَديِهِ","وَالساجِدُ المُتَهَجِّدُ المُتَبَتِّلُ",44,"ل",1,0],["المُستَجابُ دُعاؤُهُ فَالغَيثُ ما","قَنِطَ الثَرى بِدُعائِهِ يَتَنَزَّلُ",44,"ل",1,0],["المُستَقِرُّ مِنَ الخِلافَةِ في ذُرىً","شَمّاءَ لا يَسطيعُها المُتَرَقِّلُ",44,"ل",1,0],["المُسمِحُ الصَعبُ العَبوسُ الباسِمُ اليَ","قِظُ الجَوادُ القُلَّبِيُّ الحُوَّلُ",44,"ل",1,0],["المُستَضيءَ وَمَن لَهُ","ظِلٌّ عَلى الإِسلامِ وارِف",45,"ف",1,0],["المُسمِحِ الصَعبِ الرَحيبِ القِرى","في المَكرُماتِ الضَيِّقِ العُذرِ",46,"ر",1,0],["المسلمون حياتهم في دينهم","ما أمسكوه وويلهم إن أحجموا",47,"م",3,0],["المستوين على عروش جلالة","وابنيهما السبطين أعلام الهدى",48,"د",2,0],["المستضاء من الخطوب برأيه","فك