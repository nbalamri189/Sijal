,"https://www.aldiwan.net/poem61565.html","الرمل"],[458,"من جب غارب هاشم وسنامها","https://www.aldiwan.net/poem55867.html","الكامل"],[458,"سأل اللوى وسؤاله إلحاف","https://www.aldiwan.net/poem56110.html","الكامل"],[458,"هل لقتيل على اللوى ثائر","https://www.aldiwan.net/poem56169.html","المنسرح"],[458,"أهفو لعلوي الرياح إذا جرت","https://www.aldiwan.net/poem56260.html","الطويل"],[458,"نرق وتقسو بالغوير قلوب","https://www.aldiwan.net/poem56279.html","الطويل"],[468,"ورقص كشعري في الإفتنان","https://www.aldiwan.net/poem59573.html","المتقارب"],[468,"قم نصطبح تحت رفرف السحر","https://www.aldiwan.net/poem60135.html","المنسرح"],[500,"كثر الصنوف وأنت أنت الواحد","https://www.aldiwan.net/poem37565.html","الكامل"],[500,"رأت رفرف الأكوان هند فولت","https://www.aldiwan.net/poem37718.html","الطويل"],[500,"جرى دمعي السياح من جفني البالي","https://www.aldiwan.net/poem37821.html","الطويل"],[500,"ولما تلافينا التلال بلعلع","https://www.aldiwan.net/poem37977.html","الطويل"],[500,"ما للقلوب عن الحبيب غطاء","https://www.aldiwan.net/poem38105.html","الكامل"],[514,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[514,"إلى الله نشكو فادحات النوائب","https://www.aldiwan.net/poem20840.html","الطويل"],[515,"إن قلت قد خرست خلاخل ساقها","https://www.aldiwan.net/poem12193.html","الكامل"],[534,"أزف لك التحية والسلاما","https://www.aldiwan.net/poem23815.html","الوافر"],[538,"إذا ذكر المثقف من شباب","https://www.aldiwan.net/poem47958.html","عموديه"],[538,"هو بدر الجمال يرنو لبدر","https://www.aldiwan.net/poem48168.html","عموديه"],[551,"من أين لي معد على الأيام","https://www.aldiwan.net/poem47204.html","الكامل"],[551,"عن الخيال لنا ليالي الأبرق","https://www.aldiwan.net/poem47353.html","الكامل"],[558,"أنا العاشق السالي لوجهك يا علو","https://www.aldiwan.net/poem33585.html","الطويل"],[558,"طرف الذي طلب التحقيق سهران","https://www.aldiwan.net/poem33823.html","البسيط"],[558,"كل وقت جمال وجهك بادي","https://www.aldiwan.net/poem34633.html","الخفيف"],[567,"الليل يا صاحبي منطلق","https://www.aldiwan.net/poem69572.html","أحذ الكامل"],[567,"عراني الزمان بأحداثه","https://www.aldiwan.net/poem69758.html","المتقارب"],[575,"أنا غرس بيتك إن أرد","https://www.aldiwan.net/poem2761.html","مجزوء الكامل"],[575,"غدا الحسن شورى في الملاح وإنما","https://www.aldiwan.net/poem2922.html","الطويل"],[575,"نسيت في أسماء حتى اسمي","https://www.aldiwan.net/poem3012.html","السريع"],[575,"كحل العيون بمرود من عسجد","https://www.aldiwan.net/poem3085.html","الكامل"],[575,"يا قلب ويحك إن ظبيك قد سنح","https://www.aldiwan.net/poem3091.html","الكامل"]],"verses":[["وَرَقَبتُهُ فَرَأَيتُهُ مُتَمَنِّعاً","وَبَعَثتُهُ فَوَجَدتُهُ وَقّافا",0,"ف",2,0],["وَرِقابُ القَومِ مايِلَةٌ","مِن بَقايا نَشوَةِ السَهَرِ",1,"ر",1,0],["وَرَقِيبُهُ في نَاظِري","يَ قَذىً وَفي صَدْري شَجَى",2,"ج",2,0],["وَرَقيتُ في دَرَجِ العُلا فَتَضايَقَت","عَمّا أُريدُ شِعابُهُ وَفِجاجُهُ",3,"ج",2,0],["وَرَقُ الأكْرُنْبِ مَجعو","لاً علي خِرْيَةِ هِرْ",4,"ر",1,0],["ورَقَتْ مَعاريجَ العُلا لتَحوزَ في","سِمْطِ الجَلالِ نِظامَها المَعْهودا",5,"د",2,0],["ورَقيقُها من لَيْلِهِ أنْجُمُ التُّقى","وكِتابُها منْ فَجْرِهِ وصَباحِهِ",6,"ح",2,0],["وَرِقَّةَ أَنفاسٍ وَصِحَّةَ جَوهَرِ","وَناهيكَ مِن مَبدا جَمالٍ وَمَحضِرِ",7,"ر",1,0],["وَرِقَّةِ مُحْتَالٍ وَشِدَّةِ مُفْحِمٍ","يُنَسَّمُ عَنْ رَوْضٍ وَيُغْدِقُ عَنْ يَمِّ",8,"م",1,0],["وَرَقَّقَني هَوَاكِ وكُنتُ جَلداً","وَأَبدى في مَفَارِقِيَ المَشيبَا",9,"ب",2,0],["ورقّت قلوب للعراق وأهله","وأصغت إلى شكوى فلسطين آذان",10,"ن",1,0],["وَرَقاقٍ عُصَبٍ ظُلمانُهُ","كَحَزيقِ الحَبَشِيِّينَ الزُجَل",11,"ل",1,0],["ورقى صاعداً فلم يبقَ للحا","سدِ إلا تنفسُ الصعداء",12,"ا",2,0],["ورقّ معنى حديثٍ فهو حينئذٍ","دمعٌ جرى فقضى في الرُّبعِ ما وَجبا",13,"ب",2,0],["ورقيمة الألفاظِ باكر بابها","كهفٌ يروح له الثناء ويغتدِي",14,"د",2,0],["ورقى لديك الطير منبر أيكة","فعلمت أنك للمسرّة جامع",15,"ع",1,0],["ورقيم من العذار ثناني","ساهراً طول ليلتي بالرقيم",16,"م",1,0],["ورقيم حاشية العذار وكلّ ذي","حسنٍ بحاشية الفتى غلمانه",17,"ن",2,0],["ورقيتم حيَّة السل","طان والحيات تُرقى",18,"ق",2,0],["ورقاصةٍ بالطبلِ والصنجِ كاعبٌ","لها غُنْجُ مِخناثٍ وتَكريهُ فاتك",19,"ك",1,0],["وُرْقٌ تَغَنَّى على خُضْرٍ مُهَدَّلةٍ","تَسْمو بها وتشمُّ الأرضَ أحيانا",20,"ن",2,0],["وَرَقصَ الأَشِعَّةِ فَوقَ الرَوابي","وَضِحكَ الجَداوِل وَالقَهقَهات",21,"ت",1,0],["وَرَقُها أَبيَضُ لَ","كِن كَبَياضِ البَهَقِ",22,"ق",1,0],["وَرَقيبٍ عَدِمتُهُ مِن رَقيبٍ","أَسوَدِ الوَجهِ وَالقَفا وَالصِفاتِ",23,"ت",1,1],["ورقيب على الدياجي إذا أل","قت عصاها صدّعتِها بعصاكا",24,"ك",2,0],["وَرَقيقٍ مِنَ البُيوتِ عَتيقٌ","جاوَزَ الأَلفَ غَيرَ مَذمومِ حَرسِ",25,"س",1,0],["وَرَقَدتَ تُزلِفُ لِلخَيالِ مَكانَهُ","بَينَ الجُفونِ وَبَينَ هُدبِكَ وَالكَرى",26,"ر",2,0],["وَرَقَّت لِآثارِهِ في القَميصِ","كَأَنَّ قَميصَكَ قُرآنُها",27,"ن",3,0],["وَرَقِّق لِلفَقيرِ بِها قُلوباً","مُحَجَّرَةً وَأَكباداً صِلابا",28,"ب",2,0],["وَرِقَّةُ وَجهٍ لَو خَتَمتَ بِنَظرَةٍ","عَلى وَجنَتَيهِ ما اِنمَحى أَثَرُ الخَتمِ",29,"م",1,0],["ورقَّ لي قلبُه القاسي ومكَّننِي","ممّا أردتُ فلم آثمْ ولم أُلَمِ",30,"م",1,0],["ورقدتَ ليلَكَ آمِناً متمِهّلاً","ونَسِيتَ كيف طَوارِقُ الأسحارِ",31,"ر",1,0],["وَرَقيقُ الأَلفاظِ يَرصُفُ في الأَس","ماعِ دُرّاً وَلُؤلُؤاً مَنظوما",32,"م",2,0],["وَرَقَّ نَسيمُ الريحِ حَتّى حَسِبتَهُ","يَجيءُ بِأَنفاسِ الأَحِبَّةِ نُعَّما",33,"م",2,0],["ورقيقةٍ كالآلِ نادمني بها","كِسرى فرُحتُ كأنَّني من آلِه",34,"ل",2,0],["وَرَقَدْتُ عن غِزلانِه وذِئابِهِ","ما بينَ مَسروقِ الوِصالِ وسارقِ",35,"ق",1,0],["ورَقيقِ ألحاظِ الجُفونِ إذا رَنا","منعَ الجَوَى في القلبِ أن يترَفَّقا",36,"ق",2,0],["ورقَّعَ شِعرَه بعيونِ شِعري","فشابَ الشَّهدَ بالسُّمِّ الزُّعافِ",37,"ف",1,0],["ورَقرقَ الطْبعُ فيه ماءَ رَوْنَقِهِ","فجاء كالوَشْيِ مصقولاً سَبائبُه",38,"ب",2,0],["وَرَقيقِ الخَدَّينِ مُذ قابَلَ الكَأ","سَ بِوَجهٍ كَرِقَّةِ الديباجِ",39,"ج",1,1],["ورقّ ذماءُ نَفْسِ الليل لمَّا","تَنَفَّسَ في جوانبهِ النهارُ",40,"ر",1,0],["وَرَقرَقتُ بَينَ الحُزنِ وَالصَبرِ عَبرَةً","لَها جَيئَةٌ في مُقلَتي وَذَهابُ",41,"ب",1,0],["وَرَقرَقَ الدَمعَ في أَجفانِها رَشَأٌ","تَرَقرَقَ السِحرُ في أَجفانِهِ كَحَلا",42,"ل",2,0],["وَرَقَّ ثَوبُ الأَصيلِ وَاِنفَتَحَت","في وَجنَةِ النَهرِ وَردَةُ الشَمسِ",43,"س",1,0],["وَرُقْعَةُ الشِّطْرَنْجِ ثُمَّ انْتَهَى","ولَمْ أكُنْ لِلفَضلِ بالنّاسِي",44,"ي",1,0],["ورقَيْتَ مَرقاهُ وقُمْتَ مقامَهُ","في بُرْدَةٍ تُذري الدموعَ الذُّرَّفا",45,"ف",2,0],["وُرقٌ بِتَفجِعَةٍ تَنوحُ أَليفَها","غَلَسَ الدُجُنَّةِ في ذُرى الأَعوادِ",46,"د",1,0],["وَرَقبَتِهِ حَتَماتِ المُلو","كِ بَينَ السُرادِقِ وَالحاجِبِ",47,"ب",1,0],["ورقيٍّ أهْلَكَ العالم بُغضا","بين نارٍ وحديدٍ ودماءْ",48,"ا",2,0],["ورقصٌ يُمثِّلُ قلبَ الحياةِ","إذا ما استُخِفَّ بنقرِ الدفوفْ",49,"ف",1,0],["ورِقَّة هاوايَ في شدْوها","إذا جاشَ خاطرُها بالنَّغمْ",49,"م",1,0],["وَرْقاءُ تَسْجَعُ في سَماوَةِ أَيْكَةٍ","مَوْشِيَّةِ الْعَذَباتِ بِالأَنْدَاءِ",50,"ا",2,0],["وَرَقَّتْ لِي قُلوُبُ النَّاسِ حَتَّى","بَكَى لِي كُلُّ سَاقٍ فَوْقَ سَاقِ",51,"ق",1,0],["ورَقَيْتِ بِالحُسْنَى بَنِيكِ فَصُنْتِهِمْ","مِنْ آفَةِ العيْشِ الرَّخِيِّ المُتْرِفِ",52,"ف",1,0],["وَرِقَّةٍ فِي أَسِىً ضَيْمٍ","لاَ يَقْرِبُ الذُّلَّ وَالخُنُوعَا",53,"ع",2,0],["وَرقَّةَ ذَاكَ اللَّفْظ فِي كُلِّ مَوْقِفِ","يُصَانُ بهِ عِرْضٌ وَيَقْنَى بهِ وُدُّ",54,"د",1,0],["وَرِقبَةَ حُسّادٍ صَبَرتُ لِوَقعِها","لَها جانِبٌ مِنّي وَلِلحَربِ جانِبُ",55,"ب",1,0],["ورقصة الربيع في الوديان","وضحكة الأحلام في الثغور",56,"ر",1,0],["ورقَّتْ خِلالك مثلَ النسيم","فكانت على ما تقول شهيدا",57,"د",2,0],["ورقت معاريج العلا لتجوز في","سمط الجلال نظامها المعهودا",58,"د",2,0],["ورقيقها من ليله الجم التقى","وكتابها من فجره وصباحه",59,"ح",2,0],["وَرَقَّتْ نُحُورٌ ماءَهُ وسُحُورُ","بعيدٍ كعيدِ النحرِ ياحُسنَ ما يُرى",60,"ر",2,0],["ورقص الضلال بقاعاته","وأشجار ليمونه العاليه",61,"ي",2,0],["ورقصِ الظلال بقاعاتهِ","وأشجارَ ليمونهِ العاليه",62,"ي",2,0],["ورقرقت دمع العين ثم ملكته","مجال القذى فالدمع في الجفن ناقع",63,"ع",1,0],["ورقى في حظائر القدس متنا","ما رقاه من المشايخ ثاني",64,"ن",2,0],["ورقة اجساد يكاد كثيفها","بلطف الجوى يغدو عن العين غائبا",65,"ب",2,0],["ورقيت ما زال يبحث عنها","ونصوح فيها من العذال",66,"ل",1,0],["ورقيقة المقصود من خلق الوجو","د وعينه في عالم الأسماء",67,"ا",2,0],["ورقى رُتبة الوزارةِ حَتّى","حَلّ تاجاً بمَفرق الوُزَراء",68,"ا",2,0],["وُرقُ الحَمَائِمِ مُذ غَنَّت بِأغصَانِ","بَانٍ تَعَلَّقت وجداً بِابنَةِ ألبَانِ",69,"ن",1,1],["وَرَقَبتُ الهِجَانَ تَعتسِفُ الكُث","بانَ تَنهَارُ تَحتَها الكُثبَانُ",70,"ن",1,0],["وَرُقِيتَ مِن عَينِ الحَسُودِ وشَرِّهِ","وبَقِيتَ وَألاً لِلعُفَاةِ ومَالَفَا",71,"ف",2,0],["وَرَقَّاهُ حََتَّى رَاقَهُ الشَّيخُ أحمَدٌ","وألبَسَهُ مِن حَوكِ هَيبَتِهِ خِلَع",72,"ع",1,0],["ورقمت في طرس الزمانِ مؤرخاً","الخلق في فرح لمولد أحمدِ",73,"د",1,0],["ورقّة تخلب الألباب لو عرضت","على الندامى لصدّوا الراح والحببا",74,"ب",2,0],["ورقَّ الحُداةُ لإنصاتِهم","فأبدلْنَها بالسياطِ النَّغَمْ",75,"م",1,0],["وَرَقّاكَ في قَولِهِ وَالفَعالِ","ذُرى شَرَفٍ لَم يَنَلها بَشَر",76,"ر",1,0],["ورقدة توقظ جفن الردى","ونظرة ترمد طرف السنان",77,"ن",1,0],["ورَقيتُ من مدح الملوك بها","رُتَبا أَنافتْ في العُلى كَنَفا",78,"ف",2,0],["ورَقْمه الجسر وتفريكه ال","موجُ وتَكُّ الخليج تكميل",79,"ل",1,0],["وَرقاءُ فِى اَفنانِ غِيلٍ اَو هَفَت","مِثلُ اللُّيُوثِ الحُمسِ اِذ تَغَضَّفَت",80,"ت",1,0],["ورقاءُ تأرَقُ مقلتي لبكائها","ليلاً إذا ما هَوَّمتْ سمَّارُهُ",81,"ر",2,0],["ورق معناه من فهم بصوره","حتى كأني في الافهام تخييل",82,"ل",1,0],["ورقيت في درج الكمال مكانة","تسمو بها شرفا على الجوزاء",83,"ا",2,0],["ورقى بمنبره خطيب جمالكم","وتلا فاطرب سجعه وكلامه",84,"م",2,0],["ورقَّ معناه في بلاغته","فكاد يخفى على مردده",85,"د",2,0],["ورقيبٍ خبأتُ شخصيَ عنه","أن يراني في مستكِنّ النُحور",86,"ر",1,0],["ورقى وخلّف حاسدي","ه في الحضيض الأسفل",87,"ل",1,0],["ورقيت معراج المديح إلى العلى","ووقفت فيه عند سدرة منتهى",88,"ه",2,0],["ورقّه معراج سعد الإرتِقا","واحفظه بالألطاف من درك الشقا",89,"ق",2,0],["وَرَّقَت بَينَنا الشَكوى فَكانَت","كَرِقَّةِ دَمع راووقِ الشَّرابِ",90,"ب",1,0],["ورقيت الصنائع واستفاقت","شبيبتك الحليفة للديار",91,"ر",1,0],["وَرقى هامَ المَعالي صاعداً","واِمتَطى من كاهِل المجد سَناما",92,"م",2,0],["وَرقاءُ ذاتُ تَفجُّعِ","هتفتْ ففاضتْ أَدمعي",93,"ي",1,1],["وَرقّهما في دولةِ الملكِ الّذي","دَرى منك ما يَخفى على الناس علمهُ",94,"م",2,0],["وَرقراقُ بشرٍ كادَ يقطرُ ماؤهُ"