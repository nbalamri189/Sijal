{"poems":[[53,"جرعتني غصصا ورحت مسلما","https://www.aldiwan.net/poem29966.html","الكامل"],[53,"طلعت والليل مشتمل","https://www.aldiwan.net/poem30438.html","المديد"],[63,"وأغر إن عذر الورى","https://www.aldiwan.net/poem45937.html","مجزوء الكامل"],[57,"ماذا يخبر ضيف بيتك أهله","https://www.aldiwan.net/poem24714.html","الكامل"],[77,"إنما طاشور جعسوس","https://www.aldiwan.net/poem36401.html","مجزوء الرمل"],[77,"هاجتك إذ جئت اللوى فزرودا","https://www.aldiwan.net/poem36535.html","الكامل"],[77,"عبد العزيز خليفة الله الذي","https://www.aldiwan.net/poem36624.html","الكامل"],[73,"تنشق من عرف الصبا ما تنشقا","https://www.aldiwan.net/poem11855.html","الطويل"],[93,"أخا الحزم نبئني أفارقت عن حزم","https://www.aldiwan.net/poem11418.html","الطويل"],[41,"أبت بالشام نفسي أن تطيبا","https://www.aldiwan.net/poem42381.html","الوافر"],[88,"أما آن أن تنسى من القوم أضغان","https://www.aldiwan.net/poem44992.html","الطويل"],[4,"إن تقوى ربنا خير نفل","https://www.aldiwan.net/poem21191.html","الرمل"],[72,"قام يرنو بمقلة كحلاء","https://www.aldiwan.net/poem18165.html","الخفيف"],[72,"سد يا علي فلا نكرا ولا عجبا","https://www.aldiwan.net/poem18233.html","البسيط"],[72,"أهلا بها صحف الإمام المسند","https://www.aldiwan.net/poem18563.html","الكامل"],[72,"يا منزل ابن علي حيتك الصبا","https://www.aldiwan.net/poem19183.html","الكامل"],[72,"مدمع سائل لغير رحيم","https://www.aldiwan.net/poem19679.html","الخفيف"],[72,"عرفت بخدام البكا أجفانه","https://www.aldiwan.net/poem20184.html","الكامل"],[51,"لا تشم للمزن برقا","https://www.aldiwan.net/poem65494.html","مجزوء الرمل"],[51,"غدا الدهر مفترا أغر المضاحك","https://www.aldiwan.net/poem65812.html","الطويل"],[51,"حيتك عنا شمال طاف طائفها","https://www.aldiwan.net/poem66411.html","البسيط"],[91,"سلام عليكم رجال الوفاء","https://www.aldiwan.net/poem8785.html","عموديه"],[70,"أحبابنا حاشاكم","https://www.aldiwan.net/poem42787.html","مجزوء الرجز"],[70,"ورقيب عدمته من رقيب","https://www.aldiwan.net/poem42998.html","الخفيف"],[85,"يا هلال الصيام","https://www.aldiwan.net/poem7891.html","الخفيف"],[85,"اختلاف النهار والليل ينسي","https://www.aldiwan.net/poem63713.html","الخفيف"],[85,"لا السهد يدنيني إليه ولا الكرى","https://www.aldiwan.net/poem63716.html","الطويل"],[85,"نجا وتماثل ربانها","https://www.aldiwan.net/poem63734.html","المتقارب"],[85,"أنادي الرسم لو ملك الجوابا","https://www.aldiwan.net/poem63784.html","الوافر"],[43,"ملامي النوى في ظلمها غاية الظلم","https://www.aldiwan.net/poem10536.html","الطويل"],[62,"يا ليلة السفح ألا عدت ثانية","https://www.aldiwan.net/poem52276.html","البسيط"],[62,"فضحتك رائحة الذنوب بنتنها","https://www.aldiwan.net/poem52380.html","الكامل"],[45,"يا مغاني الأحباب صرت رسوما","https://www.aldiwan.net/poem65684.html","الخفيف"],[45,"أَكان الصبا إِلا خيالا مسلما","https://www.aldiwan.net/poem66638.html","البسيط"],[61,"يأبى إذا خطر العقيق بباله","https://www.aldiwan.net/poem51464.html","الكامل"],[61,"يا دار يوسف لا عدتك تحية","https://www.aldiwan.net/poem51503.html","الكامل"],[61,"كشف الصباح قناعه فتألقا","https://www.aldiwan.net/poem51525.html","المتقارب"],[61,"تلاف السهم أثبت في الشغاف","https://www.aldiwan.net/poem51548.html","الوافر"],[61,"لنا من الدهر خصم لا نغالبه","https://www.aldiwan.net/poem51782.html","البسيط"],[66,"ورقيق الخدين مذ قابل الكأس","https://www.aldiwan.net/poem39665.html","الخفيف"],[80,"نعيمك أن تزف لك العقار","https://www.aldiwan.net/poem31437.html","الوافر"],[74,"شراب الأماني لو علمت سراب","https://www.aldiwan.net/poem12869.html","الطويل"],[74,"الآن سح غمام النصر فانهملا","https://www.aldiwan.net/poem13228.html","البسيط"],[81,"كيف ترى زورة الخليج وقد","https://www.aldiwan.net/poem61443.html","المنسرح"],[67,"قل لولي الدولة المرتجى","https://www.aldiwan.net/poem18074.html","السريع"],[75,"قد سار بي هذا الزمان فأوجفا","https://www.aldiwan.net/poem69062.html","الكامل"],[48,"دعت الهموم إلى شغاف فؤادي","https://www.aldiwan.net/poem62563.html","الوافر"],[19,"ألم تكسف الشمس والبدر والكواكبُ","https://www.aldiwan.net/poem325.html",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39634","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42494","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42710","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55034","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55018","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54706","الطويل"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/852","الطويل"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199476","المنسرح"],[106,"فقيد الفصحى!","https://www.poetsgate.com/ViewPoem.aspx?id=179487",""],[77,"هاجتك إذ جئت اللوى فزرودا","https://www.poetsgate.com/ViewPoem.aspx?id=34092",""],[77,"عبد العزيز خليفة الله الذي","https://www.poetsgate.com/ViewPoem.aspx?id=33544",""],[67,"جِوَارُكَ منْ جَوْرِ الزَّمانِ يُجِيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=14535",""],[99,"دونا ماريا","https://www.poetsgate.com/ViewPoem.aspx?id=16918",""],[99,"دونيا ماريا","https://www.poetsgate.com/ViewPoem.aspx?id=36620",""],[32,"أبت مقلتي كتمان ما بي","https://www.poetsgate.com/ViewPoem.aspx?id=116",""]],"verses":[["وَرَقَبتُهُ فَرَأَيتُهُ مُتَمَنِّعاً","وَبَعَثتُهُ فَوَجَدتُهُ وَقّافا",0,"ف",2,0],["وَرِقابُ القَومِ مايِلَةٌ","مِن بَقايا نَشوَةِ السَهَرِ",1,"ر",1,0],["وَرَقِيبُهُ في نَاظِري","يَ قَذىً وَفي صَدْري شَجَى",2,"ج",2,0],["وَرَقيتُ في دَرَجِ العُلا فَتَضايَقَت","عَمّا أُريدُ شِعابُهُ وَفِجاجُهُ",3,"ج",2,0],["وَرَقُ الأكْرُنْبِ مَجعو","لاً علي خِرْيَةِ هِرْ",4,"ر",1,0],["ورَقَتْ مَعاريجَ العُلا لتَحوزَ في","سِمْطِ الجَلالِ نِظامَها المَعْهودا",5,"د",2,0],["ورَقيقُها من لَيْلِهِ أنْجُمُ التُّقى","وكِتابُها منْ فَجْرِهِ وصَباحِهِ",6,"ح",2,0],["وَرِقَّةَ أَنفاسٍ وَصِحَّةَ جَوهَرِ","وَناهيكَ مِن مَبدا جَمالٍ وَمَحضِرِ",7,"ر",1,0],["وَرِقَّةِ مُحْتَالٍ وَشِدَّةِ مُفْحِمٍ","يُنَسَّمُ عَنْ رَوْضٍ وَيُغْدِقُ عَنْ يَمِّ",8,"م",1,0],["وَرَقَّقَني هَوَاكِ وكُنتُ جَلداً","وَأَبدى في مَفَارِقِيَ المَشيبَا",9,"ب",2,0],["ورقّت قلوب للعراق وأهله","وأصغت إلى شكوى فلسطين آذان",10,"ن",1,0],["وَرَقاقٍ عُصَبٍ ظُلمانُهُ","كَحَزيقِ الحَبَشِيِّينَ الزُجَل",11,"ل",1,0],["ورقى صاعداً فلم يبقَ للحا","سدِ إلا تنفسُ الصعداء",12,"ا",2,0],["ورقّ معنى حديثٍ فهو حينئذٍ","دمعٌ جرى فقضى في الرُّبعِ ما وَجبا",13,"ب",2,0],["ورقيمة الألفاظِ باكر بابها","كهفٌ يروح له الثناء ويغتدِي",14,"د",2,0],["ورقى لديك الطير منبر أيكة","فعلمت أنك للمسرّة جامع",15,"ع",1,0],["ورقيم من العذار ثناني","ساهراً طول ليلتي بالرقيم",16,"م",1,0],["ورقيم حاشية العذار وكلّ ذي","حسنٍ بحاشية الفتى غلمانه",17,"ن",2,0],["ورقيتم حيَّة السل","طان والحيات تُرقى",18,"ق",2,0],["ورقاصةٍ بالطبلِ والصنجِ كاعبٌ","لها غُنْجُ مِخناثٍ وتَكريهُ فاتك",19,"ك",1,0],["وُرْقٌ تَغَنَّى على خُضْرٍ مُهَدَّلةٍ","تَسْمو بها وتشمُّ الأرضَ أحيانا",20,"ن",2,0],["وَرَقصَ الأَشِعَّةِ فَوقَ الرَوابي","وَضِحكَ الجَداوِل وَالقَهقَهات",21,"ت",1,0],["وَرَقُها أَبيَضُ لَ","كِن كَبَياضِ البَهَقِ",22,"ق",1,0],["وَرَقيبٍ عَدِمتُهُ مِن رَقيبٍ","أَسوَدِ الوَجهِ وَالقَفا وَالصِفاتِ",23,"ت",1,1],["ورقيب على الدياجي إذا أل","قت عصاها صدّعتِها بعصاكا",24,"ك",2,0],["وَرَقيقٍ مِنَ البُيوتِ عَتيقٌ","جاوَزَ الأَلفَ غَيرَ مَذمومِ حَرسِ",25,"س",1,0],["وَرَقَدتَ تُزلِفُ لِلخَيالِ مَكانَهُ","بَينَ الجُفونِ وَبَينَ هُدبِكَ وَالكَرى",26,"ر",2,0],["وَرَقَّت لِآثارِهِ في القَميصِ","كَأَنَّ قَميصَكَ قُرآنُها",27,"ن",3,0],["وَرَقِّق لِلفَقيرِ بِها قُلوباً","مُحَجَّرَةً وَأَكباداً صِلابا",28,"ب",2,0],["وَرِقَّةُ وَجهٍ لَو خَتَمتَ بِنَظرَةٍ","عَلى وَجنَتَيهِ ما اِنمَحى أَثَرُ الخَتمِ",29,"م",1,0],["ورقَّ لي قلبُه القاسي ومكَّننِي","ممّا أردتُ فلم آثمْ ولم أُلَمِ",30,"م",1,0],["ورقدتَ ليلَكَ آمِناً متمِهّلاً","ونَسِيتَ كيف طَوارِقُ الأسحارِ",31,"ر",1,0],["وَرَقيقُ الأَلفاظِ يَرصُفُ في الأَس","ماعِ دُرّاً وَلُؤلُؤاً مَنظوما",32,"م",2,0],["وَرَقَّ نَسيمُ الريحِ حَتّى حَسِبتَهُ","يَجيءُ بِأَنفاسِ الأَحِبَّةِ نُعَّما",33,"م",2,0],["ورقيقةٍ كالآلِ نادمني بها","كِسرى فرُحتُ كأنَّني من آلِه",34,"ل",2,0],["وَرَقَدْتُ عن غِزلانِه وذِئابِهِ","ما بينَ مَسروقِ الوِصالِ وسارقِ",35,"ق",1,0],["ورَقيقِ ألحاظِ الجُفونِ إذا رَنا","منعَ الجَوَى في القلبِ أن يترَفَّقا",36,"ق",2,0],["ورقَّعَ شِعرَه بعيونِ شِعري","فشابَ الشَّهدَ بالسُّمِّ الزُّعافِ",37,"ف",1,0],["ورَقرقَ الطْبعُ فيه ماءَ رَوْنَقِهِ","فجاء كالوَشْيِ مصقولاً سَبائبُه",38,"ب",2,0],["وَرَقيقِ الخَدَّينِ مُذ قابَلَ الكَأ","سَ بِوَجهٍ كَرِقَّةِ الديباجِ",39,"ج",1,1],["ورقّ ذماءُ نَفْسِ الليل لمَّا","تَنَفَّسَ في جوانبهِ النهارُ",40,"ر",1,0],["وَرَقرَقتُ بَينَ الحُزنِ وَالصَبرِ عَبرَةً","لَها جَيئَةٌ في مُقلَتي وَذَهابُ",41,"ب",1,0],["وَرَقرَقَ الدَمعَ في أَجفانِها رَشَأٌ","تَرَقرَقَ السِحرُ في أَجفانِهِ كَحَلا",42,"ل",2,0],["وَرَقَّ ثَوبُ الأَصيلِ وَاِنفَتَحَت","في وَجنَةِ النَهرِ وَردَةُ الشَمسِ",43,"س",1,0],["وَرُقْعَةُ الشِّطْرَنْجِ ثُمَّ انْتَهَى","ولَمْ أكُنْ لِلفَضلِ بالنّاسِي",44,"ي",1,0],["ورقَيْتَ مَرقاهُ وقُمْتَ مقامَهُ","في بُرْدَةٍ تُذري الدموعَ الذُّرَّفا",45,"ف",2,0],["وُرقٌ بِتَفجِعَةٍ تَنوحُ أَليفَها","غَلَسَ الدُجُنَّةِ في ذُرى الأَعوادِ",46,"د",1,0],["وَرَقبَتِهِ حَتَماتِ المُلو","كِ بَينَ السُرادِقِ وَالحاجِبِ",47,"ب",1,0],["ورقيٍّ أهْلَكَ العالم بُغضا","بين نارٍ وحديدٍ ودماءْ",48,"ا",2,0],["ورقصٌ يُمثِّلُ قلبَ الحياةِ","إذا ما استُخِفَّ بنقرِ الدفوفْ",49,"ف",1,0],["ورِقَّة هاوايَ في شدْوها","إذا جاشَ خاطرُها بالنَّغمْ",49,"م",1,0],["وَرْقاءُ تَسْجَعُ في سَماوَةِ أَيْكَةٍ","مَوْشِيَّةِ الْعَذَباتِ بِالأَنْدَاءِ",50,"ا",2,0],["وَرَقَّتْ لِي قُلوُبُ النَّاسِ حَتَّى","بَكَى لِي كُلُّ سَاقٍ فَوْقَ سَاقِ",51,"ق",1,0],["ورَقَيْتِ بِالحُسْنَى بَنِيكِ فَصُنْتِهِمْ","مِنْ آفَةِ العيْشِ الرَّخِيِّ المُتْرِفِ",52,"ف",1,0],["وَرِقَّةٍ فِي أَسِىً ضَيْمٍ","لاَ يَقْرِبُ الذُّلَّ وَالخُنُوعَا",53,"ع",2,0],["وَرقَّةَ ذَاكَ اللَّفْظ فِي كُلِّ مَوْقِفِ","يُصَانُ بهِ عِرْضٌ وَيَقْنَى بهِ وُدُّ",54,"د",1,0],["وَرِقبَةَ حُسّادٍ صَبَرتُ لِوَقعِها","لَها جانِبٌ مِنّي وَلِلحَربِ جانِبُ",55,"ب",1,0],["ورقصة الربيع في الوديان","وضحكة الأحلام في الثغور",56,"ر",1,0],["ورقَّتْ خِلالك مثلَ النسيم","فكانت على ما تقول شهيدا",57,"د",2,0],["ورقت معاريج العلا لتجوز في","سمط الجلال نظامها المعهودا",58,"د",2,0],["ورقيقها من ليله الجم التقى","وكتابها من فجره وصباحه",59,"ح",2,0],["وَرَقَّتْ نُحُورٌ ماءَهُ وسُحُورُ","بعيدٍ كعيدِ النحرِ ياحُسنَ ما يُرى",60,"ر",2,0],["ورقص الضلال بقاعاته","وأشجار ليمونه العاليه",61,"ي",2,0],["ورقصِ الظلال بقاعاتهِ","وأشجارَ ليمونهِ العاليه",62,"ي",2,0],["ورقرقت دمع العين ثم ملكته","مجال القذى فالدمع في الجفن ناقع",63,"ع",1,0]]}