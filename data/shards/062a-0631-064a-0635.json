{"poems":[[55,"غزال ماطل ديني","https://www.aldiwan.net/poem29739.html","الهزج"],[32,"قف العيس في أطلال مية فاسأل","https://www.aldiwan.net/poem29540.html","الطويل"],[29,"أصبح حبل وصلكم رماما","https://www.aldiwan.net/poem5987.html","الوافر"],[53,"مطايب عيش زايلته مخابثه","https://www.aldiwan.net/poem9226.html","الطويل"],[30,"نصبتم له قدرا فلما غلت لكم","https://www.aldiwan.net/poem5041.html","الطويل"],[51,"لكم فجع الدهر من والد","https://www.aldiwan.net/poem62064.html","المتقارب"],[68,"ليحيى فم لو علق المسك فوقه","https://www.aldiwan.net/poem38600.html","الطويل"],[82,"وممشوقة القد معشوقة","https://www.aldiwan.net/poem31373.html","المتقارب"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85305","المجتث"],[369,"خيالك من قبل الكرى طارقي ذكرا","https://www.aldiwan.net/poem60916.html","الطويل"],[543,"كما شئت مر فالدهر ممتثل أمرا","https://www.aldiwan.net/poem48181.html","عموديه"],[609,"","https://poetry.dctabudhabi.ae/diwan/poem/198597","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122581","الوافر"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64039","الهزج"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56097","الطويل"],[1415,"","https://poetry.dctabudhabi.ae/diwan/poem/102284","السريع"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49969","الطويل"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102058","الوافر"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101045","الوافر"],[2241,"","https://poetry.dctabudhabi.ae/diwan/poem/10470","البسيط"],[2491,"","https://poetry.dctabudhabi.ae/diwan/poem/115056","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75863","المتقارب"],[2973,"","https://poetry.dctabudhabi.ae/diwan/poem/107027","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65124","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100783","الطويل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97088","الطويل"],[4776,"وإني لا ستحيي بدنياي أن أرى","https://www.poetsgate.com/ViewPoem.aspx?id=99983",""],[6115,"خذ الصاحب الونعم وقل للبقيه طز","https://www.poetsgate.com/ViewPoem.aspx?id=180533",""]],"verses":[["تُرى صَرفُ المَقاديرِ","مَتى يَصحو مِنَ الأَينِ",0,"ن",1,0],["تَرى صَمدَهُ في كُلِّ ضِحٍّ تُعينُهُ","حَرورٌ كَتَشعالِ الضِرامِ المُشَعِّلِ",1,"ل",1,0],["تُري صَديانَ مَشرَعَةً شِفاءً","فَحامَ وَلَيسَ وارِدَها وَحاما",2,"م",2,0],["ترى صاحبَيْه ذا سؤالٍ يَميحُهُ","فواضلهُ أو ذا سؤالٍ يُباحِثُهْ",3,"ث",2,0],["تَرى صَدَأَ الماذِيِّ فَوقَ جُلودِهِم","وَفي السِلمِ أَملاكٌ رِقاقٌ يَرودُها",4,"د",3,0],["تَرى صُوَراً تُعجِبُ الناظِرينَ","وَمَخبَرَةً تَحتَها فاسِدَه",5,"د",2,0],["تَرى صَحبَهُ الحُضّارَ مِن نَتنِ ريحِهِ","كَأَنَّهُمُ مِن طولِ ما اِلتَثَموا مُردُ",6,"د",1,0],["ترى صَدَّها عاقلاً رُوحَهُ","فيا وَصْلَها جُدْ بإطْلاقِها",7,"ق",3,0],["تَري صدوراً من الشو","ق وَالصبابة تغلي",8,"ل",2,0],["تَرى صَدْرَه بَحراً وأنمُلَه حياً","وأخلاقَه روضاً وآدابَه زَهرا",9,"ر",2,0],["تَرى صافِناتِ الخَيلِ تَختالُ تَحتَهُم","كأنَّ الجِيادَ الصَّافناتِ بِهم سَكرى",10,"ر",2,0],["تَرَى صَرْحَ المَكَارِمِ والْمَعَالي","مَشِيداً ثَم هَلْ لكَ أَنْ تَزُورَا",11,"ر",2,0],["تَرى صيدَ الملوكِ ولو تَعالوا","بِفضلِك سُوقةً والحرَّ عبدا",12,"د",2,0],["ترى صورتَه مخلو","سةَ الجُثْمانِ مَخطوفه",13,"ف",2,0],["ترى صدر بيت قد حواه ختامها","فامعن بما قد قلعه تبلغ الهدى",14,"د",2,0],["ترى صباها نشراً عطرها","كأنما قد ضمنت عنبرا",15,"ر",2,0],["تَرى صورةَ مخلوقةَ من فضائل","تكافأ فيها منظرُ العين والخُبزُ",16,"ز",1,0],["ترى صبح الهدى ينشق عمداً","لغرة وجهه سطع الثناء",17,"ا",2,0],["ترى صبر القنوع له غذاءً","جرى دمع الخشوع له إداما",18,"م",2,0],["تَرى صُدورَهُمُ سُمراً مُحَشَّرَةً","وَفي أَسافِلِهِم نَشرٌ وَتَشميرُ",19,"ر",1,0],["ترى صاحبي يَبكي قليلاً لفُرقتي","ويضحكَ من طولِ الليالي على قبري",20,"ر",2,0],["تَرى صاحِ يَدري غَرامي بَدري","فَإِنَّ بِصَدري حَريقَ لَهيبِ",21,"ب",1,0],["ترى صرح بلقيس اذا ما رأيتها","فتعذر من قد كان يحسبه بحرا",22,"ر",2,0],["ترى صهوات الخيل تحسدُ بعضها","بما قد علا منها وصار بها رمزا",23,"ز",2,0],["ترى صاحب التاج المرصع فوقه","وتبصر ليثاً للخلافة هيصما",24,"م",2,0],["ترى صبيتي ذي شفها سوط قارعٍ","وذي في يديها تتقي كف صافق",25,"ق",1,0],["ترى صلحاء الناس يتخذونني","أخاً ولساني للئام شتوم",26,"م",1,0],["ترى صقر واحد عن ميه من طيور الوزّ","وكف الصقر ماهو مثل مخلب الوزّه",27,"ز",2,0]]}