{"poems":[[57,"يقولون لي واصل سواها لعلها","https://www.aldiwan.net/poem26186.html","الطويل"],[30,"تحن بزوراء المدينة ناقتي","https://www.aldiwan.net/poem5618.html","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54279","الطويل"],[111,"أشعة الحق لا تخفى عن النظر","https://www.poetsgate.com/ViewPoem.aspx?id=512",""],[234,"والله لو لم يكن في الدمع يوم نأواوش","https://www.aldiwan.net/poem50784.html","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96687","الوافر"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139703",""]],"verses":[["تَآزَرنَ فيما بَينَهُنَّ فَجِئنَها","عَلى وَجهِ إِلقاءِ النَصيحَةِ لِلمَحلِ",0,"ل",1,0],["تَأَزَّرَ بَينَ القابِلاتِ وَلَم يَكُن","لَهُ تَوأَمٌ إِلّا دَهاءٌ لِحازِمِ",1,"م",1,0],["تَأَزَّر مِنْ أَثْوابِه الرَّوْضُ واكْتَسَى","فَرقَّت حَواشِيه وطَالت مَآزِرُه",2,"ر",2,0],["تأزروا شعب الإيمان وانتبهوا","بين الجهادين منهم أنفس العمر",3,"ر",1,0],["تأزَّرَ الغصنُ دِعصا في ثيابكِ أم","تعمّم البدرُ في أزرارك الظُّلمَا",4,"م",2,0],["تأزّرَ بِالمكارمِ واغ","تَدا بالحمدِ مُلتحَفا",5,"ف",2,0],["تَأزَّرَ الدَّهرُ عَلَيهِ وَارتَدَى","الجَدُّ يُدنِي القَاصِي المُزَحَّلا",6,"ل",2,0],["تأزَّر بالجدوى وفي مجده أحتبى","وبالفضل والتقوى ارتدى وتلفَّعا",7,"ع",2,0]]}