501",""],[4815,"حرب مع الذَّات","https://www.poetsgate.com/ViewPoem.aspx?id=210640",""],[5324,"أنا لا أسميه شيا","https://www.poetsgate.com/ViewPoem.aspx?id=207173",""],[5442,"قد براها جذب البرى والأزمة","https://www.poetsgate.com/ViewPoem.aspx?id=114766",""],[5582,"غاداكَ مِنْ دِيَمِ الحَيا ضَحْوِيُّها","https://www.poetsgate.com/ViewPoem.aspx?id=187333",""],[5956,"رَفَّ البليبل","https://www.poetsgate.com/ViewPoem.aspx?id=183637",""],[5956,"لله درك يا أحنَّ حبيبِ","https://www.poetsgate.com/ViewPoem.aspx?id=193815",""],[5970,"الليل جن فأسرعا","https://www.poetsgate.com/ViewPoem.aspx?id=130586",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[6256,"هاجرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65914&r=&rc=2",""]],"verses":[["لَم يَهوَ مَن لَم يُمسِ قُرَّةَ عَينِهِ","سَهَرُ الصَبابَةِ في خَلِيٍّ هاجِعِ",0,"ع",1,0],["لِمَيَّةَ عِندَ الزُرقِ لَأياً عَرَفتُها","بِجُرثومَةِ الآريّ وَالمُتَخَيَّمِ",1,"م",1,0],["لِمَيَّةَ إِذ لا نَشتَري بِزَمانِنا","زَماناً وَإِذ لا نَصطَفي مَن يَغولُها",2,"ل",3,0],["لِمَيَّةَ إِذ مَيٌّ مَعانٌ تَحُلُّهُ","فِتاخٌ فَحُزوى في الخَليطِ المُجاوِرِ",3,"ر",1,0],["لِمَيَّةَ أَطلالٌ بِحُزوَى دَوائِرُ","عَفَتها السَوافي بَعدَنا وَالمَواطِرُ",4,"ر",1,1],["لَم يُهينوا المَولى عَلى حَدَثِ الدَه","رِ وَلا تَجتَويهِمُ الأَصهارُ",5,"ر",1,0],["لَم يَهَب لي صُبابَةً مِن رُقادٍ","لَم يَجُد لي فيها بِطَيفِ خَيالِك",6,"ك",1,0],["لَم يَهجُروكَ مَلالَةً لَكِنَّهُم","خُلِقوا لِصَيدِ اللُؤلُؤِ المَكنونِ",7,"ن",1,0],["لِمَيَّةَ حَيّا بِالسَلامِ كَأَنَّما","عَلَيهِ دَماً لا يَقبَلُ المالَ ثائِرُه",8,"ر",2,0],["لم يَهْدِني نجمٌ إليهِ ولم","يَبسِمْ ليَ الحظُّ فألقى سَناه",9,"ه",1,0],["لَم يَهدِ رَكبي سَناهُ","حَتّى خَبا فَلحدتُه",10,"ت",2,0],["لَم يَهِن بَل واظَبَ القَر","آنَ حَتّى اِشتَدَّ بَلوى",11,"و",2,0],["لم يهدموا قريةً عزلاء، بل هدموا","ركنَ السلام بأيديهم، وما شعروا!",12,"ر",3,0],["لم يهتدوا لكنوزها؛ فإذا همو","يرمونها بالفقر، والإعدام",13,"م",1,0],["لم يهو عزّ الحسن في خفراته","وأحبّه عند القيان ذليلا",14,"ل",2,0],["لِمَيّةَ، حَيّا بِالسّلامِ كَأنّمَا","عَلَيْهِ دمٌ لا يَقْبَلُ المالَ ثَائِرُهْ",15,"ر",2,0],["لَم يَهَبهُ رَيبُ المَنونِ فَبادَ الْ","ملك عَنهُ فَبابُهُ مَهجورُ",16,"ر",1,0],["لَم يَهتَدِ المَرءُ كِسرى أَن يُدَبِّرَهُ","وَكانَ أَرجَحَها عَقلاً وَتَمكِينا",17,"ن",2,0],["لَم يهدم الدنيا بحطم حطامها","الا ليزرع ما سيحصد في غد",18,"د",1,0],["لَم يَهدِه إلّا تَصعُّد زَفرَتي","فكأَنَّها نارٌ تُشبُّ لسارِ",19,"ر",1,0],["لَمْ يُهدِ مَلْكُ الصِّينِ أَحْسَنَ منهما","أَخَوَيْنِ كالقَمريْن عِندَ كَمالِ",20,"ل",1,0],["لم يهده الرأي إلاَّ للضلال ولا","يزيده عدم التوفيق غير عمى",21,"م",2,0],["لم يهوك القلب إن أظهرت أنت له","براً فيسلاك إذا أظهرت تقصيرا",22,"ر",2,0],["لم يَهِنيِّ إِلاَّ هَواهُ ولا د","ل عليَّ السَّقامَ إِلاَّ دلاَلُه",23,"ل",2,0],["لم يَهدِ هديَك إنسانٌ ولا ولَدٌ","شخصاً كَشخصِكَ لا أنثى ولا ذَكَرُ",24,"ر",1,0],["لم يهبك العظيم غليوم إلا","ثمن العلم بل جزاء الرفيق",25,"ق",1,0],["لم يهن خارج عليك من الوا","دي وهانت عليك شم جباله",26,"ل",2,0],["لم يهتبلْ غُلَواءُ عيشِكَ كَنزَهُ","إلا أفاءَ عليك عيشاً بُرزُغا",27,"غ",2,0],["لَم يَهتَدوا لِكُنوزِها فَإِذا بِهِم","يَرمونَها بِالفَقرِ وَالإِعدامِ",28,"م",1,0],["لم يَهْنَ لي من بعدها عيش ولا","طابت لديَّ مجالس اللذات",29,"ت",1,0],["لم يهدِنا لنسيمكم","غير الخُزَامى والعَرارْ",30,"ر",1,0],["لم يهدها غيلانه لبلاله","أبداً ولم يَسبق بها أمويُّها",31,"ي",3,0],["لم يهدِ نرجسهُ إليك وإنما","لغرامهِ أهدى إليكَ عيونه",32,"ه",1,0],["لم يهد الا اليه قول ذي نظر","ما كان اوتي آت غيره نظرا",33,"ر",2,0],["لَم يَهَب حُرمَةَ النَديمِ وَحُقَّت","يا لِقَومي لِلسَوأَةِ السَوآءِ",34,"ا",2,0],["لَم يَهجُنا اللَهُ اللَطيفُ مُفاكِهاً","إِلّا رِضاءً لا لِمَحضِ سِبابِ",35,"ب",1,0],["لم يهب نعمة بلا سبب اخرى","لبنيه ولا يدوم بقاها",36,"ا",3,0],["لم يهنني بسَهامَ مذ فارقتكم","عَيشٌ ولا ماءٌ بجاحِف سَلَسْلُ",37,"ل",1,0],["لَم يَهابوا جَمع العِدى يَوم صالوا","وَإِن استنزروا وقلّ العَديد",38,"د",1,0],["لم يَهدِنا نَحْوَهُ بالنّارِ في غَسَق","ولا النِّباحُ سوى الفانوسِ والكاسِ",39,"س",1,0],["لم يهبني أهلي سوى اسمٍ جميل","زاد حسناً بكونه نبويّا",40,"ي",2,1],["لم يهيموا بالروح مبدعة الفنّ","وهاموا من دونها بالفنون",41,"ن",1,0],["لم يهب شخصَه الرّدى بعد أن كا","نتْ لهُ هيبة على كل تُركي",42,"ك",2,0],["لِمَيَّةَ إِذ طَرَقَت مَوهِناً","فأَضحى بِها دَنِفاً مُستَجافا",43,"ف",2,0],["لم يهُلْنا المَغيبُ لو هيَ وافَتْ","لمواقِيتِ عوْدِها وأهَلّتْ",44,"ت",1,0],["لم يهاجر وله في مكة","ناصر يدفع ضيماً واهتضاما",45,"م",2,0],["لم يهبطان وَيعلوان تشرفاً","وَبِوَهجِ حَرِّ الشَمسِ يَحتَرِقانِ",46,"ن",1,0],["لمية ربع بالصريمة دارس","الحت بمرّاها عليه الطوامس",47,"س",1,1],["لِمَيَّةَ خَدٌّ بِهِ وَردَة","تُفتِّحُهُ نَظرَةٌ أَو خَجَل",48,"ل",1,0],["لَم يَهنَني ذاكَ الفَقدِ اِمرىءٍ","أَبيَضَ مِثلِ البَدرِ وَضّاحِ",49,"ح",1,0],["لم يهو صرامه عليها راكعاً","إلا وغادر سجداً أذقانها",50,"ن",3,0],["لم يَهِجْ صدايَ سوى","مبسمٍ به شَنب",51,"ب",1,0],["لم يَهُن قطُّ علينا بُعدُكم","مثلما هانَ عليكم بُعدُنا",52,"ن",2,0],["لم يهابوا المنون والموت صعب","ويهابون الظلم والعُدوانا",53,"ن",2,0],["لم يُهدَ قَومٌ إلى حَقٍّ وَ رَأْسُهُمُ","ما زالَ يَشعُرُ فِعلاً أَنَّهُمْ غَنَمُ",54,"م",1,0],["لم يَهُنْ يَوماً ولا اقتيد سَبيّا","ذَلّتِ الدنيا.. وَمازالَ عَصِيّا",55,"ي",2,0],["لم يهب في الإنذار أمة كفر","لا ولم يخش من بسؤ أمه",56,"م",2,0],["لَمْ يُهْدِها غَيْلانُها لِبِلالِهِ","أَبَداً لَمْ يَسْبِقْ بِها أُمَوِيُّها",57,"ي",3,0],["لم يهْوَ طول العمر إلا حكمَهم","ويريد فيها أن يقامَ بدفْنِهِ",58,"ن",2,0],["لم يَهوِ قدْرُك في القداسة عن عُلا","صحب النبي الصِّيد أو يعقوبِ..",59,"ب",1,0],["لم يهن بالدنيا ولم","يغنم بها إلا العذابا",60,"ب",2,0],["لَم يهض أمه وَلا الظهر أَنقض","بمخاض بسرعة البرق أَومض",61,"ض",1,0],["لم يهن في قلبه صفو الهوى","كيف تنسين رعا الله صباك",62,"ك",1,0]]}