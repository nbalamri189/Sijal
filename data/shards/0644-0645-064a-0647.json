{"poems":[[73,"ما طول عذلك للمحب بنافع","https://www.aldiwan.net/poem11925.html","الكامل"],[30,"ألا أيهذا المنزل الدارس اسلم","https://www.aldiwan.net/poem29526.html","الطويل"],[30,"ألا حي دارا قد أبان محيلها","https://www.aldiwan.net/poem29538.html","الطويل"],[30,"أشاقتك أخلاق الرسوم الدواثر","https://www.aldiwan.net/poem29579.html","الطويل"],[30,"لمية أطلال بحزوى دوائر","https://www.aldiwan.net/poem29586.html","الطويل"],[4,"إنما يحفظ التقى الأبرار","https://www.aldiwan.net/poem21168.html","الخفيف"],[47,"يا أخي قد وهبت ذنب زمان","https://www.aldiwan.net/poem25215.html","الخفيف"],[91,"بأبي خيال لاح لي متلففا","https://www.aldiwan.net/poem62779.html","عموديه"],[28,"لقد هاج من عيني ماء على الهوى","https://www.aldiwan.net/poem5197.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39625","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43667","المجتث"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43818","الرمل"],[106,"إلى الغزاة الهادمين","https://www.poetsgate.com/ViewPoem.aspx?id=179650",""],[106,"قومي بين الشرق والغرب","https://www.poetsgate.com/ViewPoem.aspx?id=179442",""],[28,"لقد هاج من عيني ماء على الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=21061",""],[20,"أرواح مودع أم بكور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69771&r=&rc=12",""],[167,"بعض الذي نالنا يا دهر يكفينا","https://www.aldiwan.net/poem1686.html",""],[269,"خطرت كغصن البانة المتأود","https://www.aldiwan.net/poem52072.html","الكامل"],[295,"وافى خيالك بعد طول نفار","https://www.aldiwan.net/poem33268.html","الكامل"],[346,"ما أنصف الصحنين مني واصف","https://www.aldiwan.net/poem20631.html","الكامل"],[413,"اليوم أصبح فيك الوقت منتظما","https://www.aldiwan.net/poem54127.html","البسيط"],[511,"ألا تكن في الهوى أرويت من ظماء","https://www.aldiwan.net/poem67749.html","البسيط"],[573,"لا تسل عنه كيف أصبح حاله","https://www.aldiwan.net/poem3028.html","الخفيف"]],"verses":[["لَم يَهوَ مَن لَم يُمسِ قُرَّةَ عَينِهِ","سَهَرُ الصَبابَةِ في خَلِيٍّ هاجِعِ",0,"ع",1,0],["لِمَيَّةَ عِندَ الزُرقِ لَأياً عَرَفتُها","بِجُرثومَةِ الآريّ وَالمُتَخَيَّمِ",1,"م",1,0],["لِمَيَّةَ إِذ لا نَشتَري بِزَمانِنا","زَماناً وَإِذ لا نَصطَفي مَن يَغولُها",2,"ل",3,0],["لِمَيَّةَ إِذ مَيٌّ مَعانٌ تَحُلُّهُ","فِتاخٌ فَحُزوى في الخَليطِ المُجاوِرِ",3,"ر",1,0],["لِمَيَّةَ أَطلالٌ بِحُزوَى دَوائِرُ","عَفَتها السَوافي بَعدَنا وَالمَواطِرُ",4,"ر",1,1],["لَم يُهينوا المَولى عَلى حَدَثِ الدَه","رِ وَلا تَجتَويهِمُ الأَصهارُ",5,"ر",1,0],["لَم يَهَب لي صُبابَةً مِن رُقادٍ","لَم يَجُد لي فيها بِطَيفِ خَيالِك",6,"ك",1,0],["لَم يَهجُروكَ مَلالَةً لَكِنَّهُم","خُلِقوا لِصَيدِ اللُؤلُؤِ المَكنونِ",7,"ن",1,0],["لِمَيَّةَ حَيّا بِالسَلامِ كَأَنَّما","عَلَيهِ دَماً لا يَقبَلُ المالَ ثائِرُه",8,"ر",2,0],["لم يَهْدِني نجمٌ إليهِ ولم","يَبسِمْ ليَ الحظُّ فألقى سَناه",9,"ه",1,0],["لَم يَهدِ رَكبي سَناهُ","حَتّى خَبا فَلحدتُه",10,"ت",2,0],["لَم يَهِن بَل واظَبَ القَر","آنَ حَتّى اِشتَدَّ بَلوى",11,"و",2,0],["لم يهدموا قريةً عزلاء، بل هدموا","ركنَ السلام بأيديهم، وما شعروا!",12,"ر",3,0],["لم يهتدوا لكنوزها؛ فإذا همو","يرمونها بالفقر، والإعدام",13,"م",1,0],["لِمَيّةَ، حَيّا بِالسّلامِ كَأنّمَا","عَلَيْهِ دمٌ لا يَقْبَلُ المالَ ثَائِرُهْ",14,"ر",2,0],["لَم يَهَبهُ رَيبُ المَنونِ فَبادَ الْ","ملك عَنهُ فَبابُهُ مَهجورُ",15,"ر",1,0],["لَم يَهتَدِ المَرءُ كِسرى أَن يُدَبِّرَهُ","وَكانَ أَرجَحَها عَقلاً وَتَمكِينا",16,"ن",2,0],["لَم يهدم الدنيا بحطم حطامها","الا ليزرع ما سيحصد في غد",17,"د",1,0],["لَم يَهدِه إلّا تَصعُّد زَفرَتي","فكأَنَّها نارٌ تُشبُّ لسارِ",18,"ر",1,0],["لَمْ يُهدِ مَلْكُ الصِّينِ أَحْسَنَ منهما","أَخَوَيْنِ كالقَمريْن عِندَ كَمالِ",19,"ل",1,0],["لم يهده الرأي إلاَّ للضلال ولا","يزيده عدم التوفيق غير عمى",20,"م",2,0],["لم يهوك القلب إن أظهرت أنت له","براً فيسلاك إذا أظهرت تقصيرا",21,"ر",2,0],["لم يَهِنيِّ إِلاَّ هَواهُ ولا د","ل عليَّ السَّقامَ إِلاَّ دلاَلُه",22,"ل",2,0]]}