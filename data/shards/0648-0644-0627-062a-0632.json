5183,"روح البردة","https://www.poetsgate.com/ViewPoem.aspx?id=186547",""],[5198,"نواف","https://www.poetsgate.com/ViewPoem.aspx?id=156536",""],[5246,"إني لفي أسف مما له انقلبوا","https://www.poetsgate.com/ViewPoem.aspx?id=187030",""],[5277,"يا سيّدَ الناس","https://www.poetsgate.com/ViewPoem.aspx?id=188104",""],[5582,"سُلطانُ لا زِلْتَ فِي عَلْياكَ سُلْطانا","https://www.poetsgate.com/ViewPoem.aspx?id=187305",""],[5605,"رحلة عابر","https://www.poetsgate.com/ViewPoem.aspx?id=159458",""],[5756,"قدها وقدود","https://www.poetsgate.com/ViewPoem.aspx?id=5439",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5897,"إلى .. اليمن الذي كان سعيداً !","https://www.poetsgate.com/ViewPoem.aspx?id=176758",""],[6023,"إذا ما كنت في قومٍ غريباً","https://www.poetsgate.com/ViewPoem.aspx?id=123854",""],[6152,"يا صبح أخبرها","https://www.poetsgate.com/ViewPoem.aspx?id=203398",""]],"verses":[["ولا تزال وإن صلت جوارحهم","ترعى سرائرهم أن يعبد الصنم",0,"م",1,0],["وَلا تَزرَعوا شَوكَ القَتادِ فَإِنَّكُم","جَديرونَ أَن تُدمَوا بِهِ وَتُشاكوا",1,"ك",3,0],["وَلا تَزالُ هُمومُ النَفسِ طارِقَةً","رُسلُ البَياضِ إِلى الفَودينِ تَختَلِفُ",2,"ف",1,0],["وَلا تَزهَدَن في وَصلِ أَهلِ قَرابَةٍ","وَلا تَكُ سَبعاً في العَشيرَةِ عادِيا",3,"ي",2,0],["ولا تزجُر الغربان في البحر إنها","سفائن والبحرُ المذلَّلُ حاملُ",4,"ل",1,0],["ولا تزكو المَناشىء في أناس","يرون الطفل من سَقَط المتاع",5,"ع",1,0],["ولا تزحزَحُ عن فضلٍ شمائلهُ","كأنَّها لبدورِ الفضلِ هالات",6,"ت",1,0],["ولا تزل للورى جبراً لمنكسرٍ","وقراً لمفتقرٍ ملكاً لممتثل",7,"ل",1,0],["ولا تزل صورتي إذا طلعت","لناظريه قذاه بل رمدَهْ",8,"د",2,0],["ولا تزعزع حلمي وتأمل أن","ترسوَ إن الجبال تقتلع",9,"ع",1,0],["ولا تزل لي بالشكرِ قافيةٌ","فيك تسيرُ الوجيفَ والرَّتكا",10,"ك",2,0],["ولا تَزَلْ من لبوس عافيةٍ","وسِترِ نعماءَ في سرابيلِ",11,"ل",1,0],["وَلا تَزعُموا بِالوَعرِ أَن قَد مَنَعتُم","وَلَم تَمنَعوا بِالوَعرِ بَطناً وَلا ظَهرا",12,"ر",2,0],["وَلا تَزدَهي الأَجهالُ حِلمي وَلا أَرى","سِؤولاً بِأعقابِ الأَقاويلِ أَنمُلُ",13,"ل",1,0],["وَلا تَزالُ صَلاةُ اللَهِ دائِمَةً","عَلى دَفينكَ لا تُحصى بِتعدادِ",14,"د",1,0],["وَلا تَزَل تَغمُرُ الوَرى بِنَدىً","مُؤتَنَفٍ مِن يَدَيكَ مُقتَبَلِ",15,"ل",1,0],["وَلا تَزدَد مِنَ الدُنيا","فَتَزدادَن بِها نوكا",16,"ك",2,0],["وَلا تَزُر حَضرَتَهُ مُختَلِسا","ولا تُشَمِّتهُ إِذا عَطَسا",17,"س",2,0],["ولا تزدني بالملامِ ضررا","ولا تحاضرْ وتسيءَ المحضرا",18,"ر",2,0],["ولا تَزُرِ البَنِيَّةَ واجْتنِبْها","إذا ازدلَفتْ وُفودُ الزّائرينا",19,"ن",2,0],["ولا تزالُ من الزلزال باقيةٌ","تذكارُها يوقد الأُكبادَ إيقادا",20,"د",2,0],["وَلا تَزالُ بِكَأسِ الشُربِ دائِرَةً","تَبولُ هَمّاً وَتَحسو اللَهوَ وَالتَرَبا",21,"ب",2,0],["ولا تَزَوَّدْتُ قبلَ المَوْتِ نافِلةً","ولَمْ أُصَلِّ سِوَى فَرْضٍ ولَمْ أَصُمِ",22,"م",1,0],["ولا تَزَلْ لكَ أَزمانٌ ممَتِّعَةٌ","بالآلِ والحالِ والعَلياءِ والعُمُرِ",23,"ر",1,0],["وَلا تَزهَدَن في وَصلِ أَهلِ قَرابَةٍ","لِذُخرٍ وَفي وَصلِ الأَباعِدِ فَاِزهَدِ",24,"د",1,0],["ولاَ تَزَالُ لَهُمْ قِدْرٌ مُغَطْغِطَةٌ","كَالرَّأْلِ تَعْجِيلُهَا الأَعْجَازُ والقَمَعُ",25,"ع",1,0],["ولا تزالُ لهم في ذاكَ مأرُبَةٌ","ولا يزالُ لهم في أخذِكُم وطَر",26,"ر",1,0],["ولا تَزرعوا اشواككم في طريقه","تعوقونه .. مَن يزرعِ الشوكَ يَحصِد",27,"د",1,0],["ولا تزعجوا الديدان بالندب أنها","هديٌّ لمن تطويه سود الملاحد",28,"د",1,0],["ولا تزيغ به الأهوا ولا لُسُنٌ","يَرى التباساً به أو داعي المللِ",29,"ل",1,0],["ولا تزل في سعود","موصولة وجدود",30,"د",1,1],["ولا تَزْهدا في الذُّخْرِ عندي وأَجْمِلا","فإِنَّكُما بِيْ اليومَ مبتَلِيانِ",31,"ن",1,0],["ولا تزل تلبس الأعياد في نعم","ورد الخدود بها يزداد توريدا",32,"د",2,0],["ولا تزال الى ابوابك الشعرا","بالحج تسعى فهم كالنمل في زمر",33,"ر",1,0],["ولا تزال تلاقيني بنفحتها","من كلّ وجه رياضٌ أو أزاهِير",34,"ر",1,0],["وَلا تَزالُ ترجى","لِلحادِثِ النَكير",35,"ر",1,0],["ولا تزجيا القود الرواسم واعقلا","على الرسم منها ظالعا وضليعا",36,"ع",2,0],["ولا تَزِيدُكَ إلّا العَلَّ مِن أسَفٍ","فَهَل لِقَلبِكَ مِن صَبرٍ على الأسَفِ",37,"ف",1,0],["وَلا تَزَل في عاجِلِ النَصرِ مَدى ال","دَهرِ وَفي مُستَأخِرٍ مِنَ الأَجَل",38,"ل",1,0],["ولا تَزُر بصاحب","أَو أَحد الأَقارِبِ",39,"ب",1,0],["وَلا تزالُ عوادٍ من عوارفهم","إِلى مَعارفهم فينا لها ديمُ",40,"م",1,0],["ولا تزيدي شقائي","وخلني والتأسي",41,"س",2,0],["وَلا تَزُر مَعهَدَ رَبعٍ قَد خَلا","وَزُر حِمىً عَنهُ سَناها مَاِنتَقَل",42,"ل",1,0],["ولا تزمجَر رَعدٌ أو همى مطرٌ","إلاَّ وزاد لهيب النار واضطرما",43,"م",2,0],["ولا تَزلْ حيث كنتَ غَيْثاً","يَمْطُرُ بالسّعْدِ شائميه",44,"ي",2,0],["ولا تَزلْ تَخطِرُ عن خاطري","في بُرْدِ مَدْحٍ سابِغٍ ذائل",45,"ل",1,0],["ولا تَزَلْ أنتَ بالإقبالِ مُبتهِجاً","ومَن يُعاديكَ بالبَلْبالِ مُرْتَمِضا",46,"ض",2,0],["ولا تُزاحِمْ بنَحرِ العَيشِ صَدرَقَنا","فلنْ يقاوِمَ أطرافَ القَنا عِيسُ",47,"س",1,0],["ولا تزال والإِله راحمٌ","في رحمة الله الَّتي تصافِحُكْ",48,"ك",1,0],["ولا تزال لك الأيام ضاحكةً","والعيش رغداً أو طيب العمر ممدوداً",49,"د",2,0],["ولا تزال له العلياءُ خادمةٌ","ما صادح الورق غنى فوق أفنان",50,"ن",1,0],["ولا تزال لك العلياءُ خادمةً","في كلما تشتهي يا مشرق النسبِ",51,"ب",1,0],["ولا تزَلْ أوصافُ إحسانِه","تُغني عن الناظمِ والناثرِ",52,"ر",1,0],["ولا تَزَلْ أَيُّهَا الدَّهْرُ السعيدُ بِهِ","بِوَجْهِهِ بَهِجاً مِنْ ذِكْرِهِ أَرِجَا",53,"ج",2,0],["ولا تزال بيوت الحمد قاصدة","مني إليه ومن عاداه يقراها",54,"ا",3,0],["ولا تزلْ أنت لي ذُخرا أعدُّك مس","تثنىً إذا قلتَ لي مَن في الخطوب مَنِ",55,"ن",1,0],["ولا تزال لوقتٍ ما فتُحرِمني","وإنما فلتاتُ الجود تُغتنَمُ",56,"م",1,0],["ولا تزلْ يقظى الخطو","ب وهي عنك نُوَّمُ",57,"م",1,0],["ولا تزلْ منكم الأساورُ وال","تيجانُ فوق الأكفِّ والقِممِ",58,"م",1,0],["ولا تزل بالشلِّ تَر","مي في العدا والجَذمِ",59,"م",1,0],["ولا تزل تُلين لي من عُنُقِ ال","أيام فظّاً في مقادي شرسا",60,"س",2,0],["ولا تزل أنت كالقضاء بما","تطلبُ من كلّ بغيةٍ ظافرْ",61,"ر",1,0],["ولا تزل أنتَ مدَى الدهر لنا","كهفا إلى أن لا ترى الدهرَ مَدَى",62,"ا",1,0],["وَلا تزالُ حِمىً في ظلّ دولتهِ","تُطاولُ الدهرَ بَهراماً وكيوانا",63,"ن",2,0],["وَلا تَزالُ كَما أَمست مؤرّخةً","دارُ الجهادِ حِمى الآساد فرسانا",63,"ن",2,0],["ولا تزم شاكماً زمامها","ولا تحول عن هواها حالها",64,"ل",3,0],["ولا تزيدونا أباطيلكمْ","فإنّما أمرضتُمُ مُدْنَفا",65,"ف",2,0],["ولا تزحفوا زَحْفَ الكسير إلى العُلا","فلن تلحقوا وللصّلالِ التَّزَحُّفُ",66,"ف",1,0],["ولا تزاحم على نيل المنى أحداً","واعلم بأن قضاء الله قد لزما",67,"م",2,0],["ولا تزالُ وإن كَانت لها سَعَةٌ","لَهَا إلى الشيءِ لم تَظفَر به نَظَرُ",68,"ر",1,0],["ولا تزالُ لها الأيَّام خادمةً","ومقلةُ السعد ترعَاها مَدَى الحُقُبِ",69,"ب",1,0],["ولا تَزالُ لأَهل العلم مُنتضجعاً","يُسَدى الثَنآءُ لكم في السرّ والعلَنِ",70,"ن",1,0],["ولا تزَل فوقهُ الأزهارُ نابتةً","بوابلٍ من عيون السُحب منهمِل",71,"ل",1,0],["ولا تَزال بنور اللَه مبتهجاً","تجلو لنا شبهات الظلم والظلم",72,"م",1,0],["ولا تزال أكف الوفر هاطلة","منكم على الوفد انعاما وافضالا",73,"ل",2,0],["ولا تُزَوَّجْ غيره","فلفظه مثل الهَبَا",74,"ب",2,0],["ولا تزال مَباديهم مُباركةً","وفي مواطنها صدق وإخباتُ",75,"ت",1,0],["ولا تزال يدُ الأنواء ناسجةً","عليه أثواب حسن وهي ألوان",76,"ن",1,0],["وَلا تزخر لوترِ القوسِ نبلاً","إِذا ما أنتَ عنَّ لك الصوارُ",77,"ر",1,0],["وَلا تَزالُ لَكَ الأَيّامُ موطَأَةٌ","تَمضي قَضاياكَ مِنها في أَمانيكا",78,"ك",2,0],["ولا تزال لحاظ الله راعيةً","لها وتنمو مدى الأعصار أنعمها",79,"م",3,0],["ولا تَزِدِ العِيالَ على كَفَافٍ","يَقُوتُهُمُ فذاكَ مِنَ الغُلُوِّ",80,"و",1,0],["ولا تَزالُ بحُسْنِ الخَلْقِ مالِكَتي","لأَنّهُ مُشْبِهٌ مِنْ مالكي خُلُقَا",81,"ق",2,0],["ولا تزال إذا ما قلْت روَّعهُ","صوتُ الغراب شجته نغمةُ الحَادي",82,"د",2,0],["ولا تزالُ عِداكم تشتكي عِللاً","بين البريَّةِ فيها تَغتدي مَثلاً",83,"ل",2,0],["ولا تزال غوادي السحب واكفةً","تعتاده بين منهلٍّ ومنهمرِ",84,"ر",1,0],["ولا تزرعي في حقول الضَّلال","وأَما بحقل الهدى فاْزرعي",85,"ع",2,0],["ولا تَزُقَّ إذا ما نلتَ ذاك وبِت","مع شوزَرٍ وَافرِ الأردافِ محبوبِ",86,"ب",1,0],["وَلا تَزجُر كِلابَكَ وَاِصطَنِعها","لِتُطعِمَها كِلابَ الأَبعَدينا",87,"ن",2,0],["وَلاتَزالُ الدَهرَ في نِعمَةٍ","يَغدو عَلَيكَ المِسكُ وَالعَنبَرُ",88,"ر",1,0],["ولا تَزدَريني وانظُري ما خليقَتي","إذا ضافَ أمرٌ أو أَناخَ أميرُ",89,"ر",1,0],["ولا تزيدوا زحام القب","ور حولي زحاما",90,"م",2,0],["وَلا تَزُر بَلَداً دونَ الحُلولِ بِهِ","قَطعُ المَ