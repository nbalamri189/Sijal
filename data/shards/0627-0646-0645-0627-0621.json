{"poems":[[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54242","الخفيف"],[362,"عجبت من بزتي إذ أخلقت","https://www.aldiwan.net/poem4161.html","الرمل"],[794,"","https://poetry.dctabudhabi.ae/diwan/poem/101198","الخفيف"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126656","الخفيف"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132322","الخفيف"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131277",""],[4174,"","https://poetry.dctabudhabi.ae/diwan/poem/98058","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139585",""],[4927,"عدوية","https://www.poetsgate.com/ViewPoem.aspx?id=80805",""]],"verses":[["إنّ مَاءَ الدموعِ أطْفَأُ للوَجْ","دِ وأشفَى للصَّبِّ في خَلَواته",0,"ت",2,0],["إنَّ ماءً كان في وَجنَتِها","وَرَدَتهُ السِّنُّ حَتَّى نشَفا",1,"ف",2,0],["ان ماء اسقيتنيه فراتا","قذفته العيون ملحا اجاجا",2,"ج",2,0],["إن ماء السماء بل ردائي","وسرى الليل قد أمات عزائي",3,"ي",1,0],["إنَّ ماءَ العُيُونِ ماءُ حياةٍ","لحياةِ الأشباحِ والأرواح",4,"ح",1,0],["إن ماءً يفيض من صدع صخرٍ","غير ماءٍ من الحشاشة جار",5,"ر",1,0],["إنّ ماءَ الجفونِ ينزحه الهمّ","وَتَبقى الهمومُ والأحزانُ",6,"ن",1,1],["إن ماءُ وردٍ في اناء غدا","بغير ماء الورد لن ينضحا",7,"ح",2,0],["إِنَّ مَاْءَ الشَّآمِ خَيْرُ دَوَاْءٍ","لِعَلِيْلٍ فِي الْبِلاْدِ الْقَصِيَّةْ",8,"ي",2,0]]}