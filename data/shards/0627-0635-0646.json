{"poems":[[31,"عفا من آل فاطمة الثريا","https://www.aldiwan.net/poem6027.html","الوافر"],[51,"إنقطاع الأيام عني سريع","https://www.aldiwan.net/poem62164.html","الخفيف"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30496","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42593","السريع"],[102,"صنعاء .. في طائرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67705&r=&rc=192",""],[190,"اصنع المعروف لا تلوم عليه","https://www.aldiwan.net/poem43333.html","الخفيف"],[369,"أشبه دهري أبناؤه فهم","https://www.aldiwan.net/poem60655.html","المنسرح"],[463,"وجد الجميم فعافه وتبقلا","https://www.aldiwan.net/poem55960.html","الكامل"],[520,"أصنيعة الطهر الإمام","https://www.aldiwan.net/poem12265.html","مجزوء الكامل"],[673,"","https://poetry.dctabudhabi.ae/diwan/poem/137348",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48855","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63895","السريع"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62562","البسيط"],[1385,"","https://poetry.dctabudhabi.ae/diwan/poem/178070","المنسرح"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82576","الكامل"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141206","الرجز"],[2872,"","https://poetry.dctabudhabi.ae/diwan/poem/146502","الدوبيت"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48454","المتقارب"],[3531,"","https://poetry.dctabudhabi.ae/diwan/poem/145742","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86291","الرمل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86535","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94408","الوافر"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81279","الرمل"],[4274,"","https://poetry.dctabudhabi.ae/diwan/poem/35048","الكامل"],[5100,"ولسوف ترضى...","https://www.poetsgate.com/ViewPoem.aspx?id=207708",""],[5216,"مع سيرة الحبيب","https://www.poetsgate.com/ViewPoem.aspx?id=187130",""],[5264,"يا جاهل","https://www.poetsgate.com/ViewPoem.aspx?id=152677",""],[5397,"بكى الدين والدنيا عليك فأفجعا","https://www.poetsgate.com/ViewPoem.aspx?id=157901",""],[5458,"أحببت مستعمري","https://www.poetsgate.com/ViewPoem.aspx?id=113368",""],[5640,"شامية","https://www.poetsgate.com/ViewPoem.aspx?id=206110",""],[5829,"الاسراء والمعراج","https://www.poetsgate.com/ViewPoem.aspx?id=166830",""],[6355,"متى يطهر التراب؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66581&r=&rc=41",""]],"verses":[["أَصَنّا يَحمِيانِ ذِمارَ قَيسٍ","فَلَم يَقِ آنُفَ العَبدَينِ واقي",0,"ق",2,0],["اِصنَعِ الخَيرَ ما اِستَطَعتَ إِلى النا","سِ وَبِاللَهِ وَحدَهُ تَستَطيعُ",1,"ع",1,0],["أَصْنافُ زَهْرٍ طُوِّقَتْ","دُرراً تذوب بكَفِّ ناظِمْ",2,"م",1,0],["اصْنَعْ بِنَا ما شِئْتَ مِنْ قَسْوَةٍ","فَاللهُ عَدْلٌ وَالتَّلاقِي غَدُ",3,"د",1,0],["أصنعا إلى أين ..؟ أمضي أعود","لأمضي … كأني أؤدي وظيفه",4,"ف",2,0],["أصنعا … ولكنّ متى تأنفين","يقولون قد كنت يوما منيفه",4,"ف",2,0],["اصنع المعروف لا تلوم عليه","واجتنب ما يكون فيه الأثامه",5,"ه",1,1],["أصنامُ قومٍ كما سَمعْتَ بها","صُمٌّ منَ الصَّخْرِ نَحتُها زَعَموا",6,"م",3,0],["اِصنع لهم مَلَقا كما يرضونه","وتنحَّ عنهم سامِرِيّاً قُلقُلا",7,"ل",2,0],["أصنيعة الطهر الإمام","أنعم وأصغ إلى كلامي",8,"م",2,1],["إِصنعِ الخيرَ ما استطعتَ فلا خ","يرَ كان قلبهُ كالحديد",9,"د",1,0],["اصنع الخير واطلب العون من أه","ليه واترك سواه ممَّا سمعتا",10,"ت",2,0],["أصنافُ آذريونِهِ بينها","أنواعُ خيريٍّ وأجناس",11,"س",1,0],["أصنام حسن قلوب الناس تعبدهَا","طوعاً وكم عُبدت للكفر أوثان",12,"ن",1,0],["أصنعُ ما شئتُ في حمايته","وهو إلى الغانيات محبوب",13,"ب",1,0],["اِصنَع فَديتُك ما تَشا","ء وَجدتَ إِنساناً يُحبُّك",14,"ك",1,0],["أصنافه كثيرة في العد","ليس لها في حسنها من حد",15,"د",1,0],["اصنع ما شئت أنت أنت المحبوب","ما لي ذنبٌ بل كما قلت ذنوب",16,"ب",1,1],["أصِنْوَ الإمامِ الهُمامِ الذي","إذا عنّ أمْرٌ كَفَى خطْبَهُ",17,"ب",2,0],["إصنَع لهمٍّ أخي همٍ تقلقله","فصدرُه ضيق من رُعبِه حرِج",18,"ج",1,0],["اِصنَع الاِحسانَ مَهما اِطعتُه","اِن تَكُن في رُتبَة وَاشفِ الغِلَل",19,"ل",1,0],["أصنعك هذا يا كمال دلال","وكل دلالٍ في الأمور ضلال",20,"ل",1,1],["أَصنعُ الناس هَذا أم أَشادَت","مبانيَهُ العجابَ يدُ القَديرِ",21,"ر",1,1],["أَصنعي أَيَتُها الشَمس الأَهله","وَاِنفُخي مِن روحك الطاهر فيها",22,"ه",2,1],["أَصنعتموهُ كذا لنيلِ رغائب","منّا بداراً وهو ليس بدارِ",23,"ر",1,0],["اِصنع مِنَ الأشواكِ أجملَ وردةٍ","واجعلْ من القفص ال\"هُنا\" شبّاكا",24,"ك",2,1],["أصنامُ مكَّةَ أُنذِرتْ بزوالِها","فالشِّركُ يوشكُ أن يُولِّيَ زاهِقا",25,"ق",2,0],["إصنع شعب دايماً راضى","شارب خوفك راضع ذل",26,"ل",1,0],["أصنو النبي المصطفى بك قد ذوت","ربوع الندى والدين منك تفرعا",27,"ع",2,0],["أصناف أسلحة ما كنت أعرفها","منها المحرم كالإشعاع والشرر",28,"ر",1,0],["اصْنَعْ تَلاحينَ الحياةِ بِدِقَّة","وأنا على وَتَرِ الرَّبابَة أصْقُلُ",29,"ل",1,0],["4. اصنع بأعيننا السفين فقد دنا","يوم الحساب فلا تمار وانتظر",30,"ر",1,0],["إصنعي ما شئتِ لكن لن تمسي كبريائي","أنا من جيل البطولات ومن شَعْبِ الوفاءِ",31,"ا",2,1]]}