{"poems":[[45,"حاشى الرقيب فخانته ضمائره","https://www.aldiwan.net/poem9571.html","البسيط"],[30,"وجاء قريع الشول قبل إفالها","https://www.aldiwan.net/poem5338.html","البسيط"],[473,"ومسمع تحلو اجتماعاتنا","https://www.aldiwan.net/poem60068.html","السريع"],[3931,"","https://poetry.dctabudhabi.ae/diwan/poem/113819","الطويل"]],"verses":[["نَعجٌ مَحاجِرُهُ دُعجٌ نَواظِرُهُ","حُمرٌ غَفائِرُهُ سودٌ غَدائِرُهُ",0,"ر",2,0],["نُعَجِّلُ لِلضيفانِ في المَحلِ بِالقِرى","قُدوراً بِمَعبوطٍ تُمَدُّ وَتُغرَفُ",1,"ف",1,0],["نَعجَبُ مِن كَثرَةِ إِعجابِهِ","وَقدرُهُ أَهوَنُ مِن بَعرَه",2,"ر",2,0],["نعج إلى المولى بانجا نفوسنا","ونسأله كشف الملم المواثب",3,"ب",1,0]]}