{"poems":[[63,"مررت على ذات الأبارق موهنا","https://www.aldiwan.net/poem45723.html","الطويل"],[63,"رنت إلي وظل النقع ممدود","https://www.aldiwan.net/poem46194.html","البسيط"],[63,"رنا وناظره بالسحر مكتحل","https://www.aldiwan.net/poem46198.html","البسيط"],[77,"تخطت وفود الليل بان به الوخط","https://www.aldiwan.net/poem36395.html","الطويل"],[10,"لما رأيت البدر أظلم كاسفا","https://www.aldiwan.net/poem21130.html","الطويل"],[72,"تناسبت المحاسن يا لبينا","https://www.aldiwan.net/poem20200.html","الوافر"],[85,"رنة الكف فوق خدك اشهى","https://www.aldiwan.net/poem7573.html","الخفيف"],[85,"مرحبا بالربيع في ريعانه","https://www.aldiwan.net/poem62943.html","الخفيف"],[45,"رنو ذاك الغزال أو غيده","https://www.aldiwan.net/poem63505.html","المنسرح"],[61,"أ أقحوانا أرته أم بردا","https://www.aldiwan.net/poem51719.html","المنسرح"],[66,"رقت لنا حين هم الصبح بالسفر","https://www.aldiwan.net/poem38492.html","البسيط"],[66,"أبد سنا وجهك من حجابه","https://www.aldiwan.net/poem41551.html","الرجز"],[81,"وزاهرة المرأى معطرة الشذا","https://www.aldiwan.net/poem61510.html","الطويل"],[52,"ومما شجاني بارق لاح موهنا","https://www.aldiwan.net/poem26880.html","الطويل"],[48,"انس رسم الديار ثم الطلولا","https://www.aldiwan.net/poem64509.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85742","الهزج"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39585","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39599","الرمل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147508","السريع"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/66042","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142035","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54207","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54195","الخفيف"],[106,"هرم يهوي 2","https://www.poetsgate.com/ViewPoem.aspx?id=179486",""],[106,"دمعة على الخفيف","https://www.poetsgate.com/ViewPoem.aspx?id=179355",""],[90,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[96,"الفنان الأول","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66403&r=&rc=79",""]],"verses":[["رَنا نَحوَها طَرْفي وَقَلبي كِلاهُما","فَلَم أَدرِ أَيَّ النَّاظِرَينِ أَذودُ",0,"د",1,0],["رَنَتْ إليّ وظِلُّ النَّقْعِ مَمدودُ","سَوابِقُ الخَيلِ والمَهريُّ القُودُ",1,"د",1,1],["رَنا وناظِرُهُ بالسِّحْرِ مُكتَحِلُ","أغَنُّ يُمْتارُ مِن ألحاظِهِ الغَزَلُ",2,"ل",1,1],["رَنَتْ عَنْ كَحِيلٍ كَالْغَزَالِ إِذَا رَنَا","وَأَوْفَتْ بِهَادٍ كَالظَّلِيمِ إِذَا يَعْطُو",3,"ط",2,0],["رَنيناً وَما يُغني الرَنينُ وَقَد أَتى","بِمَوتِكَ مِن نَحوِ القُرَيَّةِ حامِلُه",4,"ل",2,0],["رنيدة وقتها سمنت بلطف","فما أشهى رنيدا أو سمينا",5,"ن",2,0],["رنة الكف فوق خدك اشهى","عند قومي من رنة الأوتار",6,"ر",1,1],["رَنَّمَ الرَوضُ جَدوَلاً وَنَسيماً","وَتَلا طَيرَ أَيكِهِ غُصنُ بانِه",7,"ن",2,0],["رُنُوُّ ذاكَ الغَزالُ أَو غَيدُه","مولِعُ ذي الوَجدِ بِالَّذي يَجِدُه",8,"د",2,1],["رَنَتْ إليهِ بِطَرْفِ خاذِلَةٍ","ضَعيفَةِ الطَّرْفِ تُضْعِفُ الجَلَدا",9,"د",2,0],["رَنَت نُجومُ الدُجى نَحوي فَما نَظَرَت","مَن يَرشُفُ الراحَ لَيلاً مِن فَمِ القَمَرِ",10,"ر",1,0],["رَنوا إِلى المُلكِ بِعَينِ غادِرٍ","أَطمَعَهُ حِلمُكَ في اِقتِضابِهِ",11,"ب",2,0],["رَنَت مِثلَ مَذعورِ الظِباءِ وَإِنَّما","مَشَت مِثلَما يَمشي القَطا غَيرَ مَذعورِ",12,"ر",1,0],["رَنَوتُ إِلَيهِ مِن بَعيدٍ بِنَظرَةٍ","رَسولٍ لِقَلبٍ لَم يُطِق نَحوَهُ غُمضا",13,"ض",2,0],["رَنَّحَتهُ الكُؤوسُ بِالصِرفِ حَتّى","خَرَّ مِنها عَلى الجَبينِ تَليلا",14,"ل",2,0],["رنت لَيلى إلى وجهي","بألحاظ هي السحرُ",15,"ر",1,1],["رنينُها يُقلق صُمَّ الصدور","وطَرقُها يقرع باب القلوب",16,"ب",1,0],["رنا حيث ترقُبُ أحلامُهُ","خيالكَ في الموعِدِ المنتظَرْ",17,"ر",1,0],["رَنَا والطبيعةُ في حَلِيها","وحواءُ عاريةٌ كالصَّنمْ",18,"م",1,0],["رنَّحته موجةٌ تلعبُ في ضوءِ النجومِ","وتُنادي بشعاعٍ راقصٍ فوقَ الغيومِ",19,"م",1,0],["رنت له الأعداء إن عاينت","صاحبها عن كل خير عدي",20,"د",2,0],["رَنَّمَتْها بخُشُوعٍ مُهْجَ","ةُ الكَوْنِ الحَزينْ",21,"ن",1,0],["رنّ النعي بأذن عفراء فهل","شاهدت غصناً من رطيب البان",22,"ن",1,0],["رنا لها فتمادتْ في تَدلُّلها","العينُ غاضبةٌ والقلبُ جذْلانُ",23,"ن",1,0],["رنَّةُ النصر في السماواتِ والأر","ضِ أعادتْ إلى الوجودِ الوجودا",24,"د",2,0],["رنَتْ نحَوك الأحداق؛ والخطبُ محدقٌ","ولكنها ألفَتْ مكانك خاليا",25,"ي",2,0],["رناتُ صوتك تسري من مطالعه","وحسنُ سَمْتِك يبدو في قوافيه",26,"ي",2,0],["رَنتِ العيونُ إليكَ تُكبِرُ موقفاً","من \" شيخِ \" لُبنانَ النبيل نبيلا",27,"ل",2,0],["رنا ، والطّبيعة في حليها","وحواء عارية كاصّنم",28,"م",1,0]]}