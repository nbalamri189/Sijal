ewPoem.aspx?id=124438",""],[5111,"غَفْوةُ الْحَلاجِ","https://www.poetsgate.com/ViewPoem.aspx?id=212222",""],[5111,"مَدَّاحُ","https://www.poetsgate.com/ViewPoem.aspx?id=212253",""],[5121,"لُغَةُ الرَّبِيِع","https://www.poetsgate.com/ViewPoem.aspx?id=68726",""],[5219,"وذات خال ...","https://www.poetsgate.com/ViewPoem.aspx?id=198233",""],[5232,"لغزُ العيون","https://www.poetsgate.com/ViewPoem.aspx?id=213023",""],[5232,"يا عودُ","https://www.poetsgate.com/ViewPoem.aspx?id=213107",""],[5277,"جنّاتُ عاطفتي","https://www.poetsgate.com/ViewPoem.aspx?id=192112",""],[5320,"غزال","https://www.poetsgate.com/ViewPoem.aspx?id=41641",""],[5358,"أتى وحيدُكِ","https://www.poetsgate.com/ViewPoem.aspx?id=183426",""],[5376,"علا القدسَ في أرجائها الحقُّ والعدلُ","https://www.poetsgate.com/ViewPoem.aspx?id=188562",""],[5402,"لغة العشق","https://www.poetsgate.com/ViewPoem.aspx?id=215513",""],[5409,"مروا به وسط الدساكر","https://www.poetsgate.com/ViewPoem.aspx?id=155277",""],[5431,"نزفٌ مفترس...","https://www.poetsgate.com/ViewPoem.aspx?id=208994",""],[5542,"قراءة في وجة امرأة شو هاء..!","https://www.poetsgate.com/ViewPoem.aspx?id=1655",""],[5582,"أَتَجْحَدُ داءَ الحُبِّ عِنْدَ المُشاهِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=186906",""],[5626,"يا أيها العشّاق توبوا","https://www.poetsgate.com/ViewPoem.aspx?id=189492",""],[243,"تحية القرية","https://www.poetsgate.com/ViewPoem.aspx?id=50485",""],[5642,"جهرة الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=125040",""],[5690,"أنى أعداد أوصافاً عرفت بها","https://www.poetsgate.com/ViewPoem.aspx?id=172179",""],[5691,"تدور بنا الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=206080",""],[5691,"وكر الجواسيس... ويوم النكبة","https://www.poetsgate.com/ViewPoem.aspx?id=206158",""],[5721,"الرقص على حبال الموت","https://www.poetsgate.com/ViewPoem.aspx?id=214687",""],[5781,"جمرةٌ في زحمة الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=204823",""],[5818,"لعلّ الله أنْ يشفي سقامهْ","https://www.poetsgate.com/ViewPoem.aspx?id=193231",""],[5937,"اللّا وَرَقِيَّة","https://www.poetsgate.com/ViewPoem.aspx?id=211908",""],[5956,"أحلى الكلام (نعم)‏","https://www.poetsgate.com/ViewPoem.aspx?id=182031",""],[5956,"أشواقها إليَّ","https://www.poetsgate.com/ViewPoem.aspx?id=182648",""],[5956,"أطلال وآمال","https://www.poetsgate.com/ViewPoem.aspx?id=183699",""],[5956,"فقدان وأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=194843",""],[6032,"رند الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=181512",""],[6124,"رنة الخلخال","https://www.poetsgate.com/ViewPoem.aspx?id=159867",""],[4432,"ادكارا بعد ما ولى الشباب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=564221",""],[6167,"حديث النجوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85550&r=&rc=33",""],[6237,"أحمد أمين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77883&r=&rc=25",""],[463,"أبا لغور تشتاقُ تلك النجودا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60018&r=&rc=74",""],[6302,"تَعْليلْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86231&r=&rc=29",""],[6355,"هلال رمضان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66597&r=&rc=57",""],[572,"رَنَتْ فأَصَابَتْ سِرَّ قلبي بلحظة ٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9216&r=&rc=73",""]],"verses":[["رَنا نَحوَها طَرْفي وَقَلبي كِلاهُما","فَلَم أَدرِ أَيَّ النَّاظِرَينِ أَذودُ",0,"د",1,0],["رَنَتْ إليّ وظِلُّ النَّقْعِ مَمدودُ","سَوابِقُ الخَيلِ والمَهريُّ القُودُ",1,"د",1,1],["رَنا وناظِرُهُ بالسِّحْرِ مُكتَحِلُ","أغَنُّ يُمْتارُ مِن ألحاظِهِ الغَزَلُ",2,"ل",1,1],["رَنَتْ عَنْ كَحِيلٍ كَالْغَزَالِ إِذَا رَنَا","وَأَوْفَتْ بِهَادٍ كَالظَّلِيمِ إِذَا يَعْطُو",3,"ط",2,0],["رَنيناً وَما يُغني الرَنينُ وَقَد أَتى","بِمَوتِكَ مِن نَحوِ القُرَيَّةِ حامِلُه",4,"ل",2,0],["رنيدة وقتها سمنت بلطف","فما أشهى رنيدا أو سمينا",5,"ن",2,0],["رنة الكف فوق خدك اشهى","عند قومي من رنة الأوتار",6,"ر",1,1],["رَنَّمَ الرَوضُ جَدوَلاً وَنَسيماً","وَتَلا طَيرَ أَيكِهِ غُصنُ بانِه",7,"ن",2,0],["رُنُوُّ ذاكَ الغَزالُ أَو غَيدُه","مولِعُ ذي الوَجدِ بِالَّذي يَجِدُه",8,"د",2,1],["رَنَتْ إليهِ بِطَرْفِ خاذِلَةٍ","ضَعيفَةِ الطَّرْفِ تُضْعِفُ الجَلَدا",9,"د",2,0],["رَنَت نُجومُ الدُجى نَحوي فَما نَظَرَت","مَن يَرشُفُ الراحَ لَيلاً مِن فَمِ القَمَرِ",10,"ر",1,0],["رَنوا إِلى المُلكِ بِعَينِ غادِرٍ","أَطمَعَهُ حِلمُكَ في اِقتِضابِهِ",11,"ب",2,0],["رَنَت مِثلَ مَذعورِ الظِباءِ وَإِنَّما","مَشَت مِثلَما يَمشي القَطا غَيرَ مَذعورِ",12,"ر",1,0],["رَنَوتُ إِلَيهِ مِن بَعيدٍ بِنَظرَةٍ","رَسولٍ لِقَلبٍ لَم يُطِق نَحوَهُ غُمضا",13,"ض",2,0],["رَنَّحَتهُ الكُؤوسُ بِالصِرفِ حَتّى","خَرَّ مِنها عَلى الجَبينِ تَليلا",14,"ل",2,0],["رنت لَيلى إلى وجهي","بألحاظ هي السحرُ",15,"ر",1,1],["رنينُها يُقلق صُمَّ الصدور","وطَرقُها يقرع باب القلوب",16,"ب",1,0],["رنا حيث ترقُبُ أحلامُهُ","خيالكَ في الموعِدِ المنتظَرْ",17,"ر",1,0],["رَنَا والطبيعةُ في حَلِيها","وحواءُ عاريةٌ كالصَّنمْ",18,"م",1,0],["رنَّحته موجةٌ تلعبُ في ضوءِ النجومِ","وتُنادي بشعاعٍ راقصٍ فوقَ الغيومِ",19,"م",1,0],["رنت له الأعداء إن عاينت","صاحبها عن كل خير عدي",20,"د",2,0],["رَنَّمَتْها بخُشُوعٍ مُهْجَ","ةُ الكَوْنِ الحَزينْ",21,"ن",1,0],["رنّ النعي بأذن عفراء فهل","شاهدت غصناً من رطيب البان",22,"ن",1,0],["رنا لها فتمادتْ في تَدلُّلها","العينُ غاضبةٌ والقلبُ جذْلانُ",23,"ن",1,0],["رنَّةُ النصر في السماواتِ والأر","ضِ أعادتْ إلى الوجودِ الوجودا",24,"د",2,0],["رنَتْ نحَوك الأحداق؛ والخطبُ محدقٌ","ولكنها ألفَتْ مكانك خاليا",25,"ي",2,0],["رناتُ صوتك تسري من مطالعه","وحسنُ سَمْتِك يبدو في قوافيه",26,"ي",2,0],["رنت والدجى في خاطر الصمت هاديء","يطاوعه حلم وحلم يناوىء",27,"ا",2,1],["رنت والسنى في مقلة اللّيل متعب","يئنّ وفي دور المدينة طافيء",27,"ي",2,0],["رَنتِ العيونُ إليكَ تُكبِرُ موقفاً","من \" شيخِ \" لُبنانَ النبيل نبيلا",28,"ل",2,0],["رنّح الشعر والكريم طروب","ذكر سعد لا يبعد الله سعدا",29,"د",2,0],["رنت العيون إلى جلالك خشّعا","والبدر يلثم في العيون ويرمق",30,"ق",1,0],["رنا ، والطّبيعة في حليها","وحواء عارية كاصّنم",31,"م",1,0],["رنا ظبي فأقصد مَن رماه","بسهمى مقلتيه وماس بانا",32,"ن",2,0],["رنينها يشحذ منه العزمهْ","وصرفها يرصف عنهُ الأزمهْ",33,"ه",1,0],["رنينُ صوتِكِ \"دوْزانٌ\" لأغْنيتي","ينْثالُ في عَصَبي يَسْتَحْضِرُ الرَّوَقا",34,"ق",2,0],["رنت لي باللحاظ فقلت هذي","سيوف جردت ام مقلتاها",35,"ا",3,0],["رنّقت ورده الليالي فأمسى","يرقب الصفو من خلال الأماني",36,"ن",2,0],["رن رَن أَلو مركزَ القَل","ب قَلب ذاكَ الوَجيعِ",37,"ع",1,1],["رن رَن أَلو لي حَديثٌ","مَع الفُؤادِ طَويلُ",37,"ل",1,0],["رن رَن أَلو ذاكَ صوتٌ","سَمِعتُه مِن قَديمِ",37,"م",1,0],["رَنوتِ بمقلةٍ كحلاءَ فيها","حنانٌ منهُ تعزيةٌ لباك",38,"ك",1,0],["رَنَت بجفونٍ مثل أكمامِ زَهرِها","عَليها جُفُوني في الجوى تتقرَّح",39,"ح",1,0],["رَنونَ فَلَو أَلفَينَ هاروتَ نافِثاً","وَماروتَ جاءاها لِيقَتَبِسا السِحرا",40,"ر",2,0],["رنَّحنَ من أَعطافِهنَّ ذوابلاً","وَنَضَونَ من أَجفانهنَّ قواضِبا",41,"ب",2,0],["رنا إليه دهرُه","بوجهِه المقطَّب",42,"ب",1,0],["رَنَوناةٌ تُساوِرُ حينَ تُجلى","شُؤونَ الرَأسِ شَبّاً لا قَبالا",43,"ل",2,0],["رَنَت بِفواترِ الأجفانِ سَكرى","فَخِلنا نَجلها بالغضّ خزرا",44,"ر",2,1],["رنّ هذا النداءُ في أُذُنيّا","وسرى كاللهيب في أصغريّا",45,"ي",2,0],["رنّ في مسمعي نداءُ الحبيب","من بعيد فخلته من قريب",46,"ب",1,1],["رنقت صفويَ الدنايا فجلى","صدأ الخوف من لقاء المجيد",47,"د",1,0],["رَنَا فَرْثاً بِأَيرٍ قَبلَ عَيْنٍ","وَشَيْطانُ الحَمِيرِ نَقيبُ مَارِدْ",48,"د",1,0],["رَنا خشفاً وَهَزَّ قَناة قَدٍّ","وَماسَ وَلَيسَ كَالخبر العيانُ",49,"ن",1,0],["رَنَت وَلَها وُجوهٌ ناضِراتٌ","لآلاء المهيمن ناظِرات",50,"ت",1,0],["رَنا فاِستخدم الأَلباب سحرا","وَأطلع فَوق غُصن البان بَدرا",51,"ر",2,1],["رَنَت فَدَعانا مُرسل اللَحظ لِلهَوى","فَآمنت خَوفاً مِن هَلاكيَ بِالفتره",52,"ر",2,0],["رَنا لي فَصادَتني حَبائل دلّه","فَواعجَباً هَل يَقنص اللَيث جؤذرُ",53,"ر",1,0],["رَنّقت مَشْربي وقد كان عَيْنٌ الشْ","شَمْسِ والماء دونه في الصّفاء",54,"ا",2,0],["رَنّقن من وِرْدِي وأَمْ","حَلَ جَورُها عمْداً مَرَادي",55,"د",2,0],["رنا فأَصابَ بالأَلحاظ منَّا","فؤاداً بالصَّبابة مستطارا",56,"ر",2,0],["رنّحت بالدلال خَطِّيَّ قدٍّ","فأقامت على الغصون القيامه",57,"م",2,0],["رنين الحجول بخلخالها","كمثل العزول ينادي علن",58,"ن",1,0],["رنتْ فرمتْ بسهمٍ من فُتورٍ","يُليحُ له شواكلَهُ الرميُّ",59,"ي",1,0],["رنت فرمت قل