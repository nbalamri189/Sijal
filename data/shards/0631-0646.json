{"poems":[[63,"مررت على ذات الأبارق موهنا","https://www.aldiwan.net/poem45723.html","الطويل"],[63,"رنت إلي وظل النقع ممدود","https://www.aldiwan.net/poem46194.html","البسيط"],[63,"رنا وناظره بالسحر مكتحل","https://www.aldiwan.net/poem46198.html","البسيط"],[77,"تخطت وفود الليل بان به الوخط","https://www.aldiwan.net/poem36395.html","الطويل"],[10,"لما رأيت البدر أظلم كاسفا","https://www.aldiwan.net/poem21130.html","الطويل"],[72,"تناسبت المحاسن يا لبينا","https://www.aldiwan.net/poem20200.html","الوافر"],[85,"رنة الكف فوق خدك اشهى","https://www.aldiwan.net/poem7573.html","الخفيف"],[85,"مرحبا بالربيع في ريعانه","https://www.aldiwan.net/poem62943.html","الخفيف"],[45,"رنو ذاك الغزال أو غيده","https://www.aldiwan.net/poem63505.html","المنسرح"],[61,"أ أقحوانا أرته أم بردا","https://www.aldiwan.net/poem51719.html","المنسرح"],[66,"رقت لنا حين هم الصبح بالسفر","https://www.aldiwan.net/poem38492.html","البسيط"],[66,"أبد سنا وجهك من حجابه","https://www.aldiwan.net/poem41551.html","الرجز"],[81,"وزاهرة المرأى معطرة الشذا","https://www.aldiwan.net/poem61510.html","الطويل"],[52,"ومما شجاني بارق لاح موهنا","https://www.aldiwan.net/poem26880.html","الطويل"],[48,"انس رسم الديار ثم الطلولا","https://www.aldiwan.net/poem64509.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85742","الهزج"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39585","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39599","الرمل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147508","السريع"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/66042","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142035","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54207","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54195","الخفيف"],[106,"هرم يهوي 2","https://www.poetsgate.com/ViewPoem.aspx?id=179486",""],[106,"دمعة على الخفيف","https://www.poetsgate.com/ViewPoem.aspx?id=179355",""],[90,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[96,"الفنان الأول","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66403&r=&rc=79",""],[130,"أإن ظعن الخليط ضحى فبانا","https://www.aldiwan.net/poem54656.html","الوافر"],[133,"في حلقة الندى قام مصقع","https://www.aldiwan.net/poem49103.html","الرجز"],[176,"كعبة الحسن","https://www.aldiwan.net/poem50713.html","البسيط"],[208,"أما وعذاب قلبي في هواها","https://www.aldiwan.net/poem13342.html","الوافر"],[209,"إيه يا فتنة الوجود سلام","https://www.aldiwan.net/poem46338.html","الخفيف"],[221,"رن رن ألو مركز القلب","https://www.aldiwan.net/poem41902.html","المجتث"],[268,"دهاني يا غزالة ما دهاك","https://www.aldiwan.net/poem35233.html","الوافر"],[268,"تحاول إنكارا ودمعك موضح","https://www.aldiwan.net/poem35613.html","الطويل"],[280,"لحاظ المهى لا بابل تنفث السحرا","https://www.aldiwan.net/poem32789.html","الطويل"],[295,"أرأيت بين المأزمين كواعبا","https://www.aldiwan.net/poem33329.html","الكامل"],[296,"تحية طيبة","https://www.aldiwan.net/poem36305.html","عموديه"],[298,"أغدوا واعد الحي الزبالا","https://www.aldiwan.net/poem45471.html","الوافر"],[303,"رنت بفواتر الأجفان سكرى","https://www.aldiwan.net/poem56517.html","الوافر"],[326,"هدم الليل ما بناه النهار","https://www.aldiwan.net/poem55005.html","الخفيف"],[326,"رن في مسمعي نداء الحبيب","https://www.aldiwan.net/poem55028.html","الخفيف"],[326,"أبنجواي من رقيق النشيد","https://www.aldiwan.net/poem55060.html","الخفيف"],[346,"برغمي إن خلت منه المذاود","https://www.aldiwan.net/poem20065.html","الوافر"],[351,"أدر راح الصفا ولك الأمان","https://www.aldiwan.net/poem39769.html","الوافر"],[351,"إذا هبت صبا الأسحار فاذكر","https://www.aldiwan.net/poem40007.html","الوافر"],[351,"رنا فاستخدم الألباب سحرا","https://www.aldiwan.net/poem40227.html","الوافر"],[351,"بروحي جمالا صورته يد القدره","https://www.aldiwan.net/poem40340.html","الطويل"],[351,"علام فدتك النفس تجفو وتهجر","https://www.aldiwan.net/poem40348.html","الطويل"],[362,"وعدت باستراقة للقاء","https://www.aldiwan.net/poem61018.html","الخفيف"],[406,"يا دار إن بخلت على","https://www.aldiwan.net/poem32500.html","مجزوء الكامل"],[413,"سقانيها معتقة عقارا","https://www.aldiwan.net/poem54008.html","الوافر"],[426,"أقبلت تنثني بأعدل قامه","https://www.aldiwan.net/poem40713.html","الخفيف"],[426,"حذار حذار أخي الشجن","https://www.aldiwan.net/poem41411.html","المتقارب"],[429,"تولى سقي دارهم الولي","https://www.aldiwan.net/poem12770.html","الوافر"],[434,"سرى الطيف وهنا والرقاد مرنق","https://www.aldiwan.net/poem2618.html","الطويل"],[447,"العبور","https://www.aldiwan.net/poem1007.html",""],[456,"أبلاغور تشتاق تلك النجودا","https://www.aldiwan.net/poem56240.html","المتقارب"],[466,"ترى بركات بورك فيه بدري","https://www.aldiwan.net/poem59975.html","الوافر"],[475,"هي الدار قد أقوت ورث جديدها","https://www.aldiwan.net/poem15191.html","الطويل"],[498,"كل حال لا بد آنا يحول","https://www.aldiwan.net/poem37568.html","الخفيف"],[498,"بين الكتائب والكثبان جلجلة","https://www.aldiwan.net/poem37780.html","البسيط"],[498,"جاء البشير ليعقوبي بيوسفه","https://www.aldiwan.net/poem38078.html","البسيط"],[512,"ما حركت سكنات الأعين النجل","https://www.aldiwan.net/poem20788.html","البسيط"],[512,"رنا فسل على العشاق أحوره","https://www.aldiwan.net/poem20792.html","البسيط"],[556,"ما اصطكاك الأجرام عند السماع","https://www.aldiwan.net/poem34384.html","الخفيف"],[556,"تبارك الله ما في الدار ديار","https://www.aldiwan.net/poem34533.html","البسيط"],[557,"إذا بريق الحمى استنارا","https://www.aldiwan.net/poem69359.html","مخلع البسيط"],[565,"رنت فأصابت سر قلبي بلحظة","https://www.aldiwan.net/poem69756.html","الطويل"],[573,"رأيت طرفك يوم البين حين همى","https://www.aldiwan.net/poem3020.html","البسيط"],[573,"أسير عنك بقلب عن هواك سلا","https://www.aldiwan.net/poem3033.html","البسيط"]],"verses":[["رَنا نَحوَها طَرْفي وَقَلبي كِلاهُما","فَلَم أَدرِ أَيَّ النَّاظِرَينِ أَذودُ",0,"د",1,0],["رَنَتْ إليّ وظِلُّ النَّقْعِ مَمدودُ","سَوابِقُ الخَيلِ والمَهريُّ القُودُ",1,"د",1,1],["رَنا وناظِرُهُ بالسِّحْرِ مُكتَحِلُ","أغَنُّ يُمْتارُ مِن ألحاظِهِ الغَزَلُ",2,"ل",1,1],["رَنَتْ عَنْ كَحِيلٍ كَالْغَزَالِ إِذَا رَنَا","وَأَوْفَتْ بِهَادٍ كَالظَّلِيمِ إِذَا يَعْطُو",3,"ط",2,0],["رَنيناً وَما يُغني الرَنينُ وَقَد أَتى","بِمَوتِكَ مِن نَحوِ القُرَيَّةِ حامِلُه",4,"ل",2,0],["رنيدة وقتها سمنت بلطف","فما أشهى رنيدا أو سمينا",5,"ن",2,0],["رنة الكف فوق خدك اشهى","عند قومي من رنة الأوتار",6,"ر",1,1],["رَنَّمَ الرَوضُ جَدوَلاً وَنَسيماً","وَتَلا طَيرَ أَيكِهِ غُصنُ بانِه",7,"ن",2,0],["رُنُوُّ ذاكَ الغَزالُ أَو غَيدُه","مولِعُ ذي الوَجدِ بِالَّذي يَجِدُه",8,"د",2,1],["رَنَتْ إليهِ بِطَرْفِ خاذِلَةٍ","ضَعيفَةِ الطَّرْفِ تُضْعِفُ الجَلَدا",9,"د",2,0],["رَنَت نُجومُ الدُجى نَحوي فَما نَظَرَت","مَن يَرشُفُ الراحَ لَيلاً مِن فَمِ القَمَرِ",10,"ر",1,0],["رَنوا إِلى المُلكِ بِعَينِ غادِرٍ","أَطمَعَهُ حِلمُكَ في اِقتِضابِهِ",11,"ب",2,0],["رَنَت مِثلَ مَذعورِ الظِباءِ وَإِنَّما","مَشَت مِثلَما يَمشي القَطا غَيرَ مَذعورِ",12,"ر",1,0],["رَنَوتُ إِلَيهِ مِن بَعيدٍ بِنَظرَةٍ","رَسولٍ لِقَلبٍ لَم يُطِق نَحوَهُ غُمضا",13,"ض",2,0],["رَنَّحَتهُ الكُؤوسُ بِالصِرفِ حَتّى","خَرَّ مِنها عَلى الجَبينِ تَليلا",14,"ل",2,0],["رنت لَيلى إلى وجهي","بألحاظ هي السحرُ",15,"ر",1,1],["رنينُها يُقلق صُمَّ الصدور","وطَرقُها يقرع باب القلوب",16,"ب",1,0],["رنا حيث ترقُبُ أحلامُهُ","خيالكَ في الموعِدِ المنتظَرْ",17,"ر",1,0],["رَنَا والطبيعةُ في حَلِيها","وحواءُ عاريةٌ كالصَّنمْ",18,"م",1,0],["رنَّحته موجةٌ تلعبُ في ضوءِ النجومِ","وتُنادي بشعاعٍ راقصٍ فوقَ الغيومِ",19,"م",1,0],["رنت له الأعداء إن عاينت","صاحبها عن كل خير عدي",20,"د",2,0],["رَنَّمَتْها بخُشُوعٍ مُهْجَ","ةُ الكَوْنِ الحَزينْ",21,"ن",1,0],["رنّ النعي بأذن عفراء فهل","شاهدت غصناً من رطيب البان",22,"ن",1,0],["رنا لها فتمادتْ في تَدلُّلها","العينُ غاضبةٌ والقلبُ جذْلانُ",23,"ن",1,0],["رنَّةُ النصر في السماواتِ والأر","ضِ أعادتْ إلى الوجودِ الوجودا",24,"د",2,0],["رنَتْ نحَوك الأحداق؛ والخطبُ محدقٌ","ولكنها ألفَتْ مكانك خاليا",25,"ي",2,0],["رناتُ صوتك تسري من مطالعه","وحسنُ سَمْتِك يبدو في قوافيه",26,"ي",2,0],["رَنتِ العيونُ إليكَ تُكبِرُ موقفاً","من \" شيخِ \" لُبنانَ النبيل نبيلا",27,"ل",2,0],["رنا ، والطّبيعة في حليها","وحواء عارية كاصّنم",28,"م",1,0],["رنا ظبي فأقصد مَن رماه","بسهمى مقلتيه وماس بانا",29,"ن",2,0],["رنينها يشحذ منه العزمهْ","وصرفها يرصف عنهُ الأزمهْ",30,"ه",1,0],["رنينُ صوتِكِ \"دوْزانٌ\" لأغْنيتي","ينْثالُ في عَصَبي يَسْتَحْضِرُ الرَّوَقا",31,"ق",2,0],["رنت لي باللحاظ فقلت هذي","سيوف جردت ام مقلتاها",32,"ا",3,0],["رنّقت ورده الليالي فأمسى","يرقب الصفو من خلال الأماني",33,"ي",1,0],["رن رَن أَلو مركزَ القَل","ب قَلب ذاكَ الوَجيعِ",34,"ع",1,1],["رن رَن أَلو لي حَديثٌ","مَع الفُؤادِ طَويلُ",34,"ل",1,0],["رن رَن أَلو ذاكَ صوتٌ","سَمِعتُه مِن قَديمِ",34,"م",1,0],["رَنوتِ بمقلةٍ كحلاءَ فيها","حنانٌ منهُ تعزيةٌ لباك",35,"ك",1,0],["رَنَت بجفونٍ مثل أكمامِ زَهرِها","عَليها جُفُوني في الجوى تتقرَّح",36,"ح",1,0],["رَنونَ فَلَو أَلفَينَ هاروتَ نافِثاً","وَماروتَ جاءاها لِيقَتَبِسا السِحرا",37,"ر",2,0],["رنَّحنَ من أَعطافِهنَّ ذوابلاً","وَنَضَونَ من أَجفانهنَّ قواضِبا",38,"ب",2,0],["رنا إليه دهرُه","بوجهِه المقطَّب",39,"ب",1,0],["رَنَوناةٌ تُساوِرُ حينَ تُجلى","شُؤونَ الرَأسِ شَبّاً لا قَبالا",40,"ل",2,0],["رَنَت بِفواترِ الأجفانِ سَكرى","فَخِلنا نَجلها بالغضّ خزرا",41,"ر",2,1],["رنّ هذا النداءُ في أُذُنيّا","وسرى كاللهيب في أصغريّا",42,"ي",2,0],["رنّ في مسمعي نداءُ الحبيب","من بعيد فخلته من قريب",43,"ب",1,1],["رنقت صفويَ الدنايا فجلى","صدأ الخوف من لقاء المجيد",44,"د",1,0],["رَنَا فَرْثاً بِأَيرٍ قَبلَ عَيْنٍ","وَشَيْطانُ الحَمِيرِ نَقيبُ مَارِدْ",45,"د",1,0],["رَنا خشفاً وَهَزَّ قَناة قَدٍّ","وَماسَ وَلَيسَ كَالخبر العيانُ",46,"ن",1,0],["رَنَت وَلَها وُجوهٌ ناضِراتٌ","لآلاء المهيمن ناظِرات",47,"ت",1,0],["رَنا فاِستخدم الأَلباب سحرا","وَأطلع فَوق غُصن البان بَدرا",48,"ر",2,1],["رَنَت فَدَعانا مُرسل اللَحظ لِلهَوى","فَآمنت خَوفاً مِن هَلاكيَ بِالفتره",49,"ر",2,0],["رَنا لي فَصادَتني حَبائل دلّه","فَواعجَباً هَل يَقنص اللَيث جؤذرُ",50,"ر",1,0],["رَنّقت مَشْربي وقد كان عَيْنٌ الشْ","شَمْسِ والماء دونه في الصّفاء",51,"ا",2,0],["رَنّقن من وِرْدِي وأَمْ","حَلَ جَورُها عمْداً مَرَادي",52,"ي",1,0],["رنا فأَصابَ بالأَلحاظ منَّا","فؤاداً بالصَّبابة مستطارا",53,"ر",2,0],["رنّحت بالدلال خَطِّيَّ قدٍّ","فأقامت على الغصون القيامه",54,"م",2,0],["رنين الحجول بخلخالها","كمثل العزول ينادي علن",55,"ن",1,0],["رنتْ فرمتْ بسهمٍ من فُتورٍ","يُليحُ له شواكلَهُ الرميُّ",56,"ي",1,0],["رنت فرمت قلبي بسهم لوقعه","حشاي على مر الليالي تمزّق",57,"ق",1,0],["رنا نحوها الطرف المدله خلسة","ويا لعذاب الطرف إذ يتخلس",58,"س",1,0],["رنَتْ عينُه ورأت مَقتَلي","فوَّقها ورماني سديدا",59,"د",2,0],["رَنا فَرَمى فُؤادي مِنهُ طَرفٌ","لَهُ سَهمانِ مِن غُنجٍ وَسِحرِ",60,"ر",1,0],["رنتْ فرمتْ نبلاً حشاىَ رديةً","له دونَ أحشائي هواها يؤودُها",61,"د",3,0],["رنَّ في فكرة القطيع اتحادٌ","من كثوفاتِ وهمه وحلول",62,"ل",1,0],["رَنَّاتُ أَسرارِ أَحوالٍ يرَنِّحُها","من طِينِها بأَساليبِ الهوَى نَغَمُ",63,"م",1,0],["رنَّتْ له في طريقِ السَّمعِ داعِيَةٌ","فقُمْتُ مُبْتهِجاً في طَوْرِ مجْذوبِ",64,"ب",1,0],["رَنَتْ إلينا عُيونُ العِينِ من مُضَرٍ","فاِستهدَفَتنا رُماةُ النَّبْلِ من ثُعَلِ",65,"ل",1,0],["رَنا فسلَّ على العُشّاقِ أحوَرهُ","سيفاً عليهمْ ذِمامُ البيضِ يخفِرُهُ",66,"ر",2,1],["رنة بعد رنة بعد أخرى","صور تنجلي على الأسماع",67,"ع",1,0],["رنات أوتار أسماء لذاتك لا","كما يقولون رنات وأوتار",68,"ر",1,0],["رنَّحَهُ سُكرهُ فَنادى","ياصَاح لا تترك الكبَارَا",69,"ر",2,0],["رَنَتْ فَأَصَابَتْ سِرَّ قلبي بِلَحْظَةٍ","لَهَا في الحَشَى لَذْعٌ وَلَيْسَ لَهَا جُرْحُ",70,"ح",1,1],["رنا إِليَّ فقال العاذلون رَنَا","وما أَقولُ رَنا لكن أَقول رَمى",71,"م",2,0],["رنَا إِليّ بعينيه فقلتُ طَلاَ","حتى إِذا كَسَر الأَجفانَ قلتُ طِلاَ",72,"ل",2,0]]}