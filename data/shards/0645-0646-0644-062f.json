{"poems":[[68,"لو أفادتنا العزائم حالا","https://www.aldiwan.net/poem40128.html","المديد"],[33,"ذكرتني الديار شوقا قديما","https://www.aldiwan.net/poem41805.html","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54270","المديد"],[119,"من لدمع طغى وقلب مهيم","https://www.aldiwan.net/poem40590.html","عموديه"],[199,"منع النوم طارقات الهموم","https://www.aldiwan.net/poem54415.html","الخفيف"],[237,"من لدم القتيل","https://www.aldiwan.net/poem14800.html","منهوك المنسرح"],[556,"من لداع لا يجاب","https://www.aldiwan.net/poem48097.html","مجزوء الرمل"],[572,"أي حراك غال منك السكون","https://www.aldiwan.net/poem69478.html","السريع"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53863","الخفيف"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126831","الخفيف"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95558","الرمل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125377","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58533","الرجز"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74337","الرمل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114051","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111521","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111510","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111424","الخفيف"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119685","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90965","الرمل"],[4649,"","https://poetry.dctabudhabi.ae/diwan/poem/101933","الرمل"],[4119,"أنتم كالشمس لولا خدرها","https://www.poetsgate.com/ViewPoem.aspx?id=16224",""],[5145,"ما على الجيرة لو صبروا","https://www.poetsgate.com/ViewPoem.aspx?id=108198",""],[5956,"جواب رفاه لخالد","https://www.poetsgate.com/ViewPoem.aspx?id=182389",""]],"verses":[["مَن لَدَستِ الحُكمِ بَعدَكَ قاضٍ","لَم يَمِل يَوماً إِذا الدَهرُ مالا",0,"ل",2,0],["مِن لَدُن فَحمَةِ العِشاءِ إِلى أَن","لاحَ وَردٌ يَسوقُ جَوناً بَهيما",1,"م",2,0],["مِنْ لَدُنْهُ الْوُدُّ أَخْلَصُهُ","والْوَفا والطُّهْرُ مِنْ لَدُنِي",2,"ن",2,0],["من لدمع طغى وقلب مهيم","مغرم وافر الانين متيم",3,"م",1,1],["مِن لَدُن أَن أَجَنَّني اللَيلُ حَتّى","فَضَحَ الصُبحُ واضِحاتُ النُجومِ",4,"م",1,0],["مَن لِدَمِ القَتيلِ","مِن طَرفِكَ الكَحيلِ",5,"ل",1,1],["مَنْ لِداعٍ لا يجابُ","وشفاءٍ لا يُصابُ",6,"ب",1,1],["مَنْ لِدَوَاةٍ كُنْتَ تُعْنَى بِهَا","عِنَايَةً تَعْجِزُ عَنْهَا القُيُونْ",7,"ن",1,0],["مَنْ لدانٍ هواه ناء هواه","قد شكته شكواه",8,"ا",2,1],["مَن لدُنيا الفخارِ شرعاً قويماً","خصّه اللّه للبلادِ كفيلا",9,"ل",2,0],["من لدي المحفل نور وهدى","من لإِخوان الصفاء الادبَا",10,"ب",2,0],["من لدهري بان تراع وهلا","يتقي ما يروع من تلقاها",11,"ا",3,0],["من لدرِّ البحارِ يخرُجُ منها","يترامى نثراً على أقدامكِ",12,"ك",1,0],["من لَدُنِ ابنِ العاص أعني عَمرا","مِن فتحها ثمَّ هَلُمَّ جرّا",13,"ر",2,0],["مِن لدن رَب حَكيم","وَعَطاء وَحباء",14,"ا",2,0],["مِن لَدُن آدَمٍ إِلَى ابنَةِ وَهبٍ","تُنتَقى أينَ تُوضعُ الحُسَباءُ",15,"ا",2,0],["من لدى زفس أمره بلغتني","وأنا عالمٌ بأن إلاهاً",16,"ه",2,0],["من لدن تيتس نضاراً بهرا","فقال آخيل علام يا منى",17,"ن",2,0],["من لَدَى زَفسَ بالبَلاغِ أَتَتهُم","نَفسُ إِيرِيسَ كالنَّسِيم العَجُولِ",18,"ل",1,0],["من لدهرٍ عنّي عَمي فدعاني","للمعمّى أرنو للأعيَنَين",19,"ن",1,1],["من لدنيين علما لهما","وهب الوهاب منه ما وهب",20,"ب",1,0],["من لدى المعراج قد شاهده","خاتم الرسل بأعلى الطبقات",21,"ت",1,0],["من لدات الحور إلا أنها","ألفت نار الحشى دار مقام",22,"م",1,0],["من لديه العفو مطلب","ولديه الذنب مغتفر",23,"ر",1,0],["مَن لديها الصبرُ أن تبقى بعيداً","حين تدري أنَّ أخرى تقترِبْ؟",24,"ب",1,0]]}