{"poems":[[50,"ومترف عقل الحياء لسانه","https://www.aldiwan.net/poem10401.html","الكامل"],[234,"الحر لا يأتي الدنيه","https://www.aldiwan.net/poem50732.html","مجزوء الكامل"],[289,"عاد الشمقمق في الخسارة","https://www.aldiwan.net/poem44310.html","مجزوء الكامل"],[556,"ضنت عليك ضنينة الخدر","https://www.aldiwan.net/poem47786.html","أحذ الكامل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16763","الكامل"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/19983","البسيط"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49994","الكامل"],[2124,"","https://poetry.dctabudhabi.ae/diwan/poem/45512","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199997","المجتث"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82828","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48459","البسيط"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85248","الكامل"],[4767,"كوكب عمان","https://www.poetsgate.com/ViewPoem.aspx?id=204152",""],[243,"يوم ارتوى الثأر","https://www.poetsgate.com/ViewPoem.aspx?id=20960",""],[5720,"سَيِّدِنَا النَّبِيْ ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=204110",""],[6320,"ثَلْجُ الجَحِيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83636&r=&rc=17",""]],"verses":[["حَتّى أُزيحَ الهَمَّ عَنكَ بِشُربَةٍ","تَسمو بِصاحِبِها إِلى العَلياءِ",0,"ا",2,0],["حتّى أزورَ أميَّةً","في كلّ بَلْقَعةٍ قَصِيّه",1,"ي",2,0],["حَتّى أَزورَ الهاشِمِيَّ","أَخو الغَضارَةِ وَالنَضاره",2,"ر",2,0],["حَتّى أَزارتنِي محاسنُهُ","بعد الهدوّ سُلافَةَ الخمرِ",3,"ر",1,0],["حَتّى أَزالَ الصُبحَ فاضَلَ ذَيلُهُ","كَالنيلِ يَخطُرُ في نَوادي يَعرُبِ",4,"ب",1,1],["حَتّى أَزالوهُ كُرهاً عَن كَريمَتِهِم","وَعَرَّفوهُ بِذُلٍّ أَينَ أَصلُ عَدى",5,"د",2,0],["حتى أزور أبا المغيرة طالباً","منه السّماحةَ والشَّجاعةَ والوَفا",6,"ف",2,0],["حَتّى أَزورَكِ إِن تَيَسَّرَ طائِري","وَسَلِمتُ مِن رَيبِ الحَوادِثِ وَالرَدى",7,"ا",1,0],["حتى ازدهوا بي وقالوا","إنّ مع العسر يسرا",8,"ر",2,0],["حَتى ازدراكُم بهذا كل مُحتَرِمٍ","لكم وَمجكُمُ الأَعلى مَعَ الأدنى",9,"ن",2,0],["حتى أزَلْتَ وللأبْصارِ تبْصِرَةٌ","بمخبَر الصّدقِ أخْبارَ الأكاذيبِ",10,"ب",1,0],["حتى أز به المهين دينه","وأذل كل معاندٍ متجبر",11,"ر",1,0],["حتى أزال من الطريق حواجزاً","كانت تصد العاملين وتحجب",12,"ب",1,0],["حتى ازدهى كل شبر في العراق ففي","مينائه اليوم نور الفجر قد سطعا",13,"ع",2,0],["حَتَّىٰ أَزُوْرَ هُنَاكَ مَسْجِدَهَا الَّذِيْ","فِي الْبَعْضِ مِنْهُ مَزَارُ سَيِّدِنَا النَّبِيْ",14,"ب",2,0],["حَتَّى أُزِيلَ الحُزْنَ عَنِّي رَاجِياً","إِيمَاضَ قَلْبِي فِي دَيَاجِي المُعْدِمِينْ",15,"ن",1,0]]}