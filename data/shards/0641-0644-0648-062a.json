om/ViewPoem.aspx?id=181582",""],[5183,"صفو الحب","https://www.poetsgate.com/ViewPoem.aspx?id=186608",""],[5183,"الخال","https://www.poetsgate.com/ViewPoem.aspx?id=186611",""],[572,"عُيوناً تُمْسّكُ أفْقَ السماءِ","https://www.poetsgate.com/ViewPoem.aspx?id=25007",""],[5358,"نعم صدَقتِ","https://www.poetsgate.com/ViewPoem.aspx?id=197395",""],[5542,"الباحة اليوم","https://www.poetsgate.com/ViewPoem.aspx?id=10055",""],[5582,"لَقَدْ زِدْتِ نُوراً يا ابْنَةَ الخَمْسِ وَالتِّسْعِ","https://www.poetsgate.com/ViewPoem.aspx?id=187178",""],[5690,"نوائب الدهر إنذارٌ إلى الأممِ","https://www.poetsgate.com/ViewPoem.aspx?id=172180",""],[5759,"كيف الخلاص","https://www.poetsgate.com/ViewPoem.aspx?id=213994",""],[2546,"قد ثبت الخاتم فى بنصرى","https://www.poetsgate.com/ViewPoem.aspx?id=201431",""],[5803,"أنت الهيام وصبر العاشقين أنا","https://www.poetsgate.com/ViewPoem.aspx?id=104035",""],[5828,"هَات اسْقِنِي بالكبير وأنتخب","https://www.poetsgate.com/ViewPoem.aspx?id=190973",""],[5908,"لي لا لغيري آلت نوبة الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=170970",""],[5953,"يا سرّ مرَّى لقد أصبحت لي سكناً","https://www.poetsgate.com/ViewPoem.aspx?id=93789",""],[402,"وارحمتاه لقوم فارقوا النعما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54062&r=&rc=914",""],[6289,"دِمّشْقْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81753&r=&rc=5",""]],"verses":[["فَلَو تَجمُدُ الراحُ لَم تَعدُها","وَإِن هِيَ ذابَت فَخَمرٌ تَحِلّ",0,"ل",1,0],["فَلَو تَراهُم حَيارى لا دَلِيلَ لَهُم","عَلَيهِم من ثيابِ الذُلِّ أَلوانُ",1,"ن",1,0],["فَلَو تُذرِيانِ الدَمعَ مُنذُ استَهَلَّتا","عَلى إِثرِ جازي نِعمَةٍ لَجَزاهُما",2,"م",2,0],["فَلَوْ تَرَقَّبَهُمْ مُسْتَطْلِعٌ لَرَأَى","أَشْلاءَ حُزْنٍ مُشَظَّاةً بِكُلِّ حِمَى",3,"م",2,0],["فَلو تَرَكوها وَالخِيارَ تَخيَّرَت","فَما مِثلُ مَيّ عِندَ مِثلِكَ يَصلُحُ",4,"ح",1,0],["فلو ترى القوم قاموا في ضفافهما","واستنزفوا من شؤون الدمع ما غزرا",5,"ر",2,0],["فَلَو تُفتَدى بِالبيضِ وَالسُمرِ فِديَةٌ","لَأَلقَت قَناها في البِلادِ كَتائِبُه",6,"ب",2,0],["فَلَو تَمُرُّ بِها بَلقيسُ عَن عُرُضٍ","قالَت هِيَ الصَرحُ تَمثيلاً وَتَشبيها",7,"ي",3,0],["فَلَو تَعلَمُ الأَنعامُ شَيئاً بَكَينَهُ","وَكانَ عَلى الجَرّاحِ تَبكي البَهائِمُ",8,"م",1,0],["فلو تراءت لك مصلوبة","حسبتها جذعا على الجذع",9,"ع",1,0],["فلو تراه وحسن منظره","لقلت إن الجمال للشعر",10,"ر",1,0],["فَلَو تَأَهَّبتُ وَالأَنفاسُ في مَهلٍ","وَالخَيرُ بَيني وَبَينَ العَيشِ مَقبولُ",11,"ل",1,0],["فَلو تَحمِلُ الأَيّامُ ما أَنا حامِلٌ","لَما كادَ يَمحو صِبغَةَ اللَيلِ نورُها",12,"ر",3,0],["فلو تسألُ الريحُ المعاطسَ منهمُ","لأخبرها عَن كُلِّ شلوٍ بها دِفرُ",13,"ر",1,0],["فَلَو تَراهُ مُشيحاً وَالحَصى فِلَقٌ","تَحتَ السَنابِكِ مِن مَثنىً وَوُحدانِ",14,"ن",1,0],["فَلَو تَرى عَبرَتي وَالشَوقُ يَسفَحُها","لَما اِلتَفَتَّ إِلى شَيءٍ مِنَ المَطَرِ",15,"ر",1,0],["فَلَو تَكَلَّمَ خَلقٌ لا لِسانَ لَهُ","لَقَد دَعَتهُ المَعالي مِلَّةً طُرُفا",16,"ف",2,0],["فلو تساوى الناسُ في رزقهمْ","لم تعْطَ معشارَ الذي في يديكْ",17,"ك",1,0],["فَلَو تَلتَقي أَرواحُنا بَعدَ مَوتِنا","وَمِن دونِ رَمسَينا مِنَ الأَرضِ مَنكِبُ",18,"ب",1,0],["فَلَو تَرانا في قَميصِ الدُجى","حَسِبتَنا في جَسَدٍ واحِدِ",19,"د",1,0],["فلَوْ تُجَرَّدُ مِنْ مِصْرٍ عَزائِمُهُ","إلى العِدَا بَطَلَ البَيْكارُ والسَّفَرُ",20,"ر",1,0],["فَلَو تَعْلَمُ الأجسامُ أن تُرابَهُ","مِهادُ حَياةٍ لِلْجُسومِ وَثيرُ",21,"ر",1,0],["فلو تَرَى كلَّ عُضْوٍ مِنْ كُمِاتِهِم","مُفَصَّلاً وهْوَ مَكفُوفُ ومَشْلولُ",22,"ل",1,0],["فلو تقدر الألفاظ أكثر تَرجمت","ولكنّ هذا ما تُطِيقُ التراجِمُ",23,"م",1,0],["فلو تقدم في عصر الفلاسف أو","لو أبصروه لقالوا علةُ العلل",24,"ل",1,0],["فلو تَراهُ غَدا بالصّقْرِ أشْبهَ مِنْ","جوانحي بقَطاً في الجَوّ كُدْريّ",25,"ي",1,0],["فَلَو تَسأَلَ الأَيّامَ ما اسمي لَما دَرَت","وَأَينَ مَكاني ما عَرَفنَ مَكاني",26,"ن",2,0],["فَلَو تَأكُلُ الزُبدَ بِالنِرسِيانِ","وَتَدَّمِجُ المِسكَ وَالمَندَلا",27,"ل",2,0],["فَلَو تَكَلَّمَ ذاكَ الطِفلُ قالَ لَهُ","إِلَيكَ عَنّي فَما أُنشِئتُ مُعتَمِدا",28,"د",2,0],["فَلَو تَكَلَّمَ دَهرٌ كانَ شاكِيَهُم","كَما تَراهُم عَلى الإِحسانِ يَشكّونَه",29,"ن",2,0],["فَلَو تُكشَفُ الأَحشاءُ صودِفَ تَحتُها","لبَثنَةَ حُبٌّ طارِفٌ وَتَليدُ",30,"د",1,0],["فَلَوْ تَرَانِي وَبُرْدِي بِالنَّدَى لَثِقٌ","لَخِلْتَنِي فَرْخَ طَيْرٍ بَيْنَ أَدْغَالِ",31,"ل",1,0],["فَلَوْ تَأَمَّلْتَنِي وَالْكَأْسُ دَائِرَةٌ","لَخِلْتَنِي مَلِكاً يَخْتَالُ مِنْ مَرَحِ",32,"ح",1,0],["فَلَو تُرِكَ المَسيحُ يُريدُ بُرئي","لَقالَ كَفَت بَصيرَتُكَ المَسيحُ",33,"ح",1,0],["فلو تدفعون ما أُعَانى","لمَا أَطَقْتم لذاك دَفْعَا",34,"ع",2,0],["فَلَو تَقَدَّمَ لَم تَفخَر بِحاتِمِها","وَعَمرِها سالِفاً أَبناءُ قَحطانا",35,"ن",2,0],["فلو تراني أمسي رافعا ليدي","في الليل أدعو لك الرحمن مبتهلا",36,"ل",2,0],["فلو تلبث يوما في تجلده","دارت عليه كؤوس الويل والحرب",37,"ب",1,0],["فلو ترى الخلق والأبصار طامحة","والناس لو ضربوا بالسيف ما شعروا",38,"ر",3,0],["فلو تزن الدنيا لديه بعوضة","لما كان فيكم من بها الماء يشرب",39,"ب",1,0],["فَلو تُذابُ عَطايا كَفِّهِ لَجَرَت","بَحراً مِن التِبرِ رَجّافاً لَهُ لَجَبُ",40,"ب",1,0],["فَلو تَكونُ إِلى الأَصدافِ نِسبَتُها","لَكانَ لِي كَرَمٌ يَنهى عَن الهَلَعِ",41,"ع",1,0],["فَلَوْ تَرَكَتْني ناقتي من حَنينِها","وما بِيَ من وَجْدٍ إِذاً لكَفاني",42,"ن",2,0],["فَلَو تُولِينَنِى لَعَلِمتِ أَبِّى","بِمَعرُوفٍ لِفاعِلِهِ شَكُورُ",43,"ر",1,0],["فلو تسطو الأكفُّ لأخذِ شيءٍ","وأعقبَ فيه نَهْيُك عَزَّ قبض",44,"ض",1,0],["فلو تَصاممت عن داعي السرور به","أجاب دونَك سكان النواويس",45,"س",1,0],["فلو ترسل الارواح في الجوِّ نورها","عرفتكِ بالنور الذي قد تبسما",46,"م",2,0],["فلو تشاءُ أمرتَ النارَ فانطفأتْ","ولو تشاءُ زجرتَ الماءَ فاستعرا",47,"ر",2,0],["فلو تدرِ العوالمُ ما درينا","لحنتْ للصلاةِ وللصيامِ",48,"م",1,0],["فلو ترى حُسنه من بين حُسنهمُ","لقلت ذا مَلِكٌ حَفَّت به الوُزَرا",49,"ر",2,0],["فلو ترانيَ تِلقا بابِ دارِكمُ","كأنَّني دَيدَبانٌ أحرس الطُّرقا",50,"ق",2,0],["فلو ترى كأسَه على فمه","حسبتَ شمساً تقبِّلُ القمرا",51,"ر",2,0],["فلو تراني عاريا","مضنى حليف السهد",52,"د",1,0],["فلو تراها فوق ظهري غدت","وحرت ما اصنع في امري",53,"ر",2,0],["فلو تَسْمَعُ الموتى لناديتُ مُسْمِعاً","يزيدَ بِخِزْيٍ قم فقد أدرِك الوِتر",54,"ر",1,0],["فلو ترى ضِحْكَه ودَمْعي","وذِلّتي في الهوى وكِبْرَهْ",5