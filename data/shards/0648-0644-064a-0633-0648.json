{"poems":[[90,"أرى بغداد من بعد أغبرار","https://www.aldiwan.net/poem44976.html","الوافر"],[39,"وليسوا من القوم الذين تبدلوا","https://www.aldiwan.net/poem7455.html","الطويل"],[53,"أبا حسن قد قلت لو كان فعال","https://www.aldiwan.net/poem65941.html","الطويل"],[53,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[53,"بني وهب الله جار لكم","https://www.aldiwan.net/poem66482.html","المتقارب"],[31,"ألا يا اسلمي يا أم بشر على الهجر","https://www.aldiwan.net/poem6070.html","الطويل"],[87,"حياة ما نريد لها زيالا","https://www.aldiwan.net/poem62956.html","الوافر"],[71,"وليس وفاتهم بالردم نقصا","https://www.aldiwan.net/poem29208.html","الوافر"],[107,"أعدي النمل خيبر والذبابا","https://www.aldiwan.net/poem44062.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85599","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39679","المتقارب"],[136,"تخطى ركبه الظلل القواء","https://www.aldiwan.net/poem54900.html","الوافر"],[426,"يعاتبني في الدين قومي وإنما","https://www.aldiwan.net/poem4848.html","الطويل"],[445,"تتبين شمل الدين أنك ناظمه","https://www.aldiwan.net/poem34869.html","الطويل"],[463,"بدينك بعد ما انفرق الجميع","https://www.aldiwan.net/poem56119.html","الوافر"],[463,"حماها بأطراف الرماح حماتها","https://www.aldiwan.net/poem56261.html","الطويل"],[469,"سقى الله بالإسكندرية منزلاً","https://www.aldiwan.net/poem3376.html","عموديه"],[556,"هل الدار تدري ما أثارت من الوجد","https://www.aldiwan.net/poem47846.html","الطويل"],[563,"خذوا علمكم بالله لا تتأخروا","https://www.aldiwan.net/poem34489.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122731","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48900","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48761","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48830","الطويل"],[914,"","https://poetry.dctabudhabi.ae/diwan/poem/100528","الرجز"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145777","المتقارب"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62448","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112889","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64510","الطويل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71077","الطويل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109357","الطويل"],[2175,"","https://poetry.dctabudhabi.ae/diwan/poem/101271","الطويل"],[2332,"","https://poetry.dctabudhabi.ae/diwan/poem/82188","الوافر"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93602","الوافر"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65971","الطويل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123931","المتقارب"],[3570,"","https://poetry.dctabudhabi.ae/diwan/poem/35889","الوافر"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117862","الوافر"],[4667,"","https://poetry.dctabudhabi.ae/diwan/poem/31396","الطويل"],[5186,"أرقت وهاجتني وقد هجع الركب","https://www.poetsgate.com/ViewPoem.aspx?id=156457",""],[308,"قد قلت إِن ثَلَاثًا عمر غيبته","https://www.poetsgate.com/ViewPoem.aspx?id=189402",""],[5334,"عَدَدْنا فُقَيْماً وآباءَهُمْ","https://www.poetsgate.com/ViewPoem.aspx?id=96977",""],[592,"فليس بنظم مستقم ولم يكن","https://www.poetsgate.com/ViewPoem.aspx?id=128801",""]],"verses":[["وليسوا مُحوِجيك إلى مُعين","وهم ما بين مهزول وضاو",0,"و",1,0],["وليسوا من القوم الذين تبدلوا","أراشا بإسماعيل أعور من جدلِ",1,"ل",1,1],["وليسوا بأجذالِ الطعانِ ذوي القنا","ولكنهم للطعن بالرأي أَجذالُ",2,"ل",1,0],["وليس وإن عداهُ الحمدُ ممن","يقال لرأيه رأيٌ كهامُ",3,"م",1,0],["وليسوا كعينٍ وإنسانها","وما قدرُ عين وإنسانها",4,"ن",3,0],["وَلَيسوا إِلى أَسواقِهِم إِذ تَأَلَّفوا","وَلا يَومَ عَرضٍ عُوَّداً سُدَّةَ القَصرِ",5,"ر",1,0],["وَلَيسوا أَرغَدَ الأَحياءِ عَيشاً","وَلَكِن أَنعَمَ الأَحياءِ بالا",6,"ل",2,0],["وليس وفاتهم بالردم نَقْصاً","لقدرهمُ ففي الشهداء صاروا",7,"ر",3,1],["وليسوا في الحروبِ إذا تلظَّت","كمن جَهِلَ الأُمورَ أَوِ استرابا",8,"ب",2,0],["وَلَيسَ وداع الشيخ قد شاب رأسه","وَداع فتى في أَول العمر أَمردا",9,"د",2,0],["وليسُوا بغيرِ صَليلِ السُّيوِف","يُجِيبُونَ صَوتاً لنا أو صدى",10,"د",2,0],["ولَيسُوا مِثلَ أقوَامٍ تَوَخَّوا","بِهَا العُجبَ المُضَلِّلَ والرِّيَاءَ",11,"ا",2,0],["وَلَيسوا إِلى نَصري سِراعاً وَإِن هُمُ","دَعوني إِلى نَصيرٍ أَتَيتُهُم شَدّا",12,"د",2,0],["وَلَيْسَ ولَوْ سامى السَّماءَ بِمُعْجِزٍ","مِنَ المَشْرَفِيِّ وَالعَوَالِي سَلالِمُهْ",13,"م",2,0],["وليس وإنما زمنٌ تولَّى","بغُرّبَ ما لفائته رجوعُ",14,"ع",1,0],["وليسوا كمن جُنَّ الزمانُ برفعه","وجاءت به من دولةٍ فَلَتاتُها",15,"ت",3,0],["وليس وميض البرق فيها بعارض","بكاها ولكن جاءها ضاحك السنّ",16,"ن",1,0],["وَلَيس وفاءٌ للجميل بموعدٍ","لَدَيَّ ويأتينِي القبيحُ بلا وَعْدِ",17,"د",1,0],["وليس وجود من وجود يكون قل","هو الله واقرأ ما هو المتقرر",18,"ر",1,0],["وَلَيسَ وَإن تَحَمَّلَ حُبَّ أسما","بِأَوَّلِ عاشِقٍ صَرَمَت حِبالَه",19,"ل",2,0],["وليس وفائي للفقيد رثاءه","ولكنه في أن أتابعه رأيا",20,"ي",2,0],["وليس وفاء النيل إلا سجيةً","تناولها من رفقة وتعلما",21,"م",2,0],["وليس وعيد الصاخبين بمنته","ولا عمل بعد الأقاويل حاسم",22,"م",1,0],["وليس وصفاً لفظه نفي بلا","ولا بالاستفهام شاب الخير",23,"ر",1,0],["ولَيْسوا مُوَالِيْنَ إلاّ لنيْرانِ","سَاسَانَ كي تَسْتَعِيدَ لظاهَا",24,"ا",3,0],["وليسَ وقوفي في المعاهد مُطفِئاً","غليلاً ومن أهواهُ عنَيَ غائبُ",25,"ب",1,0],["ولي سوء حال لا مرا غير انني","رجائي لغفار الذنوب كثير",26,"ر",1,0],["وليس وجود الضر منا لقدرة","مجردة للذات عن سبق قدرة",27,"ه",1,0],["وليسوا إلى العَلْيا بأَرْفَعَ منكمُ","وأَكثرَ سعْياً للمكارم والفَخْرِ",28,"ر",1,0],["وليس وراء الظلم خير ولا هدى","ومهما تعالى صرحه سوف ينهد",29,"د",1,0],["وليسوا كحجاج إلى البيت يمموا","فبعض على رفد وبعض على رد",30,"د",1,0],["وليسوا مثل عشرهم ولكن","يضيع القوم من قبل العقول",31,"ل",1,0],["وَلَيسَ وَراء ذاكَ السجف إِلّا","ظبيات النقا وَدمى القُصور",32,"ر",1,0],["وليس وذي الآلاء يظهر أمرهم","بطيب كلام أو بكتمان راتق",33,"ق",1,0],["وليس وزان جميل الخلاق","لدي وزان جميل البشر",34,"ر",1,0],["وَلَيسَ وزارَةُ الخُلَفاءِ نَهباً","وَلَيسَ خِلافَةُ الرَحمَنِ عارَه",35,"ر",2,1],["وليس وإن سما قدراً وشاناً","بذي صلفٍ ولا الشكس الكنود",36,"د",1,0],["وَلَيسوا بَواءً مِن أَبيهِ وَإِنَّما","شَفى في كَريمِ النَفسِ قَتلُ لِئامِ",37,"م",1,0],["وليسوا ذوي نفع رجال ترونهم","على غير أبواب السياسة ما انكبوا",38,"ب",3,0],["وَلَيْسَ وَعدك شَاة سَاقهَا الزَّمن","الْجَانِي فعلقها مِنْهُ بعرقوب",39,"ب",1,0],["ولَيْسُوا إِذَا قُلْتَ ماذا هُمُ","بأَصْحاب دُنْيَا ولا آخرَهْ",40,"ر",2,0],["وليسوا ذوي علم ومعرفة بما","يقولونه من مطلق القول والجمل",41,"ل",1,0]]}