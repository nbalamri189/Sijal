06,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[106,"تمثال فينوس","https://www.poetsgate.com/ViewPoem.aspx?id=179776",""],[106,"آمال وآلام !!","https://www.poetsgate.com/ViewPoem.aspx?id=179444",""],[90,"أمين الريحاني","https://www.poetsgate.com/ViewPoem.aspx?id=178954",""],[45,"أعادَ شَكوى منَ الطّيفِ الذي اعتَادَا","https://www.poetsgate.com/ViewPoem.aspx?id=31633",""],[91,"صاحب القلم","https://www.poetsgate.com/ViewPoem.aspx?id=53269",""],[94,"سكب المروءات","https://www.poetsgate.com/ViewPoem.aspx?id=15637",""],[51,"أيها السيِّدُ الذي وهَنَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=30625",""],[89,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[20,"طال الليل علينا واِعتكر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69774&r=&rc=15",""],[87,"هَل فى الخلاعة ِ والصِبا من باسِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23987&r=&rc=249",""]],"verses":[["ما حَقُّ مِثلي أَن يُضاعَ وَقَولُهُ","باقي العِمادِ عَلى الزَمانِ مُخَيِّمُ",0,"م",1,0],["ما حَمَلَت أَمثالَهُم","يَوماً غَوارِبُ النَعَم",1,"م",1,0],["ما حانَ مِنّا لِغَيرِ العِزِّ مُضطَرَبٌ","وَلا اِطَّبانا إِلى غَيرِ العُلى وَطَرُ",2,"ر",1,0],["ما حارَبوا الدَهرَ إِلّا لانَ جانِبُهُ","إِنَّ المُشَيَّعَ أَولى الناسِ بِالظَفَرِ",3,"ر",1,0],["ما حَمَلَ الذُلَّ ظَهرُ مارِنَةٍ","وَلا اِنزَوى عَن طَبيعَةِ الصَيَدِ",4,"د",1,0],["ما حارَبَ الأَيّامَ إِل","لا كانَ لي وَلَهُ الغِلابُ",5,"ب",1,0],["ما حَزِنّا وَلا جَزِعنا وَلَكِن","لا نُبالي يَكونُ أَو لا يَكونُ",6,"ن",1,0],["ما حسُنَتْ بعْدَكُم وُجوهٌ","عنْدي ولا أعْجَبَتْ دِيارُ",7,"ر",1,0],["ما حالُ مَنْ جاوَرَ منْكَ الصَّبا","والقُرُّ مُضْنٍ شَرُّهُ مُشْجِي",8,"ج",2,0],["ما حالُ خُلقُ الماءِ بَينَ سُطورِهِ","إِلّا إِلى خُلُقِ الزِنادِ الواري",9,"ي",1,0],["ما حَقَّنا أَن تُقِرّوا عَينَ ذي حَسَدٍ","بِنا وَلا أَن تَسُرّوا كاشِحاً فينا",10,"ن",2,0],["مَا حَالُ أُمٍّ لَهَا طِفْلٌ بِجَانِبِهَا","غَيْرَ المَدَامِعِ فِي يَوْمَيْهِ مَا طُعِمَا",11,"م",2,0],["مَا حَالُ قَوْمٍ بِمِصْرٍ شَمسُهُمْ كُسِفَتْ","وَتَسْتَهِلُّ فَمَا تُغْنِهِمُ الديَمُ",12,"م",1,0],["مَا حَيَاتِي بَعْدَ الَّتِي هِيَ مِنْهَا","مَا كِفَاحِي فِيها وَمَا آمالي",13,"ي",1,0],["مَا حَالُ مَنْ أَيْتَمتِهِمْ","بَعْدَ الهَنَاءَةِ وَالدَّلاَل",14,"ل",1,0],["ما حياة الإنسان بالذُلّ إلا","مُرّة عند حَسْوِها ممجوجه",15,"ج",2,0],["ما حُسن وجه الفتى بمَفخَرة","أن لم يؤيَّد بالحسن من أدبه",16,"ب",2,0],["ما حاجَةٌ لَكَ في الظُعنِ الَّتي بَكَرَت","مِن دارَةِ الجَأبِ كَالنَخلِ المَواقيرِ",17,"ر",1,0],["ما حولتك عن اسم الصدق آفنة","من العيوب وما نبَّرْتَ بالسبَبِ",18,"ب",1,1],["ما حُلتُ عَن خَيرِ ما عَهِدتِ وَلا","أَحبَبتُ حُبّي إِيّاكِ مِن أَحَدِ",19,"د",1,0],["ما حسن يوسف عنك بالناي ولا","دمُ مهجتِي بقميصِ خدِّك كاذبا",20,"ب",2,0],["ما حمدنا للدهرِ إلاَّ دواهُ","ولرقم الطروس إلاَّ دَوَاته",21,"ت",2,0],["ما حاد عني الفقر حتى صحت في","مدحي أنا بالله والسلطان",22,"ن",1,0],["ما حَقُّ من أسلف تأميلَهُ","مثلك أن يُجزى بإكْدائِهِ",23,"ا",3,0],["ما حمرةُ فيكما أمن خجلٍ","أم صبغةُ الله أم دمُ المُهَجِ",24,"ج",1,0],["ما حقُّ أيرٍ ناك أمثالَها","إلا مَواسِي أهل إفْرَنْجَهْ",25,"ج",2,0],["ما حَقُّ عُرْفٍ لم يُذِعْهُ وَليُّهُ","أنْ يَصْمِتَ المُوْلاَهُ بل أنْ يَصْدَحا",26,"ح",2,0],["ما حيدَ بالناس عن منهاج مكرمةٍ","إلا هَدَاكُمْ إلى منهاجِها هادِي",27,"د",2,0],["ما حَسَنٌ أن تذوبَ مهجتُها","ومهجتي لم تُرَق ولم تُمَرِ",28,"ر",1,0],["ما حُجتي إن قلتَ لي","قلْ لي متى أعدمت فخرا",29,"ر",2,0],["ما حققتْ معنى اسمها نحلةٌ","قيل اقلسي أرياً فلم تَقلِس",30,"س",1,0],["ما حقُّها عندي إذا أقبلتْ","تَعْوي سوى قولي لها نَحْطه",31,"ط",2,0],["ما حاز منزله عرساً ولا أمة","إلا ومن أجل هجوي سوف يصفعه",32,"ه",1,0],["ما حُوذرتْ نكبةٌ مُزلزِلةٌ","بالناسِ إلا جعلتَه سندكْ",33,"ك",1,0],["ما حَقُّ ميدانِ مجدٍ أنتَ صاحبُهُ","إجراءُ ناهقِهِ قُدّامَ صاهِلِهِ",34,"ل",2,0],["ما حَمْدُ مثلِكَ إن سَلِمْ","تُ عليكَ في ظلِّ التسلُّمْ",35,"م",1,0],["ما حمدُ مَنْ جادَ إن كظَّتْه ثروتُهُ","ما الحمد إلا لمُعطٍ وهْو خُمصان",36,"ن",1,0],["ما حقُّ مَنْ لان صدرُهُ لك بال","ودِّ لقاءٌ بجانبٍ خَشِن",37,"ن",1,0],["ما حَنِقنا عليكَ وهو عدوٌّ","مُوفقٌ سَهمُه وأنت الوليُّ",38,"ي",1,0],["ما حالَ بَينَ نُفوسِنا ما حالَ بَي","نَ جُسومِنا مِن أَجبُلٍ وَفَضاءِ",39,"ا",2,0],["ما حَدَّثَتنِيَ نَفسي أَن أُحَطِّمَهُ","إِلّا خَشيتُ عَلى نَفسي مِنَ النَدَمِ",40,"م",1,0],["ما حالُ تِلكَ المَغاني بَعدَ عاشِقِها","فَإِنَّني بَعدَها لِلهَمِّ وَالسَقَمِ",40,"م",1,0],["ما حَبَّبَ الجَنّاتِ عِندِيَ أَنَّها","مَثوى سَلامٍ مُستَقَرُّ حِسانِ",41,"ن",1,0],["ما حَلَّ مِنهُم مَوضِعاً أَحَدٌ","إِلّا وَصارَ لِكُلِّنا وَطَنا",42,"ن",2,0],["ما حيلَتي في كَذِبٍ","مِن حاسِدٍ مُصَدَّقِ",43,"ق",1,0],["ما حُلتُ عَن عَهدٍ وَلا خُنتُ في","وُدّي وَما قَصَّرتُ مِن جُهدي",44,"ي",1,0],["ما حياة في الشرق ذات هدوء","كحياة في الغرب ذات صدام",45,"م",1,0],["ما حيلة الضعيف تلقاء","السيوف الباتره",46,"ر",2,0],["ما حيلة المرء اذا","ما اخطأ المترجم",47,"م",1,0],["ما حياة الابناء في الارض الا","من حياة الآباء والاجداد",48,"د",1,0],["ما حياتي وغاية الله منها","ما وجودي والقصد من ايجادي",48,"ي",1,0],["ما حياة قديمها غير باد","لك الا تطور في الجماد",49,"د",1,1],["ما حياة المرء الا يقظة","بين نومين له فيها العنا",50,"ن",2,0],["ما حيلتي وانا امرؤ متفكر","جم الشكوك الى الحقيقة صاد",51,"د",1,0],["ما حياة الشعوب في","كل عصر سوى قحم",52,"م",1,0],["ما حيلتي آه كيف أصنع","إنا إلى اللَه راجعونا",53,"ن",2,0],["ما حَطَّموكَ وَإِنَّما بِكَ حُطِّموا","مَن ذا يُحَطِّمُ رَفرَفَ الجَوزاءِ",54,"ا",2,0],["ما حَدا المَها","قَبلَهُ طَرِب",55,"ب",1,0],["ما حَلَّهُ عَطفٌ وَلا رِفقٌ وَلا","بِرٌّ بِأَهلٍ أَو هَوىً لِدِيارِ",56,"ر",1,0],["ما حالَ حتّى قُلْتُ حَوْلٌ كاملٌ","سيحولُ بَيني إنْ أَقامَ وبَيْني",57,"ي",1,1],["ما حالُ مفجوعٍ بمنيةِ نفسِه","قد بانَ عنهُ شقيقُهُ وصفيُّهُ",58,"ي",2,0],["ما حَقُّنا مِن سُلَيمى أَن تَقِبضَ لَنا","بِالبَذلِ مَنعاً وَبِالإِدناءِ إِبعادا",59,"د",2,0],["ما حَديثي إِلّا حَديثُ كُلَيبٍ","وَبُجَيرٍ وَالحارِثُ إِبنِ عُبادِ",60,"د",1,0],["ما حَلَّ مُذ عَقَدَ الزُرَيقُ إِزارَهُ","حَتّى اِستَقَرَّت كَرَّةُ الأَفراسِ",61,"س",1,0],["ما حَقُّ قَدرِكَ أَن أُحَمِّلَ مُرسَلاً","غَيري إِلَيكَ وَلَو بَعُدتُ أَلوكا",62,"ك",2,0],["ماحِصنُ هَذا الحِصنُ لي بِمُعَوِّلِ","أَلجا إِلَيهِ وَأَنتَ حِصنُ أَماني",63,"ي",1,0],["ما حَلَّ لِلحُبِّ إِنَّ الحُبَّ أَعدَمَني","صَبري وَحَرَّمَ أَجفاني عَلى الوَسَنِ",64,"ن",1,0],["ما حالَ لَونٌ عِندَ ذاكَ وَلا هَفا","عَزمٌ وَلا راعَ الجَوانِحَ رائِعُ",65,"ع",1,0],["ما حَمَلَت ناقَةٌ مِن سوقَةٍ رَجُلاً","مِثلي إِذا الريحُ لَفَّتني عَلى الكورِ",66,"ر",1,0],["ما حَنَّ شَيْطَانُهُ العَاتِي إلَى بَلَدٍ","إلاّ ليَقْرُبَ مِنْ دَيْرِ الشّيَاطينِ",67,"ن",1,0],["ما حاولوا الحِصْنَ المُنيفَ بِغَدْرِهِم","حتَّى انثَنَوا جُثَثاً على الحِصنَيْنِ",68,"ن",1,0],["ما حُرِّقَ العُودُ الذي أَشبهتَه","خطأ ولا غُمَّ البَنَفسجُ باطِلا",69,"ل",2,0],["ما حرق العد الذي أشبهته","خطأ ولا غم البنفسج باطلا",70,"ل",2,0],["ما حاربَ الصُّبحُ المُضئُ غياهباً","إلا أرتنا الصبحَ سِلْمُ غياهبِ",71,"ب",1,0],["ما حالَ مَنْ لَعِبَ السَّقامُ بجسمِهِ","ظُلْماً فعضَّ نفيسةَ الأعضاءِ",72,"ا",2,0],["ما حيلَةُ المَوتِ إِلّا كُلُّ صالِحَةٍ","أَو لا فَما حيلَةٌ فيهِ لِمُحتالِ",73,"ل",1,0],["ما حيلَةُ المَوتِ إِلّا كُلُّ صالِحَةٍ","أَو لا فَلا حيلَةٌ فيهِ لِمُحتالِ",74,"ل",1,0],["ما حالَ مَن سَكَنَ الثَرى ما حالُهُ","أَمسى وَقَد قُطِعَت هُناكَ حِبالُهُ",75,"ل",2,1],["ما حَلَّتِ الأَيّامُ موثَقَ حُبِّهِ","عِندي وَلا حالَت عُهودُ وَفائِهِ",76,"ا",3,0],["ما حَرَّكَتهُ نَسيمُ الرَقصِ مِن مَرَحٍ","إِلّا وَما جَت بِهِ أَمواجُ أَردافِ",77,"ف",1,0],["ما حالَ عَنكَ عَهدي","وَلا اِنثَنى عِناني",78,"ن",2,0],["ما حِلَّةُ اِبنِ دَبيسٍ","إِلّا كَحِصنٍ حَصينِ",79,"ن",1,1],["ما حَلَّتِ الواشونَ ما عَقَدَ الهَوى","تَفنى اللَيالي وَالغَرامُ بِحالِهِ",80,"ل",2,0],["ما حُرِّكَت سَكَناتُ فاتِرِ طَرفِهِ","إِلّا وَأَصمى القَلبَ وَقعُ نِبالِهِ",80,"ل",2,0],["ما حلَّ حتى سارَ في ركبِه","معجزُ ألبابٍ وأفهام",81,"م",1,0],["ما حيلةُ القربِ الوشيك بمهجةٍ","الدهرُ أجمعُ ما يبلُّ صداهَا",82,"ا",3,0],["ما حيلةُ الآمالِ في معبودةٍ","قرَّحتُ أجفاني على مغناهَا",82,"ا",3,0],["ما حلَّ بالحرية الحمراء هل","سال الدم القاني على قدميك",83,"ك",1,0],["ما حيلتي يا هند وجهك لاح لي","بأنوثةٍ جبَّارة الطغيان",84,"