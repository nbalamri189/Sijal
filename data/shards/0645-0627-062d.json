رَابُ",132,"ب",1,0],["مَا حَياةُ عُمرانُهَا مِنْ بَقَايا","هدْمِهَا وَالْجَدِيدْ نَسْجُ الْبالِي",133,"ي",1,0],["مَا حَالُ مَنْ تَدْأَبُ تَنْتَابُهُ","تخْبُرُ مِنْ بَلْوَاهُ مَا تَخْبُرُ",134,"ر",1,0],["مَا حَسِبْنَا الزَّمانَ إِنْ طَاَل مَا طَا","لَ مُزِيلاً ذَاكَ الشَّبَابَ النَّضِيرا",135,"ر",2,0],["مَا حِصْنُهُ مِمَّنْ يَصِيدُ","وَأَمْنُهُ مِمَّا يَضِيرْ",136,"ر",1,0],["مَا حُفِفْنا بِهِ مِنَ الشِّقِوَاتِ","فَلِهَذَا نُحِبُّهَا كَيْفَ كُنَّا",137,"ن",2,0],["مَا حَلَّ بالأَعْدَاءِ مِثْلُ لِقائِنَا","يومَ النّجاحِ ويمُنَا بالخنْدَقِ",138,"ق",1,0],["ماحاضر الروحاء دون مناله","وخْد السرى في الأمعز الصوان",139,"ن",1,0],["ما حَسِبتُ القُبورَ تَستَودِعُ الأَق","مارِ فيها حَتّى دَفَنتُ الحَبيبا",140,"ب",2,0],["ما حَياتي بَعدَ رَوضٍ","إِذ وَشاهُ الدَهرُ أَدوا",141,"و",2,0],["ما حبسكم لُطفاً لديكم مُحضَراً","عمّنْ لديه به ثناء محضر",142,"ر",1,0],["ما حنى الرأسَ مرةً لِعظيمٍ","فأبى أن يراهُ لِلسِّنّ يُحنَى",143,"ن",2,0],["ما حَيَاةُ المُحبِّ بعدَ حبيبٍ","قَبَسَ النورُ والهوَى من حياته",144,"ت",2,0],["مَا حَيَاتِي وَالْكَوْنُ بَعْدَ جِهَادٍ","لَمْ أَزَلْ وَاقِفاً عَلَى أبْوابِهْ",145,"ب",2,0],["ما حاد عن سَنَن العدالة آخذٌ","من نفسه لغريمه بالثار",146,"ر",1,0],["ما حوى الأفْقُ مثل برجك برجًا","شائك السُّور، محكمَ الأبواب",147,"ب",1,0],["ما حاد عن شرعة الإِنصاف مُهْتَضَمٌ","قد جاءه يقتضي حقًّا لَهُ سُلبا",148,"ب",2,0],["ما حرب جنديّ لهُ","في السلم كلُّ دِمٍ مباح؟",149,"ح",1,0],["ما حرَّم الإسلام حلاَّ","أو أباح محرَّما",150,"م",2,0],["مَا حطَّ قدرَكَ سجنٌ أَنزلوك به","هيهاتَ! بل كنْتَ للسَّجَّان سجَّانا",151,"ن",2,0],["ما حلَّ من عبَثٍ لَغْيرِك، فَهْو في","شَرْع الوَرَىْ لك أنتَ غَيْرُ حَلالِ",152,"ل",1,0],["ما حَقَّق الأهدافَ إلاّ أُمَّةٌ","رَسَخَتْ عَقِدَتُها رُسُوخَ جِبالِ",152,"ل",1,0],["ما حسنُ أُفقٍ سُحبُهُ","يحُجبنَ صفحة بدره؟",153,"ر",2,0],["ما حيلة العصفور قَضُّوا ريشة","ورمَوْه في قفص وقالوا: غرِّد؟",154,"د",1,0],["ما حُوِّلت تلك الخيامُ ولا عَدَتْ","فينا على تلك الطباع عوادي",155,"د",2,0],["ما حقُّنَا من سُلَيمى، أنْ تَقيضَ لَنا","بالبَذْلِ مَنعاً، وَبالإدْنَاءِ إبْعَادَا",156,"د",2,0],["ما حدّثتني نفسي أن أحطّمه","إلاّ خشيت ععلى نفسي من الندم",157,"م",1,0],["ما حاكاه الهندوانيّ ولا أغنى غناه","أكرم الودّ تفيأنا على الجلىّ حماه",158,"ا",2,0],["ما حقُّ مَنْ لان صدرُهُ لك بال","ودّ لقاءٌ لجانبٍ خَشِن",159,"ن",1,0],["ما حياتي ألا كسلسلة أنت س","تأتي في آخر الحلقات",160,"ت",1,0],["ما حَمَلتُ الغُلَّ مِن أَعدائِكُم","وَلَدى اللَهِ مِنَ العِلمِ المُسَر",161,"ر",1,0],["مَا حُل بَينَ القَوم عَقْدُ وِكائها","لِلشرْب إِلاَّ آدبت بِعُطاسِ",162,"س",1,0]]}