],["إن الكريم إذا عفا عن مجرم","لم تبق سيئة له في الحال",205,"ل",1,0],["أنا لكِ عبدٌ فكوني كَمَن","إذا سرَّهُ عبدهُ أعتَقا",206,"ق",2,0],["أنالكمُ الإلاهُ كلَّ خَيرٍ","أيا برقَ المفاخِر واللَّطافه",207,"ف",2,0],["إن الكريمة إذ تهدى إلى رجل","كفوء لها نال شكر الخلق مهديها",208,"ي",3,0],["ان الكريم هو الذي حمل الاذى","عن قومه لا من تقل ضوابح",209,"ح",1,0],["إِنَّ الكِرامَ بَني سَعيدٍ كُلَّما","وَرِثوا النَدى وَالمَجدَ أَوحَدَ أَوحَدا",210,"د",2,0],["إن الكواكب دون شمسك مالها","وهجٌ ولا عند الطلوع سعودُ",211,"د",1,0],["إنَّ الكرامَ إذا غابوا أو ارْتَحلوا","فإنَّ مَنْزلَهُم فِي القَلْبِ لا البَصَرِ",212,"ر",1,0],["انا لك من مجاميعي عطيتك قلبي الوافي","وسلّمتك مفاتيح الفؤاد وسوّبه ماتريد",213,"د",1,0],["إن الكرام ومنك كل نوالهم","يرتاح فيضهم إلى استدراره",214,"ر",2,0],["إن الكريم الحق من إحسانه","يثري إلى من ليس بالمستأهل",215,"ل",1,0],["اِنّ الكرامَ اذا مالحق أندبهم","ألفيتَ سيفَ الأبى قاني الدّما اتزرا",216,"ر",2,0],["إن الكرام بأسرهم قد أغلقوا","باب السماح وضيعوا المفتاحا",217,"ح",2,0],["إنّ الكتاب لخير مجدٍ للفتى","هّيا ادخلوا للمجد أوسع بابِ",218,"ب",1,0],["إنّ الكرامَ بكلِّ أرضٍ قِلّةٌ","إلا هُنا نلقى الجميعَ كِراما",219,"م",2,0],["إن الكرامةَ في نفوسِ أُبَاتِها","تجري دمًا بعروقِهاَ ينسابُ",220,"ب",1,0],["إنَّ الكرامةَ في العروبةِ مِلةٌ","من قبل أن يُتْلَى الكتابُ ويُنْزَلَا",221,"ل",2,0],["ان الكريم اذا تحكم ما ظلم","وابن اللئيم اذا تحكم كالذئاب",222,"ب",1,0],["إن الكلاب ماؤنا فخلوه","وساجراً والله لن تحلوه",223,"ه",1,1],["ان الكرام اذا اهريقت دماؤهم","أرواحهم بقيت في الدهر كالشمس",224,"س",1,0],["إن الكريم متى ألم بداره","ضيف قراه البِرّ والإحسانا",225,"ن",2,0],["إن الكتاب وإن تضمن طية","كنه الفصاحة كالفصيح الأخرس",226,"س",1,1],["إن الكريم يلين عند عتابه","وترق حاشيتاه باستعطافه",227,"ه",1,1],["إنّ الكريمَ لطِيبِ الخَلق ملْتمسٌ","أمّا اللئيمُ فدَومًا يطْلبُ الخَبَثا!",228,"ث",2,0],["إن الكلام تكسّرت أغلالُه","حتى السكاتُ رنَا لنا همّاسا",229,"س",2,0],["إن الكلام على الكلام تتابُعٌ","عشِقت له رحِمُ السماء نِفاسا",229,"س",2,0],["إن الكلام مذكر ومؤنث","وكذ البيان مذكر ومؤنث",230,"ث",1,0],["إنَّ الكِتَابَ إذا قَلَاهُ صِحَابُهُ","ونَسُوا مَقَاصِدَ وَضْعِهِ في المَنْزِلِ",231,"ل",1,1],["أ نالكَ شئ ٌ من هواكَ ؟ أ نِلْتَهُ","؟ فمالكَ ضيّعتَ السنينَ الغوالِيا",232,"ي",2,0],["إنّ الكرامةَ الاِستقامةُ والتُّقى","وزكاة نفسِكَ أَنْ تُطيعَ الخالقا",233,"ق",2,0],["إنَّ الكرامةَ عرشٌ لا أضيُّعه","منْ بعدها ذلةٌ لن ينفعَ الندمُ",234,"م",1,0],["إنَ الكهولةَ لم تقفْ في بابنا","هيَّا رواءُ* فرددي ألحاني",235,"ن",2,0],["ان الكوارث لن تفارق عزلا","لا يملكون سوى الدموع سلاحا",236,"ح",2,0],["إِنَّ الْكَرِيمَ إِذَا رَأَى إِخْلَاصَكُمْ","حَتْمًا سَيَنْصُرُكُمْ بِلَا خِذْلَانِ",237,"ن",1,0],["إنَّ الكرام كرام نفسٍ قد سمتْ","ومعادن الشجعانِ درٌ مستترْ",238,"ر",1,0],["إن الكلام مترجمٌ لذواتنا","منها يُرى جهل الفتى إذْ ينطقُ",239,"ق",1,0],["إن الكلامَ إذا امتشقتَ حُسَامَهُ","روحٌ تُطاوِلُ صَرْحَ أعْمَارِ ..",240,"ر",1,0],["ان الكريمَ وان أربت خلائقه","ما لم يجده بأدنى وبله اليسرُ",241,"ر",1,1],["أنا لك أسوار ومصدّات وحدود","أرضك على قلبي والاضلاع بيتك",242,"ك",1,0],["إن الكريم إذا أساء بلا قصدٍ","وأخطأ تاب واعتذرا",243,"ر",2,0],["انا لك من هنا حتى مغيب العمر وزهوره","الى مشرق مشيب العمر لين يغيب بترابه",244,"ب",2,0],["إن الكرامة فوق الأرضِ غايتنا","أو للشهادةِ دون العرضِ نستبقُ",245,"ق",1,0],["أنا لك في نحتِ القوافي مهذَّبٌ","لأنَّك بالحُسنى إليَّ محبّب",246,"ب",1,0],["إنّ الكفوفَ التي قدْ صفّقَتْ مَلَقَاً","عينُ الكفوفِ التي باعتْ بلا ثمنِ",247,"ن",1,0],["إنَّ الكريمَ يحبُّ كَفَّ مُشَمِّرٍ","لا يرتضي عَمَلًا بلا إتقانِ",248,"ن",1,0],["أنا لك هديةْ حب لا لا تِرِدّني","وإذا قلبك ارفضني ابطلب مدد مدد",249,"د",1,0],["إن الكسائيَّ وأصحابهُ","يرقَونَ في النحوِ إلى أسفلِ",250,"ل",1,0],["إن الكآبة قطعّت أحشاءنا","ووصلتها فيما لديك منَ اعتنا",251,"ن",2,0],["إنَّ الكمالَ لربنا لكنها","كمُلتْ بفن الصبرِ والتدبيرِ",252,"ر",1,0],["إنّ الكفيف إذا يمرُّ بربوةٍ","غناءَ يجهلها ولا غنّاءا",253,"ا",3,0],["أنا لك الصحب والإخوان كلهُمُ","والأبُّ والأمُّ يا أحلى البنيّاتِ",254,"ت",1,0],["إنَّ الكلامَ عنِ الحَبيبِ يَشُوقُ","قلبَاً تَعلَّقَ والفُوأَدُ عَلوقُ",255,"ق",1,1],["إنَّ الكَرامَةَ تأبى أَن نَذِلَّ ولَم","نَهضم حُقوقَ الوَرى كالهائجِ الضَّرمِ",256,"م",1,0],["إن الكريم منْ قرى أضيافه","ما يسمعُ الإمكانُ من إكرامها",257,"م",3,0],["إن الكواكبَ في علوّ محلّها","لتُرى صغاراً وهي غيرُ صغار",258,"ر",1,0]]}