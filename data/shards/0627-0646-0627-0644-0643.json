"البسيط"],[501,"الخب ميال مع الشبهات","https://www.aldiwan.net/poem37714.html","الكامل"],[516,"يا مطلق العبرات وهي غزار","https://www.aldiwan.net/poem12104.html","الكامل"],[538,"إن الكرام على الجياد مقيلهم","https://www.aldiwan.net/poem69407.html","الكامل"],[559,"العفو أليق لا جرم","https://www.aldiwan.net/poem34073.html","مجزوء الكامل"],[559,"أسقي نداماي من كاسي وأشرب ما","https://www.aldiwan.net/poem34312.html","البسيط"],[563,"أليوم مات التقى والجود والكرم","https://www.aldiwan.net/poem52783.html","البسيط"],[563,"تناقض الرأي بين الناس والعمل","https://www.aldiwan.net/poem52856.html","البسيط"],[570,"إن الكريم إذا ما كان ذا كذب","https://www.aldiwan.net/poem52044.html","البسيط"],[573,"لآل هند بجنبي نفنف دار","https://www.aldiwan.net/poem2054.html","البسيط"],[576,"إن الكمال أصاب في محبوبتي","https://www.aldiwan.net/poem2834.html","الكامل"],[576,"جاءت بحسن مطمئن","https://www.aldiwan.net/poem3000.html","مجزوء الكامل"],[587,"بمن أباحك قتلي","https://www.aldiwan.net/poem17667.html","المجتث"]],"verses":[["إنّ الكَتائِبَ كُتْبٌ عَنْكَ صادِرَةٌ","فاسْدُدْ بِها لَهَواتِ السّهْلِ والجَبَلِ",0,"ل",1,0],["إِنَّ الكَريمَ نُدوبُهُ في وَجهِهِ","وَنُدوبُ مُرَّةَ لا تُرى في المَنحَرِ",1,"ر",1,0],["أَنا لَكِ مَملوكٌ فَإِن شِئتِ عَذِّبي","وَإِن شِئتِ مُنّي أَيَّ ذا شِئتِ فَاِصنَعي",2,"ع",2,0],["إِنَّ الكِلابَ لَتَهدي في مَواطِنِها","وَالخَلقُ لَيسَ بِهادٍ شَرُّهُم أَبَدا",3,"د",2,0],["إِنَّ الكَريمَ اِبنَ الكَري","مِ لِكُلِّ ذي كَرَمٍ نِصابُه",4,"ب",2,0],["إِنَّا لَكُمْ وَلِمِصْرَ وَاستِقْلاَلِهَا","فَلْتَحْيَا مِصْرُ وَيَحْيَا الاسْتِقْلاَلُ",5,"ل",1,0],["إِنَّ الكِرامَ إِذا ما أَسهَلوا ذَكَروا","مَن كانَ يَألَفُهُم في المَنزِلِ الخَشِنِ",6,"ن",1,0],["إِنَّ الكَريمَ إِذا حَرَّكتَ نِسبَتَهُ","سَمَت بِهِ سامِياتُ المَجدِ وَالهِمَمِ",7,"م",1,1],["أن الكريمة في الزواج لحُرّةٌ","والحرّ يأبى أن يعيش مذبذبا",8,"ب",2,0],["إِنَّ الكِرامَ إِذا عَدّوا مَساعِيَكُم","قِدماً فَضَلتَ بِئاباءٍ وَأَجدادِ",9,"د",1,0],["إِنَّ الكِرامَ إِذا مَدّوا حِبالَهُمُ","أَزرى بِحَبلِكَ ضَعفُ العَقدِ وَالقِصَرُ",10,"ر",1,0],["إِنَّ الكَريمَةَ يَنصُرُ الكَرَمَ اِبنُها","وَاِبنُ اللَئيمَةِ لِلِّئامِ نَصورُ",11,"ر",1,0],["إِنَّ الكَنيسَةَ كانَ هَدمُ بِنائِها","قَسراً فَكانَ هَزيمَةً لِلأَخرَمِ",12,"م",1,0],["إِنَّ الكِرامَ لَها مَكارِمُ أَصبَحَت","تَنمي وَسَعيُ أَبيكَ لَيسَ بِنامِ",13,"م",1,0],["إنَّ الكرام إذا حاولت صيدهمُ","كانت بيوت المعالي مثل إشراك",14,"ك",1,0],["إن الكلام الذي رُعِّثتَهُ شَبَهُ","تستنكف الأُذنُ منه حين تُرتعَثُ",15,"ث",1,0],["إن الكلاب مغنيها ومطربها","في صوته عمر فاسلح على عمر",16,"ر",1,0],["إن الكتابة أصبحت عربيةً","زهراء ترغب عن بني الأكداس",17,"س",1,0],["إن الكثير الخبيث مقتحم","في العين والقلب يبعث الأنفا",18,"ف",2,0],["إن الكرائم ليستْ وحدها حُرَماً","دون المكارم لكن كُلُّها حُرَمُ",19,"م",1,0],["إِنَّ الكَواكِبَ في مَنازِلِها","لَو شِئتُ لَاِستَنزَلتُها كَلِما",20,"م",2,0],["إِنَّ الكِرامَ إِذا صَحِبتُهُمُ","سَتَروا القَبيحَ وَأَظهَروا الحَسَنا",21,"ن",2,0],["إن الكفاية للمكا","سم واللوابل والموازر",22,"ر",1,0],["إِنَّ الكِرامَ بِلا كِرامٍ مِنهُمُ","مِثلُ القُلوبِ بِلا سُوَيداواتِها",23,"ت",3,0],["إِنَّ الكِذابَ الَّذي أَكادُ بِهِ","أَهوَنُ عِندي مِنَ الَّذي نَقَلَه",24,"ل",2,0],["إِنَّ الكَريمَ إِذا رَأى ذا خِسَّةٍ","صَدَفَ المَوَدَّةَ عَنهُ صَدفَ الطارِدِ",25,"د",1,0],["إِنَّ الكُؤوسَ بِها يَطيبُ المَجلِسُ","فَعَلامَ تُحبَسُ أَم لِماذا تَحبِسُ",26,"س",1,1],["إنَّ الكَريمَ إذَا بَنَى","لَمْ يَنْوِ هَدْمَ بِنَائِهِ",27,"ا",3,0],["إِنَّ الكَريمَ إِذا حَباكَ بِنَيلِهِ","أَعطاكَهُ سَلِساً بِغَيرِ مِطالِ",28,"ل",1,0],["إن الكريمَ إذا نابتهُ نائبةٌ","لَم يَبدُ مِنهُ عَلى عِلّاتِهِ الهَلَعُ",29,"ع",1,0],["إِنَّ الكَريمَ إِذا حَباكَ بِوَعدِهِ","أَعطاكَهُ سَلِساً بَغَيرِ مِطالِ",30,"ل",1,0],["إِنَّ الكَبيرِ أَجَلُّ قَدراً أَن يُرى","عَجِلَ التَغَيُّرِ لِلصَديقِ إِذا هَفا",31,"ف",2,0],["إن الكواكب ضقن بي","ذرعاً وآسيها سئم",32,"م",1,0],["إِنَّ الكِرامَ كَثيرٌ في البِلادِ وَإِن","قَلّوا كَما غَيرُهُم قُلٌّ وَإِن كَثَروا",33,"ر",3,0],["إنَّ الكريمَ ليمحو كلَّ سيئةٍ","معَ الصفاءِ ويخفيها معَ الكدرِ",34,"ر",1,0],["إِنَّ الكَواكِبَ لا يُشبِهنَ صورَتَها","وَهُنَّ أَسوَءُ مِنها بَعدُ أَخبارا",35,"ر",2,0],["أَنَّ الكِنانَةَ لا يَحومُ رَجاؤُها","إِلّا عَلى اِستِقلالِها المَأمولِ",36,"ل",1,0],["إن الكتابَ شريعةُ استقلالكم","فتدَّبروه وأنتم الخلفاءُ",37,"ا",2,0],["إِنَّ الكَريمَ مُخَلَّدٌ","وَحَياتُهُ مَعروفُهُ",38,"ف",2,0],["إِنَّ الكَريمَ لَتَخفى عَنكَ عُسرَتُهُ","حَتّى تَراهُ غَنِيّاً وَهوَ مَجهودُ",39,"د",1,0],["إِنَّ الكَرى في العَينِ يُحمَدُ وَالكَرى","عِندَ البُرى كَمَدُ الحِسانِ الأَنِّسِ",40,"س",1,0],["إنَّ الكواعِبَ إنْ رأَيْنكَ طاوِياً","وصْلَ الشبابِ طَويْنَ عنكَ وِصالا",41,"ل",2,0],["إن الكتاب هو المعل","لمُ وَالمسلي وَالمصاحب",42,"ب",1,0],["إِن الكرِيمَ إِذا نالته مَخْمَصَةٌ","أَبْدى إِلى الناسِ شِبْعاً وَهْوَ طَيَّانُ",43,"ن",1,0],["إِنَّ الكَرِيمَ إِذا ما ماتَ صاحِبُه","أَوْدَى بِهِ الوجْدُ وَالثُّكْلُ الطَّبِيعيُّ",44,"ي",1,0],["إنّ الكرامة والحرّية احتلفا","ولن يفارق حلف حلفه أبدا",45,"د",2,0],["إِنَّ الكَواكِبَ كُنَّ في فَلَكِ العُلا","يوددنَ لَو قَبَّلنَ مِنكَ الأَخمَصا",46,"ص",2,0],["إِنَّ الكِرامَ الغُرَّ مَهما أَنجبوا","شادوا بِناءَ المَجدِ بِالأَبناءِ",47,"ا",2,0],["إن الكنانة ظنَّتِ استقلالها","حُلمًا، فكنتَ لحلمها تأويلا",48,"ل",2,0],["إن الكنانة بايعتك، فكن لها","ظلاً -كما كان الجدود- ظليلا",48,"ل",2,0],["إنَّ الكنانَةَ يشتكي أبناؤها","إذ يطلبون العيش ضِيقَ مَجالِهِ",49,"ل",2,0],["إن الكريم إذا نابته مخمصة","أبدى إلى الناس شبعا وهو طيان",50,"ن",1,0],["أن الكلاب لتهتدي في مواطنها","والخلق ليس بهاد شرهم أبدا",51,"د",2,0],["إنّ الكواكبَ لا يشبهنَ صورتها،","وهنّ أسوأُ منها، بعدُ، أخبارا",52,"ر",2,0],["إن الكريم الحُرَّ من قومنا","لو مات جَوْعانا فلا يَطْلُبُ",53,"ب",1,0],["أنالك ما تؤمله","ولا همُّ ولا نصب",54,"ب",1,0],["إن الكبائر للطاعات مفسدةٌ","وإن أفسَدَهَا للطاعةِ الحسدُ",55,"د",1,1],["إن الكمالَ خصاله وكمالها","بكمالها وهو الأجلُّ المنتخب",56,"ب",1,0],["إِن الكريم مع الكريم ولم يكن","في سائرِ الكرما ليحيى ثان",57,"ن",1,0],["إن الكريم وإن تضعضع حاله","فالفعل منه لا يزال لطيفا",58,"ف",2,0],["إن الكبار أحق بال","فرح المصان من الصغار",59,"ر",1,0],["إن الكهولة لم تصدع فؤاد فتىً","يخافه الخلق من إنس ومن جان",60,"ن",1,0],["إنّ الكرى هجرته أجفاني وقد","باتت بحبس العين وفقَ هواك",61,"ك",1,0],["ان الكريم بنوه بعد مماته","خلفاؤه في الأمر أو حلفاؤه",62,"ا",3,0],["ان الكرام إلى ظهور","الخيل تدفعها البطون",63,"ن",1,0],["إن الكريمَ لهُ على أمثالهِ","حقُّ الإخاءِ فلي عليكَ حقوق",64,"ق",1,0],["إنّ الكتابةَ حرفةٌ قتَّالةٌ","فتحت لأربابِ النُّهى أجداثا",65,"ث",2,0],["إِنَّ الكُلابَ ماؤُنا فَخَلّواهُ","وَساجِراً وَاللَهِ لَن تَحُلّوهُ",66,"ه",1,1],["إِنَّ الْكِرامَ لِداءٍ كُلِّ مُلِمَّةٍ","أَعْيا عَلَى الْفَلَكِ الْعَلِيِّ دَواؤُهُ",67,"ا",3,0],["إِنَّ الْكَرِيمَ الْمَحْضَ سُؤْدَدُهُ","مَنْ لَمْ تَضِقْ بِوَفائِهِ حِيَلِي",68,"ل",2,0],["إن الكلام لفي الفؤا","د بطيها سر ظهر",69,"ر",1,0],["إن الكروب وكل خطب هائل","قد يممت سوح الفقير القاصر",70,"ر",1,0],["إنّ الكريمَ يقيل عثرة مثله","لا سيّما إن كان غير مريبِ",71,"ب",1,0],["إِنَّ الكَريمَ وَأَنتَ أَعلَمُ أَن يُعَدَّ","وَعداً عَلَيهِ نِجازُهُ لَن يَخلَفا",72,"ف",2,1],["إِنَّ الكَريمِ حَباكَ خَيرُ بُنيَةٍ","شَمسَ الهَناءِ أَمامَها مجلِّيَه",73,"ي",2,0],["إِنَّ الكَبائِرَ في الغُفرانِ كَاللِمَمِ","أَحكامُ رَبّي وَإِن تَجهَل مَراسِمَها",74,"ه",2,0],["إن الكنائسَ من حضورك ظاهراً","فيهن أضحت من يديك تُعان",75,"ن",1,0],["إن الكرام وإن تناءت دارهم","عني فإن القلب دار كرام",76,"م",1,0],["إِنَّ الكَنيسةَ لا تزال بهيَّةً","واليومَ في ذا الحِبر زاد بَهاؤُها",77,"ا",3,0],["إن الكرام إذا توفر حظهم","عطفوا به وتصدقوا وتبرروا",78,"ر",3,0],["اِن الكِرام اِذا ما أَسهَلوا ذَكَروا","مَن كانَ يَألَفَهُم بِالمَنزِلِ الخشنِ",79,"ن",1,0],["إنّ الكمالَ لَقَلّ ما","تَصْفو لِصاحبِه المشَاربْ",80,"ب",1,0],["إن الكتابة شأنُها","أعْزِزْ بهِ عندِي وأَعظِمْ",81,"م",1,1],["إن الكتابيين حكمهمُ الذي","قد مر لكن ثَمَّ شيء زائد",82,"د",1,0],["إنّ الكواكِبَ كُنَّ في أشرافِها","إلاّ عُطارِدَ حينَ صُوِّرَ آدَمُ",83,"م",1,0],["إنَ الكِرامَ إذا ما مسَّهُمْ سغبٌ","صالُوا صِيال لئامِ النَاسِ إن شبِعوا",84,"ع",3,0],["إِنَّ الكِتابة سارَت نَحوأَنمله","وَالجود فالتَقَيا فيهِ عَلى قَدرِ",85,"ر",1,0],["إِنَّ الكَواكِبِ في عُلُوِّ مَكانِها","لَتُرى صِغاراً وَهيَ غَيرُ صِغارِ",86,"ر",1,0],["إنَّ الكتاب الَّذي نظرتَ به","أبلَغُ ما ألَّفوه في الكتب",87,"ب",1,0],["إنَّ الكويت حماها الله قد بلغت","باليوسْفين مكان السَّبْعة الشُّهب",88,"ب",1,0],["أنا لك يا خالقي تائب","فما عذبت عصبة لك تابوا",89,"ب",3,0],["أنا لك تائبٌ فالتو","ب للغفران إقليد",90,"د",1,0],["إن الكؤوس من الولا","ء أحب من راح وجام",91,"م",1,0],["إن الكُفَاة لم يكن عميدَهم","في دائهم إلا الطبيبُ الحاسمُ",92,"م",1,0],["إن الكريم مَنْ قَرَى أضيافَهُ","ما يسَعُ الإمكانُ من إكرامها",93,"م",3,0],["إن الكرامَ درَستْ آثارُهم","فلم أطق ضبطاً لها بدرسِ",94,"س",1,0],["إِنَّ الكواعبَ والمآربَ والمُنى","نهضت بهن حوادثٌ ورواحل",95,"ل",1,0],["إن الكواكب في جلا","لتها وقوفٌ دون حدّك",96,"ك",1,0],["اِنَّ الكريمَ يرى ذكرَ الذين نأوا","وان أضاعوا عهودَ المنحنى ذِمَما",97,"م",2,0],["إن الكرام إذا سترت عيوبهم","بذلوا لك الأرواح في الشدت",98,"ت",1,0],["إن الكفالة والوزارة لم يزل","يومى إليك بفضلها ويشار",99,"ر",1,0],["إنّ الكرامَ على الجياد مَقيلُهم","فذَري الجيادَ لأهلها وتَعَطَّري",100,"ي",1,1],["إن الكمال هو الذي","حبل الوجود به انبرمْ",101,"م",1,0],["إن الكرام بحسن الظن قد شربوا","وسوء ظنك حرمانٌ لرقراق",102,"ق",1,0],["إنَّ الكريمَ الذي يَروي محامِدَهُ","حيّاً ومَيْتاً لسانُ النَّاسِ والقَلَمِ",103,"م",1,0],["إنَّ الكريمَ الذي لا مالَ في يَدهِ","مِثلُ الشُّجاعِ الذي في كَفِّهِ شَلَلُ",104,"ل",1,0],["إِنَّ الكَريم إِذا ما كانَ ذا كَذِب","شانَ التكرّمَ منه ذلك الكذِبُ",105,"ب",1,1],["إِنَّ الكَبيرَ إِذا طالَت زَمانَتُهُ","فَإِنَّما حَملُهُ جِنازَةً عارُ",106,"ر",1,0],["إِنَّ الكمال أَصابَ في مَحْبُوبَتي","لما أَصابَ بِعيْنِه عَيْنيْها",107,"ي",3,1],["إِن الكريمَ تُرى عَطا","ياه كِراماً غيرَ هُجْن",108,"ن",1,0],["أَنَا لَكَ المُتَمنِّي","وَغَيْرِيَ المُتَمَلِّي",109,"ل",2,0]]}