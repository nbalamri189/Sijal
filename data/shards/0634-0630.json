{"poems":[[53,"قربوهن ليبعدن المغارا","https://www.aldiwan.net/poem30447.html","الرمل"],[73,"سقى الغيث أطلال الأحبة بالحمى","https://www.aldiwan.net/poem11852.html","الطويل"],[27,"بان الخليط فعينه لا تهجع","https://www.aldiwan.net/poem5801.html","الكامل"],[37,"شذبته عنقفير سلتم","https://www.aldiwan.net/poem7200.html","المتقارب"],[51,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[45,"على الحي سرنا عنهم وأقاموا","https://www.aldiwan.net/poem65687.html","الطويل"],[44,"هل أثر من ديارهم دعس","https://www.aldiwan.net/poem30492.html","المنسرح"],[46,"يا أم دفر إنما أكرمت عن","https://www.aldiwan.net/poem22714.html","الكامل"],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[90,"الشاعرية","https://www.poetsgate.com/ViewPoem.aspx?id=650",""],[94,"النبع المسحور","https://www.poetsgate.com/ViewPoem.aspx?id=15631",""],[136,"تأمل رعاك الله حسن المواكب","https://www.aldiwan.net/poem49034.html","الطويل"],[271,"بكيت لباك واشتكيت لشاك","https://www.aldiwan.net/poem35624.html","الطويل"],[271,"تنزهت في روض خضيل مطلل","https://www.aldiwan.net/poem35662.html","الطويل"],[272,"أتأمرني بالصبر والطبع أغلب","https://www.aldiwan.net/poem52082.html","الطويل"],[378,"حلول حال أفرقنا مجالا","https://www.aldiwan.net/poem59176.html","الوافر"],[417,"ألما على لومي وجدا مجددا","https://www.aldiwan.net/poem54134.html","الطويل"],[501,"رأى حاسدي شأني فخامره عمى","https://www.aldiwan.net/poem37777.html","الطويل"],[560,"من لا مني لو أنه قد أبصرا","https://www.aldiwan.net/poem69362.html","الكامل"]],"verses":[["شَذَّبَت أَيدي اللَيالي مِنهُمُ","عَدَداً لا يَرأَمُ الضَيمَ كِثارا",0,"ر",2,0],["شَذا المِسكِ مِن أَردانِهِ يَتَضَوَّعُ","إِذا جِئتُ أَشكوهُ الجَوى لَيسَ يَسمَعُ",1,"ع",1,0],["شَذِبُ المَكارِبِ مِن جُذوعِ سُمَيحَةٍ","يَمطو الجَديلَ وَسُرطُمانٌ شَعشَعُ",2,"ع",1,0],["شَذَّبَته عنقفير سلتمُ","فبرت جسمانه حتى انحسرْ",3,"ر",1,1],["شذَّبتَ في دارِ الفناءِ أثيلَهُ","ليكون في دارِ البقاءِ أثيلا",4,"ل",2,0],["شَذاتِيَ مِن نَحوِ الصَديقِ كَليلَةُ ال","مُدى وَزِياراتي الصَديقَ لِمامُ",5,"م",1,0],["شَذَّبَ هَمّي بِهِ صَقيلٌ مِنَ ال","فِتيانِ أَقطارُ عِرضِهِ مُلسُ",6,"س",1,0],["شَذَّ التَقيُّ فَما يُقاسُ عَلى أَبي","ذُرٍّ وَشيمَتُهُ رِجالُ غِفارِ",7,"ر",1,0],["شُذَّاذُ أهلِ الأرضِ في","«حَيْفَا» أذلَّوا كلَّ كابر",8,"ر",1,0],["شذوذ الناس مُختلق ولكنْ","شذوذ الشاعر الفنان خَلْقُ",9,"ق",1,0],["شذاهما باق وإن غابتا","كأنّما فرعاك ريحانتان",10,"ن",1,0],["شذا عطره يهديك أو ضوءه إلى","حماه إذا أمسيت رهن الغياهبِ",11,"ب",1,0],["شذا الياسمين انبَثَّ مني فعبِّقي","شذا الوردِ كي يَلقى شذايَ شذاك",12,"ك",1,0],["شذا الحبِّ والسّلوى يُعطّر قلبها","ففي شمَّةٍ منه الكآبةُ تنجلي",13,"ل",2,0],["شذاها من الفَردوس مسك وَعَنبَر","عَلى غاية الوصفين أَذ فر أَشهَب",14,"ب",1,0],["شُذورُ كلامهم في سلك نظمٍ","يزيد نحور نائطها جمالا",15,"ل",2,0],["شذا ورد ذاك الوصل من روض قربكم","هزار اشتياقي كلما هب غردا",16,"د",2,0],["شَذا العِطرِ مِنَّا في الوُجوداتِ كلّها","ولكنَّما المَزْكومُ قد فاتَهُ الشَّمُّ",17,"م",1,0],["شَذت أمُورُ القوم عن عَاداتِهم","فَلأجل ذاك يقال سحر مُفترى",18,"ر",2,0]]}