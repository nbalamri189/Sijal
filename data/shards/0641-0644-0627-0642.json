{"poems":[[55,"سأصبر إن الصبر مر صدوره","https://www.aldiwan.net/poem30709.html","الطويل"],[65,"أدار بأكناف الحمى جادها الحيا","https://www.aldiwan.net/poem45799.html","الطويل"],[79,"دعاك بأقصى المغربين غريب","https://www.aldiwan.net/poem36715.html","الطويل"],[9,"يظن الناس بالملكي","https://www.aldiwan.net/poem21983.html","مجزوء الوافر"],[95,"عفوكم ما تقدمي إقدام","https://www.aldiwan.net/poem11087.html","الخفيف"],[85,"نجوم أمدتها بدور كوامل","https://www.aldiwan.net/poem54260.html","الطويل"],[29,"أقمنا وربتنا الديار ولا أرى","https://www.aldiwan.net/poem5798.html","الطويل"],[4,"ألا تسألان المرء ماذا يحاول","https://www.aldiwan.net/poem21189.html","الطويل"],[23,"عرفت ديار زينب بالكثيب","https://www.aldiwan.net/poem21247.html","الوافر"],[53,"سقيتن يا منزلات الهوى","https://www.aldiwan.net/poem8117.html","المتقارب"],[53,"أما الزمان إلى سلمى فقد جنحا","https://www.aldiwan.net/poem9264.html","البسيط"],[53,"يمن الله طلعة المولود","https://www.aldiwan.net/poem10079.html","الخفيف"],[53,"ليهنك لبس المهرجان وإن غدا","https://www.aldiwan.net/poem64568.html","الطويل"],[31,"شفى النفس قتلى من كليب وعامر","https://www.aldiwan.net/poem6094.html","الطويل"],[45,"آخر ما الملك معزى به","https://www.aldiwan.net/poem9512.html","السريع"],[45,"كدعواك كل يدعي صحة العقل","https://www.aldiwan.net/poem10137.html","الطويل"],[47,"وقوفك في أطلالهم وسؤالها","https://www.aldiwan.net/poem65564.html","الكامل"],[30,"كأن فريدة سفعاء راحت","https://www.aldiwan.net/poem5058.html","الوافر"],[30,"كفاك بحول من عزيز وقوة","https://www.aldiwan.net/poem5458.html","الطويل"],[101,"من مفكرة عاشق دمشقي","https://www.aldiwan.net/poem5856.html","عموديه"],[99,"أحقا كنت في قربي","https://www.aldiwan.net/poem24769.html","مجزوء الوافر"],[82,"إذا البدر يطوى في ربوع البلى لحدا","https://www.aldiwan.net/poem31479.html","الطويل"],[46,"حجى لحمى البطالة مستبيح","https://www.aldiwan.net/poem30057.html","الوافر"],[46,"ومحتكم في الخمص طورا وفي البدن","https://www.aldiwan.net/poem30095.html","الطويل"],[33,"ألا حي التي قامت","https://www.aldiwan.net/poem41300.html","الهزج"],[107,"أكانوا كلهم داء عياء","https://www.aldiwan.net/poem44053.html","الوافر"],[54,"ألا عللاني قبل أن يأتي الموت","https://www.aldiwan.net/poem27217.html","الطويل"],[69,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[69,"إلهي على كل الأمور لك الحمد","https://www.aldiwan.net/poem18053.html","الطويل"],[69,"وسلن حبقوق المصرح باسمه","https://www.aldiwan.net/poem18080.html","الكامل"],[77,"نظرت كما جلت عقاب على إرم","https://www.aldiwan.net/poem69035.html","الطويل"],[77,"أقول دمى وهي الحسان الرعابيب","https://www.aldiwan.net/poem69105.html","الطويل"],[48,"لقد آن أن يثني الجموح لجام","https://www.aldiwan.net/poem23643.html","الطويل"],[19,"تنكر بعدي من أميمة صائف","https://www.aldiwan.net/poem351.html",""],[19,"صحا قلبه عن سُكره فتأملا","https://www.aldiwan.net/poem356.html",""],[8,"خليلي غضا ساعة وتهجرا","https://www.aldiwan.net/poem21784.html","الطويل"],[8,"خليلي عوجا ساعة وتهجرا","https://www.aldiwan.net/poem21785.html","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/147515","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16684","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55267","المتقارب"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67298","المتقارب"],[111,"تلك البوارق حاديهن مرنان","https://www.poetsgate.com/ViewPoem.aspx?id=100",""],[79,"دعاكَ بأقصى المغربينِ غريبُ","https://www.poetsgate.com/ViewPoem.aspx?id=33820",""],[147,"كفى الدين عزا ما قضاه لك الدهر","https://www.aldiwan.net/poem11758.html","الطويل"],[154,"عجبا لمن ترك الحقيقة جانبا","https://www.aldiwan.net/poem68457.html","الكامل"],[154,"مديح نبي الله أزكى التعبد","https://www.aldiwan.net/poem68603.html","الطويل"],[164,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[173,"دع الكاعب الحسناء تهوي ركابها","https://www.aldiwan.net/poem1600.html",""],[189,"على الجانب الإسكندري سلام","https://www.aldiwan.net/poem14658.html","الطويل"],[190,"عظ النفس أن تصبو إلى شهواتها","https://www.aldiwan.net/poem44109.html","الطويل"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[239,"وأغيد ما عنه للصب صبر","https://www.aldiwan.net/poem32000.html","المتقارب"],[243,"فعالك تسهتوي القلوب فتطرب","https://www.aldiwan.net/poem23839.html","الطويل"],[247,"إني على رغم الوشاة لقائل","https://www.aldiwan.net/poem2053.html","الكامل"],[253,"ألا هل أتاها كيف ناوأ قومها","https://www.aldiwan.net/poem2097.html","الطويل"],[265,"طرف بكى وفؤاد أن من وصب","https://www.aldiwan.net/poem38369.html","البسيط"],[274,"أرى المرء يولد للنعمة","https://www.aldiwan.net/poem35048.html","المتقارب"],[274,"كفى الحر أن يشقى وأن يتألما","https://www.aldiwan.net/poem35217.html","الطويل"],[274,"تذكرت ما أبلى الزمان وما غير","https://www.aldiwan.net/poem35628.html","الطويل"],[275,"ذروني أبكي بعد جيرة ثهمد","https://www.aldiwan.net/poem52052.html","الطويل"],[275,"أنسمة طيب أم صبا طيبة هبا","https://www.aldiwan.net/poem52104.html","الطويل"],[284,"سوى باكيك من ينهى العذول","https://www.aldiwan.net/poem60710.html","الوافر"],[286,"إن الهوى إن كنت عنه تسأل","https://www.aldiwan.net/poem32675.html","الكامل"],[368,"سرى كما يسري القمر","https://www.aldiwan.net/poem60914.html","مجزوء الرجز"],[375,"والدهر ليس بمستجيز","https://www.aldiwan.net/poem57513.html","مجزوء الكامل"],[381,"رأينا من عهودِكم","https://www.aldiwan.net/poem59203.html","مجزوء الوافر"],[384,"بعينيه سحار يعلمني السحرا","https://www.aldiwan.net/poem49207.html","الطويل"],[407,"أهذا الذي في كأس نظمك قرقف","https://www.aldiwan.net/poem33638.html","الطويل"],[420,"هنيئا لكم هذا الهناء المجدد","https://www.aldiwan.net/poem54042.html","الطويل"],[423,"طربت وعناك الهوى والتطربُ","https://www.aldiwan.net/poem404.html",""],[425,"إليك مددت الكف في كل شدة","https://www.aldiwan.net/poem46388.html","الطويل"],[443,"سماء العلا منكم وأنت لها بدر","https://www.aldiwan.net/poem34843.html","الطويل"],[445,"أيا ليلى ويا ليت التلاقي","https://www.aldiwan.net/poem14315.html","الوافر"],[445,"بني راشد الزاكي ابن سالم","https://www.aldiwan.net/poem14480.html","الطويل"],[447,"جنى قوم على الدنيا","https://www.aldiwan.net/poem55978.html","عموديه"],[461,"كم النحت في جنبي والحز في متني","https://www.aldiwan.net/poem55835.html","الطويل"],[461,"في كل دار عدو لي أقاذعه","https://www.aldiwan.net/poem56117.html","البسيط"],[461,"نرق وتقسو بالغوير قلوب","https://www.aldiwan.net/poem56279.html","الطويل"],[464,"إذا كنت مضعوفا بأدنى فراقكم","https://www.aldiwan.net/poem16126.html","الطويل"],[467,"رويدك يا من تدعي شرف العلى","https://www.aldiwan.net/poem3407.html","عموديه"],[467,"أما وابتسام البرق في عابس الدجن","https://www.aldiwan.net/poem3514.html","عموديه"],[496,"ويوم كأن الدهر سامحني به","https://www.aldiwan.net/poem67368.html","الطويل"],[530,"ألا أبلغ بني شار كلامي","https://www.aldiwan.net/poem46020.html","الوافر"],[532,"نظام من الدر الثمين فرائده","https://www.aldiwan.net/poem37466.html","الطويل"],[532,"مسامع من ناديت يا عمرو سدت","https://www.aldiwan.net/poem37501.html","الطويل"],[544,"أقول لنفسي مرةً بعد مرةٍ","https://www.aldiwan.net/poem673.html",""],[561,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[566,"هو الموت عضب لا تخون مضاربه","https://www.aldiwan.net/poem13604.html","الطويل"],[616,"","https://poetry.dctabudhabi.ae/diwan/poem/200335","الطويل"],[722,"","https://poetry.dctabudhabi.ae/diwan/poem/29533","الطويل"],[766,"","https://poetry.dctabudhabi.ae/diwan/poem/31487","الوافر"],[1040,"","https://poetry.dctabudhabi.ae/diwan/poem/28452","الوافر"]],"verses":[["فَلا قَلبَ لي إِلّا وَأَنتَ حِجابُهُ","وَلا سِرَّ لي إِلّا وَذِكرُكَ حاجِبُه",0,"ب",2,0],["فَلاقاهُ فُرسانٌ تَلوحُ سيوفُهُم","صَباحاً وَلَيلُ النَّقعِ تَجثو غياهِبُهْ",1,"ب",2,0],["فَلاَ قَوْلَ إِلاَّ أَنَّةٌ وَتَوَجُّعٌ","وَلاَ حَوْلَ إِلاَّ زَفْرَةٌ وَنَجِيبُ",2,"ب",1,0],["فَلاقى المَوتَ مُكتَنِعاً","وَذُهلاً دونَ ما زَعَما",3,"م",2,0],["فَلاقَوا مَعشَراً أُنُفاً","غِضاباً أَحرَزوا الغَنَما",3,"م",2,0],["فلأقف للندى بحيث أشاروا","وليصيبوا من نجدتي ما راموا",4,"م",3,0],["فلاقى بها عقبان طير وراية","تُبيد الأعادي والرماحُ حبائلُ",5,"ل",1,0],["فَلا قَينَ شَرٌّ مِن أَبي القَينِ مَنزِلاً","وَلا لُؤمَ إِلّا دونَ لُؤمِكِ صَعصَعا",6,"ع",2,0],["فَلا قَصَبُ البَطحاءِ نَهنَهَ وِردَهُم","بِرِيٍّ وَلا العادِيُّ مِنهُ العُدامِلُ",7,"ل",1,0],["فَلاقَيناهُمُ مِنّا بِجَمعٍ","كَأُسدِ الغابِ مِن مُردٍ وَشيبِ",8,"ب",1,0],["فلا قُدِّستْ واسطٌ بلدةً","ولا جادها من سحابٍ رَوا",9,"ا",1,0],["فلاقحاتُ الأماني قد نُتِجْنَ به","وحائلات الأماني قد طوت لَقَحا",10,"ح",2,0],["فلأقلامِهِمْ صَريرٌ مَهيبٌ","يُزْدَرَى عنده زئيرُ الأُسُودِ",11,"د",1,0],["فلا قال والخَطِّيّ حولك بينه","فوارسه كالغيل فيه عَنابسه",12,"س",2,0],["فَلاقى عُمَيرٌ حَتفَهُ في رِماحِنا","وَما أَنتَ يا جَحّافُ عَنها بِهارِبِ",13,"ب",1,0],["فَلا قَضى حاجَتَهُ طالِبٌ","فُؤادُهُ يَخفِقُ مِن رُعبِهِ",14,"ب",2,0],["فَلا قَطَعَ الرَحمَنُ أَصلاً أَتى بِهِ","فَإِنّي رَأَيتُ الطَيِّبَ الطَيِّبَ الأَصلِ",15,"ل",1,0],["فَلاقُربَ إِلّا أَن يُعاوِدَ ذِكرُها","وَلاوَصلَ إِلّا أَن يُطيفَ خَيالُها",16,"ل",3,0],["فَلاقَت حَيثُ كانَ دَماً وَمَسكاً","حَديثَ العَهدِ قَد سَدِكَ الغُبارا",17,"ر",2,0],["فَلا قَومَ شَرٌّ مِنهُمُ غَيرَ أَنَّهُم","تَظُنُّهُمُ أَمثالَ تُركٍ وَكابُلِ",18,"ل",1,0],["فلا قميص من القمصان ألبسه","إلا وجدت على خيطانه عنبا",19,"ب",2,0],["فلا قلبي من الأرض","ولا جسدي من الطين",20,"ن",1,0],["فلا قابلٌ هجراً ولا مضمرٌ أذىً","ولا مخلفٌ وعداً ولا مانعٌ رفدا",21,"د",2,0],["فَلا قَلبٌ قَريحٌ قَلَّبَتهُ","نَوىً قَذَفٌ وَلا جَفنٌ قَريحُ",22,"ح",1,0],["فَلاقَتهُ أَبياتٌ تُناسِبُ وَجهَهُ","نَدَبتُ لَها فِكري وَأَخدَمتُها ذِهني",23,"ن",2,0],["فَلا قُربٌ لَها يَشفي","وَلَيسَ البُعدُ يُسلينا",24,"ن",2,0],["فلاقَت زَينبٌ قتلاً بقتلٍ","وما كانت لصاحبهم كِفَاءَ",25,"ا",2,0],["فَلاقَيتُهُ في مَنزِلٍ قَد أُعِدَّ لي","مَحَلّاً كَريماً لا يَرومُ فَأَقرَيتُ",26,"ت",1,0],["فلا قَوْلٌ وَلا عَمَلٌ لَدَيْهَا","بفاحِشَةٍ وَلا بِهَوىً مَشُوبُ",27,"ب",1,0],["فَلا قَبِلَ الرَّحْمنُ عُذْرَ عُداتِكم","فإنهم لا يَنْتَهُون وإنْ رُدُّوا",28,"د",3,0],["فَلأَقطَعَنَّ حِبالَ تَسْوِيفِي الّتي","مَنَعَت سِوَايَ إِلى حِماهُ وُصولا",29,"ل",2,0],["فلا قُلّةٌ شَهْبَاءُ إلاّ رَبَأتُهَا","ولا عَلَمٌ إلاّ رقَأتُ ذُرَى العَلَم",30,"م",1,0],["فلا قارعٌ إلاّ القنا السُّمرُ بالقنا","إذا قُرِعَتْ للحادثاتِ الظّنابيب",31,"ب",1,0],["فلا قوْلَ إلا الضّرْبُ والطّعْنُ عندنا","وَلا رُسْلَ إلا ذابِلٌ وحُسامُ",32,"م",1,0],["فَلاقى عَلَيها مِن صُباحَ مُدَمِّراً","لِناموسِهِ مِنَ الصَفيحِ سَقائِفُ",33,"ف",1,0],["فَلاقى اِمرَأً مِن مَيدَعانَ وَأَسمَحَت","قَرونَتُهُ بِاليَأسِ مِنها فَعَجَّلا",34,"ل",2,0],["فَلاَقَت بَياناً عِندَ أَحدَثِ مَعهَدٍ","إِهاباً وَمَعبُوطاً مِن الجَوفِ أَحمَرا",35,"ر",2,0],["فَلاَقَت بَياناً عِندَ أَوَّلِ مَربضٍ","إِهاباً وَمَعبوطاً مِن الجَوفِ أَحمَرا",36,"ر",2,0],["فلا قد أتانا كل ما هو زائل","ولكننا في عَالَم ليْسَ يَعْلَم!",37,"م",1,0],["فلا قِدَمُ الأيّامِ ألْبَسَ غَلْفَقاً","جِباها ولكنْ نارُ قَيْنٍ لها صال",38,"ل",1,0],["فَلأَقُلْ مَرَّةً لَكِ الحَقَّ فِي الوَجْ","هِ وَمَا بِي مُخَافَةَ التَّأْثِيمِ",39,"م",1,0],["فلاقاهُ عَبْدُ بَني نَوْفَلٍ","يُبرِبْرُ كالجَملِ الأَدْعَجِ",40,"ج",1,0],["فلا قصاص ولا أرش ولا قود","كأن لحم بني الاسلام جعلان",41,"ن",1,0],["فلا قول إلا أنة ٌ وتوجعٌ","ولا حول إلا زفرَة ٌ ونحيبُ",42,"ب",1,0],["فَلاقَيتُ بابَ الأَمنِ ما عَنهُ حاجِزٌ","يَصُدُّ وَبابَ العُرفِ ما دونَهُ سِترُ",43,"ر",1,0],["فلا قوةً عندي ولا لي حيلة","سوى حسن ظني بالجميل المواهب",44,"ب",1,0],["فَلا قَدرَ إِلّا دونَ قَدرِ مُحَمَّدٍ","تَضاءَلَتِ الأَقدارُ عَن قَدرِ سَيّدٍ",45,"د",1,0],["فلا قدس الرحمن شخصاً يحبه","على ما يرى من قبح هذي المخابر",46,"ر",1,0],["فَلاقى طِعاناً أَنكَرَتهُ حُماتُهُ","فَآبت عَلَيها ذُلُّها وَاِكتِئابُها",47,"ب",3,0],["فلا قربَ في الدنيا سوى أن يزورني","خيالٌ وهيهاتَ النَّوى ومَنام",48,"م",1,0],["فلا قلب لا فيه لذع ضريمة","ولا نفس إلا وهيَ في غمراتها",49,"ت",3,0],["فَلا قَدمٌ يَسعى بِها فهو مُقعدٌ","وَأقطع لا شبراً حواه ولا فترا",50,"ر",2,0],["فَلا قَصُرَت فيكَ آمالُنا","وَلا طالَ يَوماً لِشانيكَ عُمرُ",51,"ر",1,0],["فلاقاه في أقوامه ابن مساعد","فأفناهم قتلا أبا لسيف يلعب",52,"ب",1,0],["فَلاقى أَبا بِشرٍ عَلى الماءِ راصِداً","به مِن زَماعِ الصَيدِ وَردٌ وَأَفكَلُ",53,"ل",1,0],["فَلاقاهُمُ مِنّا بِدَمخٍ عِصابَةٌ","عَلى المُقرَباتِ الجُردِ فيها تَخابُلُ",54,"ل",1,0],["فلاقها بقبول تمسي آمنة","فإنها لم تكن تخلو من الرهب",55,"ب",1,0],["فلا قلبَ إلا وفيهِ هوى","ولا رأسَ خالٍ من الحكمة",56,"ه",1,0],["فلا قلَّ مالٌ في أكفٍّ سخيَّةٍ","رَأيتُ نداها نضرةً وتبسُّما",57,"م",2,0],["فلا قدرٌ أعمى ولا ربَّ منصفٌ","ولكنّه السرُّ الذي عَقلنا حيَّر",58,"ر",1,0],["فَلا قر قَلبي بل وَلا كف مدمعي","وَلا لذلي عيشي وَشربي وَمَرقَدي",59,"د",2,0],["فَلاقَت قُرَيش منه ايمن طائر","واسعد فأل واِنثَنى جدبها خصبا",60,"ب",2,0],["فَلا قَصُرَتْ عَوالِيكَ الأَعالِي","وَلا زالَ الزَّمانُ بها يَطُولُ",61,"ل",1,0],["فَلَأَقصُدَن مَلِكاً يَجودُ بِرِفدِهِ","لِلسائِلينَ وَوَجهُهُ يَتَهَلَّلُ",62,"ل",1,0],["فلا قَرارٌ إن زَأَر","ولا بقاءٌ إن هَصَر",63,"ر",1,0],["فلأقسمَنَّ الشكر ما","بين المناحِ إلى المنيحِ",64,"ح",1,0],["فلا قلتم ولا قلنا","كفى الفتنةَ ذكراها",65,"ا",3,0],["فَلا قَلب إِلّا في هَواهُ مُبلبلٌ","وَلا عَينٌ إِلّا مِن تَجنيهِ عَبرى",66,"ر",2,0],["فلاقاه شعري وهو شيخ على العصا","معانيه إن حققتها فهي تخرف",67,"ف",1,0],["فلا قَدْرَ يدنو قَدْرَه وعلاءه","ولم تَعْلُ في الدُّنيا على يده يد",68,"د",1,0],["فَلاقوا مِصاعاً مِن أُناسٍ كَأَنَّهم","أسودُ العَرينِ صادِقاً لا يُكَذِّبُ",69,"ب",1,0],["فلا قوةٌ عندي ولا لي حيلةٌ","سوى أن فقري للجميل المواهبِ",70,"ب",1,0],["فلا قَصَّرَ الرحمنُ عنكَ سيادَةً","تَمَلّأَها عُمْراً يُمَدُّ بِهِ عُمْرُ",71,"ر",1,0],["فلا قطعت حبال رجاء وصلي","ولا قصرت دونك عن متاق",72,"ق",1,0],["فلا قصصت منكم خوافي جناحكم","ولا حصصت منكم طوال القوادم",73,"م",1,0],["فلا قامت لأهل الشر","قائمة مدى المحيا",74,"ا",1,0],["فلا قلت يا نفسي بخلٍّ تأنسي","ويا كبدي حنّي إلى سكنٍ حنِّي",75,"ن",2,0],["فلا قرارَ لمالٍ أنت باذلُهُ","ولا انزعاجَ لثغرٍ أنت مانعُهُ",76,"ع",2,0],["فلا قَلَصتْ عني سحائبُ ظلِّكم","فمنها مُرِدٌّ تارة وسَكوبُ",77,"ب",1,0],["فلا قوْلَ إِلا وهو لِلُّدِّ قاطِعٌ","ولا جود إِلا وهو للسُّحب فاخِر",78,"ر",1,0],["فلا قرن الرحمنُ سعيك بالهدى","وفعلك بالحسنى وقصدك بالنُّجح",79,"ح",1,0],["فلا قلقُ الأحشاءِ عند رزيئةٍ","ولا فرحٌ إن جاءهُ الدَّهرٌ بالأمن",80,"ن",1,0],["فَلاقَيتُ مِلءَ العَينِ نُبلاً وَهِمَّةً","مَحَلّى السَجايا بِالطَلاقَةِ وَالبَشرِ",81,"ر",1,0],["فلا قر نصتموه فعلتموه","ولا خليتم عنه يصيدُ",82,"د",1,0],["فَلاَ قَدَّسَ الرَّحْمَنُ عَصْراً تَرَى بِهِ","جَهُولاً يعادِي الحقَّ ثُمَّ يُعانِدُهْ",83,"د",2,0],["فَلا قَوْلَ إلا ما تَقُولُ غَزيَّةٌ","وَلا رأْي إلا ما يَلوحُ لِعَزَّةِ",84,"ه",1,0],["فَلا قُدتُّ مِن أَقصى البَلادِ طَلائِعاً","وَلا عِشتُ مَحموداً وَعَيشي مُوَسَّعُ",85,"ع",1,0],["فلاقونا بترحيبٍ","وعنهم حالهم ترجمْ",86,"م",1,0],["فَلاقَيتُهُ لُقيا شَجٍ مُتَعَلِّلٍ","بِصِدقِ الأَماني والأَماني كَواذِبُه",87,"ب",2,0],["فلاقيته والخيل بيني وبينه","بأزرق مخشي الوقيعة باتك",88,"ك",1,0],["فَلا قَومَ إِلّا نَحنُ خَيرٌ سَياسَةً","وَخَيرٌ بِقِيّاتٍ بَقينَ وَأَوَّلا",89,"ل",2,0],["فَلاقَتهُ بِبلقَعَةٍ بَرازٍ","فَصادَمَ بَينَ عَينَيها الجَبوبا",90,"ب",2,0],["فَلاقَت فارِسٌ مِنّا نِكالاً","وَقَتَّلنا هَرابِذَ شَهرَزورِ",91,"ر",1,0]]}