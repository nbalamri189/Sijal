om/ViewPoem.aspx?id=129309",""],[4978,"تشطير لأبيات أستاذي محمد ذيب سليمان","https://www.poetsgate.com/ViewPoem.aspx?id=211981",""],[5002,"جائحةُ العصرِ.....","https://www.poetsgate.com/ViewPoem.aspx?id=211792",""],[4119,"لك الله إن حاربت فالنصر والفتح","https://www.poetsgate.com/ViewPoem.aspx?id=16107",""],[585,"خذوا بيدي فالدهر جاشت غواربه","https://www.poetsgate.com/ViewPoem.aspx?id=161927",""],[5106,"إعتذارٌ لعمرو بن كلثوم","https://www.poetsgate.com/ViewPoem.aspx?id=137303",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[5397,"أغاظ الدهر قدرك أن يسودا","https://www.poetsgate.com/ViewPoem.aspx?id=157926",""],[5431,"وفي معبد الطغيان كلٌّ مُذبّحُ...","https://www.poetsgate.com/ViewPoem.aspx?id=201517",""],[5431,"أمنية ....(ع)","https://www.poetsgate.com/ViewPoem.aspx?id=206102",""],[5776,"( لحى اليسار )","https://www.poetsgate.com/ViewPoem.aspx?id=199823",""],[5829,"البيت الحرام","https://www.poetsgate.com/ViewPoem.aspx?id=210657",""],[5953,"سئمت المقام بأرض الشّام","https://www.poetsgate.com/ViewPoem.aspx?id=93800",""],[6024,"الحاسد","https://www.poetsgate.com/ViewPoem.aspx?id=186346",""],[6125,"جِرَاحِي لا تُضَمِّدها الأمَانِي","https://www.poetsgate.com/ViewPoem.aspx?id=207908",""],[6152,"تعال الآن","https://www.poetsgate.com/ViewPoem.aspx?id=205875",""],[6213,"أفي السلم نحيا!!!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76302&r=&rc=50",""],[463,"نرقُّ وتقسو بالغوير قلوبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59978&r=&rc=34",""],[6327,"حكاية الأيام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86568&r=&rc=3",""]],"verses":[["فَلا قَلبَ لي إِلّا وَأَنتَ حِجابُهُ","وَلا سِرَّ لي إِلّا وَذِكرُكَ حاجِبُه",0,"ب",2,0],["فَلاقاهُ فُرسانٌ تَلوحُ سيوفُهُم","صَباحاً وَلَيلُ النَّقعِ تَجثو غياهِبُهْ",1,"ب",2,0],["فَلاَ قَوْلَ إِلاَّ أَنَّةٌ وَتَوَجُّعٌ","وَلاَ حَوْلَ إِلاَّ زَفْرَةٌ وَنَجِيبُ",2,"ب",1,0],["فَلاقى المَوتَ مُكتَنِعاً","وَذُهلاً دونَ ما زَعَما",3,"م",2,0],["فَلاقَوا مَعشَراً أُنُفاً","غِضاباً أَحرَزوا الغَنَما",3,"م",2,0],["فلأقف للندى بحيث أشاروا","وليصيبوا من نجدتي ما راموا",4,"م",3,0],["فلاقى بها عقبان طير وراية","تُبيد الأعادي والرماحُ حبائلُ",5,"ل",1,0],["فَلا قَينَ شَرٌّ مِن أَبي القَينِ مَنزِلاً","وَلا لُؤمَ إِلّا دونَ لُؤمِكِ صَعصَعا",6,"ع",2,0],["فَلا قَصَبُ البَطحاءِ نَهنَهَ وِردَهُم","بِرِيٍّ وَلا العادِيُّ مِنهُ العُدامِلُ",7,"ل",1,0],["فَلاقَيناهُمُ مِنّا بِجَمعٍ","كَأُسدِ الغابِ مِن مُردٍ وَشيبِ",8,"ب",1,0],["فلا قُدِّستْ واسطٌ بلدةً","ولا جادها من سحابٍ رَوا",9,"ا",1,0],["فلاقحاتُ الأماني قد نُتِجْنَ به","وحائلات الأماني قد طوت لَقَحا",10,"ح",2,0],["فلأقلامِهِمْ صَريرٌ مَهيبٌ","يُزْدَرَى عنده زئيرُ الأُسُودِ",11,"د",1,0],["فلا قال والخَطِّيّ حولك بينه","فوارسه كالغيل فيه عَنابسه",12,"س",2,0],["فَلاقى عُمَيرٌ حَتفَهُ في رِماحِنا","وَما أَنتَ يا جَحّافُ عَنها بِهارِبِ",13,"ب",1,0],["فَلا قَضى حاجَتَهُ طالِبٌ","فُؤادُهُ يَخفِقُ مِن رُعبِهِ",14,"ب",2,0],["فَلا قَطَعَ الرَحمَنُ أَصلاً أَتى بِهِ","فَإِنّي رَأَيتُ الطَيِّبَ الطَيِّبَ الأَصلِ",15,"ل",1,0],["فَلاقُربَ إِلّا أَن يُعاوِدَ ذِكرُها","وَلاوَصلَ إِلّا أَن يُطيفَ خَيالُها",16,"ل",3,0],["فَلاقَت حَيثُ كانَ دَماً وَمَسكاً","حَديثَ العَهدِ قَد سَدِكَ الغُبارا",17,"ر",2,0],["فَلا قَومَ شَرٌّ مِنهُمُ غَيرَ أَنَّهُم","تَظُنُّهُمُ أَمثالَ تُركٍ وَكابُلِ",18,"ل",1,0],["فلا قميص من القمصان ألبسه","إلا وجدت على خيطانه عنبا",19,"ب",2,0],["فلا قلبي من الأرض","ولا جسدي من الطين",20,"ن",1,0],["فلا قابلٌ هجراً ولا مضمرٌ أذىً","ولا مخلفٌ وعداً ولا مانعٌ رفدا",21,"د",2,0],["فَلا قَلبٌ قَريحٌ قَلَّبَتهُ","نَوىً قَذَفٌ وَلا جَفنٌ قَريحُ",22,"ح",1,0],["فَلاقَتهُ أَبياتٌ تُناسِبُ وَجهَهُ","نَدَبتُ لَها فِكري وَأَخدَمتُها ذِهني",23,"ن",2,0],["فَلا قُربٌ لَها يَشفي","وَلَيسَ البُعدُ يُسلينا",24,"ن",2,0],["فلاقَت زَينبٌ قتلاً بقتلٍ","وما كانت لصاحبهم كِفَاءَ",25,"ا",2,0],["فَلاقَيتُهُ في مَنزِلٍ قَد أُعِدَّ لي","مَحَلّاً كَريماً لا يَرومُ فَأَقرَيتُ",26,"ت",1,0],["فلا قَوْلٌ وَلا عَمَلٌ لَدَيْهَا","بفاحِشَةٍ وَلا بِهَوىً مَشُوبُ",27,"ب",1,0],["فَلا قَبِلَ الرَّحْمنُ عُذْرَ عُداتِكم","فإنهم لا يَنْتَهُون وإنْ رُدُّوا",28,"د",3,0],["فَلأَقطَعَنَّ حِبالَ تَسْوِيفِي الّتي","مَنَعَت سِوَايَ إِلى حِماهُ وُصولا",29,"ل",2,0],["فلا قُلّةٌ شَهْبَاءُ إلاّ رَبَأتُهَا","ولا عَلَمٌ إلاّ رقَأتُ ذُرَى العَلَم",30,"م",1,0],["فلا قارعٌ إلاّ القنا السُّمرُ بالقنا","إذا قُرِعَتْ للحادثاتِ الظّنابيب",31,"ب",1,0],["فلا قوْلَ إلا الضّرْبُ والطّعْنُ عندنا","وَلا رُسْلَ إلا ذابِلٌ وحُسامُ",32,"م",1,0],["فَلاقى عَلَيها مِن صُباحَ مُدَمِّراً","لِناموسِهِ مِنَ الصَفيحِ سَقائِفُ",33,"ف",1,0],["فَلاقى اِمرَأً مِن مَيدَعانَ وَأَسمَحَت","قَرونَتُهُ بِاليَأسِ مِنها فَعَجَّلا",34,"ل",2,0],["فَلاَقَت بَياناً عِندَ أَحدَثِ مَعهَدٍ","إِهاباً وَمَعبُوطاً مِن الجَوفِ أَحمَرا",35,"ر",2,0],["فَلاَقَت بَياناً عِندَ أَوَّلِ مَربضٍ","إِهاباً وَمَعبوطاً مِن الجَوفِ أَحمَرا",36,"ر",2,0],["فلا قد أتانا كل ما هو زائل","ولكننا في عَالَم ليْسَ يَعْلَم!",37,"م",1,0],["فلا قِدَمُ الأيّامِ ألْبَسَ غَلْفَقاً","جِباها ولكنْ نارُ قَيْنٍ لها صال",38,"ل",1,0],["فَلأَقُلْ مَرَّةً لَكِ الحَقَّ فِي الوَجْ","هِ وَمَا بِي مُخَافَةَ التَّأْثِيمِ",39,"م",1,0],["فلاقاهُ عَبْدُ بَني نَوْفَلٍ","يُبرِبْرُ كالجَملِ الأَدْعَجِ",40,"ج",1,0],["فلا قصاص ولا أرش ولا قود","كأن لحم بني الاسلام جعلان",41,"ن",1,0],["فلا قول إلا أنة ٌ وتوجعٌ","ولا حول إلا زفرَة ٌ ونحيبُ",42,"ب",1,0],["فَلاقَيتُ بابَ الأَمنِ ما عَنهُ حاجِزٌ","يَصُدُّ وَبابَ العُرفِ ما دونَهُ سِترُ",43,"ر",1,0],["فلا قوةً عندي ولا لي حيلة","سوى حسن ظني بالجميل المواهب",44,"ب",1,0],["فَلا قَدرَ إِلّا دونَ قَدرِ مُحَمَّدٍ","تَضاءَلَتِ الأَقدارُ عَن قَدرِ سَيّدٍ",45,"د",1,0],["فلا قدس الرحمن شخصاً يحبه","على ما يرى من قبح هذي المخابر",46,"ر",1,0],["فَلاقى طِعاناً أَنكَرَتهُ حُماتُهُ","فَآبت عَلَيها ذُلُّها وَاِكتِئابُها",47,"ب",3,0],["فلا قربَ في الدنيا سوى أن يزورني","خيالٌ وهيهاتَ النَّوى ومَنام",48,"م",1,0],["فلا قلب لا فيه لذع ضريمة","ولا نفس إلا وهيَ في غمراتها",49,"ت",3,0],["فَلا قَدمٌ يَسعى بِها فهو مُقعدٌ","وَأقطع لا شبراً حواه ولا فترا",50,"ر",2,0],["فَلا قَصُرَت فيكَ آمالُنا","وَلا طالَ يَوماً لِشانيكَ عُمرُ",51,"ر",1,0],["فلاقاه في أقوامه ابن مساعد","فأفناهم قتلا أبا لسيف يلعب",52,"ب",1,0],["فَلاقى أَبا بِشرٍ عَلى الماءِ راصِداً","به مِن زَماعِ الصَيدِ وَردٌ وَأَفكَلُ",53,"ل",1,0],["فَلاقاهُمُ مِنّا بِدَمخٍ عِصابَةٌ","عَلى المُقرَباتِ الجُردِ فيها تَخابُلُ",54,"ل",1,0],["فلاقها بقبول تمسي آمنة","فإنها لم تكن تخلو من الرهب",55,"ب",1,0],["فلا قلبَ إلا وفيهِ هوى","ولا رأسَ خالٍ من الحكمة",56,"ه",1,0],["فلا قلَّ مالٌ في أكفٍّ سخيَّةٍ","رَأيتُ نداها نضرةً وتبسُّما",57,"م",2,0],["فلا قدرٌ أعمى ولا ربَّ منصفٌ","ولكنّه السرُّ الذي عَقلنا حيَّر",58,"ر",1,0],["فَلا قر قَلبي بل وَلا كف مدمعي","وَلا لذلي عيشي وَشربي وَمَرقَدي",59,"د",2,0],["فَلاقَت قُرَيش منه ايمن طائر","واسعد فأل واِنثَنى جدبها خصبا",60,"ب",2,0],["فَلا قَصُرَتْ عَوالِيكَ الأَعالِي","وَلا زالَ الزَّمانُ بها يَطُولُ",61,"ل",1,0],["فَلَأَقصُدَن مَلِكاً يَجودُ بِرِفدِهِ","لِلسائِلينَ وَوَجهُهُ يَتَهَلَّلُ",62,"ل",1,0],["فلا قَرارٌ إن زَأَر","ولا بقاءٌ إن هَصَر",63,"ر",1,0],["فلأقسمَنَّ الشكر ما","بين المناحِ إلى المنيحِ",64,"ح",1,0],["فلا قلتم ولا قلنا","كفى الفتنةَ ذكراها",65,"ا",3,0],["فَلا قَلب إِلّا في هَواهُ مُبلبلٌ","وَلا عَينٌ إِلّا مِن تَجنيهِ عَبرى",66,"ر",2,0],["فلاقاه شعري وهو شيخ على العصا","معانيه إن حققتها فهي تخرف",67,"ف",1,0],["فلا قَدْرَ يدنو قَدْرَه وعلاءه","ولم تَعْلُ في الدُّنيا على يده يد",68,"د",1,0],["فَلاقوا مِصاعاً مِن أُناسٍ كَأَنَّهم","أسودُ العَرينِ صادِقاً لا يُكَذِّبُ",69,"ب",1,0],["فلا قوةٌ عندي ولا لي حيلةٌ","سوى أن فقري للجميل المواهبِ",70,"ب",1,0],["فلا قَصَّرَ الرحمنُ عنكَ سيادَةً","تَمَلّأَها عُمْراً يُمَدُّ بِهِ عُمْرُ",71,"ر",1,0],["فلا قطعت حبال رجاء وصلي","ولا قصرت دونك عن متاق",72,"ق",1,0],["فلا قصصت منكم خوافي جناحكم","ولا حصصت منكم طوال القوادم",73,"م",1,0],["فلا قامت لأهل الشر","قائمة مدى المحيا",74,"ا",1,0],["فلا قلت يا نفسي بخلٍّ تأنسي","ويا كبدي حنّي إلى سكنٍ حنِّي",75,"ن",2,0],["فلا قرارَ لمالٍ أنت باذلُهُ","ولا انزعاجَ لثغرٍ أنت مانعُهُ",76,"ع",2,0],["فلا قَلَصتْ عني سحائبُ ظلِّكم","فمنها مُرِدٌّ تارة وسَكوبُ",77,"ب",1,0],["فلا قوْلَ إِلا وهو لِلُّدِّ قاطِعٌ","ولا جود إِلا وهو للسُّحب فاخِر",78,"ر",1,0],["فلا قرن الرحمنُ سعيك بالهدى","وفعلك بالحسنى وقصدك بالنُّجح",79,"ح",1,0],["فلا قلقُ الأحشاءِ عند رزيئةٍ","ولا فرحٌ إن جاءهُ الدَّهرٌ بالأمن",80,"ن",1,0],["فَلاقَيتُ مِلءَ العَينِ نُبلاً وَهِمَّةً","مَحَلّى السَجايا بِالطَلاقَةِ وَالبَشرِ",81,"ر",1,0],["فلا قر نصتموه فعلتموه","ولا خليتم عنه يصيدُ",82,"د",1,0],["فَلاَ قَدَّسَ الرَّحْمَنُ عَصْراً تَرَى بِهِ","جَهُولاً يعادِي الحقَّ ثُمَّ يُعانِدُهْ",83,"د",2,0],["فَلا قَوْلَ إلا ما تَقُولُ غَزيَّةٌ","وَلا رأْي إلا ما يَلوحُ لِعَزَّةِ",84,"ه",1,0],["فَلا قُدتُّ مِن أَقصى البَلادِ طَلائِعاً","وَلا عِشتُ مَحموداً وَعَيشي مُوَسَّعُ",85,"ع",1,0],["فلاقونا بترحيبٍ","وعنهم حالهم ترجمْ",86,"م",1,0],["فَلاقَيتُهُ لُقيا شَجٍ مُتَعَلِّلٍ","بِصِدقِ الأَماني والأَماني كَواذِبُه",87,"ب",2,0],["فلا قوة ترجى لدفع كريهة","دهتك ولا طب لصدعك يجبر",88,"ر",1,0],["فَلاقَيتَهُ كالسَّيفِ ما فيكَ نَبوَةٌ","وَفي كُلِّ سَيفٍ نَبوَةٌ وَتَثَلُّمُ",89,"م",1,0],["فَلاقَوا بِحَربِكَ يَومَ الحِسابِ","وألجَمتَ أفواهَهُم بالعَرَق",90,"ق",1,0],["فَلا قاطِعٌ حَبلاً لِمَن هوَ واصِلٌ","وَلا واصِلٌ حَبلاً لِمَن هُوَ يَقطَعُ",91,"ع",1,0],["فلاقيته والخيل بيني وبينه","بأزرق مخشي الوقيعة باتك",92,"ك",1,0],["فلاقى خطيباً بالخرافات واعظاً","فصاح به اسكت إن ما قلته كفر",93,"ر",1,0],["فلاقانا وكفُّ الصب","حِ دونَ الليل مَكفوفه",94,"ف",2,0],["فلاقَتْ سماءَ الجودِ يَنشو سحابُها","ووافَتْ رياضَ المجدِ يبدو ربيعها",95,"ع",3,0],["فَلاقاهُ جَذلاناً وَجادَ بِنَفسِهِ","وَإِنَّ كَريمَ النَّفسِ مَنْ جادَ بِالنَّفسِ",96,"س",1,0],["فَلاقي أُسَيدٌ يَومَ ذَلِكَ حَتفَهُ","وَقَطَّرَهُ مِنّا فَتىً غَيرُ جَأنَبِ",97,"ب",1,0],["فَلاقوا بِعَينِ الوَردَةِ الجَيشَ فاصِلاً","إِلَيهِم فَحَسّوهُم بِبيضٍ قَواضِبِ",98,"ب",1,0],["فلا قُوت إلاَّ إن ندى فضله سما","ولا موت إلا أن ردى نصله همى",99,"م",2,0],["فَلا قِصَرٌ يشين قوا","مها فيها ولا طولُ",100,"ل",1,0],["فلاقته فرسانُ المنايا مغيرةً","نواخيذ أبطالٍ من الأسدِ أَجسرُ",101,"ر",1,0],["فلا قُرْبُكمُ لا زالَ عنِّي يَمَلُّني","ولا بُعْدُكُمْ حاشايَ مِنْ بَعْدِكُمْ يُسْلي",102,"ل",2,0],["فلاقَينَ مولانا وقد صَنَعَ السُّرى","بهنَّ صنيع كفه بِتَلادهَا",103,"د",3,0],["فَلاَقُوا بِيَ الأَعْدَاءَ فِي زَحْفِهِمْ وَلاَ","تُبَالُوا بِقَرْعِ الزُّرْقِ وَالْبِيضِ وَالسُّمْرِ",104,"ر",1,0],["فَلا قَومَ إِلّا نَحنُ خَيرٌ سَياسَةً","وَخَيرٌ بِقِيّاتٍ بَقينَ وَأَوَّلا",105,"ل",2,0],["فلا قلتُ بعدك للعيشِ طب","ولا قلتُ بعدك للسحب جودي",106,"د",2,0],["فلا قربى رعيتم من قريب","ولا للعرف أنتم شاكرونا",107,"ن",2,0],["فَلاقَتهُ بِبلقَعَةٍ بَرازٍ","فَصادَمَ بَينَ عَينَيها الجَبوبا",108,"ب",2,0],["فلا قال وصفاً حيدر ليس يوصف","فكم رامه قوم فأعيا وكفكفوا",109,"ف",3,1],["فلا قَصرَ حتى يفرجَ الغيثَ من أوى","إلى جَنبِ رَحلي كلُّ أَشعَثَ أغبَرِ",110,"ر",1,0],["فَلاقَاهُ من وَالاكَ كَالزَّهرِ بَاسِماً","وَواجَهَ مَنْ عَاداكَ في غايَةِ القُبْحِ",111,"ح",1,0],["فَلاقَى عَبِيداً في حِمَاها فَدَاسَها","وَخَلَّفَهَا تُصْغِي لِصَوْتِ النَّوَاعِبِ",112,"ب",1,0],["فَلا قَضى كَلِفٌ نحبا فأوجعني","إن قيل إنَّ المحبَّ المُستهام قَضى",113,"ض",2,0],["فَلا قَدَّسَ اللَهُ الزَمانَ مَحَلّهُ","وَلا زالَ عَنهُ نافِعُ الغَيثِ يُصرَفُ",114,"ف",1,0],["فلا قلمي يعاني ما يعاني","من السلوى ولا يشكو حسامي",115,"م",2,0],["فلاقوا بها تلك التلاع لعلّني","أبلّ بها حرا تضمّنه صدري",116,"ر",2,0],["فَلا قام للهيجاء سوق حفيظة","تباع بها نفس الكَريم وَتَشتَري",117,"ر",2,0],["فلاقوا لدى عمرو قرىً ليس أنياً","حزاز حديث الصفل أبيض مقصب",118,"ب",1,0],["فلا قت عذاباً هوَّن الموتَ بعضه","بما وردت من شرعة الذل موردا",119,"د",2,0],["فلاق على جد بنصرك إنني","ذكرتك فاسودت غصون المحالك",120,"ك",1,0],["فلا قدس اللّه أمرأ ظن أنني","أراجع أيام الغنا وهو عالم",121,"م",1,0],["فلا قصدي بلغت ولا مرادي","ولم أحصل على غير إلا ضاعه",122,"ع",2,0],["فلا قد قلت للأيام عودي","وان عادت فعين او طليعه",123,"ع",2,0],["فلاقى عليٌّ ما لقي من جموعهم","وأصحابه باتوا يلاقون ما لاقى",124,"ق",2,0],["فلا قال لي في نجاحي بخٍ","ولا قال لي في عثاري لعا",125,"ع",2,0],["فلاقت كتابي في الطريق كتائب","من السحب روى قطرها السهل والوعرا",126,"ر",2,0],["فَلا قدس الرَحمن دَهراً أَصابه","وَسَهماً رَماه بِالمَنية عَن عَمد",127,"د",1,0],["فلأقرَعنَّ صفاةَ دهرٍ نابَهُم","قَرعاً يهُدُّ رواسيَ الأعلامِ",128,"م",1,0],["فلاقتهُ أملاكُ السّموات بالرّحب","بنيٌّ إلى السّبع السّماوات قد سرى",129,"ر",2,0],["فلاقيت موعظة لا تزال","تبقى لأيامك الغابرة",130,"ر",2,0],["فلا قدر ولا في الدين جبر","بلى كسب شرحت به المقالا",131,"ل",2,0],["فلأقصدنّك بالنصيحة والذي","حجَّ الحجيجُ إليه فاقبل أودعِ",132,"ع",1,0],["فلأقطَعَنَّ من الهَوى أَعلاقه","أَو يَشتَفي داءٌ لَديَّ دَخيلُ",133,"ل",1,0],["فلا قُطْرَ إلا وهو يبْغيكَ مالِكاً","ولا قَطْرَ إلا عن سحابِكَ ينْشأُ",134,"ا",1,0],["فلاقيتهم يوماً على فطرية","وللعيس مما في الخدور دليحُ",135,"ح",1,0],["فَلا قَد عِشتُ إِن قَلبي سَلاهُ","وَعن ذِكراهُ يَوماً اِن تَلاهى",136,"ه",2,0],["فَلاقاهُ بِاِجلال وَأُنس","وَانزَلَهُ عَلى صَرح مَشيد",137,"د",1,0],["فَلاقَت فارِسٌ مِنّا نِكالاً","وَقَتَّلنا هَرابِذَ شَهرَزورِ",138,"ر",1,0],["فلاق هامات الكماة إذا سرى","يوم الوغى في جحفل زحاف",139,"ف",1,0],["فلَأَقصِدَنَّ من العِراقِ نُسورُها","ما دام أَجدَلُ ارض جِلِّقَ يَشؤُمُ",140,"م",1,0],["فَلا قَلب إِلا بِالمَسرات عامر","وَلا عَين إِلا من بَهاً في تَزايد",141,"د",1,0],["فلا قدس الرحمن حزباً قلوبهم","وأقلامهم عن مهيع الحق آبقه",142,"ق",2,0],["فَلا قَتَدٌ إِلّا شَواهُم سُتورُهُ","وَلا مَسدٌ إِلّا طُلاهُم شِعارُهُ",143,"ر",2,0],["فَلا قَلبَ إِلّا وَهوَ دامٍ مُفجّع","وَلا دَمع إِلّا وَهوَ مُنهَمل سَكبُ",144,"ب",1,0],["فَلا قُرب إِلّا أن يُخيِّلهُ الكَرى","وَلا وَصل إِلّا أَن يَسهّله الفكرُ",145,"ر",1,0],["فلاقه بكؤوس الراح مترعة","شكراً له فكريم القوم من شكرا",146,"ر",2,0],["فَلا قُوَّةٌ لِاِلتِقاطِ الزِجاجِ","وَلا لِفِرارٍ بِذاكَ العَجاجِ",147,"ج",1,0],["فَلا قَدِيمَ غَيرُ ذِى الجَلاَلِ","نَنسأَلُهُ الأَمنَ مِنَ الضَّلاَلِ",148,"ل",1,0],["فلاقى نِكالاً حيث طيَّرَ رأسه","حسامٌ يريه الموت ساعة يُشهَرُ",149,"ر",1,0],["فلأقدْحنَّ البرق من نار الحشا","ولأخلعنَّ على النجوم نحولي",150,"ي",1,0],["فَلا قَلبٌ يُبَصَّرُ كُلَّ ذَنبٍ","وَلا راضٍ بَغيرِ رِضاً غَضوبُ",151,"ب",1,0],["فلا قر قلبي ساكناً في مكانهِ","ولا كان منسوباً إلى غيرهِ الوجدُ",152,"د",1,0],["فلاقته بسعف النخل شوقاً","ملائكةٌ وأطفالٌ صِغار",153,"ر",1,0],["فلا قبسٌ يضيءُ لنا طريقاً","سوى قبسِ اتِّباعِ المرسلينا",154,"ن",2,0],["فلا قصد لي والقصد لي ترك رؤيتي","بقصدي وليس الترك عندي محرما",155,"م",2,0],["فلا قبلي ابن انثى صحيح العقل او مسحور","رئا ماقد رأيت فلا رئا قبلي بن انسيه",156,"ي",2,0],["فلاقوه بإكرام","ومنه نلتمو المنحا",157,"ح",2,0],["(فلا قُدسًا ولا عمّانَ أرضى)","(وإن كرُما فلا أرضى الضفافا)",158,"ف",2,0],["فلا قُوَّةً دامتْ وربِّي عظِيمُنا","له بشَرٌ ساروا وذا الَعَبْدُ عائِثُُ",159,"ث",1,0],["فلا قُوَّةً إلا بربِّي لَهُ الوَرى","مشِيئتُه علمٌ ونحنُ العوابثُ",159,"ث",1,0],["فلا قلب إلا قد تملكته هوى","ولا صدر إلا قد جلاه لك النصح",160,"ح",1,0],["فلا قلب إلا والظنون شغافه","ولا صدر وإلا والحقود ترائبه",161,"ب",2,0],["فَلَاْ قَيْسٌ وَلَاْ لَيْلَىْ تَلَاْقَوْاْ","وَلَاْ هِنْدٌ وَلَاْ دَعْدٌ بَقِيْنَاْ",162,"ن",2,0],["فلا قادني حبل الهوى بتعسف","لأتبعه كل مال واعتدل",163,"ل",1,0],["فلا قرت من الإسلام عين","ولا نظرت بطلعتها السعودا",164,"د",2,0],["فلا قيمة الإنسان باتت بأُنسه","ولا عدله عدلٌ ولا الحبَ يمنحُ!!",165,"ح",1,0],["فلا قلقٌ على ايقاع بحرٍ","ولا طعم الحروف يصير مرّا",166,"ر",2,0],["فلا قصفَ في صنعاءَ لا انهارَ منزلٌ","ولكنهم ماتوا بتأثير (راجعِ)",167,"ع",1,0],["فلا قيم تسود ولا حساب","وسيف الظلم في الاعناق جائر",168,"ر",1,0],["فلا قدس الله أرواحهم","وتقّلهم في جلود الزّوام",169,"م",1,0],["فلا قدمي تسعى لغير جمائل","ولا قلمي يجري بغير فوائد",170,"د",1,0],["فلا قَلبِي سِوَاكِ هَوَى خَلِيلًا","بِحَقِّ اللَّهِ في السَّبعِ المَثَانِي",171,"ن",2,0],["فلا قلبي اطمئن ولا شعوري","هدا يوما , ولا أواه طيف",172,"ف",1,0],["فلا قلب يجاري ما يجارى","ولا نفع يعود ولا مزية",173,"ي",2,0],["فلا قلصتْ عني سحائبُ ظلكم","فمنها مرذٌّ تارة وسكوبُ",174,"ب",1,0],["فَلا قدمٌ تَسيرُ إلى الأَماني","ولا خَصمٌ لهُ قَلبٌ منيبُ",175,"ب",1,0]]}