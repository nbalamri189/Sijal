diwan/poem/145769","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48210","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53226","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53150","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53050","الخفيف"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137172",""],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129900","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62991","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139624",""],[5136,"يا لها قبة تلألأ نورا","https://www.poetsgate.com/ViewPoem.aspx?id=121549",""],[5582,"سَلْ بُرْقَةَ العَلَمَيْنِ ثُمَّ البانا","https://www.poetsgate.com/ViewPoem.aspx?id=187309",""],[5582,"هذِي بِشاراتُ السُّرُورِ تَراها","https://www.poetsgate.com/ViewPoem.aspx?id=187331",""],[5582,"أَسْيانُ ما فِي الأَيْكِ ناحَ حَمامُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=63573",""],[6031,"ماذا يفيدُكَ من سؤالِ الأَرْبُعِ","https://www.poetsgate.com/ViewPoem.aspx?id=46253",""]],"verses":[["مَلِكٌ راحَتُهُ بَحرُ النَدى","مِثلَما غُرَّتُهُ بَدرُ النَدِيّ",0,"د",2,0],["ملك رأيت الشهب ثمَّ رأيته","فوجدته أعيى على المتطاول",1,"ل",1,0],["مُلكٌ رَعَيتَ اللَهَ فيهِ مُؤَيَّداً","بِاِسمِ النَبِيِّ مُوَفَّقاً مَسعاكا",2,"ك",2,0],["مَلِكٌ رُحِمتَ بِقُربِهِ وَجِوارِهِ","حَتّى كَأَنَّكَ لِلعِنايَةِ جارُ",3,"ر",1,0],["مَلِكٌ راحَتاهُ أَحنى عَلى العا","فينَ مِن والِدٍ وَمِن مَولودِ",4,"د",1,0],["مَلِكٌ رِضاهُ رِضا المَليكِ وَسُخطُهُ","حَتفُ العِدى وَرَداهُمُ المُتَوَقَّعُ",5,"ع",1,0],["مَلِكٌ رَجَوْتُ نَوالَه فوجدتُه","كَثَباً على الرَّاجينَ غيرَ قَذيفِ",6,"ف",1,0],["مَلِكٌ رَعَى الدنْيا رعايةَ حازمٍ","وأظلّ دينَ اللَّه منه جَناحُ",7,"ح",1,0],["مَلِكٌ رِضَاهُ رِضا المُلُوكِ، وَسُخطُه","حَتْفُ العِدى، وَرَداهُمُ المُتَوَقَّعُ",8,"ع",1,0],["ملك رَعيتهُ القُلو","ب غَدَت لَهُ طَوع اليَد",9,"د",1,0],["مَلِكٌ رِياضُ ثَرائِهِ مَرعِيَّةٌ","كَرَماً وَرَوضُ عَلائِهِ لا يُرتَعا",10,"ع",2,0],["ملك رسولي نمته خلائف","ملكوا البرية قبل تبّع أدهرا",11,"ر",2,0],["مَلِكٌ رَمى بِجُنودِهِ أَبراجَها","فَكَبَت عَلى الأَذقانِ كَبوَ المعتَسِ",12,"س",1,0],["مَلِكٌ رَبوبِيُّ الجَلالِ تَحفُّه","أنوارُ عُلْوِيِّ الخِلالِ مُؤَيَّد",13,"د",1,0],["ملك رأى الله أن الحق ركبّه","فيه فملّكه الأرضين والأمما",14,"م",2,0],["ملك رسا وأنافت جانباه علا","أضحت به وبك الأيام مفتخر",15,"ر",1,0],["مُلْكُ ربِّي هو فيه مالِكٌ","رغمَ مَن قدْ مُلِكُوا أَو مَلَكُوا",16,"ك",3,0],["مَلِكٌ رَبيطُ الجأشِ عدْل محسنٌ","حسنُ المقالةِ صادقُ الكلمات",17,"ت",1,0],["ملك رب المعالي","محكم المجد رصين",18,"ن",1,0],["ملك رعاياه بمن","جاه ومرعاه أنيس",19,"س",1,0],["ملك رقود الحلم يقظان السطا","حلو الرضا مر العداوة أَصَيدُ",20,"د",1,0],["ملك رزين الحلم منتقم","غير أن طبع مجتني المرعى",21,"ع",2,0],["مَلِكٌ رَأيْتُ الشهبَ ثُمَّ رَأيْتُهُ","فَوَجَدْتُهُ جِسْماً وَهُمْ أسْمَاءُ",22,"ا",2,0],["ملكٌ رَقى رتبَ العلا حتّى دنا","عمّا اِرتقاه منَ العُلا بهرامهُ",23,"م",2,0],["ملك رئيسٌ امبراطورٌ وسل","طانٌ وقائد عصبة والشاه",24,"ا",2,0],["ملك رآه الله أفضل خلقه","فحباه من رتب العلا بالأفضل",25,"ل",1,0],["ملكٌ رأيُهُ المشير لدى الرَّو","عِ وفي كفِّهِ الحسامُ الوزيرُ",26,"ر",1,0],["ملك ردنا لإحراز مجدٍ","فنأى عن مداه كل مُدَان",27,"ن",1,0],["ملك رمته النائبات فأثبتت","سهم الردى في مقتل الملك الخفي",28,"ف",2,0],["ملك راجح الحيا حُبُّه لل","ه يثني الوليَّ عن كل حوبِ",29,"ب",1,0],["ملك رأينا الدهر طوع بنانه","يجثو لديه مثل عبد شاك",30,"ك",1,0],["ملكٌ رأينا الفتح يلزمُ لامهُ","والجمعُ من أعدائه متكسّرا",31,"ر",2,0],["ملكٌ رأى الاحسانَ من","عُددِ العواقبِ فاستعدَّا",32,"د",2,0],["ملك رعيته الملوك وقد رعى","فيه الإله مواليا وعبيدا",33,"د",2,0],["ملك راسخ الدعائم راس","باذخ شامخ البنا لا يسيح",34,"ح",1,0],["مَلِكٌ رَقا رُتَباً عَلَتْ حَتَّى عَلا","رُتَباً عَلا بِعُلُوِّهِ كَيْوانا",35,"ن",2,0],["مَلِكٌ رَقا رُتَبَ العُلا حَتَّى انْتَهَى","أَعْلَى المَعالِي فاصْطَفَى أَعْلاها",36,"ا",3,0],["مَلِكٌ رَقا رُتَبَ العُلا حَتَّى دَنا","عَمَّا ارْتَقاهُ مِنَ العُلا بَهْرامُهُ",37,"م",2,0],["مَلِكٌ رَقَى دَرَجَ الفخارِ فلم يَدَعْ","فيها لراقٍ بَعْدَهُ من مَطْمَعِ",38,"ع",1,0]]}