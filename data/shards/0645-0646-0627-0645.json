4935,"ملك الجمال اليوسفي السامي الاغن","https://www.poetsgate.com/ViewPoem.aspx?id=129502",""],[5022,"ألقمرية","https://www.poetsgate.com/ViewPoem.aspx?id=200597",""],[585,"لمع اللجين وسال ذوب العسجد","https://www.poetsgate.com/ViewPoem.aspx?id=161875",""],[5111,"عَشْتَارُ","https://www.poetsgate.com/ViewPoem.aspx?id=212606",""],[5122,"أهني إنسان\"","https://www.poetsgate.com/ViewPoem.aspx?id=33177",""],[5122,"(غني الاوأدم ما تكفل أبمفلسها)","https://www.poetsgate.com/ViewPoem.aspx?id=34736",""],[5155,"الوحده العربيه","https://www.poetsgate.com/ViewPoem.aspx?id=176192",""],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""],[5277,"عمر الفلسطيني","https://www.poetsgate.com/ViewPoem.aspx?id=203579",""],[5351,"القادم أولاً وثانياً","https://www.poetsgate.com/ViewPoem.aspx?id=202236",""],[5376,"ياأمتي خبا النفيرُ فاسمعي","https://www.poetsgate.com/ViewPoem.aspx?id=188498",""],[5425,"أَوفَيتَ عَهْدَكَ ، يا حَقٌّ بِمَقْتَلِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=207514",""],[5431,"نور على نورِ","https://www.poetsgate.com/ViewPoem.aspx?id=199391",""],[5431,"لستَ مثلي!","https://www.poetsgate.com/ViewPoem.aspx?id=200646",""],[5536,"إلى هوازن من عدنان منتسبي","https://www.poetsgate.com/ViewPoem.aspx?id=37054",""],[5648,"بالراي متعصب وجمهور واجيال","https://www.poetsgate.com/ViewPoem.aspx?id=155976",""],[5672,"في يوم الطف...","https://www.poetsgate.com/ViewPoem.aspx?id=206518",""],[5725,"ياقدس","https://www.poetsgate.com/ViewPoem.aspx?id=194358",""],[6102,"دِيوانُ العَربِ...","https://www.poetsgate.com/ViewPoem.aspx?id=182739",""],[6146,"لك الحمد يا أللهُ يا الواحدُ البَرُّ","https://www.poetsgate.com/ViewPoem.aspx?id=122040",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577080",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[566,"قد جبر الدين الإله فجبر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=507608",""],[6189,"عيبان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83602&r=&rc=69",""],[6257,"المجازي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87187&r=&rc=12",""]],"verses":[["منام أبي الحسينِ قرير عين","ومن قوسين كان الموت قابا",0,"ب",2,0],["منامٌ فاق عند الله ليلا","قيام الناس كلهم ثوابا",0,"ب",2,0],["مِن أُمورٍ تَعتَريها","هِيَ مِنها في السِياقِ",1,"ق",1,0],["مَن أَمرُهُ عُسْرُ وَمَنْ أَمْرُهُ","يُسْرٌ نَزِيلاَهَا عَلَى الرُّحْبِ",2,"ب",1,0],["مِن أَمرِ ذي بَدَواتٍ لا تَزالُ لَهُ","بَزلاءُ يَعيا بِها الجَثّامَةُ اللُبَدُ",3,"د",1,0],["مِن أُمِّهِ لَقِيَ الصَغي","رُ مِنَ البَلِيَّةِ ما لَقي",4,"ق",2,0],["مِن إِماراتِ مُفلِسٍ أَن تَراهُ","موجِفاً في إِقطِضاءِ دَينٍ قَديمِ",5,"م",1,0],["مَن أَمكَنَ الشَكَّ مِن عَزيمَتِهِ","لَم يَزَلِ الرَأيُ مِنهُ يَضطَرِبُ",6,"ب",1,0],["مِن آمِنِ المالِ أَبقاها لَدى شَبَثٍ","جَرُّ الكُماةِ بِرَأسٍ أَو بِتَلبيبِ",7,"ب",1,0],["مَنْ أَمْلَتِ التَّقْوَى عليهِ وأَنْفَقَتْ","يَدُهُ مِنَ الأَكوانِ لا مِنْ مِزْوَدِ",8,"د",1,0],["من إمامٍ قائمٍ بالقِسْطِ أو","مُنذِرٍ مُنتخَبٍ للوَحي هَاد",9,"د",1,0],["مِن أُمورٍ حَدَثَت أَمثالُها","تَبتَري عودَ القَويِّ المُستَمِر",10,"ر",1,0],["مِنْ أُمِّ مَثْوىً كَرِيمٍ هَابَ ذْمَّتَهَا","إِنَّ الكَرِيمَ عَلَى عِلاَّتِهِ وَرِعُ",11,"ع",1,0],["من أمّةِ الطير هذا اللحن ما سمعت","بمثله الأرض لا روضٌ ولا صدَح",12,"ح",1,0],["مَنَامُهُمُ جَاثِمِينَ وَقُو","فاً وَلاَ يَهْجَعُونَ عَلَى مَرْقَد",13,"د",1,0],["مَنْ أَمَّ سَاحَتَهُ يَحْتَتُّهُ أَمَلٌ","وَلَوْ عَدَتْهُ عَوَادِي الْدَّهْرِ لَمْ يَخِبِ",14,"ب",1,0],["من أمها تبغي الغذاء لجسمها","من أمها تبغي الدواء الواقي",15,"ق",2,0],["من إمامٍ وشاعرٍ وأديبٍ","معجزاتُ الفنونِ طوْعُ بنانه",16,"ن",2,0],["من أمانيّ التي كا","نت رؤى في ناظريها",17,"ي",3,0],["مِنْ أمَارَاتِ مُفْلِسٍ أنْ تَرَاهُ","مُوجِفاً في اقتِضَاءِ دَيْنٍ قَديمِ",18,"م",1,0],["منامٌ أخافُ عليه الزَوال","وأخشى على النفسِ منهُ الوَبال",19,"ل",1,0],["مَن أَمَّ مَسعاكَ أَنضى فِكرَهُ سَفَهاً","وَلَستَ تَلقاهُ إِلّا خائِفاً وَصِبا",20,"ب",2,0],["من آمنتْ جِنُّ البلاد به وقد","سمعتْ كلامَ اللهِ في تنزيله",21,"ل",2,0],["من ام يكنْ مثلي فلا يدعي","حبَ ذاتِ النظرِ الفاترِ",22,"ر",1,0],["من آمراً بالعرف حقاً بعدة","وعن المناكر زاجراً ومحذرا",23,"ر",2,0],["من أمةٍ جمعاء أنتَ مؤيّدٌ","ومهيمنٌ برضائها ومسيطر",24,"ر",1,0],["من إمام كامل علم","فإمام فاضل علم",25,"م",1,0],["مَن أَمِنَ العَقرَبَ في الخَدِّ أَن","يُفتِيَ فينا اللَّثمُ بِالقَتلِ",26,"ل",1,0],["من أمرت او نهيت قال مجيبا","عادتي عادتي كذا ملاقيه",27,"ي",2,0],["من أمير المؤمنين انبعثَتْ","حَبّذا المأمورُ فيها والأمير",28,"ر",1,0],["من أمّ دولته ولاذ بربعه","أمن الزمان وكل خطب داه",29,"ا",2,0],["من أمّها وهو ذو عسرس ومسكنةٍ","نال اليسار وعزّاً خير منهدمِ",30,"م",1,0],["مَنَّاً منَ اللهِ والمولى الَّذِي مَطَرَتْ","سماؤُهُ الدُّرَّ بَلْهَ التِّبْرَ والوَرِقا",31,"ق",2,0],["من أمّهات الفضل إما نُثرت","أو نُظمت كانت لجوجاً عنقا",32,"ق",2,0],["من أمرَّ الليلَ والصبحَ به","أظلم الحظُّ عليه وأضا",33,"ض",2,0],["مَن أَمَهُ فيمينهُ ويسارُهُ","والعامُ اغبرَ يُمنهُ ويساره",34,"ر",2,0],["من أمة أوفدتني للرسول وقد","وافيته بلواء النصر محمولا",35,"ل",2,0],["من أم مخا مرعدا","فارتد عن كنز بدا",36,"د",2,0],["مِنّا مُسافٍ يُسافي الناسَ ما يَسَروا","في كَفِّهِ أَكعُبٌ أَو أَقدُحٌ عُطُف",37,"ف",1,1],["من أُمَّةٍ أَعظَمَ الرَّحمنُ مشهَدَهُمْ","ودون أقدامِهِمْ في المُرتَقى الأُمَمُ",38,"م",1,0],["من أمره ونهيه","بين المنايا والمنى",39,"ن",2,0],["مِن أمِير الأمرَاء","مُلتَجَانا والعِمَاد",40,"د",1,0],["من أمر ربي كلها طاعة","لأمره بالعقل والحس",41,"س",1,0],["منامكم قد جاء في الذكر من","آياته فافطن لتذكيره",42,"ر",2,0],["من أَمامٍ أَنت محفو","ظٌ بهمْ أَو مِنْ وَرَائِكْ",43,"ك",1,0],["من أمه يخضر عود يقينه","وكم اليقين بغير بطرس ييبس",44,"س",1,0],["مِن أمّة عربيّة","مَلَكت حِمى كِسرى وقَيصَر",45,"ر",1,0],["مِنْ أَمَّةُ يبغي دُلافةَ عنده","لاقاه بالإِقبال والتّرحابِ",46,"ب",1,0],["من أمور تقذى العيون وأخرى","تصدع السمع مثل وخز السهام",47,"م",1,0],["من أم بالأملاك في السماء جميعا","من قدّم في الأرض للصلاة بالارسال",48,"ل",1,0],["من أم بالأملاك والرسل إذ","كانوا له صفا وكان الإمام",49,"م",1,0],["من أمره بين الندى والردى","قد كان بين الكاف والنون",50,"ن",1,0],["مَن أَمن الدهر وهن","مَن اِجتَوى المَثوى ظعن",51,"ن",1,0],["مِن أَمن القَضاء فَهوَ مُشرك","إِن القَضاء لِلعباد أَملك",52,"ك",1,0],["مَن أَمن العَواقِبا","لَم يَأمَن النوائِبا",53,"ب",2,0],["من أمره اللم يكن واللا يكون وكن","فكيف يجهل ما يستحصل البشر",54,"ر",1,0],["من أمره الماضي على الأشياء","أو علمه الفعلي والقضائي",55,"ي",1,0],["منام جفوني مستحيل ومدمعي","على العين فرض بالتنظيم والنشر",56,"ر",1,0],["من أمها يبغي التنزه قائل","لو كان لي قصر بها أو دار",57,"ر",1,0],["من امة عدت الهدى","فطريقها متحير",58,"ر",1,0],["من أمورٍ ليس في","قولها شرعاً أذى",59,"ذ",2,0],["من أمورٍ إذا بدتْ","أذهلتْ صاحبَ النظرْ",60,"ر",1,0],["من أمه كنت عليه أشفقا","ومن أبيه يا رفيقي أرفقا",61,"ق",2,0],["من أمَّهُ نال بلوغَ المنى","وهو بما يطلبهُ ظافر",62,"ر",1,0],["من أمر مجلسه المبعوث قد وردت","إرادة أحكمت بالعدل مستندا",63,"د",2,0],["من أمه نادته ألسن فضله","أهلاً وسهلاً قد كفيناك افتقارك",64,"ك",1,0],["من أمّه مرتجياً لفضله","يعود مسروراً بأوفى نصيب",65,"ب",1,0],["من أميرٍ وقائدٍ وخطيرٍ","ورئيسٍ وماجدٍ وهمام",66,"م",1,0],["من أمه يرجو نوالاً ناله","أو خائفاً مستنسراً لا يخذل",67,"ل",1,0],["من أمه يبتغي يساراً","أتته منه به اليمين",68,"ن",1,0],["من أمها حسن الفعال وجاءها","من أرض أرزنجان يدعوه الشجن",69,"ن",1,0],["من أمها طالب افتراع","وليس كفؤاً لها تزحلق",70,"ق",1,0],["من أمه دون الورى","فاز بنيل الأرب",71,"ب",1,0],["من أم يم نواله","نال المقاصد والمآرب",72,"ب",1,0],["من أُمة الشعر كل معنى","إن ضاع يكوي الفؤاد كيّا",73,"ي",2,0],["من أماني الحب نفَّضت يديّ","مذ رأيت الشيب غطَّى وجنتيّ",74,"ي",1,1],["مِن آمِلٍ بِنَعيمِ الخُلدِ مبتشرٍ","وَمِن جَهُولٍ يَخافُ النّارَ تَستَعِرُ",75,"ر",1,0],["من أم حضرتك بأنواع العطا ينقلب","ذا حسن ظني وحاشى إن ظني يخب",76,"ب",1,0],["منامكم بالليل والنهار","مع حبكم لصاحب الأنوار",77,"ر",1,0],["من أم موسى والجواد يجد","أمنين من ضر ومن جهد",78,"د",1,0],["مَن أمَّ ساحتهم يولونَهُ مِنَناً","وَلا يَرى مِنهُمُ فَخراً وَلا مَنّا",79,"ن",2,0],["من أمرها في الكون أضحى نافذا","الجند طوع أمرها حتى إذا",80,"ذ",2,0],["من أم باب ابي العباس يأ مله","منه برى الوجه طلقا والفنا رحبا",81,"ب",2,0],["من أمه مسترحماً","اصمت حشاشته العوادى",82,"د",2,0],["من أمم بادت بصرف الأدهر","أشهدنا من ذاك ما لم نحضر",83,"ر",1,0],["من أم جانبه لدفع ملمة","فأنا الضمينُ له بنجح المصدر",84,"ر",1,0],["من أمور قد ضاق صدري منها","غير اني مقيد في بلادي",85,"ي",1,0],["من أمةٍ غبطتها الأنبياءُ بما","لها من الفضل والتمييز والكرمِ",86,"م",1,0],["مَن أمَامَ الجَمَالِ سِراً وَحُسناً","بِسَنَاهُ قَد زَادَ فَرطَ الجَوَى بِي",87,"ب",2,1],["من أم ساحتها بحسن طوية","كانت له الدنيا وأهلوها خدم",88,"م",1,0],["من أمكنته فرصة فأضاعها","واستعتب الأيام فهو المعتدي",89,"د",2,0],["من أمَّ بابك لم تبرح جوارحهُ","تروي أحاديثَ ما أوليتَ من مِننِ",90,"ن",1,1],["مِن أَم اِرباب الفَصاحَة جامِعاً","فَصل الخَطاب وَبِالبَيانِ كَفيلا",91,"ل",2,0],["مِن أَم أَبوابِ الكَريمِ يَفِزُّ بِما","يَرجوهُ مِن نَيلٍ وَفَوق المَقصَدِ",92,"د",1,0],["من أمهرت بالملح من دون العرب","والماء ناهيك به خير سبب",93,"ب",1,0],["من أمّته الخيرة الاخيرة تأتى","في البعث على السابقين أعدل أشهاد",94,"د",1,0],["من أمّ برسل الاله ثم تسامى","والفرش سخين وبالهناء له هاد",94,"د",1,0],["من أمّه سائلا حباه","حباه م اعنه كل فكر",95,"ر",1,0],["من أمه يرجو نوالا نال ما","يرجو وعنه كل سوء يحجز",96,"ز",1,0],["من أمه إن في كشف خطب مثقل","فلقد نجا من كربه الفداح",97,"ح",1,0],["من آمر بالعرف ينكر منكراً","قولاً وفعلاً مبدءاً ومعيدا",98,"د",2,0],["من أمام ووراءٍ","وشمالٍ وميامن",99,"ن",1,0],["من أُمّه يرجو به نَصرَةً","يَجده في يوم الوَغى ناصره",100,"ر",2,0],["من أمَّل الناس يشقى","وليس يقنع منه",101,"ن",2,0],["من أمه وهو يشكو الكرب من عسر","أخنى عليه أحال العسر باليسر",102,"ر",1,0],["من أمر روح القدس نشأة روحه","ومن السماحة جسمه متجسد",103,"د",1,0],["من آمنَ الضبُّ تصديقاً لدعوته","رداً على شكِّ مَن بالمصطفى كفروا",104,"ر",3,0],["من أمَّةٍ غبطتها الأنبياء ومن","إلى البتول ومن أحفاد آل عليّ",105,"ل",2,0],["من أَمْرَ