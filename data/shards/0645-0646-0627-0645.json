{"poems":[[110,"سطا حُسناً","https://www.shoaraa.com/p13815",""],[57,"طال ليلي واشتياقي","https://www.aldiwan.net/poem26208.html","مجزوء الرمل"],[95,"هل آية في السلم والحرب","https://www.aldiwan.net/poem9789.html","عموديه"],[40,"بان الأحبة بالعهد الذي عهدوا","https://www.aldiwan.net/poem7699.html","البسيط"],[87,"وممهد في الوكر","https://www.aldiwan.net/poem7930.html","مجزوء الكامل"],[47,"قد ترى دارسات الرسوم","https://www.aldiwan.net/poem65654.html","الخفيف"],[51,"ما استعبد الحرص من له أدب","https://www.aldiwan.net/poem10331.html","المنسرح"],[22,"لما رأى أن أرياف القرى منعت","https://www.aldiwan.net/poem21675.html","البسيط"],[69,"كتب المشيب بأبيض في أسود","https://www.aldiwan.net/poem18056.html","الكامل"],[77,"إمسحوا عن ناظري كحل السهاد","https://www.aldiwan.net/poem69087.html","الطويل"],[1,"أصحوت اليوم أم شاقتك هر","https://www.aldiwan.net/poem33999.html","الرمل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62225","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39676","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54771","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54572","البسيط"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142012","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54315","الخفيف"],[98,"إليها","https://www.poetsgate.com/ViewPoem.aspx?id=17491",""],[47,"قَدْ تَرَى دارِاساتِ تِلْكَ الرّسومِ","https://www.poetsgate.com/ViewPoem.aspx?id=31726",""],[132,"تعالي صباحا إلى غرفتي","https://www.aldiwan.net/poem67444.html","المتقارب"],[146,"أما الفراق فقد عاصيته فأبى","https://www.aldiwan.net/poem11718.html","البسيط"],[188,"صلى الإله عليك يا بن رسوله","https://www.aldiwan.net/poem14639.html","الكامل"],[202,"قولوا لهذا الرشا الهاجر","https://www.aldiwan.net/poem45589.html","السريع"],[209,"دهش الفؤاد فكان أن يتفطّرا","https://www.aldiwan.net/poem918.html",""],[273,"أنت المقيل المرتجى يا هتلر","https://www.aldiwan.net/poem35585.html","الكامل"],[307,"يا وجيه الدين والكرم","https://www.aldiwan.net/poem16840.html","المديد"],[369,"يا كعبة الحسن التي زارها","https://www.aldiwan.net/poem17078.html","السريع"],[394,"عجبا للزمان مع أهليه","https://www.aldiwan.net/poem54451.html","عموديه"],[419,"شرف البصرة مولانا المشير","https://www.aldiwan.net/poem54069.html","الرمل"],[432,"ربع التهاني بالمسرة زاهي","https://www.aldiwan.net/poem40058.html","الكامل"],[432,"لك الهناء بنيل المجد والنعم","https://www.aldiwan.net/poem40798.html","البسيط"],[442,"هل يجهل السمت من يستوضح الطرقا","https://www.aldiwan.net/poem34833.html","البسيط"],[460,"در لها خلف الغمام فسقى","https://www.aldiwan.net/poem56094.html","البسيط"],[460,"مطل الدين ولو شاء قضى","https://www.aldiwan.net/poem56147.html","الرمل"],[466,"هذا العقيق وهذه أقماره","https://www.aldiwan.net/poem3177.html","عموديه"],[481,"ما كان قولك في لوزان مقبولا","https://www.aldiwan.net/poem36949.html","البسيط"],[481,"وحق سيف أنور","https://www.aldiwan.net/poem37204.html","مجزوء الرجز"],[492,"منا مُسافٍ يُسافي الناس ما يسروا","https://www.aldiwan.net/poem661.html",""],[502,"أنا الفتى من بني الصياد لي نسب","https://www.aldiwan.net/poem37773.html","البسيط"],[517,"الحمد لله الذي","https://www.aldiwan.net/poem12285.html","مجزوء الرجز"],[540,"إن هتلير الضحايا","https://www.aldiwan.net/poem48208.html","عموديه"],[560,"إن كنت لم ترض عن النفس","https://www.aldiwan.net/poem34447.html","السريع"],[560,"انظر إلى الكون وتسطيره","https://www.aldiwan.net/poem34458.html","السريع"],[577,"إنني من عتقائك","https://www.aldiwan.net/poem3042.html","مجزوء الرمل"]],"verses":[["منام أبي الحسينِ قرير عين","ومن قوسين كان الموت قابا",0,"ب",2,0],["منامٌ فاق عند الله ليلا","قيام الناس كلهم ثوابا",0,"ب",2,0],["مِن أُمورٍ تَعتَريها","هِيَ مِنها في السِياقِ",1,"ق",1,0],["مَن أَمرُهُ عُسْرُ وَمَنْ أَمْرُهُ","يُسْرٌ نَزِيلاَهَا عَلَى الرُّحْبِ",2,"ب",1,0],["مِن أَمرِ ذي بَدَواتٍ لا تَزالُ لَهُ","بَزلاءُ يَعيا بِها الجَثّامَةُ اللُبَدُ",3,"د",1,0],["مِن أُمِّهِ لَقِيَ الصَغي","رُ مِنَ البَلِيَّةِ ما لَقي",4,"ق",2,0],["مِن إِماراتِ مُفلِسٍ أَن تَراهُ","موجِفاً في إِقطِضاءِ دَينٍ قَديمِ",5,"م",1,0],["مَن أَمكَنَ الشَكَّ مِن عَزيمَتِهِ","لَم يَزَلِ الرَأيُ مِنهُ يَضطَرِبُ",6,"ب",1,0],["مِن آمِنِ المالِ أَبقاها لَدى شَبَثٍ","جَرُّ الكُماةِ بِرَأسٍ أَو بِتَلبيبِ",7,"ب",1,0],["مَنْ أَمْلَتِ التَّقْوَى عليهِ وأَنْفَقَتْ","يَدُهُ مِنَ الأَكوانِ لا مِنْ مِزْوَدِ",8,"د",1,0],["من إمامٍ قائمٍ بالقِسْطِ أو","مُنذِرٍ مُنتخَبٍ للوَحي هَاد",9,"د",1,0],["مِن أُمورٍ حَدَثَت أَمثالُها","تَبتَري عودَ القَويِّ المُستَمِر",10,"ر",1,0],["مِنْ أُمِّ مَثْوىً كَرِيمٍ هَابَ ذْمَّتَهَا","إِنَّ الكَرِيمَ عَلَى عِلاَّتِهِ وَرِعُ",11,"ع",1,0],["من أمّةِ الطير هذا اللحن ما سمعت","بمثله الأرض لا روضٌ ولا صدَح",12,"ح",1,0],["مَنَامُهُمُ جَاثِمِينَ وَقُو","فاً وَلاَ يَهْجَعُونَ عَلَى مَرْقَد",13,"د",1,0],["مَنْ أَمَّ سَاحَتَهُ يَحْتَتُّهُ أَمَلٌ","وَلَوْ عَدَتْهُ عَوَادِي الْدَّهْرِ لَمْ يَخِبِ",14,"ب",1,0],["من أمها تبغي الغذاء لجسمها","من أمها تبغي الدواء الواقي",15,"ق",2,0],["من إمامٍ وشاعرٍ وأديبٍ","معجزاتُ الفنونِ طوْعُ بنانه",16,"ن",2,0],["من أمانيّ التي كا","نت رؤى في ناظريها",17,"ي",3,0],["مِنْ أمَارَاتِ مُفْلِسٍ أنْ تَرَاهُ","مُوجِفاً في اقتِضَاءِ دَيْنٍ قَديمِ",18,"م",1,0],["منامٌ أخافُ عليه الزَوال","وأخشى على النفسِ منهُ الوَبال",19,"ل",1,0],["مَن أَمَّ مَسعاكَ أَنضى فِكرَهُ سَفَهاً","وَلَستَ تَلقاهُ إِلّا خائِفاً وَصِبا",20,"ب",2,0],["من آمنتْ جِنُّ البلاد به وقد","سمعتْ كلامَ اللهِ في تنزيله",21,"ل",2,0],["من ام يكنْ مثلي فلا يدعي","حبَ ذاتِ النظرِ الفاترِ",22,"ر",1,0],["من آمراً بالعرف حقاً بعدة","وعن المناكر زاجراً ومحذرا",23,"ر",2,0],["من أمةٍ جمعاء أنتَ مؤيّدٌ","ومهيمنٌ برضائها ومسيطر",24,"ر",1,0],["من إمام كامل علم","فإمام فاضل علم",25,"م",1,0],["مَن أَمِنَ العَقرَبَ في الخَدِّ أَن","يُفتِيَ فينا اللَّثمُ بِالقَتلِ",26,"ل",1,0],["من أمرت او نهيت قال مجيبا","عادتي عادتي كذا ملاقيه",27,"ي",2,0],["من أمير المؤمنين انبعثَتْ","حَبّذا المأمورُ فيها والأمير",28,"ر",1,0],["من أمّ دولته ولاذ بربعه","أمن الزمان وكل خطب داه",29,"ا",2,0],["من أمّها وهو ذو عسرس ومسكنةٍ","نال اليسار وعزّاً خير منهدمِ",30,"م",1,0],["مَنَّاً منَ اللهِ والمولى الَّذِي مَطَرَتْ","سماؤُهُ الدُّرَّ بَلْهَ التِّبْرَ والوَرِقا",31,"ق",2,0],["من أمّهات الفضل إما نُثرت","أو نُظمت كانت لجوجاً عنقا",32,"ق",2,0],["من أمرَّ الليلَ والصبحَ به","أظلم الحظُّ عليه وأضا",33,"ض",2,0],["مَن أَمَهُ فيمينهُ ويسارُهُ","والعامُ اغبرَ يُمنهُ ويساره",34,"ر",2,0],["من أمة أوفدتني للرسول وقد","وافيته بلواء النصر محمولا",35,"ل",2,0],["من أم مخا مرعدا","فارتد عن كنز بدا",36,"د",2,0],["مِنّا مُسافٍ يُسافي الناسَ ما يَسَروا","في كَفِّهِ أَكعُبٌ أَو أَقدُحٌ عُطُف",37,"ف",1,1],["من أُمَّةٍ أَعظَمَ الرَّحمنُ مشهَدَهُمْ","ودون أقدامِهِمْ في المُرتَقى الأُمَمُ",38,"م",1,0],["من أمره ونهيه","بين المنايا والمنى",39,"ن",2,0],["مِن أمِير الأمرَاء","مُلتَجَانا والعِمَاد",40,"د",1,0],["من أمر ربي كلها طاعة","لأمره بالعقل والحس",41,"س",1,0],["منامكم قد جاء في الذكر من","آياته فافطن لتذكيره",42,"ر",2,0],["من أَمامٍ أَنت محفو","ظٌ بهمْ أَو مِنْ وَرَائِكْ",43,"ك",1,0]]}