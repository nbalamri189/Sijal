{"poems":[[55,"طال ليلي واشتياقي","https://www.aldiwan.net/poem26208.html","مجزوء الرمل"],[93,"هل آية في السلم والحرب","https://www.aldiwan.net/poem9789.html","عموديه"],[38,"بان الأحبة بالعهد الذي عهدوا","https://www.aldiwan.net/poem7699.html","البسيط"],[85,"وممهد في الوكر","https://www.aldiwan.net/poem7930.html","مجزوء الكامل"],[45,"قد ترى دارسات الرسوم","https://www.aldiwan.net/poem65654.html","الخفيف"],[49,"ما استعبد الحرص من له أدب","https://www.aldiwan.net/poem10331.html","المنسرح"],[22,"لما رأى أن أرياف القرى منعت","https://www.aldiwan.net/poem21675.html","البسيط"],[67,"كتب المشيب بأبيض في أسود","https://www.aldiwan.net/poem18056.html","الكامل"],[75,"إمسحوا عن ناظري كحل السهاد","https://www.aldiwan.net/poem69087.html","الطويل"],[1,"أصحوت اليوم أم شاقتك هر","https://www.aldiwan.net/poem33999.html","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39676","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54771","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54572","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142012","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54315","الخفيف"],[96,"إليها","https://www.poetsgate.com/ViewPoem.aspx?id=17491",""],[45,"قَدْ تَرَى دارِاساتِ تِلْكَ الرّسومِ","https://www.poetsgate.com/ViewPoem.aspx?id=31726",""],[129,"تعالي صباحا إلى غرفتي","https://www.aldiwan.net/poem67444.html","المتقارب"],[143,"أما الفراق فقد عاصيته فأبى","https://www.aldiwan.net/poem11718.html","البسيط"],[185,"صلى الإله عليك يا بن رسوله","https://www.aldiwan.net/poem14639.html","الكامل"],[199,"قولوا لهذا الرشا الهاجر","https://www.aldiwan.net/poem45589.html","السريع"],[206,"دهش الفؤاد فكان أن يتفطّرا","https://www.aldiwan.net/poem918.html",""],[270,"أنت المقيل المرتجى يا هتلر","https://www.aldiwan.net/poem35585.html","الكامل"],[304,"يا وجيه الدين والكرم","https://www.aldiwan.net/poem16840.html","المديد"],[366,"يا كعبة الحسن التي زارها","https://www.aldiwan.net/poem17078.html","السريع"],[391,"عجبا للزمان مع أهليه","https://www.aldiwan.net/poem54451.html","عموديه"],[416,"شرف البصرة مولانا المشير","https://www.aldiwan.net/poem54069.html","الرمل"],[429,"ربع التهاني بالمسرة زاهي","https://www.aldiwan.net/poem40058.html","الكامل"],[429,"لك الهناء بنيل المجد والنعم","https://www.aldiwan.net/poem40798.html","البسيط"],[439,"هل يجهل السمت من يستوضح الطرقا","https://www.aldiwan.net/poem34833.html","البسيط"],[458,"در لها خلف الغمام فسقى","https://www.aldiwan.net/poem56094.html","البسيط"],[458,"مطل الدين ولو شاء قضى","https://www.aldiwan.net/poem56147.html","الرمل"],[464,"هذا العقيق وهذه أقماره","https://www.aldiwan.net/poem3177.html","عموديه"],[479,"ما كان قولك في لوزان مقبولا","https://www.aldiwan.net/poem36949.html","البسيط"],[479,"وحق سيف أنور","https://www.aldiwan.net/poem37204.html","مجزوء الرجز"],[490,"منا مُسافٍ يُسافي الناس ما يسروا","https://www.aldiwan.net/poem661.html",""],[500,"أنا الفتى من بني الصياد لي نسب","https://www.aldiwan.net/poem37773.html","البسيط"],[515,"الحمد لله الذي","https://www.aldiwan.net/poem12285.html","مجزوء الرجز"],[538,"إن هتلير الضحايا","https://www.aldiwan.net/poem48208.html","عموديه"],[558,"إن كنت لم ترض عن النفس","https://www.aldiwan.net/poem34447.html","السريع"],[558,"انظر إلى الكون وتسطيره","https://www.aldiwan.net/poem34458.html","السريع"],[575,"إنني من عتقائك","https://www.aldiwan.net/poem3042.html","مجزوء الرمل"]],"verses":[["مِن أُمورٍ تَعتَريها","هِيَ مِنها في السِياقِ",0,"ق",1,0],["مَن أَمرُهُ عُسْرُ وَمَنْ أَمْرُهُ","يُسْرٌ نَزِيلاَهَا عَلَى الرُّحْبِ",1,"ب",1,0],["مِن أَمرِ ذي بَدَواتٍ لا تَزالُ لَهُ","بَزلاءُ يَعيا بِها الجَثّامَةُ اللُبَدُ",2,"د",1,0],["مِن أُمِّهِ لَقِيَ الصَغي","رُ مِنَ البَلِيَّةِ ما لَقي",3,"ي",1,0],["مِن إِماراتِ مُفلِسٍ أَن تَراهُ","موجِفاً في إِقطِضاءِ دَينٍ قَديمِ",4,"م",1,0],["مَن أَمكَنَ الشَكَّ مِن عَزيمَتِهِ","لَم يَزَلِ الرَأيُ مِنهُ يَضطَرِبُ",5,"ب",1,0],["مِن آمِنِ المالِ أَبقاها لَدى شَبَثٍ","جَرُّ الكُماةِ بِرَأسٍ أَو بِتَلبيبِ",6,"ب",1,0],["مَنْ أَمْلَتِ التَّقْوَى عليهِ وأَنْفَقَتْ","يَدُهُ مِنَ الأَكوانِ لا مِنْ مِزْوَدِ",7,"د",1,0],["من إمامٍ قائمٍ بالقِسْطِ أو","مُنذِرٍ مُنتخَبٍ للوَحي هَاد",8,"د",1,0],["مِن أُمورٍ حَدَثَت أَمثالُها","تَبتَري عودَ القَويِّ المُستَمِر",9,"ر",1,0],["من أمّةِ الطير هذا اللحن ما سمعت","بمثله الأرض لا روضٌ ولا صدَح",10,"ح",1,0],["مَنَامُهُمُ جَاثِمِينَ وَقُو","فاً وَلاَ يَهْجَعُونَ عَلَى مَرْقَد",11,"د",1,0],["مَنْ أَمَّ سَاحَتَهُ يَحْتَتُّهُ أَمَلٌ","وَلَوْ عَدَتْهُ عَوَادِي الْدَّهْرِ لَمْ يَخِبِ",12,"ب",1,0],["من أمها تبغي الغذاء لجسمها","من أمها تبغي الدواء الواقي",13,"ق",2,0],["من إمامٍ وشاعرٍ وأديبٍ","معجزاتُ الفنونِ طوْعُ بنانه",14,"ن",2,0],["من أمانيّ التي كا","نت رؤى في ناظريها",15,"ي",3,0],["مِنْ أمَارَاتِ مُفْلِسٍ أنْ تَرَاهُ","مُوجِفاً في اقتِضَاءِ دَيْنٍ قَديمِ",16,"م",1,0],["منامٌ أخافُ عليه الزَوال","وأخشى على النفسِ منهُ الوَبال",17,"ل",1,0],["مَن أَمَّ مَسعاكَ أَنضى فِكرَهُ سَفَهاً","وَلَستَ تَلقاهُ إِلّا خائِفاً وَصِبا",18,"ب",2,0],["من آمنتْ جِنُّ البلاد به وقد","سمعتْ كلامَ اللهِ في تنزيله",19,"ل",2,0],["من ام يكنْ مثلي فلا يدعي","حبَ ذاتِ النظرِ الفاترِ",20,"ر",1,0],["من آمراً بالعرف حقاً بعدة","وعن المناكر زاجراً ومحذرا",21,"ر",2,0],["من أمةٍ جمعاء أنتَ مؤيّدٌ","ومهيمنٌ برضائها ومسيطر",22,"ر",1,0],["من إمام كامل علم","فإمام فاضل علم",23,"م",1,0],["مَن أَمِنَ العَقرَبَ في الخَدِّ أَن","يُفتِيَ فينا اللَّثمُ بِالقَتلِ",24,"ل",1,0],["من أمرت او نهيت قال مجيبا","عادتي عادتي كذا ملاقيه",25,"ي",2,0],["من أمير المؤمنين انبعثَتْ","حَبّذا المأمورُ فيها والأمير",26,"ر",1,0],["من أمّ دولته ولاذ بربعه","أمن الزمان وكل خطب داه",27,"ا",2,0],["من أمّها وهو ذو عسرس ومسكنةٍ","نال اليسار وعزّاً خير منهدمِ",28,"م",1,0],["مَنَّاً منَ اللهِ والمولى الَّذِي مَطَرَتْ","سماؤُهُ الدُّرَّ بَلْهَ التِّبْرَ والوَرِقا",29,"ق",2,0],["من أمّهات الفضل إما نُثرت","أو نُظمت كانت لجوجاً عنقا",30,"ق",2,0],["من أمرَّ الليلَ والصبحَ به","أظلم الحظُّ عليه وأضا",31,"ض",2,0],["مَن أَمَهُ فيمينهُ ويسارُهُ","والعامُ اغبرَ يُمنهُ ويساره",32,"ر",2,0],["من أمة أوفدتني للرسول وقد","وافيته بلواء النصر محمولا",33,"ل",2,0],["من أم مخا مرعدا","فارتد عن كنز بدا",34,"د",2,0],["مِنّا مُسافٍ يُسافي الناسَ ما يَسَروا","في كَفِّهِ أَكعُبٌ أَو أَقدُحٌ عُطُف",35,"ف",1,1],["من أُمَّةٍ أَعظَمَ الرَّحمنُ مشهَدَهُمْ","ودون أقدامِهِمْ في المُرتَقى الأُمَمُ",36,"م",1,0],["من أمره ونهيه","بين المنايا والمنى",37,"ن",2,0],["مِن أمِير الأمرَاء","مُلتَجَانا والعِمَاد",38,"د",1,0],["من أمر ربي كلها طاعة","لأمره بالعقل والحس",39,"س",1,0],["منامكم قد جاء في الذكر من","آياته فافطن لتذكيره",40,"ر",2,0],["من أَمامٍ أَنت محفو","ظٌ بهمْ أَو مِنْ وَرَائِكْ",41,"ك",1,0]]}