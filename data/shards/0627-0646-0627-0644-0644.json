{"poems":[[53,"أنا للركائب إن عرضت بمنزل","https://www.aldiwan.net/poem29911.html","الكامل"],[53,"سيدي أنت ليس كلل","https://www.aldiwan.net/poem29953.html","مجزوء الخفيف"],[53,"أثر الهوادج في عراص البيد","https://www.aldiwan.net/poem30633.html","الكامل"],[77,"إن اللحاظ هي السيوف حقيقة","https://www.aldiwan.net/poem35846.html","الكامل"],[88,"هي المواطن أدنيها وتقصيني","https://www.aldiwan.net/poem44815.html","البسيط"],[27,"ما هاج شوقك من رسوم ديار","https://www.aldiwan.net/poem5785.html","الكامل"],[72,"أيها البحر الذي عن","https://www.aldiwan.net/poem18284.html","مجزوء الرمل"],[72,"إن اللديغ هو السليم كما رووا","https://www.aldiwan.net/poem20503.html","الكامل"],[51,"إن اللسان الذي نسجت به","https://www.aldiwan.net/poem9258.html","المنسرح"],[51,"أعزز علي أبا إسحاق أن ذهبت","https://www.aldiwan.net/poem64667.html","البسيط"],[51,"مكر الزمان علينا غير مأمون","https://www.aldiwan.net/poem66416.html","البسيط"],[29,"لمن الديار بحائل فوعال","https://www.aldiwan.net/poem6033.html","الكامل"],[29,"يا كعب لا تهجونا العام معترضا","https://www.aldiwan.net/poem6103.html","البسيط"],[91,"ذات شوك كالحراب أو كأظفار العقاب","https://www.aldiwan.net/poem8752.html","عموديه"],[91,"لم يبق ما يسليك غير الكاس","https://www.aldiwan.net/poem8973.html","عموديه"],[92,"يا ربة الشعر والأحلام غنيني","https://www.aldiwan.net/poem38900.html","الكامل"],[32,"زوروا بثينة فالحبيب مزور","https://www.aldiwan.net/poem27803.html","الكامل"],[89,"حول الحقيقة في الحياة طوافي","https://www.aldiwan.net/poem44615.html","الكامل"],[89,"قد انى يا منيتي ان تعودي","https://www.aldiwan.net/poem44738.html","الخفيف"],[89,"يا موطنا قد ذبت فيه غراما","https://www.aldiwan.net/poem44748.html","الكامل"],[85,"أمينتي في عامها","https://www.aldiwan.net/poem8068.html","مجزوء الرجز"],[58,"أنا للحراب اليها","https://www.aldiwan.net/poem30806.html","مجزوء الرمل"],[97,"طوى السنين وشق الغيب والظلما","https://www.aldiwan.net/poem24940.html","البسيط"],[80,"إن الليالي والأيام يدركها","https://www.aldiwan.net/poem31348.html","البسيط"],[74,"إن الليالي لا دهتك لعائثه","https://www.aldiwan.net/poem12878.html","الكامل"],[50,"أقوى وعطل من فراطة الثمد","https://www.aldiwan.net/poem63936.html","البسيط"],[46,"قد باشروك بمكروه أديت به","https://www.aldiwan.net/poem22664.html","البسيط"],[46,"بئس الشهادة إذا سألت شهادة","https://www.aldiwan.net/poem22889.html","الكامل"],[46,"يا خاطري لا توجه وجه سيئة","https://www.aldiwan.net/poem23220.html","البسيط"],[46,"لم لا أؤمل رحمة من قادر","https://www.aldiwan.net/poem23247.html","الكامل"],[46,"لنا طباع وجدنا العقل يأمرها","https://www.aldiwan.net/poem23475.html","البسيط"],[46,"إن لم نكن عائمي لج نمارسه","https://www.aldiwan.net/poem23514.html","البسيط"],[46,"يا شائم البارق لا تشجك ال","https://www.aldiwan.net/poem23546.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85389","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85731","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85484","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85352","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42609","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54195","الخفيف"],[90,"أنا !","https://www.poetsgate.com/ViewPoem.aspx?id=179156",""],[90,"إبن الشام","https://www.poetsgate.com/ViewPoem.aspx?id=178945",""],[46,"أنا، للصَّرورةِ، في الحياةِ، مُقارنٌ،","https://www.poetsgate.com/ViewPoem.aspx?id=18252",""],[51,"مكْرُ الزَّمانِ علينا غير مأمونِ","https://www.poetsgate.com/ViewPoem.aspx?id=30805",""],[87,"رفَّ النَّدَى ، وَتَنَفَّسَ النُوَّارُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23924&r=&rc=186",""],[135,"لا للقدود ولا للأعين السود","https://www.aldiwan.net/poem49190.html","البسيط"],[157,"خير الكلام","https://www.aldiwan.net/poem23647.html","البسيط"],[160,"يا أيها الملك الميمون طائره","https://www.aldiwan.net/poem58951.html","البسيط"],[160,"زيادة القول تحكي النقص في العمل","https://www.aldiwan.net/poem59154.html","الطويل"],[185,"أنا للعود لسان","https://www.aldiwan.net/poem14673.html","مجزوء الرمل"],[198,"ألوت بأهل اللوى المهرية النجب","https://www.aldiwan.net/poem51984.html","البسيط"],[210,"أنا حسبي من رآه","https://www.aldiwan.net/poem13474.html","مجزوء الرمل"],[211,"جارت على الورد في أيام نضرته","https://www.aldiwan.net/poem46779.html","البسيط"],[212,"إن الليالي والأيام أطراق","https://www.aldiwan.net/poem37856.html","البسيط"],[225,"إن الليالي من أخلافها الكدر","https://www.aldiwan.net/poem55100.html","البسيط"],[229,"ما استحسن الحب حتى استقبح العذل","https://www.aldiwan.net/poem50848.html","البسيط"],[280,"يا مفلت الظبية الغناء من يده","https://www.aldiwan.net/poem60762.html","البسيط"],[303,"إن اللطافة لم تزل","https://www.aldiwan.net/poem58240.html","الكامل"],[328,"عاد الربيع ولم تعودي","https://www.aldiwan.net/poem54937.html","مجزوء الكامل"],[328,"فوق هذي الربا أقمت وحيدا","https://www.aldiwan.net/poem54989.html","الخفيف"],[338,"إن اللبيب إذا تفرق أمره","https://www.aldiwan.net/poem68778.html","الكامل"],[342,"يا مال في الأفق البعيد سحاب","https://www.aldiwan.net/poem55387.html","الكامل"],[364,"لولا رجائي ثانيا للقائه","https://www.aldiwan.net/poem61006.html","الكامل"],[369,"إن اللئيم على حقارة قدره","https://www.aldiwan.net/poem4309.html","الكامل"],[371,"صبرا لما فعل الزمن","https://www.aldiwan.net/poem57011.html","مجزوء الكامل"],[371,"طال الزمان وما ثناه ولا انثنى","https://www.aldiwan.net/poem57023.html","الكامل"],[371,"جفن على شوك القتادة يطبق","https://www.aldiwan.net/poem57276.html","الطويل"],[377,"يا غافلا عن نفسه","https://www.aldiwan.net/poem59302.html","مجزوء الكامل"],[377,"وقبيلة جهلاؤها عقلاؤها","https://www.aldiwan.net/poem66981.html","الكامل"],[402,"يا طرف أنجد بالدموع","https://www.aldiwan.net/poem46723.html","مجزوء الكامل"],[405,"أنا للسيد الشريف غلام","https://www.aldiwan.net/poem49738.html","الخفيف"],[416,"قل مثلما قد قال عبد الباقي","https://www.aldiwan.net/poem53980.html","الكامل"],[416,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[432,"لو حل عن خديه عقد لثامه","https://www.aldiwan.net/poem12734.html","الكامل"],[441,"المرء لا زال في دنياه كالعرض","https://www.aldiwan.net/poem14456.html","البسيط"],[449,"يئس الصغار من الكبار","https://www.aldiwan.net/poem995.html",""],[458,"هل بعد مفترق الأظعان مجتمع","https://www.aldiwan.net/poem56135.html","البسيط"],[500,"للقلب في سبك الحروف معان","https://www.aldiwan.net/poem37757.html","الكامل"],[500,"رح مع الوردين إني عاشق","https://www.aldiwan.net/poem37950.html","الرمل"],[506,"أنا للندامى نزهة المستمتع","https://www.aldiwan.net/poem2459.html","الكامل"],[515,"عند ظباء الجهلتين ثاره","https://www.aldiwan.net/poem12110.html","الرجز"],[515,"ما عن هوى الرشأ العذري أعذار","https://www.aldiwan.net/poem12136.html","البسيط"],[529,"إن الليالي في المخادر قد غدت","https://www.aldiwan.net/poem37071.html","الكامل"],[529,"إن اللقا أفضل إن كان في","https://www.aldiwan.net/poem37164.html","السريع"],[558,"أيها السائر بالركبان حي","https://www.aldiwan.net/poem33571.html","الرمل"],[562,"نفذ القضا من أوج ذلك المنبر","https://www.aldiwan.net/poem52778.html","الكامل"],[569,"ألا أيها الغائر المستشي","https://www.aldiwan.net/poem52010.html","المتقارب"],[586,"يا راقد الطرف ما للطرف إغفاء","https://www.aldiwan.net/poem17396.html","البسيط"],[586,"أنا للمجالس والجليس أنيسة","https://www.aldiwan.net/poem17543.html","الكامل"]],"verses":[["أَنا لِلرَكائِبِ إِن عَرَضتُ بِمَنزِلِ","وَإِذا القَنوعُ أَطاعَني لَم أَرحَلِ",0,"ل",1,1],["أَنا لِلجودِ مُذ خُلِق","تُ وَوَحَّدتُ خالِقي",1,"ق",2,0],["إِنَّ اللَآلي بَينَ أَصدافِ اللَمى","غَلَبَت مَراشِفُها عَلى مَجلودي",2,"د",2,0],["إنّ اللِّحاظَ هيَ السُيوفُ حَقيقةً","ومَنِ اسْتَرابَ فحُجّتي تكْفِيهِ",3,"ه",1,1],["إن اللئيم دفين قبل ميتتِهِ","وما الكريم وإن أودى بمدفون",4,"ن",1,0],["إِنَّ اللِئامَ بَني اللِئامِ مُجاشِعٌ","وَالأَخبَثونَ مَحَلَّ كُلِّ إِزارِ",5,"ر",1,0],["أنا للشكرِ المهنى","وابن شكر المواهب",6,"ب",1,0],["إنَّ اللّديغ هو السليم كما رَوَوْا","ولكن بقلبي أيّ لدغٍ كامن",7,"ن",1,1],["إنّ اللسان الذي نَسَجْتُ به","مدحَك يَسطيعُ نقضَ ما نَسجا",8,"ج",2,1],["إن اللياليَ والأيام مُوقِعةٌ","بذي النعيم وذي المِسْحَينِ في البوس",9,"س",1,0],["إنَّ اللَّياليَ والأيامَ قد كَشفَتْ","من كَيْدها كلَّ مستورٍ ومكنونِ",10,"ن",1,0],["إِنَّ اللَئيمَ إِذا سَأَلتَ بَهَرتَهُ","وَتَرى الكَريمَ يراحُ كَالمُختالِ",11,"ل",1,0],["إِنَّ اللَهازِمَ لَن تَنفَكَّ تابِعَةً","هُمُ الذُنابى وَشُربُ التابِعِ الكَدَرُ",12,"ر",1,0],["أَنا لِلأَرض وَإِن طالَ عَنِ الأَرضِ اِغتِرابي","غَيرَ أَنّي لَم يَزَل ضَرعي لِرَي وَاِحتِلابِ",13,"ب",1,0],["إِنَّ اللَذاذاتِ الَّتي ضَيَّعتَها","رَجِعَت إِلَيكَ عُصارَةً في الكاسِ",14,"س",1,0],["إنَّ اللَّيالي اللَّواتي ضمَّختْ كَبِدِي","بالسِّحْرِ أَضْحتْ مع الأَيَّامِ ترميني",15,"ي",1,0],["إِنَّ اللِسانَ بِذِكرِها لَمُوَكَّلٌ","وَالقَلبُ صادٍ وَالخَواطِرُ صوَرُ",16,"ر",1,0],["إن الليالي أخلفتني وعدها","حتى برمت بذلك الاخلاف",17,"ف",1,0],["انا للورد قد تفتح اشدو","فهو ان اصغى تم لي مقصودي",18,"د",2,0],["انا للافاعي غير مكترث وان","تركت بنفسي نابها آلاما",19,"م",2,0],["إِنَّ اللَيالي وَهيَ لا","تَنفَكُّ حَربَ أَهلِكِ",20,"ك",1,0],["أَنا لِلحِرابِ اِلَيها","وَبِنَفسي أَتَّقيها",21,"ي",3,1],["إن الليالي التي في العمر منك خلت","مرت يبابا وكانت كلها عقما",22,"م",2,0],["إنَّ الليالِيَ والأيّامَ يُدْرِكُها","شَيبٌ وَيعقبها مِن بَعْدِهِ هُلُكُ",23,"ك",1,1],["إِنَّ اللَيالي لا دَهَتكَ لَعائِثَه","فَوَقَيتُ فيكَ يَدَ الزَمانِ العابِثَه",24,"ث",2,1],["إِنَّ اللَيالِيَ وَالأَيّامَ فاجِعَةٌ","وَالمَرءُ يَفنى وَلا يَبقى لَهُ الأَبَدُ",25,"د",1,0],["إِنَّ اللَيالِيَ تَسقي الحَتفَ ساكِنَها","قَيلاً وَصُبحاً وَفي الظَلماءِ وَالجَشرِ",26,"ر",1,0],["إِنَّ اللَيالِيَ ما تَصَرَّمُ عَنهُمُ","إِلّا لِتَبلُغَ فيِهُمُ أَغراضَها",27,"ض",3,0],["إِنَّ اللَطيفَينِ مِن دَهرٍ وَأَمكِنَةٍ","لا يَفتَآنِ بِلا حِسٍّ وَلا زَجَلِ",28,"ل",1,0],["إِنَّ اللِقاحَ وَإِن أَتاكَ بِثَروَةٍ","فَأَقَلُّ مِنهُ أَذىً حِيالُ الحُوَّلِ",29,"ل",1,0],["إِنَّ اللَيالِيَ قالَت وَهيَ صامِتَةٌ","ما أَبلَغَ الدَهرَ لا مَن يَدَّعي اللَسَنا",30,"ن",2,0],["إِنَّ اللِباسَ وَعِطراً أَنتَ بائِعُهُ","لَيسا لِمَدفونِ مَوتانا بَلِ الدُفُنِ",31,"ن",1,0],["إِنَّ اللَبيباتِ إِذا مِلنَ لِلدُن","يا وَأَلغَينَ التُقى ما لَبَبنَ",32,"ن",1,0],["إن اللصوص أَتوا بليلٍ أَحمداً","واِغتاله طمع لهم غلاب",33,"ب",1,0],["أَنا للشعر في العرا","ق أَديب مجدِّدُ",34,"د",1,1],["إِنَّ اللَياليَ والايام في عجلٍ","لنا تجدّان أَفراحاً وأحزانا",35,"ن",2,1],["إِنَّ اللَّبيب هُوَ الَّذي","يَرجو البقاء من الجدال",36,"ل",1,0],["أَنَا لِلصَّدِيقِ كَمَا يُحِبُّ وَلِلْعِدَا","عِنْدَ الْكَرِيهَةِ ضَيْغَمٌ زَأَّرُ",37,"ر",1,0],["إن الله حكمة دونها العق","ل فَخَلِّ المِراءَ والترديدا",38,"د",2,0],["إن الليالي حاوَلَت ضَرعَي","فوجدْنَني مُتعسَّرَ الحَلَب",39,"ب",1,0],["أنا للتجاذب نقطة إن سَّرني","لقياكم ساء العراق فراقي",40,"ق",2,0],["أنا، للصَّرورةِ، في الحياةِ، مُقارنٌ،","ما زلتُ أسبحُ في البحارِ المُوَّجِ",41,"ج",1,1],["إنَّ اللَّياليَ والأيامَ قد كَشفَتْ","من كَيْدها كلَّ مسترٍ ومكنونِ",42,"ن",1,0],["أَنَا لِلصَّدِيقِ كَمَا يُحِبُّ، وَلِلْعِدَا","عِنْدَ الْكَرِيهَة ِ ضَيْغَمٌ زءَّارُ",43,"ر",1,0],["إن الليالي يأبى أن يسالمها","عزم امرىء لنزال الدهر مولودِ",44,"د",1,0],["إنَّ اللِّسَانَ إِذَا مَاتَتْ مَعَايِبُهُ","قَامَ المَقَالُ مَقَامَ الشَّذْرِ أغْلَاهُ",45,"ا",2,0],["إنَّ اللَّبِيبَ بَصِيصُ القَصْدِ يُدْرِكُهُ","عِنْدَ الإشَارَةِ يُجْلِي القِشْرَ مَعْناهُ",45,"ا",2,0],["إِنَّ الليالي هاضتنيِ وليس لها","فيما ترى هيضُ عظمٍ أَنت جابره",46,"ر",2,0],["إن اللسان صغير جرمه وله","جرم عظيم كما قد قيل في المثل",47,"ل",1,0],["أنا للعود لسان","حين تُبدْيه القيانَ",48,"ن",1,1],["إنَّ اللياليَ والأيامَ أجدر بال","تأنيبِ ممَّن أطالت ظُلمَةُ النُّوَب",49,"ب",1,0],["أنا للنفس شفاء","أنا للروح بدن",50,"ن",1,0],["إن اللئام تواسيهم نحائزهم","بوابلٍ من هتون اللؤم دفّاقِ",51,"ق",1,0],["إن اللياليَ والأيامَ أطراق","ولا يدومُ لها عَهْدٌ وَمِيثَاقُ",52,"ق",1,1],["إنَّ اللَيالي من أخلافِها الكَدَرُ","وَإن بَدا لك مِنها مَنظَرٌ نَضِرُ",53,"ر",1,1],["إنّ اللّواتي غَدَا حِنَّاؤُهن دَمِي","هُنّ الّلواتي عليهنّ الحشَا كِلَلُ",54,"ل",1,0],["إِنَّ اللَّبِيبَ إِذا ما عَنَّ مَطْلَبُهُ","أَهْوى إِلَيْهِ وَلَمْ يَنْظُرْ بِهِ الرُّخَصا",55,"ص",2,0],["إن اللطافة لم تزل","عند الأكابر فاشيه",56,"ه",1,1],["أنا للفناء فلا تمنّيني بأح","لام الخلود",57,"د",1,0],["أنا للناس قد خلِقت فما أر","جو لنفسي إلا الذي يفضلونا",58,"ن",2,0],["إِنَّ اللَبيبَ إِذا تَفَرَّقَ أَمرُهُ","فَتَقَ الأُمورَ مُناظِراً وَمُشاوِرا",59,"ر",2,1],["انا للعلا أرنو فمالي مطمع","فيك ومالك في حماي ركاب",60,"ب",1,0],["إنَّ اللّياليَ أصبحَتْ بأساؤها","مَغْمورةً للخَلْقِِ في نَعْمائه",61,"ا",3,0],["إن اللئيم على حقارة قدره","لَينال من عِرض الكريم منالا",62,"ل",2,1],["أنَّ اللَّيالي قَد نُهينَ","عَن السُّكُونِ إلى السَّكَن",63,"ن",1,0],["أنا للخُطُوبِ إذا دَعَت أقرانَها","إذ لا يَقولُ لَها أنا إلا أنا",64,"ن",2,0],["أنا لِلنَّوى إن لَم أشُدَّ مع النَّوى","عَزمي إِلى حيثُ التَّفرقُ يفرقُ",65,"ق",1,0],["إن اللسان بشرِِّه","يُفني الملوك مع الممالك",66,"ك",1,0],["إِنَّ اللِئامَ إذا تجاوزَ حدُّها","في اللُؤم ساءَ جَوازُها وجَزاؤُها",67,"ا",3,0],["أنّ اللّواحظَ رُبّما","قتلتْ بأوّلِ نظْرةِ",68,"ه",1,0],["أنا للِسَّيِّدِ الشَّريفِ غُلامٌ","حَيثُما فَلْيُبَلَّغْ سَلامي",69,"ي",1,1],["إنَّ اللسان لمضغةٌ ما لم تفه","بالطيّبات تُلاك بالأشداق",70,"ق",1,0],["إنَّ اللَّيالي حمَّلتني ثقلاً","تنوء من ثقل به شمُّ الذُّرا",71,"ا",1,0],["إنّ الليالي ما ذمَمْتُ صُروفَها","منذُ استجَرْتُ بياسرٍ وذِمامِه",72,"م",2,0],["إن الليالي على صنع القضا سخطت","به ومن زهده بالكاتبات رضي",73,"ض",2,0],["أنا للعروبة أينما وجدت أخ","يسعى لعزتها بكل فخار",74,"ر",1,0],["إن اللسانَ لوصَّالٌ إلى طُرُقٍ","في القلب لا تهتديها الذُّبَّلُ الشُّرُعُ",75,"ع",1,0],["أَنا للطَّريقِ الأَحمَدِيِّ مُجَدِّدٌ","ولنَهْجِ طَهَ المُصْطَفى العَدْنَانِي",76,"ي",1,0],["أنا للمُخْتارِ مُخْتارٌ ولي","طارقٌ في كُلِّ أرضٍ طارقُ",77,"ق",1,0],["أنَا للِنَّدَامَى نُزهَة المُستمتعِ","تَبدُو نُجُومُ سُعُودِهِم في مَطلعِ",78,"ع",1,1],["إن الليالي عوضتني بعدهم","جوار ملك لا يضام جاره",79,"ر",2,0],["إن الليالي أساءت غير عالمة","أن ابن أيوب لي من جورها جار",80,"ر",1,0],["إنّ اللّيالِي في الْمَخَادِرِ قَدْ غَدَتْ","عِنْدِي عَلَى جِيدِ الزَّمانِ لآلِيا",81,"ي",2,1],["إنّ اللّقا أَفْضَلُ إنْ كانَ في","تَعْلِمِ عِلْمٍ لامْرِىءٍ مُسْلِمِ",82,"م",1,1],["أنا للسالك أمٌّ وأبٌ","فتمتع بعلومي يا بُنَيّ",83,"ي",1,0],["إنَّ اللِّسان يُطيعُ أمرَ نصيحهِ","والقلب يَنبذهُ كمَن لم يُؤْمَرِ",84,"ر",1,0],["إِن اللَه لَم يعطه ودها","فَلَن يعطى الود سوط مُمر",85,"ر",1,0],["إنَّ اللَّياليَ وَالأيَّامَ مِنْ غَزَلي","في الحُسْنِ والحُبّ أَبْناءٌ وأَنباءُ",86,"ا",2,0],["أنا لِلْمَجَالِسِ وَالجَلِيسِ أَنيسةٌ","أَزْهَى بِحُسْنٍ نَاظرٍ لِلنَّاظِرِ",87,"ر",1,1]]}