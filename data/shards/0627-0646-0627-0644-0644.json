وق أنفاسٌ وروحٌ","أنا للبعد أنغام التغني",179,"ن",2,0],["أنا للوهمِ منهاج عريقٌ","أنا الآفاق والطيرُ التجني",179,"ن",2,0],["أَنَا لِلْخَيَالِ مَجَرَّةٌ بَرَّاقَةٌ","لَكِنَّ نَجْمِيَ بِالْوَرَى يَتَخَيَّلُ",180,"ل",1,0],["إن الله رجالاً كلما","ذكروه استهونوا قرع الظبى",181,"ب",2,0],["إن الليالي أسفرت عن أمل","لكنه بين الجهاد والنهى",182,"ا",1,0],["أنا للمرأة الضعيفة عمري","مخلص، صادق، وفي العهود",183,"د",1,0],["أنا لله والشقيق أصلي","وأزكي محبة وأصوم",184,"م",1,0],["أنا للحياةِ وكلُّ إيماني بها","أنَّ الحياةَ محبةٌ وكفاحُ .",185,"ح",1,0],["أنا للعراق.. وللعراقِ لسانُهُ","أنّى يراني اليوم يدري من أنا",186,"ن",2,0],["إنّ اللَّيالِي عَجِيباتٌ خَلائِقُها","تَرمِي المحِبَّ بِسَهْمٍ مِنْ تَجَافيهَا",187,"ي",3,0],["أن الله جل له صفات","وأسماء تعالت عن مثال",188,"ل",1,0],["أنا للشامِ محتاجٌ","ومقصّيٌ.. لها جائعْ",189,"ع",1,0],["أنا للنصر محتاجٌ وروحي","به انسكبت لخيرات عظامِ",190,"م",1,0],["أَنَا للهِ قَدْ نَذَرْتُ حُرُوفِي","وَعَلَى اللهِ مَقْصَدِي وَالسَّبِيلُ",191,"ل",1,0],["إن الليالي هكذا في طبعها","تخفي الشموس وليس تأبه بالهلال",192,"ل",1,0],["إنَّ اللسانَ الذي أَجَّتْ مناهِلُهُ","لا يستبين له نصح وإن صحّا",193,"ح",2,0],["أنا لليلِ أحلامُ العذارى","يراودني على حبّي شقاق",194,"ق",1,0],["أنا للحبِّ نادتني الليالي","أهيمُ ولا يداريني اتفاقُ",194,"ق",1,0],["إن اللئيمَ إذا غسّلتَ معدنَهُ","منْ كلّ شائبةٍ لمْ يتركِ الوحَلَا",195,"ل",2,1],["أَنِ اَللَّهُمَّ أَورِثنِي نَعِيما","وَخَيرا مِنْكَ مِلءَ الرَّاحَتَينِ",196,"ن",1,0],["إنّ اللسان أمانة ورسالة","فاحفظ لسانك من مصير آتِ!",197,"ت",1,0],["إن اللبيب إذا ما فاته قنصٌ","يظلّ يرصد حتى يقنص البدَلا",198,"ل",2,0],["إنَّ الليوث التي جالَت بعصركمُ","غيرُ (الليوثِ) التي في عصرِنا هُزموا",199,"م",3,0],["انا للحب حياتي كُلِّها","صُنْت مَعْناهُ وراعيْتُ الأصولا",200,"ل",2,0],["أنا للوصلِ توّاقٌ فهُزّي","إليكِ الجذعٓ في سِفْرً التنائي",201,"ا",3,0],["أنا للعناد مدرب وأنا","أستاذه بل فيه لي رتبهْ !",202,"ب",2,0],["انا للي عاشق بالغي مغرم","غريق في هوا راع القلادة",203,"د",2,0],["إنَّ اللياليَ والأيامَ أجدر بالتأنيبِ","أنيب ممن أطالب ظل