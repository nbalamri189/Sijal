{"poems":[[56,"يا أبا سعد قوصره","https://www.aldiwan.net/poem29374.html","مجزوء الخفيف"],[264,"ليس يخفى ما كان بالحب فاشي","https://www.aldiwan.net/poem35780.html","الخفيف"],[422,"قدحت في مزجها بالماء نارا","https://www.aldiwan.net/poem54186.html","الرمل"],[443,"إن العرين الذي يحتله الأسد","https://www.aldiwan.net/poem2613.html","البسيط"],[482,"قف بي على منزل بالربع قد دثرا","https://www.aldiwan.net/poem15341.html","البسيط"],[482,"حييت من دمن ومن أطلال","https://www.aldiwan.net/poem15352.html","الكامل"],[519,"غربت منكم شموس التلاقي","https://www.aldiwan.net/poem20786.html","الخفيف"],[1200,"","https://poetry.dctabudhabi.ae/diwan/poem/111165","الرجز"],[2362,"","https://poetry.dctabudhabi.ae/diwan/poem/198790","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74097","الخفيف"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111051","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72517","الرمل"],[5150,"نشيد المقاومة ...!","https://www.poetsgate.com/ViewPoem.aspx?id=202934",""],[5376,"لا تكلُّوا يا صحابي","https://www.poetsgate.com/ViewPoem.aspx?id=188464",""],[5956,"يا خالد الحُبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=193695",""],[5956,"احفظ له أكباده يا خالقي","https://www.poetsgate.com/ViewPoem.aspx?id=194229",""],[6102,"سُحقًا لِقَلبكِ ..","https://www.poetsgate.com/ViewPoem.aspx?id=184412",""]],"verses":[["أَجَّجَ العَبدُ نارَهُ","وَهُوَ لِلنارِ كُندُرَه",0,"ر",2,0],["أجّجت نار مهجتي بلهيبٍ","وعليها حامَ الحشا كالفراش",1,"ش",1,0],["أجَّجوا نيرانها يوم الوغى","بمواضيهم وإن كانوا بحارا",2,"ر",2,0],["أججتَ للكفرين من كفيك ملحمة","أضحى بها الموت في حوبائه بخد",3,"د",1,0],["أجَّجتُ نارَ غرامي في ملاعبهِ","بفائضِ الدمعِ في الأطلالِ فاستقرا",4,"ر",2,0],["أجَّجنَ بين أضالِعي نارَ الهوى","بمرابعٍ مِن أهلهنَّ خوالِ",5,"ل",1,0],["أجّجتْ نارَ زَفرتي الفُرقُ فيهمْ","فنشا الدّجنُ من دُخانِ اِحتراقي",6,"ق",2,0],["أججت النار الحروب كرة","دائرة تحت السماء الراكد",7,"د",1,0],["أججت نيران الصدور بكربة","فالدمع بوح والوجوم رداء",8,"ا",2,0],["أَجَّجوا في جَوانحي البرحاء","وَأَثاروا عليّ داءً فداءَ",9,"ا",2,0],["أججت بين جوانحي","ناراً سلبت القلب صبره",10,"ر",2,0],["أججت من فحمة الليل كبى","ملأ الدنيا بنشر العبهر",11,"ر",1,0],["أججْ لهيبَ الجرحِ وابتلعِ الأسى","من ثورةِ الآلامِ ينبثقُ الرجاءْ",12,"ا",2,0],["أجَّج النفس لهيباً","كي تلظَّى بالتهابِ",13,"ب",1,0],["أججْتَ في أدبي يا سيدي شهُباً","قد أطفأتْها مناكيدُ الأعاصيرِ",14,"ر",1,0],["أجّجْتَ فني من حُنوّك عالياً","يا من رأيتك في المعالي ماردا",15,"د",2,0],["أَجَّجتِ قَافِيَتِي بِالجَمرِ فَانتَظِرِي","مِنِّي حَرَيقًا إِذَنْ , وَ استَقبِلِي الشَّرَرا",16,"ر",2,0]]}