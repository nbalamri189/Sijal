{"poems":[[57,"إن يومي بين المغيثة والقرعاء","https://www.aldiwan.net/poem26305.html","الخفيف"],[95,"مليكتانا أدام الله عزهما","https://www.aldiwan.net/poem11199.html","البسيط"],[90,"صاح إن الخطوب في غليان","https://www.aldiwan.net/poem44456.html","الخفيف"],[87,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[64,"يا حادي الظعن رفقا إنك الجاني","https://www.aldiwan.net/poem52253.html","البسيط"],[47,"يوم سبت وعندنا ما كفى الحر","https://www.aldiwan.net/poem10661.html","الخفيف"],[47,"يوم سبت وعندنا ما كفى الحر","https://www.aldiwan.net/poem64542.html","الخفيف"],[18,"هل عرفت الغداة من أطلال","https://www.aldiwan.net/poem23933.html","الخفيف"],[52,"علليني يا عبد أنت الشفاء","https://www.aldiwan.net/poem64888.html","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141950","الخفيف"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/8897","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54281","الكامل"],[164,"يوم سرور وشفاء صدر","https://www.aldiwan.net/poem59024.html","الرجز"],[168,"إنما فازت قداح المنايا","https://www.aldiwan.net/poem67815.html","المديد"],[240,"عسى غزال الأبرق","https://www.aldiwan.net/poem31803.html","مجزوء الرجز"],[255,"ويعود عاشوراء يذكرني","https://www.aldiwan.net/poem14950.html","أحذ الكامل"],[369,"أهكذا يسري القمر","https://www.aldiwan.net/poem60902.html","مجزوء الرجز"],[422,"دنف ذو مهجة في الحب تصدا","https://www.aldiwan.net/poem54128.html","الرمل"],[514,"هل عرفت الغداة من أطلال","https://www.aldiwan.net/poem745.html",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138402",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48868","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63806","الخفيف"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107215","الرمل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202103","الرجز"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80179","الرمل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80188","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79824","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108626","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89373","الرجز"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69904","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90829","الكامل"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105184","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139540",""],[4728,"يوم سلّم","https://www.poetsgate.com/ViewPoem.aspx?id=176949",""],[4987,"عليل وتداوى","https://www.poetsgate.com/ViewPoem.aspx?id=49583",""],[5150,"تموز فجر الشهادة ...!","https://www.poetsgate.com/ViewPoem.aspx?id=204036",""],[5397,"ما لهذا الدهر في الغي تمادى","https://www.poetsgate.com/ViewPoem.aspx?id=157914",""],[5573,"ساقه الله فوق ساقه والقدم","https://www.poetsgate.com/ViewPoem.aspx?id=200221",""],[402,"عز المعالي مات يوسف سابا","https://www.poetsgate.com/ViewPoem.aspx?id=35358",""],[5848,"400 كم","https://www.poetsgate.com/ViewPoem.aspx?id=50615",""],[5848,"تنهيدة قتيل","https://www.poetsgate.com/ViewPoem.aspx?id=50601",""],[6142,"مادت الأرض انقلاباً والسما","https://www.poetsgate.com/ViewPoem.aspx?id=155750",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""]],"verses":[["يَومَ ساروا وَسِرتُ حَيثُ أَراهُم","فَتَمَنَّيتُ أَن يَطولَ المَسيرُ",0,"ر",1,0],["يَوْمُ سَعِيدٌ جَلا لِلحَاشِدِينَ بِهِ","أَسْنَى الرَّوَائِعَ مِنْ حُسْنٍ وَإِحْسَانِ",1,"ن",1,0],["يوم سادوا والعز فيهم يُماشي","ضربهم بالمُشَطَّب الهندواني",2,"ن",2,0],["يَومَ سارَ الصَليبُ وَالحامِلوهُ","وَمَشى الغَربُ قَومُهُ وَالنِساءُ",3,"ا",2,0],["يومٌ سرورٌ ويومٌ بعدَهُ تُرَحٌ","كلاهُما مضمحلٌّ ظِلُّهُ فاني",4,"ن",2,0],["يَومُ سَبتٍ وَعِندَنا ما كَفى الحُرَّ","طَعامٌ وَالوِردُ مِنّا قَريبُ",5,"ب",1,1],["يَومُ سَبتٍ وَعِندَنا ما كَفى الحُرَّ","وَطَعامٌ وَالوَردُ مِنّا قَريبُ",6,"ب",1,1],["يَومَ سِرنا إِلى قَبائِلَ عَوفٍ","بِجُموعٍ زُهاؤُها كَالجِبالِ",7,"ل",1,0],["يَومَ سِلوانَ إِذ يُنادينَني أَق","بِل إِلَينا فَعِندَنا ما تَشاءُ",8,"ا",2,0],["يوم سمّى الرفاقُ سلمى العَروسا","وأرادوا بأن أكون العريسا",9,"ا",1,0],["يَومُ سَعدٍ قَد أَطرَقَ الدَهرُ عَنهُ","خاسِئُ الطَرفِ لا تَراهُ الخُطوبُ",10,"ب",1,1],["يَوْمٌ سَرَتْ فيه البَشَائِر حُوَّماً","تُفْضِي إِلى الدُّنْيَا بسِرُّ عَلاَئه",11,"ا",3,0],["يوم سرور وشفاء صدر","انجز في الأعدا وعيد نحر",12,"ر",1,1],["يَومَ سَقى الدَهرُ أَرواحَ قَومي","تَحتَ ظِلِّ الخافِقاتِ الحُتوفا",13,"ف",2,0],["يَومَ سَرَقنا اللَحَظا","تِ مِن خِلالِ السَرَقِ",14,"ق",1,0],["يَومُ سبيلي حين أذكُرُهَ","ألاَّ يَدورَ الصَّبرُ في خلدي",15,"د",2,0],["يومٌ سُرورٍ من عُمُر","حُسْناً وطِيباً وقِصَر",16,"ر",1,0],["يوم سارت عنك للركب بهم","مشمعلاّت تقدّ السير قدّا",17,"د",2,0],["يَومَ سِرنا إِلى قَبائِلَ عَوفٍ","بِجُموعٍ زُهاؤوها كَالجِبالِ",18,"ل",1,0],["يوم سعيد تجلى يمنه وبدا","في كل آفاق اعراب واخوان",19,"ن",1,0],["يوم ساق العدو جنداً غضاباً","فتملكته وأنت كظيم",20,"م",1,0],["يومَ سبتِ واليومُ أوَّلُ نيسا","نَ ويومُ النيروزِ يومُ السرور",21,"ر",1,0],["يَومَ سَعدِي طالِعٌ فِي حُبِّهِ","يَومَ حَبلُ الوَصلِ مُمتَدٌ بِهِ",22,"ه",1,0],["يوم سعودي وزوال نحسي","مبدأ سعدي وختام نحسى",23,"س",2,0],["يَومَ سارَت سارَ قَلبي ضائِعاً وَلَذا","للآن لَم أَعشَق سِواها",24,"ا",3,0],["يَومٌ سَعيدٌ بِهِ قد قامَ مُنتَصِباً","في سِدَةِ الطَهر حَبرٌ لازمَ الوَرعا",25,"ع",2,0],["يومٌ سرت أسرى كما شاء العدى","فيه الفواطمُ من بني ياسين",26,"ن",1,0],["يومٌ سعيد على الأيام يفتخرُ","بكوكب ناطق ألفظه دررُ",27,"ر",1,1],["يوم سعيد وهو عيد دهرِهِ","بدا لنا ملثَّماً من بشرِهِ",28,"ه",1,0],["يَومٌ سَعيدٌ يَومٌ مَجيدٌ","عيدٌ جَديد يَجلي الصُدور",29,"ر",1,0],["يوم سما قدرا بليلته التي","بلقاك بشرت اللوا والمعهدا",30,"د",2,0],["يوم سارت حموله نحو حزوى","ذاب قلبي أسى وزاد انصداعا",31,"ع",2,0],["يوم سارت آل النبي أُسارى","لكفور وذاك أيُّ مصاب",32,"ب",1,0],["يوم سلّم قلت لا تنتظر ردّ السلام","أنت تعرف ما أبي منك غير تْضمّني",33,"ن",2,1],["يوم ساقوا ركايبهم وشبيت ضوي","ماتخوفت وسباع الخلا لي تعاوى",34,"ا",3,0],["يومٌ سيبقى في الزمانِ منارةً","للجيلِ نورُ حقيقةٍ وضّاحِ",35,"ح",1,0],["يوم سيقت حرم الوحي به","حاسرات في الفلا تطوى الوهادا",36,"د",2,0],["يوم سلم قال انا كلي ندم","قبل احوش الذنب ياوجه السعد",37,"د",1,0],["يوم سابا ما فعلت بأمة","ثكلته دع أهليه والأصحابا",38,"ب",2,0],["يوم سافر قلت خذني معْك يا معشوقي","ويش اسوّي والرياض بناسها ممليّة",39,"ي",2,0],["يوم سافرت وتركت الحدايق للرمال !","ما تخيّل وش بقى لي مع الصبر الطويل",40,"ل",1,0],["يوم سيمت آل طه ذلة","وأبى الله لها إلا الإبا",41,"ا",1,0],["يُوم سعدنا غاب عَنا وَاِنثَنى","وَادَعى سباع البر بِأوشم حال",42,"ل",1,0]]}