{"poems":[[55,"لمن الحدوج تهزهن الأنيق","https://www.aldiwan.net/poem29959.html","الكامل"],[90,"دار ذا الدهر مداره","https://www.aldiwan.net/poem44820.html","مجزوء الرمل"],[74,"عللونا عند النوى بالعناق","https://www.aldiwan.net/poem19354.html","الخفيف"],[53,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[53,"لا وألحاظ العيون الساحره","https://www.aldiwan.net/poem62878.html","الطويل"],[91,"أكبر بفيصل من مليك حازم","https://www.aldiwan.net/poem44730.html","الكامل"],[47,"أطلب النوم كي يعود غراره","https://www.aldiwan.net/poem63577.html","الخفيف"],[71,"ووزير قال يوما","https://www.aldiwan.net/poem28329.html","مجزوء الرمل"],[54,"يا قلب ويحك خنتني وفعلتها","https://www.aldiwan.net/poem27202.html","الكامل"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[50,"حميد ماذا دهاكا","https://www.aldiwan.net/poem66560.html","المجتث"],[52,"الق حربا فحيه","https://www.aldiwan.net/poem63973.html","مجزوء الخفيف"],[102,"","https://poetry.dctabudhabi.ae/diwan/poem/142329","المتقارب"],[92,"الفرات الطاغي","https://www.poetsgate.com/ViewPoem.aspx?id=179148",""],[147,"شرف المعالي من يساجلك العلى","https://www.aldiwan.net/poem11790.html","الكامل"],[276,"عسى من خفي اللطف سبحانه لطف","https://www.aldiwan.net/poem52135.html","الطويل"],[276,"تجلت لوحدانية الحق أنوار","https://www.aldiwan.net/poem52137.html","الطويل"],[369,"البحر أجمع لو غدا أنقاسي","https://www.aldiwan.net/poem60869.html","الكامل"],[369,"طرقت بليل من سناها مقمر","https://www.aldiwan.net/poem60912.html","الكامل"],[398,"شيب لغير أوانه يعتاد","https://www.aldiwan.net/poem53667.html","الكامل"],[438,"سافر إذا حاولت قدرا","https://www.aldiwan.net/poem12635.html","مجزوء الكامل"],[457,"كلما جدد الشجي ادكاره","https://www.aldiwan.net/poem13758.html","الخفيف"],[458,"تبارك الله هل كافور فنان","https://www.aldiwan.net/poem61601.html","البسيط"],[466,"جانبا لومي وخافا لددي","https://www.aldiwan.net/poem16116.html","الرمل"],[466,"يفضل الصارم في عزمته","https://www.aldiwan.net/poem16119.html","الرمل"],[466,"وكريم الملتقى ذو لسن","https://www.aldiwan.net/poem16152.html","الرمل"],[466,"تتبارى أقلامه وقناه","https://www.aldiwan.net/poem16166.html","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87060","الكامل"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99973","الخفيف"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145850","المتقارب"],[1174,"","https://poetry.dctabudhabi.ae/diwan/poem/205974","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64586","الرجز"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137855",""],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11901","الخفيف"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202142","الرمل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27935","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77339","البسيط"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120605","الكامل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58256","الكامل"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104671","الرمل"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91195","الكامل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85244","البسيط"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128900","المجتث"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135727","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72786","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139677",""],[4689,"دوح المدائح","https://www.poetsgate.com/ViewPoem.aspx?id=152847",""],[4722,"وأن نفخة اسرافيل ثانية","https://www.poetsgate.com/ViewPoem.aspx?id=26474",""],[4755,"وهذا هُوَ الحَالُ يا (مَارِسُ)","https://www.poetsgate.com/ViewPoem.aspx?id=184700",""],[1536,"بَارَكَ اللهُ لِلأَمِيرِ أَبِي الْعب","https://www.poetsgate.com/ViewPoem.aspx?id=85707",""],[4927,"جرائم الديكتاتورية","https://www.poetsgate.com/ViewPoem.aspx?id=80801",""],[5055,"المهر","https://www.poetsgate.com/ViewPoem.aspx?id=106076",""],[5174,"حوار مع شاعرة","https://www.poetsgate.com/ViewPoem.aspx?id=187134",""],[5431,"شهاب الشعر والأدب","https://www.poetsgate.com/ViewPoem.aspx?id=198555",""],[1547,"قف بجيرون أو بباب البريد","https://www.poetsgate.com/ViewPoem.aspx?id=16746",""],[5845,"تجلتْ لوحدانية ِ الحقِّ أنوارُ","https://www.poetsgate.com/ViewPoem.aspx?id=15448",""],[5377,"لحظات الإشراق الفني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79566&r=&rc=22",""]],"verses":[["وَوَزَنتَ بِالقِسطاسِ غَيرَ مُراقَبٍ","وَالعَدلُ مَهجورُ الطَريقِ مُطَلَّقُ",0,"ق",1,0],["ووزيرٍ ملحق كالذَي","لِ في عجز الحماره",1,"ر",2,0],["ووزير في مصر جاء مرجيّ","ه وغنَّى بمدحه في عراق",2,"ق",1,0],["ووزيرنا ذاك السفي","ر فَمن سواه نستميرُ",3,"ر",1,0],["ووزير عمَّر الدنيا لكم","ولقد كانت خلاف العامره",4,"ر",2,0],["ووزارة الحزم الرشيدة ابرزت","اثر الكفاءة ايما ابراز",5,"ز",1,0],["وَوَزيرُ السُلطانِ يَملِكُ أَن يَخ","لُصَ لي رُقُّهُ وَتَدنو دِيارُه",6,"ر",2,0],["ووزيرٍ قالَ يوماً","ولهُ وجهٌ منيرُ",7,"ر",1,1],["وَوَزارَةٍ كانَت عَلَيكَ حَريصَةً","حَتّى أَتَتكَ فَم تَزِدكَ وَزِدتَها",8,"ت",3,0],["وَوَزيرِ ابن عَمِّه في المعالي","ومِنَ الأهلِ تُسْعَدُ الوُزَراءُ",9,"ا",2,0],["ووزّةَ ابنِ تبيع","منوطةً من وراكا",10,"ك",2,0],["وَوَزَنّاهُ بِالكِرا","مِ فَساوى وَقَد رَجَح",11,"ح",1,0],["ووزّعت النور في العالم","ين وجادت على العبد والسيّد",12,"د",1,0],["ووزّع الماءَ عدلاً في مسايله","فكلُّ ناحيةٍ يجري بها نَهَر",13,"ر",1,0],["وَوَزيرُ مُلكٍ ظَلَّ وَصفُكَ دَأبَهُ","عِندَ الخِلافَةِ دائِماً لَن يَخجَلا",14,"ل",2,0],["ووزن جِبال كَم مَثاقيل ذرة","وَكيل بحار لا يغيضها نزف",15,"ف",1,0],["ووزن جبال كم مَثاقيل بنوره","دراها وكيل البحر والبحر تيار",16,"ر",1,0],["ووزيرُ صِدْقٍ مُصطَفيهِ خليفةٌ","منه الهُدَى في ظِلِّ طَوْدٍ راس",17,"س",1,0],["ووزيرُ صِدْقٍ جازَ في دَرَج العُلا","غاياتِ كُّلِ مُملَّكٍ ومُؤزَّر",18,"ر",1,0],["وَوَزيرُهُ وَأَثيرُهُ وَنَصيرُهُ","أَسَدٌ تَزِلُّ لِبَأسِهِ الآسادُ",19,"د",1,0],["ووزيرَ مملكةٍ غدا","وَزَراً لها وسِواهُ وِزْرا",20,"ر",2,0],["ووزيرٍ قد بات يسترق اللذا","تِ وهنا والليلُ مرخٍ إِزاره",21,"ر",2,0],["ووزعوا تهمَ التلفيقِ صارخةً","بالزورِ فاستعبدَ الأحرار عبدان",22,"ن",1,0],["ووزيرٌ سابِغٌ إِحْسانُهُ","ليسَ بالنِّكْسِ ولا بالمُسْنَدِ",23,"د",1,0],["ووزيرٌ يَأرَجُ الدَّهْرُ به","أرَج التَّجْرِ يَفُضُّونَ العِطارا",24,"ر",2,0],["ووزيرٌ أصْغَرَ الدُّنْيا فلمْ","يُلْهِهِ منها غُرورٌ وأمَلْ",25,"ل",1,0],["ووزيرٌ عارٍ من العارِ لكنْ","هو كاسٍ من المَناقِبِ حالِ",26,"ل",1,0],["وَوزارة الحَرب اِزدَهَت مِن رستم","بحميد سَير في الجُنود قَويم",27,"م",1,0],["وَوَزِيرَيْنِ جَهَّزِانِي بجُودٍ","تَعَّشَانِي بذَلِكَ التَّجْهِيزِ",28,"ز",1,0],["وَوُزِّعَ جرحُكَ بينَ الجُيوب","وتُوجِرَ في دمِهِ الشاحِبِ",29,"ب",1,0],["ووَزْنُ كل امرئ ما كان يُحسنه","والجاهلون لأهل العلم أعداءُ",30,"ا",2,0],["ووزنه ستة أرطالٍ وَزِد","مقدار نصف الرطل آساً قد عُهِد",31,"د",1,0],["ووزن أسمائك عجل المدد","والنصر والتفريج والفتح القريب",32,"ب",1,0],["ووزعي في سبيل الله مرحمة","عن نفس سمعان من فحواك مرجانا",33,"ن",2,0],["وَوَزيرٍ في الفَضلِ أَوفى مِنَ الفَضلِ","بنِ يَحيى في ظِلِّ مُلكِ الرَشيدِ",34,"د",1,0],["ووزيرٍ ثقلت أوزاره","شد أزر الفئة المستعمرين",35,"ن",1,0],["ووزنُ ربِّك عدلٌ جلّ عن غرض","يقيم ميزانَه بَرٌّ ومحسانُ",36,"ن",1,0],["وَوَزَّعَ الفَيءَ تَأليفَ القُلوبِ عَلى","قِسطاسِ عَدلٍ رِضاءَ اللَهِ مُرتَسِمِ",37,"م",1,0],["ووزارةٌ بُنِيَت على رِضوانِهِ","كَرُمَت شَمائِلُهَا وطابَ العُنصُرُ",38,"ر",1,1],["ووزيره الفخرُ الذي قد خوّلا","بالمنتمي فخراً على النظار",39,"ر",1,0],["وَوَزيرِ المُصطَفى خَيرِ الوَرى","وَأَخيهِ حَيدَرٍ مُروي القَنا",40,"ن",2,0],["ووزن ذلك انفق صاح متحسبا","واعط المساكين منه مع ذوي رحم",41,"م",1,0],["وَوَزنُ مَثنَى وَثًلاثَ كهُمَا","مِن وَاحِدٍ لأربَعٍ فَليُعلَمَا",42,"م",2,0],["وَوَزيرنا رَب العُلا","ذو الطُول وَالحَزم الأَكف",43,"ف",1,0],["ووزن أعمالهم حقّاً فإن ثقلت","بالخير فاز وإن خفف فقد خرا",44,"ر",2,0],["ووزعوا فضلهم","على جميع الانام",45,"م",1,0],["ووِزر ذي المنِّ يرى أكثر من","أجرٍ لما من صدقاته يمُنْ",46,"ن",1,0],["ووزيرٌ بالعدلَ في الموصلِ الخضرا","ءِ في حفظِ ذي الجلالِ المجيد",47,"د",1,0],["ووزيرٌ وليس وزرٌ عليه","إنما الوزر عنده مأسور",48,"ر",1,0],["ووزن عرش المليكِ الحقِّ كتلته","وكالزمان الذي يجري من القِدَمِ",49,"م",1,0],["ووزن أعمالهم حقا فإن ثقلت","بالخير فاز وإن خفت فقد خسرا",50,"ر",2,0],["ووَزِّعْ عَذَابَاتِ رُوحِي عَلى","بِلادٍ بِهَا يُحْصَدُ الغَارِسُ",51,"س",1,0],["وَوَزِيرَيْنِ جَهَّزِانِي بجُودٍ","نَعَّشَانِي بذَلِكَ التَّجْهِيزِ",52,"ز",1,0],["وَوِزَاْرَةُ الزُّعْرَاْنِ شَرُّ وِزَاْرَةٍ","بِئْسَ الْوَزِيْرُ اللِّصُّ وَالْمُسْتَوْزِر",53,"ر",1,0],["ووزع على باقي الفريق","كل واحدٍ ثوب ونعال",54,"ل",1,0],["ووزناً صارماً لا بد منه","وقافيةً تُقيدني عَضوضا",55,"ض",2,0],["ووزن الشعر منفعلٌ","ببحر منك مضطربِ",56,"ب",1,0],["ووزير في الفضل أوفى من الفضل","ن يحيى في ظل ملكِ الرشيدِ",57,"د",1,0],["ووزنَ جبالٍ كمْ مثاقيلَ ذرة ٍ","ذراها وكيلُ البحرِ والبحرُ تيارُ",58,"ر",1,0],["ووزن تحمل ثقل الجبال","...يقسم في طيه أن تذوبا",59,"ب",2,0]]}