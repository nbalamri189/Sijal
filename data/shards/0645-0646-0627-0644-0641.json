ps://www.poetsgate.com/ViewPoem.aspx?id=197517",""],[5431,"أنثى ..","https://www.poetsgate.com/ViewPoem.aspx?id=206343",""],[5431,"إياك أن تقعا","https://www.poetsgate.com/ViewPoem.aspx?id=207941",""],[5528,"صلاة دافئة في محراب نوفمبر","https://www.poetsgate.com/ViewPoem.aspx?id=201275",""],[5545,"هنا أقفُ","https://www.poetsgate.com/ViewPoem.aspx?id=195409",""],[5605,"مرثية النهر البارد","https://www.poetsgate.com/ViewPoem.aspx?id=159817",""],[5616,"عامان","https://www.poetsgate.com/ViewPoem.aspx?id=205247",""],[5618,"في جبة التأويل ..عراق الصمود","https://www.poetsgate.com/ViewPoem.aspx?id=208921",""],[5732,"الملحمة الزايدية","https://www.poetsgate.com/ViewPoem.aspx?id=177865",""],[5736,"رسائل الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=208459",""],[5751,"شَكوى مُسافر","https://www.poetsgate.com/ViewPoem.aspx?id=214716",""],[5751,"أنا وأنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=215023",""],[5791,"يا ضم ..!","https://www.poetsgate.com/ViewPoem.aspx?id=209034",""],[5845,"لكلِّ خطبٍ مهمٍّ حسبيَ اللهُ","https://www.poetsgate.com/ViewPoem.aspx?id=198425",""],[5851,"شهقة السنديان","https://www.poetsgate.com/ViewPoem.aspx?id=175298",""],[5939,"طوفان لهفة","https://www.poetsgate.com/ViewPoem.aspx?id=178596",""],[1920,"ستنجلي","https://www.poetsgate.com/ViewPoem.aspx?id=198589",""],[5952,"لك يا عراق","https://www.poetsgate.com/ViewPoem.aspx?id=207803",""],[5956,"الاشتهاء","https://www.poetsgate.com/ViewPoem.aspx?id=181904",""],[5966,"الطائف","https://www.poetsgate.com/ViewPoem.aspx?id=158861",""],[6352,"حزت بالكاظمين شأنا كبيرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22745&r=&rc=6",""]],"verses":[["مِنَ الفِتيانِ مُحلَولٍ مُمِرٌّ","وَأَمَارٌ بِإِرشادٍ وَغَيِّ",0,"ي",1,0],["من آل فضل الله والقوم الأولى","زانوا الزمان وكان مثل مشوّه",1,"ه",1,0],["مِنَ الفِتيانِ لابَهِجٌ بِدُنيا","وَلا جَزِعٌ إِذا الحَدَثانُ نابا",2,"ب",2,0],["مِنَ الفَرنسيسِ قَيدَ العَينِ صورَتَها","عَذراءَ قَد مُلِأَت أَجفانُها حَوَرا",3,"ر",2,1],["مِنَ الفائِقِ المَحبوسِ عَنهُ لِسانُهُ","يَفوقُ وَفيهِ المَيِّتُ المُتَكَنَّفُ",4,"ف",1,0],["مِنَ الفَاتِنَاتِ الْغِيدِ لَوْ مَرَّ ظِلُّهَا","عَلَى قَانِتٍ دَبَّتْ بِهِ سَوْرَةُ الْوَجْدِ",5,"د",1,0],["مَن الفظاعةِ أنْ تُريدَ رَعيَّةٌ","في ظِلِّ دُستورٍ لها وشِعار",6,"ر",1,0],["من الفرنسيس قيد العين صورتها","عذراء قد ملئت أجفانها حورا",7,"ر",2,1],["من الفجر حتى الفجر ننجرّ كالرّحى","الي أين يا مسرى ومن أين يا ضحى",8,"ح",2,1],["من الفاطميين الايمة غرة ال","مفاخر روح الكون دورا على دور",9,"ر",1,0],["من الفاطميين الشموس التي انجلت","بسمك التجلي في بروج النبوة",10,"ه",1,0],["من الفاطميين الجحا حجة الاولى","شموس المعالي غوث كل كئيب",11,"ب",1,0],["من ألفِ دَهرٍ وألفِ دُنيا","سَمَوا إلى المَشرَعِ الحقيقي",12,"ي",1,0],["مِن آلِ فَضلٍ بُناةِ المَجدِ تَعرِفُهُ","كُلُّ القَبائِلِ مِن ناءٍ وَمُقتَرِبِ",13,"ب",1,0],["مِن آلِ فَرعونَ كَريمٌ قَد سَقى","مَثواهُ دَمعٌ بِالدِماءِ يَسيلُ",14,"ل",1,1],["مِنَ الفاعِلي الإِحسانِ ما أَنْفكَّ دَأبُهُ","إِلى أَن جَرى في الناسِ صَوتُ نَعيِّهِ",15,"ي",2,0],["مِنِ آل فَياضٍ عَزيزٌ ماجِدٌ","كَالغُصنِ مِن ريحِ المَنيَّةِ يُكسَرُ",16,"ر",1,1],["مِن آلِ فَيّاضَ شَهمٌ قَد قَضى فَثَوى","قَبراً سَقَتهُ المَآقي مِن دَمِ المُهَجِ",17,"ج",1,1],["مِن آلِ فكَّاكٍ عَزيزٌ راحلُ","يُسقى ثَراهُ بِالدُموعِ الذُّرَّفِ",18,"ف",1,1],["مِن آلِ فَوّازَ قَد فازَت يَداهُ بِما","سَعى لَهُ مِن ثَوابِ الخالقِ الأَزَلِي",19,"ي",1,0],["مِن آلِ فَيّاضَ مَن فاضَت مَدامِعُهُم","مِن بَعدِهِ بِدَمٍ كَالسَيلِ مَصبوبِ",20,"ب",1,0],["مِن آلِ فَرنيني الأَكارِمَ ماجدُ","أَجرى المَدامِعَ بِالدِماءِ رَحيلُهُ",21,"ل",2,1],["من ألف فلس وألف ألف عصا","لو أحصيت في أقل ديوانه",22,"ن",2,0],["مِنَ الْفَضْلِ وَالتَّوْفِيقِ فَاللهُ يَجْتَبِي","إِلَيْهِ الذِي يَخْتَارُهُ مِنْ مُوحِّدِ",23,"د",1,0],["من الفخَّارِ قد سخرت وقالت","أعدُّوا لي إناءً مَرمَريسا",24,"س",2,0],["من الفرنسيسِ بلوانا ونكبتُنا","فهل يظلّونَ فينا مستبدّينا",25,"ن",2,0],["من الفرنجِ أرى الإسلامَ في خطرٍ","ولليهود انتهاكٌ بعد إنهاك",26,"ك",1,0],["من آل فاطمة لزهراء ذو شرف","أَتى به الدهر فردا عَن مثناه",27,"ا",2,0],["من الفواطم في الأَغلال خاشعةً","يُحدى بهنَّ على الأَقتاب والكورِ",28,"ر",1,0],["من آل فاطمة بيض الوجوه له","إلى المكارم سعى المسرع العجل",29,"ل",1,0],["من الفاطميين الدعاة إلى الهدى","قد انتهجوا في نهج خير إمام",30,"م",1,0],["مِن الفاختياتِ لَمَّا بَدَتْ","بِها طَلْعَةُ البَدْرِ كانتْ سَماءَ",31,"ا",2,0],["من الفُرْسِ فُرسانُ الحديثِ ومن غدَتْ","أواخرُهُم ممدوحةٌ والأوائلُ",32,"ل",1,0],["من الفقر التي تبني المعالي","ويستغني بها الحسب الفقير",33,"ر",1,0],["من الفخر هل فاتتك يوماً شوارد","أو الشكر هل طافتك آنا فرائد",34,"د",1,1],["من آل فيَّاض الأَكَارم قد مَضَت","عَجَلاً وأَبقت نارَ حزنٍ تُضرَمُ",35,"م",1,1],["من الفتح بكران بدت تسحر النبي","وتومي إليها بالسجود المسامع",36,"ع",1,0],["من الفستقِ الشاميِّ كلّ مصونةٍ","تُصانُ من الأحداقِ في بطن تابوت",37,"ت",1,0],["من الفاطميين الدعاة إلى الهدى","به البيت يزهو والمقام وزمزم",38,"م",1,0],["مِنَ الفراقِ وَالنّوى","إِنَّ النّوى مُرُّ المَذاق",39,"ق",1,0],["مِنَ الفَراسِخِ عَشرٌ حينَما هَربوا","كَأَنّها حينَما يَمشونَها ميلُ",40,"ل",1,0],["مِن الفتيانِ اقذفُ كلَّ عَبدٍ","بحربٍ ليس فيهنّ اعتِذارُ",41,"ر",1,0],["مِن الفُرات إِلى البَحر المُحيط فَما","بَينَ العِراقين مِن نَجد وَبَطحاء",42,"ا",2,0],["مِنَ الفَعَالِ وَالدَسِيع الأَعْظَمِ","فَما ظَلَمْتَ الناسَ بِالتَجَهضُمِ",43,"م",1,0],["من الفراديس قد جاءت مسلسلةً","تروي الظوامي بمروى عذب مسقاها",44,"ا",3,0],["من الفاطميين الذين تراضعتْ","قناهم على الأعداء في كلِّ مازق",45,"ق",1,0],["من الفخار بنى بيتاً ومد له","من المحامد في الآفاق اطنابا",46,"ب",2,0],["مِن ألفِ وَجهٍ أو قِرِيبِ الألفِ يُح","صِيهَا الذِي يُعنَي بهَذَا الشَّانِ",47,"ن",1,0],["مِن الفَيلَقُ الجَرّار كَاليمّ زاخِراً","تَدَفَّعُ كَالأَمواج فيهِ الفَوارس",48,"س",1,0],["مِنَ الفَتَياتِ الغُرِّ مِن أَرضِ بابِلٍ","إِذا صَبَّها الحانِيُّ في الكَأسِ كَبَّرا",49,"ر",2,0],["مِن الفَقير كاتب المَواقف","إِلى الإِمام الأَلمعي العارف",50,"ف",1,1],["من الف الضدين باكيا اسى","وساجعا من السرور ناغما",51,"م",2,0],["من الفائزون ومن ذا الذي","على جيشه كانت الدائرة",52,"ر",2,0],["من الفحش معصوم وللجيش عاصمٌ","بذي العرش مكروم من البطش منجد",53,"د",1,0],["منَ الفِرارِ إلى 