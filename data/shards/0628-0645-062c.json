{"poems":[[55,"بمجال عزمي يملأ الملوان","https://www.aldiwan.net/poem29659.html","الكامل"],[55,"غالى بها الزائد حتى ابتاعها","https://www.aldiwan.net/poem30152.html","الرجز"],[32,"خليلي عوجا عوجة","https://www.aldiwan.net/poem29570.html","الطويل"],[4,"أرى النفس لجت في رجاء مكذب","https://www.aldiwan.net/poem21149.html","الطويل"],[53,"صبرا على أشياء كلفتها أعقبتها الآن وسلفتها","https://www.aldiwan.net/poem8691.html","السريع"],[53,"أمامك فانظر أي نهجيك تنهج","https://www.aldiwan.net/poem9253.html","الطويل"],[31,"صحا القلب عن أروى وأقصر باطله","https://www.aldiwan.net/poem6057.html","الطويل"],[16,"ذهبت من الهجران في غير مذهب","https://www.aldiwan.net/poem27693.html","الطويل"],[47,"ربع خلا من بدره مغناه","https://www.aldiwan.net/poem66856.html","الكامل"],[68,"ما هبت الريح إلا هزني الطرب","https://www.aldiwan.net/poem40984.html","البسيط"],[46,"يا موضع الشدنية الوجناء","https://www.aldiwan.net/poem30593.html","الكامل"],[42,"أفي رسم دار دمعك المتحدر","https://www.aldiwan.net/poem42309.html","الطويل"],[50,"هلا استعنت على الهموم","https://www.aldiwan.net/poem65095.html","مجزوء البسيط"],[52,"غدا مالك بملاماته","https://www.aldiwan.net/poem24445.html","المتقارب"],[38,"","https://poetry.dctabudhabi.ae/diwan/poem/72213","الطويل"],[38,"أَتاني مِنَ الأَنْباءِ أَنّ عَشِيرة ً","https://www.poetsgate.com/ViewPoem.aspx?id=15883",""],[136,"لعمرك ما مقلاء عود عودها","https://www.aldiwan.net/poem54852.html","البسيط"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[199,"أطربت أم رفعت لعينك غدوة","https://www.aldiwan.net/poem54404.html","الكامل"],[199,"ألمم على طلل عفا متقادم","https://www.aldiwan.net/poem54417.html","الكامل"],[199,"عرف الديار توهما فاعتادها","https://www.aldiwan.net/poem54421.html","الكامل"],[208,"بمجاري فلك الحسن","https://www.aldiwan.net/poem53058.html","مجزوء الرمل"],[208,"قد كنت فزت بمن أهوى وآنسني","https://www.aldiwan.net/poem53127.html","البسيط"],[214,"ظن العواذل أسلو طيب رياك","https://www.aldiwan.net/poem13564.html","البسيط"],[240,"وأغيد ما عنه للصب صبر","https://www.aldiwan.net/poem32000.html","المتقارب"],[240,"لك النهي بعد الله في الخلق والأمر","https://www.aldiwan.net/poem32009.html","الطويل"],[285,"بقاؤك أوفى اقتراح الأماني","https://www.aldiwan.net/poem60693.html","المتقارب"],[368,"أبيت اللعن والراعي متى ما","https://www.aldiwan.net/poem1693.html","الوافر"],[435,"أرج الصبابة من ثنائك عارف","https://www.aldiwan.net/poem40081.html","الكامل"],[466,"شكرا لدهري بالضمير وبالفم","https://www.aldiwan.net/poem15142.html","الكامل"],[466,"أأترك محيي العدل والشوق قائدي","https://www.aldiwan.net/poem15921.html","الطويل"],[466,"أقول لصحبي والمقال تكعه","https://www.aldiwan.net/poem16163.html","الطويل"],[505,"أفيضوا لنا يا أهل أم عبيدة","https://www.aldiwan.net/poem38012.html","الطويل"],[505,"رفعت بسري كل أمري لسيدي","https://www.aldiwan.net/poem38020.html","الطويل"],[511,"ويوم تضوع الشمس حليا بحسنه","https://www.aldiwan.net/poem2471.html","الطويل"],[566,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[566,"أما ورب البيت لو لم أشغل","https://www.aldiwan.net/poem27840.html","الرجز"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103099","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53922","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48825","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38707","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38407","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59722","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62613","الطويل"],[1031,"","https://poetry.dctabudhabi.ae/diwan/poem/216900",""],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35403","الطويل"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101993","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56172","المتدارك"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64755","الوافر"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136289","الوافر"],[1317,"","https://poetry.dctabudhabi.ae/diwan/poem/146949","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49963","المتقارب"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79941","الوافر"],[1782,"","https://poetry.dctabudhabi.ae/diwan/poem/128736","البسيط"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66295","الكامل"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100449","الوافر"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102103","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53195","السريع"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109448","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109376","الرمل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132362","الوافر"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100901","الوافر"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137408",""],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116509","الطويل"],[2821,"","https://poetry.dctabudhabi.ae/diwan/poem/100542","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100402","البسيط"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58264","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201767","الوافر"],[3015,"","https://poetry.dctabudhabi.ae/diwan/poem/199441","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133972","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89118","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74103","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48312","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86240","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111446","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86377","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119600","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90848","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90744","الطويل"],[4480,"","https://poetry.dctabudhabi.ae/diwan/poem/28927","الكامل"],[4483,"","https://poetry.dctabudhabi.ae/diwan/poem/101285","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139580",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139637",""],[4649,"","https://poetry.dctabudhabi.ae/diwan/poem/101937","الرجز"],[5102,"أطوار حرب العزة","https://www.poetsgate.com/ViewPoem.aspx?id=12862",""],[5102,"دعاء الصباح في هجاء \"نور الفلالح\"","https://www.poetsgate.com/ViewPoem.aspx?id=59818",""],[5136,"ريحاننا لا إله إلا الله","https://www.poetsgate.com/ViewPoem.aspx?id=121768",""],[5155,"في ذكرى الرصافي","https://www.poetsgate.com/ViewPoem.aspx?id=176479",""],[5206,"حب الله","https://www.poetsgate.com/ViewPoem.aspx?id=187390",""],[5444,"براعمُ الصخر","https://www.poetsgate.com/ViewPoem.aspx?id=205070",""],[5776,"سرةٌ تبلعُ ذقنَ المصباح","https://www.poetsgate.com/ViewPoem.aspx?id=199337",""],[5851,"زنبقة من بقايا الصلصال","https://www.poetsgate.com/ViewPoem.aspx?id=175251",""],[5956,"وتعاونوا على البِرِّ والتقوَى","https://www.poetsgate.com/ViewPoem.aspx?id=194825",""],[6056,"عديم المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=130516",""],[199,"لولاَ الحياءُ وأنَّ رأسيِ قدْ عثا","https://www.poetsgate.com/ViewPoem.aspx?id=22434",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"]],"verses":[["بِمَجالِ عَزمي يُملَأُ المَلَوانِ","وَتَضَلَّ فيهِ بَوائِقُ الأَزمانِ",0,"ن",1,1],["بِمَجدِهِ وَالعِزِّ مِن أَيّامِهِ","مَدَّت إِلى نَيلِ العُلى أَضباعَها",1,"ع",3,0],["بِمَجلوزَةِ الأَفخاذِ بَعدَ اِقوِرارِها","مُؤَلَّلّةِ الآذانِ عُفرٍ نَزائِعِ",2,"ع",1,0],["بِمُجتَزَفٍ جَونٍ كَأَنَّ خَفائَهُ","قَرا حَبَشِيٍّ في السَرَومَطِ مُحقَبِ",3,"ب",1,0],["بمجد آبائك أسَّستُها","ومجدِ آلائك شرَّفْتُها",4,"ت",3,0],["بمَجرٍ تضيق الأرضُ من زفَراته","له زَجَلٌ ينفي الوحوشَ وهَزْمَجُ",5,"ج",1,0],["بِمُجتَمِعِ التَلعَينِ خوصاً تَلُفُّها","هَواجِرُ وَقّادٍ رَكودٍ أَصائِلُه",6,"ل",2,0],["بِمُجفَرةِ الجَنبَينِ حَرفٍ شِمِلَّةٍ","كَهَمِّكَ مِرقالٍ عَلى الأَينِ ذِعلِبِ",7,"ب",1,0],["بِمُجَنَّبٍ رَحبِ الفُروجِ مُشَذَّبٍ","نابي القَذالِ حَديدَةٍ أُذُناهُ",8,"ا",2,0],["بِمَجلِسٍ لَو رَآهُ اللَيثُ قالَ بِهِ","يا نَفسِ في مِثلِ هَذا يَلزَمُ الأَدَبُ",9,"ب",1,0],["بِمَجامِعِ الثَغرَينِ ما يَنفَكُّ مِن","جَيشٍ أَزَبَّ وَغارَةٍ شَعواءِ",10,"ا",2,0],["بِمُجتَمَعِ الرَضمَينِ غَيَّرَهُ البِلى","وَنَكباءُ تُزجى خارِجَ المُورِ صَرصَرُ",11,"ر",1,0],["بِمَجالِسِ فيها المَزا","هِرُ وَالأَوانِسُ كَالنُجومِ",12,"م",1,0],["بِمَجلِسِ يَومٍ سَأوفي بِهِ","وَلَو أَجلَبَ الناسُ أَحوالِيَه",13,"ل",3,0],["بمَجْدٍ إذا المرءُ اللّئيمُ أرادَهُ","هَوى دُونَهُ في مَهْبَلٍ ثم عَضَّلا",14,"ل",2,0],["بمجد إذا المرء اللئيم أراده","هوى دونه في مثبل ثم عضلاَ",15,"ل",2,0],["بِمُجدَيَةِ شيئاً يسودُ بِه الفَتَى","إِذَا اشتَبَهتُ بيضُ المَعَاني وُسودُها",16,"د",3,0],["بِمَجمعِ بحرَيها أئمّتنا اِلتقَوا","وَما خَرجوا عَنها بل اِستَخرجوا الدرّا",17,"ر",2,0],["بِمَجامِعِ المِصرَينِ حَيثُ تَلاقَيا","فَرعٌ مَجامِعُ شُعبَتَيهِ أَصيلُ",18,"ل",1,0],["بِمَجَرِّ أَهبِرَةِ الكِناسِ تَلَفَّعَت","بَعدي بِمُنكَرِ تُربِها المُتَراكِمِ",19,"م",1,0],["بِمَجَرِّ مُرتَجِزِ الرَواعِدِ بَعَّجَت","غُرُّ السَحابِ بِهِ الثِقالُ مَزادَها",20,"د",3,0],["بمجاري فَلَكِ الحُس","نِ التي في وجناتِكْ",21,"ك",1,1],["بمجلسٍ كان مُلتَذّاً فنغَّصَه","ما كان من طَفِسٍ لا كان ذا جَلَسا",22,"س",2,0],["بمجلس فيك مذ شببت ملت هوى","فكيف لو كان هذا عند مغناك",23,"ك",1,0],["بِمَجدِهِمُ شَرُفَت في القَديمِ","قُرَيشٌ وَسادَت عَلى الناسِ فِهرُ",24,"ر",1,0],["بِمَجدِهِمُ سادَت قُرَيشٌ وَهاشِمٌ","وَمِن قَبلُ ما سادَت كُنانَةُ وَالنِضرُ",25,"ر",1,0],["بِمَجْدِكَ يا ثالِثَ النَّيِّرَيْنِ","وَثانِي الْحَيا يَفْخَرُ النَّيِّرانِ",26,"ن",1,0],["بِمَجرٍ تَهِلكُ البَلقاءُ فيهِ","فَلا تَبقى وَنودي بِالرِكابِ",27,"ب",1,0],["بمجالس العلم الشريف مشرف","وبمجلس الأحكام فهو النائف",28,"ف",1,0],["بمجردِ الأيامِ في حالاته","علاَّمةٍ بالدهْرِ غيرِ مُعَلَّمِ",29,"م",1,0],["بمجدِ عمادِ الدين والضارب الطُّلى","اذِ الدَّمُ أرضْ والسماءُ صعيدُ",30,"د",1,0],["بمُجْتَمَع الفخرين من فرع مالكٍ","وحنظلةٍ والمجدُ تسمو فَوارعُهْ",31,"ع",2,0],["بِمَجْلى مَعاني خَلْوةٍ ضمنَ جَلْوَةٍ","لكُمْ دونَها الدُّنيا النَّضيرةُ والأُخرى",32,"ر",2,0],["بِمَجْلى شُعاعٍ من قُلوبٍ تَرَوْحَنَتْ","بِشُكْركَ في الأسحارِ مولايَ والذِّكْرِ",33,"ر",1,0],["بِمَجلِسِ أُنسٍ وَدَّتِ الشَّمسُ لو تَرَى","كُؤُوساً بِهَا بَينَ النَّدَامى فتَشرَبُ",34,"ب",1,0],["بِمُجمَعِ الروحِ إِذا الحامي اِنبَهَر","يُمَكِنُ السَيفَ إِذا الرُمحُ اِنأَطَر",35,"ر",1,0],["بِمِجدَلٍ وَنِعمَ رَأسُ المِجدَلِ","عَلَيهِ بِاللهِ بَلاغُ الرُحَّلِ",36,"ل",1,0],["بمجمل القول إلى عليّ","بظاهر الحكم من النبي",37,"ي",1,0],["بمجموع أسماء وذات ووصفها","تنزل رحمان الوجود على خبر",38,"ر",1,0],["بمجاهدين أعزّة قد عُوِّدوا","حمل القنا والسيف والمُرّانِ",39,"ن",1,0],["بمجيد الوسائل اعتدت والأس","باب أن تطلب المصير المجيدا",40,"د",2,0],["بِمَجدٍ مِنَ الأَصلابِ وَهيَ شَريفَة","لِوَقتٍ إِلى خَيرِ البطونِ نُزولُ",41,"ل",1,0],["بِمَجدٍ وَجاهٍ لَيسَ في الدّهرِ يَنتَهي","وَأَرغدِ عَيشٍ مِنهُ صَفوُ المَشارِبِ",42,"ب",1,0],["بمجمع بحريها على خطر السرى","أعاد الجناب المشمعلَّ مَريعا",43,"ع",2,0],["بمجديَ لا أرضى على الشمس موضعا","ولا أرتضي في ملكي الدهر مقنعا",44,"ع",2,1],["بمُجَوّفٍ بلقاً وأع","لى لونهِ ورْدٌ مُصامِصْ",45,"ص",1,0],["بِمَجدِهِمُ الأَعلى الصَريحِ تَشَرَّفَت","مَعَدٌّ عَلى العَرباءِ عادٍ وَقَحطانِ",46,"ن",1,0],["بمجلس تجلس الآساد رهبته","ويعتري الصيدفيه الخوف والوجل",47,"ل",1,0],["بمجرد صيت أمير الشوف","تباد الوف لخوفهمِ",48,"م",1,0],["بِمَجْدِكَ فُقْتَ أَملاكَ العِبادِ","فَأَذْعَنَ حاضِرٌ مِنْهُمْ وبادِ",49,"د",1,1],["بمجد لا يضاهى أو يسامى","سكوت الحاضرين وأنت قائل",50,"ل",1,0],["بمجر له في كل فج طليعة","وفي كل أرض منه ذيل مجرر",51,"ر",1,0],["بمجد صريح وفعل صحيحٍ","ولفظ فصيح وطبع جوادِ",52,"د",1,0],["بمجدِكَ يا أعزَّ عليَّ منِّي","ومجدُك ما ذخرتُ سواهُ ثاني",53,"ن",2,1],["بمجدك الدهر لا بالعيد مبتهج","وفي محياك يزهو لامحياه",54,"ه",1,1],["بمجرد الدعوى أزي","ل الستر وانكشف الحجاب",55,"ب",1,0],["بمجلس أنس خير الخلق طراً