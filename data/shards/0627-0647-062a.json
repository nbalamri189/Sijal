{"poems":[[94,"كم من عهود عذبة","https://www.aldiwan.net/poem38946.html","مجزوء الكامل"],[91,"قد انى يا منيتي ان تعودي","https://www.aldiwan.net/poem44738.html","الخفيف"],[76,"قل لمسرى الريح من إضم","https://www.aldiwan.net/poem13255.html","المديد"],[107,"لمن دم في مغاني الحي مطلول","https://www.aldiwan.net/poem42135.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85428","الخفيف"],[92,"وادي العرائش","https://www.poetsgate.com/ViewPoem.aspx?id=179145",""],[182,"سرادق","https://www.aldiwan.net/poem50691.html","الخفيف"],[412,"صددت أن عاد روض الرأس ذا زهر","https://www.aldiwan.net/poem50174.html","البسيط"],[458,"أهتز قربك كالزمان قصيدة","https://www.aldiwan.net/poem61380.html","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77565","المجتث"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56601","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101077","الطويل"],[1763,"","https://poetry.dctabudhabi.ae/diwan/poem/146062","الكامل"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67942","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74091","السريع"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40081","الكامل"],[4775,"تراتيل ضائعة في محراب بلقيس","https://www.poetsgate.com/ViewPoem.aspx?id=175764",""],[4797,"صلف الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=50253",""],[4899,"الغرب العظيم","https://www.poetsgate.com/ViewPoem.aspx?id=176824",""],[5061,"الامير","https://www.poetsgate.com/ViewPoem.aspx?id=147171",""],[585,"أنا في انتظارك مدنف ولهان","https://www.poetsgate.com/ViewPoem.aspx?id=161936",""],[5163,"أنا","https://www.poetsgate.com/ViewPoem.aspx?id=33953",""],[5224,"اهتدوا بالعشق طلاب الرشد","https://www.poetsgate.com/ViewPoem.aspx?id=121297",""],[5281,"غرِّدي يا بوادي","https://www.poetsgate.com/ViewPoem.aspx?id=199627",""],[5285,"باقة ورد","https://www.poetsgate.com/ViewPoem.aspx?id=203581",""],[307,"وجوه في المرايا","https://www.poetsgate.com/ViewPoem.aspx?id=214163",""],[5677,"أنا والشعر","https://www.poetsgate.com/ViewPoem.aspx?id=179981",""],[5725,"انوار محمد","https://www.poetsgate.com/ViewPoem.aspx?id=177543",""],[5725,"قالوا","https://www.poetsgate.com/ViewPoem.aspx?id=194072",""],[5770,"نجوى طائر","https://www.poetsgate.com/ViewPoem.aspx?id=178264",""],[5956,"أوَ ما نخجل من أنفسنا؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=194418",""]],"verses":[["آهٍ توارى فَجْرِيَ القُدسيُّ","في ليلِ الدُّهُورْ",0,"ر",1,0],["اهتدى بالشعرى وبعد خفاها","من بياض للفرقدين استفيدي",1,"د",2,0],["آهِ تَحتَ اللَيلِ مِن أَرَقٍ","وَوَراءَ البُرءِ مِن سَقَمِ",2,"م",1,0],["أهتاجُ للموتِ يَغشاني ويُمسِكُني","أَنِّي على ظَمَئِي والوِردُ مقتولُ",3,"ل",1,0],["اِهتَدوا بالقرآن فاِتبعوه","وأجلُّوا التوراة والإنجيلا",4,"ل",2,0],["اهتاجني موعدٌ لي فيك يجمعُني","كأنَّني بالشَّباب الطَّلْقِ موعود",5,"د",1,0],["آهتي شاهِدي وحُزني قريني","تُربتي غُربتي وقبري ظَلامي",6,"م",2,0],["أَهتَزُّ عِندَ تَمَنّي وَصلِها طَرَباً","وَرُبَّ أمنِيَة أَحلى مِنَ الظَفَرِ",7,"ر",1,0],["أهتزّ قربك كالزمان قصيدة","يا ليت قلبك كان يدرك ما بيا",8,"ي",2,1],["إِهتمَّ شَيخ الصَراصير","وَهَبّت النار في قَلبه",9,"ه",1,0],["اهتزت الدنيا بهم","واليوم تهتز المنابر",10,"ر",1,0],["أهت لما يرضيك نفساً كريمةً","وكم في الهوى هانت نفوس كرام",11,"م",1,0],["أهتز حين أراك فرط محبة","فرحاً بوجهك ضاحكاً مستبشرا",12,"ر",2,0],["أهتزُّ مثلَ قُضُبِ الرَّيحانِ","لا تَتَخطاني يدُ الأماني",13,"ن",2,0],["أَهتَزُّ شَوقاً لاِقتناص العلا","مثل اِهتِزاز المقضب الباتِرِ",14,"ر",1,0],["أَهَتُوفٌ بانَ في سرارِ الوادي","هل كنتَ من بَيْنٍ على ميعادِ",15,"د",1,1],["آه تطاردني القوافي كلّما","آنست نارا، ثمَّ حزت رثاءنا",16,"ن",2,0],["اهتوي طاري هله من حبي لطاريه","والدروب اللي تجنبهم مهي بدروبي",17,"ب",2,0],["اهتفوا من بعد هذا بإهتمام","اهتفوا للغرب حرية عقيم",18,"م",1,0],["اهتمامي فيك خلاني »أغير«","من جميع الناس حتى من[عيوني]",19,"ن",2,0],["أهتز مرتعشاً كأني راقصٌ","والنبض تعزف منه لي ألحان",20,"ن",1,0],["آهٍ تقطّع بي السبيل ُ وحالَ دونيَ والوجود","ما عدت اعرف من حياتي غير بارقة الرعود",21,"د",1,0],["اهتدوا بالعشق طلاب الرشد","يضيع من ذهب لطريق آخر",22,"ر",1,1],["اهتفْ اهتفْ ونادي","في الرُّبا والقِمَم",23,"م",1,0],["آهٍ تأججَ في الفؤادِ لهيبُها","باتتْ لجفْني كالدموعِ خليلا",24,"ل",2,0],["آهٍ تجلجلُ في الفؤادِ كانّها","لهب الصواعقِ في الهشيمِ وبيلُ",25,"ل",1,0],["أهتم به وأروف له وأعتنز به","وأحمى جنابه من شرور الزماني",26,"ن",2,0],["اهتزّ كسرئ والجموعُ تحيطُه","لكنَّ فضّلْتٓ الجريد ظِلالا",27,"ل",2,0],["اهتزت اركاني علي اني ودويت","ما دريت الهزة من اجتافة",28,"ف",2,0],["اهت به جاراتِها تزدهي","إذ إنه أولُ فرخٍ تُصيب",29,"ب",1,0],["آهٍ تبّت كل أيدٍ دمّرتنا","من عدوٍّ وعميلٍ مكتسِبْ",30,"ب",1,0]]}