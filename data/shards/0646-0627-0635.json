{"poems":[[55,"رب مستغمز إبائي وفي الناس","https://www.aldiwan.net/poem30176.html","الخفيف"],[79,"ما على القلب بعدكم من جناح","https://www.aldiwan.net/poem36623.html","الخفيف"],[32,"قفا نحيي العرصات الهمدا","https://www.aldiwan.net/poem29604.html","الرجز"],[74,"قسما ما حلت عن عهد الوفاء","https://www.aldiwan.net/poem18203.html","الرمل"],[87,"هو مأتم الأخلاق فاتل رثاءها","https://www.aldiwan.net/poem7109.html","الكامل"],[87,"أوحت لطرفك فاستهل شؤونا","https://www.aldiwan.net/poem8112.html","الكامل"],[51,"قال لي أحمد ولم يدر ما بي","https://www.aldiwan.net/poem64248.html","الخفيف"],[46,"ما عهدنا كذا نحيب المشوق","https://www.aldiwan.net/poem30395.html","الخفيف"],[78,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39673","الخفيف"],[111,"عش ما نشاء وراقب فجعة الأجل","https://www.poetsgate.com/ViewPoem.aspx?id=520",""],[111,"هزت العالم أدوار البشر","https://www.poetsgate.com/ViewPoem.aspx?id=105",""],[119,"نور قرب في حالة البعد اقبل","https://www.aldiwan.net/poem40850.html","عموديه"],[141,"هل إلى أم سعيد","https://www.aldiwan.net/poem67960.html","مجزوء الرمل"],[302,"أتركتني دنفا ورحت معافى","https://www.aldiwan.net/poem33217.html","الكامل"],[310,"خير حام مجير عبد المجيد","https://www.aldiwan.net/poem56552.html","الطويل"],[310,"خير حام مجد مجير العبيد","https://www.aldiwan.net/poem56553.html","الخفيف"],[321,"يا لحدب الظهور فصع الرقاب","https://www.aldiwan.net/poem69444.html","الخفيف"],[347,"يا خليلي متع الطر","https://www.aldiwan.net/poem55311.html","مجزوء الرمل"],[369,"سل صدور الركاب ماذا الحنين","https://www.aldiwan.net/poem60627.html","الخفيف"],[369,"قسما لقد رجع النسيم عليلا","https://www.aldiwan.net/poem60803.html","الكامل"],[398,"ناصب قال لي معاوية خالك","https://www.aldiwan.net/poem53466.html","الخفيف"],[398,"أنا من شيعة الرضا","https://www.aldiwan.net/poem53655.html","مجزوء الخفيف"],[398,"يا زائرا سائرا إلى الكوفه","https://www.aldiwan.net/poem53676.html","المنسرح"],[408,"غير مستنكر من الأيام","https://www.aldiwan.net/poem46973.html","الخفيف"],[458,"وطن الدولار هذا أم ترى","https://www.aldiwan.net/poem61565.html","الرمل"],[463,"نبهت سعدا والأفق","https://www.aldiwan.net/poem56086.html","مجزوء الرجز"],[463,"مطل الدين ولو شاء قضى","https://www.aldiwan.net/poem56147.html","الرمل"],[463,"بلوت هذا الدهر أطواره","https://www.aldiwan.net/poem56171.html","السريع"],[463,"كم النوى قد جزع الصابر","https://www.aldiwan.net/poem56172.html","السريع"],[463,"بالغور ما شاء المطايا والمطر","https://www.aldiwan.net/poem56190.html","الرجز"],[463,"جاء بها والخير مجلوب","https://www.aldiwan.net/poem56277.html","السريع"],[463,"نظرة منك ويوم بالجريب","https://www.aldiwan.net/poem56280.html","الرمل"],[466,"ناصر الدين والسحاب إذا غا","https://www.aldiwan.net/poem15276.html","الطويل"],[466,"خفضا لا موت الا بأجل","https://www.aldiwan.net/poem15467.html","الرمل"],[469,"عثرة قلبي فيكم لا تقال","https://www.aldiwan.net/poem3558.html","عموديه"],[473,"وليلة أيقظني معانقي","https://www.aldiwan.net/poem59521.html","الرجز"],[572,"لي صاحب لا يجتني","https://www.aldiwan.net/poem69668.html","مجزوء الكامل"],[572,"مذبة تهدى إلى سيد","https://www.aldiwan.net/poem69814.html","السريع"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122640","المديد"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122701","الكامل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101543","الرمل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87272","الرمل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64122","الخفيف"],[919,"","https://poetry.dctabudhabi.ae/diwan/poem/99970","الخفيف"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59603","المديد"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59565","المديد"],[1115,"","https://poetry.dctabudhabi.ae/diwan/poem/138805",""],[1315,"","https://poetry.dctabudhabi.ae/diwan/poem/140219",""],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122086","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/49088","الخفيف"],[1563,"","https://poetry.dctabudhabi.ae/diwan/poem/203766","السريع"],[1616,"","https://poetry.dctabudhabi.ae/diwan/poem/206238",""],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125365","الخفيف"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114027","الرمل"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100455","الرمل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93523","الرمل"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99067","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205006","الخفيف"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74326","الخفيف"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134017","الخفيف"],[3187,"","https://poetry.dctabudhabi.ae/diwan/poem/138787",""],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48368","الرمل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48304","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216433","الرمل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131247",""],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135661","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111506","السريع"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105113","الخفيف"],[4203,"","https://poetry.dctabudhabi.ae/diwan/poem/105533","الخفيف"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54478","الخفيف"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73091","الخفيف"],[3163,"","https://poetry.dctabudhabi.ae/diwan/poem/123455","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139707",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139692",""],[5055,"كل السحايب","https://www.poetsgate.com/ViewPoem.aspx?id=104295",""],[5145,"ناصر الإسلام عيد ألف عام","https://www.poetsgate.com/ViewPoem.aspx?id=108072",""],[5145,"رجعت صبوته إن خطرا","https://www.poetsgate.com/ViewPoem.aspx?id=108110",""],[572,"مذبَّة ٌ تُهدَى إلى سيّدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=25015",""],[5480,"ثوب الحداد","https://www.poetsgate.com/ViewPoem.aspx?id=10980",""],[470,"الوهم","https://www.poetsgate.com/ViewPoem.aspx?id=177985",""],[5829,"دنيا غرور","https://www.poetsgate.com/ViewPoem.aspx?id=178227",""],[5853,"القصيدة الاخيرة","https://www.poetsgate.com/ViewPoem.aspx?id=175623",""]],"verses":[["ناصِبٌ لي حَبائِلَ الطَمَعِ المُز","ري وَغَيري لِلمُطمِعاتِ قَنيصُ",0,"ص",1,0],["ناصِرِ الحقِّ مُرسِلِ النّقْعِ سُحْباً","بيْنَ سُمْرِ القَنا وبيضِ الصِّفاحِ",1,"ح",1,0],["ناصَينَ مِن جَوزِ الفَلاةِ أَوَهِدا","أُسقَينَ وَسَمِيَّ السَحابِ الأَعهُدا",2,"د",2,0],["ناصر الدين الذي ابيضَّ ثنا","تُضرَبُ الأمثال فيه بالثناء",3,"ا",2,0],["ناصرت فيه من تلفّت لم يجد","من حوله الدنيا ولا أُجراءها",4,"ا",3,0],["ناصَرتَ في فَجرِ القَضِيَّةِ مُصطَفى","فَنَصَرتَ خُلُقاً في الشَبابِ مَتينا",5,"ن",2,0],["ناصِحٌ مُشفِقٌ وَإِن كُنتُ ما أُر","زَقُ مِنها وَالحَمدُ لِلَّهِ عِتقا",6,"ق",2,0],["ناصِحاً لِلمَليكِ وَالمَلِكِ القا","ئِمِ وَالمُلكِ غَيرَ نُصحِ مَذيقِ",7,"ق",1,0],["ناصِحٌ وَهوَ غَيرُ جِدِّ نَصيحٍ","مُشفِقٌ وَهوَ غَيرُ جِدِّ شَفيقِ",7,"ق",1,0],["ناصبَهم حرباً لها شَرارُ","كأنَّما أُضرِمَ فيها النارُ",8,"ر",1,0],["ناصلات الألوانِ في صفحةِ الما","ء غصونا نفيّة الأفوافِ",9,"ف",1,0],["ناصحت ربك في تعزيز ملته","فلتنصح اليوم ندبا خيرة الملل",10,"ل",1,0],["ناصع الحجة معصوم النهى","جلد الهمة ذو العزم الذمر",11,"ر",1,0],["ناصر السنة السنية شيخ ال","قوم انداهمو يمينا واطول",12,"ل",1,0],["ناصِحٍ يُخبِرُ أَنّي","حافِظٌ وُدَّ خَليلِ",13,"ل",1,0],["ناصَفتَني حملَ الهَوى وتركتني","حتّى حملتُ من الهوى أَضعافا",14,"ف",2,0],["ناصَروا الحقّ باكتوا الفجرَ مجدٌ","أَمّنوا الجمعَ رجف بثَّ الحرودِ",15,"د",1,0],["ناصروا الحقّ كبتُ عجوٍ ورجفٍ","باكِتُوا الفجرَ صدقُ رهنِ المجودِ",16,"د",1,0],["ناصب طرفه إزاء الروايا","وإزاء السقوف والأبواب",17,"ب",1,0],["ناصعاً يلمس بالرو","ح خليلي واليدين",18,"ن",1,0],["ناصِرٌ كُلّما انْتضاهُ حُسامٌ","ناصحٌ كُلّما ارتآه مُبِين",19,"ن",1,0],["ناصَيْتَ فيها السّابقينَ إلى العُلا","وملأْتَ حَدَّ اللاحقِينَ فُلولا",20,"ل",2,0],["ناصِبٌ قالَ لي مُعاوِيَة خا","لُكَ خيرُ الأَعمامِ وَالأَخوالِ",21,"ل",1,1],["ناصِحُ الجَيبِ آمِنُ ال","غَيبِ لَم يَغرف الشَرَه",22,"ر",2,0],["ناصِبَة أَصبَحت مناصِبُها","مَقرفَةً لِلقَبيحِ مَقروفَه",23,"ف",2,0],["ناصروا سيّدَ الأَنام وأفنَوا","دونَه كلِّ ذابلٍ وحُسام",24,"م",1,0],["ناصبا لي منبرا حرا كما","مد إعزازا لفكري كنفه",25,"ف",2,0],["ناصَحَ للخليفتي","ن حدَثُ الرأي شفِقْ",26,"ق",1,0],["ناصلاً من صدإِ العار كما","خلَّص القَينُ الحسامَ المنتضى",27,"ض",2,0],["ناصَى عميدُ الرؤساء العلا","والناسُ يقتصُّون آثارَهْ",28,"ر",2,0],["ناصَى بها عبدُ الرحيم السها","وبعدَه الكابرُ والكابرُ",29,"ر",1,0],["ناصبتم الشمسَ بحدِّ سيفه","ودستُمُ بسيعه حدَّ القَمرْ",30,"ر",1,0],["ناصعةً في العين لكنّها","تُبغَضُ والناصعُ محبوبُ",31,"ب",1,0],["ناصحُ الجيبِ بما حمَّلتُهُ","حيثُ يَخشَى مُرسِلٌ غِشَّ الجيوبِ",32,"ب",1,0],["ناصر الدين والسَّحاب إذا غا","با تنادى الأحياءُ بالإمْحالِ",33,"ل",1,1],["ناصفُ المِئْزرِ من كسب العُلى","وهو في الحي سَحوبٌ ورَفِلْ",34,"ل",1,0],["ناصرُ دمعي بمدودِ الأسى","هازم صبري بجنود الجمال",35,"ل",1,0],["ناصِعَةً تُزهِرُ بَينَ الخِيَري","كَمِثلِ صُلبانِ مِنَ البِلّورِ",36,"ر",1,0],["ناصحتُهُ وَحَمَلْتُ عنْهُ","فما أثابَ وَلا شَكَرْ",37,"ر",1,0],["ناصيةُ الأدهم في عُودِها","لم تك من عُرْفٍ ولا من ذَنَبْ",38,"ب",1,0],["ناصِبُ الرّاياتِ تَخفُقُ إن","نَكَسَ الرّايات أنكاسُ",39,"س",1,0],["ناصِف إذا هُم ناصَفُوكَ وَصِل إذا","وَصَلُوا وإن فَرَكُوا إخاكَ فَطَلِّقِ",40,"ق",1,0],["ناصحاً اياي ان انبذَهُ","وأُديم اللهوَ جلباً للهنا",41,"ن",2,0],["ناصر الدين الأَغرِّ","راسمٌ خَطَّ الشَتاتِ",42,"ت",1,0],["ناصبٌ طرفه إِزاءَ الزوايا","وإِزاءَ السقوفِ والأبواب",43,"ب",1,0],["نَاصِحٌ لَمْ يَخُضْ ضَحَاضِحَ غِشِّ","فِي الزَّمَانِ الْمَاضِي مَعَ الْخُوَّاضِ",44,"ض",1,0],["ناصري لم تزل","رحماته تجود",45,"د",1,0],["ناصريّ لم يزل","للسبيل مُوضحا",46,"ح",2,0],["ناصره سيفه مؤيده","مفني أعاديه باب حطته",47,"ت",2,0],["ناصبني الدهر بغاراته","حتى متى أسلم من كره",48,"ر",2,0],["نَاصِرُو المُصْطَفْى أَعَزِّ رَسُولٍ","خَصَّهُ اللَّهُ مِنْ مَثَانٍ بِسَبْعِ",49,"ع",1,0],["ناصرٌ للنُّهى مكينُ","أنصروهُ أنصروهُ",50,"ه",1,0],["ناصر دين الله محيي الهدى","من رأيه لكل أمر قوام",51,"م",1,0],["ناصح النّيات واصفي من الغدير","ريّس الدوله عسى الله ينصره",52,"ر",2,0],["ناصراً للضعيفِ خيرَ شفقيقٍ","باسمَ الثَّغرِ صادِقَ الإيمانِ",53,"ن",1,0],["ناصحٌ برّ رؤوفٌ رحمة","مُنجِزُ من كلّ خيرٍ ما وَعَد",54,"د",1,0],["ناصبي رام أن يدخل في","نعله للروضة المزدهره",55,"ر",2,0],["ناصح للملك لا تخدعه","صحبة الناس وَلا يَوماً يحابي",56,"ب",2,0],["ناصحاً مشفقاً محباً ودوداً","قائماً في رضاه صعباً عسوفا",57,"ف",2,0],["ناصب للشباك يحسب جهلا","كل شخص يمر صيدا جديدا",58,"د",2,0],["ناصح لِلوَرى رَؤوف رَحيم","مُشفق ناطق بِخَير المَعاني",59,"ن",2,0],["ناصر العدل ناثر الفضل طرا","ناظم اليمن والمنى والأمان",60,"ن",1,0],["نَاصِرُ الدِّينِ مَن تَوَدُّ الثّرَيَّا","أنَّها شَسعُ نَعلِهِ أو ثَرَاهَا",61,"ا",3,0],["ناصِرُ الدّينِ الذي","لمْ يدعْ منْ مطْلَبِ",62,"ب",1,0],["ناصرَ الدّين خُذ إلَيكَ بشارَهْ","قد كسَتْها الفُتوحُ أبْدَعَ شارَهْ",63,"ر",2,1],["ناصحي أنت بزهري أنتشيه","لا أبالي الشوك والغصة فيه",64,"ه",1,0],["ناصب الدهر آل عثمان حتى","هبطوا من يقارعهم واستكانوا",65,"ن",3,0],["ناصيتي بيدك اللهمَّ","قدني لفضلٍ ولخيرٍ جمّا",66,"م",2,1],["ناصية الخرنوص مذ قص مد","يديه من زفس يروم المدد",67,"د",1,0],["ناصباً للاسود أشراك حسن","من مراسيله فصاد الاسودا",68,"د",2,0],["ناصب كلة الخفاء بخدر","مرتج الباب عن شكاية معدم",69,"م",1,0],["ناصحي غيرُ عالمٍ بالذي بي","ومن الغَبْنِ ناصحٌ غيرُ عالمْ",70,"م",1,0],["ناصى العوالي جِيدُهُ فكادَ لا","يُمكِنُ مشن ناصِيَتَيهِ مَن نصا",71,"ا",1,0],["ناصِريُّ النِّجارِ لو سَابَقٌ البَر","قَ إِلى مَفخرٍ شآهٌ كليلا",72,"ل",2,0],["ناصرِ العدل كاسر الجور مُعلي","كلُمة الحق مُرشدِ الصلَحاء",73,"ا",2,0],["ناصر الدين مَن به الدين أضحى","مثلَ زهو الدنيا بأزهى ارتباع",74,"ع",1,0],["ناصرُ الدين الذي ذلاً لدى","عزِّه كلُّ مليكٍ خضعا",75,"ع",2,0],["ناصر نصير الشعر ولشعر لجا","وناصر ل عين الشعر لوذ وملاجي",76,"ج",2,0],["ناصر الإسلام عيد ألف عام","في ذرى عزٍ رهينٍ بالدوام",77,"م",1,1],["ناصر الإسلام هذي دعوة","لم يرد صاحبها أن شعرا",78,"ر",2,0],["ناصِيَة ٌ الأدْهَمِ في عودِهَا","لَمْ تَكُ مِن عُرْقٍ وَلاَ مِنْ ذَنَبْ",79,"ب",1,0],["\"ناصر ٍ أسمه يكّفي ضيغم ً ضد الظروف","بيت للرحمة وبيته تقصده كل العباد",80,"د",1,0],["ناصحاً، أو محدِّثاً، أو سميعاً","حين تحكين.. غارقاً في التَّمنِّي",81,"ن",2,0],["ناصبتني فُجْرَها والحقد لما","أمعنت بالغي تبغي ابتلائي",82,"ا",3,0],["ناصحته يكتم الآهات ماانتصحا","ومااستكان النوى بعداً وماسمحا",83,"ح",2,1]]}