{"poems":[[53,"بعادا لمن صاحبت غير المقوم","https://www.aldiwan.net/poem29758.html","الطويل"],[53,"بيني وبين الصوارم الهمم","https://www.aldiwan.net/poem29775.html","المنسرح"],[63,"أردد الظن بين اليأس والأمل","https://www.aldiwan.net/poem46141.html","الطويل"],[77,"أإخواننا لا تنسوا الفضل والعطفا","https://www.aldiwan.net/poem35975.html","الطويل"],[77,"سلام الله بورك من سلام","https://www.aldiwan.net/poem36096.html","الوافر"],[93,"هنيئا لكم أن تسمعوا شعر حافظ","https://www.aldiwan.net/poem11190.html","الطويل"],[88,"يا شهر أيار ما أن أنت أيار","https://www.aldiwan.net/poem44420.html","البسيط"],[88,"لا يبلغ المرء منتهى أربه","https://www.aldiwan.net/poem45001.html","المنسرح"],[88,"هو الدهر لم يترك مشن غواره","https://www.aldiwan.net/poem45014.html","الطويل"],[27,"شعفت بعهد ذكرته المنازل","https://www.aldiwan.net/poem5966.html","الطويل"],[37,"ومن غنمها يوم الهياج إذا غدت","https://www.aldiwan.net/poem6433.html","الوافر"],[37,"ومن غدره نبز الأولو","https://www.aldiwan.net/poem7149.html","المتقارب"],[37,"طربت وما شوقا إلى البيض أطرب","https://www.aldiwan.net/poem7650.html","الطويل"],[60,"لا تعذليه فإن العذل يولعه","https://www.aldiwan.net/poem13279.html","البسيط"],[51,"نجاك يا ابن الحاجب الحاجب","https://www.aldiwan.net/poem8294.html","السريع"],[51,"قل للذي أعجبت محاسنه","https://www.aldiwan.net/poem9406.html","المنسرح"],[51,"يا أيها السيد الذي طهرت","https://www.aldiwan.net/poem61996.html","المنسرح"],[78,"الجود أحلى على قلبي من الظفر","https://www.aldiwan.net/poem14158.html","البسيط"],[78,"يا قمرا أفقه فؤادي","https://www.aldiwan.net/poem14172.html","مخلع البسيط"],[62,"أنات وذكرانها صنوها","https://www.aldiwan.net/poem52217.html","المتقارب"],[45,"نهيتكم عن صالح فأبى بكم","https://www.aldiwan.net/poem62707.html","الطويل"],[45,"يأبى الخلي بكاء المنزل الخالي","https://www.aldiwan.net/poem65572.html","البسيط"],[61,"ها إنها خطط العلياء والكرم","https://www.aldiwan.net/poem51423.html","البسيط"],[61,"ليالينا بأحياء الغميم","https://www.aldiwan.net/poem51454.html","الوافر"],[61,"أمن رقبة عاف السلام مودعا","https://www.aldiwan.net/poem51570.html","الطويل"],[61,"أبا العمر خيم أم بالحشاء","https://www.aldiwan.net/poem51834.html","المتقارب"],[66,"إن جئت سلعا فسل عن جيرة العلم","https://www.aldiwan.net/poem38503.html","البسيط"],[66,"من لم تضم الضيوف ساحته","https://www.aldiwan.net/poem38549.html","المنسرح"],[66,"ما دام جري الفلك الدائر","https://www.aldiwan.net/poem40135.html","السريع"],[66,"أهلا بشهب عند إشراقها","https://www.aldiwan.net/poem40990.html","السريع"],[80,"ومنغمس في صبغة الليل يمتطي","https://www.aldiwan.net/poem31488.html","الطويل"],[69,"علا لك ذكر لا يشابهه ذكر","https://www.aldiwan.net/poem28801.html","الطويل"],[48,"لقد أصبحت ذا كرب","https://www.aldiwan.net/poem10810.html","الهزج"],[50,"ألا لا أرى شيئا ألذ من الوعد","https://www.aldiwan.net/poem63925.html","الطويل"],[46,"أفوق البدر يوضع لي مهاد","https://www.aldiwan.net/poem23638.html","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54769","المتقارب"],[77,"إخواننا لا تنسوا الفضل والعطفا","https://www.poetsgate.com/ViewPoem.aspx?id=34184",""],[51,"يا أيها السيد الذي طَهُرت","https://www.poetsgate.com/ViewPoem.aspx?id=28711",""]],"verses":[["وَمَن غَرَّهُ مالٌ رَضي بِبَشاشَةٍ","وَعادِمُ ماءٍ قانِعٌ بِالتَيَمُّمِ",0,"م",1,0],["وَمِن غُصونٍ عَلى ذَوائِبِها","يَزلَقُ طَلُّ الرِياضِ وَالدِيَمُ",1,"م",1,0],["ومَنْ غَدا بِرِداءِ الفَخْرِ مُشْتَمِلاً","أضْحى بِما يَكْتَسيهِ غيرَ مُحتَفِلِ",2,"ل",1,0],["ومِنْ غادَةٍ بكرٍ جلَتْها يدُ الجَلا","ولمْ تدْرِ إلا دايَة قطُّ أو سَجْفا",3,"ف",2,0],["وَمَنْ غَرَسَ الْمَوَدَّةَ قَرَّ عَيْناً","وَأَعْمَلَ فِي الْجَنَى كَفَّ احْتِكَامِ",4,"م",1,0],["وَمِنْ غَانِيَاتٍ لَسْنَ فِي كُلِّ مَوْضِعٍ","حَلَلْنَ بِهِ إِلاَّ أَزَاهِيرَ بُسْتَانِ",5,"ن",1,0],["ومن غموس الثريّا فيك منحسة","دامت بها فيك عاهات وأوضار",6,"ر",1,0],["ومن غدا هاديا يعلّمه","وراح يشفي الجهول من وَصبَه",7,"ب",2,0],["ومن غاوره اليام غيرَ مُدجَّج","فلا يطعمَنْ في مَغنَم منَ مَغاره",8,"ر",2,0],["وَمَن غَلَّ مالَ اللَهِ غُلَّت يَمينُهُ","إِذا قيلَ أَدّوا لا يَغُلَّنَّ عامِلُ",9,"ل",1,0],["ومن غنمها يوم الهياج إذا غدت","بنا العَرج يُحوى والقتيل الملَحَّبُ",10,"ب",1,1],["ومن غدره نَبَزَ الأولو","ن إذ لقبَّوه الغدير الغديرا",11,"ر",2,1],["وَمَن غَيرَهُم أرضَى لِنَفسِيَ شِيعَةً","ومن بَعدَهُم لاَ مَن أُجِلُّ وأُرجَبُ",12,"ب",1,0],["وَمَن غَدا لابِساً ثَوبَ النَعِيم بِلا","شَكرٍ عَلَيهِ فَإِنَّ اللَهَ يَنزَعُهُ",13,"ع",2,0],["ومن غدا مثلك في مجده","حُمِّل ما لا يحمل الصاقبُ",14,"ب",1,0],["وَمَنْ غدا والنَّوالُ من يَدِهِ","يُطْلَبُ والرأيُ منه يُقْتَدَحُ",15,"ح",1,0],["ومن غدا وهو للخبائث تَر","راكٌ وللطيبات أَخّاذُ",16,"ذ",1,0],["وَمِن غِناء أرَيوى في الصبوح لَنا","يا طلعةَ الشَمس في الآصال وَالبُكَرِ",17,"ر",1,0],["وَمَن غَدا مُسترقَ حُرّ ال","كَلامِ قَد حازَهُ بِمُلكِ",18,"ك",1,0],["ومن غلظ في طباع الإناث","تلقن دهراً ولا تفهمُ",19,"م",1,0],["وَمَن غابَ عَن يَومِ المَوالي وَيَومِكُم","فَقَد غابَ عَن يَومٍ عَظيمِ الجَوائِحِ",20,"ح",1,0],["وَمِن غَرائِبِ ما تَأتي الخُطوبُ بِهِ","في أَوَّلٍ مِن صُروفِ الدَهرِ أَو تالِ",21,"ل",1,0],["ومن غَطارِفَةٍ شُمٍّ أنوفُهُمُ","يَلقَوْنَ قبلَ الشِّفاهِ الماءَ بالشَّمَمِ",22,"م",1,0],["وَمِنْ غُرَفٍ تُضيءُ الليلَ حُسناً","فتَحسِبُها النُّجومُ من النُّجومِ",23,"م",1,0],["ومِنْ غُصُنٍ رَطْبٍ تأزَّرَ بالنَّقا","إذا هَزَّ عِطْفَيْهِ القِناعُ تَزَعْزَعا",24,"ع",2,0],["ومَن غَرَّه الدهرُ ألفيتَه","ذليلَ الدموعِ عزيزَ العَزاءِ",25,"ا",2,0],["وَمَن غَدا اِسمُ أُمِّهِ نَعتاً لِآمنِهِ","فَتلِكَ آمِنَةٌ مِن سائِرِ النَقَمِ",26,"م",1,0],["وَمَن غَدا عِرضُهُ المُهَلَّبُ في ال","ناسِ غَدا وَجهُهُ أَبا صُفرَه",27,"ر",2,0],["وَمَن غَدَت سَيدَةُ إِنعامِهِ","تَملَأُ سَمعَ المَثَلِ السائِرِ",28,"ر",1,0],["وَمَن غَدا سائِحُ إِنعامِهِ","يَملَأُ قَلبَ الآمَلِ السانِحِ",29,"ح",1,0],["ومُنغَمِسٍ في صِبغَةِ اللَّيل يَمْتَطي","إِلى آجَلِ الآسادِ قَيْدَ الأَوابِدِ",30,"د",1,1],["وَمَنْ غاظَهُ هذا فليسَ بمسلمٍ","وهلْ مسلمٌ يختارُ أنْ يُنصرَ الكفرُ",31,"ر",1,0],["وَمَن غابَ عَنِ العَينِ","فَقَد غابَ عَنِ القَلبِ",32,"ب",1,0],["وَمِن غَفلَةِ الواشي إِذا ما أَتَيتُها","وَمِن نَظَري أَبياتَها جالِساً وَحدي",33,"د",2,0],["ومِنْ غَلَلٍ تَحِيدُ الرّيحُ عنه","مَخافَةَ أنْ يُمَزّقَها القَتادُ",34,"د",1,0],["وَمَنْ غَرَّهُ مِنْهُمُ الظَّاهِرُو","نَ فَكَمْ خَدَعَتْ حَمْأَةٌ بِالزَّبَدْ",35,"د",1,0],["ومن غادة بكر جلتها يد الجلا","ولم تدر الإذاية قط أو سجفا",36,"ف",2,0],["ومن غدا وهو للخبائث تَرَّ","اكٌ وللطيبات أَخّاذُ",37,"ذ",1,0]]}