77086",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577080",""],[463,"ردَّ عليها النومَ بعد ما شردْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60045&r=&rc=101",""],[463,"إذا رفعتْ من شرافَ الخدورُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60064&r=&rc=120",""]],"verses":[["وَمَن غَرَّهُ مالٌ رَضي بِبَشاشَةٍ","وَعادِمُ ماءٍ قانِعٌ بِالتَيَمُّمِ",0,"م",1,0],["وَمِن غُصونٍ عَلى ذَوائِبِها","يَزلَقُ طَلُّ الرِياضِ وَالدِيَمُ",1,"م",1,0],["ومَنْ غَدا بِرِداءِ الفَخْرِ مُشْتَمِلاً","أضْحى بِما يَكْتَسيهِ غيرَ مُحتَفِلِ",2,"ل",1,0],["ومِنْ غادَةٍ بكرٍ جلَتْها يدُ الجَلا","ولمْ تدْرِ إلا دايَة قطُّ أو سَجْفا",3,"ف",2,0],["وَمَنْ غَرَسَ الْمَوَدَّةَ قَرَّ عَيْناً","وَأَعْمَلَ فِي الْجَنَى كَفَّ احْتِكَامِ",4,"م",1,0],["وَمِنْ غَانِيَاتٍ لَسْنَ فِي كُلِّ مَوْضِعٍ","حَلَلْنَ بِهِ إِلاَّ أَزَاهِيرَ بُسْتَانِ",5,"ن",1,0],["ومن غموس الثريّا فيك منحسة","دامت بها فيك عاهات وأوضار",6,"ر",1,0],["ومن غدا هاديا يعلّمه","وراح يشفي الجهول من وَصبَه",7,"ب",2,0],["ومن غاوره اليام غيرَ مُدجَّج","فلا يطعمَنْ في مَغنَم منَ مَغاره",8,"ر",2,0],["وَمَن غَلَّ مالَ اللَهِ غُلَّت يَمينُهُ","إِذا قيلَ أَدّوا لا يَغُلَّنَّ عامِلُ",9,"ل",1,0],["ومن غنمها يوم الهياج إذا غدت","بنا العَرج يُحوى والقتيل الملَحَّبُ",10,"ب",1,1],["ومن غدره نَبَزَ الأولو","ن إذ لقبَّوه الغدير الغديرا",11,"ر",2,1],["وَمَن غَيرَهُم أرضَى لِنَفسِيَ شِيعَةً","ومن بَعدَهُم لاَ مَن أُجِلُّ وأُرجَبُ",12,"ب",1,0],["وَمَن غَدا لابِساً ثَوبَ النَعِيم بِلا","شَكرٍ عَلَيهِ فَإِنَّ اللَهَ يَنزَعُهُ",13,"ع",2,0],["ومن غدا مثلك في مجده","حُمِّل ما لا يحمل الصاقبُ",14,"ب",1,0],["وَمَنْ غدا والنَّوالُ من يَدِهِ","يُطْلَبُ والرأيُ منه يُقْتَدَحُ",15,"ح",1,0],["ومن غدا وهو للخبائث تَر","راكٌ وللطيبات أَخّاذُ",16,"ذ",1,0],["وَمِن غِناء أرَيوى في الصبوح لَنا","يا طلعةَ الشَمس في الآصال وَالبُكَرِ",17,"ر",1,0],["وَمَن غَدا مُسترقَ حُرّ ال","كَلامِ قَد حازَهُ بِمُلكِ",18,"ك",1,0],["ومن غلظ في طباع الإناث","تلقن دهراً ولا تفهمُ",19,"م",1,0],["وَمَن غابَ عَن يَومِ المَوالي وَيَومِكُم","فَقَد غابَ عَن يَومٍ عَظيمِ الجَوائِحِ",20,"ح",1,0],["وَمِن غَرائِبِ ما تَأتي الخُطوبُ بِهِ","في أَوَّلٍ مِن صُروفِ الدَهرِ أَو تالِ",21,"ل",1,0],["ومن غَطارِفَةٍ شُمٍّ أنوفُهُمُ","يَلقَوْنَ قبلَ الشِّفاهِ الماءَ بالشَّمَمِ",22,"م",1,0],["وَمِنْ غُرَفٍ تُضيءُ الليلَ حُسناً","فتَحسِبُها النُّجومُ من النُّجومِ",23,"م",1,0],["ومِنْ غُصُنٍ رَطْبٍ تأزَّرَ بالنَّقا","إذا هَزَّ عِطْفَيْهِ القِناعُ تَزَعْزَعا",24,"ع",2,0],["ومَن غَرَّه الدهرُ ألفيتَه","ذليلَ الدموعِ عزيزَ العَزاءِ",25,"ا",2,0],["وَمَن غَدا اِسمُ أُمِّهِ نَعتاً لِآمنِهِ","فَتلِكَ آمِنَةٌ مِن سائِرِ النَقَمِ",26,"م",1,0],["وَمَن غَدا عِرضُهُ المُهَلَّبُ في ال","ناسِ غَدا وَجهُهُ أَبا صُفرَه",27,"ر",2,0],["وَمَن غَدَت سَيدَةُ إِنعامِهِ","تَملَأُ سَمعَ المَثَلِ السائِرِ",28,"ر",1,0],["وَمَن غَدا سائِحُ إِنعامِهِ","يَملَأُ قَلبَ الآمَلِ السانِحِ",29,"ح",1,0],["ومُنغَمِسٍ في صِبغَةِ اللَّيل يَمْتَطي","إِلى آجَلِ الآسادِ قَيْدَ الأَوابِدِ",30,"د",1,1],["وَمَنْ غاظَهُ هذا فليسَ بمسلمٍ","وهلْ مسلمٌ يختارُ أنْ يُنصرَ الكفرُ",31,"ر",1,0],["وَمَن غابَ عَنِ العَينِ","فَقَد غابَ عَنِ القَلبِ",32,"ب",1,0],["وَمِن غَفلَةِ الواشي إِذا ما أَتَيتُها","وَمِن نَظَري أَبياتَها جالِساً وَحدي",33,"د",2,0],["ومِنْ غَلَلٍ تَحِيدُ الرّيحُ عنه","مَخافَةَ أنْ يُمَزّقَها القَتادُ",34,"د",1,0],["وَمَنْ غَرَّهُ مِنْهُمُ الظَّاهِرُو","نَ فَكَمْ خَدَعَتْ حَمْأَةٌ بِالزَّبَدْ",35,"د",1,0],["ومن غادة بكر جلتها يد الجلا","ولم تدر الإذاية قط أو سجفا",36,"ف",2,0],["ومن غدا وهو للخبائث تَرَّ","اكٌ وللطيبات أَخّاذُ",37,"ذ",1,0],["ومَن غيرُه أعددتِه لملمةٍ","إذا ضلت الآراء واضطرب الفكرُ",38,"ر",1,0],["ومن غرسَ الآمال في منبت السخا","تدلت عليه بالثمار غصونُها",39,"ن",3,0],["ومن غريب الأمر أنه أبى","والطمع المطاع أمر مهلك",40,"ك",1,0],["وَمَن غَدَا المَجدُ لَهُ حُلّةً","مِن عَمِّهِ المَهدِيِّ أَو جَدِّهِ",41,"د",2,0],["ومن غربةٍ يبكي الجنينُ إذا بدا","وقد كان في ضيقٍ وفرطِ ظلام",42,"م",1,0],["ومن غيث القبول سقى وحيا","ثراه في الصباح وفي المساء",43,"ا",2,0],["وَمَن غَدا ضامِنَ رِزقي فَمُذ","جَرى عَلى راحَتِهِ ما اِحتَبَس",44,"س",1,0],["وَمِنْ غُصُونٍ قَدْ سَقاها الْحَيَا","فَعَرْبَدَتْ بِالرَّقْصِ مِنْ خَمْرَتِهِ",45,"ت",2,0],["وَمَنْ غَثَى مِنْ حِقْدِهِمْ وَغَلاَ","طَوِّقْهُ يَا رَبَّ الْعُلاَ غَثْيَهْ",46,"ي",2,0],["ومن غره لين الثعابين فاعتدى","عليها فبالسم الزعاف سيعطب",47,"ب",1,0],["ومن غرس العدلَ القويم فإنّه","سيجني ثمار العزّ من ذلك الغرس",48,"س",1,0],["وَمن غُررٍ وضّاحةٍ ما تطلّعت","عَلى الخطب إلّا اِنجاب محلولك الخطبِ",49,"ب",1,0],["ومن غَرامي بِذى قَرنينِ أَنظرُهُ","إنّي أُخاطَبُ في مَدْحي بِقَرْنانِ",50,"ن",1,0],["ومن غرّاءَ أُمليها كلاماً","على أُذُنٍ فأملَؤُها كِلاما",51,"م",2,0],["ومَن غدا طَلُّ عَطِيّاته","يُخْجِلُ صَوْبَ المطَر الوابل",52,"ل",1,0],["وَمَن غَدا وَلَهُ في كُلِّ ما نَفَسٍ","مِنَ الجَلالَةِ أَمرٌ غَيرُ مَعهودِ",53,"د",1,0],["وَمن غَدا بِالوصيّ مُعتَصِماً","أَنا لَهُ اللَهُ ما تَمَنّاهُ",54,"ا",2,0],["ومن غدر المنافق حين يلوي","عمامة خائن يوم (الضريب)",55,"ب",1,0],["ومن غرام ومن وجد ومن أرق","ومن دموع على الخدين تنسكب",56,"ب",1,0],["ومَن غَدا رأيُهُ يُضحي لسائلهِ","ضُحىً إذا ليلُ إشكالٍ سَجا ودَجا",57,"ج",2,0],["ومن غَزَلٍ عَذب كأنَّ بُيُوته","مسارحُ آرام النقا وملاعبُ",58,"ب",1,0],["ومن غدَتْ ألفاظُه","مشرقةً كالكوكبِ",59,"ب",1,0],["ومن غدا ثانيَ شمسِ الضُحى","عُلوّ مقدارٍ وإشراقا",60,"ق",2,0],["ومن غصُن مالت بأعطافه الصَّبا","يُمايس غُصناً قد تلفَّع بالزّهر",61,"ر",1,0],["ومن غير شكٍ إِنه يسكر الورى","ولكنني ممن يموت به سُكْرا",62,"ر",2,0],["ومن غِمارٍ في الهوى خضتُه","مشمِّرا للصبر عن ساقيا",63,"ي",2,0],["ومن غلطِ إذا أبردت نفسي","حرارةَ ما يعالجه الحزينُ",64,"ن",1,0],["ومن غالب الأيامَ كان صريعةً","لجانب قِرنٍ لا يضعضَع كاهلُهْ",65,"ل",2,0],["ومن غَدرِ أيّامه العادياتِ","على ما أذمَّتْ عليه تُغيرُ",66,"ر",1,0],["ومن غزالٍ لا يُقِلُّ رِدفُه","ضعفاً وفي حباله عُنقُ أَسَدْ",67,"د",1,0],["ومن غَدا الهادي فلا تعجبوا","تبديله الأرض نعيمَ الجِنانْ",68,"ن",1,0],["وَمَن غَدا يَسحَبُ ذَيلَ العُلا","ما بَينَ إِجلالٍ وَإِعظامِ",69,"م",1,0],["ومنغلقاً أؤمله","بيمنى الشيخ ينفسح",70,"ح",1,0],["ومن غدا الهادي له والداً","فليس من مكرمة يقصر",71,"ر",1,0],["ومَنْ غَدا مُرَجِّحا","لِجَهْرِها مُصَحِّحا",72,"ح",2,0],["ومن غفلةِ الواشي إذا ما لقيتهُ","ومن زورتي أبياتها خالياً وَحدي",73,"د",2,0],["وَمِن غَير أَحواضِ البَطالةِ مشربي","وَفي غَيرِ أَسبابِ الغرامِ مِكاسي",74,"س",2,0],["ومن غُلَّتي قد درَّعَ الماءُ نَفْسَهُ","من الخَوْفِ منها أَن أَتاها مُلاَقِيا",75,"ي",2,0],["ومِنْ غَرامِي دموعٌ ما لها عَدَدٌ","وكَيْفَ أَسْخُو بِما لَمْ أُحْصِه عَدَدا",76,"د",2,0],["ومن غيظ ضحاياهنّ قالوا","كفاك الله شر مبذرات",77,"ت",1,0],["وَمن غَصَبَتهُ النّائِباتُ وَساءَني","بِفُرقَتِهِ يومٌ مِنَ السُّوءِ أيوَمُ",78,"م",1,0],["ومن غَدا نفس الرسولِ المصطفى","صلّى عليه اللهُ عندَ المُبتهلْ",79,"ل",1,0],["ومن غَيُّه أغرى بآلِ محمد","وشانَ من يَغدو عليهم ومن يُغْري",80,"ر",2,0],["ومن غير الأيام أني شاعر","أديب بسربال الخمول مسربل",81,"ل",1,1],["وَمِن غُصون اِعتِناء ما جَنيت لَها","مِن الفَواكه إلا فَرط إِهمالِ",82,"ل",1,0],["وَمِن غلوّ معاذ اللَه يورثني","ما يوقع المَرء في غيّ وَإِضلال",82,"ل",1,0],["وَمَن غَدا لا يُجاريه بِمكرمة","كَعبٌ وَلا حاتم المَشهور في العرب",83,"ب",1,0],["ومن غَدَا وهُموم الدّهْرِ تُثْقِلُهُ","يروحُ منها خفيفَ الحِمل ما نُكِسَا",84,"س",2,0],["وَمَنْ غاب عن شَمْسِ المعالي وبدرِها","فَحُقَّ له ألاَّ يَقَرَّ قراره",85,"ر",2,0],["وَمَن غَدا في محيّا المَجدِ غرَّتهُ","أَكْرِمْ بِها غُرّةً مِن أَجمَلِ الغُررِ",86,"ر",1,0],["وَمَن غَرَس المَعروفَ وَالخَيرَ وَالتُّقى","يُسرُّ بِما يَجنيهِ مِن ذَلكَ الغرسِ",87,"س",1,0],["وَمن غَد اليَوم وَكانَ الأربعا","ثاني قِعدة رَكِبنا أَجمَعا",88,"ع",2,0],["وَمِن غَدٍ في مِثل ذاكَ الوَقتِ","أَرسى بِيَنبع كَذاكَ يوتي",88,"ي",1,0],["وَمِن غَدٍ بعيدَ ظُهرِ السَّبت","حَلَّ بِبَيروت جَميل السَّمتِ",88,"ت",1,0],["ومِنْ غافرٍ أجداده السادةُ الذي","تهاب تلاقيها الأسودُ الأصابح",89,"ح",1,0],["ومِنْ غافرٍ أجدادُه السادة الذي","لهم في قريش نُسْبةٌ كرُمتْ أصلا",90,"ل",2,0],["ومن غفلةِ الواشي إذا ما أتَيتُها","ومن زورتي أبياتها خالياً وحدي",91,"ي",1,1],["ومن غلا وعلا قدراً ومقدرةً","يروي الارض نصراً والعلى نصرا",92,"ر",2,0],["ومِنْ غرائبِ ما يُروَى مُحافَظَتي","على مَودّةِ مَنْ يُرْضِيهِ إِحْفاظِي",93,"ظ",2,0],["ومن غير هذا الهوَى إنَّني",