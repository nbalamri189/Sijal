{"poems":[[79,"فتحت سعودك كل باب مبهم","https://www.aldiwan.net/poem36122.html","الكامل"],[87,"يا ناي كيف عرفت أرباب الهوى","https://www.aldiwan.net/poem7523.html","الكامل"],[87,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[45,"فعلت بنا فعل السماء بأرضه","https://www.aldiwan.net/poem9715.html","الكامل"],[68,"عجنا على وادي الصفا فصفا","https://www.aldiwan.net/poem38797.html","الكامل"],[76,"هل ساءه أن آل آسا ورده","https://www.aldiwan.net/poem12846.html","الكامل"],[132,"أوصيكمو يا أيها العقلاء","https://www.aldiwan.net/poem50680.html","الكامل"],[137,"فتح مبين جل أن يتخيلا","https://www.aldiwan.net/poem4220.html","الكامل"],[445,"كفي شئونك ساعة فتأملي","https://www.aldiwan.net/poem34808.html","الكامل"],[463,"قم غير معتذرٍ ولا متثاقلِ","https://www.aldiwan.net/poem55926.html","الكامل"],[463,"طرقت على خطر السرى المركوب","https://www.aldiwan.net/poem56281.html","الكامل"],[473,"قامت قيامة روحها لرواحي","https://www.aldiwan.net/poem60287.html","الكامل"],[479,"دعوت أبا ليلى إلى السلم كي يرى","https://www.aldiwan.net/poem2148.html","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67843","الطويل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118412","البسيط"],[2165,"","https://poetry.dctabudhabi.ae/diwan/poem/20454","الكامل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66558","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77005","البسيط"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86355","الرمل"],[4210,"","https://poetry.dctabudhabi.ae/diwan/poem/111190","الكامل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76738","الكامل"],[4830,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=193597",""],[5508,"أقول لمعشر حمدوا أكفّاً","https://www.poetsgate.com/ViewPoem.aspx?id=110827",""]],"verses":[["فَكَأَنَّ صَفْحَ الْبَحْرِ مَدَّتْ فَوْقَهُ","أَيْدِي الرِّيَاحِ مَطَارِفاً مِنْ عَنْدَمِ",0,"م",1,0],["فكان صوتك انة بعث الجوى","وكأن غابك من ضلوع العاشق",1,"ق",1,0],["فَكانَ صِراطُ الحَشرِ ما ثَمَّ ريبَةٌ","وَكانوا فَريقَ اللَهِ ما ثَمَّ مُذنِبُ",2,"ب",1,0],["فَكَأَنَّ صِحَّةَ نَسجِها مِن لَفظِهِ","وَكَأَنَّ حُسنَ نَقائِها مِن عِرضِهِ",3,"ض",2,0],["فَكَأَنَّ صَوبَ المُزنِ يَعشَقُها","فَأَقامَ لا يَبغي بِها حِوَلا",4,"ل",2,0],["فَكَأَنَّ صَفحَتَهُ وَنَدَّ عِذارِهِ","ماءٌ يَثورُ بِصَفحَتَيهِ طِحلِبُ",5,"ب",1,0],["فكأن صاحبه مُصاحب حَيَّةٍ","رقطاءَ بئست حَيَّةٌ رقطاءُ",6,"ا",2,0],["فكأن صارمَهُ وهامات العدا","كفٌّ تدحرجُ في الصعيد الحنظلا",7,"ل",2,0],["فكأَنَّ صفحةَ وجهِهِ شمسُ الضُحَى","وُصِلَتْ ببدرٍ بالنجومِ مُكَلَّلِ",8,"ل",1,0],["فكأنّ صِرفَ شَمولةٍ مسكوبةٍ","في الكأس من خُلُقٍ له وشمائلِ",9,"ل",1,0],["فكأنَّ صَحْبي نافحتهم قَرقفٌ","أو فزَّ بينهُمُ عِيابُ الطِّيبِ",10,"ب",1,0],["فَكَأَنَّ صَفحَةَ وَجهِها لَمّا بَكَت","رَوضٌ تَرَصَّعُ وَردَهُ بِأَقاحِ",11,"ح",1,0],["فكان صريعَ الخيل أول وهلة","فبعداً له مختار عجز على علم",12,"م",1,0],["فَكَانَ صَبَاحاً مُسْفِراً بِنَجَاحِهِ","بِهِ شَرُفَ الْوَادِي وَأهْلُ بِطَاحِهِ",13,"ه",1,0],["فكان صائدنا مثل الكتاب اذا","يطوى وكان له يهديه عنوانا",14,"ن",2,0],["فَكَأَنَّ صالِحَ أَهلَ جَوَّ غُدوَّةً","صُبِحوا بِذيفانَ السِمامِ المُنقَعِ",15,"ع",1,0],["فَكَأنَّ صارِمَهُ خَطِي","بٌ مِصْقَعٌ وَإلْهامَ مِنْبَرْ",16,"ر",1,0],["فَكانَ صَفو حَياتي لا يَكدره","صَرفُ الزَمانِ الَّذي قَد عودَ النوبا",17,"ب",2,0],["فكأن صورة ثغر أشنبا","لاثه الخمر وما لاث الخمار",18,"ر",1,0],["فكأن صكصكة الكؤوس لديهم","ألحان اسحاق بنغمة معبد",19,"د",1,0],["فكأن صوب حيا وصعقة بارق","ما ضم منه نديه والمأزق",20,"ق",1,0],["فكانَّ صوتَ زفيرها قولٌ علا","ياساسةَ الزمنِ الوضيعِ تلطَّفوا",21,"ف",3,0],["فكان صعودهم فيه نزولا","كما لنشاطهم فيه فتورُ",22,"ر",1,0]]}