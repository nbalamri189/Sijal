{"poems":[[77,"باتت نجوم الأفق دون علاكا","https://www.aldiwan.net/poem36385.html","الكامل"],[93,"يا صورة شبهت صخراً بإنسان","https://www.aldiwan.net/poem11173.html","البسيط"],[27,"أجدك لا يصحو الفؤاد المعلل","https://www.aldiwan.net/poem5970.html","الطويل"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[72,"حضرت صلاة العصر خلف مبلغ","https://www.aldiwan.net/poem19635.html","الطويل"],[51,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[85,"عش للخلافة ترضاها وترضيها","https://www.aldiwan.net/poem7528.html","البسيط"],[85,"شيعوا الشمس ومالوا بضحاها","https://www.aldiwan.net/poem8109.html","الرمل"],[62,"حضاننا السحق فلا","https://www.aldiwan.net/poem52145.html","مجزوء الرجز"],[62,"إن الألى ضربوا لنا مثلا","https://www.aldiwan.net/poem52209.html","أحذ الكامل"],[45,"صنت نفسي عما يدنس نفسي","https://www.aldiwan.net/poem64601.html","الخفيف"],[45,"حضرموت وأينما حضرموت","https://www.aldiwan.net/poem65149.html","الخفيف"],[61,"أغرتك الشهاب أم النهار","https://www.aldiwan.net/poem51685.html","الوافر"],[66,"حضوري عند مجدك مثل غيبي","https://www.aldiwan.net/poem38687.html","الوافر"],[44,"قلبت أمري في بدء وفي عقب","https://www.aldiwan.net/poem30054.html","البسيط"],[44,"أعيدي النوح معولة أعيدي","https://www.aldiwan.net/poem30318.html","الوافر"],[69,"حضوركم غاية إيناسي","https://www.aldiwan.net/poem28622.html","السريع"],[105,"هدأ المخيم واطمأن المضجع","https://www.aldiwan.net/poem44071.html","الكامل"],[102,"وغريرة في المكتبه","https://www.aldiwan.net/poem33124.html","مجزوء الكامل"],[52,"عرج على الدار التي كنا بها","https://www.aldiwan.net/poem27298.html","الرجز"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39562","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42505","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43837","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43635","الطويل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/5138","الكامل"],[106,"في مهرجان دار العلوم","https://www.poetsgate.com/ViewPoem.aspx?id=179366",""],[90,"قف بأجداث الضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=179225",""],[113,"ملك الدنيا امام المسلمين","https://www.aldiwan.net/poem40477.html","عموديه"],[113,"يا بعينيك طر الى بغداد","https://www.aldiwan.net/poem41168.html","عموديه"],[126,"سمعا وطوعا للإمام","https://www.aldiwan.net/poem50606.html","مجزوء الكامل"],[130,"كلف العيس بالسرى فذراها","https://www.aldiwan.net/poem54692.html","الخفيف"],[139,"ملكتني المدامة الخندريس","https://www.aldiwan.net/poem2364.html","عموديه"],[141,"لك السعي ما ينفك يخدمه السعد","https://www.aldiwan.net/poem11747.html","الطويل"],[153,"رب ليل طلعت فيه","https://www.aldiwan.net/poem55779.html","مجزوء الرمل"],[158,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[187,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[187,"أقبل على مدح النبي مفخما","https://www.aldiwan.net/poem35104.html","الكامل"],[209,"حضرت وما في الجيب غير دراهم","https://www.aldiwan.net/poem46234.html","الطويل"],[209,"حضرنا إلى نهرنا نستقيه","https://www.aldiwan.net/poem46235.html","المتقارب"],[209,"أمن أجل أجسام نواعم بضة","https://www.aldiwan.net/poem46264.html","الطويل"],[209,"حضرنا ننظر النهرا","https://www.aldiwan.net/poem46274.html","مجزوء الوافر"],[248,"دع اللوم أو لمني فلست بسامع","https://www.aldiwan.net/poem14947.html","الطويل"],[273,"أعمى البصيرة من تقدمه الهوى","https://www.aldiwan.net/poem25561.html","الكامل"],[295,"يا صاح هذا المشهد الأقدس","https://www.aldiwan.net/poem33243.html","السريع"],[301,"حضرت مجلس قوم","https://www.aldiwan.net/poem57634.html","المجتث"],[301,"يا سيدا رب العلا","https://www.aldiwan.net/poem57736.html","مجزوء الرجز"],[302,"خلها تجري بعين الله في","https://www.aldiwan.net/poem16878.html","الرمل"],[314,"حضرتكم دهرا وفي الكم تحفه","https://www.aldiwan.net/poem69422.html","الطويل"],[317,"حضض قومي مضرحي بن يعمر","https://www.aldiwan.net/poem23874.html","الطويل"],[324,"حضر الرحيل وشدت الأحداج","https://www.aldiwan.net/poem44288.html","البسيط"],[351,"بلغا عني ربوع الصالحيه","https://www.aldiwan.net/poem39576.html","الرمل"],[351,"يا سميري في السرى عرجا بي","https://www.aldiwan.net/poem40822.html","الخفيف"],[362,"طرقت بليل من سناها مقمر","https://www.aldiwan.net/poem60912.html","الكامل"],[362,"حضرت لإسماعيل مجلس وعظه","https://www.aldiwan.net/poem60945.html","الطويل"],[362,"قسما مني بأيام الصفاء","https://www.aldiwan.net/poem61005.html","الطويل"],[363,"حضض قومي باللقاء ومعشري","https://www.aldiwan.net/poem44374.html","الطويل"],[364,"ما العجب في خلق ذاك الخلق بالعجب","https://www.aldiwan.net/poem17312.html","البسيط"],[367,"لك الله نور الدين ردء وحافظ","https://www.aldiwan.net/poem4297.html","الطويل"],[369,"كل من يستكفني يغريني","https://www.aldiwan.net/poem57066.html","الخفيف"],[388,"ياتاركا للمدارس ليس هذا حسن","https://www.aldiwan.net/poem54482.html","عموديه"],[396,"قد كنت لي جبلا ألوذ بظله","https://www.aldiwan.net/poem4513.html","الكامل"],[413,"زيد لوما فزاد في الحب وجدا","https://www.aldiwan.net/poem54124.html","الخفيف"],[418,"أدرها لنا صرفا ودع مزجها عنا","https://www.aldiwan.net/poem46357.html","الطويل"],[436,"أخلق الدهر بقاء واستجد","https://www.aldiwan.net/poem34820.html","الرمل"],[456,"حماها أن تشل وأن تراعا","https://www.aldiwan.net/poem56121.html","الوافر"],[477,"ظلموك يا جدي ولست ظلوما","https://www.aldiwan.net/poem37194.html","الكامل"],[498,"يستغرب الخب أن نعلو وقد برزت","https://www.aldiwan.net/poem37809.html","البسيط"],[498,"أورد الدلو لعقد الكرب","https://www.aldiwan.net/poem38069.html","الرمل"],[498,"أضحى فؤادي منيرا","https://www.aldiwan.net/poem38088.html","المجتث"],[498,"إن معنى الهيام بالأولياء","https://www.aldiwan.net/poem38101.html","الخفيف"],[503,"العار","https://www.aldiwan.net/poem42463.html","البسيط"],[513,"قبولاً وإن بان عجز الخواطر","https://www.aldiwan.net/poem12122.html","الطويل"],[536,"واسلك سبيل المفلسين ودار","https://www.aldiwan.net/poem48172.html","عموديه"],[549,"زارك زوار الحلم","https://www.aldiwan.net/poem47191.html","مجزوء الرجز"],[556,"أنا أدرى كنه ذاته","https://www.aldiwan.net/poem33517.html","مجزوء الرمل"],[556,"هذه الكائنات أم هي حانه","https://www.aldiwan.net/poem33691.html","الخفيف"],[556,"لمتى أنت في الضلال المبين","https://www.aldiwan.net/poem33722.html","الخفيف"],[556,"مرج البحرين إذ يلتقيان","https://www.aldiwan.net/poem33756.html","الرمل"],[556,"نحن قوم متنا به وفنينا","https://www.aldiwan.net/poem33804.html","الخفيف"],[556,"نحن قوم نهوى الوجوه الحسانا","https://www.aldiwan.net/poem33816.html","الخفيف"],[556,"طلعت شمسنا على الأفلاك","https://www.aldiwan.net/poem34274.html","الخفيف"],[556,"صحن صحناء واسع الأطراف","https://www.aldiwan.net/poem34340.html","الخفيف"],[556,"ملكوت السماء والأرض","https://www.aldiwan.net/poem34415.html","الخفيف"],[556,"فيه أنا ميت ومقبور","https://www.aldiwan.net/poem34481.html","السريع"],[556,"إن هذا بعض ما قد ظهرا","https://www.aldiwan.net/poem34511.html","الرمل"],[556,"انظر الكون خارجا من وجوده","https://www.aldiwan.net/poem34563.html","الخفيف"],[556,"خلوة القبر أشرف الخلوات","https://www.aldiwan.net/poem34708.html","الخفيف"],[556,"حضرة الغيب سترها الأشياء","https://www.aldiwan.net/poem35077.html","الخفيف"],[565,"جنبك الله عارض العلل","https://www.aldiwan.net/poem69535.html","المنسرح"],[565,"ملكتني وصيفة لأناس","https://www.aldiwan.net/poem69722.html","الخفيف"],[573,"حضر الحبيب","https://www.aldiwan.net/poem2727.html","مجزوء الكامل"],[573,"فرقت بين بنانها وخضابها","https://www.aldiwan.net/poem3101.html","الكامل"]],"verses":[["حَضَرَ الْوَلِيُّ وَأَحْكَمَتْ ريِحُ الصَّبَا","بَيْنَ الْغَمَامِ وَبَيْنَهَا إِمْلاكَا",0,"ك",2,0],["حَضَارَتَانِ سَمَا شَأْوُ النُّهَى بِهِمَا","أَفَادَتَا كُلَّ تَثْقِيفٍ وَعِرْفَانِ",1,"ن",1,0],["حَضَضتُ عَلى القَومِ الَّذينَ تَرَكتَهُم","تَعُلُّ الرُدَينِيّاتُ فيهِم وَتَنهَلُ",2,"ل",1,0],["حَضَأنَا نارَ مَكرُمضة وعِزٍّ","نَشُبُّ وَقُودَها لِلمُصطَلينَا",3,"ن",2,0],["حضرت صلاة العصر خلف مبلّغٍ","بهيّ المحيَّا يعشق الجمع شكلهُ",4,"ه",1,1],["حضضتَ على حطبي لناري فلا تدعْ","لك الخيرُ تحذيري شرورَ المَحاطبِ",5,"ب",1,0],["حضارة يخدع الأغرار زخرفها","وما زخارفها إلا مخازيها",6,"ي",3,0],["حَضَنَت نَعشَكَ وَاِلتَفَّت بِهِ","رايَةٌ كُنتَ مِنَ الذُلِّ فِداها",7,"ا",3,0],["حضاننا السحق فلا","تسحق دواءٌ بيدِ",8,"د",1,1],["حضنوه أياما لها عددٌ","جمٌّ بلا سأم ولا مللِ",9,"ل",1,0],["حَضَرَت رَحلِيَ الهُمومُ فَوَجَّه","تُ إِلى أَبيَضَ المَدائِنِ عَنسي",10,"س",2,0],["حَضرَمَوتُ وَأَينَما حَضرَمَوتُ","بَلَدٌ دونَهُ الفَلا وَالفَيافي",11,"ي",1,1],["حضَرْنا والملوكُ به قِيامٌ","تَغُضُّ نواظراً فيها انكسارُ",12,"ر",1,0],["حُضوري عِندَ مَجدِكَ مِثلُ غَيبي","وَبُعدي عَن جَنابِكَ مِثلُ قُربي",13,"ي",1,1],["حَضرَمتُ دَهري وَأَشكالي لَكُم وَبِكُم","حَتّى بَقيتُ كَأَنّي لَستُ مِن أُدَدِ",14,"د",1,0],["حَضَرتُ فَناءَ بابِكَ فَاِعتَراني","شَجىً بَينَ المُخَنَّقِ وَالوَريدِ",15,"د",1,0],["حضورُكم غايةُ إيناسي","وقربُكم تذكرةُ الناسي",16,"ي",1,1],["حَضرتْ منيّتُهُ وحُمَّ قَضَاؤُه","ولكلِّ نَفسٍ يَومُها والمصرعُ",17,"ع",1,0],["حَضَنَتْهُ تقرأُ ما حوى","وحَنَتْ عليه وما انتبه",18,"ب",2,0],["حَضَّرتُها وَكُنتُ مِن أَصحابِها","فَطارَتِ الهاماتُ عَن رِقابِها",19,"ب",3,0],["حُضَّر في القلوب أنتم وإن كن","تُم على ملتقى النواظر غيَّبْ",20,"ب",1,0],["حَضَرِيَّةَ الأَنْسَابِ إِلَّا أَنَّها","بَدَوِيَّةٌ في الطَّبْعِ وَالتَّرْكِيبِ",21,"ب",1,0],["حَضَرتُها كقَارِيءٍ","مَغْزَى النُّهَى فِي مُخْتَصَرْ",22,"ر",1,0],["حَضَرتَ أَو غِبتَ ما لِقَلبي","إِلّا إِلى ذِكرِكَ اِرتِياحُ",23,"ح",1,0],["حَضَرنا وَإِن غِبنا جسوماً خَواطِراً","فَنَحنُ قَريبٌ وَالمَنازِلُ نُزَّحُ",24,"ح",1,0],["حَضَروا السِماطَ فَكُلَّما راموا القِرى","مالَت بِأَيديهِم عُقولٌ ذُهَّلُ",25,"ل",1,0],["حضريَّة يُدْمِي بعيرُ عُنيزَة","بِزمامِهِ إبْهَامَها والخِنْصَرَا",26,"ر",2,0],["حضَنَ \" التاجُ \" بنيه فتعالَى","وتعالى \" حارسُ التاج \" جَلالا",27,"ل",2,1],["حضَنَ التاجُ بنيهِ حضنْةَ الليث","لا يبغي عن \" الشِبل \" انفِصالا",27,"ل",2,0],["حضرة ضمت امام الاوليا","مجتبى اولاد زين العابدين",28,"ن",1,0],["حضرة الفتح سدة المنح معنى","شيخ اهل العلوم والارشاد",29,"د",1,0],["حضرُوا جميعاً في ذُرَى","نَزْوى وكلٌّ مُنتِظر",30,"ر",1,0],["حَضرَةَ المُصطَفَي الخَلِيفَةِ كَشَّا","فِ العَوِيصَاتِ في حِجَابِ دُجَاهَا",31,"ا",3,0],["حَضرَةَ العِلمِ وَالأَناةِ وَإِحيا","ءِ المَعالِي وَقَفوِ سُنَّةِ طَهَ",31,"ه",1,0],["حَضرَة العَالِمِ التَّقِيِّ النَّقِيِّ ال","عاذِلِ البَاذِلِ السَّكُوبَ نَدَاهَا",31,"ا",3,0],["حَضرَةَ مَن أَتَى إِلَيها سَعيدٌ","أَو أَتَى مَن أَتى لِمَن قَد أَتاها",31,"ا",3,0],["حَضرَةً أُسِّسَت عَلَى مَحضِ تَقوَى ال","لَهِ طُوبَى لَهَا وَوَاهاً وَوَاهَا",31,"ا",3,0],["حضرتنا السعود فيه وغابت","عن ذرانا فلم تطرنا النحوس",32,"س",1,0],["حَضَرتَ فَوَجهُ الدَهرِ أَبلَجُ ناضِرٌ","وَإِن غِبتَ حيناً فَهوَ أَكلَفُ مُربَدُّ",33,"د",1,0],["حضرتْ فيهِ اللذاذا","تُ بِفقدانِ الرَّقيبِ",34,"ب",1,0],["حضرت لآجال حضرن ولو بقى","لهم أجل ما كنت فيها بحاضر",35,"ر",1,0],["حَضرتُ بفقهِ الشافعيّ خطيبهُ","عَلى شيخِ شربينٍ فألفيتهُ بَحرا",36,"ر",2,0],["حَضرَ الوقيعةَ جبرئيلُ بعسكر","وَاللَّه ناصرهُ وإن لم يحضرِ",37,"ر",1,0],["حضرت وما في الجيب غير دراهم","إلى بلد لم تغن فيه الدراهم",38,"م",1,1],["حضرت أبث البحر شوقي وإنني","بأمواج هذا البحر ظمآن هائم",38,"م",1,0],["حضرت أناجيه فثارت عواصف","وأعقبها بعد الهبوب غمائم",38,"م",1,0],["حضرنا إلى نهرنا نستقيه","ففي مائه عسل ذائب",39,"ب",1,1],["حضرنا نبث البحر ألام قلبنا","فهل أنت يا بحر الصبابة سامع",40,"ع",1,0],["حضرنا ننظر النهرا","ونسمع موجه الصاخب",41,"ب",1,1],["حضمَت ثغرها والخدَّ عن حائم شَجٍ","له أملٌ في مَوردٍ ومُوَرَّدِ",42,"د",1,0],["حَضَرَ المُصَلَّى وَهْوَ مَشْهودٌ بِمَن","تَتَزَيَّنُ الدُّنيا به مَحْضورُ",43,"ر",1,0],["حضرةُ قُدسٍ لم يَنَل فضلَها","لا المَسجد الأَقصى ولا المقدِسُ",44,"س",1,0],["حضرت مجلس قومٍ","وفيه ظبيٌ مهفهف",45,"ف",1,1],["حضرته يانعةٌ","بهيئةٍ مشرفه",46,"ف",2,0],["حضرة القدس وسدرة منتهى","جنة المأوى وشأن قد علا",47,"ل",2,0],["حضرتكم دهرا وفي الكم تحفه","فما أذن البواب لي في لقائكم",48,"م",1,1],["حَضَّضَ قَومي مَضرَحِيُّ بنُ يَعمُرٍ","فَلِلَهِ قَومي حينَ هَزّوا العَوالِيا",49,"ي",2,1],["حَضَرَ الرَحيلُ وَشُدَّتِ الأَحداجُ","وَغَدا بِهِنَّ مُشَمِّرٌ مِزعاجُ",50,"ج",1,1],["حَضرة أَنوارها تَمحو دُجى","كُلّ وَهم يَهلك النَفس