{"poems":[[77,"باتت نجوم الأفق دون علاكا","https://www.aldiwan.net/poem36385.html","الكامل"],[93,"يا صورة شبهت صخراً بإنسان","https://www.aldiwan.net/poem11173.html","البسيط"],[27,"أجدك لا يصحو الفؤاد المعلل","https://www.aldiwan.net/poem5970.html","الطويل"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[72,"حضرت صلاة العصر خلف مبلغ","https://www.aldiwan.net/poem19635.html","الطويل"],[51,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[85,"عش للخلافة ترضاها وترضيها","https://www.aldiwan.net/poem7528.html","البسيط"],[85,"شيعوا الشمس ومالوا بضحاها","https://www.aldiwan.net/poem8109.html","الرمل"],[62,"حضاننا السحق فلا","https://www.aldiwan.net/poem52145.html","مجزوء الرجز"],[62,"إن الألى ضربوا لنا مثلا","https://www.aldiwan.net/poem52209.html","أحذ الكامل"],[45,"صنت نفسي عما يدنس نفسي","https://www.aldiwan.net/poem64601.html","الخفيف"],[45,"حضرموت وأينما حضرموت","https://www.aldiwan.net/poem65149.html","الخفيف"],[61,"أغرتك الشهاب أم النهار","https://www.aldiwan.net/poem51685.html","الوافر"],[66,"حضوري عند مجدك مثل غيبي","https://www.aldiwan.net/poem38687.html","الوافر"],[44,"قلبت أمري في بدء وفي عقب","https://www.aldiwan.net/poem30054.html","البسيط"],[44,"أعيدي النوح معولة أعيدي","https://www.aldiwan.net/poem30318.html","الوافر"],[69,"حضوركم غاية إيناسي","https://www.aldiwan.net/poem28622.html","السريع"],[105,"هدأ المخيم واطمأن المضجع","https://www.aldiwan.net/poem44071.html","الكامل"],[102,"وغريرة في المكتبه","https://www.aldiwan.net/poem33124.html","مجزوء الكامل"],[52,"عرج على الدار التي كنا بها","https://www.aldiwan.net/poem27298.html","الرجز"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39562","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42505","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43837","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43635","الطويل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/5138","الكامل"],[106,"في مهرجان دار العلوم","https://www.poetsgate.com/ViewPoem.aspx?id=179366",""],[90,"قف بأجداث الضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=179225",""]],"verses":[["حَضَرَ الْوَلِيُّ وَأَحْكَمَتْ ريِحُ الصَّبَا","بَيْنَ الْغَمَامِ وَبَيْنَهَا إِمْلاكَا",0,"ك",2,0],["حَضَارَتَانِ سَمَا شَأْوُ النُّهَى بِهِمَا","أَفَادَتَا كُلَّ تَثْقِيفٍ وَعِرْفَانِ",1,"ن",1,0],["حَضَضتُ عَلى القَومِ الَّذينَ تَرَكتَهُم","تَعُلُّ الرُدَينِيّاتُ فيهِم وَتَنهَلُ",2,"ل",1,0],["حَضَأنَا نارَ مَكرُمضة وعِزٍّ","نَشُبُّ وَقُودَها لِلمُصطَلينَا",3,"ن",2,0],["حضرت صلاة العصر خلف مبلّغٍ","بهيّ المحيَّا يعشق الجمع شكلهُ",4,"ه",1,1],["حضضتَ على حطبي لناري فلا تدعْ","لك الخيرُ تحذيري شرورَ المَحاطبِ",5,"ب",1,0],["حضارة يخدع الأغرار زخرفها","وما زخارفها إلا مخازيها",6,"ي",3,0],["حَضَنَت نَعشَكَ وَاِلتَفَّت بِهِ","رايَةٌ كُنتَ مِنَ الذُلِّ فِداها",7,"ا",3,0],["حضاننا السحق فلا","تسحق دواءٌ بيدِ",8,"د",1,1],["حضنوه أياما لها عددٌ","جمٌّ بلا سأم ولا مللِ",9,"ل",1,0],["حَضَرَت رَحلِيَ الهُمومُ فَوَجَّه","تُ إِلى أَبيَضَ المَدائِنِ عَنسي",10,"س",2,0],["حَضرَمَوتُ وَأَينَما حَضرَمَوتُ","بَلَدٌ دونَهُ الفَلا وَالفَيافي",11,"ي",1,1],["حضَرْنا والملوكُ به قِيامٌ","تَغُضُّ نواظراً فيها انكسارُ",12,"ر",1,0],["حُضوري عِندَ مَجدِكَ مِثلُ غَيبي","وَبُعدي عَن جَنابِكَ مِثلُ قُربي",13,"ي",1,1],["حَضرَمتُ دَهري وَأَشكالي لَكُم وَبِكُم","حَتّى بَقيتُ كَأَنّي لَستُ مِن أُدَدِ",14,"د",1,0],["حَضَرتُ فَناءَ بابِكَ فَاِعتَراني","شَجىً بَينَ المُخَنَّقِ وَالوَريدِ",15,"د",1,0],["حضورُكم غايةُ إيناسي","وقربُكم تذكرةُ الناسي",16,"ي",1,1],["حَضرتْ منيّتُهُ وحُمَّ قَضَاؤُه","ولكلِّ نَفسٍ يَومُها والمصرعُ",17,"ع",1,0],["حَضَنَتْهُ تقرأُ ما حوى","وحَنَتْ عليه وما انتبه",18,"ب",2,0],["حَضَّرتُها وَكُنتُ مِن أَصحابِها","فَطارَتِ الهاماتُ عَن رِقابِها",19,"ب",3,0],["حُضَّر في القلوب أنتم وإن كن","تُم على ملتقى النواظر غيَّبْ",20,"ب",1,0],["حَضَرِيَّةَ الأَنْسَابِ إِلَّا أَنَّها","بَدَوِيَّةٌ في الطَّبْعِ وَالتَّرْكِيبِ",21,"ب",1,0],["حَضَرتُها كقَارِيءٍ","مَغْزَى النُّهَى فِي مُخْتَصَرْ",22,"ر",1,0],["حَضَرتَ أَو غِبتَ ما لِقَلبي","إِلّا إِلى ذِكرِكَ اِرتِياحُ",23,"ح",1,0],["حَضَرنا وَإِن غِبنا جسوماً خَواطِراً","فَنَحنُ قَريبٌ وَالمَنازِلُ نُزَّحُ",24,"ح",1,0],["حَضَروا السِماطَ فَكُلَّما راموا القِرى","مالَت بِأَيديهِم عُقولٌ ذُهَّلُ",25,"ل",1,0],["حضريَّة يُدْمِي بعيرُ عُنيزَة","بِزمامِهِ إبْهَامَها والخِنْصَرَا",26,"ر",2,0],["حضَنَ \" التاجُ \" بنيه فتعالَى","وتعالى \" حارسُ التاج \" جَلالا",27,"ل",2,1],["حضَنَ التاجُ بنيهِ حضنْةَ الليث","لا يبغي عن \" الشِبل \" انفِصالا",27,"ل",2,0]]}