ww.poetsgate.com/ViewPoem.aspx?id=200125",""],[307,"القطار","https://www.poetsgate.com/ViewPoem.aspx?id=215236",""],[5411,"وَرْدَةٌ حمراءُ","https://www.poetsgate.com/ViewPoem.aspx?id=215793",""],[5431,"حضارتنا يُراد لها زوال","https://www.poetsgate.com/ViewPoem.aspx?id=183275",""],[5431,"فدتك روحي يانبضي ويانغمي","https://www.poetsgate.com/ViewPoem.aspx?id=185003",""],[5431,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=186521",""],[5431,"رجولة...كالسهم يعبرُ شامخا لن تُخضعَه!!","https://www.poetsgate.com/ViewPoem.aspx?id=198116",""],[5464,"أوصيك بي شراً اذا خنت الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=7560",""],[5465,"كيف بالعفو عنهم وقديماً","https://www.poetsgate.com/ViewPoem.aspx?id=98427",""],[5518,"في مدح الرسول","https://www.poetsgate.com/ViewPoem.aspx?id=201599",""],[5526,"روعة الغيم","https://www.poetsgate.com/ViewPoem.aspx?id=204615",""],[5533,"نكرانُ الجميل","https://www.poetsgate.com/ViewPoem.aspx?id=176273",""],[5550,"سَألْتُ الشَّيخَ","https://www.poetsgate.com/ViewPoem.aspx?id=211542",""],[5561,"أُمُّ الحضارات","https://www.poetsgate.com/ViewPoem.aspx?id=192738",""],[5595,"حبّاً إليها","https://www.poetsgate.com/ViewPoem.aspx?id=144558",""],[5596,"لطف الاعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=206379",""],[5626,"ردّي إليّ فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=189696",""],[2598,"حَضْرَمَوتٌ فَتَّشَتْ أَحْسَابَنَا","https://www.poetsgate.com/ViewPoem.aspx?id=20694",""],[5692,"صايح عند العصير إستهاضنا","https://www.poetsgate.com/ViewPoem.aspx?id=179113",""],[5701,"حضرت عرسا وغنى","https://www.poetsgate.com/ViewPoem.aspx?id=164696",""],[5739,"قلبي وكر ...!","https://www.poetsgate.com/ViewPoem.aspx?id=155476",""],[5747,"لوعة التذكار","https://www.poetsgate.com/ViewPoem.aspx?id=61615",""],[5776,"حضوركَ أنتَ يكمنُ في الغيابِ","https://www.poetsgate.com/ViewPoem.aspx?id=199436",""],[5956,"ما أكثر آلامَ الإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=185320",""],[5956,"أبواشٌ وشارونيّون","https://www.poetsgate.com/ViewPoem.aspx?id=192363",""],[5956,"البِرُّ بالوالدَيْن","https://www.poetsgate.com/ViewPoem.aspx?id=192713",""],[5956,"هنالك في عمق السعود كواكب","https://www.poetsgate.com/ViewPoem.aspx?id=193362",""],[5963,"آخر ُ الأَلحان","https://www.poetsgate.com/ViewPoem.aspx?id=187414",""],[5974,"فيالق النور","https://www.poetsgate.com/ViewPoem.aspx?id=200260",""],[6102,"موعد","https://www.poetsgate.com/ViewPoem.aspx?id=185070",""],[6131,"رسولُ الثَّرَى","https://www.poetsgate.com/ViewPoem.aspx?id=189281",""],[6142,"حضن الطفل جده شيبة الحم","https://www.poetsgate.com/ViewPoem.aspx?id=155705",""],[6152,"صوتكِ لي ضياء","https://www.poetsgate.com/ViewPoem.aspx?id=206724",""],[6160,"في سُقُوطِ الظِّلِّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87083&r=&rc=0",""],[6185,"قصة الجمال !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86941&r=&rc=1",""],[1583,"هذه الأرض لي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73069&r=&rc=26",""],[5957,"زرعت الحرف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82433&r=&rc=71",""],[6225,"سلمت مصر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80916&r=&rc=185",""],[6247,"أتدرين أنك أمّ الجمال؟!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80293&r=&rc=32",""],[6317,"هذي الرّبوع بوجهها الخلّاب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86084&r=&rc=0",""],[6331,"بغداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82025&r=&rc=6",""],[6344,"حضور بطعمِ الغياب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87972&r=&rc=12",""],[6351,"صباح بنكهة بحّتها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86047&r=&rc=7",""],[572,"ملكَتْنِي وصيفة ٌ لأُنَاسِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9237&r=&rc=94",""],[572,"جَنّبكَ الهُ عارضَ العِلَلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9438&r=&rc=295",""]],"verses":[["حَضَرَ الْوَلِيُّ وَأَحْكَمَتْ ريِحُ الصَّبَا","بَيْنَ الْغَمَامِ وَبَيْنَهَا إِمْلاكَا",0,"ك",2,0],["حَضَارَتَانِ سَمَا شَأْوُ النُّهَى بِهِمَا","أَفَادَتَا كُلَّ تَثْقِيفٍ وَعِرْفَانِ",1,"ن",1,0],["حَضَضتُ عَلى القَومِ الَّذينَ تَرَكتَهُم","تَعُلُّ الرُدَينِيّاتُ فيهِم وَتَنهَلُ",2,"ل",1,0],["حَضَأنَا نارَ مَكرُمضة وعِزٍّ","نَشُبُّ وَقُودَها لِلمُصطَلينَا",3,"ن",2,0],["حضرت صلاة العصر خلف مبلّغٍ","بهيّ المحيَّا يعشق الجمع شكلهُ",4,"ه",1,1],["حضضتَ على حطبي لناري فلا تدعْ","لك الخيرُ تحذيري شرورَ المَحاطبِ",5,"ب",1,0],["حضارة يخدع الأغرار زخرفها","وما زخارفها إلا مخازيها",6,"ي",3,0],["حَضَنَت نَعشَكَ وَاِلتَفَّت بِهِ","رايَةٌ كُنتَ مِنَ الذُلِّ فِداها",7,"ا",3,0],["حضاننا السحق فلا","تسحق دواءٌ بيدِ",8,"د",1,1],["حضنوه أياما لها عددٌ","جمٌّ بلا سأم ولا مللِ",9,"ل",1,0],["حَضَرَت رَحلِيَ الهُمومُ فَوَجَّه","تُ إِلى أَبيَضَ المَدائِنِ عَنسي",10,"س",2,0],["حَضرَمَوتُ وَأَينَما حَضرَمَوتُ","بَلَدٌ دونَهُ الفَلا وَالفَيافي",11,"ف",2,1],["حضَرْنا والملوكُ به قِيامٌ","تَغُضُّ نواظراً فيها انكسارُ",12,"ر",1,0],["حُضوري عِندَ مَجدِكَ مِثلُ غَيبي","وَبُعدي عَن جَنابِكَ مِثلُ قُربي",13,"ي",1,1],["حَضرَمتُ دَهري وَأَشكالي لَكُم وَبِكُم","حَتّى بَقيتُ كَأَنّي لَستُ مِن أُدَدِ",14,"د",1,0],["حَضَرتُ فَناءَ بابِكَ فَاِعتَراني","شَجىً بَينَ المُخَنَّقِ وَالوَريدِ",15,"د",1,0],["حضورُكم غايةُ إيناسي","وقربُكم تذكرةُ الناسي",16,"ي",1,1],["حَضرتْ منيّتُهُ وحُمَّ قَضَاؤُه","ولكلِّ نَفسٍ يَومُها والمصرعُ",17,"ع",1,0],["حَضَنَتْهُ تقرأُ ما حوى","وحَنَتْ عليه وما انتبه",18,"ب",2,0],["حَضَّرتُها وَكُنتُ مِن أَصحابِها","فَطارَتِ الهاماتُ عَن رِقابِها",19,"ب",3,0],["حُضَّر في القلوب أنتم وإن كن","تُم على ملتقى النواظر غيَّبْ",20,"ب",1,0],["حضريّ الخيال إن ذكر المنبت","سمّى نجدا وسمّى العقيقا",21,"ق",2,0],["حَضَرِيَّةَ الأَنْسَابِ إِلَّا أَنَّها","بَدَوِيَّةٌ في الطَّبْعِ وَالتَّرْكِيبِ",22,"ب",1,0],["حَضَرتُها كقَارِيءٍ","مَغْزَى النُّهَى فِي مُخْتَصَرْ",23,"ر",1,0],["حَضَرتَ أَو غِبتَ ما لِقَلبي","إِلّا إِلى ذِكرِكَ اِرتِياحُ",24,"ح",1,0],["حَضَرنا وَإِن غِبنا جسوماً خَواطِراً","فَنَحنُ قَريبٌ وَالمَنازِلُ نُزَّحُ",25,"ح",1,0],["حَضَروا السِماطَ فَكُلَّما راموا القِرى","مالَت بِأَيديهِم عُقولٌ ذُهَّلُ",26,"ل",1,0],["حضريَّة يُدْمِي بع