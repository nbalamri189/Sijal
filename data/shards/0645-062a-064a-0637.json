{"poems":[[65,"رمى صاحبي من ذي الأراك بنظرة","https://www.aldiwan.net/poem45738.html","الطويل"],[46,"كأني لم أبثكما دخيلي","https://www.aldiwan.net/poem30009.html","الوافر"],[237,"رثى لي عذولي يوم زمت مطيتي","https://www.aldiwan.net/poem14812.html","الطويل"],[374,"نزه فؤادك عن وجد وعن وجل","https://www.aldiwan.net/poem4308.html","البسيط"],[505,"جلا سر الغيوب لنا الصباح","https://www.aldiwan.net/poem37682.html","الوافر"],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107260","المتقارب"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122550","الوافر"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50041","الهزج"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48442","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138591",""],[4433,"","https://poetry.dctabudhabi.ae/diwan/poem/121268","الطويل"],[4607,"","https://poetry.dctabudhabi.ae/diwan/poem/132192","الطويل"],[5152,"بعثرةُ طين","https://www.poetsgate.com/ViewPoem.aspx?id=185873",""],[5776,"أطوارُ ......عنكبوت الهولوكوست","https://www.poetsgate.com/ViewPoem.aspx?id=199338",""],[6031,"أَلاَ هَلْ تجاوَزْتَ الخِباءَ المحجَّبَا","https://www.poetsgate.com/ViewPoem.aspx?id=46274",""]],"verses":[["مَتى طَرَقَتْني نَفحَةٌ غَضَوِيَّةٌ","يَفوحُ بِرَيَّاها العَرارُ أَوِ الرَّندُ",0,"د",1,0],["مَتى طابَت جَنىً وَزَكَت فُروعٌ","إِذا كانَت خَبيثاتِ الأُصولِ",1,"ل",1,0],["مَتى طَلَبوا مِنّي لِدَعوايَ شاهِداً","فَإِنَّ شَهودي أَربَعٌ ثُمَّ أَربَعُ",2,"ع",1,0],["متى طلبت وداداً عند ذي حسد","بصدق ودِّك لم تظفر ولم تنل",3,"ل",1,0],["متى طرقت أخا نعم ببؤسٍ","يقول غداً يراحُ ويستراحُ",4,"ح",1,0],["مَتى طِبتُ نَفساً بِها غالَنِي","تذكُّرُها يومَ كانُوا حِلالا",5,"ل",2,0],["مَتَى طَلَعت شُموسُ الرّاحِ فيه","فَيا قُربَ الطُّلُوعِ مِنَ الغُروب",6,"ب",1,0],["متى طلتم لمعروف","بلغتم منه أَوفاهُ",7,"ا",2,0],["متى طلعَتْ راعَ القلوبَ اطّلاعُها","وإن غرُبَتْ رابَ النّفوسَ اغتِرابُها",8,"ب",3,0],["متى طاب نفساً في فراق حبيبه","محب ولكن كان امراً مقدرا",9,"ر",2,0],["متى طلَعَ البدرُ واشتَعَلتُ صبابَةً","بما في فؤادي من بدورِ أكلّةِ",10,"ه",1,0],["متى طعمت عيني الكرى بعد بعدكم","فإني في دعوى الهوى غير صادق",11,"ق",1,0],["متى طويتُ مَدَى الأشْعَارِ أرَّقَنِي","صمتُ الحروفِ وخيباتٌ تُنَادِيْنِي !",12,"ن",2,0],["متى طفى وَجْهُ بَيْروتَ التي غُُمِرَتْ؟","وَقَاوَمَتْ أبْحُراً فيها البُحَيْرَاتُ",13,"ت",1,0],["متى طَلبُوهُ مُوجِفِينَ فإنَّما","يُوافونَه سَاعٍ لكم مُتَطَلِّبا",14,"ب",2,0]]}