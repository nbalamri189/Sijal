{"poems":[[10,"ألا ابكي على صخر وصخر ثمالنا","https://www.aldiwan.net/poem21099.html","الطويل"],[87,"بين المقطم والمقطم نسبة","https://www.aldiwan.net/poem7268.html","الكامل"],[27,"دعَتْنا بكهفٍ مِنْ كُنابَيْنِ دعوة ً ،","https://www.poetsgate.com/ViewPoem.aspx?id=18344",""],[266,"محلك من متن السماكين ارفع","https://www.aldiwan.net/poem38242.html","البسيط"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124752","الطويل"],[5121,"تَوَهَّجْتُ نُوراً","https://www.poetsgate.com/ViewPoem.aspx?id=33602",""],[5943,"قلبي سعيدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=34486",""]],"verses":[["فَصَخرٌ لَدَيها مِدرَهُ الحَربِ كُلَّها","وَصَخرٌ إِذا خانَ الرِجالُ يُطيرُها",0,"ر",3,0],["فصخور ذا وسطور ذا وكلاهما","متألف من صخرة صماء",1,"ا",2,0],["فَصِخْدٌ فَشِسْعَى مِنْ عُمَيْرَة َ فاللِّوى","يَلُحْنَ كَما لاَحَ الوُشُومُ القَرَائِحُ",2,"ح",1,0],["فصخروان سحت أياديه صخرة","لديه وعمرو منه عمري يجزع",3,"ع",1,0],["فصخ وصن الآراب كل له زنا","ولكن زنا الفرج الكبيرة فاعدد",4,"د",1,0],["فَصَخَّتْ صُخُورٌ وَخَرَّتْ بِقَلْبِي","دُمُوعٌ دَمُوسٌ كَظُلْمِ اللَّيَالِي",5,"ل",2,0],["فصخرة البحر لمَّا بالهدى سجدت","خوفَ العذاب الذي بالنَّار يحتدمُ",6,"م",1,0]]}