{"poems":[[95,"هكذا هكذا نبوغ الرجال","https://www.aldiwan.net/poem11470.html","الخفيف"],[74,"ما لظبي الحمى إليه التفاته","https://www.aldiwan.net/poem18387.html","الخفيف"],[74,"قل للفهيم الناصري","https://www.aldiwan.net/poem18769.html","مجزوء الرجز"],[74,"خلع أنشرت زمان الرياض","https://www.aldiwan.net/poem19118.html","الخفيف"],[74,"جاءت العاذلات شيئا فريا","https://www.aldiwan.net/poem20564.html","الخفيف"],[53,"لله خالد الطائي من رجل","https://www.aldiwan.net/poem8687.html","البسيط"],[53,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[53,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[47,"إن رق لي قلبك مما ألاقي","https://www.aldiwan.net/poem65188.html","السريع"],[99,"تحت عين الصباح والأنوار","https://www.aldiwan.net/poem24747.html","الخفيف"],[71,"إن لنا في جلق حاجبا","https://www.aldiwan.net/poem28797.html","السريع"],[54,"راب دهر وسطا","https://www.aldiwan.net/poem26869.html","مجزوء الرمل"],[50,"رسم الكرى بين الجفون محيل","https://www.aldiwan.net/poem64968.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55239","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54712","الخفيف"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/5277","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54285","الخفيف"],[164,"بالسعد دار نجم هذا الدار","https://www.aldiwan.net/poem58972.html","الرجز"],[193,"الحمد لله الغني الأحد","https://www.aldiwan.net/poem35111.html","الرجز"],[203,"يا للهوى والغزل","https://www.aldiwan.net/poem45354.html","مجزوء الرجز"],[228,"هذه القصة لا شأن لها","https://www.aldiwan.net/poem41916.html","الرمل"],[237,"عذرا فقلبي ما عليه اعتذار","https://www.aldiwan.net/poem14839.html","السريع"],[369,"صب مقيم سائر فؤاده","https://www.aldiwan.net/poem60930.html","الرجز"],[382,"دهرنا قد تزندقا","https://www.aldiwan.net/poem59319.html","مجزوء الخفيف"],[385,"استغر الله العظيم العفو","https://www.aldiwan.net/poem47411.html","الرجز"],[411,"قلت للقلب من دهاك أجبني","https://www.aldiwan.net/poem49687.html","الخفيف"],[415,"ما خطر السلوان في بالي","https://www.aldiwan.net/poem32547.html","السريع"],[422,"دنف ذو مهجة في الحب تصدا","https://www.aldiwan.net/poem54128.html","الرمل"],[435,"ربع التهاني بالمسرة زاهي","https://www.aldiwan.net/poem40058.html","الكامل"],[438,"ناظر الديوان يحتاج","https://www.aldiwan.net/poem12406.html","مجزوء الرمل"],[438,"اجتل اللهو حمرة في بياض","https://www.aldiwan.net/poem12451.html","الخفيف"],[449,"ناظم الفضل النا قد غدونا","https://www.aldiwan.net/poem56023.html","عموديه"],[463,"بلغت صبرا فقالت ما الخبر","https://www.aldiwan.net/poem56203.html","الرمل"],[466,"أيها الناطق الذي شغل الأل","https://www.aldiwan.net/poem15153.html","الخفيف"],[484,"أطلق الشوق دمعتي","https://www.aldiwan.net/poem37067.html","مجزوء الخفيف"],[484,"عارف ما الشعر صاغيه","https://www.aldiwan.net/poem37208.html","مجزوء الرمل"],[509,"ناظم شرع وساقي كوثر","https://www.aldiwan.net/poem38380.html","عموديه"],[563,"لبسنتني مليحة الغيب مرطا","https://www.aldiwan.net/poem34406.html","الخفيف"],[567,"هكذا هكذا وإلا فلا لا","https://www.aldiwan.net/poem52814.html","الخفيف"],[567,"خطرت وفي قلبي لذاك خفوق","https://www.aldiwan.net/poem52991.html","الكامل"],[572,"ما تغطي أكوار تلك البدور","https://www.aldiwan.net/poem69679.html","الخفيف"],[727,"","https://poetry.dctabudhabi.ae/diwan/poem/204993",""],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53913","الرمل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39057","الخفيف"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104608","الرمل"],[905,"","https://poetry.dctabudhabi.ae/diwan/poem/146462","السريع"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62523","الخفيف"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107188","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59433","الخفيف"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133851","الخفيف"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64894","السريع"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95558","الرمل"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/12034","الدوبيت"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111786","الخفيف"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105426","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66286","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114037","الخفيف"],[1898,"","https://poetry.dctabudhabi.ae/diwan/poem/188181","الخفيف"],[498,"","https://poetry.dctabudhabi.ae/diwan/poem/28126","الرجز"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76796","الرجز"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123123","البسيط"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123040","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53218","الرمل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53099","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53168","الرجز"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109376","الرمل"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67921","الخفيف"],[2582,"","https://poetry.dctabudhabi.ae/diwan/poem/124221","الخفيف"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137107",""],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105665","الخفيف"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75976","المقتضب"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75956","الرمل"],[2799,"","https://poetry.dctabudhabi.ae/diwan/poem/121151","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205023","الخفيف"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79704","الخفيف"],[3329,"","https://poetry.dctabudhabi.ae/diwan/poem/100180","الخفيف"],[3477,"","https://poetry.dctabudhabi.ae/diwan/poem/132951","السريع"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127056","الرجز"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61268","الخفيف"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66351","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91637","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216810","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114050","الخفيف"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103012","الخفيف"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76444","الرمل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101390","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86355","الرمل"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45951","الخفيف"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54480","الرمل"],[4233,"","https://poetry.dctabudhabi.ae/diwan/poem/143567","الخفيف"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58179","الرجز"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139522",""],[4764,"موت المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=27079",""],[4764,"كفة حروف","https://www.poetsgate.com/ViewPoem.aspx?id=36738",""],[4875,"عتْم المسافه","https://www.poetsgate.com/ViewPoem.aspx?id=132252",""],[4988,"فضا الإبداع","https://www.poetsgate.com/ViewPoem.aspx?id=198226",""],[5463,"خل من راح يرحل بكره شوقه يجيبه","https://www.poetsgate.com/ViewPoem.aspx?id=27213",""],[5841,"شهريار وشهرزادي","https://www.poetsgate.com/ViewPoem.aspx?id=34907",""],[5956,"راعي","https://www.poetsgate.com/ViewPoem.aspx?id=184695",""],[6023,"ناظراه إذا تنكَّر تيهاً","https://www.poetsgate.com/ViewPoem.aspx?id=123928",""],[6102,"كبرياء","https://www.poetsgate.com/ViewPoem.aspx?id=184856",""],[6102,"هي .. هي","https://www.poetsgate.com/ViewPoem.aspx?id=185304",""],[6238,"غِيضَ الكَلامُ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86771&r=&rc=0",""]],"verses":[["نَاظِماً مِنْ نَدَاكَ عِقْداً نَفِيساً","تَشْتَهِي لَوْ تُصاغُ فِيهِ الَّلالِي",0,"ل",2,0],["ناظمٌ يشتكي الوليد قصوراً","حيت تتلو رُواته أبياته",1,"ت",2,0],["ناظر بيروت أتى","عساكَ لي أن تنظرا",2,"ر",2,0],["ناظم من جواهر اللفظ فيه","ومن الذم صائن الأعراض",3,"ض",1,0],["ناظراً ساهراً على الملك يدري","كيف يهدي له المرام الخفيّا",4,"ي",2,0],["ناظرتُهُ في استِهِ يوماً فقلتُ لهُ","يا شيخُ ويحك أجْمِمها فقد تَعبتْ",5,"ت",1,0],["ناظراً أن تَردَّ نِقياً براهُ","عضُّ دهرٍ مصمّمٍ صوّالِ",6,"ل",1,0],["ناظرات بأعيُنِ العينِ نَحْوي","عاطفاتٍ سوالفَ الآرام",7,"م",1,0],["ناظِرَةٌ نَحوَكَ مُشتاقَةٌ","مِنكَ إِلى القُربِ وَوَشكِ التَلاق",8,"ق",1,0],["ناظراً في هوامشٍ تأكل العق","ل وتبلي نواضر الأبصارِ",9,"ر",1,0],["ناظرُهُ نحو الرشا مشرفٌ","ما أطمعَ الحاجبَ في العينِ",10,"ن",1,0],["ناظِرٍ في غُرَّةٍ","حَشَّها وَاِشتَرَطا",11,"ط",2,0],["ناظِراً ما أَقلَعَت لَحَظاتُهُ","حَتّى تَشَحَّطَ بَينَهُنَّ قَتيلُ",12,"ل",1,0],["نَاظِرُ الوَقْفِ أَمْسِ أَصْبَحَ فِي تَا","لِيهِ وَالحَرْثُ شأْنُهُ وَالسَّوَامُ",13,"م",1,0],["نَاظِرَاتٍ إِلَى الشُّمُوسِ اللَّوَاتِي","عُدْنَ عَنْهَا بِمِثْلِ أَعْيُنِ رُمْدِ",14,"د",1,0],["ناظِرٌ وِجهَةَ المَليحِ فَلَو يَن","طِقُ حَيّاهُ مُعلِناً بِالسَلامِ",15,"م",1,0],["نَاظِرٌ يَعْبُرُ الْوُجودَ بِلَحْظَيْهِ","فَيَجْتَازُ مُسْتَسِرَّ الْخَفَاءِ",16,"ا",2,0],["ناظرة عين السعود نحوها","قاصرة أكرم بها من دار",17,"ر",1,0],["ناظرُ مَن وراءُه من خلفِ","الشثنُ ذو الجهادِ رحب الكفِّ",18,"ف",1,0],["ناظرةٌ في رجلٍ","مغضيةٌ عن رجلِ",19,"ل",1,0],["ناظِراً في عالَمِ الماضي إِلى","مَجد قَومي المُتَلاشي كَالضَباب",20,"ب",1,0],["ناظِرُهُ يُظهِرُ لي قُدرَةً","وَطَرفُهُ يَرمُقُني بِاِنكِسار",21,"ر",1,0],["ناظِرُ تِبْرٍ ناضِرُ نَقّادُه","له اشترى أصفَرَه بالأسْود",22,"د",1,0],["ناظماً شرح حاله","شاعراً جاء مفلِقا",23,"ق",2,0],["ناظِمُها ولا تسل عبدٌ مُسِي","إنَّ عَنَّ لم يُذكَر وإن غَاب نُسِي",24,"ي",1,0],["ناظِراهُ فيما جنى ناظِراه","أوْدَعاني أمُتْ بِما أوْدَعاني",25,"ن",2,0],["نَاظِرُهُ الفتّاكُ لا ناظِرٌ","علَى تَعَدِّيهِ ولا وَالي",26,"ل",2,0],["ناظمٌ فيكم على طول المدى","مدحاً ترفع لي بالفخر مجدا",27,"د",2,0],["ناظورة الديوان أشرق فضلهِ","ما بين أهل فضائل وجباهِ",28,"ا",2,0],["ناظِرُ الديوانِ يحتا","جُ لِنُورَيْ ناظرَيْنِ",29,"ن",1,1],["ناظِرٌ يخرِقُ الحجابَ بطرْفٍ","عن إساءاتِ قومِه مُتغاضِ",30,"ض",1,0],["ناظم الفضل النا قد غدونا","بعد رب السما عليك عيالا",31,"ل",2,1],["ناظراً عادَكُمُ في مثلها","جَنَّةً لي من عذابٍ منتظَرْ",32,"ر",1,0],["ناظمٌ من بديهةِ القولِ ما تَقْ","صُرُ عنه رويَّةُ الأحْقابِ",33,"ب",1,0],["ناظم الدر ثغرها","مطلع النجم في الشفق",34,"ق",1,0],["ناظر كل لمصلحة","تنبني عنها مباديه",35,"ي",2,0],["ناظم شرع وساقي كوثر","بأب شبير والد الشبر",36,"ر",1,1],["ناظرات من الظبا بعيون","ناعسات من البواتر أسطى",37,"ط",2,0],["ناظِرُ المالِ نظرةٌ منهُ تُغني النْ","نَاسَ حتَّى تكونَ للنَّاسِ مالا",38,"ل",2,0],["ناظرتُها فَسكرتُ مِن لحَظاتِها","وَشَرِبتُ خَمرتَها فَكَيفَ أُفِيقُ",39,"ق",1,0],["ناظماتٌ لها من الدر طِرْفاً","سُبَحاً عُلِّقَتْ مَكَانَ السُّتُورِ",40,"ر",1,0],["ناظر الجامع الكبي","ر ظلوم إذا قدر",41,"ر",1,1],["ناظِروه تعلموا كيف ارتقى","للمعالي مَنْ هواه وعَرَجْ",42,"ج",1,0],["ناظِرِي قادَ خاطِري لِفُتُوني","سَيَطُولُ العَذابُ بَيْني وبَيْنِي",43,"ن",2,0],["ناظرٌ نحوي بِطرفٍ","فاعلٌ فعلَ النِّصالِ",44,"ل",1,0],["ناظرك الفاتك في...","فعلك أم حاجبك المقفل",45,"ل",1,0],["ناظر في مصالح الدولة الغَرّ","اءِ فرد فيما يشيد بِناها",46,"ا",3,0],["ناظِمٌ ناثِرٌ فَأَقلامُهُ الهِي","فُ بِما شَاءَ رُكَّعٌ وَسُجُودُ",47,"د",1,0],["ناظر العين زهر روض المحيا","نكتة السمع غصن دوح الفؤاد",48,"د",1,0],["ناظر يجتلي الطبيعة لا ملّ","سؤالاً ولا أقرّ جوابا",49,"ب",2,0],["ناظِرُكَ الجائرُ هل مُسْلِمٌ","يُجيرُني مِنْ سَهْمِهِ المارقِ",50,"ق",1,0],["ناظم الدر يحلِّى كل جيد","من بليغ اللفظ والمعنى العظيم",51,"م",1,0],["ناظِرٌ فيما فَعَلتَهُ بي ناظِر","يا شَمسُ ضُحىً عَلى قَضيبٍ ناضِر",52,"ر",1,0],["ناظماً بالبديعِ آياتِ حسنٍ","ان تجلت دعت لها الانتهاضا",53,"ض",2,0],["ناظر بالدموع غير بخيل","وحشا بالسلو غير جواد",54,"د",1,0],["ناظرت قلبي رقة فملكته","لكنما ملكت يداك ثمين",55,"ن",1,0],["ناظرته عمد الحياة ومن يعدو","تحدث أنبائه أبناها",56,"ا",3,0],["ناظِم العدل ناثر الجود ما أحسن","في الناس نثرَه ونظامَه",57,"م",2,0],["ناظري ثم عقلي وفؤادي","وكذا خلى الذي اعتمادي عليه",58,"ي",2,0],["ناظِرَةٍ مِن لَهَبٍ مُؤَجَّجِ","وَهامَةٍ كَالحَجَرِ المُدَملَجِ",59,"ج",1,0],["ناظمه يرجو من الله غدا","ثوابه محمد بن أحمدا",60,"د"