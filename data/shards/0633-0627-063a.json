{"poems":[[14,"تقول ألا أقصر من الغزو واشتكى","https://www.aldiwan.net/poem38294.html","الطويل"],[64,"سقى دارها بالجزع صوب غمائم","https://www.aldiwan.net/poem52283.html","الطويل"],[63,"يريك قوامها الغصن الرطيب","https://www.aldiwan.net/poem51809.html","الوافر"],[77,"أرقت لبرق يستطير له لمع","https://www.aldiwan.net/poem69066.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39604","المتقارب"],[38,"","https://poetry.dctabudhabi.ae/diwan/poem/72193","الوافر"],[164,"ما الفخر في الطعن بالعسالة الذبل","https://www.aldiwan.net/poem58998.html","البسيط"],[276,"اليه به سبحانه أتوسل","https://www.aldiwan.net/poem52130.html","الطويل"],[422,"من لصب مستطار القلب هائم","https://www.aldiwan.net/poem53954.html","الرمل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138214",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138283",""],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86921","الرمل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87128","الخفيف"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96723","الكامل"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132844","الطويل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115978","الوافر"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45586","الهزج"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141184","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201824","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204951","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200020","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204709","الوافر"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69967","البسيط"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105110","الخفيف"],[4593,"","https://poetry.dctabudhabi.ae/diwan/poem/130266","الطويل"],[4680,"مجازر الأرواح","https://www.poetsgate.com/ViewPoem.aspx?id=185033",""],[4691,"عطرها يملؤني فرحا","https://www.poetsgate.com/ViewPoem.aspx?id=61363",""],[4859,"سأغسل مهجتي!","https://www.poetsgate.com/ViewPoem.aspx?id=199792",""],[4929,"وضيفة الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=199553",""],[3591,"إذا كنت لم أبرح من الدهر شاكيا","https://www.poetsgate.com/ViewPoem.aspx?id=149441",""],[5121,"اللَّحْنُ الجَرِيحْ","https://www.poetsgate.com/ViewPoem.aspx?id=33509",""],[5121,"عِنَاقُ الأَشْقِيَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=33629",""],[5216,"مجنون","https://www.poetsgate.com/ViewPoem.aspx?id=187649",""],[5273,"مساء الخير","https://www.poetsgate.com/ViewPoem.aspx?id=183101",""],[5376,"سأبقى بداري أعيش الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=188483",""],[5447,"شطرٌ ناقصٌ غرزة","https://www.poetsgate.com/ViewPoem.aspx?id=208375",""],[5582,"بِاللهِ ما سَرَتْ الجَنُوبُ نَسِيمَا","https://www.poetsgate.com/ViewPoem.aspx?id=63576",""],[5616,"سَلِّمْ عَلَيْهَا","https://www.poetsgate.com/ViewPoem.aspx?id=204587",""],[5688,"سعيد فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=200891",""],[5708,"سأُغمِضُ أجفاني على مضض القذى","https://www.poetsgate.com/ViewPoem.aspx?id=158080",""],[5818,"لست تعرفني","https://www.poetsgate.com/ViewPoem.aspx?id=193182",""],[5956,"ولدي المرضيُّ عنه مريض","https://www.poetsgate.com/ViewPoem.aspx?id=193194",""],[5956,"عجباً يحارب نفسه الصّومالُ","https://www.poetsgate.com/ViewPoem.aspx?id=194484",""],[5956,"بعد الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=194844",""],[5956,"لحل المشكلات","https://www.poetsgate.com/ViewPoem.aspx?id=194892",""],[5975,"نظراتك","https://www.poetsgate.com/ViewPoem.aspx?id=52969",""],[6093,"إن الغياب عن الغياب حضور","https://www.poetsgate.com/ViewPoem.aspx?id=200516",""],[6125,"بكل نقيصةٍ في الحب جاؤوا","https://www.poetsgate.com/ViewPoem.aspx?id=209069",""],[6125,"أحلِّقُ في الدُّجى وحدي","https://www.poetsgate.com/ViewPoem.aspx?id=212879",""],[5080,"بلالٌ دونَ مئذنةٍ أنايا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88134&r=&rc=4",""],[5190,"أُحقِّركُم وأكرَهُكُم جميعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85050&r=&rc=125",""]],"verses":[["سَأُغنيكِ عَن رَجعِ المَلامِ بِمُزمَعٍ","مِنَ الأَمرِ لا يَعشو عَلَيهِ المُطاوِعُ",0,"ع",1,0],["سأغضي وفي الأحشاءِ جُرحٌ وأتَّقِي","بوصلِ حبالِ الودِّ قبلَ اللوائمِ",1,"م",1,0],["سأُغرِبُ في الثناءِ على ابنِ فهدٍ","فما هو في الورى إلا غريبُ",2,"ب",1,0],["سأغدو عليها وهي إضريجُ عَندَمٍ","لها منْظَرٌ بِدْعٌ يجيءُ بهِ بِدْع",3,"ع",1,0],["سأغمضُ عينيَّ كي لا أراكَ","وما في صنيعكَ من مأثمِ",4,"م",1,0],["سأغلِبُ والسماءِ ومَنْ بناها","قَطاةَ مُزاحِمٍ ومَنِ انتحاها",5,"ا",3,1],["ساغفر اليوم ذنبا قد تعاظمه","غيري واحلم حلما غير منتحل",6,"ل",1,0],["سأغرقكم في بحر جودى كَرامة","وأومنكم يوم المراضع تذهل",7,"ل",1,0],["ساغَ ما جرَّعْتني من غصَّةٍ","غير أنِّي عن جنى ريقك صائم",8,"م",1,0],["ساغت مناهلها طابت مراشفها","فأنها للنهي أحلى من الضرب",9,"ب",1,0],["ساغت مناهله فهل تشكو الظما","من بعد أن ترد الزلال وتصدرا",10,"ر",2,0],["ساغَ لي بَعد الَّذي عاينته","مِنكَ أَن أَخلع في الشُكر العِذار",11,"ر",1,0],["ساغ لي مَدحُه وَبَثُّ ثَناه","بِبَديع وَعقد درّ نَظيم",12,"م",1,0],["ساغَت مجاجة رشفها في ريقها","فَحَكت رحيقاً طيّباً مختوما",13,"م",2,0],["سأغفرُ للأيامِ كلَّ عظيمةٍ","لئن قَرَّبت بعد الِبعاد مَزَارَها",14,"ر",3,0],["سأغفرُ للّيالى ما أساءت","وإن ساءت إلىّ به اللّيالى",15,"ل",2,0],["سَأَغدو مِنهُ مَحمولاً","عَلى أَدهَم هِملاج",16,"ج",1,1],["سأغسل رجس الذل عني بنهضة","يقل بها حل ويكثر ترحال",17,"ل",1,0],["سأغدو ويغدو قريضي معي","هدية َعصري الى الأعصر",18,"ر",1,0],["سأغدو متى تأفل خليفتك الذي","يقوم إذا ساد الظلام بتنوير",19,"ر",1,0],["سأغرق في البحر افكاريه","وأدفن في اليمّ أوهاميه",20,"ي",2,1],["سأغدوا مثلهم طفلاً صغيراً","بروح تسكن الجسم الكبيرا",21,"ر",2,0],["ساغ المديحُ بِكم يا سَيدي وَصفا","سبك القَريض بِنار العَقلِ وَالفطنِ",22,"ن",1,0],["ساغ للواردين علا ونهلا","في اغتباق ووردها في اصطباح",23,"ح",1,0],["سأغسل عني العار بالسيف جالبا","علي قضاء الله ما كان جالبا",24,"ب",2,1],["سأغفو وتحييني من الموت صرخة ٌ","ويدمي ضريح الروح قومٌ أراذلُ",25,"ل",1,0],["11 سأغنيه وأمنحه","من لحوني مثلما منحا",26,"ح",2,0],["سأغسل مهجتي بدموع صبري","لعلّ الروح تنظفُ من أسايا",27,"ي",2,1],["سَأُغرِقُ بالخَوْفِ ساحتَه","فلا يهْنَأُ العَيْشَ إلا قَلِيْلَا",28,"ل",2,0],["سأغزو بشعري العالمين لأنه","تقلّد سيفاً من جمالك غازيا",29,"ي",2,0],["سَأَغْدُو رَبِيِعاً بِأَحْضَانِ حَقْلِي","وَصَوْتِي سَيَصْدُو فُنُونَ احْتِرَافِي",30,"ف",2,0],["سَأُغَنِّي فِي رِيَاضِ الْعِشْقِ فُلاًّ","وَأَرِيِجِي يَتَسَنَّى بِاحْتِفَائِي",31,"ا",2,0],["سأغلبُ في الغرامِ العفِّ قيساً","ليبقَ الشِّعْرُ لمْ يحجبْهُ رَمْسُ",32,"س",1,0],["سأغفو فوقَ صدرِكِ مثلَ طفلٍ","يُطارِدُ خوفَهُ معنى الأمانِ",33,"ن",1,0],["سأغدو بليلي وأنظر خلِّي","ورغم أماني الدجي الموحشات",34,"ت",1,0],["سأغزلُ شطرَ هذا الشعرِ مكتملًا","وشطرًا ناقصًا غُرزة",35,"ز",2,0],["ساغَتْ مُجاجَةُ رِيقِها فِي رَشْفِها","فَحَكَتْ رَحِيقاً طَيِّباً مَخْتُوما",36,"م",2,0],["سَأَغْلِقُ بَابَاً ثُمَّ افْتَحُ غَيْرَهُ","لَعَلِّي أَرَى وَجْهَاً تَشُعُّ بِهِ النُّعْمَى",37,"م",2,0],["سأغسل عيني بماء السّحاب","عساه بذلك يجلو البصر",38,"ر",1,0],["سأُغمِضُ أجفاني على مضض القذى","وإن حسب الجهّال أنّيَ جاهلُ",39,"ل",1,1],["س أغيب عنك وعن سمائك أنثني","والشمس ليس يعيبها إلّا الغروبْ",40,"ب",1,0],["سأغيب عن وعيي إلى أن يشتفي","أرجوك يا رحمن أن يتحسّنا",41,"ن",2,0],["ساغوا التزلّف للعدوّ بسؤله","يأتي ويوقف حربهم ويطالُ",42,"ل",1,0],["ساغوا دخول المشركين لأرضهم","بدل التفاهم يا لهم جهّالُ",42,"ل",1,0],["سأغمض عينَ الفؤاد احتراماً","وكبتاً يعزّز همِّي المريرا",43,"ر",2,0],["سأغدو الجحفلَ الفكريَّ أسري","إلى أكواخِ أهلي والقصورِ",44,"ر",1,0],["سأغدو منهجَ الدنيا الحضاري","ورائدَها إلى الخير الوفيرِ",44,"ر",1,0],["سأغيب لبضعة أيام","والقلب يقول متى الطله",45,"ل",2,0],["سأغيبُ عنْ هجْر ِالحبيبِ بذكرِهِ","إنَّ الغيابَ عنِ الغيابِ حُضُورُ",46,"ر",1,1],["سأغرسُ في معاني الحبِّ غرسًا","ليُقبَلَ في تدلُّلِهِ الإيذاءُ",47,"ا",2,0],["سأغمد في الحشا سيفي","وأخرجها بنيراني",48,"ن",2,0],["سأغتصبُ النواعيرَ القدامى","على شغفٍ فتُلبسُني سنايا",49,"ا",3,0],["سأُغرِقُكُم جميعاً في مياهي","وأدفنُكُم بِمَقبَرَتي جميعا",50,"ع",2,0]]}