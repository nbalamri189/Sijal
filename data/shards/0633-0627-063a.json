{"poems":[[14,"تقول ألا أقصر من الغزو واشتكى","https://www.aldiwan.net/poem38294.html","الطويل"],[62,"سقى دارها بالجزع صوب غمائم","https://www.aldiwan.net/poem52283.html","الطويل"],[61,"يريك قوامها الغصن الرطيب","https://www.aldiwan.net/poem51809.html","الوافر"],[75,"أرقت لبرق يستطير له لمع","https://www.aldiwan.net/poem69066.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39604","المتقارب"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72193","الوافر"],[161,"ما الفخر في الطعن بالعسالة الذبل","https://www.aldiwan.net/poem58998.html","البسيط"],[272,"اليه به سبحانه أتوسل","https://www.aldiwan.net/poem52130.html","الطويل"],[417,"من لصب مستطار القلب هائم","https://www.aldiwan.net/poem53954.html","الرمل"]],"verses":[["سَأُغنيكِ عَن رَجعِ المَلامِ بِمُزمَعٍ","مِنَ الأَمرِ لا يَعشو عَلَيهِ المُطاوِعُ",0,"ع",1,0],["سأغضي وفي الأحشاءِ جُرحٌ وأتَّقِي","بوصلِ حبالِ الودِّ قبلَ اللوائمِ",1,"م",1,0],["سأُغرِبُ في الثناءِ على ابنِ فهدٍ","فما هو في الورى إلا غريبُ",2,"ب",1,0],["سأغدو عليها وهي إضريجُ عَندَمٍ","لها منْظَرٌ بِدْعٌ يجيءُ بهِ بِدْع",3,"ع",1,0],["سأغمضُ عينيَّ كي لا أراكَ","وما في صنيعكَ من مأثمِ",4,"م",1,0],["سأغلِبُ والسماءِ ومَنْ بناها","قَطاةَ مُزاحِمٍ ومَنِ انتحاها",5,"ا",3,1],["ساغفر اليوم ذنبا قد تعاظمه","غيري واحلم حلما غير منتحل",6,"ل",1,0],["سأغرقكم في بحر جودى كَرامة","وأومنكم يوم المراضع تذهل",7,"ل",1,0],["ساغَ ما جرَّعْتني من غصَّةٍ","غير أنِّي عن جنى ريقك صائم",8,"م",1,0]]}