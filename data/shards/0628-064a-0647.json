{"poems":[[55,"بغير شفيع نال عفو المقادر","https://www.aldiwan.net/poem30465.html","الطويل"],[29,"ألم خيال هاج من حاجة وقرا","https://www.aldiwan.net/poem5745.html","الطويل"],[53,"بيهقي مزدقي","https://www.aldiwan.net/poem65819.html","مجزوء الرمل"],[93,"أعلى عيني من الدمع غشاء","https://www.aldiwan.net/poem62753.html","عموديه"],[71,"بي هيفاء من بنات العراق","https://www.aldiwan.net/poem28211.html","الخفيف"],[453,"أترى أرضى أهيل الأجراع","https://www.aldiwan.net/poem53745.html","الرمل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49967","البسيط"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74098","الرمل"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46017","الطويل"],[5002,"القصيدة الباكية","https://www.poetsgate.com/ViewPoem.aspx?id=204939",""],[5136,"دعه يبكي فمن بكى يستريح","https://www.poetsgate.com/ViewPoem.aspx?id=121548",""]],"verses":[["بِيَهماءَ يَستَغوي الحُداةَ سَرابُها","عَلى ظَمَإٍ بَينَ الجَوانِحِ ثائِرِ",0,"ر",1,0],["بِيَهماءَ غَورِ الماءِ يُمسي دَليلُها","مِنَ الهَولِ يَشكو في مَسامِعِهِ وَقرا",1,"ر",2,0],["بيهقيٌّ مَزْدقِيٌّ","كافرٌ باللَّهِ مُشرِكْ",2,"ك",1,1],["بي هُمومٍ كُلَّما لاحَ الضِياء","ضَرَبَت فَوقَ عُيوني بِلِثام",3,"م",1,0],["بيَ هيفاءُ منْ بناتِ العِراقْ","أطلقتْ أدمعي وشدَّتْ وثاقْ",4,"ق",1,1],["بى هوى يعجز رضوى حمل ما","حملت منه حنايا أضلعي",5,"ع",2,0],["بيهت كلَّ ثقيل الرأس مال به","كاسُ الكَرى وثنى أَعطافه السُكُرُ",6,"ر",1,0],["بي هِلالاً فضل البَدرَ سَناءَ","وَغَزالاً عَلَّمَ النفرَ الظباءَ",7,"ا",2,1],["بيهماءَ لَم أسمَع بِارجاءِ جَوِّها","سِوى اِطحَلٍ يَعوي لِعاوِيَةٍ طُحلِ",8,"ل",1,0],["بي هاجِرِي ياجيادَ الحرْفِ لي شغفٌ","أحيا أحاسيسَهُ والوجدُ يَنْكَعُهُ",9,"ع",2,0],["بيهس إذ دعت نزال أتاها","إن يهبها الكماة ساع جموح",10,"ح",1,0]]}