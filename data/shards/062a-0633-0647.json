{"poems":[[74,"تفهمه قلبي الشجي فهاما","https://www.aldiwan.net/poem19682.html","الطويل"],[47,"إنك والاحتفال في عذلي","https://www.aldiwan.net/poem65613.html","الخفيف"],[63,"ونى في التصابي بعدما كان شمرا","https://www.aldiwan.net/poem51648.html","الطويل"],[132,"سلام وتسليم وألف مسرة","https://www.aldiwan.net/poem50503.html","الطويل"],[190,"أفق أيها القلب الولوع المكلف","https://www.aldiwan.net/poem43621.html","الطويل"],[369,"روحا ساعة متون القلاص","https://www.aldiwan.net/poem60864.html","الخفيف"],[447,"الصبر من كرم الأخلاق فاصطبر","https://www.aldiwan.net/poem14368.html","البسيط"],[447,"الرزء أعظم أن تراق دموع","https://www.aldiwan.net/poem14460.html","الكامل"],[463,"أيا سكر الزمان متى تفيق","https://www.aldiwan.net/poem56099.html","الوافر"],[520,"ولاؤك دين في الرقاب ودين","https://www.aldiwan.net/poem12276.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122717","الوافر"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93708","السريع"],[2798,"","https://poetry.dctabudhabi.ae/diwan/poem/144186","الطويل"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79725","الرمل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62840","السريع"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110058","البسيط"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128921","الخفيف"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103000","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45952","الطويل"],[4166,"","https://poetry.dctabudhabi.ae/diwan/poem/203266","البسيط"],[4759,"المساء الجميل","https://www.poetsgate.com/ViewPoem.aspx?id=204144",""],[5376,"للقدس آهٍ ولبغدادَ آهات","https://www.poetsgate.com/ViewPoem.aspx?id=188467",""],[5573,"ياليت / وأغفى ثواني","https://www.poetsgate.com/ViewPoem.aspx?id=211556",""],[5596,"نظرة","https://www.poetsgate.com/ViewPoem.aspx?id=205465",""],[6034,"الدهر لا يبرح خوانا","https://www.poetsgate.com/ViewPoem.aspx?id=169609",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[6212,"أميرة الماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1629&r=&rc=10",""]],"verses":[["تسهَّد في حفظ المماليك جفنهُ","وفي كلِّ جفنٍ قد أنام حساما",0,"م",2,0],["تَسهُلُ أَخلاقُهُ وَنَحنُ عَلى","حالٍ مِنَ الدَهرِ وَعرَةِ الحيلِ",1,"ل",1,0],["تسهَّلَ لي في أحمدَ الشِّعرُ طائعاً","ولو رُمْتُه في غيرِه لتعذَّرا",2,"ر",2,0],["تُسَهِّد أجفانَ الكرى بفراقِها","كأنها بالوصلِ تُوقِظُ قائمَا",3,"م",2,0],["تسهّدهُ خودٌ كأنّ قوامها","قضيب تثنيه الرياح وتعطف",4,"ف",1,0],["تَسهَرُ اللّيلَ للمعالي وتُمْسي","عنده قَينةٌ وأَسْوَدُ شاص",5,"ص",1,0],["تسهو وتلهو وترجو ما تؤمله","هيهات لا ينظر المنظور ذو عور",6,"ر",1,0],["تسهو وتلهو والردى لك لازم","ترجو الاناءة منه وهو سريع",7,"ع",1,0],["تسهَّلَ في فمي الصعبانِ منه ال","كلامُ الحلوُ والمعنى الدقيقُ",8,"ق",1,0],["تسهل حزن النائبات بعزمه","وأمست سهول المجد وهي حزون",9,"ن",1,0],["تُسَهِّلُ كُلَّ صَعبٍ وَهُوَ صَعبٌ","فَهل أحدَثتَ أنَّ البَينَ سَهلُ",10,"ل",1,0],["تسهرُ الليلَ في سرورٍ وأنسٍ","بين كأس وقينةٍ وأغاني",11,"ن",2,0],["تَسهر لِلدين وَأَبنائه","وَكَم سَعى الساهرُ للنائم",12,"م",1,0],["تُسهّلُ عندي كلّ صعبٍ أريغُهُ","عزائمُ لا تمضي السّيوفُ كما تمضي",13,"ي",1,1],["تسهرين الليل طوعاً بينهم","ولو أن الجفن قبلاً لم ينم",14,"م",1,0],["تَسهر للنائمِ حاجاتُه","ويكدحُ القائمُ للقاعِدِ",15,"د",1,0],["تسهيمُ رحمتهِ قد ضَمَّ فِتيتهُ","ضِمنَ اللَظى فارتَعَوا في باردٍ شَبِمِ",16,"م",1,0],["تسهر الليل في بكاء على من","هي تهواه دون كل العباد",17,"د",1,0],["تسهل حزنها منه علوم","بخاتمهنّ تنطبع الجبال",18,"ل",1,0],["تَسهَرُ كُلَّ اللَيلِ كَي لا يَرتَعا","بِشَحمِها وَلَحمِها وَيَرجِعا",19,"ع",2,0],["تَسَهَّدَ طَرفي في الدُجى وَتَأَرَّقا","وَقَلبي بِمَن أَهوى غَدا مُتَعَلِّقا",20,"ق",2,1],["تسهيمه في الوغى جسم لمتصل","تسليمه في الرضى وصل لمنسجم",21,"م",1,0],["تسهر الشوق والمفاتن صبح","أشعلته الطيوب والانغام",22,"م",1,0],["تسْهدُ عينُ العربِ دامعةً","لليلِ أجفانٌ لمُرْتَقِبِ",23,"ب",1,0],["تسهر الين الصباح يطق بيبانك","وتظهر ملامح عناك وقلة الخيره",24,"ر",2,0],["تسهر الليل مثلنا بقيودٍ","بين جنبيك أُحكمتْ إحكاما",25,"م",2,0],["تسهو عن الموت وتنسى الردى","ومن قضى مثل سليمانا",26,"ن",2,0],["تسهي كَما الخَطاف لا هوجر الفَلا","مثل السَراب بِناظر اللي يرونها",27,"ن",3,0],["تسهو على وَلَهٍ مشاعلُ وَجْدِها","الصُّوفيّ، أو يصحو الحضورُ المُزْهِرُ",28,"ر",1,0]]}