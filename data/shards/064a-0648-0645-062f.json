{"poems":[[170,"يوم دعانا إلى حيث الكؤوس به","https://www.aldiwan.net/poem47125.html","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64130","الخفيف"],[1765,"","https://poetry.dctabudhabi.ae/diwan/poem/131594",""],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[3443,"","https://poetry.dctabudhabi.ae/diwan/poem/143498","الخفيف"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138522",""],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[5409,"يومٌ بزغت بأفقه مولودا","https://www.poetsgate.com/ViewPoem.aspx?id=155488",""],[5414,"حوار مع منافق","https://www.poetsgate.com/ViewPoem.aspx?id=12929",""],[5614,"شموخ المجد","https://www.poetsgate.com/ViewPoem.aspx?id=4261",""],[5950,"حكاوي","https://www.poetsgate.com/ViewPoem.aspx?id=126265",""],[6118,"عودة الشراع","https://www.poetsgate.com/ViewPoem.aspx?id=12625",""],[170,"يومٌ دعانا إلى حث الكؤوسِ به","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26735&r=&rc=10",""]],"verses":[["يومٌ دعانا إلى حيث الكؤوسِ به","ثلجٌ سقيطٌ وغيمٌ غيرُ مُنْجاب",0,"ب",1,1],["يومُ دجنٍ فما انتظاري ويومُ ال","دجن يومٌ إلى القلوب حبيبُ",1,"ب",1,1],["يوم دبر امره بفكره صافيه","في حيث بالفكر ضاع الانتفاع",2,"ع",1,0],["يوم دارت رحى الوغى والمنايا","أولجت كل موكب في لهاها",3,"ا",3,0],["يوم دجنٍ هواؤه","فاختيُّ رواؤه",4,"ا",3,1],["يوم دهى الإسلام يوم أسود","حجب فيه نوره المتقد",5,"د",1,1],["يَؤُم دمشقَ ومنْ دونها","تُجابُ سُهولُ الفَلا والوُعُورُ",6,"ر",1,0],["يوم دانت في حرب بدرٍ وأحدٍ","وسواها لسيفك الكبرياء",7,"ا",2,0],["يوم دُك الإيوانُ إيوانُ كسرى","بجيوش الإيمان والفاروق",8,"ق",1,0],["يوم دمعي في عيوني مكتحل","والفكر سرحان اضناه الصداع",9,"ع",1,0],["يومّ دنّ الشمال وهبّت الريح هيل","لين روحي بغت تقضي على جالها",10,"ل",3,0],["يوم دَقُوا سواحل الشرق بالغر","بِ ولم يَهْدهم سوى العزمِ هادِ",11,"د",1,0],["يومٌ دعانا إلى حث الكؤوسِ به","ثلجٌ سقيطٌ وغيمٌ غيرُ مُنْجابِ",12,"ب",1,1]]}