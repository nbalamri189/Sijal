.ae/diwan/poem/26567","الرجز"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202067","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200018",""],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74037","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77017","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94801","الطويل"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35431","الكامل"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147286","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72458","الكامل"],[4929,"وصف لمشهد دمار","https://www.poetsgate.com/ViewPoem.aspx?id=199242",""],[4935,"ألهي أنت ديان","https://www.poetsgate.com/ViewPoem.aspx?id=129275",""],[5038,"دع عنك","https://www.poetsgate.com/ViewPoem.aspx?id=189467",""],[5136,"أيها المدره الحليم العليم","https://www.poetsgate.com/ViewPoem.aspx?id=121656",""],[5183,"العجوز","https://www.poetsgate.com/ViewPoem.aspx?id=186415",""],[5431,"إلى الجزائر الحبيبة ....","https://www.poetsgate.com/ViewPoem.aspx?id=190246",""],[5497,"أتيه بحسنه","https://www.poetsgate.com/ViewPoem.aspx?id=208726",""],[5528,"من مثل أحمد..؟ ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=200986",""],[402,"لينر شعاعك يا عروس النيل","https://www.poetsgate.com/ViewPoem.aspx?id=36168",""],[5939,"كأنكِ لم تكوني حلم عمري","https://www.poetsgate.com/ViewPoem.aspx?id=178593",""],[6090,"بدت لنا بمحيا أخجل البدرا","https://www.poetsgate.com/ViewPoem.aspx?id=170914",""],[6093,"رأيٌ على رأيٍ يُفِيْدُ وقَلَّمَا ( الكامل )","https://www.poetsgate.com/ViewPoem.aspx?id=180583",""],[6102,"زيفا الإسرائيلية","https://www.poetsgate.com/ViewPoem.aspx?id=184171",""],[6125,"في ضَيِّ عينيكِ القصيدُ تَبَعثَرا","https://www.poetsgate.com/ViewPoem.aspx?id=210971",""],[6212,"فيفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1620&r=&rc=1",""],[6337,"واهاً لسحركِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81412&r=&rc=24",""]],"verses":[["فَعَقَدنا لَهُ اللِواءَ عَلَينا","وَاِحتَفَلنا نَزيدُهُ إِكراما",0,"م",2,0],["فَعَقَدتِ تاجَكِ مِن ظُبىً مَسلولَةً","وَحَلَلتِ عَرشَكِ مِن قَناً مَشبوكِ",1,"ك",1,0],["فعقمت تلك العذارى ولم","يولد له في عمره نجل",2,"ل",1,0],["فعقدنا الماءين أسبوعنا","مضاعفاً ما فيهما وكسُ",3,"س",1,0],["فَعِقْدُ الدَّمْعِ مَحلولٌ","وعِقْدُ الثَّغْرِ مَرصُوفُ",4,"ف",1,0],["فَعَقَدتُ الفِرزانَ مَعَ بَيدَقِ الصَد","رِ وَسُقتُ الفيلَينِ في الطَرَفَينِ",5,"ن",1,0],["فعقبني في كل يوم وَليلة","إلى الحول من تلك الجواسيس أربع",6,"ع",1,0],["فعقّبته مستطلعاً طِلْع أمره","على البُعد أقفو الأثر منه وأتبع",7,"ع",1,0],["فَعُقُودُ نَظْمٍ رُصِّعَتْ جِدرَانُهُ","بِلآلىءَ اسَتوْقَفْنَ حِينَ مَسِيلِ",8,"ل",1,0],["فَعَقَدَا فِي ثَغْرِهَا دُرَّةً","أَجْمَلَ شيءٍ بَيْنَ دُرِّ الثُّغُورْ",9,"ر",1,0],["فعقَدْن فِيمَا حَوْلَهُ","عِقْداً فَرِيداً مِنْ جَوَاهِر",10,"ر",1,0],["فَعَقلُ ذِى المَهدِ مِنكُم وَهوَ مُرتَضِعٌ","كَعَقلِ مَن شَيبُهُ في فَودِهِ اشتَعَلا",11,"ل",2,0],["فَعَقراً لِلرِكابِ غَداةَ وَلَّت","بِنُزّالِ الحِمى تَطوي المَراحِل",12,"ل",1,0],["فعقول الناس لاهيَةٌ","في الهوى والكسب والأمل",13,"ل",1,0],["فَعُقباه عندَ اللَّه جنّةُ عدنهِ","وَيَنسى بِحلوِ الفوزِ كلّ الّذي مرّا",14,"ر",2,0],["فَعُقباهُ في أُخراه أسوأُ حالةٍ","وَمَثواهُ نارُ اللَّه قَد زَفَرت زفرا",14,"ر",2,0],["فَعَقيلاتُ بَني عُذرَةَ كَم","سَلَبَت بِالحُسنِ وَالدَلِّ عُقولا",15,"ل",2,0],["فَعُقبى كُلِّ شَيءٍ نَحنُ فيهِ","مِنَ الجَمعِ الكَثيفِ إِلى شَتاتِ",16,"ت",1,1],["فعقدْتَ فِي عُنقِ الضَّلالِ مَواثِقاً","دانَتْ بِهَا الرُّهبانُ والأَحبارُ",17,"ر",1,0],["فعقولنا وهي المراتع تجتلى","وقلوبنا وهي العرائس تملكُ",18,"ك",1,0],["فَعُقْبَى أَمْرِهِ ذَمٌّ فَظِيعٌ","يَجِيءُ بِهِ إليْكَ بِلا طَرِيقَهْ",19,"ه",1,0],["فعقود الأيام ما حللت قط","بكف العزاء الا انحلت",20,"ت",1,0],["فَعقدُ درٍّ لِخودٍ عندَهُ وُضِعَت","مريدةُ اللّبسِ مِرآةٌ مِنَ الذّهبِ",21,"ب",1,0],["فَعقدانِ مِن دُرٍّ ثَمينٍ تَنَظَّما","بِسلكٍ مِنَ الياقوتِ أَو سِلكِ عِقيانِ",22,"ن",1,0],["فعقيم الرجاء قد لقحته","راحة منه للأيادي ولود",23,"د",1,0],["فَعَقروها وَأَصابوا ما اشتَهوا","وَما أَرعووا عَن محرم وَلا اِنتَهوا",24,"ه",3,0],["فعقد الثريَّا مستكنٌّ بثغره","ومنطقهُ الجوزاء في خصره تجري",25,"ر",2,0],["فَعَقَروا الناقَةَ لِلشَقاءِ","فَعاجَلَتهُم صَيحَةُ الفَناءِ",26,"ا",2,0],["فعقاب الجو يخشى بأسه","وترجى فيض كفيه النعامى",27,"م",2,0],["فعقلكم قد نأى قديماً","عن عالم القلب لو يؤوب",28,"ب",1,0],["فَعقودُ نَظمي لا يفصلها فمي","إِلّا لِجيد في المَعالي أَجيدِ",29,"د",1,0],["فَعَقارِب الاِصداغِ تَلدَغ في الحَشا","وَعَلَيهِ حَيات القُرون تَدور",30,"ر",1,0],["فعُقبى دُفار التُرَّهاتِ كما بنا","وتسري جميع الناس في ذي الاسالبِ",31,"ب",1,0],["فَعُقولُهُم في نورِهِم مَغموسَةٌ","وَلِسانُهُم لاهٍ بِذِكرِ سَماهُ",32,"ا",2,0],["فعقارب الوقت المعنى تشتكي","من ذلك السأم الذي يتجدد",33,"د",1,0],["فعقيدة الاسلام عقد بنانك ال","حالي النظام بعقدة حلاها",34,"ا",3,0],["فعقلك يُصغي لرهبتها","وعيناك تسمع اقوالها",35,"ل",3,0],["فعقوك واسع ربي","وجود علاك هتان",36,"ن",1,0],["فَعُقولُهُمْ دونَ النّهى هَمَلٌ","وبِلادُهُمْ دونَ الدّنا خِرَبُ",37,"ب",1,0],["فعقوق أن يستحث وليد","والداً للقاء وهو مقيم",38,"م",1,0],["فعقبى السقم في المثل العجوز51","وكم ذلت لذي الجلد العجوز52",39,"ز",1,0],["فعقبة في قلب الزمان مخلدٌ","باسلامنا اللهم تسمو المراتبُ",40,"ب",1,0],["‏فعقلي والمشاعر دون علمي","‏سكارى حائرون بلا مدام",41,"م",1,0],["فَعقائدٌ شتَّى يُؤلِّفُ بَيْنهَا","سَيفُ إذَا حَمِيَ الوَطِيسُ وَأسْرَفَا",42,"ف",2,0],["فعقود نظم رصعت جدرانه","بلالئ استوقفن حين مسيل",43,"ل",1,0],["فعقلُكِ ضَلَّ دَربي في عَماهُ","وقلبُكِ لم يَعُدْ حيًّا سليما",44,"م",2,0],["فعقرب الصدغ يحمي ورد وجنتها","والخال يحرسها من أن ترى شرا",45,"ر",2,0],["فَعُقولُ أفْذاذِ الرِّجِالِ حِديقةٌ","فاقطفْ ثِمارَ حُلومِهم بِكَلامِ",46,"م",1,0],["فَعَقِيدَتِي الحَقُّ المُبِينُ وَ مَنْهَجِي","رَغْمَ الرِّيَاحِ - وَ مَا تَجُورُ بِهِ - الطُّودُ",47,"د",1,0],["فَعَقَدْتُ عَقدًا كي تصيرَ حَلِيلتي","وسبيلُ هذا العَقدِ جاءَ مُيَسَّرا",48,"ر",2,0],["فعقاكِ الشاهينُ يصطادُ السُّهَا","وعقابكِ الإنسانُ يصطادُ العِدَى!",49,"د",2,0],["فعقيدتي في الحبِ دَفْقُ كُلَيْمَةٍٍ","حرفان لم يتجمعا أقساطا",50,"ط",2,0]]}