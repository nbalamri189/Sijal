رحتي زفةً","https://www.poetsgate.com/ViewPoem.aspx?id=201514",""],[5614,"احلام المنام","https://www.poetsgate.com/ViewPoem.aspx?id=1368",""],[5786,"إن كنتَ لي صاحباً قِف لي بهبود","https://www.poetsgate.com/ViewPoem.aspx?id=50651",""],[5794,"غرور الشعر ..","https://www.poetsgate.com/ViewPoem.aspx?id=122796",""],[5829,"العبد التائب","https://www.poetsgate.com/ViewPoem.aspx?id=148784",""],[5829,"في مخيم الكشافة","https://www.poetsgate.com/ViewPoem.aspx?id=161989",""],[5829,"أم اعيش فأطرب","https://www.poetsgate.com/ViewPoem.aspx?id=184482",""],[5894,"عذب المحبة في جمالك مجمع","https://www.poetsgate.com/ViewPoem.aspx?id=131427",""],[5939,"مشاغبة","https://www.poetsgate.com/ViewPoem.aspx?id=180018",""],[5956,"جُدَّة جنَّة الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=184958",""],[5956,"لِمَ عدت يا غالي لشعري؟","https://www.poetsgate.com/ViewPoem.aspx?id=193691",""],[6056,"قديمة نديمة","https://www.poetsgate.com/ViewPoem.aspx?id=130512",""],[6093,"قلبٌ يَطرُقُ البَابَا","https://www.poetsgate.com/ViewPoem.aspx?id=189701",""],[6115,"خلك هبل واحيان يازين الهبال","https://www.poetsgate.com/ViewPoem.aspx?id=180491",""],[6213,"الناس أسرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76273&r=&rc=30",""],[6229,"أمّتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65214&r=&rc=37",""],[6359,"عقدة حجاجي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69089&r=&rc=3",""]],"verses":[["عايَنوا الضَربَ دِراكاً في الطُلى","يُعجِلُ الفارِسَ وَالطَعنَ بِدارا",0,"ر",2,0],["عَايَشْتِ بِالحُسْنَى حَلِيلَكِ","لَمْ تَسُؤْهُ مِنْكِ حَالْ",1,"ل",1,0],["عايَنَ طَرّادَ وُحوشٍ مِصيَدا","كَأَنَّما أَطمارُهُ إِذا عَدا",2,"د",2,0],["عايَنتَ مُشعَلَةَ الرِعالِ كَأَنَّها","طَيرٌ تُغاوِلُ في شَمامَ وُكورا",3,"ر",2,0],["عاينت صوغ صفاته","فجعلت خاتمه سوارا",4,"ر",2,0],["عايَنتْ فيه قبحها فاجتوتْه","ظالماتٍ هناك ظلماً صريحا",5,"ح",2,0],["عائد القول بالخُلُوقة رهْنٌ","ويعود العطاءُ لاستجدادِهْ",6,"د",2,0],["عائذٌ دهرَهُ إذا سطع النَّقْ","عُ بمعنى مُصَحَّفِ اسمِ أبيه",7,"ه",1,0],["عايَنتُهُ وَكَأَنَّهُ","غُصنُ النَقا ليناً وَقامَه",8,"م",2,0],["عائِبٌ عابني لديكَ ومنهُ","خُلِقَت في ذوي العيوبِ العيوبُ",9,"ب",1,0],["عاينْتُ في شرفاتِهِ نوراً وَمِنْ","عجبٍ بناءُ الكفرِ كيفَ ينيرُ",10,"ر",1,0],["عايَنتُ حَبَّةَ خالِهِ","في رَوضَةٍ مِن جُلَّنارِ",11,"ر",1,1],["عايِن أَواخِرَ كائِنٍ بِأَوائِلٍ","إِنَّ الهِلالَ يُحَقُّ بِالإِبدارِ",12,"ر",1,1],["عايِنْ بِقَلْبِكَ إِنَّ العَين غافِلَةٌ","عَنِ الحقيقَةِ وَاعْلَمْ أَنَّها سَقَرُ",13,"ر",1,0],["عاين فيها الموت أربعينا","ينتظر الناعي أو المعينا",14,"ن",2,0],["عَائِفاً خُطَّةَ الجُدَاةِ وَفِيهِ","طَبْعُ حُرٍّ يَجُودُ لا طَبْعُ جَادي",15,"د",2,0],["عَايَنتُ مِنكُم أَبَا النَّعِيمِ","فِي رَوضَةٍ نَضرَةَ النَّعِيمِ",16,"م",1,1],["عائدٌ أنت لرمل اسكندرية","بأزاهير من الحسن جنيّه",17,"ه",1,0],["عَائِذاً بِكُمْ مِنْ زَمَانِي وَبَثِّهِ","يَا إِلَهِي وَمِنْ عَدُوِّي وَخُبْثِهِ",18,"ث",2,1],["عَائِذاً بِالْحِلْمِ وَالإِجْمَالِ إِنْ","يَنْقَضِ الْغَيْبُ الذِي فِي الْمَشْهَدِ",19,"د",1,0],["عايَنتُ مِنهُ طَلعَةً مَلَكِيَّةً","مِنها عَلى وَجهِ الزَمانِ بَهاءُ",20,"ا",2,0],["عاينتُ مِن خدِّه الْفاني وعارضه","فيروزجَ الصّبحِ مَعْ ياقوته الشفقِ",21,"ق",1,0],["عاينْتَ هندياً أشدَّ من الوغى","صبراً وأقْدمَ من مُروقِ الأسهمِ",22,"م",1,0],["عائِداتٌ إلَيكِ يا رايَة َالرَّحمن ِ","تِلكَ النُّجومُ في كلِّ حال ِ",23,"ل",1,0],["عائدا جئت يومها دون علم","فبغتنا بالأمر فاحترت أمرا",24,"ر",2,0],["عاينت عيناي نورا","بالحبيب مولاي محمد",25,"د",1,0],["عاينت منزلةً في الظرف عاليةً","ورتبةً قصرت عن شأوها الرتب",26,"ب",1,0],["عاينوا منك مُصْمِياً ثُغرةَ النّح","ر وما أرسلتْ يداك سهاما",27,"م",2,0],["عاينتْ منه والحوادثُ يُنكِرْ","ن طلوعاً لم ترجُ منه أُفولا",28,"ل",2,0],["عاين الكل منه ما عاينوه","وهو في غاية من الإرتفاع",29,"ع",1,0],["عاينَه من جوعِه مُطِرقاً","صلّى عليه اللهُ من صابرِ",30,"ر",1,0],["عاينتُ اجناداً تسو","ق جماعةً نحو السجون",31,"ن",1,1],["عاينوا الطُرق عاصَّةً بالوفٍ","يزعجونَ الآفاقَ بالضوضاءِ",32,"ا",2,0],["عاينت منه عيون وشي سدّيت","ببدائع في جانب القرطاس",33,"س",1,0],["عائبٌ كم تَعيبني دون ذنبٍ","جئتهُ فيكَ غير سَعْدي ونَحْسِكْ",34,"ك",1,1],["عايَنَهُ طَرفُ السَماءِ فَاِنثَنى","عِشقاً لَهُ يَبكي بِأَجفانِ المَطَرْ",35,"ر",1,0],["عاينتُ مرأىً لم اُشاهد مِثلهُ","كلّا ولم أسمع بهِ مِن مُخبرِ",36,"ر",1,0],["عاينتُ منه غزالَ إِنسٍ","يُديرُ عَيْنيْ غزالِ وحْش",37,"ش",1,0],["عاينهُ الشَيخ فَراح يَمشي","وَقالَ قم وَاجربنا يا جَحشي",38,"ي",1,0],["عايَنته وَعَلَيهِ ثَوب أَبيَض","وَعمامَةٌ قَد لَفَها بِتَلفُّق",39,"ق",1,0],["عائت مشاربُه فامْلَوْلحتْ كدراً","ولا حلا أبداً ما ساغ أو مضغا",40,"غ",2,0],["عاينت من طلابه","زمراً مواصلة زمر",41,"ر",1,0],["عاينتُ وردَ الروضِ يلطمُ خدَّهُ","ويقولُ وهو على البنفسجِ مُحنقُ",42,"ق",1,1],["عاينتُ في الحمام أسودَ واثباً","من فوقِ أبيضَ كالهلالِ المسفر",43,"ر",1,1],["عاينتَ ليثاً يلتوي في كفِّهِ","ثعبانُ رَملٍ فوقَ متنِ عُقابِ",44,"ب",1,0],["عايش معه عيشة ملده","اعاذله وابغيه يرتد",45,"د",1,0],["عايِف لذيذ النوم والقوت يا زين","وأرجو العفو مِنْ خَالِجٍ جَنّه ونار",46,"ر",1,0],["عاينت عينَ الدّهر في أبنائهِ","ورأيتُ من حُسناهُ أحسنَ مايُرى",47,"ا",1,0],["عايَنْتُ ابيَضَ بالبهاءِ مُتّوَّجا","ومُطَوّقاً ومُنَطَّقاً ومُوشّحاً",48,"ح",2,0],["عايَشت فيها أناسا أمرهم عجبٌ","وَرُدتَ فيها خلاءً فيه تبديد",49,"د",1,0],["عاينتهُ سجناً مخيفاً مظلما","سرحنَ لي هذي الاراقم علَّها",50,"ه",2,0],["عاينوا عيناً وَوَجهاً حسنا","قَمري اللون قدسي الثنا",51,"ن",2,1],["عاينت فيها زهواً وَتيها","ترياق فيها زينهتروش",52,"ش",1,0],["عاينت وقت زوال الشمس طلعته","لذاك عيناي إن قلت اكففا همتا",53,"ت",2,0],["عاينت في المحراب دميته التي","نطقت ونطق مثالها لم يعرف",54,"ف",1,1],["عَايَنُوا الأرضَ التِي كانت لَهُمْ","شِركَةً مَا بَيْنَهُمْ وَالوَعَلِ",55,"ل",1,0],["عَائِداً مِنْهَا إلَى أمثَالِهَا","صَالِحَ الحَالِ بَعِيدَ الأجَلِ",55,"ل",1,0],["عاينت أشيا كما عاينتها وأنا","عن بعض ذلك أحكي بين إنشادي",56,"د",2,0],["عائثاً في صدره يأكل من","رئتيه شرها ملتهما",57,"م",2,0],["عايَنتُ أَسبابَ المَنِيَّةِ عِندَما","أَرخوا أَزِمَّتَها وَشُدَّ وَضينُ",58,"ن",1,0],["عاينتُ فيه مَعالماً بدلائل","لا يَمتري في صدقها اثنان",59,"ن",1,0],["عاينتُ رُقماً مثله","في العالمين منمنما",60,"م",2,0],["عائذاً