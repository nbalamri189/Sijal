{"poems":[[55,"يا أراك الحمى تراني أراكا","https://www.aldiwan.net/poem29922.html","الخفيف"],[55,"أعلمت من حملوا على الأعواد","https://www.aldiwan.net/poem30599.html","الكامل"],[88,"إيه يا ليل هل شهدت المصابا","https://www.aldiwan.net/poem10378.html","الخفيف"],[88,"لله آثار هناك كريمة","https://www.aldiwan.net/poem10679.html","الكامل"],[88,"قصر الدبارة هل أتاك حديثنا","https://www.aldiwan.net/poem10693.html","الكامل"],[29,"ما هاج شوقك من رسوم ديار","https://www.aldiwan.net/poem5785.html","الكامل"],[53,"لا ترج يا بيهقي إفراشي","https://www.aldiwan.net/poem64925.html","المنسرح"],[87,"شكرتك في أجداثها الشهداء","https://www.aldiwan.net/poem7258.html","الكامل"],[47,"أترى الزمان يعيد لي أيامي","https://www.aldiwan.net/poem65674.html","الكامل"],[101,"القصيدة الدمشقية","https://www.aldiwan.net/poem6529.html","عموديه"],[89,"أي فتى للعظيم نندبه","https://www.aldiwan.net/poem8283.html","المنسرح"],[107,"أعجزنا أن نجوب المشرقين","https://www.aldiwan.net/poem42090.html","الرمل"],[107,"اشهدي يا مصر أعمال البنين","https://www.aldiwan.net/poem43070.html","الرمل"],[107,"يا غاديا ببريد الشام ينتحب","https://www.aldiwan.net/poem43094.html","الكامل"],[107,"الله أكبر باسم الله أهديها","https://www.aldiwan.net/poem43131.html","البسيط"],[107,"هم سادة الحرب من شيب وشبان","https://www.aldiwan.net/poem43573.html","البسيط"],[107,"هو مرتمى الأبطال مالك دونه","https://www.aldiwan.net/poem44209.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39630","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54249","السريع"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54324","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/142074","البسيط"],[92,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[96,"وفاء القبور","https://www.poetsgate.com/ViewPoem.aspx?id=13790",""],[137,"فتح مبين جل أن يتخيلا","https://www.aldiwan.net/poem4220.html","الكامل"],[463,"إن تسأليني بعد قومي","https://www.aldiwan.net/poem55856.html","مجزوء الكامل"],[556,"دع الهوى يتبعه الأخرق","https://www.aldiwan.net/poem47377.html","السريع"],[556,"ما زرت إلا خداعا أيها الساري","https://www.aldiwan.net/poem47781.html","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136195","الخفيف"],[1616,"","https://poetry.dctabudhabi.ae/diwan/poem/206234",""],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101024","الخفيف"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101009","الكامل"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66309","الرجز"],[1837,"","https://poetry.dctabudhabi.ae/diwan/poem/143886","الخفيف"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109468","الرجز"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93650","البسيط"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87761","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74317","الخفيف"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132748","السريع"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130053","الكامل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130037","البسيط"],[3291,"","https://poetry.dctabudhabi.ae/diwan/poem/106684","السريع"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216552",""],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89397","الرجز"],[3900,"","https://poetry.dctabudhabi.ae/diwan/poem/26609","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86453","الكامل"],[4702,"الوقت ياعزام بانت غوايبه","https://www.poetsgate.com/ViewPoem.aspx?id=155114",""],[4204,"طاحون بر للبرايا تشيدت","https://www.poetsgate.com/ViewPoem.aspx?id=165556",""],[4791,"النجمة","https://www.poetsgate.com/ViewPoem.aspx?id=36957",""],[4797,"تحذرو من بايعين الحباري","https://www.poetsgate.com/ViewPoem.aspx?id=178133",""],[4883,"اطلق فمي","https://www.poetsgate.com/ViewPoem.aspx?id=48372",""],[5061,"قصيدة المواد","https://www.poetsgate.com/ViewPoem.aspx?id=147164",""],[5341,"صرخة الميلاد.. صرخة للحَد","https://www.poetsgate.com/ViewPoem.aspx?id=185355",""],[5351,"نرجسية","https://www.poetsgate.com/ViewPoem.aspx?id=202600",""],[5525,"شديد الرمل","https://www.poetsgate.com/ViewPoem.aspx?id=904",""],[5526,"تبّ الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=202656",""],[5573,"فاز بالخير بادي يوم يقري سلام","https://www.poetsgate.com/ViewPoem.aspx?id=202543",""],[5652,"شفرة الموس","https://www.poetsgate.com/ViewPoem.aspx?id=208679",""],[5848,"مولاتي","https://www.poetsgate.com/ViewPoem.aspx?id=50538",""],[5848,"يا لابسين الأقنعة والقناعات","https://www.poetsgate.com/ViewPoem.aspx?id=48843",""],[5976,"طهر الضيا","https://www.poetsgate.com/ViewPoem.aspx?id=32509",""],[6100,"اليوم كني واحد(ن) ماعرفني ..","https://www.poetsgate.com/ViewPoem.aspx?id=52554",""]],"verses":[["طاحَ في حَدِّ مِخلَبيكَ وَخَسَّت","أَكلَةُ الذِئبِ أَن تُقارِبَ فاكا",0,"ك",2,0],["طاحَت بِتِلكَ المَكرُماتِ طَوائِحٌ","وَعَدَت عَلى ذاكَ الجَوادِ عَوادي",1,"د",2,0],["طاحَ بِالرَأسِ مِن رِجالاتِ مِصرٍ","وَتَخَطّى التُحوتَ وَالأَوشابا",2,"ب",2,0],["طاحَت بِها تِلكَ المَدافِعُ تارَةً","لَمّا أَمَرتَ وَتارَةً زِبلينُ",3,"ن",1,0],["طاحوا بِأَربَعَةٍ فَأَردَوا خامِساً","هُوَ خَيرُ ما يَرجو العَميدُ وَيَطلُبُ",4,"ب",1,0],["طاحَ الفَرَزدَقُ في الرِهانِ وَعَمَّهُ","غَمرُ البَديهَةِ صادِقُ المِضمارِ",5,"ر",1,0],["طاحت جُباراً وما أضرَّ به","بَثْقٌ ولا ناله بإِتكاش",6,"ش",1,0],["طاحت نفوس في سبيل حمامة","دخلت عليها أيكها الغرباء",7,"ا",2,0],["طاحوا فَما بَكَتِ العُيونُ عَلَيهِمِ","بِدُموعِها وَمَضَوا بِغَيرِ سَلامِ",8,"م",1,0],["طاحونة البن جزءٌ من طفولتن","فكيف أنسى؟ وعطر الهيل فواح",9,"ح",1,0],["طَاحَ بِجُثْمَانِهِ الرَّدَى وَرَقَا","إِلَى سَمَوَاتِ رَبِّهِ نَسَمُهْ",10,"م",2,0],["طَاحَ بالنَّسْرينِ منه قَدَرٌ","نَافِذُ النَّابيْنِ مَاضي المِخلبيْنْ",11,"ن",1,0],["طاحَ بِالخَيرِ وَعَفّى رَسمَهُ","زَمَنٌ لِلشَرِّ مُنبَتُّ القَرينْ",12,"ن",1,0],["طاحَت بِآمالِها الخُضرِ اللِدانِ يَدٌ","خُضرُ الحَدائِقِ في إِعصارِها حَطَبُ",13,"ب",1,0],["طاحَ الَّذي وَأَدَ الأَقوامَ وَاِنبَعَثَت","مِنَ القُبورِ شُعوبٌ رُوِّعَت فيها",14,"ي",3,0],["طاحَتْ بهم غَمرةٌ ما تَنجَلي وطَغَتْ","على عُقولٍ لهم مَرْضَى وأذهانِ",15,"ن",1,0],["طاحَ الجهادُ به شهيداً صادقاً","أوفى بعهدِ إلههِ يتقرَّب",16,"ب",1,0],["طاحتْ بناصيةِ الضعفى وسخَّرها","كما يشاء الأشدّاءُ الألبّاءُ",17,"ا",2,0],["طاحَتْ بِأَهْلِ الْغَرْبِ نارُ الْوَغَى","وهَبَّت الريحُ بِهِمْ زَعْزَعا",18,"ع",2,0],["طاحوا بقيدكِ في الهواء وكم لهم","مِنَنٌ على المأسورِ والمملوك",19,"ك",1,0],["طاحونةُ البنِّ جزءٌ من طفولتنا","فكيفَ أنسى وعطرُ الهيلِ فوّاحُ",20,"ح",1,0],["طاح البلاءُ بخائرٍ في مَعرَكٍ","أشِبٍ تطيشُ بهَوله الأحلام",21,"م",1,0],["طاح الزمان بإخواني وأوردهم","على الحتوف فلا عين ولا أثر",22,"ر",1,0],["طاحت به هفواته والماء لا","بد لهُ من أن يفيضَ إذا غلا",23,"ل",2,0],["طاحت بأسنمة العُلا","ونجا الذُّنابَي والعجانُ",24,"ن",1,0],["طاحوا إلى الموتِ وكم طائحٍ","لم يُغنِ عنه حَذِرٌ مُشفِقُ",25,"ق",1,0],["طاحوا وما طاح حزني بعدهمْ ونأَوْا","عنّي وما نزحوا من بين أفكاري",26,"ر",2,0],["طاح قيد الوجود فانحل اصل ال","وجد فالوجد بالمعاني يدور",27,"ر",1,0],["طاح الحِيا والجوّ هادي","عمّ الوطن واسْقى الوطن يود",28,"د",1,0],["طاحت الروسُ في شواظ المرامي","واحتواها البوار علوا وسفلا",29,"ل",2,0],["طاحت بهضبتها التي لا تُرقى","وهوت بفارسها الذي لا يُصرع",30,"ع",1,0],["طاح به هوانه وأنّه","في ورطة العذاب قد تورّطا",31,"ط",2,0],["طاحَ صبري مع الرقاد فَعُوِّضْ","تُ غراماً مع السُّهاد طويلا",32,"ل",2,0],["طاح وما طال لهُ جَناحُ","وما لهُ اثمٌ ولا جُناحُ",33,"ح",1,0],["طاحضت شَظايا قُلوب الناس وَاختطفت","أَبصارَها بِيد الأَرزاء وَالفَجع",34,"ع",1,0],["طاحَت بِهِ في مَجال العزّ طائِحَة","الملك وَالعز إِذ طاحَت بِهِ طاحا",35,"ح",2,0],["طاحَ يا أَكرَم الوَرى فَتَدارك","وافِداً عِندَ بابك الرَحب حطا",36,"ط",2,0],["طاحت شظايا قلبه دهشة","من خبر الهيجاء قبل العيان",37,"ن",1,0],["طاحت بها النيرانُ تحت عيونهم","عذراء تعلو عن الذنوب وتعصمُ",38,"م",1,0],["طاحَت بكاملنا لياليك الّتي","مِن شأنها أن تستبدّ وتقهرا",39,"ر",2,0],["طَاحَ عَلَى قَوِيِّهِم بالمَغا","وِيرِ من المنصورِ أيدِى اجتِيَاح",40,"ح",1,0],["طاحْ رِكْن الشَّعْر والفَنّا","حِزْن عَمّ الكونْ بِطْياحَه",41,"ح",2,1],["طاحت بهذا التيس أخت الذيبهْ","وعلمته في النساء الغيبهْ",42,"ه",1,0],["طاحَ خِلاجُ الأَمرِ ثُمَّ صَرَمتُهُ","وَلِلأَمرِ مِن بَعدِ الخِلاجِ صَريمُ",43,"م",1,1],["طاحت حشاي ولم تكن لولا الألى","قد طوح الحادي بهم لتطيحا",44,"ح",2,0],["طاحت تباكى والصحاري تصدّعت","تنثر مع العشب الورود فهبايبه",45,"ب",2,0],["طاحون بر للبرايا تشيدت","بهمة شهم للمعالي مشيد",46,"د",1,1],["طاحت النجمة على صدر الشفق","وانتهى قبل العشا حلم النهار",47,"ر",1,1],["طاح الحيا في قافرات الصحاري","وخلا الصحاري الجرد عشب ونوواير",48,"ر",1,0],["طاح قلبك فوق طاولْة الهدايا؟","طيّب : يديني .. وصوتي ونسمي؟!",49,"م",2,0],["طاحة التفاحه وسوا سوايا","ليته يطيح بيدين الدارسينا",50,"ن",2,0],["طاحت سْنين العمرْ/ جفّت سماي","والحصاد مْن الأماني للّحَد",51,"د",1,0],["طاح منك نجم وانهارت صوامعْ","من أحاسيسك وصارت جاهلية",52,"ي",2,0],["طاح الرواق وطاح حلم الحبايب","لا ناي في روحي غدت روحي حطام",53,"م",1,0],["طاحت لها في أول الخد لمعه","وتساقطت معها له احلام وآمال",54,"ل",1,0],["طاح مارد جنبه غير حضن الرخام","وين ياحيل صابر طاح راحة ذليل",55,"ل",1,0],["طاحت رؤوسٍ شامخه ترقب جلوس","وشاخت هلايم بايعين الصلاااحي",56,"ح",2,0],["طاحت من القلب دمعة وابتدى نزفي","يا جرحي اللي نهش كل ابتساماتي",57,"ت",2,1],["طاحوا .. قبل لا يرتفع ذنب ويضيع","طُهر السوالف بابتعاد المسافات",58,"ت",1,0],["طاحت عناقيد العنب .. واغلى الجواهر والدرر","من عين تعشقني بْألم .. وتْضمّ طيفي في حيا .. !!",59,"ي",2,1],["طاحت من عيوني اساطير ورجال","ذابت من اهدابي على شط جفني",60,"ن",2,0]]}