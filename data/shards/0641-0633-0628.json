.aspx?id=128722",""],[5340,"ويوم ترى كانونا الأول مقبلا","https://www.poetsgate.com/ViewPoem.aspx?id=186106",""],[5397,"لمن الرواسم بين تلك الأرسم","https://www.poetsgate.com/ViewPoem.aspx?id=157956",""],[5411,"( وتَأبَى شُموسُكَ )","https://www.poetsgate.com/ViewPoem.aspx?id=186720",""],[5431,"عشق....","https://www.poetsgate.com/ViewPoem.aspx?id=183092",""],[5431,"عن القصيدة أتكلم","https://www.poetsgate.com/ViewPoem.aspx?id=186849",""],[5431,"سلامي إلى صنعا تعزّ وربعها","https://www.poetsgate.com/ViewPoem.aspx?id=188446",""],[5431,"أمير..","https://www.poetsgate.com/ViewPoem.aspx?id=190434",""],[5431,"وسبحان من سواه اعجوبتي الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=197300",""],[5431,"في حب الله ...","https://www.poetsgate.com/ViewPoem.aspx?id=202478",""],[5533,"أُحِبُّ حَدِيثَها","https://www.poetsgate.com/ViewPoem.aspx?id=179990",""],[5605,"بلادي ..ملحمتي","https://www.poetsgate.com/ViewPoem.aspx?id=159576",""],[5616,"سهل ممتنع","https://www.poetsgate.com/ViewPoem.aspx?id=203334",""],[5701,"رفيع القدر حيانا","https://www.poetsgate.com/ViewPoem.aspx?id=164703",""],[5725,"وماعجبي بوجهك من صفاء","https://www.poetsgate.com/ViewPoem.aspx?id=185402",""],[5752,"في محراب الرسول","https://www.poetsgate.com/ViewPoem.aspx?id=1331",""],[5782,"جموح / د. عمر هزاع","https://www.poetsgate.com/ViewPoem.aspx?id=183618",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5818,"البنات كالنبات","https://www.poetsgate.com/ViewPoem.aspx?id=181760",""],[5845,"عسى منْ خفي اللطفِ سبحانهُ لطفُ","https://www.poetsgate.com/ViewPoem.aspx?id=15452",""],[5910,"حيِّ الطلولَ ونبِّ عن أخبارِها","https://www.poetsgate.com/ViewPoem.aspx?id=206239",""],[5910,"فسبِّحْ بحمدِ اللهِ","https://www.poetsgate.com/ViewPoem.aspx?id=206240",""],[5913,"تغنى الكون","https://www.poetsgate.com/ViewPoem.aspx?id=177072",""],[5956,"شغلت وجودي","https://www.poetsgate.com/ViewPoem.aspx?id=181883",""],[5956,"أصالة النقاء ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182271",""],[5956,"زرافات عنز تُرَجّي حناني","https://www.poetsgate.com/ViewPoem.aspx?id=183501",""],[5956,"شكرتُ عواطفَ الناي الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=207913",""],[161,"أخيرا أثلجت","https://www.poetsgate.com/ViewPoem.aspx?id=176767",""],[5309,"ضل رهط الأثرياء","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573890",""],[6202,"أبا الزهراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86699&r=&rc=0",""],[6202,"وقفة رجاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86759&r=&rc=60",""],[2220,"حمدتُ إلهي والمقامُ عظيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11732&r=&rc=602",""],[5190,"المفترق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78333&r=&rc=46",""],[5190,"إحساس شاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85055&r=&rc=130",""]],"verses":[["فَسَبَقتُمُ وَكَبا بِهِ مِن جَدِّهِ","دونَ المُنى قَصفُ الفَقارِ مُوَقَّعُ",0,"ع",1,0],["فَسَبَّحتُ تَعظيماً لَها وَجَلالَةً","وَقَد سَفَرَت عَن مُشبِهِ الشَمسِ وَالقَمَر",1,"ر",1,0],["فسَبَكْتُ التِّبرَ لَها لُجُماً","وجعَلْتُ أعنّتَها سَرَقا",2,"ق",2,0],["فَسَبيلُهُ أَن يَستَبِد","دَ وَشَأنُنا أَن نَستَعِدّا",3,"د",2,0],["فَسُبْحَانَ مَنْ آتَاهُ حُسْناً كَأَنَّهُ","بِهِ أُوتِيَ التَّنْزِيهَ عَنْ كُلِّ مُشْبِهِ",4,"ب",2,0],["فسبحان المؤلِّف عن شتاتٍ","ومن أدنى البعيدَ مِنَ القريبِ",5,"ب",1,0],["فَسَبَّحَ مَن لَم يَزجُرِ الطَيرَ مِنهُمُ","وَأَيقَنَ قَلبي أَنَّهُنَّ نَواجِحُ",6,"ح",1,0],["فَسَبيلُ الغرامِ جَمُّ المهاوي","وافرُ الهولِ مُسْتَرابُ الصَّعيدِ",7,"د",1,0],["فسبوها وضاجعوها بلا عقد","عليها منهم ولا إشهاد",8,"د",1,0],["فسبحان المفرِّق حظ قومٍ","قناطيرا وأقوامٍ أواقي",9,"ق",2,0],["فَسَبَقَ الكَلبُ لِتِلكَ الشَجَرَه","لِيُنذِرَ الطَيرَ كَما قَد أَنذَرَه",10,"ه",1,0],["فَسُبحانَ مَن يَرمي الحَديدَ وَبَأسَهُ","عَلى ناعِمٍ غَضٍّ مِنَ الزَهرِ مِنهالِ",11,"ل",1,0],["فَسَبيلُنا في المَوتِ مُشتَرَكٌ","يَتلو أَصاغِرَهُ أَكابِرُهُ",12,"ر",2,0],["فَسَبَتني بِ