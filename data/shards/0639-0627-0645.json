دْ قَضَى بِتَمَامِ","https://www.poetsgate.com/ViewPoem.aspx?id=176226",""],[6093,"همٌّ يُبايتني وغمٌّ يسهدُ ( الكامل )","https://www.poetsgate.com/ViewPoem.aspx?id=176381",""],[6093,"عاملْ أخاك كما يَجِبْ","https://www.poetsgate.com/ViewPoem.aspx?id=185453",""],[6097,"أيّار","https://www.poetsgate.com/ViewPoem.aspx?id=186068",""],[6102,"ريما","https://www.poetsgate.com/ViewPoem.aspx?id=184167",""],[6102,"يا أنا","https://www.poetsgate.com/ViewPoem.aspx?id=185331",""],[6106,"سيدنا الإمام الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=6315",""],[6117,"شَهْرُ رَمَضَانْ الْمُبَارَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=182798",""],[6125,"عَامَانِ مُذْ أشعَلتِ فيَّ صَبَابةً","https://www.poetsgate.com/ViewPoem.aspx?id=210569",""],[6127,"لَمُّ الجراحِ","https://www.poetsgate.com/ViewPoem.aspx?id=202685",""],[6134,"عاملت باللطف الزنيم فجاءني","https://www.poetsgate.com/ViewPoem.aspx?id=169588",""],[6142,"مذ صلصل الله من طين خليقته","https://www.poetsgate.com/ViewPoem.aspx?id=155709",""],[6152,"كل عيش لغير الله أوهام","https://www.poetsgate.com/ViewPoem.aspx?id=203051",""],[520,"قل للمشارف عني","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577570",""],[6180,"عشرون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81083&r=&rc=17",""],[5355,"احتياج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86681&r=&rc=4",""],[6218,"عبير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65866&r=&rc=20",""],[6222,"عام مضى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1932&r=&rc=3",""],[6302,"بَغدادْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86227&r=&rc=25",""],[5190,"إطلالة على العام الجديد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78300&r=&rc=13",""],[6355,"عام رحل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66623&r=&rc=83",""],[6355,"داء لا مناص منه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66626&r=&rc=86",""]],"verses":[["عامي وَعامُ المَحلِ في بَلَدٍ","فَاِسحَب إِلَيَّ ذُؤابَةَ الوَبلِ",0,"ل",1,0],["عامِلْ بِما عوّدْتَ منْ لُطْفٍ ومِنْ","رُحْمَى ولا تَنْظُر لسوءِ صَنيعِ",1,"ع",1,0],["عَامَلْتَ وَجْهَ اللهِ فِيمَا رُمْتَهُ","مِنْهَا فَلَمْ يَبْعُدْ عَلَيْكَ مَرَامُ",2,"م",1,0],["عامِداً لِلقَنانِ يَنضو رِياضاً","وَطِراداً مِنَ الذِنابِ وَدورا",3,"ر",2,0],["عامَ شَهرَينِ وَلَم يَفتَح سِوى","هُوَّةٍ فيها المَلايينُ تَرامى",4,"م",2,0],["عَامَانِ مَرَّا فِي الغِيَابِ وَعِنْدَ مَنْ","يَشْتَاقُ أَقْصَرُ سَاعَةٍ أَعْوَامُ",5,"م",1,0],["عام بذوب الماس أوقد غدا","يسبح في لجة ذوب اللجين",6,"ن",1,0],["عام حلفنا بمسطور الثلاث به","بأنه عامُ إقبال وأفراح",7,"ح",1,0],["عاملت حبّ عليٍّ والولاء بها","فهي الدَّواوين فيها والمساطير",8,"ر",1,0],["عامٌ يقول على رأسي سعت قدمي","لرأس عامٍ بهذا العام محتفل",9,"ل",1,0],["عامريًّا من التغزُّل فيه","ومن المدحِ بعده قرشيّا",10,"ي",2,0],["عامريّ اللحظ طائيّ الفمِ","بارزٌ في حسنه كالصنمِ",11,"م",1,0],["عام ولم ينتج نداك وإنما","تتوقع الحبلى لتسعة أشهر",12,"ر",1,0],["عامٌ نَسيتُ سُعودَهُ بِنُحوسِهِ","قَد يَحجِبُ اللَيلُ الهِلالَ المُشرِقا",13,"ق",2,0],["عامِلِ الكُلَّ بِإِحسانٍ تُحَب","فَقَديماً جَمَّلَ المَرءَ الأَدَب",14,"ب",1,0],["عامِلِيِّ النّتاجِ تُطْوى لهُ الأر","ضُ إذا ما اسْتُعِدَّ للأَنْقالِ",15,"ل",1,0],["عامِداتٍ لِلبَدرِ وَالبَحرِ وَالضِر","غامَةِ اِبنِ المُبارَكِ المِفضالِ",16,"ل",1,0],["عامٌ أَتى قَبلَهُ عامانِ ما تَرَكا","مالاً وَلا بَلَّ عوداً فيهِما مَطَرُ",17,"ر",1,0],["عامِلِ الناسَ بِرَأيٍ رَفيقِ","وَالقِ مَن تَلقى بِوَجهٍ طَليقِ",18,"ق",1,1],["عامٌ مضى يا للزمان وطيّه","فينا ويا لسواخر الأقدارِ",19,"ر",1,0],["عامٌ مضى وكأنّ أمس نعيُّه","يا ما أقلَّ العامَ في الأعمارِ",19,"ر",1,0],["عامٌ أتاك مُبشّراً برياسةٍ","أبديّةِ الإجلال والإعظامِ",20,"م",1,0],["عامٌ وَشَهرٌ مُقبِلانِ كِلاهُما","ما اِستَجمَعا إِلّا لِحَظٍّ مُقبِلِ",21,"ل",1,0],["عامي وَعامُ العيسِ بَينَ وَديقَةٍ","مَسجورَةٍ وَتَنوفَةٍ صَيخودِ",22,"د",1,0],["عَاملٍ قَامَ بِشَطْرِ","في الرّجالِ العامِلينْ",23,"ن",1,0],["عامٌ أَهابَ به الزّمانُ فأقبلا","يُزجِي المواكبَ بالأهِلَّةِ حُفّلا",24,"ل",2,1],["عامانِ ما عَطَفَ المَمالِكَ فيهِما","حُبٌّ وَلا جَمَعَ الشُعوبَ وِدادُ",25,"د",1,0],["عامَت سُلَيمى وَمَسَّها سَغَبُ","بَل مالَها لا تَزالُ تكتَئِبُ",26,"ب",1,1],["عامَ في الغَمرِ زَماناً فَنَجا","وَاِنثَنى الآنَ غَريقاً في الغُمَر",27,"ر",1,0],["عامل الناس بالعَدالة وَالظل","مِ فَكانوا يَلقون نوراً وَنارا",28,"ر",2,0],["عامل الظالمين بالظلم تسلم","ربّ شرٍّ يكون فيه نجاة",29,"ه",1,0],["عَامِلٌ لاَ يَنِي يَرُودُ المَظِنِّا","تِ إِلى أَنْ يُجْلَى لَدَيْهِ الطَّرِيقُ",30,"ق",1,0],["عَامَانِ مَرَّا بِي وَتَاللّهِ مَا","عِشْتهُمَا مَعْنىً ولاَ حِسا",31,"س",2,0],["عَامَا نِزَاعٍ لَمْ تُهَادِنُ فِيهِمَا","نُذُرُ الرَّدَى وَشَوَاغِلُ البُرَحَاءِ",32,"ا",2,0],["عَامُكَ الثَّالِثُ وافى يَا أَميرِي","لَمْ تَمُتْ بَلْ أَنتَ حَي في ضَمِيرِي",33,"ر",2,1],["عَامٌ تَقَضَّى مُذْ نَأَيْتَ وَلَمْ يَزَلْ","بِعُيونِ مِصْرَ سَنَى الشِّهَابِ الكَابي",34,"ب",2,0],["عَامٌ بِهِ كَرُّ الزَّمَانِ وَفَرُّهُ","جَازَ الحِسَابَ وَلَمْ يَكُنْ بِحِسَابِ",34,"ب",1,0],["عامٌ، وآخر: مقبلٌ، ومودعٌ","شيعتُ نعشًا، واحتفلتُ بمولد",35,"د",1,0],["عاملتها بمراد الله منحرفا","الى نصيبك من عقباك بالعمل",36,"ل",1,0],["عام نَأى عَنكَ فيهِ مُكرَهاً فَعلي","أَسحارُهُ أَبَداً تَبكي أَصائلهُ",37,"ل",2,0],["عامل الله بصدق وقضى","نحبه بالامن من كل الفتن",38,"ن",1,0],["عام سبعِ والألفُ مع مائةٍ","تمتْ حساباً والخير في عُقْبَاهَا",39,"ا",3,0],["عامٌ حُلولُكَ فيهِمُ بِحُلولِهِ","عامٌ يُبَجَّلُ عِندَهُم وَيُعَظَّمُ",40,"م",1,0],["عامل بحزم الرأي أكثر من ترى","فأبو فلان في الخداع فلان",41,"ن",1,0],["عامل المولى بنعمته","من أيادي فعله الحسنِ",42,"ن",1,0],["عاملتَ ربك وانتدبتَ خصالا","يرضى بها سبحانه وتعالى",43,"ل",2,1],["عاملْ به الخلق يرضى عنك خالقُهم","رضاً يوالي عَليك الخير متصلا",44,"ل",2,0],["عَاماً فَعاماًُ ثُمَّ آخَرَ ثالثاً","فَبَلَوتُ ذلكَ مثلَ قِيلِ الباطلِ",45,"ل",1,0],["عامرةً بالشكر مأنوسةً","بالحمد لا تَفْنَى ولا تَخْرب",46,"ب",1,0],["عامٌ يَعُمُّ ببُشراهُ التي نطقتْ","بطولِ عمرك فيه سائرُ الأمم",47,"م",1,0],["عاملوني بالمجد والجود ظرفا","ثمّ عادوا عليّ بالتعظيم",48,"م",1,0],["عاملِ الإنسان قبل ال","حجّ وافعل ما تريد",49,"د",1,1],["عامله بالشر وانظر كيف موقعه","فالشر يصلحه والخير يفسده",50,"د",2,0],["عامرٌ طلحة الزبير وسعدٌ","واِبنُ عوفٍ مع صاحب الغارِ جاؤوا",51,"ا",1,0],["عامِيَةً جَرَّتِ الريحُ الذُيولَ بِها","فَقَد تَخَذَّمَها الهِجرانُ وَالقَدَمُ",52,"م",1,0],["عامٌ يعمُّ لك السرور ولا ترى","في نعمةٍ خللاً ولا إخلالا",53,"ل",2,0],["عام بها الدر وما ابصرت","عيناي يوما مثلها منذ عام",54,"م",1,0],["عامَلتَ خَبّازي بِهِ بَعدَ ما","عامَلَني أَمسِ بِما يُجزي",55,"ز",2,0],["عامَ تَرى الكاعِبَ المُنَعَّمَةَ ال","حَسناءَ في دارِ أَهلِها سَبُعا",56,"ع",2,0],["عَامَ الجَماعَة ما اعتاصَت وَلا نَغِلَتْ","فيما يُقرّرُ حِسْبَانٌ وتَعْدادُ",57,"د",1,0],["عام جديد عاد فالبشرى به","والعود أحمد ما بدا فرح جديد",58,"د",1,1],["عاملهُمُ بالصِدقِ","واِصحب بحسنِ الخُلقِ",59,"ق",1,0],["عاملتني بالجميل مبتدئاً","جعلتني أثراً وما أثر",60,"ر",1,0],["عامُ سبعٍ صفوٌ لسعدِ الوزيرِ","فَالهَنا أوّلاً بهِ للأميرِ",61,"ر",1,1],["عامٌ سَعيد قَد أَتاكَ مُجَدَّداً","حُسنُ الوَلاءِ وَبِالصَفا يَتَعَهَّدُكَ",62,"ك",1,1],["عامل يصنع الحياة ويرجوها فتاتا","يجفوه كلب الثرى",63,"ر",2,0],["عام جَديد فيهِ يَلقى الهَنا","وَالفَوز وَالتَوفيق وَالمَيسَره",64,"ر",2,0],["عامٌ تَقضّى وعامٌ بعدُ تابعُه","لقد تَكلّفْتُ من تأميلِكمْ شَطَطا",65,"ط",2,0],["عامَ تَرى الطَّيْرَ دَواخِلَ في","بُيوتِ قومٍ معَهُمْ تَرْنَمّ",66,"م",1,0],["عامِداتٍ لِخَلِّ سَمْسَمَ ما يَنْ","ظُرْنَ صَوْتاً لِحاجةِ المَحْزُونِ",67,"ن",1,0],["عامٌ على خيرِ العِبادِ تراكمَتْ","فيه المصائبُ ‘ والعَدوُّ لَدُودُ",68,"د",1,0],["عام بك للعيد وجهك عيده","فليفتخر فيها على الأَعوام",69,"م",1,0],["عامَلوا باللّطف منهم أمَّةً","لم تجد من طاعة السلطان بدَّا",70,"د",2,0],["عامٌ كعُمْرِ الوَصْلِ ليلَةَ زائِرٍ","وأسىً تَقاصَرُ دُونَهُ الأَعمارُ",71,"ر",1,0],["عامت بنا الآمال في لجة","تعجز عنها حيلة العائم",72,"م",1,0],["عامِرٌ مَن كَعامِرٍ يَرقَعُ الثّا","مَ وَيَكفيكَ حَضرَةَ السُلطانِ",73,"ن",1,0],["عامراً عافِيَها أو مالئا","بجماعات الندى مسكونَها",74,"ن",3,0],["عاما ً على عام ٍ، وأنتَ مَجَرَّة ٌ","تَنمو ، وآلافُ الكَواكِبِ تَلمَعُ",75,"ع",1,0],["عامِلُ دِمياطَ فَتىً قَلَّما","يَحصُلُ مِن وَفدٍ عَلى شاكِرِ",76,"ر",1,1],["عامِلُ 