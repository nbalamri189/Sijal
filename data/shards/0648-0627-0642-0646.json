{"poems":[[55,"أأبقى كذا أبدا مستقلا","https://www.aldiwan.net/poem29898.html","المتقارب"],[55,"خصيم من الأيام لي وشفيع","https://www.aldiwan.net/poem30151.html","الطويل"],[79,"أبدى لداعي الفوز وجه منيب","https://www.aldiwan.net/poem36767.html","الكامل"],[90,"بني الأرض هل من سامع فأبثه","https://www.aldiwan.net/poem45068.html","الطويل"],[74,"فطمت ولائي ثم أقبلت عاتبا","https://www.aldiwan.net/poem19477.html","الطويل"],[53,"أغر مخيلات الأماني لموعها","https://www.aldiwan.net/poem65406.html","الطويل"],[72,"إن كنت تقبل مني","https://www.aldiwan.net/poem42393.html","المجتث"],[64,"أقول وقد غال الردى من أحبه","https://www.aldiwan.net/poem52429.html","الطويل"],[60,"قدم لنفسك في الحياة تزودا","https://www.aldiwan.net/poem30966.html","الكامل"],[68,"رضيت ببعدي عن جنابك عندما","https://www.aldiwan.net/poem38768.html","الطويل"],[46,"لم أر عيرا جمة الدؤوب","https://www.aldiwan.net/poem29700.html","الرجز"],[71,"ما للزمان عن المروءة عار","https://www.aldiwan.net/poem28776.html","الكامل"],[53,"أغرُّ مُخيلاتِ الأماني لَمُوعها","https://www.poetsgate.com/ViewPoem.aspx?id=29518",""],[123,"سأستجدي صغيراً من كبير","https://www.aldiwan.net/poem4351.html","الوافر"],[132,"خليلي إن الهم والحزن خيما","https://www.aldiwan.net/poem50509.html","الطويل"],[132,"إما فررت من العدى","https://www.aldiwan.net/poem50633.html","الطويل"],[154,"إن الكبائر للطاعات مفسدة","https://www.aldiwan.net/poem68517.html","البسيط"],[190,"ته على الناس جميعا","https://www.aldiwan.net/poem43603.html","مجزوء الرمل"],[190,"أقلل من الخلطة للناس","https://www.aldiwan.net/poem43727.html","السريع"],[203,"حمل فؤادك ما يطيق ولا تكن","https://www.aldiwan.net/poem45664.html","الكامل"],[215,"أجبني إن تفضلت","https://www.aldiwan.net/poem46344.html","مجزوء الوافر"],[276,"أفق هديت من التبريح والكمد","https://www.aldiwan.net/poem52105.html","البسيط"],[308,"لا تسأل الناس فإني امرؤ","https://www.aldiwan.net/poem58281.html","السريع"],[309,"يا سائلي عن عبرتي ومدامي","https://www.aldiwan.net/poem16845.html","الخفيف"],[371,"وقفنا على قصر العزيز وقد عفا","https://www.aldiwan.net/poem17353.html","الطويل"],[396,"ماذا يقول الناس في طريق","https://www.aldiwan.net/poem54348.html","عموديه"],[409,"وافت على وفق احتياجي","https://www.aldiwan.net/poem34096.html","مجزوء الكامل"],[411,"ألا ليت شعري كيف أصبح طائري","https://www.aldiwan.net/poem49923.html","الطويل"],[415,"أسائقها للبين وهو عجول","https://www.aldiwan.net/poem31846.html","الطويل"],[463,"أتعلمين يا ابنة الأعاجم","https://www.aldiwan.net/poem55879.html","الرجز"],[463,"أمرتجع لي فارط العيش بالحمى","https://www.aldiwan.net/poem56129.html","الطويل"],[463,"أصبت لو أحمدت أن أصيبا","https://www.aldiwan.net/poem56297.html","الرجز"],[466,"عليك ذمام الله ما ذر شارق","https://www.aldiwan.net/poem15694.html","الطويل"],[500,"غضي جفونك يا رياض","https://www.aldiwan.net/poem9883.html","مجزوء الكامل"],[556,"رضينا من عدانك بالمطال","https://www.aldiwan.net/poem47296.html","الوافر"],[556,"تطالبني نفسي بما غيره الرضا","https://www.aldiwan.net/poem48086.html","الطويل"],[563,"ونحن أهل الصفا لا نقبل الكدرا","https://www.aldiwan.net/poem34494.html","البسيط"],[567,"دع يوم أمس وخذ في شأن يوم غد","https://www.aldiwan.net/poem52862.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122747","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48872","الطويل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122308","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/71023","البسيط"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16986","الطويل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61077","الطويل"],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/69195","المنسرح"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55935","الرجز"],[1302,"","https://poetry.dctabudhabi.ae/diwan/poem/131395","السريع"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137866",""],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122064","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79871","الرمل"],[1661,"","https://poetry.dctabudhabi.ae/diwan/poem/67814","الكامل"],[1890,"","https://poetry.dctabudhabi.ae/diwan/poem/89656","الكامل"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76661","المتقارب"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69338","الهزج"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76794","الكامل"],[2029,"","https://poetry.dctabudhabi.ae/diwan/poem/123708","البسيط"],[2244,"","https://poetry.dctabudhabi.ae/diwan/poem/202676","الكامل"],[2275,"","https://poetry.dctabudhabi.ae/diwan/poem/28057","الطويل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28539","الكامل"],[2394,"","https://poetry.dctabudhabi.ae/diwan/poem/146277","السريع"],[2500,"","https://poetry.dctabudhabi.ae/diwan/poem/116837","الطويل"],[563,"","https://poetry.dctabudhabi.ae/diwan/poem/68318","الرجز"],[2957,"","https://poetry.dctabudhabi.ae/diwan/poem/198418","المجتث"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134014","الكامل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133945","الكامل"],[3322,"","https://poetry.dctabudhabi.ae/diwan/poem/142925","البسيط"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67973","الكامل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86312","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110025","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91989","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91961","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91121","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91162","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91923","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91976","البسيط"],[3774,"","https://poetry.dctabudhabi.ae/diwan/poem/21506","الكامل"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93280","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90872","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45103","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94532","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133071","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58039","الوافر"],[4778,"يا لاهيا قد غرَّه","https://www.poetsgate.com/ViewPoem.aspx?id=193617",""],[4916,"لبيه ياهادم اللّذات","https://www.poetsgate.com/ViewPoem.aspx?id=135386",""],[4927,"عيد الميلاد","https://www.poetsgate.com/ViewPoem.aspx?id=32634",""],[4939,"أجعل صديقَكَ نفسَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=135264",""],[5206,"حب غير الله","https://www.poetsgate.com/ViewPoem.aspx?id=187395",""],[5237,"إن شئت عيشا هنيا واتباع هدى","https://www.poetsgate.com/ViewPoem.aspx?id=113119",""],[5376,"دُسْ عليها واهْرسِ الجسْمَ النحيلا","https://www.poetsgate.com/ViewPoem.aspx?id=188451",""],[5464,"طرقنا بابكم فأجاب صمت","https://www.poetsgate.com/ViewPoem.aspx?id=6677",""],[5497,"القناعة","https://www.poetsgate.com/ViewPoem.aspx?id=210618",""],[5671,"أضيق صدر الدهر والحزم واسع","https://www.poetsgate.com/ViewPoem.aspx?id=169351",""],[5718,"تراويح","https://www.poetsgate.com/ViewPoem.aspx?id=213833",""],[5759,"عودة الرَشاد","https://www.poetsgate.com/ViewPoem.aspx?id=213721",""],[5818,"بثامن آيةٍ في العادياتِ","https://www.poetsgate.com/ViewPoem.aspx?id=199689",""],[6093,"دَعِ التماسَ الهوى مِنْ ظبية الآس (البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176196",""],[6152,"ذكرى لمن كان قلب","https://www.poetsgate.com/ViewPoem.aspx?id=203303",""]],"verses":[["وَأَقنَعُ بِالدونِ فِعلَ الذَلي","لِ يَخشى الأَجَلَّ وَيَرضى الأَقَلّا",0,"ل",2,0],["وَأَقنَعَنا بِالبيدِ أَن لَيسَ مَنزِلٌ","وَما بَينَ أَيدي اليَعمُلاتِ وَسيعُ",1,"ع",1,0],["وَاقْنَعْ بِحَظٍّ لَمْ تَنلْهُ بِحِيلةٍ","مَا كُلُّ رَامٍ سَهْمُهُ بِمُصِيبِ",2,"ب",1,0],["وأقنع بالقوت الزهيد لطيبه","حذارَ وقوعي في خبيث المطاعم",3,"م",1,0],["وأقنعني منه المدجاة أعرضت","بشقٍّ وشقٍّ عندنا لم يجوّل",4,"ل",1,0],["وأقنعهم من مجدهم ما كفاهمُ","وأعلى نفوس الراغبين قنوعها",5,"ع",3,0],["وَاِقنَع بِكِسرَةِ خُبزٍ","وَهِمَّةٍ كِسرَوِيَّه",6,"ي",2,0],["وأقنعُ بالموعودِ وهو كما تَرى","وأصبرُ للمقدورِ وهو كما تَدرِي",7,"ر",2,0],["وَاقنَع بِقوتِكَ فَالقِناعُ هُوَ الغِنى","وَالفَقرُ مَقرونٌ بِمنَ لا يَقنَعُ",8,"ع",1,0],["وَأَقنَعتُ نَفسي أَن أَراكَ عَلى النَوى","بِقَلبي وَبَعضُ الشَرِّ أَهوَنُ مِن بَعضِ",9,"ض",1,0],["وَأَقنَعَت مِن بَلَدٍ رَغيبِ","يَحفَظُ عَهدَ الغَيثِ بِالمَغيبِ",10,"ب",1,0],["واقنعْ فما كنزُ القناعةِ نافداً","وكفى بها عزّاً لغير ممارِ",11,"ر",1,0],["وأقنعهم من مدهم ما كفاهمُ","وأعلى نفوسِ الراغبين قَنُوعُها",12,"ع",3,0],["وأقنعُ بالقليل النزرِ ممّن","يجودُ وليس يقنَعُ بالكثيرِ",13,"ر",1,0],["وأقنعُ من دهري بأيسرِ بُلْغة","إذا لم أجدْ يوماً سِوى التمر مَطْعَمَا",14,"م",2,0],["واقنعْ بما تُؤْتَى ولا","تُطْلِق لسانَك للجَدَى",15,"د",2,0],["واقنع برزقك فالأرزاق قد قُسِمَت","سيَّان في الرزق بطَّالٌ ومقتصد",16,"د",1,0],["واقنتع بالقوت والث","وب ودع خوض الحتوف",17,"ف",1,0],["واقنع إذا لم يك حظّ بما","بل اللهى من أسفل الكاس",18,"س",1,0],["واقنع برزقكَ ما كفاكَ فإنما","زاد المسافرِ هذهِ الأرزاقُ",19,"ق",1,0],["واقنع بالردى ورداً","وغيري سائغ الورد",20,"د",1,0],["واقنع بمن لم يزل سبحانه عوضا","عَن كل ما فات من أَهل وَمن وَلَد",21,"د",1,0],["واقنع ولا ت جمع حطاماً فكم","في الدهر للدينار من صرف",22,"ف",1,0],["واقنع بميسور المعاش ولا تطل","أملاً وعما لا يحل تورع",23,"ع",1,0],["وَأَقنَعُ بِالآمالِ مِنكَ كَواذِباً","فَلا أَخلَفَ اللَهُ المُرَجّي المُرَجِّما",24,"م",2,0],["واقنع من الدنيا بما تيسر","ودع لمازاد وما تعسر",25,"ر",1,0],["واقنع بما قال الإِما","م أبو العلى من لا يداجي",26,"ج",2,0],["وأقني سُلُواًّ ثمَّ أعلمُ أنَّني","وإن صِرتُ مَهجورا لقد صِرتُ مأجورا",27,"ر",2,0],["وأَقْنَعُ منها بالخَيالِ إذا سَرى","ويُعْجِبُني منها بُزخْرُفِها الكَرى",28,"ر",2,0],["واقنع فقد فتُّك غيرَ خاملٍ","بالصَّغْرِ أن تقرَع سنَّ نادمِ",29,"م",1,0],["وأقنعني تجريب دهري وأهله","بكم فحسمتم بذْلَتي وقنوعي",30,"ع",2,0],["وأَقنعَ الميسورُ فاحبسْ شُرَّداً","تَسألُ عنها الشمأَلُ الجَنوبا",31,"ب",2,0],["وأقْنيهِ غُراً من فَصيح مَحامدٍ","حَقيقٌ على مثل الوزير اغْتناُها",32,"ه",2,0],["واقني حياءَك يا ريا","ح فقد كددت الغصن هزا",33,"ز",2,0],["وأَقنعنا هواك وقد ظمئنا","إلى وِرْدِ الزّلالِ بكلِّ آلِ",34,"ل",1,0],["وَأَقنعُ مِن خِلّي بِظاهرِ وُدّه","وَلَيسَ بِحْليٍ ما تضمّ ترائبُهْ",35,"ب",2,0],["واقنع به حيثما وليت معترفاً","بفضله فاز من للفضل قد شكرا",36,"ر",2,0],["واقنَعْ بما قَسَمَ اللهُ الكريمُ ولا","تَبسُطْ يَديَكَ لنَيلِ الرِّزقِ من أحَدِ",37,"د",1,0],["وَأقنَعُ في الوَعدِ الَّذي تَعلَمينَهُ","بِمَطلٍ وَطَيفٍ مَن خَايلٍ يُسلِّمُ",38,"م",1,0],["وأقنع منهم بالسلامة وحدها","وغيري عليهم ثائر متمرد",39,"د",1,0],["واقنع بظلك أو بظل ال","دوح عن ظل العباد",40,"د",1,0],["واقْنِ الحياءَ وكنْ بالله مُعتصما","فالسالم الغانمُ الناجى من اعتصما",41,"م",2,0],["وَأَقنَعُ لا أَنَّ القَناعَةَ لي غِنىً","وَلَكِنَّ صَونَ العِرضِ بِالحُرِّ أَجمَلُ",42,"ل",1,0],["وَأَقنعُ مِن وَصل الخَيالِ بزَورة","إِلا إِنَّما وَصل البَخيلة زور",43,"ر",1,0],["وَأَقنعَتها الدُنيا التي جمعت","لَها وَرُعبُ النُفوس ضائِرها",44,"ر",3,0],["واقن بهاراً ذا عطورٍ نافحَهْ","والزعفران المبتغى ذو الرايحهْ",45,"ه",1,0],["واقن انايين من الفخارِ","واجعلهما من خلف باب الدار",45,"ر",1,0],["وأقنع بهذا القول من شاعر","يرضى من الخصر بأدنى العنق",46,"ق",1,0],["وأقنعتنا ان اسمه لا تمسه","فليتك لم تطمع بنا بمسماه",47,"ا",2,0],["وَاقْنِصَا مَا رَمَى بِأَسْهُمِ لَحْظٍ","وَصِدَاما فِي الحَرْبِ أَبْدَى صِدَامَا",48,"م",2,0],["واقنصا بين الخزامى عفرَها","فاتَ فيما قد مضى أن تطربا",49,"ب",2,0],["واقنع بما قسم الإله فأمره","ما لا يزال على الفتى إِتيانه",50,"ن",2,0],["وَاِقنَع فَفي بَعضِ القَناعَةِ راحَة","وَاليَأسُ مِمّا فاتَ فَهو المَطلَبُ",51,"ب",1,0],["وأقنع منك بدون الحرا","م فتقسم جهدك أن لا حلالا",52,"ل",2,0],["وَأَقنِيكَ ثَناً يَبقى","عَلى غابِرَةِ الدَهرِ",53,"ر",1,0],["وَاِقنَع بِرَعيِ العُنظُوانِ تَعَلُّلا","وَاِعلُ الظِّرابَ وَفُرَّ مِمن يَلؤُمُ",54,"م",1,0],["واقنع تكن عابداً واذكر فإنّ به","ثقل الموازين يوم الحشر للأمم",55,"م",1,0],["واقنع بعلم الوحي علماً ثم لا","يذهب بك التشقيق والتوفيق",56,"ق",1,0],["وَأَقنَى كَحَدِّ السَيفِ يَشرَبُ قَبلَها","وَأَشنَبَ رِفّاقِ الثَنايا لَهُ ظَلمُ",57,"م",1,0],["واقنَع فَفي عَيشِ القَناعَةِ نِعمَةٌ","لا تَتَّقي كَفَّ الزَّمانِ الخالِسِ",58,"س",1,0],["واقنع إذا ما لم تجد مطمعاً","واطمع إذا نفّست من عسرتك",59,"ك",1,0],["وأقنَعُ من ليلى بأصقابِ دارِها","وأخدَعُ فيها بالمُنى وهيَ باطِلُ",60,"ل",1,0],["واقنع بمن تطلبه دون الورى","واخرج عن القيام والقعود",61,"د",1,0],["واقنع فإنك فانٍ","غداً وكل محال",62,"ل",1,0],["واقنع بافطار على حل ودع","شبهات مال يَحلُ فيه حلاله",63,"ل",2,0],["واقنع بإفطار على حل ودع","شبهات ما لم يحل فيه حلاله",64,"ل",2,0],["واقْنَ القناعةَ جُنّةً مأمونةً","تَحْصُنْكَ مانِعةً نبالَ الألسُن",65,"ن",1,0],["واقنَعْ بما يأتي الزمانُ فإنه","زمنٌ كقلبِ المرءِ قَدْ يتقلَّب",66,"ب",1,0],["وَاِقنَع بِما قُلنا اِلَيكَ فَاِنَّهُ","طُوي الكِتاب وَجَفَّت الاِقلام",67,"م",1,0],["واقنَع بنَزرٍ يسيرٍ دون مَكثَرةٍ","فرَغبةُ النفس في الإِكثار تُهلِكُها",68,"ك",3,0],["واقنع ففي طمع الرجالِ مذلةٌ","وَتُصغِّرُ الشكوى الكبيرَ المحتشم",69,"م",1,0],["وَاقنع ففي الحرص ذلٌّ أَنتَ تذكرُه","وَغاية العمر محدودٌ إِلى أَجل",70,"ل",1,0],["وَأَقنع من ظل الشَوامخ عزة","إِذا خانَني ظل الأَريض الممهد",71,"د",1,0],["وَاقنع ببارقة الظُبى","هاد إِذا الأَمر انبهم",72,"م",1,0],["واقنع بما خط القضاءُ عَلى النَوى","بِمَعاهد الأَحباب في تنصيصها",73,"ص",3,0],["وَاقنع بظاهرهم يزهى فباطنُهم","وَراءَ ستر من التغرير وَالحيل",74,"ل",1,0],["وَاقني حَياءَكِ وَاِقعُدي مَكفِيَّةً","إِن كُنتِ لِلرُّشدِ المُصِبِّ هُديتِ",75,"ت",1,0],["وأَقْنعُ من وعد الحبيب بخُلْفِهِ","ومِنْ كَلَفي أَن أَسأَلَ الوعد مُخْلِفا",76,"ف",2,0],["واقنع بأنك في زمانك واحد","إن القناعة كنزها لا ينفد",77,"د",1,0],["وَأَقنى وَأَغنى عَن حُسامٍ وَصارِمٍ","بِحُسنٍ وَإِحسان غَنيّ عَنِ المَدحِ",78,"ح",1,0],["وأقناسُها الأفراح والأمن واللُهى","وايناءها الأنوار تجنى من الدرِّ",79,"ر",1,0],["واقنع فهذا الكنز لا يحصل","إلا لمن يسمو إلى المعالي",80,"ي",1,0],["واقنعْ واقتصدْ ما","عالَ مقتصدٌ وما افتقرَا",81,"ر",2,0],["واقنع بقسمتك التي","أُوتيتها تكن السعيدْ",82,"د",1,0],["واقنع بدنياي .. والمقسوم","واحارب الذات / لجل الذات",83,"ت",1,0],["وَأَقْنِيَةُ الْفَضَاْءِº تَفِيْضُ سُمًّا","لإِغْرَاْءِ الْمُكَاْفِحِ بِالرَّحِيْلِ",84,"ل",1,0],["وأقنعْ بخبزٍ وملحٍ","وأجعل كتابَكَ أنسك",85,"ك",1,0],["واقْنَعْ بلَازِمِهِ وجَايِزِهِ ودَعْ","ما لا يَجوزُ مَقَالَةً وفِعَالَا",86,"ل",2,0],["واقنع بقسمة رب الناس وارض بها","وكن شكورا لما أسدى يزدك يدا",87,"د",2,0],["واقْنصِ الطيرَ بما علّى بجنحٍ","سائحٍ في افقه جَدَّا هزيلا",88,"ل",2,0],["وأقنعني \"ابن غدرةَ\" أن حُبّاً","بلا جمر الصبابةِ لا يدومُ",89,"م",1,0],["واقنع بما قسم الرحمن وارضَ به","إن القناعة من كنزِ السعاداتِ",90,"ت",1,0],["وأقنع بالشيء القليل تعففا","وفي كل رزق جاءني أنا قانع",91,"ع",1,0],["واقْنَعْ وصِلْ رَحِمًا , وانْطِقْ وزِنْ كَلِمًا","واحْمِلْ شُمُوعًا فَسِجْنُ اللَّيْلِ مُنْهَدِمُ",92,"م",1,0],["واقنعْ أُخَيَّ مِن الثَراءِ ولا","تقنعْ مِنَ الأمجادِ بالرِفَدِ",93,"د",1,0],["وأقنعنا بأنّ الفِكْر كفرٌ","وما التفكير بالتكفير آتِ",94,"ت",1,0],["16. وأقنعوها بأنَّ الحُبَّ قاتلُها","وأنّ هجر الهوى كالدّاءِ والآسي",95,"س",2,0],["واقنت لربك واجتهد في ذكره","ما خاب عبد ذاكر ما خابا",96,"ب",2,0]]}