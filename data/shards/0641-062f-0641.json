{"poems":[[95,"قربته فما ارتوى","https://www.aldiwan.net/poem11103.html","مجزوء الخفيف"],[54,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39638","الرمل"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/24804","الخفيف"],[102,"ليالي السجن","https://www.poetsgate.com/ViewPoem.aspx?id=50145",""],[309,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[406,"رسالة اعتذار إلى أم المؤمنين خديجة (رضي الله عنها)","https://www.aldiwan.net/poem10309.html","عموديه"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86940","الكامل"],[1200,"","https://poetry.dctabudhabi.ae/diwan/poem/111172","المتدارك"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64901","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108650","الخفيف"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87818","الكامل"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11167","الطويل"],[2787,"","https://poetry.dctabudhabi.ae/diwan/poem/202328","الخفيف"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199027","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77117","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28647","الخفيف"],[5459,"سلعة بائرة","https://www.poetsgate.com/ViewPoem.aspx?id=211767",""],[5628,"حديث مع الطير","https://www.poetsgate.com/ViewPoem.aspx?id=178516",""],[5720,"عودي","https://www.poetsgate.com/ViewPoem.aspx?id=202925",""],[5906,"فجور طيف","https://www.poetsgate.com/ViewPoem.aspx?id=188072",""],[6102,"حُداءُ الجَثامِين !!","https://www.poetsgate.com/ViewPoem.aspx?id=183615",""],[6167,"فرار الضياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85536&r=&rc=19",""]],"verses":[["فَدَفَناهُ بَرَّدَ ال","غَيثُ قَبْراً بِهِ ثَوَى",0,"و",2,0],["فَدَفَعَ اللَهُ الخُطوبَ عَنهُ","وَنَحنُ لِلسوءِ فِداءٌ مِنهُ",1,"ه",1,0],["فدفعْتَ الجيشَ أعلاماً عُجابا","ما لهذا الجيشِ في الصحراء ذابا",2,"ب",2,0],["فَدْفَدٍ مُقْشَعِرَّةِ النبت قاعٍ","غيرِ معهودةٍ بواكف مُزن",3,"ن",1,0],["فدفنت في خفق الجراح تألّمي","حيّا وألحدت الأنين صحيحا",4,"ح",2,0],["فدفع عنادلا لضعف وانما","لدفع شتات المال والحال والآن",5,"ن",1,0],["فدَفَعْتِ عنه الهمَّ حتى لم يَعُدْ","للخوفِ في وجدانه تَرْعِيدُ",6,"د",1,0],["فدفعوا العيان بالتوهم","ونحلوا القيام من لم يقم",7,"م",1,0],["فَدفعتها عَني وَقُلت أَرى الشَفا","في البُعد عَن شَمطا مِن الأَرجاس",8,"س",1,0],["فدفعت مكايده عني","ومرقت بثوب لم ينفض",9,"ض",1,0],["فَدفَعْتَ في صَدْرِ الشِّتاءِ بِخِلْعةٍ","خَلَعَتْ قُلوبَ الحاسدينَ فأَطْرَقُوا",10,"ق",3,0],["فدفعت العفاف عني كما يد","فع نور السحيرة الديجورا",11,"ر",2,0],["فَدَفَنتُ بَينَهُما بَقِيَّةَ عِفَّةٍ","في القَلبِ عاجَلَها الفُجورُ بِخِنجَرِ",12,"ر",1,0],["فَدَفعُهُما عَنهُ إِذا ما تَحَدَّبا","وَجَدّا كَدَفعِ الأَسكَتَينِ عَنِ البَظرِ",13,"ر",1,0],["فدفعت السفاه بالحلم لما","نزل الشيب في محل الشباب",14,"ب",1,0],["فدفن الرضا مع الرشيد","طوبى لموسى من فتى شهيد",15,"د",1,0],["فَدُفِعوا لِلتينِ ثُمَّ اِجتازوا","في وَسَطِ السَهلِ وَفيهِ اِنحازوا",16,"ز",3,0],["فَدَفَعتَني عَنهُ بِمَحضِ خِيانَة","وَلَها وَثَبتُ وُثوبَ آسادِ الشَرى",17,"ر",2,0],["فَدَفَعناهُ فَاِنثَنى","وَفَتَلناهُ فَاِنفَتَلْ",18,"ل",1,0],["فَدَفْنُ الحَقِّ مُمْتَنِعٌ","وَ نُصْرَةُ صَوْتِهِ فَرْضُ",19,"ض",1,0],["فدفاتري في كلّ زاوية ٍ","قدْ بُعثرتْ وتشتّتَ الفكْرُ",20,"ر",1,0],["فدفاتري ملأىٰ بأيامي التيْ","ما عاد فيها لي ربيعٌ ناضرُ",21,"ر",1,0],["فَدِفءٌ في مُحيطِكِ حَيثُ أنتِ","يُلامِسُ حَوفَهُ أقصى عِظامي",22,"م",2,0],["فَدَفَنَّاكَ يا الهَوَى بِقُبُورٍ","وَ كَسَوناكَ حُلَّةَ المُومِياءِ",23,"ا",2,0],["فدفنتُ نَفسي في جُمانِ حُبورِهِ","وسَكَبتُ رُوحي فانتَشَتْ أعضائى",24,"ا",2,0]]}