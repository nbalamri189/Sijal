{"poems":[[49,"مغرم مؤلم جريح أسير","https://www.aldiwan.net/poem25262.html","الخفيف"],[113,"ما على ما لقيته من مزيد","https://www.aldiwan.net/poem16516.html","الخفيف"],[132,"قد قضى لي بالصد والهجر والبلوي","https://www.aldiwan.net/poem50479.html","الخفيف"],[132,"من لصب دموعه ليس ترفا","https://www.aldiwan.net/poem50563.html","الخفيف"],[226,"بعد أن طال في هواه صدودي","https://www.aldiwan.net/poem55280.html","الخفيف"],[333,"في طريق يحفه الزهر النضر","https://www.aldiwan.net/poem54972.html","الخفيف"],[447,"إليك إليك يا ربي","https://www.aldiwan.net/poem14351.html","الهزج"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62587","الخفيف"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112777","الكامل"],[1367,"","https://poetry.dctabudhabi.ae/diwan/poem/205476","الخفيف"],[1949,"","https://poetry.dctabudhabi.ae/diwan/poem/105312","الرمل"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102145","الوافر"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102132","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200088","الخفيف"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121683","الرمل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128915","الخفيف"],[4802,"سلة أوجاعي","https://www.poetsgate.com/ViewPoem.aspx?id=32784",""],[5092,"حبٌ يورقُ في الفراغ","https://www.poetsgate.com/ViewPoem.aspx?id=175329",""],[5691,"أنَا والدجى","https://www.poetsgate.com/ViewPoem.aspx?id=206743",""],[5956,"رفضٌ وثأر","https://www.poetsgate.com/ViewPoem.aspx?id=181968",""],[5956,"حسْن هذا النهد من أجلي أنا","https://www.poetsgate.com/ViewPoem.aspx?id=182645",""],[6102,"فرادة","https://www.poetsgate.com/ViewPoem.aspx?id=184552",""],[6229,"ذلك الصوت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65179&r=&rc=2",""]],"verses":[["أَنا أَصبَحتُ لا أُطيقُ حَراكاً","كَيفَ أَصبَحتَ أَنتَ يا مَنصورُ",0,"ر",1,0],["أَنا أَصبَحت لا أَطيق حِراكاً","بَينَ قَوم قُلوبَهُم مِن حَديد",1,"د",1,0],["أنا أصبحتُ في البرية من قتلاهُ","في جوده بسيفِ جَدائه",2,"ا",3,0],["أنا أصبحتُ في ذَرَاك زمَدْحِي","ومعاليك أطولُ الناس عُنْقَا",3,"ق",2,0],["أنا أصبو إلى الجمال ولكن","كمال الجميل بيت قصيدي",4,"د",2,0],["أنا أصبو إلى الصباح وأشتا","ق إلى الليل هادئاً عبقريّا",5,"ي",2,0],["أنا أصبو وهن لغي","ر ما أصبو له تصبي",6,"ب",2,0],["أنا أصبو جازيت أم لم تجازِي","لشذاً هبَّ من طريق الحجازِ",7,"ز",1,1],["انا أصبنا بالهوان من الهوى","وبه عدمنا في الورى ألبابنا",8,"ن",2,0],["أنا أصبو الى الغرام ولا يع","رف لي في الجنون بالحسن ثانى",9,"ن",2,0],["أنا أصبحت بحب ال","أشتياني متيم",10,"م",1,1],["أنا أصلُ الأصولِ وفهم فهمٍ","أنا رأسُ الرؤس أنا الوصالِ",11,"ل",1,0],["أنا اصغى تلاوتَك","فاقرا بني لك الهنى",12,"ن",2,0],["انا أصبو للانفراد لأني","أجد الكل عائقا تفكيري",13,"ر",2,1],["أنا أصْبُو والتَّصَابِي حِلْيَةٌ","لكريمِ العِرْضِ في صَبْوَتِهِ",14,"ه",1,1],["أنا أصغي لها فأسمع منها","همس حب ينمو به جثماني",15,"ن",2,0],["أنا أصدق طير بالدنيا عشق حتى مسابيقه","ولكني بديت أذكر معاك أيام مرباعي",16,"ع",2,0],["أنا أصدَّقُ العشَّاقِ ظنًا بالهوى","دومًا ظنوني في الهوى لا تصدقُ",17,"ق",1,0],["أنا أصدقائي حين أتركُكُمْ","ينْفضُّ مجلسُنا فنَنْتشرُ",18,"ر",1,0],["أنا أصبحتُ أسيراً مستهاماً","بك يا من نلْتِ منّي كلَّ ثاركْ",19,"ك",1,0],["‏ ‏أنا أصحو فوق نهدين استراحا","‏ ‏ لدخولي يَسَّرا لي المُجْتنى",20,"ن",2,0],["أَنا أَصلُ الغَرامِ لَم أَتَبَدَّلْ","فِي شُعُورِي, وَعَنهُ لَم أَتَحَوَّلْ",21,"ل",1,1],["أنا أُصغي إليكِ في كِلّةِ اللَّيْ","لِ، كأني في عالمٍ مسحور",22,"ر",1,0]]}