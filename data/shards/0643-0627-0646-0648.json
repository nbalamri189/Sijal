aldiwan.net/poem1823.html","الوافر"],[475,"لاترض وجدك في أهل الهوى وسطا","https://www.aldiwan.net/poem15201.html","البسيط"],[475,"ربع وقفت عليه بعد أهليه","https://www.aldiwan.net/poem15251.html","البسيط"],[477,"هب لي بيانك في ممدوحك الهادي","https://www.aldiwan.net/poem36957.html","البسيط"],[477,"إن كنت مثلي على الأحوال مطلعا","https://www.aldiwan.net/poem37575.html","البسيط"],[477,"يا أمة شهد الكتاب بفضلها","https://www.aldiwan.net/poem37623.html","الكامل"],[491,"ما المال إلا ما أفاد ثناء","https://www.aldiwan.net/poem67427.html","الكامل"],[498,"كانوا ربيعا للقلوب","https://www.aldiwan.net/poem37766.html","مجزوء الوافر"],[498,"ولما توسطنا البطاح عشية","https://www.aldiwan.net/poem37797.html","الطويل"],[512,"لله إخوان صدق ما هواهم مين","https://www.aldiwan.net/poem20932.html","المواليا"],[513,"لا تندبن ليلى ولا أطلالها","https://www.aldiwan.net/poem12239.html","الكامل"],[513,"نسيب ولكن بالقنا والصوارم","https://www.aldiwan.net/poem12244.html","الطويل"],[527,"قل لإمام الزمن","https://www.aldiwan.net/poem37130.html","الرجز"],[527,"كأن وجه النهر إذ حفت به","https://www.aldiwan.net/poem37152.html","الرجز"],[527,"كأن وجود هذا بعد هذا","https://www.aldiwan.net/poem37486.html","الوافر"],[536,"صدعنا مذ كان ناعم خد","https://www.aldiwan.net/poem47603.html","عموديه"],[538,"فلا عفا الله عن مروان مظلمة","https://www.aldiwan.net/poem56847.html","البسيط"],[549,"أرني العجائب يا أباها","https://www.aldiwan.net/poem47144.html","مجزوء الكامل"],[549,"إن كنت يا عمرو قد أسأت فقد","https://www.aldiwan.net/poem47227.html","المنسرح"],[549,"صمت العواذل في أساك وسلموا","https://www.aldiwan.net/poem47242.html","الكامل"],[549,"يا ثاويا خلف الرتاج المطبق","https://www.aldiwan.net/poem47356.html","الكامل"],[549,"أيا حادي الأظعان لم لا تعرس","https://www.aldiwan.net/poem47754.html","الطويل"],[549,"أي فتى ووري في الترب","https://www.aldiwan.net/poem48059.html","السريع"],[551,"هاجت وساوسه برومة دور","https://www.aldiwan.net/poem68402.html","الكامل"],[565,"أجل هو الرزء جل فادحه","https://www.aldiwan.net/poem69740.html","مجزوء البسيط"],[573,"لم أذق بعد ريقه البابليه","https://www.aldiwan.net/poem2830.html","الخفيف"],[574,"يا آل بكر ألا لله أمكم","https://www.aldiwan.net/poem1798.html","البسيط"],[584,"أرح يمينك مما أنت معتقل","https://www.aldiwan.net/poem17644.html","البسيط"],[585,"سبحان من كون الأشياء تكوينا","https://www.aldiwan.net/poem11513.html","عموديه"],[585,"ألا مال نيران الأسى تتضرم","https://www.aldiwan.net/poem11519.html","عموديه"]],"verses":[["كانوا السَحائِبَ تَرمي مِن كَنائِنِها","مَقاتِلَ المَحلِ كَالمُثعَنجِرِ الرَذِمِ",0,"م",1,0],["كانوا إِذا قَعَدَ البِكارُ بِثِقلِهِم","قالوا لِذا العودِ الجُلالِ تَقَدَّمِ",1,"م",1,0],["كانوا إِذا الخَطبُ دَجا","وَجَلجَلَت إِحدى الغُمَم",2,"م",1,0],["كانوا صَفاءَ الكَأسِ ثُمَّ اِنجَلَوا","مِنَ البَواقي عَن قَذىً ثافِلِ",3,"ل",1,0],["كانوا فُحولَ وَغىً تُسانِدُ بِالقَنا","لا كَالفُحولِ تُسانِدُ الأَجذالا",4,"ل",2,0],["كانوا سَماءً لَنا فَلا عَجَبٌ","إِن قَطَروا بِالنَوالِ أَو هَطَلوا",5,"ل",3,0],["كانوا حَوامي جِبالِ العِزِّ فَاِنقَرَضوا","وَصَدَّعوا قُلَلَ العَليا مُذِ اِنصَدَعوا",6,"ع",3,0],["كانوا صَياصيها وَكانوا دونَها","فُرّاطَها في المَجدِ أَو نُزّاعَها",7,"ع",3,0],["كانوا هُمُ الحَيَّ اللِقاحَ وَغَيرُهُم","ضَرَعٌ عَلى حُكمِ المَقاوِلِ جارِ",8,"ر",1,0],["كانوا ثُمالَ الناسِ وَال","أَمنَ إِذا ما الأَمرُ هَرّ",9,"ر",1,0],["كانوا السُيوفَ إِذا عا","يَنوا المُقاتِلَ هَبّوا",10,"ب",3,0],["كَأَنَّ وَميضَهُ أَيدي قُيونٍ","تُعيدُ عَلى قَواضِبِها جَلاءَ",11,"ا",2,0],["كانوا بُدورَ أسِرَّةٍ ومَنابِرٍ","يتهلّلونَ بأوْجُهٍ أحْرارِ",12,"ر",1,0],["كانوا يَشُبّونَ الحُروبَ إِذا خَبَت","قِدماً بِكُلِّ مُهَنَّدٍ فَصّالِ",13,"ل",1,0],["كَانُوا مَلاَئِكَةً إِذَا جَنَّ الدُّجَى","وَإِذَا اْلأسِرَّةُ مُهَّدتْ أَمْلاَكَا",14,"ك",2,0],["كانوا نَبيطاً في الأصْلِ أو حَبَشاً","ما عِنْدَهُ عِبْرَةٌ بمُعْتَبِرِ",15,"ر",1,0],["كانَ وَالتاجُ صَغيرَينِ مَعاً","وَجَلالُ المُلكِ في مَهدِ الصِبا",16,"ب",2,0],["كَأَنَّ وِفارَ القَومِ تَحتَ رِحالِها","إِذا حُسِرَت عَنها العَمائِمُ عُنصُلُ",17,"ل",1,0],["كَانُوا وُجُوهاً مُنَوَّرَاتٍ","تَكَدَّسُوا أَرْجُلاً وَهَامَا",18,"م",2,0],["كَانُوا ابْتِسَامَ الرَّجَاءِ أَمْسَوْا","وَلا رَجَاءً وَلا ابْتِسَامَا",18,"م",2,0],["كانوا ذَوي عَدَدٍ دَثرٍ وَعاثِرَةٍ","مِنَ السِلاحِ وَأَبطالاً ذَوي نَجَدِ",19,"د",1,0],["كانوا جبالاً قد عَلتْ هضباتها","نسفتهُمُ ريحُ الجلاد فزُلْزلوا",20,"ل",3,0],["كانوا بحاراً من حديد زاخر","أذكتهم نار الوغى فتَسيَّلُوا",20,"ل",3,0],["كانوا كعِقد رائق نظمه","فبَددتهم ضربة ناثره",21,"ر",2,0],["كانوا أحقّ البرايا مطلباً فغَدوا","من أبطل الناس في الدنيا مطاليبا",22,"ب",2,0],["كانوا أجلّ الورى عزاً ومقدرة","إذا الخطوب بحبل البَغي تحتزم",23,"م",1,0],["كانوا يمدّون سيل الكيد مندفقاً","وكان يبني له من سعيه رصفا",24,"ف",2,0],["كانوا ثَمانينَ أَو زادوا ثَمانِيَةً","لَولا رَجاؤُكَ قَد قَتَّلتُ أَولادي",25,"ي",1,0],["كانوا شُهوداً فَلَم يَدفَع مَنِيَّتَهُ","عَبدُ العَزيزِ وَلا رَوحٌ وَلا عُمَرُ",26,"ر",1,0],["كانوا كَمُشتَرِكينَ لَمّا بايَعوا","خَسِروا وَشُفَّ عَلَيهِمُ فَاِستوضِعوا",27,"ع",3,0],["كَأَنَّ وَميضَهُ أَقرابُ بُلقٍ","تُحازِرُ خَلفَها خَيلاً صِياما",28,"م",2,0],["كانوا إِذا حَضَروا شيبَ العُقارُ لَهُم","وَطيفَ فيهِم بِأَكواسٍ وَأَكوابِ",29,"ب",1,0],["كانوا بِدارٍ ناعِمينَ فَبُدِّلوا","أَيّامَ ذي قَرَدٍ وُجوهَ عِبادِ",30,"د",1,0],["كانوا جبالاً لا ترام فأصبحوا","بيد الردى حفنات تربٍ هار",31,"ر",1,0],["كأنّ وصلكِ مالٌ في يمين فتًى","ما ماله في يديه غير مجتاز",32,"ز",1,0],["كانوا مراعي للأرباع ممرعة","في كل حين وللمرتاع أكهافا",33,"ف",2,0],["كانوا إذا امتُدِحوا رأوْا ما فيهمُ","فالأرْيحِيَّةُ منهمُ بمكان",34,"ن",1,0],["كانوا إذا مُدِحوا رأوا ما فيهمُ","فالأريحيَّةُ منهمُ بمكان",35,"ن",1,0],["كانوا إذا قسطوا فأقسطُ واعظٍ","ظلُّوا هنالك منه في فَهفاه",36,"ه",1,0],["كانوا مَلاوِثَ فَاِحتاجَ الصِدّيقُ لَهُم","فَقدَ البِلادِ إِذا ما تُمِحلُ المَطَرا",37,"ر",2,0],["كانوا مَوالِيَ حَقٍّ يَطلُبونَ بِهِ","فَأَدرَكوهُ وَما مَلّوا وَلا لَغِبوا",38,"ب",3,0],["كانوا ذَوي إِمَّةٍ حَتّى إِذا عَلِقَت","بِهِم حَبائِلُ لِلشَيطانِ وَاِبتَهَروا",39,"ر",3,0],["كانوا إِذا الريحُ لَفَّت عُشبَ ذي إِضَمٍ","غَيثَ المَراضِعِ ما ضَنّوا وَما مَنَعوا",40,"ع",3,0],["كانوا إِذا حَلَّ جارٌ في بُيوتِهِمِ","عادوا عَلَيهِ وَأَحصَوا مالَهُ عَدَدا",41,"د",2,0],["كَأَنَ وَغاها حَجرَتَيهِ وَحَولَهُ","أَضاميمُ مِن سِفرِ القَبائِلِ نُزَّلُ",42,"ل",1,0],["كان والعزم يملأ الصدر منه","عنده المستحيل لا يستحيل",43,"ل",1,0],["كانوا على الناس آباء أولى شفق","وفي الأرائك أملاكاً خواقينا",44,"ن",2,0],["كانوا الحمائم قل أن","تحلو من الطوق الحمامه",45,"م",2,0],["كان والله يسكع الصبح والليل","إلى كل حانة سكيرا",46,"ر",2,0],["كانوا بظل السلم لا بهلالهم","شر يراد ولا حماه مروع",47,"ع",1,0],["كانوا وَطَرفُ الدَهرِ لا يَسمو لَهُم","ما بالُهُم عُرِضوا عَلى النُظّارِ",48,"ر",1,0],["كَأَنَّ وَجهَكَ تَحتَ النَقعِ بَدرُ دُجىً","يُضيءُ مُلتَثِماً أَو غَيرَ مُلتَثِمِ",49,"م",1,0],["كانوا مُلوكاً سَريرُ الشَرقِ تَحتَهُمُ","فَهَل سَأَلتَ سَريرَ الغَربِ ما كانوا",50,"ن",3,0],["كانوا الذِئابَ وَكانَ الجَهلُ داءَهُمو","وَاليَومَ عِلمُهُمُ الراقي هُوَ الداءُ",51,"ا",2,0],["كانوا أَجَلَّ مِنَ المُلوكِ جَلالَةً","وَأَعَزَّ سُلطاناً وَأَفخَمَ مَظهَرا",52,"ر",2,0],["كَأَنَّ وُجوهَ الخَيلِ غُرّاً وَسيمَةً","دَرارِيُّ لَيلٍ طُلَّعٌ فيهِ ثُقَّبُ",53,"ب",1,0],["كانوا بِذاكَ عِصابَةً كَعَصائِبٍ","في مَذحِجٍ وَذُؤابَةً كَذَوائِبِ",54,"ب",1,0],["كانوا كَشَوكِ القَتادِ يَسخَطُ را","عيهِ وَيَأبى رِضاهُ مُحتَطِبُه",55,"ب",2,0],["كانوا هُمُ ثَبَجَ الجَميعِ لِطَيِّئٍ","في أَمرِها وَطَوائِفَ الأَشتاتِ",56,"ت",1,0],["كانوا أَحَقَّ بِعَقدِ بَيعَتِها ضُحاً","وَبِنَظمِ لُؤلُؤِ تاجِها المَعقودِ",57,"د",1,0],["كانوا ثَلاثَةَ أَبحُرٍ أَفضى بِها","وَلَعُ المَنونِ إِلى ثَلاثَةِ أَقبُرِ",58,"ر",1,0],["كَأَنَّ وَقعَ سُيوفِ الهِندِ سابِحَةٍ","في هامِهِم حَشُّ نارٍ تَحتَها سَعَفا",59,"ف",2,0],["كانوا فَبانوا وَبانَ ذِكرُهُمُ","فَلَيسَ إِلّا الرُسومُ وَالطَلَلُ",60,"ل",1,0],["كَأَنَّ وَميضَ التاجِ فَوقَ جَبينِهِ","عَلى قَمَرٍ بِالشِعرَيَينِ مُكَلَّلِ",61,"ل",1,0],["كانوا أُسوداً يَقرِمونَ إِلى العِدى","نَهَماً إِذا كانَ الرِجالُ قُروما",62,"م",2,0],["كانوا جَميعاً ثُمَّ فَرَّقَ بَينَهُم","بَينَ كَتَقويضِ الجَهامِ المُقلِعِ",63,"ع",1,0],["كانوا كَسالِئَةٍ حَمقاءَ إِذ حَقَنَت","سِلاءَها في أَديمٍ غَيرِ مَربوبِ",64,"ب",1,0],["كانوا إِذاً لِتَميمٍ لُقمَةً ذَهَبَت","في ذي بَلاعيمَ لَهّامٍ إِذا فَغَرا",65,"ر",2,0],["كانوا لَيالِيَ كُنتَ فيهِم أُمَّةً","يُرجى لَها زَمَنٌ مِنَ الأَزمانِ",66,"ن",1,0],["كانوا فَريقَينِ يُصغونَ الزُجاجَ عَلى","قُعسِ الكَواهِلَ في أَكتافِها شَمَمُ",67,"م",1,0],["كانوا الذَوائِبَ مِن فَهرٍ وَأَكَرَمَها","حيثُ الأُنوفُ وَحَيثُ الفَرعُ وَالعَدَدُ",68,"د",1,0],["كانوا مُلوكَ مَآكِلٍ وَمَشارِبٍ","وَمَلابِسٍ وَرَوائِحٍ عَطِراتِ",69,"ت",1,0],["كانوا المُلوكَ فَأَيُّهُم","لَم يُفنِهِ رَيبُ المَنونِ",70,"ن",1,0],["كانَ وَبلاً لِلعُفاةِ هَتوناً","وَلِأَحزابِ العُداةِ وَبالا",71,"ل",2,0],["كأنّ وُثُوبَ السُّكْرِ فيها مُساورٌ","يدبّبُ منه في مفاصلها نملا",72,"ل",2,0],["كأنّ وراءَ الخيلِ منها جآذراً","تُرَوّعُ أخصارٌ لهنّ دماجُ",73,"ج",1,0],["كانوا عَلى عَهدِ كِسرى في الزَمانِ وَلَن","يَستَشرِيَ الخَطبُ إِلّا كُلَّما قَدُما",74,"م",2,0],["كانوا بُرودَ زَمانِهِم فَتَصَدَّعوا","فَكَأَنَّما لَبِسَ الزَمانُ الصوفا",75,"ف",2,0],["كانَ واللهِ عفيفاً نزهاً","ولهُ عرضٌ عريضٌ ما اتهمْ",76,"م",1,1],["كانوا إذا قبلوا الرِشا","ولّوا لعلمٍ أو نسبْ",77,"ب",1,1],["كانوا معاني المغاني حينَ ينشدُهُمْ","شادٍ يجاوبُهُ حُسْنٌ وإحسانُ",78,"ن",1,1],["كانَ وَالوُدَّ الَّذي يَشكو بِها","كَمَريقِ الماءِ في الأَرضِ الشَحاح",79,"ح",1,0],["كانوا العدوَّ فأصبحوا في ظلِّها","أَوْلىَ الشُّعوبِ بأُلفةٍ ووِدادِ",80,"د",1,0],["كانوا غِياث المُرْمِلين إذا طغت","نُوَبُ الزّمانِ وهالتِ الأزماتُ",81,"ت",1,0],["كانوا إِذا لَوَتِ النُفوسَ عَنِ النَدى","سَعَةُ الغِنى قالوا نُفوسُ تِجارِ",82,"ر",1,0],["كانوا المَصاقِعَ يَهدي كُلَّ مُعتَسِفٍ","ما يَنطِقونَ وَيَشفي كُلَّ مَخبولِ",83,"ل",1,0],["كانوا مَصابيحَ الرَشادِ إِذا دَجَت","ظُلَمُ الحَياةِ وَأَعوَزَ المِصباحُ",84,"ح",1,0],["كانوا الغِياثَ إِذا تَنوبُ عَظيمَةٌ","وَتَهولُ بارِزَةُ النُيوبِ وَقاحُ",84,"ح",1,0],["كانوا الأُساةَ إِذا تَحَطَّمَ مَنكِبٌ","وَاِنهاضَ مِن وَقعِ الخُطوبِ جَناحُ",84,"ح",1,0],["كانوا النُهاةَ الآمِرينَ فَما اِشتَهوا","نالوا وَما ساموا الخَلائِقَ صارا",85,"ر",2,0],["كانوا أَساسَ بِنائِهِ وعِمادَهُ","والأرضُ تُخْسَفُ و