ب"],[476,"لا ينسإ الله منا معشراً شهدوا","https://www.aldiwan.net/poem1821.html","البسيط"],[476,"عرفت بأجدث فنعاف عرق","https://www.aldiwan.net/poem1823.html","الوافر"],[478,"لاترض وجدك في أهل الهوى وسطا","https://www.aldiwan.net/poem15201.html","البسيط"],[478,"ربع وقفت عليه بعد أهليه","https://www.aldiwan.net/poem15251.html","البسيط"],[480,"هب لي بيانك في ممدوحك الهادي","https://www.aldiwan.net/poem36957.html","البسيط"],[480,"إن كنت مثلي على الأحوال مطلعا","https://www.aldiwan.net/poem37575.html","البسيط"],[480,"يا أمة شهد الكتاب بفضلها","https://www.aldiwan.net/poem37623.html","الكامل"],[494,"ما المال إلا ما أفاد ثناء","https://www.aldiwan.net/poem67427.html","الكامل"],[501,"كانوا ربيعا للقلوب","https://www.aldiwan.net/poem37766.html","مجزوء الوافر"],[501,"ولما توسطنا البطاح عشية","https://www.aldiwan.net/poem37797.html","الطويل"],[515,"لله إخوان صدق ما هواهم مين","https://www.aldiwan.net/poem20932.html","المواليا"],[516,"لا تندبن ليلى ولا أطلالها","https://www.aldiwan.net/poem12239.html","الكامل"],[516,"نسيب ولكن بالقنا والصوارم","https://www.aldiwan.net/poem12244.html","الطويل"],[530,"قل لإمام الزمن","https://www.aldiwan.net/poem37130.html","الرجز"],[530,"كأن وجه النهر إذ حفت به","https://www.aldiwan.net/poem37152.html","الرجز"],[530,"كأن وجود هذا بعد هذا","https://www.aldiwan.net/poem37486.html","الوافر"],[539,"صدعنا مذ كان ناعم خد","https://www.aldiwan.net/poem47603.html","عموديه"],[541,"فلا عفا الله عن مروان مظلمة","https://www.aldiwan.net/poem56847.html","البسيط"],[552,"أرني العجائب يا أباها","https://www.aldiwan.net/poem47144.html","مجزوء الكامل"],[552,"إن كنت يا عمرو قد أسأت فقد","https://www.aldiwan.net/poem47227.html","المنسرح"],[552,"صمت العواذل في أساك وسلموا","https://www.aldiwan.net/poem47242.html","الكامل"],[552,"يا ثاويا خلف الرتاج المطبق","https://www.aldiwan.net/poem47356.html","الكامل"],[552,"أيا حادي الأظعان لم لا تعرس","https://www.aldiwan.net/poem47754.html","الطويل"],[552,"أي فتى ووري في الترب","https://www.aldiwan.net/poem48059.html","السريع"],[554,"هاجت وساوسه برومة دور","https://www.aldiwan.net/poem68402.html","الكامل"],[568,"أجل هو الرزء جل فادحه","https://www.aldiwan.net/poem69740.html","مجزوء البسيط"],[576,"لم أذق بعد ريقه البابليه","https://www.aldiwan.net/poem2830.html","الخفيف"],[577,"يا آل بكر ألا لله أمكم","https://www.aldiwan.net/poem1798.html","البسيط"],[587,"أرح يمينك مما أنت معتقل","https://www.aldiwan.net/poem17644.html","البسيط"],[588,"سبحان من كون الأشياء تكوينا","https://www.aldiwan.net/poem11513.html","عموديه"],[588,"ألا مال نيران الأسى تتضرم","https://www.aldiwan.net/poem11519.html","عموديه"]],"verses":[["كأن وثوبه أملٌ لعاف","بباب المرتضى يشكو سغابا",0,"ب",2,0],["كانوا السَحائِبَ تَرمي مِن كَنائِنِها","مَقاتِلَ المَحلِ كَالمُثعَنجِرِ الرَذِمِ",1,"م",1,0],["كانوا إِذا قَعَدَ البِكارُ بِثِقلِهِم","قالوا لِذا العودِ الجُلالِ تَقَدَّمِ",2,"م",1,0],["كانوا إِذا الخَطبُ دَجا","وَجَلجَلَت إِحدى الغُمَم",3,"م",1,0],["كانوا صَفاءَ الكَأسِ ثُمَّ اِنجَلَوا","مِنَ البَواقي عَن قَذىً ثافِلِ",4,"ل",1,0],["كانوا فُحولَ وَغىً تُسانِدُ بِالقَنا","لا كَالفُحولِ تُسانِدُ الأَجذالا",5,"ل",2,0],["كانوا سَماءً لَنا فَلا عَجَبٌ","إِن قَطَروا بِالنَوالِ أَو هَطَلوا",6,"ل",3,0],["كانوا حَوامي جِبالِ العِزِّ فَاِنقَرَضوا","وَصَدَّعوا قُلَلَ العَليا مُذِ اِنصَدَعوا",7,"ع",3,0],["كانوا صَياصيها وَكانوا دونَها","فُرّاطَها في المَجدِ أَو نُزّاعَها",8,"ع",3,0],["كانوا هُمُ الحَيَّ اللِقاحَ وَغَيرُهُم","ضَرَعٌ عَلى حُكمِ المَقاوِلِ جارِ",9,"ر",1,0],["كانوا ثُمالَ الناسِ وَال","أَمنَ إِذا ما الأَمرُ هَرّ",10,"ر",1,0],["كانوا السُيوفَ إِذا عا","يَنوا المُقاتِلَ هَبّوا",11,"ب",3,0],["كَأَنَّ وَميضَهُ أَيدي قُيونٍ","تُعيدُ عَلى قَواضِبِها جَلاءَ",12,"ا",2,0],["كانوا بُدورَ أسِرَّةٍ ومَنابِرٍ","يتهلّلونَ بأوْجُهٍ أحْرارِ",13,"ر",1,0],["كانوا يَشُبّونَ الحُروبَ إِذا خَبَت","قِدماً بِكُلِّ مُهَنَّدٍ فَصّالِ",14,"ل",1,0],["كَانُوا مَلاَئِكَةً إِذَا جَنَّ الدُّجَى","وَإِذَا اْلأسِرَّةُ مُهَّدتْ أَمْلاَكَا",15,"ك",2,0],["كانوا نَبيطاً في الأصْلِ أو حَبَشاً","ما عِنْدَهُ عِبْرَةٌ بمُعْتَبِرِ",16,"ر",1,0],["كانَ وَالتاجُ صَغيرَينِ مَعاً","وَجَلالُ المُلكِ في مَهدِ الصِبا",17,"ب",2,0],["كَأَنَّ وِفارَ القَومِ تَحتَ رِحالِها","إِذا حُسِرَت عَنها العَمائِمُ عُنصُلُ",18,"ل",1,0],["كَانُوا وُجُوهاً مُنَوَّرَاتٍ","تَكَدَّسُوا أَرْجُلاً وَهَامَا",19,"م",2,0],["كَانُوا ابْتِسَامَ الرَّجَاءِ أَمْسَوْا","وَلا رَجَاءً وَلا ابْتِسَامَا",19,"م",2,0],["كانوا ذَوي عَدَدٍ دَثرٍ وَعاثِرَةٍ","مِنَ السِلاحِ وَأَبطالاً ذَوي نَجَدِ",20,"د",1,0],["كانوا جبالاً قد عَلتْ هضباتها","نسفتهُمُ ريحُ الجلاد فزُلْزلوا",21,"ل",3,0],["كانوا بحاراً من حديد زاخر","أذكتهم نار الوغى فتَسيَّلُوا",21,"ل",3,0],["كانوا كعِقد رائق نظمه","فبَددتهم ضربة ناثره",22,"ر",2,0],["كانوا أحقّ البرايا مطلباً فغَدوا","من أبطل الناس في الدنيا مطاليبا",23,"ب",2,0],["كانوا أجلّ الورى عزاً ومقدرة","إذا الخطوب بحبل البَغي تحتزم",24,"م",1,0],["كانوا يمدّون سيل الكيد مندفقاً","وكان يبني له من سعيه رصفا",25,"ف",2,0],["كانوا ثَمانينَ أَو زادوا ثَمانِيَةً","لَولا رَجاؤُكَ قَد قَتَّلتُ أَولادي",26,"د",2,0],["كانوا شُهوداً فَلَم يَدفَع مَنِيَّتَهُ","عَبدُ العَزيزِ وَلا رَوحٌ وَلا عُمَرُ",27,"ر",1,0],["كانوا كَمُشتَرِكينَ لَمّا بايَعوا","خَسِروا وَشُفَّ عَلَيهِمُ فَاِستوضِعوا",28,"ع",3,0],["كَأَنَّ وَميضَهُ أَقرابُ بُلقٍ","تُحازِرُ خَلفَها خَيلاً صِياما",29,"م",2,0],["كانوا إِذا حَضَروا شيبَ العُقارُ لَهُم","وَطيفَ فيهِم بِأَكواسٍ وَأَكوابِ",30,"ب",1,0],["كانوا بِدارٍ ناعِمينَ فَبُدِّلوا","أَيّامَ ذي قَرَدٍ وُجوهَ عِبادِ",31,"د",1,0],["كانوا جبالاً لا ترام فأصبحوا","بيد الردى حفنات تربٍ هار",32,"ر",1,0],["كأنّ وصلكِ مالٌ في يمين فتًى","ما ماله في يديه غير مجتاز",33,"ز",1,0],["كانوا مراعي للأرباع ممرعة","في كل حين وللمرتاع أكهافا",34,"ف",2,0],["كانوا إذا امتُدِحوا رأوْا ما فيهمُ","فالأرْيحِيَّةُ منهمُ بمكان",35,"ن",1,0],["كانوا إذا مُدِحوا رأوا ما فيهمُ","فالأريحيَّةُ منهمُ بمكان",36,"ن",1,0],["كانوا إذا قسطوا فأقسطُ واعظٍ","ظلُّوا هنالك منه في فَهفاه",37,"ه",1,0],["كانوا مَلاوِثَ فَاِحتاجَ الصِدّيقُ لَهُم","فَقدَ البِلادِ إِذا ما تُمِحلُ المَطَرا",38,"ر",2,0],["كانوا مَوالِيَ حَقٍّ يَطلُبونَ بِهِ","فَأَدرَكوهُ وَما مَلّوا وَلا لَغِبوا",39,"ب",3,0],["كانوا ذَوي إِمَّةٍ حَتّى إِذا عَلِقَت","بِهِم حَبائِلُ لِلشَيطانِ وَاِبتَهَروا",40,"ر",3,0],["كانوا إِذا الريحُ لَفَّت عُشبَ ذي إِضَمٍ","غَيثَ المَراضِعِ ما ضَنّوا وَما مَنَعوا",41,"ع",3,0],["كانوا إِذا حَلَّ جارٌ في بُيوتِهِمِ","عادوا عَلَيهِ وَأَحصَوا مالَهُ عَدَدا",42,"د",2,0],["كَأَنَ وَغاها حَجرَتَيهِ وَحَولَهُ","أَضاميمُ مِن سِفرِ القَبائِلِ نُزَّلُ",43,"ل",1,0],["كان والعزم يملأ الصدر منه","عنده المستحيل لا يستحيل",44,"ل",1,0],["كانوا على الناس آباء أولى شفق","وفي الأرائك أملاكاً خواقينا",45,"ن",2,0],["كانوا الحمائم قل أن","تحلو من الطوق الحمامه",46,"م",2,0],["كان والله يسكع الصبح والليل","إلى كل حانة سكيرا",47,"ر",2,0],["كانوا بظل السلم لا بهلالهم","شر يراد ولا حماه مروع",48,"ع",1,0],["كانوا وَطَرفُ الدَهرِ لا يَسمو لَهُم","ما بالُهُم عُرِضوا عَلى النُظّارِ",49,"ر",1,0],["كَأَنَّ وَجهَكَ تَحتَ النَقعِ بَدرُ دُجىً","يُضيءُ مُلتَثِماً أَو غَيرَ مُلتَثِمِ",50,"م",1,0],["كانوا مُلوكاً سَريرُ الشَرقِ تَحتَهُمُ","فَهَل سَأَلتَ سَريرَ الغَربِ ما كانوا",51,"ن",3,0],["كانوا الذِئابَ وَكانَ الجَهلُ داءَهُمو","وَاليَومَ عِلمُهُمُ الراقي هُوَ الداءُ",52,"ا",2,0],["كانوا أَجَلَّ مِنَ المُلوكِ جَلالَةً","وَأَعَزَّ سُلطاناً وَأَفخَمَ مَظهَرا",53,"ر",2,0],["كَأَنَّ وُجوهَ الخَيلِ غُرّاً وَسيمَةً","دَرارِيُّ لَيلٍ طُلَّعٌ فيهِ ثُقَّبُ",54,"ب",1,0],["كانوا بِذاكَ عِصابَةً كَعَصائِبٍ","في مَذحِجٍ وَذُؤابَةً كَذَوائِبِ",55,"ب",1,0],["كانوا كَشَوكِ القَتادِ يَسخَطُ را","عيهِ وَيَأبى رِضاهُ مُحتَطِبُه",56,"ب",2,0],["كانوا هُمُ ثَبَجَ الجَميعِ لِطَيِّئٍ","في أَمرِها وَطَوائِفَ الأَشتاتِ",57,"ت",1,0],["كانوا أَحَقَّ بِعَقدِ بَيعَتِها ضُحاً","وَبِنَظمِ لُؤلُؤِ تاجِها المَعقودِ",58,"د",1,0],["كانوا ثَلاثَةَ أَبحُرٍ أَفضى بِها","وَلَعُ المَنونِ إِلى ثَلاثَةِ أَقبُرِ",59,"ر",1,0],["كَأَنَّ وَقعَ سُيوفِ الهِندِ سابِحَةٍ","في هامِهِم حَشُّ نارٍ تَحتَها سَعَفا",60,"ف",2,0],["كانوا فَبانوا وَبانَ ذِكرُهُمُ","فَلَيسَ إِلّا الرُسومُ وَالطَلَلُ",61,"ل",1,0],["كَأَنَّ وَميضَ التاجِ فَوقَ جَبينِهِ","عَلى قَمَرٍ بِالشِعرَيَينِ مُكَلَّلِ",62,"ل",1,0],["كانوا أُسوداً يَقرِمونَ إِلى العِدى","نَهَماً إِذا كانَ الرِجالُ قُروما",63,"م",2,0],["كانوا جَميعاً ثُمَّ فَرَّقَ بَينَهُم","بَينَ كَتَقويضِ الجَهامِ المُقلِعِ",64,"ع",1,0],["كانوا كَسالِئَةٍ حَمقاءَ إِذ حَقَنَت","سِلاءَها في أَديمٍ غَيرِ مَربوبِ",65,"ب",1,0],["كانوا إِذاً لِتَميمٍ لُقمَةً ذَهَبَت","في ذي بَلاعيمَ لَهّامٍ إِذا فَغَرا",66,"ر",2,0],["كانوا لَيالِيَ كُنتَ فيهِم أُمَّةً","يُرجى لَها زَمَنٌ مِنَ الأَزمانِ",67,"ن",1,0],["كانوا فَريقَينِ يُصغونَ الزُجاجَ عَلى","قُعسِ الكَواهِلَ في أَكتافِها شَمَمُ",68,"م",1,0],["كانوا الذَوائِبَ مِن فَهرٍ وَأَكَرَمَها","حيثُ الأُنوفُ وَحَيثُ الفَرعُ وَالعَدَدُ",69,"د",1,0],["كانوا مُلوكَ مَآكِلٍ وَمَشارِبٍ","وَمَلابِسٍ وَرَوائِحٍ عَطِراتِ",70,"ت",1,0],["كانوا المُلوكَ فَأَيُّهُم","لَم يُفنِهِ رَيبُ المَنونِ",71,"ن",1,0],["كانَ وَبلاً لِلعُفاةِ هَتوناً","وَلِأَحزابِ العُداةِ وَبالا",72,"ل",2,0],["كأنّ وُثُوبَ السُّكْرِ فيها مُساورٌ","يدبّبُ منه في مفاصلها نملا",73,"ل",2,0],["كأنّ وراءَ الخيلِ منها جآذراً","تُرَوّعُ أخصارٌ لهنّ دماجُ",74,"ج",1,0],["كانوا عَلى عَهدِ كِسرى في الزَمانِ وَلَن","يَستَشرِيَ الخَطبُ إِلّا كُلَّما قَدُما",75,"م",2,0],["كانوا بُرودَ زَمانِهِم فَتَصَدَّعوا","فَكَأَنَّما لَبِسَ الزَمانُ الصوفا",76,"ف",2,0],["كانَ واللهِ عفيفاً نزهاً","ولهُ عرضٌ عريضٌ ما اتهمْ",77,"م",1,1],["كانوا إذا قبلوا الرِشا","ولّوا لعلمٍ أو نسبْ",78,"ب",1,1],["كانوا معاني المغاني حينَ ينشدُهُمْ","شادٍ يجاوبُهُ حُسْنٌ وإحسانُ",79,"ن",1,1],["كانَ وَالوُدَّ الَّذي يَشكو بِها","كَمَريقِ الماءِ في الأَرضِ الشَحاح",80,"ح",1,0],["كانوا العدوَّ فأصبحوا في ظلِّها","أَوْلىَ الشُّعوبِ بأُلفةٍ ووِدادِ",81,"د",1,0],["كانوا غِياث المُرْمِلين إذا طغت","نُوَبُ الزّمانِ وهالتِ الأزماتُ",82,"ت",1,0],["كانوا إِذا لَوَتِ النُفوسَ عَنِ النَدى","سَعَةُ الغِنى قالوا نُفوسُ تِجارِ",83,"ر",1,0],["كانوا المَصاقِعَ يَهدي كُلَّ مُعتَسِفٍ","ما يَنطِقونَ وَيَشفي كُلَّ مَخبولِ",84,"ل",1,0],["كانوا مَصابيحَ الرَشادِ إِذا دَجَت","ظُلَمُ الحَياةِ وَأَعوَزَ المِصباحُ",85,"ح",1,0],["كانوا الغِياثَ إِذا تَنوبُ عَظيمَةٌ","وَتَهولُ بارِزَةُ النُيوبِ وَقاحُ",85,"ح",1,0],["كانوا الأُساةَ إِذا تَحَطَّمَ مَنكِبٌ","وَاِنهاضَ مِن وَقعِ الخُطوبِ جَناحُ",85,"ح",1,0],["كانوا النُهاةَ الآمِرينَ فَما اِشتَهوا","نالوا وَما ساموا الخَلائِقَ صارا",86,"ر",2,0],["كانوا أَساسَ بِنائِهِ وعِمادَهُ","والأرضُ تُخْسَفُ والشَّوامخُ تُنْسَفُ",87,"ف",1,0],["كانوا يَظنُّونَ أنْ لا يُسْتَبَاحَ لها","حِمىً فلا شمماً أبدتْ ولا أنَفَا",88,"ف",2,0],["كانوا على حَدَثِ الزّمانِ جَناحَنا","فتركتَ ناهِضَهُ كسيراً داميا",89,"ي",2,0],["كانوا على عهدٍ مضى فأتمّهُ","لإلهِهِمْ عهدٌ أبرُّ وأسمحُ",90,"ح",1,0],["كان واديك اللسرور مآلاً","فغدا بالثبور شرَّ مآل",91,"ل",1,0],["كانوا عَلى عَهدي ذي القَرنَينِ أَربَعَةً","وَقفاً فَما أُنقِصوا مِنهُ وَلا زادوا",92,"د",3,0],["كانوا بِلَيلٍ عَصاهُم وَهيَ واحِدَةٌ","فَأَصبَحوا وَعَصاهُم غُدوَةً شِقَقُ",93,"ق",1,0],["كانوا يَقولونَ إِذا قُتِلنا","صَبراً عَلى مِلَّتِنا رَجَعنا",94,"ن",2,0],["كانوا إِذا غَرَسوا سَقَوا وَإِذا بَنَوا","لَم يَهدِموا لِبِنائِهِم آساسا",95,"س",2,0],["كَأَنَّ وَجدي بِها وَقَد حَجَبت","في الرَأسِ وَالعَينِ وَالحَشا سَكَرُ",96,"ر",1,0],["كانوا وَلا دينَ إِلّا السَيفُ مُلكُهُمُ","راسٍ وَأَيّامُهُم عادِيَّةٌ غُلُبُ",97,"ب",1,0],["كانوا فَريقَينِ فَمِن هارِبٍ","وَمُقعِسٍ بِالطَعنِ لَم يَهرُبِ",98,"ب",1,0],["كانَ وُدّي لَها خَبِيّاً فَأَسرَعتُ","إِلَيها وَالأَمرُ فيهِ اِلتِواءُ",99,"ا",2,0],["كانوا زَماناً فَوقَ غَبرائِهِم","ثُمَّ اِستَحالوا فَغَدَوا تَحتَها",100,"ت",3,0],["كَأَنَّ وَليداً ماتَ قَبلَ سُقوطِهِ","عَلى الأَرضِ ناجٍ مِن حِبالَتِهِ طَفرا",101,"ر",2,0],["كَأَنَّ وَنىً خانَت بِهِ مِن نِظامِها","مَعاقِدُ فَاِرفَضَّت بِهِنَّ الطَوائِفُ",102,"ف",1,0],["كانوا خصوماً ثم حاقَت فتنةٌ","وإذا الخصوم كأَنهم إخوان",103,"ن",1,0],["كأَنَّ وجوه القوم فوقَ جذوعهم","نجوم سماء في الصباح أُفول",104,"ل",1,0],["كانوا الجِبالَ لَها قَبلَ الجِبالِ وَهُم","سالوا وَلَم يَكُ سَيلٌ في أَباطِحِها",105,"ح",3,0],["كَانَ وَهْوَ الكَرِيمُ جِدَّ ضَنِينٍ","بِالإِذَاعَاتِ عَنْهُ وَالأَنْبَاءِ",106,"ا",2,0],["كَانُوا ثَمَانِيَةٌ مِنَ النُّدَمَاءِ","مُتَآلِفِينَ كَأَحْسَنِ الرُّفَقَاءِ",107,"ا",2,1],["كَانُوا وَقَدْ رَكِبُوا لِلْحَرْبِ أَبْهَجَ مَا","تَرَى العُيُونُ غِياضاً فَوْق