{"poems":[[53,"قل لأقنى يرمي إلى المجد طرفا","https://www.aldiwan.net/poem29971.html","الخفيف"],[86,"صفحة البرق أومضت في الغمام","https://www.aldiwan.net/poem10914.html","الخفيف"],[93,"يا ابن لبنان عد إلى لبنان","https://www.aldiwan.net/poem11175.html","الخفيف"],[88,"دار السلام تفاخرت برجال","https://www.aldiwan.net/poem44980.html","الكامل"],[72,"صب بمصر حيث أولاده","https://www.aldiwan.net/poem18275.html","السريع"],[72,"يحير الغصن بين اللين والهيف","https://www.aldiwan.net/poem19267.html","البسيط"],[72,"لثمت ثغر عذولي حين سماك","https://www.aldiwan.net/poem19438.html","البسيط"],[72,"عيد يعود إلى هذا الثنا العالي","https://www.aldiwan.net/poem19474.html","البسيط"],[72,"حاشا لوعدك أن يلويه نسيان","https://www.aldiwan.net/poem20287.html","البسيط"],[51,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[51,"لا يغضبن لعمرو من له خطر","https://www.aldiwan.net/poem62965.html","البسيط"],[51,"وقفات رأيك في الخطوب تأمل","https://www.aldiwan.net/poem65996.html","الكامل"],[92,"أين يا شعب قلبك الخافق الحساس","https://www.aldiwan.net/poem38915.html","الخفيف"],[43,"لك يا منازل في القلوب منازل","https://www.aldiwan.net/poem10130.html","الكامل"],[45,"عهدي بربعك مثلا آرامه","https://www.aldiwan.net/poem65681.html","الكامل"],[45,"نصيب عينيك من سح وتسجام","https://www.aldiwan.net/poem66640.html","البسيط"],[61,"إني هديت لنعمة مكنونة","https://www.aldiwan.net/poem51755.html","الكامل"],[66,"كفي القتال وفكي قيد أسراك","https://www.aldiwan.net/poem38480.html","البسيط"],[80,"زارت على الخوف من رقيب","https://www.aldiwan.net/poem31574.html","مخلع البسيط"],[48,"لم تدر جارتنا ولا تدري","https://www.aldiwan.net/poem63376.html","الكامل"],[106,"حرب الأعداء الثلاثة","https://www.poetsgate.com/ViewPoem.aspx?id=179643",""],[45,"عَهْدِي بِرَبْعِكَ مُثَّلاً آرَامُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=32042",""],[110,"وفد الربيع فقم لحث الكاس","https://www.aldiwan.net/poem16246.html","الكامل"],[116,"قل لمحبوب دني","https://www.aldiwan.net/poem41212.html","عموديه"],[116,"يا نبيا على الأنبياء","https://www.aldiwan.net/poem42164.html","الخفيف"],[144,"أبا زنة لا زال جدك هابطا","https://www.aldiwan.net/poem11736.html","الطويل"],[199,"ألف ألا انعم بالمحبة حالا","https://www.aldiwan.net/poem51903.html","الكامل"],[343,"مرقص ضاحك يحف به البشر","https://www.aldiwan.net/poem55323.html","الخفيف"],[352,"قد أغتدي والليل مركوم الظلم","https://www.aldiwan.net/poem68967.html","الرجز"],[433,"كافورة في الثلج مدفونة","https://www.aldiwan.net/poem12419.html","السريع"],[454,"اضحكي يا شمس وابكى يا سماء","https://www.aldiwan.net/poem61757.html","الرمل"],[465,"عرضت سماء الدجنِ زهر جنودها","https://www.aldiwan.net/poem3192.html","عموديه"],[465,"ليس على الصب المغنى جناح","https://www.aldiwan.net/poem3474.html","عموديه"],[501,"أي راح دارت به الأقداح","https://www.aldiwan.net/poem38045.html","الخفيف"],[505,"أحببت رب ملاحة لجماله","https://www.aldiwan.net/poem38412.html","الكامل"],[516,"لو كان ينفع أن تجود بمائها","https://www.aldiwan.net/poem11998.html","الكامل"],[516,"بصفات مجدك يشرف التمجيد","https://www.aldiwan.net/poem12060.html","الكامل"],[516,"عند ظباء الجهلتين ثاره","https://www.aldiwan.net/poem12110.html","الرجز"],[516,"إن حارت الأفكار كيف تقول","https://www.aldiwan.net/poem12199.html","الكامل"],[530,"وصل الدواء فدمت يارب","https://www.aldiwan.net/poem37140.html","مجزوء الكامل"],[539,"دعنى من ذكر حداة الأينق","https://www.aldiwan.net/poem47549.html","عموديه"],[554,"شغلي عن الدار أبكيها وأرثيها","https://www.aldiwan.net/poem68403.html","البسيط"],[554,"آثار أطلال برومة درس","https://www.aldiwan.net/poem68418.html","الكامل"],[559,"كل شيء كما أتى النص هالك","https://www.aldiwan.net/poem33538.html","الخفيف"],[559,"نحن الجفون نحفظ العيونا","https://www.aldiwan.net/poem33809.html","الرجز"],[568,"باكر الصبحة هذا","https://www.aldiwan.net/poem69516.html","الرمل"]],"verses":[["كافَأَت أَرضُهُ السَماءَ عَلى المُز","نِ وَأَهدَت لَها قَساطِلَ وُطفا",0,"ف",2,0],["كافَحَ المَوجَ صارَعَ الهَولَ أَبلى","كَبَلاءِ المُهَنَّدِ الصَمصامِ",1,"م",1,0],["كَافِحِ الخَصْمَ دُونَهُ وَادْرَأِ البَا","طِلَ عَنْهُ بِقُوَّةِ البُرْهَانِ",2,"ن",1,0],["كافحتم الأدواء في أيتامنا","دَأباً بغير كلالة وملال",3,"ل",1,0],["كافلُ دينِ الله سيفٌ له","لا زالَ للأمةِ محبوبا",4,"ب",2,0],["كافي الجيوش بآراءٍ مناضلةٍ","تكاد ترعد منها أنفسُ النّطف",5,"ف",1,0],["كافاك يا دولة الملك المؤيد عن","برُّ البريَّة من للفضل أعطاك",6,"ك",1,0],["كافي الممالك إن نادت براعته","أجابَ نصرتها نصباً على الحال",7,"ل",1,0],["كافي المناصب في سرٍّ ومشتهرٍ","فحبَّذا منه إسرار وإعلان",8,"ن",1,0],["كافي ملوكٍ لا يفن","نَدُ ما يُجيل وما يديرُ",9,"ر",1,0],["كافٍ كسى الناسَ طراً من فواضله","ما ليس في ثوبه ضيقٌ ولا قِصر",10,"ر",1,0],["كافي المشاهدِ لا يخورُ ولا يَني","ثبتُ السجيّةِ ليسَ فه تغوُّلُ",11,"ل",1,0],["كافرٌ بالحَيَاةِ والنُّورِ لا يُصغي","إلى الكونِ قلبُه الحجريُّ",12,"ي",1,0],["كافَأنَنا عَن شِبهِهِنَّ مِنَ المَها","فَلَهُنَّ في غَيرِ التُرابِ حَبائِلُ",13,"ل",1,0],["كافٍ إِذا أَلقى المُهِمَّ بِرَأيِهِ","بَدءً سَواءٌ عَزمُهُ وَحُسامُهُ",14,"م",2,0],["كافِيَّ كُلَّ نَآدٍ لا أَقومُ لَها","إِلّا بِعارِفَةٍ مِنهُ وَإِنعامِ",15,"م",1,0],["كافورةُ الصَّيفِ التي تحيا بها","مِنَّا النُّفُوسُ وَصِمَّةُ الشَّتَوَاتِ",16,"ت",1,0],["كافَيتِني بِذُنوبٍ لَستُ أَعرِفُها","فَسامِحي وَاِذكُري مَن لَيسَ يَسلاكِ",17,"ك",1,0],["كافورةٌ في بياضِ لونٍ","ومسكةٌ في ذكيِّ طيبِ",18,"ب",1,0],["كافٍ إِذا عَصَبَ الأُمورَ بِهِ","ماضي العَزيمَةِ جامِعُ الأَمرِ",19,"ر",1,0],["كافحوا الجهل في ثبات وعزم","قهْرُ هذا العدوِّ نصفُ النجاح",20,"ح",1,0],["كافحوا الفقر في الكنانة؛ حتى","تطردوه من منزل الفلاح",20,"ح",1,0],["كافحوا الداءَ؛ فهْو ضيفٌ ثقيلٌ","حلَّ بالزاد والنميرِ القَرَاح",20,"ح",1,0],["كَافٍ إِذَا أَلْقَى المُهِمَّ بِرَأْيهِ","بَدْءًا سَواءٌ عَزْمُهُ وحُسَامُهُ",21,"م",2,0],["كافي الكفاة المُنعم الزخار في","يَوم الفَخار المُستَجار الكاسي",22,"س",2,0],["كافر النعمة عن خب","ث لقد يلقى الصعابا",23,"ب",2,0],["كاف كن قبل كون كل مكين","نون كان الإمام للشفعاء",24,"ا",2,0],["كَأَفعالِ مَن حاوَلتَ بِالخَتلِ نَفسَهُ","فَلا زِلتَ مَغلوباً وَلا زالَ غَلاّبا",25,"ب",2,0],["كاف كساه الحسن غرة جعفر","فاهتزَّ من طرب وفاق جمالا",26,"ل",2,0],["كافحوا هذه الميول وثوبوا","طاب في هذه الليالي الكفاح",27,"ح",1,0],["كافٌ أجيدَ مطها في حسن ضمّ","حتى إذا كنا على ظهر إضم",28,"م",1,0],["كافورَةٌ في الثَّلْج مدفونَةٌ","يومَ شَمالٍ بُكْرَةٌ في جَبَلْ",29,"ل",1,1],["كافحا في طردهم أسبانيا","حينَ سادَ الليلُ واغتيلَ الضياء",30,"ا",2,0],["كافورُ جوٍ عنهُ عنبرُ نشرها","ذو ماءِ وردٍ منهُ مسكُ صعيدها",31,"د",3,0],["كافحتُ بالقنع ليليَّ وللقنعُ","وإن جلَّ ضعيفُ الطفاحْ",32,"ح",1,0],["كافحَتْنا الأشواقُ فيكمْ كِفاحاً","رُبَّما يَغلبُ الكِفاحَ الكِفاحُ",33,"ح",1,0],["كاف لعفته الشهادة أنه","متجنب بالرعب عن مياله",34,"ل",2,0],["كافي خلافتك التي نصرت بها","في كل معترك على أعدائها",35,"ا",3,0],["كافأته في أهله وجعلتهم","سبباً تفيد به الورى وتبيد",36,"د",1,0],["كاف متى تعرق به مهمة","عذراء لم يعرق لها عذاره",37,"ر",2,0],["كاف هو الباب الذي من لم يصل","منه فليس له إليك وصول",38,"ل",1,0],["كَافاكَ رَبِّيَ بالكَرَا","مَةِ في الحياةِ وَبالسَّلامَهْ",39,"ه",1,0],["كأُفعُوانٍ خلفَ صَيدِه جرَى","رامَ التِحَاقَه ولم يَلتَحِقِ",40,"ق",1,0],["كافى الإِمامُ الوَرى طُرّاً بِأَجمَعِها","وَفاقَهُم بِبُيوتِ المَجدِ يَبنيها",41,"ي",3,0],["كافَأتُ نِعمَتَها بِفَضلِ بَلائِها","ثُمَّ اِنفَرَدتُ بِمَنصِبٍ لَم يُدنَسِ",42,"س",1,0],["كافر الحق مؤمن بسواه","وسواه الطاغوت فاخطر ببالك",43,"ك",1,0],["كاف إمكاننا لها لون نور","منه حتى لاح الوجود كذلك",43,"ك",1,0],["كاف كفاية ونون نعمة","روحاً وجسماً سَلِساً موزونا",44,"ن",2,0],["كَافْتِتَاحِ حَسَنٍ زَيْ","يَنَهُ حُسْنُ خِتَامِ",45,"م",1,0]]}