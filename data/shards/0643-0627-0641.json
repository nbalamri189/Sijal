{"poems":[[53,"قل لأقنى يرمي إلى المجد طرفا","https://www.aldiwan.net/poem29971.html","الخفيف"],[86,"صفحة البرق أومضت في الغمام","https://www.aldiwan.net/poem10914.html","الخفيف"],[93,"يا ابن لبنان عد إلى لبنان","https://www.aldiwan.net/poem11175.html","الخفيف"],[88,"دار السلام تفاخرت برجال","https://www.aldiwan.net/poem44980.html","الكامل"],[72,"صب بمصر حيث أولاده","https://www.aldiwan.net/poem18275.html","السريع"],[72,"يحير الغصن بين اللين والهيف","https://www.aldiwan.net/poem19267.html","البسيط"],[72,"لثمت ثغر عذولي حين سماك","https://www.aldiwan.net/poem19438.html","البسيط"],[72,"عيد يعود إلى هذا الثنا العالي","https://www.aldiwan.net/poem19474.html","البسيط"],[72,"حاشا لوعدك أن يلويه نسيان","https://www.aldiwan.net/poem20287.html","البسيط"],[51,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[51,"لا يغضبن لعمرو من له خطر","https://www.aldiwan.net/poem62965.html","البسيط"],[51,"وقفات رأيك في الخطوب تأمل","https://www.aldiwan.net/poem65996.html","الكامل"],[92,"أين يا شعب قلبك الخافق الحساس","https://www.aldiwan.net/poem38915.html","الخفيف"],[43,"لك يا منازل في القلوب منازل","https://www.aldiwan.net/poem10130.html","الكامل"],[45,"عهدي بربعك مثلا آرامه","https://www.aldiwan.net/poem65681.html","الكامل"],[45,"نصيب عينيك من سح وتسجام","https://www.aldiwan.net/poem66640.html","البسيط"],[61,"إني هديت لنعمة مكنونة","https://www.aldiwan.net/poem51755.html","الكامل"],[66,"كفي القتال وفكي قيد أسراك","https://www.aldiwan.net/poem38480.html","البسيط"],[80,"زارت على الخوف من رقيب","https://www.aldiwan.net/poem31574.html","مخلع البسيط"],[48,"لم تدر جارتنا ولا تدري","https://www.aldiwan.net/poem63376.html","الكامل"],[106,"حرب الأعداء الثلاثة","https://www.poetsgate.com/ViewPoem.aspx?id=179643",""],[45,"عَهْدِي بِرَبْعِكَ مُثَّلاً آرَامُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=32042",""]],"verses":[["كافَأَت أَرضُهُ السَماءَ عَلى المُز","نِ وَأَهدَت لَها قَساطِلَ وُطفا",0,"ف",2,0],["كافَحَ المَوجَ صارَعَ الهَولَ أَبلى","كَبَلاءِ المُهَنَّدِ الصَمصامِ",1,"م",1,0],["كَافِحِ الخَصْمَ دُونَهُ وَادْرَأِ البَا","طِلَ عَنْهُ بِقُوَّةِ البُرْهَانِ",2,"ن",1,0],["كافحتم الأدواء في أيتامنا","دَأباً بغير كلالة وملال",3,"ل",1,0],["كافلُ دينِ الله سيفٌ له","لا زالَ للأمةِ محبوبا",4,"ب",2,0],["كافي الجيوش بآراءٍ مناضلةٍ","تكاد ترعد منها أنفسُ النّطف",5,"ف",1,0],["كافاك يا دولة الملك المؤيد عن","برُّ البريَّة من للفضل أعطاك",6,"ك",1,0],["كافي الممالك إن نادت براعته","أجابَ نصرتها نصباً على الحال",7,"ل",1,0],["كافي المناصب في سرٍّ ومشتهرٍ","فحبَّذا منه إسرار وإعلان",8,"ن",1,0],["كافي ملوكٍ لا يفن","نَدُ ما يُجيل وما يديرُ",9,"ر",1,0],["كافٍ كسى الناسَ طراً من فواضله","ما ليس في ثوبه ضيقٌ ولا قِصر",10,"ر",1,0],["كافي المشاهدِ لا يخورُ ولا يَني","ثبتُ السجيّةِ ليسَ فه تغوُّلُ",11,"ل",1,0],["كافرٌ بالحَيَاةِ والنُّورِ لا يُصغي","إلى الكونِ قلبُه الحجريُّ",12,"ي",1,0],["كافَأنَنا عَن شِبهِهِنَّ مِنَ المَها","فَلَهُنَّ في غَيرِ التُرابِ حَبائِلُ",13,"ل",1,0],["كافٍ إِذا أَلقى المُهِمَّ بِرَأيِهِ","بَدءً سَواءٌ عَزمُهُ وَحُسامُهُ",14,"م",2,0],["كافِيَّ كُلَّ نَآدٍ لا أَقومُ لَها","إِلّا بِعارِفَةٍ مِنهُ وَإِنعامِ",15,"م",1,0],["كافورةُ الصَّيفِ التي تحيا بها","مِنَّا النُّفُوسُ وَصِمَّةُ الشَّتَوَاتِ",16,"ت",1,0],["كافَيتِني بِذُنوبٍ لَستُ أَعرِفُها","فَسامِحي وَاِذكُري مَن لَيسَ يَسلاكِ",17,"ك",1,0],["كافورةٌ في بياضِ لونٍ","ومسكةٌ في ذكيِّ طيبِ",18,"ب",1,0],["كافٍ إِذا عَصَبَ الأُمورَ بِهِ","ماضي العَزيمَةِ جامِعُ الأَمرِ",19,"ر",1,0],["كافحوا الجهل في ثبات وعزم","قهْرُ هذا العدوِّ نصفُ النجاح",20,"ح",1,0],["كافحوا الفقر في الكنانة؛ حتى","تطردوه من منزل الفلاح",20,"ح",1,0],["كافحوا الداءَ؛ فهْو ضيفٌ ثقيلٌ","حلَّ بالزاد والنميرِ القَرَاح",20,"ح",1,0],["كَافٍ إِذَا أَلْقَى المُهِمَّ بِرَأْيهِ","بَدْءًا سَواءٌ عَزْمُهُ وحُسَامُهُ",21,"م",2,0]]}