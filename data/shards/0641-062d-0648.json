{"poems":[[55,"ضربن إلينا خدودا وساما","https://www.aldiwan.net/poem29807.html","المتقارب"],[55,"نغالب ثم تغلبنا الليالي","https://www.aldiwan.net/poem29886.html","الوافر"],[55,"ألا يا لقومي للخطوب الطوارق","https://www.aldiwan.net/poem29952.html","الطويل"],[55,"نزوت نزاء الجندب الجون ضلة","https://www.aldiwan.net/poem30696.html","الطويل"],[79,"أنتم من مناسب الأمجاد","https://www.aldiwan.net/poem36605.html","الخفيف"],[32,"خليلي عوجا عوجة","https://www.aldiwan.net/poem29570.html","الطويل"],[53,"يا من زكا جهره وإسراره","https://www.aldiwan.net/poem62944.html","المنسرح"],[93,"تركت النجم مثلك مستهاما","https://www.aldiwan.net/poem62741.html","عموديه"],[47,"حلفت لها بالله يوم التفرق","https://www.aldiwan.net/poem65186.html","الطويل"],[99,"أمير الفضل فضلك بيت شعرٍ","https://www.aldiwan.net/poem24968.html","الوافر"],[46,"فحواك عين على نجواك يا مذل","https://www.aldiwan.net/poem30389.html","البسيط"],[46,"ما عهدنا كذا نحيب المشوق","https://www.aldiwan.net/poem30395.html","الخفيف"],[33,"وإني لسائل أم الربيع","https://www.aldiwan.net/poem42228.html","المتقارب"],[48,"لا تكرموا جسدي إذا ما حل بي","https://www.aldiwan.net/poem22495.html","الكامل"],[111,"أبا الحارث اسمع حديثا جرى","https://www.poetsgate.com/ViewPoem.aspx?id=527",""],[45,"ما أجدر الأيام والليالي","https://www.poetsgate.com/ViewPoem.aspx?id=77",""],[47,"أبُكَاءً في الدّارِ، بَعْدَ الدّارِ","https://www.poetsgate.com/ViewPoem.aspx?id=31284",""],[47,"حَلَفْتُ لهَا بالله، يَوْمَ التّفَرّقِ","https://www.poetsgate.com/ViewPoem.aspx?id=33106",""],[119,"اطلت بالوجنا السرى فمدارها","https://www.aldiwan.net/poem41096.html","عموديه"],[147,"هو ذاك ربع المالكية فاربع","https://www.aldiwan.net/poem11770.html","الكامل"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[240,"يا صلاح الدين خذ حذ","https://www.aldiwan.net/poem31807.html","مجزوء الرمل"],[240,"آه للبرق أضاءا","https://www.aldiwan.net/poem32197.html","مجزوء الرمل"],[275,"رأيت الشرق ملكا للنبي","https://www.aldiwan.net/poem35655.html","الوافر"],[276,"رد بالمطي موارد الغزلان","https://www.aldiwan.net/poem52069.html","الكامل"],[302,"تفديك لو قبل المنون فداها","https://www.aldiwan.net/poem33083.html","الكامل"],[369,"خيالك من قبل الكرى طارقي ذكرا","https://www.aldiwan.net/poem60916.html","الطويل"],[395,"ألم تر أن جيرتنا استقلوا","https://www.aldiwan.net/poem1927.html","الرمل"],[445,"قد الخيل والخير بأسا وجودا","https://www.aldiwan.net/poem34850.html","المتقارب"],[445,"قل للخلافة قد بلغت مناك","https://www.aldiwan.net/poem34895.html","الكامل"],[447,"أعد نظراً في السرب بالرمل من حزوي","https://www.aldiwan.net/poem14343.html","الطويل"],[454,"إلى هيئة الأمم المتحدة","https://www.aldiwan.net/poem989.html",""],[456,"اهل افغانستان","https://www.aldiwan.net/poem23875.html","الطويل"],[463,"كم النوى قد جزع الصابر","https://www.aldiwan.net/poem56172.html","السريع"],[469,"هي ظبية الوادي وعين لداتها","https://www.aldiwan.net/poem3345.html","عموديه"],[473,"حث الكؤوس فكل هم","https://www.aldiwan.net/poem60482.html","مجزوء الكامل"],[480,"عرفت بأجدث فنعاف عرق","https://www.aldiwan.net/poem1823.html","الوافر"],[548,"أشجاك الربع أقوى والديار","https://www.aldiwan.net/poem1762.html","الرمل"],[556,"كم ذا نخيب وتكذب الأطماع","https://www.aldiwan.net/poem47724.html","الكامل"],[563,"أنا النور المبين","https://www.aldiwan.net/poem33818.html","مجزوء الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122779","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63858","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62685","الرمل"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119370","الخفيف"],[1056,"","https://poetry.dctabudhabi.ae/diwan/poem/178040","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72314","الخفيف"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25345","الرجز"],[1138,"","https://poetry.dctabudhabi.ae/diwan/poem/100619","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112808","الوافر"],[1419,"","https://poetry.dctabudhabi.ae/diwan/poem/116686","الوافر"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79984","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/78011","الكامل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109317","الوافر"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77293","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87327","الرجز"],[2705,"","https://poetry.dctabudhabi.ae/diwan/poem/128651","السريع"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65941","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65974","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65991","الطويل"],[3009,"","https://poetry.dctabudhabi.ae/diwan/poem/102352","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68006","الرجز"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62992","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109994","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69938","الوافر"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97098","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45063","الرمل"],[4325,"","https://poetry.dctabudhabi.ae/diwan/poem/29467","الطويل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133186","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58122","المتقارب"],[4657,"","https://poetry.dctabudhabi.ae/diwan/poem/140148",""],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52130","الطويل"],[4679,"أما لأبي البرية أن يعادا","https://www.poetsgate.com/ViewPoem.aspx?id=142720",""],[4882,"اجبني فحتى الماء فجره الصخرُ_بهاء الدين الخاقاني","https://www.poetsgate.com/ViewPoem.aspx?id=7332",""],[4927,"أبناء السحالي","https://www.poetsgate.com/ViewPoem.aspx?id=80797",""],[4978,"يفْحَصُ العِنَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=177699",""],[5101,"شموع ليلة الميلاد","https://www.poetsgate.com/ViewPoem.aspx?id=204585",""],[5112,"من يرد؟","https://www.poetsgate.com/ViewPoem.aspx?id=213045",""],[5183,"أَلْطَّاغُوتْ","https://www.poetsgate.com/ViewPoem.aspx?id=186459",""],[5431,"أحبك هائماً للحب تركعْ","https://www.poetsgate.com/ViewPoem.aspx?id=183299",""],[5431,"قبلته...","https://www.poetsgate.com/ViewPoem.aspx?id=200620",""],[5431,"على لسان حواء...","https://www.poetsgate.com/ViewPoem.aspx?id=208756",""],[5829,"جنة الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=151690",""],[6093,"عصيان","https://www.poetsgate.com/ViewPoem.aspx?id=198857",""],[6093,"حوار مطرقة","https://www.poetsgate.com/ViewPoem.aspx?id=204052",""],[5377,"حراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79568&r=&rc=24",""],[6213,"أرض ونجوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76296&r=&rc=44",""],[6225,"مهندس زراعي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80901&r=&rc=170",""],[463,"كمِ النّوى قدْ جزعَ الصَّابرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60086&r=&rc=142",""]],"verses":[["فَحوزوا العَقائِلَ عَن خاطِري","إِلى ما أُماطِلُ عَنها إِلى ما",0,"م",2,0],["فُحولُ المَجدِ جَعجَعَها المَنايا","وَأَسلَمَها الزِمامُ إِلى العِقالِ",1,"ل",1,0],["فُحولٌ أَطَلنَ الهَدرَ وَالخَطرَ بِالقَنا","ضَوارِبُ لِلأَذقانِ مَيلُ الشَقائِقِ",2,"ق",1,0],["فَحَولَ مَعَدٍّ مُنجِبونَ وَأَنتُمُ","نِزالَةُ فَحلٍ مِنهُمُ غَيرِ مُنجِبِ",3,"ب",1,0],["فحُوارٌ ترْغو ونارٌ تلَظّى","وطُهاةٌ تَشي ودَاعٍ يُنادي",4,"د",2,0],["فَحَوَّمنَ وَاِستَنفَضنَ مِن كُلِّ جانِبٍ","وَبَصبَصنَ بِالأَذنابِ حَولَ الشَرائِعِ",5,"ع",1,0],["فحواه بشراه حين تسألهُ","وحلمهُ إن عثرتَ إنذاره",6,"ر",2,0],["فَحَوَّلَتِ القُنوطَ إِلى رَجاءٍ","وَصَيَّرَتِ الوَنى فينا اِعتِزاما",7,"م",2,0],["فَحَولَهُمُ مِن نُصحِهِ وَدِفاعِهِ","تَكَهَّفُ طَودٍ بِالخِلافَةِ مُحدِقِ",8,"ق",1,0],["فحولك حيثما تمشي وتسعى","قصيدٌ عامر غمر الربوعا",9,"ع",2,0],["فَحواكَ عَينٌ عَلى نَجواكَ يا مَذِلُ","حَتّامَ لا يَتَقَضّى قَولُكَ الخَطِلُ",10,"ل",1,1],["فَحَوى سوقَها وَغادَرَ فيها","سوقَ مَوتٍ طَمَت عَلى كُلِّ سوقِ",11,"ق",1,0],["فَحوراً كَمِثلِ ظِباءِ الخَري","فِ أُخرِجنَ يَمشينَ مَشياً قَطوفا",12,"ف",2,0],["فَحَوادِثُ الأَيّامِ غَيرُ تَوارِكٍ","نَسرَ النُجومِ وَلا السَمّاكَ وَلا الأَسَد",13,"د",1,0],["فحول عن وجهنا وجهه","وجملة نحو واعرابها",14,"ب",3,0],["فُحولُها وَالعُوذُ وَالمَتالي","تَوَدُّ لَو يُتحِفُها بِوالي",15,"ل",2,0],["فَحَوَتْهُ الرّماحُ أغيَدَ، مَجدو","لاً، قَصِيرَ الزُّنّارِ، وَافي الإزَارِ",16,"ر",1,0],["فَحَوْلَهُمُ مِنْ نَضْحِهِ وَدِفَاعِهِ","تَكَهُّفُ طَوْدٍ بالخِلاَفَةِ مُحْدِقِ",17,"ق",1,0],["فحوزه الاقبال من قبولها","وطوله الاثير من آثارها",18,"ر",3,0],["فَحَوَيتُ ما لَم يَجرِ في خَلَدِ المُنى","مِن سَيبِهِ وَحَصَدتُ ما لَم أَزرَعِ",19,"ع",1,0],["فَحَوى العُلومَ وَكانَ طَوراً راسِخاً","فيها وَأَمعَنَ غايَةَ الإِمعانِ",20,"ن",1,0],["فَحَواها بِخِداعٍ","وَرِياءٍ وَنِفاقِ",21,"ق",1,0],["فَحَوى السَبقَ عَلى رِس","لٍ وَفاتَ الرُسَلاءا",22,"ا",3,0],["فَحولَ الكعبةِ العُظمى نجومٌ","تطالِعُكُم من الليلِ الدجي",23,"ي",1,0],["فَحوى فَخارهما وَطالَ هداهما","شرفا فنعم النجم وَالقمران",24,"ن",1,0],["فحويتَها وَالعمرُ مُقتَبل الصِبا","واهاً لهمَّتك العليَّة واها",25,"ا",3,0],["فحَولاءُ عَوراءُ يَظَلُّ حِسابُها","لوِتْرِ الورَى شَفْعاً وشَفْعِهمُ وِترا",26,"ر",2,0],["فَحَوَّطَ عَن بَني عَمرُو بنَ عَوفٍ","وَأَفناءُ العُمورِ بِها شَفيقُ",27,"ق",1,0],["فَحَوَّلْتَ منها اللُّهى والخيولَ","وعَبَّدْتَ منها المَها والعَبِيدا",28,"د",2,0],["فَحَوى الخلافةَ والسناءَ وليُّهُ","رَغْماً لكلِّ مُعاندٍ أَفَّاكِ",29,"ك",1,0],["فحولك من أبناء ازدٍ شنوءة","أسود إذا سيموا الوغى كلهم ألوى",30,"و",2,0],["فحوّلتها سياسات القوي إلى","من ليس يعبأة بالأخلاق والقيم",31,"م",1,0],["فحُول يكيدون العدو بقهره","يصدون بغي العابثين المقفزِ",32,"ز",1,0],["فَحُوِّلا في عَطَنٍ واسع","يذرَعُ فيه الأملُ الشابرُ",33,"ر",1,0],["فحوت غصون ألبان في أنقائها","وسبت بدور التمّ في هالاتها",34,"ت",3,0],["فَحَوادِثُ الأَيّامِ ما","لِلمَرءِ عَنها مَذهَبُ",35,"ب",1,0],["فُحورٍ قَد لَهَوتُ بِهِنَّ وَحدي","نَواعِمَ في المُروطِ وَفي الرِياطِ",36,"ط",1,0],["فَحَوَينا دونَكُم أَرساننا","وَتَرَكنا النَهبَ يَحويهِ الخُشارُ",37,"ر",1,0],["فحوائمٌ لا تَرْتَوِي وعواطلٌ","لا تَحْتَلي وزخارفٌ وخداعُ",38,"ع",1,0],["فحوِّل عن طريقي","وأمري يا لعين",39,"ن",1,0],["فحوَى كَلامِكِ بِالنَّوى وَكَلامِهِ","شَكوَى سِقامِكِ بِالهَوَى وَسِقامِهِ",40,"م",2,1],["فحوزا راشِدَيْنِ ذمامَ ودّي","فمثلُ ذمامِ وُدِّي لن تحوزا",41,"ز",2,0],["فحواه بكتاب فاخر","من لباب النحو علم الجمل",42,"ل",1,0],["فحوت إرثها الكبيرة ثمنا","غير بخس من كل عرضٍ وعين",43,"ن",1,0],["فحوى خلافتهم ولم يظلم بها","القرم قرم بني قصي الأنزع",44,"ع",1,0],["فحوى من عكا وانطرطوس","عدة لم يحط بها التحصيل",45,"ل",1,0],["فُحُولَهمْ وَالآخَرِينَ الدَرْدَقا","مِنِّي إِذَا شَاؤُوا حِداء مِسْوَقا",46,"ق",2,0],["فحواهُ اني بتُّ عن","ذاك الحبيب مشرَّدا",47,"د",2,0],["فحول القوم عنها في قصور","ولكني أزين بها نظامي",48,"م",2,0],["فحُوبُهما يشَبَّهُ نَسل حَامٍ","وأُمُّهُمُ تَشَبَّهُ بِالمَوالِي",49,"ل",2,0],["فحوى جميعَ خصالهم","إلاَّ الإِمامة والنبوَّه",50,"و",2,0],["فحواه يا من طال عنا صبره","ما مثل ذلك تصنع الأحباب",51,"ب",1,0],["فحول العرب أبطال المغازى","حُماة العرض حراس الضعائن",52,"ن",1,0],["فَحَولي جَوقٌ صادِحٌ مِن بَلابِل","وَأَلوانُ وَردٍ ضاحِكٍ بِالنَدى رَفّا",53,"ف",2,0],["فَحَولَهَا مَنَاقِعٌ وَالمَا تَرى","خَمسينَ حَولَهَا بِلا مِرَا",54,"ر",2,0],["فحولُ مدحٍ حكمَت لفظها","نظامَها بالسحرِ فلتمزجِ",55,"ج",1,0],["فحولك كهلان وحولك حمير","خلائف قحطان من كل منهج",56,"ج",1,0],["فحولك من رعي ونوح قبائل","إذا رعتهم سلوا رقاق البواتك",57,"ك",1,0],["فحول أبي الفضل الغداة وحولنا","قبائل من قحطان شم الخراطم",58,"م",1,0],["فحوصر في دار الإمارة بائياً","بذلٍّ وإِرغامٍ له وخضوع",59,"ع",1,0],["فحولَها كم سائلٍ ومُجْتَدٍ","عن مَدَدٍ أَوْ واردٍ مُسترفِد",60,"د",1,0],["فحويتَ مضِمارَ العلا","وجريتَ فيه بلا مُجَارِ",61,"ر",1,0],["فحوَّاءُ لن ندعو بها ابنةَ آدمٍ","وإِن صَدَرَت منهُ بما أُخِذَت ضِلعا",62,"ع",2,0],["فَحَولَ سَفائِهِم يُذبَحونا","وَللذَودِ عَنهُنَّ لا يَنهَضونا",63,"ن",2,0],["فَحوَّلَها بِسَطوَتِهِ رَماداً","فَسموهُ بكسّارِ النِصالِ",64,"ل",1,0],["فحوى أبو الفضل المثير قتامها","قصبات سبقتها وبذر هانها",65,"ن",3,0],["فَحَوى الدارَينِ يا طوبى لَهُ","وَبِذا تَسلو عَنِ الخَطبِ الأَليم",66,"م",1,0],["فَحَولِيَّةٌ مِثلُ القَنَاةِ يَرُدُّها","رِ