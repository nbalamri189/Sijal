ViewPoem.aspx?id=25885",""],[5309,"يتمنعن وهن الراغبات","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573959",""],[6237,"وحشة قلب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77896&r=&rc=38",""],[6324,"لا تسل عن أرقي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87946&r=&rc=11",""]],"verses":[["يا لَقَومي لِهَذِهِ الصَيلَمِ الصَ","ماءِ عَنَّت وَالنازِلِ الأَروَنانِ",0,"ن",1,0],["يا لَقَلْبي كلّما هبّتْ صَبا","شفّهُ الوجْدُ لأيّامِ صِباهُ",1,"ا",2,0],["يَا لِقَوْمِي مِنْ ذِكْرِ تِلْكَ الْمَغَانِي","ما لِقَلْبِي يَهْوَى إِلا هَيْنِ مَا لَهْ",2,"ل",2,0],["يا لَقَيسٍ لِما لَقينا العاما","أَلِعَبدٍ أَعراضُنا أَم عَلى ما",3,"م",2,1],["يا لِقَومي إِنَّني رَجُلٌ","أَفنَتِ الأَيّامُ مُصطَبَري",4,"ر",2,0],["يا لَقَومي إِنَّني رَجُلٌ","حِرتُ في أَمري وَفي زَمَني",5,"ن",2,0],["يا لَقَومي وَلِقَومي قُوَّةٌ","لِوَقيذٍ قَتَلَتهُ الحَدَقُ",6,"ق",1,0],["يا لَقَومي لَحَبلِكَ المَصرومِ","يَومَ شَوطى وَأَنتَ غَيرُ مُليمِ",7,"م",1,1],["يَا لَقَوْمِي إِنَّا إِذَا مَا تَوَاصَيْ","نَا بِصَبْرٍ فَالخَطْبُ خَطْبٌ عَمِيمُ",8,"م",1,0],["يَا لَقَوْمِي مَاتَ الشُّجَاعُ الَّذِي كَا","نَ يُفَدَى حِمَاهُ وَهْوَ مَضِيمُ",8,"م",1,0],["يَا لَقَوْمِي هَلْ خِلْتُمُ الشَّرْقَ عَفْواً","قَدْ دَهَاهُ التَّشْتِيتُ وَالتَّقْسِيمُ",9,"م",1,0],["يا لَقَومِي لِكَثرةِ العُذَّالِ","وَلِطَيفٍ سَرَى مَليحِ الدَّلالِ",10,"ل",1,1],["يا لَقَومي هَل يَقتُلُ المَرءَ مِثلي","واهِنُ البَطشِ وَالعِظامِ سَؤومُ",11,"م",1,0],["يا لقلبٍ مودعٍ سرّ الأسى","ودّع الصبّ وماذا أوْدَعه",12,"ع",2,0],["يا لَقَوْمٍ أأثقلَ الأرضَ شخصي","أم شكْت من جفاءِ خَلقي امْتِلاءَ",13,"ا",2,0],["يا لقومٍ لأحمد بن بُنانٍ","ولما قال من عجيب المقالِ",14,"ل",1,1],["يا لقومٍ لأُنسه وهداهُ","بين تلك المهامِه الأغفالِ",15,"ل",1,0],["يا لِقَومي بَلَغَ السَيلُ الذُبى","وَاِستَطالَ البَغي وَاِستَشرى الفَساد",16,"د",1,0],["يا لِقَومي ما إِن وَجَدتُ مِنَ الخَط","بِ مَحيداً وَلا عَليهِ اِنتِصارا",17,"ر",2,0],["يا لَقَومي لِلَوعَةِ البَلبالِ","وَلِقَتلِ الكُماةِ وَالأَبطالِ",18,"ل",1,0],["يا لِقَومي وَكَيفَ صَبرِيَ عَمَّن","لا تَرى النَفسُ طيبَ عَيشٍ سِواهُ",19,"ا",2,0],["يا لقومي أَغرَقَتْهم دِيَمٌ","للمنايا الحُمرِ تحدو دِيَما",20,"م",2,0],["يا لِقَومي لِلثَكالى شَفَّها","إِذ مَضى أَبناؤُها طولُ الرَنينْ",21,"ن",1,0],["يا لِقَومي لِليَتامى بَعدَهُم","وَالأَيامى وَالشُيوخِ الهامِدينْ",21,"ن",1,0],["يا لِقَومي جاهِدوا لا تَهنوا","وَسَيَأتي اللَهُ بِالنَصرِ المُبينْ",21,"ن",1,0],["يا لَقَومي لِطُولِ هَذا العِتاب","وَلِصَبري عَلى الهَوى وَاِجتِنابي",22,"ب",2,1],["يا لَقَومٍ لِلحَبيبِ المُذَّكَر","وَخَيالٍ زارَني قَبلَ السَحَر",23,"ر",1,1],["يا لَقَومٍ لِلزائِرِ المُنتابِ","وَلِما قَد لَقيتُ حينَ المَتابِ",24,"ب",1,1],["يا لقلوب خفقت","بالخوف بين الأضلع",25,"ع",1,0],["يا لِقَلْبٍ تَجَرّعَ اللَّوعةَ المُرَّ","ةَ من جدولِ الزَّمانِ الرَّهيبِ",26,"ب",1,0],["يَا لَقَوْمِي مِثَالُ أَنْطونَ لَوْ صَوَّ","رْتُهُ لَمْ يُحِطْ بِه التَّصوِيرُ",27,"ر",1,0],["يا لِقَومي وَقَومي","جَرَّعوني السِماما",28,"م",2,0],["يا لقومي والأسى كل الأسى","ان جرى النيل على هذا القدر",29,"ر",1,0],["يا لقومٍ لجوده كيف يَبني","وهو سيلٌ وكلُّ سيل معفِّي",30,"ف",2,0],["يَا لَقَوْمٍ، وَكَيْفَ صَبْرِي عَنْ مَنْ","لا ترى النفسُ طيبَ عيشٍ سواه؟",31,"ا",2,0],["يا لقومي أتلفت عمري فيها","ولقد كنت قبل ذاك نجيا",32,"ي",2,0],["يا لقمة الخبز التي","إشقت بحاجتها الأَنام",33,"م",1,0],["يا لقَومي لَقَد بَغى العَبدُ موسى","وَالعَسيفُ المُدَفَّعُ العُضروطُ",34,"ط",1,0],["يا لَقومي ما أَراكُم حسَناً","بَيعَنا بِالبَخسِ في سوقِ الكَسادِ",35,"د",1,0],["يا لقومٍ هاجوا هدير القوافي","وتضاغَوا إذ راعهم منه ثارُ",36,"ر",1,0],["يا لقومي من للفتى من فتاة","مزجت كأس صدها بالملاله",37,"ل",2,0],["يا لقومي ما للعذول ومضنى","بذل الروح في هواها ومالة",37,"ل",2,0],["يالقومي من رشا غنج","تائه بالعجب والصلف",38,"ف",1,0],["يالقومي من حبيب فارغ","بخلالي لم يزل مشتغلا",39,"ل",2,0],["يا لقومي أنا من فَق","رِيَ في أنحَسِ حاله",40,"ل",2,1],["يَا لَقَوْمٍ ضُرِّجوا في ضَارج","بالعُيونِ النجْلِ فِيمَن ضُرِّجا",41,"ج",2,0],["يا لقَومي ماذا مِنَ الوَجدِ أَلقى","فَاِندُبوني وَاِبكوا عَلَيَّ وَنوحُوا",42,"ح",3,0],["يا لقَومي أَيذهبُ في الحُب","بِ دَمي باطِلاً وَجرحي جُبارا",43,"ر",2,0],["يا لقومي من سطوة الترك سلوا","بيض أسيافهم لحز النحور",44,"ر",1,1],["يا لقومي سألتكم خبروني","هكذا كل من أحب حبيبه",45,"ه",1,1],["يا لقَومٍ لأُناسٍ رُذَّلٍ","جَمَعوا الجَمعَ لِأَهلِ الحَرَمَين",46,"ن",1,0],["يا لقومي لحر صدري وعولي","وغليلي وقلبي المعمود",47,"د",1,0],["يا لِقَومي بَشَّروا الشورى بِهِ","وَاِرقُبوا أَقرَبَ خَيرٍ يَنتَظِر",48,"ر",1,0],["يا لقلب طواه في صدره الرح","ب قوى الرجاء والخفقات",49,"ت",1,0],["يا لقبر حواه لم يحو إلّا","جسدا لا يعدّ في الهامدات",49,"ت",1,0],["يا لقصرى إذ عربد الريح في الجوّ","وشقّت لساكنيه القبور",50,"ر",1,0],["يا لقلبي من ذكريات الأماني","الأماني العذاب في نيسان",51,"ن",1,1],["يِالقَومى من مُنصِفي مِن حَبيب","يمكث الشَهر لا أَراه وَأَكثر",52,"ر",1,1],["يا لقومي وكلّ آية عذر","تعذر المستهام من أنْ يُلاما",53,"ا",1,0],["يا لقومٍ أرهبوا أو أرغبوا","من كرامٍ بحسامٍ أو حطام",54,"م",1,0],["يا لقومي من مشيرٍ بدمي","من دم طُلّ بألحاظ الدُّمى",55,"م",2,0],["يا لقومي من ذات تيهٍ سبتني","بالتجني وليس تنصف خلا",56,"ل",2,0],["يا لقومي من منجدي من مهاة","ذات نهد يهدّ طود احتمالي",57,"ل",2,0],["يا لقومي أَتبعوا في","قَصدهم روحي وَجِسمي",58,"م",2,0],["يالقومي ذل من ليس له","في البرايا للرزايا من نصير",59,"ر",1,0],["يا لقَلبٍ إِلى الهوى يتداعى","فهو لا مُخْلِفٌ ولا متعاصِي",60,"ص",2,1],["يا لَقومٍ إذ يقتلون عليّاً","وهو للمَحْل فيهمُ قَتّالُ",61,"ل",1,0],["يا لقومي من نزار غارةً","تخلطُ القوم بريئاً بسقيم",62,"م",1,0],["يا لقومي من تيميٍ دعْوةً","لكثير الوتْرِ موفور الأحَنْ",63,"ن",1,1],["يا لقبي من نغمة الأوتار","وصنوف الريحان والأزهار",64,"ر",1,1],["يا لقلبي وقد أقام فريقٌ","ليلةَ النَّعف واستقلَّ فريق",65,"ق",1,0],["يا لقومي حملتْ ثقل دمي","غادةٌ يثقلها حملُ الحلي",66,"ل",2,0],["يا لِقَومي أَما لِقَتليَ ثارُ","ما لَكُم لَيسَ فيكُمُ لِي اِنتِصارُ",67,"ر",1,1],["يا لَقَومي مِن حنينٍ زادَني","سَقَماً منه وما نلتُ مراما",68,"م",2,0],["يا لقلبٍ تعوَّد الحنَّ الأَ","نَّ وفي ذين جيدٌ إدمانه",69,"ن",2,0],["يا لقيد إطلاقه غير خافٍ","وفراقٍ مطلسمِ في تلاقِ",70,"ق",1,0],["يا لقلبٍ منهُ مُضْنًى","يا لعينٍ في عَماءِ",71,"ا",2,0],["يا لَقَوْمِي وَه