035,"","https://poetry.dctabudhabi.ae/diwan/poem/86356","الرمل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90903","الرمل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136674",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120415","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120287","الخفيف"],[4578,"ما عقودٌ في طلى الغيد الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=49380",""],[5187,"عيد الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=33005",""],[5187,"ضحايا بين الألم","https://www.poetsgate.com/ViewPoem.aspx?id=29258",""],[5436,"السفر الى ضفاف الرافدين (محمود محمد أسد )","https://www.poetsgate.com/ViewPoem.aspx?id=58602",""],[5628,"المرأة الساحرة","https://www.poetsgate.com/ViewPoem.aspx?id=179898",""],[4623,"ما ثنائي عليك إلا يسير ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146774",""],[5873,"اِزدهار الحب","https://www.poetsgate.com/ViewPoem.aspx?id=215410",""],[161,"بين الأرض والسماء حياة","https://www.poetsgate.com/ViewPoem.aspx?id=202596",""],[6105,"قد كسر المشمش قلبِي وَلم","https://www.poetsgate.com/ViewPoem.aspx?id=190383",""],[6206,"...رقَّ ثَوْبُ الدُّجى وطاب الهواءُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27259&r=&rc=0",""]],"verses":[["قَد كَسا الكَرنَكُ مِصراً ما كَسا","مِن سَنىً أَبلى اللَيالي وَسَناء",0,"ا",2,0],["قَد كَسانا مِن كِسوَةِ الصَيفِ خِرَقٌ","مُكتَسٍ مِن مَكارِمٍ وَمَساعِ",1,"ع",1,1],["قدْ كسدَ الشعرُ فيا أهلَهُ","بشراكمُ إذْ ذاكَ بالعافيهْ",2,"ي",2,1],["قَد كَسَرَ الشِعرَ واواتٍ وَنَضَّدَهُ","فَوقَ الجَبينِ وَرَدَّ الصُدغَ بِالفاءِ",3,"ا",2,0],["قَد كَساني خَزّاً وَأَخدَمني الحو","رَ وَخَلّى بُنَيَّتي في الحُلاءِ",4,"ا",2,0],["قد كسَتهُ الطروسُ ثوبَ فَخَارٍ","وكساها من فنِّه ألوانا",5,"ن",2,0],["قد كسَد الفضلُ به فما تَرى","في سوقِه للفضل عِلْقا نافقا",6,"ق",2,0],["قَد كَستهُ القلوبُ والأعينُ الحو","رُ لِباساً به يروق اِكتساءُ",7,"ا",2,0],["قد كساها علاك ثوب فخار","وعرت من زخارف وسخاف",8,"ف",1,0],["قد كسيت بترون منه سناً","أفضل ما يكسى وما يكسب",9,"ب",1,0],["قَد كَساه الإله ثَوب وقار","وَفَخار فَما اِزدَهته اِختياله",10,"ل",2,0],["قد كساني الصدود ثوب سقامٍ","ومنعني المنام خوف وعيدك",11,"ك",1,0],["قد كساها البشير ثوب فخارٍ","صيغ من جوهرٍ بدر البنان",12,"ن",1,0],["قد كسوت العلياءَ مجداً كريماً","وسقيت البطاح صافي السحائب",13,"ب",1,0],["قد كساها اللَه أثواب البها","بجمال وحباها كل جود",14,"د",1,0],["قَد كَساهُ الجَمالُ مِنهُ رِداءً","لَيسَ فيهِ صَنيفَةٌ مِن جَميلِ",15,"ل",1,0],["قد كسا أحمد الرجال الرفاعي","من نسيج الكساء مِرصاً سنيّا",16,"ي",2,0],["قَدْ كَساني لباسَ سُقْمِ وذله","حبُ غَيْدَاءَ بالجْمال مُدله",17,"ل",2,1],["قد كستها الدهورُ أرديةَ الرّقْ","قَةِ حتى جفا عليها الهواءُ",18,"ا",2,0],["قد كَسَر الْجفْنَ فَطارَ الحَشَا","مَا أَفْتَكَ الْكَاسِرَ بالطَّائِر",19,"ر",1,0],["قد كَساهُ الإِلهُ نوراً ولكنْ","هو في نصرِ دينه قد تَجَرَّد",20,"د",1,0],["قد كساك الغبار منه رداء","فوق صُدغ وجفن طرف كحيلِ",21,"ل",1,0],["قَد كَسَتها كفّ الجلالة برداً","مِن جلال فجلّ مَن قد كَساها",22,"ا",3,0],["قَد كَسَتني بحلّةِ الأَوصابِ","مَنْ تَحَلَّتْ بِحلَةِ الإعجابِ",23,"ب",1,1],["قد كسى الديباج جلداً اجربا","وحبا بالتاج رأساً اصلعا",24,"ع",2,0],["قد كسدت آدابه والشعر","فما له عند البرايا قدر",25,"ر",1,0],["قد كساها ابنُ أحمد الشهمُ حُسناً","فبه السيب قد علت في قراها",26,"ا",3,0],["قَد كَسَّرَت كِسرى العِراقِ فَلَم","يَخفُق لَهُ مِنها جَناحٌ خَفوق",27,"ق",1,0],["قَدْ كَسَتْها الدُّهورُ أَرْدِيَةَ الرِّق","قةِ حتَّى جَفا لَدَيْها الهَواءُ",28,"ا",2,0],["قد كست الأرجاء والأرباضا","ثم رياضاً تقتفي رياضاً",29,"ض",2,0],["قد كستني ثوب مدح","طال عني وتدلى",30,"ل",2,0],["قَد كَسَت جسمي نَحولاً وَضَنىً","وَكَوَت قَلبي بِنار البُعد كَي",31,"ي",1,0],["قَد كَسَتهُم مَهابة المَجد قُدُماً","مِن لِباس التُقى أَجل لِباس",32,"س",1,0],["قَد كساه اللَهُ جُلباب الرِضا","حينَ مِنهُ كَرَم الوَجه السَني",33,"ي",1,0],["قد كساه الروضُ أبهى مَلبس","فيه بتنا تحت بُردِ الحندس",34,"س",1,0],["قد كساهم محمدٌ صالحَ الأفعال","بُرداً من فخره طابَ نشرا",35,"ر",2,0],["قد كسى هذهِ المقاصرَ وشياً","فسيُكسى وشياً ويحيى قصورا",36,"ر",2,0],["قَد كَسَدَ الحبُّ وَضَاعَ الهَوَى","من غيرِ مايَسهَرُ أَو يَنحَلُ",37,"ل",1,1],["قد كست علياءه أم القرى","غرة تحمي حماها أبدا",38,"د",2,0],["قد كسته الرباب برداً قشيباً","طرزته ورودها عطرات",39,"ت",1,0],["قد كستها الطيور لما رأتها","كافلاتٍ لها برزقٍ عميمِ",40,"م",1,0],["قد كسا الورد خحده ثوب حسن","فيه بالآس صنعة التطريز",41,"ز",1,0],["قد كساها الحياء شقة ورد","طرزت بالريحان منها الحواشي",42,"ش",2,0],["قد كساها الحياء حلة ورد","أسبلت فوقها ذؤابة آسي",43,"س",2,0],["قَد كسدَتْ سوقُ المعاصي فلا","شُرْبَ ولا قَصْفَ ولا عشرَه",44,"ر",2,0],["قد كسبناها بذرا","ت ونار وحديد",45,"د",1,0],["قد كَسُّرُوا البَابَ وهوَ السَّدُّ عَن فِتَنٍ","كأنَّ نجلَ اليمانيِّ ما حَكَى الخَبَرا",46,"ر",2,0],["قد كستهُ الدهور ثوباً من العج","زِ خليع الأكمام والأردان",47,"ن",1,0],["قد كساني حلة هذا الضنا","خاطها في الليل وجد لا يمل",48,"ل",1,1],["قد كسته السموم خضرةً لون","فاكتسى الكون حالك الألوان",49,"ن",1,0],["قد كسا جِسمَهُ البِعادُ نُحولاً","وذُبولاً واكسبَ القلب صدعا",50,"ع",2,0],["قد كسا الحسن خدها لازورد","فيه برد لحر نار الغليل",51,"ل",1,0],["قد كسفت شمس الضحى وقد خسف","بدر الدجى وذاك صُندوق التحف",52,"ف",1,0],["قد كسوت الزوراء بردى سناءٍ","وسنىً خالدين لن يستحيلا",53,"ل",2,0],["قَد كَسَت جسمي نحولا","بِهجَةَ القَلب الحَزين",54,"ن",1,0],["قَد كَسا لُبنان فَخراً","وَسَما الاعصارَ طرّا",54,"ر",2,0],["قد كساك الفخر برداً قد ضفا","فاعقد الشهب به وانتطق",55,"ق",1,0],["قد كسا لبسه المحقين عزا","وكسا المبطلين ثوب عزاء",56,"ا",2,0],["قد كسا العلياء ثوبا معلما","يوسفي طاب غرسا وأنتما",57,"م",2,1],["قد كسَانا الدهرُ أبرادَ السُرور","فغَدت تفترُ بالبُشر الثغور",58,"ر",1,1],["قد كساه بهتانه ثوب خزي","اينما سار سار فيه ذميما",59,"م",2,0],["قد كسته الدعوى من الخزي ثوباً","سايغا ضافيا طويل الذيول",60,"ل",1,0],["قد كساها حلل الحسن أبو","حسن من فضله في الكون لاح",61,"ح",1,0],["قد كسرَ طوقَ مناعتها","أبطالٌ بالنخوةِ هاموا",62,"م",3,0],["قد كَساها الحُبُّ ثوباً ناصِعاً","ما رأتْ كمْ تَحتَهُ مِن عَتمَةِ",63,"ت",3,0],["قد كسِّرتْ شوكةُ الغازينَ في دجلةٍ","والسَّيْفُ هبَّ إلى العلياءِ مُنْتَسِبا",64,"ب",2,0],["قدْ كسَّر َ الموجُ يا حسناء أشرعتي","وليس َ غيْرُك ِ يا حسْناء ُ يُحييها",65,"ي",3,0],["قد كساه الجمال حلة إجلال","عليه من الجلال ستور",66,"ر",1,0],["قد كساها الحسن من أثوابه","حلّة ً يلتذّ منها من نظرْ",67,"ر",1,0],["قَدْ كَسَى الوَجْهَ صُفَرَةً","مِنْ غُبَارٍ فَأظْلَمَا",68,"ا",1,0],["قد كسر المشمش قلبِي وَلم","أكسر لَهُ مُنْذُ أَتَى قلبا",69,"ب",2,1],["قد كسَتْها الدُّهورُ أردِية َ الرِّقَّ","ة ِ حتَّى جَفَا لَدَيْها الهَواءُ",70,"ا",2,0]]}