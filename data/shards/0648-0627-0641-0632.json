{"poems":[[79,"أشارت غداة البين من خلل السجف","https://www.aldiwan.net/poem35976.html","الطويل"],[53,"قد ذقت أنواع الطعوم فلم أجد","https://www.aldiwan.net/poem66731.html","البسيط"],[108,"ظلع وشيب!","https://www.poetsgate.com/ViewPoem.aspx?id=179321",""],[53,"قد ذقتُ أنواعَ الطعوم فلم أجد","https://www.poetsgate.com/ViewPoem.aspx?id=30750",""],[119,"اقبح اطوار الكرام العقوق","https://www.aldiwan.net/poem40875.html","عموديه"],[168,"لن تستطيع لأمر الله تعقيبا","https://www.aldiwan.net/poem67835.html","البسيط"],[333,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[411,"إن كنت ترغب في السعادة","https://www.aldiwan.net/poem49396.html","مجزوء الكامل"],[469,"بين القدود وبين أعطاف القنا","https://www.aldiwan.net/poem3325.html","عموديه"],[498,"كل الأمور إلى من","https://www.aldiwan.net/poem67375.html","المجتث"],[556,"لا تستعن أبدا بمن","https://www.aldiwan.net/poem47173.html","مجزوء الكامل"],[693,"","https://poetry.dctabudhabi.ae/diwan/poem/104096","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136275","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77268","الكامل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67195","الرجز"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101724","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91101","الكامل"],[3271,"سيف الله","https://www.poetsgate.com/ViewPoem.aspx?id=128730",""],[585,"تلك القبور وماثل الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=161873",""],[4190,"لم يشرب الصفو من لم يشرب الكدرا","https://www.poetsgate.com/ViewPoem.aspx?id=152433",""],[5147,"أيقل أرحلك الصعيد الهامد","https://www.poetsgate.com/ViewPoem.aspx?id=166697",""],[5382,"أعيش كأنّى","https://www.poetsgate.com/ViewPoem.aspx?id=211405",""],[5573,"ياطول ليلي وانا اطرد طارق الفكره","https://www.poetsgate.com/ViewPoem.aspx?id=203322",""],[5612,"عُدْ للكريمْ","https://www.poetsgate.com/ViewPoem.aspx?id=180951",""],[5670,"أشجان","https://www.poetsgate.com/ViewPoem.aspx?id=215245",""],[5764,"حبيبي وسلطاني","https://www.poetsgate.com/ViewPoem.aspx?id=137067",""],[5907,"رحلة الامس !","https://www.poetsgate.com/ViewPoem.aspx?id=176270",""],[6056,"مثل الجبل رآسي","https://www.poetsgate.com/ViewPoem.aspx?id=130339",""]],"verses":[["وأفْزَعُ منْ دهْري الى ظِلّ يُوسُفٍ","فلِلّهِ منْ رُكْنٍ مَنيع ومِنْ كهْفِ",0,"ف",1,0],["وافْزعْ إلى شُورى الرجالِ فإنها","لفساد رأيك حين يفسدُ نافيه",1,"ف",3,0],["وأفزع حين تُبْدِلُني حَنَانًا","بحبٍّ ربَّةُ الوجه الوسيم",2,"م",1,0],["وافْزعْ إلى شُورى الرجالِ فإنها","أفساد رأيك حسن يفسدُ نافيه",3,"ف",3,0],["وافزع الى الله بنصر امرءٍ","من قومك لزهر صديق صدوق",4,"ق",1,0],["وَاِفزَع إِلى كَنَفِ التَسليمِ وَاِرضَ بِما","قَضى المُهَيمِنُ مَكروهاً وَمَحبوبا",5,"ب",2,0],["وأفزعتني فوسعتُ الفضاء","إلّا فضاءً به ترتدي",6,"ي",1,0],["وافزع إلى اللَهِ الكري","مِ ودع مواصلة الخلائق",7,"ق",1,0],["وأفزع إلى حلق العذار فقد غدا","منهنَّ أحسن في العيون وأحصنا",8,"ن",2,0],["وَأفزَع إَلَيهِ إِذا لَم","يُجِركَ عَجزاً مُجيرُ",9,"ر",1,0],["وَاِفزعْ إِلى نصرِ الّذي","نَصَر الأنامَ بلا مَؤُونَهْ",10,"ن",2,0],["وأفزعُ مِن إطراقهِ فكأنّهُ","يُراصدُ إطلاقي نجيَّ التكتّمِ",11,"م",1,0],["وافزع إلى التقوى بعزم صادق","واسلك سبيل السادة الابدال",12,"ل",1,0],["وَافزَع إِلى شَكوى الهَوى فَمَذاقُها","عطرُ الشهادِ وَطَعمُ عَيشِكَ عَلقَمُ",13,"م",1,0],["وافزَع من الذَنبِ إلى أماجدِ","ما بَرحوا للصارخينَ مفزَعا",14,"ع",2,0],["وأفزع بالشكوى إلى حكم عادل","بصير ببادي أمرهم والمكتم",15,"م",1,0],["وافزع لِأَنَّة باشق","وَاطرب إِذا حجل الغراب",16,"ب",1,0],["وأفزع ليلَ الجاحدينَ بَومضهِ","فَخَرَّ لدينِ اللهِ كلُّ مكابرِ",17,"ر",1,0],["وافزع إلى الملك المهيمن فوقهم","فالعلم مل تنطس الجهال",18,"ل",1,0],["وافزع إذا أفزعتك النائبات إلى","كهف الأرامل والأيتام والفقرا",19,"ر",2,0],["وافزع على غفلات دهرك إنما","يصل الأماني فارط أو رائد",20,"د",1,0],["وأفْزع من واقعى والتّمنّي","على حزن قلبى بكى أربعينى",21,"ن",2,0],["وافز من عز نومي لازعج ذكره","واقوم فازع يطيح الجسم متواسي",22,"س",2,0],["وافْزَعْ إليْهِ إذا بُليتَ بكُرْبَةٍ","واقْصُدْهُ إن غَلَبتْ عليْكَ الآهُ",23,"ا",2,0],["‏وافزع لمن خضع الأنام لأمره","‏صعبُ المُنى بغِياثِهِ ينقادُ",24,"د",1,0],["وأفز فرحة وأهلي به","وأضمه بداخل أجفاني",25,"ن",2,0],["وافز من نومي وناخاطري عمس","حتى منامي يابعدهم جفاني",26,"ن",2,0],["وأفزّ مع طاريه وأقوم وأطيح","ولاجيت أبا أشرب شفت له طيف بالكأس",27,"س",1,0]]}