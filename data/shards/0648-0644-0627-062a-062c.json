"],[5358,"مسار الكواكب","https://www.poetsgate.com/ViewPoem.aspx?id=21906",""],[5376,"اذا غاب عني راح عن أنسنا ينحو","https://www.poetsgate.com/ViewPoem.aspx?id=200211",""],[5410,"رسالة خاصة","https://www.poetsgate.com/ViewPoem.aspx?id=140759",""],[5410,"آهات","https://www.poetsgate.com/ViewPoem.aspx?id=144495",""],[5497,"في عالم الذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=207251",""],[5564,"يا لله يارب الخلايق يامعبود","https://www.poetsgate.com/ViewPoem.aspx?id=186844",""],[5573,"ياخشف اشوف ان الهوى ماله حدود","https://www.poetsgate.com/ViewPoem.aspx?id=203090",""],[5606,"ليت بعض الأوادم باصمه","https://www.poetsgate.com/ViewPoem.aspx?id=198724",""],[5612,"الوَعْدُ الحَقّْ","https://www.poetsgate.com/ViewPoem.aspx?id=181334",""],[5660,"دَعِ الكِمياءَ تَفعَلُ ما تَشاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=23713",""],[5689,"ترى يطب بي شعبي رجوعي لغيله","https://www.poetsgate.com/ViewPoem.aspx?id=143430",""],[5873,"عيش الفخار","https://www.poetsgate.com/ViewPoem.aspx?id=215435",""],[5952,"أقيموا على أخلاقنا اليوم مأتما","https://www.poetsgate.com/ViewPoem.aspx?id=197109",""],[5953,"باب الهداية باب واحد أبدي","https://www.poetsgate.com/ViewPoem.aspx?id=93783",""],[5956,"شقاء الشوق ‏","https://www.poetsgate.com/ViewPoem.aspx?id=181907",""],[5961,"الى حي المليحة سر","https://www.poetsgate.com/ViewPoem.aspx?id=199805",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[6070,"رَأيتُ العُمرَتبكيهِ الورودُ*","https://www.poetsgate.com/ViewPoem.aspx?id=189502",""],[6115,"من عادتي اكتب من الشعربيتين","https://www.poetsgate.com/ViewPoem.aspx?id=180528",""],[6142,"سل كربلا والوغى والبيض والأسلا","https://www.poetsgate.com/ViewPoem.aspx?id=155747",""],[6152,"الوكالة","https://www.poetsgate.com/ViewPoem.aspx?id=201644",""],[2220,"سما فاعتلى في كلِّ حال مقام من","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11287&r=&rc=161",""]],"verses":[["وَلا تَجُز بِصُروفِ الدَهرِ في عُصَبٍ","مِنَ القَرائِنِ غَيرِ السُمرِ وَالقُضُبِ",0,"ب",1,0],["ولا تَجْثِمْ بمَدْرَجَةِ الهُوَيْنَى","تُقَعقِعُ للنّوائِبِ بالشِّنانِ",1,"ن",1,0],["وَلا تُجاوِر لِئاماً ذَلَّ جارُهُمُ","وَخَلِّهِم في عِراصِ الدارِ وَاِرتَحِلِ",2,"ل",1,0],["وَلا تَجزَعي إِن لَجَّ قَومُكِ في دَمي","فَما لِيَ بَعدَ الهَجرِ لَحمٌ وَلا دَمُ",3,"م",1,0],["وَلا تَجزَع لِحادِثَةِ اللَيالي","فَما لِحَوادِثِ الدُنيا بَقاءُ",4,"ا",2,0],["وَلاَ تُجْرِيَا ذِكْرَ الْفِرَاقِ فإِنَّهُ","حَدِيثٌ عَلَى سَمْعِ الْغَدَاةِ ثَقِيلُ",5,"ل",1,0],["ولا تَجَسَّس فهذي الآيُ قد نَزَلَتْ","بالنَّهْي عنه فلم تَذكر نَواهيها",6,"ي",3,0],["وَلا تَجزَعي مِن مُدَّةِ الجَورِ إِنَّني","كَأَنّي بِها قَد آذَنَت بِبَتاتِ",7,"ت",1,0],["ولا تجعلوني في رجائي ودكم","كراجٍ على بيض الأنوق احتبالَها",8,"ه",2,1],["وَلا تَجزَعوا مِنها فَإِنَّ سُيوفَنا","لَها وَقعَةٌ بِالمَوتِ يُفتَحُ بابُها",9,"ب",3,0],["ولا تجعلنّ الظن ما عشتَ صاحباً","فلستَ تراه صاحباً لنبيلِ",10,"ل",1,0],["ولا تَجزَعْ فصرفُ الدَّهْرِ كَلْمٌ","وتَعفيةٌ وإن دَمِيَتْ كِلامُ",11,"م",1,0],["وَلا تَجعَليني أَسوَةَ العَبدِ وَاِجعَلي","مَعَ العَبدِ عَبداً مِثلَهُ وَذَريني",12,"ي",1,0],["ولا تجعليه بين خديك والنوى","من الظلم ان يغدو لنارَيك صاليا",13,"ي",2,0],["وَلا تَجعَل تَوَدُّدُكَ اِبتِذالاً","وَلا تَسمَح بِحِلمِكَ أَن يُذالا",14,"ل",2,0],["وَلا تَجعَليهِ بَينَ خَدَيكِ وَالنَوى","مِنَ الظُلمِ أَن يَغدو لِنارَينِ صالِيا",15,"ي",2,0],["وَلا تُجاوِزُها شَمسٌ إِذا شَرَقَت","إِلّا وَمِنهُ لَها إِذنٌ بِتَغريبِ",16,"ب",1,0],["ولا تجزعي من ذمِّ غاوٍ وحاسدٍ","فأهونُ مأثورٍ كلامُ سفيهِ",17,"ي",2,0],["ولا تجزعَنْ للكَبْلِ مسَّكَ وقْعُهُ","فإنَّ خلاخيلَ الرِجالِ كُبُولُ",18,"ل",1,0],["ولا تَجزَعْ لِمَيلِ الدهرِ إني","أُؤمِّلُ أن يعودَ إلى اعتدالِ",19,"ل",1,0],["ولا تَجعَلِ الذَّنْبَ العظيمَ خيانةً","فليسَ مليحُ الذَّنبِ مُقترِفاً ذَنْبا",20,"ب",2,0],["وَلا تَجزَع إِذا ما نابَ خَطبٌ","فَكَم لِلّهِ مِن لُطفٍ خَفيِّ",21,"ي",1,0],["وَلا تَجزَع وَإِن أُعسِرتَ يَوماً","فَقَد أَيسَرَت في الزَمَنِ الطَّويلِ",22,"ل",1,0],["وَلا تَجزع مِنَ المَوتِ","إِذا حَلَّ بِواديكا",23,"ك",2,0],["وَلا تَجمع مِنَ المالِ","فَلا تَدري لِمَن تَجمَع",24,"ع",1,0],["وَلا تَجعَلَنَّ الحَمدَ إِلّا لِأَهلِهِ","وَلا تَدَعِ الإِمساكَ بِالعُروَةِ الوُثقى",25,"ق",2,0],["وَلا تَجعَل كَلامَ الضِدِّ عُذراً","تَصُدُّ بِهِ الأَحِبَّةَ وَالصِحابا",26,"ب",2,0],["ولا تجريا لي ذكرَ جريا ونحوها","ربي جادَها غيثٌ فروَّى وروَّضا",27,"ض",2,0],["ولا تجهلْ بجهلٍ مِنْ أناسٍ","وإنْ همْ خاطبوكَ فقلْ سلاما",28,"م",2,0],["وَلا تَجحَدوا بي وُدَّ عِشرينَ حِجَّةٍ","وَلا تُفسِدوا ما كانَ مِنكُم مِنَ الفَضلِ",29,"ل",1,0],["وَلا تَجعَل نَديمَكَ في شَرابٍ","سَخيفَ العَقلِ أَو دَنِسَ الأَديمِ",30,"م",1,0],["وَلا تَجعَلِ الشُورى عَلَيكَ غَضاضَةً","مَكانُ الخَوافي قُوَّةٌ لِلقَوادِمِ",31,"م",1,0],["وَلا تَجلِس إِلى أَهلِ الدَنايا","فَإِنَّ خَلائِقَ السُفَهاءِ تُعدي",32,"د",2,0],["وَلا تَجنُبنِيَ الإِحسانَ ضَنّاً","إِذا ما كانَ نَجرُكَ غَيرَ نَجري",33,"ر",2,0],["وَلا تَجعَلكَ لِلأَيّامِ كَلباً","ظِباءٌ مِن ذُؤَيبَةَ أَو سُبَيعَه",34,"ع",2,0],["وَلا تَجعَل فِناءَكَ مُستَضاماً","بِمُطَلِّعٍ يَكونُ إِلى الطَريقِ",35,"ق",1,0],["وَلا تُجِلَنَّ ما الأَحلامُ تَحظُرُهُ","فَقَد عَلِمتَ بِأَنَّ الرِمسَ مَحلولُ",36,"ل",1,0],["وَلا تَجعَليني كَاِمرِئٍ لَيسَ هَمُّهُ","كَهَمّي وَلا يُغني غَنائي وَمَشهَدي",37,"د",2,0],["وَلا تَجزَعا إِنَّ الحَيَاةَ ذَمِيمَةٌ","فخِفّا لِروعَاتِ الحَوَادِثِ أَو قِرا",38,"ر",2,0],["ولا تجلعه غزْلاً فَرْ","رَ حائكُه إلى عَدَنِ",39,"ن",1,0],["وَلا تَجزَعي مِن مُدَّةِ الجَورِ إِنَّني","كَأَنّي بِها قَد آذَنَت بِشَتاتِ",40,"ت",1,0],["ولا تجعل الشورى عليك غضاضة","مكان الخوافي نافع للقوادم ِ",41,"م",1,0],["ولا تجعليني كامريء ليس همه","كهمي ولا يغني غنائي ومشهدي",42,"د",2,0],["ولا تجعله غزلاً فَرْ","رَ حائكُه إلى عَدَنِ",43,"ن",1,0],["ولا تجعل إليّ له مَساغاً","فقد تؤتى الحصونُ من النقوبِ",44,"ب",1,0],["وَلا تَجْزَعْ لنازلة الليالي","فما لحوادثِ الدنيا بقاءُ",45,"ا",2,0],["ولا تجعل حبال المكر شأوا","فنصل المكر كم قطع الحبالا",46,"ل",2,0],["ولا تجبنوا إن النعيمَ أمامُكم","ولو لم يعشْ شيخٌ لكم وغلامُ",47,"م",1,0],["ولا تجَالسْ كثيرَ الضحكِ ذَا رِيَبٍ","ولا تُجَالسْ كثيرَ القولِ ذَا هَدَرِ",48,"ر",1,0],["ولا تجفُه مهما بَدَت منه زَلةٌ","وكن ذا صَفاءِ إن تكدَّر مشربُ",49,"ب",1,0],["وَلا تَجزَعَن إِنَّ اللَيالي بِأَهلِها","تَقَلَّبُ وَالأَيّامُ بُؤسى وَأنعُمُ",50,"م",1,0],["وَلا تَجذِباها بِالبُرى وَاِرخِيا لَها","فَجَذبُ البُرى وَالإِنجِذابُ بَراها",51,"ا",3,0],["وَلا تَجنَحي نَحوَ التَّراخي إِذا بَدَت","شَدائدُ هَذا الدَّهرِ قاذفةً ذُعرا",52,"ر",2,0],["ولا تَجُدْ بمدامٍ غيرِ قانيةٍ","في جنة الخلد كانت شرب إبليس",53,"س",1,0],["ولا تجنح إلى قول الاعادي","ودع زيدا ولا تعني بعمرو",54,"ر",2,0],["ولا تجيزون رفعى","شكواي منكم إليكم",55,"م",1,0],["ولا تجعل الدنيا بهجرك مقلة","مقرّحة الجفنين معطوبة الهدب",56,"ب",1,0],["ولا تجادل أخاك معتذراً","فلست ممن يقول بالجدل",57,"ل",1,0],["وَلا تَجمَح إِلى اللُّوامِ فيها","عَلى الروّاضِ كَالطِرفِ الجَموحِ",58,"ح",1,0],["وَلا تَجَمَّلَت بِالأَرياشِ مُفتَخِراً","وَلا اِفتَتَنتَ بِحُبِّ الأَهلِ وَالسَكَنِ",59,"ن",1,0],["وَلا تَجعَل طَعامَ اللَيلِ ذُخراً","حِذارَ غَدٍ لِكُلِّ غَدٍ غداءُ",60,"ا",2,0],["ولا تجنح إلى أعمال قومٍ","نسوا ما قد أسرَّته الطوايا",61,"ا",3,0],["ولا تجد دافع","لك من عذاب الله",62,"ه",1,0],["ولا تجالس لجاهل","تجيك كم من أذيه",63,"ه",1,0],["ولا تجنَحْ إلى العصْيانِ تُدْفَعْ","إلى ليلٍ مِنَ الأحزانِ حالِكْ",64,"ك",1,0],["ولا تجزَعْ لغَدرٍ من خَليلٍ","فقد نُسِخَ الوفاءُ مِن الخليلِ",65,"ل",1,0],["ولا تجزَعي من بَغتَةِ البينِ واصبري","لعلَّ التَّنائي مُعْقِبٌ لِتَداني",66,"ن",2,0],["وَلا تَجعَل الأَرضَ العَريضَ مَحلُّها","عَلَيكَ سَبيلاً وَعَثَةَ المُتَنَقَّل",67,"ل",1,1],["ولا تجعلي هجري لديك سجيّةً","وحسبك ما يلقى فوادي وما لقي",68,"ق",2,0],["ولا تجزع إذا فارقت إلفا","نأى وأبانه الزمن الخؤون",69,"ن",1,0],["ولا تجعل الدنيا قرينة مطلبي","ولا تجعل الأخراي عني على بعد",70,"د",1,0],["ولا تجد أحداً إِلا عليه له","من علمه أَو هداه أَو نداه يد",71,"د",1,0],["ولا تجعل الأحزان بين حيازم","على حرها تطوى وتكوى وتفرك",72,"ك",1,0],["وَلا تَجُرُّ إِلَيَّ العَذلُ مِنكَ فَما","تَرى طَريقاً لِغَيرِ النايِ وَالوَتَرِ",73,"ر",1,0],["وَلا تَجعَلي بِالرَدِّ قَصدِيَ ضائِعاً","لَدَيكَ فَماءُ الوَجهِ يُذهِبُهُ الرُدُّ",74,"د",1,0],["ولا تجعلوا نهضة الشعب مهدا","إذا حركته البواعث نام",75,"م",1,