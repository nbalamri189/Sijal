{"poems":[[29,"ألا حي ربع المنزل المتقادم","https://www.aldiwan.net/poem4453.html","الطويل"],[29,"زار القبور أبو مالك","https://www.aldiwan.net/poem5779.html","المتقارب"],[53,"يا أحمد بن سعيد لا تمت جزعا","https://www.aldiwan.net/poem65873.html","البسيط"],[21,"ومن صنعه يوم فيل الحبوش","https://www.aldiwan.net/poem36162.html","المتقارب"],[108,"ثورة على الحضارة","https://www.poetsgate.com/ViewPoem.aspx?id=179425",""],[385,"وجد له في الحشا دبيب","https://www.aldiwan.net/poem49249.html","مخلع البسيط"],[422,"تولت من الظلماء تلك الدياجر","https://www.aldiwan.net/poem54031.html","الطويل"],[463,"بدينك بعد ما انفرق الجميع","https://www.aldiwan.net/poem56119.html","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122673","الطويل"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18489","الخفيف"],[1319,"","https://poetry.dctabudhabi.ae/diwan/poem/128281","الرجز"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132579","الكامل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130052","الطويل"],[3553,"","https://poetry.dctabudhabi.ae/diwan/poem/17678","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110061","الوافر"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32416","المنسرح"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125805","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54414","الطويل"],[4759,"لا أتذكر","https://www.poetsgate.com/ViewPoem.aspx?id=208583",""],[585,"مغلغلة منشورةٌ في المحافل","https://www.poetsgate.com/ViewPoem.aspx?id=161901",""],[592,"الحمد لله حمداً دائماً وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=128796",""],[5431,"هو سرُ أسرار الوجود مخلدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=187756",""],[5628,"زفرة على نعش غسان كنفاني","https://www.poetsgate.com/ViewPoem.aspx?id=178759",""]],"verses":[["تُحَضِّضُ يا اِبنَ القَينِ قَيساً لِيَجعَلوا","لِقَومِكَ يَوماً مِثلَ يَومِ الأَراقِمِ",0,"م",1,0],["تَحُضّونَ قَيساً وَلا تَصبِرونَ","لِزَبنِ الحُروبِ وَإِضرارِها",1,"ر",3,0],["تحضَّنتْ خُلَّتي عُوداً فحضَّنها","طفلاً أتاها وفي الأطفال تطفيلُ",2,"ل",1,0],["تَحضُّ عَلى الصَبرِ أَحبارَهُم","وقَد ثأَجوا كثُؤاجِ الغَنَم",3,"م",1,0],["تحضر النَّاس حتى ما لمكرُمة","قُدسٌ لديهم، ولكن قدسوا المالا",4,"ل",2,0],["تَحضر لي بَعضُهُ الأَماني","وَالشَوق عَني بِهِ يَغيب",5,"ب",1,0],["تحضّ على الذكر الحميد بفعله","وفيها لأرباب العقول بصائر",6,"ر",1,0],["تَحضَّنهم حواضنُ مُكرَماتٌ","ففات الكهلَ طفلُهم الرضيعُ",7,"ع",1,0],["تَحُضُّ عَلى بَذري خيارُ احتِراثِه","وتَعتُبُ في تَركي حَصادُ أزدِراعِه",8,"ع",2,0],["تَحضُرُ الطَيرُ مَصرَعي وَتَرَوَّح","تُ إِلى اللَهِ في الدِماءِ خَضيبا",9,"ب",2,0],["تحضنها حرارة لطيفه","داخلة من حجب كثيفه",10,"ه",1,0],["تحضى بالطاف وبيض مواهب","في كل شارقة لها تجديد",11,"د",1,0],["تَحُضّ على تأييد قومك جاهداً","وتنشر فيهم للهدى أعلاما",12,"م",2,0],["تُحَضِّضُ أَفناءَ الرِبابِ سَفاهَةً","وَعِرضُكَ مَوتورٌ وَلَيلُكَ نائِمُ",13,"م",1,0],["تَحُضُّ على اطِّراح العُجب كُلاً","وتُعجِبُ في مُطارَحةِ الكَلامِ",14,"م",1,0],["تُحضِرُهُ لا فَلا يَهُمُّ بِها","وَمِنهُ تَضحي نَعَم عَلى أَرَبِ",15,"ب",1,0],["تحضيره البدو الجفاة وقلبه ال","بيداء من قفر إلى مأهول",16,"ل",1,0],["تحضُّ على نِشدان حَظٍّ فقدتُهُ","إذا الحظُّ لم ينفعْ فلا نفعَ في الحضِّ",17,"ض",1,0],["تحضرك الأشواق عن كل غائب","وتأتي بك الأحداق فيما تحضر",18,"ر",1,0],["تحض جميع المسلمين حفيةً","بقاصٍ ودانٍ لا تصيخ لعاذل",19,"ل",1,0],["تحض أتباعك الغوغا وتندبهم","إلى أتباع غواةٍ قد أتوا جنفا",20,"ف",2,0],["تحضنْك روحي كالنعيم لأهله","وتذودُ عنك مُحِبَةً وتجودُ",21,"د",1,0],["تحضّنتَ المصائبَ في خشوع ٍ","فصرْتَ لكلِّ قدّيسٍ مزارا",22,"ر",2,0]]}