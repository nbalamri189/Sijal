{"poems":[[55,"مقيم من الهم لا يقلع","https://www.aldiwan.net/poem29974.html","المتقارب"],[30,"تحن بزوراء المدينة ناقتي","https://www.aldiwan.net/poem5618.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42562","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54858","الكامل"],[96,"إيه حكيم الدّهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66311&r=&rc=29",""],[447,"كوى قلبي الأسى والحزن كيا","https://www.aldiwan.net/poem14492.html","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62698","الوافر"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35355","الطويل"],[1624,"","https://poetry.dctabudhabi.ae/diwan/poem/45386","الوافر"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106895","الكامل"],[3469,"","https://poetry.dctabudhabi.ae/diwan/poem/5","المتقارب"],[5187,"سكرة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=29253",""],[5431,"وفي معبد الطغيان كلٌّ مُذبّحُ...","https://www.poetsgate.com/ViewPoem.aspx?id=201517",""],[5495,"بده العام الدراسي (مرثيه لولده حيدر)","https://www.poetsgate.com/ViewPoem.aspx?id=175440",""],[5751,"المعشوق والعاشق","https://www.poetsgate.com/ViewPoem.aspx?id=214763",""]],"verses":[["بِدَهرٍ أَلومُ وَلا يَرعَوي","وَمَولىً أَقولُ وَلا يَسمَعُ",0,"ع",1,0],["بِدَهنا تَميمٍ حَيثُ سُدَّت عَلَيهِمُ","بِمُعتَرَكٍ مِن رَملِها المُتَراكِمِ",1,"م",1,0],["بَدَهَاتُهُ قَيْدُ الصَّوَابِ وَعَزْمُهُ","شَرَكُ الْفَوارِسِ فِي الْعَجَاجِ الأَرْبَدِ",2,"د",1,0],["بِدَهَاءِ ذِي عَدَدٍ وَذِي عُدَد","مِنْ نَفْسِهِ إِنْ كَرَّ أَوْ فَرَّا",3,"ر",2,0],["بدهت شواردها العدى بكتيبة","خضراء تلمع بالحديد رداح",4,"ح",1,0],["بدهر عشت بعدهمو غريبا","أخبِّر عنهمُ عيلان طيا",5,"ي",2,0],["بدهر في تقلبه عريق","يرينا اللطف في مرآى شفيق",6,"ق",1,0],["بِدُهمٍ سَدَدنَ الجَوَّ وَهيَ حَنادِسٌ","وَشُهبٍ كَسا الأَرضينَ مِنها ثُلوجُ",7,"ج",1,0],["بِدَهرٍ ضاعَتِ الأَحسابُ فيهِ","ضَياعَ الرَأيِ في السِرِّ المُذاعِ",8,"ع",1,0],["بدهات أفكار لما","قد كان أو ما قد يكون",9,"ن",1,0],["بِدُهمٍ ضَوامِنَ لِلمُعتَفي","نَ أَن يَمنَحوهُنَّ قَبلَ العِيالِ",10,"ل",1,0],["بدهائِها وفنونِها","أصبحتُ شَلواً باليا",11,"ي",2,0],["بدهري غدا لفظي يُعاني اغترابه","وقد أُفرغَ المعنى فما عاد يُفصحُ!!",12,"ح",1,0],["بده العام الدراسي وبدت الهموم","وبيتي عالمدارس بابه صاير",13,"ر",1,1],["بدهشةِ الألوان يجري وفي","محارةِ المعنى شراعاً طَليقْ",14,"ق",1,0]]}