oem.aspx?id=199054",""],[5542,"مشاهد من يوم القيامة","https://www.poetsgate.com/ViewPoem.aspx?id=10202",""],[5542,"حرقة عالى حال الأمة","https://www.poetsgate.com/ViewPoem.aspx?id=10062",""],[5674,"قلبي هائم وقتيل","https://www.poetsgate.com/ViewPoem.aspx?id=189068",""],[445,"وَحْشِيَّةَ اللَّفْظِ هل يودِي قتيلُكُمُ","https://www.poetsgate.com/ViewPoem.aspx?id=58590",""],[5848,"صوت ريم","https://www.poetsgate.com/ViewPoem.aspx?id=48851",""],[5885,"وحشية","https://www.poetsgate.com/ViewPoem.aspx?id=194734",""],[5953,"عاذلتي في الشيب لو تعلم ما","https://www.poetsgate.com/ViewPoem.aspx?id=93807",""],[5953,"لاح ضياء القمر الزاهر","https://www.poetsgate.com/ViewPoem.aspx?id=93849",""],[5959,"القلب الأخضرانى","https://www.poetsgate.com/ViewPoem.aspx?id=12164",""],[6003,"عنترة !!","https://www.poetsgate.com/ViewPoem.aspx?id=189043",""],[6031,"يا نَسيمَ الشَمالِ أدِّ رِسَالا","https://www.poetsgate.com/ViewPoem.aspx?id=46264",""],[6070,"قُمْ وافتَحْ الصََندوقَ والأبوابا","https://www.poetsgate.com/ViewPoem.aspx?id=193902",""],[6093,"اللقْطَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=205374",""],[6102,"رِقَّةٌ وَحشِيَّة !!","https://www.poetsgate.com/ViewPoem.aspx?id=184163",""],[6102,"على !!","https://www.poetsgate.com/ViewPoem.aspx?id=184455",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577067",""],[5309,"إياك يا صاحبي ان تكثر الجدلا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573866",""],[6202,"استبد الهوى عشقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86702&r=&rc=3",""],[406,"حرقة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=851&r=&rc=42",""],[6275,"سنوات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83611&r=&rc=3",""],[6280,"طَرَقَتْكَ زَائِرَة ً فَحَيِّ خَيَالَها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27902&r=&rc=57",""],[6314,"غزل أحمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88066&r=&rc=1",""],[6356,"آخرُ شموعِ الخريفْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81908&r=&rc=9",""]],"verses":[["وَحَشاً إِذا ذُكِرَ الفِراقُ هَفا","في جانِبَيهِ الشَوقُ وَالأَسَفُ",0,"ف",1,0],["وَحَشوُ أَكُفِّهِم سُمرٌ رِواءٌ","بِوِردِ المَوتِ مِن مُهَجٍ صَوادِ",1,"د",1,0],["وَحَشِيَّتي سَرجٌ عَلى عَبلِ الشَوى","نَهدٍ مَراكِلُهُ نَبيلِ المَحزِمِ",2,"م",1,0],["وَحشاً تَعاوَرَها الرِياحُ كَأَنَّها","تَوشيحُ عَصبِ مُسَهَّمِ الأَغيالِ",3,"ل",1,0],["وحشاشة لم يبق فيها للأسى","والهمّ إلا نبذة وكأنْ قد",4,"د",1,0],["وحشا مسامعَهُ بها","فحمى مُعاتِبَه عِتابهْ",5,"ب",2,0],["وحشةَ النِّضْو للنَّسيم إذا أعْ","وَزَ وهْو المأكول والمشروبُ",6,"ب",1,0],["وحشةَ المجدِبِ المُقلّ دَهَتْهُ","نُقْلَةُ الغيثِ حين كاد يَصوبُ",6,"ب",1,0],["وحشةَ الفردِ غُيِّبَ النُّورُ عنهُ","في سُهوبٍ أمامهنّ سُهُوبُ",6,"ب",1,0],["وحشة العبدِ للمليك وليستْ","وحشةَ الكُفءِ والمعاني ضُروبُ",6,"ب",1,0],["وَحشاً سِوى أَنَّ فُرّادَ السِباعِ بِها","كَأَنَّها مِن تَبَغّى الناسِ أَطلاحُ",7,"ح",1,0],["وَحُشاشَةٍ ما أَبقَتِ ال","أَشواقُ مِنها باقِيَه",8,"ي",2,0],["وَحَشاهُ عادِيَةً بِغَيرِ قَوائِمٍ","عُقمَ البُطونِ حَوالِكَ الأَلوانِ",9,"ن",1,0],["وَحشٌ تَأَبَّدَ في تِلكَ الطُلولِ وَقَد","تَكونُ أُنّاسَهُنَّ الأُنَّسُ الخُرُدُ",10,"د",1,0],["وَحَشوُ كَتيبَةٍ جُعِلَت غِشاءً","لِعَينِ الشَمسِ مِن لَهَبِ الحَديدِ",11,"د",1,0],["وَحْشاً من السَّبي آنَسْتَ الكُماةَ به","سِيَّانِ في الحُسْنِ حاليهِ وعاطِلُه",12,"ل",2,0],["وَحَشّي بِالكُؤوسِ إِلى بَواطٍ","ظَواهِرُهُنَّ غابٌ وَالبَواطِن",13,"ن",1,0],["وحشا الجوِّ حَشْوُه نارُ برقٍ","إنّه في ضلوعِهِ لَغَلِيلُ",14,"ل",1,0],["وَحَشاً تُحَرِّقُهُ النَصيحَةُ وَالهَوى","لَو أَنَّهُ وَقتٌ لَكانَ مَصيفا",15,"ف",2,0],["وَحشِيَّةٌ تَرمي القُلوبَ إِذا اِغتَدَت","وَسنى فَما تَصطادُ غَيرَ الصيدِ",16,"د",1,0],["وَحَشوُ حَوادِثِ الأَيّامِ مِنهُم","مَعاقِلُ مُطرَدٍ وَبَنو طِرادِ",17,"د",1,0],["وحشٌ وإنْ روَّضَ الإِنسيُّ جامحَها","قفرٌ وإنْ مُلئتْ ورداً ونِسرينا",18,"ن",2,0],["وَحشِيَّةً إِنسِيَّةً","خَرّاجَةً مِن بابِها",19,"ب",3,0],["وَحشِيَّةِ الدارِ وَالأَنسابِ ما بَرَحَت","خَلفَ الطَرائِدِ في الآفاقِ تَنسَرِبُ",20,"ب",1,0],["وَحَشْوَ القِبابِ المستقِلّةِ غَادَةٌ","أُجَدِّدُ عَهدَ الوُدِّ منها وتُخلِقُه",21,"ق",2,0],["وَحَشوَ جَفيرٍ مِن فُروعٍ غَرائِبٍ","تَنَطَّعَ فيها صانِعٌ وَتَنَبَّلا",22,"ل",2,0],["وحَشَرَ الأطرافَ والثُّغورَا","ورَفضَ اللَّذاتِ والحُبورَا",23,"ر",2,0],["وَحَشوا حَشا الظَلماءِ مِلءَ جَنانِها","حَتّى تَصَدَّعَ بِالصَديعِ البادي",24,"د",2,0],["وَحَشَدْنَا الأَلْلَاظَ أَنْقَى مِنَ الْمَاءِ","وَأشْهَى مَسَاغَةً وَوُرُودا",25,"د",2,0],["وحشوا أنوف القوم غازٌ مسمَّم","وللنار في أبدانهم مرتع خصب",26,"ب",1,0],["وحشة الخارج تعوي حوله","ثمّ تنفيه إلى داخله",27,"ل",2,1],["وحشدتَ فيه الجيشَ واجتمع الملا","كالحشرِ أقدامٌ على أقدامِ",28,"م",1,0],["وحشدَت جندك ناهضاً لزفافه","فملأت أقطار البسيطة عسكرا",29,"ر",2,0],["وحشى تعشقه الغرام وحله","قسرا وليس بكفوه وضريبه",30,"ب",2,0],["وحش رواحة القرشي رحلي","بناقته ولم ينظر ثوابا",31,"ب",2,0],["وَحَشا تِلكُمُ المَدارِسَ بِالكُت","بِ الشَريفَةِ الصَحيحَةِ الإِسنادِ",32,"د",1,0],["وحَشا قلوبَ سَذابه","منه بكل فمٍ حَرِج",33,"ج",1,0],["وَحَشاه بِحكمةٍ وبإيما","نٍ وتمَّ الختام تمّ الوكاءُ",34,"ا",2,0],["وَحشُ بَرِّيَةٍ بِها وَلَدَتهُ","أُمُّهُ لا يَزولُ مِنها الصِيارُ",35,"ر",1,0],["وحشةُ اللَيلِ وَالسَكينَةُ وَالصَم","تُ وَمرُّ النَسيمِ كانَ كلاما",36,"م",2,0],["وحشية كشف الزمان حجابها","لا بل أشد من الوحوش وأظلم",37,"م",1,0],["وَحَّش الناس قرب أرضك حتّى","أصبحوا للعيون هاماً وجِنّا",38,"ن",2,0],["وحَشَّدَ لِلأحرارِ زحفاً مُضرِّساً","مُضرَّىً قد اعتادَ الفَواتِكَ والضّرى",39,"ر",2,0],["وَحْشِيّةٌ في فَازَة بِمَفازَةٍ","يَنزو الجنانُ الوَحشُ مِنها راهِبا",40,"ب",2,0],["وحشاشةُ الأبطال قد تلفت ظما","ودمُ الفوارس مستهل صيبُ",41,"ب",1,0],["وحشاشةٌ في حشوها نارُ الأسى","وجوى يزيدُ وعبرةٌ تترقرقُ",42,"ق",1,0],["وحشر وميزان ونار وجنة","وجسر وحوض طيب الماء عاطر",43,"ر",1,0],["وَحَشَوتُ أَعيُنَهُم تُراباً بَعدَما","كانَت تَأَذّى بِاليَسيرِ مِنَ القَذا",44,"ا",1,0],["وحشية الأنساب ما أنست","في فوحش البيداء بالقود",45,"د",1,0],["وحشدتُ الخواطر الهيم تنسا","بُ لتفنى في موجد الهدار",46,"ر",1,0],["وَحشٍ في العُربِ مَنازِلُهُ","مَجهولِ الأصلِ إذا نُسِبا",47,"ب",2,0],["وَحَشَوتُ الغَيظَ فِي أَضلاعِهِ","فَهوَ يَمشِي حَظَلاناً كَالنَّقِرْ",48,"ر",1,0],["وَحشية شرك القَضا","ء أَصارها عِندي أَسيرَه",49,"ر",2,0],["وحشر تحت ظل","لواراعى الشفاعات",50,"ت",1,0],["وحشر مع الغانيات الحسان","إذا حشر المرء معْ من أحب",51,"ب",1,0],["وحشاشة تورى عليك وناظر","ممَّن دعا لوبالها ووباله",52,"ل",2,0],["وحُشيَتْ حشوَ خبيرٍ عارفِ","وجادَها عارضُ حُلْوٍ واكِفِ",53,"ف",1,0],["وحشا حشاها البين باكره قانيا","كادت ببيني النواظر تسحم",54,"م",1,0],["وَحشٌ للاستعمارِ يُمعنُ شَرُّهُ","باسمِ الحضارةِ والتَّقدمِ ساخرا",55,"ر",2,0],["وحَشَونا جلودَنا حِكَماً","وبَرَعنا في كيفَ نَنتَقِد ُ",56,"د",1,0],["وَحشاً تُعَفّيهِ سَوافي الصَبا","وَالصَيفُ إِلّا دَمَنَ المَنزِلِ",57,"ل",1,0],["وَحُشّوا الحُروبَ إِذا أوقِدَت","رِماحاً طِوالاً وَخَيلاً فُحولا",58,"ل",2,0],["وَحَشر جَميع الرُّسل تَحتَ لِوائِهِ","فَلِلّه ما أَسناه مَجداً وَما أَسما",59,"م",2,0],["وحشو ضلوعي كلُّ نَجلاءَ ثَرَّةٍ","متى ألَّفوها أقْسَمَتْ لا تألَّفُ",60,"ف",1,0],["وحُشرنا إليه عمن سواه","ودخلنا جنانه خالدينا",61,"ن",2,0],["وَحُشاشةٌ مَسلوبَةٌ وَلَعَلَّها","ذَهَبَت عَلى أَثَرِ الفُؤادِ تُودِّعُ",62,"ع",1,0],["وَحْشِيَّةُ العَيْنَيْنِ مياسَةُ ال","عِطْفَيْنِ من تَرْبيَةِ القَصْرِ",63,"ر",1,1],["وحشاً رأت هذى الفريسة فاغرا","فمه وعن ناب العداوة كاشرا",64,"ر",2,0],["وحَشْوُ قِباب الرَّقْم أَحْوَى مُقَرْطَقٌ","كما آسُ رَوْضٍ عِطْفُهُ والقَرَاطِقُ",65,"ق",1,0],["وحشا بالمدى مدى","حرقاتي تشرح",66,"ح",1,0],["وحشاً حَشْوُها عقابيلُ وَجدٍ","يرتقي حرُّ ناره في التَّراقي",67,"ق",2,0],["وَحَشَتْ جَيْبَها غِرارةَ قُطْنٍ","أمِنَ الظَّرْفِ قَيْنَةٌ في غِراره",68,"ر",2,0],["وحشدت ما بين الفضا زمر القضا","جنداً أخفت لنصره الأجنادا",69,"د",2,0],["وحشر مثله في الفضل يقضي","سبيلهما على كرم وبِرّ",70,"ر",1,0],["وحشاهم أن يحرموا جيرانهم","همّا به عمّوا على البلدان",71,"ن",1,0],["وحشاهم أن يطردوا عن وردهم","مستوردا من شاحط الأوطان",71,"ن",1,0],["وحشاهم أن يعرضوا عن شيّق","متمَلّق في حبّهم متفان",71,"ن",1,0],["وحشا لبارق صادقات وعودهم","أن ينتمي لكواذب اللمعان",71,"ن",1,0],["وحشاشتي أبدّا تذوب تحسرّا","مما لقيت ومهجتي تتمزق",72,"ق",1,0],["وحشن ختم وتقويم على سنن المختار","طه وأعلا حالة كملت",73,"ت",1,0],["وحشو حشاي فيك رسيس وجد","أقل صفاته النار الجحيم",74,"م",1,0],["وحشٌ من الإنس من يعلق بصحبتهم","يكنْ كمستبدلٍ سقماً بصحَّته",75,"ه",1,1],["وحشا المكرمات حرَّى وعينُ ال","مجد عبرى ومهجة الفضل حرَّى",76,"ر",2,0],["وحشاهُ يبعثُ للق","لوبِ أَريجه كالمسكِ عاطر",77,"ر",1,0],["وحشاها ليَ مثوىً كلما","بعُد الركب بها أو قرُبا",78,"ب",2,0],["وَحَشَّ الكُماةُ بالسيوف وقودَها","حِفاظا وبالخطيِّ حَتَّى تَلَهَّبا",79,"ب",2,0],["وَحَشْحَشَها جُرْداً تُخُيّرْنَ لِلنَّوَى","وَكُومَ ذرِّي مَعْدودَةً لِلنَّوائِبِ",80,"ب",1,0],["وحش تناكرت الوجوه به","حتى استربت بصفحة البدر",81,"ر",1,0],["وحشةٌ خيمت بواديه فالند","مان عنه بمعزلٍ والحميا",82,"ي",2,0],["وحشاً أنفاسه شررٌ","محرقات من إليّ دنا",83,"ن",2,0],["وَحشِيَّةٌ ما بِها أُنسٌ قَد اِتَّخَذَت","في بَيتِ خَلوتِها لِلذِّكرِ ناووسا",84,"س",2,0],["وحُشاشة فَنِيتْ ومنها فضْلةُ","بقيت مُقُلّبة على شوكِ الإبَر",85,"ر",1,0],["وَحشاي أخفق مِن جَناحي طائر","إن يخفقا لَكَ قرطق ووشاح",86,"ح",1,0],["وَحَشىً ألهب الفراق حواشي","ها لأحرى حشىً ببلِّ الأوامِ",87,"م",1,0],["وحَشَوا بالصواعقِ الأرض حتى","نَمَّ قيد الأُظفور عن بركان",88,"ن",1,0],["وحش الفلا تبكيه في فلواتها","وحمائم الاغصان في اغصانها",89,"ن",3,0],["وحشّية هذه العروس فما","تطلب إلا وحشاً له تفِد",90,"د",1,0],["وحشتي بعدك ليست تنقضي","فكأني لا أرى من بشر",91,"ر",1,0],["وحشة في منتدى أو سكن","وشعور منك بالعيش مهين",92,"ن",1,0],["وحَشى الحشاء بلَوعَةٍ وتَحَزُّنٍ","وزفير وَجدٍ يُعدِمُ الإِيجادا",93,"د",2,0],["وحشتي لابن سُهيلٍ","أسهرتني طولَ ليلي",94,"ل",2,1],["وحشري في جواركم عليكم","صلاة الله ما همت الغوادي",95,"د",2,0],["وحَشاهم على الطَوَى كُلَّ يومٍ","مُنطَوٍ ما أَرَوهُ قطًّ نِياحا",96,"ح",2,0],["وحَشايَ المُصابُ من أَسهمُ الأَو","زارِ تَدمَى جِراحُهُ وتَقِيحُ",97,"ح",1,0],["وَحشاشةُ المريخ شبَّ أُوارُها","مِن غَيظِه فَلَهيبُهُ لم يخمد",98,"د",1,0],["وَحَشاشَتي وَقَوامُه","بَين اضطرابٍ وَاهتزاز",99,"ز",1,0],["وحشا مدرج القُصا","صِ بمسكٍ ورصَّفا",100,"ف",2,0],["وحشيةق ظلت تناغي جؤذرا","ترضعه الدر ويرنو 