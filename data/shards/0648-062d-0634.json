{"poems":[[53,"أشكو إليك مدامعا تكف","https://www.aldiwan.net/poem29967.html","الكامل"],[53,"لحيا عهدهن حيا العهاد","https://www.aldiwan.net/poem30619.html","الوافر"],[3,"هل غادر الشعراء من متردم","https://www.aldiwan.net/poem85.html","الكامل"],[35,"إربع فحي معارف الأطلال","https://www.aldiwan.net/poem39096.html","الكامل"],[72,"تحلو الثغور بذكرك المتردد","https://www.aldiwan.net/poem18546.html","الكامل"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[51,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[26,"أصبح من أم عمرو بطن مر فأج","https://www.aldiwan.net/poem24101.html","البسيط"],[70,"يا قلب بعض الناس هل","https://www.aldiwan.net/poem42398.html","مجزوء الكامل"],[43,"الرأي قبل شجاعة الشجعان","https://www.aldiwan.net/poem10580.html","الكامل"],[45,"يكاد يبدي لسعدى غيب ما أجد","https://www.aldiwan.net/poem63477.html","البسيط"],[45,"ألما يكف في طللي زرود","https://www.aldiwan.net/poem63486.html","الوافر"],[61,"أجل هو الفتح لا فتح يشاكله","https://www.aldiwan.net/poem51478.html","البسيط"],[66,"لسيري في الفلا والليل داج","https://www.aldiwan.net/poem41557.html","الوافر"],[80,"حركات إلى السكون تؤول","https://www.aldiwan.net/poem31320.html","الخفيف"],[44,"أطلالهم سلبت دماها الهيفا","https://www.aldiwan.net/poem30403.html","الكامل"],[44,"أرأيت أي سوالف وخدود","https://www.aldiwan.net/poem30556.html","الكامل"],[44,"سقى عهد الحمى سبل العهاد","https://www.aldiwan.net/poem30558.html","الكامل"],[90,"يا أم عوف عجيبات ليالينا","https://www.aldiwan.net/poem60157.html","عموديه"],[31,"حي الرباب وتربها","https://www.aldiwan.net/poem42653.html","مجزوء الكامل"],[105,"يا غاديا ببريد الشام ينتحب","https://www.aldiwan.net/poem43094.html","الكامل"],[75,"أمن أفقها ذاك السنا وتألقه","https://www.aldiwan.net/poem69058.html","الطويل"],[19,"صحا قلبه عن سُكره فتأملا","https://www.aldiwan.net/poem356.html",""],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/13469","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54284","الخفيف"],[106,"شبح الحرب","https://www.poetsgate.com/ViewPoem.aspx?id=179421",""],[158,"لو يستطيع تخطي الأيام","https://www.aldiwan.net/poem58849.html","الطويل"],[158,"قد أوعدتني بالزيارة في الكرى","https://www.aldiwan.net/poem58874.html","الكامل"],[158,"يا من لدمع مارقي وصبيبه","https://www.aldiwan.net/poem58943.html","الكامل"],[163,"نأت سلمى وأمست في عدو","https://www.aldiwan.net/poem719.html",""],[167,"كره الله ما أحب الأعادي","https://www.aldiwan.net/poem1621.html",""],[183,"وافى بفقاع أرج","https://www.aldiwan.net/poem14135.html","مجزوء الكامل"],[187,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[193,"ليت شعري هل تخبرني الديار","https://www.aldiwan.net/poem54408.html","الخفيف"],[221,"سل البدر بالضياء الظلاما","https://www.aldiwan.net/poem41867.html","الخفيف"],[224,"مأساة البدارى","https://www.aldiwan.net/poem24222.html","عموديه"],[227,"ما تمناك جعفر يا منى جع","https://www.aldiwan.net/poem50742.html","الخفيف"],[268,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[273,"أهلا بهن أهلة وكواكبا","https://www.aldiwan.net/poem25628.html","الكامل"],[301,"ولقد ذكرتكتم بحرب ينثني","https://www.aldiwan.net/poem58212.html","الكامل"],[301,"يفديك جفن قد نفى عنه الكرى","https://www.aldiwan.net/poem58214.html","الكامل"],[302,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[307,"ناديت سكان القبور فأسكتوا","https://www.aldiwan.net/poem50327.html","الكامل"],[308,"قدحت يد الأشواق من زندي","https://www.aldiwan.net/poem59518.html","أحذ الكامل"],[326,"فيك معنى من المعاني بعيد","https://www.aldiwan.net/poem54991.html","الخفيف"],[355,"أبعيد الشباب هوى وصبا","https://www.aldiwan.net/poem4177.html","المتدارك"],[365,"مثل عداء بروضات القطا","https://www.aldiwan.net/poem4617.html","الرمل"],[377,"لا يخدعنك جمال صوره","https://www.aldiwan.net/poem48759.html","مجزوء الكامل"],[388,"يبسم الله مفتاح","https://www.aldiwan.net/poem54609.html","عموديه"],[413,"جميل الصنيع بأهل الأدب","https://www.aldiwan.net/poem53855.html","المتقارب"],[413,"هلا نظرت إلى الكئيب الواله","https://www.aldiwan.net/poem54023.html","الكامل"],[429,"أحسن من وصف ديار الطائف","https://www.aldiwan.net/poem12671.html","الرجز"],[438,"الرزء من قلقي أجل وأعظم","https://www.aldiwan.net/poem14482.html","الكامل"],[451,"بوركت يا شعب الكنانة ثائرا","https://www.aldiwan.net/poem61626.html","الكامل"],[473,"هل تعرف المنزل بالأهيل","https://www.aldiwan.net/poem1825.html","السريع"],[481,"هجرت أمامة هجراً طويلا","https://www.aldiwan.net/poem2071.html","المتقارب"],[522,"نبي براه الله من نوره الأسمى","https://www.aldiwan.net/poem13283.html","الطويل"],[549,"خذوا من جفوني ماءها فهي ذرف","https://www.aldiwan.net/poem47400.html","الطويل"],[556,"نحن قوم متنا به وفنينا","https://www.aldiwan.net/poem33804.html","الخفيف"],[560,"صدر به سعة وشوق أوسع","https://www.aldiwan.net/poem52989.html","الكامل"],[565,"وحشية العينين مياسة","https://www.aldiwan.net/poem69688.html","مجزوء الكامل"]],"verses":[["وَحَشاً إِذا ذُكِرَ الفِراقُ هَفا","في جانِبَيهِ الشَوقُ وَالأَسَفُ",0,"ف",1,0],["وَحَشوُ أَكُفِّهِم سُمرٌ رِواءٌ","بِوِردِ المَوتِ مِن مُهَجٍ صَوادِ",1,"د",1,0],["وَحَشِيَّتي سَرجٌ عَلى عَبلِ الشَوى","نَهدٍ مَراكِلُهُ نَبيلِ المَحزِمِ",2,"م",1,0],["وَحشاً تَعاوَرَها الرِياحُ كَأَنَّها","تَوشيحُ عَصبِ مُسَهَّمِ الأَغيالِ",3,"ل",1,0],["وحشاشة لم يبق فيها للأسى","والهمّ إلا نبذة وكأنْ قد",4,"د",1,0],["وحشا مسامعَهُ بها","فحمى مُعاتِبَه عِتابهْ",5,"ب",2,0],["وحشةَ النِّضْو للنَّسيم إذا أعْ","وَزَ وهْو المأكول والمشروبُ",6,"ب",1,0],["وحشةَ المجدِبِ المُقلّ دَهَتْهُ","نُقْلَةُ الغيثِ حين كاد يَصوبُ",6,"ب",1,0],["وحشةَ الفردِ غُيِّبَ النُّورُ عنهُ","في سُهوبٍ أمامهنّ سُهُوبُ",6,"ب",1,0],["وحشة العبدِ للمليك وليستْ","وحشةَ الكُفءِ والمعاني ضُروبُ",6,"ب",1,0],["وَحشاً سِوى أَنَّ فُرّادَ السِباعِ بِها","كَأَنَّها مِن تَبَغّى الناسِ أَطلاحُ",7,"ح",1,0],["وَحُشاشَةٍ ما أَبقَتِ ال","أَشواقُ مِنها باقِيَه",8,"ي",2,0],["وَحَشاهُ عادِيَةً بِغَيرِ قَوائِمٍ","عُقمَ البُطونِ حَوالِكَ الأَلوانِ",9,"ن",1,0],["وَحشٌ تَأَبَّدَ في تِلكَ الطُلولِ وَقَد","تَكونُ أُنّاسَهُنَّ الأُنَّسُ الخُرُدُ",10,"د",1,0],["وَحَشوُ كَتيبَةٍ جُعِلَت غِشاءً","لِعَينِ الشَمسِ مِن لَهَبِ الحَديدِ",11,"د",1,0],["وَحْشاً من السَّبي آنَسْتَ الكُماةَ به","سِيَّانِ في الحُسْنِ حاليهِ وعاطِلُه",12,"ل",2,0],["وَحَشّي بِالكُؤوسِ إِلى بَواطٍ","ظَواهِرُهُنَّ غابٌ وَالبَواطِن",13,"ن",1,0],["وحشا الجوِّ حَشْوُه نارُ برقٍ","إنّه في ضلوعِهِ لَغَلِيلُ",14,"ل",1,0],["وَحَشاً تُحَرِّقُهُ النَصيحَةُ وَالهَوى","لَو أَنَّهُ وَقتٌ لَكانَ مَصيفا",15,"ف",2,0],["وَحشِيَّةٌ تَرمي القُلوبَ إِذا اِغتَدَت","وَسنى فَما تَصطادُ غَيرَ الصيدِ",16,"د",1,0],["وَحَشوُ حَوادِثِ الأَيّامِ مِنهُم","مَعاقِلُ مُطرَدٍ وَبَنو طِرادِ",17,"د",1,0],["وحشٌ وإنْ روَّضَ الإِنسيُّ جامحَها","قفرٌ وإنْ مُلئتْ ورداً ونِسرينا",18,"ن",2,0],["وَحشِيَّةً إِنسِيَّةً","خَرّاجَةً مِن بابِها",19,"ب",3,0],["وَحشِيَّةِ الدارِ وَالأَنسابِ ما بَرَحَت","خَلفَ الطَرائِدِ في الآفاقِ تَنسَرِبُ",20,"ب",1,0],["وَحَشْوَ القِبابِ المستقِلّةِ غَادَةٌ","أُجَدِّدُ عَهدَ الوُدِّ منها وتُخلِقُه",21,"ق",2,0],["وَحَشوَ جَفيرٍ مِن فُروعٍ غَرائِبٍ","تَنَطَّعَ فيها صانِعٌ وَتَنَبَّلا",22,"ل",2,0],["وحَشَرَ الأطرافَ والثُّغورَا","ورَفضَ اللَّذاتِ والحُبورَا",23,"ر",2,0],["وَحَشوا حَشا الظَلماءِ مِلءَ جَنانِها","حَتّى تَصَدَّعَ بِالصَديعِ البادي",24,"ي",1,0],["وَحَشَدْنَا الأَلْلَاظَ أَنْقَى مِنَ الْمَاءِ","وَأشْهَى مَسَاغَةً وَوُرُودا",25,"د",2,0],["وحشوا أنوف القوم غازٌ مسمَّم","وللنار في أبدانهم مرتع خصب",26,"ب",1,0],["وحشدتَ فيه الجيشَ واجتمع الملا","كالحشرِ أقدامٌ على أقدامِ",27,"م",1,0],["وحشدَت جندك ناهضاً لزفافه","فملأت أقطار البسيطة عسكرا",28,"ر",2,0],["وحشى تعشقه الغرام وحله","قسرا وليس بكفوه وضريبه",29,"ب",2,0],["وحش رواحة القرشي رحلي","بناقته ولم ينظر ثوابا",30,"ب",2,0],["وَحَشا تِلكُمُ المَدارِسَ بِالكُت","بِ الشَريفَةِ الصَحيحَةِ الإِسنادِ",31,"د",1,0],["وحَشا قلوبَ سَذابه","منه بكل فمٍ حَرِج",32,"ج",1,0],["وَحَشاه بِحكمةٍ وبإيما","نٍ وتمَّ الختام تمّ الوكاءُ",33,"ا",2,0],["وَحشُ بَرِّيَةٍ بِها وَلَدَتهُ","أُمُّهُ لا يَزولُ مِنها الصِيارُ",34,"ر",1,0],["وحشةُ اللَيلِ وَالسَكينَةُ وَالصَم","تُ وَمرُّ النَسيمِ كانَ كلاما",35,"م",2,0],["وحشية كشف الزمان حجابها","لا بل أشد من الوحوش وأظلم",36,"م",1,0],["وَحَّش الناس قرب أرضك حتّى","أصبحوا للعيون هاماً وجِنّا",37,"ن",2,0],["وحَشَّدَ لِلأحرارِ زحفاً مُضرِّساً","مُضرَّىً قد اعتادَ الفَواتِكَ والضّرى",38,"ر",2,0],["وَحْشِيّةٌ في فَازَة بِمَفازَةٍ","يَنزو الجنانُ الوَحشُ مِنها راهِبا",39,"ب",2,0],["وحشاشةُ الأبطال قد تلفت ظما","ودمُ الفوارس مستهل صيبُ",40,"ب",1,0],["وحشاشةٌ في حشوها نارُ الأسى","وجوى يزيدُ وعبرةٌ تترقرقُ",41,"ق",1,0],["وحشر وميزان ونار وجنة","وجسر وحوض طيب الماء عاطر",42,"ر",1,0],["وَحَشَوتُ أَعيُنَهُم تُراباً بَعدَما","كانَت تَأَذّى بِاليَسيرِ مِنَ القَذا",43,"ا",1,0],["وحشية الأنساب ما أنست","في فوحش البيداء بالقود",44,"د",1,0],["وحشدتُ الخواطر الهيم تنسا","بُ لتفنى في موجد الهدار",45,"ر",1,0],["وَحشٍ في العُربِ مَنازِلُهُ","مَجهولِ الأصلِ إذا نُسِبا",46,"ب",2,0],["وَحَشَوتُ الغَيظَ فِي أَضلاعِهِ","فَهوَ يَمشِي حَظَلاناً كَالنَّقِرْ",47,"ر",1,0],["وَحشية شرك القَضا","ء أَصارها عِندي أَسيرَه",48,"ر",2,0],["وحشر تحت ظل","لواراعى الشفاعات",49,"ت",1,0],["وحشر مع الغانيات الحسان","إذا حشر المرء معْ من أحب",50,"ب",1,0],["وحشاشة تورى عليك وناظر","ممَّن دعا لوبالها ووباله",51,"ل",2,0],["وحُشيَتْ حشوَ خبيرٍ عارفِ","وجادَها عارضُ حُلْوٍ واكِفِ",52,"ف",1,0],["وحشا حشاها البين باكره قانيا","كادت ببيني النواظر تسحم",53,"م",1,0],["وَحشٌ للاستعمارِ يُمعنُ شَرُّهُ","باسمِ الحضارةِ والتَّقدمِ ساخرا",54,"ر",2,0],["وَحشاً تُعَفّيهِ سَوافي الصَبا","وَالصَيفُ إِلّا دَمَنَ المَنزِلِ",55,"ل",1,0],["وَحُشّوا الحُروبَ إِذا أوقِدَت","رِماحاً طِوالاً وَخَيلاً فُحولا",56,"ل",2,0],["وَحَشر جَميع الرُّسل تَحتَ لِوائِهِ","فَلِلّه ما أَسناه مَجداً وَما أَسما",57,"م",2,0],["وحشو ضلوعي كلُّ نَجلاءَ ثَرَّةٍ","متى ألَّفوها أقْسَمَتْ لا تألَّفُ",58,"ف",1,0],["وحُشرنا إليه عمن سواه","ودخلنا جنانه خالدينا",59,"ن",2,0],["وَحُشاشةٌ مَسلوبَةٌ وَلَعَلَّها","ذَهَبَت عَلى أَثَرِ الفُؤادِ تُودِّعُ",60,"ع",1,0],["وَحْشِيَّةُ العَيْنَيْنِ مياسَةُ ال","عِطْفَيْنِ من تَرْبيَةِ القَصْرِ",61,"ر",1,1]]}