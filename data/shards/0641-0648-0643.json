{"poems":[[53,"سبغت نعمة ودام صفاء","https://www.aldiwan.net/poem7955.html","الخفيف"],[463,"أمكنت العاذل من قيادها","https://www.aldiwan.net/poem56218.html","الرجز"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38321","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59412","الكامل"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93095","الكامل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104956","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33666","المتقارب"],[5186,"مخرت تحمل خمرا، وجعه","https://www.poetsgate.com/ViewPoem.aspx?id=156525",""],[5906,"أوتار حائرة","https://www.poetsgate.com/ViewPoem.aspx?id=188311",""]],"verses":[["فُوكَ مَجْنى حِجاً ووجهك شمسٌ","ويميناك مُزنةٌ وَطْفاءُ",0,"ف",3,0],["فوكِّل الجودَ على نفسك في","قضائها ومُرْهُ بافتقادِها",1,"د",3,0],["فوكَ لا فُضَّ بَل وَلا عاشَ من","يَجفو وَلا قَد خانَت لَكَ الأذهانُ",2,"ن",1,0],["فوكبريائي لأقسمن اليوم ما","بيني وبينك بالطريق الأعدل",3,"ل",1,0],["فوكلت لله الأمور","وقلت صبراً واحتسابا",4,"ب",2,0],["فوكل بها عينيك فهي كواكب","لدرِّيها أعياني العدُّ والحصر",5,"ر",1,0],["فوكلتَهُ بالذي إن يَدُم","سيأتي على نفسِ إنسانهِ",6,"ن",2,0],["فوكوا كيسا من الفحم به","وبه غاص فألفى مرجعه",7,"ع",2,0],["فَوَكيفَ أُلَمْلِمُ أحْْزانيْ","من آه ُ تسكن منحَدريْ",8,"ر",2,0]]}