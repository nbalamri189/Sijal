{"poems":[[53,"تأمل أن تفرح في دار الحزن","https://www.aldiwan.net/poem29747.html","الرجز"],[53,"تأبى الليالي أن تديما","https://www.aldiwan.net/poem29749.html","مجزوء الكامل"],[53,"جربت آل الغوث ثم تركتهم","https://www.aldiwan.net/poem30456.html","الكامل"],[63,"ومفيقين من الله","https://www.aldiwan.net/poem46080.html","مجزوء الرمل"],[63,"هو ما ترى فأقل من تعنيفي","https://www.aldiwan.net/poem46129.html","الكامل"],[77,"يا ربة البيت الممنع جاره","https://www.aldiwan.net/poem36516.html","الكامل"],[9,"أجبير هل لأسيركم من فادي","https://www.aldiwan.net/poem21925.html","الكامل"],[54,"إذا غزونا فمغزانا بأنقرة","https://www.aldiwan.net/poem27633.html","البسيط"],[91,"من أين جئت وكيف عجت ببابي","https://www.aldiwan.net/poem8751.html","عموديه"],[92,"اسكني يا جراح","https://www.aldiwan.net/poem38902.html","مجزوء المتدارك"],[85,"لا والزبيب ومزة من حمص","https://www.aldiwan.net/poem7261.html","الكامل"],[85,"فلوس الشغل ما تأخير","https://www.aldiwan.net/poem7900.html","الكامل"],[43,"ما للمروج الخضر والحدائق","https://www.aldiwan.net/poem9743.html","الرجز"],[62,"بالعدل قام الخلق وهو ملاكه","https://www.aldiwan.net/poem52153.html","الكامل"],[45,"في غير شأنك بكرتي وأصيلي","https://www.aldiwan.net/poem65605.html","الكامل"],[28,"لا قوم أكرم من تميم إذ غدت","https://www.aldiwan.net/poem5479.html","الكامل"],[28,"أبني لجيم إنكم ألجمتم","https://www.aldiwan.net/poem5606.html","الكامل"],[28,"قد بلغنا على مخشاة أنفسنا","https://www.aldiwan.net/poem5633.html","البسيط"],[61,"أقصر الزاجر عنه فازدجر","https://www.aldiwan.net/poem51677.html","الرمل"],[58,"أحسين إني واعظ ومؤدب","https://www.aldiwan.net/poem31150.html","الكامل"],[97,"أين شط الرجاء","https://www.aldiwan.net/poem25074.html","مجزوء الخفيف"],[44,"دمن ألم بها فقال سلام","https://www.aldiwan.net/poem30368.html","الكامل"],[90,"ياسيدي أسعف فمي ليقولا","https://www.aldiwan.net/poem56781.html","عموديه"],[105,"أمم العروبة جاء يومك فاعلمي","https://www.aldiwan.net/poem41936.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85561","المجتث"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39651","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55018","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54326","الكامل"],[77,"يا ربة البيت الممنع جاره","https://www.poetsgate.com/ViewPoem.aspx?id=34095",""],[90,"تحرك اللحد !","https://www.poetsgate.com/ViewPoem.aspx?id=179160",""],[28,"أبني لجيم إنكم ألجمتم","https://www.poetsgate.com/ViewPoem.aspx?id=20012",""]],"verses":[["وَالضارِبينَ الهامَ في مُشعَلَةٍ","لَها بِلا نارٍ ضِرامٌ وَدَخَن",0,"ن",1,0],["وَالضَيمُ أَروَحُ مِنهُ مَط","رورُ الظُبى بَلَغَ الصَميما",1,"م",2,0],["وَالضارِبينَ عَلَيَّ بَيتَ زِمامَةٍ","خَسَأَ العَدُوَّ فَما يُطيقُ ضِراري",2,"ي",1,0],["وَالضُّبَيْبِيَّاتُ خُوصٌ","وَبِها نُجْلُ الجِراحِ",3,"ح",1,0],["والضّرْبَةُ الأخْدودُ لم يُعْجَمْ لَها","سَطْرٌ بِعاجِلِ طَعْنَةٍ إخْطيفِ",4,"ف",1,0],["والضّرْعُ أصْبَحَ منْهُ بعْدَ حُفولِهِ","جفّتْ غَضارَتُهُ وغاضَ سَحارُهُ",5,"ر",2,0],["وَالضامِنينَ بِقَومِهِم يَومَ الوَغى","لِلحَمدِ يَومَ تَنازُلٍ وَطِرادِ",6,"د",1,0],["وَالضَيفُ يَعلَمُ أَنِّيَ حينَ يَطرُقُني","ماضي الجَنانِ عَلى كَفّي وَمَقدِرَتي",7,"ي",1,0],["وَالضارِبينَ بِكُلِّ سَيفٍ في الوَغى","وَالخانِعينَ لِكُلِّ ذي قِرضابِ",8,"ب",1,0],["والضِّيا والظِّلالْ","والشَّذَى والورودْ",9,"د",1,0],["والضرب في طول الجيوب وعرضها","بتلطف وتحيل وتلصص",10,"ص",1,0],["والضرب فوق الظهر وهو مطاوع","والضرب فوق البطن وهو مواتي",11,"ت",2,0],["وَالضَربِ في الأَوجُهِ وَالمَفارِقِ","وَالسَيرِ في ظِلِّ اللِواءِ الخافِقِ",12,"ق",1,0],["والضدّ غالب ضدّه وبقهره","ظهر السكون وبان منه حراكُه",13,"ك",2,0],["وَالضارِبونَ بِسُهمَةٍ مَعروفَةٍ","في التاجِ ذي الشُرُفاتِ وَالإِكليلِ",14,"ل",1,0],["وَالضامِنونَ عَلى المَنِيَّةِ جارَهُم","وَالمُطعِمونَ غَداةَ كُلَّ شَمالِ",15,"ل",1,0],["وَالضارِبونَ الكَبشَ يَبرُقُ بَيضُهُ","وَالمُثبِتونَ مَواطِئَ الأَقدامِ",16,"م",1,0],["وَالضارِبونَ مِنَ الأَقرانِ هامَهُمُ","إِذا الجَبانُ رَأى لِلمَوتِ أَلوانا",17,"ن",2,0],["والضُّحى أدهمُ في النَّقعِ فإنْ","ضَحِكَتْ فيه الظُّبا كان أغَرّ",18,"ر",1,0],["وَالضَيفُ أَكرِم ما اِستَطَعتَ جِوارَهُ","حَتّى يَعُدُّكَ وارِثاً يَتَنَسَبُ",19,"ب",1,0],["والضنى والشحوب","وخيال الوَداع",20,"ع",1,0],["وَالضَربُ يُقعِدُ قَرمَ كُلِّ كَتيبَةٍ","شَرِسِ الضَريبَةِ وَالحُتوفُ قِيامُ",21,"م",1,0],["والضَّارِعَاتُ مَعِي، مَصَائِرُ أُمَّةٍ","ألاّ يَعُودَ بها العَزِيزُ ذَلِيلا",22,"ل",2,0],["والضَّعفُ للضَّعفِ المُهَدَّدِ قُوَّةٌ","تَمضِي فتدفعُ قُوّةَ المُتَهجِّمِ",23,"م",1,0],["وَالضغط يأَتي انفجارا","يبيد من غير مهل",24,"ل",1,0],["والضوءُ فوق الخصور منهمرٌ","والماء تحت الصدور مستعرُ",25,"ر",1,0],["وَالضَّوَارِي انْطلَقَتْ لاَ تَأْتَلِي","مَا الْتَقَتْ عَضّاً وَتمزِيقاً وَكسْرا",26,"ر",2,0],["وَالضَّادُ تَأْسَى لِفَقْدِ ذُخْرٍ","بِرَغْمِهَا أَنَّهُ أُضِيَعا",27,"ع",2,0],["والضاد حسب الضاد فخراً أنها","كانت لسان اللّه في فرقانه",28,"ن",2,0],["والضرع أصبح منه بعد جفوله","جفت غضارته وغاض سماره",29,"ر",2,0],["والضاربُ الضربةَ لصَدمتِها","لحمُ العُلوج على الأقدام ينتثر",30,"ر",1,0],["وَالضّارِبُونَ الكَبْش يَبْرُقُ بَيضُهُ،","وَالمُثْبِتُونَ مَوَاطىءَ الأقْدامِ",31,"م",1,0]]}