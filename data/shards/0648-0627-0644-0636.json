{"poems":[[53,"تأمل أن تفرح في دار الحزن","https://www.aldiwan.net/poem29747.html","الرجز"],[53,"تأبى الليالي أن تديما","https://www.aldiwan.net/poem29749.html","مجزوء الكامل"],[53,"جربت آل الغوث ثم تركتهم","https://www.aldiwan.net/poem30456.html","الكامل"],[63,"ومفيقين من الله","https://www.aldiwan.net/poem46080.html","مجزوء الرمل"],[63,"هو ما ترى فأقل من تعنيفي","https://www.aldiwan.net/poem46129.html","الكامل"],[77,"يا ربة البيت الممنع جاره","https://www.aldiwan.net/poem36516.html","الكامل"],[9,"أجبير هل لأسيركم من فادي","https://www.aldiwan.net/poem21925.html","الكامل"],[54,"إذا غزونا فمغزانا بأنقرة","https://www.aldiwan.net/poem27633.html","البسيط"],[91,"من أين جئت وكيف عجت ببابي","https://www.aldiwan.net/poem8751.html","عموديه"],[92,"اسكني يا جراح","https://www.aldiwan.net/poem38902.html","مجزوء المتدارك"],[85,"لا والزبيب ومزة من حمص","https://www.aldiwan.net/poem7261.html","الكامل"],[85,"فلوس الشغل ما تأخير","https://www.aldiwan.net/poem7900.html","الكامل"],[43,"ما للمروج الخضر والحدائق","https://www.aldiwan.net/poem9743.html","الرجز"],[62,"بالعدل قام الخلق وهو ملاكه","https://www.aldiwan.net/poem52153.html","الكامل"],[45,"في غير شأنك بكرتي وأصيلي","https://www.aldiwan.net/poem65605.html","الكامل"],[28,"لا قوم أكرم من تميم إذ غدت","https://www.aldiwan.net/poem5479.html","الكامل"],[28,"أبني لجيم إنكم ألجمتم","https://www.aldiwan.net/poem5606.html","الكامل"],[28,"قد بلغنا على مخشاة أنفسنا","https://www.aldiwan.net/poem5633.html","البسيط"],[61,"أقصر الزاجر عنه فازدجر","https://www.aldiwan.net/poem51677.html","الرمل"],[58,"أحسين إني واعظ ومؤدب","https://www.aldiwan.net/poem31150.html","الكامل"],[97,"أين شط الرجاء","https://www.aldiwan.net/poem25074.html","مجزوء الخفيف"],[44,"دمن ألم بها فقال سلام","https://www.aldiwan.net/poem30368.html","الكامل"],[90,"ياسيدي أسعف فمي ليقولا","https://www.aldiwan.net/poem56781.html","عموديه"],[105,"أمم العروبة جاء يومك فاعلمي","https://www.aldiwan.net/poem41936.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85561","المجتث"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39651","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55018","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54326","الكامل"],[77,"يا ربة البيت الممنع جاره","https://www.poetsgate.com/ViewPoem.aspx?id=34095",""],[100,"ثائران","https://www.poetsgate.com/ViewPoem.aspx?id=50176",""],[100,"مآتم وأعراس","https://www.poetsgate.com/ViewPoem.aspx?id=50173",""],[90,"تحرك اللحد !","https://www.poetsgate.com/ViewPoem.aspx?id=179160",""],[28,"أبني لجيم إنكم ألجمتم","https://www.poetsgate.com/ViewPoem.aspx?id=20012",""],[109,"بان الخليط ضحى من الجرعاء","https://www.aldiwan.net/poem16224.html","الكامل"],[115,"أي يوم يا ريم عيني تراكا","https://www.aldiwan.net/poem40860.html","عموديه"],[117,"الغلاء الوحش","https://www.aldiwan.net/poem24033.html","الرمل"],[132,"في اجتناب الأتاي للمرء ذام","https://www.aldiwan.net/poem54743.html","الخفيف"],[147,"يا رب يا رب يا رب الأنام ومن","https://www.aldiwan.net/poem47639.html","البسيط"],[160,"برغم سنة خير العجم والعرب","https://www.aldiwan.net/poem59217.html","البسيط"],[166,"لي في الشجاعة سهم ما ضربت به","https://www.aldiwan.net/poem46873.html","البسيط"],[174,"ومحجب نبهته","https://www.aldiwan.net/poem46028.html","مجزوء الكامل"],[181,"يا صاحبى قفا على الأطلال","https://www.aldiwan.net/poem58842.html","الكامل"],[189,"عج بالمدينة تلق ثم كريما","https://www.aldiwan.net/poem35109.html","الكامل"],[197,"حي الأساتذة الكرام تحية","https://www.aldiwan.net/poem39949.html","الكامل"],[197,"كفكف بربك دمعك الهتانا","https://www.aldiwan.net/poem39950.html","الكامل"],[216,"أجُبيل إن أباك كاربُ يومه","https://www.aldiwan.net/poem683.html",""],[237,"أملى الهنا والسعد ردد","https://www.aldiwan.net/poem18140.html","مجزوء الكامل"],[287,"بكرت لتحزن عاشقاً طفل","https://www.aldiwan.net/poem1914.html","أحذ الكامل"],[297,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[306,"صرمت ظليمة خلتي ومراسلي","https://www.aldiwan.net/poem25.html","الكامل"],[322,"بان الخليط فشطوا بالرعابيب","https://www.aldiwan.net/poem56349.html","البسيط"],[328,"بين همس الشفاه والأحداق","https://www.aldiwan.net/poem55035.html","الخفيف"],[342,"الضحايا معناهم الشهداء","https://www.aldiwan.net/poem55366.html","الخفيف"],[348,"يا أيها الملك الذي أيامه","https://www.aldiwan.net/poem20243.html","الكامل"],[348,"أي عيد مضى ومملوكك الو","https://www.aldiwan.net/poem20252.html","الخفيف"],[366,"لم يطمع الليل مني أن أرق له","https://www.aldiwan.net/poem17016.html","البسيط"],[366,"أهذه سير في المجد أم سور","https://www.aldiwan.net/poem17202.html","البسيط"],[367,"فهي خذواء بعيش ناعم","https://www.aldiwan.net/poem4620.html","الرمل"],[416,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[453,"هل للأمير أعز الله حكمته","https://www.aldiwan.net/poem61281.html","البسيط"],[458,"من موصل بالسؤال والقسم","https://www.aldiwan.net/poem55894.html","المنسرح"],[458,"نبهته فقام مشبوح العضد","https://www.aldiwan.net/poem56228.html","الرجز"],[461,"كبت جفان الحي من دارم","https://www.aldiwan.net/poem15098.html","السريع"],[464,"شهرت علي صوارم العذل","https://www.aldiwan.net/poem3349.html","عموديه"],[551,"ما قربوا إلا لبين نوقا","https://www.aldiwan.net/poem47365.html","الكامل"],[551,"تلك الديار برامتين همود","https://www.aldiwan.net/poem47881.html","الكامل"],[551,"أعلى الركائب سارت الأحداج","https://www.aldiwan.net/poem48017.html","الكامل"],[551,"زعازع ثم نكب","https://www.aldiwan.net/poem48102.html","الطويل"],[558,"ليس الوجود كما يقال اثنان","https://www.aldiwan.net/poem33757.html","الكامل"],[558,"لا بد للضيق في الدنيا من الفرج","https://www.aldiwan.net/poem34691.html","البسيط"],[561,"وبلدة بعيدة النياط","https://www.aldiwan.net/poem27843.html","الرجز"],[567,"عادلة الأجزاء قد برئت","https://www.aldiwan.net/poem69719.html","السريع"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"أسير عنك بقلب عن هواك سلا","https://www.aldiwan.net/poem3033.html","البسيط"],[575,"كحل العيون بمرود من عسجد","https://www.aldiwan.net/poem3085.html","الكامل"]],"verses":[["وَالضارِبينَ الهامَ في مُشعَلَةٍ","لَها بِلا نارٍ ضِرامٌ وَدَخَن",0,"ن",1,0],["وَالضَيمُ أَروَحُ مِنهُ مَط","رورُ الظُبى بَلَغَ الصَميما",1,"م",2,0],["وَالضارِبينَ عَلَيَّ بَيتَ زِمامَةٍ","خَسَأَ العَدُوَّ فَما يُطيقُ ضِراري",2,"ي",1,0],["وَالضُّبَيْبِيَّاتُ خُوصٌ","وَبِها نُجْلُ الجِراحِ",3,"ح",1,0],["والضّرْبَةُ الأخْدودُ لم يُعْجَمْ لَها","سَطْرٌ بِعاجِلِ طَعْنَةٍ إخْطيفِ",4,"ف",1,0],["والضّرْعُ أصْبَحَ منْهُ بعْدَ حُفولِهِ","جفّتْ غَضارَتُهُ وغاضَ سَحارُهُ",5,"ر",2,0],["وَالضامِنينَ بِقَومِهِم يَومَ الوَغى","لِلحَمدِ يَومَ تَنازُلٍ وَطِرادِ",6,"د",1,0],["وَالضَيفُ يَعلَمُ أَنِّيَ حينَ يَطرُقُني","ماضي الجَنانِ عَلى كَفّي وَمَقدِرَتي",7,"ي",1,0],["وَالضارِبينَ بِكُلِّ سَيفٍ في الوَغى","وَالخانِعينَ لِكُلِّ ذي قِرضابِ",8,"ب",1,0],["والضِّيا والظِّلالْ","والشَّذَى والورودْ",9,"د",1,0],["والضرب في طول الجيوب وعرضها","بتلطف وتحيل وتلصص",10,"ص",1,0],["والضرب فوق الظهر وهو مطاوع","والضرب فوق البطن وهو مواتي",11,"ت",2,0],["وَالضَربِ في الأَوجُهِ وَالمَفارِقِ","وَالسَيرِ في ظِلِّ اللِواءِ الخافِقِ",12,"ق",1,0],["والضدّ غالب ضدّه وبقهره","ظهر السكون وبان منه حراكُه",13,"ك",2,0],["وَالضارِبونَ بِسُهمَةٍ مَعروفَةٍ","في التاجِ ذي الشُرُفاتِ وَالإِكليلِ",14,"ل",1,0],["وَالضامِنونَ عَلى المَنِيَّةِ جارَهُم","وَالمُطعِمونَ غَداةَ كُلَّ شَمالِ",15,"ل",1,0],["وَالضارِبونَ الكَبشَ يَبرُقُ بَيضُهُ","وَالمُثبِتونَ مَواطِئَ الأَقدامِ",16,"م",1,0],["وَالضارِبونَ مِنَ الأَقرانِ هامَهُمُ","إِذا الجَبانُ رَأى لِلمَوتِ أَلوانا",17,"ن",2,0],["والضُّحى أدهمُ في النَّقعِ فإنْ","ضَحِكَتْ فيه الظُّبا كان أغَرّ",18,"ر",1,0],["وَالضَيفُ أَكرِم ما اِستَطَعتَ جِوارَهُ","حَتّى يَعُدُّكَ وارِثاً يَتَنَسَبُ",19,"ب",1,0],["والضنى والشحوب","وخيال الوَداع",20,"ع",1,0],["وَالضَربُ يُقعِدُ قَرمَ كُلِّ كَتيبَةٍ","شَرِسِ الضَريبَةِ وَالحُتوفُ قِيامُ",21,"م",1,0],["والضَّارِعَاتُ مَعِي، مَصَائِرُ أُمَّةٍ","ألاّ يَعُودَ بها العَزِيزُ ذَلِيلا",22,"ل",2,0],["والضَّعفُ للضَّعفِ المُهَدَّدِ قُوَّةٌ","تَمضِي فتدفعُ قُوّةَ المُتَهجِّمِ",23,"م",1,0],["وَالضغط يأَتي انفجارا","يبيد من غير مهل",24,"ل",1,0],["والضوءُ فوق الخصور منهمرٌ","والماء تحت الصدور مستعرُ",25,"ر",1,0],["وَالضَّوَارِي انْطلَقَتْ لاَ تَأْتَلِي","مَا الْتَقَتْ عَضّاً وَتمزِيقاً وَكسْرا",26,"ر",2,0],["وَالضَّادُ تَأْسَى لِفَقْدِ ذُخْرٍ","بِرَغْمِهَا أَنَّهُ أُضِيَعا",27,"ع",2,0],["والضاد حسب الضاد فخراً أنها","كانت لسان اللّه في فرقانه",28,"ن",2,0],["والضرع أصبح منه بعد جفوله","جفت غضارته وغاض سماره",29,"ر",2,0],["والضحى يرتدي رداء من النار","ويرخى من الدخان ظلالا",30,"ل",2,0],["والضحى في الدروب يمرح كالأ","فراح º في أعين الصبايا النواعم",31,"م",1,0],["والضاربُ الضربةَ لصَدمتِها","لحمُ العُلوج على الأقدام ينتثر",32,"ر",1,0],["وَالضّارِبُونَ الكَبْش يَبْرُقُ بَيضُهُ،","وَالمُثْبِتُونَ مَوَاطىءَ الأقْدامِ",33,"م",1,0],["وَالضارِبون خِيام سوددهم عَلى","هام السماك وَمفرق الجَوزاءِ",34,"ا",2,0],["والضياء الذي اتشحت سناه","هبة الله جل من اعطاكا",35,"ك",2,0],["والضَّجِيجُ المُرُّ في حارَتِنا","لمْ يَكُنْ إلَّا نُواحُ الحَزَنِ",36,"ن",1,0],["والضيوفُ اللِّئَامُ لم ترض أيضاً","بسواه شَرُّ الضُّيُوفِ اللِّئَامُ",37,"م",1,0],["والضاربون ببيض الهند مرهفةً","تخالها في ظلام الحرب نيرانا",38,"ن",2,0],["والضرب بالدف للنسوان ليس به","قبح ولا سيما إن كان عن سبب",39,"ب",1,0],["والضربُ بالسهمِ لم تنطقْ به لغةٌ","والرميُ بالسيفِ لم تَسمع بهِ الأمَم",40,"م",1,0],["والضَّوْءُ يُنْحِلُ جِسْمَهُ","وَسِقامُها سَبَبُ النُّحُولِ",41,"ل",1,0],["وَالضَّاربُونَ بِكُلِّ أَخضَرَ قاطعٍ","لَينِ المَهَزِّ قَلانِسَ الأَبطالِ",42,"ل",1,0],["وَالضبُّ أفصحُ بالرسالةِ يشهدُ","وَتعجّبَ السرحانُ ممّن يجحدُ",43,"د",1,0],["والضاحكونَ إذا الأسنّةُ والظبا","هتَكَت ظلامَ النَقع باللمعان",44,"ن",1,0],["والضيغمِ ابن زياد طارقَ كيف","قادَ السُفن لمّا أن غزا الإسبانا",45,"ن",2,0],["وَالضَيفَ أَكرِمهُ فَإِنَّ مَبيتَهُ","حَقٌّ وَلا تَكُ لُعنَةً لِلنُزَّلِ",46,"ل",1,0],["وَالضَّرْبُ أَبْرَقَ ثُمَّ أَرْعَدْ","وَالطَّعْنُ أَتْهَمَ ثُمَّ أَنْجَدْ",47,"د",1,0],["وَالضامِراتِ كَأَنَّها بَقَرٌ","تَقرو دَكادِكَ بَينَها الرَملُ",48,"ل",1,0],["وَالضمُّ والمصافَحَه","مِن سُنَّة المُصالحَه",49,"ه",1,0],["والضاربينَ الكبشَ يبرُقُ بَيضُهُ","ضربَ المهنّدِ عن حياضِ الناهلِ",50,"ل",1,0],["وَالضارِبونَ مِنَ الأَبطالِ هامَهُمُ","ضَرباً طِلَخفاً وَهَكّاً غَيرَ تَذبيبِ",51,"ب",1,0],["والضحايا لهم مع الدهر حرب","وخطاهم ماصورت لسباق",52,"ق",1,0],["والضحايا لولا الخلود لكانت","وهي والميتين حتفاً سواء",53,"ا",2,0],["والضَّارِبُ الأَقْرانَ أَوَّلَ ضَرْبَةٍ","هِيَ مِن حَيَاةِ مَن اتّقاهَا آخِرُ",54,"ر",1,0],["والضَّحايَا تُسَاقُ إلاَّ إلينا","فَكَأَنَّا كُنَّا بهِ كُفَّارا",55,"ر",2,0],["وَالضَربُ قَد لَجَّ بِالأَوتارِ أَو حُبِسَت","وَهَيَّجَ الحَليُ وَسواسي بِوَسواسِ",56,"س",1,0],["وَالضَربُ بِالبيضِ مِن آثارِهِ عُكَنٌ","وَالطَعنُ بِالسمُرِ مِن آثارِهِ سُرَرُ",57,"ر",1,0],["وَالضُّحَى تَغْلِبُها وَقدَتُها","خَرَقَ الجُؤْذُر في اليَومِ الخَدِرْ",58,"ر",1,0],["والضّيف تغدو عن معالي فضله","شاكرة من فضله حسن القرى",59,"ا",1,0],["والضيم ألوانه شتى وأظلمها","أن يشعر المرء أن الموت يغنيه",60,"ي",2,0],["والضاربين العدا بحدّهِمُ","والبالغين المدى بجِدّهِمِ",61,"م",1,0],["والضاربون في اليفاع والذُّرَى","إذا بيوتُ الذلِّ عاذتْ بالوُهُدْ",62,"د",1,0],["والضاربُ الهام بآرائه","إذا نبا السَّيفُ على الشاتم",63,"م",1,0],["والضربُ أمثالُ الحواجبِ فو","ق الطعن مثل الأعين النجل",64,"ل",1,0],["والضّربُ يهتك جانباً متستّراً","والطّعْنُ يفتُقُ جانباً مرتوقا",65,"ق",2,0],["وَالضِّغنُ تَطْمُرُهُ الأناةُ فتعترِي","حِزَقاً إليه ضغائنٌ وحقودُ",66,"د",1,0],["وَالضّاحكون بيومِهمْ ما فيهمُ","إِلّا الّذي هو في غدٍ نشّاجُ",67,"ج",1,0],["وَالضّرعُ لا دَرَّ فيهِ","فَليسَ يَنفَعُ حَلْبُ",68,"ب",1,0],["والضد ليس يجيء منه ضده","أبداً وما الضدان يجتمعان",69,"ن",1,0],["والضدُّ للضد مجعول يزول به","وليس ماض مع الآتي بممتزج",70,"ج",1,0],["وَالضِغنِ مِن تَتابُعِ الأَشواطِ","حَتّى تُناخَ بَعدَ خِمسٍ ماطِ",71,"ط",1,0],["والضربُ والصوتُ وحِسّاهُما","خارِجَةٌ في قرنٍ واحدْ",72,"د",1,0],["والضيف لا يقطع قالوا فظلم","في الحكم في الوجهين فيه إذ حكم",73,"م",1,0],["والضَّربُ لا يترُكُ الهنديَّ مستوياً","والطعنُ لا يَدَعُ الخطِّيّ مُعتدِلا",74,"ل",2,0],["والضَّغْنَ يقتله بعفوِ تَغَمُّدِ","والفَقرَ يُعدِمه بقتلِ تَعَمُّدِ",75,"د",1,0]]}