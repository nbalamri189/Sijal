"],[5437,"ياصاحبي","https://www.poetsgate.com/ViewPoem.aspx?id=143690",""],[5442,"مادون رامة من معرس","https://www.poetsgate.com/ViewPoem.aspx?id=114778",""],[5466,"يا مَنْ يرومُ تلاوة القرآن","https://www.poetsgate.com/ViewPoem.aspx?id=112512",""],[5488,"عزوة الصحابة","https://www.poetsgate.com/ViewPoem.aspx?id=100733",""],[5526,"دفتر أشعاري","https://www.poetsgate.com/ViewPoem.aspx?id=198789",""],[5573,"تدرين انا محتار ياكثر اساميك","https://www.poetsgate.com/ViewPoem.aspx?id=200072",""],[5573,"يقول منهو يكابد با المسا كربه","https://www.poetsgate.com/ViewPoem.aspx?id=203082",""],[5582,"أَتِلْكَ لِلحَيِّ أَحْداجٌ وَأَظْعانُ","https://www.poetsgate.com/ViewPoem.aspx?id=63592",""],[5606,"يحسب إن الفوزياجي بالرشاوي","https://www.poetsgate.com/ViewPoem.aspx?id=198631",""],[5616,"إلى متى؟","https://www.poetsgate.com/ViewPoem.aspx?id=205030",""],[5616,"الحمدُ لله","https://www.poetsgate.com/ViewPoem.aspx?id=205246",""],[5732,"الملحمة الزايدية","https://www.poetsgate.com/ViewPoem.aspx?id=177865",""],[5739,"زوايا الحبر ..!","https://www.poetsgate.com/ViewPoem.aspx?id=126878",""],[5829,"قالت الاعوام صبرا","https://www.poetsgate.com/ViewPoem.aspx?id=214632",""],[5866,"مدح القبيلة","https://www.poetsgate.com/ViewPoem.aspx?id=182810",""],[5893,"لو أكتبك","https://www.poetsgate.com/ViewPoem.aspx?id=141384",""],[5897,"حلم","https://www.poetsgate.com/ViewPoem.aspx?id=156535",""],[5906,"غبار أمّة","https://www.poetsgate.com/ViewPoem.aspx?id=188911",""],[4442,"يبدو الشباب بشكل الخرد العين","https://www.poetsgate.com/ViewPoem.aspx?id=171001",""],[6093,"إلاَّا القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=178563",""],[6101,"زمرة الشيطان / حسن الأفندي","https://www.poetsgate.com/ViewPoem.aspx?id=120281",""],[6115,"نصايح عشر","https://www.poetsgate.com/ViewPoem.aspx?id=180461",""],[6115,"الفاهم العاقل ضميره خصيمه","https://www.poetsgate.com/ViewPoem.aspx?id=181518",""],[6139,"مناجاة","https://www.poetsgate.com/ViewPoem.aspx?id=212330",""],[6148,"نبي الرحمة","https://www.poetsgate.com/ViewPoem.aspx?id=202058",""],[6237,"عودة إلى الطبيعة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77860&r=&rc=2",""],[6255,"الحُزْنُ جَادَ أَبًا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80883&r=&rc=11",""],[5126,"الطائر الغريب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87826&r=&rc=41",""],[4890,"الهزيمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72560&r=&rc=137",""]],"verses":[["وَالضارِبينَ الهامَ في مُشعَلَةٍ","لَها بِلا نارٍ ضِرامٌ وَدَخَن",0,"ن",1,0],["وَالضَيمُ أَروَحُ مِنهُ مَط","رورُ الظُبى بَلَغَ الصَميما",1,"م",2,0],["وَالضارِبينَ عَلَيَّ بَيتَ زِمامَةٍ","خَسَأَ العَدُوَّ فَما يُطيقُ ضِراري",2,"ر",2,0],["وَالضُّبَيْبِيَّاتُ خُوصٌ","وَبِها نُجْلُ الجِراحِ",3,"ح",1,0],["والضّرْبَةُ الأخْدودُ لم يُعْجَمْ لَها","سَطْرٌ بِعاجِلِ طَعْنَةٍ إخْطيفِ",4,"ف",1,0],["والضّرْعُ أصْبَحَ منْهُ بعْدَ حُفولِهِ","جفّتْ غَضارَتُهُ وغاضَ سَحارُهُ",5,"ر",2,0],["وَالضامِنينَ بِقَومِهِم يَومَ الوَغى","لِلحَمدِ يَومَ تَنازُلٍ وَطِرادِ",6,"د",1,0],["وَالضَيفُ يَعلَمُ أَنِّيَ حينَ يَطرُقُني","ماضي الجَنانِ عَلى كَفّي وَمَقدِرَتي",7,"ي",1,0],["وَالضارِبينَ بِكُلِّ سَيفٍ في الوَغى","وَالخانِعينَ لِكُلِّ ذي قِرضابِ",8,"ب",1,0],["والضِّيا والظِّلالْ","والشَّذَى والورودْ",9,"د",1,0],["والضرب في طول الجيوب وعرضها","بتلطف وتحيل وتلصص",10,"ص",1,0],["والضرب فوق الظهر وهو مطاوع","والضرب فوق البطن وهو مواتي",11,"ت",2,0],["وَالضَربِ في الأَوجُهِ وَالمَفارِقِ","وَالسَيرِ في ظِلِّ اللِواءِ الخافِقِ",12,"ق",1,0],["والضدّ غالب ضدّه وبقهره","ظهر السكون وبان منه حراكُه",13,"ك",2,0],["وَالضارِبونَ بِسُهمَةٍ مَعروفَةٍ","في التاجِ ذي الشُرُفاتِ وَالإِكليلِ",14,"ل",1,0],["وَالضامِنونَ عَلى المَنِيَّةِ جارَهُم","وَالمُطعِمونَ غَداةَ كُلَّ شَمالِ",15,"ل",1,0],["وَالضارِبونَ الكَبشَ يَبرُقُ بَيضُهُ","وَالمُثبِتونَ مَواطِئَ الأَقدامِ",16,"م",1,0],["وَالضارِبونَ مِنَ الأَقرانِ هامَهُمُ","إِذا الجَبانُ رَأى لِلمَوتِ أَلوانا",17,"ن",2,0],["والضُّحى أدهمُ في النَّقعِ فإنْ","ضَحِكَتْ فيه الظُّبا كان أغَرّ",18,"ر",1,0],["وَالضَيفُ أَكرِم ما اِستَطَعتَ جِوارَهُ","حَتّى يَعُدُّكَ وارِثاً يَتَنَسَبُ",19,"ب",1,0],["والضنى والشحوب","وخيال الوَداع",20,"ع",1,0],["وَالضَربُ يُقعِدُ قَرمَ كُلِّ كَتيبَةٍ","شَرِسِ الضَريبَةِ وَالحُتوفُ قِيامُ",21,"م",1,0],["والضَّارِعَاتُ مَعِي، مَصَائِرُ أُمَّةٍ","ألاّ يَعُودَ بها العَزِيزُ ذَلِيلا",22,"ل",2,0],["والضَّعفُ للضَّعفِ المُهَدَّدِ قُوَّةٌ","تَمضِي فتدفعُ قُوّةَ المُتَهجِّمِ",23,"م",1,0],["وَالضغط يأَتي انفجارا","يبيد من غير مهل",24,"ل",1,0],["والضَّارِبِينَ بِأَيْدِيهِمْ إذَا نَهَدَتْ","مَثنَى القِدَاحِ وحُبَّتْ فَوْزَةُ الخَطَرِ",25,"ر",1,0],["والضوءُ فوق الخصور منهمرٌ","والماء تحت الصدور مستعرُ",26,"ر",1,0],["وَالضَّوَارِي انْطلَقَتْ لاَ تَأْتَلِي","مَا الْتَقَتْ عَضّاً وَتمزِيقاً وَكسْرا",27,"ر",2,0],["وَالضَّادُ تَأْسَى لِفَقْدِ ذُخْرٍ","بِرَغْمِهَا أَنَّهُ أُضِيَعا",28,"ع",2,0],["والضاد حسب الضاد فخراً أنها","كانت لسان اللّه في فرقانه",29,"ن",2,0],["والضرع أصبح منه بعد جفوله","جفت غضارته وغاض سماره",30,"ر",2,0],["والضحى يرتدي رداء من النار","ويرخى من الدخان ظلالا",31,"ل",2,0],["والضحى في الدروب يمرح كالأ","فراح º في أعين الصبايا النواعم",32,"م",1,0],["والضاربُ الضربةَ لصَدمتِها","لحمُ العُلوج على الأقدام ينتثر",33,"ر",1,0],["وَالضّارِبُونَ الكَبْش يَبْرُقُ بَيضُهُ،","وَالمُثْبِتُونَ مَوَاطىءَ الأقْدامِ",34,"م",1,0],["وَالضارِبون خِيام سوددهم عَلى","هام السماك وَمفرق الجَوزاءِ",35,"ا",2,0],["والضياء الذي اتشحت سناه","هبة الله جل من اعطاكا",36,"ك",2,0],["والضَّجِيجُ المُرُّ في حارَتِنا","لمْ يَكُنْ إلَّا نُواحُ الحَزَنِ",37,"ن",1,0],["والضيوفُ اللِّئَامُ لم ترض أيضاً","بسواه شَرُّ الضُّيُوفِ اللِّئَامُ",38,"م",1,0],["والضاربون ببيض الهند مرهفةً","تخالها في ظلام الحرب نيرانا",39,"ن",2,0],["والضرب بالدف للنسوان ليس به","قبح ولا سيما إن كان عن سبب",40,"ب",1,0],["والضربُ بالسهمِ لم تنطقْ به لغةٌ","والرميُ بالسيفِ لم تَسمع بهِ الأمَم",41,"م",1,0],["والضَّوْءُ يُنْحِلُ جِسْمَهُ","وَسِقامُها سَبَبُ النُّحُولِ",42,"ل",1,0],["وَالضَّاربُونَ بِكُلِّ أَخضَرَ قاطعٍ","لَينِ المَهَزِّ قَلانِسَ الأَبطالِ",43,"ل",1,0],["وَالضبُّ أفصحُ بالرسالةِ يشهدُ","وَتعجّبَ السرحانُ ممّن يجحدُ",44,"د",1,0],["والضاحكونَ إذا الأسنّةُ والظبا","هتَكَت ظلامَ النَقع باللمعان",45,"ن",1,0],["والضيغمِ ابن زياد طارقَ كيف","قادَ السُفن لمّا أن غزا الإسبانا",46,"ن",2,0],["وَالضَيفَ أَكرِمهُ فَإِنَّ مَبيتَهُ","حَقٌّ وَلا تَكُ لُعنَةً لِلنُزَّلِ",47,"ل",1,0],["وَالضَّرْبُ أَبْرَقَ ثُمَّ أَرْعَدْ","وَالطَّعْنُ أَتْهَمَ ثُمَّ أَنْجَدْ",48,"د",1,0],["وَالضامِراتِ كَأَنَّها بَقَرٌ","تَقرو دَكادِكَ بَينَها الرَملُ",49,"ل",1,0],["وَالضمُّ والمصافَحَه","مِن سُنَّة المُصالحَه",50,"ه",1,0],["والضاربينَ الكبشَ يبرُقُ بَيضُهُ","ضربَ المهنّدِ عن حياضِ الناهلِ",51,"ل",1,0],["وَالضارِبونَ مِنَ الأَبطالِ هامَهُمُ","ضَرباً طِلَخفاً وَهَكّاً غَيرَ تَذبيبِ",52,"ب",1,0],["والضحايا لهم مع الدهر حرب","وخطاهم ماصورت لسباق",53,"ق",1,0],["والضحايا لولا الخلود لكانت","وهي والميتين حتفاً سواء",54,"ا",2,0],["والضَّارِبُ الأَقْرانَ أَوَّلَ ضَرْبَةٍ","هِيَ مِن حَيَاةِ مَن اتّقاهَا آخِرُ",55,"ر",1,0],["والضَّحايَا تُسَاقُ إلاَّ إلينا","فَكَأَنَّا كُنَّا بهِ كُفَّارا",56,"ر",2,0],["وَالضَربُ قَد لَجَّ بِالأَوتارِ أَو حُبِسَت","وَهَيَّجَ الحَليُ وَسواسي بِوَسواسِ",57,"س",1,0],["وَالضَربُ بِالبيضِ مِن آثارِهِ عُكَنٌ","وَالطَعنُ بِالسمُرِ مِن آثارِهِ سُرَرُ",58,"ر",1,0],["وَالضُّحَى تَغْلِبُها وَقدَتُها","خَرَقَ الجُؤْذُر في اليَومِ الخَدِرْ",59,"ر",1,0],["والضّيف تغدو عن معالي فضله","شاكرة من فضله حسن القرى",60,"ا",1,0],["والضيم ألوانه شتى وأظلمها","أن يشعر المرء أن الموت يغنيه",61,"ي",2,0],["والضاربين العدا بحدّهِمُ","والبالغين المدى بجِدّهِمِ",62,"م",1,0],["والضاربون في اليفاع والذُّرَى","إذا بيوتُ الذلِّ عاذتْ بالوُهُدْ",63,"د",1,0],["والضاربُ الهام بآرائه","إذا نبا السَّيفُ على الشاتم",64,"م",1,0],["والضربُ أمثالُ الحواجبِ فو","ق الطعن مثل الأعين النجل",65,"ل",1,0],["والضّربُ يهتك جانباً متستّراً","والطّعْنُ يفتُقُ جانباً مرتوقا",66,"ق",2,0],["وَالضِّغنُ تَطْمُرُهُ الأناةُ فتعترِي","حِزَقاً إليه ضغائنٌ وحقودُ",67,"د",1,0],["وَالضّاحكون بيومِهمْ ما فيهمُ","إِلّا الّذي هو في غدٍ نشّاجُ",68,"ج",1,0],["وَالضّرعُ لا دَرَّ فيهِ","فَليسَ يَنفَعُ حَلْبُ",69,"ب",1,0],["والضد ليس يجيء منه ضده","أبداً وما الضدان يجتمعان",70,"ن",1,0],