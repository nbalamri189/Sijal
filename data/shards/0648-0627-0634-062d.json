{"poems":[[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145812","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96752","المتقارب"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50007","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93533","الكامل"],[4767,"عودة الجنوب","https://www.poetsgate.com/ViewPoem.aspx?id=94471",""],[585,"هو الصوت دوّى من فلسطين عالياً","https://www.poetsgate.com/ViewPoem.aspx?id=161906",""],[5376,"جاد بسْمُ العرْبِ يسري في فمي","https://www.poetsgate.com/ViewPoem.aspx?id=188477",""],[5431,"دورة الشرّ","https://www.poetsgate.com/ViewPoem.aspx?id=213762",""],[5582,"أَبَى اللهُ إِلاّ أَنْ أَرَى الحَقَّ غالِبا","https://www.poetsgate.com/ViewPoem.aspx?id=186674",""],[5582,"أَلا حَيِّ مِنْ دارِ سُعْدَى مُقامَا","https://www.poetsgate.com/ViewPoem.aspx?id=63572",""],[5749,"لوم العاشقين","https://www.poetsgate.com/ViewPoem.aspx?id=130035",""]],"verses":[["وأشَحتُ عنكمْ وَجه َجرحي لي سَما","واتِي لأنّ الأرضَ للجُبَناءِ",0,"ا",2,0],["وأشحذت عزماً لحدّ السرى","وودَّعت داراً وجاراً وأهلا",1,"ل",2,0],["واشحذُ من طبع القوافي صارماً","لها بين أعراض الِّلئام صليلُ",2,"ل",1,0],["وَاشحذ حسامك فَال","حسين قَضى بِحَد السَيف نَحبه",3,"ب",2,0],["واشحذ صوارمَك الحِدادَ لعلها","تُردي العدا فوق الصعيد المُجهَد",4,"د",1,0],["وأشحذ ناباً بين فكي طاحناً","فتبصر كيف الليث يبطش ضاريا",5,"ي",2,0],["واشحذِ النفسَ حماساً للعلا","في ثنايا النفسِ صبرُ المسلمِ",6,"م",1,0],["واشحنيها من الجحيم انفعالا","تصطليهِ وفي المجاز الماءُ",7,"ا",2,0],["وَأَشْحَذْتُ عَزْماً لِلْحُرُوبِ مُهَذَّباً","وَرَأْياً لِتَدْبِيرِ السِّياسَةِ صائِبا",8,"ب",2,0],["وَأَشْحَذْتُ مِنْ عَزْمَتِي صارِماً","وَقَعْقَعْتُ لِلكاشِحِينَ اللِّجامَا",9,"م",2,0],["واش حد حرشو عليا بلعاني","ولا كان يتسنى انسان ثاني",10,"ن",2,0]]}