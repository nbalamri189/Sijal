يه"],[549,"حديقة بلا غناء","https://www.aldiwan.net/poem67250.html","عموديه"],[556,"أرق عيني طارق","https://www.aldiwan.net/poem47360.html","مجزوء الرجز"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138381",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48636","الوافر"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126148","الرجز"],[1148,"","https://poetry.dctabudhabi.ae/diwan/poem/146295","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112935","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112857","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108928","الوافر"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141309","الوافر"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49589","الطويل"],[2196,"","https://poetry.dctabudhabi.ae/diwan/poem/205617","الطويل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106879","الطويل"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126224","البسيط"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26249","الوافر"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87316","الرجز"],[561,"","https://poetry.dctabudhabi.ae/diwan/poem/145201","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204905","الوافر"],[3114,"","https://poetry.dctabudhabi.ae/diwan/poem/147712","البسيط"],[3658,"","https://poetry.dctabudhabi.ae/diwan/poem/199176","الرجز"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125955","السريع"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118014","الرجز"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131283",""],[3976,"","https://poetry.dctabudhabi.ae/diwan/poem/17772","الطويل"],[4393,"","https://poetry.dctabudhabi.ae/diwan/poem/124787","الطويل"],[4433,"","https://poetry.dctabudhabi.ae/diwan/poem/121261","الطويل"],[4862,"في رثاء أبي رحمه الله وغفر له","https://www.poetsgate.com/ViewPoem.aspx?id=152722",""],[4927,"عودة العيد","https://www.poetsgate.com/ViewPoem.aspx?id=4584",""],[4984,"بشرى العيد","https://www.poetsgate.com/ViewPoem.aspx?id=189552",""],[1420,"أقام رجالاً في معارجه ملكاً","https://www.poetsgate.com/ViewPoem.aspx?id=87617",""],[5237,"إن شئت عيشا هنيا واتباع هدى","https://www.poetsgate.com/ViewPoem.aspx?id=113119",""],[592,"أهاجك أزماة تسامى بها الخلف","https://www.poetsgate.com/ViewPoem.aspx?id=128857",""],[592,"إن الأمور التي الأعداء تبديها","https://www.poetsgate.com/ViewPoem.aspx?id=128826",""],[592,"على قلة الداعي وقلة ذي الفهم","https://www.poetsgate.com/ViewPoem.aspx?id=128814",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5376,"الدهرُ أمتعنا بالرود والغيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=188404",""],[5409,"نعوا للعروبة عنوانها","https://www.poetsgate.com/ViewPoem.aspx?id=155484",""],[5409,"بلغت يا أيها النحات منزلة","https://www.poetsgate.com/ViewPoem.aspx?id=155284",""],[5411,"عَلى بُعْد ميلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=201924",""],[5431,"زمانٌ لا يكفّ عن الخداع","https://www.poetsgate.com/ViewPoem.aspx?id=215980",""],[5606,"يقول عيسى وعيسى يرفع أقواله","https://www.poetsgate.com/ViewPoem.aspx?id=197970",""],[5690,"نوائب الدهر إنذارٌ إلى الأممِ","https://www.poetsgate.com/ViewPoem.aspx?id=172180",""],[5694,"ياشين قهر الرجال","https://www.poetsgate.com/ViewPoem.aspx?id=129914",""],[5720,"الذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=200565",""],[5720,"سنرحلُ","https://www.poetsgate.com/ViewPoem.aspx?id=210360",""],[5818,"ان طاب الختام","https://www.poetsgate.com/ViewPoem.aspx?id=197078",""],[5894,"نعوت الهوى للصب ذل مهين","https://www.poetsgate.com/ViewPoem.aspx?id=131434",""],[5953,"يا سرّ مرَّى لقد أصبحت لي سكناً","https://www.poetsgate.com/ViewPoem.aspx?id=93789",""],[5956,"عيونٌ تدري مقاصدنا ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182273",""],[5956,"تسجيل وتصوير ليلة دخلة عريس","https://www.poetsgate.com/ViewPoem.aspx?id=182669",""],[5977,"شعور","https://www.poetsgate.com/ViewPoem.aspx?id=212706",""],[6117,"شَهْرُ رَمَضَانْ الْمُبَارَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=182798",""]],"verses":[["نَعَوهُ عَلى ضَنِّ قَلبي بِهِ","فَلِلَّهِ ماذا نَعى الناعِيانِ",0,"ن",1,1],["نَعَوا ظُبَةً لِأَبيَضَ مَشرَفيٍّ","قَديمِ الطَبعِ عاديِّ الصِقالِ",1,"ل",1,0],["نَعَوني لِكَي أَسلو هَواها فَأَصبَحَت","عَلى نَأيِها أَذرى لِدَمعي وَأَكمَدا",2,"د",2,0],["نَعَوا مالِكاً بِالتاجِ لَمّا هَبَطنَهُ","عَوابِسَ في هابي الغُبارِ كَوالِحا",3,"ح",2,0],["نَعَوني وَلَمّا يَنعَني غَيرُ شامِتٍ","وَغَيرُ عَدُوٍّ قَد أُصيبَت مَقاتِلُه",4,"ل",2,1],["نَعَوا عَبدَ العَزيزِ فَقُلتُ هَذا","جَليلُ الرُزءِ وَالحَدَثُ الكَبيرُ",5,"ر",1,1],["نعوذ بالرحمن من شؤمه","فإنه أمضى من المِثْقبِ",6,"ب",1,0],["نَعوسٌ إِذا دَرَّت جَرورٌ إِذا غَدَت","بُوَيزِلُ عامٍ أَو سَديسٌ كَبازِلِ",7,"ل",1,0],["نعوذ باللَه معاً","من غاسق اذا وقب",8,"ب",1,0],["نُعَوِّذُهُ مِنَ الأَعيانِ بَأساً","وَيَكثُرُ بِالدُعاءِ لَهُ الضَجيجُ",9,"ج",1,0],["نُعَوِّلُ وَالإِجداءُ فيهِ تَباعُدٌ","عَلى سَيِّدٍ يَدنو جَداهُ وَيَقرُبُ",10,"ب",1,0],["نَعودُ مِن رَأيِهِ في كُلِّ مُشكِلَةٍ","إِلى سِراجٍ يُرينا الغيبَ وَهّاجِ",11,"ج",1,0],["نَعَوكَ بِهِم كانَ النَعيُّ وَلَم تَمُت","وَلَو مُتَّ ماتَ الظَرفُ أَجمَعَ كُلُّهُ",12,"ل",2,1],["نَعودُ مِنكَ عَلى نَهجٍ بَدَأتَ بِهِ","فَنَحنُ نَخبِطُ في أَخلاقِكَ الأُوَلِ",13,"ل",1,0],["نَعوذُ بِاللَهِ ذي الجَلالِ وَذي ال","إِكرامِ مِن سُخطِهِ وَنِقمَتِهِ",14,"ت",2,0],["نَعوذُ بِاللَهِ مِن خِذلانِهِ أَبَداً","فَإِنَّما الناسُ مَعصومٌ وَمَخذولُ",15,"ل",1,0],["نَعوذُ مِنَ الشيطانِ باللّه إنّهُ","يوسوسُ بالعصيان في أُذُنِ القلبِ",16,"ب",1,1],["نعوذُ بالرحمنِ مِنْ مثلها","زلزلةٌ أسهرتِ الأعينا",17,"ن",2,1],["نَعوذُ بِباعِثِ المَوتى وَنَرجو","عَوارِفَهُ رَجاءَ العامِلينا",18,"ن",2,0],["نَعوذُ بِرَبِّنا مِن كُلِّ سوءٍ","وَنَبرَأُ مِن مَعَرَّةِ كُلِّ رِقِّ",19,"ق",1,0],["نَعوذُ بِعَدلِكُم أَن تُسلِمونا","إِلى نارِ الخَصاصَةِ نَصطَليها",20,"ي",3,0],["نَعودُ إِذا اِعوَجَّت سَبيلٌ بِأَهلِها","حِفاظاً وَلَيسَ الحَقُّ فينا بِأَعوَجِ",21,"ج",1,0],["نَعوجٌ عَلى التَأويبِ صُعرٌ مِنَ البَرى","نَواشِطُ في لُجٍّ مِنَ اللَيلِ تَنعَبُ",22,"ب",1,0],["نَعوذُ بِاللَهِ مِن غَوانٍ","يَكِنُّ بِاللُبِّ مُعصَفاتِ",23,"ت",1,0],["نَعوذُ بِاللَهِ مِن مُلكٍ نُشَبِّهُهُ","غَيماً أَراقَ مَتى لا يُمرَ لا يَمِرِ",24,"ر",1,0],["نَعُّومُ يَا نِعْمَ المُوَجِّهُ","لِلْعَزَائِمِ واَلمُحَرِّك",25,"ك",1,0],["نعودُ إلى الترابِ كما بدأنا","فكُلُّ حياتِنا نَقْضٌ وغَزْل",26,"ل",1,0],["نعود إذا اعوج سبيل بأهلها","حِفَاظاً وَلَيْسَ الْحَقُّ فِينَا بِأَعْوَجِ",27,"ج",1,0],["نَعوا إلى الشِعرِ حُراً كان يرعاهُ","ومَنْ يَشُقُّ على الأحرارِ مَنعاهُ",28,"ا",2,1],["نعوا عليكَ – وأنت النور – فلسفةً","سوداءَ لا لذَّةً تبغي ولا طرَبا",29,"ب",2,0],["نعوني ولما ينعيني غير شامتٍ","وغيرُ عَدُوٍّ قَدْ أُصِيبتْ مَقاتِلُهْ",30,"ل",2,1],["نَعَوْكَ بهِمْ كان النعِيُّ، ولمْ تمُتْ،","وَلَوْ مُتَّ ماتَ الظَّرْفُ بعدَكَ كلّهُ",31,"ل",2,1],["نَعُودُ إلى المَأثُورِ مِنْ فَعَلاتِهِ","فتَأتمُّهَا في الأمْرِ، أوْ نَستَشيرُهَا",32,"ر",3,0],["نعودها الطرادَ، فكلَّ يومٍ","تسنُّ، على سنابكها، القرونُ",33,"ن",1,0],["نعوتي مخرّبا أنت تدري","أنها لن تكون آخر خدعه",34,"ع",2,0],["نعوذ بالله من كل العوائل بل","نعوذ بالله من عول وشيطان",35,"ن",1,0],["نَعَوا مالِكاً بِالسَهلِ لَمّا هَبَطنَهُ","عَوابِسَ في كابي الغُبارِ كوالِحا",36,"ح",2,0],["نعود إلى مآثمنا نعود","فمن هذي المآثم نستفيد",37,"د",1,1],["نَعوذُ بِالإِقرارِ مِن قَرارِها","وَشَرَّ تَقرينِ ذَويها في الزُبُر",38,"ر",1,0],["نعودُ إلى مُوسى فإنَّ حَديثَه","عَجيبٌ وإن طاشَ الحَليمُ وإن شاطا",39,"ط",2,0],["نعود في زياده","في العلم والعباده",40,"د",2,0],["نعوذ بالله خالقنا","نلوذ بالمفضل الحنان",41,"ن",1,0],["نَعوا مُهجَة السَلميَّ وَهيَ سَلامَةٌ","غُلِبتُ عَلَيها فَالسَلامُ عَلى الأُنسِ",42,"س",1,0],["نعوذ بربِّنا من كلِّ قلبٍ","به من سوء نيَّته احتقانُ",43,"ن",1,0],["نعوذ برِّبنا من شرِّ قومٍ","رأوا فِعْلَ الحرامِ من الحَلاَلِ",44,"ل",1,0],["نَعَوا فارس الخيل المغيرة في الضحى","ومُختلسَ الأرواح تحت السنوَّر",45,"ر",1,0],["نَعَوا وَشيكَ القِرى في كُلِّ مُجْدبَةٍ","يُغْني سَنى الوَجْه منهُ عن سنى النَّارِ",46,"ر",1,0],["نعوذ بأحشاء خلاء من التقى","وفي كلما يومٍ حبيبٌ نشيع",47,"ع",1,0],["نعودُ كالفتيةِ اللَّاهِينَ ما برحوا","حولَ الغوايةِ طَوَّافِينَ سَاعِينا",48,"ن",2,0],["نَعَوْا إليَّ صاحباً","موافقاً موفّقا",49,"ق",2,0],["نعوم كنت لنا شهابا ثاقبا","ولذا بكتك كواكب ونجوم",50,"م",1,0],["نعوا يوم الخميس إليَّ خالي","فقلت مضت مصافاة الليالي",51,"ل",2,1],["نعوذ من جميعها يا رب","بوجهك الكريم فهو حسبي",52,"ي",1,0],["نعوا مالكاً بالسهل لما هبطنه","عوابس في كابي الغبار كواحلا",53,"ح",3,0],["نعوذ بك اللهم منه فسلمن","وسلم بهم من كل شر واوحال",54,"ل",1,0],["نعوذ برحمن البرايا من الردى","ومن منهج الاغوا ومسلك شيطان",55,"ن",1,0],["نعوِّذه فقد حسدت علاه ال","جهاتُ الستُ بالسبعِ المثاني",56,"ن",2,0],["نعوم لك البقا فالموت أولى","وأسمى من حياة المائتينا",57,"ن",2,0],["نَعَوْهُ فقلتُ الآنَ واللهِ أصْبَحت","معالمُ هذا الدينِ وَهْيَ مَجَاهل",58,"ل",1,0],["نعوك فحاقت بالبلاد رزية","وطاف بها جنح من الخطب مسودّ",59,"د",1,0],["نعوها إليها فاستقرَّ ملجلجاً","كما هزت الأنواءُ صرحاً مشيدا",60,"د",2,0],["نَعُوذُ باللهِ ذى الألطَافِ والمِنَنِ","من كل سوءٍ من الآفاتِ والمِحَنِ",61,"ن",1,1],["نُعوتٌ كُلُّهُنَّ غَدَت نُعوتاً","لِعَبّادٍ سِوى نَعتٍ عَداها",62,"ا",3,0],["نعوشُ سَبعٍ ورقيقَ البحرِ","خُذ في اليسار والسماكَ آجرِ",63,"ر",1,0],["نعوذ بالله من وجد ومن بين","ومن وقوف على دار ببابين",64,"ن",1,1],["نعود اليه إمّا حار عقل","فنبصر فيه حلاً للأمور",65,"ر",1,0],["نعوذ باللَّه من شر الحياة ومن","شر الممات وشر الإنس والجان",66,"ن",1,0],["نعوذ باللهمن اهل ذا الزمن","فإنهم في الظلم شخص أوحد",67,"د",1,0],["نعود للدار على بعدها","بعد اللتيا يا أخى والتي",68,"ي",1,0],["نعوذ بالله من العصيان","ومن فساد الوقت والزمان",69,"ن",1,0],["نعوه ففي كل الديار مناحةٌ","وفي كل عين مدمع بذ مدمعا",70,"ع",2,0],["نُعَوِّدُها الإِقدامَ في كُلِّ غَمرَةٍ","وَكَرّاً بِأَيدٍ لا قِصارٍ وَلا عُسرِ",71,"ر",1,0],["نَعُوذً بِكَ اللَّهُمَّ مِن سُوءِ صُنعِنَا","فَإنَّ لنَا في العَفوِ مِنكَ لَمطمَعَا",72,"ع",2,0],["نعوذُ بعفو اللَه من نارِ فتنَةٍ","تَأَجَّجُ من قطرِ البلاد إلى قُطرِ",73,"ر",1,0],["نعوه ضحى الإثنين لا عاد من ضحى","( وكل ضحىً قد خالط الحزن أسودُ )",74,"د",1,1],["نَعُوْمُ فِيْ الْهَجْرِ - كَالأَسْرَىْ - وَ يُغْرِقُنَاْ","مَوْجٌ مِنَ الشَّوْقِ º وَ الْمُشْتَاْقُ مَعْطُوْبُ",75,"ب",1,0],["نعود لغفلتنا من جديد","وفي الرغبات قيود وأَسْر",76,"ر",1,0],["نعوذ بك اللهم من شر فتنة","تطوق من حلت به عيشة ضنكا",77,"ك",2,0],["نعوذ بالله من عيش الحسود فما","يمسي ويصبح إلا ساخطا كمدا",78,"د",2,0],["نعوذ بوجه الله أن نترك الذي","أتانا عن المعصوم ليس به خلف",79,"ف",1,0],["نعوذ بالله من قول يقول به","أهل الصليب ومن قول يضاهيها",80,"ي",3,0],["نعوذ برب الناس من كل طاعنٍ","علينا بسوء قد تهور في الإثم",81,"م",1,0],["نعوذ بك اللهم مما يقوله","وهل ذاك إلا الكفر والجعل للند",82,"د",1,0],["نعوذ بالله ان نلنا بمعصيةٍ","والركب يمشي أُناةً غير مجهودِ",83,"د",1,0],["نعوا للعروبة عنوانها","فراحت تسائل ركبانها",84,"ن",3,1],["نعود بالله ممن لا ذمام له","وماردٍ من علوج الإنس خنيس",85,"س",1,0],["نَعُودُ إلى نَفْسِ الحَديثِ مُجَدَّدًا","عَلَى ألْفِ حُبٍ بَعْدَ حُبٍّ نُتَبِّعُ",86,"ع",1,0],["نُعوّمُ في فضاءٍ عالميٍ","فلا جذرٌ وإلّا لاقتطاعِ",87,"ع",1,0],["نعوذ بالله من الشيطان وأفعاله","خسران من طاوع الشيطان وأشواره",88,"ر",2,0],["نعوذ باللّه من أفعى جهالتهم","قومٌ غدا برُّهم إغضاب ربهمِ",89,"م",1,0],["نعوذ باللّه من كفر أتيت بهِ","أبشر إذن بعذاب النار والألمِ",89,"م",1,0],["نعوذ بالله من كيد الشياطينا","والكبر والجبروت وزيف الأوهامي",90,"م",2,0],["نعودُها دائماً في خِدرِها فَنَرَىٰ","ذاكَ الزمانَ الذي بالعهدِ يُدنينا",91,"ن",2,0],["نعوذُ بربنا من كلِّ مأوىً","تشيبُ لهولِ منظرهِ الرؤوسُ",92,"س",1,0],["نعوذ بربّ حمّى الناس منها","إذا متنا وحاق بنا الحرام",93,"م",1,0],["نعوت الهوى للصب ذل مهين","وفي حكمه جور لدينا مبين",94,"ن",1,1],["نعوذ بالله مولانا وسيدنا","من أن يمن علينا ثم يسلبنا",95,"ن",2,0],["نعود للأرض من بعد العلاء فما","يرضى الفضاء بأن نُعلي مبانينا",96,"ن",2,0],["نعود لبعضٍ بشوقٍ أحَرّْ","نعيد اللقاء نعيد السَّفَرْ",97,"ر",1,0],["نعوذ بالله أن نحيا بلا هدفٍ","نعوذ بالله من وسواسِ خنّاسِ",98,"س",1,0],["نَعُوذُ باللهِ مِنْ أعْتَابِ مَدْخَلِهَا","سُكْنَى لِمَنْ حَاقَ بالإسْلاَمِ عُدْوَانَا",99,"ن",2,0]]}