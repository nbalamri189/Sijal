{"poems":[[55,"ألمع برق أم ضرم","https://www.aldiwan.net/poem29820.html","مجزوء الرجز"],[55,"أهلا بهن على التنويل والبخل","https://www.aldiwan.net/poem29905.html","البسيط"],[55,"أنا للركائب إن عرضت بمنزل","https://www.aldiwan.net/poem29911.html","الكامل"],[55,"يا دار ما طربت إليك النوق","https://www.aldiwan.net/poem29956.html","الكامل"],[95,"دعا الوفاء وهذا وقت تبيان","https://www.aldiwan.net/poem11236.html","البسيط"],[74,"مقسم الخاطر ولهانه","https://www.aldiwan.net/poem20166.html","السريع"],[53,"أشجتك أطلال لخوله","https://www.aldiwan.net/poem64603.html","مجزوء الكامل"],[53,"يا نجدة الروم في بطارقها","https://www.aldiwan.net/poem65502.html","المنسرح"],[53,"مالي إذا زدت حبا زدت مقلية","https://www.aldiwan.net/poem66437.html","البسيط"],[53,"يا طول غلة نفسي المبلاه","https://www.aldiwan.net/poem66717.html","الكامل"],[93,"صبرا على هجرها إن كان يرضيها","https://www.aldiwan.net/poem62813.html","عموديه"],[87,"منتزه العباس للمجتلى","https://www.aldiwan.net/poem7924.html","السريع"],[45,"عيد بأية حال عدت يا عيد","https://www.aldiwan.net/poem9555.html","البسيط"],[63,"ردي الخيال يجد معنى واجدا","https://www.aldiwan.net/poem51370.html","الكامل"],[63,"أمن العيون تروم فقد عنائه","https://www.aldiwan.net/poem51836.html","الكامل"],[68,"رقصوا فقام الحرب واشتبك القنا","https://www.aldiwan.net/poem39232.html","الكامل"],[82,"لو أن ربع غير مندرس","https://www.aldiwan.net/poem31407.html","البسيط"],[82,"من كان عنه يدافع القدر","https://www.aldiwan.net/poem31442.html","أحذ الكامل"],[82,"من كان يعذب عندها تعذيبي","https://www.aldiwan.net/poem31542.html","الكامل"],[46,"يا ربع لو ربعوا على ابن هموم","https://www.aldiwan.net/poem30351.html","الكامل"],[46,"صرف النوى ليس بالمكيث","https://www.aldiwan.net/poem30564.html","مجزوء البسيط"],[46,"لو أن دهرا رد رجع جواب","https://www.aldiwan.net/poem30590.html","الكامل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/141014",""],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39680","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202538","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42505","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142005","البسيط"],[108,"سمر الأدباء","https://www.poetsgate.com/ViewPoem.aspx?id=179454",""],[108,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[79,"عقب الشعير لقد هوت بك عيري","https://www.poetsgate.com/ViewPoem.aspx?id=34111",""],[92,"يا بدرداجيَة الخطوب","https://www.poetsgate.com/ViewPoem.aspx?id=179157",""],[53,"لا تَصدِفا عن دِمن المنازلِ","https://www.poetsgate.com/ViewPoem.aspx?id=30265",""],[186,"أحبابنا هل لذاك العهد تذكار","https://www.aldiwan.net/poem67065.html","البسيط"],[189,"لمن الشموس غربن في الأحداج","https://www.aldiwan.net/poem14137.html","الكامل"],[240,"لو أن قلبك مثل قلبي مغرم","https://www.aldiwan.net/poem31768.html","الكامل"],[240,"خليفة الله أنت في الدين وال","https://www.aldiwan.net/poem31824.html","المنسرح"],[240,"مدحك لا يستطيعه البشر","https://www.aldiwan.net/poem32019.html","المنسرح"],[280,"أما الكثيب فما يطار حماه","https://www.aldiwan.net/poem25463.html","الكامل"],[280,"من كل رقراق الفرند كأنه","https://www.aldiwan.net/poem25582.html","الكامل"],[376,"رسم علي لناظري","https://www.aldiwan.net/poem57439.html","مجزوء الكامل"],[445,"كم أستطيل تضللي وتلددي","https://www.aldiwan.net/poem34890.html","الكامل"],[463,"يا دار بين شراف فالنخلِ","https://www.aldiwan.net/poem55992.html","السريع"],[463,"ما أنكرت إلا البياض فصدتِ","https://www.aldiwan.net/poem56266.html","الكامل"],[556,"يا جالبا للأرق","https://www.aldiwan.net/poem47350.html","مجزوء الرجز"],[563,"إني أنا لست أنا","https://www.aldiwan.net/poem33847.html","مجزوء الرجز"],[563,"ما الشدة إلا للفرج","https://www.aldiwan.net/poem34692.html","المتدارك"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35357","الكامل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122026","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100987","البسيط"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137359",""],[3001,"","https://poetry.dctabudhabi.ae/diwan/poem/144545","الكامل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65172","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132752","السريع"],[3302,"","https://poetry.dctabudhabi.ae/diwan/poem/71396","المنسرح"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89405","البسيط"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108026","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110110","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36717","البسيط"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36722","الكامل"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202364","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59513","الكامل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102737","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90812","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54498","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94370","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81734","البسيط"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73206","البسيط"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146754","الكامل"],[4596,"","https://poetry.dctabudhabi.ae/diwan/poem/116076","الكامل"],[5155,"من وحي المهرجان","https://www.poetsgate.com/ViewPoem.aspx?id=176557",""],[5206,"الرد على منكر علم الحِكمة","https://www.poetsgate.com/ViewPoem.aspx?id=187403",""],[5213,"هذا العذيب فأين سرب رئامه","https://www.poetsgate.com/ViewPoem.aspx?id=170537",""],[5582,"هَلْ مِنْ مُجِيدٍ لِي بِأَنْباءِ","https://www.poetsgate.com/ViewPoem.aspx?id=186648",""],[5651,"سفرَتْ فقال أدلّةُ السّفْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=107008",""],[5790,"هي دارهم وأنا المحب المغرم","https://www.poetsgate.com/ViewPoem.aspx?id=112128",""]],"verses":[["مِن كُلِّ راعي أُمَّةٍ","أَجهَلَ مِن راعي غَنَم",0,"م",1,0],["مِن كُلِّ ريمِ هَوىً أَلحاظُ مُقلَتِهِ","يُمسينَ لِلعُذرِ أَنصاراً عَلى العَذَلِ",1,"ل",1,0],["مِن كُلِّ رابِيَةٍ تَرَفَّعَ جيدُها","فَكَأَنَّهُ هادي حِصانٍ مُقبِلِ",2,"ل",1,0],["مِن كُلِّ رَقّاصٍ كَأَنَّ صَهيلَهُ","نَغَمٌ وَما مَجَّ الطِعانُ رَحيقُ",3,"ق",1,0],["مِنْ كُلِّ رَيَّانِ ذِي ظِلٍّ وَذِي ثَمَرٍ","صُلْبٍ عَلَى الدَّهْرِ أن يَعْصِفْ بِحُدْثان",4,"ن",1,0],["من كلِّ ريمٍ قد تشوّقته","من قبلِ أن تشتاق أوطانه",5,"ن",2,0],["من كل رودٍ كالقضي","ب نَماهُ دِعصٌ أوعسُ",6,"س",1,0],["من كل رود إذا تضمَّنت ال","ألحان أربت على مُخارقها",7,"ق",3,0],["من كل رقراقِ ماءِ الوجه تحسبُه","سيفاً صقيلاً حديث العهد بالقين",8,"ن",1,0],["منْ كُلِّ رَيَّا لا تجودُ بشَرْبةٍ","وجنابُها مُتدفِّقٌ بمياه",9,"ه",1,0],["مِن كُلِّ رَعبوبَةٍ عَبلِ رَوادِفُها","تَأبى القُعودَ فَتَأبى أَن تُجاريها",10,"ي",3,0],["مِن كُلِّ راسي الأَصلِ تَحتَ الثَرى","مُحيرَ النَجمِ بِذِرواتِهِ",11,"ت",2,0],["مِن كُلِّ رِخوِ وِكاءِ البَطنِ مُنفَتِقٍ","لا في الرِحالِ وَلا النِسوانِ مَعدودُ",12,"د",1,0],["من كل ريقة كفاك بلفظها","ذهبا يروق وحسبها بك ناقدا",13,"د",2,0],["من كلِّ رَيِّقَةِ الكلامِ كأنما","جادَ الشبابُ لها بِريِّقِ مائِه",14,"ا",3,0],["مِن كُلِّ رِدفٍ كَالكَثيبِ مُجاذِبٍ","قَدّاً أَغَضَّ مِنَ القَضيبِ وَأَليَنا",15,"ن",2,0],["من كلّ روضةِ حُسْنٍ زَهْرُها أرِجٌ","تُهْدي الهوى ليَ في لحظٍ وفي أنَسِ",16,"س",1,0],["مِن كُلِّ رابٍ سَلهَبٍ رَسخَتْ","منهُ القوائمُ ما له حُضُرُ",17,"ر",1,0],["من كلّ رهوٍ في المقادة مشيُهُ","نَقلَ الخطى منه على ترتيبِ",18,"ب",1,0],["مِن كُلِّ ريمٍ لَو تَبَدّى قَطَّعَت","أَلحاظُ مُقلَتِهِ فُؤادَ الريمِ",19,"م",1,0],["مِن كُلِّ رُعبوبَةٍ تَرَدّى","بِثَوبِ فَينانِها الأَثيثِ",20,"ث",1,0],["مِن كُلِّ ريمٍ لَم تَرُم سوءاً وَلَم","تَخلِط صِبى أَيّامِها بِتَصابي",21,"ب",2,0],["من كلّ رخو وكاء البطن منفتقٍ","لا في الرّجال ولا النّسوان معدود",22,"د",1,0],["من كلّ رامٍ كما تنقضّ صاعقةٌ","يرمي العداة حديد الظفر عقّارا",23,"ر",2,0],["من كل رستاقٍ وكلّ حاضره","عقارب والنعلُ غير حاضره",24,"ه",1,0],["مِنْ كُلِّ راقِصَةٍ عَلَى نَقْرِ الصَّبَا","تَخْتَالُ بَيْنَ شَمائِلٍ وَجَنُوبِ",25,"ب",1,0],["من كل ريحانةٍ يندى الحياءُ بها","فإن تثرها أثرت الفاتكَ الوقحا",26,"ح",2,0],["مِن كلِّ روايةٍ، كأنَّ فؤادَهُ","نُقشَتْ على صفحاته الأخبار",27,"ر",1,0],["من كل رامٍ حاذق","في الرمي والتَّسديد ماهر",28,"ر",1,0],["من كل راحية كغارب ناقة","أو كل عرجاء كعنق بعير",29,"ر",1,0],["من كل رَكّاضٍ إلى غاياتِه","رَسْلاً بسرّ حدوده مدفوع",30,"ع",1,0],["من كلّ ريَّا حُلوة ِ الشمائلِ","ناعمة ٍ ذاتِ مُحب ذابل",31,"ل",1,0],["مِن كُلِّ راضٍ مِن الدُنيا بِدرهمِهِ","وَلَيسَ في نَفسهِ لِلمَجدِ إيثارُ",32,"ر",1,0],["من كلِّ رائِقة الجمال كدُمْيةٍ","في مَرْمرٍ أو صورةٍ من عاج",33,"ج",1,0],["مِن كُلِّ رَيّانِ المَعاطِفِ خَصرُهُ","كَمُحِبِّهِ مِن رِدفِهِ يَتَظَلَّمُ",34,"م",1,0],["مِن كُلِّ رَحبِ المِعاءِ أَجوَفَ نا","ريِّ الحَشا لا يَمَسُّهُ الشَبَعُ",35,"ع",1,0],["مِن كُلِّ رامٍ عَن قَوسِ حاجِبِهِ","بِمُصمِياتٍ نِصالُها الحَوَرُ",36,"ر",1,0],["مِنْ كُلِّ رِيمٍ لا يُرامُ خِباؤُهُ","أَنَّى لِتَبرِيحِ الصَّدَى بِلَمَاهُ",37,"ا",2,0],["مِن كلّ رَقْراق الفِرَنْد كأنَّه","نِهْيٌ إذا ما الغمدُ عنهُ جُرِّدا",38,"د",2,1],["من كلِّ رافعةٍ لها","في الروعِ سَقطَةُ طائِرِ",39,"ر",1,0],["من كُلِّ رُوحٍ بالعَفافِ مقدَّسٍ","فِي كُلِّ جِسمٍ بالسَّناءِ مُقلَّدُ",40,"د",1,0],["من كلِّ رِخو المفِصلين وقد","لفَّ القناةَ بساعدٍ عبَلِ",41,"ل",1,0],["من كلِّ راكبةٍ بفضلِ عَفافِها","والحُسنِ عُنْقَ العائبِ المتعنِّتِ",42,"ت",1,0],["من كلّ ركّابٍ إلى ال","هولِ ظهورَ السُّبَّقِ",43,"ق",1,0],["من كل روح جعلوا","للأمر منهم بدَنا",44,"ن",2,0],["من كل رسول جاء لنا","بالحق وبالدين البهج",45,"ج",1,0],["مِن كُلِّ رَقراقِ الحَواشي فَوقَهُ","كَعُيونِ أَفعى أَو كَعَينِ جَرادِ",46,"د",1,0],["مِنْ كُلِّ رَكَّابِ الْعظَائِمِ ضَارِبٍ","لِلْهَامِ ظَلَّ لأَهْلِهَا أَخَّاذَا",47,"ذ",2,0],["من كل رومية كعاب","شفافة الثوب والإزار",48,"ر",1,0],["من كل رأى تحلى بالسداد وأف","كار بهن أيا لاذ واعتصما",49,"م",2,0],["من كلِّ راكعةٍ تَنو","ءُ ومستعدَّ للسُّجود",50,"د",1,0],["من كلّ ريم كحيل الطّرف ذي حور","وكلّ غُصن رشيق القدّ ذي هيف",51,"ف",1,0],["من كل ريا الردف ظمأى الحشا","صامتة الخلخال بكر حصان",52,"ن",1,0],["مِنْ كُلِّ رَامِي العُيُونِ مَعْرَكَةٌ","مَعْ وَجْنَتَيْهِ وَصُدْغُهُ الزَّرَدُ",53,"د",1,0],["من كل رب جمال لا شبيه له","لولا التقى ليقول المرء سبحانَهْ",54,"ه",1,1],["من كل رائعة سمحت بها غدا","شغفاً يكررها علينا القاري",55,"ر",2,0],["من كل راكبِ صَهوةٍ ومُقلنَسٍ","شاكِ السِلاحِ يصولُ كالفُرسانِ",56,"ن",1,0],["مِن كُلِّ رُعبُوبةٍ تَهفو بِمُصطَبري","قَد زانَها الحُسنُ بَينَ الدَلِّ وَالحوَرِ",57,"ر",1,0],["مِن كُلِّ رُودٍ وازَنت شَمسَ الضُحى","غَيداءَ تَهزَأ بِالغَزال النافِرِ",58,"ر",1,0],["من كل ريم لا عديل لحسنها","رحلت فكان لها الفؤاد عديلا",59,"ل",2,0],["من كلِّ رائعةِ الجمالِ خريدةٍ","رَيَّا الرَّوادفِ كالوذيلة حاصِنِ",60,"ن",1,0],["من كل ريم يصيد الأسد ناظره","ويكسر الجفن يوم الروع من حور",61,"ر",1,0],["من كل رفع خافضيه وناصب","شرك الخيانة للأمانة جازم",62,"م",1,0],["مِن كلِّ رامٍ سَهْمُهُ من وَهْمه","أَهدى إلى إنسانِ عينِ الرَّاني",63,"ن",2,0],["من كل ريشٍ من لحواظها تَرى","سحراً سرى وبذي الصبابة قد نَما",64,"م",2,0],["من كل رافعِ ما أضحى له خبراً","وناصبِ اسمٍ إذا ما لم يُكَفَّ بما",65,"م",2,0],["من كلِّ ريمٍ كَحيلِ الطَّرفِ قد سَقمَت","منهُ الجُفونُ ويشفينا من السَّقمِ",66,"م",1,0],["من كل رائقة المحاسن حلوة","ريا الرواية غضة الإنشاد",67,"د",1,0],["من كلِّ رائِقةٍ الجمالِ زهَت بها","بين القصائِد عِزَّةُ السلطان",68,"ن",1,0],["من كل روض هزار جاء ينشدنا","على تفاوت انشاد والحان",69,"ن",1,0],["مِنْ كُلِّ رُكنٍ طَبْعُهُ تَركِيبُهُ","فِي بُوطِ يَرْبُوطٍ بِهِ النِّبْرِيسُ",70,"س",1,0],["من كل رائشة بساجي لحظها","بحشا المعنى نافذات سهامه",71,"م",2,0],["مِنْ كُلِّ رَيَّا الرِّدْفِ بَهْكَنَةٍ","صِفْرِ الحَشا لَمْياءَ لَعْساءِ",72,"ا",2,0],["من كلّ رعّافِ السِّنانِ إذا","حطم الطِّعانُ مثقّفِ الصّدرِ",73,"ر",1,0],["من كل رامٍ حاجباه قسيه","وعلى القياس فمقلتاه أسهم",74,"م",1,0]]}