try.dctabudhabi.ae/diwan/poem/45098","الكامل"],[4516,"","https://poetry.dctabudhabi.ae/diwan/poem/66853","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72351","الخفيف"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72440","الرمل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72517","الرمل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72394","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139520",""],[4782,"قالت وقد ودعتُها/ بدية","https://www.poetsgate.com/ViewPoem.aspx?id=201018",""],[4852,"(بلقيسة)","https://www.poetsgate.com/ViewPoem.aspx?id=215739",""],[4859,"كل أنثى حين تشدو شاعرة!","https://www.poetsgate.com/ViewPoem.aspx?id=191086",""],[4859,"متفرد!","https://www.poetsgate.com/ViewPoem.aspx?id=207455",""],[4929,"رمال الثلج","https://www.poetsgate.com/ViewPoem.aspx?id=199317",""],[4929,"تسونامي الأتراح","https://www.poetsgate.com/ViewPoem.aspx?id=213359",""],[3271,"في وادي النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=103534",""],[3271,"على مذبح الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=103196",""],[5136,"أدعوه يا قمري غلط","https://www.poetsgate.com/ViewPoem.aspx?id=121933",""],[5277,"ابتسامةٌ بطعم الدمع","https://www.poetsgate.com/ViewPoem.aspx?id=197842",""],[5284,"طفولة","https://www.poetsgate.com/ViewPoem.aspx?id=191791",""],[307,"هلْ زجّ في الأملِ القنوطُ سقاما","https://www.poetsgate.com/ViewPoem.aspx?id=213805",""],[5370,"حيرة","https://www.poetsgate.com/ViewPoem.aspx?id=81642",""],[5409,"قاتل الله من أمية حزباً","https://www.poetsgate.com/ViewPoem.aspx?id=155490",""],[5410,"دَعني أُحِبُّكَ","https://www.poetsgate.com/ViewPoem.aspx?id=73758",""],[5457,"يا صاحبي","https://www.poetsgate.com/ViewPoem.aspx?id=213117",""],[5459,"حروف ثائرة","https://www.poetsgate.com/ViewPoem.aspx?id=197607",""],[5461,"مجموعة انسان","https://www.poetsgate.com/ViewPoem.aspx?id=8542",""],[5525,"جفن الليل","https://www.poetsgate.com/ViewPoem.aspx?id=859",""],[5582,"لَمْ أَسْتَمِعْ يا هِنْدُ نَوْحَ حَمامِ","https://www.poetsgate.com/ViewPoem.aspx?id=187299",""],[5582,"قِفْ وَسَلِّمْ فِي مَغانِي ذِي سَلَمْ","https://www.poetsgate.com/ViewPoem.aspx?id=63570",""],[5616,"سيف على لغتي","https://www.poetsgate.com/ViewPoem.aspx?id=205036",""],[5691,"ذيول العباءات","https://www.poetsgate.com/ViewPoem.aspx?id=205882",""],[5783,"إنما \"هند\"إسم كل جميل","https://www.poetsgate.com/ViewPoem.aspx?id=53716",""],[5829,"اعلان حب هام","https://www.poetsgate.com/ViewPoem.aspx?id=150261",""],[5939,"روبابيكيا","https://www.poetsgate.com/ViewPoem.aspx?id=178625",""],[5956,"في كون الغرامِ","https://www.poetsgate.com/ViewPoem.aspx?id=182093",""],[5956,"أنا أرجو ربي يُلْهمُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=194044",""],[5956,"رسالة جوابية منه لي على الوتس أب","https://www.poetsgate.com/ViewPoem.aspx?id=194394",""],[5960,"أنا حاكمٌ عربيٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=31108",""],[6029,"نشيج المدائن","https://www.poetsgate.com/ViewPoem.aspx?id=189014",""],[6093,"تجرؤ","https://www.poetsgate.com/ViewPoem.aspx?id=203088",""]],"verses":[["وَأَحالوا عَلى المَقاديرِ في حَر","بِكَ لَو أَنَّ عُذرَهُم مَقبولُ",0,"ل",1,0],["وأحاديثَ لو دَعَوْتَ بها الأعْ","صَمَ لَبَّى من حسن ذاك الدعاءِ",1,"ا",2,0],["وأحاشيك أن أفهِّمَك الحج","جةَ أنَّى يُفَهَّمُ الكُتَّابُ",2,"ب",1,0],["واحاجَتي فَعَسى مَولايَ يَذكُرُها","فَإِنَّني في التَقاضي مِنكَ خَجلانُ",3,"ن",1,0],["واحاطت بما هنالك اسرا","ر لعيني تجللت بسواد",4,"د",1,0],["وَأَحاطَت بِعَزمِكَ الجُندُ لَكِن","عَزمُكَ الشُهبُ وَالجُنودُ الظِلامُ",5,"م",1,0],["وَأَحاديثُكَ القِصا","رُ قِلالٌ مُبَرَّدَة",6,"د",2,0],["وَأَحاديثُهُ المُكَرَّرَةُ الغَثَّ","ةُ تُمسي سَحائِبَ الغَثَيانِ",7,"ن",1,0],["وأحاديث أنَّ وَعْدَ رسولِ ال","له بالبعثِ حانَ منه الوفاءُ",8,"ا",2,0],["وَأَحاديثُ خَبَّرَتها غُواةٌ","وَاِفتَرَتها لِلمَكسِبِ القُدَماءُ",9,"م",3,0],["وأحايين تراها من عل","تقذف النار مناطيدهم",10,"م",1,0],["وأحايين في لمى غزلانه","وأحايين في لها فرسانِه",11,"ن",2,0],["وأحاطت بكِ الخمائلُ زُهْراً","كلُّ قَدٍ فيها يعانقُ قَدّا",12,"د",2,0],["وأحاطت بالمارقين وإن لم","تشهرِ السيف، أو تَسُلَّ السنانا",13,"ن",2,0],["وأحايين على لمى غزلانه","وأحايين فى لها فرسانه",14,"ن",2,0],["وأحاطوا من كل وجهٍ بكلى","فبهم قد كلفت حالاً وقالا",15,"ل",2,0],["وأحال لذاتي وساوس حاسب","يهذي بضرب ثلاثة بثماني",16,"ن",2,0],["وأحابيل من الروح الألوف","عرضتني في حياتي للحتوف",17,"ف",1,0],["وأحال الدمع عن رؤيته","لدمي السفح بسفح من دماء",18,"ا",2,0],["وأحاديثُ هَوانا","في الحِمى رَقَّت نسيما",19,"م",2,0],["وأَحالت منه المَعالم فالآ","ثار فالربع فالكثيب المهيلا",20,"ل",2,0],["وَأَحالته الحظوظ عَلى","سر علم اللوح وَالقَلَم",21,"م",1,0],["وأحاديثُ النّدى عَنْ يَديهِ","مُعْرِقاتٍ في الغرابِ الصّحاح",22,"ح",1,0],["وأَحالوني عَلى آثارِهم","ما شَفوا داءً ولا بَلّوا أواما",23,"م",2,0],["وأَحاديث إِذا هَمَّ بِها","مَدمَعي قالَت له لا تَفعلَن",24,"ن",1,0],["وَأَحالَ صِبغَ الليلِ صِبغُ فَعائلي","فظَلامُهُ من دَجنِها قد فاءَ",25,"ا",2,0],["وأحاشيكَ أنْ تُرى عن جوابي","معرضاً أو تُطيل فيهِ عتابي",26,"ب",2,0],["وإحاطة بدقائق ولطائف","قد ضمنت وأتى بها العلمان",27,"ن",1,0],["وأحاديثُ المنى ما صَدَقتْ","بتدانيكم وأضحت أفكا",28,"ك",2,0],["وأَحالَتْ على الفؤادِ غراماً","طالَ تردادُهُ فصارَ غريما",29,"م",2,0],["وأحاديثهم ما تركت","لسواهم موضعا فى مسمعى",30,"ع",2,0],["وأحاديثَ كالسقيط من العق","دِ فإن كنّ السحرَ كنّ حلالَهْ",31,"ل",2,0],["وأحادت صرفَ الصروف وقد","قصّر من وعدها مطيل المطال",32,"ل",1,0],["وإِحاطاتِ قدرَةِ الغَيْبِ في الكُ","لِّ وتَصْريفِ نَشْئِها الفَرْدِيِّ",33,"ي",1,0],["وأحاطت بي الخصوم فجفناً","مستهلاً وصاحباً مستقلا",34,"ل",2,0],["وأحالها شمساً تشعشع نورها","بعد الجمود بسرعة التقليب",35,"ب",1,0],["وأحالوه باطلاً وهو حق","ظاهر الحكم عند كل نجيب",36,"ب",1,0],["وأحاطهم رهط الملائك مثلما","بالملك إجلالا تحف جنود",37,"د",1,0],["وأحاطوا بابن النبي عناداً","لأبيه ولم يراعوا ذماما",38,"م",2,0],["وَأَحاطَت بِهِ الفَوارسُ فَازدا","د شُجوناً وَقلّ مِنهُ عَزاه",39,"ا",2,0],["واحالت على الكرى بلقاء","ما درت ان لي كرى مستحيلا",40,"ل",2,0],["وَأحارَنِي مَرَضاً وَأَوْهَنَ قُوَّتِي","فَغَدَوْتُ مِنْهُ وَقَدْ صَحِحْتُ مُمَرَّضا",41,"ض",2,0],["وأحالَتْ دُهْمَاً عَلَى الرَّأْسِ شُهْباً","لَيْسَ يَجِزي بِخَيْلِهِ اللَّهْوِ شُهْب",42,"ب",1,0],["وأحاديث العلا","عظمت أن تُشرحا",43,"ح",2,0],["وأحاطت بها حدائقُ غُلبٌ","فتدلّت ظِلالُها وجناها",44,"ا",3,0],["وأحاط بالأعدا وقسّم جمعهم","ما بين مأسور وبين مجندل",45,"ل",1,0],["وأحاكي ثرى البقيع بدمع","أكسب الخد حيث سال احمرارا",46,"ر",2,0],["وَأَحاطَ المُلك والإقليم بالس","سيف والرمحِ الرديني والقَلَم",47,"م",1,0],["وَأَحاديثُ في خِلال الأَغاني","كَاِبتِسامِ الرِياضِ غَب القَطار",48,"ر",1,0],["وأحاجيك والأريب يحاجى","وعسى أن سئلت أن لا تجيبا",49,"ب",2,0],["واحاجتاه إليك إذ كم نشتكي","فقدان محكم رأيك المقبولُ",50,"ل",1,0],["وَأُحاوِلُ السلوانَ عَن حُبّي له","فَيعزُّني منه أَغرُّ مُفَلَّجُ",51,"ج",1,1],["واحالاه حضيرة قدس","بضراح جل عن ان اقيسا",52,"س",2,0],["وأحاشيك منالبخل وأن","تغتدي هجو لسان الشعرا",53,"ر",2,0],["وأحالت نير الصبح دجى","فغدا الغادي به يخبط عشوى",54,"و",2,0],["وأحال الهوى الحقائق حتى","صار عذباً عند المحب عذابه",55,"ب",2,0],["وأحاديث قوم نوح ولوط","وزخاريف وصف ذات العماد",56,"د",1,0],["وأحاطوا به فكان سفينا","فى خضم أجد بالازيادِ",57,"د",1,0],["وأحَاطَ بالآدابِ مُبتدعاً","كالعقد حاطَ الجيدَ وازدهرَا",58,"ر",2,0],["وأحاطت بي الخطايا وإني","ليكاد القنوط يصدع قلبي",59,"ب",2,0],["وأحالَ ريِّقَةُ على تزيازَةٍ","ودِرارِ سُطفٍ بالذنوبِ الأثجَلِ",60,"ل",1,0],["وأحال شوقهم إلى أترابهم","إذ ينتظن متى يكون إياب",61,"ب",1,0],["وأَحاطت بالمُجْرِمينَ غواديه","إحاطةَ العقدِ بالأعناق",62,"ق",1,0],["واحاطني جيشُ الدّجى بسكونه","فتراكمت حولي هُمُومُ شُجُوني",63,"ن",2,0],["وَأَحادِيثُ الغَضا هَل عَلِمَت","أَنَّها تَملِكُ قَلبي قَبلَ أذني",64,"ن",2,0],["وَ أَحَالَ الحُلُمَ المَفقُودَ فعلاً واقِعِيّا","وَ أذلَّ المُستَحيلَ الصَّعبَ إذلالاً عَتِيّا",65,"ي",2,0],["وأحاطَ الأكوانَ فضلاً وجُوداً","حَوطانَ الهواءِ بالأكوانِ",66,"ن",1,0],["وأحاشيك أن تكون خليلاً","مذق الود للصديق معارا",67,"ر",2,0],["وأحاطت به الجبال ليبقى","معبداً ناطقاً بفضل الباري",68,"ر",2,0],["وأحاطت بهن هالة عطر","يا لنور مضمخ بالعبير",69,"ر",1,0],["وأحاط علمهم بأقصى","ما يحيط به بشر",70,"ر",1,0],["وأحالها التحريم لم","ما شبهت بدم الحسين",71,"ن",1,0],["وأحالَ بردُ مزاجِهِ","نارَ الصبا بعدَ اللهيب",72,"ب",1,0],["وأحاطت بالمسلمين علوج ال","بغي من كل جانب ومكان",73,"ن",1,0],["وأحاطَتْ بهِ كتائِبُ تُنْمى","لعُلَى اليوسُفيِّ غُلْبٌ أشاوِسْ",74,"س",1,0],["واحالَ عدلَ ابيهِ منهُ لرحمةٍ","ومحبَّةٍ عَظُمَت لديهِ وتَعظُمُ",75,"م",1,0],["واحاطوا بنا وقد منعونا","إستقاء من نيلِنا أو نُصوَّب",76,"ب",1,0],["وأحاديث ان رواهن راوٍ","خلته قد جلا الكؤوس الرويه",77,"ه",1,0],["وأحاط بي يرمي بكلّ ملمَّةٍ","من كل داهية وصرفٍ منكد",78,"د",1,0],["واحاته الراحات تولي والعنا","للأولياء له وللأعداء",79,"ا",2,0],["وأحاطت بى الخصوم أمامى","ويمينى ويسرتى وورائى",80,"ا",2,0],["وَأَحالَهُ راحاً فَحالَ كَأَنَّهُ","قَلَبَ الحَقائِقَ ساحِراً وَمُشَعوِذا",81,"ذ",2,0],["وأحال لذاتي وساوس حاسب","يهذي بضرب ثلاثة بثمان",82,"ن",1,0],["وأحاطت بالمجد في الطول والعرض","كل فضل من فضلها يتبعض",83,"ض",1,0],["وأحاديث علا سلسلها","ألحق الآباء منها بالجدود",84,"د",1,0],["وأحاطت هالة في بدرها","فحكت عقدا زها في منحر",85,"ر",1,0],["وأحالت ليل المضلين صبحا","فيه للهدى والرشاد ظهور",86,"ر",1,0],["وأحاطت منها بأسرار غيب","حسدتها مناطق وخصور",86,"ر",1,0],["وأحالت دجى الليالي ضياءاً","فاصارت جزع الظلام شهابا",87,"ب",2,0],["واحاتها🌴🌴ورمالها","ونسائمٌ تجلو الأسية",88,"ي",2,0],["وأحال عينيّ الذي خلف الفضا","مثلَ المكاحل فوق جفني قرْبا",89,"ب",2,0],["وأحاديثي بفصحى جنبتْ","مهجتي كلّ القلوبِ الغادرة",90,"ر",2,0],["وأحالَها عزفاً بديعاً مترفاً","يستجلبُ العذالَ حسنٌ زانَه",91,"ن",2,0],["وإِحارٌ بلا ِفُلْكٍ بِبَحْرٍ","تَلاطَمُ فيهِ أمواجُٰ الجافِ",92,"ف",1,0],["وأحالتْ للشرِّ أيامَه نا","راً تلَظَّى إنْ تخبُ تنمُ اشتعالا",93,"ل",2,0],["وأحالها فنُّ المصوّر آيةً","سرتِ الحياةُ بها فكادت تطفرُ",94,"ر",1,0],["وأحالها مزقاً صواغر أصبحت","كفنا يُذيق القيدَ مُرّ شمات",95,"ت",1,0],["وأحاد نوني حاجبيه","بمشقه لهما وخط",96,"ط",1,0],["وأحارُ لا أدري إذا فارقتها","أأرَى بمجرى الروحِ بعدُ غراما",97,"م",2,0],["وَأَحَالَنِيْ رَجُلًا يَطُوْفُ بِسَبْعَةٍ","مِنْ عُمْرِهِ فَوْقَ الدُّرُوْبِ الشَّائِبَهْ",98,"ب",2,0],["وأحالَ رفض الطامحين تخاذلاً","واغتالَ في صدرِ الغزاة هُماما",99,"م",2,0],["واحاول آخفّي جروحي بروحي","واخيط جرح وتنفتق عدة اجراح",100,"ح",1,0],["وأحاديث ضدك ابتدعوهن","نَ لتعدي الصحيحة الجرباء",101,"ا",2,0],["وأَحالَ ما بينَ القلوبِ حَرائقاً","ليُصَيِّرَ النبضَ السليمَ حَقُودا",102,"د",2,0],["وأحاربُ الشوقَ المَقيتَ تهالكًا","والقلبُ من نزفِ الدماءِ ترمَّدا",103,"د",2,0],["وأحَالَ هانئةَ الجِنَانِ مَوَاجِعًا","وتعاسةً وعَذابَ نَارِ جَهنَّمِ..",104,"م",1,0],["واحاوم صقور الهوا حوم نشوان","واسيّل الوديان دمعٍ حزيني",105,"ن",2,0],["واحاكي الجدران عن وصف غرفه","ماتشبه الجدران ويطول وصفي",106,"ف",2,0],["وَأَحاطَ إِقْلِيمَ البِلادِ سِياسَةً","بِالبِيضِ وَالآراءِ وَالأَقْلامِ",107,"م",1,0],["-وَأَحاطَ المُلْكَ وَالإِقْلِيمَ بِال","سَّيْفِ وَالرُّمْحِ الرُّدَيْنِي وَالقَلَمْ",108,"م",1,0],["وأحارُ حين أرى \"أُمَامَ\" تَلومني","ماذا أقولُ لها وماذا أَسرُدُ",109,"د",1,0],["وأحاطوا لِسانَهُ بالمَقاريضِ","لإرْهابِهِ بسوءِ الجَزاءِ",110,"ا",2,0],["وأحايين أزدري كل أنثى","غير هندٍ.. ما مثلها حواء",111,"ا",2,0],["واحاطني طيف يواس وحدتي","يشدو يناجي دون أن يتكلما",112,"م",2,0],["وأُحاولُ في لحظةِ شَغَفٍ تَستهويني","أن أجمعَ نَزِقًا مِن تلكَ الخُردةِ شَيّا",113,"ي",2,0],["وأحاسيسُ جمالٍ","وانتعاشٍ واضطرامِ",114,"م",1,0],["وأحاول أن أدنو خطوةْ","لصديقٍ معروفِ النخوةْ..",115,"ه",1,0],["وأحار كيف تردّ روحي فضله","فرأيتُ أن أهدي له إطرابا",116,"ب",2,0],["وأُحاربُ الدّينَ الحَنيفَ , فَسادَتي","وصَفوهُ بالإرهابِ والرَّجعيَّةْ",117,"ي",2,0],["وآحادٌ تُفيقُ على نَحيبٍ","ومِئذنةٌ يُحرِّقُها النُّواحُ",118,"ح",1,0],["وأحارُ في سُودِ العيونِ وفي","خُضْرٍ هوايَ وأعشقُ الزّرْقا",119,"ق",2,0]]}