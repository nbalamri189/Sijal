{"poems":[[92,"فداء لمثواك","https://www.aldiwan.net/poem59036.html","عموديه"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/142406","البسيط"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21083","المنسرح"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42568","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42730","الطويل"],[92,"أخي جعفر","https://www.poetsgate.com/ViewPoem.aspx?id=179226",""],[173,"بسمر القنا والمرهفات الصوارم","https://www.aldiwan.net/poem1673.html",""],[275,"رويدك لا تأسف ولا تتندم","https://www.aldiwan.net/poem35070.html","الطويل"],[280,"أعد نظرا إلى الزمن النضير","https://www.aldiwan.net/poem25566.html","الوافر"],[422,"أقلب طرفي ولا أرى غير منظر","https://www.aldiwan.net/poem54121.html","الطويل"],[491,"أرسم ديار بالستارين تعرفُ","https://www.aldiwan.net/poem482.html",""],[1175,"","https://poetry.dctabudhabi.ae/diwan/poem/67749","الطويل"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145166","المتقارب"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53181","الوافر"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106874","الطويل"],[2447,"","https://poetry.dctabudhabi.ae/diwan/poem/198717","الوافر"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100265","الطويل"],[3616,"","https://poetry.dctabudhabi.ae/diwan/poem/147696","المتقارب"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103020","الطويل"],[243,"ثورة 14 رمضان","https://www.poetsgate.com/ViewPoem.aspx?id=19625",""],[5829,"يا تراب المجد","https://www.poetsgate.com/ViewPoem.aspx?id=192052",""]],"verses":[["تَقَحَّمْتَ صَدْرِي ورَيْبُ الشُّكُوكِ","يِضِجُّ بِجُدْرَانِهِ الأَرْبَعِ",0,"ع",1,0],["تقحّمت كبريائي بوم محنتها","ما سامع االمحنة الكبرى كمن شهدا",1,"د",2,0],["تَقَحَّمَ الآنِيَ العَبيطَ كَماَ","قَحَّمَ غَربُ المَحَالَةِ الَجمَلُ",2,"ل",1,1],["تَقَحَّمْتُهُ والرُّمْحُ صَدْيانُ يَنْتَحي","نِطافَ الْكُلَى والْمَوْتُ يَمْضِي وَعِيدُهُ",3,"د",2,0],["تَقَحَّمْتُهُ فَرْدَاً سِوَى النَّصْلِ وَحْدَهُ","وَحَسْبُ الْفَتَى أَنْ يَطْلُبَ النَّصْرَ بِالنَّصْلِ",4,"ل",1,0],["تَقَحَّمْ ، لُعِنْتَ ، أزيزَ الرَّصاص","وَجرِّبْ من الحظّ ما يُقسَم",5,"م",1,0],["تَقَحَّمْ ، لُعِنْتَ ، فما تَرتجي","مِن العيش عن وِرده تُحرَم",5,"م",1,0],["تقحَّمْ فمَنْ ذا يَخوضُ المَنون","إذا عافَها الأنكدُ الأشأم",5,"م",1,0],["تقحَّمْ فمَنْ ذا يلومُ البطين","إذا كان مِثلُكَ لا يَقْحَم",5,"م",1,0],["تَقَحَّمَها قُدماً إِلى المَوتِ فِتيَةٌ","تَرى عِيشَةً في الذُلِّ حَزَّ الغَلاصِمِ",6,"م",1,0],["تقَحَّم غِمارَ المجدِ فالموتُ واحدٌ","وإن تلقَ وجهاً عابساً فتَبَسَّم",7,"م",1,0],["تَقَحّم غَمْرة الأخْطارِ لَمّا","سَما هِمَماً إِلى نَيْلِ الخَطيرِ",8,"ر",1,0],["تقحّمتْ الأَمرَ الخطير تقحّما","تروح رواءً ترتمي أيَّ مرتمى",9,"م",2,0],["تَقَحَّمتُ لَيلَ العيسِ وَهيَ رَذِيَّةٌ","وَكَلَّفتُ أَصحابي الوَجيفَ فَأَوجَفوا",10,"ف",3,0],["تَقَحَّمَهَا قِدْماً عدِيُّ بن حَاتِمٍ","وَالأشْتَرُ يَهْدِي الخَيْلَ في وَضَحِ الفجرِ",11,"ر",1,0],["تقحمتُ فيها الصعاب التي","يضيق بها الواغل المجتري",12,"ر",2,0],["تَقَحَّمَ حولها وسما إليها","وكان لحرِّ تلك النار صالي",13,"ل",2,0],["تَقحَّمتُ أهوال الحياة لغايةٍ","بقيتُ إلى تحقيقها متتبعا",14,"ع",2,0],["تقحمها شذاتك وهي بكر","فكيف لقيتها حربا عوانا",15,"ن",2,0],["تقحَّم دون العز صعب مواردٍ","وما زال حتى راض صعب المواردِ",16,"د",1,0],["تقحمت جاحم نار الضلوع","كما خضت بحر دموع الحدقْ",17,"ق",1,0],["تقحمهها قدما إلى الموت فتية","ثوى عيشها في الذل حز الغلاصم",18,"م",1,0],["تقحمت أو كان المنيات والسنا","يئن وآلاف الشاياطين تصفر",19,"ر",1,0],["تقحَّمَ في الوغى هول الرزايا","وأوغل وارتقى وهو الفخورُ",20,"ر",1,0]]}