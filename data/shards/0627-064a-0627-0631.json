05572",""],[5956,"دعاء في موضوع النساء","https://www.poetsgate.com/ViewPoem.aspx?id=181866",""],[5956,"ألفُ شكر","https://www.poetsgate.com/ViewPoem.aspx?id=182374",""],[5956,"دفاع عن الحظائر *","https://www.poetsgate.com/ViewPoem.aspx?id=183370",""],[5956,"عقدة النقص لدى إسرائيل","https://www.poetsgate.com/ViewPoem.aspx?id=192310",""],[5956,"توديع الابن","https://www.poetsgate.com/ViewPoem.aspx?id=192523",""],[5956,"أيا رب طمئن فؤادي وقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=194710",""],[5956,"الطفل أرتين يناجي ابنَي عمته وأسرتهما","https://www.poetsgate.com/ViewPoem.aspx?id=210842",""],[5969,"تُبارِكُكَ الخَوافِقُ والعقولُ","https://www.poetsgate.com/ViewPoem.aspx?id=198959",""],[5977,"مشاطرة الفؤاد","https://www.poetsgate.com/ViewPoem.aspx?id=212851",""],[6004,"أيُّ ربيعٍ أنتَ","https://www.poetsgate.com/ViewPoem.aspx?id=109515",""],[161,"حنين الأنام لحج بيت الله الحرام","https://www.poetsgate.com/ViewPoem.aspx?id=175362",""],[6066,"اللج العقيم","https://www.poetsgate.com/ViewPoem.aspx?id=36766",""],[4442,"أيا ريحانتي برياض أني","https://www.poetsgate.com/ViewPoem.aspx?id=171216",""],[6082,"المصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=58835",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[5957,"فمصر الطهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82597&r=&rc=137",""],[572,"لهُ شُغُلٌ عنْ سؤالِ الطّلَلْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9447&r=&rc=304",""]],"verses":[["أَيا راكِباً تَرمي بِهِ اللَيلَ جَسرَةٌ","لَها نِمرِقٌ مِن نَيِّها وَوِراكُ",0,"ك",1,1],["أَيا رَبَّةَ الخِدرِ المُمَنَّعِ بِالقَنا","أَتَنأَينَ لَم تَنظُر بِكِ العَينُ مَنظَرا",1,"ر",2,1],["أيا ربة السعد المساعد والأنس","أعيذك بالآي المعوذة الخمس",2,"س",1,1],["أيا راكِبَ البَحْرِ الأجاجِ مُخاطِراً","تقدّمْ باسْمِ اللهِ مُرْساكَ والمَجْرا",3,"ر",2,1],["أَيَا رَوضَةَ الوَضَّاحِ يا خَيرَ رَوضَةٍ","لأَِهلِكِ لَو جَادُوا عَلَينا بمَنزِلِ",4,"ل",1,1],["أَيا راكِباً نَحوَ الجَزيرَةِ جَسرَةً","عُذافِرَةً إِنَّ الحَديثَ شُجونُ",5,"ن",1,1],["أَيا رَبِّ حَتّى الحَليُ مِمّا نَخافُهُ","وَحَتّى بَياضُ الصُبحِ مِمّا نُحاذِرِ",6,"ر",1,0],["أَيا راكِباً تُحدى بِأَعوادِ رَحلِهِ","عُذافِرَةٌ عَيرانَةٌ وَعُذافِرُ",6,"ر",1,0],["أيا رب لو سويتَ بيني وبينه","لَما كان عَدْلاً أن نكونَ سواءَ",7,"ا",2,1],["أَيا راكِباً إِمّا عَرَضتَ فَبَلِّغَن","نُباتَةَ بِالحِصنَينِ وَاِبنَ المُحَلَّقِ",8,"ق",1,1],["أَيّارُ مَذكورٌ بِحُسنِ صَنيعِهِ","وَلَئِن تَوَلّى وَاِنقَضى أَيّارُ",9,"ر",1,0],["أَيّارُ يا شاعِرَ الشُهورِ","وَبَسمَةَ الحُبِّ في الدُهورِ",10,"ر",1,1],["أَيا رَمزَ لُبنانٍ جَلالاً وَهَيبَةً","وَحُصنَ الوَفاءِ المَحضِ في ذَلِكَ الحوسنِ",11,"ن",1,0],["أَيا راكِباً إِمّا عَرَضتَ فَبَلِّغَن","بَني ناشِبٍ عَنّي وَمَن يَتَنَشَّبُ",12,"ب",1,1],["أَيا ريحَ الشَمالِ أَما تَرَيني","أَهيمُ وَإِنَّني بادي النُحولِ",13,"ل",1,1],["أَيا رامِياً يُصمي فُؤادَ مَرامِهِ","تُرَبّي عِداهُ ريشَها لِسِهامِهِ",14,"م",2,1],["أَيا رَبِّ مِنّا الضَعفُ إِن لَم تُقَوِّنا","عَلى شُكرِ ما أَبلَيتَ مِنكَ وَأَولَيتا",15,"ت",2,0],["أَيا رَبِّ نَحنُ الفائِزونَ غَداً لَئِن","تَوَلَّيتَنا يا رَبِّ فيمَن تَوَلَّيتا",15,"ت",2,0],["أَيا رَبِّ يا ذا العَرشِ أَنتَ رَحيمُ","وَأَنتَ بِما تُخفي الصُدورُ عَليمُ",16,"م",1,1],["أَيا رَبُّ حَتّى في الحَداقِقِ أَعيُنٍ","عَلَينا وَحَتّى في الرَياحينِ نَمّامُ",17,"م",1,0],["أَيا رَبُّ قَد عَوَّدتَني مِنكَ نِعمَةً","أَجودُ بِها لِلوافِدينَ بِلا مَنِّ",18,"ن",1,1],["أيا ربّ عفواً عن ظلومٍ لنفسهِ","رَجاكَ وإن كان العفافُ به أولى",19,"ل",2,1],["أَيا ربِّ إنَّ الخَلْقَ لا أرتجيهمُ","فكلّ ضعيف لا يُمِرّ ولا يُحلي",20,"ل",2,0],["أيا رشاقةَ غُصْنِ البان ما هَصَرَكْ","ويا تألُّفَ نظم الشمل مَنْ نَثَرَك",21,"ك",1,1],["أَيا رَبِّ لا آلو المَوَدَّةَ جاهِداً","لِأَسماءَ فَاِصنَع بي الَّذي أَنتَ صانِعُ",22,"ع",1,1],["أَيا رَبِّ إِن لَم تَقسِمِ الحُبَّ بَينَنا","سَواءَينِ فَاِجعَلني عَلى حُبِّها جَلدا",23,"د",2,1],["أَيا رَبَّ لا تَقبَل صَلاةَ مَعاشِرٍ","يَأُمُّهُمُ دَيرُ النُمَيرِيِّ رُكَّعا",24,"ع",2,1],["أَيا رُبَّ وَجهٍ في التُرابِ عَتيقِ","وَيا رُبَّ حُسنٍ في التُرابِ رَقيقِ",25,"ق",1,1],["أَيَا رَبَّةَ الْبَيْتِ بَعْضُ النُّفُو","سِ يَدُلُّ عَلَيْهَا جَمَالُ الصُّوَرْ",26,"ر",1,0],["أَيا ربعَ صبري كيف طاوَعَك البلى","فجَدَّدتَ عَهْدَ الشَوقِ في دِمَنِ الهوى",27,"ا",1,1],["أَيا رَكبُ حُيِّيتُم وَجادَت بِلادَكُمُ","غَمائِمُ أَدنى سَحِّهِنَّ سِجالُ",28,"ل",1,0],["أَيا رَبِّ أَدعُوكَ العَشِيَّةَ مُخلِصاً","لِتَعفوَ عَن نَفسٍ كَثِيرٍ ذُنُوبُهَا",29,"ب",3,1],["أَيَارَبِّ أَذَا الْعِزَّهْ","أَمَنْ يَسْقِي الْوَرَى عِزَّهْ",30,"ز",2,1],["أيا رمضان الزائر الراحل الّذي","تودعنا بالبين هل أنت راجع",31,"ع",1,0],["أيا روميّةً سَلبَت فؤادي","وأنسَتني عهودَ الرقمتين",32,"ن",1,0],["أيا ريح الصبا إن جزت روضاً","تثنى في خمائله الحبيبُ",33,"ب",1,1],["أَيا ربّ حتّى في الحدائقِ أعينٌ","تُعيّنني مَهما صَفت ليَ أيّامُ",34,"م",1,0],["أَيَارُبَّ مَن ظَنَّني عَاجِزاً","عَنِ القَوْلِ والقَوْلُ عِنْدِي عَتِيدُ",35,"د",1,1],["أَيا روحَ روحي رَأَيت العَجَب","لِبُعدك يا غايَتي وَالأَرَب",36,"ب",1,1],["أيا رُكنَ إسلامٍ أُراقِبُ حَجَّه","ولي عنه دَهْري مُحصَرٌ ومُحاصَر",37,"ر",1,0],["أَيا رَبعُ قل لي كَيفَ حالُكَ بَعدَ ما","تَفانَوا فَقالَ الرَبعُ لَم يَبقَ بَعدَ ما",38,"م",2,0],["أيا راحلا\" خلف أهوائه","تأمل حنيني ولا ترحل",39,"ل",1,0],["أيا راحلاً أفنى فراقك راحتي","وألهب ما بين الجوانح نيرانا",40,"ن",2,0],["أيا راكباً يطوي الفلاة ببكرةٍ","يباع بها النهد المطهم والخال",41,"ل",1,0],["أيا رب يوم هتكت الستار","لخلع العذار بظبي ودن",42,"ن",1,0],["أيا رب ذا الملك العظيم ومن له","مغامات صدق في الليالي الحوالك",43,"ك",1,0],["أيا رب قد ألقيت رحل رجائي","وأملت أن ألقى مناء منائي",44,"ي",1,1],["أيا رباه إن جواء ليلى","كحبك عندنا نعم الجواء",45,"ا",2,0],["أيا رباه دعوة مستغيث","أجل عتاد نصرته الدعاء",45,"ا",2,0],["أيا رازق الفرخ الذي مات جلده","رياشاً لوم تحسن له حركات",46,"ت",1,0],["أيا رباه حبي وجه ليلى","لحبك راجياً حسن الجواز",47,"ز",1,0],["أيا رباه عفوك عن عبيد","أناب وإن دعاك على وقاز",47,"ز",1,0],["أيا رباه قيني شح نفسي","وقدس أصغري من النفاق",48,"ق",1,0],["أيا رباه دعوة مستضيق","غريب الدار في البلد المضيق",49,"ق",1,1],["أيا رباه خلصني وصحبي","من الذؤبان كالحة الشدوق",49,"ق",1,0],["أيا رباه إني مستغيثٌ","أغثني أنت أفضل مستغاث",50,"ث",1,0],["أيا رباه دعوة مستغيثٍ","أسير غل بالعمل الخبيث",51,"ث",1,1],["أيا رب أنت عليم بدائي","وعفوك مولاي أشفي العلاج",52,"ج",1,0],["أيا رباه يا معبو","د والمعبود مقصود",53,"د",1,0],["أيا رب يا من لا يحاط بوصفه","تعاليت عن حد الكلام وصوف",54,"ف",1,0],["أيا رب توفيقاً وعفواً ورحمةً","لقد كثرت منيي فيك الجرائم",55,"م",1,0],["أيا رباه لي عمل قبيح","وفيك عقيدة الأمل المتين",56,"ن",1,0],["أيا رباه أسألك الصفوحا","عن الذنب الذي أمسى جموحا",57,"ح",2,0],["أي أرض إرضنا في الكائنات","أم تراه مثلنا قد رجموا",58,"م",3,0],["أيا روضةً تحكي النسيم أريجها","إِذا نحن لم نُسْرح بألفافها طَرفا",59,"ف",2,0],["أيّار كاد يذوب عطرا سابغا","وجمال ألوان وجمّ حنان",60,"ن",1,1],["أيا راكبا ظهرَ مجدولةٍ","تُخالُ إذا انبسطت أجدلا",61,"ل",2,0],["أيا ربعَ الهوى دعْ لي طريقي","فلا حبسي إليكَ ولا اعتياقي",62,"ق",2,0],["أيا راكبَ الوجناءِ يخبط ليلَه","على الرزق لم يقصِد ضلالاً لمَقصدِ",63,"د",1,0],["أيا راكبَ العشواءِ يطرَحُ صدرَها","خِطاراً على الشِّقِّ الذي هو أتعبُ",64,"ب",1,0],["أَيا رِفقَةً مِن أَهلِ بَصرى تَحَمَّلَت","تَؤُمُّ الحِمى لُقّيتِ مِن رِفقَةٍ رُشدا",65,"د",2,0],["أَيا راكِباً إِمّا عَرَضتَ فَبَلِّغَن","هُديتَ أَميرَ المُؤمِنينَ رَسائِلي",66,"ل",2,1],["أيا رشأً اعارَ الظبيَ جيداً","يُدِلُّ بحسنِه في كلَّ سربِ",67,"ب",1,0],["أيا ربة الخال التي فتنت به","أما لك في وصل أما لك جائر",68,"ر",1,1],["أيا رب أندى فرعه المجد فارعه","ولا تخل ذاك الصدر من ذلك الصدر",69,"ر",1,0],["أيا ربُ اهلي في يَديك وديعةٌ","وما عَدِمَت صوناً لديك الودائعُ",70,"ع",1,0],["أيا رِحْلَةَ الطّلاّبِ مَنْ ذاك يُرْتَجى","لَحلِّ عُقُودِ المعْضِلاتِ الْعَظائِمِ",71,"م",1,0],["أَيا رَحْمَةَ الرَّحْمَنِ حِلّي بِقَبْرِهِ","وَدُومِي عَلَيْهِ دَائِماً لا تُفارِقِي",72,"ق",2,0],["أَيا رُوحَ عَبْدِ الهادِي الْبَرِّ دُمْتِ في","نَعيمٍ وإكْرامٍ منَ اللهِ خالِقِي",72,"ق",2,0],["أَيَا رَبِّ هَلْ مِنْ نُصْرَةٍ لشَرِيعَةٍ","أَتانَا بِها عَنْكَ الرَّسولُ المطَهَّرُ",73,"ر",1,1],["أيا رَبِّ لا تُمْهِلْهُمُ منْ عُقُوبَةٍ","فإنَّكَ إنْ تُمْهِلْهُمُ الْيَوْمَ يَبْطَروا",73,"ر",3,0],["أيا رب وقف لخير المقال","إِنْ لَمْ أُوَفَّقْ لِخَيْرِ العَمَلْ",74,"ل",1,0],["أَيا راحِلاًُ عَنا إِلى المُلكِ الَّذي","دَعاهُ إِلى عَيشٍ مِنَ الخُلدِ ناعِمِ",75,"م",1,0],["أَيا رَبّاهُ أَكتُمُ حُبّ لَيلَى","وَأجحَدُهُ وَأنتَ بِهِ عَليمُ",76,"م",1,0],["أيا راكباً نحو المدينةِ جَسْرَةً","عُذافِرَةً يَطوي بها كلَّ سبسب",77,"ب",1,1],["أيا راحلاً عني أَلِفتُ لفقدهِ","كدورةَ عيشٍ لا أَرُومُ لهُ صفوا",78,"و",2,0],["أَيا راجِياً لِلفَوز بِالسَبق بَعدَه","تَأخَّر فَما كُل الطُيور عُقاب",79,"ب",1,0],["أيا ربّاً إذا يُدعَى يُجيبُ","دعوتُكَ فاستجبْ لي يا مُجيبُ",80,"ب",1,1],["أيا رَحْمَةً إِلّا لِمَشْغوفِ حُبِّها","حَنانَيْك في صَبٍّ أُهَيل مغرّبِ",81,"ب",1,0],["أيا رنة الناعي عبثتِ بسمعي","فأججتِ نارَ الحُزنِ ما بينَ أضلُعي",82,"ع",2,1],["أيا ربِّ انَّ الأقرباءَ تباعدوا","وعُومِلُت منهم بالقطيعةِ والهَجرِ",83,"ر",1,1],["أيا راحلاً ولّى وخلّى بمهجتي","أجيجاً تلاقى زندُهُ وزِنادهُ",84,"د",2,0],["أيا رَنَّة الناعي بِسُعدي تأيّدي","على كبدٍ حَرَّى وجَفنٍ مُسهَّدِ",85,"د",1,1],["أيا ربنا إذن بالظهور لغائب","يقوم وبالتنزيل يقضي ويحكم",86,"م",1,0],["أَيا رَبِّ إِنّ العُمرَ وَلّى كَثيرهُ","فَيا رَبِّ تَمِّمْه بِحُسنِ الختامِ",87,"م",1,1],["أَيا رَبَّة الطَّرفِ الّذي مِن سِهامِهِ","يَذوبُ فُؤادي ثمَّ تَبقى النّصولُ",88,"ل",1,1],["أَيا رَبِّ قَد أَولَعتَ قَلبي بِأَغيَدٍ","جَميلٍ وَلَيسَ البدر يَحكي جَمالَهُ",89,"ه",1,1],["أيا ربُّ حسنَ التخلُّصِ ممّا","بُليتُ فَذا مُنتَهى الأمَلِ",90,"ل",1,1],["أيا رَاحِلاً لمْ يُغادِرْ مَكانَهْ","وَيَا فارسَاً لمْ يُهَدِّلْ عِنانَهْ",91,"ن",2,1],["أيا راكب الوجناء في طلب العلى","سيكفيك عزم في العلاء عريق",92,"ق",1,0],["أيا راحلاً عنّا ببهجة قادمٍ","إلى أهله ما كان حالك من بعدي",93,"د",2,0],["أَيا رُكنِي إِذا ما أَدَّ خَطبٌ","دَها وَمُؤَنِّسِي بِحَدِيثِ رَيّا",94,"ي",2,0],["أيا ريع ذاتِ الخالِ لا بت خاليا","وأصبحت من نور الخمائل حاليا",95,"ي",2