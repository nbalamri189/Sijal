{"poems":[[55,"أراك ستحدث للقلب وجدا","https://www.aldiwan.net/poem30614.html","المتقارب"],[0,"أعني على برق أراه وميضِ","https://www.aldiwan.net/poem54.html","الطويل"],[32,"أقول لأطلاح برى هطلانها","https://www.aldiwan.net/poem29552.html","الطويل"],[32,"أمنزلتي مي سلام عليكما علي","https://www.aldiwan.net/poem29608.html","الطويل"],[90,"من مبلغ المنصور عن بغداد","https://www.aldiwan.net/poem45006.html","الكامل"],[29,"لمن الديار كأنها لم تحلل","https://www.aldiwan.net/poem5967.html","الكامل"],[74,"أفدي غزالا من الأتراك مقلته","https://www.aldiwan.net/poem18686.html","البسيط"],[74,"أعدى بغيركم دمع المحبينا","https://www.aldiwan.net/poem20172.html","البسيط"],[74,"ما للندى لا يلبي صوت داعيه","https://www.aldiwan.net/poem20565.html","البسيط"],[53,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[93,"سلام عليكم رجال الوفاء","https://www.aldiwan.net/poem8785.html","عموديه"],[80,"كذا يهلك السيف في جفنه","https://www.aldiwan.net/poem14220.html","المتقارب"],[91,"الفن روض أنيق غير مسؤوم","https://www.aldiwan.net/poem44743.html","البسيط"],[45,"ضروب الناس عشاق ضروبا","https://www.aldiwan.net/poem9501.html","الوافر"],[64,"فديتك قد حان وقت الصبوح","https://www.aldiwan.net/poem52395.html","المتقارب"],[30,"وإذا نظرت رأيت فوقك دارما","https://www.aldiwan.net/poem5253.html","الكامل"],[30,"أقول لحرف قد تخون نيها","https://www.aldiwan.net/poem5396.html","الطويل"],[30,"ولما رأت ما كان يأوي ورائها","https://www.aldiwan.net/poem5399.html","الطويل"],[63,"شيخ لنا من شيوخ بغداد","https://www.aldiwan.net/poem51688.html","المنسرح"],[51,"رأيتك فيما يخطئ الناس تنظر","https://www.aldiwan.net/poem62101.html","الطويل"],[51,"أتبكي لهذا الموت أم أنت عارف","https://www.aldiwan.net/poem62180.html","الطويل"],[18,"أليلتنا بذي حسم أنيري","https://www.aldiwan.net/poem23949.html","الوافر"],[82,"وصفراء كالشمس تبدو لنا","https://www.aldiwan.net/poem31464.html","المتقارب"],[50,"كان الشباب مطية الجهل","https://www.aldiwan.net/poem64491.html","الكامل"],[50,"ثقيل يطالعنا من أمم","https://www.aldiwan.net/poem65265.html","المتقارب"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85649","الطويل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140900",""],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39663","الوافر"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16694","الطويل"],[30,"ترى كل منشق القميص كأنما","https://www.poetsgate.com/ViewPoem.aspx?id=21733",""],[154,"صدروا وسحر لحاظهم يغريني","https://www.aldiwan.net/poem68480.html","الكامل"],[164,"لك خارقات عوائد لن تعرفا","https://www.aldiwan.net/poem58902.html","الكامل"],[215,"يا قلب هذا نعيم","https://www.aldiwan.net/poem46564.html","المجتث"],[234,"وروضة أنف جاد الغمام لها","https://www.aldiwan.net/poem50943.html","البسيط"],[285,"ألم تك للملوك الغر تاجا","https://www.aldiwan.net/poem60700.html","الوافر"],[369,"سترن المحاسن إلا العيونا","https://www.aldiwan.net/poem60632.html","المتقارب"],[371,"كان الفرنج لهم نون وقد حذفت","https://www.aldiwan.net/poem17203.html","البسيط"],[371,"ما العجب في خلق ذاك الخلق بالعجب","https://www.aldiwan.net/poem17312.html","البسيط"],[382,"كأن ألفاظ نمام ينم بنا","https://www.aldiwan.net/poem59403.html","البسيط"],[406,"يا قلب جدة","https://www.aldiwan.net/poem6704.html","عموديه"],[438,"لو أنها سمحت بطيف عائد","https://www.aldiwan.net/poem12592.html","الكامل"],[447,"ألا من لصب دائب المهجات","https://www.aldiwan.net/poem14439.html","الطويل"],[463,"من الغادي تحط به وتعلو","https://www.aldiwan.net/poem56250.html","الوافر"],[500,"أليلتنا بين العتابين والعذر","https://www.aldiwan.net/poem9855.html","الطويل"],[500,"لك الخير من طيف على النأي طارق","https://www.aldiwan.net/poem10249.html","الطويل"],[500,"سماء الدجى ما هذه الحدق النجل","https://www.aldiwan.net/poem10259.html","الطويل"],[495,"","https://poetry.dctabudhabi.ae/diwan/poem/17181","الكامل"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123399","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62536","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62514","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117395","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122074","الطويل"],[1497,"","https://poetry.dctabudhabi.ae/diwan/poem/202315","المتقارب"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127946","الوافر"],[1711,"","https://poetry.dctabudhabi.ae/diwan/poem/145768","الوافر"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69315","الطويل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46487","الوافر"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67908","المتقارب"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87718","البسيط"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93394","المتقارب"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216697","الطويل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86528","الوافر"],[3889,"","https://poetry.dctabudhabi.ae/diwan/poem/142941","الطويل"],[3893,"","https://poetry.dctabudhabi.ae/diwan/poem/114854","الطويل"],[3894,"","https://poetry.dctabudhabi.ae/diwan/poem/34994","الطويل"],[4217,"","https://poetry.dctabudhabi.ae/diwan/poem/123955","الوافر"],[4718,"يابدر شفت الزين وش قال عني","https://www.poetsgate.com/ViewPoem.aspx?id=137212",""],[4734,"فجر القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=50227",""],[4866,"خواطر ليل","https://www.poetsgate.com/ViewPoem.aspx?id=194768",""],[5050,"مقام في القصور على قصور","https://www.poetsgate.com/ViewPoem.aspx?id=38189",""],[5187,"قلب بين نارين","https://www.poetsgate.com/ViewPoem.aspx?id=29698",""],[5353,"بردة الأوجاع","https://www.poetsgate.com/ViewPoem.aspx?id=212465",""],[5516,"وجه السماء بيروت","https://www.poetsgate.com/ViewPoem.aspx?id=215422",""],[5638,"عندما بكى وبكيته الكتاب","https://www.poetsgate.com/ViewPoem.aspx?id=198127",""],[5652,"إغماءة فقد","https://www.poetsgate.com/ViewPoem.aspx?id=168822",""],[1920,"حجرٌ قلبُكْ","https://www.poetsgate.com/ViewPoem.aspx?id=191354",""],[5956,"حدثٌ أليم","https://www.poetsgate.com/ViewPoem.aspx?id=193104",""],[5956,"أنهكتَ أمك لست تأكل جيدا","https://www.poetsgate.com/ViewPoem.aspx?id=205428",""],[6045,"شباب الحلوة","https://www.poetsgate.com/ViewPoem.aspx?id=123996",""],[6075,"الأميرة والفتى العاشق","https://www.poetsgate.com/ViewPoem.aspx?id=213306",""],[6089,"إني أقمتُ جدارَ نسيانٍ على حبي","https://www.poetsgate.com/ViewPoem.aspx?id=214556",""],[6100,"اشتقت لأنفاسك","https://www.poetsgate.com/ViewPoem.aspx?id=52589",""],[6147,"شهوة سريالية.. ليلة سقوط بغداد..","https://www.poetsgate.com/ViewPoem.aspx?id=151487",""]],"verses":[["كَأَنَّ الفَتى مِنهُمُ في النِزالِ","يَرى أَكبَرَ الغُنمِ إِن قيلَ أَودى",0,"د",2,0],["كَأَنَّ الفَتى لَم يَغنَ في الناسِ ساعَةً","إِذا اِختَلَفَ اللَحيانِ عِندَ الجَريضِ",1,"ض",1,0],["كَأَنَّ الفِرِندَ الخُسرواِنيَّ لثُنَهُ","بِأعطَافِ أَنقاءِ العَقوقِ العَوانِكِ",2,"ك",1,0],["كَأَنَّ الفِرنِدَ المَحضَ مَعصوبَةٌ بِهِ","ذُرى قورِها يَنقَّدُ عَنها وَيُنصَحُ",3,"ح",1,0],["كان الفرات يُمدّ دجلةَ ماؤه","بجداول تُسقَى بها الجنات",4,"ت",1,0],["كانَ الفَرَزدَقُ إِذ يَعوذُ بِخالِهِ","مِثلَ الذَليلِ يَعوذُ تَحتَ القَرمَلِ",5,"ل",1,0],["كأنَّ ألفاظَ فخر الدِّين منه حوَتْ","مدامَ ساقٍ عليها سحر نفَّاذ",6,"ذ",1,0],["كأن ألفاظها في سمع حدسِها","كواكب الرجم يحرقن الشياطينا",7,"ن",2,0],["كانَ الفقير إذا أمرَ الزمان بغى","عليه قامَ إلى السلطانِ يُنهيه",8,"ي",2,0],["كأنَّ الفتى نصبَ الليالي بنيّةٌ","بمُصْطَفَقٍ من موج بحْر ومُلْتَطَمْ",9,"م",1,0],["كَأَنَّ الفَضاء وَفيهِ الطُيورُ","بُحورٌ بِها سُفُنٌ سابِحات",10,"ت",1,0],["كأنَّ الفَوارِسَ فيهِ ليوثٌ","تُراعي فَرائِسَها في عَرينِ",11,"ن",1,0],["كان الفنغراف يحكي الصوت منك لنا","قبلا فيا حبذا المحكى والحاكي",12,"ي",1,0],["كَأَنَّ الفَجرَ حِبٌّ مُستَزارٌ","يُراعي مِن دُجُنَّتِهِ رَقيبا",13,"ب",2,0],["كأنَّ الفواقِعَ قد فُصِّلَتْ","عليها جَلابيبُ لم تُزْرَرِ",14,"ر",1,0],["كانَ الفِداءُ لَهُ صُدورَ رِماحِنا","وَالخَيلَ إِذ رَهَجَ الغُبارُ مُثارُ",15,"ر",1,0],["كَأَنَّ الفُراتَ الجَونَ أَصبَحَ دارِئا","عَلَينا إِذا ما هَزهَزَتهُ شَمايِلُه",16,"ل",2,0],["كَأَنَّ الفُراتَ الجَونَ يَجري حُبابُهُ","مُفَجَّرَةً بَينَ البُيوتِ جَداوِلُه",17,"ل",2,0],["كأنَّ ألفاظَه لرِقَّتِها","وحُسنِها خمرُ طِيزَناباذِ",18,"ذ",1,0],["كَأَنَّ الفَتى المُغتَرَّ لَم يَدرِ أَنَّهُ","تَروحُ عَلَيهِ الحادِثاتُ وَتَبكُرُ",19,"ر",1,0],["كَأَنَّ الفَتى لَم يَغنَ في الناصِ ساعَةً","إِذا عُصِبَت يَوماً عَلَيهِ اللَفائِفُ",20,"ف",1,0],["كَأَنَّ الفَرقَدَينِ يَدا بَغيضٍ","أَلَحَّ عَلى إِفاضَتِهِ قَميري",21,"ر",2,0],["كَأَنَّ الفَرَزدَقَ في طَيرها","يُجيبُ عَلى كُلِّ شِعرٍ جَريرَه",22,"ر",2,0],["كانَ الفَصيحُ إِذا نَطَقتُ بِهِ","وَأَصاخَتِ الآذانُ لِلمُملي",23,"ل",2,0],["كَأَنَّ الفُؤادَ إِذا ما بَدا","بِإِشفى إِلى كَبِدي يَنتَظِم",24,"م",1,0],["كأن الفَتى لا بارك اللَه في الفَتى","قد اعتاض عن قلب له حجراً صلبا",25,"ب",2,0],["كأن الفجر حبٌّ مستزارٌ","يراعى في دجنته رقيبا",26,"ب",2,0],["كأن الفاتحين مِن الأوالي","على أسيافهم رفعوا خيامهْ",27,"م",2,0],["كأنّ الفتى شنّتْ عليه بلُبْسِها","يَداهُ ذَنُوباً ما اسْتَقَتْه المَوائح",28,"ح",1,0],["كَأَنَّ الفُراتَ التجَوْنَ يَجْري خبَابُهُ","مُفَجّرَةً بيْنَ البيُوتِ جَدَاوِلُهْ.",29,"ل",2,0],["كان الفؤاد براحة في راحة","للوصل بين معاقل وحصون",30,"ن",1,0],["كان الفتى ابن ابي غرارة راسه","بقرارة فافاق إذ برح الخفا",31,"ف",2,0],["كان الفؤاد استراح","من فاتكات الشجون",32,"ن",1,0],["كأنّ ألفاظَهم ما بينهم تحفٌ","غريبةُ الحسن أو أحلى من التحف",33,"ف",1,0],["كَأَنَّ الْفَوْزَ بِالآمالِ تُمْسِي","إِلَيْهِ النَّاجِياتُ بِهِ تُناجا",34,"ج",2,0],["كأنّ الفَتى عاش عُمْرَ الزَّمانِ","وعاشرَ أهليهِ مُسْتَجْمعينا",35,"ن",2,0],["كانَ الفَرَنجُ لَهُم نونٌ وَقَد حُذِفَت","وَجاءَنا فَرَجٌ ما كانَ يُذدَكَرُ",36,"ر",1,1],["كانَ الفِراقُ عَلى جَدِّ الأَسى لَعِباً","فَفَرَّقَ الشَيبُ بَينَ الجِدِّ وَاللَعِبِ",37,"ب",1,0],["كأن ألفاظَ نمامٍ ينمُّ بنا","شهدٌ تضمنه لدغُ الدبابير",38,"ر",1,1],["كان الفتى عند بابِ الدار تلفحهُ","من المواجعِ والآلامِ نارانِ",39,"ن",1,0],["كان الفتى غارقاً في بؤسِ حالتِه","كطائرٍ كُسرتْ منهُ الجناحانِ",39,"ن",1,0],["كان الفراقُ هو التلاقي فانظُروا","ضدّيْنِ قد جُمِعا بحالٍ واحدِ",40,"د",1,0],["كأن الفرات العذب كان وإنني","لذو نائل منه وذو لهوات",41,"ت",1,0],["كأنَّ الفضلَ في ناديه صَوناً","فتاةُ الحيّ تمنعها الرماحُ",42,"ح",1,0],["كأن الفلا صدري كأني وناقتي","خيال به تسري كأن الدجى فقري",43,"ر",2,0],["كأن الفلا في خندق من ظلامه","دجى والدجى من أُفقه في سرادق",44,"ق",1,0],["كأن الفلا نادٍ به الجن فتية","عليه الثرى فرش حشيته الرمل",45,"ل",1,0],["كانَ الفَخارُ يَمانِيّاً مُتَقَحطِناً","وَأَراهُ أَصبَح شامِيّاً مُتَنَزِّرا",46,"ر",2,0],["كأنَّ الفَلا طَيُّ الضمير وَخَطْوَها","مع الخَطْر خَطْرُ الوهمِ لا الوهمِ إذ يَخْطُو",47,"ط",2,0],["كأنَّ الفرسخي كريم قوم","بسيط الراحتين بفيض رغسِ",48,"س",1,0],["كأنَّ الفجر ألبسهَا كِسَاهُ","ووسط جبينها العيُّوقُ حَلاّ",49,"ل",2,0],["كان الفتى لم يحظ فيها بطائل","ولم يك في دنياه قط ينعم",50,"م",1,0],["كأنَّ الفيافي أقسمت لا تدلهُ","على عينِ ماءٍ أو ترى مثلَ صاحبِ",51,"ب",1,0],["كَأَنَّ الفَلاَ وَالبِيدَ مُنْذُ حَوَتْهُمُ","قُلُوبٌ حَوَتْ أَسْرَارَ حُبٍّ وَعِرْفَانِ",52,"ن",1,0],["كأن الفتى لم يعش ليلة","إذا صار رمساً على صوأر",53,"ر",1,0],["كأن الفجر فيه أصاب بردا","فصار له ببرديه اتشاح",54,"ح",1,0],["كأن الفجر أذنب وهو سار","وعوقب فهو مسجون يزاح",54,"ح",1,0],["كأن الفرقدين ذوا عتابٍ","أجلا طول ليلهما العتابا",55,"ب",2,0],["كَأَنَّ الفَتى يَرقى مِنَ العُمرِ سُلَّماً","إِلى أَن يَجُوزُ الأَربَعينَ فَيَنحَطُّ",56,"ط",1,0],["كَأَن الفَرقدين إِذا اِستكنا","حَبيبان اِستكانا للغرام",57,"م",1,0],["كأنَّ الفِجاجَ على سالكي","هِ سُدَّت فليسَ لها مطلعُ",58,"ع",1,0],["كانَ الفَسوق لِهَذا العَهد مُنتَحِلاً","فَردَّه اليَومَ قَوم وَهُوَ مُبتَكَر",59,"ر",1,0],["كَأَنَّ الفَيافي في طُولِها","لَيالٍ عَلى عاشِقٍ قَد جُفي",60,"ف",2,0],["كأن الفضاء لم يرَ الشمس مرة","ولم يسر فيه بدره المتهلل",61,"ل",1,0],["كأن الفضل فيه على فتاءٍ","أنيق الزهر في الغصن الرطيب",62,"ب",1,0],["كأن الفلا ظئر لها الليل حجلة","تحن إليها من ركابي أطفال",63,"ل",1,0],["كأنّ الفتى لم يحي يوماً اذا جرى","على قبره هابي التراب وحاصِبُه",64,"ه",1,0],["كَأَنَّ الفَتى داوُد لَم يَكُ فيكُمُ","وَلَم نَرَهُ يَوماً مِنَ الصَومِ بالِيا",65,"ي",2,0],["كان الفجر يبدو في دجاه","رها بين ثبدث في مسوح",66,"ح",1,0],["كان الفر