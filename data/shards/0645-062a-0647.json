مل"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202556","الكامل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109288","الكامل"],[2397,"","https://poetry.dctabudhabi.ae/diwan/poem/96168","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93620","الكامل"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45652","الكامل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129858","الكامل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100921","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100346","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74237","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100804","الكامل"],[3127,"","https://poetry.dctabudhabi.ae/diwan/poem/29530","الكامل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68022","الكامل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112330","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74102","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62992","الكامل"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46019","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206168","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36725","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131261",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131288",""],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102927","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103028","الكامل"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29319","السريع"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40147","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54432","الكامل"],[4246,"","https://poetry.dctabudhabi.ae/diwan/poem/103260","الكامل"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147276","الكامل"],[5168,"عسنك بالجبيره","https://www.poetsgate.com/ViewPoem.aspx?id=33603",""],[5277,"قبضةٌ من أثرِ الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=210888",""],[5582,"دَعْهُ يَحِنُّ لِشَجْوِهِ وَشُجُونِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63583",""],[402,"جمع الصحاب على هوى وإخاء","https://www.poetsgate.com/ViewPoem.aspx?id=35008",""],[5908,"أسفر الحي حين زارت نوار","https://www.poetsgate.com/ViewPoem.aspx?id=170973",""],[5956,"تشكيل مخي أنت يا أعشاب","https://www.poetsgate.com/ViewPoem.aspx?id=183308",""]],"verses":[["مُتَهَلَّلاً في كُلِّ نائِبَةٍ","تَضَعُ القُطوبَ مَواضِعَ البِشرِ",0,"ر",1,0],["مُتَهَلِّلُ الجَنَباتِ تَضحَكُ أَرضُهُ","فَكَأَنَّ بَينَ فُروجِهِ الجَوزاءَ",1,"ا",2,0],["مُتَهَلِّلٌ يَحمي حَقيقةَ عامِرٍ","بالسّيفِ عَضْباً والنَّوالِ جَسيما",2,"م",2,0],["متهللين لدى الهياج كأنما","خلقت وجوههم من الأقمار",3,"ر",1,0],["متهللون إذا النزيل عراهم","سفروا له عن أوجه الأقمارِ",4,"ر",1,0],["متهزِّجٌ بَهجاً بألفةِ شَملِه","هَزَجاً يخفُّ له الوقورُ المجلِس",5,"س",1,0],["متهلل زجل تحنُّ رواعدٌ","في حجرتيه وتستطير بروقُ",6,"ق",1,1],["مُتَهَيِّباً فَكَأَنَّني في هَيكَلٍ","وَكَأَنَّهُ سِفرٌ مِنَ الأَسفارِ",7,"ر",1,0],["مُتَهامِساتٍ ما نَظُنُّ فُلانَةً","أَحداً بِها أَولى مِنِ اِبنِ فُلانِ",8,"ن",1,0],["مُتَهَتِّكاً فَإِذا حَضَر","تُ تَظَلَّ في نُسكٍ وَوَعظِ",9,"ظ",1,0],["مُتَهَلِّلاً في الماءِ أَبدى نِصفَهُ","يَسمو بِها وَالنِصفُ كاسٍ عارِ",10,"ر",1,0],["مُتَهَجِّدٌ يُخفي الصَلاةَ وَقَد أَبى","إِخفاءَها أَثرَ السُجودِ البادي",11,"د",2,0],["مُتَهَلِّلٍ طَلقٍ إِذا وَعَدَ الغِنى","بِالبِشرِ أَتبَعَ بِشرَهُ بِالنائِلِ",12,"ل",1,0],["مُتَهَلِّلاً في الرَوعِ مُنهَلّاً إِذا","ما زَنَّدَ اللِحِزُ الشَحيحُ وَصَرَّدا",13,"د",2,0],["مُتَهادِياً مابَينَ أَبطَحِ شيمَةٍ","دَمُثَت وَهَضبَةِ عِزَّةٍ قَعساءِ",14,"ا",2,0],["مُتَهَلِّلٌ يَندى حَياءً وَجهَهُ","فَتراهُ بَينَ مُفَضَّضٍ وَمُذَهَّبِ",15,"ب",1,0],["مُتَهَلِّلٍ لِلطارِقينَ بَشاشَةً","أَو ضارِبٍ رَأسَ الكَمِيِّ المُعلَمِ",16,"م",1,0],["مُتَهَكِّمٌ بِالسِرِّ لَيسَ بِعَقلِهِ","رَتَقٌ إِذا غَفَلَ الرِجالُ تَنَكَّثا",17,"ث",2,0],["مُتَهَلِّلٌ والبَدْرُ فوْقَ جَبِينهِ","يَلقاكَ بِشْرُ سَماحِهِ من دُونِهِ",18,"ن",2,1],["مُتَهَلِّلٌ والعُرْفُ ما لم تجْلُهُ","بالبِشْرِ كالإبريزِ غيرَ مُخَلَّص",19,"ص",1,0],["مُتَهَلِّلاتٌ في العَبي","رِ وَفي الزَبَرجَدِ وَالفَرائِد",20,"د",1,0],["متهافتين عَلى موارد غيِّهم","كقطا ظماء عند حر هَجير",21,"ر",1,0],["مُتَهَجِّدٌ للهِ مُضْطَّلِعٌ عَلَى","وِقَرِ السِّنِينَ بِفَادِحِ الأَعْبَاءِ",22,"ا",2,0],["متهللٌ زجلٌ تحنّ رواعد","في حجزتيْه وتستطير بروقُ",23,"ق",1,1],["مُتَهَلِّلاً تَبدوا أَسِرَّةُ وَجهِهِ","مِثلَ الحُسامِ جَلَتهُ كَفُّ الصَيقَلِ",24,"ل",1,0],["متهلّلٌ للوفد يُحسَب أنه","بدرٌ أحاط بجانبيهِ الأنجُمُ",25,"م",1,0],["متهافتين على الصَّعيد كأنّهم","شِربوا بهيبتِهِ سُلافَ دِنانِ",26,"ن",1,0],["متهم في الدين من رايته","يبغي له خطا لديك يدرك",27,"ك",1,0],["مُتَهاوِناً بِالمَوتِ يَعلَمُ أَنَّهُ","سَيَمُوتُ بِالأَدواءِ مَن لَم يُقتَلِ",28,"ل",1,0],["متهلِّلٌ مهما تَهَلَّلَ شيبُهُ","كوميضِ برقٍ في غمام ممطر",29,"ر",1,0],["متهرِّدٌ صبغ الهوى لوني به","فأذاب جسمي في الهوى تذكاره",30,"ر",2,1],["متهادِيا بين البِقاعِ مُناجِيا","أَرجاءَها بالخِصب يَكتَنِفُ الثَرى",31,"ر",2,0],["مُتَهَضِّماً فَضلي الأَبِيُّ وَلَم يَكُن","لَولا الزَمانُ وَغَدرُهُ يَتَهَضَّمُ",32,"م",1,0],["مُتَهَجِّداً واَلَيلُ دا","جٍ صائِماً وَاليَومُ صائِف",33,"ف",1,0],["مت هماماً كما حييتَ هماماً","واحى في ذكرِكَ المجيدِ الرفيعِ",34,"ع",1,0],["مُتَهافِتاً مُتَرامِياً مُتَطارِحاً","مُتَواصِلاً مُتَوَسِّلاً مُتَحَرِّما",35,"م",2,0],["مُتَهادِياتِ الخَطوِ يَكسونَ البَرا","طيباً بِسَحبِ مَعاجِرٍ وَضَفائِرِ",36,"ر",1,0],["متهافتاً عن رحل كل مذلل","نشوان من أين ومس لغوب",37,"ب",1,0],["متهجداً ومجاهداً","والليل بالظلماء دامس",38,"س",1,0],["متهلّل للوافدين كأَنَّه","روضٌ سقاه الغيث من مدراره",39,"ر",2,0],["متهلّلٌ بجمال أبهج طلعةٍ","ممَّن تشير إلى علاهُ الإصبعُ",40,"ع",1,0],["متهللا ماء الحياة بوجهه","كالبدر أشرق في الدجنة يبسم",41,"م",1,0],["متهالكينَ على التظا","هُرِ وهو كالفجرِ الكذُوبِ",42,"ب",1,0],["متهللاً معنى الشباب رواوءه","وخلاله كحديثه المتفائل",43,"ل",1,0],["متهافتين على الرحال فناكسٌ","سئم الكَلالَ وناصبٌ لم يسأمِ",44,"م",1,0],["متهدِّلُ الأطرافِ يَمَسحُ بالثرى","مما تراكَمَ ذيلُهُ الجَرَّارُ",45,"ر",1,0],["متهلِّلاً أعدَى بخُضرة جودِه","جدبَ الرُّبَى من أرضها المغبَرَّةِ",46,"ه",1,0],["متهلّلٌ كالبدر صائك نشرهِ","كالمسكِ بين صلابةٍ ومداك",47,"ك",1,0],["مُتهدِّلاً فوقَ الخيامِ ربابُه","فكأنَّه قد شُدَّ بالأطنابِ",48,"ب",1,0],["مُتَهاجِرينَ عَلى الدَنّو كَأَنَّما","أَنفَت رُؤوسَهُم مِنَ الأَجسامِ",49,"م",1,0],["متهللاً بشراً ومنهلاً ندى","ألقى الكرامة عنده والجودا",50,"د",2,0],["متهلل أبداً فإن شهداء الوغى","شاهدت بعد اللين قسوة قسور",51,"ر",1,0],["متهجّمٍ إذْ لاتَ حين تهجّمٍ","واليومُ مُثْرٍ من قنىً ونصالِ",52,"ل",1,0],["متهجّمين ولاتَ حين تهجّمٍ","متسرّعين ولاتَ حين تسرُّعِ",53,"ع",1,0],["متهلِّلُ الْمَعْرُوف لاَ","جَهْماً نَدَاكَ ولاَ جَهامَا",54,"م",2,0],["مُتَهلِّلُ القَسَمَاتِ يُؤْذِنُ بِالرِّضَا","وَجْهُ الكَريمِ يبينُ عَنْ أَفْعَالِهِ",55,"ل",2,0],["متهتك في طبعه متستر","وكذا تكون شمائل الظرفاء",56,"ا",2,0],["متهالكين فإن تجاوز عنهم","جندُ النظام ترامت الأبدان",57,"ن",1,0],["مُتَهنِّئاً طولَ الزّمانِ بِراحةٍ","وَعَليك مِنّي الدّهرَ دامَ سَلامي",58,"م",2,0],["متهم بذوي الخنا متزمعٌ","متهازلٌ بذوي التقى متضاحك",59,"ك",1,0],["مُتهللُ في النازلات محلِّلٌ","للمشكلات مجلِّل أهلَ الهُدى",60,"د",2,0],["متهلل للنائبات محلل","للمشكلات مكشِّف لنوازلِ",61,"ل",1,0],["متهلل بالبشر مر","تاح لدى فيض النُّضارْ",62,"ر",1,0],["متهجما تشقى ببي","ض طباه هامات وسوقُ",63,"ق",1,0],["متهلل في سرجه","بحر وطود حجى وقور",64,"ر",1,0],["متهجما يلفى واز","رق رمحه بالطعن أحمر",64,"ر",1,0],["مُتَهَلِّلٌ طلقٌ إذَا وَعَدَ الغِنَى","بِالبِشْرِ أتْبَعَ بِرَّه الاحْسَانَا",65,"ن",2,0],["متَّ هل متَّ على درب المعالي","واثقاً بالحق في ركَب الرجال",66,"ل",1,1],["متَّ هل متَّ فداءَ الفن والفكر","والذوق وأغراض الجمال",66,"ل",1,0],["متهللا متملقا لوفوده","حتى تظن الوافد الموفودا",67,"د",2,0],["متهذّبٌ حبرٌ حزومٌ عالمٌ","سامي الحجى ندبٌ نبيهٌ فوقُ",68,"ق",1,0],["متهذّبٌ طابت مآثرهُ وقد","أعلى المهيمن في الورى مقدارَهْ",69,"ر",2,0],["مُتَهَدِّفينَ لِكُلِّ رامٍ بِالأَذى","يَرمِيكُمُ كَتَهَدُّفِ الحِيطانِ",70,"ن",1,0],["متهادياً أما على وشي الربى","أو لا فتحت كواعب الأعناب",71,"ب",1,0],["متهلّل صَلْت الجبين كأنّهُ","صدر الحسام المنتضَى وغِرارُهُ",72,"ر",2,0],["متهجدا تتلو الكتا","ب ويسألون المولى مقدير",73,"ر",1,0],["متهجداً لله ودَّت","لثمَ مسجده النجوم",74,"م",1,0],["مُتَهَدٍّ إلى الحُلُومِ بِلَحْظٍ","رُبّما كانَ ضَلّةً لِلْحُلُوم",75,"م",1,0],["متهنساً بين الرياض كما حبا","ليث العرين دجا عليه الغيل",76,"ل",1,0],["متهلل الإشراق ينهلّ الندى","من سحب راحته وفيض بنانه",77,"ن",2,0],["متهافت دوماً على حب الظبا","مثل الفراش على اللهيب المضرم",78,"م",1,0],["متهال بنعم بلا متباعد","سيان منه الوفر والعدم",79,"م",1,0],["متهلل بجمال يُوسف تاجَها","وَمُقبل قَدم النَبي سَريرها",80,"ر",3,0],["مُتهادِلات النور في آفاقِها","مُستَعبِرات في الدُجى تَستَرجع",81,"ع",1,0],["متهتّكون لدى المنى","وفسادهُم فيها صلاحُ",82,"ح",1,0],["متهيّبينَ جلالَ أبلجَ لم يزل","مستشفعاً بضيائِه الإِظلام",83,"م",1,0],["متهلِّلا يفترّ عن","خلق تضمخ بالخلوق",84,"ق",1,0],["متهيئاً للمكرمات فَإِن وَنَت","يَوماً يُحركها بحسن فعاله",85,"ل",2,0],["متها الكواكب طلع","آنا وآنا غوّر",86,"ر",1,0],["مُتَهَجِّماتٌ بِالفَروقِ وَثَبرَةٍ","حينَ اِرتَبَأتُ كَأَنَّهُنَّ سُيوفُ",87,"ف",1,0],["مُتهلِّل يَعْلوه سيفُ مَهابةٍ","فإذا بدَا بَداك وجهٌ أَطْلَق",88,"ق",1,0],["مُتهافِتِينَ على المُدا","مَةِ والهموم بمعزلِ",89,"ل",1,0],["متهلّلاً نَلقاكَ إِن","وَجه الخطوب تجهّما",90,"م",2,0],["مُتهلِلاً للزائري","نَ مرحباً بالمستَزَارِ",91,"ر",1,0],["مُتَهَدِّلاتٌ في السّحابِ كَأَنَّها","لِلزّاهِراتِ خَلاخِلٌ وَعُقودُ",92,"د",1,0],["متهللين غداة أطفأ شوقهم","نيلٌ أتوه وهم إليه ظماءُ",93,"ا",2,0],["مُتَهافتينَ عَلى الرِحال كَفِتيَةٍ","خَرّوا سُجوداً بَعدَ طُولِ قيامِ",94,"م",1,0],["متهاديات في شفوفٍ تحتها","تخفى الغضاضة تارةً وتبين",95,"ن",1,0],["متهافتين على القبيح يهزهم","شوقٌ إلى الإسفاف واستهتار",96,"ر",1,0],["متهلل بالمكرمات كأنما","غذيت نمير لبانه الوطفاء",97,"ا",2,0],["متهلل بالمكرمات كأنما","سطر من الأنوار فوق جبينه",98,"ن",2,0],["مُتَهَلِّلاً مُتَبَسِّماً طَلِقا","يَطَأُ النُجومَ وَرائِقَ الغَرسِ",99,"س",1,0],["مُتَهلِّلٌ وَالمَوتُ في نَبراتِهِ","يُرجى وَيُرهَبُ خَوفُهُ وَعِقابُهُ",100,"ب",2,0],["مُتهجِّداً لعبادةٍ أَو تالياً","من آيةٍ أَو ناظراً في مصحفِ",101,"ف",1,0],["متهللون فما تني خطواتهم","متدافعون جموعهم لا تنضب",102,"ب",1,0],["متهالك في قبضة الأيام","أضنى بالنزول",103,"ل",1,0],["متهني بحياتك عايش افراح","واتجوي بعذابك كلب إنسان",104,"ن",1,0],["متهالكٌ قصرُ المحبةِ ريثما","يبنيهِ صدقٌ لا يُباعُ ويُشترى",105,"ر",2,0],["مُتَهاجِرَ الأَجْفانِ مُدَّةَ لَيْلِهِ","واهِي القُوَى وَالصَّبْرُ غَيْرُ مَتِينِهِ",106,"ن",2,0],["متهجد في قسماته والحق في","كلماته والطهر في الحوباء",107,"ا",2,0],["متهم في هوى نوار إذا ما","أنجدوا في هواهم أو أغاروا",108,"ر",3,0],["متهرِّئٌ أنا كالتلال وأدمعي","بحرٌ يسافر فوقه الأحبابُ",109,"ب",1,0]]}