{"poems":[[53,"أوما رأيت وقائع الدهر","https://www.aldiwan.net/poem30444.html","الكامل"],[53,"أي العيون تجانب الأقذاء","https://www.aldiwan.net/poem30780.html","الكامل"],[63,"جهد الصبابة أن أكون ملوما","https://www.aldiwan.net/poem46195.html","الكامل"],[82,"وكتيبة بالدارعين كثيفة","https://www.aldiwan.net/poem29400.html","الكامل"],[83,"هي نفحة هبت من الأنصار","https://www.aldiwan.net/poem54284.html","الكامل"],[51,"يدعو الحمام بها الهديل تأسيا","https://www.aldiwan.net/poem64677.html","الطويل"],[51,"متهلل زجل تحن رواعد","https://www.aldiwan.net/poem65503.html","الكامل"],[91,"أبصرتها والشمس عند شروقها","https://www.aldiwan.net/poem8848.html","عموديه"],[91,"إني امرؤ لا شيء يطرب روحه","https://www.aldiwan.net/poem62762.html","عموديه"],[70,"ما لي أراك أضعتني","https://www.aldiwan.net/poem42836.html","مجزوء الكامل"],[85,"ملك السماء بهرت في الأنوار","https://www.aldiwan.net/poem63717.html","الكامل"],[45,"حقا أقول لقد تبلت فؤادي","https://www.aldiwan.net/poem63504.html","الكامل"],[45,"لو كان يعتب هاجر في واصل","https://www.aldiwan.net/poem65544.html","الكامل"],[44,"يا دار دار عليك إرهام الندى","https://www.aldiwan.net/poem30539.html","الكامل"],[74,"يانشر عرف الروضة الغناء","https://www.aldiwan.net/poem12828.html","الكامل"],[74,"ومعين ماء البشر أبرق هشة","https://www.aldiwan.net/poem12839.html","الكامل"],[74,"يممت من علياك خير ميمم","https://www.aldiwan.net/poem13254.html","الكامل"],[52,"سار الرفيق لقصده وتلبثا","https://www.aldiwan.net/poem27183.html","الكامل"],[75,"متهلل والبدر فوق جبينه","https://www.aldiwan.net/poem69030.html","الكامل"],[75,"أحبب به قنصا إلى متقنص","https://www.aldiwan.net/poem69068.html","الكامل"],[50,"يا دار أقوت بالأجالد","https://www.aldiwan.net/poem63942.html","مجزوء الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85456","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54524","الكامل"],[51,"متهللٌ زجلٌ تحنّ رواعد","https://www.poetsgate.com/ViewPoem.aspx?id=25509",""],[129,"ما إن رأيت ولا سمعت بمثله","https://www.aldiwan.net/poem23998.html","الكامل"],[140,"ما ضاع من أيامنا هل يغرم","https://www.aldiwan.net/poem58446.html","الكامل"],[140,"لو كنت أشفق من خضيب بنان","https://www.aldiwan.net/poem58451.html","الكامل"],[158,"الدين دين ربنا والملك","https://www.aldiwan.net/poem59186.html","الرجز"],[167,"بالسيف يفتح كل باب مقفل","https://www.aldiwan.net/poem1657.html",""],[196,"أهزز معاطف رائح ومبكر","https://www.aldiwan.net/poem51948.html","الطويل"],[202,"متهرد صبغ الهوى لوني به","https://www.aldiwan.net/poem53315.html","الكامل"],[223,"اليوم آن لشاكر أن يجهرا","https://www.aldiwan.net/poem55197.html","الكامل"],[233,"لو أن قلبك مثل قلبي مغرم","https://www.aldiwan.net/poem31768.html","الكامل"],[233,"وأغن معسول المراشف","https://www.aldiwan.net/poem31819.html","مجزوء الكامل"],[239,"إن أسماء في الورى خير أنثى","https://www.aldiwan.net/poem45753.html","الخفيف"],[273,"لمبشري برضاك أن يتحكما","https://www.aldiwan.net/poem25527.html","الكامل"],[280,"صيدت ضراغم حاجر بمحاجر","https://www.aldiwan.net/poem32744.html","الكامل"],[308,"أسرفن في هجري وفي تعذيبي","https://www.aldiwan.net/poem59519.html","الكامل"],[374,"قلب يقلبه النوى","https://www.aldiwan.net/poem59383.html","مجزوء الكامل"],[413,"جاء الربيع بورده وبهاره","https://www.aldiwan.net/poem54045.html","الكامل"],[413,"قلب يذوب ومهجة تتقطع","https://www.aldiwan.net/poem54185.html","الكامل"],[438,"الرزء من قلقي أجل وأعظم","https://www.aldiwan.net/poem14482.html","الكامل"],[451,"أين ابتسامك يا حبيبي","https://www.aldiwan.net/poem61716.html","مجزوء الكامل"],[451,"رف الربيع على الشتاء الماحل","https://www.aldiwan.net/poem61771.html","الكامل"],[456,"ما المجد إلا بالعزيمة فاعزِمِ","https://www.aldiwan.net/poem55904.html","الكامل"],[456,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[456,"ما أنكرت إلا البياض فصدتِ","https://www.aldiwan.net/poem56266.html","الكامل"],[462,"ما كنت بالباكي ولا المتباكي","https://www.aldiwan.net/poem3512.html","عموديه"],[475,"عهد الصبا ومعاهد الأحباب","https://www.aldiwan.net/poem15221.html","الكامل"],[491,"عدل الصوارم أعدل الأحكام","https://www.aldiwan.net/poem67321.html","الكامل"],[513,"ردا أحاديث المنى وأعيدا","https://www.aldiwan.net/poem12092.html","الكامل"],[513,"يا دار عليك سعد المشتري","https://www.aldiwan.net/poem12135.html","الكامل"],[549,"من ذا الذي ينجو من الآجال","https://www.aldiwan.net/poem47273.html","الكامل"],[549,"من أين زرت خيال ذات البرقع","https://www.aldiwan.net/poem47707.html","الكامل"],[573,"حاشا لمجدك أن يضاما","https://www.aldiwan.net/poem3008.html","مجزوء الكامل"],[584,"لو رمت إبقاء الوداد بحاله","https://www.aldiwan.net/poem17687.html","الكامل"]],"verses":[["مُتَهَلَّلاً في كُلِّ نائِبَةٍ","تَضَعُ القُطوبَ مَواضِعَ البِشرِ",0,"ر",1,0],["مُتَهَلِّلُ الجَنَباتِ تَضحَكُ أَرضُهُ","فَكَأَنَّ بَينَ فُروجِهِ الجَوزاءَ",1,"ا",2,0],["مُتَهَلِّلٌ يَحمي حَقيقةَ عامِرٍ","بالسّيفِ عَضْباً والنَّوالِ جَسيما",2,"م",2,0],["متهللين لدى الهياج كأنما","خلقت وجوههم من الأقمار",3,"ر",1,0],["متهللون إذا النزيل عراهم","سفروا له عن أوجه الأقمارِ",4,"ر",1,0],["متهزِّجٌ بَهجاً بألفةِ شَملِه","هَزَجاً يخفُّ له الوقورُ المجلِس",5,"س",1,0],["متهلل زجل تحنُّ رواعدٌ","في حجرتيه وتستطير بروقُ",6,"ق",1,1],["مُتَهَيِّباً فَكَأَنَّني في هَيكَلٍ","وَكَأَنَّهُ سِفرٌ مِنَ الأَسفارِ",7,"ر",1,0],["مُتَهامِساتٍ ما نَظُنُّ فُلانَةً","أَحداً بِها أَولى مِنِ اِبنِ فُلانِ",8,"ن",1,0],["مُتَهَتِّكاً فَإِذا حَضَر","تُ تَظَلَّ في نُسكٍ وَوَعظِ",9,"ظ",1,0],["مُتَهَلِّلاً في الماءِ أَبدى نِصفَهُ","يَسمو بِها وَالنِصفُ كاسٍ عارِ",10,"ر",1,0],["مُتَهَجِّدٌ يُخفي الصَلاةَ وَقَد أَبى","إِخفاءَها أَثرَ السُجودِ البادي",11,"د",2,0],["مُتَهَلِّلٍ طَلقٍ إِذا وَعَدَ الغِنى","بِالبِشرِ أَتبَعَ بِشرَهُ بِالنائِلِ",12,"ل",1,0],["مُتَهَلِّلاً في الرَوعِ مُنهَلّاً إِذا","ما زَنَّدَ اللِحِزُ الشَحيحُ وَصَرَّدا",13,"د",2,0],["مُتَهادِياً مابَينَ أَبطَحِ شيمَةٍ","دَمُثَت وَهَضبَةِ عِزَّةٍ قَعساءِ",14,"ا",2,0],["مُتَهَلِّلٌ يَندى حَياءً وَجهَهُ","فَتراهُ بَينَ مُفَضَّضٍ وَمُذَهَّبِ",15,"ب",1,0],["مُتَهَلِّلٍ لِلطارِقينَ بَشاشَةً","أَو ضارِبٍ رَأسَ الكَمِيِّ المُعلَمِ",16,"م",1,0],["مُتَهَكِّمٌ بِالسِرِّ لَيسَ بِعَقلِهِ","رَتَقٌ إِذا غَفَلَ الرِجالُ تَنَكَّثا",17,"ث",2,0],["مُتَهَلِّلٌ والبَدْرُ فوْقَ جَبِينهِ","يَلقاكَ بِشْرُ سَماحِهِ من دُونِهِ",18,"ن",2,1],["مُتَهَلِّلٌ والعُرْفُ ما لم تجْلُهُ","بالبِشْرِ كالإبريزِ غيرَ مُخَلَّص",19,"ص",1,0],["مُتَهَلِّلاتٌ في العَبي","رِ وَفي الزَبَرجَدِ وَالفَرائِد",20,"د",1,0],["متهافتين عَلى موارد غيِّهم","كقطا ظماء عند حر هَجير",21,"ر",1,0],["مُتَهَجِّدٌ للهِ مُضْطَّلِعٌ عَلَى","وِقَرِ السِّنِينَ بِفَادِحِ الأَعْبَاءِ",22,"ا",2,0],["متهللٌ زجلٌ تحنّ رواعد","في حجزتيْه وتستطير بروقُ",23,"ق",1,1],["مُتَهَلِّلاً تَبدوا أَسِرَّةُ وَجهِهِ","مِثلَ الحُسامِ جَلَتهُ كَفُّ الصَيقَلِ",24,"ل",1,0],["متهلّلٌ للوفد يُحسَب أنه","بدرٌ أحاط بجانبيهِ الأنجُمُ",25,"م",1,0],["متهافتين على الصَّعيد كأنّهم","شِربوا بهيبتِهِ سُلافَ دِنانِ",26,"ن",1,0],["متهم في الدين من رايته","يبغي له خطا لديك يدرك",27,"ك",1,0],["مُتَهاوِناً بِالمَوتِ يَعلَمُ أَنَّهُ","سَيَمُوتُ بِالأَدواءِ مَن لَم يُقتَلِ",28,"ل",1,0],["متهلِّلٌ مهما تَهَلَّلَ شيبُهُ","كوميضِ برقٍ في غمام ممطر",29,"ر",1,0],["متهرِّدٌ صبغ الهوى لوني به","فأذاب جسمي في الهوى تذكاره",30,"ر",2,1],["متهادِيا بين البِقاعِ مُناجِيا","أَرجاءَها بالخِصب يَكتَنِفُ الثَرى",31,"ر",2,0],["مُتَهَضِّماً فَضلي الأَبِيُّ وَلَم يَكُن","لَولا الزَمانُ وَغَدرُهُ يَتَهَضَّمُ",32,"م",1,0],["مُتَهَجِّداً واَلَيلُ دا","جٍ صائِماً وَاليَومُ صائِف",33,"ف",1,0],["مت هماماً كما حييتَ هماماً","واحى في ذكرِكَ المجيدِ الرفيعِ",34,"ع",1,0],["مُتَهافِتاً مُتَرامِياً مُتَطارِحاً","مُتَواصِلاً مُتَوَسِّلاً مُتَحَرِّما",35,"م",2,0],["مُتَهادِياتِ الخَطوِ يَكسونَ البَرا","طيباً بِسَحبِ مَعاجِرٍ وَضَفائِرِ",36,"ر",1,0],["متهافتاً عن رحل كل مذلل","نشوان من أين ومس لغوب",37,"ب",1,0],["متهجداً ومجاهداً","والليل بالظلماء دامس",38,"س",1,0],["متهلّل للوافدين كأَنَّه","روضٌ سقاه الغيث من مدراره",39,"ر",2,0],["متهلّلٌ بجمال أبهج طلعةٍ","ممَّن تشير إلى علاهُ الإصبعُ",40,"ع",1,0],["متهللا ماء الحياة بوجهه","كالبدر أشرق في الدجنة يبسم",41,"م",1,0],["متهالكينَ على التظا","هُرِ وهو كالفجرِ الكذُوبِ",42,"ب",1,0],["متهللاً معنى الشباب رواوءه","وخلاله كحديثه المتفائل",43,"ل",1,0],["متهافتين على الرحال فناكسٌ","سئم الكَلالَ وناصبٌ لم يسأمِ",44,"م",1,0],["متهدِّلُ الأطرافِ يَمَسحُ بالثرى","مما تراكَمَ ذيلُهُ الجَرَّارُ",45,"ر",1,0],["متهلِّلاً أعدَى بخُضرة جودِه","جدبَ الرُّبَى من أرضها المغبَرَّةِ",46,"ه",1,0],["متهلّلٌ كالبدر صائك نشرهِ","كالمسكِ بين صلابةٍ ومداك",47,"ك",1,0],["مُتهدِّلاً فوقَ الخيامِ ربابُه","فكأنَّه قد شُدَّ بالأطنابِ",48,"ب",1,0],["مُتَهاجِرينَ عَلى الدَنّو كَأَنَّما","أَنفَت رُؤوسَهُم مِنَ الأَجسامِ",49,"م",1,0],["متهللاً بشراً ومنهلاً ندى","ألقى الكرامة عنده والجودا",50,"د",2,0],["متهلل أبداً فإن شهداء الوغى","شاهدت بعد اللين قسوة قسور",51,"ر",1,0],["متهجّمٍ إذْ لاتَ حين تهجّمٍ","واليومُ مُثْرٍ من قنىً ونصالِ",52,"ل",1,0],["متهجّمين ولاتَ حين تهجّمٍ","متسرّعين ولاتَ حين تسرُّعِ",53,"ع",1,0],["متهلِّلُ الْمَعْرُوف لاَ","جَهْماً نَدَاكَ ولاَ جَهامَا",54,"م",2,0],["مُتَهلِّلُ القَسَمَاتِ يُؤْذِنُ بِالرِّضَا","وَجْهُ الكَريمِ يبينُ عَنْ أَفْعَالِهِ",55,"ل",2,0]]}