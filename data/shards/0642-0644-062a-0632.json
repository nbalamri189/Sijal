{"poems":[[95,"زارني صبحاً وحيى","https://www.aldiwan.net/poem11100.html","مجزوء الرمل"],[74,"قال لي إذا رأى انكساري حبيبي","https://www.aldiwan.net/poem18672.html","الخفيف"],[53,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[121,"أرشف ثغرًا","https://www.aldiwan.net/poem24055.html","الرمل"],[366,"لست أهوى الارقيق الطباع","https://www.aldiwan.net/poem68091.html","الخفيف"],[457,"ونديم طارحته بعض ما بي","https://www.aldiwan.net/poem13635.html","الخفيف"],[1110,"","https://poetry.dctabudhabi.ae/diwan/poem/126611","الرمل"],[1605,"","https://poetry.dctabudhabi.ae/diwan/poem/143637","الخفيف"],[1843,"","https://poetry.dctabudhabi.ae/diwan/poem/130231","الخفيف"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118827","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81234","الخفيف"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119538","الخفيف"],[4935,"زفاف نعمت إلى الرضا منى","https://www.poetsgate.com/ViewPoem.aspx?id=129469",""]],"verses":[["قلْت زَادَ اللهُ مَنْ تَع","نِيهِ عِزاً وَرُقِيَّا",0,"ي",2,0],["قلت زادوا رفاق شغلي دوني","قال أخشى عليك من ذي الزياده",1,"ه",1,0],["قَلَتْ زُخْرفَ الدنيا فلم يكُ قصدَها","بُرودٌ تُوشَّى أو رِياطٌ تُسَهَّمُ",2,"م",1,0],["قُلْتُ: زِيدني عِتابًا هَزِّئِي","كلَّ إحساسي ولا أرجوكِ عُذْرا",3,"ر",2,0],["قُلت زرني فَما أَحيلاه لما","أَن أَهاجَت أَلحاظه أَطماعي",4,"ع",2,0],["قلت زدني قال النديم المواتي","قلت لم قال مؤنس الأحباب",5,"ب",1,0],["قلت زادي شربة مثلوجة","من ثناياك فقد مس الظما",6,"م",2,0],["قلت: زوري. فأرسلت","أنا آتيك سحره",7,"ر",2,1],["قلت زرها وآت أم عديٍ","ترتدي ليلةً إلينا الظلاما",8,"م",2,0],["قلت زرني حتى أرى طيف قلبي","قال حاشاك ترتضي بالخيالِ",9,"ل",1,0],["قُلت زِدني فَقالَ يَسمَع ما في ال","أَرض مِن هَمسة وَمِن إِيماء",10,"ا",2,0],["قُلت زِدني فَقالَ يَعلَم كَم عِن","د نَديف مصعد مِن هَباء",10,"ا",2,0],["قُلت زِدني فَقالَ أَجهل إِلّا","صُوَراً أَو غَلَت علا في الخَفاء",10,"ا",2,0],["قلت زوري فاسبلت","أنا آتيك سحره",11,"ر",2,1],["قلت زمان الأنس بالبشر وفي","وعوده والخير منه عمنا",12,"ن",2,0]]}