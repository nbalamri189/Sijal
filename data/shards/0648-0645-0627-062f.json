"],[442,"قد خان سمعي وعيني خانها بصري","https://www.aldiwan.net/poem14370.html","البسيط"],[459,"عذيرك من حلمك المهتضم","https://www.aldiwan.net/poem55892.html","المتقارب"],[459,"لمن طل بلِوى عاقِلِ","https://www.aldiwan.net/poem55998.html","المتقارب"],[459,"كذا تنقضي الأيام حالا على حال","https://www.aldiwan.net/poem56070.html","الطويل"],[459,"أخي في الود أخي النسيبِ","https://www.aldiwan.net/poem56304.html","الوافر"],[462,"زار الخيال بخيلا مثل مرسله","https://www.aldiwan.net/poem15326.html","البسيط"],[462,"أقول وقد طاب النسيم بمدرجي","https://www.aldiwan.net/poem15372.html","الطويل"],[462,"تعاظم حزني والرزية أعظم","https://www.aldiwan.net/poem15905.html","الطويل"],[465,"عيون المهى قلبي بنبلك مجروح","https://www.aldiwan.net/poem3149.html","عموديه"],[465,"لقد سل سيفا والغدار الحمائل","https://www.aldiwan.net/poem3189.html","عموديه"],[465,"بقبرك فلتسحب ذيول السحائب","https://www.aldiwan.net/poem3210.html","عموديه"],[465,"ليهن الورى برء العلى والفضائل","https://www.aldiwan.net/poem3265.html","عموديه"],[465,"أشاقك برق بالشآم يشام","https://www.aldiwan.net/poem3487.html","عموديه"],[465,"تعجبت من نحولي وهي واصلة","https://www.aldiwan.net/poem3570.html","عموديه"],[466,"في رحاب الحسين","https://www.aldiwan.net/poem59034.html","عموديه"],[483,"سلام عليكم ما أمر فراقكم","https://www.aldiwan.net/poem24433.html","عموديه"],[483,"كم كنت في غمرات الحب أستبق","https://www.aldiwan.net/poem24456.html","عموديه"],[496,"سقى الله نجدا كلما ذكروا نجدا","https://www.aldiwan.net/poem9820.html","الطويل"],[501,"هنيئا لعبد طيب الحب قلبه","https://www.aldiwan.net/poem37822.html","الطويل"],[515,"مضى خلف الأبرار والسيد الطهر","https://www.aldiwan.net/poem20839.html","الطويل"],[516,"خادم ذيل المجلس العادلي","https://www.aldiwan.net/poem12197.html","السريع"],[516,"قدك مثل الغصن في اعتداله","https://www.aldiwan.net/poem12217.html","الرجز"],[516,"ثغر الزمان بنجم الدين مبتسم","https://www.aldiwan.net/poem12263.html","البسيط"],[535,"إلى الأمير فدته النفس أهديها","https://www.aldiwan.net/poem23814.html","البسيط"],[539,"مللت الكتابة دهرا طويلا","https://www.aldiwan.net/poem48204.html","عموديه"],[552,"قد زرت ليلة هومنا على العيس","https://www.aldiwan.net/poem47744.html","البسيط"],[568,"وجارية تستميل القلوب","https://www.aldiwan.net/poem69777.html","المتقارب"],[576,"عز إله العالم","https://www.aldiwan.net/poem2756.html","مجزوء الرجز"],[576,"أيا دار في جنات عدن له دار","https://www.aldiwan.net/poem2783.html","الطويل"],[576,"لا تجر دمعا على سعاد","https://www.aldiwan.net/poem2818.html","مخلع البسيط"],[576,"أحدث عنكم أن بعدكم دنا","https://www.aldiwan.net/poem2999.html","الطويل"]],"verses":[["وما دام عنه الدين حسّن بدعةً","فلم بإجتهادي ركنه قد تهدما",0,"م",2,0],["وما درت أنَّ هَمَّ الحرِّ تَعذِرَةٌ","إذا أرادَ صلاحًا ثُمَّ ما وَجَدا",1,"د",2,0],["وَما دَرَتْ أَنَّ في أَثْنائِها رَجُلاً","تُرْخَى على الأَسدِ الضّارِي غَدائِرُهُ",2,"ر",2,0],["وَمَا دَرَى أَنَّ سُعُودَ الْهَوَى","لِفَاضِلٍ زَوْجَتُهُ فَاضِلَهْ",3,"ل",2,0],["ومأدْبَةٍ بِالنُّيوبِ الحِدَادِ","غَزَوْنَا مَآكِلِهَا الطِّيِّبَهْ",4,"ه",1,1],["وَمَا دَامَ أَهْلُ البَيْتِ يَرْعَى شَبَابُهُمْ","شُيُوخَهُمُ فَالعِزُّ فِي البَيْتِ دَائِمُ",5,"م",1,0],["وما دعوة البابا لكم مستجابة","فقد أغضبت طغواكم غَيرة الرَبّ",6,"ب",1,0],["ومادة نسج الدمقس غطاؤها","بمجلس شبان هم أنجم العصر",7,"ر",1,0],["وما دعاه إلى استخفافه درَكٌ","لكن دعاه إليه الجهل والبطر",8,"ر",1,0],["وما درك الدهقان في قيل قائل","ألا ذاك خصاف النعال رقوعها",9,"ع",3,0],["وما دعَمَ الأقوامُ ظُلَّةَ نَعمةٍ","بمثلِ مُحقٍّ تحتها متظلّلِ",10,"ل",1,0],["وما دُبِغتْ بالمسك بل صُوفحت به","له قدمٌ في كلّ مجدٍ تَقدَّمُ",11,"م",1,0],["وما دعونا له وح","ده ولا لِفئامِ",12,"م",1,0],["ومادتْ لك الأجبال حتى كأنما","شواهقها كانت بِمحياك تُدَّعمْ",13,"م",1,0],["وَما دامَ في الدُنيا سُمُو وَرِفعَةٌ","فَما أَنا مَن يَرضى وَيَقنَعُ بِالأَردا",14,"د",2,0],["وما دون مصر في العراق لك الأسى","وإن دموع الشعر بعض الشواهد",15,"د",1,0],["وَما دانَ إِلّا بِشورى الأُمورِ","وَلا اِختالَ كِبراً وَلا اِستالَها",16,"ل",3,0],["وَما دَفعِيَ اللُوّامَ فيها سَآمَةٌ","وَلَكِنَّ نَفسَ الحُرِّ أَزجَرُ لِلحُرِّ",17,"ر",1,0],["وَما دامَ دِلَّيرٌ يَهُزُّ حُسامَهُ","فَلا نابَ في الدُنيا لِلَيثٍ وَلا شِبلِ",18,"ل",1,0],["وَما دامَ دِلَّيرٌ يُقَلِّبُ كَفَّهُ","فَلا خَلقَ مِن دَعوى المَكارِمِ في حِلِّ",18,"ل",1,0],["وَما دُوَلُ الأَيّامِ نُعماً وَأَبؤُساً","بِأَجرَحَ في الأَقوامِ مِنهُ وَلا أَسوا",19,"و",2,0],["وَما دُبرُ سُعدى وَأَخدانِها","بِأَكفاءِ كَهلِهِمِ المُحتَنِك",20,"ك",1,0],["وَما دَعوَةٌ تَدعو بِلالاً إِلى القِرى","وَلا الطَعنِ يَومَ الرَوعِ إِلّا يُجيبُها",21,"ب",3,0],["وَما دونَ كَفَّيكَ اِنتِهاءٌ لِراغِبٍ","وَلا لِمُناهُ مِن وَرائِكَ مَذهَبُ",22,"ب",1,0],["وَما دَعا لِلنَدى إِلّا أَجابَ نِدا","باغي النَوالِ إِذا ما ناحَ أَو نادى",23,"د",2,0],["ومادَتِ الأَرضُ من فُقدانِها جَبلاً","ينابِعُ الجودِ من سفحَيهِ تَنفَجِرُ",24,"ر",1,0],["وَما دَرَت أَنَّهُ وَاللَهِ لا عَجَبٌ","أَن يوجَدَ الدُرُّ مَقروناً مَعَ الصَدَفِ",25,"ف",1,0],["وما دَلَفَتْ إلاّ الهُمومُ وراءَهُ","وإنْ قال قومٌ إنّهُنّ حُشود",26,"د",1,0],["وَما دَرى الشَربُ أَو دَرَوا فَلَهَوا","عَن قَرَحِ القَلبِ قَد لَجَّ في دَنَفِه",27,"ف",2,0],["وَما دافَعوهُ رَغبَةً عَن سَقامِهِ","وَلَكِنَّ أَولادَ الزِناءِ خِلادُ",28,"د",1,0],["وَما دَرى المَيتُ أَأَكفانُهُ","مُخلِقَةٌ في رَمسِهِ أَم قُشُب",29,"ب",1,0],["وَما دَفَعَت حُكَماءُ الرِجالِ","حَتفاً بِحِكمَةِ بُقراطِها",30,"ط",3,0],["وَما دُنياكَ إِلّا دارُ سوءٍ","وَلَستَ عَلى إِساءَتِها مُقيما",31,"م",2,0],["وَما دانَ الفَتى بِحِجىً وَلَكِن","يُعَلِّمُهُ التَدَيُّنَ أَقرَبوهُ",32,"ب",3,0],["وَما دَفَعَت عَنِ الملِكِ المَنايا","مَقانِبُهُ وَلا مُتَكَتِّبوهُ",32,"ب",3,0],["وَما دونَها إِلّا ثَلاثٌ مَآوِبٌ","قُدِرنَ لِعيسٍ مُسنِفاتِ الحَوارِكِ",33,"ك",1,0],["وَما دون مصر مطلبٌ لميمم","ففيها ينال المجد من همه المجد",34,"د",1,0],["وَما دجلة عن قاصديها قصية","ولا ماؤها يوماً لشاربه ثمد",34,"د",1,0],["وَما دانَيتُ شَخصَ المَوتِ إِلّا","كَما يَدنو الشُجاعُ مِنَ الجَبانِ",35,"ن",1,0],["وما دَهري اطبَأَنَّكِ غيرَ أَنيِّ","بَنَى لي والدي بَيتاً يَفاعا",36,"ع",2,0],["وما دَهري بأن كُدِّرتُ فَضلاً","ولكن ما لَقيتُ مِنَ العَجِيبِ",37,"ب",1,0],["وَمَا دَعْوى اتِّحادٍ فِي بِلاَدٍ","وَمَا دَعْوَى ذِمَارٍ مُسْتَقِل",38,"ل",1,0],["وَمَا دَرَى أَنَّهُ لَوْ نَالَ مِدْفَعُهُ","أَرْسَى الْقِلاَعِ فَدُكَّتْ وَهْيَ تَتَّقِدُ",39,"د",1,0],["وَمَا دَهَى الْشَّرْقَ في ابْنَاهُ قَاطِبَةً","فأَصْبَحَ الرَّأْسُ مِنْ أَبْنَائِهِ ذَنَبَا",40,"ب",2,0],["وَما دَعاني إِلى ما سائَهُ سَخَطٌ","إِلّا ثَناني إِلى ماشاءَ إِشفاقُ",41,"ق",1,0],["وما دَرأَتْ عن تُبَّعٍ تُبَّعٌ له","صروفَ الرَّدَى الجاري على كلِّ قَسْوَرِ",42,"ر",1,0],["وَما دارِعٌ إِلّا كَآخَرَ حاسِرٍ","وَما مُقتِرٌ إِلّا كَآخَرَ ذي وَفرِ",43,"ر",1,0],["وَمَا دُوَلُ الأيّامِ، نُعْمَى وأبْؤساً،","بأجْرَحَ في الأقْوَامِ مِنه، وَلا أسوَا",44,"و",2,0],["وما دهتنا من الجبّار عادية","إلاّ جزينا على الطّغيان طغيانا",45,"ن",2,0],["وما دمت تبني ، وتهدي سواك","سيحكون ، منك إليك اهتديت",46,"ت",1,0],["وَما دارَهُ قَصدي وَلَكن لِأَجلِهِ","أَحنُّ فَلا أَلفي لَها غَير آلفِ",47,"ف",1,0],["وما درى إن صدقي في محبة من","أحببتهم وعلو النفس من شيمي",48,"م",2,0],["وما دعاك غريب لاذ فيك وقد","وافاك يا من زكت طبعاً خلائقه",49,"ق",2,0],["وما دَرَوْا أنك الملكُ الذي خضعَتْ","له مُلوكُ الورَى والبَدْوُ والحَضرُ",50,"ر",1,0],["وما درى أن بعض القوم مركبُه","متنَ الصَّبَا وهي العيرانةُ الأُجُد",51,"د",1,0],["وما درى أنيّ لمّا بدا","زدت غراماً فوق ذاك الغرام",52,"م",1,0],["وَما دونَهُ لِلطالِبي العُرفِ حاجِبٌ","إِذا ما أَتَوا مِن دونِ بابِكَ حُجّابا",53,"ب",2,0],["ومادحُ شرط الخدّ في السود صادقٌ","وأما بخد البيض فالقبح عمدتي",54,"ي",1,0],["وما دارنا إلا مناخ لراكب","يقيلُ به لكنّه يتنقُل",55,"ل",1,0],["وما در ديب إذ عصاه وسالم","فليس لأم قبل أمهما ثكل",56,"ل",1,0],["وَما دامَ لَيثُ الغابِ في الغابِ كامِناً","فَإِنَّ حَراماً أَن تُدَمّى مَخالِبُهْ",57,"ب",2,0],["وما دَرَوا أَنَّ فَضلَ الجُودِ يُكذِبُهُم","عَمّا قَليلٍ بِما في زَعمِهِم زَعَمُوا",58,"م",3,0],["وَما دِماؤُكُم أَغلى إِذا سُفِكتْ","مِن ماء وَجهِ لَهُم في الفُحشِ يَنسَكِبُ",59,"ب",1,0],["وما دُعيتَ بشاهِنْشَاهَ فاعترفتْ","به الملوكُ على جهلٍ ولا غِرَرِ",60,"ر",1,0],["وما دام عَتْبُك إلا وأنت","تُفدِّر أن فؤادي معي",61,"ع",2,0],["وماد الخَيزُرانُ به تَناهَى","إلى صفة تَجِلّ عن المِثال",62,"ل",1,0],["وما دامَ شعرُ القومِ أمسى كما ترى","شعيراً فقل إن الزمانَ بهيم",63,"م",1,0],["وما دامتِ الأفلاكُ في دورانها","ففيهنَّ من بعدِ الأمورِ أمورُ",64,"ر",1,0],["وما دمعتي تلك التي قد تحدَّرت","ولكنَّها وَدقٌ غدت تتحدَّرُ",65,"ر",1,0],["وما دها المجد يتم بعد والده","وكيف يبقى يتيماً وهو كافله",66,"ل",2,0],["وما دار كأس الأنس من قدس حضرةٍ","بمسك شذا ختم الجلالة بالحمد",67,"د",1,0],["وما دام لي عزمي وحزمي وعفتي","ففي كل ارض لي صديق اوده",68,"د",2,0],["وما دمت لا دامت عداك مخلداً","أرى كل يوم مر عيداً اعده",68,"د",2,0],["وما دمت فالآمال زهر طوالع","وخوض المنى ما شابه كدر بعد",69,"د",1,0],["وَمَا دَارُ الإمَارَة بالتِي لا","أبِيتُ لِبَيْنِها خَضِلَ المَآقِي",70,"ق",2,0],["وَما دَرَى أَنَّ سَيْفَ اللَّهِ آكِلُهُمْ","إذَا هُمُ اسْتَلَمُوا عُرْيانَ غُرْثَانا",71,"ن",2,0],["وما دونَ ما أبغي حجابٌ يصُدُّني","برّدٍ ولا بابٍ عن الخير مُغْلَقِ",72,"ق",1,0],["وما دول الاسلام سادت ومهدت","من الدين ما يلفى ألذ من الشهد",73,"د",1,0],["وما دروا أَنَّ الرَدى","أكمِنَ في ذاك الغَدا",74,"د",2,0],["وَما دامتْ نفوسُ القومِ يوماً","تثورُ فلا يزال لهمْ رجاءُ",75,"ا",2,0],["وَما درتْ أنَّ حبي بالغٌ أمداً","عَلى الحوادثِ لم ينقصْ وَلم يزد",76,"د",1,0],["وَما دَروا أَنَّهُ دونَ القِوى جَلَدُ","لِلشامِتينَ وَإِنَّ السُمَّ في العَسَلِ",77,"ل",1,0],["وَمَا دَرَى أَنَّ لامَ عارضهِ","لامُ ابتِداءٍ ولامُ تَوْكِيدِ",78,"د",1,0],["وَما دَرى بِأَنَّني لِذاتِها","أَمسَيتُ عَن صِفاتِها مُجَرَّدا",79,"د",2,0],["وَما دَرى لِتَعاميهِ وَغَرَّتهُ","بِأَنَّ حِليَةَ أَهلِ الفَضلِ في العَطَلِ",80,"ل",1,0],["وَما دَرى بِأَنَّ عَينَ حُسنِها","بِالضالِ عَينُ حُسنِها بِذي الأَثَل",81,"ل",1,0],["وما درَوْا أنّ غيرَ اللّهْو من أَرَبي","وأنّ غيرَ رَسيسِ الوَجْدِ من عِلَلي",82,"ل",2,0],["وما دُعِيتَ ضياءَ الدّينِ عن عَبَثٍ","لكنْ لنورٍ على أهليه مُشْتَمِل",83,"ل",1,0],["ومادُمْتَ حيّاً فالحقوقُ قديمةٌ","لبَحْرِك يا ابنَ الأكرمينَ أُجاور",84,"ر",1,0],["وَما دَرَّجَ الكُثبانَ مَرُّ نُسيمِها","بَلى دَرَّجَ الكُثبانَ ما أَنا لاثِمُ",85,"م",1,0],["ومادام في الدنيا لها من يقولُها","ويسمعُها منه ومن يَستجيدُها",86,"د",3,0],["وما دَنّستْ عرضي مقالَةُ حاسدٍ","وإن نَال من عرضي وبالَغَ في ذَمّي",87,"م",2,0],["وما دمتمُ لِلْمجد والجود بعدَهُ","فركنُ المعالي لا يزالُ مُشيّدا",88,"د",2,0],["وما دمتَ لا تُخْشى الليالي فإنّما","طَوالِعُها مَهْما بقيتَ سعودُ",89,"د",1,0],["وما دَروا أنّ ديونَ العُلى","بسُمْرِ أرماحك تُسْتقضىَ",90,"ض",2,0],["وما دمت حتى رامني الرِّئْم رمة","وأذرف آماق الحمى الدمع من أجلي",91,"ل",2,0],["وَما دامَ ذاكَ الحيُّ جارٌ لِحَيِّنا","فَدونَ حِجاب القَلبِ ما ضَمَّت الحُجُبُ",92,"ب",1,0],["وما دَرَى أنَّ في قلبي لفقدِهِمُ","ناراً تلظّى وفي الأجفانِ طُوفانا",93,"ن",2,0],["وما دون أن يَفنى الفرَنجُ وتُفْتَحَ ال","بلادُ سوى أن يُمضيَ العزمَ عازِمُ",94,"م",1,0],["وما دَرَوْا أنّه في جَحفَلٍ لَجِبٍ","من بأسِه غيرُ هيّابٍ ولا بَرِمِ",95,"م",1,0],["وما درى أيَّ جوىً أثاره","وعبرة بذكره أسالها",96,"ل",3,0],["وما دون ما أمّلته لقائكم","بلوغ منى يدنو ولا أمل يعلو",97,"ل",2,0],["وما درت أن في عقبى لذاذتها","نغائصاً وردها حادٍ عن الصدر",98,"ر",1,0],["وما دُعدِعَ الليثُ في غيلِهِ","سوى أن متى صافحوه لَطَمْ",99,"م",1,0],["وما دام يبقَى أبو سعدهم","فما نجم سعدك بالآفلِ",100,"ل",1,0],["وما دُهِيَ الإنسانُ فيمن يحبُّه","بفقدٍ كأخذٍ جاء من طول إمهالِ",101,"ل",1,0],["وما دِحىَ المصرِّحُ شاهداً لي","فداءٌ للمعرِّض في مَغيبي",102,"ب",2,0],["وما درى أنَّ نومي حيلةٌ نصبتْ","لوصلهِ حين أعيْا اليقظةَ الحِيلُ",103,"ل",1,0],["ومادتْ بأعطافِ المداليج نشوةٌ","مُرَنِّحةٌ حتى كأنهمُ شَرْبُ",104,"ب",1,0],["ومادَتُ بلادُ اللهِ حتى كأنما","سَفينٌ بها تنْزو جَنوبٌ غَشمْشم",105,"م",1,0],["وما دمتَ لا ظلُّ العفاةِ بقالصٍ","ولا عشيهم ذاوٍ ولا الماءُ ممنوح",106,"ح",1,0],["وما دُمتَ في الدَّنيا تعولُ ابنَ فاقهٍ","فأَهونُ ماضٍ مَن تغولُ الغوائل",107,"ل",1,0],["وما دُمتَ لم يُفقدْ من القوم فارسٌ","ولا علقتْ كفُّ المنون بذاهب",108,"ب",1,0],["وما دمت لا نور العلوم بخامد","ضئيل ولا قدر العفاة بخامل",109,"ل",1,0],["وما دام لم تصدع يدُ الدهر شملنا","فلا فضَّ للملك العزيز نظامُ",110,"م",1,0],["وما درتْ أن خدّيها ومصطبري","كجذوة النار منها قرّب الشمع",111,"ع",1,0],["وَما دارَ حَولَكَ بَل أنتَ دُرتَ","على الموتِ في زَرَدٍ مُحكَمِ",112,"م",1,0],["وما دارت الأرضُ إلا وأنتَ","لِلألائِها كالأخِ التَّوأمِ !",112,"م",1,0],["وما دامت الأحزان ألقيت بعدكم","إذا أنت فؤادي والجوارح والحشا",113,"ش",2,0],["وما درت ببرازخ لنا اقتنصت","أشكال من في مرائي الهجر يخترق",114,"ق",1,0],["وما دولة أنت المدبر أمرها","بمَنْشَب ظفر ما بقيت لها سَدّا",115,"د",2,0],["وما دينُنا إِلاَّ رِضاهِمْ وحبُّهُمْ","وللحُبِّ ما بينَ الصُّفوفِ رِجَالُ",116,"ل",1,0],["وما دَفْنُه في الأرضِ إلّا لعِلْمِنا","به أنّه كنزٌ لها ولَنا ذُخْرُ",117,"ر",1,0],["وما درى الخادم حتى أتى","من قال لم تحصل على طائل",118,"ل",1,0],["وما درى بأنها إما قذى","أو ميسم يبقى على قذاله",119,"ل",2,0],["وما درى أحد من قبل رؤيتهم","أن الحظوظ بلثم الأرض تقتسم",120,"م",1,0],["وما دروا أننا جدنا بأنفسنا","رخيصة في حروب لست أحصيها",121,"ي",3,0],["ومَا دامت النَّفسُ مُختَارة","فيا شَرَّ من يَمطِي قُصَّادُهَا",122,"د",3,0],["وَما دَنِستُ بعارٍ في الرّجال وما","لَمْسُ الكَواكب إلّا دونَ تَدنيسي",123,"س",2,0],["ومادَتْ لَها الأرضُ أوْ كادَتِ ال","حياةُ تُعَادُ لأمْوَاتِها",124,"ت",3,0],["وما دَرَى بأَنَّه","لِفعْلهِ قَدْ صَادَمْ",125,"م",1,0],["وما دَارُه قَلْبي ولا جَارُهُ الحَشَا","لأَنَّ الحَشَا والقَلبَ حَشْواهما النَّارُ",126,"ر",1,0],["وما دَرَت أَنَّ كلَّ خالٍ","بِغْضَتُه للظَّريف عاده",127,"د",2,0],["وما دعت الأَضيافُ أَلسنَ نارِهم","ولكنْ دعتْهم للنَّدى أَلسُن الثَّنا",128,"ن",2,0]]}