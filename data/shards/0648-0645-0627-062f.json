{"poems":[[63,"رأت أميمة أطماري وناظرها","https://www.aldiwan.net/poem45887.html","البسيط"],[93,"تكتب يومياتها عادله","https://www.aldiwan.net/poem11125.html","السريع"],[93,"ومأدبة بالنيوب الحداد","https://www.aldiwan.net/poem11301.html","المتقارب"],[93,"إلى أهلها تنعى النهى والعزائم","https://www.aldiwan.net/poem11408.html","الطويل"],[88,"ألا انهض وشمر أيها الشرق للحرب","https://www.aldiwan.net/poem44471.html","الطويل"],[88,"قرأت وما غير الطبيعة من سفر","https://www.aldiwan.net/poem45075.html","الطويل"],[51,"لا يغضبن لعمرو من له خطر","https://www.aldiwan.net/poem62965.html","البسيط"],[51,"أغر مخيلات الأماني لموعها","https://www.aldiwan.net/poem65406.html","الطويل"],[51,"أبا الصقر قد أصبحت في ظل نعمة","https://www.aldiwan.net/poem65936.html","الطويل"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[51,"اسلم على الأيام","https://www.aldiwan.net/poem66009.html","المجتث"],[51,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[91,"تبدل قلبي من ضلالته رشدا","https://www.aldiwan.net/poem8815.html","عموديه"],[89,"لقد كان سعد خير قوم مجاهد","https://www.aldiwan.net/poem44614.html","الطويل"],[85,"جعلت حلاها وتمثالها","https://www.aldiwan.net/poem62953.html","المتقارب"],[85,"أتغلبني ذات الدلال على صبري","https://www.aldiwan.net/poem63662.html","الطويل"],[43,"كدعواك كل يدعي صحة العقل","https://www.aldiwan.net/poem10137.html","الطويل"],[45,"لنا أبدا بث نعانيه من أروى","https://www.aldiwan.net/poem10213.html","الطويل"],[45,"أتتني أنباء ما قاله","https://www.aldiwan.net/poem65224.html","المتقارب"],[28,"يقول الأطباء المداوون إذ خشوا","https://www.aldiwan.net/poem1281.html",""],[28,"ألم يك جهلاً بعد ستين حجةً","https://www.aldiwan.net/poem1288.html",""],[66,"لم تتبع الأمر إلا كان أو كادا","https://www.aldiwan.net/poem38505.html","البسيط"],[80,"ما أغمد العضب حتى جرد الذكر","https://www.aldiwan.net/poem31441.html","البسيط"],[81,"سألتها علة من ماء مبسمها","https://www.aldiwan.net/poem61457.html","الطويل"],[75,"ألا طرقتنا والنجوم ركود","https://www.aldiwan.net/poem69091.html","الطويل"],[48,"يا رب ساق كأنه شبه البدر","https://www.aldiwan.net/poem64402.html","المنسرح"],[50,"أباهل إني للحروب عواد","https://www.aldiwan.net/poem63892.html","الطويل"],[46,"كأنما الأجساد إن فارقت","https://www.aldiwan.net/poem22370.html","السريع"],[46,"أعوذ بربي من سخطه","https://www.aldiwan.net/poem22921.html","المتقارب"],[46,"وجدت الموت للحيوان داء","https://www.aldiwan.net/poem23353.html","الوافر"],[46,"قد اختل الأنام بغير شك","https://www.aldiwan.net/poem23561.html","الوافر"],[1,"قفي ودعينا اليوم يا ابنة مالك","https://www.aldiwan.net/poem34008.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85601","الطويل"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9879","الوافر"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20982","الوافر"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20983","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55164","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54772","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54620","البسيط"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/999","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43897","الطويل"],[11,"","https://poetry.dctabudhabi.ae/diwan/poem/10371","الطويل"],[45,"لَنَا أبَداً بَثٌّ نُعانيهِ من أرْوَى","https://www.poetsgate.com/ViewPoem.aspx?id=31686",""]],"verses":[["وَما دَرَتْ أَنَّ في أَثْنائِها رَجُلاً","تُرْخَى على الأَسدِ الضّارِي غَدائِرُهُ",0,"ر",2,0],["وَمَا دَرَى أَنَّ سُعُودَ الْهَوَى","لِفَاضِلٍ زَوْجَتُهُ فَاضِلَهْ",1,"ل",2,0],["ومأدْبَةٍ بِالنُّيوبِ الحِدَادِ","غَزَوْنَا مَآكِلِهَا الطِّيِّبَهْ",2,"ه",1,1],["وَمَا دَامَ أَهْلُ البَيْتِ يَرْعَى شَبَابُهُمْ","شُيُوخَهُمُ فَالعِزُّ فِي البَيْتِ دَائِمُ",3,"م",1,0],["وما دعوة البابا لكم مستجابة","فقد أغضبت طغواكم غَيرة الرَبّ",4,"ب",1,0],["ومادة نسج الدمقس غطاؤها","بمجلس شبان هم أنجم العصر",5,"ر",1,0],["وما دعاه إلى استخفافه درَكٌ","لكن دعاه إليه الجهل والبطر",6,"ر",1,0],["وما درك الدهقان في قيل قائل","ألا ذاك خصاف النعال رقوعها",7,"ع",3,0],["وما دعَمَ الأقوامُ ظُلَّةَ نَعمةٍ","بمثلِ مُحقٍّ تحتها متظلّلِ",8,"ل",1,0],["وما دُبِغتْ بالمسك بل صُوفحت به","له قدمٌ في كلّ مجدٍ تَقدَّمُ",9,"م",1,0],["وما دعونا له وح","ده ولا لِفئامِ",10,"م",1,0],["ومادتْ لك الأجبال حتى كأنما","شواهقها كانت بِمحياك تُدَّعمْ",11,"م",1,0],["وَما دامَ في الدُنيا سُمُو وَرِفعَةٌ","فَما أَنا مَن يَرضى وَيَقنَعُ بِالأَردا",12,"د",2,0],["وما دون مصر في العراق لك الأسى","وإن دموع الشعر بعض الشواهد",13,"د",1,0],["وَما دانَ إِلّا بِشورى الأُمورِ","وَلا اِختالَ كِبراً وَلا اِستالَها",14,"ل",3,0],["وَما دَفعِيَ اللُوّامَ فيها سَآمَةٌ","وَلَكِنَّ نَفسَ الحُرِّ أَزجَرُ لِلحُرِّ",15,"ر",1,0],["وَما دامَ دِلَّيرٌ يَهُزُّ حُسامَهُ","فَلا نابَ في الدُنيا لِلَيثٍ وَلا شِبلِ",16,"ل",1,0],["وَما دامَ دِلَّيرٌ يُقَلِّبُ كَفَّهُ","فَلا خَلقَ مِن دَعوى المَكارِمِ في حِلِّ",16,"ل",1,0],["وَما دُوَلُ الأَيّامِ نُعماً وَأَبؤُساً","بِأَجرَحَ في الأَقوامِ مِنهُ وَلا أَسوا",17,"و",2,0],["وَما دُبرُ سُعدى وَأَخدانِها","بِأَكفاءِ كَهلِهِمِ المُحتَنِك",18,"ك",1,0],["وَما دَعوَةٌ تَدعو بِلالاً إِلى القِرى","وَلا الطَعنِ يَومَ الرَوعِ إِلّا يُجيبُها",19,"ب",3,0],["وَما دونَ كَفَّيكَ اِنتِهاءٌ لِراغِبٍ","وَلا لِمُناهُ مِن وَرائِكَ مَذهَبُ",20,"ب",1,0],["وَما دَعا لِلنَدى إِلّا أَجابَ نِدا","باغي النَوالِ إِذا ما ناحَ أَو نادى",21,"د",2,0],["ومادَتِ الأَرضُ من فُقدانِها جَبلاً","ينابِعُ الجودِ من سفحَيهِ تَنفَجِرُ",22,"ر",1,0],["وَما دَرَت أَنَّهُ وَاللَهِ لا عَجَبٌ","أَن يوجَدَ الدُرُّ مَقروناً مَعَ الصَدَفِ",23,"ف",1,0],["وما دَلَفَتْ إلاّ الهُمومُ وراءَهُ","وإنْ قال قومٌ إنّهُنّ حُشود",24,"د",1,0],["وَما دَرى الشَربُ أَو دَرَوا فَلَهَوا","عَن قَرَحِ القَلبِ قَد لَجَّ في دَنَفِه",25,"ف",2,0],["وَما دافَعوهُ رَغبَةً عَن سَقامِهِ","وَلَكِنَّ أَولادَ الزِناءِ خِلادُ",26,"د",1,0],["وَما دَرى المَيتُ أَأَكفانُهُ","مُخلِقَةٌ في رَمسِهِ أَم قُشُب",27,"ب",1,0],["وَما دَفَعَت حُكَماءُ الرِجالِ","حَتفاً بِحِكمَةِ بُقراطِها",28,"ط",3,0],["وَما دُنياكَ إِلّا دارُ سوءٍ","وَلَستَ عَلى إِساءَتِها مُقيما",29,"م",2,0],["وَما دانَ الفَتى بِحِجىً وَلَكِن","يُعَلِّمُهُ التَدَيُّنَ أَقرَبوهُ",30,"ب",3,0],["وَما دَفَعَت عَنِ الملِكِ المَنايا","مَقانِبُهُ وَلا مُتَكَتِّبوهُ",30,"ب",3,0],["وَما دونَها إِلّا ثَلاثٌ مَآوِبٌ","قُدِرنَ لِعيسٍ مُسنِفاتِ الحَوارِكِ",31,"ك",1,0],["وَما دون مصر مطلبٌ لميمم","ففيها ينال المجد من همه المجد",32,"د",1,0],["وَما دجلة عن قاصديها قصية","ولا ماؤها يوماً لشاربه ثمد",32,"د",1,0],["وَما دانَيتُ شَخصَ المَوتِ إِلّا","كَما يَدنو الشُجاعُ مِنَ الجَبانِ",33,"ن",1,0],["وما دَهري اطبَأَنَّكِ غيرَ أَنيِّ","بَنَى لي والدي بَيتاً يَفاعا",34,"ع",2,0],["وما دَهري بأن كُدِّرتُ فَضلاً","ولكن ما لَقيتُ مِنَ العَجِيبِ",35,"ب",1,0],["وَمَا دَعْوى اتِّحادٍ فِي بِلاَدٍ","وَمَا دَعْوَى ذِمَارٍ مُسْتَقِل",36,"ل",1,0],["وَمَا دَرَى أَنَّهُ لَوْ نَالَ مِدْفَعُهُ","أَرْسَى الْقِلاَعِ فَدُكَّتْ وَهْيَ تَتَّقِدُ",37,"د",1,0],["وَمَا دَهَى الْشَّرْقَ في ابْنَاهُ قَاطِبَةً","فأَصْبَحَ الرَّأْسُ مِنْ أَبْنَائِهِ ذَنَبَا",38,"ب",2,0],["وَما دَعاني إِلى ما سائَهُ سَخَطٌ","إِلّا ثَناني إِلى ماشاءَ إِشفاقُ",39,"ق",1,0],["وما دَرأَتْ عن تُبَّعٍ تُبَّعٌ له","صروفَ الرَّدَى الجاري على كلِّ قَسْوَرِ",40,"ر",1,0],["وَما دارِعٌ إِلّا كَآخَرَ حاسِرٍ","وَما مُقتِرٌ إِلّا كَآخَرَ ذي وَفرِ",41,"ر",1,0],["وَمَا دُوَلُ الأيّامِ، نُعْمَى وأبْؤساً،","بأجْرَحَ في الأقْوَامِ مِنه، وَلا أسوَا",42,"و",2,0]]}