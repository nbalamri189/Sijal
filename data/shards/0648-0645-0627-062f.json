.net/poem32204.html","البسيط"],[420,"أهاجها حادي المطي فمالها","https://www.aldiwan.net/poem54170.html","الرجز"],[441,"دعوا مقلتي تغفي إذا لم يكن وصل","https://www.aldiwan.net/poem2512.html","الطويل"],[445,"قد خان سمعي وعيني خانها بصري","https://www.aldiwan.net/poem14370.html","البسيط"],[461,"عذيرك من حلمك المهتضم","https://www.aldiwan.net/poem55892.html","المتقارب"],[461,"لمن طل بلِوى عاقِلِ","https://www.aldiwan.net/poem55998.html","المتقارب"],[461,"كذا تنقضي الأيام حالا على حال","https://www.aldiwan.net/poem56070.html","الطويل"],[461,"أخي في الود أخي النسيبِ","https://www.aldiwan.net/poem56304.html","الوافر"],[464,"زار الخيال بخيلا مثل مرسله","https://www.aldiwan.net/poem15326.html","البسيط"],[464,"أقول وقد طاب النسيم بمدرجي","https://www.aldiwan.net/poem15372.html","الطويل"],[464,"تعاظم حزني والرزية أعظم","https://www.aldiwan.net/poem15905.html","الطويل"],[467,"عيون المهى قلبي بنبلك مجروح","https://www.aldiwan.net/poem3149.html","عموديه"],[467,"لقد سل سيفا والغدار الحمائل","https://www.aldiwan.net/poem3189.html","عموديه"],[467,"بقبرك فلتسحب ذيول السحائب","https://www.aldiwan.net/poem3210.html","عموديه"],[467,"ليهن الورى برء العلى والفضائل","https://www.aldiwan.net/poem3265.html","عموديه"],[467,"أشاقك برق بالشآم يشام","https://www.aldiwan.net/poem3487.html","عموديه"],[467,"تعجبت من نحولي وهي واصلة","https://www.aldiwan.net/poem3570.html","عموديه"],[468,"في رحاب الحسين","https://www.aldiwan.net/poem59034.html","عموديه"],[485,"سلام عليكم ما أمر فراقكم","https://www.aldiwan.net/poem24433.html","عموديه"],[485,"كم كنت في غمرات الحب أستبق","https://www.aldiwan.net/poem24456.html","عموديه"],[498,"سقى الله نجدا كلما ذكروا نجدا","https://www.aldiwan.net/poem9820.html","الطويل"],[503,"هنيئا لعبد طيب الحب قلبه","https://www.aldiwan.net/poem37822.html","الطويل"],[517,"مضى خلف الأبرار والسيد الطهر","https://www.aldiwan.net/poem20839.html","الطويل"],[518,"خادم ذيل المجلس العادلي","https://www.aldiwan.net/poem12197.html","السريع"],[518,"قدك مثل الغصن في اعتداله","https://www.aldiwan.net/poem12217.html","الرجز"],[518,"ثغر الزمان بنجم الدين مبتسم","https://www.aldiwan.net/poem12263.html","البسيط"],[537,"إلى الأمير فدته النفس أهديها","https://www.aldiwan.net/poem23814.html","البسيط"],[541,"مللت الكتابة دهرا طويلا","https://www.aldiwan.net/poem48204.html","عموديه"],[554,"قد زرت ليلة هومنا على العيس","https://www.aldiwan.net/poem47744.html","البسيط"],[570,"وجارية تستميل القلوب","https://www.aldiwan.net/poem69777.html","المتقارب"],[578,"عز إله العالم","https://www.aldiwan.net/poem2756.html","مجزوء الرجز"],[578,"أيا دار في جنات عدن له دار","https://www.aldiwan.net/poem2783.html","الطويل"],[578,"لا تجر دمعا على سعاد","https://www.aldiwan.net/poem2818.html","مخلع البسيط"],[578,"أحدث عنكم أن بعدكم دنا","https://www.aldiwan.net/poem2999.html","الطويل"],[745,"","https://poetry.dctabudhabi.ae/diwan/poem/67418","الطويل"],[845,"","https://poetry.dctabudhabi.ae/diwan/poem/21480","الطويل"],[963,"","https://poetry.dctabudhabi.ae/diwan/poem/96122","الطويل"],[1027,"","https://poetry.dctabudhabi.ae/diwan/poem/20542","المتقارب"],[1062,"","https://poetry.dctabudhabi.ae/diwan/poem/21394","الطويل"],[1073,"","https://poetry.dctabudhabi.ae/diwan/poem/18727","الوافر"],[1164,"","https://poetry.dctabudhabi.ae/diwan/poem/18780","الطويل"]],"verses":[["وما دام عنه الدين حسّن بدعةً","فلم بإجتهادي ركنه قد تهدما",0,"م",2,0],["وما درت أنَّ هَمَّ الحرِّ تَعذِرَةٌ","إذا أرادَ صلاحًا ثُمَّ ما وَجَدا",1,"د",2,0],["وَما دَرَتْ أَنَّ في أَثْنائِها رَجُلاً","تُرْخَى على الأَسدِ الضّارِي غَدائِرُهُ",2,"ر",2,0],["وَمَا دَرَى أَنَّ سُعُودَ الْهَوَى","لِفَاضِلٍ زَوْجَتُهُ فَاضِلَهْ",3,"ل",2,0],["ومأدْبَةٍ بِالنُّيوبِ الحِدَادِ","غَزَوْنَا مَآكِلِهَا الطِّيِّبَهْ",4,"ه",1,1],["وَمَا دَامَ أَهْلُ البَيْتِ يَرْعَى شَبَابُهُمْ","شُيُوخَهُمُ فَالعِزُّ فِي البَيْتِ دَائِمُ",5,"م",1,0],["وما دعوة البابا لكم مستجابة","فقد أغضبت طغواكم غَيرة الرَبّ",6,"ب",1,0],["ومادة نسج الدمقس غطاؤها","بمجلس شبان هم أنجم العصر",7,"ر",1,0],["وما دعاه إلى استخفافه درَكٌ","لكن دعاه إليه الجهل والبطر",8,"ر",1,0],["وما درك الدهقان في قيل قائل","ألا ذاك خصاف النعال رقوعها",9,"ع",3,0],["وما دعَمَ الأقوامُ ظُلَّةَ نَعمةٍ","بمثلِ مُحقٍّ تحتها متظلّلِ",10,"ل",1,0],["وما دُبِغتْ بالمسك بل صُوفحت به","له قدمٌ في كلّ مجدٍ تَقدَّمُ",11,"م",1,0],["وما دعونا له وح","ده ولا لِفئامِ",12,"م",1,0],["ومادتْ لك الأجبال حتى كأنما","شواهقها كانت بِمحياك تُدَّعمْ",13,"م",1,0],["وَما دامَ في الدُنيا سُمُو وَرِفعَةٌ","فَما أَنا مَن يَرضى وَيَقنَعُ بِالأَردا",14,"د",2,0],["وما دون مصر في العراق لك الأسى","وإن دموع الشعر بعض الشواهد",15,"د",1,0],["وَما دانَ إِلّا بِشورى الأُمورِ","وَلا اِختالَ كِبراً وَلا اِستالَها",16,"ل",3,0],["وَما دَفعِيَ اللُوّامَ فيها سَآمَةٌ","وَلَكِنَّ نَفسَ الحُرِّ أَزجَرُ لِلحُرِّ",17,"ر",1,0],["وَما دامَ دِلَّيرٌ يَهُزُّ حُسامَهُ","فَلا نابَ في الدُنيا لِلَيثٍ وَلا شِبلِ",18,"ل",1,0],["وَما دامَ دِلَّيرٌ يُقَلِّبُ كَفَّهُ","فَلا خَلقَ مِن دَعوى المَكارِمِ في حِلِّ",18,"ل",1,0],["وَما دُوَلُ الأَيّامِ نُعماً وَأَبؤُساً","بِأَجرَحَ في الأَقوامِ مِنهُ وَلا أَسوا",19,"و",2,0],["وَما دُبرُ سُعدى وَأَخدانِها","بِأَكفاءِ كَهلِهِمِ المُحتَنِك",20,"ك",1,0],["وَما دَعوَةٌ تَدعو بِلالاً إِلى القِرى","وَلا الطَعنِ يَومَ الرَوعِ إِلّا يُجيبُها",21,"ب",3,0],["وَما دونَ كَفَّيكَ اِنتِهاءٌ لِراغِبٍ","وَلا لِمُناهُ مِن وَرائِكَ مَذهَبُ",22,"ب",1,0],["وَما دَعا لِلنَدى إِلّا أَجابَ نِدا","باغي النَوالِ إِذا ما ناحَ أَو نادى",23,"د",2,0],["ومادَتِ الأَرضُ من فُقدانِها جَبلاً","ينابِعُ الجودِ من سفحَيهِ تَنفَجِرُ",24,"ر",1,0],["وَما دَرَت أَنَّهُ وَاللَهِ لا عَجَبٌ","أَن يوجَدَ الدُرُّ مَقروناً مَعَ الصَدَفِ",25,"ف",1,0],["وما دَلَفَتْ إلاّ الهُمومُ وراءَهُ","وإنْ قال قومٌ إنّهُنّ حُشود",26,"د",1,0],["وَما دَرى الشَربُ أَو دَرَوا فَلَهَوا","عَن قَرَحِ القَلبِ قَد لَجَّ في دَنَفِه",27,"ف",2,0],["وَما دافَعوهُ رَغبَةً عَن سَقامِهِ","وَلَكِنَّ أَولادَ الزِناءِ خِلادُ",28,"د",1,0],["وَما دَرى المَيتُ أَأَكفانُهُ","مُخلِقَةٌ في رَمسِهِ أَم قُشُب",29,"ب",1,0],["وَما دَفَعَت حُكَماءُ الرِجالِ","حَتفاً بِحِكمَةِ بُقراطِها",30,"ط",3,0],["وَما دُنياكَ إِلّا دارُ سوءٍ","وَلَستَ عَلى إِساءَتِها مُقيما",31,"م",2,0],["وَما دانَ الفَتى بِحِجىً وَلَكِن","يُعَلِّمُهُ التَدَيُّنَ أَقرَبوهُ",32,"ب",3,0],["وَما دَفَعَت عَنِ الملِكِ المَنايا","مَقانِبُهُ وَلا مُتَكَتِّبوهُ",32,"ب",3,0],["وَما دونَها إِلّا ثَلاثٌ مَآوِبٌ","قُدِرنَ لِعيسٍ مُسنِفاتِ الحَوارِكِ",33,"ك",1,0],["وَما دون مصر مطلبٌ لميمم","ففيها ينال المجد من همه المجد",34,"د",1,0],["وَما دجلة عن قاصديها قصية","ولا ماؤها يوماً لشاربه ثمد",34,"د",1,0],["وَما دانَيتُ شَخصَ المَوتِ إِلّا","كَما يَدنو الشُجاعُ مِنَ الجَبانِ",35,"ن",1,0],["وما دَهري اطبَأَنَّكِ غيرَ أَنيِّ","بَنَى لي والدي بَيتاً يَفاعا",36,"ع",2,0],["وما دَهري بأن كُدِّرتُ فَضلاً","ولكن ما لَقيتُ مِنَ العَجِيبِ",37,"ب",1,0],["وَمَا دَعْوى اتِّحادٍ فِي بِلاَدٍ","وَمَا دَعْوَى ذِمَارٍ مُسْتَقِل",38,"ل",1,0],["وَمَا دَرَى أَنَّهُ لَوْ نَالَ مِدْفَعُهُ","أَرْسَى الْقِلاَعِ فَدُكَّتْ وَهْيَ تَتَّقِدُ",39,"د",1,0],["وَمَا دَهَى الْشَّرْقَ في ابْنَاهُ قَاطِبَةً","فأَصْبَحَ الرَّأْسُ مِنْ أَبْنَائِهِ ذَنَبَا",40,"ب",2,0],["وَما دَعاني إِلى ما سائَهُ سَخَطٌ","إِلّا ثَناني إِلى ماشاءَ إِشفاقُ",41,"ق",1,0],["وما دَرأَتْ عن تُبَّعٍ تُبَّعٌ له","صروفَ الرَّدَى الجاري على كلِّ قَسْوَرِ",42,"ر",1,0],["وَما دارِعٌ إِلّا كَآخَرَ حاسِرٍ","وَما مُقتِرٌ إِلّا كَآخَرَ ذي وَفرِ",43,"ر",1,0],["وما دفنوا نفس امرئ منك وحدها","ولكن نفوس في ضريحك تردم",44,"م",1,0],["وَمَا دُوَلُ الأيّامِ، نُعْمَى وأبْؤساً،","بأجْرَحَ في الأقْوَامِ مِنه، وَلا أسوَا",45,"و",2,0],["وما دهتنا من الجبّار عادية","إلاّ جزينا على الطّغيان طغيانا",46,"ن",2,0],["وما دفنوا نفس امرىء منك وحدها","ولكن نفوس في ضريحك تردم",47,"م",1,0],["وما دمت تبني ، وتهدي سواك","سيحكون ، منك إليك اهتديت",48,"ت",1,0],["وَما دارَهُ قَصدي وَلَكن لِأَجلِهِ","أَحنُّ فَلا أَلفي لَها غَير آلفِ",49,"ف",1,0],["وما درى إن صدقي في محبة من","أحببتهم وعلو النفس من شيمي",50,"م",2,0],["وما دعاك غريب لاذ فيك وقد","وافاك يا من زكت طبعاً خلائقه",51,"ق",2,0],["وما دَرَوْا أنك الملكُ الذي خضعَتْ","له مُلوكُ الورَى والبَدْوُ والحَضرُ",52,"ر",1,0],["وما درى أن بعض القوم مركبُه","متنَ الصَّبَا وهي العيرانةُ الأُجُد",53,"د",1,0],["وما درى أنيّ لمّا بدا","زدت غراماً فوق ذاك الغرام",54,"م",1,0],["وَما دونَهُ لِلطالِبي العُرفِ حاجِبٌ","إِذا ما أَتَوا مِن دونِ بابِكَ حُجّابا",55,"ب",2,0],["ومادحُ شرط الخدّ في السود صادقٌ","وأما بخد البيض فالقبح عمدتي",56,"ي",1,0],["وما دارنا إلا مناخ لراكب","يقيلُ به لكنّه يتنقُل",57,"ل",1,0],["وما در ديب إذ عصاه وسالم","فليس لأم قبل أمهما ثكل",58,"ل",1,0],["وَما دامَ لَيثُ الغابِ في الغابِ كامِناً","فَإِنَّ حَراماً أَن تُدَمّى مَخالِبُهْ",59,"ب",2,0],["وما دَرَوا أَنَّ فَضلَ الجُودِ يُكذِبُهُم","عَمّا قَليلٍ بِما في زَعمِهِم زَعَمُوا",60,"م",3,0],["وَما دِماؤُكُم أَغلى إِذا سُفِكتْ","مِن ماء وَجهِ لَهُم في الفُحشِ يَنسَكِبُ",61,"ب",1,0],["وما دُعيتَ بشاهِنْشَاهَ فاعترفتْ","به الملوكُ على جهلٍ ولا غِرَرِ",62,"ر",1,0],["وما دام عَتْبُك إلا وأنت","تُفدِّر أن فؤادي معي",63,"ع",2,0],["وماد الخَيزُرانُ به تَناهَى","إلى صفة تَجِلّ عن المِثال",64,"ل",1,0],["وما دامَ شعرُ القومِ أمسى كما ترى","شعيراً فقل إن الزمانَ بهيم",65,"م",1,0],["وما دامتِ الأفلاكُ في دورانها","ففيهنَّ من بعدِ الأمورِ أمورُ",66,"ر",1,0],["وما دمعتي تلك التي قد تحدَّرت","ولكنَّها وَدقٌ غدت تتحدَّرُ",67,"ر",1,0],["وما دها المجد يتم بعد والده","وكيف يبقى يتيماً وهو كافله",68,"ل",2,0],["وما دار كأس الأنس من قدس حضرةٍ","بمسك شذا ختم الجلالة بالحمد",69,"د",1,0],["وما دام لي عزمي وحزمي وعفتي","ففي كل ارض لي صديق اوده",70,"د",2,0],["وما دمت لا دامت عداك مخلداً","أرى كل يوم مر عيداً اعده",70,"د",2,0],["وما دمت فالآمال زهر طوالع","وخوض المنى ما شابه كدر بعد",71,"د",1,0],["وَمَا دَارُ الإمَارَة بالتِي لا","أبِيتُ لِبَيْنِها خَضِلَ المَآقِي",72,"ق",2,0],["وَما دَرَى أَنَّ سَيْفَ اللَّهِ آكِلُهُمْ","إذَا هُمُ اسْتَلَمُوا عُرْيانَ غُرْثَانا",73,"ن",2,0],["وما دونَ ما أبغي حجابٌ يصُدُّني","برّدٍ ولا بابٍ عن الخير مُغْلَقِ",74,"ق",1,0],["وما دول الاسلام سادت ومهدت","من الدين ما يلفى ألذ من الشهد",75,"د",1,0],["وما دروا أَنَّ الرَدى","أكمِنَ في ذاك الغَدا",76,"د",2,0],["وَما دامتْ نفوسُ القومِ يوماً","تثورُ فلا يزال لهمْ رجاءُ",77,"ا",2,0],["وَما درتْ أنَّ حبي بالغٌ أمداً","عَلى الحوادثِ لم ينقصْ وَلم يزد",78,"د",1,0],["وَما دَروا أَنَّهُ دونَ القِوى جَلَدُ","لِلشامِتينَ وَإِنَّ السُمَّ في العَسَلِ",79,"ل",1,0],["وَمَا دَرَى أَنَّ لامَ عارضهِ","لامُ ابتِداءٍ ولامُ تَوْكِيدِ",80,"د",1,0],["وَما دَرى بِأَنَّني لِذاتِها","أَمسَيتُ عَن صِفاتِها مُجَرَّدا",81,"د",2,0],["وَما دَرى لِتَعاميهِ وَغَرَّتهُ","بِأَنَّ حِليَةَ أَهلِ الفَضلِ في العَطَلِ",82,"ل",1,0],["وَما دَرى بِأَنَّ عَينَ حُسنِها","بِالضالِ عَينُ حُسنِها بِذي الأَثَل",83,"ل",1,0],["وما درَوْا أنّ غيرَ اللّهْو من أَرَبي","وأنّ غيرَ رَسيسِ الوَجْدِ من عِلَلي",84,"ل",2,0],["وما دُعِيتَ ضياءَ الدّينِ عن عَبَثٍ","لكنْ لنورٍ على أهليه مُشْتَمِل",85,"ل",1,0],["ومادُمْتَ حيّاً فالحقوقُ قديمةٌ","لبَحْرِك يا ابنَ الأكرمينَ أُجاور",86,"ر",1,0],["وَما دَرَّجَ الكُثبانَ مَرُّ نُسيمِها","بَلى دَرَّجَ الكُثبانَ ما أَنا لاثِمُ",87,"م",1,0],["ومادام في الدنيا لها من يقولُها","ويسمعُها منه ومن يَستجيدُها",88,"د",3,0],["وما دَنّستْ عرضي مقالَةُ حاسدٍ","وإن نَال من عرضي وبالَغَ في ذَمّي",89,"م",2,0],["وما دمتمُ لِلْمجد والجود بعدَهُ","فركنُ المعالي لا يزالُ مُشيّدا",90,"د",2,0],["وما دمتَ لا تُخْشى الليالي فإنّما","طَوالِعُها مَهْما بقيتَ سعودُ",91,"د",1,0],["وما دَروا أنّ ديونَ العُلى","بسُمْرِ أرماحك تُسْتقضىَ",92,"ض",2,0],["وما دمت حتى رامني الرِّئْم رمة","وأذرف آماق الحمى الدمع من أجلي",93,"ل",2,0],["وَما دامَ ذاكَ الحيُّ جارٌ لِحَيِّنا","فَدونَ حِجاب القَلبِ ما ضَمَّت الحُجُبُ",94,"ب",1,0],["وما دَرَى أنَّ في قلبي لفقدِهِمُ","ناراً تلظّى وفي الأجفانِ طُوفانا",95,"ن",2,0],["وما دون أن يَفنى الفرَنجُ وتُفْتَحَ ال","بلادُ سوى أن يُمضيَ العزمَ عازِمُ",96,"م",1,0],["وما دَرَوْا أنّه في جَحفَلٍ لَجِبٍ","من بأسِه غيرُ هيّابٍ ولا بَرِمِ",97,"م",1,0],["وما درى أيَّ جوىً أثاره","وعبرة بذكره أسالها",98,"ل",3,0],["وما دون ما أمّلته لقائكم","بلوغ منى يدنو ولا أمل يعلو",99,"ل",2,0],["وما درت أن في عقبى لذاذتها","نغائصاً وردها حادٍ عن الصدر",100,"ر",1,0],["وما دُعدِعَ الليثُ في غيلِهِ","سوى أن متى صافحوه لَطَمْ",101,"م",1,0],["وما دام يبقَى أبو سعدهم","فما نجم سعدك بالآفلِ",102,"ل",1,0],["وما دُهِيَ الإنسانُ فيمن يحبُّه","بفقدٍ كأخذٍ جاء من طول إمهالِ",103,"ل",1,0],["وما دِحىَ المصرِّحُ شاهداً لي","فداءٌ للمعرِّض في مَغيبي",104,"ب",2,0],["وما درى أنَّ نومي حيلةٌ نصبتْ","لوصلهِ حين أعيْا اليقظةَ الحِيلُ",105,"ل",1,0],["ومادتْ بأعطافِ المداليج نشوةٌ","مُرَنِّحةٌ حتى كأنهمُ شَرْبُ",106,"ب",1,0],["ومادَتُ بلادُ اللهِ حتى كأنما","سَفينٌ بها تنْزو جَنوبٌ غَشمْشم",107,"م",1,0],["وما دمتَ لا ظلُّ العفاةِ بقالصٍ","ولا عشيهم ذاوٍ ولا الماءُ ممنوح",108,"ح",1,0],["وما دُمتَ في الدَّنيا تعولُ ابنَ فاقهٍ","فأَهونُ ماضٍ مَن تغولُ الغوائل",109,"ل",1,0],["وما دُمتَ لم يُفقدْ من القوم فارسٌ","ولا علقتْ كفُّ المنون بذاهب",110,"ب",1,0],["وما دمت لا نور العلوم بخامد","ضئيل ولا قدر العفاة بخامل",111,"ل",1,0],["وما دام لم تصدع يدُ الدهر شملنا","فلا فضَّ للملك العزيز نظامُ",112,"م",1,0],["وما درتْ أن خدّيها ومصطبري","كجذوة النار منها قرّب الشمع",113,"ع",1,0],["وَما دارَ حَولَكَ بَل أنتَ دُرتَ","على الموتِ في زَرَدٍ مُحكَمِ",114,"م",1,0],["وما دارت الأرضُ إلا وأنتَ","لِلألائِها كالأخِ التَّوأمِ !",114,"م",1,0],["وما دامت الأحزان ألقيت بعدكم","إذا أنت فؤادي والجوارح والحشا",115,"ش",2,0],["وما درت ببرازخ لنا اقتنصت","أشكال من في مرائي الهجر يخترق",116,"ق",1,0],["وما دولة أنت المدبر أمرها","بمَنْشَب ظفر ما بقيت لها سَدّا",117,"د",2,0],["وما دينُنا إِلاَّ رِضاهِمْ وحبُّهُمْ","وللحُبِّ ما بينَ الصُّفوفِ رِجَالُ",118,"ل",1,0],["وما دَفْنُه في الأرضِ إلّا لعِلْمِنا","به أنّه كنزٌ لها ولَنا ذُخْرُ",119,"ر",1,0],["وما درى الخادم حتى أتى","من قال لم تحصل على طائل",120,"ل",1,0],["وما درى بأنها إما قذى","أو ميسم يبقى على قذاله",121,"ل",2,0],["وما درى أحد من قبل رؤيتهم","أن الحظوظ بلثم الأرض تقتسم",122,"م",1,0],["وما دروا أننا جدنا بأنفسنا","رخيصة في حروب لست أحصيها",123,"ي",3,0],["ومَا دامت النَّفسُ مُختَارة","فيا شَرَّ من يَمطِي قُصَّادُهَا",124,"د",3,0],["وَما دَنِستُ بعارٍ في الرّجال وما","لَمْسُ الكَواكب إلّا دونَ تَدنيسي",125,"س",2,0],["ومادَتْ لَها الأرضُ أوْ كادَتِ ال","حياةُ تُعَادُ لأمْوَاتِها",126,"ت",3,0],["وما دَرَى بأَنَّه","لِفعْلهِ قَدْ صَادَمْ",127,"م",1,0],["وما دَارُه قَلْبي ولا جَارُهُ الحَشَا","لأَنَّ الحَشَا والقَلبَ حَشْواهما النَّارُ",128,"ر",1,0],["وما دَرَت أَنَّ كلَّ خالٍ","بِغْضَتُه للظَّريف عاده",129,"د",2,0],["وما دعت الأَضيافُ أَلسنَ نارِهم","ولكنْ دعتْهم للنَّدى أَلسُن الثَّنا",130,"ن",2,0],["وَمَا دُفِنَتْ قَتْلَى قُرَيشٍ وَعَامِرٍ","بِصِفّينَ حَتَّى حُكِّمَ الْحَكَمَانِ",131,"ن",1,0],["وَما دَخَلت في الخَدبِ حَتّى تَنَقَّضَت","تآسيرُ أَعلى قِدّهِ وَتَحَطَّما",132,"م",2,0],["وما دون ضيفي من تلاد تحوزه","لي النفسُ الا أن تصان الحلائلُ",133,"ل",1,0],["وَما دُمَيةٌ مِن دُمى مَيسَنا","نَ مُعجِبَةُ نَظَراً واتِّصافا",134,"ف",2,0],["وَما دَهرُنا أَلَّا يَكونَ أَصابَنا","بِثِقلٍ وَلكِنَّا رُزينا لِنَصبِرا",135,"ر",2,0],["وَما دَهري بِشَتمِكَ فَاِعلَمنَهُ","وَلَكِن أَنتَ مَخذولٌ كَبيرُ",136,"ر",1,0],["وَما دَلِّ قَوما قبلنا ثَورُ حِجرِهِ","وَدونَ الَّذي نَخشى أُباةٌ وَسامِرُ",137,"ر",1,1]]}