=188369",""],[5956,"إذا ذُكِرَ اْسمُها","https://www.poetsgate.com/ViewPoem.aspx?id=181945",""],[5956,"أيا إيهاب أنت فتىً لطيفُ","https://www.poetsgate.com/ViewPoem.aspx?id=205132",""],[6117,"سِفْر ُالأحَادِيْثِ وَنَبْعُ الْفَضَائِلْ","https://www.poetsgate.com/ViewPoem.aspx?id=182797",""],[6152,"عرشها بقلبي","https://www.poetsgate.com/ViewPoem.aspx?id=203312",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[6164,"الثمانون؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66038&r=&rc=48",""],[6198,"عباءة الصمت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79232&r=&rc=6",""],[6229,"القبّرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65189&r=&rc=15",""],[6315,"البَيدَاءُ وَ الجَنِينُ المُرتَقَب ... تَحِيَّتَانِ للأُنثَى !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87577&r=&rc=2",""]],"verses":[["كَما تَثوبُ الدَبرُ قَد","عادَ إِليها العاسِلُ",0,"ل",1,0],["كَما تَعرى بِهِ الغيطانُ مَحلاً","وَتَغبَرُّ التَهايِمُ وَالنُجودُ",1,"د",1,0],["كَما تُليحُ ذِراعٌ","فيها مِنَ النَضرِ قُلبُ",2,"ب",1,0],["كَما تَشاءُ فَقُل لي لَستُ مُنتَقِلاً","لا تَخشَ مِنِّيَ نِسياناً وَلا بَدَلا",3,"ل",2,1],["كَما تَنأى إِذا ما قُلتُ تَدنو","شَموسُ الخَيلِ حاذَرَتِ اللِجاما",4,"م",2,0],["كما تُحْضَر الأثقالُ وهي مهمة","بمسلمةَ استعلاؤها وازد مالُها",5,"ه",2,1],["كما تعاهدني فضل المواهب من","عليّ أهل العلى والاسم والسمةِ",6,"ه",1,0],["كما تلى التنزيل مستقبل المح","راب والإتمام في حمده",7,"د",2,0],["كم أتتني مع الركاب لهاهُ","ووفت لي مع الزمن خصاله",8,"ل",2,0],["كما تُطَرِّقُ بالآراء تَقْدَحُها","برأْيه فَتُلَقَّى كلَّ تَسديدِ",9,"د",1,0],["كما تعافُ الطَّيِّبَ المشتهَى","من الطعام المَعِدَةُ الفاسدَهْ",10,"د",2,0],["كَما تَطاعَمَ في خَضراءَ ناعِمَةٍ","مُطَوَّقانِ أَصاخا بَعدَ تَغريدِ",11,"د",1,0],["كَما تَعافُ السَراةُ الثَوبَ قَد بَلِيَت","خُيوطُه وَالرُواةُ المَورِدَ القَذِرا",12,"ر",2,0],["كما تطلّع يوما في ركائبه","رمسيس تدفعه الأيدي وتزجيها",13,"ي",3,0],["كَما تَهَبُ الأَنواءُ وَهيَ عَوابِسٌ","وَتَضحَكُ في وَجهِهِ القَتيلِ الصَفائِحُ",14,"ح",1,0],["كما تَفجَّرَ عَيناً ثرَّةً حجَرٌ","قاسٍ تفَجَّرَ دمعاً قلبيَ الصَلد",15,"د",1,0],["كَما تَبَسَّمَ ثَغرٌ","عَذبٌ يُقَبِّلُ خَدّا",16,"د",2,0],["كَما تَدانَيتَ مِن ثَغرٍ لِمُرتَشِفٍ","ثُمَّ اِنثَنَيتَ فَلَم تَصدُر وَلَم تَرِدِ",17,"د",1,0],["كَما تَوَلَّت لَيلَةٌ","تَسحَبُ ذَيلَ الغَسَقِ",18,"ق",1,0],["كَما تَمَّ حُسنُ البَدرِ وَهوَ مُكَمَّلٌ","وأَيَّدَهُ دُرّيُّ سَعدٍ يُقابِلُه",19,"ل",2,0],["كَما تَتَراءى خِلالَ السَحا","بِ شَمسُ النَهارِ تَرُومُ اطِّلاعا",20,"ع",2,0],["كَما تَحَكَّمَ في العُنوانِ قارِءُهُ","وَلا يُفَضُّ خَواتيماً عَنِ الكُتُبِ",21,"ب",1,0],["كَمَا تُحِبُّ وَتَرْضَى سَيِّدِي وكَمَا","أمَرْتَنا أنْ نُصَلِّي أنْتَ مُقْتَدِرُ",22,"ر",1,0],["كَما تغادر وجهَ البحر زوبعةٌ","له تثير وَيَبقى البحر مضطربا",23,"ب",2,0],["كَما ترحب أرض","ممطورة بالحياة",24,"ه",1,0],["كما تذبل الدّاليات الصّبايا","ذرت في سخاء المنى والعطايا",25,"ا",3,1],["كما تبدلني من صحتي ألما","مرّاً وتوسعني من كل ضراء",26,"ا",2,0],["كَمَا تَصَدَّى لِى زَنِيمٌ مُذَمَّمٌ","يُحَاوِلُ في حَولِ القَصَائِدِ شَأوِيَا",27,"ي",2,0],["كما تسجع الوَرقاء فوق غصونها","وليس لها نهىٌ يطاع ولا أمرُ",28,"ر",1,0],["كَما تَنافى الثُرَيّا وَالزَرى رُتَباً","لا مِثلَما يتَنافى الصُفرُ وَالذَهَبُ",29,"ب",1,0],["كَم أَتانا بأمرِ بِرٍّ ونهيٍ","عَن عقوقٍ وهو الفتى المئتاءُ",30,"ا",2,0],["كما تعمى البهائمُ حينَ ترعى","عن الشوكِ الكثيرِ لأجلِ عودِ",31,"د",1,0],["كما تدين في الورى تدان","ومن أهان غيره يُهان",32,"ن",1,0],["كَما تَجَلّى البَدرُ مِن دونِهِ","سَحابَةٌ غَرّاءُ ثُمَّ اِحتَجَب",33,"ب",1,0],["كَم أَتَلَقّى المَكروهَ مِنكَ أَما","تَغلَطُ لي مَرَّةً بِمَحبوبِ",34,"ب",1,0],["كما تبرع ذو نعمى بمأكلة","وحثه لقمةً منها الطفيلي",35,"ي",1,0],["كما تحملُ الرّيحُ الشديدةُ نحلةً","فتُبعِدُها عن أجملِ الزهرات",36,"ت",1,0],["كما تُسْمي عِطاشاً أو رِواءً","تُصادِفُها أعاريباً نِهالا",37,"ل",2,0],["كما تَصِفُ الأعضاءَ يوماً غلائلٌ","إذا كان فيها للرياحِ هُبوب",38,"ب",1,0],["كَم أَتلَفَتهُ أَكُفُّكُم","فَجَرى التِلافُ عَلى نِظامِ",39,"م",1,0],["كما تقرَّبتُ بالوصالِ","إليهِ وَيبعُدُ",40,"د",1,0],["كما تفرّ الزّنْجُ من جورِ العرَبْ","بمُخْطَفِ الكشْحَيْنِ من غيرِ سغَبْ",41,"ب",1,0],["كما ترفع غصن البانِ منتصباً","حالاً فحالاً إِذا ما رحت تثنيهِ",42,"ي",2,0],["كما تُنصتُ الأشجارُ وهي سواهمٌ","ومنها الذي ناجى ومنها الذي غنَّى",43,"ن",2,0],["كما تمطَّت بالخُزا","مَى لك أرواحُ السحَرْ",44,"ر",1,0],["كما تَفعَّى أرقمٌ","بالرمل يُذكي اللمحا",45,"ح",2,0],["كما تصنعُ الدُرَّ البحار إذا همى","لأصْدافِها دَرُّ الرَّبيعِ ووابِلُه",46,"ل",2,0],["كما تشكو صَوارِمَهُ المَواضي","كُماةُ الرَّوْعِ والكُومُ العِشارُ",47,"ر",1,0],["كما تشتكي منه لدى كلِّ مأزِقٍ","رقابٌ إذا جَدَّ الوَغى وجَماجمُ",48,"م",1,0],["كما تَتوالى ديمَةٌ بعد ديمَةٍ","فتَرْوى بهنَّ الهامداتُ الدَّواثِرُ",49,"ر",1,0],["كم أتاني منهُ كتابُ ثناهِ","هو نُعمى جلَّتْ عن الإنعامِ",50,"م",1,0],["كَم أَتى دونَ عَهدِ أُمِّ جَميلٍ","مِن إِنى حاجَةٍ وَلُبثٍ طَويلِ",51,"ل",1,0],["كم أتاها من قابِسِ نورَ وصلٍ","فاِصْطَلى دونَ ذاكَ نارَ الصُّدودِ",52,"د",1,0],["كم أتاها مخيَّبٌ ما يُرجّى","فَاِنثَنى بالغاً بها الأوطارا",53,"ر",2,0],["كم أتعب الحب من عاشقْ وكم عنَّى","والصب للحي كم أقلقْ وكم عنَّى",54,"ن",2,1],["كم أتاها قوم على غرةٍ مِنْ","ها وراموا أمراً فعز الوصول",55,"ل",1,0],["كما تلوح لك الأكوان تظهر في","مرآة عين الوجود المنتمي لبقا",56,"ق",2,0],["كَما تُتِمُّ لَيلَةُ البَدرِ القَمَر","لَقَد سَما اِبنُ مَعمَرٍ حينَ اِعتَمَر",57,"ر",1,0],["كَما تَدانى الحِدأُ الأُوِيُّ","رَوائِمٌ لَو تَرأمُ الأُثفِيُّ",58,"ي",1,0],["كم أَتَيْنا لها ورُحنا زمَاناً","وحَيينا بها ومِتْنا مِرَارا",59,"ر",2,0],["كم أتقاضاك مِن مُواصَلتي","ما لَستَ مِن فعله على ذِكرِ",60,"ر",1,0],["كَم أتَمنّاكَ لَو نَفَعنَ أضا","ليلُ المُنَى والمُنَى أضاليلُ",61,"ل",1,0],["كما تشاءين كوني لا مرد لما","تقضين انك عندي لخصم والحكم",62,"م",1,0],["كما تشكى الأرحبي الغرضا","كانما كان شبابي قرضا",63,"ض",2,0],["كما تريد أمة التاميزِ","وليس ذا عليَّ بالعزيزِ",64,"ز",1,0],["كما تُطوى الحنيّاتُ","من الآجرِّ والجصِّ",65,"ص",1,0],["كما تغيَّبْتَ عن عيني فلستَ تُرى","كذا تغيَّبَ عن عيني فليسَ يُرى",66,"ر",2,0],["كما ترى صيرني","قطعي قفار الدّمن",67,"ن",1,1],["كما تمايل أيم جد منهزما","أو مثل ما اهتر غصن البانة الخضل",68,"ل",1,0],["كم أترفَتْ هذى الدُّنا من معشر","فغدوا رِهان ترابها والجندلِ",69,"ل",1,0],["كما تشَائِينَ لا ما شَاءَتِ المِحَنُ","هيهاتِ يا مِصرُ يلوي عُنقَكِ الوَهَنُ",70,"ن",1,1],["كم أتعبَ الخطوُ ما في الأرضِ من طُرُقٍ","فزعى وأنهكَ ما في الأفقِ من أفقِ",71,"ق",1,0],["كما تجمع شمل الدين بالملك السلطان","فالتف بالاحسَان واتفقا",72,"ق",2,0],["كما تجري يد الشيخ","ابن مقرن في عطاياها",73,"ا",3,0],["كما تجلت على الآفاق ساطعة","علوم محمود اذ تتلى وتدكر",74,"ر",1,0],["كما تبين حبي للوصي وصالها","بالشمس إن سامتت قطب السماء خفا",75,"ف",2,0],["كما تدين أيها الانسان","من خير أو شر به تدان",76,"ن",1,0],["كما تَناسَى بنو الإِسلامِ هَمَّهُمُ","بِهَمِّ أَرْوَعَ للأَهْوالِ خَوّاضِ",77,"ض",1,0],["كما ترى في عاشق ونحوه","لكن إذا سلا مثال محوه",78,"ه",1,0],["كما تناولني من قعرِ مظلمةٍ","لم يترك الدهرُ لي في جوفها شذبا",79,"ب",2,0],["كَم أَتَصَدّى لِجَفا صَدِّهِ","وَكَم أُقاسِ قَلبَهُ القاسي",80,"س",2,0],["كما تأبى الصدوع لهم صفاة","يحيط بها فؤوس القارعينا",81,"ن",2,0],["كما تراها بذاك القصر مالكة","قلب المليك بظرف جدّ فتّان",82,"ن",1,0],["كما تخَيَّرْتِ في قذاليَ منها","لم يُرَوِّعْكِ مَفْرِقي وَقَذالي",83,"ل",2,0],["كما تَخَلّلَ برقٌ عُرْضَ ساريةٍ","فلم يَزِدْهُ نَدَاها غيرَ تسعير",84,"ر",1,0],["كَما تُسقى سَباخُ الأَرضِ رِيّاً","وتصرف عن كرائمها السيول",85,"ل",1,0],["كما تدلى الزهر كما تراءى القصر","فيه وحل الكسر بالصنم المجدّل",86,"ل",1,0],["كما ترى الذئب إذا لم يطقُ","صاح فجاءت رسلاً تجرى",87,"ر",2,0],["كما تفعل الريح","بكُثْبِ الرمل في البر",88,"ر",1,0],["كَما تَشَكّى الأَرحَبِيِّ الغَرضا","كَأَنَّما كانَ شَبابي فَرضا",89,"ض",2,0],["كما تعوَّذ منه","به القريبُ لديه",90,"ي",2,0],["كما ترنح عطف المجد إذ سحبت","على أراك المنى بشراً بلابله",91,"ل",2,0],["كَم أتلعت فيَّ الجمال وَأَبطحت","فَحَلالي الأَتلاع وَالابطاح",92,"ح",1,0],["كما ترى حَيَّرني","شرَّدني عن وطني",93,"ي",1,1],["كَما تَوَزَّعَ سُفيانٌ فَرَدَّ يَداً","ثُمَّ اِغتَدى نَحوَ بَيتِ المالِ سَفيانُ",94,"ن",1,0],["كُماتُها مِنكَ صالَت","لَمّا استظلَّ