{"poems":[[55,"أي طود دك من أي جبال","https://www.aldiwan.net/poem29889.html","الرمل"],[64,"النور في العلو له معدن","https://www.aldiwan.net/poem52192.html","السريع"],[47,"في أي حين رأيت مولاتي","https://www.aldiwan.net/poem62656.html","المنسرح"],[50,"وغرير الشباب محتبك الحسن","https://www.aldiwan.net/poem65103.html","الخفيف"],[52,"يا طلل الحي بذات الصمد","https://www.aldiwan.net/poem63943.html","الرجز"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85322","الخفيف"],[102,"عازف الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=50174",""],[9,"معلقة الأعشي","https://www.poetsgate.com/ViewPoem.aspx?id=11407",""],[159,"قفوا ما عليكم من وقوف الركائب","https://www.aldiwan.net/poem55796.html","الطويل"],[415,"يا لائم المشتاق دعه فقلما","https://www.aldiwan.net/poem32437.html","الكامل"],[463,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[469,"يا خليلي تلك أعلام نجد","https://www.aldiwan.net/poem3489.html","عموديه"],[484,"إن كنت مثلي على الأحوال مطلعا","https://www.aldiwan.net/poem37575.html","البسيط"],[949,"","https://poetry.dctabudhabi.ae/diwan/poem/124748","الرجز"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120034","المنسرح"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64920","البسيط"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93125","الرمل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53158","الكامل"],[2462,"","https://poetry.dctabudhabi.ae/diwan/poem/144709","المنسرح"],[2497,"","https://poetry.dctabudhabi.ae/diwan/poem/143744","المنسرح"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100883","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62874","المنسرح"],[3560,"","https://poetry.dctabudhabi.ae/diwan/poem/117156","البسيط"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29273","الخفيف"],[4691,"تلحفتُ حرفَكِ لمّا جرى","https://www.poetsgate.com/ViewPoem.aspx?id=216035",""],[4797,"هجن الرئاسة","https://www.poetsgate.com/ViewPoem.aspx?id=133829",""],[5121,"أنا بك","https://www.poetsgate.com/ViewPoem.aspx?id=37473",""],[5573,"مدية بارضها حقيقها","https://www.poetsgate.com/ViewPoem.aspx?id=200325",""],[5873,"تباريح الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=215466",""],[5956,"سيذكرك ..‏","https://www.poetsgate.com/ViewPoem.aspx?id=182161",""],[5956,"سرُ ليلي وإعراضي","https://www.poetsgate.com/ViewPoem.aspx?id=182306",""]],"verses":[["تُلحِمُ الأَعداءَ مِنهُ جازِراً","يَنقُلُ اللَحمَ إِلى غَيرِ عِيالِ",0,"ل",1,0],["تلحم بالظلمة نوراً وبال","غلظة لطفاً وهي لا تأتلي",1,"ل",2,0],["تَلحَظُني وَالعُيونُ تَلحَظُهّا","قَد شُغِلَت بي عَنِ المُداراةِ",2,"ه",1,0],["تَلحَقُ الظَبيَ وَالظَليمَ مِنَ الجَر","يِ وَتُزري بِكَربَةِ المَغمومِ",3,"م",1,0],["تُلحِمُ أَمراً وَأُموراً تُسدي","وَاِبنُ حَكيمٍ إِذ أَتاكَ يَردي",4,"د",2,0],["تلحق المرء ما تحرك حياً","حادِثاتٌ وَراءَها حادِثات",5,"ت",1,0],["تلحّن حتّى تراب القبور","وتعزف حتّى فراغ الكهوف",6,"ف",1,0],["تلحم أبناء ذي الجدين إن غضبوا","أرماحنا ثم تلقاهم وتعتزل",7,"ل",1,0],["تُلِحُّ علينا بالدُّموع كأَنَّها","لجاجةُ معتوبٍ عَلَى عتب عاتبِ",8,"ب",1,0],["تَلحَى المحبَّ وقلبُه ملآنُ من","حَسَراتِه عَبثاً بقَلبٍ فَارغِ",9,"غ",1,0],["تَلحظهُ الأبصارُ شَزْراً وإن","أكثرَ من أهلٍ ومن مَرحَبِ",10,"ب",1,0],["تلحظ الأفقَ سمرهُ حين تسري","بعيونٍ من الكواكب رمدُ",11,"د",1,0],["تلحينها الذكر حاشا الله يقبله","ما هكذا ربه خير الأنام دعا",12,"ع",2,0],["تلحظنى شزرا بعين الغدر","فقال لطب نفسا فقد زال الألم",13,"م",1,0],["تلحقهم والمدى بعيد","بلا حقات الأقراب شزب",14,"ب",1,0],["تَلْحى أَيْنَ لِسانُ العَذُلِ مِنْ أُذُني","ليْسَ التَّفَرُّغُ لْلعُذّالِ مِنْ شُغُلي",15,"ل",2,0],["تلحق الندب بآفاق السماء","لرأت عيناك منها ما أهال",16,"ل",1,0],["تَلْحَى ولو عاينت من أحببته","لوددتَ في أشراكه أن تعلقا",17,"ق",2,0],["تلحفني كسوة العقوق فلا","برحت منها ما عشت تلتحف",18,"ف",1,0],["تلحسُ فرعَ الدُّخان راقصةً","كألسُنِ البرقِ تلحس المُزُنا",19,"ن",2,0],["تلحُّ مساقط الأنداء فيها","فتنظم فوقها الدُّرُّ الثمينا",20,"ن",2,0],["تُلحسُ آثارُهم كما لُحِسَتْ","آثارُ عادٍ والحيّ من أُدَدِ",21,"د",1,0],["تلحَظَني عابساً قطوباً","كأنّما بي لديكَ ثارُ",22,"ر",1,0],["تَلحَظُ الكَونَ في سُباتِ المَنايا","مِثلَ رُؤيا تَهوي بِهِ وَتَدِفُّ",23,"ف",1,0],["تلحفتُ حرفك لما جرى","فأينع قلبا تشكّى الكرى",24,"ر",2,1],["تلحق اللي توها غصب وتطوف","كنها ظبي خطته البندقية",25,"ي",2,0],["تَلَحَّفْ وَثِيراً وَطَبْطِبْ صَبَاحِي","لِتُشْرِقَ شَمْسِي وَأُصْبِحَ أَجْمَلْ",26,"ل",1,0],["تلحفت بلطفها عنيقها","بسبقها ففحمت سبيقها",27,"ق",3,0],["تلحفت بلطفها عنيقها","ودع فم الحوي من صديقها",27,"ق",3,0],["تلِحُّ عليَّ من دهري صروفٌ","تذيب خطوبها الصخر الجمادا",28,"د",2,0],["تلحّ جميعاً على أن تعودي","لأنّا بمرآك نستبشرُ",29,"ر",1,0],["تُلِحُّ عليّ أشواق ثِقالُ","لغانيتي ويدعوني الوصال",30,"ل",1,1],["تلحّ عليّ أشواقي وأبكي","لأن الليل ما فيهِ مجالُ",30,"ل",1,0]]}