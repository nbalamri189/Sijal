{"poems":[[71,"قال زنار خصره","https://www.aldiwan.net/poem28232.html","مجزوء الخفيف"],[48,"قال زمان الناس في صفوه","https://www.aldiwan.net/poem23357.html","السريع"],[668,"","https://poetry.dctabudhabi.ae/diwan/poem/138996",""],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66638","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204502","الخفيف"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86344","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205677","الرمل"],[4701,"لارا","https://www.poetsgate.com/ViewPoem.aspx?id=176662",""],[669,"لم يزل بالقضيب يعلو ثنايا","https://www.poetsgate.com/ViewPoem.aspx?id=18381",""],[4926,"كيف يحصى عليك منا ثناء","https://www.poetsgate.com/ViewPoem.aspx?id=171114",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[6093,"أجْبَلَ الشعرُ وأكْدى الشاعرُ","https://www.poetsgate.com/ViewPoem.aspx?id=215902",""]],"verses":[["قالَ زنارُ خصرِهِ","كمْ كذا ترجعُ البصرْ",0,"ر",1,1],["قالَ زَمانُ الناسِ في صَفوِهِ","وَرَبُّهُ سَلّاكَ أَو هَيِّما",1,"م",2,1],["قال زبيباً تريدون أم","خمراً فإن الكل مني قريب",2,"ب",1,0],["قال زيدُ ارفعن قضيبَك ارفعْ","عن ثنايا غرٍّ غُذي باتِّقاءِ",3,"ا",2,0],["قال زهر الخدود كم ذا يساوي","لست أدري فقلت كلّ وجودي",4,"د",2,0],["قالَ زُرني جنحَ لَيلٍ","قُلتُ أَخشى صاحِ اهلَك",5,"ك",1,0],["قال: زيدٌ قلت: حاشا فانثنى","نحو عمرٍو قلت: كلا بل فلان",6,"ن",1,0],["قال زارادشت: لارا دميةٌ","لم تصدقْ دمعةٌ ما قال زارا",7,"ر",2,0],["قال زيد ارفعن قضيبك ارفع","عن ثنايا غر غذي باتقاء كذا",8,"ا",1,0],["قال: زوجي تقذَّرتني إذا ما","وجدتني أعمى كذاك النَّساء",9,"ا",2,0],["قال زيتونة مباركة كاد يضي","زيتها بنور صفاها",10,"ا",3,0],["قال : زدني! قلت : لا قدرةَ لي","أجْبَلَ الشِّعرُ وأكْدَى الشاعرُ",11,"ر",1,0]]}