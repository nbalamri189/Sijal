{"poems":[[49,"أتعز أنت على رسوم مغان","https://www.aldiwan.net/poem25112.html","الكامل"],[99,"رسم الحبيبِ الأول","https://www.aldiwan.net/poem24407.html","مجزوء الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54198","الكامل"],[102,"صنعاني يبحث عن صنعاء","https://www.poetsgate.com/ViewPoem.aspx?id=50407",""],[102,"صنعاني يبحث عن صنعاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67683&r=&rc=170",""],[215,"غنى المغنون من حولى فما سمعت","https://www.aldiwan.net/poem46768.html","البسيط"],[234,"يا ذا الذي بكلامه","https://www.aldiwan.net/poem50991.html","مجزوء الكامل"],[275,"طف بالكؤوس وأطلع أنجم الحلك","https://www.aldiwan.net/poem35288.html","البسيط"],[358,"حصنت وجه محمد بسميه","https://www.aldiwan.net/poem39750.html","الكامل"],[449,"بالله يا نسمات الرند والبان","https://www.aldiwan.net/poem55955.html","عموديه"],[473,"يا من يلقب نفسه بالشاعر","https://www.aldiwan.net/poem60105.html","السريع"],[515,"يا من تجنى ظالماً","https://www.aldiwan.net/poem1583.html",""],[556,"هل أنت من وصب الصبابة ناصري","https://www.aldiwan.net/poem47790.html","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38355","الكامل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145859","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64907","الكامل"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82664","البسيط"],[1910,"","https://poetry.dctabudhabi.ae/diwan/poem/116537","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53059","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27825","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77284","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60864","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62992","الكامل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127026","البسيط"],[3574,"","https://poetry.dctabudhabi.ae/diwan/poem/188171","الكامل"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101227","الكامل"],[3740,"","https://poetry.dctabudhabi.ae/diwan/poem/123530","الكامل"],[3763,"","https://poetry.dctabudhabi.ae/diwan/poem/124158","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94627","البسيط"],[2052,"فقن الظباء سوالفاً ونحورا","https://www.poetsgate.com/ViewPoem.aspx?id=201386",""],[5005,"بوح عاشق","https://www.poetsgate.com/ViewPoem.aspx?id=208157",""],[5150,"عشق .. وصد ...!","https://www.poetsgate.com/ViewPoem.aspx?id=203382",""],[5299,"مكابرةُ امرأة","https://www.poetsgate.com/ViewPoem.aspx?id=210536",""],[5410,"رقيب","https://www.poetsgate.com/ViewPoem.aspx?id=109732",""],[5431,"إنّي عشقتك محكومٌ بتأبيدي","https://www.poetsgate.com/ViewPoem.aspx?id=184962",""],[5703,"عمري هواك","https://www.poetsgate.com/ViewPoem.aspx?id=207263",""],[5782,"أوزان وشطآن","https://www.poetsgate.com/ViewPoem.aspx?id=185767",""],[5790,"أصبحت تعطى والأراذل تمنع","https://www.poetsgate.com/ViewPoem.aspx?id=111924",""],[5939,"طوفان لهفة","https://www.poetsgate.com/ViewPoem.aspx?id=178596",""],[5939,"يغار القلب فاتنتي","https://www.poetsgate.com/ViewPoem.aspx?id=185489",""],[5956,"لو مثلاً","https://www.poetsgate.com/ViewPoem.aspx?id=183948",""],[2220,"إني أغار على المولى وصاحبه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11215&r=&rc=89",""]],"verses":[["إِنّي أَغارُ عَلى مَكانِيَ أَن أَرى","فيهِ رِجالاً لا تَسُدُّ مَكاني",0,"ن",2,0],["إني أغارُ من الظلا","مِ وأنتما في معزلِ",1,"ل",1,0],["إِنِّي أَغارُ منَ الْكؤُوسِ فَجنِّبي","كأْسَ الْمُدَامَةِ أَنْ تُقَبِّلَ فاكِ",2,"ك",1,0],["إني أغالي في محبة","موطني ... لم لا أغالي ؟",3,"ل",2,0],["إنّي أغالي في محبة موطني … لم لا أغالي ؟","من أين أرجع … أو أمرّ ..؟ هنا سأبحث عن مجالي",4,"ل",2,0],["إنى أغار فليت الناس ما خلقوا","أو ليتهم خلقوا من غير أجفان",5,"ن",1,0],["إني أغار عليك من","ك فبسّ لفظك بَسَّه",6,"س",2,0],["إني أغارُ على الصَّهباءِ من سُفَلٍ","كأنَّهُم حَولَ نِقلٍ وَسطَ مُعترَك",7,"ك",1,0],["إِنّي أَغار عَلى مَحاسن وَجهِهِ","مِن ناظِريَّ فَكَيفَ باقي الأَعيُنِ",8,"ن",1,0],["اني اغار عليها من صواحبها","والحاسدات ومن أنس ومن جان",9,"ن",1,0],["إِنّي أَغارُ مِنَ العِثارِ عَلَيكَ في","طُرقي لِأَنَّكَ غَيرَ صَلبِ الحافِرِ",10,"ر",1,0],["إنَّي أغار عليك أن","تجني محاسنك العيونُ",11,"ن",1,0],["إِنّي أَغارُ عَلى زَمانٍ بيننا","يمضي بغير تجاورٍ وتحاورِ",12,"ر",1,0],["إِنّي أَغارُ عَلَيه أَعظَمَ غيرةٍ","مِنّي وَمِنهُ وَمِن جَميعِ العالَمِ",13,"م",1,0],["إني أغني وجرحي فيكَ مِزماري","يا موطناً لا يبالي بالدمِ الجاري",14,"ر",2,1],["إِنِّي أَغَارُ إِذا الأَرا","كُ دَنا إِليكَ فقَبَّلَكْ",15,"ك",1,0],["إِنّي اِغتَرَبتُ أُرَجّي أَن أَنال غنى","وَلَم أَكُن أَوّلَ الفِتيان مُغتَرِبا",16,"ب",2,1],["انّي أغارُ عليكم أن تسلكوا","في الودِّ غيرَ طرائق الفتيانِ",17,"ن",1,0],["إني أغار عليه أن أسميه","فيصبح الناس مثلي في محبته",18,"ت",2,0],["إني أغار على المولى وصاحبه","من الحديثِ بشيء لا أسرّ به",19,"ب",2,1],["إِنّي أَغارُ مِنَ الأَقلامِ في يَدِها","يَنظمنَ أَبهى نثار الشُهبِ في نَسَق",20,"ق",1,0],["إني أُغار على ترابِ بلادِهم","من أن يُقَبّلُه الغمام الجائد",21,"د",1,0],["انى اغتنمتُ بيمنهِ","فَوقيتُ أَسبابَ العِثارِ",22,"ر",1,0],["اني أغار على طرس اسوده","بالنظم في وصف حسن البيض والغزل",23,"ل",1,0],["إني أغار من النسيم إذا سرى","بأريج عرفك خيفة من ناشق",24,"ق",1,1],["إني أغار على الصعيد إذا مشت","وأود أن اغدوا مكان صعيدها",25,"د",3,0],["إنِّي أغار على الهوَى","من أن تُؤمِّلَه الأنامْ",26,"م",1,0],["أني أغار على حسن حبيت به","أصابه العين إن العين تختلس",27,"س",1,0],["أنّي أغادر عهداً في محبتكم","وأنت يا مالكي في الحب سلطاني",28,"ن",2,0],["إني أغار من العيون ولا هوى","إلا إذا كان المحب غيورا",29,"ر",2,0],["إني أغارُ إذا تبدَّتْ نجمةٌ","فهمستَ، أن يلْقاكَ منها مَبْسَمُ",30,"م",1,0],["إني أغالبُ في ذكراكِ ذاكرتي","لكنْ جفاؤكِ لا بخلٌ ولا بطرُ",31,"ر",1,0],["إني أُغيرُ بألحاظ تهيم بها","فهل تريدُ سقوطا تحت غاراتِي؟!",32,"ت",2,0],["إنّي اغتسلتُ من الرذائل طائعاً","وطرقت بابك والرجاء خصيبُ",33,"ب",1,0],["إني اغترفتُ من النشوات في شغفٍ","لذاتُ عشقك فيها تمَ تخليدي",34,"د",2,0],["إنّي أَغارُ على جمالكَ أن يُرى","إن العيونَ من المحاسنِ تَنهبُ",35,"ب",1,0],["إني أغوص بعمق أغواري لكي","أجني اكتشاف جديدها الفتّانِ",36,"ن",1,0],["إني أغار على المناصب أن يرى","من لا يليق بها يضر وينفع",37,"ع",1,0],["إنّي أغارُ عليكِ، أنتِ يمامتي","يُرضيكِ أسْرِي لو عذرتِ القلبَ ضَعفَهْ",38,"ف",2,0],["إنّي أغارُ ولا يَعنيكِ في شَغَفي","أنّي أريدُكِ يا أحلَى معاناتي",39,"ت",2,0],["إنّي أغارُ وأنتِ الآنَ قاتلتي","في كلِّ عينٍ رأتْ أَشهَى الجميلاتِ",39,"ت",1,0],["إني أغبطُ كلَّ جماد","لا حِسَّ لديه نَفَّاذا",40,"ذ",2,0],["إني أغار على المولى وصاحبه","من الحديثِ بشيءٍ لا أسرُّ هِ",41,"ه",1,1]]}