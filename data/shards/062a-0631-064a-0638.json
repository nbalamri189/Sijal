{"poems":[[68,"شربنا سلافا بلا آنيه","https://www.aldiwan.net/poem38521.html","المتقارب"],[82,"ونوبية في الخلق منها خلائق","https://www.aldiwan.net/poem31328.html","الطويل"],[46,"أعتبة أجبن الثقلين عتبا","https://www.aldiwan.net/poem30071.html","الوافر"],[71,"ترى ظنني من جلدة الرق عاذلي","https://www.aldiwan.net/poem29094.html","الطويل"],[463,"نديمي وما الناس إلا السكارى","https://www.aldiwan.net/poem56204.html","المتقارب"],[463,"عزفت فما أدرى الفتى كيف يرغب","https://www.aldiwan.net/poem56271.html","الطويل"],[545,"ترى ظلها عند الرواح كأنه","https://www.aldiwan.net/poem56898.html","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64562","الطويل"],[2067,"","https://poetry.dctabudhabi.ae/diwan/poem/157794","الطويل"],[2182,"","https://poetry.dctabudhabi.ae/diwan/poem/203903","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53225","البسيط"]],"verses":[["تَرى ظِلَّها في ال","ضُحى وَالمَقيلِ",0,"ل",1,0],["ترى ظِلْفَ رِجْلٍ يَلتقي إن تنقّلَتْ","بظلفِ يدٍ منها عزيزِ التنقّلِ",1,"ل",1,0],["تَرى ظَفَراً بِكُلِّ صِراعِ قِرنٍ","إِذا ما كُنتَ أَسفَلَ مِنهُ جَنبا",2,"ب",2,0],["ترى ظَنَّني مِنْ جلدةِ الرَّقِّ عاذلي","فلامَ على مَنْ تشتكي رقةَ الجلْد",3,"د",1,1],["ترى ظلَّها جامداً مائعاً","وتحمِلُ ضدَّين ماءً ونارا",4,"ر",2,0],["تَرى ظلَّها في الشمس تحسَبُ أنّه","لأُخرَى سواها لاحقاً أو ستقرُبُ",5,"ب",1,0],["تَرى ظِلَّها عِندَ الرَواحِ كَأَنَّهُ","إِلى دَفِّها رألٌ يَخبُّ جَنيبُ",6,"ب",1,1],["ترى ظلم قومي يا مهيمن جانبي","فجرد عليهم من مواضيك مقصلا",7,"ل",2,0],["ترى ظاهر المأمون أحسن ظاهراً","وأحسن منه ما أسر وأضمرا",8,"ر",2,1],["ترى ظعنهم فيها غداة تحملوا","طوافي فوق الآل مثل السفائن",9,"ن",1,0],["ترى ظُباه على الماذيِّ مسلطة","فخلتها خُلجاً جاورن غدرانا",10,"ن",2,0]]}