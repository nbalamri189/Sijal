{"poems":[[55,"بغير شفيع نال عفو المقادر","https://www.aldiwan.net/poem30465.html","الطويل"],[74,"صحا القلب لولا نسمة تتخطر","https://www.aldiwan.net/poem18693.html","الطويل"],[47,"برق أضاء العقيق من ضرمه","https://www.aldiwan.net/poem65686.html","المنسرح"],[82,"يمضي لك السيف ما تنويه والقلم","https://www.aldiwan.net/poem31288.html","البسيط"],[82,"من شاء أن تسكر راح براح","https://www.aldiwan.net/poem31514.html","السريع"],[71,"فقلت وقد أنكرت منه مقالة","https://www.aldiwan.net/poem29297.html","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16636","البسيط"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/23638","الطويل"],[147,"أما الزمان فقد ألزمته الجددا","https://www.aldiwan.net/poem11751.html","البسيط"],[147,"أما وظلك مما خفته وزر","https://www.aldiwan.net/poem11759.html","البسيط"],[164,"معظم له يدا وكم وكم","https://www.aldiwan.net/poem58664.html","الرجز"],[242,"يا رعى الله ليال قد خلت","https://www.aldiwan.net/poem18804.html","الرمل"],[302,"حسن ابتدائي بذكري جيرة الحرم","https://www.aldiwan.net/poem33180.html","البسيط"],[310,"كل انتظام آيل لانصرام","https://www.aldiwan.net/poem56395.html","السريع"],[445,"أهل بالبين فانهلت مدامعه","https://www.aldiwan.net/poem34880.html","البسيط"],[445,"أضاء لها فجر النهى فنهاها","https://www.aldiwan.net/poem34917.html","الطويل"],[463,"حماها بأطراف الرماح حماتها","https://www.aldiwan.net/poem56261.html","الطويل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126866","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62490","البسيط"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80209","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64662","المتقارب"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49590","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53149","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53239","الرجز"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109395","السريع"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99068","المجتث"],[2556,"","https://poetry.dctabudhabi.ae/diwan/poem/198706","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87328","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202988","السريع"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133262","البسيط"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[4978,"يا من نظرتِ من الشباك للمطر","https://www.poetsgate.com/ViewPoem.aspx?id=177203",""],[5956,"من أجل نقوده تقتله","https://www.poetsgate.com/ViewPoem.aspx?id=182526",""]],"verses":[["مُعَظَّمُ حَيٍّ ما رَمَتهُ هَجيرَةٌ","فَقَعقَعَ في أَعراضِها بِالهَواجِرِ",0,"ر",1,0],["معظّمة المعنى يكرَّر لفظها","فيحلو نباتيّ الكلام المكرَّر",1,"ر",1,0],["مُعَظَّمٌ لَم يَزَل تَواضُعُهُ","لِآمِليهِ يَزيدُ في عِظَمِه",2,"م",2,0],["معظَّمُ الجود في الأملاك لَذّتُهُ","في بذل مالٍ لهم من بذله ألمُ",3,"م",1,0],["مُعَظَّمُ الملك مُقِرٌّ له","بالملك حتى كلّ حيّ لَقَاح",4,"ح",1,0],["معظّمةٌ في الملَّتين بحسنِها","مكرَّمةُ في الدولتين بمالِها",5,"ل",3,0],["مُعَظّماتٌ عليها كَبْوَةٌ عَجَبٌ","تُكْبي المُحارِبَ أوْ تَثْنِيه مَكْبوتا",6,"ت",2,0],["معظِّمُ قدرٍ منك جدِّ مُعظَّمٍ","مُكبِّرُ شأنٍ منك جدِّ كبير",7,"ر",1,0],["مُعَظَّماً قَبلَ تَعظيمِ الإِمامِ لَهُ","وَالسَيفُ يُخشى وَيُرجى سُلَّ أَو غُمِدا",8,"د",2,0],["مُعَظَّمونَ يُطيعُ الناسُ أَمرَهُمُ","وَلا يُطيعونَ لِلأَملاكِ إِن أَمَروا",9,"ر",3,0],["معظم له يداً وكم وكم","عظمها أحمد منزلتي",10,"ت",2,1],["مَعْ ظِبَاءٍ كَلِفَ الْقَلْبُ بِهِمْ","سَمَحُوا بِالْوَصْلِ مِنْ بَعْدِ نِفَارْ",11,"ر",1,0],["معظَّمٌ باِئتلاف المعنيين له","من عفو مقتدرٍ أَو عزِّ منتَقِمِ",12,"م",1,0],["مُعظّماً آلَ نبيّ الهدى","فيهِ لَهم وَذوي الفضلِ اِحترام",13,"م",1,0],["مُعظَّمُ القَدْرِ فِي الأَبصارِ باهِرُهُ","وخافِضُ الطَّرْفِ للرَّحمنِ خاشِعُهُ",14,"ع",2,0],["مُعَظَّمُها مَنْصُورُها وَجَوادُها","وفارسُها يومَ الوغى وفتاها",15,"ا",3,0],["معظَّمةً في حدِّها وسنانِها","وسلطانِها لا ما حوت مَلَكاتُها",16,"ت",3,0],["معظّم طيّبَ الرحمنُ عنصره","آباؤهُ اِشتَهروا بالطيب من قدمِ",17,"م",1,0],["معظم فقلوب الناس ناظرة","لَهُ وأبصارها كلٌّ له خشعا",18,"ع",2,0],["مُعظَّماً كُلّ لَفظٍ سارَ مِن فَمِهِ","تَبَنى عَلَيهِ سِياساتٌ مِن الدُوَلِ",19,"ل",1,0],["مُعَظَّمَةٌ أَنْ تُشيرَ الْبَنانُ","إِلَيها بِأَطْرافِ إِيمائِها",20,"ا",3,0],["مُعَظّمٍ في قَوْمِهِ مُبَجَّلِ","بَهْشٍ إلى الطّعِانِ قَبْلَ القُبَلِ",21,"ل",1,0],["معظمان بالتعظيم خصهما","رب لغير الذي يرضاه ما ألفا",22,"ف",2,0],["معظم السطوة ممنوع الحمى","لا زلت ما دام الزمان باقيا",23,"ي",2,0],["معظم القدر منيع الحمى","له وإلا لا تُحثُّ الركاب",24,"ب",1,0],["معظماً ترتجيه","للنائبات العظام",25,"م",1,0],["معظم تحسر الألحاظ من رهب","عنه، وتلحظه الآمال من رغب",26,"ب",1,1],["مَعَ ظَليمِ المَعقلِ المعروفِ","وَهُم براسِ الحدِّ خَمسٌ تُوفي",27,"ي",1,0],["معظّمي كوني من فيضِه","مصغّري فهمي إياه",28,"ا",2,0],["معظم المقام في الجيران","لكل قاص يرتجى ودان",29,"ن",1,0],["معظم الجاه في حل ومرتحل","منعم البال في بدء ومختتم",30,"م",1,0],["معظما للمدعى عليه","ولم يزل كعبده لديه",31,"ه",1,0],["مع ظلمة الليل منك القلب متصلٌ","عيناك كالغيم تسكابًا بمنهمر",32,"ر",1,0],["معظم عمره يتْمٌ، غَمٌّ","حِرمانٌ، خزيٌ يخبلُهُ",33,"ل",2,0]]}