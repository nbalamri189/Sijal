{"poems":[[74,"ما لمن لام فيكمو من جواب","https://www.aldiwan.net/poem18239.html","الخفيف"],[76,"يا نزهة النفس يا مناها","https://www.aldiwan.net/poem13271.html","مجزوء البسيط"],[108,"في ربا الخلد","https://www.poetsgate.com/ViewPoem.aspx?id=179685",""],[193,"طال شوقي لطيبة الطيبات","https://www.aldiwan.net/poem35171.html","الخفيف"],[214,"يا أهيل الحمى وعرب الفريق","https://www.aldiwan.net/poem13300.html","الخفيف"],[257,"دعني ولا تلحني في دمعي الهتن","https://www.aldiwan.net/poem1423.html",""],[302,"ذكر الخيف والحمى وحجونه","https://www.aldiwan.net/poem33144.html","الخفيف"],[302,"أشذا نعمان أهدته النعامى","https://www.aldiwan.net/poem33177.html","الرمل"],[302,"أي ذنب في هواكم أذنبه","https://www.aldiwan.net/poem33327.html","الرمل"],[591,"حييت يا ربع الحمى بزرود","https://www.aldiwan.net/poem17493.html","الكامل"],[828,"","https://poetry.dctabudhabi.ae/diwan/poem/124037","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59412","الكامل"],[1395,"","https://poetry.dctabudhabi.ae/diwan/poem/124488",""],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95563","الخفيف"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128702","الرمل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123188","البسيط"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177834","الرمل"],[2338,"","https://poetry.dctabudhabi.ae/diwan/poem/111158","الخفيف"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67230","الرمل"],[2406,"","https://poetry.dctabudhabi.ae/diwan/poem/100118","الرمل"],[2444,"","https://poetry.dctabudhabi.ae/diwan/poem/105388","الرمل"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/128237","الخفيف"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110817","السريع"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97890","البسيط"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66351","الرمل"],[3782,"","https://poetry.dctabudhabi.ae/diwan/poem/124271","البسيط"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35528","البسيط"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111057","الخفيف"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94477","البسيط"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136742",""],[5121,"نُزْهَة","https://www.poetsgate.com/ViewPoem.aspx?id=49545",""],[5295,"نَزْفُ رُوحِي","https://www.poetsgate.com/ViewPoem.aspx?id=177297",""],[5431,"يارحمة الله ..لاجنٌ ..ولاعربُ","https://www.poetsgate.com/ViewPoem.aspx?id=187110",""],[5672,"نزيل الفؤاد","https://www.poetsgate.com/ViewPoem.aspx?id=206401",""],[5725,"وقفة على باب ابي الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=177475",""],[5830,"يا وهم مالي ؟!","https://www.poetsgate.com/ViewPoem.aspx?id=201912",""],[6031,"يا نُزُولاً بَينَ أَجْرَاعِ الحِمَى","https://www.poetsgate.com/ViewPoem.aspx?id=46325",""]],"verses":[["يا نزولا على عقاب المصلي","ما سمعنا بجنة في عقاب",0,"ب",1,0],["يا نُزهَةَ النَفسِ يا مُناها","ياقُرَّةَ العَينِ يا كَراها",1,"ا",3,1],["يا نزيل الدُّنيا الجديدةِ، هل عا","ثَ البلى في بُردِ الزّفاف الجديد؟",2,"د",1,0],["يا نُزولاً بِها هنيئاً فقد فز","تُم بِها في حياتِكم والمماتِ",3,"ت",1,0],["يا نزولا بالمنحنى من ضلوعي","هل الى الصبر عنكم من طريق",4,"ق",1,0],["يا نزهة العَين في جدّ وَفي لَعِب","وَمُنية النَفس في سِرِّ وَفي عَلَنِ",5,"ن",1,0],["يا نَزولاً ببطن مكَّةَ عَطفاً","بمحبٍّ أَبَحتُمُ اليومَ هونَه",6,"ن",2,0],["يا نزولَ المُنحنى من أَضلُعي","وَحُلولاً من غَضا قَلب مَقاما",7,"م",2,0],["يا نزولَ الخَيفِ ما ضَرَّكمُ","لَو وَصَلتم من قَطعتُم سَبَبه",8,"ب",2,0],["يا نُزْهَتِي الكُبْرى ومَعُدِن لذَّتِي","ومَحَلَّ أَهْلِ مَوَدَّتِي وعُهُودِي",9,"د",2,0],["يا نزهتي لم صرمى بعد بعثكِ ما","بعَثت بينى وبين الخرّد العين",10,"ن",1,0],["يا نزة الباري وجلت ذاته","عما طرا بمجسم ومعطل",11,"ل",1,0],["يا نزهة العين إن القلب في كمد","لاقاه مِن الحزن ما لاقاك من طرب",12,"ب",1,1],["يا نزيل الجنان كن فى صفاء","ورخاء فللرجال شؤونُ",13,"ن",1,0],["يا نزولا بثنيات اللوى","ليت لا غيّبتمو عن مقلتي",14,"ي",1,0],["يا نزهة الطرف يا سُؤل القلوب لقد","أدهشت وأنعشت صبّاً فيك مسرورا",15,"ر",2,0],["يا نزولاً بين سلع وقبا","جئتكم أسعى على شقة بيني",16,"ن",2,1],["يا نزيف القوام شطط سلوي","في تصابيك فالصدود إلى ما",17,"م",2,0],["يا نُزولاً في سُويداء الحشا","والحشا تشكو من البُعد وقودا",18,"د",2,1],["يا نزولاً بين جمع والمصلى","قتل مثلي في هواكم كيف حلا",19,"ل",2,1],["يا نزولاً بزرود وهموا","بحمى القلب وإن حلوا زرودا",20,"د",2,0],["يا نزولا بذي الأراك إلى كم","تنقضي في فراقكم أعوامي",21,"م",2,0],["يا نزهة السمع سكنت الثرى","فللملاهي أيما لهفي",22,"ي",1,1],["يا نزهة الصيف من فوق الرصيف على","رفقٍ أسير وسحر البحر ممتلكي",23,"ك",2,0],["يا نزولا أرض جمع والصّفا","سقيت أطلالها درّ الطّلال",24,"ل",1,0],["يا نزهتي هل انا والفعل أنت وهل","إن تلق فعلا قريبا لن تفارقه",25,"ق",2,0],["يا نُزهةَ الرَّصدِ الَّتي قَدِ اِشتَمَلَت","مِن كُلِّ شَيءٍ حَلا في جانِبِ الوادي",26,"ي",1,1],["يا نزولاً بسفحه أي عذر","لم تراعوا عهد الهوى والذماما",27,"م",2,0],["يا نزهة الطرف يا سرّ القلوب ومَن","فاقَت أزاهرها ريحاً رياحينا",28,"ن",2,0],["يا نُزهة القلب الشجي","ويا ربيعَ أخي الولوع",29,"ع",1,0],["يَا نُزْهَةً فِي جِنَانِ الأَرْضِ قَدْ حَضَنَتْ","رُوحِي الَّتِي عَانَقَتْهَا حَيْثُ تُغْرِيِهَا",30,"ي",3,0],["يَا نُزْهَتِي الْهَيَّجَتْ مَا نَامَ مِنْ زَمَنٍ","هَلاَّ طَوَيْتِ الرُّؤَى بِالْغَيْمِ تَنْزِيِهَا ؟!!",30,"ي",3,0],["يا نَزفَ رُوحِي كمْ أتوقُ إليهِ","كمْ هامَ قلبي في دُنا عَيْنَيْهِ",31,"ي",2,1],["يانزف عمري في كرب نعايشه","غيومه السود بالآلام تنسكبُ",32,"ب",1,0],["يانزيلَ الفؤادِ أذبلتَ غصناً","كان قبل الغرام غضا نديا",33,"ي",2,1],["يانزف اهلي ماله متدفقا","لاينتهي والحرب طبلاً تقرعُ",34,"ع",1,0],["يَا نَزْفَ أَحْلامِي وَ يَا ذَوْبَ المُنَى","تِلْكُمْ رَزَايَا كَمْ تَهُدُّ المِعْوَلا",35,"ل",2,0],["يا نُزُولاً بَينَ أَجْرَاعِ الحِمَى","بُعْدُكُمْ عَنْ عَينيَ النَّومَ حَمَى",36,"م",2,1]]}