te.com/ViewPoem.aspx?id=207677",""],[5038,"رحيق الورد","https://www.poetsgate.com/ViewPoem.aspx?id=190110",""],[3271,"دمعة وفاء","https://www.poetsgate.com/ViewPoem.aspx?id=104119",""],[5121,"صَبَاحُ الْهَمْسِ","https://www.poetsgate.com/ViewPoem.aspx?id=214145",""],[5183,"الدهر الفظ","https://www.poetsgate.com/ViewPoem.aspx?id=180206",""],[5213,"يا خليلي ان عزمتم رحيلا","https://www.poetsgate.com/ViewPoem.aspx?id=170524",""],[5213,"كلما رمت ان اقيم مكاني","https://www.poetsgate.com/ViewPoem.aspx?id=170545",""],[5213,"انشقاني من ربع مية طيبا","https://www.poetsgate.com/ViewPoem.aspx?id=170409",""],[5302,"موطن العز","https://www.poetsgate.com/ViewPoem.aspx?id=201148",""],[5409,"نال فيك الغرب يا علم المراما","https://www.poetsgate.com/ViewPoem.aspx?id=155311",""],[5461,"شروق الشمس","https://www.poetsgate.com/ViewPoem.aspx?id=9514",""],[5596,"نظرة","https://www.poetsgate.com/ViewPoem.aspx?id=205465",""],[5726,"كلما رابني من الدهرِ ريبٌ","https://www.poetsgate.com/ViewPoem.aspx?id=92332",""],[6031,"سَادَتي إنْ نَأتِ الدَّارُ بِكُمْ","https://www.poetsgate.com/ViewPoem.aspx?id=46372",""],[6093,"حياد الشعر والنثر","https://www.poetsgate.com/ViewPoem.aspx?id=192352",""],[6102,"هذه ليلتي","https://www.poetsgate.com/ViewPoem.aspx?id=182769",""],[199,"كُلَّمَا رَدَّنَا شَطاً عَنْ هَوَاهَا","https://www.poetsgate.com/ViewPoem.aspx?id=14100",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577049",""],[6237,"آذان الفجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77887&r=&rc=29",""],[6237,"وحشة قلب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77896&r=&rc=38",""],[6259,"إعترافي بعظم فضلك فضلُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59392&r=&rc=40",""],[6260,"هل هذا كلام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68329&r=&rc=21",""],[5555,"فِيْ حَضْرَةِ المُتَنَبِّي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87405&r=&rc=1",""]],"verses":[["كُلَّما رَحَّلَتِ اليَومَ فَتىً","نُوَبُ الأَيّامِ زادَتكَ مَقاما",0,"م",2,0],["كُلّما رُمْتُ فِيكَ بَعْضَ سُلُوٍّ","رَجَعَ الشّوْقُ بي علَى الأدْراجِ",1,"ج",1,0],["كلما راموا فساداً","عَزَّهم ذاك المرامُ",2,"م",1,0],["كُلَّما راجَعتُ أَحلامَ الصِبى","قُلتُ يا لَيتَ الصِبى لَم يَزَلِ",3,"ل",1,0],["كلما روّعت بشبهة يأس","جعلتكم معاقل الآمال",4,"ل",1,0],["كُلَّما رَنَّ في المَسارِحِ إِن كُن","تُ اِنثَنى بِالهُتافِ وَالتَهليلِ",5,"ل",1,0],["كُلَّما راحَ أَو غَدا المَوتُ فيها","سَقَطَ السِترُ بِالدُموعِ بَليلا",6,"ل",2,0],["كُلَّما رُوِّعَت بِشُبهَةِ بَأسٍ","جَعَلَتكُم مَعاقِلَ الآمالِ",7,"ل",1,0],["كُلَّما رُمتَ لَونَهُ مَنَعَ النا","ظِرَ مَوجٌ كَأَنَّهُ مِنكَ هازي",8,"ز",2,0],["كُلَّما رامَ حَطَّها اِتَّسَعَ البَن","يُ فَغَطّى جَبينَهُ وَالقَذالا",9,"ل",2,0],["كُلَّما رَحَّبَت بِنا الرَوضُ قُلنا","حَلَبٌ قَصدُنا وَأَنتِ السَبيلُ",10,"ل",1,0],["كُلَّما رُمنا نُمُوّ هِلالٍ","غَيَّبَت بَدراً أَصابَ الكَمالا",11,"ل",2,0],["كلما روعتَ من نارٍ شجٍ","حرما يصلى تلمست جبينه",12,"ه",1,0],["كلَّما رُمْتُ أُنْسَهُم ضَرَبُوا","مِنْ وَحْشَةٍ بينهُمْ وَبَيْنِي بِسُورِ",13,"ر",1,0],["كلّما رامَ نكاحاً","درتُ من حيث يدورُ",14,"ر",1,0],["كُلَّما رَأَى","فُرْصَةً قَدَحْ",15,"ح",1,0],["كُلَّمَا رُمْتُ نَهْضَةً أَقْعَدَتْنِي","وَنْيَةٌ لا تُقِلُّها أَعْصابِي",16,"ب",2,0],["كلما رفّت على","ثغركَ باهي وابتسَم",17,"م",1,0],["كلما رتل نهداك","تراتيل المغيب",18,"ب",1,0],["كُلَّما رُمتُ الأَسى نَكَأ ال","قَرحَ دَهرٌ دَأبُهُ النَكَدُ",19,"د",1,0],["كُلّما رُمْتُ منه يَوْماً خَلاصاً","عَجَزتْ حِيلَتي ورَثَّتْ حِبالي",20,"ل",2,0],["كُلما رامُوا بِسعْدٍ ضَرَراً","صَانَهُ اللَهُ وَكَفَّ الضَرَرَا",21,"ر",2,0],["كُلَّمَا رُمْتُ لَمْحَةً مِنْ سَنَاهُ","هَالَنِي بُعْدُهُ وَطُولُ شِعَابِهْ",22,"ب",2,0],["كُلَّما رُمْتُ خَدْعَ نَفْسِي بنفْسِي","كَشَفَتْ لي المِرْآةُ وَجْهَ الصَّوَابِ",23,"ب",1,0],["كلّما رُمْتَ منه قَطْفَ جَنَاةٍ","سَبقَتْ راحتَيْك ألْفُ جَنَاةِ",24,"ه",1,0],["كلَّما رُمْتُ فيك بعضَ سُلوي","رجع الشَّوقُ بي على الأدراجِ",25,"ج",1,0],["كلّما ردّد المغنّون رقّت","وهفا السامعون للترديد",26,"د",1,0],["كُلَّما رُحت ذاكِراً ذكريّا","عادَ قَلبي مِن الغَرام مَليّا",27,"ي",2,1],["كلما رمت سلوة نذهب الحر","قة زادت قلبي عليك احتراقاً",28,"ق",2,0],["كلما رمتُ للدموع جمودا","جمت العينُ بالدموع جُمومَا",29,"م",2,0],["كَلَّمَا رُمتُ عَن هَواهَا إرعِوَاءً","حَمَّلَتني مَا لَم تُحَمِّل أرِيمَا",30,"م",2,0],["كُلَّمَا رَامَ مِن بَغِىٍّ وِصَالاً","مَنَعَتهُ مَخَافَةَ التَّشِنِيعِ",31,"ع",1,0],["كلّما رنَّح النسيمُ فروعَ ال","بان هزَّت أطافَها بالعُجبِ",32,"ب",1,0],["كُلَّما رُمتُ مِن صِفاتِكَ صِنفاً","أَخَذَت بي عُلاكَ في أَصنافِ",33,"ف",1,0],["كلما رمت شرح حالي إليكم","حرت بي الوقوف والإِقدام",34,"م",1,0],["كلما رمت توقي","ه فرارا لم أوقا",35,"ق",2,0],["كلما رمت مهربا من ثقيل","كان مني كلبستي من إهابي",36,"ب",2,0],["كُلَّما رَدَّنا شَطاً عَن هَواها","شَطَنَت ذاتُ ميعَةٍ حَقباءُ",37,"ا",2,0],["كُلَّما رُمتُ دُخولاً","دَفعَ الكِشخانُ صَدري",38,"ر",2,0],["كُلَّما رُمتُ جَنى وَجنَتِهِ","حَجَبَتني عَقرَبُ الصُّدغِ اللَّدوغ",39,"غ",1,0],["كلما راجعت صحائف ماضيها","وعمراً بالعز والطهر مرّا",40,"ر",2,0],["كلَّما رمتُ رشفَةً من لماه","صدَّ عنّي وسامَني بالمِحالِ",41,"ل",1,0],["كلمّا رفرف النسيمُ عليه","ظنّ فيه تنهّدات الرياح",42,"ح",1,0],["كلما راود جفنيه الكرى","أشفقت من سفر فيه مديد",43,"د",1,0],["كلما ردت خاطري","هجت في السر والعلن",44,"ن",1,0],["كلما رمت من عذابي نجاءً","سار نحوي ميماً وتقدم",45,"م",1,0],["كلما رمت أن أبوح بشيء","اذهلتني في أمرهم أشياء",46,"ا",2,0],["كُلَّما رُضْتهُ بِشِعْرِي نَادَى","أَنا مَالي والشِّعْرُ إبنُ الشّعِيرُ",47,"ر",1,0],["كُلّما رامَ منه للرّأسِ رَفْعاً","زادَ خَفْضاً كأنّه نارُ شَمْعه",48,"ع",2,0],["كُلَّما رقَّ ماءُ وَجهي تَلَقى","وَجهَ حالي مِنه بِوَجهٍ صَفيقِ",49,"ق",1,0],["كلَّما رُمتُ أن أناديكَ حَسبي","من أياديكَ أو أقوم بشكرِك",50,"ك",1,1],["كلّما رمْتُ مراماً","صدّني عمّا أرومُ",51,"م",1,0],["كلما رُمت وصف قدرك أَلفيت","صِفاتي تَدنو وَقدرك يَعلو",52,"ل",2,0],["كُلَّمَا رامَ نهوضاً حَصَّهُ","قَوْلُ زُغْبٍ عندَهُ لا تَرمِ",53,"م",1,0],["كلما رمت عرض حالي لديها","زاد منها الإعراض عن مضناها",54,"ا",3,0],["كلّما راجعتَه مجتدياً","أحمدَ الروضَ الرّبابُ المتوالي",55,"ل",2,0],["كُلَّما رَمَت مِن يَدَيهِ خَلاصاً","سَدَّ حُبّي لَهُ عَلَيَّ سَبيلي",56,"ل",2,0],["كلَّما رَدَّدَ شعري منشدٌ","في نديًّ عَلَّمَ النوحَ الحماما",57,"م",2,0],["كلما رمت سلمه رام حربي","ما لهذا الوضيع قولوا ومالي",58,"ل",2,1],["كلَّما رُمتُ سُلُوًّا","قال لي قَدُّكَ لا لا",59,"ل",2,0],["كلما رؤية الحبيب أردنا","جاءنا الصعق مثل موسى الكليم",60,"م",1,0],["كُلما رقعت منه جانباً","حرّكته الريح وهناً فانخرق",61,"ق",1,0],["كُلما رُمتُ نَهضةً قال مهلاً","لا تَقِس أوَّلاً قِياسَ الثَواني",62,"ن",2,0],["كُلّما رامني يحُصُّ جَناحي","راشَ بالمكرُماتِ مِنّي جَناحا",63,"ح",2,0],["كُلَّما رَوَّيتُ في صُورَتِهِ","فِكرةً زادَ جَلالاً في جَلالِ",64,"ل",1,0],["كُلَّما رُمتَ أن يَكُونُوا صُدُورا","جَعلَتهُم نفوسُهُم أعجازا",65,"ز",2,0],["كلَّما رامَ سُلوةً صاحَهُ الحُبُّ","وسُلطانُه الحَذارَ الحَذارا",66,"ر",2,0],["كلما رمت فرصة","لسعت عقرب يدي",67,"ي",1,0],["كلّما رُمتُ مبيتاً عندها","طلبتْ مني صعودَ المربأهْ",68,"ا",2,0],["كلّما راحت الرِّياحُ تَمشّى","بينَ زاهٍ من نبتهِ وزهيِّ",69,"ي",1,0],["كلَّما رام للنساءِ وداعاً","كامَشُوهُ دونَ الوَداع كِماشا",70,"ش",2,0],["كلما رامتِ القيام لمشْىٍ","أقعدتْها رزانةُ الأرداف",71,"ف",1,0],["كلما رمت السلوك له","ردني وجد برمته",72,"ت",2,0],["كلما راعها الزمانُ، وهزت","جانبيها العواصف الهوجاءُ",73,"ا",2,0],["كُلما رمت أسلي النفس عَم","ما دهاها اِنطَبَقت أَي اِنطِباق",74,"ق",1,0],["كلما رمت سلوة من زماني","في زماني لقيت كرباً شديدا",75,"د",2,0],["كلما رمت أسلي كبدي","هيجت وجدي يتاماك الظماء",76,"ا",2,0],["كُلَّما رُمت لُقاه أَعرَضا","وَاِنثَنى عَني بِطَرف وَسَني",77,"ي",1,0],["كلما راء لمعها مجرمٌ خا","م ولو كان في الوغى رئبالا",78,"ل",2,0],["كلما رام من هواه خلاصاً","وجد الوجد خلفه وأمامه",79,"م",2,0],["كُلَّما رُمتُ عن هواها سُلوا","عادَني ذِكرُها بشَوقٍ علوقِ",80,"ق",1,0],["كلما رمت المقام بها","قلت ان العز في النقل",81,"ل",1,0],["كلما راشت شبا ألحاظها","ذابت الأكباد في ذاك الشبا",82,"ب",2,0],["كلما رنحت لهم عطفها","هاجوا ارتياحاً وازعجوا الأوتارا",83,"ر",2,0],["كلَّما رُمْتُ وِصالاً ما طَلَتْ","ما لَهَا لوْ وَاصَلَتْني مَا لَهَا",84,"ه",2,0],["كُلَّما رامَ مَطلَباً يَسَّرَ الل","ه لَهُ ما يَرُومُهُ مِن مَرامِه",85,"م",2,0],["كلما رمت بأن أعلمه","سرّ شوقي قال دع ما كلما",86,"م",2,0],["كلَّما راقب نجماً","فهوى راقب نجما",87,"م",2,0],["كلما رُمتُ عناقاً قال لي","فيه إثم قلت ذا في عُنقي",88,"ق",2,0],["كلما رمت وصالا","قطبت لي حاجبيها",89,"ي",3,0],["كلما رنح القضيب على الحق","ف بدا البدر منه تحت الظلام",90,"م",1,0],["كلما رنحت شمائلَها الشمالُ ل","جّ الحمام في التغريد",91,"د",1,0],["كلما رُمتُ انفكاكا","لم أزل في عثراتي",92,"ت",2,0],["كلما رمت به ختم الثنا","قال لي عوداً له فالعود أحمد",93,"د",1,0],["كُلُّ ما رامَ أَن يَطيرَ وَلا شَو","كَةً فيهِ تَخَطَّفَتهُ النُسورُ",94,"ر",1,0],["كلّما رامَ أن يُدانى توارى","يَفعَلُ الخيرَ ثم يلقاهُ شرّاً",95,"ر",2,0],["كُلَّما رامَ اِنطِباقاً","أَو حبس الشَوك فَعادا",96,"د",2,0],["كلّما رشنا لها أجنحةً","من قلاع ظلت منها تعجبُ",97,"ب",1,0],["كلَّما رُمتُ سَلوةً عن هواهُ","جاءَناهٍ من حسنِهِ مَقبولُ",98,"ل",1,1],["كُلَما رُمتُ قُربَهُ قَد تَناءى","وَاحتفاءً بِهِ بَدا مِنهُ حَيفُ",99,"ف",1,0],["كُلَّما رُمنا الحَياةَ قِسمَةً","نَهَبوا قوتَ المُقِّلِ المُعدِمِ",100,"م",1,0],["كلما رمت فيه كتمان وجدي","أظهر الدمع والضنى مكتومي",101,"م",2,0],["كلما رابني الزمان تلمّس","ت عزائي في قلبك الحنّان",102,"ن",1,0],["كلَّما رحتُ أستميح حبيباً","ودَّه جاد لي بضدِّ مرادي",103,"د",2,0],["كلَّما رمت قربه أخذت بي","شيمةٌ منه تقتضيه بعادي",103,"د",2,0],["كلما رمت اسلي كبدي","هيجت وجدي يتاماك الظما",104,"م",2,0],["كلما رمت أن أغني لحناً","صد عنه قلبي وأعرض عني",105,"ن",2,0],["كلّما رمتُ أتّى","أكتم الحب أعلنا",106,"ن",2,0],["كلما رمت لذة أو سروراً","قذفت بي في داجيات الشرور",107,"ر",1,0],["كُلَّمَا رُمْتُ تَقَاضِي وَصْلِكُمْ","وَقَفَ الإِجْلاَلُ بِي دُونَ وُرُودِ",108,"د",1,0],["كلّما روحي احتَسسَتها","خَطَرَ الشّعرُ لِبالي",109,"ل",2,0],["كلّما روّعتْهُ شمسُ ضُحاها","بغُروبٍ للدّمْعِ منّي غُروبُ",110,"ب",1,0],["كلما رمت أن ابثك شكوا","تلجلجت هيبة واحتراما",111,"م",2,0],["كلما رمت سلوا عنهم","لا تريم النفس عن أشجانها",112,"ن",3,0],["كلما رمت هجرها واصلتني","واذا رمت وصلها تتأبى",113,"ب",2,0],["كلما راق لعي