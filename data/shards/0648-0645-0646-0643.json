يل بقائها","https://www.aldiwan.net/poem10315.html","الطويل"],[49,"هو الموت فاصنع كلما أنت صانع","https://www.aldiwan.net/poem62154.html","الطويل"],[49,"لمن طلل أسائله","https://www.aldiwan.net/poem63087.html","مجزوء الوافر"],[80,"يد الدهر جارحة آسيه","https://www.aldiwan.net/poem31251.html","المتقارب"],[80,"ومشرعة بالموت للطعن صعدة","https://www.aldiwan.net/poem31547.html","الطويل"],[80,"فؤادي نجيب والجلال نجيب","https://www.aldiwan.net/poem31549.html","الطويل"],[44,"عسى وطن يدنو بهم ولعلما","https://www.aldiwan.net/poem30356.html","الطويل"],[44,"تجرع أسى قد أقفر الجرع الفرد","https://www.aldiwan.net/poem30542.html","الطويل"],[69,"أراك على ما فيك تبلغني الأذى","https://www.aldiwan.net/poem28425.html","الطويل"],[90,"شممت تربك لا زلفى ولا ملقا","https://www.aldiwan.net/poem60156.html","عموديه"],[31,"كفى حزنا أن تجمع الدار شملنا","https://www.aldiwan.net/poem41319.html","الطويل"],[31,"ومن كان محزونا بإهراق عبرة","https://www.aldiwan.net/poem42560.html","الطويل"],[105,"هل الحرب إلا أن تطير الجماجم","https://www.aldiwan.net/poem43156.html","الطويل"],[81,"تجلى شهاب للسعادة آفل","https://www.aldiwan.net/poem61333.html","الطويل"],[52,"أشهى من القهوة والكاس","https://www.aldiwan.net/poem26896.html","السريع"],[67,"إلهي على كل الأمور لك الحمد","https://www.aldiwan.net/poem18053.html","الطويل"],[48,"أيا من كنت بالبصرة","https://www.aldiwan.net/poem62609.html","الهزج"],[48,"وجه بنان كأنه قمر","https://www.aldiwan.net/poem66152.html","المنسرح"],[50,"لعمري لقد هذبت قولي ولم أدع","https://www.aldiwan.net/poem63961.html","الطويل"],[46,"إذا كان علم الناس ليس بنافع","https://www.aldiwan.net/poem22025.html","الطويل"],[46,"لقد صدئت أفهام قوم فهل لها","https://www.aldiwan.net/poem23200.html","الطويل"],[76,"هلال نماه المجد واختاره الفخر","https://www.aldiwan.net/poem39316.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85285","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85526","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85599","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39662","الطويل"],[32,"","https://poetry.dctabudhabi.ae/diwan/poem/8237","الطويل"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72199","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16630","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42566","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54911","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54747","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43912","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54241","الطويل"],[106,"حنين إلى الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=179322",""],[43,"ارى ذلك القرب صار ازورارا","https://www.poetsgate.com/ViewPoem.aspx?id=146",""],[58,"وَلَمَّا رَأَيْتُ الخَيْلَ تُقْرَعُ بالقَنَا","https://www.poetsgate.com/ViewPoem.aspx?id=22814",""],[58,"ومن كرمت طبائعه تحلى","https://www.poetsgate.com/ViewPoem.aspx?id=22733",""],[90,"صحو بعد سكر","https://www.poetsgate.com/ViewPoem.aspx?id=178933",""],[90,"دمشق.. يا جبهة المجد","https://www.poetsgate.com/ViewPoem.aspx?id=62109",""],[34,"فإن يحجبوها، أو يَحُل دونَ وصلها","https://www.poetsgate.com/ViewPoem.aspx?id=22467",""]],"verses":[["وَمَن كانَ إِنعامُ الوَزيرِ حَبيبَهُ","أَغارَ الغَواني بَينَ بِكرٍ وَأَيّمِ",0,"م",1,0],["وَمَن كانَ يَلقاكَ مُستَسلِماً","فَإِنّي أُلاقيكَ مُستَلئِما",1,"م",2,0],["وَمِنكَ تَوَلَّتِ الأَنواءُ رَيّي","وَطَبَّقَ أَرضِيَ الكَلَأُ العَميمُ",2,"م",1,0],["وَمَن كانَ مَهجوراً كَما أَنا فيكُمُ","فَما يَستَحي الأَيّامَ أَن تَتَبَدَّلا",3,"ل",2,0],["وَمَن كانَ يَرمي عَن تَقَدُّمِ باعِهِ","يُصِب سَهمُهُ أَغراضَهُ وَيَؤولُ",4,"ل",1,0],["وَمَن كُنَّ يَهوينَ خَلفَ الرِجاءِ","فَأَمسَينَ مِن جودِهِ في قَرارِ",5,"ر",1,0],["وَمَن كانَ ما فَوقَ النُجومِ طِلابُه","أَمَلَّ عَناءٌ قَلبَهُ وَدُؤوبُ",6,"ب",1,0],["وَمَن كانَ في شُغلِ المُنى فَفَراغُهُ","مَنالُ الأَماني أَو رَدىً وَشَعوبُ",6,"ب",1,0],["وَمَن كانَتِ الأَيّامُ ظَهراً لِرَحلِهِ","فَيا قُربَ ما بَينَ المَدى وَالرَكائِبِ",7,"ب",1,0],["وَمَن كانَ ذا نَفسٍ تُطيعُ قَنوعَةً","رَضي بِقَليلٍ مِن كَثيرِ ثَراءِ",8,"ا",2,0],["وَمَنْ كانَ مَغْمورَ النِّجارِ فَإِنَّني","مِنَ الشَّرَفِ الوضَّاحِ قُدَّ أَديمي",9,"م",2,0],["ومَنْ كقَوْمي وهمُ منْ يَعْرُبٍ","ومِنْ نِزارِ بنِ مَعَدّ في الذُّرا",10,"ا",1,0],["ومَنْ كان عَفّاً في هَواكِ ضَميرُهُ","فسِيّانِ هَجْرٌ عندَهُ ووصالُ",11,"ل",1,0],["ومِنكُمْ عَهِدْنا الوِرْدَ زُرْقاً جُمامُهُ","رَحيبَ مندىً العيسِ والرّوضَ مُمْرِعا",12,"ع",2,0],["ومَنْ كَحُيَيٍّ أو كَجِلْدٍ ومَرْثَدٍ","ورَيّانَ والآفاقُ شاحِبةٌ غُبْرُ",13,"ر",1,0],["ومَن كَدُبَيْسٍ حينَ تُفْتَرَشُ القَنا","إذا النَّقْعُ لَيلٌ والظُّبَى أنجُمٌ زُهرُ",13,"ر",1,0],["ومَن كعُثمانَ جُوداً والسّماحُ لهُ","عِبءٌ على كاهِلِ العَلياءِ مَحمولُ",14,"ل",1,0],["ومَنْ كأبِيهِ عبْدِ اللّهِ رأياً","إذا ما المُعْضِلُ انْطَبَقَ انْطِباقا",15,"ق",2,0],["ومَنْ كَفاهُ افْتِخاراً","نِزاعُ يوْمِ السّقيفَةْ",16,"ف",2,0],["وَمَنْ كيُوسُفَ فِي الأَمْلاَكِ مِنْ مَلكٍ","بِالْحِلْمِ مُتَّسِمٍ بالْحَزْمِ مُحْتَزِمِ",17,"م",1,0],["ومنْ كأبي الحَجّاجِ حامي حِمى الهُدى","ومَنْ كأبي الحجّاجِ ماحي دُجى الكُفْرِ",18,"ر",1,0],["ومَنْ كان بالدّنْيا الدنيّةِ واثِقاً","على حالَةٍ يوْماً فقدْ باءَ بالخُسْرِ",18,"ر",1,0],["وَمَنْ كَأَبِي بَكْرٍ عَمِيداً مُؤَمَّلاً","خُلاَصَةَ شِعْبِ الْعِلْمِ نَاهِيكَ مِنْ شِعْبِ",19,"ب",1,0],["وَمِنْ كَرَامَتِهَا أَنَّ الشَّمَالَ إِذَا","رَامَتْ زِيَارَتَهَا تَمْشي عَلَى المَاءِ",20,"ا",2,0],["وَمَنكوحَةٍ غَيرِ مَمهورَةٍ","وَأُخرى يُقالُ لَهُ فادِها",21,"د",3,0],["وَمَن كانَ يُنسيهِ إِثراؤُهُ","صَديقَ الخَصاصَةِ لا يُصطَفى",22,"ا",1,0],["وَمَن كانَ في بَيتِ المُلوكِ ثَواؤُهُ","يُنَشَّأُ عَلى النُعمى وَيَمرَح وَيَرتَعِ",23,"ع",1,0],["وَمَنُّكَ صَفوٌ لا يُشابُ بِمِنَّةٍ","وَمَدحُكَ صِدقٌ لا يُعابُ بِمَينِ",24,"ن",1,0],["ومن كحبيب عادل الخلق صادقٌ","له فعل ما يرجى وليس له وعد",25,"د",1,0],["ومنكنّ أحببت هاتي وذي","وألفَيت عذباَ بكنّ العذاب",26,"ب",1,0],["ومنكنّ حمراء جذّابةْ","حكى وجهها الشمس عند الطلوع",26,"ع",1,0],["ومنكنّ صفراء في لونها","كأن قد تردّت شعاع الأصيل",26,"ل",1,0],["ومنكنّ سمراء تحكي الدمى","وتبعث في القلب مَيت الهوى",26,"ه",3,0],["ومنكنّ من هي مثل الرياح","لها في ذرى كل قلب هبوب",26,"ب",1,0],["ومنكنّ من هي مثل النجوم","من البعد ناظرةً تبتسم",26,"م",1,0],["ومَن كان مثلي شاعراً لا تَسُوءُه","مقاذعةٌ جاءته من متشاعر",27,"ر",1,0],["وَمَن كانَ أَهلَ الجودِ وَالحَزمِ وَالنَدى","عُبَيدَةُ وَالحامي لَدى كُلِّ مَحجَرِ",28,"ر",1,0],["وَمِنكِرَةٌ ماعايَنَت مِن شُحوبِهِ","وَلا عَجَبٌ ما عايَنَتهُ وَلا نُكرُ",29,"ر",1,0],["وَمِن كُلِّ دَمعٍ في جُفوني سَحابَةٌ","وَمِن كُلِّ وَجدٍ في حَشايَ لَهيبُ",30,"ب",1,0],["وَمَن كانَ غَيرَ السَيفِ كافِلُ رِزقِهِ","فَلِلذِلِّ مِنهُ لامَحالَةَ جانِبُ",31,"ب",1,0],["وَمِنكُم شاهِدٌ وَلَقَد رَآني","رُفِعتُ لَهُ كَما اِحتُمِلَ الصَبِيُّ",32,"ي",1,0],["ومن كانَ مثلي واثقاً بولائه","فيا ليت شعري ما يحاول شعره",33,"ر",2,0],["ومن كانَ يرجى منه في المدحِ أجرة","فإني أرجو في مدائحِكَ الأجرا",34,"ر",2,0],["ومن كانَ في غيظهِ محسناً","فكيفَ يكون إذا ما رضي",35,"ي",1,0],["ومن كلّ يومٍ في هواها متيمٌ","يموت ولوَّامٌ عليه تنازع",36,"ع",1,0],["ومن كان فرداً في عظيم غَنائهِ","عن الملك لم يَصغُرْ صغيرُ أداتِهِ",37,"ت",2,0],["ومنكم أبو العباس ذاك الذي لهُ","تقاصَرُ في أبدانها القَصَراتُ",38,"ت",1,0],["ومنكم أبُو عيسى الذي بَاكَرَ العُلا","ولم يُلْهِهِ عَيْشٌ رَفِيهٌ ولا دَدُ",39,"د",1,0],["ومن كانَ يَسْتهدِي حَبِيباً هَدِيَّةً","فَطَيْفُ خيَال منك في النوم أسْتَهدي",40,"ي",1,0],["ومن كان في أن يمنع الحقّ شاعراً","فإني في أنْ أبذلَ اللَّوم أشْعَر",41,"ر",1,0],["ومن كَثُرَتْ نِعمةٌ عندهُ","عليه أقرّت وإن لم يُقِر",42,"ر",1,0],["ومنكم عبيدُ اللَه فُتُّم بسعيه","ذوي السعي فوتاً بائصاً أيَّ بائِص",43,"ص",1,0],["ومن كثُرتْ في ماله شركاؤهُ","غدا في معاليه قليلَ المُشارك",44,"ك",1,0],["ومن كان في عيشٍ يراعي زواله","فذلك في بؤسٍ وإن كان في نُعمِ",45,"م",1,0],["ومَنْ كفَّ مِنْ زَمن عارمٍ","تسلَّمَ مِنْ زمَنٍ عارمِ",46,"م",1,0],["ومُنكرةٌ تظنُّ الحبَّ لِعْباً","وقد قعدَ الهوى فيها وقاما",47,"م",2,0],["ومن كان وُدُّك لا للجَدَا","ولكن لنفسك حقاً يقينا",48,"ن",2,0],["وَمَن كانَ لَهُ إِلفٌ","وَمَن كانَ بِلا إِلفِ",49,"ف",1,0],["وَمَن كانَتا عَيناهُ حَشوَ ضَميرِهِ","فَلَيسَ بِمُحتاجٍ إِلى أَن يُذَكَّرا",50,"ر",2,0],["ومَنْ كانَ جبَّارَ المطامِعِ لم يَزَلْ","يلاقي من الدُّنيا ضَراوَةَ قَشْعَمِ",51,"م",1,0],["وَمِن كُرَبٍ لِلحُبِّ في باطِنِ الحَشا","وَلَيلٍ طَويلِ الحُزنِ غَيرِ قَصيرِ",52,"ر",1,0],["ومن كان ذالب فليس بمقدم","على جلل حتى يفكر تفكيرا",53,"ر",2,0],["ومن كواكب حسن","ومن شموس جمال",54,"ل",1,0],["ومن كان ثروته عقله","يبيع الجواهر بيع الخزف",55,"ف",1,0],["وَمَن كانَ يَغزو بِالتَعِلّاتِ فَقرَهُ","فَإِنّي وَجَدتُ الكَدَّ أَقتَلَ لِلفَقرِ",56,"ر",1,0],["وَمِن كَرَمٍ أَذَلّوا كُلَّ عاتي","وَذَلّوا في قِتالِ المُؤمِنينا",57,"ا",1,0],["وَمَن كانَ مِثلي أَحمَدَ الوَقتِ لَم تَجُز","عَلَيهِ وَلَو مِن مِثلِكَ الصَدَقاتُ",58,"ت",1,0],["وَمَن كانَ مَنسوباً إِلى دَولَةِ القَنا","فَلَيسَ إِلى شَيءٍ سِوى العِزِّ يُنسَبُ",59,"ب",1,0],["ومَنْ كَعليٍ فَدَى المُصْطَفَى","بِنَفْسٍ ونامَ فما يَحْفِلُ",60,"ل",1,0],["ومَنْ كعليٍّ إذا ما دَعَوا","نَزالِ وقدْ قَلَّ مَنْ يَنْزل",60,"ل",1,0],["وَمَن كُنتَ بَحراً لَهُ يا عَلِيُّ","لَم يَقبَلِ الدُرَّ إِلّا كِبارا",61,"ر",2,0],["وَمَن كُلَّما جَرَّدتَها مِن ثِيابِها","كَساها ثِياباً غَيرَها الشَعَرُ الوَحفُ",62,"ف",1,0],["وَمِن كَثرَةِ الأَخبارِ عَن مَكرُماتِهِ","يَمُرُّ لَهُ صِنفٌ وَيَأتي لَهُ صِنفُ",62,"ف",1,0],["وَمَن كانَ ذا نَفسٍ كَنَفسِكَ حُرَّةٍ","فَفيهِ لَها مُغنٍ وَفيها لَهُ مُسلي",63,"ل",2,0],["ومَن كان عزمي بين جنَبيهِ حثَّهُ","وخيَّلَ طول الأرضِ في عينه شِبرا",64,"ر",2,0],["وَمَن كانَ في اِستِسلامِهِ لائِماً لَهُ","فَإِنّي عَلى ماكانَ مِن ذاكَ عاذِرُه",65,"ر",2,0],["وَمِن كَمَدٍ أَسرَرتُهُ فَأَذاعَهُ","تَرادُفُ دَمعٍ مُسهِبٍ في اِنهِمالِهِ",66,"ل",2,0],["وَمَن كَأَبي عُمارَةَ في نَداهُ","وَبارِعُ فَضلِهِ أَزكى دَليلِ",67,"ل",1,0],["وَمَن كَأَنَّ القَضيبَ قامَتُهُ","وَالبَدرَ يَحكي ضِياءَهُ سُنَنُه",68,"ن",2,0],["وَمَن كَرُمَت طِبائِعُهُ تَحَلّى","بِآدابٍ مُفَصَلَةٍ حِسانِ",69,"ن",1,1],["وَمِن كُلِّ حَيٍّ أَتَتني فَوارِسٌ","ذوُو نَجَداتٍ في اللِقاءِ كِرامِ",70,"م",1,0],["وَمَن كانَ غَلّاباً بِعَقلٍ وَنَجدَةٍ","فَذو الجَدِّ في أَمرِ المَعيشَةِ غالِبُه",71,"ب",2,0],["وَمَن كَلَّفَتهُ النَفسُ فَوقَ كَفافِها","فَما يَنقَضي حَتّى المَماتِ عَناؤُها",72,"ا",3,0],["وَمَن كانَتِ الدُنيا هَواهُ وَهَمَّهُ","سَبَتهُ المُنى وَاستَعبَدَتهُ المَطامِعُ",73,"ع",1,0],["وَمَن كُنّا نُتاجِرُهُ","وَمَن كُنّا نُعامِلُهُ",74,"ل",2,0],["وَمَن كُنّا نُعاشِرُهُ","وَمَن كُنّا نُداخِلُهُ",74,"ل",2,0],["وَمَن كُنّا نُفاخِرُهُ","وَمَن كُنّا نُطاوِلُهُ",74,"ل",2,0],["وَمَن كُنّا نُشارِبُهُ","وَمَن كُنّا نُؤاكِلُهُ",74,"ل",2,0],["وَمَن كُنّا نُرافِقُهُ","وَمَن كُنّا نُنازِلُهُ",74,"ل",2,0],["وَمَن كُنّا نُكارِمُهُ","وَمَن كُنّا نُجامِلُهُ",74,"ل",2,0],["وَمَن كُنّا لَهُ إِلفاً","قَليلاً ما نُزايِلُهُ",74,"ل",2,0],["وَمَن كُنّا بِلا مَينٍ","أَحايِيناً نُواصِلُهُ",74,"ل",2,0],["ومن كَرَمٍ في العُلى أوّل","وشمسُ النّهارِ لهُ ثانيَه",75,"ي",2,0],["ومن كلّ قطر يتّقي شرّها كما","تذاءب في جنح الدجنة ذيبها",76,"ب",3,0],["ومنكرةٍ مني زماعاً عرفتهُ","عدوّكِ يا هذي إليّ حبيبُ",77,"ب",1,0],["وَمَن كانَ بِالبيضِ الكَواعِبِ مُغرَماً","فَمازِلتَ بِالبيضِ القَواضِبِ مُغرَما",78,"م",2,0],["وَمَن كانَ ذا بَثٍّ عَلى النَأيِ طارِفٍ","فَلي أَبَداً مِن صَرفِهِ حُرَقٌ تُلدُ",79,"د",1,0],["ومَنْ كانَ حالُ الشمسِ والبدرِ عندَهُ","كذاكَ فَمَنْ عاداهُ غيرُ رشيدِ",80,"د",1,0],["ومِن كُوىً خَفِراتٍ نَسْتَجِدُّ رُؤىً","نَشْوانَةً عَن رُؤىً مَمْلولَةٍ نَسَقا",81,"ق",2,0],["وَمَن كانَ لا يَعدو هَواهُ لِسانُهُ","فَقَد حَلَّ في قَلبي هَواكِ وَخَيَّما",82,"م",2,0],["وَمَن كانَ مَحزوناً بِإِهراقِ عَبرَةٍ","وَهى غَربُها فَليَأتِنا نَبكِهِ غَدا",83,"د",2,1],["وَمَن كانَ يَأبى أَن يُوالي إِمامَهُ","طَواعِيَةً والاهُ وَالأَنفُ راغِمُ",84,"م",1,0],["وَمَن كَانَ يَسعَى لِلمَقَاتِلِ سَهمُهُ","فَأسهُمُكُم تَسعَى إلَيهَا المَقَاتِلُ",85,"ل",1,0],["وَمِن كَحيلِ العَينِ مَيّاسِ","مَن جادَ بِالفَقرِ عَلى ياسِ",86,"س",1,0],["ومَن كانَ مِنْ خيرِ الأَنَامِ بِفَضلِهِ","كهارونَ مِن موسَى وذلِكُمُ الجَدُّ",87,"د",1,0],["وَمَن كانوا مَوالِيَّ","وَمَن كُنتُ لَهُم عَبدا",88,"د",2,0],["وَمِنكَباها في حُسنِ خَلقِهِما","في مِثلِ رُمّانَتَينِ مِن طينِ",89,"ن",1,0],["وَمَن كانَ ذا فَهمٍ بَليدٍ وَعَقلُهُ","بِهِ عِلَّةٌ عابَ الكَلامَ المُنَقَّحا",90,"ح",2,0],["وَمَن كانَ ذا جودٍ وَلَيسَ بِمُكثِرٍ","فَلَيسَ بِمَحسوبٍ مِنَ الكُرَماءِ",91,"م",3,0],["وَمَن كانَ في الأَشياءِ يَحكُمُ بِالحِجى","تَساوى لَدَيهِ مَن يُحِبُّ وَمَن يَقلي",92,"ي",1,0],["ومَن كان يَنْدَى الخيزُرانُ بكفِّهِ","ويَنبُتُ في أطرافهِ الورقُ الخُضْرُ",93,"ر",1,0],["ومن كان فيه غلّة من صبابة","فَقَد يَشرب الماء القراح وَلا يَروى",94,"و",2,0],["ومن كانَ حراً في شعور يبثه","قريضاً يفك الشعر من ربقة الأسر",95,"ر",1,0],["ومن كانَ ذا روح مع العصر ثائر","فَلَيسَ يريد الروح منه ليجمدا",96,"د",2,0],["ومنك الذي أوحى إليَّ فهزَّني","وفجَّر شعري مِن سماءِ بياني",97,"ي",1,0],["وَمَن كانَ في حُبّي بُثَينَةَ يَمتَري","فَبَرقاءُ ذي ضالٍ عَلَيَّ شَهيدُ",98,"د",1,0],["ومَنْ كان مِمّا يُحْدِثُ الدَّهْرُ جازِعاً","فلا بُدَّ يَوْماً أنْ يُرى وهو صابِرُ",99,"ر",1,0],["ومن كان يستدعي الجمال بحليةٍ","أضر به فقد البرى والمراسل",100,"ل",1,0],["وَمَنْ كَانَ ذَا نَفْسٍ كَنَفْسِي تَصَدَّعَتْ","لِعِزَّتِهِ الدُّنْيَا وذَلَّتْ لَهُ الأُسْدُ",101,"د",1,0],["وَمَنْ كَفُؤَادٍ لِلحَصَافَة وَالحِجَى","وَمَنْ كَفُؤادٍ لِلوَفَاءِ وَلِلبِرِّ",102,"ر",1,0],["وَمَن كَافحَ الدُّنْيَا وَقَدْ صَحَّ عَزْمُهُ","تَعَوَّدَ فِيهَا غَيْرَ مَا قَدْ تَعَوَّدا",103,"د",2,0],["ومِن كلِّ كفٍّ قد رُمِيتُ بصخرةٍ","وفي راحتي لو أَمْكَنَ الرأْيُ أَحجارُ",104,"ر",1,0],["ومَن كتب النصرَ المبينَ بسيفهِ","على جَبْهةِ الدنيا فقد كتب الْخُلْدا",105,"د",2,0],["ومن كلب الدنيا على كلب الغنى","تَمَنَّيْتُ لو أقضي حَيَاتيَ طاويا",106,"ي",2,0],["وَمَن كُنتَ بَحرًا لَهُ يا عَلِي","يُ لَم يَقبَلِ الدُرَّ إِلّا كِبارا",107,"ر",2,0],["ومن كل حي قد أتتني فوارس","ذَوُو نَجَداتٍ في اللِّقَاءِ كِرَامِ",108,"م",1,0],["ومن كرمت طبائعه تحلى","بِآدابٍ مُفَضَّلَة ٍ حِسَانِ",109,"ن",1,1],["ومنك تعلمت القريض منمنماً","فحق بان أهديك شكري منمنما",110,"م",2,0],["ومن كوى خفرات تستجد رؤى","نشوانة عن رؤى مملولة نسقا",111,"ق",2,0],["ومن كُرَبٍ للحبِّ في باطِنِ الحشا،","بأنعَمِ حَالَيْ غِبطَة ٍ وسُرورِ",112,"ر",1,0]]}