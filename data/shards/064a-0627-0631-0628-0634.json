{"poems":[[53,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[53,"يا رب شوهاء لجوج الزنا","https://www.aldiwan.net/poem63995.html","السريع"],[53,"وفي أبي سعد لؤم","https://www.aldiwan.net/poem66330.html","المجتث"],[51,"يا رب شهوة ساعة قد أعقبت","https://www.aldiwan.net/poem63072.html","الكامل"],[108,"تحية موجزة","https://www.poetsgate.com/ViewPoem.aspx?id=179384",""],[108,"محنة فرنسا","https://www.poetsgate.com/ViewPoem.aspx?id=179418",""],[108,"شعب واحد ورب واحد","https://www.poetsgate.com/ViewPoem.aspx?id=179304",""],[108,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[108,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179289",""],[445,"فكأن من حاني السحائب جودها","https://www.aldiwan.net/poem34842.html","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38426","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112747","الكامل"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113743","البسيط"],[2420,"","https://poetry.dctabudhabi.ae/diwan/poem/95978","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205033","الكامل"],[3109,"","https://poetry.dctabudhabi.ae/diwan/poem/102838","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77114","البسيط"]],"verses":[["يا رُبّ شاكٍ إليه خَلَّتَهُ","راح بجدواه يشتكي بطره",0,"ر",2,0],["يا رُبّ شوهاءَ لجوجِ الزنا","تصطاد بالرفق رجالَ الفُجورْ",1,"ر",1,1],["يا رُبَّ شُهْدٍ أكلْنا","هُ عنده كان علقمْ",2,"م",1,0],["يا رُبَّ شَهوَةِ ساعَةٍ قَد أَعقَبَت","مَن نالَها حُزناً هُناكَ طَويلا",3,"ل",2,1],["يا رب شعرٍ فَاتِرِ مبتذَل","لا هو بالنثر، ولا بالزَّجل",4,"ل",1,0],["يا رُب شعبِ في حِماهُ وادعٍ","جَرَفَتْهُ لُجتها فخاض غمارها",5,"ر",3,0],["يا رُبَّ شعب شتيتِ الشمل منقسم","من ضعفه قُلِّمَتْ منه أظافرهُ",6,"ر",2,0],["يا رُبَّ شاك منكمو","قد عادَ يومًا وهْوَ شاكر",7,"ر",1,0],["يا رُبَّ شعرٍ عراقيّ هتف به","كأنه لِيَ في الأسحار أوراد",8,"د",1,0],["يا رُبَّ شامِخَةِ الذَّوائِبِ والذُّرى","أَوْطَأْتَ أعلامَ الهُدى أَعْلامَها",9,"م",3,0],["يا رُبَّ شَخصٍ جاءَ يَمضغُ أَكلَهُ","فَرَأيت حالاً غيرَ حالِ الآكلِ",10,"ل",1,1],["يا رب شرفنا بشر زلاله","يا رب وارحمنا بحسن المختتم",11,"م",1,0],["يا ربِّ شَفُّعهُ فيَّ واقبَل شفاعَتَهُ","فجاهُهُ ربَّنا لديكَ مُعتَبَرُ",12,"ر",1,0],["يا ربَّ شيخٍ مِن لَكيزٍ كَهكَمِ","قَلّصَ عن ذاتِ شبابٍ خِدلم",13,"م",1,1],["يا رب شوّه لي وجوه الغيد","كيلا أعذب منهم بصدود",14,"د",1,1],["يا رب شماع يروق بقده","ناديته والقلب مني يكمد",15,"د",1,1],["يا رَب شامِخ حصن لَيسَ يَبلُغُهُ الط","رفُ السَوِيُّ وَلَم يَخضَع إِلى أَحَد",16,"د",1,0]]}