{"poems":[[53,"أراعي بلوغ الشيب والشيب دائيا","https://www.aldiwan.net/poem29567.html","الطويل"],[53,"يا من رأى البرق على الأنعم","https://www.aldiwan.net/poem29815.html","السريع"],[53,"بود الرذايا أنها في السوابق","https://www.aldiwan.net/poem29954.html","الطويل"],[53,"عظيم الأسى في هذه غير مقنع","https://www.aldiwan.net/poem30141.html","الطويل"],[53,"تناسيت إلا باقيات من الذكر","https://www.aldiwan.net/poem30441.html","الطويل"],[53,"لنا كل يوم رنة خلف ذاهب","https://www.aldiwan.net/poem30738.html","الطويل"],[63,"حنانيك إن الغدر ضربة لازب","https://www.aldiwan.net/poem46200.html","الطويل"],[86,"إيه يا ليل هل شهدت المصابا","https://www.aldiwan.net/poem10378.html","الخفيف"],[93,"اسمع شكاتي فهي إن لم تفد","https://www.aldiwan.net/poem11090.html","السريع"],[93,"قف خاشعاً بضريح عز الدين","https://www.aldiwan.net/poem11214.html","الكامل"],[93,"هل بعالي الذرى مكان اعتصام","https://www.aldiwan.net/poem11308.html","الخفيف"],[83,"زار الخيال بأيمن الزوراء","https://www.aldiwan.net/poem54344.html","الطويل"],[27,"أدار الجميع الصالحين بذي السدر","https://www.aldiwan.net/poem5770.html","الطويل"],[23,"أولئك قومي فإن تسألي","https://www.aldiwan.net/poem21241.html","المتقارب"],[51,"أحمد الله نية وثناء","https://www.aldiwan.net/poem7941.html","الخفيف"],[51,"أبلغ أبا سهل فتى العجم الذي","https://www.aldiwan.net/poem8162.html","الكامل"],[51,"فقدتك يا كنيزة كل فقد","https://www.aldiwan.net/poem8705.html","الوافر"],[51,"تعجل مولود ليمهل والد","https://www.aldiwan.net/poem61960.html","الطويل"],[51,"عظم الله يمن فطرك فطرا","https://www.aldiwan.net/poem62013.html","الخفيف"],[51,"وسميطة صفراء دينارية","https://www.aldiwan.net/poem62853.html","الكامل"],[51,"ألا قل لنحويك الأخفش","https://www.aldiwan.net/poem64923.html","المتقارب"],[51,"طل دمع هريق في الأطلال","https://www.aldiwan.net/poem65995.html","الخفيف"],[70,"وأحمق ذي لحية","https://www.aldiwan.net/poem42875.html","مجزوء الرجز"],[89,"حلمت بان الدهر لي يتبسم","https://www.aldiwan.net/poem44859.html","الطويل"],[85,"أعرني النجم أوهب لي يراعا","https://www.aldiwan.net/poem7102.html","الوافر"],[85,"هي صفعة سر الصحافة وقعها","https://www.aldiwan.net/poem7548.html","الكامل"],[85,"عظيم الناس من يبكي العظاما","https://www.aldiwan.net/poem8092.html","الوافر"],[85,"تاج البلاد تحية وسلام","https://www.aldiwan.net/poem8106.html","الكامل"],[85,"انظر إلى الأقمار كيف تزول","https://www.aldiwan.net/poem62837.html","الكامل"],[85,"أنا من بدل بالكتب الصحابا","https://www.aldiwan.net/poem63724.html","الكامل"],[85,"قف على كنز بباريس دفين","https://www.aldiwan.net/poem63736.html","الرمل"],[85,"سل يلدزا ذات القصور","https://www.aldiwan.net/poem63770.html","مجزوء الكامل"],[43,"جاء نيروزنا وأنت مراده","https://www.aldiwan.net/poem9556.html","الخفيف"],[43,"ملامي النوى في ظلمها غاية الظلم","https://www.aldiwan.net/poem10536.html","الطويل"],[45,"يأبى سموك واعتلاؤك","https://www.aldiwan.net/poem10206.html","مجزوء الكامل"],[45,"يا ابن حمدون بن إسما","https://www.aldiwan.net/poem63471.html","مجزوء الرمل"],[45,"ما بعيني هذا الغزال الغرير","https://www.aldiwan.net/poem63566.html","الخفيف"],[45,"قفا في مغاني الدار نسأل طلولها","https://www.aldiwan.net/poem65590.html","الطويل"],[28,"فسيري فأمي أرض قومك إنني","https://www.aldiwan.net/poem5344.html","الطويل"],[28,"لعمرك ما تجزي مفداة شقتي","https://www.aldiwan.net/poem5651.html","الطويل"],[61,"سوداء لم تنتسب لحام","https://www.aldiwan.net/poem51456.html","مخلع البسيط"],[2,"أمن أم أوفى دمنة لم تكلم","https://www.aldiwan.net/poem25065.html","الطويل"],[49,"يا رب شهوة ساعة قد أعقبت","https://www.aldiwan.net/poem63072.html","الكامل"],[80,"متى صدرت عيناك عن أرض بابل","https://www.aldiwan.net/poem31321.html","الطويل"],[80,"نعيمك أن تزف لك العقار","https://www.aldiwan.net/poem31437.html","الوافر"],[69,"سلام كنشر الروض باكره الحيا","https://www.aldiwan.net/poem29222.html","السريع"],[105,"اشهدي يا مصر أعمال البنين","https://www.aldiwan.net/poem43070.html","الرمل"],[105,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[105,"أفتى العوارف والعواطف حاضرا","https://www.aldiwan.net/poem43159.html","الكامل"],[105,"هواك هواك والدنيا شؤون","https://www.aldiwan.net/poem43372.html","الوافر"],[105,"يا بني الحارث بن كعب سلام","https://www.aldiwan.net/poem44004.html","الخفيف"],[105,"أبا الفضل أقبل وارفع الصوت شاكرا","https://www.aldiwan.net/poem44043.html","الطويل"],[105,"تلك عقبى البغي فانظر كيف عادا","https://www.aldiwan.net/poem44219.html","الرمل"],[13,"تقول سليمى لجاراتها","https://www.aldiwan.net/poem2210.html","المتقارب"],[22,"ألا من لقلب عارم النظرات","https://www.aldiwan.net/poem21659.html","الطويل"],[22,"ستكفيك أمثال المجادل جلة","https://www.aldiwan.net/poem22005.html","الطويل"],[52,"أبى آبي الهوى أن لا تفيقا","https://www.aldiwan.net/poem26799.html","الوافر"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[50,"هام قلبي باللواتي","https://www.aldiwan.net/poem64733.html","مجزوء الرمل"],[7,"لقد قلت للنعمان يوم لقيته","https://www.aldiwan.net/poem1993.html","الطويل"],[46,"فهل بلاد يعري الموت ساكنها","https://www.aldiwan.net/poem22389.html","البسيط"],[46,"عظيم لعمري أن يلم عظيم","https://www.aldiwan.net/poem23645.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85322","الخفيف"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30437","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42570","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55059","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55072","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54749","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54846","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54698","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54686","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54634","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67302","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43691","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43851","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54194","الخفيف"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/50177","الرجز"],[22,"أَلا مَنْ لِقَلْبٍ عارِمِ النّظراتِ","https://www.poetsgate.com/ViewPoem.aspx?id=18935",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[45,"ما بِعَيْنَيْ هذا الغَزَالِ الغَرِيرِ","https://www.poetsgate.com/ViewPoem.aspx?id=31251",""],[2,"معلقة هير بن أبي سلمى","https://www.poetsgate.com/ViewPoem.aspx?id=11406",""]],"verses":[["عَظيمٌ عَلى غَيظِ الرِجالِ مُحَسَّدٌ","غَلوبٌ إِذا ما جاذَبوهُ المَعالِيا",0,"ي",2,0],["عَظيمَةٌ نادَيتُ مِن ثِقلِها","بِالبازِلِ الناهِضِ بِالمُعظَمِ",1,"م",1,0],["عَظيمِ دَويِّ الصَوتِ في سَمعِ سامِعٍ","بَعيدِ سَماعِ الصَوتِ مِن نُطقِ ناطِقِ",2,"ق",1,0],["عَظيمُ الأَسى في هَذِهِ غَيرُ مُقنِعِ","وَلَومُ الرَدى فيما جَنى غَيرُ مُنجِعِ",3,"ع",1,1],["عَظيمٌ عَليهِم أَن يَبيتوا بِلا يَدٍ","وَهَينٌ عَليهِم أَن يَفيئوا بِلا وَفرِ",4,"ر",1,0],["عِظامُ المَقاري يُمطِرونَ نَوالَهُم","بِأَيدي مَساميحٍ سِباطِ الرَواجِبِ",5,"ب",1,0],["عِظامُ المَقاري والسَّماءُ كأنَّها","تَمُجُّ دَمَاً دونَ النُّجومِ الشَّواحِبِ",6,"ب",1,0],["عِظَمٌ لَو حَواهُ كِسرى أَنوشَر","وانَ يَوماً لَضاقَ عَنهُ إِهابا",7,"ب",2,0],["عظائم الدنيا تحب الفتى","في أكثر الأخلاق مستطفلا",8,"ل",2,0],["عَظُمَتْ مُوَاسَاةُ الحِمَى لَكَ فَلْيَكُنْ","فِيهَا العَزَاءُ لِقَلْبِكَ المَحْزُونِ",9,"ن",1,0],["عَظَّمَ الله أَجْرَكُمْ إِنَّ وَعْدَ اللَّ","هِ حَقٌّ لِلصَّابِرِينَ الكِرَامِ",10,"م",1,0],["عظّمتَ ميلادَ النبيِّ محمدٍ","وشَفعتَهُ بالليلةِ الغرَّاءِ",11,"ا",2,0],["عِظامُ المَقاري في السِنينَ وَجارُكُم","يَبيتُ مِنَ اللاتي تُخافُ لَدى وَكرِ",12,"ر",1,0],["عِظامُ القُدورِ لِأَيسارِهِم","يَكُبّونَ فيها المُسِنَّ السَنِم",13,"م",1,0],["عَظُمت تلكمُ الأيادي وجَلَّتْ","فاذكر المَوز واتركِ الأشياءَ",14,"ا",2,0],["عَظُمتْ بك النُّعمى فقد ألهيتنا","عن كل شيء كان فيه لنا أرَبْ",15,"ب",1,0],["عظامٌ قد براها السُّلُّ برياً","فما فيها لبعض الطير قوتُ",16,"ت",1,0],["عظيم وَفَى النُّعْمَى عظيماً وماجد","فدى ماجداً لا زال يفديه ماجدُ",17,"د",1,0],["عظَّمَ الله يُمنَ فطرِك فطرا","يا ابن أعلى الملوك مجداً وذكْرا",18,"ر",2,1],["عظمتْ فكادت أن تكون إوزةً","ونَوتْ فكاد إهابها يتفطرُ",19,"ر",1,0],["عظيمَ كَشاخِنةٍ قائداً","طويل السلامة لم يُخدَش",20,"ش",1,0],["عظُمت غفلةُ امرئ مُبتداه","رام من في ذَراكَ باستغفالِ",21,"ل",1,0],["عَظيمَةٍ لَكِنَّها","لَيسَت تُساوي بَعَرَه",22,"ر",2,0],["عظيم من استولى على الناس كلهم","ولكن من استغنى عن الناس اعظم",23,"م",1,0],["عظيم في الخصومة ما تجنى","ولا ركب السباب ولا القذاعا",24,"ع",2,0],["عظمت على من نالها فكأنه","من كف كل أخى نهى مصفوع",25,"ع",1,0],["عَظيمُ الناسِ مَن يَبكي العِظاما","وَيَندُبُهُم وَلَو كانوا عِظاما",26,"م",2,1],["عِظَةٌ لِفاروقٍ وَصالِحِ جيلِهِ","فيما يُنيلُ الصَبرُ وَالإِقدامُ",27,"م",1,0],["عَظُمَت وَجَلَّ ضَريحُ يوسُفَ فَوقَها","حَتّى كَأَنَّ المَيتَ فيهِ رَسولُ",28,"ل",1,0],["عِظَةُ الماضي وَمُلقى دَرسِهِ","لِعُقولٍ تَجعَلُ الماضي مَثابا",29,"ب",2,0],["عِظَةٌ قومي بِها أَولى وَإِن","بَعُدَ العَهدُ فَهَل يَعتَبِرون",30,"ن",1,0],["عِظَةُ المُلوكِ وَعِبرَةُ ال","أَيّامِ في الزَمَنِ الأَخير",31,"ر",1,0],["عَظَّمَتهُ مَمالِكُ الفُرسِ حَتّى","كُلُّ أَيّامِ عامِهِ حُسّادُه",32,"د",2,0],["عَظُمتَ فَلَمّا لَم تُكَلَّم مَهابَةً","تَواضَعتَ وَهوَ العُظمُ عُظماً عَنِ العُظمِ",33,"م",1,0],["عَظُمَ الرَجاءُ وَرُبَّ يَو","مٍ حَقَّ فيهِ لَنا رَجاؤُك",34,"ك",1,0],["عَظُمَت في فَضلِكَ النِع","مَةُ وَاللَهُ يَزيدُك",35,"ك",1,0],["عَظَّموهُ وَوَقَّروهُ وَمَحقو","قٌ بِفَضلِ التَعظيمِ وَالتَوقيرِ",36,"ر",1,0],["عَظيمُ كَراديسِ المَواكِبِ قادِرٌ","عَلى الدِرعِ أَن يَغتالَ عَنهُ فُضولَها",37,"ل",3,0],["عِظامُ المَقاري يَأمَنُ الجارُ فَجعَها","إِذا ما الثُرَيّا أَخلَفَتها بُروقُها",38,"ق",3,0],["عَظيماً سَناها لِلعُفاةِ رَفيعَةً","تُسامي أُنوفَ الموقِدينَ فَنائِيا",39,"ي",2,0],["عظيمةٌ إن غلَت أَذَابت","بِغَلْيِها يابسَ العِظامِ",40,"م",1,0],["عَظيمَينِ في عُليا مَعَدٍّ وَغَيرِها","وَمَن يَستَبِح كَنزاً مِنَ المَجدِ يَعظُمِ",41,"م",1,0],["عَظُمَ البَلاءُ بِها عَلَيهِ وَإِنَّما","نالَ المُفَضِّلُ لِلشَقاءِ قَليلا",42,"ل",2,0],["عَظيمُ رَمادِ المَندَلِ الرّطبِ نارُهُ","تَرى الجَوَّ مِنها في دُخانٍ مُواصِلِ",43,"ل",1,0],["عَظيمُ الجدّ يُضربُ مِن ظُباهُ","وَيُطعَنُ مِن أَسِنَّتِهِ البوارُ",44,"ر",1,0],["عظيمُ الندى كهفُ الردى غائظُ العدى","إمامُ الهدى نائي المدى متقرّبُ",45,"ب",1,0],["عَظَّموا ما شِئتِ مِن حُرمَتِهِ","وَمَضَوا في العُظَماءِ الخالِدينْ",46,"ن",1,0],["عِظَةٌ تُشيرُ إِلى الدُهورِ وَكُلُّها","قَلبٌ يُشيرُ إِلَيكِ بِالخَفَقانِ",47,"ن",1,0],["عَظَّمتَ حُرمَتَها وَصُنتَ ذِمامَها","وَقَضَيتَ مِن تِلكَ الحُقوقِ الواجِبا",48,"ب",2,0],["عِظاتُ الدَهرِ وَالأَجيالِ مِنها","بِبَغدادٍ وَأَندَلُسٍ فُنونُ",49,"ن",1,0],["عَظُمَتْ نِعمةُ النبيِّ عليكم","فاعرفوا دِينَهُ وكيف يُقامُ",50,"م",1,0],["عظيماً تُرَجِّيهِ قريشٌ لِمَا بها","إذا فَزعتْ للأمرِ تَخْشَى الدوائرا",51,"ر",2,0],["عِظةٌ في التُّربِ كانت فِتنةً","وعذابٌ كان شرّاً وفَسادا",52,"د",2,0],["عَظاءَةَ قَفرٍ لَها حُلَّتانِ","مِن وَرَقِ الطَلحِ لَم تُغزَلا",53,"ل",2,0],["عِظامُ مَقيلِ الهامِ غُلبٌ رِقابُها","يُباكِرنَ بَردَ الماءِ بِالسَبَراتِ",54,"ت",1,0],["عِظامُ الجُثى غُلبُ الرِقابِ كَأَنَّها","أَكاريعُ ظَبيٍ مُدفَآتٌ ظُهورُها",55,"ر",3,0],["عَظيماتٌ مِنَ البُختِ اللَواتي","تَخالُ شِفاهَها عُشَراً فَليقا",56,"ق",2,0],["عَظُمَتْ نِعْمَةُ الإِله عليه","فاستَقَلَّتْ لِذِكْرِهِ العُظَمَاءُ",57,"ا",2,0],["عِظَتي فيها رُوَيداً","قَد مَلِلتُ الواعِظاتِ",58,"ت",1,0],["عِظامُ اللُهى أَولادُ عُذرَةَ إِنَّهُم","لَهاميمُ يَستَلهونَها بِالحَناجِرِ",59,"ر",1,0],["عَظمٌ وَنَحضٌ تَبَنّى مِنهُما طَلَلٌ","كَأَنَّها الأَرضُ مِنها السَهلُ وَالجَلَدُ",60,"د",1,0],["عظِيمٌ لَعَمْري أنْ يُلِمّ عظيمُ","بآلِ علِيّ والأنامُ سَليمُ",61,"م",1,1],["عظم الخطب في العراق فَلِلَّ","هِ قلوب هناك مرتجفات",62,"ت",1,0],["عَظُمَتْ رَزِيَّتُهُ وَلَكِنْ قَدْرُهُ","أَخْزَى وأَهْوَنُ مِن ذُبَاب في تُراب",63,"ب",1,0],["عَظُمَتْ مُصِيبَتُهُ عَلَيَّ بِقَدْرِ مَا","عَظُمَتْ لَدَيَّ شَمَاتَةُ الْحُسّ