 من الكون لثاما","https://www.aldiwan.net/poem33885.html","الرمل"],[558,"نحن عن شمس أمره كالشعاع","https://www.aldiwan.net/poem34395.html","الخفيف"],[558,"لحرب نفوسنا قد جاء فارس","https://www.aldiwan.net/poem34448.html","الوافر"],[558,"إن ديني وملتي واعتقادي","https://www.aldiwan.net/poem34642.html","الخفيف"],[558,"إن بحر الوجود بالإختلاج","https://www.aldiwan.net/poem34690.html","الخفيف"],[562,"جمعت من أفضل الأسماء في القدم","https://www.aldiwan.net/poem52833.html","البسيط"],[563,"أثار الهوى سجع الحمام المغرد","https://www.aldiwan.net/poem13598.html","الطويل"],[583,"كبيشة عرسي تمنى الطلاقا","https://www.aldiwan.net/poem443.html",""]],"verses":[["عَظيمٌ عَلى غَيظِ الرِجالِ مُحَسَّدٌ","غَلوبٌ إِذا ما جاذَبوهُ المَعالِيا",0,"ي",2,0],["عَظيمَةٌ نادَيتُ مِن ثِقلِها","بِالبازِلِ الناهِضِ بِالمُعظَمِ",1,"م",1,0],["عَظيمِ دَويِّ الصَوتِ في سَمعِ سامِعٍ","بَعيدِ سَماعِ الصَوتِ مِن نُطقِ ناطِقِ",2,"ق",1,0],["عَظيمُ الأَسى في هَذِهِ غَيرُ مُقنِعِ","وَلَومُ الرَدى فيما جَنى غَيرُ مُنجِعِ",3,"ع",1,1],["عَظيمٌ عَليهِم أَن يَبيتوا بِلا يَدٍ","وَهَينٌ عَليهِم أَن يَفيئوا بِلا وَفرِ",4,"ر",1,0],["عِظامُ المَقاري يُمطِرونَ نَوالَهُم","بِأَيدي مَساميحٍ سِباطِ الرَواجِبِ",5,"ب",1,0],["عِظامُ المَقاري والسَّماءُ كأنَّها","تَمُجُّ دَمَاً دونَ النُّجومِ الشَّواحِبِ",6,"ب",1,0],["عِظَمٌ لَو حَواهُ كِسرى أَنوشَر","وانَ يَوماً لَضاقَ عَنهُ إِهابا",7,"ب",2,0],["عظائم الدنيا تحب الفتى","في أكثر الأخلاق مستطفلا",8,"ل",2,0],["عَظُمَتْ مُوَاسَاةُ الحِمَى لَكَ فَلْيَكُنْ","فِيهَا العَزَاءُ لِقَلْبِكَ المَحْزُونِ",9,"ن",1,0],["عَظَّمَ الله أَجْرَكُمْ إِنَّ وَعْدَ اللَّ","هِ حَقٌّ لِلصَّابِرِينَ الكِرَامِ",10,"م",1,0],["عظّمتَ ميلادَ النبيِّ محمدٍ","وشَفعتَهُ بالليلةِ الغرَّاءِ",11,"ا",2,0],["عِظامُ المَقاري في السِنينَ وَجارُكُم","يَبيتُ مِنَ اللاتي تُخافُ لَدى وَكرِ",12,"ر",1,0],["عِظامُ القُدورِ لِأَيسارِهِم","يَكُبّونَ فيها المُسِنَّ السَنِم",13,"م",1,0],["عَظُمت تلكمُ الأيادي وجَلَّتْ","فاذكر المَوز واتركِ الأشياءَ",14,"ا",2,0],["عَظُمتْ بك النُّعمى فقد ألهيتنا","عن كل شيء كان فيه لنا أرَبْ",15,"ب",1,0],["عظامٌ قد براها السُّلُّ برياً","فما فيها لبعض الطير قوتُ",16,"ت",1,0],["عظيم وَفَى النُّعْمَى عظيماً وماجد","فدى ماجداً لا زال يفديه ماجدُ",17,"د",1,0],["عظَّمَ الله يُمنَ فطرِك فطرا","يا ابن أعلى الملوك مجداً وذكْرا",18,"ر",2,1],["عظمتْ فكادت أن تكون إوزةً","ونَوتْ فكاد إهابها يتفطرُ",19,"ر",1,0],["عظيمَ كَشاخِنةٍ قائداً","طويل السلامة لم يُخدَش",20,"ش",1,0],["عظُمت غفلةُ امرئ مُبتداه","رام من في ذَراكَ باستغفالِ",21,"ل",1,0],["عَظيمَةٍ لَكِنَّها","لَيسَت تُساوي بَعَرَه",22,"ر",2,0],["عظيم من استولى على الناس كلهم","ولكن من استغنى عن الناس اعظم",23,"م",1,0],["عظيم في الخصومة ما تجنى","ولا ركب السباب ولا القذاعا",24,"ع",2,0],["عظمت على من نالها فكأنه","من كف كل أخى نهى مصفوع",25,"ع",1,0],["عَظيمُ الناسِ مَن يَبكي العِظاما","وَيَندُبُهُم وَلَو كانوا عِظاما",26,"م",2,1],["عِظَةٌ لِفاروقٍ وَصالِحِ جيلِهِ","فيما يُنيلُ الصَبرُ وَالإِقدامُ",27,"م",1,0],["عَظُمَت وَجَلَّ ضَريحُ يوسُفَ فَوقَها","حَتّى كَأَنَّ المَيتَ فيهِ رَسولُ",28,"ل",1,0],["عِظَةُ الماضي وَمُلقى دَرسِهِ","لِعُقولٍ تَجعَلُ الماضي مَثابا",29,"ب",2,0],["عِظَةٌ قومي بِها أَولى وَإِن","بَعُدَ العَهدُ فَهَل يَعتَبِرون",30,"ن",1,0],["عِظَةُ المُلوكِ وَعِبرَةُ ال","أَيّامِ في الزَمَنِ الأَخير",31,"ر",1,0],["عَظَّمَتهُ مَمالِكُ الفُرسِ حَتّى","كُلُّ أَيّامِ عامِهِ حُسّادُه",32,"د",2,0],["عَظُمتَ فَلَمّا لَم تُكَلَّم مَهابَةً","تَواضَعتَ وَهوَ العُظمُ عُظماً عَنِ العُظمِ",33,"م",1,0],["عَظُمَ الرَجاءُ وَرُبَّ يَو","مٍ حَقَّ فيهِ لَنا رَجاؤُك",34,"ك",1,0],["عَظُمَت في فَضلِكَ النِع","مَةُ وَاللَهُ يَزيدُك",35,"ك",1,0],["عَظَّموهُ وَوَقَّروهُ وَمَحقو","قٌ بِفَضلِ التَعظيمِ وَالتَوقيرِ",36,"ر",1,0],["عَظيمُ كَراديسِ المَواكِبِ قادِرٌ","عَلى الدِرعِ أَن يَغتالَ عَنهُ فُضولَها",37,"ل",3,0],["عِظامُ المَقاري يَأمَنُ الجارُ فَجعَها","إِذا ما الثُرَيّا أَخلَفَتها بُروقُها",38,"ق",3,0],["عَظيماً سَناها لِلعُفاةِ رَفيعَةً","تُسامي أُنوفَ الموقِدينَ فَنائِيا",39,"ي",2,0],["عظيمةٌ إن غلَت أَذَابت","بِغَلْيِها يابسَ العِظامِ",40,"م",1,0],["عَظيمَينِ في عُليا مَعَدٍّ وَغَيرِها","وَمَن يَستَبِح كَنزاً مِنَ المَجدِ يَعظُمِ",41,"م",1,0],["عَظُمَ البَلاءُ بِها عَلَيهِ وَإِنَّما","نالَ المُفَضِّلُ لِلشَقاءِ قَليلا",42,"ل",2,0],["عَظيمُ رَمادِ المَندَلِ الرّطبِ نارُهُ","تَرى الجَوَّ مِنها في دُخانٍ مُواصِلِ",43,"ل",1,0],["عَظيمُ الجدّ يُضربُ مِن ظُباهُ","وَيُطعَنُ مِن أَسِنَّتِهِ البوارُ",44,"ر",1,0],["عظيمُ الندى كهفُ الردى غائظُ العدى","إمامُ الهدى نائي المدى متقرّبُ",45,"ب",1,0],["عَظَّموا ما شِئتِ مِن حُرمَتِهِ","وَمَضَوا في العُظَماءِ الخالِدينْ",46,"ن",1,0],["عِظَةٌ تُشيرُ إِلى الدُهورِ وَكُلُّها","قَلبٌ يُشيرُ إِلَيكِ بِالخَفَقانِ",47,"ن",1,0],["عَظَّمتَ حُرمَتَها وَصُنتَ ذِمامَها","وَقَضَيتَ مِن تِلكَ الحُقوقِ الواجِبا",48,"ب",2,0],["عِظاتُ الدَهرِ وَالأَجيالِ مِنها","بِبَغدادٍ وَأَندَلُسٍ فُنونُ",49,"ن",1,0],["عَظُمَتْ نِعمةُ النبيِّ عليكم","فاعرفوا دِينَهُ وكيف يُقامُ",50,"م",1,0],["عظيماً تُرَجِّيهِ قريشٌ لِمَا بها","إذا فَزعتْ للأمرِ تَخْشَى الدوائرا",51,"ر",2,0],["عِظةٌ في التُّربِ كانت فِتنةً","وعذابٌ كان شرّاً وفَسادا",52,"د",2,0],["عَظاءَةَ قَفرٍ لَها حُلَّتانِ","مِن وَرَقِ الطَلحِ لَم تُغزَلا",53,"ل",2,0],["عِظامُ مَقيلِ الهامِ غُلبٌ رِقابُها","يُباكِرنَ بَردَ الماءِ بِالسَبَراتِ",54,"ت",1,0],["عِظامُ الجُثى غُلبُ الرِقابِ كَأَنَّها","أَكاريعُ ظَبيٍ مُدفَآتٌ ظُهورُها",55,"ر",3,0],["عَظيماتٌ مِنَ البُختِ اللَواتي","تَخالُ شِفاهَها عُشَراً فَليقا",56,"ق",2,0],["عَظُمَتْ نِعْمَةُ الإِله عليه","فاستَقَلَّتْ لِذِكْرِهِ العُظَمَاءُ",57,"ا",2,0],["عِظَتي فيها رُوَيداً","قَد مَلِلتُ الواعِظاتِ",58,"ت",1,0],["عِظامُ اللُهى أَولادُ عُذرَةَ إِنَّهُم","لَهاميمُ يَستَلهونَها بِالحَناجِرِ",59,"ر",1,0],["عَظمٌ وَنَحضٌ تَبَنّى مِنهُما طَلَلٌ","كَأَنَّها الأَرضُ مِنها السَهلُ وَالجَلَدُ",60,"د",1,0],["عظِيمٌ لَعَمْري أنْ يُلِمّ عظيمُ","بآلِ علِيّ والأنامُ سَليمُ",61,"م",1,1],["عظم الخطب في العراق فَلِلَّ","هِ قلوب هناك مرتجفات",62,"ت",1,0],["عَظُمَتْ رَزِيَّتُهُ وَلَكِنْ قَدْرُهُ","أَخْزَى وأَهْوَنُ مِن ذُبَاب في تُراب",63,"ب",1,0],["عَظُمَتْ مُصِيبَتُهُ عَلَيَّ بِقَدْرِ مَا","عَظُمَتْ لَدَيَّ شَمَاتَةُ الْحُسَّادِ",64,"د",1,0],["عَظَّمَ اللهُ أَجْرَكُمْ مَا صَبَرْتُمْ","وَوَقَاه