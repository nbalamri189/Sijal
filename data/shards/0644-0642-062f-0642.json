et/poem3319.html","عموديه"],[465,"متى لمتني في الغوزال الأغنِ","https://www.aldiwan.net/poem3326.html","عموديه"],[465,"أشاقك برق بالشآم يشام","https://www.aldiwan.net/poem3487.html","عموديه"],[465,"خلا منك طرفي والحشا لك أوطان","https://www.aldiwan.net/poem3542.html","عموديه"],[466,"شدوا اليك نياط القلب والعصبا","https://www.aldiwan.net/poem54193.html","عموديه"],[466,"في رحاب الحسين","https://www.aldiwan.net/poem59034.html","عموديه"],[478,"تمنى فكنتم جل ما يتمناه","https://www.aldiwan.net/poem15345.html","الطويل"],[501,"أتانا الهوى العذري من حيث لا ندري","https://www.aldiwan.net/poem37700.html","الطويل"],[515,"لا بر في الحب يا أهل الهوى قسمي","https://www.aldiwan.net/poem20785.html","البسيط"],[515,"أما ومواضي مقلتيها الفواصل","https://www.aldiwan.net/poem20797.html","الطويل"],[516,"الطويل","https://www.aldiwan.net/poem12121.html","الطويل"],[539,"خليفة عيسى مع سليل محمد","https://www.aldiwan.net/poem47580.html","عموديه"],[559,"لقد قيل لي ما الفرق عند أولي الذكر","https://www.aldiwan.net/poem34496.html","الطويل"],[563,"قف بالمطايا على أنجاد ذي سلم","https://www.aldiwan.net/poem52785.html","البسيط"],[576,"نعم هذه دار النعيم المعجل","https://www.aldiwan.net/poem2735.html","الطويل"],[576,"لئن كنت من عيني نقلت إلى قلبي","https://www.aldiwan.net/poem2789.html","الطويل"],[587,"دعاه ورقم الليل بالبرق مذهب","https://www.aldiwan.net/poem17416.html","الطويل"]],"verses":[["لَقَد قالَ داعي الحُبِّ هَل مِن مُجاوِبٍ","فَأَقبَلتُ أَسعى قَبلَ كُلِّ مُجاوِبِ",0,"ب",1,0],["لَقَد قُصِمَت مِنّي قَناةٌ صَليبَةٌ","وَيُقصَمُ عودُ النَبعِ وَهُوَ صَليبُ",1,"ب",1,0],["لقد قيل أن الغرب ذو مدنيّة","فقلت وهل معنى التمدن عُدوان",2,"ن",1,0],["لقد قوّيتنا من بعد عجز","به كنّا نحيد عن البراز",3,"ز",1,0],["لقد قدّم الموت الحياة أمامه","نذيراً ومن يُنذر فليس بغادر",4,"ر",1,0],["لَقَد قَتَلَ الجَحّافُ أَزواجَ نِسوَةٍ","قِصارَ الهَوادي سَيِّئاتِ التَحَوُّبِ",5,"ب",1,0],["لَقَد قَدَني مِن حُبِّ ماوِيَةَ الهَوى","وَما كانَ يَلقاني الجُنَيبَةُ أَقوَدا",6,"د",2,0],["لَقَد قَوَّسَت أُمُّ البَعيثِ وَلَم تَزَل","تُزاحِمُ عِلجاً صادِرَينِ عَلى كِفلِ",7,"ل",1,0],["لَقَد قَلَّ أَن تَلقى مِنَ الناسِ مُجمَلاً","وَأَخشى قَريباً أَن يَقِلَّ المُجامِلُ",8,"ل",1,0],["لَقَد قَنِعوا بَعدي مِنَ القَطرِ بِالنَدى","وَمَن لَم يَجِد إِلّا القُنوعَ تَقَنَّعا",9,"ع",2,0],["لَقَد قَذَفتُ بِها شَنعاءَ فاضِحَةً","يَظَلُّ مِنها لَبيبُ القَومِ كَالمودي",10,"د",2,0],["لقد قرَّ طرف مصلٍّ بمصر","بمسجدِ هذا الكريم انجذب",11,"ب",1,1],["لقد قمتَ بالمسنونِ والفرضِ في الندى","تضيّع هذا المال في غيرِ واجب",12,"ب",1,0],["لقد قنعت رجواي من قبل ما رأت","شهاب العلى والعلم في الشام يطلع",13,"ع",1,1],["لقد قام عبد الله يدعو إلى الندى","فأهوت شعوبٌ للرجا وقبائل",14,"ل",1,0],["لقَد قلَّ بين المهْد واللَّحْد لُبْثُهُ","فلم ينْسَ عهْدَ المهْد إذ ضُمَّ في اللَّحْدِ",15,"د",1,0],["لقد قسوت حين اخنيت","على الكواكب",16,"ب",1,0],["لقد قدم الدنيا بغير اختياره","وسافر منغير اختيار إلى الأخرى",17,"ر",2,0],["لقد قلت قولاً باطلاً بجهالة","والحدت فاللهم يا خالقي غفرا",17,"ر",2,0],["لَقَد قَطَعَ الواشي بِتَلفيقِ ما وَشى","مِنَ القَولِ ما لا يَقطَعُ الصارِمُ العَضبُ",18,"ب",1,0],["لَقَد قادَ جُردَ الخَيلِ مِن جَنبِ واسِطٍ","يَثورُ أَمامَ الرائِحينَ عَكوبُها",19,"ب",3,0],["لَقَد قَلَّدتُ جِلفَ بَني كُلَيبٍ","قَلائِدَ في السَوالِفِ باقِياتِ",20,"ت",1,0],["لقد قَصُرَتْ أيديهِما عن مَنالِه","زَماناً ولكن صيَّرا البُهْتَ سُلَّما",21,"م",2,0],["لقد قبضَتْ كَيْدَ المَكارمِ كفُّه","وقَلَّ على رُغمِ العُفاةِ غِزارُها",22,"ر",3,0],["لَقَد قَدَّرَ الأَرزاقَ مَن لَيسَ عادِلاً","عَنِ العَدلِ بَينَ الناسِ فيما يُقَدِّرُ",23,"ر",1,0],["لقد قالتْ لنا حلبٌ مقالاً","وقد عزمَ المشدُّ على الرواحِ",24,"ح",1,1],["لَقَد قَطّعتِ بِالدل","ل عُرى قَلبي وَأَوداجه",25,"ج",2,0],["لَقَد قالَ الرَوافِضُ في عَليٍّ","مَقالاً جامِعاً كُفراً وَموقا",26,"ق",2,0],["لقد قصَمتَ من ابنِ الخَزْرِ طاغيةً","صَعْبَ المقادةِ أبّاءً على الجَدَل",27,"ل",1,0],["لَقَد قامَ خَيرُ الناسِ مِن بَعدِ خَيرِهِم","فَلَيسَ عَلى الأَيّامِ وَالدَهرِ مَعتَبُ",28,"ب",1,1],["لَقَد قَوَّمَ العَبّاسُ لِلناسِ حِجَّهُم","وَساسَ بِرَهبانِيَّةٍ وَوِقارِ",29,"ر",1,0],["لَقَد قادَ الجُنودَ عَلَيكَ رَوحٌ","بِآباءٍ لَهُ أَمَروا وَقادوا",30,"د",3,0],["لَقَد قُلتُ لِلعَينِ المَريضَةِ بِالهَوى","أَفيقي وَإِن لَم تَفعَلي فَأَساتِ",31,"ت",1,0],["لَقَد قَرَفَ الوُشاةُ عَلى سُلَيمى","وَقالوا في البُعادِ وَفي الصِقابِ",32,"ب",1,0],["لَقَد قُلتُ لِلنُعمانِ يَومَ لَقيتُهُ","يُريدُ بَني حُنَّ بِبُرقَةِ صادِرِ",33,"ر",1,1],["لَقَد قَضَت الأيام بالبعد بيننا","فَطالَ على الأَيام فيما قَضَت عتبي",34,"ب",2,0],["لَقَد قطعوا أغصانها وفروعها","فَلَم يَبقَ ذاكَ الفيء والورق النضر",35,"ر",1,0],["لَقَد قالَ ناسٌ شاهدونيَ أنَّني","مصابٌ بداء السل وَيلي منَ السل",36,"ل",1,0],["لقد قال كل في الحياة برأيه","تعددت الآراء والحق واحد",37,"د",1,0],["لقد قرَّبَتْ جَسداً عارياً","وقلباً يَضِنُّ بأسرارهِ",38,"ه",1,0],["لَقَد قالَت عُبَيلَةُ إِذ رَأَتني","وَمَفرِقُ لِمَّتي مِثلُ الشَعاعِ",39,"ع",1,1],["لَقَدْ قَلَّ مَنْ يُؤْتِيهِ مَوْلاَهْ نِعْمَةً","وَيَقْدُرُهَا القَدْرَ الجَدِيرَ بِعَاقِلِ",40,"ل",1,0],["لقد قطفنا لكِ الأزهارَ باسمةً","وفي عقودٍ من الفصْحَى نظمناها",41,"ا",3,0],["لقد قرَّحت جفني العَبَراتُ","وأثخن قلبي الأنينُ جراحا",42,"ح",2,0],["لَقَدْ قَالَ الخَلِيُّ وَقَالَ حُلْساً","بِظَهْرِ اللَّيْلِ شُدَّ بِهِ الْعَكُومُ",43,"م",1,1],["لقد قُلْتُ لو أصغى إلى القولِ سامعٌ","وما هوَ مِّني بالظُنونِ الرّواجم",44,"م",1,0],["لقد قدنها حيّا وميّتا فما ثنى","شكيمتها عنف ولا هدّها ذعر",45,"ر",1,0],["لقد قصدوا خذل المعان وانه","له من يد المولى على رغمهم نصر",46,"ر",1,0],["لقدْ قالَ طرفى للفؤادِ شغلتني","فقالَ لهُ بلْ أنت باللحظِ شاغِلى",47,"ل",2,1],["لقدْ قالَ المهيمنُ إنّ هذا","لمن قد كان في الدنيا شَكُورَا",48,"ر",2,0],["لقد قيدتْني نعمة حاتمية","فلا تحسبنِّي عن حِوارك أجنحُ",49,"ح",1,0],["لَقَد قَذَفوا أَبا وَهبٍ بِأَمرٍ","كَبيرٍ أَو يَزيدُ عَلى الكَبيرِ",50,"ر",1,1],["لَقَد قَصَّرَ المُثني وَطالِبُ ذا المَدى","وَما مُنعِمٌ إِلّا مَنِ اِستَفرَغَ الجُهدا",51,"د",2,0],["لَقَد قَصَّروا أَن يُبرِموا ما نَقَضتَهُ","كَتَقصيرِهِم عَن نَقضِ ما ظَلتَ مُبرِما",52,"م",2,0],["لقد قيل أما اليوم ما رفعت","لهم سوى الحمد أملاكُ السما عملا",53,"ل",2,0],["لقد قالت الظلما بنورى يهتدي","وقال الدجى للشمس أغويت من يسري",54,"ر",2,0],["لقد قرئت فوق المنابر للهدى","نوافد حكم لا تعارضها دعوى",55,"و",2,0],["لقد قال لي عند المجاهد صاحبي","وقد حيل دون العيش هل أنت شارب",56,"ب",1,1],["لَقَد قَدَّمُوا هَيَّ بنَ بَيٍّ وَأَخَّرُوا","بَني المَجدِ مِن أَيّامِ عادٍ وَعاديا",57,"ي",2,0],["لقد قَدَح الشيبُ في جانِبي","وأَثَّر ما ليس بالواجِبِ",58,"ب",1,1],["لَقَد قادَهم منهُ إلى رأي ملحدٍ","إِذا لَم يكُن كُفراً فقد قاربَ الكفرا",59,"ر",2,0],["لقد قلَّ صبري بعدها وتجلُّدي","فيا ليت شعري بعدنا كيف صبرُها",60,"ر",3,0],["لقد قادني سمعي إليك وناظري","ولم يتخلّف عنك قلبي ولا فكري",61,"ر",2,0],["لقَدْ قالَ فيكَ اللهُ ما أَنْت أَهلهُ","فَيُقْضَى بِحُكْمِ اللهِ فيكَ بلا نَقْضِ",62,"ض",1,0],["لقد قرأ الرحمن طه جميعها","ويس أيضاً والملائك تسمع",63,"ع",1,0],["لَقَدَ قَصَموا عُرى الإِسلامِ عَوداً","وَبَدأً في الحُسَينِ وَفي عِلِّيِ",64,"ي",1,0],["لقد قبحت معنى وراقت نضارة","وقد يحسن المرأى وان خبث الأصل",65,"ل",1,0],["لقد قبحت في عنفوان شبابها","فهل نترجاها لتحسن فاركا",66,"ك",2,0],["لقد قدرت سرداًوضوعف نسجها","واحرزها داود من بعده ذخرا",67,"ر",2,0],["لقد قصرت ما طالَ كالليلِ في الأسى","لتأخذَ حقَّ النور من ظلمات",68,"ت",1,0],["لَقَدْ قَرَعَتْ لِلفَوْزِ باباً مُفَتَّحا","وأَمَّتْ إِماماً للنَّجَاةِ مُبلِّغا",69,"غ",2,0],["لَقَدْ قَلَبَتْ لِلْقَلْبِ ظَهْرَ مِجَنِّهَا","وَلا ذَنْبَ إلا أنْ أطَاعَ فَمَا يَعْصِي",70,"ص",2,0],["لقَد قَبُحَتْ سَجايا الدّهْرِ حَتَّى","حَباها مِنْ سَجَاياه الحِسَانِ",71,"ن",1,0],["لَقَدْ قَبَضَ الزَّمانُ يَدِي وَأَعْيَتْ","عَلَيَّ رِياضَهُ الْحَظِّ الْحَرُونِ",72,"ن",1,0],["لقد قلت حقا واجتنبت تملقا","ومع ذا فلم أظفر بنيل رضاكا",73,"ك",2,0],["لقد قمر الظلماء فهي ذؤابةٌ","ألا هل رأيتم مثله قمر الدجا",74,"ج",2,0],["لَقد قَتلوا دُنيا الحياتينِ خبرةً","فَمن لم يُساهِمهم فقد طاشَ سَهمهُ",75,"م",2,0],["لَقد قالَ هذا الوردُ لِلنرجسِ الّذي","تَطاوَل حتّى كادَ أَن يبلغَ العُلى",76,"ل",2,1],["لَقَد قَطَعت هذا الطريقَ دجاجةٌ","وَلَم نَرَ طيراً قَبلها يقطعُ الطرقا",77,"ق",2,1],["لَقَد قَطَفت مِنها يدا الدهرِ زهرةً","زكيٌّ بروضِ المكرماتِ غِراسها",78,"س",3,0],["لَقَد قَبَضَ اليَأسَ بَسطُ الرَجا","بِشَمسِ الضُحى في هِلالِ الدُجى",79,"ج",2,1],["لقد قَسَمَ الأَموالَ قِسْمةَ عادلٍ","فتىً هُوَ في الأَموالِ قاضٍ فَحَاكِم",80,"م",1,0],["لقد قطَع النَّوى إلاّ ادِّكاري","وبلَّتْ عَبْرتي إلا غليلي",81,"ل",2,0],["لَقَد قَسَموا فَرضَ النَدى وَقَسَمتَهُ","فَمِنكَ لَنا عولٌ وَمِنهُم لَنا حَجبُ",82,"ب",1,0],["لَقَد قُمتَ في نَصرِ النَبِيِّ وَآلِهِ","مَقاماً عَلى الرَحمَنِ قَد حَقَّ أَجرُهُ",83,"ر",2,0],["لَقَد قُمتَ بِالعَلياءِ حامِلَ كَلِّها","وَكُلٌّ يَراها فَوقَ عاتِقِهِ كَلّا",84,"ل",2,0],["لَقَد قامَ لِلدينِ الحَنيفيِّ بَعدَ ما","تَقاعَدَ حَدٌّ مِن حُسامٍ وَقائِمُ",85,"م",1,1],["لَقَد قَطَعَت أَصلي وَفَرعي فَلا أَنا","وَلا وَلَداً أَبقَت وَلا الخالَ وَالعَمّا",86,"م",2,0],["لقد قومت نار الجوى من جوانحي","حنايا ضلوعي فهي غير حنية",87,"ه",1,0],["لقد قرين قرياً مصغرا","إذا الهدان حار وأسبكرا",88,"ر",2,1],["لَقَد قَطَعت بِالشَوق قَلبي يَد الذِكرى","فَواقَلبيَ البالي وَواكبدي الحَرا",89,"ر",2,0],["لَقَد قُلتُ لما أَتوا بِالطَبيبِ","وَصادَفَني في أَحرِّ اللَهيبِ",90,"ب",1,1],["لقد قَوَّضَ الرّكب يوم الخليط","فأنجدَ في قلبي المتْهِمُ",91,"م",1,0],["لقد قيل الطعام فلم تدان","وقد قيل السماع فلم تدان",92,"ن",1,0],["لقد قضى اللهُ بالنصر العزيزِ له","فيما قضاه من التقدير في الأَزل",93,"ل",1,0],["لقد قرحت جلدي بلسع فلم تزل","به ندب كالفرح أو بلم الكبش",94,"ش",1,0],["لقد قوضت أيامه البيض وانقضت","فأيامنا من بعد في شية الدهم",95,"م",1,0],["لقد قيدتني الحادثات وقصَّرت","خطاي فلي من تحت أثقالها رسف",96,"ف",1,0],["لقد قعدتُ حين قام الخطوبُ","فأحيى المنى وأمات الفتن",97,"ن",1,0],["لقد قرَّرت لي بنات الزمان","قلَّةَ حظي من كلّ إبن",98,"ن",1,0],["لقد قضت الأيَّامُ بالبعد عنكمُ","وأخلقَ عهدٌ منكم وذمامُ",99,"م",1,0],["لقد قنصتنا والجفونُ حبائل","ومن عجب أن تقنص الأسدَ غزلان",100,"ن",1,0],["لَقَد قَرَعْتَ نَواقيساً مُدَوِّيَةً","تَرَكتَ كلَّ قَريض ٍبَعدَها لَغَبا !",101,"ب",2,0],["لقد قلتَ للنفسِ هذا طريقُكِ","لاقِي بِهِ الموتَ كي تَسلَمي",102,"م",2,0],["لقد قلَّ أنصارُ الذي قد غدتْ له","على البينِ عوناً في المحبَّةِ عيناهُ",103,"ا",2,0],["لقد قَصُرَت اوقاتُها انَّهُ اللُّقا","ل