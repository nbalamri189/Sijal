{"poems":[[87,"كان لسلطان نديم واف","https://www.aldiwan.net/poem8052.html","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77593","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46517","الرجز"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60899","المنسرح"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62969","السريع"],[5012,"قالولي عنك البارحه","https://www.poetsgate.com/ViewPoem.aspx?id=24378",""],[5138,"في شارع الحب سرت اسئل 2018","https://www.poetsgate.com/ViewPoem.aspx?id=195373",""],[5401,"الفكره","https://www.poetsgate.com/ViewPoem.aspx?id=182827",""],[5537,"نقاش أمن قومي","https://www.poetsgate.com/ViewPoem.aspx?id=207782",""]],"verses":[["قالَ وَلَكِن عِندَهُ مَرارَه","وَما حَمَدتُ مَرَّةً آثارَه",0,"ه",1,0],["قالَ وَلِم جئت وَماذا الداعي","أَحادِثٌ في المال وَالمَتاع",1,"ع",1,0],["قال وَلم تسبني وَتقذف","شر الرجال صاحب لا ينصف",2,"ف",1,0],["قال وَلُّوا تيماً فَبُعداً لتيمٍ","أي شر تخصيص استيلاها",3,"ا",3,0],["قالو لي اتركه عنك قلت لهم","صبي على صَاحبي ولا عدمُه",4,"م",2,0],["قال ولم يخبر بما في غدٍ","فيقبل النصحَ الذي قالَهْ",5,"ل",2,0],["قالولي عنك البارحه غلطت مره قلتني","قالولي انك من الخجل السالفه راحت هدر",6,"ر",1,1],["قالولي اصبر واتحمل","والعيش والملح عيجيبه",7,"ب",2,0],["قالولي فكّر وعيّت تضبط الفكره","وناديت ياْهل الوزاره دوروا غيري",8,"ر",2,1],["قَالوُ لِسَاَنِي كَانَ مُرَاقَب","مِن عَسسٍ وجِهَازِ سِيَاَدِي",9,"د",2,0]]}