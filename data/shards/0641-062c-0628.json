{"poems":[[6,"آذنتنا ببينها أسماء","https://www.aldiwan.net/poem375.html","الخفيف"],[63,"قمر تفرد بالمحاسن كلها","https://www.aldiwan.net/poem51541.html","الكامل"],[76,"شأوت مطايا الصبا مطلبا","https://www.aldiwan.net/poem12866.html","المتقارب"],[77,"ألا كل آت قريب المدى","https://www.aldiwan.net/poem69106.html","المتقارب"],[201,"طرقتني فجر يوم المولد","https://www.aldiwan.net/poem39890.html","الرمل"],[275,"سحرا مشى الفتيان مبتسمينا","https://www.aldiwan.net/poem35623.html","الكامل"],[382,"سمعت بأذني رنة السهمِ في قلبي","https://www.aldiwan.net/poem66952.html","الطويل"],[398,"قدم الرئيس مقدما في سبقه","https://www.aldiwan.net/poem53490.html","الكامل"],[438,"أبدى شمائل جفوة وبعاد","https://www.aldiwan.net/poem12600.html","الكامل"],[449,"نقل الطرف في ربوع الأمان","https://www.aldiwan.net/poem55974.html","عموديه"],[487,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[487,"فاح عرف المسك من عرف الخزام","https://www.aldiwan.net/poem24551.html","عموديه"],[518,"سقى الله رمل القاع في النخلات","https://www.aldiwan.net/poem67774.html","الطويل"],[519,"هذا الحمى فانزل على جرعائه","https://www.aldiwan.net/poem20799.html","الكامل"],[580,"فرقت بين بنانها وخضابها","https://www.aldiwan.net/poem3101.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138251",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122768","الكامل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96988","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38688","الطويل"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18523","الكامل"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119371","الخفيف"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144121","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101045","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53203","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53180","المديد"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67980","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89388","الكامل"],[3536,"","https://poetry.dctabudhabi.ae/diwan/poem/20617","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131059",""],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135513","الوافر"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77006","الطويل"],[4034,"","https://poetry.dctabudhabi.ae/diwan/poem/83114","الوافر"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147278","المتقارب"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139481",""],[4755,"كَغَريبٍ تَنَاهَشَتْهُ الهُمُومُ","https://www.poetsgate.com/ViewPoem.aspx?id=187242",""],[4862,"بل إن طبعي المرجله","https://www.poetsgate.com/ViewPoem.aspx?id=55630",""],[4984,"نوفمبر","https://www.poetsgate.com/ViewPoem.aspx?id=183238",""],[4984,"الْعَهْدُ الْجَدِيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=209104",""],[709,"هذَا الْحِمى فَانْزِلْ عَلَى جَرْعائِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=2903",""],[5596,"القمر والأهلة","https://www.poetsgate.com/ViewPoem.aspx?id=205610",""],[5596,"مكة الغيث","https://www.poetsgate.com/ViewPoem.aspx?id=206191",""],[6093,"قلقٌ تجذَّرَ في الفؤادِ وفي الحشا","https://www.poetsgate.com/ViewPoem.aspx?id=176519",""],[6164,"الراحل المقيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66029&r=&rc=39",""]],"verses":[["فَجَبَهناهُمُ بِضَربٍ كَما يَخرُجُ","مِن خُربَةِ المَزادِ الماءُ",0,"ا",2,0],["فَجَبِينُهُ صُبْحٌ وطُرَّتُه دُجىً","وقَوامُه غُصْنٌ رطيبٌ أهيَفُ",1,"ف",1,0],["فَجُبتُ إِلى سُدفَةٍ سُدفَةً","وَخُضتُ إِلى سَبسَبٍ سَبسَبا",2,"ب",2,0],["فجُبْتَ الغَمامَ وجُبتُ الغرامَ","حنانيك ليس سُرىً من سُرى",3,"ا",1,0],["فجبين زاهر والجفن فاتر","وفم يغري وشعر عسجدي",4,"ي",1,0],["فجبالُنا وسهولُنا وغياضُنا","أبداً تُردِّدُ من صداهُ رَنينا",5,"ن",2,0],["فجُب وادياً ما سار فيه ابنُ كوكبٍ","به الحزمُ إلّا جَلَّ عن طينةِ التُرب",6,"ب",1,0],["فَجِبالُها من حِلمِهِ وَبِحارُها","مِن جودِهِ وَرِياضِها من خُلقِهِ",7,"ق",2,0],["فجبهتموني بالقبيح مِلالةً","هذا جزاءُ المُكثرِ المتمادي",8,"د",2,0],["فجبال تلت جبالا تلتها","غيرها كالغيوم في نيسان",9,"ن",1,0],["فجبريل إحدى التشكيلات لاسمه","وإن كان في الإجمال روح الوساطيه",10,"ي",2,0],["فجبين بالبها قد أشرقا","عسجدا ينحل درا في السحر",11,"ر",1,0],["فجبلي زرودٍ فالطليحة فاللوى","فإن لها عندي يداً وهنات",12,"ت",1,0],["فجبينُك المَيمونُ يمنحُه السّنا","وعُلاكَ يرفعُه لأوجِ سنائِهِ",13,"ا",3,0],["فجبينُه أَبْهَى بثاقِب نُورِه","ويمينُه أَنْدى بفيضِ رِغَابِها",14,"ب",3,0],["فجبينه إن شمته متلألئا","قلت السعادة من جبين محمد",15,"د",1,0],["فَجَبَرتَ ما كَسرَ الزَّمانُ وَرِشتَ ما","حَصَّ الوَرَى فَما لَهُم مِن حارِمِ",16,"م",1,0],["فجبال هذا من رصانة حلمه","وعباب هذي من نداه المخصب",17,"ب",1,0],["فَجَبهَتها شَمسٌ وفي كُلِّ وَجنةٍ","فَشَمسانِ فَالمَجموعُ خَمسُ شموس",18,"س",1,0],["فَجِبالِ وَيمَةَ ما تَزالُ مُنيفَةً","يا لَيتَ أَنَّ جِبالَ وَيمَةَ تُنسَفُ",19,"ف",1,0],["فجبت بنته بحق جلي","ما ذكرتم من غير نهب وبين",20,"ن",1,0],["فجبينُه من بِشرِه","كالبدرِ في فلكِ الجنوب",21,"ب",1,0],["فجبه للظغاة بها وجوهاً","وجدع للظلال بها حثاما",22,"م",2,0],["فجبالها أنتم إذا ما رجفة","خيفت وأنتم برء كل سقام",23,"م",1,0],["فجبال الملك بينهما","شامخات الهضب والقلل",24,"ل",1,0],["فجُبْنَ بيَ الآفاقَ حَتَّى وردنَ بي","رِحابَ أبِي تيمورَ نِعْمَ الفتى البَرّ",25,"ر",1,0],["فجبرت ما في جوفها من مكرهم","وجعلت ذكرك ناسياً أوطانها",26,"ن",3,0],["فَجَبُنَّ مِنهُ وَاِنقَبضنَ تَحَيُّراً","مَكرَ المُخادِعِ يَبتَغي مَن يَخدَعُ",27,"ع",1,0],["فجبينها طرس المحا","سن والبها فيه مسطر",28,"ر",1,0],["فجبهتنا وأنفٌ واليدانِ","وركبتنا كذا الرجلان ماسِدْ",29,"د",1,0],["فَجَبهَتَها قَعب عَبيق اِذا اِنكَفا","وَقَد غارَت العَينانِ تَحتَ الحَواجِب",30,"ب",1,0],["فجب في الأرض وابغِ بها علوماً","ولا تلفتك عن هذا الدُّسوتُ",31,"ت",1,0],["فجبت المروج بروح الصبا","وأطربت وردي بأنشودتي",32,"ت",2,0],["فجبرئيل الوهم لا يرقى إلى","أدنى الذي قد ارتقت علياؤها",33,"ا",3,0],["فَجِبَاهٌ لِغَيرِ رَبٍّ تُصَلِّي","وبُطُونٌ بغير أَجرٍ تَصُومُ!",34,"م",1,0],["فجباهنا إن عفرت","لله أعظم منزلة",35,"ل",2,0],["فجبهة التحرير احتذت طرقا","عمَّت بكل الدروب والسبل",36,"ل",1,0],["فجبالها بالكبرياء توشحت","عجز الغزاة القادمون حيالها",37,"ل",3,0],["فجبينكَ الميمونُ يمنحهُ السّنا","وعلاكَ يرفعهُ لؤوجِ سنائهِ",38,"ا",3,0],["فجبينه ببهائه وصفائه","لما بدا في نوره كهلاله",39,"ل",2,0],["فجبال مكة دُكدكت فتفتت","أكبادها جزعاً بما هو أثقل",40,"ل",1,0],["فجبهتني ظلماً وصمتيَ طاعةٌ","وتبعت من كذبَ الحديثَ ورقَّشا",41,"ش",2,0],["فَجُبْتَ الذُّرَى حتى افْتَرَعْتَ سنامَها","وجابُوا سُفوحاً أَمْحَلَتْ وفيافيا!",42,"ي",2,0]]}