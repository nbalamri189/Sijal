{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55160","الكامل"],[519,"ضربوا القباب وطنبوها بالقنا","https://www.aldiwan.net/poem20802.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122615","الطويل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130094","الطويل"],[5431,"وحقك لاتعتب....","https://www.poetsgate.com/ViewPoem.aspx?id=214590",""]],"verses":[["أَبُزَرْجُمُهْرَ حَكِيمُ فَارِسَ وَالْوَرَى","يَطَأُ السُّجُونَ وَيَحْمِلُ الأَغْلاَلاَ",0,"ل",2,0],["أبِزَعْمِكُم أنّا يغيّرُنا النّوى","فوَحقِّكُم ما زالَ عنكمُ عهدُنا",1,"ن",2,0],["أبزَّ على أدهَى الدُّهاةِ فما عسى","مُغيرتُها أو عَمروها أو قَصيرها",2,"ر",3,0],["أبٌ زاد في الإحسان حتّى حَسِبتهُ","لكلِّ جليل من فضائلنا أبا",3,"ب",2,0],["أبزّ عنان الشك كالسهم مسرعا","إلى طيِّ ما أخفتْ غيوبٌ توطُّؤا",4,"ا",1,0]]}