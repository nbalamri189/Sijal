{"poems":[[53,"أيا من له الشرف المستقل","https://www.aldiwan.net/poem65882.html","المتقارب"],[30,"رأى عبد قيس خفقة شورت بها","https://www.aldiwan.net/poem5050.html","الطويل"],[366,"حليف العلا ان الفؤاد مصاب","https://www.aldiwan.net/poem68137.html","الطويل"],[466,"وإني وإن لم تنصفوا في حكومتي","https://www.aldiwan.net/poem16404.html","الطويل"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76658","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67982","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[5956,"أ أنتِ بقربي ؟","https://www.poetsgate.com/ViewPoem.aspx?id=183476",""]],"verses":[["ولكنّ ظنّك بي لا يزا","لُ أسوأَ ظنّك أو أستقلُّ",0,"ل",1,0],["وَلَكِنَّ ظِربى عِندَها يَصطَلونَها","يَصُفّونَ لِلزَربِ الصَفيحَ المُسَنَّدا",1,"د",2,0],["وَلكن ظَنّي بل يَقيني أَنَّني","لكل الَّذي أَدعوكَ فيه مُجاب",2,"ب",1,0],["ولكنْ ظَننْتُمْ أنَّ كُلَّ مَوَدَّةٍ","خداجٌ إذا لم تَقتَرِنْ بِلقاءِ",3,"ا",2,0],["ولكن ظنون ساعدتها نمائم","كما ساعدت مثنى المثاني المثالث",4,"ث",1,0],["ولكن ظروفُ الدهرِ تُعرِب للفتى","بما بَيْنَ جنبيها جَهاراً وتُنْذِر",5,"ر",1,0],["ولكن ظل هكطورٌ","لدى الأبواب محتدما",6,"م",2,0],["ولكنْ ظُلِمنا معاً قانعِينَ","بما الله في عمرنا يقْسمُ",7,"م",1,0]]}