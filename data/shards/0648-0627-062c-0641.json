{"poems":[[3,"فؤاد لا يسليه المدام","https://www.aldiwan.net/poem206.html",""],[75,"ألم يأن أن يبكي الغمام على مثلي","https://www.aldiwan.net/poem11932.html","الطويل"],[74,"أما وتلفت الرشاء الغرير","https://www.aldiwan.net/poem18712.html","الوافر"],[93,"تركت النجم مثلك مستهاما","https://www.aldiwan.net/poem62741.html","عموديه"],[45,"طوال قنا تطاعنها قصار","https://www.aldiwan.net/poem9568.html","الوافر"],[63,"ليالينا بأحياء الغميم","https://www.aldiwan.net/poem51454.html","الوافر"],[92,"أطِل مكثاً","https://www.poetsgate.com/ViewPoem.aspx?id=179234",""],[93,"بلادي","https://www.poetsgate.com/ViewPoem.aspx?id=53276",""],[132,"إليك فعيني دمعها ليس يقلع","https://www.aldiwan.net/poem50578.html","الطويل"],[164,"عيون المها ردى سهامك من نحر","https://www.aldiwan.net/poem58986.html","الطويل"],[168,"عيون ما يلم بها الرقاد","https://www.aldiwan.net/poem67847.html","الوافر"],[214,"فؤاد قد أضر به التنائي","https://www.aldiwan.net/poem13441.html","الوافر"],[214,"مصاب لا يشابهه مصاب","https://www.aldiwan.net/poem13510.html","الوافر"],[228,"أمير الشعر لا نور وحق","https://www.aldiwan.net/poem41613.html","الرمل"],[248,"إني على رغم الوشاة لقائل","https://www.aldiwan.net/poem2053.html","الكامل"],[287,"على حبكم عادلي عاذلي","https://www.aldiwan.net/poem32670.html","المتقارب"],[354,"شاغل القلب هوى عذب اللمي","https://www.aldiwan.net/poem16030.html","الرمل"],[376,"تولى بتهويمة الهائم","https://www.aldiwan.net/poem57151.html","المتقارب"],[385,"أبرق سرى وهنا فهيج أشجاني","https://www.aldiwan.net/poem48778.html","الطويل"],[422,"أرى هذي النياق لها حنين","https://www.aldiwan.net/poem53913.html","الوافر"],[463,"حب إليها بالغضا مرتبعا","https://www.aldiwan.net/poem56125.html","السريع"],[482,"عليل الوجد عندك لا يعاد","https://www.aldiwan.net/poem15313.html","الوافر"],[495,"إما ترى رأسي أزرى به","https://www.aldiwan.net/poem658.html",""],[500,"ليهنك عهد لا يضاع وإن نأت","https://www.aldiwan.net/poem10235.html","الطويل"],[519,"أتنكر بأس أحداق العذارى","https://www.aldiwan.net/poem20826.html","الوافر"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38144","البسيط"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59749","الوافر"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67828","الطويل"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132826","الوافر"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111910","الخفيف"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100974","الوافر"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52029","البسيط"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71038","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109409","الطويل"],[190,"","https://poetry.dctabudhabi.ae/diwan/poem/98584","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100287","الوافر"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104391","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62936","المتقارب"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62853","السريع"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91295","البسيط"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36715","المنسرح"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73198","الوافر"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83633","الوافر"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33560","الوافر"],[194,"ما بالُ عَينٍ شَوقُها استَبكاها","https://www.poetsgate.com/ViewPoem.aspx?id=51514",""],[5689,"لمذا خلقت لماذا أعود","https://www.poetsgate.com/ViewPoem.aspx?id=143408",""],[5790,"أظن البدر لما لحت حارا","https://www.poetsgate.com/ViewPoem.aspx?id=112046",""],[6031,"أَمَا لفراقِنا هذا اجتماعُ","https://www.poetsgate.com/ViewPoem.aspx?id=46298",""]],"verses":[["وَأَجفانٌ تَبيتُ مُقَرَّحاتِ","تَسيلُ دَماً إِذا جَنَّ الظَلامُ",0,"م",1,0],["وَأَجفى عَلى نَظمي لِكُلِّ قِلادَةٍ","مُفَصَّلَةِ السِمطَينِ بِالمَنطِقِ الفَصلِ",1,"ل",1,0],["وأجفانٌ مؤنثةٌ ولكن","تقابلنا بأسيافٍ ذكور",2,"ر",1,0],["وَأَجفو القَصرَ يُلزِمُني هَواناً","وَأَهوى العِزَّ يُلزِمُني الحِماما",3,"م",2,0],["وَأَجفَلَ بِالفُراتِ بَنو نُمَيرٍ","وَزَأرُهُمُ الَّذي زَأَروا خُوارُ",4,"ر",1,0],["وأجفانٌ إذا لحظَت جُسوماً","خَلعنَ سَقامَهن على الجُسومِ",5,"م",1,0],["وأجفانٌ ترِفُّ على عُيونٍ","تغورُ كما تَغوَّرَتِ الكهوف",6,"ف",1,0],["وأجفوا القصر يلزمني هوانا","وأهوى العزّ يلزمني الحماما",7,"م",2,0],["وأجفانُ عين بالبكاءِ قريحةٌ","مدى الدهرِ لا يَرْفها لها قطُّ مَدْمَعُ",8,"ع",1,0],["وأجفان عين قد تجافت عن الكرى","فما تلتقي إلا على دمعة تجرى",9,"ر",2,0],["وَأَجفانٌ مِنَ الدُرِّ اِستَفادَت","ضِياءً مِثلُهُ ما يُستَفادُ",10,"د",1,0],["واجفان ينصل البين جرحى","لفرط الحزن تذرف بالدماء",11,"ا",2,0],["واجفان تغشاها سهاد","واحشاء تحشاها التهاب",12,"ب",1,0],["وَأَجفانُ السُموأَلِ فيهِ تَبكي","وَأَدمُعِها شكاياتٌ وَعِشقُ",13,"ق",1,0],["وأجفلنَ من غَيرِ ائتمارٍ وَكُلُّها","لَهُ من عُبابِ الشَدِّ حِرزٌ وَمعقِلُ",14,"ل",1,0],["وَأَجفانُهُ مُشهِراتٌ ظُباً","قَواطِعَ كَالقَدَرِ النازِلِ",15,"ل",1,0],["وَاِجفُ مَن لي وُدَّ نَدّاً نَصَبوا","وَتَداعوا هُبُلاً أُعلي عَلَي",16,"ي",1,0],["وأَجفانُ عَينيك طائِيَّةٌ","لَها نَظَراتٌ إلى حاتِمِ",17,"م",1,0],["وَأَجفانُهُ تَبني عَلي الكَسر دائِماً","كَما أَعرَبَت بِالفَتح في الليل أَجفاني",18,"ن",2,0],["وأجفانٌ بِعَبْرَتها رواءٌ","وأحشاءٌ بزفرتها ظِماء",19,"ا",2,0],["وأجفلتْ عنّي صروفُ زمني","مذ قمتَ دوني بطلاً مقنَّعاً",20,"ع",2,0],["وأجفانٍ مِنَ التفريقِ أمسى","تَوالي الدمعِ وهو لها عَتادُ",21,"د",1,0],["وَأَجفَلَ القَومُ نَعامِيَّةً","عَنّا وَفِئنا بِالنِهابِ النَفيس",22,"س",1,0],["وأجفان عين لا ترى الشمس غيره","إذا هي من تلقاء أرضك تطلع",23,"ع",1,0],["وأجفانٌ كسُحبِ نَدى عليٍّ","إذا اِستمْطرْتَها مطرَتْ نُضارا",24,"ر",2,0],["وَاِجْفُ اِعتَمادَك ما في الذّهن تَخزِنُهُ","فَقَد يُقالُ بِأَنّ الذّهنَ خوّانُ",25,"ن",1,0],["وأجفاني تصوبُ دماً","وأضلاعي ترى خنقه",26,"ق",2,0],["وَأجْفَانُ عَيْني بِالبُكَاءِ تَأَرَّقَتْ","أُنَادِي وَلي نَفْسٌ إلَيْهِمْ تَشَوَّقَتْ",27,"ت",1,0],["وأجفانٌ تُرَوِّي كلَّ شيءٍ","سوى قلبٍ إلى الأخبار صادي",28,"د",2,0],["واجفاً بين رهبةٍ ورجاءٍ","فهو بين الإحجامِ والإقدامِ",29,"م",1,0],["وأجفانٌ أجف الدمع فيها","جوىً بالضلوع له التياح",30,"ح",1,0],["وأجفَلَتْ زُمَرُ الأعْرَابِ قَاطِبَةً","تَهوِي أمَامَكَ تَحتَ اللَّيلِ تَنسَحِبُ",31,"ب",1,0],["وأَجْفَلَ عنهم ذا السواد الذي غدا","كمُهْمَل مَعْزٍ في الفلاة وشاءِ",32,"ا",2,0],["واجفانه بالغمز أوحت لمهجتي","رموزاً بغير الفتك لن تناولا",33,"ل",2,0],["وأجف رتاجك وانقبض","إلا على وجه المجاز",34,"ز",1,0],["وأجفاناً مؤرقة تعدُّ ال","كواكب فهي لم تألف هجودا",35,"د",2,0],["وأجفان لذكركم","متى استمطرتها مطرت",36,"ت",1,0],["وأَجفلتِ الخيلُ عن فارسٍ","تُكسِّرُ فيه العَوالي قِصَدْ",37,"د",1,0],["واجفُ الهُوينا مركباً انَّها","مَطِيَّةُ المُضْطَجعِ الفاتِرِ",38,"ر",1,0],["وَاجف الأَماني وَخذ بالجد واعط بِهِ","فَالجدّ بالجدّ حامي النَفس عَن نَدَم",39,"م",1,0],["وَاِجفُ أَخا الفَضلِ كَي تَنالَ مُنى","وَاِصحَب أَخا الجَهلِ يَسعَدِ الطالِع",40,"ع",1,0],["وأجفاناص مريضاتٍ مراضاً","تَرى في ضِمنِ صِحتَّها انكسارا",41,"ر",2,0],["وأجفانٌ مكحَّلةٌ بِسِحرِ","حَبيبي في الوُجودِ مليكُ أَمري",42,"ر",2,0],["وأجفانا تَرى الدَّمعَ","على مُقلتِها خيما",43,"م",2,0],["وَاَجفَلَت مُضطَمِراً قُطراها","وَبَلدَةٍ خاشِعَةٍ صُواها",44,"ا",3,0],["وأجفو سعودي حتى تصد","رجعت أنوح لصد السعود؟",45,"د",1,0],["وأجفانا مريضاتٍ صحاحا","ترى في ضمن صحتها انكسارا",46,"ر",2,0],["وأجْفَاناً مُؤرَّقَةً دَوَاماً","لهَا عَنْ خاطِبِ الغَمْضِ امتِنَاعُ",47,"ع",1,0]]}