ظ عهده",144,"د",2,0],["وإِنِّي على قول الخَنَا أَيُّ مبطِىءِ","وإِنِّي إِلى بذلِ اللُّهى أَيُّ عجلان",145,"ن",1,0],["وإِني على دين الوفاءِ لثابت","وإِني من حسن العزاء لفَرَّارُ",146,"ر",1,0],["وإِنِّي عَلَى ما ذُقْتُ من أَلَم الهَوَى","وقاسَيْتُ مِنْه كُلَ مُبْكٍ وَمُضْحِكِ",147,"ك",1,0],["وإِني عَزَمْتُ عَلى سَفْرةٍ","أَرَى وجهَ إِقْبالِها يُسْفِر",148,"ر",1,0],["وإِنِّي عبدٌ لم أَزلْ فيكَ قائِلاً","قصائدَ عن عَلياك غَيرَ قصائِر",149,"ر",1,0],["وإِنِّي على وعْدٍ من الله في الَّذي","أُريدُ وعنْدِ الله لا يُخْلَفُ الوَعْد",150,"د",1,0],["وإِنيَ عبدٌ لم أَزَلْ فيكَ قائماً","بمَدْحِكَ أَشْدُو أَو بحمْدكَ أَخْطُب",151,"ب",1,0],["وَإِن يَعمَر فَإِنَّكُمُ بِخَيرٍ","عَلَيكُم مِن نَوافِلِهِ فُضولُ",152,"ل",1,0],["وإنِّي عبدُ رِقٍّ في هَواكُم","بِأفعالِي وأَقوالِ اعتِقادِي",153,"د",2,0],["وَإني على حُلو التقاضي ومرّه","لراضٍ بما يرضاه كُل رَشيد",154,"د",1,0],["وَإِن يَعترضني في عروضيَ جاهلٌ","وَعرّض لي عَرضاً كَثَوب مخلَّق",155,"ق",1,0],["وَإِني عَن التَعقيد وَاللَحن صُنتُها","وَهَذَّبت مَعناها بَدرٍّ منضَّد",156,"د",1,0],["وإني على خوفي من الله واثق","بإنعامه والله أكرم منعم",157,"م",1,0],["وَإِنّي عَلى ما خَيَّلَت لَأَظُنُّها","سَيَأتي عُبَيداً بَدؤُها وَعِيادُها",158,"د",3,0],["وإني على ما فاتني غير نادم","ولو كان فيه رتبتي ووسامي",159,"م",2,0],["وإني عونك الأوفى قمين","لك النجوى وللشعر الخلود",160,"د",1,0],["وَإِنّي عَلى فَخري بِها لَمزاحِمٌ","عَلى رِفعَتي شَمسَ الضّحى بِالمَناكِبِ",161,"ب",1,0],["وَإِنْ يَعدُ فاقَ البرقَ سبقاً ولَم يَكُن","تُجاريهِ مِن ريحٍ وَلَو عَصَفَت عَصفا",162,"ف",2,0],["وَإِنّي عَلى حَمدي أديم إِقامَتي","وَأَحمَدُ مَنْ بِالمَجدِ يَسمو مَقامُهُ",163,"م",2,0],["وإنى عن طريقة كلِّ رشدٍ","لعاشٍ أي عاشٍ أيُّ عاشِ",164,"ش",1,0],["وإن يعيشوا ينشُّوا الأكرمين أذىً","إن الظرابين لم يحسنْ لها خُلُق",165,"ق",1,0],["وإني على رعي العهود وحفظْها","مقيم مدا الأيام لا أتزحزحُ",166,"ح",1,0],["وإن يعطفكُمُ نَسَبٌ الينا","فليسَ عليكم منها ظهارُ",167,"ر",1,0],["وأن يعافيني مما أحاذر في","نفسي وأهلي واخواني وابنائي",168,"ي",1,0],["وإن يعافي أحبابي ويرسل ما","في علمه م