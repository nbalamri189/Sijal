5431,"تُنار بنا الأكوان تُجلى الغياهب","https://www.poetsgate.com/ViewPoem.aspx?id=194570",""],[5463,"أنا غرامك يوم كنتي عن غرامي تبحثين","https://www.poetsgate.com/ViewPoem.aspx?id=32341",""],[5605,"مصائب حب","https://www.poetsgate.com/ViewPoem.aspx?id=159789",""],[5638,"طريق العلم","https://www.poetsgate.com/ViewPoem.aspx?id=198010",""],[5690,"تقلبت في هزل الغرام وجدّه","https://www.poetsgate.com/ViewPoem.aspx?id=172210",""],[5690,"أيا اللّه ما أحلى وأجودْ","https://www.poetsgate.com/ViewPoem.aspx?id=172151",""],[1089,"أشرت إليه هل علمتَ مودّتي","https://www.poetsgate.com/ViewPoem.aspx?id=152941",""],[5790,"سلا خاطري عن زينبٍ ونوار","https://www.poetsgate.com/ViewPoem.aspx?id=111946",""],[5790,"أيا قلب دع عشق الحبيب المبرقع","https://www.poetsgate.com/ViewPoem.aspx?id=111873",""],[5897,"محمدٌ .. يا رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=156845",""],[5952,"وحْدي","https://www.poetsgate.com/ViewPoem.aspx?id=196822",""],[5953,"فما ضيق صدر المرء فيما ينوبه","https://www.poetsgate.com/ViewPoem.aspx?id=93870",""],[5953,"سلام على أرض الحسين وحضرته","https://www.poetsgate.com/ViewPoem.aspx?id=93792",""],[5956,"الرَّصيفُ ذو الحصى العسليّ","https://www.poetsgate.com/ViewPoem.aspx?id=184884",""],[5956,"سلامة كفّك","https://www.poetsgate.com/ViewPoem.aspx?id=192416",""],[6068,"لأحلام في جوّ الغرام تردّدُ -05-","https://www.poetsgate.com/ViewPoem.aspx?id=175842",""],[6124,"الرسالة","https://www.poetsgate.com/ViewPoem.aspx?id=103197",""],[6164,"أطوار..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66060&r=&rc=69",""],[6235,"قبور الأمهات..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77690&r=&rc=5",""],[463,"أما والنقا لولا هوى ظيبة َ النقا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60160&r=&rc=216",""],[6302,"يُحيطونَ.. لكنْ..!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86233&r=&rc=31",""]],"verses":[["وأن يعيي اللسان وفيه معنىً","يغادر أي جارحة مصابا",0,"ب",2,0],["وَإِنّي عَلى ما يوجِبُ الدَهرُ لِلفَتى","وَلَو سامَهُ حَملَ الأُمورِ العَظائِمِ",1,"م",1,0],["وَإِنّي عَلى بُعدٍ بِرَميِ قَوارِضي","لَأَرغَبُ جُرحاً مِن رَمِيِّ نِبالي",2,"ل",2,0],["وَإِنّي عَلى أَن رَماني الزَمانُ","وَأَعقَبَ بِالقَلبِ جُرحاً رَغيبا",3,"ب",2,0],["وَإِنّي عَنِ الرُبعِ الَّذي لا يَضَمُّكُم","عَلى كُلِّ حالٍ نازِحُ الوِدِّ أَجنَبُ",4,"ب",1,0],["وَإِنّي عَلى شَغَفي بِالوِقارِ","أَحِنُّ إِلى خَطَراتِ الصِبا",5,"ا",1,0],["وإنّي على ما فيَّ منْ عَجْرَفيّةٍ","إذا ما التَقى الخَيْلانِ أذْكُرُ مَهْدَدا",6,"د",2,0],["وَإِنِّي عَلَى مَا نَالَنِي مِنْ قِلىً","لأَشْتَاقُ مِنْ لُقْيَاهُ نُغْبَةَ ظَمْآنِ",7,"ن",1,0],["وَإِنّي عَداني عَنكِ لَو تَعلَمينَهُ","مَوازِئُ لَم يُنزِل سِوايَ جَليلُها",8,"ل",3,0],["وَإِن يَعدُني عَنكَ شَحطُ النَوى","فَحَظّي أَخَسَّ وَنَفسي ظَلَم",9,"م",1,0],["وإِنّي عَلى سُقمي بِأَسماءَ وَالَّذي","تُراجِعُ مِنّي النَفسُ بَعدَ اِندِمالِها",10,"ل",3,0],["وَإِنّي عَلى ذاكَ التَجَلُّدِ إِنَّني","مُسِرُّ هُيامٍ يَستَبِلُّ وَيُردَعُ",11,"ع",1,0],["وإني على علم طويت سهوله","ولم أتحيّر خابطاً حزونه",12,"ن",2,0],["وأن يعيش بها الطُرطُور ذا شَمَم","وأن أسام بعيشي جدع عِرنيني",13,"ن",2,0],["وأني على ما نابني من جفائه","لأقنع منه بالخيال الذي يَسري",14,"ر",2,0],["وإنّي على حُبِيّهمُ وَتَطَلُّعِي","الى نَصرِهم أمشِي الضَراء وأختُلُ",15,"ل",1,0],["وإنّي على أنِّي أرى في تَقِيَّةٍ","أُخَالِطُ أقوَاماً لِقَومٍ لَمِزيَلُ",15,"ل",1,0],["وإنّي على إغضَاءِ عَينَيَّ مُطرِقٌ","وَصَبرِي على الأقذَاءِ وهي تَجَلجَلُ",15,"ل",1,0],["وَإِن يَعظُم مِنَ الحَدثانِ خَطبٌ","تَجِدنا فِيهِ غَيرَ مُقَلَّمِينَا",16,"ن",2,0],["وَإِنّي عَلى طولِ الشِماسِ عَنِ الصِبا","أَحِنُّ وَتُصبيني إِلَيكِ الجَآذِرُ",17,"ر",1,0],["وَأَنّي عَلى الحالَينِ في العَتبِ وَالرِضى","مُقيمٌ عَلى ماكانَ يَعرِفُ مَن وُدّي",18,"د",2,0],["وإنيَ عن ندب الأحبَّة ساكت","وإن كانَ قلبي بالأسى يتكلم",19,"م",1,0],["وإني على ظنِّي به وصبابتي","لأقنع من يدري على الطرفِ أن يجلى",20,"ل",2,0],["وإني على الإسلام منكم لَخائفٌ","بوائقَ شتّى بابُها الآن مُرتَجُ",21,"ج",1,0],["وإنِّي على رَغْمِ الأعادي لَقائلٌ","وإن أبْرَقُوا لي بالوَعِيدِ وأرعَدُوا",22,"د",3,0],["وإني على ما كان منكم لعالمٌ","بأَنِّيَ ما أخطأتُ في مدحكم رشْدي",23,"د",2,0],["وإني عليم أنّ فَرْيَ أديمه","يسيرٌ عليه ما غدا سالمَ الوَفْرِ",24,"ر",1,0],["وإني على ما كان منكَ لراجعٌ","إليك بودي شاكرٌ سالف القرض",25,"ض",1,0],["وَإِنّي عَلى مَن لا أُسَمّيهِ عاتِبٌ","فَيا رَبِّ لا يَبلُغ إِلَيهِ كَلامي",26,"م",2,0],["وَإِنّي عَلى ما سارَ مِنهُ لَعاتِبٌ","أَلَيسَ بِهِ لِلبَينِ تُحدى الأَيانِقُ",27,"ق",1,0],["وَإِنّي عَلى ذاكَ الجَميلِ لَشاكِرٌ","وَإِنّي إِلى ذاكَ الجَمالِ لَمُشتاقُ",28,"ق",1,0],["وَإِنّي عَلى هَذا الجَفاءِ لَصابِرٌ","لَعَلَّ حَبيبي بِالرِضى لِيَ راجِعُ",29,"ع",1,0],["وَإِنّي عَلى ما فِيَّ مِن وَلَعِ الصِبا","جَديرٌ بِأَسبابِ التُقى وَخَبيرُ",30,"ر",1,0],["وَإِنِّي عَن الماءِ الذي يَجمَعُ القَذَى","إِذا كانَ طَرقاً آجِناً لصَدُورُ",31,"ر",1,0],["وَإِنِّي علَى سَفحِ الدموعِ التي تُرى","لَجَلدٌ عَلى بَين الحَبيبِ صَبورُ",32,"ر",1,0],["وَإِنّي عَلى الشَيءِ الَّذي يُلتَوى بِهِ","وَإِن زَجَرَتني زَجرَةً لَوَريعُ",33,"ع",1,0],["واني على كبرتي هذه","اود لو ان حياتي تطول",34,"ل",1,0],["وإني على هذا الجمود وطوله","ألومك يا عيني وإني أعاتب",35,"ب",1,0],["وأن يعود الجسم مني","جارياً فيه دمي",36,"م",2,0],["وَإِنّي عَنكَ بَعدَ غَدٍ لَغادِ","وَقَلبي عَن فِنائِكَ غَيرُ غادِ",37,"د",1,0],["وإِنّي على ما كانَ منكم لواجدٌ","بحبِّكُمُ تاللّه وجدَ الروائمِ",38,"م",1,0],["وَإِنّي عَلى غَربي وَشَغبِ شَكيمَتي","لَمُعتَبَدٌ لِلطولِ مِنكَ ذَليلُ",39,"ل",1,0],["وَأَن يُعَلَّلَ رُكبانُ المَطِيِّ بِهِم","بِكُلِّ قافِيَةٍ شَنعاءَ تُشتَهَرُ",40,"ر",1,0],["وَإِنّي عَلى عُظمِ الرَجاءِ لَخائِفٌ","كَأَنَّ عَلى رَأسي الأَسِنَّةَ تُشرَعُ",41,"ع",1,0],["وَإِنّي عَلى صَبري عَلى فَرطِ هَجرِهِ","وَقُربِ مَغانيهِ وَبُعدِ مَرامِهِ",42,"م",2,0],["وَإِنّي عَهِدتُكَ نَجلَ الجِيادِ","لِذَلِكَ أَطلُبُ مِنكَ الإِجادَه",43,"د",2,0],["وَإِنّي عَلى بُعدِ الدِيارِ وَقُربِها","أُطارِحُ فيكُم فِكرَتي وَتُطارِحُ",44,"ح",1,0],["وإنّي عَلَيْهِ لُمسْتَدركٌ","من البثِّ والحزْنِ ما أهملوهُ",45,"و",2,0],["وإنْ يَعْرِضِ البعضُ من سيرها","تَرَ العِيسَ من خلفها تَنقَرِض",46,"ض",1,0],["وَإِنّي عَلى هِجرانِها وَصُدودِها","وَما حَلَّ بي مِنها أَرى حُبَّها حَتما",47,"م",2,0],["وَإِنّي عَلى لَيلى لَزارٍ وَإِنَّني","عَلى ذاكَ فيما بَينَنا مُستَديمُها",48,"ه",2,1],["وَإِن يَعفُ لا يَندَم وَإِن يَسطُ يَنتَقِم","فَهَل عادِلٌ فيها بِما أَنتَ واقِعُ",49,"ع",1,0],["وَإِنّي عَلى طولِ إِخلافِها","لَأَرجو الوَفاءَ وَلا أَحقُدُ",50,"د",1,0],["وَإِنّي عَداني عَن لِقائِكِ حادِثٌ","وَهَمٌّ أَتى مِن دونِ هَمَّكِ شاغِلُ",51,"ل",1,0],["وإني على شيخوختي وَزَمانتي","أُريد بِشعري في الحياة التجددا",52,"د",2,0],["وإني عَلى ما بي من الحر وَالصدى","لأنظر ماءً ما إِليه سَبيل",53,"ل",1,0],["وإِني علَى ما هاجَ صَدْرِي وغاظنِي","ليأْمَنُنِي مَن كانَ عِنْدِي له سِر",54,"ر",1,1],["وَإِنّي عَزيزُ الجارِ في كُلِّ مَوطِنٍ","وَأُكرِمُ نَفسي أَن يَهونَ مَقامي",55,"م",2,0],["وَإِن يَعيبوا سَواداً قَد كُسيتُ بِهِ","فَالدُرُّ يَستُرُهُ ثَوبٌ مِنَ الصَدَفِ",56,"ف",1,0],["وَإِنِّي عَلَى مَا كَانَ مِنْ سَرَفِ النَّوَى","لَبَاقٍ عَلَى وَدِّي لِمَنْ كُنْتُ أَصْطَفِي",57,"ف",2,0],["وَإِنِّي عَلَى مَا كَانَ مِنْكَ لَصَابِرٌ","لعِلْمِيَ أَنَّ الْفَوْزَ مِنْ ثَمَرِ الصَّبْرِ",58,"ر",1,0],["وَإِنِّي عَلَى مَا كَانَ مِنْ سَرَفِ الْهَوَى","لَذُو تُدْرَأ في النَّائِباتِ مُغِيرُ",59,"ر",1,0],["وَأَنَّى عَلَى فَقْرٍ تَعِفُّ طَهَارةً","ولاَ عِفَّةٌ إِلاَّ بِرِيٍّ وَمَشْبَعِ",60,"ع",1,0],["وَأَنْ يُعْمَرا عُمْراً طَوِيلاً وَيَلْبَثَا","بِنُعْماءِ تُفْضِي كُلَّ يَوْمٍ إِلى غَدِ",61,"د",1,0],["وَإِنّي عَلَيكَ لَجاري الدُموعِ","وَإِنّي عَلَيكَ لَصَبٌّ وَصِب",62,"ب",1,0],["وأنْ يعتاضَ عن جيل بجيلٍ","بها ، ويفضََّ بينهما النزاعا",63,"ع",2,0],["وأني عرَّسوا أسرى إليهم","يُطيلُ عذابَهمْ وجهٌ مُخيف",64,"ف",1,0],["واني على أنَّ البلادَ جميلةٌ","تروق كما ازدادت من الدلِّ مِكسال",65,"ل",1,0],["وأنّي عُودٌ بكفِّ الرياحِ","يسأل منها متى يُقصَم",66,"م",1,0],["وإني على قدْر ما كان","بالفُجاءاتِ مِن قَسوةٍ كان بي",67,"ب",2,0],["وإني على أن هذا المزاج","رمانيَ بالمُرهِق المُنْصِب",67,"ب",1,0],["وَإِني عَلى ما كانَ أَوَّلُ أَوَّلي","عَلَيهِ كَذاكَ القَرمُ يُنتَجُ لِلقَرمِ",68,"م",1,0],["وإن يَعْصِه عمداً جَهاراً ولم يتب","ومات مصرّاً يَصْلَ نار جهنما",69,"م",2,0],["وإنِّي على العهد القديمِ لحافظٌ","وست بناسٍ ودّكم لو نسينُما",70,"م",2,0],["وإني على عهده ثابتٌ","مقيمٌ ولو عشت عمراً طويلْ",71,"ل",1,0],["وإني على رغْم الحسودِ وضدكم","بكِّفى ثمارَ الجود منكم لقاطفُ",72,"ف",1,0],["وإني عَاذِرٌ لَكُمُ فَأنتُم","جَعَلتُم مِن فُرُوعِكِمُ أُصُولا",73,"ل",2,0],["وأن يعافى مرضانا ويُهلكُ أع","دانا ويشمل موتانا بغفرانِ",74,"ن",1,0],["وإني على بعد الديار وربها","وتغيير مغتاب وتغيير عاتبِ",75,"ب",1,1],["وإِني على ما تعهدون من الهوى","ومن لي بأن يرعي كرعي له العهدُ",76,"د",1,0],["وانى على ظهر الطريق مسافر","وما الزاد مثل الرزق يطلب دائما",77,"م",2,0],["وإن يعاجله مهم فنأى","أوصى له بقاطع أوصالهُ",78,"ل",2,0],["وإني على بيض السيوف لباسل","وإن كنت عن سود العيون جبانا",79,"ن",2,0],["وان يعتريك العجب أيضا بكونها","على ما حوته من رياء وسمعة",80,"ه",1,0],["وَإِن يَعتَلِل يَوماً يقولوا عقوبةٌ","لشرِّ الّذي يَأتي وما هوَ فاعلُ",81,"ل",1,0],["وَإِنّي عَلى أَحسابِهِم وَعُلاهُمُ","غَيورٌ وَعَن بَحبوحَةِ المَجدِ ذائِدُ",82,"د",1,0],["وَإِنّي عَلى أَهلِ العُلا ذُو حَمِيَّةٍ","أُجَرِّدُ سَيفي دُونَهُم وَلِسانِيا",83,"ي",2,0],["وَإِنّى عَلَى رَغمِ العُدَاةِ بِأَنقُعٍ","شِفَاءً لِحَومَاتِ الصَّدَى لَشَرُوبُ",84,"ب",1,0],["وإن يعتللْ يوما يقولوا عقوبة","لسيء ما يأتي وما هو فاعل",85,"ل",1,0],["وَاَن يَعُمَّهُم حَياً مُطَبِّقُ","بَل قَد رَأَى بِهَجَرَ المُغَيَّقُ",86,"ق",1,1],["وَإِنّي عِندَ بَأسي لُمتُ نَفسي","وَلومُ النَفسِ لا يُغني قِبالا",87,"ل",2,0],["وان يعد تلقه وفيا","اوفى الورى نائلا ووعدا",88,"د",2,0],["وإني عليها والمُهَنَّدُ في يدي","وخطيّةٌ قد يَنْطحُ النَّجْمُ طولُها",89,"ل",3,0],["وإني على ما بي إليهنّ من جَوىً","بكّل عفافٍ كاملٍ لجَدير",90,"ر",1,0],["وانّي عَلى ما حَمَّلَتهُ لَصابِرٌ","وان كُنت لا أَبقى عليه وَلا أَقوى",91,"و",2,0],["وإنّي على شوقٍ لمعهد قربه","ومازلت أرعى العهد في القرب والبعد",92,"د",1,0],["وإنّي على عهدي أهيم بحبّه","غراماً ويا ويل الشجيّ من الخلي",93,"ل",2,0],["وإني عن البيضِ الغواني لفي غِنَىً","لأن الهوى فيهِ الخيانةُ والمكر",94,"ر",1,0],["وإني على البَلوى صبورٌ لأنني","سَلوتُ بقولي الخطبُ يحمِلهُ الحرُّ",94,"ر",1,0],["وإنّي على ما قد جنيتُ لواثقٌ","بِسَهل السَجايا منك لا بعُرامها",95,"م",3,0],["وإِنّي على ما بي من الوَجدِ والأَسى","لذو مِرَّة لا يستفزُّنيَ الدَهرُ",96,"ر",1,0],["وَأَن يعيدَ أميرُ المؤمنين له","مَفاخراً في جباهِ الدهرِ ترتسمُ",97,"م",1,0],["وأني على حكم الحوادث نازل","تسالمني طوراً وطوراً تحارب",98,"ب",1,0],["وأني عزيز بابن ماساي مكثر","وإن هان أنصار وبان خليل",99,"ل",1,0],["وإني على ما في من صلف لها","لراغبة في الوصل أعظم رغبة",100,"ه",1,0],["وَإِن يَعُد يا هَنانا","فَذاكَ عيدُ الأَنامِ",101,"م",1,0],["وَإِنّي عَداني عَنكُمُ غَيرَ ماقِتٍ","نَوارانِ مَكتوبٌ عَلَيَّ بُغاهُما",102,"م",2,0],["وَاِنّي عَلى جلو الغَرامِ وَمَرّة","صَبور وَما بي في كلا الحالتَيَن بي",103,"ب",2,0],["وأن يَعتَدَّ أيَّامَ التّهاني","بعِدَّتها إذا ما الحَوْلُ حالا",104,"ل",2,0],["وإنّي على شُكْري لهنّ مُثابِرٌ","طُوالَ اللّيالي ما أقامَ ثَبير",105,"ر",1,0],["وإنّي على حالٍ كما تَشْتَهونَهُ","نَسُرُّ ولكنّ الغريبَ غَريبُ",106,"ب",1,1],["وإنّي على ما بي ليَجْذِبُ همتّي","إلى الشّرفِ العالي من المجدِ جاذب",107,"ب",1,0],["وَإِنّي عَلى الأَيّامِ فيها لَعاتِبٌ","وَحاشا لِذاكَ الوَجهِ مِن أَلَمِ العَتبِ",108,"ب",1,0],["وَإِنّي عَلى تِلكَ المُوالاةِ ثابِتٌ","وَلَستُ وَإِن أَقصَيتَني أَتَزَحزَحُ",109,"ح",1,0],["وإنِّي عَلى ما كانَ منِّي لَمِنكُمُ","فيا نَفثةَ المَصدُورِ قَد هجتِ فاسكُني",110,"ن",2,0],["وَإِني عَلى ما بي لَأَرعى وِدادَهُم","وَإِن أَلفوا فَقدي وَإِن ضَيعوا وَدي",111,"د",2,0],["وَإِني عَلى فَقد النَعيم لَصابِرٌ","وَلَستُ عَلى فَقد الأَخِلاءِ بِالجلد",111,"د",1,0],["وَإِن يَعزّ في الفَيافي مَورِدٌ","فَدَمعُهُ لِلعيس أَوفى وَرد",112,"د",1,0],["وإني على أخذِ الغرام بمقْودي","لأَصْبو إلى المجد المؤثّل والفضْلِ",113,"ل",1,0],["وإني على ما كان يعهد خامل","ولم أتحول عن طريقي وعن وضعي",114,"ع",2,0],["وإني على شرط المودة والإِخا","وإن كانت الأجساد منها على بُعْدِ",115,"د",1,0],["وَإِنّي عند مَقدِرَتي وَوَجدي","بهنَّ مَع الشَبيبَة وَالغَرامِ",116,"م",1,0],["وإنِّي على هذا التجنّي لصابر","وأحملُ عِبءَ الوجد لا أتكلَّف",117,"ف",1,0],["وإنِّي على ما بي فقد يستفزّني","غرامٌ بسلمى حادث وقديمُ",118,"م",1,0]