ا صرفا ودع مزجها عنا","https://www.aldiwan.net/poem46357.html","الطويل"],[440,"هناء أيها الملك السعيد","https://www.aldiwan.net/poem2544.html","الوافر"],[451,"أناديك هل تدرين ما سبب النّدا ؟","https://www.aldiwan.net/poem1015.html",""],[454,"أيا ليلة باتت تساهم مقلتي","https://www.aldiwan.net/poem13958.html","الطويل"],[460,"أما والنقا لولا هوى ظيبة النقا","https://www.aldiwan.net/poem56097.html","الطويل"],[460,"لمن صاغيات في الحبل طلائح","https://www.aldiwan.net/poem56246.html","الطويل"],[463,"سألت ربي ورب الناس كلهم","https://www.aldiwan.net/poem15430.html","البسيط"],[463,"واني على همي بعصري وأهله","https://www.aldiwan.net/poem15938.html","الطويل"],[466,"نسيم الصبا والليل منتظم العقد","https://www.aldiwan.net/poem3176.html","عموديه"],[466,"ألمت سليمى والنسيم عليل","https://www.aldiwan.net/poem3634.html","عموديه"],[472,"وإني لمكرام لسادات مالك","https://www.aldiwan.net/poem4634.html","الطويل"],[484,"أقمت بدار كي أصون حقائق","https://www.aldiwan.net/poem24286.html","الطويل"],[502,"تعلم مني النوح في مذهب الهوى","https://www.aldiwan.net/poem37810.html","الطويل"],[507,"المقاوم","https://www.aldiwan.net/poem56770.html","الطويل"],[531,"أنا المذنب الجاني على حالة","https://www.aldiwan.net/poem37542.html","الطويل"],[540,"رعى الله أيام الصبا واللياليا","https://www.aldiwan.net/poem47491.html","عموديه"],[553,"تراءت لنا بالأبرقين بروق","https://www.aldiwan.net/poem47376.html","الطويل"],[553,"أظنك من جدوى الأحبة قانطا","https://www.aldiwan.net/poem47729.html","الطويل"],[560,"لقد قيل لي ما الفرق عند أولي الذكر","https://www.aldiwan.net/poem34496.html","الطويل"],[560,"سلام عظيم من عظيم تفردا","https://www.aldiwan.net/poem34594.html","الطويل"],[560,"أطوف على ذاتي بكاسات خمرتي","https://www.aldiwan.net/poem34733.html","الطويل"],[566,"فؤادي قد أغواه من بعد رشده","https://www.aldiwan.net/poem901.html",""],[577,"أيا دمع عيني لا تكن بعد إخواني","https://www.aldiwan.net/poem2776.html","الطويل"],[577,"أيا دار في جنات عدن له دار","https://www.aldiwan.net/poem2783.html","الطويل"],[577,"بنفسي من فارقت فيه تماسكي","https://www.aldiwan.net/poem2901.html","الطويل"],[577,"أناخ بها البارق الممطر","https://www.aldiwan.net/poem3067.html","المتقارب"],[577,"تنزه طرفي بين زاه وزاهر","https://www.aldiwan.net/poem3073.html","الطويل"],[577,"نعم هي سعدي وهي لي قمر سعد","https://www.aldiwan.net/poem3086.html","الطويل"],[577,"على كل حال ليس لي عنك مذهب","https://www.aldiwan.net/poem3109.html","الطويل"],[620,"","https://poetry.dctabudhabi.ae/diwan/poem/29483","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/28076","الطويل"],[860,"","https://poetry.dctabudhabi.ae/diwan/poem/17738","الطويل"],[1188,"","https://poetry.dctabudhabi.ae/diwan/poem/89644","الطويل"]],"verses":[["وأن يعيي اللسان وفيه معنىً","يغادر أي جارحة مصابا",0,"ب",2,0],["وَإِنّي عَلى ما يوجِبُ الدَهرُ لِلفَتى","وَلَو سامَهُ حَملَ الأُمورِ العَظائِمِ",1,"م",1,0],["وَإِنّي عَلى بُعدٍ بِرَميِ قَوارِضي","لَأَرغَبُ جُرحاً مِن رَمِيِّ نِبالي",2,"ل",2,0],["وَإِنّي عَلى أَن رَماني الزَمانُ","وَأَعقَبَ بِالقَلبِ جُرحاً رَغيبا",3,"ب",2,0],["وَإِنّي عَنِ الرُبعِ الَّذي لا يَضَمُّكُم","عَلى كُلِّ حالٍ نازِحُ الوِدِّ أَجنَبُ",4,"ب",1,0],["وَإِنّي عَلى شَغَفي بِالوِقارِ","أَحِنُّ إِلى خَطَراتِ الصِبا",5,"ا",1,0],["وإنّي على ما فيَّ منْ عَجْرَفيّةٍ","إذا ما التَقى الخَيْلانِ أذْكُرُ مَهْدَدا",6,"د",2,0],["وَإِنِّي عَلَى مَا نَالَنِي مِنْ قِلىً","لأَشْتَاقُ مِنْ لُقْيَاهُ نُغْبَةَ ظَمْآنِ",7,"ن",1,0],["وَإِنّي عَداني عَنكِ لَو تَعلَمينَهُ","مَوازِئُ لَم يُنزِل سِوايَ جَليلُها",8,"ل",3,0],["وَإِن يَعدُني عَنكَ شَحطُ النَوى","فَحَظّي أَخَسَّ وَنَفسي ظَلَم",9,"م",1,0],["وإِنّي عَلى سُقمي بِأَسماءَ وَالَّذي","تُراجِعُ مِنّي النَفسُ بَعدَ اِندِمالِها",10,"ل",3,0],["وَإِنّي عَلى ذاكَ التَجَلُّدِ إِنَّني","مُسِرُّ هُيامٍ يَستَبِلُّ وَيُردَعُ",11,"ع",1,0],["وإني على علم طويت سهوله","ولم أتحيّر خابطاً حزونه",12,"ن",2,0],["وأن يعيش بها الطُرطُور ذا شَمَم","وأن أسام بعيشي جدع عِرنيني",13,"ن",2,0],["وأني على ما نابني من جفائه","لأقنع منه بالخيال الذي يَسري",14,"ر",2,0],["وإنّي على حُبِيّهمُ وَتَطَلُّعِي","الى نَصرِهم أمشِي الضَراء وأختُلُ",15,"ل",1,0],["وإنّي على أنِّي أرى في تَقِيَّةٍ","أُخَالِطُ أقوَاماً لِقَومٍ لَمِزيَلُ",15,"ل",1,0],["وإنّي على إغضَاءِ عَينَيَّ مُطرِقٌ","وَصَبرِي على الأقذَاءِ وهي تَجَلجَلُ",15,"ل",1,0],["وَإِن يَعظُم مِنَ الحَدثانِ خَطبٌ","تَجِدنا فِيهِ غَيرَ مُقَلَّمِينَا",16,"ن",2,0],["وَإِنّي عَلى طولِ الشِماسِ عَنِ الصِبا","أَحِنُّ وَتُصبيني إِلَيكِ الجَآذِرُ",17,"ر",1,0],["وَأَنّي عَلى الحالَينِ في العَتبِ وَالرِضى","مُقيمٌ عَلى ماكانَ يَعرِفُ مَن وُدّي",18,"د",2,0],["وإنيَ عن ندب الأحبَّة ساكت","وإن كانَ قلبي بالأسى يتكلم",19,"م",1,0],["وإني على ظنِّي به وصبابتي","لأقنع من يدري على الطرفِ أن يجلى",20,"ل",2,0],["وإني على الإسلام منكم لَخائفٌ","بوائقَ شتّى بابُها الآن مُرتَجُ",21,"ج",1,0],["وإنِّي على رَغْمِ الأعادي لَقائلٌ","وإن أبْرَقُوا لي بالوَعِيدِ وأرعَدُوا",22,"د",3,0],["وإني على ما كان منكم لعالمٌ","بأَنِّيَ ما أخطأتُ في مدحكم رشْدي",23,"د",2,0],["وإني عليم أنّ فَرْيَ أديمه","يسيرٌ عليه ما غدا سالمَ الوَفْرِ",24,"ر",1,0],["وإني على ما كان منكَ لراجعٌ","إليك بودي شاكرٌ سالف القرض",25,"ض",1,0],["وَإِنّي عَلى مَن لا أُسَمّيهِ عاتِبٌ","فَيا رَبِّ لا يَبلُغ إِلَيهِ كَلامي",26,"م",2,0],["وَإِنّي عَلى ما سارَ مِنهُ لَعاتِبٌ","أَلَيسَ بِهِ لِلبَينِ تُحدى الأَيانِقُ",27,"ق",1,0],["وَإِنّي عَلى ذاكَ الجَميلِ لَشاكِرٌ","وَإِنّي إِلى ذاكَ الجَمالِ لَمُشتاقُ",28,"ق",1,0],["وَإِنّي عَلى هَذا الجَفاءِ لَصابِرٌ","لَعَلَّ حَبيبي بِالرِضى لِيَ راجِعُ",29,"ع",1,0],["وَإِنّي عَلى ما فِيَّ مِن وَلَعِ الصِبا","جَديرٌ بِأَسبابِ التُقى وَخَبيرُ",30,"ر",1,0],["وَإِنِّي عَن الماءِ الذي يَجمَعُ القَذَى","إِذا كانَ طَرقاً آجِناً لصَدُورُ",31,"ر",1,0],["وَإِنِّي علَى سَفحِ الدموعِ التي تُرى","لَجَلدٌ عَلى بَين الحَبيبِ صَبورُ",32,"ر",1,0],["وَإِنّي عَلى الشَيءِ الَّذي يُلتَوى بِهِ","وَإِن زَجَرَتني زَجرَةً لَوَريعُ",33,"ع",1,0],["واني على كبرتي هذه","اود لو ان حياتي تطول",34,"ل",1,0],["وإني على هذا الجمود وطوله","ألومك يا عيني وإني أعاتب",35,"ب",1,0],["وأن يعود الجسم مني","جارياً فيه دمي",36,"م",2,0],["وَإِنّي عَنكَ بَعدَ غَدٍ لَغادِ","وَقَلبي عَن فِنائِكَ غَيرُ غادِ",37,"د",1,0],["وإِنّي على ما كانَ منكم لواجدٌ","بحبِّكُمُ تاللّه وجدَ الروائمِ",38,"م",1,0],["وَإِنّي عَلى غَربي وَشَغبِ شَكيمَتي","لَمُعتَبَدٌ لِلطولِ مِنكَ ذَليلُ",39,"ل",1,0],["وَأَن يُعَلَّلَ رُكبانُ المَطِيِّ بِهِم","بِكُلِّ قافِيَةٍ شَنعاءَ تُشتَهَرُ",40,"ر",1,0],["وَإِنّي عَلى عُظمِ الرَجاءِ لَخائِفٌ","كَأَنَّ عَلى رَأسي الأَسِنَّةَ تُشرَعُ",41,"ع",1,0],["وَإِنّي عَلى صَبري عَلى فَرطِ هَجرِهِ","وَقُربِ مَغانيهِ وَبُعدِ مَرامِهِ",42,"م",2,0],["وَإِنّي عَهِدتُكَ نَجلَ الجِيادِ","لِذَلِكَ أَطلُبُ مِنكَ الإِجادَه",43,"د",2,0],["وَإِنّي عَلى بُعدِ الدِيارِ وَقُربِها","أُطارِحُ فيكُم فِكرَتي وَتُطارِحُ",44,"ح",1,0],["وإنّي عَلَيْهِ لُمسْتَدركٌ","من البثِّ والحزْنِ ما أهملوهُ",45,"و",2,0],["وإنْ يَعْرِضِ البعضُ من سيرها","تَرَ العِيسَ من خلفها تَنقَرِض",46,"ض",1,0],["وَإِنّي عَلى هِجرانِها وَصُدودِها","وَما حَلَّ بي مِنها أَرى حُبَّها حَتما",47,"م",2,0],["وَإِنّي عَلى لَيلى لَزارٍ وَإِنَّني","عَلى ذاكَ فيما بَينَنا مُستَديمُها",48,"ه",2,1],["وَإِن يَعفُ لا يَندَم وَإِن يَسطُ يَنتَقِم","فَهَل عادِلٌ فيها بِما أَنتَ واقِعُ",49,"ع",1,0],["وَإِنّي عَلى طولِ إِخلافِها","لَأَرجو الوَفاءَ وَلا أَحقُدُ",50,"د",1,0],["وَإِنّي عَداني عَن لِقائِكِ حادِثٌ","وَهَمٌّ أَتى مِن دونِ هَمَّكِ شاغِلُ",51,"ل",1,0],["وإني على شيخوختي وَزَمانتي","أُريد بِشعري في الحياة التجددا",52,"د",2,0],["وإني عَلى ما بي من الحر وَالصدى","لأنظر ماءً ما إِليه سَبيل",53,"ل",1,0],["وإِني علَى ما هاجَ صَدْرِي وغاظنِي","ليأْمَنُنِي مَن كانَ عِنْدِي له سِر",54,"ر",1,1],["وَإِنّي عَزيزُ الجارِ في كُلِّ مَوطِنٍ","وَأُكرِمُ نَفسي أَن يَهونَ مَقامي",55,"م",2,0],["وَإِن يَعيبوا سَواداً قَد كُسيتُ بِهِ","فَالدُرُّ يَستُرُهُ ثَوبٌ مِنَ الصَدَفِ",56,"ف",1,0],["وَإِنِّي عَلَى مَا كَانَ مِنْ سَرَفِ النَّوَى","لَبَاقٍ عَلَى وَدِّي لِمَنْ كُنْتُ أَصْطَفِي",57,"ف",2,0],["وَإِنِّي عَلَى مَا كَانَ مِنْكَ لَصَابِرٌ","لعِلْمِيَ أَنَّ الْفَوْزَ مِنْ ثَمَرِ الصَّبْرِ",58,"ر",1,0],["وَإِنِّي عَلَى مَا كَانَ مِنْ سَرَفِ الْهَوَى","لَذُو تُدْرَأ في النَّائِباتِ مُغِيرُ",59,"ر",1,0],["وَأَنَّى عَلَى فَقْرٍ تَعِفُّ طَهَارةً","ولاَ عِفَّةٌ إِلاَّ بِرِيٍّ وَمَشْبَعِ",60,"ع",1,0],["وَأَنْ يُعْمَرا عُمْراً طَوِيلاً وَيَلْبَثَا","بِنُعْماءِ تُفْضِي كُلَّ يَوْمٍ إِلى غَدِ",61,"د",1,0],["وَإِنّي عَلَيكَ لَجاري الدُموعِ","وَإِنّي عَلَيكَ لَصَبٌّ وَصِب",62,"ب",1,0],["وأنْ يعتاضَ عن جيل بجيلٍ","بها ، ويفضََّ بينهما النزاعا",63,"ع",2,0],["وأني عرَّسوا أسرى إليهم","يُطيلُ عذابَهمْ وجهٌ مُخيف",64,"ف",1,0],["واني على أنَّ البلادَ جميلةٌ","تروق كما ازدادت من الدلِّ مِكسال",65,"ل",1,0],["وأنّي عُودٌ بكفِّ الرياحِ","يسأل منها متى يُقصَم",66,"م",1,0],["وإني على قدْر ما كان","بالفُجاءاتِ مِن قَسوةٍ كان بي",67,"ب",2,0],["وإني على أن هذا المزاج","رمانيَ بالمُرهِق المُنْصِب",67,"ب",1,0],["وَإِني عَلى ما كانَ أَوَّلُ أَوَّلي","عَلَيهِ كَذاكَ القَرمُ يُنتَجُ لِلقَرمِ",68,"م",1,0],["وإن يَعْصِه عمداً جَهاراً ولم يتب","ومات مصرّاً يَصْلَ نار جهنما",69,"م",2,0],["وإنِّي على العهد القديمِ لحافظٌ","وست بناسٍ ودّكم لو نسينُما",70,"م",2,0],["وإني على عهده ثابتٌ","مقيمٌ ولو عشت عمراً طويلْ",71,"ل",1,0],["وإني على رغْم الحسودِ وضدكم","بكِّفى ثمارَ الجود منكم لقاطفُ",72,"ف",1,0],["وإني عَاذِرٌ لَكُمُ فَأنتُم","جَعَلتُم مِن فُرُوعِكِمُ أُصُولا",73,"ل",2,0],["وأن يعافى مرضانا ويُهلكُ أع","دانا ويشمل موتانا بغفرانِ",74,"ن",1,0],["وإني على بعد الديار وربها","وتغيير مغتاب وتغيير عاتبِ",75,"ب",1,1],["وإِني على ما تعهدون من الهوى","ومن لي بأن يرعي كرعي له العهدُ",76,"د",1,0],["وانى على ظهر الطريق مسافر","وما الزاد مثل الرزق يطلب دائما",77,"م",2,0],["وإن يعاجله مهم فنأى","أوصى له بقاطع أوصالهُ",78,"ل",2,0],["وإني على بيض السيوف لباسل","وإن كنت عن سود العيون جبانا",79,"ن",2,0],["وان يعتريك العجب أيضا بكونها","على ما حوته من رياء وسمعة",80,"ه",1,0],["وَإِن يَعتَلِل يَوماً يقولوا عقوبةٌ","لشرِّ الّذي يَأتي وما هوَ فاعلُ",81,"ل",1,0],["وَإِنّي عَلى أَحسابِهِم وَعُلاهُمُ","غَيورٌ وَعَن بَحبوحَةِ المَجدِ ذائِدُ",82,"د",1,0],["وَإِنّي عَلى أَهلِ العُلا ذُو حَمِيَّةٍ","أُجَرِّدُ سَيفي دُونَهُم وَلِسانِيا",83,"ي",2,0],["وَإِنّى عَلَى رَغمِ العُدَاةِ بِأَنقُعٍ","شِفَاءً لِحَومَاتِ الصَّدَى لَشَرُوبُ",84,"ب",1,0],["وإن يعتللْ يوما يقولوا عقوبة","لسيء ما يأتي وما هو فاعل",85,"ل",1,0],["وَاَن يَعُمَّهُم حَياً مُطَبِّقُ","بَل قَد رَأَى بِهَجَرَ المُغَيَّقُ",86,"ق",1,1],["وَإِنّي عِندَ بَأسي لُمتُ نَفسي","وَلومُ النَفسِ لا يُغني قِبالا",87,"ل",2,0],["وان يعد تلقه وفيا","اوفى الورى نائلا ووعدا",88,"د",2,0],["وإني عليها والمُهَنَّدُ في يدي","وخطيّةٌ قد يَنْطحُ النَّجْمُ طولُها",89,"ل",3,0],["وإني على ما بي إليهنّ من جَوىً","بكّل عفافٍ كاملٍ لجَدير",90,"ر",1,0],["وانّي عَلى ما حَمَّلَتهُ لَصابِرٌ","وان كُنت لا أَبقى عليه وَلا أَقوى",91,"و",2,0],["وإنّي على شوقٍ لمعهد قربه","ومازلت أرعى العهد في القرب والبعد",92,"د",1,0],["وإنّي على عهدي أهيم بحبّه","غراماً ويا ويل الشجيّ من الخلي",93,"ل",2,0],["وإني عن البيضِ الغواني لفي غِنَىً","لأن الهوى فيهِ الخيانةُ والمكر",94,"ر",1,0],["وإني على البَلوى صبورٌ لأنني","سَلوتُ بقولي الخطبُ يحمِلهُ الحرُّ",94,"ر",1,0],["وإنّي على ما قد جنيتُ لواثقٌ","بِسَهل السَجايا منك لا بعُرامها",95,"م",3,0],["وإِنّي على ما بي من الوَجدِ والأَسى","لذو مِرَّة لا يستفزُّنيَ الدَهرُ",96,"ر",1,0],["وَأَن يعيدَ أميرُ المؤمنين له","مَفاخراً في جباهِ الدهرِ ترتسمُ",97,"م",1,0],["وأني على حكم الحوادث نازل","تسالمني طوراً وطوراً تحارب",98,"ب",1,0],["وأني عزيز بابن ماساي مكثر","وإن هان أنصار وبان خليل",99,"ل",1,0],["وإني على ما في من صلف لها","لراغبة في الوصل أعظم رغبة",100,"ه",1,0],["وَإِن يَعُد يا هَنانا","فَذاكَ عيدُ الأَنامِ",101,"م",1,0],["وَإِنّي عَداني عَنكُمُ غَيرَ ماقِتٍ","نَوارانِ مَكتوبٌ عَلَيَّ بُغاهُما",102,"م",2,0],["وَاِنّي عَلى جلو الغَرامِ وَمَرّة","صَبور وَما بي في كلا الحالتَيَن بي",103,"ب",2,0],["وأن يَعتَدَّ أيَّامَ التّهاني","بعِدَّتها إذا ما الحَوْلُ حالا",104,"ل",2,0],["وإنّي على شُكْري لهنّ مُثابِرٌ","طُوالَ اللّيالي ما أقامَ ثَبير",105,"ر",1,0],["وإنّي على حالٍ كما تَشْتَهونَهُ","نَسُرُّ ولكنّ الغريبَ غَريبُ",106,"ب",1,1],["وإنّي على ما بي ليَجْذِبُ همتّي","إلى الشّرفِ العالي من المجدِ جاذب",107,"ب",1,0],["وَإِنّي عَلى الأَيّامِ فيها لَعاتِبٌ","وَحاشا لِذاكَ الوَجهِ مِن أَلَمِ العَتبِ",108,"ب",1,0],["وَإِنّي عَلى تِلكَ المُوالاةِ ثابِتٌ","وَلَستُ وَإِن أَقصَيتَني أَتَزَحزَحُ",109,"ح",1,0],["وإنِّي عَلى ما كانَ منِّي لَمِنكُمُ","فيا نَفثةَ المَصدُورِ قَد هجتِ فاسكُني",110,"ن",2,0],["وَإِني عَلى ما بي لَأَرعى وِدادَهُم","وَإِن أَلفوا فَقدي وَإِن ضَيعوا وَدي",111,"د",2,0],["وَإِني عَلى فَقد النَعيم لَصابِرٌ","وَلَستُ عَلى فَقد الأَخِلاءِ بِالجلد",111,"د",1,0],["وَإِن يَعزّ في الفَيافي مَورِدٌ","فَدَمعُهُ لِلعيس أَوفى وَرد",112,"د",1,0],["وإني على أخذِ الغرام بمقْودي","لأَصْبو إلى المجد المؤثّل والفضْلِ",113,"ل",1,0],["وإني على ما كان يعهد خامل","ولم أتحول عن طريقي وعن وضعي",114,"ع",2,0],["وإني على شرط المودة والإِخا","وإن كانت الأجساد منها على بُعْدِ",115,"د",1,0],["وَإِنّي عند مَقدِرَتي وَوَجدي","بهنَّ مَع الشَبيبَة وَالغَرامِ",116,"م",1,0],["وإنِّي على هذا التجنّي لصابر","وأحملُ عِبءَ الوجد لا أتكلَّف",117,"ف",1,0],["وإنِّي على ما بي فقد يستفزّني","غرامٌ بسلمى حادث وقديمُ",118,"م",1,0],["وإنِّي عزيز النَّفس لو تعرفونني","ولي بينكم ذلّ الأَسير المصفَّد",119,"د",1,0],["وإنِّي على شغفي بالخمول","أروم من الدهر ما لم يُرَم",120,"م",1,0],["وإنِّي عُدتّ في نفسي وجسمي","مليئاً بالهدى والانتقاع",121,"ع",1,0],["وإنِّي على خصب الزمان وجدبه","إليك وإن شطَّ المزار لأهرعُ",122,"ع",1,0],["وإني على ما أكد العهد بيننا","مدى الدهر لا خنا العهود ولا حلنا",123,"ن",2,0],["وإني عبد عبدك غير شك","وكل الناس لي طرّا عبيد",124,"د",1,0],["وأني على ما بي من الحب والأسى","صبور ومثلي من هوى فتجلدا",125,"د",2,0],["وإِني على ما فيّ من لين ملتوىً","جليد على حملٍ الهمومِ كتومُها",126,"م",3,0],["وإني على ما قد ألِمتُ محسَّدٌ","أكابدُ مفئوداً عليَّ ومُحنقا",127,"ق",2,0],["وإني على أنسي بأهلي وموطني","لأَعلمُ أَنَّ العيشَ عندك صالحُ",128,"ح",1,0],["وأنْ يُعيذَ بهاء الدين من وصبٍ","يعتلُّ منه العُلى والمجدُ والكرمُ",129,"م",1,0],["واني على همي بعصْري وأهْلهِ","وطولِ شَقائي بينهمْ وعَنائي",130,"ي",1,1],["وإني عليمٌ بالهوى وهوانه","فوا عجباً ما لي هويت على عمد",131,"د",1,0],["وإني عانٍ كنت لا يستميلني","دنيٌّ ولا يسمو إليَّ مثيل",132,"ل",1,0],["وَإِنّي عَلى الحِلمِ الَّذي مِن سَجيَّتي","لَحَمّالُ أَضغانٍ لَهُنَّ طَلُوبُ",133,"ب",1,0],["وأني على الأوكار أصطاد خاطبا","على الدهر من بلبالي عنقاء مغرب",134,"ب",1,0],["وأنِّي على العلمِ اليَقينِ بمذْهَبي","ترفَّعَ في طَوْري سَماعي عنِ العَذْلِ",135,"ل",1,0],["وإنّي عجبْتُ من فطيمٍ يخالُ نف","سَه ملكاً قالَ ببيعِ رُباها",136,"ا",3,0],["وإِنِّي عَلى ذَا ذو رَجاءٍ غَدَا بِهِ ال","قُنوطُ وَراءٌ خَلْفَ كلِّ وَراءِ",137,"ا",2,0],["وإنِّي عَلى أقوَى يَقينٍ بِأَنَّنِي","اُفارقُ فيك اليومَ جُلَّ هَنَائِيا",138,"ي",2,0],["وإنّي على مَن لا هوادَة عنده","ولا شَفَقٌ منه عليَّ شفيقُ",139,"ق",1,0],["وإنْ يَعْلِطوا بالمرهفاتِ رقابَها","إذا كانَ ربُّ البُدنِ بالنّار عالطا",140,"ط",2,0],["وإني على تسليم زعم رواتها","سأبدي لكم معنى عبارتها العبري",141,"ر",2,0],["وإن يعترض كان اعتراضاً على الذي","له الخلق والأمر اللذان تأكدا",142,"د",2,0],["وإني على ما كنت فيه ولم أزل","ولي رتبة التنزيه أرفع رتبة",143,"ه",1,0],["وإني على جور الزمان وعدله","كما شاء من أهواه في حفظ عهده",144,"د",2,0],["وإِنِّي على قول الخَنَا أَيُّ مبطِىءِ","وإِنِّي إِلى بذلِ اللُّهى أَيُّ عجلان",145,"ن",1,0],["وإِني على دين الوفاءِ لثابت","وإِني من حسن العزاء لفَرَّارُ",146,"ر",1,0],["وإِنِّي عَلَى ما ذُقْتُ من أَلَم الهَوَى","وقاسَيْتُ مِنْه كُلَ مُبْكٍ وَمُضْحِكِ",147,"ك",1,0],["وإِني عَزَمْتُ عَلى سَفْرةٍ","أَرَى وجهَ إِقْبالِها يُسْفِر",148,"ر",1,0],["وإِنِّي عبدٌ لم أَزلْ فيكَ قائِلاً","قصائدَ عن عَلياك غَيرَ قصائِر",149,"ر",1,0],["وإِنِّي على وعْدٍ من الله في الَّذي","أُريدُ وعنْدِ الله لا يُخْلَفُ الوَعْد",150,"د",1,0],["وإِنيَ عبدٌ لم أَزَلْ فيكَ قائماً","بمَدْحِكَ أَشْدُو أَو بحمْدكَ أَخْطُب",151,"ب",1,0],["وَإِنّي عَلى ما خَيَّلَت لَأَظُنُّها","سَيَأتي عُبَيداً بَدؤُها وَعِيادُها",152,"د",3,0],["وَإِنّي عَلى أِشياءَ مِنكَ تريبُني","قَديماً لَذو صَفحٍ عَلى ذاكَ مُجمِلُ",153,"ل",1,0],["وَإِنّي عَلى مَعروفِ أَخلاقِيَ الَّتي","أُزايِلُ مِن أَلقابِها وَأُجامِعُ",154,"ع",1,0],["وأَنّي عداني أَن أَزورَك فاِعلمي","شَبابُ حُروب كالحَريقِ المُضَرَّمِ",155,"م",1,0]]}