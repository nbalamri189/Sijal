{"poems":[[93,"أطار عني النوم صوت في الدجى","https://www.aldiwan.net/poem62627.html","عموديه"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/5277","الخفيف"],[259,"غرور","https://www.aldiwan.net/poem24950.html","مجزوء الرمل"],[435,"جد وحدث عن العيون الكحال","https://www.aldiwan.net/poem41401.html","الخفيف"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[599,"","https://poetry.dctabudhabi.ae/diwan/poem/100444","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37759","الرمل"],[949,"","https://poetry.dctabudhabi.ae/diwan/poem/124748","الرجز"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129519","المنسرح"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52077","الرمل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45805","البسيط"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[4376,"","https://poetry.dctabudhabi.ae/diwan/poem/131914","الرمل"],[5183,"مُلْغِزَه رق265م","https://www.poetsgate.com/ViewPoem.aspx?id=186405",""],[243,"تسديد الحساب","https://www.poetsgate.com/ViewPoem.aspx?id=50560",""]],"verses":[["وَاِستَتَرَت عَنّي السُهولُ وَالرُبى","تَحتَ الدُجى وَالبَحرُ ذو الأَهوالِ",0,"ل",1,0],["وَاِستُتِمَّ الصَبيحُ في خَيرِ وَقتٍ","فَهوَ مَغنى أُنسِ وَدارُ مُقامِ",1,"م",1,0],["واسْتَتِرْ ما شئتَ لكن","أنتَ مني أنتَ ضلعُ",2,"ع",1,0],["واستتبت به معالم صور","ذات فضل من فضله والخلال",3,"ل",1,0],["واستترت شيعته بأمره","فرق العدى واحتفظت بسره",4,"ه",1,0],["واستتمت علي حجة حق","عن قضاء المهيمن المنان",5,"ن",1,0],["وَاِستِتارَ الغيدِ في بُرقُعِها","لِأُهيل العِشقِ حقّاً فَضَحا",6,"ح",2,0],["واستترت شمس الضحى لما ظهر","قائلة لا تدرك الشمس القمر",7,"ر",1,0],["واستتر الظلم من عدالته","بين جفون الظباء بالكحل",8,"ل",1,0],["وَاسَتتَمُّوا الرَّأيَ حَتى عَايَنُوا","نِقْمَةَ اللهِ التِي لَمْ تَزَلِ",9,"ل",1,0],["وَاِستَتَبعوا بِالمواضي مَن طَغى فَمَحوا","لَيل العَجاجة مَحو الظلم وَالظلم",10,"م",1,0],["واستَتنِ مِن ذَا الخُلفِ عَجبَ الذنَبِ","وَمَاأتَت بِهِ النُّصُوصُ كالنَّبِى",11,"ب",2,0],["واستتار البدر من إشراقها","عادة للبدر فيها يستريح",12,"ح",1,0],["واستتلعت لترى معشوقها فبدا","لكنه ريثما يُستنزل الشرك",13,"ك",1,0],["واستترفوا متعة الأحياء ما دفعوا","عنها ولا غارما ما استترفوا رحموا",14,"م",3,0]]}