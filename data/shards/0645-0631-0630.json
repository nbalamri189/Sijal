{"poems":[[91,"إن تأييد نهضة العلم مجد","https://www.aldiwan.net/poem44933.html","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95526","الخفيف"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95588","الرمل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110273","السريع"],[6099,"قانأ","https://www.poetsgate.com/ViewPoem.aspx?id=35798",""]],"verses":[["مرّ ذاك العيش الذي طاب حيناً","وكذاك الحياة صاب وشَهد",0,"د",1,0],["مرّ ذاك الضَّنى إلى غير رجعى","عشتَ صفواً وزاد عمرك دهراً",1,"ر",2,0],["مرَّ ذئب تحت صرح هائل","أرفع الذروة للنجم سَمَا",2,"م",2,1],["مرذولةً معزولةً يائسه","تبكي على عهدِ الصفاءِ القديم",3,"م",1,0],["مرً ذاطعمُ كرامتنا","وخنوعُ الأوغاد كسَكرْ",4,"ر",1,0]]}