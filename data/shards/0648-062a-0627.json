ون والسعدِ فاركبِ","https://www.poetsgate.com/ViewPoem.aspx?id=27102",""],[51,"إذا خاب داعٍ أو تناهَى دعاؤه","https://www.poetsgate.com/ViewPoem.aspx?id=26851",""]],"verses":[["وَتارَةً رَشَفاتٌ لا اِنقِضاءَ لَها","شُربَ النَزيفِ طَوى عَلّاً عَلى نَهَلِ",0,"ل",1,0],["وَتَأخُذُ مِنهُ ما أَنامَ وَما حَلا","وَآخُذُ مِنهُ ما أَمَرَّ وَأَرَّقا",1,"ق",2,0],["وَتَأخُذُهُم في ساعَةِ الجودِ هِزَّةٌ","كَما خايَلَ المِطرابُ عَن نَزوَةِ الخَمرِ",2,"ر",1,0],["وَتَأَرَّجَت مِنها زَلازِلُ رَيطَتي","حَتّى تَعارَفَ طيبَها أَصحابي",3,"ي",1,0],["وتألَفُ نَفسي عِزَّها وهْيَ حُرَّةٌ","تَرى الكِبْرَ غُنْماً والضّراعَةَ مَغْرَما",4,"م",2,0],["وَتَاللهِ مَا أَصْغَيْتُ فِيهِ لِعَاذِلٍ","تَحَامَيتُهُ حَتَّى ارْعَوَى وَتَحَامَانِي",5,"ي",1,0],["وَتَاللهِ مَا اعْتَلَّ الأَصِيلُ وَإِنَّمَا","تَعَلَّمَ مِنْ شَجْوِي فَبانَ اعْتِلاَلُهُ",6,"ل",2,0],["وَتَأَتِي أمِيرَ الْمُسْلِمِينَ خَوَامِسا","فَتَكْرَعُ مِنْ بَعْدِ النَّوى فِي نَوَالِهِ",7,"ل",2,0],["وتاللّهِ لوْلا أنّةٌ تُشْهِرُ الجَوى","فأضْحى وسرُّ الحُبِّ بادٍ جُحودُهُ",8,"د",2,0],["وَتَأَنَّقوا في الخُلفِ حَتّى أَصبَحَت","أَقوالُهُم تُذرى بِغَيرِ رِياحِ",9,"ح",1,0],["وَتارَةً زَوجَ عُطبولٍ خَدَلَّجَةٍ","حَسناءَ تَملِكُ آلافَ الفَدادينِ",10,"ن",1,0],["وَتَأسَفَ بيضُ الهِندِ أَن لَيسَ تُنتَضى","وَسُمرُ القَنا أَلّا تُهَزَّ وَتُشرَعا",11,"ع",2,0],["وَتَأَوَّدَت كَالغُصنِ قا","بَلَ عِطفَهُ نَفَسُ القَبول",12,"ل",1,0],["وَتَابَعَ الفَتْحَ بَعْدَ فَتْحٍ","وَرَدَّ كَيْدَ المُثَّبِّطِينَا",13,"ن",2,0],["وَتَاللهِ إِنِّي مِنْ مُقَامِي بَيْنَكُمْ","أَرَى الشَّرْقَ يُلْقِي السَّمْعَ وَهْوَ مُكَلَّمُ",14,"م",1,0],["وَتَاللهِ مَا الرَّوَّاغُ دُونَ ضَمِيرِهِ","بِأَشْرَفَ مِنْ رِعْدِيدِ هَيْجَاءَ يُهْزمُ",15,"م",1,0],["وَتابَعَهُ الهُدى وَالدينُ كُلّاً","كَما يَتَتَبَّعُ الاِلفَ الأَليفُ",16,"ف",1,0],["وَتَأتي بِأَطرافِ الشِفاهِ تَرَشُّفاً","عَلى واضِحِ الأَنيابِ عِذبِ المُقَبَّلِ",17,"ل",1,0],["وتاجها الحمرا","ه مطلع الأنوار",18,"ر",1,0],["وتارة نتغاضى تحت غبرتها","كأنما هي في الأبصار عوّار",19,"ر",1,0],["وتارة تلقاه في مشجرة","يجري واخرى بين اصلاد الصفا",20,"ا",1,0],["وتأخذ منا راتباً كموظف","وهذا لعمر الله أنكى وأنكد",21,"د",1,0],["وتأتيك الوُفود من الأقاصي","لتسمع قول مِدْرَهِها المِثَجّ",22,"ج",1,0],["وتأخّروا عن كل ما","يَقضي بأن تتقدّموا",23,"م",3,0],["وتأملت منك حرّاً كريماً","خلفاً للفقيد ضاهى الفقدا",24,"د",2,0],["وَتَأخُذُ بِالوَزيقَةِ ثُمَّ تَمضي","إِذا اِزدَحَمَت لَدى الحَربِ الجُنودُ",25,"د",1,0],["وَتَأَيَّبتُ عَلَيهِ ثانِياً","يَتَّقيني بِتَليلٍ ذي خُصَل",26,"ل",1,0],["وَتَأبى وَآبى أَن أَموتَ مُوَسَّداً","بِأَيدي النَصارى مَوتَ أَكمُدَ أَكبَدِ",27,"د",1,0],["وتابعَ الرَّفد حتَّى ما ظننت إذاً","أنِّي من السيلِ في أبوابهِ ناجي",28,"ي",1,0],["وتاركة قلبي كليماً وناظري","ذبيحاً ولا في العيش بعدك صالح",29,"ح",1,0],["وتأوَّدتْ تدعو للذَّة ضمِّها","ما دامت الرَّقباء طوعَ هجودها",30,"د",3,0],["وتاجاً على رأس السيادة يجتلى","فينظم درّ المدح فيه وينثر",31,"ر",1,0],["وتاجر قلت له إذا رَنا","رفقاً بقلبٍ صبره حائر",32,"ر",1,1],["وتأمّلْ فإنها ألِفُ المد","دِ لها مَدّةٌ بغيرِ انتهاءِ",33,"ا",2,0],["وتأمَّلْ إذا لَحَظْتَ بعينيْ","ك صحونا لا تعرف الانتهاءَ",34,"ا",2,0],["وتاب إليك الدهرُ من كل سَيِّئٍ","وجاءك يسترضيك وهو مُنيبُ",35,"ب",1,0],["وتاللَّه لا أرضى بردّ ظُلامتي","إلى أن أرى لي ألفَ عبدٍ ومركَبِ",36,"ب",1,0],["وتارةً يُترِزُ الأرواحَ مَنْطِقُهُ","فالخَلقُ ما بين مقتولٍ ومُغتصبِ",37,"ب",1,0],["وتاب إليك الدهرُ من كل سيِّئٍ","وأعتَبَك المقدارُ ياخيرَ مُعتَبِ",38,"ب",1,0],["وتارةً على القَفَا أسطِّحُهْ","آسُوهُ منْ أدوائه وأجْرَحُهْ",39,"ح",2,0],["وتألَّفْني تَألَّفْ صاحباً","بي أَلوفاً شكره شكْرٌ شَرودُ",40,"د",1,0],["وتاللَّه ما موْلىً لمولاه خالد","ولا الحزن من مولى لمولاه خالدُ",41,"د",1,0],["وتاجرُ البر لا يزال له","ربحان في كل مَتْجَرٍ تَجَره",42,"ر",2,0],["وتاللَّه ما أدري أأسكت خاسئاً","حسيراً برغمي أم أقول فأعذر",43,"ر",1,0],["وتالٍ تلا يوماً فأُنسِيَ آيةً","فأعيتْ عليه حينَ رامَ انتهازَها",44,"ز",3,1],["وتارةً يُؤيسُني أنني","أحْزنتُ في الشكر ولم أُدهس",45,"س",1,0],["وتارةً مثل الرَّحى بلا شُعَبْ","قد شَذَّبت عنها ثناياك السَّذَب",46,"ب",1,0],["وَتَأوي لِاِبنِ زِنباعٍ إِذا ما","تَراخى الريفُ كاسَ لَهُ عَقيرُ",47,"ر",1,0],["وَتَاللَهِ يُجدي فَتىً بائِساً","كَلامُ المُنَجِّم وَالساحِرِ",48,"ر",1,0],["وَتَأَفُّفاً في اللَيلِ وَهوَ مُنَوِّرٌ","وَتَبَرُّماً في الصُبحِ وَهوَ تَبَسُّمُ",49,"م",1,0],["وَتَأبى كِبرِيائي أَن يَراني","فَتىً مُغرَورِقاً بِالدَمعِ جَفني",50,"ي",1,0],["وَتَأبى المُروأَةُ في أَهلِها","وَتَأبى السُيوفُ وَتَأبى القنا",51,"ن",2,0],["وَتائِهٍ أُقبَضُ في","حُبّي لَهُ وَما اِنبَسَط",52,"ط",1,0],["وَتالٍ لِلمَزاميرِ","بِصَوتٍ كَالمَزاميرِ",53,"ر",1,0],["وَتَأتي العَدِيَّ بارِزاً نِصفُ ساقِها","تَجولُ كَعَيرِ العانَةِ المُتَلَفَّتِ",54,"ت",1,0],["وَتابَعتُ فيهِ البَريَ حَتّى تَرَكتُهُ","يَرِنُّ إِذا أَنزَفتُهُ وَيُزَفزفُ",55,"ف",1,0],["وتائهٍ ضاعَ بَيْنَ القِفارِ","وهْوَ فَريدُ",56,"د",1,0],["وتأَلَّقَ النَّجمُ الوضِيءُ","فأَعْتَمَ الغيمُ الرَّكُودْ",57,"د",1,0],["وتارة يبني المنى","وتارة يهدم",58,"م",1,0],["وتأملت في مصيبة حفني","يوم للحكم يجلسان سويا",59,"ي",2,0],["وتأخر الأتراب عنه وطالما","كانوا لبانة روحه وجَمالها",60,"ه",2,0],["وتأمل على الصعيد بقايا","دولة فوق دولة الرومان",61,"ن",1,0],["وتألف المنازل العليه","العز كل العز في الحريه",62,"ي",2,0],["وتأتي شقوتي بالذنب عندي","لها لا للزمان ولا المكان",63,"ن",1,0],["وَتَأَمَّلوا البُنيانَ وَاد","دَكِروا الجُهودَ البانِيَه",64,"ي",2,0],["وتأَوَّدَتْ أَعطافُ بانِك فِي يدي","واحمرّ من خَفَرَيْهما خدّاكِ",65,"ك",1,0],["وَتَأَهَّبَت بِكَ تَستَعِدُّ لِزاخِرٍ","تَطَأُ العَواصِفَ فيهِ وَالأَنواءَ",66,"ا",2,0],["وَتَأَمَّل مَلعَباً أَعجَبُهُ","آيَةً جانِبُهُ المُرخى السُتُر",67,"ر",1,0],["وَتَأَتي الأُفقَ تَطويهِ سِجِلّاً","لِآخَرَ كَالسَرابِ إِذا أَضَلّا",68,"ل",2,0],["وَتَأَمَّلوكَ فَكُلُّ جارِحَةٍ لَهُم","عَينٌ تُسامِرُ نورَها وَتُساري",69,"ر",2,0],["وَتاجٍ مِن فَرائِدِهِ اِبنُ سيتى","وَمِن خَرَزاتِهِ خوفو وَمينا",70,"ن",2,0],["وَتَأليفَهُ القِبطَ وَالمُسلِمين","كَما أُلِّفَت بِالوَلاءِ الأُسَر",71,"ر",1,0],["وتارةً كالسُّطُورِ مُتّصِلاً","في جَوانبِ الكُتُبِ",72,"ب",1,0],["وَتَأمَنَهُ الأَعداءُ مِن غَيرِ ذِلَّةٍ","وَلَكِن عَلى قَدرِ الَّذي يُذنِبُ الحِقدُ",73,"د",1,0],["وتأمرني بالمال أوكي عِيابَهُ","وهيهاتَ مني أن يقالَ بخيلُ",74,"ل",1,0],["وتأزَّرَ الأرطى لذاتِ جدائِدٍ","ساغتْ له في زامتين مكارعُ",75,"ع",1,0],["وتأنف أن يَشفي الزلالُ غليلَها","إِذا هيَ لم تشتقْ إليها المواردُ",76,"د",1,0],["وتأمل أن تحظَى وتُنْقَشَ باسْمهِ","وذايلُ تِبْرٍ في المعادن سُوَّخُ",77,"خ",1,0],["وَتَأيِيدُهُ حُكمَ الهُدى بِخُشونَةِ","مِنَ الجِدِّ لَو مَرَّت عَلى الصَخرِ خَدَّتِ",78,"ت",1,0],["وَتَأخُذُ مِن عَيني بِحَقِّ دُموعِها","وَيَرتاعُ قَلبٌ لَم يَكُن بِمُرَوَّعِ",79,"ع",1,0],["وَتَأتي الدَلوُ مَلأى بَعدَ وَهيٍ","مِنَ الأَوذامِ فيها وَالعِراقي",80,"ي",1,0],["وَتَأبى صُروفُ الدَهرِ سوداً شُخوصُها","عَلى البيضِ أَن يَحظَينَ مِنّي بِطائِلِ",81,"ل",1,0],["وَتَأييدُ دينِ اللَهِ إِذ رُدَّ أَمرُهُ","إِلَيكَ فَرَوّى في الأُمورِ عَليمُها",82,"م",3,0],["وَتارَةً يَرزُقُهُ وَيَحرِمُه","بَدرٌ بَدا فَانجابَ عَنهُ ظُلَمُه",83,"م",2,0],["وَتَأَبّى مِن أَن يُقالَ كَريمٌ","لِسِواهُ إِلّا شِحاحاً وَضِنّا",84,"ن",2,0],["وَتَأَمَّلهُ مِلءَ عَينَيكَ فَاُنظُر","أَيَّ راضٍ في اللَهِ أَو غَضبانِ",85,"ن",1,0],["وتارة تحسبها قينة","تردد اللحن على زامر",86,"ر",1,0],["وتارِكٌ ماءَ وَجْهي في قَرارَتِه","بماءٍ كَفَّيْهِ لمّا فاضَ مُنْسَجِما",87,"م",2,0],["وتاجرَةٍ بالخَمْرِ تُؤثِرُ صَوْنَها","عَنِ البَيعِ أو تَلقى الغِنى فتَبيعُها",88,"ع",3,0],["وتأبى عبرتي إلا انسكابا","وتأبى لوعتي إلا التهابا",89,"ب",2,0],["وَتَأتي وَتَمضي الحادِثاتُ سَريعَةً","وَكَم غَدَرَتني الحادِثاتُ وَكَم خانَت",90,"ت",1,0],["وَتَأخُذُني مِن سَورَةِ الفِكرِ نَشوَةٌ","فَأَخرُجُ مِن فَنٍّ وَأَدخُلُ في فَنِّ",91,"ن",1,0],["وتأتلق الحياةُ على الروابي","كأنَّ على الربى كفّ عيسى",92,"س",2,0],["وتالٍ من القرآن قلْ لنْ يصيبنا","وقد حانَ من زُهْرِ النجوم غروبها",93,"ب",3,0],["وَتَأَمَّلَت شَبَحي بِعَينٍ أَيَّدَت","عَمَدَ الهَوى في قَلبِيَ المَعمودِ",94,"د",1,0],["وَتابَعَ السَّيرَ عَبدُ اللَّهِ مُتَّجِهاً","تِلقاءَ نَخلَةَ مَصحُوباً بِكُلِّ كَمِي",95,"م",2,0],["وتاجرٍ ماطلْتُهُ دينَهُ","لأجتليهِ قال ما أمطلَكْ",96,"ك",1,1],["وتاجرٍ شاهدتُ عشّاقَهُ","والحربُ فيما بينهمْ ثائرُ",97,"ر",1,1],["وتأزمت كُرَبٌ ، وضاقت خطّةٌ","واستوحشتْ طرقٌ لنا ودُروب",98,"ب",1,0],["وَتَأرَجُ أَنفاساً وَتَندى غَضارَةً","فَتَحسِبُها نُوّارَةً تَتَفَتَّقُ",99,"ق",1,0],["وَتَأبى اِهتِضامي في جَنابِكَ هِمَّةٌ","تَهُزُّكَ هَزَّ الريحِ فَرعَ أَراكِ",100,"ك",1,0],["وَتَأخُذُ عَنهُ صَنعَةَ السِحرِ بابِلٌ","وَتَلوي إِلَيهِ أَخدَعَ الصَبِّ بَغدانُ",101,"ن",1,0],["وتَألّبوا يتعلّلون بِقتلهِ","قتلاً يَرَوْنَ قضاءَه محتوما",102,"م",2,0],["وتأمّلْ هل ترى اليومَ سِوَى","دَولةٍ فوضى وحُكمٍ أخرقِ",103,"ق",1,0],["وتأخذنا الخطوبُ فإن صبرنا","تداعَوْا في الكنائسِ جازعينا",104,"ن",2,0],["وَتَأَمَّل هَل لَهُم في جَوفِهِ","مِن جُنودٍ أَو بُنودٍ أَو سَفينْ",105,"ن",1,0],["وَتارِكُ حَقِّهِ مِن غَيرِ حَربٍ","كَتارِكِ عِرضِهِ مِن غَيرِ عُذرِ",106,"ر",1,0],["وتأمّلْ فَتِلكَ حُجَّتُه البي","ضاء لم تُبقِ ظَلمةً أو سوادا",107,"د",2,0],["وَتأمَنَ وَسطَهُم وَتَعيشُ فيهِم","أَبا مَطَرٍ هُديتَ بِخيرِ عَيشِ",108,"ش",1,0],["وَتاجِرٍ ذي جَوهَرٍ وَمالِ","كانَ مِنَ اللَهِ بِحُسنِ حالِ",109,"ل",1,0],["وَتاجِرٍ مَع حَجِّهِ وَعُمرَتِه","يَطلُبُ رِبحَ مالِهِ في سَفرَتِه",109,"ه",1,0],["وَتاجِرٍ عُريانَ يَدعو بِالحَرَب","لا مالَ أَبقاهُ لَهُ إِلّا سَلَب",109,"ب",1,0],["وَتارَةً تُبصِرُهُ كَأَنَّهُ","أَبلَقُ مالَ جَلُّهُ حينَ وَثَب",110,"ب",1,0],["وَتارَةً تَخالَهُ إِذا بَدا","سَلاسِلاً مَصقولَةً مِنَ الذَهَب",110,"ب",1,0],["وتابَعَتْ بعضَها الغَلَّاتِ في سَفَرٍ","بعضاً إلَى شُوَنٍ ضاقَتْ بهاالخُدُرُ",111,"ر",1,0],["وتأتيه خَيْلُ اللَّهِ من كَلِّ وِجْهَةٍ","يُؤَيَّدُ منها بالنفيرِ نفيرُ",112,"ر",1,0],["وَتَأَثَّلَتْ لِلدِّينِ وَالدُّنيا بهِمْ","عَلْيا تُخَلِّقُ جِدَّةَ الأيَّامِ",113,"م",1,0],["وتاللّهِ ما للّهِ بادَرَ فَوتَهَا","ذَوُو إفكِهم من مُهْوَإٍ أو مُنَقَّم",114,"م",1,0],["وتأتي عطاياهُ عِدادَ جُنُودِهِ","فما افترقتْ صِنفاً ولا اجتمعتْ صِنفا",115,"ف",2,0],["وَتارَةً يَنحَطُّ في الغُيوبِ","كَعَومِ سُفنِ البَحرِ في الجَنوبِ",116,"ب",1,0],["وَتارَةً هُوَ ساقينا وَنَرجِسُنا","نَفسي فِداأُكَ مِن ساقٍ وَمَيدانِ",117,"ن",1,0],["وَتَأبَينُ الَّذي أَهوى","وَما تَأتينَ مِن عُسرَه",118,"ر",2,0],["وَتَأَلَّت ما أَتَت لي مُسخِطاً","كَذَبَت وَالمُنزِلِ القَطرِ جَدا",119,"د",2,0],["وتَأخُذُهُ عِندَ المَكارِمِ لِذَّةٌ","كَما اِهتَزَّ تَحتَ البارِحِ الغُصُنُ الرَطبُ",120,"ب",1,1],["وَتَأَيَّيتُ لِيَومٍ لاحِقٍ","وَمَضى في المَوتِ إِخوانُ الصَفا",121,"ا",1,0],["وَتَأكُلُ لَحمَ الخِلِّ مُستَعذِباً لَهُ","وَتَزعُمُ لِلأَقوامِ أَنَّكَ عاذِبُ",122,"ب",1,0],["وَتَأكُلُنا أَيّامُنا فَكَأَنَّما","تَمُرُّ بِنا الساعاتُ وَهيَ أُسودُ",123,"د",1,0],["وَتاجُكَ مَعقودٌ كَأَنَّكَ هُرمُزٌ","يُباهي بِهِ أَملاكَهُ وَيُوائِمُ",124,"م",1,0],["وتأرَنُ مِن بَعدِ اللُّغوبِ كأنّه","إليها بجَدّ في النّجاءِ أشارا",125,"ر",2,0],["وتَأبَى عليَّ الصَّبرَ نفسٌ كئيبةٌ","وقلبٌ بأصنافِ الهمومِ رفيقُ",126,"ق",1,0],["وَتأَلمت لمصاب عا","تكة بزوجٍ قد تعدى",127,"د",2,0],["وتاريخ دنيا وأمجادُها","بنى رُكنَها خالدٌ ثم عالى",128,"ل",2,0],["وتاهتِ الأقصر اختيالاً","بالغيدِ في موسم الشتاءِ",129,"ا",2,0],["وَتَأَمَّلْ آيةً مُعْجِزَةً","ما قَرَأْنَا مِثْلَها في الكُتُبِ",130,"ب",1,0],["وَتَاللَهِ إِنَّ الدَهرَ في ذاتِ بَينِنا","عَلَيَّ لَها في كُلِّ حالٍ لَجائِرُ",131,"ر",1,0],["وَتَأَلَّفَتْ بَعْدَ الْعَدَاوَةِ أَنْفُسٌ","سَكَنَتْ بِعَدْلِكَ في نَعِيمٍ سَرْمَدِ",132,"د",1,0],["وَتَاهَ فَلَمْ يَلْتَفِتْ","وَشَأْنُ الْجَمَالِ الصَّلَفْ",133,"ف",1,0],["وَتَأَرَّجَتْ سُرَرُ الْبِطَاحِ كَأَنَّمَا","فِي بَطْنِ كُلِّ قَرَارَةٍ عَطَّارُ",134,"ر",1,0],["وَتَارِكاً رَسْمَهُ لِفَاقِده","مُصَوَّراً بِالْجِرَاحِ فِي الْخَلَد",135,"د",1,0],["وَتَأَهَّبُوا لِلثَّأْرِ وَالأَحْقَادُ فِي","أَكْبَادِهِمْ كَالْبِيضِ فِي الأَغْمَادِ",136,"د",1,0],["وَتَأْخُذُهَا النُّهَى نَهْباً مُبَاحاً","فَتَسْتَكْفِي بِهَا ظَمأً وَجُوعَا",137,"ع",2,0],["وَتَأْنَفُ أَنْ تَبِيتَ عَلَى رَجاءٍ","وَلَسْتَ لِمَا تُرَجِّي مُسْتَطِيعَا",137,"ع",2,0],["وَتَارَةً يَحْمِلُهُ طَائِرٌ","بِه ضِرَامٌ وَلَهُ زَفْرُ",138,"ر",1,0],["وَتَأَلُّقاً فِي الْوَجِهِ تَمَّاماً بِمَا","تُخْفِي الطَّوِيةُ مِنْ نَقِيَّ سَرَائِرِ",139,"ر",1,0],["وتائِهٌ مالَهُ دَارٌ ولاَ وطنٌ","يسْطُو على دارِنا قَسْراً ويُقْصِينَا",140,"ن",2,0],["وتأمل بين الحقول نباتًا","سوَّت الأرض سوقه، فاستقاما",141,"م",2,0],["وتالله ما اعتل النسيم وإنما","تعلم من شجوي فبان اعتلاله",142,"ل",2,0],["وتأنت نجمةٌ أرسى على","جفنها طيفٌ، خريفي الرِّداءِ",143,"ا",2,0],["وتأهَّبي زُمراً تجهزني","محضَ الأسى ، والذُّعرَ ، والقلقا",144,"ق",2,0],["وتأريخُ الشُعوبِ إذا تَبَنّى","دمَ الأحرارِ لا يمحوهُ ماحي",145,"ح",2,0],["وتأريخٍ أُريدَ لنا ارتجالاً","فآبَ كما أريدَ إلى افتضاح",145,"ح",1,0],["وتابَعْتُ أبْقَى الحالَتْينِ لمُهجتي","وإنْ لم تَقُمْ كلْتاهُما بِمطامعي",146,"ع",2,0],["وتَارَةً يَرْزُقُهُ ويَحْرِمُهْ بَدْرٌ","بَدَا فانْجَابَ عَاْهُ ظُلَمُهْ",147,"م",2,0],["وتأبى المرؤةُ في أهلِها","وتأبى السيوفُ ، وتأبى القَنَا",148,"ن",2,0],["وتأبى جراحى أن تضمّ شفاهها","كأن جراح الحبّ لا تتخثّرُ",149,"ر",1,0],["وتاب إليك الدهرُ من كل سيِّءٍ","وأعتَبكَ المقدارُ يا خيرَ مُعتَبِ",150,"ب",1,0],["وتاب إليك الدهرُ من كل سَيِّءٍ","وجاءك يسترضيك وهو مُنيبُ",151,"ب",1,0]]}