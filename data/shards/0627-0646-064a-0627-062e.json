{"poems":[[55,"دع الذميل إلى الغايات والرتكا","https://www.aldiwan.net/poem29920.html","البسيط"],[57,"بعثت إلي صحيفة مختومة","https://www.aldiwan.net/poem26527.html","الكامل"],[9,"أوصلت صرم الحبل من","https://www.aldiwan.net/poem21910.html","مجزوء الكامل"],[88,"يا كاسي الأخلاق في","https://www.aldiwan.net/poem68899.html","مجزوء الكامل"],[90,"أزمعت عنا إلى مولاك ترحالا","https://www.aldiwan.net/poem45053.html","البسيط"],[23,"إن يأخذ الله من عيني نورهما","https://www.aldiwan.net/poem21574.html","البسيط"],[53,"أنى تماطلني وأنت جواد","https://www.aldiwan.net/poem61868.html","الكامل"],[53,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[53,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[91,"الفن روض أنيق غير مسؤوم","https://www.aldiwan.net/poem44743.html","البسيط"],[87,"انظر إلى الأقمار كيف تزول","https://www.aldiwan.net/poem62837.html","الكامل"],[47,"علل النفوس قريبة أوطانها","https://www.aldiwan.net/poem66669.html","الكامل"],[46,"نسج المشيب له لفاعا مغدفا","https://www.aldiwan.net/poem29716.html","الكامل"],[33,"لمن الديار كأنهن سطور","https://www.aldiwan.net/poem42539.html","الكامل"],[107,"يا أيها الناس إن الله يأمركم","https://www.aldiwan.net/poem43081.html","البسيط"],[107,"قم ودع الأوثان والأصناما","https://www.aldiwan.net/poem44047.html","الكامل"],[77,"أحبب بتياك القباب قبابا","https://www.aldiwan.net/poem69103.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85334","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39630","البسيط"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142003","البسيط"],[108,"ناصر الفصحى","https://www.poetsgate.com/ViewPoem.aspx?id=179359",""],[128,"بادر إلى اللذات قبل فوات","https://www.aldiwan.net/poem23765.html","الكامل"],[234,"إني غريم والغريم مطالب","https://www.aldiwan.net/poem51018.html","الكامل"],[243,"لن نفترق","https://www.aldiwan.net/poem24809.html","عموديه"],[264,"يا منكرين على من","https://www.aldiwan.net/poem35547.html","المجتث"],[275,"لصلاح قومي أعشق التأليفا","https://www.aldiwan.net/poem34985.html","الكامل"],[280,"لا أعصر الخمر بل أغرس العنبا","https://www.aldiwan.net/poem25626.html","البسيط"],[382,"أفأي عين لا ترف وتدمع","https://www.aldiwan.net/poem59345.html","الكامل"],[406,"أنا مبحر","https://www.aldiwan.net/poem6758.html","عموديه"],[407,"لا تغدروا إن هذا الغدر منقصة","https://www.aldiwan.net/poem490.html",""],[422,"عفت المنازل رقة ونحولا","https://www.aldiwan.net/poem54062.html","الكامل"],[447,"شهدت بإخلاصي عذول قرائحي","https://www.aldiwan.net/poem14422.html","الكامل"],[447,"هيظت قلبي أبا الخرصي يسلوكا","https://www.aldiwan.net/poem14470.html","البسيط"],[458,"كاد الخريف يموت مثل مماتي","https://www.aldiwan.net/poem61246.html","الكامل"],[556,"لما اعتنقنا ليلة الرمل","https://www.aldiwan.net/poem47256.html","أحذ الكامل"],[556,"صدت وما صدها إلا على ياس","https://www.aldiwan.net/poem47749.html","البسيط"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66669","الكامل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53895","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48683","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48760","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48833","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48662","الكامل"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/77446","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96738","الكامل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126132","الرجز"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56656","البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46509","الرجز"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109088","المتدارك"],[291,"","https://poetry.dctabudhabi.ae/diwan/poem/48473","البسيط"],[1483,"","https://poetry.dctabudhabi.ae/diwan/poem/130671","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48916","الكامل"],[1652,"","https://poetry.dctabudhabi.ae/diwan/poem/67408","البسيط"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126658","الكامل"],[2021,"","https://poetry.dctabudhabi.ae/diwan/poem/139338",""],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109574","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93679","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200034",""],[3112,"","https://poetry.dctabudhabi.ae/diwan/poem/130449","الرجز"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100860","الكامل"],[3317,"","https://poetry.dctabudhabi.ae/diwan/poem/35875","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74088","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62762","الكامل"],[3641,"","https://poetry.dctabudhabi.ae/diwan/poem/202260","الرجز"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125924","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132132","الكامل"],[4083,"","https://poetry.dctabudhabi.ae/diwan/poem/147653","البسيط"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136940",""],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33536","الكامل"],[669,"خف يا محمد فالق الأصباح","https://www.poetsgate.com/ViewPoem.aspx?id=18411",""],[5206,"صِرف النصيحة","https://www.poetsgate.com/ViewPoem.aspx?id=187394",""],[5268,"سيمرُّ في دَمِنا الرَصاصُ","https://www.poetsgate.com/ViewPoem.aspx?id=207018",""],[5271,"أجهلُكْ","https://www.poetsgate.com/ViewPoem.aspx?id=64038",""],[5277,"طِمَاح","https://www.poetsgate.com/ViewPoem.aspx?id=190726",""],[5277,"دنيا زحلْ..","https://www.poetsgate.com/ViewPoem.aspx?id=194698",""],[5338,"إن لم تثر في نصر أهلك في اليمن","https://www.poetsgate.com/ViewPoem.aspx?id=187944",""],[5376,"ليلةُ أنسٍ أم حميمُ الغضا","https://www.poetsgate.com/ViewPoem.aspx?id=203249",""],[5425,"بَغداد .. حبيبتي","https://www.poetsgate.com/ViewPoem.aspx?id=199911",""],[5561,"ألقت معاذيرها ...","https://www.poetsgate.com/ViewPoem.aspx?id=194433",""],[5674,"ليلي مثل روحي راحل","https://www.poetsgate.com/ViewPoem.aspx?id=187317",""],[5674,"تغازل مصرعك","https://www.poetsgate.com/ViewPoem.aspx?id=190748",""],[5691,"تمرد الجرح","https://www.poetsgate.com/ViewPoem.aspx?id=206656",""],[5691,"خمسون عاماً...!","https://www.poetsgate.com/ViewPoem.aspx?id=206746",""],[5861,"أكان بوذيا قاتلي يا ترى ..أم انه قد كبرى","https://www.poetsgate.com/ViewPoem.aspx?id=191503",""],[5956,"يا رب حقق رغبتي بسهامِ ‏","https://www.poetsgate.com/ViewPoem.aspx?id=181989",""],[5956,"تركتُ البِيدَ عكس ما توخيت","https://www.poetsgate.com/ViewPoem.aspx?id=183701",""],[5956,"لِمَ يقصد الدخلاء دوماً بحرنا؟","https://www.poetsgate.com/ViewPoem.aspx?id=192186",""],[5956,"الفخر بالابن فراس","https://www.poetsgate.com/ViewPoem.aspx?id=192387",""],[5956,"شاعر الأديان","https://www.poetsgate.com/ViewPoem.aspx?id=192499",""],[5956,"هجاء","https://www.poetsgate.com/ViewPoem.aspx?id=192939",""],[6082,"التحدّي","https://www.poetsgate.com/ViewPoem.aspx?id=60781",""],[6093,"تلفت قلب","https://www.poetsgate.com/ViewPoem.aspx?id=207221",""],[6171,"عَزْفٌ عَلَى وَتَرِ الَيأسِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86326&r=&rc=9",""]],"verses":[["إِن يَأخُذِ المَوتُ مِنّا مَن نَضَنُّ بِهِ","فَما نُبالي بِمَن بَقّى وَمَن تَرَكا",0,"ك",2,0],["أَنّى أَخونُكِ يا ظَلومُ وَحُبُكُم","مِنّي بِحَيثُ جَرى شَرابُ الشارِبِ",1,"ب",1,0],["إِنّي أَخافُ الصُرمَ مِن","ها أَو شَحيجَ غُرابِها",2,"ب",3,0],["إِنّي اِختَبَرتُكَ في الكُهو","لَةِ وَالصِبا حَقَّ اِختِبارِ",3,"ر",1,0],["إني أخفّ لدى ذكراك مضطرباً","وإن حملت من الأحزان أثقالا",4,"ل",2,0],["إِن يَأخُذِ اللَهُ مِن عَينَيَّ نورَهُما","فَفي لِساني وَقَلبي مِنهُما نورُ",5,"ر",1,1],["إني إخالك تسْتَقِلُّ من الجَدا","ميسورَة فتكِيعُ حين تُكادُ",6,"د",1,0],["أنّى اختصرتِ الطريق يا سكَني","إلى لقاء الأكفان والحفرِ",7,"ر",1,0],["أنَّى أخوِّلُ من سواه محامدي","وهو الذي أرجو به التحويلا",8,"ل",2,0],["اني اخاف افتتانا فيه مفتضحي","فانما انا شيخ غير معصوم",9,"م",1,0],["إِنّي أَخافُ عَلى السَماءِ مِنَ الأَذى","في يَومِ يُفسِدُ في السَماءِ الجيلُ",10,"ل",1,0],["أَنّى أَخافُ جِماحَها مِن بَعدِما","ظَهَرَ الدَواءُ وَفي يَدَيهِ عِنانُها",11,"ن",3,0],["إِنّي أَخافُ بِلَحظَتي عُقباكَ أَن","تُدعى المَطولَ وَأَن أُسَمّى المُلحِفا",12,"ف",2,0],["أَن يَأخُذوكَ فَكُن فَتىً ذا فِطنَةٍ","إِنَّ الكَريمَ لَدى الحِذارِ صَبورُ",13,"ر",1,0],["إِنّي أَخافُ عَلَيكُم حادِثاً جَلَلاً","لا تَملِكونَ لَهُ رَدّاً إِذا حانا",14,"ن",2,0],["إني إخالُ البَيْتَ يُشرقُ جَوُّهُ","وإخالُ مَكّةَ ترفَعُ الأعلاما",15,"م",2,0],["إني اختصرْتُ لك المديحَ لأنّه","لم يَشْفنِي فجعلْتُهُ إغبابا",16,"ب",2,0],["إني أَخاف من انفجار هائِلٍ","فَعَلى النهى يتكاثر التَضييق",17,"ق",1,0],["إني أخاف عليها أن تضيعَها","يدٌ مُبرَّأة للسلم بيضاءُ",18,"ا",2,0],["إني أخاف عليكم في تحزبكم","أن تنصروا الخصم وهو الخصم والحكمُ",19,"م",1,0],["إِنِّي أخاطب سكان الكفور؛ فلا","أعي الخطاب، ولا القاموسُ يشرح لي",20,"ل",2,0],["إني أخو طرب أعيش لأَنتشي","علَّ الزمان يدوخ من نشواتي",21,"ت",2,0],["إني أخافُ إذا تركتَ تَغاضياً","عاداتِ مثلِكَ أن أكون مقصرا",22,"ر",2,0],["إني أخاف عليك وأختلجت","شفة إلى القبلات تلتهب",23,"ب",1,0],["إنّي أخاف عليكم","يا من غدوا منكرينا",24,"ن",2,0],["إني أخو العربِ الفخورُ بقومهِ","إن كنتَ تطلبُ يا فتى تَعريفا",25,"ف",2,0],["إنّي أخاف وَقَد عُجلْتهَا مِنَحاً","إِذا أؤَجّل مَدْحاً أن يكونَ رِبا",26,"ب",2,0],["إني أخاف ولست أولَ خائفٍ","والرعد تسبقه البروق اللُّمَّع",27,"ع",1,0],["إنِّي أُخاطِبُ أُمَّتي ورجاله","ونِسَاءَها وكِبَارها وصِغَارا",28,"ر",2,0],["إِنّي أَخافُ عَليكم مثلَ تلك غداً","وَفي الأمورِ تَدابيرٌ لِمَن نَظرا",29,"ر",2,0],["إنِّي اختبرت جنابَهُ فوجدْتُهُ","ظِلاًّ بهاجرة الخطوب ظليلا",30,"ل",2,0],["إِني أَخاف هجاك في هذا الوَرى","منه يبلهمُ طشاش المانح",31,"ح",1,0],["إني أخافك في سر وفي علن","وكل خاف بقلبي غير خافيكا",32,"ك",2,0],["إني أخوه بمهجتي وبلوعتي","زفراته تشتق من زفراتي",33,"ت",2,0],["إنّي أخاف العارَ يلصق بِي","يوماً ولا أَخشى من القتلِ",34,"ل",1,0],["إِنّي أَخافُ وَقد لاحتْ دلائلُهُ","طلوعَ يومٍ بوَدْقِ الموتِ رجّاسِ",35,"س",1,0],["إنّي أخافُ عليكما سُخطَ الذي","أرسى الجبالَ بسببٍ صَحصاحِ",36,"ح",1,0],["إنّي اختبرْتُ معانيهِ التي بهرتْ","فلم أجدْ مِثْلَهُ في اللبّ والفِطَنِ",37,"ن",1,0],["إني أخاف على أعادي صحوها","أن تدهمنَّهمُ بيوم حاصب",38,"ب",1,0],["إني أخاف بقاءه من بعد ما","رضى الجلاء وهم للترحال",39,"ل",1,0],["إني أخلِّد آثار الرجال على","مر الليالي وما لي فيهمُ أرب",40,"ب",1,0],["إني أخاف النار بع","د وميضها أن تستمرا",41,"ر",2,0],["إِنّي أَخَذتُ كَثيره عَن عُروَة","وَرَوَيتُ سائِرَه عَن المُجنونِ",42,"ن",1,0],["إنّي اِختبرتك يا اِبن مالك بعدما","عاينتُ قوماً ربحها خسرانُها",43,"ن",3,0],["إني أخاف ربي القديرا","يمسخ جسمي قرداً أو خنزيراً",44,"ر",2,0],["إني اخترعت المعاني في محاسنكم","كذاك أهل الهوى من قبلي اخترعوا",45,"ع",3,0],["إِني أَخاف أَن تَقول العرب","وَالعار لا يُنجيكَ منهُ الهَرَب",46,"ب",1,0],["إني أخلصت بخدمتكم","فاقرأ عن مشروعي تدرِ",47,"ر",1,0],["إِنْ يِأْخُذِ اللهُ مِنْ عَيْنَيَّ نُورَهُما","فَفِي لِسَاني وَسَمْعي مِنْهُما نُورُ",48,"ر",1,1],["إني أخال ولو أقول علمته","ما كنت في هذا المقال أخا افترا",49,"ر",2,0],["إِني أخاطب فيكمُ ولدي فإن","جمحَ اليراع فهفوةٌ من مُرشد",50,"د",1,0],["إنِّي أخَالُ عَلِيَّا غَيْرَ مُرْتَدَعٍ","حَتَّى يُؤدَّى كِتَابُ اللهِ والذَّمَمُ",51,"م",1,1],["أن يأخذوا بالثأر من","تلك القلوب القاسيه",52,"ي",2,0],["أنَّي أخٌ لكُمُ بدارِ مضيعةٍ","بُومٌ وغربانٌ عليه وُقُوعُ",53,"ع",1,0],["اني أخاف على حبيب طاهر","من صحبة السفهاء ان يتنجسا",54,"س",2,0],["إِني اِختَبرت بَني الوَرى فَرأيتهم","إِن الوَفاء بِهم أَقل قَليل",55,"ل",1,0],["اني أخوك وإن حرمت","من الجناح فزر أخاكا",56,"ك",2,0],["إني أخاف إن عصيت ربي","زيادةً عما مضى في الحقب",57,"ب",1,0],["اني اخص الراحلين بلفظة","تبقى السنين وتخلد الاعواما",58,"م",2,0],["إِنّي اِختَبَرتُ بَني الزَمانَ مُجَرِّباً","فَبَقيتَ فَرداً ما هُنالِكَ ثاني",59,"ن",2,0],["إِنّي أَخاف عليهم","يَهفو بهم في الأَمر هافِ",60,"ف",1,0],["إنّي أخافُ عليكَ إنْ أخرجتَهُم","يوماً كيومِ الحارثِ بنِ عُبَادِ",61,"د",1,0],["إني أخاف إن أخرت وعده","أن أضل إن تركت عهده",62,"د",2,0],["إني أخالك في النها","ر شعاع حب زاهر",63,"ر",1,0],["إني أخ لك في الحمى","وأخوك في البلد البعيد",64,"د",1,0],["إنْ يأخذ السقم من جسمي مآخذه","وأصبح القوم من أمري على خطر",65,"ر",1,1],["اني اخاف على الفصحى وقد عصفت","ريح المنية بالحامي وبالعَلم",66,"م",1,0],["أن يأخذا قيساً بلحظهِما","من ليسَ يقبلُ في الهَوى عَذلا",67,"ل",2,0],["إني أخاف عليكما سخط الذي","أرسى الجبال بسبسب صحصاح",68,"ح",1,0],["إنِّي أَخِي في اللهِ رَبِّي ناصِحٌ","صِرْفًا ومَحْضُ النُّصْحِ في تَجدِيدِهِ",69,"د",2,0],["إنّي أخافُ ولا أخافُ..كأنَّني","بَرقٌ إذا احترقوا أضاءَ سَحابَهْ",70,"ب",2,0],["إني أخيط الوهم حتى شلّني","شوق إليك يهزني وسيشغلُكْ",71,"ك",1,0],["إنّي أخافُ طهورَ بوحكِ إنّه","برمال شوقٍ جاءني متيمّما",72,"م",2,0],["إني اختصرتكِ في قلبٍ رآكِ سما","وسا مرُ السهدِ في عينيكِ يرتحلُ",73,"ل",1,0],["إِنِّي أُخَاطُبُكْم وَإِنّي عَارِفٌ","أَنْ لَيْسَ تَفْهَمُنِي الأَبَاعِرُ وَالْهُجُنْ(١٤)",74,"ن",1,0],["إنِّي أخال البدرَ في ليلهِ","سوف يعودُ مبْرقاً موْمِضا",75,"ض",2,0],["إِنِّيْ أَخَالَكُمَا تَاجَاً وَمَالِكَةً","فَجْرَ المَمَالِكِ ، عَدْلُ الدَهْرِ وَلَّاها",76,"ا",3,0],["إنّي أخافُ عليها من أراذلِها","وذو الرذيلةِ غدّارٌ إذا حكما",77,"م",2,0],["إني أخاف فراق خل راحل","ٍيا حزن قلبي والدموع هواطلُ",78,"ل",1,0],["اني أخافُ عليكٓ طيْشٓ رماحِهم","وأخافُ إِنْ ناديتٓ أنْ لا أسمٓعٓكْ",79,"ك",1,0],["إنّي أخوضُ بحورَ الشِّعْرِ ملْتَزِماً","وليْسَ يسبِقُني في خوْضِها قلَمُ",80,"م",1,0],["إنّي أخط ُّأحاسيسي على ورق ٍ","أمّا هواكِ بأعْماقي أسطِّرُهُ",81,"ر",2,0],["إني أخاطب عقلكم","يا أمة رجعت ورا",82,"ر",2,0],["‏ ‏إني أخَمِّنُ أنّ ظرفاً مانعاً","‏ ‏ لك عن زواجي صرَحي بكلام",83,"م",1,0],["إني أخاف عليها مِن أكاسرها","لأني حبي عميق لا يجافيها",84,"ي",3,0],["إني أخاف من انحيازِ عقولهم","دوماً لوسواسٍ ولاستعلاءِ",85,"ا",2,0],["إني أخاف عليكم كل ثانيةٍ","من الحوادثِ لو صارت* فما بيدي..",86,"د",2,0],["إني أخاف ولا أخاف بحاجةٍ","لأخٍ صديقٍ منقذ لي يرشدُ",87,"د",1,0],["إني أخُطُّ إليك أشعاري عسى","فيها نجاتُكَ من عذابِ مقذعِ",88,"ع",1,0],["اني اخاف عليك من شغفي","فلتهربي مني ولا تقفي",89,"ف",2,1],["إني أخبيء بعض النبض عن لغتي","فلا القوافي درت كلا ولا شفتي",90,"ت",2,1],["أَنَّى اخْتَفَيْتُ أَقَامَ يَبْحَثُ فِي المَدَى","وَيُفَتِشُ الأَجَواءَ عَنْ أَصْفَادِي",91,"د",2,0]]}