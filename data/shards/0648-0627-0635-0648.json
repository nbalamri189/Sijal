{"poems":[[73,"ماذا على طيف الأحبة لو سرى","https://www.aldiwan.net/poem4031.html","الكامل"],[66,"سكوت ثم صمت ثم خرس","https://www.aldiwan.net/poem67636.html","الوافر"],[87,"خلقنا للحياة وللممات","https://www.aldiwan.net/poem62917.html","الوافر"],[87,"قف على كنز بباريس دفين","https://www.aldiwan.net/poem63736.html","الرمل"],[64,"فديتك قد تنبهنا لدهر","https://www.aldiwan.net/poem52281.html","الوافر"],[64,"تصعيد هذا الدهر والتصويب","https://www.aldiwan.net/poem52503.html","الكامل"],[30,"إذا سقنا الفرائض لم يردها","https://www.aldiwan.net/poem5156.html","الوافر"],[46,"أفدت ركاب أبي سعيد للنوى","https://www.aldiwan.net/poem30330.html","الكامل"],[106,"رسالة المتنبي الأخيرة إلى سيف الدولة","https://www.aldiwan.net/poem26161.html","عموديه"],[50,"أنا والله مشتاق","https://www.aldiwan.net/poem63294.html","الهزج"],[102,"","https://poetry.dctabudhabi.ae/diwan/poem/142323","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54316","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54204","الخفيف"],[112,"حزن النبلاء","https://www.poetsgate.com/ViewPoem.aspx?id=35291",""],[96,"من كسعد ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66301&r=&rc=19",""],[309,"يا سائلي عن عبرتي ومدامي","https://www.aldiwan.net/poem16845.html","الخفيف"],[353,"وزائرة وليس بها احتشام","https://www.aldiwan.net/poem20687.html","الخفيف"],[366,"يا نديمي قسم بي الى الصهباء","https://www.aldiwan.net/poem68143.html","الخفيف"],[371,"وفر سهامك قد أصبت مقاتلي","https://www.aldiwan.net/poem17935.html","الكامل"],[406,"نقش على جدار الوطن","https://www.aldiwan.net/poem6788.html","عموديه"],[556,"أأبا الحسين كفيت ما بعد الردى","https://www.aldiwan.net/poem47742.html","الكامل"],[659,"","https://poetry.dctabudhabi.ae/diwan/poem/76564","الكامل"],[790,"","https://poetry.dctabudhabi.ae/diwan/poem/142577","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48746","الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56697","الكامل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132226","الخفيف"],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/198888","الطويل"],[2014,"","https://poetry.dctabudhabi.ae/diwan/poem/147697","الخفيف"],[2332,"","https://poetry.dctabudhabi.ae/diwan/poem/82149","الكامل"],[2382,"","https://poetry.dctabudhabi.ae/diwan/poem/101800","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60898","الكامل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87674","الطويل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102559","الكامل"],[2697,"","https://poetry.dctabudhabi.ae/diwan/poem/107181","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62875","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110006","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91799","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206160",""],[3767,"","https://poetry.dctabudhabi.ae/diwan/poem/80160","الوافر"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59473","الكامل"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111048","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119617","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123506","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123495","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123484","الرمل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123501","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120233","الكامل"],[4690,"تباريحُ روح","https://www.poetsgate.com/ViewPoem.aspx?id=153094",""],[4755,"هَدِيرٌ على الأَطلالِ","https://www.poetsgate.com/ViewPoem.aspx?id=207775",""],[4830,"هواجس حائرة","https://www.poetsgate.com/ViewPoem.aspx?id=195016",""],[4930,"جدِّدي عهد الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=213235",""],[5135,"قالت: أراك مغرداً","https://www.poetsgate.com/ViewPoem.aspx?id=201786",""],[5277,"عاشقُ الصوبين","https://www.poetsgate.com/ViewPoem.aspx?id=190966",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5431,"أحجية...","https://www.poetsgate.com/ViewPoem.aspx?id=213354",""],[5431,"حب بدائي...","https://www.poetsgate.com/ViewPoem.aspx?id=215203",""],[5461,"المعاناة","https://www.poetsgate.com/ViewPoem.aspx?id=30029",""],[5574,"صهوة حرفي","https://www.poetsgate.com/ViewPoem.aspx?id=205990",""],[5690,"رأى نظري ربوعهم فما لا","https://www.poetsgate.com/ViewPoem.aspx?id=172171",""],[5837,"سارعي يا بلادي","https://www.poetsgate.com/ViewPoem.aspx?id=179452",""],[5842,"إلى بشار الأسد بعد خطابه الثاني ( ثائر على الأسد )","https://www.poetsgate.com/ViewPoem.aspx?id=62445",""],[5956,"قولٌ مرعِبٌ","https://www.poetsgate.com/ViewPoem.aspx?id=184879",""],[6102,"فوائد الحقد","https://www.poetsgate.com/ViewPoem.aspx?id=182744",""]],"verses":[["وَأَصونُ وَجهَ مَدائِحي مُتَقَنِّعاً","وَأَكُفُّ ذَيلَ مَطامِعي مُتَسَتِّرا",0,"ر",2,0],["وَأَصواتٌ وَراءَ البابِ لَكِن","عِباراتُ الوَرى في القُربِ هَمسُ",1,"س",1,0],["وَأَصوَنِ صائِنٍ لِأَخيهِ عِرضاً","وَأَحفَظِ حافِظٍ عَهدَ اللِداتِ",2,"ت",1,0],["وَأُصولُ الخَمرِ ما أَزكى عَلى","خُبثِ ما قَد فَعَلَت بِالشارِبين",3,"ن",1,0],["وأصوات المثالثِ والمثاني","كما سجَعتْ على الأيكِ الحمامُ",4,"م",1,0],["وأصونُ نعلي أنْ تَمَسَّ مواطِئَاً","عِرضي بوطء ترابها مثلوبُ",5,"ب",1,0],["وَأَصواتَ النِساءِ مُقَرَّناتٍ","وَصِبيانٍ لَهُنَّ عَلى الحُجورِ",6,"ر",1,0],["وَأَصومُ بَعدَكَ عَن سِواكَ وَأَغتَدي","مُتَقَلِّداً صَومَينِ في رَمَضانِ",7,"ن",1,0],["وأصوغ في شفة السراب ملاحمي","إن السراب مع الكرامة يشرب",8,"ب",1,0],["وَأَصواتِ النَواقيسِ","عَلى الزيراتِ بِالفَجرِ",9,"ر",1,0],["وأصوغ فلسفةَ الجراحِ نشائداً","يشدو بها اللّاهي ويَشْجَى المؤلَمُ",10,"م",1,0],["وأصواتُ صدقٍ بالدعاء تتابعت","لها كدَوِيِّ النحلِ في أذُنِ النجمِ",11,"م",1,0],["وأصوغُ الشِّعرَ الذي يَفْرَعُ النَّجْمَ","وتُصْغِي لِجَرْسِه الشِّعْرَيانِ",12,"ن",1,0],["وأصوّرك في الموق .. وتكبر على الموق","وتطيح مع دمعي على ايدي وأقبّلك",13,"ك",1,0],["وأصون الطيوف بين جفوني","لو تطيق الجفون للطّيف ردّا",14,"د",2,0],["وأصولنا وشيوخنا من سادة","علوية نبوية فاسمع وعي",15,"ع",2,0],["وأَصواتُ الغِناءِ لها أَنيني","فَما تَنفَكُّ مِن هذا المَقامِ",16,"م",1,0],["وَأصول الاشجار تَرسب في قَي","د من الماء ضَيق الاِرجاء",17,"ا",2,0],["وَأَصونُ آمالي صِيانَةَ مَن يَرى","عُرفَ المُؤَمَّلِ دونَ شُكرِ الآمِلِ",18,"ل",1,0],["وأصوغ شعرا لو تمثل لفظه","رجلا لقال انا المحب المفتتن",19,"ن",1,0],["وأصونُهُ بالتُّرب والتّرب الّذي","فيه أكفُّ دوارسٍ وكوامسِ",20,"س",1,0],["وأصون سمعي عن مقالة عاذل","لتذّللي والحب غير مشيح",21,"ح",1,0],["وأصوغ النشيدَ من ذوب نفسٍ","تترامى بلاهب صخّاب",22,"ب",1,0],["وأصون عهد اللّه فيكم غالياً","برّ الفتى بالفتية الأبرار",23,"ر",1,0],["وأصون صبري أن يبدده الأسى","أمد النوى لكنه يتبدد",24,"د",1,0],["وأصول وما تفرّغ منها","أين منه حلولو والفقهاء",25,"ا",2,0],["وَ أصْوَاتهَا أشوَاقهَا لَوْ رَأيْتهَا","تحِنُّ وَ تبْكِي وَ هْيَ لِلْمُصْطَفى تهْوِي",26,"ي",1,0],["وأصون الحديث أودعه صو","ني سري ولا أخون رفيقي",27,"ي",1,0],["وأصون عرضي بالسخاء وقد غدت","غبر المحاجر شعثاً أولادي",28,"د",2,0],["وأصواتنا تشكو إليك بحاجة","بجلبة داع أو بندبة أشعار",29,"ر",1,0],["وأصومُ يومي كلّه فإذا دجى","ليلى سجدتُ إلى الصَباح المنْجلي",30,"ل",2,0],["وَأَصواتِ ثَكلى ما لَهُنَّ مُجاوب","وَمُستَشفِعاتٍ ما لَهُنَّ شَفيع",31,"ع",1,0],["وأصولهم شيخ إلى شيخ إلى","هادي الأنام ومن هناك المنبع",32,"ع",1,0],["وَأصُونُ آياتِ الكِتابِ وَقَدرَها","مِن أَن أُجِيبَ بِها ذَوِي الطُّغيانِ",33,"ن",1,0],["وأُصُولٌ لولا الفروعُ عليها","لاستحالتْ طبيعةُ التَّركيبِ",34,"ب",1,0],["وأُصولٍ غُصونُها ذاوياتٌ","عَرِيتَ من ملابس الأَوراقِ",35,"ق",1,0],["وَأَصون بِالصَبر المصيبة بي كَمَن","يُخفي ضَنَى جسمٍ بطيبٍ يُضمَخ",36,"خ",1,0],["وأصوغ من لحن المنى","صوتًا يسر السامعينا",37,"ن",2,0],["وأصواتُ الرياحِ بكل فَجٍّ","أحبُّ إلي من نَقْر الدُّفوفِ",38,"ف",1,0],["وأصونُ عِرضي باذلاً في صونهِ","مالي فلم يُثْلَمْ ولا يتصدَّعُ",39,"ع",1,0],["واصول إن طلب الطعان بعزمه","فيه رحمت من العداة فؤادها",40,"د",3,0],["وأصول غرس الدين قد مَتنت","ساقاً وكاد يصيبها بَتلُ",41,"ل",1,0],["وأصولى صنهم وفرعى عن السو","ء وصحبى قريبهم والقاصى",42,"ص",2,0],["وأصولى لهم يمنّ بعون","وجميع الأصحاب والأولاد",43,"د",1,0],["وأصولى وفروعى هبهم","لمحة منك ومن قد صحبا",44,"ب",2,0],["وأصولى كذا الفروع وصحبى","يحفظ الكل من أذى هماز",45,"ز",1,0],["واصول اشتملت على","فقه المراتب والمناصب",46,"ب",1,0],["وأصون وعدي في الشغاف،وموْثقا","حتى وإنْ مزّقتَهُ ،وعدي",47,"د",2,0],["وأَصواتُ أيتامٍ يَصِيحُونَ: لا تَمُتْ","أَبَانا.. فَيَذْرُوهُمْ على الدَّارِ قاصِفُ",48,"ف",1,0],["وأصوغُ من لحن الغرامِ قصائداً","أشدو بها طرباً على لحظيكِ",49,"ك",1,0],["وأصوغُ حباتِ القلوبِ قلائدًا","لكثيرةِ العشاقِ كيما ترتدي",50,"د",2,0],["وأصُوغُ مِن عذْب الْكلامِ فَرائداً","وأشاركُ الْأنْغامَ أطْيَارَ الْفلا",51,"ل",2,0],["وأصوغُ للأحبابِ أعذارَ الهوى","فلعلَّهُ يوماً يُرى متدانيا",52,"ن",3,0],["وأصوات الجميع كصوت فرد","لدى الرحمن وهو على العوالي",53,"ل",2,0],["وأصوات الطبول إذا استُثيرت","فدقٌ لا يكلّ عن الحماسِ",54,"س",1,0],["وأصوات البداءة في انفعالٍ","كأنّ بها مساسا لا أباكا",55,"ك",2,0],["واصوّرْ معاناتي حروف وابياتْ","يلْقَى بها راعي الولَعْ جاذبيّهْ",56,"ي",2,0],["٧- وأصوغُ اللحْنَ \"كُرْدًا\"","أعزفُ الأوتارَ عزْفا",57,"ف",2,0],["وأصوات البشير تشير نحوي","لك البشرى لك البشرى أخالا",58,"ل",2,0],["واصوغ من جزل القصيد النادر","اللي مع الأيام وفق ابعادي",59,"د",2,0],["وأصواتُهم سَوفَ تغدو رُهاباً","يمسّكَ عند الهدوءِ المَهولِ",60,"ل",1,0],["وأصول بصَمصامي صَولا","وأحارب شبَحاً محتلا",61,"ل",2,0],["وَ أَصُولُ ؛ لا يَرقَى إِلَيَّ مُصاوِلٌ","وَ أَجُولُ ؛ لا يَطغَى عَلَيَّ مُجالِدُ",62,"د",1,0]]}