{"poems":[[111,"تكب على دنياك وهي تبيد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545632",""],[139,"بربك يا زيدان هل كنت تعلم","https://www.aldiwan.net/poem49175.html","الطويل"],[287,"إذا ما رأينا حسن وجه أبي الفتح","https://www.aldiwan.net/poem32823.html","الطويل"],[463,"لا تلمس الشمس يد","https://www.aldiwan.net/poem56236.html","مجزوء الرجز"],[469,"لقد غاض بحر العلم بعد أخي العلم","https://www.aldiwan.net/poem3167.html","عموديه"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62594","الوافر"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93106","المتقارب"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77820","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108708","البسيط"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66258","المتقارب"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132337","الطويل"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99468","الوافر"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134204","الطويل"],[3551,"","https://poetry.dctabudhabi.ae/diwan/poem/46048","المواليا"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85140","الطويل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117260","الوافر"],[5376,"صلاةُ العرْبِ في قدْسنا الفجْرُ","https://www.poetsgate.com/ViewPoem.aspx?id=188290",""],[5758,"شهقة المعنى","https://www.poetsgate.com/ViewPoem.aspx?id=200502",""],[5953,"متى فلكلي يقوم فأستريح","https://www.poetsgate.com/ViewPoem.aspx?id=93795",""],[5956,"حالُ العراق","https://www.poetsgate.com/ViewPoem.aspx?id=192358",""],[6212,"مهرة الشمس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1619&r=&rc=0",""]],"verses":[["متى فازت الآمال فيما ترومه","بباق وهل هذا الوجود وجود",0,"د",1,0],["متى فارقت أنبوبَها صرن صرصراً","إذا اشتمّ منها القوم فالقوم جُثمُ",1,"م",1,0],["مَتى فَتَّشَت أَبصارُنا ماءَ خَدِّهِ","قَبَسنا لَهيبَ النارِ في الماءِ بِالقَدحِ",2,"ح",1,0],["متى فقد طال المدى","لكلِّ شيء أمدُ",3,"د",1,0],["متى فا أبدى حكمةً معنويةً","على أعذب الألفاظ نافذة الحكم",4,"م",1,0],["متى فتحوا علينا العَيْ","نَ أغمضنا لهم طرفا",5,"ف",2,0],["متى فلك الحادثات استدارا","فغادر كل حشىً مستطارا",6,"ر",2,1],["مَتى فديتك تَبدو لي فرائده","تبسماً وَمَتى تَصفو موارده",7,"د",2,0],["متى فرى فرقُه ريحانَ طرته","تنفس الصبح وانشق الدجى وسرى",8,"ر",2,0],["متى فلك الحادثات استداراً","وغادر كلَّ حشىً مستطارا",9,"ر",2,1],["مَتَى فَتحَ اللَهُ المعارِفَ باسمِهِ","ومن دُونهِ حِصنٌ من الجَهلِ عامِرُ",10,"ر",1,0],["متى في البرج تحصل كي","تزيف ويهدر الذكر",11,"ر",1,0],["متى فسر القرآن يلفى كلاهما","لثانية بالإعجاز والفضل شاهدا",12,"د",2,0],["مَتى فديتك أَهَب صَدري عَلى صَدرِك","أَلثم خدودك وَأرشف يا قمر ثغرك",13,"ك",1,0],["متى فاتني بالوصل يبرد حرقتي","ويحرق قلباً للعذول الذي وشى",14,"ش",2,0],["متى في ساحة الأحباب يوماً","يجرّ بقربهم زهواً ذيولا",15,"ل",2,0],["متى في سماء العرب تعلو بنسْرها","ويعلو سماءاً في معزتها نسرُ",16,"ر",1,0],["مَتَى فَاضَ دَمْعِي والنُّجومُ طَوَالِعٌ","هَمَتْ فِي لَيَالي المُتْعَبِينَ هطُولُ",17,"ل",1,0],["متى فلكلي يقوم فأستريح","ووجه الأرض من ذهب يلوح",18,"ح",1,1],["متى في النار منضرجاً تراني","يقبلني النجاشي أم سطيح",18,"ح",1,0],["متى فيلم التوحش سوف يُنْهى","جعلتِ العُرْبَ يا صهيونُ أوْهَى..؟",19,"ه",2,0],["متى فيكِ يفْنى السؤالُ، ليحيا","جوابُ الأنوثةِ فيّ سَويّا ؟‏ ‏‏",20,"ي",2,0]]}