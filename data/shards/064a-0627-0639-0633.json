{"poems":[[57,"يا فوز بالله هبي","https://www.aldiwan.net/poem26465.html","مجزوء الرجز"],[50,"يا سالب الأذهان","https://www.aldiwan.net/poem66123.html","المجتث"],[435,"زارت فكان بأمر الله اسراها","https://www.aldiwan.net/poem41037.html","البسيط"],[4708,"صرخة غضب","https://www.poetsgate.com/ViewPoem.aspx?id=12191",""],[4816,"المارد الموهوب","https://www.poetsgate.com/ViewPoem.aspx?id=23719",""],[4866,"رمضان","https://www.poetsgate.com/ViewPoem.aspx?id=142236",""],[4918,"فوق راسي","https://www.poetsgate.com/ViewPoem.aspx?id=34596",""],[5055,"ماجد","https://www.poetsgate.com/ViewPoem.aspx?id=104297",""],[5198,"ذوق","https://www.poetsgate.com/ViewPoem.aspx?id=135069",""],[5198,"مشعل المنجومي","https://www.poetsgate.com/ViewPoem.aspx?id=136233",""],[5463,"لا إله الا ربّي يكسي باللحم العظام","https://www.poetsgate.com/ViewPoem.aspx?id=32819",""],[5525,"أجمل الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=854",""],[5526,"الفخر بالجوف","https://www.poetsgate.com/ViewPoem.aspx?id=200847",""],[5573,"ياحاتم","https://www.poetsgate.com/ViewPoem.aspx?id=200215",""],[5573,"لاتقولو ضاق فالدرب الحليم","https://www.poetsgate.com/ViewPoem.aspx?id=210462",""],[5756,"حد علمي","https://www.poetsgate.com/ViewPoem.aspx?id=5421",""],[5781,"شفاهٌ عُرْضَةٌ للدفء","https://www.poetsgate.com/ViewPoem.aspx?id=202841",""],[5848,"جريمة","https://www.poetsgate.com/ViewPoem.aspx?id=53361",""],[5962,"يا عسر","https://www.poetsgate.com/ViewPoem.aspx?id=206599",""]],"verses":[["يا عَسَلي يا سُكَّري","يا دُرَّتي يا ذَهَبي",0,"ب",2,0],["يا عَسجَداً في لُجَينٍ","في نَشوَةِ الصَمَدانِ",1,"ن",1,0],["يا عست فتداني كل مرتفع","لما سما في سما القرطاس بدراها",2,"ا",3,0],["يا عسى عرضي ومالي وولدي مع والديا","فدوة عن عرض أحمد مصطفى الرب وصفيه",3,"ي",2,0],["يا عسر درب اللي بغى الشعر تزيين","مثل المجاوب ع السؤال ب سؤالي",4,"ل",2,0],["يا عسى ذا الشهر مصباح ٍ منير","يرشد اللي من لخلاّقه لفا",5,"ف",2,0],["يا عسى ربي يحفظك يا السلام","ويحفظ التوحيد في أغلى وطن",6,"ن",1,0],["يا عساها بالمحبه لك سموع","وينتشي قلبك مع الذكرى سلام",7,"م",1,0],["ياعسى تنصاه الافراح ويروق","جوّه/ويارب حقّق مطمحه",8,"ح",2,0],["ياعسى نو السحاب اللي غزير خياله","يسقي ديار(ن)ربى فيها الكرم مع قومي",9,"م",2,1],["يا عسا ربّي يصونك مملكتنا كل عام","وكل عام ٍ وإنتي أرض ٍ غير فرحه ما تشوف",10,"ف",1,0],["ياعسي البدر نوره مايغيب","عن حبيبٍ بقي منه الكلام",11,"م",1,0],["ياعسى الله يحفظك وياعسى عمرك مديد","اطلب المعبود ربي يا إلهي ذو الجلال",12,"ل",1,0],["ياعسى الله مايخيب لك رجا ياابا الفوايد","مايخيب لك رجابالخير يومنك تريده",13,"د",2,0],["ياعسى ذكراه للريح العقيم","تنتشل باقيه لين ابلغ هواي",14,"ا",2,0],["ياعساني ماعدم إرضاه في برد وهجير","ولوعدمت مروّته ياعساني معدمه",15,"م",2,0],["يا عَسْجَدِيَّ الخُطى دَوِّنْ على جَسدي:","العِشقُ فنٌّ وفنُّ العِشْقِ أوَّاهُ",16,"ا",2,0],["يا عساك بخير يا قلب الرياض ويا ضياها","يوم غبت وما بقى لي غير ذكراك القديمة",17,"م",2,0],["يا عسر كم بتّم","اليسر فوقك حام",18,"م",1,1]]}