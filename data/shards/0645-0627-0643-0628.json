{"poems":[[48,"بلوت من هذه الدنيا وساكنها","https://www.aldiwan.net/poem22397.html","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96686","الرمل"],[585,"ماذا الجمود وجرعاء الديار دم","https://www.poetsgate.com/ViewPoem.aspx?id=161903",""],[5106,"عَاْشَ صَقْرَاً قَلَصَ الْكِبْرَ حِيْاْضَاْ","https://www.poetsgate.com/ViewPoem.aspx?id=150032",""],[549,"سيرةٌ إنسانيَّةٌ للرِّمال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87656&r=&rc=8",""]],"verses":[["ما كِبرُهُ وَثَقيلُ اللَحنِ يَمنَعُهُ","مِن سُرعَةِ الفَهمِ تَرسيلٌ وَتَمديدُ",0,"د",1,0],["ما كَبا في شأوِ ميدانِ العلا","لا ولا عَن غايةِ المجدِ وَقَف",1,"ف",1,0],["ما كبروا الله حتى كل ناحية","ردت ورجع في تكبيرها النغم",2,"م",1,0],["مَاْ كَبَاْ خَيْلٌ لَهُ أَوْ قَطُّ هَاْضَا","عَاْلِيَ الأكْنَاْنِ سَاْدَتْ مِنْهُ رُوْحٌ",3,"ح",1,0],["ما كَبَا حيثُ كَبَا لكنَّما","قُوَّةُ الشَّلَّالِ تحتاجُ انْحِدَارَهْ",4,"ر",2,0]]}