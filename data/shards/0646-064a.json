205111",""],[5573,"نيات قلبك يالوفي مخشوشه","https://www.poetsgate.com/ViewPoem.aspx?id=204548",""],[5573,"صلوا في رحالكم","https://www.poetsgate.com/ViewPoem.aspx?id=210867",""],[5626,"يا صانع المجد","https://www.poetsgate.com/ViewPoem.aspx?id=189590",""],[2110,"نأت وبنا من سحر مقلتها الوسنى","https://www.poetsgate.com/ViewPoem.aspx?id=156287",""],[5674,"أسرار ملحمة الوسامة","https://www.poetsgate.com/ViewPoem.aspx?id=189090",""],[5674,"نيزك يختال حسنا","https://www.poetsgate.com/ViewPoem.aspx?id=189102",""],[5686,"لو ماتت الأشجار ما مات الصدى","https://www.poetsgate.com/ViewPoem.aspx?id=203365",""],[5691,"مُصفِّقون...!","https://www.poetsgate.com/ViewPoem.aspx?id=208536",""],[5704,"جفاءٌ .. فصفاء","https://www.poetsgate.com/ViewPoem.aspx?id=191336",""],[5704,"رُدِّي السلام...","https://www.poetsgate.com/ViewPoem.aspx?id=198738",""],[5739,"زوايا الحبر ..!","https://www.poetsgate.com/ViewPoem.aspx?id=126878",""],[5741,"نيل مصر لمن تأمل مرأى","https://www.poetsgate.com/ViewPoem.aspx?id=187458",""],[5776,"أطوارُ ......عنكبوت الهولوكوست","https://www.poetsgate.com/ViewPoem.aspx?id=199338",""],[5826,"طرف الْكَرِيم عَن الغلياء لم ينم","https://www.poetsgate.com/ViewPoem.aspx?id=190271",""],[5956,"تجدد الإخلاص لله","https://www.poetsgate.com/ViewPoem.aspx?id=200102",""],[6004,"عروسُ الشَّرق","https://www.poetsgate.com/ViewPoem.aspx?id=71985",""],[6067,"بائع العسلية","https://www.poetsgate.com/ViewPoem.aspx?id=177158",""],[6070,"سائر الغيم","https://www.poetsgate.com/ViewPoem.aspx?id=187902",""],[159,"ِنِّي طَلَبْتُ إِلى القِرْطاسِ يَحْمِلُ لي","https://www.poetsgate.com/ViewPoem.aspx?id=6814",""],[6102,"هيت لك","https://www.poetsgate.com/ViewPoem.aspx?id=185305",""],[6115,"ودك تبيع الهلايم وسط سوق الحراج","https://www.poetsgate.com/ViewPoem.aspx?id=196480",""],[6125,"يَجتاحني حبٌّ تَملَّكَ في دمي","https://www.poetsgate.com/ViewPoem.aspx?id=210970",""],[6199,"أنا آخر العشّاق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79701&r=&rc=22",""]],"verses":[["نيفٌ بواحدهم ضاق الفضاء على","جيش تضيق به الغيطان والأكم",0,"م",1,0],["نَيِّرُ الأَقطارِ قَد ضَوَّأَ ما","بَينَ جَدِّيَّ الكَريمَينِ وَبَيني",1,"ن",2,0],["نيطَت بِعِطفَيهِ حَما","لاتُ المَغانِمِ وَالمَغارِم",2,"م",1,0],["نِيافٌ كَغُصنِ البانِ تَرتَجُّ إِن مَشَت","دَبيبَ قَطا البَطحاءِ في كُلِّ مَنهَلِ",3,"ل",1,0],["نيلٌ يَفيضُ عَلى سُهولِكِ رَحمَةً","وَفَتىً يَقيكِ غَوائِلَ العَثَراتِ",4,"ت",1,0],["نيطَت بِعَبّادٍ لَآلِىءُ مَجدِهِم","فَتَلَألَأَت في تومِها الأَفرادُ",5,"د",1,0],["نِيَّاتُهُمْ نِيَّاتُ صِدْ","قٍ تأْنَفُ المَجْدَ الْكِذَابَا",6,"ب",2,0],["نُيَمِّمُ إِسْمَاعِيلَ خَيْرَ مُيَثَّمٍ","بِصَرْحٍ بَنَاهُ مُنْجِبُوهُ القَمَاقِمُ",7,"م",1,0],["نِينَتُ حَظُّكِ فِي الحَيَاةِ جَمِيلُ","فَتَهَنَإِي وَلْيَهنَأَنَّ جَمِيلُ",8,"ل",1,1],["نَئِفنَ النَدى حَتّى كَأَنَّ ظُهورَها","بِمُستَرشَحِ البُهمى ظُهورُ المَداوِكِ",9,"ك",1,0],["نيك سوداء كالدجى","حين يدجو ويكثُف",10,"ف",1,0],["نيكٌ أذانُ صلاتِهِ","ضمٌّ وتقبيلٌ وشمُّ",11,"م",1,0],["نيويوركُ يا بِنتَ البُخارِ بِنا اِقصُدي","فَلَعَلَّنا بِالغَربِ نَنسى المَشرِقا",12,"ق",2,0],["نيويوركَ يا ذاتَ البُروجِ الَّتي","سَمَت وَطالَت كَي تَمُسَّ الغَمام",13,"م",1,0],["نَيرونُ لَو أَدرَكتَ عَهدَ كَرومِرٍ","لَعَرَفتَ كَيفَ تُنَفَّذُ الأَحكامُ",14,"م",1,0],["نَيرونُ إِن قيسَ في بابِ الطُغاةِ بِهِ","مُبالَغٌ فيهِ وَالحَجّاجُ مُتَّهَمُ",15,"م",1,0],["نَيِّرَةٌ تَنزِلُ عَن","هالَتِها لِنَيِّرَه",16,"ر",2,0],["نَيلُ المُنى وَحُكمُ نَفسِ المُرسِلِ","وَعُقلَةُ الظَبيِ وَحَتفُ التَتفُلِ",17,"ل",1,0],["نَيّالَةِ الطَلَباتِ لَولا أَنَّها","تُعطي مَكانَ لِجامِها ما نيلا",18,"ل",2,0],["نيطَت حَمائِلُهُ بِعاتِقِ مِحرَبٍ","ما كَرَّ قَطُّ وَهَل يَكُرُّ وَما اِنثَنى",19,"ن",2,0],["نَيْلُوفَرٌ يسبحُ في لُجَّةٍ","عليهِ ألوانٌ من اللَّبْسِ",20,"س",1,1],["نيكاً وَلَو بِالنُزولِ عَن كَتِفي","بِرذَونِهِ وَالخُروجِ مِن سَلَبِه",21,"ه",1,0],["نِيَّةٌ غَربَةٌ وَشَوقٌ مُقيمٌ","وادِعٌ في حِجالِهِ مَحجوبُ",22,"ب",1,0],["نَيلُهُ قُصرَةٌ عَلَيكَ وَكافٍ","لَكَ دونَ اِقتِضائِهِ إِقصارُه",23,"ر",2,0],["نُيَسَّرُ لِلَّتي تَمني المَواني","وَنَذهَبُ حَيثُ تُرسِلُنا الأُصولُ",24,"ل",1,0],["نيطَت حَمائِلُهُ مِنهُ إِلى مَلِكٍ","بِحَبلِ مُعتَصِمٍ بِاللَهِ مُعتَصِمِ",25,"م",1,0],["نَيلٌ يُحَكَّمُ فيهِ المُجتَدونَ إِذا","شِئنا أَخَذنا اِحتِكاماً فيهِ ماشينا",26,"ن",2,0],["نِيَّةٌ عُقِّبَت بِحِرمانِ حَظٍّ","رُبَّ نايِ يَنأى بِهِ حِرمانُه",27,"ن",2,0],["نيكَت زِناءً فَكَشخَنَتهُ وَقَد","نيكَ بُغاءً أَيضاً فَكَشخَنَها",28,"ن",3,0],["نيطَ في خَصْرِكَ رِدْفٌ","عَجَبي كيفَ تُقِلّهْ",29,"ل",2,0],["نينانُ أمواه وفُتْخُ سباسبٍ","وظباءُ آجامٍ وعُصْمُ شواهقِ",30,"ق",1,0],["نِيطَتْ عَلَيكَ عُقودُهَا وَلَطالَما","نُظِمَتْ لأَجيادِ المُلوكِ عُقودي",31,"د",2,0],["نيطَت قَلائِدُ عَزمِهِ بِمُحَبِّرٍ","مُتَكَوِّفٍ مُتَدَمشِقٍ مُتَبَغدِدِ",32,"د",1,0],["نَئِنُّ وَيَأبى القَومُ أَن نَتَكَلَّما","وَما يَملِكُ الصَمتُ اللِسانَ وَلا الفَما",33,"م",2,0],["نيسانُ هان علي حكُمك بالنَّوى","لما تحطّمت المنى في آب",34,"ب",1,0],["نِيافُ القُرطِ غَرّاءُ الثَنايا","وَرَيداءُ الشَبابِ وَنِعمَ خَيمُ",35,"م",1,0],["نِيرانُ شَرٍّ كَفانَا اللَّهُ شَرَّهُمُ","لا يَرْحَمُونَ وَلا يُبقُون إنْ ظَفِرُوا",36,"ر",3,0],["نِيطَتْ أكاليلٌ بها مَنظومَةٌ","فغَدا يُضاحِكُ دُرَّها مَرجانُها",37,"ن",3,0],["نَيلَ الكواكبِ رُمْتَ لا نَيل العلى","فزِدِ المكارِمَ بَسْطةً أو فانقُص",38,"ص",1,0],["نيلَت بِأَدنى المُهورِ أُختَهُمُ","قَسراً وَلَم يَدمُ أَنفُ خاطِبِها",39,"ب",3,0],["نيطَت إِلى بَدَنٍ كَالخَلقِ لَيسَ لَهُ","روحٌ وَلَكِنَّهُ مِن تَحتِ نَجّارِ",40,"ر",1,0],["نيطَ بتفّاحٍ إلى مشمشٍ","تخرقه الأنهارُ بالسُفنِ",41,"ن",1,0],["نيرانُ حِقدٍ بَينَ أَحشائِهِم","فَلَفظُهُم عَنها شَرارٌ وَثَب",42,"ب",1,0],["نيرانِ لاحا في ظَلامٍ لَنا","وَقَد لَمَحنا فيهِ نيرانا",43,"ن",2,0],["نيكوا فُكَيهَةَ وَاِمشوا حَولَ قُبَّتِها","مَشيَ الزَرافَةِ في آباطِها الخَجَفُ",44,"ف",1,0],["نيلها العذب ما أحلى مناظره","والشّمس تكسوه تبرا في تواريها",45,"ي",3,0],["نّي دعوتك للنّوائب دعوةً","لم يدع سامعها إلى أكفانه",46,"ا",3,0],["نِيرانُهُ مِن زِنَادِكُمْ قَدِحَتْ","وماؤهُ مِن بنانِكم نَبَعَا",47,"ع",2,0],["نَيَّبَتْهُ أَيَّامُهُ ولَيالِي","هِ بظُفْرٍ مِن الخُطُوبِ ونابِ",48,"ب",1,0],["نيام بين توراة","وقرآن وإنجيل",49,"ل",1,0],["نَيِّراتُ الأَيّامِ بَعدَكَ حُلكُ","وَحَياةُ الغَريبِ دونَكَ هُلكُ",50,"ك",1,1],["نِيلُكِ أحْلى مِنَ الأَمَاني","جَنىً وَأَذْكَى مِنَ الْوُرُودِ",51,"د",1,0],["«نيرون» أنت حفيده","لله درُّك من حفيد",52,"د",1,0],["نيل الجوائر من يديك جوائزٌ","أخرى تفوز بها يَمينُ الظافر",53,"ر",1,0],["نيسانُ، أنتَ لعين الدهر إنسانُ","يا ليت كلَّ ليالي الدهر نيسانُ!",54,"ن",1,1],["نيلها المستفيض أنشودة الله","على مسمع اللّيالي العوابر",55,"ر",1,0],["نيممت همدان الذين هُم هُم","إذا نَابَ أَمْرٌ جُنَّتِي وَحُسَامِي",56,"م",2,0],["نِيكَتْ زِنَاءً فكَشْخَنَتْهُ ، وقدْ","نِبكَ بُغَاءً أَيضاً فَكَشْخَنَها",57,"ن",3,0],["نَيْلُهُ قَصْرَةٌ عَلَيْكَ، وَكَافٍ","لَكَ دونَ اقْتِضَائِهِ اذّكَارُهْ",58,"ر",2,0],["نِيطَتْ عليك عقودهُما ولطالما","نُظِمَتْ لأجيَادِ الملوك عقودي",59,"د",2,0],["ِنّي لآمُلُ أَن أَراكِ وَإِنَّني","مِن أَن أَموتَ وَلا أَراكِ لَخائِفُ",60,"ف",1,1],["نَيْلاً ومازال جزيلَ النيل","قيْلاً من الأقيال وابن قيل",61,"ل",1,0],["ني نُتَيْلَة َكُفُّوا غَربَ جهلكُمُ","لا يصبِح السيفُ فيكم غيرَ معتذِر",62,"ر",1,0],["نِيافاً تَزِلُّ الطَّيْرُ قَذَفاته","تراشي الفؤاد الرخص ألا تخترا",63,"ر",2,0],["نيه جُفونك مِن نُعاسك","وَأَسمح بريقك أَو بِكاسك",64,"ك",1,1],["نيتي في طريقهم باعتقادي","هي لا بد تصلح الأحوالا",65,"ل",2,0],["نيرانُ حربِ بموج البحر قد طفئت","وَهيَ الموائدُ بينَ الماءِ والنارِ",66,"ر",1,0],["نيطت أمورُ الخلق منه بحازمٍ","متكفلٍ بالنقضِ والإبرامِ",67,"م",1,0],["نِيطَت به عُظمَى الأمور فلم يدع","فيها بحمدالله أمراً مغفلا",68,"ل",2,0],["نِيرانُ هَجْري لَيْسَ تَخْمَدْ","وَسُيُوفُ عَيْنِكَ لَيْسَ تُغْمَدْ",69,"د",1,1],["نيلانِ في مصرٍ فذلكَ قد جرى","ماءً وهذا عسجداً ولُجينُ",70,"ن",1,0],["نيران حسنك ضاءت لي فهمت بها","والنار أندى على قلبي من الماء",71,"ا",2,0],["نيرانه إن سألت عنه","نورٌ ومقتوله شهيد",72,"د",1,0],["نيرانُ عَبقَرَ في عَينَيكَ إِن مَرَدَت","هُزجُ الدُجى فَعَلى عَينَيكَ تَنصَهِرُ",73,"ر",1,0],["نِيطَت بَأَحزَمِ مَن يُرْجَى لنائبةٍ","رأْياً وأَكرم من يعفو ومن يَصِلُ",74,"ل",1,0],["نيطَت أُمورُ المُلكِ مِن آرائِهِ","بِقَوٍ أَشَمِّ المَنكِبَينِ ضَليعِ",75,"ع",1,0],["نيرانُهُم مَشبوبَةٌ وَشِفارُهُم","مَشحوذَةٌ وَجِفانُهُم تَتَدَعدَعُ",76,"ع",1,0],["نِيابَةً في راحَتَيهِ بِها","عَهدٌ مِنَ اللَهِ وَتَقليدُ",77,"د",1,0],["نئن من حرق منا بلا رمق","كأننا فيه تنوين واضمار",78,"ر",1,0],["نيطت مَكارم أَخلاق الكرام به","فكل عنه لسان القبل القال",79,"ل",1,0],["نَيّرُ الأرْض سَنىً في اتّضاحِ","نَيِّرُ الأفْقِ به في افْتِضاح",80,"ح",1,0],["نُيوب نَبَتْن مِن النّائِبات","وأزْرَينَ بالصارِمِ المُقْضِب",81,"ب",1,0],["نيلنا وهو دليلك","غاب لا غاب خليلك",82,"ك",1,0],["نيطتْ به كوتينِ القلبِ سلسلةٌ","إذا الوتين تنزّى يوم بشراك",83,"ك",1,0],["نيطَ تاجُ البها بأنجالك الأن","جادِ إِذ ميطت التمائمُ قَبله",84,"ل",2,0],["نيّراهُ على البروج يسيرا","نِ وَيَقتَرنان فيها اِصطكاكا",85,"ك",2,0],["نيشانَ مَجدٍ لِلخَليلِ أَسنى","وَرِفعَةَ حَتماً عَلَيها يَثني",86,"ي",1,1],["نيطت بحقوى فطم عشنق","شراب البان خلايا محنق",87,"ق",1,0],["نيسان يا روح القلو","ب وفتنة الربع الخصيب",88,"ب",1,1],["نيسان ما هذا الجما","لُ يسيل في أوج وطيب",88,"ب",1,0],["نيسان ما هذا الربيع","يفيض من غير نضوب",88,"ب",1,0],["نيسان ما اشجاك يا","نيسان يا قوت القلوب",88,"ب",1,0],["نيسان روحي تستشف","وراءك الامر العجيب",88,"ب",1,0],["نيسان والفرح الكث","ير على صفحائحه قشوب",88,"ب",1,0],["نيسان والامل الكبير","على معالمه يذوب",88,"ب",1,0],["نيسان والقلب المعذ","ب في جوانحه لهيب",88,"ب",1,0],["نيسان هل انت لنا","نيسان اما لك لا تجيب",88,"ب",1,0],["نيشانه العزّ وَالتَقوى بِضاعتهُ","وَصَرفه العَدل حَيث الفَضل مَتجرهُ",89,"ر",2,0],["نَيروزُ سَعْدٍ زائرُ مُعادُه","أسنَى القِرَى طُلوعُه بالأسعُد",90,"د",1,0],["نيطت بجؤن جحشم كماتر","حابي الضلوع مجفر حباتر",91,"ر",1,0],["نية مع غسل وجهك كله بالكمال","ثم اغسل ايديك واخرج للخطايا الثقال",92,"ل",1,0],["نيل ما يطلب أو دفع الذي","يختشي أو للقاه يدخر",93,"ر",1,0],["نيلُ العُلا دونَ ما أرجوهُ مِنك كما","أنّ الغِنَى دون ما تحبوهُ من نِعَمِ",94,"م",1,0],["نيران خدَّيك ها قد أحرقت كبدي","يا جنَّةً أنا منها اليوم في سفر",95,"ر",1,0],["نِيطَتْ نجومُ السَّعْدِ مِنْ أَعلامِها","وغَدَتْ جنودُ النَّصرِ من أَمْدادِها",96,"د",3,0],["نياتنا صلحت فيكم فليت لكم","فين