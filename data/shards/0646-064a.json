,"مجزوء الرجز"],[456,"ما أنكرت إلا البياض فصدتِ","https://www.aldiwan.net/poem56266.html","الكامل"],[459,"ان الوزارة وهي معتلج العلى","https://www.aldiwan.net/poem15592.html","الكامل"],[459,"نيطت حمائل سيفه","https://www.aldiwan.net/poem16105.html","مجزوء الكامل"],[462,"وافى فهز من القوام مثقفاً","https://www.aldiwan.net/poem3220.html","عموديه"],[480,"نيل الجفون أذاب قلب العاشق","https://www.aldiwan.net/poem24457.html","عموديه"],[498,"بين الكتائب والكثبان جلجلة","https://www.aldiwan.net/poem37780.html","البسيط"],[498,"ما رفرف السعد إلا في محاضرنا","https://www.aldiwan.net/poem37998.html","البسيط"],[513,"جاوز بمجدك أنجم الجوزاء","https://www.aldiwan.net/poem11996.html","الكامل"],[513,"يا خير من نظم المديح لمجده","https://www.aldiwan.net/poem12063.html","الكامل"],[556,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[556,"إني أنا فرضه وتقديره","https://www.aldiwan.net/poem34467.html","المنسرح"]],"verses":[["نَيِّرُ الأَقطارِ قَد ضَوَّأَ ما","بَينَ جَدِّيَّ الكَريمَينِ وَبَيني",0,"ن",2,0],["نيطَت بِعِطفَيهِ حَما","لاتُ المَغانِمِ وَالمَغارِم",1,"م",1,0],["نِيافٌ كَغُصنِ البانِ تَرتَجُّ إِن مَشَت","دَبيبَ قَطا البَطحاءِ في كُلِّ مَنهَلِ",2,"ل",1,0],["نيلٌ يَفيضُ عَلى سُهولِكِ رَحمَةً","وَفَتىً يَقيكِ غَوائِلَ العَثَراتِ",3,"ت",1,0],["نيطَت بِعَبّادٍ لَآلِىءُ مَجدِهِم","فَتَلَألَأَت في تومِها الأَفرادُ",4,"د",1,0],["نِيَّاتُهُمْ نِيَّاتُ صِدْ","قٍ تأْنَفُ المَجْدَ الْكِذَابَا",5,"ب",2,0],["نُيَمِّمُ إِسْمَاعِيلَ خَيْرَ مُيَثَّمٍ","بِصَرْحٍ بَنَاهُ مُنْجِبُوهُ القَمَاقِمُ",6,"م",1,0],["نِينَتُ حَظُّكِ فِي الحَيَاةِ جَمِيلُ","فَتَهَنَإِي وَلْيَهنَأَنَّ جَمِيلُ",7,"ل",1,1],["نَئِفنَ النَدى حَتّى كَأَنَّ ظُهورَها","بِمُستَرشَحِ البُهمى ظُهورُ المَداوِكِ",8,"ك",1,0],["نيك سوداء كالدجى","حين يدجو ويكثُف",9,"ف",1,0],["نيكٌ أذانُ صلاتِهِ","ضمٌّ وتقبيلٌ وشمُّ",10,"م",1,0],["نيويوركُ يا بِنتَ البُخارِ بِنا اِقصُدي","فَلَعَلَّنا بِالغَربِ نَنسى المَشرِقا",11,"ق",2,0],["نيويوركَ يا ذاتَ البُروجِ الَّتي","سَمَت وَطالَت كَي تَمُسَّ الغَمام",12,"م",1,0],["نَيرونُ لَو أَدرَكتَ عَهدَ كَرومِرٍ","لَعَرَفتَ كَيفَ تُنَفَّذُ الأَحكامُ",13,"م",1,0],["نَيرونُ إِن قيسَ في بابِ الطُغاةِ بِهِ","مُبالَغٌ فيهِ وَالحَجّاجُ مُتَّهَمُ",14,"م",1,0],["نَيِّرَةٌ تَنزِلُ عَن","هالَتِها لِنَيِّرَه",15,"ر",2,0],["نَيلُ المُنى وَحُكمُ نَفسِ المُرسِلِ","وَعُقلَةُ الظَبيِ وَحَتفُ التَتفُلِ",16,"ل",1,0],["نَيّالَةِ الطَلَباتِ لَولا أَنَّها","تُعطي مَكانَ لِجامِها ما نيلا",17,"ل",2,0],["نيطَت حَمائِلُهُ بِعاتِقِ مِحرَبٍ","ما كَرَّ قَطُّ وَهَل يَكُرُّ وَما اِنثَنى",18,"ن",2,0],["نَيْلُوفَرٌ يسبحُ في لُجَّةٍ","عليهِ ألوانٌ من اللَّبْسِ",19,"س",1,1],["نيكاً وَلَو بِالنُزولِ عَن كَتِفي","بِرذَونِهِ وَالخُروجِ مِن سَلَبِه",20,"ه",1,0],["نِيَّةٌ غَربَةٌ وَشَوقٌ مُقيمٌ","وادِعٌ في حِجالِهِ مَحجوبُ",21,"ب",1,0],["نَيلُهُ قُصرَةٌ عَلَيكَ وَكافٍ","لَكَ دونَ اِقتِضائِهِ إِقصارُه",22,"ر",2,0],["نُيَسَّرُ لِلَّتي تَمني المَواني","وَنَذهَبُ حَيثُ تُرسِلُنا الأُصولُ",23,"ل",1,0],["نيطَت حَمائِلُهُ مِنهُ إِلى مَلِكٍ","بِحَبلِ مُعتَصِمٍ بِاللَهِ مُعتَصِمِ",24,"م",1,0],["نَيلٌ يُحَكَّمُ فيهِ المُجتَدونَ إِذا","شِئنا أَخَذنا اِحتِكاماً فيهِ ماشينا",25,"ن",2,0],["نِيَّةٌ عُقِّبَت بِحِرمانِ حَظٍّ","رُبَّ نايِ يَنأى بِهِ حِرمانُه",26,"ن",2,0],["نيكَت زِناءً فَكَشخَنَتهُ وَقَد","نيكَ بُغاءً أَيضاً فَكَشخَنَها",27,"ن",3,0],["نيطَ في خَصْرِكَ رِدْفٌ","عَجَبي كيفَ تُقِلّهْ",28,"ل",2,0],["نينانُ أمواه وفُتْخُ سباسبٍ","وظباءُ آجامٍ وعُصْمُ شواهقِ",29,"ق",1,0],["نِيطَتْ عَلَيكَ عُقودُهَا وَلَطالَما","نُظِمَتْ لأَجيادِ المُلوكِ عُقودي",30,"د",2,0],["نيطَت قَلائِدُ عَزمِهِ بِمُحَبِّرٍ","مُتَكَوِّفٍ مُتَدَمشِقٍ مُتَبَغدِدِ",31,"د",1,0],["نَئِنُّ وَيَأبى القَومُ أَن نَتَكَلَّما","وَما يَملِكُ الصَمتُ اللِسانَ وَلا الفَما",32,"م",2,0],["نيسانُ هان علي حكُمك بالنَّوى","لما تحطّمت المنى في آب",33,"ب",1,0],["نِيافُ القُرطِ غَرّاءُ الثَنايا","وَرَيداءُ الشَبابِ وَنِعمَ خَيمُ",34,"م",1,0],["نِيرانُ شَرٍّ كَفانَا اللَّهُ شَرَّهُمُ","لا يَرْحَمُونَ وَلا يُبقُون إنْ ظَفِرُوا",35,"ر",3,0],["نِيطَتْ أكاليلٌ بها مَنظومَةٌ","فغَدا يُضاحِكُ دُرَّها مَرجانُها",36,"ن",3,0],["نَيلَ الكواكبِ رُمْتَ لا نَيل العلى","فزِدِ المكارِمَ بَسْطةً أو فانقُص",37,"ص",1,0],["نيلَت بِأَدنى المُهورِ أُختَهُمُ","قَسراً وَلَم يَدمُ أَنفُ خاطِبِها",38,"ب",3,0],["نيطَت إِلى بَدَنٍ كَالخَلقِ لَيسَ لَهُ","روحٌ وَلَكِنَّهُ مِن تَحتِ نَجّارِ",39,"ر",1,0],["نيطَ بتفّاحٍ إلى مشمشٍ","تخرقه الأنهارُ بالسُفنِ",40,"ن",1,0],["نيرانُ حِقدٍ بَينَ أَحشائِهِم","فَلَفظُهُم عَنها شَرارٌ وَثَب",41,"ب",1,0],["نيرانِ لاحا في ظَلامٍ لَنا","وَقَد لَمَحنا فيهِ نيرانا",42,"ن",2,0],["نيكوا فُكَيهَةَ وَاِمشوا حَولَ قُبَّتِها","مَشيَ الزَرافَةِ في آباطِها الخَجَفُ",43,"ف",1,0],["نّي دعوتك للنّوائب دعوةً","لم يدع سامعها إلى أكفانه",44,"ا",3,0],["نِيرانُهُ مِن زِنَادِكُمْ قَدِحَتْ","وماؤهُ مِن بنانِكم نَبَعَا",45,"ع",2,0],["نَيَّبَتْهُ أَيَّامُهُ ولَيالِي","هِ بظُفْرٍ مِن الخُطُوبِ ونابِ",46,"ب",1,0],["نيام بين توراة","وقرآن وإنجيل",47,"ل",1,0],["نَيِّراتُ الأَيّامِ بَعدَكَ حُلكُ","وَحَياةُ الغَريبِ دونَكَ هُلكُ",48,"ك",1,1],["نِيلُكِ أحْلى مِنَ الأَمَاني","جَنىً وَأَذْكَى مِنَ الْوُرُودِ",49,"د",1,0],["«نيرون» أنت حفيده","لله درُّك من حفيد",50,"د",1,0],["نيل الجوائر من يديك جوائزٌ","أخرى تفوز بها يَمينُ الظافر",51,"ر",1,0],["نيسانُ، أنتَ لعين الدهر إنسانُ","يا ليت كلَّ ليالي الدهر نيسانُ!",52,"ن",1,1],["نيممت همدان الذين هُم هُم","إذا نَابَ أَمْرٌ جُنَّتِي وَحُسَامِي",53,"م",2,0],["نِيكَتْ زِنَاءً فكَشْخَنَتْهُ ، وقدْ","نِبكَ بُغَاءً أَيضاً فَكَشْخَنَها",54,"ن",3,0],["نَيْلُهُ قَصْرَةٌ عَلَيْكَ، وَكَافٍ","لَكَ دونَ اقْتِضَائِهِ اذّكَارُهْ",55,"ر",2,0],["نِيطَتْ عليك عقودهُما ولطالما","نُظِمَتْ لأجيَادِ الملوك عقودي",56,"د",2,0],["ِنّي لآمُلُ أَن أَراكِ وَإِنَّني","مِن أَن أَموتَ وَلا أَراكِ لَخائِفُ",57,"ف",1,1],["نَيْلاً ومازال جزيلَ النيل","قيْلاً من الأقيال وابن قيل",58,"ل",1,0],["ني نُتَيْلَة َكُفُّوا غَربَ جهلكُمُ","لا يصبِح السيفُ فيكم غيرَ معتذِر",59,"ر",1,0],["نِيافاً تَزِلُّ الطَّيْرُ قَذَفاته","تراشي الفؤاد الرخص ألا تخترا",60,"ر",2,0],["نيه جُفونك مِن نُعاسك","وَأَسمح بريقك أَو بِكاسك",61,"ك",1,1],["نيتي في طريقهم باعتقادي","هي لا بد تصلح الأحوالا",62,"ل",2,0],["نيرانُ حربِ بموج البحر قد طفئت","وَهيَ الموائدُ بينَ الماءِ والنارِ",63,"ر",1,0],["نيطت أمورُ الخلق منه بحازمٍ","متكفلٍ بالنقضِ والإبرامِ",64,"م",1,0],["نِيطَت به عُظمَى الأمور فلم يدع","فيها بحمدالله أمراً مغفلا",65,"ل",2,0],["نِيرانُ هَجْري لَيْسَ تَخْمَدْ","وَسُيُوفُ عَيْنِكَ لَيْسَ تُغْمَدْ",66,"د",1,1],["نيلانِ في مصرٍ فذلكَ قد جرى","ماءً وهذا عسجداً ولُجينُ",67,"ن",1,0],["نيران حسنك ضاءت لي فهمت بها","والنار أندى على قلبي من الماء",68,"ا",2,0],["نيرانه إن سألت عنه","نورٌ ومقتوله شهيد",69,"د",1,0],["نيرانُ عَبقَرَ في عَينَيكَ إِن مَرَدَت","هُزجُ الدُجى فَعَلى عَينَيكَ تَنصَهِرُ",70,"ر",1,0],["نِيطَت بَأَحزَمِ مَن يُرْجَى لنائبةٍ","رأْياً وأَكرم من يعفو ومن يَصِلُ",71,"ل",1,0],["نيطَت أُمورُ المُلكِ مِن آرائِهِ","بِقَوٍ أَشَمِّ المَنكِبَينِ ضَليعِ",72,"ع",1,0],["نيرانُهُم مَشبوبَةٌ وَشِفارُهُم","مَشحوذَةٌ وَجِفانُهُم تَتَدَعدَعُ",73,"ع",1,0],["نِيابَةً في راحَتَيهِ بِها","عَهدٌ مِنَ اللَهِ وَتَقليدُ",74,"د",1,0],["نئن من حرق منا بلا رمق","كأننا فيه تنوين واضمار",75,"ر",1,0],["نيطت مَكارم أَخلاق الكرام به","فكل عنه لسان القبل القال",76,"ل",1,0],["نَيّرُ الأرْض سَنىً في اتّضاحِ","نَيِّرُ الأفْقِ به في افْتِضاح",77,"ح",1,0],["نُيوب نَبَتْن مِن النّائِبات","وأزْرَينَ بالصارِمِ المُقْضِب",78,"ب",1,0],["نيلنا وهو دليلك","غاب لا غاب خليلك",79,"ك",1,0],["نيطتْ به كوتينِ القلبِ سلسلةٌ","إذا الوتين تنزّى يوم بشراك",80,"ك",1,0],["نيطَ تاجُ البها بأنجالك الأن","جادِ إِذ ميطت التمائمُ قَبله",81,"ل",2,0],["نيّراهُ على البروج يسيرا","نِ وَيَقتَرنان فيها اِصطكاكا",82,"ك",2,0],["نيشانَ مَجدٍ لِلخَليلِ أَسنى","وَرِفعَةَ حَتماً عَلَيها يَثني",83,"ي",1,1],["نيطت بحقوى فطم عشنق","شراب البان خلايا محنق",84,"ق",1,0],["نيسان يا روح القلو","ب وفتنة الربع الخصيب",85,"ب",1,1],["نيسان ما هذا الجما","لُ يسيل في أوج وطيب",85,"ب",1,0],["نيسان ما هذا الربيع","يفيض من غير نضوب",85,"ب",1,0],["نيسان ما اشجاك يا","نيسان يا قوت القلوب",85,"ب",1,0],["نيسان روحي تستشف","وراءك الامر العجيب",85,"ب",1,0],["نيسان والفرح الكث","ير على صفحائحه قشوب",85,"ب",1,0],["نيسان والامل الكبير","على معالمه يذوب",85,"ب",1,0],["نيسان والقلب المعذ","ب في جوانحه لهيب",85,"ب",1,0],["نيسان هل انت لنا","نيسان اما لك لا تجيب",85,"ب",1,0],["نيشانه العزّ وَالتَقوى بِضاعتهُ","وَصَرفه العَدل حَيث الفَضل مَتجرهُ",86,"ر",2,0],["نَيروزُ سَعْدٍ زائرُ مُعادُه","أسنَى القِرَى طُلوعُه بالأسعُد",87,"د",1,0],["نيطت بجؤن جحشم كماتر","حابي الضلوع مجفر حباتر",88,"ر",1,0],["نية مع غسل وجهك كله بالكمال","ثم اغسل ايديك واخرج للخطايا الثقال",89,"ل",1,0],["نيل ما يطلب أو دفع الذي","يختشي أو للقاه يدخر",90,"ر",1,0],["نيلُ العُلا دونَ ما أرجوهُ مِنك كما","أنّ الغِنَى دون ما تحبوهُ من نِعَمِ",91,"م",1,0],["نيران خدَّيك ها قد أحرقت كبدي","يا جنَّةً أنا منها اليوم في سفر",92,"ر",1,0],["نِيطَتْ نجومُ السَّعْدِ مِنْ أَعلامِها","وغَدَتْ جنودُ النَّصرِ من أَمْدادِها",93,"د",3,0],["نياتنا صلحت فيكم فليت لكم","فينا صلحن عقيدات ونيات",94,"ت",1,0],["نيوب النائبات البائنات","قطعن حشاي قطع المرهفات",95,"ت",1,1],["نيرانه للقرى بالليل ساطعة","ونوره من قيام الليل فهو يضي",96,"ض",2,0],["نيرانُهم آراؤهم","والسابقاتُ الهممُ",97,"م",1,0],["نِيطتْ عُراها منه بابنِ نجيبةٍ","سهلِ الخُطَا تحتَ الخطوبِ الصعبةِ",98,"ه",1,0],["نيطتْ بأبْلَجَ من ذؤابةِ هاشمٍ","جَمِّ المآثر ذي سُطاً وسَماحِ",99,"ح",1,0],["نيطَتْ حمائلُ سَيفِهِ","بالفارسِ الشَّهْمِ الزَّمِيعِ",100,"ع",1,1],["نيطاً بعزم لا يقال له ونى","خوراً ورأي لا يقال له هفا",101,"ف",2,0],["نيل الجفون أذاب قلب العاشق","في جنح ليل غيهب من غاسق",102,"ق",1,1],["نِيابَتي عن رسولِ اللهِ ثابتَةٌ","بها أَساطينُ علمِ الله قد عَلِموا",103,"م",3,0],["نِيابَةُ المُصْطَفى في نشرِ حكمَتِهِ","قامتْ بغائِبِنا قِدْماً وحاضِرِنَا",104,"ن",2,0],["نيطت حمائلها الطوال بعاتق","متعود لتحمل الأعباء",105,"ا",2,0],["نيطت حمائلها بعاتق أروع","حمل الشدائد قبل وقت أشده",106,"د",2,0],["ني إليكم والحادثات تحول","سال دمعي دماً من الماء أميَعْ",107,"ع",1,0],["نئنُّ حتى تسيل أدمعنا","كأننا في الهوى نواعيره",108,"ر",2,0]]}