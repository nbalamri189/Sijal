{"poems":[[65,"طرقت ونحن بسرة البطحاء","https://www.aldiwan.net/poem46215.html","الكامل"],[88,"سكن الظلام وبات قلبك يخفق","https://www.aldiwan.net/poem68942.html","الكامل"],[29,"يا دار أقوت بجانب اللبب","https://www.aldiwan.net/poem5690.html","المنسرح"],[49,"اللوم للعاشقين لوم","https://www.aldiwan.net/poem25159.html","مجزوء البسيط"],[53,"لا ترج يا بيهقي إفراشي","https://www.aldiwan.net/poem64925.html","المنسرح"],[87,"درجت على الكنز القرون","https://www.aldiwan.net/poem63694.html","مجزوء الكامل"],[68,"لم تتبع الأمر إلا كان أو كادا","https://www.aldiwan.net/poem38505.html","البسيط"],[68,"كيف الضلال وصبح وجهك مشرق","https://www.aldiwan.net/poem41374.html","الكامل"],[107,"أمنارة الساري وأمن الوادي","https://www.aldiwan.net/poem42087.html","الكامل"],[69,"كتب المشيب بأبيض في أسود","https://www.aldiwan.net/poem18056.html","الكامل"],[50,"مستيقظ اللحظ في أجفان وسنان","https://www.aldiwan.net/poem66110.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39616","الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202530","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54705","البسيط"],[108,"ذكرى فريد !","https://www.poetsgate.com/ViewPoem.aspx?id=179479",""],[108,"ظل الحكم","https://www.poetsgate.com/ViewPoem.aspx?id=179710",""],[98,"عام جديد","https://www.poetsgate.com/ViewPoem.aspx?id=17900",""],[92,"ذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=179230",""],[107,"حيوا الهلال وحيوا أمة النيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54973&r=&rc=143",""],[240,"قلبي في حبك معمود","https://www.aldiwan.net/poem32104.html","السريع"],[358,"يا سادتي لو ترون الدمع بعدكم","https://www.aldiwan.net/poem40200.html","البسيط"],[415,"لم تترك السبعون في إقبالها","https://www.aldiwan.net/poem31963.html","الكامل"],[449,"بالله يا نسمات الرند والبان","https://www.aldiwan.net/poem55955.html","عموديه"],[449,"من أسرة الغنام ذات صيانة","https://www.aldiwan.net/poem56041.html","عموديه"],[463,"ليل السرى مثل نهار المقام","https://www.aldiwan.net/poem55886.html","السريع"],[463,"نبهت سعدا والأفق","https://www.aldiwan.net/poem56086.html","مجزوء الرجز"],[463,"غال بها فيما تسام واشترط","https://www.aldiwan.net/poem56144.html","الرجز"],[519,"ميلوا بنا نحو الحجون ونكبوا","https://www.aldiwan.net/poem20800.html","الكامل"],[556,"من أين زرت خيال ذات البرقع","https://www.aldiwan.net/poem47707.html","الكامل"],[567,"لا تجزعي يا نفس من حكم الردى","https://www.aldiwan.net/poem52894.html","البسيط"],[572,"يا من لأجفان قريحه","https://www.aldiwan.net/poem69759.html","مجزوء الرجز"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2485","المنسرح"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126883","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122825","الكامل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101509","الكامل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53904","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48827","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48642","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63925","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62584","البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144109","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79796","الكامل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87763","البسيط"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87712","الكامل"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105660","الكامل"],[2718,"","https://poetry.dctabudhabi.ae/diwan/poem/73938","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94272","الكامل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140042",""],[3318,"","https://poetry.dctabudhabi.ae/diwan/poem/138744",""],[3369,"","https://poetry.dctabudhabi.ae/diwan/poem/117031","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88923","الكامل"],[3550,"","https://poetry.dctabudhabi.ae/diwan/poem/206249","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216758","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125845","الكامل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81273","الخفيف"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136486",""],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83155","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83144","البسيط"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33284","الكامل"],[4679,"حتى مَ نلهو والمنية تنذر","https://www.poetsgate.com/ViewPoem.aspx?id=142723",""],[4755,"مأساة سُهَيل اليَمَاني ( 2 )","https://www.poetsgate.com/ViewPoem.aspx?id=210755",""],[4961,"الكهف الذي لم تدخله الظلمات","https://www.poetsgate.com/ViewPoem.aspx?id=33328",""],[4984,"مرَّ قطار صحبك","https://www.poetsgate.com/ViewPoem.aspx?id=175538",""],[5072,"أنا زيد .. // زيد خالد علي","https://www.poetsgate.com/ViewPoem.aspx?id=51800",""],[5156,"واحر بي من فراق قوم","https://www.poetsgate.com/ViewPoem.aspx?id=99209",""],[4623,"أتسرك الدنيا وعمرك ذاهب ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146604",""],[402,"يوم أثار كوامن الأشجان","https://www.poetsgate.com/ViewPoem.aspx?id=36526",""],[5956,"أرنو لطيفكِ","https://www.poetsgate.com/ViewPoem.aspx?id=192722",""],[5956,"ذهب القطينُ إلى جنازتها","https://www.poetsgate.com/ViewPoem.aspx?id=196839",""],[5956,"أمُّ الحبيبِ مُحمدٍ والمصطفى","https://www.poetsgate.com/ViewPoem.aspx?id=207118",""],[6211,"وانتهى الأمرُ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79197&r=&rc=16",""]],"verses":[["لمْ تَتِّبِعْ عَيني سِواكِ ولا ثَنى","عَنْكِ الفُؤادَ تَقَسُّمُ الأهواءِ",0,"ا",2,0],["لَم تَترُكا لي في المَدائِحِ فَضلَةً","يَجري بِها قَلَمي الضَعيفُ وَيَلحَقُ",1,"ق",1,0],["لَم تَتَلَفَّع بِفَضلِ مِئزَرَها","دَعدٌ وَلَم تُغذَ دَعدُ بِالعُلَبِ",2,"ب",1,0],["لَم تَتَفَرَّق بِنا خُؤولٌ","في جَذمِ عِزٍّ وَلا عُمومُ",3,"م",1,0],["لم تَتْرك البغي يا حُذَيْفَتَهُ","حتى أظلّتك خيلُ قِرواش",4,"ش",1,0],["لَم تَترُكوهُ في الجَلي","لِ وَلا الحَقيرِ مِنَ الشُؤون",5,"ن",1,0],["لَم تَتبَعِ الأَمرَ إِلّا كانَ أَو كادا","وَلَم تَرَ الخَطبَ إِلّا بانَ أَو بادا",6,"د",2,1],["لَم تَترُكِ الأَتراكُ بَعدَ جَمالِها","حُسناً لِمَخلوقٍ سِواها يُخلَقُ",7,"ق",1,0],["لم تَتَّخِذْ مُلكاً أزلَّ وَلم تُقِمْ","حُكماً على شَطَطٍ ولا اسْتبدادِ",8,"د",1,0],["لَمْ تَتْرُكِ التَّقْوَى لها مِنْ عادَةٍ","أُلِفَتْ ولا لِمَريضها مِنْ عُوَّدِ",9,"د",1,0],["لَم تَتَّصِل بِعُيونِ الناسِ لَحظَتُهُ","إِذا اِستَوى كُلُّ إِسرارٍ وَإِعلانِ",10,"ن",1,0],["لم تُتَحْ يوماً لجبَّارٍ طَغَى","أو لباغٍ فاتكِ السيف عُرامِ",11,"م",1,0],["لم تتق الله ولا الأياما","في أمم سبتهمو أيامى",12,"م",2,0],["لَمْ تَتْرُكِي مَنْزِلاً مُجِيداً","إِلاَّ إِلَى مَنْزِلٍ مُجِيدِ",13,"د",1,0],["لم تَتَّخِذْ حبَّ البلاد تجارة","أو سُلَّما تبغي عليه صُعودا",14,"د",2,0],["لم تتَّخذهُ لمطمعٍ","شَرَكًا، ولا سيفًا تَسُلُّه",15,"ل",2,0],["لم تتح لجبّار طغى","أو لباغ فاتك السّيف عرام",16,"م",1,0],["لم تتركي من كلِّ شاردةٍ","نَمَطاً ، ولا من نأمةٍ نَسَقا",17,"ق",2,0],["لم تتركي منزلاً آمناً ولم تدعي","لمدمن الخوف عيشاً غير مملول",18,"ل",1,0],["لَم تَتَدَنَّس بِسُؤالٍ وَلا","أَخلَقَها كَرُّ وَتَرديدُ",19,"د",1,0],["لَم تترك العين مِنّي بَعد ما غربت","مِنكُم وَأَرسَلت مِنها نَحوَكُم أَثَرا",20,"ر",2,0],["لم تترُكِ السبعونَ في إقبالِها","مِنّي سوى مالاَ عليه مُعوَّلُ",21,"ل",1,1],["لم تتخذ بدلا منها ولا سندا","لها سوى بعض تباع وغلمان",22,"ن",1,0],["لم تتخذ غير الفضائل مذهبا","وسوى الشريعة راية وحبيبه",23,"ب",2,0],["لم تترك الغورَ لنجدٍ مع ال","إلف ولم تهجر عراقاً لشامْ",24,"م",1,0],["لم تترك الأيامُ غي","رَ مجده ولم تُبَقْ",25,"ق",1,0],["لم تتحرَّشْ بشميم أمِّها","هجائن الفُرس ولا غُبْس النَّبَطْ",26,"ط",1,0],["لم تتّخذْ غيرَ المهنّدِ في الوغى","إلْفاً ولا غيرَ المثقَّفِ تَصحَبُ",27,"ب",1,0],["لَم تَترك الرَّوْحاتُ فَوق ضلوعها","وَقدِ اِلتَوَيْنَ بهنّ غيرَ الأضلُعِ",28,"ع",1,0],["لم تترُكِ الأحزانُ قلباً سالماً","منَّا فكيف نُطيقُ أن نَتَجلَّدا",29,"د",2,0],["لم تَتْرُكِ المُقَلُ المري","ضَةُ في جارِحَةً صَحِيْحَهْ",30,"ح",2,0],["لَم تَتَلَفَّع بِفَضلِ مِئزَرِها","دَعدٌ وَلَم تُسقَ دَعدُ في العُلَبِ",31,"ب",1,1],["لَم تتّخِذ غير المكارمِ منهجاً","فُقتَ الأنامَ بها يداً ولِسانا",32,"ن",2,0],["لَم تَترُكِ الأَيامُ في آياتِهِ","لِلعَينِ غَير عِراصِهِ وَنَويِّهِ",33,"ي",2,0],["لم تتخذهُ ذريعةً لمغانمٍ","يوليكها الممدوح وهو حقيرُ",34,"ر",1,0],["لم تَتّخِذْ فيه جليساً مؤنساً","غيرَ العلومِ وسِيرةَ العلماءِ",35,"ا",2,0],["لم تتركوهم سدى إلا لأنكمُ","أبيتمُ لهمُ عيش السراحين",36,"ن",1,0],["لم تتركي صرحاً هنا متعالياً","إلا لتمتلكي هنالك غيلا",37,"ل",2,0],["لم تتركِ الأمرَ إذا أصبحتَ تَكْنُفُه","تنالُ منه يدا مَنْ عَطَّ أو خرشا",38,"ش",2,0],["لم تترك الترك شيئاً من ذرى شَرَفٍ","إلا وقد ملأت من نشره الأفقا",39,"ق",2,0],["لم تتركِ الأسقامُ في بدني ال","مسكين مُعتَرَقاً لمُعترِقِ",40,"ق",1,0],["لم تَترك خطباً تصادِفُه","إلاَّ ثنته مقلَّم الظفر",41,"ر",1,0],["لَم تَترك الحَرب فيها غَير ثاكِلَة","وَثاكِلٍ مِن شُيوخ عُجَّزٍ وَنَسا",42,"س",2,0],["لَم تَترُك الحِمّى عَلى كَبدي","غَير الغِشاء وَفيهِ سِجِيّنُ",43,"ن",1,0],["لم تتل من درس الحياة سوى","عناوين الصبابة والهيام",44,"م",1,0],["لَم تَترُكوا غَيرَ أَجسامٍ مُعَطَّلَةٍ","وَلا حَياةَ لَها إِلا بِذِكرِكُمُ",45,"م",1,0],["لم تتخذ زاداً وقد","أزف الرحيل بلا اتخاذ",46,"ذ",1,0],["لم تتحد ذاته العظمى بمحدثة","ولم تحل على الآباد في أحد",47,"د",1,0],["لم تترك الأشواق منك لعلة","مأوى تحل به ولا لشفاء",48,"ا",2,0],["لم تترك الأتراك بعد جمالها","حسنا لمخلوق سواها تخلق",49,"ق",1,0],["لم تتصل حساده لصفاته","إلا اتصال الفكر بالآمال",50,"ل",1,0],["لم تترك الستون إذ نزلت به","من عهد صبوته سوى تذكاره",51,"ه",1,0],["لم تتبع نصحي وملت مع الهوى","جهلاً وغرّك أن غصنك أملد",52,"د",1,0],["لم تَتَّحِدْ أُممُ الضلالِ دقيقةً","إلا علينا دون أيِّ معين",53,"ن",1,0],["لَم تُتَوَج بِهِ قَياصرة الرُو","مان فيما اِنتَقيت مِن أَلوانه",54,"ن",2,0],["لمت تلفت الامجادُ قومك جيدها","إذا نزل الاعداء يوماً شِعابها",55,"ب",3,0],["لَم تَتَركا أَدَباً مِن حِين نَشأَتِهِ","حَتّى نَما وَسَما في سالِف الحقبِ",56,"ب",1,0],["لَم تَتَّخِذ لِلسِفارِ زاداً","وَلَم تَذُق في الرحيل خَطبا",57,"ب",2,0],["لم تتركِ العذالُ لومَهما","إلا ووصلُهما على خَطَرِ",58,"ر",1,0],["لم تتل أفواه الملا أعماله","الا غدت بعبيرها تتعطر",59,"ر",1,0],["لم تَترُكِ النَّارُ لِي بَابًا فَأُغلِقَهُ","ولم تَدَع لِيَ تحت السَّقفِ جُدرانا",60,"ن",2,0],["لم تتصلْ هذي الصَّلاةُ بأختِها","إلا وحبُّكِ فيهما شريانُ",61,"ن",1,0],["لم تتفق في الصلح رؤيا جلّهم","فتعددت للمصلحين مصادر",62,"ر",1,0],["لِم َ تتركين َ جواد َ أحلامي يرى","نار َ انْدحاري ثم َّ يصطنع ُ العَوَقْ ؟",63,"ق",1,0],["لم تتغير لنا الليالي","حتى أظلتهم المنون",64,"ن",1,0],["لم تتعظ بالحال منك وما جرى","لك لو عقلت تركت ما هو ذاهب",65,"ب",1,0],["لم تتعظ بسواك إن لم تتعظ","بالنفس منك وقد دهتك مصائب",65,"ب",1,0],["لم تتقد يوما لظى شنآن","ذنب المسيء إليه بالغفران",66,"ن",1,0],["لم تتركيني أي يوم مفردي","في ساعة السَّرَّاء والضرَّاءِ",67,"ا",2,0],["لم تترك الضعفاءَ دون حماية","لم تترك الفقراء دون إزارِ",68,"ر",1,0],["لَم تتركِ الأمراضُ أيَّ صبيّةٍ","وعجوزةٍ، إنّ الجميع قد اختفى..",69,"ف",2,0],["لمْ تَتْرُكِي تَحْتَ جِلْدِي مَا يُخَبِّرُني","لِمَ الرَّحِيلُ؟ وأَيْنَ السِّرُّ والْعُذْرُ؟",70,"ر",1,0]]}