{"poems":[[78,"عاضت بوصل صدا","https://www.aldiwan.net/poem39454.html","منهوك المنسرح"],[415,"ما يريد الشوق من قلب مغنى","https://www.aldiwan.net/poem32369.html","الرمل"],[443,"أرأيت ما صنعت لحاظ الغيد","https://www.aldiwan.net/poem2612.html","الكامل"],[556,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59142","الرمل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59127","الخفيف"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64670","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100225","البسيط"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/132016","الرمل"],[5469,"عاضاها فيما ادعت عارضاها","https://www.poetsgate.com/ViewPoem.aspx?id=169368",""],[5582,"أَسْيانُ ما فِي الأَيْكِ ناحَ حَمامُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=63573",""]],"verses":[["عاضَتْ بِوَصْلٍ صَدَّا","تُريدُ قَتْلي عَمْدا",0,"د",2,1],["عَاضَهُ الدّهرُ من القُربِ نَوىً","ومن الغِبطةِ بالأحبابِ حُزْنَا",1,"ن",2,0],["عاضت بك الأفهام بعد إياسها","عن كلّ منزور النوالِ زهيدِ",2,"د",1,0],["عاضَني اللَّه في فَضائِلكم عل","ماً بِشكٍّ وَزادني اِستِبصارا",3,"ر",2,0],["عَاضِدُ المُلْكِ رَشِيدُ الإقْتِرَاحْ","رَاشِدٌ أسْنَى",4,"ن",2,1],["عَاضِدُ المُلْكِ مَالِكُ الأمْرِ","حَازَ فَضْلَ السَّبَقْ",5,"ق",1,0],["عاضدْ خليلَكَ في مُلْكٍ تناهَبَهُ","بِمِصْرَ ذو الغَدْرِ فيها والأكاذيبِ",6,"ب",1,0],["عاضت عن الشمس قانوناً يبين لنا","وقتا فوقتا إذا غابت ولم تغب",7,"ب",1,0],["عاضدوا الكاتب في آرائه","وأعينوه ولو بالإبتسام",8,"م",1,0],["عاضاها فيما ادعت عارضاها","وسلاها عن مغرم ما سلاها",9,"ا",3,1],["عاضَتْهُ مِنْ صِيرانِهِ صِيرانُهُ","بَدَلاً وَمِنْ آرامِهِ آرامُهُ",10,"م",2,0]]}