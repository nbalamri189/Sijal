ww.poetsgate.com/ViewPoem.aspx?id=143405",""],[5689,"هات لي الكأس عزيز القلب هات","https://www.poetsgate.com/ViewPoem.aspx?id=143411",""],[5717,"هذا الكتاب معجز مشاهد","https://www.poetsgate.com/ViewPoem.aspx?id=170606",""],[5720,"كيف الحب ؟","https://www.poetsgate.com/ViewPoem.aspx?id=198865",""],[5725,"الى رحمة","https://www.poetsgate.com/ViewPoem.aspx?id=177499",""],[5781,"بطاقاتُ الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=208771",""],[5829,"الاسراء والمعراج","https://www.poetsgate.com/ViewPoem.aspx?id=166830",""],[5939,"حكايات الرمال","https://www.poetsgate.com/ViewPoem.aspx?id=178632",""],[5956,"إن كان لا يُعطيك شعري بعضُهم","https://www.poetsgate.com/ViewPoem.aspx?id=194702",""],[5988,"كيف يطيق الناس وصف الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=99714",""],[5997,"لَبَّيْكَ حَبِيْبِيْ","https://www.poetsgate.com/ViewPoem.aspx?id=214238",""],[6032,"عهود الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=181520",""],[6068,"الجمال -03-","https://www.poetsgate.com/ViewPoem.aspx?id=175908",""],[6068,"يا ظبية عن بعدها لا أقدر -21-","https://www.poetsgate.com/ViewPoem.aspx?id=177395",""],[6101,"بشرى السماء / حسن الأفندي","https://www.poetsgate.com/ViewPoem.aspx?id=120279",""],[6127,"مررْتَ كالطّيف","https://www.poetsgate.com/ViewPoem.aspx?id=198350",""],[6142,"بنت النبوة أخت الذكر أم هدا","https://www.poetsgate.com/ViewPoem.aspx?id=155741",""],[5724,"قف يا زمان معي بالله وانتحب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55151&r=&rc=18",""],[6215,"شرقيّة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84933&r=&rc=7",""],[6259,"لمن الرسومُ بعرصة ِ البردانِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59405&r=&rc=53",""]],"verses":[["بَلْ كَانَ فِي كلِّ رَهْطٍ مِنْ صَحَابَتِهِ","فَرِيدَةً الْعِقْدِ حَيْثُ الْعِقْدُ يَنْتَظِمُ",0,"م",1,0],["بَل كُلُّ سَعيِكَ باطِلٌ إِلّا التُقى","فَإِذا اِنقَضى شَيءٌ كَأَن لَم يُفعَلِ",1,"ل",1,0],["بل كنت تجمي الناس من كيدِ دهرهم","فكادك موتورٌ وقد يدْرَك الوتر",2,"ر",1,0],["بل كنت فيما حِدْتَ عنه ولم تَئِلْ","كالمستَجيرِ لظىً من الرَّمضاءِ",3,"ا",2,0],["بل كلُّ عضوٍ منه يو","جَدُ مذنباً حاشا عُنابهْ",4,"ب",2,0],["بل كيف للدَّها والإرْ","بِ حين تصمِدُ صمْدَه",5,"د",2,0],["بل كيف للعفو والجو","د حين تُنْجِزُ وعدَهُ",5,"د",2,0],["بل كيف للحزم والعزْ","مِ حين تُحْكِمُ عَقْدَهْ",5,"د",2,0],["بل كنتَ كالأسودِ الغليظ أخي ال","نَتْن لمن شمَّه وذي الوضَر",6,"ر",1,0],["بل كلْ هنيئاً كسب أن","فِك قد منحتُك منه شطرا",7,"ر",2,0],["بل كلهمْ بالشرّ أم","مَارٌ عن الخيرات زاجر",8,"ر",1,0],["بل كالمقادر إن تحصن دونها","مُتحصِّنٌ هجمتْ مع الأنفاس",9,"س",1,0],["بل كيف لا تأتجُّ في آلاته","نيرانُ هاجسةٍ بغير مساس",9,"س",1,0],["بلْ كل دَوْرٍ يدوره أحدٌ","ولا رضىً دون تابع السُدُس",10,"س",1,0],["بل كالسماء وكل ما زينت به","وكأرضها في قربه من لاقي",11,"ق",2,0],["بل كلُّ ذلك يجري في خواطرها","وما جهلتُ ولا ضاهيتُ مَنْ جهلا",12,"ل",2,0],["بلْ كنتَ للملكِ السعيدِ وديعةً","أمرَ الإلهُ بحفظِها جبريلا",13,"ل",2,0],["بل كلّ ما يوجبُ الإنصافَ منك له","مع الوسائل والأسبابِ والوُصَلِ",14,"ل",1,0],["بل كلا الشاكيين نُزّل منها","نُزُلاً طيباً من الأنزالِ",15,"ل",1,0],["بل كيف يشكرك اصطناعَ صنائعٍ","صدقُ التذاذِك فعلهنَّ قديمُ",16,"م",1,0],["بلْ كُلُّهُمْ لابسٌ حِلماً ومُنتزعٌ","رأياً ومِطعامُ أضْيافٍ ومِطعان",17,"ن",1,0],["بل كنتَ فيما قد لقيتَ مفكراً","حتى كأنك كنتَ ثَمَّ مُعاينا",18,"ن",2,0],["بل كاد من فَرْط الحميَّة أن يَرَى","فيما تقلَّد رأي معْتَزلِيِّ",19,"ل",2,0],["بَل كُلُّ قَومٍ وَإِن عَزّوا وَإِن كَثُروا","عَريفُهُم بِأَثافي الشَرِّ مَرجومُ",20,"م",1,0],["بَل كَعبَةَ المَعروفِ بَل كَعبَ النَدى","وَالماءُ يَقسِمُ شُربَهُ بِحَصاتِهِ",21,"ت",2,0],["بل كيف لم تحرص غدا","ة جرى يخر على شهابك",22,"ك",1,0],["بَل كَيفَ يَنجو وَالمُطالِبُ طاهِرٌ","بِمَواقِفِ الأَرصادِ وَالأَحراسِ",23,"س",1,0],["بَل كُلُّنا فيهِ سَواءٌ فَاجتَلِب","فَرَحاً يُزيلُكَ عَن مَحَلِّ البُؤَّسِ",24,"س",1,0],["بَل كَيفَ تَسلَمَ نَفسٌ مِنكَ قَد صَلِيَت","بِسَطوَتي وَمَخاليبي بِها عَلِقَه",25,"ق",2,0],["بَل كَيفَ زارَ وَدونَهُ مَجهولَةٌ","مِن سَبسَبٍ قَفرٍ تَمورُ بِآلِهِ",26,"ل",2,0],["بَل كانَ أَقرَبَهُم مِن سَيبِهِ سَبَباً","مَن كانَ أَبعَدَهُم مِن جَذمِهِ رَحِما",27,"م",2,0],["بَل كَيفَ تَقدُرُ أَن تُحَوِّلَ شيمَةُ","ثَقُلَت قَواعِدُها فَلَيسَ تُرامُ",28,"م",1,0],["بل كيف ننهض بالخطوب وإننا","لأرق من قمص تشف رقاق",29,"ق",1,0],["بَل كُنتُ بِها لِعابِدِ الأَو","ثانِ ثاني",30,"ي",1,0],["بَل كُلُّ مُنصَلِتٍ مِنّا وَمُنصَلِحٍ","في كَفِّ مُرتَجِلٍ مِنّا وَمُرتَجِزِ",31,"ز",1,0],["بَل كانَ كَالضَحّاكِ في سَطواتِهِ","بِالعالَمينَ وَأَنتَ إِفريدونُ",32,"ن",1,0],["بَلْ كَمْ خَطِيبٍ شَفَى نَفْسَاً بِمَوْعِظَةٍ","وَكَمْ طَبِيبٍ شَفَى جِسْمَاً مِنَ السَّقَمِ",33,"م",1,0],["بَل كَريمٌ عَلَّقَتهُ نَفسُهُ","بِكَريمٍ لَو يُرى أَو لَو يُدَن",34,"ن",1,0],["بل كنت لي عوناً على غربتي","وكنتِ لي راحمةً آسيهْ",35,"ي",2,0],["بَل كَيفَ يَحسُنُ بي التَقريظُ وَالعَزَلُ","وَشَيبُ رَأسي عَلى الفَودَينِ مُشتَعِلُ",36,"ل",1,0],["بَل كَيفَ تَأبى لِلنُفو","سِ وَغَيِّها في كُلِّ وادِ",37,"د",1,0],["بَل كَيفَ يَحمِلُ طولَ لَيلَتِهِ","قَلِقُ الوِسادِ يَبيتُ مُجتَنِحا",38,"ح",2,0],["بَل كَيفَ أُسقى عَلى الرَيحانِ مُتَّكِئاً","وَقَد تَعَلَّقتُ مِن أَسماءَ أَسبابا",39,"ب",2,0],["بل كُلَّما سمعوا هزيمَ رعودها","وَضعوا أَصابعَهم عَلى الآذان",40,"ن",1,0],["بل كلنا بشر أَبوهم مِن أَبي","عند الرجوع وَكلهم إخواني",40,"ن",2,0],["بل كان فظاً في معا","شرة يحقِّرها وجاها",41,"ا",3,0],["بل كنت في عهد","لِلعَيش فضفاض",42,"ض",1,0],["بل كلَّم وَهُوَ بغرفته","ناساً عَن بلدته شطروا",43,"ر",3,0],["بل كرمةٌ زانتْ","خلقَ الفراديس",44,"س",1,0],["بل كنت عِيدَيْنِ فِي التَّقْرِيبِ بَيْنَهُمَا","مَعْنىً لَطِيفٌ يُنَافِي كُلَّ تَبْعِيدِ",45,"د",1,0],["بِلْكَ لَعَمْرِي سُنَّةٌ نَجَا بِها","مِنْ قَبْلُ أَقْوَامٌأَنَتَحَدَّى",46,"د",2,0],["بَلْ كُنْتَ أَبْلَغَ إِذْ تَعَارِضُ وَصْفَهُ","وَتَفُوقُ بِالتَّمْثِيلِ وَالإِحْيَاءِ",47,"ا",2,0],["بل كان منها في ندى ماله","بل في بحار ذات تغريق",48,"ق",1,0],["بل كان نفح الخلد أمتعنا به","حيناً وعاد به إلى رضوانه",49,"ن",2,0],["بل كاتبًا في الأُفق حلَّ","ق غيرَ وانٍ عن شهابه",50,"ب",2,0],["بل كنت مثلَ النجم، يطوي أفقه","والعين تحسبه يسير وئيدًا",51,"د",2,0],["بَلْ كريمُ الأحجار ما ادَّخَرَ الما","ءَ؛ لإِحْيَاء كلِّ أرض مَوات",52,"ت",1,0],["بَلْ كَيْفَ يَحْسنُ بِي التَّقْرِيظُ والغَزَلُ","وشَيْبُ رأْسِي عَلَى الفَوْدَينِ مُشْتَعِلُ",53,"ل",1,0],["بل كُلُّنا فِيهِ سَواءٌ فاجْتَلبْ","فَرَحاَ يُزٍلُك عنْ محَلً البُؤَّسِ",54,"س",1,0],["بل كم ثقالٍ تَطبَّعوا بسجا","ياك فأضْحوا في خفّة القُذَذِ",55,"ذ",1,0],["بل كل شوقي وأشجاني وما انجبلت","بلابلي فيه يقظاناً وفي حلمي",56,"م",2,0],["بل كلما نَهْنَهْتَهُ","عن حالةٍ أبدى غرائبْ",57,"ب",1,0],["بل كَانَ مِنكَ رِيَاءً لِلرَّعِيةِ كَى","تَصطَادَ مِنهُم إِذَا أمُّوا العَطَا نِحَلا",58,"ل",2,0],["بل كلُّ مدحِك أمرٌ ليس من حِيلى","وكنْهُ وصفك ثِقلٌ ليس في آدى",59,"د",2,0],["بَل كانَ جودُكَ مِن سَحابٍ هاطِلٍ","أَندى وَمِن إيماضِ بَرقٍ أَسرَعا",60,"ع",2,0],["بَل كَيفَ لا تُثني عَلَيكَ خَواطِرٌ","أَنتَ الَّذي أَوسَعتَها إِفهاما",61,"م",2,0],["بَل كَيفَ أَجحَدُ ما أَنالَتني يَدٌ","بِكرُ الغِنى مِن سَيبِها وَعَوانُهُ",62,"ن",2,0],["بل كلما نادوه كيما يرحموا","زادت عليهم من لديه نقمة",63,"ه",1,0],["بَل كُلّ شَيءٍ فيهِ مُستَحسَنٌ","لَم أَهوَهُ مِن سَببٍ واحدِ",64,"د",1,0],["بل كيفَ يُمسي ذلك الباغي وقد","ثَبَتَت إدانَتُهُ ويُصبحُ مُدّعي",65,"ع",2,0],["بل كل ذا فيك أمسى","حريّة في ابن حرّ",66,"ر",1,0],["بل كلّ من قد حلّها","أرّخ يراها خير دار",67,"ر",1,0],["بل كيف ينعمُ مبصرٌ","هَلْ تُخبرُ الولدَ الضريرا",68,"ر",2,0],["بل كالهباء إذ الرمال لربما","كانت بها في الأعين الأقذاءُ",69,"ا",2,0],["بَل كُلَّ أَوقاتي وَحَقُّكَ ذائِبٌ","وَجداً وَلِلإِنكارِ بي أَحداقُ",70,"ق",1,0],["بَل كُلُّهُم مِن جَلاِ اللَهِ مُقتَبَسِ","وَكُلُّهُم مِن رَسولِ اللَهِ مُلتَمَسِ",71,"س",1,0],["بل كان في ذَهبٍ يَجلو البنانُ به","دُرَّ البيانِ إذا ما بَحْرُه زَخرا",72,"ر",2,0],["بل كنتُ واقيَ مَن عُلاه ومَجْدُه","لي دائماً مِمّنْ أذُمُّ وِقاء",73,"ا",2,0],["بل كيف لا أَصْلَى بحبك فانياً","وأرك في حبي أتُونَ صلاء",74,"ا",2,0],["بَلْ كنتَ عِندَ الله جَلَّ جلالُهُ","مِن أن يُنيلكَها أجلّ وأخطرا",75,"ر",2,0],["بل كل ما في الكون من أفضاله","حتى الغراب وربة الأطراف",76,"ف",1,0],["بَل كَيفَ تجدب بلدة تَجري بِها","وَيَداكَ في أَرجائِها بَحرانِ",77,"ن",1,0],["بَل كَيفَ تخطيني العلى وَأَنا امرؤ","أَرتادُ عاريهن مِن مِرتادِهِ",78,"د",2,0],["بلّ كُميّه من الدَّمع وما","بلّ من أحشائه الدَّمع غليلا",79,"ل",2,0],["بل كل خطب خطر بلوته","حتَّى تروى القلب فيه فارتوى",80,"ا",1,0],["بل كنِ الماء بلا لون يرى","آخذاً من كل كاسٍ مظهرا",81,"ر",2,0],["بل كيفَ لا يجبُ القلبُ الذي فعلَتْ","يدُ الصّبابةِ منه فوقَ ما يجبُ",82,"ب",1,0],["بل كيف يحسنُ بي الهوى ومحلّهُ","دون الحضيضِ ودونيَ الجوزاء",83,"ا",2,0],["بل كما تَبْغي مدى اليُمْ","نى الى الفضلِ السِيارُ",84,"ر",1,0],["بل كما تطلُبُ شأوَ الس","حْبِ في الأرضِ الغِبارُ",84,"ر",1,0],["بل كل سام سامك قدره","يحمى به للقبر كالحائم",85,"م",1,0],["بل كلُّهُ يومَ الكريهةِ شُعلة","وجميعه يومَ السلام الغارُ",86,"ر",1,0],["بل كلُّ مصطحِبَيْن قد رضِيا","بالغدر واصطلحا على الغَشْمِ",87,"م",1,0],["بل كلّ ما بعد المشيبِ مسمِحٌ","ماكسَ أو منجذبٌ تشمَّسا",88,"س",2,0],["بلْ كُلُّ يومٍ منكَ ذو شَرَفٍ","يُزْهى كما تُزْهى بكَ الرُّتَبُ",89,"ب",1,0],["بل كالشموس متى تجلوا في وغى","غدت الكماةُ بظلّ جنحٍ زائل",90,"ل",1,0],["بَل كُلُّ ذي ضِنَّةٍ وَبِشرٍ","كَالبَرقِ في العارِضِ الجَهامِ",91,"م",1,0],["بَلْ كانَ مَطْمَحُ قَصْدِهِ في قَوْلِهِ","وفِعالِهِ إدْرَاكَ ما هُوَ أَفْضَلُ",92,"ل",1,0],["بل كلُّ مِسكٍ عَبِقِ العَرفِ فمَا","بِغيرِ ذكرِه شَذاً لَم يَعبَقِ",93,"ق",1,0],["بَل كَريماً يَرتاحُ لِلمَجدِ بَسّا","ماً إِذا هَزَّهُ السُؤالُ حَييّا",94,"ي",2,0],["بَلْ كنتَ أعمقَ أسراراً مُقَدَّسَةً","من نطفةٍ بمياهِ الخَلْقِ تَصْطَفِقُ",95,"ق",1,0],["بل كل معن لقذ ذاق البلا حينا","حتى البلا بالملا منا بلى فينا",96,"ن",2,0],["بل كل مفعول به سابق","للفعل قطعاً عند من يفرق",97,"ق",1,0],["بل كان مجلس النب إن قصد","حيث انتهى المجلس بالمرء قعد",98,"د",1,0],["بل كيف ينبغي القيام والطلب","لمن جنى ما فيه قام واحتسب",98,"ب",1,0],["بل كيف كانوا استعملوا الإشارة","وتركوا التصريح بالعبارة",98,"ه",1,0],["بل كنتَ تنقُل عَزَّةً لكُثَيِّرٍ","في الحُبِّ أَو مَيّاً إِلى غَيْلاَنِ",99,"ن",1,0],["بل كلنا يدعو لسعد قائلا","عاش المقدس مائتي عام لنا",100,"ن",2,0],["بل كل فرد عينه قطرت دما","من ذلك الجرح الاليم الدامي",101,"م",2,0],["بل كم ملوك في مواكبهم وكم","