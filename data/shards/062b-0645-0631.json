9",""],[523,"هل لُغْزِي هذا مَفْهُومٌ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=100021",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[1583,"ثمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73057&r=&rc=14",""]],"verses":[["ثَمَرٌ حَرَّمَ واشي","كِ عَلَينا أَن نَذوقَه",0,"ق",2,0],["ثَمَري اليَومَ لِمَن أَورَقَني","وَإِذا ما أَورَقَ الفَرعُ عَقَد",1,"د",1,0],["ثمَرُ القلْبِ بِها خلّفْتُهُ","هلْ لقَلْبي بعْدَها منْ مُنتَجَعْ",2,"ع",1,0],["ثمّ رَدّ الأمورَ رَدّاً جَميلاً","لكَ منْ بَعْدِ فُرْقَةٍ وانْتِزاحِ",3,"ح",1,0],["ثُمَّ راحوا مَغرِبَ الشَمسِ إِلى","قُطُفِ المَشيِ قَليلاتِ الحَزَن",4,"ن",1,0],["ثُمَّ رَوِّحْهُمَا بِنَافِحَةٍ مِنْ","رَوْضِ مِصْرَ زَكِيَّةِ الأَرْدَانِ",5,"ن",1,0],["ثَمَرَاتُ مَا غَرَسَتْ يَدَا سَعْدٍ وَمَا","أَرْوَتْ نُفُوسَ الشِّيبِ وَالشُّبَّانِ",6,"ن",1,0],["ثم رمى نظرة مسترحم","في الكون عن طرف له حائر",7,"ر",1,0],["ثُمَّ رَمَيناهُنَّ بِالصُقورِ","فَجِئنَها بِالقَدَرِ المَقدورِ",8,"ر",1,0],["ثُمَّ رُحنا وَما يَخافُ خَليلي","مِن لِساني خِيانَةَ الإِنبِساطِ",9,"ط",1,0],["ثم رأى أنْ لم يُوفَّق رأيُهُ","فأطلقَ الطفلَ وأمسى في رَهَبْ",10,"ب",1,0],["ثم راما تلاقيا واذا الموت","فراق ما بعده من تلاق",11,"ق",1,0],["ثم رنا ثم دنا","ثم جثا ثم وثب",12,"ب",1,0],["ثُم رَمى المَغربَ فَاِهتَزَ لَهُ","وَحَث نَحو سجلماسةَ الخُطا",13,"ا",1,0],["ثُمَّ رَأى مَوجاً عَلى بُعدٍ عَلا","فَظَنَّ أَنَّ في الفَضاءِ جَبَلا",14,"ل",2,0],["ثمر محتجب في ال","بذر أبداه النبات",15,"ت",1,0],["ثُمَّ راسَلتَني بِكاساتِكَ المَز","زَةِ حَثَّ النَديمِ كَأسَ النَديمِ",16,"م",1,0],["ثَمَراتُ مَجدٍ مَدَّ نَحوَ قِطافِها","كَفّاً بِإِسداءِ الصَنائِعِ تَعبَثُ",17,"ث",1,0],["ثُمَّ راجَعتُ رُشدَ عَقلي وَكَفَّر","تُ يَميناً كانَت وَساوِسَ صَدري",18,"ر",2,0],["ثمرٌ على ثمرٍ وإن المُجتني","ليحار من عذب الجنى ما يطرح",19,"ح",1,0],["ثمَّ رماه بالتي","تبدِّلُ اللحنا",20,"ا",1,0],["ثُمَّ راحَت كَالمَغالي وَلَم","تَشفِ سَوّارَ غَليلِ الأُوام",21,"م",1,0],["ثم رمى وجهي بتفاحةٍ","لم يخطِها لمّا رمّى سنّي",22,"ن",2,0],["ثُمَّ رَثَّ الهَوى وَراجَعَني الحِل","مُ وَرُدَّت عارِيَّةُ المُستَعيرِ",23,"ر",1,0],["ثُمَّ راقَت بِاللَونِ وَالعَينِ حَتّى","كادَ حُبّي يَطيرُ بي عَن وِسادي",24,"د",2,0],["ثُمَّ راحوا عَبَقُ المِسكِ بِهِم","يُلحِفونَ الأَرضَ هُدّابَ الأُزُر",25,"ر",1,0],["ثمَّ رَمى الثَّغرَ بخيرِ قائدِ","وزادهم عنه بخيرِ ذائدِ",26,"د",1,0],["ثمراتُ الأحراث لا تتساوى","هذه حنطةٌ وهذا شعيرُ",27,"ر",1,0],["ثمرات من غرسهم قد جنوها","بئس ما قد جنوه من ثمرات",28,"ت",1,0],["ثمرُ الفكر ومجنى نورِه","ومراح العين والقلب العميد",29,"د",1,0],["ثمرٌ ناضجُ الجني","كيف لا نقطُفُ الثَّمَرْ",30,"ر",1,0],["ثَمَرَاتٍ مِنْ كُلِّ فَنٍّ بَدِيعٍ","فِي حُلِيٍّ مِنْ كُلِّ لَوْنٍ رَاقِ",31,"ق",1,0],["ثُمَّ رَدَّ الصَّبْرُ عَنْهُمْ","ذلِكَ الْكَيْدَ الْمُبِيدا",32,"د",2,0],["ثَمَّرَت فَرعي فَحينَ أَزهى","وَزانَني زينَة الرِعاثِ",33,"ث",1,0],["ثم رُمْنا أن نحاجِي ساعةً","لنُريحَ النفسَ من كدِّ العَناء",34,"ا",2,0],["ثمرٌ بلا ظلٍ لديك كما","في أسرِهِ ظلٌّ بلا ثمر",35,"ر",1,0],["ثُمَّ رَاسَلْتَنِي بكَاسَاتِكِ المَزَّةِ","حَثَّ النَّدِيمِ كَأْسَ النَّدِيمِ",36,"م",1,0],["ثُمَّ رافَقتُموهُ إِذ جاءَ يَلحا","ني فَأَلّا رافَقتُمُ العُوّادا",37,"د",2,0],["ثَمَرُ الغُصونِ تُبينُ عَن أَعراقِها","أَيَكونُ مِن غَيرِ الغُيوثِ سُيولُ",38,"ل",1,0],["ثَمَرٌ جيوشيُّ المَغارِسِ أَفْضَل","ىُّ الفرع للفَضْلَيْن فيه شِعار",39,"ر",1,0],["ثم راح العجوز ينسج أكفان","ثريا من لحية أرخاها",40,"ا",3,0],["ثمَّ رقت من بعد ما غرق النو","م وأرست سفينة الأشجان",41,"ن",1,0],["ثَمراتُ الطُهرِ مراشِفه","وَغُصونُ الزَنبَقِ أَذرعُهُ",42,"ع",2,0],["ثم رمَى قلبي بألحاظِه","وا بِأبِي ألحاظُه من رمَاه",43,"ا",2,0],["ثم رامت تخلصاً","فاغتدت ذات طرطره",44,"ر",2,0],["ثَمَرٌ كَأَنَّ بِهِ الَّذِي","بِي مِنْ جَوىً فِيه اصْفِرارُ",45,"ر",1,1],["ثمرُ الجفوِ بعدَ مَجناه مرّاً","مِن فجورٍ عاث مرابع جودِ",46,"د",1,0],["ثمَّ راحُوا لا ما مَعِي يُطرِفُ ال","قَومَ ولا ما أتَوا بهِ يُسلِيني",47,"ن",2,0],["ثَمرٌ طابَ عِرقُها مِن ثِمارٍ","مُخبِرٍ طيبُها بِطيبِ العُروقِ",48,"ق",1,0],["ثمَّ رأى الفِكرةَ تَعتادُه","فاعتَادَها يَلقى بِها ما لَقي",49,"ق",2,0],["ثمرات العلم أعمال التقى","إن عدمها فهو حجه ووبال",50,"ل",1,0],["ثم راحت منه البنان ذوى وي","ل طويل إذ تفقد الآباء",51,"ا",2,0],["ثَمَرٌ بغرسِك قد حلتْ مَجْناتُهُ","ونتائجٌ من بحر فكرك تُلقَحُ",52,"ح",1,0],["ثُمَّ رَآني غَيرَ مُستَأنِسٍ","أَنفُرُ مِن زَيدٍ وَمِن عَمرِو",53,"ر",2,0],["ثم رجَعتُ وفُؤادي مُضطَرِب","والدمعُ لم يَزَل بِخَدِّي مُنسَكي",54,"ي",1,0],["ثُم رأى بكَفِّي","ذاتَ البَها والظَّرفِ",55,"ف",1,0],["ثمرات على غصون الحوادثْ","بعثتها من الغيوب بواعثْ",56,"ث",1,1],["ثم رحنا والفكر بالشوق ساهي","ندفع الوقت بالرجاء وناهي",57,"ي",1,0],["ثم راح الجسم مضطرباً","شمَّ ريح الأمر فانتشقا",58,"ق",2,0],["ثم رأيتم هذه فضيلة","لنقص آرائكم العليلة",59,"ه",1,0],["ثم رويتم والظنون جمة","أن عليا قال خير الأمة",59,"ه",1,0],["ثم رُوحِي بالأَمَانِ فمِثْ","لي بسرٍّ قَطّ لَمْ يَبُحِ",60,"ح",1,0],["ثمر الجهاد جنيتموه ولم يضع","جهد عظيم دونه مبذول",61,"ل",1,0],["ثَمَرُ الحدائقِ منذ حلَّ ببسطةٍ","يبتاع جهْلاً قبل بَدْوِ صلاحِهِ",62,"ه",1,0],["ثم راجعتُ حب هندٍ فلم يل","قَ له في الحشا مكاناً فسيحا",63,"ح",2,0],["ثُمَّ رَدِّدْ حَديثَها لِكئيبٍ","فَحَياةُ الكئيبِ بِالترديدِ",64,"د",1,0],["ثُمَ رَنا بِعَينه مِن فَوقه","رَأى الغُرابَ طارِشاً مِن حَلقِهِ",65,"ه",1,0],["ثُم رَأى الجمَّيز عالي الشَجَرَه","ذا ثَمَر مُستَصغرٍ فَاِستَحقَرَه",66,"ه",1,0],["ثُمَ رَمى لكل شَخصٍ قشرَه","وَقالَ وَهوَ يَتَمنى عَشَرَه",67,"ه",1,0],["ثُمَّ رَجَعتُ مِثل ما جِئت إِلى","رِفاقِنا وَلَهُم فينا إِلى",68,"ل",2,0],["ثُمَّ رَكبنا بَعد في مَركَبنا","وَسارَ لَيلَة وَيَومَها بِنا",68,"ن",2,0],["ثَمرٌ مرٌّ لجانِيه","ِ وأوراق تَروقُ",69,"ق",1,0],["ثم رَبَّيتُهُ كتربية الطف","لِ رضيعاً وعند حالِ الفطيم",70,"م",1,0],["ثمراتها للجهبذ الن","حرير دانيةُ القِطافِ",71,"ف",1,0],["ثم راجَعَه حينَ رَوَّعهُ","كِبَرٌ معهُ الحلمُ والعِلَلُ",72,"ل",1,0],["ثم راحوا بعد الهدوء إلى دا","ري فلم يتركوا سوى الحيطان",73,"ن",1,0],["ثم رماني بسلحة خطمت","أنفي فزاولتها على يل",74,"ل",1,0],["ثمرٌ أصابته السهام ولم يزل","متماسكاً بذوائب الأشجار",75,"ر",1,0],["ثُمَّ رَقى المَنبَرَ يَومَ الجُمعَه","في مَسجِدِ الكوفَةِ يُذري دَمعَه",76,"ه",1,0],["ثم رَدَّ المسلوبَ من كلِّ جسمٍ","عذَّبتهُ الأمراضُ والأدواء",77,"ا",2,0],["ثم روح اللَه عيسى من له","آية النطق لَدى المهد فصل",78,"ل",1,0],["ثُمَّ رَمى اللَيلُ بِهِ قارِباً","يَستَوقِدُ النيرانَ في الجَروَلِ",79,"ل",1,0],["ثَمَراتٌ هِيَ لِلقَطف دَواني","أَيُّ عُذرٍ بَعدَ ذا لِلمتواني",80,"ن",2,1],["ثُمَّ رَحُودَه بَعدَهُم والوادي","مِنهُم لِخَنزِيرَه بالاسنادِ",81,"د",1,0],["ثمرات زهو يا بدائع حمدي","فد نلت في الاحسان أشرف قصد",82,"د",1,1],["ثُمَ راحَت لَمّا قَضى اللَهُ فيها","بِثَناءٍ وَطَيِّب التَذكارِ",83,"ر",1,0],["ثم راحوا مجردين سكارى","وتثنوا معربدين فغابوا",84,"ب",3,0],["ثمرات تجني بحلو حديث","ونكات تزهو بحسن اختراع",85,"ع",1,0],["ثم رجعت خفق قلبي نشيداً","يتهادى مع النسيم الواني",86,"ن",2,0],["ثمرٌ لا يَقِلّ، والعودُ ذاوٍ","وربيعٌ، والشمسُ في الميزان",87,"ن",1,0],["ثم راحوا بعدكم هملا","يحملون القيد كالغنم",88,"م",1,0],["ثم رضوا بالعاديات صدوراً","لأناس في الناس كانوا صدورا",89,"ر",2,0],["ثم ردُّوا لكم من الكل جزءاً","ودعوْه تصدُّقاً وسخاء",90,"ا",2,0],["ثم راحت فازّينت ثم عادت","ثم قالت أنا أم الشعر أحلى",91,"ل",2,0],["ثمر العيش قد مصصناه حلواً","ثم صرنا بالقشر نمتصُّ دهرا",92,"ر",2,1],["ثمر الوَصل أَرتجيه لأَني","عَن سوى الهاشمي أَصبَحت غارث",93,"ث",1,0],["ثمرات سعيك واجتها","دك ملؤ افواه الجناة",94,"ا",2,0],["ثمر تداوله الجناة ومنهل","حشدت عليه خوامس الوراد",95,"د",1,0],["ثم رجعتُ سائلاً","لذي المعالي والحجب",96,"ب",1,0],["ثمّ رَموا بجسمهِ المطهَرِ","من بعد قتله بسيف الأحمري",97,"ي",1,0],["ثم ركبنا بعد لاي ونصب","ونحن في ذل وويل وحرب",98,"ب",1,0],["ثم راموا بعده أن يخلصوا","من تباريح البلايا والبلش",99,"ش",1,0],["ثمر الرياض تعال يا","ثمر الرياض جُزِيتَ عشرا",100,"ر",2,0],["ثم رمى بنفسه كالخالع","إلى ابنه عبد الكريم الطائع",101,"ع",1,0],["ثم راحت لغرفة النوم سرا","وهي في مشيها تجيد خطاها",102,"ه",2,0],["ثم رحنا نجدد السير منا","باتجاهٍ الى نواحي الشمال",103,"ل",1,0],["ثم راح الجميع ينشد