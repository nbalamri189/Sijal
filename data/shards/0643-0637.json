{"poems":[[53,"أمل من مثانيها فهذا مقيلها","https://www.aldiwan.net/poem29893.html","الطويل"],[53,"الدمع مذ بعد الخليط قريب","https://www.aldiwan.net/poem30710.html","الكامل"],[9,"أأزمعت من آل ليلى ابتكارا","https://www.aldiwan.net/poem21940.html","المتقارب"],[51,"ومن ظن أن الاستزادة في الهوى","https://www.aldiwan.net/poem61896.html","الطويل"],[91,"رأيت غلاما مليح الرواء","https://www.aldiwan.net/poem8783.html","عموديه"],[38,"عاد الهموم وما يدري الخلي بها","https://www.aldiwan.net/poem7725.html","البسيط"],[43,"وشامخ من الجبال أقود","https://www.aldiwan.net/poem9548.html","الرجز"],[2,"تعلم أن شر الناس حي","https://www.aldiwan.net/poem25060.html","الوافر"],[80,"صمت لله صوم خرق همام","https://www.aldiwan.net/poem31287.html","الخفيف"],[39,"أساءك تقويض الخليط المباين","https://www.aldiwan.net/poem53738.html","الطويل"],[22,"أشاقتك ليلى في اللمام وما جزت","https://www.aldiwan.net/poem21660.html","الطويل"],[48,"مني إلى المتكبر","https://www.aldiwan.net/poem63350.html","مجزوء الكامل"],[48,"قد أغتدي والليل داج عسكره","https://www.aldiwan.net/poem63415.html","الرجز"],[48,"وشاعر ما يفيق من خطله","https://www.aldiwan.net/poem66556.html","المنسرح"],[46,"لا تعذلاني فالذي أبتغي","https://www.aldiwan.net/poem22743.html","السريع"],[8,"تأبد من ليلى رماح فعاذب","https://www.aldiwan.net/poem21765.html","الطويل"],[8,"سما لك هم ولم تطرب","https://www.aldiwan.net/poem21770.html","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54823","البسيط"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199493","المتقارب"],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[38,"عادَ الهمومُ وما يدري الخليُّ بها","https://www.poetsgate.com/ViewPoem.aspx?id=21204",""],[51,"من ظن أن الاستزادة في الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=27818",""],[141,"بك اقتضى الدين دينا كان قد وجبا","https://www.aldiwan.net/poem11722.html","البسيط"],[183,"انظر إلى الخال على خدها","https://www.aldiwan.net/poem14519.html","السريع"],[268,"تصبته ريحا شمأل وجنوب","https://www.aldiwan.net/poem35639.html","الطويل"],[296,"معيني على نفس شتيت جميعها","https://www.aldiwan.net/poem36313.html","عموديه"],[296,"عيون من كلامك قد","https://www.aldiwan.net/poem36803.html","عموديه"],[302,"قل لأحبابنا بسوح المقام","https://www.aldiwan.net/poem16829.html","الخفيف"],[377,"أقام بقلبه حزنه","https://www.aldiwan.net/poem48787.html","مجزوء الوافر"],[438,"أطاوي السبسب القهب","https://www.aldiwan.net/poem14421.html","مجزوء الوافر"],[456,"سلا من سلا من بنا استبدلا","https://www.aldiwan.net/poem56005.html","المتقارب"],[513,"لولا جفون ومقل","https://www.aldiwan.net/poem12209.html","مجزوء الكامل"],[536,"رعى الله أيام الصبا واللياليا","https://www.aldiwan.net/poem47491.html","عموديه"],[574,"إن الحبيبة حبها لم ينفد","https://www.aldiwan.net/poem1785.html","الكامل"]],"verses":[["كَطامِيَةِ التَيّارِ يَجري سَفينُها","أَوِ الفُلَجِ العَلياءِ يَهفو نَخيلُها",0,"ل",3,0],["كَطَريدِ يَومِ الوِردِ طالَ هُيامُهُ","فَغَدا يَحومُ عَلى الرَدى وَيَلوبُ",1,"ب",1,0],["كَطَوفِ الغَريبَةِ وَسطَ الحِياضِ","تَخافُ الرَدى وَتُريدُ الجِفارا",2,"ر",2,0],["كطالبِ رِبْحٍ في سبيلٍ مخوفةٍ","فأَوْدَى بأصل المال والحرصُ قد يودي",3,"د",2,0],["كَطَيّارَةٍ في مَهَبِّ الهَواءِ","إِلى أَن نَظَرتُ إِلى لِحيَتِه",4,"ه",1,0],["كَطُرَّةِ البُردِ يَروى الصادِياتُ بِهِ","مِنَ الأَجارِعِ لا مِلحٌ وَلا نَزَعُ",5,"ع",1,0],["كَطالِبِ الثَأرِ وَإِن لَم يَحقِدِ","يَقتُلُ ما يَقتُلُهُ وَلا يَدي",6,"د",2,0],["كَطِفلٍ ظَلَّ يَهدِجُ مِن بَعيدٍ","ضَئيلِ الجِسمِ يَعلوهُ اِنبِهارُ",7,"ر",1,0],["كطينةِ المسكِ لا تخليكَ من أرَجٍ","إذا تَنَسّمَ رَيّاها امرؤ فغما",8,"م",2,0],["كَطَوفِ مُتَلّي حَجَّةٍ بَينَ غَبغَبٍ","وَقَرَّةَ مُسوَدٍّ مِنَ النَسكِ قاتِنِ",9,"ن",1,0],["كَطَعمِ الشَمولِ طَعمُ فيها وَفارَةٌ","مِنَ المِسكِ مِنها في المَفارِقِ ذُرَّتِ",10,"ت",1,0],["كَطالِبٍ مَثَلاً قي","لَ خالِفِ القَومَ تُذكَر",11,"ر",1,0],["كَطالِبِ الأَوتارِ طُلَّت مِأَرُه","أَو لِمُحِلِّ النَحبِ كانَ يُذِرُه",12,"ر",2,0],["كطفلةٍ نصفُها كثيبُ نقا","ونصفُها كالقضيبِ في ميلِه",13,"ل",2,0],["كَطائِرٍ قيلَ أَلا تَغتَدي","فَقالَ أَنّي وَجَناحَي كَسير",14,"ر",1,0],["كَطَاوٍ بِعَروى أَلجَأَتهُ عَشِيَّةٌ","لَها سَبَلٌ فيهِ قِطارٌ وَحاصِبُ",15,"ب",1,0],["كَطَودِ يُلاَذُ بِأَركانِهِ","عَزيزِ المُراغِمِ وَالمَهرَبِ",16,"ب",1,0],["كَطَائِرٍ رَاقَهُ غَدِيرٌ","فَرَفَّهُ جَانِحاً وَطَار",17,"ر",1,0],["كطفل يداهن أستاذه","ليهمس \"أحسنت\" .. \"ما أجودا\"",18,"د",2,0],["كطُهْرِ \" الطفولةِ \" أجواؤه","وأفياؤه كرفيفِ الضحى",19,"ا",1,0],["كطيور السماءِِِ همّهُمُ الأوحدُ","زرعٌ يرَعْونه وحبوب",20,"ب",1,0],["كَطُرَّة ِ الْبُرْدِ تُرْوَى الصَّادِيَاتُ بِهِ","مِنَ الأَجَارعِ لاَ مِلْحٌ وَلاَ نَزَعُ",21,"ع",1,0],["كطالب رِبْحٍ في سبيلٍ مخوفة ٍ","فأَوْرى بأصل المال والحرصُ قد يودى",22,"د",2,0],["كَطارِدٍ إِبلَهُ وَالأَرضُ مُخصِبَةٌ","يَبغي سِباخاً يُرَجّي عِندَها العُشُبا",23,"ب",2,0],["كطابَعٍ من عنبرٍ حَطَّهُ","مُبَخِّرَ في وَسَط الجَمْرَه",24,"ر",2,0],["كطيرٍ تصبّاها ربيعُ بلادِنا","فأطربنا منها حنينُ سروب",25,"ب",1,0],["كطائرةٍ قد أُفلتتْ من حبالةٍ","فما سمعته أَو رأَته يروعها",26,"ع",3,0],["كطفلٍ أغضبته الأمُّ","إذْ منعته ثدييها",27,"ه",2,0],["كطواف به طواف الأملا","كِ حول العرش العظيم للإعظام",28,"م",1,0],["كَطَير كُلَما دَرَس ال","غَرام هَفا بِهِ فَننه",29,"ن",2,0],["كطي البُرد والأَتب","أَنخ بسعال واحتسب",30,"ب",1,0],["كطّيك في منتهىً واحد","لتُدرِكَ يثربَ أو مرقلا",31,"ل",2,0],["كطرر في غرر","أو طرز على حلل",32,"ل",1,0],["كَطيرٍ تَقَوَّى ثم طَار مُرَفرِفا","علَى الرَّوضِ في حِضنِ الطبيعَةِ شَادِيا",33,"ي",2,0],["كَطُرَيفَةَ بنِ العَبدِ كانَ هَدِيَّهُم","ضَربوا قَذالَةَ رَأسِهِ بِمُهَنَّدِ",34,"د",1,0]]}