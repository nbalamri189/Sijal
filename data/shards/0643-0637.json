sgate.com/ViewPoem.aspx?id=177471",""],[5725,"اتصبوا في غرامك","https://www.poetsgate.com/ViewPoem.aspx?id=178278",""],[5776,"حضوركَ أنتَ يكمنُ في الغيابِ","https://www.poetsgate.com/ViewPoem.aspx?id=199436",""],[5782,"تفاعل القصائد بالقوافي","https://www.poetsgate.com/ViewPoem.aspx?id=185762",""],[5783,"لايشرب الخمرة .. لكن يحتسيها","https://www.poetsgate.com/ViewPoem.aspx?id=34048",""],[5881,"يا طارق الباب","https://www.poetsgate.com/ViewPoem.aspx?id=183866",""],[5926,"في عتمة الليل","https://www.poetsgate.com/ViewPoem.aspx?id=213822",""],[5939,"وقد يُفصِحُ الزهرُ عمّا مَسَك","https://www.poetsgate.com/ViewPoem.aspx?id=178613",""],[5977,"إشراقة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=212732",""],[5992,"أرى مُرهفاً للبرق سُلَّ على الدجى","https://www.poetsgate.com/ViewPoem.aspx?id=41828",""],[6262,"السقوط","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80111&r=&rc=9",""],[6319,"الجنوب الصعب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86563&r=&rc=5",""]],"verses":[["كَطامِيَةِ التَيّارِ يَجري سَفينُها","أَوِ الفُلَجِ العَلياءِ يَهفو نَخيلُها",0,"ل",3,0],["كَطَريدِ يَومِ الوِردِ طالَ هُيامُهُ","فَغَدا يَحومُ عَلى الرَدى وَيَلوبُ",1,"ب",1,0],["كَطَوفِ الغَريبَةِ وَسطَ الحِياضِ","تَخافُ الرَدى وَتُريدُ الجِفارا",2,"ر",2,0],["كطالبِ رِبْحٍ في سبيلٍ مخوفةٍ","فأَوْدَى بأصل المال والحرصُ قد يودي",3,"د",2,0],["كَطَيّارَةٍ في مَهَبِّ الهَواءِ","إِلى أَن نَظَرتُ إِلى لِحيَتِه",4,"ه",1,0],["كَطُرَّةِ البُردِ يَروى الصادِياتُ بِهِ","مِنَ الأَجارِعِ لا مِلحٌ وَلا نَزَعُ",5,"ع",1,0],["كَطالِبِ الثَأرِ وَإِن لَم يَحقِدِ","يَقتُلُ ما يَقتُلُهُ وَلا يَدي",6,"د",2,0],["كَطِفلٍ ظَلَّ يَهدِجُ مِن بَعيدٍ","ضَئيلِ الجِسمِ يَعلوهُ اِنبِهارُ",7,"ر",1,0],["كطينةِ المسكِ لا تخليكَ من أرَجٍ","إذا تَنَسّمَ رَيّاها امرؤ فغما",8,"م",2,0],["كَطَوفِ مُتَلّي حَجَّةٍ بَينَ غَبغَبٍ","وَقَرَّةَ مُسوَدٍّ مِنَ النَسكِ قاتِنِ",9,"ن",1,0],["كَطَعمِ الشَمولِ طَعمُ فيها وَفارَةٌ","مِنَ المِسكِ مِنها في المَفارِقِ ذُرَّتِ",10,"ت",1,0],["كَطالِبٍ مَثَلاً قي","لَ خالِفِ القَومَ تُذكَر",11,"ر",1,0],["كَطالِبِ الأَوتارِ طُلَّت مِأَرُه","أَو لِمُحِلِّ النَحبِ كانَ يُذِرُه",12,"ر",2,0],["كطفلةٍ نصفُها كثيبُ نقا","ونصفُها كالقضيبِ في ميلِه",13,"ل",2,0],["كَطائِرٍ قيلَ أَلا تَغتَدي","فَقالَ أَنّي وَجَناحَي كَسير",14,"ر",1,0],["كَطَاوٍ بِعَروى أَلجَأَتهُ عَشِيَّةٌ","لَها سَبَلٌ فيهِ قِطارٌ وَحاصِبُ",15,"ب",1,0],["كَطَودِ يُلاَذُ بِأَركانِهِ","عَزيزِ المُراغِمِ وَالمَهرَبِ",16,"ب",1,0],["كَطَائِرٍ رَاقَهُ غَدِيرٌ","فَرَفَّهُ جَانِحاً وَطَار",17,"ر",1,0],["كطفل يداهن أستاذه","ليهمس \"أحسنت\" .. \"ما أجودا\"",18,"د",2,0],["كطُهْرِ \" الطفولةِ \" أجواؤه","وأفياؤه كرفيفِ الضحى",19,"ا",1,0],["كطيور السماءِِِ همّهُمُ الأوحدُ","زرعٌ يرَعْونه وحبوب",20,"ب",1,0],["كطيور في الأسر تبغي انعتاقا","قبل أن يفسد الإسار لغاها",21,"ا",3,0],["كَطُرَّة ِ الْبُرْدِ تُرْوَى الصَّادِيَاتُ بِهِ","مِنَ الأَجَارعِ لاَ مِلْحٌ وَلاَ نَزَعُ",22,"ع",1,0],["كطالب رِبْحٍ في سبيلٍ مخوفة ٍ","فأَوْرى بأصل المال والحرصُ قد يودى",23,"د",2,0],["كطاحونة نمضي ونأتي كمنحنى","يشد إلى رجليه تلاّ مجنّحا",24,"ح",2,0],["كَطارِدٍ إِبلَهُ وَالأَرضُ مُخصِبَةٌ","يَبغي سِباخاً يُرَجّي عِندَها العُشُبا",25,"ب",2,0],["كطابَعٍ من عنبرٍ حَطَّهُ","مُبَخِّرَ في وَسَط الجَمْرَه",26,"ر",2,0],["كطيرٍ تصبّاها ربيعُ بلادِنا","فأطربنا منها حنينُ سروب",27,"ب",1,0],["كطائرةٍ قد أُفلتتْ من حبالةٍ","فما سمعته أَو رأَته يروعها",28,"ع",3,0],["كطفلٍ أغضبته الأمُّ","إذْ منعته ثدييها",29,"ه",2,0],["كطواف به طواف الأملا","كِ حول العرش العظيم للإعظام",30,"م",1,0],["كَطَير كُلَما دَرَس ال","غَرام هَفا بِهِ فَننه",31,"ن",2,0],["كطي البُرد والأَتب","أَنخ بسعال واحتسب",32,"ب",1,0],["كطّيك في منتهىً واحد","لتُدرِكَ يثربَ أو مرقلا",33,"ل",2,0],["كطرر في غرر","أو طرز على حلل",34,"ل",1,0],["كَطيرٍ تَقَوَّى ثم طَار مُرَفرِفا","علَى الرَّوضِ في حِضنِ الطبيعَةِ شَادِيا",35,"ي",2,0],["كَطُرَيفَةَ بنِ العَبدِ كانَ هَدِيَّهُم","ضَربوا قَذالَةَ رَأسِهِ بِمُهَنَّدِ",36,"د",1,0],["كطائر يشكو اشتداد الصدى","في قفص جاور مجرى غديرْ",37,"ر",1,0],["كَطرفٍ مَؤوفٍ قَد يَرى غَيرَ كائِنٍ","وَما لَيسَ مَوجوداً لمَحضِ تَوهُّمِ",38,"م",1,0],["كَطِيبٍ فَاحَ أَشْذاءً","زُجاجةَ مِسْكِ عَطَّارِ",39,"ر",1,0],["كَطُوفَانِ نُوحٍ لاَ يُرَامُ لَهُ شَطُّ","وَهَبْتُ لَهُ رُوحِي وَأتْبَعْتُهَا الْبَدَنْ",40,"ن",1,0],["كطريحٍ في جوف رمس رحيبٍ","قد أحاطت به بوالي رفات",41,"ت",1,0],["كطيورٍ لم تجد ريّا لها","فبدا للعين منها مشربُ",42,"ب",1,0],["كطعم الزنجبيل لها مزاج","إذاما الماء مازجها امتزاجا",43,"ج",2,0],["كطير عاش في الأقفاص رغداً","فلا تذكر له روضاً وظلاّ",44,"ل",2,0],["كطعامِ الجِنانِ من غيرِ قَطْعٍ","لجميعِ الأنامِ فيه اكْتفاءُ",45,"ا",2,0],["كطلاوَةِ السَّيفِ المُهَنْ","نَدِ تَطْبِيَيْكَ كما تَهابُهْ",46,"ب",2,0],["كطيب بثوب لم تزل نكهاتهُ","وان صار ذاك الثوب رثاً وباليا",47,"ي",2,0],["كطائر ذي شجن صامت","أبعده المقدور عن وكره",48,"ر",2,0],["كطالب الماء قد حَفَّ العدوُّ به","يموتُ لهفاً وخوفَ المَوتِ لم يَرِدِ",49,"د",1,0],["كطائر مس غصن الرند جانحه","فغادر الغصن في رجفٍ وأجفال",50,"ل",1,0],["كطعنِ ذوي كفرٍ بما ليسَ ثابتاً","وإلا بما لا وضمَ فيهِ وقد عَمُوا",51,"م",3,0],["كَطَاوٍ بُطُونَ البِيدِ صَدَّتهُ عَنوَةً","سُيُولٌ غَثَت عَنها تَزُوغُ النَّواظِرُ",52,"ر",1,0],["كطب من طب الى من حبا","وليس طب عامر أو زيد",53,"د",1,0],["كَطائر الرَوض إِلّا أَنَّهُ أَبَداً","يَشدو هُنالك شَدو الحائر النائي",54,"ا",2,0],["كطودٍ ثوى من آل أزدٍ به احتمتْ","قبائِلُ شتَّى من نِزَارٍ وجُرْهُمِ",55,"م",1,0],["كطفلٍ يتيمٍ قضَتْ أمهُ","فيذوي اشتياقًا وبؤسًا يموت",56,"ت",1,0],["كطفلِ مَلَّ من ثَديٍ سقيمِ","فمال عن الرِّضاعِ إلى الفطامِ",57,"م",1,0],["كطاهر الأصل الفتى محمد","بالعلم نال يافعاً مراده",58,"د",2,0],["كطفل إذ يحاول أن يماري","يقاوم أن يُناط له اعترافُ",59,"ف",1,0],["كطيرِ خميلةٍ في الرّوضِ يلْهو","هديلُ رنيمِهِ في الرّوعِ هَمْسُ",60,"س",1,0],["كطامية التيار ينقض موجها","ولا يتعدى شوطه ساحل البحر",61,"ر",1,0],["كَطَيْرٍ ذَفِيِفٍ تَهَاوَى خَفِيِقِي","لِيَحْكِي بِأَرْضِي سِمَاتِ الْكَمَالِ",62,"ل",1,0],["كطفل غائر الأوجاع يبكي","ومن خوفي اتخذتُكَ لي أماني",63,"ن",2,0],["كطائر قد غفا رق النسيم له","حنت لدمعته في الغصن أوراقُ",64,"ق",1,0],["كطيفٍ زارني طفلاً يتيماً","إذا ما جاءَ آذنهُ انْصرافهْ",65,"ف",2,0],["كطائر غاب عنه السرب وهو لقى",