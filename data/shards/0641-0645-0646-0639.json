لوافر"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125800","الكامل"],[4042,"","https://poetry.dctabudhabi.ae/diwan/poem/69258","الطويل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127252","الوافر"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81941","المتقارب"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35414","الطويل"],[4496,"","https://poetry.dctabudhabi.ae/diwan/poem/77692","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120526","الطويل"],[4623,"","https://poetry.dctabudhabi.ae/diwan/poem/140152",""],[4691,"قبيلتي هيفاء !!","https://www.poetsgate.com/ViewPoem.aspx?id=59824",""],[4778,"إذا المرء لا يرعاك الا تكلّفا","https://www.poetsgate.com/ViewPoem.aspx?id=190721",""],[4784,"رعى الله صبا لا يزال مولعا","https://www.poetsgate.com/ViewPoem.aspx?id=170929",""],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[4578,"بسادس شعبان جنى اليمين أينما","https://www.poetsgate.com/ViewPoem.aspx?id=49469",""],[5065,"مكاشفة الغموض","https://www.poetsgate.com/ViewPoem.aspx?id=205181",""],[5092,"قبلةٌ ومن أوّل السطر","https://www.poetsgate.com/ViewPoem.aspx?id=163043",""],[5121,"أَنْفَاسْ","https://www.poetsgate.com/ViewPoem.aspx?id=33584",""],[5121,"الْمِنْهَاجُ","https://www.poetsgate.com/ViewPoem.aspx?id=34716",""],[5136,"يا راقد الليل لم تشعر لمن سهرا","https://www.poetsgate.com/ViewPoem.aspx?id=121584",""],[5320,"العامل","https://www.poetsgate.com/ViewPoem.aspx?id=40903",""],[1021,"تبدى يملأ الناظر","https://www.poetsgate.com/ViewPoem.aspx?id=47834",""],[592,"تبصر نور الحق من كان يبصر","https://www.poetsgate.com/ViewPoem.aspx?id=128795",""],[5376,"تُهانُُ القدسُ ما فيكم مروءةْ","https://www.poetsgate.com/ViewPoem.aspx?id=203293",""],[5410,"خفقة في بداية المطاف","https://www.poetsgate.com/ViewPoem.aspx?id=154943",""],[5431,"سأترك مهجتي في اليم طوعا...","https://www.poetsgate.com/ViewPoem.aspx?id=191602",""],[5550,"أريد","https://www.poetsgate.com/ViewPoem.aspx?id=215569",""],[5717,"لم تحي بامرء في سمع وفي بصر","https://www.poetsgate.com/ViewPoem.aspx?id=170587",""],[5736,"صباحي أنت","https://www.poetsgate.com/ViewPoem.aspx?id=203894",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5830,"سَلِي العُرُوبَةَ","https://www.poetsgate.com/ViewPoem.aspx?id=200822",""],[5970,"حلت لي عزلتي وحلا مقامي","https://www.poetsgate.com/ViewPoem.aspx?id=130615",""],[6093,"طَعْمُ الأنَا","https://www.poetsgate.com/ViewPoem.aspx?id=205586",""],[6124,"همس الحب","https://www.poetsgate.com/ViewPoem.aspx?id=128748",""],[6125,"فمن عينيكِ ألتمسُ المعاني","https://www.poetsgate.com/ViewPoem.aspx?id=210908",""],[6125,"أحلِّقُ في الدُّجى وحدي","https://www.poetsgate.com/ViewPoem.aspx?id=212879",""]],"verses":[["فَمَن عَرَفَ العَيشَ خَبَّت بِهِ","عَزائِمُهُ في طَريقِ الحِمامِ",0,"م",1,0],["فَمَن عَرَفَ الدَهرَ الخَؤونَ وَصَرفَهُ","تَصَبَّرَ لِلبَلوى وَلَم يُظهِرِ الشَكوى",1,"و",2,0],["فَمِنْ عالَمِ الأشْباحِ ليْلِي وظُلْمَتي","ومِنْ عالَمِ الأرْواحِ نُوري وإشْراقِي",2,"ي",1,0],["فمِنْ عالَمِ الأسْرارِ ذاتُكَ تجْتَلي","ملامِحَ نورٍ لاحَ للطّوْرِ فانْهَدّا",3,"د",2,0],["فمِنْ عِقَبٍ مَنْ ضَلّ في شِعْبِها هَوَى","ومِنْ درَجٍ مَنْ زَلّ في ضَنْكِها دَرَجْ",4,"ج",1,0],["فَمِن عارِفٍ لَم يَنتَفِع وَمُعانِدٍ","يَميلُ مَعَ الأَهواءِ وَالشَهَواتِ",5,"ت",1,0],["فمنعة صدق للخلافة قد ضَفَتْ","على من حواه من مهابته حُجْبُ",6,"ب",1,0],["فَمَن عاذِري مِن عَبدِ عُذرَةَ بَعدَما","هَوى في دَجوجِيٍّ مِنَ البَحرِ خافِقِ",7,"ق",1,0],["فمنَعتني منكَ الجَدا","وسرقتني طِيب الثناءِ",8,"ا",2,0],["فمنعْتَ نفسَكَ دَرَّها","ومَرَيْتها للحالبينا",9,"ن",2,0],["فَمَنَّ عَلَيهِم بِالأَمانِ تَكَرُّماً","عَلى الرَغمِ مِن بيضِ الصَوارِمِ وَالسُمرِ",10,"ر",1,0],["فمن عون اللغات على ملم","أصاب فصيحها والأعجميا",11,"ي",2,0],["فَمَن عَرَفوا بَراءَتَهُ فَإِنّي","ظَنينُ الجَهرِ مُتَّهَمُ المَغيبِ",12,"ب",1,0],["فَمِن عِندِكَ القَولُ مُستَأنِفاً","لِتَقتَبِلَ الفِعلَ مِن عِندِهِ",13,"د",2,0],["فمَنْ عادَ بالكَيدِ الخفيِّ فإنَّه","يعودُ بيأسٍ في الكريهةِ بَادِي",14,"د",2,0],["فمن عَياءٍ إِلى كلالٍ","ومن كلالٍ إِلى عياء",15,"ا",2,0],["فمن عزْمنا هنديّةُ الضّرْبِ تُنتَضى","ومن زَنْدنا ناريّةُ البأس تُقْبَسُ",16,"س",1,0],["فمن عذيري مِنْ هوى ظبيةٍ","قدْ عشقتْها الإنسُ والجنُّ",17,"ن",1,0],["فمن عُذَيْري في هوى ظبيةٍ","قَدْ عَشِقَتْها الجنُّ والإنسُ",18,"س",1,0],["فَمِن عارِضٍ يَسقي وَمِن سَقفِ مَجلِسٍ","يُغَنّي وَمِن بَيتٍ يَميلُ مِنَ السُكرِ",19,"ر",1,0],["فَمَنَعتُهُ جَمَّ المَحاسِنِ ناقِهاً","قَد كاثَرَ الأَمداحَ وَهوَ قَليلُ",20,"ل",1,0],["فَمَن عَصى داعِيَ الهَوى فَقَسا","وَكانَ جِلداً مِنَ الصَفا خَشِنا",21,"ن",2,0],["فمن عائذ بالبرق يسترجع الهوى","ومن لائذ بالريح يستدفع الصدا",22,"د",2,0],["فَمِن عَدا الخَمرَ إِلى غَيرِها","عاشَ طَليحاً عَينَ مَحرومِ",23,"م",1,0],["فَمَن عاتَبَ الجُهّالَ أَتعَبَ نَفسَهُ","وَمَن لامَ مَن لا يَعرِفُ اللَومَ أَفسَدا",24,"د",2,0],["فَمَن عَهِدتُ بِهِ الأُلّافَ تَسكُنُهُ","فَالعَرجُ حَيثُ تَلاقى القاعُ وَالعُقَدُ",25,"د",1,0],["فَمِن عَثَراتِ المَرءِ في الرَأي أَنَّهُ","إِذا ما جَرى ذِكرُ الخِضابِ تَشَوَّرا",26,"ر",2,0],["فَمَن عاداكَ في ذُلٍّ شَديدٍ","وَمَن والاكَ في عِزٍّ مُبينِ",27,"ن",1,0],["فَمَنَعْتُمُوهُ أَو قُتِلْتُمْ حَوْلَهُ","مُتَلَبّبينَ البِيضَ والأبْدَانَا",28,"ن",2,0],["فَمَن عابَ هَوى فَوزٍ","وَعَبّاسٍ فَقَد خابا",29,"ب",2,0],["فمن عجب أن يُمْنَحَ الرزقَ وادعٌ","ويُمْنَعَهُ ثَبْتُ الجَنانِ مُغامر",30,"ر",1,0],["فمِنْ عناءِ بَلَّياتٍ نُهكتُ بها","إلى عناء . ومن داءٍ إلى داء",31,"ا",2,0],["فَمِنْ عِندِكَ القَوْلَ مُسْتأنَفاً","لنَقْتَبِلَ الفِعْلَ مِنْ عِنْدِهِ",32,"د",2,0],["فَمِن عَجيبَ الأَشياءِ أَن يُصبِحَ ال","مُلكُ شَعاعاً وَيُحرَزَ اللَقَبُ",33,"ب",1,0],["فَمَنَعتَ حَتّى لَم تَجِد مُستَبدِلاً","وَغَفَرتَ حَتّى لَم تَدَع مُستَغفِرا",34,"ر",2,0],["فَمِن عُصَبٍ عَصَبَتها الحُروبُ","وَمِن ثُلَلٍ قَد مَحاها الثَلَل",35,"ل",1,0],["فَمَنَعتَها مَن كانَ مَشرَبُها بِهِ","كَدِراً وَمَرتَعُها لَدَيهِ وَخيما",36,"م",2,0],["فمن عاش منهم عاش فيما يسوءه","ومن لم يعش يهلك وفي قلبه أشيا",37,"ي",2,0],["فمَن عاذِري مِن غائبٍ وخيالُه","إذا خاطَ جفني النومُ أو غابَ آيبُ",38,"ب",1,0],["فَمن عيصِ إِبراهيمَ تُنمي فُروعُها","وَمِن بَحرِ عَبدِ اللَّهِ يَجري عبابُها",39,"ب",3,0],["فَمِن عَبرَةٍ سالَت بِنَحري وَزَفرةٍ","بِها رُحتُ مِن بَعد الوَداعِ مشيّعا",40,"ع",2,0],["فمَنْ عاش أَحْياهُ نَداهُ ومن يَمُتْ","على حبه طَوْعا فمسكنُه الخُلْد",41,"د",1,0],["فمَن عاش منهم بالفرارِ فإنما","حُسامُك موتٌ فوقَه حيثُما يَغْدو",41,"د",2,0],["فمن عضّه دهرٌ ولم يكن واجدا","سبيلا إلى صبر يعضّ على الدهر",42,"ر",1,0],["فَمِن عامِرٍ رَدّهُ غامِراً","وَمَن مُعلمٍ عادَ كَالمَجَهلِ",43,"ل",1,0],["فمن عيونٍ تبيتُ عبْرى","ومن عيونٍ تبيتُ سَكْرى",44,"ر",2,0],["فمن عينك النجلاء كانت بليتي","فويلاه من غنجٍ بها وفتورِ",45,"ر",1,0],["فمن عينك الكحلاء كانت بليَّتي","فويلاه من غنجٍ بها وفتورِ",46,"ر",1,0],["فمن عينيك يستوحى لظاه","ليبلغ دارة السحر المبين",47,"ن",1,0],["فمن عدلِه لم يفترقْ شملُ جامعٍ","ومن جودِه لم يجتمعْ شملُ مالِهِ",48,"ل",2,0],["فمن عذِيريَ من دَمْ","عِ مقلتي مَن عذيري",49,"ر",2,0],["فمِن عُلاك مَعاليَّ التي شَرُفَت","ومن أياديك ما أحوِى من النَّشَب",50,"ب",1,0],["فَمِنْ عَجَبٍ تُحَاجَنِي فِي عَرُوضٍ","وَتَخْتَرِمُ الْقَرِيضَ فَمَا النَّجَاةُ",51,"ه",1,0],["فمن عاش في قيد الدنا مات مكمداً","ومن صح في هذي الجبلة يسقم",52,"م",1,0],["فمن عينٍ كراهبةٍ تصلّي","وثغرٍ مُسلِمِ يأبى الفُطورا",53,"ر",2,0],["فَمِن عَزَماتِهِ سَترى وَشيكاً","دُنُوَّ حُتوفِها الكُرجُ اللِئامُ",54,"م",1,0],["فَمن عَينَيَّ جارِيَةٌ عُيونٌ","وَلي قَلبٌ بِنارِ الهَجرِ صالي",55,"ل",2,0],["فَمَنَّ عَلَيكَ أَنَّ الجِلْدَ وارى","غَثِيثَتَها وَإِحرامُ الطَّعامِ",56,"م",1,0],["فمن علمه إن صح صحت لك ال","حقيقة من إيمانك العلمية",57,"ه",1,0],["فَمَن عَلِمَ الأشياءَ وفّى حُقوقَها","وَدانَ لَه فيما يحاولُ خصمهُ",58,"م",2,0],["فمَن عمرك اللَه أدنى إليه","أمن غرسَ الغرس أم من جناه",59,"ه",1,0],["فَمَنَعَ النَومَ وَمَنّانا المُنى","فَقُلتُ أَهلاً بِالخَيالِ إِذ سَرى",60,"ا",1,0],["فَمَنَعتَ حَوزَتَهُ وَكُنتَ وِقاءَهُ","مِن وَقعِ كُلِّ مُهَنَّدٍ وَسِنانِ",61,"ن",1,0],["فمن عزماتي للهموم معاذر","ومن كلماتي للنجوم ضرائر",62,"ر",1,0],["فمن عُقْرِ دارٍ غيرِ محميَّةِ الحِمى","ومَصْرَعِ قِرْنٍ غيرِ منتعِش الصَّرْعِ",63,"ع",1,0],["فمن عضد الدين استفاد بنو العُلى","مساعِيَهُمْ حتى أتوا كلَّ مَحْمد",64,"د",1,0],["فمِنْ عضدُ الدين النَّوالُ لُممْلقٍ","وإِنْ جارَ خطب فالوفاءُ لصاحب",65,"ب",1,0],["فمُنَّ عليّ يا ربّ بجسمٍ","فأخطئُ ثم أرجع إن علمتُ",66,"ت",1,0],["فمن عثرت به قدم فإني","بمصر قد عثرت على المراد",67,"د",1,0],["فمن عاملٍ ما له خِبرةٌ","وآخرَ يدري ولا يعملُ",68,"ل",1,0],["فَمن عَنّا يُبلِّغُكمْ خطوباً","إذا ذُكِرتْ يَصَمُّ لها المُناجى",69,"ج",2,0],["فمِنْ عذْبِ أزوادِ النّزاهةِ مطعمِي","ومن ماءِ أحواض العَفاف شرابي",70,"ب",2,0],["فَمَن عَلى صَبوَتي يُساعِدُني","إِذا جَفاني الحَبيبُ وَالسَكَنُ",71,"ن",1,0],["فمن عوّادةٍ تَشْدو وأخرى","بِمَعْزَفَةٍ وأخرى بالرّبابِ",72,"ب",1,0],["فَمن عاشَ من آل النبي كلالَةً","وماتَ ولم يُعقب فأنتَ لَهُ عَقبُ",73,"ب",1,0],["فَمن عَذيري ولستُ لاقٍ","مِنهم ولا فيهمُ عذيرا",74,"ر",2,0],["فمنَّع بالحديدِ لهُ رتاجاً","حباهُ النُورَ شوقيٌ كليم",75,"م",1,0],["فمنعفر خد وصدرُ مرضضٌ","وَمختضب نحرٌ وجسم مبضع",76,"ع",1,0],["فمن عندها إسحاقُ في طيب نغمةٍ","أو ابن سريج والغريضُ ومعبدُ",77,"د",1,0],["فمن عدّ من الأقوا","م رهطاً عدَّنا رهطه",78,"ط",2,0],["فمنع فضول المال بخل ومنعه","مع الحرص للعافين شُحٌّ يوافقه",79,"ق",2,0],["فمنَّ عليَّ بالغفران واختم","على عملي بتزكية وقدسِ",80,"س",1,0],["فمن عذيري من خل يقربني","إلى التكاسي ويقصيني عن الكاس",81,"س",1,0],["فَمِنْ عَسْجَدِ الإشْرَاقِ دُبِّجَ ثَوْبُهَا","وَمِنْ خَزّ دِيبَاجِ الرَّبِيعِ لَهَا مَرْطُ",82,"ط",1,0],["فَمِن عَذيرَ الصَبِّ مِن صَدِّهِ","وَمَن يُجيرُ القَلبَ مِن هَجرِهِ",83,"ر",2,0],["فَمَنْ عَاشَ مِنْكُمْ عَاشَ عَبْداً ومنْ يَمُتْ","فَفِي النَّارِ سُقْياهُ هناك وَصَدِيدُهَا",84,"د",3,0],["فمن عرف المقصود منها اقامه","بشاهد ذوق حير العقل والفكر",85,"ر",1,0],["فمن عرف المعنى بشاهد ذوقه","اقام على التقوى بقلب منور",86,"ر",1,0],["فمنعه لدى سعيد قد ظهر","لكنه عند الخليل معتبر",87,"ر",1,0],["فَمَنْ عَاذِرِي مِنْ حِيرَتِي وَتَوَلُّهِي","إِذَا سَفِرَتْ مِنْهَا المَحَاسِنُ لِلسَّفْرِ",88,"ر",1,0],["فمنعت حوزَتها وصنتَ حريمها","وحميتَ بيضتها وحِطتَ سِجافَها",89,"ف",3,0],["فمن عناه فقد عناه","ومن رآه فقد رآه",90,"ا",2,0],["فمن عقّ منّا أصله عقّ دي