.com/ViewPoem.aspx?id=213085",""],[5989,"خلي فؤادي ...","https://www.poetsgate.com/ViewPoem.aspx?id=181564",""],[6093,"عودي","https://www.poetsgate.com/ViewPoem.aspx?id=202606",""],[6142,"يا نبي الهدى وأفضل خلق الل","https://www.poetsgate.com/ViewPoem.aspx?id=155703",""],[6213,"كل الهوان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76310&r=&rc=58",""],[6213,"المجْدُ الجَدُّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76314&r=&rc=62",""],[5957,"رفقا بها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82586&r=&rc=128",""],[6230,"العقاب ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67168&r=&rc=42",""],[119,"يا نبيا علا على الأنبياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55610&r=&rc=7",""]],"verses":[["يا نبعة الفضل مذ فاز التراب بها","لم تَسر من حجُب إلا إلى حُجب",0,"ب",1,0],["يا نبيَّ الله في الشع","رِ ويا عيسى بن مريمْ",1,"م",1,1],["يا نَبَأَ سُرَّ بِهِ مَسمَعي","حَتّى تَمَنّى أَنَّهُ الناقِلُ",2,"ل",1,1],["يا نبتةَ البلوى ويا","ورداً ترعرعَ في ﭐهتضامِ",3,"م",1,0],["يا نبيَّ الهُدَى اسْتِغَاثَةَ مَلْهو","فٍ أَضَرَّتْ بحالِه الحوْبَاءُ",4,"ا",2,0],["يا نَبيلاً فَجِعَت فيهِ فهرٌ","وَلِفهرٍ أسوَةٌ في النَبِيِّ",5,"ي",1,0],["يا نبعةً عولجتْ دهراً فما انحطَمَتْ","ما كنتَ لولا يدُ الاقدار تَنحطِم",6,"م",1,0],["يا نَبتة الله في عَليا مَظاهرِه","آمنتُ بالله لم لم يُولَد ولم يَلِد",7,"د",1,0],["يا نبتةَ البلوى ويا","ورداً ترعرعَ في اهتضامِ",8,"م",1,0],["يا نبي الوجود بالجود أدرك","عبدك الملتجى الضعيف المعنى",9,"ن",2,1],["يا نبياً على الأنبياء","بمقام التعظيم والاصطفاء",10,"ا",2,1],["يا نَبيّاً لَدى الإلهِ عَظيما","وَحَبيباً لهُ وعَبداً كريما",11,"م",2,1],["يا نَبِيَّ الهُدى إِلَيكَ لَجا حَي","يُ قُرَيشٍ وَلاتَ حينَ لَجاءِ",12,"ا",2,1],["يا نبي الجمال أصبح دمعي","مرسلاً في هواك بالبيِّنات",13,"ت",1,0],["يا نبي الهدى أغث مستجيراً","بك في الخطب دائم الألظاظ",14,"ظ",1,0],["يا نبي الهدى عليك سلام","يبقى غضاً على الأناء",15,"ا",2,0],["يا نَبِيَّ الرِضا أَلَم يُرضِكَ الحق","قُ بِنَصِّ الرِضا لَعَلَّكَ تَرضى",16,"ض",2,0],["يا نَبِيّاً بُعِثتَ لِلخَلقِ رَحمَهْ","وَلَهُ أُمةٌ بِهِ خَيرُ أُمَّهْ",17,"م",2,1],["يا نَبِيّاً عَلَيكَ مَولاكَ صَلّى","وَأُمِرنا أَنّا نُصَلّي عَلَيكا",18,"ك",2,1],["يا نَبِيّاً قَد كُنتَ أَوَّلَ نورٍ","شاهَدَ النورَ في الحِمى الغَيبِيِّ",19,"ي",1,0],["يا نَبِيّ اللَهِ مالي حيلَة","غَير حبي لَكَ يا خَير نَبي",20,"ب",2,0],["يا نبع إلهامي المنوّر دائما","ماذا سكبت بها غنى ومعانيا",21,"ي",2,0],["يا نَبيها وَعاقِلاً وَذَكيّا","وَنَجيباً وَكامِلاً وَعَليا",22,"ي",2,1],["يا نُباحَ الكلبِ أنتَ المُشْتَهى","دون ما يأتي به المُسْتَعْذبُ",23,"ب",1,0],["يا نبوة الايام او يا جفوة الأح","باب قد اعجمتما لي عودي",24,"د",2,0],["يا نُبْلَها من بركةٍ لم تعدُ بل","لم يَعْدُها في النُّبْلِ بحرٌ مُتْرَع",25,"ع",1,0],["يا نبيّاً فدتْكَ أنفسُنا معْ","أهلنا والأموال والأولاد",26,"د",1,0],["يا نبياً جاء يرشدنا","للهدى إذ أوضح السبلا",27,"ل",2,0],["يا نبأ مروعاً مبهما","أعيت أساريرك وجداني",28,"ن",2,0],["يا نبعة المجد بل يا روضة قطفت","كانَت حَياتي بها مَنشورة العبق",29,"ق",1,0],["يا نبي الهدى إليك استنادي","فاز عبد القى إليك قياده",30,"د",2,0],["يا نبي ألفٍ وحاميمٍ ودال لا يزال","نجل كمونة فيكم بجلاد وجدال",31,"ل",1,0],["يا نبي الهدى عليك صلاة","وسلام قد يستزيد الكمالا",32,"ل",2,0],["يا نبي الإله يا أفصح العر","ب وأدراهم بنطق الضاد",33,"د",1,0],["يا نبيونَ تلك جَنَّاتُ عدنٍ","فادخلوها وكبرى يا سماء",34,"ا",2,0],["يا نبأة وَلَجَت عليَّ مسامِعي","رُفِعَ الحَجابُ وإذنُهُ فَتَسوَّري",35,"ر",2,0],["يا نبيّ الهدى وخير البرايا","من حباه الآله بالاسراء",36,"ا",2,0],["يَا نَبيَّ الجَمالِ في أُمَّةٍ العُشَّ","اقِ لا تَجعَلِ المَلالَةَ مِلَّه",37,"ل",2,0],["يا نبيَّ الهدى وخَيْرَ كريمٍ","باسطاً كفَّهُ لبذلِ النَّوَال",38,"ل",1,0],["يا نبع مرسركيس الف سلام","مني اليك وصبوتي وهيامي",39,"م",2,1],["يا نبع مرسر كيس ماؤك كوثر","وهو الدواء لمعضل الاسقام",39,"م",1,0],["يا نَبيَّ الأَنبِياءِ","يا صَفِيَّ الأَصفِياءِ",40,"ا",2,1],["يا نبياً لم يلق في الكون أمه","عجز الدهرأن يجاريك همه",41,"م",2,1],["يا نبياً بفنه وعلاه","لا ترم أمة فانك أمه",41,"م",2,0],["يا نبيا سعت إليه المطايا","في وهاد مألوفة ونشوز",42,"ز",1,1],["يا نبيها ذكره جاب البلاد","عاطرا كالزهر في أكمامه",43,"ه",1,0],["يا نبت عقبة يا بذور يمينه","من منكم الرجل الكريم المنجد",44,"د",1,0],["يا نَبي اللَه أَنتَ الرَجا","مِن شَقا يَبقى وَعمر يبيدْ",45,"د",1,0],["يا نبي الهُدى وَأَنتَ سَميع","جل داءُ العَنا وَعز الدَواء",46,"ا",2,0],["يا نبي الهُدى أَقلْها عثاراً","لَم يُقِلني من حملها الإعياء",46,"ا",2,0],["يا نَبي الهُدى عَليك سَلام","لا اِبتِداء لَهُ وَلا إنتِهاء",46,"ا",2,0],["يا نبيِّي العزيز أنت نبيٌّ","غلبته وساوس الشيطان",47,"ن",1,1],["يا نبيِّي، فاشرح لنا أنت ما قد","كان لا ما يكون في الإمكان",47,"ن",1,0],["يَا نَبِيَّ الهُدَى تَشَفَّع لِعَاصٍ","جَاهِلٍ حَيثُ تَذهَلُ الرُّضَعَاءُ",48,"ا",2,0],["يا نبيا به الكمال استتما","ورسولا بفضله الكون عما",49,"م",2,1],["يا نبي الهدى وما الأنبياء","منك إلا أرض وأنت سماء",50,"ا",2,1],["يا نبعة البان لم تجن نضارتها","للعاشقين سوى الأشجان من ثمر",51,"ر",1,0],["يا نَبِيَّ الهُدى تَدارك عُبيداً","قَيَّدوا منهُ مطلَقَ الحُرِيَّه",52,"ي",2,1],["يا نَبِيَّ الهُدى تدارك ضَعيفاً","كلّ ضَعفٍ من قبل وَقع المَنِيَّه",52,"ي",2,0],["يا نَبِيَّ الهدى تَدارَك عَزيزاً","ذَلَّ وَالعُرب ذلَّة عِبريّه",52,"ي",2,0],["يا نَبِيّ الهُدى أَفَتحٌ مُبينٌ","باِفتِتاح الأعجام قَطر الشامِ",53,"م",1,0],["يا نَبيّ الهُدى أَجب فيكَ صبّاً","مُغرَماً في هواك أَيّ غرامِ",53,"م",1,0],["يا نَبِيَّ الهُدى هرقلُ تصدّى ال","يومَ لِلتُركِ راغِباً في القِتالِ",54,"ل",1,0],["يا نَبيّ الهدى اِهدِنا في دِياجٍ","ضَلَّ فيها الأَقوامُ كلَّ ضَلالِ",54,"ل",1,0],["يا نَبِيَّ الهُدى وَأَشرَفَ خلق ال","لهِ يا مرتجىً بحشرٍ وَنشرِ",55,"ر",1,0],["يا نَبيَّ الهُدى نَصحتُ لِقَومي","كُلَّ نُصحٍ وَشاهدي أَوراقي",56,"ق",2,1],["يا نَبيّ الهدى تحيَّرتُ في ما","نَحنُ فيه فَلِلسوى لا تَكِلنا",57,"ن",2,0],["يا نَبيّ الهُدى وَأَكرَمَ خَلقِ ال","لهِ منكَ الهدى وَمِنكَ الرُشدُ",58,"د",1,0],["يا نَبِيَّ الهُدى اِهدني في شُؤون","حرتُ فيها وَاِنظُر لِعَبدٍ حارا",59,"ر",2,0],["يا نَبِيَّ الهُدى شَفيعَ البَرايا","وَمقامُ الشَفيعِ ذاكَ المقامُ",60,"م",1,0],["يا نبيَّ الإلاه دعوةَ راجٍ","مِن ضنا ذنبِه وفيَّ الشفاء",61,"ا",2,0],["يا نبيذا في دمي خبأتهُ","واحتستهُ مهجتي لم تظهر ِ",62,"ر",1,0],["يا نبتة الريحان إني عاشق","والعشق من فرط القطيعة نار",63,"ر",1,0],["يا نبتة الريحان أي عبارة","تجدي فأرسلها لقلبك تطرب",64,"ب",1,0],["يا نبتة الريحان يا قمر الدجى","بل يا شعاع الشمس في الإشراق",65,"ق",1,0],["يا نبيَّ الفُصُولِ قُل أيَّ شَيءٍ","نَغَّصَ البَثُّ عَيشَنَا والمُذِيعُ",66,"ع",1,0],["يا نبيَّ الفُصُولِ.. فَلْيَفصِلُونا","سَوفَ يَلقَاكَ بالجَمِيعِ الجَمِيعُ",66,"ع",1,0],["يانبضَ كلّ جَمالٍ صاغَهُ قلمي","ولحنَ قافيةٍ بالحُسنِ عَصماءُ",67,"ا",2,0],["يا نبتة جحدت ندى رحمي وحين","... ترعرعت قد أذَّنت بغروبي",68,"ب",2,0],["يا نبضةً بالجراح مثخنةً","لمهجةٍ قد كبا بها الجسدُ",69,"د",1,0],["يانبض قلبه ويادمٍ في عرقه","لحظة يشوفك يعزز للصمودي",70,"د",2,0],["يا نبياً مُبارَكاً","لانتشالِ الورى أتىٰ",71,"ت",2,0],["يَا نَبِيَّ اللهِ فَافْرَحْ","إِنَّ بَعْدَ الْعُسْرِ يُسْرَا",72,"ر",2,0],["يَا نَبْعَةَ الطِّيبِ وَنشرَ الفضا","قَد زانَكِ عِطْرًا شَذا الْمُصْطَفَى",73,"ف",2,0],["يا نبأة قد سرت من جلق فسرى","بها من الحزن ما لا يحمل الفيل",74,"ل",1,0],["يا نبأة أقحمت كالنار لا بردى","ببرده مطفئ منها ولا النيل",74,"ل",1,0],["يا نبعَ الوادي لي أملٌ","في حضنِكَ، أودِعُ ذِكراهُ",75,"ا",2,0],["يا نَبعِ الوفَه يالشاطِئَك يِعْلَمْ","فايض بالكَرَم وامْنِ العِلِمْ زَمْزَمْ",76,"م",1,1],["يا نبعة الحسب الوضاح قصفها","ربب الزمان فأبدى الحادث الجللا",77,"ل",2,0],["يانبضة الشعر يا بيتاً مطالعه","تعانق الشمسَ من آفاق مسراكِ",78,"ك",1,0],["يا نبضةً في القلب تدفقُ حبّها","شوقا تهيجُ وقيدَه الأخبارُ",79,"ر",1,0],["يا نبيُّ اللهِ يا نورُ السما","هاجني الشوقُ بقلبي فنما",80,"م",2,1],["يا نبيَّ اللهِ مشتاقٌ أنا","أن أرى الوجْهَ الصبوحَ المُبْسِما",81,"م",2,0],["يا نبيَّ اللهِ هذا حالُنا","ما لصمْتٍ في سكونٍ من صدى",82,"د",2,0],["يا نبع حبي أنا الضمآن منهزم","وجهي إليك وفي واديك أعتقدُ",83,"د",1,0],["يانبيّ الضلال هيّا اغثني","معبدي طاهرَ الربوع نديّ",84,"ي",1,0],["يانبي الهوى سكارى القوافي","هات فاسكب فأنت أنت المدامُ",85,"م",1,0],["يانبضنا اللي كم هدى ب أسمه الروع","ادربنا اللي نهتديه وندله",86,"ل",2,0],["يانبض أيامي الجميلة كلها","أنت الحياة وأنت عمري الأكبرُ",87,"ر",1,0],["يا نبضُ كم شمعةٍ في ليلنا انطفأتْ","وأنتَ أطفأتَ فيها العمرَ مُختطفا",88,"ف",2,0],["يا نبضُ كم لِمَّةٍ بيضاءَ مؤمنةٍ","إلى الردى سُقتها كي يرتضي الحُلَفا",88,"ف",2,0],["يا نبضُ كم دمعةٍ للأمِّ تسكبها","عند الغروب لذكرى من لها اختُطِفا",88,"ف",2,0],["يا نبضُ من دمنا المسكوب قد رضعتْ","أفواهنا ومن الدمع الذي ذُرِفا",88,"ف",2,0],["يا نبضَ روحي ووجداني ومعتقدي","رفقاً فعندي من افيائكِ الرّطبُ",89,"ب",1,0],["يا نبضةَ الحُبِّ في قلبي ، وذاكرتي","هل عِشتُ حُبًّا يُذيبُ القلبَ لولاكِ ؟",90,"ك",1,0],["يَا نَبْعنَا الصَّافِيَ الْمَشْمولَ تَكْرِمَةً","يَا رَمْزَنَا الْخَالِدَ الْمَحْمُودَ إِنْسَانَا",91,"ن",2,0],["يا نبضة في الصدر أوجعك الردى","واختار من بين الحمائم طائره",92,"ر",2,0],["يا نبضة في الصدر أوجعها الردى","واختار من بين الحمام الباهره",93,"ر",2,0],["يا نبضة القلب يا سر الحياة وَيَا","أيقونة الحب .. في الأعماق سكناكِ",94,"ك",1,0],["يا نبض عشقي بين ذاتي وذاتك","روحين عاشت بالمشاعر تناديك",95,"ك",1,0],["يا نبيا أنباؤه أنبا الله","بها الأنبياء والأولياء",96,"ا",2,0],["يا نبيا أسرى به الله في","أوج كمال به يسامي السماء",96,"ا",2,0],["يا نَبْضَهُ منْ فُؤَادٍ حُقَّ شاغِلُهُ","ذاكَ المُوَشَّى بِشَهْدِ النَّحْلِ يَرْتَسِمُ",97,"م",1,0],["يانبض القلب ومهجته","ونجيع الفكر يغذيني",98,"ن",2,0],["يَا نَبْضَ شِعْرِي يَا جَنَاحَ قَصِيدَتِي","مَا السِّرُّ كَيْفَ الخِلُّ صَارَ بَعِيدَا",99,"د",2,0],["يا نبضَ القلبِ ألا تجدُ","دربًا للوصلِ كمن وجدوا؟",100,"د",3,1],["يانبضَ قلبي ..يابهاءَ كرامتي","ياعزَّ شعبي ماابتغيتُ سواكِ",101,"ك",1,0],["يا نبضةً في القلب حطت وهجها","فكتبت فيك روائِعَ الأشعارِ",102,"ر",1,0],["يا نبض قلبي معلنا ً","سرّا ً من العين فشى",103,"ا",1,0],["يا نبض قلبي ويا أسباب بهجته","على مرافئكم ناخت مطايانا",104,"ن",2,0],["يانبضةً في حنايا القلب ما فتئت","تروي لنا الحب في أيام لقياه",105,"ا",2,0],["يا نبتةَ الألق المغروس في طيني","نامي بقلبي وذوبي في شراييني",106,"ن",2,1],["يا نبضَ يومي أنت لغزُ خريطتي","وأراك في يوم الرحيلِ وَصِيَّتي",107,"ت",2,0],["يا نبي الهدى وأفضل خلق الل","هِ في طارف العلى والتليد",108,"د",1,1],["يا نبأة المجد، تحت الترب ساحتنا","أين العطاء وأين الكبر يمتثل",109,"ل",1,0],["يا نبأة بين البرايا حرّكي عظم اللحودْ","يا صرح ماضينا علامك في شرود أو صدودْ",110,"د",1,0],["يا نبضها الجاري بكم شغفا","والناي في تهيامها طربُ",111,"ب",1,0],["يا نَبْعَةَ النُّورِ في الوجْدانِ يا بصري","يا مَنْ سأبقى إليكِ العُمْرَ مُنْصَرِفَا",112,"ف",2,0],["يا نبيا علا على الأنبياء","بمقام التعظيم والاصطفاء",113,"ا",2,1]]}