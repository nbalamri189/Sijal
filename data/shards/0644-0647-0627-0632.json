{"poems":[[32,"دنا البين من مي فردت جمالها","https://www.aldiwan.net/poem29539.html","الطويل"],[54,"يا دار يا دار أطرابي وأشجاني","https://www.aldiwan.net/poem26663.html","البسيط"],[50,"وميرائية تمشي اختيالا","https://www.aldiwan.net/poem66544.html","الوافر"],[124,"بنات الدجى هذا الذي لم يزل له","https://www.aldiwan.net/poem49321.html","الطويل"],[266,"أظن الصبا جابت إليك المسالكا","https://www.aldiwan.net/poem38220.html","الطويل"],[305,"ألم ترم الأطلال من حول جعشم","https://www.aldiwan.net/poem45455.html","الطويل"],[563,"شهدت القديم الحق بالحادث الفاني","https://www.aldiwan.net/poem33708.html","الطويل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126910","المجتث"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55908","المجتث"],[1849,"","https://poetry.dctabudhabi.ae/diwan/poem/77679","الطويل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106852","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93732","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85244","البسيط"],[4722,"وأن نفخة اسرافيل ثانية","https://www.poetsgate.com/ViewPoem.aspx?id=26474",""],[5186,"يا طيب ليل بالأنس مرا","https://www.poetsgate.com/ViewPoem.aspx?id=156570",""],[5816,"( العبيرية ) في وصف الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=125964",""]],"verses":[["لَهُ أَزمَلٌ عِندَ القِذافِ كَأَنَّهُ","نَحيبُ الثَكالى تارَةً وَاِعتِوالُها",0,"ل",3,0],["لَها زِمامٌ إِذا أَبصَرتُ جَولَتَهُ","حَسِبتُ في قَبضَتي أَثناءَ ثُعبانِ",1,"ن",1,0],["لها زيّ الغلام ولم أقسها","إليهِ ولا كرامةَ للغلام",2,"م",1,0],["لها زأرة الآساد إن هي أقبلت","وخشخشة الأشجار عند الهزائم",3,"م",1,0],["لها زهر غض نضير لناظر","وان لمسته راحة كان شائكا",4,"ك",2,0],["لَها زَجَلٌ جُنحَ الظَلامِ كَأَنَّهُ","عَجارِفُ غَيثٍ رائِحٍ مُتَهَزِّمِ",5,"م",1,0],["له أزل الأزال في كل رتبة","له أبد الآباد من غير أزمان",6,"ن",1,0],["له أزفّ التهاني","في العيد مِن حسن نيّة",7,"ي",2,0],["لها زهير هزارٌ","يشدو بها مستميلا",8,"ل",2,0],["لَها زَجَلٌ مِن رَعدِها وَلَوامع","مِن البَرق عَنها للعُيون كُلولُ",9,"ل",1,0],["لها زرقةُ الماءِ الذي فيك سرُّه","وفيها من السحر العجيب غرائبه",10,"ب",2,0],["لَها زَفرةٌ مِن خَلفه أَثر زَفرة","مَشيعة في نوحها وَحَنينها",11,"ن",3,0],["لها زفير شديد من تغيضها","على العصاة وترمي نحوهم شررا",12,"ر",2,0],["لها زفير شديد من تغيظها","على العصاة وترمى نحوهم شررا",13,"ر",2,0],["لها زكاتي عسرا ويسرا","لها حياتي دنيا وأخرى",14,"ر",2,0],["لها زجل عشرون ألف ذؤابة","تسيل على أرض العبير ظفيرها",15,"ر",3,0]]}