{"poems":[[32,"أعن ترسمت من خرقاء منزلة","https://www.aldiwan.net/poem29532.html","البسيط"],[82,"جلا محياك عن أبصارنا الرمدا","https://www.aldiwan.net/poem31474.html","البسيط"],[146,"وددت التصابى فيك إذ كان عاذرى","https://www.aldiwan.net/poem58434.html","الطويل"],[159,"كأن أجفانه من جسم عاشقه","https://www.aldiwan.net/poem55502.html","البسيط"],[285,"لنا مجلس ما فيه للهم مدخل","https://www.aldiwan.net/poem60713.html","الطويل"],[350,"أمولى بني تيم ألست مؤديا","https://www.aldiwan.net/poem4476.html","الطويل"],[369,"دام علاء العماد","https://www.aldiwan.net/poem60952.html","مجزوء السريع"],[435,"أخلاي أن الشوق هبت نواسمه","https://www.aldiwan.net/poem40836.html","الطويل"],[498,"كم منة للظلام في عنقي","https://www.aldiwan.net/poem67351.html","المنسرح"],[500,"سماء الدجى ما هذه الحدق النجل","https://www.aldiwan.net/poem10259.html","الطويل"],[503,"كأن أجالنا صقور","https://www.aldiwan.net/poem3692.html","مخلع البسيط"],[741,"","https://poetry.dctabudhabi.ae/diwan/poem/199299","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63870","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38212","البسيط"],[917,"","https://poetry.dctabudhabi.ae/diwan/poem/34514","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62586","البسيط"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93356","المنسرح"],[3778,"","https://poetry.dctabudhabi.ae/diwan/poem/90002","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131191",""],[3870,"","https://poetry.dctabudhabi.ae/diwan/poem/204021","المنسرح"],[585,"يا صارخاً أجفلت من صوته الأمم","https://www.poetsgate.com/ViewPoem.aspx?id=161844",""],[5246,"نصيحة","https://www.poetsgate.com/ViewPoem.aspx?id=187036",""],[5431,"تسلل ضوئي...","https://www.poetsgate.com/ViewPoem.aspx?id=202580",""],[5582,"صَبٌّ بِدِرَّةِ ثَدْيِ الحُبِّ مَلْبُونُ","https://www.poetsgate.com/ViewPoem.aspx?id=63587",""]],"verses":[["كَأَنَّ أَجلادَ حاذَيها وَقَد لَحِقَت","أَحشاؤُها مِن هَيامِ الرَملِ مَطمومُ",0,"م",1,0],["كَأَنَّ أجفانَهُ في الحَربِ قَد وَرَدَت","مَعَ الدِّماءِ منَ الهِندِيِّ ما وَرَدا",1,"د",2,0],["كأنا جميمُ الروض يقطُف نَوْرَه الظ","باءُ ولا يحلو لأُسْدٍ خوادرِ",2,"ر",1,0],["كأَنَّ أَجْفَانَهُ مِنْ جِسْمِ عَاشِقِهِ","قَدْ رُكِّبَتْ فَهْيَ بِالأَسْقَامِ تَحْكِيهِ",3,"ه",1,1],["كَأَنّا جَمِيعاً دُونَهُ وَهْوَ واحِدٌ","بِساحِلِ بَحْرٍ رِيعَ مِنْهُ الْمُلَجِّجُ",4,"ج",1,0],["كَأَنَّ اِجيجَ النارِ إِرزامُ شُخبِها","إِذا اِمتاحَها في مِحلَبِ الحَيِّ مائِحُ",5,"ح",1,0],["كأنّ أَجفانَهم","أَهدابُها من قَتاد",6,"د",1,0],["كأن اجتماع المال جمع عداته","متى يدن من راحاته فهو قاسمه",7,"م",2,0],["كَأَنَّ أَجزاءَهُ مُرَكَّبَةٌ","حُسناً وَلُطفاً مِن زُرقَةِ الحَدَقِ",8,"ق",1,0],["كأنا جياع والمطيّ لنا فم","كأن الفلا زاد كأن السرى أكل",9,"ل",1,0],["كَأَنَّ أَجالَنا صُقور","وَنَحنُ مِن تَحتِها خَشاشُ",10,"ش",1,1],["كأنّ آجال شجعان الورى خلقت","في أنفس البيض والخطبّة الذّبل",11,"ل",1,0],["كأن أجْفَانَه بُدورٌ","كأنَّ أَحداقَه شُموس",12,"س",1,0],["كَأنَّ أَجسادَهم أَقلامُهُ بُريَت","بِسَيفِهِ المُعتَلي جَزماً على صُقَلِ",13,"ل",1,0],["كَأَنَّ أَجبالَها مِن حَولِها سُحُبٌ","تَقَشَّعَت بَعدَ قَطرٍ عَن سَماواتِ",14,"ت",1,0],["كأنَّ أجسامهم خُشْب مُسنّدة","قد تبَّرتها السيوف المَشرِفيّاتُ",15,"ت",1,0],["كَأَن أَجفانهُ جُفون الَّذي","أَهواه لا تَستَطيع أَن تَسهر",16,"ر",1,0],["كأنّ أجفانَ عيني من تذكُّرهِ","غُصن مَروح من الطَّرفاءِ مهَضوبُ",17,"ب",1,0],["كأن اجتماعك في يوم الخميس لنا","فوزا به عاد شمل الظلم منصدعا",18,"ع",2,0],["كأن أجفان عينه حلفت","ألا تذوق الرقاد أجفاني",19,"ن",2,0],["كأن أجسامهم أكفان أنفسهم","فلا يبالون ما يزكو وما يصم",20,"م",1,0],["كأن اجتلابَ المال جاء بقوةٍ","لديك وإبقاء على المال تقدر",21,"ر",1,0],["كأنّا جراحٌ لم نُدرْ كأسَ لذّةٍ","وماكان تيه العشق فينا يُعشش",22,"ش",1,0],["كأَنَّ أَجْسامَهُنَّ البِيضَ إِذْ سَفَرَتْ","بَيْضٌ عَنْ الوَمَدِ الوَهّاجِ مَكْنُونُ",23,"ن",1,0]]}