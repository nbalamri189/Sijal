{"poems":[[29,"حيوا الديار وأهلها بسلام","https://www.aldiwan.net/poem6005.html","الكامل"],[93,"تبدل قلبي من ضلالته رشدا","https://www.aldiwan.net/poem8815.html","عموديه"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85375","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[146,"لأى مرمى تزجر الأيانقا","https://www.aldiwan.net/poem58416.html","الرجز"],[215,"وفدت على بغداد والقلب موجع","https://www.aldiwan.net/poem46574.html","الطويل"],[324,"احبس علي فارساً وقل لها","https://www.aldiwan.net/poem23877.html","الرجز"],[376,"أرأيتني فيما أراك طروقا","https://www.aldiwan.net/poem57281.html","الكامل"],[382,"قلب يقلبه النوى","https://www.aldiwan.net/poem59383.html","مجزوء الكامل"],[463,"أبلغ بها أمنية الطالب","https://www.aldiwan.net/poem56275.html","السريع"],[466,"احب سجايا الخير غرا كأنها","https://www.aldiwan.net/poem15461.html","الطويل"],[469,"حديث غرامي في هواك قديم","https://www.aldiwan.net/poem3516.html","عموديه"],[545,"إحبس على طلل ورسم منازل","https://www.aldiwan.net/poem56689.html","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64347","الرمل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64249","الرمل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80233","الكامل"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/12011","البسيط"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141353","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93648","الوافر"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100240","الخفيف"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97891","المتقارب"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108285","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131060",""],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93320","الرمل"],[4856,"أحبك","https://www.poetsgate.com/ViewPoem.aspx?id=36739",""],[5271,"فرح","https://www.poetsgate.com/ViewPoem.aspx?id=123671",""],[5376,"احبسْ دموعَك حافظاً أنسامَها","https://www.poetsgate.com/ViewPoem.aspx?id=202167",""],[5582,"سَقاكِ دِيارَ الظَّاعِنِينَ غَمامُ","https://www.poetsgate.com/ViewPoem.aspx?id=187273",""],[1547,"يا معشَرَ الناس حالي بينكم","https://www.poetsgate.com/ViewPoem.aspx?id=17094",""],[5725,"احبس الدمع","https://www.poetsgate.com/ViewPoem.aspx?id=195395",""],[6038,"سحر العيون","https://www.poetsgate.com/ViewPoem.aspx?id=32327",""],[161,"حنين الأنام لحج بيت الله الحرام","https://www.poetsgate.com/ViewPoem.aspx?id=175362",""],[6202,"احبس دموعك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86700&r=&rc=1",""]],"verses":[["اِحبِس رِباطَكَ حَيثُ كُنتَ مُسَبَّقاً","وَاِسكُت فَغَيرُ أَبيكَ كانَ يُحامي",0,"م",2,0],["أَحَبَّ سِوايَ العَيشَ لَهوا وَراحَةً","وَأَنكَرتُهُ لَهواً فَأَحبَبتُهُ كَدّا",1,"د",2,0],["احبس دموعك أَو أرسل بوادرها","فَلَيسَ يَرجع شيءٌ بعد ما فرطا",2,"ط",2,0],["احبسوا السيلَ إن قدرتم وسُدّوا","إن أردتم منافذَ البركان",3,"ن",1,0],["احبِس دمعى فيِندُّ شاردا","كأننى أضِبطُ عبدا آبقا",4,"ق",2,0],["أحبّ سعير الوجد فأرم حشاشتي","على جمراتٍ منه حمقاء هوجاء",5,"ا",2,0],["اِحبِس عَلَيَّ فارِساً وَقُل لَها","تَحبِس عَلَيَّ دِفَّها وَحِلَّها",6,"ل",3,1],["احبِس عليكَ فلَيسَ تَخفقُ غيرَها","عَينايَ مادامَ الفُؤادُ خَفوقا",7,"ق",2,0],["احبس لسانَك تستقِم","ما بين محبوسٍ وحابس",8,"س",1,0],["اِحبس مطاياك فما في السرى","إلا جنونُ الطمعِ الكاذبِ",9,"ب",1,0],["اُحِبُّ سَجايا الخيرِ غُرّاً كأنها","إذا طلعت يوم النَّدِيِّ نجومُ",10,"م",1,1],["أحبُّ سليمى والشبابَ لأجلها","لو أنَّ سليمى والشبابَ يدوم",11,"م",1,0],["إِحبِس عَلى طَلَلٍ ورَسمِ مَنازِلِ","أَقوَينَ بَينَ شَواحِطٍ وَخلائِلِ",12,"ل",1,1],["أحبسنا الكرب اجساها","وأسالا الدار اسألاها",13,"ا",3,1],["احبسا العيسَ احْبساها","وسَلا الدار سَلاها",14,"ا",3,1],["أَحبَستِهِ لِيكُفَّ عَن سَرِقاتِهِ هُوَ","يَركَب الأَوزار إِن لَم يَسرِقِ",15,"ق",1,0],["أُحِبُّ سُمرَ القَنا مِن أَجلِ مُشُبِهِها","لَونان وَأَحسُدُ حَتّى مَن بِها طُعَنا",16,"ن",2,0],["إحبس مساعيك الجليلة وان","ظر كيف ندفع خطبنا الجللا",17,"ل",2,0],["أَحب سَوانح الأَفكار حَتّى","نَفَت عَن وَرد مُقلته الهَجوعا",18,"ع",2,0],["أحبس اليعملات فوق محيل الر","بع مكثل العجول أو بعض مكث",19,"ث",1,1],["أحب سمنود لا للغنى","أصبتُ ولكن لبرى بها",20,"ب",3,1],["أحبُّ سكنى ديار أنت نازلها","وحبذا لو غدا هذا بامكاني",21,"ن",2,0],["احبس مدادك أيها القلم","إن كنت ترعى عندك الذمم",22,"م",1,1],["إِحبس الكأْس فقد","عِفتُ سُلاف الزَّرَجونِ",23,"ن",1,0],["أُحبُّ سُعادَ فيسري هواها","بصدري كريحِ الربيعِ العليلْ",24,"ل",1,1],["احبسْ دُموعكَ أنَّ الروحَ تنهَملُ","واهجرْ سَمَاءَكَ مَا عَادَتْ بها زُحَلُ",25,"ل",1,1],["احبسْ دموعَك حافظاً أنسامَها","رفقاً فإنَّك ما بلغْتَ سقامَها",26,"م",3,1],["أُحِبُّ سَقاماً جاءَ مِنْها لأَجْلِها","فأَنْعَمُ هَجْراً وَالحَبِيبُ سَقامُ",27,"م",1,0],["أُحبُّ سُمر القنا من أَجل مُشُبِهِها","لوناً: وأحسدُ حتى من بها طعنا",28,"ن",2,0],["احبس الدمع لئلا يفزعك","مشفقاً من مدمعي أنْ يوجعكْ",29,"ك",1,1],["احبسيه وسط الجفون","وخلى اهدابك قفل",30,"ل",1,0],["16-أُحِبُّ سَبِيلَ اليُسْرِ والرُّشْدُ مَبْدَئي","أُحِبُّ شُهُودَ الفَجْرِ والسَّبْق والعزْمَا",31,"م",2,0],["احبس دموعك إن عمرك ذاهب","وانظم لشعرك ما أردت تعاتب",32,"ب",1,1],["احبس دموعك ما تفيد مناحة","أبدا وما ينجو لعمرك نادب",32,"ب",1,0]]}