wan/poem/136084","الرجز"],[3984,"","https://poetry.dctabudhabi.ae/diwan/poem/147200","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83662","الخفيف"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133091","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133117","الرجز"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133162","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133142","المجتث"],[4684,"أفرخ الزغلول","https://www.poetsgate.com/ViewPoem.aspx?id=202387",""],[4691,"لحن هيفا","https://www.poetsgate.com/ViewPoem.aspx?id=59592",""],[4859,"أنا ما أضعتك!","https://www.poetsgate.com/ViewPoem.aspx?id=210750",""],[5111,"قِيثَارَةُ العِشْقِ","https://www.poetsgate.com/ViewPoem.aspx?id=212085",""],[5112,"البدر الراحل","https://www.poetsgate.com/ViewPoem.aspx?id=212708",""],[5121,"هَدِيَّتِي إِلَيْكَ","https://www.poetsgate.com/ViewPoem.aspx?id=209063",""],[5121,"لُؤْلُؤَة","https://www.poetsgate.com/ViewPoem.aspx?id=215867",""],[5183,"حلبة الرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=180224",""],[5190,"الحقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=175589",""],[5273,"بيتان يوسفيان","https://www.poetsgate.com/ViewPoem.aspx?id=181586",""],[5338,"« يا رسول الله خذ بيدي »","https://www.poetsgate.com/ViewPoem.aspx?id=187760",""],[5365,"خدُّها","https://www.poetsgate.com/ViewPoem.aspx?id=190406",""],[5381,"ملعبٌ وتراب","https://www.poetsgate.com/ViewPoem.aspx?id=214591",""],[5409,"يا شبابي لم يصبني لك ذكر","https://www.poetsgate.com/ViewPoem.aspx?id=155268",""],[5413,"ليلة الغرباء","https://www.poetsgate.com/ViewPoem.aspx?id=208657",""],[5431,"لكل شيء من الأسباب دافعه","https://www.poetsgate.com/ViewPoem.aspx?id=190306",""],[5431,"من أطلق الوحشا؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=199214",""],[5559,"بيننا شغاف الروح ( محمود أسد )","https://www.poetsgate.com/ViewPoem.aspx?id=60738",""],[5561,"خذني إليك ...","https://www.poetsgate.com/ViewPoem.aspx?id=206453",""],[5618,"سهد وحنين","https://www.poetsgate.com/ViewPoem.aspx?id=208935",""],[5621,"صلاة الفتح","https://www.poetsgate.com/ViewPoem.aspx?id=24567",""],[5631,"نَوَّاتُ الحَنينِ","https://www.poetsgate.com/ViewPoem.aspx?id=211085",""],[5651,"ألِفارطِ العيشِ الرّطيبِ معيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=107007",""],[5674,"يا نازك الحرف يا أسمى بلاغاتي","https://www.poetsgate.com/ViewPoem.aspx?id=189098",""],[5674,"كان صمتك قاتلا","https://www.poetsgate.com/ViewPoem.aspx?id=191748",""],[5736,"قشب الذنوب","https://www.poetsgate.com/ViewPoem.aspx?id=208468",""],[5855,"يا من أناجيه في سر وإعلان","https://www.poetsgate.com/ViewPoem.aspx?id=186767",""],[5913,"نجوى نسيم الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=177075",""],[5956,"أجمل جنة في الأرض","https://www.poetsgate.com/ViewPoem.aspx?id=184960",""],[5956,"أ تطيق بُعداً عن محبِّك خالدٍ؟","https://www.poetsgate.com/ViewPoem.aspx?id=193347",""],[6019,"عتاب على هامش الشوق ...!!","https://www.poetsgate.com/ViewPoem.aspx?id=53042",""],[6125,"أَهوَى اللِّقَاءَ وأشتَهِي القُرْبَا","https://www.poetsgate.com/ViewPoem.aspx?id=210722",""],[6152,"لاتسأليني","https://www.poetsgate.com/ViewPoem.aspx?id=203096",""],[6302,"بَغدادْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86227&r=&rc=25",""]],"verses":[["أغفلت عمّا فيهما","ما عذرُ مثلك يُقبلُ",0,"ل",1,0],["أَغفى ذِراعَيهِ وَأَنحى عَلى","لِحيَتِهِ بِالنَتفِ يُحفيها",1,"ي",3,1],["أَغفَلتَ مِن دارِ البَقاءِ نَعيمَها","وَطَلَبتَ في دارِ الفَناءِ نَعيما",2,"م",2,0],["أغفر خليلي الشكَّ في الرؤيا التي","ملكت عليَّ مَشاعِري وصَوابي",3,"ب",2,0],["أغفيت في كنفي وفي ظل الكرى","كالطفل في أمنٍ مِنَ الأوجاع",4,"ع",1,0],["أغفى ونَصَّبَ خيشوماً يُحِسُّ به","خُطى اللصوص ويستاف السراحينا",5,"ن",2,0],["اغفري لي إِذا اِتَهَمتُك بِالغَد","رِ فَقَد كُنتُ غائِباً عَن صَوابي",6,"ي",1,1],["اِغفري لي لَعل ما كانَ مني","صَرخة الهَول عِندَ مَرأى عَذابي",6,"ي",1,0],["اِغفري لي ما قلته في جُنوني","وَتَعالي أَشرح إِلَيك مصابي",6,"ي",1,0],["إِغفري لي فَإِن أَشقى المحبّين","محبٌّ حَياتُهُ ذكرياتُ",6,"ت",1,0],["أَغفَلَهُ البَوّابُ مِن شِقوَتي","فَجاءَني يَضحَكُ عِطفاهُ",7,"ا",2,0],["اغفي لعبد تاب من فيطاته","ما كان منه في الزمان الأول",8,"ل",1,0],["أغفى الوجود ونام سُمارُ الدجى","إلا أنا والشعرُ والأشواقُ",9,"ق",1,0],["أغفى الجريح على السكون وأغمضت","أجفان من حوليه كفّ سبات",10,"ت",1,0],["أغفى الوجود ونام سمّار الدجا","إلاّ أنا والشعر والأشواق",11,"ق",1,0],["أغفَت طويلاً ولما هاجَ هائجُه","جاءته بعد فواتِ الوقتِ تبتدِر",12,"ر",1,0],["أغفر لعبدك يربي ياغفور ورحوم ..","ياكافلن سعد.. من قدهو..؟ ألى .. لاقده",13,"د",2,0],["أغفت على أعذارها ، فتريّثوا","ألله ليس بقابل أعذارها",14,"ر",3,0],["أغفين فيه لماما ثمّ عدن إلى","جنّاتهنّ وقد لملمن ريّاه",15,"ا",2,0],["اغفر ذنوبي واجتذب قلبي الى","علياك يا رحمن يا ديان",16,"ن",1,0],["أغفلةٌ منك أم سهو تعيرنا","فعل امرىء غير ذى علم بما عَمِلا",17,"ل",2,0],["أغفلتُ ما حازْته من مهجتى","مخافةً أن تذكُرَ الباقي",18,"ق",2,0],["أغفيته من وصالي وهو يكرهه","صبرا وفي الصبر ضرّ عند مصطبره",19,"ر",2,0],["إغفاءةٌ الدهر لو طالت لما عبثت","بنا الصروف وصرف الدهر يجتاح",20,"ح",1,0],["اغفلت من غفلات الدهر آونة","آوت من الجيرة الغادين مثواك",21,"ك",1,0],["اِغفِر لِعَبد اللَهِ ما قَد جَنى","وَاِرزُقه عِندَ المَوت حُسن الخِتام",22,"م",1,0],["اِغفِر بِفَضلِكَ لِلعِبادِ وَاِعفُ عَن الما","ضي وَآمنه من خَوف وَمِن وَجل",23,"ل",1,0],["اغفر لهم أبتاه هم لم يعلموا","ما يعملون وإن رأوا ما صدَّقوا",24,"ق",3,0],["اغفر وسامح لذي الآيام والاوزار","فرج عليه إلهي باسمك المكنون",25,"ن",1,0],["اغفر لنا ذنبنا","وابدله بالصالحات",26,"ت",1,0],["اغْفرْ بِفَضْلِكَ يا عليمُ شُؤُنَنا","يا خيرَ من فَضلاً على العاصي سَتَرْ",27,"ر",1,0],["أَغْفَلْتُ وَجْهَ شَبيبَتي","حتَّى تَنَقَّبَ بِالنِّقَابِ",28,"ب",1,0],["أغفلتني بزهوها وكأني","ما احتسبت المعاد في حسباني",29,"ن",2,0],["أَغفلت وَيلك عَن مَضيق مُظلم","أَمسيت فيهِ تَقول ذاكَ مقدّر",30,"ر",1,0],["أغفلوني فما عرفت أمن حُض","ضارهم كنت أم من الغُيّاب",31,"ب",1,0],["أغفى عَلى غَير وَعد مِن منبهه","مَع الصباح وَيَوم الحَشر مَوعده",32,"د",2,0],["اغفر لنا الذنوبا والعيوبا","وهب لنا المقصود والمطلوبا",33,"ب",2,0],["اغفر لنا وساتر عيوباً لنا","فإننا جيران بيتٍ حرام",34,"م",1,0],["إغفر لعبد قالها ومن نظر","في نظمها ومن على عيب ستر",35,"ر",1,0],["اغفر لنا واكفنا والحاضرين ومن","قد غاب عنا وأهل الحلّ والحرم",36,"م",1,0],["أغفوا هنالك في ظلال بشاشة","عنها عيون الحادثات غوافي",37,"ف",2,0],["أغفر خدي في حراء ومن حرى","أطوف ببيت الله في الحج والعمر",38,"ر",1,0],["أغفَى لِدِقَّةِ مَا جَرى حتى ادَّعَى","مَا فَهمُهُ عَنْ مِثلِهِ مُتَعَذّرُ",39,"ر",1,0],["أغفلني عنها الذي حدثته","عني من قضية الخمور",40,"ر",1,0],["أغفت جُفون الرّشد ثم تنبّهت","بلطائِفٍ قد كُنّ تحت سجاف",41,"ف",1,0],["أغفى فيا ليت شعري هل يلم به","إذا دجا الليل طيف كان يأتيه",42,"ي",2,0],["أغفيت قبل الصبح نوم مسهد","في ساعة ما كنت قبل أنامها",43,"م",3,1],["اغفر لنا والطف بِنَا في ما القدَر","جَرَى بِهِفيما خَفِي وَمَا ظَهَر",44,"ر",1,0],["اغفر لعبد على الاسلام نشأته","يرجوك صدقاوان خابت مساعيه",45,"ي",2,0],["اغفر لعبد على الاسلام فطرته","يدعوك حقاً وان جلت مساويه",45,"ي",2,0],["اغفر ذنوبي كلها ومثالبي","أيضاً وعشني عيشة السعداء",46,"ا",2,0],["أغفر لنا ظمها أبو البركات أبرا","هيم من يقري بساحة غزة",47,"ه",1,0],["اغفى الرقيب وأُوقظ الأملُ","وثوى الامان وقوّض الوَجلُ",48,"ل",1,1],["أغفى وقد أيقظني للهوى","وبات طرفي حارساً مضجعه",49,"ع",2,0],["اِغفر له زلّاته","أَيّ الخَلائِق لا يَزَلُّ",50,"ل",1,0],["إغفر لشمس الدين عصيانه","ونجّه من هول نار الجحيم",51,"م",1,0],["اغفر لنا ما كانَ من سوءٍ وبدِّله","بِحُسنٍ أنت أهلٌ لِلحَسَن",52,"ن",1,0],["اغفرْ لنا الذنوبَ يا علاَّمُ","واستُرْ لنا العيوب يا سلامُ",53,"م",1,0],["أغفلته عصابةٌ ساقت الشع","ب عبيداً لأجنبيّ مسوّد",54,"د",1,0],["أَغفِلوا الحَقَّ وهو حقٌّ صُراحٌ","في فِلِسطين يومَ حَقَّ القيامُ",55,"م",1,0],["اغفر وسامح وتب وامنن بعافيةٍ","واختم بخيرٍ لدى أعمار تنهيها",56,"ي",3,0],["اغفر لنا يا ربنا جميعاً","اسبل علينا نعمتك سريعا",57,"ع",2,0],["اغفر لمن قد أتى من ذنبه خائفاً","فضلاً لما قد جنى في عمره ولها",58,"ه",2,0],["اغفر يا رحيم","أوزار توجب بعادي",59,"ي",1,0],["اغفر حماقة مشرفٍ متهوّرٍ","الثومُ أفسد ذوقه والفولُ",60,"ل",1,0],["أغفو وأكون ملتحفاً.","عينيك وأحضن ُ اللطفا",61,"ف",2,0],["أغفو عليك وإن صحوت فلا أرى","إلاك في حض