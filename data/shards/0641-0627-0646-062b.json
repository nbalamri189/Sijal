{"poems":[[42,"ألا أبلغا عني زيادا رسالة","https://www.aldiwan.net/poem50332.html","الطويل"],[88,"كفى بالعلم في الظلمات نورا","https://www.aldiwan.net/poem45002.html","الوافر"],[88,"من أين من أين يا ابتدائي","https://www.aldiwan.net/poem45073.html","مخلع البسيط"],[51,"عزاؤك أن الدهر ذو فجعات","https://www.aldiwan.net/poem8699.html","الطويل"],[70,"لو تراني وحبيبي عندما","https://www.aldiwan.net/poem42388.html","الرمل"],[92,"يا قلبي الدامي إلام الوجوم","https://www.aldiwan.net/poem38920.html","البسيط"],[85,"نظارة العدلية","https://www.aldiwan.net/poem7256.html","مجزوء الرجز"],[85,"نظر الليث إلى عجل سمين","https://www.aldiwan.net/poem8041.html","الرمل"],[85,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[61,"نحن للأيام غنم ونفل","https://www.aldiwan.net/poem51477.html","الرمل"],[61,"رب صاف رقرقته الريح","https://www.aldiwan.net/poem51758.html","مجزوء الرمل"],[66,"وغزال غازلته بعد بين","https://www.aldiwan.net/poem39511.html","الكامل"],[66,"صاحب السيف الصقيل المحلا","https://www.aldiwan.net/poem39637.html","المديد"],[66,"وحق الهوى ما حلت يوما عن الهوى","https://www.aldiwan.net/poem39641.html","الطويل"],[66,"ظن قومي أن الأساة ستبري","https://www.aldiwan.net/poem40115.html","الخفيف"],[66,"ظن قومي أن الأساة ستبري داء","https://www.aldiwan.net/poem40654.html","الخفيف"],[80,"هات كأس الراح أو خذها إليك","https://www.aldiwan.net/poem31354.html","الرمل"],[40,"لقد أرسلت ليلى رسولا بأن أقم","https://www.aldiwan.net/poem42342.html","الطويل"],[67,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[50,"نظرت عيني لحيني","https://www.aldiwan.net/poem24570.html","مجزوء الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39654","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39624","الرمل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202546","الرمل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30451","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55152","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[74,"","https://poetry.dctabudhabi.ae/diwan/poem/141800","الخفيف"]],"verses":[["فَإِن ثَقُلَت لا وَهيَ غَيرُ خَفيفَةٍ","عَلَيكَ فَلَلأُخرى أَشَدُّ وَأَثقَلُ",0,"ل",1,0],["فإن ثيابهم أكفان موتى","وليس بُيوتهم إلاّ قبورا",1,"ر",2,0],["فأنثني باكياً بشعري","ويطرب الليل من بكائي",2,"ا",2,0],["فإن ثوابَ الله في رُزء مثلها","لِقاؤُكها في أرفع الدرجاتِ",3,"ت",1,0],["فَاِنثَنى يَحمَرُّ مِنّي خَجَلاً","وَثَناهُ التيهُ عَنّي لا إِلَيَّ",4,"ي",1,0],["فانثُرْ غُبارَ الحُزْن فوقَ الدُّجَى","واسمعْ إلى صوتِ الشَّبابِ الرخِيمْ",5,"م",1,0],["فإن ثروت حاوى","يعيدها سحلية",6,"ي",2,0],["فَاِنثَنى يَضحَكُ مِن طَيشِ العُجول","وَجَرى في حَلبَةِ الفَخرِ يَقول",7,"ل",1,0],["فَاِنثَنى مُنخَدِعاً مُستَسلِماً","شاةٌ اِغتَرَّت بِعَهدِ الأَلَسِ",8,"س",1,0],["فانثَنَوا عن ذلك الشُّربِ الذي","صار عَلاً لسِواهُم ونَهَلْ",9,"ل",1,0],["فانثَنَوا عنه بأيدٍ","خَضِراتٍ عَطِراتِ",10,"ت",1,0],["فَاِنثَنى ضاحِكاً وَقالَ لَعَمري","تَنثَني راجِعاً بِخُفّي حُنَينِ",11,"ن",1,0],["فَاِنثَنى يَطلُبُ الفِرارَ وَجَيشي","راجِعاً نَحوَهُ مِنَ الجانِبَينِ",11,"ن",1,0],["فَاِنثَنى عَنها نِفا","راً فَقالَت",12,"ت",1,0],["فَاِنثَنَيتِ ساهِيَةً","وَالقُلوبُ واهِيَةً",13,"ه",1,0],["فَاِنثَنى حائِراً وَقالَ لِأَهلي","ما شِفاءُ العُشّاقِ إِلّا بَعيدُ",14,"د",1,0],["فَاِنثَنى حائِراً وَقالَ لِقومي","ما دَواءُ العُشّاقِ إِلّا بَعيدُ",15,"د",1,0],["فانثَنَتْ كِبراً وقالَتْ وَيلَتا","أَوَ هَذا كُلّهُ تَطلبُ وَيْك",16,"ك",1,0],["فَإِنَّ ثَوائي عِندَكُم لا أَزوُرُكُم","وَلا أَنا مَردُودٌ بِيَأسٍ مُزَحَّلُ",17,"ل",1,0],["فَأَنْثَنِي وَيَدِي بالفَوْزِ ظافِرَةٌ","وَثَوْبُ ذَنْبِي مِنَ الآثامِ مَغْسُولُ",18,"ل",1,0],["فَاِنثَنَت حَتّى تَوارى","بَينَ طَيِّ العَكنَتَينِ",19,"ن",1,0],["فانثنتْ تنظر للوادي العجيبِ","صُوَراً يَذهبنَ في إِثرِ صورْ",20,"ر",1,0],["فانثنى الشيطانُ عنها صارخاً","أتراها تتحدَّى من تُراها",21,"ا",3,0],["فانثنى منخدعا مستسلما","شاة اغترتْ بعهد الأطلس",22,"س",1,0],["فانثَنَى يَهْتَزُّ مِن مَنكِبِه","قائِلاً لا ثُمَّ أَعْطَانِي اليدا",23,"د",2,0],["فَانْثَنَتْ تُطْفِئُهُ هَلاَّ رَأَت","حَوْلَهَا كَمْ مِنْ قُلُوبٍ تَشْتَعِلْ",24,"ل",1,0],["فَانثَنَى مُنْشرِحاً صَدراً كَأَنْ","لَمْ يَجِيءْ مِنْ شُنَعِ التَّنْكِيلِ صَدْرَا",25,"ر",2,0],["فانثنينا مع الغصون غصوناً","مرحاً في بطاحها ورباها",26,"ا",3,0]]}