ttps://www.poetsgate.com/ViewPoem.aspx?id=211904",""],[6102,"جَرِّبِينِي !!","https://www.poetsgate.com/ViewPoem.aspx?id=183607",""],[6189,"فيروز أغنية العش الأولى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83597&r=&rc=64",""]],"verses":[["فَإِن ثَقُلَت لا وَهيَ غَيرُ خَفيفَةٍ","عَلَيكَ فَلَلأُخرى أَشَدُّ وَأَثقَلُ",0,"ل",1,0],["فإن ثيابهم أكفان موتى","وليس بُيوتهم إلاّ قبورا",1,"ر",2,0],["فأنثني باكياً بشعري","ويطرب الليل من بكائي",2,"ا",2,0],["فإن ثوابَ الله في رُزء مثلها","لِقاؤُكها في أرفع الدرجاتِ",3,"ت",1,0],["فَاِنثَنى يَحمَرُّ مِنّي خَجَلاً","وَثَناهُ التيهُ عَنّي لا إِلَيَّ",4,"ي",1,0],["فانثُرْ غُبارَ الحُزْن فوقَ الدُّجَى","واسمعْ إلى صوتِ الشَّبابِ الرخِيمْ",5,"م",1,0],["فإن ثروت حاوى","يعيدها سحلية",6,"ي",2,0],["فَاِنثَنى يَضحَكُ مِن طَيشِ العُجول","وَجَرى في حَلبَةِ الفَخرِ يَقول",7,"ل",1,0],["فَاِنثَنى مُنخَدِعاً مُستَسلِماً","شاةٌ اِغتَرَّت بِعَهدِ الأَلَسِ",8,"س",1,0],["فانثَنَوا عن ذلك الشُّربِ الذي","صار عَلاً لسِواهُم ونَهَلْ",9,"ل",1,0],["فانثَنَوا عنه بأيدٍ","خَضِراتٍ عَطِراتِ",10,"ت",1,0],["فَاِنثَنى ضاحِكاً وَقالَ لَعَمري","تَنثَني راجِعاً بِخُفّي حُنَينِ",11,"ن",1,0],["فَاِنثَنى يَطلُبُ الفِرارَ وَجَيشي","راجِعاً نَحوَهُ مِنَ الجانِبَينِ",11,"ن",1,0],["فَاِنثَنى عَنها نِفا","راً فَقالَت",12,"ت",1,0],["فَاِنثَنَيتِ ساهِيَةً","وَالقُلوبُ واهِيَةً",13,"ه",1,0],["فَاِنثَنى حائِراً وَقالَ لِأَهلي","ما شِفاءُ العُشّاقِ إِلّا بَعيدُ",14,"د",1,0],["فَاِنثَنى حائِراً وَقالَ لِقومي","ما دَواءُ العُشّاقِ إِلّا بَعيدُ",15,"د",1,0],["فانثَنَتْ كِبراً وقالَتْ وَيلَتا","أَوَ هَذا كُلّهُ تَطلبُ وَيْك",16,"ك",1,0],["فَإِنَّ ثَوائي عِندَكُم لا أَزوُرُكُم","وَلا أَنا مَردُودٌ بِيَأسٍ مُزَحَّلُ",17,"ل",1,0],["فَأَنْثَنِي وَيَدِي بالفَوْزِ ظافِرَةٌ","وَثَوْبُ ذَنْبِي مِنَ الآثامِ مَغْسُولُ",18,"ل",1,0],["فَاِنثَنَت حَتّى تَوارى","بَينَ طَيِّ العَكنَتَينِ",19,"ن",1,0],["فانثنتْ تنظر للوادي العجيبِ","صُوَراً يَذهبنَ في إِثرِ صورْ",20,"ر",1,0],["فانثنى الشيطانُ عنها صارخاً","أتراها تتحدَّى من تُراها",21,"ا",3,0],["فانثنى منخدعا مستسلما","شاة اغترتْ بعهد الأطلس",22,"س",1,0],["فانثَنَى يَهْتَزُّ مِن مَنكِبِه","قائِلاً لا ثُمَّ أَعْطَانِي اليدا",23,"د",2,0],["فَانْثَنَتْ تُطْفِئُهُ هَلاَّ رَأَت","حَوْلَهَا كَمْ مِنْ قُلُوبٍ تَشْتَعِلْ",24,"ل",1,0],["فَانثَنَى مُنْشرِحاً صَدراً كَأَنْ","لَمْ يَجِيءْ مِنْ شُنَعِ التَّنْكِيلِ صَدْرَا",25,"ر",2,0],["فانثنينا مع الغصون غصوناً","مرحاً في بطاحها ورباها",26,"ا",3,0],["فانثنى ليله كما يخبط المخمور","في الوحل ، والسماء مطيره",27,"ر",2,0],["فانثنت ((هاديا)) وقالت ترابي","يا كنوز الرشيد أغلى ذخيره",28,"ر",2,0],["فأنثني غير مخدوع وكم فتنت","لي الأماني بإيماءٍ وتلماع",29,"ع",1,0],["فَاِنثنى ترجفُ البوادرَ منه","لِخديجٍ وحبّذا الإنثناءُ",30,"ا",2,0],["فأنثنى منصرفا آيسا","من عمل يختص بالفاعل",31,"ل",1,0],["فانثنى عنى على أن يستبين","أنني في حبّه الروح الأمين",32,"ن",1,0],["فانثنت تبعث اللقاء كما يبعد عن","مطلب الكريم النجاح",33,"ح",1,0],["فاِنثَنى عنها مقرّاً أَنَّ في","أَنفهِ الرغمَ وفي فيه الرغاما",34,"م",2,0],["فانثني غير هياب ولا وجل","أصيح بين خيالاتي واغوالي",35,"ل",2,0],["فَانثَنَوا بَعدَ مِصاعٍ صَادقٍ","كَسَّرَ الدَّرعَ وَفَضَّ القَونَسَا",36,"س",2,0],["فَإِنَّ ثَناءً أَنتَ تَذخَرُهُ مِنّي","يَفوقُ ثَراءً أَنتَ تَذخَرُهُ عَنّي",37,"ي",1,1],["فَأَنثَني بَعدَ الدُعا قائِلاً","سُبحانَ مَن يُحيي العِظامَ الرَميم",38,"م",1,0],["فإنَّ ثنائي واعتِقادي وطاعتي","لأفلاكِ ما أولَيْتَنِيهِ مراكِزُ",39,"ز",1,0],["فأنثني لستُ أدري أين مُنقَلَبي","كأنني حائرٌ في اللّيلِ مُعتَسِفُ",40,"ف",1,0],["فأنْثَنِي ودُموعي مِن جَوى كَبِدِي","تَفيضُ فاعجب لماءٍ فاضَ من نارِ",41,"ر",1,0],["فانثنت أغصانها مائسةً","طرب النشوان راحت تتأوَّد",42,"د",1,0],["فأَنْثَنِي تِيهاً بلقياكُمُ","قد ضَاقَ بي أَوْسَعُ أَثوابي",43,"ب",2,0],["فانْثَنَتْ تُنْثَرُ من أَنْجُمِهِ","دُرَرٌ لولا العُلَى لم تُنْظَمِ",44,"م",1,0],["فأنثني ومهجتي","نهْبَ جيوشِ الكمَدِ",45,"د",1,0],["فإنّ ثغور الروم تحنو تشوقا","اليك فبادرها بقطع المسالك",46,"ك",1,0],["فاَنثنىْ القلبُ مُذْ رآها جريحاً","يتقطر دماً كماء الدوالي",47,"ي",1,0],["فأنثَني للهيبِ الشوقِ في كَبِدي","نضّاخُ دمعٍ لنارِ الشوقِ نَضّاحا",48,"ح",2,0],["فأنثني وقد تروَّتْ","مِن 