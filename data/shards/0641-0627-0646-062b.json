{"poems":[[42,"ألا أبلغا عني زيادا رسالة","https://www.aldiwan.net/poem50332.html","الطويل"],[88,"كفى بالعلم في الظلمات نورا","https://www.aldiwan.net/poem45002.html","الوافر"],[88,"من أين من أين يا ابتدائي","https://www.aldiwan.net/poem45073.html","مخلع البسيط"],[51,"عزاؤك أن الدهر ذو فجعات","https://www.aldiwan.net/poem8699.html","الطويل"],[70,"لو تراني وحبيبي عندما","https://www.aldiwan.net/poem42388.html","الرمل"],[92,"يا قلبي الدامي إلام الوجوم","https://www.aldiwan.net/poem38920.html","البسيط"],[85,"نظارة العدلية","https://www.aldiwan.net/poem7256.html","مجزوء الرجز"],[85,"نظر الليث إلى عجل سمين","https://www.aldiwan.net/poem8041.html","الرمل"],[85,"من لنضو يتنزى ألما","https://www.aldiwan.net/poem62962.html","الرمل"],[61,"نحن للأيام غنم ونفل","https://www.aldiwan.net/poem51477.html","الرمل"],[61,"رب صاف رقرقته الريح","https://www.aldiwan.net/poem51758.html","مجزوء الرمل"],[66,"وغزال غازلته بعد بين","https://www.aldiwan.net/poem39511.html","الكامل"],[66,"صاحب السيف الصقيل المحلا","https://www.aldiwan.net/poem39637.html","المديد"],[66,"وحق الهوى ما حلت يوما عن الهوى","https://www.aldiwan.net/poem39641.html","الطويل"],[66,"ظن قومي أن الأساة ستبري","https://www.aldiwan.net/poem40115.html","الخفيف"],[66,"ظن قومي أن الأساة ستبري داء","https://www.aldiwan.net/poem40654.html","الخفيف"],[80,"هات كأس الراح أو خذها إليك","https://www.aldiwan.net/poem31354.html","الرمل"],[40,"لقد أرسلت ليلى رسولا بأن أقم","https://www.aldiwan.net/poem42342.html","الطويل"],[67,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[50,"نظرت عيني لحيني","https://www.aldiwan.net/poem24570.html","مجزوء الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39654","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39624","الرمل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202546","الرمل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30451","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55152","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[74,"","https://poetry.dctabudhabi.ae/diwan/poem/141800","الخفيف"],[100,"قالت الضحيّة","https://www.poetsgate.com/ViewPoem.aspx?id=50170",""],[100,"مسافرة بلا مهمة","https://www.poetsgate.com/ViewPoem.aspx?id=50437",""],[120,"يا شاعر النفس كم أبكاك مصرعها","https://www.aldiwan.net/poem49358.html","البسيط"],[189,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[210,"يا أيها المولى الذي جوده","https://www.aldiwan.net/poem13320.html","السريع"],[211,"بعد أعوام طوال وطوال","https://www.aldiwan.net/poem46781.html","الرمل"],[261,"حباك عرفا حليها والوشاح","https://www.aldiwan.net/poem38348.html","الخفيف"],[297,"أشذا نعمان أهدته النعامى","https://www.aldiwan.net/poem33177.html","الرمل"],[342,"انا خيال ارى حالي بلا حال","https://www.aldiwan.net/poem55381.html","البسيط"],[357,"ما عسى تبلغ شكراً ما عسى","https://www.aldiwan.net/poem4166.html","الرمل"],[366,"فإن ثناء أنت تذخره مني","https://www.aldiwan.net/poem17828.html","الطويل"],[380,"الحمد لله الذي حمده","https://www.aldiwan.net/poem48751.html","السريع"],[405,"لئن عجزت عن شكر برك قوتي","https://www.aldiwan.net/poem49916.html","الطويل"],[409,"أزور قبرك والأشجان تمنعني","https://www.aldiwan.net/poem31856.html","البسيط"],[409,"أزور قبرك مشتاقا فيحجبني","https://www.aldiwan.net/poem31860.html","البسيط"],[416,"أعد اللهو فإن اللهو أحمد","https://www.aldiwan.net/poem54100.html","الرمل"],[432,"عليكم جانبت أصحابي","https://www.aldiwan.net/poem12326.html","السريع"],[432,"طار عن برقة برق فشم","https://www.aldiwan.net/poem12350.html","الرمل"],[432,"مالك قلبي عن يد","https://www.aldiwan.net/poem12587.html","مجزوء الرجز"],[437,"منازلهم بين اللوى فالدكادك","https://www.aldiwan.net/poem2528.html","الطويل"],[452,"قطبت وجهها وعبست الطر","https://www.aldiwan.net/poem13890.html","الخفيف"],[477,"أبارقا شمته بالغور لماحا","https://www.aldiwan.net/poem15196.html","الرجز"],[477,"أهل الحمى قد أودعوا","https://www.aldiwan.net/poem15299.html","مجزوء الرجز"],[504,"أراك ترى حالي وما تترحم","https://www.aldiwan.net/poem38409.html","الطويل"]],"verses":[["فَإِن ثَقُلَت لا وَهيَ غَيرُ خَفيفَةٍ","عَلَيكَ فَلَلأُخرى أَشَدُّ وَأَثقَلُ",0,"ل",1,0],["فإن ثيابهم أكفان موتى","وليس بُيوتهم إلاّ قبورا",1,"ر",2,0],["فأنثني باكياً بشعري","ويطرب الليل من بكائي",2,"ا",2,0],["فإن ثوابَ الله في رُزء مثلها","لِقاؤُكها في أرفع الدرجاتِ",3,"ت",1,0],["فَاِنثَنى يَحمَرُّ مِنّي خَجَلاً","وَثَناهُ التيهُ عَنّي لا إِلَيَّ",4,"ي",1,0],["فانثُرْ غُبارَ الحُزْن فوقَ الدُّجَى","واسمعْ إلى صوتِ الشَّبابِ الرخِيمْ",5,"م",1,0],["فإن ثروت حاوى","يعيدها سحلية",6,"ي",2,0],["فَاِنثَنى يَضحَكُ مِن طَيشِ العُجول","وَجَرى في حَلبَةِ الفَخرِ يَقول",7,"ل",1,0],["فَاِنثَنى مُنخَدِعاً مُستَسلِماً","شاةٌ اِغتَرَّت بِعَهدِ الأَلَسِ",8,"س",1,0],["فانثَنَوا عن ذلك الشُّربِ الذي","صار عَلاً لسِواهُم ونَهَلْ",9,"ل",1,0],["فانثَنَوا عنه بأيدٍ","خَضِراتٍ عَطِراتِ",10,"ت",1,0],["فَاِنثَنى ضاحِكاً وَقالَ لَعَمري","تَنثَني راجِعاً بِخُفّي حُنَينِ",11,"ن",1,0],["فَاِنثَنى يَطلُبُ الفِرارَ وَجَيشي","راجِعاً نَحوَهُ مِنَ الجانِبَينِ",11,"ن",1,0],["فَاِنثَنى عَنها نِفا","راً فَقالَت",12,"ت",1,0],["فَاِنثَنَيتِ ساهِيَةً","وَالقُلوبُ واهِيَةً",13,"ه",1,0],["فَاِنثَنى حائِراً وَقالَ لِأَهلي","ما شِفاءُ العُشّاقِ إِلّا بَعيدُ",14,"د",1,0],["فَاِنثَنى حائِراً وَقالَ لِقومي","ما دَواءُ العُشّاقِ إِلّا بَعيدُ",15,"د",1,0],["فانثَنَتْ كِبراً وقالَتْ وَيلَتا","أَوَ هَذا كُلّهُ تَطلبُ وَيْك",16,"ك",1,0],["فَإِنَّ ثَوائي عِندَكُم لا أَزوُرُكُم","وَلا أَنا مَردُودٌ بِيَأسٍ مُزَحَّلُ",17,"ل",1,0],["فَأَنْثَنِي وَيَدِي بالفَوْزِ ظافِرَةٌ","وَثَوْبُ ذَنْبِي مِنَ الآثامِ مَغْسُولُ",18,"ل",1,0],["فَاِنثَنَت حَتّى تَوارى","بَينَ طَيِّ العَكنَتَينِ",19,"ن",1,0],["فانثنتْ تنظر للوادي العجيبِ","صُوَراً يَذهبنَ في إِثرِ صورْ",20,"ر",1,0],["فانثنى الشيطانُ عنها صارخاً","أتراها تتحدَّى من تُراها",21,"ا",3,0],["فانثنى منخدعا مستسلما","شاة اغترتْ بعهد الأطلس",22,"س",1,0],["فانثَنَى يَهْتَزُّ مِن مَنكِبِه","قائِلاً لا ثُمَّ أَعْطَانِي اليدا",23,"د",2,0],["فَانْثَنَتْ تُطْفِئُهُ هَلاَّ رَأَت","حَوْلَهَا كَمْ مِنْ قُلُوبٍ تَشْتَعِلْ",24,"ل",1,0],["فَانثَنَى مُنْشرِحاً صَدراً كَأَنْ","لَمْ يَجِيءْ مِنْ شُنَعِ التَّنْكِيلِ صَدْرَا",25,"ر",2,0],["فانثنينا مع الغصون غصوناً","مرحاً في بطاحها ورباها",26,"ا",3,0],["فانثنى ليله كما يخبط المخمور","في الوحل ، والسماء مطيره",27,"ر",2,0],["فانثنت ((هاديا)) وقالت ترابي","يا كنوز الرشيد أغلى ذخيره",28,"ر",2,0],["فأنثني غير مخدوع وكم فتنت","لي الأماني بإيماءٍ وتلماع",29,"ع",1,0],["فَاِنثنى ترجفُ البوادرَ منه","لِخديجٍ وحبّذا الإنثناءُ",30,"ا",2,0],["فأنثنى منصرفا آيسا","من عمل يختص بالفاعل",31,"ل",1,0],["فانثنى عنى على أن يستبين","أنني في حبّه الروح الأمين",32,"ن",1,0],["فانثنت تبعث اللقاء كما يبعد عن","مطلب الكريم النجاح",33,"ح",1,0],["فاِنثَنى عنها مقرّاً أَنَّ في","أَنفهِ الرغمَ وفي فيه الرغاما",34,"م",2,0],["فانثني غير هياب ولا وجل","أصيح بين خيالاتي واغوالي",35,"ي",1,0],["فَانثَنَوا بَعدَ مِصاعٍ صَادقٍ","كَسَّرَ الدَّرعَ وَفَضَّ القَونَسَا",36,"س",2,0],["فَإِنَّ ثَناءً أَنتَ تَذخَرُهُ مِنّي","يَفوقُ ثَراءً أَنتَ تَذخَرُهُ عَنّي",37,"ي",1,1],["فَأَنثَني بَعدَ الدُعا قائِلاً","سُبحانَ مَن يُحيي العِظامَ الرَميم",38,"م",1,0],["فإنَّ ثنائي واعتِقادي وطاعتي","لأفلاكِ ما أولَيْتَنِيهِ مراكِزُ",39,"ز",1,0],["فأنثني لستُ أدري أين مُنقَلَبي","كأنني حائرٌ في اللّيلِ مُعتَسِفُ",40,"ف",1,0],["فأنْثَنِي ودُموعي مِن جَوى كَبِدِي","تَفيضُ فاعجب لماءٍ فاضَ من نارِ",41,"ر",1,0],["فانثنت أغصانها مائسةً","طرب النشوان راحت تتأوَّد",42,"د",1,0],["فأَنْثَنِي تِيهاً بلقياكُمُ","قد ضَاقَ بي أَوْسَعُ أَثوابي",43,"ي",1,0],["فانْثَنَتْ تُنْثَرُ من أَنْجُمِهِ","دُرَرٌ لولا العُلَى لم تُنْظَمِ",44,"م",1,0],["فأنثني ومهجتي","نهْبَ جيوشِ الكمَدِ",45,"د",1,0],["فإنّ ثغور الروم تحنو تشوقا","اليك فبادرها بقطع المسالك",46,"ك",1,0],["فاَنثنىْ القلبُ مُذْ رآها جريحاً","يتقطر دماً كماء الدوالي",47,"ي",1,0],["فأنثَني للهيبِ الشوقِ في كَبِدي","نضّاخُ دمعٍ لنارِ الشوقِ نَضّاحا",48,"ح",2,0],["فأنثني وقد تروَّتْ","مِن دموعي الأربٌعُ",49,"ع",1,0],["فان ثبتت حقاً على جريمة","بروحي ومالي في الهوى اتجرم",50,"م",1,0]]}