{"poems":[[88,"بنات الشعر بالنفحات جودي","https://www.aldiwan.net/poem10690.html","الوافر"],[73,"بقدكما إن شئتما فتطاعنا","https://www.aldiwan.net/poem3964.html","الطويل"],[58,"أخا الرأي التدبير لا تركب الهوى","https://www.aldiwan.net/poem58582.html","الطويل"],[69,"قد خص بالفضل قطليجا وأيدمر","https://www.aldiwan.net/poem18064.html","البسيط"],[69,"ثكلت طوائف المستخدمينا","https://www.aldiwan.net/poem18120.html","الوافر"],[50,"منحتكم يا أهل مصر نصيحتي","https://www.aldiwan.net/poem62427.html","البسيط"],[48,"أقيمي لا أعد الحج فرضا","https://www.aldiwan.net/poem22042.html","الوافر"],[53,"يا أيها المرء الكريم والدا","https://www.poetsgate.com/ViewPoem.aspx?id=27704",""],[119,"اخا الاشجان حي على الفلاح","https://www.aldiwan.net/poem41176.html","عموديه"],[173,"ألم يأن أن تنسى عسى ولعلما","https://www.aldiwan.net/poem1665.html",""],[266,"هو المجد ما يقظانه مثل نائم","https://www.aldiwan.net/poem38191.html","الطويل"],[327,"عليك بكل ذي حسب ودين","https://www.aldiwan.net/poem56336.html","الوافر"],[463,"أجدك بعد أن ضم الكثيب","https://www.aldiwan.net/poem56288.html","الوافر"],[469,"أرى سيرها عنقاً أو خيدا","https://www.aldiwan.net/poem3276.html","عموديه"],[520,"مل وقد ملت إلى وداده","https://www.aldiwan.net/poem12065.html","الرجز"],[534,"يا حبذا كلام","https://www.aldiwan.net/poem37445.html","مجزوء الرجز"],[580,"","https://poetry.dctabudhabi.ae/diwan/poem/47764","الهزج"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90552","السريع"],[287,"","https://poetry.dctabudhabi.ae/diwan/poem/69871","الطويل"],[1157,"","https://poetry.dctabudhabi.ae/diwan/poem/102921","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64679","الوافر"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102565","الوافر"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104682","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89299","المجتث"],[3519,"","https://poetry.dctabudhabi.ae/diwan/poem/145127","المتقارب"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133264","الوافر"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83191","الرجز"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66184","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58076","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58162","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72437","المتقارب"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113822","البسيط"],[5756,"قدها وقدود","https://www.poetsgate.com/ViewPoem.aspx?id=5439",""],[5873,"تباريح الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=215466",""]],"verses":[["وَلا تُثقِل مَطاهُ بِمُستَشارٍ","يَحيدُ بِهِ عَنِ القَصدِ الحَميدِ",0,"د",1,0],["وَلا تُثقِلا خَصرَيكُما بِمُهَنَّدٍ","فَفي كُلِّ جَفنٍ مِنكُما حَدُّ مُرهَفِ",1,"ف",1,0],["ولا تَثِقَنْ بالغانِياتِ وإنْ وَفَتْ","وَفاءُ الغَواني بالعُهُودِ مِنَ الغَدْرِ",2,"ر",1,0],["ولا تَثِقْ بِوَفاءٍ مِنْ أَخِي حُمُقٍ","فالحُمْقُ دَاءٌ عَياءٌ بُرْؤُه عَسِرُ",3,"ر",1,0],["ولا تُثْبَتْ لهُمْ عُسْراً إذَا مَا","غَدَتْ ألْزامَهُ مُتَمَوِّلِينا",4,"ن",2,0],["وَلا تَثِبوا وَثبَ السِفاهِ فَتَركَبوا","عَلى حَدِّ حامي الظَهرِ غَيرِ رَكوبِ",5,"ب",1,0],["وَلا تَثِقي بِما صَنَعوا وَصاغوا","فَقَد جاءَت خُيولُهُمُ تَبارى",6,"ر",2,0],["ولا تُثر من عَتبهُ الأساودا","ليس بأن تمنعه المرافدا",7,"د",2,0],["ولا تثقل علي العذل اني","يعوقني اللطيف من الرياح",8,"ح",1,0],["وَلا تَثنِ عِطفاً لِلدِيارِ وَكُن فَتىً","يَهُمُّ فَيَمضي في المُهِمّاتِ مُقدِما",9,"م",2,0],["ولا تثبت الأقوال بعض صفاتكم","ولا تثبت الأقوام عند التقاوم",10,"م",1,0],["وَلا تَثِقَنَّ بِالنَمّامِ فيما","حَباكَ مِنَ النَصيحَةِ في الخَلاءِ",11,"ا",2,0],["ولا تُثْلِمْ ودادَك لي بغَدرٍ","فقد يتثلَّم النسبُ القريبُ",12,"ب",1,0],["ولا تثقوا بوفاق الجمال","فإن له بعد وصل صدودا",13,"د",2,0],["ولا تثق بكل من صحبته","مالم تحل عقدة اعتقاده",14,"د",2,0],["ولا تَثِقْ بِما زَبَرْ","في شَأْنِها ابنُ حَجَرْ",15,"ر",1,0],["ولا تثنيهم الأَقفا","ل عنها والمساميرْ",16,"ر",1,0],["ولا تثق قبل بُدُوِّ الصلاح","واحذَر وكن ذا عبرةٍ وافتكار",17,"ر",1,0],["وَلا تَثنِياها عَن ثَنِيّاتِ حاجِرٍ","وَإِن راعَها جَذبُ البُرى فَبَراها",18,"ا",3,0],["ولا تثقن بالأزد فالغدر منهم","وبكر فمنهم مستحل المحارم",19,"م",1,0],["ولا تَثِقَنْ بها وأَقِلْ بَنيها","جَرائِمَ ضَيَّقَتْ سَعَةَ الرِّحابِ",20,"ب",1,0],["ولا تثني عليه سوى بخير","فانّ اللَه يعلم ما تكنه",21,"ن",2,0],["ولا تثنيت إذ مر الصبا سحراً","إلا لعبت بقلبي يا أثيلات",22,"ت",1,0],["ولا تثق بكثيرٍ","منهم ولا بقليلِ",23,"ل",1,0],["ولا تثقي بمواعيدهم","فكم جر موعدهم من ندامه",24,"م",2,0],["ولا تثقل كواهلنا بدين","كثيرا كان أم ساوى الجراما",25,"م",2,0],["وَلا تَثِق بَعدُ بِوُدِّ صاحِب","فَوُدُّهُ صارَ كَأمسِ الذاهِبِ",26,"ب",1,0],["ولا تُثْقِلِيني بالمَلامِ عَلَى النَّدى","فَما يَسْتَوِي فِعْلٌ حَمِيدٌ ومَنْكُورُ",27,"ر",1,0],["ولا تَثِقَنْ بالغانيات وإن حكت","شموساً عليها أدرعٌ وبراقع",28,"ع",1,0],["ولا تَثْنِهم في الله لومةُ لائم","بهم ظهرَ الإسلامُ يوماً وأعلنا",29,"ن",2,0],["ولا تثن عنها عنان المطيَّ","إلى غيرها رائدا للخصاب",30,"ب",1,0],["ولا تثق بكذوب خاسر أبدا","مثل السراب كثير المكر والحيل",31,"ل",1,0],["ولا تثّر بي البسمة ولا كحل العيون السود","ولا يقوى على قلبي صغير الحسد وأجسامه",32,"م",2,0],["ولا تثني عن الحقِّ البلايا","إذا ما آثر القلب الرشادا",33,"د",2,0]]}