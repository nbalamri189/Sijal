iewPoem.aspx?id=51957",""],[5848,"من يد ما نعدمها","https://www.poetsgate.com/ViewPoem.aspx?id=50614",""],[5848,"تعريف الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=51958",""],[5943,"أكثرْ من اللذات","https://www.poetsgate.com/ViewPoem.aspx?id=92977",""],[5952,"اكثر الغرس","https://www.poetsgate.com/ViewPoem.aspx?id=200340",""],[5956,"أنا في الصين الجميلة ‏","https://www.poetsgate.com/ViewPoem.aspx?id=181869",""],[5956,"غداً يحِلُّ الصيف","https://www.poetsgate.com/ViewPoem.aspx?id=183180",""],[6198,"معطف الزمان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79321&r=&rc=95",""],[6259,"عصرت معدا معك الأناة ُ المعصرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59379&r=&rc=27",""],[572,"أكثرَ الإحْسانَ أعدا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9176&r=&rc=33",""]],"verses":[["أَكثَبتَ حَتّى أَقصَدَتكَ سِهامُهُم","قَد كُنتُ عَن أَمثالِها أَنهاكا",0,"ك",2,0],["أَكثَرُ ما يَلقَينَني ساهِراً","ما بَينَ أَعرافٍ وَأَكتادِ",1,"د",1,0],["أَكثَرتُ شِعري وَلَم أَظفَر بِحاجَتِهِ","فَسَقَّني قَبلَ أَن تَفنى الأَغاريدُ",2,"د",1,0],["أَكثَرتُمُ التَصفيقَ في مَوطِنٍ","كانَ البُكا فيهِ بِنا أَليَقا",3,"ق",2,1],["أَكثَرتَ مِن ذِكرِ الإِلَهِ تَوَرُّعاً","وَزَعَمتَ أَنَّكَ مُرسَلٌ وَأَمينُ",4,"ن",1,0],["أَكثِروا النُزهَةَ في أَحيائِنا","وَرُبانا إِنَّها تَشفي السَقاما",5,"م",2,0],["أكثر الناس يكدحون لقوم","قعدوا في قصورهم والعَلالي",6,"ل",2,0],["أُكَثِّرُ أَهلي مِن عِيالٍ سِواهُمُ","وَأَطوي عَلى الماءِ القَراحِ المُبَرَّدِ",7,"د",1,0],["أكثرتُ من معروفه","إذ لم يقل رجل تَزوَّدْ",8,"د",1,0],["أكثرُ شكوى ضيفِهِ أَنَّه","يُغَبُّ بالبِرِّ على كُرْهِهِ",9,"ه",2,0],["أكثَرتِ هَجري غَيرَ أَنَّك رُبَّما","عَطَفَتكِ أَحيانا عَليّ أُمورُ",10,"ر",1,1],["اكثر الناس ينزعون الى الشر وقد","يبدو الشر في الكلمات",11,"ت",1,0],["أَكثَرَت ضَجَّةَ السَواقي عَلَيهِ","وَسُؤالَ اليَراعِ عَنهُ بِهَمسِ",12,"س",1,0],["أَكثَرتَ مِن بَذلِ النَوالِ وَلَم تَزَل","عَلَماً عَلى الإِفضالِ وَالإِنعامِ",13,"م",1,0],["أَكثَرتَ عَن مُترَفي مِصرَ السُؤالَ وَلَن","تَلقى ثَموداً بِواديها وَلا عادا",14,"د",2,0],["أَكثَرتِ لَومي وَتَناوَلتِني","تَبغينَ أَن أَتلَفَ فَاِستَغفِري",15,"ر",2,0],["أَكثَرَ لَومي عَلى هَواها","رَكبٌ عَلى دِمنَةٍ وُقوفُ",16,"ف",1,0],["أَكثَرُ الإِشفاقِ يُرجى نَفعُهُ","بَعدَ أَن تَطرِحَ الخِلَّ الشَفَق",17,"ق",1,0],["أَكثَرتَ في لَومِ المُحِبِّ فَأَقلِلِ","وَأَمَرتَ بِالصَبرِ الجَميلِ فَأَجمِلِ",18,"ل",1,1],["أَكثَرُ هَذي الخُطوبِ أَشكالُ","وَيُعقِبُ الاِنصِرافُ إِقبالُ",19,"ل",1,1],["أَكثَرُ النَيلِ ضائِعٌ غَيرَ ما يَس","ري إِلى نابِهِ الثَناءِ مُذاعِه",20,"ع",2,0],["أَكثَرتَ في طَلَبِ الغِنى لَعِباً","وَغِناكَ أَن تَرضى عَنِ الدَهرِ",21,"ر",1,0],["أَكثَرَ موسى غَيظَ حُسّادِهِ","وَزَيَّنَ الأَرضَ بِأَولادِهِ",22,"د",2,1],["أَكثَرتُ في شِعري عَلَيكِ مِنَ الرُقى","وَضَرَبتُ في شِعري لَكِ الأَمثالا",23,"ل",2,0],["أَكثَرتُ قَتلَ بَني بَكرٍ بِرَبِّهِمِ","حَتّى بَكَيتُ وَما يَبكي لَهُم أَحَدُ",24,"د",1,1],["أَكثَرتَ مِن ذِكرِ الفَتاءِ وقَلَّما","تُعْطي لذي الذّكَرِ الفتاةُ قيادا",25,"د",2,0],["أَكثَرَ الأَرضِ زائِراً وَمَزوراً","وَصَعوداً مِنَ الهَوى وَصَبوبا",26,"ب",2,0],["أكثرُ وطءِ الناسِ مِنْ شُبْهةٍ","أو مِنْ زنا والحلُّ فيهم قليلْ",27,"ل",1,1],["أَكثَرُ الناسِ بِالمَمالِكِ جَهلاً","مَن يَرى الجاهِلينَ لِلمُلكِ أَهلا",28,"ل",2,0],["أَكثَرتَ يا عاذِلي مِنَ العَذَلِ","إِنّي عَنِ العاذِلينَ في شَغَلِ",29,"ل",1,1],["أَكثَرُ وَصفي لَها شِكايَةُ ما","فيها قَضى اللَهُ لي عَلى راسي",30,"س",2,0],["أَكثِري أَو فَأَقِلّي","قَد مَلَلناكِ فَمَلّي",31,"ل",2,1],["أَكثَرُ ما بَينَنا الحَديثُ فَإِن","زِدنا فَزيدوا وَما لِذا ثَمَنُ",32,"ن",1,0],["أكثرُ ما يشغلُها سجدةٌ","لغُرّةِ الشمسِ إذا تشرقُ",33,"ق",1,0],["أَكثَرَت في القُربِ خُلفي","وَعَلى النَأيِ عِداتي",34,"ت",2,0],["أكثر الناس لا يرى غير ما كا","ن مريداً أَو ما يريه سواه",35,"ه",1,0],["أكثر الترب عظام","من ضلوع وصدورِ",36,"ر",1,1],["أكثرت من حزن عيوني بكاها","يا عيوني في الحزن ما أَبكاك",37,"ك",1,0],["أَكثرت مِن دَمعي عليه باكياً","وإذا كَثير الدمع غير كَثير",38,"ر",1,0],["أَكْثَرُ الجُودِ عَنْ هَوىً غَيْرَ أَنَّ ال","رَّيْبَ يَقْفُو مَسَالِكَ الأَهوَاءِ",39,"ا",2,0],["أكثِروا من دَمكمْ تَستَكثِروا","من فمِ التاريخ مجداً وابتهالا",40,"ل",2,0],["أَكْثَرَ النَّاسُ في النِّسَاءِ وَقالُوا","إنَّ حُبَّ النِّسَاءِ جَهْدُ الْبَلاءِ",41,"ا",2,1],["اكثروا العذل والملام وقلبي","كره العذل والملام وملّه",42,"ل",2,0],["اكثر الواشي له القو","ل وقد طاش المحرف",43,"ف",1,0],["اكثر الغمز في يبغي بان تب","غى بفصال طرفك الغماز",44,"ز",1,0],["أكثرُ الناس إذا ما كثرُ الم","الُ في كفيه في دنياهُ ضَلّْ",45,"ل",1,0],["أكثرُ من تَخبُرهُ من أهلهِ","يَظهرَ في دِين الوداد الواثقا",46,"ق",2,0],["أَكْثَرْتَ لَوْمِي بِغَيْرِ تَنْفيسِ","مَا أَنْتَ إِلا رَسُولُ إِبْلِيسِ",47,"س",1,1],["أكثرتُ فيها ولم أهجرْ بلاغتَهُ","وليسَ كثرةُ تكثيري من الفَشَلِ",48,"ل",1,0],["أكثَرتُ مِن لَيتَنِى لو كانَ يَنفَعُنِى","وَمِن مُنَى النَّفسِ لَو تُعطَى أَمانِهَا",49,"ه",2,0],["أَكثَرتُ مِن لَيتنِى لَو كَانَ يَنفَعُنِى","وَمِن مُنَى النَّفسِ لَو تُعطَى أَمانِيها",50,"ي",3,0],["أكثبانَ رملِ الظاهرية هل إلى","عَشِيّاتِك المستحسَناتِ سَبيلُ",51,"ل",1,1],["أَكثرُها معرّفاتٍ ذُكرت","وَجُلّ ما عندَ الجزولي نُكرت",52,"ت",1,0],["أكثيرةَ الشكوى حنانيكِ أهدأي","وترفّقي بالشاعر المنكودِ",53,"د",1,0],["أكثرُ ما يبذُلُ مِن وصلِهِ","لَثْمٌ على الكأسِ وتقبِيل",54,"ل",1,0],["أكثر عدد الصلاة والتسليم","في الدهر على النبيّ ذي التكريم",55,"م",1,0],["أَكثَرتَ فيمَن أَهوى مَلامَك","فَمَجَّ سَمعي فيهِ كَلامَك",56,"ك",1,1],["أكثرتَ رِفْدِي فأكثَرتُ التّفكُّرَ في","إحرازِه وأخو التّحصيلِ يَفتكِر",57,"ر",1,0],["أكثر ما بَيني وبينَ الهَوى","ما بَينَها من نَظرٍ شَزرِ",58,"ر",1,0],["أكثَرتَ عذلكَ لوْ وجدْتَ مُطيعَا","ونصحْتَ جهدَكَ لَو وجدتَ سَميعا",59,"ع",2,1],["أكثر الناسِ إذا جرَّ","بتَ جُهّالٌ وهوجُ",60,"ج",1,1],["أَكثرت جودك ثُمَّ قلت وَنَفسُ مَن","يهب النَفيس مِنَ العَطايا أَكثَرُ",61,"ر",1,0],["أكثر فيه العُذّلُ","جاروا ولمّا يَعدِلوا",62,"ل",3,0],["أكثر الناسُ من ندى يدك القو","لَ وسارت نعماك في الآفاقِ",63,"ق",1,0],["أكثرَ الناسُ في بنائك هذا ال","جسرَ مدحاً وأنت أعلى محلاّض",64,"ل",3,0],["أَكثَرتَ وَطأَكَ في قَصائِدِيَ الَّتي","لَو أَنَّها وَطِئَتكَ صِرتَ تُرابا",65,"ب",2,0],["أَكثَرَ ما عِندَهُم المَواهِبُ","كَأَنَّهُم أَيديهِمُ سَحائِبُ",66,"ب",1,0],["أكثَرْتُ نَوْحي والبُكاءَ فرقَّ لي","حِبِّي وقالَ إليَّ يا زَيْنَ الشِّيَمْ",67,"م",1,0],["أكْثروا الأنَّ والحنينَ اضْطِراماً","وبَكَوا لهْفةً ووجداً وناحوا",68,"ح",3,0],["أكْثَرُ ذا الْعَامِ صِرْتُ في سَفَرٍ","ومِثْلُ ذا للفُؤادِ قَدْ صَدَعا",69,"ع",2,1],["أكثَرَ الشكوى مَدمَعشي من فُؤَادي","وكَفى للطَّليقِ قَيدُ السَّجينِ",70,"ن",1,0],["أَكثَرتُما تَفنيدي","لَو يَنفَعُ التَفنيدُ",71,"د",1,0],["أكثرت يا أنت تقليباً وتلوينا","ساروا الحبائبْ وعنهم أنت تَلوِينا",72,"ن",2,0],["أكثَرتُ من مَدحِ الأميرِ فقالَ لي","أسرَفْتَ فاترُكْ فَضلةً لِسَوائي",73,"ا",2,0],["أَكْثَرَتْ مِنْهُ تَعَجُّبَهَا","وَهْيَ تَجْنِيْهِ وَتَعْجَبُ لَهْ",74,"ل",2,0],["أكثر ما توجب في المناظرة","الرأي والتدبير والمشاورة",75,"ه",1,0],["أكثر ما ينكره من يجهل","من قتل عثمان إذا ما سئلوا",75,"ل",3,0],["أكثر من قيامه وطلبه","لخذه والإنفراد منه به",75,"ه",1,0],["أكثرتَ في عَذلي وفي تَفنيدي","لَغواً لعمرُ أبيكَ غَيرُ مُفيدِ",76,"د",1,1],["أكثر المدح في الجمال قديماً","هو في حسنك الحديث اقل",77,"ل",1,0],["اكثر خلق الله من لا يدري","من أي خلق اللَه حين يلقى",78,"ا",1,1],["أكثرُ النّاس بها مَنْ تَلْقَهُ","بِكِلا الوصفين فيها عُرِفَا",79,"ف",2,0],["أَكثَروا من لومه وَهْوَ يُنا","دي ألا حسبُكمُ من لومنا",80,"ن",2,0],["أكثروا في جلالة الملك اللغْ","وَ وخاضوا في هذه القدسيه",81,"ي",2,0],["أَكثِرْ وَبالِغْ بِلا كَيلٍ وَلا زِنَةٍ","فَإِنّما البحرُ لَم يوزَن وَلم يُكَلِ",82,"ل",1,0],["أكثر ما فيه أن يقال لهم","لم يك في قوله بمنقطع",83,"ع",1,0],["أكثر اللائمون فيك عتابي","أنا واللائمون فيك فداكا",84,"ك",2,0],["أكثر العاذلون فيها ولكن","خرسوا عند نطق ذاك النطاقِ",85,"ق",1,0],["أَكثَرَ ما تَكتُبُهُ الأَقلامُ","لَم تَسعَ في زَوالِهِ الأَيّامُ",86,"م",1,1],["أكْثَرْتَ في العَذْلِ مُلِحّاً دائِما","لا تُكْثِرَنْ إِنِّي عَسَيْتُ صائِما",87,"م",2,1],["أكثر من تراهم أغمار","وإن تنفست بهم أعمار",88,"ر",1,0],["أكثرهم نفعاً رسول الله","النعمة العظمى عظيم الجاه",89,"ه",1,0],["أكثرهم عن الصواب زور","دعواهم باطلة وزور",90,"ر",1,0],["أَكثرت من نهب المَكارِم ياسنا","النادي ترفق أَيهذا المنهب",91,"ب