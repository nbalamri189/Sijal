ل"],[404,"ولأهل هذي الهجرتين من الأذى","https://www.aldiwan.net/poem33397.html","الكامل"],[410,"ما استجهلتك معالم ورسوم","https://www.aldiwan.net/poem32386.html","الكامل"],[417,"أترى في الوجود مثلك عالم","https://www.aldiwan.net/poem54119.html","الخفيف"],[417,"أنا في هواكم مطلق ومقيد","https://www.aldiwan.net/poem54136.html","الكامل"],[433,"ما ضر ذاك الريم ألا يريم","https://www.aldiwan.net/poem12725.html","السريع"],[433,"هبهم رضوا غير قلبه وطنا","https://www.aldiwan.net/poem12755.html","المنسرح"],[450,"النكسة","https://www.aldiwan.net/poem994.html",""],[453,"ويا ليلة أفنيت فاحم نفسها","https://www.aldiwan.net/poem13650.html","الطويل"],[454,"تمهل أمام الماء حين ابتسامه","https://www.aldiwan.net/poem61235.html","الطويل"],[459,"ياابنة القوم تراك","https://www.aldiwan.net/poem56083.html","مجزوء الرمل"],[464,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[465,"أعجبت من خد صفا وتلهبا","https://www.aldiwan.net/poem3445.html","عموديه"],[465,"أما واللمى وجداً بساكنه الملا","https://www.aldiwan.net/poem3589.html","عموديه"],[465,"أقل عنائي أنني فيه هائم","https://www.aldiwan.net/poem3633.html","عموديه"],[467,"يقول بصحراء الضبيب ابن بوزل","https://www.aldiwan.net/poem50462.html","الطويل"],[496,"حديقة الجو غضي هذه الحدقا","https://www.aldiwan.net/poem10251.html","البسيط"],[516,"ما كنت آلف منزلي إلا به","https://www.aldiwan.net/poem12027.html","الكامل"],[516,"سأبكي على ابني مدتي وحياتي","https://www.aldiwan.net/poem12039.html","الطويل"],[516,"أأرجو بقاء أم صفاء حياة","https://www.aldiwan.net/poem12043.html","الطويل"],[539,"عبد السلام ببلدة الحمراء","https://www.aldiwan.net/poem48306.html","عموديه"],[554,"لاينتها باختلاس اللحظ فانخشعت","https://www.aldiwan.net/poem68383.html","البسيط"],[554,"اهلا بكيت ظعائنا وحمولا","https://www.aldiwan.net/poem68428.html","الكامل"],[565,"تحمل في الهوى ما لا يطاق","https://www.aldiwan.net/poem876.html",""],[568,"داو خماري بكأس خمر","https://www.aldiwan.net/poem69458.html","مخلع البسيط"],[581,"أتجحد ما في الريح من أنة الحزن","https://www.aldiwan.net/poem25195.html","عموديه"]],"verses":[["أَتبَعتُهُم نَظَراً تَدمى أَواخِرُهُ","وَقَد رَمَلنَ عَلى رَملِ العَقيقِ ضُحى",0,"ح",2,0],["أَتَبكونَ مِن جَزَعٍ وَالبُكاءُ","تُكَرِّمُ عَنهُ عَيونُ الرِّجالِ",1,"ل",1,0],["أَتَبكي عَلى لُبنى وَأَنتَ تَرَكتَها","وَأَنتَ عَلَيها بِالمَلا أَنتَ أَقدَرُ",2,"ر",1,0],["أَتبع جَمالَكَ بِالجَميلِ لَنا","ما أَليَقَ الإِحسانَ بِالحُسنِ",3,"ن",1,0],["أَتْبَعْتُ في دين الصبابة أمّةً","ما بدّلوا في حبّهم تبديلا",4,"ل",2,0],["أتبعتها غُرَرَ الجياد كواكباً","تنقضُّ رجماً في سماء غُبارِ",5,"ر",1,0],["أتبغون في تلفيقها نفع واحد","وتغضون عن اضرارها ألف واحد",6,"د",1,0],["أتُباع أفئدة النساء كأنها","بعض المتاع وهنّ في عهد الصبا",7,"ب",2,0],["أَتبَعتُهُم مُقلَةً إِنسانُها غَرِقٌ","هَل يا تُرى تارِكٌ لِلعَينِ إِنسانا",8,"ن",2,0],["أَتَبتَغي التَيمُ عُذراً بَعدَما غَدَروا","لا يَقبَلُ اللَهُ مِن تَيمٍ إِذا اِعتَذَروا",9,"ر",3,0],["أَتَبيتُ لَيلَكَ يا اِبنَ أَتأَةَ نائِماً","وَبَنو أُمامَةَ عَنكَ غَيرُ نِيامِ",10,"م",1,1],["أتبغي إلى الشُنع التي فيك سادساً","وفيك من السَوءاتِ خمسُ خصالِ",11,"ل",1,0],["أتبعِ الكفَّ ساعداً قلّما مث","لُكَ أسدى يداً بلا استكمالِ",12,"ل",1,0],["أتبهجُنِي نعماءُ دهرٍ حماكِها","وأشكرُ ما أَعطَى وأنتِ الذي حرمْ",13,"م",1,0],["أتبلغُ أقدارُ الدراهم أنْ تُرى","تُباريكَ في هجرِ الذين تُراغمُ",14,"م",1,0],["أَتَبْخلُ بالقرطاسِ والخطِّ عن أخٍ","وكفَّاك أنْدَى بالعطايا من المُزنِ",15,"ن",1,0],["أتبعتُ جَدبَك طَوْعي لا كذي خطَل","ممن تقاعسَ إذ جاذبتَه القَرنا",16,"ن",2,0],["أَتَبكينَ آمالُكِ الضائِعاتِ","هَلِ الريحُ مِثلَ الوَرى تَأمُلُ",17,"ل",1,0],["أَتبَعتُ آثارَهُم عَيناً مُعَوَّدَةً","سَبقَ العُيونِ إِذا اِستُكرِهنَ بِالنَظَرِ",18,"ر",1,0],["أتبعدُ حتى ليس في العَتْبِ مطمعٌ","وتُعرِضُ حتى ما تكادُ تُرامُ",19,"م",1,0],["أَتُبذَلُ لي حُورُ الجِنانِ نَسِيئَةً","وتُؤخذُ نَقْداً من ورائي وفي خِدْري",20,"ر",2,0],["أَتُبَكّي مَن لا يُنازِلُ بِالسَي","فِ مُشيحاً وَلا يَهُزُّ اللِواءَ",21,"ا",2,0],["أَتَبعُدُ حاجَتي وَإِلَيكَ قَصدي","بِها وَعَلى عِنايَتِكَ اِعتِمادي",22,"د",2,0],["أَتَبعُدُ حاجَتي وَإِلَيكَ قَصدي","بِها وَعَلى عِنايَتِكَ اِعتِقادي",23,"د",2,0],["أَتبَعتَهُ العِجلِيَّ ثُمَّ رَفَدتَهُ","بِالكَوتَكينَ مُكاتِفاً وَمُعاضِدا",24,"د",2,0],["أَتبَعنَ عَبدَ اللَهِ رِمَّةَ أَحمَدٍ","وَالنَقعُ يَتبَعُهُنَّ هَيجُ مُثارِهِ",25,"ر",2,0],["اِتبَع هَواكَ إِلى الحَبيبِ فَإِنَّهُ","رَشَدٌ وَخَلِّ لِعاذِلٍ أَن يَعذُلا",26,"ل",2,0],["اِتَّبِعها فَقَد رَأَيتَ عِياناً","أَثَرَيها عَلى العِدى وَالعَديمِ",27,"م",1,0],["أَتَبكي اِمرَأً مِن أَهلِ مَيسانَ كافِراً","كَكِسرى عَلى عِدّانِهِ أَو كَقَيصَرا",28,"ر",2,0],["أتبعْتُها نَفَسَ المحبِّ تضرَّمَتْ","أحشاؤُه لتَفرُّقِ الأحبابِ",29,"ب",1,0],["أتبعْتُها نَظَرَ المَشُوقِ تجمَّعتْ","زَفَراتُه لتَفرُّقِ الأترابِ",29,"ب",1,0],["أَتَبكي لِهَذا المَوتِ أَم أَنتَ عارِفُ","بِمَنزِلَةٍ تَبقى وَفيها المَتالِفُ",30,"ف",1,1],["أَتَبذُلُ دونَ وَجهِكَ ماءَ وَجهي","وَتَمحو بِاِسمِ شَرَّكَ ذِكرَ خَيري",31,"ر",2,0],["أَتبَعتَ قَلبي لَوعَةً كانَت أَسىً","تَبِعَت أَماني مِنكَ كانَت زُخرُفا",32,"ف",2,0],["أَتُبغِضُ جَوهَرَ العَرَبِ المُصَفّى","وَلَم يُبغِضهُمُ مَولىً صَريحُ",33,"ح",1,0],["أَتَبَاهَى بِهِ إِذَا كَانَ غَيْرِي","يَتَبَاهَى بِزِينَةِ الإِنْعَامِ",34,"م",1,0],["أَتبَعتُهُم مُقلَةً مَدامِعُها","مِنها بِماءِ الشُؤونِ تَستَبِقُ",35,"ق",1,0],["أَتبَعتُهُ قَلباً لَهُ مِن لَوعَةٍ","زادٌ وَمِن عَينٍ تَفيضُ مَزادُ",36,"د",1,0],["أَتبَعتُ فيهِ وَقَد بَكيتُ","عَقيقَ خَدِّكَ دُرَّ ثَغرِك",37,"ك",1,0],["أَتَبكي عَلى لَيلى وَنَفسُكَ باعَدَت","مَزارَكَ مِن لَيلى وَشِعباكُما مَعا",38,"ع",2,1],["أَتَبِيتُ أولى القِبْلَتَيْنِ حَزينةً","وأَبِيتُ وَسْنانَ الجُفونِ مُنعّما",39,"م",2,0],["اتبَعوا الجِدَّ وَاِعصِبوها بِرَأسي","حَسبُكُم ما مَضى مِنَ الدَهرِ هَزلا",40,"ل",2,0],["أتبقى قلوبُ النّاسِ في ظُلماتها","تَظاهرُ أكنانٌ عليها وأقفال",41,"ل",1,0],["أتبعتَ نفسَكَ ما ملكتَ فمهجةٌ","تَنهالُ طيّعةً وكَفُّ تَهطلُ",42,"ل",1,0],["أَتَبكي عَلى جَبر وَحَولك جنده","عَزاؤك فيمن راحَ حَولك وَاِغتَدى",43,"د",2,0],["أَتبَعتُهُ جَوانِحي","مُهجَتي عِندَما نَفَر",44,"ر",1,0],["أَتباعُ إِمرَةٍ وَأَسرى هُدهُدِ","إِن حَضَروا لَم يُكرَموا في المَشهَدِ",45,"د",1,0],["أتْبَعْتُهُ فِكَري حتى إذا بَلَغتْ","غاياتِها بين تصْويبٍ وتصعيد",46,"د",1,0],["إِتبَع طَريقاً لِلهُدى لاحِباً","وَخَلِّ آثاراً بِمَلحوبِ",47,"ب",1,1],["أَتَبغَينَ مِنّي في المَقالِ تَعَصُّباً","وَأَيُّ أَذاةٍ ما عَصَبتِ بِراسي",48,"س",2,0],["اِتْبَعْ وصاياه فيما لا يَحِلُّ لكم","ولا يَليقُ بكم مِن سيِّئ العَمَلِ",49,"ل",1,0],["أتُبقين حقاً على ما بها","متى أنتِ أبقيتِ شيئاً متى",50,"ت",2,0],["أتبْصِرُهُ جسداً عارياً","وتقربهُ تلك إحدى الكُبرْ",51,"ر",1,0],["أتُبْصِرُ ناراً أُوقِدَتْ لخُوًيْلِدٍ","ودونَ سَناها للنجائبِ إرْقال",52,"ل",1,0],["اِتبَعيني تَرَي دِماءَ الأَعادي","سائِلاتٍ بَينَ الرُبى وَالرِمالِ",53,"ل",1,0],["أَتْبَعْتُهُمْ نَظَرَاتٍ كُلَّمَا بَلَغَتْ","أُخْرَى الْحُمُولِ ثَنَاهَا مَدْمَعٌ هُتُنُ",54,"ن",1,0],["أَتُبْطِيءُ مِصْرٌ عَنْ ثَوَابِ وَزِيرِهَا","وَمَا عَهْدُهُ إِلاَّ نَدىً وَفَلاَحُ",55,"ح",1,0],["أَتَبِينُ عَنَّأ يَا عَلِيُّ","وَكُلُّنَا يَبْكِي بِعَادَكْ",56,"ك",1,0],["أَتْبصِرُ مِنْ سَمَاءِ الشَّرْقِ طَيْرَاً","تَوَافَدُ فِي إِئْتِلاَفٍ وَائْتِلاَقِ",57,"ق",1,0],["أَتبِع بَني عَبدِ شَمسٍ أَمرَ صاحِبِهِم","أَهلي فِداؤُكَ إِن ضَرّوا وَإِن نَفَعوا",58,"ع",3,0],["أتبسمت بعد صمت رهيب","كان يدوي في مسمعيا دويا؟",59,"ي",2,0],["أتبعد والآمالُ دانٍ قطوفها","ولا تحصُد الحبّ الذي أنت باذره؟",60,"ر",2,0],["أتبرَّضُ الماء الزُّلالَ . وغُنيتي","كِسَرُ الرَّغيفِ مَطاعماً ومَشاربا",61,"ب",2,0],["أتبكِي عَلَى لُبْنَى وأنتَ تركتَها","؟ وكُنْتَ عليهَا بالملاَ أنتَ أقدرُ",62,"ر",1,0],["أتبعتهم مقلة ً مدامعها","مِنْهَا، بِمَاءِ الشُّونِ تَسْتَبِقُ",63,"ق",1,0],["أتبكين ؟ لا … لا ومن تؤسفين","إذا أنت مقهورة أو أسيفه",64,"ف",2,0],["اتبع الكُتب بَعضَها أَثر بَعض","فَلَعَلي أَشفي بِها أَحداقي",65,"ق",2,0],["أَتَبعثُ الموتى ولا ترعوي","يا أيُّها العابثُ بينَ اللُحود",66,"د",1,0],["اتَبعتُ بِالهِجَاءِ لَنَا ألَمَّا","تُمَيِّز بَينَ لَيلِكَ والنَّهَارِ",67,"ر",1,0],["أَتَبغونَ قَتلاً لِلنَبِيَّ مُحَمَّدٍ","خُصِصتُم عَلى شُؤمٍ بِطولِ أثامِ",68,"م",1,0],["أتبِّعها نظرا معجَلا","يعثِّر عينى بهُدّابها",69,"ب",3,0],["أتبيع دينك في الضلال بجرعة","قُبِّحتَ بطّالاً زمان المتجر",70,"ر",1,0],["أتَبكي حسرةً وأنا المُعنىَ","وترفع رنّةً وأنا الغريبُ",71,"ب",1,1],["أَتبَعتُهُم طَرفَ عَينٍ جالُها غَرِقٌ","هَاجَ احتمِالُهُم من دَمعِها سَرَبا",72,"ب",2,0],["أَتبَعتُهُم دَوسَراً رَحبَ الفُرُوجِ تَرَى","فى حَدِّ مِرفَقِهِ عَن زَورِهِ حَنَبَا",72,"ب",2,0],["أتبعتهم نظري وفرّق بيننا","بعد المدى وجد النوى الوجدا",73,"د",2,0],["اِتّبع واِسلُك سبيلَ الحُنَفا","مَن سَعى في نَهجهم لم يفتنِ",74,"ن",1,0],["أَتَبغي بِاعتِمادِكَ ذُخرَ أَجرٍ","وَأَنتَ لِسُوءِ فِعلِكَ بي أَثيمُ",75,"م",1,1],["أتبعتهمْ نفساً عليكَ عزيزةً","وطويتَ جنبيها على الآلامِ",76,"م",1,0],["أتبخل إذ وجبت حرمتي","ومن قبلُ جُدتَ ولم تبخلِ",77,"ل",1,0],["أتبكي ماهراً وبه تراخت","إليك أعنّة الحكم الجموح",78,"ح",1,1],["إِتبَعيني يا فَتاتي","وَاِبخلي بِالعبراتِ",79,"ت",1,0],["إِتبَعيني إِتبَعيني","فَدُموعي وَجُفوني",79,"ي",1,0],["إِتبَعني إِتبَعني","فَدُموعي وَجُفوني",79,"ي",1,0],["أَتَبحَثُ عنه في وادٍ","وَمنهُ الكونُ مَلآنُ",80,"ن",1,0],["أَتْبَعْتُهُمْ من دُموعي كُلِّ مُنهمِر","يُرْضي الغَرامَ وإنْ لَمْ تَرْضَهُ المُقَلُ",81,"ل",1,0],["أتبعتُهمْ من أدمعي ما لو غدا","مَطَراً لروَّى عِيسَهم والبلقعا",82,"ع",2,0],["أتبقي على ذبيان في قتل مالكٍ","فقد حشَّ جاني الحرب ناراً تضرمُ",83,"م",1,0],["أتُبدينَ التجلّدَ في جلادٍ","وقد أرسَلتِ طَرفَك لي سفيرا",84,"ر",2,0],["أتُبدي الغنجَ كي أُبدي هُيامي","وكي يَغلي دَمي تُبدي فُتُورا",84,"ر",2,0],["أتبكي الكريماتُ الأُصولِ قصائِدي","وأنتِ ضحوكٌ من تألُّم شاك",85,"ك",1,0],["أتبكي لأجلي بنتُ أشرفِ قومها","وتضحكُ منى في النّوى بنتُ بقّال",86,"ل",1,0],["أَتَبْرِينِي يَدٌ راشَتْ جَناحِي","وَيَحْسِمُنِي نَدَىً هُوَ لِي حُسامُ",87,"م",1,0],["أَتَبخَلونَ بِالخِيارِ خِسَّةً","عَلى أُناسٍ نَزَلوا بِدارِكُم",88,"م",1,1],["أَتبَعَ ذُلّاً تُبَّعاً وَقَيصَرا","قَسراً وَكِسرى بِالسُيوفِ كَسرا",89,"ر",2,0],["أَتَبخَلُ تائِهاً شَرِهاً بِمالٍ","يَكونُ عَلَيكَ بَعدَ غَدٍ وَبالا",90,"ل",2,0],["أَتبَعتَهُم نَظَراتٍ خَلفَها كَبِدٌ","تُسايرُ الرَكبَ بَينَ الريثِ وَالعَجَلِ",91,"ل",1,0],["اتبكين هذي اماني الشباب","وهذي نفاثة قلبي الحزين",92,"ن",1,0],["أَتْبعتَ حَجَّتَك الحميدةَ غَزْ