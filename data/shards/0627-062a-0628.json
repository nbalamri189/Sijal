"الأعْراف","https://www.poetsgate.com/ViewPoem.aspx?id=28586",""],[5376,"أذودُ عن الحوض ِالمنيعِ برفعةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=188375",""],[5431,"وقدس العرب تختزلُ المآسي...","https://www.poetsgate.com/ViewPoem.aspx?id=190187",""],[5431,"وساده....","https://www.poetsgate.com/ViewPoem.aspx?id=201735",""],[5480,"العين والكاف","https://www.poetsgate.com/ViewPoem.aspx?id=31228",""],[5582,"أَلا ما لِدَمْعِكَ يَجْرِي طَلَلْ","https://www.poetsgate.com/ViewPoem.aspx?id=187236",""],[5616,"صاحب","https://www.poetsgate.com/ViewPoem.aspx?id=203236",""],[5616,"قاصمة الظهر","https://www.poetsgate.com/ViewPoem.aspx?id=203429",""],[5638,"اخسأ ولا تطغى أيا سلمي","https://www.poetsgate.com/ViewPoem.aspx?id=198250",""],[5648,"شموخ ذاتي","https://www.poetsgate.com/ViewPoem.aspx?id=154830",""],[5732,"قلبي نهبته","https://www.poetsgate.com/ViewPoem.aspx?id=177915",""],[5753,"كُن أنت","https://www.poetsgate.com/ViewPoem.aspx?id=204600",""],[5756,"الأم","https://www.poetsgate.com/ViewPoem.aspx?id=5181",""],[5776,"بحّار السماء","https://www.poetsgate.com/ViewPoem.aspx?id=199412",""],[5776,"آتٍ بعكسِ مجيئهِ الوقتُ","https://www.poetsgate.com/ViewPoem.aspx?id=199462",""],[5956,"الإعجابُ والحبّ","https://www.poetsgate.com/ViewPoem.aspx?id=182655",""],[5956,"عذرٌ أقبحُ من ذنب","https://www.poetsgate.com/ViewPoem.aspx?id=192180",""],[5956,"أَ تَبْكي يا مساءُ؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=194816",""],[5962,"يا عسر","https://www.poetsgate.com/ViewPoem.aspx?id=206599",""],[5975,"أتبردينَ ؟!!","https://www.poetsgate.com/ViewPoem.aspx?id=53408",""],[5977,"ثق بربك","https://www.poetsgate.com/ViewPoem.aspx?id=213279",""],[6108,"نفاق","https://www.poetsgate.com/ViewPoem.aspx?id=192750",""],[6142,"كم البيض بالأغماد حرى شفارها","https://www.poetsgate.com/ViewPoem.aspx?id=155749",""],[6152,"وجه الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=203179",""],[469,"أما واللمى وجدا بساكنة الملا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574809",""],[6259,"نفسي الفداءُ للحظها من رام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59400&r=&rc=48",""]],"verses":[["أَتبَعتُهُم نَظَراً تَدمى أَواخِرُهُ","وَقَد رَمَلنَ عَلى رَملِ العَقيقِ ضُحى",0,"ح",2,0],["أَتَبكونَ مِن جَزَعٍ وَالبُكاءُ","تُكَرِّمُ عَنهُ عَيونُ الرِّجالِ",1,"ل",1,0],["أَتَبكي عَلى لُبنى وَأَنتَ تَرَكتَها","وَأَنتَ عَلَيها بِالمَلا أَنتَ أَقدَرُ",2,"ر",1,0],["أَتبع جَمالَكَ بِالجَميلِ لَنا","ما أَليَقَ الإِحسانَ بِالحُسنِ",3,"ن",1,0],["أَتْبَعْتُ في دين الصبابة أمّةً","ما بدّلوا في حبّهم تبديلا",4,"ل",2,0],["أتبعتها غُرَرَ الجياد كواكباً","تنقضُّ رجماً في سماء غُبارِ",5,"ر",1,0],["أتبغون في تلفيقها نفع واحد","وتغضون عن اضرارها ألف واحد",6,"د",1,0],["أتُباع أفئدة النساء كأنها","بعض المتاع وهنّ في عهد الصبا",7,"ب",2,0],["أَتبَعتُهُم مُقلَةً إِنسانُها غَرِقٌ","هَل يا تُرى تارِكٌ لِلعَينِ إِنسانا",8,"ن",2,0],["أَتَبتَغي التَيمُ عُذراً بَعدَما غَدَروا","لا يَقبَلُ اللَهُ مِن تَيمٍ إِذا اِعتَذَروا",9,"ر",3,0],["أَتَبيتُ لَيلَكَ يا اِبنَ أَتأَةَ نائِماً","وَبَنو أُمامَةَ عَنكَ غَيرُ نِيامِ",10,"م",1,1],["أتبغي إلى الشُنع التي فيك سادساً","وفيك من السَوءاتِ خمسُ خصالِ",11,"ل",1,0],["أتبعِ الكفَّ ساعداً قلّما مث","لُكَ أسدى يداً بلا استكمالِ",12,"ل",1,0],["أتبهجُنِي نعماءُ دهرٍ حماكِها","وأشكرُ ما أَعطَى وأنتِ الذي حرمْ",13,"م",1,0],["أتبلغُ أقدارُ الدراهم أنْ تُرى","تُباريكَ في هجرِ الذين تُراغمُ",14,"م",1,0],["أَتَبْخلُ بالقرطاسِ والخطِّ عن أخٍ","وكفَّاك أنْدَى بالعطايا من المُزنِ",15,"ن",1,0],["أتبعتُ جَدبَك طَوْعي لا كذي خطَل","ممن تقاعسَ إذ جاذبتَه القَرنا",16,"ن",2,0],["أَتَبكينَ آمالُكِ الضائِعاتِ","هَلِ الريحُ مِثلَ الوَرى تَأمُلُ",17,"ل",1,0],["أَتبَعتُ آثارَهُم عَيناً مُعَوَّدَةً","سَبقَ العُيونِ إِذا اِستُكرِهنَ بِالنَظَرِ",18,"ر",1,0],["أتبعدُ حتى ليس في العَتْبِ مطمعٌ","وتُعرِضُ حتى ما تكادُ تُرامُ",19,"م",1,0],["أَتُبذَلُ لي حُورُ الجِنانِ نَسِيئَةً","وتُؤخذُ نَقْداً من ورائي وفي خِدْري",20,"ر",2,0],["أَتُبَكّي مَن لا يُنازِلُ بِالسَي","فِ مُشيحاً وَلا يَهُزُّ اللِواءَ",21,"ا",2,0],["أَتَبعُدُ حاجَتي وَإِلَيكَ قَصدي","بِها وَعَلى عِنايَتِكَ اِعتِمادي",22,"د",2,0],["أَتَبعُدُ حاجَتي وَإِلَيكَ قَصدي","بِها وَعَلى عِنايَتِكَ اِعتِقادي",23,"د",2,0],["أَتبَعتَهُ العِجلِيَّ ثُمَّ رَفَدتَهُ","بِالكَوتَكينَ مُكاتِفاً وَمُعاضِدا",24,"د",2,0],["أَتبَعنَ عَبدَ اللَهِ رِمَّةَ أَحمَدٍ","وَالنَقعُ يَتبَعُهُنَّ هَيجُ مُثارِهِ",25,"ر",2,0],["اِتبَع هَواكَ إِلى الحَبيبِ فَإِنَّهُ","رَشَدٌ وَخَلِّ لِعاذِلٍ أَن يَعذُلا",26,"ل",2,0],["اِتَّبِعها فَقَد رَأَيتَ عِياناً","أَثَرَيها عَلى العِدى وَالعَديمِ",27,"م",1,0],["أَتَبكي اِمرَأً مِن أَهلِ مَيسانَ كافِراً","كَكِسرى عَلى عِدّانِهِ أَو كَقَيصَرا",28,"ر",2,0],["أتبعْتُها نَفَسَ المحبِّ تضرَّمَتْ","أحشاؤُه لتَفرُّقِ الأحبابِ",29,"ب",1,0],["أتبعْتُها نَظَرَ المَشُوقِ تجمَّعتْ","زَفَراتُه لتَفرُّقِ الأترابِ",29,"ب",1,0],["أَتَبكي لِهَذا المَوتِ أَم أَنتَ عارِفُ","بِمَنزِلَةٍ تَبقى وَفيها المَتالِفُ",30,"ف",1,1],["أَتَبذُلُ دونَ وَجهِكَ ماءَ وَجهي","وَتَمحو بِاِسمِ شَرَّكَ ذِكرَ خَيري",31,"ر",2,0],["أَتبَعتَ قَلبي لَوعَةً كانَت أَسىً","تَبِعَت أَماني مِنكَ كانَت زُخرُفا",32,"ف",2,0],["أَتُبغِضُ جَوهَرَ العَرَبِ المُصَفّى","وَلَم يُبغِضهُمُ مَولىً صَريحُ",33,"ح",1,0],["أَتَبَاهَى بِهِ إِذَا كَانَ غَيْرِي","يَتَبَاهَى بِزِينَةِ الإِنْعَامِ",34,"م",1,0],["أَتبَعتُهُم مُقلَةً مَدامِعُها","مِنها بِماءِ الشُؤونِ تَستَبِقُ",35,"ق",1,0],["أَتبَعتُهُ قَلباً لَهُ مِن لَوعَةٍ","زادٌ وَمِن عَينٍ تَفيضُ مَزادُ",36,"د",1,0],["أَتبَعتُ فيهِ وَقَد بَكيتُ","عَقيقَ خَدِّكَ دُرَّ ثَغرِك",37,"ك",1,0],["أَتَبكي عَلى لَيلى وَنَفسُكَ باعَدَت","مَزارَكَ مِن لَيلى وَشِعباكُما مَعا",38,"ع",2,1],["أَتَبِيتُ أولى القِبْلَتَيْنِ حَزينةً","وأَبِيتُ وَسْنانَ الجُفونِ مُنعّما",39,"م",2,0],["اتبَعوا الجِدَّ وَاِعصِبوها بِرَأسي","حَسبُكُم ما مَضى مِنَ الدَهرِ هَزلا",40,"ل",2,0],["أتبقى قلوبُ النّاسِ في ظُلماتها","تَظاهرُ أكنانٌ عليها وأقفال",41,"ل",1,0],["أتبعتَ نفسَكَ ما ملكتَ فمهجةٌ","تَنهالُ طيّعةً وكَفُّ تَهطلُ",42,"ل",1,0],["أَتَبكي عَلى جَبر وَحَولك جنده","عَزاؤك فيمن راحَ حَولك وَاِغتَدى",43,"د",2,0],["أَتبَعتُهُ جَوانِحي","مُهجَتي عِندَما نَفَر",44,"ر",1,0],["أَتباعُ إِمرَةٍ وَأَسرى هُدهُدِ","إِن حَضَروا لَم يُكرَموا في المَشهَدِ",45,"د",1,0],["أتْبَعْتُهُ فِكَري حتى إذا بَلَغتْ","غاياتِها بين تصْويبٍ وتصعيد",46,"د",1,0],["إِتبَع طَريقاً لِلهُدى لاحِباً","وَخَلِّ آثاراً بِمَلحوبِ",47,"ب",1,1],["أَتَبغَينَ مِنّي في المَقالِ تَعَصُّباً","وَأَيُّ أَذاةٍ ما عَصَبتِ بِراسي",48,"س",2,0],["اِتْبَعْ وصاياه فيما لا يَحِلُّ لكم","ولا يَليقُ بكم مِن سيِّئ العَمَلِ",49,"ل",1,0],["أتُبقين حقاً على ما بها","متى أنتِ أبقيتِ شيئاً متى",50,"ت",2,0],["أتبْصِرُهُ جسداً عارياً","وتقربهُ تلك إحدى الكُبرْ",51,"ر",1,0],["أتُبْصِرُ ناراً أُوقِدَتْ لخُوًيْلِدٍ","ودونَ سَناها للنجائبِ إرْقال",52,"ل",1,0],["اِتبَعيني تَرَي دِماءَ الأَعادي","سائِلاتٍ بَينَ الرُبى وَالرِمالِ",53,"ل",1,0],["أَتْبَعْتُهُمْ نَظَرَاتٍ كُلَّمَا بَلَغَتْ","أُخْرَى الْحُمُولِ ثَنَاهَا مَدْمَعٌ هُتُنُ",54,"ن",1,0],["أَتُبْطِيءُ مِصْرٌ عَنْ ثَوَابِ وَزِيرِهَا","وَمَا عَهْدُهُ إِلاَّ نَدىً وَفَلاَحُ",55,"ح",1,0],["أَتَبِينُ عَنَّأ يَا عَلِيُّ","وَكُلُّنَا يَبْكِي بِعَادَكْ",56,"ك",1,0],["أَتْبصِرُ مِنْ سَمَاءِ الشَّرْقِ طَيْرَاً","تَوَافَدُ فِي إِئْتِلاَفٍ وَائْتِلاَقِ",57,"ق",1,0],["أَتبِع بَني عَبدِ شَمسٍ أَمرَ صاحِبِهِم","أَهلي فِداؤُكَ إِن ضَرّوا وَإِن نَفَعوا",58,"ع",3,0],["أتبسمت بعد صمت رهيب","كان يدوي في مسمعيا دويا؟",59,"ي",2,0],["أتبعد والآمالُ دانٍ قطوفها","ولا تحصُد الحبّ الذي أنت باذره؟",60,"ر",2,0],["أتبحثون بينها عن عزة","أوفي لعل فرجا أوفي عسى",61,"ا",1,0],["أتبرَّضُ الماء الزُّلالَ . وغُنيتي","كِسَرُ الرَّغيفِ مَطاعماً ومَشاربا",62,"ب",2,0],["أتبكِي عَلَى لُبْنَى وأنتَ تركتَها","؟ وكُنْتَ عليهَا بالملاَ أنتَ أقدرُ",63,"ر",1,0],["أتبعتهم مقلة ً مدامعها","مِنْهَا، بِمَاءِ الشُّونِ تَسْتَبِقُ",64,"ق",1,0],["أتبكين ؟ لا … لا ومن تؤسفين","إذا أنت مقهورة أو أسيفه",65,"ف",2,0],["اتبع الكُتب بَعضَها أَثر بَعض","فَلَعَلي أَشفي بِها أَحداقي",66,"ق",2,0],["أَتَبعثُ الموتى ولا ترعوي","يا أيُّها العابثُ بينَ اللُحود",67,"د",1,0],["اتَبعتُ بِالهِجَاءِ لَنَا ألَمَّا","تُمَيِّز بَينَ لَيلِكَ والنَّهَارِ",68,"ر",1,0],["أَتَبغونَ قَتلاً لِلنَبِيَّ مُحَمَّدٍ","خُصِصتُم عَلى شُؤمٍ بِطولِ أثامِ",69,"م",1,0],["أتبِّعها نظرا معجَلا","يعثِّر عينى بهُدّابها",70,"ب",3,0],["أتبيع دينك في الضلال بجرعة","قُبِّحتَ بطّالاً زمان المتجر",71,"ر",1,0],["أتَبكي حسرةً وأنا المُعنىَ","وترفع رنّةً وأنا الغريبُ",72,"ب",1,1],["أَتبَعتُهُم طَرفَ عَينٍ جالُها غَرِقٌ","هَاجَ احتمِالُهُم من دَمعِها سَرَبا",73,"ب",2,0],["أَتبَعتُهُم دَوسَراً رَحبَ الفُرُوجِ تَرَى","فى حَدِّ مِرفَقِهِ عَن زَورِهِ حَنَبَا",73,"ب",2,0],["أتبعتهم نظري وفرّق بيننا","بعد المدى وجد النوى الوجدا",74,"د",2,0],["اِتّبع واِسلُك سبيلَ الحُنَفا","مَن سَعى في نَهجهم لم يفتنِ",75,"ن",1,0],["أَتَبغي بِاعتِمادِكَ ذُخرَ أَجرٍ","وَأَنتَ لِسُوءِ فِعلِكَ بي أَثيمُ",76,"م",1,1],["أتبعتهمْ نفساً عليكَ عزيزةً","وطويتَ جنبيها على الآلامِ",77,"م",1,0],["أتبخل إذ وجبت حرمتي","ومن قبلُ جُدتَ ولم تبخلِ",78,"ل",1,0],["أتبكي ماهراً وبه تراخت","إليك أعنّة الحكم الجموح",79,"ح",1,1],["إِتبَعيني يا فَتاتي","وَاِبخلي بِالعبراتِ",80,"ت",1,0],["إِتبَعيني إِتبَعيني","فَدُموعي وَجُفوني",80,"ي",1,0],["إِتبَعني إِتبَعني","فَدُموعي وَجُفوني",80,"ي",1,0],["أَتَبحَثُ عنه في وادٍ","وَمنهُ الكونُ مَلآنُ",81,"ن",1,0],["أَتْبَعْتُهُمْ من دُموعي كُلِّ مُنهمِر","يُرْضي الغَرامَ وإنْ لَمْ تَرْضَهُ المُقَلُ",82,"ل",1,0],["أتبعتُهمْ من أدمعي ما لو غدا","مَطَراً لروَّى عِيسَهم والبلقعا",83,"ع",2,0],["أتبقي على ذبيان في قتل مالكٍ","فقد حشَّ جاني الحرب ناراً تضرمُ",84,"م",1,0],["أتُبدينَ التجلّدَ في جلادٍ","وقد أرسَلتِ طَرفَك لي سفيرا",85,"ر",2,0],["أتُبدي الغنجَ كي أُبدي هُيامي","وكي يَغلي دَمي تُبدي فُتُورا",85,"ر",2,0],["أتبكي الكريماتُ الأُصولِ قصائِدي","وأنتِ ضحوكٌ من تألُّم شاك",86,"ك",1,0],["أتبكي لأجلي بنتُ أشرفِ قومها","وتضحكُ منى في النّوى بنتُ بقّال",87,"ل",1,0],["أَتَبْرِينِي يَدٌ راشَتْ جَناحِي","وَيَحْسِمُنِي نَدَىً هُوَ لِي حُسامُ",88,"م",1,0],["أَتَبخَلونَ بِالخِيارِ خِسَّةً","عَلى أُناسٍ نَزَلوا بِدارِكُم",89,"م",1,1],["أَتبَعَ ذُلّاً تُبَّعاً وَقَيصَرا","قَسراً وَكِسرى بِالسُيوفِ كَسرا",90,"ر",2,0],["أَتَبخَلُ تائِهاً شَرِهاً بِمالٍ","يَكونُ عَلَيكَ بَعدَ غَدٍ وَبالا",91,"ل",2,0],["أَتبَعتَهُم نَظَراتٍ خَلفَها كَبِدٌ","تُسايرُ الرَكبَ بَينَ الريثِ وَالعَجَلِ",92,"ل