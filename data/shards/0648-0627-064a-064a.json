{"poems":[[65,"من رام عزا بغير السيف لم ينل","https://www.aldiwan.net/poem46207.html","البسيط"],[60,"الأزد سيفي على الأعداء كلهم","https://www.aldiwan.net/poem31152.html","البسيط"],[51,"إني أرقت وذكر الموت أرقني","https://www.aldiwan.net/poem63163.html","البسيط"],[92,"الأصيل في لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179198",""],[369,"يا راحلا بالسعد عن مقلتي","https://www.aldiwan.net/poem60903.html","السريع"],[469,"معاليك أعلى أن يحيط بها الوصف","https://www.aldiwan.net/poem3294.html","عموديه"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122623","الوافر"],[1019,"","https://poetry.dctabudhabi.ae/diwan/poem/123317","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202107","الطويل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132231","الوافر"],[2501,"","https://poetry.dctabudhabi.ae/diwan/poem/198534","الطويل"],[3519,"","https://poetry.dctabudhabi.ae/diwan/poem/145135","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91141","الوافر"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97093","الطويل"],[5670,"أوبة","https://www.poetsgate.com/ViewPoem.aspx?id=211417",""]],"verses":[["وأيُّ يَومَيْكَ مِن نارَيْ قِرًى وَوَغىً","في السِّلْمِ والحَربِ لمْ يَفتَرَّ عنْ شُعَلِ",0,"ل",1,0],["وَأَيُّ يَومٍ مِنَ الأَيّامِ لَيسَ لَهُم","فيهِ مِنَ الفِعلِ ما مِن دُونِهِ العَجَبُ",1,"ب",1,0],["وَأَيُّ يَومٍ لِمَن وافى مَنِيَّتَهُ","يَومٌ تَبَيَّنُ فيهِ صورَةُ الغَبَنِ",2,"ن",1,0],["وأيّ يد مرت عليه كريمةٍ","صناعٍ . فردَّتْهُ أديما مخضّبا",3,"ب",2,0],["وأيَّ يومٍ يغَتْدِي ناظري","مُكتحِلاً منكمْ بأنوار",4,"ر",1,0],["وأيُّ يدٍ أولى بتقبيل شاكر","من اليد أدنى نيلها سحبٌ وطف",5,"ف",1,0],["وأيُّ يَدَيَّ مِن أخوي أشجَى","أأشجَى لليمينِ أمِ اليَسار",6,"ر",1,0],["وأي يقين في ادخارك كسرة","لقد جئت شيأ عيب من أضعف الذر",7,"ر",1,0],["وأي يد لم تستقل دونها يدي","لتأخُذَ منها ما ترَشَّفتها يَدا",8,"د",2,0],["وإيئتوا ماجداً برا كريا","بوصل للإله بلا حجاب",9,"ب",1,0],["وأي يدٍ ... قراعك بعدما","رأينا يد الجبار عنك تقارع؟",10,"ع",1,0],["وأي يتم لأطفال وأي أسى","لزوجة عشت ترعاها وترعاكا",11,"ك",2,0],["وَأَيّ يَد تمدّ إِلى عَدوّ","وَقَلب ممدّها يَخشى اِنصِرافه",12,"ف",2,0],["وأي يدٍ جذت لعمرك أنها","يد اللَه كانت في جميع العوالم",13,"م",1,0],["وأيُّ يدٍ تمتدُّ نحْو كتابها","أيُمنى فمرحى .. أم تُمدُّ شماليهْ",14,"ي",2,0]]}