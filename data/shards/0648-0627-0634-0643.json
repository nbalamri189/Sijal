""],[5277,"الرِصافة","https://www.poetsgate.com/ViewPoem.aspx?id=191463",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5431,"ليته كان شفّر !!","https://www.poetsgate.com/ViewPoem.aspx?id=203703",""],[5442,"عسى وقفة بالركب يا حادي الركب","https://www.poetsgate.com/ViewPoem.aspx?id=114759",""],[5606,"مرحبا بالمراسيل","https://www.poetsgate.com/ViewPoem.aspx?id=197469",""],[5648,"حكم القدر","https://www.poetsgate.com/ViewPoem.aspx?id=154432",""],[5660,"عَذابُ الحُبِ أَن تُمسي حَريقاً","https://www.poetsgate.com/ViewPoem.aspx?id=23780",""],[5689,"أظل خيالي أم ضرام جهنم","https://www.poetsgate.com/ViewPoem.aspx?id=143403",""],[5720,"رسالة إلى ولدي ..","https://www.poetsgate.com/ViewPoem.aspx?id=198971",""],[4623,"أتسرك الدنيا وعمرك ذاهب ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146604",""],[2546,"سأمنعُ طرفي أن يلفَّ بنظرة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=17204",""],[5785,"سلام ما الطير في البشامة","https://www.poetsgate.com/ViewPoem.aspx?id=131576",""],[5785,"باهي المحيَّا شمس نصف النهار","https://www.poetsgate.com/ViewPoem.aspx?id=131580",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[469,"أعاذلتي كُفّي ثكلتِ عن العذلِ","https://www.poetsgate.com/ViewPoem.aspx?id=76855",""],[5841,"ش ه د","https://www.poetsgate.com/ViewPoem.aspx?id=34955",""],[5956,"ثورة الأشواق","https://www.poetsgate.com/ViewPoem.aspx?id=182636",""],[5956,"أرى وجه الإله على الزهورِ..","https://www.poetsgate.com/ViewPoem.aspx?id=192602",""],[5956,"أعيش بسِجْنٍ من دُخانٍ مسَوَّر","https://www.poetsgate.com/ViewPoem.aspx?id=194481",""],[5956,"أ تأتي الإمارات يا صالح؟","https://www.poetsgate.com/ViewPoem.aspx?id=194595",""],[5976,"قمراي","https://www.poetsgate.com/ViewPoem.aspx?id=30350",""],[6031,"أَبا هَاشمٍ أُنهِي إليكَ تحيةً","https://www.poetsgate.com/ViewPoem.aspx?id=46265",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577049",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577080",""],[6320,"قَافِلَةُ المَآسِي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84338&r=&rc=35",""],[4222,"لقد بسط الإحسان والعدل في الأرض","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52819&r=&rc=111",""],[5567,"وسواس الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81769&r=&rc=37",""]],"verses":[["وَاِشكو إِلى حَدِّ الحُسامِ فَإِنَّهُ","أَمضى إِذا حَقَّ اللِقاءُ وَأَفضَلا",0,"ل",2,0],["وَأشْكُرْ صَنِيعَ اللهِ فِيكَ فَإِنَّهُ","يُنْمِي ثَوَابَ الشَّاكِرِينَ وَيُجْزِلُ",1,"ل",1,0],["واشْكُرْهُ بالرّحْمَةِ في خَلْقِهِ","ووَجْهَكَ ابْسُطْ بالرِّضا أو يَدَكْ",2,"ك",1,0],["وأشْكَلَ فيها موْتُهُ منْ حَياتِهِ","فعُمِّرَ في حُكْمِ الغَرامِ لفَقْدِهِ",3,"د",2,0],["وَاِشكُروا سُلطانَ مِصرٍ وَاِشكُروا","صاحِبَ الدَولَةِ مَحمودَ الأَثَر",4,"ر",1,0],["وَاِشكُر رِعايَةَ عَبّاسٍ وَمِنَّتَهُ","وَاِشرَح وَلاءَكَ يا غالي لِعُثمانِ",5,"ن",1,0],["وَأَشكالُها شَتّى فَهَذا مُنَظَّمٌ","وَذَلِكَ مَنثورٌ وَذاكَ مُقَبَّبُ",6,"ب",1,0],["وَأَشكو نُبُوَّ الجَنبِ عَن كُلِّ مَضجَعٍ","كَما يَتَجافى بِالأَسيرِ ظِرابُ",7,"ب",1,0],["وَأَشْكُرُ مِنْكُمْ أَنَّكُمْ لائْتِلافِنَا","غَرَسْتُمْ رَجَاءً وَهْوَ يَنْمُو وَيَعْظُمُ",8,"م",1,0],["وَاشكُ الَّذي لاقَيتَهُ مِن دُونِهِ","وانشُر إِلَيهِ دَاءَ قَلبِكَ كُلَّهُ",9,"ل",2,0],["وأشكر فضلها والشكر عَجْز","إذا هو لم يكن إلا كلاما",10,"م",2,0],["وَاِشكُ الهُمومَ إِلى الإِلَهِ وَما تَرى","مِن مَعشَرٍ مُتَأَلِّبينَ غِضابِ",11,"ب",1,0],["وأشكرُهُ شكرين شكراً لحاجة","قضاها وشكراً أنها لم تُنَكَّدِ",12,"د",1,0],["واشكرِ الله الذي أعطاكَهُ","إنْ في جنبيْه نفساً شاكره",13,"ر",2,0],["واشكر لخرطومك المُجدي فأنت به","من قبل شِعري وقبلي طاعمٌ كاس",14,"س",1,0],["وَأَشكُرُكُم بِلِسانِ النَسائِمِ","وَالرَوضِ وَالجَدوَلِ المُترَعِ",15,"ع",1,0],["وَأَشكُرُ الصُنعَ في سِرّي وَفي عَلَني","إِنَّ الصَنائِعَ تَزكو عِندَ أَمثالي",16,"ل",2,0],["وَأَشكو مِن عَذابي في هَواكُم","وَأَجزيكُم عَنِ التَعذيبِ حُبّا",17,"ب",2,0],["وأشكو إِليه سُقْمَ حالي وإِنما","بعُلياهُ أرجو أن يبلَّ سقيمُها",18,"م",3,0],["وأشكُو الذي لاقيتُ بعدَك إنَّهُ","عجائبُ يُجْرِي الدمعَ وهي جَمودُ",19,"د",1,0],["وَأَشكُرُ أُمّي إِذا قَحبَةٌ","وَأُمُّ المُقَصِّرِ إِن شِئتَ بي",20,"ب",2,0],["وَأَشكُرُ نِعمَةً لَكَ بِاِطِّلاعي","عَلى أَنَّ الوَفاءَ اليَومَ مودِ",21,"د",1,0],["وأشكُرُها شُكْرَ الرِّياضِ صنيعةً","من الرَّائحاتِ الغُرِّ راحَت تَجودُها",22,"د",3,0],["وَأَشكُرُكُم ما دُمتُ حَيّاً وَإِن أَمُت","وَلَم أوفِهِ أَوصَيتُ بِالشُكرِ آلِيا",23,"ي",2,0],["وَأَشكُرُ شُكراً لَيسَ لي فيهِ مِنَّةٌ","وَلا مِنَّةٌ لِلرَوضِ إِن شَكَرَ الوَبلا",24,"ل",2,0],["واشكلِ الأوتار عن نغمتها","لا تسوغُ الخمرُ إلا بالنّغم",25,"م",1,0],["وَأَشكو لَو شَكَوتُ إِلى مُصيخٍ","لَيالِيَ لا تُوَقِّرُ مِن مَشيبِ",26,"ب",1,0],["وَأَشكو هَجرَها مِنها إِلَيها","شِكايَةَ مُدنِفٍ عَظِمِ المُصابِ",27,"ب",1,0],["وَأَشكو ما لَقيتُ وَكُلَّ وَجدٍ","غَراماً بِالشِكايَةِ لِلتُرابِ",27,"ب",1,0],["وأشكرُ إذ تعطي، بما أنت أهله","وتأخذ ما تعطي، فأرتاحُ للشكرِ",28,"ر",1,0],["وَأَشكو لِلدِيارِ عَظيمَ وَجدي","وَدَمعي في اِنهِمالٍ وَاِنسِيابِ",29,"ب",1,0],["وَاشْكُرْ لِرَبِّ الفنِّ إِبْدَاعَهُ","مَا شَاءَ فِي تَصْويرِ هَذَا الجَمَالْ",30,"ل",1,0],["وَأَشْكَى شَعْبَهَا وَحَبَا وَوَاسَى","فَرَدَّ بَشَاشةَ الشَّعْبِ العَبُوسِ",31,"س",1,0],["واشكُروا للوزير بِيضَ أيادِيهِ","ومِدْرارَ فَيْضِهِ الهَتّانِ",32,"ن",1,0],["وأشكل فها موته من حياته","فعمر في حكم الغرام لفقده",33,"د",2,0],["واشكري يا أرضُ ألطافَ السّما","تُسلَبُ النعمهُ إن لم تشكري",34,"ر",2,0],["واشْكُرْ فَضَائِلَ صُنعِ اللهِ إذْ جَعَلَتْ","إليكَ، لا لكَ، عِنْدَ النَّاس ِحاجَاتُ",35,"ت",1,0],["وأشكو له البلوى ويشكو كأنّنا","حميم يساقيه العزاء حميم",36,"م",1,0],["واشكو لا يرق الي غيري","ودائي في الهوى الداء العضال",37,"ل",1,0],["واشكر لتحشر شاكراً","حسن الموارد والمصادر",38,"ر",1,0],["واشكرْ لمن أفضَى إليك بجوده","فالشكرُ مرقاةٌ إلى الإحسانِ",39,"ن",1,0],["وأشكر اللّه إذ لم ينصرم أجلي","حتى وصلتُ بأهل الدين إيصالا",40,"ل",2,0],["وأشكوك ما قد نلت من ألم وما","تحمّله ضعفي وعالجه جهدي",41,"د",2,0],["وأشكوها البعاد وليس تصغي","إلى الشكوى وتمكث في ازدياد",42,"د",1,0],["واشكر إلهاً لا يغبك حفظه","والناس إما شامت أو حاسد",43,"د",1,0],["وَاِشكُر أَيادِيَهُ الَّتي أَولاكَها","فَلَقَد أَطابَ لَكَ العَطاءَ وَأَجزَلا",44,"ل",2,0],["وَاِشكُر لَهُ السَعيَ الَّذي اِنقادَت بِهِ","لَكَ وُلد سامٍ حَيثُ شِئتَ وَحامِ",45,"م",1,0],["وَأَشكل معناهُ لدى كلّ عاقلٍ","وَشاكلَ في آفاتهِ لبُّهُ القشرا",46,"ر",2,0],["واشكر أساتذة سموا","بشبيبة الشعب الشكور",47,"ر",1,0],["واشك الغرام لعله","بك يا هزار الحي مغرم",48,"م",1,0],["واشكروا الله الذي","عن ذاته النور صدر",49,"ر",1,0],["وَأَشكو النَوى ما أَمَرَّ النَوى","على هائِمٍ إِن دَعا الشَوقُ لَبّى",50,"ب",2,0],["وَأَشكُرُ ما خَوَّلَتني يَداهُ","شُكرَ رِياضِ الرَبيعِ القُطارا",51,"ر",2,0],["وَأَشكوكَ مِن حِرفَةٍ لا تَريمُ","مُلازِمَةً لي وَلا تَبرَحُ",52,"ح",1,0],["واشْكُرِ اللهَ عَلَى آلائِهِ","إِنَّمَا يَنْجَحُ سَعْياً مَنْ شَكَرْ",53,"ر",1,0],["وَاشْكُرْهُ إِنْ أَسْدَى إِلَيْكَ يَداً","تَنَلِ الْغِنَى وَيَعُلُّكَ النُّسْكُ",54,"ك",1,0],["وَاشْكُرْ إِلَهَكَ دَائِماً فَالْفَوْزُ فِي","شُكْرِ الإِلَهِ عَلَى سَحَائِبِ نَعْشِهِ",55,"ش",2,0],["وَأَشكو تَجنّيهِ فَيقضي لَهُ الهَوى","وَقاضي الهَوى في حُكمِه كَيفَ يَعدلُ",56,"ل",1,0],["واشكر عَلى نعمة من نعمة نشأت","لمن أَرادَ بك الحُسنى وَلَم ترد",57,"د",1,0],["وأَشْكُو إِلى الأيامِ سُوءَ صَنِيعِها","ولَكِنَّها شَكْوى إِلى غَيْرِ رَاحِمِ",58,"م",1,0],["واشكرْه كي تزدادَ من نعمائه","فالشكر فيه زيادةُ النعماء",59,"ا",2,0],["واشكر على النعماء واصبر للبلا","وتحل بالإفضال والإنصاف",60,"ف",1,0],["وَأَشكو إِليه البثّ من معجمٍ عرا","يجرّ لسان المصقع المدره الذربِ",61,"ب",1,0],["وأشك شكاةً ضاق عنها نطاقها","وَصلها برفدٍ يصرمُ الهمّ والكربا",62,"ب",2,0],["وَاِشكُر وَسِر بِنِعمَةِ فَوقِ المَرا","مِ وَصَفوُ فَطِر لَن يَزولَ رَغيدُهُ",63,"د",2,0],["وَاشكُر لِشَيبِكَ حُسنَ صُحبَتِهِ","فَلَقَد كَساكَ جَلالَه الفَضل",64,"ل",1,0],["وَأَشكر فَضل مَولانا عَلَيّ","وَأَجد في الزَيارة وَالمسير",65,"ر",1,0],["وَأَشكو من الدَهرِ الخؤن صَنائِعا","بِها كُل شَيء أَرتَجيه سَراب",66,"ب",1,0],["وَأَشكُرُ المُغضي عَلى حُبِّهِ","لا أَشكُرُ المُغضي عَلى البُغضِ",67,"ض",1,0],["وَأَشكو وَحشَتي لَكَ وَاِغتِرابي","وَإِني بَينَ إِخواني وَناسي",68,"س",2,0],["واشكر الله إذا سبل على الكل ستره","عم جوده تعالى المسلمين وكفره",69,"ر",2,0],["واشكر الرب المجيد تحظ منه بالمزيد","لا تعلق بالعبيد",70,"د",1,0],["واشكر الله مع من قد شكر","واذكر النعماء في جسم ومال",71,"ل",1,0],["واشكر الله على آلائه","ولدى البلوى فكن مع من صبر",72,"ر",1,0],["وأشكُو بَعْدَ ذلِكَ ما أَلاقي","مِن الأيَّام مِنْ هَمّ وضيقِ",73,"ق",1,1],["واشكُرْ لمولاك إذ أَولاكَ عافيةً","لا زِلْتَ ترفلُ في أثوابها الجُدُدِ",74,"د",1,0],["وأشكُو ما ألاقي مِن شجوني","له وأبثّ أشواقي إليهِ",75,"ي",2,0],["وأشكو إلى المولى جوىً عن أقلِّه","يضيق لعمري البرّ أجمعُ والبحرُ",76,"ر",1,1],["وأشكوك دَيْناً أثقلَ الظّهْرَ حملُهُ","فحالي إذاً حَالُ الطّريد المشرّدِ",77,"د",1,0],["وأشكر يد الأنوا فما برحت","تدنيك أدنى الصب للصب",78,"ب",1,0],["وَأَشكُر نُعماءً بِمَدحِكَ نِلتُها","وَمِمَّن حَباها دائِماً أَستَزيدُها",79,"د",3,0],["وأشكرُ منك فضلك ثم أدعو","لوجهك بالبقاء وبالدوام",80,"م",1,0],["وأشكو غليلَ الوجد في عَرَصَاتها","وما لي فيها ما يبلُّ غليلي",81,"ل",2,0],["وأشكرُ منه أيدياً تخجل الحيا","ويترك حرَّ القوم إحسانُه عبدا",82,"د",2,0],["وأشكو إليك الشَّوق لو كنتَ سامعاً","ومن لي بمشكوٍّ يرقُّ ويرحمُ",83,"م",1,0],["وأَشكو إِلَى الرحمنِ تَرْحَةَ فجعَةٍ","بمن لَمْ يَبِتْ داعٍ إِلَى اللهِ يَشْكُوهُ",84,"و",2,0],["وأشكر نبذَهُ بالوصل حينا","وأعذِرُ في الجفاءِ إذا جفاني",85,"ن",2,0],["واشكر لها المحبوبَ من طروقها","في زمن المحْلِ وفي إلمامِها",86,"م",3,0],["واشكر لها كَشْفَ القِناعِ فإنها","غَدرتْ فكان الغدرُ من حسناتِها",87,"ت",3,0],["وَاِشكُرهُ عِندي فَإِنّي ما أَرى أَحَدا","مُذ كُنتُ يَكرَهُ مِن أَحوالِهِ حالا",88,"ل",2,0],["وأشكو اليها ما أُعانيهِ منهما","فلم تُشكِني أن الصبابةَ مَغْرَمُ",89,"م",1,0],["وأشكالها من شكل اسم محمد","قد انبجست ها هي تبدي غواليه",90,"ي",2,0],["واشكر أبا النجم الذي","إحسانه لا يكفر",91,"ر",1,0],["وأشكُو إليها لا إليكُم ظُلاَمَةً","لِتُنصِفَني مِنكم وتَقبِضُ لي حقِّي",92,"ق",2,0],["واشكر على كل حال أنت فيه فما","عن حكمة قد خلا أمر إليك يجي",93,"ج",2,0],["واشكر مولاك كما أولا","ك به واترك قول الهمج",94,"ج",1,0],["واشكرُ مَولانا الكريمَ الذي بهِ","غَدَت مُهجتي عن كلِّ ذلكَ في شُغلِ",95,"ل",1,0],["وَأَشْكُو إِلَيْهَا فَلاَ مُسْعِدَاً","أُصَادِفُ مِنْهَا وَلاَ رَاحِمَا",96,"م",2,0],["وأشكر انتحالها للناس","من قد تولى من بني العباس",97,"س",1,0],["وأَشكو إِلى الأَفلاكِ جَوْرَ نُجُومِها","فيضحكْنَ عن ثَغرِ الصباح هَوازِيا",98,"ي",2,0],["وأَشْكَلَ الأَمْرُ إِلى أَنْ غَدا","إِشكالُه غايَةَ تَبْيِينِه",99,"ن",2,0],["وأَشْكو إِليك الحاسدين عليك لِي","وإِنْ كان يبدو مِنْهمُ الحُبُّ والوُدُّ",100,"د",1,0],["وأَشْكُو إِلى ليلِ الغَدائِر غدرَها","وأُمْلي عليه وهْو في الأَرْضِ يَكْتُبُ",101,"ب",1,0],["وأشكاله في كشف أشكال لوحه","تبين مثل الفرد في كثرة المثنى",102,"ن",2,0],["واشكر له نعماً جلَّت ولست لها","أهلاً ولكن بفضل نلتَ ما وهبا",103,"ب",2,0],["وَاشكر صَنيع الداوريّ محمد","فَهُوَ الَّذي أَحيا العلوم بمصره",104,"ر",2,0],["وَاشكر صَنيعة محسن متفضل","أَولاك كُل الخَير في السَرّاء",105,"ا",2,0],["وأشكُو إليها ما ألاقي من الظما","فتشكو الذي أشكو لِتَقْتُلَنِي عَمْدَا",106,"د",2,0],["وأشكوك ما ألقى من الهجر والهوى","فتأبى سوى الإعراض عني وما تشكي",107,"ك",2,0],["وأشكو لك الجورَ الّذي جرّه النّوى","فتُعرِضُ إِعراض الخليّ عن الشَّكْوِ",108,"و",1,0],["وأشكرُهُ شكرَ الثّرى لسمائهِ","بِدُرٍّ من اللَفظِ البليغِ المُرصّعِ",109,"ع",1,0],["واشكر سعيداً لما أولى ومن كأبي","عثمان إن حل عقد الأمر أو ربَطا",110,"ط",2,0],["وَأَشْكُو لَهُ لَوْ رَقَّ يَوْماً إلَى الشَّكْوى","نُفُوسٌ أَرَاهَا لاَ تَزَالُ مُذَابَةً",111,"ه",1,0],["وأشكو عندها ضُرّي وأبكي","فتسكب مقلتاي سُموط تِبرِ",112,"ر",1,0],["واشكر الدهر والايام اذ وخدت","بي النجائب نحو السادة النجب",113,"ب",1,0],["واشك الهموم إليه وأط","رح ثقلها بفناه وأفرح",114,"ح",1,0],["وَاشْكرْ لمَوْلاَك الكَرِيمِ فَإنَّ مَنْ","شَكَرَ لإلهَ يَزِيدُه مَهْمَا شَكَرْ",115,"ر",1,0],["واشكر لمن قد غشت مغناك أنعمه","ولا يشكر الله من لا يشكر النعما",116,"م",2,0],["وَأشكرُ نُعماك الّتي كادَ حاسدي","على نيلها بالريقِ أن يتشرّقا",117,"ق",2