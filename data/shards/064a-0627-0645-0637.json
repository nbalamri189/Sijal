{"poems":[[53,"جري النسيم على ماء العناقيد","https://www.aldiwan.net/poem30625.html","البسيط"],[88,"أزمعت عنا إلى مولاك ترحالا","https://www.aldiwan.net/poem45053.html","البسيط"],[72,"عيد يعود إلى هذا الثنا العالي","https://www.aldiwan.net/poem19474.html","البسيط"],[70,"طلع العذار عليه حارس","https://www.aldiwan.net/poem42861.html","مجزوء الكامل"],[89,"نطقت حشاشة محسن تتبرم","https://www.aldiwan.net/poem44897.html","الكامل"],[97,"يا للحبيب المفدى","https://www.aldiwan.net/poem24786.html","المجتث"],[74,"في كل ناد منك روض ثناء","https://www.aldiwan.net/poem12835.html","الكامل"],[105,"خلوا سبيل الشاعر المتدفع","https://www.aldiwan.net/poem42071.html","الكامل"],[105,"بني الكنانة هذا صوتها ارتفعا","https://www.aldiwan.net/poem42100.html","البسيط"],[105,"يا مطعم الجيش أشبعت السيوف دما","https://www.aldiwan.net/poem44069.html","البسيط"],[106,"مصر تناجي المعلمين","https://www.poetsgate.com/ViewPoem.aspx?id=179599",""],[223,"يا مطري المولى الرفيع الذرا","https://www.aldiwan.net/poem55210.html","السريع"],[227,"تميط الأذى عن حامليها الصوارم","https://www.aldiwan.net/poem50832.html","الطويل"],[280,"وميض برق أرى في فيك أم شنبا","https://www.aldiwan.net/poem32294.html","البسيط"],[302,"يا هاجري كم ذا تكون مهاجري","https://www.aldiwan.net/poem16862.html","الكامل"],[326,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[362,"أسعداني في الحب ما تعلمان","https://www.aldiwan.net/poem60609.html","الخفيف"],[362,"سل صدور الركاب ماذا الحنين","https://www.aldiwan.net/poem60627.html","الخفيف"],[364,"يا مطمعي لفظا بكله","https://www.aldiwan.net/poem17385.html","الكامل"],[369,"يا مطيع العذول في عصياني","https://www.aldiwan.net/poem57088.html","الخفيف"],[400,"هل ينال القلب ما طلبا","https://www.aldiwan.net/poem34147.html","المديد"],[456,"ألطيمة حبست بكاظمة","https://www.aldiwan.net/poem55845.html","أحذ الكامل"],[513,"يا مطلق العبرات وهي غزار","https://www.aldiwan.net/poem12104.html","الكامل"]],"verses":[["يا مُطلِقَ السَمعِ وَالأَسماعُ ما بَرِحَت","أَسيرَةً في يَدَيّ عَذلٍ وَتَفنيدِ",0,"د",1,0],["يا مُطلعاً في سماء الفكر أنجمه","تهدي إلى العلم رحّالاً وقفّالا",1,"ل",2,0],["يا مطلق الحسن أحشائِي مفلفلةٌ","على محاسنِهِ دعني وأغلالي",2,"ي",1,0],["يامُطمِعي في وَصلِهِ","لا رُحتُ يَوماً مِنكَ آيِس",3,"س",1,0],["يا مطلقاً في صدره لرصاصه","سرفي طريق الموت فهو الاسلم",4,"م",1,0],["يا مطلعَ السحر والنو","ر والجمال تَكَلَّم",5,"م",1,0],["يامَطلَعَ الأَنوارِ إِنَّ بِمُقلَتي","أَسَفاً عَلَيكَ كَمَنشَإِ الأَنواءِ",6,"ا",2,0],["يا مطلعَ العهدِ الجديدِ تحيّةً","كَسناهُ إن تَظْفَرْ بِنُوركَ تَسطعِ",7,"ع",1,0],["يا مُطفِئَ الفتنةِ الكبرى وقد رجفتْ","أرضُ الكِنانةِ من أهوالها فَزعا",8,"ع",2,0],["يا مُطعِمَ الجيشِ أشبعتَ السُّيوفَ دَما","لولاكَ ما شَبعتْ يَوماً ولا طَعِما",9,"م",2,1],["يا مُطلعينَ شُموسي من مَشَارِقِها","وباعثينَ القُوَى في عَزْمِ آسادِي",10,"د",2,0],["يا مُطرِيَ المَولى الرَفيعِ الذُرا","نِلتَ المُنى فَاِنزِل بِوادٍ خَصيب",11,"ب",1,1],["يا مطلِقَ الأمَل العاني ومُخرِجَه","لليُسْر من بعد ما أَوْدَى به العَدَمُ",12,"م",1,0],["يا مُطلِعَ البَدرِ فَوقَ الغُصنِ مُعتَدِلاً","يَلوحُ ما بَينَ شربوشٍ وَطَوق قبا",13,"ب",2,0],["يا مطلبي يا مأربي يا مهربي","يا مفزعي في يسرتي ومعاسري",14,"ي",1,0],["يا مطيّ القضاء أضناكم السي","ر فثوروا بطبعكم لا بطبعه",15,"ه",1,0],["يا مَطافاً للوَفدِ من كُلّ أرضٍ","ومُحلَّى بالعَدْلِ والإحسان",16,"ن",1,0],["يا مطايا الأحبابِ أنتُنَّ للعُشْ","شاقِ مثْلُ اسْمِكُنَّ والطّاءُ نُون",17,"ن",1,0],["يا مُطمِعي لَفظاً بِكُلَّه","وَالبُخلُ يَمنَعُ مِن لَعَلِّه",18,"ل",2,1],["يا مُطيعَ العَذولِ في عِصياني","ومُذيقي حَرارَة الهجرانِ",19,"ن",1,1],["يا مطيل الخوض في عذلي","طامعاً أن سوف تحدث لي",20,"ي",1,0],["يا مطبقا عينيه حين رأى","ضوءاً فخال البرقَ معتنّا",21,"ن",2,0],["يا مطلق العبرات وهي غزار","ومقيد الزفرات وهي حرار",22,"ر",1,1]]}