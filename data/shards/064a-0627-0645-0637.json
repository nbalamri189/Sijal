{"poems":[[55,"جري النسيم على ماء العناقيد","https://www.aldiwan.net/poem30625.html","البسيط"],[90,"أزمعت عنا إلى مولاك ترحالا","https://www.aldiwan.net/poem45053.html","البسيط"],[74,"عيد يعود إلى هذا الثنا العالي","https://www.aldiwan.net/poem19474.html","البسيط"],[72,"طلع العذار عليه حارس","https://www.aldiwan.net/poem42861.html","مجزوء الكامل"],[91,"نطقت حشاشة محسن تتبرم","https://www.aldiwan.net/poem44897.html","الكامل"],[99,"يا للحبيب المفدى","https://www.aldiwan.net/poem24786.html","المجتث"],[76,"في كل ناد منك روض ثناء","https://www.aldiwan.net/poem12835.html","الكامل"],[107,"خلوا سبيل الشاعر المتدفع","https://www.aldiwan.net/poem42071.html","الكامل"],[107,"بني الكنانة هذا صوتها ارتفعا","https://www.aldiwan.net/poem42100.html","البسيط"],[107,"يا مطعم الجيش أشبعت السيوف دما","https://www.aldiwan.net/poem44069.html","البسيط"],[108,"مصر تناجي المعلمين","https://www.poetsgate.com/ViewPoem.aspx?id=179599",""],[230,"يا مطري المولى الرفيع الذرا","https://www.aldiwan.net/poem55210.html","السريع"],[234,"تميط الأذى عن حامليها الصوارم","https://www.aldiwan.net/poem50832.html","الطويل"],[287,"وميض برق أرى في فيك أم شنبا","https://www.aldiwan.net/poem32294.html","البسيط"],[309,"يا هاجري كم ذا تكون مهاجري","https://www.aldiwan.net/poem16862.html","الكامل"],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[369,"أسعداني في الحب ما تعلمان","https://www.aldiwan.net/poem60609.html","الخفيف"],[369,"سل صدور الركاب ماذا الحنين","https://www.aldiwan.net/poem60627.html","الخفيف"],[371,"يا مطمعي لفظا بكله","https://www.aldiwan.net/poem17385.html","الكامل"],[376,"يا مطيع العذول في عصياني","https://www.aldiwan.net/poem57088.html","الخفيف"],[409,"هل ينال القلب ما طلبا","https://www.aldiwan.net/poem34147.html","المديد"],[463,"ألطيمة حبست بكاظمة","https://www.aldiwan.net/poem55845.html","أحذ الكامل"],[520,"يا مطلق العبرات وهي غزار","https://www.aldiwan.net/poem12104.html","الكامل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103069","الكامل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101552","البسيط"],[794,"","https://poetry.dctabudhabi.ae/diwan/poem/101215","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48677","الكامل"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122304","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70820","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119996","السريع"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119982","السريع"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59414","السريع"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59416","الكامل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138071",""],[1065,"","https://poetry.dctabudhabi.ae/diwan/poem/177899","الكامل"],[1240,"","https://poetry.dctabudhabi.ae/diwan/poem/216709",""],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/73951","الخفيف"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82298","الرمل"],[1428,"","https://poetry.dctabudhabi.ae/diwan/poem/82290","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79896","الخفيف"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141301","المنسرح"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101007","السريع"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101049","البسيط"],[1954,"","https://poetry.dctabudhabi.ae/diwan/poem/188167","البسيط"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123089","البسيط"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123049","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53128","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106825","السريع"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100918","الكامل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130862",""],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100349","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100323","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204632","الكامل"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115434","الكامل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112517","المجتث"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89106","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91684","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91068","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216716",""],[3726,"","https://poetry.dctabudhabi.ae/diwan/poem/31383","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135738","الرجز"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93316","الكامل"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113824","البسيط"],[4869,"يا مطيّح الحر يوم ارمشت","https://www.poetsgate.com/ViewPoem.aspx?id=151562",""],[4991,"شاغلتني","https://www.poetsgate.com/ViewPoem.aspx?id=183314",""],[5012,"يامطول الليل","https://www.poetsgate.com/ViewPoem.aspx?id=22800",""],[5183,"حلبة الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=180215",""],[5183,"رد التهنئة","https://www.poetsgate.com/ViewPoem.aspx?id=180229",""],[5582,"صبٌّ له في الهَوى شرحٌ وإملاءُ","https://www.poetsgate.com/ViewPoem.aspx?id=63455",""],[5784,"الشعر أوزان","https://www.poetsgate.com/ViewPoem.aspx?id=189939",""],[5853,"أفول شعر الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=175720",""],[5952,"ستائر من خجل","https://www.poetsgate.com/ViewPoem.aspx?id=200247",""],[5956,"صاحبة التَّرحابِ المُرَكَّز","https://www.poetsgate.com/ViewPoem.aspx?id=205344",""],[6133,"قولة أهلاً","https://www.poetsgate.com/ViewPoem.aspx?id=33826",""]],"verses":[["يا مُطلِقَ السَمعِ وَالأَسماعُ ما بَرِحَت","أَسيرَةً في يَدَيّ عَذلٍ وَتَفنيدِ",0,"د",1,0],["يا مُطلعاً في سماء الفكر أنجمه","تهدي إلى العلم رحّالاً وقفّالا",1,"ل",2,0],["يا مطلق الحسن أحشائِي مفلفلةٌ","على محاسنِهِ دعني وأغلالي",2,"ل",2,0],["يامُطمِعي في وَصلِهِ","لا رُحتُ يَوماً مِنكَ آيِس",3,"س",1,0],["يا مطلقاً في صدره لرصاصه","سرفي طريق الموت فهو الاسلم",4,"م",1,0],["يا مطلعَ السحر والنو","ر والجمال تَكَلَّم",5,"م",1,0],["يامَطلَعَ الأَنوارِ إِنَّ بِمُقلَتي","أَسَفاً عَلَيكَ كَمَنشَإِ الأَنواءِ",6,"ا",2,0],["يا مطلعَ العهدِ الجديدِ تحيّةً","كَسناهُ إن تَظْفَرْ بِنُوركَ تَسطعِ",7,"ع",1,0],["يا مُطفِئَ الفتنةِ الكبرى وقد رجفتْ","أرضُ الكِنانةِ من أهوالها فَزعا",8,"ع",2,0],["يا مُطعِمَ الجيشِ أشبعتَ السُّيوفَ دَما","لولاكَ ما شَبعتْ يَوماً ولا طَعِما",9,"م",2,1],["يا مُطلعينَ شُموسي من مَشَارِقِها","وباعثينَ القُوَى في عَزْمِ آسادِي",10,"د",2,0],["يا مُطرِيَ المَولى الرَفيعِ الذُرا","نِلتَ المُنى فَاِنزِل بِوادٍ خَصيب",11,"ب",1,1],["يا مطلِقَ الأمَل العاني ومُخرِجَه","لليُسْر من بعد ما أَوْدَى به العَدَمُ",12,"م",1,0],["يا مُطلِعَ البَدرِ فَوقَ الغُصنِ مُعتَدِلاً","يَلوحُ ما بَينَ شربوشٍ وَطَوق قبا",13,"ب",2,0],["يا مطلبي يا مأربي يا مهربي","يا مفزعي في يسرتي ومعاسري",14,"ر",2,0],["يا مطيّ القضاء أضناكم السي","ر فثوروا بطبعكم لا بطبعه",15,"ه",1,0],["يا مَطافاً للوَفدِ من كُلّ أرضٍ","ومُحلَّى بالعَدْلِ والإحسان",16,"ن",1,0],["يا مطايا الأحبابِ أنتُنَّ للعُشْ","شاقِ مثْلُ اسْمِكُنَّ والطّاءُ نُون",17,"ن",1,0],["يا مُطمِعي لَفظاً بِكُلَّه","وَالبُخلُ يَمنَعُ مِن لَعَلِّه",18,"ل",2,1],["يا مُطيعَ العَذولِ في عِصياني","ومُذيقي حَرارَة الهجرانِ",19,"ن",1,1],["يا مطيل الخوض في عذلي","طامعاً أن سوف تحدث لي",20,"ي",1,0],["يا مطبقا عينيه حين رأى","ضوءاً فخال البرقَ معتنّا",21,"ن",2,0],["يا مطلق العبرات وهي غزار","ومقيد الزفرات وهي حرار",22,"ر",1,1],["يا مطلق ومقيد يا مجمل","ومفصل متعاكس مطارد",23,"د",1,0],["يا مطرباً قد أثار الوجدَ في كبدي","لما تحدَّث عن إحسانهِ العودُ",24,"د",1,1],["يا مطلاً دمي بخديه عمداً","لأقودن عن دمي عندميا",25,"ي",2,0],["يا مطلق الآمال كيف سباقها","إن لم يكن ميدانها ناديكا",26,"ك",2,0],["يا مطلع النور الذي","ضاءت بطلعته المطالع",27,"ع",1,0],["يا مُطعما أولادَها","أطعم بني ضَبُعٍ وذِيب",28,"ب",1,0],["يا مطلق العاني ورب الندى ال","داني ويا ذا الصفحةِ الطَّلقَه",29,"ق",2,0],["يا مطلق العاني ويا موئل ال","جاني ويا كنز المقل الغريب",30,"ب",1,0],["يا مطمح الآمال يا مجتبي","والكون لم يبؤز من الأنعدام",31,"م",1,0],["يا مطلع الأنوار يا قطب البها","يا مظهر الأسرار يا سر الحكيم",32,"م",1,0],["يا مطلق الأرواح في دنيا الكرى","أطلق سراحي في الوجود الثاني",33,"ن",2,0],["يا مطلعين لنا بدوراً أوجها","لم يدر غزلاناً تغازل أم مها",34,"ه",2,0],["يا مطلوق الزلايف","يا مِسْمَرّ اليديل",35,"ل",1,0],["يا مطيلاً آمال عمرٍ قصيرٍ","وخطيب الردى فصيح خطابُه",36,"ب",2,0],["يا مُطيعُ النَّذلُ أَنتَ ال","يَومَ مَخذولٌ جَهولُ",37,"ل",1,1],["يا مُطيعُ يا مُطيعُ","أَنتَ إِنسانٌ رَقيعُ",38,"ع",1,1],["يا مُطيبَ القِرى إذا ما اقشعرَّت","ببني الدهرِ شَتوةٌ غبراء",39,"ا",2,0],["يا مطلع السّعود","وبهجة الوجود",40,"د",1,0],["يا مَطلَع الحق ومجلى الهدى","بوركت في المجلى وفي المطلع",41,"ع",1,0],["يا مطعمي الناس إن أكدى الغمام ويا","ري الحجيج إذا يوم الهجير حمى",42,"م",2,0],["يامطلع الصبح من ظلماء كربتنا","ياكابح الشر إذ ماشبَّ عريانا",43,"ن",2,0],["يا مُطلق النفس في قيد الهوى سَرفاً","يخصّهنا بعُموم الخزي والندم",44,"م",1,0],["يا مطلباً قد عزّ كم","كذا تُهين طالبك",45,"ك",1,1],["يا مطلقي من يَدَيْ عواد","أوثقني حربهنَّ أسرا",46,"ر",2,0],["يا مطلق الطرف المعذب في الألى","جردن عن حسن وعن احسان",47,"ن",1,0],["يا مطربَ الرفقة في محفلٍ","قد كان يشجو صوتُك المحفلا",48,"ل",2,0],["يا مطفئاً منها لوافحَ صدرِهِ","إهنأ بوهمٍ فى المياه قراحِ",49,"ح",1,0],["يا مطيل الآمال في النجم أقصر","وأقرض الشعر في صفاء المساء",50,"ا",2,0],["يا مُطمعي حيث لا حسٌّ ولا رمق","رضيت بالوهم لو ابقيت لي رمقا",51,"ق",2,0],["يا مطمعي والعيش منتهز","والشيب جرَّد صارم الوخط",52,"ط",1,0],["يا مطفئ المصباح خيفة نوره","هيهات تطفئ نور نجم لامع",53,"ع",1,0],["يا مطرباً أغنى النديم غناؤُهُ","عن طيبِ مشموم وعن مشروب",54,"ب",1,1],["يا مطلقى من إساري","يا مطفئا حرّ ناري",55,"ي",1,1],["يا مطمح الأبصار بل يا مطلب ال","أسرار بل يا وارث المختار",56,"ر",1,0],["يا مطلعَ الأَقمار أَين منيرُها","يا ملعبَ الأَغصانِ أَين مميدها",57,"د",3,0],["يا مطيّ الرجا استريحي فهَذا","ما قَصدنا وَعيشةٌ خَضراء",58,"ا",2,0],["يا مطيّ الرَجاء قَد فارق الإع","ياء قرّي وَحُطَّت الأَعباء",58,"ا",2,0],["يا مطعم الدود بالصبا","لا الدود تبقي ولا الجسدْ",59,"د",1,0],["يا مُطعِمَ الرَكبِ الجِياعِ إِذا هُمُ","حَثّوا المَطِيَّ إِلى العُلى وَتَسَرَّعوا",60,"ع",3,0],["يا مطعمٌ يا مصلحٌ يا ملهمُ","يا عاصمٌ من البلاء نَسلَمُ",61,"م",1,0],["يا مُطْلِعاً بصُدوده في لِمَّتي","ما غاب تحت عِذاره من خدّه",62,"د",2,1],["يا مطرب الحي أنشدنا بتنغيم","ولا تُعر لعذول أذن متهوم",63,"م",1,1],["يامطيّح الحُر يوم ارمشت بجفونك","ادخل على الله .. قلوب الناس قمريّه",64,"ي",2,0],["يا مطر روحي لج اجمل وردتين","والغلا انسامنا وقت الفلاح",65,"ح",1,0],["يامطول الليل الخواطر كثيره","أتعبني الهوجاس وأتعبني الليل",66,"ل",1,1],["يا مطلق العنان سبحاً يثب","حياك من ذاك العنان الدأب",67,"ب",1,1],["يا مطلع السعد من شمس الإخاء لقد","أنرت حالك مجهول الصوى فدُم",68,"م",1,0],["يا مُطْمِعِي بِسُعادٍ كَيْفَ تُطْمِعُنِي","وَدُونَها حَرَّةُ البَيْداءِ رَجْلاءُ",69,"ا",2,0],["يا مطلقا للقوافي لست تلجمها","مزقت أثوابها والشعر أوزان",70,"ن",1,1],["يا مطمع العبد في جودٍ لخالقهُ","قصدي رضاكَ فهب لي منكَ برهانا",71,"ن",2,0],["يا مطلعَ الشعرِ يا أنغامَ قافيتي","أبكي على القلبِ أم أبكي على الطَلَلِ",72,"ل",1,0],["يا مطربي الأعماق آنُ ومصطفى","والأحمدان أجَدْتمُ الإطرابا",73,"ب",2,0],["يا مطوية في قولة أهلاً","أركزي أثبتي أوعي تخافي",74,"ف",2,0]]}