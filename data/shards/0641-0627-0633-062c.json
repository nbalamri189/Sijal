{"poems":[[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[89,"سل مالك الملك فهو الآمر الناهي","https://www.aldiwan.net/poem8201.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42579","السريع"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54195","الخفيف"],[128,"هشت لمقدمه المدينه","https://www.aldiwan.net/poem23748.html","مجزوء الكامل"],[228,"أيها الظلم والخنا والغرور","https://www.aldiwan.net/poem41927.html","الخفيف"],[563,"من الجسوم إلى الأرواح إسراء","https://www.aldiwan.net/poem35087.html","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96669","الكامل"],[1090,"","https://poetry.dctabudhabi.ae/diwan/poem/96455","الوافر"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112955","الكامل"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[2126,"","https://poetry.dctabudhabi.ae/diwan/poem/100545","الرمل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53033","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77372","الخفيف"],[563,"","https://poetry.dctabudhabi.ae/diwan/poem/68193","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132642","المنسرح"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112676","الرجز"],[4921,"بك أستجير فمن يجير سواكا","https://www.poetsgate.com/ViewPoem.aspx?id=3652",""],[5136,"قمر أهل على الغصون من البكور","https://www.poetsgate.com/ViewPoem.aspx?id=121576",""],[5183,"الدهر الفظ","https://www.poetsgate.com/ViewPoem.aspx?id=180206",""],[5582,"ما لِي أَصَبُّ إِلَى الحَياةِ وَما لِي","https://www.poetsgate.com/ViewPoem.aspx?id=187226",""],[5720,"حَيَاهْ","https://www.poetsgate.com/ViewPoem.aspx?id=199164",""]],"verses":[["فاسجُد لَهُ وَاِقترِب تَبلُغ بِطاعَتِهِ","ما شِئتَ في الدَّهرِ مِن جاهٍ وَمِن عِظَمِ",0,"م",1,0],["فَاسْجُدْ لَهُ وَاقْتَرِبْ تَبْلُغْ بِطَاعَتِهِ","مَا شِئْتَ فِي الدَّهْرِ مِنْ عِزٍّ وَمِنْ جَاهِ",1,"ه",1,0],["فَاسْجُدْ لَهُ وَاقْصِدْ حِمَاهُ تَجِدْ","رَبَّاً كَرِيماً وَمَلِيكاً هَدَى",2,"د",2,0],["فاسجَعي يا حمامةَ السلْمِ للكو","نِ وهُزِّي أعطافَه تغريدا",3,"د",2,0],["فاسجع على فنن التشرد","في حياتكم الضنينة",4,"ن",2,0],["فَاِسجُدوا لِلأَثيرِ فيها وَصَلّوا","فَلُهاثُ الأَجدادِ هذا الأَثيرُ",5,"ر",1,0],["فاسجد له سجدة في مسجد حرمت","جهاته منه للأملاك لألاء",6,"ا",2,0],["فَاِسجُد لغرّةِ وَجهه فهناك قد","تَلقى أميراً بِالمكارمِ آمرا",7,"ر",2,0],["فَأَسجِح إِذ مَلَكتَ فَلَومَلَكنَا","لَجُرنَا فِى الحُكُومَةِ وَاعتَدَينَا",8,"ن",2,0],["فاسجد اخا اللأوى لربك شاكرا","فالنصر جاء لك الهناء بنيله",9,"ل",2,0],["فأسجر بينهم فيها وطيسٌ","فَصُلُّوها وظلوا يصطلونا",10,"ن",2,0],["فاسجدوا ذلا له فيمن سجد","فله الأملاك خرت سجدا",11,"د",2,0],["فاسجد إذا رفع الحجاب وغض من","عينيك لا يعشيهما لألاؤه",12,"ا",3,0],["فَاِسجُدوا لِلإِلَهِ شُكراً وَإِن لَم","تَقضِ عَنّا إِحسانَهُ السَجَداتُ",13,"ت",1,0],["فاسجد له دائما إن كنت تعرفه","مثلي كما قال في القرآن واقترب",14,"ب",1,0],["فاسجد لآياته إذا تليت","فان فيها السجود قد فرضا",15,"ض",2,0],["فاسجد على تربته القدسيه","فإن فيها الفضل والمزيه",16,"ه",1,1],["فاسجد لمولاك القدير فإنما","لابد يوماً تنتهي دنياكا",17,"ك",2,0],["فاسجد لربك واقترب شكر فقد","ضمن المزيد لشكر كل شكور",18,"ر",1,0],["فاسجدي طوعاً له أو","غادري اللطف مغيظا",19,"ظ",2,0],["فَاسْجَحْ فإِنَّ أَضالِعِي فِي أَعْظُمٍ","لَيْسَتْ حَناياها بِصُمِّ جِبالِ",20,"ل",1,0],["فأسجدُ للِه في خَلْوَتِيْ","عساني أفوزُ بطوقِ النجاهْ",21,"ا",2,0]]}