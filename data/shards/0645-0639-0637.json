{"poems":[[55,"توقعي أن يقال قد ظعنا","https://www.aldiwan.net/poem29653.html","المنسرح"],[55,"ما أقل اعتبارنا بالزمان","https://www.aldiwan.net/poem29740.html","الخفيف"],[55,"أهلا بهن على التنويل والبخل","https://www.aldiwan.net/poem29905.html","البسيط"],[74,"مبلبل الأصداغ والطره","https://www.aldiwan.net/poem18697.html","السريع"],[74,"صرفت فعلي في الأسى وقولي","https://www.aldiwan.net/poem20616.html","الرجز"],[53,"أما الزمان إلى سلمى فقد جنحا","https://www.aldiwan.net/poem9264.html","البسيط"],[45,"أجاب دمعي وما الداعي سوى طلل","https://www.aldiwan.net/poem9943.html","البسيط"],[47,"أتاركي أنت أم مغرى بتعذيبي","https://www.aldiwan.net/poem10649.html","البسيط"],[47,"بات عهد الصبا وباقي جديده","https://www.aldiwan.net/poem63465.html","الخفيف"],[68,"لعل ليالي الربوتين تعود","https://www.aldiwan.net/poem41357.html","الطويل"],[83,"لزهرة البستان في غصنها","https://www.aldiwan.net/poem61387.html","الكامل"],[83,"سل في الظلام أخاك البدر عن سهري","https://www.aldiwan.net/poem61518.html","البسيط"],[54,"ليت يومي بنهر فروخ عادا","https://www.aldiwan.net/poem27119.html","الخفيف"],[111,"همم الملوك أجلها أعظامها","https://www.poetsgate.com/ViewPoem.aspx?id=533",""],[47,"بَاتَ عَهْدُ الصّبَا وَباقي جَديدِهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31632",""],[164,"معط أخا كرم مرض أخا ندم","https://www.aldiwan.net/poem58707.html","البسيط"],[182,"كعبة الحسن","https://www.aldiwan.net/poem50713.html","البسيط"],[189,"يا رب بدر بات يرشف مسمعي","https://www.aldiwan.net/poem14133.html","الكامل"],[215,"فجعت بألطف العلماء روحا","https://www.aldiwan.net/poem46629.html","الوافر"],[228,"على ذروة بين أطلال صور","https://www.aldiwan.net/poem39710.html","المتقارب"],[240,"زفرات وجد ما يبوخ ضرامها","https://www.aldiwan.net/poem31746.html","الكامل"],[276,"لاقيت يا نفس حقا ما حكى الحاكي","https://www.aldiwan.net/poem52112.html","البسيط"],[285,"أما والهوى يوم استقل فريقها","https://www.aldiwan.net/poem60780.html","الطويل"],[287,"هلم يا لائمي قد أثمر البان","https://www.aldiwan.net/poem32409.html","البسيط"],[333,"أخطأت ميعادك","https://www.aldiwan.net/poem54978.html","مجزوء الرجز"],[369,"سرى كما يسري القمر","https://www.aldiwan.net/poem60914.html","مجزوء الرجز"],[438,"هل لركب العراق بعد نجوده","https://www.aldiwan.net/poem12470.html","الخفيف"],[438,"مالك قلبي عن يد","https://www.aldiwan.net/poem12587.html","مجزوء الرجز"],[463,"خاطر بها إما ردى أو مراد","https://www.aldiwan.net/poem56227.html","الرجز"],[469,"لولا صدودك يا أمامه","https://www.aldiwan.net/poem3491.html","عموديه"],[519,"خر الورى حيدري عم نائله","https://www.aldiwan.net/poem20836.html","البسيط"],[519,"دهر دها قدر دارت نوائبه","https://www.aldiwan.net/poem20846.html","البسيط"],[519,"فخر الورى","https://www.aldiwan.net/poem20850.html","مجزوء الرجز"],[519,"فخر الورى حيدري عم نائله","https://www.aldiwan.net/poem20851.html","البسيط"],[572,"عجبت من قناعتي وقعودي","https://www.aldiwan.net/poem69730.html","الكامل"],[572,"أطلق عقال الروح بالراح","https://www.aldiwan.net/poem69760.html","السريع"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122695","المنسرح"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38966","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38766","الطويل"],[966,"","https://poetry.dctabudhabi.ae/diwan/poem/146425","المتقارب"],[971,"","https://poetry.dctabudhabi.ae/diwan/poem/204333","البسيط"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105454","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56241","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64624","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49974","البسيط"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11990","المنسرح"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/109005","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69339","المنسرح"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53169","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27858","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27632","البسيط"],[2293,"","https://poetry.dctabudhabi.ae/diwan/poem/198987","الطويل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106893","الخفيف"],[2406,"","https://poetry.dctabudhabi.ae/diwan/poem/100117","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60956","الكامل"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99073","البسيط"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46015","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117965","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117877","الكامل"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29277","الرمل"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75697","الطويل"],[3987,"","https://poetry.dctabudhabi.ae/diwan/poem/146883","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119620","الكامل"],[4078,"","https://poetry.dctabudhabi.ae/diwan/poem/199413","الطويل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102729","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90825","الطويل"],[4220,"","https://poetry.dctabudhabi.ae/diwan/poem/104419","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54347","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133079","البسيط"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105178","السريع"],[4627,"","https://poetry.dctabudhabi.ae/diwan/poem/102018","الكامل"],[4691,"يبتزّني الخدّ فما أفلحُ","https://www.poetsgate.com/ViewPoem.aspx?id=211311",""],[4733,"خُطوبُ اليَاسَمين","https://www.poetsgate.com/ViewPoem.aspx?id=188193",""],[5186,"ورد الربيع شذا من ربع غسان","https://www.poetsgate.com/ViewPoem.aspx?id=156440",""],[5277,"الأيام الخوالي","https://www.poetsgate.com/ViewPoem.aspx?id=194942",""],[5596,"السحمية","https://www.poetsgate.com/ViewPoem.aspx?id=206361",""],[5845,"لاقيتِ يا نفسُ حقاً ما حكى الحاكي","https://www.poetsgate.com/ViewPoem.aspx?id=16704",""],[5912,"قاتل الروح","https://www.poetsgate.com/ViewPoem.aspx?id=203621",""],[5943,"تشطير لقصيدة نجاة الظاهري","https://www.poetsgate.com/ViewPoem.aspx?id=138286",""],[5953,"سئمت المقام بأرض الشّام","https://www.poetsgate.com/ViewPoem.aspx?id=93800",""]],"verses":[["مُعَطِّلاً بَعدَ طولِ مَلبَثِهِ","مَنازِلاً قَد عَمَرتُها زَمَنا",0,"ن",2,0],["مُعطِياً لِلعِدا بِهِ الواهِنَ الضا","رِعَ بَعدَ الأَنصارِ وَالأَعوانِ",1,"ن",1,0],["مُعطىً عِناناً مِنَ النُعمى فَقُدتَ بِهِ","تَغايُرَ الدَهرِ بِالأَيّامِ وَالدُوَلِ",2,"ل",1,0],["معطي جواد الخيل للمعتفي","وخلفه الصرّة كالمهره",3,"ر",2,0],["معطَّل السمع من العذَّال","فحالهُ مغير بحال",4,"ل",1,0],["مُعطىً لسانَ فمٍ معطىً لسان يدٍ","إنْ أجملا فصّلا أو فسَّرا شرَحا",5,"ح",2,0],["مُعطي الكَواعِبِ وَالجُردِ السَلاهِبِ وَال","بيضِ القَواضِبِ وَالعَسّالَةِ الذَبُلِ",6,"ل",1,0],["مُعطىً مِنَ المَجدِ مُزدادٌ بِرَغبَتِهِ","تَجري عَلى سَنَنٍ مِنهُ وَأُسلوبِ",7,"ب",1,0],["مُعطِياً في وِصالِهِ في كَرى النَو","مِ الَّذي كانَ مانِعاً في صُدودِه",8,"د",2,0],["مُعَطَّلَةٌ بَينَ السَلُوِّ لِفَقدِهِ","وَقَصرُ غَرامي في هَواهُ مَشيدُ",9,"د",1,0],["مُعَطَّرُ الأَردان","ذَكِيُّ الأَنفاسِّ عَذبُ الفَم",10,"م",1,0],["مُعَطَّلٌ فَالحُلى مِنهُ مُحَلَّأَةٌ","تَغنى الدَراري عَن التَقليدِ بِالدُرَرِ",11,"ر",1,0],["مُعطِياةٍ رُؤوسَهُنَّ إِذا شِئ","نَ وُقوفاً تَخالُها أَوتادا",12,"د",2,0],["معطاء كل رغبة وهابها","بتار كل عظيمة صمصامها",13,"م",3,0],["مُعطِياً مِنْ وِصَالِهِ في كرَى النّوْ","مِ الذي كانَ مانِعاً في صُدودِهْ",14,"د",2,0],["معط أخا كرم مرضٍ أخا ندم","معر أخا قرم مغنى ذي نهم",15,"م",1,1],["مِعْطيرةٌ وَنسيمُ الطِّيْبِ هالَتُها","تضوَّعتْ ليْلَكًا قد طارحَ الحَبَقا",16,"ق",2,0],["مُعْطٍ إذا ضَنَّ الغمامُ بقَطْرِه","رَوَّى جميعَ الأرضِ جودُ غُيوثه",17,"ث",2,0],["معطّر الروح بالآداب عالية","والزهر في دوحه بعض الأفانين",18,"ن",1,0],["مُعَطَّرَةٍ مِثلَ أِشجارِهِ","بِدُهنِ اللبان وَأَسحارِهِ",19,"ه",1,0],["مِعطاؤُها مِطعامُها مِطعانُها","مِقدامُها صَوّامُها قَوّامُها",20,"م",3,0],["معطى الحقوق لمن والى وقاطع من","عادى وَعاند منهم قط فتاك",21,"ك",1,0],["مُعَطَّلَةً إِلاَّ لَديْكَ حِياضُها","وَمَهْجُورَةً إِلاَّ إِلَيْكَ طَرِيقُها",22,"ق",3,0],["مُعطي الأُلوفِ وَطَعّانُ الأُلوفِ لَدى ال","هَيجا إِذا أُوقِدَت لِلحَربِ نيرانُ",23,"ن",1,0],["معطّل الإلهام","ميت الأسارير",24,"ر",1,0],["مُعطِي عطاءٍ قد غَمَر","أَصبح أَدناهُ البِدَر",25,"ر",1,0],["مُعطياً ضد ما لعمرُك يعطى","وهو مستيقظٌ أذًى من صدودِه",26,"د",2,0],["معطلُ اللبةِ إل","ا من حُليّ الغيَد",27,"د",1,0],["معطَّلَ المجلسِ والمنبرِ ال","مركوبِ عاري السرجِ رخوَ البِدادْ",28,"د",1,0],["معطي المعاقل كالعقائل","ما يقارعها سآمه",29,"م",2,0],["مُعطي اللّهى نبويّاتٌ مناقبُه","رحبُ الفنا نجلُ خيرِ الخلْقِ والرُسُلِ",30,"ل",1,0],["مُعطِي اللَّهَى نَبَوِيَّاتٌ مَنَاقِبُهُ","بَحرٌ جَرَى عَلقَمِيٌّ مُجَّ عَاسِلُهُ",31,"ل",2,0],["مُعطِي اللّهَى","رَحبُ الفَنَا",32,"ا",1,0],["مُعطِي اللَّهَى نَبَوِيَّاتٌ مَنَاقِبُهُ","غَيثُ النَّدَى مَورِدٌ أَشهَى مِنَ العَسَلِ",33,"ل",1,0],["مُعْطِياً رِبْقَتي أَكُفَّ ظِبَاءٍ","مُطِئاً أَخْمَصي رِقَابَ أُسُودِ",34,"د",1,0],["مُعْطي الشَّبيبَةَ ما تُحِبْ","بُ من البَطَالَةِ والمِرَاحِ",35,"ح",1,0],["مُعَطَّمٌ لا يَحِلُّ حِبوَتَه الطَّي","شُ وَلا يَستَخَفُّهُ النَّزَق",36,"ق",1,0],["مُعَطّرة في مِسكِ مَدحِك ذي الشّذى","فَفي نَفحِها قَد فاقَتِ المسك والقُسطا",37,"ط",2,0],["مُعطّرة مِن عطرِ مَدحِك نافِحاً","فَكانَ بِها أَشذى مِنَ المِسكِ وَالندِّ",38,"د",1,0],["معطّف على مهجة ظاميه","وتقذفها عَبْرة هاميه",39,"ي",2,1],["مُعطي الألوف ومِطعام الضيوف ومط","عانُ الصفوف ومُردي الحادث الجلل",40,"ل",1,0],["معطرة الأنفاس مهما نشرتها","وجدت بها من طيب أوصافكم نشرا",41,"ر",2,0],["مع طول عمر مستديمٍ في هنأ","عيشٍ رغيدٍ لا يدانيه عنا",42,"ن",2,0],["معطاء كل رغيبة وهابها","بتار كل عظيمة صمصامها",43,"م",3,0],["معطّران بما استنّا وما اقتفيا","طيبا كما ينفحُ النّوار والزّهرُ",44,"ر",1,0],["مُعطي القُرى وَالقِرى لِقاصِدِهِ","بِغَيرِ مَنٍّ وَالخَيلِ وَالخَوَلِ",45,"ل",1,0],["معطي الفتوة حقها","ومفرق البُدَر العظيمه",46,"م",2,0],["مُعطَّراتِ الرِحالِ قَد عَبِقَت","بِالمِسكِ مَما يُفَتّ في خِيَمِه",47,"م",2,0],["معطي البلاد واللهى","والخيل مرداً والخول",48,"ل",1,0],["معطرةَ الأعرافِ معلولةً للحمى","يمد بها كوني سنا وسناء",49,"ا",2,0],["مع طولِ صحبته لكلِّ طائفةٍ","من الخلائقِِ روحاً كان أو بدنا",50,"ن",2,0],["معطرة الأنفاس رائقة الحلى","هواها بقلبي في المهامة ساير",51,"ر",1,0],["معطياً ما ملكت قولاً وفعلاً","وفؤادي في أول الأَعطيات",52,"ت",1,0],["معطارةً لم يمس الطيب مفرقها","كحلاء ما مسحت عيناً من الكحل",53,"ل",1,0],["معطى الألوف ولا يَمُنَّ ببذْلها","إن شحَّ كلُّ مبخل مَنّانِ",54,"ن",1,0],["معطوفة وبنفسي يا ابن أم قفا","على الأخادع مثني ومعطوف",55,"ف",1,0],["مُعطي الطَّريفِ اسحّ كَفّاً مِن فَتىً","يُعطيك مِن جَبَلِ التَّليدِ الرَّاسي",56,"س",2,0],["معط الذئاب الناطقات هم الأولى","جعلوا التصوّف صنعة للداجل",57,"ل",1,0],["معطي الهبات الجم مبتدئاً فلا","يحتاج راجي رفده أن يطلبا",58,"ب",2,0],["مُعَطَّرَ الذَيلِ","في أُفُقٍ داجِ",59,"ج",1,0],["معطرة الأَنفاس معسولة اللما","مهفهفة الأَعطاف وَهنانة القوى",60,"و",2,0],["معط على شكر الصنيع وكفره","ما كل ما سقت الغمائم يثمر",61,"ر",1,0],["معطي الكرائم مانعٌ عن جاره","ما لا يسر أبو الغياث القسو",62,"و",1,0],["مُعَطَّلَة أَكنافُه عن زِيارةٍ","بعيد مدىً عن حُسَّرٍ ونَوادِب",63,"ب",1,0],["معطى الغنائم حمال المغارم فراج","العظائم بالخطية السلب",64,"ب",1,0],["معطرة الأردان مسك ختامها","مبراة مما بحرمتها يذري",65,"ر",2,0],["معطرة مهما تتم بذكائها","أهيل وداد أمحضت بوفائها",66,"ه",2,0],["مُعَطّرٌ عرفُهُ عرفاً ومكرمة","مخمّرٌ طينُهُ بالطُّهر والطيبِ",67,"ب",1,0],["معطر الجسم والثياب","الأغيد الأهيف الخرود",68,"د",1,0],["معطر الأبراد عذب اللمى","يا بأبي الأدعج والعاطر",69,"ر",1,0],["معطارة أرج النسيم بعرفها","عبقا وضوّعت الثرى أردانها",70,"ن",3,0],["معطفها الزيتي لي بهجةٌ","يراودُ الخاطرَ إذ ألمحُ",71,"ح",1,0],["معَ طَيرِ نَهرِ الكرخِ أبعثُ لهفتي","ويقودُه للياسمينِ غَرامُ",72,"م",1,0],["معطرا من مجاني أريحيتهم","روضا تنفس عن روح وريحان",73,"ن",1,0],["معطاءُ لا تشري الرخيصَ وإنّها","تعطي وتمنعُ ما تشاءُ وإنْ غلتْ",74,"ت",1,0],["مع طلّ الصباح باكره الن","ور على وجنة التلال الندية",75,"ي",2,0],["معطى الحقوقِ لمن والي وقاطعُ منْ","عادى وعاندَ منهمْ قطع َ فشاكِ",76,"ك",1,0],["معطفي العطر زكيٌ إنما","هزّه الوجد وعن روحي جفَل",77,"ل",1,0],["معطاءة كنتم على","أكتافها كم تصعدونْ",78,"ن",1,0],["معطرةٍ بمسوك الجنان","ونار اليقين بنور اللزام",79,"م",1,0]]}