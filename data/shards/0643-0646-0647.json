ذكر لربك وابقَ العمر متصلا","https://www.poetsgate.com/ViewPoem.aspx?id=192168",""],[5431,"كنه الحياة ...","https://www.poetsgate.com/ViewPoem.aspx?id=203124",""],[5455,"صدفة","https://www.poetsgate.com/ViewPoem.aspx?id=213951",""],[5480,"خزني بالعين","https://www.poetsgate.com/ViewPoem.aspx?id=1587",""],[5480,"الفداء","https://www.poetsgate.com/ViewPoem.aspx?id=9889",""],[5525,"الغراب اللي نعق","https://www.poetsgate.com/ViewPoem.aspx?id=7210",""],[5573,"جيت اعبر شعوري يوم ليلي سكن","https://www.poetsgate.com/ViewPoem.aspx?id=204545",""],[5573,"عبرتك فعل البليد ومكسبه وإفلاسه","https://www.poetsgate.com/ViewPoem.aspx?id=206490",""],[5652,"ليه الفساد بموطني له رياده","https://www.poetsgate.com/ViewPoem.aspx?id=176979",""],[5694,"من العايدين","https://www.poetsgate.com/ViewPoem.aspx?id=132100",""],[5732,"حل الرحيل وفرقوا شمل الاحباب","https://www.poetsgate.com/ViewPoem.aspx?id=177871",""],[5732,"قالوا علامك","https://www.poetsgate.com/ViewPoem.aspx?id=177885",""],[5732,"صفقت بالأصبع","https://www.poetsgate.com/ViewPoem.aspx?id=177955",""],[5732,"الملحمة الزايدية","https://www.poetsgate.com/ViewPoem.aspx?id=177865",""],[5732,"وناديت من حولي","https://www.poetsgate.com/ViewPoem.aspx?id=177827",""],[5747,"سموم الهجر","https://www.poetsgate.com/ViewPoem.aspx?id=61670",""],[5747,"بين فرح وبين جرح","https://www.poetsgate.com/ViewPoem.aspx?id=61682",""],[5756,"ثامن السبع العجايب","https://www.poetsgate.com/ViewPoem.aspx?id=5422",""],[5756,"حد علمي","https://www.poetsgate.com/ViewPoem.aspx?id=5421",""],[5815,"شهْدُ الشّهيد","https://www.poetsgate.com/ViewPoem.aspx?id=196848",""],[5848,"تنطفي نجمه","https://www.poetsgate.com/ViewPoem.aspx?id=53175",""],[5848,"ست الكل","https://www.poetsgate.com/ViewPoem.aspx?id=53093",""],[5848,"مشكلة قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=53446",""],[5853,"صدى الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=175640",""],[5956,"الحب الخائب","https://www.poetsgate.com/ViewPoem.aspx?id=181997",""],[6001,"أبو أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=315",""],[6113,"السالفه...............!!!","https://www.poetsgate.com/ViewPoem.aspx?id=41916",""],[6115,"ياوجودي يوم شفت الديره المهجوره","https://www.poetsgate.com/ViewPoem.aspx?id=181608",""]],"verses":[["كَنَهارِ المَصيَفِ حراً وَكرباً","وَلَيالي الشِتاءِ بَرداً وَطولا",0,"ل",2,0],["كُن هَزاراً في عُشِّهِ يَتَغَنّى","وَمَع الكَبلِ لا يُبالي الكُبولا",1,"ل",2,0],["كَنَّها اللَهُ في مَكانٍ خَفِيٍّ","وَخَفيٍ مَكانُها لَو خَفيتُ",2,"ت",1,0],["كنها تقول أنّا.....؟ ترانا مرغمين","ومن عادتك يالسمح.. تقبل الاعتذار",3,"ر",1,0],["كنها.؟ لاقالت . أرررررررحب.؟ على الررررأأ ترتكي","أأأتحفاها. وأخلص. وتوها. باديه",4,"د",3,0],["كنّه سحابة حلم وتطير بك فوق","وتطير .. ولا ودّك انها تنزلك",5,"ك",1,0],["كنهدها حين يبدو","في ثوب لاذ معصفر",6,"ر",1,0],["كنهارٍ فيه نهرٌ","مده ليلٌ بهيمُ",7,"م",1,0],["كَنهُها عَزَّ في المِثالِ كَما عَز","زَ نَحيبٌ في رَأيِهِ بِالأَصالَه",8,"ل",2,0],["كن هكذا مثلي تكن مثله","وثم لا مصرٌ ولا سور",9,"ر",1,0],["كنّه عليِّ مْثاري","وذكّرني ما سلف",10,"ف",1,0],["كُنْ هيِّناً ليّناً سهلَ الطّبائِعِ لا","رَطْباً ولا يابساً في البَدوِ والحضَرِ",11,"ر",1,1],["كن هكذا في عز مُلكٍ آمنٍ","تُعطي وتمنعُ آخذاً ومواسي",12,"س",2,0],["كَنَّهَا طيرٍ عَلَى ريشه يشيل","للملاحه تاج مَا مثله مثال",13,"ل",1,0],["كَنَّهَا زهره عَلَى باقةْ خميل","عُوْدها مَعْ نسمةْ الأرياف مال",13,"ل",1,0],["كنّه اسمك يا الغلا قطرة مطر","أو عبيرٍ مِنْ شذا طيب الازهار",14,"ر",1,0],["كنّه سمك في برك","والقلب له قد هام",15,"م",1,0],["كنّه عَنْ الميعادْ بَطّل","لكِنّ هين الوَصل مِطّي",16,"ط",2,0],["كنّه لِمْبَشِّر وِصَل راسي","عِنْد يَعقوب ورِجَعْ شوفه",17,"ف",2,0],["كنه معناك جل عن كل وصف","عجزت فيه فكرة العرفاء",18,"ا",2,0],["كنههم غيب فلم يحط به","الا الذي شأنهم قد عظمه",19,"م",2,0],["كنهُ في دولتيه جاهاً وفضلاً","واجمع الفضل مثله في شتاتِه",20,"ت",2,0],["كنّه مكانٍ تستظل فيه وتشّد","وارج المكان اللي لنفسك توده",21,"د",2,0],["كنها من الشيراز تعطي تلاوين","حمرا يديهن بيض وخشومهن سود",22,"د",1,0],["كنه يحول على لب المسامع محول","وتلد له لدة الطيح لمقهورها",23,"ر",3,0],["كنْهُ البيان مشرّد في نسوة","قطّعن أيديَهن يا حواءنا",24,"ن",2,0],["كنّه من فؤاده الى طار منتوق","ماهو بللريضان لاهد مساح",25,"ح",1,0],["كنه يعرفك قبل يلقاك من مده","مع ان مابينك ومابينه أمواجه",26,"ج",2,0],["كنها بنت مخضبة الكفوف","وكنها بالشكل دلة شاذلية",27,"ي",2,0],["كنها الى طارت تصلفق على نار","يالله ياهادي دليل اتهدينا .",28,"ن",2,0],["كنّه من اشواقه بنفسه تربص","مشتاق للردميه وذبة البور",29,"ر",1,0],["كنّه من احدانا لفانا بيقتص","يعني على كل المهمّات مذكور",29,"ر",1,0],["كنه صباحٍ تكتسيه النواوير","والا كما ليلٍ من العز ضاوي",30,"ا",3,0],["كنّه صباحٍ عشق له طير","ويدندنه عشق وهْيامي",31,"م",2,0],["كنّها سيره عن النفس النقيّه","ولا تعيش إلا على رجم النقآوه",32,"ا",3,0],["كنها والشمس خصم ومشتكي","وبين ذيك وذيك عذبت السطور",33,"ر",1,0],["كنّه توقّف مع هذيك الثواني","والدم مايجري والاحساس مفقود",34,"د",1,0],["كنّهم .. يرجون من كسري .. متاع","ما دروا قلبي على الشدّه أبي !!",35,"ب",2,0],["كنه على موعد معك ياهادم اللذات","من شاف ماصابه يقول الله في عونه",36,"ن",2,0],["كنها من حلاها كل ليله عروس","خايفه من عيون الناس واحراجها",37,"ج",3,0],["كنها حفيدة شمس وطيور الارجاء","معلم حضاري صار واضح وموجود",38,"د",1,0],["كنه أبو حماد ناصر تميم الصخا","خذ م السحاب ومد خضر الفيافي",39,"ف",2,0],["كنها فناجيل قهوه عند ضيفان","لا لا بعد اكبر واوسع شويه",40,"ي",2,0],["كنه جذب قلبي ثم أصبح زبينه","وكن المشاعر لأبتوب بيتهكر",41,"ر",1,0],["كنّه من الجنّة على الأرض موقوع","حوري من الحور الذي يذكرنيّ",42,"ن",2,0],["كنّها بستان وردٍ ماحدٍ يعرف دروبه","غير قطرات المطر لاحوّلت فوقه تهامى",43,"م",2,0],["كنهّ مسوّي بين اﻻضلاع مهذاب","ومعمّرٍ في مهجة الروح بيته",44,"ت",2,0],["كن هامات الرجال إذ هوت","بهن مغناطيسها مركب",45,"ب",1,0],["كنّه يقول ان واقعنا لبس له قناع","وان وسوس ابليس في فرقا الوليف إدحره",46,"ر",2,0],["كنه يحشّ القلب مرهوف لمواس","حشّ الصّريم اللّي نواه اليبوسي",47,"س",2,0],["كُنْها تَكُنْكَ...وأطْلقْ كلَّ لهفتِها","كي تصطفيكَ لديها القلبَ والرجلا",48,"ل",2,0],["كنه الجمال هو الأخلاقُ إن حسُنت","ما قيمة الحُسنِ إذ يزهو بلا أدبِ",49,"ب",1,0],["كُنْهُهُ مِمَّا تَنَاهَتْ عِنْدَهُ","جَائِلاتُ الفِكْرِ مِنْ أنْ تَلِجَا",50,"ج",2,0],["كنهَ المؤامرة التي","أعيت منفذها اللعين",51,"ن",1,0],["كنه الغرام حلاوةٌ وعذوبةٌ","مهما اعترتنا علةٌ ونحولُ",52,"ل",1,0],["كنه الحقيقة قلب فيه متصلٌ","بوجه ربك نوارٌ به اشتعلا",53,"ل",2,0],["كنه الحياة لذاذةٌ محمومةْ","والوقت حقل قنابلٍ ملغومةْ",54,"م",2,1],["كنّه ظبي , وعيوني ظلال صياد","يجفل قبل يرتد للجفن طرفه",55,"ف",2,0],["كنهن جمرن توقّد في فتيل","مزينات الزين به دوم الدوام",56,"م",1,0],["كنها صورة بدتلي واتركت صدري براح","شروى قفراي ٍ محيله خاويه ماها ضحوح",57,"ح",1,0],["كنه الشوك في ثوبي علق","يوذي الشوك ولا يقطع طريق",58,"ق",1,0],["كنهم يوم غابو عن عيوني وطن","دونه اسوار منفى والله المستعان",59,"ن",1,0],["كنه بسجن المصايب والبشر حراسه","ينتخي لين الضماير بالنفوس ابلاها",60,"ا",3,0],["كنه يسوق ل طيب قلبه براده","ياخذ مابين الغرب جوله ومنصاه !",61,"ا",2,0],["كنه مخيلٍ قام يدفع له مخيل","خيّل سحابه في ربابه وإستهل",62,"ل",1,0],["كنه بعيني لو غضب كل عتاب","بدرٍ تعلى كوكب الجدي وسهيل",63,"ل",1,0],["كنه الا حرك قوامه على الهون","غصن الا هب الهوا فيه مالا",64,"ل",2,0],["كنه ينابني بنومي منابي","ان هب لي من داعي الحب هباب",65,"ب",1,0],["كنه بجنات تظله غصونها","والنايف الطايل يحل رباه",66,"ا",2,0],["كنه بوسط الصين مرجان وارعاف","او دم جوف اللي تقود المخاشيف",67,"ف",1,0],["كنه صويبٍ مغز الرمح بضلاعه","ينزف وروحه من اوجاعه يودعها",68,"ع",3,0],["كنها ثبت العساكر يوم صفت برتصاف","والقوافي مقبلة لي بين مشي ودرهمه",69,"م",2,0],["كنه ارحم من همال المزن للزهر بذبوله","وانتي اقسى من هجير القيظ وسموم اللهايب",70,"ب",1,0],["كنها نكس البيارق على شط وغدير","ومثل لملمت الشتات بشتات اللملمه",71,"م",2,0],["كنهْرٍ في جِنَانِ الخُلْ","دِ ما أَرْغَى وما نَضبا",72,"ب",2,0],["كن هذا الصدق صار اليوم كافر","كن الاحلام اصبحت فينا سجينه",73,"ن",2,0],["كنها الفرق مابين الخطا والصواب","حلمها علم نوب ) ( وعلمها حلم نوب )",74,"ب",1,0],["كن هذا الشوق مخلوقٍ عشاني","سينه ) اتعبني ولا حصلت ( جيمه ) !",75,"م",2,0],["كنهرٍ عاد يسقيني فراتاً","ندى الزهرِ الجميلِ هنا شربتُ",76,"ت",1,0],["كنْهُ الحياة غرام لُذْ بفرحته","واهجر أساه وإلّا غالك الندمُ",77,"م",1,0],["كنَّه بقلبي شب لاهوب","شاقي وقلبي في تأزّيم",78,"م",1,0],["كنهاشيخه على الناس اجمعين","تعشق الهايج ولاتحب الذلول",79,"ل",1,0],["كنها تشكي ومما صابها مقهوره","مثل منهو يشكي الحرمان والهجراني",80,"ن",2,0],["كنها بنتن عروس بزينها مغروره","من يراها تفتنه يغدي لها عشقاني",80,"ن",2,0]]}