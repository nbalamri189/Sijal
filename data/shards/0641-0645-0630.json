ewPoem.aspx?id=199509",""],[4935,"باحراز العلوم بدت عطيه","https://www.poetsgate.com/ViewPoem.aspx?id=129476",""],[4935,"ووابور ركبناه بليل","https://www.poetsgate.com/ViewPoem.aspx?id=129349",""],[4935,"بدا وعلى المحب عطف","https://www.poetsgate.com/ViewPoem.aspx?id=129483",""],[4935,"بنيت بأسعد الأوقات داراً","https://www.poetsgate.com/ViewPoem.aspx?id=129481",""],[4935,"تبسم ثغر صفاء الزمن","https://www.poetsgate.com/ViewPoem.aspx?id=129487",""],[4959,"أَهْلَاً بِكَ يَا شَهْرَ الصِّيَام","https://www.poetsgate.com/ViewPoem.aspx?id=211445",""],[2177,"خليلي خلتكما تحسدان","https://www.poetsgate.com/ViewPoem.aspx?id=127094",""],[5010,"أنا والليل","https://www.poetsgate.com/ViewPoem.aspx?id=190311",""],[5080,"مدائن التمر","https://www.poetsgate.com/ViewPoem.aspx?id=184906",""],[5212,"فَقدَ الجَّواد","https://www.poetsgate.com/ViewPoem.aspx?id=212103",""],[5271,"ليالي بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=60069",""],[5277,"صرخةُ العراقيين","https://www.poetsgate.com/ViewPoem.aspx?id=199841",""],[5299,"مكابرةُ امرأة","https://www.poetsgate.com/ViewPoem.aspx?id=210536",""],[5302,"ما أعذب العشق","https://www.poetsgate.com/ViewPoem.aspx?id=200599",""],[592,"أشاقك من سعدي بتلك المنازل","https://www.poetsgate.com/ViewPoem.aspx?id=128861",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5408,"ظلان أنت","https://www.poetsgate.com/ViewPoem.aspx?id=190583",""],[5431,"اسم بقلبي يُكتبُ","https://www.poetsgate.com/ViewPoem.aspx?id=186919",""],[5431,"جوارح معتلة...","https://www.poetsgate.com/ViewPoem.aspx?id=208901",""],[5704,"المذاهب الاربعه...","https://www.poetsgate.com/ViewPoem.aspx?id=200005",""],[5725,"الى رحمة","https://www.poetsgate.com/ViewPoem.aspx?id=177499",""],[5736,"أنين قلب","https://www.poetsgate.com/ViewPoem.aspx?id=208863",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5906,"رسول وآل","https://www.poetsgate.com/ViewPoem.aspx?id=188071",""],[5937,"كأسٌ وناي","https://www.poetsgate.com/ViewPoem.aspx?id=211827",""],[5957,"أحبكَ أكثر","https://www.poetsgate.com/ViewPoem.aspx?id=11393",""],[5957,"حكايات (المسنجر)","https://www.poetsgate.com/ViewPoem.aspx?id=46453",""],[5957,"مساؤكَ","https://www.poetsgate.com/ViewPoem.aspx?id=53247",""],[6019,"لقاءُ (الخميس) عيدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=199489",""],[6031,"لقَلَّدْتَنِيها مِنَّةً لَيسَ تُجْحَدُ","https://www.poetsgate.com/ViewPoem.aspx?id=46341",""],[6093,"يا عاذلَ الدَّمْعِ إنْ أجراهْ إنسانُ ( البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176207",""],[6096,"من دون وداع","https://www.poetsgate.com/ViewPoem.aspx?id=177528",""],[6102,"سمسمة 2","https://www.poetsgate.com/ViewPoem.aspx?id=184414",""]],"verses":[["فَمُذ أَضاءَ المَشيبُ فودي","تَوَرَّعَ الزَورُ عَن مَزاري",0,"ر",2,0],["فَمُذْ كَتَبَ الْوَخْطُ المُلِمُّ بِعارِضي","حروفاً أتى فيها بمحض عتاب",1,"ب",1,0],["فمذ حان أن يخضلّ غصن اعتزازنا","ويرتع بعد اليبس رطباً ويخضرا",2,"ر",2,0],["فمذ بدا لي أن قد تساوى","في ذلك الغمر والنبيه",3,"ه",1,0],["فَمُذ خَلا الجَوُّ لِسَيفِ هاشِم","هَبّ هَبوب المُستَبدِّ الغاشِم",4,"م",1,0],["فَمُذ بَدَت لي وَاِلتَقَت","نَظرَتُها وَنَظرَتي",5,"ي",1,0],["فمُذْ بِنْتِ عنهُ صارَ أوحشَ من لظَىً","وأضيقَ من قبرٍ وأجدبَ من قَفْرٍ",6,"ر",1,0],["فمذ تولَّى الصِّبَا تبيَّنَ لي","أن الصِّبَا كان موجبَ الطربِ",7,"ب",1,0],["فَمُذ أَثَرتُ رِكابي عَنكَ مُرتَحِلاً","أَثَرتُ مَدحَكَ إِنشاءً وَإِنشادا",8,"د",2,0],["فَمُذ ثَناني الدَهرُ عَن رَبعِهِ","وَلَم يَكُن ذَلِكَ في حَدسي",9,"س",2,0],["فَمُذ لاحَ وَجهُ حَبيبي لَهُ","وَشاهَدَ أَنوارَهُ كَاللَهَب",10,"ب",1,0],["فَمُذ رَأَينا سُروراً في أَسِرَّتِهِ","تَبدو وَكَفّاً لَهُ بِالنَورِ مُختَضِبا",11,"ب",2,0],["فَمُذ سَلَّمتَ سَلَّمَتِ البَرايا","إِلَيَّ وَقيلَ كَلَّمَهُ الغَزالُ",12,"ل",1,0],["فَمُذ طالَ عُمدُ النَوى","جَعَلتُ إِلَيكَ الهَوى",13,"ه",3,0],["فَمُذ رَأى حِبّي إِلَيَّ مُحسِناً","أَساءَني فِعلاً وَساءَ ظَنّا",14,"ن",2,0],["فَمُذ صارَ مِنكِ الحُسنُ قِسماً كَقِسمِهِ","حَكَيتِ أَخاكِ البَدرَ في حالِ تِمِّهِ",15,"ه",1,0],["فَمُذ بَسَمَت ثَنايا الأَمنِ نادى","أَنا اِبنُ جَلا وَطَلّاعُ الثَنايا",16,"ا",3,0],["فَمُذ رَآهُم قِياماً حَولَ مَأمَنِهِ","يَبغُونَ ساحَتَهُ بِالشَّرِّ وَالفَقَمِ",17,"م",1,0],["فَمُذ أفَارِقُ شَمسَ الفَضلِ كَيفَ أرى","وَنَاظِرِي فِي ظَلاَمٍ غَيرَ مُنفَصِلِ",18,"ل",1,0],["فَمُذِيبَةٌ مِنْكَ القُوَى","فَمُدِيلَةٌ مِنْهَا سُؤَادِكْ",19,"ك",1,0],["فمذْ مدةٍ من دَهْرنا لم نقفْ على","رسائلَ منكم لا ولا عِلم مُخبِرِ",20,"ر",1,0],["فَمُذ سُدتَ لَم تَطمَح بِذي هِمَّةٍ مُنىً","وَمُذ جُدتَ لَم يَسنَح لِذي مِنَّةٍ ذِكرُ",21,"ر",1,0],["فَمُذ باتَ يَحرُسُهُم لَم يَنَم","وَمُذ ظَلَّ يَكلَؤُهُم ما غَفَل",22,"ل",1,0],["فَمُذ أَصبَحَت أَذنابُنا وَهيَ أَرؤُسٌ","غَدَونا بِحُكم الطَبعِ نَمشي إَلى وَرا",23,"ر",2,0],["فَمُذ خَطَّ المَشيبُ عَدِمتُ صَحبي","لَقَد كانَ المَشيبُ غَرابَ بَينِ",24,"ن",1,0],["فَمُذْ شِمْتُ بَرْقَ الْعُلاَ وَالْهُدَى","لَدى بَرَكاتِ الْعُلاَ مُسْتَطِيرَا",25,"ر",2,0],["فَمُذ رَأَيتُ البيضَ قَد أَعرَضنَ عَن","شَيبٍ بَدا بِرَأسِ شَيخٍ هِمِّ",26,"م",1,0],["فَمُذ شيّدَ القصرُ السعيدُ وأشرقت","سَعادَتهُ زالَ الخفاء ونبزهُ",27,"ز",2,0],["فَمذ اِشتكى دانت بوَأد بَناتها","إِذ ما لها إلّا لديه مهورُ",28,"ر",1,0],["فَمُذْ مُنِعْتُ جَوابي","عَنهُ لأَمْرٍ عَنَاني",29,"ن",2,0],["فَمُذ صانَ وَجهي صُنتُ فِكري لِمَدحِهِ","فَوَجهي لَهُ مِن قَبلِ فِكرِيَ مادِحُ",30,"ح",1,0],["فَمُذْ هَبَّ من سُكر الخَبال ورَوقه","رأى الدهر لاشيئاً وليس له كُنه",31,"ه",1,0],["فمذ حل روحُ القدس إكسيرَ نفسنا","رأينا ضياء السر بالسر زالغا",32,"غ",2,0],["فمذ شام شمعون الصفا برقَ نوره","أجاب بصوتٍ كادت الصمُّ تَسمع",33,"ع",1,0],["فمذْ أبْصَرتُ لَيلَ الفَرْعِ مِنْها","رأيت الفَرْقَ مثلَ الصُّبحِ ظَاهِرْ",34,"ر",1,0],["فمذلاح شيبي على عارضي","سلوت الحبيب وعني سلا",35,"ل",2,0],["فمذهبنا إذا ما أطلقوه","وقربه النجوم من الصحاب",36,"ب",1,0],["فمذهبُ العاشقين ذاك فقدْ","أضحى عليه كلامهم واحدْ",37,"د",1,0],["فَمُذْ كنتُ طفلاً رأيتُ الحسين","مَناراً إلى ضوئِهِ أنتَمي",38,"م",2,0],["فَمُذ بُدِّلَت مِن نَرجِسٍ بِشَقائِقٍ","أَعادَت لُجَينَ الدَمعِ مِنّي عَسجَدا",39,"د",2,0],["فمذ وقعت وقوع النسر خافهم","من كان مجتمعاً من ذلك الرخم",40,"م",1,0],["فمذ لاحَ في فجر الحِمايةَ بندُهَأ","وأشرقَ فينا نجمُه المتوقِّدُ",41,"د",1,0],["فمذ عادَ عادَ وأَرْوى البلادَ","وأَعْتَب بالرِّي من قد عَتب",42,"ب",1,0],["فَمَذحِجُ قَد نَأى مِن بَعدِ قُربٍ","فَيا لِلَّهِ يا لِلمُسلِمينا",43,"ن",2,0],["فمُذ رآهُ حسين فاض مدمعهُ","وقلبهُ ذابَ من وجدٍ ومن حزنِ",44,"ن",1,0],["فمُذ دعاهُ ربّه عاجلاً","مَضى إلى اللّه بقلبٍ سليم",45,"م",1,0],["فمُذ غبتَ ذُبنا أَسىً والتياعاً","ولم تذقِ العينُ طعمَ الرُّقاد",46,"د",1,0],["فمذ اشرفت عيني على زهرة الرُّبى","وقد كللتها بالجُمانِ يدُ القطر",47,"ر",1,0],["فمذ طلعت بجسمي والفؤاد بها","ألفيت قلبي من خوض الفلا أفلا",48,"ل",2,0],["فَمُذْ رَآنِي جرحتُ وجْنَتَهُ","أقتَصَّ باللحظِ والجروحُ قِصَاصْ",49,"ص",1,0],["فَمَذهبهُ في ملكهِ العدلُ والتُقى","وملّتهُ في الأمةِ البأسُ والجودُ",50,"د",1,0],["فمذ ظهرت منصوبةً جُزِمَتْ بها","ظهورُ العدى، من رفعها انخفض الكُفْر",51,"ر",1,0],["فمذ أتى بادر النبي إلى","عينيه داواهما بتفلته",52,"ت",2,0],["فمذ أتته قريش اقتحموا","صاح عليهم بهول زعقته",52,"ت",2,0],["فمذ رأيت أنه","أدار لي ظهر المجنّ",53,"ن",1,0],["فمذ رأيت بني الإنسان من رجل","يكسي العراة وطاهٍ يطعمُ الكاسي",54,"س",2,0],["فمذ عرفوه لم يروموا تعرفا","إلى غيره والغير ثم تعدما",55,"م",2,0],["فَمُذ زَمَنٍ ما كُنتَ ترجُوهُ ذاؤُهُ","فَذِي ظُرَفا ديمانَ والدَّهرُ الاَقدَمُ",56,"م",1,1],["فَمُذْ جُلِيَتْ مَحَاسِنُهُ بَدَا لِي","مُحَيًّا فِي أَسِرَّتِهِ الجَمَالُ",57,"ل",1,1],["فَمُذ غِبتُمُ لَم أَنسَ واللَهِ ذِكرَكم","وَلَم أعرِفِ السُلوانَ عَنكم وَلا الصَبرا",58,"ر",2,0],["فَمُذ ظَفِرَ الإِسلامُ مِنهُ بِصارِمٍ","تَيَقَّنَ أَنَّ الشِركَ لا شَكَّ مُقصَمُ",59,"م",1,0],["فمذ ثوت كسفت نوريهما فهما","من بعدها كضريرٍ في الدجى تاها",60,"ا",3,0],["فمذ ابت مقلتي الأانسكاب دم","واشرفت كبدي الحرا على التلف",61,"ف",1,0],["فمذ أطالوا اللوم في زلتي","قلت فلي ذنب فما حيلتي",62,"ي",1,0],["فمذ عرفناه صافانا مودّته","لكن ينكرنا من ليس يعرفنا",63,"ن",2,0],["فمذ رأوا المقصّ تبادرُوه","وزاحم أوّلَ الشبلين ثاني",64,"ن",2,0],["فمذحج قد نأونا بعد قرب","فيا الله، يا للمسلمينا",65,"ن",2,0],["فَمُذ تَعَلَّقتُ يا سَيدِى بِجَانِبكُم","فَقَطُّ ما خابَ لِى ظَنِّى وَلاَ سُؤُلِى",66,"ل",2,0],["فَمذ لَبَّتِ الأَروَاحُ رُوحِى لَهُ هَوَى","تَعَشَّقتُ فِيهِ قَبلَ أَن أعرِفَ الهَوَى",67,"ه",3,0],["فمُذْ خبَّروني أنَّ كوكبَ خدِّهِ","يقاربهُ المرّيخُ أحسستُ بالشرِّ",68,"ر",1,0],["فَمُذ رأى النازحُ المسكين مَسكَنَهُ","في قُطرِكَ الرَحبِ لم يُنكب بإيذاء",69,"ا",2,0],["فمذ رأى حلاوة ال","ألفاظ منّي ضحكا",70,"ك",2,0],["فمذهبي شرعُ النبي","الهاشميِّ العربي",71,"ب",2,0],["فمذ رأى الله قلب الدين منكسراً","وليس إن لم تعد بالفتح ينجبر",72,"ر",1,0],["فمذ قحموا منه في دارها","عريناً أبى الليث أن يقحما",73,"م",2,0],["فَمُذ سَمَحَ الدَّهر اللَّئيمُ بِقُربِهِ","صَفَحنا لَهُ عَمّا مَضى مِن صَنيعِهِ",74,"ع",2,0],["فمذ غاض بحرُ النَّدى لم تَزَل","بِحارُ الدموع عليه تسِيل",75,"ل",1,0],["فمذهبنا أنا بالاسناد نعتني","إذا صحّحَ الاسناد صح لنا الوصل",76,"ل",1,0],["فمذ نعيت نأت عنها المنى وغدت","أبواب نيل الغنى مسدودة السبل",77,"ل",1,0],["فمذ جاء رسمك تم سروري","وقد صرت عندي روحاً وجسما",78,"م",2,0],["فمذ قادنا هادي الدلييل بما قضى","به العقل والنقل اليقينان والذكر",79,"ر",1,0],["فمذ غلبوا والشاه فر مقاطعا","غدا كل فيل كالعنيف المهرول",80,"ل",1,0],["فمذ أتيت إلى الزوراء صادفني","مؤرخ متقن قد جاوز الحقبا",81,"ب",2,0],["فمذ لقيتك كل الهم فارقني","وألف اللَه بين الروح والبدن",82,"ن",1,0],["فَمذ عاتبتني قُلت معتَذِراً لَها","حَملت العَصا لا العَجز أَوجب حَملَها",83,"ل",3,0],["فَمُذ فَتَحت لَهُ باعي أُعانقه","مَضى وزود قَلبي الهَم وَالقَلَقا",84,"ق",2,0],["فمذ تحامقت قد كساني","حمقي وقد عالني جنوني",85,"ن",2,0],["فمذ استبان الصدق قلت مؤرخاً","قد كذب الآمال نأيك صادق",86,"ق",1,0],["فمُذ قامَ عَبدُ اللَّهِ لِلَّهِ ناهِضاً","بِنَهضَةِ ضِرغامٍ عَظيمٍ مِنَ الأُسدِ",87,"د",1,0],["فمذ رأتني بين أيدي الجوى","منجدلاً في الترب خالي الجذل",88,"ل",1,0],["فمذ لم تزل حسناك حياً وميتاً","علي ومن يجحد أخا الجود يلحد",89,"د",1,0],["فَمُذ تَرى سَمعنا هَذا القال","زادَ بِنا الوسواس وَالبلبالُ",90,"ل",1,0],["فمذ آن أن يأتي لنحويَ عطرها","إذا الريحُ تُذري عطرَها كلّ جانب",91,"ب",1,0],["فمذ أحتسي جاماً وأرشف ثانياً","يفر الأسى عني بجيش مب