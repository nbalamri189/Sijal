{"poems":[[53,"ليس على الشيب للغواني","https://www.aldiwan.net/poem30431.html","مجزوء البسيط"],[77,"جهاد هوى لكن بغيري ثوابي","https://www.aldiwan.net/poem36716.html","الطويل"],[88,"تبلج أفق الشرق من بعدما اغبرا","https://www.aldiwan.net/poem44824.html","الطويل"],[85,"رأيت قومي يذم بعض","https://www.aldiwan.net/poem7769.html","مخلع البسيط"],[85,"الأمر آل أحسن المآل","https://www.aldiwan.net/poem7912.html","الرجز"],[85,"لست بناس ليلة","https://www.aldiwan.net/poem8051.html","مجزوء الرجز"],[62,"أقول وقد غال الردى من أحبه","https://www.aldiwan.net/poem52429.html","الطويل"],[62,"قد كان لي في شبيبتي فرح","https://www.aldiwan.net/poem52490.html","المنسرح"],[66,"لم تتبع الأمر إلا كان أو كادا","https://www.aldiwan.net/poem38505.html","البسيط"],[66,"مملوكك اليوم أبو حبه","https://www.aldiwan.net/poem38646.html","السريع"],[66,"وبركة نيلوفر زهرها","https://www.aldiwan.net/poem38804.html","المتقارب"],[66,"ما ماس منعطفا في قرطق وقبا","https://www.aldiwan.net/poem39203.html","البسيط"],[66,"تنبأ فيك قلبي فاسترابت","https://www.aldiwan.net/poem39512.html","الوافر"],[66,"شكوت إليك الجوى","https://www.aldiwan.net/poem39645.html","مجزوء المتقارب"],[66,"لا بلغ الحاسد ما تمنى","https://www.aldiwan.net/poem39916.html","الرجز"],[66,"فضحت بدور التم إذ فقتها حسنا","https://www.aldiwan.net/poem39933.html","الطويل"],[66,"توسد في الفلا أيدي المطايا","https://www.aldiwan.net/poem41575.html","الوافر"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[81,"أذوت سموم النوى ريحانة الأمل","https://www.aldiwan.net/poem61327.html","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55092","الكامل"],[129,"سلام كماء الورد ديف بعنبر","https://www.aldiwan.net/poem50608.html","الطويل"],[144,"تمني العلى سهل ومنهجها وعر","https://www.aldiwan.net/poem11763.html","الطويل"],[144,"إباؤك للمجد أن يبتذل","https://www.aldiwan.net/poem11800.html","المتقارب"],[183,"تعجب قوم من تأخر حالنا","https://www.aldiwan.net/poem67057.html","الطويل"],[233,"بكيت أسى وحق على التصابي","https://www.aldiwan.net/poem14732.html","الوافر"],[238,"إلى ما فؤادي يذوب زفيرا","https://www.aldiwan.net/poem18193.html","المتقارب"],[283,"في مدحي الصاحب ماض عزمي","https://www.aldiwan.net/poem32459.html","الرجز"],[306,"حمى الصادق القصر السعيد وحرزه","https://www.aldiwan.net/poem56508.html","الطويل"],[306,"رسل البشائر ورد وصدور","https://www.aldiwan.net/poem56545.html","الخفيف"],[349,"قد كان يوصف نظمي","https://www.aldiwan.net/poem20757.html","المجتث"],[367,"وأرضيت فيك الحب والحب جائر","https://www.aldiwan.net/poem17170.html","الطويل"],[378,"طغى دهرنا بالشبه مذ ضل أهله","https://www.aldiwan.net/poem59205.html","الطويل"],[378,"لنا الحجر المرموز في الكتب سره","https://www.aldiwan.net/poem59333.html","الطويل"],[378,"جلا مذ تجلى أعينا فيك تدمع","https://www.aldiwan.net/poem59341.html","الطويل"],[403,"ظننت وقد نظرت إلى سناها","https://www.aldiwan.net/poem46672.html","الوافر"],[404,"أما آن للقلب أن يعقلا","https://www.aldiwan.net/poem33484.html","المتقارب"],[404,"وقفت على السؤال وما حواه","https://www.aldiwan.net/poem34131.html","الوافر"],[433,"لم يلف للهون عاشق جاحد","https://www.aldiwan.net/poem12471.html","المنسرح"],[466,"في رحاب الحسين","https://www.aldiwan.net/poem59034.html","عموديه"],[469,"لقد جار ما تشكوه في الحكم واعتدا","https://www.aldiwan.net/poem60213.html","الطويل"],[516,"صحت بدولتك الأيام من سقم","https://www.aldiwan.net/poem12269.html","البسيط"],[539,"عرفت مقام القوم إذ بت تجهد","https://www.aldiwan.net/poem48236.html","عموديه"],[576,"رأت منك رائيتي ما تحب","https://www.aldiwan.net/poem3095.html","المتقارب"]],"verses":[["فَمُذ أَضاءَ المَشيبُ فودي","تَوَرَّعَ الزَورُ عَن مَزاري",0,"ر",2,0],["فَمُذْ كَتَبَ الْوَخْطُ المُلِمُّ بِعارِضي","حروفاً أتى فيها بمحض عتاب",1,"ب",1,0],["فمذ حان أن يخضلّ غصن اعتزازنا","ويرتع بعد اليبس رطباً ويخضرا",2,"ر",2,0],["فمذ بدا لي أن قد تساوى","في ذلك الغمر والنبيه",3,"ه",1,0],["فَمُذ خَلا الجَوُّ لِسَيفِ هاشِم","هَبّ هَبوب المُستَبدِّ الغاشِم",4,"م",1,0],["فَمُذ بَدَت لي وَاِلتَقَت","نَظرَتُها وَنَظرَتي",5,"ي",1,0],["فمُذْ بِنْتِ عنهُ صارَ أوحشَ من لظَىً","وأضيقَ من قبرٍ وأجدبَ من قَفْرٍ",6,"ر",1,0],["فمذ تولَّى الصِّبَا تبيَّنَ لي","أن الصِّبَا كان موجبَ الطربِ",7,"ب",1,0],["فَمُذ أَثَرتُ رِكابي عَنكَ مُرتَحِلاً","أَثَرتُ مَدحَكَ إِنشاءً وَإِنشادا",8,"د",2,0],["فَمُذ ثَناني الدَهرُ عَن رَبعِهِ","وَلَم يَكُن ذَلِكَ في حَدسي",9,"س",2,0],["فَمُذ لاحَ وَجهُ حَبيبي لَهُ","وَشاهَدَ أَنوارَهُ كَاللَهَب",10,"ب",1,0],["فَمُذ رَأَينا سُروراً في أَسِرَّتِهِ","تَبدو وَكَفّاً لَهُ بِالنَورِ مُختَضِبا",11,"ب",2,0],["فَمُذ سَلَّمتَ سَلَّمَتِ البَرايا","إِلَيَّ وَقيلَ كَلَّمَهُ الغَزالُ",12,"ل",1,0],["فَمُذ طالَ عُمدُ النَوى","جَعَلتُ إِلَيكَ الهَوى",13,"ه",3,0],["فَمُذ رَأى حِبّي إِلَيَّ مُحسِناً","أَساءَني فِعلاً وَساءَ ظَنّا",14,"ن",2,0],["فَمُذ صارَ مِنكِ الحُسنُ قِسماً كَقِسمِهِ","حَكَيتِ أَخاكِ البَدرَ في حالِ تِمِّهِ",15,"ه",1,0],["فَمُذ بَسَمَت ثَنايا الأَمنِ نادى","أَنا اِبنُ جَلا وَطَلّاعُ الثَنايا",16,"ا",3,0],["فَمُذ رَآهُم قِياماً حَولَ مَأمَنِهِ","يَبغُونَ ساحَتَهُ بِالشَّرِّ وَالفَقَمِ",17,"م",1,0],["فَمُذ أفَارِقُ شَمسَ الفَضلِ كَيفَ أرى","وَنَاظِرِي فِي ظَلاَمٍ غَيرَ مُنفَصِلِ",18,"ل",1,0],["فَمُذِيبَةٌ مِنْكَ القُوَى","فَمُدِيلَةٌ مِنْهَا سُؤَادِكْ",19,"ك",1,0],["فمذْ مدةٍ من دَهْرنا لم نقفْ على","رسائلَ منكم لا ولا عِلم مُخبِرِ",20,"ر",1,0],["فَمُذ سُدتَ لَم تَطمَح بِذي هِمَّةٍ مُنىً","وَمُذ جُدتَ لَم يَسنَح لِذي مِنَّةٍ ذِكرُ",21,"ر",1,0],["فَمُذ باتَ يَحرُسُهُم لَم يَنَم","وَمُذ ظَلَّ يَكلَؤُهُم ما غَفَل",22,"ل",1,0],["فَمُذ أَصبَحَت أَذنابُنا وَهيَ أَرؤُسٌ","غَدَونا بِحُكم الطَبعِ نَمشي إَلى وَرا",23,"ر",2,0],["فَمُذ خَطَّ المَشيبُ عَدِمتُ صَحبي","لَقَد كانَ المَشيبُ غَرابَ بَينِ",24,"ن",1,0],["فَمُذْ شِمْتُ بَرْقَ الْعُلاَ وَالْهُدَى","لَدى بَرَكاتِ الْعُلاَ مُسْتَطِيرَا",25,"ر",2,0],["فَمُذ رَأَيتُ البيضَ قَد أَعرَضنَ عَن","شَيبٍ بَدا بِرَأسِ شَيخٍ هِمِّ",26,"م",1,0],["فَمُذ شيّدَ القصرُ السعيدُ وأشرقت","سَعادَتهُ زالَ الخفاء ونبزهُ",27,"ز",2,0],["فَمذ اِشتكى دانت بوَأد بَناتها","إِذ ما لها إلّا لديه مهورُ",28,"ر",1,0],["فَمُذْ مُنِعْتُ جَوابي","عَنهُ لأَمْرٍ عَنَاني",29,"ن",2,0],["فَمُذ صانَ وَجهي صُنتُ فِكري لِمَدحِهِ","فَوَجهي لَهُ مِن قَبلِ فِكرِيَ مادِحُ",30,"ح",1,0],["فَمُذْ هَبَّ من سُكر الخَبال ورَوقه","رأى الدهر لاشيئاً وليس له كُنه",31,"ه",1,0],["فمذ حل روحُ القدس إكسيرَ نفسنا","رأينا ضياء السر بالسر زالغا",32,"غ",2,0],["فمذ شام شمعون الصفا برقَ نوره","أجاب بصوتٍ كادت الصمُّ تَسمع",33,"ع",1,0],["فمذْ أبْصَرتُ لَيلَ الفَرْعِ مِنْها","رأيت الفَرْقَ مثلَ الصُّبحِ ظَاهِرْ",34,"ر",1,0],["فمذلاح شيبي على عارضي","سلوت الحبيب وعني سلا",35,"ل",2,0],["فمذهبنا إذا ما أطلقوه","وقربه النجوم من الصحاب",36,"ب",1,0],["فمذهبُ العاشقين ذاك فقدْ","أضحى عليه كلامهم واحدْ",37,"د",1,0],["فَمُذْ كنتُ طفلاً رأيتُ الحسين","مَناراً إلى ضوئِهِ أنتَمي",38,"م",2,0],["فَمُذ بُدِّلَت مِن نَرجِسٍ بِشَقائِقٍ","أَعادَت لُجَينَ الدَمعِ مِنّي عَسجَدا",39,"د",2,0],["فمذ وقعت وقوع النسر خافهم","من كان مجتمعاً من ذلك الرخم",40,"م",1,0],["فمذ لاحَ في فجر الحِمايةَ بندُهَأ","وأشرقَ فينا نجمُه المتوقِّدُ",41,"د",1,0],["فمذ عادَ عادَ وأَرْوى البلادَ","وأَعْتَب بالرِّي من قد عَتب",42,"ب",1,0]]}