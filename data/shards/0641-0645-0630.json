{"poems":[[53,"ليس على الشيب للغواني","https://www.aldiwan.net/poem30431.html","مجزوء البسيط"],[77,"جهاد هوى لكن بغيري ثوابي","https://www.aldiwan.net/poem36716.html","الطويل"],[88,"تبلج أفق الشرق من بعدما اغبرا","https://www.aldiwan.net/poem44824.html","الطويل"],[85,"رأيت قومي يذم بعض","https://www.aldiwan.net/poem7769.html","مخلع البسيط"],[85,"الأمر آل أحسن المآل","https://www.aldiwan.net/poem7912.html","الرجز"],[85,"لست بناس ليلة","https://www.aldiwan.net/poem8051.html","مجزوء الرجز"],[62,"أقول وقد غال الردى من أحبه","https://www.aldiwan.net/poem52429.html","الطويل"],[62,"قد كان لي في شبيبتي فرح","https://www.aldiwan.net/poem52490.html","المنسرح"],[66,"لم تتبع الأمر إلا كان أو كادا","https://www.aldiwan.net/poem38505.html","البسيط"],[66,"مملوكك اليوم أبو حبه","https://www.aldiwan.net/poem38646.html","السريع"],[66,"وبركة نيلوفر زهرها","https://www.aldiwan.net/poem38804.html","المتقارب"],[66,"ما ماس منعطفا في قرطق وقبا","https://www.aldiwan.net/poem39203.html","البسيط"],[66,"تنبأ فيك قلبي فاسترابت","https://www.aldiwan.net/poem39512.html","الوافر"],[66,"شكوت إليك الجوى","https://www.aldiwan.net/poem39645.html","مجزوء المتقارب"],[66,"لا بلغ الحاسد ما تمنى","https://www.aldiwan.net/poem39916.html","الرجز"],[66,"فضحت بدور التم إذ فقتها حسنا","https://www.aldiwan.net/poem39933.html","الطويل"],[66,"توسد في الفلا أيدي المطايا","https://www.aldiwan.net/poem41575.html","الوافر"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[81,"أذوت سموم النوى ريحانة الأمل","https://www.aldiwan.net/poem61327.html","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55092","الكامل"]],"verses":[["فَمُذ أَضاءَ المَشيبُ فودي","تَوَرَّعَ الزَورُ عَن مَزاري",0,"ي",1,0],["فَمُذْ كَتَبَ الْوَخْطُ المُلِمُّ بِعارِضي","حروفاً أتى فيها بمحض عتاب",1,"ب",1,0],["فمذ حان أن يخضلّ غصن اعتزازنا","ويرتع بعد اليبس رطباً ويخضرا",2,"ر",2,0],["فمذ بدا لي أن قد تساوى","في ذلك الغمر والنبيه",3,"ه",1,0],["فَمُذ خَلا الجَوُّ لِسَيفِ هاشِم","هَبّ هَبوب المُستَبدِّ الغاشِم",4,"م",1,0],["فَمُذ بَدَت لي وَاِلتَقَت","نَظرَتُها وَنَظرَتي",5,"ي",1,0],["فمُذْ بِنْتِ عنهُ صارَ أوحشَ من لظَىً","وأضيقَ من قبرٍ وأجدبَ من قَفْرٍ",6,"ر",1,0],["فمذ تولَّى الصِّبَا تبيَّنَ لي","أن الصِّبَا كان موجبَ الطربِ",7,"ب",1,0],["فَمُذ أَثَرتُ رِكابي عَنكَ مُرتَحِلاً","أَثَرتُ مَدحَكَ إِنشاءً وَإِنشادا",8,"د",2,0],["فَمُذ ثَناني الدَهرُ عَن رَبعِهِ","وَلَم يَكُن ذَلِكَ في حَدسي",9,"س",2,0],["فَمُذ لاحَ وَجهُ حَبيبي لَهُ","وَشاهَدَ أَنوارَهُ كَاللَهَب",10,"ب",1,0],["فَمُذ رَأَينا سُروراً في أَسِرَّتِهِ","تَبدو وَكَفّاً لَهُ بِالنَورِ مُختَضِبا",11,"ب",2,0],["فَمُذ سَلَّمتَ سَلَّمَتِ البَرايا","إِلَيَّ وَقيلَ كَلَّمَهُ الغَزالُ",12,"ل",1,0],["فَمُذ طالَ عُمدُ النَوى","جَعَلتُ إِلَيكَ الهَوى",13,"ه",3,0],["فَمُذ رَأى حِبّي إِلَيَّ مُحسِناً","أَساءَني فِعلاً وَساءَ ظَنّا",14,"ن",2,0],["فَمُذ صارَ مِنكِ الحُسنُ قِسماً كَقِسمِهِ","حَكَيتِ أَخاكِ البَدرَ في حالِ تِمِّهِ",15,"ه",1,0],["فَمُذ بَسَمَت ثَنايا الأَمنِ نادى","أَنا اِبنُ جَلا وَطَلّاعُ الثَنايا",16,"ا",3,0],["فَمُذ رَآهُم قِياماً حَولَ مَأمَنِهِ","يَبغُونَ ساحَتَهُ بِالشَّرِّ وَالفَقَمِ",17,"م",1,0],["فَمُذ أفَارِقُ شَمسَ الفَضلِ كَيفَ أرى","وَنَاظِرِي فِي ظَلاَمٍ غَيرَ مُنفَصِلِ",18,"ل",1,0],["فَمُذِيبَةٌ مِنْكَ القُوَى","فَمُدِيلَةٌ مِنْهَا سُؤَادِكْ",19,"ك",1,0]]}