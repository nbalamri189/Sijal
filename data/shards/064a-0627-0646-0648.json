[5320,"إلى رسول الله","https://www.poetsgate.com/ViewPoem.aspx?id=40398",""],[5376,"سكنت فؤادي في الضلوع وأودعت","https://www.poetsgate.com/ViewPoem.aspx?id=197588",""],[5419,"باحس إني باضيع مني","https://www.poetsgate.com/ViewPoem.aspx?id=32491",""],[5431,"إني لأشهدُ أنّ حبك معطفي","https://www.poetsgate.com/ViewPoem.aspx?id=186539",""],[5431,"فتردُ للعربي الأصيل حصانه؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=197839",""],[5431,"لابدّ أن نلقى الفرات معانقا","https://www.poetsgate.com/ViewPoem.aspx?id=201202",""],[5573,"خاتم ذهب","https://www.poetsgate.com/ViewPoem.aspx?id=200179",""],[5628,"في ذكرى شهيد الإنسانية الإمام الحسين عليه السلام","https://www.poetsgate.com/ViewPoem.aspx?id=178499",""],[5674,"يا نازك الحرف يا أسمى بلاغاتي","https://www.poetsgate.com/ViewPoem.aspx?id=189098",""],[5704,"لَيْلُ الهجران","https://www.poetsgate.com/ViewPoem.aspx?id=191213",""],[5720,"عاصِفةُ الحَزْم","https://www.poetsgate.com/ViewPoem.aspx?id=199941",""],[5732,"يا نور عيني","https://www.poetsgate.com/ViewPoem.aspx?id=177930",""],[5732,"يا معذبي بالحب","https://www.poetsgate.com/ViewPoem.aspx?id=177938",""],[4623,"محبتي لك نجتني من العطب ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146603",""],[5764,"دكتور !","https://www.poetsgate.com/ViewPoem.aspx?id=137055",""],[5764,"الليل فضّاح","https://www.poetsgate.com/ViewPoem.aspx?id=137062",""],[5829,"الى محمد","https://www.poetsgate.com/ViewPoem.aspx?id=153239",""],[5829,"تحية الى اهل العلم","https://www.poetsgate.com/ViewPoem.aspx?id=159310",""],[5848,"لا صرت","https://www.poetsgate.com/ViewPoem.aspx?id=48991",""],[5851,"هينمات من ظلال البدايات","https://www.poetsgate.com/ViewPoem.aspx?id=175277",""],[5897,"بشائر على أبواب المدينة","https://www.poetsgate.com/ViewPoem.aspx?id=157555",""],[5922,"محاورة النجوم","https://www.poetsgate.com/ViewPoem.aspx?id=185133",""],[5975,"نظراتك","https://www.poetsgate.com/ViewPoem.aspx?id=52969",""],[4442,"أنت والسجن صارم وقراب","https://www.poetsgate.com/ViewPoem.aspx?id=171198",""],[6102,"موعد","https://www.poetsgate.com/ViewPoem.aspx?id=185070",""],[6131,"عَينايَ زرقاءُ اليَمامةْ","https://www.poetsgate.com/ViewPoem.aspx?id=189287",""],[5957,"أهواك !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82763&r=&rc=147",""],[6242,"على شاطئ التِّمثال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87563&r=&rc=10",""],[6247,"جمال القرآن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80287&r=&rc=26",""],[6264,"الذكرى العطره","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79131&r=&rc=39",""],[5555,"قَمِيصُ التُّوت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87410&r=&rc=6",""]],"verses":[["يا نَومَةً ثُمَّ مِنها","إِلى الجِنانِ المَهَبُّ",0,"ب",1,0],["يا نُورَ ناظِريَّ وسِرَّ هَوى","قلْبي ويا عِزّي ويا أُنْسي",1,"س",2,0],["يا نورَ أفكارِنا وأعيننا","أغنيت أوقاتنا عن السرج",2,"ج",1,0],["يا نورَ علم تعالى في ذُرى شَرَفٍ","أنى تجور وأنت النار والعلمُ",3,"م",1,0],["يا نور هذا الحفل قد","بلغت بطولتك النصابا",4,"ب",2,0],["يا نور هَل في الأرض تض","طجع الأهِلة والبدور",5,"ر",1,0],["يا نور كأس الموت من","نفس إلى نفس تدور",5,"ر",1,0],["يا نور هبك بلغت ما","بلغت من العمر النسور",5,"ر",1,0],["يا نورَ عيني ويا حياتي ويا","أنسي ويا مودعَ أسراري",6,"ر",2,0],["يا نُواسيُّ تَوَقَّر","وَتَجَمَّل وَتَصَبَّر",7,"ر",1,1],["يا نورَ عَيني فَقَدتُهُ","وَفي الفُؤادِ وَجَدتُه",8,"ت",2,1],["يا نَوبةَ الأشباحِ زُولي عسى","يُطالع القلبُ مَغاني العِيان",9,"ن",1,0],["يا نورَةِ الهَجرِ حَلَّقَت الصَفا","لِما بَدَت لي ليفَةُ الصَد",10,"د",1,1],["يا نومة في شمس آ","ب على التراب بلا حصير",11,"ر",1,0],["يا نوني منها ومنك ومما","جمعته لذّاتنا من أماني",12,"ن",2,0],["يانوران شيئت النور","ويمسي القلب معمور",13,"ر",1,1],["يا نور عين المجد يا من حبه","قد حل في قلبي بأشرف مقعد",14,"د",1,0],["يا نور نور الكائنات جميعها","نور على نور هو النور المبينْ",15,"ن",1,0],["يا نور نور النور من نحو الحمى","أنت الحمى والنور ذاك الأبيض",16,"ض",1,0],["يا نورَ دين اللهِ حالي","بانتزاحِي عَنْكَ حَالِكْ",17,"ك",1,0],["يا نور يا نور قد مزقت أحشائي","والجسم أصليت ناراً أي إصلاء",18,"ا",2,1],["يا نورَ سلسلةِ الكمالِ خديمُكُم","قد ضاقَ ذَرعاً من زمانٍ مُجرِزِ",19,"ز",1,0],["يا نومةً ما لها من يقظةٍ أبداً","وغيبةً ما لها في الدهرِ من حَضَرِ",20,"ر",1,0],["يا نورَ عيني والتي لم تزل","من نُورها تُقْبَسُ أنواري",21,"ر",2,0],["يا نور عيني لا أراك وهكذا","إنسان عيني لا يراه عياني",22,"ن",2,0],["يا نواسيُّ يا نفايةَ خلقِ اللَ","هِ قد نلتَ بي سناءً وفَخرا",23,"ر",2,1],["يا نوم عاود جفوناً طالما سهرت","فإنّ باعث وجدي رقّ لي ورثى",24,"ث",2,1],["يا نور برهاني","يا سر إِنساني",25,"ي",1,1],["يا نوق سيري سير البشير","في دست نور يجلو العيونا",26,"ن",2,0],["يانون يا حاميم عين الهَوى","ياسين قاف الحب يا كاف ها",27,"ه",2,0],["يا نورَةَ الهَجرِ جَلَوتِ الصَفا","لَمّا بَدَت لي ليفَةُ الصَدِّ",28,"د",1,1],["يَا نُوْر دنياي بأكملها","فِيْ أرْضي وفُوْق الافاقي",29,"ق",2,0],["يا نور مشكاة العلوم وبدرها","يا من كشفت من الرموز صعابا",30,"ب",2,0],["يا نور مشكاة العلوم بنورك","الدري بأن محرم ومحلل",31,"ل",1,0],["يا نور فكري وسرى","وروح روحي ونفسي",32,"س",2,1],["يا نورَ عينَيَّ والدُّنيا وزينتَها","يا نورَ مسجدِنا يا نورَ نادينا",33,"ن",2,0],["يا نور أذهَبَهُ الظلام أهكذا ال","إِمساءُ بمحُو آيةَ الإِصباح",34,"ح",1,0],["يا نوءُ فى شرقٍ يا ضوءُ فى غسَقٍ","من جودِكَ الغيثُ أَم من نورك القمر",35,"ر",1,0],["يا نور عيني يا حشاشة مهجتي","من للنساء الضائعات دليل",36,"ل",1,0],["يَا نَوْرَسَ الغَيْبِ صُبَّ الرِّيحَ فِي لُجُبِي","تَهَجُّداً بِسَمَاءِ الحِبْرِ مِنْ كُتُبِيْ!",37,"ب",2,1],["يا نور علمٍ أراه اليوم منطفياً","وكانت الناس تمشي منه في سرج",38,"ج",1,0],["يا نوم إن زار الخيال الجفن قل","ادخل بفتحي دار دمعي الزارفِ",39,"ف",1,1],["يا نور نجم سعوده لما مشى","في ظل شمس الآصفي يتبختر",40,"ر",1,0],["يا نور عامي شريق النجم قام به","خير الصدور أبو اِلهاميّ وجه هدى",41,"د",2,0],["يا نور هذا السعد في المنزلِ","بالعز في إقباله ينجلي",42,"ل",2,1],["يا نُورَ عرش الهٍ انتِ صُفوتُهُ","وخيرَ خلقٍ يُرَجَّى نَيلُ جَدواكِ",43,"ك",1,0],["يا نون حاجبه الأم على","ضعفي تلاحظ جانب الكبر",44,"ر",1,0],["يا نُوقُ عُذراً فَإنَّ الشَّوقَ كَلَّفَنِي","إلَى الحَبِيبِ بِمَسْرانَا فَلا تَلُمي",45,"م",2,0],["يا نُوحُ رِثْ أعمارَنا وَاحْتَكِمْ","مَلَّكَكَ اللَّه رِقابَ الْعِبادْ",46,"د",1,0],["يا نور خلق اللَه فيك رجائي","يا عمدتي في شدتي ورخائي",47,"ي",1,1],["يا نور يا هادي بديع باقي","كن لي دهورَنا وفي التلاقي",48,"ي",1,0],["يا نورَ دينِ اللَّهِ وَابنَ عِمادِهِ","والكوثَرَ ابنِ الكَوثَرِ اِبنِ الكَوثرِ",49,"ر",1,0],["يا نورَ دينِ اللَّهِ كَم حادِثٍ","دَجا وَأَسْفَرْتَ لَهُ فَاِنْشَرَى",50,"ر",2,0],["يا نورَ دينٍ أُظلِمَت آفاقُهُ","لَوْ لَمْ تَبلّج هَذِهِ الآثارُ",51,"ر",1,0],["يا نور المولى ضريحا قد غرب","شمس البرازيين فيه واحتجب",52,"ب",1,1],["يا نوى الأحبابِ كائن","هجتِ من خَطْبِ وكائن",53,"ن",1,0],["يا نور يوم ولدت قامت عزة للأرض إذ أمست لنورك تنتمي","الكوكب الأرضي حين وطئته أمسى حصاه يتيه فوق الأنجم",54,"م",1,0],["يانوقُ طابَ لك السرى وسرى","عمّن حَملت اليومَ كلُ ردى",55,"د",2,0],["يا نوقُ حقَّ لي الحنينُ فما","شَيعت من أهوى غداة غدا",55,"د",2,0],["يا نوقُ حق لي الحنينُ فما","برَدت في تَوديعه كَبدا",55,"د",2,0],["يأنُّ وفي قلب الزَمان جَراحةٌ","له حين يُصغي نوحَه وبكاءه",56,"ا",3,0],["يا نوقُ قد هزَّ المسيرُ ذوابلاً","أمسى رقَادي في الوهاد طَعينها",57,"ن",3,0],["يا نوقُ قد حملَ المشوقُ من الجوى","ما قد أزالَ من الجبال رزَينها",57,"ن",3,0],["يا نوقُ هذا ماءُ دجلةَ فَاسألي","هل بلَّ من غلل الحشا سِّجينها",57,"ن",3,0],["يا نوقُ قد خانَ الأحبةُ عهدها","تيكَ المودة حيثُ كنت أمينَها",57,"ن",3,0],["يا نوق هذا الجسم نَهبٌ للضَنى","والقلبُ أصبح في الغري رهينها",57,"ن",3,0],["يا نوق لو أبصرت يوم وداعهم","ودَّعت دجلة بل رفضت مَعينها",57,"ن",3,0],["يا نوق لو مَستك نفحةُ هَجرهم","لَعلمت أن لظى الهَواجر دُونها",57,"ن",3,0],["يا نوق لو أبصرت من هول النوى","إي والهوى ما قد أشابَ جَنينها",57,"ن",3,0],["يا نورَ عَرشِ اللَهِ مَن نوّرَ ال","له بِهِ الأَكوانَ إذ نَوَّرا",58,"ر",2,0],["يا نور الفؤاد","هل يرجع الصفو الأول",59,"ل",1,0],["يا نومَ عيني من استباحَك","وَعن محلِّ الكرى أزاحَك",60,"ك",1,1],["يا نومُ ودّع جفوناً كنتَ تألفُها","فليسَ بعدكَ إلا الدمعُ والسهَرُ",61,"ر",1,0],["يا نور عيني تعال أنا بدونك وحيد","عيني تناجي الليالي ونجومها الساهره",62,"ر",2,1],["يا نورَ من أبدعَ الأكوانَ قاطبةً","منه استنارت على رغم الدجَى مِلَل",63,"ل",1,0],["يا نورها ياصل الى اخر الحد","هذا لو ان الحد عنده معايير",64,"ر",1,0],["يا نورساً سئم الأشعارَ باكيةً","الشعرُ ينبتُ في الخرطوم مبتسما",65,"م",2,0],["يا نور عيني عذلي فيك مخطين","كلما عذلوني فيك زادك تغلا",66,"ل",2,0],["يانور عيني كل ذنبي وذنبك","ابو جهل وابليس والظلاّمي",67,"م",2,0],["يانور عيني فوق قبر (أ)ختمها","لاجلك حكمت الساطي السّطامي",67,"م",2,0],["يانوور قلبي كتوف هالشوق كلاً","وذكراك تسندها جموع ومفرّد",68,"د",1,0],["يا نور عيني شفت بعدك ظلامي","ماشفت في فرقاك لحظه هنيه",69,"ي",2,0],["يَاْ نُوْرَ عَيْنِيْº ويَاْ رُوْحِيْº وَيَاْ أَمَلِيْ","مَاْ لِيْ سِوَاْكِ بِهَذَا الْكَوْنِ مِنْ بَصَرِ",70,"ر",1,0],["يَا نُورُ مَا تَأمُرِينَ القَلبَ مِن صَبٍّ","يَصبُو إلى أن يَتِمَّ الشَّوقَ طَاقَتَهُ",71,"ت",2,1],["يا نور عيني سجينًا بتُّ في يدهِ","يُسقي لروحي الهوى كأسًا على كأسِ",72,"س",1,0],["يا نورساً غابَ عن أمواجِ محبرتي","إلى السرابِ .. بقايا شاعرٍ هاكِ",73,"ك",1,0],["يَاْ نَوْرَسَ الشَّطِّ فَاغْزِلْ مِنْ ضَنَى عُمُرِيْ","ثَوَاْبَهُ أُوَسَاً . قَدْ طَاْلَ مُحْتَبَسَاْ",74,"س",2,0],["يا نور عيني ظلمت هجرا","فضقت ذرعا وحرت أمرا",75,"ر",2,0],["يا نورَ معرفةٍ ورائدَ فكرةٍ","وإمامَ مدرسةٍ بها نتأثّرُ",76,"ر",1,0],["يا نور عيني لو تغيبت ابكيك","وأنثر عليك الدمع وأعلن هيامي",77,"م",2,0],["يانوفل الإدراك فرحة دهرنا","قد جئت ياموسى فهاج وأشرقا",78,"ق",2,0],["يا نورَ عيني ودمعي لست تمنعُهُ","لكنّ قلبي بالخذلان توجعهُ",79,"ع",2,1],["يانورسَ الشطآنِ إني شاعرٌ","أخشى اقتراباً منْ بياضِ النورسِ",80,"س",1,0],["يا نَوْرَسَ الْحُبِ الْمُرابِط في دَمِي","سَيَظلُّ عُشُّكَ بالضُّلُوعِ مُمَدَّدَا",81,"د",2,0],["يَا نُورَ عَرشِ الله أُقرؤُكَ السَّلام","قَدْ فَاضَ مَا بينَ الجَّوانحِ مِنْ هَيام",82,"م",1,1],["يا نور قلب بالجمال سنائه","بدر علا في ظلمة الأفاق",83,"ق",1,0],["يانورعينى .. وروح روحى","طبيبى إنتِ وجروحى",84,"ا",1,0],["يانور عيني كم أضر بي النوى","أشلاء قلبي قد تركت بواكيا",85,"ي",2,0],["يانوح ياربّ السفينة هل لنا","إثر الأسى من يفتدي أوطانَه",86,"ن",2,0],["يانورس الماء الحزين ألست مثليَ","متعبا قُصّت ببعدٍ أضلعُ؟!",87,"ع",1,0],["يانور وهاج مايطفي ولو عودي","اهديت حزة ضهورك حيره الغادي",88,"د",2,0],["يا نورنا الأزليّ حلّ","قْ في ذرى الكونِ الكئيبِ",89,"ب",1,0],["يا نورس الدير هل اعطيك من كتبي","تلقي بها لبيوت العشق .. مأساتي",90,"ت",2,0],["يا نورَ العيْنِ يا عيني","عدُ للمحبوبِ فَتُسْعِدُهُ",91,"د",2,0],["يانورَ هذي الأرضِ ياوطنَ الهدى","يا صبحنا .. حين الظلامُ تمادى",92,"د",2,0],["يا نور عيني مال حبك نقيضي","وقلبي لغيرك ما يعرف الصداقه",93,"ق",2,0],["يا نور عيني وأنت صبحي وظلماي","يا فرحتي يا سلوتي يا ضحايه",94,"ا",3,0],["يا نور كل ظلام في الزمان وفي المكان","كان ولم تزل ولم تغب",95,"ب",1,0],["يانور عيني طالبه منك حاجه","أفتح عيونك دمعتيني مسايير",96,"ر",1,0],["يانور عيني ويادربي ومصباحه","نظرتك لاصرت ماشي مادانيها",97,"ي",3,0],["يا نور الدرب وما أحلى","في الدرب عبير رياحيني",98,"ن",2,0],["يا نور طلعته ياطيبَ منبته","في حسن معشره تفتر دنيانا",99,"ن",2,0],["يا نور الايام في دنياي نوّرني","حرام ننسى بعضنا في مشاغلنا",100,"ن",2,0],["يا نورسا صبوات البحر تذكره","ولم يزل وده بعض الأقاويل",101,"ل",1,0],["يا نورَ وجهِ الأرضِ يا قلبَ الهدى","يا موئلَ الأفضالِ والخيراتِ",102,"ت",1,0],["يانوح هل أنتَ تنساني ،وتتركُني","قلْ ،ياسماءُ اقْلعي خوفَ الذي سَبدا",103,"د",2,0],["يا نور الحب بأجنحتي","يا بعض القلب ويا كله",104,"ل",2,0],["يا نورا تجني عليها بغاث","ورؤسا تقودها الأذناب",105,"ب",1,0],["يا نُوقَ الصَّبرِ ؛ يَدٌ تَسعَى","وَ تَهُزُّ الضَّرعَ , وَ تَحتَلِبُ",106,"ب",1,0],["يَا نُوحُ ما بالُ الغُرَابِ مُحَوِّمًا","وَ الابْنُ صَعَّدَ في الجبالِ ليَثأرَا",107,"ر",2,0],["يا نور فؤادي يا بصري","أهواك حد الإرهاق",108,"ق",1,0],["يا نورس الحب أدري أن فاتنتي","قد أحرقت زهر أوراقي ونسريني",109,"ن",2,0],["يا نورُ! فكري حائرٌهل من سنا؟","يانورُعمري ظاميءٌ ودنا الغروبْ",110,"ب",1,0],["يا نورُ كم حجبَ العناكبُ من سنا","وتظلّ وحدك شمسَ خُلدٍ لا تغيبْ",110,"ب",1,0],["يا نورُ ! أسفِرْ عن جلالك علّنا","أنْ تلتقي نظراتُنا نظرَ الحبيبْ",110,"ب",1,0],["يا نور أحمد في الخوافق شعلةٌ","يا ذكر أحمد للهدى انغامُ",111,"م",1,0],["يا « نُوتةَ » اللهِ سَماوِيَّةً","شكّلَها اللهُ .. فَكَانَ الكمَانْ",112,"ن",1,0]]}