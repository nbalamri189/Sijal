n/poem/39683","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39572","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39664","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30492","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20989","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42507","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55171","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55071","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54519","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55093","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55122","الوافر"],[30,"","https://poetry.dctabudhabi.ae/diwan/poem/12322","الطويل"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1923","الطويل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/5138","الكامل"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/8871","الطويل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/205801","الخفيف"],[106,"تأميم القناة","https://www.poetsgate.com/ViewPoem.aspx?id=179582",""],[0,"ألا انعم صباحاً أيها الربع وانطقِ","https://www.poetsgate.com/ViewPoem.aspx?id=4799",""],[57,"خبت نار نفسي باشتعال مفارقي","https://www.poetsgate.com/ViewPoem.aspx?id=24897",""],[57,"سهرت أعين ، ونامت عيون","https://www.poetsgate.com/ViewPoem.aspx?id=3407",""],[28,"لعمري لقد أوفى وزاد وفاؤه","https://www.poetsgate.com/ViewPoem.aspx?id=21369",""],[51,"يا عليّ العلا ابن قاسمِ القا","https://www.poetsgate.com/ViewPoem.aspx?id=30288",""],[51,"رحم اللَّهُ صالح بن وصيفٍ","https://www.poetsgate.com/ViewPoem.aspx?id=29560",""],[85,"الله يحكمُ في المداينِ والقُرى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9648&r=&rc=138",""],[0,"خليلّي مرّ بي على أم جندب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14326&r=&rc=2",""]],"verses":[["فَاِدرَأِ الهَمَّ ما اِستَطَعتَ عَن النَف","سِ فَحِملانُكَ الهُمومَ جُنونُ",0,"ن",1,0],["فَأَدرَكوا بَعدَما أَضاعوا","وَقاتَلَ القَومُ فَاِستَناروا",1,"ر",3,0],["فَاِدفَع وَناضِل عَن مَطالِبِ أُمَّةٍ","يا سَعدُ أَنتَ أَمامَها مَسئولُ",2,"ل",1,0],["فَاِدعُ البَيانَ لِيَومٍ لا تُطاوِلُهُ","يَدُ البَلاغَةِ في الأَشعارِ وَالخُطَبِ",3,"ب",1,0],["فَأَدبَرنَ كَالجِزعِ المُفَصَّلِ بَينَهُ","بِجيدِ مُعَمٍّ في العَشيرَةِ مُخوَلِ",4,"ل",1,0],["فَأَدرَكَ لَم يَجهَد وَلَم يَثنِ شَأوَهُ","يَمُرُّ كَخُذروفِ الوَليدِ المُثَقَّبِ",5,"ب",1,0],["فَأَدبَرَ يَكسوها الرُغامَ كَأَنَّه","عَلى الصَمدِ وَالآكامِ جَذوَةُ مُقبِسِ",6,"س",1,0],["فَأَدرَكنَهُ يَأخُذنَ بِالساقِ وَالنَس","كَما شَبرَقَ الوِلدانُ ثَوبَ المُقَدَّسِ",6,"س",1,0],["فَأَدبَرنَ كَالجَذعِ المُفَصَّلِ بَينَهُ","بِجيدِ الغُلامِ ذي القَميصِ المُطَوَّقِ",7,"ق",1,0],["فَأَدرَكَكَ المَشيبُ عَلى هَواها","فَلا شَيبٌ نَهاكَ وَلا ذُهولُ",8,"ل",1,0],["فأدعوه حالاً أو نرد الدعوه","يغذنا بالكلمات الحلوة",9,"ه",1,0],["فَأَدخَلتُ فيها قَيدَ شِبرٍ موفَّرٍ","فَصاحَت وَلا وَاللَهُ ما وجِدَت تَزني",10,"ن",2,0],["فادّعوا للّه بنّيا","وتأمّن فيها الأملاك",11,"ك",1,0],["فأدرتُ من ذكراك كأس مُدامة","وشربتُ من حبي لها جريالا",12,"ل",2,0],["فأدبر الهمّ وانشقّت غياهبه","كما قد انشقّ سجف الليل بالفلق",13,"ق",1,0],["فأدنيت للنجوى فمي نحو سمعه","وقلت لأن العدل لم يتبغدد",14,"د",1,0],["فَأَدّوا حَوارِيَّ الرَسولِ وَرَحلَهُ","إِلى أَهلِهِ ثُمَّ اِفخَروا بَعدُ أَو دَعوا",15,"ع",3,0],["فأدركوا دونه اخاطي في حيث","مدى الرائطين اذ لغبوا",16,"ب",3,0],["فأدير إمّا بالمدام معَ الدُّمى","أو بالدِّماء مع الكماة شرابا",17,"ب",2,0],["فأدمعهُ قد صرنَ ألفاظ شجوه","وألفاظه من رقَّةٍ صرنَ أدمعا",18,"ع",2,0],["فادّعاها لأجنبيٍّ ولو كا","ن ادّعاها لخاف أمراً شنيعا",19,"ع",2,0],["فأدَّى إليهم كلَّ ما قد علمتَه","رُواءً إذا ورَّى لسانيَ صرّحا",20,"ح",2,0],["فادْحرُوه إذا تقرَّب منكم","وأحِلُّوه بالمحل الحَريدِ",21,"د",1,0],["فادَّرعِ الجهل فوقهنّ ولا","يُغفل حليمٌ من جهله عُدَدَهْ",22,"د",2,0],["فادعُ الإله عليها غير مُتَّئبٍ","وغيِّر اسمك حلَّت باسمك الغِير",23,"ر",1,0],["فادفن سُلاحاً ظلت تسلحه","من فيك لا استك دُفعةً دفعه",24,"ع",2,0],["فادحروا عنكم المخانيث دحراً","وليوكَّل بذاك كل شريف",25,"ف",1,0],["فأدلى له التأمير والأمر بعدها","وقد حلّقت بالعبد أولى محلّق",26,"ق",1,0],["فأدِلني على الزمانِ فما زل","تَ على صرِفه كريمَ الإدالهْ",27,"ل",2,0],["فادعُ القوافي ونُصَّ اليعْمُلات له","تُجبكَ كلُّ شرودٍ وهي مِذعان",28,"ن",1,0],["فَأَدرَكَهُنَّ السِلمُ كُلَّ مُحارِبٍ","وَتَرنَ وَقُدناهُنَّ كُلَّ مَقادِ",29,"د",1,0],["فَأَدبَرَ يَحدوها كَأَنَّ زِمالَهُ","زِمالُ شَروبٍ وَجعَ مِنهُ الأَباجِلا",30,"ل",2,0],["فَأَدركَهُم دونَ الهُيَيمَاءِ مُقصِراً","وَقَد كانَ شَأواً بالِغَ الجَهدِ باسِطا",31,"ط",2,0],["فَأَدَّت بَنو عَوفِ بنِ كَعبٍ رَبيبَها","وَغودِرَ في بَعضِ الجُنودِ رَبيبُ",32,"ب",1,0],["فَأَدَرتُ طَرفي باحِثاً مُتَعَجِّباً","مِمّا سَمِعتُ وَلَستُ في بَيداءِ",33,"ا",2,0],["فَأَدرَكتُ أَنَّ فَتى الأَغنِياء","ضَنينٌ يَخافُ عَلى ثَروَتِه",34,"ه",1,0],["فَأَدَرتُ زِندِيَ حَولَ مِنكَبِها","وَلَثَمتُها في النَحر وَالثَغرِ",35,"ر",1,0],["فَأَدرَكوا أَنَّهُم ناموا عَلى غَرَرٍ","وَأَنَّكَ البَدرُ في الأَفلاكِ تَنتَقِلُ",36,"ل",1,0],["فَاِدفِنوا أَضغانَكُم يا زُعَماء","يَبعَثُ اللَهُ مِنَ القَبرِ الوِئام",37,"م",1,0],["فَاِدعُهُ فَهُوَ بِلا شَك","كٍ مُجيبٌ مَن دَعاهُ",38,"ا",2,0],["فَادَّرَكنا الثَّأرَ مِنهُم وَلَمَّا","يَنجُ مِلحَيَّينِ إِلّا الأَقَلُّ",39,"ل",1,0],["فَاِدفَع مَظالِمَ عَيَّلَت أَبناءَنا","عَنّا وَأَنقِذ شِلوَنا المَأكولا",40,"ل",2,0],["فأدار في العواد مقلة باحث","تزن الوجوه سكوتها وكلامها",41,"م",3,0],["فأديمها كأديم","هن كلاهما النزه الطهور",42,"ر",1,0],["فَاِدفَع قَضاءَكَ أَو فَصَيِّر نارَهُ","بَرداً وَخُذ بِاللُطفِ فيما قُدِّرا",43,"ر",2,0],["فَاِدعوا لَها أَهلَ الأَمانَةِ وَاِجعَلوا","لِأولى البَصائِرِ مِنهُمُ التَفضيلا",44,"ل",2,0],["فَأَدبَروا وَوُجوهُ الأَرضِ تَلعَنُهُم","كَباطِلٍ مِن جَلالِ الحَقِّ مُنهَزِمِ",45,"م",1,0],["فَأَدرَكتَ البُخارَ وَكانَ طِفلاً","فَشَبَّ فَبايَعَتهُ الصافِناتُ",46,"ت",1,0],["فَأَدِّب بِهِ القَومَ الطُغاةَ فَإِنَّهُ","لَنِعمَ المَرَبي لِلطُغاةِ المُؤَدِّبُ",47,"ب",1,0],["فَاِدَّعَوا ما اِدَّعى أَصاغِرُ آثي","نا وَدَعواهُمُ خَناً وَاِفتِراءُ",48,"ا",2,0],["فادرأْ بها في نحورِ البِيد جافلةً","معارضاتٍ مثانى اللُّجمِ بالجُدَلِ",49,"ل",1,0],["فَأَدرَجتُهُ صَفحاً وَكُنتُ إِذا أَتى","لَئيمُ أُناسٍ سَوءَةً لا أُعاتِبُه",50,"ب",2,0],["فَأَدرَكتُ الَّذي طالَب","تُ أَو قُلتُ وَلَم أَفعَل",51,"ل",1,0],["فَأَدّى إِلى آلِ اِمرِءِ القَيسِ بَزَّهُ","وَأَدراعَهُ مَعروفَةً لَم تُغَيَّبِ",52,"ب",1,0],["فَأَدخَلَنا جَهَنَّمَ ما أَخَذنا","مِنَ الإِرباءِ مِن دونِ الظُهورِ",53,"ر",1,0],["فَأَدرَكَهُنَّ مُنبَعِقٌ ثُعابٌ","بِحَتفِ الحينِ إِذ غَلَبَ الحِذارا",54,"ر",2,0],["فَاِدفَع بِكَفِّكَ إِن أَرَدتَ بِناءَنا","ثَهلانَ ذا الهَضَباتِ هَل يَتَحَلحَلُ",55,"ل",1,0],["فَأَدرَكَها وَاِزدادَ مَجداً وَرِفعَةً","وَخَيراً وَأَحظى الناسِ بِالخَيرِ فاعِلُه",56,"ل",2,0],["فأدنى كدر العيش","بها لا كان ما أدنى",57,"ن",2,0],["فأدرها درية الكأس ملأى","من مذاب العقيقة الحمراء",58,"ا",2,0],["فَاِدعُ لِرَبِّكَ إِنَّهُ أَدنى لِمَن","يَدعوهُ مِن حَبلِ الوَريدِ وَأَقرَبُ",59,"ب",1,0],["فَاِدرَأ بِنا نَحرَ العَدُو","وِ فَبِالأَقارِبِ يُدرَأُ",60,"ا",1,0],["فَأَدرَكتُ ما أَمَّلتُ مِن طَلَبِ العُلا","وَنَزَّهتُ نَفسي عَن طِلابِ المَواهِبِ",61,"ب",1,0],["فأدِرْ للروح أُخْتاً والزرا","جينِ بنتاً وسرورِ النفس أُم",62,"م",1,0],["فأدِرْها تحْتَ ليلٍ سَقْفُهُ","ظلمةٌ فيها من النور ثُقَبْ",63,"ب",1,0],["فَادْرَأْ هُمُومَ النَّفْسِ عَنْكَ إِذَا اعْتَرَتْ","بِالْكَأْسِ فَهْيَ عَلَى الْهُمُومِ حُسَامُ",64,"م",1,0],["فأديري عليَّ كأسَ مُدامٍ","مثلَ أخلاقِهِ بلا تكديرِ",65,"ر",1,0],["فَأَدركَ ما أَعجزَ المُدركين","وَلَم يَثنِ ذَلِكَ مِن هِمَّتِه",66,"ت",2,0],["فأدَّبَنِي اليقينُ وهَذَّبَتْنِي","وصاةُ اللهِ بُورِكَتِ الوَصاةُ",67,"ه",1,0],["فَأَدرَكَها مِن ربّها ثُمَّ رَحمَةً","بِصِدقِ حَديثٍ مِن نَبيٍّ مُكَلَّمِ",68,"م",1,0],["فَأَدخَلَهُم عَلى رَبِذٍ يَداهُ","بِفِعلِ الخَيرِ لَيسَ مِنَ الهَدادِ",69,"د",1,0],["فَاِدَّرَكنا الثَأرَ مِنهُم وَلَمّا","يَنجُ مِلَحَيّنِ إِلّا الأَقَلُّ",70,"ل",1,0],["فَأَدبَرتُ لا يَنجو نَجائِيَ نِقنِقٌ","يُبادِرُ فَرخَيهِ شَمالاً وَداجِنا",71,"ن",2,0],["فَأَدركَهُ مِن هَوى تُكتَمٍ","عَقابِيلُ أَهوَنُها يَجرَحُ",72,"ح",1,0],["فَاِدعوا بَني حابِسٍ رَهطَ الجُنابِ لَها","وَالشاةَ إِنّا نَخافُ الغَيَّ وَالنَدَما",73,"م",2,0],["فَأُدخِلوا مَدينَةَ السَلامِ","وَآخَذَتهُم أَلسُنُ الأَنامِ",74,"م",1,0],["فَأُدخِلوا بَغدادَ في شَهرِ رَجَب","وَأَيقَنَ التُركُ بِصُغرٍ وَغَلَب",74,"ب",1,0],["فَأَدَّيتُ إِلى بَدرٍ","مَلا عَيني مِنَ الضَوِّ",75,"و",1,0],["فَأَدارَت في جَوانِبِها","حَبَباً تُغري بِهِ حَبَبا",76,"ب",2,0],["فادْعُني حَسَّانَ مَدْحٍ وزِدْني","إنّني أَحْسَنْتُ منه المنابا",77,"ب",2,0],["فأدِرْ جُفونَكَ واكتحِلْ بمناظِرٍ","غَشّى فِرندَ لُجَيْنِها عِقْيانها",78,"ن",3,0],["فأداتُهُ فَضْفاضَةٌ وتَريكَةٌ","ومثقَّفٌ ومُهنَّدٌ بتّار",79,"ر",1,0],["فَادَّراها وَهيَ لاهِيَةٌ","في جَميمِ الخاذِ وَالغَربِ",80,"ب",1,0],["فَأَدارَها عَدَداً ثَلاثاً فَاِنثَنَت","مِنّا النُفوسُ وَلَيسَ مِنها صادِ",81,"د",1,0],["فَاِدعُ بي لا عَدِمتَ تَقويمَ مِثلي","وَتَفَطَّن لِمَوضِعِ السُجّادَه",82,"د",2,0],["فَأَدبَرَ كَالمُزوَرِّ يُقسِمُ طَرفَهُ","لِأَرجُلِنا شَطراً وَأَوجُهِنا شَطرا",83,"ر",2,0],["فَاِدَّخِر خَيراً تُثابُ بِهِ","كُلُّ مَدخورٍ لِمُدَّخِرِه",84,"ر",2,0],["فَأَدَرنا رَحى السُرورِ ثَلاثاً","وَوَصَلنا الخُصورَ كَفّاً بِكَفِّ",85,"ف",1,0],["فَأَدرَكَ مِنها الغابِرونَ حُشاشَةً","لَها هَيَجانٌ مَرَّةً وَسُكونُ",86,"ن",1,0],["فَاِدنُ مِمَّن تُحِبُّ غَيرَ مَلومِ","لَيسَ في الحُبِّ راحَةٌ مِن بَعيدِ",87,"د",1,0],["فَأَدرَكَ مَجلودي جَوى الحُبِّ كاعِبٌ","كَشَمسِ الضُحى في الفائِقاتِ الخَرائِدِ",88,"د",1,0],["فَاِدعُ سِربَ المِلاحِ يَشهَدنَ مَوتي","بِحَنوطٍ إِنّي أُحِبُّ المِلاحا",89,"ح",2,0],["فادّعاءُ المُلوكِ غيْرِك إدرا","كَ المَعالي دعْوى شِقاقٍ وزُورِ",90,"ر",1,0],["فَأَدرَكَتهُ فَطَرَّحَتهُ","وَالصَيدُ مِن تَحتِها مَكروبُ",91,"ب",1,0],["فَأَدخَلَكَ اللَهُ بَردَ الجِنا","نِ جِذَلاَنَ في مُدخَلٍ طَيِّبِ",92,"ب",1,0],["فَأَدَلَّ العَيرُ حَتّى خِلتَهُ","قَفَصَ الأَمرانِ يَعدُو فِي شَكَل",93,"ل",1,0],["فأدخلَ العُدَّةَ والعديدا","فيها ولم يَتركْ بها عَنِيدا",94,"د",2,0],["فأَدِرْ لِحَاظَكَ في محاسنِ وجْهه","تَلْقَى جميعَ الحُسْنِ فيه مُصَوَّرا",95,"ر",2,0],["فأَدركتها من بعد يوم وليلة","ومنها إلى بيروت قد جئت موفدا",96,"د",2,0],["فأدنيتها مني وقلت لها اسمعي","حنانَيْك ما هذا الحنين المُرجَّع",97,"ع",1,0],["فادٍ أحمّ كأنما احترقت به","حربٌ من الميلاد كان نشوبها",98,"ب",3,0],["فادخلا بين ضياءٍ وغمامْ","حانةَ الأقدار والليلِ القديمْ",99,"م",1,0],["فادٍ من الغُرِّ الكُماةِ مجاهدٌ","تتنازعُ الآلامُ منه فؤادا",100,"د",2,0],["فأدب الصانع إتقان العمل","وأدب التاجر بالصدق كمل",101,"ل",1,0],["فإِدْناؤُها رُشْدٌ وَهَتْكُ حِجابها","إِذا احْتَجَبتْ في غَيْرِ أَيَّامِها ظُلْمُ",102,"م",1,0],["فادعُ نَفساً لرُشدها قَبلَ هُلك","إنَّما الهُلكُ أن تَزُورَ القُبورا",103,"ر",2,0],["فَأَدِيرَا عَلَيَّ ذِكْراهُ إِنِّي","مُنْذُ فارَقْتُهُ شَدِيدُ المُصَابِ",104,"ب",1,0],["فَادْرَكَ مَجْداً كَانَ دُونَ بُلُوغِهِ","توَقَّى مُلِمَّاتِ وَحَلَّ مَعَاضِلِ",105,"ل",1,0],["فَادْخُلْ جِنَانَ الخُلْدِ وَامْرَحْ نَاجِياً","مِنْ مَحْبَسِ الدُّنْيَا فَأَنْتَ طَلِيقٌ",106,"ق",1,0],["فَأَدْرَكْتُ كَيْفَ اسْتَبَتْ عَابِدِيهَا","بِسِحْرِ الجَمَالِ وَسِرِّ الذَّكَاءْ",107,"ا",2,0],["فادْخُلْ إِلى جَنَّاتِهِ","وَاهْنَأ وَيُرَحَمُ وَالِدَاكْ",108,"ك",1,0],["فَأدْرَكْتَ النَّجَاحَ وَكَانَ حَقّاً","وَعَادَ الصَّعْبُ مَرْكَبُهُ ذَلُولاَ",109,"ل",2,0],["فَأَدلى غُلامي دَلوَهُ يَبتَغي بِها","شِفاءَ الصَدى وَاللَيلُ أَدهَمُ أَبلَقُ",110,"ق",1,0],["فَأَدبَرَ يَكسوها الرُغامَ كَأَنَّها","عَلى الصَمدِ وَالآكامِ جَذوَةُ مُقبِسِ",111,"س",1,0],["فَأَدرَكنَهُ يَأخُذنَ بِالساقِ وَالنَسا","كَما شَبرَقَ الوِلدانُ ثَوبَ المُقَدَّسِ",111,"س",1,0],["فادَيتَ بِالأَسرى وَقَد غَلِقوا فَلا","مَنٌّ يُنالُ وَلا فِداءٌ يُقبَلُ",112,"ل",1,0],["فَأَدبَرنَ عَن رَثِّ الحَياةِ كَأَنَّهُ","رَديءٌ نَفاهُ الرَكبُ وَهوَ نَجيبُ",113,"ب",1,0],["فادفعوا جزية السّيوف عليكم","لا تعيش السيوف بالإحسان",114,"ن",1,0],["فادَّكرْنا حين ضَنَّتْ موردًا","قد تركناه مُباحًا للسُّقاهْ",115,"ا",2,0],["فأدبرنَ كالجزع المفصل بينه","بجِيدِ الغُلام ذِي القميصِ المُطوَّقِ",116,"ق",1,0],["فاد زكاة الجاه واعلم بانها","كمثل زكاة المال تم نصابها",117,"ب",3,0],["فادرأ الهم ما استعطت عن النفس","فحملانك الهموم جنون",118,"ن",1,0],["فَأدّى إلى آلِ امرِىءِ القَيْسِ بَزَّهُ","وَأدْرَاعَهُ مَعْرُوفَةً لَمْ تُغَيَّبِ",119,"ب",1,0],["فأدِلني على الزمانِ فمازل","تَ على صرِفه كرمَ الإدالهْ",120,"ل",2,0],["فادحَروا عنكم المخانيثَ دخراً","وليوكَّل بذاك كل شريف",121,"ف",1,0],["فادفعْ قضاءَك، أَو فصيِّرْ نارَه","برداً، وخذْ باللأُّطفِ فيما قدِّرا",122,"ر",2,0],["فَأدْرَكَ لمْ يَجْهَدْ وَلمْ يَثنِ شَأوَهُ","تر كخذروف الوليد المثقبِ",123,"ب",1,0]]}