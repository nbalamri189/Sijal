poem33578.html","الطويل"],[558,"أصبحت أنا على مرادك","https://www.aldiwan.net/poem34271.html","مجزوء الدوبيت"],[558,"عشق ذات الخال عشقي","https://www.aldiwan.net/poem34325.html","مجزوء الرمل"],[558,"بدر تم لاح في الغسق","https://www.aldiwan.net/poem34335.html","المديد"],[558,"دارنا هذه هي الأشجار","https://www.aldiwan.net/poem34537.html","الخفيف"],[558,"إن قلت يا روحي لسبوحي","https://www.aldiwan.net/poem34673.html","السريع"],[558,"أنا عندي أن الشهود حجاب","https://www.aldiwan.net/poem34967.html","الخفيف"],[559,"زارني من أحب قبل الصباح","https://www.aldiwan.net/poem69365.html","الخفيف"],[562,"من مال رهبان الشوير قد ابتني","https://www.aldiwan.net/poem52524.html","الكامل"],[562,"للبكر مريم بيعة معمورة","https://www.aldiwan.net/poem52568.html","الكامل"],[562,"أطوف الأرض في شرق وغرب","https://www.aldiwan.net/poem52849.html","الوافر"],[567,"يا ريم كم أدنو وأنت تريم","https://www.aldiwan.net/poem69526.html","الكامل"],[567,"حلل الشبيبة مستعاره","https://www.aldiwan.net/poem69664.html","مجزوء الكامل"],[569,"فان يبل الشباب فكل شيء","https://www.aldiwan.net/poem51993.html","الوافر"],[575,"ألا فانتبه من أفقها طلع الفجر","https://www.aldiwan.net/poem3064.html","الطويل"],[575,"عادني من هوى الأحبة عيد","https://www.aldiwan.net/poem3078.html","الخفيف"],[586,"يا زائرا جعل الدجنة مركبا","https://www.aldiwan.net/poem17424.html","الكامل"],[586,"يا قلب كم ذا الخفوق والقلق","https://www.aldiwan.net/poem17614.html","المنسرح"]],"verses":[["فَاِدرَأِ الهَمَّ ما اِستَطَعتَ عَن النَف","سِ فَحِملانُكَ الهُمومَ جُنونُ",0,"ن",1,0],["فَأَدرَكوا بَعدَما أَضاعوا","وَقاتَلَ القَومُ فَاِستَناروا",1,"ر",3,0],["فَاِدفَع وَناضِل عَن مَطالِبِ أُمَّةٍ","يا سَعدُ أَنتَ أَمامَها مَسئولُ",2,"ل",1,0],["فَاِدعُ البَيانَ لِيَومٍ لا تُطاوِلُهُ","يَدُ البَلاغَةِ في الأَشعارِ وَالخُطَبِ",3,"ب",1,0],["فَأَدبَرنَ كَالجِزعِ المُفَصَّلِ بَينَهُ","بِجيدِ مُعَمٍّ في العَشيرَةِ مُخوَلِ",4,"ل",1,0],["فَأَدرَكَ لَم يَجهَد وَلَم يَثنِ شَأوَهُ","يَمُرُّ كَخُذروفِ الوَليدِ المُثَقَّبِ",5,"ب",1,0],["فَأَدبَرَ يَكسوها الرُغامَ كَأَنَّه","عَلى الصَمدِ وَالآكامِ جَذوَةُ مُقبِسِ",6,"س",1,0],["فَأَدرَكنَهُ يَأخُذنَ بِالساقِ وَالنَس","كَما شَبرَقَ الوِلدانُ ثَوبَ المُقَدَّسِ",6,"س",1,0],["فَأَدبَرنَ كَالجَذعِ المُفَصَّلِ بَينَهُ","بِجيدِ الغُلامِ ذي القَميصِ المُطَوَّقِ",7,"ق",1,0],["فَأَدرَكَكَ المَشيبُ عَلى هَواها","فَلا شَيبٌ نَهاكَ وَلا ذُهولُ",8,"ل",1,0],["فأدعوه حالاً أو نرد الدعوه","يغذنا بالكلمات الحلوة",9,"ه",1,0],["فَأَدخَلتُ فيها قَيدَ شِبرٍ موفَّرٍ","فَصاحَت وَلا وَاللَهُ ما وجِدَت تَزني",10,"ن",2,0],["فادّعوا للّه بنّيا","وتأمّن فيها الأملاك",11,"ك",1,0],["فأدرتُ من ذكراك كأس مُدامة","وشربتُ من حبي لها جريالا",12,"ل",2,0],["فأدبر الهمّ وانشقّت غياهبه","كما قد انشقّ سجف الليل بالفلق",13,"ق",1,0],["فأدنيت للنجوى فمي نحو سمعه","وقلت لأن العدل لم يتبغدد",14,"د",1,0],["فَأَدّوا حَوارِيَّ الرَسولِ وَرَحلَهُ","إِلى أَهلِهِ ثُمَّ اِفخَروا بَعدُ أَو دَعوا",15,"ع",3,0],["فأدركوا دونه اخاطي في حيث","مدى الرائطين اذ لغبوا",16,"ب",3,0],["فأدير إمّا بالمدام معَ الدُّمى","أو بالدِّماء مع الكماة شرابا",17,"ب",2,0],["فأدمعهُ قد صرنَ ألفاظ شجوه","وألفاظه من رقَّةٍ صرنَ أدمعا",18,"ع",2,0],["فادّعاها لأجنبيٍّ ولو كا","ن ادّعاها لخاف أمراً شنيعا",19,"ع",2,0],["فأدَّى إليهم كلَّ ما قد علمتَه","رُواءً إذا ورَّى لسانيَ صرّحا",20,"ح",2,0],["فادْحرُوه إذا تقرَّب منكم","وأحِلُّوه بالمحل الحَريدِ",21,"د",1,0],["فادَّرعِ الجهل فوقهنّ ولا","يُغفل حليمٌ من جهله عُدَدَهْ",22,"د",2,0],["فادعُ الإله عليها غير مُتَّئبٍ","وغيِّر اسمك حلَّت باسمك الغِير",23,"ر",1,0],["فادفن سُلاحاً ظلت تسلحه","من فيك لا استك دُفعةً دفعه",24,"ع",2,0],["فادحروا عنكم المخانيث دحراً","وليوكَّل بذاك كل شريف",25,"ف",1,0],["فأدلى له التأمير والأمر بعدها","وقد حلّقت بالعبد أولى محلّق",26,"ق",1,0],["فأدِلني على الزمانِ فما زل","تَ على صرِفه كريمَ الإدالهْ",27,"ل",2,0],["فادعُ القوافي ونُصَّ اليعْمُلات له","تُجبكَ كلُّ شرودٍ وهي مِذعان",28,"ن",1,0],["فَأَدرَكَهُنَّ السِلمُ كُلَّ مُحارِبٍ","وَتَرنَ وَقُدناهُنَّ كُلَّ مَقادِ",29,"د",1,0],["فَأَدبَرَ يَحدوها كَأَنَّ زِمالَهُ","زِمالُ شَروبٍ وَجعَ مِنهُ الأَباجِلا",30,"ل",2,0],["فَأَدركَهُم دونَ الهُيَيمَاءِ مُقصِراً","وَقَد كانَ شَأواً بالِغَ الجَهدِ باسِطا",31,"ط",2,0],["فَأَدَّت بَنو عَوفِ بنِ كَعبٍ رَبيبَها","وَغودِرَ في بَعضِ الجُنودِ رَبيبُ",32,"ب",1,0],["فَأَدَرتُ طَرفي باحِثاً مُتَعَجِّباً","مِمّا سَمِعتُ وَلَستُ في بَيداءِ",33,"ا",2,0],["فَأَدرَكتُ أَنَّ فَتى الأَغنِياء","ضَنينٌ يَخافُ عَلى ثَروَتِه",34,"ه",1,0],["فَأَدَرتُ زِندِيَ حَولَ مِنكَبِها","وَلَثَمتُها في النَحر وَالثَغرِ",35,"ر",1,0],["فَأَدرَكوا أَنَّهُم ناموا عَلى غَرَرٍ","وَأَنَّكَ البَدرُ في الأَفلاكِ تَنتَقِلُ",36,"ل",1,0],["فَاِدفِنوا أَضغانَكُم يا زُعَماء","يَبعَثُ اللَهُ مِنَ القَبرِ الوِئام",37,"م",1,0],["فَاِدعُهُ فَهُوَ بِلا شَك","كٍ مُجيبٌ مَن دَعاهُ",38,"ا",2,0],["فَادَّرَكنا الثَّأرَ مِنهُم وَلَمَّا","يَنجُ مِلحَيَّينِ إِلّا الأَقَلُّ",39,"ل",1,0],["فَاِدفَع مَظالِمَ عَيَّلَت أَبناءَنا","عَنّا وَأَنقِذ شِلوَنا المَأكولا",40,"ل",2,0],["فأدار في العواد مقلة باحث","تزن الوجوه سكوتها وكلامها",41,"م",3,0],["فأديمها كأديم","هن كلاهما النزه الطهور",42,"ر",1,0],["فَاِدفَع قَضاءَكَ أَو فَصَيِّر نارَهُ","بَرداً وَخُذ بِاللُطفِ فيما قُدِّرا",43,"ر",2,0],["فَاِدعوا لَها أَهلَ الأَمانَةِ وَاِجعَلوا","لِأولى البَصائِرِ مِنهُمُ التَفضيلا",44,"ل",2,0],["فَأَدبَروا وَوُجوهُ الأَرضِ تَلعَنُهُم","كَباطِلٍ مِن جَلالِ الحَقِّ مُنهَزِمِ",45,"م",1,0],["فَأَدرَكتَ البُخارَ وَكانَ طِفلاً","فَشَبَّ فَبايَعَتهُ الصافِناتُ",46,"ت",1,0],["فَأَدِّب بِهِ القَومَ الطُغاةَ فَإِنَّهُ","لَنِعمَ المَرَبي لِلطُغاةِ المُؤَدِّبُ",47,"ب",1,0],["فَاِدَّعَوا ما اِدَّعى أَصاغِرُ آثي","نا وَدَعواهُمُ خَناً وَاِفتِراءُ",48,"ا",2,0],["فادرأْ بها في نحورِ البِيد جافلةً","معارضاتٍ مثانى اللُّجمِ بالجُدَلِ",49,"ل",1,0],["فَأَدرَجتُهُ صَفحاً وَكُنتُ إِذا أَتى","لَئيمُ أُناسٍ سَوءَةً لا أُعاتِبُه",50,"ب",2,0],["فَأَدرَكتُ الَّذي طالَب","تُ أَو قُلتُ وَلَم أَفعَل",51,"ل",1,0],["فَأَدّى إِلى آلِ اِمرِءِ القَيسِ بَزَّهُ","وَأَدراعَهُ مَعروفَةً لَم تُغَيَّبِ",52,"ب",1,0],["فَأَدخَلَنا جَهَنَّمَ ما أَخَذنا","مِنَ الإِرباءِ مِن دونِ الظُهورِ",53,"ر",1,0],["فَأَدرَكَهُنَّ مُنبَعِقٌ ثُعابٌ","بِحَتفِ الحينِ إِذ غَلَبَ الحِذارا",54,"ر",2,0],["فَاِدفَع بِكَفِّكَ إِن أَرَدتَ بِناءَنا","ثَهلانَ ذا الهَضَباتِ هَل يَتَحَلحَلُ",55,"ل",1,0],["فَأَدرَكَها وَاِزدادَ مَجداً وَرِفعَةً","وَخَيراً وَأَحظى الناسِ بِالخَيرِ فاعِلُه",56,"ل",2,0],["فأدنى كدر العيش","بها لا كان ما أدنى",57,"ن",2,0],["فأدرها درية الكأس ملأى","من مذاب العقيقة الحمراء",58,"ا",2,0],["فَاِدعُ لِرَبِّكَ إِنَّهُ أَدنى لِمَن","يَدعوهُ مِن حَبلِ الوَريدِ وَأَقرَبُ",59,"ب",1,0],["فَاِدرَأ بِنا نَحرَ العَدُو","وِ فَبِالأَقارِبِ يُدرَأُ",60,"ا",1,0],["فَأَدرَكتُ ما أَمَّلتُ مِن طَلَبِ العُلا","وَنَزَّهتُ نَفسي عَن طِلابِ المَواهِبِ",61,"ب",1,0],["فأدِرْ للروح أُخْتاً والزرا","جينِ بنتاً وسرورِ النفس أُم",62,"م",1,0],["فأدِرْها تحْتَ ليلٍ سَقْفُهُ","ظلمةٌ فيها من النور ثُقَبْ",63,"ب",1,0],["فَادْرَأْ هُمُومَ النَّفْسِ عَنْكَ إِذَا اعْتَرَتْ","بِالْكَأْسِ فَهْيَ عَلَى الْهُمُومِ حُسَامُ",64,"م",1,0],["فأديري عليَّ كأسَ مُدامٍ","مثلَ أخلاقِهِ بلا تكديرِ",65,"ر",1,0],["فَأَدركَ ما أَعجزَ المُدركين","وَلَم يَثنِ ذَلِكَ مِن هِمَّتِه",66,"ت",2,0],["فأدَّبَنِي اليقينُ وهَذَّبَتْنِي","وصاةُ اللهِ بُورِكَتِ الوَصاةُ",67,"ه",1,0],["فَأَدرَكَها مِن ربّها ثُمَّ رَحمَةً","بِصِدقِ حَديثٍ مِن نَبيٍّ مُكَلَّمِ",68,"م",1,0],["فَأَدخَلَهُم عَلى رَبِذٍ يَداهُ","بِفِعلِ الخَيرِ لَيسَ مِنَ الهَدادِ",69,"د",1,0],["فَاِدَّرَكنا الثَأرَ مِنهُم وَلَمّا","يَنجُ مِلَحَيّنِ إِلّا الأَقَلُّ",70,"ل",1,0],["فَأَدبَرتُ لا يَنجو نَجائِيَ نِقنِقٌ","يُبادِرُ فَرخَيهِ شَمالاً وَداجِنا",71,"ن",2,0],["فَأَدركَهُ مِن هَوى تُكتَمٍ","عَقابِيلُ أَهوَنُها يَجرَحُ",72,"ح",1,0],["فَاِدعوا بَني حابِسٍ رَهطَ الجُنابِ لَها","وَالشاةَ إِنّا نَخافُ الغَيَّ وَالنَدَما",73,"م",2,0],["فَأُدخِلوا مَدينَةَ السَلامِ","وَآخَذَتهُم أَلسُنُ الأَنامِ",74,"م",1,0],["فَأُدخِلوا بَغدادَ في شَهرِ رَجَب","وَأَيقَنَ التُركُ بِصُغرٍ وَغَلَب",74,"ب",1,0],["فَأَدَّيتُ إِلى بَدرٍ","مَلا عَيني مِنَ الضَوِّ",75,"و",1,0],["فَأَدارَت في جَوانِبِها","حَبَباً تُغري بِهِ حَبَبا",76,"ب",2,0],["فادْعُني حَسَّانَ مَدْحٍ وزِدْني","إنّني أَحْسَنْتُ منه المنابا",77,"ب",2,0],["فأدِرْ جُفونَكَ واكتحِلْ بمناظِرٍ","غَشّى فِرند