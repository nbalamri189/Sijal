طوبِ","زَحَمتَ بِكَلكَلِ عَودٍ جُلالِ",0,"ل",1,0],["إِذا ما عَدا لَم تُبصِرِ البيضَ قُطَّعاً","وَلا الزَغفَ مَنّاعاً وَلا الجُردَ سُبَّقا",1,"ق",2,0],["إِذا ما عَنَّ حُسنٌ لَم","تُشَبِّثهُ نَواظِرُه",2,"ر",2,0],["إِذا ما عَدِمنا الجودَ مِنهُم لِعِلَّةٍ","فَلَن نَعدَمَ العَلياءَ مِنهُم وَلا المَجدا",3,"د",2,0],["إذا ما عَقَدْنا رايَةً مُقتَدِيَّةً","رَجَعْنا بِها خَفّاقَةً عَذَباتُها",4,"ت",3,0],["إِذا ما عَصَرنا الماءَ فيهِ مَجَّهُ","وَإِن نَحنُ نادَينا فَغَيرُ مُجيبِ",5,"ب",1,0],["إِذا ما عَلاها فارِسٌ مُتَبَذِّلٌ","فَنِعمَ فِراشُ الفارِسِ المُتَبَذِّلِ",6,"ل",1,0],["إِذا ما عاجِزٌ رَثَّت قُواهُ","رَأى وَطءَ الفِراشِ لَهُ فَناما",7,"م",2,0],["إِذا ما عَوى مُستَقبِلَ الريحِ جاوَبَت","مَسامِعُهُ فاهٌ عَلى الزادِ مُعوِلُ",8,"ل",1,0],["إِذا ما عَوى ذِئبُ الفَلا هَبَّ جَمعُهُم","إِلى الشَرِّ وَاِستُلَّت ظُباً وَشِفارُ",9,"ر",1,0],["إِذا ما عَيَّ بِالإِسنافِ حَيٌّ","مِنَ الهَولِ المُشَبَّهِ أَن يَكونا",10,"ن",2,0],["إِذا ما عَلَتها الشَمسُ ظَلَّ حَمامُها","عَلى مُستَقِلّاتِ الغَضا يَتَفَجَّعُ",11,"ع",1,0],["إِذا ما عَلا عَبراً تَعَسَّفَ جفَنَها","أَسابىُّ لا نَزرٍ ولا متُمَاسِكِ",12,"ك",1,0],["إِذا ما عَدَدنا يا اِبنَ بِشرٍ ثِقاتِنا","عَدَدتُكَ في نَفسي بِأولى الأَصابِعِ",13,"ع",1,0],["إِذا ما عَلاها راكِبُ الصَيفِ لَم يَزَل","يَرى نَعجَةً في مَرتَعٍ فَيُثيرُها",14,"ر",3,0],["إذا ما علتْ في الجو ثم تحدَّرتْ","تُحلّي بمرفضِّ الجُمان النواحيا",15,"ي",2,0],["إذا ما عَقّ موطنَهم أناسٌ","ولم يَبنوا به للعلم دورا",16,"ر",2,0],["إذا ما عقدنا مجلس الأنس بالطِلا","فبيني وبين السُّكر خمس دقائق",17,"ق",1,0],["إِذا ما عُدَّ فَضلُ حَصى تَميمٍ","تَحاقَرَ حينَ تَجمَعُهُ حَصاكا",18,"ك",2,0],["إِذا ما عَلَت جَوزَ الفَلاةِ مُضِرَّةً","عَلى الوَبرِ مِن هِزّانَ لَم يَتَرَمرَمِ",19,"م",1,0],["إِذا ماعَنَّ لي أَرَبٌ بِأَرضٍ","رَكِبتُ لَهُ ضَميناتِ النَجاحِ",20,"ح",1,0],["إذا ما علاءُ الدّين حام فخاره","فسل ثم عن نسرِ الكواكب لا النسر",21,"ر",1,0],["إذا ما عُبيدُ اللَّه ضاهاهُ قاسمٌ","فثَمَّ قديمُ المجد ضاهاه حادِثُهْ",22,"ث",2,0],["إذا ما عقدتَ العَقْد ثم تركته","ولم يَثْنِهِ عِقْدٌ وهَى ذلك العَقْدُ",23,"د",1,0],["إذا ما عَواريُّ الهجاء تعذَّرتْ","فقُلْ فيه ما فيه فلن يتعذرا",24,"ر",2,0],["إذا ما علا متنَ الطريق ببرْكه","حمى ظهره الركبانَ فالسَّفْر أزور",25,"ر",1,0],["إِذا ما عَلَت نَشزاً تَمُدُّ زِمامَها","كَما اِمتَدَّ جِلدُ الأَصلَفِ المُتَرَقرِقُ",26,"ق",1,0],["إِذا ما عَلاكَ لِذاتِ ليَمي","نِ تَدَحرَجَ عَنكَ لِذاتِ الشِمالِ",27,"ل",1,0],["إِذا ما عَرى خَطبٌ مِنَ الدَهرِ فَاِصطَبِر","فَإِنَّ اللَيالي بِالخَطوبِ حَوامِلُ",28,"ل",1,1],["إِذا ما عابَ ضِرسُ أَبي عَلِيٍّ","فَلَيسَ يُطيقُ يَقلَعُهُ الطَبيبُ",29,"ب",1,0],["إذا ما عصاني كلُّ شيءٍ أطاعني","ولم يجرِ في مجرى الزمان يباخلُهْ..",30,"ل",2,0],["إذا ما عدا معْ قُرَّحِ السَّبْقَ فاتها","وجاء بفضل الشَّدِّ ينتهب المعدى",31,"د",2,0],["إِذا ما عَصَت مَن رامَها وَسَما لَها","أَطاعَت فَتىً عَضباً يَسوسُ حِجاً عَضبا",32,"ب",2,0],["إِذا ما عَلاها الماءُ خِلتُ حَبابَها","تَفاريقَ دُرٍّ في جَوانِبِها شَتّى",33,"ا",1,0],["إِذا ما عاذِلي سَمّا","كِ قُلتُ أَعِد كَذا أَعِدِ",34,"د",1,1],["إِذا ما عَراكُم حادِثٌ فَتَحَدَّثوا","فَإِنَّ حَديثَ القَومِ يُنسي المَصائِبا",35,"ب",2,1],["إِذا ما عانَقَ الخَمسينَ حَيٌّ","ثَنَتهُ السِنُّ عَن عَنقٍ وَجَمزِ",36,"ز",1,1],["إِذا ما عَدَدتُ السِنَّ عُدتُ بِتَرحَةٍ","وَأَمَّلتُ رَبّي أَن يُحِلَّ عِقالي",37,"ل",2,1],["إذا ما عَلاهَا فارسٌ ظَنّ أنّه","تَبَوّأ ما بين النّجومِ قَرارا",38,"ر",2,0],["إِذا ما عُلوا قالوا أَبونا وَأُمُّن","وَلَيسَ لَهُم عالينَ أُمٌّ وَلا أَبُ",39,"ب",1,0],["إِذا ما عادَهُ مِنها نِساءٌ","صَفَحنَ الدَمعَ مِن بَعدِ الرَنينِ",40,"ن",1,0],["إذا ما عدا العادي به نحو قرنه","وقد سامه قولا فدتك المناصل",41,"ل",1,0],["إذا ما عطفتنَّ ناديتهُ","عسى الآن من روْعِه أن يُفيقْ",42,"ق",1,0],["إذا ما عَصَتْ حُكْمَ العَصَا فأعادَها","لها ضارِبٌ كانتْ إجابَتها النَّحْط",43,"ط",1,0],["إِذا ما عُلوا قالوا أَبونا وَأُمُّنا","وَلَيسَ لَهُم عالينَ أُمٌّ وَلا أَبُ",44,"ب",1,0],["إذا ما عَددْنا مأثُراتِ يمينِه","على مصرَ لم ينفَدْ لهنّ حساب",45,"ب",1,0],["إذا ما عِشْتِ في جِيل جديد","فإنَّكِ فيه أشْبَهُ باليتيم",46,"م",1,0],["اذا ما عصاني كل شي اطاعني","ولم يجر في مجرى الزمان يباخله",47,"ل",2,0],["إِذا مَا عَلاَكَ لذَاتِ اليَمِينِ","تَدَحْرَجَ عَنْكَ لِذَاتِ الشِّمالِ",48,"ل",1,0],["اذا ما عصاني كل شي اطاعني","ولم يجري في مجرى الزمان يباخله",49,"ل",2,0],["إذا ما عايَنَتْكَ بنو سُلَيْمٍ","تَبيتُ لهم بداهيةٍ نآدِ",50,"د",1,0],["إذا ما عداه استرسلت في نفاقها","ففي سيفه بطش بكل منافق",51,"ق",1,0],["إِذا ما عَدِمنا طَلعةَ البَدرِ لَيلةً","فَلا بُدَّ بَعدَ اللَّيلِ أَن نُدركَ الفَجرا",52,"ر",2,0],["إذا ما عَتا شيطانُ أرض وإنْ نَأَتْ","فأقربُ شيءٍ منه نارُ شِهابِه",53,"ب",2,0],["إذا ما عابني أبناء جنسي","بنقص الحظ والكسب الضعيف",54,"ف",1,1],["إِذا ما عَرتهُ عِلَّةٌ جُذَّ رَأسُهُ","فَيَختالُ في ثَوبٍ جَديدٍ مِنَ العُمرِ",55,"ر",1,0],["إذا ما عَيَّروني فيك قالوا","حبيبك لا يزور ولن يُزَار",56,"ر",1,0],["إِذا ما عاتَبَتكَ بَنو سُلَيمٍ","ثَنَيتَ لَهُم بِداهِيَةٍ نَآدِ",57,"د",1,0],["اذا ما عَرى الأَملاكَ مِن ثَوبِ مِدحَةٍ","تَردّى بِهِ مِن دونِهِم وَتنزلا",58,"ل",2,0],["إِذا ما عاتَبَ الأَيّامَ حُرٌّ","بِغَيْرِكَ لَمْ تَزِدْ إِلاّ لَجاجا",59,"ج",2,0],["إذا ما علا يأسي يغالب لي الرجا","ويحجب من ريا الرضا ما تأرجا",60,"ج",2,1],["إِذا ما عَضَّكَ الدَهرُ","فَلا تَجنَح إِلى خَلقِ",61,"ق",1,1],["إذا ما علا في الصدر والنهى والأمر","وبثهما في النفع منه وفي الضر",62,"ر",1,1],["إِذا ما عصت غَيري القَوافي وَراعَها","يراعي غدت مِن خاتَم اليَد أَطوَعا",63,"ع",2,0],["إِذا ما عَلوا هام الصَريع مِن العِدا","فَللهامِ مِن أَقلامهنَّ صَريرُ",64,"ر",1,0],["إِذا ما عدَّ في الكرماءِ ختما","ذكرت بِهم محامده اِفتِتاحا",65,"ح",2,0],["إذا ما علَى النُّوّابِ ثُقِّلَ ثَقّلوا","عَلّى فلِي ما ضّرَّ صَحْبِيَ ضائر",66,"ر",1,0],["إِذا ما عَقَدَ الكاتِم","وحَلَّ المَدمَعُ السَّاجِم",67,"م",1,1],["إِذا ما عَوى الذئب مِن جيدِهِ","بِهِ ذعرت مِنهُ ظلمانه",68,"ن",2,0],["إِذا ما عَرَّس الخِطيُّ فيهم","فَإِنَّ رؤوسهم فيها نِثارُ",69,"ر",1,0],["إذا ما عَرا مالا أَطيقُ دفاعَهُ","وأرْمَضَني الفكرُ المُسَهِّدُ والهَمُّ",70,"م",1,1],["إذا ما عَرا خطبٌ من الدَّهرِ فاصطَبرْ","فإنَّ اللّيالِي بالخطوبِ حَوامِلُ",71,"ل",1,1],["إذا ما عدّدت أعيان قومٍ","وقابلنا نظيراً بالنَّظير",72,"ر",1,0],["إذا ما عزوا دِيناً فآخرُ عابدٍ","وإن قسموا دنيا فأوّلُ عائفِ",73,"ف",1,0],["إذا ما عُدلتَ به لم يزن","ك مثقالَ مجدٍ ولا كال صاعا",74,"ع",2,0],["إذا ما عليل البخل لم يُبرِ داءَه","مهافةُ هاجٍ لم يُثبْ قولَ مادحِ",75,"ح",1,0],["إذا ما عُقْيلٌ باهلت يوم فخرها","تأرَّج ناديها وطابَ نسيمُها",76,"م",3,1],["اذا ما عليُّ الخيرِ عُدَّ فَخارهُ","فكل ثرىً روض وكل دجىً فجرُ",77,"ر",1,1],["اذا ما عصتْ صيدُ الرقاب مُرادَه","براها بحدِّ الرأي قبلَ البَواترِ",78,"ر",1,0],["اذا ما عارضٌ أعْلى سَناهُ","توهَّمَ لمْعَ بارقهِ حُساما",79,"م",2,0],["إذا ما عدانا البينُ عنها بصرفه","فلا جادها جونٌ على السَّفح مسفوح",80,"ح",1,0],["إذا ما عشار المال حلت بربعه","أذيقت حمام البذل في الوفد كومها",81,"م",3,0],["إذا ما علا أفرنده صدأ الدُّجى","فأغمد لم يعدم من الريح صيقلا",82,"ل",2,0],["إِذا ما عَتابي طاشَ دارَتهُ بِالرِضا","فَإِن هُوَ لَم يَقنَع تَلافَتهُ بِالوَعدِ",83,"د",1,0],["إِذا ما عَلَقتُ بِأَذيالِهِ","بَلَغتُ المُرادَ وَنِلتُ المُنى",84,"ا",1,0],["اِذا ما عداهُ الوِردُ سارَ ميمَّماً","على ثقةٍ مِن وبلِ دمعي وطَلَّهِ",85,"ل",2,0],["إذا ما عُددت بُكر الغدايا","عليّ وأُحصيت حمر المشايا",86,"ا",3,0],["إذا ما عليٌّ كان في المجدِ والعُلا","سَليماً فلا زَيدٌ يَقولُ ولا عَمْرُو",87,"ر",2,0],["إذَا ما عَلَوْنا مِنْ مَسار شَمارِخاً","صَفَعْنَا بِصَعْفانٍ رُؤوسَ طَغامِ",88,"م",1,0],["إذا ما عظيمٌ صالَ يوما بشاعِر","فَصُل بابنِ إبراهيمَ من لا له نِدُّ",89,"د",1,0],["إِذا ما عَلا نَهداً وَعَرَّضَ ذابِلاً","وَقَحَّمَ بَكرِيّاً وَهَزَّ يَمانِيا",90,"ي",2,0],["إِذا ما عَصَت أَرخى الجَريرُ لِرَأسِها","فَمَلَّكَها عِصيانَها وَهيَ لا تَدري",91,"ر",2,0],["إِذا ما عَلَت مِنّا ذُؤابَةَ شارِبٍ","تَمَشَّت بِهِ مَشيَ المُقَيَّدِ في الوَحلِ",92,"ل",1,0],["إذا ما عزمنا واحتزمنا لمعرك","خلعنا على الأعداء قبل اللقا الذعرا",93,"ر",2,0],["إذا ما عدى بالعاديات إلى العدا","غشاهم بويل القارعات التزلزل",94,"ل",1,0],["إِذا ما عصى عاصٍ عليك فإِنما","بحافرِه ما بين عينيه مَوسِم",95,"م",1,0],["اذا ما عقرتم عشار الابل","فعقري عليه الفؤاد الوجل",96,"ل",1,0],["إذا ما عَدَا منه بأدْهَمَ للعدى","تَرَى النارَ منه بالحوافر تُقْدَحُ",97,"ح",1,0],["إذا ما علا للوعْظِ أعودَ مِنْبرٍ","رأيتَ الفصيحَ النُّطْقِ وهو كأعجَمِ",98,"م",1,0],["إِذا ما عَدِمُوا اللُّحْمَا","ن فالخبزُ أَو الصِّير",99,"ر",1,0],["إذا ما عَدَتْ تَجري كريحٍ تِخالُها","بساطَ ابن داوود عليه سلاميا",100,"ي",2,0],["إذا ما علت في الأرض دولتك استوى","هنالك مهدوم عليها وهادم",101,"م",1,0],["إذا مَا عَصَتُهُمْ فلا يُدهَشُونْ","فيا طالما قدْ عَصَاهُمْ بَنونْ",102,"ن",1,0],["إذا ما عَزَمْتَ إليْنا القُفول","تَوَخَّ السُّعُودَ إلينا قُفوُلا",103,"ل",2,0],["إِذا ما عَقَدنَ رايَةً عَلَوِيَّةً","جَعَلنَ ضَمانَ الفَتحِ في عَقدِها شَرطا",104,"ط",2,0],["إذا ما علا أظهر الصافنات","يزحزح في الأرض صم الجماد",105,"د",1,0],["إِذا ما عَلَوْنا فَالصُخورُ لِوَطْئِنا","مَراقٍ إِلى الجَوْزاءِ والطَّوْدُ سُلَّمُ",106,"م",1,0],["إذا ما عليٌ لاح لي نورُ وجهه","تزايل عني البؤسُ وانحسرَ النَّصبُ",107,"ب",1,0],["إذا ما عماد البيت مالَ مُجنَدلاً","فأى فؤاد لا يقدّ له قدَّا",108,"د",2,0],["إِذا ما عَدِمنا الفَجرَ خُضنا بِوَجهِهِ","دُجى اللَيلِ حَتّى يَستَبينَ لَنا الفَجرُ",109,"ر",1,0],["إِذا ما عُدنَ بِاللَحظِ","لِصَبٍّ عادَهُ النكسُ",110,"س",1,0],["إذا ما عَبَّ منها خلتَ خمراً","ولا خَدّاً وخدّاً ليس خَمرا",111,"ر",2,0],["إذا ما علا المرء رام العلا","ويقنع بالدون من كان دونا",112,"ن",2,1],["إذا ما علت في الصين أنوار كوكب","من الدين حيّاه بُبرقَةَ كوكب",113,"ب",1,0],["اذا ما عددنا الأكرمين ذوي النهى","وقد قدموا من صالح كنت أولا",114,"ل",2,0],["إِذا ما عُدَّ مِثلُهُمُ رِجالاً","فَما فَضلُ الرِجالِ عَلى النِساءِ",115,"ا",2,0],["إِذا ما عَدا الإِنسان في الشَيء طَوره","تَعَدت إَلَيهِ بِالغموز الحَواجب",116,"ب",1,0],["إذا ما عليٌ أمطرتك سماؤه","رأيت العلى أنواؤها تتحلب",117,"ب",1,0],["إذا ما علا منا على الظهر فارس","فليس بعيداً أن تطير القوائم",118,"م",1,0],["إذا ما عن لي شجن","فمن حرم إلى حرم",119,"م",1,0],["إِذا ما عَلَت حَزناً بَرَت صَهَواتِهِ","وَإِن أَسهَلَت أَذرَت غُباراً مُطَنَّبا",120,"ب",2,0],["إِذا ما عَدَدتَ الناسَ بَعدَ مُحَمَّدٍ","فَلَيسَ لِهارونَ الإِمامِ نَظيرُ",121,"ر",1,0],["إِذا ما علا الأعوادَ منا ابنُ حرَّةٍ","فأسفَرَ عن بدرٍ ولا حظَ عن صقرِ",122,"ر",1,1],["إِذا ما عَقَدنا لَهُ ذِمَةً","شَدَدنا العِناجَ وَعَقدَ الكَرب",123,"ب",1,0],["أذا مَا عقيقُ الرّمْلِ بانت خيّامُه","وأورقَ واديه وجادت غَمَامُه",124,"م",2,1],["إذا ما عن ذكركم عليه","يكاد يغص بالماء المعين",125,"ن",1,0],["إِذا ما عُقَيلِيٌّ أَقامَ بِذِمَّةٍ","شَريكَينِ فيها فَالعِبادِيُّ أَوجَرُ",126,"ر",1,0],["إذا ما عماني ألّم بأرضنا","أحطنا به نسأله عنكم تزاحما",127,"م",2,0],["إذا ما عملتِ الزاد فالتمسي له","أكيلاً فإني لستُ آكله وحدي",128,"د",2,0],["إِذا ما عَلَونا ظَهرَ نَشزٍ كَأَنَّما","عَلى الهامِ مِنّا قَيضُ بَيضٍ مُفَلَّقِ",129,"ق",1,0],["إذا ما عاقني عنه سقامي","أطير له بأجنحة الغناء",130,"ا",2,0],["إِذا ما عَلا يَوماً مِن الدَهر شَيظما","تَرى أَسَداً مِن تَحتهِ يحفر النسر",131,"ر",1,0],["إِذا ما عمت عَن فَضلكم عَين أَرمد","فَلا ضَير أن الشَمس تجحدها الرمد",132,"د",1,0],["إذا ما عدُّوك في القول زاد","على ما جرى مثلما قد يُريدُ",133,"د",1,1],["إِذا ما عَلا غُوريُّهُ أَرزَمَت بِهِ","تَوالٍ مَتالٍ مُخَّض فَتَحَدَّبا",134,"ب",2,0],["إِذا ما عَوى جاوَبتُ سَجعَ عوائِهِ","بِتَرنيمِ مَحزونٍ يَموتُ وَيُنشَرُ",135,"ر",1,0],["إِذا ما عد للقانون فضل","فَفَضلك قبلَ وَالقانون بعدُ",136,"د",1,0],["إذا ما عقدنا مِنَّةً عند جَاحد","فلم نَرهُ إلا حرُوناً عن الشُّكر",137,"ر",1,1],["إذا ما عدُوُّ الدّين جاسَ خِلالَهُ","ورامَ اسْتِراقَ السّمْعِ كُفَّ مَريدُهُ",138,"د",2,0],["اِذا ما عَلَينا قَد جَلا مِنهُ طَلعَةً","نَراهُ كَبَدرِ التمِّ سجان من بَرا",139,"ر",2,0],["اِذا ما عَن الاِحبابِ شَطَّ مَزارهُ","تَقول نِساءُ الحَيِّ أَينَ دِيارُهُ",140,"ه",1,0],["اذا ما عدا الخطب الجليل على الفتى","فيدنو اليه كي يجير ويقرب",141,"ب",1,0],["إِذا ما عَدا صُبحاً وَغارَ عَلى العِدى","تَرى موريات القَدح كَيف تَغير",142,"ر",1,0],["إِذا ما عَصَينا بِأَسيافِنا","تَرَكنا الجَماجِمَ أَغمادَها",143,"ه",2,1],["إِذا ما عَمَمتَ الناسَ بِالأُنسِ لَم تَزَل","لِصاحِبِ سوءٍ مُستَفيداً وَكاسِبا",144,"ب",2,1],["إذا ما عدائنا النصر في حومة الوغى","فصنعكم اضحى لنا بدل النصر",145,"ر",1,0],["إذا ما عنتم","بكسبِ الأثام",146,"م",1,0],["إِذا ما عيلَ صَبري في خُطوبٍ","فَلي السَلوى باسماعيل صَبري",147,"ر",2,0],["إِذا ما عَلا نذل عَلى ذي مَكارِمِ","فَلا بدع قَد يَعلو الرَمادَ عَلى الجَمر",148,"ر",1,1],["إِذا ما عَويص البَحث أَشكَل حله","بِفِكر كَعَضب للاصابَة صائِب",149,"ب",1,0],["إِذا ما عَلا الخَمْسَ في حَوْمَةٍ","ففارسُ بُهْمَتها راجِلُ",150,"ل",1,0],["إِذا ما عَلَيكَ الدَهرُ جَرَّدَ عَضبَهُ","وَرامَكَ بِالتَشتيتِ عَن كُلِّ ذي حُبِّ",151,"ب",1,1],["إِذا ما عَبَرَت قالَت","أَيا أُمُّ وَيا جَدَّه",152,"د",2,0],["إذا ما علا صدر السرير جرى لنا","به فلك بالخير والشر دائر",153,"ر",1,0],["اذا ما عُنِيتُمْ بِهذي البَنات","تَرَوا امَّهاتٍ لَكُمْ صالِحاتِ",154,"ت",1,0],["إذا ما عَصَت أمراً لهنَّ قلوبُهُم","ضَلالاً أطاعَت أمرَهُنَّ الجماجمُ",155,"م",1,0],["اذا ما عزمني ارضاء دهري","تخذت له مدائحه وسيلا",156,"ل",2,0],["اذا ما عُدتُ من جَمعِ البَقايا","تعاودُني خطوبُ الأمسِ حَرَّى",157,"ر",2,0],["إذا ما عُدَّت الأقوام عُدّوا","لهم في الناس عنوانٌ ودارُ",158,"ر",1,0],["إذا ما عَلّقَتْ قلبي","فلا تَسْألْهُ ما السَّبَبُ",159,"ب",1,0],["إذا ما عشقتك روح يا درة الزمن","فمن للقلب هذا حبيبة مدلله؟",160,"ل",2,0],["إذا ما علا المرء العلا","ويقنع بالدون من كان دونا",161,"ن",2,1],["إذا ما عشتَ في الدُّنيا فخورا","وشيَّدتَ المبانيَ والقصورا",162,"ر",2,1],["إذا ما علت يمناك كفا حسبتها","من البر أما تحت كلكلها مهد",163,"د",1,0],["إذا ما (عبلُ) صاحتْ يا لَقومي","أتوها بالرجالِ مع المهاري",164,"ر",2,0],["إذا ماعدت ياعمرا","ويا أغلى من العمر",165,"ر",1,0],["إذا ما عدا فوق الكميت ابن غابة","تخال العدى مثل النعام كماتها",166,"ت",3,0],["إذا ما عراني الخطب أسندت جانبي","إلى العز واستعصمت بالشرف المحض",167,"ض",1,0],["إذا ما عدت من عملٍ شريفٍ","وقد ظهرت بوادر من عناء",168,"ا",2,0],["إذا ما عدتَ عدتَ إلى خليل","وإن أصررتَ فاقض بما تشاء",169,"ا",2,0],["إذا ما عن الأجساد شُقّ وصالكم","فليس لوصل القلب شيء سيمنعه",170,"ع",2,0],["إذا ما عدتَّ للقرآنِ تلْقى","حقيقَةَ موْطِنِ الإسراءِ شمْسا",171,"س",2,0],["إذا ما عن أخوّتنا عمينا","فعين الله دوما لا تنامُ",172,"م",1,0],["إذا ما علا المأمونُ أعوادَ منبر","فليس له في العالمين ضَريبُ",173,"ب",1,0],["إذا ما علمتِ زماناً ندمتِ","فهل تطعمين بحاءٍ وباء!",174,"ا",2,0],["إِذا مَا عَصَانِي المَشْيُ أَعْطَيْتُهُ العَصَا","وكُلُّ عَصِيٍّ بِالعَصَا عَادَ طَائِعَا",175,"ع",2,1],["إِذا ما عُدتَ كَي تَغتالَ؛ فافعَلْ","وَلا تُخطِئْ؛ إِذا ما اختَرتَ مَقتَلْ",176,"ل",1,1],["إذا ما عليل البخل لم يبرِ داءه","مخافة ُ هاجٍ لم يثبْ قولَ مادحِ",177,"ح",1,0],["إذا ما عدلتَ بهِ لمْ يزن","كَ مثقالَ نجدٍ ولا كالَ صاعا",178,"ع",2,0]]}