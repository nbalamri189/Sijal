 ابتياعه","https://www.aldiwan.net/poem37617.html","الطويل"],[512,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[513,"أمعتسف المهامه والموامي","https://www.aldiwan.net/poem12250.html","الوافر"],[527,"يا رب لاطف ولدي","https://www.aldiwan.net/poem37150.html","مجزوء الرجز"],[532,"إلى الأمير فدته النفس أهديها","https://www.aldiwan.net/poem23814.html","البسيط"],[549,"ما رأتني عيناك يوم الفراق","https://www.aldiwan.net/poem47357.html","الخفيف"],[551,"وإني وإسماعيل يوم وداعه","https://www.aldiwan.net/poem68272.html","الطويل"],[556,"ربي تجلى بأنواع الخلائق لي","https://www.aldiwan.net/poem34211.html","البسيط"],[556,"فراشتي رأت النور الذي ظهرا","https://www.aldiwan.net/poem34480.html","البسيط"],[559,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[565,"شارفتنا طلائع المهرجان","https://www.aldiwan.net/poem69480.html","الخفيف"],[565,"قفل الدجى وأتى الصباح حميدا","https://www.aldiwan.net/poem69716.html","الكامل"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"قد همت بالبدوي في الحلل","https://www.aldiwan.net/poem2886.html","أحذ الكامل"],[573,"نعم المشوق وأنعم المعشوق","https://www.aldiwan.net/poem3046.html","الكامل"],[581,"كبيشة عرسي تمنى الطلاقا","https://www.aldiwan.net/poem443.html",""],[584,"جيش الملاحة مقرون به الظفر","https://www.aldiwan.net/poem17513.html","البسيط"],[585,"يا تاركاً لمراضي الله أوطاناً","https://www.aldiwan.net/poem11514.html","عموديه"]],"verses":[["فَالقَلبُ لِلشانينَ إِن لَم يَكتَئِب","وَالجَفنُ لِلأَعداءِ إِن لَم يَدمَعِ",0,"ع",1,0],["فَأَلقاها عَلى قُربٍ وَبُعدٍ","فَلا هَجراً تُجِدُّ وَلا وِصالا",1,"ل",2,0],["فَأَلْقَيْتُ إِذْ لَمْ يَبْقَ في الأَرْضِ مَسْرَحٌ","رِحالي فَقُلْ في الطَّرْفِ ضاقَ مَجالُهُ",2,"ل",2,0],["فَالقَتلُ لي مِن بَعدِ عَبلَةَ راحَةٌ","وَالعَيشُ بَعدَ فِراقِها مَنكودُ",3,"د",1,0],["فَالقَلبُ مَزرَعَةُ الهَوى","وَنباتُهُ شَوكُ القَتادِ",4,"د",1,0],["فالقوْمُ منْكَ تجمّعوا في واحِدٍ","ولَدٌ كَما شاءَ العُلاءُ ووالِدُ",5,"د",1,0],["فَأَلقى إِلى عَبدِ الحَفيظِ بِتاجِهِ","وَمَرَّ عَلى أَدراجِهِ يَتَعَثَّرُ",6,"ر",1,0],["فَالقَلبُ أَصورُ عِندَهُنَّ كَأَنَّما","يَجذِبنَهُ بِنَوازِعِ الأَشطانِ",7,"ن",1,0],["فَاِلقَوهُمُ بِسُيوفِكُم وَرِماحِكُم","وَبِنَضخَةٍ في اللَيلِ كَالقَطرِ",8,"ر",1,0],["فَأَلقاهُمُ بِالبِشرِ وَالبِرِّ وَالقِرى","وَيَقدُمُهُم نَحوي يُبَشِّرُني كَلبي",9,"ي",1,0],["فالقوم أما حظّهم فقد رقد","عنهم وأما سعدهم فقد خَمَد",10,"د",1,0],["فالقبح كالحسن في حكم النهى عَرَض","وليس يَثبُت إلاّ عند مُعتَبِر",11,"ر",1,0],["فألقيتُ وجهاً خدّد الدمعُ خدَّه","ومحمرَّ جَفن بالبكار مُتَورَمَّ",12,"م",1,0],["فألقيت كفّي فوق صدري مسلمّاً","وأطرقت نحو الأرض منحني الظهر",13,"ر",1,0],["فَالقُرَيّاتِ مِن بَلاسَ فَدارَي","يا فَسَكّاءَ فَالقُصورِ الدَواني",14,"ن",2,0],["فالقطر أرجو ولا عجيبٌ","ألقطر يرجى من الغمام",15,"م",1,0],["فألقَتْ شلْوَهُ من رأس طودٍ","فِعال الجاهلية بالوئيدِ",16,"د",1,0],["فالقلبُ قلبٌ كاسمه","منهُ التقلب والفتور",17,"ر",1,0],["فالقاتل المقتول ثَمَّ لضعفه","وَلوَهْيِه والآسرُ المأسور",18,"ر",1,0],["فألقى إلينا عِذرةً لا نردُّها","وكان مُلقّىً حجةَ اللؤمِ والبخل",19,"ل",1,0],["فالْقَ في حاجتي أخاك أبا الصق","رِ مُجدّاً مشمِّرَ الأذيالِ",20,"ل",1,0],["فالْقَ في حاجتي أخاك أبا الصق","رِ تجدْه مشمّر الأذيالِ",21,"ل",1,0],["فألقاهُ في مَنْجى السَّفينِ وإنما","بحيثُ يشمُّ الرُّوحَ ركبانُها يُغمْ",22,"م",1,0],["فالقطْرُ ضربةُ لازمٍ قسماً","والصحوُ فيه تحِلَّةُ القسمِ",23,"م",1,0],["فألقى عِذرةً كذباً ومَيْناً","من العِذَرات يأْباها الحقين",24,"ن",1,0],["فَأَلقى غِمدَهُ وَهَوى إِلَيهِم","كَما تَنقَضُّ خائِتَةٌ طَلوبُ",25,"ب",1,0],["فَالقَلبُ مِن حُبِّها يَعتادُهُ سَقَمٌ","إِذا تَذَكَّرتُها وَالجِسمُ مَسلولُ",26,"ل",1,0],["فَالقَلبُ عانٍ وَإِن لامَت عَواذِلُهُ","في حَبلِهِنَّ أَسيرٌ مُسمِحُ الجَنَبِ",27,"ب",1,0],["فَالقَطرُ كَاللُؤلُؤِ المَنثورِ يَنفُضُهُ","إِذا اِقشَعَرَّ بِهِ سِربالُهُ اللَثِقُ",28,"ق",1,0],["فَأَلقَت في تُرابِها وَتَبَسَّمَت","أَعيٌ سُكوتُ الصَبِّ أَم صَمتُهُ عَمدُ",29,"د",1,0],["فَالقَلبُ مُنشَغِلٌ بِتَذكاراتِهِ","وَالطَرفُ مُندَفِعٌ مَعَ التَيّارِ",30,"ر",1,0],["فَأَلقَت إِلَيهِ صُرَّةً وَتَراجَعَت","وَفي وَجهِها نورُ السُرورِ يَجولُ",31,"ل",1,0],["فَالقاتِلُ الآلافِ غازٍ فاتِحٌ","وَالقاتِلُ الجاني أَثيمٌ جانِ",32,"ن",1,0],["فَالقَلبُ يَعلَمُ أَنَّهُ في غَيِّهِ","لَكِن تَغَطَّت عَنهُ سُبلُ رَشادِهِ",33,"د",2,0],["فَأَلقى عَصا طَلحٍ وَنَعلاً كَأَنَّها","جَناحُ السُمانى رَأسُهُ قَد تَصَوَّعا",34,"ع",2,0],["فالقيت منك النفس لا عن روية","بهاوية ليست بذات مخارج",35,"ج",1,0],["فَأَلقى بَعضَ ما تَلقى","مِنَ الغِبطَةِ وَالأُنسِ",36,"س",1,0],["فَأَلقَينا المَراسِيَ وَاِحتَوانا","بِناءٌ لِلخِلافَةِ مُشمَخِرُّ",37,"ر",1,0],["فَالقُدودُ بانُ رُبىً","بَيدَ أَنَّها تَثِبُ",38,"ب",1,0],["فالْقَهُ غَيْرَ أَنّما لِبْدَتَاهُ","أَبْيَضٌ صارِمٌ وأَسْمَرُ عالِ",39,"ل",1,0],["فَأَلقَت بِكَفَّيهِ المَنِيَّةُ إِذ دَنا","بِعَضَّةِ أَنيابٍ سَريعٍ سُؤورُها",40,"ر",3,0],["فَأَلقَت لَهُ الأَيّامُ كُلَّ خَبيأَةٍ","عَلى ذِروَةٍ لا تُرتَقى بِالسَلالِمِ",41,"م",1,0],["فالِقَ الصَباحَ بِالصَبو","حِ قَبلَ ضَوءِ الشَفَقِ",42,"ق",1,0],["فَاِلقَ صَدرَ الخَميسِ مِنكَ بِصَدرٍ","لَم يَزَل في الهِياجِ صَدرَ الخَميسِ",43,"س",1,0],["فَاِلقَ العُداةَ بِطَلعَةٍ","عَنها النَواظِرُ تَخسَأُ",44,"ا",1,0],["فالقلبُ يُذكي جذوةً تلتظي","والعينُ تُذْري عَبْرَةً تنسجم",45,"م",1,0],["فالقُ الهامِ إذا كرّ سطا","مِسْعَرُ الحربِ إذا همّ اعتَزَم",46,"م",1,0],["فالقٌ هامةَ الشُّجاعِ بعَضْبٍ","مطفئٌ روحَهُ بإيقادِ نارِ",47,"ر",1,0],["فالقضيبُ اهتَزّ والبَدرُ بدا","والكثيبُ ارتَجّ والعنبرُ فاح",48,"ح",1,0],["فالقوامُ الغُصْنُ والرِّدف النَّقا","والأقاحُ الثَّغْرُ والطَّلُ الرُّضاب",49,"ب",1,0],["فالقدُّ منك ووجنتاكِ ومبسمٌ","غصنٌ وتفاحٌ وحَبُّ غمامِ",50,"م",1,0],["فَالقَلبُ مِن ذِكرى حُمَيدَةَ مُوجَعٌ","وَالدَمعُ مُنحَدِرٌ وَدَمعِيَ فاتِرُ",51,"ر",1,0],["فَأَلقاكِ عِندَ الرُكنِ أَو جانِبَ الصَفا","وَيَشغَلَ عَنّا أَهلَ مَكَّةَ سوقُها",52,"ق",3,0],["فَأَلقُطُ دُرّاً مِن فُضولِ حَديثِهِ","وَأَشرَبُ طيبَ العَيشِ مِن فَضلَةِ الكاسِ",53,"س",1,0],["فَأَلقَيتُ رَحلي وَاِحزَأَلَّ كَأَنَّهُ","شَفاً مُجنَحٌ في مُحَناهُ ضُجوعُ",54,"ع",1,0],["فَالقَومُ أَجنُبَها شَرائِجُ مِنهُمُ","طاهٍ يَحُشُّ وَهَبهَبِيٌّ يَف