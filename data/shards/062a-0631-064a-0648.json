{"poems":[[55,"أراك ستحدث للقلب وجدا","https://www.aldiwan.net/poem30614.html","المتقارب"],[36,"أليس الليل يجمعني وليلى","https://www.aldiwan.net/poem4938.html","الوافر"],[32,"أللربع ظلت عينك الماء تهمل","https://www.aldiwan.net/poem29546.html","الطويل"],[40,"ضعيف العصا بادي العروق ترى له","https://www.aldiwan.net/poem7728.html","الطويل"],[47,"مع الدهر ظلم ليس يقلع راتبه","https://www.aldiwan.net/poem10905.html","الطويل"],[47,"خذا من بكاء في المنازل أو دعا","https://www.aldiwan.net/poem64674.html","الطويل"],[47,"على ابن المغيرة أن يقتلا","https://www.aldiwan.net/poem65651.html","المتقارب"],[30,"فأنت إذ لم تكن إياه صاحبه","https://www.aldiwan.net/poem5082.html","البسيط"],[63,"قصاراك في اللوم أن تقصرا","https://www.aldiwan.net/poem51610.html","المتقارب"],[35,"أليس الليل يجمعني وليلى","https://www.aldiwan.net/poem25772.html","الوافر"],[48,"تغدو على الأرض في حالات ساكنها","https://www.aldiwan.net/poem22937.html","البسيط"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16636","البسيط"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/24023","الوافر"],[102,"تحت السكاكين","https://www.poetsgate.com/ViewPoem.aspx?id=50374",""],[47,"خُذا مِنْ بُكاءٍ في المَنازِلِ، أوْ دَعَا","https://www.poetsgate.com/ViewPoem.aspx?id=31218",""],[146,"قد رجع الحق إلى نصابه","https://www.aldiwan.net/poem58439.html","الرجز"],[164,"إليك فلو أدركت مغنى الهوى مغنا","https://www.aldiwan.net/poem59014.html","الطويل"],[216,"فمن مقلتي روحي جرت عبراتها","https://www.aldiwan.net/poem37908.html","الطويل"],[240,"الحمد لله عوفي الكرم","https://www.aldiwan.net/poem31763.html","المنسرح"],[254,"ألا ظعن الخليط غداة ريعوا","https://www.aldiwan.net/poem2107.html","الوافر"],[285,"أبا حسن أنت أهل الجميل","https://www.aldiwan.net/poem60592.html","المتقارب"],[310,"خطب له الدين أرنى لحظ مذعور","https://www.aldiwan.net/poem56539.html","البسيط"],[356,"ترى وردها والأقحوان كأنه","https://www.aldiwan.net/poem68985.html","الطويل"],[447,"يا خالق الخلق يا من جوده الجود","https://www.aldiwan.net/poem14289.html","البسيط"],[447,"ليت الكفان الذي إن مت لي صنعا","https://www.aldiwan.net/poem14333.html","البسيط"],[463,"صدت بنعمان على طول الصدى","https://www.aldiwan.net/poem56213.html","الرجز"],[466,"أروم بفضلي نصرة وبمقولي","https://www.aldiwan.net/poem16041.html","الطويل"],[473,"تشتت شمل الصبر واتصل الضد","https://www.aldiwan.net/poem60222.html","الطويل"],[543,"لله يومان تحكي غمض أجفان","https://www.aldiwan.net/poem47920.html","عموديه"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77582","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59091","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96727","الوافر"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96719","المتقارب"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96667","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49948","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79989","الطويل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77962","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62907","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48460","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91111","الطويل"],[3707,"","https://poetry.dctabudhabi.ae/diwan/poem/124631","الطويل"],[3733,"","https://poetry.dctabudhabi.ae/diwan/poem/21414","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135231","البسيط"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93297","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72475","البسيط"],[4690,"هَلاّ تَفَضّلْتَ بالهُبوبِ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=175476",""],[5582,"حَلِيفُ جَوَىً ما ناحَ يَوْماً حَمامُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=187264",""],[5582,"سَقاكِ دِيارَ الظَّاعِنِينَ غَمامُ","https://www.poetsgate.com/ViewPoem.aspx?id=187273",""],[5664,"سلامات","https://www.poetsgate.com/ViewPoem.aspx?id=176698",""],[5694,"واحد من المليار","https://www.poetsgate.com/ViewPoem.aspx?id=129911",""],[4442,"أبت أن تسيغ العيش ألا بما تهوى","https://www.poetsgate.com/ViewPoem.aspx?id=170991",""],[6142,"أهاشم هل للبيض سلة ثائر","https://www.poetsgate.com/ViewPoem.aspx?id=155748",""],[6171,"لا فِتَةٌ عَلى بَوابةِ العَام","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84672&r=&rc=2",""]],"verses":[["تَرى وَجهَهُ في حُضورِ النَدى","كَالعَضبِ رَقرَقتَ فيهِ الفِرِندا",0,"د",2,0],["تَرى وَضحَ النَهارَ كَما أَراهُ","وَيَعلوها الظَلامَ كَما عَلاني",1,"ي",1,0],["تُرى وَلَها ظَهرٌ وَبَطنٌ وَذُروَةٌ","وَتَشرَبُ مِن بَردِ الشَرابِ وَتَأكُلُ",2,"ل",1,0],["تَرى وَجهَهُ قَد شابَ في غَيرِ لِحيَةٍ","وَذا لُبَدٍ تَحتَ العِصابَةِ أَنزَعا",3,"ع",2,0],["تَرى واشِجَ الخِرصانِ يَهتِكُ بَينَهُم","نُحورَ الأُسودِ أَو تُرَوّى ثَعالِبُه",4,"ب",2,0],["تَرى وَلَعَ السُؤالِ يَكسو جَبينَهُ","إِذا قَطَّبَ المَسئولُ بِشراً مُوَلَّعا",5,"ع",2,0],["تَرى وَجهَهُ أَبَداً كالِحاً","وَعَن نَعَمٍ فَمُهُ مُقفَلا",6,"ل",2,0],["تَرى وُجوهَ بَني مَروانَ تَحسِبُها","عِندَ اللِقاءِ مَشوفاتِ الدَنانيرِ",7,"ر",1,0],["ترى وَرْدَ وَجنَتِه أحمراً","وريحانَ شاربِه أخضرَا",8,"ر",2,0],["تَرى وَضَحَ النَهارِ كَما أَراهُ","وَيَعلوها النَهارُ كَما عَلاني",9,"ي",1,0],["تَرى وَميضَ حَياءٍ لا حَيا قَلِقاً","عِندَ الثُرَيّا وَهَل سارٍ فَمُنتَجِعُ",10,"ع",1,0],["تَرى وُجوهَ المَنايا في جَوانبِها","يُخَلْنَ أوْجُهَ جِنّانٍ عَفاريتَا",11,"ت",2,0],["ترى وقعاته أبداً خطايا","إلى أن يسبطرَّ له صريع",12,"ع",1,0],["ترى وجهها الشمس فيه كما","ترى وجهها، في المرايا المليحه",13,"ح",2,0],["تَرَى وَلعَ السّؤالِ يَكْسُو جَبينَهُ،","إذا قَطّبَ المَسؤولُ، بشْراً مُوَلَّعَا",14,"ع",2,0],["ترى وفودَ الشكر حولَ بيته","كأنها الأوتادُ في أطنابه",15,"ب",2,0],["ترى ورد خديها وصارم لحظها","طليقين ذا يجني وذلك لا يجنا",16,"ن",2,0],["ترى وجهَه بالبِشْرِ يُشْرِق نيّراً","إذا البَهْمُ في الهيجا علت صعقاتها",17,"ت",3,0],["تَرى وُفودَ النَدى بِساحَتِهِ","عَلى بُحورِ العَطاءِ تَزدَحِمُ",18,"م",1,0],["تَرى وَدَكَ السَديفِ عَلى لِحاهُم","كَلَونِ الراءِ لَبَّدَهُ الصَقيعُ",19,"ع",1,0],["تُرى وَهْيَ مُسْمَنَةٌ ظاهِراً","وَلكِنَّها باطِناً مُسْقَمَهْ",20,"م",2,0],["تَرى وجوهَ وجومٍ لا حراكَ بهم","كأنّما صُعِقوا مِن نفخةِ الصورِ",21,"ر",1,0],["ترى وردَها والأقحوانَ كأَنّه","بِها شفةٌ لمياءُ ضاحَكها ثَغر",22,"ر",1,1],["ترى ولست ترى دنيا وآخرة","علام ما سترته البيض والسود",23,"د",1,0],["ترى ولست ترى عطي وتمنع من","تشا وما عنك شيء عز ممتنعا",24,"ع",2,0],["ترى وفي شروعها ضراعةٌ","حرارةً على الكبودِ أبردا",25,"د",2,0],["ترى وجَباتِ الطَّعْن وهي ظميئةٌ","بشيراً لها لا صوت رعْدٍ مُجلجل",26,"ل",1,0],["تَرى وَصلَ مَن يَدنو إِلَيها مُحَرَّماً","فَطوبى لِمَن أَضحى لَهُ عِندَها رِفدُ",27,"د",1,0],["تَرى وُفودَ الورى تَترى وَكُلُّهُمُ","لِذلكَ الرَّبعِ شَوقاً جِدُّ لَهفانِ",28,"ن",1,0],["تَرى وَماذا قالَهُ في أُذنك","لَما أَتى مقلِّباً في بَدَنك",29,"ك",1,0],["تَرَى وَلَع السُّؤَّالِ يَكْسُو جَبِينهُ","إذَا عبر المسؤول بشر المسرة",30,"ه",1,0],["تَرى وسطَ الخيام لها شعاعاً","كأنَّ الشمسَ حلّت في الخيامِ",31,"م",1,0],["تَرى وجهَها مِن وراءِ اللثا","مِ كالشمسِ تلبس غيماً جهاما",32,"م",2,0],["تَرى وقعاتِ اللثمِ إِن رُمت لَثمها","لَها أَثرٌ في خدّها المُتعصفرِ",33,"ر",1,0],["ترى وفود الغنى والعزّ عندهما","يرعون وسط رياضٍ بين أطوادِ",34,"د",1,0],["ترى وفدَه منه تطيف بمورقٍ","على جودِ كفَّيه الرجاء المشذَّبُ",35,"ب",1,0],["تَرى وَتَسمَع لا عَينٌ وَلا أذنٌ","شمٌّ وَذوقٌ ولمسٌ لا بإِحساس",36,"س",1,0],["تَرى ولداً في الملكِ يخلف والداً","كما خلفَ البدرَ المنيرَ هِلالُ",37,"ل",1,0],["تَرى وجْهَهُ طلْقَ الأسرّةِ كلّما","أفادَ العَطايا باسِماً متهلِّلا",38,"ل",2,0],["تَرى وُكَنات المضرحيّ تباذخت","بآمالنا وَالنَفس بالنيل تلهج",39,"ج",1,0],["تَرَى وجه بَسَّام أَغَرَّ كأَنَّما","تفرّج تاجُ الملكِ عَن ضَوءِ كَوكَبِ",40,"ب",1,0],["تَرى وَرَقَ الفِتيانِ فيها كأَنَّها","دَراهِمُ مِنها جائزاتٌ وَزائِفُ",41,"ف",1,0],["ترى وتسمع مَن دعاك مجتمعاً","ووحده والذي عليك يستندُ",42,"د",1,0],["ترى وَليّ الثأْر إِن أَراده","فهل مُجيرٌ من مُجير الدين هل",43,"ل",1,0],["ترى وكم عاطل من جيد","كم ذقت منها زلالا صافي",44,"ي",1,0],["تُرى وهلْ ...؟ أمْ فقطْ جُنُوني","رُحماكَ يا عالِم الغُيوب !",45,"ب",1,0],["تَرَى وَجْهَها يَغْشاهُ مِنْ سَلْسَلِ الحَيا","لِثامٌ إِذا ما زالَ عَنْهُ لِثامُهُ",46,"م",2,0],["تَرَى وَجْهَها تَحْتَ النِّقابِ كَمِثْلِ ما","يَجُولُ عَلَى شَمْسِ النَّهارِ جَهامُ",47,"م",1,0],["ترى وصفك يجي بسنين ماهو في قلم والوان","بمعنى سنين خلق الله اذا توصف ماتوصلك",48,"ك",1,0],["ترى والله مالومك لو قضى صبرك ولو حزّنت","حمسك الهم في ضلع الندامه حمسة البنه",49,"ن",2,0],["ترى ويراك النازح الدار مغنما","وأين من الزرقاء ذو المقلة العشوى؟",50,"و",2,0],["ترى وعزيزٌ أن ترى غر قومها","على الأرض صرعى كالنجوم الزواهر",51,"ر",1,0],["تَرَى وَجهَهَا في صفحةِ الخيرِ وحْدَها","تَقُومُ على الأشواقِ تَبْنِي وتَعْمُرُ",52,"ر",1,0]]}