ww.aldiwan.net/poem64457.html","مجزوء الرمل"],[46,"أبيد على التناسب كل يوم","https://www.aldiwan.net/poem22437.html","الوافر"],[46,"أذهني طال عهدك بالصقال","https://www.aldiwan.net/poem23230.html","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54933","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54917","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43754","الطويل"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/10152","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54223","البسيط"],[0,"قفا نبك من ذِكرى حبيب ومنزل ( معلقة )","https://www.poetsgate.com/ViewPoem.aspx?id=4730",""],[54,"رأَيتُ غزالاً وقد أَقبَلَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=14451",""],[85,"كان ذئبٌ يتغدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9723&r=&rc=213",""]],"verses":[["كَأَنَّ ذا المَطلَعَ أَمسى الرَدى","رَصيدَهُ وَاِزوَرَّ عَنهُ الفَريق",0,"ق",1,0],["كَأَنَّ ذُرى مَعالِمِها قِلاصٌ","نَواءٍ كُشِّطَت عَنها الجُلودُ",1,"د",1,0],["كانَ ذا الطاقَةِ بِالثِقلِ إِذا","ضَنَّ مَولى المَرءِ عَنهُ وَصَفَح",2,"ح",1,0],["كَأَنَّ ذُرى رَأسِ المُجَيمِرِ غُدوَةً","مِنَ السَيلِ وَالغُثّاءِ فَلكَةُ مِغزَلِ",3,"ل",1,0],["كَأَنَّ ذُيولَ الجُلَّنارِ مُطِلَّةً","فُضولُ ذُيولِ الغانِياتِ مِنَ الأُزرِ",4,"ر",1,0],["كَأَنَّ ذَوي الحاجاتِ يَغشَونَ مُصعَباً","أَزَبَّ الجِرانِ ذا سَنامَينِ أَحرَدا",5,"د",2,0],["كَأَنَّ ذِراعَيها عَلى الخَلِّ بَعدَما","وَنينَ ذِراعا ماتِحٍ مُتَجَرِّدِ",6,"د",1,0],["كانَ ذاكَ الأَنينُ مِن حَجَرٍ في ال","سَدِّ يَشكو المَقادِرَ العَمياءَ",7,"ا",2,0],["كانَ ذاكَ البُعادُ أَروَحُ لِلقَل","بِ لِأَنَّ الغَرامَ بِالقُربِ زادا",8,"د",2,0],["كان ذاك العيش الذي لم يدم لي","حلماً مر طيفه خداعا",9,"ع",2,0],["كان ذاك الشباب مثل ربيع","منبت من انواره انواعا",9,"ع",2,0],["كانَ ذِئبٌ يَتَغَذّى","فَجَرَت في الزَورِ عَظمَه",10,"م",2,1],["كانَ ذَمّي لِلغانِياتِ وَشَكوا","يَ هَواهُنَّ نَفثَةَ المَصدورِ",11,"ر",1,0],["كَأَنَّ ذُكورَ الخَيلِ في غَمَراتِهِ","يَخُضنَ إِذا أُكرِهنَ فيهِ بِهِ الوَحلا",12,"ل",2,0],["كأنَّ ذُرَى الغُصونِ لَبِسنَ منه","حِلَى الكافورِ رَبَّاتُ الحِجالِ",13,"ل",1,0],["كأنَّ ذؤابَتَه إذ عَلَتْ","لواءٌ على جَمْرَةٍ خافقُ",14,"ق",1,0],["كَأَنَّ ذَوي الحاجاتِ حَولَ قِبابِهِ","جِمالٌ لَدى ماءٍ يَحُمنَ حَواني",15,"ن",2,0],["كَأَنَّ ذا العَينِ في تَطَرُّفِها","لَعباً وَلَهواً قَد عايَنَ الهَلَكا",16,"ك",2,0],["كَأَنَّ ذِكرَ رَسولِ اللَهِ مَرَّ بِها","فَأُكسِبَت أَرَجاً مِن نَشرِهِ العَبِقِ",17,"ق",1,0],["كأنّ ذكرَكَ والدنْيا به عَبَقَتْ","في البأس والجودِ مخلوعٌ عَنِ المثَلِ",18,"ل",1,0],["كانَ ذا كلّه زمانَ شبابٍ","كنتُ فيه على الدُّمَى بالخيارِ",19,"ر",1,0],["كان ذا والزمانُ سَمْحُ السجَايا","بِبَوادٍ منَ الأَماني وعُوّد",20,"د",1,0],["كأنّ ذُبابَهُ شادي صَبوحٍ","يحرّكُ إن ضربتُ به رقابا",21,"ب",2,0],["كانَ ذا في مَسيرِنا وَرَجَعنا","عَلِمَ اللَهُ مِنهُ ما قَد نَوَينا",22,"ن",2,0],["كانَ ذا نَخوة وَفيهِ حميه","أَينَ مِنها حَمية الجاهليه",23,"ي",2,0],["كانَ ذاكَ الأُفقُ مِنها","أَخصَبَ الآفاقِ أُفقا",24,"ق",2,0],["كَأَنَّ ذَوي التَنَعُّمِ في البَرايا","نَعامٌ راحَ يَلتَقِطُ الهَبيدا",25,"د",2,0],["كَأَنَّ ذَوي تَجارُبِنا سَوامٌ","تَأَنَّقُ في مُرادٍ وَاِبتِقالِ",26,"ل",1,0],["كَانَ ذَاكَ الجَافِي العَبُوسُ المُحَيَّا","في المُعاطَاةِ أَسْمَحَ السُّمَحَاءِ",27,"ا",2,0],["كَان ذَاكَ الهَوَى سَلاَماً وَبَرْداً","فَاغْتدَى حِينَ شبَّ جَذْوَةَ نَارِ",28,"ر",1,0],["كَانَ ذَاكَ الفَقِيدُ مِنْ أَكْرَمِ","الخَلقِ بِأَخْلاقِهِ وَلَيْسُوا بِكُثْرِ",29,"ر",1,0],["كَأَنَّ ذِراعي جُذَّ مِن عَضدي بِهِ","كَأَنَّ حُسامي فُلُّ وَهوَ لِساني",30,"ن",2,0],["كَأَنَّ ذِراعاً عَلا كَفَّها","إِذا حَسَرَت ذَنَبُ المِلعَقَه",31,"ق",2,0],["كَأَنَّ ذِكْرَاهُ لَمَّا سَارَ سَائِرُهَا","عَبِيرُ دَانِيَة الظِّلَّيْنِ مِعْطَارِ",32,"ر",1,0],["كأن ذرى رأس المجيمر غدوة","ً من السَّيلِ وَالأغْثاء فَلكة ُ مِغزَلِ",33,"ل",1,0],["كأنَّ ذراعاً علا كفَّها","إذا حسرتْ ، ذنبُ المعلقهْ",34,"ق",2,0],["كان ذئبٌ يتغدى","فجرتْ في الزّوْر عَظمه",35,"م",2,1]]}