{"poems":[[55,"تعيف الطير فأنبأنه","https://www.aldiwan.net/poem29951.html","السريع"],[55,"أرى بغداد قد أخنى عليها","https://www.aldiwan.net/poem30511.html","الوافر"],[9,"ما تعيف اليوم في الطير الروح","https://www.aldiwan.net/poem21921.html","الرمل"],[0,"قفا نبك من ذكرى حبيب ومنزِل","https://www.aldiwan.net/poem50.html","الطويل"],[49,"ويوم جلا فيه الربيع رياضه","https://www.aldiwan.net/poem25279.html","الطويل"],[31,"صحا القلب إلا من ظعائن فاتني","https://www.aldiwan.net/poem6052.html","الطويل"],[16,"ويلم لذات الشباب معيشة","https://www.aldiwan.net/poem27682.html","الطويل"],[93,"سمع الليل ذو النجوم أنينا","https://www.aldiwan.net/poem8731.html","عموديه"],[72,"قربت دارنا ولم يفد القر","https://www.aldiwan.net/poem42955.html","الخفيف"],[91,"ذهبت ايام الشباب سراعا","https://www.aldiwan.net/poem44894.html","الخفيف"],[87,"كان ذئب يتغذى","https://www.aldiwan.net/poem8000.html","مجزوء الرمل"],[47,"أجد الوجد جمرة في ضميري","https://www.aldiwan.net/poem63593.html","الخفيف"],[30,"كأني إذا ما كنت عندك مشرف","https://www.aldiwan.net/poem5446.html","الطويل"],[63,"أفق من سكرة الأمل المحال","https://www.aldiwan.net/poem51465.html","الوافر"],[63,"طرقنا أبا عامر موهنا","https://www.aldiwan.net/poem51507.html","المتقارب"],[2,"تبين خليلي هل ترى من ظعائن","https://www.aldiwan.net/poem25003.html","الطويل"],[51,"لا تنس واذكر سبيل من هلكا","https://www.aldiwan.net/poem62206.html","المنسرح"],[68,"فيروزج الصبح أم يا قوتة الشفق","https://www.aldiwan.net/poem41544.html","البسيط"],[82,"ملاعب البيض بين البيض والأسل","https://www.aldiwan.net/poem31322.html","البسيط"],[82,"عجبي من سكينتي ووقاري","https://www.aldiwan.net/poem31439.html","الخفيف"],[82,"نحن في جنة نباكر منها","https://www.aldiwan.net/poem31497.html","الخفيف"],[82,"ألا كم تسمع الزمن العتابا","https://www.aldiwan.net/poem31566.html","الوافر"],[33,"لم تر العين للثريا شبيها","https://www.aldiwan.net/poem41276.html","الخفيف"],[104,"مرحبا بالثقافة الغربيه","https://www.aldiwan.net/poem33122.html","الخفيف"],[50,"عجبا لي كيف أبقى","https://www.aldiwan.net/poem64457.html","مجزوء الرمل"],[48,"أبيد على التناسب كل يوم","https://www.aldiwan.net/poem22437.html","الوافر"],[48,"أذهني طال عهدك بالصقال","https://www.aldiwan.net/poem23230.html","الوافر"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62300","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62204","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54933","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54917","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43754","الطويل"],[56,"","https://poetry.dctabudhabi.ae/diwan/poem/10152","المتقارب"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54223","البسيط"],[0,"قفا نبك من ذِكرى حبيب ومنزل ( معلقة )","https://www.poetsgate.com/ViewPoem.aspx?id=4730",""],[56,"رأَيتُ غزالاً وقد أَقبَلَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=14451",""],[87,"كان ذئبٌ يتغدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9723&r=&rc=213",""],[112,"جف روضي من الحوادث لكن","https://www.aldiwan.net/poem16193.html","الخفيف"],[123,"غذائي الحب يا من فيه حرمان","https://www.aldiwan.net/poem49336.html","البسيط"],[188,"ويوم برد عقوده برد","https://www.aldiwan.net/poem14523.html","المنسرح"],[202,"كان ذاك الصديق فيما رأينا","https://www.aldiwan.net/poem45199.html","الخفيف"],[225,"عوارض آس ما أرى أم زبرجد","https://www.aldiwan.net/poem55411.html","الطويل"],[226,"أتجهل قدر بشر إن بشرا","https://www.aldiwan.net/poem39691.html","الوافر"],[226,"جثم الليل بأحضان التلال","https://www.aldiwan.net/poem41896.html","الرمل"],[238,"سقى صوب الحيا دمنا","https://www.aldiwan.net/poem31915.html","مجزوء الوافر"],[300,"أحباي أما الود مني فراسخ","https://www.aldiwan.net/poem33295.html","الطويل"],[301,"سقيا لمن أضرمت من حبها كبدي","https://www.aldiwan.net/poem36322.html","عموديه"],[340,"أتعرف رسما دارسا قد تغيرا","https://www.aldiwan.net/poem45431.html","الطويل"],[354,"ومختلف الأصوات مؤتلف الزحف","https://www.aldiwan.net/poem68975.html","الطويل"],[367,"بغرة وجهك منا القسم","https://www.aldiwan.net/poem60657.html","المتقارب"],[367,"سرى كما يسري القمر","https://www.aldiwan.net/poem60914.html","مجزوء الرجز"],[374,"كم نهتهم صبابتي وغرامي","https://www.aldiwan.net/poem57128.html","الخفيف"],[444,"لا يمنع الموت حجاب ولا زرد","https://www.aldiwan.net/poem14449.html","البسيط"],[446,"إن أيامنا التي قدم العهد","https://www.aldiwan.net/poem55937.html","عموديه"],[466,"دمعي بتلك الطول مطلول","https://www.aldiwan.net/poem3158.html","عموديه"],[472,"ألا لا تلمه اليوم أن يتبلدا","https://www.aldiwan.net/poem4657.html","الطويل"],[479,"أبرق تبدى أم وميض سنا ثغر","https://www.aldiwan.net/poem15206.html","الطويل"],[479,"دمع على عرصات الربيع مسكوب","https://www.aldiwan.net/poem15258.html","البسيط"]],"verses":[["كَأَنَّ ذا المَطلَعَ أَمسى الرَدى","رَصيدَهُ وَاِزوَرَّ عَنهُ الفَريق",0,"ق",1,0],["كَأَنَّ ذُرى مَعالِمِها قِلاصٌ","نَواءٍ كُشِّطَت عَنها الجُلودُ",1,"د",1,0],["كانَ ذا الطاقَةِ بِالثِقلِ إِذا","ضَنَّ مَولى المَرءِ عَنهُ وَصَفَح",2,"ح",1,0],["كَأَنَّ ذُرى رَأسِ المُجَيمِرِ غُدوَةً","مِنَ السَيلِ وَالغُثّاءِ فَلكَةُ مِغزَلِ",3,"ل",1,0],["كَأَنَّ ذُيولَ الجُلَّنارِ مُطِلَّةً","فُضولُ ذُيولِ الغانِياتِ مِنَ الأُزرِ",4,"ر",1,0],["كَأَنَّ ذَوي الحاجاتِ يَغشَونَ مُصعَباً","أَزَبَّ الجِرانِ ذا سَنامَينِ أَحرَدا",5,"د",2,0],["كَأَنَّ ذِراعَيها عَلى الخَلِّ بَعدَما","وَنينَ ذِراعا ماتِحٍ مُتَجَرِّدِ",6,"د",1,0],["كانَ ذاكَ الأَنينُ مِن حَجَرٍ في ال","سَدِّ يَشكو المَقادِرَ العَمياءَ",7,"ا",2,0],["كانَ ذاكَ البُعادُ أَروَحُ لِلقَل","بِ لِأَنَّ الغَرامَ بِالقُربِ زادا",8,"د",2,0],["كان ذاك العيش الذي لم يدم لي","حلماً مر طيفه خداعا",9,"ع",2,0],["كان ذاك الشباب مثل ربيع","منبت من انواره انواعا",9,"ع",2,0],["كانَ ذِئبٌ يَتَغَذّى","فَجَرَت في الزَورِ عَظمَه",10,"م",2,1],["كانَ ذَمّي لِلغانِياتِ وَشَكوا","يَ هَواهُنَّ نَفثَةَ المَصدورِ",11,"ر",1,0],["كَأَنَّ ذُكورَ الخَيلِ في غَمَراتِهِ","يَخُضنَ إِذا أُكرِهنَ فيهِ بِهِ الوَحلا",12,"ل",2,0],["كأنَّ ذُرَى الغُصونِ لَبِسنَ منه","حِلَى الكافورِ رَبَّاتُ الحِجالِ",13,"ل",1,0],["كأنَّ ذؤابَتَه إذ عَلَتْ","لواءٌ على جَمْرَةٍ خافقُ",14,"ق",1,0],["كَأَنَّ ذَوي الحاجاتِ حَولَ قِبابِهِ","جِمالٌ لَدى ماءٍ يَحُمنَ حَواني",15,"ن",2,0],["كَأَنَّ ذا العَينِ في تَطَرُّفِها","لَعباً وَلَهواً قَد عايَنَ الهَلَكا",16,"ك",2,0],["كَأَنَّ ذِكرَ رَسولِ اللَهِ مَرَّ بِها","فَأُكسِبَت أَرَجاً مِن نَشرِهِ العَبِقِ",17,"ق",1,0],["كأنّ ذكرَكَ والدنْيا به عَبَقَتْ","في البأس والجودِ مخلوعٌ عَنِ المثَلِ",18,"ل",1,0],["كانَ ذا كلّه زمانَ شبابٍ","كنتُ فيه على الدُّمَى بالخيارِ",19,"ر",1,0],["كان ذا والزمانُ سَمْحُ السجَايا","بِبَوادٍ منَ الأَماني وعُوّد",20,"د",1,0],["كأنّ ذُبابَهُ شادي صَبوحٍ","يحرّكُ إن ضربتُ به رقابا",21,"ب",2,0],["كانَ ذا في مَسيرِنا وَرَجَعنا","عَلِمَ اللَهُ مِنهُ ما قَد نَوَينا",22,"ن",2,0],["كانَ ذا نَخوة وَفيهِ حميه","أَينَ مِنها حَمية الجاهليه",23,"ي",2,0],["كانَ ذاكَ الأُفقُ مِنها","أَخصَبَ الآفاقِ أُفقا",24,"ق",2,0],["كَأَنَّ ذَوي التَنَعُّمِ في البَرايا","نَعامٌ راحَ يَلتَقِطُ الهَبيدا",25,"د",2,0],["كَأَنَّ ذَوي تَجارُبِنا سَوامٌ","تَأَنَّقُ في مُرادٍ وَاِبتِقالِ",26,"ل",1,0],["كَأَنَّ ذُراها مِنْ دَجُوجَ قَعائِدٌ","نَفَى الشَّرْقُ عَنْهَا المُغْضِنَاتِ السَّوارِيَا",27,"ي",2,0],["كَأَنَّ ذُنَابَاهُ ومَنْسِجَ مَتْنِهِ","مَدَاحِضُ وَقْعِ القَطْرِ عَنْ تَيْسِ حُلَّبِ",28,"ب",1,0],["كَانَ ذَاكَ الجَافِي العَبُوسُ المُحَيَّا","في المُعاطَاةِ أَسْمَحَ السُّمَحَاءِ",29,"ا",2,0],["كَان ذَاكَ الهَوَى سَلاَماً وَبَرْداً","فَاغْتدَى حِينَ شبَّ جَذْوَةَ نَارِ",30,"ر",1,0],["كَانَ ذَاكَ الفَقِيدُ مِنْ أَكْرَمِ","الخَلقِ بِأَخْلاقِهِ وَلَيْسُوا بِكُثْرِ",31,"ر",1,0],["كَأَنَّ ذِراعي جُذَّ مِن عَضدي بِهِ","كَأَنَّ حُسامي فُلُّ وَهوَ لِساني",32,"ن",2,0],["كَأَنَّ ذِراعاً عَلا كَفَّها","إِذا حَسَرَت ذَنَبُ المِلعَقَه",33,"ق",2,0],["كَأَنَّ ذِكْرَاهُ لَمَّا سَارَ سَائِرُهَا","عَبِيرُ دَانِيَة الظِّلَّيْنِ مِعْطَارِ",34,"ر",1,0],["كأن ذرى رأس المجيمر غدوة","ً من السَّيلِ وَالأغْثاء فَلكة ُ مِغزَلِ",35,"ل",1,0],["كأنَّ ذراعاً علا كفَّها","إذا حسرتْ ، ذنبُ المعلقهْ",36,"ق",2,0],["كان ذئبٌ يتغدى","فجرتْ في الزّوْر عَظمه",37,"م",2,1],["كانَ ذِكري مِن أَحمَد الذكر قَد ما","ت فَأَحييتهُ بِبَعض التفاتك",38,"ك",1,0],["كأن ذكريه آياتٌ أرتلها","كما يرتل إنجيلٌ وفرقان",39,"ن",1,0],["كأن ذاك الشرار من ذهب","قُراضةٌ تستطير من نُقَر",40,"ر",1,0],["كانَ ذاكَ الصديقُ فيما رأينا","سحباً فوقها سماً سوداءُ",41,"ا",2,1],["كأن ذباب السيف مغرىً بحبها","وتقبيلها فرض عليه مؤكد",42,"د",1,0],["كَأَنَّ ذُؤابَتَيهِ حِبالُ أَسرٍ","تُشَدُّ بِها قُلوبُ العُربِ أَسرى",43,"ر",2,0],["كانَ ذاكَ الدَمعُ ماءً منزِلاً","عَمَّدَ الحُبَّ بِدينِ العاشِقين",44,"ن",1,0],["كَأَنَّ ذَكِيَّ نَفحَتِها","خَلائِقُ سَيِّدِ الرُؤَسا",45,"س",2,0],["كأَنَّ ذُكا باعَت من المُشتَري اِبنها","فَلَم تَستَقِل بَيعاً ولا هو فاسِخُ",46,"خ",1,0],["كأنَّ ذكرَكِ سلكُ الكهرباءةِ إنْ","يلامسِ القلبَ وَهناً منه يرتعد",47,"د",1,0],["كَأَنَّ ذِراعَيها ذِراعا مُدِلَّةٍ","بُعَيدَ السِبابِ حاوَلَت أَن تَعَذَّرا",48,"ر",2,0],["كأن ذرى الأعلام في سيلانه","قراقير يمٍ قد عجزن عن القذف",49,"ف",1,0],["كأنَّ ذُراهُ بكفِّ الزَّما","ن طِرْسٌ وكلُّ مليكٍ قَلَم",50,"م",1,0],["كان ذُراكَ لي مَقَر","وكان للعَينِ أَقَر",51,"ر",1,0],["كانَ ذمُّ الشَّآمِ مُذ كنتُ شأني","فَنَهتني عنهُ دِمَشقُ الشَّامِ",52,"م",1,0],["كأن ذكرك بين العالمين شذى","روض أجاد عليها الوابل البرد",53,"د",1,0],["كان ذاك الشباب جنة حسن","كان ذاك الزمان عرس الغرام",54,"م",1,0],["كأنَّ ذاكَ الغديرَ سابغةٌ","والنَّهرُ سيفٌ بالريحَ مصقول",55,"ل",1,0],["كَأَنَّ ذَكِيَ المِسكِ مِنها وَقَد بَدَت","وَريح الخُزامَى عَرفُهُ ينفحُ النَّدا",56,"د",2,0],["كأنَّ ذراعيها وقد أمتِ الغَضا","جناحا عُقابِ الَّلوحِ تَهوي إلى الوَكْرِ",57,"ر",1,0],["كأنَّ ذكَركُمُ وقفٌ عليَّ فلي","دمعٌ بأشطانِ هذا البينِ مجلوبُ",58,"ب",1,0]]}