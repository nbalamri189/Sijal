{"poems":[[53,"أبا هرم أنحها إنني","https://www.aldiwan.net/poem29792.html","المتقارب"],[63,"جهد الصبابة أن أكون ملوما","https://www.aldiwan.net/poem46195.html","الكامل"],[86,"رثاك أمير الشعر في الشرق وانبرى","https://www.aldiwan.net/poem10489.html","الطويل"],[86,"وقف الخلق ينظرون جميعاً","https://www.aldiwan.net/poem10675.html","الخفيف"],[86,"قصرت عليك العمر وهو قصير","https://www.aldiwan.net/poem68948.html","الطويل"],[88,"زر السجن في بغداد زورة راحم","https://www.aldiwan.net/poem45020.html","الطويل"],[23,"لمن الدار أوحشت بمغان","https://www.aldiwan.net/poem21389.html","الخفيف"],[51,"ألا نسيا نفسي حديث البلابلِ","https://www.aldiwan.net/poem65958.html","الطويل"],[85,"عرابي كيف أوفيك الملاما","https://www.aldiwan.net/poem7581.html","الوافر"],[85,"ممالك الشرق أم أدارس أطلال","https://www.aldiwan.net/poem62835.html","البسيط"],[85,"يا نائح الطلح أشباه عوادينا","https://www.aldiwan.net/poem63691.html","البسيط"],[45,"أرى بين ملتف الأراك منازلا","https://www.aldiwan.net/poem65533.html","الطويل"],[66,"أطعت داعي الهوى رغما على العاصي","https://www.aldiwan.net/poem40648.html","البسيط"],[80,"أشارت وسحب الدمع دائمة السفح","https://www.aldiwan.net/poem31519.html","الطويل"],[44,"ما عهدنا كذا نحيب المشوق","https://www.aldiwan.net/poem30395.html","الخفيف"],[69,"أضحى ليوسف في الجمال","https://www.aldiwan.net/poem28955.html","مجزوء الكامل"],[52,"منزل أقوى بسلمى وربوع","https://www.aldiwan.net/poem26865.html","الرمل"],[75,"صدق الفناء وكذب العمر","https://www.aldiwan.net/poem69076.html","أحذ الكامل"],[50,"أقوى وعطل من فراطة الثمد","https://www.aldiwan.net/poem63936.html","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39639","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202529","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43812","البسيط"],[9,"أصَرَمْتَ حَبْلَكَ مِنْ لَمِي س","https://www.poetsgate.com/ViewPoem.aspx?id=20020",""],[2,"صَحا القَلبُ عن سلمى وأقصرَ باطِلُهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19479&r=&rc=5",""],[182,"قد سار جرجس نحو الله منصرفا","https://www.aldiwan.net/poem61129.html","البسيط"],[182,"رمس سقت جانبيه كل غادية","https://www.aldiwan.net/poem61146.html","البسيط"],[182,"بيت لجاورجيوس أنشا بنايته","https://www.aldiwan.net/poem66969.html","البسيط"],[186,"يا طالبا هجري بلا ذنب","https://www.aldiwan.net/poem44126.html","السريع"],[231,"ما ذا أثار بقلبي السائق الغرد","https://www.aldiwan.net/poem44592.html","البسيط"],[235,"نعمت زمانا مع المترفين","https://www.aldiwan.net/poem31598.html","المتقارب"],[270,"هلا وفيت كما وعدت حزينا","https://www.aldiwan.net/poem35582.html","الكامل"],[270,"رجعي يا مي ذياك الغناء","https://www.aldiwan.net/poem35611.html","الرمل"],[271,"ضربت سعاد خيامها بفؤادي","https://www.aldiwan.net/poem52108.html","الكامل"],[297,"يا صاح هذا المشهد الأقدس","https://www.aldiwan.net/poem33243.html","السريع"],[303,"يا غصن بان قد ثنته الصبا","https://www.aldiwan.net/poem57888.html","السريع"],[305,"أفق أيها المغرور بالعيش قد صفا","https://www.aldiwan.net/poem56465.html","الطويل"],[305,"ألا هذا الذي منه تحيد","https://www.aldiwan.net/poem56559.html","الوافر"],[403,"إطلاق أغلوطة عليه كما","https://www.aldiwan.net/poem33901.html","المنسرح"],[403,"صدقت فمدح الله أشرف ما يتلى","https://www.aldiwan.net/poem34173.html","الطويل"],[558,"قل لمن قال عن ذوي العرفان","https://www.aldiwan.net/poem33820.html","الخفيف"],[558,"العين واحدة والحكم مختلف","https://www.aldiwan.net/poem34344.html","البسيط"]],"verses":[["فَقِف حَيثُ أَنتَ فَما كُلُّ مَن","بَغى أَن يَطولَ وَيَسمو سَما",0,"م",2,0],["فَقِفا بَحيثُ مَحا مَساحِبَ ذَيْلِها","نَكْباءُ غادَرَتِ الدّيارَ رُسوما",1,"م",2,0],["فَقِف ثُمَّ سَلِّم وَاِحتَشِم إِنَّ شَيخَنا","مَهيبٌ عَلى رَغمِ الفَناءِ وَقورُ",2,"ر",1,0],["فَقِفوا فيهِ وَقفَةَ الحَزمِ وَاِرموا","جانِبَيهِ بِعَزمَةِ المُستَعِدِّ",3,"د",1,0],["فَقِف مَوقِفَ الفاروقِ وَاُنظُر لِأُمَّةٍ","إِلَيكَ بِحَبّاتِ القُلوبِ تُشيرُ",4,"ر",1,0],["فقف وسطها وانظر حوالَيْك دائراً","إلى حُجَر قامت على كل مُقْعَد",5,"د",1,0],["فَقَفا جاسِمٍ فَأَودِيَةِ الصُف","فَرِ مَغنى قَنابِلٍ وَهِجانِ",6,"ن",1,0],["فقِفْ خاسِئاً عنهم حسيراً فإنما","طلبتَ منيعاً من حَويل المحاولِ",7,"ل",1,0],["فقف بالتل واستمع العظاما","فإن لها كما لهمو كلاما",8,"م",2,0],["فَقِف عَلى أَهلِهِ وَاِطلُب جَواهِرَهُ","كَناقِدٍ مُمعِنٍ في كَفِّ لَآلِ",9,"ل",1,0],["فَقِف إِلى النيلِ وَاِهتُف في خَمائِلِهِ","وَاِنزِل كَما نَزَلَ الطَلُّ الرَياحينا",10,"ن",2,0],["فَقِف مُسعِداً فيهِنَّ إِن كُنتَ عاذِراً","وَسِر مُبعِداً عَنهُنَّ إِن كُنتَ عاذِلا",11,"ل",2,0],["فَقِف بِسَعدَيِّها المَشكورِ مَنشَأُهُ","سَعدِ بنِ مَزيدَ لا سَعدِ بنِ وَقّاصِ",12,"ص",1,0],["فقِفْ بحياةِ النّفسِ عن مصرع الرّدى","فمن لا يدانِ النّارَ يَنجُ منَ اللّفحِ",13,"ح",1,0],["فَقِفا العيسَ مُلقِياتِ المَثاني","في مَحَلِّ الأَنيقِ مَغنى الأَنيقِ",14,"ق",1,0],["فقفا معي حتى نرى","في خدِّهِ علمَ الخلافَهْ",15,"ه",1,0],["فَقَفَونا الغَيثَ لَم يُشرِف نَدىً","وَهَوادي الوَحشِ مَرّاتٍ وُقوعُ",16,"ع",1,0],["فقفوا تضرج ثم أنفسنا","لا الصّافناتُ الجُردُ والعَكَرُ",17,"ر",1,0],["فَقِف بِهِنَّ عَلى ما شِئتَ مِن أَثرٍ","مِمّا يُلَبَّدُ مِنها فَهوَ مُلتَبِدُ",18,"د",1,0],["فقفْ وتنظَّرْ حائراً نَصْبَ غارهِ","تحدَّاكَ فيه ورْقُهُ وعناكبُهْ",19,"ب",2,0],["فقف على آثار أعيان الزمنْ","واغش الطلول وتنقل في الدمنْ",20,"ن",1,0],["فَقِف قَليلاً عَلى العاصي أَبيكَ غَداً","وَاِشفَع لَهُ فَيَقولُ اللَهُ أل فيهِ",21,"ه",1,0],["فقُ فوقَ سيّدهمْ عقابهْ","فَأصَبْتُ مِنْ غَيْرِ الّذِي",22,"ي",1,0],["فقفٌّ، فصاراتٌ، فأكنافُ منعجٍ","فشَرْقيُّ سلمَى حَوْضُهُ فأجاوِلُهْ",23,"ل",2,0],["فَقف بِجانب قَبرٍ حَلَّ تربتَهُ","مُستَسقياً لِثَراهُ باردَ المَطرِ",24,"ر",1,0],["فَقفْ بِهِ خاشِعاً واُقرَ السَلامَ عَلى","قَومس إِلى رَحمةش الباري قَد اِنقَطَعوا",25,"ع",3,0],["فَقِفْ بِهِ خاشعَ الأَبصارِ مُبتَهِلاً","وَلُذ بِساكنِهِ في مَطلَعِ السَّحَرِ",26,"ر",1,0],["فقف على الهجر وكن عالما","أنّك من دون الورى حسبي",27,"ي",1,0],["فقف بتلك القباب البيض دام لها","من ذي الجلال السنا والقرب والمدد",28,"د",1,0],["فَقِف بِيَ مُعتَبِراً إِن مَرَرتَ","عَلى جَدَثي وَاِبكِ مُستَعبِرا",29,"ر",2,0],["فقِفي نُجدّد ما نسيتِ بحلفةٍ","وبدمعةٍ ذكراهما تَشفينا",30,"ن",2,0],["فقِفي نرثي ونبكي في الدُّجى","بعدَ أن كنّا نُغنّي في الضِّياء",31,"ا",2,0],["فَقف المطيّ وَلَو كلمحة ناظر","بربا المحصب أَو مني يا حادي",32,"ي",1,0],["فقف بها واِلثم ثرى تُربها","فَهي المقامُ الأَطهَرُ الأَقدَسُ",33,"س",1,0],["فقف لأغصان النقا إنها","تقبل الأرض وتنهى لديك",34,"ك",1,0],["فَقِف أيّها المجتازُ حولَ ضريحه","وَحسبكَ ذا التأثيرُ فيه مواقفا",35,"ف",2,0],["فَقِف واِنظر بهِ نظرَ اِعتِبار","فَلَيس عليهِ مِن عبر مزيدُ",36,"د",1,0],["فقف ولا تقف غير منهجه","ينجيك يوم الحساب من سقر",37,"ر",1,0],["فقف قارعاً باب الرجا بأنامل الد","عاء فربي سامع للذي يدعا",38,"ا",1,0],["فقفوا عند حدكم لا تغطّوا","خبثَكم بالفجور والبهتان",39,"ن",1,0],["فقف علينا وسلم بالأمور لنا","فإن عارفنا بالغيب معترف",40,"ف",1,0]]}