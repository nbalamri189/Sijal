{"poems":[[53,"أبا هرم أنحها إنني","https://www.aldiwan.net/poem29792.html","المتقارب"],[63,"جهد الصبابة أن أكون ملوما","https://www.aldiwan.net/poem46195.html","الكامل"],[86,"رثاك أمير الشعر في الشرق وانبرى","https://www.aldiwan.net/poem10489.html","الطويل"],[86,"وقف الخلق ينظرون جميعاً","https://www.aldiwan.net/poem10675.html","الخفيف"],[86,"قصرت عليك العمر وهو قصير","https://www.aldiwan.net/poem68948.html","الطويل"],[88,"زر السجن في بغداد زورة راحم","https://www.aldiwan.net/poem45020.html","الطويل"],[23,"لمن الدار أوحشت بمغان","https://www.aldiwan.net/poem21389.html","الخفيف"],[51,"ألا نسيا نفسي حديث البلابلِ","https://www.aldiwan.net/poem65958.html","الطويل"],[85,"عرابي كيف أوفيك الملاما","https://www.aldiwan.net/poem7581.html","الوافر"],[85,"ممالك الشرق أم أدارس أطلال","https://www.aldiwan.net/poem62835.html","البسيط"],[85,"يا نائح الطلح أشباه عوادينا","https://www.aldiwan.net/poem63691.html","البسيط"],[45,"أرى بين ملتف الأراك منازلا","https://www.aldiwan.net/poem65533.html","الطويل"],[66,"أطعت داعي الهوى رغما على العاصي","https://www.aldiwan.net/poem40648.html","البسيط"],[80,"أشارت وسحب الدمع دائمة السفح","https://www.aldiwan.net/poem31519.html","الطويل"],[44,"ما عهدنا كذا نحيب المشوق","https://www.aldiwan.net/poem30395.html","الخفيف"],[69,"أضحى ليوسف في الجمال","https://www.aldiwan.net/poem28955.html","مجزوء الكامل"],[52,"منزل أقوى بسلمى وربوع","https://www.aldiwan.net/poem26865.html","الرمل"],[75,"صدق الفناء وكذب العمر","https://www.aldiwan.net/poem69076.html","أحذ الكامل"],[50,"أقوى وعطل من فراطة الثمد","https://www.aldiwan.net/poem63936.html","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39639","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202529","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43812","البسيط"],[9,"أصَرَمْتَ حَبْلَكَ مِنْ لَمِي س","https://www.poetsgate.com/ViewPoem.aspx?id=20020",""],[2,"صَحا القَلبُ عن سلمى وأقصرَ باطِلُهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19479&r=&rc=5",""]],"verses":[["فَقِف حَيثُ أَنتَ فَما كُلُّ مَن","بَغى أَن يَطولَ وَيَسمو سَما",0,"م",2,0],["فَقِفا بَحيثُ مَحا مَساحِبَ ذَيْلِها","نَكْباءُ غادَرَتِ الدّيارَ رُسوما",1,"م",2,0],["فَقِف ثُمَّ سَلِّم وَاِحتَشِم إِنَّ شَيخَنا","مَهيبٌ عَلى رَغمِ الفَناءِ وَقورُ",2,"ر",1,0],["فَقِفوا فيهِ وَقفَةَ الحَزمِ وَاِرموا","جانِبَيهِ بِعَزمَةِ المُستَعِدِّ",3,"د",1,0],["فَقِف مَوقِفَ الفاروقِ وَاُنظُر لِأُمَّةٍ","إِلَيكَ بِحَبّاتِ القُلوبِ تُشيرُ",4,"ر",1,0],["فقف وسطها وانظر حوالَيْك دائراً","إلى حُجَر قامت على كل مُقْعَد",5,"د",1,0],["فَقَفا جاسِمٍ فَأَودِيَةِ الصُف","فَرِ مَغنى قَنابِلٍ وَهِجانِ",6,"ن",1,0],["فقِفْ خاسِئاً عنهم حسيراً فإنما","طلبتَ منيعاً من حَويل المحاولِ",7,"ل",1,0],["فقف بالتل واستمع العظاما","فإن لها كما لهمو كلاما",8,"م",2,0],["فَقِف عَلى أَهلِهِ وَاِطلُب جَواهِرَهُ","كَناقِدٍ مُمعِنٍ في كَفِّ لَآلِ",9,"ل",1,0],["فَقِف إِلى النيلِ وَاِهتُف في خَمائِلِهِ","وَاِنزِل كَما نَزَلَ الطَلُّ الرَياحينا",10,"ن",2,0],["فَقِف مُسعِداً فيهِنَّ إِن كُنتَ عاذِراً","وَسِر مُبعِداً عَنهُنَّ إِن كُنتَ عاذِلا",11,"ل",2,0],["فَقِف بِسَعدَيِّها المَشكورِ مَنشَأُهُ","سَعدِ بنِ مَزيدَ لا سَعدِ بنِ وَقّاصِ",12,"ص",1,0],["فقِفْ بحياةِ النّفسِ عن مصرع الرّدى","فمن لا يدانِ النّارَ يَنجُ منَ اللّفحِ",13,"ح",1,0],["فَقِفا العيسَ مُلقِياتِ المَثاني","في مَحَلِّ الأَنيقِ مَغنى الأَنيقِ",14,"ق",1,0],["فقفا معي حتى نرى","في خدِّهِ علمَ الخلافَهْ",15,"ه",1,0],["فَقَفَونا الغَيثَ لَم يُشرِف نَدىً","وَهَوادي الوَحشِ مَرّاتٍ وُقوعُ",16,"ع",1,0],["فقفوا تضرج ثم أنفسنا","لا الصّافناتُ الجُردُ والعَكَرُ",17,"ر",1,0],["فَقِف بِهِنَّ عَلى ما شِئتَ مِن أَثرٍ","مِمّا يُلَبَّدُ مِنها فَهوَ مُلتَبِدُ",18,"د",1,0],["فقفْ وتنظَّرْ حائراً نَصْبَ غارهِ","تحدَّاكَ فيه ورْقُهُ وعناكبُهْ",19,"ب",2,0],["فقف على آثار أعيان الزمنْ","واغش الطلول وتنقل في الدمنْ",20,"ن",1,0],["فَقِف قَليلاً عَلى العاصي أَبيكَ غَداً","وَاِشفَع لَهُ فَيَقولُ اللَهُ أل فيهِ",21,"ه",1,0],["فقُ فوقَ سيّدهمْ عقابهْ","فَأصَبْتُ مِنْ غَيْرِ الّذِي",22,"ي",1,0],["فقفٌّ، فصاراتٌ، فأكنافُ منعجٍ","فشَرْقيُّ سلمَى حَوْضُهُ فأجاوِلُهْ",23,"ل",2,0]]}