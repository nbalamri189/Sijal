{"poems":[[53,"لو صح أن البين يعشقه","https://www.aldiwan.net/poem29955.html","السريع"],[92,"يا أيها الطفل الذي قد","https://www.aldiwan.net/poem38926.html","مجزوء الكامل"],[85,"ليلة الأمس قد ذهبت","https://www.aldiwan.net/poem6833.html","الخفيف"],[85,"قُل لِاِبنِ سينا لا طَبيب","https://www.aldiwan.net/poem7916.html","مجزوء الرجز"],[85,"بيني وبين أبي العلاء قضية","https://www.aldiwan.net/poem7921.html","الكامل"],[45,"كل أخلاق علي","https://www.aldiwan.net/poem66643.html","مجزوء الرمل"],[97,"موقفٌ حانَ فاغتنم","https://www.aldiwan.net/poem24754.html","مجزوء الخفيف"],[69,"ما قيم الحمام إلا فتنة","https://www.aldiwan.net/poem28283.html","الكامل"],[105,"مرأى من الملأ العلي ومظهر","https://www.aldiwan.net/poem41935.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39650","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39539","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55080","الكامل"],[90,"عدِّ عنك الكؤوس","https://www.poetsgate.com/ViewPoem.aspx?id=179009",""],[45,"كُلُّ أَخْلاَقِ عَلِيٍّ","https://www.poetsgate.com/ViewPoem.aspx?id=31997",""],[113,"طعن الحسود بنا لخفة عقله","https://www.aldiwan.net/poem41695.html","الكامل"],[140,"قد بان عذرك والخليط مودع","https://www.aldiwan.net/poem58436.html","الكامل"],[187,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[195,"حي الأساتذة الكرام تحية","https://www.aldiwan.net/poem39949.html","الكامل"],[204,"دهش الفؤاد فكان أن يتفطّرا","https://www.aldiwan.net/poem918.html",""],[208,"أقضيب بان أم قوام أملد","https://www.aldiwan.net/poem13456.html","الطويل"],[208,"وافى السرور وصحت الأحلام","https://www.aldiwan.net/poem13476.html","الكامل"],[221,"إيه برناس هيكل الشعراء","https://www.aldiwan.net/poem41899.html","الخفيف"],[223,"سفرت فلاح لنا هلال سعود","https://www.aldiwan.net/poem55248.html","الكامل"],[257,"كل شهم لذاته المدح صالح","https://www.aldiwan.net/poem35564.html","الخفيف"],[326,"قبل أن يبصر الظلام الضياء","https://www.aldiwan.net/poem54981.html","الخفيف"],[326,"هو ناي حرم الشدو","https://www.aldiwan.net/poem55025.html","مجزوء الرمل"],[351,"يا طالبا نيل السعادة والمنى","https://www.aldiwan.net/poem39749.html","الكامل"],[359,"ان وجدي كل يوم في ازدياد","https://www.aldiwan.net/poem68123.html","الرمل"],[359,"يا نديمي قسم بي الى الصهباء","https://www.aldiwan.net/poem68143.html","الخفيف"],[362,"طلعت نجوم الدين فوق الفرقد","https://www.aldiwan.net/poem60958.html","الكامل"],[364,"اشترى الله من أناس فباعوا","https://www.aldiwan.net/poem17232.html","الخفيف"],[400,"لا فض من رب القوافي فوه","https://www.aldiwan.net/poem33367.html","الكامل"],[400,"قسما لقد أثقلتني تبجيلا","https://www.aldiwan.net/poem33491.html","الكامل"],[413,"نزلوا بحيث السفح من نعمان","https://www.aldiwan.net/poem54001.html","الكامل"],[429,"إنها أعرضت عن الإعراض","https://www.aldiwan.net/poem12485.html","مجزوء الخفيف"],[451,"وحدتي فيلسوفة تمسح الدمع","https://www.aldiwan.net/poem61234.html","الخفيف"],[536,"يا رعى الله إخوة كرموني","https://www.aldiwan.net/poem47601.html","عموديه"],[549,"أنكرت ليلة اعتنقنا حسامي","https://www.aldiwan.net/poem48020.html","الخفيف"],[556,"تب إلى الله من علوم الكلام","https://www.aldiwan.net/poem33868.html","الخفيف"],[556,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[560,"من قال إن الدهر ليس يعود","https://www.aldiwan.net/poem52806.html","الكامل"],[573,"لا تسل عنه كيف أصبح حاله","https://www.aldiwan.net/poem3028.html","الخفيف"],[573,"زارني طيفها محلى معطر","https://www.aldiwan.net/poem3065.html","الخفيف"],[573,"عادني من هوى الأحبة عيد","https://www.aldiwan.net/poem3078.html","الخفيف"]],"verses":[["هُوَ قادِرٌ لَكِنَّ صَولَتَهُ","في البَطشِ يَصرَعُها تَرَفُّقُهُ",0,"ق",2,0],["هوَ قلبُ أُمِّكَ","أُمِّكَ السَّكْرَى بأَحزانِ الوُجُودْ",1,"د",1,0],["هو قد بدَّ قائل الشعر ميتا","كيف يلقاه قائل الشعر حيا",2,"ي",2,0],["هُوَ قَبلَ بقراطٍ وَقَب","لَكَ لِلجِراحَةِ مَرهَمُ",3,"م",1,0],["هُوَ قَد رَأى نُعمى أَبيهِ جِنايَةً","وَأَرى الجِنايَةَ مِن أَبي نَعماءَ",4,"ا",2,0],["هُوَ قِردٌ حِنَ يَبدو","غَيرَ أَنّا لانَكُمُّه",5,"م",2,0],["هو قيثارةُ الزما","نِ ونجواه مِن قِدَم",6,"م",1,0],["هو قيِّمٌ يسطو بطرفٍ شاطرٍ","والردفُ منهُ راجحُ الرجَّاحِ",7,"ح",1,0],["هو قُوَّةُ الإسلامِ ما من قوّةٍ","تُرْمَى بها إلا تُرَدُّ وتُقْهَرُ",8,"ر",1,0],["هو قيثارتي عليها أُغنِّي","وعليها وحدِي أُغنِّي لنفسي",9,"ي",1,0],["هو قلبي في الهوى ذوَّبته","لكَ في رفَّافِ لحنٍ وشعاعِ",10,"ع",1,0],["هُوَ قَائِدٌ لاَ جُبْنَ فِي أَجْنَادِهِ","هُوَ وَالِدٌ مَا فِي بَنِيهِ عُقُوقُ",11,"ق",1,0],["هو قاسٍ ان اغضَبُوه ولكن","لو يَهُزّ الصَفَا نَداهُ لحَسّا",12,"س",2,0],["هُوَ قِرْدٌ حِينَ يَبْدُو","غَيْرَ أَنَّا لاَ نَكُمُّهْ",13,"م",2,0],["هو قائم بالزور في طلب العلا","والزور مرصاد عليه لخذله",14,"ل",2,0],["هو قِبلةُ المجد التي ما مِلَّةٌ","إلا وتسجُدُ نحوها أو تركَعُ",15,"ع",1,0],["هوَ قلبُ الأرضين والحجرُ الأس","وَدُ لِلقلبِ حبّةٌ سوداءُ",16,"ا",2,0],["هوَ قلبُها الخفّاقُ والركنُ القوي","مُ وَسورُها الحامي من العدوان",17,"ن",1,0],["هو قطبنا الحاوي لكلّ فضيلة","لا غرو كلّ الصيد في جوف الفرا",18,"ر",2,0],["هو قاتلي وانا القتيل بحبه","ودمي على وجناته لي يشهد",19,"د",1,0],["هو قبلة العليا وجامع فضلها","وتر الزمان وفي العلوم امام",20,"م",1,0],["هوَ قيثارَهُ الشعور تُناجي","بِنَشيد الأَوتارِ سرَّ الضِياءِ",21,"ا",2,0],["هو قُطبُ دائِرة المعالي وَالذي","قد زانَ عَقدَ الرَأي بِالتَسديد",22,"د",1,0],["هو قلبٌ لجسم كلّ كريم","وسواه من الكرام جوارح",23,"ح",1,0],["هو قلب الحياة يشدو إذا غنّت","ويبكى إذا شجاها البكاءُ",24,"ا",2,0],["هو قلبٌ منِعَ الحب","فجنّت خفقاتُه",25,"ه",1,0],["هُوَ قُطب دائرة الوُجود وَجدّه","خَير الخَلائق أَشرَف الثقلينِ",26,"ن",1,0],["هُوَ قَصدي لَستُ أَسلوه وَاِن","صِرت فيهِ مِثله تَبين العِباد",27,"د",1,0],["هُوَ قَصدي فَلا تَلُمني فَاِنّي","لا أُبالي مِن لائِم غَوّاء",28,"ا",2,0],["هو قد بنى وهُما معاً قد شَيّدا","وتَمامُ كلِّ مُؤسسٍ بِمُشَيّد",29,"د",1,0],["هُوَ قَوّاهُمُ عَلى ما رَآهُمُ","أَهلَهُ مِن جِهادِهِ فَاِستَطاعوا",30,"ع",3,0],["هو قاعد في ينبع متبتل","كلف بقول إلهه يتلوه",31,"و",2,0],["هو قطب تلك الاعتراضات التي","كانت على السندى أثقل قيلا",32,"ل",2,0],["هو قطب دائرة يدور مدارها","أبد الزمان ومنتهى الدَوَران",33,"ن",1,0],["هو قاضٍ على لُهاهُ بجورٍ","وهو بالعدْلِ في البريّةِ قاضِ",34,"ض",1,0],["هو قلبي الذي يرفرف كالطثير","على الحب آسيا أو رحيما",35,"م",2,0],["هوَ قَلبِي ومَا لَدىَّ سَواهُ","فَخُذُوه إن شئتمُ واعذِرُوني",36,"ي",1,0],["هو قِرْنٌ صفوٌ ولا بُدّ في كل","لِ صفاءٍ ننالُهُ من قذاةِ",37,"ا",2,0],["هو قرآننا المبين فآمن","بالذي جاء فيه باستسلام",38,"م",1,0],["هو قلبي عن الهوى ليس ينفكّْ","فاقطع اللوم صاح من حيثما رَكّْ",39,"ك",1,0],["هُوَ قَيْصرُ العَصْرِ الذي من دونِهِ","كِسرَى الذي ضاقتْ عليهِ البيدُ",40,"د",1,0],["هُو قَاضٍ لا بل أَميرٌ وقد أَضحَت","ملوك البلاد وهْي رِجَاله",41,"ل",2,0],["هو قَاضٍ وما سَمِعْنا بقاضٍ","حَوْلَه مِنْ نَداهُ جُنْدٌ وعَسْكَر",42,"ر",1,0],["هُو قَاضٍ لاَ بَلْ أَمِيرٌ بأَنْ","أَضْحَتْ لَدَيهِ مِن الْمَعَالِي جُنُودُ",43,"د",1,0]]}