"],[4683,"قلبي لودادك حين هوى","https://www.poetsgate.com/ViewPoem.aspx?id=166760",""],[4578,"قد رعت يا ريب المنون فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=49406",""],[4978,"رفح والأمة المشبورة","https://www.poetsgate.com/ViewPoem.aspx?id=177177",""],[5046,"جاد الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=197944",""],[5061,"نهر دجله","https://www.poetsgate.com/ViewPoem.aspx?id=147167",""],[3271,"أنت دير الهوى ، وشعري صلاة","https://www.poetsgate.com/ViewPoem.aspx?id=102362",""],[5183,"الطبيعة","https://www.poetsgate.com/ViewPoem.aspx?id=180193",""],[5285,"قد كان ملْلكا","https://www.poetsgate.com/ViewPoem.aspx?id=203653",""],[5363,"لمن جرّح في السيد قطب","https://www.poetsgate.com/ViewPoem.aspx?id=144286",""],[5368,"يا صرخة المخنوق","https://www.poetsgate.com/ViewPoem.aspx?id=186650",""],[5397,"أطربتني نغمات لحن المنشد","https://www.poetsgate.com/ViewPoem.aspx?id=157934",""],[5409,"أنت والحق في العلو سواءُ","https://www.poetsgate.com/ViewPoem.aspx?id=155491",""],[5413,"الحب","https://www.poetsgate.com/ViewPoem.aspx?id=208710",""],[5542,"قلعة العلم","https://www.poetsgate.com/ViewPoem.aspx?id=10191",""],[5542,"يا قدس","https://www.poetsgate.com/ViewPoem.aspx?id=10200",""],[5652,"هو قدوتي فارق على كل مقدمْ ! !","https://www.poetsgate.com/ViewPoem.aspx?id=147305",""],[5861,"هو قالها","https://www.poetsgate.com/ViewPoem.aspx?id=191302",""],[5939,"بلاغٌ عن حالة عشق","https://www.poetsgate.com/ViewPoem.aspx?id=180016",""],[1920,"الأرجوحة المشنقة","https://www.poetsgate.com/ViewPoem.aspx?id=197103",""],[6070,"الشَّمسُ تَغربُ والضِّياءُ ينادي","https://www.poetsgate.com/ViewPoem.aspx?id=189948",""],[4442,"بشرى العراق بعيد فطره","https://www.poetsgate.com/ViewPoem.aspx?id=171006",""],[6106,"سقوط العاهر : امريكا","https://www.poetsgate.com/ViewPoem.aspx?id=6848",""],[6167,"الربان الجسور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85570&r=&rc=53",""],[5190,"عودة بلفور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78348&r=&rc=61",""]],"verses":[["هُوَ قادِرٌ لَكِنَّ صَولَتَهُ","في البَطشِ يَصرَعُها تَرَفُّقُهُ",0,"ق",2,0],["هوَ قلبُ أُمِّكَ","أُمِّكَ السَّكْرَى بأَحزانِ الوُجُودْ",1,"د",1,0],["هو قد بدَّ قائل الشعر ميتا","كيف يلقاه قائل الشعر حيا",2,"ي",2,0],["هُوَ قَبلَ بقراطٍ وَقَب","لَكَ لِلجِراحَةِ مَرهَمُ",3,"م",1,0],["هُوَ قَد رَأى نُعمى أَبيهِ جِنايَةً","وَأَرى الجِنايَةَ مِن أَبي نَعماءَ",4,"ا",2,0],["هُوَ قِردٌ حِنَ يَبدو","غَيرَ أَنّا لانَكُمُّه",5,"م",2,0],["هو قيثارةُ الزما","نِ ونجواه مِن قِدَم",6,"م",1,0],["هو قيِّمٌ يسطو بطرفٍ شاطرٍ","والردفُ منهُ راجحُ الرجَّاحِ",7,"ح",1,0],["هو قُوَّةُ الإسلامِ ما من قوّةٍ","تُرْمَى بها إلا تُرَدُّ وتُقْهَرُ",8,"ر",1,0],["هو قيثارتي عليها أُغنِّي","وعليها وحدِي أُغنِّي لنفسي",9,"س",2,0],["هو قلبي في الهوى ذوَّبته","لكَ في رفَّافِ لحنٍ وشعاعِ",10,"ع",1,0],["هُوَ قَائِدٌ لاَ جُبْنَ فِي أَجْنَادِهِ","هُوَ وَالِدٌ مَا فِي بَنِيهِ عُقُوقُ",11,"ق",1,0],["هو قاسٍ ان اغضَبُوه ولكن","لو يَهُزّ الصَفَا نَداهُ لحَسّا",12,"س",2,0],["هُوَ قِرْدٌ حِينَ يَبْدُو","غَيْرَ أَنَّا لاَ نَكُمُّهْ",13,"م",2,0],["هو قائم بالزور في طلب العلا","والزور مرصاد عليه لخذله",14,"ل",2,0],["هو قِبلةُ المجد التي ما مِلَّةٌ","إلا وتسجُدُ نحوها أو تركَعُ",15,"ع",1,0],["هوَ قلبُ الأرضين والحجرُ الأس","وَدُ لِلقلبِ حبّةٌ سوداءُ",16,"ا",2,0],["هوَ قلبُها الخفّاقُ والركنُ القوي","مُ وَسورُها الحامي من العدوان",17,"ن",1,0],["هو قطبنا الحاوي لكلّ فضيلة","لا غرو كلّ الصيد في جوف الفرا",18,"ر",2,0],["هو قاتلي وانا القتيل بحبه","ودمي على وجناته لي يشهد",19,"د",1,0],["هو قبلة العليا وجامع فضلها","وتر الزمان وفي العلوم امام",20,"م",1,0],["هوَ قيثارَهُ الشعور تُناجي","بِنَشيد الأَوتارِ سرَّ الضِياءِ",21,"ا",2,0],["هو قُطبُ دائِرة المعالي وَالذي","قد زانَ عَقدَ الرَأي بِالتَسديد",22,"د",1,0],["هو قلبٌ لجسم كلّ كريم","وسواه من الكرام جوارح",23,"ح",1,0],["هو قلب الحياة يشدو إذا غنّت","ويبكى إذا شجاها البكاءُ",24,"ا",2,0],["هو قلبٌ منِعَ الحب","فجنّت خفقاتُه",25,"ه",1,0],["هُوَ قُطب دائرة الوُجود وَجدّه","خَير الخَلائق أَشرَف الثقلينِ",26,"ن",1,0],["هُوَ قَصدي لَستُ أَسلوه وَاِن","صِرت فيهِ مِثله تَبين العِباد",27,"د",1,0],["هُوَ قَصدي فَلا تَلُمني فَاِنّي","لا أُبالي مِن لائِم غَوّاء",28,"ا",2,0],["هو قد بنى وهُما معاً قد شَيّدا","وتَمامُ كلِّ مُؤسسٍ بِمُشَيّد",29,"د",1,0],["هُوَ قَوّاهُمُ عَلى ما رَآهُمُ","أَهلَهُ مِن جِهادِهِ فَاِستَطاعوا",30,"ع",3,0],["هو قاعد في ينبع متبتل","كلف بقول إلهه يتلوه",31,"و",2,0],["هو قطب تلك الاعتراضات التي","كانت على السندى أثقل قيلا",32,"ل",2,0],["هو قطب دائرة يدور مدارها","أبد الزمان ومنتهى الدَوَران",33,"ن",1,0],["هو قاضٍ على لُهاهُ بجورٍ","وهو بالعدْلِ في البريّةِ قاضِ",34,"ض",1,0],["هو قلبي الذي يرفرف كالطثير","على الحب آسيا أو رحيما",35,"م",2,0],["هوَ قَلبِي ومَا لَدىَّ سَواهُ","فَخُذُوه إن شئتمُ واعذِرُوني",36,"ن",2,0],["هو قِرْنٌ صفوٌ ولا بُدّ في كل","لِ صفاءٍ ننالُهُ من قذاةِ",37,"ا",2,0],["هو قرآننا المبين فآمن","بالذي جاء فيه باستسلام",38,"م",1,0],["هو قلبي عن الهوى ليس ينفكّْ","فاقطع اللوم صاح من حيثما رَكّْ",39,"ك",1,0],["هُوَ قَيْصرُ العَصْرِ الذي من دونِهِ","كِسرَى الذي ضاقتْ عليهِ البيدُ",40,"د",1,0],["هُو قَاضٍ لا بل أَميرٌ وقد أَضحَت","ملوك البلاد وهْي رِجَاله",41,"ل",2,0],["هو قَاضٍ وما سَمِعْنا بقاضٍ","حَوْلَه مِنْ نَداهُ جُنْدٌ وعَسْكَر",42,"ر",1,0],["هُو قَاضٍ لاَ بَلْ أَمِيرٌ بأَنْ","أَضْحَتْ لَدَيهِ مِن الْمَعَالِي جُنُودُ",43,"د",1,0],["هو قدوة الشبان في مصرٍ وفي","شرق به ذو العقل منهم يقتدي",44,"د",2,0],["هو قدوة للمحسنين فذكره","تتلوه أفواه كما تتلو السور",45,"ر",1,0],["هو قال أفضلكم عليٌّ إِنه","أَمضى فسنَّته التي يمضيها",46,"ي",3,0],["هو قاسم المعروف ما بين الورى","بفضائل وفواضل ومكارم",47,"م",1,0],["هو قُدّامي مَنْجُو","ق وَخَلْفي مَنْجَنيقُ",48,"ق",1,0],["هو قد أصاب حشاي سيف لحاظه","حتى أضر بقلبي المقروح",49,"ح",1,0],["هو قاسمٌ بالعدل فالعمر والبقا","له والهنا لي والدعا فيه للملا",50,"ل",2,0],["هو قدوة الرسل الكرام","وعن علاه الكل قاصر",51,"ر",1,0],["هو قوى لدي جانب ظني","فيك حتى توفرت رغباتي",52,"ت",2,0],["هو قدوة للمقتدين وكعبة","للقاصدين ومفخر للوادي",53,"د",2,0],["هو قائمٌ بالحقِّ كم من دعوةٍ","هزَّتهُ لولا ربُّه لأجابها",54,"ب",3,0],["هو قطب دائرة السياسة لم تدر","بسواه أحكامٌ بها وأمور",55,"ر",1,0