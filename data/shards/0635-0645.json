w.aldiwan.net/poem56126.html","مجزوء الرجز"],[456,"هل تقبلون إنابة الدهر","https://www.aldiwan.net/poem56194.html","أحذ الكامل"],[456,"لا تلمس الشمس يد","https://www.aldiwan.net/poem56236.html","مجزوء الرجز"],[459,"اذا لم أجد مصغيا للحدي","https://www.aldiwan.net/poem15334.html","المتقارب"],[459,"يا فارس الهولين عم رداهما","https://www.aldiwan.net/poem15443.html","الكامل"],[459,"شموس المواضي ان بغيت الأمانيا","https://www.aldiwan.net/poem15466.html","الطويل"],[462,"شاق الحمام برامتين فغردا","https://www.aldiwan.net/poem3584.html","عموديه"],[480,"ثوى الحب واستعلى وما قد رثى ليا","https://www.aldiwan.net/poem24500.html","عموديه"],[512,"عج بالعقيق وناد أسد سراته","https://www.aldiwan.net/poem20807.html","الكامل"],[549,"قد مضى شهر الصيام","https://www.aldiwan.net/poem47208.html","مجزوء الرمل"],[549,"صمت العواذل في أساك وسلموا","https://www.aldiwan.net/poem47242.html","الكامل"],[549,"أرقت للبرق بالعلياء يضطرم","https://www.aldiwan.net/poem47247.html","البسيط"],[549,"أيا حادي الأظعان لم لا تعرس","https://www.aldiwan.net/poem47754.html","الطويل"],[549,"ولما أردت طروق الفتاة","https://www.aldiwan.net/poem47811.html","المتقارب"],[549,"لقل غناء العتب والمجرم الدهر","https://www.aldiwan.net/poem47826.html","الطويل"],[551,"طرق الخيال فهاج لي بلبالا","https://www.aldiwan.net/poem68406.html","الكامل"],[551,"طيف الخيال حمدنا منك إلماما","https://www.aldiwan.net/poem68427.html","البسيط"],[584,"قف بالركائب أو سقها بترتيب","https://www.aldiwan.net/poem17440.html","البسيط"]],"verses":[["صُموتٌ لا يُجابُ لَهُنَّ داعٍ","أَرَنَّ وَلا يُرَدُّ لَهُ سَلامُ",0,"م",1,0],["صَمّاءُ تُخرِسُ آلَها","إِلّا قِراعاً أَو صَهيلا",1,"ل",2,0],["صَموتٌ بَينَ أَطرافِ العَوالي","وَفي طَعنِ القُلوبِ لَهُ خُوارُ",2,"ر",1,0],["صَمَحمَحٌ مُجَرَّبٌ عَيّاطُ","وَوائِلٌ كَأَنَّهُ مُخاطُ",3,"ط",1,0],["صَموتِ السُرى خَرساءَ فيها تَلَفُّتٌ","لِنَبأَةِ حَقٍّ أَو لِتَشبيهِ باطِلِ",4,"ل",1,0],["صَموتٌ وَقَوّالٌ فَلِلحِلمِ صَمتُهُ","وَبِالعِلمِ يَجلو الشَكَّ مَنطِقُهُ الفَصلُ",5,"ل",1,1],["صَمصامُ بادِرَةٍ وَطَودُ سَكينَةٍ","وَجَوادُ غاياتٍ وَجِذلُ حِكاكِ",6,"ك",1,0],["صُمَّ صَداها وَعَفا رَسمُه","وَاِستَعجَمَت عَن مَنطِقِ السائِلِ",7,"ل",1,0],["صَموتٌ إِذا التَصديرُ في صُعدائِهِ","تَصَعَّدَ إِلّا أَنَّهُ لا يَتَبَغَّمُ",8,"م",1,0],["صَمتُ الخَلاخيلِ خَودٌ لَيسَ يُعجِبُها","نَسجُ الأَحاديثِ بَينَ الحَيِّ وَالصَخَبُ",9,"ب",1,0],["صموتٌ بلا عيٍّ له من بلائه","نَوَاطِقُ تَسْتدْعِي الرَّجَاءَ وتَزْأدُ",10,"د",1,0],["صَمْتٌ وعيبٌ فلا خطابٌ","ولا كتابٌ ولا رسولُ",11,"ل",1,0],["صمَدَتْ في الزِّنا تُناسلُ حَوَّا","ء فحوَّاءُ عِندها كالعقيمِ",12,"م",1,0],["صُمْتُ عن كُل لذّةٍ لمشيبي","أفلا كان للإله صيامي",13,"م",2,0],["صُمْتُ عمَّنْ سواكَ من سائر النَّا","س ففطْري بذاكَ عند صيامي",14,"م",2,0],["صمتَ فيه وقمتَ بعدَ صيامٍ","وقيامٍ من قَبْلهِ غيرَ دون",15,"ن",1,0],["صَمتُ الكَنارِ وَإِن قَسا","خَيرٌ مِنَ النَغَمِ المُعار",16,"ر",1,0],["صمغة الشمس هذه","جسد الصمغة القمر",17,"ر",1,0],["صمَّاءُ ما في عودِها خَوَرٌ","عيطاءُ ما في عِطْفِها مَيَلُ",18,"ل",1,0],["صَمصامَةُ الرَأيِ صَمصامُ الجَنانِ ثَنى","تِلكَ الصُفوفَ بِماضي الحَدِّ صَمصامِ",19,"م",1,0],["صَمُوتٌ إذا زُرَّ جِلبابُهُ","أريبٌ فإنْ حَلَّهُ أمتَعا",20,"ع",2,0],["صُمَّ في صَومِكَ العُداةُ وَفي فِط","رِكَ مِنهُم تُفَطَّرُ الأَكبادُ",21,"د",1,0],["صُمَّت بِصَومِكَ أَسماعُ العُداةِ وَكَم","قَلبٍ لَهُم مِنكَ بِالإِفطارِ مَفطورِ",22,"ر",1,0],["صَمَتَ السّهلُ ولكن أقبَلَت","من ثَنَايا السهلِ أصداءٌ بعيده",23,"ه",1,0],["صُمْتَ للَّه صَوْمَ خِرْقٍ هُمامِ","مُفْطِرِ الكفّ بالعطايا الجسامِ",24,"م",1,1],["صموتٍ عن النطقِ المبين لسانُهُ","فإن قَرَعَ البَيضْ اليمانِيَّ وَلوَلَا",25,"ل",2,0],["صَمَدَ اللاجونَ إلى مَلِكٍ","مَنصورٍ بالأحَدِ الصّمَدِ",26,"د",1,0],["صَمصامَتي اِتَّهَموني مِن صِيانَتِها","هَل كانَ عَمرٌو عَلى الصَمصامِ يُتَّهَمُ",27,"م",1,0],["صَمّاءُ سَمُّ العِدى في جَنبِها ضَرَبٌ","وَشُربُ كاسِ الرَدى في فَمِّها شُهُدُ",28,"د",1,0],["صَمَمتُ سَمعاً فَما أُصغي إِلى العَذَلِ","وَهِمتُ قَلباً فَما أَصحو عَنِ الغَزَلِ",29,"ل",1,1],["صَمَّ سَمعي فيهِ عَن عَذَلٍ","وَاِبنُ سِتّينَ أَخو صَمَمِ",30,"م",1,0],["صَمّاءَ لَو قُذِفَ الزَمانُ بِمِثلِها","باتَت جَوانِبُهُ العُلى تَتَهَيَّلُ",31,"ل",1,0],["صَموتِ السُرى عَيرانَةٍ ذاتِ مَنسَمٍ","نَكيبِ الصُوى تَرفَضُّ عَنهُ الجَنادِلُ",32,"ل",1,0],["صُمتُ عَنهُنَّ كَي تَصومي عَنِ القَو","مِ وَقَد حينَ مُصغِياتُ الخُدودِ",33,"د",1,0],["صُمتُ حَياتي إِلى مَماتي","لَعَلَّ يَومَ الحِمامِ عيدُ",34,"د",1,0],["صُمنا عَنِ القوتِ يَوماً ثُمَّ أَعقَبَهُ","فِطرٌ وَلا صَومَ نَرجوهُ مِنَ الفِطرِ",35,"ر",1,0],["صَمَماً حَشا أُذنَ الكُمَيتِ وَدِرهِمي","كَمَهٍ أَحَلَّ بِناظِرَي بَشّارِ",36,"ر",1,0],["صَمْداً إلى المدينةِ اللعينَه","أتعسَها الرّحمنُ من مَدينَه",37,"ه",1,0],["صَمْتٌ تحيَّرَ فيه كلُّ مُحدِّثٍ","والصمتُ بعضُ خلائق الكرماءِ",38,"ا",2,0],["صَمُوتاً لها رُدْنانِ طالا وأُكْمِلا","وذيْلانِ ذالا في التَّمامِ وأُحْصِدا",39,"د",2,0],["صَمَدْتُ لِصَرْفِهُنَّ صُمُودَ صَخْرٍ","فَكمْ سَهْمٍ تَكَسَّرَ دُونَ صَدْرِي",40,"ر",2,0],["صِمْصَامُ قَوْمٍ أَغْمَدَتْهُ وَلَمْ يَكُنْ","أَيَّامَ حَاجَتِهِمْ إِليْهِ بِمُغَمَدِ",41,"د",1,0],["صمتٌ يفيضُ بياناً","ودمعَةٌ تتَبَسّم",42,"م",1,0],["صمتت لدن برَزَ الدجى","فكأن في فمها لجام",43,"م",1,0],["صمتٌ يقُزّك فيه خبّ","النمل في ملمس الرخام",43,"م",1,0],["صممتُ عَنِ الحادي عُميتُ مِنَ البُكا","ذَملتُ لِبَينٍ لَيسَ عَنهُ مناصُ",44,"ص",1,0],["صُمَّ صَداها وَعَفا رَسمُها","وَاِستَعجَمَت عَن مَنطِقِ السائِلِ",45,"ل",1,0],["صموتٌ إذا ما الصمتُ زيَّنَ أهلَهُ","وفتّاقُ أبكار الكلام المختَّمِ",46,"م",1,1],["صَمْتُ الهمام النجدِ أو إطراقُه","خُطَبٌ مُجلْجِلَةٌ بِغير هُتافِ",47,"ف",1,0],["صمْتٌ وسحرٌ وإرهابٌ وبعدُ مدىً","ماذا تكونين قولي ما تكونينا",48,"ن",2,0],["صُمْتَ فأعطَيْتَ الصِّيامَ حقَّه","ورُبَّ ذي صَوْمٍ خِداجٍ لم يَصُمْ",49,"م",1,0],["صموتٌ، إذا ما الصمتُ كان بلاغةً","فإن قال، راشَ القولَ سهمًا مسدَّدا",50,"د",2,0],["صَمَتَّ، وكم خطابٍ منك دَوَّى","بأسماع الورى وَهْو ارتجال!",51,"ل",1,0],["صمتت بعد سؤال قرأت من","صداه قصّتي حرفا فحرفا",52,"ف",2,0],["صَمَّ صَدَاهَا وَعَفَا رَسْمُهَا","واسعجمت عن منطق السائل",53,"ل",1,0],["صَمدَتْ في الزِّنا تُناسلُ حَوَّا","ما عهدناك قطُّ إلاَّ عَزوفاً",54,"ف",2,0],["صمد الدهر إليه","وهو وعر السطوات",55,"ت",1,0],["صمتاً فان العي في بع","ض المواقف شاعرية",56,"ي",2,0],["صم به واغسل الذنوبَ لتبقى","ملكاً من ملائك الرحمنِ",57,"ن",1,0],["صُمُّ رَواجعُ إنْ تزِنْ رَضْوى بها","تُخْبرْكَ عن كميِّةِ الكمّونِ",58,"ن",1,0],["صُمٌّ عَنِ الحُسنى وَلَكِن طالَما","سَمِعوا كَلامَ الحُكلِ في العَوراءِ",59,"ا",2,0],["صمتي على غصص الشجاعن حكمة","صمت امرىء متطارش ما يسمع",60,"ع",1,0],["صموت وكتمان وشوق وحسرة","وصدّ حبيب إن ذا لشديد",61,"د",1,0],["صَمَدَتْ يوافيها مَها","بوروائها فتَنَوّرا",62,"ر",2,0],["صمتت وربت صامت","يسديك وعظ النابس",63,"س",1,0],["صمدت للعظات هذي الطلولُ","فاصغ يا صاحبي لما ستقولُ",64,"ل",1,1],["صمتَ الكون مذ صمت ونامت","صادحات تردد اللحن عذبا",65,"ب",2,0],["صِمتُ مِن بَعدِها برغمي عَن اللَهوِ","فَهَل لي يَعود بِها عَيدُ فِطرِ",66,"ر",1,0],["صُمٌّ عَن الذامِ لا يأتون داعيَهُ","فان دَعَوتَ إِلى حَربٍ أَجابوكا",67,"ك",2,0],["صمدت لها وجنح الليل داجٍ","بأخطف للطريدة من عقابِ",68,"ب",1,1],["صمد بِلا كفء وَلا كَيفية","أَبدا فَما النظراء والاشباه",69,"ا",2,0],["صَميمُ المَجْدِ أمنَعُ ما يُلاقي","ذِماراً إِذْ يُلِمُّ بِهِ دَخِيلُ",70,"ل",1,0],["صُمَّ صَدى العاذِلِ في حُبِّ من","أَسكنتهُ من مُهجَتي في الصَميم",71,"م",1,0],["صمدتْ لعادي الدهرِ أطولَ مدَّة","لو لم يقدرْ فرعه أبراجها",72,"ج",3,0],["صموتك تبر والكلام كفضة","اذا زانه المعنى والافعيبان",73,"ن",1,0],["صمت عن الحق وهي سامعة","كأنني ما أريد إياها",74,"ا",3,0],["صمتُ يوما عن الطعام فما جع","تُ لأني أردتُ هذا الصياما",75,"م",2,0],["صَمتُ اللَبيبِ يَزينُهُ","وَبِهِ يُصانُ الجاهِلُ",76,"ل",1,1],["صَمَتّ فَقيل قُل فَأَجدت قَولاً","بِهِ اِفتَخَر الأَواخر وَالأَوائل",77,"ل",1,1],["صَموتٍ فإن جَرَّدْتَه فجَميعُه","لسانٌ مُبينُ الهامِ غيرُ مُبين",78,"ن",1,0],["صُمْ أَلفَ عامٍ مثْلِ عامِك مُقبِلٍ","في ظلِّ دائمةٍ بغَيرِ نَفاد",79,"د",1,0],["صُمْ ألفَ عامٍ في ظلالِ سعادةٍ","ولأَلْفِ عيدٍ بالميامِنِ عَيِّد",80,"د",1,0],["صُمْ وأفطِرْ ما كُرِّرَ الصّوم والفِطْ","رُ عزيزاً تَعيشُ في النَّعْماء",81,"ا",2,0],["صَمَتَ العَذولُ وَصَمتُهُ إِقرارُ","صَمَتَ المُحِبُّ وصمتُهُ إِصرارُ",82,"ر",1,1],["صَمَتُّ عَنِ الشَكوى وَأَيقَنتُ أَنَّني","عَدِمتُ إِذا أَبدَيتُها مَن يُصَمِّتُ",83,"ت",1,1],["صُمَّت عَن العاذلِ في حبِّه","أُذني فَمالي مِسمَعٌ يَسمَعُ",84,"ع",1,0],["صمتي عن الحق لا جهلاً ومعجزةً","لكن لأمرٍ دعاني فيه أَتْأنَّى",85,"ن",2,0],["صمتٌ وصبرٌ وكفاحٌ لم يزل","وخدعٌ من دونها وقعُ الأسَل",86,"ل",1,0],["صم اِن أَرَدتَ تَحَرُّجاً وَتَعَفُّفاً","عَن أَن تكدَّ الصَبَّ بِالهِجران",87,"ن",1,0],["صمتكُم ظُلمٌ كظلم المعتدي","كلكم في إثمهِ تشتركون",88,"ن",1,0],["صمدتَ لَهمْ في كلّ بيداء مَجْهَل","وقد أظْلمتْ تحتَ العجاجِ طريقُها",89,"ق",3,0],["صم عن الداعي وإن قالوا له","قولاً ففعلهم لذاك مناف",90,"ف",1,0],["صُمْ كما شِئت بخيرٍ واغتَنم","أجْرَ شهرِ الصَّوم بالخير المدان",91,"ن",1,0],["صممته بظلامٍ مثل طرته","فاشرقت وجنتاه موضع القبل",92,"ل",1,0],["صُمْ سعيداً فأنت أكرمُ مَولىً","قبِل اللهُ نَسْكَهُ وصِيامَهْ",93,"م",2,0],["صُمْ وافرَ الأجرِ وصِمْ حاسداً","يُشْجيهِ قولي لك صُمْ أوصِمِ",94,"م",1,0],["صمّ سمعيّ بل خانني نور عيني","إن أرتني في العالمين مشاله",95,"ل",2,0],["صمدت في وجه من جاءوا لينتقمو","فرد كيد البغاة الخالق الباري",96,"ر",2,0],["صم الجلاميد أحنى في مقابرها","ممن أضاعوا حقوق الشعب أو قبروا",97,"ر",3,0],["صُمتم فكانت حياةُ الصومِ تجربةً","بِراً بدينِ وأخلاقٍ وأوطانِ",98,"ن",1,0],["صُمتم عن السوءِ والأحقادِ في زمنٍ","طاشت عقولٌ وُهدِّدنا بِعدوانِ",98,"ن",1,0],["صُمتم مثالَ المساواةِ التي نُشدَت","وما تزال لأزمانٍ وأزمان",98,"ن",1,0],["صمُّوا فماً فرقوا نِدايَ نِداهُمُ","ما قلتُ أم في الضأن كان نعيقي",99,"ق",2,0],["صَمَّ وأُذنُ عِرضه","تسمعُ عنّي وتعي",100,"ي",1,0],["صَمَّاءُ من عبد الرحيم لها","عِرقٌ يمُدُّ إلى مَنُوجَهْرِ",101,"ر",1,0],["صمّ القنا الصِّلابِ من","خَوَرِهِ تَقَصَّدُ",102,"د",1,0],["صمتُّ وصمتي اِذاً حكْمةٌ","وكم حكمةٍ تحت صمتِ اللِّسانِ",103,"ن",1,0],["صَمْتٌ تُقرُّ له البلاغةُ بالحِجا","والحزمُ للمتأمِّلِ المُسْتبصرِ",104,"ر",1,0],["صموتٌ يضيق النُّطق عنه وباسمٌ","إِذا اخْتُبِرَتْ حالاتُه كان باكيا",105,"ي",2,0],["صمتت رواعد سحبه فكأنّما","ريعت قلائصها فسرنَ بلا حدا",106,"د",2,0],["صموت حيي ذاكر متورع","محب شكور هائم في العواليا",107,"ي",2,0],["صِمصامَةُ الحقِّ المُبينِ وعاملُ الد