{"poems":[[53,"لهان الغمد ما بقي الحسام","https://www.aldiwan.net/poem29818.html","الوافر"],[53,"إن كان ذاك الطود خر","https://www.aldiwan.net/poem29890.html","مجزوء الكامل"],[53,"أما لو لم تعاقره العقار","https://www.aldiwan.net/poem30451.html","الوافر"],[9,"لا فشل في ولا سقاط","https://www.aldiwan.net/poem21950.html","الرجز"],[24,"أمن أم شداد رسوم المنازل","https://www.aldiwan.net/poem21878.html","الطويل"],[24,"صموت وقوال فللحلم صمته","https://www.aldiwan.net/poem21901.html","الطويل"],[73,"ما للمدام تديرها عيناك","https://www.aldiwan.net/poem11913.html","الكامل"],[0,"يا دار ماوِية بالحائلِ","https://www.aldiwan.net/poem65.html",""],[30,"ألا ظعنت مي فهاتيك دارها","https://www.aldiwan.net/poem29534.html","الطويل"],[30,"ما بال عينك منها الماء ينسكب","https://www.aldiwan.net/poem29617.html","البسيط"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"يا سيدا لم تزل فروع","https://www.aldiwan.net/poem65943.html","مخلع البسيط"],[51,"خلياني عند اصطكاك الخصومِ","https://www.aldiwan.net/poem66322.html","الطويل"],[51,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[51,"يا أبا الصقر إن شكري لمعروفك","https://www.aldiwan.net/poem66341.html","الخفيف"],[51,"أطلع الله وجه شهرِك هذا","https://www.aldiwan.net/poem66377.html","الخفيف"],[91,"نسي الكنار نشيده","https://www.aldiwan.net/poem8878.html","عموديه"],[62,"قل لمن يطلب الحجر","https://www.aldiwan.net/poem52140.html","مجزوء الخفيف"],[62,"في راحتيك الرزق والأجل","https://www.aldiwan.net/poem52318.html","أحذ الكامل"],[45,"نصيب عينيك من سح وتسجام","https://www.aldiwan.net/poem66640.html","البسيط"],[61,"وأدهم يسفر عن ضده","https://www.aldiwan.net/poem51567.html","المتقارب"],[66,"يا مليكا بذكره يفخر المدح","https://www.aldiwan.net/poem40976.html","الخفيف"],[66,"من نفخة الصور أم من نفحة الصور","https://www.aldiwan.net/poem41361.html","البسيط"],[97,"ها أنا عدت إلى حيث التقينا","https://www.aldiwan.net/poem24925.html","الرمل"],[80,"صمت لله صوم خرق همام","https://www.aldiwan.net/poem31287.html","الخفيف"],[80,"وذي رونق ترتاع منه كأنما","https://www.aldiwan.net/poem31326.html","الطويل"],[80,"صادتك مهاة لم تصد","https://www.aldiwan.net/poem31480.html","المتدارك"],[44,"شعبي وشعب عبيد الله ملتئم","https://www.aldiwan.net/poem29705.html","البسيط"],[44,"لو صحح الدمع لي أو ناصح الكمد","https://www.aldiwan.net/poem30314.html","البسيط"],[74,"صممت سمعا فما أصغي إلى العذل","https://www.aldiwan.net/poem13214.html","البسيط"],[74,"قل لمسرى الريح من إضم","https://www.aldiwan.net/poem13255.html","المديد"],[105,"إني نصحتك فاتهمت نصيحتي","https://www.aldiwan.net/poem43108.html","الكامل"],[22,"أرى العير تحدى بين قو وضارج","https://www.aldiwan.net/poem22003.html","الطويل"],[50,"اشفعي لي صريم عند الكنود","https://www.aldiwan.net/poem63937.html","الخفيف"],[46,"إن صح لي أنني سعيد","https://www.aldiwan.net/poem22403.html","مجزوء البسيط"],[46,"إن كان لم يترك قيس له وطرا","https://www.aldiwan.net/poem22666.html","البسيط"],[46,"يا شهب إنك في السماء قديمة","https://www.aldiwan.net/poem22712.html","الكامل"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39594","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16696","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54836","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54730","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142051","المجتث"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141961","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43643","الطويل"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1927","السريع"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116985","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54283","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54220","البسيط"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/50449","الرجز"],[106,"فقيدُ الإسلام!","https://www.poetsgate.com/ViewPoem.aspx?id=179686",""],[106,"رويدك يا جمال!","https://www.poetsgate.com/ViewPoem.aspx?id=179353",""],[100,"يداها","https://www.poetsgate.com/ViewPoem.aspx?id=50458",""],[0,"يَا دَارَ مَاوِيّة َ بِالحَائِلِ","https://www.poetsgate.com/ViewPoem.aspx?id=4787",""],[51,"خلياني عند اصطكاك الخصوم","https://www.poetsgate.com/ViewPoem.aspx?id=25876",""]],"verses":[["صُموتٌ لا يُجابُ لَهُنَّ داعٍ","أَرَنَّ وَلا يُرَدُّ لَهُ سَلامُ",0,"م",1,0],["صَمّاءُ تُخرِسُ آلَها","إِلّا قِراعاً أَو صَهيلا",1,"ل",2,0],["صَموتٌ بَينَ أَطرافِ العَوالي","وَفي طَعنِ القُلوبِ لَهُ خُوارُ",2,"ر",1,0],["صَمَحمَحٌ مُجَرَّبٌ عَيّاطُ","وَوائِلٌ كَأَنَّهُ مُخاطُ",3,"ط",1,0],["صَموتِ السُرى خَرساءَ فيها تَلَفُّتٌ","لِنَبأَةِ حَقٍّ أَو لِتَشبيهِ باطِلِ",4,"ل",1,0],["صَموتٌ وَقَوّالٌ فَلِلحِلمِ صَمتُهُ","وَبِالعِلمِ يَجلو الشَكَّ مَنطِقُهُ الفَصلُ",5,"ل",1,1],["صَمصامُ بادِرَةٍ وَطَودُ سَكينَةٍ","وَجَوادُ غاياتٍ وَجِذلُ حِكاكِ",6,"ك",1,0],["صُمَّ صَداها وَعَفا رَسمُه","وَاِستَعجَمَت عَن مَنطِقِ السائِلِ",7,"ل",1,0],["صَموتٌ إِذا التَصديرُ في صُعدائِهِ","تَصَعَّدَ إِلّا أَنَّهُ لا يَتَبَغَّمُ",8,"م",1,0],["صَمتُ الخَلاخيلِ خَودٌ لَيسَ يُعجِبُها","نَسجُ الأَحاديثِ بَينَ الحَيِّ وَالصَخَبُ",9,"ب",1,0],["صموتٌ بلا عيٍّ له من بلائه","نَوَاطِقُ تَسْتدْعِي الرَّجَاءَ وتَزْأدُ",10,"د",1,0],["صَمْتٌ وعيبٌ فلا خطابٌ","ولا كتابٌ ولا رسولُ",11,"ل",1,0],["صمَدَتْ في الزِّنا تُناسلُ حَوَّا","ء فحوَّاءُ عِندها كالعقيمِ",12,"م",1,0],["صُمْتُ عن كُل لذّةٍ لمشيبي","أفلا كان للإله صيامي",13,"م",2,0],["صُمْتُ عمَّنْ سواكَ من سائر النَّا","س ففطْري بذاكَ عند صيامي",14,"م",2,0],["صمتَ فيه وقمتَ بعدَ صيامٍ","وقيامٍ من قَبْلهِ غيرَ دون",15,"ن",1,0],["صَمتُ الكَنارِ وَإِن قَسا","خَيرٌ مِنَ النَغَمِ المُعار",16,"ر",1,0],["صمغة الشمس هذه","جسد الصمغة القمر",17,"ر",1,0],["صمَّاءُ ما في عودِها خَوَرٌ","عيطاءُ ما في عِطْفِها مَيَلُ",18,"ل",1,0],["صَمصامَةُ الرَأيِ صَمصامُ الجَنانِ ثَنى","تِلكَ الصُفوفَ بِماضي الحَدِّ صَمصامِ",19,"م",1,0],["صَمُوتٌ إذا زُرَّ جِلبابُهُ","أريبٌ فإنْ حَلَّهُ أمتَعا",20,"ع",2,0],["صُمَّ في صَومِكَ العُداةُ وَفي فِط","رِكَ مِنهُم تُفَطَّرُ الأَكبادُ",21,"د",1,0],["صُمَّت بِصَومِكَ أَسماعُ العُداةِ وَكَم","قَلبٍ لَهُم مِنكَ بِالإِفطارِ مَفطورِ",22,"ر",1,0],["صَمَتَ السّهلُ ولكن أقبَلَت","من ثَنَايا السهلِ أصداءٌ بعيده",23,"ه",1,0],["صُمْتَ للَّه صَوْمَ خِرْقٍ هُمامِ","مُفْطِرِ الكفّ بالعطايا الجسامِ",24,"م",1,1],["صموتٍ عن النطقِ المبين لسانُهُ","فإن قَرَعَ البَيضْ اليمانِيَّ وَلوَلَا",25,"ل",2,0],["صَمَدَ اللاجونَ إلى مَلِكٍ","مَنصورٍ بالأحَدِ الصّمَدِ",26,"د",1,0],["صَمصامَتي اِتَّهَموني مِن صِيانَتِها","هَل كانَ عَمرٌو عَلى الصَمصامِ يُتَّهَمُ",27,"م",1,0],["صَمّاءُ سَمُّ العِدى في جَنبِها ضَرَبٌ","وَشُربُ كاسِ الرَدى في فَمِّها شُهُدُ",28,"د",1,0],["صَمَمتُ سَمعاً فَما أُصغي إِلى العَذَلِ","وَهِمتُ قَلباً فَما أَصحو عَنِ الغَزَلِ",29,"ل",1,1],["صَمَّ سَمعي فيهِ عَن عَذَلٍ","وَاِبنُ سِتّينَ أَخو صَمَمِ",30,"م",1,0],["صَمّاءَ لَو قُذِفَ الزَمانُ بِمِثلِها","باتَت جَوانِبُهُ العُلى تَتَهَيَّلُ",31,"ل",1,0],["صَموتِ السُرى عَيرانَةٍ ذاتِ مَنسَمٍ","نَكيبِ الصُوى تَرفَضُّ عَنهُ الجَنادِلُ",32,"ل",1,0],["صُمتُ عَنهُنَّ كَي تَصومي عَنِ القَو","مِ وَقَد حينَ مُصغِياتُ الخُدودِ",33,"د",1,0],["صُمتُ حَياتي إِلى مَماتي","لَعَلَّ يَومَ الحِمامِ عيدُ",34,"د",1,0],["صُمنا عَنِ القوتِ يَوماً ثُمَّ أَعقَبَهُ","فِطرٌ وَلا صَومَ نَرجوهُ مِنَ الفِطرِ",35,"ر",1,0],["صَمَماً حَشا أُذنَ الكُمَيتِ وَدِرهِمي","كَمَهٍ أَحَلَّ بِناظِرَي بَشّارِ",36,"ر",1,0],["صَمْداً إلى المدينةِ اللعينَه","أتعسَها الرّحمنُ من مَدينَه",37,"ه",1,0],["صَمْتٌ تحيَّرَ فيه كلُّ مُحدِّثٍ","والصمتُ بعضُ خلائق الكرماءِ",38,"ا",2,0],["صَمُوتاً لها رُدْنانِ طالا وأُكْمِلا","وذيْلانِ ذالا في التَّمامِ وأُحْصِدا",39,"د",2,0],["صَمَدْتُ لِصَرْفِهُنَّ صُمُودَ صَخْرٍ","فَكمْ سَهْمٍ تَكَسَّرَ دُونَ صَدْرِي",40,"ر",2,0],["صِمْصَامُ قَوْمٍ أَغْمَدَتْهُ وَلَمْ يَكُنْ","أَيَّامَ حَاجَتِهِمْ إِليْهِ بِمُغَمَدِ",41,"د",1,0],["صمتٌ يفيضُ بياناً","ودمعَةٌ تتَبَسّم",42,"م",1,0],["صمتت لدن برَزَ الدجى","فكأن في فمها لجام",43,"م",1,0],["صمتٌ يقُزّك فيه خبّ","النمل في ملمس الرخام",43,"م",1,0],["صممتُ عَنِ الحادي عُميتُ مِنَ البُكا","ذَملتُ لِبَينٍ لَيسَ عَنهُ مناصُ",44,"ص",1,0],["صُمَّ صَداها وَعَفا رَسمُها","وَاِستَعجَمَت عَن مَنطِقِ السائِلِ",45,"ل",1,0],["صموتٌ إذا ما الصمتُ زيَّنَ أهلَهُ","وفتّاقُ أبكار الكلام المختَّمِ",46,"م",1,1],["صَمْتُ الهمام النجدِ أو إطراقُه","خُطَبٌ مُجلْجِلَةٌ بِغير هُتافِ",47,"ف",1,0],["صمْتٌ وسحرٌ وإرهابٌ وبعدُ مدىً","ماذا تكونين قولي ما تكونينا",48,"ن",2,0],["صُمْتَ فأعطَيْتَ الصِّيامَ حقَّه","ورُبَّ ذي صَوْمٍ خِداجٍ لم يَصُمْ",49,"م",1,0],["صموتٌ، إذا ما الصمتُ كان بلاغةً","فإن قال، راشَ القولَ سهمًا مسدَّدا",50,"د",2,0],["صَمَتَّ، وكم خطابٍ منك دَوَّى","بأسماع الورى وَهْو ارتجال!",51,"ل",1,0],["صمتت بعد سؤال قرأت من","صداه قصّتي حرفا فحرفا",52,"ف",2,0],["صَمَّ صَدَاهَا وَعَفَا رَسْمُهَا","واسعجمت عن منطق السائل",53,"ل",1,0],["صَمدَتْ في الزِّنا تُناسلُ حَوَّا","ما عهدناك قطُّ إلاَّ عَزوفاً",54,"ف",2,0]]}