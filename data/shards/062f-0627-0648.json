com/ViewPoem.aspx?id=153509",""],[3591,"قد هام حافظ في القطرين وانتسبا","https://www.poetsgate.com/ViewPoem.aspx?id=149505",""],[5186,"لا خير في الشكوى وقد","https://www.poetsgate.com/ViewPoem.aspx?id=156478",""],[5190,"جرح نازف","https://www.poetsgate.com/ViewPoem.aspx?id=62017",""],[5352,"ونيرب من موالي السوء ذي حسد","https://www.poetsgate.com/ViewPoem.aspx?id=200560",""],[5464,"كُتِبَ الوفاءُ عليَّ دون إرادتي","https://www.poetsgate.com/ViewPoem.aspx?id=125405",""],[327,"أشتقت وانهل دمع عينك أن","https://www.poetsgate.com/ViewPoem.aspx?id=4137",""],[2110,"دع هوى سلمى واقصر عن سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=156270",""],[5690,"دع عنك تشبيباً بوصف محاجرِ","https://www.poetsgate.com/ViewPoem.aspx?id=172161",""],[5718,"داو القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=214404",""],[5781,"جمرةٌ في زحمة الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=204823",""],[5943,"بشذا الورودِ ندى تفوحْ","https://www.poetsgate.com/ViewPoem.aspx?id=60770",""],[1920,"فيض الحنان","https://www.poetsgate.com/ViewPoem.aspx?id=200491",""],[6052,"بطاقات حمراء من غزة","https://www.poetsgate.com/ViewPoem.aspx?id=47578",""],[520,"داويت ما نقع العليل دوائي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577430",""],[5190,"فاض الكيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78342&r=&rc=55",""],[6355,"شيشان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66608&r=&rc=68",""],[572,"سيّدي أنتَ لَمْ أكُنْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9409&r=&rc=266",""]],"verses":[["دَاوُدُ وَهْوَ الَّذِي كَا","نَ عَاهِلاً وَنَبِيَّا",0,"ي",2,0],["داوُدَ إِنَّكَ مِن ذَوي الأَحسابِ","وَنَدى يَدَيكَ يَفيضُ لِلمُنتابِ",1,"ب",1,1],["دَاوي هَوايَ وَأَطفِئي","ما في الفُؤَادِ مِنَ الحَريق",2,"ق",1,0],["داوَيتَ بِالقَطِرانِ عَرَّ جُلودِهِم","حَتّى بَرَأنَ وَكُنَّ غَيرَ بِراءِ",3,"ا",2,0],["داوَيتَهُم وَشَفَيتَهُم مِن فِتنَةٍ","غَبراءَ ذاتِ دَواخِنٍ وَأُجاجِ",4,"ج",1,0],["داوى أذى رأسي طبيب قلبها","داوى لرجلك حظره من باس",5,"س",1,0],["داويت أدواءها وقد دنفت","حينا من الدهر أيما دنف",6,"ف",1,0],["داوُد وَالمِزمارُ في نَغَماتِهِ","وَالموصِلِي وَمَعبَد وَسَريرُهُ",7,"ر",2,0],["داوِ المُتَيَّمَ داوِهِ","مِن قَبلِ أَن يَجِدَ الدَوا",8,"و",2,1],["داوَيتَ كُلَّ مُحَطَّمٍ فَشَفَيتَهُ","وَنَسيتَ داءً في الضُلوعِ دَفينا",9,"ن",2,0],["داوُدُ وَالمَلِكُ المَهدِيُّ إِذ حَكَما","أَولادَها وَاِجتِزازَ الصوفِ بِالجَلَمِ",10,"م",1,0],["داوَيْتَ جِسْماً طالَما داوَى الهُدى","تحتَ العَجاجِ وأمرَضَ الإِشراكا",11,"ك",2,0],["داوِ بِالرِفقِ جِراحاتِ الخَرَق","وَابلِ قَبلَ الحَمدِ وَالذَمِّ وَذُق",12,"ق",1,1],["داوَيتَ أَضعافَ الصُدورِ بِصارِمٍ","ماءُ المَنونِ بِمَتنِهِ يَتَجَعَّدُ",13,"د",1,0],["داوِ حَبيبي يا طَبيبَ الهَوى","وَخَلِّني إِنّي بِحالي عَليم",14,"م",1,0],["داوِ ناري والتياعي","وتمهَّل في وداعي",15,"ع",2,1],["داوِ السَّقامَ فقد تفاقَمَ وانثنى","طِبُّ الأُلى سبقوك عنه سقيما",16,"م",2,0],["داويتِ بالإسلامِ قلبكِ فاشتَفَى","وغَسَلْتِ من تلكِ الجريمَةِ فَاكِ",17,"ك",1,0],["داويتَ بالحسنَى فلجَّ فسادُها","ولديك إن شِئْتَ الدواءُ الأصلحُ",18,"ح",1,0],["داوَيتَ غَيرَ وِدّي","مَصائِبُ الإِخوانِ",19,"ن",1,0],["داوِ الهُمومَ بِقَهوَةٍ صَفراءِ","وَاِمزُج بِنارِ الراحِ نورَ الماءِ",20,"ا",2,1],["داوِ يَحيى مِن خُمارِه","بِاِبنَةِ الدَنِّ وَقارِه",21,"ر",2,1],["داوى بِهِ اللَهُ القُلوبَ مِنَ العَمى","حَتّى أَفَقنَ وَما بِهِنَّ سَقامُ",22,"م",1,0],["داوودُ مَحمودٌ وَأَنتَ مُذَمَّمٌ","عَجَباً لِذاكَ وَأَنتُما مِن عودِ",23,"د",1,0],["داوى صُدورَهُمُ مِن بَعدِ ما نَغِلَت","كَما يُداوى بِدُهنِ العُرَّةِ العَنَدُ",24,"د",1,0],["داوِني مِن حِمامِ قَلبي إِلَيها","بِدَواءٍ يَرُدُّ غَربَ الجِماحِ",25,"ح",1,0],["داودُ إِنَّكَ قَد بَلَغتَ بِحاتِمٍ","شَرَفَ العُلى وَذَهَبتَ في أَسبابِهِ",26,"ب",2,0],["داودُ غَيثُكَ إِن بَسَطتَ بِلادَهُ","فَاِنزِل ضَمِنتُ لَكَ الحِبا بِجَنابِهِ",26,"ب",2,0],["داوَيتَ مُتَّئِداً وَداوَوا ظَفرَةً","وَأَخَفُّ مِن بَعضِ الدَواءِ الداءُ",27,"ا",2,0],["داويت متئدا وداووا طفرة","وأخف من بعض الدواء الداء",28,"ا",2,0],["داواهُ مَن أَدواهُ حَتّى قالَ لي","لا تَأتِني مِن ذا الرَدى بِدَواءِ",29,"ا",2,0],["داووكَ مِن عِلَّتَيك حَتّى","تَسَلَّلوا مِنهُما لِواذا",30,"ذ",2,1],["«داودُ» يبكيك فنٌّ كنت تبكيه","كأنما دمعه ديْن يؤديهِ",31,"ي",2,1],["«داود»، كم لك ألحان مرددة","يجرحن أحشاء من يخرجن من فيه",31,"ي",2,0],["داوَي جراحَ الشرق حدُّ سلاحِهِ","وحمى الذِّمارَ، وحقَّقَ المأمولا",32,"ل",2,0],["\" داودُ \" بالمزمارِ يُوقِظه","ويُنيمُهُ بالعُود \" مَعبده \"",33,"د",2,0],["داوِني إنَّ بين جنبيَّ قلباً","يشتكي طولَ دهره أوجاعا",34,"ع",2,0],["داو لي المهجة بالوص","ل فذا البعد كفاها",35,"ا",3,0],["داوني من جرح طرف","لك للاكباد يطرف",36,"ف",1,0],["داوني يا رحيم من كل داء","واحييني بالقبول يا مولائي",37,"ا",2,0],["داؤك هذا مَن جناه وَمن","يُبرئه قلتُ الذي تعلَمُ",38,"م",1,0],["داوَى عَياءَ الداءِ ساحرُ رفِقهِ","والنَّقْبُ يَشفيهِ هِنَاءُ الهانى",39,"ن",2,0],["داوى كُلُومَهُمُ وَأَصلَحَ مِنهُمُ","ما كانَ أَفسَدَهُ الزَمانُ المُفسِدُ",40,"د",1,0],["داوَيتُكُم جاهِداً لَو أَنَّ داءَكُمُ","مِمّا يُداوى بِغَيرِ البيضِ وَالأَسَلِ",41,"ل",1,0],["دَاوِ الخمارَ بِخَمْرَهِ","وَصِلِ الصَّبُوحَ بِفَجْرهِ",42,"ر",2,1],["داوَيتَ ضَيفَكَ حَتّى قامَ مُعتَدِلا","وَرشَتَهُ فَرَآهُ الناسُ قَد جُبِرا",43,"ر",2,0],["داؤه استعصى وأضناه الجوى","هكذا يعمل بالصبّ النوى",44,"ن",3,0],["داوَى انفرادي منك أن","سٌ للكآبة طارد",45,"د",1,0],["داوني، وارْحَمْ عذابي","لا تكنْ لي كالغريبِ",46,"ب",1,0],["داومي العود وداويني به","واجعليني للحمى لاوي العنا",47,"ن",2,0],["داؤه في الهوى عداك عياء","عد عنه لا ينتهي تعداده",48,"د",2,0],["داؤنا في الهوى شجى وشجون","كيف نمحو الشجى ونبرى الشجونا",49,"ن",2,0],["داورتُه بالرفِق لا","آلو لو انَّ الرفقَ أَجدى",50,"د",2,0],["داودُ عَدلٌ فَاِحكُم بِسُنَّتِهِ","وَآلُ مَروانَ إنهمنَصَحوا",51,"ح",3,0],["داؤنا الداء والدواء لدينا","في هدى المصطفى ونور الكتاب",52,"ب",1,0],["داوم على درس العلوم مطالعا","ياويح طمس للطوى يتجمجمُ",53,"م",1,0],["داوِ القُلوب وقيت مِن عِلل الرَدى","فَلرُبَّما اِندَمَلَت لَهُنَّ جِراحُ",54,"ح",1,0],["داود ينشد نَحوَه مترنماً","وكذاك موسى والنبي يونان",55,"ن",1,0],["داود مَثَّلَها بآلة نَظمِهِ","مُذ خُصِّصَت بالنَغمةِ الحسناءِ",56,"ا",2,0],["داوَيتُهُ بِالمَحضِ حَتّى شَتا","يَجتَذِبُ الآرِيَّ بِالمِروَدِ",57,"د",1,1],["داوي ضنىً في القَلْبِ أنتِ جَلَبْتِهِ","فدواءُ دائي رشْفَةٌ مِنْ فيكِ",58,"ك",1,0],["داؤه عندي هو الداء العضال","ذكره يشجي",59,"ي",1,0],["داوني واشف ولاطف وأغث","وادفع الشر إذا الشر حضر",60,"ر",1,0],["دَاوَى بما أعلن من بثِّه","قَلباً من الكتمانِ دَامِي الجراحْ",61,"ح",1,0],["داو بها كلَّ ما تشكوه من وصب","ففي المدامة ما يشفي من الوصب",62,"ب",1,0],["داوِ الفواد برشف كوثر مائه","واجل النواظر تؤرخ بالأغر",63,"ر",1,0],["داوي الحشاشة راشفاً","سلسال ماءٍ سلسلا",64,"ل",2,1],["داودُ والمرتجى في كلّ نائبةٍ","إن قلّ في الناس أعواني وأنصاري",65,"ر",2,0],["داوى بتأنيسه نفاري","طَبٌّ بأدوائه العِضالِ",66,"ل",1,0],["داوِ بها حبّي فما مهجتي","أوّلُ مخبولٍ بنجدٍ رُقِي",67,"ق",2,0],["داوستهُا أبغي العَلاءَ بهمّةٍ","لو شاورت أمَّ الشقيق لَمَا سَمتْ",68,"ت",1,0],["داوِ العَليلَ تَفَضُّلاً وتَكَرُّماً","واشْفِ الغَليلَ تَرَحُّماً وتَحَنُّنا",69,"ن",2,0],["داويت ما نفع العليل دوائي","بل زاد سقماً في خلال ضناء",70,"ا",2,1],["داويته حتى إذا","لم يبق في الدنيا دوا",71,"ا",1,0],["داوت بصحة جسمي سقم مقلتها","فما أبل ومالي منه إبلال",72,"ل",1,0],["داود داودُ لا تفلت حَبائله","واِشدد يديك بِباقي للودّ وَصّالِ",73,"ل",1,0],["داويتَ ما أَنت به عالمٌ","ودائِيَ المعضلُ لم تعلمِ",74,"م",1,0],["داوِ دائي أوْ فعُدْني","مَعَ عُوّادي مريضا",75,"ض",2,0],["داوى فِلِسطينَ مِن أَدوائِها بَطَلٌ","في صورَةِ المَوتِ إِلّا أَنَّهُ رَجُلُ",76,"ل",1,0],["داوَيتَ مِن دائِها كَرمانَ وَاِنتَصَفَت","بِكَ المَنونُ لِأَقوامٍ مَجاهيدِ",77,"د",1,0],["داودُ عيسى بنَى داراً مُبارَكةً","في طالعٍ حَسَنِ الإقبالِ مسعودِ",78,"د",1,1],["دَاوِ خُمَارِي بِكَأسِ خَمْرِ","وَأَحْيِ سُكْرَ الهَوَى بِسُكْرِ",79,"ر",1,1],["دَاوِ جِسْمِي فَإِنَّهُ","فِيْكَ بِالصَّدِّ قَدْ شَقِي",80,"ق",2,0],["داوود أورثني علما وجاد بما","أُعطي على نبيُّ الله داوود",81,"د",1,0],["داوَيتَ عِلَّتَهُم بِعَلَّتِهمِ","يا مَن يُداوي السُّقمَ بِالسُّقمِ",82,"م",1,0],["دَاوِ مَا تَشْكُو به من مرض","بصباح من محيّاه انبلج",83,"ج",1,0],["داويت هوى اضنى فؤادي","يهوى ما زاد علي غير فقد القلب",84,"ب",1,0],["داوَيتَهم بِنِف