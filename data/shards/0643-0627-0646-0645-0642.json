{"poems":[[53,"يا أخي أين ريع ذاك اللقاء","https://www.aldiwan.net/poem7944.html","الخفيف"],[31,"ألا يا اسلما على التقادم والبلى","https://www.aldiwan.net/poem6051.html","الطويل"],[82,"بجمل حدا الغيران بزل جمائله","https://www.aldiwan.net/poem31331.html","الطويل"],[33,"ألم تربع على الطلل المريب","https://www.aldiwan.net/poem42657.html","الوافر"],[8,"سما لك هم ولم تطرب","https://www.aldiwan.net/poem21770.html","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55240","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54781","الخفيف"],[199,"نأتك حسينة فيمن نأى","https://www.aldiwan.net/poem54403.html","المتقارب"],[369,"أأجفان بيض هن أم بيض أجفان","https://www.aldiwan.net/poem60628.html","الطويل"],[376,"أبثك ما الحديث به شجونا","https://www.aldiwan.net/poem57071.html","الخفيف"],[447,"أريقي الدمع يا مقلي أريقي","https://www.aldiwan.net/poem14467.html","الوافر"],[556,"ألا إني وهبت اليوم نفسي","https://www.aldiwan.net/poem47748.html","الوافر"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18510","المتقارب"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96683","الطويل"],[2321,"","https://poetry.dctabudhabi.ae/diwan/poem/147005","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204448","المتقارب"],[3477,"","https://poetry.dctabudhabi.ae/diwan/poem/132985","الطويل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66622","الطويل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86527","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59472","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90965","الرمل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54419","المنسرح"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33283","السريع"],[5190,"في ذكرى ملحمة العبور","https://www.poetsgate.com/ViewPoem.aspx?id=9716",""],[5776,"الحكيمُ الرابع","https://www.poetsgate.com/ViewPoem.aspx?id=199327",""],[402,"أيها المغتدي عليك السلام","https://www.poetsgate.com/ViewPoem.aspx?id=36203",""]],"verses":[["كان مقدارُ حُرمتي بك في نف","سك شيئاً من تافِه الأشياءِ",0,"ا",2,0],["كَأَنَّ مَقَذَّيها إِذا ما تَحَدَّرا","عَلى واضِحٍ مِن ليتِها وَشَلانِ",1,"ن",1,0],["كأنّ مقامَ الحربِ أشهى ربوعِهِ","إليه وبيضُ الهند أدنى قبائِلِه",2,"ل",2,0],["كَأَنَّ مَقَصَّ رامِسَةٍ عَلَيهِ","مَعَ الحِدثانِ سَطرٌ في عَسيبِ",3,"ب",1,0],["كَأَنَّ مَقَطَّ شَراسِيفِهِ","إِلى طَرَفِ القُنبِ فالمَنقَبِ",4,"ب",1,0],["كَانَ مِقْدَامَهَا إِذَا أَعْضَلَ فَلَمْ الأَمْ","رُ فَلَمْ يَضْطَلِعْ بِهِ مِقْدَامُ",5,"م",1,0],["كَانَ مِقْدَامَ قَوْمِهِ وَأَبَا النُّوَّ","ابِ فِيهِمْ وَغَوَتْهُم حِينَ يُقْصَدْ",6,"د",1,0],["كَأَنَّ مُقَبِّلَها بِالصَريْ","مِ ظَمآنُ مُستَورِدٌ يُرشَفُ",7,"ف",1,0],["كأنّ مُقامَ الفاضلِيَن لديهمُ","سَنا الشَّمسِ ذُرَّت في نَواظرِ عُمْيان",8,"ن",1,0],["كأنَّ مَقاصِدي أمسَت عُيُونا","وقَد غَدتِ الخُطوبُ لها جُفُونا",9,"ن",2,0],["كأن مقامه أبدا لدينا","مقام الطيف بالليل الطروق",10,"ق",1,0],["كأنّ مَقامَ جارِهِمُ عليهمْ","مقامُ مؤمّلٍ لرجوع أمسِ",11,"س",1,0],["كَأَنَّ مُقَلَّدَها إِذ بَدا","بِهِ الدُرُّ وَالشَذرُ وَالجَوهَرُ",12,"ر",1,0],["كانَ مَقامُنا بِها أَيّاما","أَربَعَة تَستَوجِب الإِتماما",13,"م",2,0],["كانَ مَقامُنا بِها أَيّاماً","ثَلاثَة نَحسبُها مَناما",13,"م",2,0],["كانَ مقامُنا لَدَيهِ سَبعا","مِن اللَيالي يَستَفيد نفعا",13,"ع",2,0],["كأنّ مقنيات به وبملكه","منَ الحسنِ مصر وهو في مصر يوسفُ",14,"ف",1,0],["كأن مقلتها الوطفاء إذ نظرت","سيف الأمير البشير الأروع البطل",15,"ل",1,0],["كأن مقر الحياة السماء","ترى كل حي اليها نزوعا",16,"ع",2,0],["كأنَّ مَقِيلَ القلبِ منه قَرَارةٌ","تُصَفِّقها أيدي الرياح فَتَخفُقُ",17,"ق",1,0],["كَأنَّ مَقادِيرَ الزَّمانِ قِسِيُّهُ","رَمانِي بِها وَالحَادِثاتِ لَها نَبْلُ",18,"ل",1,0],["كأن مقاليد الزعامة عندنا","تعاف البنان الرخص والساعد اللدنا",19,"ن",2,0],["كأنَّ مُقلتَها قد أوْلجت نبأً","في أذنها فهي تستقصي وتستمعُ",20,"ع",1,0],["كان مقداما إذا امرأ قضى","زهق الباطل والحق غلب",21,"ب",1,0],["كان مقيماً بها على الفلكِ ال","أعلى شهاباً بنورهِ سَطَعا",22,"ع",2,0],["كانَ مقيماً فنهاهُ الهَوَى","واختلستهُ دولة الهَجرِ",23,"ر",1,0],["كأنّ مقاتلي أُحدٍ وبدرٍ","ملائكةٌ تلوِّح من بعيدِِ",24,"د",1,0],[". كانَ مقهى القلوبِ من غيرِ شايٍ","الملايينُ فيهِ تطهو الحضارهْ",25,"ر",2,0],[". كانَ مقهى فيه انتظارُ طلولٍ","أجّلتها إلى المُحالِ الخسارهْ",25,"ر",2,0],["كان مقدامها إذا أعضل الأمر","فلم يضطلع به مقدام",26,"م",1,0]]}