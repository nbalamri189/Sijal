"],[513,"أيا أذن الأيام إن قلت فاسمعي","https://www.aldiwan.net/poem12176.html","الطويل"],[513,"حسبت الدهر في ولدي","https://www.aldiwan.net/poem12294.html","الهزج"],[514,"اني اراني لسحيم قائلا","https://www.aldiwan.net/poem48619.html","الرجز"],[527,"وليت الحكم فوق الأربعينا","https://www.aldiwan.net/poem37121.html","الوافر"],[527,"وليت الحكم خمسا وهي خمس","https://www.aldiwan.net/poem37122.html","الوافر"],[549,"كتمت من أسماء ما كان علن","https://www.aldiwan.net/poem47149.html","الرجز"],[549,"ماذا على الريم لو حيا فأحيانا","https://www.aldiwan.net/poem47179.html","البسيط"],[549,"لعمرك إنني فارقت نجدا","https://www.aldiwan.net/poem47181.html","الوافر"],[549,"بقاء ولكن لو أتى لا أذمه","https://www.aldiwan.net/poem47249.html","الطويل"],[549,"مدحتكم علما بأن مدائحي","https://www.aldiwan.net/poem47385.html","الطويل"],[549,"عرفت الديار كسحق البرود","https://www.aldiwan.net/poem47805.html","المتقارب"],[549,"إلام أرامي في المنى وأُرادي","https://www.aldiwan.net/poem47847.html","الطويل"],[549,"أما سمعت حمام الأيك إذ صدحا","https://www.aldiwan.net/poem47895.html","البسيط"],[556,"لو أن من يطلب مولاه","https://www.aldiwan.net/poem33668.html","السريع"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[584,"قف بالركائب أو سقها بترتيب","https://www.aldiwan.net/poem17440.html","البسيط"]],"verses":[["وَلَيتَ أَديمَ الأَرضِ يَعرى كَما اِكتَسى","مِنَ الناسِ أَو يَعفو كَما بانَ رَسمُهُ",0,"م",2,0],["وَلَّيتُهُ زُجَّ القَناةِ مُوَزَّعاً","فَكَأَنَّما أَعمَلتُ فيهِ عامِلا",1,"ل",2,0],["وَليتَ صُبحاً ساءَني ضَوءُهُ","زالَ وَأَبقى لَيلَهُ الأَليَلا",2,"ل",2,0],["وُلّيتُها طِفلاً فَهَل","مَجدٌ يُعَدَّدُ مِثلَ مَجدي",3,"ي",1,0],["وَلَيتَهُنَّ عَلى يَأسِ اللِقاءِ لَنا","عَلَّلنَ بِالوَعدِ سَيرَ الضُمَّرِ القودِ",4,"د",1,0],["ولَيْتَ لِساناً أرْهَفَ العَذْلُ غَرْبَهُ","على الصّبِّ مَفْلولُ الشَباةِ كَليلُها",5,"ل",3,0],["وَلَيتَكَ حالَ البَحرُ دونَكَ كُلُّهُ","وَكُنتَ لَقىً تَجري عَلَيهِ السَوائِلُ",6,"ل",1,0],["وَلِيَتَّقِ اللَهَ أُولو أَمرِها","أَن يُسكِتوا الأَصواتَ أَو يُرفِحوا",7,"ح",3,0],["وَلَيتَ الَّذي قادَ عَفواً إِلَيكِ","أَبِيَّ الهَوى في عَنانِ الغَزَل",8,"ل",1,0],["وَليتَ الثُغورَ فَلَم تَعدُ أَن","رَأَبتَ الثَأى وَسَدَدتَ الخَلَل",9,"ل",1,0],["وَلِيتَ فَما شانَتكَ فينا وِلايَةٌ","وَلا أَنتَ فيها كُنتَ مِمَّن يَشينُها",10,"ن",3,0],["وَليتَ فَلَم تَشتم عَلِيّاً وَلَم تُخِف","بَرِيّاً ولم تَقبَل إِشارَةَ مُجرِمِ",11,"م",1,0],["وَلِيتَ فَلَم تُغفِل صَديقاً وَلَم تَدَع","رَفيقاً وَلَم يُحرَم لَدَيكَ غَريبُ",12,"ب",1,0],["وُلِّيْتَ بِالمَعْرُوفِ أَجْمَعِ أَمْرَهُمْ","فَإِلَيْكَ مِنْهُمْ أَجْمَعَ الشُّكْرَانِ",13,"ن",1,0],["وَلِيتَ الْقَضَاءَ فَكُنْتَ الْقَضَاءَ","عَلَى المُعْتَدِي وَعَلَى الآثِمِ",14,"م",1,0],["وُلِّيتَهُ فِي مَبْدَأِ اسْتِقْلالِهِ","وَلَهُ مِنَ الشورَى أَشَد دِعَامِ",15,"م",1,0],["وليتها كان هذا حظُّ شاربها","بل قد تفُتّ بكفّيه المرارات",16,"ت",1,0],["وَليتُم أَمرَنا وَلَكُم عَلَينا","فُضولٌ في الحَديثِ وَفي القَديمِ",17,"م",1,0],["وَلَيتَها إِذ أَخَذَت قِسمَها","عَن قِسمِنا تُغمِضُ أَو تَغفَلُ",18,"ل",1,0],["وَلَيتَ الَّذي بَيني وَبَينَكَ عامِرٌ","وَبَيني وَبَينَ العالَمينَ خَرابُ",19,"ب",1,0],["وليتني عارفاً ذنبي فأجعله","باب التقاضي لسهل العفو مرْتاح",20,"ح",1,0],["وليت النجوم الزهر تدنو قوافياً","لنا قتنقى في ابن خضر المدائح",21,"ح",1,0],["ولّيت بالعلمِ لا بالحظِّ مرتبةً","فاحْكمْ بعلمِك فيما أنتَ ناظره",22,"ر",2,0],["وليت نجمك لم يشرق على سحري","وليت برقك لم يومض على أفقي",23,"ي",1,0],["وليتَ بني الدنيا فَنُكِّرَ مُنْكرٌ","وعُرِّفَ معروفٌ وأُصْلح مُفْسَدُ",24,"د",1,0],["ولَّيتَ لا مائلاً إلى دنسٍ","عمداً ولا عاثراً مع العَثره",25,"ر",2,0],["وليتَ التي تهوي إليها نَوازعاً","قلوبُ الورى واليعمُلات العرامس",26,"س",1,0],["وليتَ فوليت البلادَ وأهلها","صنائعَ لم ترك لغيرك مَصْنعا",27,"ع",2,0],["وُلِّيتَ أمراً فلا المُرعي أمانتَه","فيها مخونٌ ولا المرعيُّ معسوف",28,"ف",1,0],["وليتَ اللَّه يغفِرُ لي اشتطاطي","فقد جاز اشتطاط ذوي الأماني",29,"ي",1,0],["وليتَ الرياحَ الهوج في ذات بَيننا","بِما لا تَبُتُّ الكاشِحينَ بريدُ",30,"د",1,1],["وَّليت في إثر الشباب ومن يعش","بعد الشباب يعش بغير عماد",31,"د",1,0],["وَلِيتَ الأمر أقدرَ من يليه","تخاف الله فيه وترتجيه",32,"ه",1,0],["وَلَيتَ عَيني لَم تُفارِق رَقدَها","قُم نَبِّني يا بَنتَؤورُ ما دَها",33,"د",3,0],["وَلَيتَ الَّذي قاسَت مِنَ المَوتِ ساعَةً","كَما راحَ يَطوي الوالِدَينِ طَواها",34,"ا",3,0],["وَلَيتَ لَدى فُروقٍ بَعضَ بَثّي","وَما فَعَلَ الفُراقُ غَداةَ راعا",35,"ع",2,0],["وَلَيتَ عَينَ الَّتي آبَ النَهارُ بِها","فِداءُ عَينِ الَّتي زالَت وَلَم تَؤُبِ",36,"ب",1,0],["وَلَيتَ شَكاتَكَ في جِسمِهِ","وَلَيتَكَ تَجزي بِبُغضٍ وَحُب",37,"ب",1,0],["وَلَيتَكَ تَرعاني وَحَيرانُ مُعرِضٌ","فَتَعلَمَ أَنّي مِن حُسامِكَ حَدُّهُ",38,"د",2,0],["وَلَيتَ يَومي فَناءِ عَسكَرِهِ","وَلَم تَكُن دانِياً وَلا شاهِد",39,"د",1,0],["وُلِيَت مِنكُما بِنَيلٍ دِراكٍ","مُغدِقٍ وَبلُهُ وَسَيلٍ جُحافِ",40,"ف",1,0],["وَلِيَتني مِن سُلَيمانَ بِهِ","نِعمَةً مِثلُ السَحابِ المُدَّرِك",41,"ك",1,0],["وَلِيَت نَصرَهُ المَوالي فَأَعطَت","هُ عُلُوَّ السِماكِ أَو هُوَ أَعلى",42,"ل",2,0],["وَليتَهُمُ وَالأُفقِ أَغبَرُ عِندَهُم","وَجَوُّهُمُ عَن صَيِّبِ المُزنِ مُقفَلُ",43,"ل",1,0],["وَلَيتَ النَجاءَةَ لِلمُنصِفي","نَ تُرَجّى فَكَيفَ لِمَن يَظلِمُ",44,"م",1,0],["وَلَيتَني الشَمولُ فيها فِراكاً","بِيَدي مُرهَفٍ خَصيبٍ بَنانُه",45,"ن",2,0],["وَلَيتَ الَّذي وَلّاكَ يَومَ وَلَيتَهُ","وَلايَةَ وافٍ بِالأَمانَةَ صادِقِ",46,"ق",1,0],["وَلَيتَ ما جَمَعَت كَفّاكَ مِن نَشبٍ","يُنجيكَ مِن هَولِ ما إِن أَنتَ مُطَّلِعُ",47,"ع",1,0],["وَلَّيت قبلَ لقائنا يا جنتي","لم تطفري مني بقولٍ مسعدِ",48,"د",1,0],["وليتَ أنّا أصبنا","سعادةَ الجُهَّالِ",49,"ل",1,0],["وليتَ أنّا عرفنا","يوماً هدوءَ البالِ",49,"ل",1,0],["وليت في إثر الذين رثيتهم","وأقمتَ فيهم مأتمَ الأشعارِ",50,"ر",1,0],["ولّيتِ قبل لقائنا يا جنتي","لم تظفري مني بقول مسعد",51,"د",1,0],["وَلَّيتَ عَنّي فَدَمعُ العَينِ مُنسَجِمٌ","يَبكي التَلاقي وَماءُ القَلبِ مُنسَجِمُ",52,"م",1,0],["وَليتَ المُسلِمينَ فَلَم تُضَيِّع","أُمورَهُمُ الصِغارَ وَلا الكِبارا",53,"ر",2,0],["ولَّيْتمُ جاهلاً جريئاً","ألثغَ بالمسلمينَ ضارِ",54,"ر",1,1],["وليتَ أنَّ النسورَ استُنزفَتْ نَصفاً","أعمارُهنَّ ولم يُخصصْ بها أحد",55,"د",1,0],["وَلَيتَ طَهوري كانَ ريقَكِ كُلَّهُ","وَلَيتَ حَنوطي مِن مُشاشِكِ وَالدَمِ",56,"م",1,0],["وَلَيتَ سُلَيمى في المَماتِ ضَجيعَتي","هُنالِكَ أَم في جَنَّةٍ أَم جَهَنَّمِ",56,"م",1,0],["وَلَيتَ العاذِلاتِ غَداةَ بِنتُم","وَأَظهَرنَ المَلامَةَ لي فِداكِ",57,"ك",1,0],["وَلَيتَ مُخَبِّري بِالصَرمِ مِنكُم","عَلانِيَةً نَعانِيَ إِذ نَعاكِ",57,"ك",1,0],["وليتَ أمورَنا والخطبُ قاسٍ","نُعالجهُ ويأبى أن يلينا",58,"ن",2,0],["وليتك تُزجي كلّ يومٍ بشارةً","فقد طال ما بيني وبين البشائرِ",59,"ر",1,0],["وَلَّيتَ إِحلالي لَواحِظَ نائِمٍ","وَرَأَيتَ خَلّاتي بِلَحظِ مُؤَرِّقِ",60,"ق",1,0],["وَلَّيتُ لا آسى عَلى نائِلِ اِمرِئٍ","طَوى كَشحَهُ عَنّي وَقَلَّت أَواصِرُه",61,"ر",2,0],["وَليتَ تُراثَ الأَحوَصَينِ فَلَم يَضِع","إِلى اِبنَي طُفَيلٍ مالِكٍ وَعَقيلِ",62,"ل",1,0],["وَلَيتَكَ كُلَّما كَلَّمتَ غَيري","رُميتَ بِخَرسِهِ وَمَنَعتَ فاكا",63,"ك",2,0],["وَلَيتَ وَليداً ماتَ ساعَةَ وَضعِهِ","وَلَم يَرتَضِع مِن أُمِّهِ النُفَساءِ",64,"س",3,0],["وَلَيتَها لَم يَكُ مِن بَعدِها","خَوفُ حِسابٍ وَعِقابٍ بِنار",65,"ر",1,0],["وَلَيتَ شَيئاً وَأَبانا الَّذي","جاءَ بِنا أَهبَلَهُ المُهبِلُ",66,"ل",1,0],["وَلَيتَنا تُترَكُ أَجسادُنا","كَما يَزولُ السُمرُ المُحبِلُ",66,"ل",1,0],["وَلَيتَ نُفوسَنا وَالحَقُّ آتٍ","ذَهَبنَ كَما أَتَينَ وَما أَحَسنَه",67,"ن",2,0],["وَلَيتَ المَنايا ما تخرَّمْنَ دلبراً","وَغلْنَ سليمى فهي بالموت أَجدَر",68,"ر",1,0],["وليت شمسَك كل الدهر بازغة","تجلو العمى عن عيون ظَلن في الريب",69,"ب",1,0],["وَلَيتَهُمُ في كُلِّ ممسىً وَشارِقٍ","تُضاعفُ أَكبالٌ لَهُم وَقُيودُ",70,"د",1,0],["ولَيْتَ قِلاصاً مِلْعِراقِ خَلَعْنَني","جُعِلْنَ ولم يَفْعَلْنَ ذاكَ من الخَلْع",71,"ع",1,0],["وَلَيتَ خَيالاً مِنكِ يا عَبلَ طارِقاً","يَرى فَيضَ جَفني بِالدُموعِ السَواكِبِ",72,"ب",1,0],["وَلَيتَهُما ماتا جَميعاً بِبَلدَةٍ","وَأَخطاهُما قَيسٌ فَلا يُرَيانِ",73,"ن",1,0],["وَلَيْتَ أَمِيرَ الْعُرْبِ بِالْيُمْنِ دَوْلَةً","كَبَا جَدُّهَا دَهْراً فَأَعْلَيْتَهَا جِدَّا",74,"د",2,0],["وَلَّيتَ مصطحِباً قلوباً لاَ تَرَى","مِن بَعْدِك الصَّبْرَ الْجمِيلَ جمِيلاَ",75,"ل",2,0],["وَليِّتَ شَعْباً قَمِناً","بِالعَطْفِ وَالتَّفَضُّلِ",76,"ل",1,0],["وليتَ بمصرَ زمامَ القضاءِ","فما كنت في العدل إلا عُمر",77,"ر",1,0],["وليت الليلَ يغمرهُ دخاناً","وليت الصبحَ يُمطرُه التياعا",78,"ع",2,0],["وليت مُنىً يُراودها فِجاراً","تُعاوِده لتنهَشَه ضِباعا",78,"ع",2,0],["وليت ضميرَه يثب افتزاعا","من الذكرى وينتفِضُ التذاعا",78,"ع",2,0],["وليت العارَ يبرحُ مستضيفاً","سريرتَه اصطيافا وارتِباعا",78,"ع",2,0],["وليت امامَ عينيه احتراقاً","جَرىَ كالشمع حاضرهُ وماعا",78,"ع",2,0],["وليت خيالَ ماضيه مَسيخاً !","يَلوح على ملامحِه انطِباعا",78,"ع",2,0],["وليت من دجلةٍ كأساً تصفقه","امواجُها بالرحيق الصفْوِ ملآنا",79,"ن",2,0],["وليتك تحَسِبُ أزياءهم","فتجمعَ منها زهورَ الرُّبى",80,"ا",1,0],["وليتَ بهنَّ ولا غيرهنَّ","تَنَقَّلُ في غضبٍ أو رِضا",80,"ا",1,0],["وليتَ الفداء لكوخ الفقير","قصورٌ أنفَ بها المْترَفونا",81,"ن",2,0],["وَلِيَتْني الشَّمُولُ فِيها دِرَاكاً،","بيَدَيْ مُرهَفٍ، خَضِيبٍ بَنَانُهْ",82,"ن",2,0],["وليتَ فولّيت البلادَ وأهلها","صنائعَ لم تترك لغيرك مَصْنعا",83,"ع",2,0],["وليت اذا لم يمكن القرب منكم","قضيت اسى أو ليت لم يخلق الحب",84,"ب",1,0],["وَلَيتَ الَّتي عاصَيتُ فيها عَواذِلي","لَها قَبِلَت عَقلاً وَلَم تَحتَمِل دَمي",85,"ي",1,0],["وليتك إذهباً على القلب لم تهن","علينا ولكني على ذاك شاكر",86,"ر",1,0],["وليتني صيدحٌ يغني","في ظلك الوارف الأمين",87,"ن",1,0],["وليتني حمامةٌ","أصدح في ضوء القمر",88,"ر",1,0],["وليتق اللّه بي شعب وفيت له","حق الوفاء وبالنكران كافاني",89,"ي",1,0],["وليتق الله ربَّهُ فهو الخلاقُ","وليَعْتَبر بما سمعَهْ",90,"ع",2,0],["وَلَّيتَهُم ما تَوَلَّتهُ المُلوكُ لَقَد","أَبى اِعتِزامُكَ ما نالَت مِنَ الرُتَبِ",91,"ب",1,0],["وَلِيَت نُمَيرٌ نَصرَهُ وَرَبيعَةٌ","وَلَهُ مِنَ العَزمِ الوَحِيِّ جُنودُ",92,"د",1,0],["وَليَتبَعَنَّ رِضاكَ غَيرَ مُوارِبٍ","مَن في يَمينِكَ خَوفُهُ وَأَمانُهُ",93,"ن",2,0],["وَلَيْتَ بَعْدَكِ تسويد البَياضِ فَلي","بالدَّمْعِ في صُحُفِ الأَحْزانِ تَسْويدُ",94,"د",1,0],["وليت بالأقبال تدبيره","حتى نجى من ظلمة الحيرة",95,"ه",1,0],["ولَيتَ كَدرَ القَطا حَلَّقنَ بِى وبِها","دُونَ السَّماءِ فَنَخفَى فِى خَوافِيها",96,"ي",3,0],["وَلَيتَ كُدرَ القَطَا حَلَّقنَ بِى وَبِهَا","دُونَ السَّماءِ فَعِشنا فى خَوَافِيهَا",97,"ي",3,0],["وَلَيتَ أَنِّي وَإِيّاهَا عَلَى جَبَلٍ","فى رَأسِ شَاهِقَةٍ صَعبٍ مَرَاقِيهَا",97,"ي",3,0],["وليتَ بحارَ الجوادِ إذ غاضَ ماؤُها","تدومُ لنا تلكَ العِهاد الصَّوائب",98,"ب",1,0],["وليتني كنتُ ثوباُ","وكنتُ ألمسُ قدَّكْ",99,"ك",1,0],["وليتَ طيفكَ عندي","وليتَ طيفيَ عندكْ",99,"ك",1,0],["وليتني إذ يئست منكم","كبحت في غربتي شجوني",100,"ي",1,0],["وليت فتاةً أتلفتني بحبهَا","تموتُ ونُطوى في ضريحٍ فَنُصْرَعُ",101,"ع",1,0],["ولَيتَ كوبي","يا لَيلُ يَبقى",102,"ق",2,0],["وَلَيتَكَ إذ ناضَلتَ عن مصرَ لم تُفِض","مع الحِبرِ قلباً يعلمُ اللَهُ غالِيا",103,"ي",2,0],["وَليتبعنَّ القَلبَ فيكَ مِنَ الأَسى","بِأَوائِلٍ مَوصولَةٍ بِأَواخِرِ",104,"ر",1,0],["وَلَيتَ الدَهرَ إِذ لَم يُمسِ سِلمي","عَلى أَحداثِهِ لَم يُمسِ قِرني",105,"ي",1,0],["وَلَيتَ غَريمي في الهَوى وَهوَ واحِدٌ","تَحَرَّجَ مِن لِيّانِهِ فَقَضاني",106,"ي",1,0],["وَلَيتَكَ لَم تُعَرِّضها لِذَمٍّ","إِذا كانَت تَقِلُّ عَنِ المَديحِ",107,"ح",1,0],["وليته ما شبَّ في زُخرِفٍ","يبكي يد الدهرِ على رَغده",108,"د",2,0],["وليتَها أصمت فما أبتغي","من عيشها إن أنا لم أقتلِ",109,"ل",1,0],["وليتَ عيناً فيه قد كحِلَت","بِمَسَّرةٍ لم تَخلُ من رَمَدِ",110,"د",1,0],["وَلَيتَكَ لَم تَجِد فَعَقلتُ شِعري","إِلى مَن عِندَهُ الخَيرُ الكَثيرُ",111,"ر",1,0],["وليت لحية من لا","يهواك في جوف حجري",112,"ي",1,0],["وليت الأماني كالمنايا سريعة","بنا والنوي لو كان ظبيا مشنفا",113,"ف",2,0],["وليت سلو الحب سالم صبَّه","وإن لم يرق في الحب سلم المحارب",114,"ب",1,0],["وليتَهم أسمعونا من هُناكَ صدى","لِكي نقوِّي هُنا آمالَنا بهم",115,"م",1,0],["وَلَيتَ عيني تَرى بنجدي","روضا تَناغَت به الغيوم",116,"م",1,0],["وَلَيت زمان الوصل ارخى عنانه","فتبلغني الآمال غاية مقصدي",117,"ي",1,0],["وَلَيْتَ الرِّياحَ الرّائِحاتِ خَوالِصٌ","إِلَيَّ وَلَوْ لاقَيْنَ قَلْبِي بِكَرْبِهِ",118,"ب",2,0],["وَلَيْتَ سُقْمِي الَّذِي فِي الْحالِ مِنْ عَدَمِي","أَحَلَّهُ الدَّهْرُ مِنِّي الرُّوحَ وَالْجسَدَا",119,"د",2,0],["وَلَيتَ نَفسي تَقيكَ كُلَّ أَذىً","تَشكو وَلَو شَعرَةً عَلى قَلَمِك",120,"ك",1,0],["وَليتَ قَلبي فَجُرتَ فيهِ","ما هَكَذا تَفعَلُ الوُلاةُ",121,"ه",1,0],["وليَترُكِ الشِكايَه","وَيكتُم النِكايه",122,"ه",1,0],["وَلَيتَني لَم أَنَم لَيلي الطَويلَ وَلا","ظَلَمَت سُنَّةُ مَن أَحيا الظَلامَ إِلى",123,"ل",2,0],["وَلَّيتَهُ عَهدَ الأَنامِ وَأَمرَهُم","فَدَمَغَتَ بِالمَعروفِ رَأسَ المُنكَرِ",124,"ر",1,0],["وليتنا ما جهلناها وما جمعت","من الحلول لابعاد الظلامات",125,"ت",1,0],["وليتَني طائرٌ شَهيٌ","أشْدو بأنغامِ عَنْدَليبِ",126,"ب",1,0],["ولَيتَني جَدوَلٌ تَهادىِ","ما بَيْنَ زَهْرٍ وبينَ طيبِ",126,"ب",1,0],["ولَيتنا زَهْرَتانِ نَهفو","على شَفا جَدْوَلٍ لَعوبِ",126,"ب",1,0],["وَلَيتُكَ وَاِعدتهم عودة","وَهيهات هَيهات ما يوعَدون",127,"ن",1,0],["ولي تَفاصيلُ أوطارٍ بَقِينَ فقُمْ","بها عَليُّ كما قد قُمْتَ بالجُمَل",128,"ل",1,0],["وَلَّيْتَ وقلتَ أنعَمَ اللهُ مَساكْ","مَولايَ وهل يَنعَمُ مَن ليس يَراك",129,"ك",1,0],["وَلِيتُ بأرْجانَ القضاءَ ولم أكنْ","عرَفْتُ بها أنّ الخُطوبَ شُهود",130,"د",1,0],["وَلَيتَ أَغرِبَةً لِلبَينِ ما وَقَعَت","وَلَيتَ أَغرِبَةً لِلَّيلِ لَم تَصِرِ",131,"ر",1,0],["وَلَيتَهُ أَعلَنَ أَشجانَه","فَيَحمِلُ الإِعلانُ أَشجانَه",132,"ن",2,0],["وليتني كنت له فادياً","دون مواليه وأصحابه",133,"ب",2,0],["وَليتَ المَرءَ يَسعى طَ","لَبَ الفَضلِ أبا الفَضلِ",134,"ل",1,0],["ولَيتَها لا تَنالُهُ أَبداً","إِلا بِما نالَها مِن العِلَلِ",135,"ل",1,0],["ولَّيتُه في الهَوى قَلبي فَفارَقَني","وما نَهى قطُّ في قَلبي ولا أَمَرا",136,"ر",2,0],["وَلَيتَ عَيني لَم تُبصر مَحاسِنهُ","فَمَصرَعي كانَ بَينَ السحر وَالوَسَن",137,"ن",1,0],["وليتك خفت ذنبك","كهم من خوف حسنات",138,"ت",1,0],["وليتك في صلاتك","كهم في حال عادات",138,"ت",1,0],["وليت قضاء المسلمين بصولة","تذيب بها من كان أقسى من الصلد",139,"د",1,0],["ولْيُتْبعِ البِرَّ القدي","مَ بصَفْوِبِرٍّ كالسُّلافِ",140,"ف",1,0],["وَلَيتَ التأسي بِالمُصيبَةِ كائِنٌ","كفافاً فَلا يُسلي هُناك وَلا يُغري",141,"ر",2,0],["وليتَني أشكو الى عاذرٍ","أو ليتَني أشكو من العاذلِ",142,"ل",1,0],["وليت شِعْرِيَ إِذْ لاما وشِعْرَهُما","أَفِي السُّوَيدَاءُ من قَلْبِي ومن عَيْنِي",143,"ن",2,0],["وليتي كنت أعلم كيف حالي","بحيث حثا عليه الترب حاث",144,"ث",1,0],["وليتك مقبور بإنسان مقلتي","لتمسي كما تضحي حذا نظرات",145,"ت",1,0],["وليت بدمعي كان بالأمس غسله","وليت بذاك العطر سبط جسيد",146,"د",1,0],["وليت قد علمت ما","أشعر عند هبتي",147,"ي",1,0],["وليت صقر قريش ظل مختبئ","يلهو به الهم أو يلهو به الطرب",148,"ب",1,0],["وليتك تدركين مدة هيامي","وأشواقي إليك فتنقذيني",149,"ن",2,0],["وليتَ لنا شأنا بها في مبيتنا","يَعودُ على قَصْدِ الخلاعة بالعُذْر",150,"ر",1,0],["وليتَ الليالي بعد أن قد ولدنكم","عَقمنَ فلم تُنجِب لهنّ بطونُ",151,"ن",1,0],["وليت ونابل الأيام رامٍ","يصيب بنا المنى أيام رامهْ",152,"م",2,0],["ولي تابعاً لك يوم الفخا","ر من باب مجدهِمُ مدخلُ",153,"ل",1,0],["وليتْ سيوفُ البرق قطعَ عروقها","فبكلِّ فجٍّ شاريانٌ سائلُ",154,"ل",1,0],["ولِيَتْ خلقَ ثوبها يدُ رَبٍّ","لم يفته التغريب والتدقيقُ",155,"ق",1,0],["وَلِيتَ بصُغْرَى عزمتيك كبيرَها","كما دبَّرتْ نزعَ القناةِ الأصابعُ",156,"ع",1,0],["ولَيتَ الزمانَ المطربي باقترابكم","كما زال سُكْرٌ منه زال خُمارُ",157,"ر",1,0],["وليتكُمُ جيرانُ عوفٍ تلقَّنوا","خلالَ الندى والجودِ من آل مَزيَدِ",158,"د",1,0],["ولَيتَ دمي ما سَقَى الأرضَ منك","يقوتُ الرَّدَى وأكون الرَّدِي",159,"ي",1,0],["وليتَ سَبقتُ فكنتُ الشهيدَ","أمامَك يا صاحبَ المَشهَدِ",159,"د",1,0],["وليتِك إذ نحلتِ نحولَ جسمي","بقِيتِ على النحول بقاءَ عهدي",160,"ي",1,0],["ولَيتَ أنَّ كمالَ المُلكِ خالصةٌ","آراؤه لي ورأيُ الناسِ مؤتَشبُ",161,"ب",1,0],["ولَيتَ بِساطَ الأرض بيني وبينه","طوتْه على الأعضادِ أيدي الركائبِ",162,"ب",1,0],["ولَيتَ طريفَ الودّ بيني وبينه","وإن طابَ يوماً لم يكن من مَكاسبي",162,"ب",2,0],["ولَّيْت أمر الرعايا حازِماً يقظاً","خِرقاً عليماً فمات الجهل والعدمُ",163,"م",1,0],["وليتَها والبلادُ مُجْدِبَةٌ","مُغْبَرَّةٌ صُبْحُنَّ إِظْلامُ",164,"م",1,0],["وَلَّيتَ أَمر غَضَباً حائِراً","فَفيمَ لا تَعزِلُهُ بِالرِضا",165,"ض",2,0],["وليت نشيدها وجلوت منها","على الأسماعِ أبكار النقابِ",166,"ب",1,0],["وليت الأُسْدَ قد علِمتْ بجيلٍ","يسوسُ أمورَه بالموءِ هرُّ",167,"ر",1,0],["وليت الوُلْدَ كالآباءِ ذوقاً","وليتَ اليومَ كالأمسِ المغادرْ",168,"ر",1,0],["وليت الحيَّ حرٌّ كالخيالِ","أوِ الحُلْمِ أوِ الوهْمِ المُسافرْ",168,"ر",1,0],["وليتَ والدَكَ المرحومَ يشهدُ ما","منكَ الحُضورُ رَواهُ حالَ غَيبتِهِ",169,"ت",2,0],["وليت أن نفوس الناس إذ قعدت","عن القيام بنعماهم بما يجب",170,"ب",1,0],["ولي تحت دار الملك يومان لم تلح","لعيني علامات الكرامة والبشر",171,"ر",1,1],["وليتك ممن أطلع الشرق مطلعي","لتعلم نبعي إن عجمت وخروعي",172,"ع",2,0],["وليت إذا رأت عينا","ي طفلاً لا تساقبني",173,"ي",1,0],["وليت إذا وعت أذني","حديثاً لا يصاحبني",173,"ي",1,0],["وليت الموت عاجلني","وليت الدهر أهلكني",173,"ي",1,0],["وَلَيتَني مِنكَ القَفا وَالكاهِلا","اخلُقا شَكسا وَلَوناً حائِلا",174,"ل",2,0],["وَلِيتُ الْحُكْمَ فَوْقَ الأَرْبَعِينا","وَذَاكَ النِّصْفُ مِنْ عُمْري يَقِينا",175,"ن",2,1],["وَلِيتُ الْحُكْمَ خَمْساً وهْيَ خُمْسٌ","لِعُمْرِي والصِّبا في الْعُنْفُوانِ",176,"ن",1,1],["وليتَه مَنَّ بوصلِ حَبْلِهِ","على قلوبٍ لم تُطِقْ حَمْلَ المِنَنْ",177,"ن",1,0],["ولَيتَهُ إذْ تحامى أن يُنَوِّلنا","لَم يستردّ الّذي قد كان أعطانا",178,"ن",2,0],["ولَيتَهمُ وحسبي ذاك منهمْ","دَرَوْا أنّي لفرقتهمْ حَزينُ",179,"ن",1,0],["وليت ثرائي من شبابٍ تعجّلتْ","بشاشتُهُ عنّى تأبّد عُدْمُهُ",180,"م",2,0],["وليتكُمُ لمّا تركتمْ حقوقَها","رَجعتمْ إلى عرفانِ بعض المعارفِ",181,"ف",1,0],["وَلَيتَ بَياضاً أراد الرّحيلَ","عقيب الزّيارة ما كان زارا",182,"ر",2,0],["وليتك لم تحلُلْ رِكابُك عَقْوَتِي","تُراوِحها صبّاً بِها وَتغادِي",183,"ي",1,0],["وليت أدْمَ المَهارَى النّاهضات بما","تحوِي الهوادجُ كانت رُزَّحاً طُلُحا",184,"ح",2,0],["وَلَيتَني لَم أَكُنْ يوماً عرفتكُمُ","وَكُنتُ مِنكُمْ بعيدَ الدّار مُنتَزِحا",184,"ح",2,0],["وليته في ربه هكذا","والناس أشكال وأشباه",185,"ا",2,0],["وليتهم يا رب خير أهلكا","وخير من بلوته في أمركا",186,"ك",2,0],["وَلَيْتَ أَنّي لَمْ أُدْفَعُ إِلى زَمنٍ","ألقى الأسُودَ بِهِ طَوْعَ الأَرانيبِ",187,"ب",1,0]]}