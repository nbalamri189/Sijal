spx?id=177506",""],[161,"وَجهُ المرآة","https://www.poetsgate.com/ViewPoem.aspx?id=204621",""],[6052,"بطاقات حمراء من غزة","https://www.poetsgate.com/ViewPoem.aspx?id=47578",""],[6100,"الصمان","https://www.poetsgate.com/ViewPoem.aspx?id=52551",""],[6102,"هوان هوى","https://www.poetsgate.com/ViewPoem.aspx?id=185303",""],[549,"الفارس والصهيل المكسر","https://www.poetsgate.com/ViewPoem.aspx?id=203001",""],[5724,"ربيعك للروح كالبلسم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55133&r=&rc=0",""],[159,"أَمَغْنَى الهَوَى غالَتْكَ أَيدي النِّوائِبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26937&r=&rc=8",""],[406,"أما لهذا الليل من آخر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63269&r=&rc=73",""],[463,"أيوما مثلَ يوم الجز","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60308&r=&rc=364",""],[6260,"البطل الشهيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68318&r=&rc=9",""],[454,"صباحك عيد مشرف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82682&r=&rc=46",""],[6290,"فَأَيّامُنَا تَغْدُو جَمِيعًا نُفَمْبَرًا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85153&r=&rc=18",""],[6359,"نخلة الوادي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69091&r=&rc=5",""]],"verses":[["تَحَرَّيتُ أَعجازَها بِالسِياطِ","فَخاضَت صُدورَ الأُمورِ الصِعابِ",0,"ب",1,0],["تَحَرَّقُ مِنكَ قُلوبُ العُدا","ةِ غَيظاً وَأَنتَ ضَحوكٌ قَطوبُ",1,"ب",1,0],["تَحَرَّجتِ أَن تَصِلي في الصِيا","مِ تَقوى وَرُمتِ لَقَتلي مَراما",2,"م",2,0],["تحرّكَتِ الأجْيالُ واشْتَعَلَ الفَلا","وزُلْزِلَ منْ هَذي البَسيطةِ وادِعُ",3,"ع",1,0],["تحرّر نظمه معنًى ولفظاً","فيا لله من بردٍ محرّر",4,"ر",1,0],["تحرِّم الماء من نجاستها","فهْي يد الدهر كله ذَفره",5,"ر",2,0],["تحرّوا في فَكاكِ الأسر عنّي","تحرّيَ مثلكم في فكّ مثلي",6,"ل",2,0],["تَحَرَّزَ مِنهُ أَهلُ عانَةَ بَعدَ ما","كَسا سورَها الأَعلى غُثاءً مُنَضَّدا",7,"د",2,0],["تَحَرَّك أَبا الهَولِ هَذا الزَمانُ","تَحَرَّكَ ما فيهِ حَتّى الحَجَر",8,"ر",1,0],["تَحَرَّجَ عَن حَقنِ الدِماءِ كَأَنَّهُ","يَرى قَتلَ نَفسٍ تَركَ رَأسٍ عَلى جِسمِ",9,"م",1,0],["تَحَرَّزتَ بِالهِجرانِ حِصناً مِنَ الهَوى","أَلا كانَ ذا مَن قَبلِ أَن تُمرِضَ القَلبا",10,"ب",2,0],["تَحَرّيها إِلَيهِ وَحَيثُ تَنأى","بِشَقِّ النَفسِ تَرهَبُ أَن يُضارا",11,"ر",2,0],["تُحَرِّكُ قَيسٌ في رُؤوسٍ لَئيمَةٍ","أُنوفَن وَآذاناً لِئامَ المَصالِمِ",12,"م",1,0],["تَحرَّجَ أن يَظْمَا القَنا فأعادَه","برُغمِ الأعادي قانئ اللَّونِ ناهِلا",13,"ل",2,0],["تَحَرَّز مِن الدُنيا فَإِنَّ فَناءَها","مَحَلُّ فَناءٍ لا مَحَلُّ بَقاءِ",14,"ا",2,1],["تحركي وسكوني عن إرادتها","كأنّ روحَ هواها مالكٌ بدني",15,"ن",2,0],["تُحرِّقُ بالنّارِ أحشاءَهَا","فتدمعُ مقلتها بالذهب",16,"ب",1,0],["تحرَّكَ البيتُ حَتَّى لو تُطاوعُهُ","أركانُهُ حَفَّ يَلْقَى رَكبَهُ شَغَفَا",17,"ف",2,0],["تَحَرِّكُ لِلفَخارِ زُبانَيَيها","وَفَخرُ الخُنفُساءِ مِنَ الصَغارِ",18,"ر",1,0],["تَحَرَّجي بِالهَوى إِن كُنتِ مُؤمِنَةً","بِاللَهِ أَن تَقتُلي نَفساً بِلا قَوَدِ",19,"د",1,0],["تحررت لما شئت أَن تتحرري","وَلَيسَ على حال يَليق بك الأسر",20,"ر",1,0],["تحررتِ الشعوبُ فكلُّ شعبٍ","طليقٌ والمجال اليوم رَحْبُ",21,"ب",1,0],["تحركت سواكن الأقدار","واطردت عوامل الأكدار",22,"ر",1,0],["تُحَرِّكُ دَائِباً قَلَماً","عَلَى قُرْطَاسِهِ يَجْرِي",23,"ر",2,0],["تحرّش الذئاب بالأغنام؟","«روما» تهز صفحة الحسام",24,"م",1,0],["تحركت الأجبال واشتعل الفلا","وزلزل من هذي البسيطة وادع",25,"ع",1,0],["تَحرَّكَ الَلحدُ وانشقَّت مُجدَّدةً","أكفانُ قَومٍ ظنَّنا أنَّهم قُبِروا",26,"ر",3,0],["تحرّقَ كاسٍ إلى عُريهِ","وأُغرم عارٍ به فاكتسى",27,"ا",1,0],["تحررتِ البلادُ سوى بلادٍ","ذُيولٍ شانهن الالتحاق",28,"ق",1,0],["تحرّ إذا صادقتَ مَن رُدُّه مَحض","يُصان لديه المال والدين والعِرض",29,"ض",1,1],["تحرك بسيف أحمدي وخد به","رقاب العدا وافتك بهم فتك غضبان",30,"ن",1,0],["تَحَرَّزَ المَجدُ حَتّى قالَ طالِبُهُ","أَماتَهُ الدَهرُ أَم أُمّاتُهُ عُقُمُ",31,"م",1,0],["تَحَرَّكَ طِفْلُ الغُنْجِ في مَهْدِ طَرْفِهِ","فَأَجْفانُهُ مُسْتَيْقِظَاتٌ هَوَاجِعُ",32,"ع",1,0],["تَحَّرك طفلُ التِّيهِ في مَهْدِ طرفِها","إِذا اكتحلتْ بِالغُمْضِ عَينُ المُراقِبِ",33,"ب",1,0],["تحرِّمُهُ عاماً وعاماً تُحلّهُ","ومن بات ما ينهاك عنهُ نِدام",34,"م",1,0],["تُحَرّكها الصَّبا فتَخالُ فيها","بحارَ دمٍ يُموِّجها انْصِبابُ",35,"ب",1,0],["تحري المقادير عن تقدير مالكها","وليس يرزؤها من عاش أو هلكا",36,"ك",2,0],["تحرمُ عيني ما لعينيكِ مثلما","تَجَنَّبُ مولاها العبيدُ تحاشيا",37,"ي",2,0],["تُحرّمني وصلا عليّ محلّلا","ولا رَاعها واشٍ لجوجٌ وحاسِدُ",38,"د",1,0],["تَحَرَّكَ اللَيلُ وَقالَ الخَيال","من لَيسَ يَبكي في اللَيالي الطِوال",39,"ل",1,0],["تَحَرَّشَ بِالوَغَى دَهْراً فَدَهْراً","لِجَاحِمِها المُؤَجَّجِ فِي صُلِيِّ",40,"ي",1,0],["تَحَرَّى وَلِيُّ العَهْد فِيه سَبيلَهُ","يُقَاسِمُه أعبَاءَها ويُشَاطِرُ",41,"ر",1,0],["تَحَرّانِي الزَّمانُ بِكُلِّ خَطْبٍ","وَعانَدَنِي الْقَضاءُ بِغَيْرِ ذَنْبِ",42,"ب",1,1],["تُحَرِّقُنِي بِنارِكَ مُؤْذِناً لِي","بما أَنا فِيكَ يَوْمَ الْبَيْنِ لاقِ",43,"ق",1,0],["تُحَرِّمُ الوَصلَ وَلَكِن تَرى","سَفكَ دَمِ العُشّاقِ عَمداً حَلال",44,"ل",1,0],["تحريرها نسج الحري","ر ونظمها سبك الذهب",45,"ب",1,0],["تحر علم وطور حلم منيف","وملاذ للضعفا والأرامل",46,"ل",1,0],["تحرك الى المطلوب ما دمت طالبا","أتى الرى فورا من تحرك عطشان",47,"ن",1,0],["تُحرّرُ لِلقربى منَ اللّه وحدهُ","رقاباً غَدَت في ربقةِ الأسر كالعبدِ",48,"د",1,0],["تَحَرَّقَ كُلَّ حاسِدٍ","بِما أَتَيتَ كافِرُ",49,"ر",1,0],["تَحَرَّ مِنَ الطُرقِ أَوساطَها","وَعَدِّ عَنِ الجانِبِ المُشتَبِه",50,"ب",2,1],["تَحَرَّجَ مِن رَدِّ الجَوابِ لِإِثمِهِ","فَلا تَعدَمَنكَ النَفسُ ما قَتلُها إِثمُ",51,"م",1,0],["تَحَرَّجُ عَن وَصلي مَخافَةَ إثمِها","فلا تَحرَجي إنَّ الصدودَ هو الإثمُ",51,"م",1,0],["تحريكُ ساكنِها الخفي أخفُّ من","تسكين ما حرَّكته من ساكنِ",52,"ن",1,0],["تحرم به وتقف عرفات بعد ليال","تسع مضت شهر ذي الحجه بعيد الزوال",53,"ل",1,0],["تحرِّمُ وَصْل من يهواك ظُلماً","وتَبْخَلُ فيه حتَّى في خيالك",54,"ك",1,0],["تحرَّوْا بني عمّنا في الأُمور","وراعوا عواقبها وانظروا",55,"ر",3,0],["تحرّك ذات الطوق وجدي وطالما","تبيت على فينانة البان تسجع",56,"ع",1,0],["تحرَّينا السرور وَرُبَّ رأيٍ","أرادَ الخِطْءَ فاحتمل الصوابا",57,"ب",2,0],["تحررنا من عجزنا وخمولن","وتبعث فينا العزم وهو جديد",58,"د",1,0],["تحرّش ثم جرَّبكم","لينقُلَ غيرَ ما 