 ما وَضَعتُ زِمامَهُ","مُنيفٌ بِهِ الهادي إِذا اِحتُثَّ ذامِلُ",8,"ل",1,0],["دَلَّ عَلى مَعروفِهِ وَجهُهُ","بورِكَ فيهِ هادِياً مِن دَليل",9,"ل",1,0],["دَلَّتْ مَهَارَتُهَا خُبْراً وَمَعْرِفَةً","عَلَى التَّفَوُّقِ فِي خُبْرٍ وَعِرْفَانِ",10,"ن",1,0],["دَلَّتْ عَلَى قُوَّةٍ فِيهَا صَلابَتُكُمْ","تَذُودُ عَنْهَا الأَشِدَّاءَ المَقَاحِيمَا",11,"م",2,0],["دَلَّيتَني بِغُرورِ وَعدِكَ في","مُتَلاطِمٍ مِن حَومَةِ الغَرَقِ",12,"ق",1,1],["دَلاَلُكِ الحُلو والمشهِّى","وَلَيسَ سَرِّيكِ بالمُضّاعِ",13,"ع",1,0],["دلعت ألسناً من النار حُمراً","ويلَ من قد غدا بها مَلحوسا",14,"س",2,0],["دلفاً من الشرف التليد","إيك بالرِّفد الموافر",15,"ر",1,0],["دَلّوكَ غَدراً وَهُم فيها أُلو خُلُفٍ","وَأَنتَ ضَيمٌ لَها في الدارِ مُحتَبَسُ",16,"س",1,0],["دَلّاهُمُ بِغُرورٍ ثُمَّ أَسلَمَهُم","إِنَّ الخَبيثَ لِمَن والاهُ غَرّارُ",17,"ر",1,0],["دلَّت مناقبهُ على أنسابهِ","وحَماهُ عن تسآل مَن لألاؤه",18,"ا",3,0],["دلَّ العلاء على إيضاح سؤددكم","دلالةَ القبسِ الموفي على نشز",19,"ز",1,0],["دليل الحشا لما نظرتَ قتلته","بأضعف قرن في أذلِّ مكان",20,"ن",1,0],["دلفي يوم الفخار يجلى","وبه منهم الخطوب تجلَّى",21,"ل",2,0],["دَلالٌ يا مُحَمَّد مُستَعارُ","دَلالٌ بَعدَ أَن شابَ العَذارُ",22,"ر",1,1],["دَلَفْتَ إليه فاستبحتَ حَرِيمَهُ","بجيشٍ لُهامٍ كالمدود الزَّوائدِ",23,"د",1,0],["دلوا على باطن الدنيا بظاهرها","وعلم ما غاب عنهم بالذي شهدُوا",24,"د",3,0],["دلَّت معالمُها على أغفالها","فعرفتُ دارسَها بما لم يدرس",25,"س",1,0],["دلفوا لجارِهمُ بشرٍّ لازمٍ","وتجانفوا عنه بخيرٍ مائطِ",26,"ط",1,0],["دلفنا لها بالسمهريّ فطالعٌ","إلى مصرعٍ يرتاده ومُحَرْجمُ",27,"م",1,0],["دلَّهتك اثنتانِ عن فهم شعري","خوفُ أن تُجتَدى وخوفُ الهزيمَهْ",28,"م",2,0],["دَلَفتُ لَهُ تَحتَ الوَغى بِمُرِشَّةٍ","مُسَحسِحَةٍ تَعلو ظُهورَ الأَنامِلِ",29,"ل",1,0],["دَلَّهَتني وَحَمَيتِ جَفني غَمضَهُ","لا يُستَطاعُ مَعَ الهُمومِ هُجودا",30,"د",2,0],["دَلَفتُ لَهُم بَعدَ الأَناةِ بِخَطَّةٍ","تَرى القَومَ مِنها يَجهَدونَ التَفادِيا",31,"ي",2,0],["دَلَّني أَنَّكَ في الخُل","صان مَعقودٌ بِخِنصَرْ",32,"ر",1,0],["دَلَّهَت مِصراً وَلَو أَنَّ بِها","فَلَواتٍ دَلَّهَت وَحشَ فَلاها",33,"ا",3,0],["دَلَّهتِهِ بِعَزيزٍ في مَحاجِرِهِ","ماضٍ لَهُ مِن مُبينِ السِحرِ جَفنانِ",34,"ن",1,0],["دَلَّت عَلى مَلِكِ المُلوكِ فَلَم تَدَع","لِأَدِلَّةِ الفُقَهاءِ وَالأَحبارِ",35,"ر",1,0],["دَلهَمِيٌّ إِذا اِدلَهَمَّ دُجى الخَط","بِ كَفَت فيهِ شُعلَةٌ مِن وُقودِه",36,"د",2,0],["دَلَفتَ مُستَنصِراً بِاللَهِ مُنتَصِراً","لِلَّهِ غَيرانَ تَحمي دينَهُ أَنِفا",37,"ف",2,0],["دَلائِلُ مَكنونٍ مِنَ الوَجدِ لاعِجِ","وَسُحُّ دُموعِ العَينِ أَقوى الدَلائِلِ",38,"ل",1,0],["دَلَّت عَلى رَأيِ الإِمامِ وَأَنَّهُ","قَلِقُ الضَميرِ لِما أَصابَكَ جازِعُ",39,"ع",1,0],["دَليلُكَ أَنَّ الفَقرَ خَيرٌ مِنَ الغِنى","وَأَنَّ القَليلَ المالِ خَيرٌ مِنَ المُثري",40,"ي",1,1],["دَلَفتُ إِلَيهِم بِالصَفائِحِ وَالقَنا","عَلى كُلِّ لَيثٍ مِن بَني غَطفانِ",41,"ن",1,0],["دَلَّت زَخارِفُهُ الخَليفَةَ أَنَّهُ","ما كُلُّ عودٍ ناضِرٍ بِنُضارِ",42,"ر",1,0],["دَلوحانِ تَفتَرُّ المَكارِمُ عَنهُما","كَما الغَيثُ مُفتَرٌّ عَنِ البَرقِ وَالرَعدِ",43,"د",1,0],["دَلَّ عَلَى مَعْدِنِهِ فَضْلُهُ","دَلالَةَ التِّبْرِ عَلَى الْمَنْجَمِ",44,"م",1,0],["دليلُ ذلكَ قولُهُ","وآخرون اعترفوا",45,"ف",3,0],["دَلَّ الفُؤادَ عَلَيها بَعضُ نِسوَتِها","وَنَظرَةٌ عَرَضَت كانَت مِنَ القَدَرِ",46,"ر",1,0],["دَلَّهَتني وَالجيدُ مِنها كَلَيلى","وَالحَشا وَالبُغامُ وَالعَينانِ",47,"ن",1,0],["دَلَفَ الفَوارِسُ في لِوائِكِ حُسَّراً","وَمَضوا رَعيلاً لِلوَغى فَرعيلا",48,"ل",2,0],["دَلَّهُ منكم عليكم رَجُلٌ","خَشِيَ القتلَ وخافَ العَطَبا",49,"ب",2,0],["دَلَفتَ تَمشي على الأشلاءِ مُقتحماً","والقومُ مُنجدلٌ في إثرِ مُنْجَدِلِ",50,"ل",1,0],["دَليلكم الصّدقُ فيما مَضَى","يَشُقُّ الصّعابَ ويَهدِي الزُّمَرْ",51,"ر",1,0],["دَلَفَ القومُ بالمصاحفِ لا يَدْ","رُونَ ماذا يُريدُ أن يَسْتَبينا",52,"ن",2,0],["دَليلُ السُّوءِ لا عَقلٌ حَصِيفٌ","يُسَدِّدُه ولا رأيٌ أصيلُ",53,"ل",1,0],["دلفت قرومُ محمدٍ في شأنها","تلقى بِيَثْرِبَ من ذويه قروما",54,"م",2,0],["دلَفوا إليه وظَنَّ أكذبُهُم مُنىً","أنْ قد سَقَتْهُ يداه كأسَ حِمامِهِ",55,"م",2,0],["دَلَلْتَ عَلَى الهَوَى قلبي فَسَهْمِي","وَسَهْمُكَ في الهَوَى كلٌّ مُصيبُ",56,"ب",1,0],["دَلوحاً إذا ما شِمتَهُ افتَرَّ وَبْلُهُ","وإرْهامُهُ سَحّاً عليكَ ورَيّقُه",57,"ق",2,0],["دَلَّت بِغَدرٍ وَقُرونُ الفَتى","تَهتَزُّ بِالكَشخِ عَلى راسِهِ",58,"س",2,0],["دَلَفنا إِلى الضَحّاكِ نَصرِفُ بِالرَدى","وَمَروانُ تَدمى مِن جُذامَ مَخالِبُه",59,"ب",2,0],["دَلّاً عَلَيَّ وَعادَةً سَبَقَت","أَن سَوفَ إِن أَغضى أُعاتِبُهُ",60,"ب",2,0],["دَليلُ ذَلِكَ أَنَّ الحُرَّ أَعوَزَهُ","قوتٌ وَأَنَّ سِواهُ فازَ بِالمالِ",61,"ل",1,0],["دلاصٌ كظهر النون ما يستطيعها","سنانٌ ولا تلك الحظاء الدواخل",62,"ل",1,0],["دل أن لَيسَ كائناً فيه ماءٌ","ما تَرى في سَمائه من صفاء",63,"ا",2,0],["دَلُوقُ السُّرَى يَنْضُو الهَمَالِيجَ مَشْيُهَا","كَمَا دَلَقَ الغِمْدُ الحُسَامَ المُهَنَّدَا",64,"د",2,0],["دلائِلُ مُشْفِقٍ يَخْشَى ضَلالاً","وكيف يُخافُ عن قَمَرٍ ضَلال",65,"ل",1,0],["دَلَّتْ عَلَى فَضْلِهِ آثارُ حِكْمَتِهِ","وَكُلُّ شَيءٍ لَهُ مِنْ نَفْسِهِ أَثَرُ",66,"ر",1,0],["دَلَّتْ بِقُدْرَتِهَا عَلَى","فَضْلِ الْوِفَاقِ وَالاتِّحَادْ",67,"د",1,0],["دَلَّ اسْمُهَا دَلاَلَةَ اسْمِ العُطْرِ","عَلَى جَمَالِ نَوْعِهِ فِي الزَّهْرِ",68,"ر",1,0],["دلَّسَ للناس أحاديثَه","واللَه لا يقبلُ تدليسا",69,"س",2,1],["دَلَّلْتُم الكلب حتى كاد سادتُكم","يدعونه: ملكًا، أو إمْبراطورا",70,"ر",2,0],["دليلهم يهوي بهم في مضلة","وهم خلفه عمش العيون وعور",71,"ر",1,0],["دلَّ أن الرخاء مغتبطٌ بي","فبحق تبجُّحي وانتخاء",72,"ا",2,0],["دَلَيْتَ دَلْوَ اٌلمَنَايَا فِي نُفُؤسِهُمُ","فَأَغْرَقَتْهَا إِلى اٌلأَكْرابِ واٌلْوَذَمِ",73,"م",1,0],["دلّلت محنتها بسحر قصائدي","أيّام يستحذي الكميّ فيطرق",74,"ق",1,0],["دليل المصلين الكرام وسيلة ال","ملبين هادي كل داعٍ وصائم",75,"م",1,0],["دليل عشيرتي في أي أمرِ","وقدوة جيرتي في كلِ حالِ",76,"ل",1,0],["دَليلايَ فيها حُسنُ ظَنّي وَبارِقٌ","يُبَشِّرُ بِالتَهطالِ وَالعامُ مُجدِبُ",77,"ب",1,0],["دَلَّ عَلى المَجدِ مَن إِلَيهِ سَعى","كَيلا يَدَع في فَضيلَةٍ طَمَعا",78,"ع",2,1],["دليلُ عُلاك ليس على اعتراض","وبسط نداك ليس إلى انقباض",79,"ض",1,1],["دَلائِلُ نَستَهدي بِها الشَرعَ وَالعَقلا","دَلائِلُ زادَت في بِلى الدَهرِ جِدَّةً",80,"ه",1,0],["دَليلٌ عَلى أَنَّ المَكانَةَ أَنوَهُ","إِل