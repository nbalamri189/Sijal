ر"],[553,"قد اطلعت على سري وإعلاني","https://www.aldiwan.net/poem68419.html","البسيط"],[558,"دللناك يا من أنت ذمي ديننا","https://www.aldiwan.net/poem34710.html","الطويل"],[562,"جاءت رسالة إبراهيم سافرة","https://www.aldiwan.net/poem52791.html","البسيط"],[562,"من يقرب النار لا يسلم من الحرق","https://www.aldiwan.net/poem52861.html","البسيط"],[562,"فدى الجلابيب والأطمار من وبر","https://www.aldiwan.net/poem52941.html","البسيط"],[567,"أنا أفدي التي تغدو","https://www.aldiwan.net/poem69590.html","مجزوء الوافر"],[575,"ويح نفس مغطره","https://www.aldiwan.net/poem2948.html","مجزوء الخفيف"]],"verses":[["دَلّاهُ فيها مِثلَ ما","دَلّى السِنانَ العامِلُ",0,"ل",1,0],["دَلَّ فيهَا الذِّهْنُ الجَلِيُّ بِأَلْفا","ظٍ رِقاقٍ على مَعانٍ دِقاقِ",1,"ق",1,0],["دلّتْ على أعراقِهِمْ أفعالُهُمْ","والمَكْرُماتُ جمّةُ المَخائلِ",2,"ل",1,0],["دَلّى عِمامَتَهُ حَتّى إِذا اِنقَشَعَت","غَمامَةٌ الماءِ عَن عَذبٍ وَمَوّارِ",3,"ر",1,0],["دَلَكَ الْكَفَّ بِحِنَّاءٍ فَقُلْنَا","أَنْتَ شَمْسُ الدِّينِ عِنْدَ الدُّلُوكْ",4,"ك",1,0],["دَلِيلُهُمُ الْقُرْآنُ يَا حَبَّذَا الْهُدَى","وَرَهْطُهُمُ الأَنْصَارُ يَا حَبَّذَا الرَّهْطُ",5,"ط",1,0],["دَلَّ أَنَّ الرَّخَاءَ مُغْتَبِطٌ بِي","فَبِحَقِّ تَبَجُّحِي وَانْتِخَائِي",6,"ي",1,0],["دَلَّهَت فِكرِيَ مِن إِبداعِهِ","حيرَةٌ في مَنطِقٍ لي مُخرِسِ",7,"س",1,0],["دِلاثُ العَتيقِ ما وَضَعتُ زِمامَهُ","مُنيفٌ بِهِ الهادي إِذا اِحتُثَّ ذامِلُ",8,"ل",1,0],["دَلَّ عَلى مَعروفِهِ وَجهُهُ","بورِكَ فيهِ هادِياً مِن دَليل",9,"ل",1,0],["دَلَّتْ مَهَارَتُهَا خُبْراً وَمَعْرِفَةً","عَلَى التَّفَوُّقِ فِي خُبْرٍ وَعِرْفَانِ",10,"ن",1,0],["دَلَّتْ عَلَى قُوَّةٍ فِيهَا صَلابَتُكُمْ","تَذُودُ عَنْهَا الأَشِدَّاءَ المَقَاحِيمَا",11,"م",2,0],["دَلَّيتَني بِغُرورِ وَعدِكَ في","مُتَلاطِمٍ مِن حَومَةِ الغَرَقِ",12,"ق",1,1],["دَلاَلُكِ الحُلو والمشهِّى","وَلَيسَ سَرِّيكِ بالمُضّاعِ",13,"ع",1,0],["دلعت ألسناً من النار حُمراً","ويلَ من قد غدا بها مَلحوسا",14,"س",2,0],["دلفاً من الشرف التليد","إيك بالرِّفد الموافر",15,"ر",1,0],["دَلّوكَ غَدراً وَهُم فيها أُلو خُلُفٍ","وَأَنتَ ضَيمٌ لَها في الدارِ مُحتَبَسُ",16,"س",1,0],["دَلّاهُمُ بِغُرورٍ ثُمَّ أَسلَمَهُم","إِنَّ الخَبيثَ لِمَن والاهُ غَرّارُ",17,"ر",1,0],["دلَّت مناقبهُ على أنسابهِ","وحَماهُ عن تسآل مَن لألاؤه",18,"ا",3,0],["دلَّ العلاء على إيضاح سؤددكم","دلالةَ القبسِ الموفي على نشز",19,"ز",1,0],["دليل الحشا لما نظرتَ قتلته","بأضعف قرن في أذلِّ مكان",20,"ن",1,0],["دلفي يوم الفخار يجلى","وبه منهم الخطوب تجلَّى",21,"ل",2,0],["دَلالٌ يا مُحَمَّد مُستَعارُ","دَلالٌ بَعدَ أَن شابَ العَذارُ",22,"ر",1,1],["دَلَفْتَ إليه فاستبحتَ حَرِيمَهُ","بجيشٍ لُهامٍ كالمدود الزَّوائدِ",23,"د",1,0],["دلوا على باطن الدنيا بظاهرها","وعلم ما غاب عنهم بالذي شهدُوا",24,"د",3,0],["دلَّت معالمُها على أغفالها","فعرفتُ دارسَها بما لم يدرس",25,"س",1,0],["دلفوا لجارِهمُ بشرٍّ لازمٍ","وتجانفوا عنه بخيرٍ مائطِ",26,"ط",1,0],["دلفنا لها بالسمهريّ فطالعٌ","إلى مصرعٍ يرتاده ومُحَرْجمُ",27,"م",1,0],["دلَّهتك اثنتانِ عن فهم شعري","خوفُ أن تُجتَدى وخوفُ الهزيمَهْ",28,"م",2,0],["دَلَفتُ لَهُ تَحتَ الوَغى بِمُرِشَّةٍ","مُسَحسِحَةٍ تَعلو ظُهورَ الأَنامِلِ",29,"ل",1,0],["دَلَّهَتني وَحَمَيتِ جَفني غَمضَهُ","لا يُستَطاعُ مَعَ الهُمومِ هُجودا",30,"د",2,0],["دَلَفتُ لَهُم بَعدَ الأَناةِ بِخَطَّةٍ","تَرى القَومَ مِنها يَجهَدونَ التَفادِيا",31,"ي",2,0],["دَلَّني أَنَّكَ في الخُل","صان مَعقودٌ بِخِنصَرْ",32,"ر",1,0],["دَلَّهَت مِصراً وَلَو أَنَّ بِها","فَلَواتٍ دَلَّهَت وَحشَ فَلاها",33,"ا",3,0],["دَلَّهتِهِ بِعَزيزٍ في مَحاجِرِهِ","ماضٍ لَهُ مِن مُبينِ السِحرِ جَفنانِ",34,"ن",1,0],["دَلَّت عَلى مَلِكِ المُلوكِ فَلَم تَدَع","لِأَدِلَّةِ الفُقَهاءِ وَالأَحبارِ",35,"ر",1,0],["دَلهَمِيٌّ إِذا اِدلَهَمَّ دُجى الخَط","بِ كَفَت فيهِ شُعلَةٌ مِن وُقودِه",36,"د",2,0],["دَلَفتَ مُستَنصِراً بِاللَهِ مُنتَصِراً","لِلَّهِ غَيرانَ تَحمي دينَهُ أَنِفا",37,"ف",2,0],["دَلائِلُ مَكنونٍ مِنَ الوَجدِ لاعِجِ","وَسُحُّ دُموعِ العَينِ أَقوى الدَلائِلِ",38,"ل",1,0],["دَلَّت عَلى رَأيِ الإِمامِ وَأَنَّهُ","قَلِقُ الضَميرِ لِما أَصابَكَ جازِعُ",39,"ع",1,0],["دَليلُكَ أَنَّ الفَقرَ خَيرٌ مِنَ الغِنى","وَأَنَّ القَليلَ المالِ خَيرٌ مِنَ المُثري",40,"ي",1,1],["دَلَّت زَخارِفُهُ الخَليفَةَ أَنَّهُ","ما كُلُّ عودٍ ناضِرٍ بِنُضارِ",41,"ر",1,0],["دَلوحانِ تَفتَرُّ المَكارِمُ عَنهُما","كَما الغَيثُ مُفتَرٌّ عَنِ البَرقِ وَالرَعدِ",42,"د",1,0],["دَلَّ عَلَى مَعْدِنِهِ فَضْلُهُ","دَلالَةَ التِّبْرِ عَلَى الْمَنْجَمِ",43,"م",1,0],["دليلُ ذلكَ قولُهُ","وآخرون اعترفوا",44,"ف",3,0],["دَلَّ الفُؤادَ عَلَيها بَعضُ نِسوَتِها","وَنَظرَةٌ عَرَضَت كانَت مِنَ القَدَرِ",45,"ر",1,0],["دَلَّهَتني وَالجيدُ مِنها كَلَيلى","وَالحَشا وَالبُغامُ وَالعَينانِ",46,"ن",1,0],["دَلَفَ الفَوارِسُ في لِوائِكِ حُسَّراً","وَمَضوا رَعيلاً لِلوَغى فَرعيلا",47,"ل",2,0],["دَلَّهُ منكم عليكم رَجُلٌ","خَشِيَ القتلَ وخافَ العَطَبا",48,"ب",2,0],["دَلَفتَ تَمشي على الأشلاءِ مُقتحماً","والقومُ مُنجدلٌ في إثرِ مُنْجَدِلِ",49,"ل",1,0],["دَليلكم الصّدقُ فيما مَضَى","يَشُقُّ الصّعابَ ويَهدِي الزُّمَرْ",50,"ر",1,0],["دَلَفَ القومُ بالمصاحفِ لا يَدْ","رُونَ ماذا يُريدُ أن يَسْتَبينا",51,"ن",2,0],["دَليلُ السُّوءِ لا عَقلٌ حَصِيفٌ","يُسَدِّدُه ولا رأيٌ أصيلُ",52,"ل",1,0],["دلفت قرومُ محمدٍ في شأنها","تلقى بِيَثْرِبَ من ذويه قروما",53,"م",2,0],["دلَفوا إليه وظَنَّ أكذبُهُم مُنىً","أنْ قد سَقَتْهُ يداه كأسَ حِمامِهِ",54,"م",2,0],["دَلَلْتَ عَلَى الهَوَى قلبي فَسَهْمِي","وَسَهْمُكَ في الهَوَى كلٌّ مُصيبُ",55,"ب",1,0],["دَلوحاً إذا ما شِمتَهُ افتَرَّ وَبْلُهُ","وإرْهامُهُ سَحّاً عليكَ ورَيّقُه",56,"ق",2,0],["دَلَّت بِغَدرٍ وَقُرونُ الفَتى","تَهتَزُّ بِالكَشخِ عَلى راسِهِ",57,"س",2,0],["دَلَفنا إِلى الضَحّاكِ نَصرِفُ بِالرَدى","وَمَروانُ تَدمى مِن جُذامَ مَخالِبُه",58,"ب",2,0],["دَلّاً عَلَيَّ وَعادَةً سَبَقَت","أَن سَوفَ إِن أَغضى أُعاتِبُهُ",59,"ب",2,0],["دَليلُ ذَلِكَ أَنَّ الحُرَّ أَعوَزَهُ","قوتٌ وَأَنَّ سِواهُ فازَ بِالمالِ",60,"ل",1,0],["دل أن لَيسَ كائناً فيه ماءٌ","ما تَرى في سَمائه من صفاء",61,"ا",2,0],["دلائِلُ مُشْفِقٍ يَخْشَى ضَلالاً","وكيف يُخافُ عن قَمَرٍ ضَلال",62,"ل",1,0],["دَلَّتْ عَلَى فَضْلِهِ آثارُ حِكْمَتِهِ","وَكُلُّ شَيءٍ لَهُ مِنْ نَفْسِهِ أَثَرُ",63,"ر",1,0],["دَلَّتْ بِقُدْرَتِهَا عَلَى","فَضْلِ الْوِفَاقِ وَالاتِّحَادْ",64,"د",1,0],["دَلَّ اسْمُهَا دَلاَلَةَ اسْمِ العُطْرِ","عَلَى جَمَالِ نَوْعِهِ فِي الزَّهْرِ",65,"ر",1,0],["دلَّسَ للناس أحاديثَه","واللَه لا يقبلُ تدليسا",66,"س",2,1],["دَلَّلْتُم الكلب حتى كاد سادتُكم","يدعونه: ملكًا، أو إمْبراطورا",67,"ر",2,0],["دلَّ أن الرخاء مغتبطٌ بي","فبحق تبجُّحي وانتخاء",68,"ا",2,0],["دَلَيْتَ دَلْوَ اٌلمَنَايَا فِي نُفُؤسِهُمُ","فَأَغْرَقَتْهَا إِلى اٌلأَكْرابِ واٌلْوَذَمِ",69,"م",1,0],["دلّلت محنتها بسحر قصائدي","أيّام يستحذي الكميّ فيطرق",70,"ق",1,0],["دليل المصلين الكرام وسيلة ال","ملبين هادي كل داعٍ وصائم",71,"م",1,0],["دليل عشيرتي في أي أمرِ","وقدوة جيرتي في كلِ حالِ",72,"ل",1,0],["دَليلايَ فيها حُسنُ ظَنّي وَبارِقٌ","يُبَشِّرُ بِالتَهطالِ وَالعامُ مُجدِبُ",73,"ب",1,0],["دَلَّ عَلى المَجدِ مَن إِلَيهِ سَعى","كَيلا يَدَع في فَضيلَةٍ طَمَعا",74,"ع",2,1],["دليلُ عُلاك ليس على اعتراض","وبسط نداك ليس إلى انقباض",75,"ض",1,1],["دَلائِلُ نَستَهدي بِها الشَرعَ وَالعَقلا","دَلائِلُ زادَت في بِلى الدَهرِ جِدَّةً",76,"ه",1,0],["دَليلٌ عَلى أَنَّ المَكانَةَ أَنوَهُ","إِلى رَبِّهِ أَلقى بِظَهرِ اِستِنادِهِ",77,"ه",1,0],["دَليلُ الوَرى وَاللَيلُ بِالصُبحِ يَنجَلي","شَفيعُهُمُ وَالنارُ بِالنورِ تَخمدُ",78,"د",1,0],["دليل سعدك أن الخير أجمعه","على يدك وفي شهر الصيام جرا",79,"ر",2,0],["دليل على تقوى التقي انسلاخه","من اليني فيما لم يكن يتحقق",80,"ق",1,0],["دلت على علم عظيم ذكا","والصبح قد ينبيك عنه فجره",81,"ر",2,0],["دُلَّني يا ليلُ أشْقاني النّوى","ورَماني في أوانٍ دَهِمِ",82,"م",1,0],["دليلك أن لا عيب في طاعة الفتى","أخاه على كبر ولا يمكن الغضب",83,"ب",1,0],["دليلك أن لا خير في قرب صاحب","على كل حال من مقيم وغائب",84,"ب",1,0],["دَلَفنا إِلَيهِ بِذي تُدرَأٍ","قَليلٍ التَفَقُّدِ لِلغُيَّبِ",85,"ب",1,0],["دلفوا كما دلفتْ أسودُ خفيّةٍ","والتفَّتِ الأقرانُ بالأقران",86,"ن",1,0],["دَلُّ الملاحِ يهزُّه فكأنَّه","وردٌ يُقَبِّل غُرَّةَ المنثورِ",87,"ر",1,0],["دلفت إليه ملهوفاً","تحث حنيني الذكرى",88,"ر",2,0],["دَلالاً عَلَيَّ وكُنْتُ امْرَأً","أحِبّ من الخَودِ إِدلالَها",89,"ل",3,0],["دليلٌ عَلى أن سوف يُرْدِيه ما لَقِي","بأنَّك لو قد شئْتَ بُقْياه ما بقي",90,"ق",2,1],["دَلَّ إِبْدَاعُهَا عَلَى أَنّ