{"poems":[[53,"أين الغزال الماطل","https://www.aldiwan.net/poem29906.html","مجزوء الرجز"],[63,"كلماتي قلائد الأعناق","https://www.aldiwan.net/poem45891.html","الخفيف"],[63,"يا طرة الشيح بسفح عاقل","https://www.aldiwan.net/poem46162.html","الرجز"],[55,"يا موقد النار بالهندي والغار","https://www.aldiwan.net/poem26369.html","البسيط"],[77,"إن شمس الدين فخر الملوك","https://www.aldiwan.net/poem36380.html","الخفيف"],[77,"تخطت وفود الليل بان به الوخط","https://www.aldiwan.net/poem36395.html","الطويل"],[77,"يا محلا لخلتي وانتخائي","https://www.aldiwan.net/poem36789.html","الخفيف"],[73,"أسقيط الطل فوق النرجس","https://www.aldiwan.net/poem11953.html","الرمل"],[35,"أللشوق لما هيجتك المنازل","https://www.aldiwan.net/poem39114.html","الطويل"],[10,"ياعين جودي بالدموع السجول","https://www.aldiwan.net/poem21124.html","السريع"],[93,"ألطيب في نفحات الروض حياني","https://www.aldiwan.net/poem11224.html","البسيط"],[93,"تحية أيها القتلى وتسليماً","https://www.aldiwan.net/poem11387.html","البسيط"],[54,"دليتني بغرور وعدك","https://www.aldiwan.net/poem27520.html","الكامل"],[41,"دعاك من شوقك الدواعي","https://www.aldiwan.net/poem42371.html","مخلع البسيط"],[88,"سعروها في البحر حربا ضروسا","https://www.aldiwan.net/poem44472.html","الخفيف"],[37,"قف بالديار وقوف زائر","https://www.aldiwan.net/poem7174.html","مجزوء الكامل"],[23,"لو كان في الدار قرم ذو محافظة","https://www.aldiwan.net/poem21370.html","البسيط"],[23,"قومي الذين هم آووا نبيهم","https://www.aldiwan.net/poem21570.html","البسيط"],[72,"جسم سقيم لا يرام شفاؤه","https://www.aldiwan.net/poem18173.html","الكامل"],[72,"قد أمكنت فرص اللذات فانتهز","https://www.aldiwan.net/poem18999.html","البسيط"],[72,"لنجم هلال الدولة الحسن عسكر","https://www.aldiwan.net/poem20190.html","الطويل"],[72,"إن طيفا عن حال شجواي أملى","https://www.aldiwan.net/poem20543.html","الخفيف"],[64,"دلال يا محمد مستعار","https://www.aldiwan.net/poem67651.html","الوافر"],[51,"رقدت وما ليل الغريب براقد","https://www.aldiwan.net/poem61941.html","الطويل"],[51,"فلو شهدت مقامي ثم أنديتي","https://www.aldiwan.net/poem61980.html","البسيط"],[51,"يدعو الحمام بها الهديل تأسيا","https://www.aldiwan.net/poem64677.html","الطويل"],[51,"أشجتك منزلة بمرجي راهط","https://www.aldiwan.net/poem65022.html","الكامل"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[51,"يا سليمان لا ألومك في رد","https://www.aldiwan.net/poem66031.html","الخفيف"],[26,"وقائلة ما كان حذوة بعلها","https://www.aldiwan.net/poem24095.html","الطويل"],[91,"ليت الذي خلق العيون السودا","https://www.aldiwan.net/poem8816.html","عموديه"],[38,"ظعنت وودعت الخليط اليمانيا","https://www.aldiwan.net/poem7822.html","الطويل"],[78,"أيها الفائق أهل ال","https://www.aldiwan.net/poem14164.html","مجزوء الرمل"],[85,"شيعوا الشمس ومالوا بضحاها","https://www.aldiwan.net/poem8109.html","الرمل"],[85,"قلب بوادي الحمى خلفته رمقا","https://www.aldiwan.net/poem62998.html","البسيط"],[85,"تلك الطبيعة قف بنا يا ساري","https://www.aldiwan.net/poem63715.html","الكامل"],[45,"بات عهد الصبا وباقي جديده","https://www.aldiwan.net/poem63465.html","الخفيف"],[45,"إستقبلا الركب في أطلالهم وقفا","https://www.aldiwan.net/poem65170.html","البسيط"],[45,"أما كان في تلك الدموع السوائل","https://www.aldiwan.net/poem65638.html","الطويل"],[45,"بعدوك الحدث الجليل الواقع","https://www.aldiwan.net/poem64709.html","الكامل"],[58,"دليلك أن الفقر خير من الغنى","https://www.aldiwan.net/poem31043.html","الطويل"],[44,"الحق أبلج والسيوف عوار","https://www.aldiwan.net/poem30507.html","الكامل"],[44,"شهدت لقد أقوت مغانيكم بعدي","https://www.aldiwan.net/poem30537.html","الطويل"],[87,"يا لك من ذي أدب","https://www.aldiwan.net/poem8247.html","السريع"],[69,"لا ييئسن مخلط","https://www.aldiwan.net/poem28028.html","مجزوء الرجز"],[31,"يا صاحبي أقلا اللوم واحتسبا","https://www.aldiwan.net/poem42544.html","البسيط"],[33,"اذهبي في كلاءة الرحمن","https://www.aldiwan.net/poem25771.html","الخفيف"],[105,"من حق ركبك أن يهز النيلا","https://www.aldiwan.net/poem43063.html","الكامل"],[105,"يا بني سعد بن بكر مرحبا","https://www.aldiwan.net/poem43987.html","الرمل"],[105,"ودع ذويك وسر في شأنك الجلل","https://www.aldiwan.net/poem44046.html","البسيط"],[105,"مضى العام وانبعث المنتظر","https://www.aldiwan.net/poem44049.html","المتقارب"],[105,"مرحبا بالأحبة المقبلينا","https://www.aldiwan.net/poem44058.html","الخفيف"],[105,"ترامى الجيش واندفع الرعيل","https://www.aldiwan.net/poem44191.html","الوافر"],[105,"اذهب حيي مذمما مشؤوما","https://www.aldiwan.net/poem44195.html","الكامل"],[105,"هذا إمام الدين في أعلامه","https://www.aldiwan.net/poem44206.html","الكامل"],[67,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[75,"أمن أفقها ذاك السنا وتألقه","https://www.aldiwan.net/poem69058.html","الطويل"],[48,"قولا لمن يعشق قصرية","https://www.aldiwan.net/poem64338.html","البسيط"],[50,"جفا وده فازور أو مل صاحبه","https://www.aldiwan.net/poem64818.html","الطويل"],[50,"بأبي وأمي من يقاربني","https://www.aldiwan.net/poem64843.html","الكامل"],[46,"لم يسقكم ربكم عن حسن فعلكم","https://www.aldiwan.net/poem23225.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16638","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42605","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54719","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54949","الرجز"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116965","السريع"],[106,"كلب بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179351",""],[77,"يا محلاَّ لخُلّتي وانتخائي","https://www.poetsgate.com/ViewPoem.aspx?id=33195",""],[45,"لامَتْ ، عَلَى أَنَّها في الدَّمْعِ لم تَلُمِ","https://www.poetsgate.com/ViewPoem.aspx?id=31887",""]],"verses":[["دَلّاهُ فيها مِثلَ ما","دَلّى السِنانَ العامِلُ",0,"ل",1,0],["دَلَّ فيهَا الذِّهْنُ الجَلِيُّ بِأَلْفا","ظٍ رِقاقٍ على مَعانٍ دِقاقِ",1,"ق",1,0],["دلّتْ على أعراقِهِمْ أفعالُهُمْ","والمَكْرُماتُ جمّةُ المَخائلِ",2,"ل",1,0],["دَلّى عِمامَتَهُ حَتّى إِذا اِنقَشَعَت","غَمامَةٌ الماءِ عَن عَذبٍ وَمَوّارِ",3,"ر",1,0],["دَلَكَ الْكَفَّ بِحِنَّاءٍ فَقُلْنَا","أَنْتَ شَمْسُ الدِّينِ عِنْدَ الدُّلُوكْ",4,"ك",1,0],["دَلِيلُهُمُ الْقُرْآنُ يَا حَبَّذَا الْهُدَى","وَرَهْطُهُمُ الأَنْصَارُ يَا حَبَّذَا الرَّهْطُ",5,"ط",1,0],["دَلَّ أَنَّ الرَّخَاءَ مُغْتَبِطٌ بِي","فَبِحَقِّ تَبَجُّحِي وَانْتِخَائِي",6,"ي",1,0],["دَلَّهَت فِكرِيَ مِن إِبداعِهِ","حيرَةٌ في مَنطِقٍ لي مُخرِسِ",7,"س",1,0],["دِلاثُ العَتيقِ ما وَضَعتُ زِمامَهُ","مُنيفٌ بِهِ الهادي إِذا اِحتُثَّ ذامِلُ",8,"ل",1,0],["دَلَّ عَلى مَعروفِهِ وَجهُهُ","بورِكَ فيهِ هادِياً مِن دَليل",9,"ل",1,0],["دَلَّتْ مَهَارَتُهَا خُبْراً وَمَعْرِفَةً","عَلَى التَّفَوُّقِ فِي خُبْرٍ وَعِرْفَانِ",10,"ن",1,0],["دَلَّتْ عَلَى قُوَّةٍ فِيهَا صَلابَتُكُمْ","تَذُودُ عَنْهَا الأَشِدَّاءَ المَقَاحِيمَا",11,"م",2,0],["دَلَّيتَني بِغُرورِ وَعدِكَ في","مُتَلاطِمٍ مِن حَومَةِ الغَرَقِ",12,"ق",1,1],["دَلاَلُكِ الحُلو والمشهِّى","وَلَيسَ سَرِّيكِ بالمُضّاعِ",13,"ع",1,0],["دلعت ألسناً من النار حُمراً","ويلَ من قد غدا بها مَلحوسا",14,"س",2,0],["دلفاً من الشرف التليد","إيك بالرِّفد الموافر",15,"ر",1,0],["دَلّوكَ غَدراً وَهُم فيها أُلو خُلُفٍ","وَأَنتَ ضَيمٌ لَها في الدارِ مُحتَبَسُ",16,"س",1,0],["دَلّاهُمُ بِغُرورٍ ثُمَّ أَسلَمَهُم","إِنَّ الخَبيثَ لِمَن والاهُ غَرّارُ",17,"ر",1,0],["دلَّت مناقبهُ على أنسابهِ","وحَماهُ عن تسآل مَن لألاؤه",18,"ا",3,0],["دلَّ العلاء على إيضاح سؤددكم","دلالةَ القبسِ الموفي على نشز",19,"ز",1,0],["دليل الحشا لما نظرتَ قتلته","بأضعف قرن في أذلِّ مكان",20,"ن",1,0],["دلفي يوم الفخار يجلى","وبه منهم الخطوب تجلَّى",21,"ل",2,0],["دَلالٌ يا مُحَمَّد مُستَعارُ","دَلالٌ بَعدَ أَن شابَ العَذارُ",22,"ر",1,1],["دَلَفْتَ إليه فاستبحتَ حَرِيمَهُ","بجيشٍ لُهامٍ كالمدود الزَّوائدِ",23,"د",1,0],["دلوا على باطن الدنيا بظاهرها","وعلم ما غاب عنهم بالذي شهدُوا",24,"د",3,0],["دلَّت معالمُها على أغفالها","فعرفتُ دارسَها بما لم يدرس",25,"س",1,0],["دلفوا لجارِهمُ بشرٍّ لازمٍ","وتجانفوا عنه بخيرٍ مائطِ",26,"ط",1,0],["دلفنا لها بالسمهريّ فطالعٌ","إلى مصرعٍ يرتاده ومُحَرْجمُ",27,"م",1,0],["دلَّهتك اثنتانِ عن فهم شعري","خوفُ أن تُجتَدى وخوفُ الهزيمَهْ",28,"م",2,0],["دَلَفتُ لَهُ تَحتَ الوَغى بِمُرِشَّةٍ","مُسَحسِحَةٍ تَعلو ظُهورَ الأَنامِلِ",29,"ل",1,0],["دَلَّهَتني وَحَمَيتِ جَفني غَمضَهُ","لا يُستَطاعُ مَعَ الهُمومِ هُجودا",30,"د",2,0],["دَلَفتُ لَهُم بَعدَ الأَناةِ بِخَطَّةٍ","تَرى القَومَ مِنها يَجهَدونَ التَفادِيا",31,"ي",2,0],["دَلَّني أَنَّكَ في الخُل","صان مَعقودٌ بِخِنصَرْ",32,"ر",1,0],["دَلَّهَت مِصراً وَلَو أَنَّ بِها","فَلَواتٍ دَلَّهَت وَحشَ فَلاها",33,"ا",3,0],["دَلَّهتِهِ بِعَزيزٍ في مَحاجِرِهِ","ماضٍ لَهُ مِن مُبينِ السِحرِ جَفنانِ",34,"ن",1,0],["دَلَّت عَلى مَلِكِ المُلوكِ فَلَم تَدَع","لِأَدِلَّةِ الفُقَهاءِ وَالأَحبارِ",35,"ر",1,0],["دَلهَمِيٌّ إِذا اِدلَهَمَّ دُجى الخَط","بِ كَفَت فيهِ شُعلَةٌ مِن وُقودِه",36,"د",2,0],["دَلَفتَ مُستَنصِراً بِاللَهِ مُنتَصِراً","لِلَّهِ غَيرانَ تَحمي دينَهُ أَنِفا",37,"ف",2,0],["دَلائِلُ مَكنونٍ مِنَ الوَجدِ لاعِجِ","وَسُحُّ دُموعِ العَينِ أَقوى الدَلائِلِ",38,"ل",1,0],["دَلَّت عَلى رَأيِ الإِمامِ وَأَنَّهُ","قَلِقُ الضَميرِ لِما أَصابَكَ جازِعُ",39,"ع",1,0],["دَليلُكَ أَنَّ الفَقرَ خَيرٌ مِنَ الغِنى","وَأَنَّ القَليلَ المالِ خَيرٌ مِنَ المُثري",40,"ي",1,1],["دَلَّت زَخارِفُهُ الخَليفَةَ أَنَّهُ","ما كُلُّ عودٍ ناضِرٍ بِنُضارِ",41,"ر",1,0],["دَلوحانِ تَفتَرُّ المَكارِمُ عَنهُما","كَما الغَيثُ مُفتَرٌّ عَنِ البَرقِ وَالرَعدِ",42,"د",1,0],["دَلَّ عَلَى مَعْدِنِهِ فَضْلُهُ","دَلالَةَ التِّبْرِ عَلَى الْمَنْجَمِ",43,"م",1,0],["دليلُ ذلكَ قولُهُ","وآخرون اعترفوا",44,"ف",3,0],["دَلَّ الفُؤادَ عَلَيها بَعضُ نِسوَتِها","وَنَظرَةٌ عَرَضَت كانَت مِنَ القَدَرِ",45,"ر",1,0],["دَلَّهَتني وَالجيدُ مِنها كَلَيلى","وَالحَشا وَالبُغامُ وَالعَينانِ",46,"ن",1,0],["دَلَفَ الفَوارِسُ في لِوائِكِ حُسَّراً","وَمَضوا رَعيلاً لِلوَغى فَرعيلا",47,"ل",2,0],["دَلَّهُ منكم عليكم رَجُلٌ","خَشِيَ القتلَ وخافَ العَطَبا",48,"ب",2,0],["دَلَفتَ تَمشي على الأشلاءِ مُقتحماً","والقومُ مُنجدلٌ في إثرِ مُنْجَدِلِ",49,"ل",1,0],["دَليلكم الصّدقُ فيما مَضَى","يَشُقُّ الصّعابَ ويَهدِي الزُّمَرْ",50,"ر",1,0],["دَلَفَ القومُ بالمصاحفِ لا يَدْ","رُونَ ماذا يُريدُ أن يَسْتَبينا",51,"ن",2,0],["دَليلُ السُّوء