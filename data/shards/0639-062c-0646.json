{"poems":[[55,"دع من دموعك بعد البين للدمن","https://www.aldiwan.net/poem29648.html","البسيط"],[45,"دمع جرى فقضى في الربع ماوجبا","https://www.aldiwan.net/poem9465.html","البسيط"],[64,"عجنا إلى الجزع الذي مد في","https://www.aldiwan.net/poem52404.html","السريع"],[68,"عجنا على وادي الصفا فصفا","https://www.aldiwan.net/poem38797.html","الكامل"],[33,"طال من آل زينب الإعراض","https://www.aldiwan.net/poem42467.html","الخفيف"],[33,"حدث حديث فتاة حي مرة","https://www.aldiwan.net/poem42666.html","الكامل"],[42,"طال عن آل زينب الإعراض بي","https://www.aldiwan.net/poem42318.html","الخفيف"],[50,"أما ترى الشمس حلت الحملا","https://www.aldiwan.net/poem64495.html","البسيط"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30500","الكامل"],[33,"طالَ من آلِ زينبَ الإعراضُ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18931&r=&rc=194",""],[173,"ما أنصف الطلل العافي بماوانا","https://www.aldiwan.net/poem1685.html",""],[182,"موت يشتهيه الرثاء","https://www.aldiwan.net/poem50697.html","الكامل"],[185,"حى المنازل من حماء قد درست","https://www.aldiwan.net/poem58851.html","البسيط"],[199,"بانت سعاد وليس الود ينصرم","https://www.aldiwan.net/poem54418.html","البسيط"],[203,"كان ذاك الصديق فيما رأينا","https://www.aldiwan.net/poem45199.html","الخفيف"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[409,"عذرا إلى مولاي عذرا","https://www.aldiwan.net/poem33927.html","مجزوء الكامل"],[412,"لو جادهن غداة رمن رواحا","https://www.aldiwan.net/poem50194.html","الكامل"],[463,"من دل ربات العيون النجل","https://www.aldiwan.net/poem56067.html","الرجز"],[463,"يا دار لا أنهج القشيب","https://www.aldiwan.net/poem56284.html","مخلع البسيط"],[469,"هيج بلبالي بأهل بابل","https://www.aldiwan.net/poem3494.html","عموديه"],[556,"ماذا على الريم لو حيا فأحيانا","https://www.aldiwan.net/poem47179.html","البسيط"],[556,"يا راكبا وصل الوجيف ذميله","https://www.aldiwan.net/poem47335.html","الكامل"],[563,"قف جانب الدير سل عنها القساسيسا","https://www.aldiwan.net/poem34453.html","البسيط"],[591,"علق الفؤاد بظبية عجانة","https://www.aldiwan.net/poem17545.html","الكامل"],[659,"","https://poetry.dctabudhabi.ae/diwan/poem/76566","الكامل"],[789,"","https://poetry.dctabudhabi.ae/diwan/poem/146223","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64183","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62685","الرمل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50028","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50030","السريع"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50035","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108927","الكامل"],[1668,"","https://poetry.dctabudhabi.ae/diwan/poem/31381","البسيط"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26438","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69378","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69351","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69324","الرجز"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69321","الكامل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123181","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53067","الرجز"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28572","الكامل"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45576","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74232","الكامل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67976","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108138","البسيط"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101251","الكامل"],[3690,"","https://poetry.dctabudhabi.ae/diwan/poem/77712","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117947","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117924","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94656","الكامل"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104519","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139736",""],[5206,"مناهج الله","https://www.poetsgate.com/ViewPoem.aspx?id=187391",""],[4045,"إن يكن هذا النوا","https://www.poetsgate.com/ViewPoem.aspx?id=200271",""],[5444,"أحلى الأمكنة","https://www.poetsgate.com/ViewPoem.aspx?id=205447",""],[5776,"سديمُ المستحيلات","https://www.poetsgate.com/ViewPoem.aspx?id=199343",""],[4442,"يتنزى هوى على تلعاته","https://www.poetsgate.com/ViewPoem.aspx?id=170995",""]],"verses":[["عُجنا عَلى الرَكبِ أَنضاءً مُحَزَّمَةً","أَثقالُها الشَوقُ مِن بادٍ وَمُكتَمِنِ",0,"ن",1,0],["عُجنا فَأَذهَبَ ما أَبقى الفِراقُ لَنا","مِنَ العُقولِ وَما رَدَّ الَّذي ذَهَبا",1,"ب",2,0],["عُجْنَا إِلى الجِزْعِ الذي مَدَّ في","أرجائِه الغيمُ بِساطَ الزَّهَرْ",2,"ر",1,1],["عُجنا عَلى وادي الصَفا فَصَفا","عَيشي وَوَلّى الهَمُّ مُرتَحِلا",3,"ل",2,1],["عُجنَ نَحوَ الفَتى البِغالَ نُحَيِّي","هِ بِما تَكتُمُ القُلوبُ المِراضُ",4,"ض",1,0],["عُجنا مَطايا قَد عَيَينَ وَعُوِّدَت","أَلّا يَرُمنَ تَرَغُّماً بِرُغاءِ",5,"ا",2,0],["عُجنَ نَعهَد إِلى الفَتى وَنُخَبِّر","هُ بِما تَكتُمُ القُلُوبُ المِراضُ",6,"ض",1,0],["عُجنا بِثِنتَينِ مِن طَبائِعِها","حُسناً وَطيباً تَرى بِهِ المَثَلا",7,"ل",2,0],["عُجْنَا الرِّكابَ بها فَهَيَّجَ وَجْدَنَا","دِمَنٌ ذَعَرْنَ السِّرْبَ مِن إِدْمَانِهَا",8,"ن",3,0],["عُجْنَ نَحْوَ الفَتَى البِغَالَ نُحَيّي","بما تكتمُ القلوبُ المراض",9,"ض",1,0],["عُجنا نُحَيّيهِ إِجلالاً وَتَكرِمَةً","مِنّا فَلَم نُبكِهِ شَوقاً وَأَبكانا",10,"ن",2,0],["عجنتكَ في صَحْنِ الأسى البَلْواءُ","خَبَزَتْكَ في تنّورِها الأنْواءُ",11,"ا",2,1],["عُجنا عَلَى دَارِها نبكِى وَنسأَلُهَا","عَنها ونُخبِرُها عَن بَينِنا خُطُبا",12,"ب",2,0],["عُجنا إِلَيها وَما عُجنا لِتُخبِرَنا","إِلّا اللُجاجَةُ وَالوَهمُ الَّذي تَهِمُ",13,"م",1,0],["عجنتْ لي الرواةُ أخلاقكَ السو","ءَ طينها يكونُ البناءُ",14,"ا",2,0],["عُجِنَت مِنَ التَسنيمِ بِالماءِ الَّذي","زادَت بِهِ شَرَفاً عَلى الأَبدانِ",15,"ن",1,0],["عجنت بحبك طينتي","فنشأت أحمل منه وقرا",16,"ر",2,0],["عَجنا بِهِ هَلكى فاهدَت ريحَهُ","أُصُلاً إِلى أَجسادِنا الأَرواحا",17,"ح",2,0],["عجنا بها العيسَ سريعاتِ الخُطَى","شوقاً إليها مائلاتِ الأرجلِ",18,"ل",1,0],["عُجْنا وليلُ المطيِّ ليلٌ","بَعْدُ وصوتُ الحادي صليبُ",19,"ب",1,0],["عجناً على نواحلٍ نسأل عن","سكّانها في أربعٍ نواحل",20,"ل",1,0],["عُجنا إليه صدورَ اليَعْمَلاتِ وقدْ","نضا الصّباحُ ثيابَ اللّيلِ عُريانا",21,"ن",2,0],["عُجنا عليه وللقلوب بلابلٌ","هيّجنَهُنّ ربوعُهُ وطلولُهُ",22,"ل",2,0],["عجنا على ديرها والليل معتكر","حتى زجرنا لدى حاناتها العيسا",23,"س",2,0],["عَجَنَتْ فُؤَادِي بِالغَرامِ فَماؤُهَا","مِنْ أَدْمُعي وَدَقِيقُها مِنْ خَصْرِهَا",24,"ه",2,0],["عُجنا فلَم نَرَ غَيرَ نُؤيٍ دارِسِ","وَجَواثِم سُفعٍ وَأَسحَمَ هابِ",25,"ب",1,0],["عجنا بقصرِ بني شعيبٍ بعدَما","سئمَ الخليطُ ونامَ كلُّ مسامرِ",26,"ر",1,0],["عُجنا بها من حيث ما عاج أحد","في ظلِّ صفصافٍ علينا قد بَرَد",27,"د",1,0],["عجنت طينته من لبّها","واستوت من ضوئها المشتعل",28,"ل",1,0],["عُجْنا بها أنْضاؤُنا أُصُلاً","فعرفتها لأَيا وبي وهمُ",29,"م",1,0],["عُجنا على الأَطلال أَنضاءَنا","حيث توهمنا رسوم الخيامْ",30,"م",1,0],["عجنا نحيّيها ونقضي بها","حفيظةَ العَهْد وحقَّ الذّمامْ",30,"م",1,0],["عُجنا على الدّار أيضاً أن نقول لها","هل تذكر الوفد أَو انسيت قُطانا",31,"ن",2,0],["عج نحوه تجد المكرام عرست","في حلةٍ يحتلها الإيمان",32,"ن",1,0],["عجنا فما كلمتنا الدارُ إذ سُئلت","وما بها من جوابٍ خلتَ من صممِ",33,"م",1,0],["عُجنا المَطِيَّ وَنَحنُ تَحتَ الحاجِرِ","بَينَ الأَبارِقِ وَالسَبيلِ الغامِرِ",34,"ر",1,1],["عُجنا عَلَيهِ العِيسَ نَسأَل رَسمَهُ","لَو كانَ مَن سَأَلَ الطُلُولَ يَجابُ",35,"ب",1,0],["عُجنا عَلَيهِ المَطايا عَوجَةً قَدَحَت","نارَ الصَبابَةِ في قَلبٍ وَفي كَبِدِ",36,"د",1,0],["عُجنا بِهِ كَأَنَّنا نُعُودُه","فَلَم نَزَل دُمُوعُنا تَجُودُه",37,"د",2,0],["عُجنا الطَيَّ بِهِ وَهَبَّ نَسيمُهُ","فَذَكرتُ رَيّاهُ بِرَيّا بانِهِ",38,"ه",1,0],["عجنت فيه دقيق الفكر مُنطرحا","في ظل نخل به تخمير تخييلي",39,"ل",2,0],["عجنا به العيس خفافاً وانثنت","بالعبء من أشواقنا طلائحا",40,"ح",2,0],["عُجنا بِناحِلِ رَسمِهِ فَتَحَيَّرَت","فيهِ دُموعٌ ما لَهُنَّ مسيلُ",41,"ل",1,0],["عَجنا عَن المِدَح الَّتي اِستحقَقتها","وَاللَهُ يَعلم ما تَعي النيات",42,"ت",1,0],["عجنت بِماء الفَضل حَتّى طهرَت","وَتخمرت بالعلم وَالإِرشاد",43,"د",1,0],["عُجِنت بماءِ المُزْنِ تربتُها إذن","لكنَّ من دَمِّ العِدى مولود",44,"د",1,0],["عجنا عليك فاعولن اولا عجبٌ","فالصب يبدي لهجر الحسن أعوالا",45,"ل",2,0],["عجنت بماء الحسن طينته","سبحان خالقه وباريه",46,"ي",2,0],["عُجنا نؤمُّ بها معاهدَ طالَما","كرمتْ فعاجَ الأنسُ حيثُ نعوجُ",47,"ج",1,0],["عُجِنَت بماء العشق طينته وفي","دعوى المحبة والغرام مصدق",48,"ق",1,0],["عجنت بطينته حمية هاشم","والشبل يمرح في مجال القسور",49,"ر",1,0],["عُج نحوهُ واغنم وناقض من أتى","بطلاب ما لا يستطاع جنونُ",50,"ن",1,0],["عجنت طينه المحبة فيه","فهي في ملكه ومن ملكاته",51,"ت",2,0],["عُجنَت بطينتك المروةُ فاغتدت","ولها الفتوَّة قوَّةٌ وقوام",52,"م",1,0],["عُجِنَتْ بأنوَاعِ الخَبَائثِ جُلُّهَا","مِضمَارُ شَيطَانٍ حِمَارٌ رَافِلُ",53,"ل",1,0],["عجنوا من جلنار","ليكيدوك عجانا",54,"ن",2,0],["عجَنتْ بيُمناها طحينَ مودةٍ","هي ما تبقَّى للجمالِ لتَعجَنه",55,"ن",2,0],["عجنوا تُراباً ينتمي أو ربما","صاروا كصلصالٍ تناسلَ من بللْ",56,"ل",1,0],["عجنت طينة المحبة فيه","فهي من ملكه ومن ملكاته",57,"ت",2,0]]}