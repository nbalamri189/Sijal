{"poems":[[53,"إلى كم الطرف بالبيداء معقود","https://www.aldiwan.net/poem30637.html","البسيط"],[63,"عرضت كخوط البانة الأملود","https://www.aldiwan.net/poem46165.html","الكامل"],[37,"طربت وما شوقا إلى البيض أطرب","https://www.aldiwan.net/poem7650.html","الطويل"],[43,"ملث القطر أعطشها ربوعا","https://www.aldiwan.net/poem9722.html","الوافر"],[129,"إليك فعيني دمعها ليس يقلع","https://www.aldiwan.net/poem50578.html","الطويل"],[144,"ليهنك ما أنالتك الجدود","https://www.aldiwan.net/poem11748.html","الوافر"],[170,"أرتها المآقي ما تكن الجوانح","https://www.aldiwan.net/poem1611.html",""],[465,"سقاني بكأسي ريقه ومدامه","https://www.aldiwan.net/poem3446.html","عموديه"],[501,"لي في سماء الحمى الشرقي أقمار","https://www.aldiwan.net/poem38015.html","البسيط"],[552,"أما ترى الدهر لا يبقي على حال","https://www.aldiwan.net/poem47289.html","البسيط"],[576,"نفس تحن إلى مها","https://www.aldiwan.net/poem3017.html","مجزوء الكامل"],[579,"أتهجر أم لا اليوم من أنت عاشقه","https://www.aldiwan.net/poem710.html",""]],"verses":[["مُلَثَّمينَ بِما راخَت عَمائِمَهُم","وَكُلُّهُم طَرِبٌ لِلبَينِ غَرّيدُ",0,"د",1,0],["مَلْثومَةُ العَرَصاتِ في أرْجائِها","مَثْوى جُنودٍ أو مُناخُ وفودِ",1,"د",1,0],["مُلِثُّ مَربٌّ يَحفِشُ الأُكمَ وَدقُه","شآبيبُ منها وادقاتٌ وَهَيدَبُ",2,"ب",1,0],["مُلِثَّ القَطرِ أَعطِشها رُبوعاً","وَإِلّا فَاِسقِها السَمَّ النَقيعا",3,"ع",2,1],["مُلِثّاً غزيراً دائمَ الوبل هاطَلا","كما قد سَفَتْهُ من جفوني أَدمْعُ",4,"ع",1,0],["مُلِثٌّ ما يُبالي حَيثُ يَهمي","أُتيحَ لَهُ شَكورٌ أَم كَنودُ",5,"د",1,0],["مُلِثٌّ يَظَلُّ الجَأبُ في عُنفُوانِهِ","عَلى النَّشزِ وَهوَ السَّحسَحُ المُتَمايِحُ",6,"ح",1,0],["ملثّاً إذا ما عمَّ صدر تنوفةٍ","أزال يد الإمحال وجهُ غمامهِ",7,"م",2,0],["مُلَثَّمٌ حينَما التِّيجانُ ساقِطَةٌ","ورَابِضٌ إذْ خَميسُ الشُّوسِ فَرَّارُ",8,"ر",1,0],["مُلِثَّةُ الوَدْقِ تسري اللّيلَ أجمعَهُ","فإنْ غدَت وصلتْ صبحاً بآصالِ",9,"ل",1,0],["مَلْثُومةٌ ليستْ تَحُ","طُّ من الشِفاهِ لِثامَها",10,"م",3,0],["مُلِثٍّ فُوَيقَ الأَرضِ دانٍ كَأَنَّهُ","دُجى اللَيلِ أَرسى يَفحَصُ الأَرضَ وادِقُهْ",11,"ق",2,0]]}