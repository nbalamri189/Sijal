{"poems":[[55,"إلى كم الطرف بالبيداء معقود","https://www.aldiwan.net/poem30637.html","البسيط"],[65,"عرضت كخوط البانة الأملود","https://www.aldiwan.net/poem46165.html","الكامل"],[39,"طربت وما شوقا إلى البيض أطرب","https://www.aldiwan.net/poem7650.html","الطويل"],[45,"ملث القطر أعطشها ربوعا","https://www.aldiwan.net/poem9722.html","الوافر"],[132,"إليك فعيني دمعها ليس يقلع","https://www.aldiwan.net/poem50578.html","الطويل"],[147,"ليهنك ما أنالتك الجدود","https://www.aldiwan.net/poem11748.html","الوافر"],[173,"أرتها المآقي ما تكن الجوانح","https://www.aldiwan.net/poem1611.html",""],[469,"سقاني بكأسي ريقه ومدامه","https://www.aldiwan.net/poem3446.html","عموديه"],[505,"لي في سماء الحمى الشرقي أقمار","https://www.aldiwan.net/poem38015.html","البسيط"],[556,"أما ترى الدهر لا يبقي على حال","https://www.aldiwan.net/poem47289.html","البسيط"],[580,"نفس تحن إلى مها","https://www.aldiwan.net/poem3017.html","مجزوء الكامل"],[583,"أتهجر أم لا اليوم من أنت عاشقه","https://www.aldiwan.net/poem710.html",""],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/71025","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120082","المتقارب"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96719","المتقارب"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96748","الوافر"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118429","البسيط"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89558","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89527","الطويل"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88555","المتقارب"],[5044,"إذا لله لم يسق إلا الكرام","https://www.poetsgate.com/ViewPoem.aspx?id=52088",""],[5582,"أَلا هَلْ نَفَتْ عَنْكَ طِيبَ الرُّقادِ","https://www.poetsgate.com/ViewPoem.aspx?id=186965",""],[5582,"أَلا هَلْ سَرَوْا أَهْلُ العَقِيقِ وَراحُوا","https://www.poetsgate.com/ViewPoem.aspx?id=186793",""],[5645,"ما ليل بمنج من عُقيل","https://www.poetsgate.com/ViewPoem.aspx?id=186660",""],[6031,"عَذِيريَ من هَذَا العَذُولِ المُفَنَّدِ","https://www.poetsgate.com/ViewPoem.aspx?id=46273",""]],"verses":[["مُلَثَّمينَ بِما راخَت عَمائِمَهُم","وَكُلُّهُم طَرِبٌ لِلبَينِ غَرّيدُ",0,"د",1,0],["مَلْثومَةُ العَرَصاتِ في أرْجائِها","مَثْوى جُنودٍ أو مُناخُ وفودِ",1,"د",1,0],["مُلِثُّ مَربٌّ يَحفِشُ الأُكمَ وَدقُه","شآبيبُ منها وادقاتٌ وَهَيدَبُ",2,"ب",1,0],["مُلِثَّ القَطرِ أَعطِشها رُبوعاً","وَإِلّا فَاِسقِها السَمَّ النَقيعا",3,"ع",2,1],["مُلِثّاً غزيراً دائمَ الوبل هاطَلا","كما قد سَفَتْهُ من جفوني أَدمْعُ",4,"ع",1,0],["مُلِثٌّ ما يُبالي حَيثُ يَهمي","أُتيحَ لَهُ شَكورٌ أَم كَنودُ",5,"د",1,0],["مُلِثٌّ يَظَلُّ الجَأبُ في عُنفُوانِهِ","عَلى النَّشزِ وَهوَ السَّحسَحُ المُتَمايِحُ",6,"ح",1,0],["ملثّاً إذا ما عمَّ صدر تنوفةٍ","أزال يد الإمحال وجهُ غمامهِ",7,"م",2,0],["مُلَثَّمٌ حينَما التِّيجانُ ساقِطَةٌ","ورَابِضٌ إذْ خَميسُ الشُّوسِ فَرَّارُ",8,"ر",1,0],["مُلِثَّةُ الوَدْقِ تسري اللّيلَ أجمعَهُ","فإنْ غدَت وصلتْ صبحاً بآصالِ",9,"ل",1,0],["مَلْثُومةٌ ليستْ تَحُ","طُّ من الشِفاهِ لِثامَها",10,"م",3,0],["مُلِثٍّ فُوَيقَ الأَرضِ دانٍ كَأَنَّهُ","دُجى اللَيلِ أَرسى يَفحَصُ الأَرضَ وادِقُهْ",11,"ق",2,0],["مُلِثِّ الندى مُغْلَنْطِفِ المزْن مُرْعدِ","يضل به الخِرِّيتُ طوراً ويهتدى",12,"د",2,0],["ملثّ إذا دام تهتانه","على جلمد أورق الجلمدُ",13,"د",1,0],["ملثٌّ حَكى جودَ كهلانَ إِذ","ألثَّ اِنسكاباً وسحّ اِنسجاما",14,"م",2,0],["ملثّ يسمن الآما","لَ ضاحكُه وباكيهِ",15,"ي",2,0],["ملث دمعي جرى لما وقفت على","ربع بسقط اللوى ما فيه من ارم",16,"م",1,0],["مُلِثٌّ إِذا ما راثَ حَنَّت عِشارُهُ","وَحلَّ عُراهُ أَزيَبٌ وَقَبولُ",17,"ل",1,0],["مُلِثُّ القُوى واهي العَزالي إِذا اِنتَجى","بِهِ مُنتِجٌ أَربَت عَلَيهِ دَوافِعُه",18,"ع",2,0],["مُلثّاً مُربَّاَ له هيدب","صدوق الرواعد والأزمل",19,"ل",1,0],["ملثا أحم دوابي السحاب","هزيم الصلاصل والأزمل",20,"ل",1,0],["مُلِثُّ غَمامٍ غَداةَ نَوالٍ","وَلَيْثُ عَرِينٍ غَداةَ الجِلادِ",21,"د",1,0],["مُلِثُّ غَمامٍ لِلْعُفاةِ وَرَحْمَةٌ","وَسَهْمُ حِمامٍ لِلْبُغاةِ مُتاحُ",22,"ح",1,0],["مُلِثٌّ في المبارك غير عف","قليل من زيارته كثير",23,"ر",1,0],["مُلِثٌّ إذا ما مَرَّ بالهَضْبِ لم يكنْ","ليُقْلِعَ إلاَّ عن رَوَاكِعَ سُجَّدِ",24,"د",1,0]]}