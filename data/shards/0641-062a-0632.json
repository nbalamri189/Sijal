{"poems":[[53,"قضت المنازل يوم كاظمة","https://www.aldiwan.net/poem29962.html","الكامل"],[41,"طرب الفؤاد لطيف روضة غاشي","https://www.aldiwan.net/poem42372.html","الكامل"],[51,"لا تكثرن ملامة العشاق","https://www.aldiwan.net/poem65525.html","الكامل"],[80,"ورد الخدود ونرجس المقل","https://www.aldiwan.net/poem31330.html","أحذ الكامل"],[44,"أرأيت أي سوالف وخدود","https://www.aldiwan.net/poem30556.html","الكامل"],[105,"يا أيها الداعي وليس بمسمع","https://www.aldiwan.net/poem43140.html","الكامل"],[48,"شجاني وأبلاني تذكر من أهوى","https://www.aldiwan.net/poem10420.html","الطويل"],[48,"يا صاحبي عصيت مصطبحا","https://www.aldiwan.net/poem62500.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39579","الخفيف"],[80,"وَرْدُ الخدودِ ونرّجسُ المُقَلِ","https://www.poetsgate.com/ViewPoem.aspx?id=3528",""],[160,"يا من رأى مثل ابن تاج الدين","https://www.aldiwan.net/poem58960.html","الكامل"],[169,"إلام أناجي قلب حيران واجم","https://www.aldiwan.net/poem1668.html",""],[186,"أيها الغر بالزما","https://www.aldiwan.net/poem43728.html","مجزوء الخفيف"],[195,"ما هاج شوقك من مغاني دمنة","https://www.aldiwan.net/poem54420.html","الكامل"],[235,"يا علاء الدين المرجى أعني","https://www.aldiwan.net/poem31634.html","الخفيف"],[270,"ودعتني عند السفين أصيلا","https://www.aldiwan.net/poem35191.html","الخفيف"],[270,"حواء أمك حبها أشقانا","https://www.aldiwan.net/poem35584.html","الكامل"],[270,"أدمشق ما أمضى سيوف بنيك","https://www.aldiwan.net/poem35644.html","الكامل"],[364,"أنا والرجاء وأنت والكرم","https://www.aldiwan.net/poem60667.html","أحذ الكامل"],[403,"ولما عراني الضعف من كل جانب","https://www.aldiwan.net/poem33893.html","الطويل"],[461,"أبى الله أن تمسي همومي صواحبي","https://www.aldiwan.net/poem15375.html","الطويل"],[479,"أمسى المساء كأمسنا","https://www.aldiwan.net/poem36927.html","مجزوء الكامل"],[500,"حي الربيع بزهره","https://www.aldiwan.net/poem37703.html","مجزوء الكامل"]],"verses":[["فَتَزاجَروا مِن قَبلِ أَن تَرِدوا","بِمَوارِدٍ مُرٍّ تَرَشُّفُها",0,"ف",3,0],["فَتَزورَنا مَعَهُم زِيارَةَ آمنٍ","والسرُّ يا وَضَّاحُ لَيس بفَاشِي",1,"ي",1,0],["فتزاجروا عن غيِّهم وتصارحوا","نصحاً جلا الشبهات بعد ملاق",2,"ق",1,0],["فَتُزَرُّ لأمَتُهُ على أسَدٍ","وَتُلاثُ حَبْوَتُهُ على جَبَلِ",3,"ل",1,0],["فَتَزَعزَعَ الزورُ المُؤَسَّسُ عِندَهُ","وَبِناءُ هَذا الإِفكِ غَيرُ مَشيدِ",4,"د",1,0],["فَتَزول أَيّامُ النُحوسِ وَتَنقَضي","مِن حادِثاتِ الدَهرِ ما نَتَجَرَّعُ",5,"ع",1,0],["فَتَزدادُ عِندَ المَزجِ طيباً كَأَنَّها","إِشارَةُ مَن تَهوى إِلى كُلِّ ما تَهوى",6,"ا",1,0],["فَتَزَوَّدا مِنّي مُحادَثَةً","حَذَرَ العَصا لَم يُبقِ لي مَرَحا",7,"ح",2,0],["فتزوّدْ من النَّعي","مِ لأيامِك الأُخَرْ",8,"ر",1,0],["فتُزرّ لأمتُهُ على أسَدٍ","وتلاتُ حبوتهُ على جبلِ",9,"ل",1,0],["فتزحزحت تلك الصفوف واغمدت","تلك السيوف وفر كل سخين",10,"ن",1,0],["فَتُزعِجُها حَتّى كَأَن قَد أَصابَها","مِنَ المَسِّ ما لا يُتَّقى بِالتَمائِمِ",11,"م",1,0],["فتزوّد من التقى","قبل قبر ورمسه",12,"س",2,0],["فَتَزَوَّدا نَفَسَينِ ثُمَّ تَوَلَيّا","فَرِحَينِ غِبَّ الرَي أَن يَذَراها",13,"ا",3,0],["فَتَزَوَّجتُها وَقَد باعَدَ اللَ","هُ بِقُربي مِنها السَعادَةَ عَنّي",14,"ن",2,0],["فتزوّدتُ قُبلةً من يمينٍ","علّمَتني أن أُكثِرَ التقبيلا",15,"ل",2,0],["فتزوّدي إنّ الحياة قصيرةٌ","ويمرُّ كالطيرِ الجميلِ صِبانا",16,"ن",2,0],["فتُزلزلُ الدُّنيا لِرَكضِ جَوادِهِ","ويَكونُ مُنقِذَ مُلكِنا مُنجيك",17,"ك",1,0],["فتَزيدُ نُوراً كلّما كُتِمتْ","شمسُ الظّهيرة كيفَ تنكَتِم",18,"م",1,0],["فتزداد إيماناً على كل لحظة","كإيمان أصحاب الرسول ذوي بدر",19,"ر",1,0],["فتزدادُ حُسْناً بالبيان ولم يزلْ","بحسب قوى الفرسان تجري الضوامر",20,"ر",1,0],["فتزودوا بدعائهم","عند المساء وفي الصباح",21,"ح",1,0],["فتزاحم الأحباب ول","هانٌ ومولوعٌ كئيب",22,"ب",1,0]]}