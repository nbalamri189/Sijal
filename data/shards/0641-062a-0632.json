{"poems":[[55,"قضت المنازل يوم كاظمة","https://www.aldiwan.net/poem29962.html","الكامل"],[43,"طرب الفؤاد لطيف روضة غاشي","https://www.aldiwan.net/poem42372.html","الكامل"],[53,"لا تكثرن ملامة العشاق","https://www.aldiwan.net/poem65525.html","الكامل"],[82,"ورد الخدود ونرجس المقل","https://www.aldiwan.net/poem31330.html","أحذ الكامل"],[46,"أرأيت أي سوالف وخدود","https://www.aldiwan.net/poem30556.html","الكامل"],[107,"يا أيها الداعي وليس بمسمع","https://www.aldiwan.net/poem43140.html","الكامل"],[50,"شجاني وأبلاني تذكر من أهوى","https://www.aldiwan.net/poem10420.html","الطويل"],[50,"يا صاحبي عصيت مصطبحا","https://www.aldiwan.net/poem62500.html","الكامل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62218","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39579","الخفيف"],[82,"وَرْدُ الخدودِ ونرّجسُ المُقَلِ","https://www.poetsgate.com/ViewPoem.aspx?id=3528",""],[164,"يا من رأى مثل ابن تاج الدين","https://www.aldiwan.net/poem58960.html","الكامل"],[173,"إلام أناجي قلب حيران واجم","https://www.aldiwan.net/poem1668.html",""],[190,"أيها الغر بالزما","https://www.aldiwan.net/poem43728.html","مجزوء الخفيف"],[199,"ما هاج شوقك من مغاني دمنة","https://www.aldiwan.net/poem54420.html","الكامل"],[240,"يا علاء الدين المرجى أعني","https://www.aldiwan.net/poem31634.html","الخفيف"],[275,"ودعتني عند السفين أصيلا","https://www.aldiwan.net/poem35191.html","الخفيف"],[275,"حواء أمك حبها أشقانا","https://www.aldiwan.net/poem35584.html","الكامل"],[275,"أدمشق ما أمضى سيوف بنيك","https://www.aldiwan.net/poem35644.html","الكامل"],[369,"أنا والرجاء وأنت والكرم","https://www.aldiwan.net/poem60667.html","أحذ الكامل"],[409,"ولما عراني الضعف من كل جانب","https://www.aldiwan.net/poem33893.html","الطويل"],[466,"أبى الله أن تمسي همومي صواحبي","https://www.aldiwan.net/poem15375.html","الطويل"],[484,"أمسى المساء كأمسنا","https://www.aldiwan.net/poem36927.html","مجزوء الكامل"],[505,"حي الربيع بزهره","https://www.aldiwan.net/poem37703.html","مجزوء الكامل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96999","الكامل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101554","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87280","المتدارك"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62564","الكامل"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/73951","الخفيف"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/127959","الكامل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124730","الرمل"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108476","الخفيف"],[2100,"","https://poetry.dctabudhabi.ae/diwan/poem/34952","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53133","الخفيف"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47105","الكامل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47126","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106879","الطويل"],[2769,"","https://poetry.dctabudhabi.ae/diwan/poem/98159","الكامل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205777","الخفيف"],[2888,"","https://poetry.dctabudhabi.ae/diwan/poem/46730","الكامل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109802","الكامل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134015","الطويل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134016","الكامل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67975","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74070","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62992","الكامل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102385","الكامل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102383","المتقارب"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138703",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91962","الرمل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86520","الكامل"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97076","الكامل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45052","الرمل"],[4291,"","https://poetry.dctabudhabi.ae/diwan/poem/142466","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120279","الطويل"],[4657,"","https://poetry.dctabudhabi.ae/diwan/poem/140146",""],[4858,"وما النصر إلا من عند الله","https://www.poetsgate.com/ViewPoem.aspx?id=175067",""],[4859,"حين يبتسم العراق!","https://www.poetsgate.com/ViewPoem.aspx?id=207986",""],[4927,"صَبْرٌ ودُمُوْعٌ","https://www.poetsgate.com/ViewPoem.aspx?id=29646",""],[5049,"المسكنة الله","https://www.poetsgate.com/ViewPoem.aspx?id=186335",""],[5121,"غَرِّدْ","https://www.poetsgate.com/ViewPoem.aspx?id=183758",""],[5183,"حلبة الرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=180224",""],[5183,"نهر الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=186612",""],[5186,"هون عليك ولا تضق صدرا","https://www.poetsgate.com/ViewPoem.aspx?id=156443",""],[5277,"المزّمّلة","https://www.poetsgate.com/ViewPoem.aspx?id=191649",""],[5285,"وللتذكرِ مبتدا","https://www.poetsgate.com/ViewPoem.aspx?id=203188",""],[5295,"شذا القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=210634",""],[5431,"عظُمَ الحنينُ وعنّفا ...","https://www.poetsgate.com/ViewPoem.aspx?id=198505",""],[5704,"الثعلب","https://www.poetsgate.com/ViewPoem.aspx?id=192536",""],[5720,"الأَرض (*)","https://www.poetsgate.com/ViewPoem.aspx?id=200226",""],[5765,"موتٌ ينادي للولادة !","https://www.poetsgate.com/ViewPoem.aspx?id=213304",""],[5804,"مساجلة مع جار الهنا","https://www.poetsgate.com/ViewPoem.aspx?id=190655",""],[5861,"لكم الحسنى آل البيت","https://www.poetsgate.com/ViewPoem.aspx?id=191772",""],[5897,"بشائر على أبواب المدينة","https://www.poetsgate.com/ViewPoem.aspx?id=157555",""],[5943,"إحساسُ الأمة في سقمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=45273",""],[5956,"شقاء الشوق ‏","https://www.poetsgate.com/ViewPoem.aspx?id=181907",""],[5956,"أقصوصة امرأة بوصلتها الجنس","https://www.poetsgate.com/ViewPoem.aspx?id=182704",""],[5956,"أيها البحر العاشق","https://www.poetsgate.com/ViewPoem.aspx?id=183229",""],[5956,"حدثٌ أليم","https://www.poetsgate.com/ViewPoem.aspx?id=193104",""],[5997,"عِلْمُ الْبَيَاْن","https://www.poetsgate.com/ViewPoem.aspx?id=214993",""]],"verses":[["فَتَزاجَروا مِن قَبلِ أَن تَرِدوا","بِمَوارِدٍ مُرٍّ تَرَشُّفُها",0,"ف",3,0],["فَتَزورَنا مَعَهُم زِيارَةَ آمنٍ","والسرُّ يا وَضَّاحُ لَيس بفَاشِي",1,"ش",2,0],["فتزاجروا عن غيِّهم وتصارحوا","نصحاً جلا الشبهات بعد ملاق",2,"ق",1,0],["فَتُزَرُّ لأمَتُهُ على أسَدٍ","وَتُلاثُ حَبْوَتُهُ على جَبَلِ",3,"ل",1,0],["فَتَزَعزَعَ الزورُ المُؤَسَّسُ عِندَهُ","وَبِناءُ هَذا الإِفكِ غَيرُ مَشيدِ",4,"د",1,0],["فَتَزول أَيّامُ النُحوسِ وَتَنقَضي","مِن حادِثاتِ الدَهرِ ما نَتَجَرَّعُ",5,"ع",1,0],["فَتَزدادُ عِندَ المَزجِ طيباً كَأَنَّها","إِشارَةُ مَن تَهوى إِلى كُلِّ ما تَهوى",6,"ا",1,0],["فَتَزَوَّدا مِنّي مُحادَثَةً","حَذَرَ العَصا لَم يُبقِ لي مَرَحا",7,"ح",2,0],["فَتَزَاوَرَتْ مِنْ طَيِّه وحِيَاضِهِ","ونَقِيِّ خِيمٍ كَالنِّسَاءِ الحُسَّرِ",8,"ر",1,0],["فتزوّدْ من النَّعي","مِ لأيامِك الأُخَرْ",9,"ر",1,0],["فتُزرّ لأمتُهُ على أسَدٍ","وتلاتُ حبوتهُ على جبلِ",10,"ل",1,0],["فتزحزحت تلك الصفوف واغمدت","تلك السيوف وفر كل سخين",11,"ن",1,0],["فَتُزعِجُها حَتّى كَأَن قَد أَصابَها","مِنَ المَسِّ ما لا يُتَّقى بِالتَمائِمِ",12,"م",1,0],["فتزوّد من التقى","قبل قبر ورمسه",13,"س",2,0],["فَتَزَوَّدا نَفَسَينِ ثُمَّ تَوَلَيّا","فَرِحَينِ غِبَّ الرَي أَن يَذَراها",14,"ا",3,0],["فَتَزَوَّجتُها وَقَد باعَدَ اللَ","هُ بِقُربي مِنها السَعادَةَ عَنّي",15,"ن",2,0],["فتزوّدتُ قُبلةً من يمينٍ","علّمَتني أن أُكثِرَ التقبيلا",16,"ل",2,0],["فتزوّدي إنّ الحياة قصيرةٌ","ويمرُّ كالطيرِ الجميلِ صِبانا",17,"ن",2,0],["فتُزلزلُ الدُّنيا لِرَكضِ جَوادِهِ","ويَكونُ مُنقِذَ مُلكِنا مُنجيك",18,"ك",1,0],["فتَزيدُ نُوراً كلّما كُتِمتْ","شمسُ الظّهيرة كيفَ تنكَتِم",19,"م",1,0],["فتزداد إيماناً على كل لحظة","كإيمان أصحاب الرسول ذوي بدر",20,"ر",1,0],["فتزدادُ حُسْناً بالبيان ولم يزلْ","بحسب قوى الفرسان تجري الضوامر",21,"ر",1,0],["فتزودوا بدعائهم","عند المساء وفي الصباح",22,"ح",1,0],["فتزاحم الأحباب ول","هانٌ ومولوعٌ كئيب",23,"ب",1,0],["فتزاحمت بهما اللواعج في الحشى","كتزاحم الأصوات في الأسماع",24,"ع",1,0],["فتزخرفت وتفوفت وتدبجت","كجنان عدنٍ قد ثوت بجوار نيل",25,"ل",1,0],["فَتزعزعُ أَركانَ القولِ","وَتردّ الصاغَ إِلى الصولِ",26,"ل",1,0],["فتزاحم الوُرّادُ حول جنابه","من كل قاصٍ قد أتاه ودانِ",27,"ن",1,0],["فتزود ان التقى خيرُ زادٍ","ونصيبُ اللبيبِ منه لبابُه",28,"ب",2,0],["فتزينت كل الجهات وأشرقت","واستقبلته بكامل الاقبال",29,"ل",1,0],["فتزوجت فلا عتقٌ يرى","بعد ما ماتت ولا عتقٌ سبق",30,"ق",1,0],["فتزود يا هاجر الدار منا","مدمعاً سائلاً وقلباً كئيبا",31,"ب",2,0],["فَتَزَوَّدنَّ لِيَومِ فَقرِكَ دائِباً","وَاِجمَع لِنَفسِكَ لا لِغَيرِكَ تَجمَعُ",32,"ع",1,0],["فتزود ليوم حشرك وانظر","ما إليه عما قليل تصير",33,"ر",1,0],["فَتَزَوَّدِ التّقوى وأيّة خلّة","يسعى لها مَنْ قد أريد نجاته",34,"ت",2,0],["فتزَوَّدِ التّقوى فإنّ وَلِيَّها","أَكْرِمْ به من سيّدٍِ محمودِ",35,"د",1,0],["فتزعجها أشباحُه وهي حوَّمٌ","تروح وتغدو في اىلأماكن روَّدا",36,"د",2,0],["فتزودوا من ثعلب فبكأس ما","شرب المبرد عن قليل يشرب",37,"ب",1,0],["فتزود من بشرة وسناه","وأسق منه أبناء عمي وخالي",38,"ل",2,0],["فَتَزَيَّنَت حُسناً أَتَمَّ تزيُّنٍ","وَتَنَفَّسَت طيباً أَلَذَّ تَنَفُّسِ",39,"س",1,0],["فتزيد بالتذكار نار غرامها","وتزيدها نار الغرام من الضنى",40,"ا",1,0],["فتزهو به الدنيا سروراً وبهجة","بكل مكان للسعادة واصل",41,"ل",1,0],["فتزينت دمياط من انواره","والثغر قابله بحسن تبسم",42,"م",1,0],["فتَزعزعتْ وتمايلتْ","وغدت تَميسُ من الطَّرَب",43,"ب",1,0],["فَتَزَلزَلَ الجبّار واِنفجَرَت","أَحشاؤُهُ وَتطاير الحممُ",44,"م",1,0],["فتزيلُه فتكاتُه","وتُذيقُه طعمَ الصغارِ",45,"ر",1,0],["فتزاوَرَتْ منهُ كأنَّ بدَفِّها","هِرّاً يُشَبِّثُ ضَبعَها بالأظفُرِ",46,"ر",1,0],["فتزداد حَمْياً شآبيبُهُ","وتزداد أوضاحُهنَّ احمِرارا",47,"ر",2,0],["فتزايدت احزانهن وهل لها","يوم خلا من فادح ومآتم",48,"م",1,0],["فَتزوّد من حياةٍ صفوُها","لَيسَ يَبقى وَليكن منهُ الأَقل",49,"ل",1,0],["فتزودوا تلك العلوم فإنها","لبلادكم من أنفس الأجلاب",50,"ب",1,0],["فتزلزل العرش المجيد وهتكت","غيظاً سرادقه مع الأستار",51,"ر",1,0],["فَتَزَوّد مِن قَليلٍ زائِلٍ","لِمُقامٍ شامِلٍ كُلّ الوَرى",52,"ر",2,0],["فتَزِلُّ عنكَ حَسِيرَةً ومن ارتقى","ما تَرْتَقيِهِ، فما لهُ نُظَرَاءُ",53,"ا",2,0],["فتزعم ان السعي احرمني العلى","فقلت بل الحرمان صيرني اسعى",54,"ع",2,0],["فتزينت بقدومه وتيمنت","بوروده الموفي على الآمال",55,"ل",1,0],["فتزلزلت أركانُ صهيون الخَنا","وتجرّعوا مُرّاً من الآلام",56,"م",1,0],["فتزهر كلّ رابيةٍ وتشدو","طيورُ النّصرِ أن حان الوفاقُ",57,"ق",1,0],["فَتَزَوَّدُوْاº إِنَّ الطَّرِيْقَ عَسِيْرَةٌ","وَالسَّيْرُ صَعْبٌº وَالْمَسِيْرُ طَوِيْلُ",58,"ل",1,0],["فتزكى من سوء وصف وتهدى","وتكون المرضى نفسا ودينا",59,"ن",2,0],["فَتَزَيَّنِي فِي خَاطِرِي بَرَّاقَةً","وَتَلَأْلَئِي فَوْقَ الْغُيُومِ بِبِالِيَا",60,"ل",3,0],["فتزيني وتبهرجي وتمايلي","هذا المجلى فوقه هارون",61,"ن",1,0],["فتزكو أمانيه ويحلو صباحه","وتزهو لياليه وتصفو مشاربه",62,"ب",2,0],["فتزعزعت أركان عفته","ولوى عن اليمنى إلى اليسرى",63,"ر",2,0],["فتزمّلي حينَ السرى","شوقاً تناثرَ في ترابكْ",64,"ك",1,0],["فتزيلُ عن وجهِ الحبيبِ عبوسَه","وتبثُ من عذبِ الحديثِ تودُّدا",65,"د",2,0],["فتزُفُّني للمجدِ مِثلَّ أميرةٍ","ما زُفَّ مِثْلي في الْوجودِ صَبايا",66,"ا",3,0],["فتزيدُ فيك تعلقي","متولها متصوفا!!!",67,"ف",2,0],["فتزهُو بذي الأخلاق منه وتنتشي","وتبدي له سرًّا عظيمًا مغيَّبا",68,"ب",2,0],["فتزدهر الديار بحُسْنِ فعلٍ","وتَتَّحدُ القلوبُ .. معَ القلُوبِ",69,"ب",1,0],["فتزمل الحمى على عرق الرؤى","سيفضُ عينيك انكشافُ يقينِ!",70,"ن",1,0],["فتزعزعوا فتحيّروا فتغيّظوا","وأنا بكفيّ عاملٌ وحُسامُ",71,"م",1,0],["فتزاحمت كل البلاد لكسرنا","نبقى سيوفاً للحسينِ يساندُ",72,"د",1,0],["فتزلزلَ الطغيانُ في وجهِ الهدى","واهتزَّ عرشُ البغيِ في الغزواتِ",73,"ت",1,0],["فتزيدُ بأقصانا وجعا","يحتاجُ لقلعٍ للأضراسْ",74,"س",1,0],["‏ ‏فتزداد أطباع الحمير سلامة","‏ ‏ عن الناس، والأطيارُ فوق البيادرِ",75,"ر",1,0],["فتزيد إمعانا بنقطة ضعفهم‎","حتى يضمّوا دونها الأولادا‎",76,"د",2,0],["فتزداد سحراً ومجدا أثيلا","ويزداد في روحك البارقُ",77,"ق",1,0],["فتزحلقْت قدماه من سُوْرٍ إلى","أرضٍ غدورٍ كلُّها صارت حُفَرْ",78,"ر",1,0],["فَتَزَيَّنَ الشّيْطَاْنُ فِيْ أَغْصَاْنِهَاْ","أَكَلاْ وَمَاْ كَاْدَاْ مِنَ الْعِنْقَاْدِ",79,"د",1,0]]}