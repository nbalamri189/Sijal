َ","https://www.poetsgate.com/ViewPoem.aspx?id=206050",""],[223,"ما لم تقله زرقاء اليمامة","https://www.poetsgate.com/ViewPoem.aspx?id=181142",""],[5409,"أحداث هذا الدهر تترى","https://www.poetsgate.com/ViewPoem.aspx?id=155276",""],[5409,"تحولت بعدك الأرياف والمدن","https://www.poetsgate.com/ViewPoem.aspx?id=155486",""],[5409,"لا عشت لصاً في ثياب عسيس","https://www.poetsgate.com/ViewPoem.aspx?id=155282",""],[5431,"فوضى تنبئُ أن كوكبنا انتهى","https://www.poetsgate.com/ViewPoem.aspx?id=185385",""],[5431,"قلب اليماني حبٌ كله وكفى!","https://www.poetsgate.com/ViewPoem.aspx?id=189732",""],[5431,"وبمثله هو يقتدي العظماء","https://www.poetsgate.com/ViewPoem.aspx?id=194798",""],[5431,"مازال يأسرني الإعجاز من شفة","https://www.poetsgate.com/ViewPoem.aspx?id=195158",""],[5431,"كي لا تُداس وتُكسرا","https://www.poetsgate.com/ViewPoem.aspx?id=196669",""],[5431,"ما كان لله أن ينسى أحبته ....","https://www.poetsgate.com/ViewPoem.aspx?id=200831",""],[5431,"طفلٌ على ضحكات شمسٍ يرقصُ","https://www.poetsgate.com/ViewPoem.aspx?id=200978",""],[5431,"هيتَ له ....","https://www.poetsgate.com/ViewPoem.aspx?id=202400",""],[5431,"مهجة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=205811",""],[5431,"باريس ...","https://www.poetsgate.com/ViewPoem.aspx?id=208588",""],[5442,"فوض أمورك من بين الأنام إلى","https://www.poetsgate.com/ViewPoem.aspx?id=114753",""],[5442,"اشرفت في السواد ذات الثور","https://www.poetsgate.com/ViewPoem.aspx?id=114768",""],[5442,"هذا اللقاء وما شفيت غليلا","https://www.poetsgate.com/ViewPoem.aspx?id=114739",""],[5528,"من مثل أحمد..؟ ﷺ","https://www.poetsgate.com/ViewPoem.aspx?id=200986",""],[5689,"ضاقت بمن في ظلها الآجام","https://www.poetsgate.com/ViewPoem.aspx?id=143413",""],[5829,"انت الشآم","https://www.poetsgate.com/ViewPoem.aspx?id=150260",""],[5953,"فوض أمورك جمعا","https://www.poetsgate.com/ViewPoem.aspx?id=93875",""],[5956,"أ أصبر؟؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=182479",""],[5956,"ترعَى الصداقةَ كندةُ الحمدونُ","https://www.poetsgate.com/ViewPoem.aspx?id=207260",""],[6070,"فَوِّضْ أمُورَكَ لِلذي سوَّاكا","https://www.poetsgate.com/ViewPoem.aspx?id=189546",""],[6093,"ذَارِيْ الرِّيْحِ","https://www.poetsgate.com/ViewPoem.aspx?id=187943",""],[6093,"فوضى مشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=215942",""],[6152,"مناجاة العشر الأواخر","https://www.poetsgate.com/ViewPoem.aspx?id=204735",""],[6262,"جُثَّتي تقتفي خُطاي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80124&r=&rc=22",""]],"verses":[["فَوَّضَتِ الدُنيا إِلَيهِ أَمرَها","وَقَلَّدَتهُ نَفعَها وَضَرَّها",0,"ر",3,0],["فوض الجامع السعيد لمن يد","عى له فيه بالضحى والعشيّ",1,"ي",1,1],["فَوَضَعتُ غَيرَ غَبيطِهِ أَثقالَهُ","بِسِباءِ لا حَصِرٍ وَلا وَغّالِ",2,"ل",1,0],["فَوَضَعنَ أَزفَلَةً وَرَدنَ بِها","بَحراً خَسيفاً طَيِّبَ الشُربِ",3,"ب",1,0],["فَوِّض إِلى اللَه فيما أَنتَ خائِفُه","وَتِقْ بِمُعتَضِدٍ بِاللَهِ يَغتَفِرُ",4,"ر",1,0],["فَوَّضَ أَمرَ المُلكَ مِن مُحَمَّدٍ","الناصِرِ المَلِكَ إِلى مُحَمَّدِ",5,"د",1,0],["فَوُضِعتَ لِلَّهِ المُهَيمِنِ ساجِداً","وَاِستَبشَرَت بِظُهورِكَ الأَكوانُ",6,"ن",1,0],["فَوَضَعتُ كَفّي عِندَ مَقطَعِ خَصرِها","فَتَنَفَّسَت نَفَساً فَلَم تَتَلَهَّجِ",7,"ج",1,0],["فَوَضَعوا في رَأسِهِ السِياطا","وَجَعَلوا يُردونَهُ شَطاطا",8,"ط",2,0],["فَوَضَعتُ وَجدي بِالتَنَفُّسِ وَالبُكا","وَرَأَيتُ ماءَ المُزنِ كَيفَ يَجودُ",9,"د",1,0],["فَوَّضتُ أمري إليه إنه رجلٌ","فيه إلى المجد والعلياء تفويض",10,"ض",1,0],["فوضعت في أيمانهم","يمناك عقدا لا يزاح",11,"ح",1,0],["فوَّضتُه وحَمَلت ألفَ مصيبة","من أجل أن راح الفوآدُ مفوَّضا",12,"ض",2,0],["فَوِّض إِلى اللَه فيما أَنتَ خائِفُه","وَثقْ بِمُعتَضِدٍ بِاللَهِ يَغتَفِرُ",13,"ر",1,0],["فَوَضَعْتُ كَفِّي عِنْدَ مَقْطَعِ خَصْرِها","فَتَنَفَّسَتْ نَفَساً فَلَمْ تَتَهَلَّجِ",14,"ج",1,0],["فوضعت خد الاعتذار على الثرى","وشرعت أذكر عهد ود قد نسى",15,"س",2,0],["فوضعت وجهك في التراب معفرا","تلك الخدود لوجهك الميمون",16,"ن",1,0],["فوّض أمورك في الخطو","ب إلى المدبّر للسرار",17,"ر",1,0],["فوّضتُ أمري إلى من","يُرْجَى لكلّ الأمورِ",18,"ر",1,0],["فوضى من الألوان يأْخذ مزجها","بمجامع الأبصار والأَلباب",19,"ب",1,0],["فَوِّض إِلى أَكبادِنا ذِكرَ مَن","يَفيضُ مِن ذِكرِكَ غُدرانُ",20,"ن",1,0],["فوِّض إليَّ أكُن إلَي","كَ بِما أَقولُ مُفَوّضا",21,"ض",2,0],["فوضت أمري إلى من هو بحالي عليم","الله مولاي ذو الفضل العظيم العميم",22,"م",1,1],["فَوِّض الأمرَ راضِيا","جَفَّ بالكائِنِ القَلَمْ",23,"م",1,1],["فوَّضتُ أمرِي إليهمُ ثِقَةً","بِهمْ فلمّا تحكَّمُوا ظَلَمُوا",24,"م",3,0],["فَوَّض الأمر إليه مَلِكٌ","ما جَرَتْ إلاَّ بما شاء الأمور",25,"ر",1,0],["فوضت أمري إلى ذي القدرة الصمد","نعم الخليفة في مالي وفي ولدي",26,"د",2,1],["فوضت أمري إليك اللَه متكلا","إلا عليك وراج منك تجديني",27,"ن",2,0],["فوضعتها لبَّ الفؤادِ لما حَوَتْ","من حُسْن ألفاظ كزهر يانع",28,"ع",1,0],["فوضى بها اندثرت أخلاق من غبنوا","ومثلها صارت الثروات تندثر",29,"ر",1,0],["فوضعت فوقه قبلة","قد أشعرتها بالمفيد",30,"د",1,0],["فوضت في باريس تفعل ما تشا","ممن غدا لرسوله مخدوما",31,"م",2,0],["فوضَعتُ كفِّى تحتَ خدِّىَ خاضِعا","ووضَعتُ أُخرى فوقَ قلبي المُرهَفِ",32,"ف",1,0],["فوضع صحيح به مؤمنون","على مقتضى حكم أرسالها",33,"ل",3,0],["فَوضى وَرَفضاً تَتَبَعُ الأَظلالا","قَطَعتُ لَمّا آَزَتِ الظِلالا",34,"ل",2,0],["فوضتُ أمري إلى اللهِ المهيمن في","حَلٍّ وعقدٍ وإيرادٍ وغصدارِ",35,"ر",1,0],["فوضت أمري للذي لم يضع","من أحسن الظن ومن فوضا",36,"ض",2,0],["فوضى أقلية تودي بمملكة","فكيف تترك فوضى الأكثريات",37,"ت",1,0],["فوضى عمني بطولك ما أب","صر عرضا من لون عرضك أنقى",38,"ق",2,0],["فوَضَعْتُ في جَيْبي يَدَ","يَّ وقُلْت خلُّوني وإِلاّ",39,"ل",2,0],["فَوْضَى كأمْثَالِ القَطَا المُنْجَفِلِ","عَجلى إلى المستوفزِ المُسْتَعْجِل",40,"ل",1,0],["فوّض الأمر إلى من","هو بالأمر أحق",41,"ق",1,0],["فوضوءه نقضٌ ويمضي صومه","فاسمع وما سمعكَ ذا وفرِ",42,"ر",1,0],["فوضعت مالك جنب علمك نفحة","للناس في صحف وقين نحولا",43,"ل",2,0],["فوضعت سيفك فيهم فابادهم","تلفاً فديتك متلفاً ومعيدا",44,"د",2,0],["فوّضت الدنيا إليه أمرها","صبابة منها بعظم شانه",45,"ه",1,0],["فوضعتم لهم من باب الألقاب ما","تستقبحون وذا من العدوان",46,"ن",1,0],["فَوضعتُ في فَمه فمي فعل الَّذي","يَهوى بريق حَبيبه المَعسولِ",47,"ل",1,0],["فوض إلى ملك الملوك الأمر في","أحكامه وأقبل ولاتك معرضا",48,"ض",2,0],["فوضعتها فوق الضلوع فأنعشت","قلبي وهزّت للسعادة روحي",49,"ح",2,0],["فوضت أمري للذي","تخذته معتمدي",50,"د",2,1],["فَوِّض إِلَيهِ الَّذي تَخشاهُ مِن خَطَرٍ","تُوقَ المَخوفِ وَيُرمَ الضِدُّ بِالصَعدِ",51,"د",1,0],["فوضعوا الرأس على ذاك الحجر","فخص بالتشريف من ذاك الاثر",52,"ر",1,0],["فوضى تدمر ما بنى ال","باني وما شاد الأول",53,"ل",1,0],["فوضت للربع القديم العافي","طرفا يسح بواكف ذراف",54,"ف",1,1],["فوضعت من عبء الأسى كفى على","صدري وقلت اليوم أندب مجدها",55,"د",3,0],["فوضعوا المنطق منه يعرف","موضوعه الحجة والمعرف",56,"ف",1,0],["فوّضت أمري إليك يا حاضرا","وغير غائب ترى ناديا",57,"د",3,0],["فوضّ ما بي من جوى وصبابة","لا زال فيكم للمؤمل مطمع",58,"ع",1,0],["فوّضت فيما ترتضيه وإنني","ما زلت فيما ترتضيه مفوّضا",59,"ض",2,0],["فوض أمرك لتدبيره ودب في مدابه","قم على الحد والزم ما لزمك الوفا به",60,"ب",2,0],["فوض إليه راضياً متأدباً","نعم الإلهُ العالمُ الجبارُ",61,"ر",1,0],["فَوَّضْتُ أمري للذي","خلق المَودّةَ والنُّفور",62,"ر",1,0],["فَوضَ إليَّ حَديِثَ البانِ وأرض بهَا","لدَّاءَ لا حيفَ يعروها ولا كَذبُ",63,"ب",1,0],["فَوَضَعْتُ مِلْحاً فَوْقَ جُرْحٍ نَاْزِفٍ","وَتَفَاْقَمَ الإِيْلاْمُº وَالإِحْفَاْظُ",64,"ظ",1,0],["فوضت أمري للإله فإنه","بعباده هو يعلم الأسرارا",65,"ر",2,0],["فوضت للحق المجيب قضيتي","وتركت أوراقي هنالك مودعة",66,"ع",2,0],["فَوَّضْتُ وجهكَ في عيوني أوَّلاً","وجعلتُ نورَ بَصيرتي ثانيها",67,"ي",3,0],["فَوَضَعتُ كَفِّيْ فَوْقَ رَأْسِيْ ، مُغْمِضًا","عَيْنَيَّ عَنْ مَرْأًى يَفُتُّ الْأَحْجُرَا",68,"ر",2,0],["فوضى انخرطنا في المتاهةِ والرؤى","حَرَمٌ مِن الذكرى يُرتِّب صَفَّنا",69,"ن",2,0],["فوضعتُ في الخدّ اليمين تحيتي","قُبَلا وكنتُ من الشمال على شَفا",70,"ف",2,0],["فوضى كأنَّ الأرضَ تهتزُّ تحتي","لغْوٌ كما وجهي عبوسَ القَطوب ِ",71,"ب",1,0],["فَوَّضْتُ أمْريْ لِلْمُهَيْمِنِ كُلَّهُ","مُحْيِيْ الْخَلائِقِ دَبَّرَ الْأَفْلاكا",72,"ك",2,0],["فَوَّضْتُ أَمْرِي للْمُهَيْمِنِ وَحْدَهُ","فازْدَادَ بِالْفَرَجِ الْقَرِيْبِ يَقِيْنِي",73,"ن",2,0],["فوضتُ أمري للعظيم فانهُ","ربي ويعلمُ داخلي وينيرُ",74,"ر",1,0],["فوضعتُ طيَّ قميصِها قلبي وقدْ","سكبتْ دموعَ الروحِ في الأزرارِ",75,"ر",1,0],["فوضى استثاراتي.. ووجهي متعبُ","ومآل أحلامي إلى ما يصعبُ",76,"ب",1,1],["فوضى التماعةِ نجمٍ لاحقتْ طُرُقي","منها تشظّى المدى يبكي على مزقي",77,"ق",2,1],["فَوضى وتنبئ كل من مرّت بهم","سيعود سيفُ القرمطيّ ليثأرا",78,"ر",2,0],["فوضى إذن لم لا تطي","ر فليس غرك منك أحرى",79,"ر",2,0],["فوضى إذا أزمنت في كل مجتمع","عادت نظاماً فلا حيف ولا غبن",80,"ن",1,0],["فوضي وما برحت تبرر فعل من","وجدته أتقن مهنة التلبيس",81,"س",1,0],["فوضى تنبئُ أن كوكبنا انتهى","قلبي ينادي معلنا ايمانه",82,"ن",2,0],["فوضى تُثارُ وترمي عنه منسأةَ","لانعلم الغيب .. مات الغيب لو عرفا",83,"ف",2,0],["فوضى تأبّطت الزمان كأنه","أضغاث حلم مفزعٍ ..وخواءُ",84,"ا",2,0],["فوضى تُعيد لنا الرؤيا بلا وجس","فالشك يمنحنا (من نوره) ومضا",85,"ض",2,0],["فوضعته في نجمة","ووهبت روحي كوثرا",86,"ر",2,0],["فوضى الحواس رياح الذات عاصفة","طيفي سرابٌ إلى اللاشيَ مجرورٌ",87,"ر",1,0],["فوضى الطفولة غيمةٌ تهمي به","وبضحكة من طينه يتخلّصُ",88,"ص",1,0],["فوضى تُنبئُ أنّ ثمّة معضلةْ","تأوي إلى الحسّ الرهيف لتصقله!",89,"ل",2,1],["فوضى تُهدّم بعد عشقٍ مابنت !","وتبيح للغربانِ سطوا هيكله !!",89,"ل",2,0],["فوضى تُقطّع حبلها من قلبه","ليسيلَ منها نازفا في (هيتَ له )!",89,"ل",2,0],["فوضوي الحواس كالعشب ليلا","فيه جوّ من البراءة أنقى !!",90,"ق",2,0],["فوضى تبوتقُها بالقلب صاهرة","سيل التضاد بوهج الحب باريسُ",91,"س",1,0],["فوض أمورك من بين الأنام إلى","من في يديه زمام النفع والضرر",92,"ر",1,1],["فوضعنا الجباه لله شكراً","في ثري ذلك التراب الطهور",93,"ر",1,0],["فوضعت كفك في الإناء فمعهم","غرر بفضل وصلواتهم وحجولا",94,"ل",2,0],["فوْضَى ونَهْبٌ للعُداةِ بِمَا جَنَتْ","أيْدِي العُصَاةِ فحالنا يُبْكِي الصّفَا",95,"ف",2,0],["فوضى النهى مسترحمين وهل ترى","يجدي لدى صم الصفا استرحام؟",96,"م",1,0],["فوضى منظمة يدير أتونها","من بات مفتونا من الإثراء",97,"ا",2,0],["فوض أمورك جمعا","إلى الملاء الوفي",98,"ي",1,1],["فوضِّح وفسِّرْ لعقليَ واْشرحْ","أ جِدٌّ جفاؤك أم مِن فنونْ؟",99,"ن",1,0],["فوَّضتُ للقيُّومِ بِنْتي كندةً","ونذيرَها لهما القلوبُ عرينُ",100,"ن",1,0],["فوَّضتُ أمرَه للمهمين وحدِه","فهو المحبُّ لراغبٍ وضمينُ",100,"ن",1,0],["فَوِّضْ أمُورَكَ لِلذي سوَّاكا","مِنْ نطْفَةٍ فِي صُلبِ مَنْ آواكا",101,"ك",2,1],["فَوَضْحَاءُ المَسِيْرِ تَدُوْسُ قَلْبَاً","إِذا مَا أتْبَعَتْ وَخْدَاً رَسِيْمَا",102,"م",2,0],["فوضى المشاعر مثل حال قصائدي","رفضوا لأجلك منهج التهذيب",103,"ب",1,0],["فوضت أمري له ربي فألهمني","رشدي وحررني من قيد أحزاني",104,"ن",2,0],["فوضويٌّ أنا فلستُ أبالي","أيَّ موتٍ وأيَّ حُبٍّ سأُرضى",105,"ض",2,0]]}