{"poems":[[95,"وارحمتا لمصاب","https://www.aldiwan.net/poem11151.html","المجتث"],[74,"قالت خزائن علم إن شكا ألما","https://www.aldiwan.net/poem19452.html","البسيط"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[102,"في اللّيل","https://www.poetsgate.com/ViewPoem.aspx?id=50151",""],[119,"سارت تزمزم للحمى الركبان","https://www.aldiwan.net/poem40480.html","عموديه"],[469,"شهرت علي صوارم العذل","https://www.aldiwan.net/poem3349.html","عموديه"],[484,"أطرق بكفك بابا غير موصود","https://www.aldiwan.net/poem36942.html","البسيط"],[520,"ما عن هوى الرشأ العذري أعذار","https://www.aldiwan.net/poem12136.html","البسيط"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66726","البسيط"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44568","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48849","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96708","البسيط"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77969","الكامل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141272","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132551","السريع"],[3471,"","https://poetry.dctabudhabi.ae/diwan/poem/56452","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91214","الكامل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66613","البسيط"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76458","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111507","الكامل"],[3999,"","https://poetry.dctabudhabi.ae/diwan/poem/111601","البسيط"],[4126,"","https://poetry.dctabudhabi.ae/diwan/poem/126355","السريع"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33506","الكامل"],[4764,"روحي عصيه والرضا اجباري","https://www.poetsgate.com/ViewPoem.aspx?id=26732",""],[4955,"إن لم يرق لك رأي غيرك لا تكن","https://www.poetsgate.com/ViewPoem.aspx?id=187739",""],[5216,"تحية للدكتور محمد البدري","https://www.poetsgate.com/ViewPoem.aspx?id=187620",""],[5447,"سيحيا الفيلسوف","https://www.poetsgate.com/ViewPoem.aspx?id=208347",""],[5595,"كركوكُ يا ألم َالأحرار ِفي بلدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=144619",""],[5887,"قال السجين","https://www.poetsgate.com/ViewPoem.aspx?id=35277",""],[5939,"لستِ أنثى!","https://www.poetsgate.com/ViewPoem.aspx?id=185492",""],[6238,"لُباب الحُب...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86777&r=&rc=6",""]],"verses":[["هَذَا أَخٌ لَكَ عَانَى","كَرَّ المَنَايَا بِسُوحِهْ",0,"ح",2,0],["هذا أخوه الذي بالسعدِ أنعته","الله يبقي لنا في عمرِه البركه",1,"ه",1,0],["هذا اختصارُ الفَرش من مقالي","وبعدَهُ أقولُ في المِثالِ",2,"ل",1,0],["هذا أخي يروي وأظما ليس لي","في النهر لا حقّ ولا استحقاق",3,"ق",1,0],["هذا اخو وله وذاك متيم","ولذاك ذو دهش وذا حيران",4,"ن",1,0],["هذا أخير الأنبياء غدا","وهو الشفيع وسيدّ الرُّسل",5,"ل",1,0],["هذا اختياري وحاشا أن أخيب به","ظنا وإن يك سعيي غير محمود",6,"د",1,0],["هذا اختياري فوافق إن رضيت به","أولا فدعني وما أهوى وأختار",7,"ر",1,0],["هذا أخي ووصيِّي في الأمور ومن","يَقوم فيكم مَقامي عند تَذكاري",8,"ر",2,0],["هذا اِختِياري فَأَبصِروهُ","شاهِدُ عَقلِ الفَتى اِختِيارُهْ",9,"ر",2,0],["هذا أخٌ لكمُ عرفتم جهرَه","وضميرَه والفضلَ والآدابا",10,"ب",2,0],["هذا أخوكَ أبو دهمان خير أخٍ","ندب أخو ثقةٍ حمّال أثقالِ",11,"ل",1,0],["هَذا أَخوك أَلَيسَ ربكما معاً","أَحَداً أَلَيسَ نبيكم خير الوَرى",12,"ر",2,0],["هذا أخوكم فهاتوا العون يعضده","ولا تخلوه رهن اليأس والهون",13,"ن",1,0],["هذا أخوها المستهل الندي","بدر سماء الفضل بحر الهبات",14,"ت",1,0],["هذا أخٌ لك يَشتكي إذ تشتكي","وكذا الخليلُ إذا أَحَبَّ خَلِيلا",15,"ل",2,0],["هَذا أَخو العَليا وَتِلكَ جَمالها","داما كما راما وَدامَت غبطةُ",16,"ه",1,0],["هذَا اخْتِصاصٌ إلهِيٌّ وَمَرْتَبَةٌ","ما فِي المُلُوكِ عَلَيْها مَن يُزاحِمُهُ",17,"م",2,0],["هَذا اخوكم وَهَذا بعض طينتكم","مِمّا امتزجتم به ياناس قد مزجا",18,"ج",2,0],["هذا أخيل وتلك سطوته","كالرب صال تروع صولته",19,"ه",1,0],["هذا أخي وشقيقي المرتَضى ويَدي ال","يُمنى وموضع إسراري وإعلاني",20,"ن",2,0],["هذا اختباري بعد ما مرَّ بي","ما عشرهُ شيَّب رأسَ الوليد",21,"د",1,0],["هذا أخٌ لكَ يشتكي أو يُشتكى","وكذا الخليلُ إذا أجلَّ خليلا",22,"ل",2,0],["هَذا إختياري .. وهَقوتي يِسعدني","درب الهوى وصى وقال إختاري",23,"ر",2,0],["هذا اختلافٌ لا خلافٌ يا أخي","فلنستفد من سيرةِ المختارِ",24,"ر",1,0],["هذا أخي بالعلمِ زانَ بلادنا","فانثُر منَ الدرِّ الثمينِ قصائِدا",25,"د",2,0],["هذا اختلاطٌ يا صديقي رائقٌ","خمرٌ مريرٌ بَيْدَ أنَّ له صروفْ",26,"ف",1,0],["هَذا أخونا أيادُ الدّين يَجمعُنا","به العراقُ تبَاهى حينَ يبتسِم ُ",27,"م",1,0],["هذا أخي يبكي هنا","يوما عصيبا إذ حضر",28,"ر",1,0],["هذا اختيارُكِ فاعذِريني إنّني","حاولتُ جدًّا ثمّ ضاقَ الذَّرْعُ",29,"ع",1,0],["هذا أخي... لكنَّ حُبي قاتلي","والحُبُّ يا هذا اتِّباعُ طِلابِهِ",30,"ب",2,0]]}