ps://www.poetsgate.com/ViewPoem.aspx?id=113116",""],[5273,"خطاب من الشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=175271",""],[5277,"مريمُ..عليها السلام..القطوفُ القُدْسيّةُ","https://www.poetsgate.com/ViewPoem.aspx?id=199954",""],[5277,"صَلُّوا عَلَيْهِ وَسَلِّمُوا تَسْلِيمًا","https://www.poetsgate.com/ViewPoem.aspx?id=200675",""],[5277,"آهةٌ خرساءُ","https://www.poetsgate.com/ViewPoem.aspx?id=205799",""],[5277,"وللهوى عطره","https://www.poetsgate.com/ViewPoem.aspx?id=206207",""],[5277,"العشرُ العجاف","https://www.poetsgate.com/ViewPoem.aspx?id=214857",""],[5310,"إِلَى السَّمَاءِ الثَّامِنَةِ","https://www.poetsgate.com/ViewPoem.aspx?id=215363",""],[5320,"تحية نصر","https://www.poetsgate.com/ViewPoem.aspx?id=42037",""],[592,"أهاجك رسم بالديار الدوائر","https://www.poetsgate.com/ViewPoem.aspx?id=128849",""],[592,"الحمد لله حمداً دائماً وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=128796",""],[5370,"كوشة فرحها","https://www.poetsgate.com/ViewPoem.aspx?id=87580",""],[5409,"ردوا إلى أريافكم ردوا","https://www.poetsgate.com/ViewPoem.aspx?id=155262",""],[5431,"وإن ضاقتِ السُبْلُ","https://www.poetsgate.com/ViewPoem.aspx?id=190098",""],[5431,"معنى الرجولة..","https://www.poetsgate.com/ViewPoem.aspx?id=195355",""],[5431,"قد جئت دهرك ثائرا ووحيدا","https://www.poetsgate.com/ViewPoem.aspx?id=196789",""],[5688,"خلّوا الدموع تَسرّب","https://www.poetsgate.com/ViewPoem.aspx?id=200824",""],[3856,"مَعنًى يُجَاهِدُ فِي شِفاهِ الأبكَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=215913",""],[5902,"جوى يتلظى فِي الْفُؤَاد استعاره","https://www.poetsgate.com/ViewPoem.aspx?id=189170",""],[5906,"أجراس الحكمة","https://www.poetsgate.com/ViewPoem.aspx?id=188073",""],[5908,"تعرفت منهم بالغربين أربعا","https://www.poetsgate.com/ViewPoem.aspx?id=170975",""],[5953,"الله أكبر أكبر الله","https://www.poetsgate.com/ViewPoem.aspx?id=93797",""],[5956,"لا عدل في الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=192298",""],[5956,"أبطال فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=192326",""],[5956,"ديمقراطية الدمويِّين","https://www.poetsgate.com/ViewPoem.aspx?id=192364",""],[5956,"الناي مَرْضِيّة دنيا وآخرةً","https://www.poetsgate.com/ViewPoem.aspx?id=193574",""],[5956,"معنى السعوديين واليمنيين خالد والعصفور","https://www.poetsgate.com/ViewPoem.aspx?id=193768",""],[5956,"رائد الأفضال في الأجيالِ","https://www.poetsgate.com/ViewPoem.aspx?id=205487",""],[6038,"سحر العيون","https://www.poetsgate.com/ViewPoem.aspx?id=32327",""],[6093,"بوصلة","https://www.poetsgate.com/ViewPoem.aspx?id=199959",""],[6115,"بذكرالله المولى نبدا صباح الخير","https://www.poetsgate.com/ViewPoem.aspx?id=180621",""],[5724,"يا ليل ظلامك يحبسني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55136&r=&rc=3",""],[6189,"فيروز أغنية العش الأولى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83597&r=&rc=64",""],[6204,"شاعر الوجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69141&r=&rc=13",""],[572,"أخٌ لي كُنتُ أُغبَطُ باعتقادِه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9249&r=&rc=106",""],[4890,"أغنية إلى المعنى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75271&r=&rc=383",""]],"verses":[["مَعنىً أَلَذُّ مِنَ الشَما","تَةِ بِالعَدُوِّ المُدبِرِ",0,"ر",1,0],["مَعنىً بَديعٌ وَأَلفاظٌ مُنَقَّحَةٌ","غَريبَةٌ وَقَوافٍ كُلُّها نَخَبُ",1,"ب",1,0],["مَعنى الهَوى أَنتَ وَشَخصُ المُنى","دَعنِيَ مِمّا يَزعُمُ الزاعِمُ",2,"م",1,0],["مَعنَاهُ مَا أَبْلَغَ وَاللَّفَّظُ مَا","أَفْصَحَ وَالأُسْلُوبُ مَا أَرْصَنَهْ",3,"ن",2,0],["مَعْنَى الحَيَاةِ يُجْتَلَى","فِي الوَقْتِ إِذْ نُبْصِرُهْ",4,"ر",2,0],["مَع نَدامى بيضِ الوُجوهِ كِرامٍ","نُبِّهوا بَعدَ خَفقَةِ الأَشراطِ",5,"ط",1,0],["معنى الفضائل والندى والبأس لي","والسيف مشتهرٌ بمعنًى واحد",6,"د",1,1],["معنى بوسنان اللواحظ سارق","كرى مقلتي من حيث أدري ولا أدرِي",7,"ر",2,0],["مع نزوعي إلى هوى كل بدرٍ","لستُ عنهُ بالمعتاض",8,"ض",1,0],["معنى بذي قدٍّ ثنى الرمح تابعاً","لأدرب منه في الطعان وأحذق",9,"ق",1,0],["معنى بظبيٍ ينهب الناس لحظه","ويعزي إليهم كلّ سور وخندق",9,"ق",1,0],["معناه معنى الشباب مقتبلاً","وشكله المستطيل كالهرم",10,"م",1,0],["مَعناهُ في شَفَتَي مَن حَلَّ مُنعقداً","عَنِ التَهَجّي إِلى خَلقٍ لَهُ فاهوا",11,"ه",3,0],["مَعنُ لَوِ اِنتابَها","أَدرَكَ مَعنى الكَرَم",12,"م",1,0],["مُعَنّىً بِإِعجالِ البَطيءِ إِذا اِحتَبى","وَصَبَّ بِتَقديمِ المُزَجّى المُؤَخَّرِ",13,"ر",1,0],["مُعَنّاً بِهِ الصَبُّ الشَجِيُّ المُعَذَّلُ","عَلَيهِ وَذو الحُبِّ المُعَنّى المُعَذَّلُ",14,"ل",1,0],["مَعنى الحَياةِ لِكُلِّ شَعبٍ ناهِضٍ","تاجٌ يُضيءُ سَبيلَهُ وَسَريرُ",15,"ر",1,0],["مَعْنَى التفوّقِ في الحياةِ فَمَن أبى","إلا الصُّدودَ فما درى مَعناهُ",16,"ا",2,0],["مُعَنّىً بِذكرى كُلِّ خَودٍ تَخالُها","إِذا نَظَرَت حَوراءَ بِالفَرشِ مُغزِلا",17,"ل",2,0],["معناه مَنْ لَمْ يكنْ كَوالدِهِ","فَهْوَ لَقيطٌ رَمَتْ به قَحْبَهْ",18,"ب",2,0],["مَعْنَى الوجودِ الذي قامَ الوجودُ به","وهلْ بِغَيْرِ المَعاني قامَتِ الصُّوَرُ",19,"ر",1,0],["مَعنىً خَبيءٌ عَلى ما بانَ مِنهُ كَما","تُبنى الزَوائِدُ مِن يا أَوسُ لا تَنَمِ",20,"م",1,0],["مَعَنا زِقُّ إِلى سُمَّهَةٍ","تَسِقُ الآكَالَ مِن رَطبٍ وَهَش",21,"ش",1,0],["مُعَنِّسَةٌ إنْ جاءها الرّمْحُ خاطِباً","سقَتْهُ ذُعافَ الموتِ شَمطاءُ عانِس",22,"س",1,0],["مَعْنَى المُرُوءَةِ فِي الهُمَامِ وَحُسْنُهُ","حُسْنُ الفَرِيدَةِ فِي نِظَامِ حِلاَكَا",23,"ك",2,0],["مَعناكَ في القَلبِ كانَ أَحلى","مِنَ الأَمانِيِّ وَالأَمانِ",24,"ن",1,1],["مُعَنًّى بهِ الصْبّ الشّجيُّ، المُعَذَّلُ","عَلَيْهِ، وَذو الحُبّ المُعنّى المُعَذَّلُ",25,"ل",1,0],["معنى تخف به الرجاح ونكتة","هي للعقول وطورها ديوان",26,"ن",1,0],["معناه نصب عيني","ثناه في سماعي",27,"ع",2,0],["معناك قبلة عين روح","ي في المحافل والمحاضر",28,"ر",1,0],["معنبر نقشته","بولح نور يد اللَه",29,"ل",2,0],["مَعنونَةٌ سِربٌ بِها مَطرودَةٌ","مُتَقَنَّصٌ سِربٌ بِها مَشلولُ",30,"ل",1,0],["مَعْنَاكِ سِرٌّ غَرِيبُهٌ عَجَبٌ","يَبْنِي ظِلالاً أَعْيَتْ منِ اسْتَعْيَا!",31,"ي",2,0],["معنوي لم يستحل بانعكاس","عند تصريفه تزول الملامه",32,"م",2,0],["معنىً من العلَّة الأولى التي سبقتْ","خَلْق الهيولىَ وبسَطْ الأرض والمَدَرِ",33,"ر",1,0],["معنُ بنُ زائدةِ الهمامُ رفيقُهُ","في الذودِ عن عربيّةٍ عطبول",34,"ل",1,0],["مَعْنىً بَلِيغاً وَاَلْفاظاً يَرُقْنَ وَأَغْ","راضاً يَفُقْنَ وَبَحْراً لَيْسَ يُنْتَزَحُ",35,"ح",1,0],["معنى به طينة قد شرُفت","إذا يزول تُساوى الطين والخزفا",36,"ف",2,0],["معنّىً كلَّما هبَّت شَمالٌ","تذكَّر ذلك العيش المهنّا",37,"ن",2,0],["مَعناهُ أَولادَكُم جَميعاً","أَبناءَ أَسباطِكَ الظَهيرَةِ",38,"ر",2,0],["مَعنى القَديمِ بِالحَديثِ مُشهَدٌ","لِناظِري مُغَيِّبٌ عَنِ الفِكَر",39,"ر",1,0],["مَعنى المَعاني اِسمُهُ ظاهِرٌ","وَظاهِرُ الاِسمِ لَهُ رَسولُ",40,"ل",1,1],["مَعنى الكِتابِ لَدَيهِ","عِبارَةً في رُقومِه",41,"م",2,0],["مَعْ نورهِ كيف استَتر","أَوجُهُه حينَ سفَر",42,"ر",1,0],["مَعنىً مِنَ الكَرَمِ المَهجورِ فُزتُ بِهِ","وَفي الرِثاءِ لِمَن لا يُرتَجى كَرَمُ",43,"م",1,0],["مُعَنّى بِريحِ شَمالِ الشَآمِ","لَقَد عَذَّبَ اللَهُ بِالريحِ روحَه",44,"ح",2,0],["معناك صخرٌ أساسٌ محكَمٌ أبداً","عليك يُبنَى بنا إيمانَ مبناكا",45,"ك",2,0],["معنى الزَّمانِ على الحَقيقَةِ كاسمِهِ","فعلامَ نرجو أنَّهُ لا يُزمِنُ",46,"ن",1,0],["مَعنُ بنُ زائِدَةَ الموفي بِذِمَّتِهِ","وَالمُشتَري المَجدَ بِالغالي مِنَ الثَمَنِ",47,"ن",1,0],["مَعنُ بنُ زائِدَةَ الَّذي زيدَت بِهِ","شَرَفاً عَلى شَرَفٍ بَنو شَيبانِ",48,"ن",1,0],["معنية تعني إليك بأنّ لا","أهلٌ سواكَ لها ولا أبناء",49,"ا",2,0],["مُعنّىً بأفلاذِ قلبٍ حوامٍ","تُباري إلى كلّ ماءٍ سمامَهْ",50,"م",2,0],["معنى الحياة ابتسام لا يفارقها","وإن أحيطت بجدب غير بسام",51,"م",1,0],["معنويات الذي أغنى به","لؤلؤ حين أجافي الصدفه",52,"ف",2,0],["معنَّسة أفنيت عمرَ شبابها","فلم يبقَ إلا الشيبُ فيها أو الردى",53,"د",2,0],["معنبرُ أنفاس النسيم كأنهُ","صفات صفي الدين بين المجامع",54,"ع",1,0],["مُعَنَّى كَرُكنِ الطَّودِ قَد زاحَ نَيَّهُ","زَمَانانِ مَرّا أَعشبا خَصِبانِ",55,"ن",1,0],["مُعَنًّى بأسرابِ الصريمِ فتارةً","يلاحظُ ظبياً أو يغازلُ جُؤذَرا",56,"ر",2,0],["مُعنَّى بتسآلِ الرسومِ وتارةً","يسائلُ حادي العيسِأين يُريدُ",57,"د",1,0],["معنًّى بأغصانِ القدودِ رشيقةً","كبانِ الحِمى في دِقَّةٍ وذبولِ",58,"ل",1,0],["معنى الجمال وظل شمس طواسم","يا مصطفى من قبل نشأة آدم",59,"م",1,0],["معنى الجمال ومهمه الحسن الذي","يبلي النهى بتماثل الغزلان",60,"ن",1,0],["معنى بدا بتما