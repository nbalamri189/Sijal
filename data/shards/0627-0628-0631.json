,"خلى يتامى كان يحسن أسوهم","https://www.aldiwan.net/poem38.html","الكامل"],[416,"قد ركبنا بمركب الدخان","https://www.aldiwan.net/poem53823.html","الخفيف"],[416,"جسد ذاب نحولا وسقاما","https://www.aldiwan.net/poem53951.html","الرمل"],[416,"أدار على الندمان كأس عقاره","https://www.aldiwan.net/poem54057.html","الطويل"],[416,"ألما على لومي وجدا مجددا","https://www.aldiwan.net/poem54134.html","الطويل"],[429,"أبرق نراه أم سنا الصبح حاضر","https://www.aldiwan.net/poem41427.html","الطويل"],[439,"وفي غيابات أطباق الخطوب شج","https://www.aldiwan.net/poem34760.html","البسيط"],[443,"سألنا فقالوا هذه جنة الورد","https://www.aldiwan.net/poem55934.html","عموديه"],[458,"لا تلمس الشمس يد","https://www.aldiwan.net/poem56236.html","مجزوء الرجز"],[461,"تود الجحاجيح من خندف","https://www.aldiwan.net/poem15115.html","المتقارب"],[461,"اعيذ قريشا أن تصيخ لكاشح","https://www.aldiwan.net/poem15463.html","الطويل"],[461,"أبر على هطول الغيث جودا","https://www.aldiwan.net/poem15488.html","الوافر"],[461,"أبر صلاح الدين وابن صلاحه","https://www.aldiwan.net/poem16398.html","الطويل"],[464,"امشنع أني جنحت إلى الكرى","https://www.aldiwan.net/poem3153.html","عموديه"],[464,"راح يستمطر الدموع الغزارا","https://www.aldiwan.net/poem3621.html","عموديه"],[468,"أبركت يا بركات راحلة الهوى","https://www.aldiwan.net/poem59555.html","البسيط"],[468,"وليلة ليس لها مثل","https://www.aldiwan.net/poem59715.html","السريع"],[477,"أبرق تبدى أم وميض سنا ثغر","https://www.aldiwan.net/poem15206.html","الطويل"],[477,"أبرق على المنحنى لائحام","https://www.aldiwan.net/poem15220.html","المتقارب"],[479,"لست الإله ولست بالشيطان","https://www.aldiwan.net/poem36946.html","الكامل"],[482,"سقتني بثغر الوصل قهوة حسنها","https://www.aldiwan.net/poem24322.html","عموديه"],[493,"وداية ترضع عبر درها","https://www.aldiwan.net/poem67294.html","عموديه"],[500,"أبرز هذا وطمس","https://www.aldiwan.net/poem37993.html","مجزوء الرجز"],[500,"بدر حسن راق العيون شهوده","https://www.aldiwan.net/poem38027.html","الخفيف"],[500,"ها أين يا ريح الصبا","https://www.aldiwan.net/poem38086.html","مجزوء الرجز"],[524,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[529,"إن لموكا علي مكرمة","https://www.aldiwan.net/poem37433.html","المنسرح"],[553,"طرق الخيال فهاج لي بلبالا","https://www.aldiwan.net/poem68406.html","الكامل"],[558,"ما الشدة إلا للفرج","https://www.aldiwan.net/poem34692.html","المتدارك"],[562,"قضى في خلقه ذو العرش أمرا","https://www.aldiwan.net/poem52739.html","الوافر"],[562,"دعاني من هوى هند وأسما","https://www.aldiwan.net/poem52779.html","الوافر"],[562,"لمن الهوادج في عراء الهوجل","https://www.aldiwan.net/poem52887.html","الكامل"],[573,"مفتتن في نفسه فاتن","https://www.aldiwan.net/poem3638.html","السريع"],[575,"وفتاة ما واصلتني إلا","https://www.aldiwan.net/poem2929.html","الخفيف"]],"verses":[["أُبرِمَت لي مِن صَنعَةِ الدَهرِ لا يُس","رِعُ فيها إِلّا المَنايا نَفضا",0,"ض",2,0],["أَبرَزتُها فَتَحاضَرنا مُباعَدَةً","عَنِ الخِيامِ نُعَفّي الخَطوَ بِالأُزُرِ",1,"ر",1,0],["أَبَرَّ عَلى الأَنواءِ فَضلي وَنائِلي","وَطالَ عَلى الجَوزاءِ قَدري وَمُحتَدي",2,"ي",1,1],["أَبرا إِلى المَجدِ مِن حَرصي عَلى الطَلَبِ","وَمِن قِراعي عَلى الأَرزاقِ وَالرُتَبِ",3,"ب",1,1],["أَبرِزوهُ وَاِنظُروا ما يَلتَقي","مِن سِناني تَحتَ ظِلِّ القَسطَلِ",4,"ل",1,0],["أَبَرُّ يَميناً إِذا أَقسَموا","وَأَفضَلُ إِن عُدَّ أَفضالُها",5,"ل",3,0],["أَبَريءٌ عَنهُ يَعفو مُذنِبٌ","كَيفَ تُسدي العَفوَ كَفُّ المُذنِبِ",6,"ب",1,0],["أَبرَزَ الجيدَ في غَلائِلَ بيضٍ","وَجَلا الخَدَّ في مَجاسِدَ حُمرِ",7,"ر",1,0],["َأبْرَزَ الْحَزْمَ مِنْهُ ضَوْءُ سِرَاجٍ","وَجَلاَ الْعَزْمَ مِنْهُ ضَوْءُ الثَّوَابِ",8,"ب",1,0],["أبرر بك إبنا لمصر لما","جدت فنادت أين البنونا",9,"ن",2,0],["أَبَرُّ المُلُوكِ الأُولى حَبَّبُوا","سَجَايَا المُلُوكِ إِلَى العَالَمِينْ",10,"ن",1,0],["أَبْرِزْ بِكَ ابْناً لِمِصْرَ لَمَّا","جُدْتَ فَنَادَتْ أَيْنَ البَنُونَا",11,"ن",2,0],["أَبَرَّ عَلى الخُصوم فَلَيسِ خَصمٌ","وَلا خَصمانِ يَغلبُهُ جِدالا",12,"ل",2,0],["أبرزت للكون غرّا","من سلالة فخر الأنصار",13,"ر",1,0],["أبرَّ من التثليث بالله وحَدَه","فمن يعتصمُ بالله فالله يعصِمُ",14,"م",1,0],["أبرق وأرعد يا يزي","د فما وعيدك لي بضائر",15,"ر",1,1],["أبرِح بِمَن كُلِّفَ الديارَ وما","تَزعُمُ فِيهِ الشَّواحِجُ النُعُبُ",16,"ب",1,0],["أبرَقَ للمُسنِتِينَ عِندكُمُ","بالجَودِ فيها النِّهاءُ والعُشُبُ",16,"ب",1,0],["أبرق له بالشام نيل مدامعٍ","يجريه ذكر منازل المقياس",17,"س",1,0],["أُبْرِكُهُ طوْراً وطورا أبْطَحُهْ","وتارةً للجنْبِ لا أروِّحُهْ",18,"ح",2,0],["أبْرقَ برقاً كأن لائحَهُ","من أُفقِ الخير نار حُرَّاضِهِ",19,"ض",2,0],["أبرَّا على الولدان حُسناً ونازَعَا","جحاجحةَ القومِ السجايا الكرائما",20,"م",2,0],["أبْرَمُوا أمرَهُمْ وأنتُمْ نِيامٌ","سوءةً سوءةً لنوْمِ النيام",21,"م",1,0],["أبرَّ عليَّ إبرارَ المُعادي","وليٌّ منه بَرَّ فما اتَّلاني",22,"ي",1,0],["أَبرَمَني حَديثُهُ الطَويلُ","فَلَيتَ لَو كانَ لَهُ مَحصولُ",23,"ل",1,0],["أبر الخلق عاطفة","وأسمحه وأحلمه",24,"م",2,0],["أَبَراكينُ تِلكَ أَم نَزَواتٌ","مِن جِراحٍ قَديمَةٍ مُلتامَه",25,"م",2,0],["أبرَّ عِلمي على علمِ الأُلى سلفوا","لولا فضيلةُ سبقٍ حازَها القِدمُ",26,"م",1,0],["أبريسَمٌ كبَّتُه","مبلولةٌ لم تُعْصَرِ",27,"ر",1,0],["أَبَرَّ عَلى الأَلواءِ نائِلُكَ الغَمرُ","وَبِنتَ بِفَخرٍ ما يُشاكِلُهُ فَخرُ",28,"ر",1,1],["أَبرِ صُدورَ القَومِ مِن شَكِّها","فَقَصرُ مَن يَجهَلُ أَن يَعرِفا",29,"ف",2,0],["أَبَرقٌ تَجَلّى أَم بَدا اِبنُ مُدَبِّرٍ","بِغُرَّةِ مَسئولٍ رَأى البِشرَ سائِلُه",30,"ل",2,0],["أَبرَحَ العَيشُ فَالمَشيبُ قَذىً في","أَعيُنِ البيضِ وَالشَبابُ جَمالُ",31,"ل",1,0],["أَبَرتَ زُحوفَ المُلحِدينَ وَكِدتَهُم","بِمُستَنصِرٍ يَتلو كِتابَ المَصاحِفِ",32,"ف",1,0],["أَبَرَّ وَأَوفى ذِمَّةً يَعقُدونَها","وَخَيراً إِذا ساوى الذُرى بِالكَواهِلِ",33,"ل",1,0],["إبريقنا عاكف على قدح","تخاله الأم ترضع الولدا",34,"د",2,1],["أُبْرِئتُ إذ جاورتُ رَبَعك نازلاً","فكأنَّني جارُ الرَّبيعِ النازِلِ",35,"ل",1,0],["أَبْرَأَتْنا كما أَبارَتْ عِدانا","فَهْيَ فينا بُرْءٌ وفيهم بَوارُ",36,"ر",1,0],["أبرُوقٌ تلألأتْ أم ثغورُ","وليالٍ دجتْ لنا أم شعورُ",37,"ر",1,1],["أبَرّ على إيوان كسرى فلو رأى","مراتِبَهُ في الملك منه لأكبَرَه",38,"ر",2,0],["أَبرَأتُ قَرحَةَ لَوعَةٍ نَبَتَت","بَينَ الشِغافِ كَقَرحَةِ الجَنبِ",39,"ب",1,0],["آبِرُ حَمدٍ يَرى الرِجالَ هُمُ","سِرُّ الثَرى وَالعُلى هِيَ الغَرسُ",40,"س",1,0],["أَبْرَزَتْ قُدْرَةُ الطَّبِيعَةِ مِنْهُ","شَكْلَ لُؤْمٍ إِنْ كَان لِلُّؤمِ شَكْلُ",41,"ل",1,0],["أبرأُ إلى الرحمنِ من بهتانِهِ","وفجورِهِ وعتوِّهِ المتزايدِ",42,"د",1,1],["أَبرَزوها مِثلَ المَهاةِ تَهادى","بَينَ خَمسٍ كَواعِبٍ أَترابِ",43,"ب",1,0],["أبرُّ الناسِ عندهمُ المُداجِي","وشرُّ القومِ ذو النُّصْحِ الوَدودُ",44,"د",1,0],["أُبَرهِنُ عِندَ النَفسِ باطِلَ عُذرِهِ","وَأَقنَعُ مِنهُ بِالوِدادِ المُلَفَّقِ",45,"ق",1,0],["أَبَرُّ عَلى الأَعداءِ مِنّي اِبنُ حُرَّةٍ","جَرِيٌّ عَلى الشَحناءِ عَفُّ المَسالِكِ",46,"ك",1,0],["إبراهِمِيّةُ سُودَدٍ تُعزَى إلى","نَجْرِ الكِرامِ جِنانُها ومَعانُها",47,"ن",3,0],["أَبرَزَهُ المَأتَمُ لي كارِهاً","بِرُغمِ داياتٍ وَحُجّابِ",48,"ب",1,0],["إِبريقُنا مُنتَصِبٌ تارَةً","وَتارَةً مُبتَرِكٌ جاثِ",49,"ث",1,0],["أَبرَشَ بَطنانَ الجَناحِ أَقمَرا","أَرقَطَ ضاحي الدَفَّتَينِ أَنمَرا",50,"ر",2,0],["إِبريقُهُ في كَفِّهِ مُترَعٌ","مُغتَرِفٌ مِن ذَوبِ جِريالِ",51,"ل",1,0],["أَبرَأتِ صَدرَكِ إِنَّني","قَلِقٌ بِسُخطِكِ مُتعَبُ",52,"ب",1,0],["إِبَرُ العَقارِبِ فَوقَ أَلسُنِهِم","مَحمولَةٌ فَكَلامُهُم أَبرُ",53,"ر",1,0],["أَبراكَ رَبُّكَ فَوقَ ظَهرِ مَطيَّةٍ","سارَت لِتَبلُغَ ساعَةَ الإِبراكِ",54,"ك",1,0],["أَبرَأَنا الواحِدُ مِن سُقمِنا","وَرَمَّنا المَلكُ وَأَبرانا",55,"ن",2,0],["أَبَرَّ وَأَوفى ذِمَّةً يَعقِدونَها","وَخَيراً إِذا ساوى الذُرى بِالحَوارِكِ",56,"ك",1,0],["أبرقٌ بدا من جانِبِ الغَور لامعُ","أمِ ارتفَعَتْ عن وجهِ ليلى البراقع",57,"ع",1,1],["أبروحانيةِ الشَّرقِ العريقْ","أمْ ببوهيميَّةِ الفنِّ الطَّليقْ",58,"ق",1,0],["إبريقهُ حَلْيٌ من الدُّرَرِ","يُزْهى به قَدَحٌ من الماسِ",59,"س",1,0],["إبرحي بهوَه الكئيبَ فما في","هِ لعينيكِ بهجةٌ تتجلّى",60,"ل",2,0],["أَبَرْقٌ بَدا أَمْ لَمْعُ أَبْيَضَ قاصِلِ","ورَجْعُ صَدى أَمْ رَجْعُ أَشْقَرَ صَاهِلِ",61,"ل",1,1],["أَبْرَعُ مِنْ جَوَّدَ فِي مُرْسَلٍ","وَخَيْرُ مَنْ جَدَّدَ فِي شِعْرَ",62,"ر",1,0],["أَبْرَزَ العِليَةَ المُجَلِّينَ مِنْ","هُمْ فِي مَجَالِ العُلومِ وَالفَلْسَفَاتِ",63,"ت",1,0],["أَبْرَزَتْ فِي لِقَائِهَا مُصْطَفَاها","مَا أَكَنَّتْ لَهُ مِنَ التَّبْجِيلِ",64,"ل",1,0],["أبرق بدا أم لمع أبيض قاصل","ورجع شدا أم رجع اشقر صاهل",65,"ل",1,1],["أبرَحتَ يا مَرَضَ الجُفونِ بِمُمرَضٍ","مَرِضَ الطَبيبُ لَهُ وَعيدَ العُوَّدُ",66,"د",1,0],["أبرزتُ قلبي للرماة معرَّضا","وجلوت شعري للعواطف مَعرِضا",67,"ض",2,1],["أبرمتُ ما أبرمتهُ مستسهلاً","ان حانَ موعِدُ نقضِه ان يُنقَصا",67,"ص",2,0],["أَبْرِ صُدورَ القَوْمِ من شَكلها","فَقَصْرُ مَنْ يَجْهَلُ أَن يعرفها",68,"ف",3,0],["أَبْرَجَ الْعَيْشُ فَالمشِيبُ قَذِّى في","أَعيُنِ الْبيضِ ، والشَّبَابُ جَمَالُ",69,"ل",1,0],["أبَرْقٌ تَجَلّى أمْ بَدا ابنُ مُدَبِّرٍ","بغُرّةِ مَسؤُولٍ، رأى البِشرَ سائِلُهْ",70,"ل",2,0],["أبرزتْ ثدرة ُ الطبيعة ِ منهُ","شَكْلَ لُؤْمٍ، إِنْ كَانَ لِلُّؤمِ شَكْلُ",71,"ل",1,0],["إبرخي بهوه الكئيب فما في","ه لعينيك بهجة تتجلّى",72,"ل",2,0],["أَبرَأت ذمة دَهر جاءَ يَمنَحَني","بَعدَ الإِساءَة مِن لُقياك إِحسانا",73,"ن",2,0],["أَبرِّؤُ نَفسي وَهِيَ امارة بِها","يَسِّود صَحفي يَوم تَذهل مُرضع",74,"ع",1,1],["ابرز روح العدل من هيكل","قام على عرش الفخار المهيب",75,"ب",1,0],["أبرقاً في الدُجى جُنَّا","وغلغَل بعدَما أسنى",76,"ن",2,0],["أبرقاً في الدُجى أسرى","يجُرُّ وميضُهُ الرُدنا",76,"ن",2,0],["أبَرقٌ لاحَ مِن خِلَلِ الغَمَامِ","أمِ انكَشَفَ التَّنَقُّبُ عَن أُمَامِ",77,"م",1,1],["أبَرقٌ مَا لَمِحتُ له ائتِلاَقَا","أمِ الحَسنَاءُ ثَقَّبتِ الرِّوَاقَا",78,"ق",2,1],["أَبَرُّ عِبادِ اللَهِ ديناً وَعادَةً","وَأَنفَعُهُم لِلطالبينَ إِفادَةً",79,"ه",1,0],["أَبَرُّ شُهُودِي أَنَّني لَكَ عاشِقٌ","سُهادي وَسُقمي وَالدُمُوعُ الدَوافِقُ",80,"ق",1,1],["أَبرَّ الوَرى بَعضاً بِبَعضٍ طويةً","وَأَوثَقَهُم وُدّاً وَأَبعَدَهُم غَدرا",81,"ر",2,0],["أَبرّهُم أعلمُهم باللَّهِ","لَم يخلُقِ الخلّاقُ منه أَعلما",82,"م",2,0],["أبرِقي يا سماءُ فالبرقُ نورٌ","أرعِدي يا سماء فالرعد صوتُ",83,"ت",1,1],["أَبَرُّ الوُلدِ بِالآباءِ خُلقاً","وَأَقرَبُهُم إِلَيَّ إِذا زُهيتُ",84,"ت",1,0],["أَبَرقٌ يُتَوِّجُ هامَ الرُبا","وَإِلّا فهاتيكَ نارُ القِرى",85,"ا",1,1],["أَبْرزْنَ من خَلَل السُّتُورِ مَحاجِراً","مكحولةً بمَلا