{"poems":[[53,"عند قلبي علاقة ما تقضى","https://www.aldiwan.net/poem30174.html","الخفيف"],[53,"شيمي لحاظك عنا ظبية الخمر","https://www.aldiwan.net/poem30460.html","البسيط"],[53,"أبر على الأنواء فضلي ونائلي","https://www.aldiwan.net/poem30610.html","الطويل"],[53,"أبرا إلى المجد من حرصي على الطلب","https://www.aldiwan.net/poem30707.html","البسيط"],[3,"نفسوا كربي وداووا عللي","https://www.aldiwan.net/poem185.html",""],[9,"ألا قل لتياك ما بالها","https://www.aldiwan.net/poem21973.html","المتقارب"],[86,"أعجمي كاد يعلو نجمه","https://www.aldiwan.net/poem68943.html","الرمل"],[73,"عذري إن عذلت في خلع عذري","https://www.aldiwan.net/poem11944.html","الخفيف"],[93,"يا وزير الشباب أنت خليق","https://www.aldiwan.net/poem9784.html","عموديه"],[93,"قضيت عمري لا مستديناً","https://www.aldiwan.net/poem9843.html","مخلع البسيط"],[93,"مددت طرافك للائدين","https://www.aldiwan.net/poem11200.html","المتقارب"],[93,"قضيت عمري لا مستدينا","https://www.aldiwan.net/poem11212.html","مخلع البسيط"],[30,"أراح فريق جيرتك الجمالا","https://www.aldiwan.net/poem29550.html","الوافر"],[83,"الملك أصبح علينا","https://www.aldiwan.net/poem54204.html","مجزوء الرمل"],[83,"هناء له ثغر الهدى يتبسم","https://www.aldiwan.net/poem54244.html","الطويل"],[37,"أبرق وأرعد يا يزيد","https://www.aldiwan.net/poem7175.html","مجزوء الكامل"],[37,"أنى ومن أين آبك الطرب","https://www.aldiwan.net/poem7651.html","المنسرح"],[72,"يا ناسيا عهدي ولست بناسي","https://www.aldiwan.net/poem19017.html","الكامل"],[51,"رب غلام وجهه لا يفضحه","https://www.aldiwan.net/poem9417.html","الرجز"],[51,"أنهضه في أوان إنهاضه","https://www.aldiwan.net/poem64941.html","المنسرح"],[51,"لعمرك ما ضيف ابن موسى بصائم","https://www.aldiwan.net/poem66067.html","الطويل"],[51,"ذاد عن مقلتي لذيذ المنام","https://www.aldiwan.net/poem66325.html","الخفيف"],[51,"أأبكتك المعاهد والمغاني","https://www.aldiwan.net/poem66430.html","الوافر"],[70,"وقائل يجهل ما يقول","https://www.aldiwan.net/poem42750.html","الرجز"],[85,"به هجر يتيمه","https://www.aldiwan.net/poem7140.html","مجزوء الوافر"],[85,"قف بطوكيو وطف على يوكاهامه","https://www.aldiwan.net/poem63698.html","الخفيف"],[62,"يا شامتا لزمان قد تنكر لي","https://www.aldiwan.net/poem52292.html","البسيط"],[62,"نارنجنا في لونه","https://www.aldiwan.net/poem52399.html","مجزوء الرجز"],[45,"أبر على الألواء نائلك الغمر","https://www.aldiwan.net/poem63606.html","الطويل"],[45,"قد قلت عن نصح لبرذونة","https://www.aldiwan.net/poem65148.html","السريع"],[45,"سقى ربعها سح السحاب وهاطله","https://www.aldiwan.net/poem65565.html","الطويل"],[45,"أصدود غلا بها أم دلال","https://www.aldiwan.net/poem65596.html","الخفيف"],[28,"ولما دعا الداعون وانشقت العصا","https://www.aldiwan.net/poem5324.html","الطويل"],[28,"تبغت جوارا في معد فلم تجد","https://www.aldiwan.net/poem5408.html","الطويل"],[61,"إبريقنا عاكف على قدح","https://www.aldiwan.net/poem51302.html","المنسرح"],[61,"تأبى الصبابة أن تصيخ لعاذل","https://www.aldiwan.net/poem51494.html","الكامل"],[61,"لحظ عينيك للردى أنصار","https://www.aldiwan.net/poem51681.html","الخفيف"],[80,"أبروق تلألأت أم ثغور","https://www.aldiwan.net/poem31230.html","الخفيف"],[80,"ثلاثة أفلاك عن العين مضمره","https://www.aldiwan.net/poem31435.html","الطويل"],[44,"أطفأت نار هواك من قلبي","https://www.aldiwan.net/poem30285.html","الكامل"],[44,"هل أثر من ديارهم دعس","https://www.aldiwan.net/poem30492.html","المنسرح"],[87,"كل صعب سوى المذلة سهل","https://www.aldiwan.net/poem8345.html","الخفيف"],[69,"أبرأ إلى الرحمن من بهتانه","https://www.aldiwan.net/poem29201.html","الكامل"],[31,"قال لي صاحبي ليعلم ما بي","https://www.aldiwan.net/poem42618.html","الخفيف"],[105,"أتسأل مصر ما حمل العميد","https://www.aldiwan.net/poem42123.html","الوافر"],[81,"سل النوم يا موسى وهنئت طيبه","https://www.aldiwan.net/poem61451.html","الطويل"],[52,"ضمان على عيني سقي ديارك","https://www.aldiwan.net/poem26783.html","الطويل"],[75,"الشمس عنه كليلة أجفانها","https://www.aldiwan.net/poem69029.html","الكامل"],[48,"يا قمرا أبرزه مأتم","https://www.aldiwan.net/poem10787.html","السريع"],[48,"وابأبي ألثغ لاججته","https://www.aldiwan.net/poem62481.html","السريع"],[48,"لما رأيت الليل قد تشزرا","https://www.aldiwan.net/poem63412.html","الخفيف"],[48,"لا تمزج الخمر على حال","https://www.aldiwan.net/poem64504.html","السريع"],[50,"يا بان ضاق المذهب","https://www.aldiwan.net/poem64810.html","مجزوء الكامل"],[46,"عبر الشباب لأمه العبر","https://www.aldiwan.net/poem22589.html","الكامل"],[46,"أتراك يوما قائلا عن نية","https://www.aldiwan.net/poem23103.html","الكامل"],[46,"طودان قالا زل غفرانا","https://www.aldiwan.net/poem23492.html","السريع"],[1,"قفي ودعينا اليوم يا ابنة مالك","https://www.aldiwan.net/poem34008.html","الطويل"],[68,"أبرق بدا من جانب الغور لامع","https://www.aldiwan.net/poem1506.html",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39572","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39601","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39547","الخفيف"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30486","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54963","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54656","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55166","الخفيف"],[84,"أبرق بدا أم لمع أبيض قاصل","https://www.poetsgate.com/ViewPoem.aspx?id=26348",""],[43,"اليوم عهدكم فأين الموعد","https://www.poetsgate.com/ViewPoem.aspx?id=206",""],[90,"معرض العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179147",""],[45,"قَد قُلتُ عَن نُصْحٍ لِبِرْذَوْنَةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=32535",""],[45,"أَصُدُودٌ غَلاَ بِهَا أَمْ دَلاَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=32056",""],[45,"سَقَى رَبْعَها سَحُّ السّحابِ وَهَاطِلُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31871",""],[87,"كلُّ صعبٍ سوى المذلة ِ سهلُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23768&r=&rc=30",""]],"verses":[["أُبرِمَت لي مِن صَنعَةِ الدَهرِ لا يُس","رِعُ فيها إِلّا المَنايا نَفضا",0,"ض",2,0],["أَبرَزتُها فَتَحاضَرنا مُباعَدَةً","عَنِ الخِيامِ نُعَفّي الخَطوَ بِالأُزُرِ",1,"ر",1,0],["أَبَرَّ عَلى الأَنواءِ فَضلي وَنائِلي","وَطالَ عَلى الجَوزاءِ قَدري وَمُحتَدي",2,"ي",1,1],["أَبرا إِلى المَجدِ مِن حَرصي عَلى الطَلَبِ","وَمِن قِراعي عَلى الأَرزاقِ وَالرُتَبِ",3,"ب",1,1],["أَبرِزوهُ وَاِنظُروا ما يَلتَقي","مِن سِناني تَحتَ ظِلِّ القَسطَلِ",4,"ل",1,0],["أَبَرُّ يَميناً إِذا أَقسَموا","وَأَفضَلُ إِن عُدَّ أَفضالُها",5,"ل",3,0],["أَبَريءٌ عَنهُ يَعفو مُذنِبٌ","كَيفَ تُسدي العَفوَ كَفُّ المُذنِبِ",6,"ب",1,0],["أَبرَزَ الجيدَ في غَلائِلَ بيضٍ","وَجَلا الخَدَّ في مَجاسِدَ حُمرِ",7,"ر",1,0],["َأبْرَزَ الْحَزْمَ مِنْهُ ضَوْءُ سِرَاجٍ","وَجَلاَ الْعَزْمَ مِنْهُ ضَوْءُ الثَّوَابِ",8,"ب",1,0],["أبرر بك إبنا لمصر لما","جدت فنادت أين البنونا",9,"ن",2,0],["أَبَرُّ المُلُوكِ الأُولى حَبَّبُوا","سَجَايَا المُلُوكِ إِلَى العَالَمِينْ",10,"ن",1,0],["أَبْرِزْ بِكَ ابْناً لِمِصْرَ لَمَّا","جُدْتَ فَنَادَتْ أَيْنَ البَنُونَا",11,"ن",2,0],["أَبَرَّ عَلى الخُصوم فَلَيسِ خَصمٌ","وَلا خَصمانِ يَغلبُهُ جِدالا",12,"ل",2,0],["أبرزت للكون غرّا","من سلالة فخر الأنصار",13,"ر",1,0],["أبرَّ من التثليث بالله وحَدَه","فمن يعتصمُ بالله فالله يعصِمُ",14,"م",1,0],["أبرق وأرعد يا يزي","د فما وعيدك لي بضائر",15,"ر",1,1],["أبرِح بِمَن كُلِّفَ الديارَ وما","تَزعُمُ فِيهِ الشَّواحِجُ النُعُبُ",16,"ب",1,0],["أبرَقَ للمُسنِتِينَ عِندكُمُ","بالجَودِ فيها النِّهاءُ والعُشُبُ",16,"ب",1,0],["أبرق له بالشام نيل مدامعٍ","يجريه ذكر منازل المقياس",17,"س",1,0],["أُبْرِكُهُ طوْراً وطورا أبْطَحُهْ","وتارةً للجنْبِ لا أروِّحُهْ",18,"ح",2,0],["أبْرقَ برقاً كأن لائحَهُ","من أُفقِ الخير نار حُرَّاضِهِ",19,"ض",2,0],["أبرَّا على الولدان حُسناً ونازَعَا","جحاجحةَ القومِ السجايا الكرائما",20,"م",2,0],["أبْرَمُوا أمرَهُمْ وأنتُمْ نِيامٌ","سوءةً سوءةً لنوْمِ النيام",21,"م",1,0],["أبرَّ عليَّ إبرارَ المُعادي","وليٌّ منه بَرَّ فما اتَّلاني",22,"ي",1,0],["أَبرَمَني حَديثُهُ الطَويلُ","فَلَيتَ لَو كانَ لَهُ مَحصولُ",23,"ل",1,0],["أبر الخلق عاطفة","وأسمحه وأحلمه",24,"م",2,0],["أَبَراكينُ تِلكَ أَم نَزَواتٌ","مِن جِراحٍ قَديمَةٍ مُلتامَه",25,"م",2,0],["أبرَّ عِلمي على علمِ الأُلى سلفوا","لولا فضيلةُ سبقٍ حازَها القِدمُ",26,"م",1,0],["أبريسَمٌ كبَّتُه","مبلولةٌ لم تُعْصَرِ",27,"ر",1,0],["أَبَرَّ عَلى الأَلواءِ نائِلُكَ الغَمرُ","وَبِنتَ بِفَخرٍ ما يُشاكِلُهُ فَخرُ",28,"ر",1,1],["أَبرِ صُدورَ القَومِ مِن شَكِّها","فَقَصرُ مَن يَجهَلُ أَن يَعرِفا",29,"ف",2,0],["أَبَرقٌ تَجَلّى أَم بَدا اِبنُ مُدَبِّرٍ","بِغُرَّةِ مَسئولٍ رَأى البِشرَ سائِلُه",30,"ل",2,0],["أَبرَحَ العَيشُ فَالمَشيبُ قَذىً في","أَعيُنِ البيضِ وَالشَبابُ جَمالُ",31,"ل",1,0],["أَبَرتَ زُحوفَ المُلحِدينَ وَكِدتَهُم","بِمُستَنصِرٍ يَتلو كِتابَ المَصاحِفِ",32,"ف",1,0],["أَبَرَّ وَأَوفى ذِمَّةً يَعقُدونَها","وَخَيراً إِذا ساوى الذُرى بِالكَواهِلِ",33,"ل",1,0],["إبريقنا عاكف على قدح","تخاله الأم ترضع الولدا",34,"د",2,1],["أُبْرِئتُ إذ جاورتُ رَبَعك نازلاً","فكأنَّني جارُ الرَّبيعِ النازِلِ",35,"ل",1,0],["أَبْرَأَتْنا كما أَبارَتْ عِدانا","فَهْيَ فينا بُرْءٌ وفيهم بَوارُ",36,"ر",1,0],["أبرُوقٌ تلألأتْ أم ثغورُ","وليالٍ دجتْ لنا أم شعورُ",37,"ر",1,1],["أبَرّ على إيوان كسرى فلو رأى","مراتِبَهُ في الملك منه لأكبَرَه",38,"ر",2,0],["أَبرَأتُ قَرحَةَ لَوعَةٍ نَبَتَت","بَينَ الشِغافِ كَقَرحَةِ الجَنبِ",39,"ب",1,0],["آبِرُ حَمدٍ يَرى الرِجالَ هُمُ","سِرُّ الثَرى وَالعُلى هِيَ الغَرسُ",40,"س",1,0],["أَبْرَزَتْ قُدْرَةُ الطَّبِيعَةِ مِنْهُ","شَكْلَ لُؤْمٍ إِنْ كَان لِلُّؤمِ شَكْلُ",41,"ل",1,0],["أبرأُ إلى الرحمنِ من بهتانِهِ","وفجورِهِ وعتوِّهِ المتزايدِ",42,"د",1,1],["أَبرَزوها مِثلَ المَهاةِ تَهادى","بَينَ خَمسٍ كَواعِبٍ أَترابِ",43,"ب",1,0],["أبرُّ الناسِ عندهمُ المُداجِي","وشرُّ القومِ ذو النُّصْحِ الوَدودُ",44,"د",1,0],["أُبَرهِنُ عِندَ النَفسِ باطِلَ عُذرِهِ","وَأَقنَعُ مِنهُ بِالوِدادِ المُلَفَّقِ",45,"ق",1,0],["أَبَرُّ عَلى الأَعداءِ مِنّي اِبنُ حُرَّةٍ","جَرِيٌّ عَلى الشَحناءِ عَفُّ المَسالِكِ",46,"ك",1,0],["إبراهِمِيّةُ سُودَدٍ تُعزَى إلى","نَجْرِ الكِرامِ جِنانُها ومَعانُها",47,"ن",3,0],["أَبرَزَهُ المَأتَمُ لي كارِهاً","بِرُغمِ داياتٍ وَحُجّابِ",48,"ب",1,0],["إِبريقُنا مُنتَصِبٌ تارَةً","وَتارَةً مُبتَرِكٌ جاثِ",49,"ث",1,0],["أَبرَشَ بَطنانَ الجَناحِ أَقمَرا","أَرقَطَ ضاحي الدَفَّتَينِ أَنمَرا",50,"ر",2,0],["إِبريقُهُ في كَفِّهِ مُترَعٌ","مُغتَرِفٌ مِن ذَوبِ جِريالِ",51,"ل",1,0],["أَبرَأتِ صَدرَكِ إِنَّني","قَلِقٌ بِسُخطِكِ مُتعَبُ",52,"ب",1,0],["إِبَرُ العَقارِبِ فَوقَ أَلسُنِهِم","مَحمولَةٌ فَكَلامُهُم أَبرُ",53,"ر",1,0],["أَبراكَ رَبُّكَ فَوقَ ظَهرِ مَطيَّةٍ","سارَت لِتَبلُغَ ساعَةَ الإِبراكِ",54,"ك",1,0],["أَبرَأَنا الواحِدُ مِن سُقمِنا","وَرَمَّنا المَلكُ وَأَبرانا",55,"ن",2,0],["أَبَرَّ وَأَوفى ذِمَّةً يَعقِدونَها","وَخَيراً إِذا ساوى الذُرى بِالحَوارِكِ",56,"ك",1,0],["أبرقٌ بدا من جانِبِ الغَور لامعُ","أمِ ارتفَعَتْ عن وجهِ ليلى البراقع",57,"ع",1,1],["أبروحانيةِ الشَّرقِ العريقْ","أمْ ببوهيميَّةِ الفنِّ الطَّليقْ",58,"ق",1,0],["إبريقهُ حَلْيٌ من الدُّرَرِ","يُزْهى به قَدَحٌ من الماسِ",59,"س",1,0],["إبرحي بهوَه الكئيبَ فما في","هِ لعينيكِ بهجةٌ تتجلّى",60,"ل",2,0],["أَبَرْقٌ بَدا أَمْ لَمْعُ أَبْيَضَ قاصِلِ","ورَجْعُ صَدى أَمْ رَجْعُ أَشْقَرَ صَاهِلِ",61,"ل",1,1],["أَبْرَعُ مِنْ جَوَّدَ فِي مُرْسَلٍ","وَخَيْرُ مَنْ جَدَّدَ فِي شِعْرَ",62,"ر",1,0],["أَبْرَزَ العِليَةَ المُجَلِّينَ مِنْ","هُمْ فِي مَجَالِ العُلومِ وَالفَلْسَفَاتِ",63,"ت",1,0],["أَبْرَزَتْ فِي لِقَائِهَا مُصْطَفَاها","مَا أَكَنَّتْ لَهُ مِنَ التَّبْجِيلِ",64,"ل",1,0],["أبرق بدا أم لمع أبيض قاصل","ورجع شدا أم رجع اشقر صاهل",65,"ل",1,1],["أبرَحتَ يا مَرَضَ الجُفونِ بِمُمرَضٍ","مَرِضَ الطَبيبُ لَهُ وَعيدَ العُوَّدُ",66,"د",1,0],["أبرزتُ قلبي للرماة معرَّضا","وجلوت شعري للعواطف مَعرِضا",67,"ض",2,1],["أبرمتُ ما أبرمتهُ مستسهلاً","ان حانَ موعِدُ نقضِه ان يُنقَصا",67,"ص",2,0],["أَبْرِ صُدورَ القَوْمِ من شَكلها","فَقَصْرُ مَنْ يَجْهَلُ أَن يعرفها",68,"ف",3,0],["أَبْرَجَ الْعَيْشُ فَالمشِيبُ قَذِّى في","أَعيُنِ الْبيضِ ، والشَّبَابُ جَمَالُ",69,"ل",1,0],["أبَرْقٌ تَجَلّى أمْ بَدا ابنُ مُدَبِّرٍ","بغُرّةِ مَسؤُولٍ، رأى البِشرَ سائِلُهْ",70,"ل",2,0],["أبرزتْ ثدرة ُ الطبيعة ِ منهُ","شَكْلَ لُؤْمٍ، إِنْ كَانَ لِلُّؤمِ شَكْلُ",71,"ل",1,0]]}