هُ من بعد دعوته","ذبيحةً قُدِّمت في قمة الجبل",111,"ل",1,0],["ابرُزْ به إن كان حقّاً تشفِنا","من شانِ قذفٍ شانَ أو كفرٍ قتَل",112,"ل",1,0],["أَبرق سَرى وَهناً فَهَيج أَشجاني","أَم الطَير غَنى في الأَراك فَأَشجاني",113,"ن",2,1],["أَبرَزتُها مِثلَ العَروسِ بديهَةً","فَليَبتَدِر لِنَشيدِها الكوفِيُّ",114,"ي",1,0],["أبراجُ جيلٍ مُؤمنٍ مُتطلِّعٍ","يرْقى بهِمَّتِهِ أعَزَّ مقامِ",115,"م",1,0],["أبرز منه على الأنام نفائساً","فكأنها للعالمين زمام",116,"م",1,0],["أبَرْقٌ بدا أم زحزح اليومَ بُرقعٌ","لسلمى فهذا نورها يتسطع",117,"ع",1,1],["أبرأ الأكمه عيسى وكذا","نفخ الروح بطير من مدر",118,"ر",1,0],["أبرزت فيه نفائساً","أوضحتها حلاً وعقدا",119,"د",2,0],["أبرزَتْ وجهاَ كَلاذَا","في الهوى أُلبسَ لاذا",120,"ذ",2,1],["أَبرَزنَ مِن تِلكَ العُيون أَسِنَّة","وَهَززن مِن تِلكَ القُدود رماحا",121,"ح",2,0],["أَبَرَّ فَما يَرجو جَوادٌ لَحاقَهُ","أَبو الفَضلِ سَبّاقُ اللَهاميمِ جَعفَرُ",122,"ر",1,0],["أبرأتَهَا إِذ كُنتَ أَنتَ طَبيبهَ","حَتَّى تُؤَدِّيَها كَعَهدِ العَاهِدِ",123,"د",1,0],["أبرَزوا بالعقول كلَّ عجيب","ما وَجدناه في قديم الزمان",124,"ن",1,0],["أبرح الدَّهر على ما لم أَرِدْ","ورزاياه اصطكاكاً واضطراما",125,"م",2,0],["أبَرَّتْ به في الأَنجبين ذخيرة","وحسبُك ما كانَ الغنى بادِّخاره",126,"ر",2,0],["أبرَّتْ على ما تدعيه يَمينُها","مَتى تقسم الأيام إنَّك مفردا",127,"د",2,0],["أبرقٌ نراه أم سنا الصبح حاضر","أم الثغر من مختارة الحسن ظاهر",128,"ر",1,1],["أُبْرِزْنَ من سُتُرِ الإِكرامِ وانْسَدَلَتْ","من الهوانِ عَلَيْنا بَعْدَهُ سُتُرُ",129,"ر",1,0],["ابر فتى بالوالدين وخير من","ترفع عن حقد واغمض عن ضد",130,"د",1,0],["أبرُدُهُ بَعذَلي","لو أن ناراً تَبْرُدُ",131,"د",1,0],["أَبَرَّهُمُ بِضيوفٍ الشِّتاءِ","وأقْرى إذا هَبَّ شَفَّانُها",132,"ن",3,0],["أبَرَّ عَليَّاها على كل ماجِدٍ","فأولها حازَ العُلى وأخيرها",133,"ر",3,0],["أبَرَّ على هَطولِ الغيثِ جوداً","وزادَ على حديدِ الهندِ نَصْرا",134,"ر",2,1],["أبَرَّ صَلاحُ الدِّينِ وابْنُ صَلاحِهِ","ببَأسٍ شَهيرٍ في الحُروبِ ونائلِ",135,"ل",1,1],["أبرزتَ وجهَ الغدرَ غير مساترٍ","وقصار ودٍ مماذقٍ إن يغدرا",136,"ر",2,0],["أبرزت معصماً يناط بكفٍّ","لستُ أرضى لها الهلالَ سوارا",137,"ر",2,0],["أَبرَكتَ يا بَرَكاتُ راحِلَةَ الهَوى","مِن مُهجَتي في أَبرَكِ الأَوطانِ",138,"ن",1,1],["أَبرَزَها مِن خِدرِها عاتِقاً","بِمَفرِقٍ إِكليلُهُ الوَصلُ",139,"ل",1,0],["أبرقٌ تبدَّى أم وميضُ سنا ثَغْرِ","تألَّقَ ما بينَ البراقعِ والخُمرِ",140,"ر",1,1],["أبرقٌ على المنحنى لائحُ","امِ الزَّنْدُ أضرمَهُ القادِحَ",141,"ح",1,1],["أبرمت حكمك بالصدود مصدقا","للظن يا عبد الحميد الثاني",142,"ي",1,0],["أبرد ما بالقلب لو كان نافعا","توقدت الأضرام في كل شعرة",143,"ه",1,0],["أبرزها في حلل من خدرها","بوتر مطالبٍ بوترها",144,"ر",3,0],["أبْرَزَ هذا وطَمَسْ","واسْتَوْدَعَ الصُّبْحَ النَّفَسْ",145,"س",1,1],["أَبرزتْهُ يدُ العِنايَةِ لمَّا","كُشِفت عنه في الغُيوبِ بُرودُهْ",146,"د",2,0],["أُبرِزُ منِّي فارِساً","ينظِمُ فيه موْكِبَا",147,"ب",2,0],["أَبرَمتَ عَذلاً وَيُخشى أَن تُجرّ به","إِلى السُّلُوِّ وما السُّلوانُ مِن شِيَمي",148,"م",2,0],["أبْرَزَها كالهِلالِ طالِعَةً","كَمْ عِلَّةٍ للغَرامِ تُبْرِدُها",149,"د",3,0],["إِبريقُنا سَلَبَ الغَزالَةَ جيدَها","وَحَكى المُديرُ بِمُقلَتَيهِ غَزالا",150,"ل",2,0],["أبرى الأعمى والأبرص بل","أحيى كم ميت مندرج",151,"ج",1,0],["أبَرُّ مُهذَّبٍ قولاً وفِعلاً","وأفضلُ مُخلِصٍ سرّاً وجهرا",152,"ر",2,0],["أبَرُّ الصَّالحينَ يداً وقلباً","وأزكَى رَهطِهم خالاً وعَمَّا",153,"م",2,0],["أبراجُ أقمارٍ تَغيبُ نَهارَها","فيها وتَطلعُ في الظَّلامِ المُقبلِ",154,"ل",1,0],["أَبرَزَهُ الحَمّامُ في حِليَةٍ","مِن عَرَقٍ لُؤلُؤُها مِنهُ",155,"ن",2,0],["أَبْرزَتْها هاتِيك بعد خِباءٍ","وأَطاعتْ بتلك بعد شِماسِ",156,"س",1,0]]}