etsgate.com/ViewPoem.aspx?id=60997",""],[6032,"زائري في ليلة صيف","https://www.poetsgate.com/ViewPoem.aspx?id=181524",""],[6070,"رَكبتَ هواكَ ألوانَ الرُّكوبِ","https://www.poetsgate.com/ViewPoem.aspx?id=189129",""],[6070,"اذا كنتَ ذا مالٍ وكنتَ كريما","https://www.poetsgate.com/ViewPoem.aspx?id=189485",""],[6102,"صراحة مفرطة ...","https://www.poetsgate.com/ViewPoem.aspx?id=184430",""],[6115,"على شأن مايشره عليه خيار الناس","https://www.poetsgate.com/ViewPoem.aspx?id=181444",""],[6187,"نبضُ الحكمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82478&r=&rc=1",""],[6212,"مهرة الشمس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1619&r=&rc=0",""],[6224,"طواف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88194&r=&rc=9",""],[6229,"قلادة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65192&r=&rc=17",""],[6239,"المؤتلفة/ المختلفة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76056&r=&rc=107",""],[6262,"وَشْمٌ ثالث","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80123&r=&rc=21",""],[6267,"فإنْ ذُكرَتْ هششتُ لذكرها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=8341&r=&rc=50",""],[6288,"الحاضر ... ليس النهاية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76849&r=&rc=12",""],[6346,"بركان المشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83389&r=&rc=5",""]],"verses":[["تُعيرُ الفَتى ظَهراً قَصيراً كَأَنَّهُ","قَرا النِقنِقِ الطاوي وَعُنقاً عَشَنَّقا",0,"ق",2,0],["تَعَيَّفَ الطَيرَ فَأَنبَأنَهُ","أَنَّ اِبنَ لَيلى عَلِقَتهُ عَلوق",1,"ق",1,1],["تُعَيُّرُني شَيبي كَأَنّي اِبتَدَعتُهُ","وَمَن لِيَ أَن يَبقى بَياضُ المَفارِقِ",2,"ق",1,0],["تُعَيِّرُ رَبَّ الخَيرِ بالي عِظامِهِ","أَلا نُزِّهَت تِلكَ العِظامُ البَوائِدُ",3,"د",1,0],["تُعَيُّرُنا القَبائِلُ أَن قَطَعنا","قَرائِنَ عامِرٍ وَبَني رِياحِ",4,"ح",1,0],["تُعَيِّرُني تَلويحَ وَجهي وَإِنَّما","غَضارَتُهُ مَدفونَةٌ في شُحوبِهِ",5,"ب",2,0],["تُعَيِّرُني فَتاةُ الحَيِّ أَنّي","حَظيتُ مِنَ المُروءَةِ وَالفَتاءِ",6,"ا",2,1],["تُعَيّرُني أَنْ يَرْضَعَ الحَمْدُ نَائِلي","وَتَعْلَمُ مَا أَسْعَى لَهُ وَأَرُومُ",7,"م",1,0],["تُعَيِّرُني بِنْتُ المُعاوِيِّ أَنْ أُرَى","على عَجُزِ الأَمْرِ الذِي فَاتَ صَدْرُهُ",8,"ر",2,0],["تُعيِّرُني بِنتُ المُعاويِّ غُربَتي","وكلُّ طُلوعٍ يَقتَفيهِ أُفولُ",9,"ل",1,0],["تُعَيِّرُني العِدا بِسَوادِ جِلدي","وَبيضُ خَصائِلي تَمحو السَوادا",10,"د",2,0],["تُعَيِّرُني بِأَن أَفسَدتُ مالي","فَسادُ المالِ إِحدى الصالِحاتِ",11,"ت",1,0],["تُعَيِّرُني الإِخلافَ لَيلى وَأَفضَلَت","عَلى وَصلِ لَيلى قُوَّةٌ مِن حِبالِيا",12,"ي",2,0],["تعيبُ شعري وقد طارتْ نوافذُه","في القلب منك وفي الأحشاء والكبدِ",13,"د",1,1],["تعْيَى يدي والظلام معتكرٌ","من طول مدِّي إلى السماء يدي",14,"د",2,0],["تعيش استُهُ في فضل كَعْثب عِرسه","فقُبِّح من شيخٍ يعول استَه حِرُ",15,"ر",1,0],["تعيشون ما عشتم وللحبل واصل","تقوم به الدنيا وللشمل جامع",16,"ع",1,0],["تعيد شباه إلى حاله","وتلقى على صفحتيه شعاعا",17,"ع",2,0],["تَعيبُ الخَمرَ وَهيَ شَرابُ كِسرى","وَيَشرَبُ قَومُكَ العَجَبَ العَجيبا",18,"ب",2,1],["تَعيسٌ تُعانِقُهُ النائِباتُ","عِناقَ الحَبائِلِ لِلطائِرِ",19,"ر",1,0],["تَعيشُ أَنتَ وَتَبقى","أَنا الَّذي مُتُّ حَقّا",20,"ق",2,1],["تُعَيِّرُني صُهباً كَأَنَّ رُؤوسَها","ذُرى الأُكمِ فيها غَضُّ نَيٍّ وَعاتِقُه",21,"ق",2,0],["تُعيدُ عليها ظِلالَ الخُلودِ","وتهفو عليها قُلُوبُ الأَنامْ",22,"م",1,0],["تعيش عبدا حاله شقيه","مستضعَفا تمقتك البريه",23,"ي",2,0],["تُعي مَنابِعُكَ العُقولَ وَيَستَوي","مُتَخَبِّطٌ في عِلمِها وَمُحَقِّقُ",24,"ق",1,0],["تُعينينَ المَوالِدَ وَالمَنايا","وَتَبنينَ الحَياةَ وَتَهدُمينا",25,"ن",2,0],["تَعيشُ وَيَأتيكَ البَنونَ بِكَثرَةٍ","تَتِمُّ بِها النُعمى وَيُستَوجَبُ الشُكرُ",26,"ر",1,0],["تَعيبُني بِهَناتٍ لَستُ أَعرِفُها","مِنّي وَأَنتَ بِها جَذلانُ مُعتَرِفُ",27,"ف",1,0],["تُعيدُ وَتِبدي مِن ثَناءٍ كَأَنَّهُ","سَبائِبُ رَوضِ الحَزنِ جادَ رَبيعُها",28,"ع",3,0],["تُعَيِّرُها بِالنارِ وَالنارُ تَلتَقي","عَلَيكَ بِزَقّومٍ لَها وَضِرامِ",29,"م",1,0],["تُعَيِّرُنا أَيَّمَ قَيسٍ وَلَم نَدَع","لِعَيلانَ أَنفاً مُستَقيمَ الخَياشِمِ",30,"م",1,0],["تُعَيِّرُني الأَعداءُ بِالبَينِ عَنهُمُ","وَما كانَ حُكمُ الدَهرِ بِالبَينِ عَن إِذني",31,"ن",2,0],["تعير ناجي بالردنجوت جاءه","معاراً فغامر واستعر أنت معطفا",32,"ف",2,0],["تعينك من غير اقتراحك نعمةٌ","فتقطعُ بالإبراقِ فينا اللياليا",33,"ي",2,0],["تُعيرُكَ مُقلَةً نَطِفَت وَلَكِن","قُصاراها عَلى قَلبٍ بَرِيِّ",34,"ي",1,0],["تُعيدُ بِها شَبابَ المُلكِ غَضّاً","وَتَمنَعُ أَن يَذِلَّ وَأَن يُهونا",35,"ن",2,0],["تَعيا خُطوبُ الدَهرِ مِنهُ بِحُوَّلٍ","ما ضاقَ وَجهُ الرَأيِ إِلّا اِحتالا",36,"ل",2,0],["تُعَيِّرُنا أَنّا قَليلٌ عَديدُنا","فَقُلتُ لَها إِنَّ الكِرامَ قَليلُ",37,"ل",1,0],["تَعيبينَ الذُنوبَ وَأَيُّ حُرٍّ","مِنَ الفِتيانِ لَيسَ لَهُ ذُنوبُ",38,"ب",1,0],["تُعَيِّرُ سَيري في البِلادِ وَرِحلَتي","أَلا رُبَّ دارٍ لي سِوى حُرُّ دارِكِ",39,"ك",1,0],["تعيث بأهليها فتغصب حقهم","وتسلب من أَموالهم وتبيدها",40,"د",3,0],["تُعَيِّرُنَا كَعْبٌ كِلاَباً وقَتْلَهَا","ويُقْتَلُ أَدْنَى مِنْ كِلاَبٍ وأَضْعَفُ",41,"ف",1,0],["تعيرُها فارسُ واليونانُ","كما تهادى الزهرَ الجنانُ",42,"ن",1,0],["تعيي منابعك العقول ويستوي","متخبط في علمها ومحقق",43,"ق",1,0],["تُعِيدُ الْغُيَّبَ الذِّكْرَى","وتَشْفِي الأَنْفُسَ المَرْضى",44,"ض",2,0],["تَعِيشِينَ في زَاخِرٍ مِنْ ضِيَاءٍ","يُصَفِّقُ بِالأَمَلِ الْمُقْبِلِ",45,"ل",1,0],["تَعيِشُ مِصْرُ وتبقَى","فَقُرَّةُ العَيْنِ مِصْرُ",46,"ر",1,0],["تعيش بها بين مفقودة","وراقبة حتفها فاقده",47,"د",2,0],["تعيث قرود الجبت في سنة الهدى","اذا عقدوا شنعاء جاءت شنائع",48,"ع",1,0],["تَعيبُ على الشِّعرِ التَّحايا رقيقةً","وتلثُم من \" بغلٍ هجينٍ \" حوافرا",49,"ر",2,0],["تعيا القوافي ان تصُدَّ الجوى","يغلي ، ويعيا الدمعُ ان ينضُبا",50,"ب",2,0],["تعيشُ على الأرضِ أُمِّ الكفاحِِ","وتربُطُ أحلاَمها بالسَّما",51,"ا",1,0],["تعيد إلى الضعيف قوى وتهدي","إليه غبطة وصفاء فكر",52,"ر",1,0],["تعيد لعيني كلّ ما فات وانطوى","وترفع من بالي كلّ الطلول الدوارس",53,"س",1,0],["تُعَيِّرُها في النّارِ، وَالنّارُ تَلْتَقي","عَلَيْكَ بِزَقّومٍ لَهَا وَضِرَامِ",54,"م",1,0],["تعيشينَ بي كالعطرِ يَحيا بِوَردةٍ","وكالخمرِ في جوفِ الخوابي لها فِعلُ",55,"ل",1,0],["تُعيد يا عود بالأوتار إن نطقت","مَيتَ المَسرة حياً وهو ملحود",56,"د",1,0],["تُعيّرني العِدى بِسوادِ جلْدي","وبيض خصائلي تمحو السَّوادا",57,"د",2,0],["تعيرنا بفقد المال هند","وتجهل من اوائلنا الفعالا",58,"ل",2,0],["تَعيثُ الأخلاّءُ في ماله","كما عاث في جانب السِّربِ ذيبُ",59,"ب",1,0],["تعيرها منك مهما مال جانبها","لحظا يقوم منها ذلك الميلا",60,"ل",2,0],["تَعيشُ صَبابَتي وَيَموتُ صَبري","وَنَفسي لا تَعيشُ وَلا تَموتُ",61,"ت",1,0],["تَعِيشُ الناسُ ما عِشنا بِخَيرٍ","وَتَحيا ما حَيِينا في أَمانِ",62,"ن",1,0],["تعيدُ إلينا السرورَ القديم","كأنَّا خُلقنا بها من جديدِ",63,"د",1,0],["تعيش بلا قلب أتحيا بلا قلب","وفي مصر ما يغوى القلوب وما يسبي",64,"ب",2,1],["تعينون أيامي عليّ بصدكم","عفا الحب عنكم وهو بالحسن يرفق",65,"ق",1,0],["تعيد الصعب بالنَشوات سهلاً","وتُغني بالمُنَى الرجل الفقيرا",66,"ر",2,0],["تعيد أديم الضحى مُذْهبا","إذا لاح فوق دنانِيرها",67,"ر",3,0],["تُعِيد في إرقالها وتبتدي","كأنها في جِنَّة لم تُجهَد",68,"د",1,0],["تَعيب الوَرْدَ حمرةُ وجنتيْه","وتلعَب بالقرائح مُقلتاه",69,"ا",2,0],["تعيي وتعجز في لحاقك دونها","الراجون شأوك ايّما اعجاز",70,"ز",1,0],["تُعَيِّرُنِي بأَحْداثِ الْلَّيالِي","وَكَيْفَ يُدافِعُ الْبَدْرُ الْمِحاقا",71,"ق",2,0],["تُعَيِّرني بِالشَيبِ هِندٌ وَلَو دَرَت","بِفَضلِ مَشيبي زالَ عَن قَلبِها الجَهلُ",72,"ل",1,1],["تُعير الظَبيَ مُلتَفَتاً وَجيداً","وَتَكسو الغصنَ ليناً واِعتِدالا",73,"ل",2,0],["تعيديد حي اللَه عيديد كله","بسارية كماسري البرق أو رعدا",74,"د",2,0],["تُعيدانِ للخضراءِ عهد جذاذةٍ","يَفوقُ مَزايا الأقدمينَ جَديدها",75,"د",3,0],["تُعيي المفاقهَ فيه من نهجٍ على","أُسلوبِ إبداءٍ نوى تَخريجه",76,"ج",2,0],["تعيش التي احتقرت قلبها","وألقَتهُ في حمأة الطينة",77,"ه",1,0],["تعيشُ على الماضي وتخشى رجوعَه","وتهفو إلى المجهول ما دام خافيا",78,"ي",2,0],["تعيش للفانين عيش الزنيم","وأنت أنت السيد الآمر",79,"ر",1,0],["تعيث بها سافيات الرياح","وتنزو عليها ضواري الرخم",80,"م",1,0],["تَعيبُ مَضاءه وقَفَاتُ حِلْمٍ","كَعيْبِ المَشْرفيَّةِ بالفُلول",81,"ل",1,0],["تُعيدُهُمُ تِلكَ العَزائِمُ إِن سَطَت","حَواصِلَ مِصرٍ في حَواصِلَ مِن نَصرِ",82,"ر",1,0],["تَعيشُ مُنعِماً إِن مُتَ شَوقاً","فَكَم قَتَل الهَوى صَبّاً كَئيبا",83,"ب",2,0],["تعيشُ وتبقى أَنتَ في نعمةٍ فَما","أراك إذَا طَالَ الصّدود تَراني",84,"ي",1,0],["تُعيرُ وبالقَسرِ العنيفِ ارتجاعُها","ولا خَيرَ في عاريَّةٍ ردَّها القَسْرُ",85,"ر",1,0],["تعيدُ على سمعي أحاديث عتبها","كساجعة ورقاء تطرب بالسّجع",86,"ع",1,0],["تعير بوجهها الأقمار معنىً","إذا وافتك بارزة اللثام",87,"م",1,0],["تعير البدرَ من محياك حُسناً","كأَنَّ البدر طلعتَه استعارك",88,"ك",1,0],["تعيد علينا ما مضى من صبابةٍ","وتملي أحاديث الغرام فنفهمُ",89,"م",1,0],["تُعيدُ عليَّ ما تُبدي غَرَاماً","فكم تُبدي الغرامَ وكم تُعيدُ",90,"د",1,0],["تعيدون بدراً في وغاها فتية","ترج قلوب الناكثين الملكزِ",91,"ز",1,0],["تعيى بحمل السيف راحتُهُ","فكأنّها خلقت بلا حَبلِ",92,"ل",1,0],["تعيرُ طخياءُ العجاج فوقها","من صبغة الليل ضُحاها الماتعا",93,"ع",2,0],["تعيبُ عليَّ الشيبَ خنساءُ أن رأت","تطلّع ضوءِ الفجرِ تحت هزيعِ",94,"ع",1,0],["تعيش بخفضٍ ما تمنّت ونعمةٍ","بحيث سواها لو يُرَى فارَقَ العمْرا",95,"ر",2,0],["تعيَّفَ طيراً بارحاتٍ يَسَرنَهُ","بفقدك قد كانت ميامينَ تَسنحُ",96,"ح",1,0],["تَعيبُ على الوفاءِ نحولَ جسمي","ألا بالغدر أجدرُ أن تُعابي",97,"ب",2,0],["تعيّرني لَيْلَى الوفاءَ بعهدِهم","على بُعدِهم أنَّبْتِ غيرَ مُنيبِ",98,"ب",1,0],["تُعيدُ جبان الحي عند نشيدها","شجاعاً وتغني الشاربين عن الخمر",99,"ر",1,0],["تعيد الفجاج الغُبْر خضراً من الندى","وترجع ضوء الصُّبح بالبأس أغبرا",100,"ر",2,0],["تُعيد الدجى صبحاً وتنمي فخارها","إِلى واضحٍ من قيس عيْلان باهرِ",101,"ر",1,0],["تعيد لبيداً تعيريه بلادةٌ","وقلّ عبيد أن يكون بها عبدي",102,"د",2,0],["تُعيد الصّبا غدارنها بهبوبها","دروعاً وكانت قبل وهي مناصل",103,"ل",1,0],["تعيش بلادي وعاش بنوها","وبلغها منتهى الأرب",104,"ب",1,0],["تعيد المساعي غضة بعد يبسها","وشِيب المعاني بعد كبرتها مردا",105,"د",2,0],["تُعِيرُ المعاني من معانِي جمالها","ففي كل مَعْنىً من مَلاحتِها مَعْنَى",106,"ن",2,0],["تُعينهُمُ في الهوى أَعْيُنٌ","وينصرُهم رشَأٌ خَاذِلُ",107,"ل",1,0],["تُعيدُ شبَابَ العقل شَوْبا وشيبةً","ويرجعُ مِنْها للكبيرِ شَبَابُ",108,"ب",1,0],["تُعَيِّرُني سَلمى وَلَيسَ بِقُضأَةٍ","وَلو كُنتَ مِن سَلمى تَفَرَّعتَ دارِما",109,"م",2,1],["تَعي فُؤادَ الأَحوَذي كَأَنَّهُ","مِما أُصيبَ صَ