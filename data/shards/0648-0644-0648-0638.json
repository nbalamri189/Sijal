{"poems":[[27,"ألا إنما تيم لعمرو ومالك","https://www.aldiwan.net/poem4438.html","الطويل"],[70,"لها خفر يوم اللقاء خفيرها","https://www.aldiwan.net/poem42923.html","الطويل"],[105,"أتسأل مصر ما حمل العميد","https://www.aldiwan.net/poem42123.html","الوافر"],[46,"لقد أصبحت دنياك من فرط حبها","https://www.aldiwan.net/poem22604.html","الطويل"],[46,"لو كان يدري أويس ماجنت يده","https://www.aldiwan.net/poem23343.html","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147499","المتقارب"],[124,"ما حسن يوسف إلا منك مقتبس","https://www.aldiwan.net/poem782.html",""],[158,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[513,"دنا العيد هنيت أمثاله","https://www.aldiwan.net/poem12240.html","المتقارب"],[573,"غريمي ولكنه الماطل","https://www.aldiwan.net/poem3034.html","المتقارب"]],"verses":[["وَلَو ظَمِئَ التَيمِيُّ لَاِفتَظَّ أُمَّهُ","إِذا أَبصَرَ المَوماةَ غُبراً صُحونُها",0,"ن",3,0],["وَلَو ظَفِرَت لَيلى بِتُربِ دِيارِها","لَأَصبَحَ مِنها دُرُّها وَعَبيرُها",1,"ر",3,0],["ولو ظَفِرَتْ بأجنحةٍ لأَمْسَتْ","لها بين النُّسور مَدىً بعيدُ",2,"د",1,0],["وَلَو ظَهَرَت أَحداثُها لَسَمِعَتَها","تَغَيَّظُ أَو عايَنتَ أَعيُنَها خُزرا",3,"ر",2,0],["وَلَو ظَفِرتَ عَلى حالٍ بِحالِيَةٍ","جَزَّأتَها وَنَبَذتَ السورَ وَالخَدَما",4,"م",2,0],["ولو ظهر الأثم للناظرين","لراعك في الوجه منه كلف",5,"ف",1,0],["ولو ظَهَرتِ لمن أكبرنه شغفاً","لقُطّعت فيك أكبادٌ بلا ألم",6,"م",1,0],["ولو ظهرت آيات ربك للورى","بلا سبب ما بات منهم مكذب",7,"ب",1,0],["ولو ظميء الغيث لم أسقه","سوالي ولا ذاق سلساله",8,"ل",2,0],["ولو ظَفِروا بالَّذي نِلْتُه","لأَسلاَهُمُ ذلكَ النَّائِلُ",9,"ل",1,0]]}