{"poems":[[29,"ألا إنما تيم لعمرو ومالك","https://www.aldiwan.net/poem4438.html","الطويل"],[72,"لها خفر يوم اللقاء خفيرها","https://www.aldiwan.net/poem42923.html","الطويل"],[107,"أتسأل مصر ما حمل العميد","https://www.aldiwan.net/poem42123.html","الوافر"],[48,"لقد أصبحت دنياك من فرط حبها","https://www.aldiwan.net/poem22604.html","الطويل"],[48,"لو كان يدري أويس ماجنت يده","https://www.aldiwan.net/poem23343.html","البسيط"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/147499","المتقارب"],[130,"ما حسن يوسف إلا منك مقتبس","https://www.aldiwan.net/poem782.html",""],[164,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[520,"دنا العيد هنيت أمثاله","https://www.aldiwan.net/poem12240.html","المتقارب"],[580,"غريمي ولكنه الماطل","https://www.aldiwan.net/poem3034.html","المتقارب"],[1910,"","https://poetry.dctabudhabi.ae/diwan/poem/116546","الطويل"],[2221,"","https://poetry.dctabudhabi.ae/diwan/poem/34831","المجتث"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79710","الوافر"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129460","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131010",""],[4902,"جتني","https://www.poetsgate.com/ViewPoem.aspx?id=5043",""],[592,"لعمرك ما يدري الغبي بأنه","https://www.poetsgate.com/ViewPoem.aspx?id=128805",""],[5739,"أرحب يالهلاك ..!","https://www.poetsgate.com/ViewPoem.aspx?id=155471",""]],"verses":[["وَلَو ظَمِئَ التَيمِيُّ لَاِفتَظَّ أُمَّهُ","إِذا أَبصَرَ المَوماةَ غُبراً صُحونُها",0,"ن",3,0],["وَلَو ظَفِرَت لَيلى بِتُربِ دِيارِها","لَأَصبَحَ مِنها دُرُّها وَعَبيرُها",1,"ر",3,0],["ولو ظَفِرَتْ بأجنحةٍ لأَمْسَتْ","لها بين النُّسور مَدىً بعيدُ",2,"د",1,0],["وَلَو ظَهَرَت أَحداثُها لَسَمِعَتَها","تَغَيَّظُ أَو عايَنتَ أَعيُنَها خُزرا",3,"ر",2,0],["وَلَو ظَفِرتَ عَلى حالٍ بِحالِيَةٍ","جَزَّأتَها وَنَبَذتَ السورَ وَالخَدَما",4,"م",2,0],["ولو ظهر الأثم للناظرين","لراعك في الوجه منه كلف",5,"ف",1,0],["ولو ظَهَرتِ لمن أكبرنه شغفاً","لقُطّعت فيك أكبادٌ بلا ألم",6,"م",1,0],["ولو ظهرت آيات ربك للورى","بلا سبب ما بات منهم مكذب",7,"ب",1,0],["ولو ظميء الغيث لم أسقه","سوالي ولا ذاق سلساله",8,"ل",2,0],["ولو ظَفِروا بالَّذي نِلْتُه","لأَسلاَهُمُ ذلكَ النَّائِلُ",9,"ل",1,0],["ولو ظَفِرت عيني بشخصِكَ ساعة","لكنتُ على عيني من العين أتَّقي",10,"ق",2,0],["وَلَو ظَفِرتُ بِقَيحٍ","يَكونُ لِلنَّحرِ حِلفا",11,"ف",2,0],["ولو ظفرت لكان الفوز هلكا","على الدنيا وفوزا للحود",12,"د",1,0],["ولو ظفرت فيه نزار ويعرب","بيوم هياج والذمام ذمامها",13,"م",3,0],["ولو ظمئوا حتى تلظّت كبودهم","لما وقفوا من خوفهم عند منهل",14,"ل",1,0],["ولو ظلام الليل يعطينا الثبات","فيه من لون الشعر وإلا كساها",15,"ا",3,0],["ولو ظفر المخذول بالعلم والهدى","لأبداهما فوراً وما كان أحجما",16,"م",2,0],["ولو ظميتي .. ثم وردتي تشربين.","لك وريدي كان يقطع لك ظماك.",17,"ك",1,0]]}