غِنى","https://www.poetsgate.com/ViewPoem.aspx?id=16866",""],[11,"وما من شيمتي شتم ابن عمي","https://www.poetsgate.com/ViewPoem.aspx?id=15590",""],[90,"الشاعر السليب !","https://www.poetsgate.com/ViewPoem.aspx?id=178978",""],[90,"عاشوراء","https://www.poetsgate.com/ViewPoem.aspx?id=179150",""],[90,"سبيل الجَماهير","https://www.poetsgate.com/ViewPoem.aspx?id=178923",""],[90,"المحرقة","https://www.poetsgate.com/ViewPoem.aspx?id=179110",""],[45,"أُقيمُ عَلى التّشَوّقِ أمْ أسِيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=31342",""],[45,"يَهُونُ عَلَيْهَا أنْ أبِيتَ مُتَيَّما","https://www.poetsgate.com/ViewPoem.aspx?id=31883",""],[51,"يأْبى ليَ الضَّيْم فرْعيَ السامي","https://www.poetsgate.com/ViewPoem.aspx?id=30513",""]],"verses":[["وَما مُغزِلٌ أَدماءُ تُزجي بِرَوضَةٍ","طَلاً قاصِراً عَن غايَةِ السِربِ وانِيا",0,"ي",2,0],["وَما مِنهُمُ إِلّا اِمرُؤٌ شَبَّ ناشِئاً","عَلى نَمَطَي بَيضاءَ مِن آلِ هاشِمِ",1,"م",1,0],["وَما مَنظَرُ الحَسناءِ عِندي بِرائِقٍ","وَلا نَيلُها وَالقُربُ عِندي بِمَغنَمِ",2,"م",1,0],["وَما مَدَحتُهُمُ أَنّي رَجَوتُهُمُ","لَكِنَّهُ عُوَذٌ مِن شَرِّهِم وَرُقى",3,"ق",2,0],["وَما مِن هَوانٍ خَطَّأَ التُربَ فَوقَهُ","وَخَطَّ لَهُ بَيتاً مِنَ الأَمرِ ضَيِّقا",4,"ق",2,0],["وَما مُدَّ ما بَيني وَبَينَ مَذاهِبي","حِجازٌ وَلا سُدَّت عَلَيَّ المَطالِعُ",5,"ع",1,0],["وَما مَوقِفي وَالرَكبُ يَرجو عَلى الصَدى","مَوارِدَ قَد نَشَّت بِهِنَّ الوَقائِعُ",5,"ع",1,0],["وَما مَرِضَت لي في المَطالِبِ هِمَّةٌ","وَأَحداثُهُ في كُلِّ يَومٍ عَوائِدُ",6,"د",1,0],["وَما مُقامُ الحُرِّ في عيشَةٍ","لَها المَقاديرُ بِمِرصادِ",7,"د",1,0],["وَما مَسَّهُ مَجدٌ بَلى إِنَّ راحَةً","لَها نَسَبٌ في الماجِدينَ قِرابُ",8,"ب",1,0],["وما مُغْزِلٌ تَعْطو الأراكَ يَهُزُّهُ","نَسيمٌ تُناجيه الخَمائِلُ وانِ",9,"ن",1,0],["وما متَوقِّدُ اللّحَظاتِ يَحْمي","على حَذَرٍ مُعَرَّسَهُ بوَهْدِ",10,"د",1,0],["وما مَنَحَتْها العَيْنُ إذ عَثَرَتْ بِها","سوى نَظْرَةٍ رَوعاءَ منْ مُتَوَهِّمِ",11,"م",1,0],["وما مُغْزِلٌ فاءتْ إِلى خُوطِ بانَةٍ","نَأتْ بِمجانِيها عَنِ الخِشْفِ عاطِيا",12,"ي",2,0],["وَما مَرَرتُ بِقَومٍ في مَجالِسِهم","إِلاّ سَمِعتُهُمُ فينا يَخوضونا",13,"ن",2,0],["وَما مَرَّ يَومٌ أَرتَجي فيهِ راحَةً","فَأَخبُرَهُ إِلّا بَكَيتُ عَلى أَمسِ",14,"س",1,0],["وَما مِن حَبيبٍ وامِقٍ لِحَبيبِهُ","وَلا ذي هَوى إِلّا لَهُ الدَهرُ فاجِعُ",15,"ع",1,0],["وَما مَوتُ مَن قَد ماتَ قَبلي بِضائِري","وَلا عَيشُ مَن قَد عاشَ بَعدي بِمُخلِدي",16,"ي",1,0],["وما منْ يَدٍ إلا يَدُ اللهِ فوقَها","ومنْ شِيَمِ الموْلَى التّلطُّفُ بالعَبْدِ",17,"د",1,0],["وَما مُخدِرٌ وَردٌ عَلَيهِ مَهابَةٌ","أَبو أَشبُلٍ أَمسى بِخَفّانِ حارِدا",18,"د",2,0],["وَما مُزبِدٌ مِن خَليجِ الفُرا","تِ يَغشى الإِكامَ وَيَعلو الجُسورا",19,"ر",2,0],["وَما مُجاوِرُ هيتٍ إِن عَرَضتَ لَهُ","قَد كانَ يَسمو إِلى الجُرفَينِ وَاِطَّلَعا",20,"ع",2,0],["وَما مُزبِدٌ مِن خَليجِ الفُرا","تِ جَونٌ غَوارِبُهُ تَلتَطِم",21,"م",1,0],["وَما مِن مَجمَعٍ لِلخَيرِ إِلّا","وَمِن كَفَّيكَ سَحَّ عَلَيهِ وَبلُ",22,"ل",1,0],["وَما مُسبَطِرٌّ ماؤُهُ مُتَدَفِّقٌ","مِنَ الظَهرِ يَأتي غَيرَ زورٍ وَلا كَذِب",23,"ب",1,1],["وَما مُشبِلٌ من أُسد خَفّانَ باسِلٌ","يَذودُ الرَدى عَن أُمِّ شِبلَينِ في خِدرِ",24,"ر",1,0],["وَما مَنَعَ الظَعائِنَ مِثلُ ضَربٍ","تَرى مِنهُ السَواعِدَ كَالقُلينا",25,"ن",2,0],["وَما مَرَّ مِن يَومٍ عَلَيَّ كيومِها","وَإِن عَظُمَت أَيامُ أُخرى وَجَلَّتِ",26,"ت",1,0],["وَمَا مَلَكٌ مَنْ يَحْسُنُ العَيْشُ بَعْدَهَا","عَلَيْهَا سَلامٌ فِي الجِنَانِ وَرِضْوَانُ",27,"ن",1,0],["وَمَا مِنْكُمُ مَنْ يُسْتَعَانُ بِفَضْلِهِ","عَلَى الدَّهْرِ آناً بَعْدَ آنٍ فَيسْأَمُ",28,"م",1,0],["وَما مِن دونِ عِرضِكَ لِلقَوافي","شَبا قُفلٍ يُشَدُّ وَلا رِتاجِ",29,"ج",1,1],["وما مقبِس عند النهى غير قابس","ولا لابس عند النهي غير مُلبس",30,"س",1,0],["وما مدينّة الأقوام إلاّ","تعاوُنهم على غُرّ المساعي",31,"ع",2,0],["وما مات من أبقى له طيّب الثنا","لدى الناس من بادٍ ومن متحضر",32,"ر",1,0],["وما مات محمود الخصال وإنما","تنقّل من هذا الفناء إلى الخلد",33,"د",1,0],["وَما مَسَحَت عِندَ الحِفاظِ مُجاشِعٌ","كَريماً وَلا مِن غايَةِ المَجدِ دانِيا",34,"ي",2,0],["وَما مِن بَلاءٍ غَيرَ كُلِّ عَشِيَّةٍ","وَكُلِّ صَباحٍ زائِدٍ غَيرِ عائِدِ",35,"د",1,0],["وَما مِن فَتىً حَيٍّ بِيَحيى أَبيعُهُ","بِلا فاجِرِ الدُنيا وَلا غَيرِ فاجِرِ",36,"ر",1,0],["وَما مُستَنيرُ الخُبثِ إِلّا فَراشَةٌ","هَوَت بَينَ مُؤتَجِّ الحَريقَينِ ساطِعِ",37,"ع",1,0],["وَما مارَسَت مِن ذي ذُبابٍ شَكيمَتي","فَيُفلِتُ فَوتَ المَوتِ إِلّا عَلى خَبلِ",38,"ل",1,0],["وَما مِن لَئيمٍ عالَهُ الدَهرُ مَرَّةً","فَيَذكُرَها إِلّا اِستَمالَ إِلى البُخلِ",39,"ل",1,0],["وَما مِن شيمَتي شَتمُ اِبنِ عَمّي","وَما أَنا مُخلِفٌ مَن يَرتَجيني",40,"ن",2,1],["وما من تهتفين له لنصرٍ","بأسرع جابة لك من هديلِ",41,"ل",1,0],["وَما مَرَّ إِنسانٌ فَأَخلَفَ مِثلَهُ","وَلَكِن يُزَجّي الناسُ أَمراً مُوَقَّعا",42,"ع",2,0],["وَما مِنهُمُ عِندَ المَكارِمِ وَالعُلى","إِذا حَضَرَت يَوماً مِنَ الدَهرِ ماجِدُ",43,"د",1,0],["وما مات أو ماتت بحزنٍ نساؤه","وماتت بأحزان البلاد حماته",44,"ه",1,0],["وَما مُجاهَدَةُ الإِنسانِ تَوصِلُهُ","رزقَاً وَلادَعَةُ الإِنسانِ تَقطَعُهُ",45,"ع",2,0],["وما مَنْ كان ذا خُلُقَين شتَّى","وكانا ما جدَينِ بذي ائتشابِ",46,"ب",1,0],["ومأمونُهُ تحت محذورِهِ","ومرجوُّهُ تحت مرهوبِهِ",47,"ب",2,0],["وما مَعيبٌ بعادمٍ لقباً","كلُّ مَعيبٍ فَعيبُهُ لَقَبُهْ",48,"ب",2,0],["وَمَا مذْحجٌ إذْ كان منها بمَعْزِلٍ","عن الحْمدِ مَا لَمْ يَجْحَدِ الحقَّ جُحَّدُ",49,"د",1,0],["وما مطلُ ابن يحيى سائليه","ليوحشهم بذاك من العِوادِ",50,"د",1,0],["وما من شأنه استكثار عُوْدٍ","ولا استثقالُ معروفٍ مُعادِ",50,"د",1,0],["وما مات منه أسوةَ الناس ميِّتٌ","بل انقضَّ منه المشتَري أو عطاردُ",51,"د",1,0],["وما مثلُهُ يبقى علينا لأنه","لنا من هدايا الدهر ذي الغدر والختر",52,"ر",1,0],["وما مثلي من قيسٍ","بأهل الغدر والختر",53,"ر",1,0],["وما مرّ يومٌ أرتجي فيه راحةً","فأذكرها إلا بكيتُ على نفسي",54,"ي",1,0],["وما مثله خِيفَ الملالةُ والقلى","عليه ولكن المحب شفيقُ",55,"ق",1,0],["وما مللتَ العطايا فاسترحْتَ إلى","إغبابها بل همُ ملّوا عطاياكا",56,"ك",2,0],["وما مَرِضَتْ تلك العنايةُ مَرْضَةً","تُميتُ ولكنْ قد تطرَّقها نَهْكُ",57,"ك",1,0],["وما من علاءٍ في يدٍ عند ملكها","ولكنه لا شكّ عند فعالِها",58,"ل",3,0],["وما مثلُ إسماعيلَ جارَ قضاؤُه","وعدلُ الفتى في حكمه كاعتدالهِ",59,"ل",2,0],["وما من مُزْنِكم ما فيه دجنٌ","ولا من ريحكم هَيْفٌ جَفُولُ",60,"ل",1,0],["وما ملّئتْ منك الصدُورُ بهيبةٍ","ولا عِظَمٌ إلا وشأنك أعظمُ",61,"م",1,0],["وما منهما إلا الذي ما أتى له","من السن ما يبتز عنه التمائما",62,"م",2,0],["وما معروفُك الممدود عني","بمنقطعٍ إذا انقطع الكلامُ",63,"م",1,0],["وما من الحلمِ أن أُقِرَّ على ال","ظُلْم وأسبابِه لظلّامي",64,"م",2,0],["وما من العدل أن يُقْضَى نَعيمُهم","ومُصْطَلاي بِبَرْحٍ مُبْرحٍ فيه",65,"ي",2,0],["وَما مُزبِدٌ يَعلو جَزائِرَ حامِزٍ","يَشُقُّ إِلَيها خَيزُراناً وَغَرقَدا",66,"د",2,0],["وَما مُزبِدُ الأَطوادِ مِن دونِ عانَةٍ","يَشُقُّ جِبالَ الغَورِ ذو حَدَبٍ غَمرِ",67,"ر",1,0],["وَما مَنَعَت أَسماءُ يَومَ رَحيلِنا","أَمَرُّ عَلَيَّ مِن خَطائي وَمِن وِزري",68,"ر",2,0],["وَما مِثلُهُ في الناسِ إِلّا قَبيلُهُ","مُساوٍ وَلا دانٍ لَذاكَ قَريبُ",69,"ب",1,0],["وَما مِصرُ الَّتي مَلَكَت فُؤادي","وَلَكِن أَهلُها قَومٌ كِرامُ",70,"م",1,0],["وَما مُزنَةٌ جادَت فَأَسبَلَ وَدقُها","عَلى رَوضَةٍ رَيحانُها قَد تَخَضَّدا",71,"د",2,1],["وَما مالَ النَهارُ وَهُنَّ فيها","يُخَدِّرنَ الدِمَقسَ وَيَحتَوينا",72,"ن",2,0],["وَما ماءُ مُزنٍ مِن جِبالٍ مَنيعَةٍ","وَلا ما أَكَنَّت في مَعادِنِها النَحلُ",73,"ل",1,0],["وما من أمس للاقوام بد","وإن ظنوا عن الماضي انقطاعا",74,"ع",2,0],["وما ملا الشباب كروح سعد","ولا جعل الحياة لهم طماحا",75,"ح",2,0],["وما مال ذو حق وإن جل حقه","إلى الحقد إلا ضيع الحق واعتدى",76,"د",2,0],["وَما مَلَكوكِ في سوقٍ وَلَكِن","لَدى ظِلِّ القَنا وَالمُرهَفاتِ",77,"ت",1,0],["وَما مَوتٌ بِأَبغَضَ مِن حَياةٍ","أَرى لَهُمُ مَعي فيها نَصيبا",78,"ب",2,0],["وَما ماضي الشَبابِ بِمُستَرَدٍّ","وَلا يَومٌ يَمُرُّ بِمُستَعادِ",79,"د",1,0],["وَما مَطَرَتنيهِ مِنَ البيضِ وَالقَنا","وَرومِ العِبِدّى هاطِلاتُ غَمامِهِ",80,"م",2,0],["وَما مَنزِلُ اللَذّاتِ عِندي بِمَنزِلٍ","إِذا لَم أُبَجَّل عِندَهُ وَأُكَرَّمِ",81,"م",1,0],["وما ملأتُ يدي من ثروةٍ أبداً","إلّا وأصفرَها جُودٌ يُفرِّقُها",82,"ق",3,0],["وما مَنْصِبٌ إلا وقدريَ فوقَهُ","ولو حُطَّ رحلي فوق نَسْرٍ وفرقدِ",83,"د",1,0],["وَما مَلِكٌ يُخشى عَلى كَسبِ شاعِرٍ","بِمُرضِيَةٍ عِندَ المُلوكِ مَكاسِبُه",84,"ب",2,0],["وَما مَضى أَمسِ مِن عَيشٍ أُسَرُّ بِهِ","في حُبِّها فَأُرَجّى أَن يَعودَ غَدا",85,"د",2,0],["وَما مُسلِمُ الثَغرِ المُعانِدُ رَبَّهُ","بِناءٍ عَنِ الكَأسِ الَّتي اِشتَفَّ كافِرُه",86,"ر",2,0],["وَما مِن مَورِدٍ أَدنى لِرَيٍّ","مِنَ الأَنهارِ تَملِكُها البُحورُ",87,"ر",1,0],["وَما مِنهُما إِلّا زُنَيديقُ قَريَةٍ","يُلاكِنُ ماني حُمقُهُ وَيُعافِطُه",88,"ط",2,0],["وَما مَتَّعانا في المُقامِ بِأُنسِهِ","وَقَد عَلِما أَنَّ الفِراقَ سَريعُ",89,"ع",1,0],["وَما مَنَعَ الفَتحُ بنُ خاقانَ نَيلُهُ","وَلَكِنَّها الأَقدارُ تُعطي وَتَحرُمُ",90,"م",1,0],["وَما مِنهُما إِلّا يُرَجّي كَرامَةً","بِكَفَّيكَ أَو يَخشى العِقابَ فَيَهرُبُ",91,"ب",1,0],["وَما مِنهُما إِلّا يَرى أَنَّ حَقَّهُ","عَلَيكَ لَهُ يا اِبنَ الخَلايِفِ واجِبُه",92,"ب",2,0],["وَما مَنَعَتنا دارَها مِن قَبيلَةٍ","إِذا ما تَميمٌ بِالسُيوفِ اِستَظَلَّتِ",93,"ت",1,0],["وَما مِن بَلاءٍ غَيرَ كُلِّ عَشِيَّةٍ","وَكُلِّ غَداةٍ زائِراً غَيرَ عائِدِ",94,"د",1,0],["وَما مِن حَنيفٍ آلَ مَروانَ مُسلِمٍ","وَلا غَيرِهِ إِلّا عَلَيهِ لَكُم يَدُ",95,"د",1,0],["وَما مِن غُلامٍ مِن مَعَدٍّ عَلِمتُهُ","وَلا يَمِنِ الأَملاكِ مِن أَرضِ صَيهَدِ",96,"د",1,0],["وَما مُغزِلٌ بِالغَورِ غَورِ تِهامَةٍ","تَرَعّى أَراكاً مِن مَخارِمِها نَضرا",97,"ر",2,0],["وَما مِنهُما إِلّا بِهِ مِن دِيارِها","مَنازِلُ أَمسَت ماتَبيدُ سُطورُها",98,"ر",3,0],["وَما ماتَ عِندَ اِبنِ المَراغَةِ مِثلُها","وَلا تَبِعَتهُ ظاعِناً حَيثُ دَعدَعا",99,"ع",2,0],["وَما مِن بَلاءٍ مِثلُ نَفسٍ رَدَدتَها","إِلى حَيثُ كانَت وَهيَ عِندَ المُخَنَّقِ",100,"ق",1,0],["وَما مِن مُصَلٍّ تَعرِفُ الشَمسَ عَينُهُ","إِذا طَلَعَت أَو تائِهٍ غَيرِ عاقِلِ",101,"ل",1,0],["وَما مِن فَتىً كُنّا نَبيعُ مُحَمَّداً","بِهِ حينَ تَعتَزُّ الأُمورُ عِظامُها",102,"م",3,0],["وَما مِن فِراقٍ غَيرَ حَيثُ رِكابُنا","عَلى القَبرِ مَحبوسٌ عَلَينا قِيامُها",103,"م",3,0],["وَما مِنهُمُ إِلّا يُخَفِّضُ جَأشَهُ","إِلَيهِ بِقَلبٍ صارِمٍ وَحُسامِ",104,"م",1,0],["وَما مِنهُما إِلّا بَعَثنا بِرَأسِهِ","إِلى الشَأمِ فَوقَ الشاحِجاتِ الرَواسِمِ",105,"م",1,0],["وَما مِنهُما إِلّا تَوَلّى بِشِقَّةٍ","مِنَ القَلبِ فَالعَينانِ تَبتَدِرانِ",106,"ن",1,0],["وما منحَ الشمسَ شَمَّاسُها","وما خَبَأ القَسُّ في الخابيه",107,"ي",2,0],["وما ماتَ حتى أنْحَلَ الحبُّ جِسمَه","فلم يبقَ فيه للتُّرابِ نَصيبُ",108,"ب",1,0],["وَما مِن عَمى أُغضي وَلَكِن لَرُبَما","تَغامى وَأَغضى المَرءُ وَهُوَ بَصيرُ",109,"ر",1,0],["وَما مِن غايَةٍ إِلّا المَنايا","لِمَن خَلِقَت شَبيبَتُهُ وَشابا",110,"ب",2,0],["وَما مِنكَ الشَبابُ وَلَستَ مِنهُ","إِذا سَأَلَتكَ لِحيَتُكَ الخِضابا",110,"ب",2,0],["وَما مِن فَتاً إِلّا سَيَبلى جَديدُهُ","وَتُفني الفَتى الرَوحاتُ وَالدَلَجاتُ",111,"ت",1,0],["وَما مَلجَأٌ لي غَيرَ مَن أَنا عَبدُهُ","إِلى اللَهِ رَبّي شِقوَتي وَسَعادَتي",112,"ي",1,0],["وَما مِن صَباحٍ مَرَّ إِلّا مُؤَدِّباً","لِأَهلِ العُقولِ الثابِتاتِ البَصائِرِ",113,"ر",1,0],["وَما مَن يَخافُ البَعثَ وَالنارَ آمِنٌ","وَلَكِن حَزينٌ موجَعُ القَلبِ خائِفُ",114,"ف",1,0],["وَما مُلكٌ لِذي مُلكٍ بِباقٍ","وَهَل يَبقى عَلى الحَدَثانِ مُلكُ",115,"ك",1,0],["وَما مِن مَذهَبٍ إِلّا إِلَيهِ","وَإِنَّ سَبيلَهُ لَهُوَ السَبيلُ",116,"ل",1,0],["وَما مِن مَسلَكٍ إِلّا","وَرَيبُ الدَهرِ شامِلُهُ",117,"ل",2,0],["وَما مِن مُحِبٍّ نالَ مِمَّن يُحِبُّهُ","هَوى صادِقاً إِلّا سَيَدخُلُهُ زَهوُ",118,"و",1,0],["وما مجانبتي من عاش في بصري","فأينما التفتت عيني تلاقيه",119,"ه",1,0],["وما مُطْرَفٌ إلّا أبيٌّ بِحُرْمَةٍ","عُبابٌ خِضَمٌّ حُلَّ عن حَسرِهِ المَدُّ",120,"د",1,0],["وما ماتَ مُبْقي أحْمَدٍ وَمُحَمَّدٍ","فَإِنَّهُما سَدّا المَكانَ الَّذي سَدّا",121,"د",2,0],["وَما مِن شِدَّةٍ إِلّا سَيَأتي","لَها مِن بَعدِ شِدَّتِها رَخاءُ",122,"ا",2,0],["وَما ماتَ حَتّى ماتَ مَضرِبُ سَيفِهِ","مِنَ الضَربِ وَاِعتَلَّت عَلَيهِ القَنا السُمرُ",123,"ر",1,0],["وَما مِن لَبوسٍ سِوى السابِغاتِ","تَرَقرَقُ مِثلَ مُتونِ الإِضاءِ",124,"ا",2,0],["وَمَا مِصْرُ عُمْرَ الدَّهْرِ إِلَّا غَنِيمَةٌ","لِمَنْ حَلَّ مَغْنَاهَا وَنَهْبٌ مُقَسَّمُ",125,"م",1,1],["وما منصبَ الشهباءِ كُفْواً لعلمِهِ","غلطتَ ولا دارُ السلامِ ولا مصرُ",126,"ر",1,0],["وَما مَلِلتُ وَلَكِن زادَ حُبُّكُمُ","وَما ذَكَرتُكِ إِلّا ظِلتُ كَالسَدِرِ",127,"ر",1,0],["وَما مِن لِقاءٍ يُرتَجى بَعدَ هَذِهِ","لَنا وَلَهُم دونَ اِلتِفافِ المُجَمَّرِ",128,"ر",1,0],["وما ملكت صبرا ديار أمية","ولا حملت أرض الحجاز فتى جلدا",129,"د",2,0],["وما مُلْكُ الهلالِ بِمُستباحٍ","وإن غَفَتِ القواضبُ عنه حينا",130,"ن",2,0],["وما من حيلةٍ في التُّركِ تُجدِي","إذا ذَعروا المقانبَ مُقدِمينا",130,"ن",2,0],["وَما مِن حِكمَةٍ في الأَرضِ إِلّا","لِقَومِكَ فَضلُها في العالَمينا",131,"ن",2,0],["وَما مِصرُ إِلّا رَجاءُ الجَميعِ","فَإِن ذَهَبَت ذَهَبوا في الأَثَرْ",132,"ر",1,0],["وَما مِن فَتىً تَغشى المَهانَةُ قَومَهُ","فَيَطمَع أَن يُلفي مِنَ الناسِ مُكرِما",133,"م",2,0],["وَما مَلَكَت يَدي في الدَهرِ إِلّا","يَراعَ أَمانَةٍ وَلِسانَ صِدقِ",134,"ق",1,0],["وَما مِصرُ إِلّا مَوطنٌ نَحنُ أَهلُهُ","عَزيزٌ عَلَينا أَرضُهُ وَسَماؤُهُ",135,"ا",3,0],["وما مَلِكُ الشآمِ وَمَنْ يَلِيهِ","كَمَنْ وَافَيْتُما تَستَعطِفانِ",136,"ن",1,0],["وما من معشرٍ يا كعبُ إلا","على حُكْمِ النبيِّ لهم نُزولُ",137,"ل",1,0],["وَما مِنكُما إِلّا سَعيدٌ مُهَنّأٌ","وَلَكِن لِذي اللُبِّ الهَناءُ المُحَقَّقُ",138,"ق",1,0],["وَما ماءُ ذاكَ الثَغرِ عِندي غالِياً","بِماءِ شَبابي وَاِقتِبالِ زَماني",139,"ي",1,0],["وَما مُنِعَت دارٌ وَلا عَزَّ أَهلُها","مِنَ الناسِ إِلّا بِالقَنا وَالقَنابِلِ",140,"ل",1,0],["وَما مِن حَبيبٍ يَستَزيدُ حَبيبَهُ","يُعاتِبُهُ في الوُدَّ إِلّا تَفَرَّقا",141,"ق",2,0],["وَما ماتَ مِنّا سَيِّدٌ حَتفَ أَنفِهِ","وَلا طُلَّ مِنّا حَيثُ كانَ قَتيلُ",142,"ل",1,0],["وما ماءٌ تَلَقَّى وهْوَ مِلْحٌ","أُجاجٌ طَعْمُهُ إِلَّا يَطِيبُ",143,"ب",1,0],["وما مُحمَّدٌ إِلَّا رَحمَةٌ بُعِثَت","لِلعالَمِينَ وفَضلُ اللَّه مَبْذُولُ",144,"ل",1,0],["وما مثلها مما تعاظم في الندى","ولا غيرها مما يقل ويكثر",145,"ر",1,0],["وما من قليل سُدتَ أبناءَ هاشم","وإن كان منهم سادةٌ وأكارم",146,"م",1,0],["وما مُغزِلٌ أدْماءُ دانٍ بَريرُها","تَرَبَّعُ أيْكاً ناعِماً وتَرُودُ",147,"د",1,0],["وَما مِثلُ مَنصوريكَ مَنصورِ هاشِمٍ","وَمَنصورِ قَحطانٍ إِذا عُدَّ مَفخَرُ",148,"ر",1,0],["وَما مِنها لَهُ شَيءٌ","أَلا هَذا هُوَ العارُ",149,"ر",1,0],["وَما مِنهُما إِلّا وَطارَ بِشَخصِهِ","نَجيبٌ وَطارَت لِلكِلابِ رَواجِبُه",150,"ب",2,0],["وَما ماتَ مَيتٌ مَرَّةً في سِواهِما","كَخَصمَينِ في الأَرواحِ يَفتَرِعانِ",151,"ن",1,0],["وَما مَنَعَ الأَوطانَ إِلّا حُماتُها","وَذادَتُها مِن ذِي شَبابٍ وَأَشيبِ",152,"ب",1,0],["وما من حياة للفتى غير هذه","فليس له يوماً إذا مات رجعان",153,"ن",1,0],["وَما مكانك فيهم","يا شعر إلا اليفاع",154,"ع",1,0],["وما مصرُ والسودانُ إلَّا قضيَّةٌ","مُوحَّدَةٌ في غايةٍ وجهودِ",155,"د",1,0],["وَما مِثلي جَزوعٌ في لَظاها","وَلَستُ مُقَصِّراً إِن جاءَ داعي",156,"ي",1,0],["وَمَا مَاتَ مَنْ أَبْقَاكَ تَهْتِفُ بِاسْمِهِ","وَتُذْكَرُ عَنْهُ صَالِحَاتُ الْمَنَاقِبِ",157,"ب",1,0],["وَمَا مِصْرُ إِلا جَنَّةٌ بِكَ أَصْبَحَتْ","مُنَوِّرَةً أَفْنَانُهَا وَالْخَمَائِلُ",158,"ل",1,0],["وَمَا مَاتَ مَنْ أَبْقَى عَلَى الدَّهْرِ فَاضِلاً","يُؤَلِّفُ أَشْتَاتَ الْمَعَالِي وَيَجْمَعُ",159,"ع",1,0],["وَمَا مِنْهُمُ لِلْعِدَى مُرْشدٌ","سِوَى غَادِرٍ سَاءَ مِنْ مُرْشد",160,"د",1,0],["وَمَا مِصْرَ إلا جَنَّةُ الأَرْضِ سُيِّجَتْ","بِكُلِّ بَعِيدِ الهَمِّ غَضِّ إِهَابِ",161,"ب",1,0],["وَمَا مِثْلُ الْقَضَاءِ مَجَالُ فَخْرٍ","وَلاَ مِثْلُ العَدَالَةِ رَمْزُ طُهْرِ",162,"ر",1,0],["وَما مِنْ مَطْلَعٍ أَصْفَى","وَما مِنْ طَالعٍ أَهْدَى",163,"د",2,0],["وَمَا مِنْ دَارِ بِرٍّ لَمْ تَجِدْهُ","إلى دَاعيَه لِلْحُسْنَى قَرِيبا",164,"ب",2,0],["وَمَا مِنْ دَارِ بِرءٍ لَمْ تَجِدْهُ","إِذَا اعْتَلَّتْ لَعُلَّتِهَا طَبِيبَا",164,"ب",2,0],["وَمَا مِنْ شَقَّةٍ فِيهَا حِزَامٌ","وَلاَ جِيلٌ هُنَاكَ يَذُودُ جِيلاَ",165,"ل",2,0],["وما منت أَدري قَبلَ عَزَّةَ ما البُكا","وَلا مُوجِعاتِ القَلبِ حَتَّى تَوَلَّتِ",166,"ت",1,0],["وما مَجازُ كلام من حقيقته","ولا شهادة علم مثل تقْلِيدِ",167,"د",1,0],["وما مَاتَ مَنْ أَبْقى ثَنَاءً مُخلَّداً","وذِكْراً يُسَامِي النَّيِّراتِ وَيفْرَع",168,"ع",1,0],["وما مَاتَ من أبقى لمصر مجادةً","تُطاول أعنانَ السماءِ بغَاربِ",169,"ب",1,0],["وما مات مَنْ رَدّ الحياةَ لأمَّةٍ","وأحيا بها الآمالَ وهي يَباب",170,"ب",1,0],["وما مصرُ إلا مهادُ العلوم","ورمزُ الحضارةِ منذُ القِدَمْ",171,"م",1,0],["وما مات إبراهيمُ، لكنَّه على","ممرِّ الليالي خالدُ الذكر، عاطره",172,"ر",2,0],["وما مِنْ لَئيمٍ عالَهُ الدّهْرُ مَرّة","ً فيذكرها، إستمال إلى البخل",173,"ل",1,0],["وما من شيمتي شتم ابن عمي","وما من مخلف من يرتجيني",174,"ن",2,1],["وما منهمُ الا كما البرجُ ناهض","علينا ومثل الكلب للتُرب ساجد",175,"د",1,0],["وماماتَ حتى بيَّن الحزمَ لابنه","كتابٌ حوى رأساً حكيماً مفكرا",176,"ر",2,0],["وما منهمُ الا الذي إنْ صَفَتْ له","لَياليه يَبْطَر ، او تُكَدِّرْ يُعربِد",177,"د",1,0],["وما ميَّزتْهُ عن سواه فوارقٌ","سوى أنه قد أتقنَ الرَّقصَ والزمرا",178,"ر",2,0],["وَمَا مِنْ مَوْرِدٍ أدنَى لري لَدَيْهِ","منَ الأنهارِ، تَمْلِكُها البُحُورُ",179,"ر",1,0],["وَما مانعٌ مِمّا تَوَهّمتُ غَيرَ أنْ","تَذَكّرَ بَعضَ الأُنْسِ، أو تتَذمّمَا",180,"م",2,0],["وما من الحلمِ أن أُقِرَّ على","الظْ ظُلْم وأسبابه لظلاَّمي",181,"م",2,0]]}