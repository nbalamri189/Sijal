{"poems":[[119,"هز منها النسيم خصراً رفيعاً","https://www.aldiwan.net/poem41758.html","الخفيف"],[259,"ياعظيم الشأن","https://www.aldiwan.net/poem25013.html","مجزوء الرمل"],[309,"يا رسول الله يا أهل الوفا","https://www.aldiwan.net/poem16816.html","الرمل"],[358,"يا رجائي في شدتي ورخائي","https://www.aldiwan.net/poem40841.html","الخفيف"],[396,"ياعظيم الفضل يا معطي الجزيل","https://www.aldiwan.net/poem54433.html","عموديه"],[396,"يا غياث المستغيثين أغث","https://www.aldiwan.net/poem54550.html","عموديه"],[396,"يا عظيم الفضل يا معطي","https://www.aldiwan.net/poem54628.html","عموديه"],[408,"قد آن أن تلوي العنان وتقصرا","https://www.aldiwan.net/poem46979.html","الكامل"],[505,"لا تعنف مولها أحمديا","https://www.aldiwan.net/poem37649.html","الخفيف"],[543,"أينما كنت كنت رمز الكمال","https://www.aldiwan.net/poem47986.html","عموديه"],[563,"عم صباحا أيها الطلل","https://www.aldiwan.net/poem34224.html","المديد"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119965","الرمل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202069","الرجز"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112762","الرمل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64549","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125369","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77378","الخفيف"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126228","الخفيف"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104677","الرمل"],[3545,"","https://poetry.dctabudhabi.ae/diwan/poem/131388","الخفيف"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66406","الرمل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85190","الرجز"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123506","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83444","الخفيف"],[5121,"رعشة","https://www.poetsgate.com/ViewPoem.aspx?id=33585",""],[5652,"دُرتي","https://www.poetsgate.com/ViewPoem.aspx?id=192118",""],[5864,"الشام","https://www.poetsgate.com/ViewPoem.aspx?id=190337",""],[192,"فهد بن سلمان","https://www.poetsgate.com/ViewPoem.aspx?id=16371",""],[6339,"مناجاة قلب..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87891&r=&rc=3",""],[5064,"في رثاء ملك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87519&r=&rc=14",""]],"verses":[["يا عظيم المقام يا مرشد الإس","لام يا غوث من دعاك ملوعا",0,"ع",2,0],["ياعظيمَ الشأنِ ارْحَمْ","مُسْتَجيراً خاف لوما",1,"م",2,1],["يا عظيم المن والإفضال وال","جود والعرف الذي قد وصفا",2,"ف",2,0],["يا عَظيماً يُرجى لِكُلِّ عَظيم","وَقَويّاً في نُصرَةِ الضُعَفاءِ",3,"ا",2,0],["ياعظيم الفضل يا معطي الجزيل","يا كثير الخير جمل ياجميل",4,"ل",1,1],["يا عظيم الفضل يا ذا الجوديا","حي يا قيوم هب لي من عطاك",5,"ك",1,0],["يا عظيم الشان مالي غيركم","لست أرجو غيركم لاذا وذاك",5,"ك",1,0],["يا عظيم الفضل يا معطي الجزيل","يا صمد يا من عوائدك الجميل",6,"ل",1,1],["يا عُظم ما نالَتهُ مِنك مَعَاشِرٌ","سُحقاً لهم بين البريّة معشرا",7,"ر",2,0],["يا عظيماً رآى التواضَعَ لل","هِ اعتلاءً والفقر كنزاً وفيّا",8,"ي",2,0],["يا عظيماً في عينِ كلِّ عَظيمٍ","وعظيمَ الأقوالِ والأفعالِ",9,"ل",1,0],["يا عظيم الخطب أنت لها","لا يُمِلْكَ القصدُ والأمل",10,"ل",1,0],["يا عظيم القدر ما تذ","خر إلا للعظائم",11,"م",1,0],["يا عَظمَ ما كانت به من مَخْمَصَهْ","مُورِثَةٍ إياه هذى المنْقِصَهْ",12,"ه",1,0],["يا عظيم الفيض إني قد نزلت","بكم فارحم فقل لي قد فعل",13,"ل",1,1],["يا عظيم السلطان يا باهر القد","رة غلب أيدي وأيد محلي",14,"ل",2,0],["يا عظيماً قد نالَ عزاً ومجدا","لستُ أنسى نداكَ قُرباً وبُعدا",15,"د",2,1],["يا عَظيمَ الثَراءِ يا واسِعَ الجو","دِ وَيا مالِئ المَناجِمِ تِبرا",16,"ر",2,1],["يا عَظِيمَ النَوالِ مَن لِى بهذا","حُبُّ هذا بذا الفُؤادِ الغَوِىِّ",17,"ا",1,0],["يا عَظيمَ الخُلقِ أَجمَل","بَل وَأَسنى مِن ذُكاءِ",18,"ا",2,0],["يا عظيما يرجى لكل عظيم","لا يقاسى من الأمور العظام",19,"م",1,1],["يا عظيم المنّ يا من قصرت","ألسن المدّاح عن إدراك وصفك",20,"ك",1,1],["يا عظم ما أبداه من معاني","كم مغرم فيها لها معاني",21,"ي",1,0],["يا عظيما يرجى لكل عظيم","وعزيزا لديه ذل العاصى",22,"ص",2,0],["يا عَظيماً يُرجى لكلّ عَظيمٍ","جَلَّ خَطبي قَديمُهُ وَالحَديثُ",23,"ث",1,0],["يَا عَظِيِمَ الْشَّأنِ رَبِّي","عَافِنِي بِالْيَوْمِ شَهْرَا",24,"ر",2,0],["ياعظيمة في عيووووني تشبهين","وبل .. هتانٍ تناثر وإزدهر ..!!",25,"ر",1,0],["ياعظيماً ، بِهِ القلوبُ اطمأنَّت","آسِ شَعباً مهمَّشاً مكروبا",26,"ب",2,0],["ياعظيم الباس يالله .. اجبر أهلٍ فاقدينه","واغفر لفهد وتقبّل واجعل الجنة ثوابه",27,"ب",2,0],["يا عظيم الرجاء يا من بعفو","منه تعفو الورى.. فيحلو الإخاء",28,"ا",2,0],["يَا عظَّمَ اللهُ أَجْرَ العُرْبِ فِي ملِكٍ","مِنَ الخَلِيجِ إِلى صنْعَا إِلى حَلَبِ",29,"ب",1,0]]}