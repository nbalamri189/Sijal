{"poems":[[89,"خلعت في حب غزلان الحمى رسني","https://www.aldiwan.net/poem8236.html","البسيط"],[105,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""],[146,"أكذا يجازى ود كل قرين","https://www.aldiwan.net/poem58441.html","الكامل"],[182,"الطريد","https://www.aldiwan.net/poem50688.html","الكامل"],[333,"هذا الطريق الطويل","https://www.aldiwan.net/poem54924.html","المجتث"],[563,"هذا الطريق بدا فأين السالك","https://www.aldiwan.net/poem34284.html","الكامل"],[563,"هذا الطريق الأقرب","https://www.aldiwan.net/poem34925.html","مجزوء الكامل"],[567,"يا أيها القبر فيك الناس قد رقدوا","https://www.aldiwan.net/poem52822.html","البسيط"],[567,"لا تبك إن جد بعض القوم في السفر","https://www.aldiwan.net/poem52923.html","البسيط"],[874,"","https://poetry.dctabudhabi.ae/diwan/poem/104472","البسيط"],[969,"","https://poetry.dctabudhabi.ae/diwan/poem/145608","المجتث"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137874",""],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137875",""],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137876",""],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137873",""],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49923","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/78011","الكامل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137359",""],[3465,"","https://poetry.dctabudhabi.ae/diwan/poem/116607","الكامل"],[3640,"","https://poetry.dctabudhabi.ae/diwan/poem/141889","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90795","الكامل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4898,"وطني الكبير !","https://www.poetsgate.com/ViewPoem.aspx?id=35778",""],[5038,"أسحار الملاح","https://www.poetsgate.com/ViewPoem.aspx?id=195420",""],[5187,"شبح الهزيمة","https://www.poetsgate.com/ViewPoem.aspx?id=29249",""],[5277,"دمعةٌ على وجنةِ الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=189757",""],[5358,"متى تعود لنا","https://www.poetsgate.com/ViewPoem.aspx?id=21899",""],[5573,"دربي طويل وسكتي مالها زي","https://www.poetsgate.com/ViewPoem.aspx?id=201932",""],[5611,"كل امرىء وسط التراب يكون","https://www.poetsgate.com/ViewPoem.aspx?id=165153",""],[5956,"اتّق شرّ من أحسنت إليه","https://www.poetsgate.com/ViewPoem.aspx?id=192409",""]],"verses":[["هَذَا الطَّرِيقُ فَإِنْ أَخْطَأْتَ شِرْعَتَهُ","أَضَعْتَ نَفْسَكَ بَيْنَ الْحَوْضِ وَالْعَطَنِ",0,"ن",1,0],["هذا الطعام المر ما صنعته لي","أمي ولا وضعوه فوق خوان",1,"ن",1,0],["هذا الطريقُ اللَّحْبُ زاجرُ ناقتى","واليمُّ قاذفُ فُلكىَ المشحونِ",2,"ن",1,0],["هذا الطَّريدُ كِلامُهُ في حينهِ","ما حانَ حينٌ كيْ يُجَنِّبَهُ الوَنا",3,"ن",2,0],["هذا الطريق الطويل","المدلهمّ الظلام",4,"م",1,1],["هذا الطريق الطويل","متى يرى منتهاه",4,"ه",1,0],["هذا الطريق بدا فأين السالكُ","ما الناس إلا سالم أو هالكُ",5,"ك",1,1],["هذا الطريق الأقربُ","فخذوا المدامة واشربوا",6,"ب",3,1],["هذا الطريقُ الذي لا بُدَّ يَسلُكُهُ","جميعُ ما وَلَدَتْ أُنثَى وما تَلِدُ",7,"د",1,0],["هذا الطَريقُ إلى دارِ البَقاءِ لنا","فلا تَفاوُتَ بينَ الطُولِ والقِصَرِ",8,"ر",1,0],["هذا الطريق الذي قد ضل عنه بنو","الآداب ما بين تخميس وتسديس",9,"س",1,0],["هذا الطبيب المداوي","هذا الحكيم المعاني",10,"ن",2,0],["هذا الطراديّ فازت عزيمته","بعزة النصر في هيجاء دنياه",11,"ا",2,1],["هذا الطرادي الذي لما مضى","كم ناح طرف اجبة واقارب",12,"ب",1,1],["هذا الطرادي نعوم الذي ملئت","ارياف مصر وسوريا بشهرته",13,"ت",2,1],["هذا الطراديّ الذي لما قضى","سحت عيون الناس دمعا كالدما",14,"م",2,1],["هذا الطريقُ المستقيمُ وزُيِّنت","في نفسهِ التَقوى بحُسنِ إيابهِ",15,"ب",2,0],["هذا الطعام وذا الشراب لتطعموا","ولتشربوا ما إن عليه حساب",16,"ب",1,0],["هذا الطبيب كساها ثوب عافية","فما تكاد لعمرى تشتكى سقما",17,"م",2,0],["هذا الطريقُ إلى المكارم مهيعاً","فاسلك فقد أبصرت قصدَ المهيع",18,"ع",1,0],["هذا الطّرف في طرف","منها على قاطنيها للإله يد",19,"د",1,0],["هذا الطريق فللرفيق تهيئوا","فلنا الأمان به من الأوجال",20,"ل",1,0],["هذا الطهورُ ظهورٌ","على الزمانِ وأَمرُ",21,"ر",1,0],["هذا الطريقُ وقد تبيَّنَ وجْهُهُ","مَا عَادَ مُحْتاجَاً إلى تَبْيَان ِ",22,"ن",1,0],["هذا الطَّريقُ أ يُوسُفٌ بِتُرابِهِ","سالَتْ كُلومُ السّالِكينَ عِلالا",23,"ل",2,0],["هذا الطريقُ ولا حياةَ بدونِهِ","مهما ارتأتْ وتَقَلّبتْ أفكارُنا",24,"ن",2,0],["هذا الطريقُ وتلك العيسُ راحلةٌ","واستوحش الركبُ فيه الدربَ والسُبلا",25,"ل",2,0],["هذا الطريقُ الذي كنا نمرُّ بهِ","مُمَزّقٌ سُبُلاً يا أيها السُّبُلُ",26,"ل",1,0],["هذا الطريق ولو طوى خاطري طي","رجلي عليه وماطرت لي طواري",27,"ر",2,0],["هذا الطويبيّ عالم ثبت الحوى","شرع الرسول وللحقوق يصونُ",28,"ن",1,0],["هذا الطويل لسانه وذراعه","أنا قادر أؤذيه لكنْ كاظمُ",29,"م",1,0]]}