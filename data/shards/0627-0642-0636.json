,"مدينة العلم طه والوصي لها","https://www.poetsgate.com/ViewPoem.aspx?id=155719",""],[520,"أعندك ان وجدي واكتئابي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577433",""],[6202,"سبعون","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86728&r=&rc=29",""],[6218,"وطن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65865&r=&rc=19",""],[6223,"طارقة السحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1216&r=&rc=1",""],[463,"جرتْ لها ببابلٍ يمينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60234&r=&rc=290",""],[6320,"وَخْزُ الرِّمَاح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84350&r=&rc=47",""],[4222,"لو كان من شكوى الصبابة مشكيا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52920&r=&rc=212",""]],"verses":[["أَقضى عَليها أَرَباً مِن هِمَّةٍ","لَو عَدَلَ الدَهرُ ثَنى زِماعَها",0,"ع",3,0],["أَقضَموها بَدَلَ الرُطبِ الجَنى","وَسَقوها بَدَلَ الماءِ العُقارا",1,"ر",2,0],["أُقَضّي نَهاري بِالحَديثِ وَبِالمُنى","وَيَجمَعُني بِاللَيلِ وَالهَمَّ جامِعُ",2,"ع",1,0],["أُقَضّيهِ في الأَشواقِ إِلّا أَقَلَّهُ","بَطيءَ سُرىً إِلى اللُبثِ مَيلَهُ",3,"ل",2,1],["أَقضي المَصيفَ بِلُبنانٍ عَلى شَرَفٍ","وَلا أَحولُ عَنِ المَشتى بِحُلوانِ",4,"ن",1,0],["أَقضي نَهاري بِالأَماني الكَواذِبِ","وَآوي إِلى لَيلٍ بَطيءِ الكَواكِبِ",5,"ب",1,0],["أَقضي اللُبانَةَ لا أُفَرِّطُ ريبَةً","أَو أَن يَلومَ بِحاجَةٍ لُوّامُها",6,"م",3,0],["اقضِ لي حاجتي ولا تمطلنّي","فأرى الغُنم من نداكا غراما",7,"م",2,1],["أَقَضَّ هَذا الفِراشُ جَنبي","كَأَنَّ في مَضجَعي الإِبَر",8,"ر",1,0],["أُقَضّي نَهارِيَ طائِرَ النَفسِ حائِراً","وَأَقطَعُ لَيلي كاسِفَ البالِ مَناهِيا",9,"ي",2,0],["اقض ايامك القليلة في الضحك","ولا تؤذ العين بالعبرات",10,"ت",1,0],["أقضِّى الليل حول السجن شوقا","للحيته أناجيها أطِلى",11,"ل",2,0],["أَقضِ مِن لَذَّتي وَأَعهَدُ إِنّي","لا أَرى ذا الصُدودَ مِنكَ جَميلا",12,"ل",2,0],["اِقضِ عَلى خِلِّكَ أَو ساعِدِ","عِشتَ بِجِدٍّ في العُلى صاعِدِ",13,"د",1,1],["أُقَضّي نَهاري بِالحَديثِ وَبِالمُنى","وَيَجمَعُني وَالهَمَّ بِاللَيلِ جامِعُ",14,"ع",1,0],["أقضّي نهارِي بالحديثِ وَبِالمُنَى","وَيجمَعُني وَاللَّيلَ للهَمّ جَامِعُ",15,"ع",1,0],["أَقضي رقادي في غَير مضجعها","أَخشى إِذا اِستيقَظت أَسهّرها",16,"ر",3,0],["أَقَضِيَةٌ لا تَزالُ وارِدَةٌ","تَحارُ في كَونِها الأَلِبّاءُ",17,"ب",3,0],["أُقَضّي الدَهَر مِن فِطرٍ وَصَومِ","وَآخُذُ بُلغَةً يَوماً بِيَومِ",18,"م",1,1],["أقضية الله دعت","فأسمعت إذ هتفت",19,"ت",1,0],["أَقضي بِها أَرَبي وتُبلِغُني","قابُوسَ أَهلَ الُملكِ والَحَسبِ",20,"ب",1,0],["أَقَضَى اليَوْمَ حَتْفَ أَنْفٍ وَأَقْصَى","مَا رَجَا أَنْ يَمُوتَ مَوْتَ شَهِيدِ",21,"د",1,0],["أقَضَّ موتُك من مصرٍ مضاجعَها","وأسكت الخطبُ أطياراً وأدواحا",22,"ح",2,0],["أقضي الحياةَ هناكَ يوَمًا واحدًا","مُتكرِّرًا، في منظرٍ متشابه",23,"ب",2,0],["أقضى مرامِك أن تَفيضَ فتشتكى","ظمأ ربوعُك او تفيض فتغرقا",24,"ق",2,0],["أقضي نهاري طائر النفس حائرا","وأقطع ليلي كاسف البال ساهيا",25,"ي",2,0],["أقضيه فى الأشواق إلا أقله","بطئ سرى أبدى إلى اللبث ميله",26,"ل",2,1],["أَقضى قُضاة المُسلِمين وَقامع ال","قَوم البُغاة بِصارم الإِنصافِ",27,"ف",1,0],["أَقضى قُضاة الوَرى مِن عَمَّ نائِلُهُ","حَيّاً وَمَيتاً قَضى بِالعَهد مِن نوح",28,"ح",1,0],["أَقضي ظُلماً وَبِثَغرِهِ وَبِوَجهِهِ","ماءن ماء حَياً وَماء حَيّات",29,"ت",1,0],["أقضى فؤاد أجل وقد أَودت به","ريب الردى ففؤاد ليس براجع",30,"ع",1,0],["أقضى فؤاد نعم قضى وترنحت","أعطافه موتاً أقض مضاجعي",30,"ع",2,0],["أقضي الليالي وأنّاتي تسامرني","فلا عزاء ولا أهلٌ واخوان",31,"ن",1,0],["اِقْضِ في أمري بما أنتَ قاضٍ","فبأنعامك أرجو الخَلاصا",32,"ص",2,0],["أُقَضِّي نَهارِي بِالزَفيرِ وَأَنَّةٍ","وَأَقطَعُ لَيلي بِالدُموعِ السَواجِمِ",33,"م",1,0],["أقضى عليّ من الأجل","عذل العذول إذا عذل",34,"ل",1,1],["أقضيب بان أم قوام أملد","وكحيل طرف أم غزال أغيد",35,"د",1,1],["أُقَضّي نَهاري في اِنقِباضٍ وَريبَةٍ","وَيُشتَدُّ بي وَجدي إِذا أَقبَلَ الغَسَق",36,"ق",1,0],["أُقَضّي لَيالِيَّ في مخدعٍ","بَكى والدي حَظَّه فيهِ قَبلي",37,"ي",1,0],["أَقضى نهاري مُقبلاً مُدبراً","كأنَّني الآلةُ في المَعمل",38,"ل",1,0],["أَقضي الزَمانَ ولا أَقضي به وَطَراً","وأَقطعُ الدَهرِ أَشواقاً وأَشجانا",39,"ن",2,0],["أُقضّي زَماني بينَ صدٍّ وهجرانِ","عَلى حسمِ آمالي وصَبري ظهيرانِ",40,"ن",1,1],["أُقَضّى عَلَيها حاجَتي وَأَرُدُّها","مَنيناً كَما رَدَّ المَنِيحَ المُخاطِرُ",41,"ر",1,0],["أقضي طويل الليل وسنان ساهداً","تحاول اغماض الجفون عيون",42,"ن",1,0],["أقضَى قُضاةٍ في الممالكِ كُلِّها","مِمَّن غَدا يَبْغي العلا أو راحا",43,"ح",2,0],["أُقضّي زماني بالأماني تَعلّةً","فما سَمَري إلا عَسَانيَ أو عَلّي",44,"ل",2,0],["اِقضِ بحكم المجد لي عليهمُ","واظهِرْ لها سرَّ الندى المكنونا",45,"ن",2,0],["أقضِّي ما أغالطُ من زماني","بلَوعاتٍ تكاد عليَّ تَقضي",46,"ض",2,0],["اِقضِ لِلعَيشِ حاجَةَ الأَفراحِ","وَصِلِ الإِغتِباقَ بِالإِصطِباحِ",47,"ح",1,1],["أقضي الليالي إدلاجا لأكشفه","بين الغياهب في جيش من الحجب",48,"ب",1,0],["أقضي العمر تشبيهاً","على الناس وتمويها",49,"ي",3,1],["أقضيها وتحسب من حياتي","وقد أنفقتهن بلا حساب",50,"ب",1,0],["أَقضي كَمَثلِ بَعضِ ما قَد قَضَّتِ","أَو عِظَةٌ إِن نَفسُ حُرٍّ بَلَّتِ",51,"ت",1,0],["أقضي البقية من حياتي عابداً","رباً عظيما حقه إن يعبدا",52,"د",2,0],["أَقضي اللَيالي لا أَحظى بِطَيفٍ كَرى","مُوَزَّعاً بَينَ حَيرانٍ وَحَرّانِ",53,"ن",1,0],["أُقَضّي اللّضيالي بالأمانيَ ضَلَّة","لَعَلَّكِ أن تَرثَي لَنا وَعَساكِ",54,"ك",1,0],["أقَضتَ غِرارَ نومِكَ بالسُّهادِ","فما أكتَحَلت جَفُونُك بالرُّقادِ",55,"د",1,1],["أُقضّي نَهاري بِالحَديثِ وَبِالمُنى","وَفي اللَيلِ ما لي مؤنِسٌ يَتَوَجَّعُ",56,"ع",1,0],["أَقضي نَهاريَ في هَمٍّ وَفي حزَنٍ","وَطولَ ليليَ في فِكرٍ وَفي سَهَرِ",57,"ر",1,0],["أقضى على الأحياء منه بما قضا","هُ مطيعٌ أو عاصٍ سعيدٌ أو شقي",58,"ق",2,0],["أقضي نهاري لاهياً بحديثكم","ويجمعني والهم في الليل مضجعي",59,"ع",2,0],["أُقَضِّي زَمَاني حَسْرَةً وَكَآبَةً","وَأَكْتُمُ وَجْدِي وَالْغَرامَ مَهَابَةً",60,"ه",1,0],["أقضّي نهاري بالكآبة والأسى","وأقطع ليلي كالسّليمِ المسهَّد",61,"د",1,0],["أقضي بها حق نعماء مننت بها","يزينها فيك إطراء وتمجيد",62,"د",1,0],["أقضَّي زماني زفرة بعد زفرة","فقلبي لا يخلو من الزفرات",63,"ت",1,0],["أقَضِّي نهاري في ظلام من الجوى","يكاد له يرتد ليلا فيظلم",64,"م",1,0],["اقضي الدجى سهرا وتسعدني على","ما بي حمامات اللوى تغريدا",65,"د",2,0],["أَقْضي حُقُوقَ دُماها بالبكاءِ دماً","ولو قَضيْتُ لَمَا أَدَّيْتُ ما وجبا",66,"ب",2,0],["أقضي بما في كتاب اللَه مجتهداً","وبالنظائر أقضي والمقاييس",67,"س",1,1],["أقْضَمْتُهُ حَبَّ الفؤاد لحبِّه","وجعلتُ مربطَهُ سوادَ المدمعِ",68,"ع",1,0],["أقضى من النصالِ","أضوا من الهلالِ",69,"ل",1,0],["اقض حق الصبوح قبل الصباح","واكس راحاتنا بكاسات راح",70,"ح",1,1],["أقضي زماني فيك متصل الأسى","ومنقطعا عما به أتوصل",71,"ل",1,0],["أُقضِّى حياتى فى هواهُ تكلُّفاً","وأىُّ حياةٍ تنقضى بالتَّكَلُّفِ",72,"ف",1,0],["أُقَضّي عُمُرَ الدُنيا","عَلى النَقضَةِ وَالنَقضِ",73,"ض",1,0],["اقضي وما من دافعٍ لقضائه","هذي يدي لقضي لبانة مهجتي",74,"ي",1,0],["أقضى قضاة المسلمين كلمبوي","زاده الأمين معين كل موادع",75,"ع",1,0],["أقضي الدجى وأنا أحنُّ إلى غد","وكذا يجي غد وعمري يصرم",76,"م",1,0],["اقضِ مُشْتطاً على كلِّ هوىً","واجرِ مُسْتَولٍ على كلِّ أمد",77,"د",1,0],["أُقضّى الوقتَ أجمعَه ادكاراً","لمن عنهم ترحَّلتُ اضطرار",78,"ر",1,1],["أقضى الليالي ساهراً","أبكي على زاهي ربيعي",79,"ع",2,0],["اقضي ليالي البين وحدي ساهراً","ويروعني فيه نعيق غرابه",80,"ب",2,0],["أقضى قُضاةِ عسكرِ الإسلامِ","وصاحب الإحكامِ في الأَحْكَامِ",81,"م",1,0],["أَقضى الأَنام عَليٌّ في محاكمة","وَأبصرُ الناس لَكن المضلَّ عَما",82,"م",2,0],["أقضّي زماني باللّتيَّا وبالّتي","ومن دون إدراك المنى حادثٌ يقضي",83,"ض",2,1],["اقضى زماني بالتشوّق والأسى","وأكاد أقضى في هواك تلهفا",84,"ف",2,0],["أقضى بياض نهاري في الدروسِ وسل","يا أيها الشمسُ نجم الليل عن سهري",85,"ر",2,0],["أقضي لوجه الله واجب خدمة","لمواطني والله كاس طاعمُ",86,"م",1,0],["أقضى العمر أم تحجب عنا","مثلما يحجب الغمام الشموسا",87,"س",2,0],["اقض فيها حق الغرام فإني","مغرم لم يزل يعاني غرامه",88,"م",2,0],["اقضي وما ينقضي عشقي ولا المي","افني وما فنيت منكم تفانيني",89,"ن",2,0],["أقضي عليهم لأفني","في الكون لؤم الطغام",90,"م",1,0],["أُقضّي حياتي كل يوم مجرّباً","دياراً وأصحاباً فأنأى واهربُ",91,"ب",1,1],["أقضي وعيني للحبيب وهكذا","يقضي القتيلُ وعينه للقاتل",92,"ل",1,1],["أقضّي نهاري بين رقص إلى غنا","كأن الغنا والرقص لي أصبحا شغلا",93,"ل",2,0],["أقضي الليالي وحيدا","مسامرا ارزائي",94,"ي",1,0],["أقضي حيات