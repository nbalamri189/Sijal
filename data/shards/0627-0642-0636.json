{"poems":[[53,"غالى بها الزائد حتى ابتاعها","https://www.aldiwan.net/poem30152.html","الرجز"],[53,"قربوهن ليبعدن المغارا","https://www.aldiwan.net/poem30447.html","الرمل"],[34,"فيا قلب صبرا واعترافا لما ترى","https://www.aldiwan.net/poem4903.html","الطويل"],[86,"أقضيه في الأشواق إلا أقله","https://www.aldiwan.net/poem10946.html","الطويل"],[86,"حيا بكور الحيا أرباع لبنان","https://www.aldiwan.net/poem68892.html","البسيط"],[73,"تنشق من عرف الصبا ما تنشقا","https://www.aldiwan.net/poem11855.html","الطويل"],[4,"عفت الديار محلها فمقامها","https://www.aldiwan.net/poem21196.html","الكامل"],[51,"اقضِ لي حاجتي ولا تمطلني","https://www.aldiwan.net/poem66026.html","الخفيف"],[91,"يا رب ليل بلا سناء","https://www.aldiwan.net/poem62711.html","عموديه"],[91,"ألا ليت قلبا بين جنبي داميا","https://www.aldiwan.net/poem62817.html","عموديه"],[89,"اغتنم كل فرصة في الحياة","https://www.aldiwan.net/poem44633.html","الخفيف"],[85,"سيوف أبيه من خمسين عاما","https://www.aldiwan.net/poem7046.html","الوافر"],[31,"حي ربعا أقوى ورسما محيلا","https://www.aldiwan.net/poem41837.html","الخفيف"],[74,"اقض على خلك أو ساعد","https://www.aldiwan.net/poem12902.html","السريع"],[33,"نهاري نهار الناس حتى إذا بدا","https://www.aldiwan.net/poem25887.html","الطويل"],[81,"إذا كنت تجفوني وأنت ذخيرتي","https://www.aldiwan.net/poem61341.html","الطويل"],[102,"ما لك والذكريات تذعرها","https://www.aldiwan.net/poem32915.html","المنسرح"],[46,"دنياك ماوية لها نوب","https://www.aldiwan.net/poem22009.html","المنسرح"],[46,"أقضي الدهر من فطر وصوم","https://www.aldiwan.net/poem23403.html","الوافر"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147477",""],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20994","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54750","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54247","البسيط"],[106,"حي البيان","https://www.poetsgate.com/ViewPoem.aspx?id=179367",""],[90,"سبحان من خلق الرجال","https://www.poetsgate.com/ViewPoem.aspx?id=179013",""],[91,"دموع وتنهّدات","https://www.poetsgate.com/ViewPoem.aspx?id=53396",""],[86,"أقضيه فى الأشواق إلا أقله","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69208&r=&rc=66",""],[109,"صبر الفؤاد على فعال الجافي","https://www.aldiwan.net/poem16208.html","الكامل"],[109,"إن الحكيمين قد فازا بمدحهما","https://www.aldiwan.net/poem16323.html","البسيط"],[109,"ومعبس للكاس راح وأنه","https://www.aldiwan.net/poem16581.html","الكامل"],[124,"وادته بعد تجاذب وتدافع","https://www.aldiwan.net/poem23745.html","الكامل"],[126,"عزّ التأسّي وفاض الدمع هتانا","https://www.aldiwan.net/poem792.html",""],[142,"من رأى المجد يثير القلاصا","https://www.aldiwan.net/poem58437.html","الخفيف"],[169,"إلام أناجي قلب حيران واجم","https://www.aldiwan.net/poem1668.html",""],[186,"أقضى علي من الأجل","https://www.aldiwan.net/poem43358.html","مجزوء الكامل"],[210,"أقضيب بان أم قوام أملد","https://www.aldiwan.net/poem13456.html","الطويل"],[223,"أيا قبلة مرت على ضفتي في","https://www.aldiwan.net/poem41448.html","الطويل"],[223,"بلوت الحياة فما من أنيس","https://www.aldiwan.net/poem41897.html","المتقارب"],[241,"زاحفت أيامي وزاحفنني","https://www.aldiwan.net/poem45756.html","السريع"],[297,"بانوا فليت غرامي بعدهم بانا","https://www.aldiwan.net/poem33149.html","البسيط"],[305,"أقضي زماني بين صد وهجران","https://www.aldiwan.net/poem56381.html","الطويل"],[322,"ألا هاج قلبي العام ظعن بواكر","https://www.aldiwan.net/poem56358.html","الطويل"],[342,"عجيب أيحدوني إليك حنين","https://www.aldiwan.net/poem55364.html","الطويل"],[364,"شاق الحمام إليك لما ناحا","https://www.aldiwan.net/poem60965.html","الكامل"],[402,"وغيداء لا تنفك تمل عيونها","https://www.aldiwan.net/poem46421.html","الطويل"],[458,"جرت لها ببابلٍ يمينا","https://www.aldiwan.net/poem55838.html","الرجز"],[458,"سقى زمنا ببابل عقربي","https://www.aldiwan.net/poem56146.html","الوافر"],[468,"اقض للعيش حاجة الأفراح","https://www.aldiwan.net/poem60301.html","الخفيف"],[479,"بالشاعرين نحيي ندوة الأدب","https://www.aldiwan.net/poem37191.html","البسيط"],[495,"أقضي العمر تشبيها","https://www.aldiwan.net/poem10287.html","الهزج"],[515,"أعندك أن وجدي واكتئابي","https://www.aldiwan.net/poem12008.html","الوافر"],[561,"الحمد لله الذي استقلت","https://www.aldiwan.net/poem27845.html","الرجز"]],"verses":[["أَقضى عَليها أَرَباً مِن هِمَّةٍ","لَو عَدَلَ الدَهرُ ثَنى زِماعَها",0,"ع",3,0],["أَقضَموها بَدَلَ الرُطبِ الجَنى","وَسَقوها بَدَلَ الماءِ العُقارا",1,"ر",2,0],["أُقَضّي نَهاري بِالحَديثِ وَبِالمُنى","وَيَجمَعُني بِاللَيلِ وَالهَمَّ جامِعُ",2,"ع",1,0],["أُقَضّيهِ في الأَشواقِ إِلّا أَقَلَّهُ","بَطيءَ سُرىً إِلى اللُبثِ مَيلَهُ",3,"ل",2,1],["أَقضي المَصيفَ بِلُبنانٍ عَلى شَرَفٍ","وَلا أَحولُ عَنِ المَشتى بِحُلوانِ",4,"ن",1,0],["أَقضي نَهاري بِالأَماني الكَواذِبِ","وَآوي إِلى لَيلٍ بَطيءِ الكَواكِبِ",5,"ب",1,0],["أَقضي اللُبانَةَ لا أُفَرِّطُ ريبَةً","أَو أَن يَلومَ بِحاجَةٍ لُوّامُها",6,"م",3,0],["اقضِ لي حاجتي ولا تمطلنّي","فأرى الغُنم من نداكا غراما",7,"م",2,1],["أَقَضَّ هَذا الفِراشُ جَنبي","كَأَنَّ في مَضجَعي الإِبَر",8,"ر",1,0],["أُقَضّي نَهارِيَ طائِرَ النَفسِ حائِراً","وَأَقطَعُ لَيلي كاسِفَ البالِ مَناهِيا",9,"ي",2,0],["اقض ايامك القليلة في الضحك","ولا تؤذ العين بالعبرات",10,"ت",1,0],["أقضِّى الليل حول السجن شوقا","للحيته أناجيها أطِلى",11,"ل",2,0],["أَقضِ مِن لَذَّتي وَأَعهَدُ إِنّي","لا أَرى ذا الصُدودَ مِنكَ جَميلا",12,"ل",2,0],["اِقضِ عَلى خِلِّكَ أَو ساعِدِ","عِشتَ بِجِدٍّ في العُلى صاعِدِ",13,"د",1,1],["أُقَضّي نَهاري بِالحَديثِ وَبِالمُنى","وَيَجمَعُني وَالهَمَّ بِاللَيلِ جامِعُ",14,"ع",1,0],["أقضّي نهارِي بالحديثِ وَبِالمُنَى","وَيجمَعُني وَاللَّيلَ للهَمّ جَامِعُ",15,"ع",1,0],["أَقضي رقادي في غَير مضجعها","أَخشى إِذا اِستيقَظت أَسهّرها",16,"ر",3,0],["أَقَضِيَةٌ لا تَزالُ وارِدَةٌ","تَحارُ في كَونِها الأَلِبّاءُ",17,"ب",3,0],["أُقَضّي الدَهَر مِن فِطرٍ وَصَومِ","وَآخُذُ بُلغَةً يَوماً بِيَومِ",18,"م",1,1],["أقضية الله دعت","فأسمعت إذ هتفت",19,"ت",1,0],["أَقضي بِها أَرَبي وتُبلِغُني","قابُوسَ أَهلَ الُملكِ والَحَسبِ",20,"ب",1,0],["أَقَضَى اليَوْمَ حَتْفَ أَنْفٍ وَأَقْصَى","مَا رَجَا أَنْ يَمُوتَ مَوْتَ شَهِيدِ",21,"د",1,0],["أقَضَّ موتُك من مصرٍ مضاجعَها","وأسكت الخطبُ أطياراً وأدواحا",22,"ح",2,0],["أقضي الحياةَ هناكَ يوَمًا واحدًا","مُتكرِّرًا، في منظرٍ متشابه",23,"ب",2,0],["أقضى مرامِك أن تَفيضَ فتشتكى","ظمأ ربوعُك او تفيض فتغرقا",24,"ق",2,0],["أقضي نهاري طائر النفس حائرا","وأقطع ليلي كاسف البال ساهيا",25,"ي",2,0],["أقضيه فى الأشواق إلا أقله","بطئ سرى أبدى إلى اللبث ميله",26,"ل",2,1],["أَقضى قُضاة المُسلِمين وَقامع ال","قَوم البُغاة بِصارم الإِنصافِ",27,"ف",1,0],["أَقضى قُضاة الوَرى مِن عَمَّ نائِلُهُ","حَيّاً وَمَيتاً قَضى بِالعَهد مِن نوح",28,"ح",1,0],["أَقضي ظُلماً وَبِثَغرِهِ وَبِوَجهِهِ","ماءن ماء حَياً وَماء حَيّات",29,"ت",1,0],["أقضى فؤاد أجل وقد أَودت به","ريب الردى ففؤاد ليس براجع",30,"ع",1,0],["أقضى فؤاد نعم قضى وترنحت","أعطافه موتاً أقض مضاجعي",30,"ي",1,0],["أقضي الليالي وأنّاتي تسامرني","فلا عزاء ولا أهلٌ واخوان",31,"ن",1,0],["اِقْضِ في أمري بما أنتَ قاضٍ","فبأنعامك أرجو الخَلاصا",32,"ص",2,0],["أُقَضِّي نَهارِي بِالزَفيرِ وَأَنَّةٍ","وَأَقطَعُ لَيلي بِالدُموعِ السَواجِمِ",33,"م",1,0],["أقضى عليّ من الأجل","عذل العذول إذا عذل",34,"ل",1,1],["أقضيب بان أم قوام أملد","وكحيل طرف أم غزال أغيد",35,"د",1,1],["أُقَضّي نَهاري في اِنقِباضٍ وَريبَةٍ","وَيُشتَدُّ بي وَجدي إِذا أَقبَلَ الغَسَق",36,"ق",1,0],["أُقَضّي لَيالِيَّ في مخدعٍ","بَكى والدي حَظَّه فيهِ قَبلي",37,"ي",1,0],["أَقضى نهاري مُقبلاً مُدبراً","كأنَّني الآلةُ في المَعمل",38,"ل",1,0],["أَقضي الزَمانَ ولا أَقضي به وَطَراً","وأَقطعُ الدَهرِ أَشواقاً وأَشجانا",39,"ن",2,0],["أُقضّي زَماني بينَ صدٍّ وهجرانِ","عَلى حسمِ آمالي وصَبري ظهيرانِ",40,"ن",1,1],["أُقَضّى عَلَيها حاجَتي وَأَرُدُّها","مَنيناً كَما رَدَّ المَنِيحَ المُخاطِرُ",41,"ر",1,0],["أقضي طويل الليل وسنان ساهداً","تحاول اغماض الجفون عيون",42,"ن",1,0],["أقضَى قُضاةٍ في الممالكِ كُلِّها","مِمَّن غَدا يَبْغي العلا أو راحا",43,"ح",2,0],["أُقضّي زماني بالأماني تَعلّةً","فما سَمَري إلا عَسَانيَ أو عَلّي",44,"ي",1,0],["اِقضِ بحكم المجد لي عليهمُ","واظهِرْ لها سرَّ الندى المكنونا",45,"ن",2,0],["أقضِّي ما أغالطُ من زماني","بلَوعاتٍ تكاد عليَّ تَقضي",46,"ي",1,0],["اِقضِ لِلعَيشِ حاجَةَ الأَفراحِ","وَصِلِ الإِغتِباقَ بِالإِصطِباحِ",47,"ح",1,1],["أقضي الليالي إدلاجا لأكشفه","بين الغياهب في جيش من الحجب",48,"ب",1,0],["أقضي العمر تشبيهاً","على الناس وتمويها",49,"ي",3,1],["أقضيها وتحسب من حياتي","وقد أنفقتهن بلا حساب",50,"ب",1,0],["أَقضي كَمَثلِ بَعضِ ما قَد قَضَّتِ","أَو عِظَةٌ إِن نَفسُ حُرٍّ بَلَّتِ",51,"ت",1,0]]}