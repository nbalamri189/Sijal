{"poems":[[79,"أشارت غداة البين من خلل السجف","https://www.aldiwan.net/poem35976.html","الطويل"],[53,"هل أنت من مرتجيك مستمع","https://www.aldiwan.net/poem65399.html","المنسرح"],[40,"هممت الغداة همة أن تراجعا","https://www.aldiwan.net/poem7729.html","الطويل"],[87,"أعدت الراحة الكبرى لمن تعبا","https://www.aldiwan.net/poem63781.html","البسيط"],[47,"ألما يكف في طللي زرود","https://www.aldiwan.net/poem63486.html","الوافر"],[68,"عزمت يا متلفي على السفر","https://www.aldiwan.net/poem39640.html","المنسرح"],[82,"قم هاتها من كف ذات الوشاح","https://www.aldiwan.net/poem31520.html","السريع"],[76,"وصهوة عزم قد تمطيت والدجى","https://www.aldiwan.net/poem12922.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85552","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42677","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54530","الخفيف"],[79,"أشارت غداة البين من خلل السجف","https://www.poetsgate.com/ViewPoem.aspx?id=34201",""],[98,"راكبة الدراجة","https://www.poetsgate.com/ViewPoem.aspx?id=15719",""],[123,"من لم يؤدبه تأديب الكتاب فما","https://www.aldiwan.net/poem4362.html","البسيط"],[124,"لذيذ إذا در قطر الرهام","https://www.aldiwan.net/poem49359.html","المتقارب"],[147,"شفاء الهدى يا سيفه العضب أن تشفا","https://www.aldiwan.net/poem11779.html","الطويل"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[458,"تمهل أمام الماء حين ابتسامه","https://www.aldiwan.net/poem61235.html","الطويل"],[458,"تمهل يا قطار علام تجري","https://www.aldiwan.net/poem61365.html","الوافر"],[463,"إذا عارض نحو أرض عدل","https://www.aldiwan.net/poem56076.html","المتقارب"],[463,"أبلاغور تشتاق تلك النجودا","https://www.aldiwan.net/poem56240.html","المتقارب"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86896","الطويل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95505","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108952","الوافر"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130857",""],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139984","الطويل"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99402","الوافر"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89153","الطويل"],[3469,"","https://poetry.dctabudhabi.ae/diwan/poem/13","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62926","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45779","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216734","الوافر"],[4391,"","https://poetry.dctabudhabi.ae/diwan/poem/114045","الرمل"],[4691,"إذا مر شعري عليك تذكر","https://www.poetsgate.com/ViewPoem.aspx?id=61413",""],[4987,"العيون السود","https://www.poetsgate.com/ViewPoem.aspx?id=49580",""],[4119,"لكم من فؤادي ما اباحكم الوجد","https://www.poetsgate.com/ViewPoem.aspx?id=16112",""],[5038,"تعال نغنّي","https://www.poetsgate.com/ViewPoem.aspx?id=188834",""],[5135,"خَيلُ البشائر","https://www.poetsgate.com/ViewPoem.aspx?id=201871",""],[5135,"وجاء المساء","https://www.poetsgate.com/ViewPoem.aspx?id=201955",""],[5198,"عالم النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=136106",""],[5277,"مدى الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=185566",""],[5277,"حشرجة","https://www.poetsgate.com/ViewPoem.aspx?id=190908",""],[5277,"فاطمة","https://www.poetsgate.com/ViewPoem.aspx?id=195091",""],[5277,"وجعٌ على قارعةِ الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=201006",""],[5277,"صريخُ الشوقِ","https://www.poetsgate.com/ViewPoem.aspx?id=206801",""],[5430,"تمهل","https://www.poetsgate.com/ViewPoem.aspx?id=1461",""],[5628,"الشاعر والعاذلة","https://www.poetsgate.com/ViewPoem.aspx?id=178469",""],[5660,"أُغالِبُ شَوقَ القَلبِ بَل كُنتُ أُغلَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=33986",""],[5720,"سَكْرَة الجَوَىٰ","https://www.poetsgate.com/ViewPoem.aspx?id=198975",""],[5843,"أهم إحساسي","https://www.poetsgate.com/ViewPoem.aspx?id=51299",""],[5943,"بهيُّ الشِّعرِ","https://www.poetsgate.com/ViewPoem.aspx?id=34291",""],[6008,"رثاء بالشيوخ (مهل القعقاع -مساعد البنيه )","https://www.poetsgate.com/ViewPoem.aspx?id=60996",""],[6046,"الظمأ الرهيب","https://www.poetsgate.com/ViewPoem.aspx?id=35226",""],[6096,"سؤال .. وعتاب","https://www.poetsgate.com/ViewPoem.aspx?id=177884",""],[6115,"تمهلو ياللى عن الحق غادين","https://www.poetsgate.com/ViewPoem.aspx?id=196455",""],[6152,"هوى بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=202701",""],[6152,"تعبان خالي ( طفل العراق)","https://www.poetsgate.com/ViewPoem.aspx?id=203289",""],[5957,"فحبكَ عندي فراتٌ ونيلٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82451&r=&rc=90",""],[6218,"زمن أم عمرو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65904&r=&rc=57",""],[6225,"القطار المُحترق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80899&r=&rc=168",""],[6225,"تقمُّص","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78046&r=&rc=131",""],[6262,"السقوط","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80111&r=&rc=9",""],[5126,"تأمل! فلا سرّ لديك ولا جهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87800&r=&rc=15",""]],"verses":[["تمهّدَتِ الدُنْيا بمُلْكِكَ بعْدَما","أقامَتْ زَماناً لا تَقَرُّ منَ الرّجْفِ",0,"ف",1,0],["تمهَدُ لي مطلبي وآونةً","تمهد لي مضجعي فأضطجع",1,"ع",1,0],["تَمَهَّدنَ ديباجاً وَعالَينَ عَقمَةً","وَأَنزَلنَ رَقماً قَد أَجَنَّ الأَكارِعا",2,"ع",2,0],["تَمَهَّدَت عَقَباتٌ غَيرُ هَيِّنَةٍ","تَلقى رُكابُ السُرى مِن مِثلِها نَصَبا",3,"ب",2,0],["تَمَهَّلَ بَعدَ إِقصارِ المُسامي","وَتَسليمِ المُنافِسِ وَالحَسودِ",4,"د",1,0],["تَمَهَّل مُضنى جَفاك","تَحَمَّل ذُبتُ في هَواك",5,"ك",1,0],["تمهرُ أرواحَ العدى بيْضُهُ","إذا أرادتْ من حروبٍ نكاح",6,"ح",1,0],["تَمَهَّدَ مِنهُ كُلُّ رُكنٍ رَكانَةً","فَقَطَّبَ إِطراقاً وَقَد ضَحِكَ البَدرُ",7,"ر",1,0],["تمهل قَليلاً لا تغظ أمة إذا","تأجج فيها الغيظ لا تتمهل",8,"ل",1,0],["تَمَهَّلْ وَلا تَعْجَلْ إِذَا رُمْتَ حَاجَةً","فَقَدْ يَلْحَقُ الْخُسْرَانُ مَنْ يَتَوَرَّطُ",9,"ط",1,1],["تَمُّهُ تَمُّهَا وَغِرُّ لَيَاليهِ س","نُوهَا تَتَابَعَتْ غَرَّاءَ",10,"ا",2,0],["تمهدت الدنيا بملكك بعدما","أقامت زمانا لا تفر من الرجف",11,"ف",1,0],["تمهّلي فراشة الصّباح","أسرفت في الغدوّ والرّواح",12,"ح",1,1],["تَمَهَّدَ الأَمرُ في أكنافِ دولتِهِ","حتّى تآلف فيها السَّخلُ والذيبُ",13,"ب",1,0],["تمهل ألفاظه علها","تبرد في فيه حر الأوام",14,"م",1,0],["تَمَهَّلتَ عِلماً أَنَّها لَكَ دونَهُم","وَمُلتَمِسُ المَمنوعِ يَأخُذُهُ خَطفا",15,"ف",2,0],["تمهَّلوا لا تَقعوا","وَأَنصِتوا لي واِسمَعوا",16,"ع",3,0],["تمهّل أمام الماء حين ابتسامه","على الكرز البسام غير مرائي",17,"ي",1,1],["تمهل يا قطار علام تجري","وأنت مخلف ينبوع شعري",18,"ر",2,1],["تمهَّلْ فغير بعيدٍ تراه","وكم عجِلَ الحظُّ بعد المهَلْ",19,"ل",1,0],["تمهَّدَ من فارسٍ ذِروةً","تُحَطُّ المجرّة عنها صعودا",20,"د",2,0],["تَمهل يراجع دَهرنا فيك عَقله","فَما سُدتَ إِلا وَالزَمان بِهِ سُكر",21,"ر",1,0],["تمهَّل لعلىِّ أنتحى فيك سلوة","وإن لم أكُن في حبها الدّهر بالسالى",22,"ل",2,0],["تمهَّر باللغات فقلت أرِّخ","كبير الملك خوَّله المهاره",23,"ر",2,0],["تمهَّل فما الدُّنيا سوى آلةٍ تجري","لوالبها فيها المنية لو تدري",24,"ر",2,1],["تمهّد بالوحي المنزّل أمرُه","وبالسيف إن آذن عن الوحي صمَّت",25,"ت",1,0],["تمهر في الوقائع وهو مهر","ولا سرج عليه ولا لجام",26,"م",1,0],["تمهل يراجع دهرنا فيك عقله","فإن صلحت أعضاؤه صلح الفكر",27,"ر",1,0],["تَمَهَّلَ عانَةً قَد ذَبَّ عَنها","يَكونَ مَصامُهُ مَنها قَصِيّا",28,"ي",2,0],["تمهَّلَ قُدَّام السِّماكِ ولم يكنْ","تكِنَّةَ نجمٍ أردفته الفَوارسُ",29,"س",1,0],["تَمَهل إِذا ما جئت ناديه سائِلاً","كَما شئت وَاِحذَر سَيله إِن تَحَدّرا",30,"ر",2,0],["تمهل يا نسيم ولا تكدّر","نعاس النهر بالهمس الضعيف",31,"ف",1,1],["تم هنيئاً واثقاً منتصرا","وستدري من غدا ينتصر",32,"ر",1,0],["تمهل حبيبي أبعد احترافي","هواك وعشقكَ تنسى وتدبر ْ",33,"ر",1,0],["تمهل واعرف اللي راح لا يمكن عليك يعود","خذاه الوقت لاتستنقض المبطي مع التالي",34,"ل",2,0],["تمهل منه في مساعي خزيمة","عريق العلى ينميه من أسد أسد",35,"د",1,0],["تمَهّلْ فنارُ جمالِكَ وهْجُ","سرابٍ فمَنْ نالَ منْهُ وناشا؟",36,"ش",2,0],["تمهَّلْ يا أخي واعْدلْ قليْلاً","لعلَّكَ أنْ ترى شيئاً أراه",37,"ا",2,0],["تمهل أيا قلب ، لا ترتجفْ","يجيب: هو العقل ما أجهلهْ !",38,"ل",2,0],["تمهّل قبل ترحل اليا عالم النسيان","وتنسى الذي لاهو بناسي ولاداله",39,"ل",2,1],["تمهل ترا لك في فسوح الحشى بستان","ليا اسرف سموم الوقت قيّلت ف ظلاله",39,"ل",2,0],["تمهّلْ واستقِ الدنيا نصيباً","بكفِّ الصبر أو صاعِ الغيارى",40,"ر",2,0],["تمهّلي لا تكوني محضَ غاديةٍ","تؤرشفُ الوجدَ بين القلبِ والخلجِ",41,"ج",1,0],["تمهّلي..وارفقي يا خيرَ من ذرفتْ","يومَ الرحيلِ..عليها الدمعَ قافيتي",42,"ت",2,0],["تمهَّلْ ها هنا أطلالُ حبٍّ","على جرفٍ من الوادي السحيقِ",43,"ق",1,0],["تمهّلْ إن وصلتَ إلى دياري","فبي من لهفتي حطبٌ ونارُ",44,"ر",1,0],["تمهل أيها الرجل الأريبُ","فحال الناس في الدنيا عجيبُ",45,"ب",1,1],["تمهّلي إنّها الأيّامُ غادرة ٌ","لا تعجبي إنْ رأيت الرأْسَ مُنتكِسا",46,"س",2,0],["تَمَهَّل فَأَشواقُ العَذارى قَتَلنَهُم","فَلا تَسلُلِ الأَشواقَ فَالشَّوقُ أَغلَبُ",47,"ب",1,0],["تَمَهَّلْ .. فليسَ الحبُ نزوةَ صُرعةٍ","تَهِبُّ فتقضي إنْ تمادتْ علىٰ الهوىٰ",48,"و",2,1],["تمهل لين قر الحبهان بقاعة الفنجال","وجثى جمر الفؤاد ال دلةٍ بالكيف موزونه",49,"ن",2,0],["تمهل لاتحاصرْنا","بحرفِ الرَّندِ والعنبر",50,"ر",1,0],["تمهل ولكن دائما ً مابها أهمال","ربك يدير ايامها مع سنتها",51,"ت",3,0],["تمهَّلْ أيُّها الظَّمأُ الرَّهيبُ","ورُدَّ إليَّ نفْساً لا تطيبُ",52,"ب",1,0],["تمهَّلْ... قد فككْتَ قيودَ جُرْحي","فجُنَّ ولا أراهُ يستجيبُ",52,"ب",1,0],["تمهل كي ترى شرفا رفيعا","تعالى شامخا حتى السحابا",53,"ب",2,0],["تمهل علنا نمضي سويا","لندفع عن ربى القدس العذابا",53,"ب",2,0],["تمهلوا ياللى عن الحقّ غادين","الحق واضح كنّه الجدي وسهيل",54,"ل",1,1],["تمهل حبيبي لستَ وحدك متعبا","ففي كل أرض دمعة وغريب",55,"ب",1,0],["تمهل حبيبي لست وحدك متعب","ففي كل أرض دمعة وغريب",56,"ب",1,0],["تمهد بين الرؤى وانتشى","فمنه ارتوائي وفيه المنالْ",57,"ل",1,0],["تمهّلْ.. كلُّ ذي روحٍ أسيرُ","وهذا الكون معتقلٌ صغيرُ",58,"ر",1,1],["تمهّلْ قليلا قطارَ الصعيد","فللعيدِ فيكَ معانٍ أدقْ",59,"ق",1,0],["تمهلْ قليلا .فأرواحُنا","بقلبكَ تحفرُ للضوءِ شِقْ",59,"ق",1,0],["تمهلْ قليلا فأحزاننا","بكابوسِكَ اليومَ خوفٌ صدَقْ",59,"ق",1,0],["تمهَّلْ , ما اغترابُكَ غيرُ ظِلٍّ","يُشكِّلُهُ الضياءُ بُكاءَ قلبِ",60,"ب",1,0],["تمهَّلي في افْتِضاضِ الروحِِ إنَّ يدي","في يأسِها..بخيوطِ الروحِ تمتسكُ",61,"ك",1,0],["تمهَّلْ.. فلسنا بالعُجالى وغَنِّنا","فلا النثرُ -يستوْحي هوانا- ولا الشِّعرُ",62,"ر",1,0]]}