","https://www.poetsgate.com/ViewPoem.aspx?id=170567",""],[5273,"تسآل","https://www.poetsgate.com/ViewPoem.aspx?id=180966",""],[5277,"طيفٌ عابر","https://www.poetsgate.com/ViewPoem.aspx?id=187892",""],[5277,"لحاظ الروح","https://www.poetsgate.com/ViewPoem.aspx?id=197623",""],[5277,"آلاءُ الجمالِ","https://www.poetsgate.com/ViewPoem.aspx?id=198434",""],[5281,"ربَّةُ الشِّعر","https://www.poetsgate.com/ViewPoem.aspx?id=199301",""],[5285,"مريم","https://www.poetsgate.com/ViewPoem.aspx?id=203654",""],[5327,"الصُّبحُ الغَائب","https://www.poetsgate.com/ViewPoem.aspx?id=140331",""],[5431,"نشوى الوصال","https://www.poetsgate.com/ViewPoem.aspx?id=183087",""],[5442,"آن التأهب للرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=114779",""],[5533,"الشِّعْرُ زَهْرٌ قد نُثِرْ","https://www.poetsgate.com/ViewPoem.aspx?id=176721",""],[5542,"مشاهد من يوم القيامة","https://www.poetsgate.com/ViewPoem.aspx?id=10202",""],[5626,"ما بالُ قومي","https://www.poetsgate.com/ViewPoem.aspx?id=189561",""],[5758,"أنا وعنترة","https://www.poetsgate.com/ViewPoem.aspx?id=200529",""],[5815,"ألوان الطيف","https://www.poetsgate.com/ViewPoem.aspx?id=197798",""],[5848,"هي بإختصار","https://www.poetsgate.com/ViewPoem.aspx?id=53447",""],[5848,"قبل الزيارة","https://www.poetsgate.com/ViewPoem.aspx?id=48995",""],[5956,"حيويتان متبادَلتان ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182266",""],[5956,"وحيدة حتى الموت","https://www.poetsgate.com/ViewPoem.aspx?id=183438",""],[5956,"الفراشة البيضاء *","https://www.poetsgate.com/ViewPoem.aspx?id=183468",""],[5956,"بالجدِّ باركْ يا إلهُ وآلِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=192094",""],[5956,"اذهب لمصنعك الجميل","https://www.poetsgate.com/ViewPoem.aspx?id=193166",""],[5956,"يَدُ بنيَّ مربوطةٌ كعقولنا","https://www.poetsgate.com/ViewPoem.aspx?id=193399",""],[5956,"هي رمزُ عقلانية وتبصر","https://www.poetsgate.com/ViewPoem.aspx?id=193992",""],[5956,"يا ألفَ شكر للسمية بِنْتِنا","https://www.poetsgate.com/ViewPoem.aspx?id=206261",""],[6019,"وقوفاً على باب قصيدتي","https://www.poetsgate.com/ViewPoem.aspx?id=174231",""],[6090,"قل لسكرى فليحيي آنا ليرنو","https://www.poetsgate.com/ViewPoem.aspx?id=170906",""],[6102,"حطب الحقد","https://www.poetsgate.com/ViewPoem.aspx?id=183654",""],[6238,"غِيضَ الكَلامُ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86771&r=&rc=0",""],[5567,"ناسكة الأسرار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81812&r=&rc=62",""]],"verses":[["هِيَ راحَةٌ ما تَستَفيقُ مِنَ النَدى","أَبَدَ الزَمانِ وَبَدرَةٌ لا تُختَمُ",0,"م",1,0],["هيَ روضةٌ تَجْنيكَ بينَ لِثاتِها","خَمْراً ومنْ وَجَناتِها تُفّاحا",1,"ح",2,0],["هِيَ راحَةٌ لِلمُتعَبين وَجَنَّةٌ","لِلعاشِقين وَمَلعَبٌ لِذَوي الثَرا",2,"ر",2,0],["هِيَ رَتقاءُ يَعجَزُ اللَف","ظُ عَن قُبحِ نَعتِها",3,"ت",3,0],["هِيَ رَودُ الشَبابِ فاتِرَةُ الطَر","فِ تَدَرّى مِثلَ العَريشِ اِسلَحَبّا",4,"ب",2,0],["هي رقصةٌ وكأنها حُلُمُ","وإذا بفينوس تمدُّ يدا",5,"د",2,0],["هِيَ رَحْمَةٌ فِي البَيْتِ","لِلعَانِي وَبُرْءٌ لِلعَلِيلِ",6,"ل",1,0],["هَيَ رَمْزُ الطَّبْعِ الشَّديد وَإِنْ كَا","نَ عَلَى الوَادِعِينَ غَيْرَ شَديد",7,"د",1,0],["هِيَ ريحُ الحَبيبِ أَيَّتُها الثَك","لى فَإِن هاجَكِ النَسيمُ فَتوقي",8,"ي",1,0],["هي روضة تجنيك بين لثاثها","خمرا ومن وجناتها تفاحا",9,"ح",2,0],["هِيَ رَوضة الذكر الجَميل لِنورِها","بِنَسيم فَضلك في الوَرى تَقيحٌ",10,"ح",1,0],["هي روح وروح من صار مثلي","في هواها حزباً من الأمثال",11,"ل",1,0],["هي رحمة للعالمي","ن فكل خير في رباها",12,"ا",3,0],["هي روضٌ من الرياحين فاح ال","مسكُ منها كما يفرحُ شَذَاهَا",13,"ا",3,0],["هيَ رقصةٌ فنيةٌ رقصَت لها","كلُّ القلوبِ وما وَجَدت شواذا",14,"ذ",2,0],["هي ربةُ الدنيا كما شاءَ الندى","والبأسُ وهي قوامُها والمحور",15,"ر",1,0],["هي روضة مزجت بطينة طيبة","وَسمت فَنافَسَت الحطيم وَزَمزَما",16,"م",2,0],["هِيَ رُتبَةُ الباشا المُعَظَّمِ قَدرُها","وَأَراهُ بَعدُ لِما يَليها يَصطَفيكِ",17,"ك",1,0],["هي روحي التي أحبّتك حتى","قدّست فيك حزنها وأساها",18,"ه",2,0],["هي رأس الإسلام من يقطعه ماله حياه","من لم يصل فقط اخطا طريق النجاه",19,"ا",2,0],["هي ركن الإسلام ياذا لا تكن عنه ساه","وهي عموده كذا جاعن رواة ثقاه",19,"ا",2,0],["هي رأس الشرور","للجاهل الغافل القاس",20,"س",1,0],["هي ركن الإسلام كن","حافظا لها من فوات",21,"ت",1,0],["هي رأسه والعمود","بادر إليها وآت",21,"ت",1,0],["هي روض سقاه سحب المعاني","فأتانا بطيب الأثمار",22,"ر",1,0],["هي رُقعةٌ رُفعَتْ إليك وخاطري","متيقّنٌ أنّ النوالَ جوابُها",23,"ب",3,0],["هي راية مرفوعة","للمجد وهو يمينها",24,"ن",3,0],["هيَ رُوحُ الإلَه في خَلقِه مُن","تَحِراً ماتَ مَن بها لاَ يعيش",25,"ش",1,0],["هِيَ (رِدَّةٌ)أخرَى أفاقَ سرابُها","فإذا (مُسَيْلِمَةٌ) يَهِمُّ بِنهْلِهِ",26,"ل",2,0],["هي رامة هي لعلعٌ ولأجل ذا","ناديتها يا رامة يا لعلع",27,"ع",1,0],["هي ربة المجد المؤثل والسنا","والفخر والإجلال والعلياء",28,"ا",2,0],["هي روضة تحيي النفوس وكيف لا","تغدو الجنان حياة كل حنان",29,"ن",1,0],["هي ربة الطهر الحَصان فخير مَن","يرعى الولا حصنا تعزُّ وتكرم",30,"م",1,0],["هي رائية تسامت وعزت","فاستطالت على القوافى افتخارا",31,"ر",2,0],["هي روح الأرض أنفاس العبير","صعدت كسلى على جنح الصبا",32,"ب",2,0],["هي روح الخمر لا جسم لها","فكأن الكأ قد مثلها",33,"ه",2,0],["هي رمز قدر الوقت أحفظه بها","وأجوز أشواط الجهاد وأسبق",34,"ق",1,0],["هي روح الشّرق لا يحيا إذا","لم تكن فيه نساءٌ بارعة",35,"ع",2,0],["هي روح الوطن الغالي الذي","ينقذ العرب من الخطب الملم",36,"م",1,0],["هي روح تعاق بالأقذار","ما ترددت غير أني أعاني",37,"ي",1,0],["هي رامت دنوه ما انْتَثَتْ ع","زته أن تذيبها بسناها",38,"ا",3,0],["هي روح الهدى فمن لم تجده","كان روح الضلال ما ناواها",38,"ا",3,0],["هي روحان حلقا واستقرا","في وئام، في بهجة، في سعاده",39,"د",2,0],["هِيَ رَشقَةٌ في لَحظِها النَشوانِ","وَأَتَت عَلى أَثر الطَبيبِ تراني",40,"ن",2,1],["هي رجعة منه اِستعارتها العلى","لاخ الفضائل جعفر فاعارها",41,"ر",3,0],["هي روحٌ بنفسه مستقلٌّ","عن قيود الإجسام قام بذات",42,"ت",1,0],["هِيَ ريح وَمِنكَ تُزجي سَحاباً","أَمن الناس رَعده وَالبُروقا",43,"ق",2,0],["هي ربة القلم الذي ما حازه","سحبان في ماض من الأزمان",44,"ن",1,0],["هي روض حسن يانع","طابت مجانيه الجنيه",45,"ي",2,0],["هي روحي ولا غنى لي عنها","وحديثي يطول متناً وشرحا",46,"ح",2,0],["هي ريفيّة وأين غواني","شامخات الذرى وبيت الهشيم",47,"م",1,0],["هي رعشةُ الزهرِ النضيرِ مُبللاً","بدمِ الدُجى يهمي مع الانداءِ",48,"ا",1,0],["هي رحلةٌ للشوقِ من عليا الربى","في بعلبكَّ الى انخفاضِ الساحلِ",49,"ل",1,0],["هي راحٌ حملت بالراحتين","افتدي حاملها بالمقلتين",50,"ن",1,1],["هِي رحلةٌ محتومَةٌ لمنازِلٍ","لا يُرتَجَى لِقَطينِهنَّ قُفُولُ",51,"ل",1,0],["هي روح وبهجة وصفاء","وشفاء وفرحة وسرور",52,"ر",1,0],["هِي راحة للشاربين وَنزهة","للناظِرين وَطلسم للراقي",53,"ق",2,0],["هي روحي جاءت تخلّصني من","غضب العالم الفخور بشمسه",54,"س",2,0],["هي روح وراحة لفؤادي","لست اختار عندها العندميه",55,"ي",2,0],["هي روضة المعمور فاسقوا دوحها","بالعلم يورق فرعها المتهشم",56,"م",1,0],["هَيْرَه يَتْلِفْ حالي ويَسبي","والوصل أفراح زين بها",57,"ب",3,0],["هي ربَّة ذاتُ المَقاماتِ العُلا","وَكَريمةُ الأَجدادِ وَالآباءِ",58,"ا",2,0],["هي رتبة مهما تعالى قدرها","هي دون مجد للمناصب شرّفا",59,"ف",2,0],["هيَ رُخصَةٌ في الصُبحِ لا في غَيرها","مِن أَجل يَقظة غافِلٍ وَسنان",60,"ن",1,0],["هي روضة جلبت وبكر عطارد","جلّابها والمشتري المريخ",61,"خ",1,1],["هِيرُودُسُ الخَثَّارُ ساءَ بقتلِهِ","أَطفالَ أَفراثاً وأَسرَفَ واعتَدَى",62,"د",2,0],["هي رسل الهوى تذكر قلبي","بشفاه ذوات حسن عذاب",63,"ب",1,0],["هِيَ رَمزُ شَيءٍ واحِدٍ وَلَو انَّهُم","قَد أكثَروا التَّنويعَ وَالتَّجنيسا",64,"س",2,0],["هي روضة عني الإله بغرسها","أثمارها الرمان والتفاح",65,"ح",1,0],["هي رامة مأوى الظباء ومألف ال","خود الحسان ومسقط الآرام",66,"م",1,0],["هِيَ رُؤيا حِلمٍ وَيَقظَتُهُ المَو","تُ وَقَفرٌ سَماؤُهُ مِن آلِ",67,"ل",1,0],["هيرا أسارتها فلم يعلم بها","زفسٌ ولا أربابٌ ذاك المحفل",68,"ل",1,0],["هي رحمة اللَه التي لا تشتري","بكتابة العلماء ولا بالدرهم",69,"م",1,0],["هي روض الجمال يرتادها الطر","ف اختلاساً وتمنع الكف قطفا",70,"ف",2,0],["هيَ راحٌ كيف حلّتْ عَجَباً","وهي سِحرٌ كيف ما كانت حراما",71,"م",2,0],["هي روض ونعم مرعى ومنهل","لامر النحل الإمام المفضل",72,"ل",1,0],["هي روضة تزهو بغضِّ أزاهر","يزهو العلى بصفاء ناديها الندى",73,"د",2,0],["هي روضة الخلد التي قد خُلدِّت","فيها لذائذُ كلِّ عيشٍ سرمد",73,"د",1,0],["هى ركعة فى العشق لست أتمها","الا على سجادة الشعراء",74,"ا",2,0],["هِيَ رَكْعَتِي الأولَى بمِحْرَابِ الهَوَى","فَرْضِي الذي مَا ضَمَّهُ التَّدْنِيسُ",75,"س",1,0],["هي راس مالي والعرب ما يدركون","اني على باب الممات وما حكيت",76,"ت",1,0],["هي رحلةُ قد أرهقتك ذميلا","ما كان ضرك لو صبرت قليلا",77,"ل",2,1],["هي رغم المرجفين الدخلا","في بني الإنسان خير السير",78,"ر",1,0],["هي ربّةُ الإلهامِ ساكنةٌ","في مهجة الشُّعراءِ والكُتُبِ",79,"ب",1,0],["هِيَ رَبَّةُ الشِّعرِ النَّقِيِّ بِصِدقِهَا","تَروِي مَشَاعِرَهُ بِمَاءِ نَقَائِهَا",80,"ا",3,0],["هي روضة الوادي وفي جرعائها","يجتاز سرب الريم من غزلانها",81,"ن",3,0],["هيَ روضةٌ غَنّاءُ .. في دَمِها","أنشودةُ الأيامِ شَلَّالُ",82,"ل",1,0],["هي رؤيا أورقت في خافقي","زانتْ الوصلَ بثوب السندس",83,"س",1,0],["هيَ رحلةٌ ما زلتُ قيدَ شهيقِها","مطراً.. وفي قلبي النوى قدْ أبرقا",84,"ق",2,0],["هي رونقُ المعنى إذا هامستهُا","ما كان يُكذبني العذولُ المرجفُ",85,"ف",1,0],["هِي رَبةُ الشِّعرِ البَديعِ ونَبْعُهُ","عَنْها، وفِيْهَا قَدْ شَدَا الشُّعَرَاءُ",86,"ا",2,0],["هي روضةٌ ، عبقُ الربيعِ","نديمُها وسميرُها",87,"ر",3,0],["هِىَ رَايَةُ حَقٍّ نَحمِلُها","عَالِيَةً تَأبَى أنْ تُقْهَرْ",88,"ر",1,0],["هيَّ رغبةٌ خلاقةٌ ترنو بنا","هل تنجحُ الرغباتُ أم تتمزقُ؟",89,"ق",1,0],["هي رتبة فاق الجما","د بها ذوي اللب الذهول",90,"ل",1,0],["هِي رَوْضَةُ الحُسْنِ التي","نَسْعى لها نَحْنُ البَشَرْ",91,"ر",1,0],["هي روضة الإيمان يجري نهرها","عذبا ويشدوا في رباها البلبل",92,"ل",1,0],["هِيَ رَقْدةٌ رَعْناءُ تُدْميْ أنْفُساً","وَثمالةٌ حَيْرى تَلوكُ سُكارى",93,"ر",2,0],["هيَ رحلةٌ أخرى هناكَ ، تبسّمي","فامضي إلى أقدارها وتنعّمي",94,"م",2,1],["هي رقصةٌ أُخْرى ، مَدائن شهوتي","وكأنّها شوق الشِّفاه إلى فمي",94,"م",2,0],["هي رَوْضَةٌ صَاغَ الإله جِنَانَهَا","لا تَسْأَلِي مِنْ أَيْنَ لِي نَفَحَاتِي",95,"ت",2,0],["هي رغبتي هي حاجتي واختياري","هي ذكرياتي لا انتهيت وبدتني",96,"ن",2,0],["هي رحلتي وحكايتي واختصاري","هي ضحكتي لا رحت عنها وجتني",96,"ن",2,0],["هي راحتي هي رحلتي والمساري","هي التعب لامن بكيت وبكتني",96,"ن",2,0],["هي راس مال الحب واجمل رصيده","من دونها الدنيا ب اهلها مابيها",97,"ي",3,0],["هي رقةٌ توحي إليّ قصائداً","لا تنتهي كالشمس ليس تغيبُ",98,"ب",1,0],["هي ربما تسلو غداً لكنها","هذي العشيَّةَ قد تزول حياتُها",99,"ت",3,0],["هي رمزُ سلمٍ دائمٍ ليست تسي","ئُ لأي نفسٍ، دائماً هي خَيِّرَةْ",100,"ر",2,0],["هي رمزُ حبِّ قرينة لقرينها","هي قلعة الحصنِ الأمين لمالهِ..",101,"ل",2,0],["هي رمز إخلاصٍ فريدٍ لم تحُز","ما تستحق وإنما انعكس البَلا",102,"ل",2,0],["هي رسمُ سوريَّا التي قد مُزِّقت","بمؤامراتٍ لا تملُّ خرابا",103,"ب",2,0],["هي رمزُ عقلانيةٍ ومروءةِ","هي رمز فكرٍ عالميّ القيمةِ",104,"ه",1,1],["هي رغم كل المارقين بعصرنا","قد قاومت تفكيرَهُ المتعفنا",105,"ن",2,0],["هي رحلتي أوجزتُها بعبارةٍ :","\"ك أبٍ ترفَّقَ صادقاً بوليدِهِ\"",106,"د",2,0],["هي ريم من أرض طهران جاءت","وأقامت ياللورى بفؤادي",107,"د",2,0],["هِيَ رُوحِي ؛ وَ مُهجَتِي ؛ وَ ضَمِيرِي","وَ عُيونٌ بِها امكُثِي - الآنَ - كُحلَا",108,"ل",2,0],["هيَ رحلةُ السَّهمِ المفارقِ قوسَهُ","ما عادَ يوماً مُخْبِراً عمَّا جَرى",109,"ر",2,0],["هي رؤيا في مسافات المدى","هي مرآة الهوى شفت كمالا",110,"ل",2,0]]}