m.aspx?id=179239",""],[45,"ها هوَ الشّيبُ لائِماً، فأفيقي","https://www.poetsgate.com/ViewPoem.aspx?id=32844",""],[45,"هَلْ فيكُمُ مِنْ وَاقِفٍ مُتَفَرِّسِ","https://www.poetsgate.com/ViewPoem.aspx?id=31149",""],[31,"حَدِّثينا، قُرَيْبَ، ما تَأْمرينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19123&r=&rc=385",""]],"verses":[["في رِياضٍ مِنَ السَماحِ حَوالٍ","وَجِبالٍ مِنَ الحُلومِ رِزانِ",0,"ن",1,0],["في رِفقَةٍ لا يَستَطيلُ سَفيفُها","أَبَداً وَلا يَدري المَقالَ حَليمُها",1,"م",3,0],["في رِواقٍ مِنَ القَنا لا تُرى في","هِ سِوى البيضِ وَالعَوامِلِ سَقفا",2,"ف",2,0],["فَيَرفَعُ صَدرَ السَيفِ إِن حَطَّ كَأسَهُ","وَيَمري دِماءَ الهامِ إِن لَم يُعاقِرِ",3,"ر",1,0],["في رِفقَةِ البَيداءِ أَو","بَينَ المَنازِلِ وَالقُصورِ",4,"ر",1,0],["في رِجالٍ تَهزا بِوَفدِ المَعالي","وَدِيارٍ تَسطو عَلى الوُرّادِ",5,"د",1,0],["فَيَرمي بِها بَغدادَ كُلُّ مُكَبِّرٍ","إِذا ما رَأى جُدرانَها وَقِبابَها",6,"ب",3,0],["فيَرْحَلُ عَنهُمْ والمُحَيَّا بِمائِهِ","يُلاعِبُ ظِلَّ الفائِزِ المُتَغَنِّمِ",7,"م",1,0],["فَيَرُدُّها سوداً عَلى جَنَباتِها","مِن ظُلمَةَ التَمويهِ أَلفُ نِطاقِ",8,"ق",1,0],["في رِياضٍ مِثلِ السَماءِ اِخضِراراً","زَيَّنَتها أَزاهِرٌ كَالدَراري",9,"ي",1,0],["في رَوضَةٍ عُنِيَ الرَبيعُ بِها","فَأَبانَ صنعَةَ عِلَّةِ العِلَلِ",10,"ل",1,0],["في رَوضَةٍ نَسَجَت وَشائِعَ بُردِها","كَفُّ السَحابِ وَأَيُّ كَفِّ صَناعِ",11,"ع",1,0],["في رَوضَةٍ بِالنَيربَينِ أَريضَةٍ","رَضَعَت أَفاويقَ السَحائِبِ حُفَّلا",12,"ل",2,0],["في رياض تبسم الزهر فيها","لغمام بكت دموع لال",13,"ل",1,0],["فِي رِضَى المَرْبُوبِ وَالرَّبِّ","بِتْ قَرِيراً يَا أبَا الطَّبِّ",14,"ب",1,1],["فِي رَوْضَةٍ شَائِقَةٍ أُنْشِئَتْ","لسَاعَةٍ أَزْهَارُهَا زَاهِيهْ",15,"ي",2,0],["فِي رَوْضَةٍ أَنِفٍ مُنَسَّقَةِ الحِلَى","نَسَقاً تَقِرُّ بِحُسْنِهِ العَيْنَانِ",16,"ن",1,0],["فِي رَحْمَةِ اللهِ الأُولَى بَدَرُوا لَهُمْ","عَدْنٌ وَمَنْ يَرْحَمْ فَقِيراً يُرْحَمِ",17,"م",1,0],["في رَبرَبٍ رَوائِقِ الأَعطالِ","هِيفِ الأَعالي رُجَّحِ الأَكفالِ",18,"ل",1,0],["في رَبرَبٍ مُخطَفِ الأَحشاءِ مُلتَبِسٍ","مِنهُ بِنا مَرَضُ الحورِ المَبَاهيجِ",19,"ج",1,0],["في روض جودك قد طوّقتني مِننا","طوقَ الحمام فما سجعي مُوَفيّها",20,"ي",3,0],["في روضة يشجي المشوق ترقرق","للماء في جنباتها وخرير",21,"ر",1,0],["فيروح يَشري ثانياً وبما ارتشى","قد عاد من أهل الثراء الأجزل",22,"ل",1,0],["فيرحل من أنسابه في مواكب","وينزل من أحسابه في سُرادق",23,"ق",1,0],["فيرفع بعض من حصير ظلالةً","ويجلس فيها جلسة المتعبّد",24,"د",1,0],["في رَبرَبٍ كَنِعاجِ صا","رَةَ يَبتَئسنَ بِما لَقينا",25,"ن",2,0],["في ريِّ صاد بالندى لك فكرةٌ","وسرى لا فصح ناطق بالضاد",26,"د",1,0],["فيرفع أخبارَ السلامِ لمالكٍ","ويسمعني في الرد مسند أحمد",27,"د",1,0],["فيروي غليلها من نداه","ويحييه شكرها بالرياض",28,"ض",1,0],["في رفعة وسعادة ما برّها","في الخلقِ مقطوع ولا ممنوع",29,"ع",1,0],["في راحة الجود تعبانة","بنائل في الخلق مقسوم",30,"م",1,0],["في رفعةٍ تحسنُ الأعراب أن تره","يرفع له الشأن أو يكسر له الشاني",31,"ي",1,0],["في رفعةٍ وسيادةٍ وسعادةٍ","وزهاوةٍ وإفادةٍ وتهاني",32,"ي",1,0],["في رتبتي علمهم والجود ثم لهم","فرط العلوّ ورجحان الموازين",33,"ن",1,0],["في روضةٍ شَتوية رَضِعت","دِرَرَ الحيا حَلباً على حلبِ",34,"ب",1,0],["في رياضٍ من الشقائق والنَّسْ","رين فوق المراشفِ البارداتِ",35,"ت",1,0],["فيرى اللَّه كلَّ باغٍ عليكم","وهو مني بحتفه مبغوتُ",36,"ت",1,0],["في ربيعٍ من شباب","وربيع من نباتِهْ",37,"ت",2,0],["في رَاحة اليأس لي من بُغْيَتِي عوَضٌ","وحسْبيَ اللَّهُ مَدْعَى كلِّ مَنْجودِ",38,"د",1,0],["فيرى إجازة ما يُسام ولا","يلقى مُطالبُهُ به نَكدا",39,"د",2,0],["في رِباعٍ مثلِ الرياضِ يُحَيِّي","كَ بأنفاسها رَقيقُ النسيمِ",40,"م",1,0],["في راحَتَيْكَ من اليمَّيْن لجُّهما","وفي بنانك أنهارٌ وخُلجان",41,"ن",1,0],["في رَبرَبٍ يَلَقٍ حورٍ مَدامِعُها","كَأَنَّهُنَّ بِجَنبَي حَربَةَ البَرَدُ",42,"د",1,0],["فَيَرى الكَواكِبَ تَحتَهُ أَمّا أَنا","فَتَظَلُّ أَفكاري تَحومُ عَلَيها",43,"ا",1,0],["فَيَرجِعُ الحَقلُ يَزهو في غَلائِلِهِ","وَتَرجِعينَ وَأَغشاهُ فَأَلقاكِ",44,"ك",1,0],["في رُبى لُبنانَ قَومي الأَصفِياء","وَبِأَرضِ الشامِ أَحبابي الكِرام",45,"م",1,0],["فَيَروقُني وَالجَوُّ مِن","هُ ساكِنٌ وَالقَطرُ ساكِب",46,"ب",1,0],["في ريحِهِ أَو لَونِهِ أَو طَعمِهِ","كَالمِسكِ أَو كَالتِبرِ أَو كَالضَربِ",47,"ب",1,0],["فيرنُّ قلبي بالصَّدى وعظامي","روحٌ أَنا مسحورةٌ في عَالمٍ",48,"م",1,0],["في رنَّةِ المزمارِ","في لغوِ الطُّيور الشَّاديهْ",49,"ه",1,0],["في رقَّةِ الفجرِ الوَديعِ","وفي اللَّيالي الحالِمَهْ",49,"ه",1,0],["في رقصِ أَمواجِ البحيْرة","تَحْتَ أَضواءِ النُّجُومْ",49,"م",1,0],["في رياض الآداب غرسك يحكى","شجرا من اثماره الآلام",50,"م",1,0],["فَيَرعَى الفَلا ما قَدْ رَعَتْهُ مِنَ الفَلا","ويُنْحِفُها المَرْتُ القِفارُ وتُنْحِفُهْ",51,"ه",1,0],["في رُتبَةٍ حَجَبَ الوَرى عَن نَيلِها","وَعَلا فَسَمَّوهُ عَلِيَّ الحاجِبا",52,"ب",2,0],["في رأسها فتح وإكليلها ال","مقلوب في داخلها يقطرُ",53,"ر",1,0],["في راحتيكَ الرِزقُ والأجَلُ","وبعزمتيكَ الأمنُ والوَجَلُ",54,"ل",1,1],["في رأسِ شاهقةِ المرامِ منيعةٍ","والقِدُّ طَوقٌ والحديدُ سِوَارُ",55,"ر",1,0],["في رِداءٍ مِنَ الفُتُوَّةِ فَضفا","ضٍ وَعَهدٍ مِنَ التَصابي قَريبِ",56,"ب",1,0],["في رِياضٍ قَدِ اِستَعارَ لَها الوَب","لُ رِداراً مِنِ اِبتِسامِ سُعادِ",57,"د",1,0],["في رَأسِ مُشرِفَةٍ حَصاها لُؤلُؤٌ","وَتُرابُها مِسكٌ يُشابُ بِعَنبَرِ",58,"ر",1,0],["في رَوضَةٍ خَضراءَ يُشرِقُ نَورُها","تُسقى مُجاجاتِ الغُيومِ البُخَّسِ",59,"س",1,0],["في رِباعٍ تَرتادُ عَينُكَ فيها","حِلَلَ المُلكِ مُفضِياتٍ عِراصُه",60,"ص",2,0],["في رَفيعِ السُموكُ يَعتَرِفُ الغَي","مُ لَهُ بِالسُمُوِّ وَالإِرتِفاعِ",61,"ع",1,0],["في رِعانٍ تَرغو وَتَصهَلُ لَم تَس","مَعَ وَلَم تُصِخ لِنَهيقي",62,"ق",2,0],["في روضَةٍ قد لَبِسَت","من لؤلؤ الطَّلِّ سُبَح",63,"ح",1,0],["في رَوضَةٍ حاكَ الرَبيعُ لَها","بُسطاً وَأَلبَسَ دَوحَها حُلَلا",64,"ل",2,0],["في رِياضٍ عَطَّرَت أَنفاسُها","سائِرَ الآفاقِ إِذ هَبَّت صَباها",65,"ا",3,0],["في رِياضِ الفَخرِيَةِ الرَحبَةِ الأَك","نافِ ذاتِ الفُنونِ وَالأَفنانِ",66,"ن",1,0],["في رِياضٍ كَأَنَّما رَصَّعَ القَط","رُ أَكاليلَها الحُسانَ بَدُرِّ",67,"ر",1,0],["في رَبعِهِم وَلَهُم بِالشُكرِ يُنطِقُنا","وَكانَ فيهِم بِهِم مِنهُم تَأَنُّقُنا",68,"ن",2,0],["في رَوضَةٍ نُصِبَت أَغصانُها وَغدا","ذَيلُ الصِبا بَينَ مَرفوعٍ وَمَجرورِ",69,"ر",1,0],["في رِياضٍ بِها الشَقيق","قَد جَلا بَهجَةَ التَمام",70,"م",1,0],["فَيروزَجُ الصُبحِ أَم يا قوتَةُ الشَفَقِ","بَدَت فَهَيَّجَتِ الوَرقاءَ في الوَرَقِ",71,"ق",1,1],["في رَبْعِهِ الرحبِ سماءُ العلى","طوالعٌ فيها نجومُ الهمم",72,"م",1,0],["في رياضٍ تَنَوَّعَ النَّوْرُ فيها","كاليواقيتِ في حِقاقِ التِّجارِ",73,"ر",1,0],["في رُوَاقِ المُلْكِ منه مَلِكٌ","مُلْكُهُ من قبلِ عادٍ وثَمود",74,"د",1,0],["في رَبعِهِ رَوضٌ مَرُودٌ خِصْبُهُ","أبداً مُصَاقِبُ مَنْهَلٍ مَورودِ",75,"د",1,0],["في روضةٍ نَفْحَتُها مِسْكَةٌ","تُهْدى إلينا في جيوب الرّياح",76,"ح",1,0],["في روضةٍ غنّاءَ غنّتْ بها","في قُضُبِ الأوْراقِ وُرْقٌ فِصَاح",77,"ح",1,0],["في رَوضَةٍ قَد عَلا حافاتِها زَهَرٌ","عَلِمتُ عِندَ اِنتِباهي أَنَّها نِعَمُه",78,"م",2,0],["فَيَرى فَناءَ المالِ أَفضَلَ ذُخرِهِ","وَخُلودَ ذِكرِ الحَمدِ خَيرَ خُلودِ",79,"د",1,0],["فَيَروحُ بَينَ مُؤَدِّبيهِ مُخالِفاً","مُتَعَصِّباً بِعِصابَةِ التَسويدِ",79,"د",1,0],["في روضةٍ عبثَ النسيمُ بخدِّها","فتضمَّخَتْ بالطيبِ كفُّ الشمأل",80,"ل",1,0],["فَيَرى فَعلَهُ فَيُسدي إِلَيهِ","وَهوَ في ذاكَ بِالحَرى أَن يَخونا",81,"ن",2,0],["في رَوضَةٍ يَمَّمنَها مَولِيَّةٍ","مَيثاءَ رابِيَةٍ بُعَيدَ سَماءِ",82,"ا",2,0],["في رُقعَةٍ تَحمِلُ مِن رِفعَةٍ","لَألاءِ أَوضاحِ الوُجوهِ الصِباح",83,"ح",1,0],["في رَوضَةٍ جِنحُ الدُجى ظِلٌّ بِها","وَتَجَسَّمَت نَوراً بِها الأَنوارُ",84,"ر",1,0],["في راحَةٍ خُلِقَت سَماءَ سَماحَةٍ","فَتَقارَنا نَجماً بِها وَهِلالا",85,"ل",2,0],["فَيَرمي التِجارُ بَراميلَهُم","بِأَبصارِ جِنٍّ تَمُجُّ اللَهَبْ",86,"ب",1,0],["في رسولِ اللهِ إذ نَبَّأكم","ببلايا الخمرِ آياتٌ كُبَرْ",87,"ر",1,0],["فيرميك ربُّكَ بابنِ الوليدِ","ويشفيكَ من دائِكَ المعضلِ",88,"ل",1,0],["في رجالٍ من صحبهِ زَعموا الإغ","راءَ نُصحاً واسْتَحسنوا التَّغريرا",89,"ر",2,0],["في رَوضَةٍ كَحُلَّةِ العَروسِ","وَخَدَمٍ كَهامَةِ الطاوُوسِ",90,"س",1,0],["في رُكامٍ ضاقَ بِالماءِ ذَرعاً","حَيثُما مالَت بِهِ الريحُ ساحا",91,"ح",2,0],["فَيَرى سَبيلَهُما لَدَي","يَ سَبيلَهُ فيما مَضى",92,"ض",2,0],["في رِياضٍ رِبعِيَّةٍ بَكَّرَ النَو","ءُ عَلَيها بِمُستَهِلِّ الغَمامِ",93,"م",1,0],["في رَوضَةٍ لَعِبَ النَعيمُ بِحورِها",