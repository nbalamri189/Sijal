ا تلوموني إني أطلت المقالا ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146608",""],[5818,"أيقنتُ أنَّ اللهَ يا قلبي معَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=184765",""],[5829,"هوى الشام","https://www.poetsgate.com/ViewPoem.aspx?id=211774",""],[5875,"شيّب المهاريف","https://www.poetsgate.com/ViewPoem.aspx?id=187017",""],[5910,"هتف البيانُ فراع قلبَ الواجلِ","https://www.poetsgate.com/ViewPoem.aspx?id=206320",""],[5937,"هوَ من !","https://www.poetsgate.com/ViewPoem.aspx?id=211819",""],[5956,"وعد يعلمني الصبر","https://www.poetsgate.com/ViewPoem.aspx?id=182030",""],[5956,"ساكنة السطح","https://www.poetsgate.com/ViewPoem.aspx?id=182197",""],[5956,"سؤال وجواب على شاطئ البحر","https://www.poetsgate.com/ViewPoem.aspx?id=183228",""],[5956,"البلدة السعيدة","https://www.poetsgate.com/ViewPoem.aspx?id=185792",""],[5956,"قصة صديق","https://www.poetsgate.com/ViewPoem.aspx?id=192417",""],[5956,"وكفى بالله وكيلا","https://www.poetsgate.com/ViewPoem.aspx?id=192647",""],[5956,"الودُّ الأخوي","https://www.poetsgate.com/ViewPoem.aspx?id=192947",""],[5956,"يارا هنالك يا فؤادي فانتبهْ","https://www.poetsgate.com/ViewPoem.aspx?id=193150",""],[5956,"نجلي وأصحابه وموظفوه","https://www.poetsgate.com/ViewPoem.aspx?id=193289",""],[5956,"تهديدي له","https://www.poetsgate.com/ViewPoem.aspx?id=193425",""],[5956,"فيه سرُّ الله في أسمى البشرْ","https://www.poetsgate.com/ViewPoem.aspx?id=193919",""],[5956,"مهما اجتمعنا لا نطيق تباعداً","https://www.poetsgate.com/ViewPoem.aspx?id=193941",""],[5956,"أنا أحتفي بإخائه البنَّاء","https://www.poetsgate.com/ViewPoem.aspx?id=194391",""],[5956,"نسيَ الجميع صديقهم","https://www.poetsgate.com/ViewPoem.aspx?id=194465",""],[5956,"يا ربُّ يا مَن لا تضيع ودائعُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=200541",""],[5956,"رضيعٌ يزحف كسُلْحُفاةٍ حلوة","https://www.poetsgate.com/ViewPoem.aspx?id=205158",""],[5956,"أخَّرْتُ في أغلى الصحاب قصائدي","https://www.poetsgate.com/ViewPoem.aspx?id=214991",""],[5957,"ولأن عطرك أطيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=210291",""],[5969,"لا تفتحي الباب الذي أوصدته","https://www.poetsgate.com/ViewPoem.aspx?id=198679",""],[6082,"يا قلب","https://www.poetsgate.com/ViewPoem.aspx?id=59132",""],[6093,"باسطة الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=176436",""],[6093,"الفَنْقَلَة","https://www.poetsgate.com/ViewPoem.aspx?id=204921",""],[6102,"غُربَةُ الزَّمَكان!","https://www.poetsgate.com/ViewPoem.aspx?id=186283",""],[6127,"أبونا آدمُ","https://www.poetsgate.com/ViewPoem.aspx?id=188209",""],[6142,"مل بنا يا هديت ننتجع الحق","https://www.poetsgate.com/ViewPoem.aspx?id=155693",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577080",""],[6160,"هَلْوسَات فِي غُرْفَة سَودَاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87108&r=&rc=25",""],[5080,"من يصطفي جسد الرّحيل مواظبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88142&r=&rc=12",""],[6241,"حقيقة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77054&r=&rc=12",""],[6277,"قالوا أناب !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64448&r=&rc=11",""]],"verses":[["هُوَ لا يُريدُ فِراقَها","خَوفَ القَوارِسِ والهَواجِر",0,"ر",1,0],["هَؤُلاءِ الصُدورُ أَدبرُ مِن دب","رٍ وَأَردى رَذالَةً وَأَخَسُّ",1,"س",1,0],["هُوَ لِلنَّاظِرِينَ نُورٌ مُبِينٌ","وَهُوَ لِلوَارِدِينَ مَاءٌ مَعِينُ",2,"ن",1,0],["هو للعلم خير فجر تجلَى","مستنيراً بأشهرِ الأوضاع",3,"ع",1,0],["هؤلاء الصِّيد قومي فانتسبْ","إن تجد أكرمَ من قومي رجالا",4,"ل",2,0],["هُوَ لِلحَقِّ إِلى أَن يَنجَلي","وَعَلى الباطِلِ حَتّى يُزهَقا",5,"ق",2,0],["هُوَ لِلأُلى يَدورونَ كُنهَ جَمالِهِ","فَإِذا مَضَوا فَكَأَنَهُ دُكّا",6,"ك",2,0],["هُوَ لِلدُجى يُلقي عَلَيهِ خُشوعَهُ","وَالصُبحُ يَسكُبُ وَهوَ يَضحَكُ نورُهُ",6,"ه",1,0],["هُوَ لِلرِياحِ تَهُزُّهُ وَتُثيرُهُ","وَالشُهبُ تَسمَعُ في الظَلامِ زَئيرَهُ",6,"ه",1,0],["هُوَ لِلحُسنِ مَشرِقٌ","فيهِ قَد تَظهَرُ الفِتَن",7,"ن",1,0],["هُوَ لِجَيش الطَير مِن فِكرَتي","صَقرٌ فَوَلّى وَهوَ مَقهورُ",8,"ر",1,0],["هو ليس غير وديعة","للشعب طراً في ترابك",9,"ك",1,0],["هول كين مصر رواية لا تنتهى","منها يد الكتاب والشراح",10,"ح",1,0],["هُوَ لَحنٌ مُضَيَّعٌ لا جَواباً","قَد عَرَفنا لَهُ وَلا مُستَقَرّا",11,"ر",2,0],["هُوَ لُطفُ اللَهِ لَو تَعلَمُهُ","رَحِمَ اللَهُ اِمرَءاً يَرحَمُهُ",12,"ه",1,0],["هُوَ لِلراغِبينَ عُمدَةُ آما","لٍ كَما البَيتُ لِلحَجيجِ مَثابَه",13,"ب",2,0],["هَولٌ جَميعُ الأَهوالِ تَرهَبُهُ","خَطبٌ جَميعُ القُلوبِ تَخشاهُ",14,"ا",2,0],["هُوَ لِلوَفِيِّ العَهدِ ظِلُّ أَراكَةٍ","وَلِمُضمِرِ الشَنَآنِ شَوكُ عِضاهِ",15,"ه",1,0],["هوَ للكرى وعنِ الذي","يهواهُ نافٍ نافرُ",16,"ر",1,0],["هؤلاءِ القومُ يا قومُ مَضَوا","ما تبقى منهمُ إلا الأقلْ",17,"ل",1,0],["هو لا يضنُّ بألفِ مص","رٍ في الفداءِ وألفِ نيلْ",18,"ل",1,0],["هُوَ لِلغَرابَةِ في الجَمالِ عَرابَةٌ","أَخَذَ المَحاسِنَ رايَةً بِيَمينِهِ",19,"ن",2,0],["هَوَّلَ عَوداً قَد نَخَر","فَبَينَ هاوٍ مُنحَدِر",20,"ر",1,0],["هو ليلٌ من الغياهبِ ضافي","وأديمٌ في لُجَّةِ الثلج طافي",21,"ف",2,1],["هُوَ لَيْلٌ جَلاَ الصَّفَاءُ بهِ","صُورَةً منَ رَائعِ الصُّوَرِ",22,"ر",1,1],["هُوَ لِلْعَفافِ مِنَ الدَّعَارَة مُوْئِلٌ","هُوَ لِلإِبَاءِ مِنَ المَهَانَة مَفْزَعُ",23,"ع",1,0],["هو للأَبناءِ عمٌّ وأبٌ","وهو للآباءِ خِلٌّ وخَدينْ",24,"ن",1,0],["هو ليلاي؛ فاعذروني إذا ما","أنا أصبحت في الهوى مجنونَه",25,"ن",2,0],["هو للصَّبَابَة معرض","هو للغَوانِي مُؤتمر",26,"ر",1,0],["هو للصبابةِ كلَّ عامٍ موسمٌ","هو معرضٌ للخُرَّدِ الأبكار",27,"ر",1,0],["هُوَ لَمْ يعترفْ بلفظِ «محال»","فَمَحَاهُ مِنْ معجم الكلمات",28,"ت",1,0],["هو لا يرتقي المنابر؛ لكنْ","فأسُه في الثَّرى تُجيدُ الخطابة",29,"ب",2,0],["هو لا يحيد عن الصوا","ب، ولا يحابي من رشاه",30,"ا",2,0],["هُوَ للرّاغبينَ عُدَةُ آمَا","لٍ كمَا البَيتُ للحَجيجِ مَثَابَهْ",31,"ب",2,0],["هؤلاء دود القزّ أحسن منهم","وأجلّ في نظر الحياة وأفهم !",32,"م",1,0],["هو للمصطفى وسيلتي العظ","مى وذخري لصدمة الإزماع",33,"ع",1,0],["هو لن يعيش ولن","يعيش بغير باطية الشراب",34,"ب",1,0],["هو لُها يُختَشَى وفِيهَا إشتِبَاهٌ","مُعقِبٌ في حِجَا الدِّليلِ غُمُومَا",35,"م",2,0],["هو للمسالم شهدةٌ","وعلى الأعادي كالهبيده",36,"د",2,0],["هو لا ينفكّ عَبداً قيّما","شدّدي في هجرهِ أو نفّسي",37,"ي",1,0],["هو للنبيّ مصاحبٌ ومعلّمُ","بِحياتهِ صلّوا عليه وسلّموا",38,"م",3,0],["هو للذة استنام","كمن ليس يشعر",39,"ر",1,0],["هوَ لِصٌّ أَسكَنتُهُ قَلبي","مَعَ أَنّي عَرَفتَه سالِب",40,"ب",1,0],["هو ليث يوم وغى وغيث في الندى","وغياث مزعوج الفؤاد مروع",41,"ع",1,0],["هو ليث مستأنس وعجيب","أن تري الأغلب الهزبر أنيسا",42,"س",2,0],["هؤلاءِ أعداءُ الوَرى وعميدُهم","تصريحهُ الإبهامُ والإيهام",43,"م",1,0],["هؤلاء ضمّيهم بلا أسفٍ إِلى","ما في ثراها من صَليبييك",44,"ك",1,0],["هو لَوْ لَمْ يأْخذْ نفوسَ البرايا","ضنَّ حتى بالنفحةِ السجواءِ",45,"ا",2,0],["هو للشاعرِ في جوف الدجى","سورةٌ أَوحى بها ربُّ الفلق",46,"ق",1,0],["هو لو لمْ يتخذْ زِيَّ (الذينْ)","عُدَّ من حزبِ (اللواتي) في الأَثيرِ",47,"ر",1,0],["هؤلاء الألى يضيقون بالنو","ر إذا كان عالي الفيضان",48,"ن",1,0],["هؤلاء الأُلى يموتون في اللي","ل فلا يحرمون من أكفاني",48,"ن",2,0],["هو للبؤس صورة","ومن شجون الأسى صور",49,"ر",1,0],["هؤلاء تعدهم في الضحايا","الالى بالخلود هم احرياء",50,"ا",2,0],["هولُجّةُ الكَرمِ الّذي مِن قَبلِه","كانوا أوائلَ مَوجِها المُتَدافع",51,"ع",1,0],["هو لم يُعزَلْ ولكنْ","عُزِلَتْ عنه الوِزاره",52,"ر",2,0],["هَول الفراق أَشد مِن","هَول الحَمام وَأَقطَع",53,"ع",1,0],["هو لا أشك الجوهر الفَرد الّذي","قُطعَ التراجعَ فيهِ بالإِجماعِ",54,"ع",1,0],["هُو لا شكَ لِما بي","من جوىً في القلب جَاهِلْ",55,"ل",1,0],["هو لساني يعوقُهُ ثِقَلٌ","وذاكَ عندي من أعظم النوب",56,"ب",1,0],["هَوْلٌ نَفى الجِنَّ عن أَخفى مَلاعِبِها","وأَوْحَشَ الوحشَ فِي أَقْصى مَرَاتِعِها",57,"ع",3,0],["هول أثار بها تشجى العيون","منظرا قد فرقت منه الوحوش",58,"ش",1,0],["هو للبرَّيةِ كلها إيمانُها","أَو ثارُها أيانَّ تطلب ثارا",59,"ر",2,0],["هو للعِدى نارٌ مُؤجَّجَةٌ","ولمُعْتفيه موردٌ شَبِمُ",60,"م",1,0],["هوْلٌ عليه من البسالةِ نَفْضَةٌ","وبه إلى حُبِّ العُلى بُرَحاءُ",61,"ا",2,0],["هو لصاحب المأمون خانك غادراً","فمن واثق من بعد ذاك بصاحب",62,"ب",1,0],["هو لابن بدور التمِّ والأنجم العلى","وسحب الغوادي والبحار الخضارم",63,"م",1,0],["هو لا شكَّ قا","تلي فلماذا أودّه",64,"د",2,0],["هؤلاء السادة العلماء","لا الذي تخفى فتاويه",65,"ي",2,0],["هو لي كنانة أسهم أعددتها","في كل سهم مصرع لقتيله",66,"ل",2,0],["هو لولا ذِكرُهُ ما حَسُنَتْ","رُبَّ ذِكرٍ فيه تَحلو الكَلِمُ",67,"م",1,0],["هو ليلٌ ما بهِ من طالِعٍ","هو بحرٌ ما لدَيهِ طَرَفُ",68,"ف",1,0],["هؤلاء اخوَةٌ قدْ تجافَوْا","وطغى اشرارُهمْ في اخْتيالِ",69,"ل",1,0],["هؤلاءِ همْ قومُنا قد غدوْا في","هيئةِ التماثيلِ بينَ العبادِ",70,"د",1,0],["هو للعُلا زنْدٌ وللدنيا إذا","ما اِسودّتْ الأيّامُ خدٌّ أنعَجُ",71,"ج",1,0],["هو للشّاربينَ روحٌ وراحٌ","بل وروضٌ زَها بهِ ريحانُهْ",72,"ن",2,0],["هو لِرَأسِ المجدِ أضحَى خاضِعا","لأنَّه للمجدِ تاجُ المَفرِقِ",73,"ق",1,0],["هو لِلفَوزِ والنَّجاحِ أَساسٌ","فعلامَ العُدولُ عَنهُ عَلاما",74,"م",2,0],["هو للعين قرةٌ وقذاةٌ","لِحَسودٍ ومُنصفٍ للكَمالِ",75,"ل",1,0],["هوَ للمالِك المفَدَّى خَديمٌ","مُخلصٌ واقفٌ بعتبَة بابِ",76,"ب",1,0],["هوَ للعينِ هضبَةٌ من وقَارٍ","بسَمَت خُلقاً عن زُهورِ الروَابي",76,"ب",2,0],["هو لاهٍ عنها وما بتُّ فيه","لم يُحِطْهُ عِلْماً ولم يكُ ظَنّا",77,"ن",2,0],["هو للعقل سلَّمٌ للمعاني","تترقَّى به إلى الأسقام",78,"م",1,0],["هو لا نحن ولا أنت ولا","كل ما ندركه فاقتصر",79,"ر",1,0],["هو لم يلد أبداً ولم يولد ولا","كفء له أحد مقالة لاحِدِ",80,"د",1,0],["هو للرد لا لأجل اعتقاد","وعلى من يرد إذ لا رديد",81,"د",1,0],["هو للصلاة مع السلام المرتضى","الجامع المخصوص ما دام الأبد",82,"د",1,0],["هو لا هو التواب بل هو أنت لا","أنت المتاب عليه يا مصباح",83,"ح",1,0],["هو لو لم يكن به غير روح","غالب للإله ليس يغيب",84,"ب",1,0],["هو لِلمُلكِ كالعمادِ فتلك ال","يد مَغنية بذَاك الْعِماد",85,"د",1,0],["هو للبصائر لذةٌ فكأنها","قد شاركت ابصارنا اذ ترمُق",86,"ق",1,0],["هو للنوادي زينة كفريدة","زانت جمان العقد في الأجياد",87,"د",1,0],["هو ليس صيفا بل يقيم بأهله","لا فاصل ما بيننا وحدود",88,"د",1,0],["هو للكنية والملوك وشعبهم","وبلادهم ذخر من الإذخار",89,"ر",1,0],["هو لَم يَزَل باِسمِ العروبة ناهضاً","عن ساعديهِ مُشمّراً تشميرا",90,"ر",2,0],["هو لاِبن النبيّ خير وزيرٍ","ويمين وساعد وحسامُ",91,"م",1,0],["هو للمُسلمينَ خير إمام","مُرتجى كلّ حاضرٍ أو بادِ",92,"د",1,0],["هو للموالي رحمة","وعَلى العِدى سخط ونِقمه",93,"م",2,0],["هُوَ لِلأَلسُنِ الغَريبةِ يُعزَى","وَبِهِ أَدرَك الفَخارُ مَداه",94,"ا",2,0],["هُوَ لَيثٌ لَهُ بَسالةُ عَمروٍ","وَشَبيبٍ وَعَنترٍ في لِقاه",94,"ا",2,0],["هُوَ لا يُجارى في أَمور عدّة","ما حازَها يَوماً سِواه وَزير",95,"ر",1,0],["هوَ لا يُجارى في أُمور عدّة","ما حازَها كِسرى وَلا سابور",96,"ر",1,0],["هُوَ للخائِفين خَير مَلاذٍ","وَعَلى المُعتدين لَيث شَديد",97,"د",1,0],["هُوَ لَم يَزُر في العام إِلّا مرّةً","بِتكدّرٍ مِنهُ الصَفاء يَزيد",98,"د",1,0],["هُوَ لا يَستَقيم إِلا بلعن","مَع زَجر وَقسوة وَعِناد",99,"د",1,0],["هُوَ لَم يَفتَخر بِأَصلٍ كَريم","كَسِواه وَلا بِفَضل الجُدود",100,"د",1,0],["هُوَ لِلوَعد منجز وَتَراه","دائِماً مائِلاً لِخُلف الوَعيد",100,"د",1,0],["هَوْلٌ عِلاطُ الفعلِ فيه إِذا غدا","قولُ امرئٍ عُطْلاً بغير عِلاط",101,"ط",1,0],["هو لي كهارونٍ لموسى حبذا","تشبيهُ هارونٍ به تشبيها",102,"ي",3,0],["هُوَ لِلعِلمِ شَمسه اليَوم غابَت","وَتَوارَت ذا الآن بَعدَ الظّهورِ",103,"ر",1,0],["هُوَ لَفْظٌ تَحَكَّمَ الطَّبعُ فِيهِ","مِثْلُهُ لا عَدِمْتُكُمْ مَعْدُومٌ",104,"م",1,0],["هُو ليث وهْو غيث للورى","هو نورٌ وحسامٌ مُنْتضى",105,"ض",2,0],["هو ليث الإقدام نمْرُ السرايا","هو غيثُ العطاشِ بدر النادى",106,"د",2,0],["هو لصدر أضحى واسع الصدر ذا لهى","تسيل على سؤال ضيق العذر",107,"ر",1,0],["هُوَ لِي جُنَّةُ إذَا رَشَقَ الخَطْ","بُ بِسَهْمِ التَصْوِيبِ وَالتَّصْعِيدِ",108,"د",1,0],["هُوَ لاحِقٌ قَدميكَ دَوماً كَيفَما","سارَت يَسيرُ منعتً أَو لَم تمنَعِ",109,"ع",1,0],["هو للمحاسن قد غدا","برا وللاحسان بحرا",110,"ر",2,0],["هو لم يزل يبدي الحماقة في الورى","ويذيق بيت المال فقراً مؤلما",111,"م",2,0],["هو لم يُطق بالراءِ نطقاً وهي لم","تنطق إذا خطبت بغيرِ الراءِ",112,"ا",2,0],["هُوَ لِلشَريعة آخذ بِيَمينها","عَمَلاً وَعِلماً بِالبَنان وَبلاهُم",113,"م",1,0],["هُوَ لِلشَريعة آخذ بِيَمينِها","وَيَسارِها نَهجاً لِعَبد القادر",114,"ر",1,0],["هو للزعامةِ صالٌ","شرفاً رقي علياءها",115,"ا",3,0],["هو لجَّة المعروف ما عرفتْ بنو ال","دنيا سواه منهلاً مورودا",116,"د",2,0],["هو للخير كان أصلاً وفرعاً","وله الخيرُ كانَ فرعاً وأَصلا",117,"ل",2,0],["هو للجميع 