{"poems":[[86,"هذا صبي هائم","https://www.aldiwan.net/poem10861.html","مجزوء الكامل"],[71,"لقبوه الحرا بدبس وقد","https://www.aldiwan.net/poem3797.html","الخفيف"],[93,"من عذيري والدمع جار سخين","https://www.aldiwan.net/poem11202.html","الخفيف"],[88,"قل لنجلا نجلا أبي اللمع إني","https://www.aldiwan.net/poem45060.html","الخفيف"],[95,"غادة من الاندلس","https://www.aldiwan.net/poem60150.html","عموديه"],[91,"امنحيني يا نجوم الألقا","https://www.aldiwan.net/poem9047.html","عموديه"],[91,"أمر السلطان بالشاعر يوما فأتاه","https://www.aldiwan.net/poem62797.html","عموديه"],[70,"لكم الروح والبدن","https://www.aldiwan.net/poem42443.html","مجزوء الخفيف"],[78,"يا خبر من يلحظه ناظري","https://www.aldiwan.net/poem14166.html","السريع"],[89,"لهفي يطول على شبابك","https://www.aldiwan.net/poem44755.html","مجزوء الكامل"],[85,"آذار أقبل قم بنا يا صاح","https://www.aldiwan.net/poem7257.html","الكامل"],[85,"أمن البحر صائغ عبقري","https://www.aldiwan.net/poem8086.html","الخفيف"],[85,"أحمدك الله وأطري الأنبياء","https://www.aldiwan.net/poem8099.html","الرمل"],[45,"أن دعاه داعي الصبا فأجابه","https://www.aldiwan.net/poem10667.html","الخفيف"],[66,"هل علم الطيف عند مسراه","https://www.aldiwan.net/poem38476.html","المنسرح"],[44,"إحدى بني بكر بن عبد مناه","https://www.aldiwan.net/poem30327.html","الكامل"],[69,"الطرف ساه ساهر","https://www.aldiwan.net/poem28915.html","مجزوء الكامل"],[69,"ذهب الصدق وإخلاص العمل","https://www.aldiwan.net/poem29305.html","الرمل"],[105,"يا قوم ما ذنب الرئيس","https://www.aldiwan.net/poem42136.html","مجزوء الكامل"],[81,"دنف قضى عز الجمال بهونه","https://www.aldiwan.net/poem61471.html","الكامل"],[52,"لا صيد إلا بوتر","https://www.aldiwan.net/poem26974.html","مجزوء الرجز"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39554","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54937","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55010","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54212","الرمل"],[106,"هو ليلاي","https://www.poetsgate.com/ViewPoem.aspx?id=179378",""],[106,"هل عاد قيس؟","https://www.poetsgate.com/ViewPoem.aspx?id=179386",""],[106,"موكب الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=179775",""],[106,"معجزة السد","https://www.poetsgate.com/ViewPoem.aspx?id=179335",""],[106,"راهب الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=179334",""],[106,"الكلب هول","https://www.poetsgate.com/ViewPoem.aspx?id=179445",""],[45,"إنْ دَعَاهُ داعي الصبَى، فأجابَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31576",""],[91,"الماهدون في المهجر","https://www.poetsgate.com/ViewPoem.aspx?id=53243",""],[116,"لذ بباب الغوث الجليل الرفاعي","https://www.aldiwan.net/poem41778.html","الخفيف"],[125,"قالوا أناب وما أناب","https://www.aldiwan.net/poem23721.html","مجزوء الكامل"],[133,"لمعان البروق هاج الهموما","https://www.aldiwan.net/poem54745.html","الخفيف"],[151,"أهلا بغرتك السعيده","https://www.aldiwan.net/poem68462.html","مجزوء الكامل"],[190,"حي يا سعد قبابا بالحمى","https://www.aldiwan.net/poem35099.html","الرمل"],[190,"أموا المدينة حيث جل المغنم","https://www.aldiwan.net/poem35107.html","الكامل"],[222,"جاء للقصر يخطر","https://www.aldiwan.net/poem55281.html","مجزوء الخفيف"],[224,"ومليح أخذته صاحب","https://www.aldiwan.net/poem41889.html","الخفيف"],[262,"وان طيفا منك عاود مضجعي","https://www.aldiwan.net/poem38243.html","الكامل"],[262,"جور حكم الهوى يهين النفيسا","https://www.aldiwan.net/poem38256.html","الخفيف"],[271,"الشام يقهر والعراق يضام","https://www.aldiwan.net/poem35641.html","الكامل"],[271,"أبدا أرى والغدر طبع فيك","https://www.aldiwan.net/poem35643.html","الكامل"],[299,"لزوال جميع ما أنت رائي","https://www.aldiwan.net/poem36262.html","عموديه"],[299,"خفق القلب له لما خفق","https://www.aldiwan.net/poem36855.html","عموديه"],[299,"نفخ الصور فهبوا مسرعين","https://www.aldiwan.net/poem36856.html","عموديه"],[329,"كذبت هند حين قالت لك القل","https://www.aldiwan.net/poem54941.html","الخفيف"],[343,"شارد اللب والفكر","https://www.aldiwan.net/poem55314.html","مجزوء الخفيف"],[343,"الضحايا معناهم الشهداء","https://www.aldiwan.net/poem55366.html","الخفيف"],[365,"أوجست من جمر بخدك ساطع","https://www.aldiwan.net/poem60852.html","الكامل"],[365,"قلت للحاسد نما","https://www.aldiwan.net/poem60901.html","مجزوء الرمل"],[381,"قلب يحبك مولع","https://www.aldiwan.net/poem48747.html","مجزوء الكامل"],[403,"أهديت للأبصار والأسماع","https://www.aldiwan.net/poem46499.html","الكامل"],[403,"برح الشوق فواصل","https://www.aldiwan.net/poem46726.html","مجزوء الرمل"],[417,"يا ناجيا نحو كل مكرمة","https://www.aldiwan.net/poem54078.html","المنسرح"],[440,"قد عادت الشمس في أعلى مطالعها","https://www.aldiwan.net/poem34798.html","البسيط"],[444,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[454,"أمواكب الذكرى تأنى واهتفي","https://www.aldiwan.net/poem61691.html","الكامل"],[462,"لا ثل عرشكم بني أسد","https://www.aldiwan.net/poem15170.html","أحذ الكامل"],[462,"العز حيث البلدة الزوراء","https://www.aldiwan.net/poem16046.html","الكامل"],[465,"بقبرك فلتسحب ذيول السحائب","https://www.aldiwan.net/poem3210.html","عموديه"],[465,"سقى دمع العين لا دموع الغمائم","https://www.aldiwan.net/poem3271.html","عموديه"],[465,"حال في الحب عهده","https://www.aldiwan.net/poem3575.html","عموديه"],[480,"عارف ما الشعر صاغيه","https://www.aldiwan.net/poem37208.html","مجزوء الرمل"],[480,"قرنت قلوصك ربها بزميله","https://www.aldiwan.net/poem37580.html","الكامل"],[501,"هذه واسط أم ذا حلم","https://www.aldiwan.net/poem37790.html","الرمل"],[501,"رفع البدر علينا سجفا","https://www.aldiwan.net/poem37954.html","الرمل"],[506,"من تنادي","https://www.aldiwan.net/poem27891.html","المديد"],[506,"بلا أرواح","https://www.aldiwan.net/poem56763.html","الرمل"],[515,"أموا بنا نحو العقيق وأدلجوا","https://www.aldiwan.net/poem20813.html","الكامل"],[515,"أيها المصقع المهذب طبعا","https://www.aldiwan.net/poem20837.html","الخفيف"],[539,"دعنى من ذكر حداة الأينق","https://www.aldiwan.net/poem47549.html","عموديه"],[539,"حي فيها الإخلاص ولاإقداما","https://www.aldiwan.net/poem47934.html","عموديه"],[539,"أينما كنت كنت رمز الكمال","https://www.aldiwan.net/poem47986.html","عموديه"],[539,"طال مني لذا النهار ارتقابي","https://www.aldiwan.net/poem48296.html","عموديه"],[552,"بأبي زائرا أتاني جنحا","https://www.aldiwan.net/poem47172.html","الخفيف"],[559,"تب إلى الله من علوم الكلام","https://www.aldiwan.net/poem33868.html","الخفيف"],[559,"شمس وحي ظهرت في قمري","https://www.aldiwan.net/poem34473.html","الرمل"],[559,"هو كل شيء في الوجود الواحد","https://www.aldiwan.net/poem34584.html","الكامل"],[559,"إنما الدين كله تقليد","https://www.aldiwan.net/poem34595.html","الخفيف"],[559,"لي رتبة العلامة الشهم الأَسد","https://www.aldiwan.net/poem34635.html","الكامل"],[559,"تب منك حين تقول يا فتاح","https://www.aldiwan.net/poem34679.html","الكامل"],[559,"يا سقى الله لذة الموت لما","https://www.aldiwan.net/poem34935.html","الخفيف"],[576,"سلام عليه لا على الدهر بعده","https://www.aldiwan.net/poem3075.html","الطويل"]],"verses":[["هُوَ لا يُريدُ فِراقَها","خَوفَ القَوارِسِ والهَواجِر",0,"ر",1,0],["هَؤُلاءِ الصُدورُ أَدبرُ مِن دب","رٍ وَأَردى رَذالَةً وَأَخَسُّ",1,"س",1,0],["هُوَ لِلنَّاظِرِينَ نُورٌ مُبِينٌ","وَهُوَ لِلوَارِدِينَ مَاءٌ مَعِينُ",2,"ن",1,0],["هو للعلم خير فجر تجلَى","مستنيراً بأشهرِ الأوضاع",3,"ع",1,0],["هؤلاء الصِّيد قومي فانتسبْ","إن تجد أكرمَ من قومي رجالا",4,"ل",2,0],["هُوَ لِلحَقِّ إِلى أَن يَنجَلي","وَعَلى الباطِلِ حَتّى يُزهَقا",5,"ق",2,0],["هُوَ لِلأُلى يَدورونَ كُنهَ جَمالِهِ","فَإِذا مَضَوا فَكَأَنَهُ دُكّا",6,"ك",2,0],["هُوَ لِلدُجى يُلقي عَلَيهِ خُشوعَهُ","وَالصُبحُ يَسكُبُ وَهوَ يَضحَكُ نورُهُ",6,"ه",1,0],["هُوَ لِلرِياحِ تَهُزُّهُ وَتُثيرُهُ","وَالشُهبُ تَسمَعُ في الظَلامِ زَئيرَهُ",6,"ه",1,0],["هُوَ لِلحُسنِ مَشرِقٌ","فيهِ قَد تَظهَرُ الفِتَن",7,"ن",1,0],["هُوَ لِجَيش الطَير مِن فِكرَتي","صَقرٌ فَوَلّى وَهوَ مَقهورُ",8,"ر",1,0],["هو ليس غير وديعة","للشعب طراً في ترابك",9,"ك",1,0],["هول كين مصر رواية لا تنتهى","منها يد الكتاب والشراح",10,"ح",1,0],["هُوَ لَحنٌ مُضَيَّعٌ لا جَواباً","قَد عَرَفنا لَهُ وَلا مُستَقَرّا",11,"ر",2,0],["هُوَ لُطفُ اللَهِ لَو تَعلَمُهُ","رَحِمَ اللَهُ اِمرَءاً يَرحَمُهُ",12,"ه",1,0],["هُوَ لِلراغِبينَ عُمدَةُ آما","لٍ كَما البَيتُ لِلحَجيجِ مَثابَه",13,"ب",2,0],["هَولٌ جَميعُ الأَهوالِ تَرهَبُهُ","خَطبٌ جَميعُ القُلوبِ تَخشاهُ",14,"ا",2,0],["هُوَ لِلوَفِيِّ العَهدِ ظِلُّ أَراكَةٍ","وَلِمُضمِرِ الشَنَآنِ شَوكُ عِضاهِ",15,"ه",1,0],["هوَ للكرى وعنِ الذي","يهواهُ نافٍ نافرُ",16,"ر",1,0],["هؤلاءِ القومُ يا قومُ مَضَوا","ما تبقى منهمُ إلا الأقلْ",17,"ل",1,0],["هو لا يضنُّ بألفِ مص","رٍ في الفداءِ وألفِ نيلْ",18,"ل",1,0],["هُوَ لِلغَرابَةِ في الجَمالِ عَرابَةٌ","أَخَذَ المَحاسِنَ رايَةً بِيَمينِهِ",19,"ن",2,0],["هَوَّلَ عَوداً قَد نَخَر","فَبَينَ هاوٍ مُنحَدِر",20,"ر",1,0],["هو ليلٌ من الغياهبِ ضافي","وأديمٌ في لُجَّةِ الثلج طافي",21,"ف",2,1],["هُوَ لَيْلٌ جَلاَ الصَّفَاءُ بهِ","صُورَةً منَ رَائعِ الصُّوَرِ",22,"ر",1,1],["هُوَ لِلْعَفافِ مِنَ الدَّعَارَة مُوْئِلٌ","هُوَ لِلإِبَاءِ مِنَ المَهَانَة مَفْزَعُ",23,"ع",1,0],["هو للأَبناءِ عمٌّ وأبٌ","وهو للآباءِ خِلٌّ وخَدينْ",24,"ن",1,0],["هو ليلاي؛ فاعذروني إذا ما","أنا أصبحت في الهوى مجنونَه",25,"ن",2,0],["هو للصَّبَابَة معرض","هو للغَوانِي مُؤتمر",26,"ر",1,0],["هو للصبابةِ كلَّ عامٍ موسمٌ","هو معرضٌ للخُرَّدِ الأبكار",27,"ر",1,0],["هُوَ لَمْ يعترفْ بلفظِ «محال»","فَمَحَاهُ مِنْ معجم الكلمات",28,"ت",1,0],["هو لا يرتقي المنابر؛ لكنْ","فأسُه في الثَّرى تُجيدُ الخطابة",29,"ب",2,0],["هو لا يحيد عن الصوا","ب، ولا يحابي من رشاه",30,"ا",2,0],["هُوَ للرّاغبينَ عُدَةُ آمَا","لٍ كمَا البَيتُ للحَجيجِ مَثَابَهْ",31,"ب",2,0],["هؤلاء دود القزّ أحسن منهم","وأجلّ في نظر الحياة وأفهم !",32,"م",1,0],["هو للمصطفى وسيلتي العظ","مى وذخري لصدمة الإزماع",33,"ع",1,0],["هو لن يعيش ولن","يعيش بغير باطية الشراب",34,"ب",1,0],["هو لُها يُختَشَى وفِيهَا إشتِبَاهٌ","مُعقِبٌ في حِجَا الدِّليلِ غُمُومَا",35,"م",2,0],["هو للمسالم شهدةٌ","وعلى الأعادي كالهبيده",36,"د",2,0],["هو لا ينفكّ عَبداً قيّما","شدّدي في هجرهِ أو نفّسي",37,"ي",1,0],["هو للنبيّ مصاحبٌ ومعلّمُ","بِحياتهِ صلّوا عليه وسلّموا",38,"م",3,0],["هو للذة استنام","كمن ليس يشعر",39,"ر",1,0],["هوَ لِصٌّ أَسكَنتُهُ قَلبي","مَعَ أَنّي عَرَفتَه سالِب",40,"ب",1,0],["هو ليث يوم وغى وغيث في الندى","وغياث مزعوج الفؤاد مروع",41,"ع",1,0],["هو ليث مستأنس وعجيب","أن تري الأغلب الهزبر أنيسا",42,"س",2,0],["هؤلاءِ أعداءُ الوَرى وعميدُهم","تصريحهُ الإبهامُ والإيهام",43,"م",1,0],["هؤلاء ضمّيهم بلا أسفٍ إِلى","ما في ثراها من صَليبييك",44,"ك",1,0],["هو لَوْ لَمْ يأْخذْ نفوسَ البرايا","ضنَّ حتى بالنفحةِ السجواءِ",45,"ا",2,0],["هو للشاعرِ في جوف الدجى","سورةٌ أَوحى بها ربُّ الفلق",46,"ق",1,0],["هو لو لمْ يتخذْ زِيَّ (الذينْ)","عُدَّ من حزبِ (اللواتي) في الأَثيرِ",47,"ر",1,0],["هؤلاء الألى يضيقون بالنو","ر إذا كان عالي الفيضان",48,"ن",1,0],["هؤلاء الأُلى يموتون في اللي","ل فلا يحرمون من أكفاني",48,"ن",2,0],["هو للبؤس صورة","ومن شجون الأسى صور",49,"ر",1,0],["هؤلاء تعدهم في الضحايا","الالى بالخلود هم احرياء",50,"ا",2,0],["هولُجّةُ الكَرمِ الّذي مِن قَبلِه","كانوا أوائلَ مَوجِها المُتَدافع",51,"ع",1,0],["هو لم يُعزَلْ ولكنْ","عُزِلَتْ عنه الوِزاره",52,"ر",2,0],["هَول الفراق أَشد مِن","هَول الحَمام وَأَقطَع",53,"ع",1,0],["هو لا أشك الجوهر الفَرد الّذي","قُطعَ التراجعَ فيهِ بالإِجماعِ",54,"ع",1,0],["هُو لا شكَ لِما بي","من جوىً في القلب جَاهِلْ",55,"ل",1,0],["هو لساني يعوقُهُ ثِقَلٌ","وذاكَ عندي من أعظم النوب",56,"ب",1,0],["هَوْلٌ نَفى الجِنَّ عن أَخفى مَلاعِبِها","وأَوْحَشَ الوحشَ فِي أَقْصى مَرَاتِعِها",57,"ع",3,0],["هول أثار بها تشجى العيون","منظرا قد فرقت منه الوحوش",58,"ش",1,0],["هو للبرَّيةِ كلها إيمانُها","أَو ثارُها أيانَّ تطلب ثارا",59,"ر",2,0],["هو للعِدى نارٌ مُؤجَّجَةٌ","ولمُعْتفيه موردٌ شَبِمُ",60,"م",1,0],["هوْلٌ عليه من البسالةِ نَفْضَةٌ","وبه إلى حُبِّ العُلى بُرَحاءُ",61,"ا",2,0],["هو لصاحب المأمون خانك غادراً","فمن واثق من بعد ذاك بصاحب",62,"ب",1,0],["هو لابن بدور التمِّ والأنجم العلى","وسحب الغوادي والبحار الخضارم",63,"م",1,0],["هو لا شكَّ قا","تلي فلماذا أودّه",64,"د",2,0],["هؤلاء السادة العلماء","لا الذي تخفى فتاويه",65,"ي",2,0],["هو لي كنانة أسهم أعددتها","في كل سهم مصرع لقتيله",66,"ل",2,0],["هو لولا ذِكرُهُ ما حَسُنَتْ","رُبَّ ذِكرٍ فيه تَحلو الكَلِمُ",67,"م",1,0],["هو ليلٌ ما بهِ من طالِعٍ","هو بحرٌ ما لدَيهِ