{"poems":[[10,"لعمري وما عمري علي بهين","https://www.aldiwan.net/poem20942.html","عموديه"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125571","الكامل"],[147,"علي لها أن أحفظ العهد والودا","https://www.aldiwan.net/poem11743.html","الطويل"],[275,"هلا ثناك إلي قلب راض","https://www.aldiwan.net/poem35207.html","الكامل"],[534,"أقول من بعد حمد والصلاة على","https://www.aldiwan.net/poem37209.html","البسيط"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110335","الكامل"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45653","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202516","الطويل"],[3070,"","https://poetry.dctabudhabi.ae/diwan/poem/142706","الطويل"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110860","الوافر"],[3658,"","https://poetry.dctabudhabi.ae/diwan/poem/199149","المجتث"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127218","الكامل"],[5038,"صنعاء","https://www.poetsgate.com/ViewPoem.aspx?id=195221",""],[3558,"بدأنا بحمد الله فهو سناء","https://www.poetsgate.com/ViewPoem.aspx?id=43376",""],[5431,"مازلتَ تحبو بالشغاف معلّقا","https://www.poetsgate.com/ViewPoem.aspx?id=198124",""],[5937,"قهوةُ البلابِلْ","https://www.poetsgate.com/ViewPoem.aspx?id=211802",""],[4115,"وكان ثغر الأقحوان وقد غد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=607616",""]],"verses":[["وكانَ ثمالَ الحيِّ في كلِّ ازمة ٍ","وعِصْمَتَهُمْ والفارِسَ المُتَغَشِّمَا",0,"م",2,0],["وكأن ثغرك والنوَى تَعدُو بنا","شَفَقٌ يلوحُ على نضيدِ زنابقِ",1,"ق",1,0],["وَكانَ ثَوابُ المَدحِ فيهِم نَسيئَةً","تُناسى إِلى حينٍ فَعَجَّلَهُ نَقدا",2,"د",2,0],["وكأن ثغرَكِ في دياجي غربتي","برقٌ يشقُّ الليلَ بالإيماض",3,"ض",1,0],["وكانُ ثَبْتاً أمِيناً في رِوايَتِهِ","صَحِيحَ فَهْمٍ لِمَنْثورٍ ومَنْظومِ",4,"م",1,0],["وكأن ثغر الفجر ضح","ضح حين لاثمه ضياك",5,"ك",1,0],["وَكَأَنَّ ثَوب الجَو صَرح لائح","وَنُجومِهِ دُرٌّ عَلَيهِ تَرصع",6,"ع",1,0],["وكان ثميناً لو يصادف صيرفاً","ويُسألُ عنه قال أرخصُه الدرّ",7,"ر",1,0],["وكان ثمال جالساً بشَفيرِه","فشبَّهتُه بحراً لديه خليجُ",8,"ج",1,0],["وكان ثمار روضته جنيا","وكان مهذا للعلم حاوى",9,"ا",3,0],["وكان ثالث عشر","من صومنا ما دهاه",10,"ا",2,0],["وكان ثغر الأقحوان وقد غدا","غضا عقيب الأوطف الهطال",11,"ل",1,1],["وَكَأَنَّ ثالِثَةَ الْأَثافي خائِنٌ","فَتَجَمَّلي بِالصَّبْرِ يا صَنْعاءُ",12,"ا",2,0],["وكان ثنى يثني الثناء بسيبه","قنى ولديه في الحروب قناء",13,"ا",2,0],["وكأن ثغريَ كوثرٌ وحنينه","فاض ابتهالا جامحا متعشّقا",14,"ق",2,0],["وكأُنثى إذا مشَتْ ، ليس ندري","موتنا بالعيون أم بالخلاخِلْ !",15,"ل",1,0],["وكان ثغر الأقحوان وقد غد","غضا عقيب الأوطف الهطال",16,"ل",1,1]]}