.. عيناكِ","https://www.poetsgate.com/ViewPoem.aspx?id=175688",""],[5887,"رُغمَ الجراح الداميات بغزّةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=27996",""],[5953,"عاذلتي في الشيب لو تعلم ما","https://www.poetsgate.com/ViewPoem.aspx?id=93807",""],[5953,"يا سرّ مرَّى لقد أصبحت لي سكناً","https://www.poetsgate.com/ViewPoem.aspx?id=93789",""],[5974,"مواقد العشق","https://www.poetsgate.com/ViewPoem.aspx?id=200441",""],[6069,"هذا الفراق وأنت شاهده","https://www.poetsgate.com/ViewPoem.aspx?id=105661",""],[6093,"إلاَّا القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=178563",""],[6093,"وطن يقدسه الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=189390",""],[6102,"عُد ..","https://www.poetsgate.com/ViewPoem.aspx?id=184447",""],[6106,"إلى ربيع المولد النبوي","https://www.poetsgate.com/ViewPoem.aspx?id=6310",""],[6117,"طَيْبَةُ الطَّيِّبَة","https://www.poetsgate.com/ViewPoem.aspx?id=183710",""],[6142,"سل عنه سلعا لدن ضاق الخناق بها","https://www.poetsgate.com/ViewPoem.aspx?id=155715",""],[6145,"من نحن ؟","https://www.poetsgate.com/ViewPoem.aspx?id=7794",""],[5309,"في نظام مرصع الأصفاد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573552",""],[5724,"شريعة الله للاصلاح عنوان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55134&r=&rc=1",""],[6187,"آخر أنفاس الحب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82157&r=&rc=0",""],[6200,"غَابَةُ الأَطْفالِ وَ الحِجَارَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81373&r=&rc=15",""],[6212,"أميرة الماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1629&r=&rc=10",""],[6225,"إلى متى ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78030&r=&rc=115",""],[6225,"حلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80912&r=&rc=181",""],[6225,"تسرُّب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78037&r=&rc=122",""],[6308,"كفي ولونُ الجدائل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87725&r=&rc=3",""],[6314,"بكائية الليل الأخير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88067&r=&rc=2",""],[6318,"السهم الأخير وفتىًُ يفَجَّر نفسَهَّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66168&r=&rc=18",""],[6344,"رجع من شفة الصّمت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87978&r=&rc=18",""],[572,"ياريمُ كمْ أدنو وأنتَ ترِيمُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9467&r=&rc=324",""]],"verses":[["وَالمُستَجارُ إِذا تَصافَحَتِ القَنا","بِصُدورِها وَاِلتَفَّتِ الفِئَتانِ",0,"ن",1,0],["وَالمُستَجارُ بَعدَ ذا وَالمُلتَزَم","تَلقى بِهِ لِأُمَمٍ بَعدَ أُمَم",1,"م",1,0],["وَأَلمَسَتني وَقَد جَدَّ الوَداعُ بِنا","كَفّاً تُشيرُ بِقُضبانٍ مِنَ العَنَمِ",2,"م",1,0],["والْمُسْتَعِدّ لِمَا يُؤَمِّلُ ظَافِرٌ","وَكَفَاكَ شَاهِدُ قَيِّدُوا وَتَوَكَّلُوا",3,"ل",3,0],["وَالمُستَشارُ مُكاثِرٌ بِرِجالِهِ","وَمُعاجِزٌ وَمُناجِزٌ وَمُحَزِّبُ",4,"ب",1,0],["وَالمُسلِمونَ بِمَنظَرٍ وَبِمَسمَعٍ","لا جازِعٌ مِن ذا وَلا مُتَخَشِّعُ",5,"ع",1,0],["وَالمُسَبطِرُ اللاَحِبُ المُنَيّرُ","جاذَبنَ حَتَّى يَستَظِلَّ الأَعفَرُ",6,"ر",1,0],["والمسلمون بحالة من أجلها","تالله ضجّ بما حواه المُصحف",7,"ف",1,0],["وَالمُستَنيرَ أَجيرَ بَرزَةَ عائِذاً","أَمسى بِأَلأَمِ مَنزِلِ الأَحياءِ",8,"ا",2,0],["وَالمُستَقادُ لَهُم إِمّا مُطاوَعَةً","عَفواً وَإِمّا عَلى كُرهٍ إِذا عَزَموا",9,"م",3,0],["وَالمُسلِمونَ بِشاطِئِ اليَرموكِ لَم","ما أُحرِجوا عَطَفوا عَلى هامانِ",10,"ن",1,0],["والمستماحة في الندى آلافه","والواحد المربي على الآلاف",11,"ف",1,0],["والمستحق الزيّ لا","يعني الكريم بشأنه",12,"ن",2,0],["والمساحي تسوقه نحو مجرا","هُ فيا حسنه هناك مسوقا",13,"ق",2,0],["وَالمُستَمِرُّ بِهِ أَمرُ الجَميعِ فَما","يَغتَرُّهُ بَعدَ تَوكيدٍ لَهُ غَرَرُ",14,"ر",1,0],["وَالمُستَقِلُّ بِأَثقالِ العِراقِ وَقَد","كانَت لَهُ نِعمَةٌ فيهِم وَمُدَّخَرُ",14,"ر",1,0],["وَالمُستَقِلُّ بِأَمرٍ لا يَقومُ لَهُ","غُسٌّ مِنَ القَومِ رِعديدٌ وَلا فَرِقُ",15,"ق",1,0],["والمسلمون اليوم في حاجة","إلى آئتلاف كائتلاف الصحاب",16,"ب",1,0],["وَالمُسعِفونَ في غَدٍ","يُؤَلِّفونَ مَوكِبا",17,"ب",2,0],["وَالمُسَتضاءُ بِنورِهِ","في الخافِياتِ المُظلِماتِ",18,"ت",1,0],["وَالمُسلِمونَ عَلى اِختِلافِ دِيارِهِم","لا يَملُكونَ مَعَ المُصابِ عَزاءَ",19,"ا",2,0],["وَاِلمُس جِراحاتِ البَرِيَّةِ شافِياً","ما كُنتَ إِلّا لِلمَسيحِ بَنانا",20,"ن",2,0],["وَالمُستَشارُ إِلى الفَظائِعِ ناظِرٌ","تَدمى جُلودٌ حَولَهُ وَعِظامُ",21,"م",1,0],["وَالمُسَمَّونَ بِالأَميرِ كَثيرٌ","وَالأَميرُ الَّذي بِها المَأمولُ",22,"ل",1,0],["والمُستعانُ على الزمان إِذا اعتَرى","وأجدَّ حربا",23,"ب",2,0],["وَالمُسْتَبِدِّ بِعَزْمِهِ","كالسَّيْفِ عِنْدَ مَضَائِهِ",24,"ا",3,0],["وَالمِسكُ يُخزَنُ في الوِعاءِ وَنَشرُه","أَبَداً بِأَفنِيَةِ المَنازِلِ يَعبَقُ",25,"ق",1,0],["وَالمُستَغيثِ بِهِ العِبادُ وَمَن بِهِ","يَحمي الذِمارَ وَجودَةَ الجيرانِ",26,"ن",1,0],["والمسلمونَ بذاكَ قد فرحوا وقد","حمدوا عليهِ الواحدَ القدُّوسا",27,"س",2,0],["والمُسْمعِ الدهرَ، والدنيا، وساكنَها","قرْعَ النواقيسِ في عيدِ الشعانين",28,"ن",1,0],["وألمِسُ الجُدُرَ الدَكناءَ تخبرني","أنْ لستُ في مَهْمَهٍ بالغِيل مسكون",28,"ن",1,0],["وَالمَسجِدِ الأَقصى المُبارَكِ حَولَهُ","وَالطَورِ حِلفَةَ صادِقٍ لَم يَأثَمِ",29,"م",1,0],["والمُسلِمونَ بنعمةٍ من ربِّهمْ","فيها لِكُلِّ مُوَحِّدٍ مُسْتَمتَعُ",30,"ع",1,0],["وَالمَسوا بِاليدين صَرحاً مَنيعاً","شادَ أَركانه بِعَزم وَطيدِ",31,"د",1,0],["وَالمُسلِمونَ مِنهُمُ بَراءُ","رافِضَةٌ وَدينُهُم هَباءُ",32,"ا",2,0],["والمِسكُ يَعبَقُ في البُرُودِ كأنّها","زَهُر الرّبيعِ مُفَوَّفُ الألوانِ",33,"ن",1,0],["والمسكُ ما لَثَمَ الثرى من ذكرهِ","لا أنّ كلّ قرارةٍ دارين",34,"ن",1,0],["والمُستظِلُّ سماؤهُ من عِثْيَرٍ","فيها الكواكبُ لَهْذمٌ وغِرار",35,"ر",1,0],["والمسلمون تراهم","بكل أرض كسالى",36,"ل",2,0],["وَالمساواة قوضت","كل مجد مشيد",37,"د",1,0],["والمُسْمِعَاتِ لَدَى الشُّرُوبِ كَأَنَّهَا","أَدْمُ الظِّبَاءِ نَوَاعِمُ الأَبْشَاره",38,"ر",2,0],["والمسعد الأيكات منه بملهم","كانت به الجنات قبل شحاحا",39,"ح",2,0],["وَالمُسْتَحَبَّ سَمَاعُهُ وَلِقَاؤُهُ","فِي عَالَمٍ أَبْدَعْتَهُ تَخْيِيلاَ",40,"ل",2,0],["وَالمُسلِمونَ بِحُبِّ آلِ نَبِيِّها","يُرمَونَ في الآفاقِ بِالنيرانِ",41,"ن",1,0],["والمساعي التي تَجَشَّمْتَ فيها","ألفَ هولٍ وألْفَ أمرٍ مُخيف",42,"ف",1,0],["والمُسمَلات عُيونُهم ، وكأنهم","بطيُوف شخصك يكحلون مراودا",43,"د",2,0],["والمستبيحِ عُصارةً من ذهنِهِ","يغذو الألوفَ بها ، ويُحسبُ واحدا",43,"د",2,0],["والمستجيرَ بظلِّها من ظلِّها","تتخيرُ التحويرَ والتحويلا",44,"ل",2,0],["والمسجدُ المحزونُ يُلقي فوقَه","ليلاً – على الشرقِ الحزينِ – طويلا",44,"ل",2,0],["والمسجدُ الأقصى كأنْ لم يرتفعْ","فيهِ أذانٌ بُكرةً وأصيلا",44,"ل",2,0],["والمسمعات لدى الشُّروب كأنَّها","أدم الظِّباء نواعم الأبشار",45,"ر",1,0],["والمسكِ في أبشارهنّ الشامل","والعنبرِ المنشور كالقساطل",46,"ل",1,0],["والمِسك صِرْفاً كدم الأباجلِ","قاتلهُنّ اللهُ من قواتِل",46,"ل",1,0],["والمستضاءَ بنوره","في الغربِ مُغْتَربُ الرُّفات",47,"ت",1,0],["وَالمسك في الحَمل العُلوي إِذا رَتَعَت","غَزالة الأُفق وَالكافور سيان",48,"ن",1,0],["والمسلمين تولهم بعناية","عنهم ترد الضد وهو خذيل",49,"ل",1,0],["والمُسْلِمُ العَرَبِيُّ شَخْصٌ مُجْرِمٌ","أفكارُهُ الإجرامُ والإرهابُ",50,"ب",1,0],["والمسك حيث يفوح نشره عبقاً","كأنه نفسها والنفس تعتبق",51,"ق",1,0],["والمستحيل لها يُتاح","واذا انتهى بتُّ الأمورُ",52,"ر",1,0],["والمسلِمُونَ أصبَحُوا خُنَّفاً","عَن مَنهَجِ المُبتَدِعِ الخَانِفِ",53,"ف",1,0],["والمسلمون بخير ما بَقِيتَ لهم","فَثَبَّتَ اللهُ ذَاك الخَيرَ تَثبِيتَا",54,"ت",2,0],["وَالمُسلِمونَ بِخَيرٍ ما سَلِمتَ لَهُم","يُرجى وَيُخشى لَدَيكَ النَفعُ وَالضَرَرُ",55,"ر",1,0],["وَالمِسكُ أَوَّلُ مَن يَفوزُ بِعَرفِهِ","في وَقتِ فَضِّ خِتامِهِ عَطّارُهُ",56,"ر",2,0],["والمس لمهوى أحمد طاعة","يرضى بها المسلم والمسلمه",57,"م",2,0],["والمِسْكِ نَشْرا والأَقاحِ تَبسُّما","والخمرِ ريقا والشَّقيقِ خدودا",58,"د",2,0],["وألمس نيران الجحيم إذا مضت","تروم بعين الجد بعدى وإقصائي",59,"ي",1,0],["وَالمَساءُ الوَلهانُ يُصغي","لِهَمَساتِ أَنجُمِه",60,"ه",1,0],["وَالمَسا يَنشُرُ الظِلالَ عَلى الدُ","نيا وَيُلقي عَلى النُفوسِ الثَوابا",61,"ب",2,0],["والمسكُ والزنجبيلُ عُلَّ به","أنيابُها بعد غفلَةِ الرَّصَدِ",62,"د",1,0],["والمستهام عن المودة لم يحل","حاشا لذراه من النسيان",63,"ن",1,0],["وَالمُستَضيءُ هِلالُ لَي","لَيلَتِها وَشَمسُ ضَحائِها",64,"ا",3,0],["وَالمُستَعيدونَ لِلطارِقينَ","وَاللَيلُ جانِح",65,"ح",1,0],["وَالمَسجِدُ البيتُ الحَرامِ فَأَنتُمُ","جيرانُهُ وَقَديمُكُم ساداتُهُ",66,"ت",2,0],["وَالمُستَعانَ بِهِ عَلى","دَفعِ الشَدائِدِ وَالنَوائِب",67,"ب",1,0],["وَالْمِسْكَ مَنْ لَيْسَ مُزْكُوماً وَقَدْ سَطَعَتْ","مِنْهُ الْفَوَاغِمُ تَشْفِي كُلَّ مَصْدُورِ",68,"ر",1,0],["وَالْمُسْبِلِينَ عَلَى الْمُزِيلِ","سَحَابَ بِرٍّ ذَا انْسِجَامِ",69,"م",1,0],["والمسلمون جميعهم في شاغل","من سفسفات أو عقيم لجاج",70,"ج",1,0],["والمسلمون أكفهم مرفوعة","ودموعهم في المحجرين تسيل",71,"ل",1,0],["والمسهب اللسن البليغ فصاحة","سحبت على سحبان ذيلا معلماً",72,"م",2,0],["والمستحيل منال غايه سابق","من اعرج يمشي على عكاز",73,"ز",1,0],["والمسجدُ الأقصى إلى حسناتِها","يصبو وهذا العهدُ عهدُ بخيل",74,"ل",1,0],["وَالمسك تذريه أَرواح النَسيم وَفي","خَمائل الشعب تَغريد وألحان",75,"ن",1,0],["والمِسْكُ لَوْنِي إليْهِ يُعْزَى","وَحَبَّذَا العِطْرُ للْعَرُوسِ",76,"س",1,0],["وَالمُسلِمونَ بِيُمنِ غُرَّتِهِ وَجو","دِ يَمينِهِ وَصَلوا إِلى ما أَمَّلوا",77,"ل",3,0],["والمسجد المبارك","قد أرخوا بناه",78,"ا",2,0],["والمُستعينُ له المُعتَزُّ مُرتَدفٌ","والمُهتدي بالإلهِ المُرتَضَى سِيَرا",79,"ر",2,0],["والمُستعانُ على العَلاء بجاهه","والمُستثابُ فلا يَزالُ مُثيبا",80,"ب",2,0],["والمسلمين الأجانب","وكن سليم الطويه",81,"ه",1,0],["وَالمُسرعين إِلى المَكارِمِ كُلَّما","وَجَدوا إِلى إِتيانِهِنَّ سَبيلا",82,"ل",2,0],["والمسعدون من الغرام بمعزل","عني فهل من مسعدٍ ومعين",83,"ن",1,0],["والمسرات تبدت","بالأماني تستمر",84,"ر",1,0],["والمساعِي التي تَرُدُّ إِليها","قَصَبَ السَّبْقِ في ارْتِقَاءِ المعالي",85,"ل",2,0],["والمِسْكُ فيه طِيبُه لكنه","يحتاجُ عوناً من يديْ جرّاحه",86,"ح",2,0],["وَالمُسْلِمونَ مُقَسَّمونَ تَنالُهُمْ","أَيْدِي العُصاةِ بِذِلَّةٍ وَهَوانِ",87,"ن",1,0],["وَالمَسْجِدُ المَعْمُورُ جامِعُ عُقْبَةٍ","خَرِبُ المعاطِنِ مُظْلِمُ الأَرْكانِ",87,"ن",1,0],["والمُسْتَهِلُّ عَلَى العُفَاةِ بِراحَةٍ","وَسِعَ الهُدى والمُلْكَ ظِلُّ رِواقِها",88,"ق",3,0],["وَالمُسْتَطارِ لسَيْفِهِ فِرَقُ العِدى","فَرَقاً فكانَ هُوَ السَّنا وَهُمُ الْهَبا",89,"ب",2,0],["والمسلمون هم الكماة حمية","الثائرون على العتي وناله",90,"ل",2,0],["والمسيح اليوم 