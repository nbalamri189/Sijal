{"poems":[[53,"أيها المتحفي بحول وعور","https://www.aldiwan.net/poem66402.html","الخفيف"],[80,"أمعتضدا بالله دعوة آمل","https://www.aldiwan.net/poem14066.html","الطويل"],[107,"لمن الرواسم يرتمين صواديا","https://www.aldiwan.net/poem43382.html","الكامل"],[108,"الذئب","https://www.poetsgate.com/ViewPoem.aspx?id=179565",""],[53,"أحسنَ ما كان الدقيقُ مَوقعا","https://www.poetsgate.com/ViewPoem.aspx?id=29501",""],[203,"عرش بطول مدار السبعة الشهب","https://www.aldiwan.net/poem45349.html","البسيط"],[408,"إفزع إلى الباري وكن","https://www.aldiwan.net/poem46995.html","مجزوء الكامل"],[1269,"","https://poetry.dctabudhabi.ae/diwan/poem/122892","السريع"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100965","الخفيف"],[2405,"","https://poetry.dctabudhabi.ae/diwan/poem/27112","الطويل"],[3293,"","https://poetry.dctabudhabi.ae/diwan/poem/146467","الكامل"],[3715,"","https://poetry.dctabudhabi.ae/diwan/poem/17486","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111405","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111508","المتقارب"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105184","الخفيف"],[4984,"لله تلك السوق","https://www.poetsgate.com/ViewPoem.aspx?id=215829",""],[5041,"إنَّما العارُ أنْ يَهونَ السِّلاحُ","https://www.poetsgate.com/ViewPoem.aspx?id=24394",""],[5364,"المرجلة ماهي ب خواريف واوهام","https://www.poetsgate.com/ViewPoem.aspx?id=177124",""],[5732,"ان دك به هاجوس","https://www.poetsgate.com/ViewPoem.aspx?id=177916",""],[5829,"حوار مع زائر الليل","https://www.poetsgate.com/ViewPoem.aspx?id=178324",""],[5831,"بيت جالا","https://www.poetsgate.com/ViewPoem.aspx?id=20387",""],[5956,"قصة‎ ‎اللص والبَصَل","https://www.poetsgate.com/ViewPoem.aspx?id=184623",""],[5975,"في ولاء آل بيت الرسول1","https://www.poetsgate.com/ViewPoem.aspx?id=53466",""],[6008,"احترتُ بالحاير","https://www.poetsgate.com/ViewPoem.aspx?id=59158",""]],"verses":[["أفَزُورُ الحديثِ تقبلُ أم ما","قاله ذو الجلال والفرقان",0,"ن",1,0],["أَفُز بِالَّذي أَمَّلتُ مُذ كُنتُ آمِلاً","وَتَحتَلّ مِن عَلياهُ في المَنزِل الرَحبِ",1,"ب",1,0],["أَفزَعتُ أَصحابَ الرَقيمِ مُنادِياً","وَعَصَفتُ بِالعَظمِ الرَميمِ مُناجِيا",2,"ي",2,0],["أفزَعَ المرءُ كلَّ شاءٍ وإبْل","وأخافَ الطيور في الأوكار",3,"ر",1,0],["أفزعني الدهر فكن لي مفزعا","فكم تسمَّحت وكم تمنَّعا",4,"ع",2,0],["أفزرتَ مصرَ على ريحٍ تكفؤها","كبَّ السفينةِ في التيارِ والعببِ",5,"ب",1,0],["إفزعْ إلى الباري وكُنْ","مما جَنَيتَ على وجَلْ",6,"ل",1,1],["افزع اليه في ازدحام الجوى","ففيه مسلاة وتسهيلُ",7,"ل",1,0],["أفزعتهنّ حادثاتُ الليالي","في بنيهنّ بالرَّدى رامياتِ",8,"ت",1,0],["أَفَزَّ نَساً مِن بَعدِ ساقٍ أَتَرَّها","لُعابُ الفَرَندِ الخالِصِ المُتَنَخَّلِ",9,"ل",1,0],["أفزلة سبقت له أم خلة","مألوفة من تيهه ودلاله",10,"ل",2,0],["أَفزَعتُ مِنهُ وُحوشاً وَهيَ ساكِنَةٌ","كَأَنَّها نَعَمٌ في الصُبحِ مَشلولُ",11,"ل",1,0],["أَفِز جَيشَ طُروَادا لِيَعظُمَ قَدرُهُ","ويُنزِلَهُ الإِغرِيقُ أَسمى المنازِلِ",12,"ل",1,0],["أفز ناجياً لا فماذا الصواب","ولا لا علام أنا بارتياب",13,"ب",1,0],["أفزعته الوشاة عني فأمسى","ما نعي وصله وحقي أضاعا",14,"ع",2,0],["أفزعني السعر ويا حاجة","زاد بها الخطب على الخطب",15,"ب",1,0],["أَفْزَعَتْنا بِنَوْحِها، فَخَجِلْنا","ومضينا، وَجُبْنُنا فَوَّاحُ",16,"ح",1,0],["افزع لهم وابشربنا درع وحزام","على العهد والله ما يوم خّنا",17,"ن",2,0],["افزع لمفجوع على البعد ناداك","والياس روحه بالضماير حشكها",18,"ك",3,0],["أفزعتني هل تستحي","ام لا يدانيك الخجل",19,"ل",1,0],["أفزعوا الأطفالَ ليلا","خلّفوا فيها ثكالى",20,"ل",2,0],["أفزعَتْني زوجتي قالت كلاماً","كلُّهُ رعبٌ: حرامي قد أقاما",21,"م",2,0],["أفزْ .. وأكرَمْ .. في نعيمٍ وراحةٍ","وأرْقَ وتصفُ الروحُ ,, ألْقَ به الصحْبا",22,"ب",2,0],["افزع لنا بشورًوفكرآ وتدبير","يفداك عفنآ ضاريآ للنمايم",23,"م",1,0]]}