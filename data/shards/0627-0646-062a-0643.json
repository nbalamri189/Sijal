 عَلِمتَ مُضْطرِبُ الهي","ئةِ وَالقَدّ، ظاهرُ الجَلَفِ",125,"ف",1,0],["إنْ تُكْفَرُوا لا تَنْقُصُوا، أوْ تُشكَرُوا","فالنّجْمُ مَا لخطتْهُ عَينُ النّاظِرِ",126,"ر",1,0],["أنت كالبردة الموشّاة أبلى الطّي","والنّشر ما بها من رواء",127,"ا",2,0],["أنت كاللّيث فلّم الدّهر ظفريه","وأحنى عليه طول الثّواء",127,"ا",2,0],["إنْ تَكُ تَبخَلْ يا ابنَ عَمروٍ وَتَعتَللْ","فَإنّ ابنَ عَبْدِ الله حَمْزَةَ فَاعِلُ",128,"ل",1,1],["إنْ تَكُ كَلْباً مِنْ كُلَيْبٍ، فإنّني","مِنَ الدّراِمِيّينَ الطّوَالِ الشّقاشِقِ",129,"ق",1,1],["أنت كاللص قاحم للقصور","هاتك في جرأة للستور",130,"ر",1,0],["إنْ تَكُنْ بِکلصَّفاءِ، يا صاحِ، هَمَّتْ،","فَلَقَدْ عَنَّتِ الفُؤَادَ سِنينا",131,"ن",2,0],["ان تكن عن ابصارنا غبت شخصا","فبمعناك قط ما غبت عنا",132,"ن",2,0],["أنت كالذئب خدن غدر ولؤم","ليس للذئب في الورى من وفاء",133,"ا",2,0],["إن تكذب الأنساب أصحابها","فصادق الأعمال لن يكذبا",134,"ب",2,0],["أن تكونوا في همةٍ لشراه","فهلموا وأظهروا لي المَرَامَا",135,"م",2,0],["أنتَ كُفْءٌ لها فاجزلْ لها الإحس","انَ عفواً جاءتك تَبْغى النوَالا",136,"ل",2,0],["إن تكنْ ذا عقلٍ وحلمٍ رزين","لا تفتش يا صاحِ ما في الضميرِ",137,"ر",1,0],["إِن تَكُن لاَحِناً فَلَستَ مَلُوماً","لَستَ في كُلِّ مَايِشِينُ مَلُومَا",138,"م",2,0],["إِن تَكُن عَظَّمَتكَ يَوماً إِمَاءٌ","وَدَجَاجِيلُ إِذ قَدِمتَ قُدومَا",139,"م",2,0],["إن تَكُن كُلَّمَا مَررتَ بِدُورٍ","قَد حَوَينَ الرَّبَابَ دَهراً قَدِيمَا",140,"م",2,0],["أَنتَ كَلَّفتَها اِدِّراعَ الدَياجي","حَيثُ لَم يَحمِ مِن سُطاكَ اللامُ",141,"م",1,0],["إِن تَكُن أَسلافُ قَومي تَوَلّوا","فَلَقَد أَبقَوا أُناساً خُلوفا",142,"ف",2,0],["إنْ تكنْ أَعيُنُ المَها أنكرتْنِي","فلَعَمْرِي لقد أَصَبْن نكيرا",143,"ر",2,0],["إِن تَكُن عارفاً فبادِر إليها","تَلقَ فيها ما شئتَ دُنيا وَدينا",144,"ن",2,0],["إن تكن غبتَ فإنَّ","البدرُ قد طالَ مغيبهْ",145,"ب",2,0],["أنتَ كالبدرِ غيرَ أنكَ ممحو","قٌ وكالشمسِ أوشكتْ ان تغيبا",146,"ب",2,0],["إن تكنْ تصغرُ المصئبُ فالنف","سُ ترى فيكم المصائبُ كُبرى",147,"ر",2,0],["أنتَ كالبدرِ حين يطلعُ لكنْ","في سوادِ القلوبِ والمقلتينِ",148,"ن",1,0],["إن تكن راعي المحاسن فينا",