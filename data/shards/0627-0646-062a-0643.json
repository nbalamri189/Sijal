75,"ي",1,0],["إن تُكسِبِ الألقابَ من يُدعى بها","شرفاً فقد شّرفتمُ الألقابا",176,"ب",2,0],["إِن تَكن لِلغنى عَبداً فَإِنّي","أَنا في الحُبّ عَبد عَبد الغَنيِّ",177,"ي",1,0],["إن تَكُونِي تَرَكْتِ رَبْعَكِ بالشَّأ","مِ وجاوَزْتِ حِمْيراً ومُرادا",178,"د",2,0],["إِن تَكُن هَذي ذُنوبي","في الهَوى فَهِيَ عِظام",179,"م",1,0],["إِن تَكُن هانَت عَلى متلفها","فَلَقَد عَزَّ دَواها وَعَزاها",180,"ا",3,0],["إن تكونوا حماتها وبنيها","ما لتلك الذئبا تعتس فيها",181,"ي",3,1],["أنتَ كالشمسِ إذا ما غَربَت","أهدتِ البَدرَ ضياءَ المُدلجين",182,"ن",1,0],["أنت كشاف البحث إن دقَّ معنا","ه ومفتاحه إذا الباب موصد",183,"د",1,0],["إِن تَكُن هاجِري فَذاكَ لِذَنبٍ","كان مِنّي فَإِنَّني مُستَقيلُ",184,"ل",1,0],["أنتَ كالتَّنُّور يَصلى النْ","نَارَ في نفعِ سِواهُ",185,"ا",2,0],["إن تكُن ما رَأَيْتَ مَن جَمَع الإح","سانَ والحُسنَ في المِلاحِ فكُنْهُ",186,"ن",2,0],["أنتَ كالصّائِم الذي يَشتهي الما","ءَ لِفرطِ الظَّما ويكرُهُ فِطْرا",187,"ر",2,0],["أَنْتَ كهذا الظلّ في فضله","وجودُ هذا الغيث في نيله",188,"ل",2,0],["إنْ تكنْ عيناك أنكرنَ دمي","فبه خدّاك عمداً قد أقرّا",189,"ر",2,0],["أنت كالدُّنيا إذا ما أقبلَتْ","لامرئٍ والدهر إعراضاً وصَدَّا",190,"د",2,0],["أَنتَ كالماءِ غَيْرَ أَنْ لَسْتَ تَصْفُو","وقبيحٌ بالماءِ تَرْكُ الصَّفَاءِ",191,"ا",2,0],["أَنْتَ كاسٍ من المَحَامِدِ والصِّحّ","ة عارٍ من الصنا والعارِ",192,"ر",1,0],["إن تكن شاكرا تجازى وإن تك","فر ستلقى سلاسلا وسعيرا",193,"ر",2,0],["إن تكن تجهل ما الحب وما","يفعل البين بذي الحب فسلني",194,"ن",2,0],["ان تكن شمسها قد احتجبت فال","نور فيها كالبرق في الايماض",195,"ض",1,0],["إن تكرموني فقد أنصفتمو أمماً","عانت وضَّحت وما زالت بأرسان",196,"ن",1,0],["أنتَ كما كنتَ أخاً مُخالِلاً","بحيثُ قد زدتَ فصرتَ سيّدا",197,"د",2,0],["إن تكن أنكرت حِفظي","لك وأرتبتَ بحُبيّ",198,"ب",2,0],["إن تك سِحْرا أو لها فعلهُ","فالسحر يشفِي منه طِبُّ الرُّقَى",199,"ا",1,0],["أنت كالسمهري هزَّ بكفي با","ترٍ والحسام سلَّ فشلاً",200,"ل",2,0],["إنْ تَكُنْ قد وقفتَ مُرتَبكاً","فالنَّبيُّون هَهُنا وَقَفوا",201,"ف",3,0],["إِن تكنْ في البحرِ من هِمَّتِهِ","تُلْفِ بينَ الموجِ منها مَدَدَا",202,"د",2,0],["أنتَ كتابُ اللهِ في قلبِ مَنْ","قد قادَهُ الحظُّ إلى ربِّهِ",203,"ه",1,0],["إِن تَكُونُوا قَتَلتُمُ النَّفَرَ البِي","ضَ وَغَالَت أُولئكَ الآجَالُ",204,"ل",1,0],["إن تكن كالثُغورِ في الرَوعِ تبدو","فلهنّ الجُسومُ كالأشْداقِ",205,"ق",1,0],["إنْ تَكُنْ في الغَرامِ مِثْلي فإنِّي","رُبَّما بِتُّ سَاهِراً كالسَّلِيمِ",206,"م",1,0],["إن تَكوني أنتِ الإرادةُ حَقّاً","وقِوَى الكَونِ مِنكِ مِلكُ يَمِينِ",207,"ن",1,0],["أنتَ كالشَّمسِ كلُّ طَرفٍ رآها ار","تَدَّ عن ضَوئها كَليلاً حَسيرا",208,"ر",2,0],["أنتَ كالغيثِ والسُّرورِ نباتٌ","وَكفَى بالسُّرور غِبَّ عِهَادِ",209,"د",1,0],["إنْ تكنْ عُوجِلَتْ فما مُهلةُ المُر","جى على سُنّةِ الرّدى بأمانِ",210,"ن",1,0],["إنْ تكن مجرماً ولستَ فقد وا","ليتَ قوماً تحمّلوا الأجراما",211,"م",2,0],["إنْ تكن جاهلاً بحُبِّي فخذ عِلْ","ماً بُحبّي من دمعِيَ المذروفِ",212,"ف",1,0],["إن تكن فانياً فقل هو لا","غيره في كتابه المكنونْ",213,"ن",1,0],["أنت كلمتني بأحرف ذاتي","وأجبت الكلام بي لك عني",214,"ن",2,0],["إن تكن آمنت بالله كما","هو في التنزيه عما ههنا",215,"ن",2,0],["إن تكن قد مضت لأحمد صحبٌ","إننا لم نزل له إخوانا",216,"ن",2,0],["إن تكن مؤمناً بربك أسلمْ","لعلوم المهيمن العلام",217,"م",1,0],["أنت كلي أنت بعضي","أنت نومي والهجوع",218,"ع",1,0],["إن تكن كنت أمره وإذا","لم تكن فهو ما له حصر",219,"ر",1,0],["إن تكن عارفاً عذرتَ قصوراً","في كلامي ولم تقل باحتجاج",220,"ج",1,0],["إن تكن قد أعبت ما أنا فيه","ثم أصبحت منكراً مشروبي",221,"ب",2,0],["إن تكونوا في السوء أهل اجتهاد","أهله بين مخطئٍ ومصيب",222,"ب",1,0],["إن تكنْ مِن مؤرِّخيهِ فحرِّرْ","صارَ سعدُ السُّعودِ سَعدَ الخَبايا",223,"ي",2,0],["إن تكنْ كلُّ دولةٍ بيتَ شعرٍ","فهْيَ حرفُ الرَّوِيِّ مِن كلِّ شعرِ",224,"ر",1,0],["إن تكن نمتَ نومةَ الدهرِ فالنو","مُ علينا قد حرَّمتهُ الجُفُونُ",225,"ن",1,0],["إِنْ تَكُ ذَا عِلْمٍ فَمَنْ ذَا الَّذِي","مِثْلَ الَّذِي تَعْلَمُ لَمْ يَعْلَمِ",226,"م",1,0],["إن تَكُوني ذممت كَرَّ نُحُوسي","فلقد طَالَ ما حَمِدْتِ سُعُودي",227,"د",2,0],["إِن تَكُ حَربٌ فَلَم أَجنِها","جَنَتها خِيارُهُمُ أَو هُمُ",228,"م",1,1],["إِن تَكُنْ عَيْنٌ له عُورةٌ","فهو منها الدَّهرَ ليس يَرى",229,"ر",2,0],["إِن تكن عذَّبَتْكَ بالحُسْنِ شَرٌّ","إِنَّ مَحبُوبَتي وَحقِّكَ خيْرُ",230,"ر",1,0],["إِن تكلمتُ شاكياً قال قَد أَض","جَرني أَو سكتُّ قال تسلَّى",231,"ل",2,0],["أَنت كالشمسِ ولكن","دَهرُك الظُهْرُ زوالا",232,"ل",2,0]]}