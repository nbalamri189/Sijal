ي حرم الشدو","https://www.aldiwan.net/poem55025.html","مجزوء الرمل"],[329,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[329,"خطرت كالنسمة السكرى","https://www.aldiwan.net/poem55050.html","مجزوء الرمل"],[341,"يا من نأت بهم الديار فأصبحوا","https://www.aldiwan.net/poem11560.html","الكامل"],[354,"يا غنيا بالحسن إني فقير","https://www.aldiwan.net/poem39577.html","الخفيف"],[369,"قل لأسماء أنجزي الميعادا","https://www.aldiwan.net/poem1869.html","الخفيف"],[381,"أحريق أم غرام","https://www.aldiwan.net/poem48801.html","مجزوء الرمل"],[381,"من لنفس طال في الحب عناها","https://www.aldiwan.net/poem49195.html","الرمل"],[398,"إن تكونوا حماتها وبنيها","https://www.aldiwan.net/poem10977.html","عموديه"],[401,"شموخ الصابري","https://www.aldiwan.net/poem6716.html","عموديه"],[404,"غصن شوق علاه قلبي وغرد","https://www.aldiwan.net/poem33977.html","الخفيف"],[407,"لج في حب من هويت العذول","https://www.aldiwan.net/poem50134.html","الخفيف"],[410,"أيها المغرور مهلا","https://www.aldiwan.net/poem31868.html","مجزوء الرمل"],[410,"يا هلالا إذا تبدى يراه","https://www.aldiwan.net/poem32519.html","الخفيف"],[410,"من عذيري من شادن لم أطق عن","https://www.aldiwan.net/poem32582.html","الخفيف"],[417,"يا سيد السادات من هاشم","https://www.aldiwan.net/poem53871.html","السريع"],[417,"ما لها تطوي فيافي الأرض سيرا","https://www.aldiwan.net/poem53994.html","الرمل"],[417,"سعدت نجد إذا وافيت نجدا","https://www.aldiwan.net/poem54161.html","الرمل"],[433,"يا علي الذي دعوه عليا","https://www.aldiwan.net/poem12320.html","الخفيف"],[433,"سفرت عنك أوجه الأسفار","https://www.aldiwan.net/poem12416.html","الخفيف"],[438,"إن دمعا طلعا وقلبا أسيرا","https://www.aldiwan.net/poem2527.html","الخفيف"],[438,"صلت بالهجر فبالرحمن صلني","https://www.aldiwan.net/poem2541.html","الرمل"],[444,"زرت لندن ربة المدن والشمس","https://www.aldiwan.net/poem55989.html","عموديه"],[454,"لم يحصر الفن فن ذهن وانان","https://www.aldiwan.net/poem61805.html","البسيط"],[459,"صدت بنعمان على طول الصدى","https://www.aldiwan.net/poem56213.html","الرجز"],[459,"أيها العاتب ما ذا","https://www.aldiwan.net/poem56308.html","مجزوء الرمل"],[459,"يا عينِ لو أغضيتِ يوم النوى","https://www.aldiwan.net/poem56312.html","السريع"],[465,"جزت حد المديح قولاً وفعلا","https://www.aldiwan.net/poem3134.html","عموديه"],[466,"في رحاب النجف الأشرف","https://www.aldiwan.net/poem61432.html","عموديه"],[501,"وحد الله ولا تشرك به","https://www.aldiwan.net/poem38033.html","الرمل"],[501,"يا قلب كل الكائنات الذي","https://www.aldiwan.net/poem38089.html","السريع"],[504,"قد دنا الفصل في الصباح وللسل","https://www.aldiwan.net/poem21742.html","الخفيف"],[515,"غربت منكم شموس التلاقي","https://www.aldiwan.net/poem20786.html","الخفيف"],[530,"شيخنا دمت في النعيم المقيم","https://www.aldiwan.net/poem37160.html","الخفيف"],[539,"قلت يوما لها وكنت حياتي","https://www.aldiwan.net/poem47923.html","عموديه"],[539,"هل أريك النجوم صارت بدورا","https://www.aldiwan.net/poem48187.html","عموديه"],[539,"كيف يمتاز من جلالك يوم","https://www.aldiwan.net/poem48237.html","عموديه"],[552,"فجعة ما احتسبتها في زماني","https://www.aldiwan.net/poem47168.html","الخفيف"],[552,"من على هذه الديار أقاما","https://www.aldiwan.net/poem47232.html","الخفيف"],[552,"قل لخل له وإن كان لا يد","https://www.aldiwan.net/poem47384.html","الخفيف"],[559,"إنني كن وإنني فيكون","https://www.aldiwan.net/poem33740.html","الخفيف"],[559,"يا نديمي إن غابت الناس عني","https://www.aldiwan.net/poem33759.html","الخفيف"],[559,"أيها الشخص الذي قال أنا","https://www.aldiwan.net/poem33808.html","الرمل"],[559,"نحن قوم نهوى الوجوه الحسانا","https://www.aldiwan.net/poem33816.html","الخفيف"],[559,"تب إلى الله من علوم الكلام","https://www.aldiwan.net/poem33868.html","الخفيف"],[559,"أيها البرق اللموع","https://www.aldiwan.net/poem34383.html","مجزوء الرمل"],[559,"كلنا واحد هو الأمر","https://www.aldiwan.net/poem34497.html","الخفيف"],[559,"إن بحر الوجود بالإختلاج","https://www.aldiwan.net/poem34690.html","الخفيف"],[559,"خلني في محبة المحبوب","https://www.aldiwan.net/poem34963.html","الخفيف"],[559,"بين أهل الجحود والتكذيب","https://www.aldiwan.net/poem34966.html","الخفيف"],[563,"سعد غندور الصالح اليوم أمسى","https://www.aldiwan.net/poem52587.html","البسيط"],[563,"شاب شعري نظير ما شاب شعري","https://www.aldiwan.net/poem52740.html","الخفيف"],[563,"لمن الدمع بعد هذا تصون","https://www.aldiwan.net/poem52978.html","الخفيف"],[568,"مالك موفور فما باله اكسبك","https://www.aldiwan.net/poem69501.html","السريع"],[568,"عجبت من قناعتي وقعودي","https://www.aldiwan.net/poem69730.html","الكامل"],[571,"إن تك حرب فلم أجنها","https://www.aldiwan.net/poem59474.html","المتقارب"],[576,"أعملوا في هجوه الفكرا","https://www.aldiwan.net/poem2814.html","المديد"],[576,"قل لإبن المعنز يرحمك الله","https://www.aldiwan.net/poem2932.html","الخفيف"],[576,"وجنة فوقها عذار أطلا","https://www.aldiwan.net/poem3027.html","الخفيف"],[576,"ليس لي منه سوى لا","https://www.aldiwan.net/poem3032.html","مجزوء الرمل"]],"verses":[["إِن تَكَرَّمتَ فَالخَليلُ كَريمٌ","أَو تَمَنَّعتَ فَالمَلولُ عَنيفُ",0,"ف",1,0],["إِن تَكُن تَشكو لِأَوجاعِ الهَوى","فَأَنا أَشفيكَ مِن هَذا الوَجَع",1,"ع",1,0],["إِن تَكُن لَم تُرِد وِصالَ سِواها","فَلِماذا صَدَدتَ وَجهَكَ عَنّا",2,"ن",2,0],["إِن تَكوني لَم تَكتُبي خَشيَةَ النا","سِ فَأَلّا أَودَعتِ ذاكَ الرَسولا",3,"ل",2,0],["إِن تَكوني مَلِلتِ يا فَوزُ وَصلي","وَتَناسَيتِني وَعَهدَكِ أَمسِ",4,"س",1,1],["إِن تَكُنِ الحُمّى أَضَرَّت بِهِ","فَرُبَّما تَنكَسِفُ الشَمسُ",5,"س",1,0],["إِن تَكُ لُبنى قَد أَتى دونَ قَربِها","حِجابٌ مَنيعٌ ما إِلَيهِ سَبيلُ",6,"ل",1,1],["أنْتَ كالرُّمْحِ في اعْتِدالٍ وطولٍ","وانْتِخابِ الحَديدِ في أعْلاهُ",7,"ه",1,0],["إِن تَكُن نالَتكِ بِالضَربِ يَدي","وَأَصابَتكِ بِما لَم أُرِدِ",8,"د",1,1],["إن تك العين أذنبت","حسبها السهد والنوى",9,"و",2,0],["أَنْتَ كُلُّ الأَمِيرِ نُبْلاً وَفَضْلاً","وَسُموًّا وَأَنْتَ كُلُّ الْحَبِيبِ",10,"ب",1,0],["إِنْ تَكُونُوا حُمَاتَهَا وَبنِيهَا","مَا لِتِلْكَ الذِّئَابِ تَعتَسُّ فِيهَا",11,"ي",3,1],["إِنْ تَكُنْ هَذِهِ رِوَايَتُكَ الأُو","لَى فَمَا الظَّنُّ بِاللَّوَاتِي يَلِينَا",12,"ن",2,0],["إِنْ تُكْدِ مِنْ أَحْسَابِهِنَّ رُبُوعُهُمْ","زَادُوا وَإِنْ تُكْدِ المَحَاسِنِ زَانُوا",13,"ن",3,0],["إِنْ تُكْرِمُوهُ تُكْرِمُوا أَوْطَانكمْ","فِي أَمْجَدِ البَانِينَ لِلأَوْطَانِ",14,"ن",1,0],["إِنْ تُكْرِمِي بِالحَقِّ ذِكْرَى مَاجِدٍ","فَالمَجْدُ لا يُرْضِيهِ نَوْحُ حَمَائِمِ",15,"م",1,0],["إِنْ تُكَرَّمْ بَعْدَ الْوَفَاةِ فَهَلاَّ","قَبْلَهَا كَانَ ذَلِكَ التَّكْرِيمُ",16,"م",1,0],["إِنْ تَكْتَمِلْ فِيكَ الحِلاَلُ","وَقَدْ حَريْنَ بِالاِكْتِمَالِ",17,"ل",1,0],["إِن تَكونوا تَرَكتُمُ لَذَّةِ العَي","شِ حِذارَ العِقابِ يَومَ العِقابِ",18,"ب",1,0],["إن تكن هذه السياسة عدلاً","فإلى الظلم نشتكي الآلاما",19,"م",2,0],["إن تكونوا اعتزمتم الأمر فيه","فالبدار البدار قبل الفوات",20,"ت",1,0],["إن تكن افجعت بشهم بني العظ","م فأعظم بخطبها المترامي",21,"م",2,0],["إن تكن هالكاً فكم لك ذكر","في العلا خالد مدى الأيام",21,"م",1,0],["إن تكن هذه المجرة نهراً","مستفيضاً فشمسنا منه قطره",22,"ر",2,0],["إِن تَكُ مِطعامَ العَشِيّاتِ مِن غِنىً","فَإِنَّكَ حَيّادٌ عَنِ الحَقِّ مانِعُ",23,"ع",1,1],["إن تكن ستًّا كما قد أرخو","فلها في أنجم السعد جوار",24,"ر",1,0],["إن تكتحل سناه تلقى الرشدا","وأين ما تذهب تلاق سعدَا",25,"د",2,0],["إنْ تكن نفحةٌ أصابتك من عَذ","لي فعمّا قدحتَ في الأحشاءِ",26,"ا",2,0],["إن تكن قد علوتَ عن ساكني الأر","ضِ فخاطِبْهمُ إذاً من سَمائِكْ",27,"ك",1,0],["إن تكن عاشقاً لعبدك تعشق","عاشقاً لم تزل له معشوقا",28,"ق",2,0],["إن تكن جاحداً لنعماك عندي","لا تجدني لها كفوراً سروقا",28,"ق",2,0],["إن تكُ قد بِعْتَني فمن غَبني","أُبكَى وأبكي وليس من غبنك",29,"ك",1,0],["إن تكن ثبَّجتَ شعري ظالماً","فرماكَ اللَّهُ في واحدتِك",30,"ك",1,0],["إن تكوني أنحلتِ جسمي فقد أب","كيتِ عيني مع العيون البواكي",31,"ك",2,0],["إنْ تكونوا علوْتُمُ وعلا النا","سُ فلستم وغيركمْ أمثالا",32,"ل",2,0],["أنت كالسيفِ ماؤُهُ منه والشع","رُ يدا صيقل تُجيدُ الصّقالا",32,"ل",2,0],["أنت كالمستثير شمساً بنارٍ","ولعمري لَلشمسُ للعينِ أجلى",33,"ل",2,0],["أنت كالمستضيء شمساً بنارٍ","ولعمري للشَّمسُ للعين أجْلى",34,"ل",2,0],["إن تكسُني يكسُك المعروفُ من كثَبٍ","ثوباً جميلاً تراه أعينُ الفَطِنِ",35,"ن",1,0],["أنت كهل الكهول يوم ترى الرأ","يَ ويومَ الوغى من الفتيان",36,"ن",1,0],["إن تكن سهلةَ القوافي فليستْ","في المعاني بسهلة الوُجدان",36,"ن",1,0],["إِن تَكُ لِلحَقِّ أَسبابٌ يُمَدُّ بِها","فَفي أَكُفِّهِمِ الأَرسانُ وَالسَبَبُ",37,"ب",1,0],["إِن تَكُ عَبسٌ وَلَدَت وَليدا","وَوَلَدَت كَلبٌ بَني يَزيدا",38,"د",2,1],["أَنتِ كَالحُرَّةِ الَّتي اِنقَلَبَ الدَه","رُ عَلَيها فَأَصبَحَت في الإِماءِ",39,"ا",2,0],["أَنتِ كَالبُردَةِ المُوَشّاةِ أَبلى الط","طَيُّ وَالنَشرُ ما بِها مِن رُواءِ",39,"ا",2,0],["أَنتِ كَاللَيثِ قَلَّمَ الدَهرُ ظُفرَي","هِ وَأَحنى عَلَيهِ طولُ الثَواءِ",39,"ا",2,0],["أَنتِ كَالشاعِرِ الَّذي أَلِفَ الوِح","دَةِ في مَحفَلٍ مِنَ الغَوغاءِ",39,"ا",2,0],["إِن تَكُ العِزلَةُ نُسكا وَتُقىً فَالذِئبُ راهِب","وَعَرينُ اللَيثِ دَيرٌ حُبُّهُ فَرض وَواجِب",40,"ب",1,0],["إِن تُكرِموا شَيخَ الصَحافَةِ تُكرَموا","أَسنى الكَواكِبِ في سَماءِ الضادِ",41,"د",1,0],["إِن تَكُن زَهراً فَما أَمجَدَنا","أَو نَكُن شَوكاً فَهَذا الخَطَرُ",42,"ر",1,0],["إِن تَكُن في الوَحشِ كُن لَيثَ الثَرى","أَو تَكُن في الطَيرِ كُن كَالأَجدَلِ",43,"ل",1,0],["إِن تَكُن تَبغي الرُجوعَ لَها","ذاكَ مَقضِيٌّ لَدى الحُلُمُ",44,"م",1,0],["إِن تَكُن ذاكَ السَجينَ فَيا","رُبَّ عانِ غَيرِ مُجتَرِمِ",44,"م",1,0],["أَنتَ كَالصَديقِ أَسكَنَهُ","فَضلُهُ في السِجنِ مِن قِدَمِ",44,"م",1,0],["إِن تَكُن لِلخُلودِ ذاتَكَ في الدُن","يا فَماذا الأَمرُ الَّذي تَهواهُ",45,"ا",2,0],["إِن تَكُ يا سَيِّدي مُعَذِّبَها","مَن ذا الَّذي يُرتَجى لِرُحماها",46,"ا",3,0],["أَنْتَ كرَّهْتَني الحَيَاةَ وما فيها","وحبَّبْتَني جُمودَ السَّاهي",47,"ي",1,0],["أنتِ كالزهرةِ الجميلةِ في الغابِ","ولكنْ مَا بَيْنَ شَوكٍ ودودِ",48,"د",1,1],["أَنْتَ كهفٌ مظلِمٌ تأوي إليه البائِساتْ","أَنْتَ صرْحٌ شادَهُ الحُبُّ على نهرِ الحياةْ",49,"ه",1,0],["ان تكن مني الصراحة اثما","فهو جزء متممم لجهادي",50,"د",2,0],["انت كف القضاء تضرب من شا","ء وسيف القضاء في الاعناق",51,"ق",1,0],["انت كالطفل تسمع الشيء ممن","جهلوه فتكثر التصديقا",52,"ق",2,0],["أنتِ كالشمس رفرفا والسماك","ين رواقا والمجرّة صحنا",53,"ن",2,0],["إن تكن للثواب والبر دارا","كيف إن تمت الملاوة قرنا",53,"ن",2,0],["أنت كالنار مزاجا","كيف مازجت رشيدا",54,"د",2,0],["إن تكن من صدف تنس الحمى","او تكن من لؤلؤ تبك الديار",55,"ر",1,0],["إن تكن تحكم في أزرارها","إنه في يده زر القضاء",56,"ا",2,0],["إِن تَكُ اليَومَ لِواءً قائِداً","كَم لِواءٍ لَكَ بِالأَمسِ اِنعَقَد",57,"د",1,0],["أَنتِ كَالشَمسِ رَفرَفاً وَالسِماكَي","نِ رِواقاً وَكَالمَجَرَّةِ صَحنا",58,"ن",2,0],["إِن تَكُن لِلثَوابِ وَالبِرِّ دارٌ","أَنتِ لِلحَقِّ وَالمَراشِدِ مَغنى",58,"ن",2,0],["أَنتَ كَالحَقِّ أَلَّفَ الناسَ يَقظا","نَ وَزادَ اِئتِلافَهُم وَهوَ نائِم",59,"م",1,0],["إن تُكرمي يا زَحْلُ شعري إنني","أَنكرْتُ كلَّ قَصيدَةٍ إلاَّكِ",60,"ك",1,0],["إِن تَكُن سِلماً لَهُ لَم يَنتَفِع","أَو تَكُن حَرباً فَقَد فاتَ الضَرَر",61,"ر",1,0],["إِن تَكُن قَد جَفَتهُ في ساعَةِ الشَكِّ","فَحَظُّ الكَبيرِ مِنها الجَفاءُ",62,"ا",2,0],["إِنْ تَكُنْ في التُّرابِ خَيْرَ ضَجيعٍ","كُنْتَ لي في المَعَادِ خَيْرَ شَفيعِ",63,"ع",1,0],["إِنْ تَكُنِ الأيّامُ قَدْ أَذْنَبَتْ","فِيكَ فإنَّ الدّمْعَ لا يُذْنِبُ",64,"ب",1,0],["إِن تَكُ عُكلٌ في هاشِمٍ أُخَرِ","مِن بَعدِ عُكلٍ فَساكِنو العَقَبَه",65,"ب",2,1],["إِن تَكُن أُنسيتَ ما كا","نَ فَإِني ما نَسيتُ",66,"ت",1,0],["إِن تَكوني حَلَلتِ رَبعاً مِنَ الشا","مِ وَجاوَرتِ حِميَراً وَمُرادا",67,"د",2,0],["إِن تُكفَروا لا تَنقُصوا أَو تُشكَروا","فَالنَجمُ ما لَحَظَتهُ عَينُ الناظِرِ",68,"ر",1,0],["إِن تُكسِ مِن وَشيِ المَديحِ فَإِنَّهُ","مِن ضَوءِ سَيبِكَ في المَحافِلِ كاسِ",69,"س",1,0],["أَنتَ كَما قَد عَلِمتَ مُضطَرِبُ ال","هَيأَةِ وَالقَدُّ ظاهِرُ الجَلَفِ",70,"ف",1,0],["إِن تَكُن مُحتَسِباً مَن قَد ثَوى","لِحِمامٍ فَاِحتَسِب مَن قَد عَشِق",71,"ق",1,0],["إِن تَكتَئِب حَلَبٌ فَقَد غَلَبَت عَلى","حَلَبِ الغَمامِ وَصَوبِهِ التَهتانِ",72,"ن",1,0],["إِن تَكذِبِ الميعادَ تَظلِم وَإِن","تَصدُق فَبِرذَوناً بِبِرذَونِ",73,"ن",1,0],["إِن تَكُ كَلباً مِن كُلَيبٍ فَإِنَّني","مِنَ الدارِمِيِّينَ الطِوالِ الشَقاشِقِ",74,"ق",1,1],["إِن تَكُ تَبخَل يا اِبنَ عَمرٍ وَتَعتَلِل","فَإِنَّ اِبنَ عَبدِ اللَهِ حَمزَةَ فاعِلُ",75,"ل",1,1],["إِن تَكُ دارِمَ القَدَمَينِ جَعداً","ثُمالِيّاً فَإِنّي لا أُبالي",76,"ي",1,1],["إنْ تكُنْ ت