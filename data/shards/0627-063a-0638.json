{"poems":[[164,"الحمد للّه رب العالمين على","https://www.aldiwan.net/poem58891.html","الكامل"],[164,"أبى الله أن يشقى بنصحك ناصح","https://www.aldiwan.net/poem58983.html","الطويل"],[422,"لأسماء دار حيث منقطع الرمل","https://www.aldiwan.net/poem53930.html","الطويل"],[422,"ما مات من بعد عبد الواحد الجود","https://www.aldiwan.net/poem53941.html","البسيط"],[422,"لمن أينق يا سعد ترقل أو تخدي","https://www.aldiwan.net/poem53991.html","الطويل"],[422,"رمى ولم يرم عن قوس ولا وتر","https://www.aldiwan.net/poem54110.html","البسيط"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126180","الوافر"]],"verses":[["أغظ عِداكَ بارضاءِ الإِله فما","يرضيه مثل مليكٍ في الوري عَدلا",0,"ل",2,0],["أغظ حاسدي وارفع مكاني فربما","يسرك منى خادم لك ناصح",1,"ح",1,0],["أَغَظْتُ بك الحُسَّاد في كلِّ مدحةٍ","أشدّ على الأَعداء من موقع النّبل",2,"ل",1,0],["أغظتَ كلَّ حَسودٍ أَنْتَ تعرفه","وكلُّ ذي نعمةٍ لا شكَّ محسود",3,"د",1,0],["أغَظْتُ بك الحُسَّاد حتَّى وَجَدْتَني","ملأتُ بها صدرَ الزَّمان من الحقد",4,"د",1,0],["أغَظْتُ في مدحه قوماً بقافيةٍ","عن المقيمِ تجوب الأرض في سفر",5,"ر",1,0],["أغظ واقهر أعادينا","ولا تطمعهمُ فينا",6,"ن",2,0]]}