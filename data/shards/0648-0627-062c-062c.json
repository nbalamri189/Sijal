{"poems":[[39,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[68,"بدت تختال في ذيل النعيم","https://www.aldiwan.net/poem39924.html","الوافر"],[132,"ولما قرعتم باب عتبى فتحته","https://www.aldiwan.net/poem50522.html","الطويل"],[482,"دم أريق بأسياف الهوى هدر","https://www.aldiwan.net/poem15236.html","البسيط"],[482,"تذكر أيام الصبا فتألما","https://www.aldiwan.net/poem15241.html","الطويل"],[569,"تحمل في الهوى ما لا يطاق","https://www.aldiwan.net/poem876.html",""],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64771","الطويل"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93094","الطويل"],[2254,"","https://poetry.dctabudhabi.ae/diwan/poem/83253","الطويل"],[2697,"","https://poetry.dctabudhabi.ae/diwan/poem/107172","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65947","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91993","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91679","الطويل"],[4927,"رسالة حب","https://www.poetsgate.com/ViewPoem.aspx?id=29840",""]],"verses":[["وَأجَّجنَا بِكُلِّ يفَاعِ أرض","وَقُودَ المضجدِ لِلمُتَنَوِّرِينَا",0,"ن",2,0],["وَأَجَّجَ مِن شُعاعِ الشَمسِ ناراً","أَذابَ لَهيبُها بَردَ النُجومِ",1,"م",1,0],["وأججتمَا نارَ الملامةِ فاصبرا","على حرِّها من حَرِّها قد وقيتُما",2,"م",2,0],["وأجَّجَ البينُ في الأحشاءِ نارَ هوًى","بعدَ الحبائبِ أمستْ وهي تَستعِرُ",3,"ر",1,0],["وأجَّجَ في قلبي الغرامُ لواعجاً","مِنَ الشوقِ يبعثنَ الزفيرَ المضرَّما",4,"م",2,0],["وأجج في الجوانح نار وجدٍ","اليم للحشى منه احتراق",5,"ق",1,0],["وَأَجَّجَ كَرْبي فَتْرَةٌ مِنْ لِحاظِهِ","فأَرْسَلْتُ دَمعاً حَرَّمَ النَّوْمَ والصَّبْرا",6,"ر",2,0],["وأجج في أحشائك النار كلما","خبت زادها ما ذاب منك تلهبا",7,"ب",2,0],["وَأَجج حرباً في البِلادِ شَنيعَة","بِها اِزداد حكم الغالِبين تصلبا",8,"ب",2,0],["وَأَجِّج بِهَذِي الدارِ ناراً عَظيمَةً","مِن الحَربِ أَشلاءُ الأَعادِي وَقُودُها",9,"د",3,0],["وأجّج هيجاء الهياج تأججاً","لجاج هياج الهائج المتمائد",10,"د",1,0],["وأَججها ناراً كَوى الأَرضَ حرُّها","تمشت فمن قومٍ تهادَت إِلى قَوم",11,"م",1,0],["وَأَجّج نارَ الشَوق من قَلب والهٍ","لتُهدَى لَهُ الأَفكار من كل قاصد",12,"د",1,0],["وَأَجَّجَتِ الْعَوَاْطَفَ ذَاْتُ حُسْنٍ","مِنَ الشِّعْرِ الْمُعَبِّرِ تَسْتَفِيْدُ",13,"د",1,0]]}