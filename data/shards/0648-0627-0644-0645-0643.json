{"poems":[[9,"ما بكاء الكبير بالأطلال","https://www.aldiwan.net/poem21974.html","الخفيف"],[85,"الأمير بدر المواكب","https://www.aldiwan.net/poem54192.html","مجزوء الرمل"],[74,"لثمت ثغر عذولي حين سماك","https://www.aldiwan.net/poem19438.html","البسيط"],[64,"في راحتيك الرزق والأجل","https://www.aldiwan.net/poem52318.html","أحذ الكامل"],[47,"أرسوم دار أم سطور كتاب","https://www.aldiwan.net/poem11430.html","الكامل"],[47,"لك الخلائق فينا السهلة السمح","https://www.aldiwan.net/poem62686.html","البسيط"],[68,"كم ساهر حرم لمس الوساد","https://www.aldiwan.net/poem38652.html","السريع"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[50,"قل للمسمى باسم الذي قام يد","https://www.aldiwan.net/poem62417.html","المنسرح"],[78,"ألحاظ عيني تلتهي","https://www.aldiwan.net/poem38861.html","مجزوء الكامل"],[47,"لكَ الخَلائِقُ فِينا السّهلَةُ السُّمُحُ","https://www.poetsgate.com/ViewPoem.aspx?id=32947",""],[147,"ما في المعالي علي منك يعتصم","https://www.aldiwan.net/poem11822.html","الطويل"],[164,"سم سمة تحمد آثارها","https://www.aldiwan.net/poem59021.html","السريع"],[173,"سقها ولو ذهب السرى بسراتها","https://www.aldiwan.net/poem1609.html",""],[173,"قسماً بأعراف الجياد الضمر","https://www.aldiwan.net/poem1628.html",""],[376,"يرمي فلا أتحيد","https://www.aldiwan.net/poem57507.html","مجزوء الكامل"],[445,"قل للربيع اسحب ملاء سحائب","https://www.aldiwan.net/poem34876.html","الكامل"],[457,"إليك نزعة آداب يرن بها","https://www.aldiwan.net/poem13632.html","البسيط"],[520,"كن لي على شكر ما أوليت من نعم","https://www.aldiwan.net/poem12253.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138332",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122817","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96619","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64694","المجتث"],[1239,"","https://poetry.dctabudhabi.ae/diwan/poem/128266","البسيط"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137855",""],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26414","الخفيف"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96037","الكامل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96030","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109452","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93595","الكامل"],[2684,"","https://poetry.dctabudhabi.ae/diwan/poem/131482",""],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3658,"","https://poetry.dctabudhabi.ae/diwan/poem/199152","السريع"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102952","الكامل"],[4122,"","https://poetry.dctabudhabi.ae/diwan/poem/111114","الرجز"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97067","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133155","المجتث"],[4888,"زف الدماء","https://www.poetsgate.com/ViewPoem.aspx?id=207759",""],[5186,"الروح والريحانة الفيحاء","https://www.poetsgate.com/ViewPoem.aspx?id=156506",""],[5237,"إن شئت عيشا هنيا واتباع هدى","https://www.poetsgate.com/ViewPoem.aspx?id=113119",""],[5455,"باب النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=213952",""]],"verses":[["وَالمَكاكيكَ وَالصِحافَ مِنَ الفِض","ضَةِ وَالضامِزاتِ تَحتَ الرِجالِ",0,"ل",1,0],["والمكارم فيه طبيعت","وهوت فالمهد يرضع",1,"ع",1,0],["والمكرمات التي افترَّت مباسمها","والغيث بالرعدِ يُبدِي شهقةَ الباكي",2,"ك",2,0],["والمكرُماتُ يضِلُّ إنْ حُصِرتْ","في عدِّها التفصيلُ والجُمَلُ",3,"ل",1,0],["وَالمَكرُماتِ مَواهِبٌ مَمنوعَةٌ","إِلّا مِنَ المُتَكَرِّمِ الوَهّابِ",4,"ب",1,0],["وَالمَكرُماتُ الَّتي باتَت مَعالِمُها","مَشهورَةً كَنُجومِ اللَيلِ تَتَّضِحُ",5,"ح",1,0],["وَالمَكرُ مَكروهٌ دَها أَهلَهُ","وَأَهلَكَ اللَهُ لَهُ أَهلَ عاد",6,"د",1,0],["والمُكَنَّى أبا عُبيْدَةَ إذْ يَعْ","زِي إليه الأمانةَ الأُمَناءُ",7,"ا",2,0],["وَالمُكتَني بِاِسمِ خاتَمِ الأَنبِيا","ءِ المُرسَلينَ الَّذي أَتى العَرَبا",8,"ب",2,0],["والمُكْتسي غَنَجاً أما","تَرثي لأَشعثَ أَمرهِ",9,"ه",1,0],["وَالمَكْرُماتُ التي باعَتْ مَعالِمُها،","مَشهُورَةٌ، كَنجومِ اللّيلِ تَتّضِحُ",10,"ح",1,0],["وَالمَكرُماتُ الَّتي تَهوى بِهِنَّ نَدىً","ما حاتِمٌ مِنهُ في شَيءٍ وَلا هَرِمُ",11,"م",1,0],["والمكر مهما اسطعت لا تأته","لتقتني السودد والمكرمه",12,"م",2,0],["وَالمُكرِمِ الجاراتِ عَن شَرِّ الخَنا","إِن دَبَّتِ النّوكى إِلى جارَاتِها",13,"ت",3,0],["وَالمُكرِهُ السُّمرَ الدِقاقَ ومُنهِلُ ال","بيضِ الرِقاقِ مِنَ النَجيعِ الأَحمَرِ",14,"ر",1,0],["والمَكرُمات كأنها","من كفِّه تتولدُ",15,"د",1,0],["والمَكْرُمَاتُ منازلي ومشاهِدِي","والمُقْرَباتُ مراكِبي ومَرَاقِبي",16,"ب",2,0],["والمكرمات غدت في طبعه خُلُقاً","ونحلة الودّ دأباً منه مدؤوبا",17,"ب",2,0],["والمكرمات التي ما نال أيسرها","مؤمل قط من كعب ومن هرم",18,"م",1,0],["والمكرمات الغر قد سعدت بها","كل الورى في مربع ومصيف",19,"ف",1,0],["والمُكرهينَ صُدُورَ خَيلِهُمُ إلَى","حَوضِ المَنيّةِ والقَنا إكراها",20,"ا",3,0],["وَالمكرُمات الغرّ تنسبني كما","نسبت إليها القعهنية قعصبا",21,"ب",2,0],["وَالمَكْرُماتُ أَنارَتْ","وَسِرْنَ سَيْرَ الكَواكبْ",22,"ب",1,0],["والمكرُماتُ تُلبِّي كلَّ داعِيَة","تَمْشِي لكم ما مَشَتْ منكم لها قَدَمُ",23,"م",1,0],["والمكتسي البر والتقوى وما تركت","جدواه من مرتج جدواه عريانا",24,"ن",2,0],["وَالمُكَنّى بِكِنيَةِ الوارِثِ العَب","باسِ وَالمَكتَني بِهِ المَنصورُ",25,"ر",1,0],["والمكرمات الغر طراً","والندي الازهر",26,"ر",1,0],["والمكرمات وما أشاد","الدهر من ذكر جميل",27,"ل",1,0],["والمكرمات طواها البين في كفنٍ","له واضمرها من بعد اظهار",28,"ر",1,0],["وَالمكرمات تَوسدت","بِأزائه تَحتَ الثَرى",29,"ر",2,0],["والمكتفي من بني العباس","يفديك ودولة بني عثمان",30,"ن",1,0],["والمكتبيّ الصالح التقيّ","هنا وكان شيخه البكريُ",31,"ي",1,0],["والمكرُ فات الحصرَ كالبحر بل","يعد فيه البحر كالقطرة",32,"ه",1,0],["والمكرمات زواهر في يمنكم","يمن بمحكمة الجلالة يحفد",33,"د",1,0],["والمكرمات الساميات الفاخره","ياذا المزايا الفائقات الزاهره",34,"ه",1,0],["والمكرمات غدت تبكي دماً حزناً","إذ كان دون الورى أماً لها وأبا",35,"ب",2,0],["والمكث نحو الحطيم","وحول باب السلام",36,"م",1,0],["والمكرُ إن ألبستَه ثوبَ التقى","فالشعبُ يوشِكُ هازئًا أن يُظهرَه",37,"ر",2,0],["والمكرمات جميعها في خدمة","أجدى بها البؤساء والتعساء",38,"ا",2,0],["والمكر لا تأته عقباه خاسرة","لؤم وشئوم على أصحابه البعدا",39,"د",2,0],["والمكان اللي وهن سقفه من الفرقا وشاب","من بعد ماكان يحضّنا مثل طفل ٍ غيور",40,"ر",1,0]]}