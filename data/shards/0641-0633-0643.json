{"poems":[[65,"أصاخ إلى الواشي فلباه إذ دعا","https://www.aldiwan.net/poem46191.html","الطويل"],[79,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[74,"وافى إلي بمدحة قد أخبرت","https://www.aldiwan.net/poem18461.html","الكامل"],[74,"كان لي مال ولبس","https://www.aldiwan.net/poem18920.html","مجزوء الرمل"],[93,"مهبط الوحي مطلع الأنبياء","https://www.aldiwan.net/poem8724.html","عموديه"],[93,"شاهدتها كالميت في أكفانه","https://www.aldiwan.net/poem62809.html","عموديه"],[72,"لكم أينما كنتم مكان وإمكان","https://www.aldiwan.net/poem42683.html","الطويل"],[87,"وهذه واقعة مستغربه","https://www.aldiwan.net/poem8047.html","الرجز"],[64,"قالت وقد سمعت أني نسبت بها","https://www.aldiwan.net/poem52491.html","البسيط"],[71,"بعثت قطائفا روى","https://www.aldiwan.net/poem29105.html","مجزوء الوافر"],[76,"سجعت وقد غنى الحمام فرجعا","https://www.aldiwan.net/poem13173.html","الطويل"],[76,"ألا هل أطل الأمير الأجل","https://www.aldiwan.net/poem13225.html","المتقارب"],[42,"قد رابه ولمثل ذلك رابه","https://www.aldiwan.net/poem42339.html","الكامل"],[77,"نظرت كما جلت عقاب على إرم","https://www.aldiwan.net/poem69035.html","الطويل"],[50,"ذكر الصبوح بسحرة فارتاحا","https://www.aldiwan.net/poem62495.html","الكامل"],[7,"أهاجك من سعداك مغنى المعاهد","https://www.aldiwan.net/poem2001.html","الطويل"],[48,"يباين شكل غيره في حياته","https://www.aldiwan.net/poem23032.html","الطويل"],[63,"","https://poetry.dctabudhabi.ae/diwan/poem/50424","المتقارب"],[102,"منبت الحبّ","https://www.poetsgate.com/ViewPoem.aspx?id=50163",""],[93,"الكمنجة المحطّة","https://www.poetsgate.com/ViewPoem.aspx?id=53389",""],[113,"من لي به والسحر ملئ جفونه","https://www.aldiwan.net/poem16259.html","الكامل"],[147,"أما وبديع ما تأتي يمينا","https://www.aldiwan.net/poem11835.html","الوافر"],[164,"لم أكثر الواشي المقال وزورا","https://www.aldiwan.net/poem58959.html","الكامل"],[173,"بيني فما أنت من جدي ولا لعبي","https://www.aldiwan.net/poem1605.html",""],[173,"إلام أناجي قلب حيران واجم","https://www.aldiwan.net/poem1668.html",""],[201,"هات يا ساق هات بنت النخيل","https://www.aldiwan.net/poem39944.html","الخفيف"],[227,"عبس الزمان وقد أتى","https://www.aldiwan.net/poem55452.html","مجزوء الكامل"],[234,"أعذلا وما عذلتني النهى","https://www.aldiwan.net/poem51276.html","المتقارب"],[240,"أهلا بطلعة زائر","https://www.aldiwan.net/poem31608.html","مجزوء الكامل"],[287,"سترت بياض شيبي بالخضاب","https://www.aldiwan.net/poem32860.html","الوافر"],[290,"قل لمن تاه دلالا وهوى","https://www.aldiwan.net/poem39393.html","الرمل"],[333,"هات قيثارك يا شاعر","https://www.aldiwan.net/poem55055.html","مجزوء الرمل"],[347,"في هدأة الفكر","https://www.aldiwan.net/poem55319.html","منهوك المنسرح"],[371,"قضى نحبه الصوم بعد المطال","https://www.aldiwan.net/poem17310.html","المتقارب"],[438,"لله بدر أشرقت","https://www.aldiwan.net/poem12751.html","مجزوء الكامل"],[445,"أوجفت خيلي في الهوى وركابي","https://www.aldiwan.net/poem34871.html","الكامل"],[543,"في شخص فاطمة نحيي النيلا","https://www.aldiwan.net/poem47971.html","عموديه"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83310","المنسرح"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/97046","الخفيف"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59617","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62476","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59215","الكامل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35380","الكامل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35401","الكامل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25345","الرجز"],[1267,"","https://poetry.dctabudhabi.ae/diwan/poem/144517","المتقارب"],[1341,"","https://poetry.dctabudhabi.ae/diwan/poem/124691","البسيط"],[1560,"","https://poetry.dctabudhabi.ae/diwan/poem/130734","الطويل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111816","الرمل"],[1650,"","https://poetry.dctabudhabi.ae/diwan/poem/198697","الطويل"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132226","الخفيف"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118430","البسيط"],[1936,"","https://poetry.dctabudhabi.ae/diwan/poem/105198","الطويل"],[1956,"","https://poetry.dctabudhabi.ae/diwan/poem/121877","السريع"],[458,"","https://poetry.dctabudhabi.ae/diwan/poem/143128","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48196","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53136","البسيط"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137169",""],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65995","الطويل"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118800","الوافر"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74204","الكامل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112508","الطويل"],[3228,"","https://poetry.dctabudhabi.ae/diwan/poem/138837",""],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89189","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135362","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199065","الطويل"],[4307,"","https://poetry.dctabudhabi.ae/diwan/poem/31539","الطويل"],[4830,"حُمرةُ الخدَّين","https://www.poetsgate.com/ViewPoem.aspx?id=213318",""],[4858,"شوق وحنين إلى فلذات كبدي","https://www.poetsgate.com/ViewPoem.aspx?id=33747",""],[4888,"تحية وطن","https://www.poetsgate.com/ViewPoem.aspx?id=207745",""],[4927,"أنا والوردُ والعصفورُ والحبُّ","https://www.poetsgate.com/ViewPoem.aspx?id=29617",""],[585,"أنا في انتظارك مدنف ولهان","https://www.poetsgate.com/ViewPoem.aspx?id=161936",""],[5111,"هُيَامٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212310",""],[5111,"هَمْزِيَّةُ :الْحَوَّاسِ بري","https://www.poetsgate.com/ViewPoem.aspx?id=212623",""],[5121,"عِنَاقُ الأَشْقِيَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=33629",""],[5121,"أنا بك","https://www.poetsgate.com/ViewPoem.aspx?id=37473",""],[5458,"ملكة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=72162",""],[5671,"ضل الطريق وضلت العفر","https://www.poetsgate.com/ViewPoem.aspx?id=169350",""],[5725,"ونادبة قتلي","https://www.poetsgate.com/ViewPoem.aspx?id=196931",""],[5759,"سنظلُّ نبكي","https://www.poetsgate.com/ViewPoem.aspx?id=212934",""],[5759,"سجى الليل","https://www.poetsgate.com/ViewPoem.aspx?id=213405",""],[5790,"ليل الوصال كليلة القدر","https://www.poetsgate.com/ViewPoem.aspx?id=112054",""],[5790,"لما طرقت خباءها","https://www.poetsgate.com/ViewPoem.aspx?id=111928",""],[5790,"زار والصبح قد تبسم والجو","https://www.poetsgate.com/ViewPoem.aspx?id=111988",""],[5919,"هبّ نشرُ المعنبرِ المخزونِ","https://www.poetsgate.com/ViewPoem.aspx?id=128683",""],[6019,"تتأملُ حُلْما","https://www.poetsgate.com/ViewPoem.aspx?id=177789",""],[549,"يا إمامَ الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=203002",""],[6130,"شرفةُ حلمٍ ...","https://www.poetsgate.com/ViewPoem.aspx?id=199248",""],[6167,"هذا المساء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85537&r=&rc=20",""],[6189,"قراءة لعوامل التعرية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83585&r=&rc=52",""],[6273,"وفاء للذكرى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78505&r=&rc=3",""]],"verses":[["فسَكَّنَ رَوعي والرِّماحُ تزَعْزَعَتْ","وخَفَّضَ جَأشي والعَجاجُ ترَفّعا",0,"ع",2,0],["فسَكَبْتَ منْ آمالِها مالاً ومنْ","أوْراقِها ورَقاً وكُنّ طُروسا",1,"س",2,0],["فسكتُّ عنه فجاءني بهجائهِ","لأجيبه هيهات أخلفه الدجى",2,"ج",2,0],["فسكبت المال طاساً","وصبغت اللبس خمري",3,"ي",1,0],["فَسَكِرنا بِها فَلَمّا صَحَونا","ما وَجَدنا مِنها سِوى أَسماءِ",4,"ا",2,0],["فَسَكِرتُ حَتّى ما أَعيَ سُكرَ اِمرِئٍ","بِالخَمرِ أَترَعَ كَأسَهُ ساقيها",5,"ي",3,0],["فَسَكَّنتَها حَتّى مَتى هَبَّتِ الصَبا","بِنَعمانَ لَم يَهتَزَّ بِالأَيكِ نَعمانُ",6,"ن",1,0],["فَسَكَتَت طَريدَةُ البُيوتِ","وَاِغتَرَّتِ الأَفعى بِذا السُكوتِ",7,"ت",1,0],["فسكَّنتْها فتاةٌ من قرائِنها","بِرُقيةٍ من رُقاهَا تُطفِيءُ الغضَبَا",8,"ب",2,0],["فسكرُها أبو ذرٍّ","ومرسلُ صحنِها جابرْ",9,"ر",1,0],["فَسَكَّنتُ مِنهُ بِالتَغَنّي عَلى السُرى","أُمَسِّحُ مِن أَعطافِهِ فَتَسَمَّعا",10,"ع",2,0],["فَسَكَّنَ مِن خَفقِ قَلبٍ نَزا","وَهَوَّنَ مِن مَسِّ خَطبٍ نَزَل",11,"ل",1,0],["فَسَكَتُّ إِضرابَ الحَليمِ وَإِنَّما","يُنجى الحَليمَ عَن الخَنا إِضرابُهُ",12,"ب",2,0],["فسكّنْتُ من إرْعادِهَا وهْيَ هَونَةٌ","ضَعيفةُ طَيّ الخَصرِ في لحظِها سَقَم",13,"م",1,0],["فَسَكَبتُ مِنها في الزُجاجَةِ شَربَةً","كانَت لَهُ حَتّى الصَباحِ صَباحا",14,"ح",2,0],["فَسَكَّنتَ نَفسي بَعدَما طارَ روحُها","وَأَلبَستَني نُعمى وَلَستُ بِشاهِدِ",15,"د",1,0],["فَسَكرانُ يُستَرقى وَيَبذُلُ بُسلَةً","وَآخَرُ صاحي اللُبِّ يَغضَبُ أَن يُرقى",16,"ق",2,0],["فسُكَّانُها الدهرَ من نَفعِها","شبابٌ وشَيبُهمُ كامِل",17,"ل",1,0],["فسكبنا حوله المنى","وملأنا الكأس دمعا وعذابا",18,"ب",2,0],["فسكرت حتّى ما أوعى سكر امريء","بالخمر أترع كأسه ساقيها",19,"ي",3,0],["فَسَكنت مِن طَرفي سَواد سَوادِهِ","وَحَلَلت مِن قَلبي مَحَل ظُنونِهِ",20,"ن",2,0],["فَسُكّانُ البَسيطَةِ ما تَوالى","بِحَضرَتِكَ الهَناءُ مُهَنَّئونا",21,"ن",2,0],["فسكتّ عنهم واطرحت حديثهم","هجرا وحق لمثله ان يهجرا",22,"ر",2,0],["فَسَكِّتوني بِقَولٍ لا تَفونَ بِهِ","قَد صِرتُ أَرضى بِوَعدٍ مِنكُمُ كَذِبِ",23,"ب",1,0],["فَسَكَّنتُها بِالشَدِّ مِنّي بِرحلَةٍ","إِلَيكَ فَأَبدَت ثَغرَ جَذلانَ باسِمِ",24,"م",1,0],["فسَكِرنا فرُحت أنشد شعراً","وهو يُصغي لشعريَ المعسول",25,"ل",1,0],["فسكوت وجداً من أحا","ديث تدار بلا كؤوس",26,"س",1,0],["فسكَّن عارِضَ شُؤْبُوبها","وأمسك مِن سَجْلهِ ما انهمى",27,"ا",1,0],["فَسَكِرتُ مِن أَلحاظِها","وَغَنيتُ عَن صَهبائِها",28,"ا",3,0],["فَسُكري مِن مَشيبٍ حَلَّ عِندي","مَحَلَّ البومِ يَنأَمُ في الخَرابِ",29,"ب",1,0],["فسكبت الدمع ممزوجا دما","سائلا من قطره الورد روى",30,"و",2,0],["فسكبت الشعر من","قلبي كلماح الجمان",31,"ن",1,0],["فسكرها صحو","وصحوها سكر",32,"ر",1,0],["فَسُكرُ الشَبابِ وَسُكرُ الشَرابِ","وَسُكرُ الصُدودِ وَسُكرُ الوِصالِ",33,"ل",1,0],["فسكرتُ لا أدري أمِنْ","كاساتِه أم منْ جُفونِهْ",34,"ن",2,0],["فَسَكِرْتُ والأَيَّامُ تسلُبُ جِدَّتِي","والدَّهْرُ ينسِجُ لي ثِيابَ سِلابِي",35,"ب",2,0],["فسَكَبنَ في أرواحِنا جُملاً قَدِ ات","تَخذت مَسَامِعَنا لَهُنَّ مَسيلا",36,"ل",2,0],["فَسَكَنَ البَحرَ وَهوَ مُضَّطَرِبٌ","مِن بَعدِ ما اِستَصرَخوا وَما جَأَروا",37,"ر",3,0],["فسكران سكري أسكر السكر سكره","ففي كل سكرات تساكر سكرتي",38,"ي",1,0],["فسكرى بصحوى بعد كون تكوني","وصحوى بسكرى قبل نشأة نشوتي",38,"ي",1,0],["فسكرنا لا في الحميا ولكن","قد سكرنا بكل طرفٍ كحيل",39,"ل",1,0],["فسكن بلبالي وأذهب غُلتي","وبرد أحشائي وكان بها جَمر",40,"ر",1,0],["فسكَّن منها ما غدا متحركا","وأطفأ بالاصلاح نارَ لظاها",41,"ا",3,0],["فَسَكَرْت لَمَّا أنْ سُقِيتُ بِلَحْظِهِ","أضعَافَ مَا أُسْقِيتُه بِالاكؤسِ",42,"س",1,0],["فَسَكِرتُ مِن خَمرٍ نَعِمتُ بِشُربِها","بَينَ العُذَيبِ وَبارِقٍ وَعَقيقِ",43,"ق",1,0],["فَسَكِرتُ مِن طَرَبٍ بِبُشراهُ الَّتي","طَرِبَ الفُؤادُ بِها وَقَرَّت أَعيُنُ",44,"ن",1,0],["فَسَكَّنَ اللَّهُ القُلُوبَ الخُفَّقا","وَاعْتَاقَ عَنْهُ الجاهِلِينَ العُوَّقا",45,"ق",2,0],["فسُكَّانُهَا الدَّهْرَ من نَقْعِها","شَبَابٌ وشَيْبُهُم شامِلُ",46,"ل",1,0],["فسكرة الحب أطياب مقدّسة","من خاطر الغيب في الأرواح تنهمر",47,"ر",1,0],["فسكّن منها روعة بقدومه","وضمّت عليه سورها ضمّ معصم",48,"م",1,0],["فسكرنا بالهناءِ","انما الافراح راح",49,"ح",1,0],["فسكران من خمرٍ ومن رشف ريقه","وبينهما من سحر عينيه ثالث",50,"ث",1,0],["فسكتنا وما وجدنا جوابا","واتبعنا الهوى على ما يشاء",51,"ا",2,0],["فسكنن صدمت القهر","باللطف في السر معا والجهر",52,"ر",1,0],["فسكر ولا خمر ولكنما الهوى","يسكعها في وهده لا تثيرها",53,"ر",3,0],["فسكنت سورته وانثنى","فظل طوعي بعد طول الجماع",54,"ع",1,0],["فسكنتَ في برج الجلال مؤهلا","ورقيت إيمانا، وجزت فحولا",55,"ل",2,0],["فسكرتُ من فيهِ وخمرةِ كأسِهِ","وفتور لحظةِ مقلةٍ حوراءِ",56,"ا",2,0],["فسكنت سَوْرَةُ الصهباء شِرَّتَه","واستنزعت بعض ما في الخلق من شَرَس",57,"س",1,0],["فسكوتها فيه حياة عدوها","ومماته وقف على حركاتها",58,"ت",3,0],["فسكنى الفلا والبيد والنجد والذرى","ووحشتنا خير لنا من جوارها",59,"ر",3,0],["فسكري ما له صحو","ومن أهواه خمّاري",60,"ر",2,0],["فَسكرت مِن تلك العقار وَلَم أَزَل","أشفي بِها سَقمي وَفرط عَنائي",61,"ي",1,0],["فسكرى صحو في بلاد أرى بها","حياتي لم تنجح على الطهر والرجس",62,"س",1,0],["فسكري من رضاب سكريّ","وألحاظٍ مريضاتٍ ص