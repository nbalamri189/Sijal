ا ؟",89,"ر",2,0],["ما ذنْبُ أن يَقْلى الزهورَ وعطرَها ال","خنزيرُ؟ وا أسفاً على دُنيايا",90,"ا",3,0],["ما ذنبُ عاشقِ مصرٍ والمفيدِ لها","بالشعرِ والمالِ حتى فاز بالغضبِ؟",91,"ب",1,0],["ما ذنبُ شعبٍ أن يقاطَع رزقُهُ","معَ حكمهِ ليعانِيا الحرمانا؟",92,"ن",2,0],["ما ذَنْبُهَا الروحُ نهرُ الظُلْمِ يُمْطِرُهَا","فَتَنْتَشِي من عَذَابِي ..يَنْتَشِي القَدَرُ",93,"ر",1,0],["ما ذنبُ قلبِي؟ أمَا أضْنَتْكَ لهْفَتُهُ","إلامَ تُذْرِعُهُ النيرانُ والذِّكَرُ؟!",93,"ر",1,0],["29- مَا ذَنْبُ لُعَبَةِ طِفْلَةٍ مِنْ حُضْنِهَا","سَقَطَتْ تُحَاكِي مَشْهَدَ الأحْزَانِ",94,"ن",1,0],["مآذنٌ عانقتْ أسوارَ طيبتنا","فَأنبَتتْ نخلَةَ ( البرحيِّ ) في البَلَجِ",95,"ج",1,0],["مآذن النجف اهتزت أعاليها","فقلت قد شيعوا الدنيا بما فيها",96,"ي",3,1],["مَا ذَنبُها شَطَرَتهَا نَصلَةٌ غَدَرَتْ ؟","سُحقًا لِمَنْ غَدَرَتْ , سُحقًا لِمَنْ شَطَرا",97,"ر",2,0],["مآذننا بأقصى الشرق تعلو","فتبلغ في صداها القيروانا",98,"ن",2,0],["مَا ذَنْبُ خَاطِرَةٍ إِذَا انْقَضَّتْ عَلَى","رَجُلٍ فَعَجَّتْ بِاسْمِهِ الأَلْقَابُ",99,"ب",1,0],["مآذنُ عند شطآن التجلِّي","وقمحٌ حول قُبَّرةٍ تُصلِّي",100,"ل",2,1],["ما ذَنْبُ طِفْلٍ فِي حَدِيقَةِ بَيْتِهِ","يَأْتِيِهِ مَوْتٌ غَادِرٌ ومُدَبَّرُ",101,"ر",1,0],["ما ذَنْبُ سَيِّدَةٍ تُهَدْهِدُ طِفْلَهَا","تَدْمَى لَهَا عَيْنٌ وسَاقٌ تُكسرُ",101,"ر",1,0]]}