5072,"هو عيدكم","https://www.poetsgate.com/ViewPoem.aspx?id=51804",""],[5121,"سُلْطَانُ الرُّوح","https://www.poetsgate.com/ViewPoem.aspx?id=49547",""],[5212,"بابُ الحوائج","https://www.poetsgate.com/ViewPoem.aspx?id=212031",""],[5254,"شهقة حرف","https://www.poetsgate.com/ViewPoem.aspx?id=207817",""],[5273,"حب جديد","https://www.poetsgate.com/ViewPoem.aspx?id=28767",""],[5277,"بعيدةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=187712",""],[5277,"في عينكِ تاهتْ أشرعتي","https://www.poetsgate.com/ViewPoem.aspx?id=200889",""],[5279,"أَنْقَاضٌ","https://www.poetsgate.com/ViewPoem.aspx?id=183666",""],[5285,"أرضي لن تموت","https://www.poetsgate.com/ViewPoem.aspx?id=203981",""],[5320,"فيتنام","https://www.poetsgate.com/ViewPoem.aspx?id=42916",""],[5320,"صيحة الثأر","https://www.poetsgate.com/ViewPoem.aspx?id=40397",""],[5324,"نقل فؤادك حيث شئت من الهوى.","https://www.poetsgate.com/ViewPoem.aspx?id=211546",""],[5338,"إن لم تثر في نصر أهلك في اليمن","https://www.poetsgate.com/ViewPoem.aspx?id=187944",""],[5354,"همس القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=192159",""],[404,"دُمُوْعُ امرأةٍ من ميانْمارٍ","https://www.poetsgate.com/ViewPoem.aspx?id=191589",""],[5376,"لنا في الشامِ أشواقٌ وعشقُ","https://www.poetsgate.com/ViewPoem.aspx?id=188345",""],[5376,"أيلامُ عيد والأنام قصورُ","https://www.poetsgate.com/ViewPoem.aspx?id=188353",""],[5376,"أما في الدارِ أشواقٌ وشمسٌ","https://www.poetsgate.com/ViewPoem.aspx?id=188450",""],[5376,"علا القدسَ في أرجائها الحقُّ والعدلُ","https://www.poetsgate.com/ViewPoem.aspx?id=188562",""],[5425,"تَقاسِيمٌ عَلى وَتَر","https://www.poetsgate.com/ViewPoem.aspx?id=207510",""],[5431,"حب الأنا.","https://www.poetsgate.com/ViewPoem.aspx?id=183042",""],[5431,"وتفيض في آباري العطشى...","https://www.poetsgate.com/ViewPoem.aspx?id=200190",""],[5436,"بغداد .. يا مجد هارون ( علي محمد السليم )","https://www.poetsgate.com/ViewPoem.aspx?id=46675",""],[5493,"عزوف القلب","https://www.poetsgate.com/ViewPoem.aspx?id=199529",""],[5493,"مثلَ النجوم","https://www.poetsgate.com/ViewPoem.aspx?id=208609",""],[5512,"خلف السواتر ..قمحانة","https://www.poetsgate.com/ViewPoem.aspx?id=204501",""],[5595,"الحزنُ خيّم في شوارع دجلة","https://www.poetsgate.com/ViewPoem.aspx?id=144539",""],[5691,"لا ينحني نخل العراق","https://www.poetsgate.com/ViewPoem.aspx?id=207062",""],[5720,"كَأَنَّكَ الشَّمسُ","https://www.poetsgate.com/ViewPoem.aspx?id=201280",""],[5769,"قمر النهار","https://www.poetsgate.com/ViewPoem.aspx?id=215849",""],[5803,"لو لا العراق لما ترنم خافقي","https://www.poetsgate.com/ViewPoem.aspx?id=101216",""],[5826,"طرف الْكَرِيم عَن الغلياء لم ينم","https://www.poetsgate.com/ViewPoem.aspx?id=190271",""],[5853,"من أجل سوريا ..الأبية","https://www.poetsgate.com/ViewPoem.aspx?id=175672",""],[5853,"شهقة","https://www.poetsgate.com/ViewPoem.aspx?id=175695",""],[5853,"حلم باللقاء","https://www.poetsgate.com/ViewPoem.aspx?id=188363",""],[5943,"مزقًا تفرَّقنا","https://www.poetsgate.com/ViewPoem.aspx?id=34311",""],[5956,"حيوية الدنيا بوجه أسفر","https://www.poetsgate.com/ViewPoem.aspx?id=182286",""],[5956,"سقوط عداي","https://www.poetsgate.com/ViewPoem.aspx?id=185611",""],[5956,"أسترحم اليومَ يا إيهابُ نخوتكم","https://www.poetsgate.com/ViewPoem.aspx?id=205421",""],[5956,"أشكو لمن ليخففَ الأحزانا؟","https://www.poetsgate.com/ViewPoem.aspx?id=215830",""],[6026,"مرآة الصمت","https://www.poetsgate.com/ViewPoem.aspx?id=214648",""],[161,"بيْنَ السَّجؤينِ وخُطَّةِ السَّجَّانِ","https://www.poetsgate.com/ViewPoem.aspx?id=175319",""],[6070,"الارض الحنون","https://www.poetsgate.com/ViewPoem.aspx?id=187861",""],[4442,"مآذن النجف اهتزت أعاليها","https://www.poetsgate.com/ViewPoem.aspx?id=171229",""],[6102,"سُحقًا لِقَلبكِ ..","https://www.poetsgate.com/ViewPoem.aspx?id=184412",""],[6228,"أمّة المجد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85973&r=&rc=10",""],[6245,"حالات مطرية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87629&r=&rc=0",""],[6325,"أمنيات لطفلٍ عاشق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88019&r=&rc=1",""],[5190,"إطلالة على العام الجديد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78300&r=&rc=13",""]],"verses":[["مَآذِنُ قامَت هُنا أَو هُناكَ","ظَواهِرُها دَرَجٌ مِن شَذَب",0,"ب",1,0],["مآذن الشام تبكي إذ تعانقني","وللمآذن.. كالأشجار.. أرواح",1,"ح",1,0],["ما ذنبُه والحكمُ يطلبُهُ إذا","حُرِمَ الضَّنينُ به وخاب الطّالبُ",2,"ب",1,0],["ما ذنبُ هذا العالم الثَّائِرِ","إنْ حاولَ الإفلاتَ من آسره",3,"ه",1,0],["مَا ذَنْبُ هَذِي الفَتَاةِ تَغْدُو","سَبِيَّةَ الظُّلَّمِ الشِّرَارْ",4,"ر",1,0],["مَا ذَنْبُهُ إِلاَّ السَّمَاحُ الْمَحْضُ","والأَدَبُ اللُّبَابْ",5,"ب",1,0],["ما ذنب عيبة نصح الدين إذ عصفت","بهم رياحك لا تبقى ولم تذر",6,"ر",1,0],["ما ذنب امنية يغتالها قدر","في امرها وقضاء الله يعتقل",7,"ل",1,0],["مآذنًا وقِبابًا للهُدَى رُفِعَتْ","ما يُغْمد البَرْقُ إلَّا قَهْقَهَ الرَّعدُ",8,"د",1,0],["ما ذنبنا غير أن الشرق منبتنا","وأنَّ ساحاته مأوى أهالينا",9,"ن",2,0],["ما ذنبُ عاشقةِ الأزاهرِ والشَّذا","إن لم تُميِّز وجنةً من جنَّة",10,"ه",1,0],["ما ذنبُ نحلٍ يجتَني من سوسَنٍ","والجفنُ منكِ يُشابهُ السوسانا",11,"ن",2,0],["ما ذنبُها إلا ترفّعها بما","يخزي العدى والحاسدينَ ويقهر",12,"ر",1,0],["ما ذنبُنا عِندَكم إِلا هوى وطنٍ","يَشقى بكم فاحتَموا بالمكر والتِّهم",13,"م",1,0],["ما ذَنْبُنا في أَنْ غَزا مَلِكٌ","من آلِ جَفْنَةَ حازِمٌ مُرْغِمْ",14,"م",1,0],["ما ذنب شانيه ودينُك غامضٌ","أنَّى يلام العقل والعلم الهَمَل",15,"ل",1,0],["ما ذنبُ أجفاني إذا خُلقَتْ","من طينة البَلبالِ والخَبْلِ",16,"ل",1,0],["ما ذنبه وهو الرصين تسامحا","إلا لأنه تونسي مؤمن",17,"ن",1,0],["ما ذنبُ أطفالٍ وذنبُ عَجائِزٍ","في الدُّورِ دُكَّت فَوقهُنَّ الدُّورُ",18,"ر",1,0],["ما ذَنبُه إِلا الزمانَ فإنّه","رِخوُ اليدين بمن يُحبّ ملولُ",19,"ل",1,0],["ما ذنبي الواهي الذي اذنبتهُ","حتى بليت بظالم لا يشفقُ",20,"ق",1,0],["ما ذنبُ أهل البيت ح","تَّى منهم أخلوا ربوعه",21,"ع",2,0],["ما ذنبُ فاطمةٍ وحاشا فاطماً","حتَّى أخذت بذنبها أبناءها",22,"ا",3,0],["ما ذنب طفلٍ في الاسار معذّبٍ","الف الشقا وتحمل الاتعاب",23,"ب",1,0],["ما ذنوبي إن تجلى فضلكم","يا رَسول اللَه غث عبدا حصل",24,"ل",1,0],["ما ذَنبهم غَير أَن الحَق هاجَهمُ","كَيلا يُرى عربي فَوقَهُ عجَم",25,"م",1,0],["ما ذنب طفلاي اللذين شجاهما","نوحي فزادهما بكا وعويلا",26,"ل",2,0],["ما ذنب صب آثرت مصرعه","بسهم هجر على تلاقيه",27,"ي",2,0],["مَا ذَنبُهُم وَنَبِيُّهُم قَد قَالَ مَا","قَالُوا كَذَلِكَ مُنزِلُ الفُرقَانِ",28,"ن",1,0],["مَا ذنبُ مَن قَد قَالَ مَا نَطَقَت بِهِ","مِن غَيرِ تَحرِيفٍ وَلاَ عُدوَانِ",28,"ن",1,0],["مَا ذَنبُهُم وَالله إلاَّ أنَّهُم","أخَذُوا بِوَحيِ اللهِ وَالفُرقَانِ",28,"ن",1,0],["ما ذنبهم إذ خالفوك لقوله","ما خالفوه لأجل قول فلان",28,"ن",1,0],["ما ذنبه وهو المريض بجهله","متخبط في كل وادٍ هائمُ",29,"م",1,0],["ما ذنبه حين يلقى الليل في جزع","وهو الوحيد, غريب, الدار, والجار?",30,"ر",1,0],["ما ذنب بضعته الزهراء فاطمة","وقبرها ضاع يا لله في الترب",31,"ب",1,0],["ما ذنب عثمان ذو النورين قد درسوا","مقامه إن ذا من اعظم الكرب",31,"ب",1,0],["ما ذنب طفليه اليتيمين فلم","قتلتم وخنتم هل أذنبا",32,"ب",2,0],["ما ذنب خير عصابة علويةٍ","تنمى لاكرم مرسلٍ في العالم",33,"م",1,0],["ما ذنب يحيى إذ أذاقوه الردى","ظلماً وهدوا للرشاد دعاما",34,"م",2,0],["مآذنها قامت كأيدي جماعة","إلى الله تشكو بعض ما صنع العبد",35,"د",1,0],["ما ذَنْبُنا غيرَ انا مَعْشَرٌ عَرَبٌ","نَسْعَى إلى المجدِ سَعْياً غيرَ مُتَّهَمِ",36,"م",1,0],["ماذنبك أنت لكي تشقي","فلتحيا أنت وتنساني",37,"ن",2,0],["ما ذنبه؟! هلَّا طبخت عشاءه؟!","وغسلت يا بنت الحلال ملابسه",38,"ه",1,0],["ما ذَنبُهُ؟! قالُوا: كِتاباتُهُ","واللهُ والأنصارُ أدرَى بهِ",39,"ب",2,0],["ما ذَنْبُ شَعبي- يا رِيحُ – حتّى","يُرْمَى ويُسْبَى مِن كُلِّ جَانِبْ؟!",40,"ب",1,0],["ما ذنب طفل في العراء مشرد","في مثل عمر الورد والريحان",41,"ن",1,0],["ما ذنْبُ طُيورٍ قد عاشتْ","في هذا الرّوضِ من القِدَمِ؟!",42,"م",1,0],["ما ذنْبُنا إن لم ندخّن عمْرَنا","أن نصطلي بسجارةٍ نأباها ؟",43,"ا",3,0],["ماذنب طيب قلبٍ كنتَ تخدعه","قابلت صدق ودادٍ منه باللعبِ",44,"ب",1,0],["ماذنب من عاشوا على أمل","لا يرتجى فكأنهم رحلوا",45,"ل",3,0],["مَا ذنْبُ مَن قد حُوصِروا في عِلمهم","بالجَهْل أو مِن شِدَّة ِ الحِرمَان؟",46,"ن",1,0],["مَا ذَنْبُ فَلاَّحٍ تَقَطَّعَ دَرْبُهُ","أوْ نَبْتَةٍ لَمْ تُرْوَ في البُس