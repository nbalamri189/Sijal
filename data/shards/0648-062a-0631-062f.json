4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133121","الكامل"],[4796,"ثرثرة المُزنِ وأنا","https://www.poetsgate.com/ViewPoem.aspx?id=180985",""],[4927,"الْحُبُّ الْمُتَوَقِّدُ","https://www.poetsgate.com/ViewPoem.aspx?id=29846",""],[4927,"قَتْلُ الغرام","https://www.poetsgate.com/ViewPoem.aspx?id=30194",""],[5120,"معركة وادي أنوال الخالدة","https://www.poetsgate.com/ViewPoem.aspx?id=185808",""],[5197,"تحية البطل..!","https://www.poetsgate.com/ViewPoem.aspx?id=102355",""],[5302,"يا غويا","https://www.poetsgate.com/ViewPoem.aspx?id=201064",""],[5397,"متى آمن الدنيا من الغدر أخدع","https://www.poetsgate.com/ViewPoem.aspx?id=157923",""],[5431,"يا واهبي معنى الخلودْ","https://www.poetsgate.com/ViewPoem.aspx?id=185356",""],[5431,"الفرات الحزين","https://www.poetsgate.com/ViewPoem.aspx?id=191647",""],[5431,"سطوة المال ...(شجرُ الحب مورقٌ لا انتهاءُ )","https://www.poetsgate.com/ViewPoem.aspx?id=198472",""],[5459,"دنان الغش","https://www.poetsgate.com/ViewPoem.aspx?id=205796",""],[5493,"ما زلتَ في طيِّ الغياب","https://www.poetsgate.com/ViewPoem.aspx?id=196992",""],[5582,"( نَفْسُ ) المُتَيَّمِ فِي الصَّبابَةِ شانُها","https://www.poetsgate.com/ViewPoem.aspx?id=63591",""],[5628,"تراتيل في العشق","https://www.poetsgate.com/ViewPoem.aspx?id=179815",""],[5691,"ربيع عشتار","https://www.poetsgate.com/ViewPoem.aspx?id=206247",""],[5956,"رحماكِ","https://www.poetsgate.com/ViewPoem.aspx?id=182668",""],[6102,"تحذير ..","https://www.poetsgate.com/ViewPoem.aspx?id=183311",""],[5309,"من اعد العيش فوق السحب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573523",""],[463,"دعها تكنْ كالسلفِ من أخواتها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59994&r=&rc=50",""]],"verses":[["وَتَرَدَّفُ الأَدراعُ مُش","رَجَةً عَلَيهِنَّ العِيابُ",0,"ب",1,0],["وتَرُدُّ مَن قَلِقَتْ بهِ أضْغانُهُ","حَيَّ المَخافَةِ مَيِّتَ الأعضاءِ",1,"ا",2,0],["وَتَردُف عَبرَةٌ تَهتَانَ أُخرى","كَفَائضِ غَربِ نَضَّاحِ فَتِيقِ",2,"ق",1,0],["وتردّ غصن العيش بعد ذبوله","غضاً يميد بفرعه الفينان",3,"ن",1,0],["وَتَرُدُّ عادِيَةَ الخَميسِ سُيوفُنا","وَنُقيمُ رَأسَ الأَصيَدَ القَمقامِ",4,"م",1,0],["وَتَرَدَّدَت بِكَلامِها فَكَأَنَّما","تَبغي وَلا تَبغي التَفَوُّهَ بِالنَبا",5,"ا",1,0],["وَتُرَدُّ بِالدَمِ بُقعَةٌ أُخِذَت بِهِ","وَيَموتُ دونَ عَرينِهِ الضِرغامُ",6,"م",1,0],["وَتَردي الجِيادُ الجُردُ فَوقَ جِبالِها","وَقَد نَدَفَ الصِنَّبرُ في طُرقِها العُطبا",7,"ب",2,0],["وتردُّ صدرَ السيفِ وهو مورَّدٌ","وله على ثغرِ العدوِّ مراتعُ",8,"ع",1,0],["وَتَرُدُّهُ سَهلاً إِلَيَّ عَطائِفٌ","كَم قَد عَلِقنَ لَنا بِقَلبٍ قاسِ",9,"س",1,0],["وَتَرَدُّدٌ لِلكَأسِ أَحدَثَ حُرمَةً","أُخرى وَحَقّاً ثالِثاً لَم نَقضِهِ",10,"ض",2,0],["وَتَرَدَّى مِن شُعاعِ ال","شَمسِ ثَوباً لَم يُفَصَّل",11,"ل",1,0],["وتردُّ إخوتَنا إلى أوطانهم","بعد الجلاءِ وكان حُكمُكَ ماضيا",12,"ي",2,0],["وَتَردُّ عاديةَ الخميسِ سيوفنا","ونقينُ رأسَ الأصيدِ القمقامِ",13,"م",1,0],["وتردُّ – مثلي – عيشَه رَنِقاً","وتَسُدُّ – مثلي – حَولَه الطُرقا",14,"ق",2,0],["وترد غُصن العيش بعد ذبوله","غضاً يميد بفرغه الفينان",15,"ن",1,0],["وتردّهنّ عرائسا مجلوّة","كندى الصباح وكنّ غير صباح",16,"ح",1,0],["وترد من اعلا المنا","بر للحضيض من المقابر",17,"ر",1,0],["وترد للقلوب حقاً نره","إياه من منى النفوس ضلالا",18,"ل",2,0],["وتردّد الأنفاسِ مَلّكَ عرَفكم","ما ليس يبلغُه العبيرُ الجاسدُ",19,"د",1,0],["وَتُردي بِرُمحٍ لَم يُرَكَّب سِنانُهُ","فَكَيفَ إِذا أَشرَعتَهُ مُتَلَهذِما",20,"م",2,0],["وَتُردي مَن يُقابِلُها وَتَأبى","جَباناً لا يُقَبِّلُها الجَبينا",21,"ن",2,0],["وترددُ العلماء في المفهوم والمن","طوق من علمِ الشريعةِ والأدب",22,"ب",1,0],["وَتُردي بِنا الجُردُ العَناجيجُ وَسطَكُم","بَني الأَوسِ حَتّى يَشفِيَ النَفسَ ثائرُ",23,"ر",1,0],["وَتَرَدَّت مِنَ الجَنوبِ رِياحٌ","زَحفَ العِطرُ خَلفَها وَلهانا",24,"ن",2,0],["وَتَرَدَّدَت بَينَ الكَلامِ","الجَزلِ وَالمَعنى اللَطيفِ",25,"ف",1,0],["وترددين وأنت ذاهلة","إني أخاف عليك حزن غد",26,"د",1,0],["وَتُردّ أَسفل سافلينَ وئيدةً","في قبرِ جسمٍ للبلايا مرتعُ",27,"ع",1,0],["وتَردُّدُ الأَنفاس في لَهَواتنا","يُغري المنازلَ بُكرَةً ومساءَ",28,"ا",2,0],["وتردُّدُ الزفرات بين جوانحي","ممَّا يصُوب بمدمعي المتصاعد",29,"د",1,0],["وتَرُدَّ نائِي الملكِ فِي أَوْطانِهِ","من عهدِ كلِّ مُتوَّجٍ فمُقامِ",30,"م",1,0],["وتَرْدِيدِهِ فِي مجالِ الطِّعانِ","وتكريرِهِ فِي مَكَرِّ الطِّرادِ",31,"د",1,0],["وتردتْ منه العواتق بالمندي","ل مذ راح عاقداً زناره",32,"ر",2,0],["وتردُّ أعراضَ الكرام كأنّها","يمنيَّةٌ تختالُ في حِبَراتِها",33,"ت",3,0],["وتردى غداة السلم حول قبابه","إذا ضربت قبٌّ من الخيل ضمر",34,"ر",1,0],["وترد هيبتك العيون حواسراً","حتى كأن الستر دونك مسبل",35,"ل",1,0],["وتُرَدِّدينَه مِن مُواءٍ ناطقٍ","بنَغائِم التَّحنَانِ والأشوَاقِ",36,"ق",1,0],["وتردّ عنِّي كلَّ طارقةٍ","أنّى وليس يُطيعها الردُّ",37,"د",1,0],["وَتَردّ عن واديك أع","ناقُ المطيّ وما اِجتُوِيتا",38,"ت",2,0],["وَتُرْدِي الحُسَيْنَ سُيُوفُ الطُّغَاةِ","ظَمْآنَ لَمْ يُطْفِ حَرَّ الغُلَلْ",39,"ل",1,0],["وتُرَدُّ توقيعاتُ ما","وقَّعت عن تفريجِ كَرْبِي",40,"ب",2,0],["وتُرَدَدُّ الأنعامُ والأعرافُ وال","أنفالُ في شَرَفَي أَبيه وَطَه",41,"ه",1,0],["وترد تدعو القوم واعظةً","إذ ليس يسمع كافرٌ وعظا",42,"ظ",2,0],["وتردى به وأقبل يسعى","في سرور يجر ذاك الرداءا",43,"ا",3,0],["وَتردّ يا مَأمون عَنهُ مَن اِعتَدى","بِحسام معتصم وَحَزم حَذير",44,"ر",1,0],["وتردادها يعني عن الزاد للفتى","ويطوي بلا شك طريق المسافر",45,"ر",1,0],["وتردها روضاً لكل موحدٍ","في الأرض بين مضايق وحراج",46,"ج",1,0],["وترددوا حيناً وحيناً خافتوا","ومضيت تدعو بالجلاء جهارا",47,"ر",2,0],["وَتَردَّت بِالمَعالي حُللا","وَتَحلَّت بِحليّ الطُّرفِ",48,"ف",1,0],["وَتَردَّت تِلكَ النّجومُ لَدَيها","مِن خُسوفٍ بِالحلّةِ السّوداءِ",49,"ا",2,0],["وَتَرَدُّدي مِن بَيتِ فَرزٍ آمِناً","مِن قُربِ كُلِّ مُخالِفٍ وَملاحي",50,"ح",2,0],["وترداد بمدح جاء يدني","بإخلاص وحب واعتقاد",51,"د",1,0],["وتردد ما بين أجنا طيبة","وتطوف بضريح خير الناس",52,"س",1,0],["وتردّى الكلبُ والمهر معا","فانثنى الصياد يُبْدي الحَسرَات:",53,"ت",1,0],["وتردَّدت أصداؤها","بين البيوت الخاوية",54,"ي",2,0],["وتردّدت بين الشفا","ه وفي الضلوع الصاديةْ:",54,"ي",2,0],["وترددت حتى تغلب يأسها","فقضت شهيدة يأسها وهواها",55,"ه",2,0],["وَترددت وَتوحدت وَتصدعت","حَتّى أَتاها مؤذن بفراق",56,"ق",1,0