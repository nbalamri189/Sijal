{"poems":[[63,"لله قومي فكم ندى خضل","https://www.aldiwan.net/poem45864.html","المنسرح"],[63,"إيها فكم تهصر أغصان الضال","https://www.aldiwan.net/poem46152.html","الرجز"],[42,"أفنى الشباب الذي فارقت بهجته","https://www.aldiwan.net/poem50224.html","البسيط"],[93,"أمر من يطلب الخلود عسير","https://www.aldiwan.net/poem9165.html","الخفيف"],[93,"تكتب يومياتها عادله","https://www.aldiwan.net/poem11125.html","السريع"],[30,"خليلي عوجا عوجة ناقتيكما","https://www.aldiwan.net/poem29543.html","الطويل"],[83,"هي نفحة هبت من الأنصار","https://www.aldiwan.net/poem54284.html","الكامل"],[88,"عبد المجيد قضى فوا أسفا","https://www.aldiwan.net/poem45049.html","أحذ الكامل"],[37,"كالناطقات الصادقات","https://www.aldiwan.net/poem7177.html","مجزوء الكامل"],[23,"نب المساكين أن الخير فارقهم","https://www.aldiwan.net/poem21506.html","البسيط"],[72,"قلب ذلول وغادة صعبه","https://www.aldiwan.net/poem18237.html","المنسرح"],[72,"حاشاك من وحشة تحت الثرى وجلا","https://www.aldiwan.net/poem20546.html","البسيط"],[51,"وقائل إن أبا حفصل أحمق محتاج إلى ضرب","https://www.aldiwan.net/poem8501.html","السريع"],[51,"إن المنية لا تبقي على أحد","https://www.aldiwan.net/poem10865.html","البسيط"],[85,"لم يتفق مما جرى في المركب","https://www.aldiwan.net/poem8024.html","الرجز"],[85,"بالله يا نسمات النيل في السحر","https://www.aldiwan.net/poem63666.html","البسيط"],[43,"عيد بأية حال عدت يا عيد","https://www.aldiwan.net/poem9555.html","البسيط"],[43,"لا الحلم جاد به ولا بمثاله","https://www.aldiwan.net/poem9931.html","الكامل"],[43,"ذكر الصبى ومراتع الآرام","https://www.aldiwan.net/poem10528.html","الكامل"],[45,"يهدي الخيال لنا ذكرى إذا طافا","https://www.aldiwan.net/poem65152.html","البسيط"],[45,"إستقبلا الركب في أطلالهم وقفا","https://www.aldiwan.net/poem65170.html","البسيط"],[44,"كف الندى أضحت بغير بنان","https://www.aldiwan.net/poem30297.html","الكامل"],[44,"يوم الفراق لقد خلقت طويلا","https://www.aldiwan.net/poem30378.html","الكامل"],[44,"يا برق طالع منزلا بالأبرق","https://www.aldiwan.net/poem30397.html","الكامل"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[105,"أأنت يا ابن رزام تغلب القدرا","https://www.aldiwan.net/poem43581.html","البسيط"],[52,"يا دار يا دار أطرابي وأشجاني","https://www.aldiwan.net/poem26663.html","البسيط"],[67,"وسلن حبقوق المصرح باسمه","https://www.aldiwan.net/poem18080.html","الكامل"],[75,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[75,"يوم عريض في الفخار طويل","https://www.aldiwan.net/poem69050.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85348","الكامل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/141014",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39680","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39664","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42694","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54535","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43753","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54248","البسيط"],[106,"ذكرى فنان!","https://www.poetsgate.com/ViewPoem.aspx?id=179489",""],[106,"خيال في يقظة","https://www.poetsgate.com/ViewPoem.aspx?id=179676",""],[106,"المادة","https://www.poetsgate.com/ViewPoem.aspx?id=179426",""],[106,"لا نكسة","https://www.poetsgate.com/ViewPoem.aspx?id=179333",""],[43,"عيد بأية حال عدت يا عيد","https://www.poetsgate.com/ViewPoem.aspx?id=264",""],[67,"شَهِدَتْ لهُ الرُّسْلُ الكِرامُ وَأشْفَقَوا","https://www.poetsgate.com/ViewPoem.aspx?id=14569",""],[127,"أوحشت النخل من معاقل فالرو","https://www.aldiwan.net/poem24262.html","المنسرح"],[155,"يا ملبسي من ثياب صبري","https://www.aldiwan.net/poem55536.html","مخلع البسيط"],[169,"بعض الذي نالنا يا دهر يكفينا","https://www.aldiwan.net/poem1686.html",""],[197,"يا عيد عدت فأين الروض والعود","https://www.aldiwan.net/poem39816.html","البسيط"],[229,"يأيها المعشوق بالله من","https://www.aldiwan.net/poem50895.html","السريع"],[282,"ابن عنين في كل زندقة","https://www.aldiwan.net/poem32305.html","المنسرح"],[282,"سيف اللحاظ ورمح القد قد فتكا","https://www.aldiwan.net/poem32676.html","البسيط"],[297,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[298,"برح الخفاء فلست أكتم لوعة","https://www.aldiwan.net/poem36808.html","عموديه"],[304,"طالت لياليك والأيام يا صاحي","https://www.aldiwan.net/poem16897.html","البسيط"],[305,"خطب له الدين أرنى لحظ مذعور","https://www.aldiwan.net/poem56539.html","البسيط"],[371,"أخيلت للصب أشواقه","https://www.aldiwan.net/poem57270.html","الطويل"],[409,"أسائقها للبين وهو عجول","https://www.aldiwan.net/poem31846.html","الطويل"],[409,"حمائم الأيك هيجتن أشجانا","https://www.aldiwan.net/poem31850.html","البسيط"],[429,"خود من الترك قد صالت على العرب","https://www.aldiwan.net/poem40050.html","البسيط"],[432,"يا من وهبت لوجهه","https://www.aldiwan.net/poem12703.html","مجزوء الكامل"],[437,"خذ من قياد الدهر خير زمام","https://www.aldiwan.net/poem2495.html","الكامل"],[458,"أين ظباء المنحنى","https://www.aldiwan.net/poem55827.html","مجزوء الرجز"],[458,"إن كنت ممن يلج الوادي فسل","https://www.aldiwan.net/poem55986.html","الرجز"],[458,"لو شاء سار ليلة النعف وقف","https://www.aldiwan.net/poem56113.html","الرجز"],[458,"كالشمس من جمرة عبد شمس","https://www.aldiwan.net/poem56156.html","الرجز"],[458,"أولى لها أن يرعوي نفارها","https://www.aldiwan.net/poem56170.html","الرجز"],[458,"هون في الليل عليها الغررا","https://www.aldiwan.net/poem56183.html","الرجز"],[464,"قوامك اللدن لا ما يزعم الغصن","https://www.aldiwan.net/poem3196.html","عموديه"],[477,"كم رضت جامح قلبي عنكم فأبى","https://www.aldiwan.net/poem15242.html","البسيط"],[514,"سل ضاحك البرق يوما عن ثناياها","https://www.aldiwan.net/poem20830.html","البسيط"],[558,"لا تخلط الواجب بالممكن","https://www.aldiwan.net/poem33716.html","السريع"],[558,"لا تظلم الله بما لا يليق","https://www.aldiwan.net/poem34298.html","السريع"],[562,"أرثي ويا ليت شعري من سيرثيني","https://www.aldiwan.net/poem52888.html","البسيط"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"أحق ما كان من قلبي تباريح","https://www.aldiwan.net/poem3654.html","البسيط"]],"verses":[["لَمْ يَتَوَسَّدْ ذِراعَ هِمَّتِهِ","إِلّا رَأى النَّجْمَ مَوْطِئَ القَدَمِ",0,"م",1,0],["لم يتطَرَّقْ عَرَصاتِ البُخّالْ","يَخْطِرُ في أثناءِ بُرْدٍ أسْمالْ",1,"ل",1,0],["لَم يَترُكا ليَ في طولِ اِختِلافِهِما","شَيئاً أَخافُ عَليهِ لَذعَةَ الحَدَقِ",2,"ق",1,0],["لم يتم الذي توخاه جوتي","لا ولم يقض ما اشتهى شكسبير",3,"ر",1,0],["لَمْ يَتَزَوَّجْ وَهْوَ شَأْنُ امْرِيءٍ","يَحْسَبُ جَهْلاً نِسْوَةَ النَّاسِ لَهْ",4,"ل",2,0],["لِمَيٍّ تَرامَت بِالحَصى فَوقَ مَتنِهِ","مَراويدُ يَستَحصِدنَ باقِيَةَ البَقلِ",5,"ل",1,0],["لم يتفق لخليفة مثلُ الذي","أعطى الإلهُ خليفةَ الأنصارِ",6,"ر",1,0],["لم يتخذ غير العلا هدفا","عن قوس هّمته إذا نزعا",7,"ع",2,0],["لم يتهم فيها الصوا","نع خِلقة الأيدي القوادرْ",8,"ر",1,0],["لَم يَترُكِ اللَهَ خَلقاً مِن بَرِيَّتِهِ","وَلَم يُعِش بَعدَهُ أُنثى وَلا ذَكَرا",9,"ر",2,0],["لم يتقدَّم دهر الكرام على","دهرك يا سيِّدي سوى حجبه",10,"ب",2,0],["لم يترك الدهر من أوقات منتظري","إلا وآخر عمر تندب الأوَّلا",11,"ل",2,0],["لم يتزوَّج حَدَثاً ناشئاً","يهتزُّ مثل الغُصُن الرَّطْبِ",12,"ب",1,0],["لِمِيتةِ السِّيْفِ قَوْمٌ يشْرُفُونَ بها","لَيْسوا من المجْدِ في غاياتِه البُعَدِ",13,"د",1,0],["لَم يَتَّفِق مِمّا جَرى في المَركَبِ","كَكَذِبِ القِردِ عَلى نوحِ النَبي",14,"ي",1,1],["لَم يَترُكِ الوَجدُ مِنها غَيرَ أَضلُعِها","وَغَيرَ دَمعٍ كَصَوبِ الغَيثِ مُنهَمِرِ",15,"ر",1,0],["لَم يَترُكِ الدَهرُ مِن قَلبي وَلا كَبِدي","شَيءً تُتَيِّمُهُ عَينٌ وَلا جيدُ",16,"د",1,0],["لَم يَترُكوا أَثَراً عَلَيهِ مِنَ الوَغى","إِلّا دِماءهُمُ عَلى سِربالِهِ",17,"ل",2,0],["لَم يَترُكوا لي صاحِباً إِلّا الأَسى","وَذَميلَ دِعبِلَةٍ كَفَحلِ نَعامِ",18,"م",1,0],["لَم يَتَّسِع لِلأَداني في أَمانَتِهِ","وَقَد رَأى خِلَلاً مِنهُم وَأُلّافا",19,"ف",2,0],["لَم يَتَّرِك وَسَطاً مِنها عَلى وَجَلٍ","إِلّا عَلى الأَمنِ مُطوِيّاً وَلا طَرَفا",20,"ف",2,0],["لَم يَترُكِ الحَدَثانُ يَومَ سَطا بِهِ","أَحَداً نَصولُ بِهِ عَلى الحَدَثانِ",21,"ن",1,0],["لَم يَتَّرِك في المَجدِ مَن جَعَلَ النَدى","في مالِهِ لِلمُعتَفينَ وَكيلا",22,"ل",2,0],["لَم يَتَّبِع شَنِعَ اللُغاتِ وَلا مَشى","رَسفَ المُقَيَّدِ في حُدودِ المَنطِقِ",23,"ق",1,0],["لَم يَترُكِ الدَّهرُ لي ما أَستَعِينُ بِهِ","عَلى التَّجَمُّلِ إِلّا ساعِدي وَفَمِي",24,"م",2,0],["لم يتركِ السيفُ منهم وَهْوَ يأخذُهم","إلا حُشَاشَة هافٍ يَسبقُ البصرا",25,"ر",2,0],["لَم يَتَّسِع مَنطِقي فيهِ بِبائِحَةٍ","حَزماً وَلا ضاقَ عَن مَثواهُ كِتماني",26,"ي",1,0],["لَمْ يُتَّخذ بَيْتٌ سِواهُ قِبْلةً","فازدَد بِذَاكَ لِمَا أَقُولُ قَبُولا",27,"ل",2,0],["لم يُترَكِ اليومَ منهم غيرُ شِرذِمَةٍ","لو أنّهم إثِمدٌ ما حُسَّ في المُقَل",28,"ل",1,0],["لم يتركوا فِيها بجَعْجاعِ الرّدَى","إلاّ النجيعَ على النجيعِ يَسيل",29,"ل",1,0],["لَم يتبع النبغاء في أفعالهم","للعَبقَرية سنة الجمهور",30,"ر",1,0],["لم يترك الدّهر من قلبي ولا كبدي","شيئاً يتيّمه عينٌ ولا جيد",31,"د",1,0],["لم يتركوا في مجال النصر متسعاً","للاحقٍ أو لباغي السبقِ مِضمارا",32,"ر",2,0],["لم يتركِ السيفُ الجوابَ لسائلٍ","أو يَنْسَ من مُترقِّبٍ ميعادا",33,"د",2,0],["لَمْ يَتَّخِذْ بَدْرَ الْمُقَنَّعِ آيةً","بَلْ جَاءَ خَاطِرُهُ بِآيَةِ يُوشَعِ",34,"ع",1,0],["لَمْ يَتْرُكَا بِرَدَاهُمَا غَيْرَ الشجَى","لأَخِيهِمَا مَا دَامَ في الأَحْيَاءِ",35,"ا",2,0],["لَم يَتَبسَّم غداةَ أَودى","إِلّا الأَعادي مَعَ السَوامي",36,"ي",1,0],["لم يَتَّخذْ من مَنارٍ يستضيءُ به","لدَى الشدائِد إلاَّ العَزْمَ والشاها",37,"ا",3,0],["لم يتخِذْ عودَه «داودُ» من خشبٍ","بل كان مُهَج العشاق يبريه",38,"ي",2,0],["لم يتخذ إلا الطبيعةَ مُرشدًا","وعلى مسائلها الدِّقاق تعلَّما",39,"م",2,0],["لم يتقِ الله امرُؤٌ للتقى","بل لنعيم الجنَّة الخالد",40,"د",1,0],["لم يتركوا للمسجد الأقصى، ولا","للعُرْب فيه مَنْسَكًا، أو مَشْعَرا",41,"ر",2,0],["لَم يَترُكِ الدَهرُ مِن قَلبي وَلا كَبِدي","شَيئًا تُتَيِّمُهُ عَينٌ وَلا جِيدُ",42,"د",1,0],["لَمْ يُتخذْ بَيْتٌ سِوَاهُ قِبْلَة","ً يَدْعُو جُنُوداً للوَغَى وخُيُولا",43,"ل",2,0],["لَم يَتَخاوَشِ مِنَ النِقابِ وَلَم","يُزرِ بِهِ قَيظُهُ وَلَم يَرِدِ",44,"د",1,0],["لَمْ يَتْرُكِ البَيْنُ لِي دُمُوعاً","أَبْكي بِها خِيفَةً لِبَيْنِ",45,"ن",1,0],["لَم يَترُكُوا فَضلَ رُمحٍ في أَكُفِّهِمُ","وَنَحنُ نَقصدُها قَرعاً فَتُخَطِينا",46,"ن",2,0],["لم يترك الدهر من قلبي ومن كبدي","شيئا تتيّمه عين ولا جيد",47,"د",1,0],["لم يَتَّرِكْ لي عشقُ شمسِ الضّحى","لَوْناً لو تَارَكْتُه ما تَرَكْ",48,"ك",1,0],["لَم يَتَنَفَّس إِلا عَلى قَدَحٍ","وَلَم يَبِت غَيرَ راكِبٍ كَفَلا",49,"ل",2,0],["لَم يَترُكِ السُقمُ مِنّي غَيرَ ما شَبَحٍ","وَلَيتَهُ كانَ يَرثي لِلَّذي تَرَكا",50,"ك",2,0],["لَم يَتَغيَّر إِن وَلي","عن الودادِ الأَوَّلِ",51,"ل",1,0],["لم يتركوها بعد ذاك وَشأنها","بل أجهزوا كي يطفئوا وَهّاجها",52,"ج",3,0],["لم يتبع لرسول اللَه صفوته","محمد المصطفى العاقب الماحي",53,"ح",2,0],["لَم يَتركنّا الأسى إن كان متّركاً","نعياً ولكن لِتجديدِ المحاذيرِ",54,"ر",1,0],["لَم يَتَمكَّن قَطُّ من قُبلةٍ","إِلا مَلولُ القَلبِ ذَوَّاقُهُ",55,"ق",2,0],["لَمْ يَتْرُكِ الوَجْدُ لي في غيرِهمْ أَمَلا","ولَم أُطِعْ فيهِمْ نُصْحاً ولا عَذَلا",56,"ل",2,0],["لم يتركِ الدهرُ لي من بعدِ فقدِهِمُ","قلباً أُجشِّمُه صبراً وسُلوانا",57,"ن",2,0],["لم يترك الموتُ منهم من يُخبِّرُني","عنهم فيُوضِحُ ما لاقَوْهُ تِبيانا",57,"ن",2,0],["لم يتصل بلثامٍ قط مبسمها","ولم ترم صلة الأطواق باللببِ",58,"ب",1,0],["لم يترُكوا في كتْمِ أمر","كَ يا مليحَ الأرضِ حيلَهْ",59,"ل",2,0],["لم يتضّح فيه النهار لأنّه","قد شيب رونقه بليل قتام",60,"م",1,0],["لم يترك الغادون لي","قلبا يُحسّ الحزَنا",61,"ن",2,0],["لم يتزخرفْ وثَنٌ لعابدٍ","منهم يُزيغ قلبَه ولا يُضِلّْ",62,"ل",1,0],["لم يتقلّدها قصيراً أوقصا","إن العلا حمائلٌ لذي الكتِفْ",63,"ف",1,0],["لم يتهجَّن غُرُّها وشُمُّها","بالبُهمِ من إمائها والفُطْسِ",64,"س",1,0],["لم يتوصَّمْني بريبٍ سرُّها","صوناً ولم يُقدَر عليَّ عارُها",65,"ر",3,0],["لم يَتَأَسَّ بنتاجٍ إذ أتت","ضيفٌ ولم تُوقَدْ لها نارُ القِرى",66,"ر",2,0],["لم يتّسعْ لك لا مالٌ ولا نشبٌ","ولم يضقْ منكَ صدرٌ لا ولا عطن",67,"ن",1,0],["لم يتركِ الوجدُ لي لمّا هويتُكمُ","في سائرِ الناسِ تأميلاً ولا أربَا",68,"ب",2,0],["لم يترُكَنْ ظالماً غيرَ العُيونِ بها","إذ لا تُجازى بما تَجنيهِ مرضاها",69,"ا",3,0],["لم يتغير واحد منهما","عما عليه كان قدماً بني",70,"ي",1,0],["لم يتغير جل وهو الذي","يغير الغير ويهدي الفريق",71,"ق",1,0],["لم يَترُكِ الدَّهرُ عيناً مِنْ أحبَّتِنا","لكِنَّهُ تَرَك الآثارَ تُشجيني",72,"ن",2,0],["لم يتخذ صاحبة ولا ولد","ولم يكن جل له كفوا أحد",73,"د",1,0],["لَم يَتَّقوا الضَربَ بِالأَكتافِ إِذ صُرِعوا","بَل النَجيعُ عَلى اللَبابِ مَنضوحُ",74,"ح",1,0]]}