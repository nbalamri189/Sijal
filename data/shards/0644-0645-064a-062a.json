c=0",""],[463,"هوَّنَ باللَّيلِ عليها الغررا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60075&r=&rc=131",""],[6318,"لآلئ الشِّعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66159&r=&rc=9",""],[5396,"السيول","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65512&r=&rc=11",""]],"verses":[["لَمْ يَتَوَسَّدْ ذِراعَ هِمَّتِهِ","إِلّا رَأى النَّجْمَ مَوْطِئَ القَدَمِ",0,"م",1,0],["لم يتطَرَّقْ عَرَصاتِ البُخّالْ","يَخْطِرُ في أثناءِ بُرْدٍ أسْمالْ",1,"ل",1,0],["لَم يَترُكا ليَ في طولِ اِختِلافِهِما","شَيئاً أَخافُ عَليهِ لَذعَةَ الحَدَقِ",2,"ق",1,0],["لم يتم الذي توخاه جوتي","لا ولم يقض ما اشتهى شكسبير",3,"ر",1,0],["لَمْ يَتَزَوَّجْ وَهْوَ شَأْنُ امْرِيءٍ","يَحْسَبُ جَهْلاً نِسْوَةَ النَّاسِ لَهْ",4,"ل",2,0],["لِمَيٍّ تَرامَت بِالحَصى فَوقَ مَتنِهِ","مَراويدُ يَستَحصِدنَ باقِيَةَ البَقلِ",5,"ل",1,0],["لم يتفق لخليفة مثلُ الذي","أعطى الإلهُ خليفةَ الأنصارِ",6,"ر",1,0],["لم يتخذ غير العلا هدفا","عن قوس هّمته إذا نزعا",7,"ع",2,0],["لم يتهم فيها الصوا","نع خِلقة الأيدي القوادرْ",8,"ر",1,0],["لَم يَترُكِ اللَهَ خَلقاً مِن بَرِيَّتِهِ","وَلَم يُعِش بَعدَهُ أُنثى وَلا ذَكَرا",9,"ر",2,0],["لم يتقدَّم دهر الكرام على","دهرك يا سيِّدي سوى حجبه",10,"ب",2,0],["لم يترك الدهر من أوقات منتظري","إلا وآخر عمر تندب الأوَّلا",11,"ل",2,0],["لم يتزوَّج حَدَثاً ناشئاً","يهتزُّ مثل الغُصُن الرَّطْبِ",12,"ب",1,0],["لِمِيتةِ السِّيْفِ قَوْمٌ يشْرُفُونَ بها","لَيْسوا من المجْدِ في غاياتِه البُعَدِ",13,"د",1,0],["لَم يَتَّفِق مِمّا جَرى في المَركَبِ","كَكَذِبِ القِردِ عَلى نوحِ النَبي",14,"ي",1,1],["لَم يَترُكِ الوَجدُ مِنها غَيرَ أَضلُعِها","وَغَيرَ دَمعٍ كَصَوبِ الغَيثِ مُنهَمِرِ",15,"ر",1,0],["لَم يَترُكِ الدَهرُ مِن قَلبي وَلا كَبِدي","شَيءً تُتَيِّمُهُ عَينٌ وَلا جيدُ",16,"د",1,0],["لَم يَترُكوا أَثَراً عَلَيهِ مِنَ الوَغى","إِلّا دِماءهُمُ عَلى سِربالِهِ",17,"ل",2,0],["لَم يَترُكوا لي صاحِباً إِلّا الأَسى","وَذَميلَ دِعبِلَةٍ كَفَحلِ نَعامِ",18,"م",1,0],["لَم يَتَّسِع لِلأَداني في أَمانَتِهِ","وَقَد رَأى خِلَلاً مِنهُم وَأُلّافا",19,"ف",2,0],["لَم يَتَّرِك وَسَطاً مِنها عَلى وَجَلٍ","إِلّا عَلى الأَمنِ مُطوِيّاً وَلا طَرَفا",20,"ف",2,0],["لَم يَترُكِ الحَدَثانُ يَومَ سَطا بِهِ","أَحَداً نَصولُ بِهِ عَلى الحَدَثانِ",21,"ن",1,0],["لَم يَتَّرِك في المَجدِ مَن جَعَلَ النَدى","في مالِهِ لِلمُعتَفينَ وَكيلا",22,"ل",2,0],["لَم يَتَّبِع شَنِعَ اللُغاتِ وَلا مَشى","رَسفَ المُقَيَّدِ في حُدودِ المَنطِقِ",23,"ق",1,0],["لَم يَترُكِ الدَّهرُ لي ما أَستَعِينُ بِهِ","عَلى التَّجَمُّلِ إِلّا ساعِدي وَفَمِي",24,"م",2,0],["لم يتركِ السيفُ منهم وَهْوَ يأخذُهم","إلا حُشَاشَة هافٍ يَسبقُ البصرا",25,"ر",2,0],["لَم يَتَّسِع مَنطِقي فيهِ بِبائِحَةٍ","حَزماً وَلا ضاقَ عَن مَثواهُ كِتماني",26,"ن",2,0],["لَمْ يُتَّخذ بَيْتٌ سِواهُ قِبْلةً","فازدَد بِذَاكَ لِمَا أَقُولُ قَبُولا",27,"ل",2,0],["لم يُترَكِ اليومَ منهم غيرُ شِرذِمَةٍ","لو أنّهم إثِمدٌ ما حُسَّ في المُقَل",28,"ل",1,0],["لم يتركوا فِيها بجَعْجاعِ الرّدَى","إلاّ النجيعَ على النجيعِ يَسيل",29,"ل",1,0],["لَم يتبع النبغاء في أفعالهم","للعَبقَرية سنة الجمهور",30,"ر",1,0],["لم يترك الدّهر من قلبي ولا كبدي","شيئاً يتيّمه عينٌ ولا جيد",31,"د",1,0],["لم يتركوا في مجال النصر متسعاً","للاحقٍ أو لباغي السبقِ مِضمارا",32,"ر",2,0],["لم يتركِ السيفُ الجوابَ لسائلٍ","أو يَنْسَ من مُترقِّبٍ ميعادا",33,"د",2,0],["لَمْ يَتَّخِذْ بَدْرَ الْمُقَنَّعِ آيةً","بَلْ جَاءَ خَاطِرُهُ بِآيَةِ يُوشَعِ",34,"ع",1,0],["لَمْ يَتْرُكَا بِرَدَاهُمَا غَيْرَ الشجَى","لأَخِيهِمَا مَا دَامَ في الأَحْيَاءِ",35,"ا",2,0],["لَم يَتَبسَّم غداةَ أَودى","إِلّا الأَعادي مَعَ السَوامي",36,"ي",1,0],["لم يَتَّخذْ من مَنارٍ يستضيءُ به","لدَى الشدائِد إلاَّ العَزْمَ والشاها",37,"ا",3,0],["لم يتخِذْ عودَه «داودُ» من خشبٍ","بل كان مُهَج العشاق يبريه",38,"ي",2,0],["لم يتخذ إلا الطبيعةَ مُرشدًا","وعلى مسائلها الدِّقاق تعلَّما",39,"م",2,0],["لم يتقِ الله امرُؤٌ للتقى","بل لنعيم الجنَّة الخالد",40,"د",1,0],["لم يتركوا للمسجد الأقصى، ولا","للعُرْب فيه مَنْسَكًا، أو مَشْعَرا",41,"ر",2,0],["لم يترك العلم منه موضعا كدرا","يمثل الشمس منه الذات والشأن",42,"ن",1,0],["لَم يَترُكِ الدَهرُ مِن قَلبي وَلا كَبِدي","شَيئًا تُتَيِّمُهُ عَينٌ وَلا جِيدُ",43,"د",1,0],["لَمْ يُتخذْ بَيْتٌ سِوَاهُ قِبْلَة","ً يَدْعُو جُنُوداً للوَغَى وخُيُولا",44,"ل",2,0],["لَم يَتَخاوَشِ مِنَ النِقابِ وَلَم","يُزرِ بِهِ قَيظُهُ وَلَم يَرِدِ",45,"د",1,0],["لَمْ يَتْرُكِ البَيْنُ لِي دُمُوعاً","أَبْكي بِها خِيفَةً لِبَيْنِ",46,"ن",1,0],["لَم يَترُكُوا فَضلَ رُمحٍ في أَكُفِّهِمُ","وَنَحنُ نَقصدُها قَرعاً فَتُخَطِينا",47,"ن",2,0],["لم يترك الدهر من قلبي ومن كبدي","شيئا تتيّمه عين ولا جيد",48,"د",1,0],["لم يَتَّرِكْ لي عشقُ شمسِ الضّحى","لَوْناً لو تَارَكْتُه ما تَرَكْ",49,"ك",1,0],["لَم يَتَنَفَّس إِلا عَلى قَدَحٍ","وَلَم يَبِت غَيرَ راكِبٍ كَفَلا",50,"ل",2,0],["لَم يَترُكِ السُقمُ مِنّي غَيرَ ما شَبَحٍ","وَلَيتَهُ كانَ يَرثي لِلَّذي تَرَكا",51,"ك",2,0],["لَم يَتَغيَّر إِن وَلي","عن الودادِ الأَوَّلِ",52,"ل",1,0],["لم يتركوها بعد ذاك وَشأنها","بل أجهزوا كي يطفئوا وَهّاجها",53,"ج",3,0],["لم يتبع لرسول اللَه صفوته","محمد المصطفى العاقب الماحي",54,"ح",2,0],["لَم يَتركنّا الأسى إن كان متّركاً","نعياً ولكن لِتجديدِ المحاذيرِ",55,"ر",1,0],["لَم يَتَمكَّن قَطُّ من قُبلةٍ","إِلا مَلولُ القَلبِ ذَوَّاقُهُ",56,"ق",2,0],["لَمْ يَتْرُكِ الوَجْدُ لي في غيرِهمْ أَمَلا","ولَم أُطِعْ فيهِمْ نُصْحاً ولا عَذَلا",57,"ل",2,0],["لم يتركِ الدهرُ لي من بعدِ فقدِهِمُ","قلباً أُجشِّمُه صبراً وسُلوانا",58,"ن",2,0],["لم يترك الموتُ منهم من يُخبِّرُني","عنهم فيُوضِحُ ما لاقَوْهُ تِبيانا",58,"ن",2,0],["لم يتصل بلثامٍ قط مبسمها","ولم ترم صلة الأطواق باللببِ",59,"ب",1,0],["لم يترُكوا في كتْمِ أمر","كَ يا مليحَ الأرضِ حيلَهْ",60,"ل",2,0],["لم يتضّح فيه النهار لأنّه","قد شيب رونقه بليل قتام",61,"م",1,0],["لم يترك الغادون لي","قلبا يُحسّ الحزَنا",62,"ن",2,0],["لم يتزخرفْ وثَنٌ لعابدٍ","منهم يُزيغ قلبَه ولا يُضِلّْ",63,"ل",1,0],["لم يتقلّدها قصيراً أوقصا","إن العلا حمائلٌ لذي الكتِفْ",64,"ف",1,0],["لم يتهجَّن غُرُّها وشُمُّها","بالبُهمِ من إمائها والفُطْسِ",65,"س",1,0],["لم يتوصَّمْني بريبٍ سرُّها","صوناً ولم يُقدَر عليَّ عارُها",66,"ر",3,0],["لم يَتَأَسَّ بنتاجٍ إذ أتت","ضيفٌ ولم تُوقَدْ لها نارُ القِرى",67,"ر",2,0],["لم يتّسعْ لك لا مالٌ ولا نشبٌ","ولم يضقْ منكَ صدرٌ لا ولا عطن",68,"ن",