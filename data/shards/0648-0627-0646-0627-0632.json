{"poems":[[0,"لمن الديار غشيتها بِسحام","https://www.aldiwan.net/poem64.html",""],[74,"أناعسة الأجفان أسهرت مكمدا","https://www.aldiwan.net/poem18553.html","الطويل"],[46,"نسائلها أي المواطن حلت","https://www.aldiwan.net/poem30567.html","الطويل"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[48,"ترنّمْ في نهارِكَ، مستعيناً","https://www.poetsgate.com/ViewPoem.aspx?id=18122",""],[366,"أيها الخل قد صحبناك دهرا","https://www.aldiwan.net/poem68109.html","الخفيف"],[505,"رأيت رسول الله سبعين مرة","https://www.aldiwan.net/poem37969.html","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48666","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64897","السريع"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113769","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94290","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114560","الرمل"],[3889,"","https://poetry.dctabudhabi.ae/diwan/poem/142952","الخفيف"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135069","الطويل"],[5763,"عيناكِ","https://www.poetsgate.com/ViewPoem.aspx?id=27062",""],[5875,"يانجد","https://www.poetsgate.com/ViewPoem.aspx?id=22694",""],[5950,"سكّر","https://www.poetsgate.com/ViewPoem.aspx?id=128151",""]],"verses":[["وَأُنازِلُ البَطَلَ الكَريهَ نِزالُهُ","وَإِذا أُناضِلُ لا تَطيشُ سِهامي",0,"م",2,0],["وإن أزهرت بيضاً وخضراً رياضها","وفاحت ففي أكمامها سحب الندى",1,"د",2,0],["وَإِن أَزَماتُ الدَهرِ حَلَّت بِمَعشَرٍ","أَرَقتَ دِماءَ المَحلِ فيها فَطُلَّتِ",2,"ت",1,0],["وإن أزَلتَ سابعَ الحُروفِ","سَمَّيتهُ إذ ذاكَ بالمَكْفُوفِ",3,"ف",1,0],["وإن أزعمتَ صاحبةً بضِرٍّ،","فأجدِر أن تروعَ بمُعرِمات",4,"ت",1,0],["وَاِن اِزدَدتَ في الصدود في الهَج","رِ فَوَاللَهِ لا أَحاول هَجرا",5,"ر",2,0],["وأن أزرَعَ الحكمَ الَّذي قد أخذْتُهُ","بوادٍ تِهامِيِّ الحِمى غيرِ ذي زَرْعِ",6,"ع",1,0],["وإن ازدهتكم مُعْلَماتُ ثيابكم","فلقد لبستم بعدهن الطينا",7,"ن",2,0],["وإِن أَزُرْ قالتْ مَتَى تَغْتَدي","وإِنْ تَسرْ قُلْتُ مَتَى نَلْتَقي",8,"ق",2,0],["وإن أزيل فهو وصل يا أخي","ومنه في نصّ القرآن يا بُنَي",9,"ي",1,0],["وإن أزمَةٌ أزَمَتهمُ طَرِبوا لها","وأمسَت لهم عُرساً عظيماً ومأتَماً",10,"م",2,0],["وإن أزمعوا التعنيف فالسيف منتضى","وليس يخاف الليث مكثرة النبح",11,"ح",1,0],["وأنا زيادُهُ مدحاً وأخذاً","برأيٍ زائدِ النفسِ نفاسَه",12,"س",2,0],["وإن ازددت في الجفاء فلا تن","كر قدومي عليك مع أعوان",13,"ن",1,0],["وإن أزعجتني عن علاك ركائي","فجودك لي حضر وبذلك لي سفر",14,"ر",1,0],["وأنا زرعتُك في دروب تعاستي","شمسًا تلوحُ لغيهبِ الأعمارِ",15,"ر",1,0],["وأنا زعيم أحساس نبضي وشانه","وسيد جنون القاف وأبليس ملعون..",16,"ن",1,0],["وأنا زبونك زمان إذا أنت تتذكّر","متساويه عندي وكل العمر ساده",17,"د",2,0]]}