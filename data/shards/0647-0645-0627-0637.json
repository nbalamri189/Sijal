{"poems":[[55,"خذوا نفثات من جوى القلب نافث","https://www.aldiwan.net/poem30663.html","الكامل"],[29,"إن الفرزدق أخزته مثالبه","https://www.aldiwan.net/poem5672.html","البسيط"],[87,"عادت أغاني العرس رجع نواح","https://www.aldiwan.net/poem21008.html","الكامل"],[30,"ولما رأيت النفس صار نجيها","https://www.aldiwan.net/poem5277.html","الطويل"],[46,"عسى وطن يدنو بهم ولعلما","https://www.aldiwan.net/poem30356.html","الطويل"],[107,"هل في جفونكما دمع لممتاح","https://www.aldiwan.net/poem43147.html","البسيط"],[107,"حميت لواء الملك فارتد طالبه","https://www.aldiwan.net/poem43425.html","الطويل"],[87,"عادت أغاني العرس رجع نواح","https://www.poetsgate.com/ViewPoem.aspx?id=478",""],[137,"أحاطت بغايات العلا والمفاخر","https://www.aldiwan.net/poem4236.html","الطويل"],[285,"خليلي إن لم تسعدا فذارني","https://www.aldiwan.net/poem60776.html","الطويل"],[287,"أنى اهتدى طيف الحبيب لمرقدي","https://www.aldiwan.net/poem32794.html","الكامل"],[434,"أرى عبد عمرو قد أساط ابن عمه","https://www.aldiwan.net/poem774.html",""],[556,"ألا بكها أم الأسى والمصائب","https://www.aldiwan.net/poem48060.html","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70742","السريع"],[181,"","https://poetry.dctabudhabi.ae/diwan/poem/81912","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79852","الخفيف"],[1718,"","https://poetry.dctabudhabi.ae/diwan/poem/44765","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206169","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58065","الطويل"],[5649,"بيات صيفى","https://www.poetsgate.com/ViewPoem.aspx?id=151474",""]],"verses":[["هُمُ أَطلَعوني بِالنَجادِ وَأَرزَموا","لِنَصرِيَ إِرزامَ المَطِيّ الرَواعِثِ",0,"ث",1,0],["هُمُ أَطلَقوا بَعدَ ما عَضَّ الحَديدُ بِهِ","عَمروَ بنَ عَمروٍ وَبِالساقَينِ أَندابُ",1,"ب",1,0],["هُم أَطلَقوا يَدَهُ كَقَيصَرَ فيهُمو","حَتّى تَناوَلَ كُلَّ غَيرِ مُباحِ",2,"ح",1,0],["هَما طَلَبا شَعرانَ حَتّى حَباهُما","بِعَضبٍ وَأَلفٍ في الصِرارِ جَميعِ",3,"ع",1,0],["هُما طَرَفا الدَهرِ الَّذي كانَ عَهدُنا","بِأَوَّلِهِ غُفلاً فَقَد صارَ مُعلَما",4,"م",2,0],["هُمُ أَطلَقوا الدَّهرَ مِن أَسرِ الفَسادِ وَهُم","ساسوا الأُمورَ فَزانوها بِإِصلاحِ",5,"ح",1,0],["هُمُ أُطعِمُوا المَوتَ الزُؤامَ وَعُلِّموا","جُنونَ السُكارى ما تَكونُ عَواقِبُهْ",6,"ب",2,0],["هُمْ أَطلَقوا يَدَهُ كَقَيصَرَ فيهُمُ","حَتّى تَناوَلَ كُلَّ غَيرِ مُباحِ",7,"ح",1,0],["هُم أطلعُوا في ليلٍ كُلِّ عجاجَةٍ","كواكبَ أطراف الرماحِ الخواطِرِ",8,"ر",1,0],["هُمُ أَطْلَقُوا بِالْجُودِ كُلَّ مَصَفَّدٍ","كَما أَنْطَقُوا بِالْحَمْدِ كُلَّ لِسانِ",9,"ن",1,0],["هُم أَطلَقوا طِرفَ الغَلاءِ فَجاءَنا","عَن طِرفِ رُخصٍ بِالفَلاةِ مُقَيَّدِ",10,"د",1,0],["هُما طَعَنا مَولاكَ في خَرجِ دُبرِهِ","وَأَقَبلتَ ما تَلوي عَلى مَحجَرٍ تَجري",11,"ر",2,0],["هُمُ أطعموا سُغبَ الصّوارم والقنا","طعاناً وضرباً من لحومِ الكتائِبِ",12,"ب",1,0],["همْ أطعموا الأضيافَ جزل القِرى","وأكرموا الوُفَّادَ قبل السؤالْ",13,"ل",1,0],["هُما طَرَفا الخَوْدَيْنِ تحت دُجُنَّةِ","مِنَ اللّيلِ وَالْكَلْبانِ مُنْطَوِيانِ",14,"ن",1,0],["هم أطالوا عمرَ السماح وأعما","رَ المواعيد قدَّروها قصارا",15,"ر",2,0],["هُمُ أَطمَعوا خاقانَ فينا فَأَصبَحَت","جَلائِبُهُ تَرجو اِحتَواءَ المَغانِمِ",16,"م",1,0],["هم أطلقوا الحزن فارتاحت جوانحهم","وما استرحتُ بحزن فيَّ مدفون",17,"ن",1,0],["هما طمعٌ ثم التداهُنُ بينكمْ","وللهِ يبدُو كلُّ شيء تَسَتَّرا",18,"ر",2,0],["هم أطفئوا الشمس في عينيك وأنتجعوا","وكر الدياجير فى مستنقع القلت",19,"ت",1,0]]}