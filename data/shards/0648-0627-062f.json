bi.ae/diwan/poem/54686","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54662","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54530","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141937","البسيط"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/5177","الرمل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142329","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54262","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54242","الخفيف"],[87,"سَمَا الْمُلْكُ مُخْتَالاً بِمَا أَنْتَ فَاعِلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=22587",""],[106,"فقيد الفصحى!","https://www.poetsgate.com/ViewPoem.aspx?id=179487",""],[106,"إلى مجلس الأمن","https://www.poetsgate.com/ViewPoem.aspx?id=179350",""],[106,"صفاء النفس!","https://www.poetsgate.com/ViewPoem.aspx?id=179324",""],[77,"دعا عزماتي والمطية والوخدا","https://www.poetsgate.com/ViewPoem.aspx?id=34096",""],[77,"سرى والدجى قد آن منه رحيل","https://www.poetsgate.com/ViewPoem.aspx?id=34205",""],[50,"إذا بلغَ الرأيُ النصيحة فاستعنْ","https://www.poetsgate.com/ViewPoem.aspx?id=1469",""],[90,"الملك حسين","https://www.poetsgate.com/ViewPoem.aspx?id=179040",""],[90,"الحزبان المتآخيان","https://www.poetsgate.com/ViewPoem.aspx?id=179105",""],[90,"وادي العرائش","https://www.poetsgate.com/ViewPoem.aspx?id=179145",""],[90,"شاغور حمانا","https://www.poetsgate.com/ViewPoem.aspx?id=179166",""],[90,"الدم يتكلم بعد عشرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=179112",""],[45,"لهَا مَنْزِلٌ بَينَ الدَّخولِ فَتُوضَحِ","https://www.poetsgate.com/ViewPoem.aspx?id=33040",""],[80,"أبادَ حياتي الموتُ إن كنتُ ساليا","https://www.poetsgate.com/ViewPoem.aspx?id=3727",""],[91,"قتل نفسه","https://www.poetsgate.com/ViewPoem.aspx?id=53071",""],[51,"عقيدَ النَّدى أطلِقْ مدائح جمّة","https://www.poetsgate.com/ViewPoem.aspx?id=27413",""],[88,"اما آن ان يغشى البلاد سعودها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19509&r=&rc=12",""],[87,"مضى \" حسنٌ \" في حلبة ِ الشعرِ سابقاً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23790&r=&rc=52",""],[3,"إذا نحنُ حالفنا شفارَ البواتر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10695&r=&rc=49",""]],"verses":[["وَأَدخُلُ البَيتَ لَم تَأذَن قَعائِدُهُ","عَلى الحَصانِ أَمامَ القَومِ وَالحُصُنِ",0,"ن",1,0],["وَأَدنوا العَليقَ إِلى المُقرَباتِ","تَقُل لَكُمُ لَيسَ إِلّا اللِجاما",1,"م",2,0],["وَأَدبَرَ الوُدُّ ما بَيني وَبَينَكُمُ","وَلِلمَوَدّاتِ إِدبارٌ وَإِقبالُ",2,"ل",1,0],["وَأَدنى أَقاصي جاهِهِ لِوَسائِلي","وَشَدَّ أَواخي جودِهِ بِرَجائي",3,"ا",2,0],["وَأَديمُ الخَدِّ مِن تَرَفٍ","بالشَّبابِ الغَضِّ مَصقولُ",4,"ل",1,0],["وَأَدنَيتَني حَتى اِنطَوى النَّاسُ كُلُّهُم","عَلى حَنَقٍ لي غائظينَ وَحُسَّدا",5,"د",2,0],["وأدْنى عَطاياهُ مَلْبونَةٌ","تُباري أعِنّتَها شُزَّبُ",6,"ب",1,0],["وإدْلاجي وجِنْحُ اللّيلِ طاوٍ","جَناحَيْهِ على نَصَبٍ وكَدِّ",7,"د",1,0],["وأدْنى رَفيقَيْهِ من الصَّحْبِ مَارِنٌ","يُباريهِ فَيْنانُ السَّبيبَةِ أدْهَمُ",8,"م",1,0],["وَأُدفِئُهُ إِذا هَبَّت شَمال","بَليلاً حَرجَفاً بَعدَ الجَنوبِ",9,"ب",1,0],["وَأَدنو إِذا ما أَبعَدوني وَأَلتَقي","رِماحَ العِدا عَنهُم وَحَرَّ الهَواجِرِ",10,"ر",1,0],["وَأَدفَعُ الهَمَّ بِالسُلوِّ إِذا","أَيقَنتُ أَنّا جارانِ في بَلَدِ",11,"د",1,0],["وَأَدِّ زَكاةَ الجاهِ وَاِعلَم بِأَنَّها","كَمِثلِ زَكاةِ المالِ تَمَّ نِصابُها",12,"ب",3,0],["وأدْهَمِ اللوْنِ إنْ أبْداكَ غُرّتَهُ","تخالُ زِنْجيّةً تفترُّ عن يَقَقِ",13,"ق",1,0],["وَأَدَّتْ عَنِ الْبَكَّاءِ سُحْبُ غَمَامَةٍ","فَرَوَّى صَدَى النَّبْتِ الْمُشِيمِ وَرَوَّانَا",14,"ن",2,0],["وَأَدِرْ فِي قَرَارَةِ الْمَاءِ قَدْ دَا","رَتْ عَلَى بَدْرِهَا مِنَ الرَّيعِ هَالَهْ",15,"ل",2,0],["وَادْخُلِ الْحيّ عِنْدَمَا رَوَّحَ الرَّا","عي وَضَمّ الْمَسَاءُ فِيهِ رِعَالَهْ",15,"ل",2,0],["وَأَدْمُعُ الشَّوْقِ خَوْفاً","مِنَ الْفِرَاقِ اسْتَهَلَّتْ",16,"ت",1,0],["وَآدَمُ لَمْ تَبْدُ فِي وَجْهِهِ","بِدَارِ الْكَرَامَةِ حَتَّى سُخِط",17,"ط",1,0],["وأدَرْتَ أفْلاكَ السِّياسَةِ فوقَهُ","فافْتَرّ في لَيْلِ الخُطوبِ نهارُهُ",18,"ر",2,0],["وَأَدفَعُ عَن أَعراضِكُم وَأُعيرُكُم","لِساناً كَمِقراضِ الخَفاجِيِّ مِلحَبا",19,"ب",2,0],["وَاِدِّلاجٍ بَعدَ المَنامِ وَتَهجي","رٍ وَقُفٍّ وَسَبسَبٍ وَرِمالِ",20,"ل",1,0],["وَأَدبَرَ كَالشَعرى وُضوحاً وَنُقبَةً","يُواعِنُ مِن حَرِّ الصَريمَةِ مُعظَما",21,"م",2,0],["وَأَدكَنَ عاتِقٍ جَحلٍ سِبَحلٍ","صَبَحتُ بِراحِهِ شَرباً كِراما",22,"م",2,0],["وَإِدلاجِ لَيلٍ عَلى خيفَةٍ","وَهاجِرَةٍ حَرُّها يَحتَدِم",23,"م",1,0],["وَأَدرَكتُ ما قَد قالَ قَبلي لِدَهرِهِ","زُهَيرٌ وَإِن يَهلِك تُخَلَّد نَواطِقُهُ",24,"ق",2,0],["وَأَدالَ مِن عَبدِ الحَميدِ لِشَعبِهِ","فَهَوى وَحاوَلَ أَن يَعودَ فَأَخفَقا",25,"ق",2,0],["وَأَدفَعُ عَنهُمُ بِشَبا يَراعٍ","يَصولُ بِكُلِّ قافِيَةٍ شَرودِ",26,"د",1,0],["وَأَديبِ قَومٍ تَستَحِقُّ يَمينُهُ","قَطعَ الأَنامِلِ أَو لَظى الإِحراقِ",27,"ق",1,0],["وَاِدعُ نَدمانَ خَلوَتي وَاِئتِناسي","وَتَعَجَّل وَأَسبِل سُتورَ الدِمَقسِ",28,"س",1,0],["وَأَدرَكَ سامي بِالجَزيرَةِ غايَةً","إِلَيها مُلوكُ القَولِ لَم تَتَطَلَّعِ",29,"ع",1,0],["وَأَدرَكتَ ما تَبغي وَشَيَّدتَ آيَةً","عَلى الشاطِئِ الغَربِيِّ في خَيرِ مَوقِعِ",29,"ع",1,0],["وَأُداري في صَونِ مالي بِعرضي","وَأَقولُ القَليلُ أَصلُ الكَثيرِ",30,"ر",1,0],["وَأَدِر ذِكرِيَ كَأساً","ما اِمتَطَت كَفَّكَ كاسُ",31,"س",1,0],["وَأَدِر هُناكَ مِنَ المُدامِ أَتَمَّها","أَرَجاً زَكا وَأَشَفَّها جِريالا",32,"ل",2,0],["وَأَدرَكَهُنَّ ثانِياً مِن عِنانِهِ","كَغَيثِ العَشِيِّ الأَقهَبِ المُتَوَدِّقِ",33,"ق",1,0],["وَأَدرَكتَ صَفوَ الوُدِّ مِنّا فَلُمتَنا","وَلَيسَ لَنا ذَنبٌ فَنَحنُ مَواذِقُه",34,"ق",2,0],["وأديرهم حتى يعود نظامهم","كالشهب في فلكٍ بها دوار",35,"ر",1,0],["وَأَدِيباً إذَا تَقَضَّتْ فُنُونٌ","مِنْ إِجَادَاتِهِ تَلْتَهَا فُنُونُ",36,"ن",1,0],["وَأَدَوَاتِ المَحْوِ وَالإِثْبَاتِ مَا","شِئْتَ اخْتِصَارَ الجُهْدِ وَالإِحْكَامَا",37,"م",2,0],["وَأَدْعُو لَكُمْ أَنْ يُقْتَدَى بِمِثَالِكُمْ","فَيُبْعَثَ فِينَا مَجْدُنَا المُتَصَرِّمُ",38,"م",1,0],["وَأَدْعُو أَنْ يُعِزَّ اللهَ مِصْراً","وَيَولِيَهَا السُّعُودَ عَلَى الدَّوَامِ",39,"م",1,0],["وَأدْرَكَ مَنْ بِجَانِبِهِ تَرَاءَى","بِطَرْفَيْهِ الكَلِيلَيْنِ اضْطِرَامُ",40,"م",1,0],["وَآدَمَ لَبّاسٍ إِذا وَضَّحَ الضُحى","لِأَفنانِ أَرطى الأَقدَحَينَ المُهَدِّلِ",41,"ل",1,0],["وَإدلاجي إِذا ما اللَيلُ أَلقى","عَلى الضُعَفاءِ أَعباءً ثِقالا",42,"ل",2,0],["وَأَدرَكَ المُتَبَقّى مِن ثَميلَتِهِ","وَمِن ثَمائِلِها وَاِستُنشِئَ الغَرَبُ",43,"ب",1,0],["وأدهمَ مثلِ الليل والبدرُ غُرّةٌ","وبالشهب في حَلْي المقلَّد مُلْجَمُ",44,"م",1,0],["وأدهمُ في مِسحِ الدُّجى متلفّعٌ","وقد خاض منه في الصباح الأسافلُ",45,"ل",1,0],["وأدركتَ في الأعداء ما أنت طالب","وبُلِّغت في الأبناء ما أنت آملُ",45,"ل",1,0],["وأدرتم فيها على العُزْل كأساً","من دماء بالغدر كانت مزيجه",46,"ج",2,0],["وأدخِنة النيران لولا اشتعالها","لم تمّ في هذا الفضاء صعودها",47,"د",3,0],["وأدّخره ليوم نَحْس تجده","مسعداً مسعفاً على الخيرات",48,"ت",1,0],["وأدَرّها غَيث اللذاذة مُنبتاً","زهر المسرة سوسناً وشقيقا",49,"ق",2,0],["وأدعَم رأسي بالأصابع مُطرِقاً","كأنّ برأسي يا أميمُّ صداعا",50,"ع",2,0],["وَأَدنِ العَلاةَ وَأَدنِ القَدومَ","وَوَسِّع لِكيرِكَ في المَقعَدِ",51,"د",1,0],["وَأَدرَكَ ثَأرَ المِسمَعَينِ بِسَيفِهِ","وَأُغضِبَ في شَأنِ الخِيارِ فَنَكَّرا",52,"ر",2,0],["وَأَدعو الإِلَهَ وَتَدعو الصَليبَ","وَأَدعو قُرَيشاً وَأَنصارَها",53,"ر",3,0],["وَأَدرَكتُ مَن قَد كانَ قَبلي وَلَم أَدَع","لِمَن كانَ بَعدي في القَصائِدِ مَصنَعا",54,"ع",2,0],["وَأَدعو اللَهَ فيكَ وَأَن يُجَلّي","عَمايَةَ ما يُزايِلُها اِنكِشافُ",55,"ف",1,0],["وَأَدَّت إِلَيكَ الهِندُ ما في حُصونِها","وَمِن أَرضِ صينِ اِستانُ تُجبى الطَرائِفُ",56,"ف",1,0],["وَأَدرَكنا الهُذَيلَ بِلافِظاتٍ","دَمَ الأَشداقِ مِن عَلَكِ الشَكيمِ",57,"م",1,0],["وَأُدني وِسادي مِن ذِراعِ شِمِلَّةٍ","وَأَترُكُ عاجاً قَد عَلِمتِ وَمِعصَما",58,"م",2,0],["وأدْنِ إلى رَبَّان هُوجاً كأنها","بحَوْصَلَ أو من وحش نَيَّانَ ربربُ",59,"ب",1,1],["وادنين البرود على خدود","يُزَيِّن الفداغِمَ بالأسيلِ",60,"ل",1,1],["وأدرَكُوادُونَه أَحَاظِيَ في","حيثُ مَدَى الوابطينَ إِذ لَغَبُوا",61,"ب",3,0],["وَأَدّى إِلَينا المَلكُ جِزيَةَ رَأسِهِ","وَفُكَّ عَنِ الأَسرى الوِثاقُ وَسُلِّموا",62,"م",3,0],["وَأَديبَةٍ إِختَرتُها عَرَبِيَّةً","تُعزى إِلى الجَدِّ الكَريمِ وَتَنتَمي",63,"م",2,1],["وَإِدريسُ ما إِن كانَ في الناسِ مِثلُهُ","وَلا مِثلُ ذي القَرنَينِ أَبنارِ عابِرِ",64,"ر",1,0],["وأدهم اللونِ حِندسيّ","في جريهِ للورى عجائِب",65,"ب",1,1],["وأدهم رهوال بقرية أربد","شلت له الأحمالَ بالرجل واليد",66,"د",1,1],["وأدخل جنةً قد عجلتْ لي","لأني بالولاءِ أمنتُ نارا",67,"ر",2,0],["وأدارت يمناكَ لي كأس درجٍ","كلن فيها المزاج مع تنسيم",68,"م",1,0],["وأدع من يدع لقا أمداحنا","وهو عنها بأياديه غني",69,"ي",1,0],["وأدههمٌ سادَ على الجيادِ","وهكذا السواد في السواد",70,"د",1,0],["وادَّكِرْني إذا استثرتَ سحاباً","ذات يومٍ عشيةً أو ضَحاءَ",71,"ا",2,0],["وأديبٌ له ثناءٌ بما يُسْ","دَى إليه وللثناء ثوابُ",72,"ب",1,0],["وادَّرِعوا من عُرْفكم جُنّةً","تَفُلُّ نابَ الدهرِ والمِخلبا",73,"ب",2,0],["وأدليتُ الدِّلاءَ فلم تَؤُب لي","بملءٍ من نَداك ولا قُرابِ",74,"ب",1,0],["وأدفع لؤماً طالما قد دفعتُه","بجهدي فأمسى عن ذَرَاكَ مزحزحا",75,"ح",2,0],["وادَّعى الإجماع فيما","كان للإجماع ضدا",76,"د",2,0],["وادَّرِعْني إلى الإمام مقالاً","فيه لي خُطْبةٌ تَكِيدُ مَكيدَكْ",77,"ك",1,0],["وادّخرْ من منطقي أحدوثةً","تنشرُ الذكر إذا الذّكر انقرض",78,"ض",1,0],["وأديمي لي الصدود وروغي","عن وصالي فمنيتي أن تروغي",79,"غ",2,0],["وأَدِلنا من زمان جائرٍ","واسمعَنْ يا رب منا وانتصف",80,"ف",1,0],["وأدل معطَشيك من أهل ريٍّ","شربوا العرف من يديك سلافا",81,"ف",2,0],["وأدلَّتْ خليقتي وبناني","حين صادفتْ حاملاً إدلالا",82,"ل",2,0],["وأدركها ضَيْمٌ فلم تَنْتَصِرْ له","فلم يشكر الله الليوث الضراغم",83,"م",1,0],["وأُديل السرورُ واللهو فيه","من جميع الهموم والأحزان",84,"ن",1,0],["وَأَدرَكَ عِلمي في سُواءَةَ أَنَّها","تُقيمُ عَلى الأَوتارِ وَالمَشرَبِ الكَدرِ",85,"ر",1,0],["وَأَدَّت إِلَينا عَهدَها أُمُّ مَعمَرٍ","فَقَد جَعَلَتنا كَالخَليطِ تُزايِلُه",86,"ل",2,0],["وَأَدبَرَ لَو قيلَ اِتَّقِ السَيفَ لَم تَخَل","ذُؤابَتَهُ مِن خَشيَةٍ إِقشَعَرَّتِ",87,"ت",1,0],["وَاِدَّعَت أَنّي خَلِيٌّ زاهِدٌ","أَنا لَو كُنتُ كَذا كُنتُ سَعيد",88,"د",1,0],["وَأَدرِ عَلى الجَلّاسِ أَكوابَ الهَوى","في راحَتَيكَ سُلافُه وَعَصيرُهُ",89,"ر",2,0],["وَأَدعو وَما ثَمَّ سامِعٍ","وَأَشكو وَلَكِن إِلى ساخِرِ",90,"ر",1,0],["وَأَدَرتُ طَرفي في الحُضو","رِ لَعَلَّ شَخصَكِ في الحُضورِ",91,"ر",1,0],["وَأَدهَشَها صَبري فَأَدهَشَني الهَوى","دَهِشتُ لِأَنَّ الزَهرَ أَدهَشَها صَبري",92,"ر",2,0],["وَأَدارَ فيهِ لَحظَهُ فَإِذا بِهِ","ضَيفٌ وَلَكِن لَيسَ كَالضيفانِ",93,"ن",1,0],["وأَدقَّ الجمالَ في طرفكِ السَّاهي","وفي ثغرِكِ الجميلِ الحَزينِ",94,"ن",1,0],["وأَدوسُ أَشواكَ الحَيَاةِ","بقلبيَ الدامي الكَسيرْ",95,"ر",1,0],["وادى النيل ما تظنيت قبلا","انك الوادي سوف تفقد سعدك",96,"ك",1,0],["وادير عيني في الفضا","ء فلا اشاهد ما يسر",97,"ر",1,0],["وأدنى الذي قد نابها من نوائب","خرابى ولولاها لما كان دانيا",98,"ي",2,0],["وأدِّ إلى الجزيريّ التحايا","وسله ينل لك الإذن العلِيا",99,"ي",2,0],["واد كحاشية النعيم وأيكة","ما للبلابل دونها أوكار",100,"ر",1,0],["وادن لدى المجلس من قاسم","وقل له محتشما في العتاب",101,"ب",1,0],["وأدم عليه شوامه","متملقين مدى الزمن",102,"ن",1,0],["وأدركني ونجم صباى عال","فخَّر النجم وازدوج الأفوال",103,"ل",1,0],["وأدع سودانها إليك يلبى","إنه كان للأعزة عبدا",104,"د",2,0],["وَأَدّوا واجِباً وَاِقضوا","حُقوقَ العَلَمِ الفَردِ",105,"د",1,0],["وَأَديبٍ فاتَهُ العِلمُ فَما","جاءَ بِالحِكمَةِ فيما نَظَما",106,"م",2,0],["وَأَديروا إِلى العَتيقِ حُسَيناً","يَبتَهِل رُكنُهُ وَتَدعو الدَعائِم",107,"م",1,0],["وَاِدفُنوهُ في القُدسِ بَينَ سُلَيما","نَ وَداوُدَ وَالمُلوكِ الأَكارِم",107,"م",1,0],["وادي النَدى وَغَيثُهُ","وَعَينُهُ المُفَجَّرَه",108,"ر",2,0],["وَاِدخِل عَلى المَوتِ الصُفوفَ مُواسِياً","وَأَعِن عَلى آلامِهِ الإِنسانا",109,"ن",2,0],["وَاِدعُ أَجيالاً تَوَلَّت يَسمَعوا","لَكَ وَاِبعَث في الأُوالي حاشِرين",110,"ن",1,0],["وَاِدفَع عَنِ المَظلومِ وَال","مَحرومِ أَبلَغَ مَن دَفَع",111,"ع",1,0],["وَاِدعُ الَّذي جَعَلَ الهِلالَ شِعارَهُ","يَفتَح عَلى أُمَمِ الهِلالِ وَيَنصُرِ",112,"ر",1,0],["وادي المُلوكِ بَكَت عَلَيكَ عُيونُهُ","بِمُرَقرَقٍ كَالمُزنِ في تَسكابِهِ",113,"ب",2,0],["وَاِدَّعاكِ اليونانُ مِن بَعدِ مِصرٍ","وَتَلاهُ في حُبِّكِ القُدَماءُ",114,"ا",2,0],["وادَّرِعْ يَلْمَقَ اجْتِيابِ دُجَى اللّي","لِ بطَرْفٍ مُضَبّرِ الأَوْصالِ",115,"ل",1,0],["وَأَدَّبَها طولُ القِتالِ فَطَرفُهُ","يُشيرُ إِلَيها مِن بَعيدٍ فَتَفهَمُ",116,"م",1,0],["وادرسوا الكتب كتبهم","إنما أحسنوا النظر",117,"ر",1,0],["وأداتنا هي لطفها","فالنطق فيها يودع",118,"ع",1,0],["وأدأبُ فيما همّهُ وهو وادعٌ","وأسهرُ فيه والعيونُ نيامُ",119,"م",1,0],["وأدركتَ ثأرَ الدينِ من متمرِّدٍ","طغَى وهو شَخْتُ المنصبينِ ضئيلُ",120,"ل",1,0],["وأدَّاهُ من بعدِ التجارب رأيُهُ","إِلى أن عصَى حُكْمَ الحِجَى فتغابَى",121,"ب",2,0],["وَإِدراكَنا في ظِلِّهِ كُلَّ بُغيَةِ","مِنَ العَيشِ فاقَت سامِياتِ المَطالِبِ",122,"ب",1,0],["وَأَدبَرَ مَنكوباً بِرَأيٍ مُضَعَّفٍ","إِلى الكَرَجِ القُصيا وَوَجهٍ مُقَبَّحِ",123,"ح",1,0],["وَإِدبارِ عُبدوسٍ وَقَد عَصَفَت بِهِ","صُدورُ سُيوفِ الهِندِ وَالأَسَلِ السُمرِ",124,"ر",1,0],["وَأَدَّيتَ مِن بادورِياءَ وَمَسكِنٍ","خَراجِيَ في جَنبَي كِنابٍ وَتَعمِرِ",125,"ر",1,0],["وَأَدنى بَني عَمّي إِلَيَّ وَإِنَّما","دُنُوُّ اِبنِ عَمّي أَن يَكونَ صَديقي",126,"ي",1,0],["وادِعٌ مِن كِفايةٍ وَهوَ بِالمُل","كِ وَتَوفيرِ حَظِّهِ مَشغولُ",127,"ل",1,0],["وَأَدمُعُنا اللاتي عَفاكِ اِنسِجامُها","وَأَبلاكِ أَم صَوبُ الغُيوثِ السَواجِمِ",128,"م",1,0],["وَأَدرَكتَ مَن قَد كانَ قَبلَكَ عامِلاً","بِضِعفَينِ مِمّا قَد جَبى غَيرَ راهِقِ",129,"ق",1,0],["وَآدَمَ قَد أَخرَجتَهُ وَهوَ ساكِنٌ","وَزَوجَتَهُ مِن خَيرِ دارِ مُقامِ",130,"م",1,0],["وَإِدلاجي إِذا الظَلماءُ جارَت","إِلى طَردِ النَهارِ دُجى الظَلامِ",131,"م",1,0],["وآدابٌ جَلِيَّاتٌ","دَقيقاتٌ مَعانيها",132,"ي",3,0],["وأدهَمَ يُسْفِرُ عَنْ ضِدِّهِ","كما سَفَرَ اللَّيلُ إذا وَدَّعا",133,"ع",2,1],["وأُدْمٍ إذا رامَ ظُلمَ الفِرا","قِ عُذْنَ بِفَيْضِ الدُّموعِ انتصارا",134,"ر",2,0],["وَأَدْنَى المُحبِّين مِنْ نحبِه","مُحِبٌّ بكى يومَ بَيْن حَبيبا",135,"ب",2,0],["وأدناها من الصبِّ التنائي","كذاكَ الشمسُ يُدنيها الغروبُ",136,"ب",1,0],["وَأَدنى بَني الدُنيا إِلى الغَيِّ وَالعَمى","لَمَن يَبتَغي مِنها سَناها وَمَجدَها",137,"د",3,0],["وادي الحَياةِ مَحَلٌّ لا مُقامَ بِهِ","لِنازِليهِ وَوادي المَوتِ مَحلولُ",138,"ل",1,0],["وَاِدفَع بِصَمتِكَ عَنكَ خاطِرَةَ الخَنا","حَذَرَ الجَوابِ فَإِنَّهُ بِكَ أَشبَهُ",139,"ه",1,0],["وَأَدارَ الفِرزانَ في بَيتِ صَدرِ ال","شاهِ نَقلاً يَظُنُّهُ غَيرَ شَينِ",140,"ن",1,0],["وادٍ حَريريُّ الرِياضِ فَكَم بِهِ","مِن حارِثٍ يَغدو بِهِ وَهُمامُ",141,"م",1,0],["وَأَدهَمٍ يَقَقِ التَحجيلِ ذي مَرحٍ","يَميسُ مِن عُجبِهِ كَالشارِبِ الثَمِلِ",142,"ل",1,1],["وادٍ إِذا مَرَّ نَسيمٌ بِهِ","تَعَطَّرَت بِالمِسكِ أَردانُه",143,"ن",2,0],["وَأَدهَمُ اللَيلِ مِنهُ قَد جَفَلا","وَقَد أَتى رائِدُ الصَباحِ عَلى",144,"ل",2,0],["وأدعو بنيها سّيداً بعد سيّدٍ","ومن بعدهم أصبحتُ همّاً مواليا",145,"ي",2,0],["وأدْهَمَ يَنهَبُ عُرْضَ المدَى","ويجري به كلّ عِرْقٍ كريم",146,"م",1,1],["وأدقّ منهُ فِكرَةً حسبيّةً","حكميَّةَ الإصدارِ والإيرادِ",147,"د",1,0],["وأدِرْ حمراءَ يسري لُطُفاً","سُكْرُها منْ شمِّها في كلّ صَاح",148,"ح",1,0],["وَأَدَّخِرَ التَقوى بِمَجهودِ طاقَتي","وَأَركَبَ في رُشدي خِلافَ هَوائِيا",149,"ي",2,0],["وادٍ مِنَ السُلطانِ مُحمىً لَم يَكُن","لِيَضيمَ فيهِ المُلكَ إِلّا الدينُ",150,"ن",1,0],["وَأَدخَلوا حينَ جَدَّ الأَمرُ أَيدِيَهُم","لِلشَرِّ في جَفنَةٍ مَملُوءَةٍ بِدَمِ",151,"م",1,0],["وَأَدَرْنَا الْكُؤُوسَ حَتَّى تَوَلَّتْ","أَنْجُمُ اللَّيْلِ مِنْ أُحَادَ وَمَثْنَى",152,"ن",2,0],["وَادٍ سَرَى فِي جَوِّهِ كَنَسِيمِهِ","وَبَكَى عَلَى أَغْصَانِهِ كَحَمَامِهِ",153,"م",2,0],["وَأَدْرَكَ فِي الأَمْثَالِ أَحْمَدُ غَايةً","تَبُزُّ الْخُطَى مَا بَعْدَهَا مُتَقَدَّمُ",154,"م",1,0],["وادّرعْ جداً وكداً واجتنبْ","صحبةَ الحمقى وأربابِ البخلْ",155,"ل",1,0],["وادَّعى فيَّ ولاءً قلتُ لا","أنتَ مِنْ سرمينَ واسمي عمرُ",156,"ر",1,0],["وادي المعرةِ في النفوسِ معظَّمٌ","لا سيَّما زمنُ الربيعِ المقبلِ",157,"ل",1,0],["وادي فضالتِها وبابُ شبابها","كفلا لساكنِها بسعدٍ مكْمَلِ",157,"ل",1,0],["وَأَدهَمَ مِن جِيادِ الماءِ مُهرٍ","تَنازَعُ جُلَّهُ ريحٌ رَخاءُ",158,"ا",2,0],["وَأَدهَمُ لَولا أَنَّهُ راقَ صورَةً","لَما عَرَفَتهُ العَينُ مِن لَيلَةِ الهَجرِ",159,"ر",1,0],["وَأَدبَرَ لا يَلوي عَلى مُتَعَذِّرٍ","حِذارَ فَتىً يَسري إِلَيهِ فَيُسرِعُ",160,"ع",1,0],["وَأَدهَمٍ فَضَّضَ التَحجيلُ أَكرُعَهُ","كَما تَعَلَّقَ بَدءُ الصُبحِ بِالغَسَقِ",161,"ق",1,0],["وَأَدهَمَ مِن لَيلِ السَرى قَد رَكِبتُهُ","وَأَودَعتُ أَسرارَ السَرى صَدرَ نائِمِ",162,"م",1,0],["وَأُديمَ نَحوَ مُحَدِّثي لِيَرى","أَن قَد فَهِمتُ وَعِندَكُم عَقلي",163,"ي",1,0],["وَأَدنَيتِني حَتّى إِذا ما فَتَنتِني","بِقَولٍ يَحِلُّ العَصمَ سَهلَ الأَباطِحِ",164,"ح",1,1],["وأدنيتَ من آمالهِا الغُرِّ ما لوى","يَدَ الدّهرِ جافيه وأعياهُ نازِحُهْ",165,"ح",2,0],["وادي النَّوى اختطّتْ به لذويِ الأَسَى","مَسْرَى الهُمومِ ومَسرحَ الأحزانِ",166,"ن",1,0],["وَأَدنى العُيونِ مِنَ النَومِ عَينٌ","تُميتُ طِوالَ اللَيالي سُهادا",167,"د",2,0],["وَأَدركت نَصراً ما رَمَت ساحَةُ الوَغى","بِأَمواجها حَتّى رَمَتها غَوارِبُهْ",168,"ب",2,0],["وأدُّوا إليهِ المالَ لا تَبخلُوا به","ولا تغدروا فالبأسُ يَقظانُ دائبُ",169,"ب",1,0],["وادِي القرى التَفَّ على رَوْعَةٍ","يا وَيْحَ للمُرتاعِ ماذا يَرَى",170,"ر",2,0],["وأَدَّى ما أعَدَّ القومُ فيهِ","فأمسَى بين أعْيُنِهمْ نِهابا",171,"ب",2,0],["وَإِدراكُ الدينِ الَّذي قَد طَلَبتَهُ","وَلَم تَكُ عَن تَوحيدِ رَبِكَ ساهِيا",172,"ي",2,0],["وَأَدَّت إِلَيَّ القَولَ عَنهُنَّ زَولَةٌ","تُخاضِنُ أَو تَرنو لِقَولِ المُخاضِنِ",173,"ن",1,0],["وَأُديرَت حفُفٌ تَحتَها","مِثلُ قُسطانِيِّ دَجنِ الغَمام",174,"م",1,0],["وَأَدَلّ في عِظَةٍ عَلى ما لَم يَكُن","أَبَداً لِيَذهَنَهُ ذَوو الأَبصارِ",175,"ر",1,0],["وَأَدخُلُ وَجرَهُ أَمشي بِكَفّي","حُسامُ الحَدِّ ماضي الشَفرَتَينِ",176,"ن",1,0],["وَأَدهَمَ قَد جُبتُ جِلبابَهُ","كَما اِجتابَتِ الكاعِبُ الخَيعَلا",177,"ل",2,0],["وَأَدماءَ حُرجوجٍ تَعالَلتُ موهِناً","بِسَوطِيَ فَاِرمَدَّت نَجاءَ الخَفَيدَدِ",178,"د",1,0],["وَأُدمٍ كَأَرآمِ الظِباءِ وَهَبتَها","مَراسيلَ مَشدودٍ عَلَيها رِحالُها",179,"ل",3,0],["وَأُدخِلَ الصَفّارُ شَرَّ مَدخَلِ","يَإِنُّ مِن عَصِّ حَديدٍ مُثقِلِ",180,"ل",1,0],["وَأَدرَكَ مِنها الآخَرونَ بَقيَّةً","مِنَ الرَوحِ في جِسمٍ أَضَرَّ بِهِ النَهكُ",181,"ك",1,0],["وَأَدنى مَجلِسِ العُوّادِ مِنّي","سَقامٌ ظَلَّ يُخبِرُهُم بِباسي",182,"ي",1,0],["وَآدابُ النُّبُوَّةِ مُعجزاتٌ","فكيف يَنالُها الرجُلُ الأديبُ",183,"ب",1,0],["وأَدْعُو سِفاهاً غيرَ آلِكَ سادتي","وهلْ أنا إنْ وُفِّقتُ إِلَّا لهُمْ عَبْدُ",184,"د",1,0],["وَأَدْرَكَ السُّؤلَ لَمَّا قامَ مُجْتَهِداً","وَما بِكلِّ اجتهادٍ يُدْرَكُ السُّولُ",185,"ل",1,0],["وأدرك راج منك ما هو طالب","وأعطيَ دهرٌ منك ما هو آمل",186,"ل",1,0],["وأدْنَيْتَها بالإذْنِ حتى كأنّمَا","تَخَطّتْ إليكَ السيْفَ والسيْفُ قائم",187,"م",1,0],["وأدركتَ سُولاً في ابن واسول عَنوةً","وَزَحزَحتَ منه يذبُلاً فتزَحزَحا",188,"ح",2,0],["وَأَدبَرَ اللَيلُ في مُعَسكَرِهِ","مُنصَرِفاً وَالصَباحُ قَد لاحا",189,"ح",2,0],["وَأَدنِ عَلى القُربى المُقرِّبَ نَفسَهُ","وَلا تُشهِدِ الشُورى اِمرَأً غَيرَ كاتِمِ",190,"م",1,0],["وَاِدعُ قَومي بِأُمِّ عَمروٍ فَإِنّي","عاقِدٌ حُبَّها عَلَيَّ وِشاحا",191,"ح",2,0],["وَأَدنى رِشاءً لِلعِراقي وَلمَ يَكُن","شَريعاً إِذا نَصَّ البَيانُ وَلا خِلبا",192,"ب",2,0],["وادٍ مِنَ المَوتِ الزُؤامِ وَكُلُّنا","أَشفى لِيُدفَعَ فَوقَ جُرفِ الوادي",193,"د",2,0],["وَاِدَّعوا لِل مُعَمِّرينَ أُموراً","لَستُ أَدري ما هُنَّ في المَشهورِ",194,"ر",1,0],["وَآدَمُ وَلّى عَن بَنيهِ بِحَسرَةٍ","وَوَدَّعَ شَيثٌ أَهلَهُ وَأَنوشُ",195,"ش",1,0],["وَأَدرَكوا بِدعاويهم مَدى زُحَلٍ","مِنَ الرُغامِ بِما قاسوهُ أَو ذَرَعوا",196,"ع",3,0],["وَاِدَّعى الهَديَ في الأَنامِ رِجالٌ","صَحَّ لي أَنَّ هَديَهُم طُغيانُ",197,"ن",1,0],["وَأَدواءٌ ثَوى بُقراطُ مَيتاً","وَجالينوسُ فادَ وَما دَراها",198,"ا",3,0],["وَأَدماءَ مِثلَ الفَحلِ يَوماً عَرَضتُها","لِرَحلي وَفيها جُرأَةٌ وَتَقاذُفُ",199,"ف",1,0],["وأَدرَكتُمُ مُلكاً خَلَعتُم عِذارَنا","كَما خَلَعَ الطِّرفُ الجَوادُ المُجرَّبُ",200,"ب",1,0],["وأَدخلَ الطاعةَ في مكان","لم يدْرِ قطُّ طاعةَ السُّلطانِ",201,"ن",1,0],["وأدمُعٌ هَمَلَتْ لولا التنفّس مِن","نارِ الهَوى لم أكدْ أنجو من اللُّجَجِ",202,"ج",1,0],["وادّراعي حلّلَ النّقْعِ ولي","عَلَمَاهُ عِوَضٌ عن عَلَمي",203,"ي",1,0],["وادعُني غيرَ دَعِيٍّ عَبْدَها","نِعْمَ ما أسمو بِه هذا السُّمَي",203,"ي",1,0],["وادع القوافيَ يقرب","نَ منك وهي سراع",204,"ع",1,0],["وأدرَّت عَلى الرياض شعاعاً","لجَّ في لثم مبسم الأزهار",205,"ر",1,0],["وأُدخِلَ في دار بها شُرَطٌ لها","رَئيسٌ علي كرسيِّه متربع",206,"ع",1,0],["وادخرنَّ في الحَيا","ة للرَزايا جلدا",207,"د",2,0],["وأدِرْها نغماً في أُذني","فاض من بين سحابٍ وجبالِ",208,"ل",1,0],["وادي الهوى ولَّتْ بشاشةُ دهرهِ","وخَلَت مغانيهِ من الآرامِ",209,"م",1,0],["وأَدارَ كُلُّ صَغِيرِ قَدْ","رِ المُنْتَهَى أَرْحى العَظَائِمْ",210,"م",1,0],["وَأُدفِئُهُ إِذا هَبَّت شَمالاً","بَليلاً حَرجَفاً بَعدَ الجَنوبِ",211,"ب",1,0],["وَأَدْرَكْتَ فِي عَصْرِ الشَّبِيبَةِ غَايَةً","مِنَ الْفَضْلِ لَمْ يَبْلُغْ مَدَاهَا الأَفَاضِلُ",212,"ل",1,0],["وَأَدْنَى هُمُومِي أَخَّرُوا","مِنَ القَوْلِ فِيهِ وَمَا قَدَّمُوا",213,"م",3,0],["وَأَدْرَكْتَ فِي العَلْيَاءِ أَبعَدَ غَايَةٍ","لِيَقْظَانَ دَاجِي الهَمِّ مُتَّقد الفِكْرِ",214,"ر",1,0],["وَأَدَارَ كِسْرَى فِي الجَمَاعَةِ طَرْفهُ","فرَأَى فَتَاةً كَالصَّبَاحِ جَمَالاَ",215,"ل",2,0],["وَادْعُ الأُسَاةَ وَنُطْ بِمَا","يَصِفُونَ مِنْ حِيَلٍ رَجَاكْ",216,"ك",1,0],["وأَدْرَكَهَا فِي رَوْضَةٍ فَخَلاَ بِهَا","بِمَرْأَى رَقِيبٍ لِلْعَفَافِ وَمَسْمَعِ",217,"ع",1,0],["وَأُدِيرَتْ بِمَا يُبَددُهُ الْمَاءُ","وَأَنْفَاسُهُ الطَّلِيقَةُ حَرَّى",218,"ر",2,0],["وَادّعَى الْوِزْرَ وَقَاضَى وَقَضى","غَيْبَةً إِنْ كَانَ أَوْ لَمْ يَكُ وِزْرَا",219,"ر",2,0],["وآدَابُ نفسٍ لوْ توَزَّعَ حسْنُهَا","عَرَاءٌ لأَضْحَى وَهْوَ كالرَّوْضِ مُزهِرُ",220,"ر",1,0],["وَأَدِيباً بَيْنَ السَّرَاةِ غَرِيباً","جَاءَ فِي جِيلِهِ مِنَ الأَفْرادِ",221,"د",1,0],["وَأَدَرْتِ الشُّؤُونَ أَحْسَنَ مَا","كَانَ خَبِيرٌ إِدَارَةً للشُّؤُونِ",222,"ن",1,0],["وَأَدِيبَةٍ بَلَغَتْ مَدَى مَطْلُوبِهَا","فِي العِلْمِ مِنْ مُستَطْرَفٍ أَوْ مُتْلَدِ",223,"د",1,0],["وَادْعُ لَهُ بِالْبَقَاءِ حَتَّى","يُتِمَّ قُدْسِيَّةَ الْفُتُوحِ",224,"ح",1,0],["وَأَدَقُّ النَّاسِ فِي تَقْدِيرِهِ","طَالَمَا غُمَّتْ عَلَيْهِ التَّبِعَاتُ",225,"ت",1,0],["وَأَدَامَ الأعْيَادَ فِي بَيْتِكَ العَا","مِرِ بِالبِرِّ وَالنَّدَى مَا شَاءَ",226,"ا",2,0],["وأدهشَ الأرضَ منه عندما نظرت","إليه .. كيف مشت إحدى رواسيها؟",227,"ي",3,0],["وادِعٌ يَلعَبُ بِالدَهرِ إِذا","جَدَّ في أُكرومَةٍ قُلتَ هَزَل",228,"ل",1,0],["وأدّت رسالتها حرّة","إلى أقرب الكون والأبعد",229,"د",1,0],["وأدرك مصراً من بنيك صَوارمٌ","مواضٍ إذا اشتد الزمانُ صِلاَب",230,"ب",1,0],["وَأَدْتْنا بناتُه برَزَايا","هَا ومَنْ ذا يسطيع وَأدَ بَنَاته",231,"ت",2,0],["وَ أدركتَ في عصرِ الشبيبة ِ غاية","ً منَ الفضلِ لمْ يبلإْ مداها الأفاضلُ",232,"ل",1,0],["وأدَّى رسالتهُ في الحياة","ولولا الردى، لتوخى المزيدا",233,"د",2,0],["وأدِّبُوا مَنْ عصاكم بالسلاح؛ فقد","يُقَوِّمُ الأنفسَ المُعْوَجَّةَ الأدب",234,"ب",1,0],["وأدركتِ الذي لا تحتويه","بطونُ الكُتْبِ من شَتَّى العلوم",235,"م",1,0],["وأدت في الله العشيرة جهدها","فجادلتها بالحق السنة اللدا",236,"د",2,0],["وأدار على الأغصان راح ارتياحه","فغادر أعطاف الغصون تميل",237,"ل",1,0],["وأدن ِعلى القربى المقرّبَ نفسه","ولا تُشهد الشورى امرءا غير كاتم ِ",238,"م",1,0],["وأدخلْ عليها فرحةً فهي بَلْدةَ","بها ثارت الأتراحُ ثورةَ مُحنَق",239,"ق",1,0],["وأدمغةٌ جبارةٌ يُلتجى لها","اذا انتاب محذورٌ أو اعتاضُ مُشْكل",240,"ل",1,0],["واد هو الجَّنةُ المحسودُ داخلُها","أو أنَّه من جِنان الخُلدِ محسود",241,"د",1,0],["وادٍ تَلَفَّت ناشئاً فاذا به","بين الجبال تكفَّلَته حَنانا",242,"ن",2,0],["وادعيتم مستقبلاً لو رأته","هكذا لم تضع عليه صُواعاً",243,"ع",2,0],["وأدْبَرَ مَنْكُوباً برأيٍ مُضَعَّفٍ،","إلى الكَرَجِ القُصْا وَوَجهٍ مُقَبَّحِ",244,"ح",1,0],["وأدعو بينها سيّدا بعد سيّدٍ","ومن بعدهم أصبحتُ همّاً مواليا",245,"ي",2,0],["وأدعو وما ثمّ من سامع ،","وأشكو ، ولكن إلى ساخر",246,"ر",1,0],["وأدفع لؤماً طالما قد دفعتُه","بجهدي فأمسى عن حَرَاكَ مزحزحا",247,"ح",2,0],["وادخنة النيران لولا اشتعالها","لما تمَّ في هذا الفضاء صعودها",248,"د",3,0],["وَأَدْرَكَ فِي الأَمْثَالِ «أَحْمَدُ» غَايَة ً","تبذُّ الخطى ، ما بعدها متقدمُ",249,"م",1,0],["وأدنو إذا ما أبعدوني وألتقى","رِمَاحَ العِدى عنْهمْ وحَرّ الهواجر",250,"ر",1,0]]}