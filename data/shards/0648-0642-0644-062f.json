s://poetry.dctabudhabi.ae/diwan/poem/123794","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83406","الطويل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28782","السريع"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113828","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120222","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139630",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139629",""],[4852,"طال اعتكافي","https://www.poetsgate.com/ViewPoem.aspx?id=214517",""],[4862,"أيا عمرو بن هندٍ لاتلمنا","https://www.poetsgate.com/ViewPoem.aspx?id=55366",""],[4119,"وقلدتني طوق الحمامة منه","https://www.poetsgate.com/ViewPoem.aspx?id=16121",""],[5183,"نكبات الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=186413",""],[308,"أجوهر أم كَلَام","https://www.poetsgate.com/ViewPoem.aspx?id=189198",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5464,"طرقنا بابكم فأجاب صمت","https://www.poetsgate.com/ViewPoem.aspx?id=6677",""],[5550,"يا ابن الوجود","https://www.poetsgate.com/ViewPoem.aspx?id=211770",""],[5720,"رَثَتْكَ بيوتُ اللهِ (*)","https://www.poetsgate.com/ViewPoem.aspx?id=203033",""],[5865,"هذيان...","https://www.poetsgate.com/ViewPoem.aspx?id=179829",""]],"verses":[["وقلَّدْتُهُ مَدْحاً يَروضُ لهُ الحِجَى","قَوافيَ لا تُعطي القِيادَ على القَسْرِ",0,"ر",1,0],["وقلَّدْتَنا نَعماءَ كالرَّوض عانَقَتْ","أزاهيرَهُ ريحُ الصَّبا غِبَّ أمْطارِ",1,"ر",1,0],["وقُلِّدَ جيدُ المُلْكِ منّي قِلادَةً","وكمْ زانَ حُسْنُ الجِيدِ حُسْنُ المُقلَّدِ",2,"د",1,0],["وَقَلَّدتني مِن جَوهَرِ الفَضلِ خالِداً","وَيَفنى الَّذي مِن عَسجَدٍ وَلُجَينِ",3,"ن",1,0],["وَقَلَّدَكُمْ مِنْ خَالِدَاتِ ثَنَائِهِ","قَلائِدَ مِنْ دُرٍّ فَرِيدٍ وَعِقْيَانِ",4,"ن",1,0],["وَقَلَّدتَني لَمّا اِبتَدَأتَ بِمِدحَتي","يَداً لا أُوَفّي شُكرَها أَبَدَ الدَهرِ",5,"ر",1,0],["وَقَلَّدتُ الدَعِيَّ لَهُم شَناراً","إِلى يَومِ التَغابُنِ وَالخِصامِ",6,"م",1,0],["وقلَّدتني شرفٌ من النظمِ نعمةً","أنرت بها ما بين غرب ومشرق",7,"ق",1,0],["وقُلِّدتُ شُغْلاً ضَرُّهُ لي معَجّلٌ","سريع وأمّا نفعه فمؤخر",8,"ر",1,0],["وَقُلِّدَ عاراً وَهوَ دُرٌّ مُنَظَّمٌ","وَأُلبِسَ حُزناً وَهوَ بُردٌ مُفَوَّفُ",9,"ف",1,0],["وَقَلَّدَتني في الهَوى مِنَّةً","يا شُكرَها مِنّي وَيا حَمدَها",10,"د",3,0],["وَقَلَّدتُها الدُرَّ الثَمينَ وَإِنَّهُ","لَعَمرُكَ شَيءٌ أَنكَرَتهُ رِقابُها",11,"ب",3,0],["وَقَلَّدَني السُلطانُ مِنهُ بِأَنعُمٍ","أَخَفَّ بِها نَهضي وَإِن أَثقَلَت ظَهري",12,"ر",2,0],["وَقَلَّدَت أَجيادَ تِلكَ الرُبى","دُرّاً مِنَ النُوّارِ مَنثورا",13,"ر",2,0],["وقلَّدها الياقوتَ كالجمرِ أحمراً","يُضيءُ سَناهُ والزُّمرُّدَ أخضرا",14,"ر",2,0],["وقلده الرّماةُ بأرجوانٍ","وعاد شبابه رحضاً غسيلا",15,"ل",2,0],["وَقَلِّدُوا أَمْرَكُمْ شَهْماً أَخَا ثِقَةٍ","يَكُونُ رِدْءاً لَكُمْ فِي الْحَادِثِ الْجَلَلِ",16,"ل",1,0],["وَ قلدوا أمركمْ شهماً أخا ثقة ٍ","يكونُ رداءً لكمْ في الحادثِ الجللِ",17,"ل",1,0],["وقلَّدَتْهُمْ على العمياء جَمهرةٌ","تمشي على غير قصدٍ خبطَ عشواء",18,"ا",2,0],["وقَلَّدتُه عَن مَن سِوَاهُ لأنَّهُ","مُقَلِّدُهُ في كُلِّ مَا قَالَ يُعذَرُ",19,"ر",1,0],["وَقَلَّدَ العَضبَ عَضباً طالَما اِنكَشَفَت","بِهِ صُنوفُ الأَذى وَاِنجابَتِ الكُربُ",20,"ب",1,0],["وَقَلَّدَ الأَمرَ مَيموناً نَقيبَتُهُ","لِلهَولِ مُقتَحِمٌ بِالنَصرِ مُشتَمِلُ",21,"ل",1,0],["وقلدتني كفه صنيعة","صيرتها عقداً لنحر الدهر",22,"ر",1,0],["وقلدتني النعما التي غيرت أخي","علي فأمسى قلبه يتلهب",23,"ب",1,0],["وقلدتم من صار للناس ضحكة","بتأويله المعوج فالكل يعجب",24,"ب",1,0],["وَقَلَّداني مِنَّةً لَو قُرِنَت","بِشُكرِ أَهلِ الأَرضِ عَنِّي ما وَفى",25,"ا",1,0],["وَقَلَّدُوا الأَمرَ مِنّا ماجِداً نَجداً","يَشفي وَيَكفي إِذا ما حادِثٌ دَهَما",26,"م",2,0],["وَقَلّدها مِن دمعِ يَعقوبَ إِذ همى","قَلائدَ دُرٍّ بِالبَهاءِ مُرصَّفِ",27,"ف",1,0],["وَقلّدهُ مَن لَم يُبالوا بدينهم","لِكَيما يقولَ الناسُ إنّ لهم عذرا",28,"ر",2,0],["وقلدت سيف العدل في الحكم فاقتدت","بك الناس اذ صرت الامام المقلدا",29,"د",2,0],["وقلدتُها يمناي طوقاً ولم أزلْ","أذيل دموعاً وهي من محجري قَطْرُ",30,"ر",1,0],["وقلَّدْتَهُ أَمرَ الخلافةِ والورى","وصرَّف في تدبيره النهَى والأَمرا",31,"ر",2,0],["وَقَلَّدنَ بِالدُرِّ تِلكَ اّلثُغورَ","وَحَمَّلنَ كُلَّ قَضيبٍ هِلالا",32,"ل",2,0],["وَقَلَّدَني مِنَ الإِحسانِ عَضباً","عَلى نُوَبِ الزَمانِ بِهِ أَصولُ",33,"ل",1,0],["وقلدتني أيادي فضله نعما","إقلالها عند أهل العصر إكثار",34,"ر",1,0],["وقلدتم الأعناق مناً ولا أرى","فتى منكم إلا ثناءً مقلدا",35,"د",2,0],["وقَلَّدَهُ العَهْدَ الإمَامِيَّ راضِياً","بِسيرَتِه الحُسْنَى وآثارِهِ الغُرِّ",36,"ر",1,0],["وَقَلّدهم لَمّا كَساهُم فَلا تَرى","سوى العضْبِ حَلاهُ النُّضارُ عَلى العَصْبِ",37,"ب",1,0],["وَقلَّدته يدُ الحسناءِ عاتقَها","ما أبتُ من غُصنٍ إلّا إلى غصنِ",38,"ن",1,0],["وَقلَّدتُ جيدي من تقاصير نظمها","عقودَ لآل فذَّةٍ وتؤامِ",39,"م",1,0],["وَقلَّدوكِ أَمرَهمْ","وَذاك أَعلى الرتب",40,"ب",1,0],["وقل ديني الإسلام والهادي أحمد","نبي حبيب اللَه أفضل مرسل",41,"ل",1,0],["وقلّده الفنُّ تاج الخلود","وما الفنُّ إلا الوجودُ الكبير",42,"ر",1,0],["وَقَلّدك الأَمر سُلطاننا","فنوَّلَه مِثلَما نَوَّلك",43,"ك",1,0],["وَقلّدتَ جيد المَجد عقد مَحامدٍ","زَها بَهجَةً مِنهُ بِجَوهره الدرُّ",44,"ر",1,0],["وقلّد َسيَف الرأْيِ صَدرَك فاغتدَى","سلاحُ فتوحِ الأرضِ عندَك شاكا",45,"ك",2,0],["وقلدنا قسطاس حقٍّ محرَّرٍ","وسيطاً بعدلٍ بين شارٍ وبائع",46,"ع",1,0],["وقلّدتَ أجياد القريض لآلِئاً","ولا عجبٌ فالدرُّ معدِنُه البَحرُ",47,"ر",1,0],["وقُلِّدتَ أمراً أَنْتَ في النَّاس أهلُه","ولا منصب في الحكم إلاَّ له أهل",48,"ل",1,0],["وقَلِّدْ نَحْرَ عيدِ النَّحْرِ عِقْدًا","قَرَنْتَ به أَيادِيَكَ الثِّقالا",49,"ل",2,0],["وقلّدتَ أَجيادَ القصورِ جواهراً","من الفضلِ والإِفضالِ مُحْكَمَةَ النَّظْمِ",50,"م",1,0],["وقَلَّدْناهْ دُرًّا جاءَ منه","كذاك الدُّرُّ جاءَ من البُحورِ",51,"ر",1,0],["وقلَّدْتَ الطُّروسَ به كلاماً","يُفَصَّلُ في التَّرائِبِ أَم جُمَانا",52,"ن",2,0],["وقلّد نحرَ عيدَ النحرِ عيداً","من الأفضالِ أنت به حريُّ",53,"ي",1,0],["وقَلَّدَتْهُ تُجيبٌ حَلْيَ سابقها","حَتَّى غدا السابقَ المتبوعَ تابعُهُ",54,"ع",2,0],["وقلَّدتَهُ سيفَ رأيٍ وحزمٍ","يضيءُ الظلامَ ويأبى الظُلامَهْ",55,"م",2,0],["وقلَّدْتَ والي العهدِ سَيفاً إِلَى العِدى","فسارَ كَأَنَّ الشمسَ قُلِّدَتِ البرقا",56,"ق",2,0],["وقُلِّدنَ دُرّاً تحدَّيْنَ عنه","كأنّ قلائدَهنَّ النحورُ",57,"ر",1,0],["وقلَّد سيفَه بيدَيْه سيفاً","طويلُ نجادِهِ عنه قصيرُ",58,"ر",1,0],["وقلدها شريط العز فخرا","فبات الشأن مرفوع المنار",59,"ر",1,0],["وقلده أعباء كل مكون","وطوقه الأحمال رحماه نشهد",60,"د",1,0],["وقلّدْتَ في عقدِ المكارِمِ جيدَها","ووشّحْتَ منها في صنائِعِكَ الخَصْرا",61,"ر",2,0],["وقلده ابن سبع سنين أمراً","تدين له الحواضر والبوادي",62,"د",2,0],["وَقَلَّدَني ما لا أُطيقُ إِذا وَنَت","بَنو مُضَرَ الحُمرُ الكِرامُ الشَقائِقُ",63,"ق",1,0],["وقلّدني مَنّاً وما كنتُ قبلَه","وجَدِّك ما بين الرّجالِ مُقَلّدا",64,"د",2,0],["وقلدها عقداً من الفخر أزهرا","كأن به قد نظمت أنجم السما",65,"م",2,0],["وقلّدهُ الشعب الكريم زمامه","لكَي فيه يحيي الشعب وهو له أبُ",66,"ب",1,0],["وَقلدته يَدُ التَشريف ثالثةً","مِن المجيدي لَها بِالصَدر أَنوار",67,"ر",1,0],["وَقلدت بِالتَوكيل في مَصر حازِماً","سَعيداً لِتنجيز الأُمور يراقب",68,"ب",1,0],["وَقلَّد مِنكَ جيدَك دُون سؤلٍ","برتبتك الَّتي مِن صنف ثاني",69,"ن",2,0],["وَقلَّدَتنا أَياديه حلىً فَشدا","بِالمَدحِ مِنّا لَهُ عِلمٌ وَتَقليدُ",70,"د",1,0],["وقلدكَ الأمر الخطير لما رأى","من الخير إن قُلِّدتَهُ وتَوَسَّما",71,"م",2,0],["وَقلَّدتَني مِنها حُلىً لستُ أَهلَها","وَما هِيَ إِلا مِن مَحاسِنِكُم تُجنَى",72,"ن",2,0],["وَقلِّد جِيدَها بِعُقُودِ دُرٍّ","كَنَظمٍ جاءَ مِن نَجلِ الكِرامِ",73,"م",1,0],["وَقَلَّدْتَ نَحْرَ الدَّهْرِ دُرّاً سُلُوكُهُ","سُطُورٌ لَهَا فَوْقَ الطُّرُوسِ تَذَهُّبُ",74,"ب",1,0],["وَقَلَّدْتَهَا مِنْ مَشْرِقِ الفَضْلِ نِعْمَةً","أنَارَتْ بِهَا أرْجَاؤُهَا وَخِيَامُهَا",75,"م",3,0],["وقلدها عقدا بطعن كأنه","موانع ألحاظ بأحشا زعازع",76,"ع",1,0],["وَقَلَّدْنَاهُ بِالأزْهَارِ عقداً","وَألْبَسْنَاهُ بالأفراحِ تَاجَا",77,"ج",2,0],["وَقلَّد بحراً مكفهرّاً لجيشهِ","تَفيض عليهم من عوارضها جردُ",78,"د",1,0],["وقلد جيد المجد بالفخر منَّة","وليس يفي في مدح عليائه شكري",79,"ر",2,0],["وقلَّدْتمونا البيضَ تُثْقِلُ بالحُلَى","عواتِقَنا أغمادُها والحمائلُ",80,"ل",1,0],["وقلّدتك تميم","لواءها النهشليّا",81,"ل",3,0],["وَقَلد المَعونه","مِن طَبعِهِ الخُشونه",82,"ه",1,0],["وقلد