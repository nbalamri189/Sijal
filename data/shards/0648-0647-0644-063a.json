{"poems":[[49,"لمن جاهد الحساد أجر المجاهد","https://www.aldiwan.net/poem25321.html","الطويل"],[87,"سلام من صبا بردى أرق","https://www.aldiwan.net/poem24321.html","عموديه"],[46,"أبا القاسم اسلم في وفود من القسم","https://www.aldiwan.net/poem29704.html","الطويل"],[92,"المحرقة","https://www.poetsgate.com/ViewPoem.aspx?id=179110",""],[124,"غذائي الحب يا من فيه حرمان","https://www.aldiwan.net/poem49336.html","البسيط"],[215,"لقيتك بعد اليأس منك فصفقت","https://www.aldiwan.net/poem46765.html","الطويل"],[285,"إذا عز نفسي عن هواك قصورها","https://www.aldiwan.net/poem60737.html","الطويل"],[369,"ألم تريا أن الحمول تسير","https://www.aldiwan.net/poem60891.html","الطويل"],[371,"أرى لهم نارا تلوح على علم","https://www.aldiwan.net/poem17265.html","الكامل"],[445,"كذا تتجلى الشمس بعد كسوفها","https://www.aldiwan.net/poem34867.html","الطويل"],[505,"أهل دار مي وهي لله درها","https://www.aldiwan.net/poem38074.html","البسيط"],[556,"وسائلة لتعرف ما عراني","https://www.aldiwan.net/poem47165.html","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48807","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59111","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46688",""],[1361,"","https://poetry.dctabudhabi.ae/diwan/poem/104416","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49926","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122079","الطويل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95523","الطويل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48937","الوافر"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[1699,"","https://poetry.dctabudhabi.ae/diwan/poem/128069","الطويل"],[2029,"","https://poetry.dctabudhabi.ae/diwan/poem/123711","الطويل"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71040","الطويل"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99088","المتقارب"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58258","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100748","المتقارب"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100790","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91703","الوافر"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117859","الطويل"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103543","الطويل"],[3972,"","https://poetry.dctabudhabi.ae/diwan/poem/199831","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86459","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123524","الطويل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102743","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90853","الوافر"],[4884,"عزائي للهوى","https://www.poetsgate.com/ViewPoem.aspx?id=201771",""],[5320,"دموعى عليك حفيظ دماء","https://www.poetsgate.com/ViewPoem.aspx?id=43104",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5409,"شقاءٌ في شبابي والمشيب","https://www.poetsgate.com/ViewPoem.aspx?id=155252",""],[5582,"أَلا هَلْ سَرَوْا أَهْلُ العَقِيقِ وَراحُوا","https://www.poetsgate.com/ViewPoem.aspx?id=186793",""],[5873,"سيف العزيمة","https://www.poetsgate.com/ViewPoem.aspx?id=215412",""],[5956,"سارقُ الطبيعة","https://www.poetsgate.com/ViewPoem.aspx?id=183309",""],[5956,"النِّيلُ في قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=184947",""]],"verses":[["وَهَل غَضَّ مِنّي الأَسرُ إِذ خَفَّ ناصِري","وَقَلَّ عَلى تِلكَ الأُمورِ مُساعِدي",0,"د",2,0],["وَهَل غُرَفُ الجِنانِ مُنَضَّداتٌ","وَهَل لِنَعيمِهِنَّ كَأَمسِ نَسقُ",1,"ق",1,0],["وَهَل غَيرُ أَخلاقٍ كِرامٍ تَكافَأَت","فَمِن خُلُقٍ طَلقٍ وَمِن خُلُقٍ جَهمِ",2,"م",1,0],["وهل غيرَ هذا ترتجي من مَواطنٍ","تُريد على أوضاعها ثورةً كبرى",3,"ر",2,0],["وهل غذائي إلا أن أراك وأن","يمر بالسمع لفظٌ منك فتان",4,"ن",1,0],["وهل غاب عن بالي جمالك لحظةً","وأنت غريبُ الدار بالهجر مغرق",5,"ق",1,0],["وهل غفل الحراس ضل ضلالهم","ألا إنهم في حبس نورك أخفقوا",5,"ق",3,0],["وَهَلْ غادَرَ الهِجْرانُ إِلاّ حُشاشَةً","لِنَفْسٍ بأَدْنى لَوْعَةٍ يَسْتَطِيرُها",6,"ر",3,0],["وهل غيرُ تأميلِ الهُمامِ ابنِ ناصرٍ","لِمَنْ يَتّقي رَيبَ الزَّمانِ نَصير",7,"ر",1,0],["وَهَل غَمَّنا دَهرٌ تَوَلَّيتَ أَمرَهُ","فَمَن قالَ حَقّاً فَليَقُل مُنسِيَ الغُمَم",8,"م",1,0],["وهَلْ غَادَرَتْ يُمْنَاكَ إِلّا ودائِعاً","خَتَمْتَ عَلَيْها فِي مَقَرِّ ظُرُوفِها",9,"ف",3,0],["وهل غربَةٌ شطَّتْ لغربيِّ حيِّهِمْ","تُلائِمُ بعدَ الشَّتِّ في الشَّرقِ والغرْبِ",10,"ب",1,0],["وهلْ غنّى لِيَ العَصْرانِ فيمنْ","هويتُ بما سمعتُ ليُطرباني",11,"ن",2,0],["وهل غيرّ المندوب ما خط قبله","من السيرة النكراء أمس عميد",12,"د",1,0],["وَهَلْ غَرَّدَ القُمْرِي فِي عَرَصَاتِهَا","كَمَا هَزَّ أعطَافَ الغُصُونِ الشَّمَائِلُ",13,"ل",1,0],["وهل غيرُهُ مَّمن تَقَدَّمَ عَصرُهُ","إذا اختبروه فاضلٌ مُتَفَضِّلُ",14,"ل",1,0],["وهل غير القبر الذي قد ثوى به","وقد كان وضاح الجبين جبينه",15,"ن",2,0],["وهلْ غيرُ دهرٍ لا يُذيقك مطعماً","بلا كدرٍ بل لا يسيغك مشربا",16,"ب",2,0],["وَهَلْ غَادَرُوا الجُرْدَ الجِيَادَ خَوَابِطاً","كَمَلْقَى سُيُوفٍ أَوْ عَوَامِلِ مُرَّانِ",17,"ن",1,0],["وهل غصنٌ إلا على الجزع يعتلى","وهل ثمرٌ إِلا به يتناثرُ",18,"ر",1,0],["وهل غبراؤه إلاَّ تراب","وأَنّي ترتحل تَعلُ التُرابا",19,"ب",2,0],["وهل غير ابن مكشوح همامٌ","يكون به من المتمرسينا",20,"ن",2,0],["وهل غير فتح الله يظفر عنده","بفتح رموز للفتوحات طالب",21,"ب",1,0],["وهل غير إيقاف مواقف تهمة","تميل حبيباً عن مناهج أصله",22,"ل",2,0],["وهل غير تدبير برأي مذمم","يرى وصمة للمرء في وجه فضله",22,"ل",2,0],["وهل غير تعريض بنفس مصانة","لمستهدف بالسوء يرمي بنبله",22,"ل",2,0],["وهل غير ذكر المرء في ألسن غدت","تمزق عرضاً عز ادراك وصله",22,"ل",2,0],["وهل غير أسباب ترى وموانع","يلهى بها الانسان عن حتم شغله",22,"ل",2,0],["وهل غير تعذيب المحب بعشق من","يزيد عليه في العذاب بدله",22,"ل",2,0],["وهل غير فكر في رضاه وسخطه","وانجازه بالوعد منه ومطله",22,"ل",2,0],["وهل غير وجد مع حسين ولوعة","وسهد ودمع لانفاد لهطله",22,"ل",2,0],["وهل غير وسواس يزيد به العنا","ويقضي على الصب الكئيب بخبله",22,"ل",2,0],["وهل غير واش أو رقيب منغص","ولوم أخي عذل يسئ بعذله",22,"ل",2,0],["وهل غير انفاق لمال أضاعه","وإن لصديق يقض في نقض حبله",22,"ل",2,0],["وهل غاب عنَّا أَو يغيب الذي اغْتَدَتْ","له رُتَبٌ في الدين مُنْحَفِظاتُ",23,"ت",1,0],["وهل غيره أحد يرتجي","ويعدي على الزمن المعتدي",24,"د",2,0],["وهل غيرُ خيلِ الصالحِ الملك التي","بها اتّسَمَتْ أغوارُها ونُجودُها",25,"د",3,0],["وهل غيره يستحق العلى","وقد قمصوه بجلبابها",26,"ب",3,0],["وهل غيره للمجتديه نواله","حياة وللخصم الالدّ منون",27,"ن",1,0],["وَهَل غير القُبور محطُّ رَحلٍ","وَإِن جدّت ببانيها القصور",28,"ر",1,0],["وهل غير ساقيها بأقداح راحها","عن الغي يهدي العمي أو يسمع الصمّا",29,"م",2,0],["وهل غبت عن شيءٍ فينكِرَ منكرٌ","وجودُك أم لم تبدُ منك الشواهدُ",30,"د",1,0],["وهل غفلات العيش في دير مرقس","تعود وظل اللهو فيه ظليلُ",31,"ل",1,0],["وهل غارب الوجناء يمسك كورها","إذا أنت لم تشدد عليه بطانا",32,"ن",2,0],["وهل غير حب المنحنى ظهرها حنا","فطم حنايا أضلع وحشاها",33,"ا",3,0],["وهل غير ليلى لذ ليلا لها وقد","بدت من خباها في سنى حلاها",33,"ا",3,0],["وهل غصن ذاك القد يحكى قوامه","إذا خطرت في الروض ما ينبت الخط",34,"ط",1,0],["وهل غير ابن باكير غيور","وقور لا يراع له جنان",35,"ن",1,0],["وهل غيرُ حزْني من فراقي وفرقتي","فيا نفْسُ صبْراً واصْطباراً على القَدَرْ؟",36,"ر",1,0],["وَهَلْ غَابَ عنى وَذِى رُوحهُ ... تُحلِّقُ حَولِى صَباحاً مَساءْ","أَيا رَاحِلاَ نَحو دَارِ الخُلودْ ... عَليكَ (حَفيظُ) دُموعِي دِماءَ",37,"ا",2,0],["وهل غضبوا إلا لتشنيع مرجف","أغار على ثلب الكرام وأقدما",38,"م",2,0],["وهل غير المعاهد أمهاتٌ","يلدن اليك كل فتى نجيب",39,"ب",1,0],["وَهَلْ غَيَّرَتْ رَسْمَ الأُبَيْرِقِ وَاللِّوَى","شآبِيبُ بَرْقٍ تَمْتَرِي وَرِياحُ",40,"ح",1,0],["وهل غيرنا في عموم الدنا","لخير الفضائل طرّاً حوى؟!",41,"ا",1,0],["وهل غيرُ الطبيعة أنشأتْها","إليّ لكي أقبِّلَ مِرشفَيها؟",42,"ي",3,0],["وهل غابةٌ من حوله لا تضمّني","وقد جمعتْ قلبي وروحي الجوامعُ ؟",43,"ع",1,0]]}