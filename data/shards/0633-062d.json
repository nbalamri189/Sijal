حَبْلَكَ مِنْ لَمِي س","https://www.poetsgate.com/ViewPoem.aspx?id=20020",""],[45,"عَلى أيّ أمْرٍ مُشْكِلٍ أتَلَوّمُ","https://www.poetsgate.com/ViewPoem.aspx?id=31836",""],[88,"قامت تميسُ بأعطافٍ وأوراكِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19569&r=&rc=72",""],[85,"بني مصرَ ، ارفعوا الغار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9668&r=&rc=158",""],[71,"حبيبٌ نأى وهو القريبُ المُصاقِبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=28023&r=&rc=10",""]],"verses":[["سَحائِبُ تَمضي بِالفَتى فَصَواعِقٌ","وَغَيثُ وَهَيفٌ زَعزَعٌ وَبُرودُ",0,"د",1,0],["سَحابٌ عَلا حَتّى تَصَوَّبَ مُزنُهُ","وَأَقلَعَ لَمّا عَمَّ بِالعيشَةِ الرَغدِ",1,"د",1,0],["سَحَبَ الشَّيبُ بِفودي ذَيلَهُ","وَتَجافَتْ عَنهُ رَبَّاتُ الكِلَلْ",2,"ل",1,1],["سَحَبُوا أَذْيالَ نَقْعٍ","لَيْلُهُ وَحْفُ الجَناحِ",3,"ح",1,0],["سحائب الغزو تشوينا وتحجبنا","يوماً ستحبل من إرعادنا السحب؟",4,"ب",1,0],["سحبت أيّامها الجرحى على","لفحة البيد وأشواك الهضاب",5,"ب",1,0],["سَحّاً وَتَسكاباً فَكُلَّ عَشِيَّةٍ","يَجري عَلَيها الماءُ لَم يَتَصَرَّمِ",6,"م",1,0],["سَحَراً إِذا فاضَ الحَجيجُ إِلى مِنىً","فَيضاً كَمُلتَطِمِ الفُراتِ الفائِضِ",7,"ض",1,0],["سَحَّتْ عَلَيْهَا كُلُّ عَيْنٍ ثَرَّةٍ","لِلْمُزْنِ هَامِيةِ الْغَمَامِ هَتُونِ",8,"ن",1,0],["سُحْقاً لَهُمْ لاَ بِالْوَفَاءِ تَمَسَّكُوا","يَوْماً وَلاَ فَازُوا بمَا قَدْ أَمَّلُوا",9,"ل",3,0],["سَحَابٌ إذَا تَهْفُو بُرُوقُ صِفَاحِهِ","هَمَى عَارِضٌ جَهْمٌ بِوَدْقِ نِبَالِهِ",10,"ل",2,0],["سَحائِبُ أمْثالِ القِطارِ إذا ونَتْ","بمُثْقَلَةِ الأوْقارِ صاحَ بِها الرّعْدُ",11,"د",1,0],["سَحّاً وَساحِيَةً وَعَم","ما ساعَةٍ ذَلِقَت ضَبابُه",12,"ب",2,0],["سُحبٌ يُوَشّحُها لموحٌ مُلقِحٌ","وَيَحُفُّ حافِلُها حَفيفَ رِياحِ",13,"ح",1,0],["سِحرٌ وَلكِنَّ هاروتاً وَصاحِبَهُ","ماروتَ ما نَهيا فيهِ وَلا أَمرا",14,"ر",2,0],["سَحائِبُ أَجفانٍ سِوارٍ سَوارِبُ","وَأَعباءُ أَشواقٍ رَواسٍ رَواسِبُ",15,"ب",1,0],["سَحائِبُ نُعمى أَبرَقَت وَتَدَفَّقَت","فَصَيِّبُها الجَدوى وَبارِقُها البِشرُ",16,"ر",1,0],["سَحَبنَ ذُيولَهُنَّ بِها فَأَمسَت","مُصَرَّعَةً بِها دِعَمُ الخِيامِ",17,"م",1,0],["سُحَيراً وَآفاقُ السَماءِ كَأَنَّها","بِها بَقَرٌ أَفتاؤُهُ وَقَراهِبُه",18,"ب",2,0],["سحر بعينيك يستهوي القلوب وما","ينفكّ في هتك عبّاد ونسّاك",19,"ك",1,0],["سحرتني مذ أقبلت تتثنّى","فكأني مذ أقبلت لست منّي",20,"ي",1,0],["سُحُقٌ يُمَتِّعُها الصَفا وَسَرِيُّهُ","عُمٌّ نَواعِمُ بَينَهُنَّ كُرومُ",21,"م",1,0],["سَحابٌ ما أَناخَ عَلى عُقَيلٍ","وَجَرَّ عَلى جِوارِهِمُ ذُبابا",22,"ب",2,0],["سَحَّ الشَعيبِ وَماءِ الغَربِ يَمنَحُهُ","ساقٍ يُحَمَّلُهُ ساقٍ بِإِزلالِ",23,"ل",1,0],["سحَّارة تحكي كعوبَ الرمحِ في","رَوعٍ وتحكي في السرورِ كواعِبا",24,"ب",2,0],["سحابة الطرحة العلياء طالعة","وأوَّل الغيث قطر ثم ينسكب",25,"ب",1,0],["سحائب آلاءٍ تجول على الرجا","وأنجم آراءٍ تدل على النجح",26,"ح",1,0],["سحارة الجفن الكحيل إذا رنت","عقدت لسان معوذٍ إن عوذا",27,"ذ",2,0],["سحاب كما ترجى السحائب حفَّلاً","وبأسٌ كما تنضى الصواعق لمعا",28,"ع",2,0],["سحقاً ليوم النوى ماذا رمى بصري","حتَّى اسْتهلَّ وماذا بالحشا صنعا",29,"ع",2,0],["سحرته العيون سحر ابن محمو","د بنفث البيان من أقلامه",30,"م",2,0],["سحبت ذيول الفضل واللفظ للورى","فكنت على الحالين أشرف سحبان",31,"ن",1,0],["سَحْسَحَتْ ماءها عَلَى كل أرضٍ","بعدما صافحت به الجوزاءَ",32,"ا",2,0],["سحائبُ قيست بالبلاد فأُلْقِيَتْ","غطاءً على أغوارها ونجودها",33,"د",3,0],["سَحرَتْهُ بمقْلتيْها فأضحتْ","عنده والذميمُ منها حميدُ",34,"د",1,0],["سحماء كالمهرة المُطهمَّة ال","دهماء تنضو أوائل الصِّيَق",35,"ق",1,0],["سَحَبَ الدَهرُ عَلَيها ذَيلَهُ فَهيَ رُسوم","ما لَنا نَبني وَما نَبني لِهَدمٍ لَستُ أَدري",36,"ي",1,0],["سَحَقَ القَوِيُّ بِها الضَعيفَ وَداسَهُ","وَمَشى عَلى أَرضٍ مِنَ الأَبدانِ",37,"ن",1,0],["سَحَرَ اللُّبَّ طَرْفُهُ","مَا دَها الرِّيقَ لو رَقى",38,"ق",2,0],["سحرتني عنادل","تتنزى على الشجر",39,"ر",1,0],["سحراً حيث نسيم ال","روض معتلٌّ برود",40,"د",1,0],["سحبوا الطقوس ورتلوا إنجيلهم","فتعالت الصلوات والأذكار",41,"ر",1,0],["سحاب الجود راحته","وفي برديه عيلمه",42,"م",2,0],["سحبتها بالرفق فه","ى أَمَة ممتلكه",43,"ك",2,0],["سُحِبَت عَلى الأَحقادِ أَذيالُ الهَوى","وَمَشى عَلى الضِغنِ الوِدادُ الماحي",44,"ح",2,0],["سَحَرَ القُلوبَ فَرُبَّ أُمٍّ قَلبُها","مِن سِحرِهِ حَجَرٌ مِنَ الأَحجارِ",45,"ر",1,0],["سَحَائِبُ يَمْطُرْنَ الحَديدَ علَيهِمِ","فكُلُّ مَكانٍ بالسّيوفِ غَسيلُ",46,"ل",1,0],["سَحابٌ مِنَ العِقبانِ يَزحَفُ تَحتَها","سَحابٌ إِذا اِستَسقَت سَقَتها صَوارِمُه",47,"م",2,0],["سُحبٌ تَمُرُّ بِحِصنِ الرانِ مُمسِكَةً","وَما بِها البُخلُ لَولا أَنَّها نِقَمُ",48,"م",1,0],["سِحرٌ حَلالٌ لَم أُؤَلِّف عِقدَهُ","إِلّا لِتَعلو رُتبَتي عَلى الرُتَب",49,"ب",1,0],["سَحابُ الجودِ مُنهَلُّ العَزالى","وَريحٌ مِنهُ صادِقَةُ الهُبوبِ",50,"ب",1,0],["سَحَبوا حَواشي الأَتحَمِيِّ وَإِنَّما","وَشيُ البُرودِ عَلى أُسودِ الغابِ",51,"ب",1,0],["سِحرُ العُيونِ النُجلِ مُستَهلِكٌ","لُبّي وَتَوريدُ الخُدودِ المِلاح",52,"ح",1,0],["سِحرُ عَينَيكَ قَهوَتي وَثَنايا","كَ مِزاجي وَوَردُ خَدَّيكَ وِردي",53,"د",2,0],["سَحابا عَطاءٍ مِن مُقيمٍ وَمُقلِعٍ","وَنَجما ضِياءٍ مِن مُنيفٍ وَغائِرِ",54,"ر",1,0],["سَحابٌ خَطاني جودُهُ وَهوَ مُسبِلٌ","وَبَحرٌ عَداني فَيدُهُ وَهوَ مُفعَمُ",55,"م",1,0],["سَحَّت سَحابُ المَنايا فَوقَ هامِهِمِ","صَوباً مِنَ المَوتِ داني الوَدقِ وَالدِيَمِ",56,"م",1,0],["سَحابٌ إِذا أَعطى حَريقٌ إِذا سَطا","لَهُ عِزَّةُ الهِندِيِّ في هِزَّةِ الغُصنِ",57,"ن",1,0],["سَحّاً بِسَحٍّ وَإِسبالاً بِمُسبَلَةٍ","دَمعٌ يَبوحُ بِشَجوٍ كُنتُ أُخفيهِ",58,"ي",2,0],["سحقا لقارعة الخطوب فقد نضا","سيف النضال لها أبو إسحق",59,"ق",1,0],["سَحائبُ من بلادِ الشامِ أضحَتْ","بأرضِ الحِصنِ تَنسَجِمُ انسِجاما",60,"م",2,0],["سَحابُكَ في السَّماحِ لها انسجامُ","ونارُكَ في العَدُوِّ لها ضِرامُ",61,"م",1,1],["سَحائبُ مَعْروفٍ إذا المَحْلُ أقبلَت","سُنُوهُ وأقمارٌ إذا الخَطْبُ أَظلَما",62,"م",2,0],["سَحَبَ السَحابُ لَها الذُيولَ فَأُلبِسَت","مِن حُلَّةِ الأَزهارِ خَيرَ لِباسِ",63,"س",1,0],["سَحابُ جودٍ عَلى الوَرى هَطَلا","لا بَرقُهُ مُبطِئُ النَوالِ وَلا",64,"ل",2,0],["سِحْرُ هاروتٍ وماروتٍ بها","في فتُورِ اللحظِ واللفظِ الرّخيم",65,"م",1,0],["سَحَبَتْ ذوائبَها فَيا لأَساودٍ","نَفَثَتْ على القدمينِ مِسْكاً أَذفَرا",66,"ر",2,0],["سِحرُها وحيٌ بِنَجوى ناظِرٍ","ذُو نُفاثٍ للنُّهى في عقَدِ",67,"د",1,0],["سَحاباً إِذا أَلقَت عَلى خِلفِهِ الصَبا","يَداً قالَتِ الدُنيا أَتى قاتِلُ المَحلِ",68,"ل",1,0],["سَحابٌ مَتى يَسحَب عَلى النَبتِ ذَيلَهُ","فَلا رَجِلٌ يَنبو عَلَيهِ وَلا جَعدُ",69,"د",1,0],["سحابُ كفَّيْكَ أهنا","منَ السحابِ وأمْرا",70,"ر",2,0],["سحائبُ البَرَدِ المرْفَضِّ صائلةٌ","على جنانِ دمشقَ صولةَ الأسد",71,"د",1,1],["سحبٌ بوارقُ أو ثلوجٌ خلتُها","زنجاً تبسَّم أو قذالاً شائبا",72,"ب",2,0],["سحقاً لقاضٍ مالكي سطا","بتسعةٍ أكبر مَنْ فينا",73,"ن",2,1],["سَحَرَتني الزَرقاءُ مِن مارونَ","إِنَّما السِحرُ عِندَ زُرقِ العُيونِ",74,"ن",1,1],["سَحَرَتني بِجيدِها وَشتَيتٍ","وَبِوَجهٍ ذي بَهجَةٍ مَسنونِ",74,"ن",1,0],["سَحا تُربَها أَرواحُها فَكَأَنَّما","أَحالَ عَليها بِالرَغامِ النَواسِفُ",75,"ف",1,0],["سَحَبتُ الدَياجي فيهِ سودَ ذَوائِبٍ","لِأَعتَنِقَ الآمالَ بيضَ تَرائِبِ",76,"ب",1,0],["سَحيقٌ وَلا غَيرَ الرِياحِ رَكائِبٌ","هُناكَ وَلا غَيرَ الغَمامِ مَزادُ",77,"د",1,0],["سَحَبتُها لابِساً بُردَ الشَبابِ بِها","أَجُرُّ مِن طَرَبٍ أَذيالَ مُختالِ",78,"ل",1,0],["سَحَبتُ الدُجى مِنها بِأَعنَسَ ضامِرٍ","رَمَيتُ بِهِ رُكنَ الدُجى فَتَهَدَّما",79,"م",2,0],["سُحِرَ القومُ ومن آياتِهِ","رُقيةُ السِّحْرِ وَطِبُّ الأولق",80,"ق",1,0],["سَحَرتَ فُؤادي حينَ أَرسَلتَ حَيَّةَ ال","عِذارِ وَقَد أَغرَقتَني في مَدامِعي",81,"ي",1,0],["سَحَر القلوبَ فراحَ يقذفها على","نار الجهاد أولئك البسلاءُ",82,"ا",2,0],["سَحاليطَ حَمراءِ القَراحين أُكرِهَت","بِهِ وَالعَوالي مُضجَعاتُ السَوافِلِ",83,"ل",1,0],["سَحَرَتني الدُنيا وَعاداتُ لَذّا","تي فَجِسمي كَهلٌ وَقَلبي صَبِيُّ",84,"ي",1,0],["سَحَرَت عُيونُ الغانِياتِ وَقَتَّلَت","لا مِثلَ ما فَعَلَت بِهِ عَيناكِ",85,"ك",1,0],["سَحابَةٌ وَالبُروقُ تُحرِقُها","كَشاطِرٍ بِالسِماطِ يَعتَوِرُ",86,"ر",1,0],["سَحبَ الجُيوشِ فَكَم بِها فُتِحَت","بَعدَ التَمَنُّعِ بَلدَةٌ بِكرُ",87,"ر",1,0],["سَحَقَتها الرِياحُ في كُلِّ فَنٍّ","وَمَحَتها بَواكِرُ الأَمطارِ",88,"ر",1,0],["سَحَراً مِن قَبلِ أَن تَر","جِعَ أَرواحُ الرُقودِ",89,"د",1,0],["سُحِرَت عَيني فَلَستُ أَرى","غَيرَهُ في الناسِ أَحبابا",90,"ب",2,0],["سَحَبَتْ فيهِ الصَّبا أذْيالَها","بِمَدِيحي لإِمامِ المُرسَلِينا",91,"ن",2,0],["سُحِبَتْ بها أردانُه فتَضَوّعَتْ","عَبَقاً بصائِكِ مِسكِهِ أردانُها",92,"ن",3,0],["سَحَّ شُؤبوبُهُ فأجرى شِعابي","وطَما بحْرُهُ فأغْرَقَ فُلْكي",93,"ك",2,0],["سَحَّت عَلَيَّ سَماءُ الحُزنِ بَعدَكُمُ","وَأَحدَقَت بي بُحورُ الشَوقِ وَالفِكَرِ",94,"ر",1,0],["سَحَرتِ الرَجُلَ الحُرَّ","وَما حَلَّت لَكِ السَحرَه",95,"ر",2,0],["سَحّارَةُ العَينِ لَها صورَةٌ","جادَ عَلَيها الحُسنُ سَحّاحا",96,"ح",2,0],["سَحَرتُ ريفاً لِبَفزولِ فَدامَجَهُ","إِذ أَلَّفَت فيهِ بَينَ الشاةِ وَالذيبِ",97,"ب",1,0],["سَحائِبُ مُبرِقاتٌ مُرعِداتُ","لِمُهجَةِ كُلِّ حَيٍّ موعِداتُ",98,"ت",1,1],["سَحائِبُ لِلسُقيا وَسُحبٌ مِنَ الرَدى","وَنَبتُ أُناسٍ مِثلَ ما نَبَتَ البَقلُ",99,"ل",1,0],["سَحائِبَ ريحٍ لَم تُوَكَّل بِبَلدَةٍ","فَتَترُكَها إِلّا كَما لَيلَةِ الطَلَق",100,"ق",1,0],["سَحابٍ ذاتِ أَسحَمَ مُكفَهِرٍّ","تُوَحّي الأَرضَ قَطراً ذا اِفتِحاصِ",101,"ص",1,0],["سحراً فظنيَ فيه أنه السحَرُ","قابلتُ لَيلى فَلَم تمدد إليّ يدا",102,"د",2,0],["سحقتها أَرجل الده","رِ وأقدام العصورِ",103,"ر",1,0],["سحر حلال وَما السح","ر كله بحلال",104,"ل",1,0],["سحائب يمطرن الحديد عليهم","وكلّ مكانٍ بالدّماء غسيل",105,"ل",1,0],["سحائبُ حمرٌ أم سماءٌ تضرَّمُ","أم الشمسُ يجري فوق صفحتها الدمُ",106,"م",1,1],["سَحرَتهم روْعةُ الليلِ فهُمْ خلْقٌ جديدُ","كلهم ربٌّ يُغنِّي وإلهٌ يستعيدُ",107,"د",1,0],["سِحْر نطقتُ به وأنت المنطِقُ","ولكَ الولاءُ ولي بعرشكَ موثِقُ",108,"ق",1,1],["سحب تجلى خالياً دجنها","عنكم وسحب بعدها همع",109,"ع",1,0],["سَحَبُوا مِن ذَيْلِ مَجْد إِذْ هُمُ","للْوَغَى في ظِلِّ نَقْعٍ أَشْهَبِ",110,"ب",1,0],["سَحَرَ الْعُقُولَ بَيَانُهُ فَكَأَنَّهُ","يَسْقِي الْجَلِيسَ سُلافَةَ الْعُنْقُودِ",111,"د",1,0],["سَحَبوا أَنابيبَ القَنا فَكَأَنَّما","سَحَبوا بِهِنَّ حَواشِيَ الأَبرادِ",112,"د",1,0],["سَحّتْ عليكَ مع الْجَنُوب رَوَائِحٌ","وهَمَتْ عليك مع الشمالِ غوادِي",113,"د",2,0],["سَحَر العُيونَ بحُسنِه","والحسنُ للأبصارِ ساحرْ",114,"ر",1,0],["سْحْرُ شِعْرٍ ومَجالي فِتنةٍ","وعيونٌ أُغْرِمتْ باللعب",115,"ب",1,0],["سحرتِ عيونَ الخافقيْنَ كأَنّما","بأرضِك سحرٌ للفراعين مُودَع",116,"ع",1,0],["سُحْقاً لسكِّينِ فرديناند كم ذَبحتْ","واليومَ تشحَذُ أمريكا السكاكينَا",117,"ن",2,0],["سحَبْنَا ذيولَ الخلافِ قديمًا:","فذلك سَبَّ، وهذا شَتَمْ",118,"م",1,0],["سحْرُ الطبيعة والبيانِ تسابَقَا","فيها سِباق الخيلِ في المضْمَار",119,"ر",1,0],["سحرتْني مُضيفةٌ ذاتُ وجهٍ","باسمِ الثغر، حالمٍ، جَذاب",120,"ب",1,0],["سُحبٌ دَمعها يسيلُ سجامًا","يَالدمع يجري بلا أحزان!",121,"ن",1,0],["سحران لم يأت هاروتٌ بمثلهما:","سِحْرُ العيون، وسحر الأَعْينِ النُّجُل",122,"ل",1,0],["سَحَرْتنا ظواهرُ الأمر حتى","أوهمتنا أن البلاد قويه",123,"ي",2,0],["سَحَّت عطاياه فما من ناظرٍ","الاتمنىَّ الطيفَ من مَعروفه",124,"ف",2,0],["سَحَرٌ زماني كلُّهُ لِهَوَى","ليلٍ بقربِك كلُّه سَحَر",125,"ر",1,0],["سَحّاً وَسَاحِيَة ً، وَعَمّ","ا سَاعَة ٍ ذَلِقَتْ ضِبَابُهْ",126,"ب",2,0],["سَحَابٌ خَطاني جودُهُ، وَهوَ مُسبَلٌ،","وَبَحْرٌ عَداني فَيْضُهُ، وَهوَ مُفعَمُ",127,"م",1,0],["سحر بعينيك يستهوي القوب وما","ينفك في هتك عباد ونساك",128,"ك",1,0],["سحرٍ من قوى الروحِ","حَوَى السَّيْفَيْنِ في غِمد",129,"د",1,0],["سحائبُ أجفانٍ سوارٍ سواربُ","وأ'باءُ أشواقٍ رواسٍ رواسبُ",130,"ب",1,0]]}