{"poems":[[71,"مؤذننا إن دعا للصلاة","https://www.aldiwan.net/poem28323.html","المتقارب"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16683","الخفيف"],[240,"واعجبي وحادث الد","https://www.aldiwan.net/poem32166.html","مجزوء الرجز"],[264,"مؤذن الحب في العشاق نادى حي","https://www.aldiwan.net/poem35318.html","المواليا"],[376,"علق القلب بواع","https://www.aldiwan.net/poem57320.html","مجزوء الرمل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48512","الخفيف"],[1942,"","https://poetry.dctabudhabi.ae/diwan/poem/76823","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216573","البسيط"],[4935,"أري عين الجميل بغير كحل","https://www.poetsgate.com/ViewPoem.aspx?id=129364",""],[5168,"تخاملني علساعه","https://www.poetsgate.com/ViewPoem.aspx?id=33675",""],[5976,"شياطين الفضا","https://www.poetsgate.com/ViewPoem.aspx?id=32795",""]],"verses":[["مؤذِّننا إنْ دعا للصلاةِ","رأيتَ محبيهِ جاؤوا زمرْ",0,"ر",1,1],["مُؤذِناً هالِكِيُّهُ بالمَنايا","هالِكيهِ مُبَشِّراً ونَذيرا",1,"ر",2,0],["مُؤذِنَهٌ أَن أَتَوَل","لى بَعدَها عَن كَثَبِ",2,"ب",1,0],["مؤذّن الحبّ في العشّاق نادى حي","هذي سليمى المحاسن تنجلي في الحي",3,"ي",1,1],["مؤذنٌ عنكَ ببَينٍ","فاجعَلَنهُ بوَداعِ",4,"ع",1,0],["مؤذن بالبقاء لابن عليٍّ","سؤددٌ طارفٌ وعزٌّ تلاد",5,"د",1,0],["مؤذنٌ بالرَّحيل إن ركضت فيه","لخيل الزَّمان بُلقٌ وَشُهبُ",6,"ب",1,0],["مؤذن الطير يدعو فيه محتسباً","فيستجيب له برٌّ وغيان",7,"ن",1,0],["مؤذن خده كم قام قدماً","وكبر ثم سبح ثم هلل",8,"ل",1,0],["مو ذاك الكبل يتحمل هموم","ولا ذاك الصدمته وكال غالي",9,"ل",2,0],["مؤذّن بيتك الطاهر ينادي للصلاة الحين","وربْع ابليس تستهزئ .. بحجّة كاذب وْ زوره",10,"ر",2,0]]}