ِبي وَسَنامي",3,"م",2,0],["بِأَيدٍ تَحبِسُ الأَورادَ عِزّاً","وَتَأمَنُ مِن مُلاطَمَةِ السِجالِ",4,"ل",1,0],["بِأَيمانِنا بيضُ الغُروبِ خَفائِفٌ","نَغولُ بِها هامَ العِدا وَتَغولُها",5,"ل",3,0],["بِأَيِّ طَرفٍ أَرى العَلياءَ إِن نَضَبَت","عَيني وَلَجلَجتُ عَنها بِالمَعاذيرِ",6,"ر",1,0],["بِأَيِّ يَدٍ أَرمي الزَمانَ وَساعِدٍ","وَكانوا يَدي أَعطَيتُها الخَطبَ عَن يَدي",7,"د",2,0],["بايَعَ أَطرافَ القَنا","وَعاقَدَ المُهَنَّدا",8,"د",2,0],["بِأَيِّ مَنالٍ أَم بِأَيَّةِ أَذرُعٍ","تَعاطَيتُمُ اليَومَ البِناءَ العَطوَّدا",9,"د",2,0],["بِأَيمانِهِم بيضٌ يُضيءُ وُجوهَهُم","قَواضِبُ قَد جُرِّبنَ كُلَّ مُجَرَّبِ",10,"ب",1,0],["بِأَيِّ دَواعي الهَوى تُطرَقونَ","فَقالوا بِهَذا البُريقِ المُلالي",11,"ل",2,0],["بِأَيْدٍ إِذَا ما أَنْكَرَ الكَلْبُ أَهْلَه","عَرَفْتُ لَها طَعْناً يُشَظِّى رِماحَها",12,"ح",3,0],["بِأَيْديهمُ تَهْتَزُّ ناصِيَةُ العُلا","وَيَحْتَلبُ العافِي أَفاوِيقَ نائِلِ",13,"ل",1,0],["بأيْمانِهِمْ بِيضٌ مشاريفُ تَختَلي","رُؤوساً من الأعداءِ مالَتْ طُلاتُها",14,"ت",3,0],["بأيْدٍ يُسْتَشَفُّ الجودُ فيها","تُفيدُ مَحامِداً وتُفيتُ مالا",15,"ل",2,0],["بِأَيديهِم مُهَنَّدَةٌ وَسُمرٌ","كَأَنَّ ظُباتِها شُعَلُ الضِرامِ",16,"م",1,0],["بِأَيِّ لِسَانٍ أَمْ بِأَيِّ بَلاَغَةٍ","أُقَضِّي فُرُوضاً منْ حُقُوقِكَ لاَزِمَهْ",17,"م",2,0],["بِأَيِّ شُكْرٍ نُوَفِّي كُنْهَ نِعْمَتِهِ","لَوْ أَنَّ سحبانَ أَوْ قُسّاً لَهَا انْتُدِبَا",18,"ب",2,0],["بِآيَةِ أَنَّ الوَلعَ مِنكَ سَجِيَّةٌ","لَهِجتَ بِها فيما تَجِدُّ وَتَهزِلُ",19,"ل",1,0],["بايَعتَ فيه أبا بَكرٍ فبايَعَه","على الخِلافَةِ قاصِيها ودانِيها",20,"ي",3,0],["بِآيِ مُحَمَّدٍ وَبِآيِ عيسى","فَعَوِّذهُ وَآياتِ الكَليمِ",21,"م",1,0],["بِأَيِّ الخِلالِ المَغربيُّ إِلَيكُمُ","ترَقّى وَما فيهِ خِلالٌ تُحَبَّبُ",22,"ب",1,0],["بِأَيِّ مَشيئَةٍ عَمرُو بنَ هِندٍ","نَكونُ لِقَيلِكُم فيها قَطينا",23,"ن",2,0],["بِأَيِّ مَشيئَةٍ عَمرُو بنَ هِندٍ","تُطيعُ بِنا الوُشاةَ وَتَزدَرينا",23,"ن",2,0],["بِأَيِّ مَشيئَةٍ عَمرُو بنَ هِندٍ","تَرى أَنّا نَكونُ الأَرذَلينا",23,"ن",2,0],["بِأَيِّ مَشيئَةٍ عَمرُو بنَ هِندٍ","تَقَدَّمُنا وَنَحنُ السابِقونا",23,"ن",2,0],["بِأَيِّ عَلاقَتِنا تَرغَبونَ","أَعَن دَمِ عَمروٍ عَلى مَرثِدِ",24,"د",1,0],["بِأَيديهِمُ خَطّيّة وَعَلهِمُ","سَوابِغُ فِرعَونِيَّةٌ جُدِلت جَدلا",25,"ل",2,0],["بِأَيِّ عِبْءٍ نَهَضْتَ حِينَ","اللِّدَاتُ فِي الخَوْضِ يَلْعَبُونَا",26,"ن",2,0],["بِأَيِّ مَظَاهِرِ التَّكْرِيمِ يُجْزَى","وِفَاقاً ذَلِكَ الجَّهْدُ الجَسِيمُ",27,"م",1,0],["بَايِعُوا العِلْمَ وَالْفَضِيلَةَ فِيهِ","أَيِّدُوا كُلَّ عَاقِلٍ وَنَزِيهِ",28,"ه",1,0],["بِأَيِّ جَهْلٍ غَدَوْنَا أُمَّةً هَمَلاً","وَأَيِّ عَقْلٍ تَوَلَّتْ وَعْيَنَا الأُمَمُ",29,"م",1,0],["بَايَعْتَ دُونَ حِمَاكَ بَيْعَةَ خَاسِرٍ","تُؤْتَاهُ مِنْ كَدْحِ الفَقِيرِ المُعْدِمِ",30,"م",1,0],["بِأَيِّ جَمَالٍ أَبْدَأَ اللهُ رَسْمَهَا","وَأَيِّ جَلالٍ ذَلِكَ الرَّسْمُ يُخْتَمُ",31,"م",1,0],["بِأَيِّ يَدٍ أحَلَّ الفَن","هَذَا الرُّوحَ فِي الصَّنَمِ",32,"م",1,0],["بِأَيلَةَ وَالخَليجِ لَهُم رُسومٌ","وَآثارٌ قَدُمنَ وَما مُحينا",33,"ن",2,0],["بِأَينُقٍ كَقِداحِ النَبعِ قَد ذَبَلَت","مِنها الشَمائِلُ أَمثالِ القَراقيرِ",34,"ر",1,0],["بآية ما بلغت دين محمد","أمانيَّ للرحمن تُدني وتُزلفُ",35,"ف",1,0],["بآيةِ ما أعطى الخليفةَ ربُّهُ","مفاتيح فتحٍ ساقها سائق السعدِ",36,"د",1,0],["بأيديهم عصّي مشرعات","مهيّأة لضرب واحتثاث",37,"ث",1,0],["بِأَيِّ نِجادٍ تَحمِلُ السَيفَ بَعدَما","قَطَعتَ القُوى مِن مِحمَلٍ كانَ باقِيا",38,"ي",2,0],["بِأَيِّ سِنانٍ تَطعُنُ القَومَ بَعدَما","نَزَعتَ سِناناً مِن قَناتِكَ ماضِيا",38,"ي",2,0],["بِأَيّامِ قَومي ما لِقَومِكَ مِثلُها","بِها سَهَّلوا عَنّي خَبارَ الجَراثِمِ",39,"م",1,0],["بِأَيّامِ قَومٍ ما لِقَومِكَ مِثلُها","بِها سَهَّلوا عَنّي خَبارَ الجَراثِمِ",40,"م",1,0],["بِأَيِّ قَديمٍ يا رَبيعَ بنَ مالِكٍ","وَأَنتُم ذُنابى لا يَدانِ وَلا صَدرُ",41,"ر",1,0],["بِأَيِّ بَلاءٍ تَحمَدونَ مُجاشِعاً","غَباغِبَ أَثوارٍ تَلَظّى عَلى جَسرِ",42,"ر",1,0],["بِأيِّ كِتَابٍ أَم بِأيَّةِ سُنَّةٍ","تَرَى حُبَّهُم عَاراً عَلَيَّ وتَحسَبُ",43,"ب",1,0],["بِأيِّ مَشِيئَة في ابنى نِزَارٍ","تُُهَمِّمُني أَكُفُّ اللاَّمِسينَا",44,"ن",2,0],["بِأَيِّ عُذرٍ رَدَدتَ والِهَةً","عَلَيكَ دونَ الوَرى مُعَوَّلُها",45,"ل",3,0],["بِأَيِّ دُعاءِ داعِيَةٍ أُوَقّى","بِأَيِّ ضِياءِ وَجهٍ أَستَنيرُ",46,"ر",1,0],["بِأَيديهِم صَوارِمُ مُرهَفاتٌ","وَكُلُّ مُجَرَّبٍ خاظي الكُعوبِ",47,"ب",1,0],["بِأَيدي رِجالٍ هاجَروا نَحوَ رَبِّهِم","وَأَنصارِهِ حَقّاً وَأَيدي المَلائِكِ",48,"ك",1,0],["بِأَيدي رِجالٍ لَم يَسُلّوا سُيوفَهُم","بِحَقٍّ وَقَتلى لَم تُجَنَّ ثِيابُها",49,"ب",3,0],["بِأَيمانِهِم بيضٌ إِذا حَسِرَ الوَغى","فَلا بُدَّ أَن يَردى بِهِنَّ صَريعُ",50,"ع",1,0],["بأي حالية إذ وصلت","ذكرها أعطف من مر النسيم",51,"م",1,1],["بأيمن طالع مسرى وزير","نوال يداه للآمالِ محيا",52,"ي",2,1],["بآيةِ ألا يبرحَ المرءُ منكُمُ","يُكَبُّ على حُرِّ الجبين فيُعفَجُ",53,"ج",1,0],["بأية ملأ مغنماً وسلامةً","حواها رفيعَ العيش خوضُ الشدائدِ",54,"د",1,0],["بأيِّ وجهٍ تلاقي اللَّه معتذِراً","جلت خطيئتك العظمى عن العذر",55,"ر",1,0],["بايتُّه في بيته فأملَّني","يشكو إليَّ هوى عميد مُدنَف",56,"ف",1,0],["بأيدي بني وهبٍ فإنَّ سحابَهَمْ","سَحابٌ يعمُّ الناسَ بالغيث هَطّالُ",57,"ل",1,0],["بِآيَةِ ما وَقَفَت وَالرِكا","بُ بَينَ الحَجونِ وَبَينَ السِرَر",58,"ر",1,0],["بِأَيّامٍ خَوالٍ صالِحاتٍ","وَلَذّاتٍ تُذَكِّرُني الشَبابا",59,"ب",2,0],["بِأَيدي مَعشَرٍ قَتَلوا بُجَيراً","لِحَربِهِمِ إِذا شُبَّت سُعارُ",60,"ر",1,0],["بِآيَةِ ما لاقَيتِ مِن كُلِّ حَسرَةٍ","وَما قَد أَذَقناكِ الهَوانَ عَلى صُغرِ",61,"ر",1,0],["بِأَيِّ رِشاءٍ يا اِبنَ أَربَدَ تَرتَقي","إِلى الشَمسِ إِذ صامَت وَطالَ نَهارُها",62,"ر",3,0],["بايدي الفريقين منهم سيوف","بها من قراع الدروع فلول",63,"ل",1,0],["بائس ينخز الاسى قلبه كل","لياليه ليلة الملسوع",64,"ع",1,0],["بأية ريح فيكِ هبت زعازع","تصوَّح ذاك الروض فاجتث ذاويا",65,"ي",2,0],["بأي جواب غير ذا السيف تطمع","وهل دونه رد لمولاك مقنع",66,"ع",1,1],["بِأَيِّ فُؤادٍ تَلتَقي الهَولَ ثابِتاً","وَما لِقُلوبِ العالَمينَ ثَباتُ",67,"ت",1,0],["بِأَيمانِهِم نورانِ ذِكرٌ وَسُنَّةٌ","فَما بالُهُم في حالِكِ الظُلُماتِ",68,"ت",1,0],["بايَعَتهُ القُلوبُ في صُلبِ سيتي","يَومَ أَن شاقَها إِلَيهِ الرَجاءُ",69,"ا",2,0],["بأيِّ وَجْهٍ أَتلقّاهُمُ","إذا رَأَوني بعْدَهُمْ حيّا",70,"ي",2,0],["بِأَيِّ بِلادٍ لَم أَجُرَّ ذُؤابَتي","وَأَيُّ مَكانٍ لَ