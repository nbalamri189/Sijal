اولت المكارم والمساعي","https://www.aldiwan.net/poem12173.html","الوافر"],[522,"عبير الثنا في الخافقين يفوح","https://www.aldiwan.net/poem13284.html","الطويل"],[534,"أتذكر داراً بين دمخ ومنورا","https://www.aldiwan.net/poem23850.html","الطويل"],[536,"بإيابك الميمون أشرق نور","https://www.aldiwan.net/poem47426.html","عموديه"],[536,"بأيديهم لعبوا بالورق","https://www.aldiwan.net/poem47534.html","عموديه"],[536,"بأي لسان في المحافل أخطب","https://www.aldiwan.net/poem48289.html","عموديه"],[542,"بايعت ذكراك","https://www.aldiwan.net/poem67252.html","عموديه"],[549,"أما ترى الدهر لا يبقي على حال","https://www.aldiwan.net/poem47289.html","البسيط"],[549,"أظنك من جدوى الأحبة قانطا","https://www.aldiwan.net/poem47729.html","الطويل"],[549,"ألا هل لما فات من مطلب","https://www.aldiwan.net/poem48061.html","المتقارب"],[556,"ألا إنما المخلوق يعرف بالعقل","https://www.aldiwan.net/poem34212.html","الخفيف"],[556,"لقد قيل لي ما الفرق عند أولي الذكر","https://www.aldiwan.net/poem34496.html","الطويل"],[562,"سألناك شيئاً لو سمحت لنا به","https://www.aldiwan.net/poem834.html",""],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[567,"فان يبل الشباب فكل شيء","https://www.aldiwan.net/poem51993.html","الوافر"],[573,"بأي الظبى ضربت مقلتاه","https://www.aldiwan.net/poem2835.html","المتقارب"],[573,"إنني من عتقائك","https://www.aldiwan.net/poem3042.html","مجزوء الرمل"],[584,"صدودك هل له أمد قريب","https://www.aldiwan.net/poem17409.html","الوافر"],[585,"أمور القضا ليست بحكم العوالم","https://www.aldiwan.net/poem11521.html","عموديه"]],"verses":[["بِأَيِّ جَنانٍ قارِحٍ أَطلُبُ العُلى","وَأُطمِعُ سَيفي أَن يُبيدَ الأَعادِيا",0,"ي",2,0],["بِأَيدي جَرِيّينَ لا كوا الحُرو","بَ وَاِرتَضَعوها اِرتِضاعَ اللِبانِ",1,"ن",1,0],["بِأَيِّ سَراةٍ أَحمِلُ الخَطبَ إِن عَرا","وَقَد جُبَّ مِنهُم غارِبي وَسَنامي",2,"ي",1,0],["بِأَيدٍ تَحبِسُ الأَورادَ عِزّاً","وَتَأمَنُ مِن مُلاطَمَةِ السِجالِ",3,"ل",1,0],["بِأَيمانِنا بيضُ الغُروبِ خَفائِفٌ","نَغولُ بِها هامَ العِدا وَتَغولُها",4,"ل",3,0],["بِأَيِّ طَرفٍ أَرى العَلياءَ إِن نَضَبَت","عَيني وَلَجلَجتُ عَنها بِالمَعاذيرِ",5,"ر",1,0],["بِأَيِّ يَدٍ أَرمي الزَمانَ وَساعِدٍ","وَكانوا يَدي أَعطَيتُها الخَطبَ عَن يَدي",6,"د",2,0],["بايَعَ أَطرافَ القَنا","وَعاقَدَ المُهَنَّدا",7,"د",2,0],["بِأَيِّ مَنالٍ أَم بِأَيَّةِ أَذرُعٍ","تَعاطَيتُمُ اليَومَ البِناءَ العَطوَّدا",8,"د",2,0],["بِأَيمانِهِم بيضٌ يُضيءُ وُجوهَهُم","قَواضِبُ قَد جُرِّبنَ كُلَّ مُجَرَّبِ",9,"ب",1,0],["بِأَيِّ دَواعي الهَوى تُطرَقونَ","فَقالوا بِهَذا البُريقِ المُلالي",10,"ي",1,0],["بِأَيْدٍ إِذَا ما أَنْكَرَ الكَلْبُ أَهْلَه","عَرَفْتُ لَها طَعْناً يُشَظِّى رِماحَها",11,"ح",3,0],["بِأَيْديهمُ تَهْتَزُّ ناصِيَةُ العُلا","وَيَحْتَلبُ العافِي أَفاوِيقَ نائِلِ",12,"ل",1,0],["بأيْمانِهِمْ بِيضٌ مشاريفُ تَختَلي","رُؤوساً من الأعداءِ مالَتْ طُلاتُها",13,"ت",3,0],["بأيْدٍ يُسْتَشَفُّ الجودُ فيها","تُفيدُ مَحامِداً وتُفيتُ مالا",14,"ل",2,0],["بِأَيديهِم مُهَنَّدَةٌ وَسُمرٌ","كَأَنَّ ظُباتِها شُعَلُ الضِرامِ",15,"م",1,0],["بِأَيِّ لِسَانٍ أَمْ بِأَيِّ بَلاَغَةٍ","أُقَضِّي فُرُوضاً منْ حُقُوقِكَ لاَزِمَهْ",16,"م",2,0],["بِأَيِّ شُكْرٍ نُوَفِّي كُنْهَ نِعْمَتِهِ","لَوْ أَنَّ سحبانَ أَوْ قُسّاً لَهَا انْتُدِبَا",17,"ب",2,0],["بِآيَةِ أَنَّ الوَلعَ مِنكَ سَجِيَّةٌ","لَهِجتَ بِها فيما تَجِدُّ وَتَهزِلُ",18,"ل",1,0],["بايَعتَ فيه أبا بَكرٍ فبايَعَه","على الخِلافَةِ قاصِيها ودانِيها",19,"ي",3,0],["بِآيِ مُحَمَّدٍ وَبِآيِ عيسى","فَعَوِّذهُ وَآياتِ الكَليمِ",20,"م",1,0],["بِأَيِّ الخِلالِ المَغربيُّ إِلَيكُمُ","ترَقّى وَما فيهِ خِلالٌ تُحَبَّبُ",21,"ب",1,0],["بِأَيِّ مَشيئَةٍ عَمرُو بنَ هِندٍ","نَكونُ لِقَيلِكُم فيها قَطينا",22,"ن",2,0],["بِأَيِّ مَشيئَةٍ عَمرُو بنَ هِندٍ","تُطيعُ بِنا الوُشاةَ وَتَزدَرينا",22,"ن",2,0],["بِأَيِّ مَشيئَةٍ عَمرُو بنَ هِندٍ","تَرى أَنّا نَكونُ الأَرذَلينا",22,"ن",2,0],["بِأَيِّ مَشيئَةٍ عَمرُو بنَ هِندٍ","تَقَدَّمُنا وَنَحنُ السابِقونا",22,"ن",2,0],["بِأَيِّ عَلاقَتِنا تَرغَبونَ","أَعَن دَمِ عَمروٍ عَلى مَرثِدِ",23,"د",1,0],["بِأَيديهِمُ خَطّيّة وَعَلهِمُ","سَوابِغُ فِرعَونِيَّةٌ جُدِلت جَدلا",24,"ل",2,0],["بِأَيِّ عِبْءٍ نَهَضْتَ حِينَ","اللِّدَاتُ فِي الخَوْضِ يَلْعَبُونَا",25,"ن",2,0],["بِأَيِّ مَظَاهِرِ التَّكْرِيمِ يُجْزَى","وِفَاقاً ذَلِكَ الجَّهْدُ الجَسِيمُ",26,"م",1,0],["بَايِعُوا العِلْمَ وَالْفَضِيلَةَ فِيهِ","أَيِّدُوا كُلَّ عَاقِلٍ وَنَزِيهِ",27,"ه",1,0],["بِأَيِّ جَهْلٍ غَدَوْنَا أُمَّةً هَمَلاً","وَأَيِّ عَقْلٍ تَوَلَّتْ وَعْيَنَا الأُمَمُ",28,"م",1,0],["بَايَعْتَ دُونَ حِمَاكَ بَيْعَةَ خَاسِرٍ","تُؤْتَاهُ مِنْ كَدْحِ الفَقِيرِ المُعْدِمِ",29,"م",1,0],["بِأَيِّ جَمَالٍ أَبْدَأَ اللهُ رَسْمَهَا","وَأَيِّ جَلالٍ ذَلِكَ الرَّسْمُ يُخْتَمُ",30,"م",1,0],["بِأَيِّ يَدٍ أحَلَّ الفَن","هَذَا الرُّوحَ فِي الصَّنَمِ",31,"م",1,0],["بِأَيلَةَ وَالخَليجِ لَهُم رُسومٌ","وَآثارٌ قَدُمنَ وَما مُحينا",32,"ن",2,0],["بِأَينُقٍ كَقِداحِ النَبعِ قَد ذَبَلَت","مِنها الشَمائِلُ أَمثالِ القَراقيرِ",33,"ر",1,0],["بآية ما بلغت دين محمد","أمانيَّ للرحمن تُدني وتُزلفُ",34,"ف",1,0],["بآيةِ ما أعطى الخليفةَ ربُّهُ","مفاتيح فتحٍ ساقها سائق السعدِ",35,"د",1,0],["بأيديهم عصّي مشرعات","مهيّأة لضرب واحتثاث",36,"ث",1,0],["بِأَيِّ نِجادٍ تَحمِلُ السَيفَ بَعدَما","قَطَعتَ القُوى مِن مِحمَلٍ كانَ باقِيا",37,"ي",2,0],["بِأَيِّ سِنانٍ تَطعُنُ القَومَ بَعدَما","نَزَعتَ سِناناً مِن قَناتِكَ ماضِيا",37,"ي",2,0],["بِأَيّامِ قَومي ما لِقَومِكَ مِثلُها","بِها سَهَّلوا عَنّي خَبارَ الجَراثِمِ",38,"م",1,0],["بِأَيّامِ قَومٍ ما لِقَومِكَ مِثلُها","بِها سَهَّلوا عَنّي خَبارَ الجَراثِمِ",39,"م",1,0],["بِأَيِّ قَديمٍ يا رَبيعَ بنَ مالِكٍ","وَأَنتُم ذُنابى لا يَدانِ وَلا صَدرُ",40,"ر",1,0],["بِأَيِّ بَلاءٍ تَحمَدونَ مُجاشِعاً","غَباغِبَ أَثوارٍ تَلَظّى عَلى جَسرِ",41,"ر",1,0],["بِأيِّ كِتَابٍ أَم بِأيَّةِ سُنَّةٍ","تَرَى حُبَّهُم عَاراً عَلَيَّ وتَحسَبُ",42,"ب",1,0],["بِأيِّ مَشِيئَة في ابنى نِزَارٍ","تُُهَمِّمُني أَكُفُّ اللاَّمِسينَا",43,"ن",2,0],["بِأَيِّ عُذرٍ رَدَدتَ والِهَةً","عَلَيكَ دونَ الوَرى مُعَوَّلُها",44,"ل",3,0],["بِأَيِّ دُعاءِ داعِيَةٍ أُوَقّى","بِأَيِّ ضِياءِ وَجهٍ أَستَنيرُ",45,"ر",1,0],["بِأَيديهِم صَوارِمُ مُرهَفاتٌ","وَكُلُّ مُجَرَّبٍ خاظي الكُعوبِ",46,"ب",1,0],["بِأَيدي رِجالٍ هاجَروا نَحوَ رَبِّهِم","وَأَنصارِهِ حَقّاً وَأَيدي المَلائِكِ",47,"ك",1,0],["بِأَيدي رِجالٍ لَم يَسُلّوا سُيوفَهُم","بِحَقٍّ وَقَتلى لَم تُجَنَّ ثِيابُها",48,"ب",3,0],["بِأَيمانِهِم بيضٌ إِذا حَسِرَ الوَغى","فَلا بُدَّ أَن يَردى بِهِنَّ صَريعُ",49,"ع",1,0],["بأي حالية إذ وصلت","ذكرها أعطف من مر النسيم",50,"م",1,1],["بأيمن طالع مسرى وزير","نوال يداه للآمالِ محيا",51,"ي",2,1],["بآيةِ ألا يبرحَ المرءُ منكُمُ","يُكَبُّ على حُرِّ الجبين فيُعفَجُ",52,"ج",1,0],["بأية ملأ مغنماً وسلامةً","حواها رفيعَ العيش خوضُ الشدائدِ",53,"د",1,0],["بأيِّ وجهٍ تلاقي اللَّه معتذِراً","جلت خطيئتك العظمى عن العذر",54,"ر",1,0],["بايتُّه في بيته فأملَّني","يشكو إليَّ هوى عميد مُدنَف",55,"ف",1,0],["بأيدي بني وهبٍ فإنَّ سحابَهَمْ","سَحابٌ يعمُّ الناسَ بالغيث هَطّالُ",56,"ل",1,0],["بِآيَةِ ما وَقَفَت وَالرِكا","بُ بَينَ الحَجونِ وَبَينَ السِرَر",57,"ر",1,0],["بِأَيّامٍ خَوالٍ صالِحاتٍ","وَلَذّاتٍ تُذَكِّرُني الشَبابا",58,"ب",2,0],["بِأَيدي مَعشَرٍ قَتَلوا بُجَيراً","لِحَربِهِمِ إِذا شُبَّت سُعارُ",59,"ر",1,0],["بِآيَةِ ما لاقَيتِ مِن كُلِّ حَسرَةٍ","وَما قَد أَذَقناكِ الهَوانَ عَلى صُغرِ",60,"ر",1,0],["بِأَيِّ رِشاءٍ يا اِبنَ أَربَدَ تَرتَقي","إِلى الشَمسِ إِذ صامَت وَطالَ نَهارُها",61,"ر",3,0],["بايدي الفريقين منهم سيوف","بها من قراع الدروع فلول",62,"ل",1,0],["بائس ينخز الاسى قلبه كل","لياليه ليلة الملسوع",63,"ع",1,0],["بأية ريح فيكِ هبت زعازع","تصوَّح ذاك الروض فاجتث ذاويا",64,"ي",2,0],["بأي جواب غير ذا السيف تطمع","وهل دونه رد لمولاك مقنع",65,"ع",1,1],["بِأَيِّ فُؤادٍ تَلتَقي الهَولَ ثابِتاً","وَما لِقُلوبِ العالَمينَ ثَباتُ",66,"ت",1,0],["بِأَيمانِهِم نورانِ ذِكرٌ وَسُنَّةٌ","فَما بالُهُم في حالِكِ الظُلُماتِ",67,"ت",1,0],["بايَعَتهُ القُلوبُ في صُلبِ سيتي","يَومَ أَن شاقَها إِلَيهِ الرَجاءُ",68,"ا",2,0],["بأيِّ وَجْهٍ أَتلقّاهُمُ","إذا رَأَوني بعْدَهُمْ حيّا",69,"ي",2,0],["بِأَيِّ بِلادٍ لَم أَجُرَّ ذُؤابَتي","وَأَيُّ مَكانٍ لَم تَطَأهُ رَكائِبي",70,"ب",2,0],["بِأَيِّ حُكمِ زَمانٍ صِرتَ مُتَّخِذاً","رِئمَ الفَلا بَدَلاً مِن رِئمِ أَهليكا",71,"ك",2,0],["بِأَيِّ لَفظٍ تَقولُ الشِعرَ زِعنِفَةٌ","تَجوزُ عِندَكَ لا عُربٌ 