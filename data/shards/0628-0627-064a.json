ww.aldiwan.net/poem9884.html","المجتث"],[503,"أفيضوا لنا يا أهل أم عبيدة","https://www.aldiwan.net/poem38012.html","الطويل"],[517,"بزغت بالظلام شمس الديور","https://www.aldiwan.net/poem20787.html","الخفيف"],[518,"تناولت المكارم والمساعي","https://www.aldiwan.net/poem12173.html","الوافر"],[527,"عبير الثنا في الخافقين يفوح","https://www.aldiwan.net/poem13284.html","الطويل"],[539,"أتذكر داراً بين دمخ ومنورا","https://www.aldiwan.net/poem23850.html","الطويل"],[541,"بإيابك الميمون أشرق نور","https://www.aldiwan.net/poem47426.html","عموديه"],[541,"بأيديهم لعبوا بالورق","https://www.aldiwan.net/poem47534.html","عموديه"],[541,"بأي لسان في المحافل أخطب","https://www.aldiwan.net/poem48289.html","عموديه"],[547,"بايعت ذكراك","https://www.aldiwan.net/poem67252.html","عموديه"],[554,"أما ترى الدهر لا يبقي على حال","https://www.aldiwan.net/poem47289.html","البسيط"],[554,"أظنك من جدوى الأحبة قانطا","https://www.aldiwan.net/poem47729.html","الطويل"],[554,"ألا هل لما فات من مطلب","https://www.aldiwan.net/poem48061.html","المتقارب"],[561,"ألا إنما المخلوق يعرف بالعقل","https://www.aldiwan.net/poem34212.html","الخفيف"],[561,"لقد قيل لي ما الفرق عند أولي الذكر","https://www.aldiwan.net/poem34496.html","الطويل"],[567,"سألناك شيئاً لو سمحت لنا به","https://www.aldiwan.net/poem834.html",""],[571,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[572,"فان يبل الشباب فكل شيء","https://www.aldiwan.net/poem51993.html","الوافر"],[578,"بأي الظبى ضربت مقلتاه","https://www.aldiwan.net/poem2835.html","المتقارب"],[578,"إنني من عتقائك","https://www.aldiwan.net/poem3042.html","مجزوء الرمل"],[589,"صدودك هل له أمد قريب","https://www.aldiwan.net/poem17409.html","الوافر"],[590,"أمور القضا ليست بحكم العوالم","https://www.aldiwan.net/poem11521.html","عموديه"],[621,"","https://poetry.dctabudhabi.ae/diwan/poem/29483","الطويل"],[660,"","https://poetry.dctabudhabi.ae/diwan/poem/79685","الوافر"],[713,"","https://poetry.dctabudhabi.ae/diwan/poem/20577","الطويل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/28060","الطويل"],[856,"","https://poetry.dctabudhabi.ae/diwan/poem/18051","الطويل"],[856,"","https://poetry.dctabudhabi.ae/diwan/poem/18050","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/2","الطويل"],[1094,"","https://poetry.dctabudhabi.ae/diwan/poem/75819","الوافر"],[1095,"","https://poetry.dctabudhabi.ae/diwan/poem/17774","الطويل"],[1164,"","https://poetry.dctabudhabi.ae/diwan/poem/18787","الطويل"],[1193,"","https://poetry.dctabudhabi.ae/diwan/poem/200299","الوافر"]],"verses":[["بأيكما أبكي ومن ذا أجاهد","وكلكما ماضٍ وكليّ فاقد",0,"د",1,1],["بِأَيِّ جَنانٍ قارِحٍ أَطلُبُ العُلى","وَأُطمِعُ سَيفي أَن يُبيدَ الأَعادِيا",1,"ي",2,0],["بِأَيدي جَرِيّينَ لا كوا الحُرو","بَ وَاِرتَضَعوها اِرتِضاعَ اللِبانِ",2,"ن",1,0],["بِأَيِّ سَراةٍ أَحمِلُ الخَطبَ إِن عَرا","وَقَد جُبَّ مِنهُم غارِبي وَسَنامي",3,"م",2,0],["بِأَيدٍ تَحبِسُ الأَورادَ عِزّاً","وَتَأمَنُ مِن مُلاطَمَةِ السِجالِ",4,"ل",1,0],["بِأَيمانِنا بيضُ الغُروبِ خَفائِفٌ","نَغولُ بِها هامَ العِدا وَتَغولُها",5,"ل",3,0],["بِأَيِّ طَرفٍ أَرى العَلياءَ إِن نَضَبَت","عَيني وَلَجلَجتُ عَنها بِالمَعاذيرِ",6,"ر",1,0],["بِأَيِّ يَدٍ أَرمي الزَمانَ وَساعِدٍ","وَكانوا يَدي أَعطَيتُها الخَطبَ عَن يَدي",7,"د",2,0],["بايَعَ أَطرافَ القَنا","وَعاقَدَ المُهَنَّدا",8,"د",2,0],["بِأَيِّ مَنالٍ أَم بِأَيَّةِ أَذرُعٍ","تَعاطَيتُمُ اليَومَ البِناءَ العَطوَّدا",9,"د",2,0],["بِأَيمانِهِم بيضٌ يُضيءُ وُجوهَهُم","قَواضِبُ قَد جُرِّبنَ كُلَّ مُجَرَّبِ",10,"ب",1,0],["بِأَيِّ دَواعي الهَوى تُطرَقونَ","فَقالوا بِهَذا البُريقِ المُلالي",11,"ل",2,0],["بِأَيْدٍ إِذَا ما أَنْكَرَ الكَلْبُ أَهْلَه","عَرَفْتُ لَها طَعْناً يُشَظِّى رِماحَها",12,"ح",3,0],["بِأَيْديهمُ تَهْتَزُّ ناصِيَةُ العُلا","وَيَحْتَلبُ العافِي أَفاوِيقَ نائِلِ",13,"ل",1,0],["بأيْمانِهِمْ بِيضٌ مشاريفُ تَختَلي","رُؤوساً من الأعداءِ مالَتْ طُلاتُها",14,"ت",3,0],["بأيْدٍ يُسْتَشَفُّ الجودُ فيها","تُفيدُ مَحامِداً وتُفيتُ مالا",15,"ل",2,0],["بِأَيديهِم مُهَنَّدَةٌ وَسُمرٌ","كَأَنَّ ظُباتِها شُعَلُ الضِرامِ",16,"م",1,0],["بِأَيِّ لِسَانٍ أَمْ بِأَيِّ بَلاَغَةٍ","أُقَضِّي فُرُوضاً منْ حُقُوقِكَ لاَزِمَهْ",17,"م",2,0],["بِأَيِّ شُكْرٍ نُوَفِّي كُنْهَ نِعْمَتِهِ","لَوْ أَنَّ سحبانَ أَوْ قُسّاً لَهَا انْتُدِبَا",18,"ب",2,0],["بِآيَةِ أَنَّ الوَلعَ مِنكَ سَجِيَّةٌ","لَهِجتَ بِها فيما تَجِدُّ وَتَهزِلُ",19,"ل",1,0],["بايَعتَ فيه أبا بَكرٍ فبايَعَه","على الخِلافَةِ قاصِيها ودانِيها",20,"ي",3,0],["بِآيِ مُحَمَّدٍ وَبِآيِ عيسى","فَعَوِّذهُ وَآياتِ الكَليمِ",21,"م",1,0],["بِأَيِّ الخِلالِ المَغربيُّ إِلَيكُمُ","ترَقّى وَما فيهِ خِلالٌ تُحَبَّبُ",22,"ب",1,0],["بِأَيِّ مَشيئَةٍ عَمرُو بنَ هِندٍ","نَكونُ لِقَيلِكُم فيها قَطينا",23,"ن",2,0],["بِأَيِّ مَشيئَةٍ عَمرُو بنَ هِندٍ","تُطيعُ بِنا الوُشاةَ وَتَزدَرينا",23,"ن",2,0],["بِأَيِّ مَشيئَةٍ عَمرُو بنَ هِندٍ","تَرى أَنّا نَكونُ الأَرذَلينا",23,"ن",2,0],["بِأَيِّ مَشيئَةٍ عَمرُو بنَ هِندٍ","تَقَدَّمُنا وَنَحنُ السابِقونا",23,"ن",2,0],["بِأَيِّ عَلاقَتِنا تَرغَبونَ","أَعَن دَمِ عَمروٍ عَلى مَرثِدِ",24,"د",1,0],["بِأَيديهِمُ خَطّيّة وَعَلهِمُ","سَوابِغُ فِرعَونِيَّةٌ جُدِلت جَدلا",25,"ل",2,0],["بِأَيِّ عِبْءٍ نَهَضْتَ حِينَ","اللِّدَاتُ فِي الخَوْضِ يَلْعَبُونَا",26,"ن",2,0],["بِأَيِّ مَظَاهِرِ التَّكْرِيمِ يُجْزَى","وِفَاقاً ذَلِكَ الجَّهْدُ الجَسِيمُ",27,"م",1,0],["بَايِعُوا العِلْمَ وَالْفَضِيلَةَ فِيهِ","أَيِّدُوا كُلَّ عَاقِلٍ وَنَزِيهِ",28,"ه",1,0],["بِأَيِّ جَهْلٍ غَدَوْنَا أُمَّةً هَمَلاً","وَأَيِّ عَقْلٍ تَوَلَّتْ وَعْيَنَا الأُمَمُ",29,"م",1,0],["بَايَعْتَ دُونَ حِمَاكَ بَيْعَةَ خَاسِرٍ","تُؤْتَاهُ مِنْ كَدْحِ الفَقِيرِ المُعْدِمِ",30,"م",1,0],["بِأَيِّ جَمَالٍ أَبْدَأَ اللهُ رَسْمَهَا","وَأَيِّ جَلالٍ ذَلِكَ الرَّسْمُ يُخْتَمُ",31,"م",1,0],["بِأَيِّ يَدٍ أحَلَّ الفَن","هَذَا الرُّوحَ فِي الصَّنَمِ",32,"م",1,0],["بِأَيلَةَ وَالخَليجِ لَهُم رُسومٌ","وَآثارٌ قَدُمنَ وَما مُحينا",33,"ن",2,0],["بِأَينُقٍ كَقِداحِ النَبعِ قَد ذَبَلَت","مِنها الشَمائِلُ أَمثالِ القَراقيرِ",34,"ر",1,0],["بآية ما بلغت دين محمد","أمانيَّ للرحمن تُدني وتُزلفُ",35,"ف",1,0],["بآيةِ ما أعطى الخليفةَ ربُّهُ","مفاتيح فتحٍ ساقها سائق السعدِ",36,"د",1,0],["بأيديهم عصّي مشرعات","مهيّأة لضرب واحتثاث",37,"ث",1,0],["بِأَيِّ نِجادٍ تَحمِلُ السَيفَ بَعدَما","قَطَعتَ القُوى مِن مِحمَلٍ كانَ باقِيا",38,"ي",2,0],["بِأَيِّ سِنانٍ تَطعُنُ القَومَ بَعدَما","نَزَعتَ سِناناً مِن قَناتِكَ ماضِيا",38,"ي",2,0],["بِأَيّامِ قَومي ما لِقَومِكَ مِثلُها","بِها سَهَّلوا عَنّي خَبارَ الجَراثِمِ",39,"م",1,0],["بِأَيّامِ قَومٍ ما لِقَومِكَ مِثلُها","بِها سَهَّلوا عَنّي خَبارَ الجَراثِمِ",40,"م",1,0],["بِأَيِّ قَديمٍ يا رَبيعَ بنَ مالِكٍ","وَأَنتُم ذُنابى لا يَدانِ وَلا صَدرُ",41,"ر",1,0],["بِأَيِّ بَلاءٍ تَحمَدونَ مُجاشِعاً","غَباغِبَ أَثوارٍ تَلَظّى عَلى جَسرِ",42,"ر",1,0],["بِأيِّ كِتَابٍ أَم بِأيَّةِ سُنَّةٍ","تَرَى حُبَّهُم عَاراً عَلَيَّ وتَحسَبُ",43,"ب",1,0],["بِأيِّ مَشِيئَة في ابنى نِزَارٍ","تُُهَمِّمُني أَكُفُّ اللاَّمِسينَا",44,"ن",2,0],["بِأَيِّ عُذرٍ رَدَدتَ والِهَةً","عَلَيكَ دونَ الوَرى مُعَوَّلُها",45,"ل",3,0],["بِأَيِّ دُعاءِ داعِيَةٍ أُوَقّى","بِأَيِّ ضِياءِ وَجهٍ أَستَنيرُ",46,"ر",1,0],["بِأَيديهِم صَوارِمُ مُرهَفاتٌ","وَكُلُّ مُجَرَّبٍ خاظي الكُعوبِ",47,"ب",1,0],["بِأَيدي رِجالٍ هاجَروا نَحوَ رَبِّهِم","وَأَنصارِهِ حَقّاً وَأَيدي المَلائِكِ",48,"ك",1,0],["بِأَيدي رِجالٍ لَم يَسُلّوا سُيوفَهُم","بِحَقٍّ وَقَتلى لَم تُجَنَّ ثِيابُها",49,"ب",3,0],["بِأَيمانِهِم بيضٌ إِذا حَسِرَ الوَغى","فَلا بُدَّ أَن يَردى بِهِنَّ صَريعُ",50,"ع",1,0],["بأي حالية إذ وصلت","ذكرها أعطف من مر النسيم",51,"م",1,1],["بأيمن طالع مسرى وزير","نوال يداه للآمالِ محيا",52,"ي",2,1],["بآيةِ ألا يبرحَ المرءُ منكُمُ","يُكَبُّ على حُرِّ الجبين فيُعفَجُ",53,"ج",1,0],["بأية ملأ مغنماً وسلامةً","حواها رفيعَ العيش خوضُ الشدائدِ",54,"د",1,0],["بأيِّ وجهٍ تلاقي اللَّه معتذِراً","جلت خطيئتك العظمى عن العذر",55,"ر",1,0],["بايتُّه في بيته فأملَّني","يشكو إليَّ هوى عميد مُدنَف",56,"ف",1,0],["بأيدي بني وهبٍ فإنَّ سحابَهَمْ","سَحابٌ يعمُّ الناسَ بالغيث هَطّالُ",57,"ل",1,0],["بِآيَةِ ما وَقَفَت وَالرِكا","بُ بَينَ الحَجونِ وَبَينَ السِرَر",58,"ر",1,0],["بِأَيّامٍ خَوالٍ صالِحاتٍ","وَلَذّاتٍ تُذَكِّرُني الشَبابا",59,"ب",2,0],["بِأَيدي مَعشَرٍ قَتَلوا بُجَيراً","لِحَربِهِمِ إِذا شُبَّت سُعارُ",60,"ر",1,0],["بِآيَةِ ما لاقَيتِ مِن كُلِّ حَسرَةٍ","وَما قَد أَذَقناكِ الهَوانَ عَلى صُغرِ",61,"ر",1,0],["بِأَيِّ رِشاءٍ يا اِبنَ أَربَدَ تَرتَقي","إِلى الشَمسِ إِذ صامَت وَطالَ نَهارُها",62,"ر",3,0],["بايدي الفريقين منهم سيوف","بها من قراع الدروع فلول",63,"ل",1,0],["بائس ينخز الاسى قلبه كل","لياليه ليلة الملسوع",64,"ع",1,0],["بأية ريح فيكِ هبت زعازع","تصوَّح ذاك الروض فاجتث ذاويا",65,"ي",2,0],["بأي جواب غير ذا السيف تطمع","وهل دونه رد لمولاك مقنع",66,"ع",1,1],["بِأَيِّ فُؤادٍ تَلتَقي الهَولَ ثابِتاً","وَما لِقُلوبِ العالَمينَ ثَباتُ",67,"ت",1,0],["بِأَيمانِهِم نورانِ ذِكرٌ وَسُنَّةٌ","فَما بالُهُم في حالِكِ الظُلُماتِ",68,"ت",1,0],["بايَعَتهُ القُلوبُ في صُلبِ سيتي","يَومَ أَن شاقَها إِلَيهِ الرَجاءُ",69,"ا",2,0],["بأيِّ وَجْهٍ أَتلقّاهُمُ","إذا رَأَوني بعْدَهُمْ حيّا",70,"ي",2,0],["بِأَيِّ بِلادٍ لَم أَجُرَّ ذُؤابَتي","وَأَيُّ مَكانٍ لَم تَطَأهُ رَكائِبي",71,"ب",2,0],["بِأَيِّ حُكمِ زَمانٍ صِرتَ مُتَّخِذاً","رِئمَ الفَلا بَدَلاً مِن رِئمِ أَهليكا",72,"ك",2,0],["بِأَيِّ لَفظٍ تَقولُ الشِعرَ زِعنِفَةٌ","تَجوزُ عِندَكَ لا عُربٌ وَلا عَجَمُ",73,"م",1,0],["بِأَيِّ أَسىً تُثنى الدُموعُ الهَوامِلُ","وَيُرجى زِيالٌ مِن جَوىً لا يُزايَلُ",74,"ل",1,1],["بِأَيِّ مُخزِيَةٍ جَمَّشتَ قَينَتَهُم","أَبِاِستِ مُستَحلِقٍ أَم أَيرِ عِنّينِ",75,"ن",1,0],["بِأَيَّةِ زَنمَتَيكَ تَنالُ قَومي","إِذا بَحرِي رَأَيتُ لَهُ عُبابا",76,"ب",2,0],["بِأَيدي رِجالٍ يَمنَعُ اللَهُ دينَهُم","بِأَصدَقِ مِن أَهلِ العِراقِ وَأَصبَرا",77,"ر",2,0],["بِأَيِّ رِشاءٍ يا جَريرُ وَماتِحٍ","تَدَلَّيتَ في حَوماتِ تِلكَ القَماقِمِ",78,"م",1,0],["بِأَيِّ أَبٍ يا اِبنَ المَراغَةِ تَبتَغي","رِهاني إِلى غاياتِ عَمّي وَخالِيا",79,"ي",2,0],["بِأَيِّ الجيرَتَينِ أَجَرتُموهُ","فَلَم يَصلُح لَكُم إِلّا الأَداءُ",80,"ا",2,0],["بِأَيديَهُم بيضٌ خِفافٌ قَواطِعٌ","وَقَد حادَثوها بِالجَلاءِ وَبِالصَقلِ",81,"ل",1,0],["بِأَيِّ حُجَّةٍ أَحتَجُّ يَومَ ال","حِسابِ إِذا ذُعيتُ إِلى الحِسابِ",82,"ب",1,0],["بِأَيِّ قُوىً تَظُنُّكَ لَيسَ تَبلى","وَقَد بَلِيَت عَلى الزَمَنِ الرَواسي",83,"س",2,0],["بِأَيِّ عَينٍ نَرى الأَنامَ وَقَد","تَحَكَّمَت في أُسودِنا الغ