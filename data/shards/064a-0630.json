شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=179129",""],[45,"أُثَيْلُ العَقيقِ إلى بَانِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=32006",""],[51,"صُورتُه ناعتة ٌ خُبْرَه","https://www.poetsgate.com/ViewPoem.aspx?id=27805",""],[51,"أبا جعفرٍ لا زلت مُعطى ً وواهبا","https://www.poetsgate.com/ViewPoem.aspx?id=26848",""],[51,"أصلعٌ يُكنى بأبي الجَلَّحْتِ","https://www.poetsgate.com/ViewPoem.aspx?id=27195",""],[39,"قفَا فاسألاَ الدِّمنَة َ المَاصحَة ْ","https://www.poetsgate.com/ViewPoem.aspx?id=4239",""],[31,"لِعَائِشَة َ کبْنَة ِ التَّيْمِي عِنْدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19139&r=&rc=401",""],[88,"تذكرت في أوطاني الأهلَ والصحبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19533&r=&rc=36",""],[85,"أحقُّ أنهم دفنوا عليَّا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9637&r=&rc=127",""],[3,"يُذبِّبُ وَردٌ على إثره","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10654&r=&rc=8",""]],"verses":[["يُذَمُّ لِيَ الزَمانُ إِذا أَلامَت","يَداهُ وَلا يُذَمُّ بِيَ الزَمانُ",0,"ن",1,0],["يَذودُ رِقابَها هَيهاتَ مِنها","وَقَد غَلَبَت عَصِيَّ الذائِدينا",1,"ن",2,0],["يُذاذُ عَنِ الماءِ الذَّي فيهِ رَيُّهُ","وَيَرمي إِلى الغُدرانِ مُقلَةَ ظامي",2,"ي",1,0],["يُذَمُّ اللُؤمُ عِندَهُمُ عَلَيها","وَلَيسَ لِجارِهِم أَبَداً ذِمامُ",3,"م",1,0],["يَذودونَ عَنها لِلغَريبِ سَوامَهُم","وَلَو أَنَّهُم شاؤوا القَذى وَرَدوا قَبلا",4,"ل",2,0],["يَذوي عَلى قَدَمِ اللَيالي عَهدُها","مِثلَ الأَديمِ عَلى التَقادُمِ يَنغَلُ",5,"ل",1,0],["يُذَكِّلُ لي سَطَواتِ الزَما","نِ سَيفي وَمِثلِيَ لا يَخضَعُ",6,"ع",1,0],["يُذَوِّقُ العَينَ طَعمَ النَومِ مَضمَضَةً","إِذا الجَبانُ مَلا عَيناً بِتَهجاعِ",7,"ع",1,0],["يُذَكِّرُهُ أَخذَ أَوتارِهِ","صَهيلُ السَوابِقِ حَولَ القِبابِ",8,"ب",1,0],["يَذُمُّ البيضُ مِن جَزَعٍ مَشيبي","وَدَلُّ البيضِ أَوَّلُ ما أَشابا",9,"ب",2,0],["يَذودُ الكَرى عَنّا حَديثٌ كَعِقدِها","فَلَمّا اِفتَرَقنا صارَ كالقُرطِ للإُذْنِ",10,"ن",1,0],["يَذودون عني بالأسِنّةِ والظُّبا","ولولاهُمُ أدنى خُطا العاجِزِ القِدُّ",11,"د",1,0],["يُذَكّرُنيها البَرقُ حين أَشيمُهُ","وإنْ عَنَّ خِشْفٌ بِتُّ منْها على ذِكْرِ",12,"ر",1,0],["يُذَبِّبُ وَردٌ عَلى إِثرِهِ","وَأَدرَكَهُ وَقعُ مُردٍ خَشِب",13,"ب",1,0],["يُذَكِّرُني الفِردَوسَ ريحُ كِتابِهِ","وَقَد كُنتُ حيناً قَبلَ ذاكَ أُكاتِبُه",14,"ه",1,0],["يُذيب بُراها الشّوْقُ لوْلا مَدامِعٌ","تَحُلُّ عُراها في المَحاجِرِ والخَدِّ",15,"د",1,0],["يُذكِّرُ مَرآها قُلوبَ أولِي النُّهى","بما وُعِدَ الأبْرارُ في جنّةِ الخُلْدِ",16,"د",1,0],["يُذكّرُنِيهِ الصُّبْحُ عندَ انصِباغِهِ","جَمالَ رُواءٍ في تأرُّجِ أنْفاسِ",17,"س",1,0],["يَذوقُ مُشَعشَعاً حَتّى","يُفيءَ السَبيَ وَالنَعَما",18,"م",2,0],["يَذكُرنَ بَرّاً رَحيماً قَد أَقامَ لَهُم","صَرحاً مِنَ المَجدِ أَعلى رُكنَهُ الباني",19,"ي",1,0],["يُذِلُّ إِذا شاءَ العَزيزَ وَتَرتَئي","إِرادَتُهُ رَفعَ الذَليلِ فَيُرفَعُ",20,"ع",1,0],["يُذَكِّرُني البَرقُ الشَآمِيُّ إِن خَفا","زَماني بِكُم يا حَبَّذا ذَلِكَ الزَمَن",21,"ن",1,0],["يُذَكِّرُني عَصراً تَقَضّى عَلى الحِمى","وَأَيّامَنا في أَيمنِ العَلَمِ الفَردِ",22,"د",1,0],["يَذِلُّ لَهُ الجَبّارُ خيفَةَ بَأسِهِ","وَيَعنو إِلَيهِ الأَبلَجُ المُتَغَطرِفُ",23,"ف",1,0],["يُذَكِّرُنيها كُلُّ ريحٍ مَريضَةٍ","لَها بِالتِلاعِ القاوِياتِ نَسيمُ",24,"م",1,0],["يُذَكِّرُني طُلوعُ الشَمسِ صَخراً","وَأَذكُرُهُ لِكُلِّ غُروبِ شَمسِ",25,"س",1,0],["يَذَرُ الكَمِيَّ مُجَدَّلاً","تَرِبَ المَناخِرِ مُنقَعِس",26,"س",1,0],["يَذودُها عَن حِمامِ المَوتِ ذائِدَةٌ","كَاللَيثِ يَحمي عَريناً دونَ أَشبالِ",27,"ل",1,0],["يَذْكُو هَوَاهَا فِي جَوَانِحِهِمْ","كَالجَمْرِ مَشْبُوباً وَإِنْ رَصُنُوا",28,"ن",3,0],["يَذودونَ الذُبابَ يَمُرُّ عَنهُ","كَأَمثالِ المَلائِكَةِ الغِضابِ",29,"ب",1,0],["يَذودُ عَنِ الحَوضِ أَعداءَهُ","فَكَم مِن لَعينٍ طَريدٍ وَكَم",30,"م",1,0],["يُذَبِّبنَ عَن أَقرابِهِنَّ بِأَرجُلٍ","وَأَذنابِ زُعرِ الهُلبِ زُرقِ المَقامِعِ",31,"ع",1,0],["يَذُبُّ القَصايا عَن شَراةٍ كَأَنَّها","جَماهيرُ تَحتَ المُدجِناتٍ الهَواضِب",32,"ب",1,0],["يذكي الكِباءُ بها كأن دخانَهُ","قطعُ السحاب بجوها المتغيّم",33,"م",1,0],["يذكرني من مطلع الشمس شعرُها","ذوائبَ تُرخَى من أشعّتها الصفر",34,"ر",1,0],["يذفّ عليهم بالظبي من خطوبه","فكم جدعت أنفاً وكم صلمت أذنا",35,"ن",2,0],["يذمّم فعل السوء وهو حليفه","ويحمد قول الصدق وهو كذوب",36,"ب",1,0],["يُذيبُ غُرورَهُنَّ وَلَو يُصَلّى","حَديدُ الأَقوَلَينِ بِهِ لَذابا",37,"ب",2,0],["يُذَكِّرُني بِأَربَدَ كُلُّ خَصمٍ","أَلَدَّ تَخالُ خُطَّتَهُ ضِرارا",38,"ر",2,1],["يُذَبذِبُ أَقواماً يُريدونَ هَدمَها","نِيافٌ يَبُذُّ الواسِعُ المُتَطاوِلا",39,"ل",2,0],["يَذعَرُ البَركَ فَقَد أَفزَعَهُ","ناهِضٌ يَنهَضُ نَهضَ المُختَزَل",40,"ل",1,0],["يَذُودُ بِسَحماويه من ضَارِياتِها","مَدَاقيعَ لم يَغثَث عَلَيهِنَّ مَكسَبُ",41,"ب",1,0],["يُذَكِّرُني نَجداً حَبيبٌ بِأَرضِها","أَيا صاحِبي نَجوايَ هَل يَنفَعُ الذِكرُ",42,"ر",1,0],["يُذَكِّرُنا بُعدُ الفِراقِ عُهودَهُ","وَتِلكَ عُهودٌ قَد بَلينَ رَثائِثُ",43,"ث",1,0],["يُذكي أَخوكَ شِهابَ الحَربِ مُعتَمِداً","فَيَستَضيءُ وَيَغشى جَدُّكَ اللَهَبا",44,"ب",2,0],["يُذَكِّرنَ آلاءَ الرَسولِ وَما أَرى","لَها مُحصِياً نَفسي فَنَفسي تَبَلَّدُ",45,"د",1,0],["يذكرُ العهدَ بالعقيقِ فيبكي","لهواهُ بدمعةٍ حمراء",46,"ا",2,0],["يذَكرْني بدرُ السماءِ سِميّه","فها أنا أرعى كلّ بدرٍ وأرقب",47,"ب",1,0],["يذكرني مغنى حماهُ جماله","فلله ذكرى منزل وحبيب",48,"ب",1,0],["يذكرني عهد الوفا ما نسيته","ولكنه تجديدُ ذكرٍ على ذكر",49,"ر",1,0],["يذكر صحنَ الوجه صحنُ كنافة","هما الحلو ممَّا تشهد العين والفكر",50,"ر",1,0],["يذكرني عهد العقيق كأنه","بلؤلؤِ دمعي صارَ عقداً مرصَّعا",51,"ع",2,0],["يذبّ كما ذبّ ابن يحيى عن العلى","فلا الأنس دان من حماها ولا الجان",52,"ن",1,0],["يذكره الجنات طيب مقامه","فيدأب في تحصيلها كيف يمكن",53,"ن",1,0],["يذكرنا أخبار معنٍ بجودِه","فننثني له لفظاً وينشي لنا معنى",54,"ن",2,0],["يذُمُّك مظلوماً وتلحاهُ ظالماً","هناك فيستعدي عليك الأقاربا",55,"ب",2,0],["يذكِّرني الشبابَ صَدىً طويلٌ","إلى بَرَدِ الثنايا والرُّضابِ",56,"ب",1,0],["يُذكِّرني الشبابَ هوانُ عَتبي","وصدُّ الغانيات لدى عتابي",56,"ب",2,0],["يُذكّرني الشبابَ سهامُ حَتْفٍ","يُصبنَ مقاتلي دون الإهابِ",56,"ب",1,0],["يُذكرني الشبابَ جِنانُ عَدْن","على جنبات أنهارٍ عذابِ",56,"ب",1,0],["يُذكِّرني الشبابَ رياضُ حَزْنٍ","ترنَّم بينها زُرقُ الذُّبابِ",56,"ب",1,0],["