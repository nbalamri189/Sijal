هّبُ ذِهْنِهِ أوقاتَهُ","فكأنَّما هوَ بالغُدُوّ مُهَجِّر",150,"ر",1,0],["يُذَكِّرُني الدُجى حَميماً","هُنالِكَ باتَ أَو خِلّاً وَفِيّا",151,"ي",2,0],["يُذكي الحَياءُ بِوَجنَتَيهِ جَمرَةً","فَيَكادُ نَدُّ الخالِ يَعبَقُ طيبُهُ",152,"ب",2,0],["يُذَكِّي وَيَشُدُّ القُوَى","وَمَا فِي عَوَاقِبِهِ مَنْدَمُ",153,"م",1,0],["يُذْكى الكَلاَمُ لَظَى الكِلاَمِ وَإِنَّما","أَشْفَى المُوَاساةَ الْبُكَاءُ الصَّامِتُ",154,"ت",1,0],["يذْكُرُ الله في النَّعِيمِ وَلاَ يَنْ","سَاهُ إِنْ طَافَ طَائِفٌ مِنْ شَقَاءِ",155,"ا",2,0],["يُذِيبُ فُؤَادِي ذِكْرُ مَا قَدْ بَلَوْتَهُ","مِنَ البُؤْسِ فِي الدُّنْيَا بِذَاكَ التَّجَلدِ",156,"د",1,0],["يَذْكُرُوا لِلشَّيْخِ فِي أَعْنَاقِهِمْ","مَا لَهُ مِنْ فَضْلِ أَسْتَاذٍ وَأَبْ",157,"ب",1,0],["يَذْهبُ مَيْتٌ وَرَاءَ مَيْتٍ","وَأَنْثَني أذُرِفُ الدُّمُوعَا",158,"ع",2,0],["يَذُودُونَنَا عَنْ دِينِنَا وَنَذُودُهُمْ","عَنِ الكُفْرِ والرّحْمنُ رَاءٍ وسَامِعُ",159,"ع",1,0],["يَذُودُونَ عَنْ أحْسَابِهِمْ وَتِلاَدِهِمْ","ببيضٍ تَقُدُّ الهَامَ تحتَ القوانِسِ",160,"س",1,0],["يَذُودُ ويحمي عَنْ ذِمَارِ مُحَمَّدِ","وَيَدْفَعُ عَنْهُ باللّسانِ وَبِاليَدِ",161,"د",1,0],["يَذبُلُ لَو حَلَّ فيهِ وَجدي","لَخَرَّ دانيهِ وَالقَصِيُّ",162,"ي",1,0],["يَذْهبُ الفقرُ والثَّراءُ ويَبْقى","ما بَنَى الخيِّرونَ من أَعْمالِ",163,"ل",1,0],["يذهب الأمسُ بالرجال فيُنسَوْن","وتَمضِي القُرون قرنا فقرنا",164,"ن",2,0],["يذكرُ ما مرّ من عهودٍ","للّه ما أنضرَ العهودا",165,"د",2,0],["يُذْهِلُ الصَبَّ عَنْ أَحادِيثِ لَيْلاَ","هُ وَيُنْسِيهِ حَوْمَلاً وَالدخُولاَ",166,"ل",2,0],["يذوبُ مضَاءُ السيفِ عِنْدَ مَضَائهِ","فَمَا هو إِلا غِمْدُهُ وحَمَائِلهْ",167,"ل",2,0],["يُذَكِّرُنَا المأمونَ يومَ زِفافِهِ","وَقَدْ مَشَتْ الدُّنْيَا إِلَيْهِ تُجَامِلُهْ",167,"ل",2,0],["يذبح الطفلَ أعْصَلَ النابِ شيطا","ناً ويحسو دَمَ النساء مَرِيدا",168,"د",2,0],["يذِلُّ له شَموسُ القوْلِ طوْعاً","ويستخذِي له المعنى المُدِلّ",169,"ل",1,0],["يذكِّرنا بك نفحُ الرِّياضِ","ومرُّ النَسِيمِ، وضوءُ القَمَر",170,"ر",1,0],["يذيب كُحْل العين والأهداب","وما على الأَوْجُه منْ خضَاب",171,"ب",1,0],["يذيب ثراها الشوق لولا مدامع","تحل عراها في المحاجر والخد",172,"د",1,0],["يَذَرُ المُعارِضَ ذا الفَصاحَة ِ ألْكَنا","وَإلى المَسيحِ وَأُمِّهِ وَكَفَى بها",173,"ه",2,0],["يذكرِّني علياكُمُ رونقُ الضحى","اذا ارتفعت شمس النهار على رمح",174,"ح",1,0],["يذكّرُني أريجٌ بات يُهدي","إلىَّ لطيمُه الريحَ البليلا",175,"ل",2,0],["يُذلِّلُ من شارداتِ القريضِ","ما لو سِواهُ ابتغاهُ لَفَر",176,"ر",1,0],["يُذكّرُنا لُبْسُ نَعْمَائهِ","لِبَاسَ الشّبابِ وَرَيْعَانِهِ",177,"ن",2,0],["يُذْكي على زُغفانه عيْنَه","وعينُه عن عِرْسِهِ راقدَهْ",178,"د",2,0],["يذُمُّك مظلوماً وتلحاهُ ظالماً","هناك فيستعدي عليه الأقاربا",179,"ب",2,0],["يذكر حمدانَ عميدَ البرتِ","مُعَبِّسُ الوجه طويلُ السكتِ",180,"ت",1,0],["يَذِبلُ إِذَا نَسَمَ الأَبْرَدانْ","ويخدرُ بالصَّرَّة ِ الصَّامحهْ",181,"ح",2,0],["يُذَكِّرُني کبْنَة َ التَّيْمِيِّ ظَبْيٌ","يرودُ بروضة ٍ سهلٍ رباها",182,"ا",3,0],["يذلل ادنى فعلها المطلب الصعبا","تمشي بأطمارها والبرد يَلسعها",183,"ا",1,0],["يُذكِّرني الدُّجَى لِدَة ً حَمِيماً","هنالكَ باتَ، أو خلاًّ وفيَّا",184,"ي",2,0],["يُذبِّبُ وَردٌ على إثره","وأمْكنَهُ وَقع مِرد خَشِبْ",185,"ب",1,1]]}