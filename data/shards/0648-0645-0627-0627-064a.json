{"poems":[[9,"أأزمعت من آل ليلى ابتكارا","https://www.aldiwan.net/poem21940.html","المتقارب"],[90,"عهد الصبا سقيا لأيام الصبا","https://www.aldiwan.net/poem44447.html","الرجز"],[69,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202527","الرجز"],[164,"على من بالهدى يا ابن الإمامه","https://www.aldiwan.net/poem59206.html","الوافر"],[302,"أفي كل ربع للمطي بنا وقف","https://www.aldiwan.net/poem33218.html","الطويل"],[303,"إذا لم تطق (لمياء) أن تنجز الوعدا","https://www.aldiwan.net/poem36321.html","عموديه"],[556,"حلفت بمعشر عسفوا المطايا","https://www.aldiwan.net/poem47223.html","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87099","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87063","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48792","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38339","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59625","الطويل"],[1459,"","https://poetry.dctabudhabi.ae/diwan/poem/138019",""],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115978","الوافر"],[2376,"","https://poetry.dctabudhabi.ae/diwan/poem/115232","الوافر"],[2897,"","https://poetry.dctabudhabi.ae/diwan/poem/122225","الرجز"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132527","الوافر"],[3697,"","https://poetry.dctabudhabi.ae/diwan/poem/140267",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131230",""],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35483","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58009","الطويل"],[4565,"","https://poetry.dctabudhabi.ae/diwan/poem/73933","الوافر"],[5701,"تعجبت حتى كدت لا أتعجب","https://www.poetsgate.com/ViewPoem.aspx?id=164590",""],[5956,"شقاء الشوق ‏","https://www.poetsgate.com/ViewPoem.aspx?id=181907",""],[5956,"أعاني من الأحزان ما يغضِب الهوَى","https://www.poetsgate.com/ViewPoem.aspx?id=183713",""],[5956,"يُنَغّصُ عيشي","https://www.poetsgate.com/ViewPoem.aspx?id=183740",""],[5956,"أ تأتي الإمارات يا صالح؟","https://www.poetsgate.com/ViewPoem.aspx?id=194595",""],[5970,"عجيب منك لومك لليالي","https://www.poetsgate.com/ViewPoem.aspx?id=130597",""]],"verses":[["وَما أَيبُلِيُّ عَلى هَيكَلٍ","بَناهُ وَصَلَّبَ فيهِ وَصارا",0,"ر",2,0],["وما إياة الشمس في تطفيلها","مثل إياة الشمس في رأد الضحا",1,"ا",1,0],["وما آياتُه تُحْصَى بِعَدٍّ","فَيُدْرِكَ شَأْوَها مني طَلوبُ",2,"ب",1,0],["وما أيست من كريم يغضي","ولا أمنت حاسدا ذا بغض",3,"ض",1,0],["وما ائتمن الإله سواك فيه","فلا تأمن على مرعى مسامه",4,"م",2,0],["وما أَينعت يوماً رؤوسُ عداتِهِ","بروض الوَغى إِلّا وحانَ لها قَطفُ",5,"ف",1,0],["وَما أيأستْ يوماً وَفي اليأسِ راحةٌ","وَلا محضتني بعد إعراضها الوِدَّا",6,"د",2,0],["وما أيمانُهمْ إلّا لبيضٍ","يبلّغْنَ الفتى أبداً مَرامَهْ",7,"م",2,0],["وَما إِياسٌ وَقَيسٌ وَاِبن زائِدة","إِلّا لَديهِ مِن الأتباع وَالخَدَم",8,"م",1,0],["وَما إِياس لَديهِ في الذَكاء سِوى","أَغبى البرية إِن عرباً وَإِن عجما",9,"م",2,0],["وما ائتلفا إلا ليختلفا هوىً","وهل يستوي يوماً غراب وقشعم",10,"م",1,0],["وَما آيةُ اللّيلِ البهيمِ قَدِ اِنمَحَت","لَدى شِدّةِ الظّلماءِ مِن آيةِ الفَجرِ",11,"ر",1,0],["وما أيمنَ الدنيا بنا حيث أمْننا","يمدُّ على الأرجاء من ظلنا سترا",12,"ر",2,0],["وما إيمَان شَخصٍ حالَ بأسٍ","بمقبُولِ لِفَقدِ الإمتثَالِ",13,"ل",1,0],["وما أيقنتُ أنّ الشمسَ تدنو","فتُحملُ فوق أكتاف الرجال",14,"ل",1,0],["وما إيجافنا خلفَ الموالي","بسُنّتِنا على عهدِ الرسول",15,"ل",1,1],["وما ائتلت تذرع كل فدفد","اذرعها وكل قاع قرق",16,"ق",1,0],["وما أيامها إلا ركاب","ونحن الركب والموت الحداء",17,"ا",2,0],["وما أيقنت بالهجران منهم","سوى قطع الزيارة للسلام",18,"م",1,0],["وما أيمانهم إلا كذابٌ","وما أقوالهم إلا محال",19,"ل",1,0],["وَما اِئتَلَفَت أَجسامُ قَومٍ تَناكَرَت","عَلى القربِ أَرواحٌ لَهُم وَقُلوبُ",20,"ب",1,0],["وما آيةٌ في الكونِ إلا وأيُّها","على قدرة المولَى دليلٌ وشاهدْ",21,"د",1,0],["وَما أَيّامُنا إِلا مَطايا","تَخُبُّ بِنا وَما تَشكو كَلالا",22,"ل",2,1],["وما ائتلقت شمس له في سمائها","وليس لها من بعد ذلك مغرب",23,"ب",1,0],["‏ ‏وما أي حُسْنٍ قد أفاد قريحتي","‏ ‏ كما حسنك الساري بكل مشاعري",24,"ر",2,0],["وما أيُّ منهاج يُنّمّي هناءَنا","كمثل التَّحايا والهوى والتَّكافُلِ",25,"ل",1,0],["وما أي شرٍّ ينغص عيشي","سوى الجهل في عقلنا والصدورْ",26,"ر",1,0],["وما أي عيد يهنّي به","ولا إن مرضنا لنا كادحُ",27,"ح",1,0],["وما أيامنا إلا ظروف","فهل بينا وظرف من قتال",28,"ل",1,0]]}