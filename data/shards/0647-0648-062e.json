,"https://poetry.dctabudhabi.ae/diwan/poem/108333",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109891","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205756","الرمل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85235","الرمل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128932","الخفيف"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133269","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111397","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123500","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83404","الكامل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117212","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72458","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141567","الكامل"],[4709,"قلمٌ وقضية","https://www.poetsgate.com/ViewPoem.aspx?id=214835",""],[4955,"ولدي يموت","https://www.poetsgate.com/ViewPoem.aspx?id=187966",""],[5121,"مُسْكِرَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=33588",""],[5122,"لا قلت ....!","https://www.poetsgate.com/ViewPoem.aspx?id=28150",""],[5136,"القلب يخشع والأماني تدمع","https://www.poetsgate.com/ViewPoem.aspx?id=121614",""],[5136,"الحق أبلج واضح للمهتدي","https://www.poetsgate.com/ViewPoem.aspx?id=121802",""],[5219,"القول المسدد في معارضة همزية أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=193910",""],[5338,"لي في هباتك حيرة لا توصف","https://www.poetsgate.com/ViewPoem.aspx?id=187913",""],[5431,"هند..وبلقيس المقعدة!!...","https://www.poetsgate.com/ViewPoem.aspx?id=200068",""],[5431,"في يوم مولد سيدي محمد (ص)","https://www.poetsgate.com/ViewPoem.aspx?id=200935",""],[5561,"هو خيرةٌ من خيرةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=193807",""],[5612,"بشير الخير","https://www.poetsgate.com/ViewPoem.aspx?id=192486",""],[5691,"المفسدون في الأرض","https://www.poetsgate.com/ViewPoem.aspx?id=206745",""],[5704,"يا ليت...","https://www.poetsgate.com/ViewPoem.aspx?id=198741",""],[5861,"مناجاتي","https://www.poetsgate.com/ViewPoem.aspx?id=188039",""],[5866,"لوكان فكري يحمر العين مشلول","https://www.poetsgate.com/ViewPoem.aspx?id=182811",""],[5956,"أيها البحر الحبيب ‏","https://www.poetsgate.com/ViewPoem.aspx?id=183232",""],[5956,"وتتابعت آيات ربك","https://www.poetsgate.com/ViewPoem.aspx?id=192633",""],[5956,"ذكرى وداع شقيقي","https://www.poetsgate.com/ViewPoem.aspx?id=192923",""],[5956,"مخلصٌ سيحسّن أمورنا","https://www.poetsgate.com/ViewPoem.aspx?id=193084",""],[5956,"بِظِلال نخلهما أنخُّ رواحلي","https://www.poetsgate.com/ViewPoem.aspx?id=193693",""],[5956,"ما جاء لي من أي ضَوءٍ","https://www.poetsgate.com/ViewPoem.aspx?id=193825",""],[5956,"حوانيتُ بيعِ الماء","https://www.poetsgate.com/ViewPoem.aspx?id=194472",""],[5956,"أصدقاء خالد مظلوم يسائلونه:","https://www.poetsgate.com/ViewPoem.aspx?id=201899",""],[5956,"عميان القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=202498",""],[5956,"يا رب فك الغمة عن طحال ولدي","https://www.poetsgate.com/ViewPoem.aspx?id=214668",""],[5956,"نجْلي فراس الطاهرُ الرُّوحاني","https://www.poetsgate.com/ViewPoem.aspx?id=215496",""],[5956,"السيرة الذاتية للدكتور قيسٍ الرِّضواني بالشعر الروحاني","https://www.poetsgate.com/ViewPoem.aspx?id=215553",""],[6318,"مهرجان القصيد (1)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66156&r=&rc=6",""],[5190,"لا تسألي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85040&r=&rc=115",""]],"verses":[["هُوَ خِطَّةٌ نَزَلَ الشِتاءُ بِها","وَالصَيفُ مُنطَلِقٌ وَمُرتَحِلُ",0,"ل",1,0],["هُوَ خَيرُ مَن يَبني لَنا","فَدَعوهُ يَنهَضُ بِالبِنايَه",1,"ا",3,0],["هُوَ خِدْنٌ فَقَدْتُهُ","فَقَدْ مَأْثُورَةِ النِّعَمْ",2,"م",1,0],["هو خطب أبكى العراقين والشا","م وركن البَنِيّة المحجوجه",3,"ج",2,0],["هو خيرٌ من صاحبٍ ورفيقٍ","مُسْعِدٍ في الجَليَّةِ البَهْماءِ",4,"ا",2,0],["هُوَ خِلٌّ لَبِسْتُ مِنْهُ خِلالاً","عَبِقَاتٍ كَالنَّوْرِ فِي الأَكْمَامِ",5,"م",1,0],["هُوَ خُلقٌ كَما أَرَدتَ وَحَظٌّ","مِن عَطايا المُهَيمِنِ الوَهّابِ",6,"ب",1,0],["هُوَ خَالِدٌ وَيَظَلُّ مِدْرَهَ قَوْمِهِ","فِي كُلِّ نَازِلَةٍ وَكُلِّ نِضَالِ",7,"ل",1,0],["هو خَلْقٌ من الكمالِ المصفَّى","من رآه الكمالَ بذاتهْ",8,"ت",2,0],["هُوَ خَطُّ الْجَمَالِ في صَفْحةِ الْكَوْ","نِ فَهَلْ لِلْجَمَالِ مِنْ قُرَّاءِ",9,"ا",2,0],["هُوَ خَيْرُ مَنْ هَزَّ الْيَرَا","عَ وَهَزَّ أَعْوَادَ الْمَنابِرْ",10,"ر",1,0],["هُوَ خَير مِن أَن تُؤَمل قَرضاً","فَيَردوك خامد الأَنفاس",11,"س",1,0],["هو خطةٌ همَّ المُصيفُ بقصدها","شوقا ونادى بالشتاء رحيلُ",12,"ل",1,0],["هُوَ خَيرُ فَكَّاك لِكُل عَسيرَةٍ","عُقدت فَحارَت دونَها الأَفكارُ",13,"ر",1,0],["هو خمسةٌ عدداً يَصِحُّ ثلاثةً","لكنْ هُمُ عَشْرٌ تَتِمُّ وأزْيَد",14,"د",1,0],["هو خلد ، وما الخطيئة إلا","بعض وحي الفناء للأحياء !",15,"ا",2,0],["هو خير مأمول وأكرم شافع","يوم القيامة جاره لا يهمط",16,"ط",1,0],["هو خاتم للأنبياء وفاتح","للأولياء وشربهم من شربه",17,"ب",2,0],["هُوَ خَيرُ مَن وَطَأَ الثَرى وَأَعَزُّهُم","جاراً فَخَيرُ المُعتَفينَ عُفاتُهُ",18,"ت",2,0],["هُوَ خَيرُ الأَنامِ بَعدَ رَسولِ ال","لَهُ أَفتَت بِذَلِكَ الفُقَهاءُ",19,"ا",2,0],["هُوَ خير من كمل الاناس به من ال","أَبناء والآباء والاجداد",20,"د",1,0],["هُوَ خَيرٌ مِن شِعبِ بَوّانَ إِن رَب","بَعَ فيهِ الرَبيعُ كُلَّ أَوانِ",21,"ن",1,0],["هو خمري ونشوتي وحديثي","وغرامي ومنيتي وطلابي",22,"ب",2,0],["هوَ خيرٌ من رجالٍ باركو","لعَدوِّ الله فِيمَا اغْتَصَبهْ",23,"ب",2,0],["هو خطوة عرجاء مهما حبّذت","فدعوا المحبذ أن يكون سواكمو",24,"م",2,0],["هو خافض الأعداء ينصب نفسه","لبناءِ علياءِ ورفع مفاخر",25,"ر",1,0],["هو خادم لبلاده","ولدين سيدنا محمد",26,"د",1,0],["هُوَ خِرِّيجُ ديبوني","صَرحِ بَاريزِ المَشِيد",27,"د",1,0],["هو خلق الله أي تقديره","ظاهر بالأمر أمر الله",28,"ه",1,0],["هو خَاتَمٌ فِي فِيه يا","مَا فِيهِ مِمَّا صَاغَ رَبِّي",29,"ب",2,0],["هُوَ خَشْفِي وَهْوَ مُفْتَرِسِي","فَاروِ عَنْ أُعْجُوبَتِي خَبرا",30,"ر",2,0],["هو خير أحسان ينيف على الغنى","من ربكم وعلى المعالي والسنا",31,"ن",2,0],["هو خير فأل للمريض فإنه","يبدو به أمل الحياة ويظهر",32,"ر",1,0],["هو خير من أصفى الوداد وخير من","صحب البريّة والفؤادُ سليم",33,"م",1,0],["هو خَشَّ التقى بغيرِ خشاشٍ","ثم أَعطى الوصيَّ ذاك الخشاشا",34,"ش",2,0],["هو خمسة فوقوف دين","أصلها وهو الصميمْ",35,"م",1,0],["هو خير الورى واشرف عبد","مستقيم شرحت بالنور صدره",36,"ر",2,0],["هُوَ خَير هادٍ لِلوَرى وَأَجَل مِن","أَمَلي البُخاريّ الشَريف لِمُسلم",37,"م",1,0],["هو خيرُ من نمتْ العلاءُ وآلهُ","من ذروة الجوزاء أشرف منتمى",38,"م",2,0],["هو خير من رضعَ المكارمَ درَّها","ورعى بها مُذ كان فرضَ حقوقها",39,"ق",3,0],["هو خير من ضمَّت معاقدُ حبوةٍ","وأخوه فخراً خير من عَقد الحُبا",40,"ب",2,0],["هو خطبُ النَّجيبِ مالَ بأَوتادِ","المعالي فمادت الأَرجاء",41,"ا",2,0],["هو خطب بكى له الشرقُ والغربُ","ومن فيهما كسعدٍ قليل",42,"ل",1,0],["هو خير من خاض العجاج وإنما","حضر الوغى وجنوده أغمار",43,"ر",1,0],["هو خير الأعلام والأحبار بل","علم على الأعلام والأحبار",44,"ر",1,0],["هو خاتم الرسل الكرام ومصدر","لنيابة التبشير والانذار",45,"ر",1,0],["هو خير من قد انجبته بعصره","وابر من ولدته من ابناء",46,"ا",2,0],["هو خير مولود به ام العلا","قد انجبت قرت به عيناكا",47,"ك",2,0],["هُوَ خَير مَن حازَ الفَضائل أَهله","وَشُموس مَولده السَعيد سَوامر",48,"ر",1,0],["هو خود عذراء تخطب كفؤا","لم تشن زين حسنه الأنساب",49,"ب",1,0],["هو خير مأمول وأحسن مرتجي","واجل ذي كرم واعظم جيد",50,"د",1,0],["هو خير ما غذَّى وأنعش جاهداً","فيه من البحر الكريم عطاءُ",51,"ا",2,0],["هو خاطبُ العلياء وهي تسومه","هو طالبُ الجوزاء وهي السلم",52,"م",1,0],["هو خير الخلق عند الله من","كان للأيجاد أقوى سبب",53,"ب",1,0],["هو خطب لا يجمل الصبر فيه","ضاق قلب منه كما عيل صبرا",54,"ر",2,0],["هُوَ خُبزُنا اليوميُّ قُوتُ حَياتِنا","بل كُفؤُها وسَواهُ ليسَ بهِ اكتِفا",55,"ا",1,0],["هو خنزير ولكن شأنه","جسدٌ في وضعه منحرف",56,"ف",1,0],["هو خير الخلق طراً وبِهِ","للنبيين جرى ختم وفتح",57,"ح",1,0],["هو خالٍ مني ولم يبق فيه","غير ذكر اجتماعنا بسلام",58,"م",1,0],["هو خير جاه أرتجيه لنصرتي","في الدين والدنيا وكل تقوهي",59,"ه",2,0],["هو خَيرٌ عَلمتَ أن تَستَرِدَّ ال","سهَّمَ مِمَّن يَصُدُّ قولَكَ إِن ضَل",60,"ل",1,0],["هو خير من وطىء الثرى وسما السما","وأجل من يعد العدات فينجز",61,"ز",1,0],["هو خير خلق اللَه كل","ل الخير عنده يُعهَدُ",62,"د",1,0],["هو خير خلق اللَه والمختار من","أعلى نجار جلّ عن أنداد",63,"د",1,0],["هو خادم الحر