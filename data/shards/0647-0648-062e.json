{"poems":[[53,"أمبلغي ما أطلب الغزل","https://www.aldiwan.net/poem29910.html","الكامل"],[86,"أي مكمهون قدمت بالقصد","https://www.aldiwan.net/poem10680.html","مجزوء الكامل"],[93,"كيف قوضت يا علم","https://www.aldiwan.net/poem11343.html","مجزوء الخفيف"],[88,"أيها الانكليز لن نتناسى","https://www.aldiwan.net/poem44457.html","الخفيف"],[51,"صرحت عن طوية الأصدقاء","https://www.aldiwan.net/poem7996.html","الخفيف"],[87,"حي مغنى الهوى بوادي الشآم","https://www.aldiwan.net/poem8286.html","الخفيف"],[52,"يا إمام الهدى ويا أحكم الناس","https://www.aldiwan.net/poem27265.html","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55118","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54305","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54285","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54318","الكامل"],[110,"كن حريصا واجمع من المال ما شئ","https://www.aldiwan.net/poem16529.html","الخفيف"],[143,"ألكم إلى رد الشباب سبيل","https://www.aldiwan.net/poem58447.html","الكامل"],[183,"هتفت تبشر بالضحى الأطيار","https://www.aldiwan.net/poem67069.html","الكامل"],[186,"مجد تقاصر عن سماه الفرقد","https://www.aldiwan.net/poem14509.html","الكامل"],[227,"عصمة الحب","https://www.aldiwan.net/poem24231.html","عموديه"],[232,"إن بان من تهوى وأنت مثبط","https://www.aldiwan.net/poem44584.html","الكامل"],[232,"خذ للحجاز إذا مررت بركبه","https://www.aldiwan.net/poem44598.html","الكامل"],[236,"عصر الشباب تصرمت أوقاته","https://www.aldiwan.net/poem32134.html","الكامل"],[236,"خجلت من عطائك الأنواء","https://www.aldiwan.net/poem32200.html","الخفيف"],[272,"ضربت سعاد خيامها بفؤادي","https://www.aldiwan.net/poem52108.html","الكامل"],[283,"حل أزرار جنة الزبداني","https://www.aldiwan.net/poem32320.html","الخفيف"],[329,"طار يطوى مجاهل الأفق والنار","https://www.aldiwan.net/poem55059.html","الخفيف"],[401,"في خليج العقبة","https://www.aldiwan.net/poem6745.html","عموديه"],[454,"لا أرتضيه لكم ولا أرضاكمو","https://www.aldiwan.net/poem61227.html","الكامل"],[465,"كم بين أكناف العذيب وحاجر","https://www.aldiwan.net/poem3505.html","عموديه"],[480,"هذا الابى التونسي","https://www.aldiwan.net/poem36965.html","مجزوء الكامل"],[539,"إن تشا تحيى سعيدا","https://www.aldiwan.net/poem48212.html","عموديه"],[559,"صبغة الله وجود الله","https://www.aldiwan.net/poem33628.html","الرمل"],[576,"مالي هجرت بغير ذنب","https://www.aldiwan.net/poem3104.html","مجزوء الكامل"],[587,"قمر يجلو دجى الغلس","https://www.aldiwan.net/poem17971.html","المديد"]],"verses":[["هُوَ خِطَّةٌ نَزَلَ الشِتاءُ بِها","وَالصَيفُ مُنطَلِقٌ وَمُرتَحِلُ",0,"ل",1,0],["هُوَ خَيرُ مَن يَبني لَنا","فَدَعوهُ يَنهَضُ بِالبِنايَه",1,"ا",3,0],["هُوَ خِدْنٌ فَقَدْتُهُ","فَقَدْ مَأْثُورَةِ النِّعَمْ",2,"م",1,0],["هو خطب أبكى العراقين والشا","م وركن البَنِيّة المحجوجه",3,"ج",2,0],["هو خيرٌ من صاحبٍ ورفيقٍ","مُسْعِدٍ في الجَليَّةِ البَهْماءِ",4,"ا",2,0],["هُوَ خِلٌّ لَبِسْتُ مِنْهُ خِلالاً","عَبِقَاتٍ كَالنَّوْرِ فِي الأَكْمَامِ",5,"م",1,0],["هُوَ خُلقٌ كَما أَرَدتَ وَحَظٌّ","مِن عَطايا المُهَيمِنِ الوَهّابِ",6,"ب",1,0],["هُوَ خَالِدٌ وَيَظَلُّ مِدْرَهَ قَوْمِهِ","فِي كُلِّ نَازِلَةٍ وَكُلِّ نِضَالِ",7,"ل",1,0],["هو خَلْقٌ من الكمالِ المصفَّى","من رآه الكمالَ بذاتهْ",8,"ت",2,0],["هُوَ خَطُّ الْجَمَالِ في صَفْحةِ الْكَوْ","نِ فَهَلْ لِلْجَمَالِ مِنْ قُرَّاءِ",9,"ا",2,0],["هُوَ خَيْرُ مَنْ هَزَّ الْيَرَا","عَ وَهَزَّ أَعْوَادَ الْمَنابِرْ",10,"ر",1,0],["هُوَ خَير مِن أَن تُؤَمل قَرضاً","فَيَردوك خامد الأَنفاس",11,"س",1,0],["هو خطةٌ همَّ المُصيفُ بقصدها","شوقا ونادى بالشتاء رحيلُ",12,"ل",1,0],["هُوَ خَيرُ فَكَّاك لِكُل عَسيرَةٍ","عُقدت فَحارَت دونَها الأَفكارُ",13,"ر",1,0],["هو خمسةٌ عدداً يَصِحُّ ثلاثةً","لكنْ هُمُ عَشْرٌ تَتِمُّ وأزْيَد",14,"د",1,0],["هو خلد ، وما الخطيئة إلا","بعض وحي الفناء للأحياء !",15,"ا",2,0],["هو خير مأمول وأكرم شافع","يوم القيامة جاره لا يهمط",16,"ط",1,0],["هو خاتم للأنبياء وفاتح","للأولياء وشربهم من شربه",17,"ب",2,0],["هُوَ خَيرُ مَن وَطَأَ الثَرى وَأَعَزُّهُم","جاراً فَخَيرُ المُعتَفينَ عُفاتُهُ",18,"ت",2,0],["هُوَ خَيرُ الأَنامِ بَعدَ رَسولِ ال","لَهُ أَفتَت بِذَلِكَ الفُقَهاءُ",19,"ا",2,0],["هُوَ خير من كمل الاناس به من ال","أَبناء والآباء والاجداد",20,"د",1,0],["هُوَ خَيرٌ مِن شِعبِ بَوّانَ إِن رَب","بَعَ فيهِ الرَبيعُ كُلَّ أَوانِ",21,"ن",1,0],["هو خمري ونشوتي وحديثي","وغرامي ومنيتي وطلابي",22,"ب",2,0],["هوَ خيرٌ من رجالٍ باركو","لعَدوِّ الله فِيمَا اغْتَصَبهْ",23,"ب",2,0],["هو خطوة عرجاء مهما حبّذت","فدعوا المحبذ أن يكون سواكمو",24,"م",2,0],["هو خافض الأعداء ينصب نفسه","لبناءِ علياءِ ورفع مفاخر",25,"ر",1,0],["هو خادم لبلاده","ولدين سيدنا محمد",26,"د",1,0],["هُوَ خِرِّيجُ ديبوني","صَرحِ بَاريزِ المَشِيد",27,"د",1,0],["هو خلق الله أي تقديره","ظاهر بالأمر أمر الله",28,"ه",1,0],["هو خَاتَمٌ فِي فِيه يا","مَا فِيهِ مِمَّا صَاغَ رَبِّي",29,"ب",2,0],["هُوَ خَشْفِي وَهْوَ مُفْتَرِسِي","فَاروِ عَنْ أُعْجُوبَتِي خَبرا",30,"ر",2,0]]}