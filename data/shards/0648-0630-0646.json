{"poems":[[87,"يا فرنسا نلت أسباب السماء","https://www.aldiwan.net/poem63728.html","الكامل"],[45,"لجنية أم غادة رفع السجف","https://www.aldiwan.net/poem9728.html","الطويل"],[89,"يموت معي سر الصديق ولحده","https://www.aldiwan.net/poem8213.html","مجزوء الطويل"],[17,"عفا من آل فاطمة الخبيت","https://www.aldiwan.net/poem1192.html",""],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85388","البسيط"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43824","المديد"],[108,"مشاعر الآباء!","https://www.poetsgate.com/ViewPoem.aspx?id=179320",""],[121,"قيثار1","https://www.aldiwan.net/poem24075.html","الخفيف"],[147,"بقيت ولا عزت عليك المطالب","https://www.aldiwan.net/poem11719.html","الطويل"],[154,"قضى القلب من عهد الشباب ديونه","https://www.aldiwan.net/poem68583.html","الطويل"],[193,"كلما قلت سر قلبي الحزين","https://www.aldiwan.net/poem35149.html","الخفيف"],[199,"منع النوم طارقات الهموم","https://www.aldiwan.net/poem54415.html","الخفيف"],[240,"أولعت بالغدر في أيمانها","https://www.aldiwan.net/poem31728.html","الرمل"],[276,"أيرجع لي قرب الحبيب المعاهد","https://www.aldiwan.net/poem52107.html","الطويل"],[347,"أنا أهواك يا ليلى","https://www.aldiwan.net/poem55339.html","الهزج"],[371,"بعد المعاطف والروادف لم ترق","https://www.aldiwan.net/poem17156.html","الكامل"],[415,"قالوا ترشفت الليالي ماءه","https://www.aldiwan.net/poem32170.html","الكامل"],[534,"يجاهرني العدو بكل نكر","https://www.aldiwan.net/poem37467.html","الوافر"],[556,"هبت تلوم على الندى هند","https://www.aldiwan.net/poem47877.html","أحذ الكامل"],[556,"فضح الشيب شبابي فافتضح","https://www.aldiwan.net/poem47884.html","الرمل"],[556,"كل يوم غريبة للخطوب","https://www.aldiwan.net/poem48056.html","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48790","المتقارب"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38106","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70922","الخفيف"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96646","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65037","الرمل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136322",""],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112937","المتقارب"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79449","الوافر"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132850","الطويل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48939","المتقارب"],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101914","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110301","الطويل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96026","الخفيف"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109455","الرجز"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47194","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62833","الخفيف"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133234","الرمل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133233","الرمل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135230","الطويل"],[3987,"","https://poetry.dctabudhabi.ae/diwan/poem/146889","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58076","الطويل"],[5133,"سبتها ليه","https://www.poetsgate.com/ViewPoem.aspx?id=205945",""],[5136,"يا ليلة جاءت على قدر","https://www.poetsgate.com/ViewPoem.aspx?id=121600",""],[5136,"بمن يستغيث العبد إلا بمولاه","https://www.poetsgate.com/ViewPoem.aspx?id=121766",""],[5277,"بنتُ الرصافة","https://www.poetsgate.com/ViewPoem.aspx?id=193830",""],[5358,"أعاصير ومنافي","https://www.poetsgate.com/ViewPoem.aspx?id=21863",""],[5431,"أنطقُ الضاد خائفا من زماني ...","https://www.poetsgate.com/ViewPoem.aspx?id=199742",""],[5652,"خلي عيوني بالغلا تذرف دموع","https://www.poetsgate.com/ViewPoem.aspx?id=136101",""],[5725,"هواي عذري","https://www.poetsgate.com/ViewPoem.aspx?id=177796",""],[4623,"على من باح بالحب ملام (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146605",""],[5845,"أيرجعُلي قربُ الحبيبِ المعاهدِ","https://www.poetsgate.com/ViewPoem.aspx?id=198432",""],[6048,"نبوءة كل المياه","https://www.poetsgate.com/ViewPoem.aspx?id=201217",""],[6152,"لا شيء بعدكِ","https://www.poetsgate.com/ViewPoem.aspx?id=203011",""],[6305,"وَشَيْطانٍ يُقاسِمُني نَصِيبي !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87329&r=&rc=2",""]],"verses":[["وَذُنابى كُلُّ ريحٍ مَسَّها","مَسَّهُ صاعِقَةٌ مِن كَهرُباء",0,"ا",2,0],["وَذَنبِيَ تَقصيري وَما جِئتُ مادِحاً","بِذَنبي وَلَكِن جِئتُ أَسأَلُ أَن تَعفو",1,"ف",2,0],["وَذَنْبِي فِي ذَا الْجَحْدِ أَيْسَرُ مَحْمَلاً","مِنَ الذَّنْبِ فِي إِفْشَائِهِ بِلِسَانِي",2,"ن",2,0],["وَذَنبٍ قَد عَفَوتُ لِغَيرِ باعٍ","وَلا واعٍ وَعَنهُ قَد عَفَوتُ",3,"ت",1,0],["وَذَنبه كونه محبّا","قد كتم الحب ثم باحا",4,"ح",2,0],["وَذُنوبي كَالحَصا عَدَداً","أَينَ منّي ما لَهُ حَصَلا",5,"ل",2,0],["وذنوب الأَبناء للصَّفْح والغُفْ","ران؛ مهما جَنوْا فهم أبرياءُ",6,"ا",2,0],["وذُنوبي وتَوبتي وعُيوبي","وابتهالي وسَجْدَتي وركوعي",7,"ع",2,0],["وَذَنبِيَ أَن زُفَّت إِلى غَيرِ أَهلِها","أَلا إِنَّني مِنهُ إِلى المَجدِ تائِبُ",8,"ب",1,0],["وَذَنبيَ يأبى في الرِفاقِ تَقَدُّمي","وَما بانَ عَن فِكري وَلا زالَ عَن",9,"ن",1,0],["وذُنوبي قد أثقَلَتني وديني","بحقوقٍ لم أقضهنّ رهينُ",10,"ن",1,0],["وَذناباً تَزينُ دُبراً لَهُ ذا","كَفَلٍ مُشرِفٍ كَصَمدِ الجُثومِ",11,"م",1,0],["وَذُنوبٌ أَوبَقَتني كَثرَةً","بِكُمُ أَطمَعُ في غُفرانِها",12,"ن",3,0],["وَذَنبي يا مَولاي أَضعاف ذنبه","وَبحرك للراجين عذب المَوارِد",13,"د",1,0],["وذنبي انني باق","على عهدي لخلاني",14,"ي",1,0],["وَذُنوبُ دَهري في فِراقِكَ جَمَّةٌ","فَإِذا بَقِيت بِهِ فَلا تَثريبُ",15,"ب",1,0],["وذُنُوبُه مفغورَةٌ","لو كاثَرتْ فينا الرِّمَالاَ",16,"ل",2,0],["وذَنْبِي عِنْد إِخْوانِي بأَنِّي","هَدَيْتُهُمُ إلى سُبُلِ الرَّشادِ",17,"د",1,0],["وذنوبُ صَرْفِكِ إنْ عُدِدْنَ لنا","فَنِيَ الزّمانُ وَما اِنقَضى العَدُّ",18,"د",1,0],["وَذنوبٌ كُنَّ لِي مغفورةً","عاد فيها كلُّ من كان صَفحْ",19,"ح",1,0],["وذنوبٌ من الزّمان فقد عش","تُ طَويلاً وَما له مِن ذنوبِ",20,"ب",1,0],["وذنب الحوادث عند الحسو","دِ نيلك منها الذي لم ينل",21,"ل",1,0],["وَذَنبُك مَغفورٌ وَإِنّي مؤرِّخٌ","وَحجّك مَبرورٌ وَسَعيُك مَشكورُ",22,"ر",1,0],["وذنوبُ الأنام لم تُحصَ عدا","أعجزت كل بائح مِفْتاشِ",23,"ش",1,0],["وَذنبيَ مغفورٌ مع البيضِ إن رنت","إِلى رَونقي حنّت ليَ الخرّدُ الغيدُ",24,"د",1,0],["وذُنوبٌ جَلَّ فيها ال","خَطْبُ إِذْ عزَّ العَزاءُ",25,"ا",2,0],["وذنبي واجترأي وزوري وافترأي","وميلي في سلوكي عن طرق القويمه",26,"م",2,0],["وذنبي رماني باسهمه","بقلبي فامرضه وكلم",27,"م",1,0],["وذَنْبُ الدهرِ جَلَّ فإن أراني","محيَّاهُ الجميلَ قبلتُ عُذْرَهْ",28,"ر",2,0],["وذَنبي عظيمٌ غير أنِّي تائبٌ","ومن تابَ إخلاصاً فقد بَذَلَ الوُسعا",29,"ع",2,0],["وذنبهم كذنوب المعرّي","فضائلُ لا تقبل الاستِتار",30,"ر",1,0],["وذنابى على الرووس تعالت","واستطالت عزاً وجها وقدرا",31,"ر",2,0],["وذنوبي وأن تعاظمن حتى","ملأ الكون كله أو ناها",32,"ا",3,0],["وذنبي أني راسخٌ في مكانتي","وأن قوافي الغوالي خوالدُ",33,"د",1,0],["وذنوبي وان عظمن فاني","بك يا ابن الكرام لا أخشاها",34,"ا",3,0],["وذنبها ان كان مما يغتفر","يغض عن عقابها به النظر",35,"ر",1,0],["وذنبي وإن حقّت عليّ جحيمُه","فَعَفْوُكَ ظِلٌّ لِلْمُؤَمِّل وارفُ",36,"ف",1,0],["وذُنوبٍ عاذتْ بعَفْوكَ فتناسيتَها","تَناسي النّوالِ",37,"ل",1,0],["وذنوبي في ارتفاع","وعيوبي في انتصاب",38,"ب",1,0],["وذنوبي أثقلتني","وهى عنوان الهلاك",39,"ك",1,0],["وذنبي فاغفر يا غفور وعافني","من الشرِّ والبلوى مدى الليل والفجر",40,"ر",1,0],["وذنب زماني أهله غير أنني","أراك له عذراً محا شطر ذنبه",41,"ه",1,0],["وَذَنَّ في ذُنينَةٍ أنفُ الحَيا","وَدَرَّ دُرَّ القَطرِ فِيها وَذَرا",42,"ا",1,0],["وَذَنبُ السرحانِ يَسمُوا صاعِداً","وَمَعطِسُ السرحانِ يَشتَمُّ البَرَى",42,"ا",1,0],["وذنبَكَ لا تنساه فالعمرُ قد مضى","فشمِّرْ فما دهر الشبيبة راجعُ",43,"ع",1,0],["وذنبها ايه تدوق جرحك","وعامل يعني مش عارف",44,"ف",1,0],["وذنب إلى كبد أضرابها","برج الغرام ولوعة الهجر",45,"ر",1,0],["وذنبي يا محصى بعفوك أحصه","وأحصى العدا هلكا تدارك أحصاه",46,"ا",2,0],["وذنبي أنّني أهوى بصدقٍ","غراماً لا أملُّ هنا اقْترافهْ",47,"ف",2,0],["وذنبُكَ تعلو والرّقابُ قصيرة ٌ","كسَرْتَ رقابَ الناس ِ كونَكَ عاليا",48,"ي",2,0],["وذنوبي بلعنة تقتفيني","ليس إلايَ متْعبٌ في البرايا",49,"ا",3,0],["وذنبي غدى في داخل القلب موضوع","اثمٍ تشوفه بين رمشك وعينك",50,"ك",1,0],["وذنب الروح انك فيها تسري","فيانوق الهيام برحلي فاسري",51,"ر",2,0],["وذنوبي وعيوبي لم تزل","في ازدياد واضطراب واضطرام",52,"م",1,0],["وذنبي أيا مولاى َ أضعافُ ذنبهِ","وبحركَ للراجين َ عذبُ المواردِ",53,"د",1,0],["وذنبي لأني أناجي حبيبا","أراد ٱكتئابي فكنت مطيعا",54,"ع",2,0],["وذنبي أن من أهواه صلدُ","فلا يشتاق أو يهوى لقائي",55,"ا",3,0],["وذنبي أنَّني قُويضْتُ مَجداً","معَ الإنسان ِفي سير ِالحُقوب",56,"ب",1,0]]}