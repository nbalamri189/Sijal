tml","الطويل"],[75,"أحين ولت أنجم الأفق","https://www.aldiwan.net/poem69057.html","السريع"],[48,"إذا غاديتني بصبوح عذل","https://www.aldiwan.net/poem10789.html","الوافر"],[48,"أجارة بيتينا أبوك غيور","https://www.aldiwan.net/poem63375.html","الطويل"],[48,"إذا ما كنت عند قيان موسى","https://www.aldiwan.net/poem63385.html","الوافر"],[50,"أفنيت عمري وتقضى الشباب","https://www.aldiwan.net/poem64823.html","السريع"],[7,"إذا غضبت لم يشعر الحي أنها","https://www.aldiwan.net/poem1946.html","الطويل"],[46,"إذا غيبوني لم أبال متى هفا","https://www.aldiwan.net/poem22187.html","الطويل"],[46,"إذا غدوت عن الأوطان مرتحلا","https://www.aldiwan.net/poem22465.html","البسيط"],[46,"لا أسأل المرء قرضا من شهادته","https://www.aldiwan.net/poem22890.html","البسيط"],[46,"الفتى قد رأى اليقين ولكن","https://www.aldiwan.net/poem23262.html","الخفيف"],[46,"نقمت الرضى حتى على ضاحك المزن","https://www.aldiwan.net/poem23626.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85287","المتقارب"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125533","الوافر"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140905",""],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72240","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16707","المنسرح"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202544","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42602","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42728","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42599","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67320","الطويل"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/13662","الطويل"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199474","المتقارب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43741","الطويل"],[11,"","https://poetry.dctabudhabi.ae/diwan/poem/10386","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54262","الطويل"],[43,"لقد حازني وجد بمن حازه بعد","https://www.poetsgate.com/ViewPoem.aspx?id=181",""],[91,"مستشفى تل شيحا","https://www.poetsgate.com/ViewPoem.aspx?id=53339",""],[28,"تظل بعينيها إلى الجبل الذي","https://www.poetsgate.com/ViewPoem.aspx?id=22098",""],[51,"يا أيها المرء الكريم والدا","https://www.poetsgate.com/ViewPoem.aspx?id=27704",""],[39,"طَالَ في رَسْمِ مَهْدَدٍ رَبَدُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=4253",""],[85,"أحقُّ أنهم دفنوا عليَّا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9637&r=&rc=127",""]],"verses":[["إِذا غَبَّروا في الجَوِّ ضاقَ فَضاؤُهُ","وَإِن نَزَلوا البَيداءَ عُمَّت رِعانُها",0,"ن",3,0],["إِذا غَدا الأُفُقُ الغَربِيُّ مُختَمِراً","مِنَ الغُبارِ فَظُنّوا بي وَظُنّوني",1,"ي",1,0],["إِذا غَضِبوا جاشَت رُبى الأَرضِ مِنهُمُ","بِبيضٍ وَبيضٍ كَالنُجومِ وَلامِ",2,"م",1,0],["إِذا غَفِلَ الحادونَ ثارَ مُساوِراً","وَإِن روجِعَ النَجوى أَرَمَّ وَأَطرَقا",3,"ق",2,0],["إِذا غَضِبوا لِلأَمرِ كانَ وَعيدُهُم","حَبيقَ الأَلايا وَاِرتِعادَ الرَوانِفِ",4,"ف",1,0],["إِذا غَرَّدَ الرَكبُ الخَفيُّ تَأَوَّهوا","لِما وَجَدوا بَعدَ النَوى وَتَوَجَّعوا",5,"ع",3,0],["إِذا غَدَرَت نَفسُ الجَبانِ بِصَبرِهِ","حَمَتنا ذُروعٌ طَلقَةٌ وَدُروعُ",6,"ع",1,0],["إِذا غابَ يَومٌ أَطلَعَ العِزُّ وَجهَهُ","وَلِلبَدرِ فينا مَغرِبٌ وَطُلوعُ",6,"ع",1,0],["إِذا غاضَ مارُ النَدى أَسلَبَت","يَداهُ بِمارٍ مِنَ الجودِ جارِ",7,"ر",1,0],["إِذا غِضنا الدَموعَ أَبَت عَلينا","مَناقِبُ مِنكَ لَيسَ لَهُنَّ نِدُّ",8,"د",1,0],["إِذا غَلَّ أَيدي الرِجالِ النِعاسُ","شَدَّ عَلى العَضبِ باعاً أَشَدّا",9,"د",2,0],["إِذا غَارَ عَزْمي في البِلادِ وَأَنْجَدا","فَإِنَّ قُصَارَى السَّعْي أَنْ أَبْلُغَ المَدَى",10,"د",2,1],["إِذا غَدَرَ السِّنانُ وَفَى بِضَرْبٍ","هَزَزْتُ لَهُ شَباهُ فَلَمْ يَخُنِّي",11,"ي",1,0],["إذا غَرَّدَ الحادي تَخايَلْنَ في البُرى","ونَحْنُ على أكْوارِها نَتَرنَّمُ",12,"م",1,0],["إِذا غَلَبَ الصَبرَ البُكاءُ وَهُيِّجَت","تَباريحَهُ فَالصَبُّ بِالذِكرِ يُعذَرُ",13,"ر",1,0],["إِذا غَلَبَتهُ الكَأسُ لا مُتَعَبِّسٌ","حَصورٌ وَلا مِن دونِها يَتَبَسَّلُ",14,"ل",1,0],["إِذا غاضَتِ الأَمواهُ مِن كُلِّ مُزبِدٍ","وَخَرَّت بُروجُ الرَجمِ لِلحَدَثانِ",15,"ن",1,0],["إِذا غَشِيَ الحَربَ العَوانَ تَمَخَّضَت","وَقَد لَقَحَت عَن فتكَةٍ في العدى بِكرِ",16,"ر",1,0],["إِذا غَزَونا فَمَغزانا بِأَنقِرَةٍ","وَأَهلُ سَلمى بِسَيفِ البَحرِ مِن جُرُتِ",17,"ت",1,1],["إِذا غابَ عَنهُنَّ الغَيورانِ تارَةً","وَعَنّا وَأَيّامُ النُحوسِ الأَشائِمِ",18,"م",1,0],["إِذا غابَ عنَهُنَّ الغيَورُ وَأشَرَقَت","لَنا الأَرضُ في اليَومِ القَصيرِ المبُارَكِ",19,"ك",1,0],["إِذا غَرِقَ الرَواتِكُ في الهَوافي","أُرنُّ عَلى جَوانِبِها بِهيدِ",20,"د",1,0],["إِذا غَيَّرَ النَأيُ المُحِبّينَ لَم يَكَد","رَسيسُ الهَوى مِن حُبِّ مَيَّةَ يَبرَحُ",21,"ح",1,0],["إِذا غَرَّقَت أَرباضُها ثِنيَ بَكرَةٍ","بِتَيهاءَ لَم تُصبِح رَؤُوما سَلوبُها",22,"ب",3,0],["إِذا غَضِبَت عَلَيكَ بَنو تَميمٍ","حَسِبتَ الناسَ كُلُّهُمُ غِضابا",23,"ب",2,0],["إِذا غارَ النَدى لِخِواءِ نَجمٍ","فَسَيبُ بَني رِفاعَةَ لا يَغورُ",24,"ر",1,0],["إِذا غَدَرَت رَبيعَةُ وَاِستَقادوا","لِطاغِيَةٍ دَعا بَشَراً طَغاما",25,"م",2,0],["إِذا غَرَبَت شَمسُ النَهارِ وَرَدتُه","كَما يَرِدُ الظَمآنُ آبِيَةَ الخِمسِ",26,"س",1,0],["إِذَا غَضِبَت سُيُوفُ بَني نِزَارٍ","عَلَى حيٍّ رَجَعنَ وَقَد رَضِينَا",27,"ن",2,0],["إِذا غَيَّرَ البُعدُ الهَوى فَهَوى أَبي","حُصَينٍ مَنيعٌ في الفُؤادِ حَصينُ",28,"ن",1,0],["إِذا غارَ مِنها كَوكَبٌ بَعدَ كَوكَبِ","تُراقِبُ عَيني آخِرَ اللَيلِ كَوكَبا",29,"ب",2,0],["إِذا غابَ مِنها كَوكَبٌ لاحَ بَعدَهُ","شِهابٌ مَتى ما يَبدُ لِلأَرضِ تُشرِقِ",30,"ق",1,0],["إذا غاب ملكٌ لم يغب غيرُ شخصه","وقامَ ابنهُ من بعده وحفيدُه",31,"د",2,0],["إذا غير الدهر حسن الذوات","فحاشا محاسن ذات العماد",32,"د",1,0],["إذا غبتَ عنه خافَ في عينهِ العمى","وحسبك أن العين لا تبصر النورا",33,"ر",2,0],["إذا غرَّدت ورق الحمائم في الضحى","على فننٍ هاجت عليه البلابل",34,"ل",1,0],["إذا غَلتِ الآمالُ فارْضَ بجودِهِ","فما بعدَه مَعْدى لِسَهْمِ غَلائِها",35,"ا",3,0],["إذا غمر المالُ البخيلَ وجَدْتَهُ","يَزيدُ به يُبساً وإن ظُنَّ يَرْطُبُ",36,"ب",1,1],["إذا غدا وهو على آلةٍ","من منطقي ذاتِ قَرا أحدبِ",37,"ب",1,0],["إذا غازَلته بالصريم نِعَاجُه","كما غازلتْ زِيراً أوانسُ خُرَّدُ",38,"د",1,0],["إذا غبنتني طرفتي منه نظرتي","تمنَّيتُ عيناً جفنها غير طارف",39,"ف",1,0],["إذا غنتكَ ذُقْت العي","شَ من نَغماتها الصَّحلَهْ",40,"ل",2,0],["إذا غدتْ في الشارقِ المُغيمِ","ألوت عن المهمومِ بالهمومِ",41,"م",1,0],["إِذا غَرَّقَ الآلُ الإِكامَ عَلَونَهُ","بِمُنتَعِتاتٍ لا بِغالٌ وَلا حُمرُ",42,"ر",1,0],["إِذا غَشِياني هيلَتِ النَفسُ مِنهُما","قُشَعريرَةً وَاِزدَدتُ خَوفَ جَنانِ",43,"ن",1,0],["إِذا غابَ عَنّا غابَ عَنّا فُراتُنا","وَإِن شَهدَ أَجدى فَيضُهُ وَجَداوِلُه",44,"ل",2,0],["إِذا غَشيَ حِسياً ما لِحِساءِ دَرَت لَهُ","صَوادِرُ يَتلونَ القَطا وَقَوارِبُ",45,"ب",1,0],["إِذا غابَ عَنها البَعلُ لَم تُفشِ سِرَّهُ","وَتُرضي إِيابَ البَعلِ حينَ يَؤوبُ",46,"ب",1,0],["إِذا غابَ الذَليلُ النَفسِ عَنّي","نَظَرتُ إِلى الَّذي حَمَلَ الوِساما",47,"م",2,0],["إِذا غَضِبوا عَلى الدُنيا غَضِبنا","وَإِن يَرضوا عَلى الدُنيا رَضينا",48,"ن",2,0],["إِذا غابَ عَنّي لَم أَزَل مُتَلَفِّتاً","أَدورُ بِعَيني نَحوَ كُلِّ طَريقِ",49,"ق",1,0],["إِذا غُزُرُ المَحالِبِ أَتأَقَتهُ","يَمُجُّ عَلى مَناكِبِهِ الثُمالا",50,"ل",2,0],["إذا غبت عن أرض طلعت بغيرها","فأشرق آكام بها وسهول",51,"ل",1,0],["إذا غناهمو وجدوا سطيحا","على فمه وافعى الجرهميا",52,"ي",2,0],["إذا غَدَتْ خيلُهُمْ تَخْدي بهمْ خَبَباً","لنجدةٍ عَدَتِ الآجالَ في الخَذَمِ",53,"م",1,0],["إذا غفا عنك وأَوْدى بها","ذا الدَّهْرُ فَهْو المُحْسِنُ المُجْمِلُ",54,"ل",1,0],["إِذا غَزَتهُ أَعاديهِ بِمَسأَلَةٍ","فَقَد غَزَتهُ بِجَيشٍ غَيرِ مَغلوبِ",55,"ب",1,0],["إِذا غَدَرَت حَسناءُ وَفَّت بِعَهدِها","فَمِن عَهدِها أَن لا يَدومَ لَها عَهدُ",56,"د",1,0],["إِذا غامَرتَ في شَرَفٍ مَرومٍ","فَلا تَقنَع بِما دونَ النُجومِ",57,"م",1,1],["إِذا غَنّى الحَمامُ الوُرقُ فيها","أَجابَتهُ أَغانِيُّ القِيانِ",58,"ن",1,0],["إِذا غُلفَةُ الفَرّاشِ شَكَّت عِجانُه","بَكَينا لِذُلِّ الدينِ وَالكُفرُ راكِبُه",59,"ب",2,0],["إِذا غَمَراتُ المَوتِ أَدجَت تَكَشَّفَت","بِهِم عَن أُسودٍ زوحِفَت بِأُسودِ",60,"د",1,0],["إِذا غَنَّيتَنا يَومَ اِصطِباحٍ","فَقَد أَوسَعتَنا عَطَشاً وَجوعا",61,"ع",2,0],["إِذا غِبتَ عَن أَرضٍ وَيَمَّمتَ غَيرَها","فَقَد غابَ عَنها شَمسُها وَهِلالُها",62,"ل",3,0],["إِذا غَرَّدَ الطَيرُ فيها ثَنَت","إِلَيكَ الأَغانِيُّ أَلحانَها",63,"ن",3,0],["إِذا غَلَبَ اِبنٌ بِالشَبابِ أَباً لَهُ","كَبيراً فَإِنَّ اللَهَ لا بُدَّ غالِبُه",64,"ب",2,0],["إِذا غَضِبَت يَوماً عَرانينُ خِندِفٍ","وَإِخوَتُهُم قَيسٌ عَلَيها حَديدُها",65,"د",3,0],["إِذا غَطَفانُ راهَنَت يَومَ حَلبَةٍ","إِلى المَجدِ نادَوا مِنهُمُ كَلَّ سابِقِ",66,"ق",1,0],["إِذا غَلَبَ اللُؤمُ اِمرَأً أَن يُطيقَهُ","فَإِنَّ اِبنَ راعي الإِبلِ عَنهُ لَحامِلُه",67,"ل",2,0],["إذا غنَّتِ الطَيرُ فيها ضُحىً","حَسِبْتُ القِيانَ بها شَاديه",68,"ي",2,0],["إذا غدا المُستميحُ أعدَمَها","أَعادَه بالنَّوالِ أثْراها",69,"ا",3,0],["إذا غَدا خافِقَ البُنودِ غَدَتْ","جُنْدُ المَنايا لجُنْدِه خَدَما",70,"م",2,0],["إذا غَمَزَتْ آراؤُه البَغْيَ غَمْزَةً","تقوَّمَ فيها مَيْلُهُ وتحطَّما",71,"م",2,0],["إذا غاصَ في الماءِ النَّميرِ حَسِبْتَهُ","رؤوسَ إوَزٍّ في غِياضٍ تُغَوَّصُ",72,"ص",1,0],["إذا غَضِبْتَ فلا تَعجَلْ بسّيئَةٍ","فالعفوُ شأنكُمُ يا آلَ عَبَّاسِ",73,"س",1,1],["إذا غابَ عن ذي الرأي وجهُ رَشادِه","لجأتَ إلى رأيٍ يُريك المغيَّبا",74,"ب",2,0],["إِذا غَضِبتُم يَهابُ الخَلقُ سَطوَتَكُم","وَقَد يَهونُ عَلَيكُم مِنهُمُ الغَضَبُ",75,"ب",1,0],["إِذا غَضِبَ الحَليمُ فَفِرَّ عَنهُ","وَإِن غَضِبَ اللَئيمُ فَلا تُبالِه",76,"ل",2,0],["إِذا غابَ أَصلُ المَرءِ فَاِستَقَرَّ فِعلَهُ","فَإِنَّ دَليلَ الفَرعِ يُنبي عَنِ الأَصلِ",77,"ل",1,1],["إِذا غَدا الغُصنُ غَضّاً في مَنابِتِهِ","مَن شاءَ فَليَجنِ مِن أَفنانِهِ الثَمَرا",78,"ر",2,0],["إذا غرَستْ في مسمعِ الصّبِّ موْعِداً","جَنى بِيَدِ التسويفِ مِن غَرْسِها مَطْلا",79,"ل",2,0],["إذا غضِبوا للَّه أرضاكَ فَتكهُمْ","وأَفتكُ ما تلقى الأُسودُ غِضابا",80,"ب",2,0],["إِذا غاظَ وَصفُ الناسِ بِالحُسنِ أَهلَهُ","فَلِمَ لَم يُخَرِّق ثَوبَهُ يوسُفُ الحُسنِ",81,"ن",1,0],["إِذا غازَلَ الرَوضُ الغَزالَةَ نُشِّرَت","زَرابِيُّ في أَكنافِهِم وَدَرانِكُ",82,"ك",1,0],["إِذَا غَضِبُوا رَدُّوا الأُمُورَ لأَصْلِهَا","كَمَا بَدَأَتْ وَاسْتَفْتَحُوا الأَرْضَ بِالْغَزْوِ",83,"و",1,0],["إِذا غُمِزَت أَصلابُهُنَّ تَرَنَّمَت","مُعَطَّفَةٌ لَيسَت بِهِنَّ كُسورُ",84,"ر",1,0],["إذا غردت ماج بها رفيف","وصفق حولك ال