"وَلا بُدَّ مِن أَمَلٍ لِلفَتى","وَأُمُّ المُنى أَبَداً حامِلُ",2,"ل",1,0],["وَلا بُدَّ لي أَن أَغسِلَ العارَ بَعدَهُ","وَيا رُبَّ عارٍ دامَ غَيرَ غَسيلِ",3,"ل",1,0],["وَلِاِبنُ لَيلى عارِضاً رُمحَهُ","يَحدو بِخَفّانَ جِمالاً وَنوق",4,"ق",1,0],["وَلا بُدَّ مِن يَومٍ حَميدٍ كَأَنَّهُ","مِنَ النَقعِ في أَثناءِ بُردٍ شَبارِقِ",5,"ق",1,0],["وَلا بَرِحَت تِلكَ الرُباعُ مَجودَةً","عَلى كُلِّ حالٍ مِن مَصيفٍ وَمَربَعِ",6,"ع",1,0],["وَلا بُدَّ مِن شَعواءَ تَظما نُفوسُها","وَلَيسَ لَها إِلّا السُيوفُ مَشارِعُ",7,"ع",1,0],["وَلا بَعُدَ المَأمولُ مِن أَن تَنالَهُ","فَإِن فاتَ في ذا اليَومِ أَدرَكتَهُ غَدا",8,"د",2,0],["وَلا بَرِحَت تُندي عُقودَ صَعيدِها","نُفاثَةُ ما جادَ الغَمامُ النَوافِثُ",9,"ث",1,0],["وَلابُدَّ يَوماً أَن يَجيءَ فُجاءَةً","فَلا تَنظُراني عِندَ وَقتٍ مُوَقَّتِ",10,"ت",1,0],["وَلا بُدَّ أَن يُعطي عَلى البُعدِ دَولَةً","فَنَأمَنَ بَيناً أَو رَقيباً نُراقِبُه",11,"ب",2,0],["وَلا بَل سَقَيناكَ الدُموعَ وَإِنَّنا","لَنَأنَفُ إِن قُلنا سَقَتكَ السَحائِبُ",12,"ب",1,0],["وَلا بُدَّ لي مِنْ وَثْبَةٍ أُمَوِيَّةٍ","بِحيْثُ العجاجُ اللَّيْلُ وَالسَّيْفُ فَجْرُهُ",13,"ر",2,0],["وَلا بُدَّ مِنْ وَقْعَةٍ تَرْتَمي","بِأَيْدٍ تَطيحُ وَهامٍ تَطيرُ",14,"ر",1,0],["ولابُدَّ مِنْ زَفْرَةٍ تَستَطي","رُ مِنْ أرحُلِ الرّازِحاتِ العُهونا",15,"ن",2,0],["ولا بَرِحَ الحُسّادُ يَكْسو وليدَهُمْ","لَواعِجُ منْ هَمٍّ غَدائِرَ أشْيَبِ",16,"ب",1,0],["ولابدّ منْ يَومٍ أغَرَّ مُحَجَّلٍ","يُبَوّئُنا ظِلَّ الطِّرافِ المُمَدَّدِ",17,"د",1,0],["ولا بَرِحَتْ فيكَ الأمانِيُّ غَضَّةً","تَرِفُّ على إنعامِكَ المُتَقَسِّمِ",18,"م",1,0],["وَلابَأَسَ أَن يَلقى المُحِبُّ حَبيبَهُ","فَيَشكو إِلَيهِ بَثَّهُ وَهُوَ مُحرِمُ",19,"م",1,0],["وَلا بُدَّ مِن كَذِبٍ في الهَوى","إِذا كانَ دَفعُ الأَذى بِالكَذِب",20,"ب",1,0],["وَلاَ بَرِحَتْ آثَارُكَ الْغُرُّ تَكْتَسِي","بَدَائِعَ مِمَّا صَاغَ فِي وَصْفِهَا نَظْمِي",21,"م",2,0],["وَلاَ بَرِحَتْ تَهْفُو لِمَعْهَدِكَ الصَّبَا","وَيَسْحَبُ فِيهِ الْمُزْنُ فَضْلَ سَحَابِ",22,"ب",1,0],["وَلاَ بَرِحَتْ أَيَّامُهُ وَزَمَانُهُ","مَآثِرُهَا تُحْيَ بِهَا دَوْلَةُ الْعُرْبِ",23,"ب",1,0],["وَلا بَسبَسٍ كالعَنزِ أَطوَلُ رِسلِها","وَرِئمانِها يومانِ ثُمَّ يَزولُ",24,"ل",1,0],["وَلا بَراءَةَ لِلبَرِي","ءِ وَلا عِطاءَ وَلا خُفارَه",25,"ر",2,0],["وَلا بُدَّ مِن غَزوَةٍ في المَصي","فِ حَتٍّ تُكِلُّ الوَقاحَ الشَكورا",26,"ر",2,0],["وَلا بُدَّ مِن جارٍ يُجيزُ سَبيلَها","كَما جَوَّزَ السَكِّيَّ في البابِ فَيتَقُ",27,"ق",1,0],["وَلا بِتنا نُعاجِزُكُم بِعِلمٍ","يَبينُ بِهِ الغَوِيُّ مِنَ الرَشيدِ",28,"د",1,0],["وَلا بِذاتِ جَمالٍ","يَسري بِها في النُفوسِ",29,"س",1,0],["وَلِاِبنِ باقا وَعظٌ يَغُرُّ بِهِ النا","سَ وَعَبدُ اللَطيفِ مُحتَسِبُ",30,"ب",1,0],["وَلِاِبنِ نَجلِ الدَجاجِ طولُ يَدٍ","تَجمَعُ بَينَ الفُراتِ وَالضَبِّ",31,"ب",1,0],["وَلا بُدَّ أَن أَسعى لِأَفضَلِ رُتبَةٍ","وَأَحمِيَ عَن عَيني لَذيذَ مَنامي",32,"م",2,1],["وَلا بُدَّ أَن أَلقى الرَدى مِن مُصَمِّمٍ","فَكَم يَتَوَقّى مَن تَخَطّى الأَفاعِيا",33,"ي",2,0],["وَلا بَأسَ إِن كانَ وَلّى الرَبيعُ","إِذا لَم تَجِد فَقدَهُ الأَنفُسُ",34,"س",1,0],["وَلا بَسطِ كَفٍّ لِاِمرِئٍ غَيرِ مُجرِمٍ","وَلا السَفكِ مِنهُ ظالِماً مِلءَ مِحجَمِ",35,"م",1,0],["وَلا بَلَغَ المُهدونَ في القَولِ مِدحَةً","وَلا صَدَقوا إِلّا الَّذي فيكَ أَفضَلُ",36,"ل",1,0],["وَلا بِسَعّالٍ إِذا يُجتَدى","وَضاقَ بِالمَعروفِ صَدرُ السَعول",37,"ل",1,0],["وَلاَ بِدْعَ فَالياسُ مِنْ دُوْحَةٍ","يَغْنَى بِأَنْسَابِهَا وَالحَسَبْ",38,"ب",1,0],["وَلا بَرِحَتْ شُورَاهُ أَنْقَى صَحِيفَةٍ","يبُثُّ الهُدَى فِيهَا عَلَى النَّشْرِ والطيِّ",39,"ي",1,0],["وَلا بُرءَ مِن مَيٍّ وَقَد حيلَ دونَها","فَما أَنتَ فيما بَينَ هاتَينِ صانِعٌ",40,"ع",1,0],["ولابدّ أن تجتثّ يوماً جذورها","وتقلعها إحدى الرياح الهواجم",41,"م",1,0],["وَلِاِبنِ البارِقِيَّ قُدِرتُ حَتفاً","وَأَقصَدتُ البَعيثَ بِسَهمِ رامي",42,"م",2,0],["وَلا بَلَغَ الأَعداءُ أَن يَتَناهَضوا","وَتَقعُدَ عَن هَذا العَلاءِ المُشَيَّدِ",43,"د",1,0],["وَلا بَرَقَت لي في اللِقاءِ قَواطِعٌ","وَلا لَمَعَت لي في الحُروبِ حِرابُ",44,"ب",1,0],["ولا برحت خدام وصفك ما على","محاسنها للواصفين حجاب",45,"ب",1,0],["ولا بسطوا يمنى ببذلِ رغيبةٍ","ولا أوجدوا من بعد جائحه يسرا",46,"ر",2,0],["ولابن يحيى الذي تغنَّى المحول به","بروق بشرٍ وَراهَا القطرُ مقطور",47,"ر",1,0],["ولا بدَّ من شكوى إلى ذي مروءةٍ","يواسيك أو يسليك أو يتوجَّع",48,"ع",1,0],["ولا برح العافي بذلك أو شذا","مديحك ما بين الورى يتمسك",49,"ك",1,0],["ولا بأسود عينٍ ربَّما ربحت","بلمحةِ الرّدف قنطاراً بمثقال",50,"ل",1,0],["ولا برحت أوقاتنا ببقائهِ","مواصلة أبكارها والأصائل",51,"ل",1,0],["ولا برحنا وإن شطّ المزار بنا","من هالة البدر معنًى في ابن منهال",52,"ل",1,0],["ولا بحار الطوفان طائفة","كالبحر في صدره وأكمامه",53,"م",2,0],["ولا بد من أن يَلؤُم المرءُ نازعاً","إلى الحَمَأ المسنونِ ضربة لازبِ",54,"ب",1,0],["ولا بد لي من رتبةٍ تُرغمُ العدا","وتسهيل إذنٍ بين أهل ومَرْحبِ",55,"ب",1,0],["ولا بَرَحَتْ تَقَدُّ الليلَ قدَّاً","بأعناقٍ كعيدانِ الخصابِ",56,"ب",1,0],["ولابنِ بورانَ وجهُ عذرٍ","لأنه مُطرِبٌ مُصيبُ",57,"ب",1,0],["ولا برح القاعُ الذي أنت جارُهُ","يَرِفُّ عليه الأقحوان المُفلَّجُ",58,"ج",1,0],["ولا بِدْعَ أن دَوَّخْتَ بالحق باطلاً","فكم باطلٍ بالعدل منك مُدَوَّخِ",59,"خ",1,0],["ولا بدّ للصبح الجلِيّ إذا بدت","تباشيْره أن يسلخ الليل مسلخا",60,"خ",2,0],["وَلاَبِسُ سَيْفِ القِرْنِ عنْدَ اسْتِلابِهِ","أضَرُّ لَهُ مِنْ كَاسِرِيهِ وَأَكْيَدُ",61,"د",1,0],["وَلا بِعْتُهُ طَوْعاً ولكنْ غُصِبْته","وليس على ظُلْمِ الحوادِث من مُعْدِي",62,"ي",1,0],["ولا برحت بيضُ الأيادي عليكُمُ","ومنكمْ مدى بيض الزمان وسودِهِ",63,"د",2,0],["ولا بأس بالقول ما لم يكن","مع القول كائنَةٌ من يَدِ",64,"د",1,0],["ولا برحت من ذي الأيادي عليكُمُ","أيادٍ توالت في شبابٍ تُجدَّدُ",65,"د",1,0],["ولابأس أن يزداد طولك بسطةً","بأنِّي خطَّاء وأنك غافر",66,"ر",1,0],["ولا بالهِدان ولا بالددا","ن كلّا ولا بالجبان الهلع",67,"ع",1,0],["ولا بالقليل ولا بالذلي","ل كلّا ولا بالبخيل الجشع",67,"ع",1,0],["ولا بدَّ لتنُّورِ","كِ من بعض المحاريكِ",68,"ك",1,0],["ولا بِدْعَ منه بدؤه أريحيةٌ","تحطّ الولايا عن ظهور الرواحلِ",69,"ل",1,0],["ولا بِدْعَ أن ضمّ الوزيرُ كُفاتَه","إليه وألغى اللغو والرَّذْلُ يُرذلُ",70,"ل",1,0],["ولا بِمَتروكٍ ولا مُسالمِ","ولا بِمُستحيىً ولا مُكارِمِ",71,"م",1,0],["ولا بدَّ مِن صِدْقيكَ والصِّدقُ واجبٌ","لكل صديقٍ يَسْتصِحُّ البطائنا",72,"ن",2,0],["ولا بدَّ للمرءِ من محنةٍ","لفتنةِ نَعمائِه نافيه",73,"ف",3,0],["ولا بدَّ للريح من أن تكو","ن في بعضِ هَبَّاتها سافيه",73,"ف",3,0],["وَلا بَرَحَ الأَحرارُ يَشدو بِذِكرِهِم","بَنو الشَرقِ فَخراً في القُرى وَالعَواصِمِ",74,"م",1,0],["وَلا بَصَري عِندَ الهِياجِ بِطامِحٍ","كَأَنّي بَعيرٌ فارَقَ الشَولَ نازِعُ",75,"ع",1,0],["ولا بُدَّ للَّيْلِ أنْ ينجلي","ولا بُدَّ للقيدِ أن يَنْكَسِرْ",76,"ر",1,0],["وَلا بِفيها وَلا هَمَمتُ بِهِ","ما كانَ إِلّا الحَديثُ وَالنَظَرُ",77,"ر",1,0],["وَلا بِبُراقٍ قَد تَيَمَّمتَ فَاِعتَرِف","لِما أَنتَ لاقٍ أَو تَنَكَّب عَنِ الرَكبِ",78,"ب",1,0],["ولا بد من حرب على من تعصبوا","علي فاردى او يفيئ لي النصر",79,"ر",1,0],["ولا برحت معطَّرةٌ","من الصلواتِ تلزمه",80,"م",2,0],["ولا بمن فرقهم","حادث سيل العرم",81,"م",1,0],["ولا بحكم عمر","في لطمة ابن الأيهم",81,"م",1,0],["ولا بقتلة الإمام","من يد ابن ملجم",81,"م",1,0],["وَلا بُدَّ لَكَ اليَومَ","وَإِلّا فَغَداً مِنّي",82,"ي",1,0],["وَلا بِالنَسلِ وَالمالِ","وَلا بِالكَدحِ وَالكَدِّ",83,"د",1,0],["وَلا بُدَّ لِلغَرسِ مِن نَقلِهِ","إِلى مَن تَعَهَّدَ أَو مَن قَطَف",84,"ف",1,0],["وَلا بِتُّ إِلّا كَاِبنِ مَريَمَ مُشفِقاً","عَلى حُسَّدي مُستَغفِراً لِعِداتي",85,"ي",1,0],["وَلا بُدَّ لِلقَلبِ مِن آلَةٍ","وَرَأيٍ يُصَدِّعُ صُمَّ الصَفا",86,"ا",1,0],["وَلا بُدَّ مِن يَومٍ أَغَرَّ مُحَجَّلٍ","يَطولُ اِستِماعي بَعدَهُ لِلنَوادِبِ",87,"ب",1,0],["وَلا بَرَزنَ مِنَ الحَمّامِ ماثِلَةً","أَوراكُهُنَّ صَقيلاتِ العَراقيبِ",88,"ب",1,0],["ولا بد من حلّ وعقد كلاهما","وكل الذي ترجوه في الحلّ والعقدِ",89,"د",1,0],["ولا بُرقِعَتْ بالقَسْطلِ الجَون غُرَّةٌ","ولا غُيِّبتْ بين الدِماء حُجولُ",90,"ل",1,0],["ولابسٌ للنورِ ذو نُمرةٍ","والحسنُ كلُ الحُسْنِ للأَنْمرِ",91,"ر",1,0],["وَلا بُدَّ مِن لَومَةٍ أَنتَحي","عَلَيكَ بِها مُخطِئاً أَو مُصيبا",92,"ب",2,0],["وَلا بُدَّ مِن واشٍ يُتاحُ عَلى النَوى","وَقَد تَجلُبُ الشَيءَ البَعيدَ جَوالِبُه",93,"ب",2,0],["وَلاِبنِ داوُدَ مَطلٌ أَنتَ تَعرِفُهُ","إِن لَم تَرُضهُ وَتَحلُل مِن تَعَقُّدِهِ",94,"د",2,0],["وَلابِسٍ ظِلَّ مالٍ لِلنَدى أَبَداً","فيهِ وَقائِعُ طَيٍّ في بَني أَسَدِ",95,"د",1,0],["وَلا بُدَّ مِن تَركِ إِحدى اِثنَتَي","نِ إِمّا الشَبابِ وَإِمّا العُمُر",96,"ر",1,0],["وَلا بُدَّ أَن يُهراقَ دَمعٌ فَإِنَّما","يُرَجّى اِرتِقاءُ الدَمعِ بَعدَ التَحَدُّرِ",97,"ر",1,0],["وَلَأَبكَيتَ طَرفَةً وَزُهَيراً","وَلَبيداً وَقَرمِ آلِ نَهيكِ",98,"ك",1,0],["وَلا بِمُؤَخَّرٍ يُدعى أَخيراً","إِذا نُدِبَ الرِجالُ إِلى المَعالي",99,"ي",1,0],["وَلا بِالهُجومِ عَلى الفاحِشاتِ","يُمِرُّ عَلى السَيفِ سُؤآلَهُ",100,"ل",2,0],["ولابِسةٍ في كأسِها ثوبَ آمنٍ","جلاها علينا الماءُ في ثَوبِ خائفِ",101,"ف",1,0],["ولا برقُ لذَّاتِنا خُلَّبٌ","إذا ما دعَونا لوصلٍ قُلوبا",102,"ب",2,0],["ولا بدَّ أن أشكو إليك ظُلامةً","وغارةَ مِغوارٍ سجيَّتُه الغَضْبُ",103,"ب",1,0],["وَلا بُدَّ مِن سائِلٍ قائِلٍ","مِنَ الناسِ يَومَئِذٍ ما لَها",104,"ل",3,0],["وَلَأَبكِيَنَّ مِنَ البِلى","وَلَأَبكِيَنَّ مِنَ الخِضاب",105,"ب",1,0],["وَلَأَبقَت فَتى المُهَذَّبِ أَيدٍ","طَوَّقَت بِالنَدى رِقابَ العِبادِ",106,"د",1,0],["ولا بُدّ من حملي على النفس خُطّةً","تُعلّقُ وردي في اغترابي بمصدري",107,"ر",2,0],["وَلا بُدَّ مِن أمنيَّةٍ تَخدَعُ الهوى","لِتُدْرَكَ منها بالتعلّلِ آمالُ",108,"ل",1,0],["وَلابِسةٍ ظِلَّيْ دُجاها وَأَيْكِها","وللسجع منها في القلائد أَعمالُ",108,"ل",1,0],["ولابسٍ نُقَبَ الأعْراض جوهره","لهُ انسيابُ حُبابٍ رَقْشُهُ الحَبَبُ",109,"ب",1,1],["وَلا بُدَّ مِن فَروٍ إِذا اِجتابَهُ اِمرُؤٌ","كَفى وَهوَ سامٍ في الصَنابِرِ أَغلَبُ",110,"ب",1,0],["ولا بدْعَ مِنْ مصرٍ جمالٌ ورفعةٌ","فقيلَ حوى الوصفينِ في مصرَ يوسفُ",111,"ف",1,0],["ولا بيضُ الثغورِ إليه أشهى","وإنْ عذبتْ من البيضِ الصفاحِ",112,"ح",1,0],["ولا بغصنٍ رطيبٍ","فالحبُّ ألوى وألونْ",113,"ن",1,0],["ولا ببكرٍ رؤودٍ","فذاكَ أسمى وأسمنْ",113,"ن",1,0],["ولا بأفئدةٍ حتى تُعاهدَنا","بأنَّ أنياطها ليست ثعابينا",114,"ن",2,0],["وَلا بِتُّ مَعشوقاً تَطيرُ بِأَضلُعي","قَطاةٌ لَها بَينَ الجَوانِحِ مَفحَصُ",115,"ص",1,0],["وَلا بَأسَ إِلّا مِن سُيوفِكَ تُنتَضى","وَلا سَعدَ إِلّا في رِماحِكَ تُشرَعُ",116,"ع",1,0],["وَلا بِضتَ في خَضراءَ ما عِشتَ بَيضَةً","وَضاقَت بِرَحبَيها عَلَيكَ المَسالِكُ",117,"ك",1,0],["وَلا بَرحَ البَيتُ الَّذي أَنتَ شائِدٌ","مِن المَجدِ فينا وَهوَ بَيتٌ مُحرَّمُ",118,"م",1,0],["وَلا بِلُجِّ البِحارِ مِن كَرَمٍ","إِلّا جِوارٌ بِدارِهِ اِتَصَلا",119,"ل",2,0],["وَلِإِبراهيمَ الموَّفي بِنَذرٍ","اِحتِساباً وَحامِلَ الأَجزالِ",120,"ل",1,0],["وَلا بِالشُلَيلِ رَبِّ مَروانَ قاعِداً","بِأَحسَنِ عَيشٍ وَالنُفاثِيِّ نَوفَلِ",121,"ل",1,0],["وَلا بَنى بانٍ مِنَ الخَلائِفِ","وَلا مُلوكِ الرومِ وَالطَوائِفِ",122,"ف",1,0],["وَلا بُدَّ مِن حَتفٍ يُلاقيكَ يَومُهُ","فَلا تَجزَعَن مِن ميتَةٍ هِيَ ما هِيا",123,"ي",2,0],["وَلا بُدَّ أَن يُصغي إِلى البُؤسِ جانِبُ ال","نَعيمِ وَيَقضي مَنعُهُ ثُمَّ لا يُقضى",124,"ض",2,0],["وَلا بَأسَ أَنكى مِن تَثَبُّطِ حازِمٍ","وَلا دِرعَ أَوقى لِلنُفوسِ مِنَ العُمرِ",125,"ر",1,0],["وَلا بُدَّ لي مِنهُ فَحيناً يَعَضُّني","وَيَنساغُ لي حيناً وَوَجهي مُقَطَّبُ",126,"ب",1,0],["وَلأَبْكِيَنَّ عَلَى زَمانٍ فاتَنِي","مِنْكُمْ بَعَيْنَيْ عُرْوةَ بنِ حِزامِ",127,"م",1,0],["ولا بارق من غير بشرك لامع","ولا عارض من غير كفّك هامل",128,"ل",1,0],["ولا بَسَطَتْ أيدي العُفاةِ بَنانَها","إلى أرْيَحيٍّ منه أنْدى وأكرَم",129,"م",1,0],["ولا بنَواصي الخيلِ غيرَ خضِيبَةٍ","ولا بحَديدِ الهِندِ غيرَ مُثَلَّم",129,"م",1,0],["ولا بدّ من تلكَ التي تجمعُ الوَرى","على لاحِبٍ يَهْدي إلى الحَقّ أقوَم",129,"م",1,0],["ولا بدّ أن يزنوا، فقالت: أو الفِدا","بأبْلَجَ كالدّينَارِ في طرفهِ فَتْرُ",130,"ر",1,0],["وَلا بِمُدافِعٍ بِالكَأسِ حَتّى","يُهَيِّجَني عَلى الطَرَبِ النَديمُ",131,"م",1,0],["وَلا بُدَّ مِن شَكوى إِلى ذي حَفيظَةٍ","إِذا جَعَلَت أَسرارُ نَفسي تَطَلَّعُ",132,"ع",1,0],["وَلا بِهِ راعٍ وَلا بَعيرُ","لِلريحِ فيهِ بِالمَها التَأطيرُ",133,"ر",1,0],["وَلا بَيتَ إِلّا بَيتُ مَجدِكَ فَوقَهُ","مُنيفاً يُراعي الفَرقَدَينِ مُشَيَّدا",134,"د",2,0],["وَلا بَأسَ إِلّا أَنَّنا عِندَ أَهلِها","شُهودٌ وَما أَلبابُنا بِشُهودِ",135,"د",1,0],["وَلا بُدَّ أَنّي راحِلٌ لِلِقائِهِ","فَقَد بَشَّرَت بِالنُجحِ عَينٌ تَخَلَّجُ",136,"ج",1,0],["وَلا بُدَّ يَوماً مِن غَدوٍّ مُبَغَّضٍ","سَنَغدوهُ أَو مِن رَوحَةٍ سَنَروحُها",137,"ح",3,0],["وَلا بُدَّ مِن خَطبٍ يُصيبُ فُؤادَهُ","بِسَهمٍ فَيُضحي الصائِدَ المُتَصَيِّدُ",138,"د",1,0],["وَلا بُدِّ في دُنياكَ مِن نَصَبٍ لَها","وَهَل وَضَعَ الأَثقالَ دَهرُكَ عَن شَفرِ",139,"ر",1,0],["وَلابِسُ المِغفَرِ الدَرعيِّ جاءَ بِهِ","كَالسيِّدِ أَدرَعَ في لَيلٍ لَهُ دُرَعُ",140,"ع",1,0],["وَلا بُدَّ مِن سَيرِها مَرَّةً","بَعدَ اِلتِفاتٍ إِلى مالِها",141,"ل",3,0],["وَلا بُدَّ لِلحادِثا","تِ مِن وَقعَةِ صَيلَمِ",142,"م",1,0],["ولا بمغْلوبٍ على الرزْ","قِ الذي قُدِّرَ لي",143,"ي",1,0],["ولا بمُعطىً رزقَ غَيْ","رِي بالشَّقا والعَمَلِ",143,"ل",1,0],["وَلأُبعدت عَن أمها","فمَضَت وَما ألفت مردا",144,"د",2,0],["ولابسةٍ من حِنْدسِ الليلِ ظُلمةً","مُفَرجَةً عن صدرها تشبهُ القبا",145,"ب",2,1],["ولا بُدّ للإنْسانِ مِن سُكْرِ ساعةٍ","تَهُونُ عليه غيرَها السّكَرات",146,"ت",1,0],["وَلا بُدَّ مِنْ يَوْمٍ تَلاعَبُ بِالْقَنَا","أُسُودُ الْوَغَى فيهِ وتَمْرَحُ جُرْدُهُ",147,"د",2,0],["وَلا بَرِحَتْ فِي الدَّهْرِ وَهْيَ خَوَالِدٌ","خُلُودَ الدَّرَارِي وَالأَوَابِدِ مِنْ شِعْرِي",148,"ر",2,0],["وَلا بَرِحْتِ مِنَ الأَوْرَاقِ فِي حُلَلٍ","مِنْ سُنْدُسٍ عَبْقَرِيِّ الْوَشْيِ بَرَّاقِ",149,"ق",1,0],["وَلا بَرِحَتْ تَمْتَارُ مِنْكِ يَدُ الصِّبَا","أَرِيجَاً يُدَاوِي عَرْفُهُ كُلَّ نَاشِقِ",150,"ق",1,0],["ولا بِدْعَ إِنْ غَابَتْ عَلَيْنَا رُمُوزُهَا","وَإِنْ فَاقَ مَا تَعْنِيهِ مَا نَتَصَوَّرُ",151,"ر",1,0],["ولابتسامتك الصفراء رجفتها","كالنجم خلف رقيق من ستائره",152,"ر",2,0],["وَلا بَرَزتُ لِزُوّاري مَخافَة أَن","أساءَ مِنهُم بِطَلقِ الوَجهِ بَسّامِ",153,"م",1,0],["وَلا بَصَرٌ يَرعاكَ إِلّا بَصيرَتي","وَلا جُنَنٌ تَحويكَ غَير جِناني",154,"ن",2,0],["ولأبْقَتْكَ للقوافِي مُعافىً","تَبْتَنِيها مُشَيِّدًا ببيانك",155,"ك",1,0],["ولا برِحْت أيامُهُ وزمانُه","مآثرُها تحيا بها دولَة ُ العرب",156,"ب",1,0],["ولا برحت آثارك الغر تكتسي","بدائع مما صاغ في وصفها نظم",157,"م",1,0],["ولا بمُلْقىً واهليه بقارعةٍ","ولا بحاملة في الكُور مَن رضَعا",158,"ع",2,0],["ولا بمن يحرِس \" الناطورُ \" ارجلَهُم \"","مهروءة سَهَّلت للكلب منتزَعا",158,"ع",2,0],["ولا بد أن ينجابَ ليلٌ وينجلي","باوضاحه يومٌ أغَرُّ مُحَجَّل",159,"ل",1,0],["ولا بدّ أن تقحمي مقحماً","وإلا فلا بد أن تُطْرَدي",160,"د",2,0],["ولا بد أن يمشي العراقُ لعيشة","يشرَّفُ فيها أو لموت محتَّم",161,"م",1,0],["ولا بأسَ بالشرِّ فاضرِبْ به","إذا كان لابُدَّ من مَضرَبَ",162,"ب",1,0],["وَلاَ بِسِنَانِ بنِ المُشَلِّلِ، عِنْدَما","بَنَى هَرَمَيْهَا مِنْ حِجَارَةِ لابِهَا",163,"ب",3,0],["وَلابِسٍ ظِلّ مالٍ للنّدَى أبَداً،","فيهِ وَقَائِعُ طَيْءٍ في بَني أسَدِ",164,"د",1,0],["ولا بِمَتروكٍ ولا مُسالم","ولا بِمُستحياً ولا مُكارِم",165,"م",1,0],["ولا بدَّ من حَمْل الهجاءِ ثِقَافَهُ","على عُودِ مَمدوحٍ إذا كان أعوجا",166,"ج",2,0],["ولابُدّ مِن فَرْوٍ إِذَا اجتَابَهُ امْرُؤٌ","غدا وهو سامٍ في الصنابر اغلبُ",167,"ب",1,0],["ولا برح الأحرار يشدو بذكرهم","بنو الشرق فخرا في القرى والعوام",168,"م",1,0]]}