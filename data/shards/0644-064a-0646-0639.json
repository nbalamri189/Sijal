tps://poetry.dctabudhabi.ae/diwan/poem/44668","الطويل"],[4013,"","https://poetry.dctabudhabi.ae/diwan/poem/113660","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54416","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94396","الطويل"],[4478,"","https://poetry.dctabudhabi.ae/diwan/poem/18799","الطويل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76749","الطويل"],[4955,"نعم ضاقت ولكنا","https://www.poetsgate.com/ViewPoem.aspx?id=211017",""],[2177,"شجاني منهم ربع خلاء","https://www.poetsgate.com/ViewPoem.aspx?id=127080",""],[4119,"ما استأنف القلب من أشواقه أربا","https://www.poetsgate.com/ViewPoem.aspx?id=16079",""],[5090,"طيرُ السلام","https://www.poetsgate.com/ViewPoem.aspx?id=186811",""],[5106,"الطَّيَِبُوْنَ .. شَرِبْنَا المِسْكَ وَالصَ","https://www.poetsgate.com/ViewPoem.aspx?id=148667",""],[5277,"قصارى القول..في رسول الله صلى الله عليه وآلهِ وسلم","https://www.poetsgate.com/ViewPoem.aspx?id=212991",""],[5397,"زها زمنا روض الشبيبة مونقا","https://www.poetsgate.com/ViewPoem.aspx?id=157957",""],[5409,"ذكراك وهي لها في الدهر تجديد","https://www.poetsgate.com/ViewPoem.aspx?id=155263",""],[5543,"ضجيعي في ليلى جوىً ونحيب","https://www.poetsgate.com/ViewPoem.aspx?id=181704",""],[5783,"حنين إلى \"نجد\"","https://www.poetsgate.com/ViewPoem.aspx?id=34823",""],[6164,"حب وعرفان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66047&r=&rc=56",""],[186,"زمان الحمى هل من معاد فنطمعا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55779&r=&rc=42",""],[4478,"لئن عانسُ قد شاب ما بين قرنها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59430&r=&rc=4",""],[6213,"نداء العجوز","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76265&r=&rc=22",""],[285,"لئنْ عدانِي زمانق عنْ لقائكُمُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7311&r=&rc=8",""],[6346,"بركان المشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83389&r=&rc=5",""]],"verses":[["لَئِن عُدتُ إِلى الضَيمِ","فَلا رَحبٌ وَلا سَهلُ",0,"ل",1,0],["لَئِن عَثَرَتْ رِجلي فَلَيسَ لِمقْوَلي","عِثارٌ وَكَم زَلَّت أَفاضِلُ أَكياسُ",1,"س",1,0],["لَئِن عَجِبوا أَن شابَ شَوقي وَلَم يَزَل","فَتِيَّ الهَوى وَالقَلبِ جَمَّ التَمَتُّعِ",2,"ع",1,0],["لَئِن عَطِشتُ إِلى ذاكَ الرُضابِ لَكَم","قَد باتَ مِنهُ يُسَقّيني فَيُرويني",3,"ن",2,0],["لَئِن عادَ لي عَبدُ العَزيزِ بِمِثلِها","وَأَمكَنَني مِنها إِذاً لا أُقيلُها",4,"ل",3,0],["لئن عذرَ الصاحبُ المرتجى","لتأخيرِ معلوميَ الواجب",5,"ب",1,1],["لئن عرضت من دون رؤيتهِ الفلا","فيا رُبَّ روضٍ ضمَّنا فيه مجمع",6,"ع",1,0],["ليِّنٌ عِطفُه فإنْ رِيمَ منه","مَكْسرَ العود كان جِدَّ صليبِ",7,"ب",1,0],["لئن عدمتْ سقيا الثرى إنّ ريقَها","لأعذبُ من هاتيك سُقيا وأخْضَرُ",8,"ر",1,0],["لَئِن عَلِقَت مَولاكَ صُبحاً فَبَعدَما","أَقامَت عَلى الأَقوامِ حَسرى النَوائِحِ",9,"ح",1,0],["لَئِن عادَ بَعدِيَ عَن ساحَتي","كَ بِنَقصِ حُظوظي وَخُسرانِها",10,"ن",3,0],["لَئِن عِبتَ نارَ اِبنِ المَراغَةِ إِنَّها","لَأَلأَمُ نارٍ مُصطَلينَ وَمَوقِدا",11,"د",2,0],["لَئِن عافَيتَني وَنَظَرتَ حِلمي","لَأَعتَتِنَن إِنِ الحَدَثانُ آلا",12,"ل",2,0],["لَئِن عوفيتَ مِن شَهَواتِ نَفسٍ","لَقَد عوفيتَ مِن شَرٍّ طَويلِ",13,"ل",1,0],["لَئِن عُدتُ بَعدَ اليَومِ إِنّي لَظالِمُ","سَأَصرِفُ نَفسي حَيثُ تُبغى المَكارِمُ",14,"م",1,1],["لَئِن عَمَّ ثُكلاً كُلَّ شَيءٍ مُصابُهُ","لَقَد خَصَّ أَطرافَ السُيوفِ الصَوارِمِ",15,"م",1,0],["لَئِن عَمَّت بَني حَوّاءَ نَفعاً","لَقَد خَصَّت بَني عَبدِ الحَميدِ",16,"د",1,0],["لَئِنْ عَجِبَ الأقوامُ مِن سُوءِ صُنعهِ","لَصُنعُ الأُلىَ حَالوا عَنِ العهدِ أَعجبُ",17,"ب",1,0],["لَئِنْ عَمَرتْ تِلكَ الخزائنُ بالبِلىَ","لقد حَفَلتْ منه الدّيارُ البلاقِعُ",18,"ع",1,0],["لَئِن عُرّيتُ مِن دُوَلٍ أَراها","تُجَدِّدُ كُلَّ يَومٍ لِلكِلابِ",19,"ب",1,0],["لَئِن عَنَّفَني الناسُ","فَفي وَجهِكَ لي عُذرُ",20,"ر",1,0],["لَئِن عَمَرَت دورٌ بِمَن لا أَوَدَّهُ","فَقَد عَمَرَت مِمَّن أُحِبُّ المَقابِرُ",21,"ر",1,0],["لِيَنعَتَنَّكَ وَهمي","إِن كَلَّ عَنكَ لِساني",22,"ن",2,0],["لَئِنْ عُرفَ الجهادُ بِكُلِّ عامٍ","فإنَّكَ طُولَ دَهْرِكَ في جِهادِ",23,"د",1,0],["لئن عد فرضاً ذو عداء صياله","فإن عَلى الحر الدِفاع لأفرض",24,"ض",1,0],["لينعمَ في ظِلِّهِ لحظةً","ويملأَ عينيهِ من حسنهِ",25,"ه",1,0],["لينعُمَ مَن إنْ عاشَ لم يُدرَ نفعُه","وإنْ ماتَ لم يعرِف له أحدٌ قبرا",26,"ر",2,0],["لئن عدمتْ سقيا الثرى إنّ ريقَها","لأعذبُ من هاتيك سُقيا وأخْصَرُ",27,"ر",1,0],["لَئِن عِيب بِالتَّقصيرِ فيكَ ثَناؤُهُ","فَقَد أمِنَ التَزويرَ فيما لَكَ اِدَّعى",28,"ع",2,0],["لَئِنْ عاد ذاك العيشُ أو عاد بعضُه","وهَيْهاتَ منه إنني لسعيد",29,"د",1,0],["لئِنْ عَظُم الخطبُ الشديد مَحَلُّه","فحلمُك أعلى منه قَدْرا وأكبر",30,"ر",1,0],["لئن عرتني من الأيّام غاشية","سدّت فروج المنى واستفتحت عللي",31,"ل",2,0],["لَينُ عِطفٍ يَجعَلُ الشِد","دَةَ وَالبوئسَ رَخاءا",32,"ا",3,0],["لئِن عُنِيَ الدّينُ الحَنيف بِحُبِّهِ","فَما زالَ بالنَّصْرِ العَزيزِ لَهُ يُعْنى",33,"ن",2,0],["لَئِنْ عَدانِي زَمانٌ عَنْ لِقائِكُمُ","لَما عَدانِيَ عَنْ تَذْكارِ ما سَلفَا",34,"ف",2,1],["لَئِن عَزَّ أَقوامٌ وَكانوا أَذِلَّةً","وَصارَ لَهُم مِن بَعدِ فَقرِهِمُ مالُ",35,"ل",1,1],["لئن عزت علي فقد","فديت ترابها بدمي",36,"ي",1,0],["لَئِن عادَلي ذاكَ السرور بِأَرضِها","وَقَرّت بِمَن أَهواهُ مُقلَتي العبرا",37,"ر",2,0],["لئن عظُمت أحزانُنا لقدومهِ","لأَعظمُ منها خوفُنا من رحيلهُ",38,"ل",2,0],["لئن عطلت كأس من الوصل حلوة","فكأس الأماني بالملاقاة مترع",39,"ع",1,0],["لئن عَدًّه الجهال ذنباً فحبذا","به حبذا يوم انفرادي في لحدي",40,"د",2,0],["لئِن عجَزَتْ عن شُكرِ بِرِّكَ قُوَّتي","فأقوى الورى عن شُكرِ بِرِّكَ عاجِزُ",41,"ز",1,1],["لئنْ عدَّدوا تَوفيقَك القومَ نعمةً","فأَنت بحمْد الله فوقَ النعائم",42,"م",1,0],["لئِنْ عَلَّلْتَني يا صاحِ يوماً","بأحبابي فَعَلّلْني بجام",43,"م",1,0],["لئن عمّرت منه القلوبُ علاقةً","لقد أقفرتْ بالرُغْمِ منه المعاهدُ",44,"د",1,0],["لئن عجزت وطف الغوادي بجودهِ","لقد خجلت منه البحار الخضارم",45,"م",1,0],["لَئِنْ عَظُمَتْ شأْناً لقد عزَّ نصرُها","بكَرَّاتِ فُرسانٍ لأَقدارِهَا شانُ",46,"ن",1,0],["لئن عاش مولانا عليّ وحمير","وراجحُ فالأَمر العسير بهم يسر",47,"ر",1,0],["لئن عاش سمح فالسماح شعاره","ومن مقبل الاقبال راشد بالرشد",48,"د",1,0],["لئن عشت مطروداً بحزني عن العزا","فإني عن الأعوال غير طريد",49,"د",1,0],["لئن عفا اللَه عني فيك من حزن","عليك نلت مناي من تمانيكا",50,"ك",2,0],["لئن عداني قدَرٌ مماكسٌ","عنكم وحظٌّ ما يزال أرعنا",51,"ن",2,0],["لئن عَدَّ قومٌ نكبةً حبسَ ليلةٍ","لقد كنتُ منكوباً من الناس مُقْبِلا",52,"ل",2,0],["لئن عَركتْ في جنب طودِك نبوةٌ","من الدهر لا تُمحَى بعذرٍ هَناتُها",53,"ت",3,0],["لئن عَمَّ شرٌّ أو أُسِرَّتْ ضَغائنٌ","ببغيٍ فإنّ اللّه عنك حسيبُ",54,"ب",1,0],["لئن عَتَبوا أني تفرّدتُ دونهّم","بمدحك فاشهدْ أنني غير مُعتِبِ",55,"ب",1,0],["لينُ عطفِ السَّماحِ قاسي فؤا","د البأس خافوه وهو مأمول",56,"ل",1,0],["لئن عرفتْ مصرٌ شواهدَ فضله","لما جهلتْ ما تدّعيه خراسان",57,"ن",1,0],["لئن عُدْنَ أيامُ الأُثيلِ وطيبُها","كميدانِها الماضي فهنَّ وسائلُه",58,"ل",2,0],["لئن عز عصر ناصري فإنه","بذكركما العالي يعز وينصر",59,"ر",1,0],["لئن عرضت للفائز الطهر نقلة","فأنت أمير المؤمنين مقيم",60,"م",1,0],["لئن عرفت منك الشناشن في الوغى","فوالدك الهادي أبو الفتح أخزم",61,"م",1,0],["لئن عَمرَت منكِ البُيوتُ فإنَّما","لَديكِ قُلوبُ العاشِقينَ طُلولُ",62,"ل",1,0],["لَئِنْ عَبِثت بهِ غُصَصُ اللَيالي","فها قد جاءَها اليومَ الشَّرابُ",63,"ب",1,0],["لَئن عَرَفَتْ لكَ الأعرابُ فضلاً","فقد عَرَفَ الأعاجمُ ما كفاكا",64,"ك",2,0],["لئن عز في الوقت اتحاد هوا لمنى","فليس يعز الانفاق وذا الأحرا",65,"ر",2,0],["لئن عشتُ عند هَزَارِ اللقاءِ","لقد مِتُّ عند هَزَارِ الإِزَارِ",66,"ر",1,0],["لَئِن عَذَّبَ التَعذيبُ لي قَبلَ ذا النَوى","بِوَجدي فَهَل بَعدَ النَوى لَيسَ يُعَذَّبُ",67,"ب",1,0],["لِيَنعَم بِاللِقا أَبَداً وَفيها","يَكونُ بِهِ اِحتِفالٌ وَاِحتِفاءُ",68,"ا",2,0],["لئن عطرت أعماله ترب قبره","سيبعث في يوم اللقا طيب النشر",69,"ر",1,0],["لئن عقرب العرب","عشية من ناقة أو بعير",70,"ر",1,0],["لئن عَزَّكم رَبط مجنونكم","فإِني لمجنونكم رابط",71,"ط",1,0],["لئن عفا بعدهم رسم فلا عجب","حكم البلى للذي ساموه هجرانا",72,"ن",2,0],["لَئِن عَظُمت ذنوب في مسيءٍ","فَأَنت لَها وإن عَظُمت غفورُ",73,"ر",1,0],["لَئِنْ عيّرتمونا ما فَعَلنْا","لقد قُلْتُمْ وجدكُمُ مقالا",74,"ل",2,0],["لَئِنْ عَطَفَتْ خَيْلُ العِرَاقِ عليْكُمُ","وَلِلَّهِ لاَ للنَّاسِ عَاقِبَةُ الأَمْرِ",75,"ر",1,0],["لئن عد فخراً لبسك المجد من أب","فلبس الفتى من نفسه المجد أفخر",76,"ر",1,0],["لئن عُوفيتُ من مرضٍ بجسمى","لما عُوفيتُ من مرضٍ بقلبى",77,"ب",2,1],["لئن عزبت تلك الخواطرُ نبوةً","فلا عن ثناهم والخواطر تعزب",78,"ب",1,0],["لئن عدوتُ شبابي","فلستُ للشيب أَهلا",79,"ل",2,0],["لَئِن عَثَروا وَلَيسَ لَعا جَواب","فَلا عَلِقَت بُطونٌ مِن ظُهورِ",80,"ر",1,0],["لئن عز الوصال وكان قتلى","رخيصا حل وهو من الحرام",81,"م",1,0],["لئن عرفت جريرا","أو اعتمدت قطيعا",82,"ع",2,1],["لئن عاد للتشبيه يوماً حرمته","لذيذ الكرى، لا بل أذوّقه فقدي",83,"د",2,0],["لَئنْ عشتُ بالعصيان دهراً ولم أكنْ","لأرجع عن ذنبٍ إلى اللهِ منْ قربِ",84,"ب",1,1],["لئن علوت فالذي أدركته","وَهْيَ المساعي بعض ما تستوجب",85,"ب",1,0],["لين عنّي ابنوره يَطْوي اسْناحه","يسري بي الشوق في حَلْكا دياجيره",86,"ر",2,0],["لئن عيرتني أن أذلّ بحبها","فأيّ مُحِب لا يكون ذليلا",87,"ل",2,0],["لئن عابه زيد لامر يريده","فكم واحد في الناس بالشكر ذاكره",88,"ر",2,0],["لئن عبستَ لما ودَّعتَ من زمنٍ","فأنتَ فيها لما استقبلتَ تبتسمُ",89,"م",1,0],["لَئن عَزّ مِنهُ المِثلُ فَالكُلُّ دونَه","وَإِن خَفَّ مِنهُ الخَصرُ فَالرِدفُ راجِحُ",90,"ح",1,0],["لئن عُرف المعرّي بعد ألفٍ","فاني سوف أُعرف بعد دهر",91,"ر",1,0],["لئن عاد ذاك العيش يا سادتي بكم","وعدنا إلى تلك الديار كما كنا",92,"ن",2,0],["لَئن عطفت محبتكم فؤادي","فَكَم يَلوي الهوا رطبَ الغصونِ",93,"ن",1,0],["لَئن عفا عن نفوس القوم لم يكُ بال","عافي عن المالِ وَهوَ الياءُ والأَلفُ",94,"ف",1,0],["لَيُنعِشُني ذاكَ النّسِيمُ إِذا هَبّا","تَنادَوا بدستُورٍ وقالوا لَنَا انظُرُوا",95,"ا",1,0],["لئنْ عظُمَتْ أقدارُها في العُلى فما","توازيكَ في العَلْياءِ لكن توازِرُ",96,"ر",1,0],["لَئنْ علتْ في أفْقِها مصْنَعي","إكليلُها الرّائِقُ أو تاجُها",97,"ج",3,0],["لئن عدموا فما عدمت بنوهم","ولا الأحرار راضية بدون",98,"ن",1,0],["لَئن عاش الفتى أَلفاً","بَلا كدرٍ وَلا سقم",99,"م",1,0],["لئن عمه بالحسن ياقوت خده","فقد خصه بالصون عنبر خاله",100,"ل",2,0],["لئن عاد موسى واقفاً باب هامان","على كبره حتى انقضت منه عامان",101,"ن",1,1],["لَئِن عَرضت نَوى وَعَدَت عَوادي","أَدالَت مَن دُنوّك بِالبِعادِ",102,"د",1,0],["لَئِن عَرَجَت روح الفَقيد لِرَبِها","سَريعاً فَفي نجليهِ 