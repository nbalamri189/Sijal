com/ViewPoem.aspx?id=187009",""],[5582,"هَلْ قَدْ أَضاءَتْ شُمُوسٌ فِي المَحارِيبِ","https://www.poetsgate.com/ViewPoem.aspx?id=186670",""],[5614,"الترحال","https://www.poetsgate.com/ViewPoem.aspx?id=1357",""],[5644,"عزيز النفس","https://www.poetsgate.com/ViewPoem.aspx?id=198582",""],[5652,"لاهو ب رجالٍ ولاهو رجيجيل","https://www.poetsgate.com/ViewPoem.aspx?id=198328",""],[5956,"تتركني","https://www.poetsgate.com/ViewPoem.aspx?id=182007",""],[5956,"أنانياتها","https://www.poetsgate.com/ViewPoem.aspx?id=182455",""],[6142,"يا نبي الهدى وأفضل خلق الل","https://www.poetsgate.com/ViewPoem.aspx?id=155703",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[5309,"تعوذت بالرحمن من عصبة الغدر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573944",""],[231,"العود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79153&r=&rc=27",""]],"verses":[["وَباعُكَ مَبسوطٌ وَأَمرُكَ نافِذٌ","وَسَيفُكَ لا يَنبو وَسَيبُكَ يُجتَدى",0,"د",2,0],["وَباعَت يوسُفاً بَيعَ المَوالي","وَأَلقَت في يَدِ القَومِ المَسيحا",1,"ح",2,0],["وباعث فكرتي سيما جبين","حمدت به السرى عند الصباح",2,"ح",1,0],["وباعثها للحربِ جرداً سوابحاً","كأن دم الأبطال من تحتها يغلي",3,"ل",2,0],["وَباعَدَ أَروى بَعدَ يَومَي تَعِلَّةٍ","خَبيبُ مَطايا مالِكٍ وَذَميلُها",4,"ل",3,0],["وَباعِثَ الماءِ ذا خَريرٍ","وَموجِدَ السِحرِ في الخَريرِ",5,"ر",1,0],["وَباعَ الأَبلَقَ الحُرَّ","بِأَوفَرلاند نَعّارَه",6,"ر",2,0],["وباعٌ إذا طالَ يومُ اللقا","ءِ غادرَ أعمارَ قومٍ قِصارا",7,"ر",2,0],["وَباعَدَني مَن لا أُحِبُّ بِعادَهُ","فَنَفسي عَلَيهِ كُلَّ حينٍ تَقَطَّعُ",8,"ع",1,0],["وباعَ بها آدمٌ خُلدَهُ","ولو لم يَكُنْ لتمنَّى القضا",9,"ض",2,0],["وباعوا النفوسَ فلم يربَحوا","ولم تغلُ في البيع أثمانُها",10,"ن",3,0],["وباعثَ الروح في أجساد صابِئَةً","لا يؤمنون بغير القوت والذهب",11,"ب",1,0],["وباع (رجا) اخته في ((الرياض))","بألفين ، للتاجر المعتبر",12,"ر",1,0],["وَبَاعَتْ نِسَاءٌ وُلْدَهَا وَاشْتَرَتْ حِلَى","وَرُبِّيَ سِفْلُ البَيْتِ تَرْبِيَةَ السَّخْلِ",13,"ل",1,0],["وباعد من تقلبه الايادي","فكم خب كأخباب الاعادي",14,"ي",1,0],["وبأعتابه الشريفة أحمى","من شئون جاءت بضيق المجال",15,"ل",1,0],["وباعث أموات الندى بأنامل","إذا انهل منها التبر أخجلت المزنا",16,"ن",2,0],["وَباعُوا بِرُخصٍ باعِثَ العدلِ فيهِمُ","فَراحُوا وَكُلٌّ مِنهُمُ في يَدَي عَدلِ",17,"ل",1,0],["وَباعِثُ العَدلِ حَيّاً بَعدَما صَرَخَت","وَأَعلَنَت أُمُّهُ بِالوَيلِ وَالثَكَلِ",18,"ل",1,0],["وباعوا على حكم الجهاد نفوسهم","ولم يجدوا في ذاك حيفا ولا غبنا",19,"ن",2,0],["وباعد كل سوء عن حماكم","ولا نادى به نادي الفناء",20,"ا",2,0],["وَبِأَعلا الكَثيبِ مِن أَيمَنِ الرَم","لِ مَلِيٌّ تُلوى إِلَيهِ الدُيونُ",21,"ن",1,0],["وَباعَ أُخراهُ وَصُفرٍ غَداً","يَخرُجُ مِنها بِيَدٍ صِفرِ",22,"ر",1,0],["وبأعلى سما الإجابة قد لا","ح بإشراق بهجةٍ كالشموس",23,"س",1,0],["وَباعدَ بين إخوانٍ وَأهلٍ","فلجّوا في التقاطعِ والتَقالي",24,"ل",2,0],["وَبِأَعناقٍ حِسانٍ","وَثُدِيٍّ وَنُحورِ",25,"ر",1,0],["وَبِأَعجازٍ كَرَملٍ","مُثقَلاتٍ وَخُصورِ",25,"ر",1,0],["وباع آخرته بالدنيا","وضاع سعيه وخاب سعيا",26,"ي",2,0],["وَباعَدتُ فيها الأَقرَبينَ مَقارِباً","عَلى حُبِّها أَهلَ الشُعوبِ البَعيدَةِ",27,"ه",1,0],["وباعُك أطْولُ يومَ الفَخارِ","وخَيلُك في حَلبةِ المجدِ أجرى",28,"ر",2,0],["وَباعِثِ الطَرفِ بِشاطِي الهَوى","وَأَنتَ يا صاحِبُ كَسلانُ",29,"ن",1,0],["وَباعَ صَفوَ ودادٍ كنت أَقصره","عَلَيهِ مُجتَهِداً في السِرِّ وَالعَلَن",30,"ن",1,0],["وباعثُها خضراءَ كالبحرِ موجُها","دِلاصٌ وعسّالٌ وعضبٌ وأجرَدُ",31,"د",1,0],["وباعثُ روحِ الحمدِ في مِعطفِ العُلى","إذا ما ارتقى يوماً فحاز التّراقيا",32,"ي",2,0],["وباعوا الحربَ أنفسَهم","بما ارتخصت من الثمنِ",33,"ن",1,0],["وباعَ بها نفسه والنفوسَ","زماناً فأرخصَ منها وغالى",34,"ل",2,0],["وباعث الجيش غطى الشمس عثيره","كأنه أسْنِماتُ العارضِ الحفل",35,"ل",1,0],["وباعثُها إلى الغاراتِ تهْفو","سِراعاً مثل مبثوثِ الجرادِ",36,"د",1,0],["وباعثُها رأدَ الضُّحى أسَديَّةً","تَواجَفُ تحت الدارعين وتعْتلي",37,"ل",2,0],["وباعِثُها كعِقْبانِ المَوامي","لها في كُلِّ مُعْتَرَكٍ مَطارُ",38,"ر",1,0],["وباعثُ جيش الرأي في كلِّ مُجْلبٍ","يُحطِّمُ أطْرافَ القَنا والقواضب",39,"ب",1,0],["وباعثُها رأدَ الضُّحى مُشْمَعِلَّةً","على كل عاصٍ يغْمط الحق باطِلُه",40,"ل",2,0],["وباعِدْ صُنوفَ الغَيِّ واقْطَعْ حِبالَهُمْ","كفى عن حِبالِ النَّاسِ حبلُ الهُدى حَبْلاَ",41,"ل",2,0],["وباعوا أنْفُساً لله حتَّى","بهِ سَبَقوا ارْتِقاءً كلَّ سابقْ",42,"ق",1,0],["وباعِدْ أُناساً بالظَّلامِ قد انْطوَوْا","وصاحِبْ بصدقِ الحالِ كلَّ منوَّرِ",43,"ر",1,0],["وباعِدِ الكِبْرَ ولا تحفَلْ به","فالكِبْرُ قاطِعٌ أساليبَ العُلَى",44,"ا",1,0],["وباعِثُه بَعد طول الفنَاء","ووارِثُه بعدَ مَن دَرَجُوا",45,"ج",3,0],["وباعدتَ عن عيني قِراها من الكرى","وأغريتَ جَفني بالدّموع الهواطلِ",46,"ل",1,0],["وباعتبار الحق قلنا خطا","جميعها والوصف فيها ذميم",47,"م",1,0],["وباعوا نفوساً في هواه نفيسةً","له فاشتراها حين أوجب بائع",48,"ع",1,0],["وباعي طويل والزمان مساعد","لنا وعيون الدهر عنا هواجع",48,"ع",1,0],["وبأَعطافٍ نِشاط","وبأَجْفانٍ كَسَالى",49,"ل",2,0],["وَباعَتِ الدين بِالدُنيا فَما اِكتَسبَت","رِبحاً سِوى الخزيِ بئسَ الربحُ يكتسبُ",50,"ب",1,0],["وباعدوني بعد قُرْبي لَهُمْ","وَحَمَّلُوا قلبيَ ما لا أُطِيقْ",51,"ق",1,0],["وباعثُ الوَجْدِ سِحْرٌ منكِ أم حَوَرٌ","وقاتِلُ الصّبِّ عَمْدٌ منكِ أَم خَطَأُ",52,"ا",1,0],["وَباعوا بِهِ الأَرواحَ نَصراً لِدينِهِ","وَكانوا لَهُ جُنداً وَأَنعِمْ بِهِم جُندا",53,"د",2,0],["وَبِاِعتِدال طَبعك اللّطيفِ","كَذا بِطيبِ وَقتك الشّريفِ",54,"ف",1,0],["وَباعَها وجاءَ بِالطَعامِ","لِصحبهِ الثَلاثَةِ الكِرامِ",55,"م",1,0],["وَباعَ قنده وَباعَ العودا","وَبُدِّلَت أَصنافه نُقودا",56,"د",2,0],["وَبِاعتِيادٍ حَصَل التَأَلُّف","حَتّى غَدا مَع الصَغير يَقف",57,"ف",1,0],["وباعدتْكَ من الدنيا حوادثُها","وساعدتْك مقاديرٌ وأقدارُ",58,"ر",1,0],["وباع بفلس كل خل خليله","وعاد الكريم الحر يسترفد القنا",59,"ن",2,0],["وَباعثة جيوش الحب","بِ ألحاظاً وأجفانا",60,"ن",2,0],["وباعدتُ الأحِبَّةَ بعدَ قربٍ","وقاربتُ النَّوى بعدَ البِعاد",61,"د",1,0],["وَباعَدَ ما قَد كانَ بَيني وَبَينَهُ","مِنَ القُربِ أَيّامٌ تَسوقُ اللَيالِيا",62,"ي",2,0],["وباعثُ روح الاتحاد ولم تكنْ","لتُبْعَثَ لولا نُورُهُ المُتكامِل",63,"ل",1,0],["وباعيني اخفي الغرام وسرّهُ","فتذيعهُ وكذا العيونُ عيونُ",64,"ن",1,0],["وَباعَدَ أَهلَ النُصحِ عَنكَ وَأوغِرَت","صُدورُ المَوالي وَاِستَسَرَّت حُقودُها",65,"د",3,0],["وباعوا نفوسا بعد أن بايعوه في","رضا الله لا بيع احتكار ولا غرر",66,"ر",1,0],["وباعَ ما في زندها من سوار","وكل ما في بيتها من رياش",67,"ش",1,0],["وَباعَدَ مَن كُنّا نُسَرُّ بِقُربِهِ","وَآخرُ مَطوِيٌّ عَليهِ اللَفائِفُ",68,"ف",1,0],["وبأعلى الكثيب بيت أغض الط","رف عنه مهابة وجلاله",69,"ل",2,0],["وباعتبار الخصر مع جاره","قد نقص الصبر وزاد الغرام",70,"م",1,0],["وَبِأَعناقِنا فِراءُ صَقيعٍ","وَبِأَعناقِ غَيرِنا السَمُّورُ",71,"ر",1,0],["وَباعَ الغَواني بِالَّتي رَثَّ وَصلُها","وَإِن كانَ ما أَعطى قَليلاً مُصَرَّدا",72,"د",2,0],["وَباع ذاع المكاري الغر بغلته","ولا اراه على فعل بمأجور",73,"ر",1,0],["وباعني الزمان بشر سَوْمٍ","وعاوضَني بِعزّتيَ اطراحا",74,"ح",2,0],["وباعك عن كسب الدنيئات ان يكن","قصيراً ففي كسب الثناء طويل",75,"ل",1,0],["وَباعَدَ داري عاجِلاً عن دِيارِهِم","كَبُعدِ مَغيبِ الشَّمسِ عن مَطلَعِ الشَّمسِ",76,"س",1,0],["وبَاعَ فيها واشترَا وحَكَمَا","والسامري بَرطَلَهُ وَظَلَمَا",77,"م",2,0],["وباعث الشكر للنعماء حيث بدا","به لمقدارها في الفكر تخييل",78,"ل",1,0],["وباعد بين ما أبغي ودهر","أبت أحداثه إلا سفاها",79,"ا",3,0],["وَباعين الحساد من فَرط البَها","تَرنو إِلَيها ذات كُل نِقاب",80,"ب",1,0],["وَبِأَعَادِي الإِمامِ الشَّيخ ضِقتُ فَلاَ","أنفَكُّ أرمِيهمُ بِالحَتفِ مِن عَجَل",81,"ل",1,0],["وبأعينٍ نجلاء أندلسيةٍ","عربية الأوتار والأقواس",82,"س",1,0],["وباعثة السحر من نرجس","وما النرجس الغض إلا الحدق",83,"ق",1,0],["وباعدي الأرض إن الجور ارهقها","ووحد الضعف في هذي الأقاليم",84,"م",1,0],["وبأعطاف وأرداف ثقال","بغصون البان ناءت في جبال",85,"ل",1,0],["وباعين ترمي القلوب باسهم","وحيا من الأهداب للأهداف",86,"ف",1,0],["وباعوا على الله العلي نفوسهم","لكي يحفظوه فاشتراها له نقدا",87,"د",2,0],["وباعوا نفوساً للإله بجنَّةٍ","فيا حبذا من بيعةٍ ربحُها يعلو",88,"ل",2,0],["وباعثُ الخلقِ جميعاً أينما","كانوا ببخرٍ أو بلحدِ الرُّمَّس",89,"س",1,0],["وبَاعِدْ سَطوَةَ الأحزابِ عَنَّا","فَلَولاهُنَّ ما كانَ الأُفُولُ",90,"ل",1,0],["وبَاعَ رَأسَ القُدسِ بَخسًا قُبَا","ومِن يَدِ العِشرينِ ضَاعَت ثَمَانْ",91,"ن",1,0],["وباعوا دينَهم بالنَّزْر مِمَّن","تولَّى يأخذ الأمرَ اغتصابا",92,"ب",2,0],["وباع البلادَ وخان العبادْ","وعاثَ الفسادَ ببحرٍ وبرْ",93,"ر",1,0],["وباعد إلهي بين نفسي وبينها","ولا تدنيني رب من عمها عما",94,"م",2,0],["وباعوا الترابَ الطهرَ والصخرةَ الَّتيْ","عليها رسولُ اللهِ يمضي إلى السما",95,"م",2,0],["وباعوكِ كمْ باعوا العروبةَ والهدى","ولمْ يرقبوا الدينَ الحنيفَ تظلُّما",95,"م",2,0],["وباعوا البلادَ بسعرٍ زهيدٍ","لأجربِ كلبٍ إذا كان موسر",96,"ر",1,0],["وباعده حتى تبين حاله","ولم يتوصل كالغبي إلى إثم",97,"م",1,0],["وباعونا بسوق الرق قطعاناً","إلى الشارين من رومان أو فرسِ",98,"س",1,0],["وباعوا نفوسا أرخص الطعن سومها","بإنسان عين الدهر غالية تشرى",99,"ر",2,0],["وباعد بين تأبيني وبيني","فما مكّنتُ عجْما من قِيادي",100,"د",2,0],["وَباعُ الهُدَى عِنْدَهُمْ قاصِرٌ","وَباعُ الضَّلالَةِ لَمْ يَقْصُرِ",101,"ر",1,0],["وَباعِثُ الجَيْشَ يَوْمَ الحَرْبِ تَقْدُمُهُ","رِيحُ المَنايا بِتَدْلِيجٍ وَتَأْوِيبِ",102,"ب",1,0],["وباعلن في ضميري وخافيات البال","بأن الحب لك غلطة من سنيني",103,"ن",2,0],["وباعَ عهوده في طرفِ عينٍ","وعاد الآن يرجوني التداني",104,"ن",2,0],["وب اعطيك مماقلت عن ماضي الجيل","علومٍ درسناها .. ب كتب وقرايا",105,"ا",3,0],["وبأعتى أمواج شقائي","روحي تسبح تتَلمَّس..",106,"س",1,0],["وباعتني بما سلبتْه مني","ومنزلتي لديها كالحذاءِ",107,"ا",2,0],["وبأعلى جبين آدم أسفر","ت سفور الهلال ليلة عيد",108,"د",1,0],["وَباعوا الديانة وَالأَمانة بسعيهم","وَمَشوا بلا جادي ضروب وَظلال",109,"ل",1,0],["وَباعَةِ هَذرٍ يَرغبونَ تَخَلُّصاً","مِنَ المَرضِ الفَتّاكِ وَالجَهلِ وَالفَقرِ",110,"ر",1,0],["وباعث الذكر اللائي إذا اشتجرت","أثرن في النفس آلاماً وأشجانا",111,"ن",2,0]]}