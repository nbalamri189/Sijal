{"poems":[[53,"ألا ناشدا ذاك الجناب الممنعا","https://www.aldiwan.net/poem30145.html","الطويل"],[71,"سلوا صهوات الخيل يوم الوغى عنا","https://www.aldiwan.net/poem4023.html","الطويل"],[10,"لقد صوت الناعي بفقد أخي الندى","https://www.aldiwan.net/poem21106.html","الطويل"],[88,"لقد جمع الشيخ هذي الكتب","https://www.aldiwan.net/poem44432.html","المتقارب"],[27,"أتطرب حين لاح بك المشيب","https://www.aldiwan.net/poem5666.html","الوافر"],[27,"أتعرف أم أنكرت أطلال دمنة","https://www.aldiwan.net/poem5729.html","الطويل"],[72,"صدودك يا لمياء عني ولا البعد","https://www.aldiwan.net/poem18549.html","الطويل"],[51,"أمكوك الخسار سأنتحيكا","https://www.aldiwan.net/poem65804.html","الوافر"],[91,"أشقى البرية نفسا صاحب الهمم","https://www.aldiwan.net/poem62723.html","عموديه"],[85,"أعزيك أبا مكسى","https://www.aldiwan.net/poem7116.html","مجزوء الوافر"],[85,"لقد صفعوه صفعة جل شأنها","https://www.aldiwan.net/poem7549.html","الطويل"],[85,"سمعت بأن طاووساً","https://www.aldiwan.net/poem8029.html","مجزوء الوافر"],[85,"إلام الخلف بينكم إلاما","https://www.aldiwan.net/poem63744.html","الخفيف"],[45,"نصيبي منك لوم العاذلات","https://www.aldiwan.net/poem62649.html","الوافر"],[28,"وقائمة قامت فقالت لنائح","https://www.aldiwan.net/poem5561.html","الطويل"],[49,"سلام على أهل القبور الدوارس","https://www.aldiwan.net/poem62123.html","الطويل"],[80,"عسى للصبا علم برسم المعالم","https://www.aldiwan.net/poem31293.html","الطويل"],[80,"جرى بك جد بالكرام عثور","https://www.aldiwan.net/poem31423.html","الطويل"],[44,"أمقران يا ابن بنات العلوج","https://www.aldiwan.net/poem30034.html","المتقارب"],[69,"أيا دادا حكت صدغاك واوا","https://www.aldiwan.net/poem28983.html","الوافر"],[74,"ألا ليت لمح البارق المتألق","https://www.aldiwan.net/poem13196.html","الطويل"],[81,"هو الفتح حقا ما على الشمس كاتم","https://www.aldiwan.net/poem61322.html","الطويل"],[52,"لقد صاح بالبين الحمام النوائح","https://www.aldiwan.net/poem27141.html","الطويل"],[48,"ألا يا جبل المقت الذي","https://www.aldiwan.net/poem62535.html","الهزج"],[48,"لقد صبحت بالخير عين تصبحت","https://www.aldiwan.net/poem64432.html","الطويل"],[48,"ألا لا أشتهي الأمطار","https://www.aldiwan.net/poem66120.html","الهزج"],[50,"ألا يا نفس المسك الذي","https://www.aldiwan.net/poem63800.html","الهزج"],[50,"نبا بك خلف الظاعنين وساد","https://www.aldiwan.net/poem63876.html","الطويل"],[46,"لقد صدئت أفهام قوم فهل لها","https://www.aldiwan.net/poem23200.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85314","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85359","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85420","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85396","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42499","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43773","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54260","البسيط"],[91,"صاحب القلم","https://www.poetsgate.com/ViewPoem.aspx?id=53269",""],[107,"خليلي مالي أبصر الدهر راضيا","https://www.aldiwan.net/poem16201.html","الطويل"],[133,"وقالوا حوت مصر المحاسن كلها","https://www.aldiwan.net/poem49053.html","الطويل"],[158,"ليوم واحد لك في الصيام","https://www.aldiwan.net/poem59047.html","الوافر"],[158,"كفاك سرورا بالحسين قدومه","https://www.aldiwan.net/poem59062.html","الطويل"],[167,"دع الدار بالبحرين تعفو ربوعها","https://www.aldiwan.net/poem1634.html",""],[183,"ألا هل لدائي من فراقك إفراق","https://www.aldiwan.net/poem14607.html","الطويل"],[184,"ضرير أحنف شيخ كبير","https://www.aldiwan.net/poem44127.html","الوافر"],[197,"تغيرت الدنيا فهل هي زور","https://www.aldiwan.net/poem45156.html","الطويل"],[209,"عودوا إلى الوصل ثم عودوا","https://www.aldiwan.net/poem46615.html","مخلع البسيط"],[209,"لقيتك بعد اليأس منك فصفقت","https://www.aldiwan.net/poem46765.html","الطويل"],[230,"زبالة لا لشر أنت ممن","https://www.aldiwan.net/poem14895.html","الوافر"],[235,"أحقا عباد الله أمنع من ورد","https://www.aldiwan.net/poem18157.html","الطويل"],[237,"إلى مجدك العلياء تعزى وتنسب","https://www.aldiwan.net/poem23838.html","الطويل"],[259,"لقد آن إعراضي عن الغي جانبا","https://www.aldiwan.net/poem38364.html","الطويل"],[268,"أمن عربية تشتاق دارا","https://www.aldiwan.net/poem35647.html","الوافر"],[273,"أبقت لصحوي من علاقتها نشوى","https://www.aldiwan.net/poem25453.html","الطويل"],[273,"ألما بأشلاء العلى والمكارم","https://www.aldiwan.net/poem25526.html","الطويل"],[280,"لقد كنت من وشك الفراق أليح","https://www.aldiwan.net/poem32832.html","الطويل"],[301,"لقد صان أصداغ المماليك نبتها","https://www.aldiwan.net/poem57909.html","الطويل"],[346,"فديت الديوك بذبح عظيم","https://www.aldiwan.net/poem20667.html","المتقارب"],[362,"بغرة وجهك منا القسم","https://www.aldiwan.net/poem60658.html","المتقارب"],[374,"لك الله من علم إلى الحق رافع","https://www.aldiwan.net/poem59347.html","الطويل"],[374,"بمولد مريم العذراء تمت","https://www.aldiwan.net/poem66963.html","الوافر"],[390,"لقد صدقوا والراقصات إلى منى","https://www.aldiwan.net/poem53505.html","الطويل"],[400,"لقد صدرت إلى أعلى مقام","https://www.aldiwan.net/poem33449.html","الوافر"],[400,"سلام على نجد ومن حل في نجد","https://www.aldiwan.net/poem33956.html","الطويل"],[402,"سلام على قوم مضوا لسبيلهم","https://www.aldiwan.net/poem50030.html","الطويل"],[403,"أخذن زمام الدمع خوف انسجامه","https://www.aldiwan.net/poem50120.html","الطويل"],[406,"أطاع الهوى من بعدهم وعصى الصبر","https://www.aldiwan.net/poem32477.html","الطويل"],[407,"حمدنا الذي أدى ابن يحيى فأصبحت","https://www.aldiwan.net/poem67519.html","الطويل"],[413,"بلغتم كمال الرشد أبناء راشد","https://www.aldiwan.net/poem54010.html","الطويل"],[413,"سرينا لنمحو الإثم أو نغنم الأجرا","https://www.aldiwan.net/poem54107.html","الطويل"],[459,"تعاظم حزني والرزية أعظم","https://www.aldiwan.net/poem15905.html","الطويل"],[462,"أعاذلتي في حبس نفس ملية","https://www.aldiwan.net/poem3307.html","عموديه"],[462,"رمتني بنجل والسهام جفون","https://www.aldiwan.net/poem3591.html","عموديه"],[462,"ألمت سليمى والنسيم عليل","https://www.aldiwan.net/poem3634.html","عموديه"],[513,"أفي أهل ذا النادي عليم أسائله","https://www.aldiwan.net/poem12195.html","الطويل"],[525,"أيدري السيف أي فتى يبيد","https://www.aldiwan.net/poem45970.html","الوافر"],[536,"ملامكما كفا فقد قضي الأمر","https://www.aldiwan.net/poem48170.html","عموديه"],[536,"بلابل من مرمر نحتت","https://www.aldiwan.net/poem48256.html","عموديه"],[560,"أتحسب من حمر الشقيق خدودها","https://www.aldiwan.net/poem52860.html","الطويل"],[562,"لك الفضل يا من بالمحب تلطفا","https://www.aldiwan.net/poem905.html",""],[565,"أذابت قلبه الزفره","https://www.aldiwan.net/poem69677.html","مجزوء الرجز"]],"verses":[["لَقَد صَغَّرَ الأَرزاءَ زُرؤُكَ قَبلَها","وَهَوَّنَ عِندي النازِلَ المُتَوَقَّعا",0,"ع",2,0],["لَقَد صَبَروا صَبراً جَميلاً وَدافَعوا","طَويلاً فَما أَجدى دِفاعٌ وَلا أَغنى",1,"ن",2,0],["لَقَد صَوَّتَ الناعي بِفَقدِ أَخي النَدى","نِداءً لَعَمري لا أَبا لَكَ يُسمَعُ",2,"ع",1,1],["لقد صنتها من طروق البلى","وخلصتها من يد المستلب",3,"ب",1,0],["لَقَد صَدَّعتُ صَخرَةَ مَن رَماكُم","وَقَد يُرمى بِيَ الحَجَرُ الصَليبُ",4,"ب",1,0],["لَقَد صَبَّحَتكُم خَيلُ قَيسٍ كَأَنَّها","سَراحينُ دَجنٍ يَنفُضُ الطَلَّ سيدُها",5,"د",3,0],["لقد صدقتنا في الزمانِ وعودُهُ","وشيمةُ إسماعيل أن يصدق الوعد",6,"د",1,0],["لقد صبرتْ على قذرٍ وقُبْح","ولم تَسْعَدْ ولم تُرْضِ المليكا",7,"ك",2,0],["لَقَد صَحِبتُ شَبابي وَاليَراعَ مَعاً","أَودى شَبابي فَهَل أُبقي عَلى قَلَمي",8,"م",2,0],["لقد صرت لنا اليو","م كما كنت لنا أمس",9,"س",1,0],["لقد صفعوه صفعة جل شأنها","وأعيا على حذق الطبيب علاجها",10,"ه",2,1],["لَقَد صَغَّرتَ يا مَغرو","رُ نُعمى اللَهِ كُفرانا",11,"ن",2,0],["لَقَد صارَت لَكُم حُكماً وَغُنماً","وَكانَ شِعارُها المَوتَ الزُؤاما",12,"م",2,0],["لَقَد صَدَقَ المُنَقِّبَ عَن حَديثي","بُدُوِّيَ لِلأَعادي وَاِنصِلاتي",13,"ي",1,0],["لَقَد صَبَرَ الجَرّاحُ حَتّى مَشَت بِهِ","إِلى رَحمَةِ اللَهِ السُيوفُ الصَوارِمُ",14,"م",1,0],["لَقَد صِرتُمُ في غايَةِ المَوتِ وَالبِلى","وَأَنتُم بِها ما بَينَ راجٍ وَآيِسِ",15,"س",1,0],["لقد صَرَمَتْ حبلي ظباءُ الصرائمِ","وجازَتْ موَدّات الهوى بالسخائمِ",16,"م",1,0],["لَقَد صُنْتَ دينَ اللَّه خَيرَ صِيانَةٍ","كَأَنَّك قَلبٌ فيه وهوَ ضَميرُ",17,"ر",1,0],["لَقَد صِرتَ بَينَ الوَرى عِبرَةً","رَكِبتَ الهَماليجَ بَعدَ البَقَر",18,"ر",1,0],["لقد صدَّتْكِ أمُّكِ عن رضانا","فيا ماما دعي للصلحِ بابا",19,"ب",2,0],["لَقَد صَدَعَت أَيدي الحَوادِثِ شَملَنا","فَهَل مِن تَلاقٍ بَعدَ هَذا التَفَرُّقِ",20,"ق",1,0],["لَقَد صاد مِنهُ صُحبَة الدَّهرِ حَاطِمٌ","وقَارع مِنهُ صعدة البَغيِ خَأطِمُ",21,"م",1,0],["لَقَد صاحَ بِالبَينِ الحَمامُ النَوائِحُ","وَهاجَت لَكَ الشَوقَ الحُمولُ الرَوائِحُ",22,"ح",1,1],["لَقَد صَوَّرَكَ اللَهُ","فَما حَلّى وَلا مَلَّح",23,"ح",1,0],["لَقَد صُبِّحَت بِالخَيرِ عَينٌ تَصَبَّحَت","بِوَجهِكِ يا مَعشوقُ في كُلِّ شارِقِ",24,"ق",1,1],["لَقَد صِرتَ لِمَن أَهوا","هُ عُذراً لَيسَ بِالدونِ",25,"ن",1,0],["لَقَد صُمتُ عَن الجَورِ","لِأَلقاكَ فَما أَقصَر",26,"ر",1,0],["لَقَد صادَني ريمٌ أَرَدتُ اِصطِيادَهُ","وَما كُنتُ لَولا ما أَرَدتُ أُصادُ",27,"د",1,0],["لَقَد صَرَّحَت عَمّا تُجَمجِمُ طَعنَةٌ","شَجيتَ بِها حَتّى ظَلِلتَ تُعادُ",27,"د",1,0],["لَقَد صَدِئَت أَفهامُ قَومٍ فَهَل لَها","صِقالٌ وَيَحتاجُ الحُسامُ إِلى الصَقلِ",28,"ل",1,1],["لَقَد صدعتني النائبات بوقعها","وَلَم تَلتَئم للَيوم بعدُ صدوعي",29,"ي",1,0],["لَقَد صمت وَصمتي","ما كانَ مني عيا",30,"ي",2,0],["لَقَد صدحت تَشكو بليل حمامةٌ","عَلى فنن من ذي الأراك سجوع",31,"ع",1,0],["لَقَد صَحَّ أن الضعف ذل لأهله","وأن عَلى الأرض القويّ مسيطر",32,"ر",1,0],["لَقَدْ صَفِرَتْ عِيابُ الْوُدِّ بَيْنِي","وَبَيْنَ أَحِبَّتِي بَعدَ امْتِلاءِ",33,"ا",2,1],["لَقَد صَرَعَتكَ العَينُ قيلَ كَريهَةٍ","تَرى القَومَ فيها عَن سُروجِهِم صَرعى",34,"ع",2,0],["لقد صَدِئْنا ودُون الغِمدِ منفسَحٌ","فجرِّدُوا حَدَّ مَاضينا لآتينَا",35,"ن",2,0],["لقد صحبت شبابي واليراع معا","أودى شبابي ... فهل أبقي على قلم",36,"م",1,0],["لَقَد صَدَقت مِني الظُنون وَأَصبَحَت","تَفل جُيوش العَدل عَني الأَعاديا",37,"ي",2,0],["لقد صدقوا لو كان خدن العلي بها","ولو كان فيها لاستتم علاها",38,"ه",2,0],["لقد صابرت هذا الشهر فيما","أمرت به مصابرة الكرام",39,"م",1,0],["لقد صدق الله المعالي وعده","به فلتصلي نذرها وتصومه",40,"م",2,0],["لَقَد صَدَّعُوا عَمداً عَصاها فَلا اِلتَقَت","وَلا اِلتَأَمَت إِلّا عَلَيهم صُدُوعُها",41,"ع",3,0],["لقد صاولتْنِي يا أبا الصَّلْتِ مذ نأتْ","ديارُك عن داري همومٌ وأشواق",42,"ق",1,0],["لقد صبّ البلاد عليّ صبا","فليسَ لما بليتُ به طبيب",43,"ب",1,0],["لقد صهر الانسان من كل معدن","وباءَ بسرّ النار وهو خبيرُ",44,"ر",1,0],["لقد صددنا كما صددتم","فهل ندمنا كما ندمتم",45,"م",1,0],["لقد صار باب اللوق كعبة عاشق","يحج إليها ناسكاً يتبتل",46,"ل",1,0],["لَقد صَدَقَ الَّذي قَد قالَ قِدماً","فَغُضَّ الطَرفَ إِنَّكَ مِن نُمَيرِ",47,"ر",1,0],["لَقَدْ صَدَّنِي عَنْ شَمِّهِ وَاقْتِطَافِهِ","بِطَرْفٍ عَلِيلٍ لاَ بِسَبْفٍ سَمَرْقَنْدِي",48,"ي",1,0],["لقد صدّق الشسخ المعمم حلمه","فلاقى الذي لاقت من السيل مأرب",49,"ب",1,0],["لقد صحبت بعد الأعز اذلة","وقد خشيت حتى الصغار الأجانبا",50,"ب",2,0],["لقد صانَ الطّهارةَ من جبينٍ","حكى قمَراً وكانَ لهُ سِرارا",51,"ر",2,0],["لَقَدْ صَلدَ الزَّنْدُ الذِي أنَا قَادِحٌ","مِنَ الفِكْرِ فِي تَقْرِيظِ جَدْوَى عَلَى جَدْوَى",52,"و",2,0],["لقَد صَبروا فيها كِراما وصَابَرُوا","فَلا غَرْو أن فَازُوا بِصَفْو المكَارِمِ",53,"م",1,0],["لَقَد صَحَّ وَجدي فَهوَ لَم يَشكُ عِلَّةً","وَما القَلبُ مِن داءِ الغَرامِ صَحيحُ",54,"ح",1,0],["لقد صان أصداغ المماليك نبتها","وما شانهم في الحسن حلق الذوائب",55,"ب",1,1],["لَقَد صَفَّقوا طَرَباً بِالجنَاحِ","كتَصفِيقِ شَادٍ بِصَوْتٍ رَخِيمِ",56,"م",1,0],["لقد صاغَكَ اللهُ مِن لُطْفِه","وصان ذِمامَكَ مِن أنْ يُذَمّ",57,"م",1,0],["لقد صار مفجوعاً بنفسٍ عنيدةٍ","فأحقِرْ بمفجوعٍ وأعظِمْ بفاجع",58,"ع",1,0],["لقد صدق الذي قد قال يوماً","بأنك في الرجا بابُ الرجاء",59,"ا",2,0],["لَقَد صَدَقوا وَالراقِصاتِ إِلى منى","بِأَنَّ مَوَدّاتِ العدى لَيسَ تَنفَعُ",60,"ع",1,1],["لقد صدرت إلى أعلى مقام","لأعلام لأعلام كرام",61,"م",1,1],["لقد صدرت من سفح صنعا سقى الحيا","رُباها وحياها بقهقهة الرعد",62,"د",1,0],["لقدْ صرَعَتْهُمْ صَرَعُة المَوتِ فاستوى","قَديُمهُمْ في شأنِهِمْ وحَديثُهُمْ",63,"م",1,0],["لَقَد صَدع البين المشتَّتُ شملَنا","كَصدع الصَفا لا مَطمَعٌ في التِئامِهِ",64,"م",2,0],["لقد صَدَّعَتْ بعد التّفَرّق شَملَنا","كصَدْعِ الصّفا ما إنْ له أبداً جبْرُ",65,"ر",1,0],["لَقَد صَبّحَتنا خَيلُهُ وَرِجالُه