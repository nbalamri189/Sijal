te.com/ViewPoem.aspx?id=170488",""],[5277,"هواطلٌ ومقاتلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=190848",""],[5277,"أخرُ الضوء","https://www.poetsgate.com/ViewPoem.aspx?id=198477",""],[5277,"\"أينَ العراقُ.. تُرى؟\"","https://www.poetsgate.com/ViewPoem.aspx?id=206804",""],[592,"على الحبر بحر العلم بدر المنابر","https://www.poetsgate.com/ViewPoem.aspx?id=128847",""],[5397,"عن الدار نأيا أزمع الركب ترحالا","https://www.poetsgate.com/ViewPoem.aspx?id=157967",""],[5409,"تركت وراءك البلد الأمينا","https://www.poetsgate.com/ViewPoem.aspx?id=155482",""],[5431,"إنّي عشقتك محكومٌ بتأبيدي","https://www.poetsgate.com/ViewPoem.aspx?id=184962",""],[5431,"تراود منك الروح حتى تُسلّما","https://www.poetsgate.com/ViewPoem.aspx?id=196983",""],[5431,"فلا تشتكوا حزنا ولا تأبهوا خسفا","https://www.poetsgate.com/ViewPoem.aspx?id=197060",""],[5431,"تماهينا ولم نرضَ انفكاكا ...","https://www.poetsgate.com/ViewPoem.aspx?id=200702",""],[5431,"بريد مستعجل لمحمد صلى الله عليه وسلم","https://www.poetsgate.com/ViewPoem.aspx?id=208569",""],[5533,"دَارَ الزَّمانِ على بِلادِي","https://www.poetsgate.com/ViewPoem.aspx?id=176319",""],[5541,"الشيبانية .. سأحمد ربي طاعة وتعبدا","https://www.poetsgate.com/ViewPoem.aspx?id=119906",""],[5550,"أَبُثُّ إليكِ","https://www.poetsgate.com/ViewPoem.aspx?id=213054",""],[5582,"سَقاكِ دِيارَ الظَّاعِنِينَ غَمامُ","https://www.poetsgate.com/ViewPoem.aspx?id=187273",""],[5616,"الراحلون","https://www.poetsgate.com/ViewPoem.aspx?id=204853",""],[5638,"قيدي يحدثني","https://www.poetsgate.com/ViewPoem.aspx?id=198120",""],[5638,"سلام","https://www.poetsgate.com/ViewPoem.aspx?id=198252",""],[5667,"الراقصة","https://www.poetsgate.com/ViewPoem.aspx?id=214915",""],[5690,"إذا الصارم البتار عزت مضاربه","https://www.poetsgate.com/ViewPoem.aspx?id=172139",""],[5691,"ربيع عشتار","https://www.poetsgate.com/ViewPoem.aspx?id=206247",""],[5790,"أرى في الصبا من نشر رياهم عرفا","https://www.poetsgate.com/ViewPoem.aspx?id=112080",""],[5790,"رعى الله ليلا زارني في ظلامه","https://www.poetsgate.com/ViewPoem.aspx?id=112125",""],[5804,"اذكريني","https://www.poetsgate.com/ViewPoem.aspx?id=184429",""],[5845,"كلفتُ بكمْ ففاضَ دمي دموعاً","https://www.poetsgate.com/ViewPoem.aspx?id=16698",""],[5956,"شَعْبِيَّةُ المَرْتَبة *","https://www.poetsgate.com/ViewPoem.aspx?id=183665",""],[5956,"ذِكْرَى رحلة","https://www.poetsgate.com/ViewPoem.aspx?id=184841",""],[5956,"أحن لسوريا","https://www.poetsgate.com/ViewPoem.aspx?id=184919",""],[5956,"حسناء مضت دون أي اكتراث بيا","https://www.poetsgate.com/ViewPoem.aspx?id=185441",""],[5956,"مناجاتي لابنتي هنادي","https://www.poetsgate.com/ViewPoem.aspx?id=192383",""],[6185,"بوح !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87022&r=&rc=8",""],[6320,"نَزِيفُ القَهْر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84335&r=&rc=32",""],[6320,"مَهَاوِي اليَأْس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84354&r=&rc=51",""],[6331,"حلم موت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82023&r=&rc=4",""]],"verses":[["لَقَد صَغَّرَ الأَرزاءَ زُرؤُكَ قَبلَها","وَهَوَّنَ عِندي النازِلَ المُتَوَقَّعا",0,"ع",2,0],["لَقَد صَبَروا صَبراً جَميلاً وَدافَعوا","طَويلاً فَما أَجدى دِفاعٌ وَلا أَغنى",1,"ن",2,0],["لَقَد صَوَّتَ الناعي بِفَقدِ أَخي النَدى","نِداءً لَعَمري لا أَبا لَكَ يُسمَعُ",2,"ع",1,1],["لقد صنتها من طروق البلى","وخلصتها من يد المستلب",3,"ب",1,0],["لَقَد صَدَّعتُ صَخرَةَ مَن رَماكُم","وَقَد يُرمى بِيَ الحَجَرُ الصَليبُ",4,"ب",1,0],["لَقَد صَبَّحَتكُم خَيلُ قَيسٍ كَأَنَّها","سَراحينُ دَجنٍ يَنفُضُ الطَلَّ سيدُها",5,"د",3,0],["لقد صدقتنا في الزمانِ وعودُهُ","وشيمةُ إسماعيل أن يصدق الوعد",6,"د",1,0],["لقد صبرتْ على قذرٍ وقُبْح","ولم تَسْعَدْ ولم تُرْضِ المليكا",7,"ك",2,0],["لَقَد صَحِبتُ شَبابي وَاليَراعَ مَعاً","أَودى شَبابي فَهَل أُبقي عَلى قَلَمي",8,"م",2,0],["لقد صرت لنا اليو","م كما كنت لنا أمس",9,"س",1,0],["لقد صفعوه صفعة جل شأنها","وأعيا على حذق الطبيب علاجها",10,"ه",2,1],["لَقَد صَغَّرتَ يا مَغرو","رُ نُعمى اللَهِ كُفرانا",11,"ن",2,0],["لَقَد صارَت لَكُم حُكماً وَغُنماً","وَكانَ شِعارُها المَوتَ الزُؤاما",12,"م",2,0],["لَقَد صَدَقَ المُنَقِّبَ عَن حَديثي","بُدُوِّيَ لِلأَعادي وَاِنصِلاتي",13,"ت",2,0],["لَقَد صَبَرَ الجَرّاحُ حَتّى مَشَت بِهِ","إِلى رَحمَةِ اللَهِ السُيوفُ الصَوارِمُ",14,"م",1,0],["لَقَد صِرتُمُ في غايَةِ المَوتِ وَالبِلى","وَأَنتُم بِها ما بَينَ راجٍ وَآيِسِ",15,"س",1,0],["لقد صَرَمَتْ حبلي ظباءُ الصرائمِ","وجازَتْ موَدّات الهوى بالسخائمِ",16,"م",1,0],["لَقَد صُنْتَ دينَ اللَّه خَيرَ صِيانَةٍ","كَأَنَّك قَلبٌ فيه وهوَ ضَميرُ",17,"ر",1,0],["لَقَد صِرتَ بَينَ الوَرى عِبرَةً","رَكِبتَ الهَماليجَ بَعدَ البَقَر",18,"ر",1,0],["لقد صدَّتْكِ أمُّكِ عن رضانا","فيا ماما دعي للصلحِ بابا",19,"ب",2,0],["لَقَد صَدَعَت أَيدي الحَوادِثِ شَملَنا","فَهَل مِن تَلاقٍ بَعدَ هَذا التَفَرُّقِ",20,"ق",1,0],["لَقَد صاد مِنهُ صُحبَة الدَّهرِ حَاطِمٌ","وقَارع مِنهُ صعدة البَغيِ خَأطِمُ",21,"م",1,0],["لَقَد صاحَ بِالبَينِ الحَمامُ النَوائِحُ","وَهاجَت لَكَ الشَوقَ الحُمولُ الرَوائِحُ",22,"ح",1,1],["لَقَد صَوَّرَكَ اللَهُ","فَما حَلّى وَلا مَلَّح",23,"ح",1,0],["لَقَد صُبِّحَت بِالخَيرِ عَينٌ تَصَبَّحَت","بِوَجهِكِ يا مَعشوقُ في كُلِّ شارِقِ",24,"ق",1,1],["لَقَد صِرتَ لِمَن أَهوا","هُ عُذراً لَيسَ بِالدونِ",25,"ن",1,0],["لَقَد صُمتُ عَن الجَورِ","لِأَلقاكَ فَما أَقصَر",26,"ر",1,0],["لَقَد صادَني ريمٌ أَرَدتُ اِصطِيادَهُ","وَما كُنتُ لَولا ما أَرَدتُ أُصادُ",27,"د",1,0],["لَقَد صَرَّحَت عَمّا تُجَمجِمُ طَعنَةٌ","شَجيتَ بِها حَتّى ظَلِلتَ تُعادُ",27,"د",1,0],["لَقَد صَدِئَت أَفهامُ قَومٍ فَهَل لَها","صِقالٌ وَيَحتاجُ الحُسامُ إِلى الصَقلِ",28,"ل",1,1],["لَقَد صدعتني النائبات بوقعها","وَلَم تَلتَئم للَيوم بعدُ صدوعي",29,"ع",2,0],["لَقَد صمت وَصمتي","ما كانَ مني عيا",30,"ي",2,0],["لَقَد صدحت تَشكو بليل حمامةٌ","عَلى فنن من ذي الأراك سجوع",31,"ع",1,0],["لَقَد صَحَّ أن الضعف ذل لأهله","وأن عَلى الأرض القويّ مسيطر",32,"ر",1,0],["لَقَدْ صَفِرَتْ عِيابُ الْوُدِّ بَيْنِي","وَبَيْنَ أَحِبَّتِي بَعدَ امْتِلاءِ",33,"ا",2,1],["لَقَد صَرَعَتكَ العَينُ قيلَ كَريهَةٍ","تَرى القَومَ فيها عَن سُروجِهِم صَرعى",34,"ع",2,0],["لقد صَدِئْنا ودُون الغِمدِ منفسَحٌ","فجرِّدُوا حَدَّ مَاضينا لآتينَا",35,"ن",2,0],["لقد صدقوا المختار من غير رؤية","وتكذيب جل الشاهدين مقاوم",36,"م",1,0],["لقد صحبت شبابي واليراع معا","أودى شبابي ... فهل أبقي على قلم",37,"م",1,0],["لقد صدعت قلبي صوادع للردى","لهن انحدار بالأسى وصعود",38,"د",1,0],["لَقَد صَدَقت مِني الظُنون وَأَصبَحَت","تَفل جُيوش العَدل عَني الأَعاديا",39,"ي",2,0],["لقد صدقوا لو كان خدن العلي بها","ولو كان فيها لاستتم علاها",40,"ه",2,0],["لقد صابرت هذا الشهر فيما","أمرت به مصابرة الكرام",41,"م",1,0],["لقد صدق الله المعالي وعده","به فلتصلي نذرها وتصومه",42,"م",2,0],["لَقَد صَدَّعُوا عَمداً عَصاها فَلا اِلتَقَت","وَلا اِلتَأَمَت إِلّا عَلَيهم صُدُوعُها",43,"ع",3,0],["لقد صاولتْنِي يا أبا الصَّلْتِ مذ نأتْ","ديارُك عن داري همومٌ وأشواق",44,"ق",1,0],["لقد صبّ البلاد عليّ صبا","فليسَ لما بليتُ به طبيب",45,"ب",1,0],["لقد صهر الانسان من كل معدن","وباءَ بسرّ النار وهو خبيرُ",46,"ر",1,0],["لقد صددنا كما صددتم","فهل ندمنا كما ندمتم",47,"م",1,0],["لقد صار باب اللوق كعبة عاشق","يحج إليها ناسكاً يتبتل",48,"ل",1,0],["لَقد صَدَقَ الَّذي قَد قالَ قِدماً","فَغُضَّ الطَرفَ إِنَّكَ مِن نُمَيرِ",49,"ر",1,0],["لَقَدْ صَدَّنِي عَنْ شَمِّهِ وَاقْتِطَافِهِ","بِطَرْفٍ عَلِيلٍ لاَ بِسَبْفٍ سَمَرْقَنْدِي",50,"د",2,0],["لقد صدّق الشسخ المعمم حلمه","فلاقى الذي لاقت من السيل مأرب",51,"ب",1,0],["لقد صحبت بعد الأعز اذلة","وقد خشيت حتى الصغار الأجانبا",52,"ب",2,0],["لقد صانَ الطّهارةَ من جبينٍ","حكى قمَراً وكانَ لهُ سِرارا",53,"ر",2,0],["لَقَدْ صَلدَ الزَّنْدُ الذِي أنَا قَادِحٌ","مِنَ الفِكْرِ فِي تَقْرِيظِ جَدْوَى عَلَى جَدْوَى",54,"و",2,0],["لقَد صَبروا فيها كِراما وصَابَرُوا","فَلا غَرْو أن فَازُوا بِصَفْو المكَارِمِ",55,"م",1,0],["لَقَد صَحَّ وَجدي فَهوَ لَم يَشكُ عِلَّةً","وَما القَلبُ مِن داءِ الغَرامِ صَحيحُ",56,"ح",1,0],["لقد صان أصداغ المماليك نبتها","وما شانهم في الحسن حلق الذوائب",57,"ب",1,1],["لَقَد صَفَّقوا طَرَباً بِالجنَاحِ","كتَصفِيقِ شَادٍ بِصَوْتٍ رَخِيمِ",58,"م",1,0],["لقد صاغَكَ اللهُ مِن لُطْفِه","وصان ذِمامَكَ مِن أنْ يُذَمّ",59,"م",1,0],["لقد صار مفجوعاً بنفسٍ عنيدةٍ","فأحقِرْ بمفجوعٍ وأعظِمْ بفاجع",60,"ع",1,0],["لقد صدق الذي قد قال يوماً","بأنك في الرجا بابُ الرجاء",61,"ا",2,0],["لَقَد صَدَقوا وَالراقِصاتِ إِلى منى","بِأَنَّ مَوَدّاتِ العدى لَيسَ تَنفَعُ",62,"ع",1,1],["لقد صدرت إلى أعلى مقام","لأعلام لأعلام كرام",63,"م",1,1],["لقد صدرت من سفح صنعا سقى الحيا","رُباها وحياها بقهقهة الرعد",64,"د",1,0],["لقدْ صرَعَتْهُمْ صَرَعُة المَوتِ فاستوى","قَديُمهُمْ في شأنِهِمْ وحَديثُهُمْ",65,"م",1,0],["لَقَد صَدع البين المشتَّتُ شملَنا","كَصدع الصَفا لا مَطمَعٌ في التِئامِهِ",66,"م",2,0],["لقد صَدَّعَتْ بعد التّفَرّق شَملَنا","كصَدْعِ الصّفا ما إنْ له أبداً جبْرُ",67,"ر",1,0],["لَقَد صَبّحَتنا خَيلُهُ وَرِجالُهُ","بِأَروَع بدءِ الناسِ بِأساً وَسُؤدَدا",68,"د",2,0],["لقد صُلْتَ حتَّى كانَ أوَّلُ قائم","لسيفك يوم الرَّوع أوَّلَ ساجد",69,"د",1,0],["لقد صيَّر الغبراءَ خضراءَ قبرُه","وأشرقَ فيها في الحقيقة بدره",70,"ه",1,0],["لقد صدق القول النُّطاسيُ وحده","وكذَّب آمالُ العُلى والمُنَجِّمُ",71,"م",1,0],["لقد صنت من بعد العزيز بن يوسف","نتيجة فضل مثلها لا يضيّع",72,"ع",1,0],["لقد صحَّ عندي بعد نفخة جاحرٍ","وشكَّكتما أنَّ النسيم خؤون",73,"ن",1,0],["لقد صدقوا أنَّ اللهى تفتح اللّها","مقاليَ جزل والنوال جزيل",74,"ل",1,0],["لقد صفحوا عن زلة النعل منكم","ودان لهم حافي الزمان وناعله",75,"ل",2,0],["لقد صادت يدُ الأيام طيراً","تضيق به حباله من يصيدُ",76,"د",1,0],["لقد صادَني من جِئتُ أبغي اصطِياده","وقد غَرَّني منه التنقُل والذُّعرُ",77,"ر",1,0],["لقد صَوَّرَ السِّخرَ في حُسنَها","وأثبتَ لفن ما أثبتنا",78,"ت",3,0],["لَقد صَلَحَ ابنُ الصُّلحِ لِلمَدْح صادقاً","فكانَ أميراً للقَوافي يَقودُها",79,"د",3,0],["لقد صح عندي أن شيمتك الوفا","فعاملتني باللطف والعطف والصفا",80,"ا",1,0],["لقد صُمْتَ على الحقِّ","وَأَفْطَرْتَ على الفِطْرَهْ",81,"ر",2,0],["لقد صرفت من خمرة الحب صرفها","لأرواحنا والراح تمنح صفوها",82,"ه",2,0],["لقد صقلت كفُّ التجاربِ ذهنهم","وبالصقلِ يغدو الذهن أجلى من الفجر",83,"ر",1,0],["لقد صرتُ أَهوَى الموت بعدك والذي","براك فعيشي صرتُ أحسبهُ لَغوا",84,"و",2,0],["لقد صام كيسي صوم الوصال","فلا من حرامٍ ولا من حلال",85,"ل",1,1],["لَقَد صدقتنا بالنوال وعودُه","وَعادَة إِسماعيل صدقُ المَواعدِ",86,"د",1,0],["لقد صاحَ داعي الرُّشْدِ لوْ أنَّ سَامعاً","ولاحَ صَباحُ الحقِّ لو أنَّ رائيا",87,"ي",2,0],["لقد صار هذا المصرع الآن عبرة","لمن بات في الدنيا الدنية يطمع",88,"ع",1,0],["لقد صار هذا دأبنا وهي علة","أبى الجهل أن نلقى لها الدهر آسيا",89,"ي",2,0],["لقد صار دمعي مألفاً لجفونهِ","اذا رامَ نُقصاناً يقولُ له زِدِ",90,"د",1,0],["لقد صافحت منك الإمارة ماجدا","له شاهدٌ من مجده ومشاهد",91,"د",1,0],["لَقَد صارَ رَوْضاً لِلبَهاءِ وَإِنّهُ","غَدَت فيهِ أَنواعُ المَحاسِن تُغرسُ",92,"س",1,0],["لَقَدْ صَانُوا الوِزارَةَ بَعْدَ هَتْكٍ","وَزانُوهَا وَكانَتْ غَيْرَ زَيْنِ",93,"ن",1,0],["لقد صحبتُ رجالاً قبل ذا فمضوا","عنى فها أنا باقٍ في الذين بقوا",94,"ق",3,0],["لقد صرتُ في نُعماكَ ما بين حاسدٍ","وراجٍ ومَرْجُوٍّ خليط معاشِر",95,"ر",1,0],["لقد صرتِ لي ضحكةً في شفاهي","وقد صرتِ لي دمعةً في عيوني",96,"ن",2,0],["لقد صممتْ منه المنايا على فتى","حبيب إلى الأضياف في ليلة (الضرر)",97,"ر",1,0],["لقد صحبتها عادة الفتك في العدا","كما صَحبَ الإعجامُ لفظة حرف الظا",98,"ظ",2,0],["لقد صدَقتْ فيك الفراسةُ عندما","أرانا أخوك الصبحُ غُرَّتك الغرَّا",99,"ر",2,0],["لقد صهلت فيه الجياد وطنّبت","خيام الندى والباس تحت ظلاله",100,"ل",2,0],["لقد صحَّ عندي بعد نفحة جاحرٍ","وشكَّكتما أنَّ النسيم خؤون",101,"ن",1,0],["لقد صيرتنا للوزير صنائعا","أياد له مشكورة وصنائعُ",102,"ع",1,0],["لقد صاد قلبي حبه بيد الهوى","ولم يجد فيه أنني متحرز",103,"ز",1,0],["لقد صبرت للذل أعواد منبر","تقوم عليها في يديك قضيب",104,"ب",1,1],["لقد صيغ من بيض السبائك طبعه","فحال سبيك الصفر صيغ من الصفر",105,"ر",1,0],["لقد صادف الأمم الفساد الذي سعوا","به والتقوا ما قد خفوه تمكرا",106,"ر",2,0],["لَقَد صبغت أَقواله طرس مَقولي","فَأَشرَق من لالاء آلائه الصبغ",107,"غ",1,0],["لَقَد صرتُ مِن بعدهِ في ضَنى","وَقَلبي لأجلِ الفراقِ اِحتَرق",108,"ق",1,0],["لقد صبرنا كثيراً","وساعدتنا القلوب",109,"ب",1,0],["لقد صلدت قلوبهم","كأن قلوبهم حجر",110,"ر",1,0],["لقد صار في الآفاق أحمد محنة","وأمر الورى فيها فليس بمشكل",111,"ل",1,1],["لقد صدقوا والله فالعقل زائدٌ","وما هو إِلا غصةٌ لأولي الفضل",112,"ل",1,0],["لقد صرعتني خلفةُ الدَّهرِ صَرعةً","تَيَ