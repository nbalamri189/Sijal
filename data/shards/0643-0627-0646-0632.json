{"poems":[[55,"ألوي حيازيمي عليك تحرقا","https://www.aldiwan.net/poem29950.html","الطويل"],[55,"أترى الأحباب مذ ظعنوا","https://www.aldiwan.net/poem30595.html","المديد"],[29,"كأني بالمديبر بين زكا","https://www.aldiwan.net/poem5752.html","الوافر"],[74,"بكى الشعر أيام المنى والمنائح","https://www.aldiwan.net/poem18477.html","الطويل"],[74,"بكيت وما يجدي البكاء على العاني","https://www.aldiwan.net/poem20162.html","الطويل"],[53,"أشد بأيامنا لتشهرها","https://www.aldiwan.net/poem64036.html","المنسرح"],[53,"غدا الدهر مفترا أغر المضاحك","https://www.aldiwan.net/poem65812.html","الطويل"],[16,"أمسى بنو نهشل نيان دونهم","https://www.aldiwan.net/poem27679.html","البسيط"],[93,"يا نفس لو كنت ترين الشؤون","https://www.aldiwan.net/poem8972.html","عموديه"],[93,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[68,"لو أفادتنا العزائم حالا","https://www.aldiwan.net/poem40128.html","المديد"],[68,"لو يرد الردى ببذل الأيادي","https://www.aldiwan.net/poem40136.html","الخفيف"],[82,"أبا هاشم هشمتني الشفار","https://www.aldiwan.net/poem31300.html","المتقارب"],[82,"هذا ابتداء له عند العلى خبر","https://www.aldiwan.net/poem31433.html","البسيط"],[82,"بلى جر أذيال الصبا وتصابى","https://www.aldiwan.net/poem31543.html","الطويل"],[82,"زارت على الخوف من رقيب","https://www.aldiwan.net/poem31574.html","مخلع البسيط"],[8,"ألم تسأل الدار الغداة متى هيا","https://www.aldiwan.net/poem21854.html","الطويل"],[35,"","https://poetry.dctabudhabi.ae/diwan/poem/10841","الطويل"],[102,"قالت الضحيّة","https://www.poetsgate.com/ViewPoem.aspx?id=50170",""],[197,"هل إلى سلوة وصبر سبيل","https://www.aldiwan.net/poem13106.html","الخفيف"],[199,"لمن رسم دار كالكتاب المنمنم","https://www.aldiwan.net/poem54416.html","الطويل"],[207,"ومشفقة تظن بنا الظنونا","https://www.aldiwan.net/poem68147.html","الوافر"],[447,"وداعاً أيها الطهر النبي","https://www.aldiwan.net/poem14344.html","الوافر"],[466,"ولما تراءت كعبة البيت كعبة","https://www.aldiwan.net/poem16377.html","الطويل"],[473,"وراح تتيه بأنفاسها","https://www.aldiwan.net/poem60042.html","المتقارب"],[543,"دعاني من الهم الدفين دعانيا","https://www.aldiwan.net/poem47495.html","عموديه"],[556,"ذكرتك في الخلوات التي","https://www.aldiwan.net/poem47803.html","المتقارب"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2457","الوافر"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/66963","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70872","الوافر"],[1000,"","https://poetry.dctabudhabi.ae/diwan/poem/75755","الطويل"],[1009,"","https://poetry.dctabudhabi.ae/diwan/poem/17640","الطويل"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96568","الطويل"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96561","الوافر"],[1185,"","https://poetry.dctabudhabi.ae/diwan/poem/75731","الطويل"],[1192,"","https://poetry.dctabudhabi.ae/diwan/poem/74132","الطويل"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44823","الطويل"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11223","الطويل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125461","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125365","الخفيف"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46487","الوافر"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123157","البسيط"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48221","الطويل"],[2095,"","https://poetry.dctabudhabi.ae/diwan/poem/131323","الرجز"],[2124,"","https://poetry.dctabudhabi.ae/diwan/poem/45451","البسيط"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89527","الطويل"],[2263,"","https://poetry.dctabudhabi.ae/diwan/poem/140236",""],[2332,"","https://poetry.dctabudhabi.ae/diwan/poem/82213","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75993","الخفيف"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83217","الطويل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140045",""],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132606","البسيط"],[3291,"","https://poetry.dctabudhabi.ae/diwan/poem/106697","الطويل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112623","الرجز"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67980","الطويل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103929","المتقارب"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86510","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141684","الطويل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204186","الوافر"],[5165,"فتى عزلت عنه الفواحش كلها","https://www.poetsgate.com/ViewPoem.aspx?id=52804",""],[5183,"وادي الخيال","https://www.poetsgate.com/ViewPoem.aspx?id=180171",""],[5225,"أمنياتي","https://www.poetsgate.com/ViewPoem.aspx?id=30818",""],[5653,"لَعَلَّكَ بالوادي المُقَدَّسِ شاطىء ُ","https://www.poetsgate.com/ViewPoem.aspx?id=26369",""],[5759,"مُسَهِّدَتي","https://www.poetsgate.com/ViewPoem.aspx?id=213782",""],[6079,"أيُبكيكَ رَسمٌ في الشآم عليلُ","https://www.poetsgate.com/ViewPoem.aspx?id=207850",""]],"verses":[["كَأَنَّ زِماماً ضاعَ مِن أَرحَبِيَّةٍ","تَلَوّى بِأَقوازِ النَقا وَتَعَلَّقا",0,"ق",2,0],["كانَ زوراً بَعدَ بَينِهِمُ","وَغُروراً ذَلِكَ الجَلَدُ",1,"د",1,0],["كَأَنَّ زُهائَهُنَّ مُوَلِّياتٍ","بِذي الحَومانَتَينِ قَطاً يَطيرُ",2,"ر",1,0],["كأن زناد الفضل لم يورِ منهما","سنا شيمٍ ما فيه قولٌ لقادح",3,"ح",1,0],["كأنَّ زماني خاف لحناً فلم يكن","ليجمع بين الساكنين لأوطاني",4,"ن",2,0],["كأن زُرْقَ الدَّبا جوانبها","تاحَ لها تائحٌ فنفَّرها",5,"ر",3,0],["كأنَّ زميرَ القاصياتِ أعارَها","شجاهُ وسجعَ الباكيات الضواحك",6,"ك",1,0],["كَأَنَّ زَيدَ مَناةَ بَعدَهُم غَنَمٌ","صاحَ الرِعاءُ بِها أَن تَهبِطَ القاعا",7,"ع",2,0],["كانَ زَمانٌ كُنتِ تَستَأنِسين","بِكُلِّ وَهمٍ خادِعٍ كَالسَراب",8,"ب",1,0],["كانَ زَمانٌ لَم يَزَل كائِناً","وَحالَةٌ ما بَرَحَت باقِيَه",9,"ه",1,1],["كانَ زِلزالاً لِباغٍ عَصاهُ","وَلِباغِ الرِفدِ مِنهُ زُلالا",10,"ل",2,0],["كانَ زَينَ الأَولادِ وَالمالِ إِن زي","نَ سِواهُ بِالمالِ وَالأَولادِ",11,"د",1,0],["كأنّ زعيم الرّومِ وَيْلٌ لنفسه","أثارَ عليهِ مِنْكَ ليثاً ضُبارما",12,"م",2,0],["كأنّ زُهْرَ الدراري فيه قد نُظِمَتْ","كما تنظّمُ في أسلاكِها الدررُ",13,"ر",1,0],["كأنّ زماناً تائباً من ذنوبهِ","رَأَى عَدلَه أَو خافَ منهُ فَتابا",14,"ب",2,0],["كان زمان اللقاء منها","أقصر من جلسة الخطيبِ",15,"ب",1,0],["كَأَنَّ زَفِيرَ القَومِ مِن خَوفِ شَرِّهِ","وَقَد بَلَغَت مِنهُ النُفُوسُ التَراقِيا",16,"ي",2,0],["كَأَنَّ زِماماً في الفُؤادِ مُعَلَّقاً","تَقودُ بِهُ حَيثُ اِستَمَرَّت فَأَتبَعُ",17,"ع",1,0],["كان زور المديح يحلب كفّيه","ويعطيه وسوسات خطيره",18,"ر",2,0],["كانَ زَينَ النَدى في العِلمِ وال","آدابِ تَرعى رِياضَهُنَّ العُقولُ",19,"ل",1,0],["كَأَنَّ زُرورَ القُبطُرِيَّةِ عُلِّقَت","بَنادِكُها مِنهُ بِجِذعٍ مُقَوَّمِ",20,"م",1,0],["كَأَنَّ زُهاءَها أُحُدٌ إِذا ما","بَدَت أَركانُهُ لِلناظِرينا",21,"ن",2,0],["كأن زناد نار في فؤادي","له لهبٌ وبالأحشا وري",22,"ي",1,0],["كأنَّ زعيمَ الدِّينِ إذْ غابَ عنهُمُ","غَمامٌ تَعدَّى الهامِداتِ مع الهَطْلِ",23,"ل",1,0],["كَأَنَّ زُجاجَتِها دُرَّةٌ","تَشِفُّ عَلى الذَهَبِ الأَحمَرِ",24,"ر",1,0],["كأَنَّ زمَانِي جَاء قُربَه تَائبا","ومُستَغفِرا عمَّا جَنَاه زَمَانيا",25,"ي",2,0],["كأنّ زَماجرَه المصعِقاتِ","ضَجيجُ الفحولِ عَزمن الهديرا",26,"ر",2,0],["كَأَنَّ زُهائَهُ لِلَّهِ حُجٌّ","تَوافى مِنهُمُ بِمِنى حُلولُ",27,"ل",1,0],["كأنَّ زمانِي إذ رآني جُذَيْلَهُ","قلاني فَلِي منه عَدُوٌّ مُمالِئُ",28,"ا",1,0],["كأن زَكِىَّ بَنّتِه","روائح روضةِ الجنه",29,"ن",2,0],["كأن زَماني بالبَديع مولّع","فَما شأنه إِلّا التَقابل وَالقلب",30,"ب",1,0],["كَأَنَّ زِمَامَ المَوتِ في كَفِّ قاسِمٍ","إِذا الخَيلُ جالَت في الوَشيجِ المُقَصَّدِ",31,"د",1,1],["كأَنَّ زكىَّ المِسكِ البانِ ذَافَهُ","بأَعطافِ جَدوى آخر الليلِ ذائفُ",32,"ف",1,0],["كأّنَّ زِمامَهُ يُثنى إِلينا","قناةُ رُدَينَةٍ ذاتُ اعوِجاجِ",33,"ج",1,0],["كأن زَماني يوم ملك سيدي","محاط بأعداء وَقَد طلع الغوث",34,"ث",1,0],["كأَنَّ زَماني فَوقَ ساقى قابِضٌ","ليقصرَ باعي عَن عُلا كُلِّ مَطلَبِ",35,"ب",1,1],["كأَنَّ زَمَانِي حَاسِبٌ مُتَعَسِّفٌ","يُطَارِحُنِي كَسراً وَمَا يُحسِنُ الجَبرَا",36,"ر",2,0],["كَأَنَّ زُرورَ القُبطُرِيَّةِ عُلِّقَت","عَلائِقُها مِنهُ بِجِذعٍ مُقَوَّمِ",37,"م",1,0],["كان زَهرُ الرُّبا وصفوُ الليالي","والنسيمُ العليُ هم ندماني",38,"ن",2,0],["كان زَهرُ الرُّبى وطَيرُ الأراكي","وَنسيمُ الصَّباحِ من نُدمَاني",39,"ن",2,0],["كَأَن زبرجدَ الخَضراء روض","تَفتّح عَن بهارٍ في كِمامِ",40,"م",1,0],["كأن زهرته أمّ الخلول إذا","فلقتها فوق نعناع بصحنون",41,"ن",1,0],["كأنَّ زَواهي وَرْدِها خَدُّ ورْدَةٍ","مَتَى غازلتْهُ الشمسُ بالنُّورِ يُشْرِقِ",42,"ق",1,0],["كأَنَّ زَهْرَ الياسمين إذْ بَدا","لي لونِه وَجْهُ الحبيبِ المُقْمِرِ",43,"ر",1,0],["كَأَنَّ زَهْرَ الخَوْخِ لمَّا أَنْ زهَا","في حُسْنِه نُوْرُ الصَّباحِ المُسْفِرِ",43,"ر",1,0],["كَأَنَّ زُجلَةَ صَوبٍ صابَ مِن بَرَدٍ","شُنَّت شَآبيبهُ مِن رائِحٍ لجبِ",44,"ب",1,0],["كَأَنَّ زِحامَ المُعتَفينَ بِبابِهِ","تَزاحُمُ مَن تَرمي الجِمارَ أَصابِعُه",45,"ع",2,0],["كأن زمان الفضل قال لأهله","سلام عليكم ثم ولى وأدبرا",46,"ر",2,0],["كأن زماناً حله الحي باللوى","لوى ترمذاء لم يكن بزمان",47,"ن",1,0],["كانَ زَرعي ودادُه أَرتَجيهِ","فَإِذا الزَرعُ جاءهُ مِنهُ هَيفُ",48,"ف",1,0],["كَأَنَّ زَماني قَد عَناني بِصَرفِهِ","فَلا نَشَباً أَبقى وَلا جادَني وَفرا",49,"ر",2,0],["كأن زناده مقداح نار","ففي وجه الدجى يرمي شرارا",50,"ر",2,0],["كأن زهر الدراري في الثرى نزلت","ووجهك البدر باهي النور باهره",51,"ر",2,0],["كأنَّ زَمَانِي خافَ لحناً فلم يكُن","ليَجمَعَ بين الساكِنَينِ بأوطَانِ",52,"ن",1,1],["كان زُهيرٌ صاحبَ التوفيقِ","يسايرُ الحسينَ في الطريقِ",53,"ق",1,0],["كَأَنَّ زَفير البحر زَجْراتُ مالكٍ","إذَا سَمَّر النيرانَ أَوْ سِيقتِ الكُفْر",54,"ر",1,0],["كأن زماني عبشمي يخالني","أعنت على عثمان أهل الشيع",55,"ع",1,0],["كإنَّ زَيداً عَالِمٌ بِأنَّى","كُفءٌ وَلَكِنَّ ابنَهُ ذُو ضِغنٍ",56,"ن",1,0],["كأن زفير القوم صار ضبابةً","أناقت على الغبراء الجو أكهب",57,"ب",1,0],["كأنَّ زماني شاء في كل حالة","يراني فرداً يا لشأني من فرد",58,"د",1,0],["كأنّ زمانها نعتاض فيه","إذا طلعت شباباً من مشيب",59,"ب",1,0],["كأن زرزور القبطرية علقت","علائقها منه بجذع مقوم",60,"م",1,0],["كأن زئير الأسد بين شعابه","صواعق رعد مبرق الغيم هتان",61,"ن",1,0],["كان زايدْ لى دعانا في ثباتي","دعوة ٍمن عزمها تحيا القلوب",62,"ب",1,0],["كأنَّ زماني إذ رآني جُذَيْلَهُ","قلاني فَلِي منه عَدُوٌّ مُمالِىء",63,"ا",1,0],["كأنَّ زمانيَ الغدارَ يَلهو","بِنفسي أو يُجاهِدُها جِهادا",64,"د",2,0],["كأنّ زماني لا يُريدُ تصالحًا","ويُعجبهُ أنيْ بكُلّيْ مَلولُ",65,"ل",1,0]]}