{"poems":[[53,"ألوي حيازيمي عليك تحرقا","https://www.aldiwan.net/poem29950.html","الطويل"],[53,"أترى الأحباب مذ ظعنوا","https://www.aldiwan.net/poem30595.html","المديد"],[27,"كأني بالمديبر بين زكا","https://www.aldiwan.net/poem5752.html","الوافر"],[72,"بكى الشعر أيام المنى والمنائح","https://www.aldiwan.net/poem18477.html","الطويل"],[72,"بكيت وما يجدي البكاء على العاني","https://www.aldiwan.net/poem20162.html","الطويل"],[51,"أشد بأيامنا لتشهرها","https://www.aldiwan.net/poem64036.html","المنسرح"],[51,"غدا الدهر مفترا أغر المضاحك","https://www.aldiwan.net/poem65812.html","الطويل"],[16,"أمسى بنو نهشل نيان دونهم","https://www.aldiwan.net/poem27679.html","البسيط"],[91,"يا نفس لو كنت ترين الشؤون","https://www.aldiwan.net/poem8972.html","عموديه"],[91,"كان زمان لم يزل كائنا","https://www.aldiwan.net/poem62821.html","عموديه"],[66,"لو أفادتنا العزائم حالا","https://www.aldiwan.net/poem40128.html","المديد"],[66,"لو يرد الردى ببذل الأيادي","https://www.aldiwan.net/poem40136.html","الخفيف"],[80,"أبا هاشم هشمتني الشفار","https://www.aldiwan.net/poem31300.html","المتقارب"],[80,"هذا ابتداء له عند العلى خبر","https://www.aldiwan.net/poem31433.html","البسيط"],[80,"بلى جر أذيال الصبا وتصابى","https://www.aldiwan.net/poem31543.html","الطويل"],[80,"زارت على الخوف من رقيب","https://www.aldiwan.net/poem31574.html","مخلع البسيط"],[8,"ألم تسأل الدار الغداة متى هيا","https://www.aldiwan.net/poem21854.html","الطويل"],[33,"","https://poetry.dctabudhabi.ae/diwan/poem/10841","الطويل"]],"verses":[["كَأَنَّ زِماماً ضاعَ مِن أَرحَبِيَّةٍ","تَلَوّى بِأَقوازِ النَقا وَتَعَلَّقا",0,"ق",2,0],["كانَ زوراً بَعدَ بَينِهِمُ","وَغُروراً ذَلِكَ الجَلَدُ",1,"د",1,0],["كَأَنَّ زُهائَهُنَّ مُوَلِّياتٍ","بِذي الحَومانَتَينِ قَطاً يَطيرُ",2,"ر",1,0],["كأن زناد الفضل لم يورِ منهما","سنا شيمٍ ما فيه قولٌ لقادح",3,"ح",1,0],["كأنَّ زماني خاف لحناً فلم يكن","ليجمع بين الساكنين لأوطاني",4,"ن",2,0],["كأن زُرْقَ الدَّبا جوانبها","تاحَ لها تائحٌ فنفَّرها",5,"ر",3,0],["كأنَّ زميرَ القاصياتِ أعارَها","شجاهُ وسجعَ الباكيات الضواحك",6,"ك",1,0],["كَأَنَّ زَيدَ مَناةَ بَعدَهُم غَنَمٌ","صاحَ الرِعاءُ بِها أَن تَهبِطَ القاعا",7,"ع",2,0],["كانَ زَمانٌ كُنتِ تَستَأنِسين","بِكُلِّ وَهمٍ خادِعٍ كَالسَراب",8,"ب",1,0],["كانَ زَمانٌ لَم يَزَل كائِناً","وَحالَةٌ ما بَرَحَت باقِيَه",9,"ه",1,1],["كانَ زِلزالاً لِباغٍ عَصاهُ","وَلِباغِ الرِفدِ مِنهُ زُلالا",10,"ل",2,0],["كانَ زَينَ الأَولادِ وَالمالِ إِن زي","نَ سِواهُ بِالمالِ وَالأَولادِ",11,"د",1,0],["كأنّ زعيم الرّومِ وَيْلٌ لنفسه","أثارَ عليهِ مِنْكَ ليثاً ضُبارما",12,"م",2,0],["كأنّ زُهْرَ الدراري فيه قد نُظِمَتْ","كما تنظّمُ في أسلاكِها الدررُ",13,"ر",1,0],["كأنّ زماناً تائباً من ذنوبهِ","رَأَى عَدلَه أَو خافَ منهُ فَتابا",14,"ب",2,0],["كان زمان اللقاء منها","أقصر من جلسة الخطيبِ",15,"ب",1,0],["كَأَنَّ زَفِيرَ القَومِ مِن خَوفِ شَرِّهِ","وَقَد بَلَغَت مِنهُ النُفُوسُ التَراقِيا",16,"ي",2,0],["كَأَنَّ زِماماً في الفُؤادِ مُعَلَّقاً","تَقودُ بِهُ حَيثُ اِستَمَرَّت فَأَتبَعُ",17,"ع",1,0]]}