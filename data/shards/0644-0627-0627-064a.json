{"poems":[[53,"يا خالد ابن الخالدات","https://www.aldiwan.net/poem65801.html","مجزوء الكامل"],[94,"كان الربيع الحي روحا حالما","https://www.aldiwan.net/poem38969.html","الكامل"],[35,"لا أيها البيت الذي لا أزوره","https://www.aldiwan.net/poem26020.html","الطويل"],[147,"هل للخليط المستقل إياب","https://www.aldiwan.net/poem11723.html","الكامل"],[190,"ترك الأنام الموجبات","https://www.aldiwan.net/poem43476.html","مجزوء الكامل"],[435,"هناء لديكم والهناء بكم لنا","https://www.aldiwan.net/poem40500.html","الطويل"],[543,"ما لي أنادي يا عديل فؤادي","https://www.aldiwan.net/poem48211.html","عموديه"],[860,"","https://poetry.dctabudhabi.ae/diwan/poem/144514","السريع"],[2852,"","https://poetry.dctabudhabi.ae/diwan/poem/142919","البسيط"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84475","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100725","البسيط"],[3797,"","https://poetry.dctabudhabi.ae/diwan/poem/103793","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[4737,"متى الذهاب إلى الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=212154",""],[4119,"هي جنة المأوى فهل من خاطب","https://www.poetsgate.com/ViewPoem.aspx?id=16089",""],[5072,"أنا زيد .. // زيد خالد علي","https://www.poetsgate.com/ViewPoem.aspx?id=51800",""],[5329,"أمنيات ...","https://www.poetsgate.com/ViewPoem.aspx?id=215067",""],[5956,"البحر يسليني جدا","https://www.poetsgate.com/ViewPoem.aspx?id=183261",""]],"verses":[["لا أيُّهنَّ وكيف ذا","ك ومِنْ جميع الناس بعضُك",0,"ك",1,0],["لا أين فالشَّرْعُ المقدّسُ ههنا","رأيُ القويِّ وفكرةُ الغَلاّبِ",1,"ب",1,0],["لا أَيُّها البَيتُ الَّذي لا أَزورُهُ","وَهُجرانُهُ مِنّي إِلَيهِ ذُنوبُ",2,"ب",1,1],["لا أَيأَسُ الإِترابَ مُذ نَطَقَت بِهِ","عِندَ المُظَفَّرِ أَنعُمٌ أَترابُ",3,"ب",1,0],["لا أين بل ذهبوا إلى","ظلم الحفائر والجنادل",4,"ل",1,0],["لا أيها المفضال تهنى بخلعة","أتى حسنها بالعز والنصر معلنا",5,"ن",2,0],["لا أيتَم الرحمانُ من مَرآك يَا","أُمَّ العَواصِم أعيُنَ الأولاَدِ",6,"د",1,0],["لا أَيتَم اللهُ العُلا والوَرى","منكَ ووفّاكَ المُنى والأمل",7,"ل",1,0],["لإأين تلك المنى يا ليل هل ذهبت","كيما تعود لنا من بعد إدبار",8,"ر",1,0],["لا أَيُّها الدهر المحقق لي مُنى","قطفنا من الآمال ما بعده جَنى",9,"ن",2,0],["لا أيَّد اللَه أعداءً أذلهمُ","حتى أقاموا بدار الذل والعار",10,"ر",1,0],["لا ايئس الأس هامي السكب مدرارا","فهو الوفي وكل النور غدار",11,"ر",1,1],["لا أياسٌ يطيق دفع كمي","كر يسطو بعون ربٍّ قوي",12,"ي",1,0],["لا \"أينَ\" يأوي قليلاً تحتَ شرفتِها","وغيمةُ العيشِ بالخيباتِ تُمطرُهُ",13,"ر",2,0],["لا أين يا أسرى المهالك بعدها","ضاق الفضاء على نجاة الهارب",14,"ب",1,0],["لا أين َ أعرفُها إذا اسْتَفْهمتُها","أوَ تعرف ُ الأقلام ُ مأساة َ الورقْ",15,"ق",1,0],["لا اين هذا الصبح تهدي شمسه","فلما السماء بما تقول محرقة ؟",16,"ق",2,0],["لا أيأس من عطف تعالى‎","أن يرجع زوجي في حجري‎",17,"ر",2,0]]}