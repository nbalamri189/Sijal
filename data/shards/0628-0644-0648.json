m.aspx?id=63519",""],[5615,"راجي الوصل .....!","https://www.poetsgate.com/ViewPoem.aspx?id=192205",""],[5616,"أغنيةُ صمودٍ للمخيَّمِ الفلسطيني","https://www.poetsgate.com/ViewPoem.aspx?id=205219",""],[2110,"بعثت رسالات الدموع السواكب","https://www.poetsgate.com/ViewPoem.aspx?id=156264",""],[5661,"فديت وجه الأمير من قمرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=181393",""],[5691,"لست مذنباً...!","https://www.poetsgate.com/ViewPoem.aspx?id=206356",""],[5703,"أسطورة حلب","https://www.poetsgate.com/ViewPoem.aspx?id=206281",""],[5956,"المضياف","https://www.poetsgate.com/ViewPoem.aspx?id=194184",""],[5956,"أنا أرتينُ المُشاغِبْ","https://www.poetsgate.com/ViewPoem.aspx?id=205157",""],[5957,"بائية التعب","https://www.poetsgate.com/ViewPoem.aspx?id=184977",""],[5970,"محنة تأتي وأخرى في رواح","https://www.poetsgate.com/ViewPoem.aspx?id=130629",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"],[6242,"لغة الخلود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87552&r=&rc=0",""]],"verses":[["بَلَوتُ خَلائِقَ هَذا الأَنامِ","وَما زِلتُ أَبلو مِراراً وَأُبلى",0,"ل",2,0],["بَلَوتُ وَجَرَّبتُ الأَخِلّاءَ مُدَّةً","فَأَكثَرُ شَيءٍ في الصَديقِ مَلالُ",1,"ل",1,0],["بَلَّ وَجدي وَمَن رَأى اليَومَ قَبلي","نافِعاً لِلغَليلِ مِن غَيرِ شُربِ",2,"ب",1,0],["بَلَونا ما تَجيءُ بِهِ اللَيالي","فَلا صُبحٌ يَدومُ وَلا مَساءُ",3,"ا",2,0],["بَلَوتُكِ بِالهِجرانِ عَمداً وَإِنَّني","عَلى العَهدِ لَم أَنقُض وَلَم أَتَبَدَّلِ",4,"ل",1,0],["بَلَوتُ بَني الدُنيا فَلَم أَرى فيهُمُ","سِوى مَن غَدا وَالبُخلُ مِلءَ إِهابِهِ",5,"ب",2,1],["بَلَوْا خُلُقَ الدّنْيا رخاءً وشدّةً","وجرّبَهُمْ حُلْوُ الزّمانِ ومُرُّهُ",6,"ر",2,0],["بَلَوناهُ وَلُمناهُ فَأَعيا","عَلَينا ما يُمِرُّ لَنا مَريرَه",7,"ر",2,0],["بَلَونا شِدَّةً مِنكُم وَلينا","فَكانَ كِلاهُما ذَرَّ الرَمادِ",8,"د",1,0],["بَلَوهُ فَأَعطَوهُ المَقادَةَ بَعدَما","أَدَبَّ البِلادَ سَهلَها وَجِبالَها",9,"ل",3,0],["بَلَوَاتُ أَلْبَقِ كَاتِبٍ وَمُحَدِّثٍ","صَافِي البَدَاهَةِ بَارعِ التِّبْيَانِ",10,"ن",1,0],["بلوناك في أهل الندى ففضلتهم","وباعك في الأبواعِ قدماً فطالها",11,"ل",3,0],["بلواحظٍ يرفعنَ جفناً كاسِراً","فتثيرُ في الأحشاءِ همًّا ناصِبا",12,"ب",2,0],["بَلَونا منك كوفياً","لئيم الأصل والمَجنْى",13,"ن",2,0],["بلوتُهُ أكذبَ مِن يَلْمَعٍ","أو بارقٍ يلمع في خُلَّبِ",14,"ب",1,0],["بَلوتُ عليّاً فألفيتُهُ","وَفِيّاً وألفيتُ قوماً نُكُثْ",15,"ث",1,1],["بلوْتُ طُعُوم الناس حتى لو اَنَّني","وجدتُهُمُ أحْلَى مذاقاً من الشَّهدِ",16,"د",1,1],["بلوتُ سجاياه في النائباتِ","فلم أبْلُ منهن إلا حميدا",17,"د",2,0],["بلوتَ فألفيتني صابراً","فعُد بالثواب على شاكر",18,"ر",1,0],["بل وجدناك لا مريغاً جزاءً","بل إلى البذل لا سواه تؤوقا",19,"ق",2,0],["بل واسعاً لا كرزق","يدعوه داع رُزَيقا",20,"ق",2,0],["بل وعيدُ الذي زهتْك به نف","سُكَ حتى أهديْتَ لي تهديدَك",21,"ك",1,0],["بل وكفتْك وحشتُنا جميعاً","إذا بكرتْ لطِيَّتها جمالي",22,"ل",2,0],["بلْوى اختبارٍ وليستْ","حاشاك بلوى انتقامِ",23,"م",1,0],["بَلَوتُهُ وَهوَ مُشتَدُّ القِوى أَسَداً","صَعبِ المِراسِ وَعِندَ الضَعفِ ثُعبانا",24,"ن",2,0],["بلوت في الجاه قوما والغنى نفرا","فما تهيبت كالأخلاق في الرجل",25,"ل",1,0],["بلوت الناس خدنا بعد خدن","فما للمرء غير النفس خل",26,"ل",1,0],["بل والمقام والحطيم","والحجيج الأعظم",27,"م",1,0],["بِلَوحٍ جامِعِ الصُّوَرِ الغَوالي","وَديوانٍ تَفَرَّدَ بِالخَيالِ",28,"ل",1,0],["بَلَوناكَ يَقظانَ الصَوارِمِ وَالقَنا","إِذا ضَيَّعَ الصيدَ المُلوكَ سُباتُ",29,"ت",1,0],["بَلَوتُهُم فَتَحَدَّث كَم شَدَدتَ بِهِم","مِن مُضمَحِلٍّ وَكَم عَمَّرتَ مِن خُرَبِ",30,"ب",1,0],["بَلَونا ضَرائِبَ مَن قَد نَرى","فَما إِن رَأَينا لِفَتحٍ قَريبا",31,"ب",2,0],["بَلَونا حالَتَيهِ فَما نُبالي","ضَرَبتَ بِذي الفَقارِ أَوِ الرَسوبِ",32,"ب",1,0],["بَلَوتُ الحُبَّ مَوصولاً وَصولاً","وَمَهجوراً أُثابُ سِوى ثَوابي",33,"ي",1,1],["بَلَوتَ أَبا أَحمَدٍ مَرَّةً","فَأَلفَيتُ مِنهُ بَخيلاً سَخيفا",34,"ف",2,1],["بَلوفُ السُيوفَ بِالخُدودِ إِذا اِنحَنى","مِنَ الطَعنِ فيهِم كُلُّ أَسمَرَ ذابِلِ",35,"ل",1,0],["بَلَوتُ مِنَ الدَهرِ الَّذي فيهِ واعِظٌ","وَجارَيتُ بِالنُعمى وَطالَبتُ بِالتَبلِ",36,"ل",1,0],["بَلَوْناهُ أجَلَّ الأزدِ قَدْراً","واسطاها على الحَدَثِ الجَليلِ",37,"ل",1,0],["بَلَوتُ الناسَ قِرناً بَعد قَرنٍ","وَلَم أَرَ مِثلَ مُحتالٍ بِمالِ",38,"ل",1,0],["بَلَوتُ صُروفَ الدَهرِ سِتينَ حُجَّةً","وَجَرَّبتُ حالَيهِ مِنَ العُسرِ وَاليُسرِ",39,"ر",1,1],["بَلَوتُ رِجالاً بَعدَهُ في إِخائِهِم","فَما ازدَدتُ إِلّا رَغبَةً في إِخائِهِ",40,"ا",3,0],["بَلَوتُ إِخاءَ الناسِ يا عَمرُ كُلِّهِم","وَجَرَّبتُ حَتّى أَحكَمَتني تَجارِبي",41,"ي",1,1],["بَلَوناكَ أَمّا كَعبُ عِرضِكَ في العُلى","فَعالٍ وَلَكِن خَدُّ مالِكَ أَسفَلُ",42,"ل",1,0],["بَلَوناهُ فيها ماجِداً ذا حَفيظَةٍ","وَما كانَ رَيبُ الدَهرِ فيها بِماجِدِ",43,"د",1,0],["بَلَوتُ مِنكَ وَأَيّامي مُذَمَّمَةٌ","مَوَدَّةً وُجِدَت أَحلى مِنَ النَشَبِ",44,"ب",1,0],["بَلَوْتُ النَّاسَ وَاسْتَخْبَرْتُ عَنْهُمْ","صُرُوفَ الدَّهْرِ آناً بَعْدَ آنِ",45,"ن",1,0],["بَلَوْتُ مِنْهُمْ خِلالاً لَوْ وَسَمْتَ بِهَا","وَجْهَ الْغَزَالَةٍ لَمْ تُشْرِقْ عَلَى عَلَمِ",46,"م",1,0],["بَلَوْتُ لَهُ طَعْمَيْنِ أَمَّا مَذَاقُهُ","فَعَذْبٌ وَأَمَّا سُؤْرُهُ فَوَخِيمُ",47,"م",1,0],["بَلَوتُ الأُمورَ وَكُنتُ اِمرَأً","ذَكِيَّ الجنانِ كَبيرَ الحَصاةِ",48,"ه",1,0],["بَلَوتُ المُدَّعينَ بَلاءَ صِدقٍ","فَلا أَدَباً وَجَدتُ وَلا خَلاقا",49,"ق",2,0],["بلوى ذوي الأسقامِ أكثرها أذىً","بَلْوَى أخي عقلٍ تراه سقيما",50,"م",2,0],["بَلوى عَلى القَلبِ المُعَذَّبِ جَرَّها","لَحظي الظَلومُ وَلَحظُ موسى وَالقَضا",51,"ض",2,0],["بِلَواحِقٍ مَملوءَةٍ","ماءً وَزاداً عُرِّفا",52,"ف",2,0],["بَلَوتُ أَخِلّاءَ هَذا الزَمانِ","فَأَقلَلتُ بِالهَجرِ مِنهُم نَصيبي",53,"ي",1,1],["بَل وَجهُ عَبّاسٍ لَهُ حُسنُهُ","لِأَنَّهُ دُرٌّ وَياقوتُ",54,"ت",1,0],["بِلَونٍ رَقَّ حَتّى كادَ يَخفى","عَلى عَيني وَطابَ عَلى المَذاقِ",55,"ق",1,0],["بَلَوتُ بَني زَيدٍ فَما في كِبارِهِم","حُلومٌ ولا في الأَصغَرينَ مُطَهَّرُ",56,"ر",1,0],["بَلَوتُ اِبنَ نِهيا فَما عِندَهُ","سِوى أَن سَيَأكُلُ أَو يَسلَحُ",57,"ح",1,0],["بَل وَجهُ نُعمٍ بَدا وَاللَيلُ مُعتَكِرٌ","فَلاحَ مِن بَينِ أَثوابٍ وَأَستارِ",58,"ر",1,0],["بَلَوتُ مِن هَذِهِ الدُنيا وَساكِنِها","عَجائِباً وَاِنتِهاءُ الثَوبِ تَقديدُ",59,"د",1,1],["بَلَوتُ أُمورَ الناسِ مِن عَهدِ آدَمٍ","فَلَم أَرَ إِلّا هالِكاً إِثرَ هالِكِ",60,"ك",1,0],["بَلَوْتُ دَهْرِي فَمَا أَحْمَدْتُ سِيرَتَهُ","فِي سَابِقٍ مِنْ لَيَالِيهِ وَلا تَالِي",61,"ل",2,0],["بَلَوْتُ بَنِي الدُّنْيَا فَلَمْ أَرَ صَادِقَاً","فَأَيْنَ لَعَمْرِي الأَكْرَمُونَ الأَصَادِقُ",62,"ق",1,0],["بَلَوْتُ بَنِي الدُّنْيَا فَلَمْ أَرَ صَاحِبَاً","يَدُومُ عَلَى وُدٍّ بِغَيْرِ تَكَلُّفِ",63,"ف",1,0],["بَلَوْتُهُمْ فَسَئِمْتُ الْعَيْشَ وَانْصَرَفَتْ","نَفْسِي عَنِ النَّاسِ حَتَّى لَيْسَ لِي شَجَنُ",64,"ن",1,0],["بَلَوْتُ الْهَوَى حَتَّى اعْتَرَفْتُ بِكُلِّ مَا","جَهِلْتُ فَلا يَغْرُرْكَ فالصَّابُ شَهْدُهُ",65,"د",2,0],["بَلَوْتُ ضُرُوبَ النَّاسِ طُرّاً فَلَمْ يَكُنْ","سِوَى الْمَرْصَفِيِّ الْحَبْرِ فِي النَّاسِ كَامِلُ",66,"ل",1,0],["بَلَوْتُ إِخَاءَ النَّاسِ دَهْرَاً فَلَمْ أَجِدْ","أَخَا ثِقَةٍ يَرْعَى مَغِيبِي كَمَحْضَرِي",67,"ي",1,1],["بَلَوْتُ سَرائِرَ الإِخْوَانِ حَتَّى","رَأَيْتُ عَدُوَّ نَفْسِي مِنْ حَبِيبِي",68,"ي",1,1],["بَلْ وَجْهُهَا الصُّبْحُ يَبْدُو","تَحْتَ الظَّلاَمِ الدَّاجِي",69,"ج",2,0],["بَلوا مِنْهُ جَواراً أَرْيِحِيّاً","بِلا دَخَلٍ يَريبُ وَلا الْتِوَاءِ",70,"ا",2,0],["بَلَوْنَاك في كل خَطْب؛ فكنتَ","ذكيَّ القريحة، وَقَّادها",71,"د",3,0],["بلوتك يا مخبئة الدواهي","فكنت السم في الماء المعين",72,"ن",1,0],["بلّ وجدي ومن راى اليوم قبلي","ناقعاً للغليل من غير شر",73,"ر",1,0],["بلواك يابن الشعر فجر شاعر","يهدي إليك الوحي والإلهاما",74,"م",2,0],["بل ولولا أن غوركي أمه","مثلُ هذي لم يُبزَّ النبغاء",75,"ا",2,0],["بلوى الشعوب مخادعون إذا ادَّعوا","للنصح كذَّبتِ الفِعالُ المنطقا",76,"ق",2,0],["بلوت بني الدنيا فلم أر فيهم","سوى من غدا والبخل ملء إهابه",77,"ب",2,1],["بَلَوْنَا صَرَائبَ مَنْ قَدْ نَرَى،","فَمَا إنْ رَأيْنَا لفَتْحٍ ضَرِيبَا",78,"ب",2,0],["بلوتُ له خلائقَ ليس فيها","سوى ما سامني خلالٌ يُسَدُّ",79,"د",1,0],["بلوح سري لم يزل","منطبعا تمثاله",80,"ل",2,0],["بل وعيني لاجل عينك تقطر","كيف اسلو ومهجتي لك تسعر",81,"ر",1,0],["بَلَوتُ الهَوى قَبلَ الهوى فَوجَدتُهُ","إسَاراً بلا فَكٍّ سَقَاماً 