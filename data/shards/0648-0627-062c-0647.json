{"poems":[[55,"أغار على ثراك من الرياح","https://www.aldiwan.net/poem30656.html","الوافر"],[55,"طلوع هداه إلينا المغيب","https://www.aldiwan.net/poem30758.html","المتقارب"],[90,"مرت تقول ألا يا رب خذ روحي","https://www.aldiwan.net/poem44460.html","البسيط"],[39,"ألا لا أرى الأيام يقضى عجيبها","https://www.aldiwan.net/poem6494.html","الطويل"],[31,"عفا دير لبى من أميمة فالحضر","https://www.aldiwan.net/poem6041.html","الطويل"],[80,"أرية أنت فائدة الزمان","https://www.aldiwan.net/poem14271.html","الوافر"],[91,"أحس لو ينفعني حسي","https://www.aldiwan.net/poem44856.html","السريع"],[60,"أحسين إني واعظ ومؤدب","https://www.aldiwan.net/poem31150.html","الكامل"],[71,"ألا يا نفس لا تعصي","https://www.aldiwan.net/poem28715.html","مجزوء الوافر"],[35,"وأجهشت للتوباد حين رأيته","https://www.aldiwan.net/poem25776.html","الطويل"],[52,"طرب الحمام فهاج لي طربا","https://www.aldiwan.net/poem64861.html","الكامل"],[48,"أنا بالليالي والحواده أخبر","https://www.aldiwan.net/poem22560.html","الكامل"],[48,"تداولني صبح ومسي وحندس","https://www.aldiwan.net/poem22778.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85367","الرجز"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9964","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54713","المجتث"],[108,"تأميم القناة","https://www.poetsgate.com/ViewPoem.aspx?id=179582",""],[92,"لبنان في العراق","https://www.poetsgate.com/ViewPoem.aspx?id=178952",""],[164,"أتاكم من يسترد الغصبا","https://www.aldiwan.net/poem58809.html","الرجز"],[164,"وفقت زادك رب العرش توفيقا","https://www.aldiwan.net/poem59189.html","الوافر"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[333,"ألقت عليك الليالي ثوبها البالي","https://www.aldiwan.net/poem55038.html","البسيط"],[354,"بدت لعيني بالستور والكلل","https://www.aldiwan.net/poem15861.html","الرجز"],[358,"زن بالفضائل مجد جدك","https://www.aldiwan.net/poem40385.html","مجزوء الكامل"],[445,"نعم يبشر بدؤها بتمام","https://www.aldiwan.net/poem34866.html","الكامل"],[463,"هون في الليل عليها الغررا","https://www.aldiwan.net/poem56183.html","الرجز"],[463,"أهفو لعلوي الرياح إذا جرت","https://www.aldiwan.net/poem56260.html","الطويل"],[469,"أهلك والليل منضيا جملك","https://www.aldiwan.net/poem3286.html","عموديه"],[484,"يا أمة شهد الكتاب بفضلها","https://www.aldiwan.net/poem37623.html","الكامل"],[487,"فيا رب هذا الدهر قد جار حكمه","https://www.aldiwan.net/poem24499.html","عموديه"],[487,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[505,"دع طيش نفسك لا تسمع دعاويها","https://www.aldiwan.net/poem37716.html","البسيط"],[505,"كتب الظلام على الوجود سطورا","https://www.aldiwan.net/poem38003.html","مجزوء الكامل"],[510,"بيان","https://www.aldiwan.net/poem42464.html","الهزج"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48817","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70681","البسيط"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67846","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64793","الكامل"],[1366,"","https://poetry.dctabudhabi.ae/diwan/poem/85000","الرجز"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141247","الكامل"],[1936,"","https://poetry.dctabudhabi.ae/diwan/poem/105195","الكامل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104785","الطويل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110319","البسيط"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89519","البسيط"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89552","الطويل"],[2182,"","https://poetry.dctabudhabi.ae/diwan/poem/203904","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109470","الكامل"],[2271,"","https://poetry.dctabudhabi.ae/diwan/poem/216324","الوافر"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126191","الرجز"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93540","الكامل"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111264","الكامل"],[2697,"","https://poetry.dctabudhabi.ae/diwan/poem/107183","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93824","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201245","الطويل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112615","الرجز"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97875","الكامل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68096","الكامل"],[3437,"","https://poetry.dctabudhabi.ae/diwan/poem/102028","البسيط"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99314","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88987","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89232","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74072","المتقارب"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62851","الوافر"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109925","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91200","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102963","الكامل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76446","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111507","الكامل"],[4375,"","https://poetry.dctabudhabi.ae/diwan/poem/107146","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133071","الرجز"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133165","البسيط"],[4767,"مهر القريض","https://www.poetsgate.com/ViewPoem.aspx?id=194941",""],[4814,"عيناك","https://www.poetsgate.com/ViewPoem.aspx?id=192764",""],[4814,"ضربٌ مِن الأشجان","https://www.poetsgate.com/ViewPoem.aspx?id=193627",""],[4856,"وحدي أعاني","https://www.poetsgate.com/ViewPoem.aspx?id=36272",""],[4926,"وحَّد إلهك لا تشرك به أحداً","https://www.poetsgate.com/ViewPoem.aspx?id=171101",""],[5011,"سر حبي","https://www.poetsgate.com/ViewPoem.aspx?id=197862",""],[5092,"تحت ظلال الحلم","https://www.poetsgate.com/ViewPoem.aspx?id=180066",""],[3591,"تقرب كل للكريم أخي الجدا","https://www.poetsgate.com/ViewPoem.aspx?id=149402",""],[5183,"وادي الخيال","https://www.poetsgate.com/ViewPoem.aspx?id=180171",""],[5219,"حديث الروح","https://www.poetsgate.com/ViewPoem.aspx?id=195009",""],[5219,"منة الرحمن في بردة النبي العدنان","https://www.poetsgate.com/ViewPoem.aspx?id=195106",""],[5239,"لئن كان حمل الفقه ذنباً فإنني","https://www.poetsgate.com/ViewPoem.aspx?id=190939",""],[5273,"أمي","https://www.poetsgate.com/ViewPoem.aspx?id=162119",""],[5277,"مخلب القِط","https://www.poetsgate.com/ViewPoem.aspx?id=197299",""],[5442,"اعمل حساب النفس عن هفواتها","https://www.poetsgate.com/ViewPoem.aspx?id=114757",""],[5542,"لغة الحجارة","https://www.poetsgate.com/ViewPoem.aspx?id=10192",""],[5542,"آآآه يا إيمان","https://www.poetsgate.com/ViewPoem.aspx?id=10049",""],[5544,"إلى المتفانين من أجلنا","https://www.poetsgate.com/ViewPoem.aspx?id=213440",""],[5605,"مرثية حلب","https://www.poetsgate.com/ViewPoem.aspx?id=177655",""],[5667,"الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=214940",""],[5776,"(أُتْسُوعةُ الهلاك )","https://www.poetsgate.com/ViewPoem.aspx?id=205841",""],[5783,"دفاع عن شرف القبيلة","https://www.poetsgate.com/ViewPoem.aspx?id=36934",""],[5809,"أسف","https://www.poetsgate.com/ViewPoem.aspx?id=205397",""],[5956,"بوساطة محمد عصفور","https://www.poetsgate.com/ViewPoem.aspx?id=205162",""],[5309,"وغانية اخفى الجمال خصالها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573546",""],[5309,"تركت دنياك لم تحفل ببهجتها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573875",""],[5309,"كفاك بحثا فللموضوع عنوان","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573897",""],[5309,"لا خير في بلد عم الثراء به","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573561",""],[463,"أهفو لعلويَّ الرياح إذا جرتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59997&r=&rc=53",""]],"verses":[["وَأَجهَرُ بِالسَلامِ وَدونَ صَوتي","مَنيعٌ لا يُجاعِزُ بِالصِياحِ",0,"ح",1,0],["وَأَجهَلُ ذا الناسِ مُستَنهِضٌ","دُعاءً إِلى سَمعِ مَن لا يُجيبُ",1,"ب",1,0],["وأجهشت ثم أرخت من محاجرها","عِنان دمع على الخدَّين منضوح",2,"ح",1,0],["وأجهلُ جهل القوم ما في عدوهم","واقبحُ أخلاق الرجال عزيبها",3,"ب",3,0],["وَأَجهَضنَ إِلّا أَنَّ كُلَّ نَجيبَةٍ","أَتى دونَ ماءِ الفَحلِ مِن رِحمِها سِترُ",4,"ر",1,0],["وَأَجهَدنا العَزائِمَ وَالمَساعي","وَأَعملَنا الحُسامَ مَعَ السِنانِ",5,"ن",1,0],["واجهزوا على عقول سمت","طمساً لها والموت في الطمس",6,"س",1,0],["وَاِجهَد لَعَلَّكَ أَن تَحِلَّ بِأَرضِها","وَتَنالَ روحَ مَساكِنَ لا تَخرَبُ",7,"ب",1,0],["وأجهدُ في رضى ربي","وأستبري وأستقصي",8,"ص",2,0],["وَأَجهَشتُ لِلتوبادِ حينَ رَأَيتُهُ","وَهَلَّلَ لِلرَحمَنِ حينَ رَآني",9,"ن",2,1],["وَاِجهَد يَمينَكَ لا تُخالِفني","فيما هَويتُ وَكانَ لي أَرَبا",10,"ب",2,0],["واجَهتَ قُبَّرَةً فَخِفتَ تَطَيُّراً","ما كُلُّ مَيتٍ لا أَبا لَكَ يُقبَرُ",11,"ر",1,0],["وَأَجهَرُ حياً ثُمَّ أَهمُسُ تارَةً","وَسِيّانِ عِندَ الواحِدِ الجَهرُ وَالهَمسُ",12,"س",1,0],["واجهد فَما فازَ سِوى","ذاكَ الَّذي قد جهدا",13,"د",2,0],["وَاِجهَدي في عَداوَتي وَعِنادي","أَنتِ وَاللَهِ لَم تُلِمّي بِبالي",14,"ل",2,0],["وَأَجْهَدُوا الفِكْرَ وَثْباً","إِلَيْهِمُ فِي الْبِلاَدِ",15,"د",1,0],["واجَهَ الموتَ؛ فلم يحفِلْ: ومن","واجَهَ الموتَ يواجهْ ما عداهْ",16,"ا",2,0],["وأجهز بحد رهيف حدٍ لمَ ينُبْ","لك عن شَباه مهند وسنان",17,"ن",1,0],["وأجهل الناس ضعيف عاجز","شن على جَلد قوى حربا",18,"ب",2,0],["واجهته وإذا بالطفل ليث شرى","بالسيف يوسع رأ س القرن تغليقا",19,"ق",2,0],["وَأجهلُ خلقِ اللَّه من قال إنّها","بإِشراقها ساوَت معَ الحجرِ الدرّا",20,"ر",2,0],["وأجهش الناي في كفيه مرتعشا","ولم يرو البكا ما فيه من ضرم",21,"م",1,0],["وَاِجهَد عَلى مَرضاتِها النَفسَ وَكُن","مُجاهِداً بِالسَيفِ فيها مِن عَدَل",22,"ل",1,0],["وَاِجهد نهاك بِبَذل عل","مك وَاِمزج التَقوى بِجهدك",23,"ك",1,0],["وأُجَهِّزَ الرُّكْبانَ طَيِّبَ ذِكْرِهِ","زاداً إِلَى الإِنْجادِ والإِتهَامِ",24,"م",1,0],["واجَهَ بالعصيان فيَّ أمرَكم","والدهرُ لا يَعصيكُمُ لو أُمِرا",25,"ر",2,0],["واجهَر بصوتك للتي لو خاطبتْ","في السرّ أوعالَ القِنانِ لأسمعتْ",26,"ت",1,0],["وأجهد فإن أخفقت ولا عجبٌ","واقنع يقرصيك واشتمل سملك",27,"ك",1,0],["واجهر بما سمح الزمان بجهره","واسلك بنهضتهم سبيل سياسي",28,"س",2,0],["وأجهدنا أهل الزمان بكيدهم","فأبكهم من حيث كان بكائيا",29,"ي",2,0],["وأجهدك اللوام نحو هواجر","فلم يرتوي بالفيضيات اللدنيه",30,"ي",2,0],["واجهد لتلحق ركبان الرجال إذا","ما سار في شطحات الليل ساريها",31,"ي",3,0],["واجْهَدْ فإنْ ما مُتَّ في طُرُقِ الهَوَى","قدْ متَّ مَعْذوراً بها مأجُورَا",32,"ر",2,0],["وأجْهِدَتْ مواشينا","وصارَ نبْعُنا طِينا",33,"ن",2,0],["واجهروا باليقين فيما شهدتم","ليس حقُّ المصيرِ سراً ونجوى",34,"و",2,0],["وأجهل الناس من ضَلَّتْ بصيرتُه","ومن تبدَّل ممقوتاً بمودود",35,"د",1,0],["وَأَجْهَدْتُ نَفْسِي كَيْ تَرَى الْفَوْزَ فِي غَدِ","لِمَا نَالَ قَلْبي مِنْ جَوًى مُتَصَعِّدِ",36,"د",1,0],["واجَهْتُ وَجْهَ أَغرَّ أَزْهَرَ كلُّ مَنْ","أَسْرَى فأَصْبحَ عِندَهُ حَمْدُ السُّرَى",37,"ر",2,0],["وَأجهَشَت نَفسِي وغَاضَت شِرَّتِي","وَنَغضَت سِنِّي وَخَارَت مُنَّتِي",38,"ي",1,0],["واجهد فجهد المرء يكسبه","فخراً إلى أوج العلى يصل",39,"ل",1,0],["واجهد بكسب العلم نفسك قاصداً","وجه الإله لتدرك المقصودا",40,"د",2,0],["وَأجهَرُ بالتَّكبيرِ وَالحَمدِ وَالدُّعا","أَقُولُهُما قَولاً بِغَايَةِ غَفلَتى",41,"ت",2,0],["واجه سماءك وانظر أيها الساري","هل في سمائك نجمٌ غير سيارِ",42,"ر",1,1],["وَأَجهَلُ الناسِ مَن لَم يَدرِ قيمَتَهُ","أَو غَرَّهُ إِن خَلا المَيدانُ إِحضارُ",43,"ر",1,0],["وَأَجهدُ يومَ البَينِ أَن يَظهَرَ الهَوى","وَقد أَعلَنَتهُ الساجِماتُ الذَوارِفُ",44,"ف",1,0],["وأجهد أن أشكو إليه صبابتي","فيمنعني من ذاك فرط حيائي",45,"ا",3,0],["واجهد بنفسك ان تكون مقدَّماً","وانفع سواك مقرَّباً أو مُبعدا",46,"د",2,0],["وأجهد في البيان بقدر وسعي","وتخليص العقول من العقال",47,"ل",1,0],["واجَههُ مُستَغرقاً سَناها","مُستَولِياً على ضيا مَداها",48,"ه",2,0],["وَاجهر بحيّ عَلى الصَلاة تَرح لَهُ","بَدَنا بِطاعة رَبه مَتعوبا",49,"ب",2,0],["واجهد لتحصيل العلوم بفرصة","يتأسف الإنسان عند ضياعها",50,"ع",3,0],["وَاجهَر إِذا لَقِيتَ بالسَلامِ","بِذاكَ وَصَّى سَيِّدُ الأَنامِ",51,"م",1,0],["واجهد ففي نشر الخطا","طي الفيافي في والموامي",52,"م",2,0],["وأجهدها العبء الثقيل فمثّلتْ","لعيني أطفالاً محدّبة الظهر",53,"ر",1,0],["واجهَد بأن يسلَم منكَ العمل","من الرياء فالرياءُ مبطل",54,"ل",1,0],["وأجهد لفرضك أده","ثم اجتهد في النافله",55,"ل",2,0],["واجهد إِلَى عملٍ تكون إِذَا بكوا","في يوم موتِك ضاحكاً مسرورا",56,"ا",1,0],["واجهد النفس في كسب الكمال ولم","يعرف بنيل المعالي لذة الحلم",57,"م",1,0],["واجهر إذا أنشدتها في محفل","فعثرت بين عيوبها بصواب",58,"ب",1,0],["وأجهدني في سيره الدهر فاغتدت","مطايا المنايا للأماني مراكبا",59,"ب",2,0],["وأجهد في نزع الحطام نفائساً","ونفسيَ من بعد التنازع تنزع",60,"ع",1,0],["وأجهدت نفسك كي تَستَريح","سواك وَتَنجو بك الناجيَه",61,"ي",2,0],["وأَجهدُ في الولاءِ وليتَ أَنَّى","اذا بالغتُ أَقنعُ باجتهَادِي",62,"د",2,0],["وأَجهَدتُ نفسي في استِتارِ مَصابها","مَخافةَ أَن تَسطُو عليَّ المفاضحُ",63,"ح",1,0],["وَاجهتَها وَهِيَ الحسام المنتَضى","وَلزمتها وَهِيَ الأَساس المحكم",64,"م",1,0],["واجهد إليه فما بذلك ذلة","فالشيء لا يأتي بغير جهاد",65,"د",1,0],["واجهدي يا شمس ألا تطلعي","ان تكن منه تَراكيب اللعاب",66,"ب",1,0],["واجهله قد فاته حمقاً","أن ابن فيلا قط ما رحما",67,"م",2,0],["واجهد وبالغ في مهاجرتي","واجهر بها في السر والنجوى",68,"و",2,0],["واجهد هديت في حصول زادك","من هذه الدنيا إلى معادك",69,"ك",1,0],["واجهد بصدقٍ وتب واعمل لآخرةٍ","فيها ترى كل نفسٍ كل ما كسبت",70,"ت",1,0],["واجهر بما يشفي الغليلَ سماعُهُ","ما شئتَ واصعد بالقصيدةِ منبرا",71,"ر",2,0],["واجهتُ في عصيانها رأفةً","فيها حنانٌ بالهوى مفعمُ",72,"م",1,0],["واجهتُ جورَ نهايتي ببدايةٍ","بكماءَ لمْ تتقنْ سوى الإذعانِ",73,"ن",1,0],["وأَجهَزتَ أَنتَ على ما تَبقَّى","مِنَ الحُبِّ في ليلةٍ مِنكَ أَصعَبْ",74,"ب",1,0],["وأجهل الخلق من رام السُّكون بها","يودُّ من فرط جهلٍ لو بها خلدا",75,"د",2,0],["واجهتنا خلف بعد العصر والحاسد خلف","والهوى يجري حوالينا يلف الموج لف",76,"ف",1,0],["وأجهلُ زيفًا بألقابِ وُدٍّ","لأبقى مع الحبِّ حرفًا سميّا",77,"ي",2,0],["واجهل خلق اللَّه زاهٍ بأصله","وأعقلهم من بالفعل تمجدا",78,"د",2,0],["وأجهدت نفسي فيهم غير ضارع","لنكبة دهر ذي طموح لبطلان",79,"ن",1,0],["واجهد لشهوتها ترتاح زلتها","وابذل لطاعتها حينا وأحيانا",80,"ن",2,0],["وَأَجْهَشَتْ بِدُمُوعِ الْعَيْنِ مُقْلَتُهَا","بِدَمْعَةٍ مِنْ غَزِيرِ الدَّمْعِ مُنْسَجِمِ",81,"م",1,0],["وأجهر من أمر الصلاة ولم تكن","لتجهر في فرض هناك ولا ندب",82,"ب",1,0],["وأجْهَلُ كُنْهَ سِرِّكِ حينَ أبكي","وأضحَكُ حينَ يُفْشي السِّرَ عِلْمي",83,"م",2,0],["وأجهشتْ رملةٌ شاهتْ ملامحُها","قد صادفتْ موجةً فرّتْ من الشطِّ",84,"ط",1,0],["واجهد لنفسك في الخلاص بكفها","عن غيها والصد عن شهواتها",85,"ت",3,0],["واجهت يا أبتي الخطوب وعدتي","قلب عصاميّ وحسٌ مرهف",86,"ف",1,0],["واجهوا الحرب كما واجهَها","ابنُ عفراءَ، وسعدُ بن الرَّبيعْ",87,"ع",1,0],["واجهت طوفان الردى كسفينة","صنعت لتقهر كل موج عات",88,"ت",1,0],["وَأَجهَشَتْ ثُمَّ قَالَت وَهْيَ بَاكِيَّةٌ :","في جِيدِ قَاتِلِهِمْ حَبْلٌ مِنَ المَسَدِ",89,"د",1,0],["وأجهشتُ فانهلَّتْ سحاباً مدامعي","وقطَّعَ قلبي صوتُ طفلِكَ مثُجِما",90,"م",2,0],["وَأَجْهِزْ على رأسِهمْ","وفي الذيلِ خبثٌ كُبِتْ",91,"ت",1,0],["واجهتهم بسلاح الحب..أمنحهم","من خافقي الحرٍ.. مالا تمنح الديم",92,"م",1,0],["وأجهلُ مايكونُ المرءُ عقلاً","اذا ظنَّ الجهالةَ بالأريبِ",93,"ب",1,0],["وأجهل عنه تماما أجبني","فهل بينكم داسِسٌ مارقُ؟",94,"ق",1,0],["وَأَجهَلُ خَلقِ اللهِ يَمنَحُ قَلبَهُ","لِيَهزَاَ مِنهُ مَن بِإخلاصِهِ لَها",95,"ل",3,0],["وَأَجهَلُ الخَلقِ مَن عاداكَ مُتَّبِعاً","ضَلالَةَ النَّفسِ في إِبّانِ ثَورَتِها",96,"ت",3,0],["وَأَجهَلُ النّاسِ قَومٌ سَيَّروا قِصصاً","وَهمِيَّةً ما لَها أصلٌ وَبُرهانُ",97,"ن",1,0],["وَأَجهَلُ النّاسِ مَن يَدعو شَهادَتَهُ","لِنَصرِهِ وَهو في الإنتاجِ كَالعَدَم",98,"م",1,0],["واجهر بصوتك التي لو خاطبتْ","في السرّ أو عالَ القنانِ لأسمعتْ",99,"ت",1,0]]}