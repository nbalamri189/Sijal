الخفيف"],[498,"برق نعمان على الهائم طل","https://www.aldiwan.net/poem37699.html","الرمل"],[498,"يا آلهي بدولة الأسماء","https://www.aldiwan.net/poem37720.html","الخفيف"],[498,"تحت سبر المرفرف الأزلي","https://www.aldiwan.net/poem37723.html","الخفيف"],[498,"أطلع الحسن من سناك هلالا","https://www.aldiwan.net/poem37730.html","الخفيف"],[498,"كيف لا أندب الطلول غراما","https://www.aldiwan.net/poem37782.html","الخفيف"],[498,"قد تداعت من الأقاح خيوط","https://www.aldiwan.net/poem37784.html","الخفيف"],[498,"طرق السر من البرهان ما","https://www.aldiwan.net/poem37802.html","الرمل"],[498,"رقرق الكأس حبيبي","https://www.aldiwan.net/poem37975.html","مجزوء الرمل"],[512,"خطرت فمال الغصن وهو ممنطق","https://www.aldiwan.net/poem20823.html","الكامل"],[513,"بصفات مجدك يشرف التمجيد","https://www.aldiwan.net/poem12060.html","الكامل"],[513,"تسائلني عن قصتي متجاهلاً","https://www.aldiwan.net/poem12274.html","الطويل"],[513,"إن السعادة قد أظل زمانها","https://www.aldiwan.net/poem12284.html","الكامل"],[549,"قدني إليك فقد أمنت شماسي","https://www.aldiwan.net/poem47745.html","الكامل"],[549,"قف بالديار المقفرات","https://www.aldiwan.net/poem48026.html","مجزوء الكامل"],[549,"على مثل هذا اليوم تحنى الرواجب","https://www.aldiwan.net/poem48099.html","الطويل"],[556,"حولوا عني من الكون لثاما","https://www.aldiwan.net/poem33885.html","الرمل"],[556,"ظهر الوجود من","https://www.aldiwan.net/poem34082.html","مجزوء الكامل"],[556,"لبسنتني مليحة الغيب مرطا","https://www.aldiwan.net/poem34406.html","الخفيف"],[556,"كل من بالناس يختلط","https://www.aldiwan.net/poem34409.html","المديد"],[573,"نسيت في أسماء حتى اسمي","https://www.aldiwan.net/poem3012.html","السريع"],[573,"إنني من عتقائك","https://www.aldiwan.net/poem3042.html","مجزوء الرمل"]],"verses":[["وَتَدنو الدِيارُ بِسُكّانِها","تَمَنّي اِمرِىءٍ ما عَراكُم عَراهُ",0,"ا",2,0],["وَتَدارَكتَ ما تَمَنّيتَ وَالأَح","شاءُ مَزرورَةٌ عَلى الأَحقادِ",1,"د",1,0],["وَتَدارَكوا ذَودَ المَسا","رِحِ وَهيَ بَينَكُمُ سِقابُ",2,"ب",1,0],["وَتَداوُلُ الأَيّامِ يُبلينا كَما","يُبلي الرَشاءَ تَطاوُحُ الأَرجاءِ",3,"ا",2,0],["وتَدْفَعُ عنكَ الكاشِحينَ كأنّما","مَناطُ قَوافيها الرِّماحُ المَداعِسُ",4,"س",1,0],["وتَدْفَعُ عنهُ كلَّ أشْوَسَ باسِلٍ","بمَسْنونَةٍ زُرْقٍ ومَلْبونَةٍ جُردِ",5,"د",1,0],["وتَدعو إذا اسْتَشْرى العِدا يا لَغالبٍ","فتُشْرِقُ مِن أبطالِنا قَسَماتُها",6,"ت",3,0],["وتَدْمى عَراقيبُ المَطِيِّ إذا حَدَتْ","إلَيهمْ أعاريبَ الفَلا سَنَواتُها",6,"ت",3,0],["وتدافعت(صنعاء) إليك كأنه","حسناء مغرمة تغازل مغرما",7,"م",2,0],["وَتَدري كَيفَ مَعشوقٌ","تَحَسّى في الهَوى كاسا",8,"س",2,0],["وتُديرُ منْ قلْبِ السّطورِ سَبائِكاً","منْها ومِنْ طبْعِ الحُروفِ فُلوسا",9,"س",2,0],["وتُدْنِي إِلَيْهِ السَّمْعَ تُصْغِي كَأَنَّهُ","يُحَقِّقُ قَدْرَ الْبَسْطِ فِيهِ مِنَ القَبْضِ",10,"ض",1,0],["وَتُدفَنُ مِنهُ الصالِحاتُ وَإِن يُسِئ","يَكُن ما أَساءَ النارَ في رَأسِ كَبكَبا",11,"ب",2,0],["وَتُديرُ لِلخَرقِ البَعيدِ نِياطُهُ","بَعدَ الكَلالِ وَبَعدَ نَومِ الساري",12,"ر",2,0],["وَتَدفَعُهُ لِلمَوتِ وَالثَغرُ باسِمٌ","وَفي صَدرِها نَوءٌ مِنَ الزَفَراتِ",13,"ت",1,0],["وَتَدافَعَت تِلكَ التِلاعُ فَأَتأَقَت","غُدرانَها بِأَتِيّ ذي دُفَّاعِ",14,"ع",1,0],["وَتُدني عَلى المَتنَينِ وَحفاً كَأَنَّهُ","عَناقيدُ كَرمٍ قَد تَدَلّى فَأَنعَما",15,"م",2,0],["وَتَدَارَكُوا الأَعْراضَ أَنْ تَنْتَابَهَا","أَعْرَاضُ عَصْرٍ فِي المَآرِبِ مُتْهَمِ",16,"م",1,0],["وتدلّى قرط بسالفتَيها","رصّعت فيه ماسةٌ بجمانه",17,"ن",2,0],["وتدور بين اللاعبين فمحجِم","عنها وآخر ضارب مقدام",18,"م",1,0],["وَتَدعو خَمشَ أُمِّكَ أَن تَرانا","نُجوماً لا تَرومُ لَها طِلابا",19,"ب",2,0],["وَتَدعونَ ماروكاً أَبا العَمِّ ناصِراً","عَلَيهِم إِذا ما أَعصَمَ الوَغدُ بِالوَغدِ",20,"د",1,0],["وَتَدعو اللَهَ مُجتَهِداً لِيَرضى","وَتَذكُرُ في رَعِيَّتِكَ المَعادا",21,"د",2,0],["وَتَدعوكَ الأَرامِلُ وَاليَتامى","وَمَن أَمسى وَلَيسَ بِهِ حَويلُ",22,"ل",1,0],["وَتَداكَأَت أَركانُ كُلِّ قَبيلَةٍ","وَفَوارِسُ المَلِكِ الهُمامِ تَذودُ",23,"د",1,0],["وَتَدفَعُ عَن حَوزَتَيَّ الخُطوبَ","وَتَكشِفُ عَن ناظِرَيَّ الكُرَب",24,"ب",1,0],["وتدبير ملكٍ مع تورّع زاهدٍ","إلى وثب عزمٍ مع سكون عفاف",25,"ف",1,0],["وُتِدتْ بالحجا ولم تعدِم العِل","مَ عماداً ولا التُّقى تطنيبا",26,"ب",2,0],["وتداعت أركانُهُ بانهدام","وتداعتْ أحشاؤُهُ بالخرابِ",27,"ب",1,0],["وتداعت لها الأكف","ف وفيها تعجرُف",28,"ف",1,0],["وتدعونا إلى بثق","بشر الماء ينبثق",29,"ق",1,0],["وَتُديرُ عَنينَها عَلى جَزَعٍ","كَالظَبيِ مُلتَفِتاً مِنَ الذُعرِ",30,"ر",1,0],["وَتُديرُ في تِلكَ البَنانِ مُسَدَّساً","تَرَكَت قَذائِفُهُ السِهامَ فُضولا",31,"ل",2,0],["وَتُدرِكي أَنَّ قُصورَ المُنى","تَبقى وَنَهَدُّ قُصورُ الرِجام",32,"م",1,0],["وتدَفَّعَ الزَّمَنُ المُدَمْدِمُ","في شِعابِ الكائناتْ",33,"ت",1,0],["وتَدَفَّق المسكينُ يصرخُ ثائراً","ماذا جنيتُ أنا فَحُقَّ عِقابي",34,"ي",1,0],["وتدركني قبل الصباح ونهضه","فأنجو من الهمِّ الذي هو ناصب",35,"ب",1,0],["وتُدخل في بيتها ما تصيب","ولا يُخرج الدهر ما أدخلت",36,"ت",1,0],["وتداركوها من عمائم صادفت","مرعى من الأوقاف والأرصاد",37,"د",1,0],["وتدعو الشهود إلى الملتقى","وتبعد والخصم عن مصر ميلا",38,"ل",2,0],["وتدفعهنّ من بعد وقرب","وتثنيهن حتى ينثنينا",39,"ن",2,0],["وَتَدَّعي أَنَّ لَها مِقدارا","وَأَنَّها تَستَوقِفُ الأَبصارا",40,"ر",2,0],["وَتَداوَلَتكَ عِصابَةٌ عَرَبِيَّةٌ","بَينَ المَآذِنِ وَالقِلاعِ نُزولُ",41,"ل",1,0],["وَتَدولُ آثارُ القُرو","نِ عَلى رَحى الزَمَنِ الطَحون",42,"ن",1,0],["وَتَدَفَّقَ النَهرانِ فيهِ وَأَزهَرَت","بَغدادُ تَحتَ ظِلالِهِ وَالشامُ",43,"م",1,0],["وتدبّر سطورها","فبها الحق مستطر",44,"ر",1,0],["وتداركتني بعد يأسٍ نعمةٌ","اللّهُ مَنَّ بلطفه متفضِّلا",45,"ل",2,0],["وَتَدبيرُ مَنصورِ العَزيمَةِ يَغتَدي","وَتَدبيرُهُ حادي النَجاحِ وَقائِدُه",46,"د",2,0],["وَتُدرَجُ في البُردِ المُحَبَّرِ صورَةٌ","كَتَوشِيَةِ البُردِ الصَنيعِ المُحَبَّرِ",47,"ر",1,0],["وَتَداني الدارَينِ أَحسَنُ لَو كا","نَ إِلى رَدِّ ظاعِنٍ مِن سَبيلِ",48,"ل",1,0],["وَتُدخِلُ في اليَقينِ عَلَيكَ شَكّاً","وَلا شَيءٌ أَعَزَّ مِنَ اليَقينِ",49,"ن",1,0],["وَتَدعوكَ الكُفاةُ وَلا تُناجي","وَتَسأَلُكَ العُفاةُ فَلا تُجيبُ",50,"ب",1,0],["وَتَدَاوَيتُ من خُماري بخمرٍ","نابِعاتٌ بِها جَواهِرُ ثَغْرِك",51,"ك",1,0],["وتدفعَ هذي النفوسَ الصغارَ","خوفاً إلى حَرَمٍ أَمْنَعِ",52,"ع",1,0],["وَتَدَلَّلَت عِندَ