{"poems":[[53,"تلفت والرمل ما بيننا","https://www.aldiwan.net/poem29633.html","المتقارب"],[53,"شقيت منك بالعلاء الأعادي","https://www.aldiwan.net/poem30629.html","الخفيف"],[53,"إنا نعيب ولانعاب","https://www.aldiwan.net/poem30746.html","مجزوء الكامل"],[53,"أبكيك لو نقع الغليل بكائي","https://www.aldiwan.net/poem30779.html","الكامل"],[63,"سل الدهر عني أي خطب أمارس","https://www.aldiwan.net/poem46145.html","الطويل"],[63,"سقى دارها من منحنى الأجرع الفرد","https://www.aldiwan.net/poem46164.html","الطويل"],[63,"لمن فتية منشورة وفراتها","https://www.aldiwan.net/poem46199.html","الطويل"],[100,"الربيع والشعر","https://www.aldiwan.net/poem10291.html","عموديه"],[55,"إذا ما شئت أن تصنع","https://www.aldiwan.net/poem26264.html","الهزج"],[77,"أطلعن في سدف الفروع شموسا","https://www.aldiwan.net/poem35884.html","الكامل"],[77,"هلم فجفن الدهر قد لاذ بالغمض","https://www.aldiwan.net/poem36010.html","الطويل"],[9,"كفى بالذي تولينه لو تجنبا","https://www.aldiwan.net/poem21907.html","الطويل"],[24,"من سره كرم الحياة فلا يزل","https://www.aldiwan.net/poem21866.html","الكامل"],[86,"إليكن يهدي النيل ألف تحية","https://www.aldiwan.net/poem68894.html","الطويل"],[71,"ما سر سكان الحمى بمذاع","https://www.aldiwan.net/poem4025.html","الكامل"],[35,"لعزة أطلال أبت أن تكلما","https://www.aldiwan.net/poem39090.html","الطويل"],[93,"أليوم عيد البائس المتألم","https://www.aldiwan.net/poem11290.html","الكامل"],[88,"هذي بلودان وذا نزلها","https://www.aldiwan.net/poem44394.html","الخفيف"],[88,"قصدوا الرياضة لاعبين وبينهم","https://www.aldiwan.net/poem44415.html","الكامل"],[27,"أقلي اللوم عاذل والعتابا","https://www.aldiwan.net/poem5686.html","الوافر"],[27,"أنتم فررتم يوم عدوة مازن","https://www.aldiwan.net/poem5714.html","الطويل"],[27,"أبت عيناك بالحسن الرقادا","https://www.aldiwan.net/poem5721.html","الوافر"],[27,"علام تلوم عاذلة جهول","https://www.aldiwan.net/poem5960.html","الوافر"],[4,"قضي الأمور وأنجز الموعود","https://www.aldiwan.net/poem21156.html","الكامل"],[47,"أسيف الهدى وقريع العرب","https://www.aldiwan.net/poem25374.html","المتقارب"],[72,"بقيت لحمد مثل فضلك واف","https://www.aldiwan.net/poem19259.html","الطويل"],[51,"أحمد الله مبدئا ومعيدا","https://www.aldiwan.net/poem8322.html","الخفيف"],[51,"لهف نفسي على رصاص مذاب","https://www.aldiwan.net/poem8508.html","الخفيف"],[51,"زلقت في سلاحها","https://www.aldiwan.net/poem65472.html","مجزوء الخفيف"],[51,"لشنطف كعثب خلق","https://www.aldiwan.net/poem65727.html","مجزوء الوافر"],[91,"كانت قبيل العصر مركبة","https://www.aldiwan.net/poem8852.html","عموديه"],[91,"يا ليتما خلق الزمان أصيلا","https://www.aldiwan.net/poem62669.html","عموديه"],[91,"كمنجةي الشوا عليك السلام","https://www.aldiwan.net/poem62744.html","عموديه"],[92,"يا أيها الطفل الذي قد","https://www.aldiwan.net/poem38926.html","مجزوء الكامل"],[92,"كان الربيع الحي روحا حالما","https://www.aldiwan.net/poem38969.html","الكامل"],[89,"أحاطت بليل اليأس مني غياهب","https://www.aldiwan.net/poem44938.html","الطويل"],[85,"ولم لا وجدته نملة","https://www.aldiwan.net/poem6960.html","المتقارب"],[85,"بعثوا الخلافة سيرة في النادى","https://www.aldiwan.net/poem7110.html","الكامل"],[85,"أَمنس إلى كم تضل السبيلا","https://www.aldiwan.net/poem7517.html","المتقارب"],[85,"جلوسك أم سلام العالمينا","https://www.aldiwan.net/poem7798.html","الوافر"],[85,"كان لبعض الناس نعجتان","https://www.aldiwan.net/poem8026.html","الرجز"],[85,"انظر إلى الأقمار كيف تزول","https://www.aldiwan.net/poem62837.html","الكامل"],[85,"درجت على الكنز القرون","https://www.aldiwan.net/poem63694.html","مجزوء الكامل"],[85,"يا أخت أندلس عليك سلام","https://www.aldiwan.net/poem63741.html","الكامل"],[62,"قل لمن يطلب الحجر","https://www.aldiwan.net/poem52140.html","مجزوء الخفيف"],[62,"هذا الزمان يزف أبكار العلى","https://www.aldiwan.net/poem52319.html","الطويل"],[45,"دنا السرب إلا أن هجرا يباعده","https://www.aldiwan.net/poem63461.html","الطويل"],[45,"أراني متى أبغ الصبابة أقدر","https://www.aldiwan.net/poem63635.html","الطويل"],[45,"يا ابنة العامري عما قليل","https://www.aldiwan.net/poem65557.html","الخفيف"],[49,"مؤاخاة الفتى البطر البطين","https://www.aldiwan.net/poem63141.html","الوافر"],[66,"كذا فليصبر الرجل النجيب","https://www.aldiwan.net/poem40117.html","الوافر"],[80,"يا قليل الوفاء ضاع وداد","https://www.aldiwan.net/poem31453.html","الخفيف"],[90,"فداء لمثواك","https://www.aldiwan.net/poem59036.html","عموديه"],[31,"حي الرباب وتربها","https://www.aldiwan.net/poem42653.html","مجزوء الكامل"],[105,"قومي أهاب من الحياة بشير","https://www.aldiwan.net/poem42068.html","الكامل"],[105,"قصوا الحديث عن الفريق النائي","https://www.aldiwan.net/poem42116.html","الكامل"],[105,"أكل متوج يحمي البلادا","https://www.aldiwan.net/poem43373.html","الوافر"],[105,"أم تدافع يأسها برجائها","https://www.aldiwan.net/poem43414.html","الكامل"],[105,"لأم سليم يا أبا طلحة العذر","https://www.aldiwan.net/poem44037.html","الطويل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[75,"تقول بنو العباس هل فتحت مصر","https://www.aldiwan.net/poem69083.html","الطويل"],[48,"رفع الصوت فنادى","https://www.aldiwan.net/poem62598.html","مجزوء الرمل"],[50,"أعاذل لا أنام على اقتسار","https://www.aldiwan.net/poem63817.html","الوافر"],[46,"خوى دن شرب فاستحابوا إلى التقى","https://www.aldiwan.net/poem22453.html","الطويل"],[46,"أكتم حديثك عن أخيك ولا تكن","https://www.aldiwan.net/poem22483.html","الكامل"],[46,"للحال بالقدر اللطيف تغير","https://www.aldiwan.net/poem22559.html","الكامل"],[46,"أوعز الدهر بالفناء إلى النا","https://www.aldiwan.net/poem22773.html","الخفيف"],[46,"إن دمعي نبع وما العود نبع","https://www.aldiwan.net/poem22948.html","الخفيف"],[46,"معان من أحبتنا معان","https://www.aldiwan.net/poem23635.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85549","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85324","الكامل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30468","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42541","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55160","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54564","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54674","الخفيف"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67285","الخفيف"],[31,"","https://poetry.dctabudhabi.ae/diwan/poem/6126","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54279","الطويل"],[106,"أعياد النصر","https://www.poetsgate.com/ViewPoem.aspx?id=179343",""],[100,"الربيع والشعر","https://www.poetsgate.com/ViewPoem.aspx?id=50128",""],[100,"مدينة الغد","https://www.poetsgate.com/ViewPoem.aspx?id=24212",""],[91,"كمنجة الشوا","https://www.poetsgate.com/ViewPoem.aspx?id=53301",""]],"verses":[["وَتَدنو الدِيارُ بِسُكّانِها","تَمَنّي اِمرِىءٍ ما عَراكُم عَراهُ",0,"ا",2,0],["وَتَدارَكتَ ما تَمَنّيتَ وَالأَح","شاءُ مَزرورَةٌ عَلى الأَحقادِ",1,"د",1,0],["وَتَدارَكوا ذَودَ المَسا","رِحِ وَهيَ بَينَكُمُ سِقابُ",2,"ب",1,0],["وَتَداوُلُ الأَيّامِ يُبلينا كَما","يُبلي الرَشاءَ تَطاوُحُ الأَرجاءِ",3,"ا",2,0],["وتَدْفَعُ عنكَ الكاشِحينَ كأنّما","مَناطُ قَوافيها الرِّماحُ المَداعِسُ",4,"س",1,0],["وتَدْفَعُ عنهُ كلَّ أشْوَسَ باسِلٍ","بمَسْنونَةٍ زُرْقٍ ومَلْبونَةٍ جُردِ",5,"د",1,0],["وتَدعو إذا اسْتَشْرى العِدا يا لَغالبٍ","فتُشْرِقُ مِن أبطالِنا قَسَماتُها",6,"ت",3,0],["وتَدْمى عَراقيبُ المَطِيِّ إذا حَدَتْ","إلَيهمْ أعاريبَ الفَلا سَنَواتُها",6,"ت",3,0],["وتدافعت(صنعاء) إليك كأنه","حسناء مغرمة تغازل مغرما",7,"م",2,0],["وَتَدري كَيفَ مَعشوقٌ","تَحَسّى في الهَوى كاسا",8,"س",2,0],["وتُديرُ منْ قلْبِ السّطورِ سَبائِكاً","منْها ومِنْ طبْعِ الحُروفِ فُلوسا",9,"س",2,0],["وتُدْنِي إِلَيْهِ السَّمْعَ تُصْغِي كَأَنَّهُ","يُحَقِّقُ قَدْرَ الْبَسْطِ فِيهِ مِنَ القَبْضِ",10,"ض",1,0],["وَتُدفَنُ مِنهُ الصالِحاتُ وَإِن يُسِئ","يَكُن ما أَساءَ النارَ في رَأسِ كَبكَبا",11,"ب",2,0],["وَتُديرُ لِلخَرقِ البَعيدِ نِياطُهُ","بَعدَ الكَلالِ وَبَعدَ نَومِ الساري",12,"ر",2,0],["وَتَدفَعُهُ لِلمَوتِ وَالثَغرُ باسِمٌ","وَفي صَدرِها نَوءٌ مِنَ الزَفَراتِ",13,"ت",1,0],["وَتَدافَعَت تِلكَ التِلاعُ فَأَتأَقَت","غُدرانَها بِأَتِيّ ذي دُفَّاعِ",14,"ع",1,0],["وَتُدني عَلى المَتنَينِ وَحفاً كَأَنَّهُ","عَناقيدُ كَرمٍ قَد تَدَلّى فَأَنعَما",15,"م",2,0],["وَتَدَارَكُوا الأَعْراضَ أَنْ تَنْتَابَهَا","أَعْرَاضُ عَصْرٍ فِي المَآرِبِ مُتْهَمِ",16,"م",1,0],["وتدلّى قرط بسالفتَيها","رصّعت فيه ماسةٌ بجمانه",17,"ن",2,0],["وتدور بين اللاعبين فمحجِم","عنها وآخر ضارب مقدام",18,"م",1,0],["وَتَدعو خَمشَ أُمِّكَ أَن تَرانا","نُجوماً لا تَرومُ لَها طِلابا",19,"ب",2,0],["وَتَدعونَ ماروكاً أَبا العَمِّ ناصِراً","عَلَيهِم إِذا ما أَعصَمَ الوَغدُ بِالوَغدِ",20,"د",1,0],["وَتَدعو اللَهَ مُجتَهِداً لِيَرضى","وَتَذكُرُ في رَعِيَّتِكَ المَعادا",21,"د",2,0],["وَتَدعوكَ الأَرامِلُ وَاليَتامى","وَمَن أَمسى وَلَيسَ بِهِ حَويلُ",22,"ل",1,0],["وَتَداكَأَت أَركانُ كُلِّ قَبيلَةٍ","وَفَوارِسُ المَلِكِ الهُمامِ تَذودُ",23,"د",1,0],["وَتَدفَعُ عَن حَوزَتَيَّ الخُطوبَ","وَتَكشِفُ عَن ناظِرَيَّ الكُرَب",24,"ب",1,0],["وتدبير ملكٍ مع تورّع زاهدٍ","إلى وثب عزمٍ مع سكون عفاف",25,"ف",1,0],["وُتِدتْ بالحجا ولم تعدِم العِل","مَ عماداً ولا التُّقى تطنيبا",26,"ب",2,0],["وتداعت أركانُهُ بانهدام","وتداعتْ أحشاؤُهُ بالخرابِ",27,"ب",1,0],["وتداعت لها الأكف","ف وفيها تعجرُف",28,"ف",1,0],["وتدعونا إلى بثق","بشر الماء ينبثق",29,"ق",1,0],["وَتُديرُ عَنينَها عَلى جَزَعٍ","كَالظَبيِ مُلتَفِتاً مِنَ الذُعرِ",30,"ر",1,0],["وَتُديرُ في تِلكَ البَنانِ مُسَدَّساً","تَرَكَت قَذائِفُهُ السِهامَ فُضولا",31,"ل",2,0],["وَتُدرِكي أَنَّ قُصورَ المُنى","تَبقى وَنَهَدُّ قُصورُ الرِجام",32,"م",1,0],["وتدَفَّعَ الزَّمَنُ المُدَمْدِمُ","في شِعابِ الكائناتْ",33,"ت",1,0],["وتَدَفَّق المسكينُ يصرخُ ثائراً","ماذا جنيتُ أنا فَحُقَّ عِقابي",34,"ي",1,0],["وتدركني قبل الصباح ونهضه","فأنجو من الهمِّ الذي هو ناصب",35,"ب",1,0],["وتُدخل في بيتها ما تصيب","ولا يُخرج الدهر ما أدخلت",36,"ت",1,0],["وتداركوها من عمائم صادفت","مرعى من الأوقاف والأرصاد",37,"د",1,0],["وتدعو الشهود إلى الملتقى","وتبعد والخصم عن مصر ميلا",38,"ل",2,0],["وتدفعهنّ من بعد وقرب","وتثنيهن حتى ينثنينا",39,"ن",2,0],["وَتَدَّعي أَنَّ لَها مِقدارا","وَأَنَّها تَستَوقِفُ الأَبصارا",40,"ر",2,0],["وَتَداوَلَتكَ عِصابَةٌ عَرَبِيَّةٌ","بَينَ المَآذِنِ وَالقِلاعِ نُزولُ",41,"ل",1,0],["وَتَدولُ آثارُ القُرو","نِ عَلى رَحى الزَمَنِ الطَحون",42,"ن",1,0],["وَتَدَفَّقَ النَهرانِ فيهِ وَأَزهَرَت","بَغدادُ تَحتَ ظِلالِهِ وَالشامُ",43,"م",1,0],["وتدبّر سطورها","فبها الحق مستطر",44,"ر",1,0],["وتداركتني بعد يأسٍ نعمةٌ","اللّهُ مَنَّ بلطفه متفضِّلا",45,"ل",2,0],["وَتَدبيرُ مَنصورِ العَزيمَةِ يَغتَدي","وَتَدبيرُهُ حادي النَجاحِ وَقائِدُه",46,"د",2,0],["وَتُدرَجُ في البُردِ المُحَبَّرِ صورَةٌ","كَتَوشِيَةِ البُردِ الصَنيعِ المُحَبَّرِ",47,"ر",1,0],["وَتَداني الدارَينِ أَحسَنُ لَو كا","نَ إِلى رَدِّ ظاعِنٍ مِن سَبيلِ",48,"ل",1,0],["وَتُدخِلُ في اليَقينِ عَلَيكَ شَكّاً","وَلا شَيءٌ أَعَزَّ مِنَ اليَقينِ",49,"ن",1,0],["وَتَدعوكَ الكُفاةُ وَلا تُناجي","وَتَسأَلُكَ العُفاةُ فَلا تُجيبُ",50,"ب",1,0],["وَتَدَاوَيتُ من خُماري بخمرٍ","نابِعاتٌ بِها جَواهِرُ ثَغْرِك",51,"ك",1,0],["وتدفعَ هذي النفوسَ الصغارَ","خوفاً إلى حَرَمٍ أَمْنَعِ",52,"ع",1,0],["وَتَدَلَّلَت عِندَ العِتا","بِ فَمَرحَباً بِعِتابِها",53,"ب",3,0],["وتَدَفَّقُوا يَتَسابَقونَ إلى مَدىً","بالسُّحب عنه وبالبِحارِ قُصورُ",54,"ر",1,0],["وتداركوا دينَ الجهادِ وفَسِّروا","للجاهلينَ شَرائعَ الزُّعماءِ",55,"ا",2,0],["وَتَدعوهُ الرَعِيَّةُ وَهوَ لاهٍ","فَتَصدَعُ دونَ مَسمَعِهِ الجَمادا",56,"د",2,0],["وَتَدَفَّقوا بِالمكرماتِ وَنافِسُوا","في بَذلِ عارفةٍ وَكَسبِ ثَنائِها",57,"ا",3,0],["وتدعو رسولَ اللهِ هل أنتَ سامِعٌ","فَيَفْرَحُ من رجعِ الحديثِ وَيَفْتَرُّ",58,"ر",1,0],["وتَدَاعَى إيوانُ كِسْرَى ولَوْلا","آيةٌ مِنكَ ما تَدَاعَى البناءُ",59,"ا",2,0],["وتَدَلَّتْ زُهْرُ النُّجومِ إليهِ","فأضاءت بِضوئها الأَرجاءُ",59,"ا",2,0],["وتَدَارَكْهُ بالعناية ما دا","مَ له بالذِّمامِ منك ذماءُ",59,"ا",2,0],["وتدري فُروضَ الحجِّ من نافِلاتِهِ","ويمتازُ عندَ الأمَّةِ الخَيرُ والشرُّ",60,"ر",1,0],["وَتَدارَك جَسَداً قَد","ماتَ أَو قَد قيلَ كادا",61,"د",2,0],["وَتُدلِجُ لِلقَنافِذِ تَدَّريها","وَيُنسيكَ المَكارِمَ صَيدُ فارِ",62,"ر",1,0],["وَتَدري المَواضي ما دَواءَ دَوائِبٍ","يَبِتنَ لِرَهطِ المَرءِ شَرَّ دَوادي",63,"ي",1,0],["وَتُدَيُّرُ الأَوطانِ حُبَّ وَطالَما","قُنِصَ الحَمامُ عَلى الغُصونِ المُيَّدِ",64,"د",1,0],["وَتَدَيَّري عِندَ السِماكِ أَو أَلسُها","فَلِكُلِّ جِسمٍ في التُرابِ تَدَيُّرُ",65,"ر",1,0],["وَتَداعَوا في آلِ زَيدٍ وَعَمرٍ","وَعَزاهُم لِتُربَةِ الأَرضِ عازِ",66,"ز",1,0],["وَتَداني الأَيّامِ يُحدِثُ نَقصاً","وَاِزدِياداً وَالجِسمُ لِلنَفسِ تِبعُ",67,"ع",1,0],["وتَدّخِرُ الكَواعِبُ من حَصاهُ","وحُقّ لها ادّخارٌ واخْتِزَانُ",68,"ن",1,0],["وَتَداويت عند كل طَبيب","ونصيبي من التداوي نحول",69,"ل",1,0],["وَتدور في أطرافها","مشدودة بالجذب شدا",70,"د",2,0],["وتَدْرِي سِباعُ الطَّيْرِ أَنَّ كُمَاتَهُ","إِذا لَقِيَتْ صِيدَ الكُماةِ سِباعُ",71,"ع",1,1],["وتَدَرَّجْ مَعِي إِلَى رَوْضَةِ الْمَنْ","يَل ذاتِ النَّخِيلِ والثَّمَراتِ",72,"ت",1,0],["وَتَدُقُّ فِي مَرَأَى الرَّعِيَّةِ عُنْقهُ","لِيَمُوتَ مَوْتَ المُجْرِمِينَ مُذَالاَ",73,"ل",2,0],["وَتَدَارَكُوا الأَطُفَالَ بِالسَّبَبَيْنِ من","تَصْحِيحِ أبْدَانٍ وَمِنْ تَهْذِيبِ",74,"ب",1,0],["وَتَدَاعَتْ صَوَادِحُ الأَطْيَارِ","قُلْنَ هَذِي خُلاَصَةُ الأَسْرَارِ",75,"ر",1,0],["وتداعَتْ خَشْبَاؤُها إذْ رَأيْنَا","واستخَفّتْ من خَوْفِنا الخَشْباءُ",76,"ا",2,0],["وَتُدني النَصيفَ عَلى واضِحٍ","جَميلٍ إِذا سَفَرَت عَنهُ حُر",77,"ر",1,0],["وتَدْعُو فلا تَلْقَى مُجيباً سِوى النَّوَى","تُطَارِح مَطْوِيَّ الأسَى وتُحَاوِرُه",78,"ر",2,0],["وتدفعُ عنها العواديَ حينَ","تَنُوب، وتحمل ما آدها",79,"د",3,0],["وتدري العروبةُ أن جمالا","إذا جُرِحَت، كان ضَمّادها",79,"د",3,0],["وتدافعت ( صنعا ) إليك كأنّها","حسناء مغرمة تغازل مغرما",80,"م",2,0],["وتداعي عصر يموت ليحيا","أو ليفنى، ولا يحسَّ انتحاره",81,"ر",2,0],["وتدركي أنّ قصور المنى","تبقى ةتنهدّ قصور الرّجام",82,"م",1,0]]}