//www.aldiwan.net/poem37186.html","الكامل"],[483,"خود رمت عن قوس حاجبها سها","https://www.aldiwan.net/poem24485.html","عموديه"],[483,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[494,"ومرنان معبسة ضحوك","https://www.aldiwan.net/poem67311.html","الوافر"],[501,"أجتلى نور وجهه فأذب","https://www.aldiwan.net/poem37636.html","الخفيف"],[501,"لا تعنف مولها أحمديا","https://www.aldiwan.net/poem37649.html","الخفيف"],[501,"برق نعمان على الهائم طل","https://www.aldiwan.net/poem37699.html","الرمل"],[501,"يا آلهي بدولة الأسماء","https://www.aldiwan.net/poem37720.html","الخفيف"],[501,"تحت سبر المرفرف الأزلي","https://www.aldiwan.net/poem37723.html","الخفيف"],[501,"أطلع الحسن من سناك هلالا","https://www.aldiwan.net/poem37730.html","الخفيف"],[501,"كيف لا أندب الطلول غراما","https://www.aldiwan.net/poem37782.html","الخفيف"],[501,"قد تداعت من الأقاح خيوط","https://www.aldiwan.net/poem37784.html","الخفيف"],[501,"طرق السر من البرهان ما","https://www.aldiwan.net/poem37802.html","الرمل"],[501,"رقرق الكأس حبيبي","https://www.aldiwan.net/poem37975.html","مجزوء الرمل"],[515,"خطرت فمال الغصن وهو ممنطق","https://www.aldiwan.net/poem20823.html","الكامل"],[516,"بصفات مجدك يشرف التمجيد","https://www.aldiwan.net/poem12060.html","الكامل"],[516,"تسائلني عن قصتي متجاهلاً","https://www.aldiwan.net/poem12274.html","الطويل"],[516,"إن السعادة قد أظل زمانها","https://www.aldiwan.net/poem12284.html","الكامل"],[552,"قدني إليك فقد أمنت شماسي","https://www.aldiwan.net/poem47745.html","الكامل"],[552,"قف بالديار المقفرات","https://www.aldiwan.net/poem48026.html","مجزوء الكامل"],[552,"على مثل هذا اليوم تحنى الرواجب","https://www.aldiwan.net/poem48099.html","الطويل"],[559,"حولوا عني من الكون لثاما","https://www.aldiwan.net/poem33885.html","الرمل"],[559,"ظهر الوجود من","https://www.aldiwan.net/poem34082.html","مجزوء الكامل"],[559,"لبسنتني مليحة الغيب مرطا","https://www.aldiwan.net/poem34406.html","الخفيف"],[559,"كل من بالناس يختلط","https://www.aldiwan.net/poem34409.html","المديد"],[576,"نسيت في أسماء حتى اسمي","https://www.aldiwan.net/poem3012.html","السريع"],[576,"إنني من عتقائك","https://www.aldiwan.net/poem3042.html","مجزوء الرمل"]],"verses":[["وَتَدنو الدِيارُ بِسُكّانِها","تَمَنّي اِمرِىءٍ ما عَراكُم عَراهُ",0,"ا",2,0],["وَتَدارَكتَ ما تَمَنّيتَ وَالأَح","شاءُ مَزرورَةٌ عَلى الأَحقادِ",1,"د",1,0],["وَتَدارَكوا ذَودَ المَسا","رِحِ وَهيَ بَينَكُمُ سِقابُ",2,"ب",1,0],["وَتَداوُلُ الأَيّامِ يُبلينا كَما","يُبلي الرَشاءَ تَطاوُحُ الأَرجاءِ",3,"ا",2,0],["وتَدْفَعُ عنكَ الكاشِحينَ كأنّما","مَناطُ قَوافيها الرِّماحُ المَداعِسُ",4,"س",1,0],["وتَدْفَعُ عنهُ كلَّ أشْوَسَ باسِلٍ","بمَسْنونَةٍ زُرْقٍ ومَلْبونَةٍ جُردِ",5,"د",1,0],["وتَدعو إذا اسْتَشْرى العِدا يا لَغالبٍ","فتُشْرِقُ مِن أبطالِنا قَسَماتُها",6,"ت",3,0],["وتَدْمى عَراقيبُ المَطِيِّ إذا حَدَتْ","إلَيهمْ أعاريبَ الفَلا سَنَواتُها",6,"ت",3,0],["وتدافعت(صنعاء) إليك كأنه","حسناء مغرمة تغازل مغرما",7,"م",2,0],["وَتَدري كَيفَ مَعشوقٌ","تَحَسّى في الهَوى كاسا",8,"س",2,0],["وتُديرُ منْ قلْبِ السّطورِ سَبائِكاً","منْها ومِنْ طبْعِ الحُروفِ فُلوسا",9,"س",2,0],["وتُدْنِي إِلَيْهِ السَّمْعَ تُصْغِي كَأَنَّهُ","يُحَقِّقُ قَدْرَ الْبَسْطِ فِيهِ مِنَ القَبْضِ",10,"ض",1,0],["وَتُدفَنُ مِنهُ الصالِحاتُ وَإِن يُسِئ","يَكُن ما أَساءَ النارَ في رَأسِ كَبكَبا",11,"ب",2,0],["وَتُديرُ لِلخَرقِ البَعيدِ نِياطُهُ","بَعدَ الكَلالِ وَبَعدَ نَومِ الساري",12,"ر",2,0],["وَتَدفَعُهُ لِلمَوتِ وَالثَغرُ باسِمٌ","وَفي صَدرِها نَوءٌ مِنَ الزَفَراتِ",13,"ت",1,0],["وَتَدافَعَت تِلكَ التِلاعُ فَأَتأَقَت","غُدرانَها بِأَتِيّ ذي دُفَّاعِ",14,"ع",1,0],["وَتُدني عَلى المَتنَينِ وَحفاً كَأَنَّهُ","عَناقيدُ كَرمٍ قَد تَدَلّى فَأَنعَما",15,"م",2,0],["وَتَدَارَكُوا الأَعْراضَ أَنْ تَنْتَابَهَا","أَعْرَاضُ عَصْرٍ فِي المَآرِبِ مُتْهَمِ",16,"م",1,0],["وتدلّى قرط بسالفتَيها","رصّعت فيه ماسةٌ بجمانه",17,"ن",2,0],["وتدور بين اللاعبين فمحجِم","عنها وآخر ضارب مقدام",18,"م",1,0],["وَتَدعو خَمشَ أُمِّكَ أَن تَرانا","نُجوماً لا تَرومُ لَها طِلابا",19,"ب",2,0],["وَتَدعونَ ماروكاً أَبا العَمِّ ناصِراً","عَلَيهِم إِذا ما أَعصَمَ الوَغدُ بِالوَغدِ",20,"د",1,0],["وَتَدعو اللَهَ مُجتَهِداً لِيَرضى","وَتَذكُرُ في رَعِيَّتِكَ المَعادا",21,"د",2,0],["وَتَدعوكَ الأَرامِلُ وَاليَتامى","وَمَن أَمسى وَلَيسَ بِهِ حَويلُ",22,"ل",1,0],["وَتَداكَأَت أَركانُ كُلِّ قَبيلَةٍ","وَفَوارِسُ المَلِكِ الهُمامِ تَذودُ",23,"د",1,0],["وَتَدفَعُ عَن حَوزَتَيَّ الخُطوبَ","وَتَكشِفُ عَن ناظِرَيَّ الكُرَب",24,"ب",1,0],["وتدبير ملكٍ مع تورّع زاهدٍ","إلى وثب عزمٍ مع سكون عفاف",25,"ف",1,0],["وُتِدتْ بالحجا ولم تعدِم العِل","مَ عماداً ولا التُّقى تطنيبا",26,"ب",2,0],["وتداعت أركانُهُ بانهدام","وتداعتْ أحشاؤُهُ بالخرابِ",27,"ب",1,0],["وتداعت لها الأكف","ف وفيها تعجرُف",28,"ف",1,0],["وتدعونا إلى بثق","بشر الماء ينبثق",29,"ق",1,0],["وَتُديرُ عَنينَها عَلى جَزَعٍ","كَالظَبيِ مُلتَفِتاً مِنَ الذُعرِ",30,"ر",1,0],["وَتُديرُ في تِلكَ البَنانِ مُسَدَّساً","تَرَكَت قَذائِفُهُ السِهامَ فُضولا",31,"ل",2,0],["وَتُدرِكي أَنَّ قُصورَ المُنى","تَبقى وَنَهَدُّ قُصورُ الرِجام",32,"م",1,0],["وتدَفَّعَ الزَّمَنُ المُدَمْدِمُ","في شِعابِ الكائناتْ",33,"ت",1,0],["وتَدَفَّق المسكينُ يصرخُ ثائراً","ماذا جنيتُ أنا فَحُقَّ عِقابي",34,"ب",2,0],["وتدركني قبل الصباح ونهضه","فأنجو من الهمِّ الذي هو ناصب",35,"ب",1,0],["وتُدخل في بيتها ما تصيب","ولا يُخرج الدهر ما أدخلت",36,"ت",1,0],["وتداركوها من عمائم صادفت","مرعى من الأوقاف والأرصاد",37,"د",1,0],["وتدعو الشهود إلى الملتقى","وتبعد والخصم عن مصر ميلا",38,"ل",2,0],["وتدفعهنّ من بعد وقرب","وتثنيهن حتى ينثنينا",39,"ن",2,0],["وَتَدَّعي أَنَّ لَها مِقدارا","وَأَنَّها تَستَوقِفُ الأَبصارا",40,"ر",2,0],["وَتَداوَلَتكَ عِصابَةٌ عَرَبِيَّةٌ","بَينَ المَآذِنِ وَالقِلاعِ نُزولُ",41,"ل",1,0],["وَتَدولُ آثارُ القُرو","نِ عَلى رَحى الزَمَنِ الطَحون",42,"ن",1,0],["وَتَدَفَّقَ النَهرانِ فيهِ وَأَزهَرَت","بَغدادُ تَحتَ ظِلالِهِ وَالشامُ",43,"م",1,0],["وتدبّر سطورها","فبها الحق مستطر",44,"ر",1,0],["وتداركتني بعد يأسٍ نعمةٌ","اللّهُ مَنَّ بلطفه متفضِّلا",45,"ل",2,0],["وَتَدبيرُ مَنصورِ العَزيمَةِ يَغتَدي","وَتَدبيرُهُ حادي النَجاحِ وَقائِدُه",46,"د",2,0],["وَتُدرَجُ في البُردِ المُحَبَّرِ صورَةٌ","كَتَوشِيَةِ البُردِ الصَنيعِ المُحَبَّرِ",47,"ر",1,0],["وَتَداني الدارَينِ أَحسَنُ لَو كا","نَ إِلى رَدِّ ظاعِنٍ مِن سَبيلِ",48,"ل",1,0],["وَتُدخِلُ في اليَقينِ عَلَيكَ شَكّاً","وَلا شَيءٌ أَعَزَّ مِنَ اليَقينِ",49,"ن",1,0],["وَتَدعوكَ الكُفاةُ وَلا تُناجي","وَتَسأَلُكَ العُفاةُ فَلا تُجيبُ",50,"ب",1,0],["وَتَدَاوَيتُ من خُماري بخمرٍ","نابِعاتٌ بِها جَواهِرُ ثَغْرِك",51,"ك",1,0],["وتدفعَ هذي النفوسَ الصغارَ","خوفاً إلى حَرَمٍ أَمْنَعِ",52,"ع",1,0],["وَتَدَلَّلَت عِندَ العِتا","بِ فَمَرحَباً بِعِتابِها",53,"ب",3,0],["وتَدَفَّقُوا يَتَسابَقونَ إلى مَدىً","بالسُّحب عنه وبالبِحارِ قُصورُ",54,"ر",1,0],["وتداركوا دينَ الجهادِ وفَسِّروا","للجاهلينَ شَرائعَ الزُّعماءِ",55,"ا",2,0],["وَتَدعوهُ الرَعِيَّةُ وَهوَ لاهٍ","فَتَصدَعُ دونَ مَسمَعِهِ الجَمادا",56,"د",2,0],["وَتَدَفَّقوا بِالمكرماتِ وَنافِسُوا","في بَذلِ عارفةٍ وَكَسبِ ثَنائِها",57,"ا",3,0],["وتدعو رسولَ اللهِ هل أنتَ سامِعٌ","فَيَفْرَحُ من رجعِ الحديثِ وَيَفْتَرُّ",58,"ر",1,0],["وتَدَاعَى إيوانُ كِسْرَى ولَوْلا","آيةٌ مِنكَ ما تَدَاعَى البناءُ",59,"ا",2,0],["وتَدَلَّتْ زُهْرُ النُّجومِ إليهِ","فأضاءت بِضوئها الأَرجاءُ",59,"ا",2,0],["وتَدَارَكْهُ بالعناية ما دا","مَ له بالذِّمامِ منك ذماءُ",59,"ا",2,0],["وتدري فُروضَ الحجِّ من نافِلاتِهِ","ويمتازُ عندَ الأمَّةِ الخَيرُ والشرُّ",60,"ر",1,0],["وَتَدارَك جَسَداً قَد","ماتَ أَو قَد قيلَ كادا",61,"د",2,0],["وَتُدلِجُ لِلقَنافِذِ تَدَّريها","وَيُنسيكَ المَكارِمَ صَيدُ فارِ",62,"ر",1,0],["وَتَدري المَواضي ما دَواءَ دَوائِبٍ","يَبِتنَ لِرَهطِ المَرءِ شَرَّ دَوادي",63,"د",2,0],["وَتُدَيُّرُ الأَوطانِ حُبَّ وَطالَما","قُنِصَ الحَمامُ عَلى الغُصونِ المُيَّدِ",64,"د",1,0],["وَتَدَيَّري عِندَ السِماكِ أَو أَلسُها","فَلِكُلِّ جِسمٍ في التُرابِ تَدَيُّرُ",65,"ر",1,0],["وَتَداعَوا في آلِ زَيدٍ وَعَمرٍ","وَعَزاهُم لِتُربَةِ الأَرضِ عازِ",66,"ز",1,0],["وَتَداني الأَيّامِ يُحدِثُ نَقصاً","وَاِزدِياداً وَالجِسمُ لِلنَفسِ تِبعُ",67,"ع",1,0],["وتَدّخِرُ الكَواعِبُ من حَصاهُ","وحُقّ لها ادّخارٌ واخْتِزَانُ",68,"ن",1,0],["وَتَداويت عند كل طَبيب","ونصيبي من التداوي نحول",69,"ل",1,0],["وَتدور في أطرافها","مشدودة بالجذب شدا",70,"د",2,0],["وتَدْرِي سِباعُ الطَّيْرِ أَنَّ كُمَاتَهُ","إِذا لَقِيَتْ صِيدَ الكُماةِ سِباعُ",71,"ع",1,1],["وتَدَرَّجْ مَعِي إِلَى رَوْضَةِ الْمَنْ","يَل ذاتِ النَّخِيلِ والثَّمَراتِ",72,"ت",1,0],["وَتَدُقُّ فِي مَرَأَى الرَّعِيَّةِ عُنْقهُ","لِيَمُوتَ مَوْتَ المُجْرِمِينَ مُذَالاَ",73,"ل",2,0],["وَتَدَارَكُوا الأَطُفَالَ بِالسَّبَبَيْنِ من","تَصْحِيحِ أبْدَانٍ وَمِنْ تَهْذِيبِ",74,"ب",1,0],["وَتَدَاعَتْ صَوَادِحُ الأَطْيَارِ","قُلْنَ هَذِي خُلاَصَةُ الأَسْرَارِ",75,"ر",1,0],["وتداعَتْ خَشْبَاؤُها إذْ رَأيْنَا","واستخَفّتْ من خَوْفِنا الخَشْباءُ",76,"ا",2,0],["وَتُدني النَصيفَ عَلى واضِحٍ","جَميلٍ إِذا سَفَرَت عَنهُ حُر",77,"ر",1,0],["وتَدْعُو فلا تَلْقَى مُجيباً سِوى النَّوَى","تُطَارِح مَطْوِيَّ الأسَى وتُحَاوِرُه",78,"ر",2,0],["وتدفعُ عنها العواديَ حينَ","تَنُوب، وتحمل ما آدها",79,"د",3,0],["وتدري العروبةُ أن جمالا","إذا جُرِحَت، كان ضَمّادها",79,"د",3,0],["وتدلّت أضواؤه كالعناقيد","فأذكت في كلّ عين ذبالا",80,"ل",2,0],["وتدفعني وحشة الذكريات","وتثني خطاي طيوف المصير",81,"ر",1,0],["وتداعت الأوجاع فيه والتظت","فيه الجراح الحمر كالجمرات",82,"ت",1,0],["وتدافعت ( صنعا ) إليك كأنّها","حسناء مغرمة تغازل مغرما",83,"م",2,0],["وتداعي عصر يموت ليحيا","أو ليفنى، ولا يحسَّ انتحاره",84,"ر",2,0],["وتدركي أنّ قصور المنى","تبقى ةتنهدّ قصور الرّجام",85,"م",1,0],["وتدير عينيها على جزع","كالظّبي ملتفتا من الذّعر",86,"ر",1,0],["وتداركوا هذا السلام بطبّكم","ودوائكم إنّ السلام عليل",87,"ل",1,0],["وتدعوها الفتون وهنّ سحر","فتطرق لا تلبّي من دعاها",88,"ا",3,0],["وتدبرى حكما لربك مضمر","في طيها التفصيل والاجمال",89,"ل",1,0],["وتدارك لا رى من","ك سنا للقلب مشغف",90,"ف",1,0],["وتداركني بغوث عاجل","والتفت لي ان قلبي في نكد",91,"د",1,0],["وتداركني بغوث عاجل","فلعمري غيركم ما لي احد",92,"د",1,0],["وتداركوني أن قل","بي في خطيئته تلاها",93,"ا",3,0],["وتدق فوق خرائب الأديان نا","قوس الردى وتحيلها أغفالا",94,"ل",2,0],["وتداويت من غرام ملولٍ","بهوى مسعدس على العيش نجد",95,"د",1,0],["وتدبرْ مِن قبل فعِلكَ بالأم","رِ فإن الصلاحَ في التَّدْبيرِ",96,"ر",1,0],["وتَدنُو مِن محاوِرِهَا دُنُواً","وإِن رِي