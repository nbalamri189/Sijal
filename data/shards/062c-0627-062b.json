{"poems":[[93,"أي خطب دها فبات المهجر","https://www.aldiwan.net/poem8965.html","عموديه"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54637","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141935","الكامل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66785","السريع"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63856","الرجز"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101021","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94317","الرجز"],[2909,"","https://poetry.dctabudhabi.ae/diwan/poem/96430","الخفيف"],[4717,"ميمون","https://www.poetsgate.com/ViewPoem.aspx?id=204118",""],[4717,"جاثٍ على صدر القطيع","https://www.poetsgate.com/ViewPoem.aspx?id=204168",""],[6031,"هَتَفَتْ بِدَمْعِ العَينِ وَهْي سَجُومُ","https://www.poetsgate.com/ViewPoem.aspx?id=46292",""]],"verses":[["جاثِياتٍ في هَيكَلِ الأَرواحِ","قائِلاتٍ بِلَهجَةِ النُصّاحِ",0,"ح",1,0],["جَاثٍ عَلَى أقْدَامِهَا بَلَغَ الأَسَى","مِنْهُ مَبَالِغَهُ وَلَيسَ بِغَاضِبِ",1,"ب",1,0],["جاث على قدم السرير وعينه","عين المصور حاولت أن ترسما",2,"م",2,0],["جاثَيْتُ سوّاراً أبا شملةٍ","عندَ الإمامِ الحاكمِ العادلِ",3,"ل",1,1],["جاثمةَ الشخصِ جثومَ العنزِ","تَقْفِزُ بالأشلاءِ أوْحَى قفز",4,"ز",1,0],["جاثٍ يخاف النيل من غدراته","بأساء يومٍ بالخطوب عتيك",5,"ك",1,0],["جاث جثا كف سنحا وجه عنا","فحل نزا غاف صحا قلب حنا",6,"ن",2,0],["جاثَلِيقٌ أسقُفُّ فسقٍ وكفرٍ","ثم فُقتَ الأسقفُ والجاثليقا",7,"ق",2,0],["جَاثٍ عَلَى صَدْرِ البِلادِ ومَنْ مَعَهْ","هَذِي العِصَابَةُ دَلَّسَتْهَا الأقْنِعَةْ",8,"ع",2,1],["جَاثٍ عَلَى صَدْرِ القَطِيعِ ومَنْ مَعَهْ","هَذِي المَلَامِحُ زَيَّفَتْهَا الأقْنِعَةْ",9,"ع",2,1],["جَاثٍ على حَدِّ الفُرَاتِ كبازلٍ","سِيمَ البُرُوكَ وظهرُهُ مَعْكُومُ",10,"م",1,0]]}