poem24600.html","مجزوء الكامل"],[97,"أنا وحدي في البيد حيران هائم","https://www.aldiwan.net/poem24927.html","الخفيف"],[97,"يا حبيبي غيمة في خاطري","https://www.aldiwan.net/poem24929.html","الرمل"],[80,"الهجر يضحك والهوى يبكي","https://www.aldiwan.net/poem31352.html","أحذ الكامل"],[80,"صادتك مهاة لم تصد","https://www.aldiwan.net/poem31480.html","المتدارك"],[44,"الهوى ظالم وأنت ظلوم","https://www.aldiwan.net/poem30121.html","الخفيف"],[44,"نعاء إلى كل حي نعاء","https://www.aldiwan.net/poem30325.html","المتقارب"],[44,"ما عهدنا كذا نحيب المشوق","https://www.aldiwan.net/poem30395.html","الخفيف"],[105,"هتف البشير به وحان الحين","https://www.aldiwan.net/poem42044.html","الكامل"],[105,"إيه بني مصر من صم وعميان","https://www.aldiwan.net/poem43098.html","البسيط"],[105,"أدأبك أن تريد المستحيلا","https://www.aldiwan.net/poem44213.html","الوافر"],[81,"يا سمي المصطفى يا بغيتي","https://www.aldiwan.net/poem61480.html","الرمل"],[81,"انهض بأمرك فالهدى مقصود","https://www.aldiwan.net/poem61540.html","الكامل"],[21,"إله العالمين وكل أرض","https://www.aldiwan.net/poem36168.html","الوافر"],[52,"الموت من غادر أعذب به","https://www.aldiwan.net/poem27291.html","المنسرح"],[67,"إلهي على كل الأمور لك الحمد","https://www.aldiwan.net/poem18053.html","الطويل"],[75,"صدق الفناء وكذب العمر","https://www.aldiwan.net/poem69076.html","أحذ الكامل"],[48,"أله بالبيض الملاح","https://www.aldiwan.net/poem62510.html","مجزوء الرمل"],[48,"يا هاشم ابن حديج ليس فخركم","https://www.aldiwan.net/poem62612.html","البسيط"],[48,"يا مبيح الدمع في الطلل","https://www.aldiwan.net/poem64995.html","المديد"],[50,"تأبدت برقة الروحاء فاللبب","https://www.aldiwan.net/poem64839.html","البسيط"],[46,"إلهنا الله ملك أول أحد","https://www.aldiwan.net/poem22399.html","البسيط"],[46,"أقصرت من قصر النهار وقد أنى","https://www.aldiwan.net/poem22568.html","الكامل"],[46,"خير من الظلم للوالين لو عقلوا","https://www.aldiwan.net/poem22674.html","البسيط"],[46,"إله الأنام ورب الغمام","https://www.aldiwan.net/poem23115.html","المتقارب"],[46,"إله