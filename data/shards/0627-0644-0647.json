=179030",""],[90,"أنغام الخطوب","https://www.poetsgate.com/ViewPoem.aspx?id=179139",""],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[90,"الدم يتكلم بعد عشرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=179112",""],[58,"لك الحمد يا ذا الجود والمجد والعلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=56851&r=&rc=167",""],[96,"موت الشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66379&r=&rc=55",""]],"verses":[["الهاجِمينَ عَلى المُلوكِ قِبابَهُم","وَالضارِبينَ مَعاقِدَ التيجانِ",0,"ن",1,0],["أَلهاكِ عَنّا رَبَّةَ البُرقُعِ","مَرُّ الثَلاثينَ إِلى الأَربَعِ",1,"ع",1,1],["أَلهَمُّ أَصبَحَ يا ظَلومُ مُقارَني","وَالهَمُّ شَرُّ مُقارِنٍ وَمُصاحِبِ",2,"ب",1,0],["إلَهِي بالبَيْتِ المُقَدَّسِ والمَسْعَى","وجَمْعٍ إذا ما الخَلْقُ قدْ نزَلوا جَمْعا",3,"ع",2,1],["أَلَهْفاً عَلَيْهَا مِنْ خَلالٍ كَرِيمَةٍ","كَرَوْضِ الرُّبَا تَفْتَرُّ فِي أَرْضِ دِيمَة",4,"ه",1,0],["أَلهَمَ اللَهُ فيكَ صَبراً جَميلاً","كُلَّ مَن باتَ ناطِقاً بِالضادِ",5,"د",1,0],["آلَةٍ تَسحَقُ التَواكُلَ في الشَر","قِ وَتُلقي عَنِ الرِياءِ القِناعا",6,"ع",2,0],["أَلهَتكَ عَنهُ فُكاهاتٌ تَلَذُّ بِها","فَلَيسَ يَجري بِبالٍ مِنكَ ذِكراهُ",7,"ا",2,0],["الهَوى في طُلوعِ تِلكَ النُجومِ","وَالمُنى في هُبوبِ ذاكَ النَسيمِ",8,"م",1,1],["إِلهَامُهُ دَارَجَ الكَوْ","نَ مُنْذُ شَبَّ فَتِيَّا",9,"ي",2,0],["آلِهَةُ مِصْرَ فِي القِدَمِ","وَرَمْزُ الحُسْنِ فِي الأُمَمِ",10,"م",1,1],["أَلهاهُ آءٌ وَتَنّومٌ وَعُقبَتُهُ","مِن لائِحِ المَروِ وَالمَرعى لَهُ عُقَبُ",11,"ب",1,0],["أَلهى أَباكَ عَنِ المَكارِمِ وَالعُلى","لَيُّ الكَتائِفِ وَاِرتِفاعُ المِرجَلِ",12,"ل",1,0],["إِلَهُهُمُ رَبّي وَرَبّي إِلَهُهُم","فَأَقسَمتُ لا أَرسو وَلا أَتَمَعَّدُ",13,"د",1,1],["إلهيَ في حسنِ الرَّجا ليَ مذهب","وقد آنَ للرَّاجي إليكَ ذِهاب",14,"ب",1,0],["إلهي سلمتُ من الضربِ في","بلادٍ لعيشي فيها حرَج",15,"ج",1,1],["إلهيَ قد مدَّ الرجا يدَ قاصدٍ","وَجودُكَ أولى أن تبلغه يدا",16,"د",2,0],["ألهى قريضي عن غزالِ النقا","تغزُّلاً فيهِ وعن هنده",17,"د",2,0],["إلهي أطلْ للدهرِ في عمرِ أحمدٍ","فيا حبَّذا الشخص الكريم ودهره",18,"ر",2,0],["إلهي كم حسَّنت للحيّ منزلاً","فمنزلة الثاني بعفوك أحسن",19,"ن",1,0],["أُلهُوبُ نارٍ فاستِنرْ واسْتَتِرْ","منه فقد أنذرك اللَّفْحُ",20,"ح",1,0],["إلهي أجرني من شُنيفٍ وزيركٍ","من الجرُذ القرّاض والهرِّذي الخَدْشِ",21,"ش",1,1],["آلهاً أولها وحُقّ لأمرٍ","آلهُ أن يؤولَ خيرَ مآلِ",22,"ل",1,0],["أَلهى جَريراً عَن أَبيهِ وَأُمِّهِ","مَكانٌ لِشُبّانِ الرِجالِ أَنيقُ",23,"ق",1,1],["أَلِهَذا اللُغزُ حَلٌّ أَم سَيَبقى أَبَدِيّا","لَستُ أَدري وَلِماذا لَستُ أَدري لَستُ أَدري",24,"ي",1,0],["أَلَهُم يا بَحرُ يَوماً رَجعَةٌ أَم لا مَآبا","أَم هُمُ في الرَملِ قالَ الرَملُ إِنّي لَستُ أَدري",24,"ي",1,0],["الهَنا أُفلِتَ مِن أَيديهِم","وَالأَماني إِنَّها تَنتَحِرُ",25,"ر",1,0],["أَلهَتهُمُ الدُنيا فَهَذا بِالطِلى","صَبٌّ وَهَذا بِالحِسانِ مُتَيَّمُ",26,"م",1,0],["أَلَهيبٌ يثورُ في روضَةِ النَّفْسِ","فَيَطْغى أَمْ أَنتَ نُورُ السَّماءِ",27,"ا",2,0],["ألهم عودة كما يعد الدي","ن ام القوم ما لهم من معاد",28,"د",1,0],["ألها عندي دين","ام لها عندي حساب",29,"ب",1,0],["إله العالمين أجب دماء","تصيح الانتقاما الانتقاما",30,"م",2,0],["الهِندُ والِهَةٌ وَمِصرُ حَزينَةٌ","تَبكي عَلَيكِ بِمَدمَعٍ سَحّاحِ",31,"ح",1,0],["أَلهَبَت خَيلاً وَحَضَّت فَيلَقاً","وَأَحالَت عَسَلاً صابَ المَنون",32,"ن",1,0],["الهازِئينَ مِنَ الثَرى بِسُهولِهِ","الدائِسينَ عَلى رُؤوسِ جِبالِهِ",33,"ل",2,0],["الهَدمُ أَجمَلُ مِن بِنايَةِ مُصلِحٍ","يَبني عَلى الأُسُسِ العِتاقِ جَديدا",34,"د",2,0],["آلَةُ العَيشِ صِحَّةٌ وَشَبابٌ","فَإِذا وَلَّيا عَنِ المَرءِ وَلّى",35,"ل",2,0],["أَلهى المَمالِكَ عَن فَخرٍ قَفَلتَ بِهِ","شُربُ المُدامَةِ وَالأَوتارُ وَالنَغَمُ",36,"م",1,0],["ألهمنا علم أداة لنا","مكتومة تخفى ولا تظهر",37,"ر",1,0],["ألهمنا فكّ الرموز التي","تكاتمتها الأمم الغابره",38,"ر",2,0],["الهِزَبرُ الَّذي إِذا اِلتَفَّتِ الحَر","بُ بِهِ صَرَّفَ الرَدى كَيفَ شاءَ",39,"ا",2,0],["أَلهَتكَ عَن حاجَةٍ ضَيَّعتَ حُرمَتَها","وِلايَةٌ وَدَواعي النَفسِ تُتَّهَمُ",40,"م",1,0],["إِلَهي أَنتَ ذو فَضلٍ وَمنِّ","وَإِنّي ذو خَطايا فَاِعفُ عَنّي",41,"ي",1,1],["إِلَهي لا تُعَذِّبني فَإِنّي","مُقِرٌّ بِالَّذي قَد كانَ مِنّي",42,"ن",2,1],["إِلَهي وَخَلّاقي وَحِرزي وَمَوئِلي","إِلَيكَ لَدى الإِعسارِ وَاليُسرِ أَفزَعُ",43,"ع",1,0],["إِلَهي لَئِن جُلتُ وَجَمَّت خَطيئَتي","فَعَفوُكَ عَن ذَنبي أَجَلُّ وَأَوسَعُ",43,"ع",1,0],["إِلَهي لَئِن أَعطَيتَ نَفسي سُؤلُها","فَها أَنا في أَرضِ النَدامَةِ أَرتَعُ",43,"ع",1,0],["إِلَهي تَرى حالي وَفَقري وَفاقَتي","وَأَنتَ مُناجاتي الخَفيَّةِ تَسمَعُ",43,"ع",1,0],["إِلَهي فَلا تَقطَع رَجائي وَلا تُزِغ","فُؤادي فَلي في سَيبِ جُودِكَ مَطمَعُ",43,"ع",1,0],["إِلَهي لِئَن خَيَّبتَني أَو طَرَدتَني","فَمَن ذا الَّذي أَرجو وَمَن لي يَشفَعُ",43,"ع",1,0],["إِلَهي أَجِرني مِن عَذابِكَ إِنَّني","أَسيرٌ ذَليلٌ خائِفٌ لَكَ أَخضَعُ",43,"ع",1,0],["إِلَهي فَآنِسني بِتَلقينِ حُجَّتي","إِذا كانَ لي في القَبرِ مَثوىً وَمضجَعُ",43,"ع",1,0],["إِلَهي لَئِن عَذَّبتَني أَلفَ حَجَّةٍ","فَحَبلُ رَجائي مِنكَ لا يَتَقَطَّعُ",43,"ع",1,0],["إِلَهي أَذِقني طَعمَ عَفوكَ يَومَ لا","بَنونٌ وَلا مالٌ هُناكَ يَنفَعُ",43,"ع",1,0],["إِلَهي إِذا لَم تَرعَني كُنتُ ضائِعاً","وَإِن كُنتَ تَرعاني فَلَستُ أَضيعُ",43,"ع",1,0],["إِلَهي إِذا لَم تَعفُ عَن غَيرِ مُحسِنٍ","فَمنَ لَمسيءٍ بِالهَوى يَتَمَتَّعُ",43,"ع",1,0],["إِلَهي لَئِن فَرَّطتُ في طَلبِ التُقى","فَها أَنا أَثْرَ العَفو أَقفو وَاَتبَعُ",43,"ع",1,0],["إِلَهي لَئِن أَخطَأتُ جَهلاً فَطالَما","رَجَوتُكَ حَتّى قيلَ ها هُوَ يَجزَعُ",43,"ع",1,0],["إِلَهي ذُنوبي جازَت الطَودَ وَاَعتَلَت","وَصَفحُكَ عَن ذَنبي أَجَلُّ وَأَرفَعُ",43,"ع",1,0],["إِلَهي يُنجِّي ذِكرُ طَوْلِكَ لَوعَتي","وَذِكرُ الخَطايا العَينُ مِنّيَ تَدمَعُ",43,"ع",1,0],["إِلَهي أَنِلني مِنكَ روحاً وَرَحمَةً","فَلَستُ سِوى أَبوابِ فَضلِكَ أَقرَعُ",43,"ع",1,0],["إِلَهي لِئَن أَقصَيتَني أَو طَرَدتَني","فما حِيلَتي يا رَبُّ أَم كَيفَ أَصنَعُ",43,"ع",1,0],["إِلَهي حَليفُ الحُبِّ بِاللَيلِ ساهِرٌ","يُنادي وَيَدعو وَالمغَفَّلُ يَهجَعُ",43,"ع",1,0],["إِلَهي يُمنّيني رَجائي سَلامَةً","وَقُبحُ خَطيئاتي عَليَّ يَشيَّعُ",43,"ع",1,0],["إِلَهي فَإِن تَعفو فَعَفوُكَ مُنقِذي","وَإِلا فَبالذَنبِ المُدَمِّرِ أُصرَعُ",43,"ع",1,0],["إِلَهي بِحَقِّ الهاشِميِّ وَآلِهِ","وَحُرمَةُ إِبراهيمَ خِلَّكَ أَضرَعُ",43,"ع",1,0],["إِلَهي فَاِنشُرني عَلى دينِ أَحمَدٍ","تَقيّاً نَقيّاً قانِتاً لَكَ أَخشَعُ",43,"ع",1,0],["الهِرصُ داءٌ قَد أَضَرَّبِمَن","تَرى إِلّا قَليلا",44,"ل",2,1],["أُلهيتُ عَن قَومي بِمَلِكٍ عِندَهُ","تَنسى البَنونَ فَضائِلَ الآباءِ",45,"ا",2,0],["أَلهِم حَدَقَ المِلاحِ في الحُكمِ بِنا","إِنجازَ مَواعِدٍ وَإِخلافَ وَعيد",46,"د",1,0],["أَلهَمَ اللَهُ غُنجَ أَلحاظِكَ العَد","لَ وَأَغرى عَينَيكَ بِالإِنصافِ",47,"ف",1,1],["ألهمنني وأحطن بي","فجرى بشعري الخاطرُ",48,"ر",1,0],["ألهمنني وشككن بي","ونسين أني شاعرُ",48,"ر",1,0],["الهوى مَصرَعي وكم من حِمامٍ","كان باباً إلى الخلود الدائم",49,"م",1,0],["الهوى الخالص قيد وحده","رب حر وهو في قيد وثيق",50,"ق",1,0],["الهجرُ يضحكُ وَالهوى يبكي","والوَصلُ بَينَهُما على هُلْكِ",51,"ك",1,1],["إِلهامَ الدينِ وَحامِيَهُ","قَوِّم بسُطاك ذَوي الأوَدِ",52,"د",1,0],["الهَوى ظالِمٌ وَأَنتَ ظَلومُ","كَيفَ يَقوى عَلَيكُما المَثلومُ",53,"م",1,1],["أَلَهفي عَلى خالِدٍ لَهفَةً","تَكونُ أَمامي وَأُخرى وَرائي",54,"ا",2,0],["أَلَهفي إِذا ما رَدى لِلرَدى","أَلَهفي إِذا ما اِحتَبى لِلحِباءِ",54,"ا",2,0],["أَلهَبَتها السِياطُ حَتّى إِذا اِستَنَّ","ت بِإِطلاقِها عَلى الناطَلوقِ",55,"ق",1,0],["أَلَهُ جُنودٌ حوله محشودةٌ","وبَوارجٌ مَبثوثةٌ وسَفِين",56,"ن",1,0],["الهادِمونَ كَثيرٌ بَينَ أَظهُرِكُم","شُدّوا البِناءَ وَصونوا حُرمَةَ الباني",57,"ن",2,0],["إلهُ النّاسِ فردٌ لا يُثنَّى","تأمّلْ خلقه إنساً وجنّا",58,"ن",2,0],["الهَوى عِندِيَ إيمانٌ فَلا","بُدَّ مِنهُ في فُؤادٍ وَلِسانِ",59,"ن",1,0],["الهَديُ فيكَ سَجيَّةٌ مَفطورَةٌ","وَالنورُ طَبعاً في الضُحى مَوجودُ",60,"د",1,0],["إِلَهُ العالَمينَ وَكُلِّ أَرضٍ","وَرَبُّ الراسِياتِ مِنَ الجِبالِ",61,"ل",1,1],["الهَجرُ في فِعلِهِ وَلَحظَتِهِ","وَالوَصلُ في قَولِهِ وَفي كُتُبِه",62,"ب",2,0],["إلهي عَلَى كلِّ الأمورِ لَكَ الحَمْدُ","فلَيْسَ لِمَا أَوْلَيْتَ مِنْ نِعَمٍ حَدُّ",63,"د",1,1],["الهاتكِينَ بها الضُّلوعَ إذا","ما رَجّعوا الذّكرَاتِ أو زَفَروا",64,"ر",3,0],["أُلهُ بِالبيضِ المِلاحِ","وَبِقَيناتٍ وَراحِ",65,"ح",1,1],["أَلهى اِمرَأَ القَيسِ تَشبيبٌ بِغانِيَةٍ","عَن ثَأرِهِ وَصِفاتُ النُؤيِ وَالوَتَدِ",66,"د",1,0],["أُلهُ عَمّا أَنتَ طالِبُهُ","مِن جَوابِ النُؤيِ وَالطَلَلِ",67,"ل",1,0],["الهاشِمِيُّ اِبنُ داودٍ تَدارَكَنا","وَما لَنا عِندَهُ نُعمى وَلا نَسَبُ",68,"ب",1,0],["إِلَهُنا اللَهُ مَلكٌ أَوَّلٌ أَحَدٌ","تُطيعُهُ مِن صُنوفِ الناسِ آحادُ",69,"د",1,1],["الهَمُّ مُنتَشِرٌ وَلَكِن رَبُّهُ","يَوماً يَصيرُ إِلى الثَرى فَيُصارُ",70,"ر",1,0],["أَلهى البَريَّةَ إِلقاءٌ إِلى هُضُمٍ","كَأَنَّما هُوَ حَصبٌ في التَنانيرِ",71,"ر",1,0],["إِلَهَ الأَنامِ وَرَبَّ الغَمامِ","لَنا الفَقرُ دونَكَ وَالمُلكُ لَك",72,"ك",1,1],["إِلَهٌ قادِرٌ وَعَبيدُ سوءٍ","وَجَبرٌ في المَذاهِبِ وَاِعتِزالُ",73,"ل",1,1],["إِلَهَنا الحَقَّ خَفِّف وَاِشفِ مِن وَصَبٍ","فَإِنَّها دارُ أَثقالٍ وَآلامِ",74,"م",1,1],["إِلَهُكَ أَوجَدَ الأَشياءَ جَمعاً","فَلا يَفخَر بِشَيءٍ موجِدوهُ",75,"د",3,0],["أَلَهفاً عَلى حُسنِ أَخلاقِهِ","عَلى الجابِرِ العَظمِ وَالحارِبِ",76,"ب",1,0],["الهَدْيُ حولك والسُّيوفُ كما ترى","مَقروبةٌ وكأنّما هِيَ نُوَّم",77,"م",1,0],["آلةٌ تطفئ السعيرَ إذا شا","ء فلا تحرقُ الجسومَ السعير",78,"ر",1,0],["أَلهو بِضَعيف من أَملي","فأحل الخيط وأعقده",79,"د",2,0],["الهيولي هي الأثير تردّى","صوراً ثم شق جيب الرداء",80,"ا",2,0],["الهم أُكبره كالليل أَسهره","وَقَد أَنام به والنجم يقظان",81,"ن",1,0],["أَلها إذا بلغت نها","ية دورها المسعود مبدا",82,"د",2,0],["أَلَهُ في هُتافِكَ العذابِ داعٍ","يُنطِقُ الواجماتِ من أدواحِهْ",83,"ح",2,0],["ألهمَ الشعرُ أصغريهِ فرفَّا","في فَمِ الدهرِ كوثراً ومُدامَه",84,"م",2,0],["ألهَمها والدَك المجتبى","وأنتَ من أبنائه الملهَمينْ",85,"ن",1,0],["أَلْهَتْكُمُ الدُّنْيَا عَنِ الآخِرَهْ","وَهِيَ مِنَ الْجَهْلِ بِكُمْ سَاخِرَهْ",86,"ر",2,1],["الْهَيْلَطِيَّة أَكْلَةٌ أَتْقَنْتُهَا","فهْيَ العَزِيزَةُ مِنْ نُبُوغِ عَزِيزِ",87,"ز",1,1],["أَلَّهَتْهُ أَوْهَمَتْهُ أَنَّهُ","مَالِكُ الضُّرِّ مَنِيعٌ أَنْ يُضَرَّا",88,"ر",2,0],["ألهميني يا ربّة الشعر شعرا","كالنور والنار",89,"ر",1,1],["ألهميني شعرا طليقاً جديدا","يوزّع الأنوار",89,"ر",1,0],["الهوى والشباب والأمل المنشود","توحي فتبعث الشعر حيّا",90,"ي",2,1],["الهوى والشباب والامل المنشود","ضاعت جميعها من يديّا",90,"ي",2,0],["إلهة الشعر قامت عن ميامنه","وربة النثر قامت عن مياسره",91,"ر",2,0],["أَلهو وَلي رَهبَةٌ في كُلِّ حادِثَةٍ","وَإِنَّما رَهبَتي فَرعٌ لِرَغبَتِيَه",92,"ت",3,0],["الهُمام الذي أذلَّ صعاب ال","ناس قَسراً بالعدل لا بالتظني",93,"ي",1,0],["آلةُ الفَوْزِ همّةٌ تطحَنُ الصخ","رَ وتسمُو للنَّجْمِ في سَبَحاتِهْ",94,"ت",2,0],["ألهب العزم في بني مصرَ ناراً","أيُّ خيرٍ في هذه النيران",95,"ن",1,0],["ألهو كما تلهو الطيورُ حديثها","شدْوٌ وَرَفُّ جَناحِها أنغام",96,"م",1,0],["الهاتف الصدَّاحُ باسم بلاده","يطوي به بحرًا، ويقطع بيدا",97,"د",2,0],["الهائمون بكلِّ أفْ","قٍ دنَّسُوا البلدَ الأمين",98,"ن",1,0],["ألهاهمو هذا الحديثُ الساري","عن الوغى ونقعِها المُثَارِ",99,"ر",1,0],["الهمُّ بعدك فوق صدري جاثمٌ","والغمُّ بعدك آخذٌ بخناقي",100,"ق",2,0],["إلهُ الشرِّ جبارٌ عنيدٌ","يحبُّ معَ الجبابرةِ الصراعا",101,"ع",2,0],["ألهاه ماضيه عن تشييدِ حاضره","وعن لبابِ المساعي قِشْرَةُ النَّسَب",102,"ب",1,0],["الهواءُ الهبَّابُ ، والنورُ ،","والخضرةُ تأتي ما ليس يأتي الطبيب",103,"ب",1,0],["ألهذا هَرقْتُموني وأضحى","ألفُ عرض وألف مُلكُ مُشاعا",104,"ع",2,0],["إلهي أذقني طعم عفوك يوم لا","بنون ولا مال هنالك ينفع",105,"ع",1,0],["إلهي فإن تعف فعفوك منقذي","وإلا فبالذنب المدمر أصرع",105,"ع",1,0],["إلهيَ فانْشُرْني على دِيْنِ أَحْمَدٍ","تقياً نقياً فانتاً لك أخشعُ",105,"ع",1,0],["آله في هتافك العذب داع","ينطق الواجمات من أدواحه ؟",106,"ح",2,0]]}