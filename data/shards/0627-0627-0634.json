{"poems":[[65,"رماك بشوق فالمدامع ذرف","https://www.aldiwan.net/poem46173.html","الطويل"],[39,"ألم تلمم على الطلل المحيل","https://www.aldiwan.net/poem7425.html","الوافر"],[53,"أيا غرة العليا ويا عينها اليمنى","https://www.aldiwan.net/poem7987.html","الطويل"],[53,"لعمري لقد غاب الرضا فتطاولت","https://www.aldiwan.net/poem66300.html","الطويل"],[47,"على أي أمر مشكل أتلوم","https://www.aldiwan.net/poem65664.html","الطويل"],[63,"طلعت شموس الخدر كيما تغربا","https://www.aldiwan.net/poem51784.html","الكامل"],[69,"إلهي على كل الأمور لك الحمد","https://www.aldiwan.net/poem18053.html","الطويل"],[50,"أأشرس إن يكن ما قيل حقا","https://www.aldiwan.net/poem64485.html","المتقارب"],[113,"غضبتم والزمان معا","https://www.aldiwan.net/poem16609.html","مجزوء الوافر"],[178,"تأوبني طارق الهم نصبا","https://www.aldiwan.net/poem46065.html","المتقارب"],[228,"لمن يا ترى أشكو بمدمعي الهمل","https://www.aldiwan.net/poem41906.html","الطويل"],[371,"يعز على محلي مفارقة القطر","https://www.aldiwan.net/poem17317.html","الطويل"],[408,"أغيرك يرجى لخطب نزل","https://www.aldiwan.net/poem46914.html","المتقارب"],[463,"عزفت فما أدرى الفتى كيف يرغب","https://www.aldiwan.net/poem56271.html","الطويل"],[482,"آليت لا حلت ولا حلتم","https://www.aldiwan.net/poem15270.html","السريع"],[543,"أحس به عني قليلا تغيرا","https://www.aldiwan.net/poem48176.html","عموديه"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59751","الطويل"],[1009,"","https://poetry.dctabudhabi.ae/diwan/poem/17589","السريع"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96691","الطويل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80248","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64588","الوافر"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132888","الطويل"],[1415,"","https://poetry.dctabudhabi.ae/diwan/poem/102311","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108547","البسيط"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101042","الطويل"],[1763,"","https://poetry.dctabudhabi.ae/diwan/poem/146068","الطويل"],[2029,"","https://poetry.dctabudhabi.ae/diwan/poem/123710","الوافر"],[2083,"","https://poetry.dctabudhabi.ae/diwan/poem/205997","الطويل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77367","الطويل"],[2332,"","https://poetry.dctabudhabi.ae/diwan/poem/82204","الطويل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129835","الطويل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100895","البسيط"],[2697,"","https://poetry.dctabudhabi.ae/diwan/poem/107171","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204956","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204640","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62777","الطويل"],[3784,"","https://poetry.dctabudhabi.ae/diwan/poem/18581","الطويل"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66628","المنسرح"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102941","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83434","الطويل"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62146","الطويل"],[4389,"","https://poetry.dctabudhabi.ae/diwan/poem/178150","المتقارب"],[4790,"من بعض ما قال العراق","https://www.poetsgate.com/ViewPoem.aspx?id=109649",""],[4804,"لئن بعدت عن الاحباب دارُ","https://www.poetsgate.com/ViewPoem.aspx?id=92090",""],[4961,"وصلَّى خلفكَ العملُ المثالي","https://www.poetsgate.com/ViewPoem.aspx?id=37240",""],[5183,"سَعد وسُعَيد","https://www.poetsgate.com/ViewPoem.aspx?id=180217",""],[592,"أأشجاك أم أبكاك رسم النمازل","https://www.poetsgate.com/ViewPoem.aspx?id=128860",""],[5436,"قصيدة أسدلوا الستار","https://www.poetsgate.com/ViewPoem.aspx?id=36243",""],[5582,"أَهاجَ لَكَ التَّذْكارَ وَالوَجْدَ بارِقُ","https://www.poetsgate.com/ViewPoem.aspx?id=187213",""],[5582,"بريقٌ بِأَعْلَى الأَبْرَقَيْنِ تأَلَّقَا","https://www.poetsgate.com/ViewPoem.aspx?id=63544",""],[5760,"تركت الرَّاح إذا أبصرت رُشدي","https://www.poetsgate.com/ViewPoem.aspx?id=81249",""],[5906,"مَشَقة نظرة","https://www.poetsgate.com/ViewPoem.aspx?id=188069",""],[6199,"بغداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66252&r=&rc=5",""],[6305,"وَشَيْطانٍ يُقاسِمُني نَصِيبي !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87329&r=&rc=2",""]],"verses":[["أأشْتُمُ شَيْخاً لفّ عِرْقي بعِرْقِهِ","مَناسِبُ تَزْكو في قُرَيشٍ وتَشْرُفُ",0,"ف",1,0],["أأشيب كالوُلَيَّدِ رسمَ دار","تسائلُ ما أصَمَّ عن السَّؤولِ",1,"ل",1,0],["أأشقى بمن لو قلت يا خيرَ من مشى","على الأرض ما استثنى ضميريَ مُسْتَثْنَى",2,"ن",2,0],["أأشتمُ من لولاه لم يكُ للهُدى","صِراطٌ ولا للشَّمْلِ بالعدلِ ناظمُ",3,"م",1,0],["أَأَشكو نَداهُ بَعدَما وَسِعَ الوَرى","وَمَن ذا يَذُمُّ الغَيثَ إِلّا مُذَمَّمُ",4,"م",1,0],["أَأَشيمُ بارقةَ الغَمام وقد غدَتْ","يُمنَى أبي الحَسَنِ الغمامَ الصيِّبا",5,"ب",2,0],["أأشْغَلُ عَنْ رَيْحَانَتَيْكَ قَرِيحَتِي","بِشيحٍ ورَنْدٍ لا نَما الشِّيحُ وَالرَّنْدُ",6,"د",1,0],["أَأَشرَسُ إِن يَكُن ما قيلَ حَقّاً","وَأَحرِ بِهِ فَقَد ظَفِرَت يَداكا",7,"ك",2,1],["أَاشكوكُم إِلى الأَيّا","م أَم أَشكو لَكُم مِنها",8,"ه",2,0],["أَأُشْهِرُ سَيْفِي عَلَى نَابِحٍ","وَأَفْرِسُ للِثَّأْرِ قِرْداً وَكَلْباً",9,"ب",2,0],["أَأَشكو إِلى القانون غَدرَ مَعاشِري","وَقد أَصبَحَ القانونُ يوطِأ بِالرِجلِ",10,"ل",1,0],["أَأَشمِتُ أَعدائي وَأَعداءَ مَجدِكُم","بِأَبي وَإِيّاكُم شَريكانِ في الخُسرِ",11,"ر",1,0],["أَأَشرح حالي وأنت الّذي","لديكَ تفاصيلُها والجُمَلْ",12,"ل",1,0],["أأشرِي بِعرضي رِفدَ قومٍ مَعوضةً","وأُشعِرُ نفسي أنّ ذلك مكسَبُ",13,"ب",1,0],["أأشتكيكمْ أم إلى جورِكمْ","أشكو الذي قد حلَّ بي منكمُ",14,"م",1,0],["أَإِشراقةٌ من وجهِ مولايَ بُدِّلت","بإعراضِه يا ليتَ شِعريَ ما جرَى",15,"ر",2,0],["أأشبه من أهواه لحظاً ومعطفاً","وامضاء عزك حيث لجَّ نفاقه",16,"ق",2,0],["أَأَشرَبُ الخَمرَ عَلى هَجرِها","إِنّي إِذاً بِالهَجرِ مَسرورُ",17,"ر",1,0],["أأشرف مَن فاهت بهِ السنّ ومن","بهِ قطّعت قبل المرافقِ سملقا",18,"ق",2,0],["أَاشكُّ وَهما في وَجودكِ حَيثَما","شَخصت لِمطلعكِ العُيون تَحَيّرا",19,"ر",2,0],["أأشقى سيدي والذكر كسبي","وأنفاسي التبتل والدعاء",20,"ا",2,0],["أأشقى به غَرساً وأجنيه ذِلةً","إذن فاتباعُ الجهلِ قد كان أَحزَما",21,"م",2,0],["أأشقى بكم دهري ويحظى بوصلكم","دعي هوى من لوعة الوجد مغرم",22,"م",1,0],["أأشرقت في الدجى شمت مؤرخةٌ","أم أشرق الملك لما جاء مدحته",23,"ت",2,0],["أأشمت حسادي فأشكو وإنني","أراه على الأحرار غير حلال",24,"ل",1,0],["أأشقى بنيران ليسعد صاحبي","بضوء وطيب كالذبالة والكبا",25,"ب",2,0],["أأشكوك الغرام وما أقاسي","وقلبك يا مذيقي الهجر قاسي",26,"س",2,1],["أأشربها بعد الثمانين؟! إنني","إذن غير محمود وإن عمني الفقر",27,"ر",1,0],["أَأَشرَبُ سُمّاً ناقِعاً في زُجاجَةٍ","يَحِلُّ بِحاسيهِ الرَدى وَالمَعاطِبُ",28,"ب",1,0],["أأشتم يا مفروس في أن هجوتني","بني اسد إن إذاً لظلوم",29,"م",1,1],["أأشكوكَ أم أشكو إليكَ فما عدت","عداتيَ حتّى حان منك وثوبُ",30,"ب",1,0],["أأشتكى الجوع فى مائى وفى شجرى","ويشتكى ظالمى فى ظلها الشِّبعا",31,"ع",2,0],["أَأَشكُو الليالي أَم نِكايَةَ قَومِنا","فَليسَ أذاها مِن أَذاهُم بأعظَمِ",32,"م",1,0],["أأشقى والرقيب يعيش رغدا","سألعن للرقيب أبا وجدّا",33,"د",2,0],["أأشقى في حجاي ورب بله","تنعم بين جنات وحور",34,"ر",1,0],["أأشرَبُ فيه الصّابَ صرفاً وأهلُهُ","دِماؤهُم عندي تُعادِلُ شُهْدَهُ",35,"د",2,0],["أَأَشعَرتَ بي أَهلي عَشِيَّةَ زُرتَنا","جهاراً وَما عِندي وَقَد شَعَرَ الأَهلُ",36,"ل",1,0],["أَأَشْتَكِي الفَقْرَ وَالْخُمُولَ وَإنَّ","مِنْ عَطاياكَ المَالَ وَالْجَاها",37,"ا",3,0],["أأشكو زمانا فيه للجود باذل","أبي اللَه إلا أن يدوم به الوفد",38,"د",1,0],["أَأشغلها بِالغير عَن حاجَةٍ بِها","إليه وَما لي حاجةٌ لِسِوى المَولى",39,"ل",2,0],["أأشكر سعيي أم أقول تمثلاً","كما قالت الخنساء للسمرات",40,"ت",1,0],["أأشرب في الكأس كلا وحاشا","لأبصره في صفاء الشراب؟",41,"ب",1,0],["أأشكو والجميعُ يَرومُ ذبحي","من أشكو وكُلُّهُمُ نُصُولُ",42,"ل",1,0],["أأشقى يا عباد الله عمري","ويسعد أهل ودي حيث ساروا",43,"ر",3,0],["أأشربُ مِنْ معانيهِ زلالاً","أأدخلُ قصَّة َ العسل ِ المُسال ِ",44,"ل",1,1],["أأشجاه ترجيع الحمام فغردا","أم ارتاع منه إذ شدا فتنهدا",45,"د",2,1],["أأشجاك أم أبكاك رسم النمازل","لذكراك فيها كل هيفاء خاذل",46,"ل",1,1],["أَأَشْبَاهَ المُلُوكِ، بأَيِّ تاجٍ","سَيَفْخَرُ مَنْ كَرَامَتُهُ غُبَارُ؟",47,"ر",1,0],["أَأَشْرَفَ مَنْ لاثَتْ بِهِ حُلَلُ الثَّنا","وَأَفْخَرَ مَنْ زُمَّتْ إِلَيْهِ الأَيانِقُ",48,"ق",1,0],["أَأَشْرَفَ مَنْ فاهَتْ بِهِ أَلْسُنٌ وَمَنْ","بِهِ قَطَعَتْ فُتْلُ المَرافِقِ سَمْلَقَا",49,"ق",2,0],["أأشرب شربةً تزري بعِرضي","وأصبح ضحكةً لذوي الصَّلاح",50,"ح",1,0],["أَأْشْرَبُ أَم أَموتُ شَهيدَ عِشقٍ","وَ يُكتَبُ بِاسمِ قاتِلَتي نِضالي",51,"ل",2,0],["أ أشكوك للأرض ؟ والأرض تهوي","وتهوي على الأرض هام السّماء",52,"ا",2,0],["أ أشكو الدهرَ؟ والأجيالُ تشكو","مدى الأحقابِ زلاتِ الخطوب",53,"ب",1,0]]}