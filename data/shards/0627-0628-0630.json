{"poems":[[53,"ومروع لي بالسلام كأنما","https://www.aldiwan.net/poem30097.html","الكامل"],[73,"أجل إن ليلى حيث أحياؤها الأسد","https://www.aldiwan.net/poem11946.html","الطويل"],[47,"لست بالمستضيم من هو دوني","https://www.aldiwan.net/poem25137.html","الخفيف"],[51,"ألا قل لنحويك الأخفش","https://www.aldiwan.net/poem64923.html","المتقارب"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[268,"بما فيه سعد الجاهلين شقيت","https://www.aldiwan.net/poem35604.html","الطويل"],[269,"قف بذات السفح من اضم","https://www.aldiwan.net/poem52088.html","المديد"],[273,"لم أدر والسوسان قد أوفى على","https://www.aldiwan.net/poem25591.html","الكامل"],[303,"قد أكثبت فرص الجميل فبادر","https://www.aldiwan.net/poem56514.html","الكامل"],[318,"يا من بطول الهجر أصبح غادري","https://www.aldiwan.net/poem67095.html","الكامل"],[462,"إن يوم النوى شنيع سماعه","https://www.aldiwan.net/poem3396.html","عموديه"]],"verses":[["أَبذاكَ نَستَشفي وَمِن نَغَماتِه","تَتَوَلَّدُ الآلامُ وَالأَوجاعُ",0,"ع",1,0],["أَبٌ ذو اِعتِزامٍ أَو أَخٌ ذو تَسَرُّعِ","فَشَيحانُ ماضي الهَمِّ أَو فاتِكٌ جَلدُ",1,"د",1,0],["أَبذُلُ الحَقَّ لِلخُصومِ إِذا ما","عَجَزَت عَنهُ قُدرَةُ الحُكّامِ",2,"م",1,0],["أبٌّ ذو فِراشٍ ولكنه","لأيِّ البرية لم يُفرَش",3,"ش",1,0],["أبِذِكْرِ الآياتِ أُوفِيكَ مَدْحَاً","أيْنَ مِنى وأَيْنَ منها الوفَاءُ",4,"ا",2,0],["أُبذِّرُ أيّامي ومالي مُغامِراً","وأعجب بعد الموتِ كيفَ حييت",5,"ت",1,0],["أَبِذات البان أم عدلوا","ينشدون القلب في الخيم",6,"م",1,0],["أَبِذابِلٍ مِنْ فِضّةٍ مَسْبوكَةٍ","أمْ أنْمُلٍ تُومِي إليْكَ بِهِ يَدُ",7,"د",1,0],["اِبذل له مِن فضل جاهكَ لفتةً","تَرنو لهُ منها السعودُ بناظرِ",8,"ر",1,0],["أِبذا الدَلالَ تَظُنُّ صَرفَ نَواظِري","بِاللَهِ ضَع قَدَمَيكَ فَوقَ مَحاجِري",9,"ي",1,0],["ابذل الدمع فيه بذلَ جوادٍ","كلما زاد بُخله وامتناعه",10,"ع",2,0]]}