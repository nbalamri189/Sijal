{"poems":[[55,"ومروع لي بالسلام كأنما","https://www.aldiwan.net/poem30097.html","الكامل"],[75,"أجل إن ليلى حيث أحياؤها الأسد","https://www.aldiwan.net/poem11946.html","الطويل"],[49,"لست بالمستضيم من هو دوني","https://www.aldiwan.net/poem25137.html","الخفيف"],[53,"ألا قل لنحويك الأخفش","https://www.aldiwan.net/poem64923.html","المتقارب"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[275,"بما فيه سعد الجاهلين شقيت","https://www.aldiwan.net/poem35604.html","الطويل"],[276,"قف بذات السفح من اضم","https://www.aldiwan.net/poem52088.html","المديد"],[280,"لم أدر والسوسان قد أوفى على","https://www.aldiwan.net/poem25591.html","الكامل"],[310,"قد أكثبت فرص الجميل فبادر","https://www.aldiwan.net/poem56514.html","الكامل"],[325,"يا من بطول الهجر أصبح غادري","https://www.aldiwan.net/poem67095.html","الكامل"],[469,"إن يوم النوى شنيع سماعه","https://www.aldiwan.net/poem3396.html","عموديه"],[593,"","https://poetry.dctabudhabi.ae/diwan/poem/107085","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122676","الكامل"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39167","الخفيف"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72265","الخفيف"],[1115,"","https://poetry.dctabudhabi.ae/diwan/poem/138805",""],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80018","الرمل"],[2420,"","https://poetry.dctabudhabi.ae/diwan/poem/95995","الرجز"],[3519,"","https://poetry.dctabudhabi.ae/diwan/poem/145129","الرمل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131057",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111507","الكامل"],[5338,"دار النبي ومن بها ولد الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=187758",""],[5414,"صرخة من وراء الأسوار","https://www.poetsgate.com/ViewPoem.aspx?id=12936",""],[5431,"بات لثم الثغر أحلى","https://www.poetsgate.com/ViewPoem.aspx?id=189563",""],[5664,"الغيبوبه","https://www.poetsgate.com/ViewPoem.aspx?id=176683",""],[5732,"فات الشباب ولا بقى فيه لذات","https://www.poetsgate.com/ViewPoem.aspx?id=177834",""]],"verses":[["أَبذاكَ نَستَشفي وَمِن نَغَماتِه","تَتَوَلَّدُ الآلامُ وَالأَوجاعُ",0,"ع",1,0],["أَبٌ ذو اِعتِزامٍ أَو أَخٌ ذو تَسَرُّعِ","فَشَيحانُ ماضي الهَمِّ أَو فاتِكٌ جَلدُ",1,"د",1,0],["أَبذُلُ الحَقَّ لِلخُصومِ إِذا ما","عَجَزَت عَنهُ قُدرَةُ الحُكّامِ",2,"م",1,0],["أبٌّ ذو فِراشٍ ولكنه","لأيِّ البرية لم يُفرَش",3,"ش",1,0],["أبِذِكْرِ الآياتِ أُوفِيكَ مَدْحَاً","أيْنَ مِنى وأَيْنَ منها الوفَاءُ",4,"ا",2,0],["أُبذِّرُ أيّامي ومالي مُغامِراً","وأعجب بعد الموتِ كيفَ حييت",5,"ت",1,0],["أَبِذات البان أم عدلوا","ينشدون القلب في الخيم",6,"م",1,0],["أَبِذابِلٍ مِنْ فِضّةٍ مَسْبوكَةٍ","أمْ أنْمُلٍ تُومِي إليْكَ بِهِ يَدُ",7,"د",1,0],["اِبذل له مِن فضل جاهكَ لفتةً","تَرنو لهُ منها السعودُ بناظرِ",8,"ر",1,0],["أِبذا الدَلالَ تَظُنُّ صَرفَ نَواظِري","بِاللَهِ ضَع قَدَمَيكَ فَوقَ مَحاجِري",9,"ي",1,0],["ابذل الدمع فيه بذلَ جوادٍ","كلما زاد بُخله وامتناعه",10,"ع",2,0],["ابذل لموطنك العزيز أعز ما","أحرزت من وعظ ومن تذكير",11,"ر",1,0],["أبِذي الأراكَةِ مَنزِلٌ أو مَطرِفُ","أخلَفنَهُ السَّنَواتُ وَهوَ مُفَوَّفُ",12,"ف",1,1],["ابْذُلِ المالَ لا تُبالِ بِبَذْلِهْ","قَبلَ تَرحالِهِ ونأْيِ مَحَلِّهْ",13,"ه",1,1],["أبذنب أصابها قدر اللّه","فللأرض كالأنام ذنوب",14,"ب",1,0],["أبذل روحي فيه وما ملكت","يدي وللمرء وسع طاقته",15,"ت",2,0],["أبذاك الترب واروا فاطماً","أم إليها العالمُ القدسيُّ وافى",16,"ف",2,0],["أبذا اذى بوذيت من كلبٍ ذكر","اسودَ فزّاحٍ يعوِّي في السحر",17,"ر",1,0],["ابذلوا أرواحكم من دونها","تبذلوا في برها أقصى الجهود",18,"د",1,0],["أبذا استعضت عن الأمي","رِ وهل صغير كالكبير",19,"ر",1,0],["أبذينك القومين تفتكر","والحرب بينهم ستستعر",20,"ر",1,0],["أَ بِذَالِكُمْ أَوْصَى النَّبِيّ مَعَاشِرًا","وَفَّوْا بِعَهْدِ الشِّرْكِ أَيَّ وَفَاءِ؟",21,"ا",2,0],["أبذل النفسَ والنفيس لديني","لا أبالي الخطوبَ والأخطارا",22,"ر",2,0],["أبذلُ الروح سخيّا","أزرع الأحلام نخلا",23,"ل",2,0],["ابذبح حزني من اقصى الشعور لأول الاخوان","وأسيل عمره وتشرب عيون العمر دمعاته",24,"ت",2,0],["ابذل وسيد النسا راع المروات","ولا ينفعك مال إلى مت مخزون",25,"ن",1,0]]}