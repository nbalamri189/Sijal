5","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125879","الكامل"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93281","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123486","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94686","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73241","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73095","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28723","البسيط"],[4445,"","https://poetry.dctabudhabi.ae/diwan/poem/139145","البسيط"],[4542,"","https://poetry.dctabudhabi.ae/diwan/poem/76556","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120490","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120523","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120515","السريع"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120480","الكامل"],[4639,"","https://poetry.dctabudhabi.ae/diwan/poem/124661","الرجز"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52177","البسيط"],[4755,"سَكْبًا عليهِ مِن الهُمُومِ ورَشّا","https://www.poetsgate.com/ViewPoem.aspx?id=200849",""],[4968,"مصابيح الدجى 2","https://www.poetsgate.com/ViewPoem.aspx?id=208102",""],[3591,"يا دار مية دمع العين هطَّال","https://www.poetsgate.com/ViewPoem.aspx?id=149395",""],[3591,"إن كان دهرك قبلاً غير محمود","https://www.poetsgate.com/ViewPoem.aspx?id=149454",""],[5219,"ما حيلتي","https://www.poetsgate.com/ViewPoem.aspx?id=194917",""],[5219,"أضغاث أحلام","https://www.poetsgate.com/ViewPoem.aspx?id=195012",""],[2365,"وملاحظ بالطّرف يرقب واشيا","https://www.poetsgate.com/ViewPoem.aspx?id=200651",""],[5338,"قالوا: تعزل قلت: هذي كربلا","https://www.poetsgate.com/ViewPoem.aspx?id=190099",""],[5350,"أَلا صَرَمت حَبائِلَنا جَنوبُ","https://www.poetsgate.com/ViewPoem.aspx?id=79356",""],[5362,"رزء به للدين طاح دعام","https://www.poetsgate.com/ViewPoem.aspx?id=170391",""],[5431,"لعشتُ في الحوت لمْ تنفك أطواقي","https://www.poetsgate.com/ViewPoem.aspx?id=185286",""],[5582,"هَذِي أُمَيْمٌ تَجَلَّى شَخْصُها وَبَدَا","https://www.poetsgate.com/ViewPoem.aspx?id=63503",""],[5660,"أَنتَ الشَريفُ شَريفٌ في مُحَيّاكَ","https://www.poetsgate.com/ViewPoem.aspx?id=23714",""],[5674,"شوقا إلى الفرات أصوم وأفطر","https://www.poetsgate.com/ViewPoem.aspx?id=186708",""],[4623,"أعلى الزمان أخذت عهد أمان (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146772",""],[5781,"طُيوفكَ المنى ...وحبق","https://www.poetsgate.com/ViewPoem.aspx?id=208930",""],[5829,"العبد التائب","https://www.poetsgate.com/ViewPoem.aspx?id=148784",""],[5854,"همًّ تعرّاني فبتُّ أسِيفا ((اعتذار إلى أخ حبيب))","https://www.poetsgate.com/ViewPoem.aspx?id=191828",""],[5956,"العاشقات دخلن عمري فجأة","https://www.poetsgate.com/ViewPoem.aspx?id=182270",""],[5956,"ميمي هربتِ؟","https://www.poetsgate.com/ViewPoem.aspx?id=182276",""],[5956,"مقدمة عن فن الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=185693",""],[5956,"جُبُّ الكهولة الخانق","https://www.poetsgate.com/ViewPoem.aspx?id=192138",""],[5956,"يتسلل النور الجميل لمهجتي","https://www.poetsgate.com/ViewPoem.aspx?id=194211",""],[5956,"الصديقُ الحقيقيُّ","https://www.poetsgate.com/ViewPoem.aspx?id=200968",""],[5956,"لسامية السّالك اسم آخر هو: عناية بالنازح","https://www.poetsgate.com/ViewPoem.aspx?id=207515",""],[5956,"صلواتٌ في ذكرى الخليل بن أحمد الفراهيدي","https://www.poetsgate.com/ViewPoem.aspx?id=215185",""],[6035,"لمْ يَكْفِني دمعي .. !","https://www.poetsgate.com/ViewPoem.aspx?id=168759",""],[6101,"بشرى السماء / حسن الأفندي","https://www.poetsgate.com/ViewPoem.aspx?id=120279",""],[6127,"يا نونُ ... يا قلمُ","https://www.poetsgate.com/ViewPoem.aspx?id=188718",""],[6251,"عزة النفس .. إلى الرئيس إبراهيم الحمدي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76482&r=&rc=22",""],[6290,"الْقَنْطَرَةُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85654&r=&rc=43",""],[6333,"الموت حبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7086&r=&rc=8",""],[6352,"هي دار غيبته فحي قبابها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22743&r=&rc=4",""]],"verses":[["لَولا مُشارَكَةُ المَدامِعِ في","سُقياهُ قَلَّ لَهُ نَدى القَطرِ",0,"ر",1,0],["لَولا مُكاثَرَةُ الدُموعِ عَشِيَّةً","لَعَرَفتُ رَسمَ المَنزِلِ المُتَأَبِّدِ",1,"د",1,0],["لولا مَساعيكَ لم أهْدِرْ بقافيَةٍ","يكادُ يَسْتَرْقِصُ الأسْماعَ راويها",2,"ي",3,0],["لَولا مَحَبَّتُكُم لَما عاتَبتُكُم","وَلَكُنتُمُ عِندي كَبَعضِ الناسِ",3,"س",1,0],["لَولا مَخافَةُ أَن تُصيبَكِ دَعوَتي","لَدَعَوتُ يا سَكَني عَلى الكَذّابِ",4,"ب",1,0],["لوْلا مَقامٌ للضّراعَةِ قُمْتَهُ","فمَحا خطِيّاتِ الوَرى اسْتِغْفارُهُ",5,"ر",2,0],["لَوْلاَ مَعُونَةُ ذَاكَ الحِلفِ لاَنْقَلَبوا","دُونَ الَّذِي أَمَّلُوهُ شَرَّ مُنْقَلَبِ",6,"ب",1,0],["لولا مآثرهم وفضلُ علاهمُ","ما كانََ يُعزى الفضلُ للمتقدِّمِ",7,"م",1,0],["لَولا مُراقَبَةُ العُيونِ أَرَينَنا","مُقَلَ المَها وَسَوالِفَ الآرامِ",8,"م",1,0],["لولا مشيبي ما جفتْ","لولا جفاها لم أشب",9,"ب",1,0],["لولا معاني السحر من لحظاتِها","ما طال تردادِي إلى أبياتها",10,"ت",3,1],["لولا مديحك ما اخترت القريض ولا","والله ما دار في فكري ولا خلدي",11,"د",2,0],["لولا مشورتكم لَنَاطَحَ جَدَّه","جدٌّ يُبِيرُ مُنَاطِحِيه نِطاحُه",12,"ح",2,0],["لولا منازعةُ الجسوم نفوسَهم","نفذوا بسَوْرتها من الأقطارِ",13,"ر",1,0],["لولا مكان الحمد من قاسم","أوشك أن تكسد أسواقه",14,"ق",2,0],["لَولا مَدارِسُ شُدتَها وَكَنائِسٌ","ما كانَ إِلّا الجَهلُ وَالتَعطيلُ",15,"ل",1,0],["لولا مفارقة الذين نخصهم","بالود كان الموت أعذب مورد",16,"د",1,0],["لولا مفاخر أفراد نعدّهمو","لعاش ذو العقل حيا بين أموات",17,"ت",1,0],["لَولا مُغالَبَةُ الشُجونِ لِخاطِري","لَنَظَمتُ فيكَ يَتيمَةَ الأَزمانِ",18,"ن",1,0],["لَولا مَكانٌ لِعيسى عِندَ مُرسِلِهِ","وَحُرمَةٌ وَجَبَت لِلروحِ في القِدَمِ",19,"م",1,0],["لَولا مَواهِبُ في بَعضِ الأَنامِ لَما","تَفاوَتَ الناسُ في الأَقدارِ وَالقِيَمِ",19,"م",1,0],["لولا مُحَسَّدُ بل لولا الحسين لما","رأيت رأيي بوهن العزم مختلطا",20,"ط",2,0],["لَولا مَواهِبُ يُخفيها وَيُعلِنُها","لَقُلتُ ما حَدَّثوا عَن حاتِمٍ كَذِبُ",21,"ب",1,0],["لَولا مُكاثَرَةُ الخُطوبِ وَنَحتُها","مِن جانِبَيَّ لَكُنتَ مِن حاجاتي",22,"ت",2,0],["لولا مساعدةُ الدموعِ ودَفْعُها","خوفُ الفِراقِ أتى على حَوبائِه",23,"ا",3,0],["لولا مكارمُ يحيى والحياةُ بها","ما رُدّ روحُ الغنى في ميّتِ العدمِ",24,"م",1,0],["لَولا مُناشَدَةُ القُربى لَغادَرَكُم","حَصائِدَ المُرهَفَينِ السَيفِ وَالقَلَمِ",25,"م",1,0],["لَوْلا مُدَاوَلَةُ الأَفْكَارِ مَا ظَهَرَتْ","خَزَائِنُ الأَرْضِ بَيْنَ السَّهْلِ وَالْعَلَمِ",26,"م",1,0],["لولا مَواقِفُكم وصِدقُ بلائِكم","تحمونَ أبناءَ البلادِ لبادوا",27,"د",3,0],["لولا مُراقبةُ الجلاءِ وأنّه","داني المدى لرأوه أوّلَ جالِ",28,"ل",1,0],["لَولا مَواضيهِ وَالأَهوالُ مُحدِقَةٌ","بِالمُلكِ أَصبَحَ في أَيدي العِدى سَلَبا",29,"ب",2,0],["لولا مقالةُ عبدِ اللهِ ما انْكشفتْ","تِلكَ الغَواشِي ولولا اللَّهُ لم يَقُلِ",30,"ل",1,0],["لولا مَرَاشِدُهُ تُقَوِّمُ خَلْقَهُ","لم يعرفوا الإصلاحَ والتقويما",31,"م",2,0],["لولا مَخافَةُ رَبٍّ كانَ عَذَّبَها","عَرجاءَ تَظَلُع في أَنيابِها عَشَمُ",32,"م",1,0],["لَولا مُراقَبَةُ العُيو","نِ إِذا شَزَرنَ وَقيلُ قائِل",33,"ل",1,0],["لولا مَناقِبُكُمْ لَكانت هذه الدُّ","نيا مِنَ الذِّكْرِ الجَميلِ مُعَطَّلَهْ",34,"ل",2,0],["لولا مَعَدٌّ والخلافَةُ لم أكُنْ","أعتَدُّ من عمري بما أستَقبِل",35,"ل",1,0],["لَولا مُقامُهُم بِها","هَوَتِ الرَواسي مِن ثَبيرِ",36,"ر",1,0],["لَولا مُداراةُ حاسيها إِذا اِقتَرَبَت","مِن فيهِ لَاِنتَهَبَت مِن مُقلَةِ الحاسي",37,"س",2,0],["لولا مفارقة الأحباب ما وجدت","لها المنايا إلى أرواحنا",38,"ن",2,0],["لولا مصابٌ دهى الوادي فشبَّ به","ناراً وهاج النسيم العذب إعصارا",39,"ر",2,0],["لولا مَساعِيكَ لم نَعْدُدْ مَساعِينا","ولم نُسامِ بأحكامِ العُلى مُضَرا",40,"ر",2,1],["لَوْلا مِسَاسُ الطَّلِّ أَحْرَقَ ضَوْؤُهُ","ذَيْلَ الْخَمَائِل رَطْبِهَا وَالْعَاسِي",41,"س",2,0],["لَوْلا مُكَابَدَةُ الأَشْوَاقِ ما دَمَعَتْ","عَيْنٌ وَلا بَاتَ قَلْبٌ فِي الْحَشَا يَجِبُ",42,"ب",1,0],["لَولا مُصاب الدَمعِ يَومَ مُصابه","ذابَت صُخورُ الحَزنِ وَالبَطحاءِ",43,"ا",2,0],["لولا مدائحُكم ما كان لي قَلَمٌ","يوماً على الأيْكِ وابنِ الأيك تيَّاها",44,"ا",3,0],["لولا معاقلِ قسطنطينَ، لانطَمَستْ","آثارُ دولتهِ، وانْفَضَّ سامرهْ",45,"ر",2,0],["لوَلا مُفارَقَةُ الأَحبابِ ما وَجَدَتْ","لَها المَنايا إِلى أَرواحِنا سُبُلا",46,"ل",2,0],["لولا محيطٌ بِتُّ من نَزَعاته","وتضارب الآراءِ كالمرتاب",47,"ب",1,0],["لَوْلاَ مِسَاسُ الطَّلِّ أَحْرَقَ ضَوْؤُهُ","ديلَ الخمائلِ : رَطبِها والعاسى",48,"س",2,0],["لولا مثاني معانيهم لم اضطربت","منا القلوب ولا لذت لنا السير",49,"ر",1,0],["لولا مسللة انقضاء وحكمه","هي للزمان فعائل لا تحمد",50,"د",1,0],["لولا مآثر آبائي الذين خلوا","في الشام لم ينجذب بيت على طنب",51,"ب",1,0],["لولا معاطفةٌ في الحب تلعب بي","ما بتُّ أتلو حروفَ الشوقِ والغزلِ",52,"ل",1,0],["لولا مضاربه ساوى العصىَّ ولم","يحز إذا ما التقى الجمعانُ تفضيلا",53,"ل",2,0],["لولا مرادُ الله فيك لتلتقي","تلك الظنون الكاذبات وتذهبُ",54,"ب",1,0],["لولا منافعُ للعافينَ في كَنَفي","لكانَ قربُ جوارِ اللهِ أَنفعَ لي",55,"ي",1,0],["لولا مخافة ظالم من ظالم","لغدا عليك جميع هذا العالم",56,"م",1,1],["لولا مَدامعُ عُشّاقٍ ولَوعتُهم","لَبَانَ في الخَلق غيرُ الماءِ والنارِ",57,"ر",1,1],["لولا مَلاحةُ قَدٍّ منك تُعجبني","وحُسن طرفٍ مليح اللَّحظ سَحّارِ",58,"ر",1,0],["لولا مثالك في باريس ألمحهُ","في طلعة البدر أو في نضرة الفنَن",59,"ن",1,0],["لولا محيّاك والقوام","لم يخلق الوجد والغرام",60,"م",1,1],["لو لامَسَ الوَهْمَ الخفيْ","يَ أديمَه لجرى دَمُهْ",61,"م",2,0],["لولا مَعَدٌّ أميرُ المؤمنين لَمَا","عَزَّ الهُدى وفَشَتْ في عَصْرنا النِّعَمُ",62,"م",1,0],["لولا معنى يلوح بين الخيم","ما عجت ولا وقفت عند العلم",63,"م",1,1],["لَوْلاَ مَدِيحُ هُمَامٍ","مِنَ الْغَبَاوَةِ يَشْفِي",64,"ف",2,0],["لولا مطاوعةُ الهوى وتبذُّلي","ما كان نجمُ السَّعدِ من فلكي هوى",65,"و",2,0],["لَولا مَديحُكَ صانَها شَرَفاً","عُدَّت لرقَّتها من السِحرِ",66,"ر",1,0],["لولا (محمدُ) ظلَّ الناسُ بعضهمُ","ربّاً لبعضٍ وما كان الهدى رجحا",67,"ح",2,0],["لولا مشاهدُ سحرٍ تستفزُّ لما","مجَّتْ دمَ القلبِ فوقَ الطرسِ أقلامي",68,"م",2,0],["لَولا مَخافةُ أَن أُشابه عصبةً","قَد سُكّرَت أبصارُهم وتحيّروا",69,"ر",3,0],["لَولا مُنى العاشِقينَ ماتوا","غَمّاً وَبَعضُ المُنى غُرورُ",70,"ر",1,0],["لَولا مُفارَقَةُ الرِيَب","ما كُنتَ مِمَّن يَحتَجِب",71,"ب",1,1],["لَولا مَدامع أَجفان بِها خَمدت","نار الأَسا ذابَ مِن حر