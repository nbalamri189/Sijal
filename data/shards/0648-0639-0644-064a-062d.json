{"poems":[[48,"صاح ما تضحك البروق شماتا","https://www.aldiwan.net/poem22423.html","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39548","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39569","الخفيف"],[47,"لأخي الحُبّ عَبرَةٌ ما تَجِفُّ","https://www.poetsgate.com/ViewPoem.aspx?id=32543",""],[119,"صاح يمم ان رمت نيل الاماني","https://www.aldiwan.net/poem40476.html","عموديه"],[119,"أرأيت يا حلول الشمائل","https://www.aldiwan.net/poem40609.html","عموديه"],[119,"لذ بباب الغوث الجليل الرفاعي","https://www.aldiwan.net/poem41778.html","الخفيف"],[119,"هجم الليل بعد فر النهار","https://www.aldiwan.net/poem41779.html","الخفيف"],[211,"يا أيها الرجل الذي تهوي به","https://www.aldiwan.net/poem27944.html","الكامل"],[228,"ذلك الطير لم عراه ذهول","https://www.aldiwan.net/poem39724.html","الخفيف"],[280,"وعلى حفصية فهرية","https://www.aldiwan.net/poem25587.html","الرمل"],[409,"هات واسق الذهن من خمر العلوم","https://www.aldiwan.net/poem33343.html","مجزوء الرمل"],[415,"إن لم تطيقا يوم رامه","https://www.aldiwan.net/poem32384.html","مجزوء الكامل"],[470,"يا صاحب العيدين","https://www.aldiwan.net/poem36542.html","عموديه"],[543,"قد سقانا جرعة يوم الفراق","https://www.aldiwan.net/poem47544.html","عموديه"],[563,"هذه الكائنات أم هي حانه","https://www.aldiwan.net/poem33691.html","الخفيف"],[563,"ذهب الخوف والرجا","https://www.aldiwan.net/poem34695.html","مجزوء الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87150","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87103","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86695","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48689","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48565","الرمل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64249","الرمل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/16875","المديد"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56162","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136175","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136316","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79960","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108838","الخفيف"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108578","الكامل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104796","الرمل"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96031","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137210",""],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74052","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62923","الرمل"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101227","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117843","الرمل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86381","الرمل"],[4045,"","https://poetry.dctabudhabi.ae/diwan/poem/34753","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90863","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90807","الرمل"],[4279,"","https://poetry.dctabudhabi.ae/diwan/poem/101972","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73097","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136560",""],[4858,"عريس مسلم وعرس إسلامي","https://www.poetsgate.com/ViewPoem.aspx?id=32792",""],[4119,"ما هذه الحدث الفواتن","https://www.poetsgate.com/ViewPoem.aspx?id=16246",""],[5049,"المسكنة الله","https://www.poetsgate.com/ViewPoem.aspx?id=186335",""],[5431,"((أني معك!))","https://www.poetsgate.com/ViewPoem.aspx?id=198345",""],[5490,"وللحديث شجون","https://www.poetsgate.com/ViewPoem.aspx?id=176364",""],[5535,"دنيا المحب ودينه أحبابه","https://www.poetsgate.com/ViewPoem.aspx?id=201492",""],[5689,"حمام أم تنور أم بركان","https://www.poetsgate.com/ViewPoem.aspx?id=143412",""],[5797,"عجبًا لابن آدم","https://www.poetsgate.com/ViewPoem.aspx?id=187797",""],[6023,"يا إماماً له الفضائل تُعزى","https://www.poetsgate.com/ViewPoem.aspx?id=123885",""],[658,"لَوَّمتَهُ وَعَنَفتَ في تَعنيفِه","https://www.poetsgate.com/ViewPoem.aspx?id=45927",""],[6102,"حسب الدموع","https://www.poetsgate.com/ViewPoem.aspx?id=183652",""],[6127,"تموز","https://www.poetsgate.com/ViewPoem.aspx?id=198708",""]],"verses":[["وَعَلى حالِها تَدومُ اللَيالي","فَنَحوسٌ لِمَعشَرٍ أَو سَعودُ",0,"د",1,0],["وعلى حديثِك في فمِ الحِقَبِ","سِمَةُ الخلودِ ونفحة القِدَمِ",1,"م",1,0],["وعلى حين غرةٍ رنَّ صوتٌ","لم يُعَوَّدْ سماعَه إنسيُّ",2,"ي",1,0],["وَعَلَى حَالَتَيْكَ يَسْتَصْلِحُ الناسَْ","إباءٌ من جانبَيْكَ، وَعَطْفُ",3,"ف",1,0],["وعلى حزبه واتباعه الغ","ر اسود الهيجاء في الميدان",4,"ن",1,0],["وعلى حواشي خدك ال","وردي ليل الشعر عامل",5,"ل",1,0],["وعلى حزبه الأكارم أهل اللَ","ه أهل الإحسان والاصطناع",6,"ع",1,0],["وعلى حزبه الجليل ذوي الدي","وان والأوليا ذوي الأطوار",7,"ر",1,0],["وَعَلى حُنَينٍ قَد وَفى مِن جَمعِنا","أَلفٌ أُمِدَّ بِهِ الرَسولُ عَرَندَسُ",8,"س",1,0],["وَعَلى حُبِّنا مِن الخُلدِ زَهرٌ","وَعَلَيهِ مِن روحِهِ تَقبيلُ",9,"ل",1,0],["وعُلى حَفْصِيّةٍ فِهْرِيّةٍ","ذَهَبتْ وَأْداً بِعَلْيا أُدَدِ",10,"د",1,1],["وعلى حضرتكم أسنى السلام","أيها الأمجاد",11,"د",1,0],["وعليَّ حقٌّ أن تُصا","فِحُ سُحبُ أجْفانِي رَغَامَهْ",12,"م",2,0],["وعَلى حضورِكَ والغيابِ قصائدي","أجراسُها قَرْعَ الكَنائس ِتَقرَعُ!",13,"ع",1,0],["وعلَى حَاشيَةٍ حفَّت بكُم","ظُرَفاءُ النُّطقِ مشدودُو النِّطَاق",14,"ق",1,0],["وعلى حضرة النبي نزلنا","منه حتى بنا تلا قرآنه",15,"ن",2,0],["وعلى حيِّ ربَّةِ ال","خال بالقلب عَرِّجا",16,"ج",2,0],["وَعليّ حرّمَ وَصلَه وَأَتى عَلى","تَحليل نَقض العَهد بِالبُرهان",17,"ن",1,0],["وَعَلى حياض ثَنائه في الداوري","وَرد المصلِّي وَالتقيُّ الصائم",18,"م",1,0],["وَعَلى حلمك الأَدلةُ قامَت","في جَميع الأُمور مِن غَير رد",19,"د",1,0],["وعليَّ حقك لا أوفّيه وإن","أملأ طريقك لؤلؤاً منثورا",20,"ر",2,0],["وعلى حسنك أبدى الحذرا","من عدو طامح العين عنيدْ",21,"د",1,0],["وعلى حال سرور ال","نفسِ منّي وأساها",22,"ا",3,0],["وَعَلى حيطانِهِ أُسدُ حَربٍ","فَوقَ أَمهارٍ وَفَوقَ مَهارِ",23,"ر",1,0],["وعلى حقيقة ما رأيت كلاهما","متساويان وساعيان على شططْ",24,"ط",1,0],["وعلى حبيب الله اشرف مرسل","مني الصلاة واله الامجاد",25,"د",1,0],["وعلى حضرة العيان قدمنا","بين علم ومستهام معلم",26,"م",1,0],["وعلى حياض سماحه اختلف الورى","شرقاً وغرباً مصدراً وورودا",27,"د",2,0],["وعلى حبه التقى","يقتل الناس بالتهم",28,"م",1,0],["وعلى حدائقنا التي ثنى بها","فوك الشقيق وخدك التفاحا",29,"ح",2,0],["وَعَلى حَمزِةَ وَالعَبَّاسِ بَل","سِبطِ سَيدِ المُرسَلِينَ الشُّهَرَا",30,"ر",2,0],["وعلى حنين أين يذهب جاهد","لما ثبت به وراح شريدا",31,"د",2,0],["وعلى حبها نشا واليها","قد دنا في شبابه وتدلى",32,"ل",2,0],["وَعليّ حرّض طرفه","اللَّه من تَحريضهِ",33,"ض",2,0],["وعلى حُجر أَمالت أسدٌ","قَصَباً فيهِ لِغُلْبِ الأسْدِ زَارُ",34,"ر",1,0],["وعلى حنين كم حنين قام في","جمع العدى من بأسه في بيدها",35,"د",3,0],["وعلى حل عرى الإسلام والس","لم مرداً وكهولاً مردوا",36,"د",3,0],["وعلى حبك أطوي أضلعا","لو جرى الماء بها لاستعرا",37,"ر",2,0],["وَعَلى حُسنِ ساكِنِ الجُبّ لَمّا","أَخرَجَتهُ مِن جُبِّهِ السَيّارَه",38,"ر",2,0],["وعلى حنين العود حنت وانحنت","هزجا بلحن معرب الحركات",39,"ت",1,0],["وعلى حزن عظيم أشرفت","لكن المولى لطيف وخبير",40,"ر",1,0],["وعلى حديث الألمعي لروحه","يدير عليه الكاس صفواً ويشرب",41,"ب",1,0],["وعلى حمى النَّخَلاتِ حيٌّ لم تزل","محمَّيةً بِظُبا السُّيوفِ ظِباؤُه",42,"ا",3,0],["وعلى حَنين النُوق حنَّ لهم","قلبٌ به الزفرات تَستعر",43,"ر",1,0],["وعلى حَياءٍ جاءَ يَسْعى قاضياً","بعضَ الحقوقِ، وإنَّهُ لَخَجُولُ",44,"ل",1,0],["وعلي حسن الظن فيك","وقد يكون الظن كاهن",45,"ن",1,0],["وعلى حمل ما سماء وارض","أبياه اجعله قويا أمينا",46,"ن",2,0],["وعلى حكايات القميص","معلقا..ماضيّعك!!",47,"ك",1,0],["وعلى حدودِ العقل فرّتْ فكرةٌ","شكٌ يطارحُ واقعاً ، ويقينُ",48,"ن",1,0],["وعلى حماه جلالةٌ من أهله","فلذاك طارقة العيون تهابه",49,"ب",2,0],["وعلى حدود جنوبها تبدو لنا","لحمى المقادر والقضا خلجان",50,"ن",1,0],["وعلى حوله الصواعقُ دلّت","حيث تبدو من هولها في ابتهال",51,"ل",1,0],["وعلى حمل صخرةٍ ذُو اقتدارٍ","ثُّم عن حمل إبرةٍ نال عجزا",52,"ز",2,0],["وَعَلَى حًسامِ الدّينِ صَيفُ مَصيفِهِ","وابي عَفيفِ الدّينِ وابنِ عَفيفِه",53,"ف",2,0],["وَ عَلَى حَرِيرِ الحُلْمِ تَقْضِينَ الكَرَى","وَ أَبِيتُ - فِي شَوكِ السُّهَادِ - عَلَى الأسِنَّهْ",54,"ن",2,0],["وعلى حواشيها بقايا زمرةٍ","سَجَدَتْ لِوَشْلِ خسيسها كي تظفرا",55,"ر",2,0]]}