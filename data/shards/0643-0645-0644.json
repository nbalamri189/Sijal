em/54204","الخفيف"],[106,"حفل المولد","https://www.poetsgate.com/ViewPoem.aspx?id=179555",""],[106,"تحية موجزة","https://www.poetsgate.com/ViewPoem.aspx?id=179384",""],[106,"المادة","https://www.poetsgate.com/ViewPoem.aspx?id=179426",""],[106,"يا ملاذ الموظفين","https://www.poetsgate.com/ViewPoem.aspx?id=179706",""],[106,"محنة فرنسا","https://www.poetsgate.com/ViewPoem.aspx?id=179418",""],[106,"ثورة على الحضارة","https://www.poetsgate.com/ViewPoem.aspx?id=179425",""],[106,"نيسان","https://www.poetsgate.com/ViewPoem.aspx?id=179310",""],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[106,"تمثال فينوس","https://www.poetsgate.com/ViewPoem.aspx?id=179776",""],[106,"راهب الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=179334",""],[106,"الكلب هول","https://www.poetsgate.com/ViewPoem.aspx?id=179445",""],[90,"عُدنا وقودا","https://www.poetsgate.com/ViewPoem.aspx?id=179221",""],[45,"بِتُّ أُبْدي وَجْداً وَأكْتُمُ وَجْدا","https://www.poetsgate.com/ViewPoem.aspx?id=32950",""],[45,"قُلْ لأبي جَعْفَرٍ، وإنّ لَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=32107",""],[91,"الحرب العظمى","https://www.poetsgate.com/ViewPoem.aspx?id=53314",""],[3,"قف بالمنازل ان شجتك ربوعها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10711&r=&rc=65",""]],"verses":[["كَم لَيلَةٍ مِثلِكِ أَنضَيتُها","وَالراحُ تُزجى مِن إِزارِ النَديم",0,"م",1,0],["كَم لِسانٍ دَنا إِلَي","كَ بِقَلبٍ مُنافِقِ",1,"ق",1,0],["كَم لَيلَةٍ جَرَّعتَهُ في طولِها","غُصَصَ المَلامِ وَمُؤلِمَ التَقريعِ",2,"ع",1,0],["كَم لَوعَةٍ تُهدى إِلى كَبِدي","وَعَظيمَةٍ تُلقى عَلى كَتَدي",3,"د",2,0],["كَم لَبِستُ الطولَ مِنكُم","بَدَلَ البُردِ القَشيبِ",4,"ب",1,0],["كَم لَيلَةٍ سِرتُ في البَيداءِ مُنفَرِد","وَاللَيلُ لِلغَربِ قَد مالَت كَواكِبُهُ",5,"ب",2,0],["كَم لَيلَةٍ قَد قَطَعنا فيكِ صالِحَةٍ","رَغيدَةٍ صَفوُها ما شابَهُ كَدَرُ",6,"ر",1,0],["كَم لَيلَةٍ عانَقتُ فيها غادَةً","يَحيا بِها عِندَ المَنامِ ضَجيعُها",7,"ع",3,0],["كمْ لُذْتُ بالدّهْرِ أنْ يُدْني النّوَى فأبَى","وبالتّعَلُّلِ أنْ يُجْدي فَما فعَلا",8,"ل",2,0],["كمْ لي بصحّةِ عقْدِهِ منْ شاهِدٍ","لا يحْذَرُ التّجْريحَ والتّدْليسا",9,"س",2,0],["كمْ ليلةٍ بتُّها والطّيْفُ يشهدُ لي","لمْ تطْعَمِ النّوْمَ أجْفاني ولمْ تذُقِ",10,"ق",1,0],["كَمْ لِي بِرَبْعِكَ مِنْ أُنْسٍ وَمِنْ طَرَبٍ","كَأَنَّمَا كَانَ حُلْماً جَرّه الْوَسَنُ",11,"ن",1,0],["كمْ لُؤلُؤٍ نَثَرَ الحَديثُ عُقودَهُ","نُظِمَتْ لشَمْلِ الوُدِّ منْهُ عُقودُ",12,"د",1,0],["كَمُلْتَ فَلَمْ تَلْحَقْ عُلاَكَ النَّقَائِصُ","سَمَوْتَ فَلَمْ يُدْرِكْ مَحَلَّكَ شَاخِصُ",13,"ص",1,0],["كمْ لَيالٍ بتُّ في ظَلْمائِها","أمْتَطي منْ نارِ شوْقِي فُرُشا",14,"ش",2,0],["كَم لي أَحاديثُ شَوقٍ لا تُنافِحُها","زَهرُ الرِياضِ وَلا يَسمو بِها الحاكي",15,"ك",2,0],["كَم لَهُ مِن باقِياتٍ في الهُدى","وَالنَدى بَينَ شُروقٍ وَغُروبِ",16,"ب",1,0],["كَمُلتَ كَمالاً لَو تَناوَلَ كُفرَهُ","لَأَصبَحَ إيماناً بِهِ يُتَحَنَّفُ",17,"ف",1,0],["كَم لَيلَةٍ قَد بِتَّ فيها لا تَرى","إِلّا ظُهورَ الأَعوجِيَّةِ مَرقَدا",18,"د",2,0],["كَم لَيلَةٍ كَالبَحرِ جُبتُ ظَلامَها","عَن واضِحِ الصُبحِ المُنيرِ فَأَسفَرا",19,"ر",2,0],["كَم لامَني فيكَ الحَسودُ","وَفَنَّدَ الواشي فَأَكثَر",20,"ر",1,0],["كَم لِريحِ الغَربِ مِن عُرفٍ نَدِيِّ","كَالشَرابِ العَذبِ في نَفسِ الصَدِيّ",21,"د",2,1],["كم لكما لو أحصيت","نعماً كما من شاكر",22,"ر",1,0],["كَمَلَكٍ بَاهِي السَّنَى يَنْجَلِي","فِي فَلَكٍ مِنْ حَوْلِهِ قَاتِمِ",23,"م",1,0],["كم لسعدك من ثنيّا","أطلعك منها وجلّاك",24,"ك",1,0],["كم ليلةٍ قد بتَّ فيها ساهراً","تهدي الآمانَ إلى العيون النُّومِ",25,"م",1,0],["كم ليلةٍ والدجى راعت جوانبُها","قلبَ الجبان فما ينفكُ مُطَّرَحا",26,"ح",2,0],["كم لها من هفَوات","تسلُب الطَود وقاره",27,"ر",2,0],["كَم لَهُ ثم كَم لَهُ من قَتِيلٍ","وَصَرِيعٍ تَحتَ السَّنَابِكِ دَامِي",28,"م",2,0],["كَم لَيلَةٍ شَهباءَ إِذ بَرَزَت لَنا","كانَت كَيَومٍ إِذ تَوَلَّت أَدهَمِ",29,"م",1,0],["كَم لِلمَنازِلِ مِن شَهرٍ وَأَحوالِ","كَما تَقادَمَ عَهدُ المُهرَقِ البالي",30,"ي",1,1],["كم ليلةٍ قال لي فيها ندى يدِه","يا أشعرَ العرب امدح أكرمَ العرَب",31,"ب",1,0],["كم له في حماه نفحة غيث","شملت في البلاد كل جديب",32,"ب",1,0],["كم له عزمةٌ إلى أرض مصر","بشَّرت عامَ وفدِها بخصيب",32,"ب",1,0],["كم ليلةٍ عاطيت صورته طِلاً","كادتْ تحركُ معطفيه بذاتها",33,"ت",3,0],["كم ليلةٍ بالثلجِ شابت وكم","مداد جنح بضياه انْتسخ",34,"خ",1,0],["كم ليلةٍ بتُّ أشكو من تطاولها","عليَّ والأفق داجي القلب كافره",35,"ر",2,0],["كم لحالي بها خضوعٌ وذلٌّ","وبنعمى موسى اعتلاءٌ وعزّه",36,"ز",2,0],["كم ليلةٍ تم يا ليلاي قد قنعت","عني بمسرع خطو الطيف هماز",37,"ز",1,0],["كم لي على حبِّ طرفه","بنثرة الدمع صرفه",38,"ف",2,1],["كم ليمناك عندنا من أيادٍ","ليس فيها لواصفٍ من شمال",39,"ل",1,0],["كم لها من فتوَّةٍ وفتاوٍ","قاضيات مآرب السوَّال",39,"ل",1,0],["كم لثمة لي فيه قد عجّلت","سكري بمشمولٍ ومشموم",40,"م",1,0],["كَمُلْتَ فلستُ أسألُ فيك شيئاً","يَزيدُكَهُ المَليكُ سوى البقاءِ",41,"ا",2,0],["كملتمسٍ من خسيسِ الجذو","عِ قَطْرَ إهالةِ مصلوبِهِ",42,"ب",2,0],["كم لها من كربةٍ فرَّجها","بالعياضيّ إذا الأمرُ كَرَبْ",43,"ب",1,0],["كم لديهم لِلَهوِهِم من كَعابٍ","وعجوزٍ شبيهةٍ بالكَعابِ",44,"ب",1,0],["كم لك من والدٍ ووالدةٍ","لو غرسا الشوكَ أثمرَ العنبا",45,"ب",2,0],["كم لك عندي من يد لم تُجْحَدِ","تُثْني عليك بالفعال الأمجدِ",46,"د",1,0],["كم له من بطانة لا يُعفّي","صَرْفُهُ عارها سجيسَ عَجيس",47,"س",1,0],["كم ليَ في مَغْضبٍ وعند رضا","من وابلٍ للأكام حفّاش",48,"ش",1,0],["كمُلتمْ فمهما أسأل اللَهَ فيكمُ","من الأمر لا أسأله تكميلَ ناقص",49,"ص",1,0],["كم لهم في الوَغى مواطن تَبْيَضْ","ضُ لهنَّ الوجوهُ أيّ ابيضاض",50,"ض",1,0],["كملعقة الصيني أخدمها يداً","صناعاً وإن كانت يد الله أصنعا",51,"ع",2,0],["كم ليلةٍ نسي الصباحَ مساؤها","قد بِتَّ فيها بالسُّهادِ كحيلا",52,"ل",2,0],["كمَّلْتَ بالإيجاب منه محاسناً","قد كنتُ أحسبُ أنها لا تكمُلُ",53,"ل",1,0],["كَمُلَتْ كلها فلستَ ترى في","ها سوى سوء عهدها نُقصانا",54,"ن",2,0],["كَم لَذَّعَ الزَمهَريرُ جِلدي","وَدَبَّ حَتّى إِلى ضَميري",55,"ر",2,0],["كَم لَيلَةٍ ساهَرَتُ في","ها النَجَمَ أَحسَبُهُ سَميري",56,"ر",2,0],["كَمَليكٍ حَولَهُ الشُه","بُ جُنودٌ وَإِماء",57,"ا",2,0],["كَم لَيلَةً أَحيَيتُها مُتَمَلمِلاً","طَرفي وَطَرفُ النَجمِ مُلتَقِيانِ",58,"ن",1,0],["كَمَلتَ مَلاحَةً وَكَمَلتَ ظَرفاً","فَلَيتَكَ ل