مُ بها","في البدو فيصَلُهُ، والقول ما قالا",183,"ل",2,0],["كم للنسيم مع الشعر الطويل أو ال","ثَّوْب القصير دُعابات لَهَا شان",184,"ن",1,0],["كم للجزائر قصة","تُتْلى كما تتلى المزامِر",185,"ر",1,0],["كم للمُهيمن آيةٌ","منقوشةٌ في سفره",186,"ر",2,0],["كم لها -كالمِلاَح والرَّاح- صرعى","خدعتهم أضواؤها الخلاَّبة",187,"ب",2,0],["كم لذَّ طعم وعودهم","عند المرور من الشفاه",188,"ا",2,0],["كمْ ليلةٍ خوفَ أنْ تُواتي","أُترِعَ كأسٌ ورنَّ عُود",189,"د",1,0],["كَمْ لَهُ منْ أبٍ يَتِيهُ بأثْوا","بِ المَعَالي مُؤزراً وَمُرَدّى",190,"د",2,0],["كَمْ لكَ فيها مِنْ نَائِلٍ ونَدَّى،","سُدْتَ بِهِ بَكْرَها وَوَائِلَهَا",191,"ل",3,0],["كم ليلة أحيتها متململا","طرفي وطرف النّجم ملتقيان",192,"ن",1,0],["كم ليلة عانقتُ فيها غادة","وَلمن صَحِبنا خيْلُها وَدرُوعُها",193,"ع",3,0]]}