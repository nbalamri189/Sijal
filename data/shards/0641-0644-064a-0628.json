habi.ae/diwan/poem/95068","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73117","السريع"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72810","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141664","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141678","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139522",""],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204254",""],[4927,"هالة الخزي وأم العواذل","https://www.poetsgate.com/ViewPoem.aspx?id=29835",""],[585,"يا من تأنق في التصوير يحكينا","https://www.poetsgate.com/ViewPoem.aspx?id=161919",""],[5183,"الحزن العميق","https://www.poetsgate.com/ViewPoem.aspx?id=180262",""],[5212,"رزءُ العليل","https://www.poetsgate.com/ViewPoem.aspx?id=212052",""],[5325,"هل يعلم الدهر من أردت فوادحه","https://www.poetsgate.com/ViewPoem.aspx?id=171973",""],[5403,"حيتك يا مرقداً وأرى هلال هدى","https://www.poetsgate.com/ViewPoem.aspx?id=187606",""],[5906,"مَشَقة نظرة","https://www.poetsgate.com/ViewPoem.aspx?id=188069",""],[6072,"القلبُ إذا تَلَكَّأ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84903&r=&rc=3",""],[463,"منْ حاكمٌ وخصوميَ الأقدارُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60069&r=&rc=125",""]],"verses":[["فَلي بِالحِمَى مَن لا أُطيقُ فِراقَهُ","بِهِ يَسعَدُ الواشي وَلكنَّني أَشقَى",0,"ق",2,0],["فَلي بأكْنافِ العِراقِ مَسْرَحٌ","رَحْبُ المندىً أرِجُ الخَمائِلِ",1,"ل",1,0],["فليُبعد اللَّه الكتابةَ إنَها","لا شكَّ إذ قبِلتْك غيرُ مُقدسه",2,"س",2,0],["فليبْرأ الجَرْبَى فلستُ كمن لقُوا","ما أبعد المكْوَى من الخضْخاض",3,"ض",1,0],["فَليَبقَ بَيتُكَ وَليَدُم ديوانُهُ","وَليَحيَ جُندُكَ وَلتَعِش شوراكا",4,"ك",2,0],["فليبلونَّ أخا عزائم عندها","إِلّا البسالةَ والسماح غريبُ",5,"ب",1,0],["فَلَيَبرُكَن يا حِقَّ إِن لَم تَنتَهوا","مِن مالِكَيَّ عَلى غُدانَةَ كَلكَلُ",6,"ل",1,0],["فَليَبكِيَنَّكَ طَرفُ كُلِّ مُثَقَّفٍ","يُزهى بِحَملِ سِنانِهِ الأُنبوبُ",7,"ب",1,0],["فليبك من شاء وليُشبع محاجره","ولينتحب ما يشاءُ الحزن باكينا",8,"ن",2,0],["فليبن عني السخيف من الرأي","وتنأى سفاسف الأقوال",9,"ل",1,0],["فَليُبلِغِ الفِتيانُ عَنّي مالِكاً","أَنّي مَتى يَتَثَلَّموا أَتَهَدَّمِ",10,"م",1,0],["فَلْيَبْلُغِ الْعَذْلُ مِنِّي مَا أَرَادَ فَقَدْ","أَسْلَمْتُ لِلشَّوْقِ رُوحِي وَالضَّنَى بَدَنِي",11,"ن",2,0],["فَليَبقَ بَعدَهُمُ لَدَينا لَيلَةً","فَلَهُ عَلَيَّ بِأَن يُجادَ ثَوابُهُ",12,"ب",2,0],["فَلي بِهِ عَينٌ مَجوسِيَّةٌ","تَعبُدُ مِن وَجنَتِهِ نارا",13,"ر",2,0],["فَليَبكِهِم مَن لا يَزالُ نِساؤُهُ","يَومَ الحِفاظِ يَقُلنَ أَينَ المَهرَبُ",14,"ب",1,0],["فلي بَدَنٌ بلا رُوحٍ","ولي رُوحٌ بلا بَدَنِ",15,"ن",1,0],["فَلْيَبْكِ قَلْبِي عَلَيْكَ فَالْعَيْنُ لا","تَبْلُغُ بِالْدَّمْعِ رُتْبَةَ الْخَلَدِ",16,"د",1,0],["فليبْكِ في مأتمِ الدُّستور من سمحَتْ","بالدمع عيناه، وليندُبْه مَن نَدَبَا!",17,"ب",2,0],["فليبق ذو اللب فيها غير مرتقب","عهدا سوى عهدك المعروف بالدخن",18,"ن",1,0],["فلي بك قبل عهد البعد شأن","مضى وكأنه قد صار حلما",19,"م",2,0],["فليبك من شاء من يأس يكابده","ولتنفطر من أسى أفلاذها المهج",20,"ج",1,0],["فَلي بِالجَميلِ الَّذي خَوَّلَت","لِسانٌ يُقِرُّ وَعَينٌ تَقَرّ",21,"ر",1,0],["فَلْيَبْلُغِ الشَّوْقُ بِي أَقْصى مَرَاتِبِهِ","فَكَمْ بُدُورٍ عَلَى قُضْبانِ كُثْبانِ",22,"ن",1,0],["فليبشر النازل فيها بالرضا","والنجع في الإِيراد والإِصدار",23,"ر",1,0],["فَليبتَهج بِكَ قُطرُ بَيروتَ الَّذي","ما زالَ يحسده بِكَ الأَقطارُ",24,"ر",1,0],["فلي بعدَكم شوقٌ أَثار تأسُّفنا","يُصغِّر عندي كلَّ ما أنا صانع",25,"ع",1,0],["فَليَبخَلِ الرَوضُ الأَنيقُ بَزَهرِهِ","خَدّاهُ أَحسَنُ بَهجَةً مِن وَردِهِ",26,"د",2,0],["فَلى بمجدِك تَوفيق العُلا كلَفٌ","لَم يَثنى عنهُ هَيفاءٌ وَمَعشوقُ",27,"ق",1,0],["فلي بكلّ مكان من مجرَّدها","أَثْرٌ يدلّ عليه أنه لثما",28,"م",2,0],["فليبذل الجهد العظيم مؤدياً","حقاً لينصر في دفاع المجرمين",29,"ن",1,0],["فَلَيبكهِ شرقُ البلادِ وغربُها","وَليَبكهِ مضرٌ وكلّ يَماني",30,"ن",2,0],["فَلي بِها تِسع أَحوالٍ قَد اكتَمَلَت","أَرتادُ فيها مَعاشاً لي فَلَم أَصبِ",31,"ب",1,0],["فَلْيَبْتَسمْ بكَ ثغرٌ قد جعلْتَ له","ثغراً عن الحسن والإِحسان مبتسما",32,"م",2,0],["فَليَبكِهِ كُلُّ مَلهُوفٍ لِحَاجَتِهِ","وَكُلُّ مُعفىً عَنِ الأبوَابِ مَطرُودِ",33,"د",1,0],["فلي بين هاتيك الخيام مخيّم","غدا منتهى سؤلي وغاية مقصدي",34,"د",2,0],["فلي بين هاتيك القباب خريدة","يطالبني في كل وقت بها الوجد",35,"د",1,0],["فلي بمناهج الآما","ل إيغال وتوحيد",36,"د",1,0],["فليبقَ للناس منك من أطبقَ ال","ناسُ عليه في الفضل واجتمعوا",37,"ع",3,0],["فليبقَ وليبقوا له ما طبّق ال","آفاق طِيبُ ثنائك السيَّارُ",38,"ر",1,0],["فَليَبقَ لي وَعَلَيَّ مِمَّن جاهُهُ","مُذ كانَ مُشتَمِلٌ عَلى أَسبابي",39,"ب",2,0],["فَليَبقَ لِلقَلبِ الَّذي فيهِ لَهُ","ما لَيسَ مِنهُ ذَرَّةٌ في قَلبِهِ",40,"ب",2,0],["فَليَبقَ لِلدُنيا الَّتي ما مِثلُهُ","في مَشرِقٍ مِنها وَلا في مَغرِبِ",41,"ب",1,0],["فلي بنارِ زفيري بعدَهمْ حُرَقٌ","ولي بدمعي على أطلالِهم غَرَقُ",42,"ق",1,0],["فلي بواخر بحر","أسطولها في بروق",43,"ق",1,0],["فليبلغ العيوق فصك وليكن","مثل الشقائق وليزن مثقالا",44,"ل",2,0],["فلْيَبْكِ من شاءَ وجداً","وما عليه ملامَهْ",45,"م",2,0],["فليبق معمور الفناء مخلد ال","نعماء ممدوداً له في عمره",46,"ر",2,0],["فليبكه كل ذي دين ومكرمة","على الدوام بدمع هامع هام",47,"م",1,0],["فليبك طالوت حزناً للبقية من","قد نال داود فيه أعظم الغلب",48,"ب",1,0],["فَلي بالرِّضَى الزُّهْرِيِّ مِنْ آل زُهرةٍ","تَتَابعُ وصل لا أرى معه صَدَّا",49,"د",2,0],["فليبكه المحراب في غسق الدجى","إذ زانه بتهجد وتبتل",50,"ل",1,0],["فلْيبْقَ منصوراً على ضِدِّه","في طيب عيشٍ ماله مِنْ نَفادْ",51,"د",1,0],["فلْيبْق ما طلعتْ شمس وما نطقتْ","لسان كلِّ قؤولٍ ناطق بفم",52,"م",1,0],["فليبكه الشرف الرفيع فكم به","لرفيع أعمد عزه تقويم",53,"م",1,0],["فلي بامتداحي فيه ذمة مادح","ومن شيم الأشراف رعي ذوي الذمم",54,"م",1,0],["فَلْيُبْلَغِ الأحْبَابُ عَني أنَّنِي","فَانٍ عَلَى دِينِ الْمَحَبَّةِ بَاقِ",55,"ق",1,0],["فلي بولاء أهل البيت نصر","لدى الهيجاء معقود اللواء",56,"ا",2,0],["فلي بعده في منتهى العلم سلوة","أبي صالح لولاه عيل تجلدي",57,"د",2,0],["فليبقه المولى لنا في عزّة","لا تنتهي ما فاض هطّال الديمْ",58,"م",1,0],["فليبقه الله ما طال المطال وما","هلّ الهلال ولاح الصبح وانبثقا",59,"ق",2,0],["فليبصر النطّار أين استرتعتْ","وليصرخن قد وقعتْ قد وقعتْ",60,"ت",1,0],["فليُبْشِرِ العافي فإنَّ عطاءَهُ","خيرُ العَطَاءِ لأَنَّهُ خيرُ البَشَرْ",61,"ر",1,0],["فلي بين أكناف العقيق ورامة","حبيب له ود قديم وكامل",62,"ل",1,0],["فليبرأ الآباء من أبنائهم","يا شقوة الآباء بالأولاد",63,"د",1,0],["فليبعث العدل من ضريحته","وليتمزق عن جسمه الكفن",64,"ن",1,0],["فليبق ذو اللب فيها غير مرتقب","عهداً سوى عهدها المعروف بالدخن",65,"ن",1,0],["فليبقَ في ظلّ السّلامة جانياً","ثمراتِ صافي العيش في أَوراقها",66,"ق",3,0],["فلْيَبْقَ في نعْمَةٍ يُسَرُّ بها","يَعرُبُ أَو رُتَبةٍ يرتّبُها",67,"ب",3,0],["فليبقيا وليغنَما وليسلَما","للمعتفي والمجتدي والآملِ",68,"ل",1,0],["فلي بأكناف ذاك الحي آنسة","من سربها في كناس الدل والخفر",69,"ر",1,0],["فَليُبلِغِ الدَّهرُ في مَساتي","فَما عَسى جُهدُه يَضير",70,"ر",1,0],["فليبك جبريلُ له ولينتحب","في الملأ الأعلى على مُصابه",71,"ب",2,0],["فَلْيَبْق يَمْحَضُه الزَّمانُ وَلاءَه","طَوْعاً فَحُقَّ لِمِثْله أَن يُمْحَضا",72,"ض",2,0],["فلْيَبْقَيا في ظِلِّ ملْكٍ دائم الْ","إِقبال ما دام الزَّمانُ بقَاءَ",73,"ا",2,0],["فَليبكينَّكَ كُلُّ نادٍ صَالحٍ","وليَندُبَنَّكَ منَ أحبّ ومَن قَلى",74,"ل",2,0],["فَليبكِ هارون الخلي","فةَ للخليفة والخليفة",75,"ه",1,0],["فليبك يومك من يبكيه يوم غدرا","بالصنو قوداً وبنت المصطفى ضربوا",76,"ب",3,0],["فلي بالجناب الظاهري تمسك","أبى الدهر من ظلمي إليه يتوب",77,"ب",1,0],["فليَبشِرُوا ما فيهِمُ مِن كافِرٍ","هُم عندَ جَهمٍ كَامِلو الإِيمانِ",78,"ن",1,0],["فَليُبَاهِ القَلَمُ الأعلَى بها","فلقد عاد مُفِيداً ومُعِيدا",79,"د",2,0],["فليبق في السودان مرفوع اللوا","يكسو الربوع مهابة وجمالا",80,"ل",2,0],["فليبتهج وجه الصعيد فقد زها","شرفا وراق لأنسه تجديد",81,"د",1,0],["فَليبكه كُل الوَرى","وَدُموع أَعيُنهم دَم",82,"م",1,0],["فليبقَ ماءُ النيل فيه حياتنا","وبه نجدد ثروة الايسار",83,"ر",1,0],["فليبق سعدك شاملا","اهل السكينة والسلام",84,"م",1,0],["فليبكه الإسلام منصدعاً","بجفون ثكلى دمعها صبب",85,"ب",1,0],["فليبكه شعب العراق فعينه","فقئت ولا يجدي هناك تجلد",86,"د",1,0],["فلي بربعك عُرب ما ذكرتهمُ","غِلا وبتُّ حليفَ الشوق والألمِ",87,"م",1,0],["فليبكي الدم من مثلي","ضيع شبيبه في غيه",88,"ي",2,0],["فلي بمن استعلى الأنام حمايةٌ","ومن بعليّ يحتمي ليس يصغرُ",89,"ر",1,0],["فليبؤ بالشقاء كل جهول","ولتقر بالسعادة العلماء",90,"ا",2,0],["فليبكه الدين والدنيا فإنهما","له بأمر الباري قد اجتمعا",91,"ع",2,0],["فلي بهم نفسٌ تتوقُ لقربهم","أما علموا يَا سعد أن النوى صَدّ",92,"د",1,0],["فليبشر الدجال بالغفران","يا بارد الوجه ويا سخن القفا",93,"ف",2,0],["فلْيُبْطلِ العُلماءُ عِلْمَ نُجومِهِمْ","بَعْدَ ابنِ يَحْيَى البَرْمَكيِّ ليَعْلَمُوا",94,"م",3,0],["فليبكه كل من ضاقت مذاهبه","وكل ءامل اضحى وهو مجهود",95,"د",1,0],["فليبكه الليل البهي","م فكم جفا فيه الوسادا",96,"د",2,0],["فليبكها نوءُ السماء عَلى الثَرى","وليرعَها طرفُ الثوابت ساهيا",97,"ي",2,0],["فليبكه المجد وَالعَليا وَربُّهما","وَليهنه الحور وَالحُسنى وَربهما",98,"م",2,0],["فليبكهم باكي الرجاء مغربا","وربيعي السراء يفترقان",99,"ن",1,0],["فَلي بَينَ هاتيكَ المَعاهِدِ جُؤذرٌ","حِمى القَلب يَرعى لا الكَثيب وَلا وَالسقطا",100,"ط",2,0],["فَلي بِسَواكَ عِزوةُ خَيرِ رَهطٍ","أَجَلُّوني وزَفسٌ لي سِواكا",101,"ك",2,0],["فلي بشعابه رشأ أغن","بنفسي ذلك الرشأ الأغنا",102,"ن",2,0],["فلي بين القباب فتاة خدر","يمد لها القنا الخطي ظلا",103,"ل",2,0],["فلي بينها ظبي غرير إذا رنا","تكاد ارتياحاً تخرج الروح من عندي",104,"د",2,0],["فلى بامتداحى ذمة منه حبلها","متين وثيق عهدها وعراها",105,"ا",3,0],["فلي بهما يحلو النسيب فخلني","خليلي من هند ودعني من دعد",106,"د",1,0],["فليبكِ مسلوبُ الشبيبة سرمداً","من حيث لا صَدرٌ لذا المسلوب",107,"ب",1,0],["فَلي بها أَهيفُ عَذبُ اللَّمَى","أيُّ رشيقِ القدِّ أَحوى وأي",108,"ي",1,0],["فليباه لبنان ثهلان في ذا","ك وفي ذا فليسُم لبنان قدرا",109,"ر",2,0],["فليبعلن في قَسّه","كي يستبد بحلسه",110,"س",2,0],["فلي باسمه استفتاح كلّ قضية","ويمناه اقليد السعادة والفتح",111,"ح",1,0],["فليباهي فيه أزكى والد","منه حاز الفضلُ أقصى الأرب",112,"ب",1,0],["فليبسط الآن عذراً لست أسأله","في قابل إن أنل من خدمةٍ سببا",113,"ب",2,0],["فَلِيْ بِعَفْرَاْءَ بَدْرٌ لاْ يُقَاْرِبُهُ","بَدْرٌ يُنِيْرُ دُرُوْبَ الْعِشْقِ فِيْ سَفَرِيْ",114,"ر",2,0],["فليبك قومٌ أطال الطيف حسرتهم","فالطيف إن يعيهم هيهات يعيينا",115,"ن",2,0],["فليبق أعضاؤه نوراً على علم","كأنهم في دجى الجلى قناديل",116,"ل",1,0],["فَلِيَبْكِ سُكّانُ السَّما وَلِيَنْشُروا","ثَوبَ الذَّبيحِ فَقَد أَتى عَامُ الحَزَنْ",117,"ن",1,0],["فليبك يومك ملهوف أضر به","ضيم ومختبط طاحت طوائحه",118,"ح",2,0],["فليبك جزماً على الفتوى اليراع دما","لفقده وليرثيه فم الوكل",119,"ل",1,0],["فَلي بِالحُسْنِ آياتٌ وَتُتلى","وَ أَفضَلُ ما بِها آي ارْتِجالي",120,"ل",2,0],["فَلِيْ بخارُ أباريقَ ارتقى عُمُداً","وَليْ نِثارُ ضياءٍ مِن عُلاكِ هَمى",121,"م",2,0],["فليبقَ وليبقوا له ما طبق ال","آفاق طيبُ ثائك السيارُ",122,"ر",1,0]]}