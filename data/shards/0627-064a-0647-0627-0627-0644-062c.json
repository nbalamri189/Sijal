{"poems":[[95,"أي رزء دهاك يا سمعان","https://www.aldiwan.net/poem11258.html","الخفيف"],[97,"أمتي هل لك بين الأمم","https://www.aldiwan.net/poem60148.html","عموديه"],[53,"دار أمن وقرار","https://www.aldiwan.net/poem62849.html","مجزوء الرمل"],[53,"خلياني عند اصطكاك الخصومِ","https://www.aldiwan.net/poem66322.html","الطويل"],[53,"يا بني السمري لا تجشموني","https://www.aldiwan.net/poem66503.html","الخفيف"],[93,"أعلى عيني من الدمع غشاء","https://www.aldiwan.net/poem62753.html","عموديه"],[72,"أيها الجاهل قل لي","https://www.aldiwan.net/poem42873.html","مجزوء الرمل"],[91,"انما نهضة الامم","https://www.aldiwan.net/poem44855.html","مجزوء الخفيف"],[87,"لا يقيمن على الضيم الأسد","https://www.aldiwan.net/poem8101.html","الرمل"],[87,"أيها العمال أفنوا العمر","https://www.aldiwan.net/poem63778.html","مجزوء الرمل"],[47,"جائر في الحكم لو شاء قصد","https://www.aldiwan.net/poem63483.html","الطويل"],[63,"قد أظلتك يا أبا إسحاق","https://www.aldiwan.net/poem51509.html","الخفيف"],[99,"أيها الجالس في مرقبِه","https://www.aldiwan.net/poem24388.html","الرمل"],[99,"يا فؤادي رحم الله الهوى","https://www.aldiwan.net/poem25088.html","الرمل"],[107,"أيها الجند ظافرا يتمشى","https://www.aldiwan.net/poem43097.html","الخفيف"],[52,"أيها الجاهل المباهي بريداً","https://www.aldiwan.net/poem24506.html","الخفيف"],[48,"سل سبيل الحياة عن سلسبيل","https://www.aldiwan.net/poem23261.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85423","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85428","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54560","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55049","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54658","الرمل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141923","الخفيف"],[108,"تأميم القناة","https://www.poetsgate.com/ViewPoem.aspx?id=179582",""],[100,"شاعر يترك الخيال كسيحا","https://www.poetsgate.com/ViewPoem.aspx?id=55333",""],[333,"أطرق الشاكي ونام الموجع","https://www.aldiwan.net/poem55030.html","الرمل"],[398,"أيها الجالس المفكر في الأم","https://www.aldiwan.net/poem53520.html","الخفيف"],[470,"في رحاب النجف الأشرف","https://www.aldiwan.net/poem61432.html","عموديه"],[508,"أيها الجاهل المسيء الظن","https://www.aldiwan.net/poem21753.html","الخفيف"],[563,"أيها الجاهل الذي ليس يدري","https://www.aldiwan.net/poem33580.html","الخفيف"],[567,"تلك أيامنا عليها السلام","https://www.aldiwan.net/poem52965.html","الخفيف"],[591,"أيها الهاجر حدث","https://www.aldiwan.net/poem17528.html","مجزوء الرجز"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96693","الرمل"],[1063,"","https://poetry.dctabudhabi.ae/diwan/poem/44979","الخفيف"],[1692,"","https://poetry.dctabudhabi.ae/diwan/poem/101580","الرمل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77202","الخفيف"],[2940,"","https://poetry.dctabudhabi.ae/diwan/poem/113695","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202408","الخفيف"],[3187,"","https://poetry.dctabudhabi.ae/diwan/poem/138787",""],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205882",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131071",""],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119706","الرمل"],[4733,"عتاب","https://www.poetsgate.com/ViewPoem.aspx?id=189631",""],[5136,"أيها الجهول إلى","https://www.poetsgate.com/ViewPoem.aspx?id=121525",""],[5277,"عندما تغضبُ اللبوة","https://www.poetsgate.com/ViewPoem.aspx?id=199965",""],[5377,"الأمن الزائف","https://www.poetsgate.com/ViewPoem.aspx?id=61898",""],[5409,"يا رواق المجلس الحا","https://www.poetsgate.com/ViewPoem.aspx?id=155291",""],[5409,"قل لمن عاش كما عا","https://www.poetsgate.com/ViewPoem.aspx?id=155319",""],[5491,"رفيقة الدموع","https://www.poetsgate.com/ViewPoem.aspx?id=197550",""],[5561,"شيّعوا شمسي","https://www.poetsgate.com/ViewPoem.aspx?id=192737",""],[5776,"النّهرُ العيّاب","https://www.poetsgate.com/ViewPoem.aspx?id=199331",""]],"verses":[["أَيُّهَا الجَازِعُونَ صَبْراً فَمَا","يَنْفَعُ إِلاَّ التَّسْلِيمُ وَالإِذْعَانُ",0,"ن",1,0],["أيها الجندي يا كبش الفدا","يا شعاع الأمل المبتسم",1,"م",1,0],["أيها الجار الذي أص","بح مأمولَ الجوارِ",2,"ر",1,0],["أيُّها الجالدو عُمَيْرةَ طُرّاً","لا عدِمْتُمْ ظُلامةً من ظلوم",3,"م",1,0],["أيها الجائرون في السير قصداً","إن في الجَوْر واديَ التنِّين",4,"ن",1,0],["أَيُّها الجالونَ عَن ذاكَ الحِمى","إِنَّ في ذاكَ الحِمى ما تَعلَمون",5,"ن",1,0],["أَيُّها الجاهِلُ قُل لي","كَيفَ لاتَكتُم سِرَّك",6,"ك",1,1],["ايها الجهل لا تقم","انت بالشر متهم",7,"م",1,0],["أَيُّها الجيلُ الَّذي نَرجو لِغَدٍ","غَدُكَ العِزُّ وَدُنياكَ الرَغَد",8,"د",1,0],["أَيُّها الجَمعُ لَقَد صِر","تَ مِنَ المَجلِسِ قابا",9,"ب",2,0],["أَيُّها الجازِعُ أَجوازَ الفَلا","يَطلُبُ الجَدوى مِنَ القَومِ الجُمُد",10,"د",1,0],["أيُّها الجَفْنُ غَيرَ دَمْعِكَ هذا","إنَّ ثُكْلَ الحبيبِ غيرُ الفراقِ",11,"ق",1,0],["أيها الجالسُ في مرقبِه","أترى الدميةَ تمشي أترَى",12,"ر",2,1],["أيها الجبار هل تصرع من أجل امرأة","يا لها من صيحة ما بعثت",13,"ت",1,0],["أَيُّها الجُندُ ظافِراً يَتَمَشّى","في الجَماهيرِ مُعجَباً مُختالا",14,"ل",2,1],["أَيُّها الجاهِلُ المُباهي بُرَيداً","لَيسَ بَدرُ السَماءِ مِنكَ بِدانِ",15,"ن",1,1],["أَيُّها الجامِعُ الكُنوزَ أَذَرٌّ","أَم زِبالٌ مِن نَملَةٍ في زَبيلِ",16,"ل",1,0],["أَيُّها الجهر بالحَقائِق مني","أنت دائي وَقَد تَكون دوائي",17,"ا",2,0],["أَيُّها الجهل أَنتَ ليل مخوفٌ","باتَ يُرخي من الظلام سدولا",18,"ل",2,0],["أَيُّهَا الْجَائِزُ المَجَا","هِلُ لاَ يَعْرِفُ النَّصَبْ",19,"ب",1,0],["أَيَّهَا الْجِهبِذُ الذِي لَمْ يَفُتْهُ","مَا بِهَا مِنْ جَلاَئِلٍ وَدِقَاقِ",20,"ق",1,0],["أَيَّهَا الجُهَّالُ كُلٌّ مِنْهُمُ","قَائِدٌ تُؤْثَرُ عَنْهُ الخُدَعَاتُ",21,"ت",1,0],["ايها الجدول الوديع الذي","تسمُرُ زهر الدجى على تحنانه",22,"ن",2,0],["أيها الجيشُ، أعِدْها للحِمى","فِلذَةً عقد نزعوها من حشاهْ",23,"ا",2,0],["أيها الجدول الوديع الذى","ينشر سر الحياة فى جريانه",24,"ن",2,0],["أيها الجاني الذي فكّت يداه","ورمى في قيده كل برىء",25,"ا",2,0],["أَيُّها الجالِسُ المُفَكِّرُ في الأَم","رِ المُعَنّى بِهِ اِعتِناء المَجوسِ",26,"س",1,1],["أيُّها الجاسِرُ المَضاربُهُ","كلُّ ليلٍ بِهِنَّ يَنكَشِفُ",27,"ف",1,0],["أَيُّهَا الجَاهِلُ المُسِيءُ الظَّنَّ","لَيسَ مِثلِي تَجُوزُ فِيهِ الظُّنُونُ",28,"ن",1,1],["أيها الجاهل الذي ليس يدري","ما يلاقيه بكرة وأصيلا",29,"ل",2,1],["أيها الجيرةُ الذينَ تَوَلَّوا","هل لكم جِيرةٌ سِوانا تُرامُ",30,"م",1,0],["أَيُّها الجَاهِلُ قَدْرِي","أَنا لا أَجْهَلُ قَدْرَكْ",31,"ك",1,0],["أيُّها الجاهلُ فَضلي","إِن تماري لَم أمارِك",32,"ك",1,0],["أَيُّها الجامِعُ الَّذي لَيسَ يَدري","كَيفَ حوزَ الأَهلَينِ لِلأَموال",33,"ل",1,0],["أيها الجاني على مرأته","أنت واللَه من الذوق شجيب",34,"ب",1,0],["أيها الجاحدُ الكنودُ تذكر","كيف سواكَ خالقُ الأكوانِ",35,"ن",1,0],["أيها الجاحدون فضل إلهٍ","شملتكم من حلمهِ النعماء",36,"ا",2,0],["أَيُّها الجَيشُ عُد بِخُفي حُنَينٍ","وَهوَ جَيشٌ مُظَفَّرٌ مَنصورُ",37,"ر",1,0],["أيُّها الجاني المدلُّ","لك نفسي وتقلُّ",38,"ل",1,1],["أيها الجهل هل تعود الينا","منقذاً للورى من التدمير",39,"ر",1,0],["أَيُّها الجَوهَرُ الفَرِيدُ الَّذي فُقت","جَمِيعَ الأنامِ أَنَّى تُضَاهَى",40,"ا",3,0],["أيها الجيبون لا تف","ضح تقاريظي وشكرِي",41,"ر",2,1],["أيها الجاحد الجميل اعتباطا","عمرك الله هل بلغت مراما",42,"م",2,0],["أيها الجاهل حبّي","سل فها إني أُفيدُك",43,"ك",1,1],["أيَّها الجَازمُ بالظّنِّ ألا","تَقتفي النُّورَ بليلي لا الظَّلاما",44,"م",2,0],["أيها الجهول إلى","كم تغرك الشبه",45,"ب",2,1],["أيها الجسّاسُ إنّي لبوةٌ","قل له عنّي: \" لقد كنتَ الأسدْ\"",46,"د",1,0],["أيها الجاعلوه في وسط دنيا العصر",".. يشوء إعصارها وهو مقعد",47,"د",1,0],["أيها الجامع في الند","وة طلاب صفوف",48,"ف",1,0],["أيها الجامع مالا","فيه لم تلزمك ذمه",49,"م",2,0],["أيُّها الجَلَاّدُ قد أدميتَني","بِزَفيرٍ قَاتِلٍ يَتلُو شَهِيقَه",50,"ق",2,0],["أيّها الجوعُ كلانا ماردٌ","غيرَ أنّي لي نجومٌ بسماها",51,"ا",3,0],["أيّها الجاري أغيثٌ أمْ دماء؟","قالَ سعّرْ في التناويرِ المهابهْ",52,"ب",2,0]]}