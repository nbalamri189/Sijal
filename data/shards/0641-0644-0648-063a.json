{"poems":[[64,"قيامتنا جمع أرواحنا","https://www.aldiwan.net/poem52160.html","المتقارب"],[30,"تلوم على هجاء بني كليب","https://www.aldiwan.net/poem5239.html","الوافر"],[63,"منازلنا التي لبست بلاها","https://www.aldiwan.net/poem51399.html","الوافر"],[29,"","https://poetry.dctabudhabi.ae/diwan/poem/1691","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67319","الطويل"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[369,"لما افتحت كتابي منشئا بيدي","https://www.aldiwan.net/poem60660.html","البسيط"],[369,"أما الغزال الذي أهوى فقد هجرا","https://www.aldiwan.net/poem60918.html","البسيط"],[445,"سلام وهنيت فيك السلامه","https://www.aldiwan.net/poem34883.html","المتقارب"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66646","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38659","الطويل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61038","الطويل"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117682","المتقارب"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108625","الطويل"],[2136,"","https://poetry.dctabudhabi.ae/diwan/poem/203569","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53190","المتقارب"],[2758,"","https://poetry.dctabudhabi.ae/diwan/poem/31508","الطويل"],[2927,"","https://poetry.dctabudhabi.ae/diwan/poem/33034","الطويل"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26121","الطويل"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26116","الطويل"],[3698,"","https://poetry.dctabudhabi.ae/diwan/poem/203432","الطويل"],[5457,"جريح في الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=213313",""],[6224,"طواف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88194&r=&rc=9",""]],"verses":[["فلو غيرها رام فيها الدخول","لدى الحشر لم تغن عنها قلامه",0,"م",2,0],["فَلَو غَيرُ الوَبارِ بَني كُلَيبٍ","هَجَوني ما أَرَدتُ لَهُم حِوارا",1,"ر",2,0],["فلو غُسِلَت بماءِ المُزنِ مِنهم","وماءِ البَحرِ لم يَطْهُرْ ثَراها",2,"ا",3,0],["فَلَو غَيرُ تَيمٍ يَفخَرونَ عَذَرتُهُم","أَتَيمُ اِبنَ تَيمِ اللُؤمِ يا سَوأَةَ الدَهرِ",3,"ر",1,0],["فلو غيرُنَا كَانَتْ جيمعاً تَكِيدُهُ","البريّةُ قد أَعْطَوْا يداً وَتَوَرَّعُوا",4,"ع",3,0],["فَلو غُسلوا في البحرِ وَالبحرُ طافحٌ","لَما أثّر البحرَ المُحيطُ بِهم طهرا",5,"ر",2,0],["فَلَو غَدَت هَذِهِ الأَقلامُ ناطِقَةً","شَهِدنَ لي بِالَّذي شاهَدنَ مِن ذِمَمي",6,"م",2,0],["فلو غَسلْتَ الثَرى من وَطء أرجُلِهم","بغيرِ ماءِ الطُّلى منهمْ لمَا طَهُرا",7,"ر",2,0],["فلو غِبتَ يوم استباقِ الكرامِ","لوافاك ذو السبقِ منها أمامَهْ",8,"م",2,0],["فلو غابَ عنّا عُمرَ نوحٍ لأيقَنَتْ","منّا النفوسُ بأنّهُ سيؤوبُ",9,"ب",1,0],["فَلَو غيثَ أَقوامٌ بِغَيثٍ لَأَيقَنوا","بِأَنّ عُيونَ الصبِّ تَبكي غَمامُهُ",10,"م",2,0],["فَلَو غَير مَحتوم القَضاء أَطعته","لَما كانَ مني للعَزاء نَصيب",11,"ب",1,0],["فلو غيبت عنه مرآته","لذاب اشتياقاً إلى وجههِ",12,"ه",1,0],["فلو غدت الأفلاك تحت يمينه","وحاولها عافٍ لجاد بها طرّا",13,"ر",2,0],["فلو غير الحمام دهاك يوماً","رماه عنك شبان وشيب",14,"ب",1,0],["فلو غبت يوماً عدمنا الحي","اة فكيف نكون وقد غبت عاما",15,"م",2,0],["فَلَو غَيرَها مِن وُلدِ عَمرٍو وَكاهِلٍ","مَدَحتَ بِقَولٍ صالِحٍ لَم تُفَيَّلِ",16,"ل",1,0],["فَلَو غَيرَنا يَلقى لَقالَ لَنا اِذهَبوا","وَلَو غَيرَهُ نَلقى لَقُلنا لَهُ اِذهَبِ",17,"ب",1,0],["فَلَو غِرتُمُ يَومَ الحَرائِرِ لَم تَرُح","مَع القَومِ أَبكارُ النِساءِ وَعونُها",18,"ن",3,0],["فَلَو غَيرُ يَربوعٍ اَبوكُم صَلِحتُمُ","وَلَكِن يَزَبوعا أَبوكُم فَأَفسَدا",19,"د",2,0],["فلو غير مرداس حريث بن جابر","لكنت بما أعطيت من نائل أهلا",20,"ل",2,0],["فلو غبنا عنِ الأوطانِ قهرًا","يقاتلُنا الحنينُ لها قتالا!",21,"ل",2,0],["فلو غبتَ يومًا أو غفوتَ \"سياسةً\"","تعدُّ الثواني وهي كيدًا تُعمِّرُ",22,"ر",1,0]]}