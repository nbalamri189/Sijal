{"poems":[[55,"يد في قائم العضب","https://www.aldiwan.net/poem30764.html","الهزج"],[74,"مننت بحل اللغز معنى وصورة","https://www.aldiwan.net/poem19266.html","الطويل"],[82,"ودجنة كالنقس صب على الثرى","https://www.aldiwan.net/poem31573.html","الكامل"],[71,"ووردية النفح أرسلتها","https://www.aldiwan.net/poem27986.html","المتقارب"],[76,"ماذا عليك وقد نأيت ديارا","https://www.aldiwan.net/poem12958.html","الكامل"],[77,"هل آجل مما أؤمل عاجل","https://www.aldiwan.net/poem69046.html","الكامل"],[52,"ووطئت أردية الفتوة كلها","https://www.aldiwan.net/poem62226.html","الكامل"],[52,"تعجبت جارتي مني وقد رقدت","https://www.aldiwan.net/poem63950.html","البسيط"],[48,"أقروا بالإله وأثبتوه","https://www.aldiwan.net/poem22092.html","الوافر"],[48,"أيا شجر العرا أوسعت ريا","https://www.aldiwan.net/poem22995.html","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202542","الرجز"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21112","الرمل"],[92,"عتاب مع النفس ..","https://www.poetsgate.com/ViewPoem.aspx?id=179099",""],[173,"ظننت حسودي حين غالت غوائله","https://www.aldiwan.net/poem1644.html",""],[185,"يا للرجال هوى أميمة قاتلى","https://www.aldiwan.net/poem58883.html","الكامل"],[203,"أحقا رأيت الموت دامي المخالب","https://www.aldiwan.net/poem45410.html","الطويل"],[406,"سيل أشواقي","https://www.aldiwan.net/poem6717.html","عموديه"],[445,"أهلي قد أنى لك أن تهلي","https://www.aldiwan.net/poem34788.html","الوافر"],[447,"أيا رباه دعوة مستضيق","https://www.aldiwan.net/poem14335.html","الوافر"],[447,"أراك يا زمني شططا","https://www.aldiwan.net/poem14457.html","البسيط"],[505,"متى قربت من الخمسين طرت إلى","https://www.aldiwan.net/poem38054.html","البسيط"],[511,"أقول وآنست بالليل نارا","https://www.aldiwan.net/poem2433.html","المتقارب"],[563,"لذاتي بذاتي لا لكم أنا ظاهر","https://www.aldiwan.net/poem34556.html","الطويل"],[1056,"","https://poetry.dctabudhabi.ae/diwan/poem/178040","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72310","المتقارب"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79871","الرمل"],[1586,"","https://poetry.dctabudhabi.ae/diwan/poem/96342","الكامل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26567","الرجز"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26427","الوافر"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114751","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69375","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93523","الرمل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132318","الوافر"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137016",""],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65981","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74206","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65118","الكامل"],[3306,"","https://poetry.dctabudhabi.ae/diwan/poem/147795",""],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89270","الوافر"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138452",""],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103021","الطويل"],[3897,"","https://poetry.dctabudhabi.ae/diwan/poem/124049","الوافر"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45923","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95067","الطويل"],[4259,"","https://poetry.dctabudhabi.ae/diwan/poem/145292","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83547","الوافر"],[5542,"قالوا تطرف جيلنا","https://www.poetsgate.com/ViewPoem.aspx?id=10190",""],[5561,"هو خيرةٌ من خيرةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=193807",""],[5596,"وادي محرم","https://www.poetsgate.com/ViewPoem.aspx?id=206487",""],[5922,"صراخ فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=185119",""],[5977,"لا تعد","https://www.poetsgate.com/ViewPoem.aspx?id=213267",""],[6068,"ويَوْم لَا كَيَوْم أَحُلّ بُوحَي -08-","https://www.poetsgate.com/ViewPoem.aspx?id=175806",""]],"verses":[["وَوَطَّأتَ لِيَ الرَحلَ","عَلى عَرعَرَةِ الصَعبِ",0,"ب",1,0],["ووطنني إن بلَّ بالقطر جسمه","فها هو مبلول وها أنا ناشف",1,"ف",1,0],["ووطئتُ دونَ الحيّ نارَ عداوةٍ","لو كان واطئَها الحديدُ لذابا",2,"ب",2,0],["ووطنْتُ نفسي على أنها","تضيعُ لتقصيرِها أو تضوعُ",3,"ع",1,0],["وَوَطِئتُ دونَ الظَبيِ غابَةَ ضَيغَمٍ","غَيرانَ أَنجَدَ في الوَعيدِ وَغارا",4,"ر",2,0],["ووطِئتَ بينَ كِناسِهِ وعرينِهِ","فأُصيبَ خادِرُهُ ورِيعَ الخاذل",5,"ل",1,0],["وَوَطِئتُ أَردِيَةَ الفُتُوَّةِ كُلَّها","وَفَضَضتُ خاتَمَ طِينِها المَختوما",6,"م",2,1],["وَوَطَّنتَ تِربَها الحَولاءَ لَيلَتَها","قَبلَ الرِسالَةِ حَتّى أَصبَحَت عَضُدا",7,"د",2,0],["وَوَطءُ بَناتِنا حِلٌّ مُباحٌ","رُوَيدَكُمُ فَقَد بَطَلَ العِتابُ",8,"ب",1,0],["وَوَطءُ السُفِّ يَحمي الرِجلَ مِنهُ","بَكورُ يَدٍ عَلى ذُرَةٍ بِسَفِّ",9,"ف",1,0],["ووطئت بساطك الأسباط","وانتظم الشمل والاغتباط",10,"ط",1,0],["وَوَطيدٍ مستَعِلٍّ سَيبُه","عاقِدُ الأَيَّامِ والدَّهرُ يُسَن",11,"ن",1,1],["ووَطَّنْتُ نفسي ، كما تشتهي","على مَطْعمٍ خَشِنٍ أجْشَب",12,"ب",1,0],["وَوَطَّنتُ نَفسي لِلمُداراةِ ما رَأى","رَأيتُ وَمَهما قالَهُ أَنا قائِلُه",13,"ل",2,0],["وَوَطِئتَ عَسكَرَ كُلِّ ثَغرٍ حَازَهُ","أَهلُ المَخَبَّةِ وِطأَةَ المُتَثَاقِلِ",14,"ل",1,0],["ووطَّنَ على خوضِ المنياتِ أنفساً","تساوقها الآجالُ سوقَ النجائبِ",15,"ب",1,0],["ووطَّأ أكنافَ الهضابِ وساقه","وحوَّلها من بعدِ شدَّتها عِهْنا",16,"ن",2,0],["ووطَّأ فِي مكارِمِهِ مِهادِي","وأعْلى فِي مراتِبِهِ مَحَلِّي",17,"ل",2,0],["ووطء الحيض عندهم مباح","فخضب دمائه مثل الخلوق",18,"ق",1,0],["ووطأة الموت عمداً ما بها خطل","رضى به حيث ما عمدا عليّ وطا",19,"ط",2,0],["ووُطِّدَتْ لكَ بالإرشادِ مَرْتبتي","وأُفْرغتْ بكَ في الأقوالِ ناطِقتي",20,"ي",1,0],["ووطنت نفسي لحكم الهوى","علي وقلتُ رَضِيت اختِيارا",21,"ر",2,0],["ووطِّن على الإنكار نفسك والأذى","فمَن عسلاً يجني على النحل صابر",22,"ر",1,0],["ووطئتم في الحرب حتى أصبحوا","حدثاً يكوس وغابراً يتجعجع",23,"ع",1,0],["ووطا لثالثهم بعد أن","أهل النفاق له أميل",24,"ل",1,0],["ووطى الشهبَ بعالي جَدّه","كانَ نصفاً لو أعادي مَجدهِ",25,"ه",1,0],["ووطئن يوم الشيطين بكلكل","عمرا ومن سعد أبرن حلالا",26,"ل",2,0],["وَوَطَّنوا مَكَّةَ دَهراً داهِرا","حَتّى إِذا ما قارَفوا الكَبائِرا",27,"ر",2,0],["وَوَطَّنّا عَلى غِيَرِ اللَيالي","نُفوساً سامَحَت بَعدَ الإِباءِ",28,"ا",2,0],["ووطئتما ظهر الصفا","وقطعتما بطنَ المسيل",29,"ل",1,0],["وَوَطِئتَ الثَرى فَلَو قِيسَ بِالعَن","بَرِ ما دُستَ كانَ ما دُستَ أَغلى",30,"ل",2,0],["وَوطاب الرَوض في أَرجائنا","شَخبت فيهِ أَفاويق السَحاب",31,"ب",1,0],["ووطَّدَ للفضائلِ قَصرَ حُسنً","وصفَّى بحرهُنَّ من الأجاجِ",32,"ج",1,0],["ووطدت مجداً شاد بللمع ركنه","قديماً وفعل الفرع يبني على الاصل",33,"ل",1,0],["ووطيت عيني للخدوع بخدها","وإِني لاقذا من كحال التكاحل",34,"ل",1,0],["وَوَطَّأتُمُ أَكنافها وَأَعدتُّمُ","لَها روحَها وَاخضر في الحال عُودها",35,"د",3,0],["ووطأت تُربتها فعادت جنّة","خضراء تجري تحتها الأنهارُ",36,"ر",1,0],["ووطئتنا، وطئاً، على حنقٍ","وطء المقيد نابت الهرمِ",37,"م",1,0],["ووطّأت العلى لك أي فضل","فما لك في الموطأ من مشارك",38,"ك",1,0],["ووطأت موضع لم يكن","خلق هناك سواك يصعد",39,"د",1,0],["ووطد أرجاء البلاد بأمنه","ولم تنكتم منها سريرة كاتم",40,"م",1,0],["ووطنه عليها ما يراه","مثال الصبح من طيف الخيال",41,"ل",1,0],["وَوَطِّن وَسَلِّ النَفسَ فَالدَهرُ تارَةً","يُسيءُ وَطوراً بِالمَسَرَّةِ جالِبُ",42,"ب",1,0],["ووطدتُ إيقاني بنيل مراحمٍ","لأنك رحمانٌ وتجزي برحمةِ",43,"ه",1,0],["ووطفت عرض الأرض لم أر مثله","حكيماً شجاعاً يقطع الحكم والهاما",44,"م",2,0],["وَوُطِّدتِ المَراتِبُ لي بِدنيا","وَأُخرى منكَ توطيداً عَجيبا",45,"ب",2,0],["ووطئت أوهامي فما أسكنتها","عقلي وجاوزت الفضاء محلقا",46,"ق",2,0],["ووطئتَ أرضا في العلاءِ يخافها","جبريلُ إذْ كلَّتْ خُطاهُ تفانبا",47,"ب",2,0],["ووطّن النفس واحملها على مضضٍ","فالعزم يهزم جيش المستحيلات",48,"ت",1,0],["ووطِّدْ سياجَ الخير واطْربْ نفوسَهمْ","وألْبِسْهمُ تاجَ السُّرور النّوادِر",49,"ر",1,0],["وو طئتَ سهلاً والقلوب مساكن","ومرابعٌ .. وبك الفؤاد متيّم",50,"م",1,0],["ووَطْنٍ مَا سِواك سَكَنْتَ قَلْبِي","فَرُعْتَ الْقَاطِنِين صَمِيم وَكْر",51,"ر",1,0]]}