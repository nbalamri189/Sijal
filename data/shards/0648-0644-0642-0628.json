{"poems":[[79,"هل كنت تعلم في هبوب الريح","https://www.aldiwan.net/poem36635.html","الكامل"],[85,"بشرى كما وضح الزمان وأجمل","https://www.aldiwan.net/poem54256.html","الكامل"],[91,"قد قلت ان العقل لي","https://www.aldiwan.net/poem44853.html","مجزوء الكامل"],[81,"ولقبت المسدس وهو نعت","https://www.aldiwan.net/poem29562.html","الوافر"],[87,"عندي لكم منتخب","https://www.aldiwan.net/poem7577.html","مجزوء الرجز"],[87,"مضى الدهر بابن إمام اليمن","https://www.aldiwan.net/poem8111.html","المتقارب"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[87,"مضى الدهر بابن إمام اليَمَنْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9632&r=&rc=122",""],[266,"إنا لتقتلنا العيون","https://www.aldiwan.net/poem38164.html","مجزوء الكامل"],[266,"حباك عرفا حليها والوشاح","https://www.aldiwan.net/poem38348.html","الخفيف"],[435,"الحمد لله الذي قد حللا","https://www.aldiwan.net/poem40815.html","الرجز"],[445,"عمرت بطول بقائك الأعمار","https://www.aldiwan.net/poem34878.html","الكامل"],[466,"لقد علم الأحياء دان ونازح","https://www.aldiwan.net/poem15399.html","الطويل"],[466,"تباريت والشهر الحرام ففقته","https://www.aldiwan.net/poem16180.html","الطويل"],[532,"ما لي رأيت بني العباس قد فتحوا","https://www.aldiwan.net/poem45969.html","البسيط"],[563,"من أين للسعد ما ندري وللرازي","https://www.aldiwan.net/poem34456.html","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64123","البسيط"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77643","الرجز"],[1312,"","https://poetry.dctabudhabi.ae/diwan/poem/145166","المتقارب"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1432,"","https://poetry.dctabudhabi.ae/diwan/poem/93086","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108930","الكامل"],[3330,"","https://poetry.dctabudhabi.ae/diwan/poem/124747","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74029","المتقارب"],[3749,"","https://poetry.dctabudhabi.ae/diwan/poem/33127","الطويل"],[3889,"","https://poetry.dctabudhabi.ae/diwan/poem/142944","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125826","المتقارب"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127241","الوافر"],[4771,"يا مُزْمعاً عَن مُلْكه وسريره","https://www.poetsgate.com/ViewPoem.aspx?id=106588",""],[5200,"وعظ المشيب فمرحبا","https://www.poetsgate.com/ViewPoem.aspx?id=200804",""],[5725,"خمرية طيبة","https://www.poetsgate.com/ViewPoem.aspx?id=177436",""]],"verses":[["ولَقَبْلُما كتَبَتْ رُواةُ مَدامِعي","في طُرَّتَيْها حِلْيةَ التّجْريحِ",0,"ح",1,0],["ولقبلُ ما استفتحت كلَّ ممنَّعٍ","من دونه بابُ المطامع مُقفلُ",1,"ل",1,0],["ولقبلة احرزت من","حوراء ذات تدلل",2,"ل",1,0],["ولقّبت المسدّس وهو نعت","تفارقك الحياة ولا يفارق",3,"ق",1,1],["ولقبوه بالسرىّ","الشهم فيما لقبوا",4,"ب",3,0],["وَلُقِّبَ بِالبَدرِ مِن حُسنِهِ","وَما البَدرُ ما قَدرُهُ وَاِبنُ مَن",5,"ن",1,0],["وَلَقَّبَتهُ قُرَيشٌ بِالأَمينِ عَلى","صِدقِ الأَمانَةِ وَالإِيفاءِ بِالذِّمَمِ",6,"م",1,0],["ولقِّبَ بالبدرِ من حسن","وما البدرُ؟ ما قدرُه؟ وابنُ مَنْ؟",7,"ن",1,0],["ولقبلنا المأمون","دافع عن تخلفه الأمين",8,"ن",1,0],["ولقبت منه جوداً ومجداً","وهمالي الصلاح والاصلاح",9,"ح",1,0],["ولقبت رياضة القناص","ما بين أهل الصيد بالقرناص",10,"ص",1,0],["ولَقبلُ أَيْقنَ فِرْذِلَندٌ مَا لَهُ","إِلّا إِليكَ من الحِمامِ فِرار",11,"ر",1,0],["ولَقَّبهُ غَرْسَ الخِلافةِ حينما","رأى الغرس منه وهو بالنُّصح يانعُ",12,"ع",1,0],["ولُقِّبَ بالشَّهْر الحرام ولم تزلْ","حَراماً عن العوْراء تنْآى وتزْحَل",13,"ل",1,0],["ولقَّبوا رجلاً لو عاش أوَّلهم","ما كان يرضى به للحش بوابا",14,"ب",2,0],["ولقبوه أصول الدين حيث لهم","فيه مباحث سمعيات مجتاز",15,"ز",1,0],["ولقبوه بحبِّ الظرفِ ليتهمُ","يا نفسُ ضاعوا كما قد ضاع ذا اللقب",16,"ب",1,0],["وَلَقَبّوه بَعدُ بِالحِمار","وَذَلِكَ العار وَأَي عار",17,"ر",1,0],["ولقِّب ذا بأمير البيان","وهذاك بالكاتب العبقري",18,"ر",2,0],["ولقب آسما كونه سما على","سواه أو به المسمّى قد علا",19,"ل",2,0],["ولقّبوه الفعل حيث يشمله","ومنه لا يسأل عما يفعل",19,"ل",1,0],["ولقبض أنفسها تجلى ربها","فاستشهدت والله من شهدائها",20,"ا",3,0],["ولقبلت أركانُ بيت اللَه من","يدِك النقية أشرفَ الأركان",21,"ن",1,0],["ولقبتها العرب بالبنات","واتفقت ألسنة الرواة",22,"ه",1,0],["وَلَقَّبَ شَخصي بربِّ الجَمال","وَفي خاتمِ الرسلِ سَمّانيَه",23,"ي",2,0],["وَلَقَبَّهُ بِالناصِرِ المَلِكِ يوسُفَ","وَنَقَّبَهُ نورُ المَهابَةِ سَيِّدا",24,"د",2,0],["ولقبل كن إذا رأينك عازماً","عاين طولك فاسنفدن الطولا",25,"ل",2,0],["ولَقَّبْتَ فكتور بالامبرور","وكدت تُسميه بالقيصر",26,"ر",1,0],["ولقب جده بالشمس لكن","إذا لم يعل غرتها قتام",27,"م",1,0],["ولَقبلُ كَنَّ إذا رأينكَ عازماً","عاينَّ طُولكَ فاستفدنَ الطَّولا",28,"ل",2,0],["ولقبل ما يئس العوا","ذل من سلوّى عن حبيبي",29,"ب",2,0],["ولقبّلوا اثْرٓ الحبيب بقبلةٍ","يحثو اليهم عطرُها الفوّاحُ",30,"ح",1,0]]}