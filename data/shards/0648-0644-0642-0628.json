{"poems":[[77,"هل كنت تعلم في هبوب الريح","https://www.aldiwan.net/poem36635.html","الكامل"],[83,"بشرى كما وضح الزمان وأجمل","https://www.aldiwan.net/poem54256.html","الكامل"],[89,"قد قلت ان العقل لي","https://www.aldiwan.net/poem44853.html","مجزوء الكامل"],[79,"ولقبت المسدس وهو نعت","https://www.aldiwan.net/poem29562.html","الوافر"],[85,"عندي لكم منتخب","https://www.aldiwan.net/poem7577.html","مجزوء الرجز"],[85,"مضى الدهر بابن إمام اليمن","https://www.aldiwan.net/poem8111.html","المتقارب"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[85,"مضى الدهر بابن إمام اليَمَنْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9632&r=&rc=122",""],[262,"إنا لتقتلنا العيون","https://www.aldiwan.net/poem38164.html","مجزوء الكامل"],[262,"حباك عرفا حليها والوشاح","https://www.aldiwan.net/poem38348.html","الخفيف"],[430,"الحمد لله الذي قد حللا","https://www.aldiwan.net/poem40815.html","الرجز"],[440,"عمرت بطول بقائك الأعمار","https://www.aldiwan.net/poem34878.html","الكامل"],[462,"لقد علم الأحياء دان ونازح","https://www.aldiwan.net/poem15399.html","الطويل"],[462,"تباريت والشهر الحرام ففقته","https://www.aldiwan.net/poem16180.html","الطويل"],[528,"ما لي رأيت بني العباس قد فتحوا","https://www.aldiwan.net/poem45969.html","البسيط"],[559,"من أين للسعد ما ندري وللرازي","https://www.aldiwan.net/poem34456.html","البسيط"]],"verses":[["ولَقَبْلُما كتَبَتْ رُواةُ مَدامِعي","في طُرَّتَيْها حِلْيةَ التّجْريحِ",0,"ح",1,0],["ولقبلُ ما استفتحت كلَّ ممنَّعٍ","من دونه بابُ المطامع مُقفلُ",1,"ل",1,0],["ولقبلة احرزت من","حوراء ذات تدلل",2,"ل",1,0],["ولقّبت المسدّس وهو نعت","تفارقك الحياة ولا يفارق",3,"ق",1,1],["ولقبوه بالسرىّ","الشهم فيما لقبوا",4,"ب",3,0],["وَلُقِّبَ بِالبَدرِ مِن حُسنِهِ","وَما البَدرُ ما قَدرُهُ وَاِبنُ مَن",5,"ن",1,0],["وَلَقَّبَتهُ قُرَيشٌ بِالأَمينِ عَلى","صِدقِ الأَمانَةِ وَالإِيفاءِ بِالذِّمَمِ",6,"م",1,0],["ولقِّبَ بالبدرِ من حسن","وما البدرُ؟ ما قدرُه؟ وابنُ مَنْ؟",7,"ن",1,0],["ولقبلنا المأمون","دافع عن تخلفه الأمين",8,"ن",1,0],["ولقبت منه جوداً ومجداً","وهمالي الصلاح والاصلاح",9,"ح",1,0],["ولقبت رياضة القناص","ما بين أهل الصيد بالقرناص",10,"ص",1,0],["ولَقبلُ أَيْقنَ فِرْذِلَندٌ مَا لَهُ","إِلّا إِليكَ من الحِمامِ فِرار",11,"ر",1,0],["ولَقَّبهُ غَرْسَ الخِلافةِ حينما","رأى الغرس منه وهو بالنُّصح يانعُ",12,"ع",1,0],["ولُقِّبَ بالشَّهْر الحرام ولم تزلْ","حَراماً عن العوْراء تنْآى وتزْحَل",13,"ل",1,0],["ولقَّبوا رجلاً لو عاش أوَّلهم","ما كان يرضى به للحش بوابا",14,"ب",2,0],["ولقبوه أصول الدين حيث لهم","فيه مباحث سمعيات مجتاز",15,"ز",1,0]]}