,"https://www.poetsgate.com/ViewPoem.aspx?id=179042",""],[90,"بم أستهل","https://www.poetsgate.com/ViewPoem.aspx?id=179014",""],[90,"دمعَة على صديق","https://www.poetsgate.com/ViewPoem.aspx?id=179103",""],[91,"رثاء","https://www.poetsgate.com/ViewPoem.aspx?id=53186",""],[94,"السراب المظلم","https://www.poetsgate.com/ViewPoem.aspx?id=15630",""],[51,"نبكي الشبابَ لحاجاتِ النساءِ ولي","https://www.poetsgate.com/ViewPoem.aspx?id=30798",""],[78,"يا غَيمُ، عَيني أَقوى مِنك تَهتانا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86644&r=&rc=139",""],[97,"زازا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63558&r=&rc=104",""],[31,"ابكيتَ في طربٍ، أبا بشرِ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18905&r=&rc=168",""]],"verses":[["أَبكي عَلى عُمرٍ يُجاذِبُهُ الرَدى","جَذبَ الرِشاءِ عَنِ القَليبِ الأَطوَلِ",0,"ل",1,0],["أَبكي وَيَبسِمُ وَالدُجى ما بَينَنا","حَتّى أَضاءَ بِثَغرِهِ وَدُموعي",1,"ع",2,0],["أَبكيهِمُ وَيَدُ الأَيّامِ دائِبَةٌ","تَدوفُ لي فَضلَةَ الكَأسِ الَّتي جَرَعوا",2,"ع",3,0],["أَبكي نَداهُ العَريضَ أَم بِشرَه اللا","معَ لِلمُعتَفينَ أَم وَرَعَه",3,"ع",2,0],["أَبكيكَ يا عَبدَ العَزيزِ بِخِطَّةٍ","تُعمي مَطالِعُها وَخَطبٍ مُضلِعِ",4,"ع",1,0],["أَبكي ظُبىً فُجِعَت يَدي","مِنها بِأَصدَقِها مَهَزّا",5,"ز",2,0],["أَبكي عَلى الأَيّامِ وَهيَ ضَواحِكٌ","في وَجهِ غَيري وَهوَ فيها حائِرُ",6,"ر",1,0],["أَبكيكِ لَو نَقَعَ الغَليلَ بُكائي","وَأَقولُ لَو ذَهَبَ المَقالُ بِداءِ",7,"ا",2,1],["أَبكي وَمِثلي بَكى مِن حُبِّ جارِيَةٍ","لَم يَجعَلِ اللَهُ لي في قَلبِها لينا",8,"ن",2,0],["أَبكي إِلى الشَرقِ إِن كانَت مَنازِلُهُم","مِمّا يَلي الغَربَ خوفَ القيلِ وَالقالِ",9,"ل",1,1],["أَبكي لِمَرِّ الأَيّامِ لا جَزِعاً","مِن أَجَلي لَستُ سابِقاً أَجَلي",10,"ي",1,1],["أَبكي وَأَستَخلي كِتا","بَكِ يا ظَلومُ وَأَستَزيرُه",11,"ر",2,1],["أَبكي لِسُخطِكِ حينَ أَذكُرُ ما مَضى","يا لَيتَ ما قَد فاتَ لي مَردودُ",12,"د",1,0],["أَبكي الَّذينَ أَذاقوني مَوَدَّتَهُم","حَتّى إِذا أَيقَظوني لِلهَوى رَقَدوا",13,"د",3,1],["أَبكي إِذا سَخِطَت حَتّى إِذا رَضيَت","بَكَيتُ عِندَ الرِضا مِن خَشيَةِ الغَضَبِ",14,"ب",1,1],["أَبكي ظَلومَ وَأَبكي ما فُجِعتُ بِهِ","مِنها وَأَبكي عَلى قَلبي الَّذي ذَهَبا",15,"ب",2,0],["أَبكي وَعَينُ الشَرقِ تَبكي مَعي","عَلى الأَريبِ الكاتِبِ الأَلمَعي",16,"ع",2,1],["أَبكي بُكاءَ الثاكِلا","تِ وَأَصطَلي ما أَصطَلي",17,"ي",1,0],["أَبكَيتَ حَتّى العُلا وَالمَكرُماتِ وَما","جَفَّت عَلَيكَ مَآقي الخُرَّدِ الخودِ",18,"د",1,0],["أَبكيهِما وَكَأَنَّما أَنا ثالِثٌ","لَهُما مِنَ الإِشفاقِ وَالإِعوالِ",19,"ل",1,0],["أَبكي عَلَيكَ وَلَو وَفَت لَكَ أَدمُعي","لَتَعجَّبَت مِن مَدِّها الأَنهارُ",20,"ر",1,0],["أَبكيتَ حَتّى نَثرَةً وَطِمِرَّةً","وَحَزَنتَ حَتّى ذابِلاً وَمُهَنَّدا",21,"د",2,0],["أَبكي وَفاءً وَإِن لَم تَبذُلي صِلَةً","فَالطَيّفُ يُقنِعُنا وَالذِكرُ يَكفينا",22,"ن",2,0],["ابكي فتى الحيِّ نالتهُ منيَّتهُ","وكلُّ نفسٍ الى وقتٍ ومقدارِ",23,"ر",1,0],["أَبكي لِصَخرٍ إِذا ناحَت مُطَوَّقَةٌ","حَمامَةٌ شَجوَها وَرقاءُ بِالوادي",24,"ي",1,1],["أُبَكِّ أَبي عَمراً بِعَينٍ غَزيرَةٍ","قَليلٍ إِذا نامَ الخَلِيُّ هُجودُها",25,"د",3,1],["اِبكي أَخاكِ إِذا جاوَرتِهِم سَحَراً","جودي عَلَيهِ بِدَمعٍ غَيرِ مَنزوفِ",26,"ف",1,0],["اِبكي المُهينَ تِلادَ المالِ إِن نَزَلَت","شَهباءُ تَرزَحُ بِالقَومِ المَتاريفِ",26,"ف",1,0],["أَبكي عَلى هالِكٍ أَودى فَأَورَثَني","عِندَ التَفَرُّقِ حُزناً حَرُّهُ باقِ",27,"ق",1,0],["اِبكي أَبا حَسّانَ وَاِستَعبِري","عَلى الجَميلِ المُستَضافِ المَخيل",28,"ل",1,0],["أَبكي عَلى البَطَلِ الَّذي","جَلَّلتُمُ صَخراً ثِقالا",29,"ل",2,1],["أَبكي عَلى أَخَوَيَّ","وَالقَبرِ الَّذي واراهُما",30,"م",2,0],["أَبْكِي إِذَا غَدَتِ الظِّبَاءُ فَلَمْ","أَرَ زِيْنَةَ الأَتْرَابِ فِي السِّرْبِ",31,"ب",1,1],["أَبْكَارُ فَضْلٍ تَسْتَبِيكَ وَرُبَّمَا","وَقُرَ الجَمَالُ وَفِعْلُهُ فَتَّانُ",32,"ن",1,0],["أَبْكِيكَ يَا خِدْنِي وَكَمْ مُتَقَدِّمٍ","أَمْسَيْتُ أبكِيه مِنَ الأَخْدَانِ",33,"ن",1,0],["أَبْكَاكِ من رَقَّةٍ خَطْبٌ بِهِ صَمَمٌ","عَمَّنْ شكا ولَبِئْسَِ الخَطْبُ ذًو الصَّمَمِ",34,"م",1,0],["أَبْكَى الْعُيُونَ عَلَيْكَ إِلاَّ أَنُّهُ","مِنْ مَائِهِ دَمْعُ الْعُيُونِ السَّاجِمُ",35,"م",1,0],["أُبكِّيه للرايات يخفُقُ بَنْدها","وفي مرقب النصر المؤزر يُعليها",36,"ي",3,0],["أُبكِّيه للخيل المغيرة بالضّحى","وقد أبعد الفتح المبين مراميها",36,"ي",3,0],["أبكي وما غيرُ النجيعِ مدامعٌ","أُذكي ولا ضرمٌ سوى أحشائي",37,"ا",2,0],["أَبكي وَبْسِمُ والمحاسنُ تُجْتَلَى","فَعَلِقْتُ بينَ تَبَسُّمِ وبُكاءِ",37,"ا",2,0],["أبكي على أمة دار الزمان لها","قبلاً ودار عليها بعدُ بالغِيَر",38,"ر",1,0],["أَبكي أَبا الحَزّازِ يَومَ مَقامَةٍ","لِمُناخِ أَضيافٍ وَمَأوى مُقتِرِ",39,"ر",1,1],["أَبكي الأَحِبَّةَ بِالشَآمِ وَبَينَنا","قُلَلُ الدُروبِ وَشاطِئا جيحانِ",40,"ن",1,0],["أَبكي بِدَمعٍ لَهُ مِن حَسرَتي مَدَدٌ","وَأَستَريحُ إِلى صَبرٍ بِلا مَدَدِ",41,"د",1,0],["إِبكِ بَكَت عَيناكَ ثُمَّ تَبادَرَت","بِدَمٍ يَعُلُّ غُروبَها بِسِجامِ",42,"م",1,1],["أبكي فيبكي كأنَّا","حمائمُ النوحِ بعدَك",43,"ك",1,0],["أبكيك ما بكت الحمامُ هديلها","وأحنّ ما حنت إلى الأوكار",44,"ر",1,0],["أبكي بمحمرِّ الدّموع وإنما","تبكي العيون نظيرها بنضار",44,"ر",1,0],["أبكي الصبا بدموع عينٍ كادَ في","شكوى الجفا إنسانها أن ينطقا",45,"ق",2,0],["أبكيك للحسنين الخلْق والخُلُق","كما بكى الروض صوب العارض الغدق",46,"ق",1,1],["أبكي وعاذليَ التعبان يطلبني","أسلو فيأخذني من عقلِهِ الضحك",47,"ك",1,0],["أبكي اشْتياقاً إليها وهي قاتلتي","يا من رأى قاتلاً يبكيه مقتول",48,"ل",1,0],["أبكيه بالدُّرِّ من جفني ومن كلمي","والبحر أحسن ما بالدُّرِّ أبكيه",49,"ي",2,0],["أَبكي عَلى شَجَني مِن فُرقَتي وَطَني","طَوعاً وَيُسعِدُني بِالنَوحِ أَعدائي",50,"ا",3,0],["أبكانيَ الشيبُ حين أضحكهُ","حتى جرى الدمعُ واكفاً سَرَبُهْ",51,"ب",2,0],["أبكيتِني فبكيتُ","من غير ذنبٍ جنيْتُ",52,"ت",1,1],["أبكيك بالدمع والدماء بل ال","تسهاد بل بالمشيبِ في الشعرِ",53,"ر",1,0],["أبكرتَ فاصطدتني والقومُ في سنةٍ","وصاحبُ الصيدِ قِدْماً كلُّ مبْكار",54,"ر",1,0],["أبكاهُ قطرُ الندى وأضْحكَهُ","فهْوَ مع القطر ضاحكٌ باكي",55,"ي",1,0],["أبكانيَ ابني إذ فُجعت به","لم تُبكِني الأطلال والدِّمنُ",56,"ن",1,0],["أبكي الشبابَ لرَوْقٍ كان يُعجبني","منه إذا عاينتْ عيْني مرائيها",57,"ي",3,0],["أبكي الشباب للذّات القنيص إذا","ثَقلت عنها وغاداها مُغاديها",57,"ي",3,0],["أبكي الشبابَ للذات الشَّمولِ إذا","غنَّى القيانُ وحثَّ الكأسَ ساقيها",57,"ي",3,0],["أبكي الشبابَ لنفس كان يُسعِفُها","بكلِّ ما حاولتهُ من ملاهيها",57,"ي",3,0],["أبكي الشبابَ لآمالٍ فُجعتُ بها","كانت لنفسيَ أُنساً في معانيها",57,"ي",3,0],["أبكي الشبابَ لنفس لا ترى خلفاً","منه ولا عِوضاً مذ كان يُرضيها",57,"ي",3,0],["أبكي الشباب لعينٍ كَلَّ ناظرُها","بعد الثقوبِ وحار القصدَ هاديها",57,"ي",3,0],["أبكي الشبابَ لأذن كان مَسْمعها","وقد يُجابُ على بعدٍ مناديها",57,"ي",3,0],["أبكي الشباب لكفٍّ مُنَّ ساعِدُها","وقد تَردُّ وتلوي كفَّ لاويها",57,"ي",3,0],["أَبكي عَلَيكَ بِأَدمُعٍ هَطّالَةٍ","وَلَقَد يَقلُ لَكَ النَجيعُ الأَحمَرُ",58,"ر",1,0],["أَبكي إِذا مَرَّ الغِناءُ بِمَسمَعي","فَكَأَنَّ شَدوَ الشاضِياتِ عَويلُ",59,"ل",1,0],["أَبكي وَأَستَبكي العُيونَ عَلَيكُمُ","أَيُّ الدُموعِ عَليكُمُ لا تَهطِلُ",60,"ل",1,0],["أَبكي وَتُصغي إِلى بُكائي","يا رَبُّ هَل تَعشَقُ النُجومُ",61,"م",1,0],["أَبكيكُمُ وَيُحَقُّ لي","وَلَوَ اَنَّ ما أَبكي دَمُ",62,"م",1,0],["أَبكيكَ بِالشِعرِ الَّذي","قَد رَقَّ حَتّى صارَ دَمعا",63,"ع",2,0],["أَبكي وَنَبكي وَنُبكي غَيرنا أَسَفا","لدى التَذَكُّرِ نِسوانا وَوُلدانا",64,"ن",2,0],["أبكي بليل حف بالظلمات","مستعبرا والليل للعبرات",65,"ت",1,1],["أبكي إذا استذكرت شعرك مجهشا","بعد الهدوء ووقفة الحركات",65,"ت",1,0],["أبكي حياتك آسفا لذهابها","قبلي وأبكي من بقاء حياتي",65,"ي",1,0],["ابكى اذا ذكرته","على سنيه الغابره",66,"ر",2,0],["ابكي عليك كلما","لي الخيال مثلك",67,"ك",1,0],["ابكي لذكراك كما","بكيت يوم مت لك",67,"ك",1,0],["ابكي خلالك التي","طابت وابكي جملك",67,"ك",1,0],["ابك فان عبرة","الباكين سلوى لهم",68,"م",1,0],["ابك ان شئت في المصاب وان كا","ن البكى غير لائق بالرجال",69,"ل",1,0],["ابكي به افراح عهد ذاهب","في عهدي الباقي الذي لم يذهب",70,"ب",1,0],["ابكي اذا مرت لترحمني فلا","ليلى ترق ولا دموعي تشفع",71,"ع",1,0],["أبكي ومثلي بالبكاء حقيق","آمال شعب مالها تحقيق",72,"ق",1,1],["ابكي وادري ان هذا البكى","في الخطب لا يجدر بالعاقل",73,"ل",1,0],["أبكى بالدمع لنواحك","وتنوّح يا حمام لبكايه",74,"ا",3,0],["أبكى الأخلاء في ديار","من أنسهم أصبحت خلاء",75,"ا",2,0],["أبكي الصِباء رخيًّا من أعنته","جرى بنا لمدى ال