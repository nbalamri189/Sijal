{"poems":[[110,"سطا حُسناً","https://www.shoaraa.com/p13815",""],[55,"رجونا أبا الهيجاء إذ مات حارث","https://www.aldiwan.net/poem30665.html","الطويل"],[79,"لقد رام كتم الوجد يوم ارتحاله","https://www.aldiwan.net/poem36375.html","الطويل"],[75,"ألم يأن أن يبكي الغمام على مثلي","https://www.aldiwan.net/poem11932.html","الطويل"],[95,"بلغت أقصى العمر الفاني","https://www.aldiwan.net/poem11247.html","السريع"],[53,"غدا الدهر مفترا أغر المضاحك","https://www.aldiwan.net/poem65812.html","الطويل"],[31,"يا مي هلا يجازي بعض ودكم","https://www.aldiwan.net/poem6157.html","البسيط"],[91,"الأغاني تصبي ولست بدار","https://www.aldiwan.net/poem44756.html","الكامل"],[87,"جلوسك أم سلام العالمينا","https://www.aldiwan.net/poem7798.html","الوافر"],[87,"ظلم الرجال نساءهم وتعسفوا","https://www.aldiwan.net/poem63768.html","الكامل"],[47,"كيف به والزمان يهرب به","https://www.aldiwan.net/poem10913.html","المنسرح"],[47,"أعاد شكوى من الطيف الذي اعتادا","https://www.aldiwan.net/poem63468.html","البسيط"],[63,"حسب الأمير سماح وطد الحسبا","https://www.aldiwan.net/poem51801.html","البسيط"],[63,"لنا مغن حسن الغناء","https://www.aldiwan.net/poem51825.html","الرجز"],[51,"لهفي على الزمن القصير","https://www.aldiwan.net/poem64191.html","مجزوء الكامل"],[46,"غنى فشاقك طائر غريد","https://www.aldiwan.net/poem30528.html","الكامل"],[33,"أمست كراع الغميم موحشة","https://www.aldiwan.net/poem42619.html","المنسرح"],[33,"قالت ثريا لأتراب لها قطف","https://www.aldiwan.net/poem42621.html","البسيط"],[76,"وأغيد في صدر الندي لحسنه","https://www.aldiwan.net/poem12844.html","الطويل"],[107,"أعيدوا الحق واتخذوه عهدا","https://www.aldiwan.net/poem42104.html","الوافر"],[107,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[107,"أدأبك أن تريد المستحيلا","https://www.aldiwan.net/poem44213.html","الوافر"],[8,"الحمد لله لا شريك له","https://www.aldiwan.net/poem21831.html","المنسرح"],[78,"من محب شفه سقمه","https://www.aldiwan.net/poem38991.html","المديد"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85676","الرمل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62241","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/142405","الوافر"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20985","المنسرح"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142068","المتقارب"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54201","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54292","الكامل"],[98,"راكبة الدراجة","https://www.poetsgate.com/ViewPoem.aspx?id=15719",""],[47,"كَيْفَ بِهِ، وَالزّمانُ يَهْرُبُ بِهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31551",""],[96,"النبع المسحور","https://www.poetsgate.com/ViewPoem.aspx?id=15631",""],[33,"أمستْ كراعُ الغميمِ موحشة ً،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18784&r=&rc=47",""],[114,"أيها الفاسي أتى ريحك","https://www.aldiwan.net/poem2369.html","مجزوء الرمل"],[140,"قد كنت أحسب أنني جلد القوى","https://www.aldiwan.net/poem68041.html","الكامل"],[155,"القادمون الخضر","https://www.aldiwan.net/poem17107.html","عموديه"],[163,"هنيته عيدا فصل وانحر","https://www.aldiwan.net/poem58821.html","الرجز"],[198,"أتعرف بالصحراء شرقي شابك","https://www.aldiwan.net/poem54400.html","الطويل"],[198,"علاني الشيب واشتعل اشتعالا","https://www.aldiwan.net/poem54419.html","الوافر"],[213,"يا سيداً هباته","https://www.aldiwan.net/poem13333.html","مجزوء الرجز"],[278,"أشدو بها وسط الندي الحاشد","https://www.aldiwan.net/poem25593.html","الرجز"],[300,"يا صاح هذا المشهد الأقدس","https://www.aldiwan.net/poem33243.html","السريع"],[325,"بان السفاء وأودى الجهل والسرف","https://www.aldiwan.net/poem56340.html","البسيط"],[345,"رقادك قلبي شجاك الألم","https://www.aldiwan.net/poem55386.html","المتقارب"],[351,"إبعث بذى قرنين من لي به","https://www.aldiwan.net/poem20729.html","السريع"],[374,"ما يصبح العاذل معذورا","https://www.aldiwan.net/poem57393.html","السريع"],[380,"حلول حال أفرقنا مجالا","https://www.aldiwan.net/poem59176.html","الوافر"],[406,"يا من له الذهن الشريف والذكا","https://www.aldiwan.net/poem34103.html","الرجز"],[419,"شرف البصرة مولانا المشير","https://www.aldiwan.net/poem54069.html","الرمل"],[455,"ترفع عن معاداة الكريم","https://www.aldiwan.net/poem61339.html","الوافر"],[455,"أيها الشعب لماذا تنتحر","https://www.aldiwan.net/poem61615.html","الرمل"],[460,"بالغور ما شاء المطايا والمطر","https://www.aldiwan.net/poem56190.html","الرجز"],[460,"حمام اللوى رفقا به فهو لبه","https://www.aldiwan.net/poem56306.html","الطويل"],[466,"في لأذني عن كل لاح صمم","https://www.aldiwan.net/poem3159.html","عموديه"],[470,"وبربطاني غدا","https://www.aldiwan.net/poem59948.html","مجزوء الرجز"],[479,"نوق براهن السرى","https://www.aldiwan.net/poem15219.html","مجزوء الرجز"],[517,"أعرب إذا ما الخطب لم يعرب","https://www.aldiwan.net/poem12015.html","السريع"]],"verses":[["يرفرف في الضلوع بلا جناح","ويلهث دونما ساق وثابا",0,"ب",2,0],["يَرُفُّ عَلى ناديهِمُ الحِلمُ وَالحِجا","إِذا ما لَغا لاغٍ مِنَ القَومِ رافِثُ",1,"ث",1,0],["يَرفٌّ إلَى الْعافِينَ لألاَءُ بِشرِهِ","كَمَا رَفَّ مَتْنُ الْعَضْبِ عِنْدَ صِقَالِهِ",2,"ل",2,0],["يَرِفُّ عَلى التَأميلِ لَألاءُ بِشرِهِ","كَما رَفَّ لَألاءُ الحُسامِ عَلى الصَقلِ",3,"ل",1,0],["يَرْفَبُ مَا سَاءَ وَمَا سَرَّ مِن","أحْوَالِهِ رَقْبَةَ يَقْظَانِ",4,"ن",1,0],["يُرفّعْنَ أصواتاً لِداناً وتارةً","يُنَمنمنَ وشْياً غيرَ وشي الحوائك",5,"ك",1,0],["يَرفَعُها الآلُ لِلتالي فَيُدرِكُهُم","طَرفٌ حَديدٌ وَطَرفٌ دونَهُم غَرِقُ",6,"ق",1,0],["يرفع الصوت جاهرا ثم يلقي","هامسا ما يلقى الى الاوتار",7,"ر",1,0],["يرفع السباقين ان لهم في","كل شوط براءة من عثار",7,"ر",1,0],["يرفِّعك المقام عن أبتذال","وعن عبث الحوادث والرجال",8,"ل",1,0],["يَرفُلنَ في أُزُرِ الحَريرِ تَنَوَّعَت","أَلوانُهُ كَالزَهرِ في آذارِ",9,"ر",1,0],["يَرفَضُّ عَن ساطِعِ المَشيبِ كَما اِ","رفَضَّ خانُ الضَرامِ عَن لَهَبِه",10,"ب",2,0],["يُرَفَّهونَ بِسيحِ النَهرَوانِ إِذا","ضَنَّ السَحابُ بِجاري سَيلِهِ جادا",11,"د",2,0],["يَرِفُّ منه على أمواجِها زَهَرٌ","أربى على الزَّهْرِ حتى عاد مُكْتئِبا",12,"ب",2,0],["يرفعُ دهماءَ على شَقراءِ","تلعبُ في حُلَّتِها السَّوداءِ",13,"ا",2,0],["يَرفُلنَ في حُلَلِ المَحا","سِنِ وَالمَجاسِدِ وَالحَريرِ",14,"ر",1,0],["يَرفُلنَ أَمثالَ العَذارى طُوَّفاً","حَولَ الدَوارِ وَقَد تَدانى العيدُ",15,"د",1,0],["يَرفُلنَ في الرَيطِ وَالمُروطِ مِ","نَ الخَزِّ يُسحِبنَها عَلى الكُثُبِ",16,"ب",1,0],["يَرفُلنَ في مِطرَفاتِ السوسِ آوِنَةً","وَفي العَتيقِ مِنَ الديباجِ وَالقَصَبِ",17,"ب",1,0],["يَرُفُّ بِرَوضِ الحُسنِ مِن نورِ وَجهِهِ","وَقامَتِهِ نُوّارَةٌ وَقَضيبُ",18,"ب",1,0],["يَرِفُّ فيقذف الأبطالَ غُلْباً","تجيشُ إلى الوَغَى بالخيلِ جُرْدا",19,"د",2,0],["يَرُفُّ رجاؤُهنَّ على رجاء","يُناشِدُ يثربَ العهدَ المصونا",20,"ن",2,0],["يَرِفُّ على الدُّنَى ظِلاًّ ظليلا","نَصيبك نِلتَهُ من فضلِ ربِّ",21,"ب",1,0],["يَرفَعُ بالقارِ والحَدِيدِ مِنَ ال","جَوزِ طِوالاً جُذُوعُها عُمُما",22,"م",2,0],["يرفعُ الشّكوى إلى قمرٍ","تَنْجلي عن وجههِ ظُلَمهْ",23,"م",2,0],["يرفع الشعب فريقا","ن إناثٌ وذكورُ",24,"ر",1,1],["يَرْفُلْنَ في الرَّيْطِ لَمْ يَنْقَبْ دَوَابِرُهُ","مَشْيَ النِّعَاجِ بِحِقْفِ الرَّمْلَةِ الحُرُنِ",25,"ن",1,0],["يرفّ على خمائل غوطتيها","هوى بطل على الغمرات طاحا",26,"ح",2,0],["يَرفَعُها مَن بَنى لَدَى قَزَعِ","الُمزنِ وتَندَى مِسكاً مَحارِبُها",27,"ب",3,0],["يُرِفُ عليها فراشُ الهوى","فهنَّا جناحٌ وهنَّا جناحْ",28,"ح",1,0],["يَرْفَعُ الصّوْتَ لا يَرَى مِنْ مُجِيبٍ","أَقْفَرَ الكَوْنُ من قُلُوبِ الرّجال",29,"ل",1,0],["يَرْفُلْنَ في ضَافِي الضِّيَاءِ نَوَاعِماً","في سِحْرِ أنغامٍ وَلينِ قُدُودِ",30,"د",1,0],["يرفع طرف الثّوب في مزاح","لا يستحي من لائم ولا حي",31,"ح",2,0],["يَرْفَضُّ عَن ساطعِ المَشيبِ كما ارْ","فَضّ دُخانُ الضّرَامِ عَن لَهَبِهْ",32,"ب",2,0],["يرفعني الموج . إلى شاهق","وحطّني .. لا تهدأ الكفّتان",33,"ن",1,0],["يرفلنَ في الريطِ والمروطِ، م","خَزِّ، يُسَحِّبْنَها عَلَى الكُثُب",34,"ب",1,0],["يَرفُضُ النفلَ مَع الفَر","ض أَوانَ الزير وَالبَم",35,"م",1,0],["يَرفُلنَ في وَشيِ البُرودِ عَشِيَّةً","مِثلَ الظِباءِ وَقَد مُلِئنَ شَباباً",36,"ب",2,0],["يرفعون الإسلام نوراً وناراً","في الدُّنا، بعد غربةٍ وغيابِ",37,"ب",1,0],["يرفعُ صوتاً لم يمر مثله","بمسمع كالضيغم المزمجر",38,"ر",1,0],["يَرفانِ نَضاخاً إِذا ما أَعانَهُ","نَدى اللَيلِ مجَّ الماءَ ريان مُعشِبا",39,"ب",2,0],["يَرِفُّ الإِقحُوانُ بحافَتَيها","بِحَيثُ يُقابِلُ الجِلدُ الرِمالا",40,"ل",2,0],["يرفع حالي معرباً","عن خاطري بالكسر",41,"ر",1,0],["يَرْفُل للدّماء في مَجاسِد","من ذائِبٍ صَاكَ بهِ وجامِد",42,"د",1,0],["يرفلُ من تَقواه في حُلَّةٍ","يحسدُها الدِيباجُ والسُندسُ",43,"س",1,0],["يَرفَعُ فَودَيهِ إِن جَدَّ الجِراءُ بِهِ","أَورَقُ أَخرَجُ في ظُنبوبِهِ سَقَفُ",44,"ف",1,0],["يرف إليه جناح الخلود","ويهفو إليه شعاع النسم",45,"م",1,0],["يَرْفَعُ لي قَدْراً وَقِدْراً بها","نَصْبُ خُواني بينَ إخوانِ",46,"ن",1,0],["يَرفعُها بالكأسِ ذو مُقلَةٍ","مَقدورَةٍ تحمِلُ مَقدورا",47,"ر",2,0],["يرفرف فوق رسل اللَه جهراً","يضيء بألسنٍ كانت مثالا",48,"ل",2,0],["يرفعه ينصبه يجره","يكسره الفعل إذا أردته",49,"ت",2,0],["يرفع الجَوْرَ ويبدي عدله","منصفٌ بالحكم عدلٌ لا يجور",50,"ر",1,0],["يرف الشعر لي في كل شيء","رفيف الشدو في الصمت المقيم",51,"م",1,0],["يرفضُ الوَهمَ ويأبى فوقه","أوصياءَ من عُجولٍ وبقر",52,"ر",1,0],["يرفضُ العسف ويَأبى دينه","صلواتٍ لعتماةٍ وحجر",52,"ر",1,0],["يرفَعُ عنها حدَبَ الموج إذا اس","تنَّتْ صناعُ الرِّجْل في خوضِ الغَمَرْ",53,"ر",1,0],["يرفِّعهُ عن بذلة البعد عتبُهُ","وهمّته العليا إلى الناس ذنبُهُ",54,"ب",2,0],["يرفع عافيه كما يخفضُ من","باراهُ أو ناصبُه ويجزِم",55,"م",1,0],["يَرفَعُ عَينَيهِ إِلى","كُلِّ مَكانٍ راسُهُ",56,"س",2,0],["يَرِفُّ أويميلُ","كالنَّزيفِ عُلَّ المَسْكِرا",57,"ر",2,0],["يرفعها أبلح من طيء","نيرانه تجلو دجى الغيهب",58,"ب",1,0]]}