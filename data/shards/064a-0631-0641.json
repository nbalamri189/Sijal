الجنوبي","https://www.poetsgate.com/ViewPoem.aspx?id=205798",""],[5776,"لحيةُ الصّبح","https://www.poetsgate.com/ViewPoem.aspx?id=199324",""],[5829,"ثنايا الورد","https://www.poetsgate.com/ViewPoem.aspx?id=176840",""],[5956,"الحب المُعَاد","https://www.poetsgate.com/ViewPoem.aspx?id=181934",""],[5956,"أُلامُ لأني أحبُّ","https://www.poetsgate.com/ViewPoem.aspx?id=182085",""],[5956,"هِلالُ السماء سوارُ يديها","https://www.poetsgate.com/ViewPoem.aspx?id=182628",""],[5956,"ذكرياتُ مشاهدَ من حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=184838",""],[5956,"من صفات الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=185778",""],[6052,"أبواب النفوس","https://www.poetsgate.com/ViewPoem.aspx?id=34966",""],[6093,"يرفرفُ إن ذكرتَ لديَّ قلبٌ","https://www.poetsgate.com/ViewPoem.aspx?id=176498",""],[6117,"فَتَاةُ الْقُدْسِ","https://www.poetsgate.com/ViewPoem.aspx?id=182794",""],[6131,"يَا صَاعدًا للنورِ متَّكئَ النَّدَى","https://www.poetsgate.com/ViewPoem.aspx?id=189339",""],[520,"أعرب اذا ما الخطب لم يعرب","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577440",""],[6237,"القلب الكبير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77899&r=&rc=41",""],[6260,"نجوى المحتضرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68315&r=&rc=7",""],[5126,"قولا لذات اللّمى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87803&r=&rc=18",""],[6364,"قبر في المرج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82466&r=&rc=5",""]],"verses":[["يرفرف في الضلوع بلا جناح","ويلهث دونما ساق وثابا",0,"ب",2,0],["يَرُفُّ عَلى ناديهِمُ الحِلمُ وَالحِجا","إِذا ما لَغا لاغٍ مِنَ القَومِ رافِثُ",1,"ث",1,0],["يَرفٌّ إلَى الْعافِينَ لألاَءُ بِشرِهِ","كَمَا رَفَّ مَتْنُ الْعَضْبِ عِنْدَ صِقَالِهِ",2,"ل",2,0],["يَرِفُّ عَلى التَأميلِ لَألاءُ بِشرِهِ","كَما رَفَّ لَألاءُ الحُسامِ عَلى الصَقلِ",3,"ل",1,0],["يَرْفَبُ مَا سَاءَ وَمَا سَرَّ مِن","أحْوَالِهِ رَقْبَةَ يَقْظَانِ",4,"ن",1,0],["يُرفّعْنَ أصواتاً لِداناً وتارةً","يُنَمنمنَ وشْياً غيرَ وشي الحوائك",5,"ك",1,0],["يَرفَعُها الآلُ لِلتالي فَيُدرِكُهُم","طَرفٌ حَديدٌ وَطَرفٌ دونَهُم غَرِقُ",6,"ق",1,0],["يرفع الصوت جاهرا ثم يلقي","هامسا ما يلقى الى الاوتار",7,"ر",1,0],["يرفع السباقين ان لهم في","كل شوط براءة من عثار",7,"ر",1,0],["يرفِّعك المقام عن أبتذال","وعن عبث الحوادث والرجال",8,"ل",1,0],["يَرفُلنَ في أُزُرِ الحَريرِ تَنَوَّعَت","أَلوانُهُ كَالزَهرِ في آذارِ",9,"ر",1,0],["يَرفَضُّ عَن ساطِعِ المَشيبِ كَما اِ","رفَضَّ خانُ الضَرامِ عَن لَهَبِه",10,"ب",2,0],["يُرَفَّهونَ بِسيحِ النَهرَوانِ إِذا","ضَنَّ السَحابُ بِجاري سَيلِهِ جادا",11,"د",2,0],["يَرِفُّ منه على أمواجِها زَهَرٌ","أربى على الزَّهْرِ حتى عاد مُكْتئِبا",12,"ب",2,0],["يرفعُ دهماءَ على شَقراءِ","تلعبُ في حُلَّتِها السَّوداءِ",13,"ا",2,0],["يَرفُلنَ في حُلَلِ المَحا","سِنِ وَالمَجاسِدِ وَالحَريرِ",14,"ر",1,0],["يَرفُلنَ أَمثالَ العَذارى طُوَّفاً","حَولَ الدَوارِ وَقَد تَدانى العيدُ",15,"د",1,0],["يَرفُلنَ في الرَيطِ وَالمُروطِ مِ","نَ الخَزِّ يُسحِبنَها عَلى الكُثُبِ",16,"ب",1,0],["يَرفُلنَ في مِطرَفاتِ السوسِ آوِنَةً","وَفي العَتيقِ مِنَ الديباجِ وَالقَصَبِ",17,"ب",1,0],["يَرُفُّ بِرَوضِ الحُسنِ مِن نورِ وَجهِهِ","وَقامَتِهِ نُوّارَةٌ وَقَضيبُ",18,"ب",1,0],["يَرِفُّ فيقذف الأبطالَ غُلْباً","تجيشُ إلى الوَغَى بالخيلِ جُرْدا",19,"د",2,0],["يَرُفُّ رجاؤُهنَّ على رجاء","يُناشِدُ يثربَ العهدَ المصونا",20,"ن",2,0],["يَرِفُّ على الدُّنَى ظِلاًّ ظليلا","نَصيبك نِلتَهُ من فضلِ ربِّ",21,"ب",1,0],["يَرفَعُ بالقارِ والحَدِيدِ مِنَ ال","جَوزِ طِوالاً جُذُوعُها عُمُما",22,"م",2,0],["يرفعُ الشّكوى إلى قمرٍ","تَنْجلي عن وجههِ ظُلَمهْ",23,"م",2,0],["يرفع الشعب فريقا","ن إناثٌ وذكورُ",24,"ر",1,1],["يَرْفُلْنَ في الرَّيْطِ لَمْ يَنْقَبْ دَوَابِرُهُ","مَشْيَ النِّعَاجِ بِحِقْفِ الرَّمْلَةِ الحُرُنِ",25,"ن",1,0],["يرفّ على خمائل غوطتيها","هوى بطل على الغمرات طاحا",26,"ح",2,0],["يَرفَعُها مَن بَنى لَدَى قَزَعِ","الُمزنِ وتَندَى مِسكاً مَحارِبُها",27,"ب",3,0],["يُرِفُ عليها فراشُ الهوى","فهنَّا جناحٌ وهنَّا جناحْ",28,"ح",1,0],["يَرْفَعُ الصّوْتَ لا يَرَى مِنْ مُجِيبٍ","أَقْفَرَ الكَوْنُ من قُلُوبِ الرّجال",29,"ل",1,0],["يَرْفُلْنَ في ضَافِي الضِّيَاءِ نَوَاعِماً","في سِحْرِ أنغامٍ وَلينِ قُدُودِ",30,"د",1,0],["يرفع العلم برفع العلما","وارتفاع العلم هلك وخبل",31,"ل",1,0],["يرفع طرف الثّوب في مزاح","لا يستحي من لائم ولا حي",32,"ح",2,0],["يَرْفَضُّ عَن ساطعِ المَشيبِ كما ارْ","فَضّ دُخانُ الضّرَامِ عَن لَهَبِهْ",33,"ب",2,0],["يرفعني الموج . إلى شاهق","وحطّني .. لا تهدأ الكفّتان",34,"ن",1,0],["يرفلنَ في الريطِ والمروطِ، م","خَزِّ، يُسَحِّبْنَها عَلَى الكُثُب",35,"ب",1,0],["يَرفُضُ النفلَ مَع الفَر","ض أَوانَ الزير وَالبَم",36,"م",1,0],["يَرفُلنَ في وَشيِ البُرودِ عَشِيَّةً","مِثلَ الظِباءِ وَقَد مُلِئنَ شَباباً",37,"ب",2,0],["يرفعون الإسلام نوراً وناراً","في الدُّنا، بعد غربةٍ وغيابِ",38,"ب",1,0],["يرفعُ صوتاً لم يمر مثله","بمسمع كالضيغم المزمجر",39,"ر",1,0],["يَرفانِ نَضاخاً إِذا ما أَعانَهُ","نَدى اللَيلِ مجَّ الماءَ ريان مُعشِبا",40,"ب",2,0],["يَرِفُّ الإِقحُوانُ بحافَتَيها","بِحَيثُ يُقابِلُ الجِلدُ الرِمالا",41,"ل",2,0],["يرفع حالي معرباً","عن خاطري بالكسر",42,"ر",1,0],["يَرْفُل للدّماء في مَجاسِد","من ذائِبٍ صَاكَ بهِ وجامِد",43,"د",1,0],["يرفلُ من تَقواه في حُلَّةٍ","يحسدُها الدِيباجُ والسُندسُ",44,"س",1,0],["يَرفَعُ فَودَيهِ إِن جَدَّ الجِراءُ بِهِ","أَورَقُ أَخرَجُ في ظُنبوبِهِ سَقَفُ",45,"ف",1,0],["يرف إليه جناح الخلود","ويهفو إليه شعاع النسم",46,"م",1,0],["يَرْفَعُ لي قَدْراً وَقِدْراً بها","نَصْبُ خُواني بينَ إخوانِ",47,"ن",1,0],["يَرفعُها بالكأسِ ذو مُقلَةٍ","مَقدورَةٍ تحمِلُ مَقدورا",48,"ر",2,0],["يرفرف فوق رسل اللَه جهراً","يضيء بألسنٍ كانت مثالا",49,"ل",2,0],["يرفعه ينصبه يجره","يكسره الفعل إذا أردته",50,"ت",2,0],["يرفع الجَوْرَ ويبدي عدله","منصفٌ بالحكم عدلٌ لا يجور",51,"ر",1,0],["يرف الشعر لي في كل شيء","رفيف الشدو في الصمت المقيم",52,"م",1,0],["يرفضُ الوَهمَ ويأبى فوقه","أوصياءَ من عُجولٍ وبقر",53,"ر",1,0],["يرفضُ العسف ويَأبى دينه","صلواتٍ لعتماةٍ وحجر",53,"ر",1,0],["يرفَعُ عنها حدَبَ الموج إذا اس","تنَّتْ صناعُ الرِّجْل في خوضِ الغَمَرْ",54,"ر",1,0],["يرفِّعهُ عن بذلة البعد عتبُهُ","وهمّته العليا إلى الناس ذنبُهُ",55,"ب",2,0],["يرفع عافيه كما يخفضُ من","باراهُ أو ناصبُه ويجزِم",56,"م",1,0],["يَرفَعُ عَينَيهِ إِلى","كُلِّ مَكانٍ راسُهُ",57,"س",2,0],["يَرِفُّ أويميلُ","كالنَّزيفِ عُلَّ المَسْكِرا",58,"ر",2,0],["يرفعها أبلح من طيء","نيرانه تجلو دجى الغيهب",59,"ب",1,0],["يرفع يمناه إلى رِّبهِ","يدعو وفوق الكبد الأُخرَى",60,"ر",2,0],["يرفع اللّه قدرَ كلّ أديبٍ","عالم للعلوم أصبح حاصل",61,"ل",1,0],["يُرَفْرِفُ فوق رؤوسِ القِيانِ","فَتَنْظُرُ ما يُذْهِلُ النَّاظِرَا",62,"ر",2,0],["يَرِفُّ ضِلعي رَفيفَ الطيرِ تذبحُهُ","سِكّينُ غرْبَتهِ والمارد ُالشَغَفُ",63,"ف",1,0],["يَرفُّ ظِلالُ الأُنسِ والسَّعدُ فَوقَنا","وَيَصفُو وَلِي مِنها لِباسٌ مُكَرَّمُ",64,"م",1,0],["يرفض بأسا ومن عجيب","ركوب أسد على جياد",65,"د",1,0],["يرفّ على مغناك قلبي كلما","تذكرت أياماً مضين زواهيا",66,"ي",2,0],["يرفلن من سندس الفردوس في حلَلٍ","من فوقها حللٌ من تحتها بان",67,"ن",1,0],["يرفلن في الخَزّ وَالمَجاسِد وال","موشيّ محطومة مزامرها",68,"ر",3,0],["يَرفُلُ في مِثلِ الدِثارِ المُخمَلِ","لَم يَدرِ ما قَيدٌ وَلَم يُعَقَّلِ",69,"ل",1,0],["يرفّعهنَ الآل فَوْضى كأنما","أغار على أطرافهنّ سَرُوق",70,"ق",1,0],["يَرفُلنَ في حُلَلِ الحر","ير وهنّ في حُلَلِ الشعائر",71,"ر",1,0],["يرفُل في سُندسِ أَبرادِه","إذا تَعرَّى كلُّ يَخضُورِ",72,"ر",1,0],["يَرفَعُهُ بِذَمِّهِ حَسُودُه","كَأَنَّما نزُولُهُ صُعُودُه",73,"د",2,0],["يَرفَعُ في سَومِهِ وَأُرغِبُهُ","حَتّى التَقى زُهدُهُ وَرَغبَتِيَه",74,"ي",2,0],["يرفرفُ طيرُ الماءِ فوقك طالباً","غذاءً فتعطيه الذي هو طالبه",75,"ب",2,0],["يرفرفُ جفنك إمّا هوت","فيخفقُ قلبي بنار الولوع",76,"ع",1,0],["يرفض دمع الغوالي كلما نظرت","محاسن الجود في المعنى وفي الكلم",77,"م",1,0],["يَرف لِواء النَصر مِن فَوق رَأسه","وَيَخدمه الإقبال وَاليمن وَالسَعد",78,"د",1,0],["يَرفَعَهُ تَارة وَيخفضه","دونَ مَجاري النُجوم تارات",79,"ت",1,0],["يَرفُل مِن عُلومِهِ","في بُردِ فَضلٍ سابِغِ",80,"غ",1,0],["يَرِفُّ عَلَيها الحسنُ يَندى غَضارَةً","كَما اِخضَلَّ غُصنٌ في الخَميلَةِ يانِعُ",81,"ع",1,0],["يرفع الحجب عن وجوه الخفايا","أو يبقى الظلام والصبح أسفر",82,"ر",1,0],["يرفل في ثوب العلى","لذيله مشمِّرا",83,"ر",2,0],["يرفُسُ من كَثَرة الذباب إلى","أن ظَنّه مَعَشرَ مِنَ الشمسُ",84,"س",1,0],[