{"poems":[[95,"طفت والصبح طالباً في الجنان","https://www.aldiwan.net/poem11230.html","الخفيف"],[49,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[40,"ما بال دفك بالفراش مذيلا","https://www.aldiwan.net/poem7807.html","الكامل"],[94,"أزنبقة السفح ما لي أراك","https://www.aldiwan.net/poem38887.html","المتقارب"],[87,"عرابي كيف أوفيك الملاما","https://www.aldiwan.net/poem7581.html","الوافر"],[108,"موكب الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=179775",""],[108,"حديث خرافة","https://www.poetsgate.com/ViewPoem.aspx?id=179406",""],[108,"آمال وآلام !!","https://www.poetsgate.com/ViewPoem.aspx?id=179444",""],[228,"قالوا لها ماذا فعلت","https://www.aldiwan.net/poem41629.html","مجزوء الكامل"],[230,"خبري القوم يا سمية إسكن","https://www.aldiwan.net/poem55220.html","الخفيف"],[330,"سؤالك يا هذا سؤال معاند","https://www.aldiwan.net/poem52139.html","الطويل"],[382,"لو كان للأفلاك نطق أو فم","https://www.aldiwan.net/poem59270.html","الكامل"],[411,"كلام الأمير الندب في ثني نظمه","https://www.aldiwan.net/poem49741.html","الطويل"],[458,"هيا إلى السماء هيا","https://www.aldiwan.net/poem61573.html","مجزوء الخفيف"],[469,"أراك وصفت الروض والدوح واجم","https://www.aldiwan.net/poem3378.html","عموديه"],[505,"رأت أطلال سلما بعد بعد","https://www.aldiwan.net/poem37688.html","الوافر"],[563,"غنى لنا داعي السرور وغردا","https://www.aldiwan.net/poem34573.html","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38819","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38127","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70753","الكامل"],[1052,"","https://poetry.dctabudhabi.ae/diwan/poem/130883","الخفيف"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35353","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136282","المتقارب"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112841","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108625","الطويل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101048","الخفيف"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104732","الطويل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83219","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74270","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67998","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66485","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216785","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111465","المتقارب"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69941","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58170","الكامل"],[4858,"إلى التي نسيت إسلامها","https://www.poetsgate.com/ViewPoem.aspx?id=30116",""],[4858,"شوق والد إلى أولاده","https://www.poetsgate.com/ViewPoem.aspx?id=30458",""],[4858,"كيف ننسى أسيرنا ؟","https://www.poetsgate.com/ViewPoem.aspx?id=138040",""],[4858,"إيهِ يا صاحِ","https://www.poetsgate.com/ViewPoem.aspx?id=138205",""],[4858,"رثاء الشّيخ الحاج محمّد أحمد خليل","https://www.poetsgate.com/ViewPoem.aspx?id=139897",""],[4862,"سلامٌ ألا أيها الشاعرا ن","https://www.poetsgate.com/ViewPoem.aspx?id=55631",""],[4978,"لعل الله يفرجها لعلّهْ","https://www.poetsgate.com/ViewPoem.aspx?id=211982",""],[5302,"موطن العز","https://www.poetsgate.com/ViewPoem.aspx?id=201148",""],[592,"على الحبر بحر العلم الحقائق","https://www.poetsgate.com/ViewPoem.aspx?id=128858",""],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[5388,"مساء الورد","https://www.poetsgate.com/ViewPoem.aspx?id=206917",""],[5410,"انتظار","https://www.poetsgate.com/ViewPoem.aspx?id=139635",""],[5512,"البدر أمسى هلالاً","https://www.poetsgate.com/ViewPoem.aspx?id=204347",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[5616,"كواكب","https://www.poetsgate.com/ViewPoem.aspx?id=203426",""],[5650,"عَائِشَة... وَحْيُ الْقَصِيد!","https://www.poetsgate.com/ViewPoem.aspx?id=131223",""],[5720,"قادةٌ وأثَر *","https://www.poetsgate.com/ViewPoem.aspx?id=199812",""],[4623,"على من باح بالحب ملام (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146605",""],[5829,"يا تراب المجد","https://www.poetsgate.com/ViewPoem.aspx?id=192052",""],[5830,"سَلامٌ لِعَيْنَيْنِ","https://www.poetsgate.com/ViewPoem.aspx?id=201123",""],[5906,"بِترا","https://www.poetsgate.com/ViewPoem.aspx?id=188068",""],[5943,"بالفكر نسمو","https://www.poetsgate.com/ViewPoem.aspx?id=37121",""],[6068,"ورثنا المجد ميراث فرض -15-","https://www.poetsgate.com/ViewPoem.aspx?id=175886",""],[4442,"آبر لم يزل يشق ويرفو","https://www.poetsgate.com/ViewPoem.aspx?id=170997",""],[6152,"قسوة شوق","https://www.poetsgate.com/ViewPoem.aspx?id=203584",""]],"verses":[["فَنَرَى أَنْفُسَ الْحِسَانِ حِسَاناً","حَيْثُمَا هُنَّ عَنْ حُلِيٍّ غَوَانِي",0,"ن",2,0],["فَنَرجوكَ إِحساناً وَنَخشاكَ صَولَةً","لِأَنَّكَ جَبّارٌ وَأَنَّكَ جابِرُ",1,"ر",1,0],["فَنَرى عَطِيَّةَ ذاكَ إِن أَعطَيتَهُ","مِن رَبِّنا فَضلاً وَمِنكَ جَزيلا",2,"ل",2,0],["فَنَرقُدُ تَحْتَ التُّرابِ الأَصمِّ","جميعاً على نَغَمَاتِ الحَزَنْ",3,"ن",1,0],["فنرفعها إلى البارى دماء","ونعرضها له جثثا وهاما",4,"م",2,0],["فنرى حقولَ القمح تَنفَحُها الصَّبا","فتمُوجُ موجَ الماء في الأنهار",5,"ر",1,0],["فنرجو الله لَوْ مَنَّ","على الأسماع بالوَقْر",6,"ر",1,0],["فنرى ونسمعُ صامتين، كأننا","لم نستمع، وكأننا لم نشهد",7,"د",1,0],["فَنَراهُ يَنثُرُ دَمعَه","في كُلِّ يَومٍ كَالبَرَد",8,"د",1,0],["فَنَرى فيه كلَّ بحثٍ جديدٍ","يَقِفُ الحقَّ في صُفوفِ النِساء",9,"ا",2,0],["فنرضى من الوجه الذي هو خلقه","ونسخط من وجه اكتساب الخطيئة",10,"ه",1,0],["فنراه مثل أبيه ربّاً قادراً","هدمَ الأنامَ وعرشُه لا يُهدَم",11,"م",1,0],["فنروي إذا نَروي بدائعَ نَظمِهِ","ونَظْما إذا لم نَروِ يَوماً لهُ نَظْما",12,"م",2,0],["فنرى المجد يا مليك أنت","ونغني لك الثناء",13,"ا",2,0],["فنرجسهُ الغضُّ النَّدي طرف مدنفٍ","ومنثورهُ المنظومُ كفٌ بلا زند",14,"د",1,0],["فنروى من مياه فجاج حيٍّ","يزمزمها الولوع وليس يظما",15,"م",2,0],["فنراه يصبغنا بمحض إرادة","أزلية كيف اقتضته على المدى",16,"د",2,0],["فَنَرجِسُ عَينَيهِ يُنادي عِذارَهُ","أَيا صاحِبي هَذا العَقيقُ فَقِف بِهِ",17,"ه",1,0],["فَنَرتَجي العَفوَ يا مَن أَنتَ مَعدَنُهُ","وَالعَفوُ مِن خَيرِ خُلقٍ فيك مَحمودِ",18,"د",1,0],["فنرى الحسود به كئيباً حازنا","يزداد من بعد الهوانِ هوانا",19,"ن",2,0],["فنرى جملة الصحاة بريا","ها سكارى وما همو بسكارى",20,"ر",2,0],["فَنَرجِسُ الحُسنِ يَرمي بِالذُبولِ إِلى","قاضي الهَوى في اِنتِهازِ فُرصَةِ الأَدَبِ",21,"ب",1,1],["فنرجو الذي عمنا فضله","بحسن الملاقاة يشفي العليل",22,"ل",1,0],["فنرجوا إله العالمين بحقكم","جميل غرام في اتصال بحضرة",23,"ه",1,0],["فنرحل عن أرض الشآم ونغتني","بنعمة توفيق التي ملأت مصرا",24,"ر",2,0],["فنرى الغرب بالحضارة يزهو","في زروع مخضلة وكروم",25,"م",1,0],["فَنَرجُوكَ رَبَّ العالَمِينَ تُنِيلُنَا","مَحَبَّةَ مَحبُوبٍ لَهُ الخَيرُ وَاقِعُ",26,"ع",1,0],["فَنَرى الأَديبَ وَقَد تَخَرَّقَ جَيبُهُ","لا يَستَطيعُ القِرشُ فيهِ مُقاما",27,"م",2,0],["فَنرجع بِالنَصر العَزيز وَتَنثَني","نُكوصاً عَلى الأَعقاب لِلناب وَالأَيدي",28,"د",2,0],["فنرجع وَفْراً والقَنيص من الظِّبا","تَضيق بِهِ ذَرْعاً رِحالُ الرَّكائب",29,"ب",1,0],["فنرى الفكر نازلاً في صعودٍ","إن تبدّا وصاعداً في نزول",30,"ل",1,0],["فنرى الفرد في مضائك شعبا","ونرى الشعب في ولائك فردا",31,"د",2,0],["فَنُرجِعَ هِيلانَةَ الأَرغُسِيَّه","بِاَموَالِها خَوفَ شَرِّ البَلِيَّه",32,"ه",1,0],["فَنرى بَنيهِ حَول مائِدَةٍ لَهُ","كَغروس زَيتون البقاع وَاجملا",33,"ل",2,0],["فنرى جباهَهمُ بدوراً قد بَدَتْ","من تحتِ تيجانس من العقْيَانِ",34,"ن",1,0],["فنراكِ خَولَة في الإباءِ وأختَ عائشة التقيّه","فلئنْ رشدْت لترشدنْ أجيالنا هذي الفتيّه",35,"ي",2,0],["فنَراكُمُ حيناً يؤلّفُ بينكمْ","جذلُ التّداعُبِ في حريرِ إهابِ",36,"ب",1,0],["فنراهمُ عاثوا فساداً في الحمى","ونراهمُ لا يرقبونَ رقيبا",37,"ب",2,0],["فنرى فارسَ والرّوم هوى","فيهما تيجانُ ظلمٍ وغرور",38,"ر",1,0],["فنراكَ طوداً راسخاً بثباته","ونراك جنّةَ أرضنا وشذاها",39,"ا",3,0],["فنرجوكما ترك هذا النزاع","ونرجوا الهدوء كفى ما حصل",40,"ل",1,0],["فنرجع مثلما بالأمس كنّا","على درب الهدى من بعد ضِلّةْ",41,"ل",2,0],["فنراك في السلم تحفظ عهدا","ومع الحيف صارما بتارا",42,"ر",2,0],["فنرجو من المولى له العفو والرضى","ومحو الذنوب المثقلات العوائق",43,"ق",1,0],["فنرجع عن هذي الجهالات كلها","إلى الحق والبرهان من واضح السبل",44,"ل",1,0],["فَنرشِفُ أُمنياتِ الفجرِ مُشرقَةً","بِأقداحٍ مِن الشُّكرانِ وَ الحَمدِ",45,"د",1,0],["فنروي من كؤوس الحب","عزما يثمر الصبرا",46,"ر",2,0],["فنرسمُ الجسمَ إذ نبدي مفاتنَهُ","في وصفِها نكتبُ الاشعارَ ننحرفُ",47,"ف",1,0],["فنرى (الخوخ) منه أصناف شتى","وكذا (المشمش) الذي قد أتاها",48,"ا",3,0],["فنركبها عراةٌ كالمرايا","ويقدح في معاصمنا الزناد!",49,"د",1,0],["فَنَرَى مِحَشّ النّارِ يَلْهَجُ بِالْهَبَا","ءِ وَيَكْتَسِي ثَوبَ التّغَنّي بِالرّدَى",50,"د",2,0],["فنرىٰ الأحلامَ أمست عذبةً","كابتسام الصبح في ثغرِ الهَنا",51,"ن",2,0],["فنرى كل الأماني والمنى","في أمان الله مع حسن الختام",52,"م",1,0],["فنرمي باللظى العدوان جمرا","من السجيل أصلته السعيرُ",53,"ر",1,0],["فَنَرْنُو لِكَوْنٍ بَئِيسِ المُحَيَّا","فَيَحْلُو هَوَانَا تُقَىً وَ اهْتِدَاءْ",54,"ا",2,0],["فَنَراهُ بَينَ مَعالِمٍ قَدْ شُكِّلَتْ","تَروي لأهْلِكِ دونَ زَيفٍ ما جَرى",55,"ر",2,0],["فنرى العقول بعزمِ همَّتِهِ غدتْ","في كلِّ دربٍ مايقولُ تُعيدُ",56,"د",1,0],["فنرسلهم إذا ما النصر نادى","ليقنصوا كل شرير تبدّا",57,"د",2,0],["فنراه أذا أكب عليها","معربا لا يشذ عن تنوينه",58,"ن",2,0],["فنرجع نطلب الغفران عما","أتى سهوا ونرفده نوالا",59,"ل",2,0]]}