{"poems":[[55,"هذي الرماح عصي الضال والسلم","https://www.aldiwan.net/poem29765.html","البسيط"],[36,"أضوء سنا برق بدا لك لمعه","https://www.aldiwan.net/poem4863.html","الطويل"],[79,"وجودك حي الملك والدين والدنيا","https://www.aldiwan.net/poem35717.html","الطويل"],[47,"أمير المؤمنين أما غياث","https://www.aldiwan.net/poem64646.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42688","المتقارب"],[79,"وجودك حيى الملك والدين والدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=34199",""],[92,"أنا !","https://www.poetsgate.com/ViewPoem.aspx?id=179156",""],[147,"ما نرى للثناء عنك عدولا","https://www.aldiwan.net/poem11801.html","الخفيف"],[266,"كأن نارك يا مولاي قلب شج","https://www.aldiwan.net/poem38205.html","البسيط"],[318,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[458,"عيد الملايين ازدهت بجلاله","https://www.aldiwan.net/poem61285.html","الكامل"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107201","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[1918,"","https://poetry.dctabudhabi.ae/diwan/poem/99058","الهزج"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109328","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87343","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100328","الوافر"],[3481,"","https://poetry.dctabudhabi.ae/diwan/poem/112964","البسيط"],[3560,"","https://poetry.dctabudhabi.ae/diwan/poem/117157","المتقارب"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110058","البسيط"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97096","الكامل"],[4767,"اعتذار","https://www.poetsgate.com/ViewPoem.aspx?id=91943",""],[4859,"نهاية الجدب!","https://www.poetsgate.com/ViewPoem.aspx?id=207010",""],[585,"لمن الضارب في ظلال الوادي","https://www.poetsgate.com/ViewPoem.aspx?id=161910",""],[5290,"أعد الحديث فليس بالمملول","https://www.poetsgate.com/ViewPoem.aspx?id=113132",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5344,"عطره الشانيل ..","https://www.poetsgate.com/ViewPoem.aspx?id=180706",""],[5736,"محراب الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=208492",""],[5309,"ترنحت كالسكران والسكر اغراء","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573867",""]],"verses":[["وَمَن أُشَيِّعهُ يَأمَن مِن لَوائِمِهِ","وَلَو رَموهُ بِجَرّاحٍ مِنَ الكَلِمِ",0,"م",1,0],["وَمَن أَشتَكي مِنهُ الجَفاءُ وَحُبُّهُ","طَرائِفُ كانَت زَوَّ مَن يَتَحَبَّبُ",1,"ب",1,0],["ومِنْ أشْقَرٍ كالبَرْقِ يسْتَبِقُ الصَّبا","ومِنْ أشْهَبٍ يَفْري أديمَ الدُجى فَرْيا",2,"ي",2,0],["ومنْ أشْهَلٍ رشّ النّجيعُ احْمِرارَهُ","وقد سامَتِ الهيْجاءُ مِرْجلَها غَلْيا",2,"ي",2,0],["وَمِن أَشعارِهِ وَاللَهُ يُخزي","رُعونَتُهُ أَلا بانَ الخَليطُ",3,"ط",1,0],["وَمَنْ أَشْرَكَ النَّاسَ فِي أَمْرِهِ","دَعَتْهُ الضَّرُورَةُ أَنْ يُخْدَعَا",4,"ع",2,0],["ومن أشعل رش النجيع احمراره","وقد سامت الهيجاء مرجلها غليا",5,"ي",2,0],["ومُناشِدي نَسَباً أمُتُّ به","لم يدرِ ما حَسَبي وما نَسَبي",6,"ب",2,0],["وَمَنِ اِشتاقَ أَهلَهُ فَاِشتِياقي","لَيسَ يَعدو جَنابَكَ المَأهولا",7,"ل",2,0],["ومن أشعتها في الجو ألسنة","تدعو الآله ببقياكم وتبتهل",8,"ل",1,0],["ومن أشرقت أنوار مرآة عقله","على ظلمات الطبع منه تجلت",9,"ت",1,0],["ومن اشتطاب لهم حياة حرة","لا زهو مفتون يدلّ بماله",10,"ل",2,0],["وَمَن أَشادَ لكُم بَيتَ الوَلاءِ فَلا","يَكُن جَزَائِيَ ما لاقى سِنِمّارُ",11,"ر",1,0],["ومن أشقر قد موه التبر جسمه","وأضحى له بالنور في الوجه ميسم",12,"م",1,0],["ومنا شبه جبريل ومنكم","سراقة شبه إبليس يقينا",13,"ن",2,0],["ومنا شعراء الأر","ض أهل البدو والحضر",14,"ر",1,0],["ومن أشعة نور الشمس خذ قلما","واقبس لنفسك من حسان انفاسا",15,"س",2,0],["ومِن إشارَتِه في القُربِ مِنهُ على","مِقدَارِ إصبع نَجمَينِ صَغيرَينِ",16,"ن",1,0],["ومن اشرى اصطفى بالمال عزما","يردّ اسود خفَّان ضباعا",17,"ع",2,0],["ومن اشارتهِ في وعظهِ رجعت","جمع الخلائق عمَّا في نفوسهمِ",18,"م",1,0],["ومن أشرِبَ اليأسَ كان الغنِيَّ","ومن أشربَ الحرصَ كان الفقيرا",19,"ر",2,0],["ومن اشارتهم بالتوبةِ انصَدَعَت","بها القُلوبُ لأَن فاظت من النَدَمِ",20,"م",1,0],["ومن اشترى بالدين مرضاة التي","باعت بدنياها الدنية دينها",21,"ن",3,0],["ومن أشجاره يمتد ظل","لمن يجني غدا منها الثمارا",22,"ر",2,0],["ومن أشواقك ابتكرتْ","قوانينَ الهوى العذبِ!",23,"ب",1,0],["ومن اشترى استقلاله بدمائه","لم يستنم لأذى ولا استعباد",24,"د",1,0],["ومن اشرأب إلى لقاء حبيبه","جذب المقادة من يد التعليل",25,"ل",1,0],["ومن أشرك المعصوم في حق ربه","وأسهب في منظومه المدح بالأطرا",26,"ر",2,0],["ومن اشمه تنفتح للفكر غبه","محتواها شعور خلٍ مع خليله",27,"ل",2,0],["ومنْ أشواقنا لهبٌ تجلى","وفي محرابنا يحلو الخشوعُ",28,"ع",1,0],["وَمن أَشبَهَت بِنتَ الهَوى بِمَسيرِها","فَقَد سَكِرَت شَكلاً وَلِلطُّهرِ سيماءُ",29,"ا",2,0]]}