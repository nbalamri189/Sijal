etsgate.com/ViewPoem.aspx?id=194016",""],[5956,"بالشعر ألغي بعض موتي","https://www.poetsgate.com/ViewPoem.aspx?id=202515",""],[5956,"أنهكتَ نفسك لتنفعني وتنفعَ العالم","https://www.poetsgate.com/ViewPoem.aspx?id=206262",""],[5956,"ربَّما هجَرتْ هاجَر بُنوَّتي","https://www.poetsgate.com/ViewPoem.aspx?id=207824",""],[5956,"يا ربَّنا انصرها على أعدائها","https://www.poetsgate.com/ViewPoem.aspx?id=214089",""],[5956,"السيرة الذاتية للدكتور قيسٍ الرِّضواني بالشعر الروحاني","https://www.poetsgate.com/ViewPoem.aspx?id=215553",""],[5956,"كل أب يخشى على ابنه خَشيةً مشروعة","https://www.poetsgate.com/ViewPoem.aspx?id=215770",""],[5957,"أهواكِ!!!","https://www.poetsgate.com/ViewPoem.aspx?id=12552",""],[5957,"أخشى لو قلت أهواك","https://www.poetsgate.com/ViewPoem.aspx?id=122853",""],[5957,"وأتيتُ أجمع عاطر السحب","https://www.poetsgate.com/ViewPoem.aspx?id=208746",""],[5997,"ريمٌ شرودٌ","https://www.poetsgate.com/ViewPoem.aspx?id=215170",""],[6019,"عتاب على هامش الشوق ...!!","https://www.poetsgate.com/ViewPoem.aspx?id=53042",""],[6019,"طواف العبير","https://www.poetsgate.com/ViewPoem.aspx?id=53050",""],[6019,"في محراب الرجاء..!!","https://www.poetsgate.com/ViewPoem.aspx?id=53850",""],[4442,"ميزانكم حاد عن الصواب","https://www.poetsgate.com/ViewPoem.aspx?id=171207",""],[6082,"خوفا عليك","https://www.poetsgate.com/ViewPoem.aspx?id=58975",""],[6093,"أخْلو ، ونفسيَ للهمومِ مَطَارُ","https://www.poetsgate.com/ViewPoem.aspx?id=176070",""],[6093,"كلُّ اللغَاتِ تَعذًّرتْ","https://www.poetsgate.com/ViewPoem.aspx?id=206059",""],[6102,"أُمنِياتٌ بَريئَة !!","https://www.poetsgate.com/ViewPoem.aspx?id=211861",""],[6144,"سي المجلس البلدي","https://www.poetsgate.com/ViewPoem.aspx?id=21836",""],[6202,"لقاء العيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86750&r=&rc=51",""],[6202,"هوى وشباب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86757&r=&rc=58",""],[5957,"أهواك !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82763&r=&rc=147",""],[6242,"أرق المساء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87553&r=&rc=1",""],[6300,"نرجسيّة قلمْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82865&r=&rc=36",""],[6339,"أبواب الحنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87890&r=&rc=2",""]],"verses":[["أَخشى عَلَيها وَلَولا ذاكَ ما وَقَفَت","رَكائِبي بَينَ وِردِ العَزمِ وَالصَدَرِ",0,"ر",1,0],["أَخشى عَلَيها كَسوباً غَيرَ مُدَّخِرٍ","عاري الأَشاجِعِ لا يُشوي إِذا ضَغَما",1,"م",2,0],["أَخشى إِذا اِستَكثَرتُمُ بَينَكُم","مِن قادَةِ الآراءِ أَن تُفضَحوا",2,"ح",3,0],["أَخشى مُرَبِّيَتي إِذا","طَلَعَ النَهارُ وَأَفزَعُ",3,"ع",1,1],["أَخشى عَواقِبَها وَأَغبِطُ شَربَها","وَأُجيدُ مِدحَتَها مَعَ المُدّاحِ",4,"ح",1,0],["أَخشى عَلَيكَ المَنايا","حَتّى كَأَنَّكَ مِنّي",5,"ن",2,0],["أَخشى عَلى أَربَدَ الحُتوفَ وَلا","أَرهَبُ نَوءَ السِماكِ وَالأَسَدِ",6,"د",1,0],["أخشى عليك اضطرامَ الدهر لا عِللاً","تُخشَى على كل كابي الزند عُوّارِ",7,"ر",1,0],["أخشى كسادي على النساء إذا","أسنَنْتُ والسن جَمَّةُ الخبلِ",8,"ل",1,0],["أَخشى عَلى الأَحشاءِ مِن كِتمانِها","وَأَخافُ أَن أَشكو فَيَشمَتَ حُسَّدي",9,"د",2,0],["أَخشى عَلى أَخلاقِكُم إِن زارَكُم","وَهيَ الحِسانُ تَصيرُ غَيرَ حِسانِ",10,"ن",1,0],["أَخشى عَلَيكِ حِبالَ المَوتِ راصِدَةً","بِكُلِّ مَورِدَةٍ يُرجى بِها الطَمَعُ",11,"ع",1,0],["اخشى على الانسان ان","يزداد بالانسان حقدا",12,"د",2,1],["اخشى عليكم في الحياة تدهورا","فيه الرؤوس تقبل الاقداما",13,"م",2,0],["أَخشى عَلَيهِم مِن أَذىً رائِحٍ","يَجمَعُهُم في الفَجرِ وَالعَصرِ غاد",14,"د",1,0],["أَخشى الخَراجَ وَقَد دَعَوتُ لِعُظمِهِ","مَلِكَ المُلوكِ وَرافِدَ الرُفّادِ",15,"د",1,0],["أَخٌ شَكَرتُ لَهُ نُعمى أَخي ثِقَةٍ","زَكَت لَدَيَّ وَمَنّا غَيرَ مَمنونِ",16,"ن",1,0],["أَخِشَّةَ كُلَّ جُرشُعَةٍ وَغَوجٍ","مِنَ النَعَمِ الَّذي يَحمي سَنامي",17,"م",2,0],["أَخشى عَليهِ بِأَن يُصابَ بِأَسهُمي","مِمّا يُسابِقُني إِلى الأَغراضِ",18,"ض",1,0],["أخشى إذا قبَّلْتُها حَلْيَها","مخافةً أنْ ينطقَ الصامتُ",19,"ت",1,0],["أخشى على نفسي منهُ فإنْ","قاطعني متُّ ولو كنتُ فيلْ",20,"ل",1,0],["أَخشى عَلَيهِ العَينَ إِن بَصُرَت بِهِ","وَتَرى صَبابَتَنا بِهِ فَتَهابُهُ",21,"ب",2,0],["اخشَعْ أبا لهبٍ فإنْ تَكُ ذا عَمىً","فجبالُ مَكّةَ والأباطحُ خُشَّعُ",22,"ع",1,0],["أَخشى عَلَيكَ العارَ مِن قَولِهِم","مُعتَدِلُ القامَةِ لَم يَعدِلِ",23,"ل",1,0],["أَخشى عَلَيكَ الفَيضَ مِن أَدمُعي","وَأَنتَ في عَيني كَما تَدري",24,"ر",2,0],["أخشاكَ تُنسي الشمسَ مطلعَها كما","أنسى الملائكَ ذكرُك التسبيحا",25,"ح",2,0],["أَخَشيتَ سوءَ الفَهمِ حينَ فَعَلتَ ذا","أَم لَم تَثِق بِيَ في قِراةِ كِتابي",26,"ب",2,0],["أَخشى قُضَيِّبَ كَرمٍ أَن يُنازِعَني","فَضلَ الخِطامِ وَإِن أَسرَعتُ إِغذاذا",27,"ذ",2,0],["أَخشى عَلَيكِ مِنَ الجاراتِ حاسِدَةً","أَو سَهمَ غَيرانِ يَرميني وَيَرميكِ",28,"ك",1,1],["أَخشى الرَدى حَزَناً إِذا شَحِطَت","وَأَخافَهُ بِدُنُوِّها فَرَحا",29,"ح",2,0],["أَخُشّابَ حَقّاً أَنَّ دارَكِ تُزعِجُ","وَأَنَّ الَّذي بَيني وَبَينَكِ يَنهِجُ",30,"ج",1,1],["أَخشى عِقابَكَ إِن قَدَرتَ وَلَم","أَغدِر فَيُؤثَرَ بَينَنا الكَلِمُ",31,"م",1,0],["أَخشى وَقَد سارَ سير المصلحين بهم","أَن لا يَسير عَلى آثاره الخلف",32,"ف",1,0],["أخشى ظنونَ الناس فيكِ وأتقي","سِمَةَ الضَّنى والغيرة الحمقاءِ",33,"ا",2,0],["أَخْشَى شَظَايَا أَرَاهَا مِنْ تَفَرُّقِّكُمْ","إِنْ تَصْدُقَ الصُّحْفَ تَرْجِيعاً وتَرْدِيدَا",34,"د",2,0],["أَخْشَى كَثِيراً مِنْ إِجَادَتِكِ الَّتِي","تَجْلُو بِلا رِفْقٍ دَمَامَةَ ظَاهِرِي",35,"ر",2,0],["إِخْشَوْا عَلَيْنَا الْيُتْمَ مِنْهَا فَلَقَدْ","أَرَى أَمَرَّ اليُتْمِ أَحْلَى وِرْدَا",36,"د",2,0],["أخشابا جدّ مبروزة","بأسامي ناس تتزين",37,"ن",1,0],["أ\"خشَّابَ\" قدْ طالَ انتظاري فأنعمي","على رجلٍ يدعو الأطبَّاءَ مُتعبا",38,"ب",2,0],["أ\"خُشَّابَ\" قد ْكانت على القلبِ قرحة","ٌ من الشَّوقِ لاَ يسطيعها مَنْ تطبَّبا",38,"ب",2,0],["اخشى يطول على الصراط","عذاب مطلعك الحسن",39,"ن",1,0],["أَخْشى عَلَيْكَ إِذا مَشَيْتَ تَقَصُّفاً","وَكَذا يُخافُ عَلى القَضيبِ إِذا نَشا",40,"ش",2,1],["أخشى إذا عدتم استيصال ساقتكم","فاستعطفوا واسئلوا أن تعقد الذمم",41,"م",1,0],["أخشاك بل أخشى عليك فتارةً","أرجو رضاك وتارةً أتخوَّفُ",42,"ف",1,0],["أخشى على حسبتي العدو وفي ال","ناس لمثلي أصادقٌ وعدي",43,"د",2,1],["أخشى الهلال توهما من بأسه","ولربما هلك المحب توهما",44,"م",2,0],["أخشى التماس يديه من ترفٍ به","وأظنه لولا الغلائل سالا",45,"ل",2,0],["أَخشاكِ غَضْبَى كَما أَرْجوكِ راضِيةً","فكَمْ أرَجِّيكِ يا هَذي وأَخْشاكِ",46,"ك",1,0],["أخشى عليك من العيون","يا ربة الحُسن المصون",47,"ن",1,1],["أخشى إلهي وأومله","وحسن ظني فيه أولى لي",48,"ل",2,0],["أخشى عليك وأنت تحلم عابثا","ألّا يكون لما يفوتك مرجع",49,"ع",1,0],["أخشَى عليك وقد أضَرَرْتَ مُعتدِياً","عُقْبَى جنايةٍ طَرْفٍ منكَ فَتّان",50,"ن",1,0],["أخشى الردى وأنا طريحٌ في الردى","أرأيتَ غصناً مورقاً ويبيسا",51,"س",2,0],["أَخشاك تَذبلُهُ بِأَن","فاس الصَبابة عِندَ قَطفِهِ",52,"ف",2,0],["أَخشى الحمام لِأَني لا أَراكِ إِذا","أَماتَني الشَوق لا أَخشاهُ مِن فَرق",53,"ق",1,0],["أَخشى عَلى خَدّه أَن مثلتهُ ليَ ال","أَفكار وَالوَهم أَن يُدمى لِرقَتِهِ",54,"ت",2,0],["أخشَى عليه الكاشِحين فكُلُّهم","غَضبانُ يُسخِطُهُ هَوانَا لا رَضِي",55,"ض",2,0],["أخشى الأراقمَ أن أُسمِّيَها","فأقولُ موضعَ زينبٍ لُبْنَى",56,"ن",2,0],["اُخشنْ إذا لاقيتَ يومَك أو فَلِنْ","واشدُدْ فإنك ميّتٌ أو فاحلُلِ",57,"ل",1,0],["أخشى الرياحَ عليه أن تهبَّ فما","تراه في غير حجري أو على كتفي",58,"ف",2,0],["أخشى الوشاة بها فلولا ثغرهُ","لبكيتُ من ضحك البروق اللمَّع",59,"ع",1,0],["أخشى على إحسانها","عينَ الخليل إذ كمل",60,"ل",1,0],["أَخشَنُ ما أَلمَسُ مِن عَتبِهِ","أَرطَبُ ما يُلمَسُ مِن عُذري",61,"ر",2,0],["أخشى الثمانين على أنها","أقصى أمانيّ وإن خفتها",62,"ت",3,0],["أخشى خيال الهدبِ يجرح خدَّهُ","فيقومُ من سِنة الكرى متذعّرا",63,"ر",2,0],["أَخشى لِساني أَنْ يبوحَ بما","أشكوهُ في جِدٍّ وفي لِعْبِ",64,"ب",1,0],["أَخَشِيتَ طُولَ حَدِيثها","فَقطَعْتَها مِنْ حَيْثُ رَقَّتْ",65,"ت",1,0],["أخشَى وأرجُو وعسى اللهَ أن","يُيَسرَ الأمرَ لخاشٍ وراج",66,"ج",1,0],["أخشى عليها أن تلاقي المنون","أخشى على روحي التي في الأصول",67,"ل",1,0],["أخشى سهام مآقي الغيد رانية","لأن حمر المنايا في مآقيها",68,"ي",3,0],["أَخشى عَلَيهِ عيون الناس تنهبه","إِذا بَدا طالِعاً وَالشمس في قرَنِ",69,"ن",1,0],["أخشى على رسلهم نيّاته وهمُ","منه أمامَ جلاميدٍ وأدغال",70,"ل",1,0],["اخشى رداها فتبدى لي صلابتها","كأنما حدثت في اسم ابي الحسن",71,"ن",1,0],["اخشى