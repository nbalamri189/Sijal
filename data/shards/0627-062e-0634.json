{"poems":[[3,"ذنبي لعبلة ذنب غير مغتفر","https://www.aldiwan.net/poem162.html",""],[24,"يقول حياي من عوف ومن جشم","https://www.aldiwan.net/poem21881.html","البسيط"],[88,"ما لي أرى الأكمام لا تفتح","https://www.aldiwan.net/poem10674.html","الرجز"],[88,"أخشى مربيتي","https://www.aldiwan.net/poem10701.html","مجزوء الكامل"],[88,"مرت كعمر الورد بينا أجتلي","https://www.aldiwan.net/poem10939.html","الكامل"],[88,"يا يوم تكريم حفني","https://www.aldiwan.net/poem68862.html","المجتث"],[4,"ما إن تعري المنون من أحد","https://www.aldiwan.net/poem21157.html","المنسرح"],[53,"يا كائنا بين أوعاث وأوعار","https://www.aldiwan.net/poem62972.html","البسيط"],[53,"لا تعذل النفس في تعجلها","https://www.aldiwan.net/poem65884.html","المنسرح"],[93,"شوق يروح مع الزمان ويغتدي","https://www.aldiwan.net/poem8800.html","عموديه"],[93,"مازال يمشي في الأمور بفكره","https://www.aldiwan.net/poem62771.html","عموديه"],[40,"عاد الهموم وما يدري الخلي بها","https://www.aldiwan.net/poem7725.html","البسيط"],[91,"اخشى على الانسان ان","https://www.aldiwan.net/poem44687.html","مجزوء الكامل"],[91,"يا موطنا قد ذبت فيه غراما","https://www.aldiwan.net/poem44748.html","الكامل"],[87,"يا ناشر العلم بهذي البلاد","https://www.aldiwan.net/poem63771.html","السريع"],[47,"حقا أقول لقد تبلت فؤادي","https://www.aldiwan.net/poem63504.html","الكامل"],[47,"طيف لعلوة ما ينفك يأتيني","https://www.aldiwan.net/poem66689.html","البسيط"],[30,"ألستم عائجين بنا لعنا","https://www.aldiwan.net/poem5607.html","الوافر"],[68,"وأغر تبري الإهاب مردد","https://www.aldiwan.net/poem40683.html","الكامل"],[71,"شامية في خدها شامة","https://www.aldiwan.net/poem28212.html","السريع"],[71,"لاعب شطرنج علا دسته","https://www.aldiwan.net/poem28247.html","السريع"],[33,"ما بال قلبك عاده أطرابه","https://www.aldiwan.net/poem42638.html","الكامل"],[107,"وضح اليقين لمن يرى أو يسمع","https://www.aldiwan.net/poem44221.html","الكامل"],[83,"لا تطلبوا ثأري فلا حق لي","https://www.aldiwan.net/poem61502.html","السريع"],[83,"ضللت بالبدر على نوره","https://www.aldiwan.net/poem61517.html","السريع"],[77,"هل كان ضمخ بالعبير الريحا","https://www.aldiwan.net/poem69095.html","الكامل"],[50,"يا كاتبا كتب الغداة يسبني","https://www.aldiwan.net/poem10826.html","الكامل"],[50,"قالوا تنسك بعد الحج قلت لهم","https://www.aldiwan.net/poem63255.html","البسيط"],[52,"أخشى عليك من الجارات حاسدة","https://www.aldiwan.net/poem62299.html","البسيط"],[52,"قاس الهموم تنل بها نجحا","https://www.aldiwan.net/poem63980.html","الكامل"],[52,"أخشاب حقا أن دارك تزعج","https://www.aldiwan.net/poem63985.html","الطويل"],[1,"إني وجدك ما هجوتك وال","https://www.aldiwan.net/poem34016.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85451","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39655","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54691","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54872","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54693","الرجز"],[102,"لص تحت الأمطار","https://www.poetsgate.com/ViewPoem.aspx?id=50429",""],[52,"أ\"حارثَ\" علِّلني وإنْ كنتُ مسهَبا","https://www.poetsgate.com/ViewPoem.aspx?id=15957",""],[92,"أمنعم القلب الخلى","https://www.poetsgate.com/ViewPoem.aspx?id=178972",""],[159,"أخشى عليك إذا مشيت تقصفا","https://www.aldiwan.net/poem55648.html","الكامل"],[164,"هموا بحرب ومناهم به الحلم","https://www.aldiwan.net/poem58920.html","البسيط"],[208,"بيني وبينك يا ظلوم الموقف","https://www.aldiwan.net/poem53234.html","الكامل"],[260,"أخشى على حسبتي العدو وفي","https://www.aldiwan.net/poem48523.html","المنسرح"],[265,"أعطى سرائرك النحول اللوما","https://www.aldiwan.net/poem38193.html","الكامل"],[265,"أيظن بي أني رنا أو مالا","https://www.aldiwan.net/poem38210.html","الكامل"],[279,"يا قرة العين إن العين تهواك","https://www.aldiwan.net/poem25546.html","البسيط"],[294,"أخشى عليك من العيون","https://www.aldiwan.net/poem11709.html","مجزوء الكامل"],[308,"يا آخذا مني بأذيالي","https://www.aldiwan.net/poem16757.html","السريع"],[332,"مجد يهان وعزة تتضعضع","https://www.aldiwan.net/poem54922.html","الكامل"],[368,"يا مودع السر درا عند أجفاني","https://www.aldiwan.net/poem60635.html","البسيط"],[381,"نار تثير على الضلوع وطيسا","https://www.aldiwan.net/poem59384.html","الكامل"],[384,"ريم يجرحني بطرفه","https://www.aldiwan.net/poem48788.html","مجزوء الكامل"],[384,"ما كان أغناك يا قلبي عن القلق","https://www.aldiwan.net/poem48818.html","البسيط"],[384,"تورد الدمع من توريد وجنته","https://www.aldiwan.net/poem48819.html","البسيط"],[413,"في ذلك الحي المعرض لي هوي","https://www.aldiwan.net/poem32452.html","الكامل"],[461,"ألطيمة حبست بكاظمة","https://www.aldiwan.net/poem55845.html","أحذ الكامل"],[461,"ما بعد يومك سلوة لمعلل","https://www.aldiwan.net/poem55988.html","الكامل"],[461,"وابن سررت به إذ قيل لي ذكر","https://www.aldiwan.net/poem56109.html","البسيط"],[467,"ما كنت بالباكي جآذر لعلع","https://www.aldiwan.net/poem3291.html","عموديه"],[467,"جد بقلبي وهزل","https://www.aldiwan.net/poem3313.html","عموديه"],[471,"لنا أخ خير بلا شر","https://www.aldiwan.net/poem60080.html","السريع"],[498,"عشرون من عمري تنفيتها","https://www.aldiwan.net/poem10242.html","السريع"],[517,"يا ناقل المصباح لا تمرر على","https://www.aldiwan.net/poem20865.html","الكامل"],[554,"ماذا يضيرك هند من حبي","https://www.aldiwan.net/poem48051.html","أحذ الكامل"],[589,"يا ناتفا شعرات عا","https://www.aldiwan.net/poem17461.html","مجزوء الكامل"],[760,"","https://poetry.dctabudhabi.ae/diwan/poem/89628","السريع"],[1158,"","https://poetry.dctabudhabi.ae/diwan/poem/80109","الرجز"],[1168,"","https://poetry.dctabudhabi.ae/diwan/poem/75855","الكامل"]],"verses":[["أَخشى عَلَيها وَلَولا ذاكَ ما وَقَفَت","رَكائِبي بَينَ وِردِ العَزمِ وَالصَدَرِ",0,"ر",1,0],["أَخشى عَلَيها كَسوباً غَيرَ مُدَّخِرٍ","عاري الأَشاجِعِ لا يُشوي إِذا ضَغَما",1,"م",2,0],["أَخشى إِذا اِستَكثَرتُمُ بَينَكُم","مِن قادَةِ الآراءِ أَن تُفضَحوا",2,"ح",3,0],["أَخشى مُرَبِّيَتي إِذا","طَلَعَ النَهارُ وَأَفزَعُ",3,"ع",1,1],["أَخشى عَواقِبَها وَأَغبِطُ شَربَها","وَأُجيدُ مِدحَتَها مَعَ المُدّاحِ",4,"ح",1,0],["أَخشى عَلَيكَ المَنايا","حَتّى كَأَنَّكَ مِنّي",5,"ن",2,0],["أَخشى عَلى أَربَدَ الحُتوفَ وَلا","أَرهَبُ نَوءَ السِماكِ وَالأَسَدِ",6,"د",1,0],["أخشى عليك اضطرامَ الدهر لا عِللاً","تُخشَى على كل كابي الزند عُوّارِ",7,"ر",1,0],["أخشى كسادي على النساء إذا","أسنَنْتُ والسن جَمَّةُ الخبلِ",8,"ل",1,0],["أَخشى عَلى الأَحشاءِ مِن كِتمانِها","وَأَخافُ أَن أَشكو فَيَشمَتَ حُسَّدي",9,"د",2,0],["أَخشى عَلى أَخلاقِكُم إِن زارَكُم","وَهيَ الحِسانُ تَصيرُ غَيرَ حِسانِ",10,"ن",1,0],["أَخشى عَلَيكِ حِبالَ المَوتِ راصِدَةً","بِكُلِّ مَورِدَةٍ يُرجى بِها الطَمَعُ",11,"ع",1,0],["اخشى على الانسان ان","يزداد بالانسان حقدا",12,"د",2,1],["اخشى عليكم في الحياة تدهورا","فيه الرؤوس تقبل الاقداما",13,"م",2,0],["أَخشى عَلَيهِم مِن أَذىً رائِحٍ","يَجمَعُهُم في الفَجرِ وَالعَصرِ غاد",14,"د",1,0],["أَخشى الخَراجَ وَقَد دَعَوتُ لِعُظمِهِ","مَلِكَ المُلوكِ وَرافِدَ الرُفّادِ",15,"د",1,0],["أَخٌ شَكَرتُ لَهُ نُعمى أَخي ثِقَةٍ","زَكَت لَدَيَّ وَمَنّا غَيرَ مَمنونِ",16,"ن",1,0],["أَخِشَّةَ كُلَّ جُرشُعَةٍ وَغَوجٍ","مِنَ النَعَمِ الَّذي يَحمي سَنامي",17,"م",2,0],["أَخشى عَليهِ بِأَن يُصابَ بِأَسهُمي","مِمّا يُسابِقُني إِلى الأَغراضِ",18,"ض",1,0],["أخشى إذا قبَّلْتُها حَلْيَها","مخافةً أنْ ينطقَ الصامتُ",19,"ت",1,0],["أخشى على نفسي منهُ فإنْ","قاطعني متُّ ولو كنتُ فيلْ",20,"ل",1,0],["أَخشى عَلَيهِ العَينَ إِن بَصُرَت بِهِ","وَتَرى صَبابَتَنا بِهِ فَتَهابُهُ",21,"ب",2,0],["اخشَعْ أبا لهبٍ فإنْ تَكُ ذا عَمىً","فجبالُ مَكّةَ والأباطحُ خُشَّعُ",22,"ع",1,0],["أَخشى عَلَيكَ العارَ مِن قَولِهِم","مُعتَدِلُ القامَةِ لَم يَعدِلِ",23,"ل",1,0],["أَخشى عَلَيكَ الفَيضَ مِن أَدمُعي","وَأَنتَ في عَيني كَما تَدري",24,"ر",2,0],["أخشاكَ تُنسي الشمسَ مطلعَها كما","أنسى الملائكَ ذكرُك التسبيحا",25,"ح",2,0],["أَخَشيتَ سوءَ الفَهمِ حينَ فَعَلتَ ذا","أَم لَم تَثِق بِيَ في قِراةِ كِتابي",26,"ب",2,0],["أَخشى قُضَيِّبَ كَرمٍ أَن يُنازِعَني","فَضلَ الخِطامِ وَإِن أَسرَعتُ إِغذاذا",27,"ذ",2,0],["أَخشى عَلَيكِ مِنَ الجاراتِ حاسِدَةً","أَو سَهمَ غَيرانِ يَرميني وَيَرميكِ",28,"ك",1,1],["أَخشى الرَدى حَزَناً إِذا شَحِطَت","وَأَخافَهُ بِدُنُوِّها فَرَحا",29,"ح",2,0],["أَخُشّابَ حَقّاً أَنَّ دارَكِ تُزعِجُ","وَأَنَّ الَّذي بَيني وَبَينَكِ يَنهِجُ",30,"ج",1,1],["أَخشى عِقابَكَ إِن قَدَرتَ وَلَم","أَغدِر فَيُؤثَرَ بَينَنا الكَلِمُ",31,"م",1,0],["أَخشى وَقَد سارَ سير المصلحين بهم","أَن لا يَسير عَلى آثاره الخلف",32,"ف",1,0],["أخشى ظنونَ الناس فيكِ وأتقي","سِمَةَ الضَّنى والغيرة الحمقاءِ",33,"ا",2,0],["أَخْشَى شَظَايَا أَرَاهَا مِنْ تَفَرُّقِّكُمْ","إِنْ تَصْدُقَ الصُّحْفَ تَرْجِيعاً وتَرْدِيدَا",34,"د",2,0],["أَخْشَى كَثِيراً مِنْ إِجَادَتِكِ الَّتِي","تَجْلُو بِلا رِفْقٍ دَمَامَةَ ظَاهِرِي",35,"ر",2,0],["إِخْشَوْا عَلَيْنَا الْيُتْمَ مِنْهَا فَلَقَدْ","أَرَى أَمَرَّ اليُتْمِ أَحْلَى وِرْدَا",36,"د",2,0],["أخشابا جدّ مبروزة","بأسامي ناس تتزين",37,"ن",1,0],["أ\"خشَّابَ\" قدْ طالَ انتظاري فأنعمي","على رجلٍ يدعو الأطبَّاءَ مُتعبا",38,"ب",2,0],["أ\"خُشَّابَ\" قد ْكانت على القلبِ قرحة","ٌ من الشَّوقِ لاَ يسطيعها مَنْ تطبَّبا",38,"ب",2,0],["اخشى يطول على الصراط","عذاب مطلعك الحسن",39,"ن",1,0],["أَخْشى عَلَيْكَ إِذا مَشَيْتَ تَقَصُّفاً","وَكَذا يُخافُ عَلى القَضيبِ إِذا نَشا",40,"ش",2,1],["أخشى إذا عدتم استيصال ساقتكم","فاستعطفوا واسئلوا أن تعقد الذمم",41,"م",1,0],["أخشاك بل أخشى عليك فتارةً","أرجو رضاك وتارةً أتخوَّفُ",42,"ف",1,0],["أخشى على حسبتي العدو وفي ال","ناس لمثلي أصادقٌ وعدي",43,"د",2,1],["أخشى الهلال توهما من بأسه","ولربما هلك المحب توهما",44,"م",2,0],["أخشى التماس يديه من ترفٍ به","وأظنه لولا الغلائل سالا",45,"ل",2,0],["أَخشاكِ غَضْبَى كَما أَرْجوكِ راضِيةً","فكَمْ أرَجِّيكِ يا هَذي وأَخْشاكِ",46,"ك",1,0],["أخشى عليك من العيون","يا ربة الحُسن المصون",47,"ن",1,1],["أخشى إلهي وأومله","وحسن ظني فيه أولى لي",48,"ل",2,0],["أخشى عليك وأنت تحلم عابثا","ألّا يكون لما يفوتك مرجع",49,"ع",1,0],["أخشَى عليك وقد أضَرَرْتَ مُعتدِياً","عُقْبَى جنايةٍ طَرْفٍ منكَ فَتّان",50,"ن",1,0],["أخشى الردى وأنا طريحٌ في الردى","أرأيتَ غصناً مورقاً ويبيسا",51,"س",2,0],["أَخشاك تَذبلُهُ بِأَن","فاس الصَبابة عِندَ قَطفِهِ",52,"ف",2,0],["أَخشى الحمام لِأَني لا أَراكِ إِذا","أَماتَني الشَوق لا أَخشاهُ مِن فَرق",53,"ق",1,0],["أَخشى عَلى خَدّه أَن مثلتهُ ليَ ال","أَفكار وَالوَهم أَن يُدمى لِرقَتِهِ",54,"ت",2,0],["أخشَى عليه الكاشِحين فكُلُّهم","غَضبانُ يُسخِطُهُ هَوانَا لا رَضِي",55,"ض",2,0],["أخشى الأراقمَ أن أُسمِّيَها","فأقولُ موضعَ زينبٍ لُبْنَى",56,"ن",2,0],["اُخشنْ إذا لاقيتَ يومَك أو فَلِنْ","واشدُدْ فإنك ميّتٌ أو فاحلُلِ",57,"ل",1,0],["أخشى الرياحَ عليه أن تهبَّ فما","تراه في غير حجري أو على كتفي",58,"ف",2,0],["أخشى الوشاة بها فلولا ثغرهُ","لبكيتُ من ضحك البروق اللمَّع",59,"ع",1,0],["أخشى على إحسانها","عينَ الخليل إذ كمل",60,"ل",1,0],["أَخشَنُ ما أَلمَسُ مِن عَتبِهِ","أَرطَبُ ما يُلمَسُ مِن عُذري",61,"ر",2,0],["أخشى الثمانين على أنها","أقصى أمانيّ وإن خفتها",62,"ت",3,0],["أخشى خيال الهدبِ يجرح خدَّهُ","فيقومُ من سِنة الكرى متذعّرا",63,"ر",2,0],["أَخشى لِساني أَنْ يبوحَ بما","أشكوهُ في جِدٍّ وفي لِعْبِ",64,"ب",1,0],["أَخَشِيتَ طُولَ حَدِيثها","فَقطَعْتَها مِنْ حَيْثُ رَقَّتْ",65,"ت",1,0],["أَخشى عليك اليومَ من مَصعَةٍ","خَدباءَ من ذي هَبَّةٍ مِقصَلِ",66,"ل",1,0],["أَخشَنُ شُن علَيَّ منْ بعض اللَّمَمْ","في غَدْرَة سَبْعاً من مالِ الأُمَمْ",67,"م",1,1],["أَخشى الفَواحِشَ منهما كلتيهما","وَرَعَيتُ نَفسي ناشِئاً للمَكبَرِ",68,"ر",1,0]]}