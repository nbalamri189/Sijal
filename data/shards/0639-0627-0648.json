{"poems":[[75,"عاودت ذكرى الهوى من بعد نسيان","https://www.aldiwan.net/poem11870.html","البسيط"],[53,"بدر وشمس ولدا كوكبا","https://www.aldiwan.net/poem8321.html","السريع"],[53,"وقفات رأيك في الخطوب تأمل","https://www.aldiwan.net/poem65996.html","الكامل"],[47,"عاود القلب بثه وخباله","https://www.aldiwan.net/poem65603.html","الخفيف"],[99,"بي نزوع إلى الدموع الهوامي","https://www.aldiwan.net/poem24764.html","الخفيف"],[82,"أي روح لي في الريح القبول","https://www.aldiwan.net/poem31315.html","الرمل"],[33,"عاود القلب بعض ما قد شجاه","https://www.aldiwan.net/poem41263.html","الخفيف"],[33,"عاود القلب من تذكر جمل","https://www.aldiwan.net/poem41275.html","الخفيف"],[33,"عاود القلب يا لقومي سقما","https://www.aldiwan.net/poem41338.html","الخفيف"],[33,"عاود القلب من سلامة نصب","https://www.aldiwan.net/poem42607.html","الخفيف"],[77,"فتكات طرفك أم سيوف أبيك","https://www.aldiwan.net/poem69051.html","الكامل"],[50,"أنزف دمعي طول تسكابه","https://www.aldiwan.net/poem10782.html","السريع"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30500","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54819","الرمل"],[92,"شاغور حمانا","https://www.poetsgate.com/ViewPoem.aspx?id=179166",""],[33,"عاودض القلبَ من تذكرِ جملٍ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19125&r=&rc=387",""],[118,"إني بدهماء عز ما أجد","https://www.aldiwan.net/poem20955.html","المنسرح"],[146,"ما فاز بالحمد ولا ناله","https://www.aldiwan.net/poem58429.html","السريع"],[369,"شاق الحمام إليك لما ناحا","https://www.aldiwan.net/poem60965.html","الكامل"],[398,"ما بال علوى لا ترد جوابي","https://www.aldiwan.net/poem53671.html","الكامل"],[418,"عاود عيني نصبها وغروره","https://www.aldiwan.net/poem39.html","الطويل"],[438,"حي وجها من الرياض وسيما","https://www.aldiwan.net/poem12376.html","الخفيف"],[449,"أما لقربك بعد الهجر ميعاد","https://www.aldiwan.net/poem55954.html","عموديه"],[473,"يا من تغيب عنا","https://www.aldiwan.net/poem59616.html","مجزوء الرمل"],[475,"عاود القلب من سلامة نصب","https://www.aldiwan.net/poem4639.html","الخفيف"],[558,"عاود عزاءك لا يعنف بك الذكر","https://www.aldiwan.net/poem68392.html","البسيط"],[558,"هجر الصبا وأناب وهو طروب","https://www.aldiwan.net/poem68420.html","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48769","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119897","الخفيف"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72299","البسيط"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72328","السريع"],[1473,"","https://poetry.dctabudhabi.ae/diwan/poem/124026","الخفيف"],[1576,"","https://poetry.dctabudhabi.ae/diwan/poem/205760","الرمل"],[1910,"","https://poetry.dctabudhabi.ae/diwan/poem/116548","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88659","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60902","البسيط"],[2449,"","https://poetry.dctabudhabi.ae/diwan/poem/115369","السريع"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87767","الرمل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205426","الخفيف"],[2875,"","https://poetry.dctabudhabi.ae/diwan/poem/124045","الخفيف"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103005","الخفيف"],[3927,"","https://poetry.dctabudhabi.ae/diwan/poem/113711","الرمل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136456",""],[4422,"","https://poetry.dctabudhabi.ae/diwan/poem/116628","الطويل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83134","الرمل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76695","السريع"],[4578,"راع القلوب مصابٌ جاء بالعجب","https://www.poetsgate.com/ViewPoem.aspx?id=49352",""],[5156,"هد ركن الخلافة الموطود","https://www.poetsgate.com/ViewPoem.aspx?id=99129",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[5841,"شهريار وشهرزادي","https://www.poetsgate.com/ViewPoem.aspx?id=34907",""]],"verses":[["عاوَدتُ ذِكرى الهَوى مِن بَعدِ نِسيانِ","وَاِستَحدَثَ القَلبُ شَوقاً بَعدَ سُلوانِ",0,"ن",1,1],["عاونَ فيه منظرٌ مخبراً","مستحسَنٌ ساعَد مُستعذبا",1,"ب",2,0],["عاونْتَهم ولزمْتَ طاعةَ ربّهم","ففضلْتَ بالحسنى ومثلك يفضلُ",2,"ل",1,0],["عاوَدَ القَلبَ بَثُّهُ وَخَبالُه","لِخَليطٍ زُمَّت بِلَيلٍ جِمالُه",3,"ل",2,1],["عاودتني طفولتي فيك حتى","خلت أني ما اجتزتُ يوم عذاب",4,"ب",1,0],["عاوِدي منكِ هُبُوباً فيه لي","وَجَدَ البُرْءَ عليلٌ بعَليلِ",5,"ل",1,0],["عاوَدَ القَلبَ بَعضُ ما قَد شَجاهُ","مِن حَبيبٍ أَمسى هَوانا هَواهُ",6,"ا",2,1],["عاوَدَ القَلبَ مِن تَذَكُّرِ جُملٍ","ما يَهيجُ المُتَيَّمَ المَحزونا",7,"ن",2,1],["عاوَدَ القَلبُ يا لَقَومِيَ سُقماً","يَومَ أَبدَت لَنا قُرَيبَةُ صَرما",8,"م",2,1],["عاوَدَ القَلبَ مِن سَلامَةَ نُصبُ","فَلِعَينَيَّ مِن جَوى الحُبِّ سَكبُ",9,"ب",1,1],["عاودتَ من دارِ الخلافةِ مطلعاً","فطلعتَ شمساً غيرَ ذاتِ دُلوك",10,"ك",1,0],["عاوَدَ قَلبي كُنهُ أَطرابِهِ","مِن حُبِّ مَن أَصبَحتُ أَغنى بِهِ",11,"ب",2,0],["عَاوَدتُ ذِكْرَ العَيْشِ فيه وما انْقَضَى","مِن صَبْوتِي وطَوَيْتُ مِن أَزْمانِهَا",12,"ن",3,0],["عَاوَدَتْنِي جَارَةُ السَّوْءِ الَّتِي","فارَقَتْنِي مُنْذُ أَيَّامٍ قِصَارِ",13,"ر",1,0],["عاودتُ بعد تغيُّبٍ لُبنانا","ونزلتُ رَحْبَ فِنائه جَذلانا",14,"ن",2,1],["عاودتُ ماءَكِ ناهلاً وحسبتُني","عاودتُ بعدَ تعفُّفٍ إدمانا",14,"ن",2,0],["عاودض القلبَ من تذكرِ جملٍ،","مَا يَهِيجُ المُتَيَّمَ المَحزونا",15,"ن",2,1],["عاوَدَني حُبُّها وَقَد شَحَطَت","صَرفُ نَواها فَإِنَّني كَمِدُ",16,"د",1,0],["عاودَه من دائه نَكسُهُ","من بعد أن شارف إبلالَهْ",17,"ل",2,0],["عاوٍ يَقومُ على أناملِ رِجْلِه","لتنَال منه الكَفُّ نَجْماً لاحا",18,"ح",2,0],["عاوَدتُ عرصَةَ أَصبَهانَ وَجَهلُها","ثَبتُ القَواعِدِ مُحكمُ الاِطنابِ",19,"ب",1,0],["عاوَدَ عَينَي نَصبُهَا وَغُرورُه","أهمُّ عَرَاهَا أمٍ قَذَاها يَعُورُهَا",20,"ر",3,1],["عاودَتْنا البَليلُ عنه بِلَيْلٍ","فأَعادَتْ لنا الحديثَ القديما",21,"م",2,0],["عاودتنا بلواء الافك تنشره","وكل سعيك تفريق وافساد",22,"د",1,0],["عاوِد إِلى اللَهوِ وَاِنعَم","ما دامَ عودُكَ لَدنا",23,"ن",2,0],["عاوَدَ القَلبَ مِن سَلامَةَ نَصبُ","فَلِعَينيَّ مِن جَوى الحُبِّ غَربُ",24,"ب",1,1],["عاوِد عَزاءَكَ لا يَعنُف بِكَ الذِكَرُ","ماذا الَّذي بَعدَ شَيبِ الرَأسِ تَنتَظِرُ",25,"ر",1,1],["عاوَدتُ يا يَعقوبُ مِنكَ صَنائِعاً","مَحمودَةً عَهدي بِهِنَّ قَريبُ",26,"ب",1,0],["عاود جهادكَ مقضيَّ المشيئاتِ","واستكمل النصر سلميَّ الفتوحاتِ",27,"ت",1,1],["عاود القلب شجوه واد كاره","يوم سارت عن حاجر أقماره",28,"ر",2,1],["عاومك البحر غمراً ليس تنتزف","أسماعنا لمعاني درها صدفُ",29,"ف",1,1],["عاومكم ينظر من زهرها","أنضر من زهر البساتين",30,"ن",1,0],["عاودوا الأهل موجعين وءابوا","يندبون الأعمام والأخوالا",31,"ل",2,0],["عاودَ القلب خبالٌ رَدَعَهْ","كلَّما قلتُ تناهى صَدَعَهْ",32,"ع",2,1],["عاود بلادك واقصد الملك الذي","يكسو دُجى آمالك الاشراقا",33,"ق",2,0],["عاودت بالحسن الجميل فاجملي","وهبي ثناياك العذاب معذبا",34,"ب",2,0],["عاوِدْ كما كنتَ لا تاَتْيك نائبةٌ","والْطِفْ بعبدك لا غيّرنَك الغِيَرُ",35,"ر",1,0],["عاودني من غده طالعاً","كأنني بالأمس ربيته",36,"ت",2,0],["عاود القَلبَ حَنيني وَالجَوى","وَتَولّاه خفوق وَوَجيف",37,"ف",1,0],["عاودتني وكنت منفرداً في ال","ليل أبكي على شقائي المقيم",38,"م",1,0],["عاود العين سهدُها فحماها","سنة النوم فاستباح حماها",39,"ا",3,1],["عاوناني إن كنتما تسعداني","بمديحي له وإكرامه لي",40,"ل",2,0],["عاود الداء له من بعد ما","صح منه القلب من حر اللهيب",41,"ب",1,0],["عاودَ جِفني سُهادهُ أترى","بين جفوني وبينه رحما",42,"م",2,0],["عاوَدَ عَينَي نَصبُهَا وَغُرورُها","أهمُّ عَرَاهَا أمٍ قَذَاها يَعُورُهَا",43,"ر",3,1],["عاوَد القَلب حَنينُه","مَن عَلى الشَوقِ يُعينُه",44,"ن",2,1],["عاوده الشوق وكان استراح","وانبرت الطير تغني فناخ",45,"خ",1,1],["عاؤه مستجاباً ما دعا أبداً","لمن تيمم علياه ولم يجب",46,"ب",1,0],["عاود البدر نوره لتجلي","ه ونور الأمير ما لا يعود",47,"د",1,0],["عاودتني عبرةٍ بأقصى الحشا","والدموع من المدامع سايحات",48,"ت",1,0],["عاودت ما قالته ثم امهلت له ساعتين","ما تبي تعقل كلامه او تقول الله ارادي",49,"د",2,0]]}