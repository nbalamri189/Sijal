{"poems":[[59,"تعصي الإله وأنت تظهر حبه","https://www.aldiwan.net/poem24670.html","الكامل"],[9,"بانت سعاد وأمسى حبلها انقطعا","https://www.aldiwan.net/poem21951.html","البسيط"],[87,"يا فرنسا نلت أسباب السماء","https://www.aldiwan.net/poem63728.html","الكامل"],[47,"أأحمد هل لأعيننا اتصال","https://www.aldiwan.net/poem66868.html","الوافر"],[63,"تهيبه ورد الردى لو تهيبا","https://www.aldiwan.net/poem51811.html","الطويل"],[99,"صورة للبحر أم صورة نفس","https://www.aldiwan.net/poem24941.html","الرمل"],[46,"أأطلال هند ساء ما اعتضت من هند","https://www.aldiwan.net/poem30544.html","الطويل"],[52,"أصفراء ما في العيش بعدك مرغب","https://www.aldiwan.net/poem64815.html","الطويل"],[7,"تعصي الإله وأنت تظهر حبه","https://www.aldiwan.net/poem1980.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39609","الخفيف"],[61,"تعصى الإله وأنت تُظهر حبه","https://www.poetsgate.com/ViewPoem.aspx?id=20441",""],[228,"لبيك يا قلب ماض فيك ناداني","https://www.aldiwan.net/poem39693.html","البسيط"],[287,"يا هند لا تسخري بي","https://www.aldiwan.net/poem32891.html","المجتث"],[396,"وليس للمرء بعد الموت من شجر","https://www.aldiwan.net/poem54444.html","عموديه"],[409,"لقد سار الإِمام أبو المعالي","https://www.aldiwan.net/poem33478.html","الوافر"],[412,"عصرت مدامعك الأناة المعصر","https://www.aldiwan.net/poem50167.html","الكامل"],[447,"عجبا لراج فوز ناج سابق","https://www.aldiwan.net/poem14317.html","الكامل"],[463,"عِمي صباحا بعدنا واسلمي","https://www.aldiwan.net/poem55887.html","السريع"],[466,"أما اذا سلم الامام الأعظم","https://www.aldiwan.net/poem16018.html","الكامل"],[484,"نبه لحاظك فالصباح قريب","https://www.aldiwan.net/poem36933.html","الكامل"],[556,"ذكرتك في الخلوات التي","https://www.aldiwan.net/poem47803.html","المتقارب"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122618","الوافر"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34427","البسيط"],[1619,"","https://poetry.dctabudhabi.ae/diwan/poem/87943","البسيط"],[1682,"","https://poetry.dctabudhabi.ae/diwan/poem/198769","الوافر"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49558","البسيط"],[2558,"","https://poetry.dctabudhabi.ae/diwan/poem/200322","الرمل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65960","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100221","المتقارب"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100218","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203014","الخفيف"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126279","الكامل"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126280","الكامل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/53024","الوافر"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114198","المجتث"],[4220,"","https://poetry.dctabudhabi.ae/diwan/poem/104423","الطويل"],[4388,"","https://poetry.dctabudhabi.ae/diwan/poem/115315","الطويل"],[4578,"فؤادي بإيجاب الوصال وسلبه","https://www.poetsgate.com/ViewPoem.aspx?id=49353",""],[4955,"أنفاسنا قبل الولادة حُددت","https://www.poetsgate.com/ViewPoem.aspx?id=198265",""],[5092,"عزفٌ على وتر الفراق","https://www.poetsgate.com/ViewPoem.aspx?id=176564",""],[5206,"مناهج الله","https://www.poetsgate.com/ViewPoem.aspx?id=187391",""],[5605,"لهب في اللهب","https://www.poetsgate.com/ViewPoem.aspx?id=160691",""],[5612,"بالبابِ باتَ العائدونْ","https://www.poetsgate.com/ViewPoem.aspx?id=179613",""],[5621,"صهوة","https://www.poetsgate.com/ViewPoem.aspx?id=24565",""],[243,"دجلة الغضبى","https://www.poetsgate.com/ViewPoem.aspx?id=50472",""],[6024,"الزمان","https://www.poetsgate.com/ViewPoem.aspx?id=186355",""],[6142,"هلم نصفق معا كفي مبايعةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155725",""]],"verses":[["تَعصي الإِلَهَ وَأَنتَ تُظهِرُ حُبَّهُ","هَذا مَحالٌ في القِياسِ بَديعُ",0,"ع",1,1],["تَعصي الوُشاةَ وَكانَ الحُبُّ آوِنَةً","مِمّا يُزَيِّنُ لِلمَشغوفِ ما صَنَعا",1,"ع",2,0],["تَعصِمُ الأَجسامَ مِن عادي البِلا","وَتَقي الآثارَ مِن عادي الفَناء",2,"ا",2,0],["تَعَصَّب لِلقَريبِ أَبا وَوُدّاً","فَقَد يَجِبُ التَعَصُّبُ لِلكَنِيِّ",3,"ي",1,0],["تعصَّبتُ في شِعري عليه ولو حوَى","عصائبَ تيجانِ الملوكِ تعصبُّا",4,"ب",2,0],["تعصف الأمواج عصفا بالرجاء","كيف ننسى أن للكون إلها",5,"ه",2,0],["تُعَصفِرُ خَدَّيها العُيونُ بِحُمرَةٍ","إِذا وَرَدَت كانَت وَبالاً عَلى الوَردِ",6,"د",1,0],["تَعَصَّبَ رَوحٌ وَالمَكارِمُ تابِعاً","لِأَشياخِهِ وَالسابِقُ المُتَعَصِّبُ",7,"ب",1,0],["تَعصي الإِلَهَ وَأَنتَ تُظهِرُ حُبَّهُ","هَذا لَعَمرُكَ في المَقالِ بَديعُ",8,"ع",1,1],["تعصر الكرمَ راحتا","هُ لها وهي تبتسمْ",9,"م",1,0],["تعصى الإله وأنت تُظهر حبه","هذا لعمري في الفعال بديعُ",10,"ع",1,1],["تَعصي ضَميرَكَ وَالدُنيا تُناطُ بِهِ","وَحينَ أَعصي ضَلالاً فيكَ تَنهاني",11,"ن",2,0],["تَعَصَّبت بِحَبابٍ","كَاللُؤلُؤِ المَثقوبِ",12,"ب",1,0],["تعصي فيحسن تنساه فيذكرك","تدبر فيقبل بالنعما يواليها",13,"ي",3,0],["تعصبه لأقوام أطالوا","مقالاً في الخصام وفي الجدال",14,"ل",1,0],["تعصي قُلوب ذَوي الهَوى أَربابُها","فيهِ فَكُلٌّ في هَواهُ مُسَخَّرُ",15,"ر",1,0],["تعصى الإله ومظهراً طاعاته","ما هكذا فعل المحب الصادق",16,"ق",1,0],["تعصِمه العفّة والعزُّ أن","تأخذَه لائمةُ اللوَّمِ",17,"م",1,0],["تعْصيك في اصِّنْعو الشقيق سفاهةً","وتُطيعُ أمْرَكَ والقَنا تتَحطَّمُ",18,"م",1,0],["تعص مالكة الجمال فلطفها","يدعو الفؤاد إلى الهوى فيجيب",19,"ب",1,0],["تُعَصفرهُ وَمضاتُ البروقِ","فَتحسبه مِن نجيعٍ عصيرا",20,"ر",2,0],["تُعَصفِرُ كفَّ ساقيها وتَكسُو","شِفاهَ مُقَبِّليها جُلَّنارا",21,"ر",2,0],["تَعصي وَتُظهِر حبّاً بالمحال أَلَم","تَستَحي يا شَيخُ ماذا البَهتُ وَالكذبُ",22,"ب",1,0],["تَعصى حدودَ النُّهى بالشرِّ راضيةً","شقَّت لدينٍ عصا تسعى لبطلانِ",23,"ن",1,0],["تعصّى حصرها نثراً فأنّى","تحيطُ بحصرهن القافياتُ",24,"ت",1,0],["تعصي القنا وهي أدناها إلى كَرَمٍ","أثناءَ مُنْتَصِبٍ منها ومجرور",25,"ر",1,0],["تعصب الطير عليه كلما","حاول النهض تأباه النزف",26,"ف",1,0],["تعصي الإله وترجو الفوز منه غداً","تشكلك أمك من يرمي بلا وتر",27,"ر",1,0],["تعصب يقرع تاج العلى","على مفرق الملك العاصب",28,"ب",1,0],["تعصب أو يمري القلوب مصمما","ومازال حتى استفرغ الضرع عصابه",29,"ب",2,0],["تعصر الريح كي تصيب رواء","وتبل الظما بلفح الهجير",30,"ر",1,0],["تعصى الاله وأنت تاكل رزقه","هذا لعمرى الحمق مه يا ذاكا",31,"ك",2,0],["تعصى الاله ولم تحفه وكم وكم","أولاك من نعماه ما أولاكا",32,"ك",2,0],["تعصبهم لنا لم يُجدِ شَيّا","عليكم بالسلاح أيا أهالي",33,"ي",1,0],["تَعصِيهِ جَهراً وَسِرّا","وَلَيسَ يَقطَعُ بِرَّا",34,"ر",2,0],["تعصيت لا عن زينة وتأنق","ولا عن قوى الأعضاء فيها تقاصر",35,"ر",1,1],["تَعَصَّبَ تاجَ الملكِ في عُنفُوانهِ","وأطت به عَصرَ الشبابِ المنابرُ",36,"ر",1,0],["تعصب رمح القد منه بلحظه","لقتلي وقد أضنى فؤادي بحجبه",37,"ب",2,0],["تعصي الإلهَ مجاهرا أو في الخفا","وعلى الذُّنوبِ يُكرَّسُ الإنفاقُ",38,"ق",1,0],["تعصرني مرارًا أمنيتي","وكأنيَ فيها أُحْتَضَرُ",39,"ر",1,0],["تَعصِي مُصَوِّرَكَ الحَكِيمَ وَرِزْقُهُ","مِنْ غَيرِ مَنٍّ مِنهُ قَطعًا آكِلُ؟",40,"ل",1,0],["تعصرنت الشعوب ونحن شعب","يعصرن نحو تقبيل النعال",41,"ل",1,0],["تعْصيه يا لكَ من غريرٍ جاحِدٍ","وأمامَ عيْنِكَ نورُهُ يتلالا!!",42,"ل",2,0],["تعصِفُ بي ثَوْرَتانِ من ألَمٍ","طاغٍ ومنْ حَيْرَةٍ ومنْ رَهَقِ",43,"ق",1,0],["تعصف الصيحة المدماة بالتاج","على كل مفرق مستطار",44,"ر",1,0],["تعصي الإله وأنت تأكل فضله","سبحانه لعباده رحمان",45,"ن",1,0],["تعصبت وأبت عن أن تمد يدا","لبيعة وعلى غير راضيها",46,"ي",3,0]]}