{"poems":[[47,"بأي أسى تثنى الدموع الهوامل","https://www.aldiwan.net/poem65575.html","الطويل"],[68,"لا راجع الطرف باللقا وسنه","https://www.aldiwan.net/poem40971.html","المنسرح"],[108,"تحية وقضية","https://www.poetsgate.com/ViewPoem.aspx?id=179292",""],[111,"الله أكبر رزء نكس العلما","https://www.poetsgate.com/ViewPoem.aspx?id=525",""],[92,"ذكرى دمشق الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=179048",""],[406,"بين الريح والإعصار","https://www.aldiwan.net/poem10311.html","عموديه"],[445,"لك البشرى ودمت قرير عين","https://www.aldiwan.net/poem34819.html","الوافر"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/77452","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62508","البسيط"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107198","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50024","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89541","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204580","المجتث"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129360","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216573","البسيط"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85230","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114370","الطويل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127072","المتقارب"],[3294,"خان الوفاء وإن أجرى الدموع دما","https://www.poetsgate.com/ViewPoem.aspx?id=173278",""],[6031,"أَمَوْلَى الوَرَى إنِّي جَعلْتُكَ في الذِي","https://www.poetsgate.com/ViewPoem.aspx?id=46412",""]],"verses":[["هُما شَرَعٌ في المَكرُماتِ فَهَذِهِ","أَواخِرُ أَخلاقٍ وَتِلكَ أَوائِلُ",0,"ل",1,0],["هُمُ اِشتَروا المُلكَ غالِباً خَطَراً","وَصَيَّروا أَنفُسَ العِدى ثَمَنَه",1,"ن",2,0],["هُمْ أشعلوا في المسجد الأقصَى اللَّظَى","فَلْيَحْتَرِقْ بشُوَاظِها مَنْ أشعلوا",2,"ل",3,0],["هما شبيهان في رزء وفي جلل","وفي موازنة الأقدار بينهما",3,"م",2,0],["هما شيئان ما اجتمعا لشعبٍ","فاما الملكُ فيهِ أو الشقاق",4,"ق",1,0],["همْ أشعلوا نارهم ، منْ أشعلَ النارا؟","من الذي ملأ الساحاتِ ثوّارا",5,"ر",2,1],["هما شمسا مفارِقِ كلِّ فخْرٍ","فَخَلِّ سَناهُما والمَغْرِبَيْنِ",6,"ن",1,0],["هُم أَشفارُ عَين الملك تَذري","عَن الملك القَتام أَو التُرابا",7,"ب",2,0],["هما شقيقان شقا في طريقهما","نحو المعالي فحازا غاية الأمدِ",8,"د",1,0],["هُمُ أَشهَدُونا مِن بَديعِ جَمالِهِم","شُمُوسَ كمالٍ مُذ فَهمنَا بِهَا هِمنَا",9,"ن",2,0],["هما شاطئا بحر السّماح كلاهُما","يجيش بآذيِّ البُحور القماقمِ",10,"م",1,0],["هُم أَشادوا لِلهُدى أَعلامَهُ","وَعَلا مِنهُم بهِ في الأَرضِ صَرحُ",11,"ح",1,0],["هما شريكاي عند ال","ضراء لا السراء",12,"ا",2,0],["هما شرعا من لجة العلم مورداً","جداوله للناس أحلا من الشهد",13,"د",1,0],["هما شقيقان فارفق أن تحيلهما","ضدين بينهما نأيٌ وهجران",14,"ن",1,0],["هُما شاهَدا عَدلٍ وَلَكِن كِلاهُما","لَدى الحُكمِ قاضٍ عادِلٍ في قَضائِهِ",15,"ا",3,0],["هما شاهدا صدقٍ على النكتِ التي","تحلُّ بقلبِ السالكين وترسَمُ",16,"م",1,0],["هما شمعتا زين أهل النوادي","هما اصبعا يد نيل الأيادي",17,"ي",1,0],["هم اشرف الناس قدرا بل وأوفرهم","فخرا وأكثرهم علما هدى كرما",18,"م",2,0],["هُمُ أشْرعُونِي بَابَ كُلِّ رَغِيبَةٍ","وكَفُّوا الأذَى عن أَنْ يَمُرَّ بِبَابِيَا",19,"ي",2,0]]}