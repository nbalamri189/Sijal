{"poems":[[95,"سلام باك أسيف","https://www.aldiwan.net/poem11362.html","المجتث"],[90,"أصبحت أوسعهم لوما وتثريبا","https://www.aldiwan.net/poem44832.html","البسيط"],[93,"لمني إذا حلت عن عهودي","https://www.aldiwan.net/poem62733.html","عموديه"],[87,"غزالة مرت على أتان","https://www.aldiwan.net/poem8007.html","الرجز"],[64,"لاحظته والبدر ليلة تمه","https://www.aldiwan.net/poem52405.html","الكامل"],[30,"ولما رأيت النفس صار نجيها","https://www.aldiwan.net/poem5277.html","الطويل"],[63,"لقد سودت عرس ابن حمزة وجهه","https://www.aldiwan.net/poem51480.html","الطويل"],[46,"قد صنف الحسن في خديك جوهره","https://www.aldiwan.net/poem30244.html","البسيط"],[71,"برغمي أن بيتكم يضام","https://www.aldiwan.net/poem29243.html","الوافر"],[83,"لله نهر ما رأيت جماله","https://www.aldiwan.net/poem61505.html","الكامل"],[77,"حلفت بالسابغات البيض واليلب","https://www.aldiwan.net/poem69102.html","البسيط"],[50,"نكنا رسول عنان","https://www.aldiwan.net/poem66220.html","المجتث"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54641","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54218","البسيط"],[124,"قضى غير مأسوف عليك من الورى","https://www.aldiwan.net/poem49272.html","الطويل"],[159,"يا واحد الحسن الذي لجماله","https://www.aldiwan.net/poem55669.html","الكامل"],[226,"نما على أرضها الشجر","https://www.aldiwan.net/poem55288.html","مخلع البسيط"],[240,"أياعضد الدين شكوى فتى","https://www.aldiwan.net/poem32171.html","المتقارب"],[264,"باسمك يا الله ربي ابتدي","https://www.aldiwan.net/poem35938.html","الرجز"],[275,"أصلا برزت لنا بلا ميعاد","https://www.aldiwan.net/poem35449.html","الكامل"],[333,"رأيتها تمشي وفي كفها","https://www.aldiwan.net/poem54920.html","السريع"],[347,"أنا أهواك يا ليلى","https://www.aldiwan.net/poem55339.html","الهزج"],[369,"خفض عليك وإن أطلت تأملا","https://www.aldiwan.net/poem60805.html","الكامل"],[369,"هو ما علمت فأقصري أو فاعذلي","https://www.aldiwan.net/poem60809.html","الكامل"],[374,"عمارة في الإسلام أبدى خيانة","https://www.aldiwan.net/poem4322.html","الطويل"],[376,"شهد البكاء وما أتيت بشاهد","https://www.aldiwan.net/poem57494.html","الكامل"],[422,"خذ بالمسرة واغنم لذة الطرب","https://www.aldiwan.net/poem54116.html","البسيط"],[463,"نقيل مع الدنيا وقد أورقت لنا","https://www.aldiwan.net/poem55852.html","الطويل"],[564,"أرى طالبا منا الزيادة لا الحسنى","https://www.aldiwan.net/poem69340.html","الطويل"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53854","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48790","المتقارب"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48542","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64125","الكامل"],[849,"","https://poetry.dctabudhabi.ae/diwan/poem/105613","الطويل"],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/69200","الطويل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46510","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49935","الكامل"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133870","المنسرح"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108579","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108578","الكامل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110335","الكامل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104956","الطويل"],[2436,"","https://poetry.dctabudhabi.ae/diwan/poem/17736","الكامل"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99083","البسيط"],[2527,"","https://poetry.dctabudhabi.ae/diwan/poem/17699","الكامل"],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84925","الطويل"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93458","الكامل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65951","الطويل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58286","المنسرح"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103407","الطويل"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26117","البسيط"],[3427,"","https://poetry.dctabudhabi.ae/diwan/poem/205332","الكامل"],[3452,"","https://poetry.dctabudhabi.ae/diwan/poem/28854","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92378","البسيط"],[3763,"","https://poetry.dctabudhabi.ae/diwan/poem/124154","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133256","البسيط"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54474","الطويل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81928","الكامل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76752","الكامل"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67526","الوافر"],[4697,"ليش تزعل","https://www.poetsgate.com/ViewPoem.aspx?id=22690",""],[4701,"الحسين","https://www.poetsgate.com/ViewPoem.aspx?id=176660",""],[4755,"رَأَيتُ صَيَّادًا يُعيدُ صَيدَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=198373",""],[4755,"مأساة سُهَيل اليَمَاني ( 1 )","https://www.poetsgate.com/ViewPoem.aspx?id=209084",""],[5102,"خيرا وسلاما","https://www.poetsgate.com/ViewPoem.aspx?id=17647",""],[5415,"لك الحمد","https://www.poetsgate.com/ViewPoem.aspx?id=212226",""],[5464,"بهمومنا لا بالخمور سكارى","https://www.poetsgate.com/ViewPoem.aspx?id=697",""],[5651,"وكأنّ خيطَ عِذارهِ لما بدا","https://www.poetsgate.com/ViewPoem.aspx?id=106999",""],[5702,"مرثية حنان","https://www.poetsgate.com/ViewPoem.aspx?id=116712",""],[5848,"قبل الحفلة","https://www.poetsgate.com/ViewPoem.aspx?id=49005",""]],"verses":[["وَكَانَ خَيْرَ مِثَالٍ","لِكُلِّ حُرٍّ كَرِيمِ",0,"م",1,0],["وكان خوفهم حقاً لو أنهم","لم يعدِلوا عن طريق الحق تنكيبا",1,"ب",2,0],["وَكانَ خَوفي مِنَ التَنائي","خَوفَ كَفيفٍ مِنَ التُرامِ",2,"م",1,0],["وَكانَ خَلفَ الظَبيَةِ اِبنُها الرَشا","بِوُدِّها لَو حَمَلتهُ في الحَشا",3,"ش",2,0],["وكأنَّ خَطَّ عِذارِه في خدِّهِ","سَطْرَا ظلامٍ في صحيفةِ نُورِ",4,"ر",1,0],["وَكانَ خَليلي قَبلَ سُلطانِ ما رَمى","إِلَيهِ فَما أَدري بِأَيِّ صَنيعِ",5,"ع",1,0],["وَكانَ خَديجٌ وَالنَجاشِيُّ مِنهُمُ","ذَوَي طَعمَةٍ في المَجدِ ذاتِ دَسيعِ",5,"ع",1,0],["وكان خبيثاً قبلَ ذاكَ مُخاتِلاً","فأَنسَتْهُ أفعالَ الخَبيثِ المُخاتِلِ",6,"ل",1,0],["وَكانَ خَدُّكَ دَهراً مُشرِقاً يَقَقاً","فَمُذ تَمَكَّنَ فيهِ اللَحظُ عَصفَرَهُ",7,"ر",2,0],["وكان خليفةً في كلِّ علمٍ","وعيناً للخليفة لا تنامُ",8,"م",1,0],["وَكَأَنَّ خُضرَ ثِمارِهِ وَبَياضَهُ","ثَغرٌ تَنَسَّمَ تَحتَ خَدِّ مُعَذِّرِ",9,"ر",1,0],["وكان خيساً لآسادِ العرين وقد","غادرتَه كوِجار الثعلبِ الخَرِب",10,"ب",1,0],["وكان خبزاً بملح","قبل الشواءِ أكلنا",11,"ن",2,0],["وَكَانَ خَيْرَ اتِّحَادٍ مَا جَمَعْتِ بِهِ","مِنْ نَابِهَاتِ الغَوَانِي نُخْبَةَ النُّجَبِ",12,"ب",1,0],["وكان خصماً شريفَ الصدرِ مرتفعاً","عن الدنيّاتِ إنْ عادَى وإنْ عودي",13,"د",2,0],["وكان خبيث النفس كالناس كلهم","جباناً قليل الخير جم الحقائد",14,"د",1,0],["وكَأَنَّ خَطَّ عِذارِهِ في خَدِّهِ","لَيْلٌ تَأَلَّقَ في بَياضِ نهارِ",15,"ر",1,0],["وكان خينومها إله","بكل أبنائه أبر",16,"ر",1,0],["وَكانَ خَطيبَ مَعاليكُمُ","فَأَسكَتَ شِقشِقَةِ الخاطِبِ",17,"ب",1,0],["وكان ختم المبتدا البدايهْ","وأولاً ومنتهى النهايهْ",18,"ه",1,0],["وكأنَّ خيلَ أبي عبيدةَ أقبلت","فيها لِفَتحِ قريحتي وفؤادي",19,"د",2,0],["وكان خوفى سوء إغضاءها","أشدّ من خوفى ظنون الأنام",20,"م",1,0],["وكان خفوق قلبينا","كخفقات الافانين",21,"ن",1,0],["وكأنّ خَيْطَيْ لَيله ونهارِه","قد قُطِّعَا مزَقاً عليه ووُصِّلا",22,"ل",2,0],["وكأنّ خَطْفَ يَمينه وشِماله","مَسْرَى جَنوبِ بالفلاةِ وشَمْأل",23,"ل",1,0],["وكان خبيث الملتقى إن عجمته","تجد منه عوداً في النفاق صليبا",24,"ب",2,0],["وكأن خمسَ أناملٍ في كفِّه","يوم الندى والجود خمس موائِد",25,"د",1,0],["وكان خيراً لهم لو أنهم رجعوا","عن غيّهم بعد ذاك الجهد والنصب",26,"ب",1,0],["وكان خبالا في رزيَّة مثلِه","ولُؤماً بدمع أن يصانَ ويُخزَنا",27,"ن",2,0],["وكان خطيبَا بين ذاتين مَن يكُن","فقيراً يَرَ البحر الذي فيه قد غُصْنا",28,"ن",2,0],["وكان خيراً له لو كان مؤتزرا","في السالفات على غُرمُول عنِّينِ",29,"ن",1,0],["وكان خليقاً بترك المجا","لِ وهو شقي به لو عقل",30,"ل",1,0],["وكان خطيب القوم عمَّ عدوِّه","فعز عليه أن يضيع له قدر",31,"ر",1,0],["وكأنَّ خُرَّمَهُ البديعُ وقد بدا","روسُ الطواوسِ إذ تديرُ رقابَها",32,"ه",2,0],["وكان خليقاً بالوجاهة عنده","مكينا لديه بالوسيلة في أمري",33,"ر",2,0],["وَكانَ خَريم مِن أَبيهِ خَليفة","إِذا ما دَها يَوما مِن الشَرِّ أَشنَع",34,"ع",1,0],["وَكانَ خَيراً لَكَ في الدارين","مِما تَرى في مَوتتي وَحيني",35,"ي",1,0],["وكأنَ خَوط البان حشُو مُروطها","تَهْتَزُّ بينَ مُخَلْخَلٍ ومُدَمْلَجِ",36,"ج",1,0],["وكان خشف قد باسها بفم","وهي من البوس بعد شبعانه",37,"ن",2,0],["وكأن خالك تحت لحظك خادم","وافى ليحمل للأمير سلاحا",38,"ح",2,0],["وكأن خنصره لرقة خصره","ألقى بخاتمه فصار وشاحا",39,"ح",2,0],["وكأن خالقها برا","ها طبق ما هو مبتغاك",40,"ك",1,0],["وكان خلاف اللطف واللطف واجب","إذا من نبيٍّ أو وصيٍّ خلا عصر",41,"ر",1,0],["وَكَأَنَّ خَلفَ حِجاجِها مِن رَأسِها","وَأَمامَ مَجمَعِ أَخدَعَيها قَهقَرُ",42,"ر",1,0],["وكان خلقي لهم رضياً","أصفعهم ثم يصفعوني",43,"ن",2,0],["وَكَأَن خِلفَتَها عَطيفَةُ شَوحَطٍ","عَطلٍ بَراها مِن خُزاعَةَ باري",44,"ر",2,0],["وَكانَ خَبيراً بِالسِياسة عالِماً","وَيَحكُم أَحكاماً بِغَير تَقول",45,"ل",1,0],["وَكَأَنَّ خَجلَتَهُ إِذا ما فارقت","وَجَناتِهِ عادَت إِلى خَدَّيهِ",46,"ي",2,0],["وكان خدوماً للضيوف مخدّماً","أبا مشفقاً لما تشأ في التجوّد",47,"د",1,0],["وكانَ خَوراً تَلْهو النفوسُ به","وزيدَ ماءً فَصارَ ماخورا",48,"ر",2,0],["وكان خليلُ اللَه أكرمَ من عَنَت","له الأرض من ماشٍ عليها وراكب",49,"ب",1,0],["وَكانَ خَزُّ جَريرٍ كُلَّ مُمتَزِقٍ","مِن صوفِ ماهرَّأت مِن ضَأنِها القِرَرُ",50,"ر",1,0],["وكأنَّ خطَّ الشعرِ في جنباتهِ","ليلٌ أقامَ على نُجومِ نهارِ",51,"ر",1,0],["وَكانَ خَيرُ الخَصلَتَينِ الشرّا","أَكونُ ثَمَّ أَسَداً زِبِرّا",52,"ر",2,0],["وكان خال فصار الوَجد يشغلُهُ","لا تسألي ما جرى فالدَمعُ سائلُهُ",53,"ه",1,0],["وكأن خط عذاره في خده","سيح أذيب على صفيحة عسجد",54,"د",1,0],["وكان خير الورى في الجاش أثبتهم","إذ ما على غيره في الأمر تعويل",55,"ل",1,0],["وَكَانَ خَلقُهُمُ لِدَارِ المَأوَى","أَصلَحُ مِن تَعرِيضِهِم للأوَى",56,"ا",3,0],["وكان خلِّي القلبِ من لوعةِ الهوى","فأَصبحَ من بَرْحِ الصّبابةِ في شغلِ",57,"ل",1,0],["وكأنَّ خطَّ عذاره في خده","شمس تجلَّت في سناه غياهب",58,"ب",1,0],["وكأن خاطفة البروق قد التظت","صفحات سيفك قد علاهَن الدمُ",59,"م",1,0],["وكان خيالها يشفي سقاماً","فضنت بالخيال على الخيالِ",60,"ل",1,1],["وكان خنت العهد فالحكم معروفي","الخيانة بالعهود أكبر جناية",61,"ا",3,0],["وكأن خيل الله لم تركض بهم","والسامرين بمكة لم يسمروا",62,"ر",3,0],["وكان خلفَ النارِ أَلفُ نَهرٍ","يقولُ لي: لن تَشرَبَ الحُدَيدة",63,"د",2,0],["وكان خَيرَ بَشِيرٍ.. حِين نَسأَلُهُ:","\"يا حارِسَ البُنِّ.. بُشرَى\".. قال: بُشرانا",64,"ن",2,0],["وكأنّ خَيلَكَ لم تبِتْ برباطِها","إن الرباطَ صهيلُهُ معلومُ",65,"م",1,0],["وَكَانَ خِيَارُ مَنْ سَبَقُوا حَيَارَى","مَخَافَةَ أَنْ يَسُوؤَهُمُ الْمَصِيرُ",66,"ر",1,0],["وكأن «خيبر» لم يقوّض بابها","يوماً «عليٌّ» حين كرّ وثارا",67,"ر",2,0],["وكأنّ خيطَ عِذارهِ لما بدا","خيطٌ من الظّلماء فوقَ صباحِ",68,"ح",1,1],["وكانَ خدك في كَفي يُباعِدُنِي","إذْ ذاكَ مرّ بِقُرْبي الموت والأجلُ",69,"ل",1,0],["وكان خصرك مال طير( المذهلة ) رفرف له","رقصتك لازم تكون ببسمتك ممهورة",70,"ر",2,0]]}