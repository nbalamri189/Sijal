{"poems":[[93,"سلام باك أسيف","https://www.aldiwan.net/poem11362.html","المجتث"],[88,"أصبحت أوسعهم لوما وتثريبا","https://www.aldiwan.net/poem44832.html","البسيط"],[91,"لمني إذا حلت عن عهودي","https://www.aldiwan.net/poem62733.html","عموديه"],[85,"غزالة مرت على أتان","https://www.aldiwan.net/poem8007.html","الرجز"],[62,"لاحظته والبدر ليلة تمه","https://www.aldiwan.net/poem52405.html","الكامل"],[28,"ولما رأيت النفس صار نجيها","https://www.aldiwan.net/poem5277.html","الطويل"],[61,"لقد سودت عرس ابن حمزة وجهه","https://www.aldiwan.net/poem51480.html","الطويل"],[44,"قد صنف الحسن في خديك جوهره","https://www.aldiwan.net/poem30244.html","البسيط"],[69,"برغمي أن بيتكم يضام","https://www.aldiwan.net/poem29243.html","الوافر"],[81,"لله نهر ما رأيت جماله","https://www.aldiwan.net/poem61505.html","الكامل"],[75,"حلفت بالسابغات البيض واليلب","https://www.aldiwan.net/poem69102.html","البسيط"],[48,"نكنا رسول عنان","https://www.aldiwan.net/poem66220.html","المجتث"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54641","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54218","البسيط"],[121,"قضى غير مأسوف عليك من الورى","https://www.aldiwan.net/poem49272.html","الطويل"],[156,"يا واحد الحسن الذي لجماله","https://www.aldiwan.net/poem55669.html","الكامل"],[222,"نما على أرضها الشجر","https://www.aldiwan.net/poem55288.html","مخلع البسيط"],[236,"أياعضد الدين شكوى فتى","https://www.aldiwan.net/poem32171.html","المتقارب"],[260,"باسمك يا الله ربي ابتدي","https://www.aldiwan.net/poem35938.html","الرجز"],[271,"أصلا برزت لنا بلا ميعاد","https://www.aldiwan.net/poem35449.html","الكامل"],[329,"رأيتها تمشي وفي كفها","https://www.aldiwan.net/poem54920.html","السريع"],[343,"أنا أهواك يا ليلى","https://www.aldiwan.net/poem55339.html","الهزج"],[365,"خفض عليك وإن أطلت تأملا","https://www.aldiwan.net/poem60805.html","الكامل"],[365,"هو ما علمت فأقصري أو فاعذلي","https://www.aldiwan.net/poem60809.html","الكامل"],[370,"عمارة في الإسلام أبدى خيانة","https://www.aldiwan.net/poem4322.html","الطويل"],[372,"شهد البكاء وما أتيت بشاهد","https://www.aldiwan.net/poem57494.html","الكامل"],[417,"خذ بالمسرة واغنم لذة الطرب","https://www.aldiwan.net/poem54116.html","البسيط"],[459,"نقيل مع الدنيا وقد أورقت لنا","https://www.aldiwan.net/poem55852.html","الطويل"],[560,"أرى طالبا منا الزيادة لا الحسنى","https://www.aldiwan.net/poem69340.html","الطويل"]],"verses":[["وَكَانَ خَيْرَ مِثَالٍ","لِكُلِّ حُرٍّ كَرِيمِ",0,"م",1,0],["وكان خوفهم حقاً لو أنهم","لم يعدِلوا عن طريق الحق تنكيبا",1,"ب",2,0],["وَكانَ خَوفي مِنَ التَنائي","خَوفَ كَفيفٍ مِنَ التُرامِ",2,"م",1,0],["وَكانَ خَلفَ الظَبيَةِ اِبنُها الرَشا","بِوُدِّها لَو حَمَلتهُ في الحَشا",3,"ش",2,0],["وكأنَّ خَطَّ عِذارِه في خدِّهِ","سَطْرَا ظلامٍ في صحيفةِ نُورِ",4,"ر",1,0],["وَكانَ خَليلي قَبلَ سُلطانِ ما رَمى","إِلَيهِ فَما أَدري بِأَيِّ صَنيعِ",5,"ع",1,0],["وَكانَ خَديجٌ وَالنَجاشِيُّ مِنهُمُ","ذَوَي طَعمَةٍ في المَجدِ ذاتِ دَسيعِ",5,"ع",1,0],["وكان خبيثاً قبلَ ذاكَ مُخاتِلاً","فأَنسَتْهُ أفعالَ الخَبيثِ المُخاتِلِ",6,"ل",1,0],["وَكانَ خَدُّكَ دَهراً مُشرِقاً يَقَقاً","فَمُذ تَمَكَّنَ فيهِ اللَحظُ عَصفَرَهُ",7,"ر",2,0],["وكان خليفةً في كلِّ علمٍ","وعيناً للخليفة لا تنامُ",8,"م",1,0],["وَكَأَنَّ خُضرَ ثِمارِهِ وَبَياضَهُ","ثَغرٌ تَنَسَّمَ تَحتَ خَدِّ مُعَذِّرِ",9,"ر",1,0],["وكان خيساً لآسادِ العرين وقد","غادرتَه كوِجار الثعلبِ الخَرِب",10,"ب",1,0],["وكان خبزاً بملح","قبل الشواءِ أكلنا",11,"ن",2,0],["وَكَانَ خَيْرَ اتِّحَادٍ مَا جَمَعْتِ بِهِ","مِنْ نَابِهَاتِ الغَوَانِي نُخْبَةَ النُّجَبِ",12,"ب",1,0],["وكان خصماً شريفَ الصدرِ مرتفعاً","عن الدنيّاتِ إنْ عادَى وإنْ عودي",13,"د",2,0],["وكان خبيث النفس كالناس كلهم","جباناً قليل الخير جم الحقائد",14,"د",1,0],["وكَأَنَّ خَطَّ عِذارِهِ في خَدِّهِ","لَيْلٌ تَأَلَّقَ في بَياضِ نهارِ",15,"ر",1,0],["وكان خينومها إله","بكل أبنائه أبر",16,"ر",1,0],["وَكانَ خَطيبَ مَعاليكُمُ","فَأَسكَتَ شِقشِقَةِ الخاطِبِ",17,"ب",1,0],["وكان ختم المبتدا البدايهْ","وأولاً ومنتهى النهايهْ",18,"ه",1,0],["وكأنَّ خيلَ أبي عبيدةَ أقبلت","فيها لِفَتحِ قريحتي وفؤادي",19,"د",2,0],["وكان خوفى سوء إغضاءها","أشدّ من خوفى ظنون الأنام",20,"م",1,0],["وكان خفوق قلبينا","كخفقات الافانين",21,"ن",1,0],["وكأنّ خَيْطَيْ لَيله ونهارِه","قد قُطِّعَا مزَقاً عليه ووُصِّلا",22,"ل",2,0],["وكأنّ خَطْفَ يَمينه وشِماله","مَسْرَى جَنوبِ بالفلاةِ وشَمْأل",23,"ل",1,0],["وكان خبيث الملتقى إن عجمته","تجد منه عوداً في النفاق صليبا",24,"ب",2,0],["وكأن خمسَ أناملٍ في كفِّه","يوم الندى والجود خمس موائِد",25,"د",1,0],["وكان خيراً لهم لو أنهم رجعوا","عن غيّهم بعد ذاك الجهد والنصب",26,"ب",1,0],["وكان خبالا في رزيَّة مثلِه","ولُؤماً بدمع أن يصانَ ويُخزَنا",27,"ن",2,0],["وكان خطيبَا بين ذاتين مَن يكُن","فقيراً يَرَ البحر الذي فيه قد غُصْنا",28,"ن",2,0]]}