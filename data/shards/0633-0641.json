m51733.html","الخفيف"],[61,"من لي برد سوالف الأحقاب","https://www.aldiwan.net/poem51783.html","الكامل"],[61,"تهيبه ورد الردى لو تهيبا","https://www.aldiwan.net/poem51811.html","الطويل"],[61,"أمن العيون تروم فقد عنائه","https://www.aldiwan.net/poem51836.html","الكامل"],[49,"لايذهبن بك الأمل","https://www.aldiwan.net/poem63077.html","مجزوء الكامل"],[66,"سفح المزاج على حميا الكاس","https://www.aldiwan.net/poem38490.html","الكامل"],[66,"سفها إذا شقت عليك جيوب","https://www.aldiwan.net/poem40296.html","الكامل"],[66,"جلت الظلماء بللهب","https://www.aldiwan.net/poem40672.html","المديد"],[66,"أسلبن من فوق النهود ذوائبا","https://www.aldiwan.net/poem41382.html","الكامل"],[97,"صورة للبحر أم صورة نفس","https://www.aldiwan.net/poem24941.html","الرمل"],[97,"هي صفحة طويت وحان ختام","https://www.aldiwan.net/poem24984.html","الكامل"],[80,"أرأيت لنا ولهم ظعنا","https://www.aldiwan.net/poem31261.html","المتدارك"],[80,"بكرت تغازله الدمى الأبكار","https://www.aldiwan.net/poem31431.html","الكامل"],[44,"أسقى طلولهم أجش هزيم","https://www.aldiwan.net/poem30341.html","الكامل"],[44,"أرامة كنت مألف كل ريم","https://www.aldiwan.net/poem30367.html","الوافر"],[44,"دمن ألم بها فقال سلام","https://www.aldiwan.net/poem30368.html","الكامل"],[74,"ومغرد هزج الغناء مطرب","https://www.aldiwan.net/poem12932.html","الكامل"],[105,"يا سوء ما حمل البريد ويا لها","https://www.aldiwan.net/poem43092.html","الكامل"],[105,"حل الوفاء الحق عقد ذمامه","https://www.aldiwan.net/poem43101.html","الكامل"],[105,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[105,"سرية أنت وحدك","https://www.aldiwan.net/poem43585.html","المجتث"],[81,"عندي يد غراء أهدتها السرى","https://www.aldiwan.net/poem61419.html","الكامل"],[81,"انهض بأمرك فالهدى مقصود","https://www.aldiwan.net/poem61540.html","الكامل"],[102,"أسعديني بزورة أو عديني","https://www.aldiwan.net/poem33118.html","الخفيف"],[52,"دعوا مغرما بالطرب","https://www.aldiwan.net/poem27250.html","مجزوء المتقارب"],[75,"صدق الفناء وكذب العمر","https://www.aldiwan.net/poem69076.html","أحذ الكامل"],[75,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[50,"خليلي غضا ساعة وارحلا بردا","https://www.aldiwan.net/poem63877.html","الطويل"],[50,"أشاقك مغنى منزل متأبد","https://www.aldiwan.net/poem63906.html","الطويل"],[46,"أروى دم قلبا وتلك سفاهة","https://www.aldiwan.net/poem22490.html","الكامل"],[46,"سفكت دم الدنان وما تشكت","https://www.aldiwan.net/poem23074.html","الوافر"],[46,"إن كان من فعل الكبائر مجبرا","https://www.aldiwan.net/poem23144.html","الكامل"],[46,"ألاح وقد رأى برقا مليحا","https://www.aldiwan.net/poem23637.html","الوافر"],[46,"أفوق البدر يوضع لي مهاد","https://www.aldiwan.net/poem23638.html","الوافر"],[76,"أرقت وقلبي عنك ليس يفيق","https://www.aldiwan.net/poem39255.html","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85596","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42707","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54955","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55069","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54890","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54870","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54269","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54302","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54227","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54219","الكامل"],[106,"شبح الحرب","https://www.poetsgate.com/ViewPoem.aspx?id=179421",""],[106,"انتصار الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179290",""],[77,"الحمد لله كم لله من وجود","https://www.poetsgate.com/ViewPoem.aspx?id=33883",""],[90,"عبادة الشر","https://www.poetsgate.com/ViewPoem.aspx?id=179136",""],[91,"معركة شمولبو","https://www.poetsgate.com/ViewPoem.aspx?id=53085",""],[46,"أروى دمٌ قلباً، وتلكَ سفاهةٌº","https://www.poetsgate.com/ViewPoem.aspx?id=20037",""]],"verses":[["سَفينَةُ الأملِ المَمْدودِ قد سبَحَتْ","في جودِهِ واسْتَوَتْ منْهُ على الجودي",0,"د",2,0],["سَفائِنُ تَخْرِقُ بحْرَ الفَلا","وتَلْحَقُ نحْوَكَ بِيداً فَبيدْ",1,"د",1,0],["سُفِحَتْ فيهِ للدّموعُ دماءٌ","فهْيَ فوقَ الخُدودِ ذاتُ انْسِياحِ",2,"ح",1,0],["سَفائِنُ تَسْتَفّ الفَلا فكأنّها","سَفائِنُ في بَحْرِ السّرابِ سَوابِحُ",3,"ح",1,0],["سَفَهاً وَما تَدري سُمَيَّةُ وَيحَها","أَن رُبَّ غانِيَةٍ صَرَمتُ وِصالَها",4,"ل",3,0],["سَفى فَوقَهُنَّ التُربَ ضافٍ كَأَنَّهُ","عَلى الفَرجِ وَالحاذينِ قِنوٌ مُذَلَّلُ",5,"ل",1,0],["سَفَرَت تُوَدِّعُ أُمَّةً مَحمولَةً","في النَعشِ لا خَبَراً مِنَ الأَخبارِ",6,"ر",1,0],["سُفِكَت مَوَدَّتُنا لَكُم وَبَدا لَنا","أَنَّ الحِيادَ عَلى الخِصامِ لِثامُ",7,"م",1,0],["سَفَّهتَ آراءَهُم فيها فما لَبِثوا","أن أوسَعُوكَ على ماجِئتَ تَسفيها",8,"ي",3,0],["سَفَهاً بِحلمي إِن تَرَكتُ أَتِ","يَّ السَيلِ وَاِستَغنَيتُ بِالوَشَلِ",9,"ل",1,0],["سُفعُ الخُدودِ كَأَنَّهُنَّ وَقَد مَضَت","حِجَجٌ عَوائِدُ بَينَهُنَّ سَقيمُ",10,"م",1,0],["سُفُوحُها حُرَّةٌ وَالهَامُ مُطْلَقَةٌ","وَكُلُّ عَانٍ بِهَا بَعْدَ الأَسَى هَانِي",11,"ن",2,0],["سفوح جبال بعضها فوق بعضها","مكلّلة حافاتهنّ باشجار",12,"ر",1,0],["سفينة أسكنها ماءٌ جَمَد","حتى لقد يئست من فتح السُدَد",13,"د",1,0],["سفينة ملكهم فيها خُروق","وهم لا يُحسِنون لها القِلافه",14,"ف",2,0],["سفر أقام على السفور أدلّةً","تركت ذبابكم بغير طنين",15,"ن",1,0],["سَفِهَ الأُخَيطِلُ إِذ يَقي بِعَجوزِهِ","كيرَ القُيونِ كَأَنَّهُ مِنديلُ",16,"ل",1,0],["سَفهاً وَلَو أَنّي أَطَعتُ عَواذِلي","فيما يُشِرنَ بِهِ بِسَفحِ المِذنَبِ",17,"ب",1,0],["سَفَهاً عَذَلتِ وَقُلتِ غَيرَ مُليمٍ","وَبُكاكِ قِدماً غَيرُ جِدِّ حَكيمِ",18,"م",1,1],["سفع الخدود كأنما","نثرت عليهن المكاحلْ",19,"ل",1,0],["سِفاحاً جِهاراً مِن أُحَيمَقِ مِنهُمُ","فَقَد سَبَقَتهُم في جَميعِ المَشاهِدِ",20,"د",1,0],["سفينة ليس تجري بي لذي بخل","إنَّ السفينة لا تجري على اليبس",21,"س",1,0],["سفكْت به كفُّ الطبيب صُبابةً","كم دونها من وِردِ موتٍ أحمر",22,"ر",1,0],["سفينةٌ من سفين البر محكمةٌ","تجري إذا ما اتخذت السوط مجدافا",23,"ف",2,0],["سفهتُ على عمروٍ سفاهةَ جاهلٍ","وأبصرتُ ما في الحلمِ إبصارَ عالمِ",24,"م",1,1],["سفكتَ دمَ الحياء فلا تُتابعْ","لجَاجاً والتمسْ لدمٍ رُقُوّا",25,"و",2,0],["سَفاهاً وَقَد عُلِّقتُ مِن أُمِّ سالِمٍ","وَمِن جارَتَيها في فُؤادِيَ كَالجَمرِ",26,"ر",1,0],["سَفَرَت فَقُلتُ لَها أَهَذا كَوكَبٌ","قالَت أَجَل وَأَينَ مِنّي الكَوكَبُ",27,"ب",1,1],["سُفُنٌ هِيَ الأَطوادُ لَولا سَيرَها","أَعَهِدتُمُ جَبَلاً مَشى أَو سارا",28,"ر",2,0],["سَفَكتُ إِفضالاً دَمي كَي تُرى","تَزيدَ في عُمرِكَ أَعواما",29,"م",2,0],["سفحت على اقدام ليلى مدامعي","وليلى سوى صد يبرح لا تبدى",30,"د",2,1],["سفر إلى الوادي السعيد وملكه","حسدت عليه وفودها الأمصار",31,"ر",1,0],["سَفَرٌ مِن عَدَنِ الأَرضِ إِلى","مَنزِلٍ أَقرَبُ مِنهُ قُطُباها",32,"ا",3,0],["سَفينَةُ اللَهِ لَم تُقهَر عَلى دُسُرٍ","في العاصِفاتِ وَلَم تُغلَب عَلى خُشُبِ",33,"ب",1,0],["سَفَرَت وَبَرقَعَها الفِراقُ بِصُفرَةٍ","سَتَرَت مَحاجِرَها وَلَم تَكُ بُرقُعا",34,"ع",2,0],["سَفَكَ الدِماءَ بِجودِهِ لا بَأسِهِ","كَرَماً لِأَنَّ الطَيرَ بَعضُ عِيالِهِ",35,"ل",2,0],["سَفَعْنا بها وجهَ النهار فراعَنَا","بنُقْبَةِ مُسْوَدِّ الخياشيم شاحبِ",36,"ب",1,0],["سَفاهاً تَمادى لَومُها وَلَجاجُها","وَإِكثارُها فيما رَأَت وَضَجاجُها",37,"ج",3,1],["سَفَرٌ مَنَعتَهُمُ الصُعودَ فَصَوَّبوا","وَالاِنحِدارُ سَبيلُ مَن لَم يَصعَدِ",38,"د",1,0],["سَفَرٌ جَدَّدَت لَنا ال","لَهوَ أَيّامُهُ الجُدُد",39,"د",1,0],["سَفَرٌ جَلَوتَ بِهِ العُيونَ فَأَبصَرَت","وَفَرَجتَ ضيقَةَ كُلِّ قَلبٍ مُقفَلِ",40,"ل",1,0],["سَفَرَت كَما سَفَرَ الرَبيعُ الطَلقُ عَن","وَردٍ يُرَقرِقُهُ الضُحى مَصقولِ",41,"ل",1,0],["سَفَهٌ مِنكُما وَإِفراطُ لُؤمٍ","أَن تَلوما في الحُبِّ غَيرَ مُليمِ",42,"م",1,0],["سَفينَةُ بَرٍّ مُستَعَدٌّ نَجائُها","لِتَوجابِ رَوعاتِ القُلوبِ الرَواجِفِ",43,"ف",1,0],["سفحت رقى العذال يوم محجر","دمعا على الخدين ليس براقي",44,"ق",2,0],["سَفَرٌ رَجَوْتُ به النَّهايةَ في الغِنَى","فبلغتُ منه نِهايةَ الإملاقِ",44,"ق",1,0],["سفَرتْ لنا الدُّنيا وكَم","ألقَت محاسِنُها الخِمارا",45,"ر",2,0],["سفَرَتْ فشِمْتُ لها بوارِقَ شيمَةٍ","وَثِقَ الهَوى منها بِحَظٍّ مُسْفِرِ",46,"ر",1,0],["سفَرَتْ له فأَرتْهُ بَدراً طالعاً","وتَماي