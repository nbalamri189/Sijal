ة لم تعتمل بنجر","https://www.aldiwan.net/poem9864.html","مشطور الرجز"],[495,"راض كلا أو ساخط كالراضي","https://www.aldiwan.net/poem10225.html","الكامل"],[500,"هذه واسط أم ذا حلم","https://www.aldiwan.net/poem37790.html","الرمل"],[504,"أحببت رب ملاحة لجماله","https://www.aldiwan.net/poem38412.html","الكامل"],[509,"هل عرفت الغداة رسماً محيلا","https://www.aldiwan.net/poem751.html",""],[514,"بزغت بالظلام شمس الديور","https://www.aldiwan.net/poem20787.html","الخفيف"],[514,"شرف الوجه في تراب زرود","https://www.aldiwan.net/poem20806.html","الخفيف"],[514,"سفرت فبرقعها حجاب جمال","https://www.aldiwan.net/poem20814.html","الكامل"],[514,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[515,"سفر الزمان بواشح من بشره","https://www.aldiwan.net/poem12098.html","الكامل"],[515,"سرت نفحة كالمسك أزهى وأعطر","https://www.aldiwan.net/poem12119.html","الطويل"],[529,"حثوا المطي إلى ربا صنعا","https://www.aldiwan.net/poem37332.html","الكامل"],[529,"أقول بعد الحمد","https://www.aldiwan.net/poem37446.html","مجزوء الرجز"],[538,"أتركوه يهذي فإن كلامه","https://www.aldiwan.net/poem47945.html","عموديه"],[543,"عجلا اليوم صاحبي رواحا","https://www.aldiwan.net/poem1764.html","الخفيف"],[551,"يا عليل الطرف رفقا","https://www.aldiwan.net/poem47264.html","مجزوء الرمل"],[551,"لمن ضرم أعلى اليفاع تعلقا","https://www.aldiwan.net/poem47366.html","الطويل"],[558,"أنا بالله عارف","https://www.aldiwan.net/poem34348.html","مجزوء الخفيف"],[559,"قد كساني لباس سقم وذله","https://www.aldiwan.net/poem69349.html","الخفيف"],[562,"يا نفس هل من أمر ربك عاصم","https://www.aldiwan.net/poem52796.html","الكامل"],[562,"نادى منادي البين حي على السرى","https://www.aldiwan.net/poem52892.html","الكامل"],[562,"مات الحبيب كأنه لم يولد","https://www.aldiwan.net/poem52912.html","الكامل"],[562,"هوى في القلب يعذب وهو داء","https://www.aldiwan.net/poem52983.html","الوافر"],[567,"بكاء وقل غناء البكاء","https://www.aldiwan.net/poem69825.html","الطويل"]],"verses":[["سَفينَةُ الأملِ المَمْدودِ قد سبَحَتْ","في جودِهِ واسْتَوَتْ منْهُ على الجودي",0,"د",2,0],["سَفائِنُ تَخْرِقُ بحْرَ الفَلا","وتَلْحَقُ نحْوَكَ بِيداً فَبيدْ",1,"د",1,0],["سُفِحَتْ فيهِ للدّموعُ دماءٌ","فهْيَ فوقَ الخُدودِ ذاتُ انْسِياحِ",2,"ح",1,0],["سَفائِنُ تَسْتَفّ الفَلا فكأنّها","سَفائِنُ في بَحْرِ السّرابِ سَوابِحُ",3,"ح",1,0],["سَفَهاً وَما تَدري سُمَيَّةُ وَيحَها","أَن رُبَّ غانِيَةٍ صَرَمتُ وِصالَها",4,"ل",3,0],["سَفى فَوقَهُنَّ التُربَ ضافٍ كَأَنَّهُ","عَلى الفَرجِ وَالحاذينِ قِنوٌ مُذَلَّلُ",5,"ل",1,0],["سَفَرَت تُوَدِّعُ أُمَّةً مَحمولَةً","في النَعشِ لا خَبَراً مِنَ الأَخبارِ",6,"ر",1,0],["سُفِكَت مَوَدَّتُنا لَكُم وَبَدا لَنا","أَنَّ الحِيادَ عَلى الخِصامِ لِثامُ",7,"م",1,0],["سَفَّهتَ آراءَهُم فيها فما لَبِثوا","أن أوسَعُوكَ على ماجِئتَ تَسفيها",8,"ي",3,0],["سَفَهاً بِحلمي إِن تَرَكتُ أَتِ","يَّ السَيلِ وَاِستَغنَيتُ بِالوَشَلِ",9,"ل",1,0],["سُفعُ الخُدودِ كَأَنَّهُنَّ وَقَد مَضَت","حِجَجٌ عَوائِدُ بَينَهُنَّ سَقيمُ",10,"م",1,0],["سُفُوحُها حُرَّةٌ وَالهَامُ مُطْلَقَةٌ","وَكُلُّ عَانٍ بِهَا بَعْدَ الأَسَى هَانِي",11,"ن",2,0],["سفوح جبال بعضها فوق بعضها","مكلّلة حافاتهنّ باشجار",12,"ر",1,0],["سفينة أسكنها ماءٌ جَمَد","حتى لقد يئست من فتح السُدَد",13,"د",1,0],["سفينة ملكهم فيها خُروق","وهم لا يُحسِنون لها القِلافه",14,"ف",2,0],["سفر أقام على السفور أدلّةً","تركت ذبابكم بغير طنين",15,"ن",1,0],["سَفِهَ الأُخَيطِلُ إِذ يَقي بِعَجوزِهِ","كيرَ القُيونِ كَأَنَّهُ مِنديلُ",16,"ل",1,0],["سَفهاً وَلَو أَنّي أَطَعتُ عَواذِلي","فيما يُشِرنَ بِهِ بِسَفحِ المِذنَبِ",17,"ب",1,0],["سَفَهاً عَذَلتِ وَقُلتِ غَيرَ مُليمٍ","وَبُكاكِ قِدماً غَيرُ جِدِّ حَكيمِ",18,"م",1,1],["سفع الخدود كأنما","نثرت عليهن المكاحلْ",19,"ل",1,0],["سِفاحاً جِهاراً مِن أُحَيمَقِ مِنهُمُ","فَقَد سَبَقَتهُم في جَميعِ المَشاهِدِ",20,"د",1,0],["سفينة ليس تجري بي لذي بخل","إنَّ السفينة لا تجري على اليبس",21,"س",1,0],["سفكْت به كفُّ الطبيب صُبابةً","كم دونها من وِردِ موتٍ أحمر",22,"ر",1,0],["سفينةٌ من سفين البر محكمةٌ","تجري إذا ما اتخذت السوط مجدافا",23,"ف",2,0],["سفهتُ على عمروٍ سفاهةَ جاهلٍ","وأبصرتُ ما في الحلمِ إبصارَ عالمِ",24,"م",1,1],["سفكتَ دمَ الحياء فلا تُتابعْ","لجَاجاً والتمسْ لدمٍ رُقُوّا",25,"و",2,0],["سَفاهاً وَقَد عُلِّقتُ مِن أُمِّ سالِمٍ","وَمِن جارَتَيها في فُؤادِيَ كَالجَمرِ",26,"ر",1,0],["سَفَرَت فَقُلتُ لَها أَهَذا كَوكَبٌ","قالَت أَجَل وَأَينَ مِنّي الكَوكَبُ",27,"ب",1,1],["سُفُنٌ هِيَ الأَطوادُ لَولا سَيرَها","أَعَهِدتُمُ جَبَلاً مَشى أَو سارا",28,"ر",2,0],["سَفَكتُ إِفضالاً دَمي كَي تُرى","تَزيدَ في عُمرِكَ أَعواما",29,"م",2,0],["سفحت على اقدام ليلى مدامعي","وليلى سوى صد يبرح لا تبدى",30,"د",2,1],["سفر إلى الوادي السعيد وملكه","حسدت عليه وفودها الأمصار",31,"ر",1,0],["سَفَرٌ مِن عَدَنِ الأَرضِ إِلى","مَنزِلٍ أَقرَبُ مِنهُ قُطُباها",32,"ا",3,0],["سَفينَةُ اللَهِ لَم تُقهَر عَلى دُسُرٍ","في العاصِفاتِ وَلَم تُغلَب عَلى خُشُبِ",33,"ب",1,0],["سَفَرَت وَبَرقَعَها الفِراقُ بِصُفرَةٍ","سَتَرَت مَحاجِرَها وَلَم تَكُ بُرقُعا",34,"ع",2,0],["سَفَكَ الدِماءَ بِجودِهِ لا بَأسِهِ","كَرَماً لِأَنَّ الطَيرَ بَعضُ عِيالِهِ",35,"ل",2,0],["سَفَعْنا بها وجهَ النهار فراعَنَا","بنُقْبَةِ مُسْوَدِّ الخياشيم شاحبِ",36,"ب",1,0],["سَفاهاً تَمادى لَومُها وَلَجاجُها","وَإِكثارُها فيما رَأَت وَضَجاجُها",37,"ج",3,1],["سَفَرٌ مَنَعتَهُمُ الصُعودَ فَصَوَّبوا","وَالاِنحِدارُ سَبيلُ مَن لَم يَصعَدِ",38,"د",1,0],["سَفَرٌ جَدَّدَت لَنا ال","لَهوَ أَيّامُهُ الجُدُد",39,"د",1,0],["سَفَرٌ جَلَوتَ بِهِ العُيونَ فَأَبصَرَت","وَفَرَجتَ ضيقَةَ كُلِّ قَلبٍ مُقفَلِ",40,"ل",1,0],["سَفَرَت كَما سَفَرَ الرَبيعُ الطَلقُ عَن","وَردٍ يُرَقرِقُهُ الضُحى مَصقولِ",41,"ل",1,0],["سَفَهٌ مِنكُما وَإِفراطُ لُؤمٍ","أَن تَلوما في الحُبِّ غَيرَ مُليمِ",42,"م",1,0],["سَفينَةُ بَرٍّ مُستَعَدٌّ نَجائُها","لِتَوجابِ رَوعاتِ القُلوبِ الرَواجِفِ",43,"ف",1,0],["سفحت رقى العذال يوم محجر","دمعا على الخدين ليس براقي",44,"ق",2,0],["سَفَرٌ رَجَوْتُ به النَّهايةَ في الغِنَى","فبلغتُ منه نِهايةَ الإملاقِ",44,"ق",1,0],["سفَرتْ لنا الدُّنيا وكَم","ألقَت محاسِنُها الخِمارا",45,"ر",2,0],["سفَرَتْ فشِمْتُ لها بوارِقَ شيمَةٍ","وَثِقَ الهَوى منها بِحَظٍّ مُسْفِرِ",46,"ر",1,0],["سفَرَتْ له فأَرتْهُ بَدراً طالعاً","وتَمايَلَتْ فأَرتْهُ غُصناً مائدا",47,"د",2,0],["سَفَرٌ مُسفِرٌ لك السعدُ فيه","قادَه اليُمْنُ وانتحاهُ النَّجاحُ",48,"ح",1,0],["سَفَرَتْ لنا من رأيه وحُسامِه","عن ضوْءِ صُبْحٍ مُسْفرٍ وشِهابِ",49,"ب",1,0],["سَفرْنَ فلاحَ الأقحوانُ مفضَّضاً","على القُربِ منا والشَّقِيقُ مُذَهَّبا",50,"ب",2,0],["سَفَهاً لِمَنْ سمَّاه سيفَ حفيظَةٍ","هلاَّ أعارِ السَّيفَ من أسمائِه",51,"ا",3,0],["سَفَلَت بِهِم لُجَجُ المَنيَّ","ةِ كُلُّهُم فيمَن سَفَل",52,"ل",1,0],["سَفَحَ المِزاجَ عَلى حُمَيّا الكاسِ","وَسَعى يَطوفُ بِها عَلى الجُلّاسِ",53,"س",1,1],["سَفَرَت فَكانَت تَحتَ جِلبابِ الدُجى","تُغني عَنِ المِصباحِ وَالمِقباسِ",53,"س",1,0],["سَفَهاً إِذا شُقَّت عَلَيكَ جُيوبُ","إِن لَم تُشَقَّ مَرائِرٌ وَقُلوبُ",54,"ب",1,1],["سَفَرَت كَالشَمسِ ضاحِكَةً","مِن تَواري الشَمسِ في الحُجُبِ",55,"ب",1,0],["سَفَهاً رَأَينَ المانَوِيَّةَ عِندَما","أَسبَلنَ مِن ظُلمِ الشُعورِ غياهِبا",56,"ب",2,0],["سفر صار على طالبه","ركبُ ضنك والمنايا سفرُ",57,"ر",1,0],["سفر على سفر فهذي رقدة","شفي الغليل بها وطاب أوام",58,"م",1,0],["سفرتْ لوداعك شمسَ ضحىً","وَثَنَتْ بكثيبِ نقا غُصُنا",59,"ن",2,0],["سَفَرَتْ فما دَرَتِ الظنون ضميرها","أَسُفُورها من صُبحِها إِسفارُ",60,"ر",1,0],["سَفِهَ الفِراقُ عَلَيكَ يَومَ رَحيلِهِم","وَبِما أَراهُ وَهوَ عَنكَ حَليمُ",61,"م",1,0],["سَفيهُ الرُمحِ أُرعِفَتِ العَوالي","وَلَيسَ المُرعِفاتُ سِوى الكُلومِ",62,"م",1,0],["سَفَعَ الدُؤوبُ وُجوهَهُم فَكَأَنَّهُم","وَأَبوهُمُ سامٌ أَبوهُم حامُ",63,"م",1,0],["سَفَرَ الشَبابُ لَنا بِهِ عَن غُرَّةٍ","يُرمى بِها لَيلُ السِرارِ فَيُقمِرُ",64,"ر",1,0],["سَفَكوا الدِماءَ بَريئَةً وَتَنَمَّروا","يَرمونَ شَعباً لا يُطيقُ دِفاعا",65,"ع",2,0],["سَفَكَ الدِماءَ وَلَجَّ في غلوائِهِ","صَلِفاً يُدِلُّ بِشَرِّهِ وَعُرامِهِ",66,"م",2,0],["سُفُنٌ هَوَت بِالحوتِ حينَ تَبادَرَت","تَنسابُ بَينَ الحوتِ وَالسَرَطانِ",67,"ن",1,0],["سُفيانُ هل كنتَ طَودَاً","فمن رَماكَ فَهَدَّكْ",68,"ك",1,0],["سَفَرَت لَهُ بِكرُ الخُطوبِ بِوَجهِها","فَاِستَحسَنَ الظَلماءَ فيها خالا",69,"ل",2,0],["سَفَرَت بِهِ أَيّامُها واِستَضحَكَت","فَكَأَنَّهُنَّ مَباسِمٌ وَخُدودُ",70,"د",1,0],["سُفَراء الصباحِ نورٌ وطيرٌ","تتغنَّى في مائساتِ الغصون",71,"ن",1,0],["سَفَت عَن قَذاها كَما","تَعَرّى أَديمُ الذَهَب",72,"ب",1,0],["سَفَحَتْ دِماءُ الدّارِعينَ بها","حتى كأنّ جُفونَهم ثُغَرُ",73,"ر",1,0],["سفَرُوا فأخلتْ بالشموس جباهُهُمْ","وتَمَعْجَرَتْ بغَمامها الأقمار",74,"ر",1,0],["سَفيحَ بنَ عَمرو لا بَل وَليدُهُ","وَإِن ذُكِرَ المَعروفُ أَصغى لَهُ خَدّا",75,"د",2,0],["سَفيهَ قُرَيشٍ لا تَهولَنَّكَ المُنى","إِلى ضِلَّةٍ قَد نِلتَ سَعيَكَ فَاِبعَدِ",76,"د",1,0],["سَفيهَ قُرَيشٍ ما عَلَيكَ مَهابَةٌ","وَلا فيكَ فَضلٌ مِن إِماءٍ وَأَعبُدِ",76,"د",1,0],["سَفَرٌ يَطولُ مِنَ الأَنامِ عَلى كَراً","مِن غَفلَةٍ وَكَراً مِنَ الأَزوادِ",77,"د",1,0],["سَفَكَت دَمَ الدِنانِ وَما تَشَكَّت","وَيُشكى مِن دَمِ الأَقوامِ سَفكُ",78,"ك",1,1],["سَفَكَ الدِماءَ بِها رِجالٌ أَعصَموا","بِالخَيلِ تُلجَمُ بِالحَديدِ وَتُنعَلُ",79,"ل",1,0],["سِفَاهٌ لَوْعَةُ النّجْدِيّ لمّا","تَنَسّمَ من حِيالِ الشأمِ رِيحا",80,"ح",2,0],["سِفاهٌ ذادَ عنْكَ الناسَ حِلْمٌ","وَغَيٌّ فيه مَنْفَعَةٌ رَشادُ",81,"د",1,0],["سَفَرْنَ قناعَ الحُسنِ عنها فأَشرقتْ","مصابيحُ أبوابِ السماءِ تَروقُ",82,"ق",1,0],["سفري إليها كله قد تم في","يوم وآخر لم يكن بتمام",83,"م",1,0],["سَفَرَتْ بِهَا الأَقْمَارُ مِنْ أَطْوَاقِهَا","وَتَجَمَّعَتْ بِفِنَائِهَا الْعُشَّاقُ",84,"ق",1,0],["سِفْرٌ جَلِيلٌ مَنْ يُطاِلعُهُ","لا يَنْثَنِي أَو يُنْجِزَ السِّفْرَا",85,"ر",2,0],["سَفَهٌ جَرَّأَ العَبِيدَ المَنَاكِي","دَ عَلَى مُعْتَقِيهِمِ الأَجْوَادِ",86,"د",1,0],["سِفْرٌ أَعَادَ الذِّكْرَ أَدْرَاجَهُ","إِلى شَبَابِ اللُّغَةِ الرَّيِّقِ",87,"ق",1,0],["سِفْرٌ خَطَطْتَ فُصُولَهُ","بِبَرَاعَةِ اللَّبِقِ الْقَديرِ",88,"ر",1,1],["سِفْرٌ إِلى العِرْفَانِ أَهْدَى طُرْفَةً","لَمْ تُهْدِهَا مِنْ قَبْلِهِ الأَسْفَارُ",89,"ر",1,0],["سَفِينَةٌ أَنْتَ مُجْرِيهَا وَكَالِئُهَا","مِنَ الزَّعَازِعِ لاَ تَخْشَى أَذَى العَطَبِ",90,"ب",1,0],["سُفن تلتقِي على شاطىء الغي","بِ لتَلقي هُناكَ سُفناً وسفنَا",91,"ن",2,0],["سَفَائِنُ لَمْ يَعْرِفْ لَهَا الدَّهْرُ ساحِلاً","وسَفْرٌ عَلَى الأَيَّامِ مَا مَلَّ دَائِبُهْ",92,"ب",2,0],["سَفَرتْ به البُشْرَى فَطاحَ قِناعُها","عَمْداً وطَار مع الهَواءِ خِمار",93,"ر",1,0],