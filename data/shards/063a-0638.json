{"poems":[[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43852","البسيط"],[13,"تَقُولُ سُلَيْمَى لِجَارَاتِهَا","https://www.poetsgate.com/ViewPoem.aspx?id=180820",""],[161,"من عوض الصبر عما فاته ربحا","https://www.aldiwan.net/poem58909.html","البسيط"],[394,"يا غزالا عذاره كالطراز","https://www.aldiwan.net/poem53679.html","الخفيف"]],"verses":[["غِظتُ حَسودي فَظَلَّ يَلغى","في شَرَفي وَالحَسودُ لاغِ",0,"غ",1,0],["غَظَاءَةُ قَفْرٍ لَهَا حُلَّتَا","نِ مِنْ وَرَقِ الطَّلْحِ لَمْ تُغْزلاَ",1,"ل",2,0],["غظتَ العدوَّ وأَرضيت المحبَّ بما","تسدي ولم تخجلِ المثني الذي مَدحا",2,"ح",2,0],["غِظ عَذولي وَاِهتزّ لِلوَصلِ يَوماً","كَغصونٍ قَد غِظتَها بِاِهتِزازِ",3,"ز",1,0]]}