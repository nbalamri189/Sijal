{"poems":[[74,"حاشاك من وحشة تحت الثرى وجلا","https://www.aldiwan.net/poem20546.html","البسيط"],[53,"رأيت منكسر السكان ظاهره","https://www.aldiwan.net/poem65805.html","البسيط"],[53,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[47,"وراءك عني يا عذول الأشايب","https://www.aldiwan.net/poem11493.html","الطويل"],[30,"ألم خيال من علية بعدما","https://www.aldiwan.net/poem5318.html","الطويل"],[68,"لا نلت من طيب وصلكم أملا","https://www.aldiwan.net/poem38474.html","المنسرح"],[83,"أذوت سموم النوى ريحانة الأمل","https://www.aldiwan.net/poem61327.html","البسيط"],[42,"عوجى علي وسلمي جبر","https://www.aldiwan.net/poem42332.html","أحذ الكامل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16631","المتقارب"],[111,"لن ترضي الله حتى تخلص الورعا","https://www.poetsgate.com/ViewPoem.aspx?id=106",""],[211,"أبعد عمار الخير نرجو سلامة","https://www.aldiwan.net/poem27912.html","الطويل"],[214,"رأى العقيق فأجرى دمعه لولو","https://www.aldiwan.net/poem13306.html","البسيط"],[214,"قسما بليل الشعر منك إذا سجا","https://www.aldiwan.net/poem13395.html","الكامل"],[234,"يا من رعى ودي وأدناني","https://www.aldiwan.net/poem50753.html","السريع"],[234,"الحمد لله شكرا هذا","https://www.aldiwan.net/poem51260.html","المجتث"],[237,"ما كنت في عشقي لذاك القوام","https://www.aldiwan.net/poem14789.html","السريع"],[257,"أما كفاك تلافي في تلافيكما","https://www.aldiwan.net/poem1474.html",""],[266,"لا نلت عفوا الهنا عاف شذا","https://www.aldiwan.net/poem38374.html","الكامل"],[276,"مثل لعينك خدرا في الحمى ضربا","https://www.aldiwan.net/poem52086.html","البسيط"],[309,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[354,"لا نلت منكم باللقا آمالي","https://www.aldiwan.net/poem15851.html","الكامل"],[412,"الآن قد صح لي حقا بلا كذب","https://www.aldiwan.net/poem50209.html","البسيط"],[435,"الحمد لله الذي قد حللا","https://www.aldiwan.net/poem40815.html","الرجز"],[469,"لتذكري ظبيات سلع والنقا","https://www.aldiwan.net/poem3619.html","عموديه"],[563,"من يعرف الله فليس يسأل","https://www.aldiwan.net/poem34250.html","الرجز"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137625",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48676","الكامل"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100154","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119921","السريع"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72308","الطويل"],[1395,"","https://poetry.dctabudhabi.ae/diwan/poem/124511",""],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49971","الطويل"],[2100,"","https://poetry.dctabudhabi.ae/diwan/poem/34969","الطويل"],[2173,"","https://poetry.dctabudhabi.ae/diwan/poem/142779","الكامل"],[2186,"","https://poetry.dctabudhabi.ae/diwan/poem/124166","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27537","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27546","الوافر"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27538","الطويل"],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84857","البسيط"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65957","الرجز"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65941","الطويل"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118963","البسيط"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65104","الطويل"],[3102,"","https://poetry.dctabudhabi.ae/diwan/poem/113898","الطويل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/140038","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48435","الطويل"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61261","الكامل"],[3765,"","https://poetry.dctabudhabi.ae/diwan/poem/141086","الكامل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133191","الوافر"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33278","الكامل"],[4571,"","https://poetry.dctabudhabi.ae/diwan/poem/99109","الكامل"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67427","المنسرح"],[4882,"إن البلاغة في النهرين تزدحم","https://www.poetsgate.com/ViewPoem.aspx?id=34801",""],[4942,"إني ٱنطلقت","https://www.poetsgate.com/ViewPoem.aspx?id=188393",""],[5064,"قوافل الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=199088",""],[5674,"أمشي ودربي غائرة","https://www.poetsgate.com/ViewPoem.aspx?id=186057",""],[5953,"يا سرّ مرَّى لقد أصبحت لي سكناً","https://www.poetsgate.com/ViewPoem.aspx?id=93789",""],[5956,"إنْ تَرجعِ الشامَ يا قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=183700",""],[5956,"إنْ ترجِعِ الشامَ يا قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=196801",""],[5956,"هي سامِيا العظمى محمدُ سالكٍ","https://www.poetsgate.com/ViewPoem.aspx?id=215550",""],[469,"أمذكري ظبيات سلع والنقا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574810",""],[6324,"نجوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87950&r=&rc=15",""]],"verses":[["لا نلت قربك من دارِ النعيمِ غداً","إن كانَ قلبي المعنى عن هواكَ سلا",0,"ل",2,0],["لأن لفظة سُكَّان إذا قُلبَتْ","حروفها ناكس لا شك في ذاكا",1,"ك",2,0],["لا نُلْزَمُ الذكرَ إنّا لم نُسَمَّ به","ولا مُنِحْناهُ بل للذِّكر ذُكران",2,"ن",1,0],["لِأَنَّ لِكُلٍّ مِنهُما وَقتَ غَيبَةٍ","وَأَنَّكَ لا غُيِّبتَ لَستَ بِغائِبِ",3,"ب",1,0],["لِأَنَّ لَها نِصفَ المِلاحَةِ قِسمَةً","مَعَ الفَترَةِ الحَسناءِ عِندَ التَهانُفِ",4,"ف",1,0],["لا نِلتُ مِن طيبِ وَصلِكُم أَمَلا","إِن أَنا حاوَلتُ عَنكُمُ بَدَلا",5,"ل",2,1],["لانَ لَكَ الدَهرُ بَعدَ شِدَّتِهِ","فَجادَ لِلناسِ بَعدَما بَخِلا",5,"ل",2,0],["لا نلت قربي والهِجران فِي قَرنٍ","ضِدٌّ بِضِدّ كَجَمعِ القُطنِ بِالشُّعَلِ",6,"ل",1,0],["لا نَلتَقي إِلّا ثَلاثَ منىً","حَتّى يُشَتِّتَ بَينَنا النَفرُ",7,"ر",1,0],["لأن لها عنده زلفةً","وفاعل ما فعلت يؤجر",8,"ر",1,0],["لأن للعلم شأنا كل مرتبة","وكل شان رفيع دونه اتضعا",9,"ع",2,0],["لَإِن لَم أَزُر خَولانَ في عَقرِ دارِها","بِأَرعَنَ رَجّافٍ تُزَجّى قَنابِلُه",10,"ل",2,0],["لأن لي فيك يا كنز الرجا املا","وانت يا مطلب الراجين مأمول",11,"ل",1,0],["لا نلت سؤلي ان سلوت ولا سرت","يوما لبحر الجود بي سفن الرجا",12,"ج",2,0],["لا نِلْتُ سؤلي منه إن لم يكن","سِرِّىَ فيه مِثْلَ إعلاني",13,"ن",2,0],["لا نِلْتَ ما كان منه","يومَ الوصال ومِنّا",14,"ن",2,0],["لا نِلتُ مِن وَصلِكَ ما أبتَغى","إِن سَمِعَت أُذنايَ فيكَ المَلام",15,"م",1,0],["لا نِلتُ وَصلك إِن كانَ الَّذي زَعَموا","وَلا سَقى ظَمأي جودُ ابنِ رُزّيكا",16,"ك",2,0],["لا نلت عفوا الهنا عاف شذا","وعرى ربوعا تحتويه عفاء",17,"ا",2,1],["لا نلت قوة ضعفي ان نبازمني","وَفي يَدي منك سيف ما هَوى فَنَبا",18,"ب",2,0],["لا نلت شهدا قبل لسعة نحلة","ولا لذ قوت قبل إلفاء نيران",19,"ن",1,0],["لا نِلتُ مِنكُم بِاللِقا آمالي","إِن حالَ عَنكُم بِالتَباعُدِ حالي",20,"ل",2,1],["لأَنَّ لِلدَّهرِ أَحوالاً تَدُلُّ عَلى","أَنَّ الَّذي نابِهٌ مِنهُ بِمُنقَلبِ",21,"ب",1,0],["لأنّ للصيد وللبازي سنَن","محدودة قد سنها ذوو الفطن",22,"ن",1,0],["لا نلتُ ما فوقَ المطيِّ من المهى","إنْ كانَ قلبي قرَّ أو دمعي رقا",23,"ق",2,0],["لانَ له صمُّ الحصى والجندل","وانقادت الشم الأنوف الطوَل",24,"ل",1,0],["لأن لديّ الوف غرائ","ب في البعض منها أضيع الجنانا",25,"ن",2,0],["لا نلت منه زهرة إن لم يعد","حرّاً ولا استروحت فيه نسيما",26,"م",2,0],["لا نلت وصلهم إن رمت بعدهم","صبراً وكيف يطيق الصبر سلوانا",27,"ن",2,0],["لأن لعاف ولجاف قسا","فالعفو من شيمته والنكال",28,"ل",1,0],["لأن لهم في كل فضل وسؤدد","فصولاً عليها العالمون فضول",29,"ل",1,0],["لإن لاح ربعُ التوأمين توهما","فأذريت دمع العين فَذّاً توأَما",30,"م",2,1],["لأنَّ له العليا عليهم مُبينّة","فإِن يجحدوها صحّحتها السّرائرُ",31,"ر",1,0],["لِأَنَّ لَكَ العُقبى مِنَ الأَجرِ خالِصاً","وَشُكرِيَ في الدُنيا فَحَظُّكَ أَرجَحُ",32,"ح",1,0],["لا نلتقي إلاّ بجسمٍ ناحِلٍ","أبداً وقلبٍ بالفراق مُروَّعِ",33,"ع",1,0],["لا نلتُ ما أرجوه منك من المنى","إنْ كانَ غيركَ خاطراً في خاطري",34,"ر",2,0],["لأنَّ له التقليب في كلِّ حالة","به فتراه حيثُ يحمله الركبُ",35,"ب",1,0],["لأنَّ له الكمال بغير شكٍّ","فيظهر في القريب وفي البعيد",36,"د",1,0],["لأن لهم وجهين في أصل خلقهم","فوجهٌ إلى فصلٍ ووجهٌ إلى وصل",37,"ل",1,0],["لِأَن لَكَ نجل في الأَنام لَهُ","مَجد يُناسب فيهِ الوالد الوَلَدا",38,"د",2,0],["لا نلت محبوباً إذا لم أنقذ ال","أديان من كف الغويّ الفاجر",39,"ر",1,0],["لأن لم تقرّي في الستور وتستري","محاسنك الحسنى بترك التبرج",40,"ج",1,0],["لا نلت منه المرام إن لم","أجعل فؤادي له مخلَّى",41,"ل",2,0],["لأنّ لهُ بين ملوك مآثر","ترى الزّهر في العلياء منهنّ تزهُرُ",42,"ر",1,0],["لأن لنا حب الكرامة حلية","وهم اشربوا حب التمتع بالنهب",43,"ب",1,0],["لآن لنفسي أن تفيظ صبابةً","إذا ذكرتْ تلك الشمائل والحلا",44,"ل",2,0],["لأنّ ليَ القلبَ المُقَلَّبَ بالأسى","سَيَحيا بما يُهْديهِ من فكرِه يَحْيى",45,"ي",2,0],["لأنَلتهم ضِعفَي مُناهم راضيا","عَنهُم وَنالوا عاجلاً ما أَجَّلوا",46,"ل",3,0],["لا نلت خيراً ما حيي","ت ولا عداني الدهر شر",47,"ر",1,0],["لأَنَّ لاَ إلَهَ إلاّ اللهُ قَد","تَضَمّنَت جُملَتُهَا مَا يُعتَقَد",48,"د",1,0],["لأن لاحر يأبى كل ضيمٍ","وعز المرء اسنى عالياته",49,"ت",2,0],["لا نلتُ منكَ منىً أسرُّ بها","وقضيتُ منكَ بحسرةِ النظرِ",50,"ر",1,0],["لأنلتني شرف المقام ورعي بي","قلب الزمان وصنت وجه مدائحي",51,"ح",2,0],["لان للخارجات منفعة","تأتيه والداخلون طلاب",52,"ب",1,0],["لان لله ايد ٍ كم تحيط بنا","اهل العراق بكف الله يعتصموا",53,"م",3,0],["لان للحزن وقعا كالقيود اذا","قلبي تخاذل حتما سوف يضنيه",54,"ي",2,0],["لأنَّ لثَالثِ الحِسَّينِ معنًى","بهِ تحيَا رُؤاكَ ولا ترَاهُ",55,"ا",2,0],["لانلتقي ؛ فأنا وأنت -","كما الطيور مهاجرةْ",56,"ر",2,1],["لأن ليس لمن والى أثمته","يأت شيئا نهوه عنه إن فتنا",57,"ن",2,0],["لأنَّ لحن الهوى يزداد توسعة","أنَّى رحلتُ كأنَّ الكونَ بي اختُزلا",58,"ل",2,0],["لأن لحن الهوى يزداد توسعة","أنى نزلت كأن الكون بي اختُزلا",59,"ل",2,0],["لا نلتقي سلبية في عهدها","عهدِ الهدى وزيادة التوفيقِ",60,"ق",1,0],["لا نلتُ ما فوقَ المطيِّ من المها","إن كان قلبي قرَّ أو دمعي رقا",61,"ق",2,0],["لأنّ لها في ظلمة الّليل مجلساً","تبثُّ به لله ما جنّت النفسُ",62,"س",1,0]]}