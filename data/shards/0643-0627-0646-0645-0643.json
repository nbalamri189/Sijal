{"poems":[[91,"أعظم شأن أبيات أتتني","https://www.aldiwan.net/poem45083.html","الوافر"],[87,"أفي هذا الشباب تعف نفس","https://www.aldiwan.net/poem7776.html","الوافر"],[40,"ضعيفُ العصا بادي العروقِ ترى لهُ","https://www.poetsgate.com/ViewPoem.aspx?id=21209",""],[342,"ألا ناديا أظعان ليلى تعرج","https://www.aldiwan.net/poem45434.html","الطويل"],[603,"","https://poetry.dctabudhabi.ae/diwan/poem/107233","الوافر"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26408","الطويل"],[2337,"","https://poetry.dctabudhabi.ae/diwan/poem/21444","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72446","الوافر"]],"verses":[["كأنَّ مكارم الأخلاق طير","على علياءِ ذروتهِ تحوم",0,"م",1,0],["كأن مكارم الأخلاق روض","وأنت الزهر فيه والنسيم",1,"م",1,0],["كأنّ مكاناً لَكْلَكَتْ ضرعَها بهِ","مراغة ُ ضِبَعانٍ أسَنَّ وأمرَعَا",2,"ع",2,0],["كَأَنَّ مَكانَ الجَحشِ مِنها إِذا جَرَت","مَناطُ مِجَنٍّ أَو مُعَلَّقُ دُملُجِ",3,"ج",1,0],["كأنَّ مكانها مِن أَرضِ هَجرٍ","طِرازٌ لاحَ مِن ثَوبٍ مُطَرَّز",4,"ز",1,0],["كَأَنَّ مَكانَ التاجِ سِلكاً مُفَصَّلاً","بِنَورِ الخُزامى أَو جُماناً مُنَظَّما",5,"م",2,0],["كأَن مَكانَ العِقدِ مِنها إِذا بَدا","صفاً مِنَ حَزيزٍ سهَّلَتهُ الموارِدُ",6,"د",1,0],["كأن مكارم الاخلا","ق طالت بينها الشقق",7,"ق",1,0]]}