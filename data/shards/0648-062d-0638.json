{"poems":[[53,"أماني نفس ما تناخ ركابها","https://www.aldiwan.net/poem30760.html","الطويل"],[27,"إني امرؤ يبني لي المجد البان","https://www.aldiwan.net/poem4434.html","الرجز"],[37,"رأيتكم من مالك وادعائه","https://www.aldiwan.net/poem7434.html","الطويل"],[51,"بدا الشيب إلا ما تداوي المواشط","https://www.aldiwan.net/poem65000.html","البسيط"],[51,"العدل فرض وبذل الفضل نافلة","https://www.aldiwan.net/poem65892.html","البسيط"],[51,"أساء الرأي أم عزب الرسول","https://www.aldiwan.net/poem65999.html","الوافر"],[85,"بني مصر ارفعوا الغار","https://www.aldiwan.net/poem8078.html","الهزج"],[85,"ضمي قناعك يا سعاد أو ارفعي","https://www.aldiwan.net/poem63709.html","الكامل"],[62,"هي العيس قودا في الأزمة تنفخ","https://www.aldiwan.net/poem52455.html","الطويل"],[45,"معاد من الأيام تعذيبنا بها","https://www.aldiwan.net/poem10908.html","الطويل"],[61,"أكان لقلبه عنك انقلاب","https://www.aldiwan.net/poem51816.html","الوافر"],[66,"أغار الغيث كفك حين جادا","https://www.aldiwan.net/poem38504.html","الوافر"],[97,"مكاني الهادئ البعيد","https://www.aldiwan.net/poem24785.html","مجزوء البسيط"],[67,"إن تحي آمالي برؤية عيسى","https://www.aldiwan.net/poem18073.html","الكامل"],[46,"يغني الفتى ملبس يستره","https://www.aldiwan.net/poem22922.html","المنسرح"],[46,"إذا لم يكن للميت أهل فقلما","https://www.aldiwan.net/poem23364.html","الطويل"],[107,"كوكب السعد بالنجاح أنارا","https://www.aldiwan.net/poem16288.html","الخفيف"],[140,"لا أعذر المرء يصبو وهو مختار","https://www.aldiwan.net/poem58448.html","البسيط"],[183,"أخلآى بالثغر دام الفراق","https://www.aldiwan.net/poem14614.html","المتقارب"],[195,"سباك الجيد والقد","https://www.aldiwan.net/poem39863.html","مجزوء الوافر"],[227,"نعت بالبين غربان","https://www.aldiwan.net/poem50762.html","مجزوء الوافر"],[259,"نعم هذه الزوراء لاحت قصورها","https://www.aldiwan.net/poem38136.html","الطويل"],[302,"قل لأحبابنا بسوح المقام","https://www.aldiwan.net/poem16829.html","الخفيف"],[302,"يا وجيه الدين والكرم","https://www.aldiwan.net/poem16840.html","المديد"],[326,"على شاطىء فوق الحياة تمددت","https://www.aldiwan.net/poem54973.html","الطويل"],[346,"وعيشك لم أكد أسلوه كبشا","https://www.aldiwan.net/poem19902.html","الوافر"],[347,"إن التي سمحت لنا بوصالها","https://www.aldiwan.net/poem15854.html","الكامل"],[456,"يلوم عليك لا عدم الملامه","https://www.aldiwan.net/poem55898.html","الوافر"],[456,"رحِمت قوما وما مالت رقابهم","https://www.aldiwan.net/poem55985.html","البسيط"],[456,"خيلك من صفا لك في البعاد","https://www.aldiwan.net/poem56233.html","الوافر"],[456,"إذا لم يرع عندكم الوداد","https://www.aldiwan.net/poem56241.html","المتقارب"],[477,"تذكرت من أهوى وما كنت ناسيا","https://www.aldiwan.net/poem37062.html","الطويل"],[573,"أضاء بثغرك وادي أضا","https://www.aldiwan.net/poem3054.html","المتقارب"]],"verses":[["وَحَظِّيَ مِنها صابُها دونَ شَهدِها","فَلَو كانَ عِندي شَهدُها ثُمَّ صابُها",0,"ب",3,0],["وَحِظوَةُ السَبقِ لَنا وَالأَلفان","طَعدو بِنا الخَيلُ طُموحَ العِقبان",1,"ن",1,0],["وحظك من قحطان إن كنت منهم","ومن مالك حظ البغي من الحملِ",2,"ل",1,0],["وحظُّ أخي الشيبِ المسوِّدِ شيبَهُ","مقالة أهل الرشدِ غاوٍ مغالط",3,"ط",1,0],["وحظُّ كتّابِك الأشقين أنْ بُخسوا","حقوقهم وهمُ الأوفَونَ أعمالا",4,"ل",2,0],["وحَظّي بالوصالِ إليك حظي","ولكن الوصالَ هو الوصولُ",5,"ل",1,0],["وَحَظٍّ لَيسَ يُعطاهُ","سِوى المَخلوقِ لِلخُلدِ",6,"د",1,0],["وَحَظيرَةً قَد أودِعَت غُرَرَ الدُمى","وَحَظيرَةً مَحرومَةً لَم تودَعِ",7,"ع",1,0],["وحظِّيَ من أيامِ مُلْكٍ بِعِزِّهِ","تُقامُ مواقيتُ العُلَى وتُؤَرَّخُ",8,"خ",1,0],["وَحَظُّكَ مِن لَيلى وَلا حَظَّ عِندَها","سِوى صَدِّها مِن غادَةٍ وَاِجتِنابِها",9,"ب",3,0],["وحظُّ عُداتِه ومُؤَمِّليه","حَرائبُه النفائسُ والحِرابُ",10,"ب",1,0],["وَحَظّي مِن وِدادِكَ غَيرُ نَزرٍ","وَلَكِنّي أُؤَمِّلُ أَن أُزادا",11,"د",2,0],["وحظ شعرٍ إذا أطاع","يا ليته عاش لا يطيع",12,"ع",1,0],["وحَظِيتُ بَعْدَ اليَأْسِ بالخِضرِ الَّذي","ما زالَ يَرْقَى أَوْ حَكَى إدْرِيسا",13,"س",2,0],["وَحَظُّهُ أَن يَكونَ مُنفَرِداً","كَطائِرٍ لا يُراعُ أَينَ سَقَط",14,"ط",1,0],["وَحَظُّكَ فيهِ نَبذَةُ الفيلِ إِن دَنا","إِلَيها نَأَت عَن أَنفِهِ بِالتَشَمُّمِ",15,"م",1,0],["وَحُظوظ إِذا عَتبت عَلَيها","نَسَجت لي مِن الهَوى أَعذارا",16,"ر",2,0],["وحظُّته في العطايا أنَّ راحتَه","بين العُفاةِ وبين الرِّفدِ سُمّارُ",17,"ر",1,0],["وحظُّ العواذلِ من مِسْمَعي","ظواهرُ باطِنُهنّ النفاق",18,"ق",1,0],["وحظّك من هواها الغمّ","والتبريح والسهد",19,"د",1,0],["وحظُّ جميعِ من عادا","ك تنكيلٌ وخُسْران",20,"ن",1,0],["وحظي كيوم حجب الدجن صحوه","وليلة قمر لا ينير منيرها",21,"ر",3,0],["وحظينا بالرد منه ونلنا","كل خير ورغبة ومرام",22,"م",1,0],["وحظيتم بالمراد وبالس","ؤال والمأمول من أمم",23,"م",1,0],["وحظي وقد غسّلته بمدامعي","ولم أحتسب فيه لدى زمني أجرا",24,"ر",2,0],["وحَظّي قَدْ كَبَابي دُونَ حَظِّي","بِعِيدِ النَّحْرِ مِن أَكْلِ الكَبابِ",25,"ب",1,0],["وَحَظيتُ مِنها بِالأَماني واثِقاً","بِوَفائِها مِن غَدرِها وَمَلالِها",26,"ل",3,0],["وحظٍّ لو سألتُ بِلال ريقي","عبابَ البحر صاعبني مَرامَهْ",27,"م",2,0],["وحظُّهم منه حظّ الناقِفاتِ رجتْ","أن يُجتنَى من هبيدِ الحنظلِ العسلُ",28,"ل",1,0],["وحظُّك من صديقك أن تراه","عدوّاً في هواك لمن تعادي",29,"ي",1,0],["وحظُّك من جَنَى فكري ثناءٌ","يطول وطُولهُ فيك اقتصادُ",30,"د",1,0],["وحظي من الأسبوع يوم بنظرة","فأمسيت من شوقي أعد الثوانيا",31,"ي",2,0],["وحظُّكَ للملكِ أَنْ يُصْطَفى","وحظُّ عدوِّك أَن يُرفَضَا",32,"ض",2,0]]}