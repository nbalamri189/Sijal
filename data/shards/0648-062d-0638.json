{"poems":[[55,"أماني نفس ما تناخ ركابها","https://www.aldiwan.net/poem30760.html","الطويل"],[29,"إني امرؤ يبني لي المجد البان","https://www.aldiwan.net/poem4434.html","الرجز"],[39,"رأيتكم من مالك وادعائه","https://www.aldiwan.net/poem7434.html","الطويل"],[53,"بدا الشيب إلا ما تداوي المواشط","https://www.aldiwan.net/poem65000.html","البسيط"],[53,"العدل فرض وبذل الفضل نافلة","https://www.aldiwan.net/poem65892.html","البسيط"],[53,"أساء الرأي أم عزب الرسول","https://www.aldiwan.net/poem65999.html","الوافر"],[87,"بني مصر ارفعوا الغار","https://www.aldiwan.net/poem8078.html","الهزج"],[87,"ضمي قناعك يا سعاد أو ارفعي","https://www.aldiwan.net/poem63709.html","الكامل"],[64,"هي العيس قودا في الأزمة تنفخ","https://www.aldiwan.net/poem52455.html","الطويل"],[47,"معاد من الأيام تعذيبنا بها","https://www.aldiwan.net/poem10908.html","الطويل"],[63,"أكان لقلبه عنك انقلاب","https://www.aldiwan.net/poem51816.html","الوافر"],[68,"أغار الغيث كفك حين جادا","https://www.aldiwan.net/poem38504.html","الوافر"],[99,"مكاني الهادئ البعيد","https://www.aldiwan.net/poem24785.html","مجزوء البسيط"],[69,"إن تحي آمالي برؤية عيسى","https://www.aldiwan.net/poem18073.html","الكامل"],[48,"يغني الفتى ملبس يستره","https://www.aldiwan.net/poem22922.html","المنسرح"],[48,"إذا لم يكن للميت أهل فقلما","https://www.aldiwan.net/poem23364.html","الطويل"],[113,"كوكب السعد بالنجاح أنارا","https://www.aldiwan.net/poem16288.html","الخفيف"],[146,"لا أعذر المرء يصبو وهو مختار","https://www.aldiwan.net/poem58448.html","البسيط"],[189,"أخلآى بالثغر دام الفراق","https://www.aldiwan.net/poem14614.html","المتقارب"],[201,"سباك الجيد والقد","https://www.aldiwan.net/poem39863.html","مجزوء الوافر"],[234,"نعت بالبين غربان","https://www.aldiwan.net/poem50762.html","مجزوء الوافر"],[266,"نعم هذه الزوراء لاحت قصورها","https://www.aldiwan.net/poem38136.html","الطويل"],[309,"قل لأحبابنا بسوح المقام","https://www.aldiwan.net/poem16829.html","الخفيف"],[309,"يا وجيه الدين والكرم","https://www.aldiwan.net/poem16840.html","المديد"],[333,"على شاطىء فوق الحياة تمددت","https://www.aldiwan.net/poem54973.html","الطويل"],[353,"وعيشك لم أكد أسلوه كبشا","https://www.aldiwan.net/poem19902.html","الوافر"],[354,"إن التي سمحت لنا بوصالها","https://www.aldiwan.net/poem15854.html","الكامل"],[463,"يلوم عليك لا عدم الملامه","https://www.aldiwan.net/poem55898.html","الوافر"],[463,"رحِمت قوما وما مالت رقابهم","https://www.aldiwan.net/poem55985.html","البسيط"],[463,"خيلك من صفا لك في البعاد","https://www.aldiwan.net/poem56233.html","الوافر"],[463,"إذا لم يرع عندكم الوداد","https://www.aldiwan.net/poem56241.html","المتقارب"],[484,"تذكرت من أهوى وما كنت ناسيا","https://www.aldiwan.net/poem37062.html","الطويل"],[580,"أضاء بثغرك وادي أضا","https://www.aldiwan.net/poem3054.html","المتقارب"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83310","المنسرح"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126681","المجتث"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86796","الكامل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53992","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64149","الطويل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/71025","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62460","الرمل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62601","الرمل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96647","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96639","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56008","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95513","الكامل"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95510","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/78005","الرجز"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108931","الكامل"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105432","الكامل"],[1910,"","https://poetry.dctabudhabi.ae/diwan/poem/116542","الوافر"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48209","الوافر"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124755","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124780","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124760","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124756","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124782","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124770","الطويل"],[2607,"","https://poetry.dctabudhabi.ae/diwan/poem/34898","الكامل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83239","الوافر"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94255","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93899","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93796","الطويل"],[3305,"","https://poetry.dctabudhabi.ae/diwan/poem/26120","الوافر"],[3337,"","https://poetry.dctabudhabi.ae/diwan/poem/203546","الرجز"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52976","المتدارك"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110063","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109928","الكامل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131975","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91981","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102965","الوافر"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94595","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72464","المتقارب"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72786","الخفيف"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204312","الطويل"],[4679,"إلى الموت يسعى كلُّ من أصلهُ الثرى","https://www.poetsgate.com/ViewPoem.aspx?id=142789",""],[4679,"ألا أيها الصرح الذي تاه من فخر","https://www.poetsgate.com/ViewPoem.aspx?id=142722",""],[4767,"اليانصيب","https://www.poetsgate.com/ViewPoem.aspx?id=180035",""],[5277,"الإلفةُ والآلاف..","https://www.poetsgate.com/ViewPoem.aspx?id=206970",""],[5302,"تسائلني هيفا","https://www.poetsgate.com/ViewPoem.aspx?id=201269",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5358,"عسى ألا غيابَ","https://www.poetsgate.com/ViewPoem.aspx?id=27544",""],[5461,"ساعات العصر","https://www.poetsgate.com/ViewPoem.aspx?id=5230",""],[5582,"لِمَنْ الظُّعْنُ تَرْسُبُ وَالقُبَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=186705",""],[5582,"أَمِنْ ذِكْرِ أَطْلالٍ بِبُرْقَةِ ثَهْمَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=63500",""],[5736,"مواسم الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=208427",""],[5776,"أطوارُ ......عنكبوت الهولوكوست","https://www.poetsgate.com/ViewPoem.aspx?id=199338",""],[5809,"حديث","https://www.poetsgate.com/ViewPoem.aspx?id=205104",""],[5829,"كما كانت بثينة من جميل","https://www.poetsgate.com/ViewPoem.aspx?id=151475",""],[6031,"أَبا هَاشمٍ أُنهِي إليكَ تحيةً","https://www.poetsgate.com/ViewPoem.aspx?id=46265",""],[6115,"ياوجودي وجد من شاف ديّانه","https://www.poetsgate.com/ViewPoem.aspx?id=180482",""],[6116,"غَريبٌ ساءَهُ زَمَنٌ غَريبُ","https://www.poetsgate.com/ViewPoem.aspx?id=145116",""],[6167,"مأتم الهوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85580&r=&rc=63",""]],"verses":[["وَحَظِّيَ مِنها صابُها دونَ شَهدِها","فَلَو كانَ عِندي شَهدُها ثُمَّ صابُها",0,"ب",3,0],["وَحِظوَةُ السَبقِ لَنا وَالأَلفان","طَعدو بِنا الخَيلُ طُموحَ العِقبان",1,"ن",1,0],["وحظك من قحطان إن كنت منهم","ومن مالك حظ البغي من الحملِ",2,"ل",1,0],["وحظُّ أخي الشيبِ المسوِّدِ شيبَهُ","مقالة أهل الرشدِ غاوٍ مغالط",3,"ط",1,0],["وحظُّ كتّابِك الأشقين أنْ بُخسوا","حقوقهم وهمُ الأوفَونَ أعمالا",4,"ل",2,0],["وحَظّي بالوصالِ إليك حظي","ولكن الوصالَ هو الوصولُ",5,"ل",1,0],["وَحَظٍّ لَيسَ يُعطاهُ","سِوى المَخلوقِ لِلخُلدِ",6,"د",1,0],["وَحَظيرَةً قَد أودِعَت غُرَرَ الدُمى","وَحَظيرَةً مَحرومَةً لَم تودَعِ",7,"ع",1,0],["وحظِّيَ من أيامِ مُلْكٍ بِعِزِّهِ","تُقامُ مواقيتُ العُلَى وتُؤَرَّخُ",8,"خ",1,0],["وَحَظُّكَ مِن لَيلى وَلا حَظَّ عِندَها","سِوى صَدِّها مِن غادَةٍ وَاِجتِنابِها",9,"ب",3,0],["وحظُّ عُداتِه ومُؤَمِّليه","حَرائبُه النفائسُ والحِرابُ",10,"ب",1,0],["وَحَظّي مِن وِدادِكَ غَيرُ نَزرٍ","وَلَكِنّي أُؤَمِّلُ أَن أُزادا",11,"د",2,0],["وحظ شعرٍ إذا أطاع","يا ليته عاش لا يطيع",12,"ع",1,0],["وحَظِيتُ بَعْدَ اليَأْسِ بالخِضرِ الَّذي","ما زالَ يَرْقَى أَوْ حَكَى إدْرِيسا",13,"س",2,0],["وَحَظُّهُ أَن يَكونَ مُنفَرِداً","كَطائِرٍ لا يُراعُ أَينَ سَقَط",14,"ط",1,0],["وَحَظُّكَ فيهِ نَبذَةُ الفيلِ إِن دَنا","إِلَيها نَأَت عَن أَنفِهِ بِالتَشَمُّمِ",15,"م",1,0],["وَحُظوظ إِذا عَتبت عَلَيها","نَسَجت لي مِن الهَوى أَعذارا",16,"ر",2,0],["وحظُّته في العطايا أنَّ راحتَه","بين العُفاةِ وبين الرِّفدِ سُمّارُ",17,"ر",1,0],["وحظُّ العواذلِ من مِسْمَعي","ظواهرُ باطِنُهنّ النفاق",18,"ق",1,0],["وحظّك من هواها الغمّ","والتبريح والسهد",19,"د",1,0],["وحظُّ جميعِ من عادا","ك تنكيلٌ وخُسْران",20,"ن",1,0],["وحظي كيوم حجب الدجن صحوه","وليلة قمر لا ينير منيرها",21,"ر",3,0],["وحظينا بالرد منه ونلنا","كل خير ورغبة ومرام",22,"م",1,0],["وحظيتم بالمراد وبالس","ؤال والمأمول من أمم",23,"م",1,0],["وحظي وقد غسّلته بمدامعي","ولم أحتسب فيه لدى زمني أجرا",24,"ر",2,0],["وحَظّي قَدْ كَبَابي دُونَ حَظِّي","بِعِيدِ النَّحْرِ مِن أَكْلِ الكَبابِ",25,"ب",1,0],["وَحَظيتُ مِنها بِالأَماني واثِقاً","بِوَفائِها مِن غَدرِها وَمَلالِها",26,"ل",3,0],["وحظٍّ لو سألتُ بِلال ريقي","عبابَ البحر صاعبني مَرامَهْ",27,"م",2,0],["وحظُّهم منه حظّ الناقِفاتِ رجتْ","أن يُجتنَى من هبيدِ الحنظلِ العسلُ",28,"ل",1,0],["وحظُّك من صديقك أن تراه","عدوّاً في هواك لمن تعادي",29,"د",2,0],["وحظُّك من جَنَى فكري ثناءٌ","يطول وطُولهُ فيك اقتصادُ",30,"د",1,0],["وحظي من الأسبوع يوم بنظرة","فأمسيت من شوقي أعد الثوانيا",31,"ي",2,0],["وحظُّكَ للملكِ أَنْ يُصْطَفى","وحظُّ عدوِّك أَن يُرفَضَا",32,"ض",2,0],["وَحَظُّ جَيشٍ لِيَ النِداءُ غَدَت","في اللَوحِ مَكتوبَةٌ لَهُ الأَجرُ",33,"ر",1,0],["وحظّكم كلّ يوم","ميمٌ ودالٌ وحاءُ",34,"ا",2,0],["وَحَظى بِحَزمك في المحرّم منصب","مِن دُونه أَوج العُلا وَالسؤدد",35,"د",1,0],["وحَظَّ نفسِكَ دْع لله مُحتسِباً","قَبْلَ المماتِ وأعْطِ الحقَّ مِنْ طَلَبَهْ",36,"ب",2,0],["وحظِّيَ من نَقْلٍ إذا ما نَعَتُّهُ","نعتُّ لعمري منه أحْسَنَ منعوتِ",37,"ت",1,1],["وحظك والجيشُ الخميسُ العَرمْرَمُ","وواليك مسعود الكريمُ المكرَّمُ",38,"م",1,0],["وحظوظ الناس شتّى منهم","من إذا استيقظ للعَليا رَقَدْ",39,"د",1,0],["وحظوظ الناس جنس","نوعها فرد وزوجُ",40,"ج",1,0],["وحظّي مع البيضِ الكواعب أبيضٌ","مُضافٌ إِلى لونٍ من الشعرِ أبيضِ",41,"ض",1,0],["وَحظيتُ منه بوصلِ عيشٍ ناعمٍ","مِن بعدِ عيشٍ في المعيشةِ أنكدا",42,"د",2,0],["وحظوظ مولانا البشير أبي السطا","قد عرقلت خطواتهم في طرقهمْ",43,"م",1,0],["وحظى بأشرف بقعة فضلت","كل الدُّنا ولسانُها جهرَا",44,"ر",2,0],["وحظيتُ بالرجل العظ","يمِ المرتقى متن السِّماك",45,"ك",1,0],["وحظهم من ربهم وافر","حمد وشكر في الحشا مستقر",46,"ر",1,0],["وحظيت من بعد اليمين بخلوةٍ","لا القس باركها ولا المطران",47,"ن",1,0],["وحظوا بأقصى كل مكرمةٍ غدت","لهم افاصيهن غير أقاصي",48,"ص",2,0],["وحظّكم الصدور من النوادي","وحظّ سواكم منها الزوايا",49,"ا",3,0],["وحظيتُ حين لَثَمْتُ جَنَّةَ وجنةٍ","وشربتُ حين رشفت فاهُ كوثرا",50,"ر",2,0],["وحظر الغناء الأكثرون قضوا به","وعن أبوي بكر إمام ومقتد",51,"د",1,0],["وحظر الهجا والمدح بالزور والخنا","وتشبيه بالأجنبيّات أكّد",51,"د",1,0],["وحظّر عليه الارتشا وقبوله","وأنت لدفع الظلم فارش لتفتدي",52,"د",2,0],["وحظر بلا خلف سفار بمصحف","لدار حروب مثل تمليك ملحد",53,"د",1,0],["وحظر انتفا التسليم فوق ثلاثة","على غير من قلنا بهجر فأكد",54,"د",1,0],["وحظر على الذكران ما نسجوه من","لجين وعين غالب أو مصرّد",55,"د",1,1],["وحظر شهادات الفتى بسوى الذي","بأوقات الاسترعاء بعلمه قد",56,"د",1,0],["وَحَظِيَّةٍ فيها العَطَب","غالَيتُ فيها بِالعَطَب",57,"ب",1,1],["وَحَظٌّ وافِرٌ وَغِنىً وَجاهٌ","وَنَيلُ مَقاصِدٍ في المُقبِلاتِ",58,"ت",1,0],["وحظوتك ازدادت به حيث أرخوا","زيادة اسماعيل بهجة مصطفى",59,"ف",2,0],["وحظينا منه بطلعة حسن","وقيت شر ما به النفس غرت",60,"ت",1,0],["وحظ سما فوق السماكين حظوه","وسامي العلا فخراً بأسعد مسعد",61,"د",1,0],["وَحَظُ ابنِ المُراغَةِ مِن تَميمٍ","كَحَظِّ الزانياتِ مِنَ الفُحولِ",62,"ل",1,0],["وحظنا من علمه التّعظيمُ","وصحة الايمان والتسليمُ",63,"م",1,0],["وحظوظُ الشهرةِ أحرزتم","وبها امتزتم بين الأقران",64,"ن",1,0],["وحَظِي منكِ مادحٌ بقَبُول