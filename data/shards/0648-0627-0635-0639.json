{"poems":[[55,"سليمان لو وفيت مدحي حقه","https://www.aldiwan.net/poem30649.html","الطويل"],[73,"أشاقك من عليا دمشق قصورها","https://www.aldiwan.net/poem4027.html","الطويل"],[29,"ألا حي ليلى إذ أجد اجتنابها","https://www.aldiwan.net/poem5681.html","الطويل"],[49,"يعز على الأحبة بالشآم","https://www.aldiwan.net/poem25139.html","الوافر"],[91,"تقدمت الاقوام مسرعة تجري","https://www.aldiwan.net/poem44885.html","الطويل"],[87,"اخترت يوم الهول يوم وداع","https://www.aldiwan.net/poem62860.html","الكامل"],[64,"اسعد بيوم قد أتاك مبكرا","https://www.aldiwan.net/poem52391.html","الكامل"],[47,"أرى بين ملتف الأراك منازلا","https://www.aldiwan.net/poem65533.html","الطويل"],[82,"أراك ركبت في الأهوال بحرا","https://www.aldiwan.net/poem31572.html","الوافر"],[33,"أفي رسم دار دارس أنت واقف","https://www.aldiwan.net/poem42225.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39553","الرمل"],[34,"","https://poetry.dctabudhabi.ae/diwan/poem/8248","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42563","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54284","الخفيف"],[33,"أَفي رَسْمِ دَارِ دَارِسٍ أَنْتَ وَاقِفُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18959&r=&rc=222",""],[189,"أخلآى بالثغر دام الفراق","https://www.aldiwan.net/poem14614.html","المتقارب"],[193,"الحمد لله الغني الأحد","https://www.aldiwan.net/poem35111.html","الرجز"],[242,"أملى الهنا والسعد ردد","https://www.aldiwan.net/poem18140.html","مجزوء الكامل"],[254,"ألا بان الخليط ولم يزاروا","https://www.aldiwan.net/poem2119.html","الوافر"],[275,"قضى الدهر أن أهواك غير ممتع","https://www.aldiwan.net/poem35621.html","الطويل"],[286,"أمشرفي بصفاته وحلاه","https://www.aldiwan.net/poem1400.html",""],[287,"كفى حزنا أني من الشوق لم أنم","https://www.aldiwan.net/poem32426.html","الطويل"],[310,"إلهي ذنوبي ما علمت وإنني","https://www.aldiwan.net/poem56602.html","الطويل"],[325,"ذريني وشأني والعفاف فإنني","https://www.aldiwan.net/poem61767.html","الطويل"],[371,"وإذا السعادة لا حظتك عيونها","https://www.aldiwan.net/poem17832.html","الكامل"],[443,"خف القطين وبان الرائح الغادي","https://www.aldiwan.net/poem2619.html","البسيط"],[457,"حيا دمشق فكم فيها لذي وطر","https://www.aldiwan.net/poem13761.html","البسيط"],[466,"سهرت ونام عن سهري رجال","https://www.aldiwan.net/poem15455.html","الوافر"],[482,"حمام بأعلى الجلهتين ينوح","https://www.aldiwan.net/poem15261.html","الطويل"],[484,"يا أمة شهد الكتاب بفضلها","https://www.aldiwan.net/poem37623.html","الكامل"],[487,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[520,"تناولت المكارم والمساعي","https://www.aldiwan.net/poem12173.html","الوافر"],[534,"وأصعب ما يلاقي المرء شغل","https://www.aldiwan.net/poem37287.html","الوافر"],[672,"","https://poetry.dctabudhabi.ae/diwan/poem/102039","الطويل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34422","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48785","الوافر"],[1005,"","https://poetry.dctabudhabi.ae/diwan/poem/119360","الطويل"],[1052,"","https://poetry.dctabudhabi.ae/diwan/poem/130884","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56336","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136192","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136160","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137846",""],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79990","الطويل"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114035","البسيط"],[2003,"","https://poetry.dctabudhabi.ae/diwan/poem/136897","الرمل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27791","الطويل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77276","الكامل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137362",""],[2799,"","https://poetry.dctabudhabi.ae/diwan/poem/121142","الرمل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58438","الطويل"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79710","الوافر"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3451,"","https://poetry.dctabudhabi.ae/diwan/poem/123481","الطويل"],[3488,"","https://poetry.dctabudhabi.ae/diwan/poem/28824","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108108","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117858","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113831","الطويل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204300","الطويل"],[4767,"تجارة خاسرة","https://www.poetsgate.com/ViewPoem.aspx?id=179991",""],[4767,"مصعد الأحوال","https://www.poetsgate.com/ViewPoem.aspx?id=180769",""],[4935,"لاحت لعيني زهرة الزوراء","https://www.poetsgate.com/ViewPoem.aspx?id=129285",""],[5057,"الداعشيّ .","https://www.poetsgate.com/ViewPoem.aspx?id=184237",""],[5118,"تلاوة حكيمة","https://www.poetsgate.com/ViewPoem.aspx?id=130106",""],[5147,"أضر بجسمي عرق النسا","https://www.poetsgate.com/ViewPoem.aspx?id=166690",""],[5183,"نَبْعُ الفضلِ","https://www.poetsgate.com/ViewPoem.aspx?id=186454",""],[5431,"إني أحبك","https://www.poetsgate.com/ViewPoem.aspx?id=191707",""],[5447,"إلى حنظلة","https://www.poetsgate.com/ViewPoem.aspx?id=208326",""],[5493,"جالس أصحاب المقام","https://www.poetsgate.com/ViewPoem.aspx?id=206622",""],[5593,"إذا لم يكن للمرء بد من الردى","https://www.poetsgate.com/ViewPoem.aspx?id=181063",""],[5596,"وادي محرم","https://www.poetsgate.com/ViewPoem.aspx?id=206487",""],[5612,"حجُّ القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=205711",""],[5917,"الحمد لله هذا العين لا الأثر","https://www.poetsgate.com/ViewPoem.aspx?id=106533",""],[5943,"أكثرْ من اللذات","https://www.poetsgate.com/ViewPoem.aspx?id=92977",""],[5956,"سأهتف","https://www.poetsgate.com/ViewPoem.aspx?id=192373",""],[6093,"الله أهل للثناء","https://www.poetsgate.com/ViewPoem.aspx?id=197948",""],[6124,"يا ابنة الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=101248",""]],"verses":[["وَأَصعَبتَ لي مِن بَعدِ ما كُنتَ مُسهِلاً","مَغالِقَ بِرٍّ شارَفَت تَتَفَتَّحُ",0,"ح",1,0],["وَأَصعَبُ ما يلقى المُحِبُّ مِنَ الهَوى","تَداني النَوى مِن خُلَّةٍ لا يَزورُها",1,"ر",3,0],["وَأَصعَرَ ذي صادٍ شَفَيتُ بِصَكَّةٍ","عَلى الأَنفِ أَو بِالحاجِبَينِ مَصابُها",2,"ب",3,0],["وَأَصعَبُ خُطَّةٍ وَأَجَلُّ أَمرٍ","مُجالَسَةُ اللِئامِ عَلى الكِرامِ",3,"م",1,0],["واصعب من قيد ثقيل حديده","على الرجل اقياد ثقال على الفكر",4,"ر",1,0],["وَاِصعَدَ سَماءَ الذِكرِ مِن أَسبابِها","وَاِظهَر بِفَضلٍ كَالنَهارِ مُذاعِ",5,"ع",1,0],["وَاصعَد إِلى درجِ العُلَى متمهِّلا","واسلم على غِيَرِ الزمان معمَّرا",6,"ر",2,0],["وَأَصعَدَ موسى في السَماءِ فَلَم يَجِد","بِها مَهرَباً مِنهُ فَأَقبَلَ نازِلا",7,"ل",2,0],["وأصعبُ من ركوبِ البحر عندي","أُمُورٌ ألجأتكَ إلى ركوبه",8,"ب",2,0],["وَأَصعَدنَ في وَعثِ الكَثيبِ تَأَوُّداً","كَما اِجتازَ في الوَحلِ النِعاجُ الخَوارِفُ",9,"ف",1,0],["واصعقوا قُنَّةَ واديه الرفيعْ","تتهدمْ تحت أقدامِ الرياحْ",10,"ح",1,0],["وَأَصعَدنَ في سَرّاءَ حَتّى إِذا اِنتَحَت","شَمالاً نَحا حاديهِمُ لِيَمينِ",11,"ن",1,0],["وَأَصْعَبُ مَا يَلْقَى الْفَتَى فِي زَمَانِهِ","صَحَابَةُ مَنْ يَشْفِي مِنَ الدَّاءِ فَقْدُهُ",12,"د",2,0],["وَاصْعَدِ الْجَوَّ للسَّمَوَاتِ وَانْقُلْ","لُغَةَ الْخُلْدِ إِنْ مَلَكْتَ صُعُودا",13,"د",2,0],["وأصعدنَ في وعثِ الكثيب تأوداً،","كَمَاکجْتَازَ في الوَحْلِ النِّعَاجُ الخَوَارِفُ",14,"ف",1,0],["وأصعبُ ما حاولتْه النفوسُ","من الأمر تكليف ما لا يُطاق",15,"ق",1,0],["واِصعد بِها لذروة الفضائلِ","تَشهد علا هذا النبيِّ الكاملِ",16,"ل",1,0],["وَاصْعَدْ أَمِيرَ الْمُؤْمِنِي","نَ وَدُمْ قَرِيرَ الْعَيْنِ وَاسْعَدْ",17,"د",1,0],["وَأَصعَدَتِ الرِبابُ فَلَيسَ مِنها","بِصاراتٍ وَلا بِالحَبسِ نارُ",18,"ر",1,0],["وأصعبُ شيءٍ فرقةٌ بعد إلفةٍ","فكم مهجةٍ منها تسيلُ بمدمع",19,"ع",1,0],["واصعدْ مراتب متقٍ أو مرتقٍ","تجري الكواكبُ رفعة لعلاه",20,"ا",2,0],["وَأَصعَبُ مِن هَذا وَذاكَ ورودُ مَن","يُحاوِلُ حالاً في مُجاذَبَةِ التُّهَم",21,"م",1,0],["وَأصعب ما لاقيت خطبٌ زواله","على أنّه سهل من الخطب أصعبُ",22,"ب",1,0],["وَأَصعَبُ مَن قَطَعِ اليَدَينِ عَلى الفَتى","سُؤالٌ لَئيمٌ يَزدَريكَ إِذا غَنّى",23,"ن",2,0],["وَأَصعَبُ مِنهُ ذِلَّةً وَمَضاضَةً","صَنيعَةَ بَرِّ نالِها مِن يَدي دَني",23,"ن",2,0],["وَاِصعَد بِها العَنقاءَ فَهيَ حِبالَهُ","وَاِقتَد بِها الجَوزاءَ فَهيَ عِنانُ",24,"ن",1,0],["وأصعق الكفر حتى ذلّ جانبهُ","والأرض قد آذنت منه بإلحاد",25,"د",1,0],["واصعد ذرى السفح وأنشد فيه مدكراً","عهود أُنس مضت في سالف العمر",26,"ر",1,0],["وأصعبِهمْ إِذا يلقى نِزالاً","وأسْهلِهمْ إِذا يُغْشى حجابا",27,"ب",2,0],["وأصعبُ ما يُمنَى به الصبُّ في الهوى","عذولٌ على أحبابِه ونصيحُ",28,"ح",1,0],["واصعد لمرقاة العلا متدرجا","فيها وحاذر طفرة الإرهاس",29,"س",1,0],["وأصعن موسى العزم لما","مراسمه لما تبدى بأفنان",30,"ن",1,0],["وأصعب نائبات الدهر عندي","فجيعة فرقة بعد اجتماع",31,"ع",1,0],["وأَصْعَبُ ما يُلاقِي المْرءُ شُغْلٌ","بَغِيضٌ لا يُطِيقُ لَهُ فِراقا",32,"ق",2,1],["واصعد في السر الدليلان موهناً","يجران نجم النعش جر قطار",33,"ر",1,0],["وَأَصعبُ مِن لوم العَواذلِ قولهم","هوَ الحُبُّ فاِسلم بِالحَشا ما الهَوى سهلُ",34,"ل",1,0],["وأصعب ما تعالج من رجال","شعورهم إذا اختل الشعور",35,"ر",1,0],["وأصعب من كور الكروب وحورها","محاورة تؤذي قلوب الأكارم",36,"م",1,0],["وأصعب ما ألقى رئاسة ناقص","مساويه إن عُدَّت كثيرٌ قليلها",37,"ل",3,0],["وأصعد إلى ذلك الطود الرفيع وقف","بموقفٍ ينفي الأكدار والقلقا",38,"ق",2,0],["واصعد على منبر التحقيق محتملا","مشقة العزم في تحقيق اطواري",39,"ر",2,0],["واصعد على منبرود","القرب فيمن قد صعد",40,"د",1,0],["واصعد الى الطالع بالصدر وفي","غايته ختم بقطة يفي",41,"ي",1,0],["واصعد مقوساً وقف بالقط","واخرج قليلا عن علوّ الخطِّ",41,"ط",1,0],["واصعد بسنه لرأسٍ وانزلِ","بما به بدأتهُ وكملِ",41,"ل",1,0],["واصعد كقدر ما خسفتَ فيه","ليسرةٍ ودُر الى التشبيه",41,"ه",1,0],["واصعب شيء عنده منع فضله","واهون شيء اني حل لك الصعبا",42,"ب",2,0],["وأصعبُ حربٍ منه يومَ صروفُه","من الشرف السَّامي ارتقت مرتقًى صعبا",43,"ب",2,0],["وأصعدوا في ذراها ثم أرهقهم","إلى النوازل والأخطار إنزالُ",44,"ل",1,0],["واصعد الأعراف وانظر سقرا","وهي ترغو بجموع المجرمين",45,"ن",1,0],["وأصعقهم وحيٌ من الله جاءهم","فلما أفاقوا قلت ماذا فقال دا",46,"د",2,0],["وَاِصعَد إِلى جَوِّ الغَمامِ لِصَرفِهِ","عَن زَرعِنا لَكِن يَعوزُكَ سُلَّمُ",47,"م",1,0],["واصعد إلى العليا فان يكن الورى","أفقا فلست أراك الافرقدا",48,"د",2,0],["واصعقي إن شئت شوقاً","فجناب الموت أهدا",49,"د",2,0],["وأصعَبُ ما لاقيتُ بعدَ فِراقه","مقالَ الذي إن قلتُ آه يَقُلْ مَشِّي",50,"ش",2,0],["وأصعد للسماء بها اعتزازاً","وأهوى للثرى بعد الصعود",51,"د",1,0],["واصعد الى مقابر الهزازه","فيها اطار الهمداني بازه",52,"ه",1,0],["وأصعب شيء فقر ثم مذلة","فلذ بهما تكن كبير الولاية",53,"ه",1,0],["وَأَصعَدَتِ الحُطّابُ حَتّى تَقارَبوا","عَلى خُشُبِ الطَّرفاءِ فَوقَ العَواقِرِ",54,"ر",1,0],["واصعب من هذا على قلب هائم","بعاد ولم يبرح سبيل إلى القرب",55,"ب",1,0],["واصعب ما تنقاد للمجد والعلى","وأقرب شيء عن غناها نفورها",56,"ر",3,0],["وأَصعبُ ما لاقيتُ أَني قانعٌ","من الطيفِ مُذْ بنتمْ بزورٍ من الزورِ",57,"ر",1,0],["وأصعب من قطع اليمين على الفتى","جنايته حرا إساءة مؤمن",58,"ن",1,0],["وأصعبه ما جاءه وهو رائع","تطيف به اللذات والحظ مسعد",59,"د",1,0],["واصعد كغيرك شاهقاً","واشهر بحقدك نصلكا",60,"ك",2,0],["واصعد برجليك السلالم كلها","حتى تذوق مرارة الإذلال",61,"ل",1,0],["واصعد إلى العلم المعرف والذرى","في كل صبح طالع ومساء",62,"ا",2,0],["واصعد إلى اللهِ في ثوبٍ تُلطِّخهُ","دِمَاءُ مَن قلتَ عنهم أنّهم كفروا",63,"ر",3,0],["واصعب من احساس الأماكن بلا أيّ","__________ روحٍ تعيش ابها ./ وطيفٍ يسيّل",64,"ل",1,0],["واصعدت شأنك وهو الوضيع","عن أفقه لعنان السما",65,"ا",1,0],["واصعد إلى أوج السماء بسلم","تُسلم إليك زمامها الخضراء",66,"ا",2,0],["وأصعب الحكم أنْ لابردَ يسعفه","من حرقة الهجر إنْ في حبه انتكسا",67,"س",2,0],["واصعد على أفق الخيال بنظرةٍ","تُنسيكَ أنكَ تحت خيمة مهزلة",68,"ل",2,0],["وَاصْعدْ منَ القاعِ الذِي فِي غوْرِهِ","ضاعَ الحَصيفُ بعقلِه بينَ الزِّحامْ",69,"م",1,0],["وأصعبه ما جاءه وهو راتع","تطيف به اللذات، والحظ مسعد",70,"د",1,0],["واصعد إلى (مَحْرَم) الغرّاء مبتدراً","شُمَّ الجبال وعرِّجْ للسماوات",71,"ت",1,0],["واصْعدْ إلى عرفاتِ واسْجُدْ واقْترِبْ","وصِلِ الرَّجا بالحمْدِ والشُّكْرانِ",72,"ن",1,0],["وأصعب الداء داء لا يحس به","كالدق يضعف حساً وهو يستعر",73,"ر",1,0],["واصعدْ إلى فوقَ السحابِ تعجرفا","واكتبْ كلاما كلُّهُ زورٌ بزورْ",74,"ر",1,0],["وأصعق صعقاً جميلاً بحالٍ","جديدٍ غريبٍ غِذاهُ الفنونُ",75,"ن",1,0],["واصعدْ بنفسكَ حين تَطلب رغبَةً","بسؤالِ مَنْ يَهبُ الجزيلَ صريحَا",76,"ح",2,0],["واصعدي نحو الخلودِ","صوبَ يومٍ للقيامِ",77,"م",1,0]]}