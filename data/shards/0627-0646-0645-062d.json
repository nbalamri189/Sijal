{"poems":[[9,"إن محلا وإن مرتحلا","https://www.aldiwan.net/poem21975.html","المنسرح"],[53,"ما القلب في إثرهم بمختطف","https://www.aldiwan.net/poem65441.html","المنسرح"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202538","الرجز"],[215,"قد قضينا في العيد يوما سعيدا","https://www.aldiwan.net/poem46224.html","الخفيف"],[422,"ما لها تطوي فيافي الأرض سيرا","https://www.aldiwan.net/poem53994.html","الرمل"],[563,"إن محسوسات الحواس الظواهر","https://www.aldiwan.net/poem34517.html","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38484","السريع"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38132","الخفيف"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145976","مجزوء الخفيف"],[3727,"","https://poetry.dctabudhabi.ae/diwan/poem/124071","الخفيف"],[3779,"","https://poetry.dctabudhabi.ae/diwan/poem/132062","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139709",""]],"verses":[["إِنَّ مَحَلّاً وَإِنَّ مُرتَحِلاً","وَإِنَّ في السَفرِ ما مَضى مَهَلا",0,"ل",2,1],["إن محل الأنيس بعدهم","للمرء ذي السن شرُّ معتكف",1,"ف",1,0],["إن محمدا على الشيخ افترى","وجرأ الناس عليه واجترى",2,"ر",2,0],["إن محراب حسنها في حياتي","معبد عنده يطيب السجود",3,"د",1,0],["إنَّ محمود السجايا قد غدا","في صروف الدهر لي عوناً وذخرا",4,"ر",2,0],["إن محسوسات الحواس الظواهرْ","إن معقولات العقول البواهرْ",5,"ر",1,1],["إِنّ مُحَيّاه لروضِ البَها","شاكي السّلاحِ خشيَةَ النّاسِ",6,"س",1,1],["إِنّ مَحسوبَكَ الّذي بِكَ يَسمو","لا تُؤاخِذْه لو هَفا أيَّ هَفوِ",7,"و",1,1],["أنَّ مُحتلكَ الذي","(حرَّرَ) الأرضَ مُحسِنُ",8,"ن",1,0],["ان محض الجفاء ان لا تحيا","أو تحيا بغير سفح الدموع",9,"ع",1,0],["إن محا حسنك التراب فما للدمع","يوماً من صحن خدي انمحاء",10,"ا",2,0],["إن محمداً إمام البُلغا","مَن فضلُه في كل علمٍ بزغا",11,"غ",2,1]]}