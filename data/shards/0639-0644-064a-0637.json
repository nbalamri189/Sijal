ج من المولى القريب","https://www.aldiwan.net/poem54637.html","عموديه"],[404,"أشير وإن كنت لا تقبلا","https://www.aldiwan.net/poem34176.html","المتقارب"],[417,"ويوم وقفنا دون أسنمة النقا","https://www.aldiwan.net/poem53880.html","الطويل"],[417,"بحيث انعطف البان","https://www.aldiwan.net/poem54026.html","الهزج"],[442,"لهذا خلقنا والجديد سيخلق","https://www.aldiwan.net/poem14465.html","الطويل"],[444,"سلام على شيخ المشايخ أحمد","https://www.aldiwan.net/poem56037.html","عموديه"],[465,"سرت زينب والبرق مبتسم الثغر","https://www.aldiwan.net/poem3392.html","عموديه"],[501,"تبوأ إذا ضاق الخناق ظلالنا","https://www.aldiwan.net/poem37644.html","الطويل"],[501,"نحن شموس الحضرة المشعشعه","https://www.aldiwan.net/poem37973.html","الرجز"],[501,"طيبوا بنا نحن طيب","https://www.aldiwan.net/poem38079.html","المجتث"],[559,"وجودي جل عن جسمي","https://www.aldiwan.net/poem34248.html","الهزج"],[559,"وجود وأشيا ما لهن وجود","https://www.aldiwan.net/poem34627.html","الطويل"]],"verses":[["على طاهر الأرحام ضلّت منوطَة","ومن صالح تذرى إلى صلب مرسل",0,"ل",1,0],["عَلَيَّ طِعانٌ يَرُدُّ الجَوا","دَ بِالدَمِ أَلمى مَكانَ الرَثَم",1,"م",1,0],["عَلَيَّ طُروقُ وِردِكُمُ","وَلَيسَ عَلَيَّ أَن أَرِدا",2,"د",2,0],["عَلى طَلَلٍ كَتَوشِعِ اليَماني","أَمَحَّ فَخالَطَ البيدَ القَواءَ",3,"ا",2,0],["عَلى طَلَلٍ لَو أَنَّهُ كانَ قَبلَهُ","تَكَلَّمَ رَسمٌ دارِسٌ لَتَكَلَّما",4,"م",2,0],["عَلى طُرُقٍ كَنُحورِ الرِكا","بِ تَحسَبُ آرامَهُنَّ الصُروحا",5,"ح",2,0],["على طُرُقٍ فيها على الطُّرْقِ رِفْعَةٌ","وَفي ذِكرِها عِندَ الأنيسِ خُمُولُ",6,"ل",1,0],["عَلى طاعَةٍ لَو أَنَّ أَجبالَ طَيِّئٍ","عَمَدنَ لَها وَالهَضبَ هَضبَ التَهائِمِ",7,"م",1,0],["على طَلعةِ الجَدِّ نَغنَى بها","عن الصُّبحِ في اللَّيلةِ الدَّاجِيه",8,"ي",2,0],["عَلى طولِ ما قالَ الوُشاةُ وَخَبَّبَت","حُقودُ الأَعادي بَينَنا وَالسَخائِمُ",9,"م",1,0],["عَلى طَرَفِ العيسِ قَد حَدَّقَت","إِلَيهِ المَنايا وَكادَت تَثِب",10,"ب",1,0],["على طُرُقِ القَنا للموْتِ منه","إلى مُهجِ العِدا أبدا دَبيبُ",11,"ب",1,0],["عَلَيَّ طِلابُ الْعِزِّ مِنْ مُسْتَقَرِّهِ","وَلا ذَنْبَ لِي إِنْ عَارَضَتْنِي الْمَقَادِرُ",12,"ر",1,0],["عَلَيَّ طِلابُ المَجدِ مِن مُستَقِرِّهِ","وَلا ذَنبَ لي إِن حارَبَتني المَطالِبُ",13,"ب",1,0],["على طيفكم أغمضت عيني والتقى","صيانا له في مقلتي الهدب والهدب",14,"ب",1,0],["على طلل كتوشيع اليماني","امح فخاً لط البيد القواء",15,"ا",2,0],["على طَفْلةٍ عَبْلا السَوَاعد بَضّة","وَتَقْتُلُ أسادَ الوَغَى لَحَظَاتُها",16,"ت",3,0],["على طمرٌ كأن نواظره","يقرأ ما اضمرت له كبدي",17,"د",2,0],["على طولِ عَهدي بالدّيارِ تَشوقُني","مَحاسِنُ فيها قارَنت حَسنات",18,"ت",1,0],["علىطول آمال كثير غرورها","ونسيان موت وهو أقرب غائب",19,"ب",1,0],["على طه البشير بكل خير","ختام الرسل والهادي الدليل",20,"ل",1,0],["عَلى طَريقٍ كَظَهرِ الأَيمِ مُطَّرِدٍ","يَهوي إِلى قُنَّةٍ في مَنهَلٍ عالي",21,"ل",2,0],["عَلى طَرفِكَ بُرهانُ","بقَتلي فهوَ سَكرانُ",22,"ن",1,1],["عَلى طُرُقٍ عِندَ اليَراعَةِ تارَةً","تُوازي شَريمَ البَحرِ وَهوَ قَعيدُها",23,"د",3,0],["على طه المشفع في البرايا","وأصحابه مع الأنصار والآل",24,"ل",1,0],["على طه المشفع في البرايا","وآله والصحاب أهل القلوب",25,"ب",1,0],["على طلب العلم في رغبة","بلا ملل لتسود الملا",26,"ا",1,0],["على طلل ظامٍ إلى ريِّ أهْله","تَصُبُّ عليه الماقيانِ ذنوبا",27,"ب",2,0],["على طلْعَته الغرّاء","للإقبال عنوان",28,"ن",1,0],["على طاعة الرحمن شابت وأيفعت","وكانت على طاعاته قبل تزهق",29,"ق",1,0],["على طاهر الأذيال ذيل قميصه","وتبانه والطيلسان مع البند",30,"د",1,0],["على طول ما أبكت جفوني صبابة","وما أضحكت بالشّيب رأسي من الصبر",31,"ر",1,0],["على طور طه المصطفى وخلاله","نسقنا اتَّباعاً طورنا وخلالنا",32,"ن",2,0],["على طُوى القُلوبِ من أَلبابِنا","صُقورُ عزمٍ قد كشَفْنَ المَقْنَعَهْ",33,"ع",2,0],["على طريقِ الرِّفاعِي","زمزَمْتُ في اللهِ رَكْبي",34,"ب",2,0],["على طه رسول الل","ه نور الفرض والنفل",35,"ل",1,0],["على طبق ما في العلم والعلم واحد","قديم بأشيا ما لهن نفود",36,"د",1,0]]}