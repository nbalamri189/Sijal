ا راكباً جلعداً وجناء عيهلة","https://www.poetsgate.com/ViewPoem.aspx?id=128816",""],[5408,"أحزان سندسية","https://www.poetsgate.com/ViewPoem.aspx?id=190869",""],[5431,"وصلّت مع الضحكة التاسعة","https://www.poetsgate.com/ViewPoem.aspx?id=197802",""],[5470,"خضاب القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=10979",""],[5539,"على الله","https://www.poetsgate.com/ViewPoem.aspx?id=199247",""],[5561,"على قارعة الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=195028",""],[5582,"دَعِينِي وَيْكِ عاذِلَتِي دَعِينِي","https://www.poetsgate.com/ViewPoem.aspx?id=187306",""],[5718,"جواد العز","https://www.poetsgate.com/ViewPoem.aspx?id=213871",""],[5770,"على اليرموك","https://www.poetsgate.com/ViewPoem.aspx?id=178268",""],[5841,"وظلم ذوي القربى اشد المظالم","https://www.poetsgate.com/ViewPoem.aspx?id=35213",""],[5843,"أهم إحساسي","https://www.poetsgate.com/ViewPoem.aspx?id=51299",""],[5937,"لاهوتُ الحُب","https://www.poetsgate.com/ViewPoem.aspx?id=211812",""],[5950,"الصمت والمينا ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128119",""],[6070,"الارض الحنون","https://www.poetsgate.com/ViewPoem.aspx?id=187861",""],[6115,"اثار الغشيم اخذ النصيحه عداوه","https://www.poetsgate.com/ViewPoem.aspx?id=196482",""],[469,"سرت زينب والبرق مبتسم الثغر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574816",""],[391,"ألاَ إنَّ هتداً أمسِ رثَّ جديدها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=16117&r=&rc=2",""]],"verses":[["على طاهر الأرحام ضلّت منوطَة","ومن صالح تذرى إلى صلب مرسل",0,"ل",1,0],["عَلَيَّ طِعانٌ يَرُدُّ الجَوا","دَ بِالدَمِ أَلمى مَكانَ الرَثَم",1,"م",1,0],["عَلَيَّ طُروقُ وِردِكُمُ","وَلَيسَ عَلَيَّ أَن أَرِدا",2,"د",2,0],["عَلى طَلَلٍ كَتَوشِعِ اليَماني","أَمَحَّ فَخالَطَ البيدَ القَواءَ",3,"ا",2,0],["عَلى طَلَلٍ لَو أَنَّهُ كانَ قَبلَهُ","تَكَلَّمَ رَسمٌ دارِسٌ لَتَكَلَّما",4,"م",2,0],["عَلى طُرُقٍ كَنُحورِ الرِكا","بِ تَحسَبُ آرامَهُنَّ الصُروحا",5,"ح",2,0],["على طُرُقٍ فيها على الطُّرْقِ رِفْعَةٌ","وَفي ذِكرِها عِندَ الأنيسِ خُمُولُ",6,"ل",1,0],["عَلى طاعَةٍ لَو أَنَّ أَجبالَ طَيِّئٍ","عَمَدنَ لَها وَالهَضبَ هَضبَ التَهائِمِ",7,"م",1,0],["على طَلعةِ الجَدِّ نَغنَى بها","عن الصُّبحِ في اللَّيلةِ الدَّاجِيه",8,"ي",2,0],["عَلى طولِ ما قالَ الوُشاةُ وَخَبَّبَت","حُقودُ الأَعادي بَينَنا وَالسَخائِمُ",9,"م",1,0],["عَلى طَرَفِ العيسِ قَد حَدَّقَت","إِلَيهِ المَنايا وَكادَت تَثِب",10,"ب",1,0],["على طُرُقِ القَنا للموْتِ منه","إلى مُهجِ العِدا أبدا دَبيبُ",11,"ب",1,0],["عَلَيَّ طِلابُ الْعِزِّ مِنْ مُسْتَقَرِّهِ","وَلا ذَنْبَ لِي إِنْ عَارَضَتْنِي الْمَقَادِرُ",12,"ر",1,0],["عَلَيَّ طِلابُ المَجدِ مِن مُستَقِرِّهِ","وَلا ذَنبَ لي إِن حارَبَتني المَطالِبُ",13,"ب",1,0],["على طيفكم أغمضت عيني والتقى","صيانا له في مقلتي الهدب والهدب",14,"ب",1,0],["على طلل كتوشيع اليماني","امح فخاً لط البيد القواء",15,"ا",2,0],["على طَفْلةٍ عَبْلا السَوَاعد بَضّة","وَتَقْتُلُ أسادَ الوَغَى لَحَظَاتُها",16,"ت",3,0],["على طمرٌ كأن نواظره","يقرأ ما اضمرت له كبدي",17,"د",2,0],["على طولِ عَهدي بالدّيارِ تَشوقُني","مَحاسِنُ فيها قارَنت حَسنات",18,"ت",1,0],["علىطول آمال كثير غرورها","ونسيان موت وهو أقرب غائب",19,"ب",1,0],["على طه البشير بكل خير","ختام الرسل والهادي الدليل",20,"ل",1,0],["عَلى طَريقٍ كَظَهرِ الأَيمِ مُطَّرِدٍ","يَهوي إِلى قُنَّةٍ في مَنهَلٍ عالي",21,"ل",2,0],["عَلى طَرفِكَ بُرهانُ","بقَتلي فهوَ سَكرانُ",22,"ن",1,1],["عَلى طُرُقٍ عِندَ اليَراعَةِ تارَةً","تُوازي شَريمَ البَحرِ وَهوَ قَعيدُها",23,"د",3,0],["على طه المشفع في البرايا","وأصحابه مع الأنصار والآل",24,"ل",1,0],["على طه المشفع في البرايا","وآله والصحاب أهل القلوب",25,"ب",1,0],["على طلب العلم في رغبة","بلا ملل لتسود الملا",26,"ا",1,0],["على طلل ظامٍ إلى ريِّ أهْله","تَصُبُّ عليه الماقيانِ ذنوبا",27,"ب",2,0],["على طلْعَته الغرّاء","للإقبال عنوان",28,"ن",1,0],["على طاعة الرحمن شابت وأيفعت","وكانت على طاعاته قبل تزهق",29,"ق",1,0],["على طاهر الأذيال ذيل قميصه","وتبانه والطيلسان مع البند",30,"د",1,0],["على طول ما أبكت جفوني صبابة","وما أضحكت بالشّيب رأسي من الصبر",31,"ر",1,0],["على طور طه المصطفى وخلاله","نسقنا اتَّباعاً طورنا وخلالنا",32,"ن",2,0],["على طُوى القُلوبِ من أَلبابِنا","صُقورُ عزمٍ قد كشَفْنَ المَقْنَعَهْ",33,"ع",2,0],["على طريقِ الرِّفاعِي","زمزَمْتُ في اللهِ رَكْبي",34,"ب",2,0],["على طه رسول الل","ه نور الفرض والنفل",35,"ل",1,0],["على طبق ما في العلم والعلم واحد","قديم بأشيا ما لهن نفود",36,"د",1,0],["على طود شميم شيدوها","فكن منائر الرشد البهيه",37,"ي",2,0],["على طُورِ المعاني قد تجلَّى","فقالت مِصرُ عاوَدَني الكليم",38,"م",1,0],["على طَيش الذُّباب فأنصَفت","منهُ فمرّ بجانبٍ محذوفِ",39,"ف",1,0],["على طبق من ورد جيرون نقطت","أَواسطه بالمسك من غير ناقط",40,"ط",1,0],["على طرق المجد سَاعاتُه","تمر منغّصةً بالغُمَمْ",41,"م",1,0],["عَلِيٌّ طَلَّقَ الدُنيا ثَلاثاً","وَما حابى أَخاهُ بِها عَقيلا",42,"ل",2,0],["على طاعة القيوم قام مبادرا","فأرشد ضلالا عن الحق أحجموا",43,"م",3,0],["على طاعة المهدي لم يبق غيرها","فأبنا وأمر المسلمين جميع",44,"ع",1,0],["على طالعِ الإِقبالِ واليُمْنِ والنَّصرِ","مَسِيرُكَ مَحْروسَ الرِّكابِ إلى مِصْرِ",45,"ر",1,1],["على طبق اصل افرع ينشأ ما يبدو","فان كنت قد ازمعت في السير لا تعدو",46,"د",2,1],["على طريقٍ للخطوطِ جامعة","وللكرامِ الكاتبينَ نافعه",47,"ه",1,0],["على طاعة منهم غداة تحكما","قد اتخذوا العرفان باللّه جنة",48,"ه",1,0],["على طور سينا قاب قوسين من منى","بنى المسجد الأقصى على الماء",49,"ا",2,0],["على طّيب الذكرى أحييك يا حنّا","وأذكر ما كان الزّمان وما كنّا",50,"ن",2,1],["عَلَى طَيبةٍ تِلكَ التي طَابَ ذِكرُهَا","كَمَا طابَ منْ أثْوَابِهَا عاطرُ النَدّ",51,"د",1,0],["عَلى طَلَلي جمل وَقَفتَ ابنَ عامرٍ","وَقَد كُنتَ تعلاً والمَزارُ قَريبُ",52,"ب",1,0],["على طه شفيع الخلق والآ","ل ما نحوى أشارت بالسلام",53,"م",1,0],["على طُلُوعِ النَّسرِ أمَّا عن غَرَب","لأَهلِ تَحتٍ الريحِ هُو خيرُ سَبَب",54,"ب",1,0],["على طاعة الرحمن أفنى زمانه","وكل الورى أضحى بذلك يشهد",55,"د",1,0],["على طبنه من شدة الجوع واضع","من القوت معصوبا من الحجر الصخر",56,"ر",1,0],["على طوفانا عليها عائم","يذهب الرجس فقد طال الأمد",57,"د",1,0],["عَلَى طَلبِ العِلمِ الشَّريفِ ودَرسِهِ","دَابتَ ولم تشغلكَ عنهُ شواغِلُ",58,"ل",1,0],["عَلى طَلحٍ وَأَودَ نِساءُ سَوءٍ","تَضَمَّنَ لؤمَها طَلحٌ وَأَودُ",59,"د",1,0],["على طالع الإسعاد بيتك إن