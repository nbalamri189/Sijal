{"poems":[[53,"أما آن للدمع أن يستجم","https://www.aldiwan.net/poem29769.html","المتقارب"],[53,"أكافينا النصيح بقي","https://www.aldiwan.net/poem30631.html","مجزوء الوافر"],[53,"أيا لله أي هوى أضاء","https://www.aldiwan.net/poem30781.html","الوافر"],[3,"قفا يا خليلي الغداة وسلم","https://www.aldiwan.net/poem210.html",""],[26,"أمن أم سفيان طيف سرى","https://www.aldiwan.net/poem24085.html","المتقارب"],[43,"ليالي بعد الظاعنين شكول","https://www.aldiwan.net/poem9967.html","الطويل"],[28,"تحن بزوراء المدينة ناقتي","https://www.aldiwan.net/poem5618.html","الطويل"],[61,"تذكر أيامه الخاليه","https://www.aldiwan.net/poem51396.html","المتقارب"],[105,"هل الحرب إلا أن تطير الجماجم","https://www.aldiwan.net/poem43156.html","الطويل"],[52,"وحلو الدلال مليح الغضب","https://www.aldiwan.net/poem27264.html","المتقارب"],[67,"بمدح المصطفى تحيا القلوب","https://www.aldiwan.net/poem18034.html","الوافر"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42610","الطويل"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/852","الطويل"],[94,"الذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=13793",""],[53,"أيَا لِلَّهِ! أيُّ هَوًى أضَاءَ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9805&r=&rc=2",""],[212,"فمن مقلتي روحي جرت عبراتها","https://www.aldiwan.net/poem37908.html","الطويل"],[261,"صب بلا لوعة ولا كمد","https://www.aldiwan.net/poem38340.html","المنسرح"],[270,"تصباك ما في النجم من لمعات","https://www.aldiwan.net/poem35636.html","الطويل"],[304,"تفيض عيون بالدموع السواكب","https://www.aldiwan.net/poem16819.html","الطويل"],[304,"تبلغ بالقليل من القليل","https://www.aldiwan.net/poem16844.html","الوافر"],[337,"سل الهموم التي باتت مؤرقة","https://www.aldiwan.net/poem45296.html","البسيط"],[371,"على طرفك برهان","https://www.aldiwan.net/poem57032.html","الهزج"],[386,"ألا إن هنداً أمس رث جديدها","https://www.aldiwan.net/poem1846.html","الطويل"],[391,"إليك المعذرة يا عالم الحال","https://www.aldiwan.net/poem54546.html","عموديه"],[391,"عسى فرج من المولى القريب","https://www.aldiwan.net/poem54637.html","عموديه"],[403,"أشير وإن كنت لا تقبلا","https://www.aldiwan.net/poem34176.html","المتقارب"],[416,"ويوم وقفنا دون أسنمة النقا","https://www.aldiwan.net/poem53880.html","الطويل"],[416,"بحيث انعطف البان","https://www.aldiwan.net/poem54026.html","الهزج"],[441,"لهذا خلقنا والجديد سيخلق","https://www.aldiwan.net/poem14465.html","الطويل"],[443,"سلام على شيخ المشايخ أحمد","https://www.aldiwan.net/poem56037.html","عموديه"],[464,"سرت زينب والبرق مبتسم الثغر","https://www.aldiwan.net/poem3392.html","عموديه"],[500,"تبوأ إذا ضاق الخناق ظلالنا","https://www.aldiwan.net/poem37644.html","الطويل"],[500,"نحن شموس الحضرة المشعشعه","https://www.aldiwan.net/poem37973.html","الرجز"],[500,"طيبوا بنا نحن طيب","https://www.aldiwan.net/poem38079.html","المجتث"],[558,"وجودي جل عن جسمي","https://www.aldiwan.net/poem34248.html","الهزج"],[558,"وجود وأشيا ما لهن وجود","https://www.aldiwan.net/poem34627.html","الطويل"]],"verses":[["عَلَيَّ طِعانٌ يَرُدُّ الجَوا","دَ بِالدَمِ أَلمى مَكانَ الرَثَم",0,"م",1,0],["عَلَيَّ طُروقُ وِردِكُمُ","وَلَيسَ عَلَيَّ أَن أَرِدا",1,"د",2,0],["عَلى طَلَلٍ كَتَوشِعِ اليَماني","أَمَحَّ فَخالَطَ البيدَ القَواءَ",2,"ا",2,0],["عَلى طَلَلٍ لَو أَنَّهُ كانَ قَبلَهُ","تَكَلَّمَ رَسمٌ دارِسٌ لَتَكَلَّما",3,"م",2,0],["عَلى طُرُقٍ كَنُحورِ الرِكا","بِ تَحسَبُ آرامَهُنَّ الصُروحا",4,"ح",2,0],["على طُرُقٍ فيها على الطُّرْقِ رِفْعَةٌ","وَفي ذِكرِها عِندَ الأنيسِ خُمُولُ",5,"ل",1,0],["عَلى طاعَةٍ لَو أَنَّ أَجبالَ طَيِّئٍ","عَمَدنَ لَها وَالهَضبَ هَضبَ التَهائِمِ",6,"م",1,0],["على طَلعةِ الجَدِّ نَغنَى بها","عن الصُّبحِ في اللَّيلةِ الدَّاجِيه",7,"ي",2,0],["عَلى طولِ ما قالَ الوُشاةُ وَخَبَّبَت","حُقودُ الأَعادي بَينَنا وَالسَخائِمُ",8,"م",1,0],["عَلى طَرَفِ العيسِ قَد حَدَّقَت","إِلَيهِ المَنايا وَكادَت تَثِب",9,"ب",1,0],["على طُرُقِ القَنا للموْتِ منه","إلى مُهجِ العِدا أبدا دَبيبُ",10,"ب",1,0],["عَلَيَّ طِلابُ الْعِزِّ مِنْ مُسْتَقَرِّهِ","وَلا ذَنْبَ لِي إِنْ عَارَضَتْنِي الْمَقَادِرُ",11,"ر",1,0],["عَلَيَّ طِلابُ المَجدِ مِن مُستَقِرِّهِ","وَلا ذَنبَ لي إِن حارَبَتني المَطالِبُ",12,"ب",1,0],["على طيفكم أغمضت عيني والتقى","صيانا له في مقلتي الهدب والهدب",13,"ب",1,0],["على طلل كتوشيع اليماني","امح فخاً لط البيد القواء",14,"ا",2,0],["على طَفْلةٍ عَبْلا السَوَاعد بَضّة","وَتَقْتُلُ أسادَ الوَغَى لَحَظَاتُها",15,"ت",3,0],["على طمرٌ كأن نواظره","يقرأ ما اضمرت له كبدي",16,"د",2,0],["على طولِ عَهدي بالدّيارِ تَشوقُني","مَحاسِنُ فيها قارَنت حَسنات",17,"ت",1,0],["علىطول آمال كثير غرورها","ونسيان موت وهو أقرب غائب",18,"ب",1,0],["على طه البشير بكل خير","ختام الرسل والهادي الدليل",19,"ل",1,0],["عَلى طَريقٍ كَظَهرِ الأَيمِ مُطَّرِدٍ","يَهوي إِلى قُنَّةٍ في مَنهَلٍ عالي",20,"ل",2,0],["عَلى طَرفِكَ بُرهانُ","بقَتلي فهوَ سَكرانُ",21,"ن",1,1],["عَلى طُرُقٍ عِندَ اليَراعَةِ تارَةً","تُوازي شَريمَ البَحرِ وَهوَ قَعيدُها",22,"د",3,0],["على طه المشفع في البرايا","وأصحابه مع الأنصار والآل",23,"ل",1,0],["على طه المشفع في البرايا","وآله والصحاب أهل القلوب",24,"ب",1,0],["على طلب العلم في رغبة","بلا ملل لتسود الملا",25,"ا",1,0],["على طلل ظامٍ إلى ريِّ أهْله","تَصُبُّ عليه الماقيانِ ذنوبا",26,"ب",2,0],["على طلْعَته الغرّاء","للإقبال عنوان",27,"ن",1,0],["على طاعة الرحمن شابت وأيفعت","وكانت على طاعاته قبل تزهق",28,"ق",1,0],["على طاهر الأذيال ذيل قميصه","وتبانه والطيلسان مع البند",29,"د",1,0],["على طول ما أبكت جفوني صبابة","وما أضحكت بالشّيب رأسي من الصبر",30,"ر",1,0],["على طور طه المصطفى وخلاله","نسقنا اتَّباعاً طورنا وخلالنا",31,"ن",2,0],["على طُوى القُلوبِ من أَلبابِنا","صُقورُ عزمٍ قد كشَفْنَ المَقْنَعَهْ",32,"ع",2,0],["على طريقِ الرِّفاعِي","زمزَمْتُ في اللهِ رَكْبي",33,"ي",1,0],["على طه رسول الل","ه نور الفرض والنفل",34,"ل",1,0],["على طبق ما في العلم والعلم واحد","قديم بأشيا ما لهن نفود",35,"د",1,0]]}