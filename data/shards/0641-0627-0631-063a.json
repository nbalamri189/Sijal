الكامل"],[466,"ظل الأسنة لا جيران بغداد","https://www.aldiwan.net/poem15126.html","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59246","الكامل"],[1302,"","https://poetry.dctabudhabi.ae/diwan/poem/131394","البسيط"],[1636,"","https://poetry.dctabudhabi.ae/diwan/poem/131361","البسيط"],[2291,"","https://poetry.dctabudhabi.ae/diwan/poem/114936","السريع"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124776","الطويل"],[2921,"","https://poetry.dctabudhabi.ae/diwan/poem/34737","المنسرح"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34604","السريع"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94350","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83471","المجتث"],[4387,"","https://poetry.dctabudhabi.ae/diwan/poem/124044","الكامل"],[4530,"","https://poetry.dctabudhabi.ae/diwan/poem/20958","الرمل"],[1890,"المرء يجمع والزمان يفرق","https://www.poetsgate.com/ViewPoem.aspx?id=16448",""],[5956,"شعرُ ظرافه","https://www.poetsgate.com/ViewPoem.aspx?id=193914",""],[6093,"نَديمٌ ليس يُرضيهِ","https://www.poetsgate.com/ViewPoem.aspx?id=176434",""]],"verses":[["فَأَرغَمَ بي عَلى رُغمٍ أُنوفاً","مُضاغَنَةً وَأَقذى بي عُيونا",0,"ن",2,0],["فَارْغَبِ اللهَ فِي الْوِقَايَةِ وَاسْأَلْ","مِنْهُ سُبْحَانَهُ الْهُدَى وَالسَّلاَمَهْ",1,"م",2,0],["فَأَرغَوا بالسَوادِ فَذَرَّ قَرنٌ","وَقَد قَطَعوا الِزيارَةَ وَالوِصالا",2,"ل",2,0],["فَأَرغَمَ اللَهُ قَوماً لا حُلومَ لَهُم","مِن مُرجِفينَ ذَوي ضِغنٍ وَحُسّادِ",3,"د",1,0],["فارغبا عن مِداد شِعْبي فليست","فيه إلا صُبَابةٌ بل سرابُ",4,"ب",1,0],["فارغب عن النوم إلى قهوةٍ","تَحْيَى بها السَّرَّاءُ والجودُ",5,"د",1,0],["فَارْغَبْ بِنَفْسِكَ عَنْ حَالٍ تُضَامُ بِهَا","فَلَيْسَ بَعْدَ اطِّرَاحِ الذُّلِّ مَا يَصِمُ",6,"م",1,0],["فَاِرغَب بِنَفسِكَ عَن مَكانٍ","قَد نُبِذتَ بِهِ سَحيقِ",7,"ق",1,0],["فارغَب إِلى حُسْنِ الثَّنَاءِ فإِنَّه","لا يستوي في الذِّكْرِ نِعمَ وبِيسا",8,"س",2,0],["فارْغَبْ أوِ ارْهَبْ إنّ أيمانَهم","مبسوطةٌ تُسْعِدُ أو تُشقي",9,"ق",2,0],["فَاِرغَب إِلى اللَهِ لا إِلى بَشَرٍ","مُنتَقِلٍ في البِلى وَفي الغِيَرِ",10,"ر",1,0],["فارِغُ اللُبِّ لِلنَديمِ إِذا اِشتَف","فَ ثَلاثاً أَلفَيتَهُ غِرّيدا",11,"د",2,0],["فَارْغَبْ بِنَفْسِكَ وَهْيَ فِي أَثْوابِهَا","إِنْ لَمْ تَكُنْ شَامٌ فَتِلْكَ عِرَاقُ",12,"ق",1,0],["فارغ اللب للنجيم إذا اش","تف ثلاثاً ألفيته غريدا",13,"د",2,0],["فارغب في النوم إلى قهوة ٍ","تَحْيَى بها السَّرَّاءُ والجودُ",14,"د",1,0],["فارغبْ بنفسكَ عنْ حالٍ تضتامُ بها","فَلَيْسَ بَعْدَ اطِّرَاحِ الذُّلِّ مَا يَصِمُ",15,"م",1,0],["فَاِرغَب لِرَبِّكَ في الجَدا","ما أَنتَ عَنهُ ذو جَداءِ",16,"ا",2,0],["فارغ القلب غارق","في الملذات والسرر",17,"ر",1,0],["فَاِرغَب عَن الدُنيا الدَني","ئة فَهيَ لَيسَت دار خُلدِك",18,"ك",1,0],["فارغب إذاً يا من يروم حياتَه","أبديةً بشعارٍ إسكيمٍ سُمي",19,"م",2,0],["فارغب الى مولاك تظفر بالجَدى","فالنفس من جدواهُ ذاتُ جداءِ",20,"ا",2,0],["فأَرغمتَ آنافاً وأَكبتَّ حُسَّداً","فأكرمْ وصلْ واقطعْ وقرَّبْ وباعد",21,"د",1,0],["فأرغمت آنافاً وأكبتَّ حسَّداً","لأنف الأَعادي حدّ سيفك راغم",22,"م",1,0],["فأرغمهم كيلا اعو","د ومكبيي خفّي حُنين",23,"ن",1,0],["فارغب بنفسك أنْ يقتادها رغدٌ","ودونه جائرٌ في حكمه عادي",24,"د",2,0],["فَارْغَبْ وَدَعْ عَنْكَ الجَهَالَةَ كَيْ تَفُزْ","بِالسَّعْدِ مِنْهَا أوْ فَكُنْ عَيْنَ الشَّقِي",25,"ق",2,0],["فارغب فديتك فيما فيه رغّبنا","خير الورى كلهم حيا ومقبورا",26,"ر",2,0],["فارغب بنفسك أن تلفى بفستقة","تروم نزح طموح الموج زخاره",27,"ر",2,0],["فارغب إلى اللَه وإحسانهِ","لا تطلبِ الرزقَ من الطالبِ",28,"ب",1,0],["فارغم بأنف القاطع الشهر غفلة","وأعظم بأجر المخلص المتعبّد",29,"د",1,0],["فأرغمَ اللَّه حاسديه كما","أرغم هُودَ القرود إذ رغِموا",30,"م",3,0],["فارغب عن النومِ الى شُربِها","تَرغَب عن الموت الى النَّشرِ",31,"ر",1,0],["فارغب عن الدنيا وكن بقناعةٍ","فتقرَّ عيناً في رضاهُ تعالى",32,"ل",2,0],["فَاِرغَم حَسوداً يروغ","في كلّ أَمرٍ مُريبِ",33,"ب",1,0],["فارغب إلى الرحمان في تفريج ما","أشكو واسعافي بكل مؤمّل",34,"ل",1,0],["فارِغُ السَوطِ فما يَجهَدُني","ثَلِبٌ عَودٌ وَلا شَختٌ ضَرَع",35,"ع",1,0],["فارغب بنفسك أن تصادق أحمقا","إن الصديق علي الصديق مصدق",36,"ق",1,0],["فارغٌ من كل علمٍ وثقافةْ","ما له ميلٌ سوى أكلِ الكنافةْ",37,"ف",2,1],["فأرغبُ في مفاتنه","وأرغبُ عن مناقبه",38,"ب",2,0]]}