],[470,"وأوقدت ناري باليفاع فلم تدع","https://www.aldiwan.net/poem4659.html","الطويل"],[477,"متى حان من شمس النهار غروب","https://www.aldiwan.net/poem15325.html","الطويل"],[500,"وآيات ألواح رقمن مع العما","https://www.aldiwan.net/poem37957.html","الطويل"],[500,"يا بارقا قد تلوى","https://www.aldiwan.net/poem37978.html","المجتث"],[514,"روت عن تراقيها العقود عن النحر","https://www.aldiwan.net/poem20796.html","الطويل"],[515,"أمنت من الغرام على فؤادي","https://www.aldiwan.net/poem12064.html","الوافر"],[538,"أتيت بإذن أم أتيت بلا إذن","https://www.aldiwan.net/poem47915.html","عموديه"],[551,"وسائلة لتعرف ما عراني","https://www.aldiwan.net/poem47165.html","الوافر"],[551,"إساءات وإحسان","https://www.aldiwan.net/poem47186.html","الهزج"],[551,"توق ديار الحي فهي المقاتل","https://www.aldiwan.net/poem47325.html","الطويل"],[551,"إلى كم أقود قوما","https://www.aldiwan.net/poem47833.html","المضارع"],[551,"أبي يعصب الغاوون ما في عيابهم","https://www.aldiwan.net/poem47883.html","الطويل"],[551,"نظرت إليها والرقائب حولها","https://www.aldiwan.net/poem48049.html","الطويل"],[558,"سميت ساعة فخذ نطق فيها","https://www.aldiwan.net/poem33665.html","الخفيف"],[575,"صدوا فإنساني إليهم صدى","https://www.aldiwan.net/poem3087.html","السريع"],[586,"غرامي فيكم ما ألذ وأطيبا","https://www.aldiwan.net/poem17429.html","الطويل"],[586,"حللت بأحشاء لها منك قاتل","https://www.aldiwan.net/poem17640.html","الطويل"],[586,"إذا بعدوا وافوك أسرى وإن دنوا","https://www.aldiwan.net/poem17704.html","الطويل"],[586,"فيا شعره هل فيك ليلي ينقضي","https://www.aldiwan.net/poem17718.html","الطويل"]],"verses":[["وَلي مَضاءٌ قَطُّ لَم يَخُنّي","ضَميرُ قَلبي وَضَميرُ جَفني",0,"ي",1,0],["وَلي مِن قَريضي مُنبِهٌ لِضَميرِهِ","وَلَكِنَّني آبى دَنيَّ المَكاسِبِ",1,"ب",1,0],["وَلي مِن ظُهورِ الشَد قَميّاتِ مَقعَدٌ","وَفَوقَ مُتونِ اللاحِقِيّاتِ مَركَبُ",2,"ب",1,0],["ولي مَدىً لابُدّ منْ بُلوغِهِ","وكلُّ ساعٍ يَنتَهي إِلى مَدَى",3,"ا",1,0],["ولي مَعْقِلٌ بفِناءِ الوزيرِ","يَروحُ إِلى فَيئِهِ المُعْزِبُ",4,"ب",1,0],["ولي مُقْلةٌ ما تَسْتَريحُ إِلى البُكا","بحُزْوى فقد ألْوى بدَمْعي مُحَجَّرُ",5,"ر",1,0],["وَلي مُقلةٌ وحْشيّةٌ لا تَرُوقُها","نَفائِسُ تَحْويها نُفوسٌ خَسائِسُ",6,"س",1,0],["ولي من أميرِ المؤْمِنينَ إيالَةٌ","ستُرغِمُ أعْداءً وتَكْمِدُ حُسَّدا",7,"د",2,0],["وَلي مَعاذيرُ لَو تَطَلَّعُ في","لَيلِ سِرارٍ أَغنَت عَنِ القَمَرِ",8,"ر",1,0],["وَلي مِنكِ أَيّامٌ إِذا شَحَطَ النَوى","طِوالٌ وَلَيلاتٌ تَزولُ نُجومُها",9,"م",3,0],["وَلي مَعَ بَذلِ المالِ وَالبَأسِ صَولَةٌ","إِذا الحَربُ أَبدَت عَن نَواجِذُها العُصلِ",10,"ل",1,0],["ولي مباعدة منه ومزرية","من غير مزرى به والحين ذو سببِ",11,"ب",1,0],["وَلي مِنَّةٌ في رِقابِ الضَبابِ","وَأُخرى تَخُصُّ بَني جَعفَرِ",12,"ر",1,1],["ولى من طرة لك أو جبين","شجون في المساء وفي الصباح",13,"ح",1,0],["ولي من الحلو حالا","قصدٍ فقلٌّ وكُثر",14,"ر",1,0],["ولي منك آمالٌ عريضٌ مُرادُها","وواللَّهِ لا كانتْ مطامعَ أشعبِ",15,"ب",1,0],["ولي مَوْلىً يريشُ سهامَ غيري","فما لي لا أرى سَهمي يُراشُ",16,"ش",1,0],["ولي مثلُ إسماعيلَ عنه مُراغمٌ","وهل كأبي سهْلٍ لحُرٍّ مُراغمِ",17,"م",1,0],["وَلي مَماليكُ تُركٌ","مِنَ المِلاحِ النِظافِ",18,"ف",1,0],["وَلي مِنكَ جودٌ رامَ غَيرُكَ نَقصَهُ","وَحاشا لِجودٍ مِنكَ بِالنَقصِ يوصَفُ",19,"ف",1,0],["ولى مرضى من العمال كُثر","إذا الأسطى مضى بعث الصبيا",20,"ي",2,0],["ولي ملك ملء الفؤاد محبب","جمعت الهوى في مدحه والقوافيا",21,"ي",2,0],["وَلي مِنَ الحَدائِقِ الغَنّاءِ","رَوضٌ عَلى المَطَرِيَّةِ الفَيحاءِ",22,"ا",2,0],["ولي من الأرض ما أنضى رواحلُه","عمري لقد حكمت فينا النوى شططا",23,"ط",2,0],["ولي مقلةٌ لا يَملِكُ النومَ جَفْنُها","غِراراً إِذا انصبَّ النجومُ الضَّواجِعُ",24,"ع",1,0],["وَلي مِنَ اِثنَينِ واحِدٌ أَبَداً","عِرضُ عَزيزِ الرِجالِ أَو سَلَبُه",25,"ب",2,0],["ولي منه إذا ما الكأسُ دارَتْ","عَرابِدُ لا يَقي منهنَّ وَاقِي",26,"ي",1,0],["ولي من نَدى كفَّيْكَ رسْمٌ تضاءَلَتْ","مَعالِمُه حتى تَكادَ تبيدُ",27,"د",1,0],["ولي من الأدبِ المحمودِ أثمرُه","يُنمى إليه وأعرافٌ تناسِبُه",28,"ب",2,0],["وَلي مُدَّةٌ لا بُدَّ يَوماً سَتَنقَضي","كَأَن قَد أَتاني وَقتُها فَقَضَيتُها",29,"ت",3,0],["وَلي مِنَ المَوتِ يَومٌ لا دِفاعَ لَهُ","لَو قَد أَتاني لَقَد ضَلَّت أَقاليدي",30,"ي",1,0],["ولي منكم شغلان بالصد والنوى","وأرتاح للذكرى وقلبي بكم يغرى",31,"ر",2,0],["وَلي مُقلَةٌ قَد أَنكَرَ الغَمضَ جَفنُها","وَعَرَّفَها صَرفُ النَوى كَيفَ تَسهَدُ",32,"د",1,0],["وَلي مِقْوَلٌ قد أطْلَقَتْهُ سَجيّتي","عن الحمدِ لما عَقَلَتْهُ عَنِ الذمِّ",33,"م",1,0],["وَلي مِنَ الدُنيا هَوىً واحِدٌ","يا رَبِّ فَاِصفَح لي عَنِ الواحِدِ",34,"د",1,1],["وَلّى مُعاوِيَةٌ عَنهُم وَقَد حَكَمَت","فيهِ القَنا فَأَبى المِقدارُ وَالأَمَدُ",35,"د",1,0],["ولي مِنْ هباتِ اللهِ عَنْ كلِّ ذا غنى","وإنْ دامَ بي هذا العناءُ فما العذرُ",36,"ر",1,0],["وَلي مِثلُ ما في شِعرِ مَن كانَ ذا هَوىً","يَبيتُ جَريحَ القَلبِ حَرّانَ ساهِيا",37,"ي",2,0],["وَلي مِنَ الحَينِ عينٌ لَيسَ يَمنَعُها","طولُ المَلامَةِ أَن تَجري مَآقيها",38,"ي",3,0],["وَلي مَورِدٌ بِإِناءِ المَنونِ","وَلَكِنَّ ميقاتَهُ ما أَنى",39,"ن",2,0],["وَلي مَذهَبٌ في هَجرِيَ الإِنسِ نافِعٌ","إِذا القَومُ خاضوا في اِختِيارِ المَذاهِبِ",40,"ب",1,0],["وَلي مَنزِلٌ في الثَرى ما يُزارُ","وَلَو رامَهُ زائِرٌ ما عَرَف",41,"ف",1,0],["وَلّى مُجِدّاً وَأَزمَعنَ اللَحاقَ بِهِ","كَأَنَّهُنَّ بِجَنبَيهِ الزَنابيرُ",42,"ر",1,0],["وليَمْضِ بالزورق ما يشتهي","إلى القضاءِ الحتْم دون ارتيابْ",43,"ب",1,0],["ولي مَنطقٌ لم يرْضَ لي كُنْهَ مَنزلي","على أنّني بين السّماكينِ نازِل",44,"ل",1,0],["وَلي مِن حُسامي كُلَّ يَومٍ عَلى الثَرى","نُقوشُ دَمٍ تُغني النَدامى عَنِ الوَردِ",45,"د",1,0],["وَلِي مِنَ الشِّعْرِ آيَاتٌ مُفَصَّلَةٌ","تَلُوحُ فِي وَجْنَةِ الأَيَّامِ كَالْخَالِ",46,"ل",1,0],["وَلِي مِنْ جَنانِي إِنْ عَزَمْتُ وَمِقْوَلي","سِرَاجٌ وَعَضْبٌ ذَا يُضيئُ وَذَا يَفْرِي",47,"ر",2,0],["وَلِي مِنْ بَدِيعِ الشِّعْرِ مَا لَوْ تَلَوْتُهُ","عَلَى جَبَلٍ لانْهَالَ فِي الدَوِّ رَيْدُهُ",48,"د",2,0],["وَلِي مِنَ الْقَوْلِ نَصِيرٌ إِذَا","دَعَوْتُهُ فِي حَاجَةٍ أَوْفَضَا",49,"ض",2,0],["وَلِيُّ مَنَاصِبٍ لَمْ تُنْسَ فِيهَا","مَآثِرُهُ الإِدَارَةُ وَالقَضَاءُ",50,"ا",2,0],["وليمة كانت لنا في الهوى","أكثرت فيها عدد المعجبين",51,"ن",1,0],["ولي مضغةٌ بينَ عُوج الضلوع","تحاولُ أنْ تجعلَ الفَوْقَ دونا",52,"ن",2,0],["وليمونُ يافا يابسٌ فى حقولهِ","وهل شجرٌ فى قبضة الظلم يُزهرُ ؟",53,"ر",1,0],["وَلي ما شئت مِن وَرد","بِرَوضة خَدِهِ عَبَق",54,"ق",1,0],["ولي مع انفاسي تصعد زفرة","دخان الهوى منها الى الجو مرئي",55,"ي",1,0],["ولي منهم بحمد الله قوم","سموا بحبوحة المجد العلي",56,"ي",1,0],["ولي من خالد المجد اقتراب","عزيز الفخر يعظم ان يزالا",57,"ل",2,0],["ولي من صدور السادة الغر والد","كريم السجايا طيب الصيت والذكر",58,"ر",1,0],["ولي من اللَه خوف لأحد ولي","حسن الظنون به في كل منقلب",59,"ب",1,0],["ولي معاهد صدق في العهود ولي","عزم لأجل الوفا جلد على النصب",59,"ب",1,0],["ولي مِن الشِّعرِ آياتٌ تُوَقِّعُها","مَعازفُ السِّحرِ، والعنوانُ: ديوانُ",60,"ن",1,1],["ولي من هواك حياتي حنين","هو الحصن لي حالَتَيَّ الحصين",61,"ن",1,0],["وَلِيمَةَ لَومَ لُمتِ عَلَى لِقَاهَا","وإني فِيهِ لَم أكُ بِالمَلُومِ",62,"م",1,1],["وَلي مَولىً أَساءَ فَلَم أَسِمهُ","بِمَيسَمِ مَن أَساءَ وَلَم أُسَمِّه",63,"م",2,1],["ولي مُهجةٌ لم تَبق فيها بقيةٌ","سِوى ما سَكَنتُم من صَميم فُؤادها",64,"د",3,0],["ولي منك من مالي ملازم خدمة","وأسداء معروف وفضل تعلهُ",65,"ل",2,0],["ولي مطلب غير الذي تطلبونه","ومرما تخطاه النفوس الشحائح",66,"ح",1,0],["وليملكنَّ كنوزَ قارونٍ كما","ورثتْ عداهُ الخسفَ من قارونِ",67,"ن",1,0],["وَلي مِنَ الفَضلِ أَسنَاهُ وَأَشرَفَهُ","وَهِمَّةٌ جاوَزَت بي كُلَّ مُرتَفِعِ",68,"ع",1,0],["ولِيُمْسِك البيتُ الحرامُ وحِجْرُه","ومقامُه وحَطيمُه بذُيوله",69,"ل",2,0],["ولي مالك أنا عبد لهُ","حياتي بأجمعها في يديه",70,"ي",2,1],["ولي مذهبٌ في الهجو أرض بفحشه","قلوب أناس من أناس ذوي رجس",71,"س",1,1],["ولي موجل في الحب من كل صاحب","إذا ازور عن قصد المودة ناظره",72,"ر",2,0],["ولي مثل ما للناس من شهواتهم","وكفي صفر من نضار ومن تبر",73,"ر",1,0],["وَلي مِن أماني الدهرِ أعظم منيةٍ","إِذا قلتُ قَد حانت أرى الدهرَ يشتطُّ",74,"ط",1,0],["ولي مهجةٌ لا تُسْتَمالُ بنائلٍ","ولا تَرتجي بالشِّعر خِلعةَ واهبِ",75,"ب",1,0],["ولي ما أراد الحب والحبّ حاكم","نرى جوره فينا أبرّ من القصد",76,"د",1,0],["ولي منهم غنجاءُ ظاميةُ الحَشَى","يميل بِهاتِيْهُ الصِبَا فتَميِسُ",77,"س",1,0],["وَليمَةٌ مَدَّها الغَرامُ","وَسادَها الزَهوُ وَالمَرَح",78,"ح",1,0],["ولي من نِزَارٍ لُحْمَةٌ شدَّ نَسْجَها","مَعَدٌّ ويَحْويني وإيّاه مَنْصِب",79,"ب",1,0],["وَلي مِدَحٌ فيهِ سارَ الرُواةُ","بِها وَهوَ أَكرَمُ مَن يُمدَحُ",80,"ح",1,0],["ولي من ولي العهدِ أعظمُ شافِعٍ","إليكَ بهِ مَولى الورى أتقرَّبُ",81,"ب",1,0],["وَلي مقلة لا يَملِكُ الصَبرَ دَمعَها","وَقَلبٌ لَجوجٌ في الغَرامِ جَموح",82,"ح",1,0],["ولي من عروسِ الشعرِ خيرُ زيارةٍ","فيُطربني لحنٌ ويُنعشني عطر",83,"ر",1,0],["وَلي مَديحٌ يَهَشُّ السامِعونَ إِلى","سَماعِهِ فيهِ ما أَقوَت قَوافيهِ",84,"ي",2,0],["وَلِيُمناهُ اِستِلامٌ مِثلُ ما","لِحَجيجِ البَيتِ بِالرُكنِ اِستِلامُ",85,"م",1,0],["وَلِيُمناكَ بِالسَماحِ اِنهِلالٌ","مُخجِلٌ صَوبُهُ اِنهِلالَ الغَمامِ",86,"م",1,0],["وَلي مَنطِقٌ إِمّا سَلَلتُ غِرارَهُ","يَعُد ناكِصاً عَن حَدِّهِ كلُّ ذي حَدِّ",87,"د",1,0],["وَلي مطالِبُ شَتّى أَنتَ مُنجحُها","فَضلاً إِذا أَعيت الراجي مناجِحُهُ",88,"ح",2,0],["ولي مقولٌ (هاروت) بعضُ جنوده","يحلُّ به عصمَ الظبا من حزونها",89,"ن",3,0],["ولي من رسول الله جدي عناية","ووجه وإمداد وإرث وآثار",90,"ر",1,0],["ولي من الفنّ أشواكٌ غنيتٌ بها","عن كلّ زهر ذكيِّ العطرِ مياس",91,"س",1,0],["وَلي مِنكَ رَسْمٌ عِنْدَ إدْراكِ قَطْفهِ","لَنا مَأْكلاً مَالَمْ تُبِحْ مِنهُ مَشْرَباً",92,"ب",2,0],["وَلي مَحَلٌّ في ثُراهُ الثَرى","ما حَلَّهُ مَحلٌ وَلا نَهبُ",93,"ب",1,0],["وَلي مِنكَ غَيبٌ في تَصَحُّحِ رُؤيَتي","وَكُلُّ حَديثي في هَواكَ قَديمُ",94,"م",1,0],["ولي مَعاشٌ ما زلْتُ آخُذُه","عفْواً وفي الطّالبين مُزْدَحَم",95,"م",1,0],["ولي من نَجْمِ دينِ اللهِ هادٍ","ففي وادي الضّلالةِ لا أَهيم",96,"م",1,0],["ولي مَنطِقٌ يَبهَرُ السّامِعينَ","إذا طالَ طابَ وإن قَلَّ دَلّ",97,"ل",1,0],["ولي مَولىً إذا أُسمِيه يَوماً","يكونُ ليَ اسْمُه بالسّعْدِ فالا",98,"ل",2,0],["ولي منك آمالٌ قديماً غرَسْتُها","وهأنذا مُستَثمِرٌ ذلك الغَرْسا",99,"س",2,0],["ولي من ثنائي والولاءِ أَواصِرٌ","ترادَفَ منها أوّلٌ وأَخير",100,"ر",1,0],["ولي مِقْولٌ قد كان عَصْرُ شبيبتي","حُساماً وحُسْنُ القولِ في مَتْنِه أُثرا",101,"ر",2,0],["وَلي مُقلَةٌ مِن ذُخرِ دَمعي مُقِلَّةٌ","وَكانَ لَها لَولا النَوى حاصِلٌ جَمُّ",102,"م",1,0],["وَلي مِنَ الدَهرِ عَمّا رُمتُ أَربَعَةٌ","كَدٌّ وَرَدٌّ وَإِقصاءٌ وَإِقصادُ",103,"د",1,0],["وَلي مِنَ السَعيِ في المَرجُوِّ أَربَعَةٌ","بَأسٌ وَيَأسٌ وَإِخلالٌ وَإِخلادُ",103,"د",1,0],["ولي مُهجةٌ فاضَت وغاضَت دُمُوعُها","وذاك على ما بي أدلُّ وأبيَنُ",104,"ن",1,0],["ولي مُهجةٌ عَذارءُ لم تلقَ ذلَّةً","فَما لِي إذا ألزَمتُها ذلَّةً عُذرُ",105,"ر",1,0],["ولي من الشوقِ من يراودُني","على هواها كما أراودُها",106,"د",3,0],["وليَمضِ وقتُكَ هذا","قبل الفواتِ حَميدا",107,"د",2,0],["ولي من بديع النظم كلّ غريبةٍ","كَمِثْل رِيَاضِ الحَزنِ باكرها الوسمي",108,"ي",1,0],["ولي مِن بَناني شَأنٌ بَديعٌ","ولو شئتُ قْلتُ بَناني بَناني",109,"ي",1,0],["ولي منزلٌ مَا مَسَّ جلدِي تُرَابهُ","ولا فيه أتْرابي ومَلْهَى مَلاعبي",110,"ب",2,0],["ولي منه ما أهدي لديه وأبتغي","ومنِّي له المدح الَّذي طاب نشره",111,"ر",2,0],["ولي من رياض القول كلّ حديقة","زها ناظم فيها وأعْجَب ناظم",112,"م",1,0],["ولي مقلةٌ بالدمع تجري صبيبةً","حرامٌ عليها النومُ حتى تراكمُ",113,"م",1,0],["ولي ماءُ وجهٍ صُنْتُه بقناعةٍ","تُجاهِدُ عنه جُهدَها وتُكافحُ",114,"ح",1,0],["ولي من نَدى من لا يَدي أمرَ مُهجٍ","من لم يوقع بها قلت أوقعِ",115,"ع",1,0],["وليمددن ثناً يكن لكم سناً","وتحية مني كنشر المندل",116,"ل",1,0],["ولي مقلة شكري وجسم معذب","كذاك فؤادي من لظى الحزن مفأد",117,"د",1,0],["ولي منزل لقّنته سر عزلتي","فباركها ثم استحال شعارا",118,"ر",2,1],["ولي من الناس بيتٌ من دعائمه","أمُّ النجوم إذا استعصمتُ يعصِمني",119,"ي",1,0],["ولي من الناس أهلُ بيتٍ","له من المجد ظُلَّتانِ",120,"ن",1,0],["ولي منه إما المنع والعذرُ بعده","يُلفَّقُ مكذوباً أو المنُّ والبذلُ",121,"ل",1,0],["ولي من جلال الدين نُعمى وعزةٌ","تواتُرُ إحسانٍ وجَذْبةُ باعِ",122,"ع",1,0],["وَلي مِنكَ مَوعودٌ طَلَبتُ نَجاحَهُ","وأَنتَ امرؤٌ لا تُخلِفُ الدَّهرَ مَوعِدا",123,"د",2,0],["ولي من نسيمِ الأبرقَيْنِ إذا سرى","بريّاهمُ بعدَ الهدوَّ طبيبُ",124,"ب",1,0],["ولي منكَ روحٌ ضمنَ روحي لِسرِّها","شُؤُنٌ تُواليني بِطارقِ طائفِ",125,"ف",1,0],["ولي معَ النَّوْحِ دَوْماً","مَعارِكٌ وصِراعُ",126,"ع",1,0],["ولي مدمَعٌ في حبّها لو بكى الحَيا","به نبتَ الياقوتُ في صدَفِ الدُرِّ",127,"ر",1,0],["ولي من فارس الإسلام طود","شديد الركن في النوب الشداد",128,"د",1,0],["ولي معَهُ في الوُدِّ خيرُ علاقَةٍ","قدِ احتُرِمَت منه كما احتُرِمَت مِنِّي",129,"ي",1,0],["ولِي مُتَزَحْزَحٌ عنه لو اِنّي","أراهُ بناظِريَّ كما يراني",130,"ي",1,0],["ولي مِن بعدِ فِقداني","ك للسّرّاءِ فِقدانُ",131,"ن",1,0],["ولِي من دموعي غدوةً وعشيةً","لبين الشّبابِ الغضِّ طَلٌّ ووابلُ",132,"ل",1,0],["ولِي موقفٌ عند الخليفة ما اِدّعتْ","عديلاً له هذي النّجومُ المواثلُ",132,"ل",1,0],["ولِي منزلٌ حصينٌ","مكينٌ من الفؤادِ",133,"د",1,0],["ولِي مُهجةٌ لم يبقَ إلّا طُلولُها","تُرشُّ بأنواعِ الهمومِ وتُرضَخُ",134,"خ",1,0],["ولي مطلبٌ لكنّني لا أنالُهُ","وكم عاقتِ الأقدارُ دون المطالبِ",135,"ب",1,0],["وليمت إن أول الأمر موت","ثم قبر في تربة يحويها",136,"ي",3,0],["ولي مُرادٌ في صِمير العُلا","سَعْدُك عن إِدْرَاكِه مُسْعِدي",137,"ي",1,0],["ولي مُهْجَةٌ دِينُ الصَّبابةِ دِينُها","فَكيْف تَرى عَنْكُمْ مَدى الدَّهْرِ مَذْهَبا",138,"ب",2,0],["وَلِي مَنْطِقٌ مِنْ نَحْوِ شَوْقي أَصولُه","بِعِلْمِ المعاني مِنْ خِلافِكَ شَاغِلُ",139,"ل",1,0],["وَلِي مِنْكَ عَرْفٌ مِنْ وِدَادِكَ عاطِرٌ","وَحَاليَ مِنْ عِرْفَانِ وَصْلِكَ عَاطِلُ",139,"ل",1,0],["ولي مِدَحٌ بَالَغْتُ فِيهَا بَلاغَةً","وَأَثْنيتُ فِيها بالَّذي أَنَا عالِمُ",140,"م",1,0],["وَلِي مُقْلَةٌ قَدْ أَمْطَر الشَّوْقُ سُحْبَهَا","فَفِي دَمْعِها حَتّى تَراكُمْ تَراكُمُ",141,"م",1,0]]}