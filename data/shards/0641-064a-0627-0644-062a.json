{"poems":[[93,"زعم المرء إنما هو رب","https://www.aldiwan.net/poem62799.html","عموديه"],[87,"طوي البساط وجفت الأقداح","https://www.aldiwan.net/poem62905.html","الكامل"],[71,"صاح إن كنت في الغرام معيني","https://www.aldiwan.net/poem28372.html","الخفيف"],[48,"ما جدري أمات صاحبه","https://www.aldiwan.net/poem22597.html","المنسرح"],[71,"","https://poetry.dctabudhabi.ae/diwan/poem/57154","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54674","الخفيف"],[102,"رسالة إلى صديق في قبره","https://www.poetsgate.com/ViewPoem.aspx?id=183584",""],[264,"في التجلي قد صار كلي قلبا","https://www.aldiwan.net/poem35801.html","الخفيف"],[567,"في الترب من آل الشهاب أميرة","https://www.aldiwan.net/poem52597.html","الكامل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62519","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79985","الخفيف"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104781","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77305","الرمل"],[2338,"","https://poetry.dctabudhabi.ae/diwan/poem/111147","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94275","الخفيف"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100260","الطويل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87628","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87376","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89133","البسيط"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86490","الكامل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36400","الدوبيت"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36358","الدوبيت"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36307","الدوبيت"],[4901,"قد بدا ما يسر فيما تقول","https://www.poetsgate.com/ViewPoem.aspx?id=186127",""],[5273,"أضغاث معنى","https://www.poetsgate.com/ViewPoem.aspx?id=192312",""],[5376,"النفسُ تسعى الى اللذات تقصدُها","https://www.poetsgate.com/ViewPoem.aspx?id=188408",""],[5376,"النفسُ تسعى الى اللذات تقصدُها","https://www.poetsgate.com/ViewPoem.aspx?id=188504",""],[5376,"بانتْ بليلى امةٌ وديارُ","https://www.poetsgate.com/ViewPoem.aspx?id=197712",""],[5409,"شيعت فيك عصارة الآداب","https://www.poetsgate.com/ViewPoem.aspx?id=155453",""],[5691,"ليالي شهرزاد","https://www.poetsgate.com/ViewPoem.aspx?id=205893",""],[5851,"حزن اليتيمة","https://www.poetsgate.com/ViewPoem.aspx?id=175236",""],[5939,"يغار القلب فاتنتي","https://www.poetsgate.com/ViewPoem.aspx?id=185489",""],[6108,"تيه","https://www.poetsgate.com/ViewPoem.aspx?id=192747",""],[6125,"يَجتاحني حبٌّ تَملَّكَ في دمي","https://www.poetsgate.com/ViewPoem.aspx?id=210970",""]],"verses":[["في التُرابِ الَّذي تَدوسُ عَلَيهِ","أَلفُ دُنيا وَعالَمٍ لا تَراهُ",0,"ا",2,0],["في التُربِ فَوقَ بَني سُوَيفَ يَتيمَةٌ","وَمِنَ الجَواهِرِ زَيِّفٌ وَصِحاحُ",1,"ح",1,0],["في التشابيهِ والتغزُّلِ والتض","مينِ والمدحِ والرثا والمجونِ",2,"ن",1,0],["في التُربِ وَالصَخرِ وَالثِمارِ","وَفي الماءِ نُفوسٌ يَصوغُها القَدَرُ",3,"ر",1,0],["في التفاتٍ وثناء","وثنايا وتثني",4,"ي",1,0],["فِي التَّصَابِي وَمُلْتَقىً وَشَتَاتِ","فَإِذَا كَانَ فِعْلُهَا ذَاكَ إِثْمَا",5,"م",2,0],["في التراثيات دكتوراً، وفي","غرف التعذيب نفسياً ريادي",6,"د",2,0],["في التجلّي قد صار كلّيَ قلبا","وشهود الوجود أشهد ربّا",7,"ب",2,1],["في التُّربِ مِن آلِ الشِّهابِ أميرةٌ","بحُلولِها هذا الضَّريحُ تَشَرَّفا",8,"ف",2,1],["فيا لتسكاب دموع عيني","إذا ذكرت مصرع الحسين",9,"ن",1,0],["في التياع مجدَّد","واجتماع مبدِّدِ",10,"د",1,0],["في التقى والصلاح والزهد والخش","ية والنسك بل وحسن الرجاء",11,"ا",2,0],["فِى التِّينِ إِذ قالَ مَولاَنا العَظِيمُ لَقَد","خَلَقَنا إِنسانَ حُسنٍ نُورَ قَبضَتِنا",12,"ن",2,0],["في التِّرمِذِيِّ وَمُسنَدٍ وَسِوَاهُمَا","مِن كُتبِ تَجسِيمٍ بِلاَ كِتمَانِ",13,"ن",1,0],["في التِجاراتِ الَّتي كُنّا بِها","نَفتَحُ الدُنيا وَلَمّا نَقفِلِ",14,"ل",1,0],["في التقى المحض في الخلق الحسن","وبما قد فرض اللَه وسن",15,"ن",1,0],["في التصابي لم ألق إلا تبارك","فاستعذ يا فتى بمولى تبارك",16,"ك",1,1],["فيا لتباريح تروح وتغتدي","عَليَّ بها دَعدٌ لِيَ اللضه من دَعدِ",17,"د",1,0],["في التسعِ ولّى فالشَباب ينوحهُ","كالجار عند البين يندب جارَهُ",18,"ر",2,0],["في التسع عاجلك الردى فبكاهما","لَم تُحصَ مدَّتهُ بحكم زَمانِ",19,"ن",1,0],["في الترك والفرس والعرب الأفاضل لا","ترى له مشبهاً في البدو والحضر",20,"ر",1,0],["في الترب يسحب شعره","فضح الغوالي نشره",21,"ه",1,0],["في التَصفيَةِ اِجتَهِد لعمرٍ ثانٍ","كالوردِ مصعّداً لَدى التَقطيرِ",22,"ر",1,0],["في التُربِ تَغَيَّبَت زَمانَ الوَردِ","تُملي بِلِسان حالِها في اللَحدِ",23,"د",1,1],["في التُربِ هويتُ لَيتَني لَم أَعقِد","مِن فَوق زُمُرُّديِّ تَختٍ تاجا",24,"ج",2,0],["في التبرعات قبيح عند مثلي","وفي القبيح جميل",25,"ل",1,0],["في التّينِ والزّيتونِ قِصّةُ أمْسِهِ","قد خَطَّها زَمَنُ الخطيئةِ أسطُرا",26,"ر",2,0],["في الترْكِ راحةٌ عبدٍ لا يسالمُها","لمن تخون فويلٌ مَنْ يساومُها",27,"م",3,0],["في الترْكِ راحةٌ عبدٍ لا يسالمُها","حيث تخون فويلٌ مَنْ يساومُها",28,"م",3,0],["في التيهِ كنَّا لم نزلْ بجهالةٍ","لولا قدومُك فالمآلُ سُعَارُ",29,"ر",1,0],["في الترب ضيعها غداة أراقها","ساقي الردى بدلاً من الأكواب",30,"ب",1,0],["في التَّأَنّي سَلامةٌ ووُصولٌ","بعْدَ صَبْرٍ والعقْلُ فيهِ العِمادُ",31,"د",1,0],["في التاسع المر من أيلول طوقنا","حرمان عمر غدونا من ضحاياه",32,"ا",2,0],["في التوِّ حينَ أراكِ الشِّعرُ يَغمرُني","أُهديكِ يا مُنيَتي بالعشقِ أبياتي",33,"ت",2,0],["في التيه كنتُ وكان عمري زاده","عاد الجميعُ ولم أزلْ منفيّا",34,"ي",2,0],["في التِّيهِ وجهًا قدْ ألَمَّ به الجَفَا","ومسالبُ الضَّحِكاتِ دَقَّتْ أعْظُمي",35,"م",2,0]]}