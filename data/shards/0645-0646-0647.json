"https://www.poetsgate.com/ViewPoem.aspx?id=25883",""],[85,"أخذتْ نعشكِ مصرُ باليمينْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9630&r=&rc=120",""],[3,"عفتِ الديارَ وباقي الأطلال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10735&r=&rc=89",""]],"verses":[["مِنهُم وَراءَ التُربِ أَم","ثالُ الصَوارِمِ وَالعَوالي",0,"ي",1,0],["مِن هاشِمٍ أَكرَمِ مَن حَجَّ وَمَن","جَلَّلَ بَيتَ اللَهِ بِالوَصائِلِ",1,"ل",1,0],["مِن هاشِمٍ أَنتَ في صَمّاءَ شاهِقَةٍ","لَها رِواقٌ بِباعِ المَجدِ مَعمودُ",2,"د",1,0],["مِنهمُ الجَعفِيُّ لا يُع","رَفُ في العِلمِ ضَريبُهْ",3,"ب",2,0],["منها الندىً والرّدى فالمُعْتَفونَ رأَوْا","أرْزاقَهُمْ مَعَ آجالِ العِدا فيها",4,"ي",3,0],["مِنهُنَّ لَيلى ولا أبغِي بِها بَدَلاً","تَجْزي المُحبِّينَ بالتَّقريبِ إبْعادا",5,"د",2,0],["من هذه الأرض هذي الأغنيات، ومن","رياضها هذه الأنغام تنتثر",6,"ر",1,0],["من هذه الأرض حيث الضوء يلثمها","وحيث تعتنق الأنسام والشجر",6,"ر",1,0],["مِنهُم أَبي شَدّادُ أَكرَمُ والِدٍ","وَالأُمُّ مِن حَلمٍ فَهُم أَخوالي",7,"ل",2,0],["مِنهُم حُمَيدٌ وَداودٌ وَصاحِبُهُ","وَالأَخنَسِيُّ وَبِشرٌ وَاِبنُ سَيّارِ",8,"ر",1,0],["مَنْ هزّ دوْحَ رِضاكَ مُمْتازاً بهِ","حتّى دَنَتْ منْ راحَتَيْهِ ثِمارُهُ",9,"ر",2,0],["مِن هَواهُنَّ يَتَّبِعنَ نَواهُن","نَ فَقَلبي بِهِنَّ كَالمَشغوفِ",10,"ف",1,0],["مِنهُ تَظَلُّ حَميرُ الوَحشِ ضامِرَةً","وَلا تُمَشّي بِواديهِ الأَراجيلُ",11,"ل",1,0],["مِنها اِستَمَدَّ قُواهُ مَن","قَهَرَ المَمالِكِ وَاِستَعار",12,"ر",1,0],["منهرتُ الشِدقِ كالِحُ الوَجهِ صُلبُ ال","متنِ صَعبُ المِراسِ مُستَشري",13,"ي",1,0],["مَنها اِتِّقائي لِأَن أَكونَ أَنا ال","جالِبَ ما قُلتُهُ إِلى هَجَرِ",14,"ر",1,0],["مِنْهُمُ فِي ذُرَاكَ جَارٌ وَلَكِنْ","مَا غَرِيبٌ تَظَلُّه بِغَرِيبِ",15,"ب",1,0],["منها علمت بما أجد","ته مساعيك الجسام",16,"م",1,0],["مَنْ هِيَ بِنْتٌ مِنْ بَنَاتِ الأَسَى","مَعْرُوضَةٌ لِلصَّفْقَةِ الخَاسِرَهْ",17,"ر",2,0],["مِنْهَا اسْتَمَدَّتْ مِصْرُ مَجْداً يَلْتَقِي","فِيهِ جَدِيدٌ بَاهِرٌ وَقَدِيمُ",18,"م",1,0],["مِنهُم أَبو الحَسَنِ الساقي العِدا جُرَعاً","مِنَ الرَدى بِحُسامٍ لا بِكاساتِ",19,"ت",1,0],["منها تهدي إلينا","مسكها فطيّ الأرياح",20,"ح",1,0],["من هاشم في سماء العزْ مطلعُهُ","أكرمْ بِهِ نسباً بالعزْ مُتَّشِحا",21,"ح",2,0],["منهم وأما نحسهم فقد وَقَد","وقد أضاعوا مجدهم إلى الأبد",22,"د",1,0],["منها الفنا وبها البقا","ومن الفناء هي الوقاية",23,"ا",3,0],["مِنهُم عُتَيبَةُ وَالمُحِلُّ وَقَعنَبٌ","وَالحَنتَفانِ وَمِنهُمُ الرِدفانِ",24,"ن",1,0],["مِنهُ بِمُجتَمَعِ الأَخادِعِ نابِعٌ","يَغشى الذَفارى كَالكَحيلِ القاطِرِ",25,"ر",1,0],["مَن هَداهُ سُبُلَ الخَيرِ اِهتَدى","ناعِمَ البالِ وَمَن شاءَ أَضَلّ",26,"ل",1,0],["مِنها حُوَيٌّ وَالذَهابُ وَقَبلُهُ","يَومٌ بِبُرقَةَ رَحرَحانَ كَريمُ",27,"م",1,0],["مِنهُمُ أَصلي فَمَن يَفخَر بِهِ","يَعرِفِ الناسُ لِفَخرِ المُفتَخِر",28,"ر",1,0],["مِنهُم أَبو العاصي تَجَدَّلَ مُقعَصاً","عَن ظَهرِ صادِقَةِ النَجاءِ سَبوحِ",29,"ح",1,0],["مِنهُم رَسولُ الهُدى وَاللَهُ فَضَّلَهُ","ما في الأَنامِ لَهُ عَدلٌ وَلا كَثَبُ",30,"ب",1,0],["من هبات الوهَّاب في الخلق تبقى","طول دهر وفي العدى سمّ ساعه",31,"ع",2,0],["مِن هَواءٍ ثُمَّ نارِ","ثُمَّ مِن ماءٍ فراتِ",32,"ت",1,0],["منه بلاءٌ باستهِ","ليست عليه بالمُثابَهْ",33,"ب",2,0],["منهمُ معشرٌ ومنهمْ أناسٌ","فَضَّلَتهُمْ بفضلها الألبابُ",34,"ب",1,0],["منهم ذوو الجهر والأصالة وال","معروفِ والنُّكْر حين تَطَّلبُهْ",35,"ب",2,0],["منه وذاك الحاجب المزَجَّجا","والناظرَ الساحر منه الأدعجا",36,"ج",2,0],["منْهُمُ الغيْثُ والصَّوَاعِقُ في النَّا","سِ وفي كلِّ مَحْلَةٍ جَارُودِ",37,"د",1,0],["منْهُمُ من نُصِرَ الحقُّ به","إذ من الأوْثان للنَّاس عُبُودُ",38,"د",1,0],["من هُدُوٍّ وليس فيه انْقِطاعٌ","وشُجُوٍّ وما به تبليدُ",39,"د",1,0],["منها الكرامة وهي الفرض توجبهُ","وعند طولك أنفال له أُخَر",40,"ر",1,0],["منها متاع إلى حينٍ لصاحبها","وللعيال وللإخوان والجار",41,"ر",1,0],["منه هَوى واعتقادٌ","ومنك مقْتٌ ورفض",42,"ض",1,0],["منها معالمُ للهُدَى ومصابحٌ","تجلو الدجى والأخريات رُجومُ",43,"م",1,0],["من هاشم في أنفِها","فارجعْ بأنفٍ ذي هُشوم",44,"م",1,0],["منهما شيخٌ جليل","من رسولِ اللَّهِ داني",45,"ن",2,0],["مِنْ هالكٍ وقتيلٍ بينَ مُعْتَبَطٍ","وبينَ فانٍ بِتَرْكِ الدَّهْرِ مَطْحون",46,"ن",1,0],["مِنهُنَّ ثُمَّتَ يَزفي قَذفُ أَرجُلِها","إِهذابَ أَيدٍ بِها يَفرينَ كَالعَذَبِ",47,"ب",1,0],["مَن هُوَ المائِتُ مِن عام وَمِن مِليونِ عام","أَيَصيرُ الوَقتُ في الأَرماسِ مَحواً لَستُ أَدري",48,"ي",1,0],["مِنها صَريعٌ وَضاغٍ فَوقَ حَربَتِهِ","كَما ضَغا تَحتَ حَدِّ العامِلِ الصُرَدُ",49,"د",1,0],["مِنها الفَضاءُ ظَلامٌ","والنَّاسُ منْها سُكارى",50,"ر",2,0],["من هُرمُسُ من سيبَوي","هِ من ابن فورَك إِن تُناظِرْ",51,"ر",1,0],["مِنهُنَّ مَن يَفهَم شَيئاً فَقَد","خِفنا عَلَيهِ لِلبُكاء العَمى",52,"م",2,0],["منه بكر يطرى ومنه عوان","لم تحز رتبة الكعاب الخريد",53,"د",1,0],["من هالة لهاله","يمزق الجهالة",54,"ه",1,0],["منهل العالمين من كل جنس","وخِوان لكل قاصٍ دانى",55,"ن",2,0],["منّة للدار نذكرها","بلسان المدمع الهتن",56,"ن",1,0],["مِنهُمو كُلُّ فَتىً سادَ وَشاد","مِنهُمو إِسكَندَرٌ وَاِبنُ زِياد",57,"د",1,0],["مِن هِمَّةِ المَحكومِ وَهوَ مُكَبَّلٌ","بِالقَيدِ لا مِن هِمَّةِ الحُكّامِ",58,"م",1,0],["مُنهِضُ الشَرقِ عَلِيٌّ لَم يَزَل","مِن بَنيهِ سَيِّدٌ في عابِدين",59,"ن",1,0],["مِنها المُشَيَّدُ كَالبُروجِ وَبَعضُها","كَالطَودِ مُضطَجِعٌ أَشَمُّ مُنَطَّقُ",60,"ق",1,0],["مِنها الحَياةُ لَنا وَمِنها ضِدُّها","أَبَداً نَعودُ لَها وَمِنها نُخلَقُ",60,"ق",1,0],["مِنهُ تَعَلَّمَ عَبدٌ شَقَّ هامَتَهُ","خَونَ الصَديقِ وَدَسَّ الغَدرِ في المَلَقِ",61,"ق",1,0],["مِنها إِذا يُثغَ لَهُ لا يَغزَلِ","مُوَجَّدِ الفِقرَةَ رِخوِ المَفصِلِ",62,"ل",1,0],["مِنها شَرابي وَبِها اِغتِسالي","لا تَخطُرُ الفَحشاءُ لي بِبالِ",63,"ل",1,0],["مِنهُ ما يَجلُبُ البَراعَةُ وَالفَض","لُ وَمِنهُ ما يَجلُبُ البِرسامُ",64,"م",1,0],["منه تجسد ماؤنا","وتروح الأرض الصليب",65,"ب",1,0],["منهم في الرِّقاب غِلٌّ ثقيلٌ","فإِذا أحسنوا إِليَّ أساءُوا",66,"ا",1,0],["مِنهُمُ الحَمدُ وَالثَناءُ وَمِنكَ ال","عَدلُ فيهِم وَالنائِلُ المَشكورُ",67,"ر",1,0],["مُنهِضُ الزَحفِ لِلمُعادينَ يَبدو","حَثُّ سُرعانِهِ وَتُبنى مَنارُه",68,"ر",2,0],["مِن هَؤُلاءِ لَهُ حَزمٌ وَتَجرِبَةٌ","وَهَؤُلاءِ شَذا كَرٍّ وَإِقدامِ",69,"م",1,0],["مِنها الثَرى وَحَصى قَيسٍ إِذا حُسِبَت","وَالضارِبونَ إِذا ما اِغرَورَقَ البَصَرُ",70,"ر",1,0],["مِنهُم مَساعِرَةُ الشَهباءِ إِذ خَمَدَت","وَالمُصطَلوها إِذا مَشبوبُها اِستَعَرا",71,"ر",2,0],["مِنهُنَّ أَيّامُ صِدقٍ قَد بُليتَ بِها","أَيّامُ فارِسَ وَالأَيّامُ مِن هَجَرا",72,"ر",2,0],["مِنهُم بِوَقعَةَ مَيِّتَينِ كِلا وَلا","وَقَعوا إِلى رُكَبِ المَطِيِّ الكُلَّلِ",73,"ل",1,0],["مِنهُم خَلائِفُ يُستَسقى الغَمامُ بِهِم","وَالمُقحِمونَ عَلى الأَبطالِ في القَتَمِ",74,"م",1,0],["مِنهُم فَوارِسُ قَيسٍ وَالَّذينَ لَهُم","قِبصُ الحَصى وَثِقالُ الوَزنِ ميزانا",75,"ن",2,0],["من هم الأبرياء؟ نحن جميع","حاملو عاره ولا استثناء",76,"ا",2,0],["مَنْ هَزَّةُ الرُّمْحِ أحلى في نواظِرِه","من هَزَّةِ الغُصْنِ بين الوَرْدِ والعَنَمِ",77,"م",1,0],["منه الكتائبُ والرَّاياتُ مُوفِيةٌ","على الخليج ومنه الكُتْبُ والرُّسُلُ",78,"ل",1,0],["مَنَّهُمُ السَيرُ فَاِنآدَت سَوالِفُهُم","وَما بِأَعناقِهِم إِلّا الكَرى أَوَدُ",79,"د",1,0],["مِنها إِذا اِحتَضَرَ الخُطوبُ مُعَوَّلٌ","وَقِرىً لِحاضِرَةِ الهُمومِ وَمَهرَبُ",80,"ب",1,0],["مِنهُمُ الوالِدُ الشَفيقُ عَلَينا","وَالأَخُ المُمحِضُ الوَصولُ الأَثيرُ",81,"ر",1,0],["مَن هاتِه الحسناءُ يا عيني","السحرُ كلّلها وظلّلها",82,"ه",2,0],["مَن همُّه هَمّي سيح","مل مِن حبيبٍ ما يشاء",83,"ا",2,0],["مِنهُمُ موسى جَوادٌ ماجِدٌ","لا يَرى ما لَم يَهَب مِمّا مَلَك",84,"ك",1,0],["منْ هوَ فخرُ الدينِ عثمانُ في","مراحمِ اللهِ وإحسانِهِ",85,"ن",2,1],["منها خلقْتَ فلمْ يسمحْ زمانُكَ أنْ","يشينَ حسنَكَ فيهِ الشيبُ والكبرُ",86,"ر",1,0],["مِن هَوى خودٍ لَعوبٍ","غادَةٍ مِثلِ الهِلالِ",87,"ل",1,0],["مِنْ هَيْبَةٍ يُغضي القريضُ ويُطرِقُ","وَيميلُ فيكَ إلى السُّكوتِ المنطقُ",88,"ق",1,1],["من هِمَّةِ الرُسْلِ ما يَغتالُها خَوَرٌ","ولا يَطيشُ بها مالٌ ولا جاهُ",89,"ا",2,0],["من هؤلاءِ وهؤلاءِ نَعدُّهم","سَبعينَ تقتلُهم جزَاءً وافيا",90,"ي",2,0],["مَنْ هُمْ أيجملُ أن يقالَ تَحكَّموا","فينا ونحن السَّادَةُ الأقطابُ",91,"ب",1,0],["مِن هَيفا صادَت قُلوبَ الصيد","لَم تَترُك لِمَن سَلا عُذرَه",92,"ه",1,0],["مَنهوبُ ما تَحتَ النِقابِ عَفيفُهُ","نَهّابُ ما بَينَ الجُفونِ مُريبُهُ",93,"ب",2,0],["مَن هفا للمثل الأَعلى يَجد","في بَني هاشم أَعلى مثلِ",94,"ل",1,0],["مِنها خُلِقنا وَكانَت أُمُنا خُلِقَت