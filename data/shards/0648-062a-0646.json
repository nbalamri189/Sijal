abi.ae/diwan/poem/54306","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54296","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54288","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54216","الرمل"],[106,"رسل الثقافة","https://www.poetsgate.com/ViewPoem.aspx?id=179609",""],[106,"أجادير","https://www.poetsgate.com/ViewPoem.aspx?id=179602",""],[106,"آهة طفلة","https://www.poetsgate.com/ViewPoem.aspx?id=179661",""],[106,"أعياد النصر","https://www.poetsgate.com/ViewPoem.aspx?id=179343",""],[106,"رويدك يا جمال!","https://www.poetsgate.com/ViewPoem.aspx?id=179353",""],[100,"فارس الاصطياف","https://www.poetsgate.com/ViewPoem.aspx?id=50417",""],[100,"نهاية حسناء ريفيّة","https://www.poetsgate.com/ViewPoem.aspx?id=50449",""],[100,"ياقارئي","https://www.poetsgate.com/ViewPoem.aspx?id=50457",""],[78,"مجلس شراب","https://www.poetsgate.com/ViewPoem.aspx?id=12700",""],[90,"إلى الرّصافي","https://www.poetsgate.com/ViewPoem.aspx?id=179197",""],[90,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[90,"احمد شوقي","https://www.poetsgate.com/ViewPoem.aspx?id=179129",""],[90,"يدي هذه رهن","https://www.poetsgate.com/ViewPoem.aspx?id=179108",""],[90,"سامراء","https://www.poetsgate.com/ViewPoem.aspx?id=179132",""],[90,"الشاعر المقبور","https://www.poetsgate.com/ViewPoem.aspx?id=178931",""],[45,"لدارِكِ، يا لَيلى، سَماءٌ تَجودُها","https://www.poetsgate.com/ViewPoem.aspx?id=31695",""],[91,"وردة وأميل","https://www.poetsgate.com/ViewPoem.aspx?id=53233",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"],[31,"يا صاحبيّ، قفا نقضِّ لبانة ً،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18929&r=&rc=192",""],[96,"عدلي يكن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66356&r=&rc=32",""],[96,"الوحي الخالد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66324&r=&rc=3",""]],"verses":[["وَتَنفَضُّ بِالوَجدِ الأَليمِ أَضالِعٌ","وَتَرفَضَّ بِالدَمعِ الغَزيرِ شُؤونُ",0,"ن",1,0],["وَتَنَكُّرٌ بَدَرَت بَوادِرُهُ","مِن غَيرِ ذَنبٍ كانَ مِن لَدُني",1,"ي",1,0],["وَتَنطِفُ عَن فَمِهِ ريقَةٌ","سُوَيداءُ تَقتُلُ مِن غَيرِ سُمّ",2,"م",1,0],["وَتَناذَرِ الدَهرَ الَّذي شَرَعَ الرَدى","وَتَخَرَّمَ الأَذواءَ وَالأَقيالا",3,"ل",2,0],["وَتَنَقَّبَن بِالأَنامِلِ وَالدَم","عُ عَلى كُلِّ ذي نِقابٍ دَليلُ",4,"ل",1,0],["وَتَنكِحُ أَوتارَ الحَنايا نِبالُها","فَتَشرُدُ عَنها في نِصالٍ فَوارِكِ",5,"ك",1,0],["وَتَندى لِقَومٍ آخَرينَ سَحابُكُم","وَنَحنُ مَناشي أَرضِكُم وَالغَرائِسُ",6,"س",1,0],["وَتَناذَرَ الأَعداءُ صَولَتَهُ","فَأَباتَ أَشجَعَهُم عَلى ذُعرِ",7,"ر",1,0],["وَتَنبو أَكُفُّ العيسِ عَن عَرَصاتِهِم","مِنَ البُخلِ حَتّى تَستَغيثَ إِلى الطَردِ",8,"د",1,0],["وَتَنوشُ الوَحشُ مِن أَجسادِهِم","أَرجُلَ السَبقِ وَأَيمانَ النَدى",9,"ا",1,0],["وَتَنهَضُ في صَهَواتِ الهَجي","رِ بَينَ النِعامِ وَبَينَ المَها",10,"ا",1,0],["وَتَنتَضي مِن ضُلوعِها نَفَساً","يَدمى وَيَشجى بِهِ مُقَلَّدُها",11,"د",3,0],["وَتُنكِرُ حَتىّ لَيلَةَ الجِزعِ بِالحِمى","لَيالينا بِالسَّفحِ مِن عَلَمَيْ نَجدِ",12,"د",1,0],["وتَنْهَلُّ منْ كِلْتا يَدَيْكَ غَمائِمٌ","يظَلُّ عليْهِنَّ الأمانيُّ حُوَّما",13,"م",2,0],["وتَنْضَحُ كفّاهُ نَجيعاً ونائِلاً","تدَفُّقَ نائي الحَجْرَتَيْنِ رُكامِ",14,"م",1,0],["وتنقل حول مهد المصطفى","وانشد المجد أغانيك الرِّخاما",15,"م",2,0],["وَتَنوءُ تُثقِلُها رَوادِفُها","فِعلَ الضَعيفِ يَنوءُ بِالوَسَقِ",16,"ق",1,1],["وَتَنوفَةٍ مَجهولَةٍ قَد خُضتُه","بِسِنانِ رُمحٍ نارُهُ لَم تَخمُدِ",17,"د",1,0],["وَتَنَفَّستُ إِذ ذَكَرتُكِ حَتّى","زالَتِ اليَومَ عَن فُؤادي ضُلوعي",18,"ع",2,0],["وتنكّرَتِ الدُنْيا حتّى","عُرِفَتْ منْهُ بمُعَرَّفِها",19,"ف",3,0],["وَتَنُّورُ عَزْمٍ فَارَ فِي إِثْرِ دَعْوَةٍ","يَعُمُّ الأَقَاصِي وَالأَدَانِي بِطُوفَانِ",20,"ن",1,0],["وَتَنَاكَرَ النَّاسُ الْحَديِثَ ال","حَقّ وَفْتُقِدَ الْمُعَلِّمْ",21,"م",1,0],["وتنْهَلُ منْ وِرْدِ اللّمى غُلّةَ الظّما","فيا لَكَ منْ رَيٍّ لغُلّةِ وارِدِ",22,"د",1,0],["وتنْعَمُ منْ وصْلِ الحبيبِ بجنّةٍ","هيَ الخُلْدُ لكنّ الفَتى غيرُ خالِدِ",22,"د",1,0],["وتُنْجِبُ منْ أبْنائِها كلَّ ناصِرٍ","يَفُلُّ شَباةَ الخَطْبِ والخطْبُ فادِحُ",23,"ح",1,0],["وَتَنَازَعَ الْقَصْدَانَ عَزْمِي عِنْدَهَا","فَالضَّعْفُ يُمْسِكُ وَالتَّشَوُّقُ يَجْذِب",24,"ب",1,0],["وَتَنفي الضَفادِعَ أَنفاسُها","فَهُنَّ فُوَيقَ الرَجا يَرتَقينا",25,"ن",2,0],["وََتَنكَّرَت لي بَعدَ وُدٍّ ثابِتٍ","أَنّى تَجامُعُ وَصَلِ ذي الأَلوانِ",26,"ن",1,0],["وَتَنتَخِب صَفوَةَ أَبنائِها","فَمِنهُمُ المُخلِصُ وَالمُصلِحُ",27,"ح",1,0],["وَتَنابَلوا بِالكيمِياءِ فَأَسرَفوا","وَتَساجَلوا بِالكَهرُباءِ فَأَغرَقوا",28,"ق",3,0],["وَتَنازَلوا في الجَوِّ حينَ بَدا لَهُم","أَنَّ البَسيطَةَ عَن مَداهُم أَضيَقُ",28,"ق",1,0],["وَتَنظِمُ فِيَّ عُقودَ الجُمانِ","وَتَنثُرُ فَوقي نِثارَ الذَهَب",29,"ب",1,0],["وَتَنَبَّهوا لِمُصابِهِم فَتَضَرَّعوا","فَعَفا وَعاوَدَهُم بِغَيرِ عِتابِ",30,"ب",1,0],["وَتَنَظَّري إِنَّ الخَلاصَ مُحَتَّمٌ","فَاللَهُ أَسلَمَ أَمرَنا لِمُوَفَّقِ",31,"ق",1,0],["وَتَنَقَّلتُ في خَمائِلِها الخُض","رِ يَميناً وَيَسرَةً وَأَماما",32,"م",2,0],["وَتَنزِلُ فيهِ الشَمسُ في العامِ مَرَّةً","وَتَرحَلُ عَنهُ مِثلَما نَزَلَت حَتما",33,"م",2,0],["وَتَنَفَّسَت عَن عَنبَرٍ عَبقٍ","وَتَبَسَّمَت عَن واضِحٍ رَتِلِ",34,"ل",1,0],["وَتَنَظَّمَ المَنثورُ وَافتضحَ النَ","مامُ وَاِنقَبَضَت يَدُ الطَفَلِ",34,"ل",1,0],["وَتَنوفَةٍ حَرداءَ مُهلِكَةٍ","جاوَرتُها بِنَجائِبٍ فُتلِ",35,"ل",1,0],["وتنسمت ريح المنى تلك المنى","فتبسمت في أوجه النظار",36,"ر",1,0],["وَتَنَاثَرَتْ ضُفُرُ الفَتَاةِ غَمَائِماً","سَتَرَتْ عَنِ الأَبْصَارِ طَلْعَةَ نَجْمِهَا",37,"م",3,0],["وَتَنَادَى حُمَاتُهَا وَتَلاقَى","فِي السَّرَايَا مِنْ بِالوَفَاءِ يَدِينُ",38,"ن",1,0],["وَتَنْفَحُ فِيهَا نَفْحَةً عَبْقَرِيَّةً","نُسَيْمَاتُ رَوْضٍ فِيهِ وَرْدٌ وَرَيْحَانُ",39,"ن",1,0],["وَتَنَافَسَتْ خُضْرُ الخَمَائِلِ بِالحِلَى","وَتَدَفَّقَتْ بِالكَوْثَرِ الأَعْلامُ",40,"م",1,0],["وَتُنْجِ زَوْجاً أَذَابَ الضَّعْفُ مُهْجَتَهَا","وَوُلْدُهَا الكُثْرُ مِنْ عُدْمٍ وَمِنْ عَدَمِ",41,"م",1,0],["وَتَنَافَسَتْ بِحُلِيِّهَا أَيَّامُهَا","فَكَأَنَّهُنَّ عَرَائِسُ الأَيَّامِ",42,"م",1,0],["وَتَنَكَّرَتْ زِيناتُهَا فِي خَاطِرِي","حَتَّى لَتَنْكِرَ حِبْرَهَا الأقْلامُ",43,"م",1,0],["وَتَنَاسَقَتْ وِجْهاتُهَا وَتَسَاوقَتْ","حَرَكَاتُهَا وَتَيَقَّظَ النَّوَّامُ",43,"م",1,0],["وَتَنْظُرُ فِي السَّرَائِرِ وَالطَّوَايَا","مُمَحَّصَةَ الحَميدِ مِنَ الذَّمِيمِ",44,"م",1,0],["وتنتابها هيفُ العصي كأنها","سِهام وعاها للرمية نابلُ",45,"ل",1,0],["وتنوب عن صوب الغمام أكفُّهم","وتنوب أوجُههم عن الأقْمارِ",46,"ر",1,0],["وتناقلوا عنك الحديث مسرَّةً","بسماعه واهتزّ ذاك المحفلُ",47,"ل",1,0],["وتنشر الطيب له نافحا","كأنها تقصد انشاقه",48,"ه",1,0],["وتنكر الخيل أن جارته في سنن","ما تعرف الخيل من حضرٍ وتقريب",49,"ب",1,0],["وتُنهضني للمجد بالعزم ماضياً","وبالهمّ مقلاقاً وبالرأي صائبا",50,"ب",2,0],["وتَنهج منهج العُمران فيما","بها للناس من دَخْل وخَرج",51,"ج",1,0],["وتُنعش من صميم المجد روحاً","بأزهار لها ُمتَضوِّعات",52,"ت",1,0],["وتنبت الحارث الفلاّح مزدرعاً","وتنبت المِدْرَه المِنطيق مرتجلا",53,"ل",2,0],["وتَنهض للأرقال في غير مَنهضٍ","وتَبرُك أحياناً على غير مَبرَك",54,"ك",1,0],["وَتَنفيكَ عَمروٌ عَن حِماها وَعامِرٌ","فَما لَكَ إِلّا عِندَ كيرِكَ مَطبَعُ",55,"ع",1,0],["وَتُنكِرُ هَزَّ المَشرَفِيِّ يَمينُهُ","وَيَعرِفُ كَفَّيهِ الإِناءُ المُكَتَّفُ",56,"ف",1,0],["وَتَنزِلُ مِن أُمَيَّةَ حَيثُ تَلقى","شُؤونُ الهامِ مُجتَمَعَ الصَميمِ",57,"م",1,0],["وتنأى قعورُهم في الأمور","على من يُسِمّ ومن يُسمِلُ",58,"ل",1,0],["وَتَنَاوَلتُ من تَنَاوَلَ بالغِي","بَةِ أعرَاضَهم وَقَلَّ اكتِتامي",59,"م",2,0],["وَتَنطِقُ إِن نَطَقتَ بِلا صَوابٍ","وَأَيقَنَ بِالمَخازي وَاللِفاظِ",60,"ظ",1,0],["وتنميق ألفاظٍ عليك رقيقة","كأنيَ من نثر الدموع نظمتها",61,"ت",3,0],["وتنزهت في حكمها عن قادحٍ","كلمٌ تضيء إضاءة المقباس",62,"س",1,0],["وتنكرت صفة الغوير فلم يكن","ذاك الغوير ولا النقا ذاك النقا",63,"ق",2,0],["وتنْتهي بي إلى أبوابه مِدَحٌ","تخطو وتخطر بين الحلي والحلل",64,"ل",1,0],["وتناهت الأهوا إليه كما انْتهى","معنى السيادة للمليك الكامل",65,"ل",1,0],["وتنمى بلا ثانٍ لها عن فخارها","إلى سادةٍ يا طيب فخر ومنعما",66,"م",2,0],["وتنال ما أعيى الرجال كأنَّها","جدٌّ وأبناء الزمان مجون",67,"ن",1,0],["وتناولتَني ببرِّ فبرَّتْ","ك يد الله ثَرَّةً بيضاءَ",68,"ا",2,0],["وتنفطرُ الأكبادُ عند شُمولهِ","كأنّ الطِّباق السبع منفطرات",69,"ت",1,0],["وتَنْسين ذاكَ الهولَ حتى تُعاودي","رُكوب طوالٍ كالرّشاء عِراض",70,"ض",1,0],["وتنفست فيه الصبا فتبجست","منه الكلى فأديمه معقوق",71,"ق",1,0],["وتنسمت نفحاته فكأنه","مسك تضوع فأره مفتوق",71,"ق",1,0],["وتنمَّر للشانئين أبا إس","حاق بعداً للشانئيه وسحقا",72,"ق",2,0],["وتُناك غيرَ مُساترٍ","للغانيات ولا مخاتلْ",73,"ل",1,0],["وتناهيْتُ مُعْظِماً لمَشيبي","ومَشيبي أحقُّ بالإعظام",74,"م",1,0],["وتنسَّمتُ من مشارق بغدا","دَ نسيما يشفي رَداع السقيم",75,"م",1,0],["وَتَناجَت تَبغي النَجاةَ فِراراً","أَينَ أَينَ المَفَرُّ مِن ذا القَضاءِ",76,"ا",2,0],["وَتَنامُ في صَدرِ الشَجِيِّ هُمومُهُ","وَيُفيقُ في قَلبِ الحَزينِ سُرورُهُ",77,"ر",2,0],["وَتَنكُثُ المِرآةَ ميثاقَها","وَكَيفَ يُجزي المُجرِمُ القاتِلُ",78,"ل",1,0],["وَتَناثَرَت قِطَعُ السَحابِ كَأَنَّها","الجَيشُ اللَهامُ إِذا اِنثَنى مَفلولا",79,"ل",2,0],["وَتَنجَلي الأَنجُمُ في لَيلِهِ","ضاحِكَةً كَالغيدِ في عُرسِ",80,"س",1,0],["وَتَنَحّى أَهلُ الهَوى عَن طَريقي","وَاِنثَنى عَزمُ مَن يَرومُ لِحاقي",81,"ي",1,0],["وتنادَوْا بهِ إلى النَّارِ فالنَّا","رُ بِرُوحِ الخبيثِ أَحْرى وأَوْلى",82,"ا",1,0],["وتناسى الحَيَاةَ والزَّمنَ الدَّاوي","وما كانَ مِنْ قديمِ رِغَابِهْ",83,"ه",1,0],["وتنمو بصدري وُرُودٌ عِذابٌ","وتحنو على قلبيَ المشْتَعِلْ",84,"ل",1,0],["وتناثَرَتْ أَوراقُ أَحلامي","على حَسَكِ المَمرِّ",85,"ر",1,0],["وَتَناهَضَت زُهرُ النُجوم يَحُفُّهُ","لألاؤها فاِستَكمَلَ اللألاءَ",86,"ا",2,0],["وَتَناكَرَت هِمَمي لَما","يَستامها الخَطبُ الفَظيعُ",87,"ع",1,0],["وَتَندُبُهُ البيضُ الصَوارِمُ وَالقَنا","وَينهلُّ دَمعٌ بينَهُنَّ غَزيرُ",88,"ر",1,0],["وتنكبي الوهد الذي","يخفيك واطلبي الهضابا",89,"ب",2,0],["وتنوع الحيوان يرقى صاعدا","حتى بدا القرد السوي الافرع",90,"ع",1,0],["وتنشر الامن في بدوٍ وفي حضر","وتمل الارض عمرانا وتحييها",91,"ي",3,0],["وتنقل التيمس ما","يقوله ويطلب",92,"ب",1,0],["وتنَجد مقلة في الله يقظى","وتخلفها على أمم نيام",93,"م",1,0],["وَتَنثَني في عَرَقٍ سائِلٍ","مُنَكَّسَ الرَأسِ ضَئيلَ الفُؤاد",94,"د",1,0],["وَتَنشُرُ رَيحانَتَي زَنبَقٍ","مِنَ الشِعرِ في رَبَواتِ اليَمَن",95,"ن",1,0],["وَتَنازَعوا الذَهَبَ الَّذي","كانوا لَهُ يَتَفاتَنون",96,"ن",1,0],["وَتَنادَمَ الأَحياءُ وَالمَوتى بِها","فَكَأَنَّهُم في الدَهرِ لَم يَتَفَرَّقوا",97,"ق",3,0],["وَتَنَظَّمَت بيضُ البُيوتِ كَأَنَّها","أَوكارُ طَيرٍ أَو خَميسٌ عَسكَرا",98,"ر",2,0],["وَتُنازِعونَ الحَيَّ فَضلَ ثِيابِهِ","وَالمَيتَ ما قَد رَثَّ مِن أَكفانِهِ",99,"ن",2,0],["وَتَنَكَّبوا العُدوانَ وَاِجتَنِبوا الأَذى","وَقِفوا بِمِصرَ المَوقِفَ المَحمودا",100,"د",2,0],["وَتَنزِل عَلَيها مِن سَماءِ خَيالِها","صَواعِقٌ فيهِنَّ الرَدى المُتَصَبِّبُ",101,"ب",1,0],["وَتُنيلُ الوُجودَ مِنهُ نِظاماً","هُوَ طِبُّ الوُجودِ وَهوَ الدَواءُ",102,"ا",2,0],["وَتُنكِرَ مَوتَهُم وَأَنا سُهَيلٌ","طَلَعتُ بِمَوتِ أَولادِ الزِناءِ",103,"ا",2,0],["وَتَنسُبُ أَفعالُ السُيوفِ نُفوسَها","إِلَيهِ وَيَنسُبنَ السُيوفَ إِلى الهِندِ",104,"د",1,0],["وَتَنظُرُ مِن سودٍ صَوادِقَ في الدُجى","يَرَينَ بَعيداتِ الشُخوصِ كَما هِيَ",105,"ي",1,0],["وَتَنصِبُ لِلجَرسِ الخَفيِّ سَوامِعاً","يَخَلنَ مُناجاةَ الضَميرِ تَنادِيا",105,"ي",2,0],["وتنمو الزروع وتزكو الربوع","ويزهر من نبتها ما نجم",106,"م",1,0],["وتنازعَ الملكَ الشَّعاعَ عِصابةٌ","لم يُدْرَ أيهُّمُ به المفتونُ",107,"ن",1,0],["وتناهبوا ما لم يكنْ من قبلُ ذو ال","قرنين يملِكُه ولا قارونُ",107,"ن",1,0],["وتنسَى حقوقي عندَ أولِ زَلَّةٍ","وأنتَ لأهلِ المكرماتِ إِمامُ",108,"م",1,0],["وتنبَّهَتْ للحظِّ مقترِناً","بفضيلةٍ فرمتْهُ بالوَكْسِ",109,"س",1,0],["وَتَنهَضَ في الأَبطالِ تُفني عَديدَها","وَسُؤلُكَ في أَنَّ التُرابَ عَديدُها",110,"د",3,0],["وَتَناوَلَ الضَحّاكَ مِن خَلفِ القَنا","وَالمَشرَفِيَّةِ وَالعَديدِ الأَكثَرِ",111,"ر",1,0],["وَتَنَصَّفَ الدُنيا يُدَبِّرُ أَمرَها","سَبعينَ حَولاً قَد تَمَمنَ دَكيكا",112,"ك",2,0],["وَتَنَفَّسَت فيهِ الصَبا فَتَعَطَّفَت","أَشجارُهُ مِن حُيَّلٍ وَحَوامِلِ",113,"ل",1,0],["وَتَنسى حَظَّ خَولَةَ في المَخازي","وَلِعبَ أَبي الفَوارِسِ بِالطَويلِ",114,"ل",1,0],["وَتَنَفَّسَت بِكَ في المَكارِمِ هِمَّةٌ","نَزَلَت مِنَ العَلياءِ أَرفَعَ مَنزِلِ",115,"ل",1,0],["وَتَنَفَّسَت أَنفاسُ كُلَّ قَرارَةٍ","وَتَغَنَّتِ الأَطيارُ في الأَفنانِ",116,"ن",1,0],["وَتَنهَضُ حينَ تَنهَضُ لِلمَعالي","وَتَنطِقُ حينَ تَنطِقُ بِالبَيانِ",117,"ن",1,0],["وتَناهبا منه دمي فرَجَعنَ دا","ميةَ النحورِ عواطلا",118,"ل",2,0],["وتناهبا منه دمى حليتها","فرجعن دامية النحور عواطلا",119,"ل",2,0],["وتناهَبَتْ كاساتُها ظُلَمَ الدُّجى","نَهْبَ العُفاةِ نَدى أبي العَطَّافِ",120,"ف",1,0],["وتنَبَّهَتْ منهُم لبا","قي العِزِّ والشَّرفِ القُدامِس",121,"س",1,0],["وَتَنوفَةٍ عَمياءَ لا يَجتازُها","إِلّا المُشَيَّعُ ذو الفُؤادِ الهادي",122,"ي",1,0],["وَتَنضِحُ ذِفراها بِجَونٍ كَأَنَّهُ","عَصيمُ كُحَيلٍ في المَراجِلِ مُعقَدِ",123,"د",1,0],["وَتَنفُضُ عَنها غَيبَ كُلَّ خَميلَةٍ","وَتَخشى رُماةَ الغَوثِ مِن كُلِّ مَرصَدِ",123,"د",1,0],["وَتَنفَطِرُ الأَرضُ مِن نَفحَةٍ","هُنالِكَ تُخرِجُ أَثقالَها",124,"ل",3,0],["وَتَنالَ عَيشاً لا اِنقِطاعَ لِوَقتِهِ","وَتَنالَ مُلكَ كَرامَةٍ لا تُسلَبُ",125,"ب",1,0],["وَتَنقُصُ في كُلِّ تَنفيسَةٍ","وَأَنتَ بِظَنِّكَ فيها تَزيدُ",126,"د",1,0],["وَتَناوَلَت فِكَري عَجائِبُ جَمَّةٌ","بِتَصَرُّفي في الحالِ بَعدَ الحالِ",127,"ل",1,0],["وَتَنميقِ خَطٍّ كَما نَمَّقَت","خُطوطُ الغَوالي خُدودَ الغَواني",128,"ي",1,0],["وَتَنظُرُني شَزراً مِنَ السُمرِ وَالظُبى","نَواظِرُ إِلّا أَنَّهُنَّ حَديدُ",129,"د",1,0],["وَتَنَوَّعَت بُسطُ الرِياضِ فَزَهرُها","مُتَبايِنُ الأَشكالِ وَالأَلوانِ",130,"ن",1,0],["وَتَنَبَّهوا فَكَأَنَّهُم","بِالزِجرِ فيكَ تَنَبَّأُوا",131,"ا",1,0],["وتنظر روعةَ الإِسلام فيه","وقد غَمَرَ المدائنَ واليبابَا",132,"ب",2,0],["وتنقش أصداءها في القلوب","وتبقى مدى العمر في الذاكره",133,"ر",2,0],["وتنفّستْ من رَوْض خلقك نفحَةٌ","صَحّتْ بها الآمال بعد سقامِ",134,"م",1,0],["وتنسجُ يوم الرّوعِ من نسج جردنا","عَلَينا ملاءً بِالقشاعِمِ تَرقمُ",135,"م",1,0],["وتَنَفَّسَتْ بِالندِّ فيهِ فَخَيَّمتْ","نَارٌ مواصِلَةٌ بِهِ الإِشعالا",136,"ل",2,0],["وتنفضُ رأساً في الزّمام كأنّما","تريكَ له في الجوّ نفضةَ أجْدَلِ",137,"ل",1,0],["وتَناوَلْ نَشوةً مِن رَوضَةٍ","طَلَعَت كَالشَّمسِ بِالنجمِ عَلَيك",138,"ك",1,0],["وتناولتْ يُمْناكَ ناراً لم تَخَفْ","في لمسها لَذعاً مِنَ الإحراقِ",139,"ق",1,0],["وتَنسابُ منه حَيَّةٌ غَيرَ أَنَّها","تطولُ على قَدْرِ المَسابِ وتعْرُضُ",140,"ض",1,0],["وتَنافَرَتْ عَنّي الحسانُ كما","لحظَ الهصورَ جآذرٌ خُنْسُ",141,"س",1,0],["وتَندَى بِمَفتوتٍ مِنَ المِسْكِ صائِكٍ","قَديرٍ إِلى عَصرِ الشبابِ على رَدِّ",142,"د",1,0],["وتَنامُ في وَردِ الخُدودِ ولَدغها","متسرّب من أعينٍ لِقُلوبِ",143,"ب",1,0],["وَتَنَقُّلُُ مِن مَعشَرٍ في مَعشَرٍ","فَكَأَنَّ أُمَّكَ أَو أَباكَ الزِئبَقُ",144,"ق",1,0],["وَتَنَظَّري خَبَبَ الرِكابِ يَنُصُّها","مُحيي القَريضِ إِلى مُميتِ المالِ",145,"ل",1,0],["وَتَنَبَّهَت فِكَرٌ فَبِتنَ هَواجِساً","في قَلبِ ذي سَمَرٍ بِها مُتَهَجِّدِ",146,"د",1,0],["وَتَنَدُّ عِندَهُمُ العُلى إِلّا عُلىً","جُعِلَت لَها مُرَرُ القَصيدِ قُيودا",147,"د",2,0],["وتنظرُ في القبورِ فلا تراني","وأنظرُ في القصورِ فلا أراها",148,"ه",2,1],["وتُنوهبت مِزقاً لكل مُخنثٍ","أوصال فحل ٍ خالق هدّار",149,"ر",1,0],["وَتَنكَلُّ عَن غُرٍّ شَتيتٍ نَباتُهُ","عِذابٍ ثَناياهُ لَذيذِ المُقَبَّلِ",150,"ل",1,0],["وَتَنَظَّرَت مِنّي الجَزاءَ لِوَعدِها","حَولاً تَجَرَّمَ كُلَّهُ حَتّى اِنقَضى",151,"ض",2,0],["وَتَناءى عَنهُ الحَبيبُ فَأَضحى","بَعدَ قُربٍ قَد شَطَّ عَنهُ المَزارُ",152,"ر",1,0],["وَتَنو فَتَصرَعُها عَجيزَتُها","مَمشى الضَعيفِ يَؤودُهُ البُهرُ",153,"ر",1,0],["وَتَنوفَةٍ أَرمي بِنَفسي عَرضَها","شَوقاً إِلَيكِ بِلا هِدايَةِ هادي",154,"ي",1,0],["وَتَندى بِها في مَهَبِّ الصَبا","زَبَرجَدَةٌ أَثمَرَت بِالذَهَب",155,"ب",1,0],["وَتَنَفَّسَت عَن كُلِّ نَفحَةِ جَمرَةٍ","باتَت لَها ريحُ الجَنوبِ بِمَرقَبِ",156,"ب",1,0],["وَتَنقادُ غُرُّ المَعالي لَهُ","فَيَقتادُها مِقنَباً مِقنَبا",157,"ب",2,0],["وَتَنفُحُ ريحُ النَصرِ في قَبَسٍ بِهِ","فَتَخرُقُ أَقطارَ العَجاجِ وَتُحرِقُ",158,"ق",1,0],["وَتُنظَمُ في نَحرِ المعالي قِلادَةٌ","وَتُسحَبُ في نادي المَفاخِرِ أَردانُ",159,"ن",1,0],["وَتَندُبُ عَهداً قَد تَقَضّى بِرامَةٍ","وَوَكراً بِأَكنافِ المُشَقَّرِ خالِيا",160,"ي",2,0],["وَتَنهَشُني مِن حُبِّ لَيلى نَواهِشٌ","لَهُنَّ حَريقٌ في الفُؤادِ عَظيمُ",161,"م",1,0],["وتنزَّلوا مِلءَ الجِواءِ جَلالةً","وهُدىً ومِلءَ الواديَيْن وقارا",162,"ر",2,0],["وتُنوزِعَ الوادي فذَلَّ قطينُه","واعتزَّ فيه الغاصِبونَ وسادوا",163,"د",3,0],["وتنازعا نظراً يهول ومنطقاً","يُوهِي القُلُوبَ الصُّمَّ وَهْيَ صِلابُ",164,"ب",1,0],["وتنهَّدتْ مما تكنّ ضلوعُها","يا شوقُ ويحكَ لا ترع نهديها",165,"ي",3,0],["وَتَنزَلي في ذَرَى دارٍ مُعَمَّدَةٍ","لِلعُرفِ عُمدَ تِجارٍ أَمِّ أَسواقِ",166,"ق",1,0],["وَتَنَمّى كُلَّما آنَسَت","نَبأَةً وَالمُؤنِسُ الرَوعَ نام",167,"م",1,0],["وَتَنَظُّري لِغَدٍ وَما","أَعنى بِهِ مِن فَرطِ قائِل",168,"ل",1,0],["وَتَناقَلَت أَزدُ العِراقِ وَمَذحِجٌ","لِلمَوتِ يَجمَعُها أَبوها الأَكبَرُ",169,"ر",1,0],["وَتَنَقَّبنَ بِالبُرُودِ وَأَبدَي","نَ عُيُوناً حُورَ المَدامِعِ نُجلا",170,"ل",2,0],["وَتَنَحَّيتُ عَن طَريقِ الغَواني","وَالتَصابي وَقُلتُ يا نَفسِ توبي",171,"ب",2,0],["وَتَنالُ ما فاتَ العَجولَ تَمَهُّلاً","وَدَوّمُ حُضرِ الخَيلِ في تَقريبِها",172,"ب",3,0],["وتنهالُ الكتائبُ حينَ يَهْوِي","إليها مثلَ ما انهال الكثيبُ",173,"ب",1,0],["وَتَنْفَعِلُ الأَشياءُ مِنْ غَيْرِ فِكْرَةٍ","لهُ وقدِ اعْتاصَتْ عَلَى مَنْ يُفَكِّرُ",174,"ر",1,0],["وتنْظُرُ عُلْواً أينَ منكَ وُفودُها","كأنّكَ يومَ الركْبِ للبرقِ شائِم",175,"م",1,0],["وتنعَمَ بالبِيض الأوانسِ كالدُّمى","وتَرفُلَ من دُنياكَ في حُلَلٍ خُضر",176,"ر",1,0],["وَتَنوفَةٍ يَجري السَرابُ بِها","شارَفتَها وَالظِلُّ قَد مَصَحا",177,"ح",2,0],["وَتَنوفَةٍ تَمشي الرِياحُ بِها","حَسرى وَيَشرَبُ مائُها نُطَفا",178,"ف",2,0],["وَتَنَقّى مِن قُرَيشٍ","جَوهَرَ العِزِّ المُنَقّى",179,"ق",2,0],["وَتَناساها الجَديدانِ حَتّى","هِيَ أَنصافُ شُطورِ الدَنانِ",180,"ن",1,0],["وَتَناوَحَت شُعَبَ الذِئا","بِ وَلَم تَجِد عَوداً بِعاضِد",181,"د",1,0],["وَتَناسَيتُ لِأَنسى","فَاِعتَراني كَالسُباتِ",182,"ت",1,0],["وَتَنَقُّصُ المَولى مَوالِيَهُ","عارٌ يَكونُ بِوَجهِهِ نَدَبُه",183,"ب",2,0],["وَتَنالَ مِنهُ غَير واحِدَةٍ","إِنَّ السَماعَ لَأَهوَنُ الخَطبِ",184,"ب",1,0],["وَتَنحَط حَصانٌ آخِرَ اللَيلِ نَحطَةً","تَقَضقَضُ مِنها أَو تَكادُ ضُلوعُها",185,"ع",3,0],["وَتُنقَلُ مِنها فَالسَعيدُ مُكَرَّمٌ","بِما هُوَ لاقٍ وَالشَقِيُّ مُشَذَّبُ",186,"ب",1,0],["وَتَنقُصُ خَيرَها أَشَراً وَفَتكاً","صَواحِبُ مَنطِقٍ مُتَزَيِّداتُ",187,"ت",1,0],["وَتَنعَكِسُ الحالُ حَتّى تَرى","ظِباءَ الأَراكِ يُخِفنَ الأُسودا",188,"د",2,0],["وَتَنزِلُني سُيولُ الدَهرِ كُرهاً","إِلى وادي مِن جَبَلي وَنَعفي",189,"ف",2,0],["وتُنْفِدُ كلّ وَفْرٍ حُزْتَ قَسْراً","لعِلْمِكَ أنّ آخِرَهُ نَفادُ",190,"د",1,0],["وَتَنزِلُ مِنها بِالمَكانِ الَّذي بِهِ","يُرى الفَضلُ في الدُنيا عَلى المُتَحَمِّدِ",191,"د",1,0],["وَتُنكِرُ يَومَ الرَّوعِ أَلوانَ خَيِلنا","مِنَ الطَعنِ حَتَّى تَحسِبَ الجَونَ أَشقَرا",192,"ر",2,0],["وتَنْدُبُها الأرواحُ حتّى حَسبتُها","صَدى حفرةٍ قامتْ عليها النوادبُ",193,"ب",1,0],["وتنبهت من مناميَ صبحاً","وإذا الشمس في السماء تنير",194,"ر",1,0],["وَتُنشد في تأبينهم شعراؤها","مراثيَ يُشجي السامعين نشيدها",195,"د",3,0],["وتُنبتين الرفقَ في أنفس","غليظة قاسية لا تلينْ",196,"ن",1,0],["وتنَصَّتَت أقداحُهم لمغردٍ","مَرِحٍ يُصَفّقُ بالبيان الساحرِ",197,"ر",1,0],["وتنظّرتُه حياةً فأعياني","دبيبُ الحياة في مخلوقي",198,"ق",2,0],["وتَنْقَضُّ مثل النسر فوق سمائها","بأجنحةٍ تغزو النجومَ وتَزْحُمُ",199,"م",1,0],["وتنَقَّبْنَ بالغما","مِ وأسفرنَ يا للقمَرْ",200,"ر",1,0],["وتناجوا بذكر ثروت حتى","رجعوا الأمسَ واستعادوا شؤونه",201,"ن",2,0],["وتُنَسِّي القلبَ ما جرَّعَ من سمٍ وصابِ","قبلةٌ تمزجُ أنفاسَكِ بالقلبِ المُذابِ",202,"ب",1,0],["وتنتشر الأزهارُ من عذَباتِها","وتَعْرى الغصونُ النُّضْرُ من ورقاتِها",203,"ت",3,0],["وَتَنوفَةٍ مَجهولَةٍ قَد خُضتُها","بِسِنانِ رُمحٍ نارُهُ لَم تَخمُدِ",204,"د",1,0],["وتَنادَوا بِعَوالٍ ذُبَّلٍ","تُزلِقُ الأَضعَفَ عن خَطِّ الأَشَدّ",205,"د",1,0],["وَتَنَاجَى بِمَا يَسُرُّ وَيُسجِي","يَقِظَاتُ الأَفْكَارِ وَالأَحْلامُ",206,"م",1,0],["وَتَنَافَسَ الأَبْرَارُ فِيمَا بَعْدَهُ","يَبْنُونَ فِي الدُّنْيَا المَعَارِجَ لِلْعُلَى",207,"ل",2,0],["وَتَنَاجَتْ أَشْبَاحُ آلِهَةٍ مَا","تُوا وَفَانِينَ خُلّدُوا بِالْقُبُورِ",208,"ر",1,0],["وَتَنَاقُلِ الأَصْدِقَاءِ","رَنَّاتِ الْمَثَالِثِ وَالمَثَانِي",209,"ي",1,0],["وَتُنْضِي واضِحَ الْحَدَّيْنِ رَأْياً","فَيَمْلأُ كُلَّ غَامِضَةٍ سُطُوعَا",210,"ع",2,0],["وَتَنَافَسَ الشَّرَفَانِ حَيْثُ تَجَاوَرتْ","فِيها عُيُونُ العَصْرِ وَالآثَارُ",211,"ر",1,0],["وَتَنَزَّهْ إِنْ رُمْتَ مَا هُوَ أَبْقَى","عَنْ هَنَاتٍ سَتَنْقَضِي وَهَنَاتِ",212,"ت",1,0],["وَتَنَزَّلَتْ أَحْكَامُهُ فِي لَوْحِهَا","مَكْتُوبَةً آيَاتُهَا بِضِيَاءِ",213,"ا",2,0],["وَتَنَزُّلِ الأَقْوَامِ عَنْ أَخْطَارِهَا","وَتَعَسُّفِ الحُكِّامِ وَالكُبَرَاءِ",213,"ا",2,0],["وَتَنَاوُبٌ فِي عَبْقَريٍ وَاحِدٍ","بَيْنَ الفَتَى الفَعَّالِ وَالقَوَّالِ",214,"ل",1,0],["وَتَنْبُو بِنَا الآذَانُ عَنْ مُسْتَجَدِّهِ","فَكُلُّ عَتِيقٍ فَهْوَ مِنْ مُسْتَجَادِهِ",215,"د",2,0],["وَتُنُوقِلَتْ فِيهِ مَبَاحِثُكَ الَّتِي","قَدْ قَرَّبَتْ مَا كَانَ مِنْهُ سَحِيقَا",216,"ق",2,0],["وَتَنَاوَلَ الرَّجُلُ الرَّبَا","بَ وَفِكْرُهُ فِي الغَيْبِ نَاظِرْ",217,"ر",1,0],["وَتَنَاجَتْ فَوَائِحُ الأَزْهَارِ","وَتَنَادَتْ نَوَافِحُ الأَسْحَارِ",218,"ر",1,0],["وَتَنَزَّهَتْ أَخْلاَقُهُمْ عَنْ وَصْمَةٍ","بِتَرَدُّدٍ مُزْرٍ وَجُبْنٍ عَائِبِ",219,"ب",1,0],["وتُنْسَى اللاّتُ والعُزَّى وَوُدٌّ","ونَسْلُبُها الَقلاَئِدَ والشُّنُوفَا",220,"ف",2,0],["وتنويهَ الصّريخِ بلى ولكِنْ","عَرفتمْ أنّه صَدْقُ اللّقاءِ",221,"ا",2,0],["وتنصتت زمر الجنا","دب من فويهات الثقوب",222,"ب",1,0],["وَتَنَكَّروا بَعْدَ التَّدَلُّهِ في الهَوَى","وَشِكايَةِ السُّقَمَاءِ لِلْعُوَّادِ",223,"د",1,0],["وتَنهضُ والثَّقيلُ عليكَ خفٌّ","وتنظرُ والخَفيُّ إِليكَ بادِ",224,"د",1,0],["وتنْسَى الكواعبُ آيَ الحِجابِ","وتَبْكِي العَجائزُ أعمارَها",225,"ر",3,0],["وتنكَّرَتْ صُورُ البيانِ وعقَّني","عن أَنْ أبوحَ كما أشاءُ يراعي",226,"ي",1,0],["وتَنَقَّلْ بيْنَ الخمائلِ جَذْلا","نَ طليقَ الهَوَى جَمِيمَ المِراح",227,"ح",1,0],["وَتَنالَ قَسْراً مِنْ فَمِ الدنْيَا","حَلاَوَةَ كُلِّ حَمْدِ",228,"د",1,0],["وتنادت بُشْرَياتٌ باسمه","صُدّحاً في كلِّ أفق حُوّمَا",229,"م",2,0],["وتنفَّسوا ريح البوَادي حرَّةً","فتحرَّروا من رقِّ كلِّ إسار",230,"ر",1,0],["وتَنزعُ عن جيدِها طوقَها"