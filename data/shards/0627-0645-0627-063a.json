{"poems":[[74,"ما لي إلى السلوان عنك سبيل","https://www.aldiwan.net/poem19478.html","الكامل"],[47,"عند العقيق فماثلات دياره","https://www.aldiwan.net/poem63562.html","الكامل"],[71,"قالوا فلان جيد","https://www.aldiwan.net/poem28393.html","مجزوء الكامل"],[202,"دعا بإقامة الشوق الرحيل","https://www.aldiwan.net/poem51908.html","الوافر"],[738,"","https://poetry.dctabudhabi.ae/diwan/poem/147208","المجتث"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63867","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49963","المتقارب"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93577","البسيط"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139896","الكامل"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118744","الطويل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102748","الطويل"],[4791,"للطير طبع","https://www.poetsgate.com/ViewPoem.aspx?id=37109",""],[5533,"صَمَتَ الحَنِين","https://www.poetsgate.com/ViewPoem.aspx?id=177719",""]],"verses":[["أما غرام القلب فهو كثير","عندِي ولكن ما السلوّ جميل",0,"ل",1,0],["إِمّا غَنِيٌّ زادَ في إِغنائِهِ","أَو مُقتِرٌ يُعدى عَلى إِقتارِهِ",1,"ر",2,0],["إما غنيٌّ باخلٌ","أو معسرٌ يتصيَّدُ",2,"د",1,0],["أما غيرُ الخيالِ لنا لقاءٌ","أما غيرُ النسيم لنا رسول",3,"ل",1,0],["إما غناءً وإما","عجائباً عنه تروى",4,"و",2,0],["أما غُلامي أسدٌ فقد نَشَز","وباع مأثورِ القريضِ واللُّغزْ",5,"ز",1,1],["أَما غير بخل بميعاد وصل","على طول مطل وتزويد زادِ",6,"د",1,0],["أَمّا غَدا زَعموا أو لا فَبعد غَد","لَما حَكيت لَها بِالعبرة اختنقت",7,"ت",1,0],["أما غرامي في هواك فإنه","حيُّ ولكنْ في السلو لك البقا",8,"ق",2,0],["أم اغتال قبح الصنع حسن طباعهم","أو انقمعوا قهراً وحقك لا أدري",9,"ر",2,0],["أما غير هذا الطيف يوما يزورني","لاحظى بوصل في الحقيقة صادق",10,"ق",1,0],["إما غدا ولا بقى له شرايد","وإلا يجي ما جاه بالدرب ساموح",11,"ح",1,0],["أمَّا غِيَاثُ فَمَنْبَعٌ لرَزَانَةٍ","رَضِعَ العَلُومَ بوَاسِعِ الأَبْوَابِ",12,"ب",1,0]]}