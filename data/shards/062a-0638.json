=31340",""],[91,"فنون الوصف","https://www.poetsgate.com/ViewPoem.aspx?id=53081",""],[28,"أهاجَ لَكَ الشّوْقَ القَدِيمَ خَبالُهُ،","https://www.poetsgate.com/ViewPoem.aspx?id=2516",""],[78,"تَظُنُّ بِنا أُمُّ الرَّبيع سآمَةً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86477&r=&rc=22",""],[101,"مَلَّ مِنْ وَجْدِهِ وَمِنْ فَرْطِ مَا بِهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62429&r=&rc=21",""],[24,"أمِنْ أُمِّ شَدّادٍ رُسُومُ المَنَازِلِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10881&r=&rc=22",""],[30,"ألا أيُّها الرَّسمُ الذي غيَّرَ البلى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=20510&r=&rc=4",""],[20,"لم أر مثل الفتيان في غبن ال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69760&r=&rc=1",""],[18,"أليلتنا بذي حسمٍ أنيري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26445&r=&rc=11",""]],"verses":[["تُظَفَّرُ بِالمَآرِبِ طَيِّعاتٍ","وَبِالآمالِ أَبكاراً وَعونا",0,"ن",2,0],["تَظُنُّني أَرغَبُ عَن مَوقِفٍ","يَحضُرُ فيهِ الشَوقُ وَالشائِقُ",1,"ق",1,0],["تَظاهَروا بِنِفاقِ الغَيِّ عِندَهُمُ","حَتّى اِدِّعاهُ عَلى مَكروهِهِ الفُصَحا",2,"ح",2,0],["تُظهِرُ الوجدَ الَّذي أُضمِرُهُ","وَعَناءٌ مَرَحُ الطَّرفِ الطَّموحُ",3,"ح",1,0],["تَظُنُّ مِنَ الظَنِّ المُكَذَّبِ أَنَّهُ","وَراكِبُهُ دارا بِمَكَّةَ يَطلِبُ",4,"ب",1,0],["تُظَلِّلُهَا الْفَوَارِسُ بِالْعَوَالِي","وَتَفْرِشُهَا الْوَلاَئِدُ بِالطَّعَامِ",5,"م",1,0],["تَظَلُّ نُسوعُ الرَحلِ بَعدَ كَلالِها","لَهُنَّ أَطيطٌ بَينَ جَوزٍ وَكاهِلِ",6,"ل",1,0],["تَظَلُّ تَهدي وَلَستَ تَدري","كَأَنَّكَ المَغرِبِيّ المُفَسِّر",7,"ر",1,0],["تَظُنُّ ذُرى لُبنانَ وَاللَيلُ عاكِفٌ","صَديعَ صَباحٍ مِن سُراها يُجيرُها",8,"ر",3,0],["تَظُنُّ الوَفاءَ بِها وَالظُنونُ","فيها تَقولُ عَلى مَن فَرَض",9,"ض",1,0],["تَظُنُّ النَوى تَعدو الهَوى عَن مَزارِها","وَداعي الهَوى نَحوَ البَعيدِ مُجابُ",10,"ب",1,0],["تَظاهَرَ فيها النِيُّ لا هِيَ بَكرَةٌ","وَلا ذاتُ ضِغنٍ في الرِمامِ قَموصُ",11,"ص",1,0],["تَظَلُّ اِبنَةُ الضَمري في ظِلِّ نِعمَة","إِذا ما مَشَت مِن فوقِ صَرحٍ مُمَرَّدِ",12,"د",1,1],["تظهر منه الزور حيث اختفى","وتستبين الغامض المعضلا",13,"ل",2,0],["تَظَل الكِنَانَةُ تَبْكِي أَسىً","عَلَيْهَا وَمُهْجَتُهَا صَادِيَهْ",14,"د",3,0],["تَظَلُّ جِيادي عَلى بابِهِ","تَروثُ وَتَأكُلُ أَرواثَها",15,"ث",3,0],["تَظَلُّ الكِرامُ المُرمِلونَ بِجَوفِها","سَواءٌ عَلَيهِم حَملُها وَحِيالُها",16,"ل",3,0],["تَظَلُّ بِهِ أَيدي المَهارى كَأَنَّها","مَخاريقُ تَنبو عَن سَياسِيَّ قُحَّلِ",17,"ل",1,0],["تَظِلُّ ذُرى نَخلِ اِمرِئِ القَيسِ نِسوةً","قِباحاً وَأَشياخاً لِئامَ العَنافِقِ",18,"ق",1,0],["تُظلَّلُ سحبُ الطّير جيشَكَ حيثما","تميلُ به الراياتُ وهي حواملُ",19,"ل",1,0],["تظلّه قبّة فيه منجّدة","قد زانها حسن تنجيد وتقبيب",20,"ب",1,0],["تظاهرت من فعل البخار بقوّة","يُذلّل أدنى فعلها المطلب الصعبا",21,"ب",2,0],["تظنّ إذا صدرَ النهار دخلتَها","كأنّك في قِطع من الليل أسود",22,"د",1,0],["تَظَلَّ الخَمرُ تَخلِجُ أَخدَعَيها","وَتَشكو في قَوائِمِها اِمذِلالا",23,"ل",2,0],["تَظَلُّ رَواياهُم تَبَرَّضنَ مَنعِجاً","وَلَو وَرَدَتهُ وَهوَ رَيّانُ سائِلُ",24,"ل",1,0],["تُظَلِّلُهُ الفَوارِسُ بِالعَوالي","وَتَفرِشُهُ الوَلائِدُ بِالطَعامِ",25,"م",1,0],["تَظَلُّ جِيادُنا مُتَمَطِّراتٍ","تُلَطِّمُهُنَّ بِالخُمُرِ النِساءُ",26,"ا",2,0],["تظلّ به العقبان آلفة القنا","كأنهما وُرْقُ الحمائم والبان",27,"ن",1,0],["تظلّ على العسر أقلامه","فتأخذه أخذة رابيه",28,"ي",2,0],["تظلَّمَ عمروٌ من هِجائي وقد عَلَتْ","بما قلتُ فيه حالُهُ ومراتبُهْ",29,"ب",2,1],["تظل تُرانيها الظباءُ تخالُها","ظِباءً وتدنو فهْي منا على قُربِ",30,"ب",1,0],["تُظاهِرُ دونَ عرضِكَ كلَّ درعٍ","تُظَاهرُ للطِّعانِ وللضرابِ",31,"ب",1,0],["تَظلّ متَى صافحتَ أسْرارَ كَفِّه","تَمَسُّ عيوناً من نَداهُنَّ نُضَّخَا",32,"خ",2,0],["تَظاهَرَانِ على تَقْوَى إلهِكُما","كلا الظَّهيرَيْنِ مَعْضُودٌ بمعضُودِ",33,"د",1,0],["تُظاهر بين الخزِّ والوشْي تُرْفَةً","فيالك من سيف ويا لك من غمدِ",34,"د",1,0],["تَظنَّوْهُ سَعْداناً مَريئاً فصادفوا","ذُعافاً وذِيفاناً وخَيم العوائدِ",35,"د",1,0],["تظل إذا حبرتُ فيك قصيدةً","من المدح فيها المحكمات السوائر",36,"ر",1,0],["تظلُّ من الأمرِ المخُوفِ وغيره","تضُمُّ بنيها باليدين إلى النَّحر",37,"ر",1,0],["تظل دموع العين عند ادكاره","تَحدَّر والأنفاسُ تَصْعد في الصدر",38,"ر",1,0],["تظل له غُلب الأسود خواضعاً","ضوارب بالأذقان حين يزمجر",39,"ر",1,0],["تظل ترى الجُرذان فيك مغلغلاً","وأنت تراها وهي بالفيش تدسَر",39,"ر",1,0],["تظل مقيماً في محلك خافضاً","وأنت بها في كل فج تُسيَّر",39,"ر",1,0],["تظل تُجافي المنَّ عنهم تَحفِّياً","وقد غتَّهم معروفُك المتواتر",40,"ر",1,0],["تظل له من ذاتِ نفسك قادِحاً","وليس يُداني قادحَ العلم قابسه",41,"س",2,0],["تظلُّ إذا قلَّ قثَّاؤها","تَموشُ البقايا مع الموَّش",42,"ش",1,0],["تظل الأسود الموعِداتُ ببأسها","إذا ما رأته تتَّقي بالبصابص",43,"ص",1,0],["تظل إذا خاضها","وأحشاؤها ترجف",44,"ف",1,0],["تظاهرت غمم سود وليس لها","ألا بوجهك بعد الله منكشف",45,"ف",1,0],["تظلُّ تُلقي على من ضَمَّ مجلسُها","قولاً ثقيلاً على الأسماع كاللَّومِ",46,"م",1,0],["تظهرُ في وجهه إساءتُه","كأنّها مَسْحةٌ من الحُمَمِ",47,"م",1,0],["تظل لها الأفواهُ عند نشيدها","عِذابَ الثنايا واضحات الملاغمِ",48,"م",1,0],["تظلَّمَ شِعري إلى القاسمِ","فأعْدَى على الزمنِ الغاشمِ",49,"م",1,1],["تظلُّ يداه يديْ غارمٍ","وبَهْجَتُةُ بهجةَ الغانمِ",49,"م",1,0],["تظلُّ كَفِّي كُلما","نزلتُ فيها فكِههْ",50,"ه",2,0],["تَظَلُّ عَلى الثَمراءِ مِنها جَوارِسٌ","مَراضيعُ صُهبُ الريشِ زُغبٌ رِقابُها",51,"ب",3,0],["تَظَلُّ جِيادُنا مُتَمَطِّراتٍ","مَعَ الخَبَبِ المُعادِلِ وَالمِشاقِ",52,"ق",1,0],["تَظَلُّ فيهِ بَناتُ الماءِ أَنجِيَةً","وَفي جَوانِبِهِ اليَنبوتُ وَالحَصَدُ",53,"د",1,0],["تَظَلُّ بَناتُ الماءِ تَبدو مُتونُها","وَطَوراً تَوارى في غَوارِبِهِ الكُدرِ",54,"ر",1,0],["تَظَلُّ سِباعُ الشَرعَبِيَّةِ حَولَهُ","رُبوضاً وَما كانوا أَجَنّوهُ في قَبرِ",55,"ر",1,0],["تَظَلُّ بِهِ الثيرانُ فَوضى كَأَنَّها","مَزارِبُ وافَتها لِعيدٍ مَرازِبُ",56,"ب",1,0],["تَظَلَّلتُ بَِلأَشجارِ عِندَ اِختِفائِهِ","وَيا رُبَّ طَلٍّ كانَ أَجمَلَ مِن قَطرِ",57,"ر",1,0],["تَظُنُّ لَنا الدنيا وَما في رِحابِها","وَلَيسَت لَنا إِلّا كَما البَحرُ لِلسُفُنِ",58,"ن",1,0],["تَظَلُّ بِذي الأَرطى تَسَمَّعُ صَوتَهُ","مُفَزَّعَةً تَخشى سِباعاً وَرامِيا",59,"ي",2,0],["تَظُنُّ بِنا أُمُّ الرَبيع سآمَةً","أَلا غَفَرَ الرَحمانُ ذَنبا تُواقِعُهْ",60,"ع",2,1],["تُظِلّ زُغبَ فِراخٍ تَستَكِنُّ بِها","مِنَ الحَرورِ وَتَكفيها أَذى المطرِ",61,"ر",1,0],["تَظَلُّ وَراءَ السِترِ تَرنو بِلَحظِها","إِذا مَرَّ مِن أَترابِها مَن يَروقُها",62,"ه",2,1],["تظن العين أن قد غبت عنها","وأنت بجفنها بصر ونور",63,"ر",1,0],["تظل تشكو الداء","وتخلق الشحناء",64,"ا",2,0],["تُظَلِّلُنا وَالطَيرَ في جَنَباتِهِ","غُصونٌ قِيامٌ لِلنَسيمِ سُجودُ",65,"د",1,0],["تَظَلُّ عَلى الأَيّامِ غَرّاءَ حُرَّةً","مُحَجَّلَةً في ظِلِّها الغَزَواتُ",66,"ت",1,0],["تَظَلُّ مَهولاتُ البَوارِجِ دونَهُ","حَوائِرَ ما يَدرينَ ماذا تُخَرِّبُ",67,"ب",1,0],["تَظَلُّ الطَيرُ مِنها في حَديثٍ","تَرُدُّ بِهِ الصَراصِرَ وَالنَعيبا",68,"ب",2,0],["تَظَلُّ مُلوكُ الأَرضِ خاشِعَةً لَهُ","تُفارِقُهُ هَلكى وَتَلقاهُ سُجَّدا",69,"د",2,0],["تَظُنُّ فِراخُ الفُتخِ أَنَّكَ زُرتَها","بِأُمّاتِها وَهيَ العِتاقُ الصَلادِمُ",70,"م",1,0],["تَظُنُّ مِن فَقدِكَ اِعتِدادَهُمُ","أَنَّهُم أَنعَموا وَما عَلِموا",71,"م",3,0],["تَظُنُّ اِبتِساماتي رَجاءً وَغِبطَةً","وَما أَنا إِلّا ضاحِكٌ مِن رَجائِيا",72,"ي",2,0],["تظَلُّ إذا ما جئتَهُ الدهرَ آمناً","بخيرِ مكانٍ بل بأشرَفِ موضعِ",73,"ع",1,0],["تظنُّ وعْدَ الأماني وهي كاذبةٌ","حقاً وتطمعُ قبلَ النومِ بالحُلُمِ",74,"م",1,0],["تظنونَ حالي في الهَوى مثلَ حالِكمْ","وهيهاتَ إني في الهَوى أمَّةٌ وحدِي",75,"ي",1,0],["تُظِلُّني لِلمُلوكِ أَسمِيَةٌ","أَمطارُهُنَّ اللُجَينُ وَالذَهَبُ",76,"ب",1,0],["تَظُنُّ شُجونِيَ لَم تَعتَلِج","وَقَد خَلَجَ البَينُ مَن قَد خَلَج",77,"ج",1,1],["تَظما إِلَيهِنَّ القُلوبُ وَقَد تَرى","فيهِنَّ رِيَّ الهائِمِ المُلتاحِ",78,"ح",1,0],["تَظَلُّ العَطايا وَالمَنايا قَرائِناً","لِعافٍ يُرَجّيهِ وَغاوٍ يُعانِدُه",79,"د",2,0],["تَظُنُّ البَرقَ مُعتَرِضاً إِذا ما","جَلا عَن ثَغرِها حُسنُ اِبتِسامِ",80,"م",1,0],["تَظَلُّ البُزاةُ البيضُ تَخطِفُ حَولَنا","جَآجِئَ طَيرٍ في السَماءِ سَوامِ",81,"م",1,0],["تَظُنّونَ اِدِّعاءَكُمُ مُخيلاً","إِذا سَمَّيتُمُ توما تَميما",82,"م",2,0],["تَظَلُّ المُخدِراتُ لَهُ سُجوداً","حَمى الطُرقَ المَقانِبَ وَالتِجارا",83,"ر",2,0],["تَظَلُّ عِتاقُ الطَيرِ تَنفي هَجينَها","جُنوحاً عَلى جُثمانِ