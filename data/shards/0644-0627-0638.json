{"poems":[[53,"لأظما معلينا وأروى المصائبا","https://www.aldiwan.net/poem30735.html","الطويل"],[86,"بكرا صاحبي يوم الإياب","https://www.aldiwan.net/poem68952.html","الخفيف"],[72,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[51,"إن المنية لا تبقي على أحد","https://www.aldiwan.net/poem10865.html","البسيط"],[45,"متى لاح برق أو بدا طلل قفر","https://www.aldiwan.net/poem63556.html","الطويل"],[45,"على الحي سرنا عنهم وأقاموا","https://www.aldiwan.net/poem65687.html","الطويل"],[61,"تبين لي سبق الأمير إلى العلى","https://www.aldiwan.net/poem51422.html","الطويل"],[49,"ما لي أفرط فيما ينبغي مالي","https://www.aldiwan.net/poem63080.html","البسيط"],[66,"لا نلت من طيب وصلكم أملا","https://www.aldiwan.net/poem38474.html","المنسرح"],[46,"عفوك للعالم لا تخلين","https://www.aldiwan.net/poem22139.html","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42613","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54563","الكامل"],[138,"لا ظلع لي أرقي عليه وإنما","https://www.aldiwan.net/poem2142.html","الكامل"],[141,"أرى الشرف الأعلى إليك مسلما","https://www.aldiwan.net/poem11811.html","الطويل"],[158,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[229,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[235,"أما رضاك عمومه وخصوصه","https://www.aldiwan.net/poem19297.html","الكامل"],[259,"صب بلا لوعة ولا كمد","https://www.aldiwan.net/poem38340.html","المنسرح"],[283,"بنداوكم جبل به شوك الكلا","https://www.aldiwan.net/poem39380.html","الكامل"],[367,"قدمت فلم أترك لذي قدم حكما","https://www.aldiwan.net/poem4315.html","الطويل"],[402,"زيادة المرء في دنياه نقصان","https://www.aldiwan.net/poem49713.html","البسيط"],[438,"ليتني كنت شجره","https://www.aldiwan.net/poem14371.html","مجزوء الرجز"],[451,"مهد الحضارة للعروبة كلها","https://www.aldiwan.net/poem61290.html","الكامل"],[456,"لمن الطلول كأنهن رقوم","https://www.aldiwan.net/poem55864.html","الكامل"],[456,"قالوا رضيت قلت ما أجدى الغضب","https://www.aldiwan.net/poem56298.html","الرجز"]],"verses":[["لَأَظما مُعِلّينا وَأَروى المَصائِبا","وَأَسخَطَ آمالاً وَأَرضى نَوائِبا",0,"ب",2,1],["لَأَظَلَّتكَ بِالقُلوبِ مِنَ الشَم","سِ وَوارَت عِداكَ تَحتَ التُرابِ",1,"ب",1,0],["لا ظلم تلقى في حماه العالي","إلاَّ على الأعداء والأموال",2,"ل",1,0],["لا ظُلْمَ لَوْ شَاهَدَتْ من حال مَصْرَعه","ما شاهَدَ البدرُ لم تشرق ولم تَكَدِ",3,"د",1,0],["لَأَظلَمَتِ الدُنيا وَلَاِنقَضَّ حُسنُها","وَلَاِنحَتَّ مِن أَفنانِها الوَرَقُ الخُضرُ",4,"ر",1,0],["لَأَظلَمَ ما بَيني وَبَينَكَ مُضحِياً","وَلِلظُلمِ بَينَ الخُلَّتَينِ ظَلامُ",5,"م",1,0],["لأُظْهِرَ من حُسنِ الغِناءِ مُحَلَّلاً","وأستُرَ من حُسنِ الوجوهِ مُحرَّما",6,"م",2,0],["لَأَظعَنَنَّ إِلى دارٍ خُلِقتُ لَها","وَخَيرُ زادي إِلَيها خَيرُ أَعمالي",7,"ي",1,0],["لَأَظهُرِ الصافِناتِ خَيّالَةٌ","مِنّا وَأَمّا قُلوبُهُنَّ فَلا",8,"ل",2,0],["لا ظُبَةُ الصارِمِ باشَرتُها","فيكَ وَلا زُرتُ لِحَجِّي ظُبَه",9,"ه",1,0],["لا ظِلُّهَا راكِدُ النَّسيمِ وَلا","غُدْرَانُهَا بِالْغُثَاءِ مُخْتَمِرَهْ",10,"ر",2,0],["لاَ ظُلْمَ يَغْضِبُهُمْ وَلَوْ أَوْدَى بِهِمْ","أَتَعِزُّ شَأْناً أُمَّةٌ لاَ تَغْضَبُ",11,"ب",1,0],["لا ظَلْعَ لي أَرْقِي عليه وإِنَّما","يَرْقِي على رَثَياتِه المَنْكُوبُ",12,"ب",1,1],["لَأَظهَرَ أَهلُ الأَرضِ حُبَّكَ رَهبَةً","فَأَنعَمتَ حَتّى خالَطَ اللَحمَ وَالدَما",13,"م",2,0],["لاظهرتم ما قاله كبراؤكم","من الكفر في أن الالوهة تكسب",14,"ب",1,0],["لا ظِلَّ في قِصَرِ الزَّمانِ وَطولِهِ","فَوقَ الثَّرى لِقَوامِهِ الرَيّانِ",15,"ن",1,0],["لَأَظَلَّنِي مِنْهُ وَلاَ يَخْفَاكَ مَا","قَلْبِي بِهِ وَجَعُ الْحَشَا مَمْغُوصُهُ",16,"ص",2,0],["لا ظفرت مقلتي برؤيته","اننظرت بعده إلى احد",17,"د",1,0],["لا ظل يحلو لا مياه كما نشأ","لا زرع لا زهر ينير فوادي",18,"د",2,0],["لأظمأني بعدُ المراد ولم أرِد","به مورداً عذبا ولا مشرباً جمّا",19,"م",2,0],["لا ظِلَّ للمَرءِ يعرى من تُقىً ونُهىً","وإن أظلَّتْهُ أوراقٌ وأغصانُ",20,"ن",1,0],["لا ظلة فيها ولا","فيها غصون مثمره",21,"ر",2,0],["لا ظلم ظلم الدهر عدل صارخ","ما دام أهل الأرض نقمة عدلها",22,"ل",3,0],["لا ظلّ فوق الأرض يَحمِي قائلا","فيها ولا تحت التراب أرومُ",23,"م",1,0],["لا ظَهرهُمْ لِغِيَبةٍ إن ذُكروا","يوما ولا مِلحهُمُ على الرُّكَبْ",24,"ب",1,0]]}