{"poems":[[55,"لأظما معلينا وأروى المصائبا","https://www.aldiwan.net/poem30735.html","الطويل"],[88,"بكرا صاحبي يوم الإياب","https://www.aldiwan.net/poem68952.html","الخفيف"],[74,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[53,"إن المنية لا تبقي على أحد","https://www.aldiwan.net/poem10865.html","البسيط"],[47,"متى لاح برق أو بدا طلل قفر","https://www.aldiwan.net/poem63556.html","الطويل"],[47,"على الحي سرنا عنهم وأقاموا","https://www.aldiwan.net/poem65687.html","الطويل"],[63,"تبين لي سبق الأمير إلى العلى","https://www.aldiwan.net/poem51422.html","الطويل"],[51,"ما لي أفرط فيما ينبغي مالي","https://www.aldiwan.net/poem63080.html","البسيط"],[68,"لا نلت من طيب وصلكم أملا","https://www.aldiwan.net/poem38474.html","المنسرح"],[48,"عفوك للعالم لا تخلين","https://www.aldiwan.net/poem22139.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42613","المنسرح"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54563","الكامل"],[144,"لا ظلع لي أرقي عليه وإنما","https://www.aldiwan.net/poem2142.html","الكامل"],[147,"أرى الشرف الأعلى إليك مسلما","https://www.aldiwan.net/poem11811.html","الطويل"],[164,"هو الله من حبلي وريدك أقرب","https://www.aldiwan.net/poem59175.html","الطويل"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[242,"أما رضاك عمومه وخصوصه","https://www.aldiwan.net/poem19297.html","الكامل"],[266,"صب بلا لوعة ولا كمد","https://www.aldiwan.net/poem38340.html","المنسرح"],[290,"بنداوكم جبل به شوك الكلا","https://www.aldiwan.net/poem39380.html","الكامل"],[374,"قدمت فلم أترك لذي قدم حكما","https://www.aldiwan.net/poem4315.html","الطويل"],[411,"زيادة المرء في دنياه نقصان","https://www.aldiwan.net/poem49713.html","البسيط"],[447,"ليتني كنت شجره","https://www.aldiwan.net/poem14371.html","مجزوء الرجز"],[458,"مهد الحضارة للعروبة كلها","https://www.aldiwan.net/poem61290.html","الكامل"],[463,"لمن الطلول كأنهن رقوم","https://www.aldiwan.net/poem55864.html","الكامل"],[463,"قالوا رضيت قلت ما أجدى الغضب","https://www.aldiwan.net/poem56298.html","الرجز"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122590","الكامل"],[832,"","https://poetry.dctabudhabi.ae/diwan/poem/104574","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67820","الطويل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80193","البسيط"],[1315,"","https://poetry.dctabudhabi.ae/diwan/poem/140226",""],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64570","الطويل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35800","الوافر"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108794","الطويل"],[1829,"","https://poetry.dctabudhabi.ae/diwan/poem/130571","الطويل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110296","الكامل"],[2212,"","https://poetry.dctabudhabi.ae/diwan/poem/202379","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27268","الهزج"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109474","الطويل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120729","الطويل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106996","الرجز"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76030","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93872","المتدارك"],[2983,"","https://poetry.dctabudhabi.ae/diwan/poem/133933","الرمل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132750","الكامل"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104300","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86310","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133239","الوافر"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135727","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111416","الكامل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107483","الرجز"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58124","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58112","الطويل"],[4739,"ذنوب الجفا","https://www.poetsgate.com/ViewPoem.aspx?id=28115",""],[4755,"عَرَبيٌّ في الجِيتُو","https://www.poetsgate.com/ViewPoem.aspx?id=215951",""],[5082,"حارسةُ النّهر","https://www.poetsgate.com/ViewPoem.aspx?id=214735",""],[5139,"ذكريات","https://www.poetsgate.com/ViewPoem.aspx?id=68955",""],[5189,"أبدا لا غيرك يرحمني","https://www.poetsgate.com/ViewPoem.aspx?id=211775",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5376,"وشجى على هولِ المصاب ِهَزَارُ","https://www.poetsgate.com/ViewPoem.aspx?id=189133",""],[5561,"اليوم المشهود","https://www.poetsgate.com/ViewPoem.aspx?id=196817",""],[5573,"لاهبت الريح بقلوب الهواويه","https://www.poetsgate.com/ViewPoem.aspx?id=200306",""],[5655,"لولا الأمانيُّ والتَّسويفُ والأمَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=107214",""],[5739,"فرحة بخيل ..!","https://www.poetsgate.com/ViewPoem.aspx?id=131229",""],[5758,"اعتذار لأبي العلاء المعرّي","https://www.poetsgate.com/ViewPoem.aspx?id=200503",""],[5851,"زنبقة من بقايا الصلصال","https://www.poetsgate.com/ViewPoem.aspx?id=175251",""],[5957,"جُرح الوَطَن","https://www.poetsgate.com/ViewPoem.aspx?id=12233",""],[6160,"أقنِعَةُ الظِّلِّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87099&r=&rc=16",""],[5355,"شرود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86683&r=&rc=6",""],[5957,"صباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82616&r=&rc=140",""],[6320,"ثَلْجُ الجَحِيم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83636&r=&rc=17",""]],"verses":[["لَأَظما مُعِلّينا وَأَروى المَصائِبا","وَأَسخَطَ آمالاً وَأَرضى نَوائِبا",0,"ب",2,1],["لَأَظَلَّتكَ بِالقُلوبِ مِنَ الشَم","سِ وَوارَت عِداكَ تَحتَ التُرابِ",1,"ب",1,0],["لا ظلم تلقى في حماه العالي","إلاَّ على الأعداء والأموال",2,"ل",1,0],["لا ظُلْمَ لَوْ شَاهَدَتْ من حال مَصْرَعه","ما شاهَدَ البدرُ لم تشرق ولم تَكَدِ",3,"د",1,0],["لَأَظلَمَتِ الدُنيا وَلَاِنقَضَّ حُسنُها","وَلَاِنحَتَّ مِن أَفنانِها الوَرَقُ الخُضرُ",4,"ر",1,0],["لَأَظلَمَ ما بَيني وَبَينَكَ مُضحِياً","وَلِلظُلمِ بَينَ الخُلَّتَينِ ظَلامُ",5,"م",1,0],["لأُظْهِرَ من حُسنِ الغِناءِ مُحَلَّلاً","وأستُرَ من حُسنِ الوجوهِ مُحرَّما",6,"م",2,0],["لَأَظعَنَنَّ إِلى دارٍ خُلِقتُ لَها","وَخَيرُ زادي إِلَيها خَيرُ أَعمالي",7,"ل",2,0],["لَأَظهُرِ الصافِناتِ خَيّالَةٌ","مِنّا وَأَمّا قُلوبُهُنَّ فَلا",8,"ل",2,0],["لا ظُبَةُ الصارِمِ باشَرتُها","فيكَ وَلا زُرتُ لِحَجِّي ظُبَه",9,"ه",1,0],["لا ظِلُّهَا راكِدُ النَّسيمِ وَلا","غُدْرَانُهَا بِالْغُثَاءِ مُخْتَمِرَهْ",10,"ر",2,0],["لاَ ظُلْمَ يَغْضِبُهُمْ وَلَوْ أَوْدَى بِهِمْ","أَتَعِزُّ شَأْناً أُمَّةٌ لاَ تَغْضَبُ",11,"ب",1,0],["لا ظَلْعَ لي أَرْقِي عليه وإِنَّما","يَرْقِي على رَثَياتِه المَنْكُوبُ",12,"ب",1,1],["لَأَظهَرَ أَهلُ الأَرضِ حُبَّكَ رَهبَةً","فَأَنعَمتَ حَتّى خالَطَ اللَحمَ وَالدَما",13,"م",2,0],["لاظهرتم ما قاله كبراؤكم","من الكفر في أن الالوهة تكسب",14,"ب",1,0],["لا ظِلَّ في قِصَرِ الزَّمانِ وَطولِهِ","فَوقَ الثَّرى لِقَوامِهِ الرَيّانِ",15,"ن",1,0],["لَأَظَلَّنِي مِنْهُ وَلاَ يَخْفَاكَ مَا","قَلْبِي بِهِ وَجَعُ الْحَشَا مَمْغُوصُهُ",16,"ص",2,0],["لا ظفرت مقلتي برؤيته","اننظرت بعده إلى احد",17,"د",1,0],["لا ظل يحلو لا مياه كما نشأ","لا زرع لا زهر ينير فوادي",18,"د",2,0],["لأظمأني بعدُ المراد ولم أرِد","به مورداً عذبا ولا مشرباً جمّا",19,"م",2,0],["لا ظِلَّ للمَرءِ يعرى من تُقىً ونُهىً","وإن أظلَّتْهُ أوراقٌ وأغصانُ",20,"ن",1,0],["لا ظلة فيها ولا","فيها غصون مثمره",21,"ر",2,0],["لا ظلم ظلم الدهر عدل صارخ","ما دام أهل الأرض نقمة عدلها",22,"ل",3,0],["لا ظلّ فوق الأرض يَحمِي قائلا","فيها ولا تحت التراب أرومُ",23,"م",1,0],["لا ظَهرهُمْ لِغِيَبةٍ إن ذُكروا","يوما ولا مِلحهُمُ على الرُّكَبْ",24,"ب",1,0],["لأظُنُّ أنَّك مِثل موسى أسكَنت","حَركاتُه فرعونَ ذا الأوتاد",25,"د",1,0],["لأُظهرُ جهلاً بالذي أنا عالمٌ","بمكنونهِ فِعلَ اللّبيبِ المُخادعِ",26,"ع",1,0],["لأَظْفَرَ مِنْهَا كُلَّ يَوْمٍ بِسَكْرَةِ","أَيَا عَذِلي دَعْني وَمَنْ لَوْ رَأيْتَهُ",27,"ه",1,0],["لا ظُلمَ لا غَدرَ لا اِستعبادَ يَشمَلَكُم","لا زَيغَ لا طَيش لا قَصرٌ عَن الأَرَبِ",28,"ب",1,0],["لا ظلم ما فعلوا لا جرم إن قتلوا","قتيلهم عند رب العرش مقبول",29,"ل",1,0],["لاظهار دين اللّه غير مفيد","ومن عثرات الجد أني طالما",30,"م",2,0],["لا ظُلمَ كُلِّ ذي نورٍ وَلكِن","بِوَجهِ مُحَمَّد كُشِفَ الظَلامُ",31,"م",1,0],["لأظرف خلق اللَه من أنا عبدها","ومن هي مولاتي وإن أبت الوصلا",32,"ل",2,0],["لأظفر يوما من يزيد بن حاتم","بحبل جوارٍ ذاك ما كنت أطلب",33,"ب",1,0],["لأظل يلمسني بليل نسيمه","وأبيت يؤنسني خرير زلاله",34,"ل",2,0],["لا ظلمه لا ولا الضعف المضربه","حاضاه منه ولا ما كان من ذمم",35,"م",1,0],["لاظهار الخفايا في","بطونِ نواشىء دِبسِ",36,"س",1,0],["لإظهاره سماه مصباحَ عصرِهِ","ولم أعهد المصباحَ في العصر يظهر",37,"ر",1,0],["لأظلمت الدنيا عليَّ لفَقدِه","فها أنا أرعاها بمُقلة مَرصودِ",38,"د",1,0],["لا ظللتني اليزنيات إذا","لم أتفيأ بمحانيك ظلل",39,"ل",1,0],["لأَظلَمَ إيضاحٌ وَأَقصوا مُقَرِّباً","كَذا جُمَلٌ مَعهُ المُفَصَّلُ مُزِّقا",40,"ق",2,0],["لا ظلم اليوم ولا جور","حذراً قد أعذر من أنذار",41,"ر",1,0],["لا ظبا البيض ولا حز المدى","منه في تمزيقها أقطع حدا",42,"د",2,0],["لا ظل إلا في حماك ولا روى","الا غدير نداك للظمآن",43,"ن",1,0],["لأظلم الكون لولا أنه قمر","وماتت الناس لولا أنه خلف",44,"ف",1,0],["لا ظِل لِلمَرءِ يُغني عَن تُقى وَرِضاً","وَلَو سَمى في المَعالي وَهو دَهقان",45,"ن",1,0],["لأظفر من جنابك بالعطايا","وأحظى في رحابك بالرشاد",46,"د",1,0],["لا ظفْر مع بغيٍ ولا صحةَ معْ","نهمٍ ولا ثناءَ مع كبرٍ جمعْ",47,"ع",1,0],["لأظلن غماماً شائقاً","من نضارٍ دونَهُ الشمس تغيب",48,"ب",1,0],["لا ظَلَّ رَأسِي فَوقَ عالِفاً","لا كُنتُ والدَ تيلماخَ يَتيمتي",49,"ي",1,0],["لا ظَعن نعرفُ ولا","رسماً عفا أو طللا",50,"ل",2,0],["لاظمئ الرَوضُ الذي كنابهِ","نَرُوضُ أَفراسَ الصِبا ولا ضَحا",51,"ا",1,0],["لإظهار دين الله إنَّ قلوبَهُمْ","على كل جَبَّارٍ كصَلْدِ الجنادِلِ",52,"ل",1,0],["لإظهارِ دينِ اللهِ في كلِّ ساعةٍ","وإنْ لاَمَ لُوَّامٌ وعَجَّ العَواذلُ",53,"ل",1,0],["لا ظلمني بوصله ولا هو عدل","خايفٍ من عذابه واخاف اخسره",54,"ر",2,0],["لا ظُلمَ قُلتُ.. فَإنَّهُ رَجُلٌ","بين الرِّجَالِ، وما لَهُ غَرسُ",55,"س",1,0],["لأظلّ عندَ النّهرِ مثلَ وصيّةٍ","مغروسةٍ لم تلْهُ فيها الرّيحُ",56,"ح",1,0],["لأظلَّ أرفل في نعيمٍ فاتني","زمنَ الشبابِ وفِتُّه مُتحسِّرا",57,"ر",2,0],["لاظنَّ لديَّ أخبّئهُ","أبداً لا غيركَ يرحمني",58,"ن",2,0],["لإظهاره في الناس أن مرامه","ليدفع عن من قلدوا من تهضما",59,"م",2,0],["لا ظاهراً للأرضِ ترجو عيشَه","والباطنُ المغمورُ فيه ستارُ",60,"ر",1,0],["لا ظُلمَ فيهِ جلَّ اللهُ موعدَهُ","إنّ العهودَ بأمرِ اللهِ إقرارُ",61,"ر",1,0],["لا ظلم الليل يلقى وجهها ضيه","وتشوف الأفراح في لقياه مضواها",62,"ا",3,0],["لأظُهِرَنَّ هوىً قد كنتُ أكتُمُه","فليس لي في هوى أمثالِكم خَجلُ",63,"ل",1,0],["لا ظما عرقه .. ما يبطي صامدي.","له كفوف الريح ملحاة ٍ وويل.",64,"ل",1,0],["لَا ظِلَّ نَأْوِي وَلَا غَيْمًا لِيَعْصِمَنَا","أَنَّى اتَّجَهْنَا مَساجِينًا وَنَنْكَشِفُ",65,"ف",1,0],["لاظل يرجع للأرواح بهجتها","وفي مرايا الدجى تاهت مرائينا",66,"ن",2,0],["لا ظل لا لا ..لا ندى","تسقيها قطراتٌ تَُحِنْ",67,"ن",1,0],["لا ظلَّ يَسبِقهُ إلى أهدَابِها","الشِّعرُ: أنْ يَحيا هَواهُ، ليَقتلَهْ",68,"ل",2,0],["لا ظل ، لا صوتٌ، سوى مُتنفسي","فالكونُ يغفو إذ يحلُ سُهادي",69,"د",2,0],["لا ظل لا لا لا ندى","والغيثُ في السُّحبِ سَكَنْ",70,"ن",1,0],["لاَ ظِلَّ يُرْجَى لاِمْتِدَادِي عِنْدَهُ","أَوْ نَارَ بِالخُلْجَانِ تُقْرِي المُسْنِتِينْ",71,"ن",1,0]]}