{"poems":[[53,"لأظما معلينا وأروى المصائبا","https://www.aldiwan.net/poem30735.html","الطويل"],[86,"بكرا صاحبي يوم الإياب","https://www.aldiwan.net/poem68952.html","الخفيف"],[72,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[51,"إن المنية لا تبقي على أحد","https://www.aldiwan.net/poem10865.html","البسيط"],[45,"متى لاح برق أو بدا طلل قفر","https://www.aldiwan.net/poem63556.html","الطويل"],[45,"على الحي سرنا عنهم وأقاموا","https://www.aldiwan.net/poem65687.html","الطويل"],[61,"تبين لي سبق الأمير إلى العلى","https://www.aldiwan.net/poem51422.html","الطويل"],[49,"ما لي أفرط فيما ينبغي مالي","https://www.aldiwan.net/poem63080.html","البسيط"],[66,"لا نلت من طيب وصلكم أملا","https://www.aldiwan.net/poem38474.html","المنسرح"],[46,"عفوك للعالم لا تخلين","https://www.aldiwan.net/poem22139.html","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42613","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54563","الكامل"]],"verses":[["لَأَظما مُعِلّينا وَأَروى المَصائِبا","وَأَسخَطَ آمالاً وَأَرضى نَوائِبا",0,"ب",2,1],["لَأَظَلَّتكَ بِالقُلوبِ مِنَ الشَم","سِ وَوارَت عِداكَ تَحتَ التُرابِ",1,"ب",1,0],["لا ظلم تلقى في حماه العالي","إلاَّ على الأعداء والأموال",2,"ل",1,0],["لا ظُلْمَ لَوْ شَاهَدَتْ من حال مَصْرَعه","ما شاهَدَ البدرُ لم تشرق ولم تَكَدِ",3,"د",1,0],["لَأَظلَمَتِ الدُنيا وَلَاِنقَضَّ حُسنُها","وَلَاِنحَتَّ مِن أَفنانِها الوَرَقُ الخُضرُ",4,"ر",1,0],["لَأَظلَمَ ما بَيني وَبَينَكَ مُضحِياً","وَلِلظُلمِ بَينَ الخُلَّتَينِ ظَلامُ",5,"م",1,0],["لأُظْهِرَ من حُسنِ الغِناءِ مُحَلَّلاً","وأستُرَ من حُسنِ الوجوهِ مُحرَّما",6,"م",2,0],["لَأَظعَنَنَّ إِلى دارٍ خُلِقتُ لَها","وَخَيرُ زادي إِلَيها خَيرُ أَعمالي",7,"ي",1,0],["لَأَظهُرِ الصافِناتِ خَيّالَةٌ","مِنّا وَأَمّا قُلوبُهُنَّ فَلا",8,"ل",2,0],["لا ظُبَةُ الصارِمِ باشَرتُها","فيكَ وَلا زُرتُ لِحَجِّي ظُبَه",9,"ه",1,0],["لا ظِلُّهَا راكِدُ النَّسيمِ وَلا","غُدْرَانُهَا بِالْغُثَاءِ مُخْتَمِرَهْ",10,"ر",2,0],["لاَ ظُلْمَ يَغْضِبُهُمْ وَلَوْ أَوْدَى بِهِمْ","أَتَعِزُّ شَأْناً أُمَّةٌ لاَ تَغْضَبُ",11,"ب",1,0]]}