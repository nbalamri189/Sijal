{"poems":[[95,"مجد الشآم أعدته فأعيدا","https://www.aldiwan.net/poem9162.html","الكامل"],[76,"سمح الخيال على النوى بمزار","https://www.aldiwan.net/poem12955.html","الكامل"],[132,"الموت أبكى جملة الأقوام","https://www.aldiwan.net/poem50524.html","الكامل"],[240,"لو بات من يلحي عليك مسهدا","https://www.aldiwan.net/poem32100.html","الكامل"],[321,"يا لحدب الظهور فصع الرقاب","https://www.aldiwan.net/poem69444.html","الخفيف"],[412,"نفسي الفِداء لِلحظِها من رامِ","https://www.aldiwan.net/poem50116.html","الكامل"],[567,"لمن الهوادج في عراء الهوجل","https://www.aldiwan.net/poem52887.html","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60853","الكامل"],[5111,"تَرَاتيْلُ الْبَتُولِ","https://www.poetsgate.com/ViewPoem.aspx?id=212511",""],[5956,"اشبح أيا أرتين في كبدِ الفضا","https://www.poetsgate.com/ViewPoem.aspx?id=205427",""]],"verses":[["يتتابع العمران في جنباته","وقريبه لولاك كان بعيدا",0,"د",2,0],["يَتَتابَعونَ إِلى الصَريخِ كَأَنَّهُم","أَمواجُ بَحرٍ قَد طَمى زَخّارِ",1,"ر",1,0],["يتتابعونَ إلى المنايَا بالمنى","كتتابعِ الأقدامِ بالأَقدامِ",2,"م",1,0],["يَتَتابَعونَ إِلى المَكارِمِ سَيِّداً","مِنهُم يَرِفُّ إِلى العَلاءِ فَسَيِّدا",3,"د",2,0],["يتتضي الظفر حين يطفر للصي","د وإلا فظفره في قراب",4,"ب",1,0],["يَتَتابَعونَ إِلى العُلاء تَتابُعاً","كَتَتابُعِ الأَقدامِ في الإِقدامِ",5,"م",1,0],["يَتَتَّبعُ الآثارَ قلبي خَلفَها","فلَوِ انثَنيْنَ وَطِئنَهُ بالأرجُلِ",6,"ل",1,0],["يتتبّعون العُشبَ حيث هَمَى الحَيا","شدوا ظعاينَهم إليه وألْجَمُوا",7,"م",3,0],["يَتَتَوَّقُ الظَّمْآنُ مُشْتَاقًا لَهَا","مِنْ نَبْعِهَا كَاسُ الْهَوَى تَتَدَعْدَعُ",8,"ع",1,0],["يتتبَّعانك رحمة ومخافة","من أن تنطَّ على الثرى مترضرضا",9,"ض",2,0]]}