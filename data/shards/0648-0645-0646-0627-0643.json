{"poems":[[55,"أيا لله أي هوى أضاء","https://www.aldiwan.net/poem30781.html","الوافر"],[88,"ملكت علي مذاهبي","https://www.aldiwan.net/poem68864.html","مجزوء الكامل"],[39,"طربت وما شوقا إلى البيض أطرب","https://www.aldiwan.net/poem7650.html","الطويل"],[93,"دار السلام وأرض الهنا","https://www.aldiwan.net/poem62784.html","عموديه"],[34,"ما هاج شوقك من بلى الأطلال","https://www.aldiwan.net/poem27704.html","الكامل"],[47,"رويدك إن شأنك غير شاني","https://www.aldiwan.net/poem66787.html","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39548","الكامل"],[190,"وقال الأحنف الرجلين قولا","https://www.aldiwan.net/poem43196.html","الوافر"],[190,"لقد هاج لي الوجد","https://www.aldiwan.net/poem43978.html","الهزج"],[215,"عيونك فيها حديث أراه","https://www.aldiwan.net/poem46247.html","المتقارب"],[236,"نفسي الفداء لبدر تم بازغ","https://www.aldiwan.net/poem44581.html","الكامل"],[244,"فعالك تسهتوي القلوب فتطرب","https://www.aldiwan.net/poem23839.html","الطويل"],[276,"لي في نوالك يا مولاي آمال","https://www.aldiwan.net/poem52046.html","البسيط"],[309,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[458,"عيد الملايين ازدهت بجلاله","https://www.aldiwan.net/poem61285.html","الكامل"],[458,"لم يحصر الفن فن ذهن وانان","https://www.aldiwan.net/poem61805.html","البسيط"],[463,"إذا عارض نحو أرض عدل","https://www.aldiwan.net/poem56076.html","المتقارب"],[510,"الحظّ","https://www.aldiwan.net/poem42462.html","الطويل"],[520,"أفي أهل ذا النادي عليم أسائله","https://www.aldiwan.net/poem12195.html","الطويل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66817","الوافر"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87007","البسيط"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137707",""],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38335","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65094","المنسرح"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101062","الوافر"],[1918,"","https://poetry.dctabudhabi.ae/diwan/poem/99058","الهزج"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47165","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124774","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94084","الكامل"],[2871,"","https://poetry.dctabudhabi.ae/diwan/poem/146343","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114051","الخفيف"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66189","الكامل"],[5273,"عشق أزلي","https://www.poetsgate.com/ViewPoem.aspx?id=179463",""],[5596,"وادي محرم","https://www.poetsgate.com/ViewPoem.aspx?id=206487",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577061",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""]],"verses":[["وَمِنّا كُلُّ أَغلَبَ مُستَحينٌ","إِنَ اَنتَ لَدَدتَهُ بِالذُلِّ قاءَ",0,"ا",2,0],["وَمُناكَ لَو طَلَعَت ذُكا","ءُ عَلَيكَ في يَومٍ يَصومُ",1,"م",1,0],["وَمِن أكبَرِ الأحدَاثِ كَانَت مُصِيبَةً","عَلَينَا قَتِيلُ الأدعِيَاءِ المُلَحَّبُ",2,"ب",1,0],["وَمَنّاكُمُ وَطَناً في النُجومِ","فَلا عَرَبِيَّ بِتِلكَ الدُنى",3,"ن",2,0],["وَمَناكِبٌ عرضَت وكَشحٌ مُضمَرٌ","جَالَ الوِشَاحُ عَلَيهِ كلَّ مجَالِ",4,"ل",1,0],["وَمِن إِكرامِهِ حَثُّ النَدامى","وَإِعجالُ المَثالِثِ وَالمَثاني",5,"ن",2,0],["ومُناكَ ليس يحدّها الأبدُ","دنيا وراء اللا نهاياتِ",6,"ت",1,0],["ومن أكل الطعام الشبع يوما","حراما كان ذلك أو حلالا",7,"ل",2,0],["ومنّا كل إسطيل","من المبرمة النكد",8,"د",1,0],["ومن أكؤس الحب عندي الصبوح","ومن خمرها في الدجى أغتبق",9,"ق",1,0],["ومن اكتسى ثوب البهاء محبةً","تباً لقلب من ودادك فارغ",10,"غ",1,0],["ومن أكبر البلوى عليه قبائل","من البدو في تلك الممالك تضرب",11,"ب",1,0],["ومن أَكون وَما قدري وَما عَمَلي","في يوم توضع في الميزان أَعمال",12,"ل",1,0],["ومن أكثر العصيان من غير توبة","فذاك طريح في فيافي الغواية",13,"ه",1,0],["ومن اكتفى لوجوده ببلاغه","وأشاح عن ملك وعن أمواله",14,"ل",2,0],["ومن أكون لأحظى من محبتكم","بما يجدد وجداني وايماني",15,"ن",2,0],["ومن أكلَ السُّحتَ كلبٌ إذا","سمحتَ بمالك عفواً بَخِلْ",16,"ل",1,0],["ومن أكرمَ الليلَ بإكرام عتمهِ","تبيَّن أنّه منَ النورِ أكرمُ",17,"م",1,0],["ومن أكره الرمح الرديني فالتوى","وأرهقه حتى تحطم عامله",18,"ل",2,0],["ومن أَكملتمْ الإيمانَ فارضُوا","عبادَ الله في الإسلام دينا",19,"ن",2,0],["وَمِن أَكاذيب أَلفاظ بِها اِنتَشَرَت","صَحائفٌ طَيُّها قَد كانَ أَولى لي",20,"ل",2,0],["ومن أكبر الناس سنا إلى","فتاة برابعة السنوات",21,"ت",1,0],["وَمَنِ اِكتَسى ثَوبَ الكَمالِ وَإِنّه","مِن غَيرِ رَيْبٍ بِالكمالِ الطافِحُ",22,"ح",1,0],["ومَنْ أَكفُّ الزَّمانِ تكتبُ ما","أُمْليهِ مِنْ شُكْرِهِ على الطُّرُقَهْ",23,"ق",2,0],["ومنا كل ذي ذربٍ خطيب","ومن الشاعرون المفلقونا",24,"ن",2,0],["ومنا كل أرورع كابن مَعدِي","وزيد الخيل مردي المُعْلِمينا",24,"ن",2,0],["ومنا كل أروع يعربيٍّ","تسامى نجره ي اليعربينا",25,"ن",2,0],["ومنا كل تركي أبيٍّ","تأثل مجده في الأولينا",25,"ن",2,0],["ومنا كل صلاّجٍ","بكيذٍ وافرٍ نكر",26,"ر",1,0],["ومنا كلّ زمكدان","غدا محدودب الظهر",26,"ر",1,0],["ومنا كلّ مطراش","من المكلوذة البتر",26,"ر",1,0],["ومنا كلُّ قنّاءٍ","على الإنجيل والذكر",26,"ر",1,0],["ومنا كلُّ مستعشٍ","من النعارة الكدر",26,"ر",1,0],["ومنّا كلّ ممرورٍ","غدا غيظ بني البظر",26,"ر",1,0],["ومنا كلّ مراسٍ","جسورٍ جاهلٍ هزر",26,"ر",1,0],["ومنّا كلُّ نطّاسٍ","على البزرك مستجري",26,"ر",2,0],["ومنا كلُّ من شرش","ر بالهلاّب والكسر",26,"ر",1,0],["ومنا كلُّ إسطيلٍ","نقيِّ الذهن والفكرْ",26,"ر",1,0],["ومنا كلُّ سبّاعٍ","عظيم الليث والببر",26,"ر",1,0],["ومنا كلُّ مشقاعٍ","من الفتيان كاللغر",26,"ر",1,0],["ومنّا كل ذي سمتٍ","خشوع القنِّ كالحبر",26,"ر",1,0],["ومنّا كل من يم","رح في الإسطبل كالمهر",26,"ر",1,0],["ومِنْ أَكْبَرِ النّعمى وِلاَيةُ مَنْ له","علينا وفينا حكمةٌ وتحكُّم",27,"م",1,0],["ومن أكل الخنزير أو نحوها فلا","تكفره يا هذا بأكل مجرد",28,"د",1,0],["ومناك قد وافت بتاريخ له","أبشر بنجل قد أتى هو باسم",29,"م",1,0],["ومَن أَكابِرَ، عَنْ تَشْييدِ مَنْقَبَةٍ","أَلهتهم الخيلُ والغِلمان والسَرَق",30,"ق",1,0],["ومِنِ اكرامِهِ عَلَى رَبِّهِ أنَّهُ","لَم تَستَبِن لَهُ أفياءُ",31,"ا",2,0],["ومَنِ اكْتَفَى مِنْ عَيْشهِ بِغَلُولهِ","فَحَياتُهُ ومَماتُهُ سِيانِ",32,"ن",1,0],["ومنْ أكونُ أمامَ اللهِ إنْ نَطَقَتْ؟","روحي الصلاةَ على المَحبوبِ مِلءَ فمي؟",33,"م",2,0],["ومن أكابرهم نجم علا فسما","(محمد بن سعيد) في المقامات",34,"ت",1,0],["وَمنا كلاه الطَير وَالوَحش بِالفَلا","بحوران في سُوق الحُروب السام",35,"م",1,0],["وَمِنا كلاه الطير وَالوَحش بِالخَلا","بحوران دمو بِالمعامع سال",36,"ل",1,0]]}