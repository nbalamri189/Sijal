{"poems":[[102,"من أرض بلقيس","https://www.aldiwan.net/poem43676.html","عموديه"],[87,"يا أيها الدمع الوفي بدار","https://www.aldiwan.net/poem62872.html","الكامل"],[87,"درجت على الكنز القرون","https://www.aldiwan.net/poem63694.html","مجزوء الكامل"],[87,"الناس للدنيا تبع","https://www.aldiwan.net/poem63761.html","مجزوء الكامل"],[107,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[107,"تعلموا كيف تبني مجدها الأمم","https://www.aldiwan.net/poem44217.html","البسيط"],[92,"المجلس المفجوع","https://www.poetsgate.com/ViewPoem.aspx?id=179038",""],[92,"بريد الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=179052",""],[107,"لبيك من حر المواقف عال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55000&r=&rc=170",""],[215,"مع الحبيب سبحت","https://www.aldiwan.net/poem45543.html","المجتث"],[275,"من لي سواك إذا تحكم ضيق","https://www.aldiwan.net/poem35056.html","الكامل"],[275,"هيجت من أبلغ اللذات أذكارا","https://www.aldiwan.net/poem35465.html","البسيط"],[333,"يا أيها الشاكي جفاه الرقاد","https://www.aldiwan.net/poem55041.html","السريع"],[422,"عاد المتيم في غرامك داؤه","https://www.aldiwan.net/poem54182.html","الكامل"],[563,"هذا القديم وهذه أفعاله","https://www.aldiwan.net/poem33501.html","الكامل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109103","الكامل"],[2216,"","https://poetry.dctabudhabi.ae/diwan/poem/100480","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87343","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87331","الرجز"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122496","البسيط"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109833","الكامل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109823","البسيط"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108269","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108077","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205585",""],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90975","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90959","الكامل"],[4286,"","https://poetry.dctabudhabi.ae/diwan/poem/123467","البسيط"],[4727,"السيف أقطعُ أحياناً مِن الخشبِ","https://www.poetsgate.com/ViewPoem.aspx?id=208920",""],[4767,"الرسالة","https://www.poetsgate.com/ViewPoem.aspx?id=179781",""],[4796,"الى الاستاذ الشاعر يوسف الخطيب","https://www.poetsgate.com/ViewPoem.aspx?id=34722",""],[5111,"هَامَانُ يَعْرِفُنِي","https://www.poetsgate.com/ViewPoem.aspx?id=212238",""],[5278,"جمل يعاني من شللْ...","https://www.poetsgate.com/ViewPoem.aspx?id=210549",""],[5470,"ذاكرة المجد","https://www.poetsgate.com/ViewPoem.aspx?id=12367",""],[5493,"من وحيِ القرنفل","https://www.poetsgate.com/ViewPoem.aspx?id=197043",""],[5493,". القربان .","https://www.poetsgate.com/ViewPoem.aspx?id=197410",""],[5493,"افخر بأني","https://www.poetsgate.com/ViewPoem.aspx?id=197563",""],[5524,"الجلساء الثلاثة","https://www.poetsgate.com/ViewPoem.aspx?id=37193",""],[5616,"أين النخوة العرباء؟","https://www.poetsgate.com/ViewPoem.aspx?id=204849",""],[5626,"عجبي عل كل المحاسن","https://www.poetsgate.com/ViewPoem.aspx?id=189694",""],[5664,"الحشمة","https://www.poetsgate.com/ViewPoem.aspx?id=176692",""],[5674,"مزق الأكباد سيف الجاهلية","https://www.poetsgate.com/ViewPoem.aspx?id=185912",""],[5704,"ثَمِلُ الجفون","https://www.poetsgate.com/ViewPoem.aspx?id=191156",""],[5704,"مني السلام إليكم...","https://www.poetsgate.com/ViewPoem.aspx?id=198739",""],[5736,"حروف مهزومة","https://www.poetsgate.com/ViewPoem.aspx?id=203159",""],[5956,"مواساة متأخرة (لأني علمتُ مؤخرا)","https://www.poetsgate.com/ViewPoem.aspx?id=206256",""],[5956,"إذا قال الشَّمالي صدِّقوهُ","https://www.poetsgate.com/ViewPoem.aspx?id=210307",""],[6213,"ومضة من الألق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81912&r=&rc=87",""],[6213,"القَدَرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76315&r=&rc=63",""]],"verses":[["هذا القصيد أغانيها ودمعتها","وسحرها وصباها الأغيد النضر",0,"ر",1,0],["هَذا القَضاءُ الجِدُّ فَاِروِ وَهاتِ عَن","حُكمِ المَنِيَّةِ أَصدَقَ الأَخبارِ",1,"ر",1,0],["هَذا القِيامُ فَقُل لنا ال","يَومُ الأَخيرُ مَتى يَكون",2,"ن",1,0],["هَذا القَضاءُ رَماكَ بِال","يُمنى وَبِاليُسرى نَزَع",3,"ع",1,0],["هذا القريضُ سما إليك على يدٍ","تسمو بِقُدْسيِّ الصّحائفِ غالِ",4,"ل",1,0],["هذا القليبُ لكم في جوفه عِبرٌ","لا اللوْمُ ينفعكم فيها ولا النَّدمُ",5,"م",1,0],["هذا القصيدُ \" أبا عليٍ \" كلُّه","حزنٌ وكل سطوره أوصاب",6,"ب",1,0],["هذا القريض تكبَّرت بُرُآتهُ","إذ ضاق من ألم الفراق خناق",7,"ق",1,0],["هذا القريص سما إليك على يد","تسمو بقدسي الصحائف غال",8,"ل",1,0],["هذا القصيد شهيد","أني بنجواي بحت",9,"ت",1,0],["هذا القليلُ من الكلامِ وإنهُ","يحوي الكثيرَ وما بهِ تلفيقُ",10,"ق",1,0],["هذا القوامُ كغصنٍ رفَّ مُنتثراً","والحسنُ أصبَحَ في خدَّيكِ آثارا",11,"ر",2,0],["هذا القضاء القاهر الخالد","حتم على كل ضحايا الحياه",12,"ه",1,0],["هذا القريب من العُفاة عطاؤه","هذا الرحيب بمن ألمَّ فِناؤه",13,"ا",3,0],["هذا القديم وهذه أفعالُهُ","وجلالُه هو ظاهر وجمالُهُ",14,"ل",2,1],["هذا القماش وما بقي من لونهِ","فلمثل ذوقك يرجع المتأنق",15,"ق",1,0],["هذا القياس قياس الفرد أبطله","وإن لي بالذي قد قسته نظرا",16,"ر",2,0],["هذا القياسُ إذا ما السلِّبَارُ مَضَى","ربعاً ولَم يَبقَ فوقَ الماءِ نَسرَينِ",17,"ن",1,0],["هَذا القياسُ يا أخي دُرجَا","إصبَع بإصبَعَينِ نِعمَ المُرتَجَى",18,"ج",2,0],["هَذَا القرِيضُ لعَمر الله أبكَانَا","دماً وإِن كانَ ياقُوتاً ومرجانَا",19,"ن",2,1],["هذا القران قران سعد اشرقت","فيه من المجد الرفيع نجوم",20,"م",1,1],["هذا القران قران النيرين بدا","على العروسين اذ يجلى العروسان",21,"ن",1,0],["هذا القوم لمن يعد ويذخرُ","هذي الترائب من بها يستأثرُ",22,"ر",1,1],["هذا القوام وهذا البان فانتخبِ","ليفرق الناس بين القد والقضبِ",23,"ب",1,1],["هذا القوام جماله","مهما تعسف، في يديهْ",24,"ي",2,0],["هذا القضاء فغير معذور اذا","لم يرض في احكامه مجبور",25,"ر",1,0],["هذا القضاء فلا مرد لحكمه","فيه تعزوا يا بني طيفور",26,"ر",1,0],["هذا القطارُ يخُدُّ الأرض مُمتطياً","متنَ البسيطةِ في سهلٍ وفي جبل",27,"ل",1,0],["هذا القَرِيضُ ولا أُذنٌ لِمُسْتَمِعِ","فإنْ تَوَلّى فَلاَ حَظٌّ إلى الطَرَبِ",28,"ب",1,0],["هذا القرآن بأيديهم","لكن للنفس قد احتكموا",29,"م",3,0],["هذا القطيع من الأغنام يدفعه","إلى المَسالخِ جزارٌ أخو دأبِ",30,"ب",1,0],["هَذَا الْقَريْضُ شَدَا كَلْثُومَ يُنْشِدُهُ","لَحْنُ الْهُيَامِ فَكَمْ غَنَّتْ بِهِ نُزُلُ",31,"ل",1,0],["هذا القريضُ قصدتُ عُمقَ بِحَارِهِ","وتركتُ ساحلها لمن يخشَى الوَحَلْ",32,"ل",1,0],["هَذَا القَصِيدُ أَغَانِيهَا وَفَرحَتهَا","وَنَبضُها شَادِيَ الألحَانِ والنَّغَمِ",33,"م",1,0],["هذا القُرنفلُ من زُهَيْرات السّمَا","مِن عطرِه رقصَ الفؤادُ ترنُّمَا",34,"م",2,1],["هذا القطيعُ ثغاؤه لَغْوٌ وذِي","أصوافُه قد جزَّها الرُّعيانُ",35,"ن",1,0],["هذا القصيد نشيد النبل يعرفهُ","مكنونه غدِقٌ بالطيبِ يُستطَرُ",36,"ر",1,0],["هذا القَريضُ رياض قد نَمَى عَجَبًا","فاُستبدلَ القبْحَ حُسْنًا في مُقابلهِ",37,"ل",2,0],["هذا القِرابُ ولم يودِّ","عْ سيفَ نخوتِكم قِرابُ",38,"ب",1,0],["هذا القَصيدُ إلى الجَميلَةِ مُرسَلٌ","لِتَمُدَّ لي بَعْدَ البُعادِ وِصالا",39,"ل",2,0],["هذا القلم حبره من قلوب الاحباب","وشلون مايكتب من الطيب للطيب",40,"ب",1,1],["هذا القصيد حروفه تكبو بحزن","باتت تحن إليَّ راضية رضية",41,"ي",2,0],["هذا القصيدُ لرئْمٍ صادَ قافيتي","مستفعلن فعلن مستفعلن فعلاَ",42,"ل",2,0],["هذا القصيد إلى الحبيب أسوقه","والطرف باك والدموع سجامُ",43,"م",1,0],["هذا القصائد ما بال المداد بها؟","هل جفَّ نبعك أم شحّتْ به المقل؟",44,"ل",1,0],["هذا القضاءُ عدوُّ الناسِ أجمعِهم","فليسَ يُفْلِت منه القصرُ والخِيَمُ",45,"م",1,0],["هذا القويُّ بأصغريه غضنفرٌ","حرس العرين وأمَّن المتجاورا",46,"ر",2,0],["هذا القوام يثير اللحظ في عجب","تشتاقه النفس أم يرتاده الحدق",47,"ق",1,0],["هذا القضاء قضى لنا سِيَراً","هلْ بالعوالم يُطْفَأُ البَدْرُ!",48,"ر",1,0],["هذا القضاء وردُّهُ عَبَث","مِنْ شَمسِنا لا يَنْشَفُ البَحْرُ!",48,"ر",1,0]]}