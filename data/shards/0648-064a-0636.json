{"poems":[[63,"الورد يبسم والركائب حوم","https://www.aldiwan.net/poem46212.html","الكامل"],[55,"عبث الحبيب وكان منه صدود","https://www.aldiwan.net/poem26371.html","الكامل"],[35,"سقى دمنتين لم نجد لهما مثلا","https://www.aldiwan.net/poem39120.html","الطويل"],[54,"وذي حسد يغتابني حين لا يرى","https://www.aldiwan.net/poem27532.html","الطويل"],[30,"قف العيس في أطلال مية فاسأل","https://www.aldiwan.net/poem29540.html","الطويل"],[88,"هل الدهر إلا أعجمي أخاطبه","https://www.aldiwan.net/poem45012.html","الطويل"],[51,"أسالم قد سلمت من العيوب","https://www.aldiwan.net/poem8313.html","الوافر"],[51,"أما الزمان إلى سلمى فقد جنحا","https://www.aldiwan.net/poem9264.html","البسيط"],[91,"حي الشآم مهندا وكتابا","https://www.aldiwan.net/poem8755.html","عموديه"],[91,"المرء في غفلاته وسباته","https://www.aldiwan.net/poem8767.html","عموديه"],[91,"أطار عني النوم صوت في الدجى","https://www.aldiwan.net/poem62627.html","عموديه"],[89,"ماذا برقراق السحائب","https://www.aldiwan.net/poem44965.html","مجزوء الكامل"],[89,"إليك تتوق أيتها السماء","https://www.aldiwan.net/poem44967.html","الوافر"],[85,"قد مثلوا في صورة مزوقة","https://www.aldiwan.net/poem7907.html","الرجز"],[85,"أمينة يا بنتي الغاليه","https://www.aldiwan.net/poem8067.html","المتقارب"],[85,"العام أقبل قم نحي هلالا","https://www.aldiwan.net/poem63751.html","الكامل"],[43,"وفاؤكما كالربع أشجاه طاسمه","https://www.aldiwan.net/poem10140.html","الطويل"],[62,"قال الحكيم مقالا أبان","https://www.aldiwan.net/poem52187.html","المتقارب"],[62,"ما بعد يومك للحزين الموجع","https://www.aldiwan.net/poem52353.html","الكامل"],[45,"قامت بلادك لي مقام بلادي","https://www.aldiwan.net/poem63448.html","الكامل"],[45,"مغنى منازلها التي بمشقر","https://www.aldiwan.net/poem63594.html","الكامل"],[45,"بين الشقيقة فاللوى فالأجرع","https://www.aldiwan.net/poem64692.html","الكامل"],[66,"أما ترى الأنواء والسحائبا","https://www.aldiwan.net/poem40945.html","الرجز"],[97,"أمسي يعذبني ويضنيني","https://www.aldiwan.net/poem24798.html","أحذ الكامل"],[80,"وليث مقيم في غياض منيعة","https://www.aldiwan.net/poem31232.html","الطويل"],[80,"لم أسل عنه وقد سلا عني","https://www.aldiwan.net/poem31269.html","أحذ الكامل"],[44,"أي القلوب عليكم ليس ينصدع","https://www.aldiwan.net/poem30310.html","البسيط"],[105,"يهين رجال في الحياة نفوسهم","https://www.aldiwan.net/poem43134.html","الطويل"],[81,"لقد أعقبت بالبؤس منك وبالنعمى","https://www.aldiwan.net/poem61490.html","الطويل"],[39,"هل يدنيك من أجارع واسط","https://www.aldiwan.net/poem53778.html","الكامل"],[39,"طال في رسم مهدد أبده","https://www.aldiwan.net/poem53781.html","المنسرح"],[52,"وسارية لا تمل البكا","https://www.aldiwan.net/poem27320.html","المتقارب"],[48,"سقى الله ظبيا مبدي الغنج في الخطر","https://www.aldiwan.net/poem63298.html","الطويل"],[7,"أهاجك من سعداك مغنى المعاهد","https://www.aldiwan.net/poem2001.html","الطويل"],[46,"أعن وخد القلاص كشفت حالا","https://www.aldiwan.net/poem23633.html","الوافر"],[68,"ته دلالا فأنت أهل لذاكا","https://www.aldiwan.net/poem1517.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85387","الكامل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125577","الرجز"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39580","الكامل"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/65998","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55267","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55155","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[56,"على هَذِهِ كانَتْ تَدورُ النَّوائِبُ","https://www.poetsgate.com/ViewPoem.aspx?id=3536",""],[35,"فَلَوْلا الله ثُمَّ نَدَى ابنِ لَيْلَى","https://www.poetsgate.com/ViewPoem.aspx?id=21985",""]],"verses":[["ويَضيقُ ذَرْعُ المُهْرِ أن لا يَنْجَلي","لَيلٌ بأذْيالِ الصَّباحِ يُلَثَّمُ",0,"م",1,0],["وَيَضِنُّ عَنّي بِالكَلامِ مُصارِماً","وَبِمُهجَتي وَبِما يُريدُ أَجودُ",1,"د",1,0],["وَيَضرِبُ رَيعانَ الكَتيبَةِ صَفُّنا","إِذا أَقبَلَت حَتّى نُطَرِّفَها رَعلا",2,"ل",2,0],["وَيَضحَكُ في وَجهي إِذا ما لَقيتُهُ","وَيَهمِزُني بِالغَيبِ سِرّاً وَيَلسَعُ",3,"ع",1,0],["وَيُضحي بِهِ الرَعنُ الخُشامُ كَأَنَّهُ","وَراءَ الثَنايا شَخصُ أَكلَفَ مُرقِلِ",4,"ل",1,0],["ويضرب أطناب المُنى لي هازلاً","وما أنا مخدوع بما هو ضاربه",5,"ب",2,0],["ويُضحي ما اكتستهُ كلُّ أرضٍ","يميدُ مرنّحاً مَيْد الشُّروبِ",6,"ب",1,0],["ويضرب الهام ضرباً لا كِفاءَ له","ترى لما طار منه موقعاً طرَحا",7,"ح",2,0],["وَيُضَوِّعُ عِطراً كُلَّما شَدَّ الأَسى","بِيَدَيهِ يَعرُكُ قَلبَهُ الوَثّابا",8,"ب",2,0],["وَيُضيرُها إِفلاتُهُ مِن قَيدِها","وَسَعادَةُ الإِنسانِ في إِفلاتِهِ",9,"ت",2,0],["وَيَضرُبُ جِسمُهُ العاري","بِسَوطِ الظالِمِ القاسي",10,"ي",1,0],["ويضئ حتى تستضى","ء به المشارق والمغارب",11,"ب",1,0],["ويضرب عن وراء الموت صفحاً","كأن الموت ليس له وراءُ",12,"ا",2,0],["ويضرع الفلاح حسبي وربي","أطعمكم جميعكم من حبي",13,"ي",1,0],["وَيَضحَكُ إِن جِئتِهِ تَضحَكينَ","وَيَبكي إِذا جِئتِهِ باكِيَه",14,"ي",2,0],["وَيُضيءُ أَثناءَ الخَمائِلِ وَالرُبى","حَتّى تَرى أَسحارَها آصالا",15,"ل",2,0],["وَيُضحي غُبارُ الخَيلِ أَدنى سُتورِهِ","وَآخِرُها نَشرُ الكِباءِ المُلازِمُه",16,"م",2,0],["ويضحي صديقاً لها في الأخير","فيلزمها بعدما ينعقد",17,"د",1,0],["ويُضيءُ في سُدَفِ العَجاج بجذوةٍ","قد أُشعِلتْ بيد القُيونِ لتُبَّعِ",18,"ع",1,0],["وَيُضاعِفُ الوَعدَ الَّذي أَكَّدتَهُ","أَنَّ الَّذي أَعطَيتَ جِدُّ مُعادِ",19,"د",1,0],["وَيُضيءُ تَحسِبُ أَنَّ ماءَ غَمامِهِ","قَمَرٌ تَقَطَّعَ في إِناءٍ أَخضَرِ",20,"ر",1,0],["وَيُضيءُ مِن خَلفِ السِنانِ إِذا دَجا","وَجهُ الكَمِيِّ عَلى الكَمِيِّ الأَروَعِ",21,"ع",1,0],["وَيَضمَنُ المَصروعَ وَالصَوائِبا","أَصلَحَهُ صالِحٌ عِندَ جَسِّهِ",22,"ه",1,0],["ويضمنا الليل العظيم وما","كالليل مأوى للمساكينِ",23,"ن",1,0],["ويضربُ جنبيه به فَكَأنّما","له فيهما طَبْلٌ يَحُضّ على الكرِّ",24,"ر",1,0],["ويُضْحك في التعبيس فكّيه عن مدى","نيوبٍ صلابٍ ليس تُهتَمُ بالفِهْرِ",24,"ر",1,0],["ويضيفُ ريقَتَهُ بقبلتِهِ","كَإضافةِ السلوى إلى المنِّ",25,"ن",1,0],["وَيَضحَكُ الدَهرُ مِنهُم عَن غَطارِفَةٍ","كَأَنَّ أَيّامَهُم مِن أُنسِها جُمَعُ",26,"ع",1,0],["وَيَضرِبُ قَومٌ في البِلادِ لَعَلَّهُم","يُصيبونَ مالاً أَو يَنالونَ مَغنَما",27,"م",2,0],["وَيُضحِكُ ثَغرَ النَصرِ في كُلِّ مَعرَكٍ","يُرى وَسطَهُ وَجهُ الرَدى عابِساً جَهما",28,"م",2,0],["وَيُضَحضَحُ اللُجَجَ الغَمارَ بِسَيبِهِ","حَتّى يَصِرنَ وَهُنَّ غَيرُ غَمارِ",29,"ر",1,0],["وَيُضيعُ الَّذي يُصَيِّرُهُ اللَ","هُ إِلَيهِ فَلَيسَ يَعتَقِدُه",30,"د",2,0],["وَيَضحَكُ عَن أُقحُوانِ الرِيا","ضِ وَيَغسِلُهُ بِالعَشِيِّ النَدى",31,"ا",1,0],["وَيَضحَكُ عَن ثَغرٍ مَليحٍ كَأَنَّهُ","حُبابُ عُقارٍ أَو نَقِيٌّ مِنَ الدُرِّ",32,"ر",1,0],["وَيَضرِبنَ بِالأَيدي وَراءَ بَراغِزٍ","حِسانِ الوُجوهِ كَالظِباءِ العَواقِدِ",33,"د",1,0],["ويُضْحي والحديدُ عليه شاكٍ","وتَكْفِيهِ مَهابَتُهُ النّزَالا",34,"ل",2,0],["ويَضُوعُ العبيرُ في كلّ نادٍ","وهْوَ ذِكْرٌ معَبِّرٌ عن شذاكا",35,"ك",2,0],["وَيَضَعنَ منها في الرقاب قَلائداً","تزري بعقد الدرِّ وَالمرجان",36,"ن",1,0],["ويضربُ البحر عَلَي","هِ مَوجَه مُنتحِبا",37,"ب",2,0],["ويضيقُ بالشعبِ الطموحِ يقينهُ","ويُثيرُ مِرّتهُ الخيالُ فيَعْرُمُ",38,"م",1,0],["ويَضُجُّ جبَّارُ الأسى","وتَجيشُ أمواجُ الكُرُوبْ",39,"ب",1,0],["وَيَضْحَكُ مِنْ خُشُبٍ شُرَّعٍ","بِأَيْدِيهِمْ الرُّمْحُ وَالمِخْذَمُ",40,"م",1,0],["وَيَضُمُّ المُنْتَدى البَحْرِ","يُّ صَحْباً وأُهَيْلاَ",41,"ل",2,0],["ويُضَاعِفُ السَّرَّاءَ فِي إِقْبَالِهَا","تَذْكَارُ مَا وَلَّى مِنَ الضَّرَّاءِ",42,"ا",2,0],["ويَضْحَكُ سِنُّ المَرْءِ والقَلْبُ مُوْجَعٌ","ويرضى الفتى عن دهرهِ وهو عاتبُ",43,"ب",1,0],["وَيَضْرِبُ مِنْ نوالِكَ في بلادٍ","من المعروفِ واسعة ٍ رحابِ",44,"ب",1,0]]}