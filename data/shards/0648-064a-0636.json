{"poems":[[63,"الورد يبسم والركائب حوم","https://www.aldiwan.net/poem46212.html","الكامل"],[55,"عبث الحبيب وكان منه صدود","https://www.aldiwan.net/poem26371.html","الكامل"],[35,"سقى دمنتين لم نجد لهما مثلا","https://www.aldiwan.net/poem39120.html","الطويل"],[54,"وذي حسد يغتابني حين لا يرى","https://www.aldiwan.net/poem27532.html","الطويل"],[30,"قف العيس في أطلال مية فاسأل","https://www.aldiwan.net/poem29540.html","الطويل"],[88,"هل الدهر إلا أعجمي أخاطبه","https://www.aldiwan.net/poem45012.html","الطويل"],[51,"أسالم قد سلمت من العيوب","https://www.aldiwan.net/poem8313.html","الوافر"],[51,"أما الزمان إلى سلمى فقد جنحا","https://www.aldiwan.net/poem9264.html","البسيط"],[91,"حي الشآم مهندا وكتابا","https://www.aldiwan.net/poem8755.html","عموديه"],[91,"المرء في غفلاته وسباته","https://www.aldiwan.net/poem8767.html","عموديه"],[91,"أطار عني النوم صوت في الدجى","https://www.aldiwan.net/poem62627.html","عموديه"],[89,"ماذا برقراق السحائب","https://www.aldiwan.net/poem44965.html","مجزوء الكامل"],[89,"إليك تتوق أيتها السماء","https://www.aldiwan.net/poem44967.html","الوافر"],[85,"قد مثلوا في صورة مزوقة","https://www.aldiwan.net/poem7907.html","الرجز"],[85,"أمينة يا بنتي الغاليه","https://www.aldiwan.net/poem8067.html","المتقارب"],[85,"العام أقبل قم نحي هلالا","https://www.aldiwan.net/poem63751.html","الكامل"],[43,"وفاؤكما كالربع أشجاه طاسمه","https://www.aldiwan.net/poem10140.html","الطويل"],[62,"قال الحكيم مقالا أبان","https://www.aldiwan.net/poem52187.html","المتقارب"],[62,"ما بعد يومك للحزين الموجع","https://www.aldiwan.net/poem52353.html","الكامل"],[45,"قامت بلادك لي مقام بلادي","https://www.aldiwan.net/poem63448.html","الكامل"],[45,"مغنى منازلها التي بمشقر","https://www.aldiwan.net/poem63594.html","الكامل"],[45,"بين الشقيقة فاللوى فالأجرع","https://www.aldiwan.net/poem64692.html","الكامل"],[66,"أما ترى الأنواء والسحائبا","https://www.aldiwan.net/poem40945.html","الرجز"],[97,"أمسي يعذبني ويضنيني","https://www.aldiwan.net/poem24798.html","أحذ الكامل"],[80,"وليث مقيم في غياض منيعة","https://www.aldiwan.net/poem31232.html","الطويل"],[80,"لم أسل عنه وقد سلا عني","https://www.aldiwan.net/poem31269.html","أحذ الكامل"],[44,"أي القلوب عليكم ليس ينصدع","https://www.aldiwan.net/poem30310.html","البسيط"],[105,"يهين رجال في الحياة نفوسهم","https://www.aldiwan.net/poem43134.html","الطويل"],[81,"لقد أعقبت بالبؤس منك وبالنعمى","https://www.aldiwan.net/poem61490.html","الطويل"],[39,"هل يدنيك من أجارع واسط","https://www.aldiwan.net/poem53778.html","الكامل"],[39,"طال في رسم مهدد أبده","https://www.aldiwan.net/poem53781.html","المنسرح"],[52,"وسارية لا تمل البكا","https://www.aldiwan.net/poem27320.html","المتقارب"],[48,"سقى الله ظبيا مبدي الغنج في الخطر","https://www.aldiwan.net/poem63298.html","الطويل"],[7,"أهاجك من سعداك مغنى المعاهد","https://www.aldiwan.net/poem2001.html","الطويل"],[46,"أعن وخد القلاص كشفت حالا","https://www.aldiwan.net/poem23633.html","الوافر"],[68,"ته دلالا فأنت أهل لذاكا","https://www.aldiwan.net/poem1517.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85387","الكامل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125577","الرجز"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39580","الكامل"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/65998","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55267","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55155","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[56,"على هَذِهِ كانَتْ تَدورُ النَّوائِبُ","https://www.poetsgate.com/ViewPoem.aspx?id=3536",""],[100,"أغنية من خشب","https://www.poetsgate.com/ViewPoem.aspx?id=50378",""],[100,"الجناح المحطم","https://www.poetsgate.com/ViewPoem.aspx?id=50344",""],[100,"الفاتح الأعزل","https://www.poetsgate.com/ViewPoem.aspx?id=50351",""],[94,"الشّهيد","https://www.poetsgate.com/ViewPoem.aspx?id=13789",""],[35,"فَلَوْلا الله ثُمَّ نَدَى ابنِ لَيْلَى","https://www.poetsgate.com/ViewPoem.aspx?id=21985",""],[109,"لا تنزلن على رياض لاسمها","https://www.aldiwan.net/poem16546.html","الكامل"],[120,"حثا شرابهما في ظل حسان","https://www.aldiwan.net/poem49285.html","البسيط"],[124,"الناس ما الناس عبدان القوى بهم","https://www.aldiwan.net/poem23728.html","البسيط"],[125,"سلام ولا أقرا سلاماً على هند","https://www.aldiwan.net/poem4095.html","الطويل"],[160,"أيرجو أن يزور وأن يزارا","https://www.aldiwan.net/poem58952.html","الوافر"],[169,"ألا قل لمن أرهقته الذنوب","https://www.aldiwan.net/poem1681.html",""],[186,"دمع تحدر في انسيابه","https://www.aldiwan.net/poem44153.html","مجزوء الكامل"],[198,"يا شمس خدر مالها مغرب","https://www.aldiwan.net/poem51986.html","السريع"],[212,"زار الحبيب وللواشين أبراق","https://www.aldiwan.net/poem37855.html","الطويل"],[229,"ويلي على من كل عين","https://www.aldiwan.net/poem50794.html","مجزوء الكامل"],[231,"خذ للحجاز إذا مررت بركبه","https://www.aldiwan.net/poem44598.html","الكامل"],[231,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[237,"أقول لمن يصيخ إلى اصطراخي","https://www.aldiwan.net/poem18130.html","الوافر"],[237,"أذا العرش إن تبسم ثغور العرائش","https://www.aldiwan.net/poem19723.html","الطويل"],[256,"لا والذي يا سيدي","https://www.aldiwan.net/poem48339.html","مجزوء الكامل"],[261,"متى يستفيق الدهر من غفلانه","https://www.aldiwan.net/poem38140.html","الطويل"],[261,"منهل دمع المحب من دمه","https://www.aldiwan.net/poem38141.html","المنسرح"],[270,"لا يقل أحمق النساء بلاء","https://www.aldiwan.net/poem35182.html","الخفيف"],[270,"أرى أبدا قلبي الجريء جريحا","https://www.aldiwan.net/poem35214.html","الطويل"],[270,"تذكرت في الحمراء عهد الصبوة","https://www.aldiwan.net/poem35637.html","الطويل"],[275,"أحقا طربت إلى الربرب","https://www.aldiwan.net/poem25612.html","المتقارب"],[290,"لا تسألني فيم النحول","https://www.aldiwan.net/poem11679.html","مجزوء الكامل"],[305,"بصادق عزم تفخر الدولة الوسطى","https://www.aldiwan.net/poem56490.html","الطويل"],[348,"أيها الفاضل الذي قصر الفا","https://www.aldiwan.net/poem20783.html","الخفيف"],[353,"يطارحني هذا الزمان بهمه","https://www.aldiwan.net/poem39778.html","الطويل"],[364,"للطيف بحر بكاي ينفرق","https://www.aldiwan.net/poem60833.html","أحذ الكامل"],[364,"يا معرضا قد آن أن تتلفتا","https://www.aldiwan.net/poem60975.html","الكامل"],[380,"منع القرار متيم","https://www.aldiwan.net/poem49236.html","مجزوء الكامل"],[403,"القلب أعلم يا عذول بدائه","https://www.aldiwan.net/poem34180.html","الكامل"],[406,"بعثت إليك بطيفها تعليلا","https://www.aldiwan.net/poem50139.html","الطويل"],[408,"ومنوع الحركات يلعب بالنهى","https://www.aldiwan.net/poem4196.html","الكامل"],[439,"شهدت لك الأعياد أنك عيدها","https://www.aldiwan.net/poem34893.html","الكامل"],[448,"أترى لداء صبابتي ابلال","https://www.aldiwan.net/poem53722.html","الكامل"],[458,"لنا من ليلنا بلِوى الصريمِ","https://www.aldiwan.net/poem55891.html","الوافر"],[458,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[458,"أيا ليل جو من بشيرك بالصبح","https://www.aldiwan.net/poem56252.html","الطويل"],[461,"يرش كثيف الدجن حينا وتارة","https://www.aldiwan.net/poem15371.html","الطويل"],[461,"يفر الخطب قد أمهي شباه","https://www.aldiwan.net/poem16107.html","الوافر"],[461,"حزت المكارم والعلى","https://www.aldiwan.net/poem16153.html","مجزوء الكامل"],[464,"عيون المهى قلبي بنبلك مجروح","https://www.aldiwan.net/poem3149.html","عموديه"],[464,"يا من تلون عهده وتغيرا","https://www.aldiwan.net/poem3198.html","عموديه"],[464,"لندى يديك ويمن رأيك","https://www.aldiwan.net/poem3314.html","عموديه"],[477,"أشد الهوى ما يمنع العين أن تكرى","https://www.aldiwan.net/poem15349.html","الطويل"],[529,"يا جاهلا في نصر سنة أحمد","https://www.aldiwan.net/poem37462.html","الكامل"],[538,"لله أيام مع الأحباب","https://www.aldiwan.net/poem48291.html","عموديه"],[538,"إني بعثت لسيدي بكتابي","https://www.aldiwan.net/poem48294.html","عموديه"],[538,"بما بيننا من حرمة ايها الصحب","https://www.aldiwan.net/poem48303.html","عموديه"],[546,"آذنت جارتي بوشك رحيل","https://www.aldiwan.net/poem1858.html","الخفيف"],[551,"كذا تكشف الغماء بعد ظلامها","https://www.aldiwan.net/poem47193.html","الطويل"],[551,"ألا ما لقلب بأيدي الغواة","https://www.aldiwan.net/poem47280.html","المتقارب"],[551,"سائل بيثرب هل ثوى الركب","https://www.aldiwan.net/poem48101.html","أحذ الكامل"],[558,"ربما يكذب حسادي علي","https://www.aldiwan.net/poem33569.html","الرمل"],[562,"أقول اليوم صار الشرق شرقا","https://www.aldiwan.net/poem52881.html","البسيط"]],"verses":[["ويَضيقُ ذَرْعُ المُهْرِ أن لا يَنْجَلي","لَيلٌ بأذْيالِ الصَّباحِ يُلَثَّمُ",0,"م",1,0],["وَيَضِنُّ عَنّي بِالكَلامِ مُصارِماً","وَبِمُهجَتي وَبِما يُريدُ أَجودُ",1,"د",1,0],["وَيَضرِبُ رَيعانَ الكَتيبَةِ صَفُّنا","إِذا أَقبَلَت حَتّى نُطَرِّفَها رَعلا",2,"ل",2,0],["وَيَضحَكُ في وَجهي إِذا ما لَقيتُهُ","وَيَهمِزُني بِالغَيبِ سِرّاً وَيَلسَعُ",3,"ع",1,0],["وَيُضحي بِهِ الرَعنُ الخُشامُ كَأَنَّهُ","وَراءَ الثَنايا شَخصُ أَكلَفَ مُرقِلِ",4,"ل",1,0],["ويضرب أطناب المُنى لي هازلاً","وما أنا مخدوع بما هو ضاربه",5,"ب",2,0],["ويُضحي ما اكتستهُ كلُّ أرضٍ","يميدُ مرنّحاً مَيْد الشُّروبِ",6,"ب",1,0],["ويضرب الهام ضرباً لا كِفاءَ له","ترى لما طار منه موقعاً طرَحا",7,"ح",2,0],["وَيُضَوِّعُ عِطراً كُلَّما شَدَّ الأَسى","بِيَدَيهِ يَعرُكُ قَلبَهُ الوَثّابا",8,"ب",2,0],["وَيُضيرُها إِفلاتُهُ مِن قَيدِها","وَسَعادَةُ الإِنسانِ في إِفلاتِهِ",9,"ت",2,0],["وَيَضرُبُ جِسمُهُ العاري","بِسَوطِ الظالِمِ القاسي",10,"ي",1,0],["ويضئ حتى تستضى","ء به المشارق والمغارب",11,"ب",1,0],["ويضرب عن وراء الموت صفحاً","كأن الموت ليس له وراءُ",12,"ا",2,0],["ويضرع الفلاح حسبي وربي","أطعمكم جميعكم من حبي",13,"ي",1,0],["وَيَضحَكُ إِن جِئتِهِ تَضحَكينَ","وَيَبكي إِذا جِئتِهِ باكِيَه",14,"ي",2,0],["وَيُضيءُ أَثناءَ الخَمائِلِ وَالرُبى","حَتّى تَرى أَسحارَها آصالا",15,"ل",2,0],["وَيُضحي غُبارُ الخَيلِ أَدنى سُتورِهِ","وَآخِرُها نَشرُ الكِباءِ المُلازِمُه",16,"م",2,0],["ويضحي صديقاً لها في الأخير","فيلزمها بعدما ينعقد",17,"د",1,0],["ويُضيءُ في سُدَفِ العَجاج بجذوةٍ","قد أُشعِلتْ بيد القُيونِ لتُبَّعِ",18,"ع",1,0],["وَيُضاعِفُ الوَعدَ الَّذي أَكَّدتَهُ","أَنَّ الَّذي أَعطَيتَ جِدُّ مُعادِ",19,"د",1,0],["وَيُضيءُ تَحسِبُ أَنَّ ماءَ غَمامِهِ","قَمَرٌ تَقَطَّعَ في إِناءٍ أَخضَرِ",20,"ر",1,0],["وَيُضيءُ مِن خَلفِ السِنانِ إِذا دَجا","وَجهُ الكَمِيِّ عَلى الكَمِيِّ الأَروَعِ",21,"ع",1,0],["وَيَضمَنُ المَصروعَ وَالصَوائِبا","أَصلَحَهُ صالِحٌ عِندَ جَسِّهِ",22,"ه",1,0],["ويضمنا الليل العظيم وما","كالليل مأوى للمساكينِ",23,"ن",1,0],["ويضربُ جنبيه به فَكَأنّما","له فيهما طَبْلٌ يَحُضّ على الكرِّ",24,"ر",1,0],["ويُضْحك في التعبيس فكّيه عن مدى","نيوبٍ صلابٍ ليس تُهتَمُ بالفِهْرِ",24,"ر",1,0],["ويضيفُ ريقَتَهُ بقبلتِهِ","كَإضافةِ السلوى إلى المنِّ",25,"ن",1,0],["وَيَضحَكُ الدَهرُ مِنهُم عَن غَطارِفَةٍ","كَأَنَّ أَيّامَهُم مِن أُنسِها جُمَعُ",26,"ع",1,0],["وَيَضرِبُ قَومٌ في البِلادِ لَعَلَّهُم","يُصيبونَ مالاً أَو يَنالونَ مَغنَما",27,"م",2,0],["وَيُضحِكُ ثَغرَ النَصرِ في كُلِّ مَعرَكٍ","يُرى وَسطَهُ وَجهُ الرَدى عابِساً جَهما",28,"م",2,0],["وَيُضَحضَحُ اللُجَجَ الغَمارَ بِسَيبِهِ","حَتّى يَصِرنَ وَهُنَّ غَيرُ غَمارِ",29,"ر",1,0],["وَيُضيعُ الَّذي يُصَيِّرُهُ اللَ","هُ إِلَيهِ فَلَيسَ يَعتَقِدُه",30,"د",2,0],["وَيَضحَكُ عَن أُقحُوانِ الرِيا","ضِ وَيَغسِلُهُ بِالعَشِيِّ النَدى",31,"ا",1,0],["وَيَضحَكُ عَن ثَغرٍ مَليحٍ كَأَنَّهُ","حُبابُ عُقارٍ أَو نَقِيٌّ مِنَ الدُرِّ",32,"ر",1,0],["وَيَضرِبنَ بِالأَيدي وَراءَ بَراغِزٍ","حِسانِ الوُجوهِ كَالظِباءِ العَواقِدِ",33,"د",1,0],["ويُضْحي والحديدُ عليه شاكٍ","وتَكْفِيهِ مَهابَتُهُ النّزَالا",34,"ل",2,0],["ويَضُوعُ العبيرُ في كلّ نادٍ","وهْوَ ذِكْرٌ معَبِّرٌ عن شذاكا",35,"ك",2,0],["وَيَضَعنَ منها في الرقاب قَلائداً","تزري بعقد الدرِّ وَالمرجان",36,"ن",1,0],["ويضربُ البحر عَلَي","هِ مَوجَه مُنتحِبا",37,"ب",2,0],["ويضيقُ بالشعبِ الطموحِ يقينهُ","ويُثيرُ مِرّتهُ الخيالُ فيَعْرُمُ",38,"م",1,0],["ويَضُجُّ جبَّارُ الأسى","وتَجيشُ أمواجُ الكُرُوبْ",39,"ب",1,0],["وَيَضْحَكُ مِنْ خُشُبٍ شُرَّعٍ","بِأَيْدِيهِمْ الرُّمْحُ وَالمِخْذَمُ",40,"م",1,0],["وَيَضُمُّ المُنْتَدى البَحْرِ","يُّ صَحْباً وأُهَيْلاَ",41,"ل",2,0],["ويُضَاعِفُ السَّرَّاءَ فِي إِقْبَالِهَا","تَذْكَارُ مَا وَلَّى مِنَ الضَّرَّاءِ",42,"ا",2,0],["ويَضْحَكُ سِنُّ المَرْءِ والقَلْبُ مُوْجَعٌ","ويرضى الفتى عن دهرهِ وهو عاتبُ",43,"ب",1,0],["ويضي المغنّى يديه وفاه","وشيء يجلمد حسّ الطرب",44,"ب",1,0],["ويضمّ البلاد خلف الحنايا","أمنيات وذكريات ملاحا",45,"ح",2,0],["ويضيع جمالا مبذولا","في الكشف عن العدم الأجمل",46,"ل",1,0],["ويضحك لي وجه نديّ منوّر","كأن لم يغيّب من طلاقته القبر",47,"ر",1,0],["وَيَضْرِبُ مِنْ نوالِكَ في بلادٍ","من المعروفِ واسعة ٍ رحابِ",48,"ب",1,0],["وَيُضيءُ في شَرق وَغَرب إِن دجا","لَيل الخُطوب عَلى الوَرى مِصباحها",49,"ح",3,0],["ويضحكان إذا ما الخمر رنحني","دوارها واستوى سرى وإعلاني",50,"ي",1,0],["ويضفرون بأيديهم لقاطعها","حرصاً على البغي اكليلين من غار",51,"ر",1,0],["وَيَضحكُ عن روضٍ تُداني يد الصبّا","به صفحة السّوسانِ مِن صفحةِ الوردِ",52,"د",1,0],["ويضربُ بالظبا في كلِّ فجٍ","طِلاً مالت عن الحق اغترارا",53,"ر",2,0],["وَيُضحي الَّذي أَنفُهُ في التُخُومِ","يُطاوِلُ مَن يَتَمَطّى النُجُوما",54,"م",2,0],["ويضنّ مسؤول النوا","ل ولو بكوز من شرابه",55,"ب",2,0],["ويضربُ الهامَ به أروعٌ","سُرادق الفخرِ به يُضربُ",56,"ب",1,0],["ويُضْحي حنينُ الرَّعْدِ يُشْبه زفرتي","إذا ما سَمِعْتُ العَنْدليبَ المُطَوَّقا",57,"ق",2,0],["ويضره لبس الغلا","ئِلِ والشنوفِ ويؤلِمه",58,"م",2,0],["ويضمني وبني الوداد بجوّه","سربال وصل لا أراع بسلبه",59,"ب",2,0],["وَيُضيئُ إِن لَبِسَ السَّوادَ بَياضُهُ","حَتَّى يُنَوِّرَ مُظلِمَ الأَكنانِ",60,"ن",1,0],["وَيُضْحِي مِثْلَ لَحْمٍ مِنْ حُوَارٍ","مُسيخاً لا يُطَيَّبُ بِانْطِباخِ",61,"خ",1,0],["وَيُضْحِي بِهَا نَابُ الْهُدَى يَنْهَشُ الْهَوَى","وَيُمْسِي بِهَا ظُفْرُ الْهَوَى غَيْرَ خَادِشِ",62,"ش",1,0],["ويضيع فيها الخضر وه","ويسير في ظهر البراق",63,"ق",1,0],["ويضجر ما لم يلقني من ضميره","كما ضجر المصدور من نفثاته",64,"ت",2,0],["ويضمر الحقد في ضمائره","ويظهر الود من تبسمه",65,"م",2,0],["ويضلُّ الرهبانُ إن طرقتهم","في صلاةٍ ويجهلُ الحكماء",66,"ا",2,0],["ويَضربُني طيفُ الدُّجى بجناحهِ","فأسكتُ رعباً تحتَهُ فيصيحا",67,"ح",2,0],["ويضعفُ هذا القلبُ حتى نظنَّهُ","تساقطَ منا فلذةً إثر فلذة",68,"ه",1,0],["وَيَضْرَى عَلى الفَتْكِ بِالضّارِيات","وإن غَالَبَ القِرْنَ لَمْ يُغْلَب",69,"ب",1,0],["ويضيق بالحر الكريم","فما له من شافع",70,"ع",1,0],["وَيُضفي عَليها فيأةً من حمايةٍ","تقيلُ وَتَستذري بعزّتها لَعطا",71,"ط",2,0],["وَيُضَاهِي مَوارِدَ النِيِّلِ فيها","كُلُّ صَافٍ من مَاءِ ذاكَ البَنانِ",72,"ن",1,0],["وَيَضحك بابوجي عَلَيهِ بِجَيبِهِ","كَما ضحك الزَهر الأَنيقِ بكمِّهِ",73,"م",2,0],["ويُضيءُ قرطاساً ومِن عجَبٍ","جَوْنٌ يُضيء بصِبْغِه يَقَق",74,"ق",1,0],["ويَضُجُ منّي كلُّ مَنْبِت شَعْرةٍ","فيما أُجِنُّ ولو خَرِسْتُ تَزَمُّتا",75,"ت",2,0],["وَيَضلُّ في آيات حُسنَك","عَقلُهُ المتوسم",76,"م",1,0],["ويضمه لا مشفقاً في ضمه","حتى تكون حشاه في أحشائه",77,"ا",3,0],["وَيُضيءُ منه الطَرس ساعَة يَكتَسي","صَدأ المِداد وَلا يُضيء صَقيلا",78,"ل",2,0],["ويضُم لِلقَدَمين منه رأسه","كالسَيف ضُمَّ ذُبابه لرئاسه",79,"س",2,0],["ويضيقُ فِيهَا العُذْرُ عن خَطِيَّةٍ","سمراءَ لَمْ يُورِقْ بكفِّكَ عُودُها",80,"د",3,0],["ويضيق بى رحب الفضاء واننى","مما نحلت كأنما أنا آل",81,"ل",1,0],["ويُضعِفُ مُنَّتي ويميتُ فضلي","تَطَلُّبِيَ الثراءَ من العديمِ",82,"م",1,0],["ويضوعَ منك بطيبِ ما في ضمنه","فكأنّ ضارجَ تُربه عطَّارُ",83,"ر",1,0],["ويُضحي ويُمسي ضوءُ وجهكِ بيننا","سراجاً وضوءُ البدر يُمسي ولا يُضحي",84,"ي",1,0],["ويُضعف أدنى العار محملَ عرضه","ولكن لاِعْباءِ المكارمِ حاملُ",85,"ل",1,0],["ويُضْحي المحْلُ بالآفاقِ خِصْباً","يَعُمُّ الخفْضُ منهُ والنَّعيمُ",86,"م",1,0],["ويُضِيءُ لَيْلَ الخَطْبِ رأيُك","وهو داجي اللَّون حالِك",87,"ك",1,0],["ويضرم وجدي شيحهُ وثمامهُ","وأية نارٍ ليس يضرمها الشيح",88,"ح",1,0],["ويضيءُ في الزمن البهيم فعالهُ","والصبحُ ليس بمنكرٍ أن يسفرا",89,"ر",2,0],["ويضيء وجهُ العيش حين","يلوح أبلجَ في إضايك",90,"ك",1,0],["ويُضحي ونارُ الشوقِ بين ضلوعِه","تُؤججُها الشكوى وتُضرِمُها الذكرى",91,"ر",2,0],["ويُضَمِّخُ الأَرْجَا بجامِعِ عِلْمِهِمْ","وشِفائِهم يَشِْي بهِ قَلْبَ الصَّدِي",92,"د",2,0],["ويَضُوع نشرُ المسكِ بينَ سُطورِها","بِبلاغَةٍ تسمُو سُموَّ حبَابِ",93,"ب",1,0],["وَيضُوعُ نشرُ المسكِ بينَ سُطورِه","بفًُكَاهةٍ تسمُو سمُوِّ حُبَابِ",94,"ب",1,0],["ويُضحِكِنُي مِنهم إلَىَّ تسَابقٌ","ليُخبِرَني خِبٌّ بمَا قالَه خِبُّ",95,"ب",1,0],["وَيضِيعُ الذي يَصِيرُ إليهِ","مِنْ شَقاءٍ أَوْ مُلْكِ خُلْدٍ بجيلِ",96,"ل",1,0],["وَيَضحكُ وَجهُ الخَطْبِ بعد عُبوسِهِ","وتخمدُ نارُ الحربِ بعد اِضطرامِها",97,"م",3,0],["ويُضحِي قتيلَ بدور الخدو","رِ وَجْداً وما من دمٍ سائلِ",98,"ل",1,0],["وَيُضيءُ في إِظلامِ داجِيَةٍ","ما لا تُضيءُ لَنا بهِ الشُّهبُ",99,"ب",1,0],["ويضل الله قد قال به","وبه يهدي كثيراً فلتهي",100,"ي",1,0],["ويُضحِكُ أُنسُهُ مَنْ كَانَ يبكي","ويُسعِدُ لُطُفُهُ مَن كانَ يَشْقَى",101,"ق",2,0]]}