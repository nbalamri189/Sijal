"https://www.poetsgate.com/ViewPoem.aspx?id=192441",""],[5431,"وصلّت مع الضحكة التاسعة","https://www.poetsgate.com/ViewPoem.aspx?id=197802",""],[5431,"لسيدي محمد رسول الله (ص)","https://www.poetsgate.com/ViewPoem.aspx?id=198211",""],[5431,"((أني معك!))","https://www.poetsgate.com/ViewPoem.aspx?id=198345",""],[5444,"زيتونة المسرى","https://www.poetsgate.com/ViewPoem.aspx?id=205084",""],[5493,"ينادي الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=197641",""],[5561,"سفر الروح","https://www.poetsgate.com/ViewPoem.aspx?id=192757",""],[5561,"ومضة شوق","https://www.poetsgate.com/ViewPoem.aspx?id=193806",""],[5582,"سَقاكِ دِيارَ الظَّاعِنِينَ غَمامُ","https://www.poetsgate.com/ViewPoem.aspx?id=187273",""],[5582,"قِفْ بِالرُّسُومِ وَسائِلْ الأَطْلالا","https://www.poetsgate.com/ViewPoem.aspx?id=187237",""],[5582,"هذِي بِشاراتُ السُّرُورِ تَراها","https://www.poetsgate.com/ViewPoem.aspx?id=187331",""],[5582,"قَلْبٌ عَلَى جَمْرِ الغَرامِ يُقَلَّبُ","https://www.poetsgate.com/ViewPoem.aspx?id=186671",""],[5582,"لِمَن الهَوادِجُ وَالقبب","https://www.poetsgate.com/ViewPoem.aspx?id=63458",""],[5674,"أمشي على عكاز قلبي عاثرة","https://www.poetsgate.com/ViewPoem.aspx?id=191892",""],[5690,"فتلوتها ووقفت إجلالاً لها","https://www.poetsgate.com/ViewPoem.aspx?id=172172",""],[5732,"دار لنا","https://www.poetsgate.com/ViewPoem.aspx?id=177832",""],[5736,"متوازيان","https://www.poetsgate.com/ViewPoem.aspx?id=203812",""],[5790,"نظري إليكم والركاب تساق","https://www.poetsgate.com/ViewPoem.aspx?id=112085",""],[5829,"ولد السلام","https://www.poetsgate.com/ViewPoem.aspx?id=178915",""],[5829,"بلسم الروح","https://www.poetsgate.com/ViewPoem.aspx?id=180642",""],[5848,"خيوط الظلام","https://www.poetsgate.com/ViewPoem.aspx?id=50585",""],[5848,"ثروة وثورة","https://www.poetsgate.com/ViewPoem.aspx?id=53369",""],[5897,"ندى","https://www.poetsgate.com/ViewPoem.aspx?id=176414",""],[5906,"غدا يشيّعنا التاريخ","https://www.poetsgate.com/ViewPoem.aspx?id=193749",""],[5937,"اللّا وَرَقِيَّة","https://www.poetsgate.com/ViewPoem.aspx?id=211908",""],[5953,"علت قباب لكم هداتي","https://www.poetsgate.com/ViewPoem.aspx?id=93794",""],[5953,"لاح ضياء القمر الزاهر","https://www.poetsgate.com/ViewPoem.aspx?id=93849",""],[5956,"أوقات الإلهام","https://www.poetsgate.com/ViewPoem.aspx?id=186120",""],[5956,"هنالك في عمق السعود كواكب","https://www.poetsgate.com/ViewPoem.aspx?id=193362",""],[6022,"عبيدك ظامئ","https://www.poetsgate.com/ViewPoem.aspx?id=205699",""],[6102,"زيفا الإسرائيلية","https://www.poetsgate.com/ViewPoem.aspx?id=184171",""],[6142,"إذا ما سهام الدهر أغرق نزعها","https://www.poetsgate.com/ViewPoem.aspx?id=155756",""],[6142,"مادت الأرض انقلاباً والسما","https://www.poetsgate.com/ViewPoem.aspx?id=155750",""],[5309,"سلام على ذكر العلى سالف العهد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573521",""],[6177,"قلق الحُروف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79602&r=&rc=0",""],[6198,"ناي الهوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79296&r=&rc=70",""],[6355,"الحفيُّ بمن أعادي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66684&r=&rc=144",""]],"verses":[["ويَضيقُ ذَرْعُ المُهْرِ أن لا يَنْجَلي","لَيلٌ بأذْيالِ الصَّباحِ يُلَثَّمُ",0,"م",1,0],["وَيَضِنُّ عَنّي بِالكَلامِ مُصارِماً","وَبِمُهجَتي وَبِما يُريدُ أَجودُ",1,"د",1,0],["وَيَضرِبُ رَيعانَ الكَتيبَةِ صَفُّنا","إِذا أَقبَلَت حَتّى نُطَرِّفَها رَعلا",2,"ل",2,0],["وَيَضحَكُ في وَجهي إِذا ما لَقيتُهُ","وَيَهمِزُني بِالغَيبِ سِرّاً وَيَلسَعُ",3,"ع",1,0],["وَيُضحي بِهِ الرَعنُ الخُشامُ كَأَنَّهُ","وَراءَ الثَنايا شَخصُ أَكلَفَ مُرقِلِ",4,"ل",1,0],["ويضرب أطناب المُنى لي هازلاً","وما أنا مخدوع بما هو ضاربه",5,"ب",2,0],["ويُضحي ما اكتستهُ كلُّ أرضٍ","يميدُ مرنّحاً مَيْد الشُّروبِ",6,"ب",1,0],["ويضرب الهام ضرباً لا كِفاءَ له","ترى لما طار منه موقعاً طرَحا",7,"ح",2,0],["وَيُضَوِّعُ عِطراً كُلَّما شَدَّ الأَسى","بِيَدَيهِ يَعرُكُ قَلبَهُ الوَثّابا",8,"ب",2,0],["وَيُضيرُها إِفلاتُهُ مِن قَيدِها","وَسَعادَةُ الإِنسانِ في إِفلاتِهِ",9,"ت",2,0],["وَيَضرُبُ جِسمُهُ العاري","بِسَوطِ الظالِمِ القاسي",10,"ي",1,0],["ويضئ حتى تستضى","ء به المشارق والمغارب",11,"ب",1,0],["ويضرب عن وراء الموت صفحاً","كأن الموت ليس له وراءُ",12,"ا",2,0],["ويضرع الفلاح حسبي وربي","أطعمكم جميعكم من حبي",13,"ي",1,0],["وَيَضحَكُ إِن جِئتِهِ تَضحَكينَ","وَيَبكي إِذا جِئتِهِ باكِيَه",14,"ي",2,0],["وَيُضيءُ أَثناءَ الخَمائِلِ وَالرُبى","حَتّى تَرى أَسحارَها آصالا",15,"ل",2,0],["وَيُضحي غُبارُ الخَيلِ أَدنى سُتورِهِ","وَآخِرُها نَشرُ الكِباءِ المُلازِمُه",16,"م",2,0],["ويضحي صديقاً لها في الأخير","فيلزمها بعدما ينعقد",17,"د",1,0],["ويُضيءُ في سُدَفِ العَجاج بجذوةٍ","قد أُشعِلتْ بيد القُيونِ لتُبَّعِ",18,"ع",1,0],["وَيُضاعِفُ الوَعدَ الَّذي أَكَّدتَهُ","أَنَّ الَّذي أَعطَيتَ جِدُّ مُعادِ",19,"د",1,0],["وَيُضيءُ تَحسِبُ أَنَّ ماءَ غَمامِهِ","قَمَرٌ تَقَطَّعَ في إِناءٍ أَخضَرِ",20,"ر",1,0],["وَيُضيءُ مِن خَلفِ السِنانِ إِذا دَجا","وَجهُ الكَمِيِّ عَلى الكَمِيِّ الأَروَعِ",21,"ع",1,0],["وَيَضمَنُ المَصروعَ وَالصَوائِبا","أَصلَحَهُ صالِحٌ عِندَ جَسِّهِ",22,"ه",1,0],["ويضمنا الليل العظيم وما","كالليل مأوى للمساكينِ",23,"ن",1,0],["ويضربُ جنبيه به فَكَأنّما","له فيهما طَبْلٌ يَحُضّ على الكرِّ",24,"ر",1,0],["ويُضْحك في التعبيس فكّيه عن مدى","نيوبٍ صلابٍ ليس تُهتَمُ بالفِهْرِ",24,"ر",1,0],["ويضيفُ ريقَتَهُ بقبلتِهِ","كَإضافةِ السلوى إلى المنِّ",25,"ن",1,0],["وَيَضحَكُ الدَهرُ مِنهُم عَن غَطارِفَةٍ","كَأَنَّ أَيّامَهُم مِن أُنسِها جُمَعُ",26,"ع",1,0],["وَيَضرِبُ قَومٌ في البِلادِ لَعَلَّهُم","يُصيبونَ مالاً أَو يَنالونَ مَغنَما",27,"م",2,0],["وَيُضحِكُ ثَغرَ النَصرِ في كُلِّ مَعرَكٍ","يُرى وَسطَهُ وَجهُ الرَدى عابِساً جَهما",28,"م",2,0],["وَيُضَحضَحُ اللُجَجَ الغَمارَ بِسَيبِهِ","حَتّى يَصِرنَ وَهُنَّ غَيرُ غَمارِ",29,"ر",1,0],["وَيُضيعُ الَّذي يُصَيِّرُهُ اللَ","هُ إِلَيهِ فَلَيسَ يَعتَقِدُه",30,"د",2,0],["وَيَضحَكُ عَن أُقحُوانِ الرِيا","ضِ وَيَغسِلُهُ بِالعَشِيِّ النَدى",31,"ا",1,0],["وَيَضحَكُ عَن ثَغرٍ مَليحٍ كَأَنَّهُ","حُبابُ عُقارٍ أَو نَقِيٌّ مِنَ الدُرِّ",32,"ر",1,0],["وَيَضرِبنَ بِالأَيدي وَراءَ بَراغِزٍ","حِسانِ الوُجوهِ كَالظِباءِ العَواقِدِ",33,"د",1,0],["ويُضْحي والحديدُ عليه شاكٍ","وتَكْفِيهِ مَهابَتُهُ النّزَالا",34,"ل",2,0],["ويَضُوعُ العبيرُ في كلّ نادٍ","وهْوَ ذِكْرٌ معَبِّرٌ عن شذاكا",35,"ك",2,0],["وَيَضَعنَ منها في الرقاب قَلائداً","تزري بعقد الدرِّ وَالمرجان",36,"ن",1,0],["ويضربُ البحر عَلَي","هِ مَوجَه مُنتحِبا",37,"ب",2,0],["ويضيقُ بالشعبِ الطموحِ يقينهُ","ويُثيرُ مِرّتهُ الخيالُ فيَعْرُمُ",38,"م",1,0],["ويَضُجُّ جبَّارُ الأسى","وتَجيشُ أمواجُ الكُرُوبْ",39,"ب",1,0],["وَيَضْحَكُ مِنْ خُشُبٍ شُرَّعٍ","بِأَيْدِيهِمْ الرُّمْحُ وَالمِخْذَمُ",40,"م",1,0],["وَيَضُمُّ المُنْتَدى البَحْرِ","يُّ صَحْباً وأُهَيْلاَ",41,"ل",2,0],["ويُضَاعِفُ السَّرَّاءَ فِي إِقْبَالِهَا","تَذْكَارُ مَا وَلَّى مِنَ الضَّرَّاءِ",42,"ا",2,0],["ويَضْحَكُ سِنُّ المَرْءِ والقَلْبُ مُوْجَعٌ","ويرضى الفتى عن دهرهِ وهو عاتبُ",43,"ب",1,0],["ويضي المغنّى يديه وفاه","وشيء يجلمد حسّ الطرب",44,"ب",1,0],["ويضمّ البلاد خلف الحنايا","أمنيات وذكريات ملاحا",45,"ح",2,0],["ويضيع جمالا مبذولا","في الكشف عن العدم الأجمل",46,"ل",1,0],["ويضحك لي وجه نديّ منوّر","كأن لم يغيّب من طلاقته القبر",47,"ر",1,0],["وَيَضْرِبُ مِنْ نوالِكَ في بلادٍ","من المعروفِ واسعة ٍ رحابِ",48,"ب",1,0],["وَيُضيءُ في شَرق وَغَرب إِن دجا","لَيل الخُطوب عَلى الوَرى مِصباحها",49,"ح",3,0],["ويضحكان إذا ما الخمر رنحني","دوارها واستوى سرى وإعلاني",50,"ن",2,0],["ويضفرون بأيديهم لقاطعها","حرصاً على البغي اكليلين من غار",51,"ر",1,0],["وَيَضحكُ عن روضٍ تُداني يد الصبّا","به صفحة السّوسانِ مِن صفحةِ الوردِ",52,"د",1,0],["ويضربُ بالظبا في كلِّ فجٍ","طِلاً مالت عن الحق اغترارا",53,"ر",2,0],["وَيُضحي الَّذي أَنفُهُ في التُخُومِ","يُطاوِلُ مَن يَتَمَطّى النُجُوما",54,"م",2,0],["ويضنّ مسؤول النوا","ل ولو بكوز من شرابه",55,"ب",2,0],["ويضربُ الهامَ به أروعٌ","سُرادق الفخرِ به يُضربُ",56,"ب",1,0],["ويُضْحي حنينُ الرَّعْدِ يُشْبه زفرتي","إذا ما سَمِعْتُ العَنْدليبَ المُطَوَّقا",57,"ق",2,0],["ويضره لبس الغلا","ئِلِ والشنوفِ ويؤلِمه",58,"م",2,0],["ويضمني وبني الوداد بجوّه","سربال وصل لا أراع بسلبه",59,"ب",2,0],["وَيُضيئُ إِن لَبِسَ السَّوادَ بَياضُهُ","حَتَّى يُنَوِّرَ مُظلِمَ الأَكنانِ",60,"ن",1,0],["وَيُضْحِي مِثْلَ لَحْمٍ مِنْ حُوَارٍ","مُسيخاً لا يُطَيَّبُ بِانْطِباخِ",61,"خ",1,0],["وَيُضْحِي بِهَا نَابُ الْهُدَى يَنْهَشُ الْهَوَى","وَيُمْسِي بِهَا ظُفْرُ الْهَوَى غَيْرَ خَادِشِ",62,"ش",1,0],["ويضيع فيها الخضر وه","ويسير في ظهر البراق",63,"ق",1,0],["ويضجر ما لم يلقني من ضميره","كما ضجر المصدور من نفثاته",64,"ت",2,0],["ويضمر الحقد في ضمائره","ويظهر الود من تبسمه",65,"م",2,0],["ويضلُّ الرهبانُ إن طرقتهم","في صلاةٍ ويجهلُ الحكماء",66,"ا",2,0],["ويَضربُني طيفُ الدُّجى بجناحهِ","فأسكتُ رعباً تحتَهُ فيصيحا",67,"ح",2,0],["ويضعفُ هذا القلبُ حتى نظنَّهُ","تساقطَ منا فلذةً إثر فلذة",68,"ه",1,0],["وَيَضْرَى عَلى الفَتْكِ بِالضّارِيات","وإن غَالَبَ القِرْنَ لَمْ يُغْلَب",69,"ب",1,0],["ويضيق بالحر الكريم","فما له من شافع",70,"ع",1,0],["وَيُضفي عَليها فيأةً من حمايةٍ","تقيلُ وَتَستذري بعزّتها لَعطا",71,"ط",2,0],["وَيُضَاهِي مَوارِدَ النِيِّلِ فيها","كُلُّ صَافٍ من مَاءِ ذاكَ البَنانِ",72,"ن",1,0],["وَيَضحك بابوجي عَلَيهِ بِجَيبِهِ","كَما ضحك الزَهر الأَنيقِ بكمِّهِ",73,"م",2,0],["ويُضيءُ قرطاساً ومِن عجَبٍ","جَوْنٌ يُضيء بصِبْغِه يَقَق",74,"ق",1,0],["ويَضُجُ منّي كلُّ مَنْبِت شَعْرةٍ","فيما أُجِنُّ ولو خَرِسْتُ تَزَمُّتا",75,"ت",2,0],["وَيَضلُّ في آيات حُسنَك","عَقلُهُ المتوسم",76,"م",1,0],["ويضمه لا مشفقاً في ضمه","حتى تكون حشاه في أحشائه",77,"ا",3,0],["وَيُضيءُ منه الطَرس ساعَة يَكتَسي","صَدأ المِداد وَلا يُضيء صَقيلا",78,"ل",2,0],["ويضُم لِلقَدَمين منه رأسه","كالسَيف ضُمَّ ذُبابه لرئاسه",79,"س",2,0],["ويضيقُ فِيهَا العُذْرُ عن خَطِيَّةٍ","سمراءَ لَمْ يُورِقْ بكفِّكَ عُودُها",80,"د",3,0],["ويضيق بى رحب الفضاء واننى","مما نحلت كأنما أنا آل",81,"ل",1,0],["ويُضعِفُ مُنَّتي ويميتُ فضلي","تَطَلُّبِيَ الثراءَ من العديمِ",82,"م",1,0],["ويضوعَ منك بطيبِ ما في ضمنه","فكأنّ ضارجَ تُربه عطَّارُ",83,"ر",1,0],["ويُضحي ويُمسي ضوءُ وجهكِ بيننا","سراجاً وضوءُ البدر يُمسي ولا يُضحي",84,"ح",2,0],["ويُضعف أدنى العار محملَ عرضه","ولكن لاِعْباءِ المكارمِ حاملُ",85,"ل",1,0],["ويُضْحي المحْلُ بالآفاقِ خِصْباً","يَعُمُّ الخفْضُ منهُ والنَّعيمُ",86,"م",1,0],["ويُضِيءُ لَيْلَ الخَطْبِ رأيُك","وهو داجي اللَّون حالِ