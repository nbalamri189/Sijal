{"poems":[[53,"وقف على العبرات هذا الناظر","https://www.aldiwan.net/poem30472.html","الكامل"],[63,"طرقت أميمة والكواكب جنح","https://www.aldiwan.net/poem45775.html","الكامل"],[63,"وعليلة الألحاظ ترقد عن","https://www.aldiwan.net/poem45900.html","أحذ الكامل"],[63,"واها لأيامي بأكناف اللوى","https://www.aldiwan.net/poem46135.html","الرجز"],[72,"يا واحد المدح والثناء","https://www.aldiwan.net/poem18205.html","مخلع البسيط"],[70,"يا سيدا بوداده","https://www.aldiwan.net/poem42434.html","مجزوء الكامل"],[70,"زار والناس نيام","https://www.aldiwan.net/poem42704.html","مجزوء الرمل"],[70,"يا حسن بعض الناس مهلا","https://www.aldiwan.net/poem42769.html","مجزوء الكامل"],[38,"فلثمت فاها آخذا بقرونها","https://www.aldiwan.net/poem7837.html","الكامل"],[62,"كم ليلة بتنا وجدي عينه","https://www.aldiwan.net/poem52275.html","الكامل"],[74,"ياحبذا والطيف ضيف طارق","https://www.aldiwan.net/poem12917.html","الكامل"],[74,"أريت أي بنية","https://www.aldiwan.net/poem12921.html","مجزوء الكامل"]],"verses":[["فَلَثَمَّ أَبلَجُ إِن أَهَلَّ جَبينُهُ","جَمَحَت إِلَيهِ خَواطِرٌ وَنَواظِرُ",0,"ر",1,0],["فَلَثَمتُها وَالحَلْيُ يَكتُمُ بَعضُهُ","سِرِّي وَيُخبِرُ بَعضُه العُذّالا",1,"ل",2,0],["فَلَثَمْتُها وَاللَّيْلُ مِنْ قِصَرٍ","قَدْ كادَ يَلْثِمُ فَجْرَهُ الشَّفَقُ",2,"ق",1,0],["فلُثْتُ أعْرافَ جِيادٍ حَمَلَتْ","صَحْبي بأعْرافِ جِيادٍ للْعِدا",3,"ا",1,0],["فلثمُ يمناك فيه لثمٌ","بخمسها لازم الأداءِ",4,"ا",2,0],["فَلَثَمتُها عَدَدَ الحُرو","فِ وَما قَنِعتُ بِمَرَّتَينِ",5,"ن",1,0],["فَلَثَمتُ البَدرَ في جُن","حِ الدُجى وَهوَ تَمامُ",6,"م",1,0],["فَلَثَمتُهُ في خَدِّهِ","تِسعينَ أَو تِسعينَ إِلّا",7,"ل",2,0],["فَلَثَمتُ فاها آخِذاً بِقُرونِها","شُربَ النَزيفِ بِبَردِ ماءَ الحَشرَجِ",8,"ج",1,1],["فلثمْتُ فاها من وراءِ لثامِها","والريقُ خمرٌ واللثامُ فِدامُ",9,"م",1,0],["فَلَثَمتُ فيما قَد لَثَمتُ عَلاقَةً","خَدّاً يَسيلُ مَعَ العُقارِ عُقارا",10,"ر",2,0],["فَلَثَمتُها كَلَفاً بِها","وَالشَيخُ يَكلُفُ بِالصَغيرِ",11,"ر",1,0]]}