{"poems":[[53,"وقف على العبرات هذا الناظر","https://www.aldiwan.net/poem30472.html","الكامل"],[63,"طرقت أميمة والكواكب جنح","https://www.aldiwan.net/poem45775.html","الكامل"],[63,"وعليلة الألحاظ ترقد عن","https://www.aldiwan.net/poem45900.html","أحذ الكامل"],[63,"واها لأيامي بأكناف اللوى","https://www.aldiwan.net/poem46135.html","الرجز"],[72,"يا واحد المدح والثناء","https://www.aldiwan.net/poem18205.html","مخلع البسيط"],[70,"يا سيدا بوداده","https://www.aldiwan.net/poem42434.html","مجزوء الكامل"],[70,"زار والناس نيام","https://www.aldiwan.net/poem42704.html","مجزوء الرمل"],[70,"يا حسن بعض الناس مهلا","https://www.aldiwan.net/poem42769.html","مجزوء الكامل"],[38,"فلثمت فاها آخذا بقرونها","https://www.aldiwan.net/poem7837.html","الكامل"],[62,"كم ليلة بتنا وجدي عينه","https://www.aldiwan.net/poem52275.html","الكامل"],[74,"ياحبذا والطيف ضيف طارق","https://www.aldiwan.net/poem12917.html","الكامل"],[74,"أريت أي بنية","https://www.aldiwan.net/poem12921.html","مجزوء الكامل"],[109,"هب يجلو الراح في كاس اللجين","https://www.aldiwan.net/poem16521.html","الرمل"],[185,"وصل الكتاب فيا له من واصل","https://www.aldiwan.net/poem14638.html","الكامل"],[210,"أقضيب بان أم قوام أملد","https://www.aldiwan.net/poem13456.html","الطويل"],[235,"وأغن معسول المراشف","https://www.aldiwan.net/poem31819.html","مجزوء الكامل"],[280,"ويوم أخذنا به فرصة","https://www.aldiwan.net/poem60709.html","المتقارب"],[349,"ومهفهف بالفرق منفرد","https://www.aldiwan.net/poem15775.html","أحذ الكامل"],[380,"سقت الغريب حمائم الفجر","https://www.aldiwan.net/poem49205.html","أحذ الكامل"],[406,"نفسي الفِداء لِلحظِها من رامِ","https://www.aldiwan.net/poem50116.html","الكامل"],[429,"جاءت تلوح وحبها وافى السند","https://www.aldiwan.net/poem41413.html","الكامل"],[458,"لعلهم لو وقفوا","https://www.aldiwan.net/poem56108.html","مجزوء الرجز"],[575,"قد همت بالبدوي في الحلل","https://www.aldiwan.net/poem2886.html","أحذ الكامل"],[575,"فتحيرت أحسب الثغر عقدا","https://www.aldiwan.net/poem2930.html","الخفيف"]],"verses":[["فَلَثَمَّ أَبلَجُ إِن أَهَلَّ جَبينُهُ","جَمَحَت إِلَيهِ خَواطِرٌ وَنَواظِرُ",0,"ر",1,0],["فَلَثَمتُها وَالحَلْيُ يَكتُمُ بَعضُهُ","سِرِّي وَيُخبِرُ بَعضُه العُذّالا",1,"ل",2,0],["فَلَثَمْتُها وَاللَّيْلُ مِنْ قِصَرٍ","قَدْ كادَ يَلْثِمُ فَجْرَهُ الشَّفَقُ",2,"ق",1,0],["فلُثْتُ أعْرافَ جِيادٍ حَمَلَتْ","صَحْبي بأعْرافِ جِيادٍ للْعِدا",3,"ا",1,0],["فلثمُ يمناك فيه لثمٌ","بخمسها لازم الأداءِ",4,"ا",2,0],["فَلَثَمتُها عَدَدَ الحُرو","فِ وَما قَنِعتُ بِمَرَّتَينِ",5,"ن",1,0],["فَلَثَمتُ البَدرَ في جُن","حِ الدُجى وَهوَ تَمامُ",6,"م",1,0],["فَلَثَمتُهُ في خَدِّهِ","تِسعينَ أَو تِسعينَ إِلّا",7,"ل",2,0],["فَلَثَمتُ فاها آخِذاً بِقُرونِها","شُربَ النَزيفِ بِبَردِ ماءَ الحَشرَجِ",8,"ج",1,1],["فلثمْتُ فاها من وراءِ لثامِها","والريقُ خمرٌ واللثامُ فِدامُ",9,"م",1,0],["فَلَثَمتُ فيما قَد لَثَمتُ عَلاقَةً","خَدّاً يَسيلُ مَعَ العُقارِ عُقارا",10,"ر",2,0],["فَلَثَمتُها كَلَفاً بِها","وَالشَيخُ يَكلُفُ بِالصَغيرِ",11,"ر",1,0],["فَلَثمنا الثغر مِنهُ وَالطَلى","حَيث لَم نَخشى اِقتِران الحاجِبين",12,"ن",1,0],["فلثمتُه من قبِل فكِّ خِتامه","لما تَبدَّى من يمين الحامل",13,"ل",1,0],["فلثمته لتزول نار تلهبي","فاذا الخدود لهيبها يتوقد",14,"د",1,0],["فَلَثَمتُهُ حُلوَ اللِما","وَضَمَمتُهُ لَدنَ المَعاطِف",15,"ف",1,0],["فَلِثَغْرِهِ الْمَرْشُوفِ رِقَّةُ نَوْرِهِ","وَلِقَدِّهِ الْمَهْزُوزِ نَشْوَةُ بانِهِ",16,"ه",1,0],["فَلِثَغرِهِ وَشِفاهِ مَبسَمِهِ","أَهوى العَقيقَ وَبارِقَ الجَزعِ",17,"ع",1,0],["فَلثَمَت راحَتُهُ وَلَم أَرني","أَهلاً للثم الخَد وَالنَحر",18,"ر",1,0],["فَلَثَمنَني فَجَعَلتُ ثَمَّ تَحرُّجاً","بَيني وَبَينَ اللَثمِ ثَنيَ لِثامي",19,"م",2,0],["فلثمت مبسمها وذقت رضابها","حلو المودة والفؤاد بها استمد",20,"د",1,0],["فلثموا ومسحوا","وجمّروا وطوّفوا",21,"ف",3,0],["فلثمْتُ من فَرْع إِلى قَدَمٍ","وضمَمْتُ من صدْرٍ إِلى كَفَلِ",22,"ل",1,0],["فَلَثَمت الجميعَ قطعاً لشكِّي","وكذا فعلُ كُلِّ منْ يَتَحرَّى",23,"ر",2,0]]}