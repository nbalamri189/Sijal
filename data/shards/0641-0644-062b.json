dctabudhabi.ae/diwan/poem/203363",""],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86720","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96722","الكامل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96718","البسيط"],[1110,"","https://poetry.dctabudhabi.ae/diwan/poem/126612","الكامل"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101980","الكامل"],[1172,"","https://poetry.dctabudhabi.ae/diwan/poem/111288","الكامل"],[1268,"","https://poetry.dctabudhabi.ae/diwan/poem/198345",""],[440,"","https://poetry.dctabudhabi.ae/diwan/poem/47381","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53073","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53041","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53120","الكامل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120716","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60915","الكامل"],[3506,"","https://poetry.dctabudhabi.ae/diwan/poem/107339","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92344","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114332","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86374","الكامل"],[412,"","https://poetry.dctabudhabi.ae/diwan/poem/31264","الكامل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35124","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139732",""],[4858,"وداع الأبناء","https://www.poetsgate.com/ViewPoem.aspx?id=34106",""],[4912,"ما الروض أضحكت السحاب ثغوره","https://www.poetsgate.com/ViewPoem.aspx?id=181789",""],[5442,"اشرفت في السواد ذات الثور","https://www.poetsgate.com/ViewPoem.aspx?id=114768",""],[2678,"وافت هديتك التي","https://www.poetsgate.com/ViewPoem.aspx?id=167476",""],[5725,"عرس بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=177970",""],[5725,"سلافة الخد","https://www.poetsgate.com/ViewPoem.aspx?id=201281",""],[5790,"أسمعت ما قال النسيم وخبرا","https://www.poetsgate.com/ViewPoem.aspx?id=112049",""]],"verses":[["فَلَثَمَّ أَبلَجُ إِن أَهَلَّ جَبينُهُ","جَمَحَت إِلَيهِ خَواطِرٌ وَنَواظِرُ",0,"ر",1,0],["فَلَثَمتُها وَالحَلْيُ يَكتُمُ بَعضُهُ","سِرِّي وَيُخبِرُ بَعضُه العُذّالا",1,"ل",2,0],["فَلَثَمْتُها وَاللَّيْلُ مِنْ قِصَرٍ","قَدْ كادَ يَلْثِمُ فَجْرَهُ الشَّفَقُ",2,"ق",1,0],["فلُثْتُ أعْرافَ جِيادٍ حَمَلَتْ","صَحْبي بأعْرافِ جِيادٍ للْعِدا",3,"ا",1,0],["فلثمُ يمناك فيه لثمٌ","بخمسها لازم الأداءِ",4,"ا",2,0],["فَلَثَمتُها عَدَدَ الحُرو","فِ وَما قَنِعتُ بِمَرَّتَينِ",5,"ن",1,0],["فَلَثَمتُ البَدرَ في جُن","حِ الدُجى وَهوَ تَمامُ",6,"م",1,0],["فَلَثَمتُهُ في خَدِّهِ","تِسعينَ أَو تِسعينَ إِلّا",7,"ل",2,0],["فَلَثَمتُ فاها آخِذاً بِقُرونِها","شُربَ النَزيفِ بِبَردِ ماءَ الحَشرَجِ",8,"ج",1,1],["فلثمْتُ فاها من وراءِ لثامِها","والريقُ خمرٌ واللثامُ فِدامُ",9,"م",1,0],["فَلَثَمتُ فيما قَد لَثَمتُ عَلاقَةً","خَدّاً يَسيلُ مَعَ العُقارِ عُقارا",10,"ر",2,0],["فَلَثَمتُها كَلَفاً بِها","وَالشَيخُ يَكلُفُ بِالصَغيرِ",11,"ر",1,0],["فَلَثمنا الثغر مِنهُ وَالطَلى","حَيث لَم نَخشى اِقتِران الحاجِبين",12,"ن",1,0],["فلثمتُه من قبِل فكِّ خِتامه","لما تَبدَّى من يمين الحامل",13,"ل",1,0],["فلثمته لتزول نار تلهبي","فاذا الخدود لهيبها يتوقد",14,"د",1,0],["فَلَثَمتُهُ حُلوَ اللِما","وَضَمَمتُهُ لَدنَ المَعاطِف",15,"ف",1,0],["فَلِثَغْرِهِ الْمَرْشُوفِ رِقَّةُ نَوْرِهِ","وَلِقَدِّهِ الْمَهْزُوزِ نَشْوَةُ بانِهِ",16,"ه",1,0],["فَلِثَغرِهِ وَشِفاهِ مَبسَمِهِ","أَهوى العَقيقَ وَبارِقَ الجَزعِ",17,"ع",1,0],["فَلثَمَت راحَتُهُ وَلَم أَرني","أَهلاً للثم الخَد وَالنَحر",18,"ر",1,0],["فَلَثَمنَني فَجَعَلتُ ثَمَّ تَحرُّجاً","بَيني وَبَينَ اللَثمِ ثَنيَ لِثامي",19,"م",2,0],["فلثمت مبسمها وذقت رضابها","حلو المودة والفؤاد بها استمد",20,"د",1,0],["فلثموا ومسحوا","وجمّروا وطوّفوا",21,"ف",3,0],["فلثمْتُ من فَرْع إِلى قَدَمٍ","وضمَمْتُ من صدْرٍ إِلى كَفَلِ",22,"ل",1,0],["فَلَثَمت الجميعَ قطعاً لشكِّي","وكذا فعلُ كُلِّ منْ يَتَحرَّى",23,"ر",2,0],["فلثمتها ورشفتها","وقطعتها من حيث رقت",24,"ت",1,0],["فَلَثامنٍ مِن بَعد عَشرٍ قَد خَلَت","مِن ذَلِكَ الشَهر الكَريم المُفرَد",25,"د",1,0],["فَلثمتُ منها مبسماً","مثلَ الجمانِ المُنتظم",26,"م",1,0],["فَلثمُ مَبسمها بالنفسِ لي عوض","وقيمة تُقتنى من أبلغ القيمِ",27,"م",1,0],["فلثمت منه تمنعه","من لاثميه مبسماً شبما",28,"م",2,0],["فلثمث موطء خطوها ولو أنني","أنصفتها حبا سففت ترابها",29,"ب",3,0],["فلثمت فاه بعدما","ألصقته صدري وخدي",30,"د",2,0],["فلثمت منه موطئ ال","نعل الذي فوق الرغام",31,"م",1,0],["فَلَثَمْتُ خَدّاً مِنْهُ ضَرَّمَ لَوْعتي","وَجَعَلْتُ أُطْفي حَرَّها بِرُضابِهِ",32,"ب",2,0],["فلثم سر الله حيث تقدست","صحف الهدى وتبجست سحب الندى",33,"د",2,0],["فَلَثَمَّ سِرِّ الله طاعته","نزلت بها الآيات والكتب",34,"ب",1,0],["فلثمتها وجعلت أقتحم الردى","ما بين ملتف الوشيج الأسمر",35,"ر",1,0],["فلثمتُها وظَنَنتُها مملوكَتِي","وهي التي ظَفِرَت بِمُلك قِيَادِي",36,"د",2,0],["فلثمتُها حتى محوتُ سطورَها","لثم المحب لوجنة المحبوب",37,"ب",1,1],["فلَثمت الخدَّ وارتاعت وكم","راعها الطارِقُ مِنِّي مَوهِنا",38,"ن",2,0],["فلثمتُ ذي وتركت هذي عينه","ودفعت راحي بالَّتي هي أحسنُ",39,"ن",1,0],["فَلَثَمتُ وَزِدتُ أرشُفُ مِن ثَغ","رٍ لَهَا مَا يَفُوقُ عَذبَ الزُّلاَلِ",40,"ل",1,0],["فلثمتها في ناظري لا في فمي","وحملتها في صبوتي لا في يدي",41,"د",2,0],["فَلثغرها وَلريقِها وَلطيبِها","نَفحاتِها وَحبابِها وَشَرابُها",42,"ب",3,0],["فَلَثَمتُها شَغَفاً وَقُلتُ لِعَبرَتي","هِيَ ما تَمُجُّ الأَرضُ مِن دَمِ يُوسُفِ",43,"ف",1,0],["فلثمت يمناه وانَّ يمينه","حرزٌ يعوذ به الندى وعصام",44,"م",1,0],["فلثمْتهُم ! وضممتهم ! وشممتهُمْ !","وذخرتُ ذلك في دمِ الأعْراقِ",45,"ق",1,0],["فلثمته عشراً ولو قبلته","ألفاً وألفاً لم أوف مهوره",46,"ر",2,0],["فلثمناه كله لنلاقي","موضعاً خص بالتثنم النذير",47,"ر",1,0],["فلثمتها بفم الثنا","ء لربها ألفا وعشرا",48,"ر",2,0],["فلثمته ثغرا يفيض حنانه","جمرا فيعصرني الحنين شجيجا",49,"ج",2,0],["فلثمت منها كل ناطقة","كي لا تبوح السر للعقدِ",50,"د",1,0],["فلثمت يسراه لئلا يعلم ال","واشي فيصبح وهو بي مستهترا",51,"ر",2,0]]}