sgate.com/ViewPoem.aspx?id=129583",""],[5829,"وإن طاوعتني في الحبِّ أبشر","https://www.poetsgate.com/ViewPoem.aspx?id=178392",""],[5956,"الذبحُ الرَّاحم ‏","https://www.poetsgate.com/ViewPoem.aspx?id=183394",""],[5997,"الغَرَّاْءُ","https://www.poetsgate.com/ViewPoem.aspx?id=214276",""],[5997,"عيوني","https://www.poetsgate.com/ViewPoem.aspx?id=214289",""],[6070,"دلال الحروف","https://www.poetsgate.com/ViewPoem.aspx?id=187815",""],[6093,"لا يَنحني إلا ليلتقطَ الفصولْ","https://www.poetsgate.com/ViewPoem.aspx?id=203946",""],[5355,"عن الحبّ الذي ولى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87125&r=&rc=20",""],[6213,"دنان العشق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85492&r=&rc=95",""],[6262,"أحلامُ نورِ الدين الصغيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80126&r=&rc=24",""],[6277,"العبودية الكبرى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64441&r=&rc=0",""],[6288,"الشوق الحزين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79623&r=&rc=40",""],[6315,"رُؤى على شفير الحداد !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87579&r=&rc=4",""]],"verses":[["فَأَسرَعوا وَطُلَى الأَعناقِ مائِلَةٌ","حَيثُ الوَسائِدُ لِلنُّوَّامِ أَكوارُ",0,"ر",1,0],["فَأسْرَعَتِ الأَغْصَانُ تَبْتَدِرُ الثَّرى","وَتَعمُرُ بَاقِي الْوَقْتِ مِنْهَا بِمَا تَقْضِي",1,"ض",2,0],["فَأَسرَرتُ النَدامَةَ يَومَ نادى","بِرَدِّ جِمالِ غاضِرَةَ المُنادي",2,"د",2,0],["فَأَسرَينَ خَمساً ثُمَّ أَصبَحنَ غَدوَةً","يُخَبِّرنَ أَخباراً أَلَذَّ مِنَ الخَمرِ",3,"ر",1,0],["فاِسرح فَلا شملي صَديعٌ ولا الحَشا","وَجيعٌ وَلا عَينايَ يُبكيهِما ثَكلُ",4,"ل",1,0],["فَأَسرَعَ الحِمارُ نَحوَ أُمِّهِ","وَجاءَها وَالضِحكُ مِلءُ فَمِهِ",5,"ه",1,0],["فأسْرٌ ولا فَكٌّ وَوَجْدٌ ولا أسىً","وسُقْمٌ ولا بُرْءٌ وسكرٌ ولا صَحْوُ",6,"و",1,0],["فَأَسرَعُ فائِزٍ بِالخَي","رِ قائِلُهُ وَفاعِلُهُ",7,"ل",2,0],["فَأَسرِعِ الخَطوَ فَعِندي شادِنٌ","وَفَتاةٌ وَخُمورٌ وَأُمورُ",8,"ر",1,0],["فَأَسرَحَ ناظِري في وَشيِ رَوضٍ","وَأَلقَحَ خاطِري مِن بَعدِ عُقمِ",9,"م",1,0],["فأسرعتِ القلوبُ مُصافحاتٍ","وأقبلتِ الوفودُ مُهنِّئينا",10,"ن",2,0],["فَاسْرَحَا وَامْرَحَا فَقَدْ آذَنَتْنَا","نَسَمَاتُ الصَّبَا بِخَلْعِ الْعِذَارِ",11,"ر",1,0],["فاسر بالدهس لا الحزون بليل","آمنا من كلالها...وحفاها",12,"ا",3,0],["فأسرعت الأغصان تبتدر الثرى","وتعمر باقي الوقت منه بما تقضي",13,"ض",2,0],["فأسرحُ، لا شملي صَديعٌ، ولا الحَشَا","وَجيعٌ وَلا عَينايَ يُبكيهِما ثُكلُ",14,"ل",1,0],["فاسرع وكفر يا هداك","اللّه عن تلك الخطية",15,"ي",2,0],["فَأسرَع حتى تَظَنَّيتُهُ","بِكَفِّ وَلِيدٍ بِهِ خَذرَفَا",16,"ف",2,0],["فَأَسرَفَ في إِنعامِهِ مُتَبَرِّعاً","كَريمَ النِجارِ ما لَهُ في الوَرى نِدُّ",17,"د",1,0],["فَأَسْرَعَتْ وَأَتَتْ تَجْرِي عَلَى عَجَلٍ","فَعِنْدَ رُؤْيَتِها لَمْ أَسْتَطِعْ جَلَدِي",18,"د",2,0],["فَأَسرَحُ في رَوضِ السَماحِ رَكائِبي","وَأَسحَبُ في رَبعِ المَكارِمِ أَذيالي",19,"ل",2,0],["فاسرَحي أو نقّري آمِنَةً","وارتوي مِمّا به قَلبي ارتوى",20,"و",2,0],["فأسرَع الدَبيبا","لصَخرةٍ قَريبا",21,"ب",2,0],["فأَسرّ في أُذني اسم مَنْ","أَهواه أَصحُ وَأَسمع",22,"ع",1,0],["فَاِسرِع وَهُم وَلا تَضيعَ فُرصَةٌ","وَكُلُّ أُمورِ لِرَبِّكَ الحَنّانِ",23,"ن",1,0],["فأسرّت موجة في أذ","ن الشطّ الحبيب",24,"ب",1,0],["فأسرّت إليه أن حطّم القي","دَ وطهّر سناك من ظلمائه",25,"ا",3,0],["فَأَسرع مِن صبا سحر مَهبّاً","وَأَبدَع مِن سَنا قَمرٍ محيّا",26,"ي",2,0],["فأسَرْتُ آساداً غِضاباً منهمُ","ورجَعْتُ من أسْرَى غزالٍ أكْحَل",27,"ل",1,0],["فأسرَرتُه حتى تكاملَ سِرُّه","عليَّ فأَبدى دمعُ عَيني سَرائِري",28,"ر",2,0],["فاسرِعْ إذاً يا غافلاً عن توبةٍ","فعلام تُهملُ وقتها ولماذا",29,"ذ",2,0],["فاسرد حكاية ما جرى وارفع","بها صوتاً لتسمعَ صوتكَ الأرجاء",30,"ا",2,0],["فأسرِعْ إلينا ولا تُبطِئَنَّ","فإنّا صِيامٌ إلى أنْ تَجي",31,"ي",1,0],["فأسرع وبادر كي تعود مشرّفا","إذ تلثم الكف الكريم النادي",32,"د",2,0],["فاسْرُرْ أغربَ عزّةٍ","طلعَتْ بحيٍّ غير غارِب",33,"ب",1,0],["فأَسْرَيْتُمُ الليلَ حِفْظاً لنا","ونحنُ عَلَى فُرْشِكُمْ نائِمُونا",34,"ن",2,0],["فأَسْرَيْتُها بِالشِّعْرَيَيْنِ مُفَرِّطاً","وأَفْنَيْتُها بالقلبِ عنها مُخَيِّما",35,"م",2,0],["فَأَسْرَيْتَ بَيْنَهُمُ يَا ابْنَ يَحْيَى","كَبَدْرٍ سَرى بَيْنَ زُهْرِ السُّعُودِ",36,"د",1,0],["فاسر فإن الدنيا طريقٌ","أسْهَلَ مِيلٌ وشَقَّ مِيلُ",37,"ل",1,0],["فَاِسرِع إِلَيها قَبلَ تَبدو لَنا","بِزَعفَرانِ الشَمسِ مَطلِيَّه",38,"ي",2,0],["فأسرع للروض العمومي حاملا","لنفسه في الكفين إحدى البنادق",39,"ق",1,0],["فأسرع بالتحية مذ رآني","جديرا في الحقيقة بالسلام",40,"م",1,0],["فاسرعوا وامحوا الحروف بما","عندكم من صفحة الورق",41,"ق",1,0],["فاسرع إلى لألائه متملِّيا","وإذا رميت عليه جهدك والعيا",42,"ي",2,0],["فأسَرتَه مُستَبسِلاً وحَفظتَه","شَرَفاً بأفضلَلِ حَوط",43,"ط",1,0],["فأَسروا بمنّهم طليقه","وأَطلقوا بمنِّهم أَساره",44,"ر",2,0],["فأسرع قوم لإنقاذه","وجالت أكفهم في الوشاح",45,"ح",1,0],["فَأَسرَعَ الأَرنَبُ في الجَواب","وَأَخرَجَ المَكرَ مِن الجِرابِ",46,"ب",1,0],["فَأَسرع الحِمار بِالإِجابة","وَخَرجت سُكّان تِلكَ الغابه",47,"ه",1,0],["فأسرع حين يكرم من سحاب","وأثبت حين يحلم من إبانِ",48,"ن",1,0],["فاسرج لما إن توثب جارحا","وألجم لما إن تثاوب ملجما",49,"م",2,0],["فَأَسرَعتُ الإِيابَ بِخَيرِ حالٍ","إِلى حَوراءَ خَرعَبَةٍ لَعوبِ",50,"ب",1,0],["فَاسرع بها أو أبطِ في غيرِ رِيبَةٍ","ولا تَعْدُ فالأمر الذي حُمّ واقِعُ",51,"ع",1,0],["فأسرج فيه إِلى نوره","سراحاً مِن العلمَ يَشفي العمى",52,"ا",1,0],["فأَسْرَعَ ابنُ معزِّ الدِّنِ عَزْمَتَهُ","مِنْ بَعْدِ إِحْكامِ تدبيرٍ وإِمْحاضِ",53,"ض",1,0],["فأسر خفي اللطف بي في خصائصي","وذرات أطواري وحالي وحاجيا",54,"ي",2,0],["فَأَسرار الجواهر حور عين","وولدان وَأَقدار كبار",55,"ر",1,0],["فأَسراراي مطاياها","وَأَحشائي زَواياها",56,"ا",3,0],["فاسرع لنحسوها معتَّقةً","ديريةً لا تعرف الدنسا",57,"س",2,0],["فَأَسرَعَ كُلُّ أَروَعَ مِن قُرَيشٍ","نَماهُ أَبٌ إِلى العَلياءِ نامِ",58,"م",1,0],["فاسرع بنا يا جائعاً يبغي الجدا","قد آن للأكل الجماعة يحشدوا",59,"د",3,0],["فَأسرَجَهَا صُبْحاً وَذَاقَتْ عَشِيَّةً","مُوَيْهَةَ سُلْطَانٍ كَرِيه المَشَارِبِ",60,"ب",1,0],["فَأَسرِيا وَهُما سَنّا هُمومِهِما","إِلى عِرينِ كَعُشِّ الأَرمَلِ اليَفنِ",61,"ن",1,0],["فاسرعوا للمعالي","صلّى اللَهُ عليهِ",62,"ل",3,0],["فأسرع الخيرُ نحوي","سيرا حثيثا فسيرا",63,"ر",2,0],["فأسَرَّ قَولَ مُعَطِّلٍ وَمُكَذِّبٍ","في قَالَبِ التَّنزيهِ للرَّحمَنِ",64,"ن",1,0],["فَأَسرَفَ إِذلالُهُم في الجَفا","وَجاءَ يَفوقُ الَّذي عَوَّدا",65,"د",2,0],["فأسرعوا نحوى يبغون ما","عوَّدتهم من عطفةٍ والتماح",66,"ح",1,0],["فاسرتهم بذيوله","ن وقد نهم فيها زمر",67,"ر",1,0],["فأسرع الموت حثيث الخطى","وابتزّ مني نَيْلَ ذاك الظفر",68,"ر",1,0],["فأسرّي عني وأرسل روحي","حيث يسري الوجدان والإلهام",69,"م",1,0],["فأسرعت توا للعبادة والتقى","لأشري بالطاعات دار خلود",70,"د",1,0],["فأسرعت نحو الماء يعدو بي الظما","وأوشك أن أعدو له سابقا رجلي",71,"ل",2,0],["فأسرف إسراف الخليع وأنتهى","إلى عقل مجنون ونوم حبيس",72,"س",1,0],["فأسرعوا والموتُ فيهِم يُسرعُ","إلى جنانٍ هي نعمَ المرجعُ",73,"ع",1,0],["فأسرعت بالبيداءِ تهوِي قلائصي","إِلَى ملك فاق الملوك مَعاليا",74,"ي",2,0],["فاسرع للعلى وهم بطاء","الا اين السراع من البطاء",75,"ا",2,0],["فأسرُع لطاعتِكَ الرئيسَ بلَذَّةٍ","ان شِئتَ تُخضِعَ جِسمكَ المتنهِّصا",76,"ص",2,0],["فأسر الخليفة المذكورا","وكان مرءاً بالتقى مشهورا",77,"ر",2,0],["فأسرعوا إليه","وأقبلوا عليه",78,"ه",1,0],["فأسرع علينا يا كريم بصبَّةٍ","من الفضل والأرزاق إنك مكثرُ",79,"ر",1,0],["فاِسرعي نحو مضجعي وَضعيها","فوق قَبري لِتَستَريح رفاتي",80,"ت",2,0],["فَأَسرَجَ لِلأَعداءِ كُل طَمرَة","مِنَ الضَمّر القَب العراب العَدائِم",81,"م",1,0],["فأسرع فكل مسرع نبيل","فليس يرضى الضيم غير الود",82,"د",1,0],["فاِسرِع إِلىَ حَلقِ واديها وَشمهُ تَرَ","ما خَلَّدَتهُ يَدُ الشم العَرانينِ",83,"ن",1,0],["فأسر أهلها ثم أمر","عساكره تسكن تلك البقاع",84,"ع",1,0],["فاسرع بنا يا حادي العيس","واعنف أحمالنا عليها ليست ثقل",85,"ل",1,0],["فاسر عنك الهموم حين تداعت","بعلاةٍ مثل الفنيق وخود",86,"د",1,0],["فاسرِجوا المصباحَ في ليلٍ بهيمٍ","واستمدوا النورَ من شمس الجواد",87,"د",1,0],["فأُسْريَ بالمُختار من بطن مكّةٍ","إلى المسجد الأقصى فطاب وُصولُ",88,"ل",1,0],["فَاسْرِجْ يَدَيْكَ، وَغادِرْ بوْحَ راجِفَةٍ","واحْذَرْ إِذا هَمَّ أَنْ يَغْتالَكَ الْخَلَلُ",89,"ل",1,0],["فَاسْرِي إِلَى غَبَشِي، فَاللَّيْلُ يَعْرِفُنِي","بَدْراً تَكَامَلَ فِي عَلْيَائِهِ قَمَرَا",90,"ر",2,0],["فَأَسْرِعْ لَقْدْ حَانَ قَطْفُ ازْدِهَارِي","وَلا لَمْ يَحِنْ بَعْدُ وَقْتُ انْصِرَافِي",91,"ف",2,0],["فأسرجَ الشرعَ نوراً في غياهبهم","فهُتِّكتْ سُتُرُ الإلحادِ واندحرا",92,"ر",2,0],["فاسرق من العمر أوقاتا تسل بها","عليك نفسك واللذات تسترق",93,"ق",1,0],["فاسِر إليه أو تلاقي الهوى","في طالع النور بزحف الظلمات",94,"ت",1,0],["فأسرعت تحت السيل والبرد قارس","فأدركته مغمى عليه مهشما",95,"م",2,0],["فَأَسرَجَ خَيلَ المُنَى لِلعَلاءِ","ولامَسَ بِالعِزِّ شُمَّ الجِبَالْ",96,"ل",1,0],["فَأسرع بها، أو أبطِ في غيرِ رِيبَة ٍ","ولا تعْدُ ، الأمر الذي حُمّ واقِعُ",97,"ع",1,0],["فأسري هداك الله في ذا الدجى","بنوره يلق الدجى مقمرا",98,"ر",2,0],["فأسرجْتُ أمسي ويومي بنورِ غدي.","عزائي بمن غادروني وحيداً",99,"د",2,0],["فأسرع بطوفان لها تزكو به","في روضها الأفنان والأكمام",100,"م",1,0],["فأسرى الشوق منتهكاً حمانا","والقى رحله بالخافقين",101,"ن",1,0],["فَأَسَرتُها - رُغمًا - فَما أَطلَقتُها","إِلَّا قَصِيدًا يَعتَلِيهِ طُمُوحُ",102,"ح",1,0],["فأسرارها جاءت بها كل أمة","ومن ذاتها الشقت كشمس الظهيرة",103,"ه",1,0],["فأسْرتْ في شراييني فجاجا","وراحت في ثنايا الروح تُبحر",104,"ر",1,0],["فأَسْرِعْ يا إله لها بذبح","وأسْرعْ يا إله بيوم نحبي",105,"ب",2,0],["فَأَسْرِيْ إِلَىٰ صَنْعَاْ بِقَوْمٍ تَعَاْهَدُوْا","عَلَىٰ الرَّاْيَةِ الْبَيْضَاْءِ بِيْضَاً رِهَاْفِيَا",106,"ف",3,0],["فأسرجت الهموم بجوف ليلٍ","وأسرَ العمر في الدنيا بدوني",107,"ن",2,0],["فأسرحُ في خيالي دونَ همٍ","لأنَّ دَلالها بالقُربِ منِّي",108,"ن",2,0],["فأُسِرُّ للغاياتِ لحَن َكمَنْجَةٍ:","لا تسأموا فأنا على وشكِ الوُصُولْ",109,"ل",1,0],["فأسرع ناسيا روحي","لأحضن رسم هاجرتي",110,"ت",2,0],["فأسرق لمسة هيفا","وألثم جفنك الواني",111,"ن",2,0],["فأسرعْ وخُضْ بحرَ النُّعاسِ إليهمُ","فقطْ..أطبِقْ الجفنينِ..هيَّا..كذا مثلي",112,"ل",2,0],["فاسرع وكفر ، يا هداك الله ، عن تلك الخطية","وادخله حالا للمقام وفز بطلعته البهية",113,"ي",2,0],["فأسرح في ظل الخيال مكابرا","وأعرف أن الحلم ما عاد كافيا",114,"ي",2,0],["فَأَسرَفتِ في الإغراءِ حتى تَنَصَّلَتْ","نُدوبي مِنَ المَكنونِ في مَوئِلِ الشِّدَّه",115,"د",2,0]]}