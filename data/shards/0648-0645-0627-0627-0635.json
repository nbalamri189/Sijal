{"poems":[[86,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[29,"وما أصابت تميم إذ تفاخرنا","https://www.aldiwan.net/poem6142.html","البسيط"],[45,"علقنا بأسباب الوزير ولم نجد","https://www.aldiwan.net/poem62763.html","الطويل"],[28,"تزود فما نفس بعاملة لها","https://www.aldiwan.net/poem5012.html","الطويل"],[28,"فأعقب الله ظلا فوقه ورق","https://www.aldiwan.net/poem5054.html","البسيط"],[28,"إذا وعد الحجاج أو هم أسقطت","https://www.aldiwan.net/poem5457.html","الطويل"],[69,"تذكرت بالبرق إذ يلمع","https://www.aldiwan.net/poem28985.html","المتقارب"],[50,"جفا وده فازور أو مل صاحبه","https://www.aldiwan.net/poem64818.html","الطويل"],[50,"عدمتك عاجلا يا قلب قلبا","https://www.aldiwan.net/poem64866.html","الوافر"],[46,"إن كان لم يترك قيس له وطرا","https://www.aldiwan.net/poem22666.html","البسيط"],[46,"توافقت اليهود مع النصارى","https://www.aldiwan.net/poem22998.html","الوافر"],[46,"ما كان في الأرض من خير ولا كرم","https://www.aldiwan.net/poem23450.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141930","البسيط"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/8081","الطويل"],[28,"سلوت عن الدهر الذي كان معجبا","https://www.poetsgate.com/ViewPoem.aspx?id=22069",""],[94,"تحيّة وفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67406&r=&rc=93",""],[158,"أزلت عن الإسلام ما أوجب الشكوى","https://www.aldiwan.net/poem59202.html","الطويل"],[197,"أما آن لهذا المعرض","https://www.aldiwan.net/poem45591.html","الهزج"],[227,"نعت بالبين غربان","https://www.aldiwan.net/poem50762.html","مجزوء الوافر"],[232,"ألا أيها البيت الذي أنا هاجره","https://www.aldiwan.net/poem4604.html","الطويل"],[280,"تعالى الله كم أعرب","https://www.aldiwan.net/poem32877.html","الهزج"],[364,"وليل بطيء طلوع الصباح","https://www.aldiwan.net/poem17865.html","المتقارب"],[450,"فما روضة أبدت بكل كمامة","https://www.aldiwan.net/poem13636.html","الطويل"],[459,"وما رأى الناس من قبلي وان شرفوا","https://www.aldiwan.net/poem15419.html","البسيط"],[459,"مقامك الأشرف المحسود من مضر","https://www.aldiwan.net/poem15590.html","البسيط"],[525,"أيدري السيف أي فتى يبيد","https://www.aldiwan.net/poem45970.html","الوافر"],[549,"أنجد إذا شئت في الأرزاق أو أغر","https://www.aldiwan.net/poem47787.html","البسيط"],[559,"أما ورب البيت لو لم أشغل","https://www.aldiwan.net/poem27840.html","الرجز"],[573,"يا خيبة الحر الذي","https://www.aldiwan.net/poem2763.html","مجزوء الكامل"]],"verses":[["وما أصابَ ابنُه والسَّوْطُ يأخُذُهُ","لَدَيه من رَأْفَةٍ في الحَدِّ يُبديها",0,"ي",3,0],["وَما أَصابَت تَميمٌ إِذ تُفاخِرُنا","إِلّا العَناءَ وَإِلّا الحينَ وَالعَبَثا",1,"ث",2,1],["وَما أَصطَفي لَونَ الحِدادِ وَلا أَرى","لِعَينَيَّ حَظّاً في الرَمادِ إِذا اسوَدّا",2,"د",2,0],["وَما أَصبَحَت يَوماً بَجيلَةُ خالِدٍ","وَإِلّا لَكُم أَو مِنكُمُ مَن يَقودُها",3,"د",3,0],["وَما أَصابَت مِنَ الأَيّامِ جائِحَةٌ","لِلأَصلِ إِلّا وَإِن جَلَّت سَتُجتَبَرُ",4,"ر",1,0],["وَما أَصبَحَ الحَجّاجُ يَتلو رَعِيَّةً","بِسيرَةِ مُختالٍ وَلا مُتَضائِلِ",5,"ل",1,0],["وما أصلحتْ قينةٌ عودَها","وغنَّتْ بهِ وأنا أسمعُ",6,"ع",1,0],["وَما أَصبَحَ الضَحّاكُ إِلّا كَثابِتٍ","عَصانا فَأَرسَلنا المَنِيَّةَ تادِبُه",7,"ب",2,0],["وَما أَصبَحتَ تَأمُلُ مِن صَديقٍ","يَعُدُّ عَلَيكَ طولَ الحُبِّ ذَنبا",8,"ب",2,0],["وَما أَصيحُ بِغِربانِ الشَبابِ قَعي","وَلا أُنادي غُرابَ الراسِ لا تَطِرِ",9,"ر",1,0],["وَما اِصطَلَحوا عَلى تَركِ الدَنايا","بَلِ اِصطَلحوا عَلى شُربِ السُلافِ",10,"ف",1,0],["وَما أَصابَهُمُ أَفِنٌ فَغَيَّرَهُم","لَكِن أُراهُم عَلى طولِ المَدى أَفِنوا",11,"ن",3,0],["وما أَصابَ الهَوى نَفْساً وَأَشْقاها","إِلاَّ وَأَلْقَتْ بِإُذْنِ البَدْرِ شَكْواها",12,"ا",3,0],["وَما أَصلَتوا فيها بِسَيفٍ عَلِمتُهُ","وَلا بِسِلاحٍ مِن رِماحٍ وَلا نَبلِ",13,"ل",1,0],["وَمَا أصْلَتُوا فهيها بسَيْفٍ عَلمْتُهُ،","وَلا بِسِلاحٍ مِنْ رِمَاحٍ وَلا نَبْلِ",14,"ل",1,0],["وما اصطفيتك عن خوف وعن ملق","ولا لأنّي إلى نعماك أفتقر",15,"ر",1,0],["وما أصلها إلا خبيث من الورى","عن الحق للتعطيل والكفر قد الوى",16,"و",2,0],["وما أصبحَ مثلَ الشم","سِ حتى فتنَ الأرضا",17,"ض",2,0],["وما أَصبحَ في قدر","ةِ عاصٍ لك عِصيان",18,"ن",1,0],["وَما أَصدَقَ الطَيرَ الَّتي بَرَحَت بِنا","وَما أَعيَفَ اللهبي لا عَزَّ ناصِرُه",19,"ر",2,0],["وَما أَصدَقَ مَن قالَ","مغني الحَيّ ما يُطرِب",20,"ب",1,0],["وَما أَصحَبَت في قِتالِ العَذولِ","اَعِنَّةُ قَلبٍ عَلَيهِم جَموحَه",21,"ح",2,0],["وما أصَهبٌ من مسك تُبَّتَ ضمّنت","نوافجه من عنبر الشِحْر أشْهَبا",22,"ب",2,0],["وما اصطفاك اِمام العصر عن عَبثٍ","تلفى ومن هداه الهدى والرأي مرتبك",23,"ك",1,0],["وما أصوغُ بها من كلِّ قافيةٍ","غرَّاء فيها لمن يبغي العُلى شانُ",24,"ن",1,0],["وما أصبحت إلا مثل ضرسٍ","تأكَّل فهو موجودٌ فقيدُ",25,"د",1,0],["وَما أَصابكَ وَالأقدارُ كافلةٌ","بأن يصيبك لا تَلْويه بالحذَرِ",26,"ر",1,0],["وَما اِصطَلى أرماحَهُم مِن مُصطَلِ","مِن العِدى في كُلِّ يَومٍ مُعضِلِ",27,"ل",1,0],["وما أصبحت في داخل","إلا وبات الهمُّ برَّا",28,"ر",2,0]]}