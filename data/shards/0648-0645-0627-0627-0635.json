{"poems":[[88,"القصيدة العمرية","https://www.aldiwan.net/poem25982.html","البسيط"],[31,"وما أصابت تميم إذ تفاخرنا","https://www.aldiwan.net/poem6142.html","البسيط"],[47,"علقنا بأسباب الوزير ولم نجد","https://www.aldiwan.net/poem62763.html","الطويل"],[30,"تزود فما نفس بعاملة لها","https://www.aldiwan.net/poem5012.html","الطويل"],[30,"فأعقب الله ظلا فوقه ورق","https://www.aldiwan.net/poem5054.html","البسيط"],[30,"إذا وعد الحجاج أو هم أسقطت","https://www.aldiwan.net/poem5457.html","الطويل"],[71,"تذكرت بالبرق إذ يلمع","https://www.aldiwan.net/poem28985.html","المتقارب"],[52,"جفا وده فازور أو مل صاحبه","https://www.aldiwan.net/poem64818.html","الطويل"],[52,"عدمتك عاجلا يا قلب قلبا","https://www.aldiwan.net/poem64866.html","الوافر"],[48,"إن كان لم يترك قيس له وطرا","https://www.aldiwan.net/poem22666.html","البسيط"],[48,"توافقت اليهود مع النصارى","https://www.aldiwan.net/poem22998.html","الوافر"],[48,"ما كان في الأرض من خير ولا كرم","https://www.aldiwan.net/poem23450.html","البسيط"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141930","البسيط"],[30,"","https://poetry.dctabudhabi.ae/diwan/poem/8081","الطويل"],[30,"سلوت عن الدهر الذي كان معجبا","https://www.poetsgate.com/ViewPoem.aspx?id=22069",""],[96,"تحيّة وفاء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67406&r=&rc=93",""],[164,"أزلت عن الإسلام ما أوجب الشكوى","https://www.aldiwan.net/poem59202.html","الطويل"],[203,"أما آن لهذا المعرض","https://www.aldiwan.net/poem45591.html","الهزج"],[234,"نعت بالبين غربان","https://www.aldiwan.net/poem50762.html","مجزوء الوافر"],[239,"ألا أيها البيت الذي أنا هاجره","https://www.aldiwan.net/poem4604.html","الطويل"],[287,"تعالى الله كم أعرب","https://www.aldiwan.net/poem32877.html","الهزج"],[371,"وليل بطيء طلوع الصباح","https://www.aldiwan.net/poem17865.html","المتقارب"],[457,"فما روضة أبدت بكل كمامة","https://www.aldiwan.net/poem13636.html","الطويل"],[466,"وما رأى الناس من قبلي وان شرفوا","https://www.aldiwan.net/poem15419.html","البسيط"],[466,"مقامك الأشرف المحسود من مضر","https://www.aldiwan.net/poem15590.html","البسيط"],[532,"أيدري السيف أي فتى يبيد","https://www.aldiwan.net/poem45970.html","الوافر"],[556,"أنجد إذا شئت في الأرزاق أو أغر","https://www.aldiwan.net/poem47787.html","البسيط"],[566,"أما ورب البيت لو لم أشغل","https://www.aldiwan.net/poem27840.html","الرجز"],[580,"يا خيبة الحر الذي","https://www.aldiwan.net/poem2763.html","مجزوء الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49920","البسيط"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122047","البسيط"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122022","الطويل"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118962","المجتث"],[3561,"","https://poetry.dctabudhabi.ae/diwan/poem/32372","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108023","البسيط"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54453","البسيط"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54445","الطويل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81296","المنسرح"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136529",""],[4353,"","https://poetry.dctabudhabi.ae/diwan/poem/138038","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57975","البسيط"],[4599,"","https://poetry.dctabudhabi.ae/diwan/poem/113825","الوافر"],[5490,"بلى أشتاق","https://www.poetsgate.com/ViewPoem.aspx?id=176368",""],[5605,"رحلة عابر","https://www.poetsgate.com/ViewPoem.aspx?id=159458",""],[5809,"اصطبار","https://www.poetsgate.com/ViewPoem.aspx?id=205635",""],[5894,"كل الحواسد راعوا ما أنا فيه","https://www.poetsgate.com/ViewPoem.aspx?id=131407",""],[5943,"حروفي المسكُ في طهرٍ تسامى","https://www.poetsgate.com/ViewPoem.aspx?id=34364",""]],"verses":[["وما أصابَ ابنُه والسَّوْطُ يأخُذُهُ","لَدَيه من رَأْفَةٍ في الحَدِّ يُبديها",0,"ي",3,0],["وَما أَصابَت تَميمٌ إِذ تُفاخِرُنا","إِلّا العَناءَ وَإِلّا الحينَ وَالعَبَثا",1,"ث",2,1],["وَما أَصطَفي لَونَ الحِدادِ وَلا أَرى","لِعَينَيَّ حَظّاً في الرَمادِ إِذا اسوَدّا",2,"د",2,0],["وَما أَصبَحَت يَوماً بَجيلَةُ خالِدٍ","وَإِلّا لَكُم أَو مِنكُمُ مَن يَقودُها",3,"د",3,0],["وَما أَصابَت مِنَ الأَيّامِ جائِحَةٌ","لِلأَصلِ إِلّا وَإِن جَلَّت سَتُجتَبَرُ",4,"ر",1,0],["وَما أَصبَحَ الحَجّاجُ يَتلو رَعِيَّةً","بِسيرَةِ مُختالٍ وَلا مُتَضائِلِ",5,"ل",1,0],["وما أصلحتْ قينةٌ عودَها","وغنَّتْ بهِ وأنا أسمعُ",6,"ع",1,0],["وَما أَصبَحَ الضَحّاكُ إِلّا كَثابِتٍ","عَصانا فَأَرسَلنا المَنِيَّةَ تادِبُه",7,"ب",2,0],["وَما أَصبَحتَ تَأمُلُ مِن صَديقٍ","يَعُدُّ عَلَيكَ طولَ الحُبِّ ذَنبا",8,"ب",2,0],["وَما أَصيحُ بِغِربانِ الشَبابِ قَعي","وَلا أُنادي غُرابَ الراسِ لا تَطِرِ",9,"ر",1,0],["وَما اِصطَلَحوا عَلى تَركِ الدَنايا","بَلِ اِصطَلحوا عَلى شُربِ السُلافِ",10,"ف",1,0],["وَما أَصابَهُمُ أَفِنٌ فَغَيَّرَهُم","لَكِن أُراهُم عَلى طولِ المَدى أَفِنوا",11,"ن",3,0],["وما أَصابَ الهَوى نَفْساً وَأَشْقاها","إِلاَّ وَأَلْقَتْ بِإُذْنِ البَدْرِ شَكْواها",12,"ا",3,0],["وَما أَصلَتوا فيها بِسَيفٍ عَلِمتُهُ","وَلا بِسِلاحٍ مِن رِماحٍ وَلا نَبلِ",13,"ل",1,0],["وَمَا أصْلَتُوا فهيها بسَيْفٍ عَلمْتُهُ،","وَلا بِسِلاحٍ مِنْ رِمَاحٍ وَلا نَبْلِ",14,"ل",1,0],["وما اصطفيتك عن خوف وعن ملق","ولا لأنّي إلى نعماك أفتقر",15,"ر",1,0],["وما أصلها إلا خبيث من الورى","عن الحق للتعطيل والكفر قد الوى",16,"و",2,0],["وما أصبحَ مثلَ الشم","سِ حتى فتنَ الأرضا",17,"ض",2,0],["وما أَصبحَ في قدر","ةِ عاصٍ لك عِصيان",18,"ن",1,0],["وَما أَصدَقَ الطَيرَ الَّتي بَرَحَت بِنا","وَما أَعيَفَ اللهبي لا عَزَّ ناصِرُه",19,"ر",2,0],["وَما أَصدَقَ مَن قالَ","مغني الحَيّ ما يُطرِب",20,"ب",1,0],["وَما أَصحَبَت في قِتالِ العَذولِ","اَعِنَّةُ قَلبٍ عَلَيهِم جَموحَه",21,"ح",2,0],["وما أصَهبٌ من مسك تُبَّتَ ضمّنت","نوافجه من عنبر الشِحْر أشْهَبا",22,"ب",2,0],["وما اصطفاك اِمام العصر عن عَبثٍ","تلفى ومن هداه الهدى والرأي مرتبك",23,"ك",1,0],["وما أصوغُ بها من كلِّ قافيةٍ","غرَّاء فيها لمن يبغي العُلى شانُ",24,"ن",1,0],["وما أصبحت إلا مثل ضرسٍ","تأكَّل فهو موجودٌ فقيدُ",25,"د",1,0],["وَما أَصابكَ وَالأقدارُ كافلةٌ","بأن يصيبك لا تَلْويه بالحذَرِ",26,"ر",1,0],["وَما اِصطَلى أرماحَهُم مِن مُصطَلِ","مِن العِدى في كُلِّ يَومٍ مُعضِلِ",27,"ل",1,0],["وما أصبحت في داخل","إلا وبات الهمُّ برَّا",28,"ر",2,0],["وما اصْطحابُ بني هذا الزَّمانِ على","غِش الضَّمائر الاَّ شرُّ مُصْطَحَبِ",29,"ب",1,0],["وَمَا اصْطَبَارِي وَقَدْ زُمَّتْ رَحَائِلُهُمْ","وَللتَّرَحُّلِ حَادِي العِيسِ قَدْ نَشَطَا",30,"ط",2,0],["وَما أَصْلَحَ الْعَلْيَاءَ وَالْمَجْدَ مُصْلِحٌ","لأَمْوَالِهِ يَوْمَ النَّدَى غَيْرُ مُفْسِدِ",31,"د",1,0],["وما أصاب فإني","كليم قلب سليم",32,"م",1,0],["وَما أَصبَحَت مِن نِعمَةٍ مُستَفادَةٍ","وَلا رَحِمٍ إِلّا عَلَيكَ لَها الفَضلُ",33,"ل",1,0],["وما أصبتُ بمدح رحتُ قائلهُ","كما أصبت بريا مدحك العطر",34,"ر",1,0],["وما أُصيبوا إلاّ بطلٍّ","فكيف لو أُمطروا بوابلْ",35,"ل",1,0],["وما اصفرَّ إلا خوفَ أيدي جناته","فليس له أمنٌ من المتطرِّق",36,"ق",1,0],["وَما أَصابَت مِن قُبلة سَكَرت","تَطن كَالنَحل كُلَّما ظَفرت",37,"ت",1,0],["وما أصدقَ الأحلامَ والليلُ مظلمٌ","وأكذبها ان أسفرَ الصبح بالوعد",38,"د",1,0],["وَما أَصاخَتْ لِمَولاها بِما أَمَرا","ولا اسْتَعَدَّتْ لزادٍ إِذْ نَوَتْ سَفرا",39,"ر",2,0],["وما أصاب عماناً في زمانكمو","إلا بكفرانها الإنعام من غضب",40,"ب",1,0],["وما أصدافها إلا صحافا","لجينيات مخشرها ثقيلا",41,"ل",2,0],["وما أصلُ الخلاف جنوحُ قلبٍ","ولا عهدٌ أُخِلّ به فهانا",42,"ن",2,0],["وما أصاب عقولا فيك هائمة","قد فضلتك عن الفردوسِ يا سَقَرُ؟",43,"ر",1,0],["ومااصطباري على شيءٍ أُؤمِّلُهُ","مثلَ اصطباري على تهذيبِ أبنائي",44,"ي",1,1],["وما أصاب الفتى مما يكدره","إلا بما كسبت في لأمر أيديه",45,"ي",2,0],["وما أصْغيتُ للشَّيطانِ سَمْعاَ","وقد أصغى لأشعاري احترَامَا",46,"م",2,0]]}