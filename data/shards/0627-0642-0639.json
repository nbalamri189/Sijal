{"poems":[[53,"أقعدتنا زمانة وزمان","https://www.aldiwan.net/poem29964.html","الخفيف"],[63,"النائبات كثيرة الإنذار","https://www.aldiwan.net/poem46177.html","الكامل"],[51,"كروس يمضي بآد أصله","https://www.aldiwan.net/poem65856.html","الرجز"],[85,"يا ثرى النيل في نواحيك طير","https://www.aldiwan.net/poem62831.html","الخفيف"],[85,"درجت على الكنز القرون","https://www.aldiwan.net/poem63694.html","مجزوء الكامل"],[85,"أنا من بدل بالكتب الصحابا","https://www.aldiwan.net/poem63724.html","الكامل"],[45,"نفست قربها علينا كنود","https://www.aldiwan.net/poem62739.html","الخفيف"],[28,"غيا لباهلة التي شقيت بنا","https://www.aldiwan.net/poem1249.html",""],[31,"أبلغ سليمى بأن البين قد أفدا","https://www.aldiwan.net/poem42578.html","البسيط"],[102,"شوقي يقول وما درى بمصيبتي","https://www.aldiwan.net/poem33012.html","الكامل"],[102,"كفكف دموعك ليس ينفعك","https://www.aldiwan.net/poem33114.html","مجزوء الكامل"],[40,"بلغ قريبة أن البين قد أفدا","https://www.aldiwan.net/poem42294.html","البسيط"],[67,"ذو يراع يروع كالسيف إما","https://www.aldiwan.net/poem18069.html","الخفيف"],[50,"مهلا هجائي يا ابن شخص النجار","https://www.aldiwan.net/poem63812.html","الرجز"],[50,"وإنني في الصلاة أحضرها","https://www.aldiwan.net/poem63841.html","المنسرح"],[50,"يا عبد باهلة الذي يتوعد","https://www.aldiwan.net/poem63931.html","الكامل"],[46,"أقعد فما نفع القيا","https://www.aldiwan.net/poem22418.html","مجزوء الكامل"],[50,"يَا عَبْدَ بَاهِلة َ الذي يَتوعَّدُ","https://www.poetsgate.com/ViewPoem.aspx?id=21776",""],[107,"يا بأبي الشادن الرخيم","https://www.aldiwan.net/poem16401.html","مخلع البسيط"],[118,"يا حسن واحسرتا على غرر","https://www.aldiwan.net/poem49263.html","المنسرح"],[141,"إن لم أقل فيك ما يردي العدى كمدا","https://www.aldiwan.net/poem11753.html","البسيط"],[162,"إنما فازت قداح المنايا","https://www.aldiwan.net/poem67815.html","المديد"],[221,"أشكو إلى قلبك يا سيدي","https://www.aldiwan.net/poem41616.html","السريع"],[248,"أبروق يلوح منها وميض","https://www.aldiwan.net/poem14988.html","الخفيف"],[254,"يا عارضا يروي الثرى غيثه","https://www.aldiwan.net/poem48359.html","السريع"],[254,"غطت البظراء لما","https://www.aldiwan.net/poem48436.html","مجزوء الرمل"],[259,"كل من جد ساعيا في معاليه","https://www.aldiwan.net/poem38107.html","الخفيف"],[280,"تظلموا وهم عقوا وهم ظلموا","https://www.aldiwan.net/poem32460.html","البسيط"],[362,"وقيت ما فيك أتقيه","https://www.aldiwan.net/poem60580.html","مخلع البسيط"],[419,"مرثية رجل عظيم","https://www.aldiwan.net/poem24295.html","عموديه"],[429,"عزمي وحزمي والحسام الماضي","https://www.aldiwan.net/poem12440.html","مشطور الرجز"],[438,"نجمع والمجموع يكلا ويترك","https://www.aldiwan.net/poem14471.html","الطويل"],[462,"هذه دولة الندى والسماح","https://www.aldiwan.net/poem3162.html","عموديه"],[477,"أرقت وما غير الشجون سمير","https://www.aldiwan.net/poem37571.html","الكامل"]],"verses":[["أَقعَدَتنا زَمانَةٌ وَزَمانٌ","جائِرٌ عَن قَضاءِ حَقِّ الشَريفِ",0,"ف",1,1],["أقْعى دوَيْنَ الغابِ يمنَعُ شِبلَهُ","ويُجيلُ نظرَةَ باسِلٍ كَرّارِ",1,"ر",1,0],["أقعتْ عليهِ فَيْشةٌ من شكْلِهِ","فطحاءُ يمضي مثلها بمثلِهِ",2,"ه",1,0],["أَقعَدَ الرَوضَ في الحَياةِ مَلِيّاً","وَأَقامَ الرُبى بِسِحرِ الهَديلِ",3,"ل",1,0],["أَقعَدتُ جيلاً لِلهَوى","وَأَقَمتُ جيلاً آخَرين",4,"ن",1,0],["أَقعَدَ اللَهُ الجَبرَتِيَّ لَها","قَلَماً عَن غائِبِ الأَقلامِ نابا",5,"ب",2,0],["أَقعَصَ الفِتنَةَ المُضِلَّةَ حَتّى","رَحِمَ القائِمينَ فيها القُعودُ",6,"د",1,0],["أَقعى لِيَحبِسَ بِاِستِهِ تَيّارَهُ","فَهوى عَلى حَدَبٍ لَهُ مُتَنَصِّبِ",7,"ب",1,0],["أَقعَدنَها وَبِنا ما قالَ ذو حَسَبٍ","صَبٌّ بِسَلمى إِذا ما أُقعِدَت قَعَدا",8,"د",2,0],["اقعد فديتك هل يكون مبجلاً","من كان للنشء الصغار خليلا",9,"ل",2,0],["أُقعدْ فما أنتَ الذي","يَسْعى إلى إنهاضها",10,"ه",2,0],["أَقعَدنَها وَنَثا ما قُلنَ ذُو حَسَدٍ","صَبٌّ بِلَيلى إِذا ما أُقعِدَت قَعَدا",11,"د",2,0],["أقْعَدَتْنِي بِقَريَةٍ أسْلَمَتْنِي","لِضَياعٍ مِنْ فاقَتِي وكُفُورِ",12,"ر",1,0],["اِقعُد فَقَد قالَ رُواةُ الأَشعار","لَيسَ اِبنُ نِهيا مِن رِجالِ بَشّار",13,"ر",1,0],["أَقعُدُ في سَجدَةٍ إِذا رَكَعوا","وَأَرفَعُ الرَأسَ إِن هُمُ سَجَدوا",14,"د",3,0],["اِقعُد فَإِنَّكَ باهِلِيٌّ واغِلٌ","يَجزيكَ سَوأَتَكَ الضِياعُ الرُوَّدُ",15,"د",1,0],["أُقعُد فَما نَفَعَ القِيا","مُ وَلا ثَنى خَيراً قُعودُ",16,"د",1,1],["اقْعُدْ فَإِنَّكَ بَاهِليٌّ وَاغلٌ","يَجْزِيكَ سَوْءَتَكَ الضِّيَاعُ الرُّوَّدُ",17,"د",1,0],["أَقعدني عَنهُ سوء حَظ","بِبَعضِهِ الدَهر لا يَقوم",18,"م",1,0],["أقعده الهم عن مراغبه","كالنسر هاضته رعشة الكبر",19,"ر",1,0],["أَقعَدتَ مَن قامَ مِن أَعداءِ دَولَتِهِ","وَلَو بِغَيرِكَ ريعوا قامَ مَن قَعَدا",20,"د",2,0],["أَقُعودٌ وَالقُلوبُ تَلَظّى","فَاِنبُذِ المِغفَرَ وَاِلبَس نَصيفا",21,"ف",2,0],["أَقعَدَني عَن نَيلِ مُستَقبَلي","همٌّ وَلَولا الهَمُّ لم أَقعُدِ",22,"د",1,0],["أَقعَدتني الأيامُ عن لذَّة العَي","ش بشَيب له بفودى نُهُوضُ",23,"ض",1,0],["أقعدت في الكتاب من لم يكن","يضره أنك لا تقعده",24,"د",2,0],["اقعدي عندي وهذا","فافعليه عند غيري",25,"ر",2,0],["أقعدته أيامه حسداً فيه","لتدني مطلوبه للدني",26,"ي",1,0],["أَقعَوا هُناكَ عَلى الأَذنابِ مِن جَزَعٍ","لَمّا أَتَتهُم يَدٌ فَرّاسَةٌ وَفَمُ",27,"م",1,0],["أَقْعدَني عن ذُراكَ حتّى","حُرِمْتُ ما عَمَّ زائريه",28,"ي",2,0],["أقعى في مقعدهِ مختوما بالبهجة","حتى انتصف الليل",29,"ل",1,0],["اقْعُدْ فقد جاءك ذا ارتِكاضِ","وليس محتاجاً الى حضّاضِ",30,"ض",1,0],["اقعد القواة امغاطها وأعماطها فهل ينظرون","إلا الساعة أن تأتيهم بغتة فقد جاء أشراطها",31,"ه",2,0],["أقعدَ الخطبُ عندما طارت ال","بشرى إلينا على جناح النجاح",32,"ح",1,0],["أقعت مقرفصة فأيقظ أمها","هلعا تهدج صوتها وزفير",33,"ر",1,0]]}