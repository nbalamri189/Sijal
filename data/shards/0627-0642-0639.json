[255,"أبروق يلوح منها وميض","https://www.aldiwan.net/poem14988.html","الخفيف"],[261,"يا عارضا يروي الثرى غيثه","https://www.aldiwan.net/poem48359.html","السريع"],[261,"غطت البظراء لما","https://www.aldiwan.net/poem48436.html","مجزوء الرمل"],[266,"كل من جد ساعيا في معاليه","https://www.aldiwan.net/poem38107.html","الخفيف"],[287,"تظلموا وهم عقوا وهم ظلموا","https://www.aldiwan.net/poem32460.html","البسيط"],[369,"وقيت ما فيك أتقيه","https://www.aldiwan.net/poem60580.html","مخلع البسيط"],[428,"مرثية رجل عظيم","https://www.aldiwan.net/poem24295.html","عموديه"],[438,"عزمي وحزمي والحسام الماضي","https://www.aldiwan.net/poem12440.html","مشطور الرجز"],[447,"نجمع والمجموع يكلا ويترك","https://www.aldiwan.net/poem14471.html","الطويل"],[469,"هذه دولة الندى والسماح","https://www.aldiwan.net/poem3162.html","عموديه"],[484,"أرقت وما غير الشجون سمير","https://www.aldiwan.net/poem37571.html","الكامل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96981","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48838","الخفيف"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79922","الخفيف"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87851","الرمل"],[2251,"","https://poetry.dctabudhabi.ae/diwan/poem/82123","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100305","الرمل"],[3003,"","https://poetry.dctabudhabi.ae/diwan/poem/126539","السريع"],[3187,"","https://poetry.dctabudhabi.ae/diwan/poem/138781",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138563",""],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32846","المنسرح"],[3855,"","https://poetry.dctabudhabi.ae/diwan/poem/32670","المديد"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119431","الرجز"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123526","الخفيف"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204311","الخفيف"],[4684,"أفرخ الزغلول","https://www.poetsgate.com/ViewPoem.aspx?id=202387",""],[4799,"وين ساري ؟","https://www.poetsgate.com/ViewPoem.aspx?id=12270",""],[5302,"باحث حالم","https://www.poetsgate.com/ViewPoem.aspx?id=201245",""],[5847,"ألم وأمل","https://www.poetsgate.com/ViewPoem.aspx?id=6444",""],[5906,"سَمراء","https://www.poetsgate.com/ViewPoem.aspx?id=188806",""],[5956,"ضياع طفل *","https://www.poetsgate.com/ViewPoem.aspx?id=184565",""],[5956,"خذني لعَطفك","https://www.poetsgate.com/ViewPoem.aspx?id=193808",""],[4442,"بالأعالي فتنت لا بالأسافل","https://www.poetsgate.com/ViewPoem.aspx?id=171204",""]],"verses":[["أَقعَدَتنا زَمانَةٌ وَزَمانٌ","جائِرٌ عَن قَضاءِ حَقِّ الشَريفِ",0,"ف",1,1],["أقْعى دوَيْنَ الغابِ يمنَعُ شِبلَهُ","ويُجيلُ نظرَةَ باسِلٍ كَرّارِ",1,"ر",1,0],["أقعتْ عليهِ فَيْشةٌ من شكْلِهِ","فطحاءُ يمضي مثلها بمثلِهِ",2,"ه",1,0],["أَقعَدَ الرَوضَ في الحَياةِ مَلِيّاً","وَأَقامَ الرُبى بِسِحرِ الهَديلِ",3,"ل",1,0],["أَقعَدتُ جيلاً لِلهَوى","وَأَقَمتُ جيلاً آخَرين",4,"ن",1,0],["أَقعَدَ اللَهُ الجَبرَتِيَّ لَها","قَلَماً عَن غائِبِ الأَقلامِ نابا",5,"ب",2,0],["أَقعَصَ الفِتنَةَ المُضِلَّةَ حَتّى","رَحِمَ القائِمينَ فيها القُعودُ",6,"د",1,0],["أَقعى لِيَحبِسَ بِاِستِهِ تَيّارَهُ","فَهوى عَلى حَدَبٍ لَهُ مُتَنَصِّبِ",7,"ب",1,0],["أَقعَدنَها وَبِنا ما قالَ ذو حَسَبٍ","صَبٌّ بِسَلمى إِذا ما أُقعِدَت قَعَدا",8,"د",2,0],["اقعد فديتك هل يكون مبجلاً","من كان للنشء الصغار خليلا",9,"ل",2,0],["أُقعدْ فما أنتَ الذي","يَسْعى إلى إنهاضها",10,"ه",2,0],["أَقعَدنَها وَنَثا ما قُلنَ ذُو حَسَدٍ","صَبٌّ بِلَيلى إِذا ما أُقعِدَت قَعَدا",11,"د",2,0],["أقْعَدَتْنِي بِقَريَةٍ أسْلَمَتْنِي","لِضَياعٍ مِنْ فاقَتِي وكُفُورِ",12,"ر",1,0],["اِقعُد فَقَد قالَ رُواةُ الأَشعار","لَيسَ اِبنُ نِهيا مِن رِجالِ بَشّار",13,"ر",1,0],["أَقعُدُ في سَجدَةٍ إِذا رَكَعوا","وَأَرفَعُ الرَأسَ إِن هُمُ سَجَدوا",14,"د",3,0],["اِقعُد فَإِنَّكَ باهِلِيٌّ واغِلٌ","يَجزيكَ سَوأَتَكَ الضِياعُ الرُوَّدُ",15,"د",1,0],["أُقعُد فَما نَفَعَ القِيا","مُ وَلا ثَنى خَيراً قُعودُ",16,"د",1,1],["اقعصتهم في صلاة لا بواء لهم","هلا مشابرة والقوم في حذر",17,"ر",1,0],["اقْعُدْ فَإِنَّكَ بَاهِليٌّ وَاغلٌ","يَجْزِيكَ سَوْءَتَكَ الضِّيَاعُ الرُّوَّدُ",18,"د",1,0],["أَقعدني عَنهُ سوء حَظ","بِبَعضِهِ الدَهر لا يَقوم",19,"م",1,0],["أقعده الهم عن مراغبه","كالنسر هاضته رعشة الكبر",20,"ر",1,0],["أَقعَدتَ مَن قامَ مِن أَعداءِ دَولَتِهِ","وَلَو بِغَيرِكَ ريعوا قامَ مَن قَعَدا",21,"د",2,0],["أَقُعودٌ وَالقُلوبُ تَلَظّى","فَاِنبُذِ المِغفَرَ وَاِلبَس نَصيفا",22,"ف",2,0],["أَقعَدَني عَن نَيلِ مُستَقبَلي","همٌّ وَلَولا الهَمُّ لم أَقعُدِ",23,"د",1,0],["أَقعَدتني الأيامُ عن لذَّة العَي","ش بشَيب له بفودى نُهُوضُ",24,"ض",1,0],["أقعدت في الكتاب من لم يكن","يضره أنك لا تقعده",25,"د",2,0],["اقعدي عندي وهذا","فافعليه عند غيري",26,"ر",2,0],["أقعدته أيامه حسداً فيه","لتدني مطلوبه للدني",27,"ي",1,0],["أَقعَوا هُناكَ عَلى الأَذنابِ مِن جَزَعٍ","لَمّا أَتَتهُم يَدٌ فَرّاسَةٌ وَفَمُ",28,"م",1,0],["أَقْعدَني عن ذُراكَ حتّى","حُرِمْتُ ما عَمَّ زائريه",29,"ي",2,0],["أقعى في مقعدهِ مختوما بالبهجة","حتى انتصف الليل",30,"ل",1,0],["اقْعُدْ فقد جاءك ذا ارتِكاضِ","وليس محتاجاً الى حضّاضِ",31,"ض",1,0],["اقعد القواة امغاطها وأعماطها فهل ينظرون","إلا الساعة أن تأتيهم بغتة فقد جاء أشراطها",32,"ه",2,0],["أقعدَ الخطبُ عندما طارت ال","بشرى إلينا على جناح النجاح",33,"ح",1,0],["أقعت مقرفصة فأيقظ أمها","هلعا تهدج صوتها وزفير",34,"ر",1,0],["أقعى كما أقعى أبوه ل","عجز ذي لهث عقور",35,"ر",1,0],["أقعدتني السقام عن واجبيه","وهي عذري إلى أبي شعرائه",36,"ا",3,0],["إقعادهم تغير العروض في","طويلهم حذفا وإتماما بقي",37,"ي",1,0],["أقعدت عن شواردِ النظم فكري","عللٌ عُقنهُ عن الإقتناص",38,"ص",1,0],["أَقعَدوهُ ثُمَّ قالوا","كُن ضَريراً فَقَعَد",39,"د",1,0],["أَقعت عَلى فَرَق في صحصح أَنِق","يَنظُرن في حَدَق مِن خَوف عِقبانِ",40,"ن",1,0],["اقعود والقنا تنفث حتفا","من يديهم والظبي تلهب نارا",41,"ر",2,0],["اقعدني العجز وضعفي نما","فالبس العين ثياب العمى",42,"م",2,0],["أقعوداً وذِهِ شيعتكم","نالها فيكم هَوانٌ وصَغَار",43,"ر",1,0],["اقعد الخطب بها لكن لها","حمل العزم فاقبلن سراعا",44,"ع",2,0],["أَقعَدَني الدَهرُ عَن بَزوغى وَكِر","كينَ وَغُمّى بِالعُسرِ وَالكِبَرِ",45,"ر",1,0],["أَقَعيداً لِلقَعيدَةِ إِلفاً","كُلُّ إِلفٍ بي لِعُدمي مُخِلُّ",46,"ل",1,0],["أقعى على أذنابهن التبري","اقعاء أسد بصرت بنمر",47,"ر",1,0],["أقعدته عنك الذنوب وان لم","تك عونا له اضمحل وزالا",48,"ل",2,0],["أقعدتنا زمانةٌ وزمان","عائق من قضاء حق الشريف",49,"ف",1,1],["إقْعدْ فلست أقولها عن صبوةٍ","لكن هجوي للغرور نُصولُ",50,"ل",1,0],["أقعد أبشكي لك همومٍ بصدري","ما جيت لك إلا وأنا حيل تعبان",51,"ن",1,0],["أقعدني فيك غرامي ولم","أشف ونفس الحال للقائم",52,"م",1,0],["أقعودا عن الكفاح وقوم","من بني الدين ينظرون الإعانه؟!",53,"ن",2,0],["أَقْعَدَتني بِنَظْرَةٍ سَمراءُ","وَيلَ قَلبي لَم تَعفُهُ حَوّاءُ",54,"ا",2,1],["أقعَى طوال حياته برُهابِهِ","حتى انزوى متحطما متوترا",55,"ر",2,0],["أقْعى وشعبي راجِيَيْنِ تراحماً","بمشاركات دعائك المنفوحِ",56,"ح",1,0],["اقعصت دونها الأواخر نكصا","وتعالت فلم تصبها الأوائل",57,"ل",1,0]]}