{"poems":[[79,"قل للأشوني ولا تحتشم","https://www.aldiwan.net/poem36657.html","السريع"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[457,"تراك المهل في حث الركاب","https://www.aldiwan.net/poem13648.html","الوافر"],[612,"","https://poetry.dctabudhabi.ae/diwan/poem/82794","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93647","البسيط"],[2708,"","https://poetry.dctabudhabi.ae/diwan/poem/80426","الرجز"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100222","المتقارب"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205550","الرمل"],[3991,"","https://poetry.dctabudhabi.ae/diwan/poem/111055","الوافر"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119391","الرجز"]],"verses":[["وقِشْرِ رُمّانٍ وشَبٍّ ومنْ","سُكٍّ وعَفْصٍ قابِضٍ فَجِّ",0,"ج",1,0],["وقشورٌ وما هناك لبابٌ","ولبابٌ وما هناك قشورُ",1,"ر",1,0],["وقَشَّعَتِ الشمال الدُجْنَ حتى","بدا وجه الرقيع من الحجاب",2,"ب",1,0],["وَقشع السحب عَن أُفق السَما فَبَدا","طَلقا وَأَطلَع وَجه الشَمس ضَحيانا",3,"ن",2,0],["وَقشع العارض المرخي ذلاذله","لِبارق البشر في حافاته لمع",4,"ع",1,0],["وقَشره مُوَلِّد للريح","فِي الهَضمِ لا يَضُرُّ بِالصَّحِيحِ",5,"ح",1,0],["وقشع غيثا وعرقب ليثاً","وزلزل طوداً ودكّ هضابا",6,"ب",2,0],["وقشورًا لا تساوي وزنها","من تراب، لن ترى من يشتريها",7,"ي",3,0],["وقشع منك صرف الخطب ظلا","على خطط الوجود غدا ظليلا",8,"ل",2,0],["وقشمش كخزز","للنظم لم يثقب",9,"ب",1,1]]}