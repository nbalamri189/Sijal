{"poems":[[37,"سراج الدجى صفر الحشا منتهى المنى","https://www.aldiwan.net/poem39172.html","الطويل"],[32,"ألا حي بالزرق الرسوم الخواليا","https://www.aldiwan.net/poem29520.html","الطويل"],[32,"دنا البين من مي فردت جمالها","https://www.aldiwan.net/poem29539.html","الطويل"],[47,"ضاعف من بثي وأحزاني","https://www.aldiwan.net/poem66820.html","السريع"],[21,"جزى الله الأجل المرء نوحا","https://www.aldiwan.net/poem36245.html","الوافر"],[50,"لئن هجرتك بعد الوصل أروى","https://www.aldiwan.net/poem63289.html","البسيط"],[48,"نقمت الرضى حتى على ضاحك المزن","https://www.aldiwan.net/poem23626.html","الطويل"],[19,"عيني لا بد من سكب وتهمال","https://www.aldiwan.net/poem360.html",""],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62210","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16693","الطويل"],[214,"تريك الصبح في الليل البهيم","https://www.aldiwan.net/poem13402.html","الوافر"],[264,"سلام حكى نظم الجواهر في السلك","https://www.aldiwan.net/poem35792.html","الطويل"],[266,"أمض الجوى صد القريب المجانب","https://www.aldiwan.net/poem38365.html","الطويل"],[302,"سل البان عنهم أين بانوا ويمموا","https://www.aldiwan.net/poem33179.html","الطويل"],[333,"يا ليل قد طلع الصباح","https://www.aldiwan.net/poem55076.html","مجزوء الكامل"],[342,"أتعرف رسما دارسا قد تغيرا","https://www.aldiwan.net/poem45431.html","الطويل"],[366,"هي الليالي فلا تغتر بالامل","https://www.aldiwan.net/poem68072.html","البسيط"],[369,"أيا ولي الدولة المرتجى","https://www.aldiwan.net/poem60856.html","السريع"],[398,"علي أمير المؤمنين خليفة","https://www.aldiwan.net/poem53380.html","الكامل"],[398,"علي أمامي دون من جار وارتشى","https://www.aldiwan.net/poem53659.html","الطويل"],[509,"سروري وذوقي من جمالك صادر","https://www.aldiwan.net/poem38406.html","الطويل"],[520,"ألا قل لكتاب الصناعة كلهم","https://www.aldiwan.net/poem12229.html","الطويل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126797","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103067","الطويل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66803","الطويل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66836","المتقارب"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66708","المتقارب"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66649","الطويل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66846","الطويل"],[893,"","https://poetry.dctabudhabi.ae/diwan/poem/138818",""],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67840","الطويل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72256","الطويل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25345","الرجز"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108584","السريع"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49547","الوافر"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132225","المجتث"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123075","البسيط"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121175","الطويل"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132349","الطويل"],[3106,"","https://poetry.dctabudhabi.ae/diwan/poem/104505","الطويل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112682","الرجز"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138477",""],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66348","الطويل"],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95318","الطويل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44727","الطويل"],[4122,"","https://poetry.dctabudhabi.ae/diwan/poem/111116","الطويل"],[4473,"","https://poetry.dctabudhabi.ae/diwan/poem/130600","الطويل"],[4727,"على أمثالها قلبي يطير","https://www.poetsgate.com/ViewPoem.aspx?id=215834",""],[4767,"فرزنو","https://www.poetsgate.com/ViewPoem.aspx?id=178386",""],[5131,"نحْنُ هنا إِنْ يحنِ الموعدُ","https://www.poetsgate.com/ViewPoem.aspx?id=58246",""],[5151,"قرط الأميرات","https://www.poetsgate.com/ViewPoem.aspx?id=184842",""],[4045,"نفّر نومي الخبر الساري","https://www.poetsgate.com/ViewPoem.aspx?id=200300",""],[5277,"غزلُ الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=187523",""],[5304,"الراتب ما يكفي الحاجه","https://www.poetsgate.com/ViewPoem.aspx?id=155913",""],[5314,"أحدث غيما","https://www.poetsgate.com/ViewPoem.aspx?id=214822",""],[5616,"أنا","https://www.poetsgate.com/ViewPoem.aspx?id=205028",""],[5751,"طيلسان الريح","https://www.poetsgate.com/ViewPoem.aspx?id=214790",""],[520,"ألا قل لكتاب الصناعة كلهم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577625",""]],"verses":[["عَلى أُمِّ بَكرٍ رَحمَةٌ وَتَحِيَّةٌ","لَها مِنكَ والنائي يَوَدُّ وَيَنصَحُ",0,"ح",1,0],["عَلى أَمرِ مَن لَم يُشوِني ضَرُّ أَمرِهِ","وَلَو أَنَّني اِستَأوَيتُهُ ما أَوى ليا",1,"ي",2,0],["عَلى أَمرِ مُنقَدِّ العِفاءِ كَأَنَّهُ","عَصا قَسِّ قوسٍ لينُها وَاِعتِدالُها",2,"ل",3,0],["عَلى امرِئٍ لَم يُلفَ في سُؤدُدٍ","بِواهِنِ السَعيِ وَلا وانِ",3,"ن",1,0],["عَلى أَمواجِ أَخضَرَ ذي حَبيكٍ","كَأَنَّ سُعارَ زاخِرِهِ الهِضابُ",4,"ب",1,0],["عَلى أَمثالِها كانَت لِكِسرى","أَنوشِروانَ تَتَّجِرُ التِجارُ",5,"ر",1,0],["على أُمّ دَفْرٍ غَضْبَةُ اللّهِ انّها","لأجْدَرُ أُنْثَى أنْ تَخونَ وأن تُخني",6,"ن",2,0],["عَلى اِمرِئٍ سوقَةٍ مِمَّن سَمِعتُ بِهِ","أَندى وَأَكمَلَ مِنهُ أَيَّ إِكمالِ",7,"ل",1,0],["عَلَى أَمْرِهِ والحَزْمُ بَيْنِي وبَيْنهُ","يَرَى غَيْرَ مَا أَهْوَى مِنَ الأَمْرِ أَرْشَدَا",8,"د",2,0],["على أَمَمٍ إنّي رأيْتُكَ لابِساً","قَميصاً يُحاكي الماءَ إنْ لم يُساوِهِ",9,"ا",3,1],["عليا ما نوى ركب حجازاً","وزمزم بين زمزم والحطيم",10,"م",1,0],["على أمد الآماد ما السحب قد بكت","ومنها زهور الروض كالثغر في ضحك",11,"ك",1,0],["على أم دفر بعد رؤيته الرضا","وان سخطت منها على أقاربي",12,"ب",2,0],["عليٌّ أَميرُ المؤمنين وصيُّه","إليه اِنتَهى كُلُّ النُهى والتكرُّمُ",13,"م",1,0],["على أموت فمن يخل","لِد في الصبابة ذكريه",14,"ي",2,0],["عَلى أَمِّ بَيضاءَ السَلامُ مُضاعَفاً","عَديدَ الحَصى ما بَينَ حِمصَ وَشَيزَرا",15,"ر",2,0],["عَلى امام همام فاضِل فطن","حبر لَبيب ملاذ لِلعُلومِ وَلى",16,"ل",2,0],["على امْرئٍ تَأخذُ من شُكرِه","إن حُزْتَه فوقَ الّذي تُعطي",17,"ط",2,0],["عَلِيَّ أَميرَ المُؤمِنين خليفَةٌ","شَهدتُ لهُ بِالجنَّةِ المُتَعالِيَه",18,"ه",1,1],["عَلِيٌّ أَمامي دونَ من جارَ وَاِرتَشى","وَذلِكَ فَضلُ اللَهِ يُؤتيهِ مَن يَشا",19,"ش",2,1],["على امير المؤمنين هو الذي","لكتر صلاح الشرع بالعدل جابر",20,"ر",1,0],["على أم من لا يعتني بحوائجي","أيور التي يُركبن في سورة النحل",21,"ل",1,0],["عليّ أمير المؤمنين ومَن له","ملائكةُ الرحمن تعنو وتخضعُ",22,"ع",1,0],["عليّ أمير المؤمنين وفي غدٍ","لكلِّ مُحبٍّ شافع ومشفّعُ",22,"ع",1,0],["عليّ إمامٌ والأئمّة بعده","كواكب في أفق الهداية تطلعُ",22,"ع",1,0],["على أمره في الأمر بالأمر غالب","فتحره غيبا به غلباته",23,"ت",2,0],["عليّ أميرُ المؤمنينَ وحقُّهُ","من اللهِ مفروضٌ على كلِّ مُسلمِ",24,"م",1,0],["عليٌّ إماميَ لا أمتري","وخلّيتُ قَولي بكانَ وكانَ",25,"ن",1,0],["عليّ إمامٌ وصيُّ النبيِّ","بمحضَرَه قد دعاهُ أميرا",26,"ر",2,1],["عليٌّ أميرُ المؤمنينَ وعِزُّهُم","إذا الناس خافوا مُهلكاتِ العَواقبِ",27,"ب",1,1],["عليٌّ أميرُ المؤمنينَ أخو الهدى","وأفضلُ ذي نعلٍ ومن كان حافيا",28,"ي",2,1],["علي أمير المؤمنين وسيد الو","صيين والساقي على الكوثر الاهنى",29,"ن",2,0],["عَلىَ أُمَّةِ التَّوْحِيدِ مَا زَالَ مُشْفِقَا","سَرَائِرُهُ مَعْصُوَمةٌ وَالظَّوَاهِرُ",30,"ر",1,0],["عليَّ أمير المؤمنين ولاؤه","يراه ذوو الأحساب ضربة لازب",31,"ب",1,0],["عَلَى امْرِئٍ ضَلَّ الهُدَى وَأَوْبَقا","مُهْجَتَهُ ذاقَ الحُسَامَ المِخْفَقا",32,"ق",2,0],["على أمين اللَه سلطاننا","عبد العزيز الشهم حفظ البلاد",33,"د",1,0],["على أُمِّ اليتامَى والأيامَى","إذا نَبَتِ المواضع بالجُنُوب",34,"ب",1,0],["على إمام البرايا","يس طاء وهاء",35,"ا",2,0],["على أمر أطال الحجر من صَلَف","على الحشا ولذا سمّوه حجّارا",36,"ر",2,0],["علي امير المؤمنين ومن حوى","مقاما محا قيل الظنون وقالها",37,"ل",3,0],["على أمَّةِ الهادي تفضَّلت رَبَّنا","بهِ إذ خفَت أقمارُها والدُّلامصُ",38,"ص",1,0],["علي أمير المؤمنين إمامنا","ومن نبتغي في حبه أجزل الأجر",39,"ر",1,1],["على أمينِ اللَهِ في بلادهِ","وحجةِ اللَهِ على عبادهِ",40,"ه",1,0],["علي أمير المؤمنين ومن حوى","مناقب شتى لا تحيط بها القوى",41,"ا",1,1],["علي أمير المؤمنين ومن به","تقوّض من أهل الضلال خيامها",42,"م",3,0],["عليٌّ أميرُ المؤمنينَ زعيمهُ","وَقائدُه نَسرُ المفازةِ والذِّيبُ",43,"ب",1,0],["عَلى أَمة قَد طالَ عَن برئها الرَجا","أَريدُ لَها حُسنَ السَعادةِ وَالنَجا",44,"ج",2,0],["علي أمير المؤمنين أمامنا","امام الهدى بعد النبي أبي الغر",45,"ر",1,0],["على امير المؤمنين وسيد ال","وصيين بل نفس النبي ونائبه",46,"ب",2,0],["على أمثالها قلبي يطيرُ","خَبَرْنَجَةٌ وليس لها نظيرُ",47,"ر",1,1],["على أمور إذا ما","حفظتها فهي هون",48,"ن",1,0],["على امتدادِ الأفقِ أهدافُنا","رنا إليها الموج والفرقد",49,"د",1,0],["عَلَى اِمْتِدَادِ دَمِي كانت خِطاباتي","تَهفو إليكِ على بُعْدِ المَسَافاتِ",50,"ت",1,1],["على إمام سوطه سيفه","ليس إذا همّ بنظّار",51,"ر",1,0],["على امْتدادِ بياضِ الفجرِ تعزفُها","أوتارُهُ منذُ أنْ أصبحتِ نغمتَهُ",52,"ت",2,0],["على اموالنا سلم ولا داعي احراجه","منافع بلدنا ومخزني يصرف بموكيت",53,"ت",1,0],["على أمتي أواه من هول ما قضى","على أمتي والعاقلون مثولوا",54,"ل",3,0],["علِّي أموتُ وفي كفَّيَّ سوسنَةٌ","وفوقَ ثغري فجرٌ غيرُ موؤودِ",55,"د",1,0],["على امتداد أقاصي ورد بسمتها","نبضٌ توسّدَهُ ليلٌ من الأرقِ",56,"ق",1,0],["على أم من لا يعتني بحوائجي","أيور التي بركن في سورة النخل",57,"ل",1,0]]}