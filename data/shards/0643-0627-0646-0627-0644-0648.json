{"poems":[[55,"ألا من يمطر السنة الجمادا","https://www.aldiwan.net/poem30602.html","الوافر"],[79,"أطاع لساني في مديحك إحساني","https://www.aldiwan.net/poem36069.html","الطويل"],[75,"هذا الصباح على سراك رقيبا","https://www.aldiwan.net/poem11919.html","الكامل"],[32,"خليلي عوجا عوجة","https://www.aldiwan.net/poem29570.html","الطويل"],[23,"والله ما أوصى أمية بكره","https://www.aldiwan.net/poem21315.html","الكامل"],[74,"يا دار جيرتنا بسفح الأجرع","https://www.aldiwan.net/poem19161.html","الكامل"],[87,"بسيفك يعلو الحق والحق أغلب","https://www.aldiwan.net/poem63786.html","الطويل"],[47,"قل للخيال إذا أردت فعاود","https://www.aldiwan.net/poem63447.html","الكامل"],[47,"خطته فلم تحفل به الأعين الوطف","https://www.aldiwan.net/poem65143.html","الطويل"],[107,"حماة الوغى أين السلام الموطد","https://www.aldiwan.net/poem43104.html","الطويل"],[52,"توعدني أبو خلف","https://www.aldiwan.net/poem62249.html","مجزوء الوافر"],[78,"قصد المنون له فمات فقيدا","https://www.aldiwan.net/poem39456.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85451","البسيط"],[111,"خذوا بجميل الصبر وارضوا وسلموا","https://www.poetsgate.com/ViewPoem.aspx?id=524",""],[92,"حنين","https://www.poetsgate.com/ViewPoem.aspx?id=179239",""],[47,"خَطَتْهُ فَلَمْ تَحفِلْ به الأَعيُنُ الْوُطفُ","https://www.poetsgate.com/ViewPoem.aspx?id=32541",""],[146,"كان الوداد منغصا لوشاتنا","https://www.aldiwan.net/poem58379.html","الكامل"],[186,"هذا ابن يوسف من بني الدباس","https://www.aldiwan.net/poem61175.html","الكامل"],[203,"لقد كذب الآمال من كان كسلانا","https://www.aldiwan.net/poem45671.html","الطويل"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[276,"قسمت قلبك في الهوى فتقسما","https://www.aldiwan.net/poem52077.html","الكامل"],[310,"بصادق عزم تفخر الدولة الوسطى","https://www.aldiwan.net/poem56490.html","الطويل"],[310,"كأن الورد في ورق وزهر","https://www.aldiwan.net/poem56522.html","الوافر"],[310,"كأن الورد محفوفا بزهر","https://www.aldiwan.net/poem56523.html","الوافر"],[369,"أطاعك مني القلب العصي","https://www.aldiwan.net/poem60562.html","الوافر"],[369,"ألا ليت قلبي يوم أعلن وجده","https://www.aldiwan.net/poem60955.html","الطويل"],[422,"أنيخاها فقد بلغت مناها","https://www.aldiwan.net/poem54083.html","الوافر"],[463,"لمن صاغيات في الحبل طلائح","https://www.aldiwan.net/poem56246.html","الطويل"],[491,"أتعرف رسماً كالرداء المحبر","https://www.aldiwan.net/poem483.html",""],[519,"مضى خلف الأبرار والسيد الطهر","https://www.aldiwan.net/poem20839.html","الطويل"],[563,"خليلي ما بال القوافل هكذا","https://www.aldiwan.net/poem34232.html","الطويل"],[567,"ما يرتجيه المرء من مولوده","https://www.aldiwan.net/poem52771.html","الكامل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83309","الطويل"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66795","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48771","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63756","الطويل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56569","الطويل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48949","الطويل"],[2280,"","https://poetry.dctabudhabi.ae/diwan/poem/75843","الطويل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137129",""],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75963","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199962","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205015","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74281","الطويل"],[3211,"","https://poetry.dctabudhabi.ae/diwan/poem/130125","الطويل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87628","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62877","البسيط"],[3508,"","https://poetry.dctabudhabi.ae/diwan/poem/20542","المتقارب"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66364","السريع"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91447","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91872","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131270",""],[3889,"","https://poetry.dctabudhabi.ae/diwan/poem/142941","الطويل"],[4690,"آثارُ الزُّهور","https://www.poetsgate.com/ViewPoem.aspx?id=120286",""],[4691,"قبيلتي هيفاء !!","https://www.poetsgate.com/ViewPoem.aspx?id=59824",""],[4699,"مشرقة","https://www.poetsgate.com/ViewPoem.aspx?id=193395",""],[4755,"كانَ الوَحِيدَ هُناكَ.. مُذ دَجَّى","https://www.poetsgate.com/ViewPoem.aspx?id=183719",""],[4778,"عيون الغيد","https://www.poetsgate.com/ViewPoem.aspx?id=188204",""],[4959,"النّاسُ اليومَ شوكٌ بلا ثمَر","https://www.poetsgate.com/ViewPoem.aspx?id=214760",""],[4966,"تجَنَّى..","https://www.poetsgate.com/ViewPoem.aspx?id=196745",""],[5038,"على شفتيه","https://www.poetsgate.com/ViewPoem.aspx?id=190093",""],[3558,"بدأنا بحمد الله فهو سناء","https://www.poetsgate.com/ViewPoem.aspx?id=43376",""],[5121,"رَيْحَانَةُ الحُبَّ","https://www.poetsgate.com/ViewPoem.aspx?id=174814",""],[5187,"وطن بلا ربيع","https://www.poetsgate.com/ViewPoem.aspx?id=29066",""],[5397,"توارى محيا الشمس منك بحاجب","https://www.poetsgate.com/ViewPoem.aspx?id=157938",""],[5413,"وأنا_الأخيرُ_ولا_أخيرَ","https://www.poetsgate.com/ViewPoem.aspx?id=216036",""],[5431,"رياض العاشقين ...","https://www.poetsgate.com/ViewPoem.aspx?id=207521",""],[5563,"أبيات مجتزأة من سجال","https://www.poetsgate.com/ViewPoem.aspx?id=213545",""],[5582,"أَلا عُجْ بِالمَطِيِّ عَلَى المُقامِ","https://www.poetsgate.com/ViewPoem.aspx?id=63580",""],[5677,"بني عزيز ..!","https://www.poetsgate.com/ViewPoem.aspx?id=179980",""],[6034,"خطب ألم فسار في الآفاق","https://www.poetsgate.com/ViewPoem.aspx?id=169608",""],[6043,"مرثيّة الأرض العالقة","https://www.poetsgate.com/ViewPoem.aspx?id=215591",""],[6102,"دِيوانُ العَربِ...","https://www.poetsgate.com/ViewPoem.aspx?id=182739",""],[6138,"خل الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=207344",""],[5309,"لا تذرفا دمعا على فقدانه","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573555",""]],"verses":[["كَأَنَّ الوَسمَ شَعشَعَ فيهِ قَينٌ","بَجُذوَتِهِ عَلَطتُ بِهِ الفُؤادا",0,"د",2,0],["كَأَن الْوَغَى نَادَتْ بِهَا لِوَلِيمَةٍ","قَدِ احْتَفَلَتْ أَوْضَاعُهَا مُنْذُ أَزْمَانِ",1,"ن",1,0],["كانَ الوُشاةُ وَقَد مُنيتُ بِإِفكِهِم","أَسباطَ يَعقوبٍ وَكُنتُ الذيبا",2,"ب",2,0],["كَأَنَّ الوَلايا حينَ يَطرَحنَ فَوقَها","عَلى ظَهرِ بُرجٍ مِن ذَواتِ الصَوامِعِ",3,"ع",1,0],["كانَ الوَصِيَّةَ إِذ تَوَلّى غادِياً","غَدرُ الجِوارِ لَدى الإِلَهِ وَحوبُ",4,"ب",1,0],["كان الورى في حيرةٍ حتى أتى","بجليّ أخبارٍ دعاها من يعي",5,"ع",2,0],["كَأَنَّ الوَغى نارٌ كَأَنَّ جُنودَنا","مَجوسٌ إِذا ما يَمَّموا النارَ قَرَّبوا",6,"ب",3,0],["كَأَنَّ الوَغى نارٌ كَأَنَّ الرَدى قِرىً","كَأَنَّ وَراءَ النارِ حاتِمَ يَأدِبُ",6,"ب",1,0],["كَأَنَّ الوَغى نارٌ كَأَنَّ بَني الوَغى","فَراشٌ لَهُ مَلمَسُ النارِ مَأرَبُ",6,"ب",1,0],["كانَ الوِصالُ بُعَيدَ هَجرٍ مُنقَضٍ","زَمَنَ اللِوى وَقُبَيلَ بَينٍ آفِدِ",7,"د",1,0],["كَأَنَّ الوَديعِيِّنَ لَيلَةَ جِئتَهُم","هَوى بِهِمُ في غَمرِ مَسجورَةٍ جُرفُ",8,"ف",1,0],["كَأَنَّ الوَغى مَلهىً كَأَنَّ الرَدى هَوىً","كَأَنَّ الدَمَ الجاري شَرابٌ مُبَرَّدُ",9,"د",1,0],["كَأَنَّ الوَرسَ يَعلُوهُ","إِذا ما صَدرُهُ قاما",10,"م",2,0],["كانَ الوَصِيَّ إذا أَرَدْتُ وَصِيَّةً","وَالمُستَفادَ إذا طَلَبْتُ مُفيدا",11,"د",2,0],["كانَ الوليّ لعمري في كتابته","من الألى لصروح الوهم قد نسفوا",12,"ف",3,0],["كأن الورى الارحام لست تضيعها","على أسوة في الوصل بر ومجرم",13,"م",1,0],["كأنَّ الوجوهَ على ضَوئهِ","نلوحُ فتَحْسُنُ أو تَقبح",14,"ح",1,0],["كَأَنَّ الوَدِيعِييَّنَ لَيلَةَ جِئْتَهُمْ","هَوَى بِهمُ في غُمرِ مسجُورَةٍ جُرْفُ",15,"ف",1,0],["كان الوداد منغِّصا لوُشاتنا","ولو ارتموا ما بيننا بفواقرِ",16,"ر",1,1],["كانَ الوَحيدُ وَسارَ لَم يَترُك لَنا","ثَمَراً بِهِ يَنسى الحَزينُ مُصابَهُ",17,"ب",2,0],["كأن الورى يجرونَ طراً لغايةٍ","وقدْ دُحيتْ هذي البسيطة ميدانا",18,"ن",2,0],["كانَ الوضوءُ لِكُلِّ وَقتٍ دَأبَهُ","لَم يَجتَمِع لِوُضوئِهِ وَقتانِ",19,"ن",1,0],["كان الوَرى عدما وآدم لم يكن","فَدَعا النَبي بروحه روحيكما",20,"م",2,0],["كَأنّ الوغى نَيروزهم وَرَصاصهم","نثارٌ مِنَ العنَّابِ أَو ثمرُ الأرطى",21,"ط",2,0],["كَأنّ الوردَ في ورقٍ وزهرٍ","خدودُ معذّر عضّت بثغرِ",22,"ر",1,1],["كأنّ الوردَ مَحفوفاً بزهرِ","وَأوراقٍ منَ النارنجِ خضرِ",23,"ر",1,1],["كأنّ الوافدِينَ نُجومُ لَيلٍ","ورَحْبَ جَنابِه الفَلَكُ العليّ",24,"ي",1,0],["كأنّ الورى نالوا من المجدِ هَزْلَهُ","وأبقَوا لنا حتّى بلَغْناه جِدّه",25,"د",2,0],["كأنَّ الوُرْقَ حين بكت وأبكتْ","رَماها بالقطيعة من رماها",26,"ا",3,0],["كأنَّ الوجى سرٌّ تخاف انتشارَه","فمنها مُرِمٌّ بالتشاكي وبائحُ",27,"ح",1,0],["كَأَنَّ الوُفودَ المُبتَغينَ حِبائَهُم","عَلى فَيضِ مَدّادٍ مِنَ البَحرِ أَخضَرِ",28,"ر",1,0],["كأنّ الورى من حولِه قبلَ بعثِهم","دَعاهُم من الأجداثِ في يومِه الحَشْرُ",29,"ر",1,0],["كأن الوجود الخلق صار محقَّقاً","وأما الوجود الحق فهو خيال",30,"ل",1,0],["كانَ الوُجودُ مُسبِّباً لفنائِهِ","فغدا الفَناءُ مُسبِّباً لوُجودهِ",31,"د",2,0],["كَأَنَّ الوَرى كانوا أَهاليهِ جُملَةً","فَمَهما يَكُن مِن بائِسٍ فَهوَ كافِلُه",32,"ل",2,0],["كان الوصيُّ وكانت ابنةُ أحمدٍ","خيرَ البريّةُ كلِّها وابناهُما",33,"م",2,1],["كان الوثاق لها فعاد لخصمها","وغريمها الجبار وهو وثاق",34,"ق",1,0],["كأَنَّ الورى يستقبلونَ بوجهه","شِهابَيْنِ في مستقبل النهيِ والأمْر",35,"ر",1,0],["كأن الوغى قد صار في أنفس الورى","هياماً فمن يقتل يمت وهو هائم",36,"م",1,0],["كأَن الونى خِلّ يعزُّ فراقُه","وليس فِراقُ الخلّ أمراً مسلّما",37,"م",2,0],["كأَنَّ الوفودَ المبتَغينَ حِباءَهُم","عَلى فيضِ مدّادٍ من البَحرِ أَخضَرِ",38,"ر",1,0],["كان الوحيد ببيت اكرم والد","طابت ارومته وعزت محتدا",39,"د",2,0],["كَأَنَّ الوَرى جِسمٌ لَدَيكَ شِفاؤُهُ","وَأَمرُكَ في تَدبيرِهِ الروحُ وَالنَفسُ",40,"س",1,0],["كأن الوجود قد انهار في ال","فناء وقد غار يستعجل",41,"ل",1,0],["كأن الوغى لهو لديك فلم تسر","الى الحرب الا كنت مبتسما ثغرا",42,"ر",2,0],["كَأَن الوَرى يا آل يوسف دَوحة","وَأَنتُم لَها الزهر المفتح وَالوَرد",43,"د",1,0],["كأنّ الورى عينٌ وأنت ضياؤُها","فلا كان إلّا في بقاكَ مُرادُها",44,"د",3,0],["كانَ الوَحيدَ ولم يزل في مضجع","غيثُ المدامع والمراحم زارَهُ",45,"ر",2,0],["كانَ الوحيد له في كلِّ مكرُمَةٍ","زيادةٌ ما علمناها لمُزدَادِ",46,"د",1,0],["كأَنَّ الوُحُوشَ بِهِ عَسقَلا","نُ صادَفَ في قَرنِ حَجٍّ ديافا",47,"ف",2,0],["كأن ألوان الطواويس قد","أضحت عليها خلعاً تخلع",48,"ع",1,0],["كَأَنّ الوَفا مَعنىً وَقَلبيَ لَفظُه","وَربَّ النُهى فَهمٌ وَدَهري تعجُّب",49,"ب",1,0],["كَأَنّ الوفا في الناس خطٌّ معلقٌ","عَلى جبهة الدُنيا وَقد كُفَّ قارئه",50,"ا",2,0],["كأن الورى لما استطار نعيه","محا ويح أودى من لهم عنده رفد",51,"د",1,0],["كأن الوغى طرف له الجبل محجر","له النقع أكحال له الزان أميال",52,"ل",1,0],["كانَ الوئامُ يَعُمّنا","والصَّفْوُ في كَأْسٍ يدورْ",53,"ر",1,0],["كأن الوقت نيران","فمنها القلب يلتهب",54,"ب",1,1],["كأن الورد ..قبل لقاكِ غصنٌ","فيزهرُ حين يُروى من يديكِ",55,"ك",1,0],["كانَ الوَحِيدَ هُناكَ.. مُذ دَجَّى","لَيلٌ سَنَاهُ.. فَثَارَ واحتَجَّا",56,"ج",2,1],["كأن الورد حاكى وجنتيها","وغصن البان حاكاها قواما",57,"م",2,0],["كَانَ الْوَرَى ثَمَرَاً لَا شَوْكَ بَيْنَهُمُ","فَأَصْبَحُواْ الْيَوْمَ شَوْكَاً مَا بِهِ ثَمَرُ",58,"ر",1,1],["كأنَّ الوعد فى قلبى وُشومُ","أَوَعْدٌ أم وعيدٌ يا غشومُ",59,"م",1,0],["كأنّ الوجْد أرْداهُ طريحا ً","وراحَ يَطُبّهُ قلبٌ عميدُ",60,"د",1,0],["كأن الورى والموت نسي وراءهم","ذوات الأبا قد حازهن أباء",61,"ا",2,0],["كَأَنَّ الْوَرْدَ دُونَكِ دُونَ رُوحٍ","لِأَنَّكِ كُنْتِ لِلأَزْهَارِ عِطْرَا",62,"ر",2,0],["كأنّ الوردَ هامَ بها شَغوفا","وأبدى نارَ غيرتِهِ الهَيام",63,"م",1,0],["كأن الوفا ضرع مراه بكفه","فأنهل طه منه صفو المخالب",64,"ب",1,0],["كانَ الوجودُ يُحسُّ كنهَ وجوده","ويحسُّ أنكِ للجمال ختام",65,"م",1,0],["كأنّ الوقتَ نهرٌ من عذابٍ","يصبّ بنا إلى بئرٍ دفينِ",66,"ن",1,0],["كأنَّ الوردَ خَجْلةُ وجْنتيها","يضاهي الكونُ بالإصباحِ فاهَا",67,"ا",3,0],["كأَنَّ الوَطْءَ إِذْ زُجِرَتْ لَدَيْها","عَلَى جَمْرٍ يُذِيبُ الجِلْدَ حامِ",68,"م",1,0],["كان الولد فينا يضد القوم مااثناه الصواب","وقتٍ به العالم تهوج ولا يهود ارهابها",69,"ب",3,0],["كان الوجود به يزان كمثلما","زينت حسان الغيد بالأطواق",70,"ق",1,0],["كأنَّ الوهْمَ نفحةُ زعفرانٍ","تَذُرُّ على هزيمتِنا السكونا",71,"ن",2,0],["كانَ \"الوُجُومُ-الصَّمتُ\" طَقسَي ظُلمَةٍ","فارتَصَّ مِعراجٌ, وَصُفَّتْ أَنجُمُ",72,"م",1,0],["كان الوحيد وإن جاءت رسالته","ألفا وألفا بلا شك ولا ريب",73,"ب",1,0],["كانَ الوَرى يَهوى الحُروبِ لِغايَةٍ","لِفكرِيَّةٍ كضالذَّودِ عَن أَديانِهِ",74,"ن",2,0]]}