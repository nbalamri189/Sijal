{"poems":[[53,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[72,"لنا منكم وعد فهلا وفيتم","https://www.aldiwan.net/poem42722.html","الطويل"],[34,"وليت الرياح الهوج في ذات بيننا","https://www.aldiwan.net/poem27710.html","الطويل"],[87,"كبير السابقين من الكرام","https://www.aldiwan.net/poem63748.html","الوافر"],[82,"عذبت رقة قلبي","https://www.aldiwan.net/poem31559.html","المجتث"],[38,"","https://poetry.dctabudhabi.ae/diwan/poem/72210","الطويل"],[38,"","https://poetry.dctabudhabi.ae/diwan/poem/72204","الطويل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43754","الطويل"],[173,"دعوه فخير الرأي أن لا يعنفا","https://www.aldiwan.net/poem1639.html",""],[190,"سهرت وما مثلي ينام ويرقد","https://www.aldiwan.net/poem43910.html","الطويل"],[382,"أحن إلى الوادي المقدس رغبة","https://www.aldiwan.net/poem66892.html","الطويل"],[454,"صباحك عيد مشرف","https://www.aldiwan.net/poem974.html",""],[510,"الحساب","https://www.aldiwan.net/poem56767.html","الطويل"],[510,"أقلّوا","https://www.aldiwan.net/poem61087.html","الطويل"],[511,"لأشياع الفلاسفة اعتقاد","https://www.aldiwan.net/poem2407.html","الوافر"],[591,"صدودك هل له أمد قريب","https://www.aldiwan.net/poem17409.html","الوافر"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138386",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138441",""],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137612",""],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64117","المتقارب"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59425","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72280","الخفيف"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56629","الطويل"],[1689,"","https://poetry.dctabudhabi.ae/diwan/poem/36189","الوافر"],[1918,"","https://poetry.dctabudhabi.ae/diwan/poem/99058","الهزج"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104792","الطويل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104785","الطويل"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42436","الطويل"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42462","الطويل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109320","الوافر"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53048","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27620","الطويل"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/198648","الكامل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100883","الوافر"],[2851,"","https://poetry.dctabudhabi.ae/diwan/poem/105594","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100248","الوافر"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103407","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89385","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62832","المتقارب"],[3697,"","https://poetry.dctabudhabi.ae/diwan/poem/140286",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91110","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91703","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69952","الوافر"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77062","الطويل"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44677","الطويل"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78310","البسيط"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136874",""],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81279","الرمل"],[4679,"بذكراك لا ذكرى حبيبٍ ومنزلِ","https://www.poetsgate.com/ViewPoem.aspx?id=142719",""],[4755,"تَقُولُ الليالي الطِوَالْ:","https://www.poetsgate.com/ViewPoem.aspx?id=183545",""],[4830,"حذار","https://www.poetsgate.com/ViewPoem.aspx?id=194147",""],[4914,"بمن أتداوى والدوا معك وسدوا","https://www.poetsgate.com/ViewPoem.aspx?id=170940",""],[5106,"أُسَهَّدُ فِيْ تَذَكُّرِهِ وَأَرْضَى ..","https://www.poetsgate.com/ViewPoem.aspx?id=137167",""],[5273,"القوام يأتلق","https://www.poetsgate.com/ViewPoem.aspx?id=181461",""],[592,"ألا أيها الباغي طريقاً إلى الرشد","https://www.poetsgate.com/ViewPoem.aspx?id=128716",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5410,"ولادة","https://www.poetsgate.com/ViewPoem.aspx?id=141277",""],[5410,"هواجس على أسوار بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=152248",""],[5431,"بنت الشامِ","https://www.poetsgate.com/ViewPoem.aspx?id=183090",""],[5431,"وفؤادي مشعشعٌ لا أفولُ","https://www.poetsgate.com/ViewPoem.aspx?id=197691",""],[5463,"بيع أم المحبّه","https://www.poetsgate.com/ViewPoem.aspx?id=27212",""],[5477,"حمداً من ردّ أهل الزيغ والزلل","https://www.poetsgate.com/ViewPoem.aspx?id=124908",""],[5830,"أَسَاحِرَةَ العُيُونِ","https://www.poetsgate.com/ViewPoem.aspx?id=201193",""],[5943,"تعجَّلَ بالرحيلِ","https://www.poetsgate.com/ViewPoem.aspx?id=61825",""],[5956,"شعري يتغذَّى من شآبيبِ الخُلودْ","https://www.poetsgate.com/ViewPoem.aspx?id=186208",""],[6089,"النبي الخاتم","https://www.poetsgate.com/ViewPoem.aspx?id=213039",""]],"verses":[["فيأتي من العلياء والمجد ما أتى","كمقتحمٍ في غمرة وهو مُقْحَمُ",0,"م",1,0],["فَيا تارِكي أَنوي البَعيدَ مِنَ النَوى","إِلى أَيِّ قَومٍ بَعدَكُم أَتَيَمَّمُ",1,"م",1,0],["فَيأتيكُم مِنّا جَنُوبٌ مُطلةٌ","وَتأتينا هَيفُ العَشِيّ برودُ",2,"د",1,0],["فَيا تِلكَ اللَيالي لا تَعودي","وَيا زَمَنَ النِفاقِ بِلا سَلامِ",3,"م",1,0],["فيا تَشَوّقَ بُعْدي","إلى تَنَسّمِ قُربك",4,"ك",1,0],["فَيا تَوْبُ ما في العَيْشِ خَيْرٌ وَلا نَدىً","يُعَدُّ وَقَدْ أَمْسَيْتَ في تُرْبِ نَفْنفِ",5,"ف",1,0],["فَيا تَوْبَ للهَيْجا ويا تَوْبَ للنَّدى","ويا تَوْبَ لِلْمُسْتَنْبحِ المُتَنَوِّرِ",6,"ر",1,0],["فَيَأتي الهَوى حَتّى يَسُدَّ مَسامِعي","بُكاءُ حَمامٍ عَن غِناءِ قيانِ",7,"ن",1,0],["فَيا تارِكاً نَقلَ الأَحادِيثِ عَنهُمُ","وَيَنقُلُ أَخبارَ الأَوالي تَعَسُّفا",8,"ف",2,0],["فيأتون بالألواح يعطون هامتي","ومن دون هذا الفعل بات المبرد",9,"د",1,0],["فيا تائهاً برّاً وبحراً بغربةٍ","صريعاً وهو في فكره متموج",10,"ج",1,0],["فيا تبعات الحب لولاك لم تكن","لليلى ولا سلمى علي قيود",11,"د",1,0],["فيا تعسَ يومٍ عشتهُ مُتخيّلا","بأنّي نُصِرْتُ إذْ ملأتُ جيوبا",12,"ب",2,0],["فيا تعسَ مجْدٍ يسْتعيدُهُ حَبركُمْ","ليقضيَ في الخطابِ حُكماً مُؤبَّدا",13,"د",2,0],["فيأتون المناكر في نشاط","وياتون الصلاة وهم كسالى",14,"ل",2,0],["فَيَا تِلْكَ الذَّوائِب هَلْ صَبَاحٌ","فَلِي في لَيْلِكُنَّ أَسَىً مُذِيبُ",15,"ب",1,0],["فيا توفيق بالاجماع انا","نحيى فيك اقداما وعزما",16,"م",2,0],["فيأتى البعل يعبد في خشوع","وتلحقه العقيلة والصبيه",17,"ي",2,0],["فيأتي غلام ليأخذ منك","رسائل ما شئت في لمح نظره",18,"ر",2,0],["فيأتي الوعاءُ لها حاملاً","وتُحْسَبُ حاملةً للوعاء",19,"ا",2,0],["فيأتونه يدعونه يا محمد","أجرنا وهم بين باك وضارع",20,"ع",1,0],["فيأتون طرا نحو آدم سرعا","وأكبادهم مما دهاها تحسم",21,"م",1,0],["فيأتون طه لائذين وكلهم","ينادي بأعلى صوته يا مكرم",21,"م",1,0],["في اتكاءهم لا يرون لدى الجنة","شمساً كلا ولا زمهريرا",22,"ر",2,0],["فيأتيك منه كل زهر منثر","ويأتيك منه كل در منظم",23,"م",1,0],["فَيَأتيني مِنَ الصَّنعاءِ بَرقٌ","فَذكّرني بِهِ قُرب الدّيارِ",24,"ر",1,0],["فيأتون ببربازا","ر كالقفيا من المجري",25,"ر",2,0],["فَيَأتُونض لِلأَنبا غُمُوماً وَحُيَّرَا","وَكُلُّهُمُو نَفسِى يَقُولُونض لِلوَرَى",26,"ر",2,0],["فَيأتِيكَ يَومَ الدِّينِ لِلخَلقِ قائِداً","شَفِيعاً فَتُعطِيهِ الرِّضَا وَالوَسِيلَةِ",27,"ه",1,0],["فيأتي سليمَ القلبِ من غير نكثةٍ","يهزُّ قوام الرمحِ من دونهِ الحتفُ",28,"ف",1,0],["فيأتي إلى النزهاتِ قانصَ سبحةٍ","بيمناهُ والتلبيس مالئ به العُسرى",29,"ر",2,0],["فيا تعسا لقوم قد طغاهم","غبي ليس يدري ما الطهاره",30,"ر",2,0],["فيا تاركي ألقى العدو مسالماً","متى ساءني بالجد قمت ألاعبه",31,"ب",2,0],["فياتي وجودي للدعاوى بصورةٍ","تنزله مني كمنزلةِ الربِّ",32,"ب",1,0],["فيأتني تلك الغمام فبرّدت","من غُلّة كالنّار في إنضاجها",33,"ج",3,0],["فئاتٌ تبتغى بالدِّين رزقا","ودمع الدين يغمرهم سخينا",34,"ن",2,0],["فيأتي على رغم العذول حبيبه","يعود له بالوصل من بعد صده",35,"د",2,0],["فيا ترب العلوم ومن إذا ما","دُعي للعلم بادر بارتياح",36,"ح",1,0],["فيأتي على ما شئت من طُرقاته","قويم المعاني مستدرَّ الضرائب",37,"ب",1,0],["فيأتي محل الكلب من بعد طرده","ليُغسَلَ وجه بالتوضُّؤ وحلان",38,"ن",1,0],["فَيا تاجَ ملّةِ رَبِّ العِبا","دِ لا تاجَ مِلّةِ قَومٍ ظُهارا",39,"ر",2,0],["فيأتي نبي الله للرب ساجداً","فيثني بنعماء يجل ثناؤها",40,"ا",3,0],["فَيا تلك الطلول وَما عهدنا","سنقطع دوّها وَنَرى فجاجه",41,"ج",2,0],["فَيا تلك الأَحبةُ كَيفَ بِنّا","أَلَيسَ البينُ ذو خطبٍ يضير",42,"ر",1,0],["فَياتُرى مَن أَوَّرلاً وَآخِرا","أَبادَ مُذ زَفسُ تَوَلّى ناصِرا",43,"ر",2,0],["فَيَأتي بَعدَها فرجٌ قَريبُ","يبدد عَن رَجاءٍ لا يَخيبُ",44,"ب",1,0],["فَيا تَرى عوداً لِأَيّامِنا الَّتي","تَقَضَّت بِذاكَ الأُنسِ في ذلِكَ الجَمع",45,"ع",1,0],["فَيا تونساً عَفواً فَإِني مُقَصرٌ","وَلَستُ أَجيدُ اليَومَ في وَصفِكَ الشِعرا",46,"ر",2,0],["فَيا تَحيات برء شهدها بِفَمي","حلى مَرارَة تَسهيدي مِنَ القَلَق",47,"ق",1,0],["في اتفاقه عسى حالي بسهنته يقوى","يا صبا صله روه لي ولو ما يروى",48,"و",2,0],["فَيَأتِ مِن حُسنِها البَيت ظَلالا","سَكب الشعب عَلَيها ما سَكَب",49,"ب",1,0],["فيا ترب لبنان الذي كم أتيتهُ","وقاراً وإجلالاً أقبّل ما بلي",50,"ل",2,0],["فَيَأتِي الصَّدَى غارقًا","بأخبارِ قالت.. وقالْ",51,"ل",1,0],["فيا تعسا لما فعلوه ذنبا","وراء ظهورهم نبذوا الكتابا",52,"ب",2,0],["فيا تارك المعروف بعدك سنتي","بها يتعاطى الناس عبد وسيد",53,"د",1,0],["فَيَأتِينِيْ عَلَىْ وَجْدِيْ شَرُودَاً","أُلَمْلِمُهُ فَرَاشَاتٍ وَرَوْضَا",54,"ض",2,0],["في أتونِ نظرتِها","تَسْتَلِذُّني الحُرَقُ",55,"ق",1,0],["فيأت الذي يرضاه من كل مطلبٍ","ويجتنب النهى الذي كان لا يجدي",56,"د",2,0],["فيأتي بأنواع العبادة كلها","ويطلب ما لا يستطاع ويستجد",57,"د",1,0],["فيأتونه مشفعين لما دها","من الكرب أو مستعتب طالب غفرا",58,"ر",2,0],["فيا تعساً لمن تاه وأضحى","نزيل القهر يأسره اضطراب",59,"ب",1,0],["فيأتزروا بحسرتنا وتغزو","جحافلُهُم ثرانا أوتُريبُ",60,"ب",1,0],["فيا تجار عهد السوء كفوا","كفانا محنة من كل بابِ",61,"ب",1,0],["في اتساع وللرؤى يتجلى","نور قلبٍ وحكمة وسبيلُ",62,"ل",1,0],["فيا تشيله قلب حبّك وايدك تلامس إيديني","ولا بيع أم المحبّه دامها فيني قليله .. !",63,"ل",2,0],["فيا تنوف لقد حزت المفاخر إذ","أحييت دارس فخر الأعصر الأول",64,"ل",1,0],["فَيَأْتِي الطَّيْفُ فِي الأَحْلامِ يُحْيِي","جِرَاحَ الحُبِّ فِي شَوْقٍ تَمَادَى",65,"د",2,0],["فيأتي الصبحُ ينشرُ نورَ يومٍ","محا ما كانَ من أمسٍ ضبابا",66,"ب",2,0],["في اتحادٍ قد يفيدْ","أدبَ الدهرِ المَجيدْ",67,"د",1,0],["فيا تُرى أنت تدري أنها امرأةٌ","تحكي إليك وقلبٌ مرهفٌ هتفا",68,"ف",2,0]]}