{"poems":[[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[70,"لنا منكم وعد فهلا وفيتم","https://www.aldiwan.net/poem42722.html","الطويل"],[32,"وليت الرياح الهوج في ذات بيننا","https://www.aldiwan.net/poem27710.html","الطويل"],[85,"كبير السابقين من الكرام","https://www.aldiwan.net/poem63748.html","الوافر"],[80,"عذبت رقة قلبي","https://www.aldiwan.net/poem31559.html","المجتث"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72210","الطويل"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72204","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43754","الطويل"],[170,"دعوه فخير الرأي أن لا يعنفا","https://www.aldiwan.net/poem1639.html",""],[187,"سهرت وما مثلي ينام ويرقد","https://www.aldiwan.net/poem43910.html","الطويل"],[378,"أحن إلى الوادي المقدس رغبة","https://www.aldiwan.net/poem66892.html","الطويل"],[450,"صباحك عيد مشرف","https://www.aldiwan.net/poem974.html",""],[506,"الحساب","https://www.aldiwan.net/poem56767.html","الطويل"],[506,"أقلّوا","https://www.aldiwan.net/poem61087.html","الطويل"],[507,"لأشياع الفلاسفة اعتقاد","https://www.aldiwan.net/poem2407.html","الوافر"],[587,"صدودك هل له أمد قريب","https://www.aldiwan.net/poem17409.html","الوافر"]],"verses":[["فيأتي من العلياء والمجد ما أتى","كمقتحمٍ في غمرة وهو مُقْحَمُ",0,"م",1,0],["فَيا تارِكي أَنوي البَعيدَ مِنَ النَوى","إِلى أَيِّ قَومٍ بَعدَكُم أَتَيَمَّمُ",1,"م",1,0],["فَيأتيكُم مِنّا جَنُوبٌ مُطلةٌ","وَتأتينا هَيفُ العَشِيّ برودُ",2,"د",1,0],["فَيا تِلكَ اللَيالي لا تَعودي","وَيا زَمَنَ النِفاقِ بِلا سَلامِ",3,"م",1,0],["فيا تَشَوّقَ بُعْدي","إلى تَنَسّمِ قُربك",4,"ك",1,0],["فَيا تَوْبُ ما في العَيْشِ خَيْرٌ وَلا نَدىً","يُعَدُّ وَقَدْ أَمْسَيْتَ في تُرْبِ نَفْنفِ",5,"ف",1,0],["فَيا تَوْبَ للهَيْجا ويا تَوْبَ للنَّدى","ويا تَوْبَ لِلْمُسْتَنْبحِ المُتَنَوِّرِ",6,"ر",1,0],["فَيَأتي الهَوى حَتّى يَسُدَّ مَسامِعي","بُكاءُ حَمامٍ عَن غِناءِ قيانِ",7,"ن",1,0],["فَيا تارِكاً نَقلَ الأَحادِيثِ عَنهُمُ","وَيَنقُلُ أَخبارَ الأَوالي تَعَسُّفا",8,"ف",2,0],["فيأتون بالألواح يعطون هامتي","ومن دون هذا الفعل بات المبرد",9,"د",1,0],["فيا تائهاً برّاً وبحراً بغربةٍ","صريعاً وهو في فكره متموج",10,"ج",1,0],["فيا تبعات الحب لولاك لم تكن","لليلى ولا سلمى علي قيود",11,"د",1,0],["فيا تعسَ يومٍ عشتهُ مُتخيّلا","بأنّي نُصِرْتُ إذْ ملأتُ جيوبا",12,"ب",2,0],["فيا تعسَ مجْدٍ يسْتعيدُهُ حَبركُمْ","ليقضيَ في الخطابِ حُكماً مُؤبَّدا",13,"د",2,0],["فيأتون المناكر في نشاط","وياتون الصلاة وهم كسالى",14,"ل",2,0],["فَيَا تِلْكَ الذَّوائِب هَلْ صَبَاحٌ","فَلِي في لَيْلِكُنَّ أَسَىً مُذِيبُ",15,"ب",1,0]]}