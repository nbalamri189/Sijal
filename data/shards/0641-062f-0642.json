{"poems":[[53,"أبا الحسين وأنت المليك","https://www.aldiwan.net/poem61822.html","المجتث"],[12,"ألا أم عمرو أجمعت فاستقلت","https://www.aldiwan.net/poem1205.html",""],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[35,"يقول لي الواشون ليلى قصيرة","https://www.aldiwan.net/poem25756.html","الطويل"],[240,"ياابن الدوامي الذي","https://www.aldiwan.net/poem32128.html","مجزوء الكامل"],[505,"هذا الوجود على مجلاك إيماء","https://www.aldiwan.net/poem38106.html","البسيط"],[556,"يوم الحمى ما أنت من همي","https://www.aldiwan.net/poem47212.html","أحذ الكامل"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46512","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46518","الرجز"],[3394,"","https://poetry.dctabudhabi.ae/diwan/poem/123896","الطويل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112352","المتدارك"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86340","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111496","البسيط"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105516","الوافر"],[4461,"","https://poetry.dctabudhabi.ae/diwan/poem/116091","الرجز"],[5271,"ومنْ نورِ وجهُكِ صُبحي انفَلَقْ !!","https://www.poetsgate.com/ViewPoem.aspx?id=59741",""],[5997,"الغَرَّاْءُ","https://www.poetsgate.com/ViewPoem.aspx?id=214276",""]],"verses":[["فدق كلُّ جليل","لحسن وجهك وَحْدَهْ",0,"د",2,0],["فَدَقَّت وَجَلَّت وَاِسبَكَرَّت وَأُكمِلَت","فَلَو جُنَّ إِنسانٌ مِنَ الحُسنِ جُنَّتِ",1,"ت",1,0],["فَدَقَّ بابَ أَبي جَهلٍ فَجاءَ لَهُ","طَوعاً يَجُرُّ عِنانَ الخائِفِ الزَّرِمِ",2,"م",1,0],["فَدَقَّ صِلابَ الصَخرِ رَأسَكَ سَرمَداً","فَإِنّي إِلى حينَ المَماتِ خَليلُها",3,"ل",3,0],["فَدَقائِقٌ بَيني وَبَي","نَكَ في المَسافَةِ لا دَرَج",4,"ج",1,0],["فدقَّها وارِدُ الإنْذارِ فانْكشفتْ","بالقبضَتَيْنِ فَخُلاَّنٌ وأَعداءُ",5,"ا",2,0],["فَدقيقُهنَّ جَليلهنَّ غداً","وَمنَ الأفيل مَنابتُ القرمِ",6,"م",1,0],["فَدَقَّها في هاون وَبلها","بِلَبن الكَلب يَريد حَلَّها",7,"ه",2,0],["فدقه مِن وَقتِهِ وَافترسه","وَيح أَبيه صائِداً ما أَكيسه",8,"ه",1,0],["فدقيوس تلميذي عليكم خليفتي","رضيت به في الهزل بعدي وفي الجد",9,"د",1,0],["فدقّت على الصّدرِ عند المساء","فما كان إِلا كوقعِ الصّدى",10,"د",2,0],["فَدَقَّت صَدرها غَيظاً وَقالَت","معاذَ اللَهِ من هذا وحاشا",11,"ش",2,0],["فَدَقَّ هامَتَهُ مِن تَحتِ خُوذَتِهِ","فَغائِصاً مِن عَلى البُرجِ المَتينِ وَقَع",12,"ع",1,0],["فدق علاك عن تكييف حد","فيا من جل عن شبه وند",13,"د",1,0],["فَدَقَّ أَن يُدرَك بِالأَفهَام","فلو أتاهُ طَارقُ الحمَامِ",14,"م",1,0],["فدقاتُ قلبي تموجُ بصدري","ونبضِيَ فيكِ كلاماً نَطَقْ !!",15,"ق",1,0],["فَدَقَّتْ طُبُوْلُ الْحَرْبِ سَبْعِيْنَ يَوْمَهَا","وَحَاْزَتْ قُوَىٰ صَنْعَاْءَ نَصْرَاً جِزَاْفِيَا",16,"ف",3,0]]}