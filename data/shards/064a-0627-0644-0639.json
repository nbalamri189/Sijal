wPoem.aspx?id=156552",""],[5431,"لاتلومي تعلّقي بالرجالِ....","https://www.poetsgate.com/ViewPoem.aspx?id=200455",""],[5431,"بروازٌ مهشم!","https://www.poetsgate.com/ViewPoem.aspx?id=202618",""],[5431,"ماكيافيلي والحصاد...","https://www.poetsgate.com/ViewPoem.aspx?id=205414",""],[5573,"يارب ترزقني الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=204513",""],[5652,"حالة فراق ..!","https://www.poetsgate.com/ViewPoem.aspx?id=136926",""],[5652,"جرح غازي","https://www.poetsgate.com/ViewPoem.aspx?id=174656",""],[5652,"تفاحة نيوتن","https://www.poetsgate.com/ViewPoem.aspx?id=208680",""],[5725,"أقل العثرة","https://www.poetsgate.com/ViewPoem.aspx?id=213611",""],[5877,"يا عامي الماضي","https://www.poetsgate.com/ViewPoem.aspx?id=37469",""],[5956,"صور أشواق زوجتي إليّ","https://www.poetsgate.com/ViewPoem.aspx?id=182397",""],[5956,"إني بالاستمتاع أبقى جاهلا","https://www.poetsgate.com/ViewPoem.aspx?id=183947",""],[5969,"الشَبَحْ","https://www.poetsgate.com/ViewPoem.aspx?id=198818",""],[5976,"أنشودة التيه","https://www.poetsgate.com/ViewPoem.aspx?id=30346",""],[6115,"يالعاقل اصبر للزلل","https://www.poetsgate.com/ViewPoem.aspx?id=180454",""],[5309,"عزلوا الكفء من الحصن الحصين","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573825",""],[463,"قد قنعنا أن نرقبَ الأحلاما","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60324&r=&rc=380",""],[463,"من ناظرٌ لي بين سلعٍ وقباَ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59981&r=&rc=37",""],[6277,"لعنة الخمسين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64499&r=&rc=62",""]],"verses":[["ى العلا ويردّني","عجزي وإن العجز مردّي",0,"د",2,0],["يا لعهد الصبا تقضي وشيكا","بين أهل فارقتهم غير سال",1,"ل",1,1],["يَا لَعَزْمِي مِنَ الأَسَى وَلِحِلمِي","أَسْعَدانِي عَلَى الْخُطُوبِ الغَوَاشِمْ",2,"م",1,0],["يا لَعَينٍ سَهرت عَن فَيصَلٍ","تَحرس الملكَ لَهُ ما تَأتلي",3,"ل",2,0],["يا لعيون هجعت","لأعين لم تَهجَع",4,"ع",1,0],["يا لُعبَ لَو كُنتِ تَفهَمينَ لَحَدَّ","ثتُكِ ما كانَ هَيَّجَ الغَضبا",5,"ب",2,1],["يا لَعاري فليت لي بين قومي","بطلاً يكشِفُ الشدائدَ جَلْدا",6,"د",2,0],["يالَعصفورة تحدث نسورا","فشأنهم في حَلْبة الطيران!",7,"ن",1,0],["يا لعمر ناصبته آفة","تهدم المحيا وتزري بالحيل",8,"ل",1,0],["يا لعمر ناصبته آفة","تهدم المحيا وتزري بالحبل",9,"ل",1,0],["يا لعنة الخمسين قدك إنني","ما زلت رغم ذكائه المتغابي",10,"ب",2,0],["يا لعمري لقد مضى عمري","وتقضى وما انقضى عتبي",11,"ب",2,0],["يا لعقل محلّق كان لا يح","فِل إلا بالخلق والمعجزات",12,"ت",1,0],["يا لعمر أفناه لم يك إلا","خفقة في جوانح النسمات",12,"ت",1,0],["يا لَعَنَ اللَهُ جيفةً نَجساً","يَقرَعُ من بُغضِهِ ثناياهُ",13,"ا",2,0],["يآل عُبادٍ دَعوَةٌ بَعدَ هَجمَةٍ","فهل منكُمُ من قوة وزمَاعِ",14,"ع",1,1],["يا لعهدٍ مضى وعيش رغيد","واقتبال من الزمان سعيد",15,"د",1,1],["يالَ عبد الريم أحصدتُمُ لي","سببا كان في سواكم رماما",16,"م",2,0],["يا لُعبَةً مِنَ جَوهَرٍ شَفّافٍ","وَقَضيبَ بانٍ ناعِمَ الأَطارفِ",17,"ف",1,1],["يالعارف بالله","فك لي هذا الكلم",18,"م",1,0],["يا لعنة صارت على","أعناقهم طوق الحمامه",19,"م",2,0],["يال عيسِ الحيِّ من كاظمةٍ","حينما الرَّكب جرى ينطلقُ",20,"ق",1,0],["يا لَعَمْري فَنيتُ والقومُ صرعَى","فكأَنِّي جَنَيْتُ وحدِي جُرْمَا",21,"م",2,0],["يا لَعنةَ اللهِ اسكُني في قَبرِه","فالرِّيحُ رِجسٌ والِفعالُ فُجورُ",22,"ر",1,0],["يا لعهدٍ فيهِ كيبرُ أمسى","قرب بولاق يلفظ الروح كربا",23,"ب",2,0],["يا لعادين لم يكن منهم خا","شٍ ولا كان فيهمُ مَنْ تخاشى",24,"ش",2,0],["يا لعبةَ الجلساءِ يا رَامُشْنَةَ الن","دماءِ إن سكروا وإن لم يسكروا",25,"ر",3,0],["يا لِعَينَيكِ وَيا لي","بِهِما جُنَّ جُنوني",26,"ي",1,0],["يا لعقْدٍ جوهريٍّ مشرق","كحروف من بلوغ الأمل",27,"ل",1,0],["يا لَعَنَ اللَهُ قَوماً أَنتَ سَيِّدُهُم","في جِلدَةٍ بَينَ أَصلِ الثَيلِ وَالذَنَبِ",28,"ب",1,0],["يا لعمري بعدهم كم رعفا","جفني الراعي نجوم الغلسِ",29,"س",1,0],["يا لعقد في وصفه نتبارى","فيرينا مثال عيّ البيان",30,"ن",1,0],["يا لعمري وليس فيه قواه","وهو يقوي بنا على كل ضر",31,"ر",1,0],["يا لعبة صورت لسفك دمي","غطي بفضل النقاب محجرك",32,"ك",1,0],["يا لعصر الآلاتِ فيه غدا","دمُ أزكى الصفات مسفوحا",33,"ح",2,1],["يا لعمري كل النبات الذي في ال","كون من زهره إِلى لبلابه",34,"ب",2,0],["يالعينين تلك باردة الما","ء وهذي لمائها حرنار",35,"ر",1,0],["يا لعيارة تقصر للعا","شق بالظرف والنوادر يومه",36,"ه",1,1],["يا لعمري هل اليها من رجوع","اين اين الربع ثمَّ الملتقى",37,"ق",2,0],["يا لعين الزَرقاء يَطفو حُبابُ ال","كَأسِ مِنها خَمراً بِلطف حُبابِه",38,"ب",2,0],["يا لعنة الرحمن جل جلاله","حلي به وبحيه وبميته",39,"ت",2,0],["يا لعمر كهرباء عدوه","كيف يمضي تاركا نورا جميلا",40,"ل",2,0],["يالعرب دارت علينا رحى حرب البسوس","والزمان الاقشر اشّر علينا باصْبعه",41,"ع",2,1],["يا لعيني عاشق لم تبقيا","منه سرا فاضحات أن دنا",42,"ن",2,0],["يا لعينيَّ تهامى دمعها","كلَّما لاح بوجه الشرق صبحْ",43,"ح",1,0],["يالعقاب اللي على المشراف وسع لي ...تراني","ضايق (ن) من عاما الاول وادهله قبلك ...وادله",44,"ل",2,1],["يا لعنةً ..نزلتْ ..في حاملي لغةً","اللهُ حافظُها ..والذِّكرُ ..والحِقَبُ ....",45,"ب",1,0],["يالعزّ لك سيف ٍ على الذلّ سلّه","لا ينكسر سيفك ترى الذلّ ينحرك",46,"ك",1,0],["يالعنبو جدّه حرم عيني النوم","ليني على المسحوب همّي نظمته",47,"ت",2,0],["يا لعمري .. والأماني أصبحت","طوع أمري ولقلبي ما نوى",48,"و",2,0],["يَا لعَصْرٍ مَرَّ لَمْحًا وصَرْحٍ","خَرَّ مِنْ شَاهِقِ عَيْنَيَّ وانْدَكْ",49,"ك",1,0],["يالعنبوا نفس تنسى فضل مرضعها","ويالعنبوا من يخلي الجار والعاني",50,"ن",2,0],["يا لعود يحاضن الطير والزهر","بخود والكوكب الدريا",51,"ي",2,0],["يا لعقليتين، خلفا يساري،","دون خلف، تعارف الأرواح",52,"ح",1,0],["يالعشقٍ مولّهٍ ليس أحلى","لثم فاهٍ موّلعٍ بالنضالِ",53,"ل",1,0],["يالعنة الشرقيّ لاتتورعي!","من قلب هيبته إلى اشمئزاز!!",54,"ز",1,0],["يالعارٍ ممرغٍ في شفاه","تدّعي حضن عابثٍ لك حصنا",55,"ن",2,0],["يالعبد لاينقص ايمانك","لو طول القيض بالكنه",56,"ن",2,0],["يالعنبوها عيشة(ن) تجلب طعون","ويالعنبو حظ(ن) على الدرب ساقك !!",57,"ك",1,0],["يالعنبوا حي المشاعر لو تشوف","اشواقنا وشلون فيها احتزازي",58,"ز",2,0],["يالعنبوها ،، ماهواني سواها","ولا هويت الا ( غلا ) باشة الغيد",59,"د",1,0],["يا لعشرين مضت في حبكم","ليت شعري هل لها من عودةِ",60,"ه",1,0],["يالعام فالي من دواعي اعتزازي","جعلك تفزّ بكل من زان دينه",61,"ن",2,0],["يا لَعينيك اللتين صاغتا","خيرَ أحلامٍ كستْ عينَيْ بشرْ",62,"ر",1,0],["يا لعنة المولى عليهم خَبَّري","ما دمَّروه بخافقي فَثَعَنْجَرا..",63,"ر",2,0],["يا لَعنَةَ تَبقى لِتَحفَظَ نَفْسَها","لَوْ أَنَّها تَفنى ولا تَتَكررُ",64,"ر",1,0],["يا لعنبو ابليسك ترى الحب قتّال","لا ني قدرت احياه .. أو ميّت ٍ فيه .. !!",65,"ي",2,0],["يالعاقل اصبر للزلل مادام جاريت السفيه","حيث السفيه ان جيت تبغي ترفعه يرجع ورى",66,"ر",2,1],["يا لَعَصرٍ فَضَحَت آياتُهُ","هَذرَ أَربابِ النُّفوذِ المُفسِدين",67,"ن",1,0],["يالَ عبد الرحيم أحصدتمُ لي","سببا كان في سواكم رماما",68,"م",2,0],["يا لعبدٍ من منى ً دنا به","يوهمني الصدقَ بريقٌ كذبا",69,"ب",2,0],["يا لعنة الخمسين قدك ، فإنّني","ما زلت رغم ذكائه المتغابي",70,"ب",2,0]]}