{"poems":[[55,"صدت وما كان لها الصدود","https://www.aldiwan.net/poem30527.html","الرجز"],[87,"ليلة الأمس قد ذهبت","https://www.aldiwan.net/poem6833.html","الخفيف"],[68,"وليلة طال سهادي بها","https://www.aldiwan.net/poem38644.html","السريع"],[33,"قل للمنازل بالظهران قد حانا","https://www.aldiwan.net/poem41273.html","البسيط"],[104,"طير الصبا ولى","https://www.aldiwan.net/poem33019.html","منهوك الرجز"],[77,"إمسحوا عن ناظري كحل السهاد","https://www.aldiwan.net/poem69087.html","الطويل"],[52,"علليني يا عبد أنت الشفاء","https://www.aldiwan.net/poem64888.html","الخفيف"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/24684","البسيط"],[119,"ريم زها جماله","https://www.aldiwan.net/poem40603.html","عموديه"],[161,"نَعْيُ حَيٍّ","https://www.aldiwan.net/poem23653.html","الخفيف"],[190,"قلت نصيحة من تشاور","https://www.aldiwan.net/poem43878.html","مجزوء الكامل"],[354,"أقبل صبحي وسفر","https://www.aldiwan.net/poem15721.html","مجزوء الرجز"],[545,"تقول والعيس قد شدت بأرحلنا","https://www.aldiwan.net/poem56630.html","البسيط"],[949,"","https://poetry.dctabudhabi.ae/diwan/poem/124748","الرجز"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109187","السريع"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109708","السريع"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106995","الرجز"],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84531","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204649","الخفيف"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87408","الرجز"],[3536,"","https://poetry.dctabudhabi.ae/diwan/poem/20619","البسيط"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85020","السريع"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202345","الخفيف"],[4830,"ياصَبيَّهْ","https://www.poetsgate.com/ViewPoem.aspx?id=210819",""],[4883,"غيرة أطفال","https://www.poetsgate.com/ViewPoem.aspx?id=48396",""],[5587,"شيان حالي","https://www.poetsgate.com/ViewPoem.aspx?id=210594",""],[5606,"الثقه متبادله بين الثقات","https://www.poetsgate.com/ViewPoem.aspx?id=196664",""],[6056,"أزرق الدمع بعيوني","https://www.poetsgate.com/ViewPoem.aspx?id=130134",""]],"verses":[["قُلتُ نَعَم ذاكَ الَّذي أُريدُ","مَضى حَبيبٌ قَلَّما يَعودُ",0,"د",1,0],["قلت نرجو من ناظر العدل يُص","يه بأسيوط مبعدا منفيا",1,"ي",2,0],["قُلتُ نَعَم قالَ وَفي قَهوَةٍ","عَتَّقَها العاصِرُ مِن عَهدِ عاد",2,"د",1,0],["قُلتُ نَعَم قالَ وَفي مُطرِبٍ","إِذا شَدا يَطرَبُ مِنهُ الجَماد",2,"د",1,0],["قُلتُ نَعَم قالَ وَفي طَفلَةٍ","في وَجنَتَيها لِلحَياءِ اِتِّقاد",2,"د",1,0],["قُلتُ نَعَم قالَ وَفي شادِنٍ","قَد كُحِلَت أَجفانُهُ بِالسَواد",2,"د",1,0],["قُلتُ نَعَم فَقالَ نَم آمِناً","يا كَعبَةَ الفُسقِ وَرُكنَ الفَساد",2,"د",1,0],["قُلتُ نَعَم فَأَبيني في مُحاوَرَةٍ","وَحَدِّثيني حَديثَ الرَكبِ مَن كانا",3,"ن",2,0],["قلتُ نعم حتما","وشاب أحبابي",4,"ي",1,0],["قَلَّ تَنْويلُ خَيالٍ مِنكُمُ","يَطَّبي بين جفونٍ وسُهاد",5,"د",1,0],["قُلتُ نَفسي الفِدا عَلى عادَةٍ مِن","ني جَرى ما جَرى وَقَلبي بَراءُ",6,"ا",2,0],["قلت نكها فإنها","فقحة تعرف اللغه",7,"غ",2,0],["قلت نعم اني امروءٌ","تيمه غزاله",8,"ل",2,0],["قُلْتُ :نَفْسِي بالاسْتِقَامَةِ سِيِرِي","واسْتَعِيذِي مِنَ المَهَالِكِ أسْلَمْ",9,"م",1,0],["قلت نصيحة من تشاور","فأبى الصواب على المشاور",10,"ر",1,1],["قُلتُ نَعَم في الهِندِ أَج","يالٌ وَفي التَركِ نَفَر",11,"ر",1,0],["قُلتُ نَعَم فاكظُمي قالَت وَماجَلَدي","وَما أَظنُّ اِجتِماعاً حينَ نَفتَرِقُ",12,"ق",1,0],["قلت نعم أشفى بدا أمراضى","يا حبذا ان كنت أنت راضى",13,"ض",2,0],["قلت نعم مذ كان في رأسه","لكن دبَّ إِلى رجله",14,"ل",2,0],["قلت نعم يا قوم نعم الذي","قلتم ولكن جهله اقبح",15,"ح",1,0],["قلت نعم هذا أوان قطفه","فقد بدا ريان حلواً ممتلي",16,"ل",2,0],["قلتني الغواني بل سلتني بنارها","فَما زلت من وَجدي لها أَتملق",17,"ق",1,0],["قلت نهجي نهج الهوى قال نكب","مسرعا عنه فهو نهج مخوف",18,"ف",1,0],["قُلتُ نعم قالَ وهل","من أَملٍ قُلتُ أَجل",19,"ل",1,0],["قُلتُ نَعَم فَاِكظَمى قالَت وَما جَلَدي","وَلا أَظُنُّ اِجتِماعاً حينَ نَفتَرِقُ",20,"ق",1,0],["قُلتُ نَعَم قالَ وَفي قُبلَةٍ","في شِفَةٍ تَشفي جَميعَ السَقامِ",21,"م",1,0],["قُلتُ نَعَم قالَ وَفي خَمرَةٍ","حَلَّت بِجامِ الثَغرِ لَيسَت حَرامِ",21,"م",1,0],["قُلتُ نَعَم قالَ وَفي َمَّةٍ","في غَفلَةِ الواشي وَأَهلُ المَلامِ",21,"م",1,0],["قُلتُ نَعَم قالَ وَفي كُلَّ ما","تَرومُ في قَدّي رَشيقَ القَوامِ",21,"م",1,0],["قُلتُ نَعَم فَطِب مَسمَراً","وَاِشطَح بِمَن تَهواهُ يا اِبنَ الكِرامِ",21,"م",1,0],["قلت نفسي لك الفداء وان أذ","هلت قلبي قدا ودلاً ولحظا",22,"ظ",2,0],["قلتُ نحوي أقبلي هاتيكَ روحي","عِوَضٌ عنهُ ولو فيها المنيَّهْ",23,"ي",2,0],["قلت: نعنَاعهَا المَخْبوء خَلف الحَنَان","قَال : وإلا الحَنان .. اشبه بمصروفنَا!",24,"ن",2,0],["قُلْتْ نَرْتَاحْ يَا غْزَالِي","لْقِيتْ الغُرْبَة هِيَ هِيَّا",25,"ي",2,0],["قلت ناولني الرساله وأفتليها","أثر راعيها موصي توصيات",26,"ت",1,0],["قلت نقعد ننتظر..! أحد ٍ يجي فينا ومناّ","قالت اسكت تدري ماغيرك أحد فيني ومنيّ",27,"ن",2,0]]}