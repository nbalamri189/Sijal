{"poems":[[29,"ما بال جهلك بعد الحلم والدين","https://www.aldiwan.net/poem4437.html","البسيط"],[29,"حي المنازل بالأجزاع فالوادي","https://www.aldiwan.net/poem5722.html","البسيط"],[29,"يا عقب لا عقب لي في البيت أسمعه","https://www.aldiwan.net/poem5755.html","البسيط"],[91,"اني افكر في الطبيعة فاحصا","https://www.aldiwan.net/poem44850.html","الكامل"],[82,"يا عقرب الصدغ المعنبر طيبها","https://www.aldiwan.net/poem31219.html","الكامل"],[46,"أحسن بأيام العقيق وأطيب","https://www.aldiwan.net/poem30589.html","الكامل"],[107,"ودع ذويك وسر في شأنك الجلل","https://www.aldiwan.net/poem44046.html","البسيط"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43692","المديد"],[358,"تب يا لحاك الله من خادع","https://www.aldiwan.net/poem40575.html","السريع"],[457,"يا عقلة حنت إليك حشا","https://www.aldiwan.net/poem13834.html","مجزوء الكامل"],[458,"الأربعون صدى فؤادي الدامي","https://www.aldiwan.net/poem61769.html","الكامل"],[463,"لمن الظعن تهتدي وتجور","https://www.aldiwan.net/poem56178.html","الخفيف"],[471,"أمسى الشباب مودعا محمودا","https://www.aldiwan.net/poem50445.html","الكامل"],[563,"يا عقل كم منك قلة الأدب","https://www.aldiwan.net/poem34932.html","المنسرح"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79985","الخفيف"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105428","البسيط"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28539","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204474","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200184",""],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112567","الرمل"],[3560,"","https://poetry.dctabudhabi.ae/diwan/poem/117144","الرمل"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101234","الخفيف"],[3763,"","https://poetry.dctabudhabi.ae/diwan/poem/124151","البسيط"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107494","الخفيف"],[4137,"","https://poetry.dctabudhabi.ae/diwan/poem/136847",""],[5055,"سواري الليل","https://www.poetsgate.com/ViewPoem.aspx?id=103418",""],[585,"هي رحلةُ قد أرهقتك ذميلا","https://www.poetsgate.com/ViewPoem.aspx?id=161880",""],[5106,"يَا مِسْكَةَ العَرَبِ ..","https://www.poetsgate.com/ViewPoem.aspx?id=154846",""],[5111,"الفهري","https://www.poetsgate.com/ViewPoem.aspx?id=212044",""],[5186,"حسبك الجهد بذله لا تزيدي","https://www.poetsgate.com/ViewPoem.aspx?id=156491",""],[5717,"فالقول بالعدل أساس يبتنى","https://www.poetsgate.com/ViewPoem.aspx?id=170603",""],[5747,"شوق شما","https://www.poetsgate.com/ViewPoem.aspx?id=61618",""],[5830,"سَلِي العُرُوبَةَ","https://www.poetsgate.com/ViewPoem.aspx?id=200822",""],[5901,"العقود الأربعة","https://www.poetsgate.com/ViewPoem.aspx?id=204927",""],[5956,"الزوجُ أهمُّ شُغل ‏","https://www.poetsgate.com/ViewPoem.aspx?id=182373",""]],"verses":[["يا عُقبَ إِنّي مِنَ القَومِ الَّذينَ لَهُم","نُعمى عَلَيكَ وَفَضلٌ غَيرَ مَمنونِ",0,"ن",1,0],["يا عُقبَ يا اِبنَ سُنَيعٍ لَيسَ عِندَكُمُ","مَأوى الرِفادِ وَلا ذو الرايَةِ الغادي",1,"د",2,0],["يا عُقبَ يا اِبنَ سُنَيعٍ بَعدَ قَولِكُمُ","إِنَّ الوِثابَ لَكُم عِندي بِمِرصادِ",1,"د",1,0],["يا عُقبَ لا عُقبَ لي في البَيتِ أَسمَعُهُ","مَن لِلأَرامِلِ وَالأَضيافِ وَالجارِ",2,"ر",1,1],["يا عُقبَ لا عُقبَ لي في اليَومِ أُسمِعُهُ","إِلّا ثَوِيَّةُ رَمسٍ بَينَ أَحجارِ",2,"ر",1,0],["يا عقل مالك في شكوكك سائخا","هل فال منك الرأي بعد سداد",3,"د",1,0],["يا عَقْرَبَ الصدغِ المعنبرِ طيبها","قلبي لَسَبْتِ فأين مَنْ يرقيكِ",4,"ك",1,1],["يا عَقبَ طَوقٍ أَيُّ عَقبِ عَشيرَةٍ","أَنتُم وَرُبَّتَ مُعقِبٍ لَم يُعقِبِ",5,"ب",1,0],["يا عُقْبَةُ اصْدَعْ بها بيضاءَ ناصِعَةً","تَنْفي الوَساوِسَ أو تَشفي من الغُلَلِ",6,"ل",1,0],["يا عُقاب المَوتِ حُمت عَلى","عَقِبي فَاِنحَلَّتِ العُقَدُ",7,"د",1,0],["يا عَقرب المكر مَتى تَلدغي","نَعلي لِأَمر ما بِها تضربي",8,"ب",2,0],["يا عقلة حنَّتْ إليك حشا","ي من بين الضلوعِ",9,"ع",1,1],["يا عقلُ لا تفكر فذاك ضلالةٌ","واخسأ وياعينَ الحبيب تَعامى",10,"م",2,0],["يا عقيدي على الغرام بليل","قم وفيّاً وغيرك المأمورُ",11,"ر",1,0],["يا عُقبَ قَد شَذَبَ اللِحاءَ عَنِ العَصا","عَنّي وَكُنتُ مُؤَزَّراً مَحمودا",12,"د",2,0],["يا عقل كم منك قلة الأدبِ","في الله فاسجد إليه واقتربِ",13,"ب",1,1],["يا عقيدي على الجوى كبر الخط","بُ فأهون بالدمعة البيضاء",14,"ا",2,0],["يا عقر اللَه تلك الخيل إذ جعلت","أعضاءه لعواديها مضاميرا",15,"ر",2,0],["يا عَقلُ ما لَكَ في اللَّطائِفِ مَنهَجٌ","فَلإِن عَثَرتَ فَلا لَعاً لِلنَّاعِسِ",16,"س",1,0],["يا عقل إنك كالجناح قصيرةً","تدعو ولما تكفِ للطيران",17,"ن",1,0],["يا عقل في جسمي سُجنتَ فأصبحت","لك تلزم الأذنان والعينان",17,"ن",1,0],["يا عقرباً جاءت لتلدغني","والطبعُ منها بالأذى حاكم",18,"م",1,1],["يا عقودا فوق أجياد الحسان","ارحميني",19,"ي",1,0],["يا عقابَ الدجنِ في الأَم","نِ وفي الخوفِ ابنُ ماءِ",20,"ا",2,0],["يا عقولاً بالجهل يعبث فيها","من بني الدهر سائس ومسوس",21,"س",1,0],["يا عقرب الصدغ في الخد الأسيل أما","لمن لبست شفاء منك أوراقي",22,"ق",2,0],["يا عقولَ الأنامِ ما","زلتِ في أَوضع الرُتب",23,"ب",1,0],["يا عقيل الصحيح إن العلايق عوايق","والمعارف صوارف عن طريق الحقايق",24,"ق",1,1],["يا عقاب رد الصيد ودراه يا عقاب","عن لا تقول الناس ضيق ثراها",25,"ا",3,1],["يا عقاب خله علها راس مرقاب","في مدهمات الليل عدى حراها",25,"ا",3,0],["يا عقل خل عن الخيال محلقاً","فلقد كبحت عنانه المجدولا",26,"ل",2,0],["يَاْ عَقْلَ هَاْذِيْ الرُّبَىْ مُُقْتَبِسَ النَّاْرِ مِنْ","تَاْرِيْخِهَاْ شُعَلَاً أَوْرَاْدَ مُحْتَزَبِ",27,"ب",1,0],["يا عُقبة َالْفْهْرِيِّ كَمْ أشْتَاقُ","قَلبِي إلَيْكَ سَرَى هَوَىً سَبَّاقُ",28,"ق",1,1],["يَا عَقْبَة الْفِهْرِيِّ خَيْلُكَ هَاهُنَا","كَالرَّعْدِ تَبْدُو وَالصَّدَى صَفَّاقُ",28,"ق",1,0],["يا عقولا تحجرت بمزيج","الجهل قري عينا بهذا الجمود",29,"د",1,0],["يا عقل إن لم تدرك الحسن ولا","القبح فلا كنت جمال الامم",30,"م",1,0],["ياعقاب ابن شامان ياشوق شما","عز الخوي لاصار بالعلم علمين",31,"ن",1,1],["يَا عُقْبَةَ الخَيْرِ فِي فَتْحٍ ﻹِفْرِقْيَا","هَلِ انْكَسَرْتَ لأَنَّ الغَدْرَ يَكْوينَا؟",32,"ن",2,0],["يا عقدي الرابع تمهل على الهون","اصبر دخيلك على هونك تمهل",33,"ل",1,1],["يا عقلا لم يُنبت يوما","غيرَ الحكمة من شفتيكْ",34,"ك",1,0]]}