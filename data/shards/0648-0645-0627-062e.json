ldiwan.net/poem54034.html","الطويل"],[413,"أبى الله إلا إن تعز وتكرما","https://www.aldiwan.net/poem54043.html","الطويل"],[413,"أسرك من باد لعينيك حاضر","https://www.aldiwan.net/poem54066.html","الطويل"],[413,"تنفس عن وجد توقد جمره","https://www.aldiwan.net/poem54071.html","الطويل"],[429,"طلعت ربيعا من ربيع وأربع","https://www.aldiwan.net/poem12659.html","الطويل"],[429,"راخ لها في السبب","https://www.aldiwan.net/poem12774.html","مجزوء الرجز"],[434,"ربوع الندى من بعد فقدك بلقع","https://www.aldiwan.net/poem2548.html","الطويل"],[434,"فؤاد عصاه صبره وهو طالبه","https://www.aldiwan.net/poem2577.html","الطويل"],[434,"عقت دارها إلا ثلاثا بها سحما","https://www.aldiwan.net/poem2592.html","الطويل"],[436,"تسمع لدعوة ناء غريب","https://www.aldiwan.net/poem34789.html","المتقارب"],[436,"أخفضا نوت فينا النوى ولعلها","https://www.aldiwan.net/poem34863.html","الطويل"],[438,"ويا سائلي عن عالم الخلق كلها","https://www.aldiwan.net/poem14410.html","الطويل"],[451,"أخي عبد المسيح فدتك نفسي","https://www.aldiwan.net/poem61583.html","الوافر"],[456,"كم النحت في جنبي والحز في متني","https://www.aldiwan.net/poem55835.html","الطويل"],[456,"عذيرك من حلمك المهتضم","https://www.aldiwan.net/poem55892.html","المتقارب"],[456,"تراك ترى غدوا أو أصيلا","https://www.aldiwan.net/poem56078.html","الوافر"],[456,"لكل هوى من رائد الحزم رادع","https://www.aldiwan.net/poem56130.html","الطويل"],[456,"إذا رضيت رباك عن الربيع","https://www.aldiwan.net/poem56133.html","الوافر"],[456,"يقولون يوم البين عينك تدمع","https://www.aldiwan.net/poem56134.html","الطويل"],[456,"تظن ليالينا عودا","https://www.aldiwan.net/poem56231.html","المتقارب"],[456,"نرق وتقسو بالغوير قلوب","https://www.aldiwan.net/poem56279.html","الطويل"],[456,"تزِل الليالي مرة وتصيب","https://www.aldiwan.net/poem56290.html","الطويل"],[459,"أقول لركب كالقداح تعاقروا","https://www.aldiwan.net/poem15095.html","الطويل"],[459,"سأبعثها بين البيوت شوازيا","https://www.aldiwan.net/poem15127.html","الطويل"],[462,"تلقاك يا سعد بالنجح سعد","https://www.aldiwan.net/poem3152.html","عموديه"],[462,"سلا عنك قلبي بعد ما قيل لا يسلو","https://www.aldiwan.net/poem3165.html","عموديه"],[462,"سمو كما تهدى على العجم والعرب","https://www.aldiwan.net/poem3260.html","عموديه"],[462,"سقى دمع العين لا دموع الغمائم","https://www.aldiwan.net/poem3271.html","عموديه"],[462,"سقى الله أطلال ما صبا","https://www.aldiwan.net/poem3384.html","عموديه"],[477,"أساءت لمن لم يبد منه لها ذنب","https://www.aldiwan.net/poem36914.html","الطويل"],[477,"سألت عليك القبر لو نطق القبر","https://www.aldiwan.net/poem37592.html","الطويل"],[477,"فم الإحساس أصبح في افترار","https://www.aldiwan.net/poem37620.html","الوافر"],[480,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[488,"ألا علِّلاني واعلما أنني غرر","https://www.aldiwan.net/poem654.html",""],[498,"علام الهموم وفيم العنا","https://www.aldiwan.net/poem37695.html","المتقارب"],[499,"أجدك لم تعرف أثافي دمنة","https://www.aldiwan.net/poem2247.html","الطويل"],[503,"الغيْب","https://www.aldiwan.net/poem27791.html","الوافر"],[512,"ينم عليه الدمع وهو جحود","https://www.aldiwan.net/poem20831.html","الطويل"],[527,"نظام يا ابن ودي أم لآلي","https://www.aldiwan.net/poem37270.html","الوافر"],[527,"لعمرك ما جانبت في الحق لي رهطا","https://www.aldiwan.net/poem37346.html","الطويل"],[546,"تحُذرني كي أحذر العام خثعما","https://www.aldiwan.net/poem1187.html",""],[549,"ما للقلوب غداة السبت مزعجة","https://www.aldiwan.net/poem47250.html","البسيط"],[549,"ألا رب أمر بت أحذر غبه","https://www.aldiwan.net/poem47252.html","الطويل"],[549,"تراءت لنا بالأبرقين بروق","https://www.aldiwan.net/poem47376.html","الطويل"],[549,"سئمت مقامي في الغبينة مغمدا","https://www.aldiwan.net/poem47869.html","الطويل"],[549,"قفا بي على تلك الطلول الرثائث","https://www.aldiwan.net/poem48019.html","الطويل"],[551,"تعز فقد مات الهوى وانتهى الجهل","https://www.aldiwan.net/poem68388.html","الطويل"],[553,"ففر زهير خيفة من عقابنا","https://www.aldiwan.net/poem1924.html","الطويل"],[556,"هو الله ربي هو المبتدا","https://www.aldiwan.net/poem34598.html","المتقارب"],[565,"عذيري من صرف هذا الزمن","https://www.aldiwan.net/poem69497.html","المتقارب"],[573,"أيا دار في جنات عدن له دار","https://www.aldiwan.net/poem2783.html","الطويل"],[573,"سعودك ردت ما ادعاه المنجم","https://www.aldiwan.net/poem3015.html","الطويل"],[573,"هواي لمحبوبي الأول","https://www.aldiwan.net/poem3036.html","المتقارب"],[573,"وصفتك واللاحي يعاند في العذل","https://www.aldiwan.net/poem3040.html","الطويل"],[585,"إلى الله في كشف المهمات نرغب","https://www.aldiwan.net/poem11511.html","عموديه"]],"verses":[["وَما خَيرُ عَينٍ خَبا نورُها","وَيُمنى يَدٍ جُذَّ مِنها البَنانُ",0,"ن",1,0],["وَما خِفتُ النَوائِبَ تَرتَمي بي","وَقَد أَقعى بِجامِحِها لِجامي",1,"م",2,0],["وَما خَطَرَت مِنهُ عَلى المَجدِ زَلَّةٌ","فَيَقرَعَ في آثارِها سِنَّ نادِمِ",2,"م",1,0],["وَما خُلِقَت أَقدامُهُم وَأَكُفُّهُم","لِغَيرِ العَوالي وَالظُبى وَالأَسِرَّةِ",3,"ه",1,0],["وما خِلْتُ أنّ البَرقَ يَكْلَفُ بالنّوى","ولَمْ أتّهِمْ إلا القِلاصَ النّواجِيا",4,"ي",2,0],["وما خَصّني زمَني بالعُقوقِ","فكَمْ رِيءَ منْ فاضِلٍ مُبْتَلَى",5,"ل",2,0],["وَما خَصلَةٌ قَد تَذلُّ الرِجالَ","بَأَسوَا وَأَخزَى مِن المَسأَلَه",6,"ل",2,1],["وَما خِلتُ رَأيَ السوءِ عَلَّقَ قَلبَهُ","بِوَهنانَةٍ قَد أَوهَنَتها سِناتُها",7,"ت",3,0],["وَما خِلتُ أَن أَبتاعَ جَهلاً بِحِكمَةٍ","وَما خِلتُ مِهراساً بِلادي وَمارِدا",8,"د",2,0],["وَما خِلتُ أَبقى بَينَنا مِن مَوَدَّةٍ","عِراضُ المَذاكي المُسنِفاتِ القَلائِصا",9,"ص",2,0],["وَما خُلِقتَ لَعَمري","في الشَرقِ إِلّا لِتَبني",10,"ي",1,0],["وَما خِفتُ تَبريحَ الحَياةِ كَما أَرى","تَضيقُ ذِراعي أَن أَقومَ فَأَلبِسا",11,"س",2,0],["وَما خَلَفٌ مِنكُم بِأَطلالِ دِمنَةٍ","تَنَكَّرنَ وَاِستَبدَلنَ مِنكِ السَوافِيا",12,"ي",2,0],["وَما خَيرُ دُنيا بَعدَ آلِ مُحَمَّدٍ","أَلا لا نُباليها إِذا ما اِضمَحَلَّتِ",13,"ت",1,0],["وَما خِفتُ بيَن الحَيِّ حتَىّ تصَدَعَّتَ","عَلى أَوجُهٍ شَتّى حُدوجُ الشَكائِكِ",14,"ك",1,0],["وما خالق الأكوان إلاّ مهندس","وإن جلّ عن تعريفه بالمهندس",15,"س",1,0],["وَما خِفتُ وَشكَ البَينِ حَتّى رَأَيتُهُم","لِظَعنِهِمُ رَدّوا الغُرَيرِيَّةَ البُزلا",16,"ل",2,0],["وما خلتُ الضباب معطفاتٍ","على الحيتان من شَبَه الحُسُولِ",17,"ل",1,1],["وما خفتُ من جهلِ العذول وإنما","بغيضٌ إليَّ الجاهل المتعاقل",18,"ل",1,0],["وَما خَلَوا مِنهُ طَرفَ العَين لَو عَلِموا","وَما خَلا مِنهُم في كُلِّ أَوقاتِ",19,"ت",1,0],["وما خسَسْتَ الثوابَ المستثاب بها","وأيُّ مُهدٍ إليك الصدق لم يُثَبِ",20,"ب",1,0],["وما خِلْتُنا مستبدِلِي بقعةٍ بها","من الأرض لولا شؤْمُ صاحبِ آمِدِ",21,"د",1,0],["وما خلت أني أستريث سماءه","ويُربَع غيري من جناها ويُخرَف",22,"ف",1,0],["وما خِلتُ نفسي تقتضيني لقاءَكم","فأمنحها لولا شناءتُه المطلا",23,"ل",2,0],["وما خرقتُ ولا ضيّقت في مهلٍ","بل قد رقَقْتُ وقد أوسعت في المهَلِ",24,"ل",1,0],["وما خليلي الخليلُ يُعجبُهُ","تَرْكيَ أموالَهُ وإجمامي",25,"م",2,0],["وَما خُتِمَت أَكتافُكُم لِنُبُوَّةٍ","وَأَستاهُكُم ما فَسَّحَتها المَنابِرُ",26,"ر",1,0],["وَما خِلتُها إِلّا دَوالِحَ أوقِرَت","وَكُمَّت بِحَملٍ نَخلُها وَفَسيلُها",27,"ل",3,0],["وَما خِفتُ مِنها البَينَ حَتّى تَزَعزَعَت","هَماليجُها وَاِزوَرَّ عَنّي دَليلُها",28,"ل",3,0],["وَما خِفتُ بَينَ الحَيِّ حَتّى رَأَيتُهُم","لَهُم بِأَعالي الجَلهَتَينِ حُمولُ",29,"ل",1,0],["وَما خَطَّتِ الأَقلامُ إِلّا وَأَدمُعي","تَخُطُّ كِتابَ الشَوق في صَفحَة الخَدِّ",30,"د",1,0],["وما خذلتني في بلاء سجية","وبعض السجايا خاذل ونصير",31,"ر",1,0],["وَما خَلا خَليفَةٌ مُسوّدُ","مِن طالِبيٍّ يَطلُبُ الأَمرَ سُدى",32,"ا",1,0],["وَما خَضَبَ الناسُ البَياضَ لِأَنَّهُ","قَبيحٌ وَلَكِن أَحسَنُ الشَعرِ فاحِمُه",33,"م",2,0],["وَما خِلتُني وَالحادِثاتُ مِنَ الحَصى","أُخَيَّبُ مِن مالي وَيَغنَمُ ناهِبُه",34,"ب",2,0],["وَما خِلتُ الفَخارُ يَكونُ يَوماً","نَصيبُكَ فيهِ أَعلى مِن نَصيبي",35,"ب",2,0],["وَما خِفتُ جِدّي في الصَديقِ يَسوءُهُ","ولَكِنَّ كَثيراً مايَخافُ مُزاحي",36,"ي",1,1],["وَما خِلتُكَ ابنَ الأَنجُمِ الزُهرِ سائِراً","وَتارِكَ نُعماكَ الَّتي شُهِرَت عَدّا",37,"د",2,0],["وَما خِلتُها مَأخوذَةً بِصَبابَتي","صَحائِفُ تُمحى بِالرِياحِ سُطورُها",38,"ر",3,0],["وَما خِلتُ تُبكى بَعدَ قَيصَرَ خُلَّةٌ","لِكُلِّ مُحِبٍّ قَيصَرٌ مِثلَ قَيصَري",39,"ر",2,0],["وَما خَيرُ يَومَيَّ الَّذي أَزَعُ الصِبا","لَهُ وَأُحَلّى بِالنُهى وَأُمَتَّعُ",40,"ع",1,0],["وَما خَفَضَت جَدّاتُ بَكرٍ أَرومَتي","وَلا عَطِلَت مِن ريشِ أَحسابِها سَهمي",41,"ي",1,0],["وَما خَطَري دونَ الغِنى إِن بَلَغتُهُ","سُؤالاً وَلا عِرضي نَظيرُ الدَراهِمِ",42,"م",1,0],["وَما خافَ شَيءٌ لَم يَمُت مِن مَخافَةٍ","كَما قَد أَسَرَّت في فُؤادي ضَمائِرُه",43,"ر",2,0],["وَما خِفتُ وَشكَ البَينِ حَتّى رَأَيتُها","يُساقُ عَلى ذاتِ الجَلاميدِ عيرُها",44,"ر",3,0],["وَما خِفتُها إِن أَنكَحَتني وَأَشهَدَت","عَلى نَفسِها لي أَن تَبَجَّسَ غولُها",45,"ل",3,0],["وَما خاصَمَ الأَقوامَ مِن ذي خُصومَةٍ","كَوَرهاءَ مَشنوءٌ إِلَيها حَليلُها",46,"ل",3,0],["وما خَفا البَرقُ إلا عادَ يُذكِرهُ","من الثَّنِيَّةِ أَجزاعاً وأخيافا",47,"ف",2,0],["وما خِلْتُ صَفْعَانَ العراقِ يَسومُني","لأمثالِهِ ذمّاً يَسيراً ولا حَمْدا",48,"د",2,0],["وَما خَلَقَ الإِنسانُ إِلّا لِغايَةٍ","وَلَم يَترُكِ الإِنسانَ في الأَرضِ مُهمَلا",49,"ل",2,0],["وَما خَيَّرتَ أَينَ حَلَلتَ إِلّا","وَصَلتُ إِلَيكَ إِدلاجي بِسَيري",50,"ر",2,0],["وَما خَفَقَت جَناحُ الجَيشِ إِلّا","رَأوني مِلءَ قَلبِ العَسكَرَينِ",51,"ن",1,0],["وما خمدتْ لوعةٌ تلتظي","ولا جَمَدَتْ عَبرةٌ جاريه",52,"ي",2,0],["وما خارَ عُودي عندَ غَمزِ مُلِمَّةٍ","وهل خارَ عِندَ الغمزِ في يَدِكَ النبعُ",53,"ع",1,0],["وما خلتُ أنّ النّارَ يَبْرُدُ حَرّها","على سَعَفٍ لاقته في القيظِ يابِسا",54,"س",2,0],["وَما خَيرُ حِلمٍ لَم تَشُبهُ شَراسَةٌ","وَما خَيرُ لَحمٍ لا يَكونُ عَلى عَظمِ",55,"م",1,0],["وَما خَيرُ بَرقٍ لاحَ في غَيرِ وَقتِهِ","وَوادٍ غَدا مَلآنَ قَبلَ أَوانِهِ",56,"ن",2,0],["وَما خَلفَ أَجفاني شُؤونٌ بَخيلَةٌ","وَلا بَينَ أَضلاعي لَها حَجَرٌ صَلدُ",57,"د",1,0],["وَمَا خَيْرُ دُنْيَا لا بَقَاءَ لِعَهْدِهَا","وَمَا طِيبُ عَيْشٍ رَبُّهُ غَيْرُ سَالِمِ",58,"م",1,0],["وَما خَطا قادِماً فَوافى","حَتّى اِنثَنى ناكِصاً فَآبا",59,"ب",2,0],["وما خُطَطُ الدُّهاةِ بِمُغنياتٍ","إذا خُطَطٌ بأنقرةٍ قضينا",60,"ن",2,0],["وَما خَفِيَ الصَوابُ عَلى عَليمٍ","وَلا اِحتاجَ الضِياءُ إِلى مِثالِ",61,"ل",1,0],["وَما خِفتُ بَينَ الحَيِّ حَتّى تَذَأَّبَت","نَوىً لَم أَخَل ما كانَ مِنها بِكائِنِ",62,"ن",1,0],["وَما خُلِقَت تَيمٌ وزَيدُ مَناتِها","وَضَبَّةُ إِلّا بَعدَ خَلقِ القَبائِلِ",63,"ل",1,0],["وَما خَبَرتُ الَّذي فيها فَأذكره","لَكِن أَتَتني بِما فيهِ الأَخابيرُ",64,"ر",1,0],["وَما خِفنا مِنَ الناسِ","وَهَل في الناسِ إِنسانُ",65,"ن",1,0],["وما خُلُقِي مَدْحُ اللَّئِيمِ وَإنْ عَلَتْ","بهِ رُتَبٌ لا أَنَّني مُتَكَبِّرُ",66,"ر",1,0],["وما خِلتُ أنَّ الروْضَ يختالُ ماشِياً","ولا أن أرَى في أظهُرِ الخيل عَبقرا",67,"ر",2,0],["وما خلفَه من حطيمٍ يُزارُ","ولا دونه من مَدىً يُنْتَهَى",68,"ا",1,0],["وما خَفِيَ الرُّشْدُ لكنّما","أضَلّ الحُلومَ اتّباعُ الهوى",68,"ا",1,0],["وما خُلِقَتْ عبَثَاً أُمّةٌ","ولا ترَكَ اللّه قوماً سُدى",68,"ا",1,0],["وَما خُبزُهُ إِلّا كَآوى يُرى ابنُهُ","وَلَم يُرَ آوى في حُزونٍ وَلا سَهلِ",69,"ل",1,0],["وَما خُبزُهُ إِلّا كَعَنقاءِ مُغرِبٍ","تُصَوَّرُ في بُسطِ المُلوكِ وَفي المُثلِ",69,"ل",1,0],["وَما خُبزُهُ إِلّا كُلَيبُ بنُ وائِلٍ","وَمَن كانَ يَحمي عِزُّهُ مَنبِتُ البَقلِ",69,"ل",1,0],["وَما خَيرُ كَفٍّ أَمسَكَ الغُلُّ أُختَها","وَما خَيرُ سَيفٍ لَم يُؤَيَّد بِقائِمِ",70,"م",1,0],["وَما خابَ بَينَ اللَهِ وَالناسِ عامِلٌ","لَهُ في التُقى أَو في المَحامِدِ سوقُ",71,"ق",1,0],["وَما خابَ بَينَ الأَجرِ وَالحَمدِ عامِلٌ","لَهُ مِنهُما عِندَ العَواقِبِ زادُ",72,"د",1,0],["وَما خَرَجَت فيهِنَّ حَتّى عَذَلنَها","قِياماً وَحَتّى كادَت الشَمسُ تَخرُجُ",73,"ج",1,0],["وَما خَيرُ عَيشاً لا يَزالُ مُفَجَّعاً","بِمَوتِ نَعيمٍ أَو فِراقِ حَبيبِ",74,"ب",1,0],["وَما خِلتُهُ إِلّا سَيُبعَثُ حادِثاً","يُحِلُّ الثُرَيّا عَن جَبينِ الغَياهِبِ",75,"ب",1,0],["وَما خِلَقُ البيضِ الحِسانِ حَميدَةً","إِذا اِشتَهَرَت أَخلاقُهُنَّ الدَمائِمُ",76,"م",1,0],["وَما خِلتُ السِماكَ وَلا أَخاهُ","عَلى خَلقَيهِما لا يَهرَمانِ",77,"ن",1,0],["وَما خِلتُ سَلمى قَبلَها ذاتَ رِجلَةٍ","إِذا قَسوَريُّ اللَيلِ جيبَت سَرابِلُه",78,"ل",2,0],["وَما خَليجٌ مِنَ المَرّوتِ ذو حَدَبٍ","يَرمي الضَريرَ بِخُشبِ الطَلحِ وَالضالِ",79,"ل",1,0],["وَمَا خُنتُ ذا عَهدٍ وأُبتُ بِعَهدِهِ","وَلم أَحرِمِ المضُطَرَّ إذ جاءَ قانِعا",80,"ع",2,1],["وَمَا خِلْتَنِي فَوْقَ الَّذِي أَنَا كُنْتُهُ","فَفِيمَ أَرَى حَيّاً قِيَامَ تَمَاثِيلي",81,"ي",1,0],["وَمَا خِفْتُ فِي أنْ أُلْفى كَغَيْرِيَ مُولَعاً","بِخَلْعِ أَحِبَّائي كَخَلْعِ ثِيَابِي",82,"ب",2,0],["وَمَا خُلِقَتْ لِمَا يَخْلُبُ النُّهَى","مِنَ النَّحْتِ وَالتَّصْويرِ وَالنَّظْمِ وَالنَّثْرِ",83,"ر",1,0],["وما خَطبنا إلى قوم بَناتِهمُ","إلاّ بأرْعَن في حافاتِه الحَرَقُ",84,"ق",1,0],["وما خافَ يا أمُّ بل ضمَّني","وألقى على مَبْسَمي نجمتينْ",85,"ن",1,0],["وما خُلِقَتْ إلاّ لعزمٍ نفوسُنا","كأنَّا خُلِقْنا من غُبار الجحافل",86,"ل",1,0],["وما خضعَ النصرُ الأشمُّ لفاتحٍ","إذا لم يكُنْ من خيرة السادةِ الشُّمِ",87,"م",1,0],["وما خفت والآساد تزأر في الشرى","فكيف بخوفي من رويبضة الجحر؟",88,"ر",1,0],["وما خص هذا الخطبُ مصرَ، وإنما","رأَيت بلادَ الشرق فيه سواسيا",89,"ي",2,0],["وما خاب شعبٌ بهَذِي السماءِ","قويُّ الصِّلاتِ، وثيقُ العُرَا",90,"ر",2,0],["وما خلفتمو بين الزُّ","نُوج وبيننا فرقا",91,"ق",2,0],["ومَا خَيْرُ عَيْشٍ لاَ يَزَالُ مُفجَّعاً","بموت نعيمٍ أو فراق حبيب",92,"ب",1,0],["وما خلفت في الجو من خطراتها","وما خلعت من مرقصات على الربى",93,"ب",2,0],["وما خِلْتُني عبْءا عليهم وأنهم","يريدون أن يُجتَثَّ متنٌ وكاهل",94,"ل",1,0],["وما خلت أني في العراق جميعِه","سأفقِدُ حراً عن مغيبي يسائل",94,"ل",1,0],["وَما خَيْرُ يَوْمَيّ الذي أزِعُ الصِّبَى","لَهُ، وأُحَلّي بالنّهَى، وأُمَتِّعُ",95,"ع",1,0],["وما خلوا منه طرف عين لو علموا","وما خلا منهم في كل أوقات",96,"ت",1,0],["وما خِلْتُ نفسي تقتضيني لقائكم","فأمنحها لولا شناءتُه المطلا",97,"ل",2,0],["وَما خَطَّتِ الأَقلامُ إِلّا وَأَدمُعي","تَخُطُّ سُطور الشَّوق في صَفْحَة الخَدِّ",98,"د",1,0],["وما خيرُ شعب لستَ تعثرُ بينه","على قارئٍ من كلِّ ألفٍ وكاتب",99,"ب",1,0],["وَما خَفيت عَلَيَّ الناس حَتّى","أَروم اليَوم مِن رَخم حَليبا",100,"ب",2,0],["وما خنت والله الصديق ولم امل","اذا لم يمل عنى الخلل ويغدر",101,"ر",1,0],["وما خير علمٍ في الحياة وفطنةٍ","إذا حال ضعف العزم دون المطالب",102,"ب",1,0],["وَما خَشيت عَواقِبَ نارَ هَجوِي","إِذا حُضِئت مُيمِّمةً قَبيلا",103,"ل",2,0],["وَما خَفيتَ عَلى ذي فِطنَةٍ نَسَباً","إِذا النَدى وَالوَغى قالا لَكَ اِنتَسَبِ",104,"ب",1,0],["وَما خِفتَ إِلّا اللَهَ فيما وَليتَهُ","وَلا حِفتَ في الأَفعالِ سَهواً وَلا عَمدا",105,"د",2,0],["وَما خِلتُ قَبلَ بُلوغي إِلَيكَ","أَنَّ الغِنى مِن دَواعِ الحَصَر",106,"ر",1,0],["وَما خِلتُ أَنَّ الدَهرَ يُلجِئُني إِلى","زَمانٍ يَبيتُ العَجزُ فيهِ مُضاجِعي",107,"ع",2,0],["وَما خُلِقا إِلّا لِإِفناءِ قاسِطٍ","يُخافُ وَيُرجى أَو لِإِغناءِ قانِعِ",107,"ع",1,0],["وَما خِلتُ أَنَّ الشَمسَ قَبلَ مُصابِهِ","تُضامُ وَلا زُهرَ المَجَرَّةِ تُرتَعا",108,"ع",2,0],["وَما خَرِسَت بِها الأَبطالُ حَتّى","تَكَلَّمَتِ الصَوارِمُ وَالصَواهِل",109,"ل",1,0],["وَما خَلا مِن جَزيلِ العُرفِ مُنتَجِعٌ","كَلّا وَلا مِن جَميلِ الصَفحِ مُجتَرِمُ",110,"م",1,0],["وَما خَصَصتَ عَدُوّاً دونَ صاحِبِهِ","إِلّا لِيُنذِرَ بَعضُ القَومِ بَعضَهُمُ",110,"م",1,0],["وما خوفي عَلَى رُوحي وَلَكنْ","عليهِ منْ معاقبةِ الذنوبِ",111,"ب",1,0],["وما خص أرض دون أرضك وحشة","فراقك بل عم البلاد وما استثنا",112,"ن",2,0],["وما خابَ من كان الرجاء يقودهُ","إِليك إِلى العلَم المزيّد بالندى",113,"د",2,0],["وما خالف الأمر المشد ولا انثنى","لترك وكم عذر به يوجب التركا",114,"ك",2,0],["وما خطب العلا بالسيف كفو","فكان سوأه اولى بالنكاح",115,"ح",1,0],["وما خلوا سبيل العيس حتى","حلفت لهم يمينا لا تمين",116,"ن",1,0],["وما خص بالإِيمان فرعون وحده","لدى موته بل عمّ كل الكوافر",117,"ر",1,0],["وَما خِلتُ قَبراً وَهوَ أَربَعُ أَذرُعٍ","يَضُمُّ ثِقالَ المُزنِ وَالطَود وَالبَحرا",118,"ر",2,0],["وَما خَيرُ أَرضٍ لا يَزالُ كَريمُها","مُهاناً وَنَذلُ القَومِ فيها مُكَرَّما",119,"م",2,0],["وما خير علم ليس ينهى عن الهوى","ولا يمنع النفس اللجوج ضلالها",120,"ل",3,0],["وَما خيرُ دين ليسَ تُدركه النهى","تَغورُ عَلى أَغوارِ أسراره غورا",121,"ر",2,0],["وما خير المعيشة لابن إرب","إذا افترقت إلى الجهل العقول",122,"ل",1,0],["وما خلتُ هذا الكونَ إلا كوجنةٍ","عليها الدُّجى فيما أشبههُ خالُ",123,"ل",1,0],["وما خوف أطفال أبوهم مجاهد","على نائبات الدهر بالباس يزحف",124,"ف",1,0],["وَما خِفتُ مِنها البَينَ حَتّى رأَيتُها","مَيمِّمَةً نَحوَ القُرَيَّةِ عيرُها",125,"ر",3,0],["وما خذلْتني همّتي فألومها","وما ضاق بي مذ كنتُ في محفِلٍ عِلمي",126,"ي",1,0],["وَما خَلَفَتكِ بانَتُها وَلَكِن","حَكَت ذاكَ التَعَطُّفَ وَالتَثَنّي",127,"ي",1,0],["وَما خَلَت مِنهُمُ المَغاني","وَلا عَفَت مِنهُمُ الرُبوعُ",128,"ع",1,0],["وما خسر الضدان فهو غنيمة","فقد ضربوا نجداً بمصر وحزبوا",129,"ب",3,0],["وَما خَضَعَ الفرنجُ لَدَيكَ حَتّى","رأوا مالا يُطاقُ مِن الكِفاحِ",130,"ح",1,0],["وما خلق النساء البظر إلا","وبالاً حيث كان على الرجال",131,"ل",1,0],["وما خيط ما حاك الخد رنق في الفلا","وإحصاء رمل الخبت في فلواته",132,"ت",2,0],["وما خلت لولا الدمع تبدو وسرائري","ولا خلته ينهل لولا تدافقه",133,"ق",2,0],["وَما خالَفَت غرْناطةٌ رَأي رَيّة","لتَشْمُلَ أنْوارَ الهُدى كُل جانِبِ",134,"ب",1,0],["وما خَيْرُ السَّلامَةِ فِي حَياةٍ","إِذا كانَتْ إِلى عَطَبٍ تَؤُولُ",135,"ل",1,0],["وَما خانَنِي مِنْ هِمَّةِ تَأْمُلُ الْعُلى","سِوى أَنَّ أَسْبابَ الْقَضَاءِ تَعُوقُها",136,"ق",3,0],["وَما خافَ مَن أَنا مَملوكُهُ","وَلَيسَ سِوى المَلِكِ الكامِلِ",137,"ل",1,0],["وَما خيّمت بالمُنحنى من مُحجّرٍ","وَلكن ضُلوعي المنحنى والمخيَّمُ",138,"م",1,0],["وَما خلقُهم إلّا وفاقٌ لحكمةٍ","بِها تمّ تأليفُ الوجود ونظمهُ",139,"م",2,0],["وَما خسرَ الإنسانُ وجهَ سعادةٍ","إِذا مِن فنونِ العلمِ وُفِّرَ سهمهُ",139,"م",2,0],["وَما خَبرت إلّا إِباء حفيظةٍ","تَفيءُ لعزٍّ يَفرع الفرغَ والشرطا",140,"ط",2,0],["وَما خِلنا الفتورَ له فتونٌ","تُغالُ به النهى سكراً وسحرا",141,"ر",2,0],["وَما خُسِرَ الفرع الذويُّ بنبتهِ","مَخافةَ أَن تستأصلَ العلّة الجذرا",142,"ر",2,0],["وَما خلتُ أنّ المسكَ بالعتب حالمٌ","وَللمسك في عنوانه نفحة تُصبي",143,"ب",2,0],["وَما خلت أنّي حين يطمو عبابها","أَرى حظّ غيري النون وحظّي الضبا",144,"ب",2,0],["وماَخامَ عَنها يَومَ سارَت جُموعُنا","لِأَهلِ قُدَيسٍ يَمنَعونَ المَوالِيا",145,"ي",2,0],["وَما خابَ مَن لَم يَأَتِهِ مُتَعَمِّداً","وَلا فازَ مَن قَد نالَ مِنهُ وُصولا",146,"ل",2,0],["وَما خَفضت قَدري لِرفعةِ قَدرِها","على نصبِ أَشراك الجُفون سِوى كسرَه",147,"ر",2,0],["وَما خاض إِلّا لجّة العَفو وَالرضى","وَما حَلَّ أَرّخ في سِوى جَنة الخُلدِ",148,"د",1,0],["وما خير معروف الفتى في شبابه","إذا لم يزده الشيب حين يشيبُ",149,"ب",1,1],["وما خُلِقْنا حَماماتٍ لنُطْرِبَكمْ","شَجْواً ونَملِكَ أطْواقاً منَ الخِلَق",150,"ق",1,0],["وما خطَرتْ إلاّ برمَلْة عالجٍ","ولا عَطِرتْ إلاّ بحاشيتَيْ بُرد",151,"د",1,0],["وما خلْتُ ألحانَ الأعاجمِ قبلَها","تَشوقُ وتَشجو عِليةَ الفُصحاء",152,"ا",2,0],["وَما خَلَوتُ بِذِكراكُم وَكانَ مَعي","ثانٍ يُثَلِّثُ ذِكراكُم سِوى الكَرَمِ",153,"م",1,0],["وَما خَيرُ عَيشٍ نِصفُهُ سِنَةُ الكَرى","وَنِصفٌ بِهِ يَعثَلُّ أَو يَتَوَجَّعُ",154,"ع",1,0],["وَما خَدَعَتني مِصرُ عَن طيبِ دارِها","وَلا عَوَّضَتني بَعدَ جارِيَ جارا",155,"ر",2,0],["وماخلت أن الحال بعد ثبوتها","سيفجؤها أمرٌ من السح قاطع",156,"ع",1,0],["وما خلت أن الدهر ينقض عهده","فتدرك فينا للأعادي مطالب",157,"ب",1,0],["وما خفت منها البين حتى رأيتها","علا غيرها في الصبح أصوات سائِق",158,"ق",1,0],["وماخشيت عليك من الأعادي","ولكن من خيانة مستريب",159,"ب",1,0],["وما خلتماه مشكلاً متشابهاً","فقولا وكلناه إلى علم باريه",160,"ي",2,0],["وما خاف مولاكم عليهم وإنما","غدا منفقاً أموالهم في العمائر",161,"ر",1,0],["وَما خُضتَ جَيشاً بِالدِماءِ مُضمَّخاً","يَرى بيضُهم مِثلَ الحَبابِ عَلى الخَمرِ",162,"ر",1,0],["وَما خَيَّبَ الدهر الخؤون لِطالِبٍ","وَلاذَ بِها إِلّا أَتَتهُ الفَوائِدُ",163,"د",1,0],["ومَا خِلْتُه مَهوَى الهَوى ومَقِيلَهُ","ومَأوى الأسى والبَثِّ عند هُدوِّهِ",164,"و",2,0],["وما خلتُ آسادَ الشرى إذْ تَبَهْنَستَ","فرائسَ غِزلانِ الصّرِيمةِ إذ تعطو",165,"ط",2,0],["وَما خُلِقَت إِلّا لِبَذلٍ أَكُفُّهُم","وَأَلسُنُهُم إِلّا لِتَحبيرِ مَنطِقِ",166,"ق",1,1],["وما خَلَفْتُ للغرام طاعةً","وما نَكَثْتُ حبلها المتينا",167,"ن",2,0],["وما خَفِيَتْ تلك المزايا وإنَّما","تلوحُ كما لاح الصَّباح لرائي",168,"ي",1,0],["وما خاب ظنِّي في جميلك قبلَها","وما كنتَ للظنِّ الجميل مخيّبا",169,"ب",2,0],["وما خابَ راجيكم ليومٍ عَصَبْصَبٍ","يريه الرَّدى يوماً من الروع أَيْوما",170,"م",2,0],["وما خُلِقَ الإِحسان إلاَّ لصالحٍ","ولا خُلق الصَّمصام إلاَّ لفاجر",171,"ر",1,0],["وما خَفَيت حال عليك ظهورها","وكيف وسرُّ العَبد عندك جهره",172,"ر",2,0],["وما خدَعوني باللِوى غيرَ أنهُم","لوَوْا نحو المطامعِ أخدَعي",173,"ي",1,0],["وما خلطتَ الدرّ في","لفظي بالمُخشَلِبِ",174,"ب",1,0],["وما خلت أن أبقى وأرثيك بعدما","غدت مدحي في تاج علياك توضع",175,"ع",1,0],["وما خلتُ أن الدهر تخني صروفهُ","ولكن دهري ليس تقضى عجائبه",176,"ب",2,0],["وما خصّني من حسن خلق وخلقةٍ","ومنطق فصل أستطيش به الحلما",177,"م",2,0],["وَمَا خَطَّهُ أَثَرٌ عن أَميرٍ","وسَطَّرَهُ أَرَبٌ عن أَرِيبِ",178,"ب",1,0],["وما خَفَرَتْ بِيضُ الصَّوارِمِ والقَنا","مَحاسِنَها مِمَّا أَصابَ فَأوْلَها",179,"ل",3,0],["وما خلق الباري فليس بعالم","سواهم يسمى بين نعت وأَوصاف",180,"ف",1,0],["وما خلد الحياة لنا ولكن","لذرت سبحن بكل شمس",181,"س",1,0],["وما خلتُ وِرد الماءِ بابا إلى الصدى","ولا أنّ عومَ البحر ضربٌ من الدفنِ",182,"ن",1,0],["وما خلتُ أنَّ بيوتَ النبي","طِ يَحذَرُ فيها ليوثُ الأجَمْ",183,"م",1,0],["وما خطبٌ أجبتُ نداءَ حزني","له ودعوتُ يا دمعي نزولا",184,"ل",2,0],["وما خلتُني أمشي على البحر ظامئاً","وخِمس فمي منه بما بلَّ قانعُ",185,"ع",1,0],["وما خمدتْ بذي العلمين نارٌ","يشيمُ ضيوفُ مُوقدها ضلوعي",186,"ي",1,0],["وما خشُنتْ إلا وقلتُ دعي غداً","لكلِّ غدٍ رزقٌ مع الشمس يطلعُ",187,"ع",1,0],["وما خلتُ لي واسطاً عُقْلةً","تعلِّم نومِيَ أن يَشرُدا",188,"د",2,0],["وما خلتُ قبل أنَّ عيناً ركيَّةٌ","ولا أنّ مِلح الماقِيَيْنِ شَروبُ",189,"ب",1,0],["وما خِلتُ أن البدرَ يطلُعُ مُصعِداً","ولا أنَّ ريح المكرماتِ جَنوبُ",190,"ب",1,0],["وما خزريٌ لهْذمٌ هجمَتْ به","صناعُ يدٍ في رأس أغيْدَ ذابل",191,"ل",1,0],["وما خلتُ في خمس وعشرين شيبةً","سوى أن همّاً أشعل الرأس زائد",192,"د",1,0],["وما خنعوا لك من ذلةٍ","وفيهم سرحٌ مخوفٌ وجند",193,"د",1,0],["وما خير ملك فارقته ملوكه","وتيجانها من مثل جوهرها عطل",194,"ل",1,0],["وما خلعوا إلا سناك على الحلى","كما لاح نور البدر في خلل السحب",195,"ب",1,0],["وما خطرت قضبانها وتراقصت","شمائلها إلا لشدو الحمائم",196,"م",1,0],["وما خانني إلاّ الشبابُ فأنني","وثقتُ بعهدٍ منهُ غير وثيق",197,"ق",1,0],["وما خلت أن الدار تسعى لربها","إلى أن غدا يسعى لساكنه القلب",198,"ب",1,0],["وما خنت عهدي في الوصية إنما","تأخرت في التأبين مذ خانني الشعر",199,"ر",1,0],["وما خلف الحجاب سوى ركاز","كما قص الكتاب عن الجدار",200,"ر",1,0],["وما خان سيف العزم لما تأججت","أسود الوغى ما كنت عن عطفها ثان",201,"ن",1,0],["وما خاننا لما تضعضع ركنه","وصارت به العنقا على إثر أظعان",201,"ن",1,0],["وَما خِلتُ يُجديني أَساتي وَقَد بَدَت","مَفاصِلُ أَوصالي وَقَد شَخَصَ البَصَر",202,"ر",1,0],["وما خاب قط بقصد السبي","لِ فتى ضمهث السير في ركبنا",203,"ن",2,0],["وَما خِلتُ أَنّي نِلتُ مالَ عَشيرَةٍ","وَلا حِيبَةً إِنَّ الأُمورَ تُفَرَّجُ",204,"ج",1,0],["وما خلقُ بني آدم إلا","ليختاروا على علمٍ فغِرتُ",205,"ت",1,0],["وما خِلْتُ أنّ اللّدْنَ والصّبْرُ لامتي","تُمكّنُ فيّ الطّعنَ وهيَ قُدودُ",206,"د",1,0],["وما خَبَرُ الْحُدودِ حَدِيثُ صِدْقٍ","وَلكِنْ عُدَّ في قِيل وَقَال",207,"ل",1,0],["وما خِفْتُ في ذا الصُّنْعِ لَوْمَةَ لائِمٍ","تَلَهّبَ غَيْظاً واسْتَشاطَ لَهُ سُخْطا",208,"ط",2,0],["وَما خَثعَمُ إِلاّ لِئامٌ أَذِلَّةٌ","إِلى الذُلِّ وَالإِسحاقِ تَنمى وتَنتَمي",209,"ي",1,0],["وما خُصِصتَ بمكروهٍ تجلّلنا","ونحن قبلك بالبَأْساءِ نَسْتَهِمُ",210,"م",1,0],["وما خانني التّدبير فيه وإنّما","قضاءٌ جرى فيما سخطتُ مبرَّمُ",211,"م",1,0],["وَما خلتُ إلّا الوَرْسَ في الأفقِ إنّه","متى لم يَكُنْهُ الورس فَهْوَ خَلوقُ",212,"ق",1,0],["وما خِيفةُ الإنسان إلّا غباوةٌ","وخوفُ الرّدى للمرءِ شرٌّ من الرّدى",213,"د",2,0],["وما خَزِيَتْ منّا رؤوسٌ بريبةٍ","تُكشّفها في النّاسِ نبثةُ نابِثِ",214,"ث",1,0],["وَما خَوَّلَتكَ المَكرُماتُ سَجِيَّةً","حُبيتَ بِها إِلّا وَأَنتَ لَها أَهلُ",215,"ل",1,0],["وَما خِلتُني لِاِبنِ الأَغَرِّ مُثَمِّراً","وَما خِلتُني أَجني عَلَيهِ الجَرائِما",216,"م",2,0],["وما خبر المبتدا عينه","نعم غيره هكذا أشهدا",217,"د",2,0],["وَمَا خَانَنِي الرَّأْيُ لَكِنَّنِي","أَرَى رَأْيَهُ بِي عَيْنَ الأَفَنْ",218,"ن",1,0],["وما خصَّ مصراً وحدها رزؤُها بِه","لقد رُزِئَتْه في البَسيطَةِ أَمصَارُ",219,"ر",1,0],["وما خَدَمُوا الأَفلاكَ إِلاَّ لأَنها","بأَمرِك تَجْري أَو لأَمْرِك تَخْدُمُ",220,"م",1,0],["وما خفتُ من أَسدٍ أَمرَه","وقد مِتُّ من رشإِ أَكْحَل",221,"ل",1,0],["وما خالَفَتْك الجُردُ قَطُّ وإِنَّها","لَتَلْحقُ مَنْ عَادَيْتَه وَهْيَ في الشَّكْلِ",222,"ل",1,0],["وما خاف لما رأى منه ما دهى","ولا كان من أهواله يتهيب",223,"ب",1,0]]}