 البيوت شوازيا","https://www.aldiwan.net/poem15127.html","الطويل"],[465,"تلقاك يا سعد بالنجح سعد","https://www.aldiwan.net/poem3152.html","عموديه"],[465,"سلا عنك قلبي بعد ما قيل لا يسلو","https://www.aldiwan.net/poem3165.html","عموديه"],[465,"سمو كما تهدى على العجم والعرب","https://www.aldiwan.net/poem3260.html","عموديه"],[465,"سقى دمع العين لا دموع الغمائم","https://www.aldiwan.net/poem3271.html","عموديه"],[465,"سقى الله أطلال ما صبا","https://www.aldiwan.net/poem3384.html","عموديه"],[480,"أساءت لمن لم يبد منه لها ذنب","https://www.aldiwan.net/poem36914.html","الطويل"],[480,"سألت عليك القبر لو نطق القبر","https://www.aldiwan.net/poem37592.html","الطويل"],[480,"فم الإحساس أصبح في افترار","https://www.aldiwan.net/poem37620.html","الوافر"],[483,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[491,"ألا علِّلاني واعلما أنني غرر","https://www.aldiwan.net/poem654.html",""],[501,"علام الهموم وفيم العنا","https://www.aldiwan.net/poem37695.html","المتقارب"],[502,"أجدك لم تعرف أثافي دمنة","https://www.aldiwan.net/poem2247.html","الطويل"],[506,"الغيْب","https://www.aldiwan.net/poem27791.html","الوافر"],[515,"ينم عليه الدمع وهو جحود","https://www.aldiwan.net/poem20831.html","الطويل"],[530,"نظام يا ابن ودي أم لآلي","https://www.aldiwan.net/poem37270.html","الوافر"],[530,"لعمرك ما جانبت في الحق لي رهطا","https://www.aldiwan.net/poem37346.html","الطويل"],[549,"تحُذرني كي أحذر العام خثعما","https://www.aldiwan.net/poem1187.html",""],[552,"ما للقلوب غداة السبت مزعجة","https://www.aldiwan.net/poem47250.html","البسيط"],[552,"ألا رب أمر بت أحذر غبه","https://www.aldiwan.net/poem47252.html","الطويل"],[552,"تراءت لنا بالأبرقين بروق","https://www.aldiwan.net/poem47376.html","الطويل"],[552,"سئمت مقامي في الغبينة مغمدا","https://www.aldiwan.net/poem47869.html","الطويل"],[552,"قفا بي على تلك الطلول الرثائث","https://www.aldiwan.net/poem48019.html","الطويل"],[554,"تعز فقد مات الهوى وانتهى الجهل","https://www.aldiwan.net/poem68388.html","الطويل"],[556,"ففر زهير خيفة من عقابنا","https://www.aldiwan.net/poem1924.html","الطويل"],[559,"هو الله ربي هو المبتدا","https://www.aldiwan.net/poem34598.html","المتقارب"],[568,"عذيري من صرف هذا الزمن","https://www.aldiwan.net/poem69497.html","المتقارب"],[576,"أيا دار في جنات عدن له دار","https://www.aldiwan.net/poem2783.html","الطويل"],[576,"سعودك ردت ما ادعاه المنجم","https://www.aldiwan.net/poem3015.html","الطويل"],[576,"هواي لمحبوبي الأول","https://www.aldiwan.net/poem3036.html","المتقارب"],[576,"وصفتك واللاحي يعاند في العذل","https://www.aldiwan.net/poem3040.html","الطويل"],[588,"إلى الله في كشف المهمات نرغب","https://www.aldiwan.net/poem11511.html","عموديه"]],"verses":[["وما خطت كتابٌ منه كف","ولكن ما كتاب منه خالي",0,"ل",2,0],["وما خلت حتى أصقلتني تجارب","بأن أشر الخلق في الناس حاسد",1,"د",1,0],["وَما خَيرُ عَينٍ خَبا نورُها","وَيُمنى يَدٍ جُذَّ مِنها البَنانُ",2,"ن",1,0],["وَما خِفتُ النَوائِبَ تَرتَمي بي","وَقَد أَقعى بِجامِحِها لِجامي",3,"م",2,0],["وَما خَطَرَت مِنهُ عَلى المَجدِ زَلَّةٌ","فَيَقرَعَ في آثارِها سِنَّ نادِمِ",4,"م",1,0],["وَما خُلِقَت أَقدامُهُم وَأَكُفُّهُم","لِغَيرِ العَوالي وَالظُبى وَالأَسِرَّةِ",5,"ه",1,0],["وما خِلْتُ أنّ البَرقَ يَكْلَفُ بالنّوى","ولَمْ أتّهِمْ إلا القِلاصَ النّواجِيا",6,"ي",2,0],["وما خَصّني زمَني بالعُقوقِ","فكَمْ رِيءَ منْ فاضِلٍ مُبْتَلَى",7,"ل",2,0],["وَما خَصلَةٌ قَد تَذلُّ الرِجالَ","بَأَسوَا وَأَخزَى مِن المَسأَلَه",8,"ل",2,1],["وَما خِلتُ رَأيَ السوءِ عَلَّقَ قَلبَهُ","بِوَهنانَةٍ قَد أَوهَنَتها سِناتُها",9,"ت",3,0],["وَما خِلتُ أَن أَبتاعَ جَهلاً بِحِكمَةٍ","وَما خِلتُ مِهراساً بِلادي وَمارِدا",10,"د",2,0],["وَما خِلتُ أَبقى بَينَنا مِن مَوَدَّةٍ","عِراضُ المَذاكي المُسنِفاتِ القَلائِصا",11,"ص",2,0],["وَما خُلِقتَ لَعَمري","في الشَرقِ إِلّا لِتَبني",12,"ن",2,0],["وَما خِفتُ تَبريحَ الحَياةِ كَما أَرى","تَضيقُ ذِراعي أَن أَقومَ فَأَلبِسا",13,"س",2,0],["وَما خَلَفٌ مِنكُم بِأَطلالِ دِمنَةٍ","تَنَكَّرنَ وَاِستَبدَلنَ مِنكِ السَوافِيا",14,"ي",2,0],["وَما خَيرُ دُنيا بَعدَ آلِ مُحَمَّدٍ","أَلا لا نُباليها إِذا ما اِضمَحَلَّتِ",15,"ت",1,0],["وَما خِفتُ بيَن الحَيِّ حتَىّ تصَدَعَّتَ","عَلى أَوجُهٍ شَتّى حُدوجُ الشَكائِكِ",16,"ك",1,0],["وما خالق الأكوان إلاّ مهندس","وإن جلّ عن تعريفه بالمهندس",17,"س",1,0],["وَما خِفتُ وَشكَ البَينِ حَتّى رَأَيتُهُم","لِظَعنِهِمُ رَدّوا الغُرَيرِيَّةَ البُزلا",18,"ل",2,0],["وما خلتُ الضباب معطفاتٍ","على الحيتان من شَبَه الحُسُولِ",19,"ل",1,1],["وما خفتُ من جهلِ العذول وإنما","بغيضٌ إليَّ الجاهل المتعاقل",20,"ل",1,0],["وَما خَلَوا مِنهُ طَرفَ العَين لَو عَلِموا","وَما خَلا مِنهُم في كُلِّ أَوقاتِ",21,"ت",1,0],["وما خسَسْتَ الثوابَ المستثاب بها","وأيُّ مُهدٍ إليك الصدق لم يُثَبِ",22,"ب",1,0],["وما خِلْتُنا مستبدِلِي بقعةٍ بها","من الأرض لولا شؤْمُ صاحبِ آمِدِ",23,"د",1,0],["وما خلت أني أستريث سماءه","ويُربَع غيري من جناها ويُخرَف",24,"ف",1,0],["وما خِلتُ نفسي تقتضيني لقاءَكم","فأمنحها لولا شناءتُه المطلا",25,"ل",2,0],["وما خرقتُ ولا ضيّقت في مهلٍ","بل قد رقَقْتُ وقد أوسعت في المهَلِ",26,"ل",1,0],["وما خليلي الخليلُ يُعجبُهُ","تَرْكيَ أموالَهُ وإجمامي",27,"م",2,0],["وَما خُتِمَت أَكتافُكُم لِنُبُوَّةٍ","وَأَستاهُكُم ما فَسَّحَتها المَنابِرُ",28,"ر",1,0],["وَما خِلتُها إِلّا دَوالِحَ أوقِرَت","وَكُمَّت بِحَملٍ نَخلُها وَفَسيلُها",29,"ل",3,0],["وَما خِفتُ مِنها البَينَ حَتّى تَزَعزَعَت","هَماليجُها وَاِزوَرَّ عَنّي دَليلُها",30,"ل",3,0],["وَما خِفتُ بَينَ الحَيِّ حَتّى رَأَيتُهُم","لَهُم بِأَعالي الجَلهَتَينِ حُمولُ",31,"ل",1,0],["وَما خَطَّتِ الأَقلامُ إِلّا وَأَدمُعي","تَخُطُّ كِتابَ الشَوق في صَفحَة الخَدِّ",32,"د",1,0],["وما خذلتني في بلاء سجية","وبعض السجايا خاذل ونصير",33,"ر",1,0],["وَما خَلا خَليفَةٌ مُسوّدُ","مِن طالِبيٍّ يَطلُبُ الأَمرَ سُدى",34,"ا",1,0],["وَما خَضَبَ الناسُ البَياضَ لِأَنَّهُ","قَبيحٌ وَلَكِن أَحسَنُ الشَعرِ فاحِمُه",35,"م",2,0],["وَما خِلتُني وَالحادِثاتُ مِنَ الحَصى","أُخَيَّبُ مِن مالي وَيَغنَمُ ناهِبُه",36,"ب",2,0],["وَما خِلتُ الفَخارُ يَكونُ يَوماً","نَصيبُكَ فيهِ أَعلى مِن نَصيبي",37,"ب",2,0],["وَما خِفتُ جِدّي في الصَديقِ يَسوءُهُ","ولَكِنَّ كَثيراً مايَخافُ مُزاحي",38,"ح",2,1],["وَما خِلتُكَ ابنَ الأَنجُمِ الزُهرِ سائِراً","وَتارِكَ نُعماكَ الَّتي شُهِرَت عَدّا",39,"د",2,0],["وَما خِلتُها مَأخوذَةً بِصَبابَتي","صَحائِفُ تُمحى بِالرِياحِ سُطورُها",40,"ر",3,0],["وَما خِلتُ تُبكى بَعدَ قَيصَرَ خُلَّةٌ","لِكُلِّ مُحِبٍّ قَيصَرٌ مِثلَ قَيصَري",41,"ر",2,0],["وَما خَيرُ يَومَيَّ الَّذي أَزَعُ الصِبا","لَهُ وَأُحَلّى بِالنُهى وَأُمَتَّعُ",42,"ع",1,0],["وَما خَفَضَت جَدّاتُ بَكرٍ أَرومَتي","وَلا عَطِلَت مِن ريشِ أَحسابِها سَهمي",43,"م",2,0],["وَما خَطَري دونَ الغِنى إِن بَلَغتُهُ","سُؤالاً وَلا عِرضي نَظيرُ الدَراهِمِ",44,"م",1,0],["وَما خافَ شَيءٌ لَم يَمُت مِن مَخافَةٍ","كَما قَد أَسَرَّت في فُؤادي ضَمائِرُه",45,"ر",2,0],["وَما خِفتُ وَشكَ البَينِ حَتّى رَأَيتُها","يُساقُ عَلى ذاتِ الجَلاميدِ عيرُها",46,"ر",3,0],["وَما خِفتُها إِن أَنكَحَتني وَأَشهَدَت","عَلى نَفسِها لي أَن تَبَجَّسَ غولُها",47,"ل",3,0],["وَما خاصَمَ الأَقوامَ مِن ذي خُصومَةٍ","كَوَرهاءَ مَشنوءٌ إِلَيها حَليلُها",48,"ل",3,0],["وما خَفا البَرقُ إلا عادَ يُذكِرهُ","من الثَّنِيَّةِ أَجزاعاً وأخيافا",49,"ف",2,0],["وما خِلْتُ صَفْعَانَ العراقِ يَسومُني","لأمثالِهِ ذمّاً يَسيراً ولا حَمْدا",50,"د",2,0],["وَما خَلَقَ الإِنسانُ إِلّا لِغايَةٍ","وَلَم يَترُكِ الإِنسانَ في الأَرضِ مُهمَلا",51,"ل",2,0],["وَما خَيَّرتَ أَينَ حَلَلتَ إِلّا","وَصَلتُ إِلَيكَ إِدلاجي بِسَيري",52,"ر",2,0],["وَما خَفَقَت جَناحُ الجَيشِ إِلّا","رَأوني مِلءَ قَلبِ العَسكَرَينِ",53,"ن",1,0],["وما خمدتْ لوعةٌ تلتظي","ولا جَمَدَتْ عَبرةٌ جاريه",54,"ي",2,0],["وما خارَ عُودي عندَ غَمزِ مُلِمَّةٍ","وهل خارَ عِندَ الغمزِ في يَدِكَ النبعُ",55,"ع",1,0],["وما خلتُ أنّ النّارَ يَبْرُدُ حَرّها","على سَعَفٍ لاقته في القيظِ يابِسا",56,"س",2,0],["وَما خَيرُ حِلمٍ لَم تَشُبهُ شَراسَةٌ","وَما خَيرُ لَحمٍ لا يَكونُ عَلى عَظمِ",57,"م",1,0],["وَما خَيرُ بَرقٍ لاحَ في غَيرِ وَقتِهِ","وَوادٍ غَدا مَلآنَ قَبلَ أَوانِهِ",58,"ن",2,0],["وَما خَلفَ أَجفاني شُؤونٌ بَخيلَةٌ","وَلا بَينَ أَضلاعي لَها حَجَرٌ صَلدُ",59,"د",1,0],["وَمَا خَيْرُ دُنْيَا لا بَقَاءَ لِعَهْدِهَا","وَمَا طِيبُ عَيْشٍ رَبُّهُ غَيْرُ سَالِمِ",60,"م",1,0],["وَما خَطا قادِماً فَوافى","حَتّى اِنثَنى ناكِصاً فَآبا",61,"ب",2,0],["وما خُطَطُ الدُّهاةِ بِمُغنياتٍ","إذا خُطَطٌ بأنقرةٍ قضينا",62,"ن",2,0],["وَما خَفِيَ الصَوابُ عَلى عَليمٍ","وَلا اِحتاجَ الضِياءُ إِلى مِثالِ",63,"ل",1,0],["وما خفت والآساد تزأر في الشرى","فكيف بخوفي من رويبضة الجحر؟",64,"ر",1,0],["وَما خِفتُ بَينَ الحَيِّ حَتّى تَذَأَّبَت","نَوىً لَم أَخَل ما كانَ مِنها بِكائِنِ",65,"ن",1,0],["وَما خُلِقَت تَيمٌ وزَيدُ مَناتِها","وَضَبَّةُ إِلّا بَعدَ خَلقِ القَبائِلِ",66,"ل",1,0],["وَما خَبَرتُ الَّذي فيها فَأذكره","لَكِن أَتَتني بِما فيهِ الأَخابيرُ",67,"ر",1,0],["وَما خِفنا مِنَ الناسِ","وَهَل في الناسِ إِنسانُ",68,"ن",1,0],["وما خُلُقِي مَدْحُ اللَّئِيمِ وَإنْ عَلَتْ","بهِ رُتَبٌ لا أَنَّني مُتَكَبِّرُ",69,"ر",1,0],["وما خِلتُ أنَّ الروْضَ يختالُ ماشِياً","ولا أن أرَى في أظهُرِ الخيل عَبقرا",70,"ر",2,0],["وما خلفَه من حطيمٍ يُزارُ","ولا دونه من مَدىً يُنْتَهَى",71,"ا",1,0],["وما خَفِيَ الرُّشْدُ لكنّما","أضَلّ الحُلومَ اتّباعُ الهوى",71,"ا",1,0],["وما خُلِقَتْ عبَثَاً أُمّةٌ","ولا ترَكَ اللّه قوماً سُدى",71,"ا",1,0],["وَما خُبزُهُ إِلّا كَآوى يُرى ابنُهُ","وَلَم يُرَ آوى في حُزونٍ وَلا سَهلِ",72,"ل",1,0],["وَما خُبزُهُ إِلّا كَعَنقاءِ مُغرِبٍ","تُصَوَّرُ في بُسطِ المُلوكِ وَفي المُثلِ",72,"ل",1,0],["وَما خُبزُهُ إِلّا كُلَيبُ بنُ وائِلٍ","وَمَن كانَ يَحمي عِزُّهُ مَنبِتُ البَقلِ",72,"ل",1,0],["وَما خَيرُ كَفٍّ أَمسَكَ الغُلُّ أُختَها","وَما خَيرُ سَيفٍ لَم يُؤَيَّد بِقائِمِ",73,"م",1,0],["وَما خابَ بَينَ اللَهِ وَالناسِ عامِلٌ","لَهُ في التُقى أَو في المَحامِدِ سوقُ",74,"ق",1,0],["وَما خابَ بَينَ الأَجرِ وَالحَمدِ عامِلٌ","لَهُ مِنهُما عِندَ العَواقِبِ زادُ",75,"د",1,0],["وَما خَرَجَت فيهِنَّ حَتّى عَذَلنَها","قِياماً وَحَتّى كادَت الشَمسُ تَخرُجُ",76,"ج",1,0],["وَما خَيرُ عَيشاً لا يَزالُ مُفَجَّعاً","بِمَوتِ نَعيمٍ أَو فِراقِ حَبيبِ",77,"ب",1,0],["وَما خِلتُهُ إِلّا سَيُبعَثُ حادِثاً","يُحِلُّ الثُرَيّا عَن جَبينِ الغَياهِبِ",78,"ب",1,0],["وَما خِلَقُ البيضِ الحِسانِ حَميدَةً","إِذا اِشتَهَرَت أَخلاقُهُنَّ الدَمائِمُ",79,"م",1,0],["وَما خِلتُ السِماكَ وَلا أَخاهُ","عَلى خَلقَيهِما لا يَهرَمانِ",80,"ن",1,0],["وَما خِلتُ سَلمى قَبلَها ذاتَ رِجلَةٍ","إِذا قَسوَريُّ اللَيلِ جيبَت سَرابِلُه",81,"ل",2,0],["وَما خَليجٌ مِنَ المَرّوتِ ذو حَدَبٍ","يَرمي الضَريرَ بِخُشبِ الطَلحِ وَالضالِ",82,"ل",1,0],["وَمَا خُنتُ ذا عَهدٍ وأُبتُ بِعَهدِهِ","وَلم أَحرِمِ المضُطَرَّ إذ جاءَ قانِعا",83,"ع",2,1],["وَمَا خِلْتَنِي فَوْقَ الَّذِي أَنَا كُنْتُهُ","فَفِيمَ أَرَى حَيّاً قِيَامَ تَمَاثِيلي",84,"ي",1,0],["وَمَا خِفْتُ فِي أنْ أُلْفى كَغَيْرِيَ مُولَعاً","بِخَلْعِ أَحِبَّائي كَخَلْعِ ثِيَابِي",85,"ب",2,0],["وَمَا خُلِقَتْ لِمَا يَخْلُبُ النُّهَى","مِنَ النَّحْتِ وَالتَّصْويرِ وَالنَّظْمِ وَالنَّثْرِ",86,"ر",1,0],["وما خَطبنا إلى قوم بَناتِهمُ","إلاّ بأرْعَن في حافاتِه الحَرَقُ",87,"ق",1,0],["وما خافَ يا أمُّ بل ضمَّني","وألقى على مَبْسَمي نجمتينْ",88,"ن",1,0],["وما خُلِقَتْ إلاّ لعزمٍ نفوسُنا","كأنَّا خُلِقْنا من غُبار الجحافل",89,"ل",1,0],["وما خضعَ النصرُ الأشمُّ لفاتحٍ","إذا لم يكُنْ من خيرة السادةِ الشُّمِ",90,"م",1,0],["وما خص هذا الخطبُ مصرَ، وإنما","رأَيت بلادَ الشرق فيه سواسيا",91,"ي",2,0],["وما خاب شعبٌ بهَذِي السماءِ","قويُّ الصِّلاتِ، وثيقُ العُرَا",92,"ر",2,0],["وما خلفتمو بين الزُّ","نُوج وبيننا فرقا",93,"ق",2,0],["ومَا خَيْرُ عَيْشٍ لاَ يَزَالُ مُفجَّعاً","بموت نعيمٍ أو فراق حبيب",94,"ب",1,0],["وما خلفت في الجو من خطراتها","وما خلعت من مرقصات على الربى",95,"ب",2,0],["وما خِلْتُني عبْءا عليهم وأنهم","يريدون أن يُجتَثَّ متنٌ وكاهل",96,"ل",1,0],["وما خلت أني في العراق جميعِه","سأفقِدُ حراً عن مغيبي يسائل",96,"ل",1,0],["وَما خَيْرُ يَوْمَيّ الذي أزِعُ الصِّبَى","لَهُ، وأُحَلّي بالنّهَى، وأُمَتِّعُ",97,"ع",1,0],["وما خلوا منه طرف عين لو علموا","وما خلا منهم في كل أوقات",98,"ت",1,0],["وما خِلْتُ نفسي تقتضيني لقائكم","فأمنحها لولا شناءتُه المطلا",99,"ل",2,0],["وَما خَطَّتِ الأَقلامُ إِلّا وَأَدمُعي","تَخُطُّ سُطور الشَّوق في صَفْحَة الخَدِّ",100,"د",1,0],["وما خيرُ شعب لستَ تعثرُ بينه","على قارئٍ من كلِّ ألفٍ وكاتب",101,"ب",1,0],["وَما خَفيت عَلَيَّ الناس حَتّى","أَروم اليَوم مِن رَخم حَليبا",102,"ب",2,0],["وما خنت والله الصديق ولم امل","اذا لم يمل عنى الخلل ويغدر",103,"ر",1,0],["وما خير علمٍ في الحياة وفطنةٍ","إذا حال ضعف العزم دون المطالب",104,"ب",1,0],["وَما خَشيت عَواقِبَ نارَ هَجوِي","إِذا حُضِئت مُيمِّمةً قَبيلا",105,"ل",2,0],["وَما خَفيتَ عَلى ذي فِطنَةٍ نَسَباً","إِذا النَدى وَالوَغى قالا لَكَ اِنتَسَبِ",106,"ب",1,0],["وَما خِفتَ إِلّا اللَهَ فيما وَليتَهُ","وَلا حِفتَ في الأَفعالِ سَهواً وَلا عَمدا",107,"د",2,0],["وَما خِلتُ قَبلَ بُلوغي إِلَيكَ","أَنَّ الغِنى مِن دَواعِ الحَصَر",108,"ر",1,0],["وَما خِلتُ أَنَّ الدَهرَ يُلجِئُني إِلى","زَمانٍ يَبيتُ العَجزُ فيهِ مُضاجِعي",109,"ع",2,0],["وَما خُلِقا إِلّا لِإِفناءِ قاسِطٍ","يُخافُ وَيُرجى أَو لِإِغناءِ قانِعِ",109,"ع",1,0],["وَما خِلتُ أَنَّ الشَمسَ قَبلَ مُصابِهِ","تُضامُ وَلا زُهرَ المَجَرَّةِ تُرتَعا",110,"ع",2,0],["وَما خَرِسَت بِها الأَبطالُ حَتّى","تَكَلَّمَتِ الصَوارِمُ وَالصَواهِل",111,"ل",1,0],["وَما خَلا مِن جَزيلِ العُرفِ مُنتَجِعٌ","كَلّا وَلا مِن جَميلِ الصَفحِ مُجتَرِمُ",112,"م",1,0],["وَما خَصَصتَ عَدُوّاً دونَ صاحِبِهِ","إِلّا لِيُنذِرَ بَعضُ القَومِ بَعضَهُمُ",112,"م",1,0],["وما خوفي عَلَى رُوحي وَلَكنْ","عليهِ منْ معاقبةِ الذنوبِ",113,"ب",1,0],["وما خص أرض دون أرضك وحشة","فراقك بل عم البلاد وما استثنا",114,"ن",2,0],["وما خابَ من كان الرجاء يقودهُ","إِليك إِلى العلَم المزيّد بالندى",115,"د",2,0],["وما خالف الأمر المشد ولا انثنى","لترك وكم عذر به يوجب التركا",116,"ك",2,0],["وما خطب العلا بالسيف كفو","فكان سوأه اولى بالنكاح",117,"ح",1,0],["وما خلوا سبيل العيس حتى","حلفت لهم يمينا لا تمين",118,"ن",1,0],["وما خص بالإِيمان فرعون وحده","لدى موته بل عمّ كل الكوافر",119,"ر",1,0],["وَما خِلتُ قَبراً وَهوَ أَربَعُ أَذرُعٍ","يَضُمُّ ثِقالَ المُزنِ وَالطَود وَالبَحرا",120,"ر",2,0],["وَما خَيرُ أَرضٍ لا يَزالُ كَريمُها","مُهاناً وَنَذلُ القَومِ فيها مُكَرَّما",121,"م",2,0],["وما خير علم ليس ينهى عن الهوى","ولا يمنع النفس اللجوج ضلالها",122,"ل",3,0],["وَما خيرُ دين ليسَ تُدركه النهى","تَغورُ عَلى أَغوارِ أسراره غورا",123,"ر",2,0],["وما خير المعيشة لابن إرب","إذا افترقت إلى الجهل العقول",124,"ل",1,0],["وما خلتُ هذا الكونَ إلا كوجنةٍ","عليها الدُّجى فيما أشبههُ خالُ",125,"ل",1,0],["وما خوف أطفال أبوهم مجاهد","على نائبات الدهر بالباس يزحف",126,"ف",1,0],["وَما خِفتُ مِنها البَينَ حَتّى رأَيتُها","مَيمِّمَةً نَحوَ القُرَيَّةِ عيرُها",127,"ر",3,0],["وما خذلْتني همّتي فألومها","وما ضاق بي مذ كنتُ في محفِلٍ عِلمي",128,"م",2,0],["وَما خَلَفَتكِ بانَتُها وَلَكِن","حَكَت ذاكَ التَعَطُّفَ وَالتَثَنّي",129,"ن",2,0],["وَما خَلَت مِنهُمُ المَغاني","وَلا عَفَت مِنهُمُ الرُبوعُ",130,"ع",1,0],["وما خسر الضدان فهو غنيمة","فقد ضربوا نجداً بمصر وحزبوا",131,"ب",3,0],["وَما خَضَعَ الفرنجُ لَدَيكَ حَتّى","رأوا مالا يُطاقُ مِن الكِفاحِ",132,"ح",1,0],["وما خلق النساء البظر إلا","وبالاً حيث كان على الرجال",133,"ل",1,0],["وما خيط ما حاك الخد رنق في الفلا","وإحصاء رمل الخبت في فلواته",134,"ت",2,0],["وما خلت لولا الدمع تبدو وسرائري","ولا خلته ينهل لولا تدافقه",135,"ق",2,0],["وَما خالَفَت غرْناطةٌ رَأي رَيّة","لتَشْمُلَ أنْوارَ الهُدى كُل جانِبِ",136,"ب",1,0],["وما خَيْرُ السَّلامَةِ فِي حَياةٍ","إِذا كانَتْ إِلى عَطَبٍ تَؤُولُ",137,"ل",1,0],["وَما خانَنِي مِنْ هِمَّةِ تَأْمُلُ الْعُلى","سِوى أَنَّ أَسْبابَ الْقَضَاءِ تَعُوقُها",138,"ق",3,0],["وَما خافَ مَن أَنا مَملوكُهُ","وَلَيسَ سِوى المَلِكِ الكامِلِ",139,"ل",1,0],["وَما خيّمت بالمُنحنى من مُحجّرٍ","وَلكن ضُلوعي المنحنى والمخيَّمُ",140,"م",1,0],["وَما خلقُهم إلّا وفاقٌ لحكمةٍ","بِها تمّ تأليفُ الوجود ونظمهُ",141,"م",2,0],["وَما خسرَ الإنسانُ وجهَ سعادةٍ","إِذا مِن فنونِ العلمِ وُفِّرَ سهمهُ",141,"م",2,0],["وَما خَبرت إلّا إِباء حفيظةٍ","تَفيءُ لعزٍّ يَفرع الفرغَ والشرطا",142,"ط",2,0],["وَما خِلنا الفتورَ له فتونٌ","تُغالُ به النهى سكراً وسحرا",143,"ر",2,0],["وَما خُسِرَ الفرع الذويُّ بنبتهِ","مَخافةَ أَن تستأصلَ العلّة الجذرا",144,"ر",2,0],["وَما خلتُ أنّ المسكَ بالعتب حالمٌ","وَللمسك في عنوانه نفحة تُصبي",145,"ب",2,0],["وَما خلت أنّي حين يطمو عبابها","أَرى حظّ غيري النون وحظّي الضبا",146,"ب",2,0],["وماَخامَ عَنها يَومَ سارَت جُموعُنا","لِأَهلِ قُدَيسٍ يَمنَعونَ المَوالِيا",147,"ي",2,0],["وَما خابَ مَن لَم يَأَتِهِ مُتَعَمِّداً","وَلا فازَ مَن قَد نالَ مِنهُ وُصولا",148,"ل",2,0],["وَما خَفضت قَدري لِرفعةِ قَدرِها","على نصبِ أَشراك الجُفون سِوى كسرَه",149,"ر",2,0],["وَما خاض إِلّا لجّة العَفو وَالرضى","وَما حَلَّ أَرّخ في سِوى جَنة الخُلدِ",150,"د",1,0],["وما خير معروف الفتى في شبابه","إذا لم يزده الشيب حين يشيبُ",151,"ب",1,1],["وما خُلِقْنا حَماماتٍ لنُطْرِبَكمْ","شَجْواً ونَملِكَ أطْواقاً منَ الخِلَق",152,"ق",1,0],["وما خطَرتْ إلاّ برمَلْة عالجٍ","ولا عَطِرتْ إلاّ بحاشيتَيْ بُرد",153,"د",1,0],["وما خلْتُ ألحانَ الأعاجمِ قبلَها","تَشوقُ وتَشجو عِليةَ الفُصحاء",154,"ا",2,0],["وَما خَلَوتُ بِذِكراكُم وَكانَ مَعي","ثانٍ يُثَلِّثُ ذِكراكُم سِوى الكَرَمِ",155,"م",1,0],["وَما خَيرُ عَيشٍ نِصفُهُ سِنَةُ الكَرى","وَنِصفٌ بِهِ يَعثَلُّ أَو يَتَوَجَّعُ",156,"ع",1,0],["وَما خَدَعَتني مِصرُ عَن طيبِ دارِها","وَلا عَوَّضَتني بَعدَ جارِيَ جارا",157,"ر",2,0],["وماخلت أن الحال بعد ثبوتها","سيفجؤها أمرٌ من السح قاطع",158,"ع",1,0],["وما خلت أن الدهر ينقض عهده","فتدرك فينا للأعادي مطالب",159,"ب",1,0],["وما خفت منها البين حتى رأيتها","علا غيرها في الصبح أصوات سائِق",160,"ق",1,0],["وماخشيت عليك من الأعادي","ولكن من خيانة مستريب",161,"ب",1,0],["وما خلتماه مشكلاً متشابهاً","فقولا وكلناه إلى علم باريه",162,"ي",2,0],["وما خاف مولاكم عليهم وإنما","غدا منفقاً أموالهم في العمائر",163,"ر",1,0],["وَما خُضتَ جَيشاً بِالدِماءِ مُضمَّخاً","يَرى بيضُهم مِثلَ الحَبابِ عَلى الخَمرِ",164,"ر",1,0],["وَما خَيَّبَ الدهر الخؤون لِطالِبٍ","وَلاذَ بِها إِلّا أَتَتهُ الفَوائِدُ",165,"د",1,0],["ومَا خِلْتُه مَهوَى الهَوى ومَقِيلَهُ","ومَأوى الأسى والبَثِّ عند هُدوِّهِ",166,"و",2,0],["وما خلتُ آسادَ الشرى إذْ تَبَهْنَستَ","فرائسَ غِزلانِ الصّرِيمةِ إذ تعطو",167,"ط",2,0],["وَما خُلِقَت إِلّا لِبَذلٍ أَكُفُّهُم","وَأَلسُنُهُم إِلّا لِتَحبيرِ مَنطِقِ",168,"ق",1,1],["وما خَلَفْتُ للغرام طاعةً","وما نَكَثْتُ حبلها المتينا",169,"ن",2,0],["وما خَفِيَتْ تلك المزايا وإنَّما","تلوحُ كما لاح الصَّباح لرائي",170,"ي",1,0],["وما خاب ظنِّي في جميلك قبلَها","وما كنتَ للظنِّ الجميل مخيّبا",171,"ب",2,0],["وما خابَ راجيكم ليومٍ عَصَبْصَبٍ","يريه الرَّدى يوماً من الروع أَيْوما",172,"م",2,0],["وما خُلِقَ الإِحسان إلاَّ لصالحٍ","ولا خُلق الصَّمصام إلاَّ لفاجر",173,"ر",1,0],["وما خَفَيت حال عليك ظهورها","وكيف وسرُّ العَبد عندك جهره",174,"ر",2,0],["وما خدَعوني باللِوى غيرَ أنهُم","لوَوْا نحو المطامعِ أخدَعي",175,"ع",2,0],["وما خلطتَ الدرّ في","لفظي بالمُخشَلِبِ",176,"ب",1,0],["وما خلت أن أبقى وأرثيك بعدما","غدت مدحي في تاج علياك توضع",177,"ع",1,0],["وما خلتُ أن الدهر تخني صروفهُ","ولكن دهري ليس تقضى عجائبه",178,"ب",2,0],["وما خصّني من حسن خلق وخلقةٍ","ومنطق فصل أستطيش به الحلما",179,"م",2,0],["وَمَا خَطَّهُ أَثَرٌ عن أَميرٍ","وسَطَّرَهُ أَرَبٌ عن أَرِيبِ",180,"ب",1,0],["وما خَفَرَتْ بِيضُ الصَّوارِمِ والقَنا","مَحاسِنَها مِمَّا أَصابَ فَأوْلَها",181,"ل",3,0],["وما خلق الباري فليس بعالم","سواهم يسمى بين نعت وأَوصاف",182,"ف",1,0],["وما خلد الحياة لنا ولكن","لذرت سبحن بكل شمس",183,"س",1,0],["وما خلتُ وِرد الماءِ بابا إلى الصدى","ولا أنّ عومَ البحر ضربٌ من الدفنِ",184,"ن",1,0],["وما خلتُ أنَّ بيوتَ النبي","طِ يَحذَرُ فيها ليوثُ الأجَمْ",185,"م",1,0],["وما خطبٌ أجبتُ نداءَ حزني","له ودعوتُ يا دمعي نزولا",186,"ل",2,0],["وما خلتُني أمشي على البحر ظامئاً","وخِمس فمي منه بما بلَّ قانعُ",187,"ع",1,0],["وما خمدتْ بذي العلمين نارٌ","يشيمُ ضيوفُ مُوقدها ضلوعي",188,"ع",2,0],["وما خشُنتْ إلا وقلتُ دعي غداً","لكلِّ غدٍ رزقٌ مع الشمس يطلعُ",189,"ع",1,0],["وما خلتُ لي واسطاً عُقْلةً","تعلِّم نومِيَ أن يَشرُدا",190,"د",2,0],["وما خلتُ قبل أنَّ عيناً ركيَّةٌ","ولا أنّ مِلح الماقِيَيْنِ شَروبُ",191,"ب",1,0],["وما خِلتُ أن البدرَ يطلُعُ مُصعِداً","ولا أنَّ ريح المكرماتِ جَنوبُ",192,"ب",1,0],["وما خزريٌ لهْذمٌ هجمَتْ به","صناعُ يدٍ في رأس أغيْدَ ذابل",193,"ل",1,0],["وما خلتُ في خمس وعشرين شيبةً","سوى أن همّاً أشعل الرأس زائد",194,"د",1,0],["وما خنعوا لك من ذلةٍ","وفيهم سرحٌ مخوفٌ وجند",195,"د",1,0],["وما خير ملك فارقته ملوكه","وتيجانها من مثل جوهرها عطل",196,"ل",1,0],["وما خلعوا إلا سناك على الحلى","كما لاح نور البدر في خلل السحب",197,"ب",1,0],["وما خطرت قضبانها وتراقصت","شمائلها إلا لشدو الحمائم",198,"م",1,0],["وما خانني إلاّ الشبابُ فأنني","وثقتُ بعهدٍ منهُ غير وثيق",199,"ق",1,0],["وما خلت أن الدار تسعى لربها","إلى أن غدا يسعى لساكنه القلب",200,"ب",1,0],["وما خنت عهدي في الوصية إنما","تأخرت في التأبين مذ خانني الشعر",201,"ر",1,0],["وما خلف الحجاب سوى ركاز","كما قص الكتاب عن الجدار",202,"ر",1,0],["وما خان سيف العزم لما تأججت","أسود الوغى ما كنت عن عطفها ثان",203,"ن",1,0],["وما خاننا لما تضعضع ركنه","وصارت به العنقا على إثر أظعان",203,"ن",1,0],["وَما خِلتُ يُجديني أَساتي وَقَد بَدَت","مَفاصِلُ أَوصالي وَقَد شَخَصَ البَصَر",204,"ر",1,0],["وما خاب قط بقصد السبي","لِ فتى ضمهث السير في ركبنا",205,"ن",2,0],["وَما خِلتُ أَنّي نِلتُ مالَ عَشيرَةٍ","وَلا حِيبَةً إِنَّ الأُمورَ تُفَرَّجُ",206,"ج",1,0],["وما خلقُ بني آدم إلا","ليختاروا على علمٍ فغِرتُ",207,"ت",1,0],["وما خِلْتُ أنّ اللّدْنَ والصّبْرُ لامتي","تُمكّنُ فيّ الطّعنَ وهيَ قُدودُ",208,"د",1,0],["وما خَبَرُ الْحُدودِ حَدِيثُ صِدْقٍ","وَلكِنْ عُدَّ في قِيل وَقَال",209,"ل",1,0],["وما خِفْتُ في ذا الصُّنْعِ لَوْمَةَ لائِمٍ","تَلَهّبَ غَيْظاً واسْتَشاطَ لَهُ سُخْطا",210,"ط",2,0],["وَما خَثعَمُ إِلاّ لِئامٌ أَذِلَّةٌ","إِلى الذُلِّ وَالإِسحاقِ تَنمى وتَنتَمي",211,"ي",1,0],["وما خُصِصتَ بمكروهٍ تجلّلنا","ونحن قبلك بالبَأْساءِ نَسْتَهِمُ",212,"م",1,0],["وما خانني التّدبير فيه وإنّما","قضاءٌ جرى فيما سخطتُ مبرَّمُ",213,"م",1,0],["وَما خلتُ إلّا الوَرْسَ في الأفقِ إنّه","متى لم يَكُنْهُ الورس فَهْوَ خَلوقُ",214,"ق",1,0],["وما خِيفةُ الإنسان إلّا غباوةٌ","وخوفُ الرّدى للمرءِ شرٌّ من الرّدى",215,"د",2,0],["وما خَزِيَتْ منّا رؤوسٌ بريبةٍ","تُكشّفها في النّاسِ نبثةُ نابِثِ",216,"ث",1,0],["وَما خَوَّلَتكَ المَكرُماتُ سَجِيَّةً","حُبيتَ بِها إِلّا وَأَنتَ لَها أَهلُ",217,"ل",1,0],["وَما خِلتُني لِاِبنِ الأَغَرِّ مُثَمِّراً","وَما خِلتُني أَجني عَلَيهِ الجَرائِما",218,"م",2,0],["وما خبر المبتدا عينه","نعم غيره هكذا أشهدا",219,"د",2,0],["وَمَا خَانَنِي الرَّأْيُ لَكِنَّنِي","أَرَى رَأْيَهُ بِي عَيْنَ الأَفَنْ",220,"ن",1,0],["وما خصَّ مصراً وحدها رزؤُها بِه","لقد رُزِئَتْه في البَسيطَةِ أَمصَارُ",221,"ر",1,0],["وما خَدَمُوا الأَفلاكَ إِلاَّ لأَنها","بأَمرِك تَجْري أَو لأَمْرِك تَخْدُمُ",222,"م",1,0],["وما خفتُ من أَسدٍ أَمرَه","وقد مِتُّ من رشإِ أَكْحَل",223,"ل",1,0],["وما خالَفَتْك الجُردُ قَطُّ وإِنَّها","لَتَلْحقُ مَنْ عَادَيْتَه وَهْيَ في الشَّكْلِ",224,"ل",1,0],["وما خاف لما رأى منه ما دهى","ولا كان من أهواله يتهيب",225,"ب",1,0]]}