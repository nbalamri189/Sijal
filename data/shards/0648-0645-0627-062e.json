{"poems":[[53,"ذكرتك ذكرة لا ذاهل","https://www.aldiwan.net/poem29734.html","المتقارب"],[53,"متى أنا قائم أعلى مقام","https://www.aldiwan.net/poem29753.html","الوافر"],[53,"ألا خبر عن جانب الغور وارد","https://www.aldiwan.net/poem29768.html","الطويل"],[53,"عذيري من العشرين يغمزن صعدتي","https://www.aldiwan.net/poem30678.html","الطويل"],[63,"بعيشكما يا صاحبي دعانيا","https://www.aldiwan.net/poem46218.html","الكامل"],[77,"جزتني غرناطة بعد ما","https://www.aldiwan.net/poem35718.html","المتقارب"],[42,"وما خصلة قد تذل الرجال","https://www.aldiwan.net/poem50266.html","المتقارب"],[9,"أجد بتيا هجرها وشتاتها","https://www.aldiwan.net/poem21916.html","الطويل"],[9,"أجدك ودعت الصبى والولائدا","https://www.aldiwan.net/poem21922.html","الطويل"],[9,"لعمري لئن أمسى من الحي شاخصا","https://www.aldiwan.net/poem21947.html","الطويل"],[86,"يا يوم تكريم حفني","https://www.aldiwan.net/poem68862.html","المجتث"],[0,"الما على الربع القديم بِعسعسا","https://www.aldiwan.net/poem62.html",""],[35,"وقفت عليه ناقتي فتناعت","https://www.aldiwan.net/poem38814.html","الطويل"],[54,"ألا ما لعيني بالدموع استهلت","https://www.aldiwan.net/poem27437.html","الطويل"],[30,"أقول لأطلاح برى هطلانها","https://www.aldiwan.net/poem29552.html","الطويل"],[88,"بني وطني ماذا أؤمل بعدما","https://www.aldiwan.net/poem44979.html","الطويل"],[27,"عشية أعلى مذنب الجوف قادني","https://www.aldiwan.net/poem5953.html","الطويل"],[37,"وما خلت الضباب معطفات","https://www.aldiwan.net/poem7427.html","الوافر"],[72,"له كل يوم فيك واش وعاذل","https://www.aldiwan.net/poem19479.html","الطويل"],[64,"سر السرائر مطوي بإثبات","https://www.aldiwan.net/poem67661.html","البسيط"],[51,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8298.html","البسيط"],[51,"رقدت وما ليل الغريب براقد","https://www.aldiwan.net/poem61941.html","الطويل"],[51,"بنفسي أمير أنصف الناس كلهم","https://www.aldiwan.net/poem65473.html","الطويل"],[51,"تذكرت ما سخى بنفسي عنكم","https://www.aldiwan.net/poem65858.html","الطويل"],[51,"لا زلت تبلغ أقصى السؤل والأمل","https://www.aldiwan.net/poem65993.html","البسيط"],[51,"يأبى لي الضيم فرعي السامي","https://www.aldiwan.net/poem66320.html","المنسرح"],[29,"بنو أسد رجلان رجل تذبذبت","https://www.aldiwan.net/poem6071.html","الطويل"],[29,"ألا طرقت أروى الرحال وصحبتي","https://www.aldiwan.net/poem6158.html","الطويل"],[29,"دنا البين من أروى فزالت حمولها","https://www.aldiwan.net/poem6159.html","الطويل"],[29,"محا رسم دار بالصريمة مسبل","https://www.aldiwan.net/poem6164.html","الطويل"],[78,"كتبت وعندي من فراقك ما عندي","https://www.aldiwan.net/poem14008.html","الطويل"],[85,"شجوني إذا جن الظلام كثير","https://www.aldiwan.net/poem7520.html","الطويل"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[43,"وفاؤكما كالربع أشجاه طاسمه","https://www.aldiwan.net/poem10140.html","الطويل"],[45,"مع الدهر ظلم ليس يقلع راتبه","https://www.aldiwan.net/poem10905.html","الطويل"],[45,"أمردود لنا زمن الكثيب","https://www.aldiwan.net/poem11044.html","الوافر"],[45,"وما خفت جدي في الصديق يسوءه","https://www.aldiwan.net/poem62694.html","الطويل"],[45,"علقنا بأسباب الوزير ولم نجد","https://www.aldiwan.net/poem62763.html","الطويل"],[45,"مغاني سليمى بالعقيق ودورها","https://www.aldiwan.net/poem63610.html","الطويل"],[45,"أراني متى أبغ الصبابة أقدر","https://www.aldiwan.net/poem63635.html","الطويل"],[45,"أحاجيك هل للحب كالدار تجمع","https://www.aldiwan.net/poem64680.html","الطويل"],[45,"أعن سفه يوم الأبيرق أم حلم","https://www.aldiwan.net/poem65673.html","الطويل"],[45,"بني مخلد كفوا تدفق جودكم","https://www.aldiwan.net/poem66639.html","البسيط"],[28,"إلى ملك ما أمه من محارب","https://www.aldiwan.net/poem5115.html","الطويل"],[28,"عرفت بأعلى رائس الفأو بعدما","https://www.aldiwan.net/poem5244.html","الطويل"],[28,"لعمري لقد أردى نوار وساقها","https://www.aldiwan.net/poem5375.html","الطويل"],[28,"فإني كما قالت نوار إن اجتلت","https://www.aldiwan.net/poem5376.html","الطويل"],[61,"تزداد منعا إذا ما رمت إسعافا","https://www.aldiwan.net/poem51555.html","البسيط"],[61,"أما آن للملحي أن ينشر الودا","https://www.aldiwan.net/poem51722.html","الطويل"],[49,"ألا طالما خان الزمان وبدلا","https://www.aldiwan.net/poem63069.html","الطويل"],[66,"زجرت مرور طيركم بسعد","https://www.aldiwan.net/poem38758.html","الوافر"],[66,"أذاب التبر في كأس اللجين","https://www.aldiwan.net/poem40114.html","الوافر"],[80,"يد الدهر جارحة آسيه","https://www.aldiwan.net/poem31251.html","المتقارب"],[80,"أيا جزعي بالدار إذ عن لي الجزع","https://www.aldiwan.net/poem31387.html","الطويل"],[80,"لأمر طويل الهم نزجي العرامسا","https://www.aldiwan.net/poem31418.html","الطويل"],[44,"أبا القاسم اسلم في وفود من القسم","https://www.aldiwan.net/poem29704.html","الطويل"],[44,"سأشكر لابني وهب الهبة التي","https://www.aldiwan.net/poem30340.html","الطويل"],[44,"تجرع أسى قد أقفر الجرع الفرد","https://www.aldiwan.net/poem30542.html","الطويل"],[87,"ألا حي بالمقياس ريا المعالم","https://www.aldiwan.net/poem8288.html","الطويل"],[74,"مر بنا وهو بدر تم","https://www.aldiwan.net/poem12858.html","مجزوء البسيط"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[105,"أتنقم ما يريبك من خلالي","https://www.aldiwan.net/poem43165.html","الوافر"],[39,"أساءك تقويض الخليط المباين","https://www.aldiwan.net/poem53738.html","الطويل"],[39,"نبيت تميما تجتدي حرب طيئ","https://www.aldiwan.net/poem53756.html","الطويل"],[40,"أعاذلي أما للوم تغيير","https://www.aldiwan.net/poem42303.html","البسيط"],[52,"شجاك الحي إذ بانوا","https://www.aldiwan.net/poem26661.html","الهزج"],[67,"ثناؤك من روض الخمائل أعطر","https://www.aldiwan.net/poem18070.html","الطويل"],[75,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[75,"تقدم خطى أو تأخر خطى","https://www.aldiwan.net/poem69107.html","المتقارب"],[48,"على خبز إسماعيل واقية البخل","https://www.aldiwan.net/poem65041.html","الطويل"],[50,"أبا مسلم ما طول عيش بدائم","https://www.aldiwan.net/poem62250.html","الطويل"],[50,"خليلي إن العسر سوف يفيق","https://www.aldiwan.net/poem62322.html","الطويل"],[50,"أخالد لم أخبط إليك بنعمة","https://www.aldiwan.net/poem63917.html","الطويل"],[50,"أخشاب حقا أن دارك تزعج","https://www.aldiwan.net/poem63985.html","الطويل"],[50,"أجارتنا لا تجزعي وأنيبي","https://www.aldiwan.net/poem64831.html","الطويل"],[46,"أجل هبات الدهر ترك المواهب","https://www.aldiwan.net/poem22174.html","الطويل"],[46,"أيا ديك عدت من أياديك صيحة","https://www.aldiwan.net/poem23291.html","الطويل"],[46,"طلبت مكارما فأجدت لفظا","https://www.aldiwan.net/poem23530.html","الوافر"],[1,"أتعرف رسم الدار قفرا منازله","https://www.aldiwan.net/poem34010.html","الطويل"],[19,"عيني لا بد من سكب وتهمال","https://www.aldiwan.net/poem360.html",""],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21060","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55151","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54631","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54888","الطويل"],[9,"","https://poetry.dctabudhabi.ae/diwan/poem/199525","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141999","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54294","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54316","الطويل"],[104,"لك الحمد","https://www.poetsgate.com/ViewPoem.aspx?id=37376",""],[106,"هرم يهوي 2","https://www.poetsgate.com/ViewPoem.aspx?id=179486",""],[106,"صحا الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=179625",""],[106,"سُحقًا لها","https://www.poetsgate.com/ViewPoem.aspx?id=179644",""],[50,"أجَارَتَنَا لاَ تَجْرَعِي وَأنِيبِي","https://www.poetsgate.com/ViewPoem.aspx?id=17154",""],[90,"الأصيل في لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179198",""],[90,"ثورة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=179144",""],[45,"أُحاجِيكَ، هل للحُبّ كالدّارِ تَجمعُ","https://www.poetsgate.com/ViewPoem.aspx?id=31224",""],[64,"سرّ السرائر مَطْوِيٌّ بِاثْبَات","https://www.poetsgate.com/ViewPoem.aspx?id=3135",""],[51,"تذَّكرْتُ ما سخَّى بنفسيّ عنكُم","https://www.poetsgate.com/ViewPoem.aspx?id=30249",""],[78,"كَتَبتُ وَعِندي مِن فراقِكِ ما عِندي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86475&r=&rc=20",""],[90,"لعبة التجارب...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66767&r=&rc=175",""]],"verses":[["وَما خَيرُ عَينٍ خَبا نورُها","وَيُمنى يَدٍ جُذَّ مِنها البَنانُ",0,"ن",1,0],["وَما خِفتُ النَوائِبَ تَرتَمي بي","وَقَد أَقعى بِجامِحِها لِجامي",1,"م",2,0],["وَما خَطَرَت مِنهُ عَلى المَجدِ زَلَّةٌ","فَيَقرَعَ في آثارِها سِنَّ نادِمِ",2,"م",1,0],["وَما خُلِقَت أَقدامُهُم وَأَكُفُّهُم","لِغَيرِ العَوالي وَالظُبى وَالأَسِرَّةِ",3,"ه",1,0],["وما خِلْتُ أنّ البَرقَ يَكْلَفُ بالنّوى","ولَمْ أتّهِمْ إلا القِلاصَ النّواجِيا",4,"ي",2,0],["وما خَصّني زمَني بالعُقوقِ","فكَمْ رِيءَ منْ فاضِلٍ مُبْتَلَى",5,"ل",2,0],["وَما خَصلَةٌ قَد تَذلُّ الرِجالَ","بَأَسوَا وَأَخزَى مِن المَسأَلَه",6,"ل",2,1],["وَما خِلتُ رَأيَ السوءِ عَلَّقَ قَلبَهُ","بِوَهنانَةٍ قَد أَوهَنَتها سِناتُها",7,"ت",3,0],["وَما خِلتُ أَن أَبتاعَ جَهلاً بِحِكمَةٍ","وَما خِلتُ مِهراساً بِلادي وَمارِدا",8,"د",2,0],["وَما خِلتُ أَبقى بَينَنا مِن مَوَدَّةٍ","عِراضُ المَذاكي المُسنِفاتِ القَلائِصا",9,"ص",2,0],["وَما خُلِقتَ لَعَمري","في الشَرقِ إِلّا لِتَبني",10,"ي",1,0],["وَما خِفتُ تَبريحَ الحَياةِ كَما أَرى","تَضيقُ ذِراعي أَن أَقومَ فَأَلبِسا",11,"س",2,0],["وَما خَلَفٌ مِنكُم بِأَطلالِ دِمنَةٍ","تَنَكَّرنَ وَاِستَبدَلنَ مِنكِ السَوافِيا",12,"ي",2,0],["وَما خَيرُ دُنيا بَعدَ آلِ مُحَمَّدٍ","أَلا لا نُباليها إِذا ما اِضمَحَلَّتِ",13,"ت",1,0],["وَما خِفتُ بيَن الحَيِّ حتَىّ تصَدَعَّتَ","عَلى أَوجُهٍ شَتّى حُدوجُ الشَكائِكِ",14,"ك",1,0],["وما خالق الأكوان إلاّ مهندس","وإن جلّ عن تعريفه بالمهندس",15,"س",1,0],["وَما خِفتُ وَشكَ البَينِ حَتّى رَأَيتُهُم","لِظَعنِهِمُ رَدّوا الغُرَيرِيَّةَ البُزلا",16,"ل",2,0],["وما خلتُ الضباب معطفاتٍ","على الحيتان من شَبَه الحُسُولِ",17,"ل",1,1],["وما خفتُ من جهلِ العذول وإنما","بغيضٌ إليَّ الجاهل المتعاقل",18,"ل",1,0],["وَما خَلَوا مِنهُ طَرفَ العَين لَو عَلِموا","وَما خَلا مِنهُم في كُلِّ أَوقاتِ",19,"ت",1,0],["وما خسَسْتَ الثوابَ المستثاب بها","وأيُّ مُهدٍ إليك الصدق لم يُثَبِ",20,"ب",1,0],["وما خِلْتُنا مستبدِلِي بقعةٍ بها","من الأرض لولا شؤْمُ صاحبِ آمِدِ",21,"د",1,0],["وما خلت أني أستريث سماءه","ويُربَع غيري من جناها ويُخرَف",22,"ف",1,0],["وما خِلتُ نفسي تقتضيني لقاءَكم","فأمنحها لولا شناءتُه المطلا",23,"ل",2,0],["وما خرقتُ ولا ضيّقت في مهلٍ","بل قد رقَقْتُ وقد أوسعت في المهَلِ",24,"ل",1,0],["وما خليلي الخليلُ يُعجبُهُ","تَرْكيَ أموالَهُ وإجمامي",25,"م",2,0],["وَما خُتِمَت أَكتافُكُم لِنُبُوَّةٍ","وَأَستاهُكُم ما فَسَّحَتها المَنابِرُ",26,"ر",1,0],["وَما خِلتُها إِلّا دَوالِحَ أوقِرَت","وَكُمَّت بِحَملٍ نَخلُها وَفَسيلُها",27,"ل",3,0],["وَما خِفتُ مِنها البَينَ حَتّى تَزَعزَعَت","هَماليجُها وَاِزوَرَّ عَنّي دَليلُها",28,"ل",3,0],["وَما خِفتُ بَينَ الحَيِّ حَتّى رَأَيتُهُم","لَهُم بِأَعالي الجَلهَتَينِ حُمولُ",29,"ل",1,0],["وَما خَطَّتِ الأَقلامُ إِلّا وَأَدمُعي","تَخُطُّ كِتابَ الشَوق في صَفحَة الخَدِّ",30,"د",1,0],["وما خذلتني في بلاء سجية","وبعض السجايا خاذل ونصير",31,"ر",1,0],["وَما خَلا خَليفَةٌ مُسوّدُ","مِن طالِبيٍّ يَطلُبُ الأَمرَ سُدى",32,"ا",1,0],["وَما خَضَبَ الناسُ البَياضَ لِأَنَّهُ","قَبيحٌ وَلَكِن أَحسَنُ الشَعرِ فاحِمُه",33,"م",2,0],["وَما خِلتُني وَالحادِثاتُ مِنَ الحَصى","أُخَيَّبُ مِن مالي وَيَغنَمُ ناهِبُه",34,"ب",2,0],["وَما خِلتُ الفَخارُ يَكونُ يَوماً","نَصيبُكَ فيهِ أَعلى مِن نَصيبي",35,"ب",2,0],["وَما خِفتُ جِدّي في الصَديقِ يَسوءُهُ","ولَكِنَّ كَثيراً مايَخافُ مُزاحي",36,"ي",1,1],["وَما خِلتُكَ ابنَ الأَنجُمِ الزُهرِ سائِراً","وَتارِكَ نُعماكَ الَّتي شُهِرَت عَدّا",37,"د",2,0],["وَما خِلتُها مَأخوذَةً بِصَبابَتي","صَحائِفُ تُمحى بِالرِياحِ سُطورُها",38,"ر",3,0],["وَما خِلتُ تُبكى بَعدَ قَيصَرَ خُلَّةٌ","لِكُلِّ مُحِبٍّ قَيصَرٌ مِثلَ قَيصَري",39,"ر",2,0],["وَما خَيرُ يَومَيَّ الَّذي أَزَعُ الصِبا","لَهُ وَأُحَلّى بِالنُهى وَأُمَتَّعُ",40,"ع",1,0],["وَما خَفَضَت جَدّاتُ بَكرٍ أَرومَتي","وَلا عَطِلَت مِن ريشِ أَحسابِها سَهمي",41,"ي",1,0],["وَما خَطَري دونَ الغِنى إِن بَلَغتُهُ","سُؤالاً وَلا عِرضي نَظيرُ الدَراهِمِ",42,"م",1,0],["وَما خافَ شَيءٌ لَم يَمُت مِن مَخافَةٍ","كَما قَد أَسَرَّت في فُؤادي ضَمائِرُه",43,"ر",2,0],["وَما خِفتُ وَشكَ البَينِ حَتّى رَأَيتُها","يُساقُ عَلى ذاتِ الجَلاميدِ عيرُها",44,"ر",3,0],["وَما خِفتُها إِن أَنكَحَتني وَأَشهَدَت","عَلى نَفسِها لي أَن تَبَجَّسَ غولُها",45,"ل",3,0],["وَما خاصَمَ الأَقوامَ مِن ذي خُصومَةٍ","كَوَرهاءَ مَشنوءٌ إِلَيها حَليلُها",46,"ل",3,0],["وما خَفا البَرقُ إلا عادَ يُذكِرهُ","من الثَّنِيَّةِ أَجزاعاً وأخيافا",47,"ف",2,0],["وما خِلْتُ صَفْعَانَ العراقِ يَسومُني","لأمثالِهِ ذمّاً يَسيراً ولا حَمْدا",48,"د",2,0],["وَما خَلَقَ الإِنسانُ إِلّا لِغايَةٍ","وَلَم يَترُكِ الإِنسانَ في الأَرضِ مُهمَلا",49,"ل",2,0],["وَما خَيَّرتَ أَينَ حَلَلتَ إِلّا","وَصَلتُ إِلَيكَ إِدلاجي بِسَيري",50,"ر",2,0],["وَما خَفَقَت جَناحُ الجَيشِ إِلّا","رَأوني مِلءَ قَلبِ العَسكَرَينِ",51,"ن",1,0],["وما خمدتْ لوعةٌ تلتظي","ولا جَمَدَتْ عَبرةٌ جاريه",52,"ي",2,0],["وما خارَ عُودي عندَ غَمزِ مُلِمَّةٍ","وهل خارَ عِندَ الغمزِ في يَدِكَ النبعُ",53,"ع",1,0],["وما خلتُ أنّ النّارَ يَبْرُدُ حَرّها","على سَعَفٍ لاقته في القيظِ يابِسا",54,"س",2,0],["وَما خَيرُ حِلمٍ لَم تَشُبهُ شَراسَةٌ","وَما خَيرُ لَحمٍ لا يَكونُ عَلى عَظمِ",55,"م",1,0],["وَما خَيرُ بَرقٍ لاحَ في غَيرِ وَقتِهِ","وَوادٍ غَدا مَلآنَ قَبلَ أَوانِهِ",56,"ن",2,0],["وَما خَلفَ أَجفاني شُؤونٌ بَخيلَةٌ","وَلا بَينَ أَضلاعي لَها حَجَرٌ صَلدُ",57,"د",1,0],["وَمَا خَيْرُ دُنْيَا لا بَقَاءَ لِعَهْدِهَا","وَمَا طِيبُ عَيْشٍ رَبُّهُ غَيْرُ سَالِمِ",58,"م",1,0],["وَما خَطا قادِماً فَوافى","حَتّى اِنثَنى ناكِصاً فَآبا",59,"ب",2,0],["وما خُطَطُ الدُّهاةِ بِمُغنياتٍ","إذا خُطَطٌ بأنقرةٍ قضينا",60,"ن",2,0],["وَما خَفِيَ الصَوابُ عَلى عَليمٍ","وَلا اِحتاجَ الضِياءُ إِلى مِثالِ",61,"ل",1,0],["وَما خِفتُ بَينَ الحَيِّ حَتّى تَذَأَّبَت","نَوىً لَم أَخَل ما كانَ مِنها بِكائِنِ",62,"ن",1,0],["وَما خُلِقَت تَيمٌ وزَيدُ مَناتِها","وَضَبَّةُ إِلّا بَعدَ خَلقِ القَبائِلِ",63,"ل",1,0],["وَما خَبَرتُ الَّذي فيها فَأذكره","لَكِن أَتَتني بِما فيهِ الأَخابيرُ",64,"ر",1,0],["وَما خِفنا مِنَ الناسِ","وَهَل في الناسِ إِنسانُ",65,"ن",1,0],["وما خُلُقِي مَدْحُ اللَّئِيمِ وَإنْ عَلَتْ","بهِ رُتَبٌ لا أَنَّني مُتَكَبِّرُ",66,"ر",1,0],["وما خِلتُ أنَّ الروْضَ يختالُ ماشِياً","ولا أن أرَى في أظهُرِ الخيل عَبقرا",67,"ر",2,0],["وما خلفَه من حطيمٍ يُزارُ","ولا دونه من مَدىً يُنْتَهَى",68,"ا",1,0],["وما خَفِيَ الرُّشْدُ لكنّما","أضَلّ الحُلومَ اتّباعُ الهوى",68,"ا",1,0],["وما خُلِقَتْ عبَثَاً أُمّةٌ","ولا ترَكَ اللّه قوماً سُدى",68,"ا",1,0],["وَما خُبزُهُ إِلّا كَآوى يُرى ابنُهُ","وَلَم يُرَ آوى في حُزونٍ وَلا سَهلِ",69,"ل",1,0],["وَما خُبزُهُ إِلّا كَعَنقاءِ مُغرِبٍ","تُصَوَّرُ في بُسطِ المُلوكِ وَفي المُثلِ",69,"ل",1,0],["وَما خُبزُهُ إِلّا كُلَيبُ بنُ وائِلٍ","وَمَن كانَ يَحمي عِزُّهُ مَنبِتُ البَقلِ",69,"ل",1,0],["وَما خَيرُ كَفٍّ أَمسَكَ الغُلُّ أُختَها","وَما خَيرُ سَيفٍ لَم يُؤَيَّد بِقائِمِ",70,"م",1,0],["وَما خابَ بَينَ اللَهِ وَالناسِ عامِلٌ","لَهُ في التُقى أَو في المَحامِدِ سوقُ",71,"ق",1,0],["وَما خابَ بَينَ الأَجرِ وَالحَمدِ عامِلٌ","لَهُ مِنهُما عِندَ العَواقِبِ زادُ",72,"د",1,0],["وَما خَرَجَت فيهِنَّ حَتّى عَذَلنَها","قِياماً وَحَتّى كادَت الشَمسُ تَخرُجُ",73,"ج",1,0],["وَما خَيرُ عَيشاً لا يَزالُ مُفَجَّعاً","بِمَوتِ نَعيمٍ أَو فِراقِ حَبيبِ",74,"ب",1,0],["وَما خِلتُهُ إِلّا سَيُبعَثُ حادِثاً","يُحِلُّ الثُرَيّا عَن جَبينِ الغَياهِبِ",75,"ب",1,0],["وَما خِلَقُ البيضِ الحِسانِ حَميدَةً","إِذا اِشتَهَرَت أَخلاقُهُنَّ الدَمائِمُ",76,"م",1,0],["وَما خِلتُ السِماكَ وَلا أَخاهُ","عَلى خَلقَيهِما لا يَهرَمانِ",77,"ن",1,0],["وَما خِلتُ سَلمى قَبلَها ذاتَ رِجلَةٍ","إِذا قَسوَريُّ اللَيلِ جيبَت سَرابِلُه",78,"ل",2,0],["وَما خَليجٌ مِنَ المَرّوتِ ذو حَدَبٍ","يَرمي الضَريرَ بِخُشبِ الطَلحِ وَالضالِ",79,"ل",1,0],["وَمَا خُنتُ ذا عَهدٍ وأُبتُ بِعَهدِهِ","وَلم أَحرِمِ المضُطَرَّ إذ جاءَ قانِعا",80,"ع",2,1],["وَمَا خِلْتَنِي فَوْقَ الَّذِي أَنَا كُنْتُهُ","فَفِيمَ أَرَى حَيّاً قِيَامَ تَمَاثِيلي",81,"ي",1,0],["وَمَا خِفْتُ فِي أنْ أُلْفى كَغَيْرِيَ مُولَعاً","بِخَلْعِ أَحِبَّائي كَخَلْعِ ثِيَابِي",82,"ب",2,0],["وَمَا خُلِقَتْ لِمَا يَخْلُبُ النُّهَى","مِنَ النَّحْتِ وَالتَّصْويرِ وَالنَّظْمِ وَالنَّثْرِ",83,"ر",1,0],["وما خَطبنا إلى قوم بَناتِهمُ","إلاّ بأرْعَن في حافاتِه الحَرَقُ",84,"ق",1,0],["وما خافَ يا أمُّ بل ضمَّني","وألقى على مَبْسَمي نجمتينْ",85,"ن",1,0],["وما خُلِقَتْ إلاّ لعزمٍ نفوسُنا","كأنَّا خُلِقْنا من غُبار الجحافل",86,"ل",1,0],["وما خضعَ النصرُ الأشمُّ لفاتحٍ","إذا لم يكُنْ من خيرة السادةِ الشُّمِ",87,"م",1,0],["وما خفت والآساد تزأر في الشرى","فكيف بخوفي من رويبضة الجحر؟",88,"ر",1,0],["وما خص هذا الخطبُ مصرَ، وإنما","رأَيت بلادَ الشرق فيه سواسيا",89,"ي",2,0],["وما خاب شعبٌ بهَذِي السماءِ","قويُّ الصِّلاتِ، وثيقُ العُرَا",90,"ر",2,0],["وما خلفتمو بين الزُّ","نُوج وبيننا فرقا",91,"ق",2,0],["ومَا خَيْرُ عَيْشٍ لاَ يَزَالُ مُفجَّعاً","بموت نعيمٍ أو فراق حبيب",92,"ب",1,0],["وما خلفت في الجو من خطراتها","وما خلعت من مرقصات على الربى",93,"ب",2,0],["وما خِلْتُني عبْءا عليهم وأنهم","يريدون أن يُجتَثَّ متنٌ وكاهل",94,"ل",1,0],["وما خلت أني في العراق جميعِه","سأفقِدُ حراً عن مغيبي يسائل",94,"ل",1,0],["وَما خَيْرُ يَوْمَيّ الذي أزِعُ الصِّبَى","لَهُ، وأُحَلّي بالنّهَى، وأُمَتِّعُ",95,"ع",1,0],["وما خلوا منه طرف عين لو علموا","وما خلا منهم في كل أوقات",96,"ت",1,0],["وما خِلْتُ نفسي تقتضيني لقائكم","فأمنحها لولا شناءتُه المطلا",97,"ل",2,0],["وَما خَطَّتِ الأَقلامُ إِلّا وَأَدمُعي","تَخُطُّ سُطور الشَّوق في صَفْحَة الخَدِّ",98,"د",1,0],["وما خيرُ شعب لستَ تعثرُ بينه","على قارئٍ من كلِّ ألفٍ وكاتب",99,"ب",1,0]]}