{"poems":[[53,"بمجال عزمي يملأ الملوان","https://www.aldiwan.net/poem29659.html","الكامل"],[53,"أين الغزال الماطل","https://www.aldiwan.net/poem29906.html","مجزوء الرجز"],[77,"أنتم من مناسب الأمجاد","https://www.aldiwan.net/poem36605.html","الخفيف"],[9,"إن محلا وإن مرتحلا","https://www.aldiwan.net/poem21975.html","المنسرح"],[71,"ما سر سكان الحمى بمذاع","https://www.aldiwan.net/poem4025.html","الكامل"],[72,"قدمت كالسيف إلى غمده","https://www.aldiwan.net/poem18559.html","السريع"],[51,"قدم الأمير أخو الأمير","https://www.aldiwan.net/poem8333.html","الخفيف"],[51,"أما الزمان إلى سلمى فقد جنحا","https://www.aldiwan.net/poem9264.html","البسيط"],[51,"وقف الهوى بك بعد طول وجيفه","https://www.aldiwan.net/poem65460.html","الكامل"],[51,"شغل المحب عن الرسوم","https://www.aldiwan.net/poem66332.html","مجزوء الكامل"],[85,"كأس من الدنيا تدار","https://www.aldiwan.net/poem62885.html","مجزوء الكامل"],[45,"ما للكبير في الغواني من أرب","https://www.aldiwan.net/poem10669.html","الرجز"],[28,"ما كنت أحسبني جبانا قبل ما","https://www.aldiwan.net/poem5122.html","الكامل"],[2,"إن الخليط أجد البين فانفرقا","https://www.aldiwan.net/poem25062.html","البسيط"],[66,"لم أدر أن نبال الغنج والكحل","https://www.aldiwan.net/poem38479.html","البسيط"],[66,"يا بدورا تغيب تحت التراب","https://www.aldiwan.net/poem40292.html","الخفيف"],[80,"جلا محياك عن أبصارنا الرمدا","https://www.aldiwan.net/poem31474.html","البسيط"],[44,"بأبي وغير أبي وذاك قليل","https://www.aldiwan.net/poem30307.html","الكامل"],[44,"وأبي المنازل إنها لشجون","https://www.aldiwan.net/poem30334.html","الكامل"],[44,"لولا أبو يعقوب في إبرامه","https://www.aldiwan.net/poem30350.html","الكامل"],[44,"أحيا حشاشة قلب كان مخلوسا","https://www.aldiwan.net/poem30483.html","الكامل"],[44,"صرف النوى ليس بالمكيث","https://www.aldiwan.net/poem30564.html","مجزوء البسيط"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[52,"ذهب الشباب وكدر العمر","https://www.aldiwan.net/poem27013.html","الكامل"],[75,"قولا لمعتقل الرمح الرديني","https://www.aldiwan.net/poem69026.html","الطويل"],[50,"تأبدت برقة الروحاء فاللبب","https://www.aldiwan.net/poem64839.html","البسيط"],[46,"يا مشرع الرمح في تثبيت مملكة","https://www.aldiwan.net/poem22282.html","البسيط"],[46,"روح تعدن قضي اليوم وانتظري","https://www.aldiwan.net/poem23472.html","البسيط"],[19,"عيني لا بد من سكب وتهمال","https://www.aldiwan.net/poem360.html",""],[76,"ولرب خافقة الذوائب قد غدت","https://www.aldiwan.net/poem39300.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39550","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54915","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55096","الكامل"],[106,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[106,"لا نكسة","https://www.poetsgate.com/ViewPoem.aspx?id=179333",""],[77,"أنتم من مناسب الأمجاد","https://www.poetsgate.com/ViewPoem.aspx?id=33807",""],[45,"ما للكبير في الغواني من أرب","https://www.poetsgate.com/ViewPoem.aspx?id=31558",""],[80,"جلا محياكَ عن أبصارنا الرَّمدا","https://www.poetsgate.com/ViewPoem.aspx?id=3162",""],[94,"نغمات عودي","https://www.poetsgate.com/ViewPoem.aspx?id=15651",""],[71,"ما سرُّ سكانِ الحِمى بِمُذاعِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=28019&r=&rc=6",""]],"verses":[["لَيثٌ بِهِ سَفَكَ الطَعانُ دَمَ القَنا","بِدِماءِ أَهلِ الشِركِ وَالطُغيانُ",0,"ن",1,0],["لَيثٌ هَموسُ اللَيلِ عَ","دّاءُ النَهارِ باسِلُ",1,"ل",1,0],["لي ثَناءٌ كما علِمْتَ هوَ الوشْ","يُ وصَنْعاءُ في فَمي وفُؤادي",2,"د",2,0],["لَيثٌ لَدى الحَربِ أَو تَدوخَ لَهُ","قَسراً وَبَذَّ المُلوكَ ما فَعَلا",3,"ل",2,0],["لَيثُ الشَرى في مَتنِ أَجدَلَ كاسِرٍ","يَسطو بِصَلٍّ في ثِيابِ شُجاعِ",4,"ع",1,0],["ليثٌ وغيثٌ في سطاً أو لهاً","فاحْذَره يا طالب واستجده",5,"د",2,0],["ليثٌ لَهُ في كلِّ جا","رحةٍ وعضوٍ مخْلبُ",6,"ب",1,0],["ليثٌ إذا زأر الليث الهِزَبْر له","لم يحسب الليثَ إلا ثعلباً ضَبحا",7,"ح",2,0],["ليث تراعى الوحش حول حريمه","وترى الأسود مجانبات غريفه",8,"ف",2,0],["ليثُ اللُّيوثِ إذا الحرو","بُ تسعَّرتْ قرْمُ القُروم",9,"م",1,0],["لَيثُ المَعامِعِ وَالوَقا","ئِعِ وَالمَواقِعِ وَالحِصار",10,"ر",1,0],["لَيثٌ وَغَيزٌ وَجَوادٌ ماجِدٌ","كَفّاهُ بِالأَموالِ تَحبو وَتَهَب",11,"ب",1,0],["لَيثاً كَأَنَّ عَلى يَدَيهِ رِحالَةً","جَسِدَ البَراثِنَ مُؤجَدَ الأَظفارِ",12,"ر",1,0],["لَيثٌ بِعَثَّرَ يَصطادُ الرِجالَ إِذا","ما كَذَّبَ اللَيثُ عَن أَقرانِهِ صَدَقا",13,"ق",2,0],["لَيثٌ أَضافَت سَجاياهُ حَماسَتَهُ","إِلى السَماحِ وَناطَ العِلمَ بِالعَمَلِ",14,"ل",1,0],["لَيثُ إِبنا أُرتُقَ المَلِكُ المَن","صورُ رَبُّ الإِحسانِ وَالأَنسابِ",15,"ب",1,0],["ليثٌ تَخالُ سُيوفاً في بَراثنِهِ","وتحسبُ الزّغْفَ منه الشَّعْرَ واللبدا",16,"د",2,0],["لَيثٌ لَوَ اِنَّ اللَيثَ قامَ مَقامَهُ","لَاِنصاعَ وَهوَ يَراعَةٌ إِجفيلُ",17,"ل",1,0],["لَيثٌ إِذا خَفَقَ اللِواءُ رَأَيتَهُ","يَعلو قَرا الهَيجاءِ وَهيَ زَبونُ",18,"ن",1,0],["لَيثٌ إِذا الحاجاتُ لُذنَ بِحِقوِهِ","في كَرِّهِ مِنها وَفي إِقدامِهِ",19,"م",2,0],["لَيثٌ تَرى كُلَّ يَومٍ تَحتَ كَلكَلِهِ","لَيثاً مِنَ الإِنسِ جَهمَ الوَجهِ مَفروسا",20,"س",2,0],["لَيثاً وَلَكِنَّهُ حِمامٌ","صُبَّ اِنتِقاماً عَلى اللُيوثِ",21,"ث",1,0],["لَيثٌ رَماهُ اللَهُ ذو المَعارِجِ","بِفالِجٍ قَبلَ رُكوبِ الفالِجِ",22,"ج",1,0],["لَيثٌ فَرائِسُهُ الكُماةُ فَما","يَبيَضُّ مِن دَمِها لَهُ ظِفرُ",23,"ر",1,0],["لَيثُ الكَتيبَةِ والأبصارُ تَرمُقُهُ","وبيْضَةُ الخِدرِ في الليل الدجوجيّ",24,"ي",1,0],["لَيثٌ لَدى الحَربِ يُذكيها وَيُخمِدُها","وَلا تَرى مِثلَ ما يُعطي وَما يَهَبُ",25,"ب",1,0],["لَيثُ النِزالِ وَلَكِن في مَنازِلِهِ","كَلبٌ عَلى فَضَلاتِ الزادِ نَبّاحُ",26,"ح",1,0],["لَيثٌ كَفادِرِ فِرزٍ لُبسُهُ شَعَرٌ","وَكَالرُدَينِيُّ آلى يَلبَسُ الرَدَنا",27,"ن",2,0],["لَيثٌ عَلَيهِ مِنَ البَردِيِّ هِبرِيَةٌ","كَالمَرزَبانِيِّ عَيّالٌ بِآصالِ",28,"ل",1,0],["لَيْثٌ تَطيرُ لهُ القُلوبُ مَخافةً","مِن بَيْنِ هَمْهَمَةٍ لهُ وَزَئيرِ",29,"ر",1,0],["لِيَثُرْ على القضبانِ كلُّ معذبٍ","وليحطمِ الأصفادَ كلُّ معاني",30,"ن",2,0],["لِيُثِبْهُ عَنْ مِصْرٍ وَعَنْ جَارَاتِهَا","بِالخَيْرِ دَاعِيهِ لِخيْرِ جِوارِ",31,"ر",1,0],["لَيْثَ الشَّرَى أَتبِيتُ مِنْ أَلمٍ","تشْكُو وَمَجْدُك ليْسَ يْشكِيكا",32,"ك",2,0],["ليثٌ تناولَ زاده","ورمى بفضلتهِ لسِيد",33,"د",1,0],["ليث العروبة ما عَرَا أظْفارَهُ؟","ويلاه من هِرَّ على الليث اجْتَرا!",34,"ر",2,0],["لي ثناء كما علمت هو الوشي","وصفاء في فمي وفؤادي",35,"د",2,0],["ليث وغيث وجواد ماجد","كفاه بالأموال تحبو وتهب",36,"ب",1,0],["ليثٌ تخالُ سيوفاً في براثنه","وتحسبُ الزعف منه الشعر واللبدا",37,"د",2,0],["ليث المعامع وهو أوّل آسر","صيد الفوارس كيف صار أسيرا",38,"ر",2,0],["ليثُ الشرى في متن أَجدلَ كاسرٍ","في الأرض تسألُ عن ذوي الإدقاعِ",39,"ع",1,0]]}