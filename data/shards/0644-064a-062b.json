 ثلاث اسنين من فرقاك قادع","https://www.poetsgate.com/ViewPoem.aspx?id=180548",""],[4816,"عمان","https://www.poetsgate.com/ViewPoem.aspx?id=15736",""],[4578,"زناد نوى الأحباب في القلب يقدحُ","https://www.poetsgate.com/ViewPoem.aspx?id=49376",""],[4927,"معلقة أمير الشهداء المعاصرين صَدّام يرحمه الله","https://www.poetsgate.com/ViewPoem.aspx?id=36731",""],[5061,"نهر دجله","https://www.poetsgate.com/ViewPoem.aspx?id=147167",""],[585,"تحية تملأ الدنيا وتمجيد","https://www.poetsgate.com/ViewPoem.aspx?id=161886",""],[5136,"يا شمس أفق سما المجد والجود","https://www.poetsgate.com/ViewPoem.aspx?id=121560",""],[5136,"ما هز عطفي ملة الحنفاء","https://www.poetsgate.com/ViewPoem.aspx?id=121489",""],[5136,"أيامنا بين أعراس وأفراج","https://www.poetsgate.com/ViewPoem.aspx?id=121540",""],[5136,"دعه يبكي فمن بكى يستريح","https://www.poetsgate.com/ViewPoem.aspx?id=121548",""],[5136,"القلب يخشع والأماني تدمع","https://www.poetsgate.com/ViewPoem.aspx?id=121614",""],[5136,"الحق أبلج واضح للمهتدي","https://www.poetsgate.com/ViewPoem.aspx?id=121802",""],[5145,"من لبرقٍ على البراق أنارا","https://www.poetsgate.com/ViewPoem.aspx?id=108062",""],[5145,"آه لبرقٍ ومضا","https://www.poetsgate.com/ViewPoem.aspx?id=108066",""],[5218,"فزِّيت فزّه غافي","https://www.poetsgate.com/ViewPoem.aspx?id=25793",""],[5493,"لِيثربِ أمي","https://www.poetsgate.com/ViewPoem.aspx?id=199921",""],[5582,"بَكَى وَناحَ غَراماً فِي الهَوَى ناحَا","https://www.poetsgate.com/ViewPoem.aspx?id=186790",""],[5582,"عُجْ بِالمَطِيِّ فَهذا السَّفْحُ وَالعَلَمُ","https://www.poetsgate.com/ViewPoem.aspx?id=63577",""],[5582,"زُرْ مَنْزِلاً قاضَكَ البُرْحا وَأَوْلاكَا","https://www.poetsgate.com/ViewPoem.aspx?id=63548",""],[5582,"أَتِلْكَ لِلحَيِّ أَحْداجٌ وَأَظْعانُ","https://www.poetsgate.com/ViewPoem.aspx?id=63592",""],[5665,"ليثٌ إذا أَبكى شبا أسيافهِ","https://www.poetsgate.com/ViewPoem.aspx?id=190433",""],[5694,"البيعة","https://www.poetsgate.com/ViewPoem.aspx?id=129888",""],[5725,"وقفة على باب ابي الحسن","https://www.poetsgate.com/ViewPoem.aspx?id=177475",""],[402,"أبكي الوفاء غداة أبكيكا","https://www.poetsgate.com/ViewPoem.aspx?id=35979",""],[5953,"باب الهداية باب واحد أبدي","https://www.poetsgate.com/ViewPoem.aspx?id=93783",""],[4442,"نزعت تخط بكل نفنف","https://www.poetsgate.com/ViewPoem.aspx?id=171225",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[2131,"العِزُّ وَالمَجدُ في الهِندِيَّةِ القُضُبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=71147&r=&rc=4",""],[6345,"مايد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78663&r=&rc=34",""]],"verses":[["لَيثٌ بِهِ سَفَكَ الطَعانُ دَمَ القَنا","بِدِماءِ أَهلِ الشِركِ وَالطُغيانُ",0,"ن",1,0],["لَيثٌ هَموسُ اللَيلِ عَ","دّاءُ النَهارِ باسِلُ",1,"ل",1,0],["لي ثَناءٌ كما علِمْتَ هوَ الوشْ","يُ وصَنْعاءُ في فَمي وفُؤادي",2,"د",2,0],["لَيثٌ لَدى الحَربِ أَو تَدوخَ لَهُ","قَسراً وَبَذَّ المُلوكَ ما فَعَلا",3,"ل",2,0],["لَيثُ الشَرى في مَتنِ أَجدَلَ كاسِرٍ","يَسطو بِصَلٍّ في ثِيابِ شُجاعِ",4,"ع",1,0],["ليثٌ وغيثٌ في سطاً أو لهاً","فاحْذَره يا طالب واستجده",5,"د",2,0],["ليثٌ لَهُ في كلِّ جا","رحةٍ وعضوٍ مخْلبُ",6,"ب",1,0],["ليثٌ إذا زأر الليث الهِزَبْر له","لم يحسب الليثَ إلا ثعلباً ضَبحا",7,"ح",2,0],["ليث تراعى الوحش حول حريمه","وترى الأسود مجانبات غريفه",8,"ف",2,0],["ليثُ اللُّيوثِ إذا الحرو","بُ تسعَّرتْ قرْمُ القُروم",9,"م",1,0],["لَيثُ المَعامِعِ وَالوَقا","ئِعِ وَالمَواقِعِ وَالحِصار",10,"ر",1,0],["لَيثٌ وَغَيزٌ وَجَوادٌ ماجِدٌ","كَفّاهُ بِالأَموالِ تَحبو وَتَهَب",11,"ب",1,0],["لَيثاً كَأَنَّ عَلى يَدَيهِ رِحالَةً","جَسِدَ البَراثِنَ مُؤجَدَ الأَظفارِ",12,"ر",1,0],["لَيثٌ بِعَثَّرَ يَصطادُ الرِجالَ إِذا","ما كَذَّبَ اللَيثُ عَن أَقرانِهِ صَدَقا",13,"ق",2,0],["لَيثٌ أَضافَت سَجاياهُ حَماسَتَهُ","إِلى السَماحِ وَناطَ العِلمَ بِالعَمَلِ",14,"ل",1,0],["لَيثُ إِبنا أُرتُقَ المَلِكُ المَن","صورُ رَبُّ الإِحسانِ وَالأَنسابِ",15,"ب",1,0],["ليثٌ تَخالُ سُيوفاً في بَراثنِهِ","وتحسبُ الزّغْفَ منه الشَّعْرَ واللبدا",16,"د",2,0],["لَيثٌ لَوَ اِنَّ اللَيثَ قامَ مَقامَهُ","لَاِنصاعَ وَهوَ يَراعَةٌ إِجفيلُ",17,"ل",1,0],["لَيثٌ إِذا خَفَقَ اللِواءُ رَأَيتَهُ","يَعلو قَرا الهَيجاءِ وَهيَ زَبونُ",18,"ن",1,0],["لَيثٌ إِذا الحاجاتُ لُذنَ بِحِقوِهِ","في كَرِّهِ مِنها وَفي إِقدامِهِ",19,"م",2,0],["لَيثٌ تَرى كُلَّ يَومٍ تَحتَ كَلكَلِهِ","لَيثاً مِنَ الإِنسِ جَهمَ الوَجهِ مَفروسا",20,"س",2,0],["لَيثاً وَلَكِنَّهُ حِمامٌ","صُبَّ اِنتِقاماً عَلى اللُيوثِ",21,"ث",1,0],["لَيثٌ رَماهُ اللَهُ ذو المَعارِجِ","بِفالِجٍ قَبلَ رُكوبِ الفالِجِ",22,"ج",1,0],["لَيثٌ فَرائِسُهُ الكُماةُ فَما","يَبيَضُّ مِن دَمِها لَهُ ظِفرُ",23,"ر",1,0],["لَيثُ الكَتيبَةِ والأبصارُ تَرمُقُهُ","وبيْضَةُ الخِدرِ في الليل الدجوجيّ",24,"ي",1,0],["لَيثٌ لَدى الحَربِ يُذكيها وَيُخمِدُها","وَلا تَرى مِثلَ ما يُعطي وَما يَهَبُ",25,"ب",1,0],["لَيثُ النِزالِ وَلَكِن في مَنازِلِهِ","كَلبٌ عَلى فَضَلاتِ الزادِ نَبّاحُ",26,"ح",1,0],["لَيثٌ كَفادِرِ فِرزٍ لُبسُهُ شَعَرٌ","وَكَالرُدَينِيُّ آلى يَلبَسُ الرَدَنا",27,"ن",2,0],["لَيثٌ عَلَيهِ مِنَ البَردِيِّ هِبرِيَةٌ","كَالمَرزَبانِيِّ عَيّالٌ بِآصالِ",28,"ل",1,0],["لَيْثٌ تَطيرُ لهُ القُلوبُ مَخافةً","مِن بَيْنِ هَمْهَمَةٍ لهُ وَزَئيرِ",29,"ر",1,0],["لِيَثُرْ على القضبانِ كلُّ معذبٍ","وليحطمِ الأصفادَ كلُّ معاني",30,"ن",2,0],["لِيُثِبْهُ عَنْ مِصْرٍ وَعَنْ جَارَاتِهَا","بِالخَيْرِ دَاعِيهِ لِخيْرِ جِوارِ",31,"ر",1,0],["لَيْثَ الشَّرَى أَتبِيتُ مِنْ أَلمٍ","تشْكُو وَمَجْدُك ليْسَ يْشكِيكا",32,"ك",2,0],["ليثٌ تناولَ زاده","ورمى بفضلتهِ لسِيد",33,"د",1,0],["ليث العروبة ما عَرَا أظْفارَهُ؟","ويلاه من هِرَّ على الليث اجْتَرا!",34,"ر",2,0],["ليث الرسالة صنديد الملاحم سل","طان العوالم مولى سائر الفطر",35,"ر",1,0],["ليث المعارك مربع الفضل الذي","رفع المنار ولات حين منار",36,"ر",1,0],["لي ثناء كما علمت هو الوشي","وصفاء في فمي وفؤادي",37,"د",2,0],["ليث وغيث وجواد ماجد","كفاه بالأموال تحبو وتهب",38,"ب",1,0],["ليثٌ تخالُ سيوفاً في براثنه","وتحسبُ الزعف منه الشعر واللبدا",39,"د",2,0],["ليث المعامع وهو أوّل آسر","صيد الفوارس كيف صار أسيرا",40,"ر",2,0],["ليثُ الشرى في متن أَجدلَ كاسرٍ","في الأرض تسألُ عن ذوي الإدقاعِ",41,"ع",1,0],["ليث اذا حمي الوطيس فلذ به","وهناك تبصر هزة الصمصام",42,"م",1,0],["ليث غاب لغيب مصباح الهدى","كافل من عنه أهلوه تخلوا",43,"ل",3,0],["ليث يخضخض أقصاب الفرائص في","عَرِّيسه مالقرن فيه ملتحد",44,"د",1,0],["لِيَثنِ عَنّي صُروفَ الدَهرِ راغِمَةً","أَنّي عَلِقتُ بِحَبلٍ لَيسَ يَنقَضِبُ",45,"ب",1,0],["لَيثٌ أَظافِرِهُ الأَسِنَّةُ وَالقَنا","عِرّيسُهُ وَلَهُ الظُبى أَنيابُ",46,"ب",1,0],["لَيثٌ وَفي خَلَلَ الوَشيجِ عَرينُهُ","وَفَنيقُ حَربٍ وَالمَكَرُّ عِرانُهُ",47,"ن",2,0],["ليث يرد الألف فرداً خاسرا","عن جسمه والألف ليسوا حُسّرا",48,"ر",2,0],["ليثٌ إذا فاجا العداة تصايحوا","فترى عصافيرا رأت ثَعبانا",49,"ن",2,0],["ليث حمى سيفه ما مسه سأَم","وكم درا ووقانا كل مهتضم",50,"م",1,0],["ليثٌ تواضعَ في الفريسةِ فاجْتَرى","بالتّيسِ ذي القرنينِ والعُثْنونِ",51,"ن",1,0],["لَيثٌ أَشَمٌ جَسورٌ باسلٌ بطلٌ","عالي السِّنى طاهرِ الأَخلاقِ زاكيها",52,"ي",3,0],["ليثُ الحروبِ ومِخلبا","هُ هَناك بتّارٌ وخرصُ",53,"ص",1,0],["ليث تشب به نار الحروب غدا","يوم الضارب لضرب الأسد معتادا",54,"د",2,0],["ليث الكفاح وناصر الدين الذي","ضاقت بطاح الأرض عن أبطاله",55,"ل",2,0],["لَيثٌ وَبَدرٌ إِن تَنَم","مَرَ أَو تَصَدَّرَ مَوكِبا",56,"ب",2,0],["لَيثٌ بِهِ السُلطان أَرغم ضدَّهُ","وَبِهِ يَطولُ عَلى العِدى وَيَصولُ",57,"ل",1,0],["لَيث الوَغى شَهدت لَه أَفعالُهُ","وَالمَوتُ أَحمَرُ وَالدِماءُ تَسيلُ",57,"ل",1,0],["لَيث بلغتَ المَدى المَحتومَ في أَجَل","فَما لِوَجدي وَحُزني ما حَييتُ مَدا",58,"د",2,0],["ليث الوغى غيث الندى والشهم من","تلقاه يبدع منعما أو منقما",59,"م",2,0],["ليث برود به المهالك بأسه","والليث لولا بأسه ما صالا",60,"ل",2,0],["ليث الفراسة يوم يشتجر القنا","متفيئا ظل القنا المتحطم",61,"م",1,0],["لَيْثُ الحِفَاظِ تَعَلَّمَتْ إِقْدَامَهُ","أَشْبَالُ أَبْنَاء لَهُ أَشْباهُ",62,"ا",2,0],["لَيثُ وَغىً تَنفُرُ مِنهُ العِدا","كَالشاءِ أَحسَسنَ السَراحينا",63,"ن",2,0],["لَيثٌ تَريكَتُهُ شَمسٌ وَلَهذَمُهُ","نَجمٌ وَصارِمُهُ نارٌ عَلى عَلَمِ",64,"م",1,0],["لَيثُ وَغىً ما لَهُ سِوى البيضِ وال","نُشّابِ وَالسُمرِ مِن أَظافيرِ",65,"ر",1,0],["لَيثٌ غابَ بِدُبرِهِ حينَ يَلقى","وَجَبانٌ في الحَربِ يَومَ البَزازِ",66,"ز",1,0],["ليثٌ بهولُكَ صولُه","غَيثٌ يَروقُ لك اِنهلالُه",67,"ل",2,0],["ليث غاب خلقا وخلقا فمن لا","ح لعينيه خاله ليث غاب",68,"ب",1,0],["لَيث حمى عزَّ المَناصب بَعدَما","قامَت تَحوم حِماه راتِعَة الفَلا",69,"ل",2,0],["لَيث الوَغى سَطوَةً غَيث السَما كَرَماً","بَدر الدُجى طَلعةً شَمس الضُحى شَرَفا",70,"ف",2,0],["ليثٌ إذا صالَ لم تَثْبُتْ له نفَساً","لُيوثُ شَرٍّ تَصدَّتْ أو ليوثُ شَرى",71,"ر",2,0],["ليثُ غابٍ تُريكَ منه لساناً","وبياناً كفّاه ناباً وظُفرا",72,"ر",2,0],["ليثُ الكتيبةِ أم ليثُ الكتابة أم","حاوِي المعاني وما للحَقِّ إنكار",73,"ر",1,0],["ليثٌ عَرِيناهُ باْسٌ أو ندىً ولَه","بالبِيضِ والرُّقشِ أنيابٌ وأظفار",73,"ر",1,0],["ليثُ الكتابةِ أو ليثُ الكتيبةِ مَن","طلبْتَ في بُرْدهِ لم تَعْدُ أن تَجِدا",74,"د",2,0],["لَيْثٌ له من اليَراعِ مِخلَبٌ","مُفترِسُ الأُسودِ والأساود",75,"د",1,0],["لَيْثُ مخالِيُهُ إذا حَضر الوَغَى","بيضٌ مهنّدَةٌ وسُمرُ صِعادِ",76,"د",1,0],["ليثُ الشّرى حَيْث الصَّوارمُ والقَنَا","تَسْعَى بكأَسٍ لِلْمنونِ مُدارِ",77,"ر",1,0],["ليثُ غابٍ وسحابٌ صيّبٌ","حيثُ تلقاهُ نوالاً ونزالا",78,"ل",2,0],["ليث إذا هز اليراع بنانه","غيث البراعة والبلاغة واكف",79,"ف",1,0],["ليثٌ براحته الخطيُّ منتصرُ","والمال منهتكٌ والحمد معزوزُ",80,"ز",1,0],["ليث تذيب العدى رعباً مهابته","ان هز صارمه البتار أو رمحا",81,"ح",2,0],["ليثٌ يلاعب أرقماً","من فوق سرحان دريرِ",82,"ر",1,0],["ليثٌ تخاف الأسد في آجامها","سطواته والأمن أصبح جاري",83,"ر",2,0],["ليثٌ على ضامرٍ كالنجم غرتهُ","والريح هبتهُ والبرق ان ركضا",84,"ض",2,0],["ليثٌ بيمناهُ المنية إن بدا","فيها اليماني والنوال حياءُ",85,"ا",2,0],["ليث غيث بحر فخر","رشد سعد من يدن يرى",86,"ر",2,0],["ليث تزيّن في حلى","تلك الخلال الراضيه",87,"ي",2,0],["ليث حرب تحت العجاج مجدّ","بكعوب يصمي ليوث النزال",88,"ل",1,0],["ليث ان جال لدى الأعدا","بكعوب لاتسأل عما",89,"م",2,0],["ليثٌ إذا ما جال في حربه","ترهبه الأسد إذا يزأر",90,"ر",1,0],["ليث إذا حمي الوطيس","بنقع حرب واضطرم",91,"م",1,0],["ليث إذا الهيجاء عبّ عبابها","غوثٌ إذا ما حل خطب واعتدى",92,"د",2,0],["ليث من كان بطاعته","لم يخش الدهر من الحرج",93,"ج",1,0],["ليثٌ يموتُ جاحِدوهُ فرَقا","غيثٌ يُرى جودُ يدي