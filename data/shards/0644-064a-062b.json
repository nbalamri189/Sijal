بنا نحو الحجون ونكبوا","https://www.aldiwan.net/poem20800.html","الكامل"],[514,"نظر البدر وجهها فتلاها","https://www.aldiwan.net/poem20822.html","الخفيف"],[514,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[514,"خر الورى حيدري عم نائله","https://www.aldiwan.net/poem20836.html","البسيط"],[514,"فخر الورى ذو المعالي الباهرات علي","https://www.aldiwan.net/poem20842.html","البسيط"],[514,"فخر الورى","https://www.aldiwan.net/poem20845.html","مجزوء الرجز"],[514,"فخر الورى حيدري عم نائله","https://www.aldiwan.net/poem20847.html","البسيط"],[514,"فخر الورى","https://www.aldiwan.net/poem20850.html","مجزوء الرجز"],[514,"فخر الورى حيدري عم نائله","https://www.aldiwan.net/poem20851.html","البسيط"],[515,"خاطر فإن الحظ للمخاطر","https://www.aldiwan.net/poem12123.html","الرجز"],[515,"لولا جفون ومقل","https://www.aldiwan.net/poem12209.html","مجزوء الكامل"],[515,"سهلت حزونة وجده وغرامه","https://www.aldiwan.net/poem12254.html","الكامل"],[540,"أألحمامة في نخل ابن هداج","https://www.aldiwan.net/poem56877.html","البسيط"],[562,"قف بالمطايا على أنجاد ذي سلم","https://www.aldiwan.net/poem52785.html","البسيط"]],"verses":[["لَيثٌ بِهِ سَفَكَ الطَعانُ دَمَ القَنا","بِدِماءِ أَهلِ الشِركِ وَالطُغيانُ",0,"ن",1,0],["لَيثٌ هَموسُ اللَيلِ عَ","دّاءُ النَهارِ باسِلُ",1,"ل",1,0],["لي ثَناءٌ كما علِمْتَ هوَ الوشْ","يُ وصَنْعاءُ في فَمي وفُؤادي",2,"د",2,0],["لَيثٌ لَدى الحَربِ أَو تَدوخَ لَهُ","قَسراً وَبَذَّ المُلوكَ ما فَعَلا",3,"ل",2,0],["لَيثُ الشَرى في مَتنِ أَجدَلَ كاسِرٍ","يَسطو بِصَلٍّ في ثِيابِ شُجاعِ",4,"ع",1,0],["ليثٌ وغيثٌ في سطاً أو لهاً","فاحْذَره يا طالب واستجده",5,"د",2,0],["ليثٌ لَهُ في كلِّ جا","رحةٍ وعضوٍ مخْلبُ",6,"ب",1,0],["ليثٌ إذا زأر الليث الهِزَبْر له","لم يحسب الليثَ إلا ثعلباً ضَبحا",7,"ح",2,0],["ليث تراعى الوحش حول حريمه","وترى الأسود مجانبات غريفه",8,"ف",2,0],["ليثُ اللُّيوثِ إذا الحرو","بُ تسعَّرتْ قرْمُ القُروم",9,"م",1,0],["لَيثُ المَعامِعِ وَالوَقا","ئِعِ وَالمَواقِعِ وَالحِصار",10,"ر",1,0],["لَيثٌ وَغَيزٌ وَجَوادٌ ماجِدٌ","كَفّاهُ بِالأَموالِ تَحبو وَتَهَب",11,"ب",1,0],["لَيثاً كَأَنَّ عَلى يَدَيهِ رِحالَةً","جَسِدَ البَراثِنَ مُؤجَدَ الأَظفارِ",12,"ر",1,0],["لَيثٌ بِعَثَّرَ يَصطادُ الرِجالَ إِذا","ما كَذَّبَ اللَيثُ عَن أَقرانِهِ صَدَقا",13,"ق",2,0],["لَيثٌ أَضافَت سَجاياهُ حَماسَتَهُ","إِلى السَماحِ وَناطَ العِلمَ بِالعَمَلِ",14,"ل",1,0],["لَيثُ إِبنا أُرتُقَ المَلِكُ المَن","صورُ رَبُّ الإِحسانِ وَالأَنسابِ",15,"ب",1,0],["ليثٌ تَخالُ سُيوفاً في بَراثنِهِ","وتحسبُ الزّغْفَ منه الشَّعْرَ واللبدا",16,"د",2,0],["لَيثٌ لَوَ اِنَّ اللَيثَ قامَ مَقامَهُ","لَاِنصاعَ وَهوَ يَراعَةٌ إِجفيلُ",17,"ل",1,0],["لَيثٌ إِذا خَفَقَ اللِواءُ رَأَيتَهُ","يَعلو قَرا الهَيجاءِ وَهيَ زَبونُ",18,"ن",1,0],["لَيثٌ إِذا الحاجاتُ لُذنَ بِحِقوِهِ","في كَرِّهِ مِنها وَفي إِقدامِهِ",19,"م",2,0],["لَيثٌ تَرى كُلَّ يَومٍ تَحتَ كَلكَلِهِ","لَيثاً مِنَ الإِنسِ جَهمَ الوَجهِ مَفروسا",20,"س",2,0],["لَيثاً وَلَكِنَّهُ حِمامٌ","صُبَّ اِنتِقاماً عَلى اللُيوثِ",21,"ث",1,0],["لَيثٌ رَماهُ اللَهُ ذو المَعارِجِ","بِفالِجٍ قَبلَ رُكوبِ الفالِجِ",22,"ج",1,0],["لَيثٌ فَرائِسُهُ الكُماةُ فَما","يَبيَضُّ مِن دَمِها لَهُ ظِفرُ",23,"ر",1,0],["لَيثُ الكَتيبَةِ والأبصارُ تَرمُقُهُ","وبيْضَةُ الخِدرِ في الليل الدجوجيّ",24,"ي",1,0],["لَيثٌ لَدى الحَربِ يُذكيها وَيُخمِدُها","وَلا تَرى مِثلَ ما يُعطي وَما يَهَبُ",25,"ب",1,0],["لَيثُ النِزالِ وَلَكِن في مَنازِلِهِ","كَلبٌ عَلى فَضَلاتِ الزادِ نَبّاحُ",26,"ح",1,0],["لَيثٌ كَفادِرِ فِرزٍ لُبسُهُ شَعَرٌ","وَكَالرُدَينِيُّ آلى يَلبَسُ الرَدَنا",27,"ن",2,0],["لَيثٌ عَلَيهِ مِنَ البَردِيِّ هِبرِيَةٌ","كَالمَرزَبانِيِّ عَيّالٌ بِآصالِ",28,"ل",1,0],["لَيْثٌ تَطيرُ لهُ القُلوبُ مَخافةً","مِن بَيْنِ هَمْهَمَةٍ لهُ وَزَئيرِ",29,"ر",1,0],["لِيَثُرْ على القضبانِ كلُّ معذبٍ","وليحطمِ الأصفادَ كلُّ معاني",30,"ن",2,0],["لِيُثِبْهُ عَنْ مِصْرٍ وَعَنْ جَارَاتِهَا","بِالخَيْرِ دَاعِيهِ لِخيْرِ جِوارِ",31,"ر",1,0],["لَيْثَ الشَّرَى أَتبِيتُ مِنْ أَلمٍ","تشْكُو وَمَجْدُك ليْسَ يْشكِيكا",32,"ك",2,0],["ليثٌ تناولَ زاده","ورمى بفضلتهِ لسِيد",33,"د",1,0],["ليث العروبة ما عَرَا أظْفارَهُ؟","ويلاه من هِرَّ على الليث اجْتَرا!",34,"ر",2,0],["لي ثناء كما علمت هو الوشي","وصفاء في فمي وفؤادي",35,"د",2,0],["ليث وغيث وجواد ماجد","كفاه بالأموال تحبو وتهب",36,"ب",1,0],["ليثٌ تخالُ سيوفاً في براثنه","وتحسبُ الزعف منه الشعر واللبدا",37,"د",2,0],["ليث المعامع وهو أوّل آسر","صيد الفوارس كيف صار أسيرا",38,"ر",2,0],["ليثُ الشرى في متن أَجدلَ كاسرٍ","في الأرض تسألُ عن ذوي الإدقاعِ",39,"ع",1,0],["ليث اذا حمي الوطيس فلذ به","وهناك تبصر هزة الصمصام",40,"م",1,0],["ليث غاب لغيب مصباح الهدى","كافل من عنه أهلوه تخلوا",41,"ل",3,0],["ليث يخضخض أقصاب الفرائص في","عَرِّيسه مالقرن فيه ملتحد",42,"د",1,0],["لِيَثنِ عَنّي صُروفَ الدَهرِ راغِمَةً","أَنّي عَلِقتُ بِحَبلٍ لَيسَ يَنقَضِبُ",43,"ب",1,0],["لَيثٌ أَظافِرِهُ الأَسِنَّةُ وَالقَنا","عِرّيسُهُ وَلَهُ الظُبى أَنيابُ",44,"ب",1,0],["لَيثٌ وَفي خَلَلَ الوَشيجِ عَرينُهُ","وَفَنيقُ حَربٍ وَالمَكَرُّ عِرانُهُ",45,"ن",2,0],["ليث يرد الألف فرداً خاسرا","عن جسمه والألف ليسوا حُسّرا",46,"ر",2,0],["ليثٌ إذا فاجا العداة تصايحوا","فترى عصافيرا رأت ثَعبانا",47,"ن",2,0],["ليث حمى سيفه ما مسه سأَم","وكم درا ووقانا كل مهتضم",48,"م",1,0],["ليثٌ تواضعَ في الفريسةِ فاجْتَرى","بالتّيسِ ذي القرنينِ والعُثْنونِ",49,"ن",1,0],["لَيثٌ أَشَمٌ جَسورٌ باسلٌ بطلٌ","عالي السِّنى طاهرِ الأَخلاقِ زاكيها",50,"ي",3,0],["ليثُ الحروبِ ومِخلبا","هُ هَناك بتّارٌ وخرصُ",51,"ص",1,0],["ليث تشب به نار الحروب غدا","يوم الضارب لضرب الأسد معتادا",52,"د",2,0],["ليث الكفاح وناصر الدين الذي","ضاقت بطاح الأرض عن أبطاله",53,"ل",2,0],["لَيثٌ وَبَدرٌ إِن تَنَم","مَرَ أَو تَصَدَّرَ مَوكِبا",54,"ب",2,0],["لَيثٌ بِهِ السُلطان أَرغم ضدَّهُ","وَبِهِ يَطولُ عَلى العِدى وَيَصولُ",55,"ل",1,0],["لَيث الوَغى شَهدت لَه أَفعالُهُ","وَالمَوتُ أَحمَرُ وَالدِماءُ تَسيلُ",55,"ل",1,0],["لَيث بلغتَ المَدى المَحتومَ في أَجَل","فَما لِوَجدي وَحُزني ما حَييتُ مَدا",56,"د",2,0],["ليث الوغى غيث الندى والشهم من","تلقاه يبدع منعما أو منقما",57,"م",2,0],["ليث برود به المهالك بأسه","والليث لولا بأسه ما صالا",58,"ل",2,0],["ليث الفراسة يوم يشتجر القنا","متفيئا ظل القنا المتحطم",59,"م",1,0],["لَيْثُ الحِفَاظِ تَعَلَّمَتْ إِقْدَامَهُ","أَشْبَالُ أَبْنَاء لَهُ أَشْباهُ",60,"ا",2,0],["لَيثُ وَغىً تَنفُرُ مِنهُ العِدا","كَالشاءِ أَحسَسنَ السَراحينا",61,"ن",2,0],["لَيثٌ تَريكَتُهُ شَمسٌ وَلَهذَمُهُ","نَجمٌ وَصارِمُهُ نارٌ عَلى عَلَمِ",62,"م",1,0],["لَيثُ وَغىً ما لَهُ سِوى البيضِ وال","نُشّابِ وَالسُمرِ مِن أَظافيرِ",63,"ر",1,0],["لَيثٌ غابَ بِدُبرِهِ حينَ يَلقى","وَجَبانٌ في الحَربِ يَومَ البَزازِ",64,"ز",1,0],["ليثٌ بهولُكَ صولُه","غَيثٌ يَروقُ لك اِنهلالُه",65,"ل",2,0],["ليث غاب خلقا وخلقا فمن لا","ح لعينيه خاله ليث غاب",66,"ب",1,0],["لَيث حمى عزَّ المَناصب بَعدَما","قامَت تَحوم حِماه راتِعَة الفَلا",67,"ل",2,0],["لَيث الوَغى سَطوَةً غَيث السَما كَرَماً","بَدر الدُجى طَلعةً شَمس الضُحى شَرَفا",68,"ف",2,0],["ليثٌ إذا صالَ لم تَثْبُتْ له نفَساً","لُيوثُ شَرٍّ تَصدَّتْ أو ليوثُ شَرى",69,"ر",2,0],["ليثُ غابٍ تُريكَ منه لساناً","وبياناً كفّاه ناباً وظُفرا",70,"ر",2,0],["ليثُ الكتيبةِ أم ليثُ الكتابة أم","حاوِي المعاني وما للحَقِّ إنكار",71,"ر",1,0],["ليثٌ عَرِيناهُ باْسٌ أو ندىً ولَه","بالبِيضِ والرُّقشِ أنيابٌ وأظفار",71,"ر",1,0],["ليثُ الكتابةِ أو ليثُ الكتيبةِ مَن","طلبْتَ في بُرْدهِ لم تَعْدُ أن تَجِدا",72,"د",2,0],["لَيْثٌ له من اليَراعِ مِخلَبٌ","مُفترِسُ الأُسودِ والأساود",73,"د",1,0],["لَيْثُ مخالِيُهُ إذا حَضر الوَغَى","بيضٌ مهنّدَةٌ وسُمرُ صِعادِ",74,"د",1,0],["ليثُ الشّرى حَيْث الصَّوارمُ والقَنَا","تَسْعَى بكأَسٍ لِلْمنونِ مُدارِ",75,"ر",1,0],["ليثُ غابٍ وسحابٌ صيّبٌ","حيثُ تلقاهُ نوالاً ونزالا",76,"ل",2,0],["ليث إذا هز اليراع بنانه","غيث البراعة والبلاغة واكف",77,"ف",1,0],["ليثٌ براحته الخطيُّ منتصرُ","والمال منهتكٌ والحمد معزوزُ",78,"ز",1,0],["ليث تذيب العدى رعباً مهابته","ان هز صارمه البتار أو رمحا",79,"ح",2,0],["ليثٌ يلاعب أرقماً","من فوق سرحان دريرِ",80,"ر",1,0],["ليثٌ تخاف الأسد في آجامها","سطواته والأمن أصبح جاري",81,"ر",2,0],["ليثٌ على ضامرٍ كالنجم غرتهُ","والريح هبتهُ والبرق ان ركضا",82,"ض",2,0],["ليثٌ بيمناهُ المنية إن بدا","فيها اليماني والنوال حياءُ",83,"ا",2,0],["ليث غيث بحر فخر","رشد سعد من يدن يرى",84,"ر",2,0],["ليث تزيّن في حلى","تلك الخلال الراضيه",85,"ي",2,0],["ليث حرب تحت العجاج مجدّ","بكعوب يصمي ليوث النزال",86,"ل",1,0],["ليث ان جال لدى الأعدا","بكعوب لاتسأل عما",87,"م",2,0],["ليثٌ إذا ما جال في حربه","ترهبه الأسد إذا يزأر",88,"ر",1,0],["ليث إذا حمي الوطيس","بنقع حرب واضطرم",89,"م",1,0],["ليث إذا الهيجاء عبّ عبابها","غوثٌ إذا ما حل خطب واعتدى",90,"د",2,0],["ليث من كان بطاعته","لم يخش الدهر من الحرج",91,"ج",1,0],["ليثٌ يموتُ جاحِدوهُ فرَقا","غيثٌ يُرى جودُ يديهِ غدَقا",92,"ق",2,0],["ليثٌ يُخاطِرُ فِي المَكَرِّ بنفسِهِ","هِمَمٌ عظيمٌ فِي العلا أَخطارُها",93,"ر",3,0],["ليثُ حِماها والدارُ حربٌ","وفي السلامِ الظبيُ الربيبُ",94,"ب",1,0],["ليثٌ إذا جرّ من ذيل الحديد لغ","ير الكبر فالجيش مكفوف ومشلول",95,"ل",1,0],["لَيثٌ إِذا التاثَ حادِثٌ وَأَتى","إِلَيهِ ظُفرٌ مِن رَأيِهِ ظَفِرا",96,"ر",2,0],["ليثٌ يهزُّ يَداهُ شُعلةَ صارِمٍ","ماءُ المَنونِ يكادُ منها يشربُ",97,"ب",1,0],["ليثُها في النِّزالِ غيثُ نَداها","زَنْدُ نيرانِ حربِها وقِراها",98,"ا",3,0],["ليثُ حربٍ أشفقَتْ أُسْدُ الشّرى","منه حتّى بايعَتْهُ في شراها",99,"ا",3,0],["ليثُ الثّرى قبَسٌ تَهمي أنامِلُه","غيثُ النّدى مورِدٌ أشهى من العسَلِ",100,"ل",1,0],["لَيثُ الثَّرَى مَورِدٌ أَشهَى مِنَ العَسَلِ","بَدرُ البَهَا صُبحُ لَيلِ الحَادِثِ الجَلَلِ",101,"ل",1,0],["لَيثُ الثَّرى","بَدرُ البَها",102,"ه",2,0],["لَيثُ الثَّرَى قَبَسٌ تَهمِي أَنَامِلُهُ","بَدرُ البَهَا أُفُقٌ تَبدُو كَوَاكِبُهُ",103,"ب",2,0],["لَيثُ الثَّرَى","غَيثُ النَّدَى",104,"ا",1,0],["لَيثُ الثَّرَى قَبَسٌ تَهمِي أَنَامِلُهُ","رَحبُ الفَنَا نَجلُ خَيرِ الخَلقِ والرُّسُلِ",105,"ل",1,0],["ليث إذا قاد الجيوش لم يعد","بهن إلا ظافر الأظافر",106,"ر",1,0],["ليث ردى غيث ندى","إن طال يوماً أو بذل",107,"ل",1,0],["ليث حبيك السابري عرينه","ومثقفات السمر من آجامه",108,"م",2,0],["لَيثٌ بِحَجرٍ إِذا ما هاجَهُ فَزَعٌ","هاجَ إِلَيهِ بإِلجامٍ وَإِسراجِ",109,"ج",1,0],["ليثٌ جَسورٌ نَفُورٌ ماجدٌ مَلِكٌ","لرَوعهِ أمست الأعداءُ في الرُّجَمِ",110,"م",1,0]]}