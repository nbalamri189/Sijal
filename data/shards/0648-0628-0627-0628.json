"الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135900","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111509","الوافر"],[4083,"","https://poetry.dctabudhabi.ae/diwan/poem/147649","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90870","الرمل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81734","البسيط"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136698",""],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83541","الوافر"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83483","الوافر"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133100","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72347","البسيط"],[4653,"","https://poetry.dctabudhabi.ae/diwan/poem/97794","المتقارب"],[4767,"باب فاطمة","https://www.poetsgate.com/ViewPoem.aspx?id=180034",""],[4767,"نبع الإيثار","https://www.poetsgate.com/ViewPoem.aspx?id=197294",""],[4767,"كف الجود","https://www.poetsgate.com/ViewPoem.aspx?id=198231",""],[4843,"يا أمةَ العربِ الأمجادِ في القدمِ","https://www.poetsgate.com/ViewPoem.aspx?id=142690",""],[4926,"كيف يحصى عليك منا ثناء","https://www.poetsgate.com/ViewPoem.aspx?id=171114",""],[4927,"معاقيل الشهادة","https://www.poetsgate.com/ViewPoem.aspx?id=79608",""],[5136,"إلهي يسر الذات ذاتك في الأسما","https://www.poetsgate.com/ViewPoem.aspx?id=121654",""],[5187,"لقاءٌ بلا مَوعِد","https://www.poetsgate.com/ViewPoem.aspx?id=37393",""],[5334,"إني رأيتُ جريراً يوم فارقنا","https://www.poetsgate.com/ViewPoem.aspx?id=96976",""],[5431,"ياريح ....","https://www.poetsgate.com/ViewPoem.aspx?id=202363",""],[5612,"مُجيبَ السّائِلين","https://www.poetsgate.com/ViewPoem.aspx?id=183265",""],[5725,"وليل يكيل الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=179909",""],[5848,"رباعيات","https://www.poetsgate.com/ViewPoem.aspx?id=48997",""],[5953,"أرى ألف الحروف هي الحروف","https://www.poetsgate.com/ViewPoem.aspx?id=93806",""],[6068,"أين المسلمينا؟ -04-","https://www.poetsgate.com/ViewPoem.aspx?id=175907",""],[5309,"ذكرى ليالي الهوى العذري تصبينا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573536",""],[463,"يا وحشة َ المجدِ ثقي بالأنسِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60105&r=&rc=161",""],[6305,"مَنْ يُرينِي الشِّعْر ؟!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87327&r=&rc=0",""],[572,"تُرِيكَ مُرورُ الليالي العِبَرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9276&r=&rc=133",""]],"verses":[["وَبابُ الإِذنِ مِنّي كُلَّ يَومٍ","يُقَعقِعُ بِالقَوافي وَالنِظامِ",0,"م",1,0],["وَبابُكَ أَولى بي مِنَ الأَرضِ كُلِّها","فَحَتّامَ لي عَن قَرعِ بابِكَ حابِسُ",1,"س",1,0],["وَبِاِبنِ السِمطِ مِنّا قَد قَتَلنا","مُحَمَّداً اِبنَ هارونَ الأَمينا",2,"ن",2,0],["وَبِأَبرَقَي ضَحيانَ لاقَوا خِزيَةً","تِلكَ المَذَلَّةُ وَالرِقابُ الخُضَّعُ",3,"ع",1,0],["وبابني خزيمة بدر السما","ء والشمس مفتاح ما نأكل",4,"ل",1,0],["وبابُ محمدِ المرجوِّ يروَى","لقاصدِه نجاحٌ أو نجاء",5,"ا",2,0],["وباباً للمصير إلى أوانٍ","تُفتَّح فيه أبوابُ السماءِ",6,"ا",2,0],["وبابنك المرخص أمواله","تُغُولِيَ الحمد وأعلاقه",7,"ق",2,0],["وَبِاِبنَي قُبَيسٍ وَلَم يُكلَما","إِلى أَن يُضيءَ عَمودُ السَحَر",8,"ر",1,0],["وَبابٍ إِذا أَمَّهُ قاصِدٌ","رَآهُ مِنَ الغَيثِ أَدنى وَأَندى",9,"د",2,1],["وبآبائك الكرام التأسي","والتسلي عمن مضى والتعازي",10,"ز",2,0],["وبابن مريمٍ وشَوْا ونمُّوا","واحتشدوا لصَلبهِ وهمُّوا",11,"م",3,0],["وبابنَ التي لم يَضَعْ مِثُلها","كمِثلِكَ حَملاً ولم تُرْضِع",12,"ع",1,0],["وبابا قديما .. نقشت عليه","بخط رديء .. حكاياتيه",13,"ي",2,0],["وباب خيبر لما ان دحاه وها","لعزمه الحصن حتى صار في خلل",14,"ل",1,0],["وبابك با جدك خير هاد","فجد بالعطف يا غوث الأسير",15,"ر",1,0],["وباب رجائي في أموري جميعها","وواصل حبلي رغم باغ قلانيا",16,"ي",2,0],["وباب اللَه أنت بغير ريب","وبابك رحب سادات الرجال",17,"ل",1,0],["وبابه باب إسعادي بآخرتي","وفي الدنا باب إرشادي وإرباحي",18,"ح",2,0],["وبابن عثمان عبد الله سيدنا","وابن البكير إياس ساد إعلانا",19,"ن",2,0],["وبابن عوف وعمرو عقبة وكذا","عبيدة من لدين الله قد صانا",19,"ن",2,0],["وَبِاِبنِهِ بَعدَهُ عَبدُ المَليكِ فَقَد","زادوا ذَوي عَقلِنا شُكراً وَإيمانا",20,"ن",2,0],["وباب جودك مفتوح لقاصده","كما لسهمك في الاعداء تسديد",21,"د",1,0],["وبابه مجرب","ينجح فيه الطلب",22,"ب",1,0],["وباب حي يكون مدغما","وللندور كسر فائه انتمى",23,"م",2,0],["وَبابُ الخَيرِ وَالتَوفي","قِ في وَجهِكَ مُنسَدُّ",24,"د",1,0],["وبابن عمّه العليّ ذي الرضا","المرتضى السيف اليماني المنتضَى",25,"ض",2,0],["وبأبي حنيفةِ النعمان","شقيق روض الفضل ذي الإتقان",25,"ن",1,0],["وبابن حنبل صحيح السندِ","وكلّ شهمٍ في الورى مجتهدِ",25,"د",1,0],["وَبأبرق الحنان منزل زينَب","أَفَلا تحن لأبرق الحنان",26,"ن",1,0],["وَبابُكَ يا فَرد العُلى غَيرُ مُؤصَدِ","وَمدت بك النَعما غمائم جودها",27,"ه",2,0],["وَبابنه شرف الدين الَّذي وَصلت","به المحامد حرف الميم وَالدال",28,"ل",1,0],["وَبابك مَفتوح لكل مؤمل","وَبرك ممنوح لكل مصارم",29,"م",1,0],["وَبابُ جيرونَ قَد فارَت بِساحَتِهِ","فَوّارَةٌ هِيَ ظِئرُ الجَديِ تَرويهِ",30,"ي",2,0],["وَبابِلِيِّ اللَحظِ حُلوِ اللَمى","في خَدِّهِ الوَردُ الَّذي لا يَحول",31,"ل",1,1],["وَبابُهُ حِصنٌ حَصينٌ لَم يُسَم","من أَمَّهُ حَسو أَفاويقِ العطَب",32,"ب",1,0],["وبابِليّ لِحَاظٍ","ذي قامةٍ سَمْهَرِيّهْ",33,"ه",1,1],["وباب الصفا هو الذي قد ولجته","وبالعلمين الخضر أحسنت مولجا",34,"ج",2,0],["وبابه لجنان الخلد مقتبلاً","أدعى له حيث ناقور الحساب دعا",35,"ع",2,0],["وبابرة القطب اهتدوا","في البحر والديجور كافر",36,"ر",1,0],["وباب جودكم وقوفى دائما","كلفى يقبله وفقرى يلزم",37,"م",1,0],["وَبأبي أنت هل لوعدك ذا","من آخر بالوصال يقتربُ",38,"ب",1,0],["وبأبي الحامل إك","باراً لمن قد حملا",39,"ل",2,0],["وبأبيك حبه وبغضه","غداً يَرَى المحسنُ خسرانَ المُسي",40,"س",2,0],["وبأبي من قده معتدل","نشوان من خمر الشباب ثمل",41,"ل",1,1],["وبأبي أحورُ سيفُ لحظه","افتكُ يومَ الرَّوع من نصاله",42,"ل",2,0],["وبابي ذاك الكفلْ","وخصره وقد نحلْ",43,"ل",1,0],["وبأبي أغيد من أشراكه","هيهات أن ينجو فؤاد الحابل",44,"ل",1,0],["وبأبي بيضاءُ ودَّ الورق لو","تأخذ عنها سجعها الموزونا",45,"ن",2,0],["وَبابٌ إِن سَحَبتُ إِلَيهِ بُردي","فَحاجِبُهُ لِحاجِبِهِ قُطوبُ",46,"ب",1,0],["وبأبكار القوافي","لاَ على كفؤ شحيح",47,"ح",1,0],["وبابُهُ كعبَةُ القُصَّادِ أضحى","فهذا آبَ منهُ وذا مُقيمُ",48,"م",1,0],["وبإبرَاهيمَ ابنهِ","بينَ أخدَانِه العَمَد",49,"د",1,0],["وبابُك المعمورُ لا","عُطِّلَ من وَفْدِ الخَدَمْ",50,"م",1,0],["وبابه ما له انغلاق","عمن إليه أتى بذل",51,"ل",1,0],["وبإبراهيم خليلك من","نجّاه الحق من الوهج",52,"ج",1,0],["وبابُ أميرِ المؤمنين الذي به","ممرُّ أميرُ المؤمنينَ المهذّبِ",53,"ب",1,0],["وَبابها صارَ مَفتوحاً لِمَن رَغِبوا","في طَبع كُل بَديع راقَ وَاِنفَرَدا",54,"د",2,0],["وَبابُك مَفتوحٌ لِمَن جاءَ راجِياً","نَداكَ وَمَن عزت عَلَيهِ المَطالب",55,"ب",1,0],["وَباب الرَجا بِاليَأس أَصبَح مرتجاً","عَليّ وَكُلٌّ قَد تَحدّث في أَمري",56,"ر",2,0],["وَبابن نصيرٍ مفردِ الوَقت في التُقى","وَمَعروفٍ الكرخيِّ بحرِ علومنا",57,"ن",2,0],["وبابه يتلقّى فيه قاصده","بِشرٌ وَسَهلٌ وَمَعروفٌ بِهِ وَسَري",58,"ر",2,0],["وَبِابتِسامٍ أَبدى لَنا شَقائِقَهُ","لِنَشرَبَ الصّفوَ مِن أَقداحِ ياقوتِ",59,"ت",1,0],["وبأبيض كالأقحوان","وشارب كالأس أخضر",60,"ر",1,0],["وبأبطح البطحاء","أصبح مظهرا سر المزد",61,"د",1,0],["وبابك مفتوح لقصد مكارم","وقد سد عن نيل المكارم باب",62,"ب",1,0],["وبابه المدعو له","رسالة القشير",63,"ر",1,0],["وبابن عليّ عظم الله قدرها","واحيى لها اسماً في البلاد فضيلا",64,"ل",2,0],["وبأبناه الكرام سلوة","فإنهم سلالة الأطائب",65,"ب",1,0],["وباب البحر جف به عباب","وبات البر سلن به سهول",66,"ل",1,0],["وباب كثير العيون يرى","عجائب ما يصنع العاشقان",67,"ن",1,1],["وبابن العم أبي الحسنين","وقسورة الدين البهج",68,"ج",1,0],["وبابكموا بالظن فيكم نزلته","على ما أنا فيه من السوء سادتي",69,"ي",1,0],["وبأبراد معالي ظله","من تصاريف الردى، ملتحفه",70,"ف",2,0],["وباب أسمائك عجل المدد","والنصر والتفريج والفتح القريب",71,"ب",1,0],["وبأبدانهم سوابغ تعيي","أي نبل أصاب منها الدخالا",72,"ل",2,0],["وبابن الثامري إذا افتخرنا","ظللنا للكواكب معقلينا",73,"ن",2,0],["وبأبي كيفَ تجلَّيْتُما","عن كلِّ تأميلٍ وتأمين",74,"ن",1,0],["وبابن أخيه محسن أي سلوة","به تكشف اللأواء والضيق يرحب",75,"ب",1,0],["وبابدع الصُّوَرِ الجميلةِ س