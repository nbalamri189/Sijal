{"poems":[[74,"شجون نحوها العشاق فاؤا","https://www.aldiwan.net/poem18162.html","الوافر"],[228,"عين من هذه التي لا تنام","https://www.aldiwan.net/poem39708.html","الخفيف"],[261,"يا من يعادي الهوى جهلا بموقعه","https://www.aldiwan.net/poem48528.html","البسيط"],[280,"لمبشري برضاك أن يتحكما","https://www.aldiwan.net/poem25527.html","الكامل"],[369,"هل في عتاب الحادثات غناء","https://www.aldiwan.net/poem61013.html","الكامل"],[509,"يحرك وجدي قدك المتمايل","https://www.aldiwan.net/poem38405.html","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[440,"","https://poetry.dctabudhabi.ae/diwan/poem/47398","الكامل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52034","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2529,"","https://poetry.dctabudhabi.ae/diwan/poem/46740","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88997","الكامل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52971","الكامل"],[3749,"","https://poetry.dctabudhabi.ae/diwan/poem/33131","الطويل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35146","البسيط"],[5725,"مبتدأ الحب","https://www.poetsgate.com/ViewPoem.aspx?id=209146",""],[5309,"آراء اخواني بكم وحدتها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573682",""]],"verses":[["لمبعثه على العادين نار","وللهادين نور يستضاء",0,"ا",2,0],["لَم بَرَ الفَجرَ غاسِلاً بضياهُ","هَضابِ المَدينَةِ المَردومَه",1,"ه",1,0],["لم بت هذا طلاقاً حبل زوجته","وذاك في رقعة التابوت لم قتلا",2,"ل",2,0],["لِمُبَشِّري بِرِضاكَ أنْ يَتَحَكَّما","لا المالَ أسْتَثْنِي عَلَيْهِ ولا الدِّما",3,"م",2,1],["لَمُبرّأ من كُلّ ما اعتادَتْ له","نسباً إليّ لجهلها السفهاء",4,"ا",2,0],["لمبعضه جهلا وان ذم فضله","بتذكاره يمناً تحل المشاكل",5,"ل",1,0],["لمبداه كي أبديه فيما أفادني","فكنت به إياه حقاً كأنني",6,"ي",1,0],["لِمْ باحَ باسْمِي بَعْدَ ما كتَمَ الْهَوَى","زَمَناً وَأنَ صِيانَتي أَوْلى بهِ",7,"ب",2,1],["لِمُبَشِّرِي بِتَمَامِ عَفوِكَ مَا طَلَبْ","مَا بَعدَهُ لِي فِي الأمَانِي مِن أرَبْ",8,"ب",1,1],["لم بشبهوهم في جميع أمورهم","من كل وجه ليس يستويان",9,"ن",1,0],["لِمبعِّدٍ قُربي يَمُتُّ بِدونِها","إِنَّ امرءاً حُرِمَ الهُدى مَحرومُ",10,"م",1,0],["لمبدأ حبي فيه طبعٌ موفقٌ","ومالت إليه النفس من حبه قلبي",11,"ب",2,0],["لمباركٍ لا زال يقفو إثْره","نادى فقال له مباركُ مرحباً",12,"ب",2,0],["لِمُبتَهِجٍ يَومَ الهِياجِ خِطارُهُ","يُرى وَضَحاً وَالنَقعُ داجٍ ظَلامُهُ",13,"م",2,0],["لِم باكَرَت أقحُوانُ فيهِ","بِقَرعِ بابِ المُنى عَلَيهِ",14,"ي",2,0],["لمبتدأ الحب قاطولنا","فتحسنُ في ربضه الخاتمة",15,"م",2,0],["لِمُبشِّري بِقُدومِكُم لَم أُنصِفَ","يُبديه الأَحِبَّةُ عِزَّةً وَتَرَفُّعا",16,"ا",1,0]]}