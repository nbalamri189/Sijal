{"poems":[[53,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[53,"مستعبد هيهات إعتاقه","https://www.aldiwan.net/poem65706.html","السريع"],[53,"عد عن دار وعن جار ظعن","https://www.aldiwan.net/poem66467.html","الرمل"],[99,"أهاب بنا فلبينا","https://www.aldiwan.net/poem24768.html","مجزوء الوافر"],[82,"متى صدرت عيناك عن أرض بابل","https://www.aldiwan.net/poem31321.html","الطويل"],[70,"اسم الذي أهواه تصحيفه","https://www.aldiwan.net/poem1541.html",""],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16643","الوافر"],[99,"مصافحة اللقاء","https://www.poetsgate.com/ViewPoem.aspx?id=17343",""],[119,"بأية حجة منع الوصالا","https://www.aldiwan.net/poem40620.html","عموديه"],[164,"الدين دين ربنا والملك","https://www.aldiwan.net/poem59186.html","الرجز"],[358,"ألا هل لقلب عنك قد فقد الصبرا","https://www.aldiwan.net/poem40238.html","الطويل"],[385,"أذاب قلبي الوهج","https://www.aldiwan.net/poem49229.html","مجزوء الرجز"],[408,"غداة نأي الصبر الجميل مودعا","https://www.aldiwan.net/poem46516.html","الطويل"],[454,"اكسير الحياة","https://www.aldiwan.net/poem1020.html","عموديه"],[463,"ما سائر بين الورى دائر","https://www.aldiwan.net/poem56159.html","السريع"],[466,"ألا حبذا مسعى تميم بن خندف","https://www.aldiwan.net/poem15149.html","الطويل"],[484,"يعيش المرء في تعب ليحيا","https://www.aldiwan.net/poem37009.html","الوافر"],[566,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96991","الطويل"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130152","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59796","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120040","الوافر"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111804","الرمل"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102138","الوافر"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126228","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93648","الوافر"],[345,"","https://poetry.dctabudhabi.ae/diwan/poem/124715","الخفيف"],[2837,"","https://poetry.dctabudhabi.ae/diwan/poem/34838","الرمل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100251","المتقارب"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100215","الوافر"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100851","الوافر"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48287","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66485","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111405","الطويل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54375","الرجز"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94324","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83197","الرجز"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120221","الوافر"],[5061,"ي وجودي","https://www.poetsgate.com/ViewPoem.aspx?id=146719",""],[5190,"الجوزاء والبحر","https://www.poetsgate.com/ViewPoem.aspx?id=68758",""],[5409,"أضحكتنا ورب ضحكٍ بكاء","https://www.poetsgate.com/ViewPoem.aspx?id=155244",""],[5689,"هات لي الكأس عزيز القلب هات","https://www.poetsgate.com/ViewPoem.aspx?id=143411",""],[5937,"مَن نحن !","https://www.poetsgate.com/ViewPoem.aspx?id=211888",""],[5953,"يا دولة الحق كم تري تقف","https://www.poetsgate.com/ViewPoem.aspx?id=93850",""],[5956,"التحام صاحب العمل بموظفيه","https://www.poetsgate.com/ViewPoem.aspx?id=193192",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[6153,"غنى المعنى من فؤاد موجع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577080",""]],"verses":[["يوجسُ الليلُ رِكزَهُنَّ فينجا","بُ وإن كان حالِكَ الجِلبابِ",0,"ب",1,0],["يوجد مسبوقوه في فضله","تترى ولا يوجد سباقه",1,"ق",2,0],["يوجد العلم لديكم والهدى","أبدَ الدهر جميعاً في قَرَن",2,"ن",1,0],["يؤجج في نواظرنا","ويشعل في دماءينا",3,"ن",2,0],["يُوَجِّهُ وَجْهَ الحربِ نَحوَ عُداتِهِ","ويحشو حَشَاها بالقَنَا والقَنائِلِ",4,"ل",1,0],["يوجَدُ في تلكَ إذَنْ قِسْمَةٌ","ضِئزى عياناً وهوَ مكتوبُ",5,"ب",1,0],["يُؤجِّجُ في شُعاعِ الشمسِ ناراً","ويَقْدَحُ في تَلَهّبِها زِنادا",6,"د",2,0],["يؤجج في نواظرنا","ويشعل في دماءين!",7,"ن",1,0],["يؤجج بالتباعد نار قلبي","ويجعله له للفتك خالا",8,"ل",2,0],["يوجعنا في الله وهو سالم","يمشي برجليه أما من يفتك",9,"ك",1,0],["يُؤجّج نار الحُزن ذكرك في الحَشا","فَيوشك دَمع العَين أَن يُطفئ الجَمرا",10,"ر",2,0],["يَوجد وجداً في الجَما","د مِنهُ لَحظ غَنج",11,"ج",1,0],["يؤجّجُ لي ناراً يُريني أنّها","ومَا هيَ إلاَّ النّارُ وجدٌ وأشواقُ",12,"ق",1,0],["يوجهه للبيّنات فيرتوي","من المنهل العذب المصفى شعوره",13,"ر",2,0],["يوجَدُ منه ناحلٌ مسمِنٌ","يُحمَلُ في واردةٍ صادرهْ",14,"ر",2,0],["يؤججها نشوان من طربِ العُلى","طليقُ المُحيَّا والعيونُ دوامعُ",15,"ع",1,0],["يؤجل حتفه يوما فيوما","فيدنيه له طلب البقاء",16,"ا",2,0],["يُوَجِهُ الأَرضَ وَيستاقُ الشَجَر","حلائِباً نَكثُرُ فيها مَن كَثَر",17,"ر",1,0],["يؤججها وهاجةً في سما العلا","فتى قد نمته الصيد من آلا غالب",18,"ب",1,0],["يؤجج ناراً للضيافة قومها","كما أضرمت في مهجة الصب نارها",19,"ر",3,0],["يؤجج أثناء الضلوع ادّكارُه","بلابلَ لا تخبو أحر من الجمْر",20,"ر",1,0],["يؤجل دائما منه وعيد","ويعجل منه بالإنجاز وعدُ",21,"د",1,0],["يؤجرُ الصابرُ في المحنةِ ان","ارَّخوهُ أو بفوزٍ يظفر",22,"ر",1,0],["يوجّه نحو طيبَة قد قبلنا","مجيئكَ هاك ما فيه سناكا",23,"ك",2,0],["يُوجِعُ النَفسَ بالمجاعَةِ دَهراً","والظَمَا ساكنُ المَقامش القصَى",24,"ا",1,0],["يُوجه نَحوَ بَيت اللَه وَجها","كَوَجه الصُبح منفلقاً سطوعا",25,"ع",2,0],["يوجر القرن كلَّ فوهاء تبدي","لك ماخلف ظهره من أمامِ",26,"م",1,0],["يوجبُ النَصفَ عَلَيهِ","حاتِماً في كُلِّ عامِ",27,"م",1,0],["يؤجِّجُ ناراً عليك الزفير","فيسفح ماء العيون انسفاحا",28,"ح",2,0],["يؤجج في الحشا عباس نارا","يكاد القلب منها إن يذوبا",29,"ب",2,0],["يؤَجج بينه فتناً تحاكي","شبوب النار في الوادي الحطيب",30,"ب",1,0],["يؤجّجُ دمعَ العينِ نار غرامِه","متى ودّ أنْ يلقى خليلاً يودُّهُ",31,"د",2,0],["يوجد القول حيث لا يجد الغَي","ر مجالاً سوى المقال المقول",32,"ل",1,0],["يُؤَجّجُ في أَحشائِهِ نارَ عُزلةٍ","ووَجدٍ لضَجَّاتِ الوَغَى والجَحافِلِ",33,"ل",1,0],["يوجدُ فيه السبت في","كلِّ خميسٍ وأحَدْ",34,"د",1,0],["يوجهُ وجهاً للسماء لكي يَرى","رَقيعاً كما الأقمار تَزهو كواكبُه",35,"ب",2,0],["يُوجَرُ أَنف القِرنِ كُلَّ ثَعلَبٍ","كَثَعلَبٍ إلى وَجارٍ قَد أَوى",36,"ا",1,0],["يُؤَجِّجُ الغَيظُ بِهِ ضِراما","لَم يَرعَ لي عَهداً وَلا ذِماما",37,"م",2,0],["يوجه رأيه في كل وجه","فليس يحيد عن خط السداد",38,"د",1,0],["ي وجودي وجد من حظه ردي","والزمان الشين والوقت ابتلاه",39,"ا",2,1],["يُؤَجِّجُ الشَّوقُ صَوبَ النَّافِرَيْنِ دَمِي","فَهلَ سَتُطفِئُهُ إِن مَوعِدِي حَانَا ؟",40,"ن",2,0],["يوجد الخير حيث يوجد في المر","ء ضميرٌ يشع منه الضياء",41,"ا",2,0],["يوجد الخالق أحوال الورى","من وراه وشئون الكائنات",42,"ت",1,0],["يؤجل الصمت نيران الكلام بهِ","فترسل العين من أمواجها نارا",43,"ر",2,0],["يوجد بالجنس ثم يغرب بال","قدرة عن كل ناطق وصف",44,"ف",1,0],["يوجههم إلى الإخلاصِ دوماً","إلى العملِ المفيدِ المستقرِّ",45,"ر",1,0],["يُوجس ضَمير المُستَهام لَهيبها","وَقَلبي وَكَبدي ضمن جوفي غذالها",46,"ل",3,0],["يُوجس ضَميري المُستَهام زَفيرها","مثل نار تون القرطيان سَناه",47,"ا",2,0]]}