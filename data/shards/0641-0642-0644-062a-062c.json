{"poems":[[53,"وسائل ذات يوم","https://www.aldiwan.net/poem61922.html","المجتث"],[125,"ليالي سلمى ترتقي لي وتراقيا","https://www.aldiwan.net/poem23827.html","الطويل"],[190,"أريت في النوم دنيانا مزينة","https://www.aldiwan.net/poem43814.html","البسيط"],[202,"وزاهرة المحاسن ذات طرف","https://www.aldiwan.net/poem51928.html","الوافر"],[275,"هو الحب فليشق المحبون بالذكر","https://www.aldiwan.net/poem35635.html","الطويل"],[376,"إنلها من لوعة شانا","https://www.aldiwan.net/poem57074.html","البسيط"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83268","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64767","المجتث"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102137","البسيط"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121604","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91428","الوافر"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103036","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136653",""],[4830,"القلبُ الجَموح","https://www.poetsgate.com/ViewPoem.aspx?id=200251",""],[5277,"مكسورها الأخضر","https://www.poetsgate.com/ViewPoem.aspx?id=192000",""],[6068,"لُبنى -11-","https://www.poetsgate.com/ViewPoem.aspx?id=175839",""],[5190,"في رثاء النفس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85067&r=&rc=142",""]],"verses":[["فقلت جَمَّشَ أيْري","فما رآه يساعدْ",0,"د",1,0],["فقلت جواباً والجواب معمّمٌ","دعا نَفْسَ حِبٍّ للحبيب تناجيا",1,"ي",2,0],["فقلت جودي فقالت لي وقد حسرت","إذا تخلّصت من أيدي الخنازير",2,"ر",1,0],["فقلتُ جللتَ عن كلِّ المعاني","فللتقصيرِ لم أَنْطِقْ بحرف",3,"ف",1,0],["فقلتُ جُروحي في البلاءِ كثيرةٌ","فيا حبّذا جرحٌ بهِ الباسلُ افتخر",4,"ر",1,0],["فقلتُ جارَ الدَّمعُ في حُكمِه","فَفاضَ من أجفانِ أجفانا",5,"ن",2,0],["فَقُلتُ جَميعَ الرُشدِ في سُبُلِ حُبِّهِ","إِذا لااحَ لي مِن ذاكَ الوَجهُ لائِحُهُ",6,"ح",2,0],["فقُلتُ جُدْ لي بوصلٍ","فقالَ سَلْ غيرَ هذَا",7,"ذ",2,0],["فَقُلتُ جُد لي بالوصل الأعظم","أجابَ تمَّم أجاب تمَّم",8,"م",1,0],["فقلتُ جرى ماءُ المكارمِ والندى","وقد طاب مَجْراه لذا اخْضَرَّ أعْلاهُ",9,"ه",1,0],["فَقُلت جُننتُ في عشقي فَماذا","فَقالَ بذا وَصلت إِلى فنون",10,"ن",1,0],["فقلت جزيتم كلّ خير بنصحكم","أشرتم لعمري بالتي هي أرشد",11,"د",1,0],["فقلتُ جسمي إي وحق الهوى","وذا يمينٌ ما به مَين",12,"ن",1,0],["فقلتُ جِراحُهُ من غير جيمٍ","تَدُبُّ ليسكُنَ القلبُ الجَموحُ",13,"ح",1,0],["فقلت جريرهُ الأعرابِ","مهما قلتِ لا تُقهرْ",14,"ر",1,0],["فقلتُ: جميل حبيبة قلبي","أضمك صدريَ، هذا مثنّى",15,"ن",2,0],["فقلتُ: جنودُ اللهِ تُنذِرُ غافلاً","بزحفٍ توالى كلَّ يومٍ على الشَّعرِ",16,"ر",1,0]]}