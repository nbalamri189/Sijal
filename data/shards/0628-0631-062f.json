22,"النهر الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=12693",""],[5790,"بردت حرارة قلبك المشتاق","https://www.poetsgate.com/ViewPoem.aspx?id=112091",""],[5829,"في مخيم الكشافة","https://www.poetsgate.com/ViewPoem.aspx?id=161989",""],[5829,"رياضُ الشّام","https://www.poetsgate.com/ViewPoem.aspx?id=212095",""],[5829,"هذي دمشق","https://www.poetsgate.com/ViewPoem.aspx?id=214085",""],[5829,"ارفق بحالي ايها الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=214732",""],[5848,"جتك تكفى","https://www.poetsgate.com/ViewPoem.aspx?id=53101",""],[5848,"أنا أكثر منك برد","https://www.poetsgate.com/ViewPoem.aspx?id=48840",""],[5879,"الوجد لي","https://www.poetsgate.com/ViewPoem.aspx?id=215458",""],[5880,"بغداد ودمشق","https://www.poetsgate.com/ViewPoem.aspx?id=208577",""],[5956,"تجلو المعاني لي كخير مترجمِ","https://www.poetsgate.com/ViewPoem.aspx?id=181983",""],[5956,"سؤال وجواب على شاطئ البحر","https://www.poetsgate.com/ViewPoem.aspx?id=183228",""],[5956,"بالي عليكم دائماً مشغولُ","https://www.poetsgate.com/ViewPoem.aspx?id=203724",""],[5957,"تهذيب الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=195141",""],[6237,"الليل والشاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77881&r=&rc=23",""],[6328,"آمنة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84422&r=&rc=20",""],[6351,"مخطوطة للمتنبي.. لم تُحقَّق بعد!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86051&r=&rc=4",""]],"verses":[["بَرَدَت عَلَيَّ كَأَنَّما","طَلُّ الغَمامَةِ عارِضاها",0,"ا",3,0],["بُردي عَفيفٌ إِذا غَيري لِفَجرَتِهِ","كانَت مَناسِجُ بُردَيهِ عَلى التُهَمِ",1,"م",1,0],["بَرَدَ السِوارُ لَها فَأَح","مَيتُ القَلائِدَ بِالعِناقِ",2,"ق",1,0],["بَردُ عِزٍّ أَو حَرُّ نَصلٍ فَإِنّي","أَجِدُ اليَومَ في ضُلوعِيَ رَمضا",3,"ض",2,0],["بَردُ القُلوبِ لِمَن تُحِبُّ بَقاءَهُ","مِمّا يَجُرُّ حَرارَةَ الأَكبادِ",4,"د",1,0],["بَردُ نَسيمِ الحِجازِ في السَحَرِ","إِذا أَتاني بِريحِهِ العَطِرِ",5,"ر",1,1],["بُردانِ مِن نَسجِ الجَلا","لِ إِلَيهِما الفَخرُ اِنتَهى",6,"ه",2,0],["بَرَدَت ظِلالُ ذُراكَ وَاِحلَولى جَنى","نُعماكَ لي وَصَفَت جِمامُ نَداكا",7,"ك",2,0],["بردان هذا من وقار ونهى","حيك وهذا من تصابٍ وهوى",8,"ا",1,0],["برد أطاف بنار منك موقدةٍ","ليست تبوخ ولا تُذكى بمسعار",9,"ر",1,0],["بَرَدى ذَكَرتُكَ لِلعَطاشى فَاِرتَوَوا","وَبَني النُهى فَتَرَشَّفوكَ رِضابا",10,"ب",2,0],["بَرِّدي يا سُحبُ مِن ظَمَأي","وَاِهطُلي مِن بَعدِ ذا ذَهَبا",11,"ب",2,0],["بَردٌ عَجيبٌ قَد خاطَهُ لَبِقٌ","فَلَيسَ بِدعاً إِن حازَهُ لَبِقُ",12,"ق",1,0],["بَرَدى وَراءَ ضِفافِهِ مُستَعبِرٌ","وَالحورُ مَحلولُ الضَفائِرِ مُطرِقُ",13,"ق",1,0],["بَرِّد حَشايَ إِنِ اِستَطَعتَ بِلَفظَةٍ","فَلَقَد تَضُرُّ إِذا تَشاءُ وَتَنفَعُ",14,"ع",1,0],["بَردَ رُضابٍ إِذا تَرَشَّفَهُ ال","مَتبولُ خالَ الضَريبَ في ضَرَبِه",15,"ب",2,0],["بَردُ اَحَشا وَهَجيرُ الرَوعِ مُحتَفِلٌ","وَمَسعَرٌ وَشَهابُ الحَربِ مُستَعِرُ",16,"ر",1,0],["بُرِدَت عَرائِكُها بِجَوزِ تَنوفَةٍ","وَبِهِنَّ مِن أَينِ الكَلالِ فُتورُ",17,"ر",1,0],["بَردِيَّةٌ في الغيلِ يَغذو أَصلَها","ظِلٌّ إِذا تَلعَ النَهارُ وَماءُ",18,"ا",2,0],["بَرِّد بِيَأسِكَ عَنكَ حَرَّ مَطامِعٍ","قَدَحَت بِعَقلِكَ أَثقَبَ الأَشعالِ",19,"ل",1,0],["بردى لنا وصباه وال","جنّات والطير المرن",20,"ن",1,0],["بَرَّدَ النارَ عَنهُمُ حِينَ فارَت","تَرتَجي أَكلَهُم وَأَحمى حِماها",21,"ا",3,0],["بَرَدَت عَلى كَبِدِ المُصابِ وَأَصبَحَت","مِنّي نَوافِذُ حَرِّها لَم تَبرُدِ",22,"د",1,0],["بَردُ الصِبا لَيسَ مِثلَ البُردِ تَخلَعُهُ","وَجازَ أَن يَستَعيدَ اللُبسَ مَن خَلَعَه",23,"ع",2,1],["بُردُ التَقِيِّ وَإِن تَهَلَّلَ نَسجُهُ","خَيرٌ بِعِلمِ اللَهِ مِن بُردَيكُما",24,"م",2,0],["بُردُ الشَبابِ وَبُردُ الناسِجِ اِبتُذِلا","وَهَل يَدومُ عَلى البَردَينِ بُردانِ",25,"ن",1,0],["بَرَدَى وَنَضْرُ غِيَاضِهِ وَرِيَاضِهِ","نِعَمُ الْحَيَاةِ تَجَمَعَّتْ فِي وَادِ",26,"د",1,0],["بَرَدَى حَوْلَهُ نُفُوسٌ حِرَارٌ","لَيْسَ تُرْوَى بِالسَّلْسَبِيلِ النَّمِيرِ",27,"ر",1,0],["بردى، نظمتَ لنا الزمانَ قصائداً","بيضاً وحُمْراً منْ ندىً وصفاحِ",28,"ح",1,1],["بردى شقيق النيل منذ أميّة","جُمععنا على الأفراح والأتراح",29,"ح",1,0],["بردى هلِ الخلدُ الذي وعدوا به","إلاكَ بين شوادنٍ وشوادي",30,"د",2,0],["بَرَّدَ اللَهُ فُؤادي إِنَّهُ","كُلَّما هاجَتهُ ذِكراكَ اِحتَرَق",31,"ق",1,0],["بُرْدَتُهُ الليل على بَرْدِه","وكِنُّهُ الْقَيْظُ على حَرِّه",32,"ر",2,0],["بَرْدُ الحَشَا، وَهَجيرُ الرّوْعِ محْتفِلٌ،","وَمِسعَرٌ، وَشِهابُ الحرْبِ مُستَعِرُ",33,"ر",1,0],["برّدي ، يا سجي ، من ظمأي","واهطلي من بعد ذا ذهبا",34,"ب",2,0],["بردى والورود في ضفّتيه","مصغيات لشعره والخزامى",35,"م",2,0],["بردى أدار عليكم صهباء","وجلت عرائسه لكم نوّارها",36,"ر",3,0],["بردك فوق الخصر جار الرؤى","فخلفه تطفر جنّيّتان",37,"ن",1,1],["برداً على برد الشتاء زائدا","لا بارداً يَفثأ حَرَّا واقدا",38,"د",2,0],["برد بقربك نيراني فإن لها","شباً كأن له تخبيط شيطان",39,"ن",1,0],["بَرِدٌ تُقَحِّمُهُ الدَبورُ مَراتِباً","مُلقى ضَواحي بَينِهِنَّ لُهوبُ",40,"ب",1,0],["بَرَدٌ لاَ يَذُوبُ مَا بَينَ خَمْرٍ","جَامِدٍ مِنْ رُضابِهِ في رَحِيقِ",41,"ق",1,0],["بَردٌ وَظِلٌّ لِلصَديقِ وَجَنَّةٌ","وَعَلى أَعاديهِ حِميمٌ آنِ",42,"ن",1,0],["بَرَدٌ يُذيب ولا يَذوب وكلما","شرِب المتيمُ منه زاد غَليلا",43,"ل",2,0],["برد الشتاء معذب","يشقى به الرجال الفقير",44,"ر",1,1],["بَرَدَ المُقَبِّلُ مِن لَذاذَهِ ثَغرِها","حُمشَ اللِثاثِ كَأَنَّهُ مَصقولُ",45,"ل",1,0],["بَرَدَ الحُليّ فنافرتْ عَضُدي وقد","هبَّ الصباحُ ونامَتِ الجَوْزاءُ",46,"ا",2,0],["بردف الكثيب وقدِّ القضيب","وعين الغزال ووجه الصنمْ",47,"م",1,0],["بَرِّدْ غليل فؤادي","بِبَرْدِ تِلك الثنايَا",48,"ا",3,1],["بَرِّد بلثمك قلبَ مَن","أسكنتَه جَمْرَ الغضا",49,"ض",2,0],["بَرَدٌ يُذيبُ وَلا يَذوبُ وَرُبَّما","أَذكى زَفيرَ الوَجدِ شَفُّ بُرودِهِ",50,"د",2,0],["بُردٌ وَسَيفٌ لا يُفَلُّ وَخاتِمٌ","فَمُحَلبَبٌ وَمُقَلَّدٌ وَمُخَتَّمُ",51,"م",1,0],["بَرَدى ودجلةُ والفراتُ مياهُنا","وكذلك الأردنُّ ثم العاصي",52,"ص",2,0],["برداكِ مرآةٌ وتاريخٌ معاً","للحُسنِ والمجدِ الذي يُعليك",53,"ك",1,0],["برَدى يرجّعُ لي غناءً مطرباً","فيه نواحُ الثكلِ والترميل",54,"ل",1,0],["برّدوا عَن حشائي","بحواشي رداها",55,"ا",3,0],["بَرَدْنَ الصّدى لمّا ورَدن من النَّدى","علَى سَائِغ يُنْبُوعُهُ العدُّ سائِح",56,"ح",1,0],["بِرِدفِهِ ثقلُ غَرامي بِهِ","وَخَصرُهُ مِثلي براهُ النُحول",57,"ل",1,0],["(بردى) يبكيه