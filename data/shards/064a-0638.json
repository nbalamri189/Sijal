دائِمٌ","وَكُلَّ صُعودٍ مُعقَبٌ بِنُزولِ",3,"ل",1,0],["يَظُنّونَ أَنَّ المَجدَ فيمَن لَهُ الغِنى","وَأَنَّ جَميعَ العِلمِ فَضلُ التَشادُقِ",4,"ق",1,0],["يَظُنُّ أَنِّيَ وَصّالٌ بِهِ سَبَبي","إِنّي إِذاً مِن أَميرِ المُؤمِنينَ نَفي",5,"ف",2,0],["يظلُّ حَوالَيْهِ المَساكينُ عُوَّذاً","بخَيْر إمامٍ والسّلاطينُ سجّدا",6,"د",2,0],["يَظلُّ وفي ظَهْرِ الحِصانِ مَقيلُهُ","ويُمْسي وبَطْنُ المَضْرَحِيِّ لهُ قَبْرُ",7,"ر",1,0],["يَظَلُّ لِأَكؤُسِهِم راكِعاً","كَثيرَ السُجودِ وَما يَركَعونا",8,"ن",2,0],["يَظَلُّ هَواكِ مُرتَهِناً لِقَلبي","وَقَلبي مِن جَوى حُبٍّ يَحولُ",9,"ل",1,0],["يَظُنُّ هَذا وَذا ما لَيسَ يَعرِفُهُ","وَدَمعُ عَينَيَّ بِما أُخفيهِ قَد نَطَقا",10,"ق",2,0],["يَظُنُّ بِيَ الناسُ الظُنونَ وَأَنتُمُ","هَوايَ الَّذي أُخفي إِلى يَومَ أُقبَرُ",11,"ر",1,0],["يَظُنُّ الناسُ بي وَبِهِم وَأَنتُم","لَكُم صَفوُ المَوَدَّةِ وَاللُبابُ",12,"ب",1,0],["يَظَلُّ لِساني يَشتَكي الشَوقَ وَالهَوى","وَقَلبي كَذي حَبسٍ لِقَتلٍ مُراقِبِ",13,"ب",1,0],["يَظَلُّ نَهارَ الوالِهينَ نَهارَهُ","وَتَهدِنُهُ في النائِمينَ مَضاجِعُ",14,"ع",1,0],["يُظَلِّلُنَا بِالْغَيْمِ نَدٌّ وَعَنْبَرٌ","وَتنْضَحُنَا بِالطِّيْبِ سُحْتٌ سَوَاكِبُ",15,"ب",1,0],["يَظُنُّ الناسُ بِالمَلِكَي","نِ أَنَّهُما قَدِ اِلتَأَما",16,"م",2,1],["يَظَلُّ رَجيماً لِرَيبِ المَنونِ","وَلِلسَقمِ في أَهلِهِ وَالحَزَن",17,"ن",1,0],["يَظَلُ جَبينُهُ غَرَضاً لِسُمرٍ","كَأَنَّ نُسورَها حُشِيَت نِصالا",18,"ل",2,0],["يَظَلُّ حَصى المَعزاءِ بَينَ فُروجِها","إِذا ما اِرتَمَت شَرواتِهِنَّ القوائِمُ",19,"م",1,0],["يَظَلُّ يَنشُدُ مِن ذَرّاتِها نَبَأً","ضَنَّت بِهِ الأَرضُ في ماضٍ مِنَ الحُقُبِ",20,"ب",1,0],["يَظُنُّ رائيهِ أَنَّهُ جُرَذٌ","مُطَلّعٌ رَأسَهُ مِنَ الثَقبِ",21,"ب",1,0],["يَظَلُّ اللِّيْلُ مِنْهُ وَقَدْ تَوَارَى","إِلَى أَمَدٍ بِهِ أَثَرُ الْتِهَابِ",22,"ب",1,0],["يظل يقلق رفساً","ما حوله من ظلال",23,"ل",1,0],["يَظَلُّ مُرتَبِئاً لِلشَمسِ تُصهِرُهُ","إِذا رَأى الشَمسِ مالَت جانِباً عَدَلا",24,"ل",2,1],["يَظَلُّ بِها الحِرباءُ لِلشَّمس ماثِلا","عَلى الجَذلِ إِلا أَنَّهُ لا يُكَبِّرُ",25,"ر",1,0],["يُظَلِّلنَ دونَ الشَمسِ أَرطىً تَأَزَّرَت","بِهِ الزُرقُ مِما تَردى أُجارِدُ",26,"د",1,0],["يَظَلُّ مُختَضِعا يَبدو فَتُنكِرُهُ","حالا وَيَسطَعُ أَحيانا فَيَنتَسِبُ",27,"ب",1,0],["يَظَلُّ يُعارِضُ الرَبَعَيَّ خَطٌّ","بِنَعلِ السَيفِ مِن قِصَرَ النِجادِ",28,"د",1,0],["يَظَلُّ لَدَيها الواغِلونَ كَأَنَّما","يُوافونَ بَحراً مِن سُمَيحَةَ مُفعَما",29,"م",2,0],["يَظَلُّ اللَيثُ فيها مُستَكيناً","لَهُ في كُلِّ مُلتَفٍّ أَنينُ",30,"ن",1,0],["يظلله وقت المسير وتارةً","يشير إليه بالبنان فيمطر",31,"ر",1,0],["يظلّ أبا جهلٍ عليَّ بجهله","وأمسي بأوصاف السّقام أبا ذَرّ",32,"ر",1,0],["يظلّ السائدون لدى حماه","سدًى يستأذنون على الحضور",33,"ر",1,0],["يظنُّ من طار خوفاً من مهابته","أنَّ النجوم عليه في الدجى شبك",34,"ك",1,0],["يظنُّني عاقلاً كما زعموا","فهو على الظنِّ نافرٌ عنِّي",35,"ي",1,0],["يَظلِمُ الناسُ في القيادةٍ أَفْرى","أنت منه باللومِ أَوْلى وأَحْرى",36,"ر",2,1],["يظل يسترهِبُني موعداً","هَوْنَك ما مثلي بمُسترهَبِ",37,"ب",1,0],["يظلُّ وتدبيرُ الممالِك جِدُّهُ","وبذل العطايا المُنفِساتِ معَابثُهْ",38,"ث",2,0],["يظلُّ من يسمع أهْوالها","من صارخٍ ذُعْراً ومسْتَصرخِ",39,"خ",1,0],["يظل كأن الله يرفع قدرَهُ","بما حطّ من قدري وصغَّرَ من أمري",40,"ر",2,0],["يظل يُراعيني بعينَيْ شَناءةٍ","يدل على بَغْضائها النظر الشَّزرُ",41,"ر",1,0],["يظل يُراعيني بعينَي شناءةٍ","ويُعرِضُ عن ودي بخدٍ مُصعّر",42,"ر",1,0],["يظلم الناس يعلم الله أفْرَى","أنت بالكشخ منه أولى وأحْرَى",43,"ر",2,1],["يظل بها النوّار للشمس راكعاً","يَدورُ إذا دارت له وهو ناكس",44,"س",1,0],["يظلُّ سامعه لُدْناً مفاصلُهُ","كأنما فتَّرتْ أوصاله الكاس",45,"س",1,0],["يظل يلاحظ وجه الندي","م فرداً وحيداً فيستأنسُ",46,"س",1,0],["يظل معاديه وطالبُ رفده","على شَرفيْ رفدٍ وموتٍ مُغافص",47,"ص",1,0],["يظلُّ يبكيهمْ إذا رحلُوا","بُكاءَ غَيْلان بنت فضَّاضه",48,"ض",2,0],["يظلُّ لها المزكومُ حين يسوفُها","سحابةَ يومٍ وهْو بالمسك يُفعَمُ",49,"م",1,0],["يظلّ إذا أبدى لنا منه صفحةً","تلذّ بها أبصارنا وتنعَّمُ",49,"م",1,0],["يظلُّ وللرِّياح به اصطخابٌ","وللعُجْمِ الفصاحِ به اختصامُ",50,"م",1,0],["يظلُّ يرى حقَّهُ باطلاً","أطافَ خيالاً على نائمِ",51,"م",1,0],["يظلمُ الحاسدونَ إذْ حسدوهُ","وهْو في ماله شريكُ الأنامِ",52,"م",1,0],["يَظَلُّ بَنو النَعامَةِ حابِسيهُم","إِذا وَرَدوا وَوِردُهُمُ ذَميمُ",53,"م",1,0],["يَظَلُّ في الحَنظَلِ الخُطبانِ يَنقُفُهُ","وَما اِستَطَفَّ مِنَ التَنّومِ مَخذومُ",54,"م",1,0],["يَظلُمُ الدَهرُ حينَ يَعزو إِلَيهِ","البُؤس وَالبُؤسُ كُلُّ أُمٍّ كَنودِ",55,"د",1,0],["يَظُنُّ بِكَ اللَيلُ يَحوي فيكَ شَخصاً","وَما يَحوي الدُجى إِلّا عِظاما",56,"م",2,0],["يَظَلُّ بِها السَرحانُ يَعوي مِنَ الطَوى","نَهاراً وَيَطوي لَيلَهُ الخَوفُ طاوِيا",57,"ي",2,0],["يَظَلُّ الإِباءُ ساقِطاً فَوقَ مَتنِهِ","لَهُ العَدوَةُ الأولى إِذا القِرنُ أَصحَرا",58,"ر",2,0],["يَظَلُّ فَتيقُ المِسكِ وَهوَ مُعَطَّلٌ","بِهِ وَنَسيمُ الجَوِّ وَهوَ مُعَطَّرُ",59,"ر",1,0],["يَظَلُّ شارِبِها رِخواً مَفاصِلُهُ","يَخالُ بُصرى جِمالاً ذاتَ أَحداجِ",60,"ج",1,0],["يَظَلُّ في الشاءِ يَرعاها وَيَعمِتُها","وَيَكفِنُ الدَهرَ إِلّا رَيثَ يَهتَبِدُ",61,"د",1,0],["يظهر الشر من مراقبة الاطفال","قبل الافعال في النزعات",62,"ت",1,0],["يُظهر المدح رونق الرجل الما","جد كالسيف يزدهى بالصقال",63,"ل",1,0],["يظل يسجع في الإسلام شاعركم","كان أيامه أيام حسان",64,"ن",1,0],["يَظفَرُ العُذرُ بِأَقصى سُخطِها","وَيَنالُ الوُدُّ غاياتِ رِضاها",65,"ا",3,0],["يُظِلّونَ المَناقِبَ مِنكِ شَتّى","وَيُؤوُنَ التُقى وَالصالِحاتِ",66,"ت",1,0],["يَظَلُّ نَديمي يُسقى بِها","وَيَشرَبُ مِن خُلُقي الفاضِلِ",67,"ل",1,0],["يَظُنُّ أَنَّ فُؤادي غَيرَ مُلتَهِبٍ","وَأَنَّ دَمعَ جُفوني غَيرُ مُنسَكِبِ",68,"ب",1,0],["يَظَلُّ رَشيدٌ وَهوَ فيها مُعَلَّقٌ","عَلى خَطَرٍ في البَيعِ مُقتَرِبُ المَهوى",69,"و",2,0],["يَظُنُّ العِدى أَنّي فَنيتُ وَإِنما","هِيَ السِنُّ في بُردٍ مِنَ الشَيبِ مُتهَجِ",70,"ج",1,0],["يَظَلُّ الحَمامُ الوُرقُ في جَنَباتِهِ","يُذَكِّرُنا أَحبابَنا بِهَديلِهِ",71,"ل",2,0],["يَظَلُّ هَجيناً مِن أَبيهِ إِذا دَعا","لِأَنباطِ تَرعودٍ وَأَعرابِ حايِلِ",72,"ل",1,0],["يَظَلُّ حُمولَةُ يَبني العُلا","وَتَعلو المَعالي بِبُنيانِها",73,"ن",3,0],["يَظَلُّ القَطا مِن حَيثُ ماتَت رِياحُهُ","يُعارِضُني تَخشى الهَلاكَ قَوارِبُه",74,"ب",2,0],["يَظَلُّ إِلى أَن تَغرُبَ الشَمسُ قائِماً","تَشَمُّسَ 