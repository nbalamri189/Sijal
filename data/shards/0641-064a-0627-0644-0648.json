{"poems":[[57,"بعثت إلي صحيفة مختومة","https://www.aldiwan.net/poem26527.html","الكامل"],[95,"صدق النعي وردد الهرمان","https://www.aldiwan.net/poem11225.html","الكامل"],[95,"طيبوا قراراً أيها الأعلام","https://www.aldiwan.net/poem11358.html","الكامل"],[74,"تخيلت في إنشاء لفظي نجعة","https://www.aldiwan.net/poem18279.html","الطويل"],[87,"يقولون عن مصر بلاد عجائب","https://www.aldiwan.net/poem7296.html","الطويل"],[82,"ولما تنازعن معنى الحديث","https://www.aldiwan.net/poem31372.html","المتقارب"],[52,"يا ابني جلا هل بكما تنكير","https://www.aldiwan.net/poem63823.html","الرجز"],[48,"في الوحدة الراحة العظمى فآخ بها","https://www.aldiwan.net/poem23133.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54959","الخفيف"],[121,"يوم الشَّنق","https://www.aldiwan.net/poem24032.html","الكامل"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[369,"أنا والرجاء وأنت والكرم","https://www.aldiwan.net/poem60667.html","أحذ الكامل"],[435,"باح الفؤاد بسر كنت أخفيه","https://www.aldiwan.net/poem41067.html","البسيط"],[449,"أهلا بطلعة وجهك المحبوب","https://www.aldiwan.net/poem55944.html","عموديه"],[466,"بنو المظفر والأيام شاهدة","https://www.aldiwan.net/poem16066.html","البسيط"],[469,"سرت موهناً لا أبعد الله مسراها","https://www.aldiwan.net/poem3493.html","عموديه"],[469,"إن حجبتم أشباحكم والمناما","https://www.aldiwan.net/poem3525.html","عموديه"],[469,"رمتني بنجل والسهام جفون","https://www.aldiwan.net/poem3591.html","عموديه"],[484,"هبت الصبا فصبا","https://www.aldiwan.net/poem37058.html","المقتضب"],[505,"الغيب صف مواكبه","https://www.aldiwan.net/poem37562.html","مجزوء الكامل"],[556,"رأيت فلم أر فيما رأيت","https://www.aldiwan.net/poem47836.html","المتقارب"],[563,"كن مع الله تر الله معك","https://www.aldiwan.net/poem34279.html","الرمل"],[580,"بعثت لي على فم الطيف قبله","https://www.aldiwan.net/poem3037.html","الخفيف"],[580,"عادني من هوى الأحبة عيد","https://www.aldiwan.net/poem3078.html","الخفيف"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138276",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138281",""],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88596","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87272","الرمل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70981","الرمل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62690","الرمل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62495","الرمل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/177841","الطويل"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/201717","الطويل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109346","الرمل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77305","الرمل"],[2263,"","https://poetry.dctabudhabi.ae/diwan/poem/140242",""],[2321,"","https://poetry.dctabudhabi.ae/diwan/poem/147008","البسيط"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115810","البسيط"],[3062,"","https://poetry.dctabudhabi.ae/diwan/poem/204403",""],[3083,"","https://poetry.dctabudhabi.ae/diwan/poem/138001",""],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121718","الدوبيت"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145046","الطويل"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82825","الرمل"],[3556,"","https://poetry.dctabudhabi.ae/diwan/poem/138020","الرجز"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59480","الرمل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114450","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114452","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111506","السريع"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111452","البسيط"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36392","الدوبيت"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45917","الطويل"],[4545,"","https://poetry.dctabudhabi.ae/diwan/poem/216344",""],[4750,"لمزاين","https://www.poetsgate.com/ViewPoem.aspx?id=180416",""],[4902,"ياصغير مايكبرني لقب","https://www.poetsgate.com/ViewPoem.aspx?id=22586",""],[5072,"لنا غدنا في الحب","https://www.poetsgate.com/ViewPoem.aspx?id=53579",""],[5174,"لغتنا.. عزَّتنا","https://www.poetsgate.com/ViewPoem.aspx?id=199656",""],[5323,"يا فؤادي !","https://www.poetsgate.com/ViewPoem.aspx?id=209173",""],[5363,"رثاء أبي","https://www.poetsgate.com/ViewPoem.aspx?id=199951",""],[5376,"والفجرِ وليالٍ عشرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=205810",""],[5512,"الأم ( غفوت )","https://www.poetsgate.com/ViewPoem.aspx?id=204345",""],[5512,"البدر أمسى هلالاً","https://www.poetsgate.com/ViewPoem.aspx?id=204347",""],[5956,"عانيتُ حبَّكِ","https://www.poetsgate.com/ViewPoem.aspx?id=182334",""],[5956,"كم قلتُ: ساعدنا أيا جبار","https://www.poetsgate.com/ViewPoem.aspx?id=192698",""],[6127,"السمو","https://www.poetsgate.com/ViewPoem.aspx?id=205187",""],[6167,"تلك القمم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85544&r=&rc=27",""],[6190,"إباء الورد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86998&r=&rc=4",""],[6259,"عبسن من شعرٍ في الرأس مبتسمِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59397&r=&rc=45",""],[6289,"دِمّشْقْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81753&r=&rc=5",""]],"verses":[["في الوُدِّ تَزعُمُ أَنَّني ذو مَلَّةٍ","خُنتُ العُهودَ فَدَيتُها مِن كاذِبِ",0,"ب",1,0],["فِي الوَقْفَةِ الكُبْرَى لَهُ الأَثَرُ الَّذِي","يَبْقَى عَلَى مُتَعَاقِبِ الأَزْمَانِ",1,"ن",1,0],["فِي الْوَعْظِ وَالتَّثْقِيفِ تُنْفِقُ كلَّ مَا","أُوتِيتَ مِنْ هِمَمٍ وَهُنَّ جِسَامُ",2,"م",1,0],["فيا لوزيرٍ عن تقاهُ وبرِّهِ","رويتُ حديثَ المكرمات صَحابي",3,"ب",2,0],["فيالورد هذا الحكم والله مطلق","ومن مطلق الأحكام تأتي المصائب",4,"ب",1,0],["فيا لو رأيتَ ارتعادَ الجسومِ","لَقُلتَ الرّياحُ تهزُّ الوَرَق",5,"ق",1,0],["في الوَعثِ مُحفوفٌ بِهِ الوُعورُ","جَشَّمَها ذَلِكَ تَيَّهورُ",6,"ر",1,0],["في الوَحدَةِ الراحَةُ العُظمى فَآخِ بِها","قَلباً وَفي الكَونِ بَينَ الناسِ أَثقالُ",7,"ل",1,1],["فِي الْوَصَايَا الْعَشرِ التِي اسْتكمَلَتْ","فِي الشرْعِ لِلنَّاسِ حَاجَة الأدْهَارِ",8,"ر",1,0],["في الواحةِ الخَضراءِ حَوْلَ قُصُورِهِ","يَتَزاحَمُ الزُّعَماءُ والأَحزابُ",9,"ب",1,0],["في الوَجهِ تَدويرٌ وَأشربَ حمرَة","فَوقَ البَياضِ الزاهِرِ الخَدّانِ",10,"ن",1,0],["في الوُدِّ أَوْلَى باتّهامِكَ مَنْ","في الدِّينِ أَصبحَ وهْو مُتَّهَم",11,"م",1,0],["فيا لويلاتنا اللاتي سلفن لنا","هل أنت بالطيف ميت الحب تأتيه",12,"ي",2,0],["في الوعر سهل لا يعاصي عالما","بفنونه سباق كل ركوب",13,"ب",1,0],["في الودِّ أغْيدُ غُصنٍ لانَ ملمسهُ","وفي الحفيظة شختُ الحدِّ ذو أثر",14,"ر",1,0],["فيا لوعةً بين الجوانح والحشا","وذكرى دعتْ لبّي إليها فلبّاها",15,"ا",3,0],["في الوغى والنديِّ حرباً وسلماً","شفّ في ذا كلما وفي ذا كلاما",16,"م",2,0],["فيا لوعةً عذريّةً ما احتسبتها","إذ الوصل ظنٌ والفراق يقين",17,"ن",1,0],["في الوفا له أرب","ما أجله أربا",18,"ب",2,0],["في الوهم حاضرةٌ وفي","عين المحقِّق غائبه",19,"ب",2,0],["فيا لوعتي فيه لا تقصُرِي","ويا دمعتي فيه لا تجمُدِي",20,"د",2,0],["في الورى إن شاء خفضاً ذقته","وإذا شاء عليهم رفعك",21,"ك",1,0],["في الورى مِثلُهُ كثيرٌ ولكن","كَلَفِي أَكْمَهٌ وعشقيَ أَبْلَه",22,"ل",2,0],["في الوَرى مثلُهُ كَثيرٌ ولكِنْ","كَلَفِي أَبْلَهٌ وعِشْقي بَلِيدُ",23,"د",1,0],["في الوصف مهما طال إسهابي فلا","يأتي على عشر من المعشار",24,"ر",1,0],["في الوعظ لو نسجت كل الرؤوس على","منواله لهمى الإحسان أمطارا",25,"ر",2,0],["فَيا لوجوه في ثرى الطف غيَّبت","ومن نورها ما في الأَهلة يسطع",26,"ع",1,0],["في الوَغى عَن خَير أُمَّهْ","صَدرُها أَعظَم صَدرِ",27,"ر",1,0],["في الوغى أشجعُ منهم","غنمٌ تأْوِى وتسرَح",28,"ح",1,0],["في الوغى بين نصال المصلِتين","من له في الذل يوماً جزؤ",29,"ز",2,0],["في الوفا صرتُ طريحاً","بين أسباب المَنونِ",30,"ن",1,0],["في الوزن والروي والإعراب","وهو الذي موضعه في الباب",31,"ب",1,0],["فيا لو ترانا كنت تنظر عصبة","حيارى سكارى نحو مكة وُلاه",32,"ه",1,0],["فيا لوعة القلب المُصاب إذا بدت","ورود خلت في الروض من ذلك الحسن",33,"ن",1,0],["في الورى احيت من المجد الرمم","ومعال ليس في طوق القلم",34,"م",1,0],["في الوَغى في الطَعنِ في ضَربِ الطُلى","في قِراعِ الدارِعِ المُستَبسِلِ",35,"ل",1,0],["في الوجه غرته كالشمس ساذجة","يقصر الطرف عن تحقيقها ويني",36,"ن",2,0],["فيا لويلات أنسٍ باللقاء مضت","هل عودةٌ منك تشفي الوجد والعللا",37,"ل",2,0],["في الوصل خوف الهجر من شغف","فكل أوقاتهم همٌّ وأحزان",38,"ن",1,0],["في الوغى حين لا يرى","صاحب القوس منزعا",39,"ع",2,0],["في الوقت ما حصلت مثلك رشيد","في المال والدنيا الزهيده",40,"د",2,0],["في الوصلِ حَلَتْ حياةُ نَفْسٍ وصَفَتْ","والهجرُ به يُطِيلُ رَبِّي عُمْرِي",41,"ي",1,0],["فيا لوضيع النفس كيف تطاولت","به نفسه حتى أسر لك القتلا",42,"ل",2,0],["في الوَرى يُعزى إِلَينا","أَمرُها خَيراً وَشَرّا",43,"ر",2,0],["في الوقف في الأول خلف قد ذكر","ومنعه في الباقيين مشتهر",44,"ر",1,0],["فِى الوَقفِ تَا تَأنِيثِ الإسمِ هَا جُعل","إن لَم يَكُن بِسَاكِنٍ صَحًّ وُصِل",45,"ل",1,0],["في ألوفٍ سبعةٍ لو زاحمت","ركنَ رضوى انهدَّ منه ما شَهَقْ",46,"ق",1,0],["في الوصل والقطع مُحسنٌ وحيثُ تلا","كتابَ ربِّهِ أنسى صوتَ أم حسن",47,"ن",1,0],["في الوجه منهُ من غناهُ غنى","يا عينُ فاسمع وابكِ يا أذني",48,"ي",1,0],["في الوسط بل من عرشه يرتجل","يا صحب أتباع أريس المذل",49,"ل",1,0],["فَيا لِوَيلِ بَنِي الإنسَانِ إِن حَمَلُوا","عَلى بَنِي الخُلدِ عَن حُمقٍ وَعَن غَضَبِ",50,"ب",1,0],["في الودّ أَراكَ خادِعاً مَلّاذا","في نَقضِكَ عَهدَ من وَفى نَفّاذا",51,"ذ",2,1],["فَيا لَو تَراهُم يَومَ لَبَّوا وَأَحرَموا","وَكُلُّهُم لِلَّهِ داعٍ وَخاضِعُ",52,"ع",1,0],["فَيالَو تَراهُم يَومَ وافوا لِطيبَةٍ","وَلاحَ لَهُم مِن طيبَةِ النورِ لامِعُ",52,"ع",1,0],["في الوقت ذا مَ اكثَرْ صِدِيجي على الرّخا","وإلا على الشَّطات كِلها امحاربه",53,"ب",2,0],["في الورد ما يشرب من الحوض ثنتين","ما هيب تنقر حوضها نقر مفرود",54,"د",1,0],["في الوفا تاريخ أبيض ينتصب","لا حكوا بالحق حيين الضمير",55,"ر",1,0],["فيا لوح َ أحلامي بعمري َ كلِّه ِ","تعالي ْ فنار ُ القلب ِ أفردها الوقد ُ",56,"د",1,0],["في (الواتسْ) نؤلمها، في (الفيسْ) نغضِبُها","(مواقعُ) اليومِ تُنْكِيْهَا وتُؤْذِيْهَا",57,"ي",3,0],["‏في الورى رأسٌ وفيهمْ (....)","‏فارفعِ المدحَ لمن كانَ أَحَقْ!",58,"ق",1,0],["في الوفد سار أبي وعز نظيرُه","لا مثلة بين الأحبة أفقدُ",59,"د",1,0],["في الوَرْدِ طيبٌ في خمائله","والطيبُ شهدٌ فى جنى النحْلِ",60,"ل",1,0],["في الوجهِ نورٌ يضيء الدّربَ في عُتَمٍ","وصورةُ الوجهِ مثل البدرِ يكتملُ",61,"ل",1,0],["في الوجهِ نورٌ وفي ثغرٍ لها ألقٌ","والزّهرُ لوناً من الخدَينِ يغترفُ",62,"ف",1,0],["في الواقعيَّة كم صعبٌ تناولُهُ","إنَّا نعيش خيالاً في تناولِهِ",63,"ل",2,0],["في الوسع أن ننجو بنظمِ قصائدٍ","وروائعٍ تجري بها الأنهارُ",64,"ر",1,0],["في الوجهِ قابلني، ونصلٌ غائرٌ","في الظهرِ أنبتَ ساقَهُ متبخترا",65,"ر",2,0],["فيا لوعةً مثلَ هَولِ الأَنينِ","تغَشَّتْ فؤادَ الضنى والسَقَمْ",66,"م",1,0],["في الوردِ ما في الوردِ غيرُ شمائلٍ","في الوردِ ما في الوردِ غيرُ لطائفِ",67,"ف",1,1],["في الوحش زادهم والمزنُ ماؤهم","تحمَّلتهم فأغنتهم عن الأدم",68,"م",1,0],["فيالَوادي لُجَيْنٍ فَوْقَ عَدْوَتِهِ","زُمُرُّدٌ يَتهادى مِنْهُ عِقْيانُ",69,"ن",1,0]]}