{"poems":[[74,"مولاي مولاي نجم الدين دعوة من","https://www.aldiwan.net/poem18458.html","البسيط"],[87,"قم حي هذي النيرات","https://www.aldiwan.net/poem63775.html","مجزوء الكامل"],[107,"جاء الرسول كتابه بيمينه","https://www.aldiwan.net/poem44005.html","الكامل"],[107,"ترك الملوك ملوك كندة وانتحى","https://www.aldiwan.net/poem44009.html","الكامل"],[107,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[107,"أقبل فتلك ديار يثرب تقبل","https://www.aldiwan.net/poem44226.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55101","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55057","البسيط"],[138,"أبني طالب إن شيخك ناصح","https://www.aldiwan.net/poem21019.html","الكامل"],[186,"أهلا بأكبر وافد زار الحمى","https://www.aldiwan.net/poem61083.html","الكامل"],[201,"كفي الملام وعلليني","https://www.aldiwan.net/poem39948.html","مجزوء الكامل"],[214,"قسما بحفظ عهودكم وودادي","https://www.aldiwan.net/poem13298.html","الطويل"],[215,"هذا ربيع وأنت ناء","https://www.aldiwan.net/poem46772.html","مخلع البسيط"],[242,"هذا هلال المغرب","https://www.aldiwan.net/poem18051.html","الوافر"],[310,"يا سيد العلماء علما راسخا","https://www.aldiwan.net/poem56408.html","الكامل"],[371,"إليك بعد انقضاء الجد واللعب","https://www.aldiwan.net/poem17151.html","البسيط"],[382,"ذلت لعزة دينك الأديان","https://www.aldiwan.net/poem59237.html","الكامل"],[382,"قدك البعاد فهل إليك سبيل","https://www.aldiwan.net/poem59293.html","الكامل"],[409,"من فلق البحر للكليم ومن","https://www.aldiwan.net/poem33376.html","المنسرح"],[567,"نحن التراب إلى تراب نرجع","https://www.aldiwan.net/poem52741.html","الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138365",""],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110354","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84505","السريع"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95545","البسيط"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110289","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93575","الكامل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100917","الكامل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65983","الرجز"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140092",""],[3048,"","https://poetry.dctabudhabi.ae/diwan/poem/100604","الكامل"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126279","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87394","الكامل"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112370","السريع"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131992","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216756","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118001","الكامل"],[3962,"","https://poetry.dctabudhabi.ae/diwan/poem/131910","البسيط"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119665","البسيط"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123498","المنسرح"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97064","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83589","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83459","السريع"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117278","الكامل"],[4404,"","https://poetry.dctabudhabi.ae/diwan/poem/127938","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72353","الكامل"],[4718,"هذا رسولٍ للهدى كله انوار","https://www.poetsgate.com/ViewPoem.aspx?id=137566",""],[3464,"الحمد مقصور عليه ذي السنا","https://www.poetsgate.com/ViewPoem.aspx?id=158703",""],[4858,"صبراً أُخَيَّ","https://www.poetsgate.com/ViewPoem.aspx?id=29944",""],[4896,"في ركاب الأمل","https://www.poetsgate.com/ViewPoem.aspx?id=180885",""],[4961,"يا سيِّدَ الحبِّ الجميل ِ","https://www.poetsgate.com/ViewPoem.aspx?id=33334",""],[3271,"في وادي النسيان","https://www.poetsgate.com/ViewPoem.aspx?id=103534",""],[5183,"أقصوصة الروض","https://www.poetsgate.com/ViewPoem.aspx?id=180289",""],[5542,"يا فارس الكرسي","https://www.poetsgate.com/ViewPoem.aspx?id=9679",""],[5561,"هو خيرةٌ من خيرةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=193807",""],[5612,"بَدْرُ الدُّجَى","https://www.poetsgate.com/ViewPoem.aspx?id=179798",""],[5612,"مَهْرَجانُ النُّورْ","https://www.poetsgate.com/ViewPoem.aspx?id=184063",""],[5674,"ستلقى في رحيلي مصرعك","https://www.poetsgate.com/ViewPoem.aspx?id=192276",""],[5686,"لو ماتت الأشجار ما مات الصدى","https://www.poetsgate.com/ViewPoem.aspx?id=203365",""],[5720,"تَطفِيْف","https://www.poetsgate.com/ViewPoem.aspx?id=208516",""],[5725,"بانت سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=200939",""],[4623,"أتسرك الدنيا وعمرك ذاهب ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146604",""],[5770,"الفجر موعده اقترب","https://www.poetsgate.com/ViewPoem.aspx?id=178700",""],[5829,"ولد السلام","https://www.poetsgate.com/ViewPoem.aspx?id=178915",""],[845,"إلى أبي تراب","https://www.poetsgate.com/ViewPoem.aspx?id=159622",""],[5956,"ميمي هربتِ؟","https://www.poetsgate.com/ViewPoem.aspx?id=182276",""],[6070,"فاضَ الهيامُ بدوحةِ الأفكارِ","https://www.poetsgate.com/ViewPoem.aspx?id=188568",""],[6093,"أَلِهَ المُعنى ما يُحيرُ جوابا","https://www.poetsgate.com/ViewPoem.aspx?id=177706",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[5309,"أنوار هادي الورى في كعبة الحرم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573517",""],[406,"أحمد ياسين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=70027&r=&rc=87",""],[6315,"البَيدَاءُ وَ الجَنِينُ المُرتَقَب ... تَحِيَّتَانِ للأُنثَى !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87577&r=&rc=2",""]],"verses":[["هذا رجا الدجن كم أرسى وكم لك من","عقد من المنّ عندي واضح النهج",0,"ج",1,0],["هَذا رَسولُ اللَهِ لَم","يُنقِص حُقوقَ المُؤمِناتِ",1,"ت",1,0],["هذا رسولُكُ جَاءَهُ بِهَديّةٍ","فيها لنفسِك كلُّ ما تَهَبُ المُنَى",2,"ن",2,0],["هذا رفيقُك ما لقومِكَ غيرُه","نِعمَ الرفيقُ إذا اللّبيبُ تَخَيَّرا",3,"ر",2,0],["هذا رسولُ اللّهِ مَن يكُ مُؤمناً","فإليهِ إنّ طريدَه لا يُفلِحُ",4,"ح",1,0],["هذا رسولُ الله ِ في أصحابِه","لا يَشتكِي نَصَباً ولا يَتمهَّلُ",5,"ل",1,0],["هَذَا رِثَاؤُكَ مِنْ مُحِبٍّ","قَادِرٍ لَكَ حَقَّ قَدْرِكَّ",6,"ك",1,0],["هَذَا رَثَاءٌ أَطْلَقْتُ فِيهِ","وَهْيَ شُجُونِي بِلاَ سِيَاقِ",7,"ق",1,0],["هَذا رَجائي فيكَ بَعدَ مَنِيَّتي","لا زِلتُ فيكَ بِكُلِّ رُشدٍ واثِقُ",8,"ق",1,0],["هَذا رَسولُ السَعدِ جاءَ مُبَشِّراً","بِالصَفوِ وَالإِقبالِ وَالعَيشِ الهَنِي",9,"ن",2,0],["هذا رماني بالشذوذِ","وذا رماني بالجنونِ",10,"ن",1,0],["هذا رسول الله ابلغ منذر","حقا وأفصح ناطق بالضاد",11,"د",1,0],["هذا ربيعٌ وأنت ناءٍ","وكنت أبهى من الربيع",12,"ع",1,1],["هذَا رَفيعُ الرُّتَبِ","هَذَا عَظيمُ الْمَنْصِبِ",13,"ب",1,0],["هَذا رَسولي اِبن الإمامِ أتاكمُ","مُستهدياً تُحَفاً تروقُ الصائما",14,"م",2,0],["هَذا رَبيعُ لِآلِ فَصلِهِ","فَيا لَهُ مِن رَبيعٍ حَلَّ في رَجَبِ",15,"ب",1,0],["هذا رجائي قبل يوم منيتي","والنفس يُرهِبُ دَينَها الميزان",16,"ن",1,0],["هذا رجائي والجزاء مؤخِّري","عنه ولكن عفوك المدلول",17,"ل",1,0],["هذا رجائي إذ أفوز به","علمت أن الزمان يسعدني",18,"ن",2,0],["هذا رفيقُكَ في الطَّريقِ وغيرهُ","يمضي فليسَ تراهُ حينَ تُوَدِّعُ",19,"ع",1,0],["هذا رسول الخير أقبل مصلحاً","فكأنما رجع الزمان الاول",20,"ل",1,0],["هذا ربيعٌ في ربيعٍ زَارَنا","وجَلاَ علينا وجههُ المتسَّما",21,"م",2,0],["هذا رسول الله هذا الذي","نزيلُه بين الورى لا يُضام",22,"م",1,0],["هذا رثائى قابله على قِصَرٍ","فطالما منك جاد الناس غفرانُ",23,"ن",1,0],["هذا ربيب الأمس فيك فما","أبقى له من بعدك البعد",24,"د",1,0],["هَذَا رَأينَاهُ بِكتبِكُمُ وَلَم","نَكذِب عَلَيكُم فِعلَ ذِي البُهتَانِ",25,"ن",1,0],["هَذَا رَأينَاهِ بِكُتبِهِمُ وَمِن","أفوَاهِهِم سَمعاً إِلَى الآذانِ",25,"ن",1,0],["هذا رَئيس المسلمين وَسَيفه","نَصر المهيمن وَالسُيوف حَديد",26,"د",1,0],["هذا رسولُ الموت ينسخُ آيهُ","ولكلّ شرعٍ فى الوَرَى أحكام",27,"م",1,0],["هذا رجائي فيك يا من عفوه","للخائف المعصوم حصن سام",28,"م",1,0],["هذا رخام أبيض في لونه","يحكي صفا البلور والفضية",29,"ه",1,0],["هذا ربيع قد بدا في روضةٍ","فهواي فيه لا يزال ومنزلي",30,"ل",2,0],["هذا رسول الله يدعوك فقم","وانهض ولب وخل من ألهاكا",31,"ك",2,0],["هَذا رَسول الدولةالعظمى الَّتي","هي دَوح مَجدٍ وهو من اغصانِهِ",32,"ن",2,0],["هذا ربيعٌ أعطني مِثلَهُ","وخذ إذا ما شئتَ كلّ الدهور",33,"ر",1,0],["هذا رجائي في الشباب الهنا","حققه في وطني وفي طلابه",34,"ب",2,0],["هذا رضاك ولو أردت وهبتنا","قلباً يصم إذا الغرام دعاه",35,"ا",2,0],["هذا رسول اللَه نبّهنا على","عدل المجوس وحكمة اليونان",36,"ن",1,0],["هذا رجاها بكف من تضرعها","فاعطف بفضلك ابلغها امانيها",37,"ي",3,0],["هذا رضا اللَه خير الرسل كلهم","والجوهر الفرد في افضاله الجزل",38,"ل",1,0],["هذا ربيع الجمال هل رجب","الحب جماد الملام فيه درى",39,"ر",2,0],["هذا ركني تصدعي يا رواسي","واسقطي يا نجوم فالبدر غابا",40,"ب",2,0],["هذا رَسولُ اللَهِ هذا أَكبَرُ","وَبِنورِهِ كُلّ الوُجودِ مُنَوَّرُ",41,"ر",1,1],["هذا رَبيعُ الخَيرِ قد عَمَّنا","منكَ وَبِالوَصلِ رَبيع القُلوب",42,"ب",1,0],["هذا ربيعٌ قد أتاك مبشرا","بقدوم مولد خير من وطىءَ الثرى",43,"ر",2,1],["هذا رجائي ثم هذي غايتي","القصوى وهذا ما بهِ اتفكر",44,"ر",1,0],["هذا رواق مدينة العلم التي","عن بابه قد ضلَّ من لا يدخل",45,"ل",1,0],["هذا رسول للهدى كله انوار","نور طريق للهدى من قضبها",46,"ه",2,0],["هذا رسول أكرم الورى ندىً","إمامُ رسل ذو جدىً وندىً وفا",47,"ا",1,0],["هَذا رَسُولُ اللهِ يَبْدو قِمَّةً","لِلْعَالَمينَ فَسِيرَةٌ عَلْيَاءُ",48,"ا",2,0],["هذا ركابي قر فيك ولست غير فتى برم","والأرض أفسح ما تكون لم تحل به النقم",49,"م",1,0],["هذا رحيقي فاستلِمْ","منْهُ مقاليدَ القيادةْ",50,"د",2,0],["هذا ربيبكِ أعظمٌ منسيّةٌ","رجفت لها في الخافقين الأدهرُ",51,"ر",1,0],["هذا رفيق الفتى ذو فطنة وله","لدى معاوي زلفى أنت تدريها",52,"ي",3,0],["هذا رجائي يا ابنَ ياسينَ الذي","شيَّدتُ في قلبي له بنيانا",53,"ن",2,0],["هذا رسولُ اللهِ يرفعُ شأنهُ","خُلُقٌ بهِ الأخلاقُ تسمو عاليا",54,"ي",2,0],["هذا رسولُ اللهِ هَلَّ بَشيرُهُ","ما أجْمَلَ البَدْرَ البَهِيَّ وأعْظَما",55,"م",2,0],["هذا رَبيعُ الخَيْرِ هَلَّ هِلالُهُ","وأتَى يُبَشِّرُنا بذِكْرَى المَوْلِدِ",56,"د",1,0],["هذا رحيلٌ في عباءَتِهِ الجفا","قَطعاً ستلقى في رَحيلي مَصْرَعَكْ",57,"ك",1,0],["هذا ربيعي .... والزهور جوانحي","والزيزفون يهز روحي مشهدا",58,"د",2,0],["هذا رجائي .. وعفوُ اللهِ مَسْأَلَتِي","لعلَّ ما أبتغي يدنو من النَّيْلِ",59,"ل",1,0],["هذا رسول الهدى للناس مرحمة","قد خصه من بيان الرب تأييدُ",60,"د",1,0],["هذا رسول الله جاء يهديكم","فلتعرفوا بهداه فهو العاقب",61,"ب",1,0],["هذا رباط الصامدي","نَ الصابرين على الكُرَب",62,"ب",1,0],["هذا رباط المؤمني","ن إلى السماء له سبب",62,"ب",1,0],["هذا رسول للبيان مفصلٌ","يهدي الفصاحة فاجمع الالماسا",63,"س",2,0],["هذا رصيدك بالنفوس فما ترى","أيحبك المذبوح والمطعون",64,"ن",1,0],["‏هذا رفيقك شاعر الكون الذي","‏ ‏ يسعى لنفع الفكر وهو كفيل",65,"ل",1,0],["هذا رسولُ اللهِ مبعوثُ الورى","خيرُ الخليقةِ في دُنا الأسرارِ",66,"ر",1,0],["20. هذا رسولُ الله أفصحُ ناطقٍ","بالضادِ قال وأعرَبَ الإعرابا",67,"ب",2,0],["هَذا رَجا قَلبي مَشاهد وَلا يَفي","وَتذكر مَواضي الخاينين وَفعالها",68,"ل",3,0],["هذا رَسولُ الهُدى فارشُف عَلَى ظمَإٍ","مِن وِردِهِ العَذبِ عَطفاً شاقَ كُلَّ ظَمي",69,"م",2,0],["هذا رجائي يابن ياسين الذي","شيَّدتُ في قلبي له بنيانا",70,"ن",2,0],["هذا ( رَمَادٌ ) يَشدُّ اللَّحنَ مُكْتَنِزاً","في رِبقَةِ اللَّيل إنْ ولَّى وإنْ آبَا",71,"ب",2,0]]}