{"poems":[[74,"مولاي مولاي نجم الدين دعوة من","https://www.aldiwan.net/poem18458.html","البسيط"],[87,"قم حي هذي النيرات","https://www.aldiwan.net/poem63775.html","مجزوء الكامل"],[107,"جاء الرسول كتابه بيمينه","https://www.aldiwan.net/poem44005.html","الكامل"],[107,"ترك الملوك ملوك كندة وانتحى","https://www.aldiwan.net/poem44009.html","الكامل"],[107,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[107,"أقبل فتلك ديار يثرب تقبل","https://www.aldiwan.net/poem44226.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55101","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55057","البسيط"],[138,"أبني طالب إن شيخك ناصح","https://www.aldiwan.net/poem21019.html","الكامل"],[186,"أهلا بأكبر وافد زار الحمى","https://www.aldiwan.net/poem61083.html","الكامل"],[201,"كفي الملام وعلليني","https://www.aldiwan.net/poem39948.html","مجزوء الكامل"],[214,"قسما بحفظ عهودكم وودادي","https://www.aldiwan.net/poem13298.html","الطويل"],[215,"هذا ربيع وأنت ناء","https://www.aldiwan.net/poem46772.html","مخلع البسيط"],[241,"هذا هلال المغرب","https://www.aldiwan.net/poem18051.html","الوافر"],[309,"يا سيد العلماء علما راسخا","https://www.aldiwan.net/poem56408.html","الكامل"],[370,"إليك بعد انقضاء الجد واللعب","https://www.aldiwan.net/poem17151.html","البسيط"],[381,"ذلت لعزة دينك الأديان","https://www.aldiwan.net/poem59237.html","الكامل"],[381,"قدك البعاد فهل إليك سبيل","https://www.aldiwan.net/poem59293.html","الكامل"],[407,"من فلق البحر للكليم ومن","https://www.aldiwan.net/poem33376.html","المنسرح"],[565,"نحن التراب إلى تراب نرجع","https://www.aldiwan.net/poem52741.html","الكامل"]],"verses":[["هذا رجا الدجن كم أرسى وكم لك من","عقد من المنّ عندي واضح النهج",0,"ج",1,0],["هَذا رَسولُ اللَهِ لَم","يُنقِص حُقوقَ المُؤمِناتِ",1,"ت",1,0],["هذا رسولُكُ جَاءَهُ بِهَديّةٍ","فيها لنفسِك كلُّ ما تَهَبُ المُنَى",2,"ن",2,0],["هذا رفيقُك ما لقومِكَ غيرُه","نِعمَ الرفيقُ إذا اللّبيبُ تَخَيَّرا",3,"ر",2,0],["هذا رسولُ اللّهِ مَن يكُ مُؤمناً","فإليهِ إنّ طريدَه لا يُفلِحُ",4,"ح",1,0],["هذا رسولُ الله ِ في أصحابِه","لا يَشتكِي نَصَباً ولا يَتمهَّلُ",5,"ل",1,0],["هَذَا رِثَاؤُكَ مِنْ مُحِبٍّ","قَادِرٍ لَكَ حَقَّ قَدْرِكَّ",6,"ك",1,0],["هَذَا رَثَاءٌ أَطْلَقْتُ فِيهِ","وَهْيَ شُجُونِي بِلاَ سِيَاقِ",7,"ق",1,0],["هَذا رَجائي فيكَ بَعدَ مَنِيَّتي","لا زِلتُ فيكَ بِكُلِّ رُشدٍ واثِقُ",8,"ق",1,0],["هَذا رَسولُ السَعدِ جاءَ مُبَشِّراً","بِالصَفوِ وَالإِقبالِ وَالعَيشِ الهَنِي",9,"ن",2,0],["هذا رماني بالشذوذِ","وذا رماني بالجنونِ",10,"ن",1,0],["هذا رسول الله ابلغ منذر","حقا وأفصح ناطق بالضاد",11,"د",1,0],["هذا ربيعٌ وأنت ناءٍ","وكنت أبهى من الربيع",12,"ع",1,1],["هذَا رَفيعُ الرُّتَبِ","هَذَا عَظيمُ الْمَنْصِبِ",13,"ب",1,0],["هَذا رَسولي اِبن الإمامِ أتاكمُ","مُستهدياً تُحَفاً تروقُ الصائما",14,"م",2,0],["هَذا رَبيعُ لِآلِ فَصلِهِ","فَيا لَهُ مِن رَبيعٍ حَلَّ في رَجَبِ",15,"ب",1,0],["هذا رجائي قبل يوم منيتي","والنفس يُرهِبُ دَينَها الميزان",16,"ن",1,0],["هذا رجائي والجزاء مؤخِّري","عنه ولكن عفوك المدلول",17,"ل",1,0],["هذا رجائي إذ أفوز به","علمت أن الزمان يسعدني",18,"ن",2,0],["هذا رفيقُكَ في الطَّريقِ وغيرهُ","يمضي فليسَ تراهُ حينَ تُوَدِّعُ",19,"ع",1,0]]}