لوافر"],[536,"عرفت مقام القوم إذ بت تجهد","https://www.aldiwan.net/poem48236.html","عموديه"],[549,"لقد ضل من يسترق الهوى","https://www.aldiwan.net/poem48120.html","المتقارب"],[551,"أحق أنه أودى يزيد","https://www.aldiwan.net/poem68415.html","الوافر"],[553,"لقد علمت هذيل أن جاري","https://www.aldiwan.net/poem1922.html","الوافر"],[560,"أرى الدهر يقضي كل يوم ديونه","https://www.aldiwan.net/poem52787.html","الطويل"],[560,"يا أيها السفح ماذا يصنع البان","https://www.aldiwan.net/poem52853.html","البسيط"],[560,"أتدري ما بقلبك من جراح","https://www.aldiwan.net/poem52911.html","الوافر"],[573,"لقد عفت عيشي بعد العفيف","https://www.aldiwan.net/poem2791.html","المتقارب"],[573,"أتطلب من زمانك ذا وفاء","https://www.aldiwan.net/poem2792.html","الوافر"],[573,"بذلت وإن ضنوا وفيت وإن خانوا","https://www.aldiwan.net/poem2844.html","الطويل"],[573,"لقد عذبتني بالغرام مليحة","https://www.aldiwan.net/poem2872.html","الطويل"],[573,"لقد عمرت بيوت الحسن ممن","https://www.aldiwan.net/poem2978.html","الوافر"],[573,"مضى معهم قلبي فلله درره","https://www.aldiwan.net/poem3060.html","الطويل"],[583,"أتطمع في عقالك أن يحلا","https://www.aldiwan.net/poem1564.html",""]],"verses":[["لَقَد عافَ أَموالَهُ مَن يَجودُ","وَقَد طَلَّقَ النَفسَ مَن يَشجُعُ",0,"ع",1,0],["لَقَد عادَيتَ يا اِبنَ العَمِّ لَيث","شُجاعاً لا يَمَلُّ مِنَ الطِرادِ",1,"د",1,0],["لَقَد عَرَّضَتني لِلظُنونِ صَبابَتي","وَوُقِّفتُ لِلواشينَ في غَيرِ مَوقِفِ",2,"ف",1,0],["لَقَد عَذَّبتَني يا حُبَّ لُبنى","فَقَع إِمّا بِمَوتٍ أَو حَياةِ",3,"ه",1,1],["لقدْ عمّ منْكَ الرّفْدُ مَنْ جاءَ قاصِداً","نَوالَكَ حتّى للمَواسِمِ إرْفادُ",4,"د",1,0],["لَقَد عَلِمَت قُرَيشٌ حَيثُ كانَت","بِأَنَّكَ خَيرُهُم حَسَباً ودينا",5,"ن",2,0],["لَقَد عاشَرتَنا فَلَبِثتَ فينا","مِثالاً لِلنَزاهَةِ وَالكَمالِ",6,"ل",1,1],["لَقَد عَزَّ السَريرُ وَتاهَ لَمّا","تَبَوَّأَهُ المَليكُ المُستَقِلُّ",7,"ل",1,0],["لَقَد عَلِمَت عُليا رَبيعَةَ أَنَّنا","ذُراها وَأَنّا حينَ تُنسَبُ جيدُها",8,"د",3,1],["لَقَدْ عَظمتْ بِحَاضِرِهَا","كَمَا عَظُمَتْ بِماضِيهَا",9,"ي",3,0],["لَقَد عَلِمَت نِزارٌ أَنَّ قَومي","إِلى نَصرِ النُبُوَّةِ سابِقينا",10,"ن",2,0],["لَقَد عَلِمتُ وَمالي ما أَعيشُ بِهِ","أَنَّ الَّتي أَدرَكَتني حِرفَةُ الأَدَبِ",11,"ب",1,1],["لَقَد عَجِبَت سَلمى وَذاكَ عَجيبُ","رَأَت بِيَ شَيباً عَجَّلَتهُ خُطوبُ",12,"ب",1,1],["لَقَد عَلِقَت مَيٌّ بِقَلبي عَلاقَةً","بَطيئاً عَلى مَرِّ الشُهورِ اِنحِلالُها",13,"ل",3,0],["لقد عرفَ الإِسلام مما أفدتَهُ","مكارمَ أنصاريّةً وأياديا",14,"ي",2,0],["لقد علم اللهُ أنّي امرؤٌ","أُجَرِّرُ ذيل العفاف القشيبْ",15,"ب",1,1],["لقد عاش في عزّ بحيث أذلّهم","وقد ساءهم من حيث سرّ الأجانبا",16,"ب",2,0],["لقد عشت في الدنيا أسيفاً وليتني","تَرَحّلت عنها لا عليَّ ولا ليا",17,"ي",2,0],["لقد عابني جهلاً ولم يدر أنّه","أقلّ فِداءٍ للذي هو عائبه",18,"ب",2,0],["لقد عظمت مناحتكم فقامت","تنوح بها الحرائر والأماء",19,"ا",2,0],["لقد عاش شيخاً في العلوم مقدّماً","فما ضرّه أن مات غير معمّر",20,"ر",1,0],["لَقَد عَلِقَت يَمينُكَ قَرنَ ثَورٍ","وَما عَلِقَت يَمينُكَ بِاللِجامِ",21,"م",1,1],["لَقَد عَلِمَ الحَيُّ المُصَبَّحُ أَنَّنا","مَتى ما يُقَل يا لِلفَوارِسِ نَركَبِ",22,"ب",1,0],["لَقَد عَلِمَ الفَرَزدَقُ أَنَّ قَومي","يُعِدّونَ المَكارِمَ لِلسِبابِ",23,"ب",1,0],["لَقَد عَلِمتُ وَما أُخبِرتُ مِن أَحَدٍ","أَنَّ الهَوى بِنَقا يَبرينَ مُعتادي",24,"ي",1,0],["لَقَد عَلِمَ الأَقوامُ أَنَّ مُجاشِعاً","إِذا عُرِفَت بِالخِزيِ قَلَّ نَكيرُها",25,"ر",3,0],["لَقَد عَلِمَت غَيرَ الفِياشِ مُجاشِعٌ","إِلى مَن تَصيرُ الخافِقاتُ اللَوامِعُ",26,"ع",1,0],["لَقَد عَلِموا أَنَّ الكَتيبَةَ كَبشُها","بِحَجرٍ إِذا لاقى الكَمِيُّ اِبنُ مالِكِ",27,"ك",1,1],["لَقَد عَلِمَ الفَرَزدَقُ أَنَّ تَيماً","عَلى شِربٍ إِذا نَهِلوا وَبيلِ",28,"ل",1,0],["لَقَد عَلِمَ البَرِيَّةُ مِن قُرَيشٍ","وَمِن قَيسٍ مَضارِبَهُ الكِراما",29,"م",2,0],["لَقَد عَلِقَت بِالنَفسِ مِنها عَلائِقٌ","أَبَت طولَ هَذا الدَهرِ أَن تَتَصَرَّما",30,"م",2,0],["لَقَد عَلِمَت سُراةُ الحَيِّ أَنّا","لَنا الجَبَلُ المُمَنَّعُ جانِباهُ",31,"ه",1,1],["لَقَد عَلِمَت قَيسُ اِبنُ عَيلانَ أَنَّنا","بِنا يُدرَكُ الثَأرُ الَّذي قَلَّ طالِبُه",32,"ب",2,1],["لَقَد عَلِمَت قُرَيشٌ يَومَ بَدرٍ","غَداةَ الأَسرِ وَالقَتلِ الشَديدِ",33,"د",1,1],["لَقَد عَلِمتُ بِأَنّي غالِبي خُلُقي","عَلى السَماحَةِ صُعلوكاً وَذا مالِ",34,"ل",1,0],["لَقَد عَلِمَت بَنو النَجّارِ أَنّي","أَذودُ عَنِ العَشيرَةِ بِالحُسامِ",35,"م",1,1],["لَقَد عَلِمَ الأَقوامُ أَنَّ اِبنَ هاشِمٍ","هُوَ الغُصنُ ذو الأَفنانِ لا الواحِدُ الوَغدُ",36,"د",1,1],["لَقَد عَظُمَت فينا الرَزِيَّةُ إِنَّنا","جِلادٌ عَلى رَيبِ الحَوادِثِ وَالدَهرِ",37,"ر",1,1],["لقد عذُبت ألفاظها وصفاتها","على أنَّ قلبي في هواها معذَّب",38,"ب",1,0],["لقد عبثت لواحظه بعقلي","فيا ويل الصحيح من الكسير",39,"ر",1,0],["لقد عشت نور الدين في أفق العلى","وفي العلم والفضل البهي شهيرا",40,"ر",2,0],["لقد عمَّنا ما خصَّه من رزيةٍ","بأمثالها تدمي الجفون وتدمع",41,"ع",1,0],["لقد عرفناك أياماً وداومنا","شجو فيا ليت أنَّا ما عرفناك",42,"ك",1,0],["لقد عرفتُ تجنّيها كما عرفت","يدُ الجواد ابن قطب الدين بالكرم",43,"م",1,1],["لقد عذُبت موارده ولكن","ندى المنصور أحلى الموردين",44,"ن",1,0],["لقد عدناكُم لمَّا ضعفتم","ولا والله ما وافيتمونا",45,"ن",2,1],["لقد عَمَهُوا ما أنزل الله فيكُمُ","كأنّ كتاب الله فيهم مُمَجْمَجُ",46,"ج",1,0],["لقد علم الدهر أن الشبا","ب ثوب لدى الناس لا كالخرق",47,"ق",1,0],["لَقَد عَلِمَت تِلكَ القَبائِلُ أَنَّنا","مَصاليتُ جَذّامونَ آخِيَّةَ الشَغبِ",48,"ب",1,0],["لَقَد عَلِمتُم وَإِن أَصبَحتُ نائِيَكُم","نُصحي قَديماً وَفِعلي غَيرُ مُتَّهَمِ",49,"م",1,0],["لَقَد عَجَموا مِنّي قَناةً صَليبَةً","إِذا ضَجَّ خَوّارُ القَنا وَسَؤومُها",50,"م",3,0],["لَقَد عَثَرَت بَكرُ بنُ وائِلَ عَثرَةً","فَإِن عَثَرَت أُخرى فَلِلأَنفِ وَالفَمِ",51,"م",1,1],["لَقَد عَلِموا ما يَعصُرٌ بِأَبيهِم","وَلَكِنَّهُ جارٌ لَهُم وَعَديدُ",52,"د",1,0],["لَقَد عَلِقَتكَ أَسبابُ المَنايا","وَفِيّاً لا يُخانُ وَلا يَخونُ",53,"ن",1,0],["لَقَد عَدِمَ الغَبراءُ فيها وَداحِسٌ","وَلَم يَعدِمِ الأَعداءُ عَبسٌ وَذُبيانُ",54,"ن",1,0],["لَقَد عاجَلَنا الصَيفُ","بِحَرٍّ مِنهُ مَحفوزِ",55,"ز",1,1],["لقد عاث في الحملان قبلا رعاتها","ويا رب راع كان شراً من الذئب",56,"ب",1,0],["لقد عثرنا لدى التأويب من شلل","فينا وادلج اقوام فما عثروا",57,"ر",3,0],["لقد علمت ليلى بان صبابتي","كما يبتغى الايمان ليس بذي مين",58,"ن",1,0],["لقد عاب اقوام على تبرمي","واي امرء يشقى ولا يتبرم",59,"م",1,0],["لقد عقدت حملانه باختيارها","مع الذئب عهدا واستنامت الى العهد",60,"د",1,0],["لقد عاش الأمير بنا قويا","وعشنا تحت رايته كراما",61,"م",2,0],["لَقَد عَيِيتُ بِالطَوى المُبَرِّحِ","وَمُنذُ لَيلَتَينِ لَم أسَبِّحِ",62,"ح",1,0],["لَقَد عَلَّمَ بِالحَقِّ","وَبِالصَبرِ وَبِالقَصدِ",63,"د",1,0],["لَقَد عَبَثَت بِالنِياقِ الحُداةُ","وَنامَ عَنِ الإِبلِ رُعيانُها",64,"ن",3,0],["لَقَد عَلَّمتُ نَفسي القَولَ فيهِم","كَتَعليمِ الطَرادِ بِلا سِنانِ",65,"ن",1,0],["لَقَد عوتِبتُ في الحَسَنِ بنِ عَمرٍو","وَذاتِ الطَبلِ لَو نَفَعَ العِتابُ",66,"ب",1,0],["لَقَد عَلِقَت مِنهُ آمالُنا","بِحَبلِ غَريبِ النَدى فَردِهِ",67,"د",2,0],["لَقَد عَلِمَت قَحطانُ أَنّا سَراتُها","وَأَشرافُها الساداتُ في البَدوِ وَالحَضرِ",68,"ر",1,0],["لَقَد عَلِمَت عيدِيَّةُ العيسِ أَنَّني","أَخُبُّ إِذا نامَ الهِدانُ وَأُعنِقُ",69,"ق",1,0],["لَقَد عَجَلَتني نَظرَتي بِهَواكا","كَأَن لَم تَكُن عَيني تُريدُ سِواكا",70,"ك",2,1],["لَقَد عَلِقَت بِالعَبدِ زَيداً وَريحِهِ","حَماليقُ عَينَيها قَذىً غَيرُ بارِحِ",71,"ح",1,0],["لَقَد عَضَّت لِئامُ بَني فُقَيمٍ","عَلَيَّ أَنامِلَ الضَغنِ الحَسودِ",72,"د",1,1],["لَقَد عَلِمَ الأَحياءُ في كُلِّ مَوطِنٍ","بِأَنَّ تَميماً لَيسَ يُغمَزُ عودُها",73,"د",3,1],["لَقَد عَلِمَت يَومَ القُبَيباتِ نَهشَلٌ","وَحُردانُها أَن قَد مُنوا بِعَسيرِ",74,"ر",1,1],["لَقَد عَجِبتُ مِنَ الأَزدِيَّ جاءَ بِهِ","يَقودُهُ لِلمَنايا حَينُ مَغرورِ",75,"ر",1,0],["لَقَد عَلِمتُ وَعِلمُ المَرءُ أَصدَقُهُ","مَن عِندَهُ بِالَّذي قَد قالَهُ الخَبَرُ",76,"ر",1,1],["لَقَد عَلِمَت عَيلانُ أَنَّ الَّذي رَسَت","لَئيمٌ وَأَنَّ العيرَ قَد فُلَّ حافِرُه",77,"ر",2,0],["لَقَد عَلِمَ الأَقوامُ أَنَّ مُحَمَّداً","جَسورٌ إِذا ما أَورَدَ الأَمرَ أَصدَرا",78,"ر",2,1],["لَقَد عَلِمَ الأَحياءُ بِالغَورِ أَنَّكُم","إِذا هَبَّتِ النَكباءُ أَكثَرُهُم فَضلا",79,"ل",2,1],["لَقَد عَلِمَ الأَحياءُ في كُلِّ مَوطِنٍ","إِذا عُدَّتِ الأَحياءُ أَنّا كِرامُها",80,"م",3,0],["لَقَد عَلِمَت سُكَينَةُ أَنَّ قَلبي","عَلى الأَحداثِ مُجتَمِعُ الجَنانِ",81,"ن",1,1],["لَقَد عَلِمَ الفُسّاقُ يَومَ لَقيتَهُم","يَزيدُ وَحَوّاكُ البُرودِ اليَمانِيا",82,"ي",2,0],["لقد عَلِمَتْ صُروفُ الدَّهْرِ ما اسمي","بعَتْبِكَ واطَّلَعْنَ على مَكاني",83,"ي",1,0],["لَقَد عَلِمتُ وَإِن قَصَّرتُ في عَمَلي","أَنَّ اِبنَ آدَمَ لا يَخلو مِنَ الحُجَجِ",84,"ج",1,0],["لَقَد عَرَفناكِ يا دُنيا بِمَعرِفَةٍ","صَحَّت لَنا فَاِنقُصي إِن شِئتِ أَو زيدي",85,"ي",1,0],["لَقَد عَزَّ فينا بَعدَ وُجدانِكَ الغِنى","كَما ذَلَّ فينا قَبلَ فِقدانِكَ الفَقرُ",86,"ر",1,0],["لَقَد عَجِزوا عَن أَن يَرَوا لَكَ في النَدى","مَدى الدَهرِ أَو عَنهُ مِنَ الناسِ ثانِيا",87,"ي",2,0],["لقد عَدِمَ المُعَمّى منه فكّاً","ومات لِمَوتِهِ عِلْمُ العَروضِ",88,"ض",1,0],["لَقَد عَمَّت فُضولُكُمُ وَخَصَّت","ذَوي يَمَنٍ كَما سَلَبَت نِزارا",89,"ر",2,0],["لَقَد عَلَّقوها بِالنَبِيِّ خُصومَةً","إِلى اللَهِ تُغني عَن يَمينٍ وَشاهِدِ",90,"د",1,0],["لقد عاشَ دهراً يخدمُ العلمَ جهدَهُ","وكانَ قليلَ المثلٍِ في العلمِ والودِ",91,"د",1,1],["لقد عدم الإسلامُ حِبراً مبرِّزاً","كريمَ السجايا فيه معْ بعده قرْبُ",92,"ب",1,1],["لقد عجَّلَ المحبوبُ نَبْتَ عذارِهِ","فزادَ به حُسناً فعيلَ بهِ الصبرُ",93,"ر",1,1],["لقدْ علمتْ نساءُ الحيِّ أني","أُسِرُّ قرينتي وأسوءُ قرني",94,"ي",1,1],["لَقَد عَرَضَت لي بِالمُحَصَّبِ مِن مِنىً","مَعَ الحَجِّ شَمسٌ سُتِّرَت بِيَمانِ",95,"ن",1,1],["لَقَد عُلِّقتُ مِن عُمَرٍ","حِبالاً مِثلَها عَلِقَ",96,"ق",1,0],["لَقَد عُجتُ في رَسمٍ أَجَدَّ زَمانُهُ","لَنا دارِسٍ ما كانَ غَيرُ التَواقُفِ",97,"ف",1,1],["لَقَد عَرَفَت قَدرَهُ دَولَةٌ","تُفَدّي بِهِ الأَكرَمَ الأَنجَبا",98,"ب",2,0],["لَقَد عيلَ صَبري مِن غَرامي وَوِحدَتي","وَعُظمِ اِشتِياقي هائِمٌ وَوَحيدُ",99,"د",1,0],["لَقَد عِشتُ مِن لَيلى زَماناً أُحِبُّها","أَرى المَوتَ مِنها في مَجيئي وَمَذهَبي",100,"ب",2,0],["لَقَد عِشتُ مِن لَيلى زَماناً أُحِبُّها","أَخا المَوتَ إِذ بَعضُ المُحِبّينَ يَكذُبُ",101,"ب",1,0],["لَقَد عاشَ رَغماً لِلحَواسِدِ وَالعِدا","وَماتَ عَلى أَنفِ النَدى وَالهُدى رَغما",102,"م",2,0],["لَقَد عَلِمَ المُعَذَّلُ يَومَ يَدعو","بِذِئبَةَ يَومَ ذِئبَةَ إِذ دَعانا",103,"ن",2,1],["لَقَد عَمَرَ 