{"poems":[[53,"لو رأيت الغرام يبلغ عذرا","https://www.aldiwan.net/poem30442.html","الخفيف"],[53,"لن تشقوا لذا الجواد غبارا","https://www.aldiwan.net/poem30482.html","الخفيف"],[53,"مرضت بعدكم صدور الصعاد","https://www.aldiwan.net/poem30618.html","الخفيف"],[53,"أغار على ثراك من الرياح","https://www.aldiwan.net/poem30656.html","الوافر"],[63,"سرى طيفها والليل رق ظلامه","https://www.aldiwan.net/poem46155.html","الطويل"],[86,"نعاك النعاة وحم القدر","https://www.aldiwan.net/poem10471.html","المتقارب"],[0,"لمن طلل بين الجدية والجبل","https://www.aldiwan.net/poem84.html","الطويل"],[93,"هل بعالي الذرى مكان اعتصام","https://www.aldiwan.net/poem11308.html","الخفيف"],[93,"أيها البالغ الثريا مقاماً","https://www.aldiwan.net/poem11412.html","الخفيف"],[88,"تريد لي الأيام أن أتقيد","https://www.aldiwan.net/poem45016.html","الطويل"],[88,"أي خطب دها ربوع الشام","https://www.aldiwan.net/poem45055.html","الخفيف"],[72,"بلغا القاصدين أن الليالي","https://www.aldiwan.net/poem19529.html","الخفيف"],[51,"صرحت عن طوية الأصدقاء","https://www.aldiwan.net/poem7996.html","الخفيف"],[51,"أرضى بصورته وصد فأغضبا","https://www.aldiwan.net/poem8652.html","الكامل"],[51,"حتى متى يوري سواي وأقتدح","https://www.aldiwan.net/poem9423.html","الكامل"],[51,"ذاد عن مقلتي لذيذ المنام","https://www.aldiwan.net/poem66325.html","الخفيف"],[91,"أي خطب دها فبات المهجر","https://www.aldiwan.net/poem8965.html","عموديه"],[91,"أباعثة المطايا من حديد","https://www.aldiwan.net/poem62788.html","عموديه"],[70,"ركد الرجاء فما يهزك مأرب","https://www.aldiwan.net/poem43107.html","الكامل"],[92,"ههنا في خمائل الغاب تحت الزا","https://www.aldiwan.net/poem38901.html","المديد"],[89,"إن فعل الرجال غير الكلام","https://www.aldiwan.net/poem44616.html","الخفيف"],[89,"عاث هذا المنون يسرف فينا","https://www.aldiwan.net/poem44774.html","الخفيف"],[45,"ليس الزمان بمعتب فذريني","https://www.aldiwan.net/poem66683.html","الكامل"],[61,"يغض الطرف عن ورد الخدود","https://www.aldiwan.net/poem51717.html","الوافر"],[97,"نداؤك يا فؤاد كفى نداء","https://www.aldiwan.net/poem25073.html","الوافر"],[80,"أي خطب عن قوسه الموت يرمي","https://www.aldiwan.net/poem31283.html","الخفيف"],[80,"ما الذي أعددت للموت فقد","https://www.aldiwan.net/poem31350.html","الرمل"],[44,"معتدل لم يعتدل عدله","https://www.aldiwan.net/poem30127.html","السريع"],[69,"قصد البرنس مكيدة عظمت","https://www.aldiwan.net/poem28044.html","أحذ الكامل"],[69,"بفتح الدين شرفنا","https://www.aldiwan.net/poem29115.html","الهزج"],[31,"دعاني إلى أسماء عن غير موعد","https://www.aldiwan.net/poem41812.html","الطويل"],[31,"وقالت لتربيها غداة لقيتها","https://www.aldiwan.net/poem42250.html","الطويل"],[105,"أعجزنا أن نجوب المشرقين","https://www.aldiwan.net/poem42090.html","الرمل"],[105,"أمنك الذكر يعصف بالقلوب","https://www.aldiwan.net/poem42121.html","الوافر"],[105,"دعونا نبتدر ورد الحمام","https://www.aldiwan.net/poem43419.html","الوافر"],[102,"قدر ساقه فآواه روضا","https://www.aldiwan.net/poem32977.html","الخفيف"],[50,"طال ليلي وبات قلبي جناحا","https://www.aldiwan.net/poem63974.html","الخفيف"],[46,"قفي وقفة تعلمي","https://www.aldiwan.net/poem23423.html","مجزوء المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55048","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54758","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54674","الخفيف"],[70,"","https://poetry.dctabudhabi.ae/diwan/poem/5786","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142024","المتقارب"],[106,"عرش هوى","https://www.poetsgate.com/ViewPoem.aspx?id=179587",""],[98,"كفانيَ يا قلبُ","https://www.poetsgate.com/ViewPoem.aspx?id=55326",""]],"verses":[["أَيُّ خَطبٍ راخى قِواكَ وَقَد كُن","تَ جَديلاً عَلى الخُطوبِ مُمَرّا",0,"ر",2,0],["أَيَخافُ الخُطوبَ مَن كانَ لِلَّي","ثِ نَزيلاً وَكانَ لِلنَجمِ جارا",1,"ر",2,0],["أَيُّ خَطبٍ أَرخى ذُؤابَةَ لَيلٍ","لَم أَجُبهُ مِن عَزمَتي بِزِنادِ",2,"د",1,0],["أَيَخفى لُؤمُ أَصلِكُمُ وَهَذي","قُروفُكُمُ تَنُمُّ عَلى الجِراحِ",3,"ح",1,0],["أيَخْشى العِدا والدّهْرُ قُوِّمَ دَرْؤُهُ","بعُثْمانَ مَرْمِيّاً إليهِ زِمامُهُ",4,"م",2,0],["أَيَخفِقُ تَحتَ الدُجى وَحدَهُ","لِذِكرى أَليفٍ سَلا أَو هَجَر",5,"ر",1,0],["أَيخفَى لَنَا إِن كانَ في اللَّيلِ دفنُهُ","فَقُلنَ وهَل يَخفَى الهِلَالُ إِذَا أَفَل",6,"ل",1,0],["أَيُّ خَطْبٍ أَصَابَ أَوْحَدَ قَوْمٍ","فأَشَاعَ الأَحْزَانِ فِي أَقْوَامِ",7,"م",1,0],["أَيُّ خَيْرِ الفُتُوحِ مَا لَمْ تَعَبِّيءْ","فِيهِ جَيْشاً وَلَمْ تُجَرِّدُ حُسَامَا",8,"م",2,0],["أيُخلقنا كرّ الجديدَيْن ضِلّةً","ولم نتقمّص فيهما ما تِجدّدا",9,"د",2,0],["أيّ خطب دها ربوع الشام","يوم أمست تبكي بطرف دام",10,"م",1,1],["أي خلق من المنية يحمى","وهي تسري إليه مسرى الخيال",11,"ل",1,0],["أيُّ خلٍّ تراه كالذهب الأح","مر أو كالوذِيلة الزهراءِ",12,"ا",2,0],["أيخافُ عَيْنَيْ من قُتلْتُ بحبِّهِ","قَلَبَ الحديثَ كما اشتهى أن يُقْلَبَا",13,"ب",2,0],["أيَخِيبُ تَأمِيلِكُمُ وَقَرينُهُ","شَفَقِي عليكم والقوَارعُ تَنْتَطِحْ",14,"ح",1,0],["أيُّ خَطْبٍ وأيُّ رُزْء جليلٍ","نالنا في أولئكَ الأعمام",15,"م",1,0],["أَيُّ خَطبٍ دَها فَباتَ المَهجَر","مِثلَ حَقلٍ مَرَّت عَلَيهِ صَرصَر",16,"ر",1,1],["أَيَخذِلُ جارَةَ الوادي بَنوها","مَعاذَ اللَهِ هَذا لَن يَكونا",17,"ن",2,0],["أَيَخونُ عَهدَكَ غادِرٌ فَيَضُمُّهُ","ما بَينَ جانِحَتَيكَ وادٍ مُخصِبُ",18,"ب",1,0],["أَيُّ خمرٍ مُؤَجَّجٍ ولهيبٍ","مُسكرٍ أَيُّ نشوَةٍ وجنونِ",19,"ن",1,0],["أَيُّ خمرٍ رشفتُ بل أَيُّ نارٍ","في شفاهٍ بديعَةِ التَّكوينِ",19,"ن",1,0],["أي خير من الحياة لشعب","ما له من نقض ومن إبرام",20,"م",1,0],["أي خير للناس في نظر لم","يك بالفعل صدقه مقرونا",21,"ن",2,0],["أَيَخونُ في سِرِّ الصَديقِ لِسانُ ذي","كَرَمٍ عَلى سِرِّ العَدُوِّ أَمينِ",22,"ن",1,0],["أيخشى الخطب ذو قلب حداد","وخطب في غياهبه حديد",23,"د",1,0],["أيخيفني العشب الضعيف أنا الذي","أسلمت للشوك الممض أديمي",24,"ي",1,0],["أيّ خطْبٍ عن قوْسهِ الموْتُ يرْمي","وسهامٌ تصيبُ منه فتُصْمي",25,"ي",1,1],["أَيّ خَطْبٍ فادحٍ في رَقدةٍ","يُوقِظُ الحشرُ إِلَيها مُقلتيك",26,"ك",1,0],["أَيُّ خِصالٍ حازَها سَيِّدي","لَو لَم يُكَدِّر صَفوَها مَطلُهُ",27,"ل",2,0],["أيخافُ خيرُ الخلقِ مِنْ أحد","واللهُ يعصمُهُ منَ الناسِ",28,"س",1,0],["أيخشى القفلُ منْ لصٍّ","أليسَ الفتحُ في القفلِ",29,"ل",1,0],["أَيَخفى لَنا وَلِلمُغيريِّ مَجلِسٌ","فَإِنَّ النَوى كانَت قَليلاً لِمامُها",30,"م",3,0],["أَيَخفى عَلى ظَهرٍ وُقوفُ مَطِيَّةٍ","بِراكِبِها هَذا مِنَ الأَمرِ أَشنَعُ",31,"ع",1,0],["أيُّ خطبٍ لم يُخَفِّفْ هولَه","مصرعُ الفاروقِ أو خطبُ الحُسَيْنْ",32,"ن",1,0],["أَيُخذَلُ في الكنانةِ كلُّ حُرٍّ","ويُنصرُ كلُّ صَخَّابٍ شَغوبِ",33,"ب",1,0],["أَيخذِلُنا وَنحنُ لَهُ نُصلِّي","جَميعاً مِن قُعودٍ أَو قِيامِ",34,"م",1,0],["أَيّ خَطبٍ أَصابَكُم معشرَ الطَي","ر وَماذا في الرَوض مِن أَسرارِ",35,"ر",1,0],["أَيُّ خَيرٍ يا عَونُ يَرجو مُحِبُّ","في سَوادِ الفُؤادِ مِنهُ بَراحا",36,"ح",2,0],["أَيَخلُصُ هَذا الوَرى","مِنَ الحِندِسِ المُظلِمِ",37,"م",1,0],["أَيَخَافُهَا وَهْوَ المُرَاغِمُ لِلرَّدَى","حَتى يُوَافِيَهُ بِحِيلَةِ سَارِقِ",38,"ق",1,0],["أَيُّ خَطْبٍ دَهَى الْفَضَائِلَ فِي النَّدْ","بِ المُوَالِي وَفِي الْهُمَامِ الْجَوَاد",39,"د",1,0],["أَيَّ خَلْقٍ نَرَى بِشَكْلٍ جَدِيدِ","بِنْتَ شَمْسٍ أَمْ قَدْ بَدَتْ لِلْعَبِيدِ",40,"د",1,0],["أَيَخافُ قَلبي غَدرَكُم مَعَ أَنَّهُ","جارٌ أَقامَ لَدَيكُمُ وَنَزيلُ",41,"ل",1,0],["أيخاف الباز شر الحجل","ذكر السين عهوداً للتي",42,"ي",1,0],["أيخلق منك جديد الهوى","فؤاد من السكر لا يعقل",43,"ل",1,0],["أيَخْشَى الفقرَ ذو عرشٍ وتاجٍ","تَدِينُ له الروابي والبطاحُ؟",44,"ح",1,0],["أيُخلَقُ منك جديدُ الهوى","فؤاداً من السُّكر لا يَعقلُ",45,"ل",1,0]]}