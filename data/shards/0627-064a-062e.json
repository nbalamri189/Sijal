aspx?id=35208",""],[6052,"الطيف النزيل بمقلتي","https://www.poetsgate.com/ViewPoem.aspx?id=50261",""],[6093,"نسخة معدلة","https://www.poetsgate.com/ViewPoem.aspx?id=193066",""],[6102,"سِباقُ الواوِيات ..","https://www.poetsgate.com/ViewPoem.aspx?id=184411",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""]],"verses":[["أَيُّ خَطبٍ راخى قِواكَ وَقَد كُن","تَ جَديلاً عَلى الخُطوبِ مُمَرّا",0,"ر",2,0],["أَيَخافُ الخُطوبَ مَن كانَ لِلَّي","ثِ نَزيلاً وَكانَ لِلنَجمِ جارا",1,"ر",2,0],["أَيُّ خَطبٍ أَرخى ذُؤابَةَ لَيلٍ","لَم أَجُبهُ مِن عَزمَتي بِزِنادِ",2,"د",1,0],["أَيَخفى لُؤمُ أَصلِكُمُ وَهَذي","قُروفُكُمُ تَنُمُّ عَلى الجِراحِ",3,"ح",1,0],["أيَخْشى العِدا والدّهْرُ قُوِّمَ دَرْؤُهُ","بعُثْمانَ مَرْمِيّاً إليهِ زِمامُهُ",4,"م",2,0],["أَيَخفِقُ تَحتَ الدُجى وَحدَهُ","لِذِكرى أَليفٍ سَلا أَو هَجَر",5,"ر",1,0],["أَيخفَى لَنَا إِن كانَ في اللَّيلِ دفنُهُ","فَقُلنَ وهَل يَخفَى الهِلَالُ إِذَا أَفَل",6,"ل",1,0],["أَيُّ خَطْبٍ أَصَابَ أَوْحَدَ قَوْمٍ","فأَشَاعَ الأَحْزَانِ فِي أَقْوَامِ",7,"م",1,0],["أَيُّ خَيْرِ الفُتُوحِ مَا لَمْ تَعَبِّيءْ","فِيهِ جَيْشاً وَلَمْ تُجَرِّدُ حُسَامَا",8,"م",2,0],["أيُخلقنا كرّ الجديدَيْن ضِلّةً","ولم نتقمّص فيهما ما تِجدّدا",9,"د",2,0],["أيّ خطب دها ربوع الشام","يوم أمست تبكي بطرف دام",10,"م",1,1],["أي خلق من المنية يحمى","وهي تسري إليه مسرى الخيال",11,"ل",1,0],["أيُّ خلٍّ تراه كالذهب الأح","مر أو كالوذِيلة الزهراءِ",12,"ا",2,0],["أيخافُ عَيْنَيْ من قُتلْتُ بحبِّهِ","قَلَبَ الحديثَ كما اشتهى أن يُقْلَبَا",13,"ب",2,0],["أيَخِيبُ تَأمِيلِكُمُ وَقَرينُهُ","شَفَقِي عليكم والقوَارعُ تَنْتَطِحْ",14,"ح",1,0],["أيُّ خَطْبٍ وأيُّ رُزْء جليلٍ","نالنا في أولئكَ الأعمام",15,"م",1,0],["أَيُّ خَطبٍ دَها فَباتَ المَهجَر","مِثلَ حَقلٍ مَرَّت عَلَيهِ صَرصَر",16,"ر",1,1],["أَيَخذِلُ جارَةَ الوادي بَنوها","مَعاذَ اللَهِ هَذا لَن يَكونا",17,"ن",2,0],["أَيَخونُ عَهدَكَ غادِرٌ فَيَضُمُّهُ","ما بَينَ جانِحَتَيكَ وادٍ مُخصِبُ",18,"ب",1,0],["أَيُّ خمرٍ مُؤَجَّجٍ ولهيبٍ","مُسكرٍ أَيُّ نشوَةٍ وجنونِ",19,"ن",1,0],["أَيُّ خمرٍ رشفتُ بل أَيُّ نارٍ","في شفاهٍ بديعَةِ التَّكوينِ",19,"ن",1,0],["أي خير من الحياة لشعب","ما له من نقض ومن إبرام",20,"م",1,0],["أي خير للناس في نظر لم","يك بالفعل صدقه مقرونا",21,"ن",2,0],["أَيَخونُ في سِرِّ الصَديقِ لِسانُ ذي","كَرَمٍ عَلى سِرِّ العَدُوِّ أَمينِ",22,"ن",1,0],["أيخشى الخطب ذو قلب حداد","وخطب في غياهبه حديد",23,"د",1,0],["أيخيفني العشب الضعيف أنا الذي","أسلمت للشوك الممض أديمي",24,"ي",1,0],["أيّ خطْبٍ عن قوْسهِ الموْتُ يرْمي","وسهامٌ تصيبُ منه فتُصْمي",25,"م",2,1],["أَيّ خَطْبٍ فادحٍ في رَقدةٍ","يُوقِظُ الحشرُ إِلَيها مُقلتيك",26,"ك",1,0],["أَيُّ خِصالٍ حازَها سَيِّدي","لَو لَم يُكَدِّر صَفوَها مَطلُهُ",27,"ل",2,0],["أيخافُ خيرُ الخلقِ مِنْ أحد","واللهُ يعصمُهُ منَ الناسِ",28,"س",1,0],["أيخشى القفلُ منْ لصٍّ","أليسَ الفتحُ في القفلِ",29,"ل",1,0],["أَيَخفى لَنا وَلِلمُغيريِّ مَجلِسٌ","فَإِنَّ النَوى كانَت قَليلاً لِمامُها",30,"م",3,0],["أَيَخفى عَلى ظَهرٍ وُقوفُ مَطِيَّةٍ","بِراكِبِها هَذا مِنَ الأَمرِ أَشنَعُ",31,"ع",1,0],["أيُّ خطبٍ لم يُخَفِّفْ هولَه","مصرعُ الفاروقِ أو خطبُ الحُسَيْنْ",32,"ن",1,0],["أَيُخذَلُ في الكنانةِ كلُّ حُرٍّ","ويُنصرُ كلُّ صَخَّابٍ شَغوبِ",33,"ب",1,0],["أَيخذِلُنا وَنحنُ لَهُ نُصلِّي","جَميعاً مِن قُعودٍ أَو قِيامِ",34,"م",1,0],["أَيّ خَطبٍ أَصابَكُم معشرَ الطَي","ر وَماذا في الرَوض مِن أَسرارِ",35,"ر",1,0],["أَيُّ خَيرٍ يا عَونُ يَرجو مُحِبُّ","في سَوادِ الفُؤادِ مِنهُ بَراحا",36,"ح",2,0],["أَيَخلُصُ هَذا الوَرى","مِنَ الحِندِسِ المُظلِمِ",37,"م",1,0],["أَيَخَافُهَا وَهْوَ المُرَاغِمُ لِلرَّدَى","حَتى يُوَافِيَهُ بِحِيلَةِ سَارِقِ",38,"ق",1,0],["أَيُّ خَطْبٍ دَهَى الْفَضَائِلَ فِي النَّدْ","بِ المُوَالِي وَفِي الْهُمَامِ الْجَوَاد",39,"د",1,0],["أَيَّ خَلْقٍ نَرَى بِشَكْلٍ جَدِيدِ","بِنْتَ شَمْسٍ أَمْ قَدْ بَدَتْ لِلْعَبِيدِ",40,"د",1,0],["أَيَخافُ قَلبي غَدرَكُم مَعَ أَنَّهُ","جارٌ أَقامَ لَدَيكُمُ وَنَزيلُ",41,"ل",1,0],["أيخاف الباز شر الحجل","ذكر السين عهوداً للتي",42,"ي",1,0],["أيخلق منك جديد الهوى","فؤاد من السكر لا يعقل",43,"ل",1,0],["أيَخْشَى الفقرَ ذو عرشٍ وتاجٍ","تَدِينُ له الروابي والبطاحُ؟",44,"ح",1,0],["أيُخلَقُ منك جديدُ الهوى","فؤاداً من السُّكر لا يَعقلُ",45,"ل",1,0],["أيخذلني الشباب ضنى وسقما","أفول الشمس تغرب في ضحاها",46,"ا",3,0],["أيّ خطب في الكون أعظمُ مما","ترك الناس ذاهلينَ هيامى",47,"م",2,0],["أيخلق طفلا نفسه وهو نطفةٌ","وينشئها طوراً فطوراً فما تما",48,"م",2,0],["أيخوفونك بالذي يعصونه","ونطيعه يا مذهباً ما أسخفا",49,"ف",2,0],["أيخلع منكم ربقة الدين عاقل","لقول غريق في الضلالة جائر",50,"ر",1,0],["أيخطب لابن عروة وهو لصّ","مغيرٌ إن ذا خطب عظيم",51,"م",1,0],["أيخلف ميعادي الجمال وإنه","ليعرف أن الموت إن خان أسهل",52,"ل",1,0],["أَي خَليلَ البِلادِ وَفَّيتَ قِسطاً","من فُروضٍ عَلَيكَ لِلعَلياءِ",53,"ا",2,0],["أيّ خَلْقٍ يكون أنقصَ ممّن","ليس يدري لأيّ حال يصير",54,"ر",1,0],["أيَّ خَطْبٍ أرى وأيُّ ليالٍ","دهم الناس صَرفُها المحذورُ",55,"ر",1,0],["أيخمدُ فكرٌ ساطعٌ مثلَ نجمةٍ","بها النازحُ الرحّالُ في الغَيهَبِ اهتدى",56,"د",2,0],["أَيُخدعُ بِالآمالِ مرءٌ مصيرهُ","مَصيرُ الّذي قَد ضمّ ذا الترب والصفا",57,"ف",2,0],["أيّ خيرٍ لمؤمن في نعيم","صار منه عن ربّه في حجابِ",58,"ب",1,0],["أيّ خمر ملأت كأسي منها","أيّ كاس مجنوتةِ الصهباء",59,"ا",2,0],["أَيَخْرِقُ خَدَّهَا مِنّي خَيَالاً","كَلِيمَ القَلْبِ نَاظِرُهُ الذَّبِيحُ",60,"ح",1,0],["أَيَخسَرُ حاشاهُ مِنَ القَولِ قَولُهُم","كِرامٌ بِهِ اِستَكفَوا مِنَ الدَهرِ ما كُفوا",61,"ف",3,0],["أيُّ خلقٍ مستصعبٍ كلَّ سهلٍ","تحت عزمٍ مستسِهلٍ كلَّ صعبِ",62,"ب",1,0],["أَيَخاَفُ طُولَ المطْلِ مَنْ","أهْلُ الغَريّ لَهُ غَريمُ",63,"م",1,0],["أَيَخلف ظَنّي مِن أَبوه مُفرِجٌ","أَلا إِنَّ أَولادَ الجِيادِ جِيادُ",64,"د",1,0],["أيخادعون مخادعاً إحسانُه","عبثٌ وأسخفُ ما حكاه مهاتُر",65,"ر",1,0],["أيخشى ابن إبراهيمَ فَوت وِزارةٍ","وقد حازها سقفَ السماء وأبعدا",66,"د",2,0],["أيخمل قدري بعد طول نباهةٍ","وما الفضل عند الأكرمين بخامل",67,"ل",1,0],["أيُّ خلْصاءِ مُهجةٍ عشِقَتهُ","وبِسلسالِ خَمرهِ ما هامَتْ",68,"ت",1,0],["أيخفى صحيح الوجد والسقم لائح","ويكتم سر الشوق والدمع بائح",69,"ح",1,1],["أيخونُني اليومَ القريض وإنَّني","ربُّ القريضِ وفي القَوافي أحكُمُ",70,"م",1,0],["أَيَخُونُهُ الشِّعرُ الحبيبُ.. ومَنْ رَأَى","عَسَلاً تَوَرَّطَ في خيانةِ نَ