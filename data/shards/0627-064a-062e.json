{"poems":[[53,"لو رأيت الغرام يبلغ عذرا","https://www.aldiwan.net/poem30442.html","الخفيف"],[53,"لن تشقوا لذا الجواد غبارا","https://www.aldiwan.net/poem30482.html","الخفيف"],[53,"مرضت بعدكم صدور الصعاد","https://www.aldiwan.net/poem30618.html","الخفيف"],[53,"أغار على ثراك من الرياح","https://www.aldiwan.net/poem30656.html","الوافر"],[63,"سرى طيفها والليل رق ظلامه","https://www.aldiwan.net/poem46155.html","الطويل"],[86,"نعاك النعاة وحم القدر","https://www.aldiwan.net/poem10471.html","المتقارب"],[0,"لمن طلل بين الجدية والجبل","https://www.aldiwan.net/poem84.html","الطويل"],[93,"هل بعالي الذرى مكان اعتصام","https://www.aldiwan.net/poem11308.html","الخفيف"],[93,"أيها البالغ الثريا مقاماً","https://www.aldiwan.net/poem11412.html","الخفيف"],[88,"تريد لي الأيام أن أتقيد","https://www.aldiwan.net/poem45016.html","الطويل"],[88,"أي خطب دها ربوع الشام","https://www.aldiwan.net/poem45055.html","الخفيف"],[72,"بلغا القاصدين أن الليالي","https://www.aldiwan.net/poem19529.html","الخفيف"],[51,"صرحت عن طوية الأصدقاء","https://www.aldiwan.net/poem7996.html","الخفيف"],[51,"أرضى بصورته وصد فأغضبا","https://www.aldiwan.net/poem8652.html","الكامل"],[51,"حتى متى يوري سواي وأقتدح","https://www.aldiwan.net/poem9423.html","الكامل"],[51,"ذاد عن مقلتي لذيذ المنام","https://www.aldiwan.net/poem66325.html","الخفيف"],[91,"أي خطب دها فبات المهجر","https://www.aldiwan.net/poem8965.html","عموديه"],[91,"أباعثة المطايا من حديد","https://www.aldiwan.net/poem62788.html","عموديه"],[70,"ركد الرجاء فما يهزك مأرب","https://www.aldiwan.net/poem43107.html","الكامل"],[92,"ههنا في خمائل الغاب تحت الزا","https://www.aldiwan.net/poem38901.html","المديد"],[89,"إن فعل الرجال غير الكلام","https://www.aldiwan.net/poem44616.html","الخفيف"],[89,"عاث هذا المنون يسرف فينا","https://www.aldiwan.net/poem44774.html","الخفيف"],[45,"ليس الزمان بمعتب فذريني","https://www.aldiwan.net/poem66683.html","الكامل"],[61,"يغض الطرف عن ورد الخدود","https://www.aldiwan.net/poem51717.html","الوافر"],[97,"نداؤك يا فؤاد كفى نداء","https://www.aldiwan.net/poem25073.html","الوافر"],[80,"أي خطب عن قوسه الموت يرمي","https://www.aldiwan.net/poem31283.html","الخفيف"],[80,"ما الذي أعددت للموت فقد","https://www.aldiwan.net/poem31350.html","الرمل"],[44,"معتدل لم يعتدل عدله","https://www.aldiwan.net/poem30127.html","السريع"],[69,"قصد البرنس مكيدة عظمت","https://www.aldiwan.net/poem28044.html","أحذ الكامل"],[69,"بفتح الدين شرفنا","https://www.aldiwan.net/poem29115.html","الهزج"],[31,"دعاني إلى أسماء عن غير موعد","https://www.aldiwan.net/poem41812.html","الطويل"],[31,"وقالت لتربيها غداة لقيتها","https://www.aldiwan.net/poem42250.html","الطويل"],[105,"أعجزنا أن نجوب المشرقين","https://www.aldiwan.net/poem42090.html","الرمل"],[105,"أمنك الذكر يعصف بالقلوب","https://www.aldiwan.net/poem42121.html","الوافر"],[105,"دعونا نبتدر ورد الحمام","https://www.aldiwan.net/poem43419.html","الوافر"],[102,"قدر ساقه فآواه روضا","https://www.aldiwan.net/poem32977.html","الخفيف"],[50,"طال ليلي وبات قلبي جناحا","https://www.aldiwan.net/poem63974.html","الخفيف"],[46,"قفي وقفة تعلمي","https://www.aldiwan.net/poem23423.html","مجزوء المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55048","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54758","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54674","الخفيف"],[70,"","https://poetry.dctabudhabi.ae/diwan/poem/5786","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142066","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142024","المتقارب"],[106,"عرش هوى","https://www.poetsgate.com/ViewPoem.aspx?id=179587",""],[98,"كفانيَ يا قلبُ","https://www.poetsgate.com/ViewPoem.aspx?id=55326",""],[133,"أرسلي الدمع يا عيوني انسجاما","https://www.aldiwan.net/poem49159.html","الخفيف"],[158,"تعاليت يا من لا نحيط به علما","https://www.aldiwan.net/poem58686.html","الطويل"],[158,"لك خارقات عوائد لن تعرفا","https://www.aldiwan.net/poem58902.html","الكامل"],[158,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[184,"وما زالت بنو شيبان تبغي","https://www.aldiwan.net/poem43250.html","الوافر"],[209,"صورة ما أراه أم ذاك حلم","https://www.aldiwan.net/poem46762.html","الخفيف"],[221,"إيه برناس هيكل الشعراء","https://www.aldiwan.net/poem41899.html","الخفيف"],[227,"زمن منقض وعمر قصير","https://www.aldiwan.net/poem51102.html","الخفيف"],[227,"كل حي إلى الفناء يصير","https://www.aldiwan.net/poem51107.html","الخفيف"],[268,"بكت لفتى يفني قواه تعمدا","https://www.aldiwan.net/poem35632.html","الطويل"],[303,"أفق أيها المغرور بالعيش قد صفا","https://www.aldiwan.net/poem56465.html","الطويل"],[303,"عظم الأجر عن عظيم المصاب","https://www.aldiwan.net/poem56609.html","الكامل"],[326,"بين يأسي وحيرتي ورجائي","https://www.aldiwan.net/poem54993.html","الخفيف"],[346,"وميض البرق أم ثغر يلوح","https://www.aldiwan.net/poem19945.html","الوافر"],[364,"أعند صروف الدهر يصرف وجهه","https://www.aldiwan.net/poem17321.html","الطويل"],[369,"لحن حتى أمرن طرفا بقلبي","https://www.aldiwan.net/poem57526.html","الكامل"],[399,"حتام عن جهل تلوم","https://www.aldiwan.net/poem46981.html","مجزوء الكامل"],[403,"ألمت بنا بعد الهدو سعاد","https://www.aldiwan.net/poem50185.html","الطويل"],[451,"قالوا تصبر قد يتوب الغادر","https://www.aldiwan.net/poem61766.html","الكامل"],[456,"إذا صاح وفد السحب بالريح أوحدا","https://www.aldiwan.net/poem56243.html","الطويل"],[462,"أما وبنات الفكر حلفة فاضل","https://www.aldiwan.net/poem3336.html","عموديه"],[498,"أي عين رأت حبيبي ونامت","https://www.aldiwan.net/poem38057.html","الخفيف"],[513,"أيخفى صحيح الوجد والسقم لائح","https://www.aldiwan.net/poem12052.html","الطويل"],[536,"قد رمت وصفك وهو شيء يلزم","https://www.aldiwan.net/poem47954.html","عموديه"],[549,"شد غروض المطي مغتربا","https://www.aldiwan.net/poem48085.html","المنسرح"],[573,"لا وأرض القلوب ذات الصدع","https://www.aldiwan.net/poem3052.html","الخفيف"]],"verses":[["أَيُّ خَطبٍ راخى قِواكَ وَقَد كُن","تَ جَديلاً عَلى الخُطوبِ مُمَرّا",0,"ر",2,0],["أَيَخافُ الخُطوبَ مَن كانَ لِلَّي","ثِ نَزيلاً وَكانَ لِلنَجمِ جارا",1,"ر",2,0],["أَيُّ خَطبٍ أَرخى ذُؤابَةَ لَيلٍ","لَم أَجُبهُ مِن عَزمَتي بِزِنادِ",2,"د",1,0],["أَيَخفى لُؤمُ أَصلِكُمُ وَهَذي","قُروفُكُمُ تَنُمُّ عَلى الجِراحِ",3,"ح",1,0],["أيَخْشى العِدا والدّهْرُ قُوِّمَ دَرْؤُهُ","بعُثْمانَ مَرْمِيّاً إليهِ زِمامُهُ",4,"م",2,0],["أَيَخفِقُ تَحتَ الدُجى وَحدَهُ","لِذِكرى أَليفٍ سَلا أَو هَجَر",5,"ر",1,0],["أَيخفَى لَنَا إِن كانَ في اللَّيلِ دفنُهُ","فَقُلنَ وهَل يَخفَى الهِلَالُ إِذَا أَفَل",6,"ل",1,0],["أَيُّ خَطْبٍ أَصَابَ أَوْحَدَ قَوْمٍ","فأَشَاعَ الأَحْزَانِ فِي أَقْوَامِ",7,"م",1,0],["أَيُّ خَيْرِ الفُتُوحِ مَا لَمْ تَعَبِّيءْ","فِيهِ جَيْشاً وَلَمْ تُجَرِّدُ حُسَامَا",8,"م",2,0],["أيُخلقنا كرّ الجديدَيْن ضِلّةً","ولم نتقمّص فيهما ما تِجدّدا",9,"د",2,0],["أيّ خطب دها ربوع الشام","يوم أمست تبكي بطرف دام",10,"م",1,1],["أي خلق من المنية يحمى","وهي تسري إليه مسرى الخيال",11,"ل",1,0],["أيُّ خلٍّ تراه كالذهب الأح","مر أو كالوذِيلة الزهراءِ",12,"ا",2,0],["أيخافُ عَيْنَيْ من قُتلْتُ بحبِّهِ","قَلَبَ الحديثَ كما اشتهى أن يُقْلَبَا",13,"ب",2,0],["أيَخِيبُ تَأمِيلِكُمُ وَقَرينُهُ","شَفَقِي عليكم والقوَارعُ تَنْتَطِحْ",14,"ح",1,0],["أيُّ خَطْبٍ وأيُّ رُزْء جليلٍ","نالنا في أولئكَ الأعمام",15,"م",1,0],["أَيُّ خَطبٍ دَها فَباتَ المَهجَر","مِثلَ حَقلٍ مَرَّت عَلَيهِ صَرصَر",16,"ر",1,1],["أَيَخذِلُ جارَةَ الوادي بَنوها","مَعاذَ اللَهِ هَذا لَن يَكونا",17,"ن",2,0],["أَيَخونُ عَهدَكَ غادِرٌ فَيَضُمُّهُ","ما بَينَ جانِحَتَيكَ وادٍ مُخصِبُ",18,"ب",1,0],["أَيُّ خمرٍ مُؤَجَّجٍ ولهيبٍ","مُسكرٍ أَيُّ نشوَةٍ وجنونِ",19,"ن",1,0],["أَيُّ خمرٍ رشفتُ بل أَيُّ نارٍ","في شفاهٍ بديعَةِ التَّكوينِ",19,"ن",1,0],["أي خير من الحياة لشعب","ما له من نقض ومن إبرام",20,"م",1,0],["أي خير للناس في نظر لم","يك بالفعل صدقه مقرونا",21,"ن",2,0],["أَيَخونُ في سِرِّ الصَديقِ لِسانُ ذي","كَرَمٍ عَلى سِرِّ العَدُوِّ أَمينِ",22,"ن",1,0],["أيخشى الخطب ذو قلب حداد","وخطب في غياهبه حديد",23,"د",1,0],["أيخيفني العشب الضعيف أنا الذي","أسلمت للشوك الممض أديمي",24,"ي",1,0],["أيّ خطْبٍ عن قوْسهِ الموْتُ يرْمي","وسهامٌ تصيبُ منه فتُصْمي",25,"ي",1,1],["أَيّ خَطْبٍ فادحٍ في رَقدةٍ","يُوقِظُ الحشرُ إِلَيها مُقلتيك",26,"ك",1,0],["أَيُّ خِصالٍ حازَها سَيِّدي","لَو لَم يُكَدِّر صَفوَها مَطلُهُ",27,"ل",2,0],["أيخافُ خيرُ الخلقِ مِنْ أحد","واللهُ يعصمُهُ منَ الناسِ",28,"س",1,0],["أيخشى القفلُ منْ لصٍّ","أليسَ الفتحُ في القفلِ",29,"ل",1,0],["أَيَخفى لَنا وَلِلمُغيريِّ مَجلِسٌ","فَإِنَّ النَوى كانَت قَليلاً لِمامُها",30,"م",3,0],["أَيَخفى عَلى ظَهرٍ وُقوفُ مَطِيَّةٍ","بِراكِبِها هَذا مِنَ الأَمرِ أَشنَعُ",31,"ع",1,0],["أيُّ خطبٍ لم يُخَفِّفْ هولَه","مصرعُ الفاروقِ أو خطبُ الحُسَيْنْ",32,"ن",1,0],["أَيُخذَلُ في الكنانةِ كلُّ حُرٍّ","ويُنصرُ كلُّ صَخَّابٍ شَغوبِ",33,"ب",1,0],["أَيخذِلُنا وَنحنُ لَهُ نُصلِّي","جَميعاً مِن قُعودٍ أَو قِيامِ",34,"م",1,0],["أَيّ خَطبٍ أَصابَكُم معشرَ الطَي","ر وَماذا في الرَوض مِن أَسرارِ",35,"ر",1,0],["أَيُّ خَيرٍ يا عَونُ يَرجو مُحِبُّ","في سَوادِ الفُؤادِ مِنهُ بَراحا",36,"ح",2,0],["أَيَخلُصُ هَذا الوَرى","مِنَ الحِندِسِ المُظلِمِ",37,"م",1,0],["أَيَخَافُهَا وَهْوَ المُرَاغِمُ لِلرَّدَى","حَتى يُوَافِيَهُ بِحِيلَةِ سَارِقِ",38,"ق",1,0],["أَيُّ خَطْبٍ دَهَى الْفَضَائِلَ فِي النَّدْ","بِ المُوَالِي وَفِي الْهُمَامِ الْجَوَاد",39,"د",1,0],["أَيَّ خَلْقٍ نَرَى بِشَكْلٍ جَدِيدِ","بِنْتَ شَمْسٍ أَمْ قَدْ بَدَتْ لِلْعَبِيدِ",40,"د",1,0],["أَيَخافُ قَلبي غَدرَكُم مَعَ أَنَّهُ","جارٌ أَقامَ لَدَيكُمُ وَنَزيلُ",41,"ل",1,0],["أيخاف الباز شر الحجل","ذكر السين عهوداً للتي",42,"ي",1,0],["أيخلق منك جديد الهوى","فؤاد من السكر لا يعقل",43,"ل",1,0],["أيَخْشَى الفقرَ ذو عرشٍ وتاجٍ","تَدِينُ له الروابي والبطاحُ؟",44,"ح",1,0],["أيُخلَقُ منك جديدُ الهوى","فؤاداً من السُّكر لا يَعقلُ",45,"ل",1,0],["أيّ خطب في الكون أعظمُ مما","ترك الناس ذاهلينَ هيامى",46,"م",2,0],["أيخلق طفلا نفسه وهو نطفةٌ","وينشئها طوراً فطوراً فما تما",47,"م",2,0],["أيخوفونك بالذي يعصونه","ونطيعه يا مذهباً ما أسخفا",48,"ف",2,0],["أيخلع منكم ربقة الدين عاقل","لقول غريق في الضلالة جائر",49,"ر",1,0],["أيخطب لابن عروة وهو لصّ","مغيرٌ إن ذا خطب عظيم",50,"م",1,0],["أيخلف ميعادي الجمال وإنه","ليعرف أن الموت إن خان أسهل",51,"ل",1,0],["أَي خَليلَ البِلادِ وَفَّيتَ قِسطاً","من فُروضٍ عَلَيكَ لِلعَلياءِ",52,"ا",2,0],["أيّ خَلْقٍ يكون أنقصَ ممّن","ليس يدري لأيّ حال يصير",53,"ر",1,0],["أيَّ خَطْبٍ أرى وأيُّ ليالٍ","دهم الناس صَرفُها المحذورُ",54,"ر",1,0],["أيخمدُ فكرٌ ساطعٌ مثلَ نجمةٍ","بها النازحُ الرحّالُ في الغَيهَبِ اهتدى",55,"د",2,0],["أَيُخدعُ بِالآمالِ مرءٌ مصيرهُ","مَصيرُ الّذي قَد ضمّ ذا الترب والصفا",56,"ف",2,0],["أيّ خيرٍ لمؤمن في نعيم","صار منه عن ربّه في حجابِ",57,"ب",1,0],["أيّ خمر ملأت كأسي منها","أيّ كاس مجنوتةِ الصهباء",58,"ا",2,0],["أَيَخْرِقُ خَدَّهَا مِنّي خَيَالاً","كَلِيمَ القَلْبِ نَاظِرُهُ الذَّبِيحُ",59,"ح",1,0],["أَيَخسَرُ حاشاهُ مِنَ القَولِ قَولُهُم","كِرامٌ بِهِ اِستَكفَوا مِنَ الدَهرِ ما كُفوا",60,"ف",3,0],["أيُّ خلقٍ مستصعبٍ كلَّ سهلٍ","تحت عزمٍ مستسِهلٍ كلَّ صعبِ",61,"ب",1,0],["أَيَخاَفُ طُولَ المطْلِ مَنْ","أهْلُ الغَريّ لَهُ غَريمُ",62,"م",1,0],["أَيَخلف ظَنّي مِن أَبوه مُفرِجٌ","أَلا إِنَّ أَولادَ الجِيادِ جِيادُ",63,"د",1,0],["أيخادعون مخادعاً إحسانُه","عبثٌ وأسخفُ ما حكاه مهاتُر",64,"ر",1,0],["أيخشى ابن إبراهيمَ فَوت وِزارةٍ","وقد حازها سقفَ السماء وأبعدا",65,"د",2,0],["أيخمل قدري بعد طول نباهةٍ","وما الفضل عند الأكرمين بخامل",66,"ل",1,0],["أيُّ خلْصاءِ مُهجةٍ عشِقَتهُ","وبِسلسالِ خَمرهِ ما هامَتْ",67,"ت",1,0],["أيخفى صحيح الوجد والسقم لائح","ويكتم سر الشوق والدمع بائح",68,"ح",1,1],["أيخونُني اليومَ القريض وإنَّني","ربُّ القريضِ وفي القَوافي أحكُمُ",69,"م",1,0],["أيُّ خطوبٍ لم تشفِنِي عِظَةً","وأَيُّ دهرٍ لم أفنِهِ عَجَبا",70,"ب",2,0],["أَيّ خلقٍ أَولى بخدمَتِه منِّي","وأَولَى مِنه برَفْعي ونَفْعي",71,"ي",1,0]]}