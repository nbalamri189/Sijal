ف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128880","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128905","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128893","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128886","الخفيف"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128911","الخفيف"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29285","الخفيف"],[3984,"","https://poetry.dctabudhabi.ae/diwan/poem/147200","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81285","الرمل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81237","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81284","الخفيف"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104537","الخفيف"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52126","الخفيف"],[4830,"خواطرٌ الأمس","https://www.poetsgate.com/ViewPoem.aspx?id=215473",""],[4929,"مانبا السيف بل الكف أبى","https://www.poetsgate.com/ViewPoem.aspx?id=204993",""],[5064,"ليلٌ حاتِميٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=199087",""],[5121,"مَسَاءُ الشُّعُورِ","https://www.poetsgate.com/ViewPoem.aspx?id=56463",""],[5121,"شَاعِرُ الدُّنْيَا","https://www.poetsgate.com/ViewPoem.aspx?id=212038",""],[5121,"صَبَاحُ الْحُرِّيَّة","https://www.poetsgate.com/ViewPoem.aspx?id=213485",""],[5121,"سَكْرَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=213505",""],[5121,"دَهْشَة","https://www.poetsgate.com/ViewPoem.aspx?id=215977",""],[5186,"\"أيهذا \"\"الدبور\"\" أين الحمار","https://www.poetsgate.com/ViewPoem.aspx?id=156553",""],[5186,"من مغيثي، من منصفي، من مجيري؟","https://www.poetsgate.com/ViewPoem.aspx?id=156554",""],[5186,"ما لواه الكلال والتهويم","https://www.poetsgate.com/ViewPoem.aspx?id=156453",""],[5186,"أيهذا البناء لو كنت حرا","https://www.poetsgate.com/ViewPoem.aspx?id=156469",""],[333,"نشيد الصفاء","https://www.poetsgate.com/ViewPoem.aspx?id=101256",""],[5722,"النهر الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=12693",""],[5777,"قم فَقد لاح بريق الأمل","https://www.poetsgate.com/ViewPoem.aspx?id=157258",""],[5309,"أيهذا الشادي على الأوتار","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573783",""],[6164,"الشباب .. والشيخوخة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66027&r=&rc=37",""],[6331,"خبِّريني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82020&r=&rc=1",""]],"verses":[["أَيُّهَذا الثَرى إِلامَ التَمادي","بَعدَ هَذا أَأَنتَ غَرثانُ صادي",0,"د",2,1],["أَيُّهَذا السَجينُ لا يَمنَعُ السِج","نُ كَريماً مِن أَن يُقيلَ العِثارا",1,"ر",2,0],["أَيُّهَذا الإِمامُ أَكثَرتَ حُسّا","دي فَباتَت نُفوسُهُم في اِلتِهابِ",2,"ب",1,0],["أَيُّهذا المُسائِلي عن سعيدٍ","وشقيٍّ ولاتَ حينَ خفاءِ",3,"ا",2,0],["أيُّهذا المُهيبُ بي وبشعري","لستُ ممن يُجيب كلَّ مُهيبِ",4,"ب",1,0],["أيهذا السيِّدُ المُصْ","غي إلى نُصْح ثقاتِهْ",5,"ت",2,0],["أيُّهذا الأميرُ ألبسك اللَ","هُ بقاءَ الموْجود لا المفقودِ",6,"د",1,0],["أُيّهذا الممارسي بيديه","قدكَ لن يُؤلمَ القتادةَ خرط",7,"ط",1,0],["أيُّهذا المُسائلي بعليٍّ","زادك اللَّهُ بالمعالم جهلا",8,"ل",2,0],["أيهذا الأميرُ أسعدك اللَّ","هُ وأبقاكَ ما جرى العصران",9,"ن",1,0],["أَيُّهَذا الشاكي وَما بِكَ داءٌ","كَيفَ تَغدو إِذا غَدَوتَ عَليلا",10,"ل",2,1],["أَيُّهَذا الشاكي وَما بِكَ داءٌ","كُن جَميلاً تَرَ الوُجودَ جَميلا",10,"ل",2,0],["أَيُّهَذا الوَزيرُ تَمَّ لَكَ الطو","لُ وَلا زِلتَ تُرتَجى وَتُنيلُ",11,"ل",1,0],["أَيُّهَذا الأَميرُ قَد مَسَّنا الضُرُّ","وَمُدَّت يَدُ الخُطوبِ إِلَينا",12,"ن",2,1],["أَيُّ هَذا الأَميرُ أوفِ لَنا الكَي","لَ بِما شِئتَ أَو تَصدَّق عَلَينا",12,"ن",2,0],["أَيُّهَذا العَزيزُ قَد صَحَّ رِقّي","لَكَ مِن مَوقِعِ اِسمِيَ المَرموزِ",13,"ز",1,1],["أيهذا المكان يا غالي التر","ب ومثوى عبادتي واحترامي",14,"ي",1,0],["أيهذا الوادي المحبب ما زرتك","حتى سألت عن أوصابي",14,"ي",1,0],["أَيُّهَذا السَحابُ دونَكَ مِنّي","زاهِراً مِن كَمامِهِ الأَفكارُ",15,"ر",1,0],["أيهذا التمثالُ هأنذا جئتُ","لألقاكَ في السكونِ العميقِ",16,"ق",1,0],["أيُّهذِي الخدورُ أنوارُكِ الحم","راءُ كم أشعَلتْ لياليَ أُنسي",17,"س",2,0],["أَيُّهذِي الشَّهْبَاءُ","وَالْحُسْنُ في ذَلِكَ الشَّهَبْ",18,"ب",1,0],["أَيُّ هَذَا الثَّرَى ظَفِرْتَ بِحُسْنٍ","كَانَ بِالطُّهْرِ وَالعَفَافِ مَصُونَا",19,"ن",2,0],["أَيُّ هَذَا المِكْرُوبُ مَهْلاً قَلِيلاَ","قَدْ تَجَاوَزْتَ في سُراكَ السبِيلاَ",20,"ل",2,1],["أيُّهذا الأثير، إن كان في المر","يخ حيٌّ، فاحمل إليه السلاما",21,"م",2,0],["أيُّهذا الجماد، حسبك: ألا","تَصحَب الشيَّب، أو تذوق الحماما",21,"م",2,0],["أَيُّهَذَا الأَمِيرُ ، أَوْفِ لَنَا الكَبْ","لَ بِمَا شِئْتَ أَوْ تَصَدَّقْ عَلَيْنا",22,"ن",2,0],["أيّهَذا الوَزِيرُ! ثَمَّ لكَ الطَّوْ","لُ، وَلا زِلْتَ تُرْتَجَى وَتُنيلُ",23,"ل",1,0],["أيهذا المُسائلي بعليٍّ","أنا طَبٌّ به فسائل وأحْفِ",24,"ف",1,0],["أيّهذا المُتجنّي","ما الذي رابَك مِنّي",25,"ن",2,1],["ايهذا التراب بوركت من","قاض لأحكامه استراح العباد",26,"د",1,0],["أيهذا الرحل الأح","نف ياذاك النصيح",27,"ح",1,1],["أيهذا الهائج الصاخب","أوقدت الضراما",28,"م",2,0],["أيهذا الشاعر المغ","ترب الباكي أصيلا",29,"ل",2,1],["أيهذا الليلُ والصمتُ الرهيب","جدّدِ اللوعة في القلبِ الطعين",30,"ن",1,0],["أيهذا المسيحُ إن الليالي","في بنيها من الزمانِ سهامُ",31,"م",1,0],["أيهذا الترامُ أنتَ دليلُ الأ","فْقِ في الأرضِ وشرقها والشمالِ",32,"ل",1,0],["أي هذين في الرجالِ أهنَّ الأ","مهاتُ النسا أمِ الآباءُ",33,"ا",2,0],["أيهذا الرئيسُ دعوةَ عَبدٍ","أصبح الحُزنُ دَأبَهُ والبكاءُ",34,"ا",2,0],["أيُّهذا الأميرُ قد أشكَلَ المَعنى","ومازلتَ عارفا بالمعاني",35,"ن",2,1],["أيُّهذا الإمَامُ سَيفُكَ مَاضٍ","وَبِكَفِّ الوَلِيِّ غَيرُ كَهَامِ",36,"م",1,1],["آيه ذكرى أحبّتي","هجتِ آلام شاعر",37,"ر",1,0],["أيّهذا المُذكري ثغراً به","بردُ نظمٍ لاحَ في تلك الشنب",38,"ب",1,0],["أيهذا الطفل تلهيه الدمى","إن في الأولى معاني الآخره",39,"ه",1,0],["أيّهذا الشيطان إن تكُ عبداً","فأنا اللَه خالق الشيطان",40,"ن",1,0],["أيهذا الأميّ يا أبلغ الخلق","بيانا قدّست من أمّيّ",41,"ي",1,0],["أيهذا اليتيم حسبك فخرا أن","ترى اللَه منك خير وصيّ",41,"ي",1,0],["أيّهذا الفقير إلا من الخير","تعاليت فوق كل غني",41,"ي",1,0],["أَيُّهذا الّذي كَبِرْتَ عنِ الوَصْ","فِ فعَطْفاً على الأصاغِرِ عَطْفاً",42,"ف",2,0],["أيُّهذا المَولَى وَجُودُك قِدماً","من سُروحِ الرّجاء يَحمي القَواصي",43,"ص",2,0],["أَيهذا المَعيربي حَيث وَردي","ثَمد تَكتَفي بِهِ النَفس رنق",44,"ق",1,1],["أَيُّهذا الزَمان إِن كنت صَخراً","فَبِكِلتا يَديَّ آيَة موسى",45,"س",2,0],["أَيُّهَذا الصَديقُ لا عَتبَ إِن لَم","تَثنِ عِطفَيَّ في وِصالٍ جَديدِ",46,"د",1,1],["أَيُّهَذا المُخبِّري عَن يَزيدٍ","بِصَلاحٍ فِداكَ أَهلي وَمالي",47,"ي",1,1],["أيهذا المدرسي","بالمعارف اكتس",48,"س",1,0],["أي هذا الحجر الجا","مد والأرض الموات",49,"ت",1,0],["أيهذا المذكري مجد قومي","حين فاض الونى وجف اليراع",50,"ع",1,0],["أيهذا العزيز قد مسَّنا الضرُّ","وعانيتُ مذ هجرتَ المنونا",51,"ن",2,1],["أيُّهذا الصاحي من الوجد","والناظرُ من غنجه بعين النَّزيف",52,"ف",1,0],["أيّهذا الأستاذُ لولا انطلاقي","عنك لم أدرِ كيف قَدرُ انطلاقي",53,"ق",2,0],["أَيَهَذا الوَضيعُ كَم تَتَنَبَّل","لَو تَواضَعتَ كانَ أَبهى وَأَجمَل",54,"ل",1,1],["أيهذا الوزير أيدك الله","وأبقاك لي بقاء طويلا",55,"ل",2,1],["ايهذا المليك رأيك في سو","ء امتلاكي فلن اروم الفراقا",56,"ق",2,0],["أيهذا الأديب أوريت نارا","في فؤادي وزدت في تعذيبي",57,"ب",2,0],["أيهذا النعىُّ روعت صرحا","شيدته عزائم ما بَلينَا",58,"ن",2,0],["أيّهذا البشير لي حبَّذا أنت","بشيراً ببرءِ داءِ الحبيبِ",59,"ب",1,0],["أيّ هذا اللائمي في جَلد","فيه خالفتُ لِداتي مشربا",60,"ب",2,0],["أي هذين ما أردتَ فخذهُ","ليس منا وليسَ منكَ الهوينى",61,"ن",2,0],["أَيُّهَذا الشَرق يَكفيكَ عَمى","فَاِتَّقِ الغَربَ وَكُن في حَذِرِ",62,"ر",1,0],["أيهذا الكرديّ لا زلت تلقى","ضربات العدا وكل هوان",63,"ن",1,0],["أية ذيل الضليل عن الراشد","فيها أرشد بمن أبداها",64,"ا",3,0],["أَيُّهَذا المُصطَفى في قَومِهِ","بَعدَ سَعدٍ وَالمُفَدّى وَالأَمين",65,"ن",1,0],["أيهذا الأمير بل يا أبا القا","سم يا بن السميدع القمقام",66,"م",1,0],["أَيُّهذا الَّذي نَوى الحَجَّ مَهلا","أَنتَ مَحجوجُ مَن بَراهُ السَقامُ",67,"م",1,0],["ايهذا الانسان فكر قليلا","وامحُ هذا الغرور بالايمان",68,"ن",1,0],["ايهذا الانسان ان ترع فرضاً","واجباً نجو مبدع الاكوان",68,"ن",1,0],["أيهذا المجهول هل تنكر الأج","يال ما قد حملت من أعباء",69,"ا",2,0],["ايهذا الجليل بل من تعدى","بعلاه الفتى الأجل الاجلا",70,"ل",2,0],["أيهذا الحمّامُ أنتَ نَعيمي","وَجَحيمي وصحَتي وَسَقامي",71,"م",2,0],["أيهذا الشيطان دونك عني","أنا كهل فلا تخلني غبيا",72,"ي",2,1],["أيهذا الذي يقدم كأسا","لسروري حرمتني من سروري",73,"ر",2,0],["أيهذا الخزان نلت الفخارا","وكساك الذي بناك الوقارا",74,"ر",2,1],["أيهذا الأدب المج","فوّ ما أقفر دارك",75,"ك",1,1],["أيُّهذا الجيبون أَنْعِمْ سلامًا","يا أبا العبقري والبهلوان",76,"ن",1,1],["أيهذا القطار تسرع في الحقل","فدعني أهيم في خضرائه",77,"ا",3,0],["أيهذا الفلاح حتام تشقى","ويهنا بكدك الملاك",78,"ك",1,1],["أيهذا الفلاح حسبك فخرا","تتجلى وانت حر الضمير",79,"ر",1,0],["أيهذا الشعب الابي تنبه","من رقاد وانبذ حياة الغرور",79,"ر",1,0],["أيهذا الحراث رفقا بأرض","هي والله من ثرى أجدادك",80,"ك",1,1],["أيهذا الشرقي حتام تبقى","بانحطاط في أسفل الدركات",81,"ت",1,0],["أيهذا الغنى فكر قليلا","وترفق بحالة الضعفاء",82,"ا",2,0],["أيهذى البيضاء قد طال عتبي","سامحيني أفقت من غفلاتي",83,"ت",2,0],["أَيَهذا السُكونُ يا حاكِمَ المَو","تِ وَصَنو الآزالِ وَالآبِداتِ",84,"ت",1,1],["أيهذا النسر الذي راعه العي","شُ بوادِ كابٍ ذليلٍ مقيّد",85,"د",1,0],["أَيَهذا العَثير الغا","ئم في صَحو سَمائي",86,"ي",1,0],["أَيَهَذا النَبي مَرحى بِمَغدا","ك إِلَينا أَهلاً بِلُقياك البَشير",87,"ر",1,0],["أَيهَذا الحَبيب كَم عِندَنا مِن","كَ نَعيم مِما تَجود وَتَمنع",88,"ع",1,0],["أَيهذا الحَبيب ما بي إِلّا","إِن دُنياك مِن نَعيمي مربع",88,"ع",1,0],["أيهذا اليعسوب إنك قد أسرف","ت فاحرص على بقايا النحل",89,"ل",1,0],["ايهذا الحَبْرُ الذي قد أراني","بولسٌ فيه راسماً تمثالَه",90,"ل",2,0],["أيُّهذا المشيبُ يكفي قِطافاً","نِلتَ من زهرِ مُنيَتي حينَ أينَعْ",91,"ع",1,0],["أيُّهَذا اللائمُ السيفَ اتَّئدْ","إنما اللومُ على مَنْ ضَربَا",92,"ب",2,0],["أَيُّهذَا الرِّدَاءُ باللهِ دَعْنِي","أَتُمَنِّي بالقَتْلِ نَفْسًا قَتِيلَهْ؟!",93,"ل",2,0],["أَيُّهَذَا اللَّيْلُ اقْتَطِفْ لِي وُرُوداً","وَتَنَفَّسْ..فَإِنَّكَ الْمَأْثُورُ",94,"ر",1,0],["أَيُّهَذَا الْمَعْجُونُ بِالسِّحْرِ زِدْنَي","وَتَخَفَّى إِذَا الْمُحَالُ اسْتَنَارَا",95,"ر",2,0],["أَيُّهَذَا الْمَعْقُودُ فَوْقَ جَبِينِي","شِدَّ أَزْرَ الأَوْجَاعِ فَالْعَيْنُ نَدَّتْ",96,"ت",1,0],["أَيُّهَذَا الْمُتَأَنِّي","كَيْفَ يَنْجُو مِنْكَ سُكْرِي",97,"ر",2,0],["أَيُّهَذَا الشِّعْرُ الطَّلِيقُ الْهُوَيْنَى","فَسِجَالِي مُكَتَّفٌ بِرَحِيلِي",98,"ل",2,0],["\"أيهذا \"\"الدبور\"\" أين الحمار\"","أعلى فرقة الرفيق اصطبار؟",99,"ر",1,1],["أيهذا الدبور! عد بي إلى","الجد فأنت الهزار، لا المهذار",99,"ر",1,0],["أيهذا الدبور عود سعيد","\"وعسى يرجع \"\"الرفيق\"\" الحمار\"",99,"ر",1,0],["أيهذا (الأمين) آجرك الله","فقد نقدوك شر الأجور",100,"ر",1,0],["أيهذا الزينبل أنت سلاحي","وعلى بيدري يحق الهجوم",101,"م",1,0],["أيهذا البناء لو كنت حرا","لكفتني حريتي إلماعا",102,"ع",2,1],["أيهذا البناء لو كنت حرا","لاحترمت الحقوق والأوضاعا",102,"ع",2,0],["أيهذا البناء إنك تبني","فوق دار كادت تهور انصدعا",102,"ع",2,0],["أيُّهذا الأُمّيّ يا أبلغ الخلق بيانا . . قدّست من أُمِّيّ","أيّهذا اليتيم حسبك فخرا أن ترى الله منك خير وصيّ",103,"ي",1,0],["أيُّهذا الفقير إلا من الخير تعاليت فوق كل غَنيّ","أيُّها الصامت الذي أيقظَ الكون بنجواه للعزيز العليّ",103,"ي",1,0],["أيّهذا النهرُ الحبيبُ إلى نف","سي ويا ملهمي إذا قلتُ شعرا",104,"ر",2,0],["أيهذا الشهم مزقت الحشا","بشكاة من جهول أرذلِ",105,"ل",1,0],["أَيُّهذا الشادي عَلى الأَوتارِ","مُغرِياتِ الألحانِ في الأَسحارِ",106,"ر",1,1],["أَيُّهذا الإِيمانُ أَسْعَدني اليَوْمَ","ونَجَّى مِن الخُطُوبِ الثِّقالِ..",107,"ل",1,1],["أيُّهذا المدَّعي أملاً","والدَّواهي ما لها نُذُرُ",108,"ر",1,0]]}