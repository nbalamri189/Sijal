213.html","الوافر"],[46,"أدنياي اذهبي وسواي أمي","https://www.aldiwan.net/poem23401.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85477","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85488","الطويل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140971",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39628","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39662","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39639","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16664","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16635","الطويل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30439","الطويل"],[33,"","https://poetry.dctabudhabi.ae/diwan/poem/10976","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42645","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42685","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42600","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42698","المتقارب"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42567","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55122","الوافر"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199501","الوافر"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199492","الوافر"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1913","الطويل"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116981","المتقارب"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24377","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54286","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54259","الطويل"],[106,"فقيد الفصحى!","https://www.poetsgate.com/ViewPoem.aspx?id=179487",""],[106,"طوى الموت إبراهيم!","https://www.poetsgate.com/ViewPoem.aspx?id=179679",""],[106,"عدل السماء","https://www.poetsgate.com/ViewPoem.aspx?id=179777",""],[74,"خليلي هَل من وَقْفَة بتألم","https://www.poetsgate.com/ViewPoem.aspx?id=189651",""],[77,"تلافيت نصر الدين إذ كاد يتلف","https://www.poetsgate.com/ViewPoem.aspx?id=34179",""],[84,"إذا لم تجد إلا الأسى لك صاحبا","https://www.poetsgate.com/ViewPoem.aspx?id=26307",""],[96,"هزيمةالشيطان","https://www.poetsgate.com/ViewPoem.aspx?id=17478",""],[90,"الأوباش","https://www.poetsgate.com/ViewPoem.aspx?id=179102",""],[90,"الحزبان المتآخيان","https://www.poetsgate.com/ViewPoem.aspx?id=179105",""],[90,"صحو بعد سكر","https://www.poetsgate.com/ViewPoem.aspx?id=178933",""],[90,"شباب ضائع","https://www.poetsgate.com/ViewPoem.aspx?id=179161",""],[90,"سبيل الجَماهير","https://www.poetsgate.com/ViewPoem.aspx?id=178923",""],[45,"ملامك في صدود واجتناب","https://www.poetsgate.com/ViewPoem.aspx?id=31541",""],[51,"لما حقُّ من صدَّ عن مشربٍ","https://www.poetsgate.com/ViewPoem.aspx?id=29485",""],[31,"ألا من يرى رأيَ امرىء ٍ ذي قرابة ٍ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18938&r=&rc=201",""]],"verses":[["وَما ذَكَرَتكَ النَفسُ إِلّا وَضَمَّها","إِلى القَلبِ باعُ الموجَعِ المُتَأَلِّمِ",0,"م",1,0],["وَما ذاكَ أَنَّ النَفسَ غَيرُ نَفيسَةٍ","وَلَكِن رَأَيتُ الجُبنَ ضَرباً مِنَ البُخلِ",1,"ل",1,0],["وَما ذادَني ذِكرُ الأَحِبَّةِ عَن كَرىً","وَلَكِنَّ لَيلي بِالعِراقِ طَويلُ",2,"ل",1,0],["وَما ذاكَ مِن وَجدٍ خَلا أَنَّ هِمَّةً","عَنائي بِها في الواجِدينَ طَويلُ",3,"ل",1,0],["وَما ذاكَ جَهلاً وَلَكِنَّهُ","نِزاعُ الجَوادِ إِلى الصافِرِ",4,"ر",1,0],["وَما ذَنبي إِذا اِتَّفَقَت خُطوبٌ","مُغالِبَةٌ وَأَيّامٌ غِضابُ",5,"ب",1,0],["وَماذا آنَسَ الكُردُ","بِمَن زَلزَلَ بِالعُرَبِ",6,"ب",1,0],["وَما ذاكَ إِلّا مِن عِتابٍ نَبَذتُهُ","إِلَيها عَلى ذُعرٍ وَنَحنُ حَجيجُ",7,"ج",1,0],["وما ذُقْتُ فاهَا غَيرَ أنّي مُكَرِّرٌ","أحاديثَ يَرْويها فُروعُ بَشامِ",8,"م",1,0],["وَما ذِكرى رَقاشِ إِذا اِستَقَرَّت","لَدى الطَرفاءِ عِندَ اِبنَي شَمامِ",9,"م",1,0],["وَماذا يَضُرُّكَ مِن شُهرَتي","إِذا كانَ سِرُّكَ لا يُشهَرُ",10,"ر",1,0],["وَما ذاكَ إِلا حَيثُ أَيقَنتُ أَنَّهُ","يَمُرُّ بِوادٍ أَنتِ مِنهُ قَريبُ",11,"ب",1,0],["وَما ذُكِرَت عِندي لَها مِن سَمِيَةٍ","مِنَ الناسِ إِلّا بَلَّ دَمعي رِدائِيا",12,"ي",2,0],["وماذا عسَى يُثْني فصيحٌ وشاعِرٌ","وماذا عسَى يُحصي كلامٌ مُزَخْرَفُ",13,"ف",1,0],["وَمَا ذَاكَ إِلاَّ مِنْ نَجِيعِي خَضَبْتُهُ","وَلَيْسَ لِمَخْضُوبِ الْبَنَانِ يَمِينُ",14,"ن",1,0],["وماذا يعدُّ الوصْفُ منْ مُعْجِزاتِهِ","وآيُ رسولِ اللهِ تستَغْرِقُ العَدّا",15,"د",2,0],["وَما ذَنبُهُ أَن عافَتِ الماءَ باقِرٌ","وَما إِن تَعافُ الماءَ إِلّا لِيُضرَبا",16,"ب",2,0],["وَما ذاكَ مِن عِشقِ النِساءِ وَإِنَّما","تَناسَيتَ قَبلَ اليَومَ خُلَّةَ مَهدَدا",17,"د",2,0],["وَما ذاكَ مِن جُرمٍ عَظيمٍ جَنَيتِهِ","وَلا أَن تَكوني جِئتِ فينا بِبائِقَه",18,"ق",2,0],["وَما ذاكَ إِلّا أَنَّ كَفَّيكَ بِالنَدى","تَجودانِ بِالإِعطاءِ قَبلَ سُؤالِكا",19,"ك",2,0],["وَما ذاكَ عَن شَيءٍ أَكونُ اِجتَرَمتُهُ","سِوى أَنَّ شَيباً في المَفارِقِ شامِلي",20,"ل",2,0],["وَماذا في مَدارِسِكُم","مِنَ التَعليمِ وَالكُتُبِ",21,"ب",1,0],["وَماذا في مَساجِدِكُم","مِنَ التِبيانِ وَالخُطَبِ",21,"ب",1,0],["وَماذا في صَحائِفِكُم","سِوى التَمويهِ وَالكَذِبِ",21,"ب",1,0],["وَماذا عَلَيهِ إِذا فاتَنا","وَنَحنُ عَلى العَيشِ لَم نَدأَبِ",22,"ب",1,0],["وَماذا عَسى الواشونَ أَن يَتَحَدَّثوا","سِوى أَن يَقولوا إِنَّني لَكِ عاشِقُ",23,"ق",1,0],["وَماذا عَلَيهم أَن كَلِفتُ بِأَسوَدٍ","محلتهُ في العَينِ وَالقَلبِ مِنهُمُ",24,"م",1,0],["وَماذا عَلَيها أَن يُسَنِّيَ وَصلَها","طِعانٌ فَإِن لَم يُغنِنا فَضِرابُ",25,"ب",1,0],["وَما ذو التَذَكُّرِ مِمَّن يُلامُ","وَلا كَرَمُ العَهدِ مِمّا يُذَم",26,"م",1,0],["وَما ذَرَفَت عَيناكِ إِلّا لِتَضرِبي","بِسَهمَيكِ في أَعشارِ قَلبٍ مُقَتَّلِ",27,"ل",1,0],["وَماذا عَلَيهِ إِن ذَكَرتُ أَوانِس","كَغِزلانِ رَملٍ في مَحاريبِ أَقيالِ",28,"ل",1,0],["وَما ذِكرُهُ تِربى خُصَيلَةَ بَعدَما","ظَعَنَّ بِأَجوازِ المَراضِ فَتَغلَمِ",29,"م",1,0],["وَما ذَكَرَتكِ النَفسُ إِلّا تَفَرَّقَت","فَريقَينِ مِنها عاذِرٌ لي وَلائِمُ",30,"م",1,0],["وَماذا يُواري القَبرُ تَحتَ تُرابِهِ","مِنَ الخَيرِ يا بُؤسَ الحَوادِثِ وَالدَهرِ",31,"ر",1,0],["وَماذا يَهيجُ الشَوقَ مِن رَسمِ دِمنَةٍ","عَفَت غَيرَ مِثلِ الحِميَريّ المُسَهَّمِ",32,"م",1,0],["وَما ذِكرُكِ الشَيءَ الذَّي لَيسَ راجِعاً","بِهِ الوَجدُ إِلاَّ ضَّلةٌ مِن ضَلالِكِ",33,"ك",1,0],["وماذا على الأرواح وهي طليقةٌ","لو احتَّملت أنفاسها حاجة العاني",34,"ن",2,0],["وماذا عسى يُثني البليغ وقد أتى","ثناؤك في وحي كريم وقرآنِ",34,"ن",1,0],["وماذا ترى فيه إذا زرت حانةً","ترى الأنس يشدو في فم يجهل النطقا",35,"ق",2,0],["وماذا نفع أقوال سِمان","إذا أفعالهم كانت عِجافا",36,"ف",2,0],["وماذا عسى يجدي سقوط وزارة","إذا لم تقم أخرى على العدل والصدق",37,"ق",1,0],["وما ذاك إلاّ أنّهم في أمورهم","أبوا أن يسيروا سيرة العقلاء",38,"ا",2,0],["وما ذاك إلاّ أنّها في تَّلَهُّب","يموج بنور ساطعَ وقْد ناره",39,"ر",2,0],["وما ذاك إلاّ أنهم قد تخاذلوا","ولم ينهضوا للخصم نهضة مُلِبد",40,"د",1,0],["وماذا عسى يجدي التوّجع والأسى","من الموت إذ كلْ على الموت وارد",41,"د",1,0],["وماذا وراء القبر مما نريده","وهل من مَدىً بعد العبور على الجسر",42,"ر",1,0],["وَماذا يَبتَغي الشُعَراءُ مِنّي","وَقَد جاوَزتُ حَدَّ الأَربَعينِ",43,"ن",1,0],["وَماذا عَلَيهِم أَن يَعوجوا بِدِمنَةٍ","عَفَت بَينَ عَوصاءِ الأُمَيلِحِ وَالنَقبِ",44,"ب",1,0],["وَما ذُقتُ طَعمَ النَومِ إِلّا مُفَزَّعاً","وَما ساغَ لي بَينَ الحَيازِمِ ريقُ",45,"ق",1,0],["وَماذا يُعَدّي المالُ عَنكَ وَجَمعُهُ","إِذا كانَ ميراثاً وَواراكَ لاحِدُ",46,"د",1,0],["وَمَا ذَمَّ القَبَائلُ من مَعَدٍّ","إِلَى نَجرانَ غَزوَتَنَا الحَجُونَا",47,"ن",2,0],["وَماذا القُنوطُ الَّذي","أَراهُ فَأَستَشعِرُ",48,"ر",1,0],["وَما ذاكَ بُخلاً بِالحَياةِ وَإِنَّها","لَأَوَّلُ مَبذولٍ لِأَوَّلِ مُجتَدِ",49,"د",1,0],["وَما ذاكَ إِلّا أَنَّنا جَعَلَت لَنا","أَكابِرُنا في أَوَّلِ الخَيرِ أَوَّلا",50,"ل",2,0],["وماذا يقول اللفظ في النجم واصفاً","وحسبك أن الله أقسم بالنجم",51,"م",1,0],["وما ذاك شحًّا بالثناء وإنَّما","سجية فياض الغمام هتونه",52,"ن",2,0],["وما ذقت طعم الماء إِلاَّ وَجَدتهُ","كان ليس بالماء الذي كنتُ أعرفُ",53,"ف",1,0],["وما ذاكَ فيهم وحدَه بل زيادةٌ","يقولون ما لا يفعلُ الأمراءُ",54,"ا",2,0],["وما ذاك إلا ثلبُهُ الناسَ طائعاً","وما بَرِحَ الثُّلَّابُ للناس تُثلَبُ",55,"ب",1,0],["وما ذهبتُ إلى فخرٍ على أحدٍ","لكنه القول يجري حين يُبتعَثُ",56,"ث",1,0],["وما ذنبي إليكَ سوَى جِوَارٍ","قَريبٍ مثْلَما قَرُبَ الوريدُ",57,"د",1,0],["وما ذاك إلا أنَّ أرْوَعَ ما جداً","وَفَى لي بعهدٍ من كريم عهودِهِ",58,"د",2,0],["وما ذاك بدعاً من أفاعيل ماجدٍ","له بيت مجدٍ في القديم وسُؤْددِ",59,"د",1,0],["وما ذاك إلا أن نفساً لئيمة","عليها من النعماء ثِقْلٌ يؤُودها",60,"د",3,0],["وما ذقتُهُ إلا بشيمِ ابتسامها","وكم مَخبرٍ يُبديه للعين منظرُ",61,"ر",1,0],["وما ذاك من طِيبِ به غير أنه","ربوخٌ يُفدّي نائكيه وينخُر",62,"ر",1,0],["وما ذاك إلا عمىً في الهوى","وأعمَى الهوَى مرةً يبصر",63,"ر",1,0],["وما ذاك أنِّي نصبُ كل مُناضلٍ","ولا أن عرضي جذلُ من يتمرسُ",64,"س",1,0],["وماذا ينيكُون من شيخةٍ","قد استكْرشَتْ كلَّ مُستَكرَش",65,"ش",1,0],["وما ذاك أني بالرفاهة جاهلٌ","ولكن رأيتُ الخفضَ يُلصقُ بالخفض",66,"ض",1,0],["وما ذاك إلا بالذي أنتَ أهلهُ","وإن لم يُطق شُكري بنعماك مَنْهضا",67,"ض",2,0],["وما ذكرناك إلا كان مُتَّصلاً","ببظر أُمكَ إمصاصٌ وإعضاضُ",68,"ض",1,0],["وما ذاك إلا زجرها لبناتها","مخافة أن يذهبن في الجوِّ ضُيَّعا",69,"ع",2,0],["وما ذاك إلا أنه متهتِّكٌ","يخلّي سبيل الريح غير منازع",70,"ع",1,0],["وما ذاك إلا عقاب امرئ","رأى السيف من حيده موضعه",71,"ع",2,0],["وما ذنَّبَ الأقلام إلا ممثلاً","بهن سيوف الهند كيف تطابقُهْ",72,"ه",1,0],["وما ذاك في الشطرنج عيباً لأنه","عناءٌ عظيمٌ إن جنحْنا إلى العدلِ",73,"ل",1,0],["وما ذاك عن ذنبٍ سوى أنّ خُلَّتِي","بلا مَلقٍ فيما علمت ولا خَتْلِ",74,"ل",1,0],["وما ذاك عند البحتريّ لصاحب","ولا بعضُه في باب فرضٍ ولا نفلِ",74,"ل",1,0],["وما ذاك أني لا أجودُ بنائل","ولكن لي ما لا يحصّنه قُفلُ",75,"ل",1,0],["وما ذاك عن جودي وفضل مثوبتي","ولكنه عن فضله المتكاملِ",76,"ل",1,0],["وما ذائقٌ روحَ الحياةِ بآجِمٍ","مذاقَتَهُ يوماً ولا بعْضِ آجِمِ",77,"م",1,0],["وما ذاك من بُقْيا العِدا غيرَ أنَّهُمْ","رأوا رمْيَه بالذامِ ذاماً لذائمِ",77,"م",1,0],["وَما ذاكَ عَن حُبٍّ فَما فيكَ شيمَةٌ","تُحَبُّ وَلَسنا مِن غُواةِ المَآثِمِ",78,"م",1,0],["وَماذا فيكَ مِن ثِقَلٍ","وَماذا فيكَ مِن بَردِ",79,"د",1,0],["وَما ذاكَ إِلاّ بَسطَةٌ عَن تَفَضُّلٍ","عَلَيهِم وَكانَ الأَفضَلَ المُتَفَضَّلُ",80,"ل",1,0],["وَما ذِكرُهُ بِكرِيَّةً جُشَمِيَّةً","بِدارِ ذَوي الأَوتارِ وَالأَعيُنِ الخُزرِ",81,"ر",1,0],["وماذا على القَدَر المستَمرِّ","لوِ اسْتمرَأ النَّاسُ طعمَ الخلودْ",82,"د",1,0],["وماذا يُرجِّي ربيبُ الخلودِ","من الكونِ وهو المقيمُ العهيدْ",82,"د",1,0],["وماذا يودُّ وماذا يخافُ","من الكونِ وهو المقيمُ الأَبيدْ",82,"د",1,0],["وَما ذاكَ مِمّا يَعتَريني وَإِنَّما","وَصَفتُ الَّذي في جِبلَةِ الخَلق مِن قَبلُ",83,"ل",1,0],["وَما ذَكَرَتكِ النَفسُ يا بثنَ مَرَّةً","مِنَ الدَهرِ إِلّا كادَتِ النَفسُ تُتلَفُ",84,"ف",1,0],["وماذا عسى ان تستطيع ابتعاثه","عقول عليها في جماجمها حجر",85,"ر",1,0],["وما ذهنه الا سراج مكهرب","يضيء طريقيه بما فيه من وقد",86,"د",1,0],["وماذا تحس النفس منا لبقعة","تغور بها في الآخر الاوجه الغر",87,"ر",1,0],["وما ذل قوم ابرموا وحدة لهم","وان لم يكونوا ينتمون الى اب",88,"ب",1,0],["وماذا عليّ اليوم والحق غايتي","اذا كان لا يرضى الجماهير مذهبي",88,"ب",2,0],["وَماذا يوجِسُ الإِنسانُ مِنها","إِذا غَصَّت بِعَلقَمِها اللَهاةُ",89,"ه",1,0],["وَماذا جُبتَ مِن ظُلُماتِ لَيلٍ","بَعيدِ الصُبحِ يُنضي المُدلِجينا",90,"ن",2,0],["وَماذا بِمِصرَ مِنَ المُضحِكاتِ","وَلَكِنَّهُ ضَحِكٌ كَالبُكا",91,"ا",1,0],["وَماذا الَّذي فيهِ مِنَ الحُسنِ رَونَقاً","وَلَكِن بَدا في وَجهِهِ نَحوَكَ البِشرُ",92,"ر",1,0],["وَما ذاكَ بُخلاً بِالنُفوسِ عَلى القَنا","وَلَكِنَّ صَدمَ الشَرِّ لِلشَرِّ أَحزَمُ",93,"م",1,0],["وما ذُبتُ إلّا لاعتلاقِ نسيمها","إِذا خطرتْ حتى أزورَ ذراكُما",94,"م",2,0],["وما ذاكَ كي تزدادَ عِزَّاً وإنَّما","أبانَ به عن رأيكِ المُحكَمِ الجدلِ",95,"ل",1,0],["وما ذاك تقصيرٌ لشأويَ في العُلَى","ولكنْ قضاءٌ بالذي حُمَّ واقعُ",96,"ع",1,0],["وماذا عليهم أنْ يُلِمَّ بأرضهمْ","أخو حاجةٍ نائي المزارِ غريبُ",97,"ب",1,0],["وَما ذَنبُ مَقصورِ اليَدَينِ عَنِ الأَذى","رَقيقِ الحَواشي عَن مُقارَفَةِ الذَنبِ",98,"ب",1,0],["وَمَأذونٌ عَلى خُصيَيهِ إِذناً","يَعُمُّ وَإِن تَعَمَّقَ في الحِجابِ",99,"ب",1,0],["وَما ذاكَ إِلّا أَنَّ فُرسانَهُ اِلتَقَوا","عَلى مُنصَلٍ تُكدى عَلَيهِم مَضارِبُه",100,"ب",2,0],["وَماذا نَقَمتُم مِنهُ لَولا اِعتِسافِكُم","وَتَلجيجُكُم في مُظلِمِ اللُجِ طافِحِ",101,"ح",1,0],["وَما ذَنبي بِأَن كانَ اِبنُ عَمّي","سِواكَ وَكانَ عودُكَ غَيرَ عودي",102,"د",2,0],["وَما ذاكَ إِلّا لَوعَةٌ لَكَ زادُها","تَنائي الدِيارَ جِدَّةً وَتَوَقُّدا",103,"د",2,0],["وَما ذُكِرَت أَخلاقُكَ الغُرُّ فَانثَنى","صَديقُكَ إِلّا وَهوَ غَضبانُ حاسِدُ",104,"د",1,0],["وَما ذاكَ أَنّي زائِلٌ عَن مَوَدَّةٍ","وَلا ناقِضٌ يَوماً لِعَهدٍ وَلا عَقدِ",105,"د",1,0],["وَماذا أَرادَت إِلى مُحرمي","نَ يَجُرّونَ وَهناً فُضولَ الأُزُر",106,"ر",1,0],["وَماذا عَلى مَن يَملَأُ الدَرعَ نَجدَةً","لَدى الرَوعِ أَلّا يُلبِسَ الدِرعَ يَلمَقا",107,"ق",2,0],["وَما ذِكرُ الأَحِبَّةِ مِن ثَبيرٍ","وَبَلدَحَ غَيرُ تَضليلِ الأَماني",108,"ي",1,0],["وَما ذاكَ أَنَّ الشَوقَ يَدنو بِنازِحٍ","وَلا أَنَّني في وَصلِ عَلوَةَ طامِعُ",109,"ع",1,0],["وَما ذاكَ مِن عَيناءَ سَروٌ عَلِمتُهُ","وَلَكِنَّ مَولاها كَريمُ الضَرايِبِ",110,"ب",1,0],["وَماذا عَسى الحَجّاجُ يَبلُغُ جَهدُهُ","إِذا نَحنُ خَلَّفنا حَفيرَ زِيادِ",111,"د",1,0],["وَما ذَرَفَت عَيناكَ إِلّا لِدِمنَةٍ","بِحُزوى مَحَتها الريحُ بَعدَكَ وَالقَطرُ",112,"ر",1,0],["وَما ذَرَفَت عَينانِ بَعدَ مُحَمَّدٍ","عَلى مِثلِهِ إِلّا نُفوسَ الخَلائِفِ",113,"ف",1,0],["وَما ذُكِرَت يَوماً لَهُ عِندَ حاجَةٍ","وَإِن عَظُمَت إِلّا يَكونُ لَهُ شُغلا",114,"ل",2,0],["وَما ذاكَ إِلّا أَنَّني اِختَرتِ لِلقِرى","ثَناءَ المَخاضِ وَالجِذاعَ الأَوابِيا",115,"ي",2,0],["وما ذمِّي لمحمودِ السَّجايا","وما حَمدي لذي الخُلقِ الذَّميمِ",116,"م",1,0],["وَما ذاكَ إِلّا لِأَنَّ النَبيَّ","جَفاكَ وَما كانَ بِالفاعِلِ",117,"ل",1,0],["وَما ذاكَ إِلّا أَنَّني واثِقٌ بِما","لَدَيكَ وَأَنّي عالِمٌ بِوَفائِكا",118,"ك",2,1],["وَما ذاكَ إِلّا أَنَّ ظَنَّكَ سَيّءٌ","بِأَهلِ الوَفا وَالظَنُّ فيكَ جَميلُ",119,"ل",1,0],["وَما ذاكَ إِلّا أَنَّ مُخطَفَ خَصرِهِ","لَراجيهِ كَهفٌ وَالعِذارُ مُقيمُ",120,"م",1,0],["وَما ذاكَ إِلّا أَن شَدَوتُ فَقَد غَدا","يُلَوِّحُ بِالأَحزانِ لي فَأُصَرِّحُ",121,"ح",1,0],["وَما ذاكَ إِلّا أَنَّ يَومَ وَداعِنا","لَقَد غَفَلَت عَينُ الرَقيبِ عَلى رُغمِ",122,"م",1,0],["وماذا عليهم إِن بكوا أو تعذبوا","فإنَّ دموعَ البؤسِ من ثَمَنِ المجدِ",123,"د",1,0],["وما ذلك المرَحُ القدسيّ","وما هاته الضحكة الطاهره",124,"ر",2,0],["وما ذُقتُ فاها وَلَكِنَّني","نَقَلْتُ شهادَةَ عُودِ الأراك",125,"ك",1,0],["وَماذا عَلَيهِ أَن يُجيبَ مُسَلِّماً","وَلَيسَ يُقَضّى بِالسَلامِ ذِمامي",126,"ي",1,0],["وَما ذَكَرَ الدَهرُ العَبوسُ بِأَنَّهُ","لَهُ اِبنٌ كَيَومِ السَبتِ إِلّا تَبَسَّما",127,"م",2,0],["وَماذا عَلَيها لَو أَشارَت فَوَدَّعَت","إِلَينا بِأَطرافِ البَنانِ وَأَومَتِ",128,"ت",1,0],["وَمَاذَا عَلَى مَنْ خَامَرَ الْحُبُّ قَلْبَهُ","إِذَا مَالَ مَعْهُ لِلْخَلاعَةِ وَالْصَّبْوِ",129,"و",1,0],["وَمَا ذَاكَ إِلَّا أَنَّنِي بِتُّ سَاهِراً","وَنَامُوا وَمَا عُقْبَى التَّيَقُّظِ كَالغَفْوِ",129,"و",1,0],["وَمَا ذَاكَ ضَنّاً بِالْوِدَادِ عَلَى امْرِئٍ","حَبَانِي بِهِ لَكِنْ تَهَيَّبْتُ مَقْدَمِي",130,"ي",1,0],["وما ذاكَ عَنْ مالٍ جزيلٍ وإنَّما","كفاني كفافٌ والقناعةُ تغلبُ",131,"ب",1,0],["وما ذاكَ عنْ ذنبٍ جنيتُ وإنما","عنانيَ عرضٌ عنْ مرافعةٍ بكرُ",132,"ر",1,0],["وماذا يشبهُ النحوَ","وإنْ ذمُّوهُ أو غضُّوا",133,"ض",3,1],["وما ذقتُ في عمريَ قهوةً","ولم يُجْلَ لي كأسُها المترعُ",134,"ع",1,0],["وماذا! أأرْوَعُ مِنْ أنْ يَكُون","لَحْمُكَ وَقْفَاً على المِبْضَعِ",135,"ع",1,0],["وَما ذاكَ عَن شَيءٍ أَكونُ اِجتَنَيتُهُ","إِلَيكَ وَما حاوَلتُ سوءً فَيُمنَعا",136,"ع",2,0],["وَما ذاكِ مِن نُعمى لَدَيكِ أَصابَها","وَلَكِنَّ حُبّاً ما يُقارِبُهُ حُبُّ",137,"ب",1,0],["وَما ذاكَ إِلّا أَنَّ خُلقَكَ رائِقٌ","يُهَزُّ كَما هُزَّ الرَحيقُ المُعَتَّقُ",138,"ق",1,0],["وَماذا لَهُم لا أَحسَنَ اللَهُ حِفظَهُم","مِنَ الحَظِّ في تَصريمِ لَيلى حِبالِيا",139,"ي",2,0],["وَما ذاكَ مِن شَيءٍ أَكونُ اِجتَرَمتُهُ","إِلَيها فَتَجزيني بِهِ حَيثُ أَعلَمُ",140,"م",1,0],["وَما ذِقتُهُ إِلّا بِعَيني تَفَرُّساً","كَما شيمَ في أَعلى السَحابَةِ بارِقُ",141,"ق",1,0],["وَما ذاكَ إِلّا حينَ أَيقَنتُ أَنَّهُ","يَكونُ بِوادٍ أَنتِ مِنهُ قَريبُ",142,"ب",1,0],["وماذا للخوارجِ إن أقاموا","لها كيرزونُ أو هارِنْجتُونا",143,"ن",2,0],["وَما ذَنبي إِلَيكَ إِذا تَعامَت","عُيونُ الناقِصينَ عَنِ الكَمالِ",144,"ل",1,0],["وَما ذاكَ خَطبُ القَومِ في مِصرَ وَحدَهُ","فَثَمَّ خُطوبٌ تَستَخِفُّ الرَواسِيا",145,"ي",2,0],["وماذا على الأعداءِ إن قامَ ماجدٌ","يُناضِلُ عن أحسابها ويُنافحُ",146,"ح",1,0],["وماذا عليها حين تكفيكَ أمرَها","وتَرمِي بكَ الأبطالَ والنَّفْعُ مُغْبَرُّ",147,"ر",1,0],["وما ذَرَى هُبَلٌ والطعْنُ يأخُذُهُ","هل غَوَّرَ الدمعُ في عَيْنَيْهِ أم ذَرَفا",148,"ف",2,0],["وماذا كنتَ تحذرُ من عقابٍ","وَوِرْدُ الموتِ مُحتضَرِ السِّجالِ",149,"ل",1,0],["وَما ذَهَبَ الأَصلُ الَّذي أَنتَ فَرعُهُ","وَلا اِنقَطَعَ السَعيُ الَّذي أَنتَ واصِلُه",150,"ل",2,0],["وَما ذاكَ إِلاّ الديكُ شارِبُ خَمرَةٍ","نَديمُ غُرابٍ لا يَمَلُّ الحَوانِيا",151,"ي",2,0],["وَماذا كَثرَةُ الجِيرانِ مُغنٍ","إِذا ما بانَ مَن تَهوى فَسارا",152,"ر",2,0],["وَما ذاكَ مِن سِحرٍ وَلَكِنَّ رِفقَها","إِذا نالَ صَعباً كانَ حَرّانَ سَلَّما",153,"م",2,0],["وَما ذاكَ إِلّا خَدعُ دُنيا وَزُخرُفٌ","وَأَسبابُ إِنفاقٍ لِمالِكَ ماحِقِ",154,"ق",1,0],["وماذا يَرُدُّ السُّورُ عنهم وخلفَهُ","مِنَ الخَيْلِ سُورٌ والصَّوارِمِ سُورُ",155,"ر",1,0],["وما ذُعِرَتْ إلاّ لَجْرسِ حُلِيِّهَا","ولا لَمَحَتْ إلاّ بُرىً من مُخدَّم",156,"م",1,0],["وما ذاكَ إلاّ أنّ ألسُنَنا جَرَتْ","على عادةِ التشبيه في النظمِ والنثر",157,"ر",1,0],["وما ذاك إلاّ أن يُخاضَ بها الرَّدى","فتَنهَشَ تِنّيناً وتَضْغَمَ قَسْوَرا",158,"ر",2,0],["وما ذاكَ أخذاً بالفِراسة وَحدَها","ولا أنّه فيها إلى الظنِّ مضطَرُّ",159,"ر",1,0],["وَما ذاكَ في جَنبِ الأَميرِ وَزَورِهِ","لِيَعدِلَ مِن عَنسي مَدَبَّ قُرادِ",160,"د",1,0],["وَما ذِكرُكَ اللائي مَضَينَ بِراجِعٍ","عَلَيكَ نَوى الجيرانِ حَتّى تَبَدَّدا",161,"د",2,0],["وَما ذاكَ إِلّا حُبُّ خَودٍ تَعَرَّضَت","لِتَقتُلَني بِالمَنظَرِ المُتَباعِدِ",162,"د",1,0],["وَما ذاكَ مِن حَولٍ وَلَكِن كَرامَةٌ","مِنَ اللَهِ يَرعاني بِها كُلَّ مَنهَجِ",163,"ج",1,0],["وَما ذُقتُ طَعمَ النَومِ مُذ مَسَّني الهَوى","وَلا الكَأسَ إِلّا ماؤُها عَبَراتي",164,"ت",2,0],["وَما ذِكرُكِ إِلّا السِح","رُأَ وكَالسِحرِ عُلِّقتُه",165,"ت",2,0],["وَما ذاكَ إِلّا حُبُّ صَفراءَ مَسَّني","فَيَومي بِهِ مُرٌّ وَلَيلي مُوَصَّبُ",166,"ب",1,0],["وَما ذَنبُ مَقدورٍ عَلَيهِ شَقاؤُهُ","مِنَ الحُبِّ عِندَ اللَهِ في سابِقِ الكُتبِ",167,"ب",1,0],["وَما ذاكَ إِلّا أَنَّها حينَ تَنتَهي","تَناهى وَفيها مِن عُبَيدَةَ طيبُ",168,"ب",1,0],["وَماذا يَبتَغي الجُلَساءُ عِندي","أَرادوا مَنطِقي وَأَرَدتُ صَمتي",169,"ي",1,0],["وَما ذَنبُ الضَراغِمِ حينَ صيغَت","وَصُيِّرَ قوتُها مِمّا تُدَمّي",170,"ي",1,0],["وَما ذَنبي إليهم غير أني","إذا خاطبتهم صدق الخطاب",171,"ب",1,0],["وَماذا جَرى حتى تَباين قصدنا","وَحَتى اِختلفنا هَكَذا في الطَبائع",172,"ع",1,0],["وما ذاك بخلاً بالنّفوس على القنا","ولكنّ صدم الشّرّ بالشّرّ أحزم",173,"م",1,0],["وماذا أرجِّي بهذا الدُّعاءِ","وكيف تُلبَّيْنَ واحسرتا",174,"ت",2,0],["وما ذنبُ روحٍ نَمَتْهُ السماءُ","إذا ضجَّ في الأرضِ من سِجنهِ",175,"ه",1,0],["وماذا يفيد الرأيُ لا سيفَ عنده","وماذا يُصيب القولُ يوم طعانِ",176,"ن",1,0],["وما ذلك الظلُّ المَخوفُ بأُفْقِهِ","يُطِلُّ فترتدُّ ارتياعاً كواكبُهْ",177,"ب",2,0],["وما ذاد عنّي النّومَ خوفُ وُثوبِها","ولكنّ جَرْساً حالَ في أُذُنَيْ سِمْع",178,"ع",1,0],["وما ذَنَبُ السِّرْحانِ أبْغَضَ عندَها","على الأيْنِ من هادي الهِزَبْرِ المُرَدَّع",179,"ع",1,0],["وما ذَهَبَتْ إِذ حَصَّلَ القَبْرُ نَفْسَهُ","ولكِنَّما الإِسْلامُ أَدْبَرَ ذاهِبَا",180,"ب",2,0],["وَماذا لَهُم لا أَحسَنَ اللَهُ حالُهُم","مِنَ الحَظِّ في تَصريمِ لَيلى حَبالِيا",181,"ي",2,0],["وَمَاذَا عَلَيْهِمْ إِنْ تَرَنَّمَ شَاعِرٌ","بِقَافِيَةٍ لا عَيْبَ فِيهَا وَلا نُكْرُ",182,"ر",1,0],["وَمَا ذِكْرُ رَيْعَانِ الصِّبَا غَيْرُ حَسْرَةٍ","تَذِلُّ لَهَا نَفْسُ الْعَزِيزِ وَتَخْضَعُ",183,"ع",1,0],["وَمَاذَا عَلَيْهِ وَهْوَ خَالٍ مِنَ الْجَوَى","إِذَا هِمْتُ شَوْقَاً أَوْ تَرَنَّمْتُ بِالشِّعْرِ",184,"ر",1,0],["وَمَا ذَاكَ خَالٌ بَدَا","وَلَكِنْ وِسَامُ التَّرَفْ",185,"ف",1,0],["وَمَا ذِكْرِيَ الأَيَّامَ إِلَّا لأَنَّها","ذِمَامٌ لِعِرْفَان الصِّبَا وَعُهودُ",186,"د",1,0],["وَمَاذَا يَنْفَعُ الأَوْطَانَ نِشْءٌ","إِذَا مَا كَانَ مُعْتَلاًّ جَهُولاَ",187,"ل",2,0],["وماذا عنكِ؟ هل جربت بعدي","من الأهوالِ قاصمة الجبالِ؟",188,"ل",1,0],["وماذا تصنعين بموتِ شمسٍ","هوتْ في الغرب .. يا وَهَج الطلوعِ؟",189,"ع",1,0],["وَماذا عَلَيهِ إِن ذَكَرتُ أَوانِساً","كَغِزلانِ رَملٍ في مَحاريبِ أَقيالِ",190,"ل",1,0],["وماذا على الصبّ لو أنّه","أحلّ من الوصلِ ما حرّما",191,"م",2,0],["وماذا على طالبٍ لذةً","بأيَّةِ جارحةٍ نالَها",192,"ل",3,0],["وماذا يقولُ الشعْرُ والوهْمُ جُهْدُه","وقَدْرُ عَليٍّ يبَهرُ الشعْرَ والوَهْما",193,"م",2,0],["وماذا يقولُ الشِّعْرُ في آيِ رحمةٍ","لها اللّه يُمْلِي والملائكُ تكتُبُ",194,"ب",1,0],["وماذا تركت من الطيِّباتِ؟","تركتَ حروبًا تشيب الوليدا",195,"د",2,0],["وماذا به من وحشةٍ وتجهُّمٍ","وكان به فيضٌ من البشر غامره؟",196,"ر",2,0],["وما ذنبُ طفلٍ تَخُطُّ الحياةُ","له صفحةَ البؤس قبل اللقاء؟",197,"ا",2,0],["وماذا عَلَيْهِ أَن يَقُول محييا","إِلَّا عمم صباحاً أَو يَقُول إِلَّا أسلم",198,"م",1,0],["وماذا عسى بثني فصيح وشاعر","وماذا عسى يحصي كلام مزخرف",199,"ف",1,0],["وما ذهبت إذ حل في القبر نفسه","ولكنما الإسلام أدبر ذاهبا",200,"ب",2,0],["وما ذلك الظّل المخوف بأفقه","يطلّ فترتدّ ارتياعا كوكبه ! ؟",201,"ب",2,0],["وماذا غيَّرتْ نظمٌ وهذي","حياتُكَ جُلُّ ما فيها شقاء",202,"ا",2,0],["وماذا ترجي أنسٌ لا يَسُرهُّا","سوى الشعبِ مسروراً وماذا تؤمّل",203,"ل",1,0],["وما ذاك من ظلم الطبيعة أن ترى","شجياً، ولكن كي ترى الحزن مثلما",204,"م",2,0],["وما ذاك إلاّ كالمؤدّي رسالةً","رأى كَتْمَها حَيْفاً بها فأذاعا",205,"ع",2,0],["وماذا تُرَجِّي من بلاد بشعرة","تُقاد ، وشَعب بالمضلِِّّين يَهتدى",206,"د",2,0],["ومأذن على خصييه إذنا","يعم وإن تعمق في الحجاب",207,"ب",1,0],["وما ذاك إلا عقابُ امرىء ٍ","رأى السيفُ من حَيده موضعه",208,"ع",2,0],["وَما ذَاكَ مِنْ شَيْءٍ أَكُونُ کجْتَنَيْتُهُ","إلَيْكَ وَمَا حَاوَلْتُ سُوءاً فَيُمْنَعا",209,"ع",2,0]]}