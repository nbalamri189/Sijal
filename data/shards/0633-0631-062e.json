{"poems":[[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54284","الخفيف"],[228,"رن رن ألو مركز القلب","https://www.aldiwan.net/poem41902.html","المجتث"],[563,"كلام أهل الله في","https://www.aldiwan.net/poem34623.html","مجزوء الرجز"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103096","الكامل"],[2565,"","https://poetry.dctabudhabi.ae/diwan/poem/103755","الكامل"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35444","الكامل"],[5007,"مخالب الظّل","https://www.poetsgate.com/ViewPoem.aspx?id=177932",""],[5136,"قمر أهل على الغصون من البكور","https://www.poetsgate.com/ViewPoem.aspx?id=121576",""],[5786,"إن كنتَ لي صاحباً قِف لي بهبود","https://www.poetsgate.com/ViewPoem.aspx?id=50651",""]],"verses":[["سِرْ خفِيفاً معَ النَسائِمِ وَابْعَثْ","نَفَساً يَمْلأُ الْفَضَاءَ مَدِيدا",0,"د",2,0],["سرٌّ خَفِيٌّ ثَوى في","ضَمير هذا الوُجودِ",1,"د",1,0],["سر خفي خارج","من الفؤاد للفؤادْ",2,"د",1,0],["سر خفي في وجودك ظاهر","في كل شيء كان سرك كامن",3,"ن",1,0],["سرخ لحاظك حيث شئت فإنه","في كل موقع لحظة متأمل",4,"ل",1,0],["سِرٌّ خَفي لَم يَكُن أَحَدٌ لَهُ","غَيرُ النَبِيِّ مِنَ البَرِيَّةِ قابِلا",5,"ل",2,0],["سرْ خَلْفَ ظلّك إنّه غدّارُ","لا ينفع الحذرَ الشّديد نَهارُ",6,"ر",1,1],["سر خلفه إن عاد واصعد إن رقا","صعداً وحلق إن ثوى في طور",7,"ر",1,0],["سرٌّ خفيٌّ جليلٌ لا يُحاطُ بهِ","ولا يقاسُ بتمثيلٍ وتحديدِ",8,"د",1,0]]}