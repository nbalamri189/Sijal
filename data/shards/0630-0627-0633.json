{"poems":[[57,"ِذا سَرَّها أَمرٌ وَفيهِ مَسَاءَتي","https://www.poetsgate.com/ViewPoem.aspx?id=7718",""],[182,"سرادق","https://www.aldiwan.net/poem50691.html","الخفيف"],[469,"ظبيات الحمى تخيف الأسودا","https://www.aldiwan.net/poem3169.html","عموديه"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53784","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77622","الرجز"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136272","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126232","الخفيف"],[3307,"","https://poetry.dctabudhabi.ae/diwan/poem/145539","الخفيف"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77035","الرمل"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45066","المجتث"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133071","الرجز"],[5002,"هلال وحدتنا...","https://www.poetsgate.com/ViewPoem.aspx?id=206180",""],[5596,"وادي محرم","https://www.poetsgate.com/ViewPoem.aspx?id=206487",""],[5810,"ِذا سيقَ تِبرٌ إِلى مَسمعٍ","https://www.poetsgate.com/ViewPoem.aspx?id=6063",""]],"verses":[["ِذا سَرَّها أَمرٌ وَفيهِ مَسَاءَتي","قَضَيتُ لَها فيما تُحِبُّ عَلى نَفسي",0,"ي",1,1],["ذا سَعيري أقامَ بي وابتداني","وعلى نعشٍ منْهُ كانَ خِتامي",1,"م",2,0],["ذا سماحٍ يعيد غصن الصبا","غضاً وبأسٍ يشيب المولودا",2,"د",2,0],["ذا سَنةٍ آمن ما يروعهْ","حتى دنت منه لحتف تزمعهْ",3,"ع",2,0],["ذا سَيّدي يشهر عُرساً لابنته","وَيَمتلي جسميَ مِن وَليمَته",4,"ه",1,0],["ذا سبيل الوصول في كل معنى","ذا مجال الدنو والاتصال",5,"ل",1,0],["ذا سعيري مؤججٌ وحميمي","لعصاةِ الرحمنِ ينتظرانِ",6,"ن",1,0],["ذا سُعُود ونَجمُهُ قد تَهَلاَّ","وعليه إن ذَلّ عينُ من اللّ",7,"ل",1,0],["ذا سمي لمصطفيه وهذا","لإماميْ هدى سمي كني",8,"ي",1,0],["ذا سَبيل النَجاة وَالفَوزُ فيما","تَرتَجيهِ فَكُن بِهِ مُتَمَسِّك",9,"ك",1,0],["ذا سيرَةٍ بِهُداها","عِداهُ طَوعاً أَقَرّوا",10,"ر",3,0],["ذا سير من ساد الورى جميعه","صلى عليه الله بالتوالي",11,"ي",1,0],["ذا سؤدد لم نفرط فيه في الملل","نرعاه... والله منجينا من الدَّجل",12,"ل",1,0],["ذا(سالم بن سليمان) الذي رفعت","(بهلانُ) هاماً به بين البريّات",13,"ت",1,0],["ِذا سيقَ تِبرٌ إِلى مَسمعٍ","تَعثَّرَ خالِصهُ في الرَّغام",14,"م",1,1]]}