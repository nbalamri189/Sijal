{"poems":[[36,"ألبنى لقد جلت عليك مصيبتي","https://www.aldiwan.net/poem4905.html","الطويل"],[88,"ما لي أرى الأكمام لا تفتح","https://www.aldiwan.net/poem10674.html","الرجز"],[39,"ألا لا أرى الأيام يقضى عجيبها","https://www.aldiwan.net/poem6494.html","الطويل"],[49,"ضلال مارأيت من الضلال","https://www.aldiwan.net/poem25209.html","الوافر"],[53,"يا أحمد بن سعيد لا تمت جزعا","https://www.aldiwan.net/poem65873.html","البسيط"],[41,"لحى الله قوما أسلموا يوم بابل","https://www.aldiwan.net/poem53758.html","الطويل"],[302,"وسائل لي عن أشياء كيف أتت","https://www.aldiwan.net/poem33338.html","البسيط"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126733","الوافر"],[816,"","https://poetry.dctabudhabi.ae/diwan/poem/107114","الرجز"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63897","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62509","السريع"],[1054,"","https://poetry.dctabudhabi.ae/diwan/poem/145939","البسيط"],[1910,"","https://poetry.dctabudhabi.ae/diwan/poem/116542","الوافر"],[2186,"","https://poetry.dctabudhabi.ae/diwan/poem/124187","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27936","البسيط"],[2607,"","https://poetry.dctabudhabi.ae/diwan/poem/34885","الرجز"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74072","المتقارب"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66442","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59508","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135790","الرجز"],[4717,"النمل .. وأزمة السكر","https://www.poetsgate.com/ViewPoem.aspx?id=199650",""],[4767,"موسم الأمطار","https://www.poetsgate.com/ViewPoem.aspx?id=180857",""],[4927,"أبناء السحالي","https://www.poetsgate.com/ViewPoem.aspx?id=80797",""],[4984,"الْعَرَبَةُ","https://www.poetsgate.com/ViewPoem.aspx?id=201917",""]],"verses":[["فَقائِلَةٌ جِئنا إِلَيهِ وَقَد قَضى","وَقائِلَةٌ لا بَل تَرَكناهُ يَنزِعُ",0,"ع",1,0],["فَقائِلٌ لا تَعجَلوا إِنَّكُم","مَكانَكُم بِالأَمسِ لَم تَبرَحوا",1,"ح",3,0],["فقائبة ما نحن يوماً وأنتم","بني عبد شمس أن تفيئوا وقوبها",2,"ب",3,0],["فَقائِلَةٍ تَقولُ أَبا فِراسٍ","أُعيذُ عُلاكَ مِن عَينِ الكَمالِ",3,"ل",1,0],["فقائلٌ لك قولاً لا أطوّلُهُ","وفي الأقاويل تقصيرٌ وتطويلُ",4,"ل",1,0],["فَقائِلَةٌ تَنعى يَزيدَ وَقائِلٌ","سَقى اللَهُ جَزلَ السَيبِ عَفَّ الخَلائِقِ",5,"ق",1,0],["فَقائِلٌ إِنَّها في الأَصلِ شَيّاءُ","كمثل حَلفاء وَزناً فهيَ فَعلاءُ",6,"ا",2,0],["فَقائدنا المُرجّى خير نجلٍ","لخيرِ أبٍ تطالعهُ السعودُ",7,"د",1,0],["فقائماً وراكعاً وساجداً","مبتهلاً مستعبراً مستغفرا",8,"ر",2,0],["فَقائسُ غيرِكُمْ بكمُ كأعمى","يقيسُ من العمى غيرَ المقيس",9,"س",1,0],["فقائم في ذا بحق العُلا","وقائم في ذا بحق الهُدى",10,"د",2,0],["فَقَائِماً تأنفَ الأبصارُ مَنظرَها","لكنْ بها لِذوي الألباب مُعتَبَرُ",11,"ر",1,0],["فقايسكم إِلى نفرٍ سواكُم","يقيس الزاخرات إِلى الركايا",12,"ا",3,0],["فقائل ناكني فلان","ونكته لا له ولا لي",13,"ل",2,0],["فقائل إنَّ هذا الحكمَ ليس لها","وقائل حكم هذا من كوكبها",14,"ب",3,0],["فَقائِلٌ قَد قَتَلوا","أَلفاً وَلَمّا يَزِدِ",15,"د",1,0],["فَقائلة أنّ حَظّي عَفا","وَقائلة إِنَّني عافيَه",16,"ي",2,0],["فقائله لم يخل من كيد حاسدٍ","وقارئه مستسلم لأذى الضدِّ",17,"د",1,0],["فقائلٌ ظعنت عن سفح معقلةٍ","وقائل لم ترم والشَّمل ملمومُ",18,"م",1,0],["فقائماً وقاعداً جثيّا","وضُعَفا وظالماً عتيّا",19,"ي",2,0],["فقائلُهم : قيِّدُوا بالسلاسلْ","وآخرُ : نضْربُهمْ بالقنابلْ",20,"ل",1,0],["فقائد على الرصيف تارةً","وتارةً قد حك في الجدار",21,"ر",1,0],["فَقَاْئِدُهُمْ بِأَرْضِ الدَّيْرِ لِصٌّ","وَفِيْ الْجَوْلاْنِ يُضْرَبُ بِالنِّعَاْلِ",22,"ل",1,0],["فقايضت كسبهم وارتد من صَدَّقُوا","وُعُودَ أقطابهم من مَزْعَمِ الكذبة",23,"ب",2,0]]}