ُحَلِّقُ",244,"ق",1,0],["وَرَدَّ يَدي عَن حرِّ وَجهي حَياؤُهُ","فَإِن كانَ لَم يَخدِش فَفي قَلبيَ الخَدشُ",245,"ش",1,0],["وَرَدَّ بِالمَجْمَعِ المَعْمُورِ غُرْيَتَهَا","وَحَاطَها بِكَرِيمِ العَطْفِ والْحَدَبِ",246,"ب",1,0],["وردّ إلى العُرْب الحَياة وقد مضى","عليهم زمانٌ والأمامُ وَراءُ",247,"ا",2,0],["وردّ إلى أهلي حياةً عزيزةً","وبدّلهم من بُؤسِ أيامِهم نُعْمى",248,"م",2,0],["ورَدَ القلوب حقيقةً ملموسةً","وأتى العقولَ؛ فكان سرًّا مُبهما",249,"م",2,0],["وردُ الرُّبا متألِّقٌ في سطحها","والفلُّ منتشرٌ على جنباتها",250,"ت",3,0],["وَرَدَا على دار النّعيمِ وُحُورِها","كَلَفاً بِبِرِّهما يَزِدْنَ تَرَحُّبا",251,"ب",2,0],["وردية الوجناتِ يختبر اسمها","من ربقها من لا يحيط بخبرها",252,"ر",3,0],["وَرَدتُ عن ظمأٍ ماءً غَصِصتُ به","فليتَ أنَّيَ لم أظَمأْ ولم أرِد",253,"د",1,0],["ورُدَّت على الأعقاب زَحفاً معاشرٌ","تُحاولُ عَودْاً من حِطامٍ مركَّم",254,"م",1,0],["وردد لي همس الطبيعة نغمة","من الشعر ما كانت سوى خاطر خطر",255,"ر",1,0],["وردَدْتُ بالنغَمِ الجميلِ لأرزه","ظِلاًّ أفاءَ به عليَّ ظَليلا",256,"ل",2,0],["ورد المصلى في جلال معظَّمٍ","ووقارِ مخشع وسمت منيب",257,"ب",1,0],["ورُدَّتْ كُلُّ صالحة ٍ عليهمْ","وكانتْ قبل ذلك تُسْتردُّ",258,"د",1,0],["وردة ٌ إذ لجَّ صنَّبرُها","تَحْتَ شَفَّانِ شَباً ذِي سِجَامْ",259,"م",1,0],["وردْفٌ له ثِقْلٌ وَقدٌّ مُهَفْهَفُ","وخدٌّ به وَرْدٌ وساقٌ خَدَلَّجُ",260,"ج",1,0]]}