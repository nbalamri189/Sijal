,"ل",1,0],["وَرَدَتكَ أَرسالاً تَطوفُ ظِماؤُها","بِدَمِ الجَبينِ تُعَلُّ مِنهُ وَتُنهَلُ",177,"ل",1,0],["وَرُدّوا النُفوسَ إِلى رَبِّها","وَعودوا إِلى دينِهِ القَيِّمِ",178,"م",1,0],["وَرَدَّ عِزَّكَ ذلّاً","فما تُصَعِّرُ خَدَّكْ",179,"ك",1,0],["وَرد الدِّينَ صافياً ما يُضاهي","هِ لمن يَبْتَغِي السَّلامةَ وِرْدُ",180,"د",1,0],["ورَدَّ اللَّه غُربتَهم وفازوا","بنعمته فنعمَ ذوو العلاء",181,"ا",2,0],["وَرَدتُ وَصَدَّقتُ عِندَ الصُدورِ","حَديثَ قُلوبٍ نَأَت عَن صُدورِ",182,"ر",1,0],["وِرداً فَمَضمونٌ نَجاحُ المَصدَرِ","هِيَ عِزَةُ الدَنيا وَفَوزُ المَحشَرِ",183,"ر",1,1],["وَردة تبهر العُيون وَلَكن","كثرةُ الشمِّ قَد أَضاعَت شَذاها",184,"ا",3,0],["وَرَدّوا خَيلَ تُبَّعَ في قُدَيدٍ","وَساروا لِلعِراقِ مُشرِقينا",185,"ن",2,0],["وَرَدَةٌ إِذا لَجَّ صِنَّبرُها","تَحتَ شَفّانِ شَباً ذي سِجام",186,"م",1,0],["وَرَدَ العُفاةُ المُعطِشونَ وَأَصدَروا","رِيّاً وَطابَ لَهُم لَدَيكَ المَكرَعُ",187,"ع",1,1],["وَرَداً وَقَد نَفَضا المَراقِبَ عَنهُما","وَالماءُ لا سُدُمٌ وَلا مَحضورُ",188,"ر",1,0],["وَرَدَت عَلَيَّ هُمومُها","وَلِكُلِّ وارِدَةٍ مَصادِر",189,"ر",1,0],["وَرَدُّ الشَيبِ بِالخَضبِ","وَما لِلشَيبِ مِن رَفوِ",190,"و",1,0],["وَرُدّوا دُموعَ الشَوقِ بَينَ جُفونِهِ","يُفِق رَو فَرُدَّ لَحمَهُ فَوقَ أَعظُمِ",191,"م",1,0],["وَرُدَّت إِلَينا الشَمسُ تَرفُلُ في الدُجى","فَكانَ لِسِترِ اللَيلِ مِن نورِها هَتكُ",192,"ك",1,0],["وَرَدَّ عَلَيَّ الدَهرُ حَدَّ سِلاحِهِ","فَقَطَّعَني جَرحاً وَأَوجَعَني عَضّا",193,"ض",2,0],["وَرِدفاً كَظَهرِ التُرسِ أُسبِلَ خَلفَهُ","عَسيبٌ كَفَيضِ الطَودِ لَمّا تَحَدَّرا",194,"ر",2,0],["وَرَدَّ عَلَيهِ ما لَهُ دونَ غَيرِهِ","فَإِن كُنتَ ذا جَهلٍ فَسَل كُلَّ ذي خُبرِ",195,"ر",1,0],["وَرَدوا الحَربَ فَمَدّوا","كُلَّ خَطِّيٍّ مَديدِ",196,"د",1,0],["وَرَدَّ عَلِيّاً إِلى قُربِهِ","كَما رَدَّ بازٍ إِلَيهِ جَناحا",197,"ح",2,0],["وَرَدَدنا الرُمحَ مُختَضِباً","لِدِماءِ الوَحشِ شَرّابا",198,"ب",2,0],["ورَدَّ الفيلَ والأحزابَ طَيْرٌ","وريحٌ ما يُطاقُ لها هُبُوبُ",199,"ب",1,0],["وَرَدَّ أَلْفَيْنِ فِي رِيٍّ وَفي شِبَعٍ","إِذْ ضاق باثْنيْنِ مَشْرُوبٌ ومَأْكُولُ",200,"ل",1,0],["وَردَّ ماءَ ونُوراُ بَعْدَ ما ذَهَبا","رِيقٌ لهُ بِكِلا العَيْنَينِ مَتْفُولُ",200,"ل",1,0],["ورَدَّ أوْجُهَهُمْ سُوداً وأعْيُنُهُمْ","بِيضاً مِنَ اللهِ تَنكيدٌ وَتَنْكِيلُ",200,"ل",1,0],["ورَدَّ حقوقَ الطالبيّينَ مَن زكَتْ","صنائعُه في آلهِ وزكا الذُّخر",201,"ر",1,0],["ورُدَيْنِيّاً هَزَزْنَا مَتْنَهُ","فَتَثَنّى ساعَةً ثم انْقَصَد",202,"د",1,0],["وَرداً إذا ألقَى على أكتادِهِ","لِبْداً وصرّ بحَدّ نابٍ نابَا",203,"ب",2,0],["وَرِدفُ ظَبيٍ إِذا اِمتَطَيتَ بِهِ","أَعطاكَ بَينَ التَقريبِ وَالخَبَبِ",204,"ب",1,0],["وَرِدفُهُ في قَضيبٍ فَوقَهُ قَمَرٌ","مِن نورِ خَدَّيهِ ماءُ الحُسنِ يَنسَكِبُ",205,"ب",1,0],["وَرَدنا عَلى هاشِمٍ مِصرَهُ","فَبارَت تِجارَتُنا عِندَه",206,"د",2,0],["وَرَدَدتَ ما كُنتَ اِستَعَر","تَ مِنَ الشَبابِ إِلى المَعيرِ",207,"ر",1,0],["وَرِدفُها كَالكَثيبِ نيطَ إِلى","خَصرٍ رَقيقِ اللِحاءِ مَمشوقِ",208,"ق",1,0],["وردفهُ حين يمشي","يُخشى عليها التكسّر",209,"ر",1,0],["وَرَدَت هُمومُكَ يَومَ صاعِد","وَتَعَرَّضَت لَكَ بِالأَجالِد",210,"د",1,1],["وَرَدتُ إِذا اِلتاثَ الهِجانُ وَقَد خَوى","عَلَيهِ مِنَ الظَلماءِ بَيتٌ مُطَنَّبُ",211,"ب",1,0],["وَرُدَّت مَطايا الراغِبينَ وَعُرِّيَت","جِيادُكَ لا يُحفي لَها الدَهرُ حافِرا",212,"ر",2,0],["وَرَدَ القَومَ بَعدَما ماتَ كَعبٌ","وَاِرتَوى بِالنُمَيرِ وَفدٌ ظِماءُ",213,"م",3,0],["وَرَدنا بِلا وَفرٍ دِيارَ حَياتِنا","وَنَترُكُ فيها يَومَ نَرتَحِلُ الوَفرا",214,"ر",2,0],["وَرَدتُمُ الآجِنَ مِن دينِكُم","وَما ظَفِرتُم بِالصَريحِ النَمير",215,"ر",1,0],["وَرَدتُ إِلى دارِ المَصائِبِ مُجبَراً","وَأَصبَحتُ فيها لَيسَ يُعجِبُني النَقلُ",216,"ل",1,1],["وَرَدنا إِلى الدُنيا بِإِذنٍ مَليكِنا","لِمَغزىً وَلَسنا عالِمينَ بِما غُزي",217,"ز",2,0],["وردّوا إليكَ الرُّسْلَ والصّلحُ مُمْكنٌ","وقالوا على غيرِ القِتالِ سلامُ",218,"م",1,0],["ورِدُّها مُتَّصلٌ برِدِّ","يُمدُّه بحرٌ عظيمُ المَدِّ",219,"د",1,0],["وردَّه إلى الحُصونِ ثانياً","مُسجّلاً له علَيها والِيا",219,"ي",2,0],["وَرديَّةٌ يَحملُها شادنٌ","في مُشْرَبِ الحمرةِ وَرْدِيِّ",220,"ي",1,1],["وردنا الرّهمية في جوزه","وباقيه أكثر ممّا مضى",221,"ا",1,0],["وردت بلادك غير