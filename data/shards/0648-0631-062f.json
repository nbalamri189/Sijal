"خَطْبٌ ألمَّ فأذْهبَ الأخ والأبا","https://www.poetsgate.com/ViewPoem.aspx?id=33306",""],[56,"أنظر إلى شمس القصور وبدرها","https://www.poetsgate.com/ViewPoem.aspx?id=11349",""],[90,"بنت بيروت","https://www.poetsgate.com/ViewPoem.aspx?id=179192",""],[90,"يدي هذه رهن","https://www.poetsgate.com/ViewPoem.aspx?id=179108",""],[90,"في الليل","https://www.poetsgate.com/ViewPoem.aspx?id=178935",""],[90,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[80,"من كان يعذب عندها تعذبني","https://www.poetsgate.com/ViewPoem.aspx?id=3020",""],[51,"خبا نَحْسٌ وأعقب منه سعْد","https://www.poetsgate.com/ViewPoem.aspx?id=28470",""],[39,"شتَّ شعبُ الحيِّ بعدَ التئامْ","https://www.poetsgate.com/ViewPoem.aspx?id=4269",""],[3,"أشاقكَ مِنْ عَبلَ الخَيالُ المُبَهَّجُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10663&r=&rc=17",""]],"verses":[["وَرَدنَ وَلا دِلاءَ لَهُنَّ إِلّا","مُشافِرُهُنَّ في الوِردِ الجَمومِ",0,"م",1,0],["وَرَدَدتَهُ بِالقَولِ لَيسَ بِخُلَّبٍ","في عَقبِهِ وَالوَعدُ غَيرُ جَهامِ",1,"م",1,0],["وَرِداءَ الفَجرِ مُنسَحِبٌ","وَنِطاقَ اللَيلِ مَسدولُ",2,"ل",1,0],["وِردٌ وَمَرعىً إِذا شاءَت مَشافِرُها","مُستَجمِعانِ وَلا كَدٌّ وَلا عَمَلُ",3,"ل",1,0],["وَرَدنا بِها بَينَ العُذَيبِ وَضارِجٍ","تَريكَةَ جونٍ أَسأَرَتها البَوارِقُ",4,"ق",1,1],["وَرِدي حِياضَ فَتى مَعَدٍّ كُلُّها","فَالحَبلُ أَتلَعُ واّلقَليبُ عَميقُ",5,"ق",1,0],["وَرُدّوا أَكُفَّ الحَربِ حِلماً عَنِ العِدى","إِذا أَمكَنَت حَدَّ السُيوفِ المَقاطِعُ",6,"ع",1,0],["وَرَدتُ بِهِ بُحبوحَةَ الوِردِ فَاِنثَنى","يُقَلِّصُ صافي مائِهِ في المَشافِرِ",7,"ر",1,0],["وَرِد غَمرَةَ العِزِّ بَينَ الرِماحِ","وَاِحجُر عَلى الماءِ في الحاجِرِ",8,"ر",1,0],["وَرَدَدتَ أَعطافَ الظُبى","تَختالُ في العَلَقِ الغَزيرِ",9,"ر",1,0],["وَرَدوا وَإِنّي بَعدَهُم كَظَمِيَّةٍ","تَسَلُ القَوارِبَ عَن بُلوغِ المَشرَبِ",10,"ب",1,0],["وَرَدنَ بِها ماءَ الظَلامِ سَواغِباً","وَلِلَّيلِ جَوٌّ بِالدَرارِيِّ مُعشِبُ",11,"ب",1,0],["وَرَدنَ مِنكَ سَحاباً غَيرَ مُنتَقِلٍ","عَنِ البِلادِ وَبَدراً غَيرَ مَحجوبِ",12,"ب",1,0],["وَرَدَ الزَمانُ بِهِ وَأَورَدَهُ الرَدى","بَغياً فَأَحسَنَ مَرَّةً وَأَساءَ",13,"ا",2,0],["وَرَدَّدْنَ أَنْفاسَاً تُقَدُّ مِنَ الحَشَى","وَتَدْمَى فَلَمْ يَسْلَمْ لِغَانِيَةٍ عِقْدُ",14,"د",1,0],["وَرَدُوا المَوْتَ ظِماءً","تَحْتَ أَظْلالِ الرِّماحِ",15,"ح",1,0],["ورَدوا نَداكَ فأصْدَرَتْ نَفَحاتُهُ","عنكَ المُقِلَّ يَجُرُّ ذَيْلَ المُكْثِر",16,"ر",1,0],["ورُدَّتْ صُدورُ الخَيلِ وهْيَ سليمةٌ","كما سَلِمَتْ في الرّوْعِ منْهُنَّ أكْفالُ",17,"ل",1,0],["وَرِدفٌ لَهُ ثِقلٌ وَخَصرٌ مُهَفهَفٌ","وَخَدٌّ بِهِ وَردٌ وَساقٌ خَدَلَّجُ",18,"ج",1,0],["وَرَدتُ الحَربَ وَالأَبطالُ حَولي","تَهُزُّ أَكُفُّها السُمرَ الصِعادا",19,"د",2,0],["وَرَدتُ وَبَعضُ الوِردِ فيهِ مَرارَةٌ","حِياضَ الهَوى مِن كُلِّ أَفيَحَ مُترَعِ",20,"ع",1,0],["وردّهُ ردَّ ثَمو","دٍ والفَصيلُ قدْ رَغا",21,"غ",2,0],["وَردَّنِي لِبِلاَدِي شَاكِراً لَكُمُ","بِأَمْرِ رَبِّي بَيْنَ الْكَافِ وَالنُّونِ",22,"ن",1,0],["وَردَّ النَّسيمُ لَهَا بِنَشْرِ حَدِيقَةٍ","قَدْ أَزْهَرَتْ أَفْنَانُهَا بِفُنُونِ",23,"ن",1,0],["وَرَدَت عَلى سَعدِ بنِ قَي","سٍ ناقَتي وَلِما بِها",24,"ب",3,0],["وَرَدتُ عَلَيها الريفَ حَتّى شَرِبتُها","بِماءِ الفُراتِ حَولَنا قَصَباتُها",25,"ت",3,0],["وَرَدوا الحَوضَ تِباعاً فَقَضَوا","بِاِتِّفاقٍ في مَناياهُم عَجيبِ",26,"ب",1,0],["وَرِدوا بي مَناهِلَ العِزِّ حَتّى","يَخطُبَ النَجمُ في المَجَرَّةِ وُدّي",27,"ي",1,0],["وَرُدّوا عَلى المُلكِ الشَبابَ الَّذي ذَوى","فَإِنّي رَأَيتُ المُلكَ شابَت ذَوائِبُه",28,"ب",2,0],["وَرَدّوا عَلى الإِسلامِ عَهدَ شَبابِهِ","وَمَدّوا لَهُ جاهاً يُرَجّى وَيُرهَبُ",29,"ب",1,0],["وَرَدَ الحَياةَ عَزيزَةً","فَنَجا وَكانَ المَوتُ وِردا",30,"د",2,0],["وَرَدَ الكِنانَةَ عَبقَرِيُّ زَمانِهِ","فَتَنَظَّري يا مِصرُ سِحرَ بَيانِهِ",31,"ن",2,1],["وَردٌ تَأَلَّقَ في ضاحي مَنابِتِهِ","فَازدادَ مِنهُ الضُحى في العَينِ إِشراقا",32,"ق",2,0],["وَرَدتُ مَعينَ الطَبعِ إِذ ذيدَ دونَهُ","أُناسٌ لَهُم في حَجرَتَيهِ لُوابُ",33,"ب",1,0],["وَرَدَّ الشَبابَ اِعتِلاقُكَ بَعدَ","مُفارَقَتي ظِلَّهُ الأَبرَدا",34,"د",2,0],["وَرَدَّدتُ لَحظِيَ في غُرَّةٍ","إِذا اِجتُلِيَت شَفَتِ الأَرمَدا",34,"د",2,0],["وَرِدِ الصُبحَ فَكَم مُستَوحِشٍ","غَرِضٍ مِنكَ إِلى أُنُسِ الصَدَر",35,"ر",1,0],["وَرَدنَ دَوارِعاً وَخَرَجنَ شُعث","كَأَمثالِ الرَصائِعِ قَد بَلينا",36,"ن",2,0],["وَرَدَّ مِن جَزَعٍ ما كُنتُ أَعرِفُها","وَرامَ تَكليمَها لَو تَنطِق الإِبِلُ",37,"ل",1,0],["وَرَدتَ عَلى فُرّاطِهِم فَدَهَمتَهُم","بِأَخطارِ مَوتٍ يَلتَهِمنَ سِجالَها",38,"ل",3,0],["وَرَدنَ بُصاقاً بَعدَ عِشرينَ لَيلَةً","وَهُنَّ كَليلاتُ العُيونِ رَكائِكُ",39,"ك",1,0],["وَرْدَةٌ خَيْرُ وَرْدَةٍ نَبَتَتْ","نَبْتَ حُسْنٍ فِي خَيْرِ بُسْتَانِ",40,"ن",1,0],["وَرَدَّ عَلَى القُرْآنِ مُحْكَمَ رَسْمِهِ","كَمَا خَطَّهُ فِي سَالِفِ الدَّهْرِ عُثْمَانُ",41,"ن",1,0],["وَرْدٌ تَحَوَّلَ جَمْراً","بِمَلمَسِ الْفَاسِقِينَا",42,"ن",2,0],["وَرُدَّ عَنْ سَرَفٍ فِي الْغِيِّ مُغْتَصِبٌ","وَصُدَّ عَنَّ سَرَفٍ فِي البَغْيِ مًحْتَكِمُ",43,"م",1,0],["وَرَدَتْ وَآبَتْ بِالجِرَارِ مَلِيئَةً","ثيوشِكْنَ أَنْ يَقْطُرْنَ فَوْقَ الهَامِ",44,"م",1,0],["وَرَدناهُ في مَجرى سُهَيلٍ يَمانِياً","بِصُعرِ البُرى ما بَينَ جَمعٍ وَخادِجِ",45,"ج",1,1],["وَرَدتُهُ قَبلَ القَطا الأَرسالِ","وَقَبلَ وِردِ الأَطلَسِ العَسّالِ",46,"ل",1,0],["وَرَدتُ وَأَغباشُ السَوادِ كَأَنَّها","سَماديرُ غَشيٍ في العُيونِ النَواظِرِ",47,"ر",1,0],["وَرَدتُّ وَأَردافُ النُجومِ كَأَنَّها","وَراءَ السِماكَينِ المَها وَاليَعافِرُ",48,"ر",1,0],["وَرَدتُ وَأَردافُ النُجومِ كَأَنَّها","قَناديلُ فِيهِنَّ المَصابِيحُ تَزهَرُ",49,"ر",1,0],["وَرَدتُ بَينَ الهَبِّ وَالهُجودِ","بِأَركُبٍ مِثلِ النَشاوى الغيدِ",50,"د",1,0],["ورد الكتاب بفضلكم وكمالكم","فكفى ثناء الواحد الخلاّقِ",51,"ق",1,0],["وردوا ورود الهيمِ أجهدها الظما","فَصَفَا لهم من وِردِ كفك منهلُ",52,"ل",1,0],["ورِدْ ما يُناديك عنه الصُدُور","ألا دَرّ درّك من وارد",53,"د",1,0],["وردّد مجرى الرافدين لصوتها","صدى الحزن من أقصى العراق إلى الأدنى",54,"ن",2,0],["وِردَ القَطا زُمَراً تُبادِرُ مَنعِجاً","أَو مِن خَوارِجَ حايِراً مَورودا",55,"د",2,0],["وَرَدتُم عَلى قَيسٍ بِخورِ مُجاشِعٍ","فَبُؤتُم عَلى ساقٍ بَطيءٍ جُبورُها",56,"ر",3,0],["وَرَدتُ مِياهَهم صادِياً","بِحَائِمَةٍ وِردَ مُستَعذِبِ",57,"ب",1,0],["وَرَدَت بُعَيدَ الفَوتِ أَرضَكَ خَيلَهُ","سَرعى كَأَمثالِ القَطا أَرسالا",58,"ل",2,0],["وَرَدَت مِنكَ يا اِبنَ عَمّي هَدايا","تَتَهادى في سُندُسٍ وَحَريرِ",59,"ر",1,0],["وَرَدَّ اِبنَ مَزروعٍ يَنوءُ بِصَدرِهِ","وَفي صَدرِهِ مالاتَنالُ المَسابِرُ",60,"ر",1,0],["وَرَدّاهُ حَتّى مَلَّكاهُ سَريرَهُ","بِعِشرينَ أَلفاً بَينَها المَوتُ سافِرُ",60,"ر",1,0],["وَرُدَّ سَراةُ الأَوسِ إِذ جاءَ جَمعُهُم","بِطَعنٍ كَأَفواهِ المُخَيَّسَةِ الهُدلِ",61,"ل",1,0],["ورد الرّدى عن فائض البرّ عنده","أعزّ مكان في الدنى سرح سائح",62,"ح",1,0],["وردِي لثمُ الخدِّ لا كأسه","فلستُ للكأسِ بورَّاد",63,"د",1,0],["وردت على الباب الجماليّ قاصداً","فجادَ ولاقى مقصدي بأياد",64,"د",1,1],["ورُدَّت جيوش الفيل عن دار قومه","فلله نصلٌ قبل ما سُلَّ ينصرُ",65,"ر",1,0],["وردٌ مع العرب منسوبٌ فلا قطعت","أيدي الحوادث من أعراقه أثره",66,"ر",2,0],["ورد نعماك إليَّ الرَّجا","فأنتَ شمسي والرَّجا يوشعي",67,"ع",2,0],["وردتم شجوني إلى أن عفت","كما أنضج الشيء حتى احترق",68,"ق",1,0],["وردَّتْ ماءَ وجهي بعد ظِمْءٍ","وسودَ غدائري بعد المشيبِ",69,"ب",1,0],["وَرَدْتَ على رَشَدٍ دارَها","وفتَّحتَ باليُمن أبوابَها",70,"ب",3,0],["ورددتَ غُمضاً صدَّ عَنْ","طَرْفِ المُتيَّم مذ صددتا",71,"ت",2,0],["وردوا مناهِلَه فَمَاحُوا واسْتَقَوْا","منهنّ أعذبَ مُسْتقىً وَمُمِيحِ",72,"ح",1,0],["وَرِدْهُ الغَبَّ والرِّفْهَ","فحاشاهُ مِن النَّزْحِ",73,"ح",1,0],["وَرُدَّ كلُّ تَميمٍ كان ينْفُثُهُ","راقي الوُشاةِ فَعَضُّوا بالجلاميدِ",74,"د",1,0],["وردةِ اللون في خدود الندَامى","هي صفراء في خدود الكؤوس",75,"س",1,0],["وردَّ بناء الملكِ سوراً مشيَّداً","وقد بقيت منه رسومٌ وأطلالُ",76,"ل",1,0],["وردِّد العينين فيها لحظا","فإن للعينين منها حظّا",77,"ظ",2,0],["وَرَدَّ عَلَيكُم مُردَفاتِ نِسائِكُم","بِبَطحاءِ ذي قارٍ صَلادِمُ قُرَّحُ",78,"ح",1,0],["وَرَدَت نَميقَتَكَ الَّتي","جُمِعَت مِنَ الدُرِّ النَضيد",79,"د",1,0],["وَرَدَت خُيولُهُمُ المَجَرَّةَ شُزَّباً","وَالشُهبُ مِن حَولِ المَجَرَّةِ صادِيَه",80,"ي",2,0],["وَرَدَت أَمواهُ دَمعي","وَرَأَت نيرانَ جِسمي",81,"م",2,0],["وَرَدَ الكِتابُ وَإِنَّهُ","عِندي وَحَقِّكُمُ كَريمُ",82,"م",1,1],["وَرُدّوا نَسيماً جاءَ مِنكُم يَزورُن