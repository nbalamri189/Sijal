{"poems":[[95,"باليمن قد آنست يا سيدي","https://www.aldiwan.net/poem11391.html","السريع"],[108,"يا أخت عموريْة!","https://www.poetsgate.com/ViewPoem.aspx?id=179607",""],[186,"لأميرنا ابن مراد ملحم قد أتى","https://www.aldiwan.net/poem67008.html","الكامل"],[234,"مد العزيز يمينه ببنفسج","https://www.aldiwan.net/poem51199.html","الكامل"],[347,"حيه ما حييت يا قلب واهدا","https://www.aldiwan.net/poem55329.html","الخفيف"],[376,"أما على كرم ابنة الكرام","https://www.aldiwan.net/poem57158.html","أحذ الكامل"],[543,"حي في المنهل الزلال ارتشافه","https://www.aldiwan.net/poem47561.html","عموديه"],[543,"حي فيها الإخلاص ولاإقداما","https://www.aldiwan.net/poem47934.html","عموديه"],[543,"أأماري في علمه أماري","https://www.aldiwan.net/poem48148.html","عموديه"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79787","الرمل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79913","الخفيف"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11976","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52070","الكامل"],[2496,"","https://poetry.dctabudhabi.ae/diwan/poem/100435","السريع"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87686","الرمل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132587","الخفيف"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126927","الخفيف"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108021","الخفيف"],[4399,"","https://poetry.dctabudhabi.ae/diwan/poem/130869","الرجز"],[4978,"حيفا ويافا","https://www.poetsgate.com/ViewPoem.aspx?id=177225",""],[4988,"الخوالد تاريخ وبطولات","https://www.poetsgate.com/ViewPoem.aspx?id=182806",""],[5213,"يا نسيم الطلول طبت نسيما","https://www.poetsgate.com/ViewPoem.aspx?id=170535",""],[5447,"عكا، كنعان","https://www.poetsgate.com/ViewPoem.aspx?id=208334",""],[5701,"حي في المغرب شعبا عربيا","https://www.poetsgate.com/ViewPoem.aspx?id=164613",""],[402,"باليمن قد آنست يا سيدي","https://www.poetsgate.com/ViewPoem.aspx?id=36255",""]],"verses":[["حَيْفَا تُحيِّيكَ وَهَيْهَاتْ أَنْ","يَقْضِي بِشُكْرٍ حَقَّ ذَاكَ المَقَامْ",0,"م",1,0],["«حَيْفَا» فديتُك! ما لجفِنك ساهدًا","ولِلَحْنكِ الشادي استحال عويلا؟",1,"ل",2,0],["حَيٌ فَسارَ عَلَيهِ مَدمَعُ فارِحٍ","بَدَلاً بِهِ عَن مَدمَعِ المُتَلهِّفِ",2,"ف",1,0],["حَيَّ فأحْيا مهجتي بتحيّة","كالوصل وافق مُنْيةً من مُرْتَجِي",3,"ج",2,0],["حي فيه الفتون والسحر واخفق","خفقة العجب والتمس فيه رغدا",4,"د",2,0],["حَيفاً عَلى الجاني فَواعَجَبا","لِلضَّربِ يَتبعُ حُجَّةَ الخَصمِ",5,"م",1,0],["حَيِّ في المنهَلِ الزُّلالِ ارتشَافَه","وأدِرها من عَذبِه كَسُلافَه",6,"ف",2,1],["حيٍّ فيها الإخلاصَ ولاإقدامَا","حيٍّ فيها إلى المَسير أَماما",7,"م",2,1],["حيِّ فيها اعتِزازَها بثَباتٍ","حيِّ فيها على الجِهادِ اعتِزاما",7,"م",2,0],["حيِّ فيه إخلاصَهُ لكَ إخلا","صاً سَما وصفُه على الأشعارِ",8,"ر",1,0],["حيِّ فيه الحَديثَ سِحراً حلالاً","مِثلَما تَأتي نَفحَةُ الأزهار",8,"ر",1,0],["حَيِّ فيه يَراعَهُ في نِظامٍ","حيِّ فيه يَراعهُ في نِثارِ",8,"ر",1,0],["حَيِّ فيهِ النُّبوغ وقد أَر","بى صَغيراً عَلَى فُحولٍ كِبارِ",8,"ر",1,0],["حيِّ فيه لَطافَةَ الرُّوحِ حتى","كادَ يَخفى لُطفاً على الأنظارِ",8,"ر",1,0],["حيِّ فيها المرقدَ الأسنى وقل","زادك اللهُ بهاءً وسناءا",9,"ا",3,0],["حيِّ في مطلع السماحِ هِلالاً","عن عُيونِ الراجينَ لا يستسر",10,"ر",1,0],["حَيِّ في الحَيِّ مِن قِبابِ المُصَلّى","مَنزِلاً مونِقاً وَماءً وَظِلّا",11,"ل",2,1],["حيف أن تصد للضلال سيوف","ليس تروى إلاَّ بفيض ولاها",12,"ا",3,0],["حَيَّ فَحنَّ لهُ الفُؤادُ المُدْنَفُ","طَيْفٌ ألَمَّ بِمَنْ لهُ يَتَشَوفُ",13,"ف",1,1],["حي فأحي بلمى ريقه","مفلج المبسم ألماه",14,"ا",2,0],["حيّ في جِزّين عِينا","وَظِباءاً يَرتَعينا",15,"ن",2,1],["حي في رامتين ملعب ريم","كان عهد المشوق فيه حميدا",16,"د",2,0],["حي في جانب الرصافة داراً","ذكر عبد الحميد فيها يطيب",17,"ب",1,1],["حيِّ في مصر أربع الغاداتِ","ومغاني الحسان والحسناتِ",18,"ت",1,1],["حي فيحيى الخلق للعباده","وهو مميت منه بالإراده",19,"ه",1,0],["حيفا ويافا والجليل مشوقةٌ","يا أمّها يا أنتِ طال غيابُ",20,"ب",1,1],["حيّف على بيض الحبارى بتذليل","ومن مدّ يدّه عاد مقطوع الايمان",21,"ن",1,0],["حي فياضة الأكف سماحا","من بنى هاشم كريما كريما",22,"م",2,0],["حَيْفا ودرويشُ استقاما في يدِي","ظِلَّينِ للأبنوسِ في غابِ الكرى",23,"ر",2,0],["حي في المغرب شعبا عربيا","هب إعصارا على الباغي عتيا",24,"ي",2,1],["حيفا تحييك وهيات أن","يقضي بشكر حق ذاك المقام",25,"م",1,0]]}