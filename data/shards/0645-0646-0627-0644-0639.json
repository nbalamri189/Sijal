iewPoem.aspx?id=34736",""],[5136,"بمن يستغيث العبد إلا بمولاه","https://www.poetsgate.com/ViewPoem.aspx?id=121766",""],[5213,"من العليا نتح بفيك اثكب","https://www.poetsgate.com/ViewPoem.aspx?id=170417",""],[5277,"حسّونُ الصوبين..","https://www.poetsgate.com/ViewPoem.aspx?id=190915",""],[5277,"وقفةٌ على الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=191198",""],[5277,"رابحة ..في حلّي ومرتحلي","https://www.poetsgate.com/ViewPoem.aspx?id=192911",""],[5285,"أتدرين ؟!","https://www.poetsgate.com/ViewPoem.aspx?id=203980",""],[592,"ألا قل لذي الجهل المركب إنما","https://www.poetsgate.com/ViewPoem.aspx?id=128806",""],[592,"ما بال عينيك مثل الهاطل الساري","https://www.poetsgate.com/ViewPoem.aspx?id=128848",""],[592,"فليس بنظم مستقم ولم يكن","https://www.poetsgate.com/ViewPoem.aspx?id=128801",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[812,"من العقيق ومن تذكاري ذي سلمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=115769",""],[5431,"تاء الأنوثة !","https://www.poetsgate.com/ViewPoem.aspx?id=207717",""],[5596,"بين السبحية والحمراء","https://www.poetsgate.com/ViewPoem.aspx?id=206360",""],[5596,"وادي محرم","https://www.poetsgate.com/ViewPoem.aspx?id=206487",""],[5605,"من العراق إلى السودان!!","https://www.poetsgate.com/ViewPoem.aspx?id=160021",""],[5605,"ستُونَ عَامًا","https://www.poetsgate.com/ViewPoem.aspx?id=160307",""],[5736,"أنين قلب","https://www.poetsgate.com/ViewPoem.aspx?id=208863",""],[5770,"تكريم المعلم","https://www.poetsgate.com/ViewPoem.aspx?id=178686",""],[5775,"أنا يا بدر","https://www.poetsgate.com/ViewPoem.aspx?id=35139",""],[5823,"الحياة سباق","https://www.poetsgate.com/ViewPoem.aspx?id=59136",""],[5861,"نداء لدول الطرشستان","https://www.poetsgate.com/ViewPoem.aspx?id=190323",""],[5953,"ألا يا رجال الحق بالحق أبشروا","https://www.poetsgate.com/ViewPoem.aspx?id=93852",""],[5953,"سئمت المقام بنادي حلب","https://www.poetsgate.com/ViewPoem.aspx?id=93858",""],[5953,"باب الهداية باب واحد أبدي","https://www.poetsgate.com/ViewPoem.aspx?id=93783",""],[5969,"مَدارٌ لئيم","https://www.poetsgate.com/ViewPoem.aspx?id=206928",""],[6034,"الدهر لا يبرح خوانا","https://www.poetsgate.com/ViewPoem.aspx?id=169609",""],[6068,"من العراق محب طلّ باسمُهُ -03-","https://www.poetsgate.com/ViewPoem.aspx?id=175815",""],[6068,"‫#العراق‬ -04-","https://www.poetsgate.com/ViewPoem.aspx?id=177020",""],[6125,"علىٰ شهواتِ أنفُسِهِمْ أقَامُوا","https://www.poetsgate.com/ViewPoem.aspx?id=212880",""],[6144,"العيون","https://www.poetsgate.com/ViewPoem.aspx?id=21842",""],[6147,"أم الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=151698",""],[242,"تعززت بذي العز","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563702",""],[186,"من آل عز الدين شهم قد مضى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=56012&r=&rc=275",""],[463,"منَ العارِلولا أنَّ طيفكِ يطرقِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60159&r=&rc=215",""],[6260,"يا رجال القلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68348&r=&rc=40",""]],"verses":[["مِنَ العُظَماءِ أَطوَلُهُم عِماداً","وَأَنداهُم إِذا مُطِروا يَمينا",0,"ن",2,0],["مِن آلِ عَدنانَ الَّذينَ كَفاهُمُ","أَنَّ اِبنَ موسى مِن بَني عَدنانِ",1,"ن",1,0],["مِنَ العِراقِ إِلى أَجبالِ خُرَّمَةٍ","يا بُعدَهُ مَنبَذاً عَنّا وَمُطَّرَحا",2,"ح",2,0],["منَ العَربيَّاتِ الحِسانِ كأنَّها","ظِباءٌ تُناغِيها بِوَجْرَةَ أطفالُ",3,"ل",1,0],["منَ العرَبِ الشُّمِّ الأنوفِ إذا احْتَبوا","تبوّأتَ في جارٍ مُجيرٍ وفي حِلْفِ",4,"ف",1,0],["مِنْ آلِ عَبْدِ الْحَق حَيْثُ تَوَشَّجَتْ","شُعَبُ الْعُلاَ وَرَبَتْ بِأَيِّ كَثيِبِ",5,"ب",1,0],["مِنَ العِنايةِ قد رِيشَتْ قَوادِمُها","ومن صَميم التُّقى رِيشَتْ خَوافيها",6,"ي",3,0],["مِنْ آلِ عَقْلٍ لا يَخِرُّ مُكَافِحٌ","حَتَّى يَلُوحَ مِنَ الصُّفُوفِ الثَّانِي",7,"ن",2,0],["مِنَ العَبَاقِرَةِ الغُرِّ الَّذِينَ غَدَوا","فِي الشَّرْقِ وَالغَرْبِ ملءَ العَيْنِ وَالأَذُنِ",8,"ن",1,0],["مِنَ العَضِ بِالأَفخاذِ أَو حَجَباتِها","إِذا رابَهُ اِستِعصاؤُها وَعِدالُها",9,"ل",3,0],["مِنَ العِراقِيَّةِ اللاتي يُحيلُ لَها","بَينَ الفَلاةِ وَبَينَ النَخلِ أُخدودُ",10,"د",1,0],["من آل عدنانَ في الأشراف من مُضَرٍ","من محتدِ تطمح العلياءُ إن طَمَحَا",11,"ح",2,0],["من العرب مطبوع الطباع على العلا","بديع معاني الحسن في الخَلق والخُلق",12,"ق",1,0],["من العُرب أما عِرضه فمُوَفَّر","مَصونٌ وأما جسمه فهزيل",13,"ل",1,0],["من العراق إلى نجد إلى يمن","إلى الحجاز إلى مصر إلى حلب",14,"ب",1,0],["مِنَ العيدِيِّ في نَسَبِ المَهارى","تُطيرُ عَلى أَخِشَّتِها اللُغاما",15,"م",2,0],["مِنَ العَرَشاتِ تَلحَقُ مارَأَتهُ","إِذا طَلَبَت وَتُعطى ماتُسامُ",16,"م",1,0],["من العُرب إلا أنَّ بين جفونها","أحدّ شبا مما يجرّده الهند",17,"د",1,0],["من العِتاق يجلِّي قشعماً دَرِباً","حتى إذا ما استبان انقضَّ غطرافا",18,"ف",2,0],["من آل عباس الكرام ذوي ال","سؤدد والفائزين بالسبق",19,"ق",1,0],["من العادياتِ الطائراتِ إذا نجا","بَصُرْتَ به بين النجاءيْن مُقْتَسمْ",20,"م",1,0],["مِنَ العَرَبِيّاتِ البَوادي وَلَم تَكُن","تُلَوِّحُها حُمّى دِمَشقَ وَمومُها",21,"م",3,0],["مِنَ العيسِ العِتاقِ تَرى عَلَيها","يَبيسَ الماءِ قَد خَضِبَ التِجارا",22,"ر",2,0],["مِنَ العيدِيِّ تَحمِلُني وَرَحلي","وَتَحمِلُها مَلاطِسُ ما يَقينا",23,"ن",2,0],["من العدل أنك للعدل قمت","لترضَى الحقوقُ ومهضومها",24,"م",3,0],["من العناية طورا","الى الرعاية حينا",25,"ن",2,0],["من العجائب صاروا من أحبتها","فيما زعمت وكانوا من أعاديها",26,"ي",3,0],["مِنَ العَزمِ ما يُحيِ فُحولاً كَثيرَةً","وَقَدَّمَ كافورَ الخَصِيِّ الطَواشِيا",27,"ي",2,0],["مِنَ العوجِ حَوّاءَ المَدامِعِ تَرعَوي","إِلى رَشَإٍ طِفلٍ تَخالُ بِهِ فَترا",28,"ر",2,0],["مِنَ العوجِ أَعناقاً عِقالٌ أَبوهُما","تَكونانِ لِلعَينَينِ وَالقَلبِ مَقنَعا",29,"ع",2,0],["مِنَ العَينِ مُنحَلُّ العَزالي تَسوقُهُ","جَنوبٌ بِأَنضادٍ يَسُحُّ رُكامُها",30,"م",3,0],["مِنَ العُقولِ سُهولٌ","مَعروفَةٌ وَحُزونُ",31,"ن",1,0],["مِن آلِ عَبسونَ الَّذينَ إِذا اِنتَمَوا","عَبَسَ الرَدى وَتَوَلَّتِ اللَأواءُ",32,"ا",2,0],["مِنَ العوارِفِ آلافٌ مُجَدِّدَةٌ","للنَّاسِ في كلِّ عامٍ معْلَماً دَثَرا",33,"ر",2,0],["مِنَ الْعِينِ يَحْمِي خِدْرَهَا كُلُّ ضَيْغَمٍ","بَعِيد مَشَقِّ الْجَفْنِ عَبْلِ الْمَعَاصِمِ",34,"م",1,0],["مِنَ (العِراقِ) مِنَ الأرضِ التي ائْتَلَفَتْ","و(الشَّامِ) ألْفاً فما مَلاَّ ولا افْتَرَقا",35,"ق",2,0],["مِنَ العارِ أَن تَشقى بِلادي وَأَنعَما","وَكَالمَوتِ أَن يُقضى عَلَيها وَأَسلَما",36,"م",2,0],["مِن آلِ عَمرَةَ وَالمُحِبُّ مُشَوَّقٌ","سَرِبُ الدُمُوعِ إِذا نَأى أَحبابُهُ",37,"ب",2,0],["مِنَ الْعَارِ أَنْ يَرْضَى الفَتَى بِمَذَلَّةٍ","وَفِي السَّيْفِ ما يَكْفِي لأَمْرٍ يُعِدُّهُ",38,"د",2,0],["مِنَ الْعَارِ أَنْ يَرْضَى الْفَتَى غَيْرَ طَبْعِهِ","وَأَنْ يَصْحَبَ الإِنْسَانُ مَنْ لا يُشَاكِلُ",39,"ل",1,0],["مِنَ الْعَارِ أَنْ يَرْضَى الدَّنِيَّةَ مَاجِدٌ","وَيَقْبَلَ مَكْذُوبَ الْمُنَى وَهْوَ صَاغِرُ",40,"ر",1,0],["مِنَ العَوَانِي المُحْصِ","نَاتِ بِالنُّهَى وَالشِّيَمِ",41,"م",1,0],["مِنَ الْعُنْصُرِ الأَنْقَى مِنَ الْمَعْدَنِ الَّذِي","فَرَائِدَهُ مَخْلُوقَةٌ لِلْتَفَرُّدِ",42,"د",1,0],["من آل عبدِ الحق حيث توشحت","شُعبُ العلا وربَتْ بأيِّ كثيب",43,"ب",1,0],["من العارِ أنْ نرضى التذبذبَ صامتاً","دنيئاً ، خبيثاً ، والغاً ، متصاغرا",44,"ر",2,0],["من \" العَلَمَيْن \" استَقْتَهُ محكَمَ القُوى","وفي \" تونسٍ \" أدركتَهُ رازحاً لَغْبا",45,"ب",2,0],["من العوارف آلافٌ مجدِّدَة","ٌ للناس في كلّ معلماً دثَرا",46,"ر",2,0],["من العار أن يغشى الرقاد جفونكم","على حين يغشى الدمع تلك المآقيا",47,"ي",2,0],["من العار أين يكسو الحرير جسومكم","ولم تبق منهم شدّة الضّنك كاسيا",47,"ي",2,0],["من العار أن يبقى عليكم جمودكم","وقد بلغت تلك النفوس التراقيا",47,"ي",2,0],["منَ العيسِ العتاقِ ترى عليها","يَبِيسَ الْمَاءِ قَدْ خَضَبَ النِّجَارَا",48,"ر",2,0],["من العزمِ ما يُحيي فُحولاً كثيرة ً","وقدَّمَ كافورَ الخَصِيّ الطَّواشِيا",49,"ي",2,0],["منالعلويين الجهابذة الأولى","شموس بلاد الله في السهل والوعر",50,"ر",1,0],["من العرش للفرش كل حَسِين","فعالاً وقولاً له وضَدِين",51,"ن",1,0],["من العبدان قد سادوا","ومن قد سادهم سودوا",52,"د",3,0],["مِنَ العِشَا ِإلَى طُلُوعِ الفَجرِ","مُختَارُهُ مِن بَينِ ذَينش يَجرِي",53,"ي",1,0],["مَنِ العاني الذي اتقدت","بأضلعهُ لظى الوجدِ",54,"د",1,0],["من العصبة المدركين العُلا","بأحسابها وبأنسابها",55,"ب",3,0],["من العصبةِ الغُرِّ الذين سعودُهم","بآرائهم لا بالنجوم السوائرِ",56,"ر",1,0],["من العجز ملك الجسم والقلب ممكن","فرغب وارهب تقتني من تسالمه",57,"م",2,0],["مِنَ العَبدليّينَ الأُلى في أَكُفِّهِم","حَياةٌ لِأَوّابٍ وَمَوتٌ لِباعِكِ",58,"ك",1,0],["مِن آلِ عزِّ الدينِ شَهمٌ قَد مَضى","عَنا كَما شاءَ القَضا المَحتومُ",59,"م",1,1],["مِن آلِ عَنحوري كَغُصنٍ قَد ذَوى","فَسَقَت مدامِعُهُ جَوانب قَبرِها",60,"ر",3,0],["مِن آلِ عَنحوري كَريمةُ مَعشرٍ","غَدَرَت بِها في فَتكِها الأَقدارُ",61,"ر",1,0],["من العجز أنْ يَضْحَى بحُرٍّ خَصاصةٌ","وفضُلك يَهْمِى دائماً ويَميح",62,"ح",1,0],["من العلامة في الأشرار أنهمُ","في كل ما كثرت أموالهم كفروا",63,"ر",3,0],["من العمر أيام وما هي من عمري","وما أنا فيها بالسليم من الفكر",64,"ر",1,1],["من العبوس كلامٌ","معناه معنى ابتسام",65,"م",1,0],["من العذل أخشى أنَّ من كان موجعاً","له العذلُ يوماً ليس يؤلمه الضَّربُ",66,"ب",1,0],["من العذول السفيه","حاذر وعنّي أتَصَر",67,"ر",1,0],["مِنَ العَرَبِيّاتِ لَمّا يُزَنَّ","والِدُهُنَّ وَلَمّا يَخِب",68,"ب",1,0],["مِنَ الْعُرْبِ أَوِ الْعُجْمِ","أَوِ التُّرْكِ أَوِ الْغُزِّ",69,"ز",1,0],["من العَرَكانياتِ حرفٌ كأنّها","مريرةُ ليفٍ شُدَّ شَزْراً مريرُها",70,"ر",3,0],["من العينِ قلبي إليكِ خرجْ","وعينُكِ تَهتُكُ أستارَهُ",71,"ه",1,0],["مِنَ العَرَبِيَّاتِ الرَّعابِيبِ تَنْتَمِي","لأشْرَفِ بَيْتٍ في هِلالٍ وَأكْرَمِ",72,"م",1,0],["مِنَ العَرَب العَرْباءِ في سِرّ يَعْربٍ","صَفَا للمَعالي مِنْهُمُ السِّرُّ والجَهرُ",73,"ر",1,0],["مِنَ العُفرِ إلا أنَّ في العفر خدْرَها","فَيا للردَى كَمْ أندُبُ العُفر وَالعفرا",74,"ر",2,0],["من العلماء العارفين بربهم","فإن لم تجد فالصدق خير مطية",75,"ه",1,0],["من العز والملك الخلد والبقا","وما تشتهيه النفس من كل طالب",76,"ب",1,0],["من آل عالوي سادات الأنام من ال","بيت المطهر لا شك ولا جدل",77,"ل",1,0],["مِنَ العُصاةِ وَقَد جاؤَهُ كَالحِمَمِ","اِنظُر لَها صَفحاً جاءَت مُعَدَّلَةً",78,"ه",1,0],["مِنَ العِدا كُلَّ مَسودٍ مِنَ اللَمَمِ","كَما خَدوا وَالقَنا مِنهُم قَد اِشتَبَكَت",78,"ت",1,0],["مِنَ العِينِ الجَوازىءِ لَيسَ يُخزي","مَحاسِنَها الرِياطُ وَلا البُرودُ",79,"د",1,0],["من العباشمة الغر الألى كرهوا","فيما شرى اللَه بيع النقد بالدين",80,"ن",1,0],