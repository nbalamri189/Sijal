{"poems":[[55,"جزاء أمير المؤمنين ثنائي","https://www.aldiwan.net/poem30783.html","الطويل"],[65,"يا حادي الشدنيات المطاريب","https://www.aldiwan.net/poem46151.html","الرجز"],[32,"أتعرف أطلالا بوهبين والحضر","https://www.aldiwan.net/poem29583.html","الطويل"],[53,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[40,"ومن يك باديا ويكن أخاه","https://www.aldiwan.net/poem7808.html","الوافر"],[47,"قفا في مغاني الدار نسأل طلولها","https://www.aldiwan.net/poem65590.html","الطويل"],[30,"إذا مسمع أعطتك يوما يمينه","https://www.aldiwan.net/poem5452.html","الطويل"],[82,"وذات عين من الغزلان فاترة","https://www.aldiwan.net/poem31276.html","البسيط"],[82,"ومشرعة بالموت للطعن صعدة","https://www.aldiwan.net/poem31547.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85837","المجتث"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85547","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54218","البسيط"],[55,"جَزاءُ أمِيرِ المُؤمِنِينَ ثَنَائي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9803&r=&rc=0",""],[131,"ألا صرمت من سلمى الزماما","https://www.aldiwan.net/poem24260.html","الوافر"],[255,"أرى الإسكندرية ذات حسن","https://www.aldiwan.net/poem14945.html","الوافر"],[287,"تقول صحابي والمطي بنا تخدي","https://www.aldiwan.net/poem32793.html","الطويل"],[303,"قفا عللا قبل التفرق عانيا","https://www.aldiwan.net/poem36278.html","عموديه"],[327,"بان الخليط فشطوا بالرعابيب","https://www.aldiwan.net/poem56349.html","البسيط"],[369,"إلى خيال خيال في الظلام سرى","https://www.aldiwan.net/poem60879.html","البسيط"],[369,"رأيت الطريق إلى الوصل وعرا","https://www.aldiwan.net/poem60911.html","الطويل"],[396,"عليك بذكر الله يا طالب الأجر","https://www.aldiwan.net/poem54572.html","عموديه"],[411,"لنا حاكم فيه انخناث وإنه","https://www.aldiwan.net/poem49535.html","الطويل"],[411,"أخ لي أما خلقه فمطهم","https://www.aldiwan.net/poem50016.html","الطويل"],[412,"هي البدر لكن تستر مدى الدهر","https://www.aldiwan.net/poem50169.html","الطويل"],[463,"إذا ذهب الوفاء من الزمانِ","https://www.aldiwan.net/poem55825.html","الوافر"],[463,"سوى رسني قاده الباطل","https://www.aldiwan.net/poem55975.html","المتقارب"],[463,"على كل حال جانب الحق أمنع","https://www.aldiwan.net/poem56131.html","الطويل"],[463,"هبت ومنها الخلاب والخدع","https://www.aldiwan.net/poem56139.html","المنسرح"],[469,"ألمت نع الظلماء يهدى سلامها","https://www.aldiwan.net/poem3195.html","عموديه"],[500,"يا ملك الشرق عمدة الدول","https://www.aldiwan.net/poem10262.html","المنسرح"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83270","البسيط"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96990","الطويل"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137741",""],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48507","الطويل"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96382","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122003","الطويل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77787","الخفيف"],[2181,"","https://poetry.dctabudhabi.ae/diwan/poem/45551","الطويل"],[2274,"","https://poetry.dctabudhabi.ae/diwan/poem/144757","الطويل"],[2274,"","https://poetry.dctabudhabi.ae/diwan/poem/144751","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87329","الرجز"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100888","الطويل"],[2747,"","https://poetry.dctabudhabi.ae/diwan/poem/31512","الطويل"],[2799,"","https://poetry.dctabudhabi.ae/diwan/poem/121126","الطويل"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112487","الطويل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103907","الطويل"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86244","الطويل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110005","الرجز"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205704","الهزج"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107483","الرجز"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94485","الوافر"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133129","البسيط"],[4692,"لغز3","https://www.poetsgate.com/ViewPoem.aspx?id=213013",""],[5002,"ألواَنُ الدُّمُوعِ....","https://www.poetsgate.com/ViewPoem.aspx?id=207168",""],[5351,"إليها","https://www.poetsgate.com/ViewPoem.aspx?id=202129",""],[5628,"ميادة الحناوي تألق دائم *","https://www.poetsgate.com/ViewPoem.aspx?id=182932",""],[5701,"رعى الله على دِجل","https://www.poetsgate.com/ViewPoem.aspx?id=164597",""],[5725,"الى حيث لا أدري","https://www.poetsgate.com/ViewPoem.aspx?id=214796",""],[5952,"ستائر من خجل","https://www.poetsgate.com/ViewPoem.aspx?id=200247",""],[6259,"هي البدرُ لكن تستسرّ مدى الدهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59382&r=&rc=30",""]],"verses":[["لَها سائِقٌ يَطغى عَلَيها بِسَوطِهِ","وَيَشدو عَلى آثارِها بِحَداءِ",0,"ا",2,0],["لهُ أساليبُ منْ مَجْدٍ أبَرَّ بِها","على الوَرى والعُلا شتّى الأساليبِ",1,"ب",1,0],["لَها سُنَّةٌ كَالشَمسِ في يَومِ طَلقَةٍ","بَدَت مِن سَحابٍ وَهيَ جانِحَةُ العَصرِ",2,"ر",1,0],["لها سُنَّةٌ كالشمس تبرز تارةً","وطوراً يواريها صَبيرٌ منضَّدُ",3,"د",1,0],["لَها سَلَفٌ يَعوذُ بِكُلِّ ريعٍ","حَمى الحَوزاتِ وَاِشتَهَرَ الإِفالا",4,"ل",2,0],["لُهاً سَوَّدَتهُ دونَ قَومٍ وَلَم يَدَع","جَوادُ الرِجالِ أَن يَسودَ بِخَيلَها",5,"ل",3,0],["لَها سورَةٌ كانَ المُعَلّى بَنى لَها","مَكارِمَ ما كانَت يَدانِ تَنالُها",6,"ل",3,0],["لها سنانٌ من الألحاظِ صَعْدَتُهُ","غُصْنٌ يميسُ برمّانٍ من الفتنِ",7,"ن",1,0],["لها سَوْرَةٌ خُصّتْ بصورةِ ردّةٍ","ترَى العين منها كل شيء يريبها",8,"ب",3,0],["لها سقطةٌ في الليلِ مؤذيةٌ بها","إذا وَجَبَتْ راع القلوبَ وجيبها",8,"ب",3,0],["له استواء على الع","رش فهو فيه مكين",9,"ن",1,0],["لها سماءٌ تهاب العين رؤيتها","لما على وجهها الداجي من السحب",10,"ب",1,0],["لها سلاحٌ من الإيِمانِ تشرَعُه","ينبو له كلُّم صقولٍ ومحدود",11,"د",1,0],["لهَا سائِقٌ يَطغَى عَلَيها بسَوْطِهِ","وَيَشْدُوا عَلى آثَارِهَا بحداءِ",12,"ا",2,0],["لَها سُحُقٌ وَمِنها دانِياتٌ","جَوانِحُ يَزدَحِمنَ بِها اِزدِحاما",13,"م",2,0],["لها سورٌ إذا لاقى الأعادي","يُقابلهم بوجهٍ من حديدِ",14,"د",1,0],["لَهُ أُسرَةٌ إِن يَدعُهُم لِمُلِمَّةٍ","يُلَبّوهُ بِالبيضِ الظُبى وَالقَنا المُلدِ",15,"د",1,0],["لها ساعدٌ غضٌ كطومارِ فضةٍ","وَآخر كالجُمّارِ أَمطرَ غاديا",16,"ي",2,0],["لَها سَوالِفُ غُزلانٍ وَأَوجُهُها","مِثلُ الدَنانيرِ حُرّاتُ الأَشانيبِ",17,"ب",1,0],["له استنابَ الإمامُ المُقْتَفي شرفاً","لمّا اقتفى أَمرَ رَبِّ العرشِ واقْتفرا",18,"ر",2,0],["له اسْمٌ يُسمّى ولا جِسمَ كان","كما يَقْبَضُ الرَجُلُ الكَفَّ صِفرا",19,"ر",2,0],["له استحوذ الشيطان نساه ذكر من","تفضل بالإيجاد في أول الأمر",20,"ر",1,0],["لهُ أسهُمٌ في الانفِعال صوائِبٌ","وأسهُمُهُ في الفِعلِ جِدُّ خَواطِ",21,"ط",1,0],["لهُ أسهمٌ قد راشَها بجَفائهِ","وقَلبي مِن تِلكَ السِّهامِ جَريحُ",22,"ح",1,0],["لَها سَيف طرف لا يزايل جفنه","وَلَم أَرَ سَيفاً قَطُّ في غمده يَغري",23,"ر",2,0],["لها سرُّ الصدور إذا حوتها","وفي الآذان إعلانُ الأذان",24,"ن",1,0],["له اسمان في جاره مانعٌ","وما بين زوّاره باذلُ",25,"ل",1,0],["لها سابقاتٌ كونُها في زمامكم","ضمانٌ وعهدٌ عندكم لا يضيَّعُ",26,"ع",1,0],["لها سوادا قلبي وطرفي فما","يغرب فيها دمعي ولا الجزعُ",27,"ع",1,0],["لهُ أسرةٌ سمرُ العوالي نحافها","ولكنها بيضُ الأيادي جسامها",28,"م",3,0],["له أسامٍ شتى فأشهرَها ال","سيف فقد سار سائر المثل",29,"ل",1,0],["لَها سَوابِقُ قَد جاءَت مُسَلسَلَةً","عَلى اِطِرادِ كُعوبِ الذُبَّلِ الدُعُسِ",30,"س",1,0],["له أسوةٌ في كل داعٍ إلى الهدى","وإن قيل في الدعوى وحاشاه كاذب",31,"ب",1,0],["لها سرعة لا تشبه إلا","بما ذكروا عن حمام الخلود",32,"د",1,0],["لها سكن في سلمها فهي أجبلٌ","ومضطربٌ في حربها فهي أبحر",33,"ر",1,0],["لها ساطِعٌ سامٍ حوالَي عمودِها","كثيفانِ منها مَن ذلولٍ وصعّبِ",34,"ب",1,0],["لَهُ أُسْرَةٌ أكْرِمْ بِهَا خَيْرُ أُسْرَةٍ","لِغُرِّ الْمَعَالِي وَالمَفَاخِرِ وُرَّثِ",35,"ث",1,0],["لَها سَبيل علينا","وَما إِلَيها سَبيل",36,"ل",1,0],["لَهُ أُسرَةٌ إِن خِفتَ ضَيماً رَأَيتَهُ","رَأى الحَقَّ أَن يَحمي حِماكَ وَيَحدَبا",37,"ب",2,0],["لها سلكُ درٍ قفل فيروزج الوشا","م دارَ به في نصفِ درةِ خاتمِ",38,"م",1,0],["لها سلكُ در ضمنَ خاتمِ عسجدِ","طلى لعساً يا حسنَ ختمٍ حوى سِمطا",39,"ط",2,0],["لَهُ آستِوَاءٌ وَلَهُ استقامَه","إفعَل عليهنَّ بلا ندامَه",40,"ه",1,0],["لها سَمَر كالمسك ملءُ فم الدجى","يعطّر أنفاسَ الذى هو حامله",41,"ل",2,0],["لَهُ أَسهُمٌ ظُهِّرنَ ريشاً سَنِينَهُ","وَمَفرجَةٌ تَمتَدُّ فيها السَواعِدُ",42,"د",1,0],["له أسرة ما بين لاهٍ وعاثرٍ","وذي إحنةٍ فظّ على شعبه جلف",43,"ف",1,0],["له أسرة كالروض زهرا وصادحا","فمن شامها ألفى ملائك فردوس",44,"س",1,0],["لهاسائق حادٍ حثيث مبادر","إلى غير ما أحضى إليك مدارها",45,"ر",3,0],["لَها سَهم لَحظٍ بِرَشق الصَب عامِداً","وَقدٌّ تَثَّني بِالدَلالِ رَشيقاً",46,"ق",2,0],["لها سلامُ اللَهِ من","كل البرايا الناطقه",47,"ق",2,0],["لها ستر وما للشم","س أو بدر الدجى ستر",48,"ر",1,0],["لها سوى التقليدِ","كالوكلِ البليدِ",49,"د",1,0],["لها سجد الجمال وليس بدعاً","سجود العبد إذ يلقي الوليّا",50,"ي",2,0],["له استواءٌ على العرش يليقُ به","منزهٌ عن حلولٍ أو وجهةٍ حصر",51,"ر",1,0],["له أسام عديدات تميزه","مثل (الدويل كحصن) غير مختصر",52,"ر",1,0],["لهُ أسَاطِيرُهُ فِي الحزنٍ أو فَرَحٍ","والقلْبُ مالِكُهُ.. لمْ يأتِ منْ عَدَمِ",53,"م",1,0],["لها سحق أعدائها حرةً","على دفة الحرب مستولية",54,"ي",2,0],["لها سحْرٌ على الجمهورِ بادٍ","إذا حيّتْ ببسمتها مُطِلّهْ",55,"ل",2,0],["لها سكر هو السكرا","ت فاحذر ذلك السكرا",56,"ر",2,0],["له أسرعتْ نوق الغرام هوائما","عليها قواريرٌ عشقنَ حداءهُ",57,"ا",3,0],["لها ستائرُ قد حيكَتْ مِن الخجلِ","إذا مررتُ بها أرْخت على عَجَلِ",58,"ل",1,1],["لها سيفُ جفنٍ لا يزال جفنه","ولم أرَ سيفاً قطُّ في غمده يفري",59,"ر",2,0]]}