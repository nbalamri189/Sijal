{"poems":[[55,"لأغنتك عن وصلي الهموم القواطع","https://www.aldiwan.net/poem30154.html","الطويل"],[53,"وذكرك في الشعر مثل السناد","https://www.aldiwan.net/poem65900.html","المتقارب"],[47,"تظن شجوني لم تعتلج","https://www.aldiwan.net/poem62675.html","المتقارب"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48899","الطويل"],[1660,"","https://poetry.dctabudhabi.ae/diwan/poem/72162","الطويل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26567","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89378","البسيط"],[4578,"يا غزالاً قد نسجت الغزلا","https://www.poetsgate.com/ViewPoem.aspx?id=49611",""],[5050,"لشغلي بأهل الدهر إحدى العجائب","https://www.poetsgate.com/ViewPoem.aspx?id=38188",""],[5127,"أﻻ عللاني بطيفِ الحبيبْ","https://www.poetsgate.com/ViewPoem.aspx?id=177330",""]],"verses":[["وَأَيُّ طِلابٍ فاتَني وَطَلائِعي","مُنىً قَبلَ أَعناقِ المَطيِّ طَوالِعُ",0,"ع",1,0],["وإيطاءِ شعرٍ وإكفائهِ","وإقوائهِ دون ذِكرِ الرُّذالِ",1,"ل",1,0],["وَأَي طِماسٍ إِذا ما أَشَظَّ","في صَدعِ إِمراتِكَ المُنفَرِج",2,"ج",1,0],["وأي طعام في الأسى لا أعافه","وإن كانت السلوى أماميَ والمنُّ",3,"ن",1,0],["وأَيُّ طَبِيبٍ يُبْرِىءُ الدَّاءَ بَعْدَمَا","تَشَرَّبَهُ بَطْنُ الفُؤادِ وَظَاهِرُهْ",4,"ر",2,0],["وَإيطَنَت في أَهلِها المَكارِمُ","وَرُفِعَت لِشَيدِها الدَعائِمُ",5,"م",1,0],["وأي طِرْفِ دموعٍ في مجال بكا","جرى فأدرك عن طَرْفِ الحزين وسنْ",6,"ن",1,0],["وأىطرح عذلي فمن أجفانه","سبق السيف بعشقي العذلا",7,"ل",2,0],["وأي طريق أقتفي في سلوكه","سبيل رسول الله زين المناقب",8,"ب",1,0],["وأيُّ طبيبٍ كمثلِ حبيبٍ","كبلسمِ طِيْبٍ له قد يُطيبْ",9,"ب",1,0]]}