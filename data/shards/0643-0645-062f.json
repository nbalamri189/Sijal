{"poems":[[53,"يا صاحب القلب الصحيح أما اشتفى","https://www.aldiwan.net/poem30126.html","الكامل"],[77,"حنت لخضر ربي وزرق مياه","https://www.aldiwan.net/poem35858.html","الكامل"],[24,"نفى أهل الحبلق يوم وج","https://www.aldiwan.net/poem21871.html","الوافر"],[86,"من لم يذق فقد أليف الصبا","https://www.aldiwan.net/poem10469.html","السريع"],[86,"الشعب يدعو الله يا زغلول","https://www.aldiwan.net/poem68900.html","الكامل"],[73,"قد أحسن الله في الذي صنعه","https://www.aldiwan.net/poem11972.html","المنسرح"],[93,"صوت الكنانة في يوبيلك الذهبي","https://www.aldiwan.net/poem9800.html","عموديه"],[41,"بان الخليط بمن علقت فانصدعوا","https://www.aldiwan.net/poem42370.html","البسيط"],[30,"كم دون مية موماة يهال لها","https://www.aldiwan.net/poem29487.html","البسيط"],[30,"أمنكر أنت ربع الدار عن عفر","https://www.aldiwan.net/poem29614.html","البسيط"],[83,"هي نفحة هبت من الأنصار","https://www.aldiwan.net/poem54284.html","الكامل"],[27,"قد قرب الحي إذ هاجوا لإصعاد","https://www.aldiwan.net/poem5728.html","البسيط"],[27,"قل للديار سقى أطلالك المطر","https://www.aldiwan.net/poem5764.html","البسيط"],[72,"قلب ذلول وغادة صعبه","https://www.aldiwan.net/poem18237.html","المنسرح"],[64,"كم دمعة فيك لي ما كنت أجريها","https://www.aldiwan.net/poem67534.html","البسيط"],[51,"الله يعلم أنني يا سيدي أحيا بقربك","https://www.aldiwan.net/poem8662.html","مجزوء الكامل"],[51,"كمد ليس ينفد","https://www.aldiwan.net/poem61953.html","مجزوء الخفيف"],[91,"لله من عبث القضاء وسخره","https://www.aldiwan.net/poem8730.html","عموديه"],[91,"عادت رياض القوافي وهي حالية","https://www.aldiwan.net/poem8742.html","عموديه"],[91,"شاهدتها كالميت في أكفانه","https://www.aldiwan.net/poem62809.html","عموديه"],[78,"يا ليت مدة بعدك","https://www.aldiwan.net/poem14021.html","المجتث"],[89,"ما انت يا احمد في دولة الادب","https://www.aldiwan.net/poem44620.html","البسيط"],[28,"لو جمعوا من الخلان ألفا","https://www.aldiwan.net/poem5634.html","الوافر"],[61,"وجدول بين حديقتين","https://www.aldiwan.net/poem51419.html","الرجز"],[61,"يا دار يوسف لا عدتك تحية","https://www.aldiwan.net/poem51503.html","الكامل"],[44,"أحيا حشاشة قلب كان مخلوسا","https://www.aldiwan.net/poem30483.html","الكامل"],[31,"يا أم نوفل فكي عانيا مثلت","https://www.aldiwan.net/poem41855.html","البسيط"],[105,"قل للألى رقدوا والعدل يقظان","https://www.aldiwan.net/poem42055.html","البسيط"],[105,"حيوا بمصر حماتها الأحرارا","https://www.aldiwan.net/poem42107.html","الكامل"],[105,"كم دون مية من عين أحاذرها","https://www.aldiwan.net/poem43153.html","البسيط"],[105,"طف بالمصارع واستمع نجواها","https://www.aldiwan.net/poem44218.html","الكامل"],[39,"بان الخليط بسحرة فتبددوا","https://www.aldiwan.net/poem53799.html","الكامل"],[52,"ذم الزمان لدمنة","https://www.aldiwan.net/poem26825.html","مجزوء الكامل"],[52,"سقيا لمنزلة الحمى وكثيبها","https://www.aldiwan.net/poem27267.html","الكامل"],[75,"يوم عريض في الفخار طويل","https://www.aldiwan.net/poem69050.html","الكامل"],[50,"راحت رواحا بين كناد","https://www.aldiwan.net/poem63898.html","السريع"],[50,"تأبدت برقة الروحاء فاللبب","https://www.aldiwan.net/poem64839.html","البسيط"],[46,"إني لمن آل حواء الذين هم","https://www.aldiwan.net/poem23575.html","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147485",""],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202529","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54953","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55086","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54534","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/204512",""],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54266","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54195","الخفيف"],[106,"هو ليلاي","https://www.poetsgate.com/ViewPoem.aspx?id=179378",""],[3,"ظعنَ الذينَ فراقهم أتوقعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10713&r=&rc=67",""]],"verses":[["كَمَدي قَديمٌ في هَواكَ وَإِنَّما","تاريخُ وَصلِكَ كانَ مُذ أُسبوعِ",0,"ع",1,0],["كمْ دون موقِفِ بأسِه منْ طاعِنٍ","كمْ دونَ منزِلِ ضيْفِهِ منْ طاهي",1,"ي",1,0],["كَم دونَها مِن عَدُوٍّ ذي مُكاشَحَةٍ","بادِيَ الشَوارَةِ يُبدي وَجهُهُ حَنَقا",2,"ق",2,0],["كَم دَوحَةٍ أَودى بِها عاصِفٌ","وَالنَجمُ مِن مَأمَنِهِ يَنظُرُ",3,"ر",1,0],["كَم دَولَةٍ شَهِدَ الصَباحُ جَلالَها","وَأَتى عَلَيها اللَيلُ وَهيَ فُلولُ",4,"ل",1,0],["كَم دَعوَةٍ قَد حَواهُ صالِحَةٍ","مِن أَمَلي أَن تَكونَ مُستَمَعَه",5,"ع",2,0],["كَمْ دَارِ عِلْمٍ بَنَاهضا أَوْ مُرَدَّمَةٍ","أَعَادَهَا فِي حِلَىً فَخْمَةٍ قَشِبِ",6,"ب",1,0],["كَم دُونَها مِن فَيافٍ لا أنيسَ بها","إلاّ الظَلِيمُ وإِلاَّ الظِبيُ والسَّبعُ",7,"ع",1,0],["كَم دونَ مَيَّةِ موماةٍ يُهالُ لَها","إِذا تَيَمَّمَها الخِرّيتُ ذو الجَلَدِ",8,"د",1,1],["كَم دونَ مَيَّةَ مِن خَرقٍ وَمِن عَلَمٍ","كَأَنَّهُ لامِعٌ عُريانُ مَسلوبُ",9,"ب",1,0],["كم دعوةٍ لك في المُحول مُجابةٍ","أَغْرَت جفون المزن باستعبارِ",10,"ر",1,0],["كَم دونَ بابِكِ مِن قَومٍ نُحاذِرُهُم","يا أُمَّ عَمروٍ وَحَدّادٍ وَحَدّادِ",11,"د",1,0],["كَم دونَهُم مِن ذُرى تيهٍ مُخَفِّقَةٍ","يَكادُ يَنشَقُّ عَن مَجهولِها البَصَرُ",12,"ر",1,0],["كم دلَّنا بشرهِ على كرمٍ","وساقنَا ذكرهُ إلى رغبه",13,"ب",2,0],["كَم دَمعَةٍ فيكَ لي ما كُنتُ أُجريها","وَلَيلَةٍ لَستُ أَفنى فيكَ أَفنيها",14,"ي",3,1],["كَمِدٌ على ما فات منْ","ك فلا بُليتَ بيوم عَتبِكْ",15,"ك",1,0],["كمَدٌ ليس ينفدُ","وهموم تَجدَّدُ",16,"د",1,1],["كَم دَرَّةٍ في التاجِ أَلفٌ مِثلُها","في القاعِ لَم تَخرُج مِنَ الظَلماءِ",17,"ا",2,0],["كَم دُرَّةٍ يَتَمَنّى البَحرُ لَو نُسِبَت","إِلَيهِ باتَت إِلى مَسعودَ تَنتَسِبُ",18,"ب",1,0],["كَمَدينَةٍ دَكَّ القَضاءُ صُروحَها","دَكّاً وَكَفَّنَ بِالسُكوتِ ذَويها",19,"ي",3,0],["كَمُدة الوَردِ وردَ ال","رَبيع لا وَرد خَدّكْ",20,"ك",1,0],["كم دولة للقريض الناهض انقلبت","لكن عرشك فيها غير منقلب",21,"ب",1,0],["كَمِدحَةِ جَروَلٍ لِبَني قُرَيعٍ","إِذا مِن فِيَّ أُخرِجُها لِسانا",22,"ن",2,0],["كَمِدْيَةٍ مَصقولَةِ الحَدَّيْنِ","كأنَّما صِيغَتْ من اللُّجَيْنِ",23,"ن",1,0],["كم دُمْيَةٍ خَرساءَ فيه ودُمْيَةٍ","فَضَلَتْ عليها باللَّسانِ النَّاطقِ",24,"ق",1,0],["كَم دَعوَةٍ لي إِذا مَكروهَةٌ نَزَلَت","وَاِستَفحَلَ الخَطبُ يا عَيّاشُ يا عيسى",25,"س",2,0],["كَمَ دَعوتِ الَّتي قامَت بِقَرقَرِها","تَمشى كَمَشيِ ضَعيفٍ خَرَّ فَاِنخَدَلا",26,"ل",2,0],["كم دفّق العلم فيّاض البيانِ له","من العُقوق وسوءِ الصّنعِ سجّانُ",27,"ن",1,0],["كم دولةٍ للظُّلمِ عاتيةٍ رَمَى","نَفَسُ اللَّهيفِ كِيانَها فانهارا",28,"ر",2,0],["كَم دونَ مَيَّةَ مِن عَينٍ أُحاذِرُها","مَخوفَةٍ وَلِسانٍ رائِعٍ ذَرِبِ",29,"ب",1,1],["كم دولةٍ للشّركِ زُلزِلَ عَرْشها","بدماءِ بَدْرٍ واسْتُبِيحَ حماها",30,"ا",3,0],["كَم دونَ إِلفِكَ مِن نِياطِ تَنوفَةٍ","قَذَفٍ تَظَلُّ بِها الفَرائِصُ تَرعَدُ",31,"د",1,0],["كَم دُوِّسَت رِجلي العُدا","ةَ وَما بِها عَنهُ حَفا",32,"ف",2,0],["كَم دَولَةٍ مَرِضَت وَأَبرَأَها لَنا","لَولاهُ بَرَّحَ سُقمُها بِطَبيبِها",33,"ب",3,0],["كم دَوّخَتْ أوطانَهُمْ فتركتَها","والمالُ نَهْبٌ والدّيارُ طُلول",34,"ل",1,0],["كَم دونَها مِن مَنهَلٍ آجِنٍ","وَمِن ذُرى طَودٍ وَأَعقادِ",35,"د",1,0],["كَم دونَ أَسماءَ مِن تيهٍ مُلَمِّعَةٍ","وَمِن صَفاصِفَ مِنها القَهبُ وَالخَرِبُ",36,"ب",1,0],["كَم دُرَّةٍ قَصَدوها في مَواطِنِها","لَعَلَّ كَفّاً بِمِقدارٍ تُوافيها",37,"ي",3,0],["كم دار في خاطر ضمير","من فلك دائب يدور",38,"ر",1,0],["كم دمية مما جلا مخلقة","مغنيةٍ ما أغنت المُعلّقه",39,"ه",1,0],["كَمْ دَارِ تَنْكِيدٍ إِذَا أَقْبَلَتْ","عَادَ إِلَيْهَا صَفْوُهَا المُدْبِرُ",40,"ر",1,0],["كَمْ دُونَ عِرْضٍ تَبْتَغِي صَوْنَهُ","تَمْهُرُ وَالأَقْرَبُ لاَ يَمْهُرُ",40,"ر",1,0],["كَمْ دُونَ إِدْرَاكِ الَّذِي تَسْخُو بِهِ","كَابَدْتَ تَذْلِيلَ الصِّعَابِ دِرَاكَا",41,"ك",2,0],["كَمْ دَوْلَةٌ دَالَتْ بِمصْرَ وَحُكْمُهُ","مُتَوَارَثٌ عَنْ أَقْدَمِ الآباءِ",42,"ا",2,0],["كم دميةٍ، ذلَّ الرخامُ","على انتفاضتها وهانْ",43,"ن",1,0],["كم دِرْهَمٍ أُلْقِيَ في سِجْنِهِ","ولم يَنَلْ عَفْواً مَدَى عُمْرِه",44,"ر",2,0],["كم دُموعٍ وكم دماءٍ وكم هَوْ","لٍ وكم أنَّةٍ تفُتُّ الكُبودا",45,"د",2,0],["كَمْ دعاني إلى موائِد شاي","عَامِرات، فكيف أقضي دُيُونه؟",46,"ن",2,0],["كمدلة ٍ عجزاءَ تلحمُ ناهضاً","في الوكْر مَوْقِعُها الشَّظاءُ الأَرفعُ",47,"ع",1,0]]}