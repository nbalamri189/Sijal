343,"بوارق النصر","https://www.poetsgate.com/ViewPoem.aspx?id=132673",""],[5355,"ملح العيون","https://www.poetsgate.com/ViewPoem.aspx?id=190552",""],[5376,"غمَّ قلبي من الزمان طويلا","https://www.poetsgate.com/ViewPoem.aspx?id=197729",""],[5387,"الدوامة","https://www.poetsgate.com/ViewPoem.aspx?id=53793",""],[5397,"بكيت شجواً على الأطلال والدمن","https://www.poetsgate.com/ViewPoem.aspx?id=157909",""],[5409,"طرق الباب حالماً بلقاها","https://www.poetsgate.com/ViewPoem.aspx?id=155363",""],[5409,"وغادةٍ صورها ربها","https://www.poetsgate.com/ViewPoem.aspx?id=155512",""],[5419,"ولّوا وجودَكم شطره","https://www.poetsgate.com/ViewPoem.aspx?id=32219",""],[5431,"ياحلب...","https://www.poetsgate.com/ViewPoem.aspx?id=185009",""],[5477,"حمداً من ردّ أهل الزيغ والزلل","https://www.poetsgate.com/ViewPoem.aspx?id=124908",""],[5533,"لم يَكُنْ قَلْبِي مَعِي","https://www.poetsgate.com/ViewPoem.aspx?id=179939",""],[5533,"وانتصَرَتْ حَلَب","https://www.poetsgate.com/ViewPoem.aspx?id=181540",""],[5561,"حالُهُ ....","https://www.poetsgate.com/ViewPoem.aspx?id=197101",""],[5582,"قِفْ بِالرُّسُومِ وَسائِلْ الأَطْلالا","https://www.poetsgate.com/ViewPoem.aspx?id=187237",""],[5582,"دَعْهُ يَحِنُّ لِشَجْوِهِ وَشُجُونِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63583",""],[5616,"صرخة","https://www.poetsgate.com/ViewPoem.aspx?id=204843",""],[5751,"إطلالة","https://www.poetsgate.com/ViewPoem.aspx?id=214789",""],[402,"صوت الكنانة في يوبيلك الذهبي","https://www.poetsgate.com/ViewPoem.aspx?id=35119",""],[402,"أحسنت شكرك للذي أعطاكا","https://www.poetsgate.com/ViewPoem.aspx?id=36036",""],[5784,"سفر المجاز","https://www.poetsgate.com/ViewPoem.aspx?id=215226",""],[5853,"فلسفة دموع العيون","https://www.poetsgate.com/ViewPoem.aspx?id=175669",""],[5937,"هوَ من !","https://www.poetsgate.com/ViewPoem.aspx?id=211819",""],[5948,"قلتُ ونفسي جَمُّ تأوُّهُها","https://www.poetsgate.com/ViewPoem.aspx?id=100621",""],[5952,"قومي","https://www.poetsgate.com/ViewPoem.aspx?id=199830",""],[5956,"إني أنصّب نفسي مثل والدِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=193718",""],[5978,"آمال عجاف","https://www.poetsgate.com/ViewPoem.aspx?id=191287",""],[6031,"بعثَتْ طَيْفَها فَزَارَ طُرُوقَا","https://www.poetsgate.com/ViewPoem.aspx?id=46276",""],[6164,"الثمانون؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66038&r=&rc=48",""],[5377,"من أحرار اليمن إلى أحرار العراق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79560&r=&rc=16",""],[6167,"عزة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85563&r=&rc=46",""],[6198,"الأفق المحترق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79279&r=&rc=53",""],[2588,"يا بعلبك عروسة البلدان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83217&r=&rc=165",""],[6318,"مهرجان القصيد (1)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66156&r=&rc=6",""],[6320,"قُنْصُلِيَّةُ المَوْت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84343&r=&rc=40",""],[2944,"الفلّاح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86012&r=&rc=5",""]],"verses":[["كَمَدي قَديمٌ في هَواكَ وَإِنَّما","تاريخُ وَصلِكَ كانَ مُذ أُسبوعِ",0,"ع",1,0],["كمْ دون موقِفِ بأسِه منْ طاعِنٍ","كمْ دونَ منزِلِ ضيْفِهِ منْ طاهي",1,"ي",1,0],["كَم دونَها مِن عَدُوٍّ ذي مُكاشَحَةٍ","بادِيَ الشَوارَةِ يُبدي وَجهُهُ حَنَقا",2,"ق",2,0],["كَم دَوحَةٍ أَودى بِها عاصِفٌ","وَالنَجمُ مِن مَأمَنِهِ يَنظُرُ",3,"ر",1,0],["كَم دَولَةٍ شَهِدَ الصَباحُ جَلالَها","وَأَتى عَلَيها اللَيلُ وَهيَ فُلولُ",4,"ل",1,0],["كَم دَعوَةٍ قَد حَواهُ صالِحَةٍ","مِن أَمَلي أَن تَكونَ مُستَمَعَه",5,"ع",2,0],["كَمْ دَارِ عِلْمٍ بَنَاهضا أَوْ مُرَدَّمَةٍ","أَعَادَهَا فِي حِلَىً فَخْمَةٍ قَشِبِ",6,"ب",1,0],["كَم دُونَها مِن فَيافٍ لا أنيسَ بها","إلاّ الظَلِيمُ وإِلاَّ الظِبيُ والسَّبعُ",7,"ع",1,0],["كَم دونَ مَيَّةِ موماةٍ يُهالُ لَها","إِذا تَيَمَّمَها الخِرّيتُ ذو الجَلَدِ",8,"د",1,1],["كَم دونَ مَيَّةَ مِن خَرقٍ وَمِن عَلَمٍ","كَأَنَّهُ لامِعٌ عُريانُ مَسلوبُ",9,"ب",1,0],["كم دعوةٍ لك في المُحول مُجابةٍ","أَغْرَت جفون المزن باستعبارِ",10,"ر",1,0],["كَم دونَ بابِكِ مِن قَومٍ نُحاذِرُهُم","يا أُمَّ عَمروٍ وَحَدّادٍ وَحَدّادِ",11,"د",1,0],["كَم دونَهُم مِن ذُرى تيهٍ مُخَفِّقَةٍ","يَكادُ يَنشَقُّ عَن مَجهولِها البَصَرُ",12,"ر",1,0],["كم دلَّنا بشرهِ على كرمٍ","وساقنَا ذكرهُ إلى رغبه",13,"ب",2,0],["كَم دَمعَةٍ فيكَ لي ما كُنتُ أُجريها","وَلَيلَةٍ لَستُ أَفنى فيكَ أَفنيها",14,"ي",3,1],["كَمِدٌ على ما فات منْ","ك فلا بُليتَ بيوم عَتبِكْ",15,"ك",1,0],["كمَدٌ ليس ينفدُ","وهموم تَجدَّدُ",16,"د",1,1],["كَم دَرَّةٍ في التاجِ أَلفٌ مِثلُها","في القاعِ لَم تَخرُج مِنَ الظَلماءِ",17,"ا",2,0],["كَم دُرَّةٍ يَتَمَنّى البَحرُ لَو نُسِبَت","إِلَيهِ باتَت إِلى مَسعودَ تَنتَسِبُ",18,"ب",1,0],["كَمَدينَةٍ دَكَّ القَضاءُ صُروحَها","دَكّاً وَكَفَّنَ بِالسُكوتِ ذَويها",19,"ي",3,0],["كَمُدة الوَردِ وردَ ال","رَبيع لا وَرد خَدّكْ",20,"ك",1,0],["كم دولة للقريض الناهض انقلبت","لكن عرشك فيها غير منقلب",21,"ب",1,0],["كَمِدحَةِ جَروَلٍ لِبَني قُرَيعٍ","إِذا مِن فِيَّ أُخرِجُها لِسانا",22,"ن",2,0],["كَمِدْيَةٍ مَصقولَةِ الحَدَّيْنِ","كأنَّما صِيغَتْ من اللُّجَيْنِ",23,"ن",1,0],["كم دُمْيَةٍ خَرساءَ فيه ودُمْيَةٍ","فَضَلَتْ عليها باللَّسانِ النَّاطقِ",24,"ق",1,0],["كَم دَعوَةٍ لي إِذا مَكروهَةٌ نَزَلَت","وَاِستَفحَلَ الخَطبُ يا عَيّاشُ يا عيسى",25,"س",2,0],["كَمَ دَعوتِ الَّتي قامَت بِقَرقَرِها","تَمشى كَمَشيِ ضَعيفٍ خَرَّ فَاِنخَدَلا",26,"ل",2,0],["كم دفّق العلم فيّاض البيانِ له","من العُقوق وسوءِ الصّنعِ سجّانُ",27,"ن",1,0],["كم دولةٍ للظُّلمِ عاتيةٍ رَمَى","نَفَسُ اللَّهيفِ كِيانَها فانهارا",28,"ر",2,0],["كَم دونَ مَيَّةَ مِن عَينٍ أُحاذِرُها","مَخوفَةٍ وَلِسانٍ رائِعٍ ذَرِبِ",29,"ب",1,1],["كم دولةٍ للشّركِ زُلزِلَ عَرْشها","بدماءِ بَدْرٍ واسْتُبِيحَ حماها",30,"ا",3,0],["كَم دونَ إِلفِكَ مِن نِياطِ تَنوفَةٍ","قَذَفٍ تَظَلُّ بِها الفَرائِصُ تَرعَدُ",31,"د",1,0],["كَم دُوِّسَت رِجلي العُدا","ةَ وَما بِها عَنهُ حَفا",32,"ف",2,0],["كَم دَولَةٍ مَرِضَت وَأَبرَأَها لَنا","لَولاهُ بَرَّحَ سُقمُها بِطَبيبِها",33,"ب",3,0],["كم دَوّخَتْ أوطانَهُمْ فتركتَها","والمالُ نَهْبٌ والدّيارُ طُلول",34,"ل",1,0],["كَم دونَها مِن مَنهَلٍ آجِنٍ","وَمِن ذُرى طَودٍ وَأَعقادِ",35,"د",1,0],["كَم دونَ أَسماءَ مِن تيهٍ مُلَمِّعَةٍ","وَمِن صَفاصِفَ مِنها القَهبُ وَالخَرِبُ",36,"ب",1,0],["كَم دُرَّةٍ قَصَدوها في مَواطِنِها","لَعَلَّ كَفّاً بِمِقدارٍ تُوافيها",37,"ي",3,0],["كَمْ دُونَهُمْ مِنْ فَلاَةٍ ذَاتِ مُطَّرِدٍ","قَفَّى عَلَيْهَا سَرَابٌ رَاسِبٌ حَارِي",38,"ر",2,0],["كم دار في خاطر ضمير","من فلك دائب يدور",39,"ر",1,0],["كم دمية مما جلا مخلقة","مغنيةٍ ما أغنت المُعلّقه",40,"ه",1,0],["كَمْ دَارِ تَنْكِيدٍ إِذَا أَقْبَلَتْ","عَادَ إِلَيْهَا صَفْوُهَا المُدْبِرُ",41,"ر",1,0],["كَمْ دُونَ عِرْضٍ تَبْتَغِي صَوْنَهُ","تَمْهُرُ وَالأَقْرَبُ لاَ يَمْهُرُ",41,"ر",1,0],["كَمْ دُونَ إِدْرَاكِ الَّذِي تَسْخُو بِهِ","كَابَدْتَ تَذْلِيلَ الصِّعَابِ دِرَاكَا",42,"ك",2,0],["كَمْ دَوْلَةٌ دَالَتْ بِمصْرَ وَحُكْمُهُ","مُتَوَارَثٌ عَنْ أَقْدَمِ الآباءِ",43,"ا",2,0],["كم دميةٍ، ذلَّ الرخامُ","على انتفاضتها وهانْ",44,"ن",1,0],["كم دِرْهَمٍ أُلْقِيَ في سِجْنِهِ","ولم يَنَلْ عَفْواً مَدَى عُمْرِه",45,"ر",2,0],["كم دُموعٍ وكم دماءٍ وكم هَوْ","لٍ وكم أنَّةٍ تفُتُّ الكُبودا",46,"د",2,0],["كَمْ دعاني إلى موائِد شاي","عَامِرات، فكيف أقضي دُيُونه؟",47,"ن",2,0],["كمدّع ، موطنه عنده","على قميص العيد ، أحلى زرار",48,"ر",1,0],["كم دلّلتني بالحنان ولم تكن","أمّي وقد كانت أرقّ وأرحما",49,"م",2,0],["كمدلة ٍ عجزاءَ تلحمُ ناهضاً","في الوكْر مَوْقِعُها الشَّظاءُ الأَرفعُ",50,"ع",1,0],["كم دَوحةٍ لا يَبينُ منها","إلا قليلٌ من الكثير",51,"ر",1,0],["كمدينٍ هوى إليه غريمٌ","أو بخيل حلّت به ضيفانُ",52,"ن",1,1],["كَم دَلالٍ تَدَلَّلَت","وَاِحتَملنا دَلالَها",53,"ل",3,0],["كَم دونَ طيبةَ مِن فراسِخ","وَشَوامخٍ تتلو شوامِخ",54,"خ",1,1],["كَمُدِلٍّ ظَلَّ في عانَتِهِ","بصُوى الرِجلَةِ شَرقِيَّ غُرابِ",55,"ب",1,0],["كَمُدلِجٍ في لَيلِهِ الأَليَلِ","فَقالَ هذا الحُبُّ من أَنزَلَه",56,"ه",1,0],["كَمَد اليَأس وَذُلَّ الطَمَعِ","كَبدٌ حَرّى وَدَمعٌ يَكِفُ",57,"ف",1,0],["كم دولةٍ ماتت وأُخرى بَعدَها","مرضت فما وجدت لها بُقراطا",58,"ط",2,0],["كم دولةٍ فيكِ يا مرّاكشُ انبسطت","والأرضُ تهتزُّ إرهاباً وإعجابا",59,"ب",2,0],["كَمْ دَافَعَ الجَيْشُ العَرَمْرَمُ دُونَهُ","لَوْ أَنَّ شَيْئاً لِلْحِمامِ دَفوعُ",60,"ع",