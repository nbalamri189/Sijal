ف لا عدتك تحية","https://www.aldiwan.net/poem51503.html","الكامل"],[44,"أحيا حشاشة قلب كان مخلوسا","https://www.aldiwan.net/poem30483.html","الكامل"],[31,"يا أم نوفل فكي عانيا مثلت","https://www.aldiwan.net/poem41855.html","البسيط"],[105,"قل للألى رقدوا والعدل يقظان","https://www.aldiwan.net/poem42055.html","البسيط"],[105,"حيوا بمصر حماتها الأحرارا","https://www.aldiwan.net/poem42107.html","الكامل"],[105,"كم دون مية من عين أحاذرها","https://www.aldiwan.net/poem43153.html","البسيط"],[105,"طف بالمصارع واستمع نجواها","https://www.aldiwan.net/poem44218.html","الكامل"],[39,"بان الخليط بسحرة فتبددوا","https://www.aldiwan.net/poem53799.html","الكامل"],[52,"ذم الزمان لدمنة","https://www.aldiwan.net/poem26825.html","مجزوء الكامل"],[52,"سقيا لمنزلة الحمى وكثيبها","https://www.aldiwan.net/poem27267.html","الكامل"],[75,"يوم عريض في الفخار طويل","https://www.aldiwan.net/poem69050.html","الكامل"],[50,"راحت رواحا بين كناد","https://www.aldiwan.net/poem63898.html","السريع"],[50,"تأبدت برقة الروحاء فاللبب","https://www.aldiwan.net/poem64839.html","البسيط"],[46,"إني لمن آل حواء الذين هم","https://www.aldiwan.net/poem23575.html","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147485",""],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202529","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54953","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55086","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54534","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/204512",""],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54266","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54195","الخفيف"],[106,"هو ليلاي","https://www.poetsgate.com/ViewPoem.aspx?id=179378",""],[100,"التاريخ السري .. للجدار العتيق","https://www.poetsgate.com/ViewPoem.aspx?id=50343",""],[100,"كيف أنسى","https://www.poetsgate.com/ViewPoem.aspx?id=50141",""],[3,"ظعنَ الذينَ فراقهم أتوقعُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10713&r=&rc=67",""],[129,"شربت كأسي أمام نفسي","https://www.aldiwan.net/poem67449.html","مخلع البسيط"],[135,"كمدين هوى إليه غريم","https://www.aldiwan.net/poem48944.html","الخفيف"],[137,"ما لسلمى تجنبت","https://www.aldiwan.net/poem67949.html","مجزوء الخفيف"],[189,"كم دون طيبة من فراسخ","https://www.aldiwan.net/poem35167.html","مجزوء الكامل"],[195,"لمن الدار كعنوان الكتاب","https://www.aldiwan.net/poem54425.html","الرمل"],[223,"كان شفيق لم يزل مختلي","https://www.aldiwan.net/poem39703.html","السريع"],[257,"أيها الساقي إليك المشتكى","https://www.aldiwan.net/poem2661.html","الرمل"],[270,"جار الزمان فجاره محتاطا","https://www.aldiwan.net/poem34989.html","الكامل"],[270,"صافح من العرب الأمجاد أحبابا","https://www.aldiwan.net/poem35654.html","البسيط"],[275,"عندي نزاع ليس عنه نزوع","https://www.aldiwan.net/poem25487.html","الكامل"],[298,"الهوى يا مي صعب","https://www.aldiwan.net/poem36310.html","عموديه"],[300,"قد بكرت عاذلتي بكرة","https://www.aldiwan.net/poem45491.html","السريع"],[348,"كم درهم بات يشكو","https://www.aldiwan.net/poem20630.html","المجتث"],[364,"أبقيت بالجزع ما أبليت من طلل","https://www.aldiwan.net/poem60678.html","البسيط"],[380,"واحر غلة قلبي الوقاد","https://www.aldiwan.net/poem48838.html","الكامل"],[393,"يا زائرا سائرا إلى طوس","https://www.aldiwan.net/poem53675.html","المنسرح"],[409,"لو أحسنوا في ملكنا أو أعتقوا","https://www.aldiwan.net/poem32423.html","الكامل"],[416,"كم دم فيك أيها الريم طلا","https://www.aldiwan.net/poem54000.html","الخفيف"],[439,"ثم أقدمتهن شعث النواصي","https://www.aldiwan.net/poem34764.html","الخفيف"],[439,"ضحك الزمان لنا فهاك وهاته","https://www.aldiwan.net/poem34900.html","الكامل"],[458,"أَصاب أو أخطأني راميا","https://www.aldiwan.net/poem55810.html","السريع"],[458,"مالك لا تطرب يا حادي النعم","https://www.aldiwan.net/poem55901.html","الرجز"],[458,"خنساء همي وذكرها أنسي","https://www.aldiwan.net/poem56154.html","المنسرح"],[477,"حي عني منحني الوادي وأثله","https://www.aldiwan.net/poem15200.html","الخفيف"],[477,"كم دون مسراك من بيد وأخطار","https://www.aldiwan.net/poem15202.html","البسيط"],[477,"أما هواك وان تقادم عهده","https://www.aldiwan.net/poem15208.html","الكامل"],[513,"كم دون أرضك من واد ومن علم","https://www.aldiwan.net/poem67770.html","البسيط"],[551,"قد كان يدرك عندكن السول","https://www.aldiwan.net/poem47333.html","الكامل"],[576,"يا آل بكر ألا لله أمكم","https://www.aldiwan.net/poem1798.html","البسيط"]],"verses":[["كَمَدي قَديمٌ في هَواكَ وَإِنَّما","تاريخُ وَصلِكَ كانَ مُذ أُسبوعِ",0,"ع",1,0],["كمْ دون موقِفِ بأسِه منْ طاعِنٍ","كمْ دونَ منزِلِ ضيْفِهِ منْ طاهي",1,"ي",1,0],["كَم دونَها مِن عَدُوٍّ ذي مُكاشَحَةٍ","بادِيَ الشَوارَةِ يُبدي وَجهُهُ حَنَقا",2,"ق",2,0],["كَم دَوحَةٍ أَودى بِها عاصِفٌ","وَالنَجمُ مِن مَأمَنِهِ يَنظُرُ",3,"ر",1,0],["كَم دَولَةٍ شَهِدَ الصَباحُ جَلالَها","وَأَتى عَلَيها اللَيلُ وَهيَ فُلولُ",4,"ل",1,0],["كَم دَعوَةٍ قَد حَواهُ صالِحَةٍ","مِن أَمَلي أَن تَكونَ مُستَمَعَه",5,"ع",2,0],["كَمْ دَارِ عِلْمٍ بَنَاهضا أَوْ مُرَدَّمَةٍ","أَعَادَهَا فِي حِلَىً فَخْمَةٍ قَشِبِ",6,"ب",1,0],["كَم دُونَها مِن فَيافٍ لا أنيسَ بها","إلاّ الظَلِيمُ وإِلاَّ الظِبيُ والسَّبعُ",7,"ع",1,0],["كَم دونَ مَيَّةِ موماةٍ يُهالُ لَها","إِذا تَيَمَّمَها الخِرّيتُ ذو الجَلَدِ",8,"د",1,1],["كَم دونَ مَيَّةَ مِن خَرقٍ وَمِن عَلَمٍ","كَأَنَّهُ لامِعٌ عُريانُ مَسلوبُ",9,"ب",1,0],["كم دعوةٍ لك في المُحول مُجابةٍ","أَغْرَت جفون المزن باستعبارِ",10,"ر",1,0],["كَم دونَ بابِكِ مِن قَومٍ نُحاذِرُهُم","يا أُمَّ عَمروٍ وَحَدّادٍ وَحَدّادِ",11,"د",1,0],["كَم دونَهُم مِن ذُرى تيهٍ مُخَفِّقَةٍ","يَكادُ يَنشَقُّ عَن مَجهولِها البَصَرُ",12,"ر",1,0],["كم دلَّنا بشرهِ على كرمٍ","وساقنَا ذكرهُ إلى رغبه",13,"ب",2,0],["كَم دَمعَةٍ فيكَ لي ما كُنتُ أُجريها","وَلَيلَةٍ لَستُ أَفنى فيكَ أَفنيها",14,"ي",3,1],["كَمِدٌ على ما فات منْ","ك فلا بُليتَ بيوم عَتبِكْ",15,"ك",1,0],["كمَدٌ ليس ينفدُ","وهموم تَجدَّدُ",16,"د",1,1],["كَم دَرَّةٍ في التاجِ أَلفٌ مِثلُها","في القاعِ لَم تَخرُج مِنَ الظَلماءِ",17,"ا",2,0],["كَم دُرَّةٍ يَتَمَنّى البَحرُ لَو نُسِبَت","إِلَيهِ باتَت إِلى مَسعودَ تَنتَسِبُ",18,"ب",1,0],["كَمَدينَةٍ دَكَّ القَضاءُ صُروحَها","دَكّاً وَكَفَّنَ بِالسُكوتِ ذَويها",19,"ي",3,0],["كَمُدة الوَردِ وردَ ال","رَبيع لا وَرد خَدّكْ",20,"ك",1,0],["كم دولة للقريض الناهض انقلبت","لكن عرشك فيها غير منقلب",21,"ب",1,0],["كَمِدحَةِ جَروَلٍ لِبَني قُرَيعٍ","إِذا مِن فِيَّ أُخرِجُها لِسانا",22,"ن",2,0],["كَمِدْيَةٍ مَصقولَةِ الحَدَّيْنِ","كأنَّما صِيغَتْ من اللُّجَيْنِ",23,"ن",1,0],["كم دُمْيَةٍ خَرساءَ فيه ودُمْيَةٍ","فَضَلَتْ عليها باللَّسانِ النَّاطقِ",24,"ق",1,0],["كَم دَعوَةٍ لي إِذا مَكروهَةٌ نَزَلَت","وَاِستَفحَلَ الخَطبُ يا عَيّاشُ يا عيسى",25,"س",2,0],["كَمَ دَعوتِ الَّتي قامَت بِقَرقَرِها","تَمشى كَمَشيِ ضَعيفٍ خَرَّ فَاِنخَدَلا",26,"ل",2,0],["كم دفّق العلم فيّاض البيانِ له","من العُقوق وسوءِ الصّنعِ سجّانُ",27,"ن",1,0],["كم دولةٍ للظُّلمِ عاتيةٍ رَمَى","نَفَسُ اللَّهيفِ كِيانَها فانهارا",28,"ر",2,0],["كَم دونَ مَيَّةَ مِن عَينٍ أُحاذِرُها","مَخوفَةٍ وَلِسانٍ رائِعٍ ذَرِبِ",29,"ب",1,1],["كم دولةٍ للشّركِ زُلزِلَ عَرْشها","بدماءِ بَدْرٍ واسْتُبِيحَ حماها",30,"ا",3,0],["كَم دونَ إِلفِكَ مِن نِياطِ تَنوفَةٍ","قَذَفٍ تَظَلُّ بِها الفَرائِصُ تَرعَدُ",31,"د",1,0],["كَم دُوِّسَت رِجلي العُدا","ةَ وَما بِها عَنهُ حَفا",32,"ف",2,0],["كَم دَولَةٍ مَرِضَت وَأَبرَأَها لَنا","لَولاهُ بَرَّحَ سُقمُها بِطَبيبِها",33,"ب",3,0],["كم دَوّخَتْ أوطانَهُمْ فتركتَها","والمالُ نَهْبٌ والدّيارُ طُلول",34,"ل",1,0],["كَم دونَها مِن مَنهَلٍ آجِنٍ","وَمِن ذُرى طَودٍ وَأَعقادِ",35,"د",1,0],["كَم دونَ أَسماءَ مِن تيهٍ مُلَمِّعَةٍ","وَمِن صَفاصِفَ مِنها القَهبُ وَالخَرِبُ",36,"ب",1,0],["كَم دُرَّةٍ قَصَدوها في مَواطِنِها","لَعَلَّ كَفّاً بِمِقدارٍ تُوافيها",37,"ي",3,0],["كم دار في خاطر ضمير","من فلك دائب يدور",38,"ر",1,0],["كم دمية مما جلا مخلقة","مغنيةٍ ما أغنت المُعلّقه",39,"ه",1,0],["كَمْ دَارِ تَنْكِيدٍ إِذَا أَقْبَلَتْ","عَادَ إِلَيْهَا صَفْوُهَا المُدْبِرُ",40,"ر",1,0],["كَمْ دُونَ عِرْضٍ تَبْتَغِي صَوْنَهُ","تَمْهُرُ وَالأَقْرَبُ لاَ يَمْهُرُ",40,"ر",1,0],["كَمْ دُونَ إِدْرَاكِ الَّذِي تَسْخُو بِهِ","كَابَدْتَ تَذْلِيلَ الصِّعَابِ دِرَاكَا",41,"ك",2,0],["كَمْ دَوْلَةٌ دَالَتْ بِمصْرَ وَحُكْمُهُ","مُتَوَارَثٌ عَنْ أَقْدَمِ الآباءِ",42,"ا",2,0],["كم دميةٍ، ذلَّ الرخامُ","على انتفاضتها وهانْ",43,"ن",1,0],["كم دِرْهَمٍ أُلْقِيَ في سِجْنِهِ","ولم يَنَلْ عَفْواً مَدَى عُمْرِه",44,"ر",2,0],["كم دُموعٍ وكم دماءٍ وكم هَوْ","لٍ وكم أنَّةٍ تفُتُّ الكُبودا",45,"د",2,0],["كَمْ دعاني إلى موائِد شاي","عَامِرات، فكيف أقضي دُيُونه؟",46,"ن",2,0],["كمدّع ، موطنه عنده","على قميص العيد ، أحلى زرار",47,"ر",1,0],["كم دلّلتني بالحنان ولم تكن","أمّي وقد كانت أرقّ وأرحما",48,"م",2,0],["كمدلة ٍ عجزاءَ تلحمُ ناهضاً","في الوكْر مَوْقِعُها الشَّظاءُ الأَرفعُ",49,"ع",1,0],["كم دَوحةٍ لا يَبينُ منها","إلا قليلٌ من الكثير",50,"ر",1,0],["كمدينٍ هوى إليه غريمٌ","أو بخيل حلّت به ضيفانُ",51,"ن",1,1],["كَم دَلالٍ تَدَلَّلَت","وَاِحتَملنا دَلالَها",52,"ل",3,0],["كَم دونَ طيبةَ مِن فراسِخ","وَشَوامخٍ تتلو شوامِخ",53,"خ",1,1],["كَمُدِلٍّ ظَلَّ في عانَتِهِ","بصُوى الرِجلَةِ شَرقِيَّ غُرابِ",54,"ب",1,0],["كَمُدلِجٍ في لَيلِهِ الأَليَلِ","فَقالَ هذا الحُبُّ من أَنزَلَه",55,"ه",1,0],["كَمَد اليَأس وَذُلَّ الطَمَعِ","كَبدٌ حَرّى وَدَمعٌ يَكِفُ",56,"ف",1,0],["كم دولةٍ ماتت وأُخرى بَعدَها","مرضت فما وجدت لها بُقراطا",57,"ط",2,0],["كم دولةٍ فيكِ يا مرّاكشُ انبسطت","والأرضُ تهتزُّ إرهاباً وإعجابا",58,"ب",2,0],["كَمْ دَافَعَ الجَيْشُ العَرَمْرَمُ دُونَهُ","لَوْ أَنَّ شَيْئاً لِلْحِمامِ دَفوعُ",59,"ع",1,0],["كم دعاهمْ مغرمٌ قب","لي وَلكنْ لم يلبُّوا",60,"ب",3,0],["كَم دونَ لَيلى مِن تَنوفِيَّةٍ","لَمّاعَةٍ تُنذِرُ فيها النُذُر",61,"ر",1,0],["كَمْ دِرْهَمٍ بَاتَ يَشكُو","مِن طُولِ سِجْنٍ لَدَيكا",62,"ك",2,1],["كم دونَ جَذْبِ جَديلٍ يومَ ذاك لها","من فارسٍ لسَراةِ الخَيْلِ مُنْجَدِل",63,"ل",1,0],["كَم دونَ زُرق نِطاقُهُ مِن بيض أَس","ياف تَحرمهُ وَسُمر صعاد",64,"د",1,0],["كَم دَفَنوا في القُبورِ من نَجسٍ","أَولى بِهِ الطَرحُ في النَواويس",65,"س",1,0],["كمْ دُونَ رَبْعِك مَهْمهٌ مُتقاذِفٌ","تَشقَى الركابُ به وبيدٌ سَمْلَقُ",66,"ق",1,0],["كم دمٍ فيك أيُّها الرِّيمُ طُلاّ","وفؤادٍ بجَمرةِ الوجد يَصلى",67,"ل",2,1],["كمْ دُعيتُمْ أَن لاتَ حِينَ شِقاقٍ","فأَبَيْتُمْ فلاتَ حِينَ مَناصِ",68,"ص",1,0],["كمديحٍ سيفِ الدولة الأعلى الَّذِي","أَعْيا فأَعْيا فِي مدى غاياتِهِ",69,"ت",2,0],["كمدحةٍ مِنِّيَ أهديتُها","ولم أسِمْها مِيسَما باديا",70,"ي",2,0],["كم دولةٍ قِيدَ به رَيّضُها","ونعمةٍ شبّت على رأس الهَرَمْ",71,"م",1,0],["كم دعوةٍ يشهدُ الحفيظُ على","خلوصِ سرِّي بها من اللَّبسِ",72,"س",1,0],["كم دمٍ راحَ جُباراً في الهوى","عندَهُ أجراهُ في الوجدِ وطلَّه",73,"ل",2,0],["كم دونَ مسراكَ مِن بيدٍ وأخطارِ","ومِن أصَمَّ صليبِ الكعبِ خطّارِ",74,"ر",1,1],["كمدامعي والعينُ تُحْدَجُ للنوى","والبعدُ أزمعَ بالأحبَّةِ جِدُّه",75,"د",2,0],["كم دون أرضك من وادٍ ومن علمٍ","كأن أعلاه بالأفلاك منتسج",76,"ج",1,1],["كم دون خيماتِ الحسانِ حُشاشةٌ","تَفنى ضياعاً أو دمٌ مطلولُ",77,"ل",1,0],["كَم دونَ أَسماءَ مِن مُستَعمَلٍ قَذَفٍ","وَمِن فَلاةٍ بِها تُستَودَعُ العيسُ",78,"س",1,0]]}