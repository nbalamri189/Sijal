{"poems":[[65,"لك من غليل صبابتي ما أضمر","https://www.aldiwan.net/poem46190.html","الكامل"],[36,"إذا خدرت رجلي تذكرت من لها","https://www.aldiwan.net/poem4873.html","الطويل"],[33,"خليلي عوجا نسأل اليوم منزلا","https://www.aldiwan.net/poem41854.html","السريع"],[54,"راب دهر وسطا","https://www.aldiwan.net/poem26869.html","مجزوء الرمل"],[52,"ألا من لصب عازب النوم ساهد","https://www.aldiwan.net/poem63940.html","الطويل"],[48,"أدنى الفوارس من يغير لمغنم","https://www.aldiwan.net/poem23639.html","الكامل"],[124,"أعيذك أن تمنى بتبريح لوعة","https://www.aldiwan.net/poem49306.html","الطويل"],[449,"نوابنا نوائب كلهم","https://www.aldiwan.net/poem55947.html","عموديه"],[519,"ما بال وتر صلاتكم لا يشفع","https://www.aldiwan.net/poem20809.html","الكامل"],[1431,"","https://poetry.dctabudhabi.ae/diwan/poem/198161","الطويل"],[2126,"","https://poetry.dctabudhabi.ae/diwan/poem/100545","الرمل"],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83190","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58074","الوافر"],[4830,"ذكرياتُ العُمر","https://www.poetsgate.com/ViewPoem.aspx?id=208555",""],[5183,"مبعث الأسى","https://www.poetsgate.com/ViewPoem.aspx?id=180278",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5397,"عن الدار نأيا أزمع الركب ترحالا","https://www.poetsgate.com/ViewPoem.aspx?id=157967",""],[5413,"هي قصتي!","https://www.poetsgate.com/ViewPoem.aspx?id=200673",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5816,"( العبيرية ) في وصف الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=125964",""]],"verses":[["فَوَطِئْتُ خَدَّ اللّيلِ فوقَ مُطَهَّمٍ","هُوجُ الرِّياحِ وراءَهُ تَسْتَحْسِرُ",0,"ر",1,0],["فَوَطِّن لِهُلكي مِنكِ نَفساً فَإِنَّني","كَأَنَّكَ بي قَد يا ذُرَيحَ قَضَيتُ",1,"ت",1,0],["فَوَطَّنتُ نَفسي لِلمَبيتِ فَوَلَّجوا","لِيَ الرَبَضَ الأَعلى مَطيّاً وَأَرحُلا",2,"ل",2,0],["فَوَطِئنا عازِباً","قَد حَلا وَشَمَطا",3,"ط",2,0],["فَوَطَّأنَ مَمشاها بِما لَو كَسَبنَهُ","كَفاهُنَّ مِن زَبنِ الخَروجِ الحَواشِدِ",4,"د",1,0],["فوطِئْنَ أوْكارَ الأنُوقِ ورُوّعَت","مِنها وباتَ المُهْرُ ضَيْفَ الهَيْثَمِ",5,"م",1,0],["فوطن على السلوان نفسك إنني","خبير بأدواء القلوب طبين",6,"ن",1,0],["فوطنوا النفس ايا جيرة ال","شهبا على مكس غدا يفرض",7,"ض",1,0],["فوطأْتَ أشرفَ بُقعةٍ قد قُدِّسَتْ","ولبِسْتَ خِلعةَ إنّ نعلَك يُخلَعُ",8,"ع",1,0],["فوطّن على التّرحال نفسك ثانياً","ولا ترج إلاّ مرقد اللّحد موطنا",9,"ن",2,0],["فوطى ترتبه بالقدم","إن يكن يجعل للَه البنون",10,"ن",1,0],["فَوطّنوا القَلبَ عَلى الثَبات","وَأَخلِصوا لِلَّهِ بِالنِيّات",11,"ت",1,0],["فَوَطِّد العَزمَ لَهُ تَوطِيدا","وَسَهِّدِ الجَفنَ لَهُ تَسهِيدا",12,"د",2,0],["فوطِّنْها على نصبٍ","فإن حياتها وَسَطُ",13,"ط",1,0],["فَوَطِّنِ النَّفسَ للأرزاءِ لو نزلَتْ","لايدفعُ الخَطبَ اِسآمٌ ولا ضَجَرُ",14,"ر",1,0],["فوطن عليه النفس واقهر جماحها","فلست إذا لم تقهر النفس تفلح",15,"ح",1,0],["فوطد للتوحيد ركناً مشيدا","وهد من الإشراك ما كان قد سما",16,"م",2,0],["فوطنت يوم الروع نفسك للردى","أجل حيث لم ترهب هنالك اجالا",17,"ل",2,0],["فوطئتُ يومَ تقطعتْ أخبارُها","في كل شبرٍ جمرتينِ حَزينا",18,"ن",2,0],["فوطأ للعبدان ترتيب حالهم","وأسس للأكوان أحكام شرعتي",19,"ت",2,0],["فوطن بها سبل الرشاد برأفة","فما لك نفس غيرها تستخيرها",20,"ر",3,0]]}