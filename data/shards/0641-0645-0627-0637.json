{"poems":[[55,"إلى أين مرمى قصدها وسراها","https://www.aldiwan.net/poem29634.html","الطويل"],[55,"حب العلى شغل قلب ما له شغل","https://www.aldiwan.net/poem29895.html","البسيط"],[55,"مسيري إلى ليل الشباب ضلال","https://www.aldiwan.net/poem29909.html","الطويل"],[57,"وحوراء من حور الجنان مصونة","https://www.aldiwan.net/poem26339.html","الطويل"],[88,"أثرت بنا من الشوق القديم","https://www.aldiwan.net/poem68868.html","الوافر"],[53,"أبا الفضل لا تحتجب إنني","https://www.aldiwan.net/poem65466.html","المتقارب"],[53,"تطول يا قريع بني فراس","https://www.aldiwan.net/poem65929.html","الوافر"],[72,"كلفت بها وقد تمت حلاها","https://www.aldiwan.net/poem42893.html","الوافر"],[47,"تبيت له من شوقه ونزاعه","https://www.aldiwan.net/poem64716.html","الطويل"],[63,"أقارع أعداء النبي وآله","https://www.aldiwan.net/poem51558.html","الطويل"],[60,"ذنوبي إن فكرت فيها كثيرة","https://www.aldiwan.net/poem30969.html","الطويل"],[76,"بذات المكارم ذاك الألم","https://www.aldiwan.net/poem13252.html","المتقارب"],[54,"هي الدار إلا أنها منهم قفر","https://www.aldiwan.net/poem27048.html","الطويل"],[50,"لقد نام عما قد عناك أبو الفضل","https://www.aldiwan.net/poem65056.html","الطويل"],[48,"لدنياك حسن على أنني","https://www.aldiwan.net/poem23045.html","المتقارب"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85589","المتقارب"],[35,"","https://poetry.dctabudhabi.ae/diwan/poem/10976","الطويل"],[108,"الملك الرضيع","https://www.poetsgate.com/ViewPoem.aspx?id=179597",""],[112,"يمسهّر النوّيم ومحضضّ النوم","https://www.poetsgate.com/ViewPoem.aspx?id=8402",""],[147,"كذا في طلاب المجد فليسع من سعى","https://www.aldiwan.net/poem11775.html","الطويل"],[190,"عظ النفس أن تصبو إلى شهواتها","https://www.aldiwan.net/poem44109.html","الطويل"],[354,"ما شهدت الطرف الذي","https://www.aldiwan.net/poem15769.html","مجزوء السريع"],[376,"معي كلمات ما يطاق احتمالها","https://www.aldiwan.net/poem57213.html","الكامل"],[408,"لا تعتبر ضعف حالي واعتبر أدبي","https://www.aldiwan.net/poem46412.html","البسيط"],[408,"نعم هذه حزوى وتلك زرود","https://www.aldiwan.net/poem46908.html","الطويل"],[415,"غرضت من الحياة فكل عمري","https://www.aldiwan.net/poem31725.html","عموديه"],[458,"حلمت ولم أعلم أحلمى يقظة","https://www.aldiwan.net/poem61799.html","الطويل"],[463,"أحقا يا أبا نصر فترجى","https://www.aldiwan.net/poem56074.html","الوافر"],[473,"كراسيك ضرب والبساط تراب","https://www.aldiwan.net/poem60414.html","الطويل"],[475,"يا موقد النار بالعلياء من إضم","https://www.aldiwan.net/poem4826.html","البسيط"],[482,"لمن دمن بالرقمتين وأطلال","https://www.aldiwan.net/poem15250.html","الطويل"],[534,"أنا المذنب الجاني على حالة","https://www.aldiwan.net/poem37542.html","الطويل"],[556,"إذا سارت بنا خوص الركاب","https://www.aldiwan.net/poem48058.html","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122749","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122741","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48808","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64021","الهزج"],[951,"","https://poetry.dctabudhabi.ae/diwan/poem/19930","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59555","الطويل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59617","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65011","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79975","الطويل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48912","البسيط"],[1805,"","https://poetry.dctabudhabi.ae/diwan/poem/26626","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27156","المتقارب"],[2556,"","https://poetry.dctabudhabi.ae/diwan/poem/198708","الطويل"],[2565,"","https://poetry.dctabudhabi.ae/diwan/poem/103727","الطويل"],[2614,"","https://poetry.dctabudhabi.ae/diwan/poem/34997","الطويل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130761","الطويل"],[2740,"","https://poetry.dctabudhabi.ae/diwan/poem/126523","الطويل"],[2747,"","https://poetry.dctabudhabi.ae/diwan/poem/31512","الطويل"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116515","الطويل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109779","الطويل"],[402,"","https://poetry.dctabudhabi.ae/diwan/poem/141718","البسيط"],[3564,"","https://poetry.dctabudhabi.ae/diwan/poem/127814","الوافر"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110059","الطويل"],[3893,"","https://poetry.dctabudhabi.ae/diwan/poem/114863","الطويل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70168","الوافر"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199054","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58077","الطويل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58154","الطويل"],[4593,"","https://poetry.dctabudhabi.ae/diwan/poem/130271","المتقارب"],[4755,"مُكَاشَفَة","https://www.poetsgate.com/ViewPoem.aspx?id=207193",""],[4759,"دمعة في وداعها","https://www.poetsgate.com/ViewPoem.aspx?id=203636",""],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[4881,"يقولون لي","https://www.poetsgate.com/ViewPoem.aspx?id=181740",""],[5183,"بَْينَ الْشَّهْدِ وَالْشَّهَادَة","https://www.poetsgate.com/ViewPoem.aspx?id=186463",""],[5274,"هي الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=203694",""],[5302,"صراع نفس","https://www.poetsgate.com/ViewPoem.aspx?id=202725",""],[5308,"الكرم","https://www.poetsgate.com/ViewPoem.aspx?id=215218",""],[5324,"فأجمل قاتل أنت .","https://www.poetsgate.com/ViewPoem.aspx?id=207464",""],[592,"على الحبر بحر العلم الحقائق","https://www.poetsgate.com/ViewPoem.aspx?id=128858",""],[5397,"سقيت ربوعا بالحمى ومعالما","https://www.poetsgate.com/ViewPoem.aspx?id=157964",""],[5431,"لتروي قيظ أفكارٍ عطاشِ","https://www.poetsgate.com/ViewPoem.aspx?id=198371",""],[5464,"يا جبل الوقار","https://www.poetsgate.com/ViewPoem.aspx?id=6672",""],[5464,"رويدك لا الملام ولا العتاب","https://www.poetsgate.com/ViewPoem.aspx?id=703",""],[5536,"حديث ٌ مع السمراء!!","https://www.poetsgate.com/ViewPoem.aspx?id=19875",""],[5563,"سيحكي الفوات","https://www.poetsgate.com/ViewPoem.aspx?id=212675",""],[5691,"زمان الأقوياء","https://www.poetsgate.com/ViewPoem.aspx?id=206311",""],[5703,"عيون القلب","https://www.poetsgate.com/ViewPoem.aspx?id=207967",""],[5725,"إمام العاشقين","https://www.poetsgate.com/ViewPoem.aspx?id=215791",""],[5751,"الصقر مرة اخرى","https://www.poetsgate.com/ViewPoem.aspx?id=214980",""],[5827,"أرى كذباً تلوحُ به وتزهو","https://www.poetsgate.com/ViewPoem.aspx?id=207778",""],[5916,"الى ليلى ...","https://www.poetsgate.com/ViewPoem.aspx?id=190587",""],[5952,"الشعر في مايا عجيب","https://www.poetsgate.com/ViewPoem.aspx?id=204159",""],[5956,"العدل نِسْبيٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=184126",""],[5997,"عسى يا ليالي","https://www.poetsgate.com/ViewPoem.aspx?id=214241",""],[6102,"هوان هوى","https://www.poetsgate.com/ViewPoem.aspx?id=185303",""],[2220,"سُحيراً أناخوا بِوادي العقيقِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19280&r=&rc=822",""]],"verses":[["فَماطَلَ أَصحابُ الحِياضِ وُرودَها","وَأَعتَمَ أَربابُ المَبيتِ قِراها",0,"ا",3,0],["فَما طِلابُكَ إِنساناً تُصاحِبُهُ","كُلُّ الأَنامِ كَما لا تَشتَهي هَمَلُ",1,"ل",1,0],["فَما طَرَدَ النَعماءَ وَعدُكَ ساعَةً","وَلا غَضَّ مِن جَدوى يَدَيكَ مَطالُ",2,"ل",1,0],["فَما طَرَفَت عَينايَ لَمّا تَعَرَّضَت","لِشَيءٍ سِوى إيمائِها بِالمَحاجِرِ",3,"ر",1,0],["فَما طافَ العُفاةُ بِهِ وَعادوا","بِغَيرِ العَسجَدِيَّةِ وَاللَطيمِ",4,"م",1,0],["فماطلتني ثم راوغتني","فكدرت من ودنا كل صافي",5,"ف",2,0],["فماطِلْني الجزاءَ تؤُلْ بمدحي","من الأمدِ البعيدِ إلى مآل",6,"ل",1,0],["فَما طالَت وَلا قَصُرَت وَلَكِن","مُكَمَّلَةً يَضيقُ بِها الإِزارُ",7,"ر",1,0],["فَما طاوَلَتهُ مِحنَةٌ عَن مُلِمَّةٍ","فَتَنزِعَ إِلّا باعُها دونَ باعِهِ",8,"ع",2,0],["فَمَا طَاوَعَتْنِي النَّفْسُ في أَنْ أُطِيعَهُ","وَلا آذَنَ القُرآنُ لي في اتِّبَاعِهِ",9,"ع",2,0],["فَما طَمَعي في صالِحٍ قَد عَمِلتُهُ","وَلَكِنَّني في رَحمَةِ اللَهِ أَطمَعُ",10,"ع",1,0],["فَما طَرَقَ الحَيَّ حَتّى اِتَّقى","وَلا اِستَقبَلَ المَجدَ حَتّى اِحتَشَم",11,"م",1,0],["فَما طَلَعَت شَمسُ النَهارِ ضُحيَّةً","وَلا أُصُلاً إِلا وَمِن دونِها خِدرُ",12,"ر",1,0],["فَما طالِبُ الحاجاتِ مِمَّن يَرومُها","مِنَ الناسِ إِلّا المُصبِحونَ عَلى رَحلِ",13,"ل",1,0],["فَما طُلِّقَت هِيَ بَل طَلَّقَت","وَلَستَ بِأَوَّلِ مَن طُلِّقا",14,"ق",2,0],["فَما طالَ حتى بدت أَنجم","يُرين خلال السحاب ابتساما",15,"م",2,0],["فَما طَلَعَ النَجمُ الَّذي يُهتَدى بِهِ","وَلا الصُبحُ إِلّا هَيَّجا ذِكرَها لِيا",16,"ي",2,0],["فما طابَ بالسُّلطان نفسًا، ولا بكى","عليه بدمع العين وهْوَ يضيعُ",17,"ع",1,0],["فمّا طلعت .. فحدث في مثل ذاليوم؟","والاّ بلاش من الحياه بكبرها",18,"ر",3,0],["فَما طَلَبي المَعروفَ إِلّا غَنيمَةٌ","لَدَيكَ وَقَد حُزتَ العُلى وَالغِنى مَعا",19,"ع",2,0],["فما طابت الدنيا ولا شهواتها","إذا كانت النيران في أخرياتها",20,"ت",3,0],["فَما طَغى إِذ ما عَدا حَدَّهُ","وَلا بَغى بِالفَرقِ وَالجَمعِ",21,"ع",1,0],["فَما طلَعت واستَوسَقَت وانبَرى لها","بجَدواهُ حتَّى قيلَ خفَّ ثقالُها",22,"ل",3,0],["فما طِلابيَ لِلّدنيا بممتنعٍ","لكنْ رأيتُ طِلابَ المجد أَسْمَالي",23,"ي",1,0],["فما طرقَ القلبَ الجريحَ لِبعدُكم","هدوٌّ ولا الطَّرف القريح هجودُ",24,"د",1,0],["فما طفرت يدي بسرور يوم","بغير هموم حادثة مشوب",25,"ب",1,0],["فما طاقتي أو عدل ربى وإن سما","لِيرَقىُ بها يوماً إلى عرشه السامي",26,"م",2,0],["فما طَرْفٌ طريفٌ من نبوٍّ","تجدّد لا أطيق له احتمالا",27,"ل",2,0],["فَما طَلَعَت مُذ كُنتَ شَمسُ زِيارَتي","عَلى وَطَنٍ لِلبُخلِ فيهِ ضَبابُ",28,"ب",1,0],["فَما طَرِبتَ لِشَجوٍ كُنتَ تَأمَلُهُ","وَلا تَأَمَّلتَ تِلكَ الدارَ مِن أُمَمِ",29,"م",1,0],["فماطالَ في تلكَ الديارِ بوجرَةٍ","وآجالِها للوصلِ منهنَّ آحالُ",30,"ل",1,0],["فما طَمَعِي في أَنْ أُجابَ لِصالحٍ","عَمِلْتُ فإِنّي عالِمٌ بخَطائي",31,"ي",1,0],["فما طُوِيتْ على لَعِبٍ ثيابي","ولا حُدِيَتْ إلى طَرَبٍ رِكابي",32,"ب",2,0],["فَما طَرحوا لذي أرَبٍ سؤالي","وَلا تَركوا جَوابي عن خطابي",32,"ب",2,0],["فَما طَمَعٌ بِهِ وَصلٌ فَوَصلٌ","وَلا يَأس بِهِ صَرمٌ فَصَرمُ",33,"م",1,0],["فَما طاوَلَ السّاداتِ إلاَّ عَلاهُمُ","وَدقَّ جَلالُ القَومِ دُونَ جَلالِهِ",34,"ل",2,0],["فما طبت نفساً بالذي أنت آكل","كما طبت نفساً بالذي أنت عاقد",35,"د",1,0],["فما طينُكُ بالحرِّ","ولا عودُكَ بالنَّبع",36,"ع",1,0],["فما طابت الريح الجنوب بدابقٍ","ولكنها بالعثعثين تطيب",37,"ب",1,0],["فما طارقٌ إلا ودمعي مَنهلٌ","ومن كبدي الحرَّى زِنادٌ لقادح",38,"ح",1,0],["فما طال ليل يُبصر الصبح إثرَه","ولا ربع بعدهَ يهمل القطر",39,"ر",1,0],["فما طَمَتِ الأَموالُ إِلاّ أَبادَها","ولا طَغَتِ الأَعداءُ إِلاَّ وأَرْداها",40,"ا",3,0],["فما طلعةُ البدر المنير مضيئة","كطلعته الغرَّاء في كلِّ غاسق",41,"ق",1,0],["فما طربت لما أَلفيتُ من مرح","ومن فضول برغم العلم والفَهَم",42,"م",1,0],["فَما طَعمُ ماءٍ تَقولُهُ","تَحَدَّرَ مِن غُرٍّ طِوالِ الذَوائِبِ",43,"ب",1,1],["فَما طَلَعَ الفَجرُ إِلّا وَقَد","رَأَوا عَلَماً لا يَخافونَ نيقِ",44,"ق",1,0],["فما طيب عيش المرء إلا شبابه","وليس إذا ما بان عنه يطيب",45,"ب",1,0],["فما طارق إلا لذلك مطرق","ولابن نصير لم يكن ذلك النصر",46,"ر",1,0],["فَما طَمِعَت عَينايَ نَوماً لِلَذَّةٍ","وَما زالَتا مِن ذِكرِهِ تَكفانِ",47,"ن",1,0],["فماطلني شهرا وعاماً وحقبة","وهند بذاك المطل تأخذ لا تعطي",48,"ط",2,0],["فما طلب العلياء سهلاً وانما","حلاوتها صبر وعلقمها شهدُ",49,"د",1,0],["فَماطَلَهُ طولَ المَصيفِ فَلَم يُصِب","هَواهُ مِنَ النَوءِ السَحابُ الرَواعِدُ",50,"د",1,0],["فما طاقت الفاروق وقت بذاله","فجاراه في المسرى ان اكفف عن السير",51,"ر",1,0],["فما طيب ارواح الصبا ان شدا الصبا","وما رصدات الكنز ان بان رصده",52,"د",2,0],["فَما طَوَت شَمألٌ أَذيالَ عاقِلَةٍ","إِلّا وَمَرّ بِها الشّرقي فَتَنتَشِرُ",53,"ر",1,0],["فما طعن القنا ندعوهُ طعناً","ولا قهر العدى ندعوهُ قهرا",54,"ر",2,0],["فما طُورُ سِينا ثُمَّ لُبنانُ في الرُبَى","لك الكلُّ أَيمُ اللَهِ عبدٌ وخادمُ",55,"م",1,0],["فما طعم راح في الزجاج مدامة","ترقرق في الأيدي كميت عصيرها",56,"ر",3,0],["فَما طاطا لِغَير اللَه رَأساً","وَلا احنى لِغَيرِ المَوتِ ظُهرا",57,"ر",2,0],["فما طاب ناد عندهم غير ذكره","شذاه وخير القول ما كان قاصد",58,"د",1,0],["فما طلبُ العلْيَاءِ سهلٌ مَرَامُهُ","ولا خاملٌ يدنو إليها ويطمعُ",59,"ع",1,0],["فما طلبُ الدنيا فتًى غيرُ جاهلٍ","وما نبذَ الأخرى فتى ذو تَفَهُّمِ",60,"م",1,0],["فما طول عشقي مزاح الملاح","بمشتغل عن صياح الصباح",61,"ح",1,0],["فَمَا طَمِعَ امرُؤٌ بِالحُكمِ إِلَّا","هُرِعنا بِالخَنَاجِرِ و( السُّلُوسِ