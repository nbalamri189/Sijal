{"poems":[[53,"إلى أين مرمى قصدها وسراها","https://www.aldiwan.net/poem29634.html","الطويل"],[53,"حب العلى شغل قلب ما له شغل","https://www.aldiwan.net/poem29895.html","البسيط"],[53,"مسيري إلى ليل الشباب ضلال","https://www.aldiwan.net/poem29909.html","الطويل"],[55,"وحوراء من حور الجنان مصونة","https://www.aldiwan.net/poem26339.html","الطويل"],[86,"أثرت بنا من الشوق القديم","https://www.aldiwan.net/poem68868.html","الوافر"],[51,"أبا الفضل لا تحتجب إنني","https://www.aldiwan.net/poem65466.html","المتقارب"],[51,"تطول يا قريع بني فراس","https://www.aldiwan.net/poem65929.html","الوافر"],[70,"كلفت بها وقد تمت حلاها","https://www.aldiwan.net/poem42893.html","الوافر"],[45,"تبيت له من شوقه ونزاعه","https://www.aldiwan.net/poem64716.html","الطويل"],[61,"أقارع أعداء النبي وآله","https://www.aldiwan.net/poem51558.html","الطويل"],[58,"ذنوبي إن فكرت فيها كثيرة","https://www.aldiwan.net/poem30969.html","الطويل"],[74,"بذات المكارم ذاك الألم","https://www.aldiwan.net/poem13252.html","المتقارب"],[52,"هي الدار إلا أنها منهم قفر","https://www.aldiwan.net/poem27048.html","الطويل"],[48,"لقد نام عما قد عناك أبو الفضل","https://www.aldiwan.net/poem65056.html","الطويل"],[46,"لدنياك حسن على أنني","https://www.aldiwan.net/poem23045.html","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85589","المتقارب"],[33,"","https://poetry.dctabudhabi.ae/diwan/poem/10976","الطويل"],[106,"الملك الرضيع","https://www.poetsgate.com/ViewPoem.aspx?id=179597",""],[108,"يمسهّر النوّيم ومحضضّ النوم","https://www.poetsgate.com/ViewPoem.aspx?id=8402",""],[143,"كذا في طلاب المجد فليسع من سعى","https://www.aldiwan.net/poem11775.html","الطويل"],[186,"عظ النفس أن تصبو إلى شهواتها","https://www.aldiwan.net/poem44109.html","الطويل"],[349,"ما شهدت الطرف الذي","https://www.aldiwan.net/poem15769.html","مجزوء السريع"],[371,"معي كلمات ما يطاق احتمالها","https://www.aldiwan.net/poem57213.html","الكامل"],[402,"لا تعتبر ضعف حالي واعتبر أدبي","https://www.aldiwan.net/poem46412.html","البسيط"],[402,"نعم هذه حزوى وتلك زرود","https://www.aldiwan.net/poem46908.html","الطويل"],[409,"غرضت من الحياة فكل عمري","https://www.aldiwan.net/poem31725.html","عموديه"],[453,"حلمت ولم أعلم أحلمى يقظة","https://www.aldiwan.net/poem61799.html","الطويل"],[458,"أحقا يا أبا نصر فترجى","https://www.aldiwan.net/poem56074.html","الوافر"],[468,"كراسيك ضرب والبساط تراب","https://www.aldiwan.net/poem60414.html","الطويل"],[470,"يا موقد النار بالعلياء من إضم","https://www.aldiwan.net/poem4826.html","البسيط"],[477,"لمن دمن بالرقمتين وأطلال","https://www.aldiwan.net/poem15250.html","الطويل"],[529,"أنا المذنب الجاني على حالة","https://www.aldiwan.net/poem37542.html","الطويل"],[551,"إذا سارت بنا خوص الركاب","https://www.aldiwan.net/poem48058.html","الوافر"]],"verses":[["فَماطَلَ أَصحابُ الحِياضِ وُرودَها","وَأَعتَمَ أَربابُ المَبيتِ قِراها",0,"ا",3,0],["فَما طِلابُكَ إِنساناً تُصاحِبُهُ","كُلُّ الأَنامِ كَما لا تَشتَهي هَمَلُ",1,"ل",1,0],["فَما طَرَدَ النَعماءَ وَعدُكَ ساعَةً","وَلا غَضَّ مِن جَدوى يَدَيكَ مَطالُ",2,"ل",1,0],["فَما طَرَفَت عَينايَ لَمّا تَعَرَّضَت","لِشَيءٍ سِوى إيمائِها بِالمَحاجِرِ",3,"ر",1,0],["فَما طافَ العُفاةُ بِهِ وَعادوا","بِغَيرِ العَسجَدِيَّةِ وَاللَطيمِ",4,"م",1,0],["فماطلتني ثم راوغتني","فكدرت من ودنا كل صافي",5,"ي",1,0],["فماطِلْني الجزاءَ تؤُلْ بمدحي","من الأمدِ البعيدِ إلى مآل",6,"ل",1,0],["فَما طالَت وَلا قَصُرَت وَلَكِن","مُكَمَّلَةً يَضيقُ بِها الإِزارُ",7,"ر",1,0],["فَما طاوَلَتهُ مِحنَةٌ عَن مُلِمَّةٍ","فَتَنزِعَ إِلّا باعُها دونَ باعِهِ",8,"ع",2,0],["فَمَا طَاوَعَتْنِي النَّفْسُ في أَنْ أُطِيعَهُ","وَلا آذَنَ القُرآنُ لي في اتِّبَاعِهِ",9,"ع",2,0],["فَما طَمَعي في صالِحٍ قَد عَمِلتُهُ","وَلَكِنَّني في رَحمَةِ اللَهِ أَطمَعُ",10,"ع",1,0],["فَما طَرَقَ الحَيَّ حَتّى اِتَّقى","وَلا اِستَقبَلَ المَجدَ حَتّى اِحتَشَم",11,"م",1,0],["فَما طَلَعَت شَمسُ النَهارِ ضُحيَّةً","وَلا أُصُلاً إِلا وَمِن دونِها خِدرُ",12,"ر",1,0],["فَما طالِبُ الحاجاتِ مِمَّن يَرومُها","مِنَ الناسِ إِلّا المُصبِحونَ عَلى رَحلِ",13,"ل",1,0],["فَما طُلِّقَت هِيَ بَل طَلَّقَت","وَلَستَ بِأَوَّلِ مَن طُلِّقا",14,"ق",2,0],["فَما طالَ حتى بدت أَنجم","يُرين خلال السحاب ابتساما",15,"م",2,0],["فَما طَلَعَ النَجمُ الَّذي يُهتَدى بِهِ","وَلا الصُبحُ إِلّا هَيَّجا ذِكرَها لِيا",16,"ي",2,0],["فما طابَ بالسُّلطان نفسًا، ولا بكى","عليه بدمع العين وهْوَ يضيعُ",17,"ع",1,0],["فمّا طلعت .. فحدث في مثل ذاليوم؟","والاّ بلاش من الحياه بكبرها",18,"ر",3,0],["فَما طَلَبي المَعروفَ إِلّا غَنيمَةٌ","لَدَيكَ وَقَد حُزتَ العُلى وَالغِنى مَعا",19,"ع",2,0],["فما طابت الدنيا ولا شهواتها","إذا كانت النيران في أخرياتها",20,"ت",3,0],["فَما طَغى إِذ ما عَدا حَدَّهُ","وَلا بَغى بِالفَرقِ وَالجَمعِ",21,"ع",1,0],["فَما طلَعت واستَوسَقَت وانبَرى لها","بجَدواهُ حتَّى قيلَ خفَّ ثقالُها",22,"ل",3,0],["فما طِلابيَ لِلّدنيا بممتنعٍ","لكنْ رأيتُ طِلابَ المجد أَسْمَالي",23,"ي",1,0],["فما طرقَ القلبَ الجريحَ لِبعدُكم","هدوٌّ ولا الطَّرف القريح هجودُ",24,"د",1,0],["فما طفرت يدي بسرور يوم","بغير هموم حادثة مشوب",25,"ب",1,0],["فما طاقتي أو عدل ربى وإن سما","لِيرَقىُ بها يوماً إلى عرشه السامي",26,"ي",1,0],["فما طَرْفٌ طريفٌ من نبوٍّ","تجدّد لا أطيق له احتمالا",27,"ل",2,0],["فَما طَلَعَت مُذ كُنتَ شَمسُ زِيارَتي","عَلى وَطَنٍ لِلبُخلِ فيهِ ضَبابُ",28,"ب",1,0],["فَما طَرِبتَ لِشَجوٍ كُنتَ تَأمَلُهُ","وَلا تَأَمَّلتَ تِلكَ الدارَ مِن أُمَمِ",29,"م",1,0],["فماطالَ في تلكَ الديارِ بوجرَةٍ","وآجالِها للوصلِ منهنَّ آحالُ",30,"ل",1,0],["فما طَمَعِي في أَنْ أُجابَ لِصالحٍ","عَمِلْتُ فإِنّي عالِمٌ بخَطائي",31,"ي",1,0],["فما طُوِيتْ على لَعِبٍ ثيابي","ولا حُدِيَتْ إلى طَرَبٍ رِكابي",32,"ي",1,0],["فَما طَرحوا لذي أرَبٍ سؤالي","وَلا تَركوا جَوابي عن خطابي",32,"ي",1,0]]}