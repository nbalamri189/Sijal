{"poems":[[53,"قد طلع البدر مع الزهره","https://www.aldiwan.net/poem62999.html","السريع"],[93,"جلست وقد هجع الغافلون","https://www.aldiwan.net/poem8802.html","عموديه"],[409,"أجزتكما يا أهل ودي روايتي","https://www.aldiwan.net/poem33356.html","الطويل"],[409,"إن الهوى العذري فنى","https://www.aldiwan.net/poem33385.html","مجزوء الكامل"],[409,"أجزتك يا علي وأنت عندي","https://www.aldiwan.net/poem33931.html","الوافر"],[466,"جعلت من الحدثان أحصن أدرع","https://www.aldiwan.net/poem15148.html","الكامل"],[468,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[556,"ألا ما لقلب بأيدي الغواة","https://www.aldiwan.net/poem47280.html","المتقارب"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130632","الكامل"],[3508,"","https://poetry.dctabudhabi.ae/diwan/poem/20552","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85240","الطويل"],[5781,"من نسْلِ ملحٍ وماء","https://www.poetsgate.com/ViewPoem.aspx?id=198552",""]],"verses":[["فأسندتْ ظهراً إلى شاهقٍ","وضم كفيه على دُرَّهْ",0,"ر",2,0],["فَأَسنَدتُ رَأسي إِلى مِرفَقي","وَقُلت وَقَد غَلَبَتني الهُموم",1,"م",1,0],["فأسند إلينا بالإِجازة راوياً","لغير الذي مني سمعت سترويه",2,"ي",2,0],["فأسند الحديث الغرا","م مسلسلاً إن شئت عني",3,"ن",2,0],["فأسند ما تريد إلي مما","سترويه على علماء ذمار",4,"ر",1,0],["فأسنةُ المقدور أطعنُ فيهم","دونَ الوزير من الرماحِ الشُّرَّعِ",5,"ع",1,0],["فأسنانهم تصطك من خصر نافض","باحشائهم والجفن قد بات ساهرا",6,"ر",2,0],["فأسندتُ ظهري إلى يَذْبُلٍ","وألقيتُ ثِقْلي على بازِلِ",7,"ل",1,0],["فأسن في الايمان كنت من الظبا","وألذ في الاجفان من طيب الوسن",8,"ن",1,0],["فأَسنِدُ كَسلى بَزَّها النَومُ ثَوبَها","إِلى الصَدرِ والمَملوكُ يَلقى المَلاقيا",9,"ي",2,0],["فأسن إلى من قد رعيت ولا تطع","بهم واشياً مقصوده الغش والردى",10,"د",2,0],["فأَسْندْتُ خَدِّي لِلْشِّفاهِ لَعلَّها","إِذَا لُتَّ بالمِلحِ الرُّضابُ، تُخَمَّرُ!",11,"ر",1,0]]}