{"poems":[[91,"ابناء دجلة والفرات نيام","https://www.aldiwan.net/poem44882.html","الكامل"],[48,"ألاح وقد رأى برقا مليحا","https://www.aldiwan.net/poem23637.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85525","المجتث"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85493","الكامل"],[190,"في سماح وفي لؤم","https://www.aldiwan.net/poem43329.html","مخلع البسيط"],[287,"معذبتي حتام ذا الهجر والهجر","https://www.aldiwan.net/poem32745.html","الطويل"],[327,"أشتقت وانهل دمع عينك أن","https://www.aldiwan.net/poem56345.html","المنسرح"],[458,"أشح بوجهك عن فكري وعن نظري","https://www.aldiwan.net/poem61579.html","البسيط"],[567,"أعرفت رسم الدار أم لم تعرف","https://www.aldiwan.net/poem52886.html","الكامل"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130204","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69340","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139520",""],[5411,"دُروب السَّالِكين","https://www.poetsgate.com/ViewPoem.aspx?id=185377",""],[327,"أشتقت وانهل دمع عينك أن","https://www.poetsgate.com/ViewPoem.aspx?id=4137",""],[5943,"اعتقْ فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=92975",""],[5966,"مناجاة","https://www.poetsgate.com/ViewPoem.aspx?id=159346",""],[6102,"استِنزاف","https://www.poetsgate.com/ViewPoem.aspx?id=182845",""],[6102,"فرادة","https://www.poetsgate.com/ViewPoem.aspx?id=184552",""],[6129,"للمجاهدين في العراق وللبطلة العظيمة ( ميسون","https://www.poetsgate.com/ViewPoem.aspx?id=13879",""],[6129,"للمجاهدين في العراق وللبطلة العظيمة (ميسون)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74364&r=&rc=2",""]],"verses":[["اشحذ سلاحك ما استطعت فانما","ديناك تغدر والحياة صدام",0,"م",1,0],["أشَحْنَ وقد أقَمْنَ على وَفَازٍ","ثلاثَ حَنادِسٍ يَرْعَينَ شِيحا",1,"ح",2,0],["اشحذ سلاحك للذو","دِ فالحَياة وقاع",2,"ع",1,0],["اشحذ سلاحك واستعد","دَ به لمعترك الحياة",3,"ه",1,1],["اشحذ سلاحك للخصا","م ورد غارات الغزاة",3,"ه",1,0],["اشحذ سلاحك للبقا","ء وَدرء عادية العداة",3,"ه",1,0],["اشحذ سلاحك للدفا","ع عَن الحقوق الواجبات",3,"ت",1,0],["اشحذ سلاحك وهو عل","م تَقتَنيه بلا فَوات",3,"ت",1,0],["أشُحّ بالوصل عن لئيم","وهو على لؤمه ظلوم",4,"م",1,0],["أَشَحطٌ وَلا قُربٌ وَسُخطٌ وَلا رِضىً","وَعَذلٌ وَلا عَدلٌ وَغَدرٌ وَلا عُذرُ",5,"ر",1,0],["أَشحَدَ إِذا هَبَّتِ الشَمالُ لَهُ","سِيقَ رُكامٌ فَالغَيمُ مُنسَرِحُ",6,"ح",1,0],["أشح بوجهك عن فكري وعن نظري","فربما هيجا كالصاخب الشرر",7,"ر",1,1],["أشحَنتُها كالفلكِ في فُلكٍ على","بحرٍ إلى بحرٍ لذيذِ المَرشَفِ",8,"ف",1,0],["اشح بما تبديه من در لفظها","واسخو بدر من دموعي مبدد",9,"د",1,0],["أَشحَبَتهُم غُبرُ الفَيافي وَأَزرَت","شُقَّةُ البِيدِ عِيسَهُم وَالذَميلُ",10,"ل",1,0],["أشحنت بالفيوض حتى أفاضت","سحب فضل عم الوجود انسكابا",11,"ب",2,0],["أشَحْتُ بَوجْهي عَنْهُ عَشْرَ فَراسِخ","وَعَيْنايَ تَمْحو طَيْفهُ وَتُشيحُ",12,"ح",1,0],["أشحذ إذ هبت الشمال ، له","سيق ركامٌ فالغيم منسرح",13,"ح",1,0],["أشحتُ وجهيَ عن دنيا مخادِعةٍ","يَمضي بها العُمْرُ مغصوبًا بآثامِ",14,"م",1,0],["أشحذُ اللحظات في صمتٍ حزين","شاطئُ الاحلامِ يدعو للقلق",15,"ق",1,0],["أَشحَذُ الآهَ نَصلَةً فَوقَ ضِلعِي","بَينَما أَنتِ- بِالقِلى- السَّيَّافُ",16,"ف",1,0],["أَشحَذُ الهَجوَ فَيصَلًا لِخُصُومِي","كُلُّ خِصمٍ سَقَيتُهُ الهَجوَ حَنظَلْ",17,"ل",1,0],["أشحن البندق بالنار ولا تتقي الموت فإن الأمر جد","اذبح العلج على خيبته ثم رتل قل هو الله أحد",18,"د",1,0],["اشحن البندق بالنار ولا","تتقي الموت فإن الأمر جد",19,"د",1,0]]}