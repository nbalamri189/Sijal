{"poems":[[95,"أتتنا الهدية مختالة","https://www.aldiwan.net/poem9792.html","عموديه"],[99,"أمل ضائع ولب مشرد","https://www.aldiwan.net/poem24804.html","الخفيف"],[83,"عليل شاقه نفس عليل","https://www.aldiwan.net/poem61498.html","الوافر"],[52,"وشخص طيب الأردا","https://www.aldiwan.net/poem62271.html","الهزج"],[48,"كأنك عن كيد الحوادث راقد","https://www.aldiwan.net/poem22318.html","الطويل"],[48,"عمل كلا عمل ووقت فائت","https://www.aldiwan.net/poem23078.html","الكامل"],[108,"النيل والسودان","https://www.poetsgate.com/ViewPoem.aspx?id=179757",""],[119,"سهام هواك صائبة المرامي","https://www.aldiwan.net/poem40489.html","عموديه"],[139,"قضى حسين وهل حزن بلا سبب","https://www.aldiwan.net/poem48875.html","البسيط"],[190,"هجرت المساوئ والمنكرات","https://www.aldiwan.net/poem43240.html","المتقارب"],[314,"ولم يمرر به يوم فظيع","https://www.aldiwan.net/poem50239.html","الوافر"],[347,"دمعة حرى على وطن","https://www.aldiwan.net/poem55385.html","المديد"],[409,"أهلا بها فهي عندي غاية الأرب","https://www.aldiwan.net/poem34145.html","البسيط"],[563,"قف على أيمن الحمى كوقوفي","https://www.aldiwan.net/poem34361.html","الخفيف"],[580,"الصبر بعدك لا يكون","https://www.aldiwan.net/poem2774.html","مجزوء الكامل"],[949,"","https://poetry.dctabudhabi.ae/diwan/poem/124748","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25449","الرجز"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79418","الطويل"],[1378,"","https://poetry.dctabudhabi.ae/diwan/poem/216851",""],[1378,"","https://poetry.dctabudhabi.ae/diwan/poem/216847",""],[1541,"","https://poetry.dctabudhabi.ae/diwan/poem/198477","المتقارب"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77995","المتقارب"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/199440","الطويل"],[1765,"","https://poetry.dctabudhabi.ae/diwan/poem/131559",""],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132226","الخفيف"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114708","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109430","الطويل"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105005","الطويل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120566","الطويل"],[2579,"","https://poetry.dctabudhabi.ae/diwan/poem/206004","المتقارب"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141226","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74208","الطويل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103981","البسيط"],[4308,"","https://poetry.dctabudhabi.ae/diwan/poem/34762","الهزج"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139597",""],[4633,"","https://poetry.dctabudhabi.ae/diwan/poem/142876","المتقارب"],[4640,"","https://poetry.dctabudhabi.ae/diwan/poem/142830","الطويل"],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""],[5461,"الله عليها عودت","https://www.poetsgate.com/ViewPoem.aspx?id=26285",""],[5785,"ذكرتك وقد فاض دمع الغمام","https://www.poetsgate.com/ViewPoem.aspx?id=131563",""]],"verses":[["وَشَخْصٌ كَهَذَا جَدِيرٌ بِأَنْ","يَنَالَ مَعِ الْمَالِ أَعْلى الرُّتَبْ",0,"ب",1,0],["وشخوصي إِلى السماء بطرفي","وندائي بها إلى كل فرقد",1,"د",1,0],["وَشَخصي في الهَوى طَلَلٌ فَأَنّى","يُجاوِبُ عاذِلاً طَلَلٌ مُحيلُ",2,"ل",1,0],["وَشَخصٍ طَيِّبِ الأَردا","نِ لا تَعرِفُ أَمثالَه",3,"ل",2,1],["وَشَخصي وَرَوحي مِثلُ طِفلٍ وَأُمَّهُ","لِتِلكَ بِهَذا مِن يَدِ الرَبِّ عاقِدُ",4,"د",1,0],["وَشُخوصُ أَقوامٍ تَلوحُ فَأَمَّةٌ","قَدِمَت مِجَدَّدَةً وَأُخرى تَهلِكُ",5,"ك",1,0],["وشخوصٌ تلوحُ إثر شخوصٍ","كرسُومٍ في لوحةِ الفنَّان",6,"ن",1,0],["وشخصك في رحاب القلب عال","وقدرك في لباب السر سامي",7,"م",2,0],["وشخصه غاب في هذا الثرى وثوى","وقدُره بين أهل الفضل لم يغبِ",8,"ب",1,0],["وشخصٌ يقاس بفطنته","سمين وغثّ ترى فيه لينا",9,"ن",2,0],["وَشَخصٍ كانَ في الدُنيا فَقيراً","تَبَوَّأَ مَنزِلَ النُجبِ الكِرامِ",10,"م",1,0],["وشخوص الحي جامدة","في ظلام الليل كالوثن",11,"ن",1,0],["وشخصكم في سواد العين مرتسم","مشاهد لي في بُعْدٍ ومقترب",12,"ب",1,0],["وشخوص المرآة عبرة مثلي","وظلال الأراك داني القطوف",13,"ف",1,0],["وشَخَصتُ وانقطع التَّنَفُّ","سُ مِنك إِذْ قُطع الوَتينُ",14,"ن",1,0],["وشخص النرجس في الأحداق","واحمرّ حدّ الورد للتلاقى",15,"ق",2,0],["وَشَخَصَت أَبْصارُهُمْ وَأَجْذَمُوا","لا تَشْتُمِ الناسَ كَما لا تُشْتَمُ",16,"م",1,0],["وشخصٌ جميلٌ يعجبُ الناسَ حسنُهُ","ولكنْ له أسرارُ سوءٍ قَبَائِحُ",17,"ح",1,0],["وش خَلَف يا زين لاماكم","شِ السِّبَب لي به هِجَرتونا",18,"ن",2,0],["وش خانَة السّقْط نسبه","لو كِنت به باعلى شجرَه",19,"ر",2,0],["وشخصك طالعه لحظنا","فأني أطالعه بالفؤاد",20,"د",1,0],["وشخصي رهين وسري حزين","وسيري مهين ومالي حمول",21,"ل",1,0],["وشخصاً لو أن الفضل أعطي حكمه","لكان له مما هنالك واقيا",22,"ي",2,0],["وشخصهم منقوش في الخواطر","نقش المصور في صميم الأحجار",23,"ر",1,0],["وشخير الفحول يلفح نارا","ووجوه الضياغم الحرباء",24,"ا",2,0],["وَشَخصُكِ في عَيني ونَشرُكِ في يَدي","وَصَوتُكِ في سَمعي وَذِكراكِ في فَمي",25,"م",2,0],["وشخصها هاروتها لي بروضةٍ","كستها عقود الدر ايدي السحائب",26,"ب",1,0],["وشخصاً بأبراد الفضائل كاسياً","إليها ملوك الأرض تدخل سُجَّدا",27,"د",2,0],["وشخصك مهما لاح للخلق أذعَنَت","لِهَيبَتِهِ عُجمُ الوَرى والأعارِبُ",28,"ب",1,0],["وشخصٌ تُرَىِ يَدُه أنفَه","فإن وصَلوه بسيفٍ صَقيلِ",29,"ل",1,0],["وشخصك قطب الكائنات فسِرُّها","على سِرّه في العالمين تُديرُ",30,"ر",1,0],["وَشَخص زَكا حَتّى حَكى النار في الذكا","لَهُ المُشتَكى يا صاح مِن سَطوة الدَهر",31,"ر",1,0],["وَشَخصُهُ مَاثِلٌ فِي نَاظِرِي أبَداً","وَفِي ضَمِيرِي إذَا مَا نِمنَ أجفَانِي",32,"ن",2,0],["وَشَخصٍ لا أُسَمّيهِ","مِنَ اِهلِ المَجدِ وَالخَيرِ",33,"ر",1,0],["وشخص التقى كم قرَّ طرفا بنسكه","به قبل هذا مذ رأى فيه صالحا",34,"ح",2,0],["وشخصك إن لم يكن حاضراً","فتمثال شخصك في خاطري",35,"ر",2,0],["وشخصين قد حلاّ بأعلى جرنجس","شريفَيْن قد حلاّ بأَشرفِ مَوْضِعِ",36,"ع",1,0],["وشخص بهذا لا يعامل جهرة","لدرء الفساد المستفاد من الزلل",37,"ل",1,0],["وش خانة الحب البعيد إن كان عشاقه يموت","يخيل براقه وهو ما ذاق طعمه واحتسى",38,"س",2,0],["وشخصك معه في السويد مقام","وفي العين في الإنسان",39,"ن",1,0]]}