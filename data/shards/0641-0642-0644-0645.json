{"poems":[[57,"إنا من الدرب أقبلنا نؤمكم","https://www.aldiwan.net/poem26297.html","البسيط"],[79,"قلت اعشقوا عين البذول التي","https://www.aldiwan.net/poem36128.html","السريع"],[44,"أبلغ أبا الجارود عني رسالة","https://www.aldiwan.net/poem50415.html","الطويل"],[49,"زماني كله غضب وعتب","https://www.aldiwan.net/poem25372.html","الوافر"],[53,"بان شبابي فعز مطلبه وانبت بيني وبينه نسبه","https://www.aldiwan.net/poem8518.html","المنسرح"],[72,"علا حس النواعير","https://www.aldiwan.net/poem42906.html","الهزج"],[45,"أنوك من عبد ومن عرسه","https://www.aldiwan.net/poem9615.html","السريع"],[51,"أوالب أنت في العرب","https://www.aldiwan.net/poem63236.html","مجزوء الوافر"],[89,"عليل أنت مسقمه","https://www.aldiwan.net/poem8277.html","مجزوء الوافر"],[41,"أصاح ألا هل من سبيل إلى هند","https://www.aldiwan.net/poem53784.html","الطويل"],[50,"إذا ما شكا ليم إليك مصيبة","https://www.aldiwan.net/poem63247.html","الطويل"],[50,"سأترك خالدا لهوى جنان","https://www.aldiwan.net/poem65317.html","الوافر"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43768","الوافر"],[164,"ما فته حظه من أجل الطلبا","https://www.aldiwan.net/poem59115.html","البسيط"],[190,"أقلل طعاما تبت بعافية","https://www.aldiwan.net/poem43638.html","المنسرح"],[240,"إن شئت أن تلثم ثغرا كالدرر","https://www.aldiwan.net/poem31949.html","الرجز"],[275,"حياة الناس تقتير وحرص","https://www.aldiwan.net/poem35180.html","الوافر"],[309,"خل إدكارك ربعا دارس الطلل","https://www.aldiwan.net/poem16847.html","البسيط"],[408,"لفعل الخير تشتمني","https://www.aldiwan.net/poem46451.html","مجزوء الوافر"],[422,"قدمت قدوم الخير من بعد غيبة","https://www.aldiwan.net/poem54122.html","الطويل"],[463,"قم فانتشِطها حسبها أن تعقلا","https://www.aldiwan.net/poem55915.html","الكامل"],[463,"إن كنت ممن يلج الوادي فسل","https://www.aldiwan.net/poem55986.html","الرجز"],[463,"روحها مخمسة خمائصا","https://www.aldiwan.net/poem56149.html","الرجز"],[510,"المفر","https://www.aldiwan.net/poem27797.html","الوافر"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44585","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59293","الوافر"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64888","المجتث"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6749","الوافر"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26425","السريع"],[1807,"","https://poetry.dctabudhabi.ae/diwan/poem/132240","الوافر"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109319","الوافر"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89552","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53237","الوافر"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87503","المجتث"],[3428,"","https://poetry.dctabudhabi.ae/diwan/poem/124017","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89018","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62830","المتقارب"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129362","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91783","الطويل"],[3779,"","https://poetry.dctabudhabi.ae/diwan/poem/141556","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94358","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120211","الوافر"],[5152,"ردٌ باهِت","https://www.poetsgate.com/ViewPoem.aspx?id=184956",""],[5189,"ألاَ أيها العاشقُ","https://www.poetsgate.com/ViewPoem.aspx?id=195285",""],[5781,"تراخى على القدِّ","https://www.poetsgate.com/ViewPoem.aspx?id=211099",""]],"verses":[["فَقَلَّما مَتَّعونا بِالمُناخِ بِكُم","حَتّى اِستَقَلَّت وَقَد شُدَّت بِأَكوارِ",0,"ر",1,0],["فَقَلَّمَا أَبْصَرْتُمُ مَنْظَراً","أَمْلَحَ مِنْ مَنْظَرِ عَيْنِ الْبَذُولِ",1,"ل",1,0],["فَقُل ما أَراكَ اللَهُ إِنَّكَ راشِدٌ","كِلانا مِنَ العَوراءِ بِاللَهِ عائِذُ",2,"ذ",1,0],["فَقُل ماشِئتَ فِيَّ فَلي لِسانٌ","مَليءٌ بِالثَناءِ عَلَيكَ رَطبُ",3,"ب",1,0],["فقلَّما عُدَّ مُخطئاً رجلٌ","قد كثُرَتْ خاطئاتِه صُيَبُهْ",4,"ب",2,0],["فَقُل ما شِئتَ مِن قَولٍ","وَقَدِّر كُلَّ تَقديرِ",5,"ر",1,0],["فَقَلَّما يَلؤُمُ في ثَوبِهِ","إِلّا الَّذي يَلؤُمُ في غِرسِهِ",6,"س",2,0],["فَقُل ما شِئتَ أَقبَلهُ","وَإِن أَطنَبتَ في الكَذِبِ",7,"ب",1,0],["فَقُلْ مَا شِئْتَ في شِعْرِي","وَخَيْرُ الْقَوْلِ أَحْكَمُهُ",8,"م",2,0],["فَقُل مِثلَها يا قَينُ إِن كُنتَ صادِقاً","وَإِلّا فَمِن أَنّى تُنيرُ وَلا تَسدي",9,"د",2,0],["فَقُل مِثلَ ما قالَت بُثَينَةُ إِذ شَكا","جَميلٌ إِلَيها الحُبَّ وَهوَ شَديدُ",10,"د",1,0],["فَقُل مِن بَعدِ ذا ما شِئتَ أَو زِد","فَقَد أَمسَيتَ مِنّي في أَمانِ",11,"ن",1,0],["فَقُل ما أَكدَرَ الدُنيا حَياةً","وَأَسرَعَها إِذا صَفَتِ اِنقِراضا",12,"ض",2,0],["فقل ملن سل سيف البغى يقصدني","أهل علمت لهذا بيننا سببا",13,"ب",2,0],["فقل ما بات مثقلا شره","إلا تشكى لفجأة الوجع",14,"ع",1,0],["فَقَلَّ مَن يَظفَرُ إِلّا مَن صَبَر","أَما سَمِعتَ الصَبرُ عُقباهُ الظَفَر",15,"ر",1,0],["فقل ما أحقر الإنسانَ خَلقاً","وخُلقاً والوَرَى كَلَبٌ وحرص",16,"ص",1,0],["فقلما عاد ما قد فات من زمن","صفا وخل وفي فاقصر ولا تطل",17,"ل",1,0],["فقلْ ما شئتَ في شتمي","فغني الفاعِلُ التَّارِكْ",18,"ك",1,0],["فقل ما تشا والقول في ما تقوله","جليٌّ ويأبى الله أن تتقوَّلا",19,"ل",2,0],["فقلّما يعدَم نُجحَ حاجةٍ","من يقتني الخيلَ لها والإبلا",20,"ل",2,0],["فقلَّ منهم من لوى ندامةً","عِنانَه عن المِصاع فاعتزلْ",21,"ل",1,0],["فقل مطيلاً فيّ أو ملاخصا","تشرِ المنايا من فمي رخائصا",22,"ص",2,0],["فقلْ ما شئتَ لا رُدّت حياةٌ","بها الأعينُ والآذانُ ضرُّ",23,"ر",1,0],["فَقَلَّما يُغنيكَ مَن يَعذِلُ في","ما تَشتَهي حَتّى تُواريكَ الحُفَرْ",24,"ر",1,0],["فقلْ ما شئتَ من لُطْفٍ وَظَرْفٍ","وقلْ ما شئتَ منْ سِرٍّ وَمَعْنَى",25,"ن",2,0],["فقَلَّ ما كُنْتَ فيهِمْ","إِلاّ وبالُكَ كاسِفْ",26,"ف",1,0],["فَقُل ما شِئتَ فيَّ مِنَ المَخازي","وَضاعِفها فَإِنَّكَ قَد صَدَقتا",27,"ت",2,0],["فَقُل مَعاذَ اللَهِ مِن هَفوَةٍ","قالَ فَهَل يَغلَطُ مُستَخبِرُ",28,"ر",1,0],["فقل ما شئت من مدح وشكر","فما دون النبوءة فيه بادي",29,"د",2,0],["فقل ما شئت في نكس لئيم","على عمد النفاق بي خيامه",30,"م",2,0],["فَقُل ما تَشا في مُهجَةٍ قَد تَصَدَّعَت","بِلَوعَةِ مَوتورٍ بِما أَنا واصِفُ",31,"ف",1,0],["فقل ما شئت في صبّ وحانٍ","غدا يستنجد الدمع السخيّا",32,"ي",2,0],["فَقُلَمّا عُيِّنَ المَر","ءُ بل يُذَمُّ اغتيابا",33,"ب",2,0],["فقل ما ترى واترك سواك وما يرى","فتخطئة المخطين أو غيرهم شنعا",34,"ع",2,0],["فقل ما شئت من علم وحلمٍ","وجاه لا يخيب قصد راجي",35,"ج",2,0],["فقُلْ مُبلِغاً لمليكِ الملو","كِ يا عضدَ الدولةِ الأروعُ",36,"ع",1,0],["فقل من سيد نادى عبيداً","عراة الذات من شيم العبيد",37,"د",1,0],["فقل ما تشا في حمده أو مديحه","فلن تبلغ المعشار من شكر نعمة",38,"ه",1,0],["فقل ما يشتهيه النَّاس فيهم","يقولوا فيك حالاً تشتهيها",39,"ه",2,1],["فقلما صبتَ في الدنيا أخا شَرَفٍ","يَرتاد خَيراً لأَوطانٍ واطلالِ",40,"ل",1,0],["فقل ما شئت فيه من مديح","جزيل رق في جزل لطيف",41,"ف",1,0],["فَقُلْ ما شئت مبتهجًا وغرِّدْ","بروحِ السعدِ ، غَرِّدْ للسحابِ",42,"ب",1,0],["فقلْ ما عليك وبحْ لا تخفْ","فكتمُ المشاعرِ كم قاتلُ",43,"ل",1,0],["فَقَلِّمْ بِأَوْداجِ الحَنينِ مراشِفي","فيا طيبَ ما احْلَوْلى وذابَ على الخدِّ",44,"د",1,0]]}