{"poems":[[55,"إنا من الدرب أقبلنا نؤمكم","https://www.aldiwan.net/poem26297.html","البسيط"],[77,"قلت اعشقوا عين البذول التي","https://www.aldiwan.net/poem36128.html","السريع"],[42,"أبلغ أبا الجارود عني رسالة","https://www.aldiwan.net/poem50415.html","الطويل"],[47,"زماني كله غضب وعتب","https://www.aldiwan.net/poem25372.html","الوافر"],[51,"بان شبابي فعز مطلبه وانبت بيني وبينه نسبه","https://www.aldiwan.net/poem8518.html","المنسرح"],[70,"علا حس النواعير","https://www.aldiwan.net/poem42906.html","الهزج"],[43,"أنوك من عبد ومن عرسه","https://www.aldiwan.net/poem9615.html","السريع"],[49,"أوالب أنت في العرب","https://www.aldiwan.net/poem63236.html","مجزوء الوافر"],[87,"عليل أنت مسقمه","https://www.aldiwan.net/poem8277.html","مجزوء الوافر"],[39,"أصاح ألا هل من سبيل إلى هند","https://www.aldiwan.net/poem53784.html","الطويل"],[48,"إذا ما شكا ليم إليك مصيبة","https://www.aldiwan.net/poem63247.html","الطويل"],[48,"سأترك خالدا لهوى جنان","https://www.aldiwan.net/poem65317.html","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43768","الوافر"],[160,"ما فته حظه من أجل الطلبا","https://www.aldiwan.net/poem59115.html","البسيط"],[186,"أقلل طعاما تبت بعافية","https://www.aldiwan.net/poem43638.html","المنسرح"],[235,"إن شئت أن تلثم ثغرا كالدرر","https://www.aldiwan.net/poem31949.html","الرجز"],[270,"حياة الناس تقتير وحرص","https://www.aldiwan.net/poem35180.html","الوافر"],[304,"خل إدكارك ربعا دارس الطلل","https://www.aldiwan.net/poem16847.html","البسيط"],[402,"لفعل الخير تشتمني","https://www.aldiwan.net/poem46451.html","مجزوء الوافر"],[416,"قدمت قدوم الخير من بعد غيبة","https://www.aldiwan.net/poem54122.html","الطويل"],[458,"قم فانتشِطها حسبها أن تعقلا","https://www.aldiwan.net/poem55915.html","الكامل"],[458,"إن كنت ممن يلج الوادي فسل","https://www.aldiwan.net/poem55986.html","الرجز"],[458,"روحها مخمسة خمائصا","https://www.aldiwan.net/poem56149.html","الرجز"],[505,"المفر","https://www.aldiwan.net/poem27797.html","الوافر"]],"verses":[["فَقَلَّما مَتَّعونا بِالمُناخِ بِكُم","حَتّى اِستَقَلَّت وَقَد شُدَّت بِأَكوارِ",0,"ر",1,0],["فَقَلَّمَا أَبْصَرْتُمُ مَنْظَراً","أَمْلَحَ مِنْ مَنْظَرِ عَيْنِ الْبَذُولِ",1,"ل",1,0],["فَقُل ما أَراكَ اللَهُ إِنَّكَ راشِدٌ","كِلانا مِنَ العَوراءِ بِاللَهِ عائِذُ",2,"ذ",1,0],["فَقُل ماشِئتَ فِيَّ فَلي لِسانٌ","مَليءٌ بِالثَناءِ عَلَيكَ رَطبُ",3,"ب",1,0],["فقلَّما عُدَّ مُخطئاً رجلٌ","قد كثُرَتْ خاطئاتِه صُيَبُهْ",4,"ب",2,0],["فَقُل ما شِئتَ مِن قَولٍ","وَقَدِّر كُلَّ تَقديرِ",5,"ر",1,0],["فَقَلَّما يَلؤُمُ في ثَوبِهِ","إِلّا الَّذي يَلؤُمُ في غِرسِهِ",6,"س",2,0],["فَقُل ما شِئتَ أَقبَلهُ","وَإِن أَطنَبتَ في الكَذِبِ",7,"ب",1,0],["فَقُلْ مَا شِئْتَ في شِعْرِي","وَخَيْرُ الْقَوْلِ أَحْكَمُهُ",8,"م",2,0],["فَقُل مِثلَها يا قَينُ إِن كُنتَ صادِقاً","وَإِلّا فَمِن أَنّى تُنيرُ وَلا تَسدي",9,"د",2,0],["فَقُل مِثلَ ما قالَت بُثَينَةُ إِذ شَكا","جَميلٌ إِلَيها الحُبَّ وَهوَ شَديدُ",10,"د",1,0],["فَقُل مِن بَعدِ ذا ما شِئتَ أَو زِد","فَقَد أَمسَيتَ مِنّي في أَمانِ",11,"ن",1,0],["فَقُل ما أَكدَرَ الدُنيا حَياةً","وَأَسرَعَها إِذا صَفَتِ اِنقِراضا",12,"ض",2,0],["فقل ملن سل سيف البغى يقصدني","أهل علمت لهذا بيننا سببا",13,"ب",2,0],["فقل ما بات مثقلا شره","إلا تشكى لفجأة الوجع",14,"ع",1,0],["فَقَلَّ مَن يَظفَرُ إِلّا مَن صَبَر","أَما سَمِعتَ الصَبرُ عُقباهُ الظَفَر",15,"ر",1,0],["فقل ما أحقر الإنسانَ خَلقاً","وخُلقاً والوَرَى كَلَبٌ وحرص",16,"ص",1,0],["فقلما عاد ما قد فات من زمن","صفا وخل وفي فاقصر ولا تطل",17,"ل",1,0],["فقلْ ما شئتَ في شتمي","فغني الفاعِلُ التَّارِكْ",18,"ك",1,0],["فقل ما تشا والقول في ما تقوله","جليٌّ ويأبى الله أن تتقوَّلا",19,"ل",2,0],["فقلّما يعدَم نُجحَ حاجةٍ","من يقتني الخيلَ لها والإبلا",20,"ل",2,0],["فقلَّ منهم من لوى ندامةً","عِنانَه عن المِصاع فاعتزلْ",21,"ل",1,0],["فقل مطيلاً فيّ أو ملاخصا","تشرِ المنايا من فمي رخائصا",22,"ص",2,0],["فقلْ ما شئتَ لا رُدّت حياةٌ","بها الأعينُ والآذانُ ضرُّ",23,"ر",1,0]]}