{"poems":[[74,"في ثغرها الحلو أو في جيدها الحالي","https://www.aldiwan.net/poem19473.html","البسيط"],[72,"أأحبابنا بالله كيف تغيرت","https://www.aldiwan.net/poem42866.html","الطويل"],[63,"أمن رقبة عاف السلام مودعا","https://www.aldiwan.net/poem51570.html","الطويل"],[71,"أشكو إلى الله زماني الذي","https://www.aldiwan.net/poem28836.html","السريع"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85386","الطويل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/30479","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42603","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42610","الطويل"],[139,"للدهر في مسراه سر غريب","https://www.aldiwan.net/poem49188.html","السريع"],[164,"يا بحر قلدت أخاك البحرا","https://www.aldiwan.net/poem59050.html","الرجز"],[173,"ألقت إليك مقادها الأيام","https://www.aldiwan.net/poem1678.html",""],[214,"أدر يا طلعة البدر","https://www.aldiwan.net/poem13362.html","مجزوء الوافر"],[366,"والله لا استطيع صدك","https://www.aldiwan.net/poem68117.html","مخلع البسيط"],[369,"ألا من عذيري من جوى في الجوانح","https://www.aldiwan.net/poem60966.html","الطويل"],[396,"عفيف الدين هل لي من دواء","https://www.aldiwan.net/poem54641.html","عموديه"],[408,"عدمت اللقا إن لم أوافك زائرا","https://www.aldiwan.net/poem46422.html","الطويل"],[422,"لمن أينق يا سعد ترقل أو تخدي","https://www.aldiwan.net/poem53991.html","الطويل"],[505,"برق حماهم ينجلي","https://www.aldiwan.net/poem37805.html","مجزوء الرجز"],[519,"سل ضاحك البرق يوما عن ثناياها","https://www.aldiwan.net/poem20830.html","البسيط"],[520,"تغدو مهابته حجاباً دونه","https://www.aldiwan.net/poem12033.html","الكامل"],[529,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[556,"هي الدار موقوف عليك بكاها","https://www.aldiwan.net/poem47143.html","الطويل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64086","الرمل"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100142","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56288","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56208","الوافر"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65086","الطويل"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137849",""],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132844","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49948","البسيط"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115831","الكامل"],[1600,"","https://poetry.dctabudhabi.ae/diwan/poem/146093","الكامل"],[1713,"","https://poetry.dctabudhabi.ae/diwan/poem/123320","الطويل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109331","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53216","الكامل"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126192","الرجز"],[2462,"","https://poetry.dctabudhabi.ae/diwan/poem/144716","الطويل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106990","الطويل"],[2555,"","https://poetry.dctabudhabi.ae/diwan/poem/147051","الوافر"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87322","الرجز"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130771","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100229","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202782","الوافر"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205037","الوافر"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118825","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100721","الكامل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68023","الكامل"],[3643,"","https://poetry.dctabudhabi.ae/diwan/poem/145183","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91769","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117900","الوافر"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85125","الطويل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125817","الكامل"],[4156,"","https://poetry.dctabudhabi.ae/diwan/poem/45965","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94589","الوافر"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104883","الرجز"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141678","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139486",""],[4790,"من بعض ما قال العراق","https://www.poetsgate.com/ViewPoem.aspx?id=109649",""],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[4927,"لُجَّةُ الأَحْزَاْن","https://www.poetsgate.com/ViewPoem.aspx?id=29830",""],[5136,"بكى سحرة لما تألق باسما","https://www.poetsgate.com/ViewPoem.aspx?id=121672",""],[5186,"جحدوا فضل بني العرب جحودا","https://www.poetsgate.com/ViewPoem.aspx?id=156479",""],[5318,"سلامٌ لإربد","https://www.poetsgate.com/ViewPoem.aspx?id=206943",""],[5324,"متطرف.","https://www.poetsgate.com/ViewPoem.aspx?id=213941",""],[5358,"مجرى الحُب","https://www.poetsgate.com/ViewPoem.aspx?id=183421",""],[5397,"أترع لي في سفحه الأجرع","https://www.poetsgate.com/ViewPoem.aspx?id=157902",""],[5410,"مُباح اللهو في يدنا بناءُ","https://www.poetsgate.com/ViewPoem.aspx?id=152242",""],[5689,"ذروني أقل أن الوجود ظلام","https://www.poetsgate.com/ViewPoem.aspx?id=143424",""],[6031,"لَعِبتْ بعطفيهِ الشمولُ فَمَادَا","https://www.poetsgate.com/ViewPoem.aspx?id=46254",""],[5309,"أحزنت قلبا ليس فيه سوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573869",""],[5190,"إحساس شاعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85055&r=&rc=130",""],[5567,"قالت الشهباء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69064&r=&rc=4",""]],"verses":[["فليفخر الملك بالكافي الذي انْعقدت","عليهِ آراء إجماعٍ وإجمال",0,"ل",1,0],["فَلي فيكَ حُسّادٌ وَبَيني وَبَينَهُم","وَقائِعُ لَيسَت تَنقَضي وَهَزاهِزُ",1,"ز",1,0],["فلي فيكَ من حُسْنِ الثَّناءِ ذَريعَةٌ","تُمَكِّنُ عندي للصَّنيعَةِ مَوْضِعا",2,"ع",2,0],["فليفعلِ الحاسدُ في دهرِهِ","ما شاءَ لا بدَّ وأنْ يلتقيهْ",3,"ي",2,0],["فَلي في مقر الدار زوج وأمها","وَطفل صَغير لَم يزل بعد يرضع",4,"ع",1,0],["فلي في ادِّكارِي بَعْدَ مَوْتي راحةٌ","فلا تمنَعُونيها عُلالَة زاهِقِ",5,"ق",1,0],["فَلْيَفْخَرِ التَّاجُ إِذْ دَارَتْ مَعَاقِدُهُ","عَلَى جَبِينٍ بِنُورِ السَّعْدِ مَغْمُورِ",6,"ر",1,0],["فَلِي فِي مرَادِ الْفَضْلِ خَيْرُ مَغَبَّةٍ","إِذَا شَانَ حَيَّاً بِالْخِيَانَةِ ذَاكِرُ",7,"ر",1,0],["فليفرح الشرق وأبناؤه","وليلقَوا الدهرَ بصدر رحيب",8,"ب",1,0],["فليفخر الشوجين ما شاء فقد","طال على الدنيا جميعا فخرا",9,"ر",2,0],["فَليَفرَحِ البَيتُ العَتيقُ وَزَمزَمٌ","بِقُدُومِهِ وَالحِلُّ وَالإِحرامُ",10,"م",1,0],["فلي فيها هوى عندي","قديم والهوى عذري",11,"ر",2,0],["فَلى فُؤاد يَذوب شَوقاً","اِلَيكَ مَهما ذكرت بعدك",12,"ك",1,0],["فلِي فرسا فاطْرَحْ ولاعِبْ تَغالُبا","إذالَ على كُثْرٍ إذن من مدائحي",13,"ح",2,0],["فلي في فضله طمع كثير","ولي في جوده أحسن رجاء",14,"ا",2,0],["فَلي فيكِ أعداءٌ أحاذرُ كيدَهم","وفيكِ لعمري حُقَّ لي أَنْ أحاذِرا",15,"ر",2,0],["فلي فيهم عقد الولاء وكيف لا","ولم يخلقوا إلاَّ أَولي الحلّ والعقد",16,"د",1,0],["فلي فُؤادٌ قد عَفا","وشَخْصُ جسمٍ قدْ بُلي",17,"ل",2,0],["فليفخرِ الفُرسُ وليزْهوا بسؤدُدِهم","على جميع الوَرى وليَحمَدوا اللّهَ",18,"ه",1,0],["فليفتخر بالشعر غير إنه","حسب لمثلي ليس بالمحسوب",19,"ب",1,0],["فَلِي فُؤاد بِذاكَ الحَيِّ مُرتَهنٌ","سَلا السُّلُوّ وَعانى وَجدَهُ بِهمِ",20,"م",1,0],["فَلي في معاريضِ الكلامِ تَعِلَّةٌ","ومن عِلَلِ الأدواء منه شفاها",21,"ا",3,0],["فليفقْ صبٌّ فإني","كَلِفٌ غيرُ مُفيق",22,"ق",1,0],["فليفخرن بوجوده دهر غدا","أذناً لرائق ما يقول ومسمعا",23,"ع",2,0],["فليفرح المتوكلون عليك يا","ربي ويبتهجوا مدى الأوقاتِ",24,"ت",1,0],["فلي في قاسم الفرسان قسم","لغير مديحه مالي التفاتُ",25,"ت",1,0],["فَلِي فَرْحةٌ في سُكْرِهِ بقَميصِهِ","ولي رَوْعةٌ مِنْ صَحْوِهِ في صَباحياً",26,"ي",2,0],["فليفتخر بك راجيا متضرعا","لك مع ذويك الحفظ والتأييدا",27,"د",2,0],["فلي فيهما قَلبٌ شجاني اشتياقُهُ","ومهجةُ نفسٍ ما أَمَلُّ ادَّكارَهَا",28,"ر",3,0],["فليفخروا وليعزّوا النّاس غيرَهُمُ","بأنهم لَهُمُ ليسو بأندادِ",29,"د",1,0],["فليفخرِ الموتى فقد أضحى لهم","بجوارِه فخرٌ على الأحياءِ",30,"ا",2,0],["فليفترغْ أبكار لذّاتِ المنى","وليضؤع الراقود للناجود",31,"د",1,0],["فلي في محل النجم أذيال همّة","لها بين أثناء الخطوب تعجرف",32,"ف",1,0],["فليفعل الأوغاد ما","شاءوا ودهري ما بدا له",33,"ل",2,0],["فليفدكم من ليس يفرق جهله","ما بين أبكار البلاد وعُونه",34,"ن",2,0],["فليفَربحوا بى وكذا بذِكرِى","فليّتنعَّمثوا فذاك شُكرِى",35,"ر",2,0],["فلي فرحة في سكره بقميصه","وروعاته في الصحو حصت شواتيا",36,"ي",2,0],["فلي في مغانيه عقيلة ربرب","كما طمحت للبرق واردة تعطو",37,"ط",2,0],["فلي في كل غانية مراد","ولي في كل زاوية فؤاد",38,"د",1,0],["فليَفتَقِد في جُملَةِ المَنازِل","ما كان منها مُشرِقاً وآفل",39,"ل",1,0],["فلى في رياض الزهر احسن سلوة","ويا حبذا السلوان في روضة الزهر",40,"ر",1,0],["فلي فوق أكوار المطي تهجر","ولي بين أيدي اليعملات دؤوب",41,"ب",1,0],["فلي في كل يوم منه حسنٌ","وأنغام على التكرار تحلو",42,"و",1,0],["فلي في العيش آمال طوال","تسلسل عن أمان طيبات",43,"ت",1,0],["فليفعلوا ما أرادوهُ ولا حرجٌ","هم أهل بدرٍ فلا يخشوا من التهمِ",44,"م",1,0],["فليفخر القطر الخصيب بناظر","يربي بحكمته على نظاره",45,"ر",2,0],["فلْيفخرِ القطرُ الَّذِي بك فخرُه","إذ بالقِيادِ لطوعِ كَفِّك أَلقَى",46,"ق",2,0],["فلي في مجال الشعر أعلى منصة","بها قد قضى أصل وطبع مريَّض",47,"ض",1,0],["فَلي فيهِ أَحبابٌ قَضى الدَهر بَيننا","وَصَرفُ اللَيالي غبّرت بعدُ حاليا",48,"ي",2,0],["فلي في البحر سفن منشئات","ولي في البر راحلة وزاد",49,"د",1,0],["فلي فيك ظن بل يقين محقق","ومثلك مات يخفاه ما حل في قلبي",50,"ب",2,0],["فليفعلوا ما يشتهون","لكي يقوم الراقد",51,"د",1,0],["فَلي فيكَ يا عَينَ الزَمانِ مَحَبَّةٌ","لَها في فَمي فَرعٌ وَفي مُهجَتي أَصلُ",52,"ل",1,0],["فلي فخرٌ ولكني فأخشى","يُحطُّ مقامهم إن قلتُ أهلا",53,"ل",2,0],["فلي فؤاد فيك قد ذاب أسىً","ودمع عين قط فيك ما جمد",54,"د",1,0],["فلي في نهار جهد سبح وحرفة","وفي ليلتي حبس وحُرف عن السبح",55,"ح",1,0],["فليفز في زفاف غصن معالٍ","وليهنَّى في عرس غرس الثناء",56,"ا",2,0],["فلي في كُلِّ مُعْتَرَكٍ حكايا","تصولُ بيَ المنايا إذْ أَصولُ",57,"ل",1,0],["فلي في معاني شكره كل صورة","لها روح حسن باهر الحسن فتان",58,"ن",1,0],["فَلِيْ فُؤَاْدٌ أَسِيْرٌº ضَمَّهُ قَفَصٌ","مِنْ حُبِّ عَفْرَاْءَ يَسْتَعْصِيْ عَلَى الْخَدَرِ",59,"ر",1,0],["فلي في مغانيه غزال إذا رنا","نضت عينه السوداء أبيض صارما",60,"م",2,0],["فليفد أهل الورى من للورى","كان منا صالحا حرا مفيدا",61,"د",2,0],["فلي في ثراها مقامٌ كريمٌ","ولي في سماها صدى أغنيات",62,"ت",1,0],["فليفهم الباغون ذا","ك على المدى وليعرفوا",63,"ف",3,0],["فَلْيَفْرَحِ الآنَ مَنْ أمسى يُقاطِعُنا","فالحبْلُ ذاكَ بأيدينا قطعْناهُ",64,"ا",2,0],["فليفخر البيت بميلاده","إذ فيه مصباح الهدى يسطع",65,"ع",1,0],["فلي في صحبة القرآن نورٌ","ولي في خشية المولى اتّقاءُ",66,"ا",2,0],["فلي فيهم أم رؤوم بحجرها","تسلمي بعد الرضاع فطام",67,"م",1,0],["فليُفدِ ركنَ الدينِ كلُّ مُبجَّلٍ","لا يستلينُ له الثناءُ قِيادا",68,"د",2,0],["فَليَفرَحِ المَحزونُ إِنَّ لَهُ","يَوم الشَّماتَةِ راحَةً وَدَوا",69,"و",2,0],["فلي في رُباها ذكرياتٌ ، عبيرُها","على البُعدِ فَوَّاحٌ ، وإنْ غِبتُ سرمدا",70,"د",2,0],["فلي في سره رئة","إذا صار الهواء سدى",71,"د",2,0]]}