{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[173,"ما أنصف الطلل العافي بماوانا","https://www.aldiwan.net/poem1685.html",""],[302,"ماست فأزرت بالغصون الميس","https://www.aldiwan.net/poem33241.html","الكامل"],[325,"قل للمعالي ترطب مسمعي طربا","https://www.aldiwan.net/poem67218.html","البسيط"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39233","الكامل"],[2734,"","https://poetry.dctabudhabi.ae/diwan/poem/101411","الكامل"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101627","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100831","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91277","الكامل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107533","الكامل"],[5277,"وقفةٌ على أطلالِ القوافي","https://www.poetsgate.com/ViewPoem.aspx?id=200887",""],[5456,"رحيل يشبه الموت .. !","https://www.poetsgate.com/ViewPoem.aspx?id=198750",""],[1920,"ضوء عائد","https://www.poetsgate.com/ViewPoem.aspx?id=215857",""]],"verses":[["آيَةٌ أَخْفَقَتْ فَقَيَّضَ أُخْرَى","أَثَرٌ مِنْ عِنَايَة الله بَاد",0,"د",1,0],["إِيهاً خَلِيلَيَّ مِن ذُهلِ بنِ ثَعلَبَةٍ","مَن لَم يُهِن نَفسَهُ في حَقِّها هانا",1,"ن",2,0],["إِيهٍ أَخا المَجدِ المؤثَّل وَالعُلى","لِلَّه درُّك من أَديبٍ أَكيسِ",2,"س",1,0],["إيهٍ أَخا الوُدِّ أَن تَطلُبَ لَهُ مَثَلا","فَاِذكُر وَفا النيلِ وَاِستَشهِد بِطيبِ رُبى",3,"ب",2,0],["إيهٍ أُخَيَّ أدرْ عليَّ حَديثَهُمْ","كأْساً ذَكَتْ عَرْفاً وطيبَ مَذاقِ",4,"ق",1,0],["إيهٍ أخا النصح المبين فهات لي","ما يستطاب لدي ذوي الأحجاء",5,"ا",2,0],["إيه أخا اللوردات كعبة فخرهم","محلي الأنساب من أحسابه",6,"ب",2,0],["ايها خليفة كامل في امة","ان قدتها نحو الردى لا تحجم",7,"م",1,0],["أَيه أُخَيّ وَللزمان تصرّفٌ","لا يَستقرّ بإخوة ورفاق",8,"ق",1,0],["إيه أخيَّ قد استرحت من العنا","وجهادِ عيشٍ لم تذق لذاته",9,"ت",2,0],["إيهٍ أُخيَّ وبعضُ الآهِ مُوجِعةٌ","كأنَّها السوطُ فوقَ الظهرِ قدْ جلدا",10,"د",2,0],["إيهٍ أخيّ فهل أدركت غربتنا ؟!","لما رحلت وهل تدري بمجناكا ؟!",11,"ك",2,0],["إيهٍ أخي من يرفض الأصحابَ إن","عادوا إليه وأقبلوا، من يرفضُ؟",12,"ض",1,0]]}