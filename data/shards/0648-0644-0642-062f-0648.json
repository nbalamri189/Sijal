ْصَفِ",107,"ف",1,0],["وَلَقَد وَضَعتُكَ غيرَ مُتَّرِكٍ","من جابرٍ في بَيتِها الضَخمِ",108,"م",1,1],["ولقد وردت عليه إثر مشقةٍ","فدحتْ وفلبي في جناحي طائرِ",109,"ر",1,0],["ولقد وقفتُ بها أسائل رسمها","تَسْآلَ مقروحٍ الجوانح مُثْكَلِ",110,"ل",1,1],["ولقد وقفت لدى الضريح كئيبة","أرثي وتسعفني الحمائم راثيه",111,"ي",2,0],["ولقد وقعت وكنت مذ زمن","أَتَصَيَّدُ الغزلان بالغزل",112,"ل",1,0],["وَلَقَد وَجَدتُ لفاضِلٍ مِنهُم مَقَا","ماً قَامَهُ في النَّاسِ مُنذُ زَمَانِ",113,"ن",1,0],["ولقد وصفت طريق مسكنها فان","رمت الوصال فلا تكن بالواني",113,"ن",2,0],["ولقد وقفت فما وقفن مدامعي","في دار زينب بل وقفن ربابا",114,"ب",2,0],["ولقد وليت إمارةً فرجَعتُها","في المال سالمةً ولم أتموّلِ",115,"ل",1,1],["وَلَقَد وَرَدتَ الماءَ لَم يَشرَب بِهِ","بَينَ الرَبيعِ إِلى شُهورِ الصَيِّفِ",116,"ف",1,0],["وَلَقَد وَرَدتَ الماءَ فَوقَ جِمامِهِ","مِثلُ الفَريقَةِ صُفِّيَت لِلمُدنَفِ",116,"ف",1,0],["ولقد وقفت على ثرى في كربلا","أبكي ودمع العين ليس بنافد",117,"د",1,0],["ولقد وقفت اليوم وقفة حازم","ضربت له فوق السماك خيام",118,"م",1,0],["ولَقدْ وردْتُ مياهَ مارِبَ حُفَّلاً","وأَسَمْتُ خيلي وسْطَ جنَّةِ عبقرا",119,"ر",2,0],["وَلقَدٍّ وَشعرِهِ وَالمُحيّا","أَشبَهَت خُوطةٌ وَلَيلٌ وَبَدرُ",120,"ر",1,0],["وَلَقَد وَقَفتُ النَفسَ عَن حاجاتِها","وَالنَفسُ حاضِرَةُ الشُعاعِ تَطَلَّعُ",121,"ع",1,1],["ولقد وقفت على الديار مسائلا","عن اهلها بطوامس الاطلال",122,"ل",1,0],["ولقد وقفت بباب عفوك راجياً","محو الذنوب ورحمةً ومنائي",123,"ا",2,0],["ولقد وفيت بما وفيت وربما","لقي الكريم جزا الوفاء فعادا",124,"د",2,0],["ولقد وصفت وأنت أبلغ واصف","أحد الحسامين المشرّف محملا",125,"ل",2,0],["ولقد وردت على مناهل فضله","فصدرت ريانا ولست بصادر",126,"ر",1,0],["ولقد وقعتَ بأرضِ بابلَ وقعةً","طارتْ لها سِنَةُ الزّمانِ الغافلِ",127,"ل",1,0],["ولقد وصفت لعاذلي من حسنه","طرفا فود بأنّه لم يعذل",128,"ل",1,1],["وَلَقد وَفَدت عَلَيك أَشكو حالَتي","لِلّه ثُم إَلَيكَ باسترحام",129,"م",1,0],["ولقد ودّعت لمّا ودّعوا","مهجتي الحرّى وصبري واحتمالي",130,"ل",2,0],["ولقد وقفت اليوم موقف شاعر","غرد يحيى العلم في أبطاله",131,"ل",2,0],["وَلَقَد وَردتُ مجرّةً من نشوةٍ","وقنصتُ غادتَها ورُعتُ غضنفرا",132,"ر",2,0],["وَلَقَد وَقَفتُ عَلى المَعاهِدِ سائِلاً","عَهدَ الشَبابِ وَخابَ مَن لَم يَسألِ",133,"ل",1,0],["ولقد وجدت الصبر بعدكمُ","صعباً وكنت أظنّه سهلا",134,"ل",2,1],["ولقد وقفت أمام رمسك باكياً","حتى حسبت صفيحه يبكي معي",135,"ع",2,0],["وَلَقَد وَرَدنَ بِنا المَدينَةَ شُزَّباً","وَلَقَد قَتَلنا بِجَوِّها الأَنصارا",136,"ر",2,0],["ولقد وقفت وللصوارم رنة","غنى الحمام بها غناء حمام",137,"م",1,0],["ولقد وقفت بها وصحبي نوم","إلا خليلي النجم بات مسهدا",138,"د",2,0],["ولقد وقفت ببابه أنا والورى","كل تحير عن مداه وفصرا",139,"ر",2,0],["وَلَقَد وافاه قبلا احمد","باذلا فيها المهور الغالية",140,"ه",1,0],["ولَقَد وَثقنا بالمَقاماتِ العُلى","ومَنالُ زَفسٍ صادِقُ الأَنبَاءِ",141,"ا",2,0],["وَلَقَد وَقاها مِن عِداها علمهُ","لَمّا غَذاها منعماً بلبانِهِ",142,"ن",2,0],["وَلَقَد وَعَدتَ إِجابَة الداعي","وَمِنكَ الوَعدُ لا يَفضي إِلى الاِخلافِ",143,"ف",1,0],["ولقد وقفت به ومعتلج الجوى","بجوانحي عن حبس دمعي مقعدي",144,"د",2,0],["ولقد وردتُ فِناءَ بحرٍ للندى","أَغنى بهِ عن أَنهرٍ وجداولِ",145,"ل",1,0],["ولقد وجدتُ بمُقلتيه وقدِّه","ما قد وجدتُ بسَيفه وسنانه",146,"ن",2,0],["ولقد وعدتم أن تعودوا سقمَهُ","فنبذتموه في شكايته سدى",147,"د",2,0],["وَلَقَد وَقَفتُ بِبابِ عَفوِكَ راجِياً","مِنكَ الرِضى يا أَرحَمَ الرُحَماءِ",148,"ا",2,0],["ولقد وقفت ببابها متمثلا","ما وفي وقوفك ساعة من باس",149,"س",1,0],["ولقد وقفنا اليومَ نُحْيِي حفلةً","للفائقاتِ بها جرَى تكريمُ",150,"م",1,0],["ولقد وقفت على علاك قصائدي","وقفا تسجل حكمه العلياء",151,"ا",2,0],["ولقد وهبتُكَ ضيَّ عيني كلَّهُ","وسَلْ البرايا كلها .. مَن مؤنسي؟",152,"ي",1,1],["ولقد وقفتُ على الدّيار مودعاً","متألّماً متوجّعاً متحرّقا",153,"ق",2,0],["ولقد وجدتُ مِنَ الوِصالِ بواعِثاً","شبّتْ أريجَ الشِّعرِ في أرجائِيْ",154,"ا",2,0],["ولقد وردت الماء أنهل عذبه","فرويت منه وما اجتديت بخيلا",155,"ل",2,0],["ولقد وجهت إلي بحوث","قبل عنه فكان عذري ابتلائي",156,"ا",2,0],["ولقد ورثنا الحَقَّ فيكِ عن الجُدودِ","فنحنُ نَحنُ الأهلُ والأصحابُ",157,"ب",1,0],["ولقدْ وجدتُ محبتي فيهِ انتهت","طوبى لصبٍّ ...للنبيِّ تودَّدا",158,"د",2,0],["ولقد وصفتك بالبحور جميعها","لكنّ وصفك بالطويل الأطيبُ",159,"ب",1,0],["ولَقَدْ وَقَفْتُ فَهَاجَ لِي هَذَا الوُقُو","فُ مَوَاجِعًا مِنْ هَوْلِهَا لَمْ أَنْبِسِ",160,"س",1,0],["ولقد وجدت لبينكم يا سادتي","ما أزعج القلب المشوق وأقلقا",161,"ق",2,0],["وَلَقَدْ وَقَفْتُ بِدارِها مِنْ بَعْدِ ما","دَرَسَتْ فَلاحَتْ كالوَحِيِّ رُسُومُها",162,"م",3,0],["ولقد وقفت على هواك مدامعي","فعلام روض الود منك لقد ذوى",163,"و",2,0],["ولقد وقفتَ وأنتَ تسري للعلا","في موقفٍ تخشى به الشجعان",164,"ن",1,0],["ولقد وقَفْتُكِ ما تبقى للهوى","ومشاعراً مُزجت بماء الأعينِ",165,"ن",1,0],["ولَقَدْ وقَفْتُ ببابِ جُودِكَ سَائِلاً","في حَاجَةٍ زَمَناً منَ الأزْمَانِ",166,"ن",1,0],["ولقد وَهَمْتُ بأنّ حبّك ماتِعٌ","يشفي السَقامَ ويُسعد الألبابا",167,"ب",2,0],["ولقَدْ وقَفْتُ بحِيْرَةٍ لوَدَاعِهِمْ","ولَدَيَّ عِنْدَ ودَاعِهِمْ أقْوَالُ",168,"ل",1,1],["وَ لَقَدْ - وَ قَدْ عادَ الحَبِيبُ - تَبَسَّمَتْ","دُنيايَ , وَ امتَزَجَ الرَّحِيقُ مَعَ العَسَلْ",169,"ل",1,0],["ولقد وجدتُ الأنس عند ضريحكم","وشممت من بين الصخور عبيرا",170,"ر",2,1],["ولقد ورثت مقام قوم يستوي","منهم شبابٌ في العلى زكهول",171,"ل",1,0],["ولقد وفى لك من صنائعك امرؤٌ","بثنائه تستمع السمار",172,"ر",1,0]]}