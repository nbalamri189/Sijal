{"poems":[[93,"مازال يمشي في الأمور بفكره","https://www.aldiwan.net/poem62771.html","عموديه"],[82,"ملك جديد مثل طبع المنصل","https://www.aldiwan.net/poem31324.html","الكامل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16703","الكامل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16699","السريع"],[93,"الفردوس الضائع","https://www.poetsgate.com/ViewPoem.aspx?id=53312",""],[147,"ما ذي المساعي الغر في قدر الورى","https://www.aldiwan.net/poem11761.html","الكامل"],[463,"ما ليلتي على أقر","https://www.aldiwan.net/poem56186.html","مجزوء الرجز"],[1421,"","https://poetry.dctabudhabi.ae/diwan/poem/117101","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60843","البسيط"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108234","البسيط"],[5956,"خالد باعشن مقدَّسٌ في نفسي كقداسة الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=193793",""]],"verses":[["ما ذي الفَظاظَةُ قالَ وِليَمُ وَاِنثَنى","لِليَأسِ كَالمَصفودِ في الأَقرانِ",0,"ن",1,0],["ماذيّةٌ يشكو لِكَثرَةِ لَحمِها","ضُرّاً بلا نفعٍ لسانُ المُنْصُلِ",1,"ل",1,0],["ماذِيّةٌ أبَتِ الجوارسُ قُرْبَها","لكِنْ قَوارِسُ فُلّلَتْ بوِقاعها",2,"ع",3,0],["ماذِيّةٌ هَمّ بها عاسِلٌ","من القَنا لا عاسِلٌ من هُذَيْل",3,"ل",1,0],["ما ذي الفظاظة ؟ قال((وليم)) وانثنى","لليأس كالمصفود في الأقرا",4,"ر",2,0],["ما ذي المَساعي الغُرُّ في قَدرِ الوَرى","فَلِذاكَ نَحنُ نَظُنُّ يَقظَتَنا كَرى",5,"ر",2,1],["ما ذيَّل النيروزُ في","ثوبِ الرياض وخَطَرْ",6,"ر",1,0],["ما ذي الجبانة يا طليان لا رفعت","من بعدها لكم نحو العلا قمم",7,"م",1,0],["مَا ذي الجنائب ما هذه العجائب ما","هذي الكتائب والأوضاح والغرر",8,"ر",1,0],["ما ذي الغصون التي في آخر الزمن","أبصرتها في مكان زاهرٍ حسنِ",9,"ن",1,1],["ماذ يُضِيره أن أعيش جواره","وأحبه كأبيه طيلة درْبِِهِ؟",10,"ب",2,0]]}