{"poems":[[88,"حبس اللسان وأطلق الدمعا","https://www.aldiwan.net/poem10350.html","الكامل"],[75,"أضحى التنائي بديلا من تدانينا","https://www.aldiwan.net/poem11836.html","البسيط"],[87,"قد كنت أوثر أن تقول رثائي","https://www.aldiwan.net/poem62927.html","الكامل"],[68,"غير مجد مع صحة وفراغ","https://www.aldiwan.net/poem38483.html","الخفيف"],[68,"كان الزمان بلقياكم يمنينا","https://www.aldiwan.net/poem40132.html","البسيط"],[107,"حيوا الهلال وحيوا أمة النيل","https://www.aldiwan.net/poem43087.html","البسيط"],[107,"يا بني النيل تقضى صومكم","https://www.aldiwan.net/poem43154.html","الرمل"],[111,"لا تكترث بالليالي إنها دول","https://www.poetsgate.com/ViewPoem.aspx?id=519",""],[371,"برذوننا اليوم ما به عجب","https://www.aldiwan.net/poem17361.html","المنسرح"],[409,"حتى م ذا الدهر بالتشتيت يرمينا","https://www.aldiwan.net/poem33381.html","الرمل"],[469,"ديار هند أقفرت منذ أزمان","https://www.aldiwan.net/poem3492.html","عموديه"],[580,"لا تسل عنه كيف أصبح حاله","https://www.aldiwan.net/poem3028.html","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79984","الكامل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114736","البسيط"],[1997,"","https://poetry.dctabudhabi.ae/diwan/poem/202559","الكامل"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76794","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111423","الرجز"],[5732,"الملحمة الزايدية","https://www.poetsgate.com/ViewPoem.aspx?id=177865",""],[6096,"رجلٌ أنا","https://www.poetsgate.com/ViewPoem.aspx?id=177138",""],[6142,"من فالق الكبش من قرن إلى قدم","https://www.poetsgate.com/ViewPoem.aspx?id=155714",""]],"verses":[["غيظُ العِداةُ فَحاوَلوا سَفَهاً","مِنهُم لِحَبلِ وِدادِنا قَطعا",0,"ع",2,0],["غيظَ العِدا مِن تَساقينا الهَوى فَدَعَوا","بِأَن نَغَصَّ فَقالَ الدَهرُ آمينا",1,"ن",2,0],["غيظَ الحَسودُ لَها وَقُمتُ بِشُكرِها","وَكَما عَلِمتَ مَوَدَّتي وَوَفائي",2,"ا",2,0],["غَيظُ أَهلُ النِفاقِ مِنكَ وَأَمسى","كُلُّ ضارٍ مِن خَوفِهِ وَهوَ صاغِ",3,"غ",1,0],["غَيظَ العِدى مِن تَساقينا الهَوى فَدَعوا","بِأَن نَغَصَّ فَقالَ الدَهرُ آمينا",4,"ن",2,0],["غيظَت قُرَيشٌ فَهاجَت كُلَّ مُنصَلِتٍ","ذي ساعِدٍ يَقطَعُ الهِندِيَّ مَفتولِ",5,"ل",1,0],["غيظَتِ الأَنواءُ مِمّا اِنهَمَرَت","في يَدِ المُختارِ أَيدي الكُرَماء",6,"ا",2,0],["غيظ الزمان اذا عز الكرام به","غيظ المفاخر تعطو نحوها السفل",7,"ل",1,0],["غَيظاً وَنارُ المُغتاظِ موقَدَةٌ","وَغَيرُ أَقلامِهِ لَها الحَطَبُ",8,"ب",1,0],["غيظ العدا من تساقينا اللقا فدعوا","بأن نغص فقال الدهر آمينا",9,"ن",2,0],["غيظ الحسودِ وجنون الغيران","ذات نهى صاحٍ وعطفٍ نشوان",10,"ن",1,0],["غِيظَ منه ظَبيٌ وغصنٌ إِلى أَنْ","شَفَّ ذائبُه وبَانَ هُزَالُه",11,"ل",2,0],["غيظُ الحسود إذا بدا","شرقُ الخصيم إذا تفوَّه",12,"و",2,0],["غَيظَ على كَيدِهِ ولكِن","لم يُذهِبِ الكَيدُ ما يَغيظُ",13,"ظ",1,0],["غيظا لسني يحرم شربها","بعد الصلاة وغيظ آخر شيعى",14,"ع",2,0],["غَيظُ بنُ مُرَّة عندَ كاظِمةَ اعتَلَى","إذ كانَ تَغنُظُهُ الخطوبُ فيَحلُمُ",15,"م",1,0],["غَيظاً على أَبيهِ فيلاوُسَ مَن","كان حبيبَ زَفسَ في ماضي الزَّمَن",16,"ن",1,0],["غيظ مخيف يطحن الغيظ","والغضب وماطال من روس الخشوم طماه",17,"ا",2,0],["غيظٌ شعورٌ بالحماقةِ مُفعمٌ","لمّا انتشى بالنّصرِ ..زادَ تبرُّما",18,"م",2,0],["غيظ النبي فنادى يا علي ألا","خذ رايتي أنت أولى أمتي فيها",19,"ي",3,0]]}