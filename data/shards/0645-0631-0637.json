{"poems":[[4,"ولئن كبرت لقد عمرت كأنني","https://www.aldiwan.net/poem21275.html","الكامل"],[47,"إن شعري سار في كل بلد","https://www.aldiwan.net/poem63530.html","البسيط"],[422,"سعدت نجد إذا وافيت نجدا","https://www.aldiwan.net/poem54161.html","الرمل"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2452","الخفيف"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[243,"سراج","https://www.poetsgate.com/ViewPoem.aspx?id=50494",""]],"verses":[["مَرِطُ القَذاذِ فَلَيسَ فيهِ مَصنَعٌ","لا الريشُ يَنفَعُهُ وَلا التَعقيبُ",0,"ب",1,0],["مِرطُ عَثّامَةَ مَسدولٌ عَلى","كَفَلٍ مِثلَ الكَثيبِ المُلتَبِد",1,"د",1,0],["مرُّ طعم السُّخط حلويّ النَّدى","يجتني المشتار من أيدي شهدا",2,"د",2,0],["مَرَطى الشَدِّ كَالعُقابِ تَدَلَّت","بَينَ نيقَينِ مِن رُؤوسِ الجِبالِ",3,"ل",1,0],["مرطباً واختم بقطٍّ واعتمد","في عقدها ما كان في الها قد عُهِد",4,"د",1,0],["مرَ طيفاً كلمحة البرقِ يسري","في قرونٍ مرت كمرِّ الثواني",5,"ن",2,0],["مر طيف من الحبيبة يهفو","للقاء المعذب المستضام",6,"م",1,0]]}