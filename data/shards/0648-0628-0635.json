 الفتان","https://www.aldiwan.net/poem14758.html","الكامل"],[235,"أمط اللثام عن العذار السائل","https://www.aldiwan.net/poem31792.html","الكامل"],[237,"إلى السادة الأمجاد والقادة الغر","https://www.aldiwan.net/poem18821.html","الطويل"],[259,"قم نحو حماه وانصرف","https://www.aldiwan.net/poem35942.html","المتدارك"],[261,"إنا لتقتلنا العيون","https://www.aldiwan.net/poem38164.html","مجزوء الكامل"],[304,"يا سائلي عن عبرتي ومدامي","https://www.aldiwan.net/poem16845.html","الخفيف"],[304,"بنفس أفدي خير من وطئ الثرى","https://www.aldiwan.net/poem16863.html","الطويل"],[342,"مهلا ممرضة المشوق العاني","https://www.aldiwan.net/poem55312.html","الكامل"],[348,"حصل العز لها مذ خطبت","https://www.aldiwan.net/poem20702.html","الرمل"],[349,"مر بي بالآب والإبن","https://www.aldiwan.net/poem15641.html","مجزوء الرمل"],[349,"لمغيب قلبي في هواكم مشهد","https://www.aldiwan.net/poem15644.html","الكامل"],[349,"شاغل القلب هوى عذب اللمي","https://www.aldiwan.net/poem16030.html","الرمل"],[391,"يا أهل العقول السالمه وأهل القلوب العالمه","https://www.aldiwan.net/poem54450.html","عموديه"],[405,"وبصير بمعاني الشعر","https://www.aldiwan.net/poem49609.html","مجزوء الرمل"],[416,"من لصب مستطار القلب هائم","https://www.aldiwan.net/poem53954.html","الرمل"],[416,"لمن السوابق والجياد الضمر","https://www.aldiwan.net/poem54183.html","الكامل"],[429,"عوفي الندى والمجد والأدب","https://www.aldiwan.net/poem40710.html","أحذ الكامل"],[429,"لله خير جراءة","https://www.aldiwan.net/poem40718.html","مجزوء الكامل"],[439,"أقدمت دون معالم الإسلام","https://www.aldiwan.net/poem34781.html","الكامل"],[441,"صب صبته إلى ليلى صبابته","https://www.aldiwan.net/poem14340.html","البسيط"],[441,"خل الكئيب بدائه في ذاته","https://www.aldiwan.net/poem14341.html","الكامل"],[443,"لله في ذا الخلق أح","https://www.aldiwan.net/poem56058.html","عموديه"],[452,"برح الخفاء فما ذكاء إياس","https://www.aldiwan.net/poem13807.html","الكامل"],[458,"من العار لولا أن طيفك يطرق","https://www.aldiwan.net/poem56098.html","الطويل"],[458,"بلوت هذا الدهر أطواره","https://www.aldiwan.net/poem56171.html","السريع"],[500,"القلب يفزع في المهمة ضارعا","https://www.aldiwan.net/poem37696.html","الكامل"],[540,"وبصرتني بعد خبط الغشوم","https://www.aldiwan.net/poem56871.html","المتقارب"],[551,"يا راكبا وصل الوجيف ذميله","https://www.aldiwan.net/poem47335.html","الكامل"],[558,"إلى الله نرفع أمرا ألم","https://www.aldiwan.net/poem34070.html","المتقارب"],[558,"لي رتبة العلامة الشهم الأَسد","https://www.aldiwan.net/poem34635.html","الكامل"]],"verses":[["وَبَصبَصنَ بَينَ أَداني الغَضا","وَبَينَ عُنَيزَةَ شَأواً بَطينا",0,"ن",2,0],["وَبَصُرتُ بِالبُردَينِ إِرثِ مُحَرِّقٍ","لَم تَخلُقا إِذ تَخلُقُ الأَبرادُ",1,"د",1,0],["وَبِصَوْتِهَا التَّطْرِيبُ يَصْدُرُ","عَنْ نَبِيهِ الوَحْيِ عَالِي",2,"ي",1,0],["وَبِصَرفٍ كَأَنَّها أَلسُنُ البَر","قِ إِذا اِستَعرَضَت رَقيقَ السَحابِ",3,"ب",1,0],["وبصحن ذاكَ الخدِّ من قبل","نقلي ومن رشفاته شربي",4,"ب",2,0],["وَبَصُرتُ بِالدُستورِ يُز","هَقُ وَهوَ في عُمرِ الفَطيمِ",5,"م",1,0],["وبُصِّرَ محجوبُ البصائر أكْمَهٌ","وأُسمِعَ مشدودُ المسامِع أصلخُ",6,"خ",1,0],["وَبَصبَصَ أَهلُ العَيثِ حينَ هَداهُمُ","أَخو سَطَواتٍ ما يُبِلُّ سَليمُها",7,"م",3,0],["وَبَصَرتَ بِالوُزراءِ حَولَكَ خُشَّعاً","تُمضي أُمورَ المُلكِ في الإيوانِ",8,"ن",1,0],["وبَصَّرَهُ حتى رأى كلَّ غائبٍ","وصار سواءً عندهُ القُرْبُ وَالبُعْدُ",9,"د",1,0],["وَبَصِيرَةٌ باللَّهِ يُشْرِقُ نورُها","ويُضِيءُ مثلَ الكَوْكَبِ المُتَوَقِّدِ",10,"د",1,0],["وَبَصيرُ الأَقوامِ مِثلِيَ أَعمى","فَهَلِمّوا في حِندِسٍ نَتَصادَم",11,"م",1,0],["وبَصَّرْتَهُ لَّما تَصَعَّرَ خدُّهُ","بأنَّكَ أعلْى من أخادِعِهِ كَعْبا",12,"ب",2,0],["وبَصَّرتكَ بأطباع يَضيقُ بها","صدرُ الحليم وتأباه مَزاياه",13,"ا",2,0],["وَبصنوه عُثمان ذي الن","نورَين أَقوم مَنهَجِ",14,"ج",1,0],["وبصون سربلت عيسى وموسي","قبل قد فاز باليد البيضاء",15,"ا",2,0],["وَبِصَدرِكَ القَلبُ الَّذي لَمّا يُرَع","وَبِكَفِّكَ العَضبُ الَّذي لا يَكهَمُ",16,"م",1,0],["وَبِصَدرِكَ القَلبُ الَّذي لَمّا يُرَع","وَبِكَفِّكَ السَيفُ الَّذي لَم يَكهَمِ",17,"م",1,0],["وبصّره بالفكر ما كان عله","عليه الهوى والمشكلات الغرائب",18,"ب",1,0],["وَبصدّيقكَ الكبيرِ إمام الص","صحبِ والكلّ سادةٌ كبراءُ",19,"ا",2,0],["وبصَدري سرٌّ دَفينٌ فوا","خوفي عليهِ من قلبيَ المتبولِ",20,"ل",1,0],["وبصدغٍ معقربٍ فوق خدٍّ","صاحت الملقلتانِ منه السلاحا",21,"ح",2,0],["وبَصَّرَهُمْ بعدَ طولِ العَمَى","وقَوَّمَ بالعَدْل مُنْهالَها",22,"ل",3,0],["وَبِصُلبِ آدَمَ كانَ وَقت هُبوطِهِ","وَبِصُلبِ نوحٍ وَهوَ في الطوفانِ",23,"ن",1,0],["وَبِصُلبِ إِبراهيمَ حينَ رَمى بِهِ","في نارِهِ أَشقى بَني كَنعانِ",23,"ن",1,0],["وَبِصُفرَةِ المَنثورِ مِنهُ وَحُمرَةِ ال","وَردِ الجَنِيِّ وَخُضرَةِ الرَيحانِ",24,"ن",1,0],["وَبِصامِتٍ مُنذُ اِحتَوَتهُ بَنانُهُ","فَخِرَ اليَراعُ عَلى الوَشيجِ الذابِلِ",25,"ل",1,0],["وَبَصَّرَنَا مِنْ بَعْدِهِ بِمَصِيرِهِ","فَنَعْمَلَ لِلْأُخْرَى عَلَى حَسَبِ الأَمْرِ",26,"ر",1,0],["وبصالح أهل الأرض ومن","هو فيهم كالروض الأُنُف",27,"ف",1,0],["وبصدره الصامي عمادي","هجان لا هجين",28,"ن",1,0],["وبصائر وسرائر وضمائر","وخواطر جوالة في المبدع",29,"ع",1,0],["وبصلح ولاة الأمر عند فسادهم","ويقظهم للعدل من سنة القرى",30,"ر",2,0],["وبصوتك العذب الجميل ورقة","في وجنتيك تذوب من تحناني",31,"ي",1,0],["وَبِصَدْر الدّين مُلِّيتَ ولا","زِلْتَ تَحوِى منهُ صَدْراً سَالِماَ",32,"م",2,0],["وَبِصِدغي بَينَ صُب","حَينِ بِهِ لِلرُشدِ فَقدُ",33,"د",1,0],["وَبِصينِ أَهلِ الصينِ مَنزِلٌ غَيبِها","لِلشاهِدينَ عَلى الشَهادَةِ مَشهَدُ",34,"د",1,0],["وَبِصَونِ السِرِّ صُم عَمرُكَ لي","وَاِخفِني قَبلَ الدُعا عَن داعِيَي",35,"ي",1,0],["وبصدق نيه جازمه","يا الله بحسن الخاتمه",36,"ه",1,0],["وبَصير بمَعاني الشِّعْرِ","والإعْرابِ جِدّا",37,"د",2,1],["وبصدْري زفرة لو كُشِفَتْ","للصَّبا يومئذٍ هَبَّتْ سمائم",38,"م",1,0],["وبصحبة النَّاصرين لدينه","من أوضحوا سبل الهُدى إذ أظهروا",39,"ر",3,0],["وبصحة الجسم الشريف لقد","صح الزمان وأقبل الطلب",40,"ب",1,0],["وبصدرها الفضيّ را","حة كل ذي قلبٍ كئيبِ",41,"ب",1,0],["وبَصُرْتَ من خَلَلِ التَجمُّلِ خَلَّتي","وفَهِمْتَ من صمتِ الحياءِ كلامي",42,"ي",1,0],["وبصبص الأسد الضاري لهيبته","وأفكلت حية الوادي مهابته",43,"ت",2,0],["وبصحف إبراهيم عظم قدره","وزبر داود لدى تلواته",44,"ت",2,0],["وبصدره كمنت نيو","ب الصل تنهش ان قنط",45,"ط",1,0],["وبَصارة في المُشْكِلاتِ تكفّلَتْ","منها بدفعِ مواقِعِ الإِلباس",46,"س",1,0],["وبصّرني بالناس قلبٌ ممرَّنٌ","ولحظٌ على ظنّ العيون محقِّقُ",47,"ق",1,0],["وبصَّرتْني كيف أخلاقُه","تجاربٌ كشَّفن أخبارَهْ",48,"ر",2,0],["وبصحبه الزهر الجحاجحة الأسو","دِ القائمين بنصر ما أبداه",49,"ا",2,0],["وَبَصَّرتَني بَعدَ خَبطِ الغَشو","مِ هَذي العجافَ وَهَذي السَحاحِا",50,"ح",2,1],["وبصيرتي يوم الهياجِ بصيرةٌ","والنَّقْعُ مُرْخىً في الوجوه سُدولُهُ",51,"ل",2,0],["وبصرتنا بالتجلي وفي","بصائرنا نورك المحض تم",52,"م",1,0],["وبصيرهم عين العلا وسميعهم","هم نابتون عليه وهو ربيعهم",53,"م",1,0]]}