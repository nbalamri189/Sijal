2980",""],[5956,"يا بعيدين","https://www.poetsgate.com/ViewPoem.aspx?id=182132",""],[5956,"الرسالة المحمدية","https://www.poetsgate.com/ViewPoem.aspx?id=184653",""],[5956,"بركات خالد","https://www.poetsgate.com/ViewPoem.aspx?id=193795",""],[5956,"مثل انبثاق الفجر صوت محمد","https://www.poetsgate.com/ViewPoem.aspx?id=194380",""],[5956,"مِن معجزاتك يا إلهي","https://www.poetsgate.com/ViewPoem.aspx?id=200035",""],[161,"الغليان","https://www.poetsgate.com/ViewPoem.aspx?id=152728",""],[1362,"لله أيام لنا","https://www.poetsgate.com/ViewPoem.aspx?id=127725",""],[6102,"مفعول عكسي !!","https://www.poetsgate.com/ViewPoem.aspx?id=185062",""],[6108,"رحلة","https://www.poetsgate.com/ViewPoem.aspx?id=192588",""],[5724,"أم الربيعين ابسمي وتهللي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55135&r=&rc=2",""]],"verses":[["وَبَصبَصنَ بَينَ أَداني الغَضا","وَبَينَ عُنَيزَةَ شَأواً بَطينا",0,"ن",2,0],["وَبَصُرتُ بِالبُردَينِ إِرثِ مُحَرِّقٍ","لَم تَخلُقا إِذ تَخلُقُ الأَبرادُ",1,"د",1,0],["وَبِصَوْتِهَا التَّطْرِيبُ يَصْدُرُ","عَنْ نَبِيهِ الوَحْيِ عَالِي",2,"ل",2,0],["وَبِصَرفٍ كَأَنَّها أَلسُنُ البَر","قِ إِذا اِستَعرَضَت رَقيقَ السَحابِ",3,"ب",1,0],["وبصحن ذاكَ الخدِّ من قبل","نقلي ومن رشفاته شربي",4,"ب",2,0],["وَبَصُرتُ بِالدُستورِ يُز","هَقُ وَهوَ في عُمرِ الفَطيمِ",5,"م",1,0],["وبُصِّرَ محجوبُ البصائر أكْمَهٌ","وأُسمِعَ مشدودُ المسامِع أصلخُ",6,"خ",1,0],["وَبَصبَصَ أَهلُ العَيثِ حينَ هَداهُمُ","أَخو سَطَواتٍ ما يُبِلُّ سَليمُها",7,"م",3,0],["وَبَصَرتَ بِالوُزراءِ حَولَكَ خُشَّعاً","تُمضي أُمورَ المُلكِ في الإيوانِ",8,"ن",1,0],["وبَصَّرَهُ حتى رأى كلَّ غائبٍ","وصار سواءً عندهُ القُرْبُ وَالبُعْدُ",9,"د",1,0],["وَبَصِيرَةٌ باللَّهِ يُشْرِقُ نورُها","ويُضِيءُ مثلَ الكَوْكَبِ المُتَوَقِّدِ",10,"د",1,0],["وَبَصيرُ الأَقوامِ مِثلِيَ أَعمى","فَهَلِمّوا في حِندِسٍ نَتَصادَم",11,"م",1,0],["وبَصَّرْتَهُ لَّما تَصَعَّرَ خدُّهُ","بأنَّكَ أعلْى من أخادِعِهِ كَعْبا",12,"ب",2,0],["وبَصَّرتكَ بأطباع يَضيقُ بها","صدرُ الحليم وتأباه مَزاياه",13,"ا",2,0],["وَبصنوه عُثمان ذي الن","نورَين أَقوم مَنهَجِ",14,"ج",1,0],["وبصون سربلت عيسى وموسي","قبل قد فاز باليد البيضاء",15,"ا",2,0],["وَبِصَدرِكَ القَلبُ الَّذي لَمّا يُرَع","وَبِكَفِّكَ العَضبُ الَّذي لا يَكهَمُ",16,"م",1,0],["وَبِصَدرِكَ القَلبُ الَّذي لَمّا يُرَع","وَبِكَفِّكَ السَيفُ الَّذي لَم يَكهَمِ",17,"م",1,0],["وبصّره بالفكر ما كان عله","عليه الهوى والمشكلات الغرائب",18,"ب",1,0],["وَبصدّيقكَ الكبيرِ إمام الص","صحبِ والكلّ سادةٌ كبراءُ",19,"ا",2,0],["وبصَدري سرٌّ دَفينٌ فوا","خوفي عليهِ من قلبيَ المتبولِ",20,"ل",1,0],["وبصدغٍ معقربٍ فوق خدٍّ","صاحت الملقلتانِ منه السلاحا",21,"ح",2,0],["وبَصَّرَهُمْ بعدَ طولِ العَمَى","وقَوَّمَ بالعَدْل مُنْهالَها",22,"ل",3,0],["وَبِصُلبِ آدَمَ كانَ وَقت هُبوطِهِ","وَبِصُلبِ نوحٍ وَهوَ في الطوفانِ",23,"ن",1,0],["وَبِصُلبِ إِبراهيمَ حينَ رَمى بِهِ","في نارِهِ أَشقى بَني كَنعانِ",23,"ن",1,0],["وَبِصُفرَةِ المَنثورِ مِنهُ وَحُمرَةِ ال","وَردِ الجَنِيِّ وَخُضرَةِ الرَيحانِ",24,"ن",1,0],["وَبِصامِتٍ مُنذُ اِحتَوَتهُ بَنانُهُ","فَخِرَ اليَراعُ عَلى الوَشيجِ الذابِلِ",25,"ل",1,0],["وَبَصَّرَنَا مِنْ بَعْدِهِ بِمَصِيرِهِ","فَنَعْمَلَ لِلْأُخْرَى عَلَى حَسَبِ الأَمْرِ",26,"ر",1,0],["وبصالح أهل الأرض ومن","هو فيهم كالروض الأُنُف",27,"ف",1,0],["وبصدره الصامي عمادي","هجان لا هجين",28,"ن",1,0],["وبصائر وسرائر وضمائر","وخواطر جوالة في المبدع",29,"ع",1,0],["وبصلح ولاة الأمر عند فسادهم","ويقظهم للعدل من سنة القرى",30,"ر",2,0],["وبصوتك العذب الجميل ورقة","في وجنتيك تذوب من تحناني",31,"ن",2,0],["وَبِصَدْر الدّين مُلِّيتَ ولا","زِلْتَ تَحوِى منهُ صَدْراً سَالِماَ",32,"م",2,0],["وَبِصِدغي بَينَ صُب","حَينِ بِهِ لِلرُشدِ فَقدُ",33,"د",1,0],["وَبِصينِ أَهلِ الصينِ مَنزِلٌ غَيبِها","لِلشاهِدينَ عَلى الشَهادَةِ مَشهَدُ",34,"د",1,0],["وَبِصَونِ السِرِّ صُم عَمرُكَ لي","وَاِخفِني قَبلَ الدُعا عَن داعِيَي",35,"ي",1,0],["وبصدق نيه جازمه","يا الله بحسن الخاتمه",36,"ه",1,0],["وبَصير بمَعاني الشِّعْرِ","والإعْرابِ جِدّا",37,"د",2,1],["وبصدْري زفرة لو كُشِفَتْ","للصَّبا يومئذٍ هَبَّتْ سمائم",38,"م",1,0],["وبصحبة النَّاصرين لدينه","من أوضحوا سبل الهُدى إذ أظهروا",39,"ر",3,0],["وبصحة الجسم الشريف لق