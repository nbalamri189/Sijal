{"poems":[[24,"أمن دمنة الدار أقوت سنينا","https://www.aldiwan.net/poem21884.html","المتقارب"],[73,"للحب في تلك القباب مراد","https://www.aldiwan.net/poem11948.html","الكامل"],[93,"يا حبذا أخت الغزال","https://www.aldiwan.net/poem11463.html","مجزوء الكامل"],[54,"إنما العيش في منادمة الإخوان","https://www.aldiwan.net/poem27651.html","الخفيف"],[72,"دمعي عليك مجانس قلبي","https://www.aldiwan.net/poem18235.html","أحذ الكامل"],[85,"علمت بالقلم الحكيم","https://www.aldiwan.net/poem63745.html","مجزوء الكامل"],[62,"هي العيس قودا في الأزمة تنفخ","https://www.aldiwan.net/poem52455.html","الطويل"],[45,"سقى دار ليلى حيث حلت رسومها","https://www.aldiwan.net/poem65675.html","الطويل"],[105,"طرب الحطيم وكبر الحرمان","https://www.aldiwan.net/poem43111.html","الكامل"],[67,"إلهي على كل الأمور لك الحمد","https://www.aldiwan.net/poem18053.html","الطويل"],[67,"أهل التقى والعلم أهل السؤدد","https://www.aldiwan.net/poem18059.html","الكامل"],[46,"قد ندمنا على القبيح فأمسي","https://www.aldiwan.net/poem23435.html","الخفيف"],[90,"تونس","https://www.poetsgate.com/ViewPoem.aspx?id=179195",""],[90,"حافظ إبراهيم","https://www.poetsgate.com/ViewPoem.aspx?id=179126",""]],"verses":[["وَبَصبَصنَ بَينَ أَداني الغَضا","وَبَينَ عُنَيزَةَ شَأواً بَطينا",0,"ن",2,0],["وَبَصُرتُ بِالبُردَينِ إِرثِ مُحَرِّقٍ","لَم تَخلُقا إِذ تَخلُقُ الأَبرادُ",1,"د",1,0],["وَبِصَوْتِهَا التَّطْرِيبُ يَصْدُرُ","عَنْ نَبِيهِ الوَحْيِ عَالِي",2,"ي",1,0],["وَبِصَرفٍ كَأَنَّها أَلسُنُ البَر","قِ إِذا اِستَعرَضَت رَقيقَ السَحابِ",3,"ب",1,0],["وبصحن ذاكَ الخدِّ من قبل","نقلي ومن رشفاته شربي",4,"ب",2,0],["وَبَصُرتُ بِالدُستورِ يُز","هَقُ وَهوَ في عُمرِ الفَطيمِ",5,"م",1,0],["وبُصِّرَ محجوبُ البصائر أكْمَهٌ","وأُسمِعَ مشدودُ المسامِع أصلخُ",6,"خ",1,0],["وَبَصبَصَ أَهلُ العَيثِ حينَ هَداهُمُ","أَخو سَطَواتٍ ما يُبِلُّ سَليمُها",7,"م",3,0],["وَبَصَرتَ بِالوُزراءِ حَولَكَ خُشَّعاً","تُمضي أُمورَ المُلكِ في الإيوانِ",8,"ن",1,0],["وبَصَّرَهُ حتى رأى كلَّ غائبٍ","وصار سواءً عندهُ القُرْبُ وَالبُعْدُ",9,"د",1,0],["وَبَصِيرَةٌ باللَّهِ يُشْرِقُ نورُها","ويُضِيءُ مثلَ الكَوْكَبِ المُتَوَقِّدِ",10,"د",1,0],["وَبَصيرُ الأَقوامِ مِثلِيَ أَعمى","فَهَلِمّوا في حِندِسٍ نَتَصادَم",11,"م",1,0],["وبَصَّرْتَهُ لَّما تَصَعَّرَ خدُّهُ","بأنَّكَ أعلْى من أخادِعِهِ كَعْبا",12,"ب",2,0],["وبَصَّرتكَ بأطباع يَضيقُ بها","صدرُ الحليم وتأباه مَزاياه",13,"ا",2,0]]}