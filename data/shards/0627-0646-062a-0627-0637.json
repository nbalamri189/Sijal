{"poems":[[107,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/24804","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54251","الخفيف"],[556,"رب كن لي منها لباسا حصينا","https://www.aldiwan.net/poem47226.html","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79985","الخفيف"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77054","الخفيف"],[4767,"وردتي","https://www.poetsgate.com/ViewPoem.aspx?id=175104",""],[6198,"معطف الزمان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79321&r=&rc=95",""],[6332,"خجل الصّحوُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65172&r=&rc=1",""]],"verses":[["أنت أطلعتَ للممالكِ دُنيا","ساطعاً نُورها وديناً خطيرا",0,"ر",2,0],["أنت أطلقتني من السجن والإع","دام سجنٌ يضيق عن كل سجن",1,"ن",1,0],["أنتِ أطلعتِ في سمائِكِ بَدْراً","عَلَّمَ ابنَ السماءِ معنَى الكمال",2,"ل",1,0],["أنتَ أطْلقتني وكنتُ أسيراً","ثمّ داويتَ من أموري سقيما",3,"م",2,0],["أنتَ أطلقتَ أسر أعوامه الغب","ر من الجدب بالندى والسخاء",4,"ا",2,0],["أَنتَ أَطلَقتَ أَسرَ نَخلي مِنَ الظُل","مِ فَقيدَتني لِشُكرِكَ عَمدا",5,"د",2,0],["أنت أطلقتني ولما تزالي","تَمنحيني بكل حب جديد",6,"د",1,0],["أنتِ أطفأتِ مقلةَ الصبح في عيني...‏","وأشعلتِ ليليَ المشتاقا‏",7,"ق",2,0],["أنتِ أطفاتِ القناديلَ، فهل","يعتبُ الضوءُ إذا العاصفُ ثار؟",8,"ر",1,0]]}