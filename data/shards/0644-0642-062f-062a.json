لولا أجدع الخير فاعلمي","https://www.aldiwan.net/poem44482.html","الطويل"],[369,"ما حل هذا الهوى إلا لأرتحلا","https://www.aldiwan.net/poem17090.html","البسيط"],[374,"لا بتماديك على هجري","https://www.aldiwan.net/poem57430.html","السريع"],[405,"سرى طيفها وهنا إلي فحياني","https://www.aldiwan.net/poem46755.html","البسيط"],[405,"لولا ضني جسدي والمدمع الجاري","https://www.aldiwan.net/poem46918.html","البسيط"],[406,"إن الصلاة من الرحمن واجبة","https://www.aldiwan.net/poem34133.html","البسيط"],[406,"هو الهوى فاصطبر فيه لما يجب","https://www.aldiwan.net/poem34153.html","البسيط"],[406,"عساه يرضى المغضب","https://www.aldiwan.net/poem34160.html","مجزوء الرجز"],[413,"وسدت بهارون الثغور فأحكمت","https://www.aldiwan.net/poem67500.html","الطويل"],[419,"هلم بنا نزور أبا الخصيب","https://www.aldiwan.net/poem54011.html","الوافر"],[432,"ماست فازرت غصون البان بالميل","https://www.aldiwan.net/poem41419.html","البسيط"],[435,"يا جاعل النيل صبغ جلدته","https://www.aldiwan.net/poem12411.html","المنسرح"],[451,"وآلم الجرح ما أدمته أيدينا","https://www.aldiwan.net/poem998.html",""],[455,"إلى الصديق خفاجفي عوالمه","https://www.aldiwan.net/poem61248.html","البسيط"],[460,"سقى أيام رامة بل سقاها","https://www.aldiwan.net/poem55819.html","الوافر"],[466,"ألمت نع الظلماء يهدى سلامها","https://www.aldiwan.net/poem3195.html","عموديه"],[466,"أهلك والليل منضيا جملك","https://www.aldiwan.net/poem3286.html","عموديه"],[466,"صبر قلبي عان ودمعي طليق","https://www.aldiwan.net/poem3398.html","عموديه"],[467,"قدمت وعفوك عن مقدمي","https://www.aldiwan.net/poem59035.html","عموديه"],[470,"لقد تكامل فيه اللين والهيف","https://www.aldiwan.net/poem59860.html","البسيط"],[516,"لا بر في الحب يا أهل الهوى قسمي","https://www.aldiwan.net/poem20785.html","البسيط"],[517,"وقائلة مالي أرى الجو مظلماً","https://www.aldiwan.net/poem12300.html","الطويل"],[553,"لو كنت في مثل حالي لم ترد عذلي","https://www.aldiwan.net/poem47288.html","البسيط"],[555,"خليلي لست أرى الحب عارا","https://www.aldiwan.net/poem68409.html","المتقارب"],[561,"أيها الناظر فيه في سطح المرى","https://www.aldiwan.net/poem69354.html","الرمل"],[564,"نادى حمى الملك حسبي عزة وكفى","https://www.aldiwan.net/poem52828.html","البسيط"],[577,"لو كان سقم حبيب القلب في بدني","https://www.aldiwan.net/poem2990.html","البسيط"],[611,"","https://poetry.dctabudhabi.ae/diwan/poem/18838","البسيط"],[629,"","https://poetry.dctabudhabi.ae/diwan/poem/132055","الطويل"],[678,"","https://poetry.dctabudhabi.ae/diwan/poem/79667","الوافر"],[1080,"","https://poetry.dctabudhabi.ae/diwan/poem/2567","المتقارب"],[1080,"","https://poetry.dctabudhabi.ae/diwan/poem/2533","الطويل"]],"verses":[["لَقَد تَقَدَّمَ بي فَضلي بِلا قَدَمٍ","أَعظِم بِأَمرٍ عَلى ذي السِنِّ قَدَّمَني",0,"ن",2,0],["لَقَد تَوامَقَ قَلبانا كَأَنَّهُما","تَراضَعا بِدَمِ الأَحشاءِ لا اللَبَنِ",0,"ن",1,0],["لَقَدْ تَرَكُوا سِفْراً مِنَ المَجْدِ حَافِلاً","وَكُلٌّ لَهُ فِي ذَلِكَ السِّفْرِ عُنْوَانُ",1,"ن",1,0],["لَقَدْ تَقَضَّى خَيْرُ أَيَّامِنا","وَنَحْنُ نَرْجُو وَرِضَاهَا حَرَامْ",2,"م",1,0],["لقد تِعبَت فيما تروم من العلا","كذلك نفس الحرّ تلقى المتاعبا",3,"ب",2,0],["لقد تركتني مُوجَعَ القلب ساهراً","أخا مَدمَع جار ورأس مهوَم",4,"م",1,0],["لقد ترحّلت في يوم بنا انقلبت","حوادث الدهر فيه شرّ منقلب",5,"ب",1,0],["لقد تركت يتيم العلم منتجاً","والكتب راثيةً منه لمنتحب",5,"ب",1,0],["لَقَد تَرَكَت قَيسٌ دِياراً لِتَغلِبٍ","طَويلاً بِشَطِّ الزابِيَينِ خَرابُها",6,"ب",3,0],["لَقَد تَبَيَّنَ إِذ غَبَّت أُمورُهُمُ","قَومُ الجُحافيِّ أَمراً غِبَّهُ بادي",7,"د",2,0],["لَقَد تَرَكتَ فَلا نَعدَمكَ إِذ كَفَروا","لَاِبنِ المُهَلَّبِ عَظماً غَيرَ مَجبورِ",8,"ر",1,0],["لَقَد تَوَجَّسَ ميجاسٌ فَعايَنَهُ","مُعاوِدٌ جَرَّ أَوصالٍ وَأَوصالِ",9,"ل",1,0],["لَقَد تَرَكَت حَوائِمَ صادِياتٍ","وَتَمنَعُ صَفوَ ذي حَبَبٍ زُلالِ",10,"ل",1,0],["لقد تورَّط قلبي في حبائلِها","فما أرى أنَّه من حبِّها ناج",11,"ج",1,0],["لقد تجاوز مقدارٌ تخرَّمَها","ظهراً منيعاً وعِزّاً غير مقهور",12,"ر",1,0],["لقد تَلوَّنَت لي فدع جُدد ال","أخلاق وارجع بنا إلى اللُّبس",13,"س",1,0],["لَقَد تَرَكَ النِكاحُ أَبا سُلَيمٍ","كَظَهرِ الطَستِ لَيسَ بِذي قِبالِ",14,"ل",1,0],["لَقَد تَرَكَ الحُروبُ نِساءَ قَيسٍ","مُكِبّاتٍ عَلى كُحلٍ مَضيضِ",15,"ض",1,1],["لَقَد توشِكُ الحُمّى إِذ جَدَّ جَدُّها","تُقَوِّمُ مِن أَضلاعِيَ المُتَأَوِّدا",16,"د",2,0],["لَقَد تَوَلّى الشِتاءُ عَنّا","فَصَفِّقي يا مُنى وَطيري",17,"ر",2,0],["لَقَد تَساوى لَدَيهِ شَدوُ ساجِعَةٍ","وَصَوتُ نائِحَةٍ في الحَيِّ تَبكيهِ",18,"ي",2,0],["لقد تصورت جسما","يكلم الناس مثلك",19,"ك",1,1],["لقد تمادى القتل بين الورى","بالنار بالخنجر بالفاس",20,"س",1,1],["لقد تمنيت ان الموت يمهلني","او انني بعد الف منه مولود",21,"د",1,0],["لقد تلقص ظل كنت الزمه","من الشباب زمانا وهو ممدود",22,"د",1,0],["لقد تنقدني ناس قد انغمسوا","في الجهل لا يكتبون النون بالقلم",23,"م",1,0],["لَقَد تَصَبَّرتُ حَتّى لاتَ مُصطَبَرٍ","فَالآنَ أُقحِمُ حَتّى لاتَ مُقتَحَمِ",24,"م",1,0],["لَقَد تَرَكَ الهُذَيلُ لَكُم قَديماً","مَخازِيَ لا يَبِتنَ عَلى إِرابا",25,"ب",2,0],["لَقَد تُدلِقُ الغاراتِ يَومَ لِقائِها","وَقَد كانَ ضَرّابي الجَماجِمَ صيدُها",26,"د",3,1],["لَقَد تَدارَكَني مِنهُ بِعارِفَةٍ","حَتّى تَلاقى بِها ما كانَ قَد دَثَرا",27,"ر",2,0],["لَقَد تُصبِحُ الدُنيا عَلَينا قَصيرَةً","جَميعاً وَما نُفشي الحَديثَ المُكَتَّما",28,"م",2,0],["لَقَد تَرَكَت قَيساً ظُباتُ سُيوفِنا","وَأَيدٍ بِأَعجازِ الرِماحِ اللَهاذِمِ",29,"م",1,0],["لقد تجاوزْتَ بي وقتي وأيُّ حياً","في غيرِ إبَّانِه يَشفي من الغَلَلِ",30,"ل",1,0],["لقد تحيَّفَ شِعْري مَعْشَرٌ غَرَرٌ","منهم قريبٌ ومنهم نازحُ الدَّارِ",31,"ر",1,0],["لَقَد تَعَدَّت عَلينا غَيرَ راحِمَةٍ","فَظَلَّلَ الحُسنُ ظِلّاً غَيرَ مُنتَقِلِ",32,"ل",1,0],["لقد تجلَّت قدرةٌ من علٍ","مذ أنعمَ اللهُ بأنَعامِ",33,"م",1,0],["لَقَد تَرَكَتني كَأسُها وَحَقيقَتي","مُحالٌ وَحَقٌّ مِن فِعالِيَ كَالظَنِّ",34,"ن",1,0],["لَقَد تَمَكَّنتَ مِن فُؤادٍ","أَسقَمَهُ طَرفُكَ السَقيمُ",35,"م",1,0],["لَقَد تَرَكتَ أَميرَ المُؤمِنينَ بِها","لِلنارِ يَوماً ذَليلَ الصَخرِ وَالخَشَبِ",36,"ب",1,0],["لَقَدْ تَفَرَّدَ فِي لاهُوتِ قُدْرَتِهِ","فَمَا لَهُ أَبَدَاً فِي مُلْكِهِ ثَانِي",37,"ن",2,0],["لقدْ تعوَّدَ خدِّي","دمعي وأدمى وأدمنْ",38,"ن",1,0],["لَقَد تَرَكَتني بَينَ جَفنٍ جَفا الكَرى","وَجَنبٍ تَقَلّى لايُلائِمُ مَضجَعا",39,"ع",2,0],["لقد تورّعتَ حتّى باتَ كلُّ فتىً","من الجُنودِ يُوارِي سَيْفَهُ وَرَعا",40,"ع",2,0],["لَقَد تَدارَكَني مِنهُ وَلاحَمَني","سَيبٌ كَسا أَعظُماً قَد لاحَ عاريها",41,"ي",3,0],["لقد تَعَجَّبْتُ لها فِطْنَةً","أتى بها الطِّفْلُ بلا جَرَّهْ",42,"ر",2,0],["لَقَد تَرَكَ الفُؤادُ لِتِلكَ وُدّاً","وَسُؤلاً لا يَشيدُ بِهِ مُشيدُ",43,"د",1,0],["لَقَد تَرَكَتني مِن هَواها كَأَنَّني","هَبَنَّقَةُ القَيسِيُّ ذو الوَدَعاتِ",44,"ت",1,0],["لَقَد تَرَفَّعَ فَوقَ المُشتَري زُحَلٌ","فَأَصبَحَ الشَرُّ فينا ظاهِرَ الغَلَبِ",45,"ب",1,1],["لَقَد تَفَكَّرتُ في الدُنِّيا وَساكِنِها","فَأَحدَثَ الفِكرُ أَشجاناً وَتَأريقا",46,"ق",2,0],["لَقَد تَعاطاه ناس لا ابتكار لهم","والكل قد ضربوا منه على وتر",47,"ر",1,0],["لَقَد تجادل ناس حول منزلتي","من خاذل مكثر ذمي ومنتصر",47,"ر",1,0],["لَقَد تلونا به للَه ناظمه","شعراً بكى رقة منه فأبكانا",48,"ن",2,0],["لقد تعست هنا فإذا تعالت","يكون نصيبَها عيش رغيد",49,"د",1,0],["لَقَد تعلمت من بحث أواصله","أن الحياة بوجه الأرض معترك",50,"ك",1,0],["لَقَد تشتت من خوف ومن ندم","جيش حوالي ديالي كان محتشدا",51,"د",2,1],["لَقَد تعبوا دون الوصول إلى المنى","كَذَلك من يمشون في مسلك وعرِ",52,"ر",1,0],["لَقَدْ تَقَوَّسَ لَحْيَيْهِ ولمَّتَهُ","شَيْبٌ وذلِكَ مِمَّا يُحْدِثُ الزَّمَنُ",53,"ن",1,1],["لقد تواضَعَتِ الدنيا لِذي شَرَفٍ","بمُلْبِساتِ الدّنايا غيرِ مُلْتَبِسِ",54,"س",1,0],["لقد تردى حُللَ الجلال","بالبانيين الحق والحلال",55,"ل",1,0],["لقد تحدَّيْتَ في القبر الفَناءَ، فهل","خلتَ الفناءَ على البُسْفور سُلطانا؟",56,"ن",2,0],["لقد تطوَّرت الدنيا بِرُمتَّها","ولم يزل جامِدًا لم يلق تطويرا",57,"ر",2,0],["لقد تعبتْ منه كفُّ الدمار","وباتت تخاف أذى لمسهِ",58,"س",2,0],["لقد ترك الدنيا بميزان طبعها","وأهملها خلقاً وطلقها فكرا",59,"ر",2,0],["لقد تبوهم حتى كاد بوهمة","يذوب رغم الطبيب المسعف الآسي",60,"س",2,1],["لقد تنكر لي أهلي وأنكرني","صحبي وأقرب من أدنيت أَقصاني",61,"ن",2,0],["لقد تبدّى كغصن البانِ في المَيَلِ","ظبيٌ رماني بسهمِ اللحظِ والكَحَلِ",62,"ل",1,1],["لقد تمّ لي في الأزهر الآن عشرة","أزوال فيه العلم في غاية الجِدِ",63,"د",1,0],["لقد تقضّى شاكراً مثْنياً","عليكَ عند اللهِ شهرُ الصيامْ",64,"م",1,0],["لَقَد تَرَكتَ طَريقَ المَجدِ شاطِنَةً","فَلَو سَرى النَجمُ فيها اِستَبعَدَ الأَمَدا",65,"د",2,0],["لقد تفيأت ظلا الضيا","وصد عن طاعتي العاذلان",66,"ن",1,0],["لقد تمت صفات الحسن فيهم","تمام الجود في حسن الصفات",67,"ت",1,0],["لقد تشدقت في حق الرسول بما","عن مثله عرضه بالجانب الجنب",68,"ب",1,0],["لَقَد تَعَمَّدَ أَمراً لا تَهِمُّ بِهِ","آسادُ ترجٍ وَلا ذُؤبانُ أَوطاسِ",69,"س",1,0],["لَقَد تَفَكَّرتُ في شَأني وَشَأنِهمُ","فَبانَ لي أَنَّ ذَنبي عِندَهُم وَرَعي",70,"ع",2,0],["لَقَد تَبَدَّلتُ مِنكُم خَيرَ ما بَدَلٍ","فَاِستَبدِلُوا الآنَ مِنّي شَرَّ ما بَدَلِ",71,"ل",1,0],["لَقَد تَقَدَّمتُ سَبقاً مَن تَقَدَّمَني","سِنّاً وَأَدرَكَ شَأوي فارِطَ الأوَلِ",71,"ل",1,0],["لَقَد تَرَكتنى ما أَعِى لِمُحَدِّثٍ","حَدِيثاً وما اَروى بَبردِ قَراح",72,"ح",1,0],["لَقَد تَرَكَ السَليمَ أَباهُ يَبكي","بِجفنٍ شَقَّ عَبرَتهُ الزَفيرُ",73,"ر",1,0],["لَقَد تَوَلَّت وَأَبقَت بَعدَها لِبَني","خلاّطَ صيِّبُ دَمعٍ بَلَّ مَثواها",74,"ا",3,0],["لَقَد تَرحَّلَ عَن عَيني وَأَودعَها","شَخصاً يَلوحُ خَيالاً لَيسَ مُرتَحِلا",75,"ل",2,0],["لَقَد تَلاقَت بِها الأَنفاسُ ناسِجَةً","وَشياً يُجدِّدُ لِلعرفانِ آثارا",76,"ر",2,0],["لقد تَخوَّف حتى لا يخاف أسى","وقد تألمّ حتى ما به ألم",77,"م",1,0],["لقد تركتك النائبات أخا وجى","تجوب بلاد الله حزنا إلى سهل",78,"ل",1,0],["لقد ترك الوجوه الجو","ع تعرفها وتنكرها",79,"ر",3,0],["لَقَد تقوّلَ في الصحبِ الكِرام ولم","يَستحيِ ممّا اِفتراهُ غير منجبهِ",80,"ب",2,0],["لَقَد تَباشَرَ أَعدائي بِما لَقِيَت","رِجلي وَكَم مِن كَريمٍ سَيِّدٍ عَثَرا",81,"ر",2,0],["لقد تزيَّنت الدنيا بزخرفها","فالروض قد مُثِّلَت فيه التماثيلُ",82,"ل",1,0],["لقد توقَّفت لو أنَّ الهوى وقفا","وما كشفتُ الهوى لكن هو انكشفا",83,"ف",2,1],["لقد تبت تاب القلب إني ذبحته","وصيرته بالدمع والدم يدفُق",84,"ق",1,0],["لقد تقاربن أشباحٌ وأشباحٌ","عند اللقاءِ وأرواحٌ وأرواحٌ",85,"ح",1,1],["لَقَد تَناهَت بِيَ الأَشواقُ فَاِشتَعَلَت","نِيرانُ قَلبي وَأَذكَت حَرَّ أَنفاسِي",86,"س",2,0],["لقد توارى الهلال","والبرق في الجو صال",87,"ل",