],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2286,"","https://poetry.dctabudhabi.ae/diwan/poem/143215","السريع"],[2338,"","https://poetry.dctabudhabi.ae/diwan/poem/111147","الرمل"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82854","المتقارب"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94305","الخفيف"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99473","السريع"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99502","المنسرح"],[3024,"","https://poetry.dctabudhabi.ae/diwan/poem/138037","الخفيف"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101352","الخفيف"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123506","الخفيف"],[4279,"","https://poetry.dctabudhabi.ae/diwan/poem/101972","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72753","الرمل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139714",""],[4829,"ملحمة الليث والمهاة وبنات آوى","https://www.poetsgate.com/ViewPoem.aspx?id=34252",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[5409,"طرق الباب حالماً بلقاها","https://www.poetsgate.com/ViewPoem.aspx?id=155363",""],[5431,"قد غاب عني _في رثاء ثائر العجلوني","https://www.poetsgate.com/ViewPoem.aspx?id=197874",""],[5431,"طاغوت....","https://www.poetsgate.com/ViewPoem.aspx?id=202911",""],[5436,"مناجاة بين بوش وكلبه! ( أيمن أحمد رؤوف القادري )","https://www.poetsgate.com/ViewPoem.aspx?id=35272",""],[5763,"ِ شجيٌّ وخليٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=27066",""],[5956,"ثورة هنادي","https://www.poetsgate.com/ViewPoem.aspx?id=193111",""],[6013,"يا نسيماً هب مسكاً عبقاً","https://www.poetsgate.com/ViewPoem.aspx?id=181605",""],[6189,"عيبان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83602&r=&rc=69",""]],"verses":[["كفٌّ عهدتُ ثمارَ اللَّهوِ دانيةً","منها فقد قَلصتْ عنها مَجَانيها",0,"ي",3,0],["كُفَّ عَنْ تِلْكَ الأَغاني البَاسِمَهْ","أَيُّها العُصْفُورْ",1,"ر",1,0],["كَفِعلِ كُلَيبٍ يَومَ يَدعو اِبنُ أَخضَرٍ","وَقَد نَشِبَت فيهِ الرِماحُ الشَواجِرُ",2,"ر",1,0],["كف عن القول ولا","تكفره يا ابن الزانيه",3,"ي",2,0],["كُفَّ عَنّي فَقَد بُليتُ وَخَلّا","كَ بَلائي يا عاذِلي فَاِستَرَحتا",4,"ت",2,0],["كَفِعلِكَ في قَومٍ أَراكَ اِصطَنَعتَهُم","فَلَم تَرَهُم في شُكرِ ذَلِكَ أَذنَبوا",5,"ب",3,0],["كفعلكَ في قومٍ أراكَ اصطفيتهم","، فلم ترَهُمْ، في شكر ذلك، أذْنَبُوا",6,"ب",3,0],["كفِعْلِ جَوادٍ يَسبُقُ الخَيلَ عَفوُهُ","سراعَ وإن يجهدنَ يجهدْ ويبعدِ",7,"د",1,0],["كَفِعلِكَ بِالرومِيِّ إِذ رامَ خُطَّةً","تَكادُ سَماءُ العِزِّ فيها تَفَطَّرُ",8,"ر",1,0],["كفعلة فعالة وفعلى","فعلان ولتزد فعالا فعلا",9,"ل",2,0],["كفعلة بالكسر نوعهم أتى","من ذي ثلاث أصله بغيرتا",9,"ت",2,0],["كُفَّ عني عن عتابي","أنتَ حُرٌّ في عقابي",10,"ب",2,1],["كَفِعالِ مَولانا صَلاحِ الدينِ ذي ال","مَجدِ الغُدامِسِ وَالعَطاءِ الكَوثَرِ",11,"ر",1,0],["كَفعل ذاك الدُبِّ","بخِلِّهِ المحبِّ",12,"ب",1,0],["كفّ عنا اللِحاظ فهي سِهام","وَقف الجِفن دونَها وَتسبل",13,"ل",1,0],["كفعلِ مُعْتصمٍ باللهِ قام فلَمْ","يُعهَدْ كفَتْحَيْهِ للإسلامِ فَتحان",14,"ن",1,0],["كَفَّ عنّي واشٍ وأغضى رقيبُ","ونَهاني عن التّصابي المشيبُ",15,"ب",1,1],["كفّ عنهم كفّ الرّدى بعدما غنّى","عليهم طيرُ الحِمامِ وناحا",16,"ح",2,0],["كُفَّ عَنِ العاشِقينَ مُقْتَصِراً","هَلْ أَنْت إِلَّا حُوَيْرِسُ الخُضْرَا",17,"ر",2,0],["كَفَّ عنّي الخُطُوبَ خطّابُ فالبؤ","سُ نَعيمٌ أَغرُّ والنَّحسُ سَعد",18,"د",1,0],["كُفَّ عن الشرِّ فقلتُ لا تقلْ","ولا تخلْ أكُفُّ عن خيرِ العملْ",19,"ل",1,0],["كفُّ عُثمان والنجاح كفيل","قد كفت مُعضل الخطوب الشّداد",20,"د",1,0],["كُفَّ عَنِّي الجَفا","كُفَّ عَنِّي السَّفَرْ",21,"ر",1,0],["كف عن هجرك الأليم وهب لى","نظرة واتخذ سوا السبيلِ",22,"ل",1,0],["كف عيسى بها الشفا","وَعَصى كل عاصيه",23,"ه",1,0],["كَفِعلِ اِبنِ أَيّوبَ في خَلوَةٍ","يُنازِعُ خادِمَهُ المِروَدا",24,"د",2,0],["كف عن نفسه الردى وكساها","سُبَّة دونها ورود رداها",25,"ا",3,0],["كف على عندها التبر","هان وللمك بها قدر",26,"ر",1,1],["كف عن دين الهدى واستأصلا","شأنه الغي المبير المضلل",27,"ل",1,0],["كَفِعلِ النِّساءِ إِذا ما أَسَأن","فَعاتبتهنَّ أَطَلنَ البُكاءَ",28,"ا",2,0],["كف عن فعل ما يسوء وأحسن","بالتصافي تجمل صفاتك والذات",29,"ت",1,0],["كف على الطبل لإيقاعها","وكفها الأخرى على الفيش",30,"ش",1,0],["كف عروسٍ لاحت خواتمها","أو عقد در في الجو ينتثر",31,"ر",1,0],["كُفَّ عَنّا أكُفَّ أَهْلِ الضَّلالِ","عَجِّلَنْ عَجِّلَنْ تَعَالَ تَعَالَ",32,"ل",1,0],["كَفِعلِهِ اسمُ فَاعِلٍ فِى العَمَل","إن كانَ عَن مُضِيِّهِ بمَعزِلِ",33,"ل",1,0],["كَفِعل وفُعَلٍ فِى جَمعِ مَا","كَفِعلَةٍ وَفَعلَةٍ نَحوُ الدُّمَى",33,"م",2,0],["كف عني حدود جفنك يا من","قد تعدى في شرعة الحسن حدا",34,"د",2,0],["كف عنى كف الاذى ان عذلى","منك عار من أنقص الاوقاص",35,"ص",1,0],["كفعل أخيك الغيث عند انسكابه","سواء عليه من يقيم ويعزب",36,"ب",1,0],["كف عما تشتهي النفس يدا","إنما الراحة في كف اليد",37,"د",1,0],["كفَّ عنا كفَّ الخطوب فلم يت","رك لديها فاءاً يلوك وكافا",38,"ف",2,0],["كفّ عنّي خل قولك للعيالي","شيبي عن خمسين بعثه خارجيّه",39,"ي",2,0],["كفعل للمعاصي أو مباح","فلم يأمر بها رب العوالي",40,"ل",2,0],["كف عني لا تحسب الفقر عاراً","ليس دون انتهاك عرضي دون",41,"ن",1,0],["كفٌ على فعل المكارم عوّدت","والروح منك سنابلٌ بك تكبرُ",42,"ر",1,0],["كفّ عني فسوأتي لن تُوارى","طالما الفقر ثوبها والقوتُ",43,"ت",1,0],["كفَّ عنّي! عشْ في غبائكَ واهنأْ","أنا كلبٌ، لكنّني لسْتُ وغْدا",44,"د",2,0],["كفَّ عني ، لا تسلني","عن شجوني ، لن أُجازفْ",45,"ف",1,0],["كفعل اتعاظٍ من اللاّ صراطِ","وأمزح حين أقول المُعادِي",46,"د",2,0],["كف عني والهوى ما زادني","برد أنفاسك إلا حرفا",47,"ف",2,0],["كفٌ عراقيةٌ جادت بما وجدت","والحقد من قبلُ ما ضنَّت به \"النجف\"",48,"ف",1,0]]}