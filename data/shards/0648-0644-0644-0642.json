{"poems":[[55,"إلى أين مرمى قصدها وسراها","https://www.aldiwan.net/poem29634.html","الطويل"],[55,"ما هاج من ذي طرب مخماص","https://www.aldiwan.net/poem30179.html","الرجز"],[29,"غدا باجتماع الحي نقضي لبانة","https://www.aldiwan.net/poem5735.html","الطويل"],[74,"لتهن عين إلى مراك قد طمحت","https://www.aldiwan.net/poem18476.html","البسيط"],[53,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[93,"وقفت ضحى في شاطء النيل وقفة","https://www.aldiwan.net/poem8826.html","عموديه"],[91,"أحاطت بليل اليأس مني غياهب","https://www.aldiwan.net/poem44938.html","الطويل"],[87,"أصاب المجاهد عقبى الشهيد","https://www.aldiwan.net/poem62887.html","المتقارب"],[60,"فلا تصحب أخا الجهل","https://www.aldiwan.net/poem30813.html","الهزج"],[76,"الآن سح غمام النصر فانهملا","https://www.aldiwan.net/poem13228.html","البسيط"],[76,"فيا لشجا قلب من الصبر فارغ","https://www.aldiwan.net/poem13267.html","الطويل"],[52,"لقد ذكرتني ليلة القدر مجلسا","https://www.aldiwan.net/poem63947.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39556","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54993","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54220","البسيط"],[111,"ألا هل لداعي الله في الأرض سامع","https://www.poetsgate.com/ViewPoem.aspx?id=103",""],[112,"ملائكة الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=8412",""],[87,"أصابَ المجاهدُ عقبى الشهيد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9600&r=&rc=90",""],[119,"بدأت ببسم الله في مبدأ الأمر","https://www.aldiwan.net/poem42205.html","الطويل"],[190,"فقالوا هو الزاهي فقلت ولم زها","https://www.aldiwan.net/poem43447.html","الطويل"],[193,"هواي طيبة لا بيضاء عطبول","https://www.aldiwan.net/poem35275.html","البسيط"],[236,"تواضع لرب العرش علك ترفع","https://www.aldiwan.net/poem44582.html","الطويل"],[422,"بحيث انعطف البان","https://www.aldiwan.net/poem54026.html","الهزج"],[457,"إليك شكواي مثلوج الفؤاد بها","https://www.aldiwan.net/poem13935.html","البسيط"],[463,"إن كنت ممن يلج الوادي فسل","https://www.aldiwan.net/poem55986.html","الرجز"],[466,"تمنى مقامي والمطالع ضلة","https://www.aldiwan.net/poem15107.html","الطويل"],[473,"وليلة أيقظني معانقي","https://www.aldiwan.net/poem59521.html","الرجز"],[505,"مطلسم القوم لا تهمل مكانته","https://www.aldiwan.net/poem37775.html","البسيط"],[505,"ولما توسطنا البطاح عشية","https://www.aldiwan.net/poem37797.html","الطويل"],[505,"رف الغرام بقلبي","https://www.aldiwan.net/poem37960.html","المجتث"],[543,"لله يومان تحكي غمض أجفان","https://www.aldiwan.net/poem47920.html","عموديه"],[563,"بأسماء رب العالمين ابتدائيا","https://www.aldiwan.net/poem33573.html","الطويل"],[563,"لذاتي بذاتي لا لكم أنا ظاهر","https://www.aldiwan.net/poem34556.html","الطويل"],[563,"أطوف على ذاتي بكاسات خمرتي","https://www.aldiwan.net/poem34733.html","الطويل"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/66962","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48745","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48766","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62448","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62567","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59090","البسيط"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61073","المتقارب"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49932","البسيط"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95522","الخفيف"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48204","الوافر"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113787","الطويل"],[2140,"","https://poetry.dctabudhabi.ae/diwan/poem/31480","البسيط"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28583","البسيط"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129981","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87326","الرجز"],[2695,"","https://poetry.dctabudhabi.ae/diwan/poem/84829","الطويل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75962","البسيط"],[3055,"","https://poetry.dctabudhabi.ae/diwan/poem/131358","الطويل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65104","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100723","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100806","البسيط"],[3451,"","https://poetry.dctabudhabi.ae/diwan/poem/123481","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48458","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48439","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92057","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92070","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216573","البسيط"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85162","الطويل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135880","الرجز"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103024","البسيط"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76496","الطويل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77114","البسيط"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44677","الطويل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83143","البسيط"],[4755,"لَن أَخسَرَ اليَأسَ","https://www.poetsgate.com/ViewPoem.aspx?id=183678",""],[4920,"نسيم الصبح قد هبا","https://www.poetsgate.com/ViewPoem.aspx?id=1026",""],[4954,"كَفاني قَريضي مُؤْنِسًأ","https://www.poetsgate.com/ViewPoem.aspx?id=207724",""],[585,"لك الله من منقض قصرٍ لدى القفر","https://www.poetsgate.com/ViewPoem.aspx?id=161871",""],[5365,"تراتيل في محراب الألم","https://www.poetsgate.com/ViewPoem.aspx?id=191272",""],[5561,"إطلالة على الماضي والحاضر","https://www.poetsgate.com/ViewPoem.aspx?id=197572",""],[5689,"إلى م النوم كالعني الشجين","https://www.poetsgate.com/ViewPoem.aspx?id=143401",""]],"verses":[["وَلِلقَلبِ عِندَ المَأزَمَينِ وَجَمعِها","دُيونٌ وَمَقضى خَيفِها وَمِناها",0,"ا",3,0],["وَلِلقِرى وَالطُرُقِ الخِراصِ","وَلِلقَنا يَلدَغنَ بِالأَخراصِ",1,"ص",1,0],["وَلِلقَينِ وَالخِنزيرِ مِنّي بَديهَةٌ","وَإِن عاوَدوني كُنتُ لِلعَودِ أَحمَدا",2,"د",2,0],["وللقيان بوُرقِ الطير مشتبهٌ","هذي وتلكَ على العيدانِ قد صدحت",3,"ت",1,0],["وللقُضبِ اللِّدان به اعتناقٌ","وللأنوارِ فيهنِّ التئامُ",4,"م",1,0],["وَلِلقادِرِ الماضي العَزيمَةِ حُلوُهُ","وَلِلعاجِزِ الواهي الشَكيمَةِ حازِرُه",5,"ر",2,0],["وللقلب مني بعد أن كرَّ راجعاً","وقد رحلت أظعانهم والركائب",6,"ب",1,0],["وَلِلقَومِ حَتّى وَراءَ القِفارِ","دُعاةٌ تُغَنّى وَرُسلٌ تَشيد",7,"د",1,0],["وَلِلقَلبِ عَلى القَلبِ","دَليلٌ حينَ يَلقاهُ",8,"ه",1,0],["وَلِلقَنا أَعيُنٌ قَد حَدَّقَت حَنَقاً","وَلِلظُبى أَلسُنٌ قَد أَفصَحَت جَدَلا",9,"ل",2,0],["وَلِلقُضبِ وَالأَطيارِ مَلهىً بِجَرعَةٍ","فَما شِئتَ مِن رَقصٍ عَلى رَجعِ أَلحانِ",10,"ن",1,0],["وَلِلقَلبِ وَسواسٌ مِنَ الحُبِّ يَغتَدي","وَرائِحُ رَوعاتِ الهَوى المُتَرَدِّدِ",11,"د",1,0],["وللقلوبِ أحاديثٌ يجاوبها","تناوحُ الطيرِ في ظلِّ الخميلاتِ",12,"ت",1,0],["وَلِلقَفْرِ كُنْ صرْحاً مَشِيداً لأُنْسِهَا","وَلِلصَّخْرِ كُنْ رَوْضاً وَأَوْرِقْ وَأَفْرِعِ",13,"ع",1,0],["وللقُرَى بين أضْغاثِ الكَرَى شَبَحٌ","كالسرِّ بين حنايا الليلِ مدفونا",14,"ن",2,0],["وللقوم ارث صادق من \"محمد\"","لكل هدى للرسل لا شك جامع",15,"ع",1,0],["وللقصايد.. هجسي اللي ليامنه زجر..","صيح الدنيا .. وقال... أسكتي يابارعه..",16,"ع",2,0],["وللقومِ حتى وراءه القفارِ","دعاة ٌ تغني ، ورسلٌ تشيد",17,"د",1,0],["وللقادري والأحمدي حمى الورى","كذاك الدسوقي والكرام ذووا الصبر",18,"ر",1,0],["وللقوم من هاموا بحبك سيدي","تكرم عليهم منك في رحمة تجري",18,"ر",2,0],["وللقطن فعل في ثلاثة أنفس","صناعته تعديهم خفة العقل",19,"ل",1,0],["وَللقريضِ تَفاعيلٌ توازنهُ","هيَ القريضُ وهاتيك التفاعيلُ",20,"ل",1,0],["وللقمر المنشق نصفين معجزٌ","عزيز على من رامه متمنع",21,"ع",1,0],["وللقامات أغصان","وفي الأرداف كثبان",22,"ن",1,0],["وللقريضِ فكاهاتٌ يرنّ بها","طيرُ البيانِ إِذا ما عزَّ مِرْنانُ",23,"ن",1,0],["وللقتيل يُلزِمون دمَه","وفيهم القاتلُ غيرَ من قتَلْ",24,"ل",1,0],["وللقر ما بين الشناخيب سورةٌ","تغادر ربَّ المارن البسط أجْدعا",25,"ع",2,0],["وَلِلقَضيبِ لينُها وَقَدُّها","وَلِلرَحيقِ وَالشَقيقِ خَدُّها",26,"ه",2,0],["وللقديمِ فَطيروا بالتُّقى أبَداً","غيرُ القَديمِ ألا يا قومُ مَعْدومُ",27,"م",1,0],["وللقَلبِ أطوارٌ وفي الصَّبرِ مِنحَةٌ","ولكنْ تَفانَى ما رأَيْنا له عَزْمَا",28,"م",2,0],["وللقُلوبِ عُيونٌ","وللجَمالِ رَفارِفْ",29,"ف",1,0],["ولِلقِراءَةِ طُلاَّبٌ قدِ اجتَمَعوا","وسادةٌ مِن ذَوي عِلمٍ وعِرفانِ",30,"ن",1,0],["وللقلب يا قدوس قدِّس عن السوى","وفي الحشر سلِّم يا سلام محاميا",31,"ي",2,0],["وللقلب فاحفظ يا حفيظ وأنت يا","مقيت فصير قوتي الذكر حاليا",31,"ي",2,0],["وللقلب مني قد ظهرت بكل ما","ظهرت ولم تنكرك مني الخواطر",32,"ر",1,0],["وللقلم الأعلى تنزلت من يدي","وللوح حتى للذوات الكثيرة",33,"ه",1,0],["وللقَنا مُنْهَوىً فيهمْ ومُنْسَرَبٌ","وللظُّبى مُنْبَرى فيهمْ ومُنْبَرَأُ",34,"ا",1,0],["وللقوى أسانيد يدل بها","إذا استعان ضعيف بالأسانيد",35,"د",1,0],["وللقضية ما أنت الكفيل به","من الوسائل شتى والأساليب",36,"ب",1,0],["وللقلب إثر الظاعنين التفاتة","وإنسان عيني في المعاهد ذاهبُ",37,"ب",1,0],["وللقول فعّال وللأمر نافذ","وللثقل حمّال وبالحق ضارعُ",38,"ع",1,0],["وَلِلْقرنْفلِ رَاحَاتٌ مُخَضبَةٌ","عَلَى مَعَاصمَ خُضْرٍ فتنةِ الرَّائِي",39,"ا",2,0],["وَللقطر في جيد غُصن النقا","لآل مِن الماء أَو جَوهر",40,"ر",1,0],["وللقوافي في القريض علم","به يتم للأديب النظم",41,"م",1,0],["وللقيانِ على عالي مَزاهِرها","ترنّمٌ بين محسوس ومهتوتِ",42,"ت",1,0],["وللقران الفضل في كل دار","ديناً ودنيا فهو نعم الشعار",43,"ر",1,0],["وللقمْريِّ تغريدٌ رخيمٌ","إِذا ما مالَ عن لحنٍ أجادَهْ",44,"د",2,0],["وللقلبِ في نار الغرامِ تَقَلُّبٌ","ولم لا وعَنّي بان كلُّ أخٍ عَينِ",45,"ن",1,0],["وَلِلقِسِيِّ أَزاميلٌ وَغَمغَمَةٌ","حِسَّ الجَنوبِ تَسوقُ الماءَ وَالبَرَدا",46,"د",2,0],["وَلِلقَناعَةِ عِندي مِنَّةٌ شَكَرَت","وَالشُّكرُ أَحسَنُ إِعظامٍ وَإِجلالِ",47,"ل",1,0],["وللقَلعَةِ الغرّاءِ كالبدرِ طالعا","تفرّجَ صدرُ الماء عنه هلالا",48,"ل",2,0],["وللقضاةِ حُجَّةٌ مُفيدَه","عندَ الملوكِ السادةِ المؤيَّدَه",49,"ه",1,0],["وِللقطر إِيناس وَعز وَبَهجة","لما نالَهُ الوالي برفعة شان",50,"ن",1,0],["وَلِلقَوافي قَفَت مالي فَلا أَدبٌ","يُملى وَلا نَشَبٌ يُريح مُبتَئِسا",51,"س",2,0],["وللقلب منه برد معنى لو أنه","هريق على النيران كن جنانا",52,"ن",2,0],["وللقلب من نار الفؤاد استعارة","دُمُوعي من ترشيحها تنحدّرُ",53,"ر",1,0],["وللقنابل فوق الخصم معمعة","كانما فوقهم من نارها سقر",54,"ر",1,0],["وللقوافي التي أطلقت بلبلها","في نظم مدحك تسجيعٌ وترتيل",55,"ل",1,0],["وللقبضة علم من أدرك علمها","عالما يصير بالأسرار الغريبة",56,"ه",1,0],["وللقَصْدِ إسعافٌ وللرّفْدِ طالِبٌ","وللوعْدِ إنجازٌ وللسّعْدِ طالِعُ",57,"ع",1,0],["وللقُلوبِ هُدوٌّ بالأمانِ كَما","بالشُكْرِ ألسنةُ القُصّادِ تخْتَلِجُ",58,"ج",1,0],["وللقلوبِ سُكونٌ من مَهابتِهِ","وللحروبِ على أعدائِه رهَجُ",58,"ج",1,0],["وَللقبور ثغورٌ غيرُ ناطقةٍ","سكوتُها ناطقٌ للعارف الداني",59,"ن",2,0],["وللقلوب مع الأحباب ملعبةٌ","تهوى اللقا وتعاديها أعاديها",60,"ي",3,0],["وللقرنفل أثواب ينوعها","عن البلور صناع الكف رقّان",61,"ن",1,0],["وللقلب ترياق من الثغر ريقه","إذا لسعت من ليل شعر أساوده",62,"د",2,0],["وللقبيلةِ وللأحبَّةِ","أصلحْ وقرِّبَنْ بكلِّ قربةِ",63,"ه",1,0],["وللقواضب في الأدراع صلصلة","يجيبها من قسيّ القوم مرنان",64,"ن",1,0],["وَللقبر أَشهى من قصور فَسيحة","لها البؤس خل وَالشَقاء حَبيبها",65,"ب",3,0],["وَلِلقِرافِى هُنَا كَلاَمُ","نِيطَ بِهِ مِن أجلِهِ مَلاَمُ",66,"م",1,0],["وَلِلقَنابِلِ فيهِم سوءُ صاعِقَة","وَلِلبَنادِقِ فيهِم صَيِّبُ البَرد",67,"د",1,0],["وَلِلقَيرَوانِ اليَومَ عِندي جَواذِبٌ","وَحُبٌّ إِلى الأَوطانِ يَقتادُني قَسرا",68,"ر",2,0],["وَلِلقُلوبِ لُغاتٌ لَيسَ يُدركُها","سِوى فُؤادٍ بِنارِ الوَجد مَعمودِ",69,"د",1,0],["ولِلقَصِيدَةِ بَيتٌ واحِدٌ, ولَقَد","دَخَلْتُ.. ما كُلُّ آتٍ بَيتَهَا دَخَلَا",70,"ل",2,0],["وللقلب التفات لل","ذين تحملوا رَكبا",71,"ب",2,0],["ولِلقلْب لوْعاتٌ وقدْ ذُقتُ لوْعَتي","فهَلّا أُلَاقي بعْدَ لوْعي مماتِيَا",72,"ي",2,0],["وللقصر مني عبرة تلو عبرة","فمن لؤلؤ نظم ومن لؤلؤ نثر",73,"ر",1,0],["وللقميصِ الّذي جاؤوا به كّذِباً","وللحياةِ إذا اشتدّتْ معاناتي",74,"ت",2,0],["وللّقاء إذا عزّ اللّقاءُبهِ","وللوداعِ الّذي أبكى حكاياتي",74,"ت",2,0],["وللقمرِ العشاقُ تبكي وتشتكي","فيرسلُ أنّاتٍ إليهم وأنوارا",75,"ر",2,0],["وللقربي بهذا الخلق سم","كسم الرقطا بالماء المعين",76,"ن",1,0]]}