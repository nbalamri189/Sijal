5533,"الشِّعْرُ زَهْرٌ قد نُثِرْ","https://www.poetsgate.com/ViewPoem.aspx?id=176721",""],[5582,"أَسْيانُ ما فِي الأَيْكِ ناحَ حَمامُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=63573",""],[5595,"احملْ جراحَك وابتسمْ","https://www.poetsgate.com/ViewPoem.aspx?id=145122",""],[5606,"يقول عيسى وعيسى يرفع أقواله","https://www.poetsgate.com/ViewPoem.aspx?id=197970",""],[5649,"سامر الحى","https://www.poetsgate.com/ViewPoem.aspx?id=151472",""],[5649,"درة صور","https://www.poetsgate.com/ViewPoem.aspx?id=38967",""],[5674,"ليت القلب يرتاح","https://www.poetsgate.com/ViewPoem.aspx?id=196702",""],[5691,"لا ينحني نخل العراق","https://www.poetsgate.com/ViewPoem.aspx?id=207062",""],[5736,"أسطورة للهوى","https://www.poetsgate.com/ViewPoem.aspx?id=203162",""],[5758,"عزفٌ أخْضر","https://www.poetsgate.com/ViewPoem.aspx?id=200586",""],[5829,"جفت الأقلام","https://www.poetsgate.com/ViewPoem.aspx?id=215979",""],[5855,"منجرد اللحيين عريان الطبق","https://www.poetsgate.com/ViewPoem.aspx?id=186573",""],[5910,"رمضان أقبل","https://www.poetsgate.com/ViewPoem.aspx?id=212047",""],[5939,"اضرب كي تقطع رأس الأفعى","https://www.poetsgate.com/ViewPoem.aspx?id=136646",""],[5943,"عمري وعمرك","https://www.poetsgate.com/ViewPoem.aspx?id=61845",""],[5956,"حِنّي عليَّ ‏","https://www.poetsgate.com/ViewPoem.aspx?id=181980",""],[5956,"فَرْقُ العمر فرّقنا","https://www.poetsgate.com/ViewPoem.aspx?id=182148",""],[5956,"النملة المُعَلِّمة","https://www.poetsgate.com/ViewPoem.aspx?id=183472",""],[5956,"سيارة وسط الصحراء","https://www.poetsgate.com/ViewPoem.aspx?id=184691",""],[5956,"الشر فينا منذ قابيلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=192436",""],[5956,"يستشرف ابني بالحِجى المستقبَلا","https://www.poetsgate.com/ViewPoem.aspx?id=193298",""],[5956,"من سوف ينقل للخليقة شَهْدي؟","https://www.poetsgate.com/ViewPoem.aspx?id=193360",""],[5956,"يمضي الزمان ولا أراك بجانبي","https://www.poetsgate.com/ViewPoem.aspx?id=193438",""],[5956,"أحسن مُدرّب تنس لأسوأ متدرب","https://www.poetsgate.com/ViewPoem.aspx?id=193587",""],[5956,"سحُبٌ تفيد حياتنا","https://www.poetsgate.com/ViewPoem.aspx?id=208561",""],[5969,"روايةٌ صوفية","https://www.poetsgate.com/ViewPoem.aspx?id=207465",""],[5973,"أشعل من حوليَ أقمارَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=13769",""],[5974,"هَنْدَسَةُ الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=200330",""],[5989,"يا سائلي ما الحب ..","https://www.poetsgate.com/ViewPoem.aspx?id=181546",""],[6093,"أخشاب وأحجار","https://www.poetsgate.com/ViewPoem.aspx?id=198909",""],[6125,"عَامَانِ مُذْ أشعَلتِ فيَّ صَبَابةً","https://www.poetsgate.com/ViewPoem.aspx?id=210569",""],[6152,"هواك إشاعة","https://www.poetsgate.com/ViewPoem.aspx?id=202761",""],[658,"الشان اعظم في عظيم الشأن","http://www.aldiwanalarabi.com/poemDescription.do?poemId=604006",""],[6160,"في سُقُوطِ الظِّلِّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87083&r=&rc=0",""],[6213,"شفرة الذباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76306&r=&rc=54",""],[6237,"هوية الإنسان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77868&r=&rc=10",""],[463,"وجد الجميمَ فعافه وتبقَّلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60255&r=&rc=311",""],[463,"صدتْ بنعمانَ على طول الصدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60044&r=&rc=100",""],[6308,"ذاكرة الوطن القديم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87728&r=&rc=6",""],[6318,"الهند .. تقاوم الاحتلال البريطاني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65940&r=&rc=0",""],[6327,"لامية الهمج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86571&r=&rc=6",""]],"verses":[["يَمضي الزَمانُ وَلا نُحِسُّ كَأَنَّهُ","ريحٌ تَمُرُّ وَلا يُشَمِّ نَسيمُها",0,"م",3,0],["يَمضي العَوالي حَيثُ تَث","وي تَحتَها الأَسافِلُ",1,"ل",1,0],["يمْضِي الزّمانُ وكلُّ فانٍ ذاهِبٌ","إلاّ جَميلَ الذِّكْرِ فهْوَ الباقِي",2,"ق",2,1],["يُمْضِي رِيَاحَ الْعَزْمِ غَيْرَ مُسَوِّفٍ","وَيُلاَحِظُ الآرَاءَ بَعْدَ تَلَوُّم",3,"م",1,0],["يَمضي وَلا حيلَةٌ إِلّا عَزيمَتُهُ","وَيَنثَني وَحُلاهُ المَجدُ وَالذَهَبُ",4,"ب",1,0],["يُمضي الأُمورَ وَهوَ سامٍ هَمَّهُ","بَحرُ بُحورٍ واسِعٌ مَجَمُّهُ",5,"م",2,0],["يَمضي الزَمانُ وَما ظَفِرتُ بِصاحِبٍ","إِلّا ظَفِرتُ بِصاحِبٍ خَوّانِ",6,"ن",1,0],["يَمضي بِحالِ وَفائِهِ","وَيَصُدُّ عَن قالٍ وَقيلِ",7,"ل",1,0],["يمضي الزمان وما خابت لديه يدٌ","سعياً إلى المجد لا زلت به قدمُ",8,"م",1,0],["يمضي على نهج أوَّلِيهِ","مشمِّراً يطلُع النِّجادا",9,"د",2,0],["يُمضي مكائدهُ إلى أعدائِه","كالنبل صادرةً عن الأعْجاس",10,"س",1,0],["يَمضي الشبابُ ويُبقي من لُبانتِه","شجواً على النفسِ يَشجوها ويُشجيها",11,"ي",3,0],["يَمضي النَهار وَنَحنُ نَح","سَبُ ما بَرِحنا في البُكورِ",12,"ر",1,0],["يَمضي الصَفاءُ وَيَبقى بَعدَهُ أَثَرٌ","في النَفسِ يُؤلِمُها طَوراً وَيُشجيها",13,"ي",3,0],["يَمضي فَيَقدُمُ جَيشَهُ مِن هَيبَةٍ","جَيشٌ يَغُصُّ بِهِ الزَمانُ وَيَشرَقُ",14,"ق",1,0],["يَمضي وَيُنسى العالَمونَ وَإِنَّما","تَبقى السُيوفُ وَتَخلُدُ الأَقلامُ",15,"م",1,0],["يَمضي وَيُغمِدُ بِالهُدى","فَكَأَنَّهُ سَيفُ النَذير",16,"ر",1,0],["يمضي السِّنانُ على مِقدارِ مُنَّتِه","في الطعنِ والوخز أقصَى منه بالإبرِ",17,"ر",1,0],["يُمضي المَنايا دِراكاً ثُمَّ يُتبِعُها","بيضَ العَطايا وَلَم يوعِد وَلَم يَعِدِ",18,"د",1,0],["يَمضي أَخو الحُبِّ عَلى نَهجِهِ","فَنَّدَهُ في الحُبِّ مَن فَنَّدَه",19,"د",2,0],["يَمضي الزَمانُ وَما قَضَيتُ لُبانَتي","مِن حُسنِ مَوهوبِ الصِبا وَمُعارِهِ",20,"ر",2,0],["يُمضي العَزيمَةَ لَو يُباشِرُ حَدَّها","فَلَّت غِرارَيهِ الحُسامُ المُنتَضى",21,"ض",2,0],["يَمضي هَزيعٌ لَم يَطُف طائِفٌ","مِن عِندِ أَسماءَ وَيَأتي هَزيع",22,"ع",1,0],["يمضي بمُرِّ الفَجْعِ عامٌ فيهِمُ","ويَجيءُ بالرُّزْء المبرِّحِ عامُ",23,"م",1,0],["يَمضي الشَبابُ وَقَد يَأتي لَهُ خَلَفٌ","وَالشَيبُ يَذهَبُ مَفقوداً بِمَفقودِ",24,"د",1,0],["يمضي بك البرقُ المقلُّ فيختفي","عجلانَ بينَ رُبىَ وبينَ بطاحِ",25,"ح",1,0],["يمضي فيضحك للسهو","لِ ولا يضن على الهضاب",26,"ب",1,0],["يُمضي لك السيفُ ما تَنْويهِ والقلمُ","وَيَسْتَقِلّ برضوَى هَمُّكَ الجَمَمُ",27,"م",1,1],["يُمْضي الأمورَ بآراءٍ مُسَدَّدَةٍ","كَأَنَّهُنَّ سِهامٌ تقصد الثُّغَرا",28,"ر",2,0],["يَمضِي بِمُنصُلِهِ قُدماً فَيَلحَمُهُ","مَجرى الوَريدِ مِنَ الأَعناقِ وَاللِّمَمِ",29,"م",1,0],["يَمضي فَيَهوي وَراءَ النَقعِ مُلتَهِباً","كَما تَصَوَّبَ يَجري كَوكَبٌ ساري",30,"ر",2,0],["يَمضي تُراثُ المُسلِمينَ مُوَزَّعاً","وَالمُسلِمونَ نَواكِسُ الأَذقانِ",31,"ن",1,0],["يَمضِي الزمانُ وهم وُلاةُ أمورِها","في دولةٍ أبديَّةٍ ما تَذْهَبُ",32,"ب",1,0],["يُمضي الأُمورَ بِلا وَتيرَةِ فَترَةٍ","مِمّا يُلِمُّ بِهِ وَلا اِستِحسارِ",33,"ر",1,0],["يُمضي المَنايا والعطايا وادعاً","تَعِبَتْ له عَزَمَاتُه وأُريحا",34,"ح",2,0],["يَمضي النَهارُ فَما أَنفَكُّ في شُغلٍ","وَلا أَطيقُ إِذا جَنَّ الدُجى سُهُدا",35,"د",2,0],["يَمضي كَإِيماضِ البُروقِ وَما لَها","مُكثٌ فَيُسمَعَ أَو يُقالَ حِوارُ",36,"ر",1,0],["يَمضي بِنا الفَتَيانِ ما أَخَذا لَنا","نَفساً عَلى حالٍ وَلا تَرَكانا",37,"ن",2,0],["يَمضي أمامَكَ نصرُ اللَّهِ مُنصلتاً","بالفتح يَقصمُ مَن في الأرضِ ناواكا",38,"ك",2,0],["يمضي الدليلُ بهم ويذهبُ مُوقِناً","ثَبْتاً فما يرتابُ أو يتوهّم",39,"م",1,0],["يمضون لله وللرسول","وينثنون ببلوغ السّول",40,"ل",1,0],["يَمْضِي الزَّمَانُ وَتَبْقَى فِي ضَمَائِرِهِمْ","خَلِيقَ ذِكْرَى بِتَكْرِيمٍ وَتَخْلِيدِ",41,"د",1,0],["يَمْضِي وَيَرْجَعُ الرَّجَاءُ","نَادِياً مِنَ العَرَقْ",42,"ق",1,0],["يَمْضِينَ فِي طَلَبِ الغَايَاتِ قَاصِيَةً","فَمَا يَنِيْنَ وَمَا يَشْكُونَ مِنْ نَصَبِ",43,"ب",1,0],["يُمَضُّ مَنْ مَرَّ بِهِ نَاظِراً","لِفَرْطِ مَا يُؤْلِمُهُ المَنظرُ",44,"ر",1,0],["يَمْضِي الزَّمَانُ وَتَنْقَضِي أَحْدَاثُهُ","وَهَواكِ مِنَّا فِي القُلُوبِ هَوَاكِ",45,"ك",1,0],["يَمْضي ويذْمرُنَا عَنْ غيرِ مَعْصِيةٍ","كأَنَّه البَدْرُ لم يُطْبَعْ على الكَذِبِ",46,"ب",1,0],["يمضيهما منه خيال مارد","أبو الفتوحات الذي لا يقهر",47,"ر",1,0],["يمضي وينسى خلفه","عاداته المسفّهه",48,"ه",1,0],["يمضي العظيمُ من الرجال فينبري","لمكنه خلفاء من أقرانه",49,"ن",2,0],["يَمضي ويتبعُه الشبابُ كما جرتْ","جُرْدُ المذاكي في غُبَار خَصافِ",50,"ف",1,0],["يمضي يراعك في الضريبة إن نَبا","سيف بكف مدرَّع وتثلّما",51,"م",2,0],["يمضي العظيمُ من الرجال، فينبري","لمكانه خُلفاءُ من أقرانه",52,"ن",2,0],["يمضي إليه ، على الحنين وينثني","منه على فرس من الأطياف",53,"ف",1,0],["يم