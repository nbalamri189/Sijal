{"poems":[[65,"بمنشط الشيح من نجد لنا وطن","https://www.aldiwan.net/poem45681.html","البسيط"],[32,"تصابيت في أطلال مية بعدما","https://www.aldiwan.net/poem29578.html","الطويل"],[94,"كرهت القصور وقطانها","https://www.aldiwan.net/poem38931.html","المتقارب"],[87,"شجوني إذا جن الظلام كثير","https://www.aldiwan.net/poem7520.html","الطويل"],[47,"أبالمنحنى أم بالعقيق أم الجرف","https://www.aldiwan.net/poem65157.html","الكامل"],[63,"إلام يروم الحاسدون نضالي","https://www.aldiwan.net/poem51479.html","الطويل"],[107,"إلام تجن الحادثات وتظلم","https://www.aldiwan.net/poem43423.html","الطويل"],[77,"أقول دمى وهي الحسان الرعابيب","https://www.aldiwan.net/poem69105.html","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202534","الرجز"],[234,"ما استحسن الحب حتى استقبح العذل","https://www.aldiwan.net/poem50848.html","البسيط"],[385,"أأرجوا من الإلمام بالطلل البالي","https://www.aldiwan.net/poem48836.html","الطويل"],[487,"وأعلم حقا أن بعدي عنكم","https://www.aldiwan.net/poem24416.html","عموديه"],[487,"تبدت معاني الجمع حشو ردائها","https://www.aldiwan.net/poem24496.html","عموديه"],[950,"","https://poetry.dctabudhabi.ae/diwan/poem/129530","الطويل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112889","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64485","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108912","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27895","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27612","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27766","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27937","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27940","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27622","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27654","الطويل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47192","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204590","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74202","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117992","المتقارب"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133256","البسيط"],[3892,"","https://poetry.dctabudhabi.ae/diwan/poem/97709","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111453","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141675","الطويل"],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[4767,"طفل الخلود","https://www.poetsgate.com/ViewPoem.aspx?id=88355",""],[1901,"دعاني وشاني عَلَّ يشفى غليليا","https://www.poetsgate.com/ViewPoem.aspx?id=160397",""],[4865,"ألا أيها الويلات ويلة من بكى","https://www.poetsgate.com/ViewPoem.aspx?id=213877",""],[4119,"خذوا حديث غرامي عن ضنا بدني","https://www.poetsgate.com/ViewPoem.aspx?id=16232",""],[5783,"دفاع عن شرف القبيلة","https://www.poetsgate.com/ViewPoem.aspx?id=36934",""],[5001,"ماذا أريد ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80713&r=&rc=3",""]],"verses":[["فَما ثَنَى اللَّومُ مِن غَربي وَذا عَمَهٌ","يا سَلمَ ما أَنا بَعدَ الشَّيبِ وَالطَّرَبُ",0,"ب",1,0],["فَما ثَنيُ نَفسي عَن هَواها فَإِنَّهُ","طَويلٌ عَلى آثارِ مَيٍّ زَفيرُها",1,"ر",3,0],["فما ثَمَّ إلاَّ الصُّخُورُ القَواسي","وإلاَّ الصَّدى المُسْتَطارُ الهَتُوفْ",2,"ف",1,0],["فما ثار هذا الليل عندي وإنني","أليف له في جُنحه وسمير",3,"ر",1,0],["فَما ثَلَموا حَدّي وَلا فَتَلوا يَدي","وَلا ضَعضَعوا عَزمي وَلازَعزَعوا كَهفي",4,"ف",2,0],["فما ثَلَمَ الأَعدْاءُ حَدَّ مَضاربي","ولا شَربَ الحُسَّادُ ماءَ صِقالي",5,"ل",2,0],["فَما ثاكِلٌ شَمطاءٌ أَمسى وَحيدُها","تخَرَّمهُ صَرفُ الرَدى المتخرِّمُ",6,"م",1,0],["فمأثور ذكرِ المجد فيها مُفَضَّضٌ","وفوقَ حديدِ الهندِ منهُنّ تذهيب",7,"ب",1,0],["فما ثنى القوم عن القتال","نعيُّ والٍ أو بشيرُ تال",8,"ل",1,0],["فما ثُغورُ العَذَارى كُلُّها عَطِرٌ","ولا عيونُ الغوانِي كُلُّها نُجُلُ",9,"ل",1,0],["فَما ثُمَ ظَلٌّ غَير قَسطاط عَثير","دَعائِمُهُ المرّان وَالأَسَل العالي",10,"ل",2,0],["فما ثمّ إلا الوهم وهي حقيقة","وكل وراء فهو شيء كسائر",11,"ر",1,0],["فما ثم مهجور ولا ثم واصل","وما ثم مقطوع لديك عبورها",12,"ر",3,0],["فما ثم بعد اللَه غيرك ملجأ","ولا للأماني بعد ذي اليوم من غد",13,"د",1,0],["فما ثم إلا مكرم ومكرم","وما ثم إلا زائر ومزور",14,"ر",1,0],["فما ثم وجدانية بعد مبدأ","فتقبل في أوصافها جزء وحدة",15,"ه",1,0],["فما ثناه الذي ناواه عن ملكٍ","لما رآه رأى بدراً على غصن",16,"ن",1,0],["فما ثَم إلا الميلُ ما ثَم غيره","ولو لم يكن ميل لماٌ كوِّن الأصل",17,"ل",1,0],["فما ثَم إلا العرضُ ما ثم فيصَلٌ","فقد أغلقَ البابُ الذي كان للولي",18,"ل",2,0],["فما ثَم إلا الكشف ما ثم غيرهُ","له ترفع الأستار في الحالِ إن يشا",19,"ش",2,0],["فما ثَمَّ إلا الكشفُ ما ثَم غيرُه","وما بعد علم العينِ علمٌ يوازن",20,"ن",1,0],["فما ثم إلا كاملٌ في طريقه","من أصحابِ أفلاكٍ وأصحابِ أركان",21,"ن",1,0],["فما ثَمَّ إلا عاشقُ عينِ ذاته","عموماً وتخصيصاً لدى كلِّ عاقل",22,"ل",1,0],["فما ثَمَّ إلا ما رأيتُ ومن يرم","سوى ما رأينا فهو شخصٌ تعسفا",23,"ف",2,0],["فما ثَمَّ فوق الأرض مَنْ لم يكن له","رجاء أياديك الجليلةِ والْخَوْفُ",24,"ف",1,0],["فما ثمّ أحلا مشرب من مذاقه","وللصين من مرآه أجمل منظر",25,"ر",1,0],["فَما ثم إِلا واحد فاضَ جوده","عَلى كُل ذَرات الوُجود بِلا لَبس",26,"س",1,0],["فما ثم إلا اكتساب العلا","ومجد وجود ونفع عميم",27,"م",1,0],["فماثتلهم عن الترحال عسرتهم","ولا هجير به تغلى المراجيل",28,"ل",1,0],["فَما ثأرهُ فيكم وَلكنّ ثأرهُ","شُريجٌ أَأردَته الأسنّة أَم هوى",29,"ا",1,0],["فَماثَلَ آكاماسَ شَكلاً وَهَيبَةً","وصاحَ أَلا فاسطُوا على القَوم واضربوا",30,"ب",3,0],["فما ثمّ أشباه لها ومقاييس","وفيها من العزّ الكرام أعزّة",31,"ه",1,0],["فَما ثَمَّ مِن شَيءٍ سِوى اللَهُ في الوَرى","وَما ثَمَّ مَسموعٌ وَما ثَمَّ سامِعُ",32,"ع",1,0],["فما ثارت لأخذ الثأر كف","أعاقتها من الغرب القيود",33,"د",1,0],["فما ثَمَّ إلا نوحةَ من متيّمِ","تخففُ حزناً أو تزيدُ تأسّيا",34,"ي",2,0],["فما ثأره فيكم ولكن ثأره","شريح أرادته الأسنة والقنا",35,"ا",1,0],["فما ثنت ناظري عن منظر حسن","حتى أرتني مكاني من أبي الحسن",36,"ن",1,0],["فماثناني عن الإحسان جائرهم","ولا لغير الهوى سارت بي القدم",37,"م",1,0],["فما ثم عندالله أقرب من فتى","يقومُ بجنح الليل يقنُتُ باكيا",38,"ي",2,0]]}