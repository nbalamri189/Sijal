{"poems":[[63,"بمنشط الشيح من نجد لنا وطن","https://www.aldiwan.net/poem45681.html","البسيط"],[30,"تصابيت في أطلال مية بعدما","https://www.aldiwan.net/poem29578.html","الطويل"],[92,"كرهت القصور وقطانها","https://www.aldiwan.net/poem38931.html","المتقارب"],[85,"شجوني إذا جن الظلام كثير","https://www.aldiwan.net/poem7520.html","الطويل"],[45,"أبالمنحنى أم بالعقيق أم الجرف","https://www.aldiwan.net/poem65157.html","الكامل"],[61,"إلام يروم الحاسدون نضالي","https://www.aldiwan.net/poem51479.html","الطويل"],[105,"إلام تجن الحادثات وتظلم","https://www.aldiwan.net/poem43423.html","الطويل"],[75,"أقول دمى وهي الحسان الرعابيب","https://www.aldiwan.net/poem69105.html","الطويل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202534","الرجز"],[229,"ما استحسن الحب حتى استقبح العذل","https://www.aldiwan.net/poem50848.html","البسيط"],[380,"أأرجوا من الإلمام بالطلل البالي","https://www.aldiwan.net/poem48836.html","الطويل"],[482,"وأعلم حقا أن بعدي عنكم","https://www.aldiwan.net/poem24416.html","عموديه"],[482,"تبدت معاني الجمع حشو ردائها","https://www.aldiwan.net/poem24496.html","عموديه"]],"verses":[["فَما ثَنَى اللَّومُ مِن غَربي وَذا عَمَهٌ","يا سَلمَ ما أَنا بَعدَ الشَّيبِ وَالطَّرَبُ",0,"ب",1,0],["فَما ثَنيُ نَفسي عَن هَواها فَإِنَّهُ","طَويلٌ عَلى آثارِ مَيٍّ زَفيرُها",1,"ر",3,0],["فما ثَمَّ إلاَّ الصُّخُورُ القَواسي","وإلاَّ الصَّدى المُسْتَطارُ الهَتُوفْ",2,"ف",1,0],["فما ثار هذا الليل عندي وإنني","أليف له في جُنحه وسمير",3,"ر",1,0],["فَما ثَلَموا حَدّي وَلا فَتَلوا يَدي","وَلا ضَعضَعوا عَزمي وَلازَعزَعوا كَهفي",4,"ي",1,0],["فما ثَلَمَ الأَعدْاءُ حَدَّ مَضاربي","ولا شَربَ الحُسَّادُ ماءَ صِقالي",5,"ي",1,0],["فَما ثاكِلٌ شَمطاءٌ أَمسى وَحيدُها","تخَرَّمهُ صَرفُ الرَدى المتخرِّمُ",6,"م",1,0],["فمأثور ذكرِ المجد فيها مُفَضَّضٌ","وفوقَ حديدِ الهندِ منهُنّ تذهيب",7,"ب",1,0],["فما ثنى القوم عن القتال","نعيُّ والٍ أو بشيرُ تال",8,"ل",1,0],["فما ثُغورُ العَذَارى كُلُّها عَطِرٌ","ولا عيونُ الغوانِي كُلُّها نُجُلُ",9,"ل",1,0],["فَما ثُمَ ظَلٌّ غَير قَسطاط عَثير","دَعائِمُهُ المرّان وَالأَسَل العالي",10,"ل",2,0],["فما ثمّ إلا الوهم وهي حقيقة","وكل وراء فهو شيء كسائر",11,"ر",1,0],["فما ثم مهجور ولا ثم واصل","وما ثم مقطوع لديك عبورها",12,"ر",3,0]]}