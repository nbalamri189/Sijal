{"poems":[[90,"هي عيني ودمعها نضاح","https://www.aldiwan.net/poem44461.html","الخفيف"],[53,"طلعت شنطف صباحا فقلنا","https://www.aldiwan.net/poem8184.html","الخفيف"],[87,"لِيعِنا كل معبود معين","https://www.aldiwan.net/poem7767.html","الرمل"],[58,"ليس ذا الدمع دمع عيني ولكن","https://www.aldiwan.net/poem58570.html","الكامل"],[69,"حي بلبيس منزلا في العماره","https://www.aldiwan.net/poem18062.html","الخفيف"],[50,"شجر التفاح لا ذقت القحل","https://www.aldiwan.net/poem64516.html","الرمل"],[78,"ختمت فأرة مسك","https://www.aldiwan.net/poem39242.html","مجزوء الرمل"],[108,"ما نسيناك","https://www.poetsgate.com/ViewPoem.aspx?id=179363",""],[102,"أحزان .. وإصرار","https://www.poetsgate.com/ViewPoem.aspx?id=50332",""],[53,"طلعتْ شنطفٌ صباحاً فقلنا","https://www.poetsgate.com/ViewPoem.aspx?id=26828",""],[147,"عاذ بالصفح من أَحب البقاء","https://www.aldiwan.net/poem11716.html","الخفيف"],[164,"اسكنوها بسلام آمنينا","https://www.aldiwan.net/poem58828.html","الطويل"],[170,"خل جرجان وخيم أينما","https://www.aldiwan.net/poem46866.html","الرمل"],[208,"سيدي دعني أداري","https://www.aldiwan.net/poem53305.html","مجزوء الرمل"],[259,"كفى عنادا","https://www.aldiwan.net/poem36218.html","مجزوء الرمل"],[333,"نذر العمر للغرام صبيا","https://www.aldiwan.net/poem55029.html","الخفيف"],[347,"قيل لي هات في الوطن","https://www.aldiwan.net/poem55326.html","مجزوء الخفيف"],[369,"أعلى العهد القديم","https://www.aldiwan.net/poem60643.html","مجزوء الرمل"],[443,"أترى حان لكم نحوي التفات","https://www.aldiwan.net/poem2562.html","الرمل"],[534,"عجبا أين العقول","https://www.aldiwan.net/poem37269.html","مجزوء الرمل"],[543,"حيثما سرت فالمعالي تسير","https://www.aldiwan.net/poem48186.html","عموديه"],[556,"خل عنها منيحة للئام","https://www.aldiwan.net/poem47202.html","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64063","الخفيف"],[1399,"","https://poetry.dctabudhabi.ae/diwan/poem/143713","الخفيف"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[1933,"","https://poetry.dctabudhabi.ae/diwan/poem/144319","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77227","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93736","الرمل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137464",""],[3345,"","https://poetry.dctabudhabi.ae/diwan/poem/97844","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74055","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62963","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62869","الخفيف"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131999","الرمل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83119","الخفيف"],[4830,"( مابين الوَعْدَين )","https://www.poetsgate.com/ViewPoem.aspx?id=194438",""],[5121,"يَا صَديقِي","https://www.poetsgate.com/ViewPoem.aspx?id=213495",""],[5186,"من مغيثي، من منصفي، من مجيري؟","https://www.poetsgate.com/ViewPoem.aspx?id=156554",""],[5196,"أحمد الله ذا الجلال كثيراً","https://www.poetsgate.com/ViewPoem.aspx?id=86495",""],[5691,"المفسدون في الأرض","https://www.poetsgate.com/ViewPoem.aspx?id=206745",""],[5784,"ليس ذنبي","https://www.poetsgate.com/ViewPoem.aspx?id=189911",""],[6177,"يُوجِع الموتُ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79068&r=&rc=15",""]],"verses":[["ليس ذا الموج فيّ موجاً ولكن","هو منّي تنهّد وصياح",0,"ح",1,0],["ليس ذنبي إلى الأُيورِ سوى وجْ","هي فقلنا بخٍ بخٍ أيُّ ذنبِ",1,"ب",1,0],["ليس ذاك الجنس من نسل البشر","إن شككتم أمعنوا فيه النظر",2,"ر",1,0],["ليسَ ذَا الدَّمْعُ دَمْعَ عَيْني ولكنْ","هيَ نَفْسِي تُذِيبُها أَنْفَاسِي",3,"ي",1,1],["ليس ذا حالُ مَنْ يُرِيدُ حيَاةً","لِعيالٍ ولا لِبَيْتٍ عِمَارَهْ",4,"ر",2,0],["لَيسَ ذاكَ العَضُّ مِن عَيبٍ بِها","إِنَّما ذاكَ سُؤالٌ لِلقُبَل",5,"ل",1,0],["ليس ذا من صَوغِ عَيْ","نيٍّ ولا من نسجِ عَكِّي",6,"ك",2,0],["ليس ذنبي إن بات يرفعك الشع","رُ، ويعلى بين الكواكب شَانك",7,"ك",1,0],["ليس ذا بدء التلاقي بالردى","قد عشقناه وأضنانا وصال",8,"ل",1,0],["ليس ذنبي إلى الأيُورِ سوى وجْ","رهي. فقلنا بخٍبخٍ أي ذنب",9,"ب",1,0],["لَيسَ ذا المُلكُ راضِياً أَن تُرى الرو","مُ لِعُربٍ مِن بَعدِها خُفَراءَ",10,"ا",2,0],["ليس ذا منهم ولكن حّملوا","من هواكم فوق ما قد يقدرونا",11,"ن",2,0],["ليسَ ذو الدرهم يَدري أنّهُ","يشتري ثَلجاً بهِ أم فَحَما",12,"م",2,0],["ليس ذلّي وخضوعي","لك في الحبِّ بعارِ",13,"ر",1,0],["ليس ذكري غيرُ آهٍ","عنك دوماً في الفؤادِ",14,"د",1,0],["ليس ذنبا أنى أهيم بحوا","ء فما زلت في الهوى آدميا",15,"ي",2,0],["ليس ذا السحر صاحبي","انه الهذر والافن",16,"ن",1,0],["ليس ذا الدّهرُ على خُلْ","قٍ لخَلْقٍ بمُقيم",17,"م",1,0],["ليس ذكر للفتى في عصره ذا","غير ما تنشره عنه الصلات",18,"ت",1,0],["لَيْسَ ذا زَادَ مَعادٍ","كُلُّ ذا عَنْكَ يَزُولُ",19,"ل",1,0],["ليس ذا أوَّلي لمَجدٍ وماذا","بِأخيرٍ فالخَيرُ بعدُ كثيرُ",20,"ر",1,0],["لَيس ذَنبي عليه غيرَ زيادا","تي عليه ونقصَه عن تمامي",21,"م",2,0],["ليس ذا من تُقىً يبينُ ولكن","كسرتْهُ غضاضةُ الأسلاف",22,"ف",1,0],["ليس ذاكم كمن يبيتُ بطيناً","من شواءِ ومن قليةِ جزر",23,"ر",1,0],["ليس ذا شأن الكرام","لا تخف يا صاح عود العنا",24,"ن",2,0],["ليس ذا قسوة ولكن مرادي","أن ينال الحبيب مني مراده",25,"د",2,0],["لَيسَ ذا بِالدَليلِ مِنكُم تُقيمو","نَ عَلى رَدِّ حَقِّنا المَفقودِ",26,"د",1,0],["لَيسَ ذا أَول فَضل","واصل مِنكُم إليَّه",27,"ي",2,0],["ليس ذا مال ولكن طالما","عقدوا في طوعه اسمى البنود",28,"د",1,0],["ليس ذنبي سوى مخالفة اللا","حين فيه واخيبة العذال",29,"ل",1,0],["لَيسَ ذا اليَوم يَوم إن تَتَوانوا","وَالألى دونكم علا يسرعونا",30,"ن",2,0],["ليس ذَنبى واللهُ يعلمُ والاق","وامُ في حبكم سِوى اسرافي",31,"ف",2,0],["ليس ذَنبي الى عُفاتِكَ الاَّ","أَنني منكَ بالمَحَلِّ اللطيفِ",32,"ف",1,0],["ليس ذا أولى بما خلده","مسعف الثكلى ومفقود البصر",33,"ر",1,0],["لَيسَ ذنبُ الدعِيِّ هَذا وَلَكن","ذنبُ شَعبٍ بِالزُور يَمتَدِحونَه",34,"ن",2,0],["ليس ذا سوقُ عَبيدٍ حولنا .","هو للأوطانِ سوقٌ قد ظَهَرْ",35,"ر",1,0],["لَيْسَ ذَنْبِي بِأَنَّنِي كُنْتُ حُلْماً","إنَّمَا ذَنْبِي أَنَّنِي جِئْتُ حَيَّا",36,"ي",2,0],["ليس ذنبي ما كان مني، لكن","ذنب أهل التضليل والتغرير",37,"ر",1,0],["ليس ذنبي إلى الزمان سوى أن","ني أحببت شبراً وشبيرا",38,"ر",2,0],["ليس ذا من حريَّةِ الرأي ِوالتَّعْبير","لا بلْ تَطاوُلاً مرْذولا",39,"ل",2,0],["ليس ذنبي إن بان مني الجفاءُ","ذاك أني صبرت لما أساءوا",40,"ا",1,1],["ليس ذا الدمعُ شافيا من ِفراق","إنما نحنُ بالبُكا نتسلّى َ",41,"ل",2,0]]}