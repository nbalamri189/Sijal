{"poems":[[563,"كان أنا سيدي","https://www.aldiwan.net/poem34417.html","مجزوء السريع"],[563,"أنا كتاب الله في الناس","https://www.aldiwan.net/poem34436.html","السريع"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86594","الخفيف"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202087","المنسرح"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46526","الرجز"],[2546,"","https://poetry.dctabudhabi.ae/diwan/poem/33889","الرمل"],[2546,"بِأَبي من هُو دائي","https://www.poetsgate.com/ViewPoem.aspx?id=17132",""]],"verses":[["وهو هو الآن لا","غير بحكم القضا",0,"ض",2,0],["وهو هو الموجود لا غيره","والأمر ماح كل قرطاس",1,"س",1,0],["وَهوَ هَذا الَّذي مصالحُ مصر","منه فازت في سيرها بالمآرب",2,"ب",1,0],["وهْوَ هدَى مُهْتَدِ وذُو لَجج","بالغِشِّ نورَ الُهدَى عليه عَمَى",3,"م",2,0],["وَهوَ هَجين الأَصل حينَ ينسب","وَالعرق دَساس إلَيهِ يجذب",4,"ب",1,0],["وَهوَ هَمّي وَمُنى نَف","سي وَسُؤالي وَرَجائي",5,"ي",1,0],["وهو هَمّي ومُنى نف","سي وسؤلي ورجائي",6,"ي",1,0]]}