{"poems":[[53,"عجزنا عن مراغمة الحمام","https://www.aldiwan.net/poem29763.html","الوافر"],[53,"أعلى الغور تعرفت الخياما","https://www.aldiwan.net/poem29816.html","الرمل"],[53,"تمنى رجال نيلها وهي شامس","https://www.aldiwan.net/poem30198.html","الطويل"],[3,"طربت وهاجتك الظباء السوارح","https://www.aldiwan.net/poem91.html",""],[77,"زارت ونجم الدجى يشكو من الأرق","https://www.aldiwan.net/poem35921.html","البسيط"],[77,"جهاد هوى لكن بغيري ثوابي","https://www.aldiwan.net/poem36716.html","الطويل"],[77,"أخجلتني يا مخجل الشمس","https://www.aldiwan.net/poem35880.html","أحذ الكامل"],[73,"أمولاي بلغت أقصى الأمل","https://www.aldiwan.net/poem11955.html","المتقارب"],[93,"طلعت طلوع الشمس بالنور والندى","https://www.aldiwan.net/poem9832.html","الطويل"],[30,"خليلي لا ربع بوهبين مخبر","https://www.aldiwan.net/poem29588.html","الطويل"],[83,"هذي العوالم لفظ أنت معناه","https://www.aldiwan.net/poem54231.html","البسيط"],[83,"إن الإمام محمدا","https://www.aldiwan.net/poem54326.html","مجزوء الكامل"],[88,"يقولون في الإسلام ظلما بأنه","https://www.aldiwan.net/poem45024.html","الطويل"],[27,"أتطرب حين لاح بك المشيب","https://www.aldiwan.net/poem5666.html","الوافر"],[27,"ألم تر أن الجهل أقصر باطله","https://www.aldiwan.net/poem5976.html","الطويل"],[37,"وعمى عمرو بن الخثارم قوله","https://www.aldiwan.net/poem6480.html","الطويل"],[37,"وانمار وإن رغمت أنوف","https://www.aldiwan.net/poem7417.html","الوافر"],[37,"من لقلب متيم مستهام","https://www.aldiwan.net/poem7649.html","الخفيف"],[47,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[23,"متى تنسب قريش أو تحصل","https://www.aldiwan.net/poem21443.html","الوافر"],[72,"بالنصر والإقبال والبركات","https://www.aldiwan.net/poem18389.html","الكامل"],[72,"خدمتك من فلك الثناء الدائر","https://www.aldiwan.net/poem18714.html","الكامل"],[72,"على حركات اليمن والأمن والهنا","https://www.aldiwan.net/poem18726.html","الطويل"],[72,"يقولون تبكي والديار قريبة","https://www.aldiwan.net/poem19180.html","الطويل"],[72,"لك الله قد خففت عني مؤونتي","https://www.aldiwan.net/poem19419.html","الطويل"],[51,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[51,"يا ناعي ابن رسول الله في البشر","https://www.aldiwan.net/poem64080.html","البسيط"],[51,"لا تكثرن ملامة العشاق","https://www.aldiwan.net/poem65525.html","الكامل"],[51,"على الطائر الأيمن المرتجى","https://www.aldiwan.net/poem66336.html","المتقارب"],[29,"عفا الجو من سلمى فبادت رسومها","https://www.aldiwan.net/poem6053.html","الطويل"],[29,"أعاذلتي اليوم ويحكما مهلا","https://www.aldiwan.net/poem6068.html","الطويل"],[29,"نبئت أن الخزرجيين حافظوا","https://www.aldiwan.net/poem6084.html","الطويل"],[29,"أيا راكبا إما عرضت فبلغن","https://www.aldiwan.net/poem6172.html","الطويل"],[85,"عزيز من أهلا أخي","https://www.aldiwan.net/poem6966.html","مجزوء الرجز"],[85,"أما وزهر الأنجم","https://www.aldiwan.net/poem7761.html","مجزوء الرجز"],[85,"ساجع الشرق طار عن أوكاره","https://www.aldiwan.net/poem62880.html","الخفيف"],[85,"أبا الهول طال عليك العصر","https://www.aldiwan.net/poem63767.html","المتقارب"],[43,"بغيرك راعيا عبث الذئاب","https://www.aldiwan.net/poem9459.html","الوافر"],[45,"دنا السرب إلا أن هجرا يباعده","https://www.aldiwan.net/poem63461.html","الطويل"],[28,"ورث الخلافة سبعة آباءه","https://www.aldiwan.net/poem5216.html","الكامل"],[28,"وجدي عقال من يكن فاخرا به","https://www.aldiwan.net/poem5284.html","الطويل"],[28,"تحن بزوراء المدينة ناقتي","https://www.aldiwan.net/poem5618.html","الطويل"],[58,"لنا الراية الحمراء يخفق ظلها","https://www.aldiwan.net/poem30883.html","الطويل"],[49,"إلى كم إذا ما غبت ترجى سلامتي","https://www.aldiwan.net/poem10830.html","الطويل"],[66,"لا راجع الطرف باللقا وسنه","https://www.aldiwan.net/poem40971.html","المنسرح"],[80,"قم هاتها من كف ذات الوشاح","https://www.aldiwan.net/poem31520.html","السريع"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[87,"نعاء عليه أيها الثقلان","https://www.aldiwan.net/poem8232.html","الطويل"],[69,"وعمر إسلامه بيته","https://www.aldiwan.net/poem28005.html","المتقارب"],[81,"ولما تبرج خضر البطاح","https://www.aldiwan.net/poem61438.html","المتقارب"],[39,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[52,"شجتك لهند دمنة وديار","https://www.aldiwan.net/poem27053.html","الطويل"],[52,"رثيت الحجيج فقال العداة","https://www.aldiwan.net/poem27263.html","المتقارب"],[67,"سارت العيس يرجعن الحنينا","https://www.aldiwan.net/poem18109.html","الرمل"],[48,"رأيت المسجد الجام","https://www.aldiwan.net/poem64327.html","الهزج"],[48,"لنا بالبصرة البيضاء","https://www.aldiwan.net/poem66122.html","الهزج"],[46,"إن تاب إبليس يوما تاب عابدكم","https://www.aldiwan.net/poem23473.html","البسيط"],[8,"إما تري ظلل الأيام قد حسرت","https://www.aldiwan.net/poem21815.html","البسيط"],[8,"وعمي الذي حامى غداة مناجل","https://www.aldiwan.net/poem21841.html","الطويل"],[8,"قالت أمامة كم عمرت زمانة","https://www.aldiwan.net/poem21849.html","الكامل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/141006",""],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16636","البسيط"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30498","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42610","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55140","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54736","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54717","الخفيف"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67312","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141994","الوافر"],[77,"زارت ونجم الدجى يشكو من الأرق","https://www.poetsgate.com/ViewPoem.aspx?id=34208",""],[90,"المآسي في حياة الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=179158",""],[45,"دَنَا السّرْبُ، إلاّ أنّ هَجراً يُباعِدُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=32954",""],[75,"ألا كلُّ آتٍ قريبُ المَدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10783&r=&rc=3",""],[3,"طربتَ وهاجتكَ الظباءُ السوانح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10667&r=&rc=21",""]],"verses":[["وَعُمرُ المَرءِ يَنقُصُ كُلَّ يَومٍ","وَلا عُمرٌ يَقَرُّ عَلى التَمامِ",0,"م",1,0],["وَعَمَرتُم آمِني رَيبِ الرَدى","يَمطُلُ الخَطبُ بِكُم عاماً فَعاما",1,"م",2,0],["وَعَمَّتهُمُ مِن حَدِّ بَأسِكَ سَطوَةٌ","بِها اِجتُدِعَت أَعناقُهُم لا المَعاطِسُ",2,"س",1,0],["وَعَمرواً وَحَبّاناً تَرَكنا بِقَفرَةٍ","تَعودُهُما فيها الضِباعُ الكَوالِحُ",3,"ح",1,0],["وعمّ بالرِّفْقِ هذا القُطْرَ فابْتَدَرَتْ","تنْمي مآثِرَهُ جوّابَة الأفُقِ",4,"ق",1,0],["وَعُمْرٍ تولى في لَعَلَّ وَفي عَسى","وَدَهْرٍ تَقَضَّى فِي نَوى وَعِتَابِ",5,"ب",1,0],["وعمَرْتَ كُرسيَّ الخِلافَةِ معْصو","ماً بحقِّ العرْشِ والكُرْسي",6,"س",2,0],["وَعُمِّرتَ ما شِئتَ في دَولَةٍ","تُقَصِّرُ عَنها طِوالُ الدُوَل",7,"ل",1,0],["وعما أعدت ليتيم فثقفت","فرب يتيمٍ عاد للخلق سيدا",8,"د",2,0],["وَعَمِّي الَّذي قادَ الرِبابَ جَماعَةً","وَسَعداً هوَ الرَأَسُ الرَئِيسُ المُؤَمَّرُ",9,"ر",1,0],["وَعَمرٌو وَأَبناءُ النَوارِ كَأَنَّهُم","نُجومُ الثُريَّا في الدُجا حِينَ تَبَهرُ",9,"ر",1,0],["وعمَّ بالروْح والريحان صحبته","وجادهم من نمير العفو أصفاهُ",10,"ا",2,0],["وعمامة التقوى التي","من فوقها شَمسُ الهدى",11,"د",2,0],["وعمّا قليل طبّق الأرض حكمهم","بأسرع من رفع اليدَيْن إلى الفم",12,"م",1,0],["وَعَمروٌ قَد كَرِهتُ عِتابَ عَمروٍ","وَقَد كَثُرَ المَعاتِبُ وَالذُنوبُ",13,"ب",1,0],["وَعَمّي رَئيسُ الدَهمِ يَومَ قُراقِرٍ","فَكانَ لَنا مِرباعُهُ وَنَوافِلُه",14,"ل",2,0],["وَعِمرانُ يَومَ الأَقرَعَينِ كَأَنَّما","أَناخَ بِذي قُرطَينِ خُرسٍ خَلاخِلُه",14,"ل",2,0],["وعَمَّى عمرو بن الخَثَارم قوله","بني من يفاع المجد ما هو تُرْتُبُ",15,"ب",1,1],["وعمرو بن الخُثارم كان طبا","بنسبتهم وتصديقاً لقيلي",16,"ل",2,0],["وَعَمِيدٍ مُتَوَّجٌ حُلَّ عَنهُ","عُقَدُ التَّاجِ بالصَّنِيعِ الحُسَامِ",17,"م",1,0],["وَعَمّي الَّذي أَردى الوَزيرَ وَفاتِكاً","وَما الفارِسُ الفَتّاكُ إِلّا المُجاهِرُ",18,"ر",1,0],["وَعَمّي الَّذي سُلَّت بِنَجدٍ سُيوفُهُ","فَرَوَّعَ بِالغَورَينِ مَن هُوَ غائيرُ",18,"ر",1,0],["وَعَمّي الَّذي سَمَّتهُ قَيسٌ مُزَرنَفاً","وَقَد شَجَرَت فيهِ الرِماحُ الشَواجِرُ",18,"ر",1,0],["وَعَمّي الَّذي أَفنى الشُراةَ بِوَقعَةٍ","شَهيدانِ فيها الرائِبانِ وَجازِرُ",18,"ر",1,0],["وَعَمّي الَّذي ذَلَّت حَبيبٌ لِسَيفِهِ","وَكانَت وَمَرعاها مِنَ العِزِّ ناضِرُ",18,"ر",1,0],["وَعَمّي الحَرونُ عِندَ كُلِّ كَتيبَةٍ","تَخِفُّ جِبالٌ وَهوَ لِلمَوتِ صابِرُ",18,"ر",1,0],["وَعِمرانَ اِبنَ مَخزومٍ فَدَعها","هُناكَ السِرُّ وَالحَسَبُ اللُبابُ",19,"ب",1,0],["وعمائر موصولة بعمائرٍ","طيارة في الذكر والغرفات",20,"ت",1,0],["وعمرت فيها كلّ بيت عبادة","فأتى المديحُ بكلِّ بيت عامر",21,"ر",1,0],["وعمَّرتها يا عمرك الله للعلى","فعشْ مثلها عالي المنار معمّرا",22,"ر",2,0],["وعما قليل ينفذ البين سهمه","فلا مهجة تبقى ولا دمع يهمع",23,"ع",1,0],["وعمَّرت بيتي بالدقيق فلم أسل","وكم لكَ في فعلِ الجميل دقائق",24,"ق",1,0],["وعملتَ ما عمل المشا","رك في البضاعة لا الأجيرُ",25,"ر",1,0],["وعمّ فقدك أهلَ الأرض كلَّهمُ","لم يُبقِ ذا نفس منهم ولم يذر",26,"ر",1,0],["وعمرت ما عمرت مكارمك التي","تبلى ثياب الدهر وهي بواقي",27,"ق",2,0],["وعمَّرهُ اللَّهُ حتَّى تَرى","بنيه رُعاةَ بني آدم",28,"م",1,0],["وَعَمَّهُما بِالماءِ حَتّى تَواضَعَت","رُؤوسُ المِتانِ سَهلُها وَحُزومُها",29,"م",3,0],["وَعَمّايَ نِعمَ المَرءُ عَمروٌ وَمالِكٌ","وَثَعلَبَةُ المولي بِمَنظورَةٍ فَضلا",30,"ل",2,0],["وَعَمروُ بنُ بَكرٍ لَم تُكَشَّف سُتورُها","وَحَرَّرتُ عَبدَ اللَهِ فيمَن يُحَرَّرُ",31,"ر",1,0],["وَعِمرانَ أَن أَدّوا الَّذي قَد وَأَيتُمُ","وَأَعراضُكُم مَوفورَةٌ لَم تُمَزَّقِ",32,"ق",1,0],["وعمرها يا رشاد","يربو على الثمانين",33,"ن",1,0],["وعمرَها ما سمعت","بالقشعم بن الأرقم",34,"م",1,0],["وَعِمادَ الصَديقِ إِن مالَ دَهرٌ","وَشِفاءَ المَحزونِ مِن أَكدارِهِ",35,"ر",2,0],["وَعَمرو يَسوقُ بِمِصرَ الصِحابَ","وَيُزجي الكِتابَ وَيَحدو السُوَر",36,"ر",1,0],["وَعَمرٌ في مَيامِنِهِم عُمورٌ","وَكَعبٌ في مَياسِرِهِم كِعابُ",37,"ب",1,0],["وَعَمرُ بنُ مَعدي إِن ذَهَبتَ تَهيجُهُ","وَأَوسُ بنُ سُعدى إِن ذَهَبتَ تُكايِدُه",38,"د",2,0],["وَعِمادُ بَيتِكَ في قُرَيشٍ رُكِّبَت","في الأَكرَمينَ وَفي العَديدِ الأَكثَرِ",39,"ر",1,0],["وَعَمّي الَّذي اِختارَت مَعَدٌّ حُكومَةً","عَلى الناسِ إِذ وافَوا عُكاظَ بِها مَعا",40,"ع",2,0],["وَعَمراً أَخا عَوفٍ تَرَكنا بِمُلتَقىً","مِنَ الخَيلِ في سامٍ مِنَ النَقعِ قاتِمِ",41,"م",1,0],["وَعَمراً وَسُفياناً وَجَهماً وَمالِكاً","وَحَوشَبَ وَالغاوي شَريحاً وَأَظلَما",42,"م",2,0],["وَعُمِّمتُ مِن نَسجِ القَتيرِ عِمامَةً","رُقومُ البِلى مَرقومَةٌ في عِمامَتي",43,"ي",1,0],["وَعَمَّرَ اللَهُ حاسِديكَ لِكَي","تَعيشَ في الذُلِّ عيشَةً خَشِنَه",44,"ن",2,0],["وعمّ منهُ الذلُّ أهلَ الخنى","وعمَّ منْهُ العزُّ أهلَ الصّلاح",45,"ح",1,0],["وَعَمَّهم بِكِتابٍ حَضَّ فيهِ عَلى","مَحاسِنِ الفَضلِ وَالآدابِ وَالشِّيمِ",46,"م",1,0],["وَعُمِّي قُبُورَ الْعَالَمِينَ كَرَامَةً","لِقَبْرَيْنِ بِالْبَطْحَاءِ يَلْتَقِيَانِ",47,"ن",1,0],["وعمَّرَ إسلامُه بيتَهُ","وخرَّبَ أبياتَ أخصامِهِ",48,"ه",1,1],["وَعَمَّ جَداكَ عُمومَ السَحابِ","يَسقي البِلادَ وَيَسقي الفَلا",49,"ل",2,0],["وَعِمادُ أَوسَطِهِ عتا","قُ صَفائِحِ اليَمَنِ الفَواصِل",50,"ل",1,0],["وَعَمَّ السَماءَ النَقعُ حَتّى كَأَنَّهُ","دُخانٌ وَأَطرافُ الرِماحِ شَرارُ",51,"ر",1,0],["وَعَمروُ بنُ عَبدٍ وَأَحزابُهُ","سَقاهُم حَسا المَوتِ في يَثرِبِ",52,"ب",1,0],["وَعَمُوا عنه فلا وَاللهِ ما","تَنْفَعُ الشِّمْسُ لَدَى القَوْمِ العَمِينا",53,"ن",2,0],["وَعَمروٍ صاحِبُ الرايَ","ةِ لا بَل دِرهَمَ الكيسِ",54,"س",1,0],["وَعِمرانُ اِبنُ عَمروٍ","فَفيهِ الأَمرُ وَالشانُ",55,"ن",1,0],["وَعَمَّنا الغَيُّ حَتّى خِلتَنا دَمِثاً","مُقابِلاً مِن سَفاهٍ عارِضاً هَتِنا",56,"ن",2,0],["وَعمَّمتني بَقايا الدَهرِ مِن قُطُنٍ","فَقَد أُنَضِّجُ ذا فِرقينِ مَيّالا",57,"ل",2,0],["وَعَمِّي الَّذي حامَى غَداةَ مَناجِلٍ","عَنِ القَومِ حتّى فادَ غَيرَ ذَمِيمِ",58,"م",1,1],["وَعُمِرتُ حَتّى جاءَ أَحمدُ بالهُدى","وَقَوارعٍ تُتلى مِن الفِرقانِ",59,"ن",1,0],["وعمروٌ في ميامنهم عمورٌ","وكعبٌ في مياسرهم كعاب",60,"ب",1,0],["وعَمْرُ هِنْدٍ كأنّ الَله صَوَّرَهُ","عَمرو بنَ هِنْدٍ يَسومُ الناسَ تَعْنيتا",61,"ت",2,0],["وعَمَّمَ صُلْعَ الهُضْبِ مِن قَطْرِ ثَلْجِهِ","يَدانِ مِن الصِّنَّبْرِ تَبتَدِرانِ",62,"ن",1,0],["وَعَمَّا قَلِيلٍ يَنْتَهِي الأَمْرُ كُلُّهُ","فَمَا أَوَّلٌ إِلَّا وَيَتْلُوهُ آخِرُ",63,"ر",1,0],["وَعَمَا قَلِيلٍ يَقْضِيَانِ مِنَ الجوَى","وَإِنْ صَحَّ ظَنِي فَهْي تَهِلِكُ أَوَّلُ",64,"ل",1,0],["وَعَمَّا أَعَدَّتْ لِلْيَتِيمِ فَثَقَّفَتْ","فَرُبَّ يَتِيمٍ عَادَ لِلْخَلْقِ سَيِّدَا",65,"د",2,0],["وَعَمِيداً بَثَّ الهِدَايَةَ فِي قَوْ","مٍ لَهُمْ تِيهُهُمْ بِذَاكَ العَمِيدِ",66,"د",1,0],["وعمرٌو وعثمانُ بنُ عفّانَ والفَتَى","أبو مَرْثَدٍ سُقْيَا لِذَلكَ في الأَجْرِ",67,"ر",1,0],["وعمرُ الورد ما يهمي شذاهُ","على دنياهُ لا شهرٌ وعام",68,"م",1,0],["وعم بالرفق هذا القطر فابتدرت","تنمي مآثره جوابة الرفق",69,"ق",1,0],["وعما أفادت من بلادٍ تكالَبَتْ","على الغُنم ، وارتدَّت سِباعاً ضواريا",70,"ي",2,0],["وَعَمْرُو بنُ مَعدي، إن ذَهبتَ تَهيجُه،","وَأوْسُ بنُ سُعدى، إن ذهَبتَ تُكايدُه",71,"د",2,0],["وعُمْرُ الفتى من أماني الفتى","ولكنْ لبيكِ النَّدى بالنَّدى",72,"ا",1,0],["وعمْراً وَحيَّاناً ترَكْنا بقَفْرَة ٍ","تعودهما فيها الضّباعُ الكوالح",73,"ح",1,0]]}