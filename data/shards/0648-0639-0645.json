فر"],[458,"عِمي صباحا بعدنا واسلمي","https://www.aldiwan.net/poem55887.html","السريع"],[458,"أعينوني على طلب المعالي","https://www.aldiwan.net/poem56066.html","الوافر"],[458,"كذا تنقضي الأيام حالا على حال","https://www.aldiwan.net/poem56070.html","الطويل"],[458,"طوى الليل راكب أخطاره","https://www.aldiwan.net/poem56164.html","المتقارب"],[458,"أهفو لعلوي الرياح إذا جرت","https://www.aldiwan.net/poem56260.html","الطويل"],[461,"خليلي من عليا تميم بن خندف","https://www.aldiwan.net/poem15305.html","الطويل"],[461,"وبالقصر أريحي","https://www.aldiwan.net/poem15360.html","المضارع"],[461,"وكنت أبحت الشعر حين ملكته","https://www.aldiwan.net/poem15390.html","الطويل"],[461,"ضروب قذال القرن فذا لدى الوغى","https://www.aldiwan.net/poem16039.html","الطويل"],[461,"إذا ما بحار الأرض جاشت وأجلبت","https://www.aldiwan.net/poem16350.html","الطويل"],[461,"هنيئا للمناقب والمعالي","https://www.aldiwan.net/poem16428.html","الوافر"],[463,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[464,"ظبيات الحمى تخيف الأسودا","https://www.aldiwan.net/poem3169.html","عموديه"],[471,"ألا يا لقوم للجديد المصرم","https://www.aldiwan.net/poem753.html",""],[482,"رماني زماني مذ علاني حبها","https://www.aldiwan.net/poem24484.html","عموديه"],[482,"يا ربنا يا مظهر الشهود","https://www.aldiwan.net/poem24528.html","عموديه"],[506,"اطلت على افقك الزاهر","https://www.aldiwan.net/poem2425.html","المتقارب"],[514,"بزغت بالظلام شمس الديور","https://www.aldiwan.net/poem20787.html","الخفيف"],[515,"إذا لم يكن بين القلوب صدود","https://www.aldiwan.net/poem12062.html","الطويل"],[515,"فقت الملوك مهابة وجلالاً","https://www.aldiwan.net/poem12204.html","الكامل"],[529,"الذي لاح وهو فصل الخطاب","https://www.aldiwan.net/poem37532.html","الخفيف"],[540,"وعميمة قد سقت فيها عائرا","https://www.aldiwan.net/poem56670.html","الكامل"],[551,"أرني العجائب يا أباها","https://www.aldiwan.net/poem47144.html","مجزوء الكامل"],[551,"كتمت من أسماء ما كان علن","https://www.aldiwan.net/poem47149.html","الرجز"],[551,"ماذا جنته ليلة التعريف","https://www.aldiwan.net/poem47387.html","الكامل"],[558,"بأسماء رب العالمين ابتدائيا","https://www.aldiwan.net/poem33573.html","الطويل"],[558,"قل لمن قال عن ذوي العرفان","https://www.aldiwan.net/poem33820.html","الخفيف"],[558,"فؤادي قد أضر به الغرام","https://www.aldiwan.net/poem34183.html","الوافر"],[558,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[567,"نفسي الفداء لمن إذا جرح الأسى","https://www.aldiwan.net/poem69820.html","الكامل"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[570,"تعلم أن خير الناس ميت","https://www.aldiwan.net/poem59477.html","البسيط"],[575,"مديحك كالمسك لا يكتتم","https://www.aldiwan.net/poem3006.html","المتقارب"],[575,"شربت شرب الهيم","https://www.aldiwan.net/poem3010.html","مجزوء الرجز"],[575,"تخطو وتخطر بين الحلي والحلل","https://www.aldiwan.net/poem3024.html","البسيط"],[587,"بحمد ولي الحمد مسدي الفضائل","https://www.aldiwan.net/poem11499.html","عموديه"]],"verses":[["وَعُمرُ المَرءِ يَنقُصُ كُلَّ يَومٍ","وَلا عُمرٌ يَقَرُّ عَلى التَمامِ",0,"م",1,0],["وَعَمَرتُم آمِني رَيبِ الرَدى","يَمطُلُ الخَطبُ بِكُم عاماً فَعاما",1,"م",2,0],["وَعَمَّتهُمُ مِن حَدِّ بَأسِكَ سَطوَةٌ","بِها اِجتُدِعَت أَعناقُهُم لا المَعاطِسُ",2,"س",1,0],["وَعَمرواً وَحَبّاناً تَرَكنا بِقَفرَةٍ","تَعودُهُما فيها الضِباعُ الكَوالِحُ",3,"ح",1,0],["وعمّ بالرِّفْقِ هذا القُطْرَ فابْتَدَرَتْ","تنْمي مآثِرَهُ جوّابَة الأفُقِ",4,"ق",1,0],["وَعُمْرٍ تولى في لَعَلَّ وَفي عَسى","وَدَهْرٍ تَقَضَّى فِي نَوى وَعِتَابِ",5,"ب",1,0],["وعمَرْتَ كُرسيَّ الخِلافَةِ معْصو","ماً بحقِّ العرْشِ والكُرْسي",6,"س",2,0],["وَعُمِّرتَ ما شِئتَ في دَولَةٍ","تُقَصِّرُ عَنها طِوالُ الدُوَل",7,"ل",1,0],["وعما أعدت ليتيم فثقفت","فرب يتيمٍ عاد للخلق سيدا",8,"د",2,0],["وَعَمِّي الَّذي قادَ الرِبابَ جَماعَةً","وَسَعداً هوَ الرَأَسُ الرَئِيسُ المُؤَمَّرُ",9,"ر",1,0],["وَعَمرٌو وَأَبناءُ النَوارِ كَأَنَّهُم","نُجومُ الثُريَّا في الدُجا حِينَ تَبَهرُ",9,"ر",1,0],["وعمَّ بالروْح والريحان صحبته","وجادهم من نمير العفو أصفاهُ",10,"ا",2,0],["وعمامة التقوى التي","من فوقها شَمسُ الهدى",11,"د",2,0],["وعمّا قليل طبّق الأرض حكمهم","بأسرع من رفع اليدَيْن إلى الفم",12,"م",1,0],["وَعَمروٌ قَد كَرِهتُ عِتابَ عَمروٍ","وَقَد كَثُرَ المَعاتِبُ وَالذُنوبُ",13,"ب",1,0],["وَعَمّي رَئيسُ الدَهمِ يَومَ قُراقِرٍ","فَكانَ لَنا مِرباعُهُ وَنَوافِلُه",14,"ل",2,0],["وَعِمرانُ يَومَ الأَقرَعَينِ كَأَنَّما","أَناخَ بِذي قُرطَينِ خُرسٍ خَلاخِلُه",14,"ل",2,0],["وعَمَّى عمرو بن الخَثَارم قوله","بني من يفاع المجد ما هو تُرْتُبُ",15,"ب",1,1],["وعمرو بن الخُثارم كان طبا","بنسبتهم وتصديقاً لقيلي",16,"ل",2,0],["وَعَمِيدٍ مُتَوَّجٌ حُلَّ عَنهُ","عُقَدُ التَّاجِ بالصَّنِيعِ الحُسَامِ",17,"م",1,0],["وَعَمّي الَّذي أَردى الوَزيرَ وَفاتِكاً","وَما الفارِسُ الفَتّاكُ إِلّا المُجاهِرُ",18,"ر",1,0],["وَعَمّي الَّذي سُلَّت بِنَجدٍ سُيوفُهُ","فَرَوَّعَ بِالغَورَينِ مَن هُوَ غائيرُ",18,"ر",1,0],["وَعَمّي الَّذي سَمَّتهُ قَيسٌ مُزَرنَفاً","وَقَد شَجَرَت فيهِ الرِماحُ الشَواجِرُ",18,"ر",1,0],["وَعَمّي الَّذي أَفنى الشُراةَ بِوَقعَةٍ","شَهيدانِ فيها الرائِبانِ وَجازِرُ",18,"ر",1,0],["وَعَمّي الَّذي ذَلَّت حَبيبٌ لِسَيفِهِ","وَكانَت وَمَرعاها مِنَ العِزِّ ناضِرُ",18,"ر",1,0],["وَعَمّي الحَرونُ عِندَ كُلِّ كَتيبَةٍ","تَخِفُّ جِبالٌ وَهوَ لِلمَوتِ صابِرُ",18,"ر",1,0],["وَعِمرانَ اِبنَ مَخزومٍ فَدَعها","هُناكَ السِرُّ وَالحَسَبُ اللُبابُ",19,"ب",1,0],["وعمائر موصولة بعمائرٍ","طيارة في الذكر والغرفات",20,"ت",1,0],["وعمرت فيها كلّ بيت عبادة","فأتى المديحُ بكلِّ بيت عامر",21,"ر",1,0],["وعمَّرتها يا عمرك الله للعلى","فعشْ مثلها عالي المنار معمّرا",22,"ر",2,0],["وعما قليل ينفذ البين سهمه","فلا مهجة تبقى ولا دمع يهمع",23,"ع",1,0],["وعمَّرت بيتي بالدقيق فلم أسل","وكم لكَ في فعلِ الجميل دقائق",24,"ق",1,0],["وعملتَ ما عمل المشا","رك في البضاعة لا الأجيرُ",25,"ر",1,0],["وعمّ فقدك أهلَ الأرض كلَّهمُ","لم يُبقِ ذا نفس منهم ولم يذر",26,"ر",1,0],["وعمرت ما عمرت مكارمك التي","تبلى ثياب الدهر وهي بواقي",27,"ق",2,0],["وعمَّرهُ اللَّهُ حتَّى تَرى","بنيه رُعاةَ بني آدم",28,"م",1,0],["وَعَمَّهُما بِالماءِ حَتّى تَواضَعَت","رُؤوسُ المِتانِ سَهلُها وَحُزومُها",29,"م",3,0],["وَعَمّايَ نِعمَ المَرءُ عَمروٌ وَمالِكٌ","وَثَعلَبَةُ المولي بِمَنظورَةٍ فَضلا",30,"ل",2,0],["وَعَمروُ بنُ بَكرٍ لَم تُكَشَّف سُتورُها","وَحَرَّرتُ عَبدَ اللَهِ فيمَن يُحَرَّرُ",31,"ر",1,0],["وَعِمرانَ أَن أَدّوا الَّذي قَد وَأَيتُمُ","وَأَعراضُكُم مَوفورَةٌ لَم تُمَزَّقِ",32,"ق",1,0],["وعمرها يا رشاد","يربو على الثمانين",33,"ن",1,0],["وعمرَها ما سمعت","بالقشعم بن الأرقم",34,"م",1,0],["وَعِمادَ الصَديقِ إِن مالَ دَهرٌ","وَشِفاءَ المَحزونِ مِن أَكدارِهِ",35,"ر",2,0],["وَعَمرو يَسوقُ بِمِصرَ الصِحابَ","وَيُزجي الكِتابَ وَيَحدو السُوَر",36,"ر",1,0],["وَعَمرٌ في مَيامِنِهِم عُمورٌ","وَكَعبٌ في مَياسِرِهِم كِعابُ",37,"ب",1,0],["وَعَمرُ بنُ مَعدي إِن ذَهَبتَ تَهيجُهُ","وَأَوسُ بنُ سُعدى إِن ذَهَبتَ تُكايِدُه",38,"د",2,0],["وَعِمادُ بَيتِكَ في قُرَيشٍ رُكِّبَت","في الأَكرَمينَ وَفي العَديدِ الأَكثَرِ",39,"ر",1,0],["وَعَمّي الَّذي اِختارَت مَعَدٌّ حُكومَةً","عَلى الناسِ إِذ وافَوا عُكاظَ بِها مَعا",40,"ع",2,0],["وَعَمراً أَخا عَوفٍ تَرَكنا بِمُلتَقىً","مِنَ الخَيلِ في سامٍ مِنَ النَقعِ قاتِمِ",41,"م",1,0],["وَعَمراً وَسُفياناً وَجَهماً وَمالِكاً","وَحَوشَبَ وَالغاوي شَريحاً وَأَظلَما",42,"م",2,0],["وَعُمِّمتُ مِن نَسجِ القَتيرِ عِمامَةً","رُقومُ البِلى مَرقومَةٌ في عِمامَتي",43,"ي",1,0],["وَعَمَّرَ اللَهُ حاسِديكَ لِكَي","تَعيشَ في الذُلِّ عيشَةً خَشِنَه",44,"ن",2,0],["وعمّ منهُ الذلُّ أهلَ الخنى","وعمَّ منْهُ العزُّ أهلَ الصّلاح",45,"ح",1,0],["وَعَمَّهم بِكِتابٍ حَضَّ فيهِ عَلى","مَحاسِنِ الفَضلِ وَالآدابِ وَالشِّيمِ",46,"م",1,0],["وَعُمِّي قُبُورَ الْعَالَمِينَ كَرَامَةً","لِقَبْرَيْنِ بِالْبَطْحَاءِ يَلْتَقِيَانِ",47,"ن",1,0],["وعمَّرَ إسلامُه بيتَهُ","وخرَّبَ أبياتَ أخصامِهِ",48,"ه",1,1],["وَعَمَّ جَداكَ عُمومَ السَحابِ","يَسقي البِلادَ وَيَسقي الفَلا",49,"ل",2,0],["وَعِمادُ أَوسَطِهِ عتا","قُ صَفائِحِ اليَمَنِ الفَواصِل",50,"ل",1,0],["وَعَمَّ السَماءَ النَقعُ حَتّى كَأَنَّهُ","دُخانٌ وَأَطرافُ الرِماحِ شَرارُ",51,"ر",1,0],["وَعَمروُ بنُ عَبدٍ وَأَحزابُهُ","سَقاهُم حَسا المَوتِ في يَثرِبِ",52,"ب",1,0],["وَعَمُوا عنه فلا وَاللهِ ما","تَنْفَعُ الشِّمْسُ لَدَى القَوْمِ العَمِينا",53,"ن",2,0],["وَعَمروٍ صاحِبُ الرايَ","ةِ لا بَل دِرهَمَ الكيسِ",54,"س",1,0],["وَعِمرانُ اِبنُ عَمروٍ","فَفيهِ الأَمرُ وَالشانُ",55,"ن",1,0],["وَعَمَّنا الغَيُّ حَتّى خِلتَنا دَمِثاً","مُقابِلاً مِن سَفاهٍ عارِضاً هَتِنا",56,"ن",2,0],["وَعمَّمتني بَقايا الدَهرِ مِن قُطُنٍ","فَقَد أُنَضِّجُ ذا فِرقينِ مَيّالا",57,"ل",2,0],["وَعَمِّي الَّذي حامَى غَداةَ مَناجِلٍ","عَنِ القَومِ حتّى فادَ غَيرَ ذَمِيمِ",58,"م",1,1],["وَعُمِرتُ حَتّى جاءَ أَحمدُ بالهُدى","وَقَوارعٍ تُتلى مِن الفِرقانِ",59,"ن",1,0],["وعمروٌ في ميامنهم عمورٌ","وكعبٌ في مياسرهم كعاب",60,"ب",1,0],["وعَمْرُ هِنْدٍ كأنّ الَله صَوَّرَهُ","عَمرو بنَ هِنْدٍ يَسومُ الناسَ تَعْنيتا",61,"ت",2,0],["وعَمَّمَ صُلْعَ الهُضْبِ مِن قَطْرِ ثَلْجِهِ","يَدانِ مِن الصِّنَّبْرِ تَبتَدِرانِ",62,"ن",1,0],["وَعَمَّا قَلِيلٍ يَنْتَهِي الأَمْرُ كُلُّهُ","فَمَا أَوَّلٌ إِلَّا وَيَتْلُوهُ آخِرُ",63,"ر",1,0],["وَعَمَا قَلِيلٍ يَقْضِيَانِ مِنَ الجوَى","وَإِنْ صَحَّ ظَنِي فَهْي تَهِلِكُ أَوَّلُ",64,"ل",1,0],["وَعَمَّا أَعَدَّتْ لِلْيَتِيمِ فَثَقَّفَتْ","فَرُبَّ يَتِيمٍ عَادَ لِلْخَلْقِ سَيِّدَا",65,"د",2,0],["وَعَمِيداً بَثَّ الهِدَايَةَ فِي قَوْ","مٍ لَهُمْ تِيهُهُمْ بِذَاكَ العَمِيدِ",66,"د",1,0],["وعمرٌو وعثمانُ بنُ عفّانَ والفَتَى","أبو مَرْثَدٍ سُقْيَا لِذَلكَ في الأَجْرِ",67,"ر",1,0],["وعمرُ الورد ما يهمي شذاهُ","على دنياهُ لا شهرٌ وعام",68,"م",1,0],["وعم بالرفق هذا القطر فابتدرت","تنمي مآثره جوابة الرفق",69,"ق",1,0],["وعما أفادت من بلادٍ تكالَبَتْ","على الغُنم ، وارتدَّت سِباعاً ضواريا",70,"ي",2,0],["وَعَمْرُو بنُ مَعدي، إن ذَهبتَ تَهيجُه،","وَأوْسُ بنُ سُعدى، إن ذهَبتَ تُكايدُه",71,"د",2,0],["وعُمْرُ الفتى من أماني الفتى","ولكنْ لبيكِ النَّدى بالنَّدى",72,"ا",1,0],["وعمْراً وَحيَّاناً ترَكْنا بقَفْرَة ٍ","تعودهما فيها الضّباعُ الكوالح",73,"ح",1,0],["وَعُمرنها بِشَعائر","وَجَعَلتَها لَكَ مَعبَدا",74,"د",2,0],["وَعَمَن سِواه صَمت نذراً لِقُربِهِ","فَفَطَرني مِن مُقلَتيهِ عذار",75,"ر",1,0],["وَعَمياءَ لَم تَجنح إِلى الخَير مَرَةً","وَلَم تَرَ شَيئاً مِن حَميد خِصال",76,"ل",1,1],["وعمه فيض الرضا من فضلها","واغرقته من ندا بحارها",77,"ر",3,0],["وعمنا الله باحسانه","وانه المولى ونعم النصير",78,"ر",1,0],["وعمادي وملجائي واستنادي","ووليي بالله بعد مماتي",79,"ت",2,0],["وعمق الأحزان أني أرى","نفسي في مثل دجى القبر",80,"ر",1,0],["وعمر كأحلام اليتيم كآبة","وعيش كجدوى المسنتين هزيل",81,"ل",1,0],["وعمرتَ أفئدةَ الرجال وأهلها","بالهم والأوصاب والأحزانِ",82,"ن",1,0],["وعمَمتَ أهلَ الأرضِ","والبلدان بالجدوى عمومَا",83,"م",2,0],["وعملت فيك معانياً منظومةً","ولديكَ ليس يضيعُ أجرُ العاملِ",84,"ل",1,0],["وعمرٌو وامرؤ القيسِ بن حجرٍ","وداودُ الذى حازَ الزَّبُورَا",85,"ر",2,0],["وعَمَّرَهُ مُطَاعاً مُستَقِيماً","عَلَى غرَّاءَ وَاضِحةِ السَّبِيلِ",86,"ل",1,0],["وَعمَّرَهُ مُطَاعاً مُستَقِيماً","عَلَى الدِّينِ القَوِيمِ المُستَنَارِ",87,"ر",1,0],["وعمّر قدرَ أكؤُسهِ وحلّى","وألبسَها بها ثوبِ الحِدادِ",88,"د",1,0],["وعمهم بالدمار يومٌ","تقصر عن وصفهِ الرواةُ",89,"ه",1,0],["وعمِين حتى لا رأت أبصارُها","بَرقا كناصيةِ الحِصان الأشقرِ",90,"ر",1,0],["وَعَمَمتَ كُلَّ العالَمينَ بِنائِلٍ","ما اِمتازَ فيهِ عَنِ البَعيدِ الأَقرَبُ",91,"ب",1,0],["وَعَمَّ بَيتَكَ مِن مَجدٍ خُصِصتَ بِهِ","فَخرٌ تَشارَكَ فيهِ العُجمُ وَالعَرَبُ",92,"ب",1,0],["وَعَمَرتَ هَذا الشامَ بَعدَ دُثورِهِ","حَتّى غَدَت أَطرافُهُ أَمصارا",93,"ر",2,0],["وَعَمَرتَ غامِرَها بِجِدٍّ لَم يَزَل","يَأبى لِما تَبنيهِ أَن يَتَهَدَّما",94,"م",2,0],["وَعَمّا الأَرضَ إِحساناً وَعَدلاً","فَدُمتَ لِأَهلِها أَبَداً وَداما",95,"م",2,0],["وعما به قد خالفوا حكمَ ربنا","وحكم رسول الله والمرتقى صعبُ",96,"ب",1,0],["وَعِمادي مِن آلِ سيدٍ إِذا ما","شَمَّرَ الحَرب وَالمَنايا نُزولُ",97,"ل",1,0],["وعَمُّكَ أدناهُ وأعلى مَحلّهُ","وبوَأَهُ من مُلكه كَنَفاً رَحْبا",98,"ب",2,1],["وعمّةٌ عمّتِ الأبصارَ هيبتُها","برغمِ مَن لبسَ التيجانَ واغْتَصبا",99,"ب",2,0],["وَعَميدِ قَومٍ صَكَّ مَفرِقَ رَأسِهِ","بِالسَيفِ في لَيلِ العَجاجِ الأَليَلِ",100,"ل",1,0],["وَعَمرو بنَ هِندٍ عَمَّمُوا أُمَّ رَأسِهِ","حُساماً يَقُدُّ البيضَ وَالهامَ مِن عَلُ",101,"ل",1,0],["وَعَمرٌو في اللَقاءِ عَلَيهِ كَلٌّ","وَعَوفٌ في الوَفاءِ لَهُ غُلامُ",102,"م",1,0],["وَعَمّي التارِكُ البَطَلَ المُفَدّى","كَمُشتَمِلٍ قَطيفَةَ أُرجُوانِ",103,"ن",1,0],["وعَمَّرها بالأمن والناسُ قبله","وأموالُهم فيها قتيلٌ وضائع",104,"ع",1,0],["وعملت الكسوف والزيج والمب","ل وسابقت فيهما من سواكا",105,"ك",2,0],["وعمادهُ في دينه الت","تقوى وجُنّتُه سداده",106,"د",2,0],["وَعَمّمتِ نشرَ الخيرِ في سائرِ الورى","كَما أنّها قَد عمّمت في الورى الشرّا",107,"ر",2,0],["وَعَماهُ كانَ عن النبيّ عَميما","صلّوا عليهِ وَسلّموا تسليما",108,"م",2,0],["وَعَمَّرتَ أَرضَ المُسلمينَ فَأَقبَلَت","وَنُفيتَ عَنها مَن يُريدُ فَسادَها",109,"د",3,0],["وعم بعفو منك حمدان إنه","لكل ضعيف لم يزل متعهدا",110,"د",2,0],["وَعَمرُو بنُ عَوفٍ هَمّي وَمُنيَتي","إِذا كانَ لي يَوماً قَرينٌ أُنازِلُه",111,"ل",2,0],["وعما قليل منهم تبلغ المنى","وتظفر بالاعدا وينشرح الصدر",112,"ر",1,0],["وعَمَّرَ روض العِزِّ أخضر مورِقا","وأسسَ بنيانَ الثناءِ وَشَيَّدا",113,"د",2,0],["وعمدنا الى الجدا","ل لأمر سيظهر",114,"ر",1,0],["وَعمادٌ عِيَ العُقولُ مُقيمٌ","فَوقَ أَطوادِها جَلالُ الوُجودِ",115,"د",1,0],["وعم به أصحبك الزهر ما سرى","إلى ربعك السامي مشوق وأدلجا",116,"ج",2,0],["وعمّ قبور الأكرمين صحابه","بكل غمام بالمواهب غائث",117,"ث",1,0],["وَعِمامَة سَوداء يُشرِقُ وَجهُهُ","فيها لَهُ مِن خَلفِهِ طَرَفانِ",118,"ن",1,0],["وَعَمَّ بِالجودِ كُلَّ ذي أَمَلٍ","وَخَصَّ بِالعَفوِ كُلَّ مُجتَرِمِ",119,"م",1,0],["وَعَمَمتَ بِالخِصبِ البِلادَ فَأَورَقَ ال","ذاوي وَرَقَّ بِكَ الجَديبُ المُمحِلُ",120,"ل",1,0],["وَعَمَّت يَداكَ الأَرضَ عَدلاً وَنائِلاً","فَلا الظُلم في الدُنيا وَلا العُدمُ يوجَدُ",121,"د",1,0],["وَعَميمُ طولٍ لا يُطا","وِلُ لِلنُهوضِ بِها الرِقابُ",122,"ب",1,0],["وَعِمامَةٌ ما تاجُ كِسرى مِثلُها","في الفَخرِ وَهوَ بِرَأسِ كِسرى يُعصَبُ",123,"ب",1,0],["وَعُمَرٌ وَهْوَ وَحْدَهُ نَفَرٌ","يَقْصُرُ عَنْ خَطْوِهِ تَزَيُّدُهَا",124,"د",3,0],["وَعُمَرٌ وَهْوَ لِلنُّهًى زَهَرٌ","عَرْفُ شَمَائِلِهِ يُؤَيِّدُهَا",124,"د",3,0],["وَعُمَرٌ وَهْوَ لِلنَّدَى نَهَرٌ","نَرُدُّ فُرْضَتَهُ وَنُورِدُهَا",124,"د",3,0],["وَعُمَرٌ وَهْوَ أَنْجُمٌ زُهُرٌ","نَسْرِي بِهَا لِلْهُدَى وَنَقْصِدُهَا",124,"د",3,0],["وعَمِّي قد غَدَا غَمِّي وأمسَى","يحطُّ ببخلِهِ قدري وقَدرِي",125,"ي",1,0],["وعمامتي رأسي وجمجم","تي الثرى والكبرُ خُلقي",126,"ي",1,0],["وعمّرت عمري أقاسي النوى","بعَمرو الهوى مع زيد المنال",127,"ل",1,0],["وعمّره بتقوى الله تقوى","على حملِ الأمانة والأوامر",128,"ر",1,0],["وعمم الحمد هام الفضل منك علا","فراق وصفاً ومن يرقى العلا برق",129,"ق",1,0],["وعمروٌ أتى مصراً فحيّاهُ أهلُها","وقالوا لأهلِ المكرماتِ رفاء",130,"ا",2,0],["وَعم بالخير أَهلينا وَجيرتنا","ومن يَلينا من الاصحاب وَالرحم",131,"م",1,0],["وَعمى رَسول اللَه وَالحسنين من","بهم شَرفات المجد تَزهو وَتعجب",132,"ب",1,0],["وَعم رضاه الآل وَالصحب انهم","لدينك يا شمس الزَمان بدور",133,"ر",1,0],["وعم الخلق مكرمة وَجودا","فَلما جا فارق ما أَذاقا",134,"ق",2,0],["وَعموا وَصموا واعتَدوا فوعظتهم","بالسَيف يرعف وَالعتاق الشرب",135,"ب",1,0],["وَعمّ صحبك والآل الكِرام سنا","تَحيَّة منه تهدي كل رضوان",136,"ن",1,0],["وَعُمرٌ طالَ في كَسبِ المَعالي ال","جِسامِ وَعافَ في الدُنيا الدَنايا",137,"ا",3,0],["وعمر ضاع في إيثار دار","حقيقتها تشبه بالخيال",138,"ل",1,0],["وعم أصولاً والفروع برحمة","وأهلاً وأصحاباً وكل قرابة",139,"ه",1,0],["وعمر فلا تنسى مقالته فقد","شد مع القوم الكرام وسارا",140,"ر",2,0],["وعم الفريط لنور مع أهل بكدر","هو أطل غفران مع الأمن من ردى",141,"د",2,0],["وَعمّم نَفعَ هَذا النظمِ وَاِشرح","صُدوراً منهُ جاشَت للنشيدِ",142,"د",1,0],["وَعَمرو وَالأَغَنُّ عَميدُ حَي","وَكُلٌّ في أَرومَتِهِ عَميدُ",143,"د",1,0],["وعمري ومن إظلامه يخلق الدجى","وينسى لديه الفجر من يعبد الفجرا",144,"ر",2,0],["وعمادي خواطرٌ عبقريّا","تٌ ووحيٌ من السماوات آت",145,"ت",1,0],["وعما فيه من سفه","وعما فيه من سخر",146,"ر",1,0],["وَعُمْرُ نُوحٍ وَعُمْرُ الطِّفْلِ غَايتُهُ","إلى نتِهاءٍ فَدَعْ عَن نَفسِكَ التَّعَبَا",147,"ب",2,0],["وَعُمِّرْتُ في الإسلامِ فَازْدَدْتَ بَهْجَةً","وَنُوراً كَذا يَبدُو السِّراجُ المُعَمَّرُ",148,"ر",1,1],["وَعَمَّمَ رَأْسِي الشِّيبُ نُوراً فَسَرَّني","وَما سَاءَني أَنَّ السِّراجَ مُنَوَّرُ",148,"ر",1,0],["وَعَمّا حالَ في الشَكلِ","وَما يُلحَظُ بِالطَرفِ",149,"ف",1,0],["وَعَمَّت هِباتك هَذي الدِيار","فَيا أَنفَع الغَيث ما أَهطلك",150,"ك",1,0],["وَعَمود الفَجر جيد