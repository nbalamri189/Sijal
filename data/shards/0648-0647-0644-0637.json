{"poems":[[90,"أجدك يا كواكب لا ترينا","https://www.aldiwan.net/poem45071.html","الوافر"],[47,"لدارك يا ليلى سماء تجودها","https://www.aldiwan.net/poem63478.html","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16629","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54218","البسيط"],[92,"ضحايا الأنتداب","https://www.poetsgate.com/ViewPoem.aspx?id=179024",""],[147,"أبى الدهر إلا أن تقول وتفعلا","https://www.aldiwan.net/poem11799.html","الطويل"],[154,"أنفت لقول حاد عن سمت قصده","https://www.aldiwan.net/poem68593.html","الطويل"],[173,"إلى م أرجي ضر عيش منكدا","https://www.aldiwan.net/poem1615.html",""],[173,"إلى كم مداراة العدى واحترامها","https://www.aldiwan.net/poem1663.html",""],[202,"سرى البرق من مثواك والليل مسود","https://www.aldiwan.net/poem51862.html","الطويل"],[234,"عديني بوعد تستريح صبابتي","https://www.aldiwan.net/poem50926.html","الخفيف"],[287,"انشر حديثا قديما كنت تطويه","https://www.aldiwan.net/poem32303.html","البسيط"],[302,"لقد آن أن تثني أبي زمامها","https://www.aldiwan.net/poem33176.html","الطويل"],[463,"إذا فاتها روض الحمى وجنوبه","https://www.aldiwan.net/poem56273.html","الطويل"],[519,"أفي طي الصبا نشر التصابي","https://www.aldiwan.net/poem20824.html","الوافر"],[534,"وفود حبيب أم ورود عهاد","https://www.aldiwan.net/poem37457.html","الطويل"],[556,"إلام أرامي في المنى وأُرادي","https://www.aldiwan.net/poem47847.html","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64816","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49915","الطويل"],[2900,"","https://poetry.dctabudhabi.ae/diwan/poem/102191","الطويل"],[3351,"","https://poetry.dctabudhabi.ae/diwan/poem/121118","البسيط"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139975","المتقارب"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48277","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91079","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92012","الطويل"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103577","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123524","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120367","الوافر"],[6035,"كذبة يوم القدس .. !","https://www.poetsgate.com/ViewPoem.aspx?id=175126",""],[2853,"أيا ايها العشاق للمحضر الأعلى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=584341",""]],"verses":[["وهل طابت حياة بنيك عيشًا","ففوق الأرض نحن معذبونا؟",0,"ن",2,0],["وَهَل طَيِّئٌ إِلّا نُجومُ تَوَقَّدَت","عَلى صَفحَتَي لَيلٍ وَأَنتُم سُعودُها",1,"د",3,0],["وهل طلعت شعث النواصي عوابساً","رعال ترامى خلفهن رعال",2,"ل",1,0],["وهل طيوفُ الأماني وهي حائرةٌ","تدنو بطيفٍ من الآمالِ منشود",3,"د",1,0],["وهل طرَقتْ يمينُ الحق بابا","ولم تسدد شِمال الظلمِ بابا",4,"ب",2,0],["وَهَل طَلَبا الإِنصافَ مِن غَيرِ أَهلِهِ","وَهَل أَوعَرا في السَومِ إِلّا لِيُسهِلا",5,"ل",2,0],["وَهَل طارَ مَقصوصُ الجَناحَينِ مِن عُشِّ","فَيا لِمُحِبٍّ يَستَطيبُشُجونَهُ",6,"ه",1,0],["وَهَل طابَ عَيشٌ بِالمُداراةِ أَو صَفا","لَوَ اِنّ المُداري راحَ بِالخُلدِ وَاِغتَدى",7,"د",2,0],["وَهَل طَلَبَت ثارَ اِبنِ شُكرٍ وَهَل حَمى","أَبا ماجِدٍ خَطِّيُها وَحُسامُها",8,"م",3,0],["وهل طمس الواشون بيني وبينكم","سبيلَ الرضى أم كان ما بيننا سدّ",9,"د",1,0],["وهَلْ طُرْفة أحلَى وأَلْطَفُ مَوقِعاً","مِن الوَعْدِ يُحْيي العاشِقون به العِشقا",10,"ق",2,0],["وَهَل طَنينُ ذُبابِ السَيفِ في رَهَجٍ","يُرى طَنينُ ذُبابِ الصَّيفِ يَحكيهِ",11,"ي",2,0],["وَهَل طائِلٌ في أَن يَلوم على الهَوى","طَليقٌ وقَلبي مُوثقٌ بغرامِها",12,"م",3,0],["وهل طائلٌ في أن يُكثِّر عذلَهُ","إذا قلَّ من إصغاءِ سمعِي نصيبُهُ",13,"ب",2,0],["وهل طرقَتْ مجَرَّ ذُيولِ لَيلى","فقد جاءَتْ معطّرةَ الثّيابِ",14,"ب",1,0],["وهَلْ طَلَعَتْ شَمْسُ التَّواصُلِ بَعْدَما","تَطاوَلَ لَيْلٌ مُظْلِمٌ بِبعادِ",15,"د",1,0],["وَهَل طَمَعِي في العيشِ إلّا جَهالةٌ","وفي كفّ روّادِ الحِمامِ قيادِي",16,"د",2,0],["وهل طيبُ وَصْلٍ كُنْتُ أَجْنيهِ وادِعاً","يُراجِعُني يَوماً فأَخلِسُهُ خَلْسا",17,"س",2,0],["وهل طافت الأحلام نحوك ليلةً","بما أحدثَ المقدورُ عنكَ المغيَّبُ",18,"ب",1,0],["وهل طاب عيشي في الزمان وهجره","طويل وقلب الصب لا يتحمل",19,"ل",1,0],["وهل طغى فيكم الأعادي","وطاردوكم إلى البوادي",20,"ي",1,0],["وهلْ طُررُ الصبحِ إلا ظبىً","وهلْ غُررُ الشهبِ إلا الأسلْ",21,"ل",1,0],["وهل طائر الفكْرِ الذي أمّل النّدى","إلى الورْدِ صادٍ وهْوَ بالمدحِ صادِحُ",22,"ح",1,0],["وَهَل طالح إِلا دَهاه مِن الرَدى","عَلى طُول ما يَرجو مِن الدَهر طالخ",23,"خ",1,0],["وَهَل طالَت الآجال فيما تَرومه","فَلم تنصرم دُون الأَماني الطَويلة",24,"ه",1,0],["وهل طرفت عين لمجد ولم تكن","لها مقلةٌ من آل هود وإنسانُ",25,"ن",1,0],["وهل طلبت من منجد غير نجدة","بنجد فمن تهواه حل ذراها",26,"ا",3,0],["وهل طوت البيداء الا لذى طوى","فأنحلها حث السرى وطواها",26,"ا",3,0],["وهل طعم الوداد لديك عذب","كما اضحى وداجي فيك عذبا",27,"ب",2,0],["وهل طريقك ياأقصى مُبَدَّدة","حتى تتوه عن اللقيا به البُهَم !",28,"م",1,0],["وهل طُفتَ بالأكوانِ من كلِّ جانبٍ","وهل طافَ بك الكونُ وانت لهُ قبلا",29,"ل",2,0]]}