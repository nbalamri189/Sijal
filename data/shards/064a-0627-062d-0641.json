{"poems":[[55,"غالى بها الزائد حتى ابتاعها","https://www.aldiwan.net/poem30152.html","الرجز"],[79,"يا حفيد الولي ياوارث الفخر","https://www.aldiwan.net/poem36354.html","الخفيف"],[53,"يا راغبا نزعت به الآمال","https://www.aldiwan.net/poem65921.html","الكامل"],[99,"يا جزيل الهبات والإنعامِ","https://www.aldiwan.net/poem24344.html","الخفيف"],[46,"ما للدموع تروم كل مرام","https://www.aldiwan.net/poem30362.html","الكامل"],[92,"قف بأجداث الضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=179225",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122670","المنسرح"],[1009,"","https://poetry.dctabudhabi.ae/diwan/poem/17632","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64545","الخفيف"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64548","الخفيف"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35742","الكامل"],[1778,"","https://poetry.dctabudhabi.ae/diwan/poem/96486","البسيط"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110324","الخفيف"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88651","المنسرح"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89115","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89221","الخفيف"],[3811,"","https://poetry.dctabudhabi.ae/diwan/poem/146445","السريع"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135532","الخفيف"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21583","البسيط"],[4394,"","https://poetry.dctabudhabi.ae/diwan/poem/117194","الكامل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52193","الكامل"],[4750,"قبة الفرو","https://www.poetsgate.com/ViewPoem.aspx?id=180419",""],[5186,"\"أيهذا \"\"الدبور\"\" أين الحمار","https://www.poetsgate.com/ViewPoem.aspx?id=156553",""],[5193,"صقور سلاح الجو","https://www.poetsgate.com/ViewPoem.aspx?id=213567",""],[5320,"تحية إلى الشعب الليبى","https://www.poetsgate.com/ViewPoem.aspx?id=41637",""],[5724,"أم الربيعين ابسمي وتهللي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55135&r=&rc=2",""],[6273,"قواف ٍ في ركب السراة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78507&r=&rc=5",""]],"verses":[["يا حِفظَها إِن بَلَغَت مَرامَها","وَإِن أَبى الدَهرُ فَيا ضَياعَها",0,"ع",3,0],["يَا حَفِيدَ الْوَلِيِّ يَاوَارِثَ الفَخْ","رِالَّذِي نَالَ فِي مَقَامٍ وَحَالِ",1,"ل",1,1],["يا حفرةً غلبتْ عليه جَنّةً","كانت به وبنفسِها تختالُ",2,"ل",1,0],["يا حفيفَ النسيمِ يا رقَّةَ الوردِ","تجلَّى في ناضر الأَكمامِ",3,"م",1,0],["يا حُفرَةَ المَعصومِ تُربُكِ مودَعٌ","ماءَ الحَياةِ وَقاتِلُ الإِعدامِ",4,"م",1,0],["يا حفيظَ العهدِ للوادي ويا","أمَلَ الوادي فُتُوّاً واقتبالا",5,"ل",2,0],["يا حَفِظَ اللهُ آلَ غانِمَ ما","أحسَنَ في كُلِّ مَشهَدٍ سَمِعا",6,"ع",2,0],["يا حُفرَةً ضَمَّت مَحاسِنَ مالِكٍ","ما فيك مِن كَرَمٍ وَمِن إِحسانِ",7,"ن",1,0],["يا حفيظ احفظني وهب لي حفظاً","خازناً محصياً لما الوهب يملي",8,"ل",2,0],["يا حفياً بخلقه يا خفي اللط","ف أدرك حالي بلطف وفضل",9,"ل",1,0],["يا حُفرَةَ المَلكِ المُؤَمّلِ رِفدُهُ","ما في ثَراكِ مِنَ النَدى وَالخَيرِ",10,"ر",1,1],["يا حفص إني عداني عنكم السفر","وقد أرقت فآذى عيني السهر",11,"ر",1,1],["يا حفيد الأولى حموا مجد لبنا","ن وان صنته فقد صنت مجدك",12,"ك",1,0],["يا حفرة ضاق عنه واسعها","حتىّ تجافى علاه جندلها",13,"ل",3,0],["يا حفيظاً على الختام عليماً","وأميناً بكل مدح جدير",14,"ر",1,0],["يا حفيظاً على الختام أميناً","وأميراً مضارع الأمر ماضي",15,"ض",2,0],["يا حُفْرَةَ النّارِ الني أُضْرِمَتْ","وَظَلّ فِيهَا الرّجْسُ مَدْفُونَا",16,"ن",2,0],["يا حفيظاً من البلاء سواء","منك خوفي والأمن منك رجاء",17,"ا",2,1],["يا حُفرةً طُولُها خَمسٌ إِذا ذُرِعَت","في خَمسَةٍ قَد دَفنّا عِزّنا فيها",18,"ه",2,1],["يا حفصُ عاطِ أخاك عاطِه","كأساً تهَيِّجُ من نشاطِه",19,"ط",2,1],["يا حفلةً لما رأيتُ سناءَها","أَيقَنتُ أَن اللّيلَ صارَ نهارا",20,"ر",2,1],["يا حفيد أهل القصب والجوخ ونحور السبايا","واهل العوجا واهل الأجرب مفرقة الضعاين",21,"ن",1,0],["يا حفيد الملوك! قل لي بمثوى","أبشومابي إن صحت الأخبار",22,"ر",1,0],["يا حفلُ يا عيدُ يا آفاقُ يا علمٌ","وَيَا تُرابًا .. نشَقْنا حُبَّهُ دِينا",23,"ن",2,0],["ياحفيد الصيد أيقذت الورى","بعد طول الصمت أعطيت المثل",24,"ل",1,0],["يا حفصة الفاروق في أيامنا","يا مضرب الامثال في المستقبل",25,"ل",1,0],["ياحفلنا المشهود دربك ممرعٌ","من سيد تُرعى إلى يد سيد",26,"د",1,0]]}