{"poems":[[55,"أين بانوك أيها الحيرة البيضاء","https://www.aldiwan.net/poem30439.html","الخفيف"],[55,"إذا احتبى بالعشب الوادي","https://www.aldiwan.net/poem30630.html","السريع"],[88,"نبئاني إن كنتما تعلمان","https://www.aldiwan.net/poem10953.html","الخفيف"],[90,"رقت بوصف جمالك الأقوال","https://www.aldiwan.net/poem44405.html","الكامل"],[90,"من أين من أين يا ابتدائي","https://www.aldiwan.net/poem45073.html","مخلع البسيط"],[93,"أعلى عيني من الدمع غشاء","https://www.aldiwan.net/poem62753.html","عموديه"],[91,"أي قدس يضم هذا البناء","https://www.aldiwan.net/poem44981.html","الخفيف"],[87,"ناشئ في الورد من أيامه","https://www.aldiwan.net/poem63769.html","الرمل"],[47,"منى النفس في أسماء لو تستطيعها","https://www.aldiwan.net/poem64701.html","الطويل"],[82,"أي خطب عن قوسه الموت يرمي","https://www.aldiwan.net/poem31283.html","الخفيف"],[71,"إن يطش بعض كلامي","https://www.aldiwan.net/poem28849.html","مجزوء الرمل"],[71,"رب طباخ مليح أهيف","https://www.aldiwan.net/poem29087.html","مجزوء الرمل"],[107,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[104,"كبدي من فراقها بين بينا","https://www.aldiwan.net/poem32917.html","مجزوء الرمل"],[54,"زودينا نائلا أو عدينا","https://www.aldiwan.net/poem26641.html","المديد"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85593","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54308","الخفيف"],[108,"النيل والسودان","https://www.poetsgate.com/ViewPoem.aspx?id=179757",""],[108,"راهب الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=179334",""],[47,"مُنَى النّفسِ في أسماءَ، لَوْ يَستَطيعُها","https://www.poetsgate.com/ViewPoem.aspx?id=31222",""],[119,"ربطت بحبل عنقا الشرق حبلى","https://www.aldiwan.net/poem41749.html","الوافر"],[124,"خده أحسن أم ثغره","https://www.aldiwan.net/poem49374.html","المديد"],[275,"الشام يقهر والعراق يضام","https://www.aldiwan.net/poem35641.html","الكامل"],[303,"لاح في جنح الظلام","https://www.aldiwan.net/poem36799.html","عموديه"],[376,"أرأيت ما صنع القريب النائي","https://www.aldiwan.net/poem57539.html","الكامل"],[422,"كم دم فيك أيها الريم طلا","https://www.aldiwan.net/poem54000.html","الخفيف"],[422,"ما قضى إلا على الصب العميد","https://www.aldiwan.net/poem54016.html","الرمل"],[438,"راح يوافي طراده طرده","https://www.aldiwan.net/poem12432.html","المنسرح"],[466,"ضعي لامتداحي ما استطعت من العذر","https://www.aldiwan.net/poem15104.html","الطويل"],[484,"عجبا لقلبك كيف يحمل وده","https://www.aldiwan.net/poem37018.html","الكامل"],[484,"طال المدى في خطة الأعراض","https://www.aldiwan.net/poem37181.html","الكامل"],[563,"مهجة ناظراك قد فتناها","https://www.aldiwan.net/poem33674.html","الخفيف"],[591,"رب طباخ مليح","https://www.aldiwan.net/poem17540.html","مجزوء الرمل"],[705,"","https://poetry.dctabudhabi.ae/diwan/poem/112428","الرمل"],[1052,"","https://poetry.dctabudhabi.ae/diwan/poem/130878","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136277","الطويل"],[1473,"","https://poetry.dctabudhabi.ae/diwan/poem/124027","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80036","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80012","الطويل"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[1759,"","https://poetry.dctabudhabi.ae/diwan/poem/107345","السريع"],[2539,"","https://poetry.dctabudhabi.ae/diwan/poem/113624","الخفيف"],[2638,"","https://poetry.dctabudhabi.ae/diwan/poem/142139","الخفيف"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100884","الخفيف"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140055",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201771","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201751","الرمل"],[3080,"","https://poetry.dctabudhabi.ae/diwan/poem/96117","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89404","الخفيف"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/132016","الرمل"],[3709,"","https://poetry.dctabudhabi.ae/diwan/poem/36013","الخفيف"],[3737,"","https://poetry.dctabudhabi.ae/diwan/poem/138909",""],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86530","الطويل"],[3984,"","https://poetry.dctabudhabi.ae/diwan/poem/147201","الخفيف"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125802","المتقارب"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72392","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72362","الطويل"],[5081,"لَسْتَ وَهْمَاً","https://www.poetsgate.com/ViewPoem.aspx?id=187885",""],[5136,"ربطتين قات في كل وا","https://www.poetsgate.com/ViewPoem.aspx?id=121739",""],[5281,"ليلة المعراج","https://www.poetsgate.com/ViewPoem.aspx?id=199707",""],[5431,"سطوة المال ...(شجرُ الحب مورقٌ لا انتهاءُ )","https://www.poetsgate.com/ViewPoem.aspx?id=198472",""],[5500,"شرنقة","https://www.poetsgate.com/ViewPoem.aspx?id=190065",""],[5652,"عمرو بن العاص رضي الله عنه","https://www.poetsgate.com/ViewPoem.aspx?id=208678",""],[5691,"مُصفِّقون...!","https://www.poetsgate.com/ViewPoem.aspx?id=208536",""],[5956,"ذكرى موت زميل الطفولة","https://www.poetsgate.com/ViewPoem.aspx?id=194480",""],[6102,"بَراءَةُ الذِّئب !!","https://www.poetsgate.com/ViewPoem.aspx?id=183166",""],[406,"خيمة الظلماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63653&r=&rc=83",""],[6315,"رُؤى على شفير الحداد !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87579&r=&rc=4",""]],"verses":[["رَبَطوا حَولَكِ الجِيادَ وَخَطّوا","لَكِ مِن مَركَزِ العَوالي عِذارا",0,"ر",2,0],["رُبَّ طِلابٍ أَتلَعٍ رُمتُهُ","وَحاجَةٍ عالِيَةِ الهادي",1,"د",2,0],["رُبَّ طِفلٍ قَد ساخَ في باطِنِ الأَر","ضِ يُنادي أُمّي أَبي أَدرِكاني",2,"ن",2,0],["ربطوا الأكفّ على ضلوع تحتها","بين النواظر والقلوب جدال",3,"ل",1,0],["ربطتِ كل النجوم فيها","بعضاً ببعض ربط اعتناء",4,"ا",2,0],["رُبَّ طِفلٍ طاهِرٍ ما أَثِما","ماتَ مَوتَ الآثِمِ المُجتَرِمِ",5,"م",1,0],["ربّ طفل أودت به قِلّة الدَرّ","على أن أمّه ثَدياء",6,"ا",2,0],["رُبَّ طِفلٍ بَرَّحَ البُؤسُ بِهِ","مُطِرَ الخَيرَ فَتِيّاً وَمَطَر",7,"ر",1,0],["رَبَطتَ بِصُلحِ القَومِ نافِرَ جَأشِها","فَقَرَّت حَشاها وَاِطمَأَنَّت ضُلوعُها",8,"ع",3,0],["رُبّ طَوْدٍ يريك غيرَ بعيدٍ","منه شَمّ السماءِ أنْفُ أشَمِّ",9,"م",1,0],["ربَّ طيشٍ كانَ قصداً","وبهِ الشخصُ يعيشُ",10,"ش",1,0],["ربَّ طباخٍ مليح","أهيفِ القدِّ غريري",11,"ي",1,1],["ربِّ طَالَ الخَفاءُ والدّينُ جَهرٌ","رَبِّ فاجعلْ مدَى الخفاءِ قصيرا",12,"ر",2,0],["ربّ طَير مهاجر غابَ عَنا","شاقَهُ وَكرُهُ فَعادَ إِلَينا",13,"ن",2,0],["رُبِطَ النَصرُ بِهِم أَينَ كانوا","إِن شِمالاً ذَهَبوا أَو يَمينا",14,"ن",2,0],["ربطتني أواصر محكمات","ببلادي ولن أحل وثاقي",15,"ق",2,0],["رُبَّ طفلٍ تركتَ مِنْ غَيْرِ ثَدْيٍ","يَضْرِبُ الأَرْضَ ضَجَّةً وعَوِيلاَ",16,"ل",2,0],["ربط الله بيننا برباطَيْ","نِ وثيقين: الضّادِ، والقُرآن",17,"ن",1,0],["رُبَّ طبع من الغدير اسْتقاهُ","فَهْوَ ينسابُ في الحياة انسيابه",18,"ب",2,0],["ربطتْهُ بكل ذَاتِ ثُغَاء","أو خُوَار مودَّةٌ، بل قرَابة",18,"ب",2,0],["رَبَطْتَ بِصُلْحِ القَوْمِ نافِرَ جَأشِها،","فَقَرّ حَشاها واطمَأنّتْ ضُلُوعُها",19,"ع",3,0],["ربطت بحبل عنقا الشرق حبلى","ومنه لجأت بالحصن الجليل",20,"ل",1,1],["رب طلٍّ بات يكلؤه","فكأن الطل غيران",21,"ن",1,0],["ربطوا الخُيولَ على الضّفافِ ورابطوا","فلهُم عليها عسكرٌ وخيام",22,"م",1,0],["ربَّ طيفٍ ماثلٍ","في يقظتي أو في منامي",23,"م",2,0],["ربطَ المكارمَ في جوانبِ بيته","لحوادثٍ يحدثنَ في العلياءِ",24,"ا",2,0],["ربَّ طيفٍ من آل ميٍّ طروقٍ","زارَ وَهناً فقلت أهلاً وسهلا",25,"ل",2,0],["ربَّ طيفٍ من زَرودٍ زارني","فسقى صوبُ الحيا عهدَ زرود",26,"د",1,0],["رُبَّ طعامٍ مساغُ طَيِّبِهِ","مُمْتَنِعٌ عِند فاسِدِ المَعِدَه",27,"د",2,0],["ربطتم بأطناب البيوت جيادكم","وخيلُ العِدى في كل ملحمة تجري",28,"ر",2,0],["ربطته أسلاك الهوى بسميّه","فاذا بذاتك قد تجلت عنده",29,"د",2,0],["ربط الفؤادين اعتقاد راسخ","ينأى ارتفاعهما على استخفاض",30,"ض",1,0],["ربطتهم بقيدها شهوات","فهم الهالكون مالاً وجاها",31,"ا",3,0],["رُبَّ طَبَّاخٍ مَليحٍ","فَاترِ الطَّرْفِ غَريرِ",32,"ر",1,1],["ربطتني بكم من قدم","عروة الحب التي لم تفصم",33,"م",1,0],["ربطنا باخفاف المطى ثغورنا","فصارت نسوعا للمطى وتحجيلا",34,"ل",2,0],["ربطت بحكم العلم قلبي فما صبا","إلى غاية الا وكانت من العقل",35,"ل",1,0],["رب طه وسيلتي ووليي","وعليه معوّلي واعتمادي",36,"د",2,0],["ربطتُ الحشا بالراحتين ولم أخلْ","تطيح شظايا مهجتي ببنانيا",37,"ي",2,0],["ربطت بكفيَّ الضلوع على حشاً","تكاد خفوقاً أن يطيرَ بها الذعرُ",38,"ر",1,0],["ربطناها لنحملهم عليها","إذا وفدوا ونحمي ما يلينا",39,"ن",2,0],["رُبَّ طَمُوحِ الطَرفِ صَبٍّ يُرى","ممّا جنَت عيناهُ في الساهِرين",40,"ن",1,0],["ربَّ طرفٍ من العتاق كريمٍ","يسبق البرق حالة الإيماض",41,"ض",1,1],["رب طفلٍ يعيش في عمر شيخ","أكل الدهر عمره فتقضى",42,"ض",2,0],["رُبَّ طفلٍ منيمُهُ والداه","موقظاه من نومهِ المَلَكَان",43,"ن",1,0],["ربطوا الجياد على الجهاد ورابطوا","يبغوا الشهادة في رضا الوهاب",44,"ب",1,0],["ربطوا بتربتها جذورَك مثلما","ربط السقامُ بأرضها أقدامي",45,"م",2,0],["رَبّ طفل يُخجل الريم فلو","نظر الريم اليهِ شغفا",46,"ف",2,1],["ربطنا ديات للملوك سعى بها","سنان وسيار بن عمرو فأسرعا",47,"ع",2,1],["رب طيفٍ يزورني في السفين","مستنيب الوداع عند ظعوني",48,"ن",2,1],["رب طفل طوح الفقر به","في فيافي الجهل ما بين الطغام",49,"م",1,0],["رُبَّ طَرفٍ يَكونُ أَفصَحَ مِن لَف","ظٍ وَأَبدى لِمُضمِراتِ القُلوبِ",50,"ب",1,0],["ربطت فؤادي بكف المنى","زماناً وما لي سواها يد",51,"د",1,0],["ربطت على قلبي بكل أناملي","ولكنه رغم الأنامل طارا",52,"ر",2,0],["ربطة العنقِ وحْدها ما استزادوا","عن عصور الإبداع والإتقانِ",53,"ن",1,0],["ربطتَ الحساء بارض الحجاز","وأقصى عسير بجوف العمر",54,"ر",1,0],["ربطنا بأخفاف المطيِّ ثغورنا","فسفت ترابا بالمدامع مبلولا",55,"ل",2,0],["ربطنا بأخفاف المطيَّ ثغورنا","فأشبعت البيداء لثما وتقبيلا",56,"ل",2,0],["رَبُطُوا الْحِجَارَةَ فِي إِبَاءٍ أَعْلَنُوا","لَنْ تَقْهَرُونَا أَيُّهَا الْأَعْدَاءُ",57,"ا",2,0],["ربطتين قات في كل وا","حدة منهما فتلتان من الفل الأصفر",58,"ر",1,1],["رَبَطَ النبيُّ بُرَاقَهُ في حائطٍ","مَلَؤُهُ بالأقذارِ، يا للعارِ!",59,"ر",1,0],["ربّ طيرٍ بلوعةٍ راح يشدو","ربّ نايٍ لحزنه أصداءُ",60,"ا",2,0],["ربط اليقين على مجامع قلبها","حتى لتُؤْتَى بعد وَهْيٍ موثقا",61,"ق",2,1],["ربطني بالحبال الي تربط بالقسا برباط","ربطني حظي العاثر قسى واستاح برباطه",62,"ط",2,0],["ربَطوهُ معْصوباً","ذليلاً بالحِمارِ وأطْلَقوهْ",63,"ق",3,0],["رُبَّ طفل كان يلهو في خرابٍ","وأبوه في الثرى من تحت نعلِهْ",64,"ل",2,0],["رَبَطُوهُ, فَأَوثَقُوهُ, فَأَلقُو","هُ إِلَى صَفصَفِ الهَوانِ السَّحِيقِ",65,"ق",1,0],["رب طفل يموت فيها يجوع","وعلى بابه صنوف الغذاءِ",66,"ا",2,0],["رَبَطتُكِ في ضلعي ولكنَّ رِبقَةً","يُسَاوِرُها الوسواسُ لا تَأسِرُ الرَّندَه",67,"د",2,0]]}