www.aldiwan.net/poem34879.html","البسيط"],[500,"أنعت جهما لم أجد فيما مضى","https://www.aldiwan.net/poem10223.html","الرجز"],[520,"نطقت عنك ألسن الأغماد","https://www.aldiwan.net/poem12094.html","الخفيف"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66749","السريع"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66734","السريع"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77624","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77629","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77585","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77493","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77614","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77610","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77590","الرجز"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120010","الكامل"],[1116,"","https://poetry.dctabudhabi.ae/diwan/poem/117070","الرجز"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126117","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46522","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46517","الرجز"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48963","الخفيف"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26567","الرجز"],[2308,"","https://poetry.dctabudhabi.ae/diwan/poem/138926",""],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102658","الرجز"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65960","البسيط"],[2878,"","https://poetry.dctabudhabi.ae/diwan/poem/92457","الرجز"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99524","البسيط"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112613","الرجز"],[3301,"","https://poetry.dctabudhabi.ae/diwan/poem/144910","السريع"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199029","الرجز"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199027","الرجز"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85281","الرجز"],[3793,"","https://poetry.dctabudhabi.ae/diwan/poem/124786","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111516","الرجز"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94666","البسيط"],[4257,"","https://poetry.dctabudhabi.ae/diwan/poem/117143","الرجز"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58001","السريع"],[2052,"فقن الظباء سوالفاً ونحورا","https://www.poetsgate.com/ViewPoem.aspx?id=201386",""],[4984,"\" ليس الأدل \" 3","https://www.poetsgate.com/ViewPoem.aspx?id=175836",""],[5061,"عزي لحالي","https://www.poetsgate.com/ViewPoem.aspx?id=147173",""],[5285,"هَنا","https://www.poetsgate.com/ViewPoem.aspx?id=203529",""],[5431,"كفكف دموعك لن تُراق وتهدرا","https://www.poetsgate.com/ViewPoem.aspx?id=192199",""],[5690,"هل نور وجهك ضاءَ في لبنانِ","https://www.poetsgate.com/ViewPoem.aspx?id=172190",""],[5764,"عصفورتي","https://www.poetsgate.com/ViewPoem.aspx?id=137053",""],[6093,"تَبْعِيْضٌ","https://www.poetsgate.com/ViewPoem.aspx?id=204801",""],[199,"ما هاجَ شوقكَ من مغاني دمنة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=20777",""]],"verses":[["ثُمَّ آتيكِ كَالمُداوي عَسى اللَ","هُ يُرينيكِ مَرَّةً مِن قَريبِ",0,"ب",1,0],["ثُمَّ آتِ جَزْعاً وَجُزْ عَنْ حَيِّ كَاظِمِةٍ","وَأقْر السَّلاَمَ عَلَى خَيْرِ النَّبِييِنِ",1,"ن",1,0],["ثُمَّ أَتاني عَجِلاً قالَ السَبَق","فَقُلتُ إِن كانَ العِيانُ قَد صَدَق",2,"ق",1,0],["ثم أتاني وقد طما غضبي","عليه والضيفُ قد طما غضبُهْ",3,"ب",2,0],["ثم أتى مُبدعاً بمائدةٍ","عظّمها جاهداً وكبرها",4,"ر",3,0],["ثم أتت سُرَّعاً مجامرُهُ","تمنحها نَدَّها وعنبرها",4,"ر",3,0],["ثُمَّ أَتى الذيبَ فَقالَ طِلبَتي","أَنتَ فَسِر مَعي وَخُذ بِلِحيَتي",5,"ي",1,0],["ثُمَّ أَتى ثانِيَةً يَصيحُ","قَد ثُقِبَت مَركَبُنا يا نوحُ",6,"ح",1,0],["ثُمَّ أَتى مُعتَذِراً بِجَهلِهِ","ذا عُنُقٍ في المَجدِ لَم يُحَلِّهِ",7,"ل",2,0],["ثُمَّ أَتَيتَ تَخَطّى الرَكبَ مُستَتِراً","حَتّى لَقيتَ لَدى البَطحاءِ إِنسانا",8,"ن",2,0],["ثُمَّ أَتى الرَقَّةَ يَنوي أَمرا","فَلَم يَزَل فيها مُقيماً شَهرا",9,"ر",2,0],["ثُمَّ أَتَت سَعادَةُ الخَليفَةِ","وَحيلَةٌ خَفِيَّةٌ لَطيفَه",9,"ه",1,0],["ثُمَّ أَتانا ناكِساً رَأسَهُ","مُنحَدِراً مِن مَرقَبٍ عالِ",10,"ل",1,0],["ثمَّ أتى بِهِ إلى الإمامِ","إلى وفيِّ العَهدِ والذِّمامِ",11,"م",1,0],["ثمّ أتى رِدْفاً له دُرِّيُّ","في عسكرٍ قضاؤهُ مَقْضيُّ",11,"ي",1,0],["ثمّ أَتاهم بعدُ بالرِّجالِ","فقاتلوهم أَبلغَ القِتالِ",11,"ل",1,0],["ثم أَتتهُ ربَّةُ البَشاقصِ","تُدْلي إِليه بالودادِ الخالصِ",11,"ص",1,0],["ثم أتى يسعَى بها كالمُهدي","كأنها قد بُخِّرَتْ بالنَّدِّ",12,"د",1,0],["ثم اتق الله يرزقك الإِله بها","من حيث لم تحتسب رزقاً كما حكما",13,"م",2,0],["ثُمَّ أَتى التَعريفَ يَقرو مُخبِتاً","مَواقِفاً بَينَ أُلالٍ فَالنَقا",14,"ا",1,0],["ثُمَّ أَتى المَشعَرَ يَدعو رَبَّهُ","تَضَرُّعاً وَخُفيَةً حَتّى هَمى",14,"ا",1,0],["ثُمَّ اتَّبَعنَ غَيُوراً ذا مُعاسَرَةٍ","غِن هُنَّ شاوَرنَهُ فِى نِيَّةٍ غَضِبَا",15,"ب",2,0],["ثُمَّ اِتلَأَبَّ إِلى زِمامِ مُناخَةٍ","كَبَداءَ شُدَّ بِنَسعَتَيهِ حَشاها",16,"ا",3,0],["ثُمَّ أَتاكُم عارِياً مالِئاً","حُضنَيهِ مِن عارٍ وَمِن وِزرِ",17,"ر",1,0],["ثُمَّ اِتَّجَهتُم نَحوَنا وَأَقَمتُم","تِلكَ اللَيلَةِ في هَنا وَمَسَّرَّةِ",18,"ه",1,0],["ثُمَّ اِتَّخَذتَ القُرى كَيلاَ أَرى أَبَداً","راضٍ بِما كانَ مِن عَلِ وَمِن نَهلِ",19,"ل",1,0],["ثُمَّ أَتَاهُ شَيْبُهُ جُمُلَةً","فَأَثْلَجَتْ لحُيْتُهُ صَدْرَهُ",20,"ه",1,1],["ثم أتى دف أرطاةٍ بحَنينَةٍ","من الصريمة أواه لها الدّلسُ",21,"س",1,0],["ثمَّ اتفَقْنا على رأيٍ رَضيِتُ بهِ","بالرَّفعُ مِن صِفَتي والنَّصبُ مِن صِفَتِهْ",22,"ت",2,0],["ثُمَّ أتبعتها الحَوافِر نقطاً","فَغَدَت تنقري لِمَن لَيسَ يقرا",23,"ر",2,0],["ثم اتَّقَى أعيُنَ النُّظَّارِ ينقُدُها","من عَينِهِ كالحَصى عدَّاً ومِنْ نقَدِهْ",24,"د",2,0],["ثم أتى ركب الفلا معرضا","يطفر كالبرق إذا ما أومضا",25,"ض",2,0],["ثم أتبعتها بألطاف بر","بالغت في تعهدي وافتقادي",26,"د",2,0],["ثم أتوا من بعده عثمانا","فأعلموه أمره فاسأنى",27,"ن",2,0],["ثم أتى القوم إلى عليّ","فقال لست منكم في شيء",27,"ي",2,0],["ثم أتوا بحجج كثيرة","في مثل هذا لهم مبيرة",27,"ه",1,0],["ثم أتوا بحجج قوية","في طاعة الإمام والتقية",27,"ه",1,0],["ثم أتتهُ بعدَ ذا عَزمةٍ","من ربِّه ليس لها مَدفَعُ",28,"ع",1,0],["ثم أتى بالتمرِ يَسعى به","إلى أخيه غيرَ مستأثِرِ",29,"ر",1,0],["ثُم أَتى وَنامَ تَحتَ الشَجَرَه","مِن شَجر الجمّيز واهي الثَمَرَه",30,"ه",1,0],["ثُمَّ اتَّجه لِرَجُلٍ بِحائِه","فَاسأَلهُ عَن جَروَين أَو ثَلاثَه",31,"ه",1,0],["ثُم أَتَت جَماعة اللُصوص","لمخزن الهنديِّ بِالخُصوص",32,"ص",1,0],["ثُمَ أَتى الباقي مَع الصَياد","وَقَبَضوا عَلَيهِ بِالأَيادي",33,"ي",1,0],["ثُمَ أَتى البَخيل بَعدَ الشَمس","وَما دَرى في اليَوم أَمرَ أَمس",34,"س",1,0],["ثُمَ أَتى مَكانه لِيَرعى","فَنَظر البَحر هَدا وَهَجَعا",35,"ع",2,0],["ثُمَ أَتَت سُمَيكَةٌ صَغيرَه","فَقالَ تِلكَ قِسمَةٌ حَقيرَه",36,"ه",1,0],["ثم اتقتهم بالنصيف وأعرضت","إن النصيف مجن من لا ينصفُ",37,"ف",1,0],["ثُمّ أتَوهُم بالدَّجَاجِ الدُّجَّجِ","بَينَ قَدِيرٍ وَشِوَاءٍ مُنضَجِ",38,"ج",1,1],["ثم أتى بعد أولاء الفرا","يفري الكلام لؤلؤاً ودراً",39,"ر",2,0],["ثُم أَتاني في بَني أَبيه","فَشوهوني أَقبح التشويه",40,"ه",1,0],["ثُمَّ أَتوا يَتبعون الصوتا","وَقَد رَأَيت إِذ رَأَيت المَوتا",41,"ت",2,0],["ثم آتي لبنانَ مجلى عروس","الشرق بين العرائس الفاتناتِ",42,"ت",1,0],["ثُمَّ أَتى مِصرَ فَعاشَ حِقَبا","حَتّى قَضى مِن الحَياةِ أَرَبا",43,"ب",2,0],["ثُمَّ أَتى مَحَلَّةَ الأَنصارِ","في عُصبَةٍ مِن قَومِهِ خِيارِ",43,"ر",1,0],["ثُمَّ أَتى الرومَ فَماتَ غازِيا","كانَ البَذَندونَ المَحَلَّ القاصِيا",43,"ي",2,0],["ثُمَّ أَتاهُ بَغتَةً حَمامُهُ","سُبحانَ مَن يُعاجِلُ اِنتِقامُهُ",43,"ه",1,0],["ثم آتاه ما يشا من علو","م الملكوتية التي أبداها",44,"ا",3,0],["ثم اتباعك للرسول دائم","من ها هنا تثمر علوم الاسرار",45,"ر",1,0],["ثم اتكث محن الدنيا علي ولم","تقدم لدي جنود الصبر والظفر",46,"ر",1,0],["ثُمَّ أَتَوا نَحو قُرى بَغداد","لِأَخذِ قوت غلَّة وَالزادِ",47,"د",1,0],["ثُمَّ أَتانا كَتخدا محمَّد","وَأنَّهُ في نُصحِنا مجتَهِد",47,"د",1,0],["ثُمَّ أَتَت فُرساننا وَدَخَلوا","لِداخِل عَلى الحِصار عوّلوا",47,"ل",3,0],["ثم اتفقنا على ألقاب سالفنا","فصرت في كل حالٍ ما أضاهيه",4