{"poems":[[88,"أيها المصلحون ضاق بنا العيش","https://www.aldiwan.net/poem10703.html","الخفيف"],[90,"بدت كالشمس يحضنها الغروب","https://www.aldiwan.net/poem45008.html","الوافر"],[74,"وصافي الولا والجسم مقتبل الرضا","https://www.aldiwan.net/poem20473.html","الطويل"],[53,"صفا لك شرب العيش غير مثرب","https://www.aldiwan.net/poem8338.html","الطويل"],[30,"ألم يك جهلاً بعد سبعين حجة","https://www.aldiwan.net/poem1285.html",""],[107,"أمنك فزارة انبعث الغزاة","https://www.aldiwan.net/poem43992.html","الوافر"],[107,"أعدي النمل خيبر والذبابا","https://www.aldiwan.net/poem44062.html","الوافر"],[50,"أخي قد مضى من ليلنا الثلثان","https://www.aldiwan.net/poem65295.html","الطويل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141928","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54236","المجتث"],[53,"وبديعٍ من البدائع يَسْبي","https://www.poetsgate.com/ViewPoem.aspx?id=29591",""],[132,"قفوا قلنا في ربع ليلى مواقف","https://www.aldiwan.net/poem50573.html","الطويل"],[228,"أشكو إلى قلبك يا سيدي","https://www.aldiwan.net/poem41616.html","السريع"],[264,"بحمد الله يبدأ كل شاكر","https://www.aldiwan.net/poem35945.html","الوافر"],[443,"دعا فأجابه الدمع العصي","https://www.aldiwan.net/poem2606.html","الوافر"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53758","السريع"],[1200,"","https://poetry.dctabudhabi.ae/diwan/poem/111167","البسيط"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117544","الوافر"],[2294,"","https://poetry.dctabudhabi.ae/diwan/poem/199899","الوافر"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110638","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216476","الطويل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76705","الطويل"],[5751,"طارئ المجد","https://www.poetsgate.com/ViewPoem.aspx?id=214784",""]],"verses":[["تُؤثِرُ المَوتَ في رُبا النيلِ جوعاً","وَتَرى العارَ أَن تَعافَ المَقاما",0,"م",2,0],["تَوَثَّق حبل وُدّهما حضوراً","ولم يَنْكث توثّقه المغيب",1,"ب",1,0],["توثق شخصي في العناق بشخصِه","فما تدخل الأثواب بيني وبينه",2,"ه",1,0],["توثّبَ خصمٌ واهنُ الركن والقُوى","على أيِّدِ الأركان لم يتَوثّبِ",3,"ب",1,0],["تَوَثَّبُ بِالفُرسانِ خوصاً كَأَنَّها","سَعالٍ طَواها غَزوُهُم فَهيَ شُزَّبُ",4,"ب",1,0],["تَوثّبتِ الحتوفُ فلا فِرارٌ","وأبرقتِ السُّيوفُ فلا نَجاةُ",5,"ه",1,0],["تَوثَّبَ ياسِرٌ فَتَلَقَّفَتْهُ","مَخالِبُ فاتكٍ ألِفَ الوِثابا",6,"ب",2,0],["تَوَثَّبُ عِندَ المَزجِ في صَحنِ كَأسِهِ","تَوَثُّبَ صَعبِ الرَأسِ يَومَ رِهانِ",7,"ن",1,0],["تؤثر الموت أو تعيش عزيزا","ما رناً شامخاً ووجها أغرا",8,"ر",2,0],["تَوثَّبَ الْمَوْجُ فِيهِ","لِنَظْرَةٍ ثُمَّ ثَابا",9,"ب",2,0],["تُؤثرِ العينُ أن تَنزَّه فيه","عند قول الكرى لذي العين أغفي",10,"ف",2,0],["تؤثِّر فِي جثمانها وشىُ بُردِها","فتؤلمها أثوابُها والمطَارِفُ",11,"ف",1,0],["تؤثرُ صوتَ البومِ في نَحسِهِ","عَلى أَغاني البُلبُلِ المُنشدِ",12,"د",1,0],["تؤثّر فيهم الأسماء حالاً","لها في أمرهم حكمُ المآثر",13,"ر",1,0],["تؤثّل مجدهُ جردُ المذاكي","غداة الروع لا النشر الذكيّ",14,"ي",1,0],["توثبوا عليه هل أصابوا","أم الصواب كان ما أعابوا",15,"ب",3,0],["تؤثره الحور علينا كما","نؤثره نحن على الحورِ",16,"ر",1,0],["تؤثر كل العلوم عنه","كذلك السيف عنه يؤثر",17,"ر",1,0],["تؤثرُ فيه تجعيداً لطيفاً","كوطءٍ الصافناتِ على الدروعِ",18,"ع",1,0],["توثق من إخاء الحر إني","رأيت العبد في الحالات عبدا",19,"د",2,1],["توثق به ان خفت للدهر سطوة","فلم يخش من في ركنه قد توثقا",20,"ق",2,0],["توثب للعدوان فليمض واثبًا","على غرة منه لينقضَّ هاويا",21,"ي",2,0],["تؤثر في الأفلاك من بعد غوره","كتأثير نور الشمس في الأعين الرمد",22,"د",1,0],["توثّبَ فيها طارئُ المجدِ عابثٌ","وأورثَها بئراً وللبئرِ طبعُها",23,"ع",3,0]]}