ae/diwan/poem/10455","البسيط"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/29","الطويل"],[1073,"","https://poetry.dctabudhabi.ae/diwan/poem/18746","الوافر"],[1021,"وقد برز عنه الرجل ظلماً ورملوا","https://www.poetsgate.com/ViewPoem.aspx?id=17632",""],[605,"ألا يا عين بكي لا تملي","https://www.poetsgate.com/ViewPoem.aspx?id=81338",""]],"verses":[["وَقَدَّ بِبوعِكُم حَتّى غَدَوتُم","وَعالي النَجمِ أَقرَبُكُم مَناطا",0,"ط",2,0],["وَقَد بَلَغوا مِنَ العَلياءِ أَقصى","ذَوائِبِها وَما بَلَغوا المُرادا",1,"د",2,0],["وَقَد بَلَّغَتكَ الَّذي رُمتَهُ","وَحَقُّ المُبَلِّغِ أَن يُصطَحَب",2,"ب",1,0],["وَقَد بَعَثَتْ سِرّاً إِليَّ رَسولَها","لِأَهجُرَها وَالهَجرُ شيمَةُ مَن يَسلو",3,"ل",2,0],["وَقَد بَسَطَت عِندَ الوَداعِ أَنامِلاً","لَها في دَمي لَونٌ وَمِن دَمعِها جِلْدُ",4,"د",1,0],["وقدْ بَخِلَتْ سُعْدى فلا الطّيْفُ طارِقٌ","وليسَ بمَرْدودٍ إليّ سَلامي",5,"م",2,0],["وقدْ بعثْتُ بنَزْرِ القَدْرِ محْتَقَرٍ","إنّ الهَدايا على مِقدارِ مُهْديها",6,"ي",3,0],["وقد بدّدَتْ دُرَّ الدّموعِ يدُ النّوى","وللشّوْقِ أشجانٌ يَضيقُ لها الصّدْرُ",7,"ر",1,0],["وَقَد باتَ ذو صَفرآءَ زَوراءَ نَبعَةٍ","وَزُرقٍ حَديثٍ رَيشُها وَصِقالُها",8,"ل",3,0],["وقد بثُّوا البوارج فاسبَطَّرت","تجول به فوارد أو ثُبينا",9,"ن",2,0],["وَقَد باتَ مُغتَرّاً بِحَدراءَ قَينُكُم","وَنامَ وَلَم يَجعَل عَلى قَيدِها قُفلا",10,"ل",2,0],["وَقَد بانَ ما يَأتي مِنَ الأَمرِ وَاِكتَسَت","مَفارِقُهُ لَوناً مِنَ الشَيبِ مُغرَبا",11,"ب",2,0],["وقد بكى ليَ حتَّى الروضُ فاعتبروا","كم مقلةٍ لشقيق الغصن رمداء",12,"ا",2,0],["وقد بنيت حمامها في أضالعي","وعزم أناسٍ أن تكون مثلَّثه",13,"ث",2,0],["وقُدْ بالهمِّ قلبي","لمَّا تذكَّرت قدّك",14,"ك",1,0],["وقد بثّ فيها العدل حتى بأمنها","مها الرمل تمسي والهزبر ضجيعها",15,"ع",3,0],["وقد بدأت لو تَزْجُرُونَ بَرِيْحَها","بوائجُها من كلِّ أوبٍ تبوَّجُ",16,"ج",1,0],["وقد بل خِصييه بسلحك قابضاً","حِتاراً كعزْلاء المزادة أشتَر",17,"ر",1,0],["وقد بلتِ الدنيا المخابرَ منكمُ","فلم تبلُ إلا الصبر والكرمَ المحضا",18,"ض",2,0],["وقد بدت ساق لها خَدلَةٌ","كأنما تمشي على خروع",19,"ع",1,0],["وقد بلغْتُ الذي أملتُ من أملٍ","يا ابن الوزيرِ وما أعطى وما بذلا",20,"ل",2,0],["وَقَد بَلَغَ المَطِيُّ وَهُنَّ خوصٌ","بِلاداً لا تَحُلُّ بِها قَذورُ",21,"ر",1,0],["وَقَد بَكَرَت مِن نَحوِ نُعمانَ نَسمَةً","تُحَدِّثُ عَن أَيكٍ بِهِ وَغُصونِ",22,"ن",1,0],["وقد بنيت به الآمال شاهقة","فيا شواهق آمالي به انهدمي",23,"م",2,0],["وقد بُليتُ بقلبٍ لا يُطاوعنِي","إِذا بذلتُ له نُصْحاً أبى ونَبَا",24,"ب",2,0],["وَقَد بَحثتَ العُلومَ أَجمَعَ وَاِستَظ","هَرتَ حِفظاً مَقالَةَ السَلَفِ",25,"ف",1,0],["وَقَد بانَ فيهِم غُصنُ بانٍ إِذا بَدا","ثَوى مُخبِرٌ عَن شَكلِهِ وَمِثالِهِ",26,"ل",2,0],["وَقَد بَرِئتُ إِلى العَريضِ مِن فِكَرٍ","مُبيرَةٍ وَلِسانٍ غَيرِ مَضمونِ",27,"ن",1,0],["وَقَد بَزَّ أَدهَمَهُ لَونُهُ","فَراحَ سَواءً وَبِرذَونُهُ",28,"ن",2,0],["وَقَد بَسَطتَ يَداً بَيضاءَ طَيِّبَةً","لِلناسِ مِنكَ بِفَيضٍ غَيرِ مَنزورِ",29,"ر",1,0],["وقد برقَ الهجاءُ بقَاصِفاتٍ","تَهُمُّ لها قَناتُكَ بانقِصافِ",30,"ف",1,0],["وقد بكَرَ العبدُ من عندِنا","يزُفُّ لك الطِّرفَ والمِمْطَرا",31,"ر",2,0],["وَقَد بَنَتِ المُلوكُ بِهِ قَصوراً","فَلَم تَبقَ المُلوكُ وَلا القُصورُ",32,"ر",1,0],["وَقَد بَدا الوَردُ مُفتَرّاً مَباسِمُهُ","وَالنَرجِسُ الغَضُّ فيها شاخِصُ الحَدَقِ",33,"ق",1,0],["وقَد بَعَثتُ رِثاءً في أَبيكَ ولي","حُزْنٌ عَلَيهِ فُؤادي مِنهُ يَنفَطِرُ",34,"ر",1,0],["وقد بُدِّلتُ بعد سَرَاةِ قومي","ذئاباً في الصّحابةِ لا صحابا",35,"ب",2,0],["وقدْ بدا منكَ جفاءٌ وما","عوَّدَتنا إلا الوفا والسلامْ",36,"م",1,0],["وَقَد بَرقَعَ الثَلجُ وَجهَ الثَرى","وَأَلحَفَ غُصنَ النَقا فَاِحتَبى",37,"ب",2,0],["وَقَد بَلَّ أَعطافَ الرُبى دَمعُ مُزنَةٍ","تَحَيَّرَ في جَفنٍ مِنَ النورِ طارِفِ",38,"ف",1,0],["وَقَد بَعُدوا وَاِستَطرَدوا الآلَ دونَهُم","بِدَيمومَةٍ قَفرٍ وَأَنزَلتُ جادِيا",39,"د",3,0],["وَقَد بُلِيتُ بِعَشرٍ فِي مَحَبَّتِهِ","وَحَقّ عَشرٍ مِنَ الايَاتِ وَالسُّوَرِ",40,"ر",1,0],["وَقَد بَلَغَت شَكوى الجَزيرَةِ مُشفِقاً","وَوافى صُراخُ الحَيِّ شَيحانَ مُنجِدا",41,"د",2,0],["وقَد بَكَتهُ فَذاقَت بَعضَ مَصدَقِهِ","فَليسَ في سَمعِها مِن رَهبَةٍ صَمَمُ",42,"م",1,0],["وَقَد بَدَت فَوقَ الهِلالِ كُرَتُه","كَهامَةِ الأَسوَدِ شابَت لِحيَتُه",43,"ه",1,0],["وَقَد بَدَت فيهِ ثِمارُ الكَبَرِ","كَأَنَّها حَمائِمٌ مِن عَنبَرِ",43,"ر",1,0],["وَقَد بَدا الحُبُّ في دَمعي وَفي نَظَري","فَلا تَسَل غَيرَ ما بي مِن أَحاديثِ",44,"ث",1,0],["وقد بادَرَتْها أُخْتُها منْ ورائِها","لتَخْرُقَ من ثِنيَيْ مَجرَّتها سِجفا",45,"ف",2,0],["وقد بسَطتْ فيها الرياضُ دَرانِكاً","منَ الوَشيِ إلاّ أنّها ليس تُرقَع",46,"ع",1,0],["وقد بزَّكم أيامَكُم عُصَبُ الهُدى","وأنصارُ دينِ اللّهِ والبِيضُ والسُّمر",47,"ر",1,0],["وَقَد بانَ أَنَّ النَحسَ لَيسَ بِغافِلٍ","لَهُ عَمَلٌ في أَنجُمِ الفُهَماءِ",48,"م",3,0],["وَقَد بَلَونا العَيشَ أَطوارَهُ","فَما وَجَدنا فيهِ غَيرَ الشَقاء",49,"ق",3,0],["وَقَد بَدا لي مِنَ المَنايا","بارِقَةٌ آذَنَت بِرَعدِ",50,"د",1,0],["وقد بَسَطَتْ إلى الغَرْبِ الثرَيّا","يداً غُلقَتْ بأنْمُلِهَا الرّهانُ",51,"ن",1,0],["وقد بَلَغَ الضُّراحَ وساكِنيهِ","نَشَاكَ وزارَ مَن سَكَنَ الضَّريحا",52,"ح",2,0],["وَقَد باتَت عَلَيهِ مَها رُماحٍ","حَواسِرَ ما تَنامُ وَلا تُنيمُ",53,"م",1,1],["وقد بسط الشيطان في الأرض حكمه","ولم يبق للديان حول وسلطان",54,"ن",1,0],["وقدْ بَرَيْتَ قِدَاحاً أَنْتَ مُرْسِلُهَا","ونَحْنُ رَامُوكَ فَانْظُرْ كَيْفَ تَرْمِينَا",55,"ن",2,0],["وقد بدا القمرُ الوضاح يمطرها","إرسالَ ضوء على الآفاقِ ينسَكِب",56,"ب",1,0],["وقد بَلَغَتْ سِنَّ الكَعابِ وقابَلَتْ","بنَكهةِ معْقودِ السِّخابَيْنِ مُرْضَع",57,"ع",1,0],["وَقَدْ بَدَا ذُو ذَنَبٍ طَالِعاً","كَأَنَّهُ سُنْبُلَةُ الْقَمْحِ",58,"ح",1,0],["وَقدْ بِتَّ أَجدَرَ أَلاَّ تسَرَّ","بِهَذا الوِدَاعِ وَهَذا السَّخفْ",59,"ف",1,0],["وقد بنى لك بيتاً","من العلى جوّابا",60,"ب",2,0],["وقد بدتْ صفحةُ الْخُرْطوم مُشْرقةً","كما تجلَّى جلالُ النورِ في سينا",61,"ن",2,0],["وقد بعثت بنزر النزر محتقر","إن الهدايا على قدر مهديها",62,"ي",3,0],["وقد بدا الحقلُ في أبهى مظاهره","بساطَ نورٍ على الأرجاء منشور",63,"ر",1,0],["وقد بُثَّت الأرصادُ في كل وِجهةٍ","تخوف منها ان تُسَرَّ وتُجهَرا",64,"ر",2,0],["وقد بح صوت الحق فيها فلم يكن","ليسمع ، إلا ما تقول المدافع",65,"ع",1,0],["وقد بدت خضرةُ الأشجار لامعةً","مغمورةً بسناه فهي تزدهِر",66,"ر",1,0],["وَقد بانَ فيهمْ غُصْ