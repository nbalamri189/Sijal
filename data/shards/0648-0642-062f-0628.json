{"poems":[[53,"كأنك لم تقد بعويرضات","https://www.aldiwan.net/poem30163.html","الوافر"],[53,"ألا من يمطر السنة الجمادا","https://www.aldiwan.net/poem30602.html","الوافر"],[53,"وفى ذا السرور بتلك الكرب","https://www.aldiwan.net/poem30751.html","المتقارب"],[63,"ألا ليت شعري هل تخب مطيتي","https://www.aldiwan.net/poem45820.html","الطويل"],[63,"إذا المزن أغفى والكلال يمسه","https://www.aldiwan.net/poem45829.html","الطويل"],[63,"من الركب يا بن العامري أمامي","https://www.aldiwan.net/poem46178.html","الطويل"],[77,"أبا العلاء تلقاك الزمان بما","https://www.aldiwan.net/poem35864.html","البسيط"],[77,"سلا هل لديها من مخبرة ذكر","https://www.aldiwan.net/poem36463.html","الطويل"],[30,"دنا البين من مي فردت جمالها","https://www.aldiwan.net/poem29539.html","الطويل"],[88,"أطالوا الحرب طاحنة زبونا","https://www.aldiwan.net/poem44459.html","الوافر"],[27,"عشية أعلى مذنب الجوف قادني","https://www.aldiwan.net/poem5953.html","الطويل"],[23,"تطاول بالخمان ليلي فلم تكد","https://www.aldiwan.net/poem21259.html","الطويل"],[72,"أودت فعالك يا أسما بأحشائي","https://www.aldiwan.net/poem18168.html","البسيط"],[72,"ووارثة الألحاظ من حدق المها","https://www.aldiwan.net/poem18449.html","الطويل"],[72,"اسكنت قلبي لحدك","https://www.aldiwan.net/poem18565.html","المنسرح"],[72,"أما ونجوم الحسن أعيى طلوعها","https://www.aldiwan.net/poem19167.html","الطويل"],[51,"أمامك فانظر أي نهجيك تنهج","https://www.aldiwan.net/poem9253.html","الطويل"],[51,"ثنى شوقه والمرء يصحو ويسكر","https://www.aldiwan.net/poem63015.html","الطويل"],[51,"مواهب وهاب وقى بعضها بعضا","https://www.aldiwan.net/poem64942.html","الطويل"],[51,"قلت لخود ضفتها مرة","https://www.aldiwan.net/poem65392.html","السريع"],[51,"يا عصمة لست منها باغيا بدلا","https://www.aldiwan.net/poem65886.html","البسيط"],[29,"عفا ممن عهدت به حفير","https://www.aldiwan.net/poem6048.html","الوافر"],[70,"سقى الله أرضا لست أنسى عهودها","https://www.aldiwan.net/poem42438.html","الطويل"],[89,"حملته بين احشائي بلا برم","https://www.aldiwan.net/poem44857.html","البسيط"],[62,"قالت وقد سمعت أني نسبت بها","https://www.aldiwan.net/poem52491.html","البسيط"],[45,"مرت على عزمها ولم تقف","https://www.aldiwan.net/poem65159.html","المنسرح"],[45,"عذيري من واش بها لم أواله","https://www.aldiwan.net/poem65537.html","الطويل"],[45,"طيف لعلوة ما ينفك يأتيني","https://www.aldiwan.net/poem66689.html","البسيط"],[45,"وثقت بسعد فما أفلحت","https://www.aldiwan.net/poem66808.html","المتقارب"],[28,"كيف ببيت قريب منك مطلبه","https://www.aldiwan.net/poem5081.html","البسيط"],[61,"تلاف السهم أثبت في الشغاف","https://www.aldiwan.net/poem51548.html","الوافر"],[61,"لنا غرفة حسنت منظرا","https://www.aldiwan.net/poem51645.html","المتقارب"],[58,"رأيت الدهر مختلفا يدور","https://www.aldiwan.net/poem31029.html","الوافر"],[66,"فيروزج الصبح أم يا قوتة الشفق","https://www.aldiwan.net/poem41544.html","البسيط"],[80,"هذا ابتداء له عند العلى خبر","https://www.aldiwan.net/poem31433.html","البسيط"],[80,"ألا كم تسمع الزمن العتابا","https://www.aldiwan.net/poem31566.html","الوافر"],[69,"محب مولانا ومملوكه","https://www.aldiwan.net/poem28374.html","السريع"],[74,"ألا فضلت ذيلها ليلة","https://www.aldiwan.net/poem12853.html","المتقارب"],[74,"ألا رب يوم لي بباب الزخارف","https://www.aldiwan.net/poem13180.html","الطويل"],[33,"بي اليوم ما بي من هيام أصابني","https://www.aldiwan.net/poem25745.html","الطويل"],[81,"وافى وفي جيده عقد من الدرر","https://www.aldiwan.net/poem61359.html","البسيط"],[81,"أصيخوا فمن طور الهدى انبعث الندا","https://www.aldiwan.net/poem61537.html","الطويل"],[21,"والحية الحتفة الرقشاء أخرجها","https://www.aldiwan.net/poem36160.html","البسيط"],[52,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[52,"وفتية لا يخوض الشك أنفسهم","https://www.aldiwan.net/poem27181.html","البسيط"],[75,"أليلتنا إذ أرسلت واردا وحفا","https://www.aldiwan.net/poem69061.html","الطويل"],[75,"رأيت بعيني فوق ما كنت أسمع","https://www.aldiwan.net/poem69065.html","الطويل"],[75,"تقول بنو العباس هل فتحت مصر","https://www.aldiwan.net/poem69083.html","الطويل"],[46,"إذا كان علم الناس ليس بنافع","https://www.aldiwan.net/poem22025.html","الطويل"],[46,"تقواك زاد فاعتقد أنه","https://www.aldiwan.net/poem22036.html","السريع"],[46,"لا يعجبن الفتى بفضل","https://www.aldiwan.net/poem22473.html","مجزوء البسيط"],[46,"معان من أحبتنا معان","https://www.aldiwan.net/poem23635.html","الوافر"],[46,"ألاح وقد رأى برقا مليحا","https://www.aldiwan.net/poem23637.html","الوافر"],[15,"وقد باتت عليه مها رماح","https://www.aldiwan.net/poem45243.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85845","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39676","البسيط"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16635","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42559","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55027","المتقارب"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142053","المجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54220","البسيط"],[77,"أبا العلاء تلقاك الزمان بما","https://www.poetsgate.com/ViewPoem.aspx?id=34181",""],[90,"وحي الرستمية","https://www.poetsgate.com/ViewPoem.aspx?id=179135",""],[90,"عاشوراء","https://www.poetsgate.com/ViewPoem.aspx?id=179150",""],[90,"الثورة العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=178929",""],[90,"الفرات الطاغي","https://www.poetsgate.com/ViewPoem.aspx?id=179148",""],[45,"عَذِيريَ منْ وَاشٍ بهَا لَمْ أُوَالهِ","https://www.poetsgate.com/ViewPoem.aspx?id=31868",""],[51,"يا عصمة ً لستُ منها باغياً بدلا","https://www.poetsgate.com/ViewPoem.aspx?id=30264",""],[67,"جَنابكِ منه تُسْتَفَادُ الفَوائدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13730&r=&rc=6",""]],"verses":[["وَقَدَّ بِبوعِكُم حَتّى غَدَوتُم","وَعالي النَجمِ أَقرَبُكُم مَناطا",0,"ط",2,0],["وَقَد بَلَغوا مِنَ العَلياءِ أَقصى","ذَوائِبِها وَما بَلَغوا المُرادا",1,"د",2,0],["وَقَد بَلَّغَتكَ الَّذي رُمتَهُ","وَحَقُّ المُبَلِّغِ أَن يُصطَحَب",2,"ب",1,0],["وَقَد بَعَثَتْ سِرّاً إِليَّ رَسولَها","لِأَهجُرَها وَالهَجرُ شيمَةُ مَن يَسلو",3,"ل",2,0],["وَقَد بَسَطَت عِندَ الوَداعِ أَنامِلاً","لَها في دَمي لَونٌ وَمِن دَمعِها جِلْدُ",4,"د",1,0],["وقدْ بَخِلَتْ سُعْدى فلا الطّيْفُ طارِقٌ","وليسَ بمَرْدودٍ إليّ سَلامي",5,"م",2,0],["وقدْ بعثْتُ بنَزْرِ القَدْرِ محْتَقَرٍ","إنّ الهَدايا على مِقدارِ مُهْديها",6,"ي",3,0],["وقد بدّدَتْ دُرَّ الدّموعِ يدُ النّوى","وللشّوْقِ أشجانٌ يَضيقُ لها الصّدْرُ",7,"ر",1,0],["وَقَد باتَ ذو صَفرآءَ زَوراءَ نَبعَةٍ","وَزُرقٍ حَديثٍ رَيشُها وَصِقالُها",8,"ل",3,0],["وقد بثُّوا البوارج فاسبَطَّرت","تجول به فوارد أو ثُبينا",9,"ن",2,0],["وَقَد باتَ مُغتَرّاً بِحَدراءَ قَينُكُم","وَنامَ وَلَم يَجعَل عَلى قَيدِها قُفلا",10,"ل",2,0],["وَقَد بانَ ما يَأتي مِنَ الأَمرِ وَاِكتَسَت","مَفارِقُهُ لَوناً مِنَ الشَيبِ مُغرَبا",11,"ب",2,0],["وقد بكى ليَ حتَّى الروضُ فاعتبروا","كم مقلةٍ لشقيق الغصن رمداء",12,"ا",2,0],["وقد بنيت حمامها في أضالعي","وعزم أناسٍ أن تكون مثلَّثه",13,"ث",2,0],["وقُدْ بالهمِّ قلبي","لمَّا تذكَّرت قدّك",14,"ك",1,0],["وقد بثّ فيها العدل حتى بأمنها","مها الرمل تمسي والهزبر ضجيعها",15,"ع",3,0],["وقد بدأت لو تَزْجُرُونَ بَرِيْحَها","بوائجُها من كلِّ أوبٍ تبوَّجُ",16,"ج",1,0],["وقد بل خِصييه بسلحك قابضاً","حِتاراً كعزْلاء المزادة أشتَر",17,"ر",1,0],["وقد بلتِ الدنيا المخابرَ منكمُ","فلم تبلُ إلا الصبر والكرمَ المحضا",18,"ض",2,0],["وقد بدت ساق لها خَدلَةٌ","كأنما تمشي على خروع",19,"ع",1,0],["وقد بلغْتُ الذي أملتُ من أملٍ","يا ابن الوزيرِ وما أعطى وما بذلا",20,"ل",2,0],["وَقَد بَلَغَ المَطِيُّ وَهُنَّ خوصٌ","بِلاداً لا تَحُلُّ بِها قَذورُ",21,"ر",1,0],["وَقَد بَكَرَت مِن نَحوِ نُعمانَ نَسمَةً","تُحَدِّثُ عَن أَيكٍ بِهِ وَغُصونِ",22,"ن",1,0],["وقد بنيت به الآمال شاهقة","فيا شواهق آمالي به انهدمي",23,"م",2,0],["وقد بُليتُ بقلبٍ لا يُطاوعنِي","إِذا بذلتُ له نُصْحاً أبى ونَبَا",24,"ب",2,0],["وَقَد بَحثتَ العُلومَ أَجمَعَ وَاِستَظ","هَرتَ حِفظاً مَقالَةَ السَلَفِ",25,"ف",1,0],["وَقَد بانَ فيهِم غُصنُ بانٍ إِذا بَدا","ثَوى مُخبِرٌ عَن شَكلِهِ وَمِثالِهِ",26,"ل",2,0],["وَقَد بَرِئتُ إِلى العَريضِ مِن فِكَرٍ","مُبيرَةٍ وَلِسانٍ غَيرِ مَضمونِ",27,"ن",1,0],["وَقَد بَزَّ أَدهَمَهُ لَونُهُ","فَراحَ سَواءً وَبِرذَونُهُ",28,"ن",2,0],["وَقَد بَسَطتَ يَداً بَيضاءَ طَيِّبَةً","لِلناسِ مِنكَ بِفَيضٍ غَيرِ مَنزورِ",29,"ر",1,0],["وقد برقَ الهجاءُ بقَاصِفاتٍ","تَهُمُّ لها قَناتُكَ بانقِصافِ",30,"ف",1,0],["وقد بكَرَ العبدُ من عندِنا","يزُفُّ لك الطِّرفَ والمِمْطَرا",31,"ر",2,0],["وَقَد بَنَتِ المُلوكُ بِهِ قَصوراً","فَلَم تَبقَ المُلوكُ وَلا القُصورُ",32,"ر",1,0],["وَقَد بَدا الوَردُ مُفتَرّاً مَباسِمُهُ","وَالنَرجِسُ الغَضُّ فيها شاخِصُ الحَدَقِ",33,"ق",1,0],["وقَد بَعَثتُ رِثاءً في أَبيكَ ولي","حُزْنٌ عَلَيهِ فُؤادي مِنهُ يَنفَطِرُ",34,"ر",1,0],["وقد بُدِّلتُ بعد سَرَاةِ قومي","ذئاباً في الصّحابةِ لا صحابا",35,"ب",2,0],["وقدْ بدا منكَ جفاءٌ وما","عوَّدَتنا إلا الوفا والسلامْ",36,"م",1,0],["وَقَد بَرقَعَ الثَلجُ وَجهَ الثَرى","وَأَلحَفَ غُصنَ النَقا فَاِحتَبى",37,"ب",2,0],["وَقَد بَلَّ أَعطافَ الرُبى دَمعُ مُزنَةٍ","تَحَيَّرَ في جَفنٍ مِنَ النورِ طارِفِ",38,"ف",1,0],["وَقَد بَعُدوا وَاِستَطرَدوا الآلَ دونَهُم","بِدَيمومَةٍ قَفرٍ وَأَنزَلتُ جادِيا",39,"د",3,0],["وَقَد بُلِيتُ بِعَشرٍ فِي مَحَبَّتِهِ","وَحَقّ عَشرٍ مِنَ الايَاتِ وَالسُّوَرِ",40,"ر",1,0],["وَقَد بَلَغَت شَكوى الجَزيرَةِ مُشفِقاً","وَوافى صُراخُ الحَيِّ شَيحانَ مُنجِدا",41,"د",2,0],["وقَد بَكَتهُ فَذاقَت بَعضَ مَصدَقِهِ","فَليسَ في سَمعِها مِن رَهبَةٍ صَمَمُ",42,"م",1,0],["وَقَد بَدَت فَوقَ الهِلالِ كُرَتُه","كَهامَةِ الأَسوَدِ شابَت لِحيَتُه",43,"ه",1,0],["وَقَد بَدَت فيهِ ثِمارُ الكَبَرِ","كَأَنَّها حَمائِمٌ مِن عَنبَرِ",43,"ر",1,0],["وَقَد بَدا الحُبُّ في دَمعي وَفي نَظَري","فَلا تَسَل غَيرَ ما بي مِن أَحاديثِ",44,"ث",1,0],["وقد بادَرَتْها أُخْتُها منْ ورائِها","لتَخْرُقَ من ثِنيَيْ مَجرَّتها سِجفا",45,"ف",2,0],["وقد بسَطتْ فيها الرياضُ دَرانِكاً","منَ الوَشيِ إلاّ أنّها ليس تُرقَع",46,"ع",1,0],["وقد بزَّكم أيامَكُم عُصَبُ الهُدى","وأنصارُ دينِ اللّهِ والبِيضُ والسُّمر",47,"ر",1,0],["وَقَد بانَ أَنَّ النَحسَ لَيسَ بِغافِلٍ","لَهُ عَمَلٌ في أَنجُمِ الفُهَماءِ",48,"م",3,0],["وَقَد بَلَونا العَيشَ أَطوارَهُ","فَما وَجَدنا فيهِ غَيرَ الشَقاء",49,"ق",3,0],["وَقَد بَدا لي مِنَ المَنايا","بارِقَةٌ آذَنَت بِرَعدِ",50,"د",1,0],["وقد بَسَطَتْ إلى الغَرْبِ الثرَيّا","يداً غُلقَتْ بأنْمُلِهَا الرّهانُ",51,"ن",1,0],["وقد بَلَغَ الضُّراحَ وساكِنيهِ","نَشَاكَ وزارَ مَن سَكَنَ الضَّريحا",52,"ح",2,0],["وَقَد باتَت عَلَيهِ مَها رُماحٍ","حَواسِرَ ما تَنامُ وَلا تُنيمُ",53,"م",1,1],["وقد بسط الشيطان في الأرض حكمه","ولم يبق للديان حول وسلطان",54,"ن",1,0],["وقد بدا القمرُ الوضاح يمطرها","إرسالَ ضوء على الآفاقِ ينسَكِب",55,"ب",1,0],["وقد بَلَغَتْ سِنَّ الكَعابِ وقابَلَتْ","بنَكهةِ معْقودِ السِّخابَيْنِ مُرْضَع",56,"ع",1,0],["وَقَدْ بَدَا ذُو ذَنَبٍ طَالِعاً","كَأَنَّهُ سُنْبُلَةُ الْقَمْحِ",57,"ح",1,0],["وَقدْ بِتَّ أَجدَرَ أَلاَّ تسَرَّ","بِهَذا الوِدَاعِ وَهَذا السَّخفْ",58,"ف",1,0],["وقد بنى لك بيتاً","من العلى جوّابا",59,"ب",2,0],["وقد بدتْ صفحةُ الْخُرْطوم مُشْرقةً","كما تجلَّى جلالُ النورِ في سينا",60,"ن",2,0],["وقد بعثت بنزر النزر محتقر","إن الهدايا على قدر مهديها",61,"ي",3,0],["وقد بدا الحقلُ في أبهى مظاهره","بساطَ نورٍ على الأرجاء منشور",62,"ر",1,0],["وقد بُثَّت الأرصادُ في كل وِجهةٍ","تخوف منها ان تُسَرَّ وتُجهَرا",63,"ر",2,0],["وقد بح صوت الحق فيها فلم يكن","ليسمع ، إلا ما تقول المدافع",64,"ع",1,0],["وقد بدت خضرةُ الأشجار لامعةً","مغمورةً بسناه فهي تزدهِر",65,"ر",1,0],["وَقد بانَ فيهمْ غُصْنُ بانٍ، إذا بَدَا","ثَوَى مُخبرٌ عن شَكْْلِهِ، أوْ مثالهِ",66,"ل",2,0],["وقد بلغْتُ الذي أملتُ من أملٍ","يا بن الوزيرِ وما أعطى وما بذلا",67,"ل",2,0],["وقد بينت لي هل أتى كم أتى بها","مكارمُ أخْلاَق لكم وَمَحَامِدُ",68,"د",1,0]]}