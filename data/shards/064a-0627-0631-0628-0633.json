{"poems":[[29,"لجت أمامة في لومي وما علمت","https://www.aldiwan.net/poem5769.html","البسيط"],[51,"يا رب ساكن حفرة","https://www.aldiwan.net/poem63095.html","مجزوء الكامل"],[50,"يا رب ساق كأنه شبه البدر","https://www.aldiwan.net/poem64402.html","المنسرح"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54761","الكامل"],[108,"الريف","https://www.poetsgate.com/ViewPoem.aspx?id=179446",""],[190,"يا رب سلط على العميان موجبة","https://www.aldiwan.net/poem44090.html","البسيط"],[234,"يا رب إن واخذته بتلهفي","https://www.aldiwan.net/poem50946.html","الكامل"],[303,"كم في أزاهير الرياض لناظر","https://www.aldiwan.net/poem36839.html","عموديه"],[398,"إذا تراخى مديحي آل يسينا","https://www.aldiwan.net/poem53670.html","البسيط"],[398,"يا زائرا سائرا إلى الكوفه","https://www.aldiwan.net/poem53676.html","المنسرح"],[422,"لمن السوابق والجياد الضمر","https://www.aldiwan.net/poem54183.html","الكامل"],[438,"وصل اهتمامك بي فخبرني","https://www.aldiwan.net/poem12692.html","أحذ الكامل"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126738","الرجز"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34432","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70714","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78165","البسيط"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108515","البسيط"],[498,"","https://poetry.dctabudhabi.ae/diwan/poem/28126","الرجز"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/61014","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100290","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201219","المنسرح"],[3114,"","https://poetry.dctabudhabi.ae/diwan/poem/147712","البسيط"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3278,"","https://poetry.dctabudhabi.ae/diwan/poem/121418","البسيط"],[3394,"","https://poetry.dctabudhabi.ae/diwan/poem/123908","المنسرح"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99328","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108085","الكامل"],[3641,"","https://poetry.dctabudhabi.ae/diwan/poem/202251","الرجز"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86578","الكامل"],[3914,"","https://poetry.dctabudhabi.ae/diwan/poem/116892","البسيط"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83626","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83522","السريع"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133211","الرجز"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133151",""],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133176","الرجز"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133100","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133077","الرجز"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147258","البسيط"],[4679,"لا مرحباً بالزائر الجائرِ","https://www.poetsgate.com/ViewPoem.aspx?id=142767",""],[4726,"قد عيل صبري وأيام الصبا ذهبت","https://www.poetsgate.com/ViewPoem.aspx?id=146644",""],[4980,"مناجاة","https://www.poetsgate.com/ViewPoem.aspx?id=191786",""],[5343,"صدى البردة","https://www.poetsgate.com/ViewPoem.aspx?id=132671",""],[812,"من العقيق ومن تذكاري ذي سلمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=115769",""],[5376,"يا ربُّ سلِّمْ أرضَ غزَّةَ أنَّها","https://www.poetsgate.com/ViewPoem.aspx?id=198985",""],[5922,"محاورة النجوم","https://www.poetsgate.com/ViewPoem.aspx?id=185133",""],[5956,"يا رب وفّقْ زوجتي بأمورها","https://www.poetsgate.com/ViewPoem.aspx?id=182416",""],[5956,"اشفها يا ربنا لا تُشْقِها","https://www.poetsgate.com/ViewPoem.aspx?id=192142",""],[5956,"لله أشكو ذلتي وضلالي","https://www.poetsgate.com/ViewPoem.aspx?id=192524",""],[5956,"بالي عليكم دائماً مشغولُ","https://www.poetsgate.com/ViewPoem.aspx?id=203724",""],[5956,"يا أبا ثابت أرجوك قل لسميةَ الحسناءا","https://www.poetsgate.com/ViewPoem.aspx?id=205164",""],[5956,"يا ربِّ كيف خلقت هذا الهاديا؟","https://www.poetsgate.com/ViewPoem.aspx?id=207357",""],[5957,"رمضان شهر الخير","https://www.poetsgate.com/ViewPoem.aspx?id=204597",""],[6152,"مناجاة ودعاء","https://www.poetsgate.com/ViewPoem.aspx?id=203757",""],[6202,"طول مسيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86734&r=&rc=35",""],[5126,"وَدِّعْ هَواك!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87807&r=&rc=22",""]],"verses":[["يا رُبَّ سَجلٍ مُغيثٍ قَد نَفَحتَ بِهِ","مِن نائِلٍ غَيرِ مَنزوحٍ وَلا كَدِرِ",0,"ر",1,0],["يا رُبَّ ساكِنِ حُفرَةٍ","أَبلَت جَديدَ جَمالِهِ",1,"ل",2,1],["يا رُبَّ ساقٍ كَأَنَّهُ شَبَهُ ال","بَدرِ تَجَلّى الظَلامُ عَن سَدَفِه",2,"ف",2,1],["يَا رَب سَلِّمْنَا وَإِنْ فُطِرَتْ أَسىً","مِنَّا حُشَاشَاتٌ وَشُقَّتْ أَكْبُدُ",3,"د",1,0],["يا رُبَّ ساقيةٍ لغير صبابة","أنَّت وأجرَت دمعها مسكوبا",4,"ب",2,0],["يا رب سلط على العميان موجبة","يا رب وابدأ بأعمى آل حجّاج",5,"ج",1,1],["يا ربّ سلِّمه ومُنَّ بِرَدِّه","واغْفِرْ له عقْبَى يمينِ المُصْحَف",6,"ف",1,0],["يا ربَّ سوداء الملاءَةِ شمّرتْ","عن ساقِها ورنتْ بعينِ معاقر",7,"ر",1,0],["يا رب سَهِّل زِياراتي مشاهِدَهُم","فَاِنَّ روحيَ تَهوى ذلِكَ الطينا",8,"ن",2,0],["يا رَبّ سَهِّل لِقاء مَشهدهِ","وَلا تُمتِني بِحَسرَةِ الكوفَه",9,"ف",2,0],["يا ربّ سامحْنا على هفواتنا","فذنوبنا ممَّا علمنا أكبر",10,"ر",1,0],["يا ربِّ سلِّمْ لي أبا حسن","ما هزّ ريحَك مِعْطَفي سلَمِكْ",11,"ك",1,0],["يا ربِّ سلّم شعبَنا","بحقّ ربّ المشعرِ",12,"ر",1,0],["يا رُبَّ سَمرا عليه جُنَّت","لمّا أَتى دارَ وَصلِها",13,"ه",2,0],["يا رب سكِّنْ مُعاديه وشانئه","جُبًّا لِغيِّهمُ والسجنَ والجدثا",14,"ث",2,0],["يا رب سلم سدوهن الليله","وليلة أخرى وكل ليله",15,"ه",1,0],["يا رَب سَلم لَنا مَلك البَسيطة مِن","كُل الرَدى ما نَأَت بِالسَير شَمليلُ",16,"ل",1,0],["يا رب سحر العيون الناعسات سبا","من كان أفتى وأعتى من ملوك سبا",17,"ب",2,1],["يا رُبَّ سِربٍ آمِنٍ لَم يُزعَجٍ","غادَيتُهُ قَبلَ الصَباحِ الأَبلَجِ",18,"ج",1,1],["يا ربّ سقيا رحمةٍ وتعطّف","لا غيث عادِ في الزمَان الرمدد",19,"د",1,0],["يا ربَّ سارية تروح وتغتدي","ببروقها فتضيء ليل الساري",20,"ر",2,0],["يا رُب سيارة ركبت بها","فيها جموع بالثقل تُرهقها",21,"ه",2,1],["يا رب سهل لي الخيرات أفعلها","مع الأنام بموجودي وإمكاني",22,"ن",2,1],["يا رب سدد وايد دائما ابداً","وافتح بنصر قريب غير منصرم",23,"م",1,0],["يا رب سلم ادم سترا لنا ابدا","لا تخزنا يوم كشف الساق والقدم",23,"م",1,0],["يا ربَّ سوداءَ تيمتني","يَحسُنُ في مثلها الغرامُ",24,"م",1,1],["يا رُبّ سوقٍ مزيّن حسن","جُزتُ به والنّهارُ منسلِخُ",25,"خ",1,1],["يا رب سابغة حبتني نعمة","كافأتها بالسوء غير مفندِ",26,"د",1,1],["يا رب سلمني قبلَ فراقه","أن لا اعودَ إلى مكاني السابق",27,"ق",1,0],["يا رب سبعين له قد جمعت","فأذبح الذود التي قد عطلت",28,"ت",1,1],["يا رب سربال تحاول رفوه","يوماً فيتلفه عليك الرافي",29,"ف",2,0],["يا ربّ سوسنة قد بتّ ألثمها","ومالها غير طعم المسك من ريق",30,"ق",1,1],["يا ربّ سَلِّمنا وَسَلِّم أَهلَنا","منها وَسَلِّم سائِر الإِخوانِ",31,"ن",1,0],["يا رَبّ سلِّطهُ عَلى ضدّنا","أَو هَب لَنا كهتلَر آخرا",32,"ر",2,0],["يا رب سامحنا وكن عوناً لنا","في سائر الحالات أخرى ودني",33,"ي",1,0],["يا رب سالك بخير الرسل خير العباد","أن تجمع الشمل في الغنا بزين المواد",34,"د",1,0],["يا رب سالك بالرسول الأمجد","المصطفى أحمد",35,"د",1,0],["يا رب سالك بحق المصطفى الهادي","والآل والصحب أن توليني إرشادي",36,"د",2,1],["يا رب سلم الدين","وعافنا من هولِ كل فتنه",37,"ه",1,0],["يا رُبَّ ِسر غناء بثه شجني","لولاه نار الجوى همٌّ سيضطرمُ",38,"م",1,0],["يا ربِ سكن منه لنا واقياً","فما لنا غيرك من ناصرِ",39,"ر",1,0],["يا رب سهل طريقي في زيارته","من قبل أن تعتريني شدة الهرم",40,"م",1,0],["يَا رَبّ سَلِّم فؤادًا نابهُ ندمٌ","واغفر لعبدٍ قدِ استَرضَتكَ عيناهُ",41,"ا",2,1],["يا رب سلم على أهل له أسد","بين الأنام نجوم الركب في الظلم",42,"م",1,0],["يا رب سهل سريعاً باللحوق بهم","فضلاً وأدمج محباً في لوائهم",43,"م",1,0],["يا ربُّ سلِّمْ أرضَ غزَّةَ أنَّها","طاعتْ لأمرِك عِزَّةً وصمودا",44,"د",2,1],["يا ربُّ سلِّمْ أهلَ غزَّةَ أنَّهم","ركعوا اليك أذلَّةً وسجودا",44,"د",2,0],["ياربِّ سجّلْ سِماتي في السّماءِ، ودعْ","أحاورُ النجْمَ ، دهْري لم يزلْ جمُدا",45,"د",2,0],["‏يا رب سامحني على إزعاجها","‏ ‏ وامنح لها التعويض عن تدميرها",46,"ر",3,0],["يا رب ساعدها وساعد موطني","حتى يعود لأمنه الميمونِ",47,"ن",1,0],["يا رب ساعدني فإني خائبٌ","لا وعيَ عندي إن تغب عن بالي",48,"ل",2,0],["يا ربِّ ساعدها لتشريَ منزلاً","فيهِ نعيش معاً وفيه نَزولُ",49,"ل",1,0],["يا رَبِّ ساعدني لأشكر فضلها","أثني عليكَ ولا أمل ثناءا",50,"ا",3,0],["يا ربِّ ساعده لكسب طموحه","لا تتركن لديه قَطُّ عواديا",51,"ي",2,0],["يا ربِ سامحني بحق المصطفى","وبحق من عبدوك في رمضان",52,"ن",1,0],["يارب سهل لي أموري كلها","فيك الرجاء ومنك دفع مصائبي",53,"ب",2,0],["يا رب سامح ما مضى من خيبة","هي كم تؤرقني بعيني تقبح",54,"ح",1,0],["يَا رُبَّ سَحرَةِ ليلٍ ظَلْتَ تَحْسَبُهَا","مِنَ الفَرَادِيسِ أضْوَاءَ وأنْغامَا",55,"م",2,0]]}