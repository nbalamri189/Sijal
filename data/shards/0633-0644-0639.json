{"poems":[[73,"أنا ظرف للهو كل ظريف","https://www.aldiwan.net/poem11989.html","الخفيف"],[83,"أللمحة من بارق متبسم","https://www.aldiwan.net/poem54240.html","الكامل"],[88,"هي النفوس وإن لم تبلغ الحلما","https://www.aldiwan.net/poem44830.html","البسيط"],[88,"للجعفرين شهادة الأبرار","https://www.aldiwan.net/poem45042.html","الكامل"],[72,"سل عن مقامي والرؤوس حوائم","https://www.aldiwan.net/poem19184.html","الكامل"],[72,"نفس عن الحب ما حادت ولا غفلت","https://www.aldiwan.net/poem19467.html","البسيط"],[72,"من مبلغ علماء الأعصر الأول","https://www.aldiwan.net/poem19527.html","البسيط"],[85,"استخلف المنصور في وصاته","https://www.aldiwan.net/poem7909.html","الرجز"],[85,"ريم على القاع بين البان والعلم","https://www.aldiwan.net/poem20976.html","البسيط"],[43,"بأبي الشموس الجانحات غواربا","https://www.aldiwan.net/poem9466.html","الكامل"],[61,"قد أظلتك يا أبا إسحاق","https://www.aldiwan.net/poem51509.html","الخفيف"],[105,"اشهدي يا مصر أعمال البنين","https://www.aldiwan.net/poem43070.html","الرمل"],[81,"سل عن سهادي وعن سقمي وعن جلدي","https://www.aldiwan.net/poem61364.html","البسيط"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[67,"وسلن حبقوق المصرح باسمه","https://www.aldiwan.net/poem18080.html","الكامل"],[67,"اليوم قد حكم الهوى بالمعدله","https://www.aldiwan.net/poem18087.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85483","الخفيف"],[21,"","https://poetry.dctabudhabi.ae/diwan/poem/11042","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42669","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54860","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142035","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141933","الكامل"],[106,"شعر الماحي","https://www.poetsgate.com/ViewPoem.aspx?id=179364",""],[90,"تحية العيد أو الملك والإنتداب","https://www.poetsgate.com/ViewPoem.aspx?id=178948",""],[121,"ما أنس لا أنس أياما نعمت بها","https://www.aldiwan.net/poem49318.html","البسيط"],[136,"وضح الهدى وعلا منار الدين","https://www.aldiwan.net/poem49115.html","الكامل"],[144,"سل عن فضائلك الزمان لتخبرا","https://www.aldiwan.net/poem11760.html","الكامل"],[144,"ما في المعالي علي منك يعتصم","https://www.aldiwan.net/poem11822.html","الطويل"],[151,"حمل الفؤاد على الهوى وتحملا","https://www.aldiwan.net/poem68463.html","الكامل"],[170,"يا ساهر الطرف من خوف ومن وجل","https://www.aldiwan.net/poem1652.html",""],[170,"من ذا أفتاك بسفك دمي","https://www.aldiwan.net/poem1682.html",""],[198,"نوحي بعقر السجن نوحي","https://www.aldiwan.net/poem39896.html","مجزوء الكامل"],[230,"سل عن فعالي الراح والصحو والسكرا","https://www.aldiwan.net/poem51016.html","الطويل"],[236,"أمط اللثام عن العذار السائل","https://www.aldiwan.net/poem31792.html","الكامل"],[236,"سل عن الماضين إن نطقت","https://www.aldiwan.net/poem31799.html","المديد"],[251,"أو ما ترى الإسكندرية","https://www.aldiwan.net/poem14965.html","مجزوء الكامل"],[251,"بانت وقد كلفتها توديعي","https://www.aldiwan.net/poem14992.html","الكامل"],[260,"بمدام أنس مقام إبراهيما","https://www.aldiwan.net/poem35807.html","الكامل"],[271,"سل عن تبابعة عظام مأربا","https://www.aldiwan.net/poem35003.html","الكامل"],[272,"قف بالخضوع ونادربك يا هو","https://www.aldiwan.net/poem52132.html","الكامل"],[276,"بيني ثلاثا سلوة الأيام","https://www.aldiwan.net/poem25529.html","الكامل"],[276,"أعمى البصيرة من تقدمه الهوى","https://www.aldiwan.net/poem25561.html","الكامل"],[283,"هل من حديث قديم العهد أوطاري","https://www.aldiwan.net/poem32785.html","البسيط"],[283,"سل عن فؤادي بسلع أية ذهبا","https://www.aldiwan.net/poem32874.html","البسيط"],[298,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[298,"سفرت أميمة ليلة النفر","https://www.aldiwan.net/poem33277.html","أحذ الكامل"],[298,"سل عن فؤادك حين طاش بك الهوى","https://www.aldiwan.net/poem33282.html","الكامل"],[298,"معاطف أم رماح سمهريات","https://www.aldiwan.net/poem33315.html","البسيط"],[329,"ملك القلوب بحبه وتوحدا","https://www.aldiwan.net/poem54966.html","الكامل"],[346,"واعدني الكبش موسى ثم أخلفني","https://www.aldiwan.net/poem4465.html","البسيط"],[362,"حتام يا ساجي اللواحظ تهجر","https://www.aldiwan.net/poem68111.html","الكامل"],[394,"أحسن من عود ومن ضارب","https://www.aldiwan.net/poem53614.html","السريع"],[401,"رسالة إلى فرعون مصر","https://www.aldiwan.net/poem10305.html","عموديه"],[404,"يا سعد خذ بأبي وأمي","https://www.aldiwan.net/poem33426.html","مجزوء الكامل"],[410,"قل للذي فقد الأحبة وانثنى","https://www.aldiwan.net/poem31649.html","عموديه"],[433,"كم مقلة للشقيق الغض رمداء","https://www.aldiwan.net/poem12548.html","البسيط"],[438,"خف القطين وبان الرائح الغادي","https://www.aldiwan.net/poem2619.html","البسيط"],[450,"إن العروبة بالإسلام عزتها","https://www.aldiwan.net/poem996.html",""],[459,"سل عن فؤادك بين منعقِد اللوى","https://www.aldiwan.net/poem55837.html","الكامل"],[465,"سل عنه قلب الانكتير","https://www.aldiwan.net/poem3111.html","عموديه"],[465,"لا تنكري سقمي ولا تسهيدي","https://www.aldiwan.net/poem3137.html","عموديه"],[465,"ليست قدوداً ولكن هذه أسل","https://www.aldiwan.net/poem3144.html","عموديه"],[465,"قلبي بذاك الخال ليس بخال","https://www.aldiwan.net/poem3230.html","عموديه"],[465,"شهرت علي صوارم العذل","https://www.aldiwan.net/poem3349.html","عموديه"],[466,"شدوا اليك نياط القلب والعصبا","https://www.aldiwan.net/poem54193.html","عموديه"],[501,"قالوا تحب عليا قلت مبتهجا","https://www.aldiwan.net/poem37650.html","البسيط"],[515,"هذا العقيق وتلك شم رعانه","https://www.aldiwan.net/poem20784.html","الكامل"],[515,"عج بالعقيق وناد أسد سراته","https://www.aldiwan.net/poem20807.html","الكامل"],[530,"قلب تقلب في فنون","https://www.aldiwan.net/poem37273.html","مجزوء الكامل"],[530,"أعلى الذي ألقى طلبت شهودي","https://www.aldiwan.net/poem37458.html","الكامل"],[552,"حتام ذمي عندكم أزماني","https://www.aldiwan.net/poem47167.html","الكامل"],[552,"إن كنت يا عمرو قد أسأت فقد","https://www.aldiwan.net/poem47227.html","المنسرح"],[552,"ما لك في ربة الغلائل","https://www.aldiwan.net/poem47285.html","الرجز"],[552,"قد زرت ليلة هومنا على العيس","https://www.aldiwan.net/poem47744.html","البسيط"],[552,"لم يبق لي بعد المشيب تصابي","https://www.aldiwan.net/poem48055.html","الكامل"],[554,"اهلا بكيت ظعائنا وحمولا","https://www.aldiwan.net/poem68428.html","الكامل"],[587,"أأخاف صرف الدهر أم حدثانه","https://www.aldiwan.net/poem17502.html","الكامل"]],"verses":[["سَل عَنِ الطَيِّباتِ فَهِيَ فُنونٌ","أُلِّفَت فِيَّ أَحسَنَ التَأليفِ",0,"ف",1,0],["سلْ عنهمُ أُحُداً وبدراً تلقَهُمْ","أَهلَ الغَناء بها وأهلَ المغنمِ",1,"م",1,0],["سل عنه طوسند إذ سُدّت مسالكه","فظلّ في الكوت يشكو بالطوى ألما",2,"م",2,0],["سل عن معاركه طرابلس التي","قد كان فيها شعلة من نار",3,"ر",1,0],["سل عن مقاميَ والرؤوس حوائمٌ","تحت العجاجة والنسور وقوع",4,"ع",1,1],["سل عن عطاياهُ تسأل كلّ وافدةٍ","من المدائح فازت قبلما سألت",5,"ت",1,0],["سل علمه عن خفيَّاتٍ محجَّبةٍ","وعن إحاطة أوصافٍ فلا تسل",6,"ل",1,0],["سَل عَلَيهِ سَيفَهُ وَرايَه","فَلم تَقف لابن عَليٍّ رايه",7,"ه",1,0],["سَل عُصبَةَ الشِركِ حَولَ الغارِ سائِمَةً","لَولا مُطارَدَةُ المُختارِ لَم تُسَمَ",8,"م",1,0],["سَل عَن شَجاعَتِهِ وَزُرهُ مُسالِماً","وَحَذارِ ثُمَّ حَذارِ مِنهُ مُحارِبا",9,"ب",2,0],["سِلْعَةٌ ما لِمَنْ يحاولُ حِرْزٌ","حَيَّةٌ ما لِمَنْ يُساوِرُ راقي",10,"ق",2,0],["سَل عَنِ التيجانِ وَاِنظُر هَل تَرى","فيهِ شَيئاً مِن عُروشِ المالِكينْ",11,"ن",1,0],["سَل عن سُهادي وعن سُقمي وعن جَلَدِي","كُلَّ النُّجُومِ التَّي مَثنَى وَمُنفَرِدِ",12,"د",1,1],["سَل عَنهُ قيلاً صُرِعوا بِشَيزَرا","وَآخَراً وَآخَراً وَآخَرا",13,"ر",2,0],["سَل عَنهُ كُلَّ كَدَّةٍ وَحَجرِ","في طَبَرِستانَ وَوادٍ وَعرِ",13,"ر",1,0],["سَلْ عَالَمَ المَلكُوتِ عنهُ فَخيرُ ما","سأَلَ الخَبِيرُ عَنِ الجَليلِ جَليلا",14,"ل",2,0],["سَلْ عنه وَاسْأَلْ عَنْ أبيهِ وجَدِّهِ","تَسْمَعْ أحاديثَ الكرامِ مُسَلْسَلَهْ",15,"ل",2,0],["سل عَن القوم دارسات طلول","تَرَكوها تخبر الأخبارا",16,"ر",2,0],["سَلَعٌ ما وَمِثلُهُ عَشَرٌ ما","عائِلٌ ما وَعالَت البَيقورا",17,"ر",2,0],["سَلْ عَنِّيَ الْمَجْدَ وَلا تَحْتَشِمْ","فَالْمَجْدُ يَدْرِي أَيَّ سَيْفٍ نَضَا",18,"ض",2,0],["سَلْ عَارِفِيهِ تَدْرِ مَا شَأْنُه","إِنْ يُرْجَ فَضْلٌ أَوْ يُخَفْ ضُرُّ",19,"ر",1,0],["سل عروة بن حزام عن غصص الهوى","تسمع جواب فتى الغرام العاني",20,"ن",2,0],["سلْ عن قديم هوايَ هذا الوادي","هل كان يخفق فيه غير فؤادي",21,"د",2,1],["سَلْ عن الحبِّ، والوِدَاد الصُّراح","إن هما أعوزَاكَ شعرَ الماحي",22,"ح",2,1],["سل عن تشرشل كيف جاذبه الهوى","حتى استثار كوامن الأحقاد",23,"د",1,0],["سل عنهما صادة الأسماك هل سمعوا","في فحمة الليل مثلي رنة القبل",24,"ل",1,0],["سل عنه كتْب العلم إن تكُ في مرا","تنبيك عن هذا بصدقِ يقينِ",25,"ن",1,0],["سَل عَن فَضائِلِكَ الزَمانَ لِتُخبَرا","فَنَظيرُ مَجدِكَ ما رَآهُ وَلا يَرا",26,"ر",2,1],["سَل عِلمَكَ الجَمَّ عَنّي فَهوَ يُخبِرُني","يُخبِركَ أَنّي لِسانٌ وَالزَمانُ فَمُ",27,"م",1,0],["سل عنه عُبَّاد الصليب تسل به","غرض المذلة موثقا ومجدلا",28,"ل",2,0],["سَل عَنهُ يَومَ أَغارَت في كَتائِبِها","خَيلُ القَطيفِ مِنَ القَرحا إِلى الجَبَلِ",29,"ل",1,0],["سَل عَنهُ غَداةَ الصَخرِ وَقَد","جاءَت تَتَبارى في اللُجُمِ",30,"م",1,0],["سلعا تباع وتشترى","علنا بأسواق الحواضر",31,"ر",1,0],["سل عن فِعَالي الراحَ والصحوَ والسُكْرا","وعن راحتي الجَدْوَى وعن همَّتِي الدهرا",32,"ر",2,1],["سَل عَن مَواقِعِهِ الكَتائِبِ في الوَغى","يُخبِرنَ عَن كُتُبٍ لَهُ وَرَسائِلِ",33,"ل",1,0],["سَل عَنِ الماضينَ إِن نَطَقَت","عَنهُمُ الأَجداثُ وَالبِرَكُ",34,"ك",1,1],["سَل عنه مسعوداً ويا","قوتاً ورَيحاناً وعنبر",35,"ر",1,0],["سَل عنه وأرحَل نحوه تُنجِح ولا","تَسأل عن التَثليث والتربيعِ",36,"ع",1,0],["سل عنه أهل جبال نابُلُسٍ فكم","ذاقوا عذاباً في الحروب أليما",37,"م",2,0],["سَل عَن تبابعةٍ عظامٍ مأرِبا","فهنالكَ السدُّ المحدِّثُ عن سَبا",38,"ب",2,1],["سل عنه ذرات الوجود فانها","تدعوه معبودا لها رباه",39,"ا",2,0],["سَلْ عَنْ ظُباهُ مَشارِقاً ومَغارِباً","تُنْبِئْكَ عَنْ إغْمَادِها في الْهامِ",40,"م",1,0],["سَلْ عَنْ مَغازِيه البِلادَ وأَهْلَها","يُنْبِئْك عن سَرْدِ الفُتوحِ خَبيرُ",41,"ر",1,0],["سَل عَن فُؤادي بِسَلع مَن كلفتُ بِهِم","لم أَسكنوهُ وَهم أَلقَوهُ في النارِ",42,"ر",1,0],["سَل عَن فُؤادي بِسلعٍ أَيّةً ذَهَبا","وَعُج بِها تَرَ مِن سُكّانِها عَجَبا",43,"ب",2,1],["سل عنهم إِن غابوا","وزرهم إِن آبوا",44,"ب",3,0],["سَل عنه خَيبرَ يَومَ نازَلَها","تُنبيكَ عن خَبَرٍ وعن خُبرِ",45,"ر",1,0],["سَل عن فؤادِك حين طاشَ بك الهَوى","إِن كنتَ تملِكُ في الغَرام فؤادا",46,"د",2,1],["سَل عَن دَمي عندما تَلقاك مُسفرة","تُخبِركَ عنه الخدودَ العَندِميّاتُ",47,"ت",1,0],["سل عنه عشاق الكمال فإنه","بنفائس الخلق الكريم تقلّدا",48,"د",2,0],["سَل عَنهُ أَرخِمَةً بيضاً وَأُغرِبَةً","سوداً لَهُنَّ حَنى أَطمى سَلاهيبُ",49,"ب",1,0],["سل عَنّي اللَيل الطَويل فَاِنَّهُ","أَدرى بِما فِعل الغَرام وَأَخبر",50,"ر",1,0],["سلَّ عَلى الأُمة من طَرفِهِ","سَيفَ علي بن أَبي طالبِ",51,"ب",1,0],["سلْ عنه أرضك حين لم تترك له","أثراً ، ولا للصوت منه سميعا",52,"ع",2,0],["سل عن سعاد فعندها","يا سعد إنصافي وظلمي",53,"م",2,0],["سل عنهم صرف الزّمان فإنه","بهم من الدار المحيلة أعلم",54,"م",1,0],["سلْ عن براعتِه جاري يراعتِه","تُجْر الفصاحةَ من ألفاظِ خرساء",55,"ا",2,0],["سل عنهم كم أراقوا من دم هدرٍ","في حبّهم بعد إيعاد وإبعاد",56,"د",1,0],["سل عابد النار هل أغنت عبادته","عن عرشه حين جاء الجحفل اللجب",57,"ب",1,0],["سل عن فؤادك بين منعقِد اللوى","والنَّعفِ قبلَ تشعُّب الأظعانِ",58,"ن",1,1],["سل عنه قلب الانكتير فإن في","خفقانه ما شئت من أبنائه",59,"ه",1,1],["سل عن زياد وابنه وارجع إلى","عمروٍ فسل هل عاش بعد سعيد",60,"د",1,0],["سل عن فعالهم يومي فدى ووغى","ليخبرَ المحلُ والخطيةُ الذبُل",61,"ل",1,0],["سل عنه في بذل المكارم والقرى","واسمع من الغدوات والآصال",62,"ل",1,0],["سل عنه إذ لفَّ القناة غدا","ة السعد منهُ بساعدٍ عبل",63,"ل",1,0],["سَلْ عَن أُهَيْلِكَ هَل غَصَّتْ مَحافِلُهُم","وَلَم تَكُ القَلبَ مِمَّا قيلَ أو كُتِبا",64,"ب",2,0],["سل عنه عن زمَّ صرعاً كل صافنةٍ","وكلَّ ملتثمٍ من فارسٍ بطل",65,"ل",1,0],["سلْ عنهُ ياسينا وطهَ والضُحى","إنْ كُنتَ لم تَعلَمْ حَقيقةَ شانهِ",66,"ن",2,0],["سلْ عن أوانِسِ بَيضِهِ قمرَ الدُجى","فعساهُ يُرشدُنا إلى أخَواتِهِ",67,"ت",2,0],["سَلْ عَنْهُ هَلْ طابَتْ لَهُ","يا رِيمُ رَامَةُ أَرْضِ صَنْعا",68,"ع",2,0],["سَلْ عَنْهُ أَنْواعَ الْعُلُومِ فإِنَّها","تَأْتِيكَ منْ أَوْصافِهِ بِعَدِيدِ",69,"د",1,0],["سَلْ عنِّيَ الأبطالَ إذْ عمّمتُهم","بقواضبي بدلاً من التّيجانِ",70,"ن",1,0],["سَلْ عَن صُخوري مَن كان يقرعها","وَعن قنات