كور","https://www.poetsgate.com/ViewPoem.aspx?id=121576",""],[5320,"رائد الأعلام","https://www.poetsgate.com/ViewPoem.aspx?id=40898",""],[5338,"معارضة قصيدة بات سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=187941",""],[5397,"لا تسألن معالم الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=157918",""],[5397,"ما لهذا الدهر في الغي تمادى","https://www.poetsgate.com/ViewPoem.aspx?id=157914",""],[5409,"وطني لأجلك قد عدمت قراري","https://www.poetsgate.com/ViewPoem.aspx?id=155272",""],[5409,"للحر بطن الأرض أجدى","https://www.poetsgate.com/ViewPoem.aspx?id=155492",""],[5443,"واطُولَ صَبرِي!","https://www.poetsgate.com/ViewPoem.aspx?id=185149",""],[5502,"إن كنت تبحث عن تراث عمان","https://www.poetsgate.com/ViewPoem.aspx?id=124955",""],[5563,"عبثٌ بنكهتي الفصيح والنبطي","https://www.poetsgate.com/ViewPoem.aspx?id=212679",""],[5582,"طَيْفٌ سَرَى وَثِيابُ اللَّيْلِ أَخْلاقُ","https://www.poetsgate.com/ViewPoem.aspx?id=63545",""],[5690,"دع عنك تشبيباً بوصف محاجرِ","https://www.poetsgate.com/ViewPoem.aspx?id=172161",""],[5720,"شُّكُوك","https://www.poetsgate.com/ViewPoem.aspx?id=204503",""],[6102,"بين كلابها وحجاجها ..","https://www.poetsgate.com/ViewPoem.aspx?id=182808",""],[6142,"يا فاتحا مغلق الأمصار أجمعها","https://www.poetsgate.com/ViewPoem.aspx?id=155743",""],[6142,"سل عنه سلعا لدن ضاق الخناق بها","https://www.poetsgate.com/ViewPoem.aspx?id=155715",""],[454,"إن العروبة بالإسلام عزتها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82660&r=&rc=24",""]],"verses":[["سَل عَنِ الطَيِّباتِ فَهِيَ فُنونٌ","أُلِّفَت فِيَّ أَحسَنَ التَأليفِ",0,"ف",1,0],["سلْ عنهمُ أُحُداً وبدراً تلقَهُمْ","أَهلَ الغَناء بها وأهلَ المغنمِ",1,"م",1,0],["سل عنه طوسند إذ سُدّت مسالكه","فظلّ في الكوت يشكو بالطوى ألما",2,"م",2,0],["سل عن معاركه طرابلس التي","قد كان فيها شعلة من نار",3,"ر",1,0],["سل عن مقاميَ والرؤوس حوائمٌ","تحت العجاجة والنسور وقوع",4,"ع",1,1],["سل عن عطاياهُ تسأل كلّ وافدةٍ","من المدائح فازت قبلما سألت",5,"ت",1,0],["سل علمه عن خفيَّاتٍ محجَّبةٍ","وعن إحاطة أوصافٍ فلا تسل",6,"ل",1,0],["سَل عَلَيهِ سَيفَهُ وَرايَه","فَلم تَقف لابن عَليٍّ رايه",7,"ه",1,0],["سَل عُصبَةَ الشِركِ حَولَ الغارِ سائِمَةً","لَولا مُطارَدَةُ المُختارِ لَم تُسَمَ",8,"م",1,0],["سَل عَن شَجاعَتِهِ وَزُرهُ مُسالِماً","وَحَذارِ ثُمَّ حَذارِ مِنهُ مُحارِبا",9,"ب",2,0],["سِلْعَةٌ ما لِمَنْ يحاولُ حِرْزٌ","حَيَّةٌ ما لِمَنْ يُساوِرُ راقي",10,"ق",2,0],["سَل عَنِ التيجانِ وَاِنظُر هَل تَرى","فيهِ شَيئاً مِن عُروشِ المالِكينْ",11,"ن",1,0],["سَل عن سُهادي وعن سُقمي وعن جَلَدِي","كُلَّ النُّجُومِ التَّي مَثنَى وَمُنفَرِدِ",12,"د",1,1],["سَل عَنهُ قيلاً صُرِعوا بِشَيزَرا","وَآخَراً وَآخَراً وَآخَرا",13,"ر",2,0],["سَل عَنهُ كُلَّ كَدَّةٍ وَحَجرِ","في طَبَرِستانَ وَوادٍ وَعرِ",13,"ر",1,0],["سَلْ عَالَمَ المَلكُوتِ عنهُ فَخيرُ ما","سأَلَ الخَبِيرُ عَنِ الجَليلِ جَليلا",14,"ل",2,0],["سَلْ عنه وَاسْأَلْ عَنْ أبيهِ وجَدِّهِ","تَسْمَعْ أحاديثَ الكرامِ مُسَلْسَلَهْ",15,"ل",2,0],["سل عَن القوم دارسات طلول","تَرَكوها تخبر الأخبارا",16,"ر",2,0],["سَلَعٌ ما وَمِثلُهُ عَشَرٌ ما","عائِلٌ ما وَعالَت البَيقورا",17,"ر",2,0],["سَلْ عَنِّيَ الْمَجْدَ وَلا تَحْتَشِمْ","فَالْمَجْدُ يَدْرِي أَيَّ سَيْفٍ نَضَا",18,"ض",2,0],["سَلْ عَارِفِيهِ تَدْرِ مَا شَأْنُه","إِنْ يُرْجَ فَضْلٌ أَوْ يُخَفْ ضُرُّ",19,"ر",1,0],["سل عروة بن حزام عن غصص الهوى","تسمع جواب فتى الغرام العاني",20,"ن",2,0],["سلْ عن قديم هوايَ هذا الوادي","هل كان يخفق فيه غير فؤادي",21,"د",2,1],["سَلْ عن الحبِّ، والوِدَاد الصُّراح","إن هما أعوزَاكَ شعرَ الماحي",22,"ح",2,1],["سل عن تشرشل كيف جاذبه الهوى","حتى استثار كوامن الأحقاد",23,"د",1,0],["سل عنهما صادة الأسماك هل سمعوا","في فحمة الليل مثلي رنة القبل",24,"ل",1,0],["سل عنه كتْب العلم إن تكُ في مرا","تنبيك عن هذا بصدقِ يقينِ",25,"ن",1,0],["سَل عَن فَضائِلِكَ الزَمانَ لِتُخبَرا","فَنَظيرُ مَجدِكَ ما رَآهُ وَلا يَرا",26,"ر",2,1],["سَل عِلمَكَ الجَمَّ عَنّي فَهوَ يُخبِرُني","يُخبِركَ أَنّي لِسانٌ وَالزَمانُ فَمُ",27,"م",1,0],["سل عنه عُبَّاد الصليب تسل به","غرض المذلة موثقا ومجدلا",28,"ل",2,0],["سَل عَنهُ يَومَ أَغارَت في كَتائِبِها","خَيلُ القَطيفِ مِنَ القَرحا إِلى الجَبَلِ",29,"ل",1,0],["سَل عَنهُ غَداةَ الصَخرِ وَقَد","جاءَت تَتَبارى في اللُجُمِ",30,"م",1,0],["سلعا تباع وتشترى","علنا بأسواق الحواضر",31,"ر",1,0],["سل عن فِعَالي الراحَ والصحوَ والسُكْرا","وعن راحتي الجَدْوَى وعن همَّتِي الدهرا",32,"ر",2,1],["سَل عَن مَواقِعِهِ الكَتائِبِ في الوَغى","يُخبِرنَ عَن كُتُبٍ لَهُ وَرَسائِلِ",33,"ل",1,0],["سَل عَنِ الماضينَ إِن نَطَقَت","عَنهُمُ الأَجداثُ وَالبِرَكُ",34,"ك",1,1],["سَل عنه مسعوداً ويا","قوتاً ورَيحاناً وعنبر",35,"ر",1,0],["سَل عنه وأرحَل نحوه تُنجِح ولا","تَسأل عن التَثليث والتربيعِ",36,"ع",1,0],["سل عنه أهل جبال نابُلُسٍ فكم","ذاقوا عذاباً في الحروب أليما",37,"م",2,0],["سَل عَن تبابعةٍ عظامٍ مأرِبا","فهنالكَ السدُّ المحدِّثُ عن سَبا",38,"ب",2,1],["سل عنه ذرات الوجود فانها","تدعوه معبودا لها رباه",39,"ا",2,0],["سَلْ عَنْ ظُباهُ مَشارِقاً ومَغارِباً","تُنْبِئْكَ عَنْ إغْمَادِها في الْهامِ",40,"م",1,0],["سَلْ عَنْ مَغازِيه البِلادَ وأَهْلَها","يُنْبِئْك عن سَرْدِ الفُتوحِ خَبيرُ",41,"ر",1,0],["سَل عَن فُؤادي بِسَلع مَن كلفتُ بِهِم","لم أَسكنوهُ وَهم أَلقَوهُ في النارِ",42,"ر",1,0],["سَل عَن فُؤادي بِسلعٍ أَيّةً ذَهَبا","وَعُج بِها تَرَ مِن سُكّانِها عَجَبا",43,"ب",2,1],["سل عنهم إِن غابوا","وزرهم إِن آبوا",44,"ب",3,0],["سَل عنه خَيبرَ يَومَ نازَلَها","تُنبيكَ عن خَبَرٍ وعن خُبرِ",45,"ر",1,0],["سَل عن فؤادِك حين طاشَ بك الهَوى","إِن كنتَ تملِكُ في الغَرام فؤادا",46,"د",2,1],["سَل عَن دَمي عندما تَلقاك مُسفرة","تُخبِركَ عنه الخدودَ العَندِميّاتُ",47,"ت",1,0],["سل عنه عشاق الكمال فإنه","بنفائس الخلق الكريم تقلّدا",48,"د",2,0],["سَل عَنهُ أَرخِمَةً بيضاً وَأُغرِبَةً","سوداً لَهُنَّ حَنى أَطمى سَلاهيبُ",49,"ب",1,0],["سل عَنّي اللَيل الطَويل فَاِنَّهُ","أَدرى بِما فِعل الغَرام وَأَخبر",50,"ر",1,0],["سلَّ عَلى الأُمة من طَرفِهِ","سَيفَ علي بن أَبي طالبِ",51,"ب",1,0],["سلْ عنه أرضك حين لم تترك له","أثراً ، ولا للصوت منه سميعا",52,"ع",2,0],["سل عن سعاد فعندها","يا سعد إنصافي وظلمي",53,"م",2,0],["سل عنهم صرف الزّمان فإنه","بهم من الدار المحيلة أعلم",54,"م",1,0],["سلْ عن براعتِه جاري يراعتِه","تُجْر الفصاحةَ من ألفاظِ خرساء",55,"ا",2,0],["سل عنهم كم أراقوا من دم هدرٍ","في حبّهم بعد إيعاد وإبعاد",56,"د",1,0],["سل عابد النار هل أغنت عبادته","عن عرشه حين جاء الجحفل اللجب",57,"ب",1,0],["سل عن فؤادك بين منعقِد اللوى","والنَّعفِ قبلَ تشعُّب الأظعانِ",58,"ن",1,1],["سل عنه قلب الانكتير فإن في","خفقانه ما شئت من أبنائه",59,"ه",1,1],["سل عن زياد وابنه وارجع إلى","عمروٍ فسل هل عاش بعد سعيد",60,"د",1,0],["سل عن فعالهم يومي فدى ووغى","ليخبرَ المحلُ والخطيةُ الذبُل",61,"ل",1,0],["سل عنه في بذل المكارم والقرى","واسمع من الغدوات والآصال",62,"ل",1,0],["سل عنه إذ لفَّ القناة غدا","ة السعد منهُ بساعدٍ عبل",63,"ل",1,0],["سَلْ عَن أُهَيْلِكَ هَل غَصَّتْ مَحافِلُهُم","وَلَم تَكُ القَلبَ مِمَّا قيلَ أو كُتِبا",64,"ب",2,0],["سل عنه عن زمَّ صرعاً كل صافنةٍ","وكلَّ ملتثمٍ من فارسٍ بطل",65,"ل",1,0],["سلْ عنهُ ياسينا وطهَ والضُحى","إنْ كُنتَ لم تَعلَمْ حَقيقةَ شانهِ",66,"ن",2,0],["سلْ عن أوانِسِ بَيضِهِ قمرَ الدُجى","فعساهُ يُرشدُنا إلى أخَواتِهِ",67,"ت",2,0],["سَلْ عَنْهُ هَلْ طابَتْ لَهُ","يا رِيمُ رَامَةُ أَرْضِ صَنْعا",68,"ع",2,0],["سَلْ عَنْهُ أَنْواعَ الْعُلُومِ فإِنَّها","تَأْتِيكَ منْ أَوْصافِهِ بِعَدِيدِ",69,"د",1,0],["سَلْ عنِّيَ الأبطالَ إذْ عمّمتُهم","بقواضبي بدلاً من التّيجانِ",70,"ن",1,0],["سَلْ عَن صُخوري مَن كان يقرعها","وَعن قناتي اِمرءاً لها عَجَما",71,"م",2,0],["سلْ عنهمُ إنْ كنتَ لا تعرفُهمْ","سَلَّ الظُّبا وشُرَّعَ العواملِ",72,"ل",1,0],["سَلْ عن ضِرابي وَعَن طَعني لدَى رَهَجٍ","نحرَ الكميِّ وهاماتِ الكراديسِ",73,"س",1,0],["سَلْ عَن بَسالتِهِ خفاجَةَ والظّبا","في راحتيهِ تُعطّ كلَّ إهابِ",74,"ب",1,0],["سَل عَيشَ دَهرٍ قَد مَضَت أَيّامُهُ","هَل يَستَطيعُ إِلى الرُجوعِ سَبيلا",75,"ل",2,0],["سَلْ عَفْوَهُ وحُسَامُهُ في غِمْدِهِ","وحَذَارِ ثُمَّ حَذَارِ مِنْ تَجْرِيدِهِ",76,"د",2,0],["سَل عنه مصر بل الامصار قاطبة","تنبئك عن عَلم فوق السهى ارتفعا",77,"ع",2,0],["سَل عَنهُ عُثمانَ القَديمِ وَإِن تَمَل","لِزِيادَةٍ فَاِعطِف عَلى أَرخانِ",78,"ن",1,0],["سَل عنهُ إيران إنّها شَكرت","له أيادٍ في السرّ والعلنِ",79,"ن",1,0],["سَل عنه إيران ماذا منه قد شَهِدَت","وَهل رَأَت منه إلّا طيّب الأثرِ",80,"ر",1,0],["سَل عَن نَداه البَريَّهْ",