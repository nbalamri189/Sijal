افَحتُ أَطرافَ القَنا وَالصَوارِمِ",0,"م",1,0],["وَفيمَنْ يَستَضيءُ بِها","فَتاةٌ صَلْتَةُ الخَدِّ",1,"د",1,0],["وَفيَّ مِنَ الفَضلِ الّذِي لَوْ ذَكَرْتُهُ","كَفانِيَ أَنْ أُزْهَى بِجَدٍّ وَوالِدِ",2,"د",1,0],["وفي مَنْشِطِ الرِّمْثِ عُذْريّةٌ","أبَتْ قُضُبُ الهِنْدِ أنْ تُجْتَلى",3,"ا",1,0],["وفي مَباسِمِها لي ما يُتابِعُهُ","بِراحَتَيْكَ المُلوكُ الصِّيدُ مِنْ قُبَلِ",4,"ل",1,0],["وفيَّ منْ شِيَمِ الضِّرْغامِ جُرأَتُهُ","إذا أرابَتْكَ أخْلاقٌ منَ الذّيبِ",5,"ب",1,0],["وفي مَزْيَدٍ منْ بَعْدِ رَيّانَ مَفْخَرٌ","لَوى عَنْ مَداهُ ساعِدَ النّجْمِ أجْذَما",6,"م",2,0],["وفي مِدْرَعي ماجِدٌ لا يَحومُ","على نُغَبٍ كَدِراتٍ صَداهْ",7,"ا",2,0],["وفيمَنْ خَلَّفوا أسْآرَ حَرْبٍ","كأُسْدِ الغابِ تقتحِمُ المَصالا",8,"ل",2,0],["وَفِي مُنَاهَا تَمَنَّيتُ الْمُنَى فَغَدا","قَلْبِي كَئِيباً بِبَلْوَاهُ يُنَاجِينِي",9,"ن",2,0],["وَفِيمَا رَوَاهُ النَّاقِلُونَ وَأَثْبَتُوا","بِذَاكَ دِيوَاناً صَحِيحاً فَدِيوَانَا",10,"ن",2,0],["وَفيمَ أَنِفتَ مِن تَعليلِ صَبٍّ","صَحيحِ الوُدِّ ذي جِسمٍ عَليلِ",11,"ل",1,0],["وَفيمَ الهَوى مَحضٌ يَشِفُّ صَفاؤُهُ","إِذا لَم يَكُن مِنهُنَّ عَنهُ ثَوابُ",12,"ب",1,0],["وَفيمَن أَقامَ عَنِ الحَيِّ هِرّ","أَمِ الظاعِنونَ بِها في الشُطُر",13,"ر",1,0],["وَفِي مَعَانِيكَ مِنْ أَرْوَاحِ جَنَّتِهِ","أَشْفَى النُّسَيْمَاتِ لِلأَرْوَاحِ وَالنَّسَمِ",14,"م",1,0],["وَفي مَواليكَ لِلمَحزونِ مَشغَلَةٌ","مِن أَن تَبيتَ لِمَفقودٍ عَلى أَثَرِ",15,"ر",1,0],["وفي موت خير الخلق أكبرُ أسوة","تُصبِّر أحرار النفوس وتُسْليها",16,"ي",3,0],["وفي مثل هذا اليوم في حفرة البلى","جعلنا بك الآمال مدفونة هنّا",17,"ن",2,0],["وَفى مالِكٌ لِلجارِ لَمّا تَحَدَّبَت","عَلَيهِ الذُرى مِن وائِلٍ وَالغَلاصِمِ",18,"م",1,0],["وَفي مَعنٍ وَإِخوَتِهِم تُلاقي","رِباطَ الخَيلِ وَالأَسَلَ الحِدادا",19,"د",2,0],["وَفيمَ اِبنُ ذي الكيرَينِ مِن بَيتِ خالِدٍ","وَهَل يَجمَعُ البَيتُ الخَنانيصَ وَالنَحلا",20,"ل",2,0],["وَفي مُخدَعٍ مِنهُ النَوارُ وَشَربُهُ","وَفي مُخدَعٍ أَكيارُهُ وَمَراجِلُه",21,"ل",2,0],["وَفيمَ عَدِيٌّ عِندَ تَيمٍ مِنَ العُلى","وَأَيّامِنا اللاتي يُعَدُّ فَعالُها",22,"ل",3,0],["وَفيمَن سِواهُم مِن مُلوكٍ وَسوقَةٍ","دَعائِمُ عَرشٍ خانَهُ الدَهرُ فَاِنقَعَر",23,"ر",1,0],["وَفي مَنبِجٍ مَن رِضا","هُ أَنفَسُ ما أَذخَرُ",24,"ر",1,0],["وَفيمَن حَوى ذاكَ الحَجيجُ خَريدَةٌ","لَها دونَ عَطفِ السَترِ مِن صَونِها سِترُ",25,"ر",1,0],["وَفيما اِشتَهَوا مِن عَصيرِ القِطافِ","وَعَيشٍ رَخِيِّ عَلى غَيرِ هَمّ",26,"م",1,0],["وفي منًى جمراتٌ ما لها ثمن","لكن لها في حشا الشياطين تسعير",27,"ر",1,0],["وفي مُستماحي العرفِ بارقُ خُلَّبٍ","ولامعُ رقراقٍ ونارُ حُباحبِ",28,"ب",1,0],["وفي موقف المرء عن حاجة","تيممها شاغل قاطع",29,"ع",1,0],["وفيما بين مَطلِك واختلالي","يموت بدائه الرجلُ الهزيل",30,"ل",1,0],["وَفِيَّ مَعَ الشَيبِ المُلِمِّ بَقِيَّةٌ","تُجَدِّدُ عِندي هِزَّةً وَتَطَرُّبا",31,"ب",2,0],["وفي مصر يلقى الصدق كل حفاوة","ويلقى رجال الصدق في مصر تقديرا",32,"ر",2,0],["وَفي مَقدَمِها بوقٌ","وَفي المُؤخِرِ زَمّارَه",33,"ر",2,0],["وَفيمَ تَحَمَّلَ هَمَّ القَريبِ","مِنَ المُسلِمينَ وَهَمَّ البَعيد",34,"د",1,0],["وَفيمَ يَكيدُ بَعضُكُمُ لِبَعضٍ","وَتُبدونَ العَداوَةَ وَالخِصاما",35,"م",2,0],["وَفيَّ ما قارَعَ الخُطوبَ وَما","آنَسَني بِالمَصائِبِ السودِ",36,"د",1,0],["وَفي مَوقِفٍ ما لَنا بَعدَهُ","تَنازُعُ نَجوى وَلا مُعتَلَج",37,"ج",1,0],["وَفيمَ اِبنُ بَحرٍ مِن قِلاصِ أَشَذَّها","بِسَيفَينِ أَغشى رَأسَهُ لَم يُعَمَّمِ",38,"م",1,0],["وَفي مَيدانِنا فُرسانُ لَهوٍ","كُماةٌ في المَجالِسَ لا القِفارِ",39,"ر",1,0],["وَفي مَجلِسِنا شَمسٌ","تَوَلّى حَملَها بَدرُ",40,"ر",1,0],["وَفي مَعرَكِ الآدابِ كَم لَكَ مَوقِفٌ","لِأَهلِ الحِجى مِنهُ مُقيمٌ وَمُقعَدُ",41,"د",1,0],["وفيم هواجس القلب","وفيم أطيل تسآلي",42,"ي",1,0],["وفي مكانٍ ليس في","بالٍ جَرى خَبأتها",43,"ت",3,0],["وفيم لذعة سخطٍ من جوى برمٍ","ترمي بجمرته في جوف مضطرم",44,"م",1,0],["وفي مغنى ابنِ عبّادٍ حَلَلْنا","وقد نِلنا المنى عند العَزيمِ",45,"م",1,0],["وَفي مَدِّ أَنفاسي لَدَيَّ وجَزرِها","بقاءٌ لنفسٍ غَيرِ متُصّل الحبلِ",46,"ل",1,0],["وَفي مُضمَرِ الظلماءِ كالِئُ ظَبيَةٍ","بِثَعلَبةٍ يُسقى بها المَوتَ رِئبالُ",47,"ل",1,0],["وَفِيمَ وَقَدْ بَلَوْتُ الدَّهْرَ أَبْغِي","صَدِيقاً أَوْ أَحِنُّ إِلَى مَكَانِ",48,"ن",1,0],["وَفي مُصطَلى الآفاقِ جَمرُ كَواكِبٍ","عَلاها مِنَ الفَجرِ المُطِلِّ رَمادُ",49,"د",1,0],["وَفي مِصرَ شَعبٌ دَهاهُ القَضاءُ","فَلَم يَدرِ شَيئاً وَلَم يَعلَمِ",50,"م",1,0],["وفي مَواطَنَ شَتى كَمْ أتاكَ بها","نَصْرٌ مِنَ اللهِ مَضْمُونٌ وَمَكْفُولُ",51,"ل",1,0],["وفيما اصطلوا من حرّ بأسك واعظٌ","وفيما أُذيقوا من عذابكَ تأديب",52,"ب",1,0],["وفيما طوله شبرٌ","وقد يربى على الشبرِ",53,"ر",1,0],["وفي مثل غزلانٍ فضلِ الربيع","عذاركَ فاخلعهُ ثم اخلع",54,"ع",1,0],["وَفيمَ ذاكَ وَلا في العيرِ عِدَّتُهُ","وَلا النَفيرُ وَلا إِن ماتَ يُفتَقَدُ",55,"د",1,0],["وَفيمَ أَنا مِن عَبدَ","ةَ لَولا ما تَرَجَّيتُ",56,"ت",1,0],["وَفي مُهَجِ الأَنيسِ مُثَلِّثاتٌ","عَلى عِلّاتِها وَمُوَحِداتُ",57,"ت",1,0],["وَفي مَزيجِ الراحِ أَو في صَريحِ ال","رِسلِ وَالعامُ جَديبٌ عَبَبنَ",58,"ن",1,0],["وفي مَسَارحِ غِزْلاَنِ الخمائلِ في","بَرْدِ الأصائلِ والإِصباحِ في البلَجِ",59,"ج",1,0],["وفي مَساقط أنْداء الغَمامِ على","بِساط نَوْر من الأَزهارِ مُنْتَسِجِ",59,"ج",1,0],["وفي مساحِب أذيالِ النّسيم إذا","أهْدى إليّ سُحَيْراً أطيَبَ الأرَجِ",59,"ج",1,0],["وَفي مصر آداب وتلك ثمارها","لأبناء مصر ثم للعرب الفخر",60,"ر",1,0],["وفيمَ تُجزى وهيَ لم تأثمِ","ألستَ أنت الصائغَ الطابعا",61,"ع",2,0],["وفيمَ نُرَقِّشُ هذا الجناحَ","ونصقلُه ببنانِ النعيمْ",62,"م",1,0],["وفي منامكَ والآفاقُ حالمةٌ","وفي نتباهك والظلماءُ إصغاء",63,"ا",2,0],["وفيم تُضيءُ الشمسُ أو يشرق السَّنى","إذا الأرضُ غشَّاها ضَلالٌ ومأثمُ",64,"م",1,0],["وفيمَ دعاة السَّلْمِ طال حديثهمْ","على غير معنىً من رِضىً وأمانِ",65,"ن",1,0],["وفي مَضْحَكِ البَرْقِ التّهاميّ جِيرَةٌ","يَسَرْنَ بحُسْنٍ واتّفَقْنَ على سَهْم",66,"م",1,0],["وَفِي مِحْجَرَيْهِ بَرِيقُ السُّيُو","فِ وَظِلُّ المَنِيَّةِ فِي الأُثْمُدِ",67,"د",1,0],["وَفِي مِصْرَ مُنْتَجَعَاتٌ بِهَا","شَفَاءُ الصُّدُورِ وَدَرْءُ الْغِيَرْ",68,"ر",1,0],["وَفِي مِصْرَ شَعْبٌ مَائِجٌ فِي رِحَابِكُمْ","تَقَاطَرَ يَتْلُو وَافِداً مِنْهُ وَافِدُ",69,"د",1,0],["وَفِي مَجْلِسِ النُوُّابِ هَلْ سَارَ سَيْرَهُ","أَخُو مِرَّةٍ جَلْدٌ عَنِ الجَهْدِ لاَ يَأْلُوا",70,"ل",3,0],["وفيم أتيتِ؟ ما تبغين عندي؟","وهل عندي سوى ح