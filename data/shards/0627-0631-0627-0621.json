{"poems":[[74,"كفوا حديث العذل عن مسمعي","https://www.aldiwan.net/poem19170.html","السريع"],[53,"يا كائنا بين أوعاث وأوعار","https://www.aldiwan.net/poem62972.html","البسيط"],[53,"عيد يطابق أول الأسبوع","https://www.aldiwan.net/poem65060.html","الكامل"],[438,"وعسكري كلما رمته","https://www.aldiwan.net/poem12776.html","السريع"],[458,"","https://poetry.dctabudhabi.ae/diwan/poem/143128","الكامل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121185","الطويل"],[5309,"آراء اخواني بكم وحدتها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573682",""]],"verses":[["آراء عمرٍو ولهى حاتمٍ","وحلو قيسٍ وذكا الأصمعي",0,"ع",2,0],["آراء صدقٍ أتى التوفيق خِيرتَها","في موقف بين إيراد وإصدار",1,"ر",1,0],["آراءُ داهيةٍ بعيدٍ غورُهُ","ولُهَى قريبٍ مُستقاهُ نَزوع",2,"ع",1,0],["آراءُ قلبي منه خفّاقةٌ","كأنها من بعضِ راياتِه",3,"ت",2,0],["آراء جبار وحكمة كاهن","وكتاب إعجاز يشع مديلا",4,"ل",2,0],["آراء حصول الشمس والبدر فاحمد","فانهما البدران يهنيك فاشهد",5,"د",1,1],["آراءُ إِخواني بِكم وَحَّدتُها","وَأَخَذتُ عَنكُم حِكمَةً فَوَعَيتُها",6,"ا",1,1]]}