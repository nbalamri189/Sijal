{"poems":[[51,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[51,"كنز الله في كنيزة نتنا","https://www.aldiwan.net/poem64718.html","البسيط"],[51,"يا حسن الوجه والشمائل","https://www.aldiwan.net/poem65926.html","المنسرح"],[51,"خلياني عند اصطكاك الخصومِ","https://www.aldiwan.net/poem66322.html","الطويل"],[85,"قال السلوقي مرة للجواد","https://www.aldiwan.net/poem8046.html","السريع"],[45,"قلت للائم في الحب أفق","https://www.aldiwan.net/poem65180.html","الرمل"],[69,"قال بعض الناس إني","https://www.aldiwan.net/poem28023.html","مجزوء الرمل"],[105,"رحمة يا أبا بصير ونعمى","https://www.aldiwan.net/poem44063.html","الرمل"],[105,"نهضت من كل أوب تلتقي","https://www.aldiwan.net/poem44200.html","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54712","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[106,"الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=179448",""],[50,"وذات دل كأن البدر صورتها","https://www.poetsgate.com/ViewPoem.aspx?id=15754",""],[108,"كان يوم","https://www.poetsgate.com/ViewPoem.aspx?id=8396",""],[189,"سيد الرسل قدره معلوم","https://www.aldiwan.net/poem35108.html","الخفيف"],[221,"جاء للقصر يخطر","https://www.aldiwan.net/poem55281.html","مجزوء الخفيف"],[342,"قيل لي هات في الوطن","https://www.aldiwan.net/poem55326.html","مجزوء الخفيف"],[349,"مر بي بالآب والإبن","https://www.aldiwan.net/poem15641.html","مجزوء الرمل"],[349,"أقبل صبحي وسفر","https://www.aldiwan.net/poem15721.html","مجزوء الرجز"],[371,"ضاق صدري بما أجن وما ضاق","https://www.aldiwan.net/poem57386.html","الخفيف"],[391,"أيها العبد إن شئت الأمان","https://www.aldiwan.net/poem54475.html","عموديه"],[458,"إن كان فوق الشمس للساعي قدم","https://www.aldiwan.net/poem55866.html","الرجز"],[500,"رح مع الوردين إني عاشق","https://www.aldiwan.net/poem37950.html","الرمل"],[529,"أقول بعد الحمد","https://www.aldiwan.net/poem37446.html","مجزوء الرجز"],[575,"قال بعض اللئام إذ أبطأ الأكل","https://www.aldiwan.net/poem2804.html","الخفيف"]],"verses":[["قال بالحق فيه ثم اجتباهُ","واصطفاهُ وما أساء اصطفاءَ",0,"ا",2,0],["قال بعض المُجّان لما رآها","ولذيذٌ بمثلها الطنز هشُّ",1,"ش",1,0],["قال ببعضِ الذي منحتَ ولم","يمدحْكَ بالزور والتهاويلِ",2,"ل",1,0],["قالبٌ مِشْفريه عنْ طبقاتٍ","لثقاتٍ من طُحلبٍ مركوم",3,"م",1,0],["قالَ بَلى كُلَّ الَّذي قُلتهُ","أَنا بِهِ المَشهورُ بَينَ العِباد",4,"د",1,0],["قالَ بُطلاً وَأَفالَ الرَأيَ مَن","لَم يَقُل إِنَّ المَنايا في الحَدَق",5,"ق",1,0],["قالَ بعضُ الناسِ إني","فاضلٌ في العلمِ خاملْ",6,"ل",1,1],["قال بل أعطنيهِ أَنْظُرْهُ إنّي","بسجايا السُّيوفِ أكثرُ علما",7,"م",2,0],["قال بل أحدثتَ أمراً لم تَخَفْ","سُوءَ ما يَغشَى الفتى من عابِهِ",8,"ه",1,0],["قَالَ بَيْتُ الأَمِيرِ يُوسُفَ هَذَا","فَحَمِدْنَ الزُّنْجِيَّ أَحْسَنَ حَمْدِ",9,"د",1,0],["قالَ بِي حُسْنٌ فَقَالَتْ وَبِهِ","يَا فَقِيدَ الشِّبْهِ فُقْتَ النَّاسَ طُرَّا",10,"ر",2,0],["قال بالجن معشرٌ، وأراها","وحدها جنا يلبس الأجساما",11,"م",2,0],["قالُ بمن يا ترى تهدي فقلتُ","الأذن كالعين توفي القلبُ ما كانا",12,"ن",2,0],["قال بكره قلت بكره غد .. ياتانينه","كلّها ساعات ويبوح النّهار أسرااره",13,"ر",2,0],["قالَ بلّغتُ فاِشهدوا واِستَقيموا","فَعليه الصلاة والتسليمُ",14,"م",1,0],["قال بل ثغرك الجميل","وإن كنت تنكر",15,"ر",1,0],["قال بعض لبعضهم","شاخص الطرف كالوثن",16,"ن",1,0],["قالَ بُرهاني عَلى التَوحي","دِ فيهِ لا يُرَدُّ",17,"د",1,0],["قالَ بِما تَعرِفُهُ","في لَيلِهِ إِذا اِعتَكَر",18,"ر",1,0],["قال بَيني وبينَكَ الحكمُ أوفا","لجود هذا القاضي وذا ابنُ سرورِ",19,"ر",1,0],["قال بعض الصحابه إنكم","تفعلون لاشيا عندكم",20,"م",1,0],["قال بنو الحرب وقد كتبتها","مالَ على السيفِ وفاءً للقلَمْ",21,"م",1,0],["قالََ بُشرى هذه قيعانُهُمْ","أنتَ للوَصْلِ بِحَقٍّ لائقُ",22,"ق",1,0],["قَالَ بأنَّ الْمُصْطَفَى","وصاحِبَيْهِ حَذَفَا",23,"ف",2,0],["قَالَ بأنَّ الْمُصْطَفى","وصاحِبَيْهِ الْخُلفَا",23,"ف",2,0],["قَالَ بِذاكَ السَّبْعهْ","كَما حَكَاهُ التَّبَعَهْ",23,"ه",1,0],["قال بَعضُ اللِّئام إِذْ أَبْطأَ الأَك","ل عليْنا ودمْعُه مَسجُومُ",24,"م",1,1]]}