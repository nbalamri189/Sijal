{"poems":[[53,"أيها القاسم القسيم رواء","https://www.aldiwan.net/poem7958.html","الخفيف"],[53,"كنز الله في كنيزة نتنا","https://www.aldiwan.net/poem64718.html","البسيط"],[53,"يا حسن الوجه والشمائل","https://www.aldiwan.net/poem65926.html","المنسرح"],[53,"خلياني عند اصطكاك الخصومِ","https://www.aldiwan.net/poem66322.html","الطويل"],[87,"قال السلوقي مرة للجواد","https://www.aldiwan.net/poem8046.html","السريع"],[47,"قلت للائم في الحب أفق","https://www.aldiwan.net/poem65180.html","الرمل"],[71,"قال بعض الناس إني","https://www.aldiwan.net/poem28023.html","مجزوء الرمل"],[107,"رحمة يا أبا بصير ونعمى","https://www.aldiwan.net/poem44063.html","الرمل"],[107,"نهضت من كل أوب تلتقي","https://www.aldiwan.net/poem44200.html","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54712","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[108,"الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=179448",""],[52,"وذات دل كأن البدر صورتها","https://www.poetsgate.com/ViewPoem.aspx?id=15754",""],[112,"كان يوم","https://www.poetsgate.com/ViewPoem.aspx?id=8396",""],[193,"سيد الرسل قدره معلوم","https://www.aldiwan.net/poem35108.html","الخفيف"],[226,"جاء للقصر يخطر","https://www.aldiwan.net/poem55281.html","مجزوء الخفيف"],[347,"قيل لي هات في الوطن","https://www.aldiwan.net/poem55326.html","مجزوء الخفيف"],[354,"مر بي بالآب والإبن","https://www.aldiwan.net/poem15641.html","مجزوء الرمل"],[354,"أقبل صبحي وسفر","https://www.aldiwan.net/poem15721.html","مجزوء الرجز"],[376,"ضاق صدري بما أجن وما ضاق","https://www.aldiwan.net/poem57386.html","الخفيف"],[396,"أيها العبد إن شئت الأمان","https://www.aldiwan.net/poem54475.html","عموديه"],[463,"إن كان فوق الشمس للساعي قدم","https://www.aldiwan.net/poem55866.html","الرجز"],[505,"رح مع الوردين إني عاشق","https://www.aldiwan.net/poem37950.html","الرمل"],[534,"أقول بعد الحمد","https://www.aldiwan.net/poem37446.html","مجزوء الرجز"],[580,"قال بعض اللئام إذ أبطأ الأكل","https://www.aldiwan.net/poem2804.html","الخفيف"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66737","البسيط"],[773,"","https://poetry.dctabudhabi.ae/diwan/poem/39118","السريع"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77628","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77514","الرجز"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133836","الخفيف"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46509","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79913","الخفيف"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11976","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52077","الرمل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106830","الخفيف"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141193","الرمل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65983","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94229","الدوبيت"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112627","الرجز"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112672","الرجز"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112640","الرجز"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112632","الرجز"],[3601,"","https://poetry.dctabudhabi.ae/diwan/poem/104452","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91372","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216818","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111475","الخفيف"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125839","الرمل"],[4728,"عابر سبيل","https://www.poetsgate.com/ViewPoem.aspx?id=176954",""],[5186,"مخرت تحمل خمرا، وجعه","https://www.poetsgate.com/ViewPoem.aspx?id=156525",""],[402,"خرجت هند ذات يوم وفوز","https://www.poetsgate.com/ViewPoem.aspx?id=35450",""],[5953,"إن يوم الغدير يوم السرور","https://www.poetsgate.com/ViewPoem.aspx?id=93784",""],[6056,"طريق المدرسة","https://www.poetsgate.com/ViewPoem.aspx?id=130179",""],[6056,"أبدع المنظوم","https://www.poetsgate.com/ViewPoem.aspx?id=156714",""]],"verses":[["قال بالحق فيه ثم اجتباهُ","واصطفاهُ وما أساء اصطفاءَ",0,"ا",2,0],["قال بعض المُجّان لما رآها","ولذيذٌ بمثلها الطنز هشُّ",1,"ش",1,0],["قال ببعضِ الذي منحتَ ولم","يمدحْكَ بالزور والتهاويلِ",2,"ل",1,0],["قالبٌ مِشْفريه عنْ طبقاتٍ","لثقاتٍ من طُحلبٍ مركوم",3,"م",1,0],["قالَ بَلى كُلَّ الَّذي قُلتهُ","أَنا بِهِ المَشهورُ بَينَ العِباد",4,"د",1,0],["قالَ بُطلاً وَأَفالَ الرَأيَ مَن","لَم يَقُل إِنَّ المَنايا في الحَدَق",5,"ق",1,0],["قالَ بعضُ الناسِ إني","فاضلٌ في العلمِ خاملْ",6,"ل",1,1],["قال بل أعطنيهِ أَنْظُرْهُ إنّي","بسجايا السُّيوفِ أكثرُ علما",7,"م",2,0],["قال بل أحدثتَ أمراً لم تَخَفْ","سُوءَ ما يَغشَى الفتى من عابِهِ",8,"ه",1,0],["قَالَ بَيْتُ الأَمِيرِ يُوسُفَ هَذَا","فَحَمِدْنَ الزُّنْجِيَّ أَحْسَنَ حَمْدِ",9,"د",1,0],["قالَ بِي حُسْنٌ فَقَالَتْ وَبِهِ","يَا فَقِيدَ الشِّبْهِ فُقْتَ النَّاسَ طُرَّا",10,"ر",2,0],["قال بالجن معشرٌ، وأراها","وحدها جنا يلبس الأجساما",11,"م",2,0],["قالُ بمن يا ترى تهدي فقلتُ","الأذن كالعين توفي القلبُ ما كانا",12,"ن",2,0],["قال بكره قلت بكره غد .. ياتانينه","كلّها ساعات ويبوح النّهار أسرااره",13,"ر",2,0],["قالَ بلّغتُ فاِشهدوا واِستَقيموا","فَعليه الصلاة والتسليمُ",14,"م",1,0],["قال بل ثغرك الجميل","وإن كنت تنكر",15,"ر",1,0],["قال بعض لبعضهم","شاخص الطرف كالوثن",16,"ن",1,0],["قالَ بُرهاني عَلى التَوحي","دِ فيهِ لا يُرَدُّ",17,"د",1,0],["قالَ بِما تَعرِفُهُ","في لَيلِهِ إِذا اِعتَكَر",18,"ر",1,0],["قال بَيني وبينَكَ الحكمُ أوفا","لجود هذا القاضي وذا ابنُ سرورِ",19,"ر",1,0],["قال بعض الصحابه إنكم","تفعلون لاشيا عندكم",20,"م",1,0],["قال بنو الحرب وقد كتبتها","مالَ على السيفِ وفاءً للقلَمْ",21,"م",1,0],["قالََ بُشرى هذه قيعانُهُمْ","أنتَ للوَصْلِ بِحَقٍّ لائقُ",22,"ق",1,0],["قَالَ بأنَّ الْمُصْطَفَى","وصاحِبَيْهِ حَذَفَا",23,"ف",2,0],["قَالَ بأنَّ الْمُصْطَفى","وصاحِبَيْهِ الْخُلفَا",23,"ف",2,0],["قَالَ بِذاكَ السَّبْعهْ","كَما حَكَاهُ التَّبَعَهْ",23,"ه",1,0],["قال بَعضُ اللِّئام إِذْ أَبْطأَ الأَك","ل عليْنا ودمْعُه مَسجُومُ",24,"م",1,1],["قال بُنيا النبيّ وابناهُ والبرَّ","ة والرُّوحُ ثالثٌ في قَرارِ",25,"ر",1,1],["قالَ بَدا عارِضُهُ فاسْلُهُ","كَيْفَ ورَوْضُ الحُسْنِ مِنهُ كُسِي",26,"س",2,0],["قالَ بِكُم هَذا الحَديث أَودى","وَالنصح وَلّى عَنكُم وَعَدّى",27,"د",2,0],["قال بس شيِّلني أَرَو","وِح لِلعيال جوّا الحمى",28,"م",2,0],["قال بالسعي قوله فإذا","البيد عمار ونضرة ومغاني",29,"ن",2,0],["قالَ بُكاي لفراخي إنَّهم","قَد خيبت فيَّ الليالي ظنَهُم",30,"م",1,0],["قال بالفصلِ ناطقاً فأرّموا","وادّعى الفضلَ سابقاً فأقرّوا",31,"ر",3,0],["قالَ بَل قَلَّ ما عَهِدناكَ فيهِ","قُلتُ لا وَالَّذي لِموسى تَجَلّى",32,"ل",2,0],["قال بل سَوَّلت نفوسكم الكَي","دَ فصَبرٌ ورحمةٌ ورجاء",33,"ا",2,0],["قَالِباً قَلبِي إلَى مُعْتَادِهِ","جابراً كسري بحملِ الحملِ",34,"ل",1,0],["قالبي ما يشاءُ ذوقُك وأبقي","قُرَّة العين بهجةً وصفاء",35,"ا",2,0],["قال بعض القوم من أهل المرام","لم قتلت الأم يا هذا الغلام",36,"م",1,0],["قالب ولا ترس بمرسى غفلة","يطم عليك الموج بالاركام",37,"م",1,0],["قال بشير السرور إذ أرخها","تم حصول المراد والقصد وقع",38,"ع",1,0],["قال بماذا تستحِلّونَ دَمى","وتهتكونَ في البرايا حُرمي",39,"ي",1,0],["قال بشيرٌ فركِبتُ فَرَسي","وجئتُ نحوَ المسجدِ المقدّس",40,"س",1,0],["قال بذا أوصيكَ أن تُعينَهُ","قاتلهُمُ حتى تموت دونَه",41,"ه",1,0],["قال بنفسي أفتدي حُسَينا","وأنعمَنّكَ الغداةَ عَينا",41,"ن",2,0],["قالَ بُرَيرٌ لابنِ عبدِ رَبّهِ","لمّا رأى تأنيبَه بعَتبِهِ",42,"ه",1,1],["قال بحمد اللَه خير ذي النعم","والشكر للَه على جري القلم",43,"م",1,1],["قال بَل فانتظر لَيالي رَبيعٍ","إِنَّما الوَرد في زَمان الرَبيع",44,"ع",1,0],["قالب الصنع الذي ينقل عنه","كلُّ ذي فن أعاجيبَ الفنون",45,"ن",1,0],["قالَ بَل غَيظُهُ العَنِيفُ أَشَدُّ","عَن حِباءٍ تَحبُو وَعَنكَ يَصُدُّ",46,"د",1,0],["قال بعضٌ إنَّه لا شَك","مثلُ اللانهاية",47,"ا",3,0],["قال بالغربة فقر قلت لي ربٍ مجيد","ما بعد هذي فقر صدق لا قالوا فقر",48,"ر",1,0],["قال: بل إن لضحكي سببا","فالرجا، يا سيدي! أن تسمعه:",49,"ع",2,0],["قال بين الأمير يوسف هذا","فحمدن الزنجي أحسن حمد",50,"د",1,0],["قال بلغ عني عبادي أني","أنا مولاهم وخير نصير",51,"ر",1,0],["قال بعد إذنك ، ترى طابورنا رنّ اجرسه","والحضور بدفتر التوقيع ! أظنه فاتنا",52,"ن",2,0],["قال بن عمار ، من هرج ٍ بداه","أبدع المنظوم ، من قلب ٍ صويب",53,"ب",1,1]]}