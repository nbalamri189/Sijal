{"poems":[[73,"لا تعرضن لضيق المقل","https://www.aldiwan.net/poem4018.html","أحذ الكامل"],[53,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[68,"خذ من الدهر لي نصيب","https://www.aldiwan.net/poem41371.html","مجزوء الخفيف"],[287,"عد عن العين واليعافير","https://www.aldiwan.net/poem32764.html","المنسرح"],[295,"ما لقصر الزهور أضحى كئيبا","https://www.aldiwan.net/poem11707.html","الخفيف"],[469,"نشوات طرفك والقوام الأهيف","https://www.aldiwan.net/poem3147.html","عموديه"],[520,"طرقتها والليل وحف الجناح","https://www.aldiwan.net/poem12054.html","السريع"],[580,"أوقد الحسن فوق خديك نارا","https://www.aldiwan.net/poem3068.html","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119887","الخفيف"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48292","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45798","المتدارك"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131964","الرمل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40103","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90965","الرمل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139707",""]],"verses":[["مَلِكٌ صَوارِمُهُ رَسائِلُهُ","إِنَّ الصَوارِمَ أَبلَغُ الرُسلِ",0,"ل",1,0],["ملكٌ صغَّر اسمَهُ أبواه","لا لنقص ولا لتصغير شان",1,"ن",1,0],["مَلِكٌ صَدرُهُ رَحيب","مِنهُ يُستَمطَرُ المَطَر",2,"ر",1,0],["مَلكٌ صَهيلُ الجِيادِ يُطرِبُهُ","إِطرابَ مَن بِالسَماعِ مَسرورِ",3,"ر",1,0],["ملكُ صاغه الإله من القوة","والحزم والنُهى والحنان",4,"ن",1,0],["ملكٌ صريحٌ والزمانُ بأسره","محلٌ وأسمنَ في الزمان المعجف",5,"ف",1,0],["ملك صلاح الدين لا قوضت","أطنابه ملك التقى والصلاح",6,"ح",1,0],["ملكٌ صَيَّر الملوكَ ذوي المِقْ","دَارِ جُنْداً لَه بَلِ الأَقْدَارَا",7,"ر",2,0],["ملك صان عرضه ما استباحت","من حمى ماله المضاع الوفود",8,"د",1,0],["ملكٌ صلاةُ صِلاتِه وخِلالُهُ","شمسٌ تُزيلُ عن النّواظِرِ لَبْسَها",9,"س",3,0],["ملك صار الملكوت بِهِ","كَالأُفق يُنير بِكَوكبه",10,"ه",1,0],["ملك صور في شكل فتاة","ذاب ورد الروض فوق الوجنات",11,"ت",1,0],["مَلكٌ صِرتُ في ذُراه فلا مَسْ","لمةٌ أمسى من بني مروانِ",12,"ن",1,0],["ملك صيغ كان اللَه قد","صبه في قالب الإنسان صب",13,"ب",1,0],["ملكٌ صانه المليكُ فصان ال","ملك في عزمه وحسن الدفاع",14,"ع",1,0]]}