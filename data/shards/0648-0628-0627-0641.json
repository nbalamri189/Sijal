{"poems":[[214,"خلني يا خلي وفرط بلائي","https://www.aldiwan.net/poem13509.html","الخفيف"],[264,"قم واستنشق نفح الفرج","https://www.aldiwan.net/poem35830.html","المتدارك"],[333,"هات قيثارك يا شاعر","https://www.aldiwan.net/poem55055.html","مجزوء الرمل"],[457,"إني لمشتاق لربوة جلق","https://www.aldiwan.net/poem13808.html","الكامل"],[505,"خذ شهودا عن شهود الكائنات","https://www.aldiwan.net/poem38068.html","الرمل"],[563,"لمائه كلنا أواني","https://www.aldiwan.net/poem33828.html","مخلع البسيط"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126898","الرمل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86948","الكامل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80184","الكامل"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101974","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136271","الخفيف"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123914","الرمل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126930","الخفيف"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94590","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94895","الكامل"],[4875,"ركعتين","https://www.poetsgate.com/ViewPoem.aspx?id=133585",""]],"verses":[["وبأفعالها تعدّت الى ان","تركت حبها بلا أسماء",0,"ا",2,0],["وبأفضلهم هو ثاني اثني","ن رفيق الغار وذو الأرج",1,"ج",1,0],["وبأفق المجد والعز","المرجّى قمران",2,"ن",1,0],["وبأفقه غيدٌ طلعن سوافراً","مثل البُدور جَلَتْ ظَلاَمَ الحِنْدسِ",3,"س",1,0],["وبأُفقِ البادِياتِ الخافِياتْ","شمسُ عِزِّي أَبداً لم تَغِبِ",4,"ب",1,0],["وبافتراء وباعتداء","أنكر حقاً وبامتهان",5,"ن",1,0],["وبأفقِ المجدِ والعل","ياءِ حلّا قمرانِ",6,"ن",1,0],["وَبأفق يُمناها تَلوح كَواكبٌ","درّية هِيَ كَالبُدور طَوالع",7,"ع",1,0],["وَبِأُفقِ بَيروتٍ شُعاعَكَ قَد سَما","يَجلو العُيونَ يَزيلُ كُلُ دَجنَّةِ",8,"ه",1,0],["وبافتقادي كاف الكيس قد فقدت","عين العباءة مني منتهى الأبد",9,"د",1,0],["وبافياء ظل دوحة خير المرسل","ين الكرام حطت رحالي",10,"ل",2,0],["وبأفلاك سعود سبحا","أبداً كلتاهما في ميزر",11,"ر",1,0],["وبافمي الهموم قلبي لسيب","أين مني الراقي لقلبي اللسيب",12,"ب",1,0],["وبأفق آل الفضل أصبح آفقاً","والناس تدهج بالثناءِ بلا مِرا",13,"ر",2,0],["وبأفق بيروتٍ تدفَّق معجباً","ومن العجاب غدا الخفيُّ جليّا",14,"ي",2,0],["وبأفكار شيطاني متى ما تطوّقت","أذكاري سلاحي عليهن يطخّن",15,"ن",1,0]]}