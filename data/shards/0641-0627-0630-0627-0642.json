تفاؤل","https://www.poetsgate.com/ViewPoem.aspx?id=190339",""],[5956,"وصفةٌ طبِّية","https://www.poetsgate.com/ViewPoem.aspx?id=184364",""],[391,"لا تَقُولن إذا ما لم تُرِدْ","https://www.poetsgate.com/ViewPoem.aspx?id=22522",""],[6052,"بطاقات حمراء من غزة","https://www.poetsgate.com/ViewPoem.aspx?id=47578",""],[6068,"مرض الحبيب فزرته إسعافا -05-","https://www.poetsgate.com/ViewPoem.aspx?id=177672",""],[6106,"سيدنا الإمام الحسين ، سيد الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=6313",""],[6174,"سفر في قصيدة حبّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86188&r=&rc=5",""]],"verses":[["فَإِذا قيلَ مَن تُحِبُّ تَخَطّا","كِ لِساني وَأَنتِ في القَلبِ ذاكِ",0,"ك",1,0],["فإذا قِيلَ هلْ تَمالأْتِ قالَتْ","في جَوابِ السُّؤالِ هلْ مِنْ مَزيدِ",1,"د",1,0],["فَإِذا قَصَّرَ مَن أَه","واهُ في الوُدِّ عَذَرتُهُ",2,"ت",2,0],["فَإِذا قُمتُم بِأَعباءِ الأُمور","وَاِنتَهى الأُنسُ إِلَيكُم وَالسُرور",3,"ر",1,0],["فَإِذا قَذَفتَ الحَقَّ في أَجلادِهِ","تَرَكَ الصِراعَ مُضَعضَعَ الأَلواحِ",4,"ح",1,0],["فَإِذا قَضى لَكَ أُبتَ مِن شُمِّ العُلا","بِثَنِيَّةٍ بَعُدَت عَلى الطَلّاعِ",5,"ع",1,0],["فَإِذا قيلَ ما مَفاخِرَ مِصرٍ","قيلَ مِنها إيزيسُها الغَرّاءُ",6,"ا",2,0],["فَإِذا قِستَ ما أَخَذنَ بِما أَغ","دَرنَ سَرّى عَنِ الفُؤادِ وَسَلّى",7,"ل",2,0],["فإِذا قطعْنَك فالغريبُ مبَعَّدٌ","وإِذا وصَلْنَكَ فالبعيدُ قَريبُ",8,"ب",1,0],["فَإِذا قوتُ وائِلٍ وَتَميمٍ","كانَ إِذ كانَ حَنظَلاً وَهَبيدا",9,"د",2,0],["فَإِذا قَضَيتُ فَنادِ يا حَزَنا","هَذا قَتيلُ الصَدِّ وَالهَجرِ",10,"ر",1,0],["فَإِذا قَضى في المُشكِلاتِ تَرادَفَت","حِكَمٌ تُريكَ الوَحيَ كَيفَ تَنَزَّلا",11,"ل",2,0],["فَأَذاقَهَم سَوطَ العَذابِ وَإِنَّهُم","بِالرَجزِ يَخسِفُ أَرضَهُم وَيُدَمدِمُ",12,"م",1,0],["فإذا قلت لقلبي ساعة","قم نغرد لسوى ليلي أبى",13,"ب",2,0],["فإذا قابلَ منها لحظَها","فلّلَتْ منه حديداً بكليلِ",14,"ل",1,0],["فإذا قلتُ هلْ أنالُ وصالاً","منكَ قالتْ ومنْ ينالُ السماءَ",15,"ا",2,0],["فَأَذاقَتني لَذيذاً","خِلتُهُ راحاً خَتيما",16,"م",2,0],["فَأَذاقَتني عَلى مَهلٍ","طَيِّبَ الأَنيابِ لَم يَثعَلِ",17,"ل",1,0],["فَأَذاقَتني لَذيذاً خِلتُهُ","ذَوبَ نَحلٍ شيبَ بِالماءِ الحَصِر",18,"ر",1,0],["فإذا قَبِلْتَ فمِنّةٌ مشكورةٌ","لك ثمّ أنْتَ المُرتَجى المأمول",19,"ل",1,0],["فَإِذا قَصَرتُ لَها الزِمامَ سَما","فَوقَ المَقادِمِ مِلطَمٌ حُرُّ",20,"ر",1,0],["فَإِذا قُمتُ أُصَلّي","عَرَضَت لي في صَلاتي",21,"ت",2,0],["فَإِذا قَنَى مَالاً كَمَا","يَقْنِي لِعُقْبَاهُ الحَسِيبُ",22,"ب",1,0],["فإذا قرينته الحبيبة جثة","وبجنبها ولداه يحترقان",23,"ن",1,0],["فَإِذا قُلتُ لَيسَ لي","وَلَدٌ قُلنَ لي أَصفُ",24,"ف",1,0],["فَإِذا قُلتُ خَلِّ","أَرضَ نَجدٍ أَقاما",25,"م",2,0],["فإذا قبلتَ، فتلكَ عندي مِنَّةٌ","أُخْرَى، وشُكْرٌ ماله مِنْ آخر",26,"ر",1,0],["فإذا قيل هل تملات قالت","في جواب السؤال هل من مزيد",27,"د",1,0],["فإذا قرية تدير ضرابا","وتريش السهام حينا وتبري",28,"ر",2,0],["فإذا قُوتُ وَائِلٍ وَتَميمٍ","كانَ، إن كانَ، حَنظلاً وَهبيدَا",29,"د",2,0],["فإذا قضيت فناد يا حزني","هذ قتيل الصد والهجر",30,"ر",1,0],["فَأَذَاقَتْني لَذيذاً خِلْتُهُ","ذَوْبَ نَحْلٍ شِيبَ بالماءِ الخَصِرْ",31,"ر",1,0],["فإذا قدّمَ شىءٌ لك فخذ","لا تقلْ من أين مأتاهُ وكلْ",32,"ل",1,0],["فإذا قلت مَن يُخبِّرُني عن","كل هذا يطولُ فيه عَنائي",33,"ا",2,0],["فَإِذا قامَ طامِعٌ يَبتَغيها","فَسَواءٌ قُعودُهُ وَالقِيامُ",34,"م",1,0],["فإذا قدمت قدمت وهو بفرحة","وإذا رحلت رحلت وهو حزين",35,"ن",1,0],["فأذاقنا طعم الحياة لقاؤه","فأدار خمرة ريقه وسقاني",36,"ن",2,0],["فإذا قدرت فلا تدع","فعل المكارم في اقتدارك",37,"ك",1,0],["فإذا قلت قد فعلت","يقولون ذق ترى",38,"ر",2,0],["فإذا قضيتُ وأنتَ ذو نفسٍ","فاخبا صباحكَ لي إلى الحشرِ",39,"ر",1,0],["فَإِذا قَرَّبَ النفوسَ اِئتِلافٌ","هان عِندي تفرُّقُ الأَجسادِ",40,"د",1,0],["فأذاق عجلانَ الهلاكَ ولو درى","ماذا لفضل إنه معزول",41,"ل",1,0],["فإذا قسوت علي يا أملي","وأطعت فينا ألسن العذل",42,"ل",1,0],["فإذا قتلتُ وَتلك أقصى غاية","لي فالوصيةُ عندها أولادي",43,"د",2,0],["فإذا قص جناحا","ه فنوح وانتحاب",44,"ب",1,0],["فَإِذا قُلتُ أَينَ داري وَقالوا","هِيَ هَذي أَقولُ أَينَ زَماني",45,"ن",2,0],["فَإِذا قَضَى رَجُلٌ يُقالُ مَضى بِه","أَجَلٌ نَعم أَجَلٌ ولَيسَ بآجِلِ",46,"ل",1,0],["فإذا قرأتُ قرأتُ ما","بي عن معانٍ نائيه",47,"ي",2,0],["فَإِذا قُلتَ نَعَم فَاِصبِر لَها","بِنَجاحِ الوَعدِ إِنَّ الخُلفَ ذَم",48,"م",1,0],["فإذا قد رأيت شحا مطاعا","وهوى متبع ودنيا تعظم",49,"م",1,0],["فإذاً قد نَالَ مِنْها","باقتراحٍ واختيارِ",50,"ر",1,0],["فإذا قلتم كفى في المدَّعى","اتفاق منهمُ في الجمل",51,"ل",1,0],["فإذا قلنا ليحيى قيل لا","ها هنا الحق لزيد بن علي",52,"ل",2,0],["فإِذا قابلت محمداً العيسُ","فَقَبِّل مَناسِم العيس شُكرا",53,"ر",2,0],["فإذا قلتُ في الكرام قصيداً","ذقّتُ فيها حلاوةَ الانسجام",54,"م",1,0],["فإذا قُلتُ في مديحك شيئاً","قيلَ لي أَنْتَ أصدقُ النَّاس قولا",55,"ل",2,0],["فإذا قستُه بأَبناء عَصري","كانَ أعلى كعباً وأندى يمينا",56,"ن",2,0],["فإذا قلتُ في ثنائك قولاً","قيلَ لي أنتَ أصدق النَّاس قولا",57,"ل",2,0],["فإذا قيست الأكابر في عليا","ك كانوا كما عَلِمْتَ صغارا",58,"ر",2,0],["فإذا قُلْتَ أَيُّ بَحْرٍ ونِيلٍ","فَلْيُقَلْ أَيُّ دِجْلَةٍ وفُرَاتِ",59,"ت",1,0],["فإِذا قبلت نصيحتي فاعمل بها","تلقَ النجاح وإِن كرهت فسامح",60,"ح",1,0],["فإذا قضت بعض القضاء فإنه","برد على كبد الهدى وسلام",61,"م",1,0],["فإذا قال أو رنا أو تثنّى","منه ذابت عروشها والكراسي",62,"س",2,0],["فإذا قال كن تكن بوجود","هو قول الحق الشديد الباس",63,"س",1,0],["فإذا قلت أنني","أنا والكل واحد",64,"د",1,0],["فإذا قلت فيه قال فلان","وفلان فإنها أستار",65,"ر",1,0],["فإذا قُلتَ أوْ فعلتَ فذاكَ ال","جوهرُ الفردُ يفتِنُ الحُكمَاءَ",66,"ا",2,0],["فَإِذَا قَال له طِعْ ذَا طَاعَه","وإِذا قَال له اتْركْ ذَا تَرك",67,"ك",1,0],["فإذا قبلتم ياكرام نصائحي","سلم التاج وزاد شعب كادح",68,"ح",1,0],["فأذاقُوا الحَمزيَّ كيما يبزّوا","مُلكَهُ من براشه وظفاره",69,"ر",2,0],["فأذاق شيبةَ والوليدَ منيّةً","إذ صبّحاه جَحفلاً جَرَّارا",70,"ر",2,0],["فإذا قامَ على منبرِهِ","فاضَ مثل العارض المنبجسِ",71,"س",1,0],["فَإِذا قيل إِنَّهُم كافؤونا","بِنُقود تَمحو عَناء المُعَنّى",72,"ن",2,0],["فَأَذاق الدروز كَأس حتوفٍ","وَمَحا عضبُه البغاةَ بِنَجد",73,"د",1,0],["فإذا قامت إلى جارتها","لاحت الساقُ بخلخال زجلِ",74,"ل",1,1],["فإذا قبل ابن فروخ اتى","سقطوا لو ان ذاك القول مزح",75,"ح",1,0],["فإذا قضى بطل سيولد غيره","متحديا وسيقتفي أثاره",76,"ر",2,0],["فإذا قلنا فعلنا أبداً","ما حيينا لا نقول الكذبا",77,"ب",2,0],["فَإِذا قلبت حُروفه عادَ اسم ما","تَهواه كُل خَريدة منآده",78,"د",2,0],["فَإِذا قيلَ جَمال فهم","وَإِذا قيل غَرام فَأَنا",79,"ن",2,0],["فأذاقهم حكم الامام وبالها","بنوازل كان الزمان يديرها",80,"ر",3,0],["فَإِذا قَضى فَاِقنَع فَإِنَّ قَضاءهُ","لي إِن قَضى لي أَو عَلَيَّ لَمُقنِعُ",81,"ع",1,0],["فإذا قريشٌ في المكارم طاوَلَت","غلبت بطَولِ المُطعمينَ عِجافَها",82,"ف",3,0],["فأذاقه من ريقه","شهداً فَباتَ له يمور",83,"ر",1,0],["فاذا قيل من حوى رايةَ المج","دِ أشَاروا اليه بالسبَّبَه",84,"ب",2,0],["فَإذا قَرِمْتُ أكَلْتُ لَحْمَ أنَامِلي","وَإذا عَطِشتُ فَمِنَ دَمِي أتَرَشَّفُ",85,"ف",1,0],["فإذا قبحتُ فعلاً لم أقل","أدباً إنك بي تعمله",86,"ل",2,0],["فإذا قام بحيٍّ فأب","وإذا قام بميتٍ فبنى",87,"ن",2,0],["فإذا قامت شواهده","عنده مضى لها وثنا",88,"ن",2,0],["فَإِذا قُلتُ هَبوا لي نَظرَةً","قيلَ ما تُمنَعُ إِلّا شَفَقا",89,"ق",2,0],["فإذا قلت أنا","قال لا أعلمه",90,"م",2,0],["فإذا قلت أنا","فأنا أشعره",91,"ر",2,0],["فأذاقني من حيرة قامتْ بنا","لشهودِه في الأكثرين عَذابا",92,"ب",2,0],["فأذاق كسرى كأسَ ذلٍّ قاتلٍ","فكأنّه ما ذاق بنتَ دنان",93,"ن",1,0],["فإذا قضَيتم حق ساكنةِ الغضَا","عنّي ما يَقضي الحفيُّ الأَلطف",94,"ف",1,0],["فَإِذا قمتُ لم أَدع لِيَ رحلا","من رَآني فقد رَآني وَرحلي",95,"ي",1,1],["فإذا قرأتَ كتابه فاجعل له","بعد الصُّدود إلى الوِصال سبيلا",96,"ل",2,0],["فاذا قام واحد من بنينا","لمجاراتهِ اعتراهُ الكسح",97,"ح",1,0],["فإذا قمت بالصلاة عليه","فهي تنهى إلى الكمال منارك",98,"ك",1,0],["فإذا قلبي قد حن","ن إلى عهد شجوني",99,"ي",1,0],["فإذا قلت ضميري","فهو بهتاني وزوري",100,"ي",1,0],["فإذا قرّت العيونُ استهلَّت","فإذا نِمنَ أُولِعت بالسُّهودِ",101,"د",1,0],["فإذا قرنت أَبِيَّه بمُطيعهِ","وقرنته بغَريبه وطريفه",102,"ف",2,0],["فإذا قصدت نداه ادرك غوثه","وإذا اممت نداه فاض سجاله",103,"ل",2,0],["فإذا قضيت فقم بأمري واحتفظ","بكريمتي بنت النبي وفاطم",104,"م",1,0],["فأذاقوه منقع السم سراً","إذ دنت منه رحلة للجنان",105,"ن",1,0],["فإِذا قمتُ اعترتني رَعشةٌ","فَكأني رَهنَ قَيدٍ من 