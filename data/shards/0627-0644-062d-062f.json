{"poems":[[51,"الحد لله اللطيف بنا","https://www.aldiwan.net/poem63139.html","الكامل"],[46,"نعاء إلى كل حي نعاء","https://www.aldiwan.net/poem30325.html","المتقارب"],[215,"ليلة الأمس إذا شئنا تعود","https://www.aldiwan.net/poem46248.html","الرمل"],[285,"أعطى الشباب من الآراب ما طلبا","https://www.aldiwan.net/poem60775.html","البسيط"],[563,"بين أهل الجحود والتكذيب","https://www.aldiwan.net/poem34966.html","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70681","البسيط"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61042","الرجز"],[1765,"","https://poetry.dctabudhabi.ae/diwan/poem/131591",""],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27506","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27730","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27979","البسيط"],[4469,"","https://poetry.dctabudhabi.ae/diwan/poem/103163","الرمل"],[4955,"ألحدتَ بالله واستهزأتَ بالدِّين","https://www.poetsgate.com/ViewPoem.aspx?id=197391",""],[5431,"الحدْس.....","https://www.poetsgate.com/ViewPoem.aspx?id=198676",""],[5537,"تحيا","https://www.poetsgate.com/ViewPoem.aspx?id=207784",""],[6120,"‏أَلحَدتُ بِالحُبِّ لَمَّا زَادَ إِيْمَانِي","https://www.poetsgate.com/ViewPoem.aspx?id=213468",""]],"verses":[["الحَدُ لِلَّهِ اللَطيفِ بِنا","سَتَرَ القَبيحَ وَأَظهَرَ الحَسَنا",0,"ن",2,1],["أَلَحدٌ حَوى حَيَّةَ المُلحِدينَ","وَلَدنُ ثَرىً حالَ دونَ الثَراءِ",1,"ا",2,0],["الحديث العذب والثغر الرشوف","وجبين الصبح والخد المشوف",2,"ف",1,0],["أَلَحَّ دَهْرٌ لَجُوجٌ فِي مُعانَدَنِي","فَكُلَّما رُضْتُه فِي مَطْلَبٍ صَعُبا",3,"ب",2,0],["ألحدوا في صفات مدحي ومالوا","عن صوابي وأبعدوا تقريبي",4,"ب",2,0],["أَلَحَّ دُلَّحُه بالحَزْنِ مُنْسَكِباً","وكاد يُهلكُ حُزنا كلَّ مَنْ كادا",5,"د",2,0],["أَلحده القَوم وَعل","مِي أَنَّهُ لَم يلحد",6,"د",1,0],["الحديث والحديث يا نديمي ذو شجون","وهو في الماجريات أشباه",7,"ه",1,0],["الحدُّ يجمعنا إذا أنصفتني","هنَّ الشقائقُ لا تجب من فندا",8,"د",2,0],["الحدُ لله حمداً لله بالله","وليس من حيث ما تدعوه باللاهي",9,"ي",1,1],["الحد أمر يعم حتى","يسأل فيه عن حد عدّه",10,"د",2,0],["الحدتها الشمس دهراً","ثم عاد الروح فيها",11,"ي",3,0],["ألحدتَ باللهِ واستهزأتَ بالدِّينِ","فالزم حدودَكَ يا مَن جئتَ مِن طينِ",12,"ن",1,1],["الحدْسُ ظنٌ لاتراه ويصدقُ","للماوراء نسيمه المستنشقُ",13,"ق",1,1],["الحدس ضوء داخليٌ مرسلٌ","للروح عينٌ في النفوس تحدقُ",13,"ق",1,0],["الحديد شاحح وغالي","بس لابسينه ف أدينا",14,"ن",2,0],["‏أَلحَدتُ بِالحُبِّ لَمَّا زَادَ إِيْمَانِي","وَمَا نَقَضتُ علَىٰ الهِجرَانِ أَيمَانِي",15,"ن",2,1]]}