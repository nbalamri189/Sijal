",2,1],["سَطوٌ أَقامَ العِدى عَلى قَدَمٍ","وَقَوَّمَ المائِلينَ فَاِعتَدَلوا",1,"ل",3,0],["سَطوٌ وَصَفحٌ يَطرُقانِ عَدُوَّهُ","أَبَداً وَوَعدٌ صادِقٌ وَوَعيدُ",2,"د",1,0],["سَطَعَت بِالمِسكِ دارَتُهُ","وَأَضاءَت مِثلَ ضَوءِ قَمَر",3,"ر",1,0],["سَطا عليّ وقدْ قلَّ النّصيرُ وهَلْ","يُرْجى الغَناءُ لدَى كَفٍّ بِلا عَضُدِ",4,"د",1,0],["سَطَعَتْ فِي الدُّجَى زَوَاهِرُهُ","تَتَرَاءى فِي اليَمِّ غُرَّانَا",5,"ن",2,0],["سَطَتْ عَلَى مَوْضِعِ الأَرْزَاقِ مَا تَرَكَتْ","مِنْهَا سِوَى كُلِّ عَافٍ تَحْتَ مُنْهَدِمِ",6,"م",1,0],["سَطَعَتْ شَمْسُهُ فَمَا يَتَغَشَّى","نُورَهَا الصَّافِي البَهِيجَ قَتَامُ",7,"م",1,0],["سطوره طوراً ربى زاهراً","وتارةً أغيال آساد",8,"د",1,0],["سطا في الوغى حدًّا وأينع في الندَى","فلله جاني فرعه وجنيه",9,"ي",2,0],["سطوتي سطوةُ المجاهر لا ذي","بَغْيةٍ من مُناوئٍ مكتومه",10,"م",2,0],["سطَّر العابثون فيها أساطي","رَ عَفَت مَتْنَها فما يُستبانُ",11,"ن",1,0],["سَطَرتُها بِشَرحِ أَش","واقٍ إِلَيكَ جَمَّه",12,"م",2,1],["سُطِّرَت قَبلي أَحاديثُ الهَوى","وَبِمِسكٍ مِن حَديثي تُختَمُ",13,"م",1,0],["سطا عليه بجنح الليل مختطفاً","واغتاله قبل وجه الصبح من امم",14,"م",1,0],["سطور قبورٍ في العراء تناسقت","كما نمّق لعنوان في الطرس كاتب",15,"ب",1,0],["سُطورٌ لا يُحيطُ بِهِنَّ رَسمٌ","وَلا يُحصي مَعانيهِنَّ عِلمُ",16,"م",1,0],["سَطَا يومَ بَدْرٍ بِقِرْضَابِهِ","وفي أُحُدٍ لَمْ يَزَلْ يُحْمِلُ",17,"ل",1,0],["سَطَواتُ هَجرِكِ قَطَّعَت أَنفاسي","وَوَصَلنَ عِندَ تَجَلُّدي وَسواسي",18,"س",2,1],["سَطا فَما يَأمُنُهُ خِلُّهُ","أَحوى سَقيمُ الطَرفِ مُعتَلُّهُ",19,"ل",2,1],["سَطَواتٌ بُثَّت عَلى الشَرقِ حَتّى","خَضَعَ الشَرقُ سَهلُهُ وَجِبالُه",20,"ل",2,0],["سَطوَةٌ تُظمِئُ الرُواةَ مِنَ الرُع","بِ وَنُطقٌ يَروي النُفوسَ الصَوادي",21,"د",2,0],["سِطَةُ القِلادَةِ رِفَعَةً وَمَكانُها","مِن كُلِّ مَعلاةٍ مَكانُ اللَهذَمِ",22,"م",1,0],["سَطَعَ النُّورُ لمن يأبى العَمَى","فعلى عينيهِ يَجنِي من يَصِدْ",23,"د",1,0],["سَطَواتُ الخَصيبِ إِحدى المَنايا","وَنَداهُ سُلالَةُ الحَيَوانِ",24,"ن",1,0],["سَطَوا عَلَينا بِأَن كُنّا مَوالِيَكُم","وَعَيَّرونا بِآباءٍ وَأَجدادِ",25,"د",1,0],["سُطورٌ نَحنُ نَكتُبُها لَيالٍ","مَداها كَالمُدى غَرِيَت بِقَشرِ",26,"ر",1,0],["سطَعتْ فما يَسطيعُ إطْفاءً لها","زُحَلٌ ونورُ الحقّ ليس بطافِ",27,"ف",1,0],["سَطَوْتَ ففي وَظيفِ الصّعْبِ قيْدٌ","بذاكَ وفي وَتيرَتِهِ عِرانُ",28,"ن",1,0],["سَطَعَ الزَمانُ بِها وَحُمَّ قَضاؤُها","فَرَمى المَمالِكَ بِالزَمانِ المُظلِمِ",29,"م",1,0],["سطا نفر عَلى آداب قوم","كذاك تعيث في اللَيل الذئاب",30,"ب",1,0],["سَطا عَلى عَبدِ الغنيّ الرَدى","وَكانَ مِن أسدِ الشَرى أَسطى",31,"ط",2,0],["سَطعَ الفوْزُ والرضا بين تاجَيْ","نِ أعادا للشرقِ عزَّاً وذِكْرا",32,"ر",2,0],["سطعتْ بالسعُودِ تستقبلُ الكَوْ","نَ فتحظَى بأشرفِ استقبال",33,"ل",1,0],["سطوتي سطوة ُ المجاهر لاذي","بغْية ٍ من مُناوىء ٍ مكتومه",34,"م",2,0],["سُطور إِذا ما رُمت قَتل حَواسِدي","أَجرد مِنها كُل عَضب مُهند",35,"د",1,0],["سطوة الغيب دولة الرب حقا","حكمة الأمر في اليد العلياء",36,"ا",2,0],["سطا وجادَ أبو يعقوبَ فاعترفت","له الملوكُ بفضلِ البأسِ والكرَمِ",37,"م",1,0],["سَطَوتَ فَاِستَصغَرَ الأَنجادُ ما قَهَروا","وَجُدتَ فَاِستَنزَرَ الأَجوادُ ما وَهَبوا",38,"ب",3,0],["سَطَوتَ فَاِستَصغَرَ الأَنجادُ مَن غَلَبوا","وَجُدتَ فَاِستَنزَرَ الأَجوادُ ما وَهَبوا",39,"ب",3,0],["سُطىً سَمِعَ المُلوكُ بِها فَظَلَّت","أَسِرَّتُهُم بِها خَوفاً تَميدُ",40,"د",1,0],["سَطَّروا مُبطِلينَ في صُحُفِ الفَخ","رِ حِساباً يَنحَطُّ بِالأَخلافِ",41,"ف",1,0],["سَطَوتَ عَلى الدَهرِ لَمّا اِعتَدى","وَقَد كانَ ذا مَيَلٍ فَاِعتَدَل",42,"ل",1,0],["سطا جيش أهواء على من بكم لاذا","وحط بالقدر العلى لقد عاذا",43,"ذ",2,1],["سَطا عَلى شَملِكُمْ يَوماً فمزّقهُ","كلَّ التمزّقِ نَبْواتٌ من الغِيَرِ",44,"ر",1,0],["سطواتُ ليثٍ صيّرت جهّالهم","عقلاً ولو جهلوا عليك لبادوا",45,"د",3,0],["سطوتِ بسلطانِ الجمال على الصبِّ","ولم ترفعي رأساً بلومٍ ولا عتبِ",46,"ب",1,1],["سَطَعَت أَشِعَتُهُ وَطِيبُ ثَنائِهِ","فَهُناكَ نورٌ فَوقَ نورٍ يُجتَلَى",47,"ل",2,0],["سطور نخيل بين موز مسطر","وأشجار نارنج على نهر يحري",48,"ر",2,0],["سَطيحٌ بِبُشرى الهاشميِّ ترنّما","عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما",49,"م",2,0],["سَطَعَتْ من الغبراءِ فيه عَجاجةٌ","مركومةٌ فاغبرَّتِ الخضراءُ",50,"ا",2,0],["سطروا ذكرَهُ على صحفِ التاري","خِ من سوءِ فعلهِ بمدادِ",51,"د",1,0],["سطور رأيت بأثنائها","حبيبا رأى أن يعود النديم",52,"م",1,0],["سطورٌ سواد الكحل في جفن غادةٍ","يقلّ فتوناً عن دجاها ويضؤل",53,"ل",1,0],["سُطُورُها نُمْنِمَتْ كأنَّها دُرَرٌ","تَلُوحُ لي أو عُقُودٌ لُؤْلُؤياتُ",54,"ت",1,0],["سطر على هام الزمان بأننا","أهل الكرامة والأعز قبيلا",55,"ل",2,0],["سطورُ كمالٍ خطّها قلمُ البها","بصفحة وجهٍ بالمحاسن قد زها",56,"ه",2,1],["سطواتٌ من العزائم لم يب","لغ مداها بالفعل بأسُ الحديد",57,"د",1,0],["سطوا لصوصاً ولم يُبقوا على بلدٍ","لما فتحنا لهم في جَهلِنا بابا",58,"ب",2,0],["سَطَواتُ السُلطانِ سَلَّت سُيوفاً","ساطِياتٍ فَأَسخَطَت إِبليسا",59,"س",2,0],["سَطَّرَهَا المَمْلُوكُ وَهُوَ أضرْمَدُ","يَخالُ أَنَّ الصُّبْحَ لَيلٌ أَسْوَدُ",60,"د",1,1],["سَطَوتُ لِأَنَّ الوَقتَ سَيفي عَلى العِدى","وَمِن وَقتِهِ سَيفٌ يَحِقُّ لَهُ يَسطو",61,"ط",2,0],["سَطا فَأَشبَع ما في الطَير مِن خمصٍ","مِنهُم وَأنقع ما في الوَحش مِن سَغبِ",62,"ب",1,0],["سَطْرُ عِيسٍ إلى بَياضِ فَلاةٍ","نقلَتْه الحُداةُ حَرْفاً فحَرْفا",63,"ف",2,0],["سَطَوتُم فَلَم تَبقوا عَدُوّاً مُبائِناً","وَجُدتُم فَلَم تَبقوا عَدُوّاً مُداجِيا",64,"ي",2,0],["سطورٌ تُحصِّنْها بمريم في الورى","وناهيك عن نفسٍ ومريمُ سورها",65,"ر",3,0],["سطورُ يهوديين في مُهرقيهما","مجيدين من تيماء أو أهل مدينِ",66,"ن",1,0],["سَطْوَةُ الظالم، دَرْبٌ للمآسي","ينتهي فيه إلى ذُلّ وعارِ",67,"ر",1,0],["سطور لاذ فوقها","بَرَادة من ذهب",68,"ب",1,0],["سَطَواتٌ تُخشَى وحلمٌ يُرجَّى","ونَوالٌ طلقٌ ووجهٌ طليقُ",69,"ق",1,0],["سَطا بحُسام مقلته وَصالا","كأنّي جئتُ أسألُه الوِصالا",70,"ل",2,1],["سطت تلك البزاة ضحىً","وفي راحاتها القضبُ",71,"ب",1,0],["سطوةٌ بات يحذر الكلُّ منها","شرراً يستطيرُ في إنفاضِ",72,"ض",1,0],["سطا وسلاحه قدّر شيق","بصول به وطرف با يليّ",73,"ي",1,0],["سطوراً محوْنَ بياضَ المشيبِ","بنورٍ محا منه لونَ السَّوادِ",74,"د",1,0],["سَطَعَتْ عَلَى الأَمْلاكِ غُرَّةُ وَجْهِهِ","نُوراً وأَشْرَقَ بالنَّدى تحْجِيلُهُ",75,"ل",2,0],["سطا عليها صبية بدلوا","آمالنا فانقلبت جنه",76,"ن",2,0],["سطعت بأندلسَ العظيمةِ حُرةً","ومضت وظلَّ عبيدَها الأحرارُ",77,"