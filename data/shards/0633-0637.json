{"poems":[[53,"لا زعزعتك الخطوب يا جبل","https://www.aldiwan.net/poem29907.html","المنسرح"],[53,"أنظر إلى الأيام كيف تعود","https://www.aldiwan.net/poem30626.html","الكامل"],[55,"خاتم لي ما له أثر","https://www.aldiwan.net/poem26322.html","المديد"],[77,"قلبي وسمعي في شغل عن الفند","https://www.aldiwan.net/poem36613.html","البسيط"],[93,"مر في بالنا فأحيانا","https://www.aldiwan.net/poem11201.html","الخفيف"],[93,"يا مصر لو تقدر الأقدار بالكرم","https://www.aldiwan.net/poem11289.html","البسيط"],[93,"فاح ريحانها ولاح الخزام","https://www.aldiwan.net/poem11347.html","الخفيف"],[72,"لحظك في الفتك هو البادي","https://www.aldiwan.net/poem18557.html","السريع"],[72,"تبسم عن حلو الرضاب شهيه","https://www.aldiwan.net/poem20563.html","الطويل"],[51,"يا ابن كسرى كسرى الملوك أنوشر","https://www.aldiwan.net/poem66329.html","الخفيف"],[51,"رقعة من معاتب لك ظلت","https://www.aldiwan.net/poem66390.html","الخفيف"],[70,"سطرتها بشرح أش","https://www.aldiwan.net/poem42689.html","مجزوء الرجز"],[70,"صدق الواشون فيما زعموا","https://www.aldiwan.net/poem42718.html","الرمل"],[89,"حملته بين احشائي بلا برم","https://www.aldiwan.net/poem44857.html","البسيط"],[89,"أحاطت بليل اليأس مني غياهب","https://www.aldiwan.net/poem44938.html","الطويل"],[85,"على أي الجنان بنا تمر","https://www.aldiwan.net/poem63714.html","الوافر"],[56,"دعوا ابن أبي طالب للهدى","https://www.aldiwan.net/poem58536.html","المتقارب"],[45,"سطوات هجرك قطعت أنفاسي","https://www.aldiwan.net/poem64616.html","الكامل"],[45,"سطا فما يأمنه خله","https://www.aldiwan.net/poem65592.html","السريع"],[45,"عاود القلب بثه وخباله","https://www.aldiwan.net/poem65603.html","الخفيف"],[66,"لو يرد الردى ببذل الأيادي","https://www.aldiwan.net/poem40136.html","الخفيف"],[74,"يممت من علياك خير ميمم","https://www.aldiwan.net/poem13254.html","الكامل"],[105,"أقبلوا أو فاتقوا سوء المرد","https://www.aldiwan.net/poem44205.html","الرمل"],[48,"ذكر الكرخ نازح الأوطان","https://www.aldiwan.net/poem66142.html","الخفيف"],[50,"أمن وقوف على شام بأحماد","https://www.aldiwan.net/poem63935.html","البسيط"],[46,"بحكمة خالقي طيي ونشري","https://www.aldiwan.net/poem22685.html","الوافر"],[46,"أودى فليت الحادثات كفاف","https://www.aldiwan.net/poem23630.html","الكامل"],[46,"معان من أحبتنا معان","https://www.aldiwan.net/poem23635.html","الوافر"],[105,"","https://poetry.dctabudhabi.ae/diwan/poem/49384","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85477","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43720","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54319","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54251","الخفيف"],[51,"يا بن كسرى كسرى الملوك ذوي العزْ","https://www.poetsgate.com/ViewPoem.aspx?id=30514",""]],"verses":[["سَطوٌ أَقامَ العِدى عَلى قَدَمٍ","وَقَوَّمَ المائِلينَ فَاِعتَدَلوا",0,"ل",3,0],["سَطوٌ وَصَفحٌ يَطرُقانِ عَدُوَّهُ","أَبَداً وَوَعدٌ صادِقٌ وَوَعيدُ",1,"د",1,0],["سَطَعَت بِالمِسكِ دارَتُهُ","وَأَضاءَت مِثلَ ضَوءِ قَمَر",2,"ر",1,0],["سَطا عليّ وقدْ قلَّ النّصيرُ وهَلْ","يُرْجى الغَناءُ لدَى كَفٍّ بِلا عَضُدِ",3,"د",1,0],["سَطَعَتْ فِي الدُّجَى زَوَاهِرُهُ","تَتَرَاءى فِي اليَمِّ غُرَّانَا",4,"ن",2,0],["سَطَتْ عَلَى مَوْضِعِ الأَرْزَاقِ مَا تَرَكَتْ","مِنْهَا سِوَى كُلِّ عَافٍ تَحْتَ مُنْهَدِمِ",5,"م",1,0],["سَطَعَتْ شَمْسُهُ فَمَا يَتَغَشَّى","نُورَهَا الصَّافِي البَهِيجَ قَتَامُ",6,"م",1,0],["سطوره طوراً ربى زاهراً","وتارةً أغيال آساد",7,"د",1,0],["سطا في الوغى حدًّا وأينع في الندَى","فلله جاني فرعه وجنيه",8,"ي",2,0],["سطوتي سطوةُ المجاهر لا ذي","بَغْيةٍ من مُناوئٍ مكتومه",9,"م",2,0],["سطَّر العابثون فيها أساطي","رَ عَفَت مَتْنَها فما يُستبانُ",10,"ن",1,0],["سَطَرتُها بِشَرحِ أَش","واقٍ إِلَيكَ جَمَّه",11,"م",2,1],["سُطِّرَت قَبلي أَحاديثُ الهَوى","وَبِمِسكٍ مِن حَديثي تُختَمُ",12,"م",1,0],["سطا عليه بجنح الليل مختطفاً","واغتاله قبل وجه الصبح من امم",13,"م",1,0],["سطور قبورٍ في العراء تناسقت","كما نمّق لعنوان في الطرس كاتب",14,"ب",1,0],["سُطورٌ لا يُحيطُ بِهِنَّ رَسمٌ","وَلا يُحصي مَعانيهِنَّ عِلمُ",15,"م",1,0],["سَطَا يومَ بَدْرٍ بِقِرْضَابِهِ","وفي أُحُدٍ لَمْ يَزَلْ يُحْمِلُ",16,"ل",1,0],["سَطَواتُ هَجرِكِ قَطَّعَت أَنفاسي","وَوَصَلنَ عِندَ تَجَلُّدي وَسواسي",17,"س",2,1],["سَطا فَما يَأمُنُهُ خِلُّهُ","أَحوى سَقيمُ الطَرفِ مُعتَلُّهُ",18,"ل",2,1],["سَطَواتٌ بُثَّت عَلى الشَرقِ حَتّى","خَضَعَ الشَرقُ سَهلُهُ وَجِبالُه",19,"ل",2,0],["سَطوَةٌ تُظمِئُ الرُواةَ مِنَ الرُع","بِ وَنُطقٌ يَروي النُفوسَ الصَوادي",20,"د",2,0],["سِطَةُ القِلادَةِ رِفَعَةً وَمَكانُها","مِن كُلِّ مَعلاةٍ مَكانُ اللَهذَمِ",21,"م",1,0],["سَطَعَ النُّورُ لمن يأبى العَمَى","فعلى عينيهِ يَجنِي من يَصِدْ",22,"د",1,0],["سَطَواتُ الخَصيبِ إِحدى المَنايا","وَنَداهُ سُلالَةُ الحَيَوانِ",23,"ن",1,0],["سَطَوا عَلَينا بِأَن كُنّا مَوالِيَكُم","وَعَيَّرونا بِآباءٍ وَأَجدادِ",24,"د",1,0],["سُطورٌ نَحنُ نَكتُبُها لَيالٍ","مَداها كَالمُدى غَرِيَت بِقَشرِ",25,"ر",1,0],["سطَعتْ فما يَسطيعُ إطْفاءً لها","زُحَلٌ ونورُ الحقّ ليس بطافِ",26,"ف",1,0],["سَطَوْتَ ففي وَظيفِ الصّعْبِ قيْدٌ","بذاكَ وفي وَتيرَتِهِ عِرانُ",27,"ن",1,0],["سَطَعَ الزَمانُ بِها وَحُمَّ قَضاؤُها","فَرَمى المَمالِكَ بِالزَمانِ المُظلِمِ",28,"م",1,0],["سطا نفر عَلى آداب قوم","كذاك تعيث في اللَيل الذئاب",29,"ب",1,0],["سَطا عَلى عَبدِ الغنيّ الرَدى","وَكانَ مِن أسدِ الشَرى أَسطى",30,"ط",2,0],["سَطعَ الفوْزُ والرضا بين تاجَيْ","نِ أعادا للشرقِ عزَّاً وذِكْرا",31,"ر",2,0],["سطعتْ بالسعُودِ تستقبلُ الكَوْ","نَ فتحظَى بأشرفِ استقبال",32,"ل",1,0],["سطوتي سطوة ُ المجاهر لاذي","بغْية ٍ من مُناوىء ٍ مكتومه",33,"م",2,0]]}