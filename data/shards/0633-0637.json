{"poems":[[108,"سطا حُسناً","https://www.shoaraa.com/p13815",""],[53,"لا زعزعتك الخطوب يا جبل","https://www.aldiwan.net/poem29907.html","المنسرح"],[53,"أنظر إلى الأيام كيف تعود","https://www.aldiwan.net/poem30626.html","الكامل"],[55,"خاتم لي ما له أثر","https://www.aldiwan.net/poem26322.html","المديد"],[77,"قلبي وسمعي في شغل عن الفند","https://www.aldiwan.net/poem36613.html","البسيط"],[93,"مر في بالنا فأحيانا","https://www.aldiwan.net/poem11201.html","الخفيف"],[93,"يا مصر لو تقدر الأقدار بالكرم","https://www.aldiwan.net/poem11289.html","البسيط"],[93,"فاح ريحانها ولاح الخزام","https://www.aldiwan.net/poem11347.html","الخفيف"],[72,"لحظك في الفتك هو البادي","https://www.aldiwan.net/poem18557.html","السريع"],[72,"تبسم عن حلو الرضاب شهيه","https://www.aldiwan.net/poem20563.html","الطويل"],[51,"يا ابن كسرى كسرى الملوك أنوشر","https://www.aldiwan.net/poem66329.html","الخفيف"],[51,"رقعة من معاتب لك ظلت","https://www.aldiwan.net/poem66390.html","الخفيف"],[70,"سطرتها بشرح أش","https://www.aldiwan.net/poem42689.html","مجزوء الرجز"],[70,"صدق الواشون فيما زعموا","https://www.aldiwan.net/poem42718.html","الرمل"],[89,"حملته بين احشائي بلا برم","https://www.aldiwan.net/poem44857.html","البسيط"],[89,"أحاطت بليل اليأس مني غياهب","https://www.aldiwan.net/poem44938.html","الطويل"],[85,"على أي الجنان بنا تمر","https://www.aldiwan.net/poem63714.html","الوافر"],[56,"دعوا ابن أبي طالب للهدى","https://www.aldiwan.net/poem58536.html","المتقارب"],[45,"سطوات هجرك قطعت أنفاسي","https://www.aldiwan.net/poem64616.html","الكامل"],[45,"سطا فما يأمنه خله","https://www.aldiwan.net/poem65592.html","السريع"],[45,"عاود القلب بثه وخباله","https://www.aldiwan.net/poem65603.html","الخفيف"],[66,"لو يرد الردى ببذل الأيادي","https://www.aldiwan.net/poem40136.html","الخفيف"],[74,"يممت من علياك خير ميمم","https://www.aldiwan.net/poem13254.html","الكامل"],[105,"أقبلوا أو فاتقوا سوء المرد","https://www.aldiwan.net/poem44205.html","الرمل"],[48,"ذكر الكرخ نازح الأوطان","https://www.aldiwan.net/poem66142.html","الخفيف"],[50,"أمن وقوف على شام بأحماد","https://www.aldiwan.net/poem63935.html","البسيط"],[46,"بحكمة خالقي طيي ونشري","https://www.aldiwan.net/poem22685.html","الوافر"],[46,"أودى فليت الحادثات كفاف","https://www.aldiwan.net/poem23630.html","الكامل"],[46,"معان من أحبتنا معان","https://www.aldiwan.net/poem23635.html","الوافر"],[105,"","https://poetry.dctabudhabi.ae/diwan/poem/49384","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85477","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43720","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54319","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54251","الخفيف"],[51,"يا بن كسرى كسرى الملوك ذوي العزْ","https://www.poetsgate.com/ViewPoem.aspx?id=30514",""],[110,"أمولاي من دون الأنام وسيدي","https://www.aldiwan.net/poem16328.html","الطويل"],[116,"يا نبيا على الأنبياء","https://www.aldiwan.net/poem42164.html","الخفيف"],[134,"أهدي إليك ثناء العرب والعجم","https://www.aldiwan.net/poem4217.html","البسيط"],[144,"لا زلت تعلو وإن حسادك إكتأبوا","https://www.aldiwan.net/poem11721.html","البسيط"],[144,"لا فات ملكك ما أعيا به الطلب","https://www.aldiwan.net/poem11730.html","البسيط"],[144,"ليهنك ما أنالتك الجدود","https://www.aldiwan.net/poem11748.html","الوافر"],[144,"ما عليها أوان تطوي الفيافي","https://www.aldiwan.net/poem11782.html","الخفيف"],[144,"إباؤك للمجد أن يبتذل","https://www.aldiwan.net/poem11800.html","المتقارب"],[145,"سطا جيش أهواء على من بكم لاذا","https://www.aldiwan.net/poem4459.html","الطويل"],[148,"لو أنصف الناس قالوا أنتم جبل","https://www.aldiwan.net/poem47778.html","البسيط"],[161,"أيامنا بك كلها أعياد","https://www.aldiwan.net/poem58841.html","الكامل"],[161,"سطوت بسلطان الجمال على الصب","https://www.aldiwan.net/poem58871.html","الطويل"],[183,"أمنازل الأحباب ما فعل الألى","https://www.aldiwan.net/poem67039.html","الكامل"],[187,"سكنت إلى حسن التوكل والصم","https://www.aldiwan.net/poem43867.html","الطويل"],[190,"رأى مدح خير الخلق صعبا فأحجما","https://www.aldiwan.net/poem35105.html","الرمل"],[199,"طرقت على علل الكرى أسماء","https://www.aldiwan.net/poem51991.html","الكامل"],[200,"قتل الحب يا ليالي الوداد","https://www.aldiwan.net/poem45191.html","الخفيف"],[212,"رأيت من العيد ما سرني","https://www.aldiwan.net/poem46246.html","المتقارب"],[212,"تلقيت من روح الجمال رسالة","https://www.aldiwan.net/poem46317.html","الطويل"],[213,"لحا الله ورقا هيجتني بشجوها","https://www.aldiwan.net/poem37909.html","الطويل"],[252,"قف شامخاً","https://www.aldiwan.net/poem27798.html","عموديه"],[260,"سطور كمال خطها قلم البها","https://www.aldiwan.net/poem35795.html","الطويل"],[260,"إن مدحي لخالد بن الوليد","https://www.aldiwan.net/poem35963.html","الخفيف"],[271,"صافح من العرب الأمجاد أحبابا","https://www.aldiwan.net/poem35654.html","البسيط"],[283,"اسقني الخندريس تسبى عروسا","https://www.aldiwan.net/poem32731.html","الخفيف"],[349,"سطرها المملوك وهو أضرمد","https://www.aldiwan.net/poem20076.html","الرجز"],[350,"أأكشف حالا ستره في النهى شرط","https://www.aldiwan.net/poem15762.html","الطويل"],[354,"أأنت أم أنا أم ما نلت من رتب","https://www.aldiwan.net/poem40818.html","البسيط"],[365,"أتراها تظنني الطيف لطفا","https://www.aldiwan.net/poem60838.html","الخفيف"],[367,"لعمري لئن أضحى عن الغيد عاديا","https://www.aldiwan.net/poem17304.html","الطويل"],[378,"قفا نبك نفسا طال منها بسورها","https://www.aldiwan.net/poem59433.html","الطويل"],[397,"أبينت رسم الدار أم لم تُبينِ","https://www.aldiwan.net/poem621.html",""],[401,"غابة الظلم","https://www.aldiwan.net/poem6751.html","عموديه"],[404,"بمصطكي القهوة في","https://www.aldiwan.net/poem34116.html","مجزوء الرجز"],[410,"مثل منهل أنعم الملك الصالح","https://www.aldiwan.net/poem32212.html","الخفيف"],[417,"سطا بحسام مقلته وصالا","https://www.aldiwan.net/poem54125.html","الوافر"],[430,"ويوم في الكنيسة التي","https://www.aldiwan.net/poem40750.html","مجزوء الوافر"],[433,"اجتل اللهو حمرة في بياض","https://www.aldiwan.net/poem12451.html","الخفيف"],[438,"دعا فأجابه الدمع العصي","https://www.aldiwan.net/poem2606.html","الوافر"],[440,"وفيهن أضحيت يوم الأضاحي","https://www.aldiwan.net/poem34845.html","المتقارب"],[440,"عجبا لغي الحب لاح سبيله","https://www.aldiwan.net/poem34868.html","الكامل"],[444,"في الشام دار الكتب مجد لنا","https://www.aldiwan.net/poem55957.html","عموديه"],[454,"يا مالكا لا عن وراثة شامخ","https://www.aldiwan.net/poem61646.html","الكامل"],[459,"كثر فيك اللوم","https://www.aldiwan.net/poem55885.html","مجزوء الرجز"],[459,"حماها أن تشل وأن تراعا","https://www.aldiwan.net/poem56121.html","الوافر"],[462,"بني عمنا كفوا العضيهة أنها","https://www.aldiwan.net/poem15099.html","الطويل"],[462,"كأن القنا والمشرفية بالضحى","https://www.aldiwan.net/poem15442.html","الطويل"],[465,"أعيا وقد عاينتم الآية العظمى","https://www.aldiwan.net/poem3135.html","عموديه"],[465,"سلا عنك قلبي بعد ما قيل لا يسلو","https://www.aldiwan.net/poem3165.html","عموديه"],[465,"فؤاد أطاع الوجد بين المعالم","https://www.aldiwan.net/poem3488.html","عموديه"],[480,"وجه غادتي القمر","https://www.aldiwan.net/poem37069.html","المقتضب"],[480,"يا سجينا ما حال سجنك إيه","https://www.aldiwan.net/poem37583.html","الخفيف"],[501,"ها أين يا ريح الصبا","https://www.aldiwan.net/poem38086.html","مجزوء الرجز"],[515,"روت عن تراقيها العقود عن النحر","https://www.aldiwan.net/poem20796.html","الطويل"],[515,"سطعت شموس قبابهم بزرود","https://www.aldiwan.net/poem20810.html","الكامل"],[515,"أما والهوى لولا الجفون السواحر","https://www.aldiwan.net/poem20819.html","الطويل"],[515,"سل ضاحك البرق يوما عن ثناياها","https://www.aldiwan.net/poem20830.html","البسيط"],[559,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[559,"سمع السمع وهو في الإلتباس","https://www.aldiwan.net/poem34443.html","الخفيف"],[559,"الكون قد أظهر لي بسطه","https://www.aldiwan.net/poem34741.html","السريع"],[563,"لأهل الدهر آمال طوال","https://www.aldiwan.net/poem52984.html","الوافر"],[576,"رأيت طرفك يوم البين حين همى","https://www.aldiwan.net/poem3020.html","البسيط"]],"verses":[["سطا حسنا فأذعنت اضطرابا","حريٌ بالمحاسن أن تهابا",0,"ب",2,1],["سَطوٌ أَقامَ العِدى عَلى قَدَمٍ","وَقَوَّمَ المائِلينَ فَاِعتَدَلوا",1,"ل",3,0],["سَطوٌ وَصَفحٌ يَطرُقانِ عَدُوَّهُ","أَبَداً وَوَعدٌ صادِقٌ وَوَعيدُ",2,"د",1,0],["سَطَعَت بِالمِسكِ دارَتُهُ","وَأَضاءَت مِثلَ ضَوءِ قَمَر",3,"ر",1,0],["سَطا عليّ وقدْ قلَّ النّصيرُ وهَلْ","يُرْجى الغَناءُ لدَى كَفٍّ بِلا عَضُدِ",4,"د",1,0],["سَطَعَتْ فِي الدُّجَى زَوَاهِرُهُ","تَتَرَاءى فِي اليَمِّ غُرَّانَا",5,"ن",2,0],["سَطَتْ عَلَى مَوْضِعِ الأَرْزَاقِ مَا تَرَكَتْ","مِنْهَا سِوَى كُلِّ عَافٍ تَحْتَ مُنْهَدِمِ",6,"م",1,0],["سَطَعَتْ شَمْسُهُ فَمَا يَتَغَشَّى","نُورَهَا الصَّافِي البَهِيجَ قَتَامُ",7,"م",1,0],["سطوره طوراً ربى زاهراً","وتارةً أغيال آساد",8,"د",1,0],["سطا في الوغى حدًّا وأينع في الندَى","فلله جاني فرعه وجنيه",9,"ي",2,0],["سطوتي سطوةُ المجاهر لا ذي","بَغْيةٍ من مُناوئٍ مكتومه",10,"م",2,0],["سطَّر العابثون فيها أساطي","رَ عَفَت مَتْنَها فما يُستبانُ",11,"ن",1,0],["سَطَرتُها بِشَرحِ أَش","واقٍ إِلَيكَ جَمَّه",12,"م",2,1],["سُطِّرَت قَبلي أَحاديثُ الهَوى","وَبِمِسكٍ مِن حَديثي تُختَمُ",13,"م",1,0],["سطا عليه بجنح الليل مختطفاً","واغتاله قبل وجه الصبح من امم",14,"م",1,0],["سطور قبورٍ في العراء تناسقت","كما نمّق لعنوان في الطرس كاتب",15,"ب",1,0],["سُطورٌ لا يُحيطُ بِهِنَّ رَسمٌ","وَلا يُحصي مَعانيهِنَّ عِلمُ",16,"م",1,0],["سَطَا يومَ بَدْرٍ بِقِرْضَابِهِ","وفي أُحُدٍ لَمْ يَزَلْ يُحْمِلُ",17,"ل",1,0],["سَطَواتُ هَجرِكِ قَطَّعَت أَنفاسي","وَوَصَلنَ عِندَ تَجَلُّدي وَسواسي",18,"س",2,1],["سَطا فَما يَأمُنُهُ خِلُّهُ","أَحوى سَقيمُ الطَرفِ مُعتَلُّهُ",19,"ل",2,1],["سَطَواتٌ بُثَّت عَلى الشَرقِ حَتّى","خَضَعَ الشَرقُ سَهلُهُ وَجِبالُه",20,"ل",2,0],["سَطوَةٌ تُظمِئُ الرُواةَ مِنَ الرُع","بِ وَنُطقٌ يَروي النُفوسَ الصَوادي",21,"د",2,0],["سِطَةُ القِلادَةِ رِفَعَةً وَمَكانُها","مِن كُلِّ مَعلاةٍ مَكانُ اللَهذَمِ",22,"م",1,0],["سَطَعَ النُّورُ لمن يأبى العَمَى","فعلى عينيهِ يَجنِي من يَصِدْ",23,"د",1,0],["سَطَواتُ الخَصيبِ إِحدى المَنايا","وَنَداهُ سُلالَةُ الحَيَوانِ",24,"ن",1,0],["سَطَوا عَلَينا بِأَن كُنّا مَوالِيَكُم","وَعَيَّرونا بِآباءٍ وَأَجدادِ",25,"د",1,0],["سُطورٌ نَحنُ نَكتُبُها لَيالٍ","مَداها كَالمُدى غَرِيَت بِقَشرِ",26,"ر",1,0],["سطَعتْ فما يَسطيعُ إطْفاءً لها","زُحَلٌ ونورُ الحقّ ليس بطافِ",27,"ف",1,0],["سَطَوْتَ ففي وَظيفِ الصّعْبِ قيْدٌ","بذاكَ وفي وَتيرَتِهِ عِرانُ",28,"ن",1,0],["سَطَعَ الزَمانُ بِها وَحُمَّ قَضاؤُها","فَرَمى المَمالِكَ بِالزَمانِ المُظلِمِ",29,"م",1,0],["سطا نفر عَلى آداب قوم","كذاك تعيث في اللَيل الذئاب",30,"ب",1,0],["سَطا عَلى عَبدِ الغنيّ الرَدى","وَكانَ مِن أسدِ الشَرى أَسطى",31,"ط",2,0],["سَطعَ الفوْزُ والرضا بين تاجَيْ","نِ أعادا للشرقِ عزَّاً وذِكْرا",32,"ر",2,0],["سطعتْ بالسعُودِ تستقبلُ الكَوْ","نَ فتحظَى بأشرفِ استقبال",33,"ل",1,0],["سطوتي سطوة ُ المجاهر لاذي","بغْية ٍ من مُناوىء ٍ مكتومه",34,"م",2,0],["سُطور إِذا ما رُمت قَتل حَواسِدي","أَجرد مِنها كُل عَضب مُهند",35,"د",1,0],["سطوة الغيب دولة الرب حقا","حكمة الأمر في اليد العلياء",36,"ا",2,0],["سطا وجادَ أبو يعقوبَ فاعترفت","له الملوكُ بفضلِ البأسِ والكرَمِ",37,"م",1,0],["سَطَوتَ فَاِستَصغَرَ الأَنجادُ ما قَهَروا","وَجُدتَ فَاِستَنزَرَ الأَجوادُ ما وَهَبوا",38,"ب",3,0],["سَطَوتَ فَاِستَصغَرَ الأَنجادُ مَن غَلَبوا","وَجُدتَ فَاِستَنزَرَ الأَجوادُ ما وَهَبوا",39,"ب",3,0],["سُطىً سَمِعَ المُلوكُ بِها فَظَلَّت","أَسِرَّتُهُم بِها خَوفاً تَميدُ",40,"د",1,0],["سَطَّروا مُبطِلينَ في صُحُفِ الفَخ","رِ حِساباً يَنحَطُّ بِالأَخلافِ",41,"ف",1,0],["سَطَوتَ عَلى الدَهرِ لَمّا اِعتَدى","وَقَد كانَ ذا مَيَلٍ فَاِعتَدَل",42,"ل",1,0],["سطا جيش أهواء على من بكم لاذا","وحط بالقدر العلى لقد عاذا",43,"ذ",2,1],["سَطا عَلى شَملِكُمْ يَوماً فمزّقهُ","كلَّ التمزّقِ نَبْواتٌ من الغِيَرِ",44,"ر",1,0],["سطواتُ ليثٍ صيّرت جهّالهم","عقلاً ولو جهلوا عليك لبادوا",45,"د",3,0],["سطوتِ بسلطانِ الجمال على الصبِّ","ولم ترفعي رأساً بلومٍ ولا عتبِ",46,"ب",1,1],["سَطَعَت أَشِعَتُهُ وَطِيبُ ثَنائِهِ","فَهُناكَ نورٌ فَوقَ نورٍ يُجتَلَى",47,"ل",2,0],["سطور نخيل بين موز مسطر","وأشجار نارنج على نهر يحري",48,"ر",2,0],["سَطيحٌ بِبُشرى الهاشميِّ ترنّما","عَلى ذاتِهِ الرحمنُ صلّى وَسَلّما",49,"م",2,0],["سَطَعَتْ من الغبراءِ فيه عَجاجةٌ","مركومةٌ فاغبرَّتِ الخضراءُ",50,"ا",2,0],["سطروا ذكرَهُ على صحفِ 