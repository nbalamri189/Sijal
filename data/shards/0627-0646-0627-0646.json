"],[106,"تحية السودان","https://www.poetsgate.com/ViewPoem.aspx?id=179507",""],[106,"فجر السلام","https://www.poetsgate.com/ViewPoem.aspx?id=179416",""],[103,"قف في ربوع المجد وابك الأزهرا","https://www.poetsgate.com/ViewPoem.aspx?id=1337",""],[67,"أهوى والمشيبُ قد حال دونه","https://www.poetsgate.com/ViewPoem.aspx?id=14596",""],[90,"ليت الذي بك في وقع النوائب بي !","https://www.poetsgate.com/ViewPoem.aspx?id=179093",""],[9,"معلقة الأعشي","https://www.poetsgate.com/ViewPoem.aspx?id=11407",""],[45,"باللهِ أُقسِمُ لو مُلِّكْتُ أَلْسِنَةً","https://www.poetsgate.com/ViewPoem.aspx?id=32030",""],[45,"يكادُ يُبْدي لسعدى غَيْبَ ما أجِدُ","https://www.poetsgate.com/ViewPoem.aspx?id=31630",""],[45,"تَسْعَى º وأَيْسَرُ هَذَا السَّعْيِ يَكْفِينا","https://www.poetsgate.com/ViewPoem.aspx?id=31724",""],[91,"العيون السود","https://www.poetsgate.com/ViewPoem.aspx?id=14091",""]],"verses":[["إِنّا نُجِرُّهُمُ أَعراضَنا طَمَعاً","في أَن يَعودوا إِلى البُقيا كَما كانوا",0,"ن",3,0],["إِن أَنا أَعطَيتُهُمُ مَقادَتي","فَلِم إِذاً أَطلَقَ غَربي صاقِلي",1,"ل",2,0],["إِنّا نَذُمُّ إِلَيكَ خُلَّتَهُ","فَهوَ المَلولُ الغادِرُ الطَرِفُ",2,"ف",1,0],["إِنَ اَنجُ مِنها وَقَد شَرِبتَ بِها","فَإِنَّ خَيلَ المَنونِ في طَلَبي",3,"ب",2,0],["إِنّا نَعيبُ وَلانُعابُ","وَنُصيبُ مِنكَ وَلا نُصابُ",4,"ب",1,1],["أنا نُسْخَةُ الأكْوانِ أُدْمِجَ خطُّها","فسرُّ ذَوي التّحْقيقِ في طيّ أوْراقِي",5,"ي",1,1],["إِنّا نُوازي مَن يُوا","زيهِم وَنَنكى ذا الضَرارَه",6,"ر",2,0],["إِنّا نُقاتِلُهُم ثُمَّتَ نَقتُلُهُم","عِندَ اللِقاءِ وَهُم جاروا وَهُم جَهِلوا",7,"ل",3,0],["إِنّا نَرى فيكَ عيسى","يَدعو إِلى الخَيرِ فينا",8,"ن",2,0],["إِنّا نُناضِلُ أُمَّةً","أَقطابُها أُسدٌ ضَواري",9,"ي",1,0],["إِن أَنَل أَيسَرَ الرَغائِبِ فيهِ","يَرضَ فَوزَ القِداحِ مِنّي مُفيضُ",10,"ض",1,0],["إنا نرجى جيلكم كله","أن يتر المجد ولا يخملا",11,"ل",2,0],["إنَّا نُحَيِّي حَفْلَكُمْ وَيُسُرُّنَا","تِكْرَارُهُ فِي العَامِ بَعْدَ العَامِ",12,"م",1,1],["أن أنت أنشدت شعره هزؤاً","رجعت منه كآكل البصله",13,"ل",2,0],["إنا نحبّك حبّاً لا انتهاء له","يستغرق الأرض والأكوان والزمنا",14,"ن",2,0],["إنا نُبجِّل خير مبجَّل","تبجيلُ كل الفضل في تبجيله",15,"ل",2,0],["إن انتدابكم في قلب موطننا","جرح نداويه لكن لم يزل غبرا",16,"ر",2,0],["إِنّا نُصَدِّقُ بِالَّذي قُلنا لَكُم","وَيَكونُ قَولُكَ يا فَرَزدَقُ زورا",17,"ر",2,0],["إِنّا نُقيمُ صَغا الرُؤوسِ وَنَختَلي","رَأسَ المُتَوَّجِ بِالحُسامِ المِقصَلِ",18,"ل",1,0],["إن أنسَ مدحي لك يوماً فما","نسيت جدوى قدمك الناسي",19,"ي",1,0],["إن أنقش الصحف الطوال بمدحه","فلقد أخذت من الدراهم أنقشا",20,"ش",2,0],["إن أنتَ صادفتَ شيخَ سُوءٍ","كأنما الذّقْنُ منه حِبْثَى",21,"ث",2,1],["إن أنتَ لم تُخبر الإمامَ بها","كنتَ كمن خان أو كمن نَكَثا",22,"ث",2,0],["إن أنت أنهضت حالي بعدما رزَحتْ","فأنت أنهضت ملكاً بعدما رزحا",23,"ح",2,0],["إنْ أنا لم أجزِ بالإِساءة من","زاغ عن القصد أو أبَى رشدَهْ",24,"د",2,0],["إن أنت أعززتني عَزَزْتُ وإنْ","أَسلمتني للعِدى وهَتْ عَمَدي",25,"د",2,0],["إن أنتَ صادفت أخا لحيةٍ","قد جلّلتْ من كِبَرٍ صدرَهْ",26,"ر",2,1],["إن أنتَ لم تَرْعَ وأنت المفضالْ","لنا حقوقاً أوجبتْها أقوالْ",27,"ل",1,1],["إن أنت أقبلتَ لم أطِر فرحاً","وإن تولَّيت لم أَمُت سدما",28,"م",2,0],["إن أنتَ لم تَسْتَحي مِن","وجهي ومن طول التظلُّمْ",29,"م",1,0],["إنَّا نُجارِي خَليعاً غير مُتَّزعٍ","ونحنُ من بين مَعنونٍ ومَرْسون",30,"ن",1,0],["إنا نُكاد ولا نَكيد عدوَّنا","ثقةً بكيد اللَّه وهو متين",31,"ن",1,0],["أَنّا نُعَجِّلُ بِالعَبيطِ لِضَيفِنا","قَبلَ العِيالِ وَنَقتُلُ الأَبطالا",32,"ل",2,0],["إِن أَنتَ أَبصَرتَ الجَمال وَلَم تَهِم","كُنتَ اِمرَأً خَشِنَ الطِباعِ بَليدا",33,"د",2,0],["أَنا نَغمَةٌ وَقَّعَتها الحَياةُ","لِمَن قَد يَعي وَلِمن لا يَعي",34,"ي",1,0],["إِنّا نُبادِلُهُم وَالنَقعُ مُنسَدِلٌ","طَعناً بِطَعنٍ وَنيراناً بِنيرانِ",35,"ن",1,0],["ان انكرت فئة ما فيك من شيم","فما بذى شيمة من يكر الشيما",36,"م",2,0],["ان اناتي في المشيب سهام","لم يكن عن قصد لها اطلاقي",37,"ق",2,0],["انا نحيي بعد كل عشية","من وجه يوسف كوكبا وقادا",38,"د",2,0],["ان انقض الغرب ظهر الشرق يرهقه","فالدهر والارض والعادات اعوان",39,"ن",1,0],["إنا نعاتبكم إذا","لم تفصحوا إنا نعاتب",40,"ب",1,0],["إن أنت وافيت فروقا وقد","ألبسها آذا قشب الثيبا",41,"ب",2,0],["إن أنت لم تتعطف قلت لي رشا","يغار من طيفه السارى فيمنعه",42,"ع",2,0],["إن أنا الدهاء","عنى روى النساء",43,"ا",2,0],["إن إنسانا تقابله","ليس إنسانا بلا وطن",44,"ن",1,0],["إِنّا نُعَظِّمُ فيكِ أَلوِيَةً عَلى","جَنَباتِها حَشدٌ يَروحُ وَيَغتَدي",45,"د",2,0],["إِن أَنتَ أَطلَعتَ المُمَثِّلَ ناقِصاً","لَم تَلقَ عِندَ كَمالِهِ التَمثيلا",46,"ل",2,0],["إِن أَنسَ لا أَنسَ الشَبيبَةَ وَالهَوى","وَسَوالِفَ اللَذّاتِ في ناديكِ",47,"ك",1,0],["إِن أَنا شَبَّهتُهُ بِالغَيثِ في مِدَحي","غَضَضتُ مِنهُ فَكُنتُ المادِحَ الهاجي",48,"ج",2,0],["إِن أَنتَ أَفقَرتَني ظَهرَيهِما ظَهَرَت","نَفاسَةٌ مِن قُلوبِ القَومِ أَو حَسَدُ",49,"د",1,0],["إِنَّ اِنتِظاري لِما اِبتَدَأَت بِهِ","أَبلَغَ إِفراطَهُ اِمرُؤٌ عَذرَهُ",50,"ر",2,0],["آنَ أَن أَسأَمَ اِجتِيابي الفَيافي","وَاِرتِدائي مِنَ الدُجى وَاِدِّراعي",51,"ي",1,0],["إِن أَنتِ وَدَّعتِ بِتَقبيلَةٍ","كانَت يَداً مَشكورَةً لِلفِراق",52,"ق",1,0],["إِن أَنتَ أَحبَبتَ أَن تَلقى ذَوي أَسَفٍ","عَلى فَقيدِهِمِ فَاِحلُل بِوادينا",53,"ن",2,0],["إِنّا نُعَزّيكَ لا إِنّا عَلى ثِقَةٍ","مِنَ الحَياةِ وَلَكِن سُنَّةَ الدينِ",54,"ن",1,1],["إِن أَنتَ لَم تَهدِنا ضَلَلنا","يا رَبِّ إِنَّ الهُدى هُداكا",55,"ك",2,0],["إِن أَنتَ كافَيتَ مَن أَساءَ فَقَد","صِرتَ إِلى مِثلِ سوءِ ما فَعَلا",56,"ل",2,0],["إن أنتِ أخلفتِ وَعدَ حبّي","لم تُؤوِني في الديارِ دار",57,"ر",1,0],["إن أنطون وما أعظمه","طاهر القلب نبيل المشرب",58,"ب",1,0],["أنا نبعٌ لا خِرْوَعٌ عند عمري","وأرى العود منه نبعٌ وخروَع",59,"ع",1,0],["إِن أَنتَ لَم تُفضِل وَلَم تَرَ أَنَّني","أَهلٌ لَهُ فَأَنا أَرى أَن تُنصِفا",60,"ف",2,0],["إِن أَنتَ لَم تَترُكِ السَيرَ الحَثيثَ إِلى","جَآذِرِ الرومِ أَعنَقنا إِلى الخَزَرِ",61,"ر",1,0],["إِن أَنتَ لَم تَكُ عَدلَ الحَقِّ تُنصِفُهُ","لَم نَرجُ بَعدَكَ خَلقاً يُنصِفُ الأَدَبا",62,"ب",2,0],["إِن أَنتَ لَم تَبكِ لَهُ رَحمَةً","فَلا تَلُمهُ إِن بَكا نَفسَهُ",63,"س",2,0],["إِن أَنتَ لَم تَنهَض بِهِ صاعِداً","في مُستَرادِ الزاهِرِ اليانِعِ",64,"ع",1,0],["إن انقطعنا فالعتابُ الثقيلْ","وإنْ حضرنا فالحجابُ الطويلْ",65,"ل",1,1],["إنّا نُبذْنَا بالعرا","لخوفِ زلزالٍ طما",66,"م",2,1],["إن أنتَ أطلقت في الآفاقِ حكمته","أطلقتَ للعلمِ والعرفانِ طُوفانا",67,"ن",2,0],["إنّا نَعُدُّكَ للجُلىَّ وأنت لها","كُفْءٌ إذا قلَّ أكفاءٌ وأقرانُ",68,"ن",1,0],["إنّا نُحاذرُ قولَ الشامِتينَ بنا","حِزبٌ يلومُ وحزبٌ ضلَّ مَسعاهُ",69,"ا",2,0],["إن أنتَ أسلفتَنا ما نَستعيدُ به","رُوحَ الحياةِ فَغَيْثٌ ودْقُهُ يَكفُ",70,"ف",1,0],["إن أنتَ لم تَعدلْ فمن ذا يُرتجى","للعدلِ تحت القُبَّةِ الزّرقاءِ",71,"ا",2,0],["إنّا نقاتلُ بالدِّينِ الذي ضَمنتْ","أعلامُه النَّصرَ في أيَّامِنا الأُوَلِ",72,"ل",1,0],["إنّا نخافُ العارَ فَلْيَكُ بيننا","صُلْحٌ نَدِيْنُ بهِ وعهدٌ مُبْرَمُ",73,"م",1,0],["إِن أَنسَ لا أَنسَ وَجهها وَبِهِ","غبّ اِنتَظاري بادٍ تَحيّرها",74,"ر",3,0],["إن أنفاَسكِ فيه","لَحياةُ الأَنفسِ",75,"س",1,0],["إنْ أنكَرُوا فضلَ النبيِّ فإنّما","أرخَوا عَلَى ضَوءِ النَّهارِ سُدُولا",76,"ل",2,0],["إنْ أنْطَلقْ عنكم يَكُنْ خيرٌ لكم","لِيَجِيئَكُمْ مَنْ تَرْتَضُوهُ بَدِيلا",76,"ل",2,0],["إِنْ أَنْكَرَتْهُ النَّصَارَى واليهُودُ عَلَى","ما بَيَّنَتْ منه تَوْراةٌ وإِنْجِيلُ",77,"ل",1,0],["أَنَا نِعْمَ القَرِينُ إنْ كُنْتِ تَبْغِينَ","حَلاَلاً وَأنْتِ نِعْمَ الْقَرِينَهْ",78,"ن",2,0],["إِن أَنشَدَ الشِعرَ زَوى وَجهَهُ","وَإِن بَقي في صَدرِهِ كَرَّجا",79,"ج",2,0],["إِن أَنتَ لَم تُلقِ لي المَوَدَّةَ في","صَدرِ حَبيبي وَأَنتَ مُقتَدِرُ",80,"ر",1,0],["إِن أَنتَ لَم تَرفَع لَهُ","رَأساً فُديتَ فَنِصفَ راسِ",81,"س",1,0],["إِنّا نَسَبنا وَالمَناسِبُ ظِنَّةٌ","حَتّى رُميتَ بِنا وَأَنتَ حَصانُ",82,"ن",1,0],["إِنَّ إِناءَ الخَيرِ مِن عَسجَدٍ","لَو خَرَّ هَضبٌ فَوقَهُ ما اِنثَلَم",83,"م",1,0],["إنا نريد حياة لا يضر بها","تعصب ولأمّ الناقد الهبل",84,"ل",1,0],["أنا ناديت لَو يثير المنادى","إنما العلم أَصلُ ما نَحتاجُ",85,"ج",1,0],["إن أنج يا لَيلى فرب فَتىً نجا","من كربة سوداء ذات لزامِ",86,"م",1,1],["إنا نرحب بالأمين وأنه","قدم العراق ليعرف الأحوالا",87,"ل",2,0],["إنا نَعيش بعصر","فيه الجَسور يَفوز",88,"ز",1,0],["إن أَنتَ بحت بما تك","تمينه تَستَريحي",89,"ح",2,0],["إن أنا قاومتُ هياج العبابْ","مصطرعاً والأفقُ داجي السحابْ",90,"ب",1,0],["إن أنت لم تحسني إليه","قتلتِ في صدره نزوعه",91,"ع",2,0],["إنا نفكّرُ في ماضٍ بلا أثَرٍ","ومقبل من حياة كلها غيبُ",92,"ب",1,0],["إن أنسَ لا يَنسَ اليمينَ ويومهُ","قلبي الطروبُ وجفنيَ المغرورِقُ",93,"ق",1,0],["إن انكسار الفرس شر كسرهْ","صيّر وجدان الغلام حسره",94,"ه",1,0],["إنَّ أُنشودة السُّكونِ التي ترتجّ","في صَدْرِكَ الرَّكودِ الرَّحيبِ",95,"ب",1,0],["إِنْ أَنْكَرَ الْعَادُونَ مَا وَصِمْوا بِهِ","هَلْ تَطْهُرُ الْوَصَمَاتُ بِالإِنْكَارِ",96,"ر",1,0],["إنَّا نُقَاضِي الدَّهْرَ فِي أَحْسَابِنَا","بِالرَّأيِ لا بِالصَّارِمِ الفَتَّاكِ",97,"ك",1,0],["أنا نايُ الهوى الذي اخترعَ اللهُ","وأنتَ الفريد من إنشادي",98,"ي",1,0],["إِنَّا نكادُ أسىً عَلَيْهِ ورَحْمَةً","لِشَبابِهِ نَهْوِي مِنَ الأَفْلاكِ",99,"ك",1,0],["إن أنسَها تسعًا من السنينِ","شكري أزفُّه إِلى «أنطونِ»",100,"ن",1,0],["إنا نكرِّم في أشخاصكم وطنًا","لو صُوِّرتْ مصرُ عينًا كان إنسانا",101,"ن",2,0],["إنا نريد من السلام لُبابه","لا لفظه أو صكَّه المكتوبا",102,"ب",2,0],["إنا نريد من التقدم قسطنا","ونريد للإسلام أن يتحررا",103,"ر",2,0],["أنا نعم القرينُ إنْ كنتِ تبغي","ينَ حلالاً وأنتِ نعمَ القرينهْ",104,"ن",2,0],["ان أنكرتني أُناس ضاع بينهم","قدري فمن عَرَّف \" الحجار\" بالذهب",105,"ب",1,0],["إنا نقاتلهم حتى نقتلهم","عند اللقاء وإن جاروا وإن جهلوا",106,"ل",3,0],["إِنْ أَنْسَأَ اللهُ في عُمْرِي فَسَوْفَ تَرَى","مِنْ خِدْمَتَي لَكَ ما يُغنِي عَن الخَدَمِ",107,"م",1,0],["إن أنتَ أفقَدتني ظهْرَيِهما، ظهَرَتْ","نَفَاسَةٌ من قلوب القوْمِ، أوْ حسدُ",108,"د",1,0],["إِنْ أَنْتَ أَحْبَبْتَ أَن تَلْقَى ذَوِي أَسَفٍ","عَلَى فَقيدِهِمُ فاحْلُلْ بِوَدِينَا",109,"ن",2,0],["إن أنت أبصرت الجمال ولم تهم","كنت امرءاً خشن الطباع ، بليدا",110,"د",2,0]]}