ان وتقصرا","https://www.aldiwan.net/poem46979.html","الكامل"],[407,"قسما بوصلك إن بعد مرامه","https://www.aldiwan.net/poem50114.html","الكامل"],[430,"وافى يميس فاخجل الغصن الرطب","https://www.aldiwan.net/poem39900.html","الكامل"],[430,"ماست بلدن والأثيث تميم","https://www.aldiwan.net/poem41395.html","الكامل"],[430,"برزت تفاخر بالجبين الأقمر","https://www.aldiwan.net/poem41402.html","الكامل"],[438,"دعني أعلل قلبا فيك معمودا","https://www.aldiwan.net/poem2496.html","البسيط"],[442,"هذا الفراق وهكذا التوديع","https://www.aldiwan.net/poem14378.html","الكامل"],[442,"إنا نعزيك ما لسنا على ثقة","https://www.aldiwan.net/poem14488.html","البسيط"],[444,"إن كان بعض الشعر غير سديد","https://www.aldiwan.net/poem55916.html","عموديه"],[444,"أما لقربك بعد الهجر ميعاد","https://www.aldiwan.net/poem55954.html","عموديه"],[444,"يا جنان الشام يا ذات البها","https://www.aldiwan.net/poem56030.html","عموديه"],[454,"علم الله عرض غيري عرضي","https://www.aldiwan.net/poem61342.html","الخفيف"],[454,"يا من يوكل للأجانب ملكه","https://www.aldiwan.net/poem61598.html","البسيط"],[459,"من ناصري والزمان لي خصم","https://www.aldiwan.net/poem55862.html","المنسرح"],[459,"أروض الوادي أم ابيض الغسق","https://www.aldiwan.net/poem56090.html","الرجز"],[462,"جعلت من الحدثان أحصن أدرع","https://www.aldiwan.net/poem15148.html","الكامل"],[465,"عرضت سماء الدجنِ زهر جنودها","https://www.aldiwan.net/poem3192.html","عموديه"],[466,"قدمت وعفوك عن مقدمي","https://www.aldiwan.net/poem59035.html","عموديه"],[466,"في رحاب النجف الأشرف","https://www.aldiwan.net/poem61432.html","عموديه"],[469,"أبركت يا بركات راحلة الهوى","https://www.aldiwan.net/poem59555.html","البسيط"],[469,"الشهد صاب عند مطعم خلقه","https://www.aldiwan.net/poem59808.html","الكامل"],[469,"يا ذا الذي يطلب في طرسي","https://www.aldiwan.net/poem59952.html","السريع"],[469,"قد بعتني منك أبا العباس","https://www.aldiwan.net/poem59959.html","الرجز"],[469,"لنا بغير نفاجه","https://www.aldiwan.net/poem60316.html","المجتث"],[469,"يا أخي من رضاع ثدي الإخاء","https://www.aldiwan.net/poem60541.html","الخفيف"],[478,"آليت لا حلت ولا حلتم","https://www.aldiwan.net/poem15270.html","السريع"],[480,"رأيت الناس أقساما","https://www.aldiwan.net/poem37621.html","مجزوء الوافر"],[483,"سقتني بثغر الوصل قهوة حسنها","https://www.aldiwan.net/poem24322.html","عموديه"],[484,"إن الخليط أجد البين فابتكروا","https://www.aldiwan.net/poem2067.html","البسيط"],[496,"ما عاشق ألوط من قرد","https://www.aldiwan.net/poem9823.html","السريع"],[496,"راض كلا أو ساخط كالراضي","https://www.aldiwan.net/poem10225.html","الكامل"],[501,"قل للذي فينا تمسك مخلصا","https://www.aldiwan.net/poem37724.html","الكامل"],[501,"للقلب في سبك الحروف معان","https://www.aldiwan.net/poem37757.html","الكامل"],[501,"ونغمة من أيمن الحي أتت","https://www.aldiwan.net/poem37942.html","الرجز"],[501,"تحت شراع الرفرف","https://www.aldiwan.net/poem37961.html","مجزوء الرجز"],[501,"أي راح دارت به الأقداح","https://www.aldiwan.net/poem38045.html","الخفيف"],[501,"ماذا يقول عليل شفه وله","https://www.aldiwan.net/poem38085.html","البسيط"],[516,"أسماء ملك تحتها لك مقعد","https://www.aldiwan.net/poem12059.html","الكامل"],[530,"علم الدين من غدا باتفاق","https://www.aldiwan.net/poem37076.html","الخفيف"],[530,"علي لله إن أعطيت مقدرة","https://www.aldiwan.net/poem37388.html","البسيط"],[530,"إذا كنت في دنياك والدين تابعا","https://www.aldiwan.net/poem37435.html","الطويل"],[537,"إن أنت إلا إصبع دميت","https://www.aldiwan.net/poem23846.html","الرجز"],[539,"فتحت في روضها","https://www.aldiwan.net/poem47419.html","عموديه"],[539,"فتحت في روضها زهرة","https://www.aldiwan.net/poem47421.html","عموديه"],[552,"إنا نعلل كلنا بمحال","https://www.aldiwan.net/poem47297.html","الكامل"],[552,"دع الغنى لبنيه","https://www.aldiwan.net/poem47302.html","المجتث"],[552,"قل للنوائب قد أصبت المقتلا","https://www.aldiwan.net/poem47316.html","الكامل"],[552,"دع الهوى يتبعه الأخرق","https://www.aldiwan.net/poem47377.html","السريع"],[552,"ضمنت مجدك العلا والمساعي","https://www.aldiwan.net/poem47709.html","الخفيف"],[552,"قد هويناه ناقضا للعهود","https://www.aldiwan.net/poem47853.html","الخفيف"],[559,"نحن في وادي وغيب الغيب في وادي عميق","https://www.aldiwan.net/poem34310.html","الرمل"],[559,"هذه الآيات والسور","https://www.aldiwan.net/poem34487.html","المديد"],[559,"إن محسوسات الحواس الظواهر","https://www.aldiwan.net/poem34517.html","الخفيف"],[562,"يا رب إن أخطأت أو نسيت","https://www.aldiwan.net/poem27865.html","الرجز"],[563,"قف بالعقيق وسل نسيم رياحه","https://www.aldiwan.net/poem52903.html","الكامل"],[564,"هذا جواب غامض في كلمتي","https://www.aldiwan.net/poem13610.html","الكامل"],[574,"يا برق برقاً بين مروة والصفا","https://www.aldiwan.net/poem3646.html","الكامل"],[576,"كل خطب إذا تخطاك عمدا","https://www.aldiwan.net/poem2785.html","الخفيف"],[576,"سلني بالله عن فلان","https://www.aldiwan.net/poem2845.html","مخلع البسيط"],[576,"يا معرضاً قد آن أن تقبلا","https://www.aldiwan.net/poem2887.html","السريع"],[587,"لب العاني بصده بلبله","https://www.aldiwan.net/poem17834.html","الدوبيت"]],"verses":[["إِنّا نُجِرُّهُمُ أَعراضَنا طَمَعاً","في أَن يَعودوا إِلى البُقيا كَما كانوا",0,"ن",3,0],["إِن أَنا أَعطَيتُهُمُ مَقادَتي","فَلِم إِذاً أَطلَقَ غَربي صاقِلي",1,"ل",2,0],["إِنّا نَذُمُّ إِلَيكَ خُلَّتَهُ","فَهوَ المَلولُ الغادِرُ الطَرِفُ",2,"ف",1,0],["إِنَ اَنجُ مِنها وَقَد شَرِبتَ بِها","فَإِنَّ خَيلَ المَنونِ في طَلَبي",3,"ب",2,0],["إِنّا نَعيبُ وَلانُعابُ","وَنُصيبُ مِنكَ وَلا نُصابُ",4,"ب",1,1],["أنا نُسْخَةُ الأكْوانِ أُدْمِجَ خطُّها","فسرُّ ذَوي التّحْقيقِ في طيّ أوْراقِي",5,"ي",1,1],["إِنّا نُوازي مَن يُوا","زيهِم وَنَنكى ذا الضَرارَه",6,"ر",2,0],["إِنّا نُقاتِلُهُم ثُمَّتَ نَقتُلُهُم","عِندَ اللِقاءِ وَهُم جاروا وَهُم جَهِلوا",7,"ل",3,0],["إِنّا نَرى فيكَ عيسى","يَدعو إِلى الخَيرِ فينا",8,"ن",2,0],["إِنّا نُناضِلُ أُمَّةً","أَقطابُها أُسدٌ ضَواري",9,"ر",2,0],["إِن أَنَل أَيسَرَ الرَغائِبِ فيهِ","يَرضَ فَوزَ القِداحِ مِنّي مُفيضُ",10,"ض",1,0],["إنا نرجى جيلكم كله","أن يتر المجد ولا يخملا",11,"ل",2,0],["إنَّا نُحَيِّي حَفْلَكُمْ وَيُسُرُّنَا","تِكْرَارُهُ فِي العَامِ بَعْدَ العَامِ",12,"م",1,1],["أن أنت أنشدت شعره هزؤاً","رجعت منه كآكل البصله",13,"ل",2,0],["إنا نحبّك حبّاً لا انتهاء له","يستغرق الأرض والأكوان والزمنا",14,"ن",2,0],["إنا نُبجِّل خير مبجَّل","تبجيلُ كل الفضل في تبجيله",15,"ل",2,0],["إن انتدابكم في قلب موطننا","جرح نداويه لكن لم يزل غبرا",16,"ر",2,0],["إِنّا نُصَدِّقُ بِالَّذي قُلنا لَكُم","وَيَكونُ قَولُكَ يا فَرَزدَقُ زورا",17,"ر",2,0],["إِنّا نُقيمُ صَغا الرُؤوسِ وَنَختَلي","رَأسَ المُتَوَّجِ بِالحُسامِ المِقصَلِ",18,"ل",1,0],["إن أنسَ مدحي لك يوماً فما","نسيت جدوى قدمك الناسي",19,"س",2,0],["إن أنقش الصحف الطوال بمدحه","فلقد أخذت من الدراهم أنقشا",20,"ش",2,0],["إن أنتَ صادفتَ شيخَ سُوءٍ","كأنما الذّقْنُ منه حِبْثَى",21,"ث",2,1],["إن أنتَ لم تُخبر الإمامَ بها","كنتَ كمن خان أو كمن نَكَثا",22,"ث",2,0],["إن أنت أنهضت حالي بعدما رزَحتْ","فأنت أنهضت ملكاً بعدما رزحا",23,"ح",2,0],["إنْ أنا لم أجزِ بالإِساءة من","زاغ عن القصد أو أبَى رشدَهْ",24,"د",2,0],["إن أنت أعززتني عَزَزْتُ وإنْ","أَسلمتني للعِدى وهَتْ عَمَدي",25,"د",2,0],["إن أنتَ صادفت أخا لحيةٍ","قد جلّلتْ من كِبَرٍ صدرَهْ",26,"ر",2,1],["إن أنتَ لم تَرْعَ وأنت المفضالْ","لنا حقوقاً أوجبتْها أقوالْ",27,"ل",1,1],["إن أنت أقبلتَ لم أطِر فرحاً","وإن تولَّيت لم أَمُت سدما",28,"م",2,0],["إن أنتَ لم تَسْتَحي مِن","وجهي ومن طول التظلُّمْ",29,"م",1,0],["إنَّا نُجارِي خَليعاً غير مُتَّزعٍ","ونحنُ من بين مَعنونٍ ومَرْسون",30,"ن",1,0],["إنا نُكاد ولا نَكيد عدوَّنا","ثقةً بكيد اللَّه وهو متين",31,"ن",1,0],["أَنّا نُعَجِّلُ بِالعَبيطِ لِضَيفِنا","قَبلَ العِيالِ وَنَقتُلُ الأَبطالا",32,"ل",2,0],["إِن أَنتَ أَبصَرتَ الجَمال وَلَم تَهِم","كُنتَ اِمرَأً خَشِنَ الطِباعِ بَليدا",33,"د",2,0],["أَنا نَغمَةٌ وَقَّعَتها الحَياةُ","لِمَن قَد يَعي وَلِمن لا يَعي",34,"ع",2,0],["إِنّا نُبادِلُهُم وَالنَقعُ مُنسَدِلٌ","طَعناً بِطَعنٍ وَنيراناً بِنيرانِ",35,"ن",1,0],["ان انكرت فئة ما فيك من شيم","فما بذى شيمة من يكر الشيما",36,"م",2,0],["ان اناتي في المشيب سهام","لم يكن عن قصد لها اطلاقي",37,"ق",2,0],["انا نحيي بعد كل عشية","من وجه يوسف كوكبا وقادا",38,"د",2,0],["ان انقض الغرب ظهر الشرق يرهقه","فالدهر والارض والعادات اعوان",39,"ن",1,0],["إنا نعاتبكم إذا","لم تفصحوا إنا نعاتب",40,"ب",1,0],["إن أنت وافيت فروقا وقد","ألبسها آذا قشب الثيبا",41,"ب",2,0],["إن أنت لم تتعطف قلت لي رشا","يغار من طيفه السارى فيمنعه",42,"ع",2,0],["إن أنا الدهاء","عنى روى النساء",43,"ا",2,0],["إن إنسانا تقابله","ليس إنسانا بلا وطن",44,"ن",1,0],["إِنّا نُعَظِّمُ فيكِ أَلوِيَةً عَلى","جَنَباتِها حَشدٌ يَروحُ وَيَغتَدي",45,"د",2,0],["إِن أَنتَ أَطلَعتَ المُمَثِّلَ ناقِصاً","لَم تَلقَ عِندَ كَمالِهِ التَمثيلا",46,"ل",2,0],["إِن أَنسَ لا أَنسَ الشَبيبَةَ وَالهَوى","وَسَوالِفَ اللَذّاتِ في ناديكِ",47,"ك",1,0],["إِن أَنا شَبَّهتُهُ بِالغَيثِ في مِدَحي","غَضَضتُ مِنهُ فَكُنتُ المادِحَ الهاجي",48,"ج",2,0],["إِن أَنتَ أَفقَرتَني ظَهرَيهِما ظَهَرَت","نَفاسَةٌ مِن قُلوبِ القَومِ أَو حَسَدُ",49,"د",1,0],["إِنَّ اِنتِظاري لِما اِبتَدَأَت بِهِ","أَبلَغَ إِفراطَهُ اِمرُؤٌ عَذرَهُ",50,"ر",2,0],["آنَ أَن أَسأَمَ اِجتِيابي الفَيافي","وَاِرتِدائي مِنَ الدُجى وَاِدِّراعي",51,"ع",2,0],["إِن أَنتِ وَدَّعتِ بِتَقبيلَةٍ","كانَت يَداً مَشكورَةً لِلفِراق",52,"ق",1,0],["إِن أَنتَ أَحبَبتَ أَن تَلقى ذَوي أَسَفٍ","عَلى فَقيدِهِمِ فَاِحلُل بِوادينا",53,"ن",2,0],["إِنّا نُعَزّيكَ لا إِنّا عَلى ثِقَةٍ","مِنَ الحَياةِ وَلَكِن سُنَّةَ الدينِ",54,"ن",1,1],["إِن أَنتَ لَم تَهدِنا ضَلَلنا","يا رَبِّ إِنَّ الهُدى هُداكا",55,"ك",2,0],["إِن أَنتَ كافَيتَ مَن أَساءَ فَقَد","صِرتَ إِلى مِثلِ سوءِ ما فَعَلا",56,"ل",2,0],["إن أنتِ أخلفتِ وَعدَ حبّي","لم تُؤوِني في الديارِ دار",57,"ر",1,0],["إن أنطون وما أعظمه","طاهر القلب نبيل المشرب",58,"ب",1,0],["أنا نبعٌ لا خِرْوَعٌ عند عمري","وأرى العود منه نبعٌ وخروَع",59,"ع",1,0],["إِن أَنتَ لَم تُفضِل وَلَم تَرَ أَنَّني","أَهلٌ لَهُ فَأَنا أَرى أَن تُنصِفا",60,"ف",2,0],["إِن أَنتَ لَم تَترُكِ السَيرَ الحَثيثَ إِلى","جَآذِرِ الرومِ أَعنَقنا إِلى الخَزَرِ",61,"ر",1,0],["إِن أَنتَ لَم تَكُ عَدلَ الحَقِّ تُنصِفُهُ","لَم نَرجُ بَعدَكَ خَلقاً يُنصِفُ الأَدَبا",62,"ب",2,0],["إِن أَنتَ لَم تَبكِ لَهُ رَحمَةً","فَلا تَلُمهُ إِن بَكا نَفسَهُ",63,"س",2,0],["إِن أَنتَ لَم تَنهَض بِهِ صاعِداً","في مُستَرادِ الزاهِرِ اليانِعِ",64,"ع",1,0],["إن انقطعنا فالعتابُ الثقيلْ","وإنْ حضرنا فالحجابُ الطويلْ",65,"ل",1,1],["إنّا نُبذْنَا بالعرا","لخوفِ زلزالٍ طما",66,"م",2,1],["إن أنتَ أطلقت في الآفاقِ حكمته","أطلقتَ للعلمِ والعرفانِ طُوفانا",67,"ن",2,0],["إنّا نَعُدُّكَ للجُلىَّ وأنت لها","كُفْءٌ إذا قلَّ أكفاءٌ وأقرانُ",68,"ن",1,0],["إنّا نُحاذرُ قولَ الشامِتينَ بنا","حِزبٌ يلومُ وحزبٌ ضلَّ مَسعاهُ",69,"ا",2,0],["إن أنتَ أسلفتَنا ما نَستعيدُ به","رُوحَ الحياةِ فَغَيْثٌ ودْقُهُ يَكفُ",70,"ف",1,0],["إن أنتَ لم تَعدلْ فمن ذا يُرتجى","للعدلِ تحت القُبَّةِ الزّرقاءِ",71,"ا",2,0],["إنّا نقاتلُ بالدِّينِ الذي ضَمنتْ","أعلامُه النَّصرَ في أيَّامِنا الأُوَلِ",72,"ل",1,0],["إنّا نخافُ العارَ فَلْيَكُ بيننا","صُلْحٌ نَدِيْنُ بهِ وعهدٌ مُبْرَمُ",73,"م",1,0],["إِن أَنسَ لا أَنسَ وَجهها وَبِهِ","غبّ اِنتَظاري بادٍ تَحيّرها",74,"ر",3,0],["إن أنفاَسكِ فيه","لَحياةُ الأَنفسِ",75,"س",1,0],["إنْ أنكَرُوا فضلَ النبيِّ فإنّما","أرخَوا عَلَى ضَوءِ النَّهارِ سُدُولا",76,"ل",2,0],["إنْ أنْطَلقْ عنكم يَكُنْ خيرٌ لكم","لِيَجِيئَكُمْ مَنْ تَرْتَضُوهُ بَدِيلا",76,"ل",2,0],["إِنْ أَنْكَرَتْهُ النَّصَارَى واليهُودُ عَلَى","ما بَيَّنَتْ منه تَوْراةٌ وإِنْجِيلُ",77,"ل",1,0],["أَنَا نِعْمَ القَرِينُ إنْ كُنْتِ تَبْغِينَ","حَلاَلاً وَأنْتِ نِعْمَ الْقَرِينَهْ",78,"ن",2,0],["إِن أَنشَدَ الشِعرَ زَوى وَجهَهُ","وَإِن بَقي في صَدرِهِ كَرَّجا",79,"ج",2,0],["إِن أَنتَ لَم تُلقِ لي المَوَدَّةَ في","صَدرِ حَبيبي وَأَنتَ مُقتَدِرُ",80,"ر",1,0],["إِن أَنتَ لَم تَرفَع لَهُ","رَأساً فُديتَ فَنِصفَ راسِ",81,"س",1,0],["إِنّا نَسَبنا وَالمَناسِبُ ظِنَّةٌ","حَتّى رُميتَ بِنا وَأَنتَ حَصانُ",82,"ن",1,0],["إِنَّ إِناءَ الخَيرِ مِن عَسجَدٍ","لَو خَرَّ هَضبٌ فَوقَهُ ما اِنثَلَم",83,"م",1,0],["إنا نريد حياة لا يضر بها","تعصب ولأمّ الناقد الهبل",84,"ل",1,0],["أنا ناديت لَو يثير المنادى","إنما العلم أَصلُ ما نَحتاجُ",85,"ج",1,0],["إن أنج يا لَيلى فرب فَتىً نجا","من كربة سوداء ذات لزامِ",86,"م",1,1],["إنا نرحب بالأمين وأنه","قدم العراق ليعرف الأحوالا",87,"ل",2,0],["إنا نَعيش بعصر","فيه الجَسور يَفوز",88,"ز",1,0],["إن أَنتَ بحت بما تك","تمينه تَستَريحي",89,"ح",2,0],["إن أنا قاومتُ هياج العبابْ","مصطرعاً والأفقُ داجي السحابْ",90,"ب",1,0],["إن أنت لم تحسني إليه","قتلتِ في صدره نزوعه",91,"ع",2,0],["إنا نفكّرُ في ماضٍ بلا أثَرٍ","ومقبل من حياة كلها غيبُ",92,"ب",1,0],["إن أنسَ لا يَنسَ اليمينَ ويومهُ","قلبي الطروبُ وجفنيَ المغرورِقُ",93,"ق",1,0],["إن انكسار الفرس شر كسرهْ","صيّر وجدان الغلام حسره",94,"ه",1,0],["إنَّ أُنشودة السُّكونِ التي ترتجّ","في صَدْرِكَ الرَّكودِ الرَّحيبِ",95,"ب",1,0],["إِنْ أَنْكَرَ الْعَادُونَ مَا وَصِمْوا بِهِ","هَلْ تَطْهُرُ الْوَصَمَاتُ بِالإِنْكَارِ",96,"ر",1,0],["إنَّا نُقَاضِي الدَّهْرَ فِي أَحْسَابِنَا","بِالرَّأيِ لا بِالصَّارِمِ الفَتَّاكِ",97,"ك",1,0],["أنا نايُ الهوى الذي اخترعَ اللهُ","وأنتَ الفريد من إنشادي",98,"د",2,0],["إِنَّا نكادُ أسىً عَلَيْهِ ورَحْمَةً","لِشَبابِهِ نَهْوِي مِنَ الأَفْلاكِ",99,"ك",1,0],["إن أنسَها تسعًا من السنينِ","شكري أزفُّه إِلى «أنطونِ»",100,"ن",1,0],["إنا نكرِّم في أشخاصكم وطنًا","لو صُوِّرتْ مصرُ عينًا كان إنسانا",101,"ن",2,0],["إنا نريد من السلام لُبابه","لا لفظه أو صكَّه المكتوبا",102,"ب",2,0],["آن آن الفدى وثار الدم الحرّ","يذيب القيود إثر القيود",103,"د",1,0],["إنّ أنفاسه غبار وجمر","من شظايا فؤاده ورماده",104,"د",2,0],["إنا نريد من التقدم قسطنا","ونريد للإسلام أن يتحررا",105,"ر",2,0],["أنا نعم القرينُ إنْ كنتِ تبغي","ينَ حلالاً وأنتِ نعمَ القرينهْ",106,"ن",2,0],["ان أنكرتني أُناس ضاع بينهم","قدري فمن عَرَّف \" الحجار\" بالذهب",107,"ب",1,0],["إنا نقاتلهم حتى نقتلهم","عند اللقاء وإن جاروا وإن جهلوا",108,"ل",3,0],["إِنْ أَنْسَأَ اللهُ في عُمْرِي فَسَوْفَ تَرَى","مِنْ خِدْمَتَي لَكَ ما يُغنِي عَن الخَدَمِ",109,"م",1,0],["إن أنتَ أفقَدتني ظهْرَيِهما، ظهَرَتْ","نَفَاسَةٌ من قلوب القوْمِ، أوْ حسدُ",110,"د",1,0],["إِنْ أَنْتَ أَحْبَبْتَ أَن تَلْقَى ذَوِي أَسَفٍ","عَلَى فَقيدِهِمُ فاحْلُلْ بِوَدِينَا",111,"ن",2,0],["إن أنت أبصرت الجمال ولم تهم","كنت امرءاً خشن الطباع ، بليدا",112,"د",2,0],["إن آنس النّار بالوادي فقد شهدت","عيني من اللّهب القدسيّ نيرانا",113,"ن",2,0],["أن أنس ، لا ينس اليمين ويومه","قلبي الطّروب وجفني المغروق",114,"ق",1,0],["ان انت وافيتها والصبح منبلج","وشمت سينائها اذ تكشف السينا",115,"ن",2,0],["ان انت اظهرت الوفاء او الجفا","حالي وحقك في غرامك حالي",116,"ل",2,0],["ان أنت يا راجي الوصول علقت في","اذياله طب رغم وهم اللاح",117,"ح",1,0],["إنا نيام وأنتم مغمضون على","قذى فماذا عسى يأتي به الفرج",118,"ج",1,0],["إن أنتَ فتشتَ الخلائقَ سرَّهم","عيبَ المعيبِ تَعِشْ بِلاَ خِلاَّنِ",119,"ن",1,0],["إن أنتَ لم تنزلِ الأشيا منازلهَا","ظلمتَ والأمرُ جِدٌّ والهوى لُومُ",120,"م",1,0],["إن أنت نكَّبت الهوى عن أولِ","أو حاضرٍ لا بد من مستقبلِ",121,"ل",1,0],["أَنَا نشوانُ مِن رحيقِ هوَاكُم","طولَ دَهْرى لا زلتُ أَسْقِى وأُسْقَى",122,"ق",2,0],["إن أَنتَ أبعدتَهم عن دُورنا مردُوا","على النفاق وإن قربتهم غَدرُوا",123,"ر",3,0],["أنا نشوانُ منه لكنه زا","نَتْ بعطِفَيْه في الصبا نشواتُه",124,"ت",2,0],["إِن أنظُرِ الزُّلُفَاتِ يَوماً أنثَنِي","لِتَألُّمِي بِتَثَلُّمِي ومِحَاقِيد",125,"ق",3,0],["إِن أَنتَ أَكرَمتَهُم أَلفَيتَهُم بُطُراً","وَإِن أَهَنتَهُم أَلفَيتَهُم ذُلُلا",126,"ل",2,0],["إن أنتَ شبَهتَ به غيرَه","سوَّيت بين النَّبع والخِروَعِ",127,"ع",1,0],["إِنّا نَصولُ عَلى الخُطوبِ بِأَنعُمٍ","مِنها بِأَيدينا قَنىً وَنُصولُ",128,"ل",1,0],["إن أنت راض فيا فخري ويا شرفي","ماذا علي إذا واليت من أحد",129,"د",1,0],["إن أنظرتك فإنها نعما يد","يسقي بكاسيها منا ومنون",130,"ن",1,0],["إن انكروا هذا فتلك فصوصهم","يسود منها كل وجه أنكرا",131,"ر",2,0],["إن أنت واصلته وفيت إلى","سعادة لا تشوب أحزانه",132,"ن",2,0],["إنّا نسينا اللَهَ حتى سلّطَ","الباري علينا يا نبيُّ عِدانا",133,"ن",2,0],["إنَّا نهاب وسمر الخط مشرعة","قناً نواعمَ منكم لا قنا ذبلا",134,"ل",2,0],["إنَّا نخافُ من العواقبِ ضَلَّةً","وبِعَدْلِهِ فيهنَّ سُرْجٌ تَزْهَرُ",135,"ر",1,0],["إن أنت وفَّيتَني عن غيرتي فَكَهاً","جعلتُ خدّي وقاءً تحت نعلَيكا",136,"ك",2,0],["آن أن ينسى فؤادي ما شجاه","نسخَ الإقبال أيام الشقاء",137,"ا",2,0],["إن أنسَ لا أنس والأيام ذاهبة","أني سجنت مع الأحرار في داري",138,"ي",1,0],["أَنا نُجوم اللَيالي","أَنا زهور الرَبيعِ",139,"ع",1,0],["إِن أُنسَ لا أَنسَ الهِضا","بَ وَما عَلى تِلكَ الهِضاب",140,"ب",1,0],["إِن أَنَّ فيها بائِسٌ مِمّا بهِ","وَأرَنَّ جاوَبه هناك مطوَّق",141,"ق",1,0],["إِن أَنكَرَت مِن دَمي عَيناهُ ما سَفَكَت","فَقَد أَقَرَّبِهِ خَدّاهُ وَاِعتَرَفا",142,"ف",2,0],["إِن أُنكِرَت مِنَنٌ لَهُ وَصَنائِعٌ","شَهِدَت بِها الأَعناقُ وَالأَجيادُ",143,"د",1,0],["إِن أَنكَرَت أَجفانُهُ يَومَ النَوى","قَتلي فَقَد شَهِدَت بِهِ وَجَناتُهُ",144,"ت",2,0],["إن أنتَ يا طَرفُ سابقتَ الرياح وقا","بلتَ الهِضابَ بقلبٍ غيرِ رعدِيد",145,"د",1,0],["إنْ أنا َأسْلَمْتُ روحي","لا تُعَجِّلْ أمر دفني",146,"ن",2,0],["أنا ناصحٌ لكَ فانتَصِح وارجع إلى","ما أنتَ مولودٌ له حثحاثا",147,"ث",2,0],["إنَّا نعيش كما عاشت أوائلُنا","ولا نريدُ من الأعلاجِ تمدينا",148,"ن",2,0],["إنَّا نَقَمْنَا الجَفاءَ مِنْكُمْ","باللَّهِ ما تَنْقِمون مِنَّا",149,"ن",2,0],["إِنَّ أَنبا سابا بدير قُبَيسٍ","لَجَليلٌ وَهوَ الدَقيق المَعاني",150,"ن",2,0],["إِنَّ اِنتِهاكَ السِرِّ في حُكمِ الهَوى","حُلوٌ فَسِر بِالسِرِّ عَن كِتمانِهِ",151,"ن",2,0],["إِن أَنجَدوا فَدُموعُ العَينِ تُنجِدُني","وَغائِرٌ جَيشُ وَجدي كُلَّما غاروا",152,"ر",3,0],["انا نفينا بل سجنا بل حصر","نابل حكمنا حكم اعداء الدول",153,"ل",1,0],["إن أنا لم أجد في كسب مالٍ","لاقتناء العلا فكيف أجودُ",154,"د",1,1],["إن أنت أصبحت رب أمرٍ","فلا تعرهُ لباسَ باسِ",155,"س",1,1],["إِن أَنكرته العيونُ العشيُ من بهرٍ","فَلِلخَفافيشِ عن شمسِ الضحى كهمُ",156,"م",1,0],["إن أنسَ لا أنسَ ما بالأمس منك بدا","مِن فرطِ برّك بي المُفضي إلى الشرفِ",157,"ف",1,0],["إن أنا حاولت طاعت فترت","وأظهرت وحشة وأكراها",158,"ا",3,0],["إن أنصار البواسل قل","وخميس العدو ملء المدينه",159,"ن",2,0],["انا نلاقي الهناء في حزنٍ","كما نلاقي الشقاء في طرب",160,"ب",1,0],["إن آنسَ العَينانِ من وجَناتهِ","ناراً فمِنها القلبُ في اسْتِقْباس",161,"س",1,0],["إن أنت يا بحرُ لم تَملِكْ ندىً خَضِلاً","فمِنْ يمينِ الإمامِ القائمِ اسْتَعِر",162,"ر",1,0],["إن أَنكرتْ آثاركُم زُمَرُ العِدا","فَلكُم بها كُلُّ الورى شُهَداء",163,"ا",2,0],["إن أنكَرَت ما أُلاقي","فَأمرُها مُستَفاضُ",164,"ض",1,0],["إن أنا قلتُ قلتُ ما يفسِد النا","سَ أقاويلَهم إذا كان ينشَد",165,"د",1,0],["إن أنتَ لم تَعدُ لي على الزمن ال","عادي فلم تقضِ فامضِ في الصّلحِ",166,"ح",1,0],["إنّا نجونا به من كيد مبغضِنا","ذاك المريدُ ابتلاعَ النفس بالداء",167,"ا",2,0],["إنّا نجونا بها من موت منتقمٍ","أعني به داء طاعونٍ وأوباء",167,"ا",2,0],["إن أنت خالفت الوصية مثلَه","شاركته في طرده وبدحضه",168,"ض",2,0],["إن انتقام اللَه سرٌّ غامضٌ","لا تدرك الألباب لب بلائه",169,"ا",3,0],["إن انتقام الله كليُّ القضا","وقضاؤه قد عم كل بلائه",169,"ا",3,0],["إِن أَنتَ لَم تَلقَهُ بِوَجه رضى","فَمالَهُ في حَياتِهِ وَطَر",170,"ر",1,0],["أنا ناطقٌ باسم الذين تذَّوقو","مثلي مَرارةَ عَلْقمِ الأيَّامِ",171,"م",1,0],["أنا ناطقٌ باسم الشبابِ لأنَّني","أشقى بما أَهْدَرتُ من أَعوامِ",171,"م",1,0],["إن أنَبّههُ لأَمرٍ","فَهْو مِكْسَالٌ نؤَومُ",172,"م",1,0],["أَنَا نَاصحٌ لَكَ إنْ قَبِلتَ نَصِيحَتي","خَلِّ الضّلالَ وخُذْ بحجْزةِ حيدرا",173,"ر",2,0],["إِن أَنأَ عنك فَرُبَّ ناءٍ حَسَّنت","عُقباه لِلمُشتاقِ قرب حِمامِهِ",174,"م",2,0],["أن انكرت عيناه سفك دمي فلي","منه الشهادة بالبنان المنخضب",175,"ب",1,0],["ان انكرت قتل المحب وخاصمت","فدمي الشهيد بخدها مرقوم",176,"م",1,0],["ان انكرت تعذيب قلبي فانظروا","سودا الفؤاد بخدها ان تسفر",177,"ر",1,0],["إن انكرت قتلتي عيناك او جحدت","أدت شهادتها الخدان توريدا",178,"د",2,0],["أنا نودعك العشية والحشا","فيها الأسى بعد الوداع وديع",179,"ع",1,0],["إنا نعزيك ما لسنا على ثقة","من الزمان ولكن سنة الدين",180,"ن",1,1],["إن أنت لم تنكر بجد أنني","في الكون موجودا عدمت وجودي",181,"د",2,0],["إنا نحن إلى شمل يكون به","إلى المعالي بنا نهج وإصعاد",182,"د",1,0],["ان أنل في وصفه حظ السباق","فله الفضل وما من ينكر",183,"ر",1,0],["أنا ند له بروحي وذهني","لست أرضيه عامدا حين أرضي",184,"ض",2,0],["إنا نراه بأى حالٍ داعياً","لهوضنا بجهودنا لا بالولى",185,"ل",2,0],["إن أنحلتني أيدي الخطوب ففي","ثراك عزّي ونبتَي الضخمُ",186,"م",1,0],["إن آنستْ خيراً أقامت أو رأت","ضيماً أجاز حكمها أن تنطلِقْ",187,"ق",1,0],["إنْ أنْهَد الحي الجِفانَ لَقيتَهُ","للضيف بين مُسغْسِغٍ ومُدعْدِعِ",188,"ع",1,0],["إن أنكرت من مقلتي ما تدعي","يوماً فانَّ النجمَ بعضُ شهودها",189,"د",3,0],["إنَّا نُذِرْنا لِهذا الرَّمل ِ، نَمضَغُهُ","حينا ً، وَيَمضَغ ُمِن آماقِنا حينا",190,"ن",2,0],["أنا نُصْبَ الجَلالِ أجمَعِهِ","لَيتَني لي بِظِلِّهِ كَنَفُ",191,"ف",1,0],["إِن أَنتَ أَخلَيتَ المَوَدَّةَ مِن رِضىً","يَسطو الوِصالَ بِهِ عَلى الهِجرانِ",192,"ن",1,0],["إِن أَنتَ لَم تَنفُق عَلَيهِ صَداقَةً","نَفَقَت صَداقَتُهُ عَلَيكَ لِصِدقِهِ",193,"ق",2,0],["إِن أَنا لَم أُثبِتُهُ فيهِ فَقَد","أَثبَتَهُ حِفظِيَ في نَفسي",194,"ي",1,0],["إِن أَنسَ حاجاتي فَغَيرَ ناسِ","لا عَدِمَ الناسُ اِهتِمامَ الناسِ",195,"س",1,0],["إِن أَنتَ قَبَّلتَ فاهُ","قَبَّلتَ عَذبَ المَجاجَه",196,"ج",2,0],["آنَ أَن يُثمِرَ العِتابُ اِغتِفارا","في رِياضِ الأَقصاءِ لِلإِقصاءِ",197,"ا",2,0],["اِنْ أنجدوا أو أتهموا لم يزلْ","وهو المَرُوعُ المنجِدُ المتهِمُ",198,"م",1,0],["أناني بلا ريب","يرى الأحرار أخصاما",199,"م",2,0],["أنا نقطة الباء المجردة التي","أنافت على الأفلاك يوم دجنة",200,"ه",1,0],["أنا نذكرهم باللَه واحدة","وبالقرابة والأخرى التي وذروا",201,"ر",3,0],["إن أنت لم تخرجه يا سيدي","خريت بالمفعل من خد",202,"د",1,0],["إن أنس يوم الزنج من أيامكم","فخلا إذَنْ جسمي من الأعراض",203,"ض",1,0],["أنا نَوعُ سِرٍّ أنتَ نُكْتَةُ جُزْئِهِ","ولقد تَوَحَّدَ حُكْمُهُ النَّوْعي",204,"ي",1,0],["أَنا نائِبُ المُخْتارِ في أَهلِ الحِمى","الوقتُ وقْتي والزَّمانُ زَماني",205,"ن",2,0],["إن أَنكَرَ المَخلوقُ فيهِمْ لوعَتي","يشهَدُ لي بالصِّدقِ فيها الخالِقُ",206,"ق",1,0],["إنْ أنتَ أذْعَنتَ لهمْ","قلباً ولم تَنْحَرِفِ",207,"ف",1,0],["أنا نَوْحي أسالَ طَوفانَ نوحٍ","أنا أنِّي للمُنْشَئاتِ رِياحُ",208,"ح",1,0],["إِن أَنكرَتْنا الأَعادي فهي خاسِئَةٌ","ورغْمَهُمْ عرفَتْنا العُجْمُ والعرَبُ",209,"ب",1,0],["إنا نراك وما نراك فإنما","أفكارنا للنص فيك تقلد",210,"د",1,0],["إنَّ إنْجازَ ذَلِكَ الوعْدِ مِنْكُمْ","هُوَ واللهِ عِنْدِيَ الأمْنِيَّهْ",211,"ي",2,0],["أنْ أَنْشُرُ الْعَدْلَ نَشْراً تستنيرُ به","مَعالِمُ الدّينِ في بَدْوٍ وفي حَضَر",212,"ر",1,0],["أن أنصُرَ التوْحِيدَ والعَدْلَ في","كُلِ مَكانٍ باذلاً جَهْدي",213,"د",2,0],["إِن أَنتِ إِلّا إِصبَعٌ دَميتِ","وَفي سَبيلِ اللَهِ ما لَقيتِ",214,"ت",1,1],["أنا نورُ البيت أض","حت إليكم قاله",215,"ه",1,0],["أنا نورُ البيت أضحي","تُ إليكم قائله",216,"ه",1,0],["إنّا نُعلّلُ كلّنا بمحالِ","ونُغَرُّ بالغدوات والآصالِ",217,"ل",1,1],["إنْ أنتَ أعرضتَ عنه","جثا إليك وحلّا",218,"ل",2,0],["إنّا نبدّل كلَّ يومٍ حالةً","بخلافها من قبل أن تُستبدلا",219,"ل",2,0],["إنّ أناساً طلبوا حُوَّماً","وِرْداً شربنا صفوَه ما سُقوا",220,"ق",3,0],["آنَ أنْ تُقْتضى حقوقٌ تراختْ","آذنَتْ بعد فُرقةٍ باِجتماعِ",221,"ع",1,0],["أنَا نَصْلٌ سَلَلْتَهُ لأعادي","كَ وكم ذا سللتَ من مغمودِ",222,"د",1,0],["إن أنوار سليمى ليس تخفى في الورى","إنما المزكوم لا يعرف ما المسك الفتيق",223,"ق",1,0],["إن أنثى النفس ولدها ال","روح وهو الصارم الذكر",224,"ر",1,0],["إن أنواع هذه العرضيا","ت وأجسامها وكل الجواهر",225,"ر",1,0],["إِن أَنا لَم أَصدُقكَ ما لَقيتُ","مِن كُرَبٍ فَوتَ الرَدى رَديتُ",226,"ت",1,0],["إن أنتَ لم تُصلِحْ طَريقَكَ يافعاً","فإذا كَبِرْتَ عَجَزْتَ عن إصلاحِهِ",227,"ح",2,0],["إِن أَن نَطَقتُ بِها فَإِنّي جازِمٌ","وَإِذا إِذا تاتي بِها لَم تَجزِمِ",228,"م",1,0],["أَن أَنَّ سِربَ قطاً غَداةَ شَكا الصَدى","وافاهُ مَجَّ لِوِردِهِ ما اِستَخلَفا",229,"ف",2,0],["أَنا نظَّمت عٍقْدَ لَثْمٍ بَخَدَّيْ","كَ فنثَّرت من دُمُوعك عِقدَا",230,"د",2,0],["إِنَّ انتهاكي به استتارٌ","وإِنَّ عِشْقي له دِيَانَهْ",231,"ن",2,0],["إِن أَنكرُوا سُقْميَ مِن بَعده","فصفرةُ اللونِ دليلٌ على",232,"ل",2,0],["إِن أَنْكَرَ وَجْدِي وَعَنَا القَلْبُ بِهِ","هَا دَمْعيَ سائِلٌ لِكَيْ يَسأَلَهُ",233,"ه",1,0]]}