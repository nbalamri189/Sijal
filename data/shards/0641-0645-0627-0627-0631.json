العذل","https://www.aldiwan.net/poem50848.html","البسيط"],[240,"قل لكريم الدين يا","https://www.aldiwan.net/poem31646.html","مجزوء الرجز"],[240,"يا موسعي جفوة وصدا","https://www.aldiwan.net/poem31825.html","مجزوء البسيط"],[266,"أظن الصبا جابت إليك المسالكا","https://www.aldiwan.net/poem38220.html","الطويل"],[309,"يا صاح قلبي ما سلا ولا طاب","https://www.aldiwan.net/poem16777.html","الرجز"],[310,"أعيذ صفاء الود من كدر العتب","https://www.aldiwan.net/poem56604.html","الطويل"],[354,"بدت لعيني بالستور والكلل","https://www.aldiwan.net/poem15861.html","الرجز"],[358,"علام يلوم العاذلون على وجدي","https://www.aldiwan.net/poem40389.html","الطويل"],[369,"إلى خيال خيال في الظلام سرى","https://www.aldiwan.net/poem60879.html","البسيط"],[369,"أما الغزال الذي أهوى فقد هجرا","https://www.aldiwan.net/poem60918.html","البسيط"],[376,"إن الهوى المجحودا","https://www.aldiwan.net/poem57497.html","المجتث"],[415,"أزور قبرك والأشجان تمنعني","https://www.aldiwan.net/poem31856.html","البسيط"],[422,"اليوم أصبح فيك الوقت منتظما","https://www.aldiwan.net/poem54127.html","البسيط"],[422,"إلى العز خوري يا نياقي وأنجدي","https://www.aldiwan.net/poem54159.html","الطويل"],[438,"زهرن فاعجب لروض ماله زهر","https://www.aldiwan.net/poem12341.html","البسيط"],[443,"وداعاً أيها القلب الحزين","https://www.aldiwan.net/poem2570.html","الوافر"],[463,"سقى دارها بالرقمتين وحياها","https://www.aldiwan.net/poem55818.html","الطويل"],[463,"أدرك ما شاء غلام فطنا","https://www.aldiwan.net/poem55840.html","الرجز"],[463,"يا دار ما أبقت الليالي","https://www.aldiwan.net/poem55948.html","مخلع البسيط"],[463,"أيا سكر الزمان متى تفيق","https://www.aldiwan.net/poem56099.html","الوافر"],[463,"يا دار لا أنهج القشيب","https://www.aldiwan.net/poem56284.html","مخلع البسيط"],[473,"أجيء وإن كان يوم الخميس","https://www.aldiwan.net/poem59961.html","المتقارب"],[482,"أما الشباب فشيء عز مطلبه","https://www.aldiwan.net/poem15274.html","البسيط"],[500,"ومضطغن على الألباب قاس","https://www.aldiwan.net/poem10272.html","الوافر"],[521,"يا أيها الركب اني غير تابعكم","https://www.aldiwan.net/poem48587.html","البسيط"],[569,"بكم وغرامي محنتي وتولعي","https://www.aldiwan.net/poem868.html",""],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83286","البسيط"],[779,"","https://poetry.dctabudhabi.ae/diwan/poem/199828",""],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/69174","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136304","السريع"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56635","الطويل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64490","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79895","البسيط"],[1624,"","https://poetry.dctabudhabi.ae/diwan/poem/45364","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49559","الطويل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26427","الوافر"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52028","الطويل"],[2124,"","https://poetry.dctabudhabi.ae/diwan/poem/45484","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27414","السريع"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27710","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27840","المنسرح"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27737","الوافر"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121207","البسيط"],[2521,"","https://poetry.dctabudhabi.ae/diwan/poem/110671","البسيط"],[2565,"","https://poetry.dctabudhabi.ae/diwan/poem/103724","المجتث"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82963","الرجز"],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82956","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205050","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200164","الوافر"],[3038,"","https://poetry.dctabudhabi.ae/diwan/poem/124276","الطويل"],[3051,"","https://poetry.dctabudhabi.ae/diwan/poem/95781","البسيط"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65178","البسيط"],[3102,"","https://poetry.dctabudhabi.ae/diwan/poem/113901","الطويل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100851","الوافر"],[3301,"","https://poetry.dctabudhabi.ae/diwan/poem/144911","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62743","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62948","الرجز"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62774","الوافر"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127021","الطويل"],[3690,"","https://poetry.dctabudhabi.ae/diwan/poem/77733","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91090","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91179","الوافر"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205879","الهزج"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114315","السريع"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114393","الوافر"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105112","السريع"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83438","الوافر"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33149","السريع"],[4691,"فديتكِ غادة ً","https://www.poetsgate.com/ViewPoem.aspx?id=209106",""],[4767,"عين الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=93516",""],[585,"عليك وإلا ما عقدت رجاء","https://www.poetsgate.com/ViewPoem.aspx?id=161913",""],[5277,"عيونُ القلب","https://www.poetsgate.com/ViewPoem.aspx?id=191335",""],[5302,"ملهوف","https://www.poetsgate.com/ViewPoem.aspx?id=200778",""],[5431,"وحبي مثل البدر وجدا له انشقا","https://www.poetsgate.com/ViewPoem.aspx?id=190580",""],[5691,"فِراقان ...!","https://www.poetsgate.com/ViewPoem.aspx?id=208655",""],[6051,"وَمَا أَمِّي وأَمُّ الوَحْشِ لَمَّا","https://www.poetsgate.com/ViewPoem.aspx?id=85170",""],[6102,"صراع","https://www.poetsgate.com/ViewPoem.aspx?id=184432",""]],"verses":[["فَما أَرى إِلّا سَواماً هُمَّلاً","أَو صَوَراً مَذمومَةً كَالصَوَرِ",0,"ر",1,0],["فَما أَركَبُ الخَطبَ إِلّا جَليلاً","وَلا أَجذُبُ الأَمرَ إِلّا اِقتِسارا",1,"ر",2,0],["فَما اِرتَعتَ مِن شُعُباتِ الحِمامِ","وَلا خِفتَ فيهِ لِأَمرٍ خِطارا",1,"ر",2,0],["فَما اِرتاحَ هَمّي إِلى صاحِبٍ","وَلا نامَ عَزمي عَلى سامِرِ",2,"ر",1,0],["فَما أَرَبي إِلَّا سَريرٌ وَمِنْبَرٌ","وَذِكْرٌ عَلى مَرِّ الزَّمانِ يَدومُ",3,"م",1,0],["فَما ارْتاعَتْ مِنَ الحَيّاتِ سُوداً","كَما ارْتاعَتْ مِنَ الشَّعَراتِ بِيضا",4,"ض",2,0],["فما أرْضَعَتْني دِرَّةَ العِزِّ حُرّةٌ","لَئِنْ لم أذَرْ شِلْوَ ابنِ سَلْمى مُقدَّدا",5,"د",2,0],["فَما اِربَدَّ وَجهُ الخَطبِ إِلّا لَقيتَهُ","بِصَفحَةِ طَلقِ الوَجهِ أَبلَجَ أَروَعا",6,"ع",2,0],["فما أرؤس الكفّار إلاّ حصائد","بسيفك سيف الله تُجنى وتُقْطَفُ",7,"ف",1,0],["فما أرجو بمَهْلك قوم عادٍ","ومن صبِّ العذاب على ثمودِ",8,"د",1,0],["فما أرى الدهر على حكمه","يخرج من حكمكُمُ النافذِ",9,"ذ",1,0],["فما أُراها أوسقت رِحْمَها","أوشاجه وهْي على طُهرِ",10,"ر",1,0],["فَما أَرهَبُ إِن عَزّوا","وَلا أَبهَجُ إِن هانوا",11,"ن",3,0],["فَما أَرَتنا اللَيالي عِندَهُ نِعَماً","حَتّى قَضى فَأَرَتنا عِندَهُ نِقَما",12,"م",2,0],["فَما أَرَتنا اللَيالِيَ دونَهُ مِحَناً","إِلّا سَخا فَأَرَتنا كَفُّهُ مِنَحا",13,"ح",2,0],["فَما اِرتَكَبنا بِالوِصالِ مَأثِماً","بَل بِعتُهُم رَوحي بِغَيرِ ما ثَمَن",14,"ن",1,0],["فَما أَراهُ ظاعِناً راحِلاً","إِلّا أَراهُ قاطِناً نازِلا",15,"ل",2,0],["فَمَا ارْتَهَنَ الطَّرفَ إِلاَّ مِثَالٌ","عَتِيقُ الجَمَالِ جَدِيدُ الرُّوَاءْ",16,"ا",2,0],["فما أرسل الانسان سهما محرما","سوى أنه في نحر راميه راجع",17,"ع",1,0],["فَمَا أرْهَبُ، إنْ عَزّوا،","عَلَى كانُوا، وإنْ أَبْهَجُ",18,"ج",1,0],["فَما اِرتَحَلَ المَجدُ مُذ حَلَّهُ","وَلا اِنفَصَلَ الحَمدُ مُنذُ اِتَّصَل",19,"ل",1,0],["فما ارتد من وقع السهام عنانه","إلى أن أتاه الفوز راغم من غوى",20,"و",2,0],["فما ارتعدت فرائصهم لديه","ولا نكصوا على الأعقاب جبنا",21,"ن",2,0],["فما أرى سببا يدعو إلى عظتي","إلا وكنت له وجها إلى الفرج",22,"ج",1,0],["فما أراها راهبٌ راهباً","إلا شكا المغرمُ للمغرمِ",23,"م",1,0],["فما ارْتَشَفنا شِفاهاً قَبْلها كَشَرَتْ","عن لُؤْلُؤٍ يُجْتَنَى من لَثْمِه عَسَلُ",24,"ل",1,0],["فَما أَرى أَبرَدَ مِن","فَنِّكَ إِلّا فَنَّها",25,"ن",3,0],["فَما أَراهُ يَزورُ قَبري","مَن لَم يَزُر في الحَياةِ رَبعي",26,"ع",2,0],["فما ارتضيها بين أيديك مدحة","وان أفحمت قسا وكعبا ومالكا",27,"ك",2,0],["فما أرجى اليوم كشف كربه","إلا أن صاف لي مشرب المحبة",28,"ه",1,0],["فَما اِرتدّ عنها الطرف حتّى تضرّمت","بِنارٍ لها شبٌّ بإعصار ذي هبِّ",29,"ب",1,0],["فَما اِرتَوى مِن بَعدِ غُدرانِكُم","فُؤادي الصادي وَلَم يَلقَ البَلَل",30,"ل",1,0],["فَما اِرتفعت كَعب لكعب أَمامها","وَلا نَبغَت أَقلام نابغة الجعدي",31,"د",2,0],["فما أَرى لي منَ الأيامِ إن ظَلَمَتْ","إلاّ مُؤيِّدَ دينِ اللّهِ مُنتَصِرا",32,"ر",2,0],["فما أرى أنّني أهدَيْتُ مُمتدِحاً","شِعْرِي ولكنّني أهدَيْتُ مُعتَذِرا",33,"ر",2,0],["فما أرى لي عليه","إلا الدموعَ شُهودا",34,"د",2,0],["فما أرى غيرَ أحجارٍ مُنضَّدَةٍ","قَد احتوتْك ومأْوَى الدُّرَّةِ الصَدَفُ",35,"ف",1,0],["فما ارعوى لك عن وهم توهمه","كأنَّ في أُذْنِه عن ناصح صمما",36,"م",2,0],["فما أربي من بعد فهدٍ وبندرٍ","من البصرة الفيحاء غير محمَّد",37,"د",1,0],["فما ارتَقَيْتُ الدَّرَارِي إِذْ سهِرْتُ لها","إِلا لأَصدافِ يَمٍّ كلُّها دُرَر",38,"ر",1,0],["فما أرجو سواك ومن أرجي","وكل فتى بما يحوي ضنين",39,"ن",1,0],["فما ارتاب طَرْفي فيكِ يا أمّ مالكٍ","على صحّة التشبيه أنكِ إياها",40,"ا",3,0],["فما أريد نهضةً تنتاشُني","إلا لَوى عزميَ عنها وثنَى",41,"ن",2,0],["فما أرنَّتْ عليك قوسي","إلا ولي خَصلَة النضالِ",42,"ل",1,0],["فما أرجو فَمِنْ أنّي مُدِلٌّ","وما أخشى فَمِنْ أني شفيقُ",43,"ق",1,0],["فما أرى منهُمُ بريئاً","يخَشَى افتضاحاً به المُريبُ",44,"ب",1,0],["فَما أَرتَضي العَيشَ كُسوَةً","غِذا لَم تَكُن مِن نَسيجِ الكُؤوسِ",45,"س",1,0],["فما ارعوى لي وذاكَ الصُّدغُ منعطِفٌ","مِن بعدِما لَسَبتْ ذا القلبُ عقربُه",46,"ب",2,0],["فما أرعى على أم ثكول","ولا أبقى على ولد يتيم",47,"م",1,0],["فَما اِرى مِثلُكُم رَكباً كَشَكلُكُم","يَدعوهُم ذو الهَوى الا يَعوجونا",48,"ن",2,0],["فما أرى إلا أنت قصداً أؤمه","ولن أرى إلا نحوك العمر مرجعي",49,"ع",2,0],["فَما أَرى ناعِياً حَيا بِمُفرَدِهِ","إِلّا نَعى لَو عَقِلنا سائِرَ البَشَر",50,"ر",1,0],["فما أراها تميل طوعاً","إلا إلى اليأس من ثوابك",51,"ك",1,0],["فَما أَرَ لا يُشَكِل عَليَّ صَوابه","وَأَحدِس فيما لا أَرى فأصيب",52,"ب",1,0],["فما اراني شارحا بعض ما","شاهدته من حسن ذاك الجمال",53,"ل",1,0],