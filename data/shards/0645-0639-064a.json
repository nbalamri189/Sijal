oetsgate.com/ViewPoem.aspx?id=212480",""],[4960,"مُلاحظات على حائط شُباط","https://www.poetsgate.com/ViewPoem.aspx?id=210408",""],[4978,"في حزننا وافتقاد القرب والسند","https://www.poetsgate.com/ViewPoem.aspx?id=177531",""],[5038,"ظبية النهرين","https://www.poetsgate.com/ViewPoem.aspx?id=195421",""],[3749,"وليلة الربوة الشماء معلمة","https://www.poetsgate.com/ViewPoem.aspx?id=134972",""],[5121,"قِصَّةْ","https://www.poetsgate.com/ViewPoem.aspx?id=213470",""],[5302,"تسائلني هيفا","https://www.poetsgate.com/ViewPoem.aspx?id=201269",""],[181,"خليليَّ منْ عليا هلالِ بنِ عامرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=22257",""],[5387,"بعينيكِ ارتياحي","https://www.poetsgate.com/ViewPoem.aspx?id=46526",""],[5476,"كِبْرِيَاءُ الْمَدَى","https://www.poetsgate.com/ViewPoem.aspx?id=194644",""],[5506,"إن جِئتَ بَدراً فَطِب وَاِنزِل بِذي سَلَمِ","https://www.poetsgate.com/ViewPoem.aspx?id=115770",""],[5529,"معي فلنهن الدين والآية الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=172829",""],[5573,"مدية بارضها حقيقها","https://www.poetsgate.com/ViewPoem.aspx?id=200325",""],[5694,"نرهب عدو الدين","https://www.poetsgate.com/ViewPoem.aspx?id=129915",""],[5751,"شَكوى مُسافر","https://www.poetsgate.com/ViewPoem.aspx?id=214716",""],[5865,"هذيان...","https://www.poetsgate.com/ViewPoem.aspx?id=179829",""],[5875,"تعالي","https://www.poetsgate.com/ViewPoem.aspx?id=27771",""],[5950,"مريم ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128336",""],[5956,"الرَّصيفُ ذو الحصى العسليّ","https://www.poetsgate.com/ViewPoem.aspx?id=184884",""],[5956,"وُعُود الأماني","https://www.poetsgate.com/ViewPoem.aspx?id=192695",""],[6019,"رحيقُ الوفاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=120903",""],[549,"الفارس والصهيل المكسر","https://www.poetsgate.com/ViewPoem.aspx?id=203001",""],[6189,"قراءة في جسد اللؤلؤة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83584&r=&rc=51",""],[5126,"قولا لذات اللّمى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87803&r=&rc=18",""],[6366,"آتٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86672&r=&rc=1",""]],"verses":[["مُعيني عَلى الأَيّامِ إِن غالَبَت يَدي","وَإِن كُنتُ مَعدُوّاً عَلَيَّ وَعادِيا",0,"ي",2,0],["مُعيدُ ضِرابٍ بِالِسانِ لَوَ أَنَّهُ","بِيَومِ وَغىً فَلَّ الجُرازَ اليَمانِيا",1,"ي",2,0],["مُعيني عَلى الأَيّامِ فَجَّعنَني بِهِ","فَما لي عَلى أَحداثِهِنَّ مُعينُ",2,"ن",1,0],["مَعي صاحِبٌ مِن سِرِّ عَدنانَ ماجِدٌ","مُضيءُ نَواحي الوَجهِ غَمرُ الخَلائِقِ",3,"ق",1,0],["مَعي كُلُّ فَضْفاضِ الرِّداءِ سَمَيْدَعٍ","أُصاحِبُ منهُ في الوَقائِعِ أرْوَعا",4,"ع",2,0],["مَعي مَن كَفاني غَلاءَ السِبا","وَسَمعَ القُلوبِ وَإِبصارَها",5,"ر",3,0],["معْيي المماثل في علمٍ وفيض ندًى","فالسحب باكية والبحر ملتطمُ",6,"م",1,0],["مُعِينَا مُغرمٍ إذْ لا معينٌ","نصيرَا مُسْلَمٍ متظاهران",7,"ن",1,0],["مَعي فِتيَةٌ ما يَسأَلونَ بِهالِكٍ","إِذا ما تَناشوا أَسبَلوا سَبَلَ الأُزرِ",8,"ر",1,0],["مُعيداً على مُهجتي بحَفِيفِ","جَناحَيْهِ صَوْتَ الأَسى المائتِ",9,"ت",1,0],["مَعي الأَخَوات الهالِكات عَلَيكُما","وَأمّكما الثَكلى المُضَرّمة الصَدرِ",10,"ر",1,0],["مَعي صارِمٌ قَد أَخلَصَ القَينُ صَقلَهُ","لَهُ حينَ أَغشيهِ الضَريبَةَ رَونَقُ",11,"ق",1,0],["مَعي سِلاحي وَمَعي مِجَنّي","وَصارِمٍ يَذهَبُ كُلَ ضَغنِ",12,"ن",1,0],["مَعي أَصمَعَ كَظَبا المُرهِفا","تِ أَفري بِهِ عِن بَناتِ السِيَر",13,"ر",1,0],["مُعيدينَ وِردَ الحَوضِ قَد هَدَّمَ البِلى","نَصائِبَهُ وَاِنمَحَّ مِنهُ المَراكِضُ",14,"ض",1,0],["معي كتاب القاضي","بكل من في الدارْ",15,"ر",1,0],["مُعيداتُ حَبسٍ عِندَ كُلِّ لُبانَةٍ","مُقَيَّدَةٌ قُبُّ البُطونِ سِمانُ",16,"ن",1,0],["مَعي كُلُّ غِرٍّ قَد عَصى عاذِلاتِهِ","بِوَصلِ الغَواني مِن لُدُن أَن تَرَعرَعا",17,"ع",2,0],["مُعيدِ قَمَطرِ الرِجلِ مُختَلِفِ الشَبا","شَرَنبَثِ شَوكِ الكَفِّ شَثنِ البَراثِنِ",18,"ن",1,0],["مَعي اِبنُ غَريرٍ واقِفاً في عَباءَةٍ","لِعَمري لَقَد قَرَّت عُيُونُ بَني نَصرِ",19,"ر",1,1],["مُعيدُ وَردٍ وَصَدَر","وَإِن عَلا الأَمرُ اِقتَدَر",20,"ر",1,0],["مُعِيدٌ مُبْدِئٌ فالأمّ ممّا","فعَلْتَ البِكْرُ وابْنَتُها العَوانُ",21,"ن",1,0],["مَعي مارِنٌ لَدنٌ يُخَلّي طَريقَهُ","سِنانٌ كَنِبراسِ النِهامِيِّ مِنجَلُ",22,"ل",1,0],["معي: عتبٌ أوجهُهُ إليكم","وقد تصفو المودة بالعتاب",23,"ب",1,0],["معين الدمع لن يبقى معينا","فمن أي المصائب تدمعينا",24,"ن",2,1],["مَعي صاحِبٍ داجِنٌ بِالعَزاةِ","وَلَم يَكُ في القَومِ وَغلاً ضَعيفا",25,"ف",2,0],["معين العاجزين نصيرٌ لاج","دهى من صدمة الدهر المربع",26,"ع",1,0],["معيد ومحي فاحي بالفكر مهجتي","مميت امتنى ناطق القلب بالذكر",27,"ر",1,0],["معيني على الأيام لاعت جوانحي","شكاتك حتى ما أكاد أبين",28,"ن",1,1],["مُعَيشِيقَ النُّعَيمَةِ والمُحَيَّا","مُوَيمِيقَ الوُصَيلَةِ والدُّلَيلِ",29,"ل",1,0],["مُعَيدِىِّ النُّظَير لُه وُرَيدٌ","قُوَيفٌ لِلفُسَيِّقِ والزُّلَيلِ",29,"ل",1,0],["مَعِين المعاني الذي لفظهُ","رشيقُ المباني رقيقٌ حسنْ",30,"ن",1,0],["مَعِي كُلَّ حينٍ بانَ عَنّي أو دَنا","فَقَلبي بِسلُوانٍ بهِ مُتكتَمُ",31,"م",1,0],["مَعِي طَرَبٌ لا يُطِيعُ المَلامَ","وَلَيْسَ يُقَصِّرُ عَنْ فَتْكِهِ",32,"ك",2,0],["معي صاحباً صِدْقٍ إذا مِلْتُ مَيْلَةً","وكانَ بِدَفَّيْ نِضْوَتي عَدَلاني",33,"ن",2,1],["معيري أيام الوصال استعارها","ولا بدّ يوما أن ترَدّ الودائع",34,"ع",1,0],["معي قعبي ومحبرتي وفالي","وتقويم النحوس بلا غشوش",35,"ش",1,0],["مَعي اِبنا صُرَيمٍ دارِعانِ كِلاهُما","وَعُروَةُ لَولاهُم لَقيتُ الدَهارِسا",36,"س",2,0],["مُعيدُ شَملِ الإِسلامِ مُلتَئِماً","وَكانَ لَولاهُ غَيرَ مُلتَئِمِ",37,"م",1,0],["مَعي الحَبيبُ وَصافِيات الكُؤوس","فَاِسقِني وَاِملا",38,"ل",2,0],["مُعِينٌ كُلَّ آوِنَةٍ مُعَانٌ","فَيَا لَك مِنْ مُعِينٍ أَو مُعانِ",39,"ن",1,0],["معيني عَلى نَفسٍ شتيتٌ جميعُها","(للمياء) من دون الأنام نزوعُها",40,"ع",3,1],["مُعينٌ لخيرِ الدين نجلٌ محمّد","وَخالفهُ الماضي لروقٍ يهمّهُ",41,"م",2,0],["مُعيناً لِلأَرامِلِ وَاليَتامى","أَمينَ الجَيبِ عَن قُربٍ وَنَأيِ",42,"ا",2,0],["مَعي رُدَينِيُّ أَقوامٍ أَذودُ بِهِ","عَن حَوضِهِمِ وَفَريصي غَيرُ مَرعودِ",43,"د",1,0],["معينها قلب","في جوفه قلبان",44,"ن",1,0],["مَعينُ النَّدى ما تَرى من فتىً","يُعِدُّ رِشاءً عليه مُعينا",45,"ن",2,0],["مُعينُك مَن أنت المُعينُ لدينه","وكافيكَ في الدُّنْيا صُروفَ الغَوائل",46,"ل",1,0],["مَعيشةٌ رابحةٌ عندَهم","عِلّتُها كلَّ غَداةٍ تُزاح",47,"ح",1,0],["مَعي كَلماتٌ ما يُطاقُ احتِمالُها","أوَدُّ إِذا ما قُلتُها لو أُقالُها",48,"ل",3,1],["معين النَدى عالي المَدى وآكف الجَدا","مَريق الدِما وَالحَرب تسعر نارُها",49,"ر",3,0],["مَعينُ النَدى ماء مَعروفه","يَجِمُّ إِذا ماءَ عُرفٍ نَضَب",50,"ب",1,0],["مُعينَ الدّينِ كم لك طوقُ منٍّ","بجيدي مثلُ أطواقِ الحَمامِ",51,"م",1,0],["معيرة بدر التم وجهاً وطلعةً","لقد فتكت عيناك فاستعملي الرفقا",52,"ق",2,0],["معي خِلَعُ الثناء وليس منها","خليعٌ إن عزَمْتُ على الجديدِ",53,"د",1,0],["معي إلى ما سَرَّه أو ضَرَّه","حبّاً لأن يقال خِلٌّ مؤتمنْ",54,"ن",1,0],["معي أين مالت بي من الأرض حاجةٌ","أعطِّفُه حتى كأنّي مفاصلُهْ",55,"ل",2,0],["مُعيضِ الجياد الجرد في كل مأزق","بماء الطُّلى والهام عن كل مورد",56,"د",1,0],["مُعينٌ على الجُلَّى وشيكٌ إلى القرى","لَمُوحٌ لأعْقابِ الأمورِ لَبيبُ",57,"ب",1,0],["معينُ معانِ هنَّ أشهى من الكرى","لطرفٍ وأحلى في وصالٍ من العتب",58,"ب",1,0],["معير الحميا نشوةً من لحاظهِ","وواهب خوط البان حسن الشمائل",59,"ل",1,0],["مَعينَةُ النَفسِ عَلى لِذّاتِها","وَرلااحَةُ الأَرواحِ مِن عِلّاتِها",60,"ه",2,0],["معي كلُّ مسترخي الإزار كأنّه","إذا مشى من أخمص الرِّجل ظالعُ",61,"ع",1,1],["مَعي مَشرَفِيٍّ كَالعَقيقَةِ صارِمٌ","بِهِ أَثَرٌ بِالمُتنَتَينِ مُدَرَّجُ",62,"ج",1,0],["معي مفاتيح بيت الشعر أحملها","كي أفتح الكون من قطب إلى قطب",63,"ب",1,0],["معي سرها باق وإن حجد السوى","وإن غشي الليل الذي هو مظلم",64,"م",1,0],["معي كلُّ بَسَّامٍ أغَرَّ مُسَاعِدٍ","على كل ما يَهْوَى النّديمُ مُوَاتِي",65,"ت",2,0],["مَعِي أَراهُ وفي البَيْداءِ حُفْرته","يا حرَّ قلْبَاه مِنْ ذا الحاضِرِ البَادِي",66,"د",2,0],["مُعيدِ النَّدى مُبدِي الهُدى فائِض الجدَا","مُبيدِ العِدَا جمَّاعِ شَملِ المآثرِ",67,"ر",1,0],["معين بِنَفس المَرء يَجري تَرقرقا","إِذا حَسبته غَيض جَرجر دَاويا",68,"ي",2,0],["مَعي كُلُّ أَواهٍ بَرى الصَومُ جِسمَهُ","فَفي الجِسمِ مِنهُ نَهكَةٌ وَشَحوبُ",69,"ب",1,0],["معينتي في الصبا","حتى سئمت الرخاء",70,"ا",2,0],["مَعي كُلّ غِرَّقَد عَصى عاذِلاتِهِ","بِوَصلِ الغَواني مُنذُ لَدُن أَن تَرَعرَعا",71,"ع",2,0],["مُعَيْسيلُ اللَّمى غَنِجٌ أعِدَّتْ","لِتَعْذِيبِي ثنَايَاه العِذَابُ",72,"ب",1,0],["معي في الغداوات إما","غدوت وفي ظلمات الليالي معي",73,"ع",2,0],["معي خير خلق الله مفتاح نصرتي","أمنت به من كل ما كنت احذره",74,"ر",2,0],["معيب كثير العيب قد صاغه الذي","تلبس بالذنب العظيم وبالوزر",75,"ر",1,0],["مَعي صاحِبٌ مِثلُ نَصلِ السِنانِ","عَنيفٌ عَلى قِرنِهِ مِغشَمُ",76,"م",1,0],["معي حيث كنتم في رفيع المنازل","عبيدك يا مولاي قد طال حزنه",77,"ه",1,0],["مع يا يضم اسم فريد معرفه","والنكر بالقصد نظير المعرفه",78,"ه",1,0],["معينة لطالب له أرب","في النظم أو يدري بها شعر العرب",79,"ب",1,0],["معينة للطالب الوزان","على قبول العذر في الأوزان",79,"ن",1,0],["معيشة ليث ليس يأوي لراحة","يخال إذا ما جدت الحرب يلعب",80,"ب",1,0],["معيد الذوات الفانيات كبدئها","لتظهر مجد القدرة المطلقية",81,"ه",1,1],["معيد أيادي الفضل من غير موجب","سوى كرم محض وواسع رحمة",81,"ه",1,0],["مُعِيدُ طِعَانٍ كَالرّشَاءِ إِذَا ارْتَمَى","بِدَلْوٍ لَهُ تَزْهَى بِأَيِّ فَرَاغِ",82,"غ",1,0],["معينٌ بلا غمضٍ كأَنَّ جفونها","حلفنَ بمن تهواه أنْ لا تلاقيا",83,"ي",2,0],["معيدٌ لما أبداه في الجود لا كمن","إذا جاء لا يغدو معيداً لما يبدي",84,"د",2,0],["مَعي كُلُّ وضاح الجبين سَمَيدعٍ","ثقيل تباريهِ خفيفٍ ذَلاذِلُه",85,"ل",2,0],["مَعي من بني اللهوِ الكرامِ عصابةٌ","ألا يا لَقَومي للصِبا المُتَرَعرِع",86,"ع",1,0],["معي كل مسترخي الازار كأنه","اذا ما مشى من جن غيل وعبقرا",87,"ر",2,0],["معين الماء كوثره مزاج","لخمر الحب برهان الدَليل",88,"ل",1,0],["معي حسبي لم أرز منه رزية","ولم تبد لي يوم الحفاظ عيوبُ",89,"ب",1,0],["مَعي فِتيَةٌ بيضُ الوُجوهِ كَأَنَّهُم","عَلى الرَحلِ فَوقَ الناعِجاتِ بُدورُ",90,"ر",1,0],["مُعِينُكَ اللَهُ فِيما أَنتَ طالِبُهُ","مِنَ العُلى وَأَمِينُ اللَهِ جِبرِيلُ",91,"ل",1,0],["مُعَيسيل اللُّمى أزال اليَمي","بذيّاك اللذي سُمّي اللُّمَيّا",92,"ي",2,0],["معيد وغى يثني به البيض والقنا","من الضرب أنهاراً وللطعن آبارا",93,"ر",2,0],["معي كُلُّ فضفاضِ القَميصِ كأنَّهُ","اذا خَطَرَت مِنهُ المُدامُ فَتِيقُ",94,"ق",1,1],["مَعين غَناك اليَوم أَصبَح ناضباً","وَلَم يَبقَ مِنهُ في يَديك سِوى النَزر",95,"ر",1,0],["مَعي مارِنٌ في الكَفِّ لَدنٌ كَعوبُهُ","وَأَبيَضُ ماضٍ في الضَريبَةِ مخفَقُ",96,"ق",1,0],["مع