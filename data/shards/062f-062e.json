ا","https://www.aldiwan.net/poem10270.html","الوافر"],[514,"تلثم بالعقيق على اللآلي","https://www.aldiwan.net/poem20793.html","الوافر"],[514,"طلبت عظيم المجد بالهمة الكبرى","https://www.aldiwan.net/poem20833.html","الطويل"],[529,"ذهب الظلم والهرج","https://www.aldiwan.net/poem37481.html","مجزوء الخفيف"],[538,"ألا ليت شعري هل تكونين مثلها","https://www.aldiwan.net/poem48286.html","عموديه"],[551,"من ذا الذي ينجو من الآجال","https://www.aldiwan.net/poem47273.html","الكامل"],[551,"لك الليل بعد الذاهبين طويلا","https://www.aldiwan.net/poem47299.html","الطويل"],[551,"أمالك من غرام ما أمالا","https://www.aldiwan.net/poem47319.html","الوافر"],[551,"يا ثاويا خلف الرتاج المطبق","https://www.aldiwan.net/poem47356.html","الكامل"],[551,"كل يوم غريبة للخطوب","https://www.aldiwan.net/poem48056.html","الخفيف"],[551,"ما نحن إلا للفناء","https://www.aldiwan.net/poem48110.html","مجزوء الكامل"],[558,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[558,"أنا عبد الغني أي عبد ذات ال","https://www.aldiwan.net/poem33518.html","الخفيف"],[558,"عين حق إنسانها الإنسان","https://www.aldiwan.net/poem33815.html","الخفيف"],[558,"دخل إلى بيت قلبي بارقه رفرف","https://www.aldiwan.net/poem34347.html","المواليا"],[558,"لبسنتني مليحة الغيب مرطا","https://www.aldiwan.net/poem34406.html","الخفيف"],[558,"اغسلوا بي نجاسة الوسواس","https://www.aldiwan.net/poem34440.html","الخفيف"],[558,"ألا يا لقومي من غزالة وجرة","https://www.aldiwan.net/poem34924.html","الطويل"],[567,"دخيل في الكتابة لا روي","https://www.aldiwan.net/poem69470.html","الوافر"],[575,"جاءت بحسن مطمئن","https://www.aldiwan.net/poem3000.html","مجزوء الكامل"],[575,"يا ليلة الوصل بل يا ليلة العمر","https://www.aldiwan.net/poem3063.html","البسيط"]],"verses":[["دُخولٌ عَلى زُحلوفَةِ الخَطبِ بَعدَما","تَرامَت بِهِم أَرجاءُ مُظلِمَةِ القَعرِ",0,"ر",1,0],["دُخانٌ تَلهَبُ الهَبَواتُ مِنهُ","مَدى بَينَ البَسيطَةِ وَالسَماءِ",1,"ا",2,0],["دَخَلتُ عَلَيهِ وَهوَ في صَحنِ دارِهِ","عَلى سُدَّةٍ نُصَّت عَلَيها مَراتِبُه",2,"ب",2,0],["دَخَلتُ عَلى اِبنِ الشَهرزوريِّ لَيلَةً","وَقَد أُغلِقَت دونَ الوَزيرِ المَغالِقُ",3,"ق",1,1],["دَخَلتُ عَلى بَيضاءَ جُمٍّ عِظامُه","تُعَفّي بِذَيلِ الدِرعِ إِذ جِئتُ مودَقي",4,"ق",2,0],["دخلت الثماني والثلاثين همتي","على غير ودي والفؤاد كئيب",5,"ب",1,1],["دخلتُ به عند الصباح على التي","سقاني بكاها في الجدى كأس علقم",6,"م",1,0],["دَخَلنَ حُصونَ مَذحِجَ مُعلِماتٍ","وَلَم يَترُكنَ مِن صَنعاءَ بابا",7,"ب",2,0],["دَخَلنَ قُصورَ يَثرِبَ مُعلِماتٍ","وَلَم يَترُكنَ مِن صَنعاءَ بابا",8,"ب",2,0],["دَخِيلٌ في الفَؤَادِ يَهِيجُ سُقماً","وَحُزناً كانَ من جَذَلٍ مَنُوعَاً",9,"ع",2,0],["دَخَلتُ بِناسوتي لَدَيكَ الخَلقِ","وَلَولاكَ لاهوتي خَرَجتُ مِنَ الصِدقِ",10,"ق",1,1],["دَخَلْنَا من بنات البحر جوناً","تهادى بين شبَّانٍ وشيبِ",11,"ب",1,0],["دخلت على خالد مرةً","وقد غاب في ذاته الأصلعُ",12,"ع",1,1],["دخلوها كأنهم قِطع اللْي","لِ إذا راحَ مُدْلَهِمَّ الظلام",13,"م",1,0],["دَخَلتُ مِصرَ غَنِيّاً","وَلَيسَ حالي بِخافِ",14,"ف",1,1],["دخل الذئاب حمى العرين تدوسه","لا الاسد تحميه ولا اشبالها",15,"ل",3,0],["دَخَلتُكِ وَالأَصيلُ لَهُ اِئتِلاقٌ","وَوَجهُكِ ضاحِكُ القَسَماتِ طَلقُ",16,"ق",1,0],["دَخَلَتها عَلَيكَ عُثمانُ في السِل","مِ وَقَد كُنتَ في الوَغى لا تُرامُ",17,"م",1,0],["دَخَلَت مَنازِلَها المَنو","نُ عَلى الجَريءِ المُشبِلِ",18,"ل",1,0],["دَخَلَ الكَنيسَةَ فَاِرتَقَبتُ فَلَم يُطِل","فَأَتَيتُ دونَ طَريقِهِ فَزَحَمتُهُ",19,"ت",2,0],["دَخَلتُها وَحَواشيها زُمُرُّدَةٌ","وَالشَمسُ فَوقَ لُجَينِ الماءِ عِقيانُ",20,"ن",1,0],["دَخَلَ العُشَّ عَلى أَنسُرِهِ","أَتُرى يَغشى مِنَ النَجمِ السَناما",21,"م",2,0],["دَخَلَت عَلى حُكمِ الوِدادِ وَشَرعِهِ","مِصراً فَكانَت كَالسُلالِ دُخولا",22,"ل",2,0],["دَخَلوا السَريرَ عَلَيكَ يَح","تَكِمونَ في رَبِّ السَرير",23,"ر",1,0],["دَخَلوا ثَيبَةً فَأَحسَنَ لُقيا","هُم رِجالٌ بِثيبَةٍ حُكَماءُ",24,"ا",2,0],["دَخَلتَها وَشُعاعُ الشَمسِ مُتَّقِدُ","وَنورُ وَجهِكَ بَينَ الخَلقِ باهِرُهُ",25,"ر",2,0],["دَخَلوا قُبورَهُمُ إِذا اِضطَجَعوا","فيها بِأَوعِيَةٍ لَهُم صِفرِ",26,"ر",1,0],["دَخَلَت عَلى مَلِكِ المُلوكِ رِواقَهُ","وَتَشَزَّنَت لِمُقَوِّمِ القُوّامِ",27,"م",1,0],["دخلتُ يوماً دارَهُ","فقالَ لي شخصٌ جثا",28,"ث",2,1],["دَخَلتُ عَلى خَوفٍ فَأَرَّقتُ كاعِباً","هَضيمَ الحَشا رَيّا العِظامِ كَسولا",29,"ل",2,0],["دَخلتَ العَريشَ على نَعجتيك","فَسُبحانَ ربِّكَ ما أعظَمَهْ",30,"م",2,0],["دخلاءَ البلاد إنَّ فلسطي","ن لأَرضٌ كنوزها من نكال",31,"ل",1,0],["دخلنَ عواذلي من كلّ بابِ","ولمنَ على التلذّذِ والتصابي",32,"ب",2,1],["دَخَلتُ مُسارِقاً رَصدَ الأَعادي","عَلى سِتٍّ وَمَدخَلُنا خِطارُ",33,"ر",1,0],["دَخَلَ الحُبُّ لِهِندٍ","قَلبَهُ مِن كُلِّ بابِ",34,"ب",1,0],["دخلتُها غِرّاً وعد","تُ فانياً مجرّبا",35,"ب",2,0],["دخلتها وشعاع الشمس متقدٌ","ونور وجهك بين الخيل باهره",36,"ر",2,0],["دخلوا عَليك البيتَ جسماً ضارِعاً","مُتَفَرّداً والموتُ بالمرْصادِ",37,"د",1,0],["دَخَلَتْ بي إليه ذاتَ مساءٍ","حيثُ لا ضجةٌ ولا أشباحُ",38,"ح",1,0],["دخلتَ من بابهِ واجتزتَ ساحتَه","وسِرتَ فيهِ على آثارِ من ساروا",39,"ر",3,0],["دَخَلْنَاهَا بِلاَ قَصْدٍ","وَأَدْمَتْنَا بِلاَ وَتْرِ",40,"ر",1,0],["دُخَانُهَا يُؤنِسُنِي رَاقِصاً","مُبْتسِماً وَالجَوِّ بَاكٍ عَبُوسْ",41,"س",1,1],["دخلَ الغيَ على رئبالهِ","قدرٌ نذلٌ أخو مكرٍ ودَسّ",42,"س",1,0],["دَخَلتُ عَلى بَيضاءَ جُمٍّ عِظامُها","تُعَفّي بِذَيلِ الدِرعِ إِذ جِئتُ مودَقي",43,"ق",2,0],["دَخَلُوا عَلَى الْعِقْبانِ في أوْكارِها","وتسَرَّبُوا لمسابِحِ الأسمَاكِ",44,"ك",1,0],["دَخَلَ الموتُ، يسرقُ الخطوَ، لصًّا","بين رقص الدُّمى، وعزفِ الكَمان",45,"ن",1,0],["دخلوا على الأسْد الشَّرى","وقعدت أنت على الوصيد",46,"د",1,0],["دخروك للإسلام ندبا أروعا","سحب الندى ضخيم الهموم هماما",47,"م",2,0],["دخلت (صنعاء) بابا ثانيا","ليتها تدري ، إلى اين أفتتح",48,"ح",1,0],["دخلها كلّ ليلة نصف ألف","أحسنوا الظنّ . تهمة لا إدانه",49,"ن",2,0],["دَخَلتُ على بَيضَاءَ جُمٍّ عِظَامُهَا","تعفي بذيل الدرع إذا جئتُ مودقي",50,"ق",2,0],["دخلت على تاريخنا ذات ليلةٍ","فرائحةُ التاريخ مسكٌ وعنبرُ",51,"ر",1,0],["دخيل على الغوث الرفاعي وشبله","أبى الهمم الصياد غوث البرية",52,"ه",1,1],["دخيل على عليا رحاب جنابه","وقد محيت مني رسوم المعالم",53,"م",1,0],["دخلت بأسماء الاله لبابه","أومل بالأسماء من بابه جبري",54,"ي",1,0],["دَخَلنا بِهِ في ظِلِّ أَمنٍ وَعِصمَةٍ","أَتَتنا بِهِ لِلَّهِ أَسبَغُ نِعمَةٍ",55,"ه",1,0],["دَخَلنا بِهِ في الدين مِن كُلِّ وجهَةٍ","وَكُلُّ سَبيل فيهِ أَحمَدُ يُحمَدُ",56,"د",1,0],["دخلتُ حَمَّاما على غِرةٍ","لما دعاني سوءُ حَظٍّ وحَيْنْ",57,"ن",1,1],["دخلتُ دواوين الملوك فلم أجد","يعذب فيها غير مثر ومسترف",58,"ف",1,0],["دَخلوها بِدينِهم جاهِلينا","وَتغذّوا فيها الضلالَ سِنينا",59,"ن",2,0],["دَخلوا مكّة ففرّت أسودٌ","مِن قُريشٍ كأنّما هم ظباءُ",60,"ا",2,0],["دخلتُ بابَ الهوى ولي بَصَرٌ","وفي خروجي عميتُ عن بابِهْ",61,"ب",2,0],["دخلت إذا فيه رجال أئمةٍ","وجوههم مثل النجوم الزواهر",62,"ر",1,0],["دخلت أسيوط والآمال تعصف بي","وتوقظ الوجد في أعماق وجداني",63,"ي",1,1],["دخلتُ أسأل عن روح كلفت به","قبل الوجود بأزمان وأزمان",63,"ن",1,0],["دخلت أسيوط أستشفى بطلعته","فعدت أحمل آلامي وأحزاني",63,"ي",1,0],["دخلتك عانياً في أسر ليل","أصم القلب زنجي الإهاب",64,"ب",1,0],["دخل الصبُّ غَيرَ أَنَّ شراراً","كانَ في مُقلَتَيه يسعُر سعرا",65,"ر",2,0],["دخل الشرك في قلوبهم الغلب","دخول النصول في الأرعاظ",66,"ظ",1,0],["دَخَلَ المَدينَةَ فَاِكتَست حُلَلَ الرِضى","وَتَعَطَّرَت بِالروحِ وَالرَيحانِ",67,"ن",1,0],["دَخَلْتُ فِي حِمَى الرَّاعِي","وَقَدْ ضِقْتُ بِأَوْجَاعِي",68,"ع",2,1],["دخلت دخول الفاحين مهللا","تطمنهم من خوفهم وتطبب",69,"ب",1,0],["دخلت عليه انتصاف النهار","على غفلة حين لم يشعر",70,"ر",1,0],["دَخَلَ العشَّ وَحيداً","فبَكى الإلفَ النَّزيح",71,"ح",1,0],["دخلت أشعتُها الحَشى","فتفتَّحَت مثلَ الأقاح",72,"ح",1,0],["دَخَلَ البَيتَ جَهاراً","لَم يَدَع في البَيتِ فَلقَه",73,"ق",2,0],["دخل الأير مرةً درب كسٍّ","تائها في مهامه وبطاح",74,"ح",1,1],["دخولك بين اثنين في القول طامعا","كذلك الاستخفاف جهلا بسلطان",75,"ن",1,0],["دَخَلنَ خُدوراً فَوقَ عِيسٍ كَنينَةً","كَما كَنَسَت نِصفَ النَهارِ الجَآذِرُ",76,"ر",1,0],["دخلوا بلادك فاتحين فصنتهم","واذقتنا يا يوم مر عذاب",77,"ب",1,0],["دَخَلتُ بابَ حَطَّةٍ في خُطَّةٍ","مَسجَدُ سَمعي وَفُؤادي وَالبَصَر",78,"ر",1,0],["دَخَلوا إِلى سَمعي وَأخبرُكُمُ","أَنَّ الفُؤادَ إِلَيهِ ما دَخَلوا",79,"ل",3,0],["دخَلتُ لَها لمَّا جَنَت تَحتَ ما جَنَت","وما استَحسَنَت ظُلمي وقلتُ لَها اكتُمي",80,"ي",1,0],["دخلنا إلى الدنيا عراةً وإننا","عراةً نفارقها ولا خُلفَ في الأمر",81,"ر",1,0],["دُخانَها زَفَراتي وَالحَريق بِها","قَلبي بِلا زَلة وَالدَمع كَالشَرر",82,"ر",1,0],["دخولُ النارِ في حبِّ الوَصِيِّ","وَفي تَفضيلِ أَولادِ النَبِيِّ",83,"ي",1,1],["دخلتُ إلى جَوْفٍ كريمٍ مُطَهَّرٍ","فعشت من الإحساسِ مالا يُعَلَّلُ",84,"ل",1,0],["دخلت إلى منازل كل بيت","فكل في معانيه إمام",85,"م",1,0],["دَخَلْتَ البصرة الفيحاءَ صُبحاً","ونارُ الشّرِّ تَتَّقِدُ اتّقادا",86,"د",2,0],["دخلت حانتها ليلاً أطوف بها","فاشرق الدن صبحاً والشذا نفحا",87,"ح",2,0],["دخان صادوم من جيراننا وكذا","من سقفنا طوفان الدلف قد قطرا",88,"ر",2,0],["دخلت خبا عليا وقد اطها الكرى","وقد بلني النادي ولم أمتش الحنوى",89,"و",2,0],["دخلت برحمة ربها وسعادةٍ","سبقت لها من فضله أفضالها",90,"ل",3,0],["دخل الأوحدُ في ألقابهِ","لفظةً واقعةً جاءت لمعنَى",91,"ن",2,0],["دُخانٌ للنُّجومِ بهِ اخْتفِاءٌ","ونَقْعٌ للشموسِ بهِ نِقابُ",92,"ب",1,0],["دخلتُ بأفكاري حظيرة قدسها","فأضحت في الهم الزيادي في حرم",93,"م",1,0],["دخلت صفوفا للدرو","س دخول جيس الانتصار",94,"ر",1,0],["دخل السرور على الفؤاد مباغتا","بحصول أمر دونه الإجرام",95,"م",1,0],["دخلت السجن محسودا عليه","كذلك يسجن الرجل الشريف",96,"ف",1,1],["دخلت مداخلا لا بدّ منها","أتسألني ولست ألام عنها",97,"ن",3,1],["دخلنا حمى الفضال يحمي لقاحنا","عن الفتك يا حنان يسرنا لليسرى",98,"ر",2,0],["دخلت على الرسول وكان غثا","ثقيل الروح ذا حمق وجهل",99,"ل",1,1],["دخلْتُ عليه والظُلُماتُ تُرخي","ذَوائِبَها على صَلْتِ الهِلالِ",100,"ل",1,0],["دخلتَ عليها بعدما اِنكشفَ الغِطا","فكُنتَ لعوراتِ الزّمانِ لها سِترا",101,"ر",2,0],["دَخَل الْعِزُّ أَرْضَنا","وأَرَى الذُّلَّ قَدْ خَرَجْ",102,"ج",1,0],["دخلتَ دخولَ الظبِي مشياً ولَفتةً","وأينَ من الظبِي الملاحةُ تُسكَبُ",103,"ب",1,0],["دخّالِ كلِّ كريهةٍ ولّاجِها","جوّابِ كلِّ عظيمةٍ جوّالِ",104,"ل",1,0],["دخلتَ على أبياتهمْ بمصابهمْ","ألا بئسما ذاك الدّخول دُخولا",105,"ل",2,0],["دخلتُ عليه مجلسَه فأدنى","وأعلاني مكاناً لا يُعالى",106,"ل",2,0],["دخل الزّمانُ كما كرهنا بيننا","وَرمَى اِجتِماعاً بيننا بتفرّقِ",107,"ق",1,0]