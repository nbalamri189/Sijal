{"poems":[[53,"تجاف عن الأعداء بقيا فربما","https://www.aldiwan.net/poem30413.html","الطويل"],[53,"بهاء الملك من هذا البهاء","https://www.aldiwan.net/poem30782.html","الوافر"],[71,"ظننت سليمانا جوادا يهزه","https://www.aldiwan.net/poem3738.html","الطويل"],[71,"دخلت على ابن الشهرزوري ليلة","https://www.aldiwan.net/poem3808.html","الطويل"],[0,"ألا انعم صباحا أيها الربع وانطق","https://www.aldiwan.net/poem79.html","الطويل"],[93,"دخلت الثماني والثلاثين همتي","https://www.aldiwan.net/poem9838.html","الطويل"],[88,"رمت مسمعي ليلا بأنه مؤلم","https://www.aldiwan.net/poem45022.html","الطويل"],[27,"أهاج البرق ليلة أذرعات","https://www.aldiwan.net/poem5663.html","الوافر"],[27,"أقلي اللوم عاذل والعتابا","https://www.aldiwan.net/poem5686.html","الوافر"],[37,"نفى عن عينك الأرق الهجوعا","https://www.aldiwan.net/poem7654.html","الوافر"],[64,"دخلت بناسوتي لديك الخلق","https://www.aldiwan.net/poem67621.html","الطويل"],[51,"ذكرتك حين ألقت بي عصاها","https://www.aldiwan.net/poem8527.html","الوافر"],[51,"دخلت على خالد مرة","https://www.aldiwan.net/poem65421.html","المتقارب"],[51,"ذاد عن مقلتي لذيذ المنام","https://www.aldiwan.net/poem66325.html","الخفيف"],[70,"دخلت مصر غنيا","https://www.aldiwan.net/poem42805.html","المجتث"],[89,"ويل لمملكة قضى اهمالها","https://www.aldiwan.net/poem44846.html","الكامل"],[85,"سلام من صبا بردى أرق","https://www.aldiwan.net/poem24321.html","عموديه"],[85,"هالة للهلال فيها اعتصام","https://www.aldiwan.net/poem62829.html","الخفيف"],[85,"ما بين دمعي المسبل","https://www.aldiwan.net/poem62836.html","مجزوء الكامل"],[85,"السحر من سود العيون لقيته","https://www.aldiwan.net/poem62984.html","الكامل"],[85,"قم ناج جلق وانشد رسم من بانوا","https://www.aldiwan.net/poem63693.html","البسيط"],[85,"قم سليمان بساط الريح قاما","https://www.aldiwan.net/poem63696.html","الرمل"],[85,"أيامكم أم عهد إسماعيلا","https://www.aldiwan.net/poem63755.html","الكامل"],[85,"سل يلدزا ذات القصور","https://www.aldiwan.net/poem63770.html","مجزوء الكامل"],[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[43,"حاشى الرقيب فخانته ضمائره","https://www.aldiwan.net/poem9571.html","البسيط"],[28,"حبلا به رجعت نفوسكم","https://www.aldiwan.net/poem5132.html","الكامل"],[44,"ما للدموع تروم كل مرام","https://www.aldiwan.net/poem30362.html","الكامل"],[69,"دخلت يوما داره","https://www.aldiwan.net/poem29102.html","مجزوء الرجز"],[31,"أرقت ولم آرق لسقم أصابني","https://www.aldiwan.net/poem41851.html","الطويل"],[105,"لك الله أقبل أبا خيثمه","https://www.aldiwan.net/poem44026.html","المتقارب"],[102,"أدموع النساء والأطفال","https://www.aldiwan.net/poem33120.html","الخفيف"],[48,"دخلن عواذلي من كل باب","https://www.aldiwan.net/poem66249.html","الوافر"],[50,"أأحزنك الألى ظعنوا فساروا","https://www.aldiwan.net/poem63810.html","الوافر"],[50,"طال في هند عتابي","https://www.aldiwan.net/poem64825.html","مجزوء الرمل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125577","الرجز"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140826",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39641","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39543","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39573","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54824","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54974","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142048","الرمل"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1941","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54198","الكامل"],[106,"سفينة الموت","https://www.poetsgate.com/ViewPoem.aspx?id=179666",""],[106,"الهلال الأحمر","https://www.poetsgate.com/ViewPoem.aspx?id=179420",""],[77,"قلدت من نصر الإله حساما","https://www.poetsgate.com/ViewPoem.aspx?id=34200",""],[0,"ألا انعم صباحاً أيها الربع وانطقِ","https://www.poetsgate.com/ViewPoem.aspx?id=4799",""],[99,"إليه في يوم ميلاده","https://www.poetsgate.com/ViewPoem.aspx?id=211910",""]],"verses":[["دُخولٌ عَلى زُحلوفَةِ الخَطبِ بَعدَما","تَرامَت بِهِم أَرجاءُ مُظلِمَةِ القَعرِ",0,"ر",1,0],["دُخانٌ تَلهَبُ الهَبَواتُ مِنهُ","مَدى بَينَ البَسيطَةِ وَالسَماءِ",1,"ا",2,0],["دَخَلتُ عَلَيهِ وَهوَ في صَحنِ دارِهِ","عَلى سُدَّةٍ نُصَّت عَلَيها مَراتِبُه",2,"ب",2,0],["دَخَلتُ عَلى اِبنِ الشَهرزوريِّ لَيلَةً","وَقَد أُغلِقَت دونَ الوَزيرِ المَغالِقُ",3,"ق",1,1],["دَخَلتُ عَلى بَيضاءَ جُمٍّ عِظامُه","تُعَفّي بِذَيلِ الدِرعِ إِذ جِئتُ مودَقي",4,"ق",2,0],["دخلت الثماني والثلاثين همتي","على غير ودي والفؤاد كئيب",5,"ب",1,1],["دخلتُ به عند الصباح على التي","سقاني بكاها في الجدى كأس علقم",6,"م",1,0],["دَخَلنَ حُصونَ مَذحِجَ مُعلِماتٍ","وَلَم يَترُكنَ مِن صَنعاءَ بابا",7,"ب",2,0],["دَخَلنَ قُصورَ يَثرِبَ مُعلِماتٍ","وَلَم يَترُكنَ مِن صَنعاءَ بابا",8,"ب",2,0],["دَخِيلٌ في الفَؤَادِ يَهِيجُ سُقماً","وَحُزناً كانَ من جَذَلٍ مَنُوعَاً",9,"ع",2,0],["دَخَلتُ بِناسوتي لَدَيكَ الخَلقِ","وَلَولاكَ لاهوتي خَرَجتُ مِنَ الصِدقِ",10,"ق",1,1],["دَخَلْنَا من بنات البحر جوناً","تهادى بين شبَّانٍ وشيبِ",11,"ب",1,0],["دخلت على خالد مرةً","وقد غاب في ذاته الأصلعُ",12,"ع",1,1],["دخلوها كأنهم قِطع اللْي","لِ إذا راحَ مُدْلَهِمَّ الظلام",13,"م",1,0],["دَخَلتُ مِصرَ غَنِيّاً","وَلَيسَ حالي بِخافِ",14,"ف",1,1],["دخل الذئاب حمى العرين تدوسه","لا الاسد تحميه ولا اشبالها",15,"ل",3,0],["دَخَلتُكِ وَالأَصيلُ لَهُ اِئتِلاقٌ","وَوَجهُكِ ضاحِكُ القَسَماتِ طَلقُ",16,"ق",1,0],["دَخَلَتها عَلَيكَ عُثمانُ في السِل","مِ وَقَد كُنتَ في الوَغى لا تُرامُ",17,"م",1,0],["دَخَلَت مَنازِلَها المَنو","نُ عَلى الجَريءِ المُشبِلِ",18,"ل",1,0],["دَخَلَ الكَنيسَةَ فَاِرتَقَبتُ فَلَم يُطِل","فَأَتَيتُ دونَ طَريقِهِ فَزَحَمتُهُ",19,"ت",2,0],["دَخَلتُها وَحَواشيها زُمُرُّدَةٌ","وَالشَمسُ فَوقَ لُجَينِ الماءِ عِقيانُ",20,"ن",1,0],["دَخَلَ العُشَّ عَلى أَنسُرِهِ","أَتُرى يَغشى مِنَ النَجمِ السَناما",21,"م",2,0],["دَخَلَت عَلى حُكمِ الوِدادِ وَشَرعِهِ","مِصراً فَكانَت كَالسُلالِ دُخولا",22,"ل",2,0],["دَخَلوا السَريرَ عَلَيكَ يَح","تَكِمونَ في رَبِّ السَرير",23,"ر",1,0],["دَخَلوا ثَيبَةً فَأَحسَنَ لُقيا","هُم رِجالٌ بِثيبَةٍ حُكَماءُ",24,"ا",2,0],["دَخَلتَها وَشُعاعُ الشَمسِ مُتَّقِدُ","وَنورُ وَجهِكَ بَينَ الخَلقِ باهِرُهُ",25,"ر",2,0],["دَخَلوا قُبورَهُمُ إِذا اِضطَجَعوا","فيها بِأَوعِيَةٍ لَهُم صِفرِ",26,"ر",1,0],["دَخَلَت عَلى مَلِكِ المُلوكِ رِواقَهُ","وَتَشَزَّنَت لِمُقَوِّمِ القُوّامِ",27,"م",1,0],["دخلتُ يوماً دارَهُ","فقالَ لي شخصٌ جثا",28,"ث",2,1],["دَخَلتُ عَلى خَوفٍ فَأَرَّقتُ كاعِباً","هَضيمَ الحَشا رَيّا العِظامِ كَسولا",29,"ل",2,0],["دَخلتَ العَريشَ على نَعجتيك","فَسُبحانَ ربِّكَ ما أعظَمَهْ",30,"م",2,0],["دخلاءَ البلاد إنَّ فلسطي","ن لأَرضٌ كنوزها من نكال",31,"ل",1,0],["دخلنَ عواذلي من كلّ بابِ","ولمنَ على التلذّذِ والتصابي",32,"ب",2,1],["دَخَلتُ مُسارِقاً رَصدَ الأَعادي","عَلى سِتٍّ وَمَدخَلُنا خِطارُ",33,"ر",1,0],["دَخَلَ الحُبُّ لِهِندٍ","قَلبَهُ مِن كُلِّ بابِ",34,"ب",1,0],["دخلتُها غِرّاً وعد","تُ فانياً مجرّبا",35,"ب",2,0],["دخلتها وشعاع الشمس متقدٌ","ونور وجهك بين الخيل باهره",36,"ر",2,0],["دخلوا عَليك البيتَ جسماً ضارِعاً","مُتَفَرّداً والموتُ بالمرْصادِ",37,"د",1,0],["دَخَلَتْ بي إليه ذاتَ مساءٍ","حيثُ لا ضجةٌ ولا أشباحُ",38,"ح",1,0],["دخلتَ من بابهِ واجتزتَ ساحتَه","وسِرتَ فيهِ على آثارِ من ساروا",39,"ر",3,0],["دَخَلْنَاهَا بِلاَ قَصْدٍ","وَأَدْمَتْنَا بِلاَ وَتْرِ",40,"ر",1,0],["دُخَانُهَا يُؤنِسُنِي رَاقِصاً","مُبْتسِماً وَالجَوِّ بَاكٍ عَبُوسْ",41,"س",1,1],["دخلَ الغيَ على رئبالهِ","قدرٌ نذلٌ أخو مكرٍ ودَسّ",42,"س",1,0],["دَخَلتُ عَلى بَيضاءَ جُمٍّ عِظامُها","تُعَفّي بِذَيلِ الدِرعِ إِذ جِئتُ مودَقي",43,"ق",2,0],["دَخَلُوا عَلَى الْعِقْبانِ في أوْكارِها","وتسَرَّبُوا لمسابِحِ الأسمَاكِ",44,"ك",1,0],["دَخَلَ الموتُ، يسرقُ الخطوَ، لصًّا","بين رقص الدُّمى، وعزفِ الكَمان",45,"ن",1,0],["دخلوا على الأسْد الشَّرى","وقعدت أنت على الوصيد",46,"د",1,0],["دخروك للإسلام ندبا أروعا","سحب الندى ضخيم الهموم هماما",47,"م",2,0],["دَخَلتُ على بَيضَاءَ جُمٍّ عِظَامُهَا","تعفي بذيل الدرع إذا جئتُ مودقي",48,"ق",2,0],["دخلت على تاريخنا ذات ليلةٍ","فرائحةُ التاريخ مسكٌ وعنبرُ",49,"ر",1,0]]}