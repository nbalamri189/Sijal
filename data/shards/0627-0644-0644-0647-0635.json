{"poems":[[53,"سائل أبا الصقر إذا جئته","https://www.aldiwan.net/poem65723.html","السريع"],[87,"الملك بين يديك في إقباله","https://www.aldiwan.net/poem63756.html","الكامل"],[87,"الناس للدنيا تبع","https://www.aldiwan.net/poem63761.html","مجزوء الكامل"],[52,"الله صورها وصيرها","https://www.aldiwan.net/poem24451.html","الكامل"],[48,"الله صورني ولست بعالم","https://www.aldiwan.net/poem22487.html","الكامل"],[108,"تحيّة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179608",""],[208,"صنم تصور أحسن التصوير","https://www.aldiwan.net/poem53255.html","الكامل"],[208,"حسن تكامل في المحاسن فاغتدى","https://www.aldiwan.net/poem53272.html","الكامل"],[287,"وهو الذي لم يزل تهمي أنامله","https://www.aldiwan.net/poem32887.html","البسيط"],[369,"طلعت نجوم الدين فوق الفرقد","https://www.aldiwan.net/poem60958.html","الكامل"],[412,"بعثت إليك بطيفها تعليلا","https://www.aldiwan.net/poem50139.html","الطويل"],[412,"أما الخيال فما يغيب طروقا","https://www.aldiwan.net/poem50145.html","الكامل"],[520,"يا خير من نظم المديح لمجده","https://www.aldiwan.net/poem12063.html","الكامل"],[1202,"","https://poetry.dctabudhabi.ae/diwan/poem/145281","الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56681","الكامل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109045","الكامل"],[1715,"","https://poetry.dctabudhabi.ae/diwan/poem/17556","الكامل"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104687","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93659","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93544","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93650","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93782","البسيط"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110005","الرجز"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92423","الكامل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35622","الكامل"],[5219,"القول المسدد في معارضة همزية أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=193910",""],[5353,"ملحمة فجر الصابرين","https://www.poetsgate.com/ViewPoem.aspx?id=212649",""],[5538,"هب النسيم على محب ناءي","https://www.poetsgate.com/ViewPoem.aspx?id=142626",""],[5573,"طال السهر","https://www.poetsgate.com/ViewPoem.aspx?id=200217",""],[5804,"العربيّ المحطّم","https://www.poetsgate.com/ViewPoem.aspx?id=190682",""],[5956,"يرضى الله عنكم جميعاً","https://www.poetsgate.com/ViewPoem.aspx?id=193152",""]],"verses":[["الله صدِّيقيَ في ذمِّه","بل لؤمه المشهور صدِّيقي",0,"ق",2,0],["اللَهُ صاغَكِ جَنَّتَينِ لِخَلقِهِ","مَحفوفَتَينِ بِأَنعُمٍ لِعِيالِهِ",1,"ل",2,0],["اللَهُ صانَ رِجالَهُ","مِمّا يُدَنِّسُ أَو يَضَع",2,"ع",1,0],["اللَهُ صَوَّرَها وَصَيَّرَها","لاقَتكَ أَو لَم تَلقَها تَرَها",3,"ه",2,1],["اللَهُ صَوَّرَني وَلَستُ بِعالِمٍ","لِمَ ذاكَ سُبحانَ القَديرِ الواحِدِ",4,"د",1,1],["الله صوَّرَ لبنانًا فأبدعه","كما تأنَّقَ في التمثال فنَّان",5,"ن",1,0],["اللَهُ صوَّره بديعَ محاسنٍ","كيما يكون نموذجاً للحورِ",6,"ر",1,0],["اللَهُ صيَّره خليفةَ شمسِه","فينا وأغنانا به عن بدرِهِ",7,"ر",2,0],["اللَهُ صَوَّرَهُ مِن نورِ رَحمَتِهِ","فَالخَلقُ يَدعونَهُ يا فارِجَ الكُرَبِ",8,"ب",1,0],["اللهِ صَدْرُ زمانِه من ماجدٍ","مَلِكٍ أغَرَّ من الأكارِم أصْيَد",9,"د",1,0],["اللَهُ صَوَّرَهُ جَواداً خَلَقَهُ","وَتُريدُ منه أَن يَكون بَخيلا",10,"ل",2,0],["اللَهَ صوَّرَهُ جَواداً خلقه","أَعلى بِهِ نور الزَمانِ أَنيقا",11,"ق",2,0],["الله صان عليك مهبط وحيه","ومقر رحمته وجنة خلده",12,"د",2,0],["الله صانك سائراً ومخيماً","أبداً وزادك من عوائد بره",13,"ر",2,0],["الله صورها لأعشقها","عشقي لها قد شاءه ربي",14,"ب",2,0],["الله صيَّر كل زوج حليلة","رأسا لها في معظم الأديانِ",15,"ن",1,1],["اللَّهُ صَوَّرَ كَفّهُ","مِمّا يَراهُ فَأَبدَعَه",16,"ه",1,1],["أَللهُ صَوَّرَهُ وَأَبدَعَ حُسنَهُ","فَتَبارَكَ الرَّحمنُ هُو مُنشِى الصُّوَر",17,"ر",1,0],["اللَه صَفاهم مِن خَلقهِ دُرَرا","وَكانَ غَيرُهم في جَنبِهم صدفا",18,"ف",2,0],["اللَه صَيَّر رزقهم بِرماحهم","لَم يَسألوا مِن غَيرِها وَيطالبوا",19,"ب",3,0],["اللَه صانَ أَبا الهادي وَمحمله","عن أَن يدنس يوماً في يدي لكع",20,"ع",1,0],["اللَه صير يبس السقم لين شفا","حتى جرى الخصب فيما كان لي نشفا",21,"ف",2,1],["اللَهُ صَيَّرَني عَصا مُوسى لَكُم","حَتّى تَلَقَّفَ افكَكُم ثُعباني",22,"ن",2,0],["اللَهُ صُنّا من أَذى","ذي المِلَّةِ المشاقِقه",23,"ق",2,0],["اللَه صوّر فيه صورةَ سخطِه","فنزيله المسخوطُ في إرضائه",24,"ا",3,0],["اللَّهُ صَوّرَهُ وَقَدَّرَ أَنَّهُ","حَتفُ المُحبِّ وَسقمهُ وَحمامُهُ",25,"م",2,0],["اللهُ صَلَّى والمَلائِكُ كلُّهُم","وَلَهُ التَّحِيَّةُ في الصّلاَة ثَنَاءُ",26,"ا",2,0],["الله صيّرَ من خُطاهُم مهرةً","دهماءَ أسرجتْ الرّياح الخُطّرا",27,"ر",2,0],["الله صلى على النبّي محمد","ما سقيت الأظعان للأرجاء",28,"ا",2,0],["الله صخرها لجل تشرح لي البال","لاضاق بدروب السهر والمشاوير",29,"ر",1,0],["اللهُ صيّرَهُ لدى أقدامِنا","والنفطُ ذا شيءٌ من الأشياءِ",30,"ا",2,0],["الله صيّره الأعلى لرفعتهِ","عن أن يُرائي وتاريخي إليه لجا",31,"ج",2,0]]}