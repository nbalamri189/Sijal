{"poems":[[63,"بأبي وإن عظم الفداء فتى","https://www.aldiwan.net/poem45911.html","أحذ الكامل"],[63,"هي الصبابة من باد ومكتمن","https://www.aldiwan.net/poem46187.html","البسيط"],[55,"إنهم إن رأوا لديك رسولي","https://www.aldiwan.net/poem26147.html","الخفيف"],[77,"أبا العلاء تلقاك الزمان بما","https://www.aldiwan.net/poem35864.html","البسيط"],[77,"مولاي ياذا الجلال الباهر العالي","https://www.aldiwan.net/poem36349.html","البسيط"],[77,"أبدى لداعي الفوز وجه منيب","https://www.aldiwan.net/poem36767.html","الكامل"],[86,"ملك النهى لا تبعدي","https://www.aldiwan.net/poem10479.html","مجزوء الكامل"],[86,"طوفوا بأركان هذا القبر واستلموا","https://www.aldiwan.net/poem10490.html","البسيط"],[86,"هذا صبي هائم","https://www.aldiwan.net/poem10861.html","مجزوء الكامل"],[93,"ماذا تصباك من حال تجددها","https://www.aldiwan.net/poem11314.html","البسيط"],[93,"ألتاج تاج مملكين عظام","https://www.aldiwan.net/poem11386.html","الكامل"],[30,"ما هاج عينيك من الأطلال","https://www.aldiwan.net/poem29544.html","الرجز"],[51,"أما الزمان إلى سلمى فقد جنحا","https://www.aldiwan.net/poem9264.html","البسيط"],[51,"يا ضارب المثل المزخرف مطريا","https://www.aldiwan.net/poem62844.html","الكامل"],[51,"نبل الردى يقصدن قصدك","https://www.aldiwan.net/poem65817.html","مجزوء الكامل"],[51,"ولع الزمان بأن يحرك ساكنا","https://www.aldiwan.net/poem66698.html","الكامل"],[91,"سألتني وقد رجعت إليها","https://www.aldiwan.net/poem62790.html","عموديه"],[85,"إنفع بما أعطيت من قدرة","https://www.aldiwan.net/poem8015.html","السريع"],[85,"كان بروض غصن ناعم","https://www.aldiwan.net/poem8028.html","السريع"],[85,"ما بين دمعي المسبل","https://www.aldiwan.net/poem62836.html","مجزوء الكامل"],[85,"من ظن بعدك أن يقول رثاء","https://www.aldiwan.net/poem62941.html","الكامل"],[85,"يا ناشر العلم بهذي البلاد","https://www.aldiwan.net/poem63771.html","السريع"],[62,"يا أيها المولى الذي اصطنع الورى","https://www.aldiwan.net/poem52507.html","مجزوء الكامل"],[45,"أرج لريا طلة رياه","https://www.aldiwan.net/poem66848.html","الكامل"],[61,"الماء يلعب كالأراقم موجه","https://www.aldiwan.net/poem51795.html","الكامل"],[49,"خفض هداك الله من بالكا","https://www.aldiwan.net/poem62212.html","السريع"],[66,"عبدك قد أرسل أدنى خدمة","https://www.aldiwan.net/poem38703.html","الرجز"],[66,"لا تخش ياربع الحبيب همودا","https://www.aldiwan.net/poem41375.html","الكامل"],[97,"يا أيها الحملُ الوديعُ أنا الذي","https://www.aldiwan.net/poem24765.html","الكامل"],[44,"نظري إليك عليك يش","https://www.aldiwan.net/poem30276.html","مجزوء الكامل"],[44,"لا أنت أنت ولا الديار ديار","https://www.aldiwan.net/poem30516.html","الكامل"],[87,"عرف الهوى في نظرتي فنهاني","https://www.aldiwan.net/poem8212.html","الكامل"],[87,"ما لي بودك بعد اليوم إلمام","https://www.aldiwan.net/poem8263.html","البسيط"],[87,"بقوة العلم تقوى شوكة الأمم","https://www.aldiwan.net/poem8340.html","البسيط"],[69,"طول المقام بدار الحرث برح بي","https://www.aldiwan.net/poem29268.html","البسيط"],[31,"صاح إن الملام في حب جمل","https://www.aldiwan.net/poem41301.html","الخفيف"],[31,"يا قضاة العباد إن عليكم","https://www.aldiwan.net/poem42665.html","الخفيف"],[102,"يا أيها البلد الكئيب","https://www.aldiwan.net/poem33097.html","مجزوء الكامل"],[52,"مولاي إن جفون العين قد قرحت","https://www.aldiwan.net/poem27204.html","البسيط"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[67,"إن تحي آمالي برؤية عيسى","https://www.aldiwan.net/poem18073.html","الكامل"],[67,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[75,"الحب حيث المعشر الأعداء","https://www.aldiwan.net/poem69109.html","الكامل"],[50,"غيب جيرانه بذي حمد","https://www.aldiwan.net/poem63926.html","الطويل"],[46,"دنياك موموقة","https://www.aldiwan.net/poem22212.html","مجزوء السريع"],[46,"قفي وقفة تعلمي","https://www.aldiwan.net/poem23423.html","مجزوء المتقارب"],[15,"طاف الخيال علينا ليلة الوادي","https://www.aldiwan.net/poem45273.html","البسيط"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85325","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85512","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39609","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39559","الخفيف"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30470","الكامل"],[76,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42731","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42608","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42491","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54867","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54767","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43747","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43659","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43706","الرجز"],[52,"","https://poetry.dctabudhabi.ae/diwan/poem/8835","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54281","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54269","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54303","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54243","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54211","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54284","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54240","البسيط"],[77,"أبا العلاء تلقاك الزمان بما","https://www.poetsgate.com/ViewPoem.aspx?id=34181",""],[77,"أبدى لِداعي الفوزِ وجْهَ مُنيبِ","https://www.poetsgate.com/ViewPoem.aspx?id=33318",""],[45,"أُشَرّقُ أمْ أُغَرّبُ يا سَعيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=32872",""],[51,"نبلُ الرَّدى يقصِدْن قصدَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=30077",""],[51,"ياضارب المَثَلِ المزخرفِ مُطْرِياً","https://www.poetsgate.com/ViewPoem.aspx?id=28706",""],[51,"وَلع الزمانُ بأن يحرِّكَ ساكِناً","https://www.poetsgate.com/ViewPoem.aspx?id=30806",""]],"verses":[["فَانْظُرْ إِلى الأَجْدادِ كَيْفَ سَعَوْا","لِلْمَكرُماتِ وأَيَّةً سَلَكُوا",0,"ك",3,0],["فانْظُرْ إليّ بَعيْنَيْ ناقِدٍ يَقِظٍ","تَجْذِبْ إليكَ بضَبْعَي شاعِرٍ فَطِنِ",1,"ن",1,0],["فَاِنظُري مَن رَأَيتِ لِلسِرِّ أَهلاً","فَاِجعَليهِ إِلى رَسولي رَسولا",2,"ل",2,0],["فانْظُرْ بعيْنِ الرِّضى والسّمْحِ لا نظَرَتْ","عيْنُ العدوِّ لمَرْأىً فيكَ يُرْضيها",3,"ي",3,0],["فَانْظُرْ لِنَفْسِكَ وَالإِسْلاَمِ فِي مَهَلٍ","وَعَامِل اللَّهِ مِكْيَالاً بِمِكْيَالِ",4,"ل",1,0],["فَانْظُرْ بِعَيْنِ الْعِزِّ مِنْ ثَغْرِ غَدَا","حَذَرَ الْعِدَا يَرنُو بِطَرْفِ مُرِيبِ",5,"ب",1,0],["فَاُنظُر شَمائِلَ فِكرِها","بِاللَهِ يَومَ المُؤتَمَر",6,"ر",1,0],["فَاُنظُر إِلَيهِ وَقَد طالَت بَواسِقُهُ","تَهنَأ بِهِ وَلِأَنفِ الحاسِدِ الرَغَمُ",7,"م",1,0],["فَاُنظُر إِلى أَسمالِهِ","لَم يَبقَ مِنها ما يُظاهِر",8,"ر",1,0],["فَإِنْ ظَفِرْتَ بِعِزْهَاةٍ وَمَنْصِبُهُ","فِي المَالِكِينَ فَتِلْكَ النَّفْسِ فِي الخَدَمِ",9,"م",1,0],["فَانْظُرْ إِلَيْهِ فِي المَتَاحِفِ سَائلاً","عَنْ حَادِثٍ مِنْ ذُخْرِهَا وَقُدَامِ",10,"م",1,0],["فَاِنظُر إِلى صَدرِكَ ذا بَلبالِ","صَبابَةً بِالأَزمُنِ الخَوالي",11,"ل",2,0],["فانظر إليه بعينٍ طالما ضَرَحتْ","عنها قذى خَلَّة المختل فانضرحا",12,"ح",2,0],["فانظر بعين الرأي لا عينِ الهوى","فالحق للعين الجليّة عاري",13,"ر",2,0],["فانظُر لنفسكَ مُعْمِلاً","فيما يُحبُّ اللَّهُ جُهْدَك",14,"ك",1,0],["فانظُرْ أأبلُغ ما بذلتَ مكافئاً","واذكر أأعدِلُ ما فعلتَ مُوازنا",15,"ن",2,0],["فَاِنظُري مَرَّةً إِلَيكِ مَلِيّاً","تُبصِري الأَوَّلينَ وَالآخَرينا",16,"ن",2,0],["فَانظُر إِلَيكَ الأَمرُ في ذَنبِها","وَمُر نُعَلِّقُها مِنَ الأَربَعِ",17,"ع",1,0],["فَانظُر لِقَدِّ اِبني وَلا تَفتَخِر","مادامَ في العالَمِ أُمٌّ تَلِد",18,"د",1,0],["فَاِنظُر سَريرَكَ هَل جَرى","فَوقَ الدُموعِ الهُطَّلِ",19,"ل",1,0],["فَاِنظُر مِنَ الأَعوادِ حَولَكَ هَل تَرى","مِن بَعدِ طِبِّكَ لِلعُفاةِ دَواءَ",20,"ا",2,0],["فَاِنظُر رَعاكَ اللَهُ في حاجِهِم","فَنَظرَةٌ مِنكَ تُنيلُ المُراد",21,"د",1,0],["فانظُرْ إِليهِ وهو مطرودُ الكرى","ضُرَّاً وجدبا",22,"ب",2,0],["فَانظُر إِلى الحُكمَينِ يَختَلِفانِ بي","في الدَينِ أَقضيهِ وَلا أُقضاهُ",23,"ا",2,0],["فانظُرْ إليه كأنه وكأنما","كِيزانُهُ والماءُ منها ساكبُ",24,"ب",1,0],["فَانظُر سَبيلاً سَلَكوهُ وَلا","تَحسَب بِأَن لَستَ لَهُ سالِكا",25,"ك",2,0],["فَاِنظُر بِلَحظِ الجَبرِ أَو عَينِ الرِضا","نَحوَ غُلامٍ وَكِتابٍ وَطَبَق",26,"ق",1,0],["فَاِنظُر تَجِدمَع كُلِّ نَفسٍ مِنهُم","مِن فَيضِ بِرَّكَ سائِقاً وَشَهيدا",27,"د",2,0],["فانظر إلى الحمل الوديع ووقّه","شر النفوس وفتنة الأطماع",28,"ع",1,0],["فَاُنظُر إِلى وَلَعي بِذِك","رِكَ كُلَّما غَفَلَ الرَقيبُ",29,"ب",1,0],["فَاُنظُر بِعَينِ شَجاعَةٍ فَلَتَعلَمَن","أَنَّ المُقامَ بِحَيثُ كُنتَ فِرارُ",30,"ر",1,0],["فَانْظُرْ لَعَلَّكَ تَسْتَبِينُ رِكَابَهُ","طَوْعَ الرِّيَاحِ يُصِيبُ أَيَّ مَكَانِ",31,"ن",1,0],["فَانْظُرْ لفِعْلِ الْفَتَى تَعْرِفْ مَنَاسِبَهُ","إِنَّ الْفِعَالَ لأَصْلِ الْمَرْءِ إِعْلامُ",32,"م",1,0],["فَانْظُرْ إِلَى الْهَرَمَيْنِ الْمَاثِلَيْنِ تَجِدْ","غَرَائِباً لا تَرَاهَا النَّفْسُ فِي الْحُلُمِ",33,"م",1,0],["فانظرْ إليَّ وجُدْ عطفاً عليَّ عسى","رزقٌ يعين على سكنايَ في حلبِ",34,"ب",1,0],["فَاِنظُرِ اليَومَ مَن كُنتَ تَهوى","فَاِنجُ مِن شانِهِ وَدَعني وَشاني",35,"ن",2,0],["فَاِنظُروا كُلَّ ذاتِ بوصٍ رَداحٍ","فَأَجيزوا شَهادَةَ العَجزاءِ",36,"ا",2,0],["فَاِنظُر لِوَجهك إِنَّهُ","في الكَأس لوّحه الغضب",37,"ب",1,0],["فَاِنظُر بِعَينِ الرِضا مِنّي إِلى بَدَنٍ","ما فيهِ جارِحَةٌ إِلّا وَقَد جُرِحَت",38,"ت",1,0],["فانظروا كيف كان عاقبة القوْ","مِ وَما ساق لِلْبَذِيِّ البَذَاءُ",39,"ا",2,0],["فانْظُرْ لمَنْ ذَهَبَ اللُّصُوصُ بمالِهِ","وَبِعَقْلِهِ يَعْنُو اللُّصُوصُ حُبُوسا",40,"س",2,0],["فإنْ ظَنَنْتُ بهمِ خَتْلاً لِبَعْضِهِمُ","إني إذنْ بِغُرُورِ النَّفْسِ مُخْتُولُ",41,"ل",1,0],["فانْظُرْ أنارٌ باللّوى أم بارِقٌ","مُتَألّقٌ أم رايةٌ حَمْراء",42,"ا",2,0],["فَاِنظُر إِذا اِشتَقتَ في مَنازِلِها","أَو زُر حَبيباً دَعاكَ مِن بُعُدِ",43,"د",1,0],["فَاِنظُر إِلى صُنعِها","وَاِنظُر إِلى بُختِها",44,"ت",3,0],["فَإِن ظَهَرَت زَلَتي","فَقُل لِرَفيقي لُمِ",45,"م",1,0],["فَاِنظُر إِلى فيءِ مُلكٍ أَنتَ تارِكُهُ","هَل تُرسَيَنَّ أَواخيهِ بِأَوتادِ",46,"د",1,0],["فانظرُ عنِ اليمينِ واليسارِ","فما تَرى إلَّا لهيبَ ا