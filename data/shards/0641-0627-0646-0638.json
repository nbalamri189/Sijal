5,"أما وبنات الفكر حلفة فاضل","https://www.aldiwan.net/poem3336.html","عموديه"],[469,"يا أيها الغر الجهول الذي","https://www.aldiwan.net/poem59779.html","السريع"],[469,"اسمع جعلنا فداكا","https://www.aldiwan.net/poem59784.html","المجتث"],[469,"يا سيدا سؤدده تحت","https://www.aldiwan.net/poem60345.html","السريع"],[480,"نبه لحاظك فالصباح قريب","https://www.aldiwan.net/poem36933.html","الكامل"],[480,"كل يترجم عن إحساسه لكمو","https://www.aldiwan.net/poem37057.html","البسيط"],[480,"يا ثابت الراي في الأعمال تجريها","https://www.aldiwan.net/poem37595.html","البسيط"],[480,"مجلس الشورى هل أتاك النذير","https://www.aldiwan.net/poem37602.html","الخفيف"],[501,"عرج بعيس القوم يا حاديها","https://www.aldiwan.net/poem37637.html","الكامل"],[501,"حزب الغيوب أتانا","https://www.aldiwan.net/poem37698.html","الكامل"],[501,"بين النجوم وبين مسبار الضحى","https://www.aldiwan.net/poem37819.html","الكامل"],[501,"شرافة الشوق لا زالت تطول إلى","https://www.aldiwan.net/poem38058.html","البسيط"],[505,"ما لي إلى وصل الحبيب سبيل","https://www.aldiwan.net/poem38410.html","الكامل"],[505,"أفنى الضنا جسدي وابلى بالي","https://www.aldiwan.net/poem38411.html","الكامل"],[506,"ذو الأوتاد","https://www.aldiwan.net/poem27895.html","البسيط"],[506,"بلا أرواح","https://www.aldiwan.net/poem56763.html","الرمل"],[506,"حبيبي","https://www.aldiwan.net/poem56769.html","الطويل"],[530,"يا حبذا كلام","https://www.aldiwan.net/poem37445.html","مجزوء الرجز"],[552,"كم ذا نخيب وتكذب الأطماع","https://www.aldiwan.net/poem47724.html","الكامل"],[552,"إِن كان غيبك التراب الأحمر","https://www.aldiwan.net/poem47823.html","الكامل"],[552,"من رأى الأظعان فوق","https://www.aldiwan.net/poem47903.html","مجزوء الرمل"],[559,"ربما يكذب حسادي علي","https://www.aldiwan.net/poem33569.html","الرمل"],[559,"ربي من الماء خالق كل شيء حي","https://www.aldiwan.net/poem33574.html","المواليا"],[559,"حقيقة الكل روح الله يهديها","https://www.aldiwan.net/poem33639.html","المواليا"],[559,"إن الذي أكد وعدي وفاه","https://www.aldiwan.net/poem33660.html","السريع"],[559,"خذها إليك لها هدى وبيان","https://www.aldiwan.net/poem33803.html","الكامل"],[559,"حولوا عني من الكون لثاما","https://www.aldiwan.net/poem33885.html","الرمل"],[559,"ربي تجلى بأنواع الخلائق لي","https://www.aldiwan.net/poem34211.html","البسيط"],[559,"العبد يلهو ويغفل","https://www.aldiwan.net/poem34242.html","المجتث"],[559,"العين واحدة والحكم مختلف","https://www.aldiwan.net/poem34344.html","البسيط"],[559,"إن وجها كنت أنظره","https://www.aldiwan.net/poem34469.html","المديد"],[559,"يا طلعة الشمس أو يا طلعة القمر","https://www.aldiwan.net/poem34551.html","البسيط"],[559,"هذا وهذا ثم هذا بعده","https://www.aldiwan.net/poem34608.html","الكامل"],[559,"حق عيني رؤية الوجه المليح","https://www.aldiwan.net/poem34666.html","الرمل"],[559,"إن بحر الوجود بالإختلاج","https://www.aldiwan.net/poem34690.html","الخفيف"],[563,"في ظل سلطاننا عبد العزيز بنى","https://www.aldiwan.net/poem52535.html","الطويل"],[568,"أما الظلام فقد رقت غلالته","https://www.aldiwan.net/poem69534.html","الكامل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[570,"سلب الشباب رداءه","https://www.aldiwan.net/poem52022.html","مجزوء الكامل"],[576,"رغبت في الجنة لما بدا","https://www.aldiwan.net/poem2875.html","السريع"]],"verses":[["فَانْظُرْ إِلى الأَجْدادِ كَيْفَ سَعَوْا","لِلْمَكرُماتِ وأَيَّةً سَلَكُوا",0,"ك",3,0],["فانْظُرْ إليّ بَعيْنَيْ ناقِدٍ يَقِظٍ","تَجْذِبْ إليكَ بضَبْعَي شاعِرٍ فَطِنِ",1,"ن",1,0],["فَاِنظُري مَن رَأَيتِ لِلسِرِّ أَهلاً","فَاِجعَليهِ إِلى رَسولي رَسولا",2,"ل",2,0],["فانْظُرْ بعيْنِ الرِّضى والسّمْحِ لا نظَرَتْ","عيْنُ العدوِّ لمَرْأىً فيكَ يُرْضيها",3,"ي",3,0],["فَانْظُرْ لِنَفْسِكَ وَالإِسْلاَمِ فِي مَهَلٍ","وَعَامِل اللَّهِ مِكْيَالاً بِمِكْيَالِ",4,"ل",1,0],["فَانْظُرْ بِعَيْنِ الْعِزِّ مِنْ ثَغْرِ غَدَا","حَذَرَ الْعِدَا يَرنُو بِطَرْفِ مُرِيبِ",5,"ب",1,0],["فَاُنظُر شَمائِلَ فِكرِها","بِاللَهِ يَومَ المُؤتَمَر",6,"ر",1,0],["فَاُنظُر إِلَيهِ وَقَد طالَت بَواسِقُهُ","تَهنَأ بِهِ وَلِأَنفِ الحاسِدِ الرَغَمُ",7,"م",1,0],["فَاُنظُر إِلى أَسمالِهِ","لَم يَبقَ مِنها ما يُظاهِر",8,"ر",1,0],["فَإِنْ ظَفِرْتَ بِعِزْهَاةٍ وَمَنْصِبُهُ","فِي المَالِكِينَ فَتِلْكَ النَّفْسِ فِي الخَدَمِ",9,"م",1,0],["فَانْظُرْ إِلَيْهِ فِي المَتَاحِفِ سَائلاً","عَنْ حَادِثٍ مِنْ ذُخْرِهَا وَقُدَامِ",10,"م",1,0],["فَاِنظُر إِلى صَدرِكَ ذا بَلبالِ","صَبابَةً بِالأَزمُنِ الخَوالي",11,"ل",2,0],["فانظر إليه بعينٍ طالما ضَرَحتْ","عنها قذى خَلَّة المختل فانضرحا",12,"ح",2,0],["فانظر بعين الرأي لا عينِ الهوى","فالحق للعين الجليّة عاري",13,"ر",2,0],["فانظُر لنفسكَ مُعْمِلاً","فيما يُحبُّ اللَّهُ جُهْدَك",14,"ك",1,0],["فانظُرْ أأبلُغ ما بذلتَ مكافئاً","واذكر أأعدِلُ ما فعلتَ مُوازنا",15,"ن",2,0],["فَاِنظُري مَرَّةً إِلَيكِ مَلِيّاً","تُبصِري الأَوَّلينَ وَالآخَرينا",16,"ن",2,0],["فَانظُر إِلَيكَ الأَمرُ في ذَنبِها","وَمُر نُعَلِّقُها مِنَ الأَربَعِ",17,"ع",1,0],["فَانظُر لِقَدِّ اِبني وَلا تَفتَخِر","مادامَ في العالَمِ أُمٌّ تَلِد",18,"د",1,0],["فَاِنظُر سَريرَكَ هَل جَرى","فَوقَ الدُموعِ الهُطَّلِ",19,"ل",1,0],["فَاِنظُر مِنَ الأَعوادِ حَولَكَ هَل تَرى","مِن بَعدِ طِبِّكَ لِلعُفاةِ دَواءَ",20,"ا",2,0],["فَاِنظُر رَعاكَ اللَهُ في حاجِهِم","فَنَظرَةٌ مِنكَ تُنيلُ المُراد",21,"د",1,0],["فانظُرْ إِليهِ وهو مطرودُ الكرى","ضُرَّاً وجدبا",22,"ب",2,0],["فَانظُر إِلى الحُكمَينِ يَختَلِفانِ بي","في الدَينِ أَقضيهِ وَلا أُقضاهُ",23,"ا",2,0],["فانظُرْ إليه كأنه وكأنما","كِيزانُهُ والماءُ منها ساكبُ",24,"ب",1,0],["فَانظُر سَبيلاً سَلَكوهُ وَلا","تَحسَب بِأَن لَستَ لَهُ سالِكا",25,"ك",2,0],["فَاِنظُر بِلَحظِ الجَبرِ أَو عَينِ الرِضا","نَحوَ غُلامٍ وَكِتابٍ وَطَبَق",26,"ق",1,0],["فَاِنظُر تَجِدمَع كُلِّ نَفسٍ مِنهُم","مِن فَيضِ بِرَّكَ سائِقاً وَشَهيدا",27,"د",2,0],["فانظر إلى الحمل الوديع ووقّه","شر النفوس وفتنة الأطماع",28,"ع",1,0],["فَاُنظُر إِلى وَلَعي بِذِك","رِكَ كُلَّما غَفَلَ الرَقيبُ",29,"ب",1,0],["فَاُنظُر بِعَينِ شَجاعَةٍ فَلَتَعلَمَن","أَنَّ المُقامَ بِحَيثُ كُنتَ فِرارُ",30,"ر",1,0],["فَانْظُرْ لَعَلَّكَ تَسْتَبِينُ رِكَابَهُ","طَوْعَ الرِّيَاحِ يُصِيبُ أَيَّ مَكَانِ",31,"ن",1,0],["فَانْظُرْ لفِعْلِ الْفَتَى تَعْرِفْ مَنَاسِبَهُ","إِنَّ الْفِعَالَ لأَصْلِ الْمَرْءِ إِعْلامُ",32,"م",1,0],["فَانْظُرْ إِلَى الْهَرَمَيْنِ الْمَاثِلَيْنِ تَجِدْ","غَرَائِباً لا تَرَاهَا النَّفْسُ فِي الْحُلُمِ",33,"م",1,0],["فانظرْ إليَّ وجُدْ عطفاً عليَّ عسى","رزقٌ يعين على سكنايَ في حلبِ",34,"ب",1,0],["فَاِنظُرِ اليَومَ مَن كُنتَ تَهوى","فَاِنجُ مِن شانِهِ وَدَعني وَشاني",35,"ن",2,0],["فَاِنظُروا كُلَّ ذاتِ بوصٍ رَداحٍ","فَأَجيزوا شَهادَةَ العَجزاءِ",36,"ا",2,0],["فَاِنظُر لِوَجهك إِنَّهُ","في الكَأس لوّحه الغضب",37,"ب",1,0],["فَاِنظُر بِعَينِ الرِضا مِنّي إِلى بَدَنٍ","ما فيهِ جارِحَةٌ إِلّا وَقَد جُرِحَت",38,"ت",1,0],["فانظروا كيف كان عاقبة القوْ","مِ وَما ساق لِلْبَذِيِّ البَذَاءُ",39,"ا",2,0],["فانْظُرْ لمَنْ ذَهَبَ اللُّصُوصُ بمالِهِ","وَبِعَقْلِهِ يَعْنُو اللُّصُوصُ حُبُوسا",40,"س",2,0],["فإنْ ظَنَنْتُ بهمِ خَتْلاً لِبَعْضِهِمُ","إني إذنْ بِغُرُورِ النَّفْسِ مُخْتُولُ",41,"ل",1,0],["فانْظُرْ أنارٌ باللّوى أم بارِقٌ","مُتَألّقٌ أم رايةٌ حَمْراء",42,"ا",2,0],["فَاِنظُر إِذا اِشتَقتَ في مَنازِلِها","أَو زُر حَبيباً دَعاكَ مِن بُعُدِ",43,"د",1,0],["فَاِنظُر إِلى صُنعِها","وَاِنظُر إِلى بُختِها",44,"ت",3,0],["فَإِن ظَهَرَت زَلَتي","فَقُل لِرَفيقي لُمِ",45,"م",1,0],["فَاِنظُر إِلى فيءِ مُلكٍ أَنتَ تارِكُهُ","هَل تُرسَيَنَّ أَواخيهِ بِأَوتادِ",46,"د",1,0],["فانظرُ عنِ اليمينِ واليسارِ","فما تَرى إلَّا لهيبَ النَّارِ",47,"ر",1,0],["فأنظِمه ولا أدري أَأَني","مسيء حين أنظم أم مجيد",48,"د",1,0],["فأنظم الشعر غير صعب","كأَنما الشعر من شعاري",49,"ر",2,0],["فانظروا أيَّ شاعرٍ","هو في الحفلِ بينكمْ",50,"م",1,0],["فانظري ما ترين غيرَ شقيٍّ","طاف يبكي بالشاطئ المهجورِ",51,"ر",1,0],["فانظُر إِلى حُسْن الرَّبِيعِ وقَدْ جَلَتْ","عن ثَوْبِ نَوْرٍ للربِيعِ مُجَزَّعِ",52,"ع",1,0],["فانظُر تجدْ من تحتها أسماءَها","مكتوبةً قد وُضعتْ إِزاءَها",53,"ه",2,0],["فَانْظُرْ لِقَوْلِي تَجِدْ نَفْسِي مُصَوَّرَةً","فِي صَفْحَتَيْهِ فَقَوْلِي خَطُّ تِمْثَالِي",54,"ل",2,0],["فَانْظُرْ إِلَى عَقْلِ الفَتَى لا جِسْمِهِ","فَالْمَرْءُ يَكْبُرُ بِالْفِعَالِ وَيَصْغُرُ",55,"ر",1,0],["فانْظُرْ إِلَيَّ تَجِدْ خَيَالَةَ صُورَةٍ","لم يَبْقَ فيها للحياةِ ذَمَاءُ",56,"ا",2,0],["فإِن ظَلَمَتَ حُرّاً وسَاءَكَ ظُلْمُهُ","فأجْمِلْ بِهَا عُقْبى يُسَرُّ بِهَا الْحُرُّ",57,"ر",1,0],["فَانْظُرْ إِلى الْجَاهِ الَّذِي أَحْرَزَتْ","بِهِمْ وَمَنْ سَوَّدَهُ الْجَاهُ سَادْ",58,"د",1,0],["فاِنظُر غَداً هَل عَلا البَرجيس مانِعُهُ","مِنَ الحَوادِثِ أَو عَلياءُ بَهرامِ",59,"م",1,0],["فَاِنظُر إِلى دارِ البلى كَيفَ اِلتَقى","غيثانُ مِن أَرضٍ بِها وَسَماءِ",60,"ا",2,0],["فَاِنظُر وَلَو واحِدَةً","إِلَيهِ وَاِرجِع بَصَرَك",61,"ك",1,0],["فَاِنظُر زَبَرجَدَ خَدٍّ صارَ مِن سَبَجٍ","وَصَبَّ دَمعاً عَلَيهِ كُلُّ بَكّاءِ",62,"ا",2,0],["فانظُر إِلى الوَادي الفَسِيح فَهَلْ تَرَى","إِلاَّ قُلوباً في فَسِيح فَضائه",63,"ا",3,0],["فَانْظُرْ تَرى مِصْرَ هَلْ تَلْقَى لَهَا مَثَلاً","في صَوْلَةِ المُلْكِ أَوْفى قُوَّةِ الأُهَبِ",64,"ب",1,0],["فانظرْ إلى البُستان هل تلقى به","إلاَّ وروداً أو ثُغورَ أقاحي",65,"ح",2,0],["فانظري ليس الصدَى في بعضنا","دون بعضٍ واعدلي بين الظماء",66,"ا",2,0],["فانظْرِ الرَّوضَ لا ترَى غَيْرَ تِبْرٍ","من تُرَابٍ ودُرةٍ مِن حَصَاةِ",67,"ه",1,0],["فانْظُرِ الشعْبَ لاَ تَرَى غَيْرَ قَلْبٍ","نابِضٍ يَحْفَظُ الْوَلاَءَ الأَكِيدا",68,"د",2,0],["فانظر تجدْ أملاً في كلِّ ناحيةٍ","العزمُ يمليه والْحُسنَى تُؤازرُه",69,"ر",2,0],["فانظر بعين الرضا والسمع لا نظرت","عين العدو لمرأى فيك يرضيها",70,"ي",3,0],["فانظر بعينِ العزِّ من ثُغر غدا","حذر العِدا يرنوا بطرفِ مُريب",71,"ب",1,0],["فانظري \" يا صديقتي \" رقصة الفجر","على خضرة الحقول الوريقة",72,"ق",2,0],["فأنْظُرَ أيُّنَا يُضْحي، وَيُمْسِي","لَهُ هَذي المَوَاكبُ، وَالعَبيدُ",73,"د",1,0],["فانظُر لنفسكَ مُكْمِلاً","فيما يُحبُّ اللَّهُ جُهْدَك",74,"ك",1,0],["فانظر بعين الرأي لا بعينِ الهوى","فالحق للعين الجليّة عاري",75,"ر",2,0],["فانظُرْ أأبلُغ ما بدلتَ مكافئاً","واذكر أأعدِلُ مافعلتَ مُوازنا",76,"ن",2,0],["فَاِنظُر إِلَيَّ بِرَأفَة بَل رَحمة","أَنجوبها قَد مَسَني الأَهلاكُ",77,"ك",1,0],["فَاِنُظُر إِلَيهِ بِرَأفة بَل رَحمَة","تَكفيهِ مِن جَرع الأَسايا ما اِحتَسى",78,"س",2,0],["فانظر الي بعين منك كم وصلت","بحالة الرمش منها حبل منفصل",79,"ل",1,0],["فانظر منك العين بالعين والهوى","يحلك في روحي على ا