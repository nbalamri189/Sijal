{"poems":[[53,"لله ثم لك المحل الأعظم","https://www.aldiwan.net/poem29795.html","الكامل"],[55,"إني طربت إلى شمس إذا طلعت","https://www.aldiwan.net/poem26368.html","البسيط"],[77,"لا تهج بالذكر من جلدي","https://www.aldiwan.net/poem36358.html","المديد"],[77,"هدم السد وهو ما هو فار","https://www.aldiwan.net/poem36415.html","الخفيف"],[42,"ليت شعري عن خليلي ما الذي","https://www.aldiwan.net/poem50429.html","الرمل"],[9,"ما بكاء الكبير بالأطلال","https://www.aldiwan.net/poem21974.html","الخفيف"],[86,"شبحاً أرى أم ذاك طيف خيال","https://www.aldiwan.net/poem10916.html","الكامل"],[86,"حياكم الله أحيوا العلم والأدبا","https://www.aldiwan.net/poem10917.html","البسيط"],[88,"فعدت بقارعة الطريق تنوح","https://www.aldiwan.net/poem43672.html","الكامل"],[88,"بغداد حسبك رقدة وسبات","https://www.aldiwan.net/poem45007.html","الكامل"],[27,"إن الفرزدق أخزته مثالبه","https://www.aldiwan.net/poem5672.html","البسيط"],[72,"شاب فود الصب حزنا مثل ما","https://www.aldiwan.net/poem19191.html","الرمل"],[51,"لا تهولنك شمس كسفت","https://www.aldiwan.net/poem8167.html","الرمل"],[51,"أيها المتحفي بحول وعور","https://www.aldiwan.net/poem66402.html","الخفيف"],[51,"ناشدتك الله أن تستفسد المننا","https://www.aldiwan.net/poem66517.html","البسيط"],[89,"قد انى يا منيتي ان تعودي","https://www.aldiwan.net/poem44738.html","الخفيف"],[85,"درجت على الكنز القرون","https://www.aldiwan.net/poem63694.html","مجزوء الكامل"],[85,"الناس للدنيا تبع","https://www.aldiwan.net/poem63761.html","مجزوء الكامل"],[45,"رنو ذاك الغزال أو غيده","https://www.aldiwan.net/poem63505.html","المنسرح"],[45,"أخذت جعفر برأس القطار","https://www.aldiwan.net/poem64526.html","الخفيف"],[45,"ترك السواد للابسيه وبيضا","https://www.aldiwan.net/poem64626.html","الكامل"],[45,"أنظر إلى العلياء كيف تضام","https://www.aldiwan.net/poem65657.html","الكامل"],[66,"لا تهد شيئا لم يكن حسنا","https://www.aldiwan.net/poem38535.html","الكامل"],[44,"قد عرفنا دلائل المنع أو ما","https://www.aldiwan.net/poem29711.html","الخفيف"],[44,"يا ابن تلك التي بحران لما","https://www.aldiwan.net/poem30055.html","الخفيف"],[44,"ما في وقوفك ساعة من باس","https://www.aldiwan.net/poem30485.html","الكامل"],[69,"قل لأهل الجاه مهما","https://www.aldiwan.net/poem28034.html","مجزوء الرمل"],[31,"لبس الظلام إليك مكتتما","https://www.aldiwan.net/poem42656.html","الكامل"],[102,"قدر ساقه فآواه روضا","https://www.aldiwan.net/poem32977.html","الخفيف"],[39,"قل في شط نهروان اغتماضي","https://www.aldiwan.net/poem53771.html","الخفيف"],[48,"يزيد ماذا دهاكا","https://www.aldiwan.net/poem64487.html","المجتث"],[48,"لا تهجرن الحبيب إن هجرا","https://www.aldiwan.net/poem64980.html","المنسرح"],[46,"يتحارب الطبع الذي مزجت به","https://www.aldiwan.net/poem23147.html","الكامل"],[46,"عش بخيلا كأهل عصرك هذا","https://www.aldiwan.net/poem23188.html","الخفيف"],[46,"صاحب الشرطة إن أنصفني","https://www.aldiwan.net/poem23428.html","الرمل"],[46,"لا تهاد القضاة كي تظلم الخ","https://www.aldiwan.net/poem23597.html","الخفيف"],[76,"صحيفة طابعها اللوم","https://www.aldiwan.net/poem38998.html","الرجز"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85629","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85597","البسيط"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30511","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/20987","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54215","الخفيف"],[106,"إلى مجلس الأمن","https://www.poetsgate.com/ViewPoem.aspx?id=179350",""],[90,"على سعد","https://www.poetsgate.com/ViewPoem.aspx?id=179079",""],[45,"أُنْظُرْ إلى العَلْيَاءِ كَيفَ تُضَامُ","https://www.poetsgate.com/ViewPoem.aspx?id=32073",""],[107,"لا تهمل الكاس حين يحملها","https://www.aldiwan.net/poem16582.html","المنسرح"],[141,"حاشاك أن تسلب الأيام ما تهب","https://www.aldiwan.net/poem11738.html","البسيط"],[162,"إنما فازت قداح المنايا","https://www.aldiwan.net/poem67815.html","المديد"],[183,"لا تكل لذة إلى التسويف","https://www.aldiwan.net/poem14716.html","الخفيف"],[209,"فررت منكم إليكم","https://www.aldiwan.net/poem46284.html","المجتث"],[252,"اُعف عني","https://www.aldiwan.net/poem24945.html","مجزوء الرمل"],[302,"قل للذي قد لامني","https://www.aldiwan.net/poem16785.html","مجزوء الرجز"],[362,"وجدي بلومك يا عذول يزيد","https://www.aldiwan.net/poem60944.html","الكامل"],[364,"لا دليل إلا عليه علامة","https://www.aldiwan.net/poem17671.html","الخفيف"],[366,"لمن الظعن بالضحى طافيات","https://www.aldiwan.net/poem1882.html","الخفيف"],[397,"أنا ناطق باسم الشباب","https://www.aldiwan.net/poem6794.html","عموديه"],[403,"الآن قد صح لي حقا بلا كذب","https://www.aldiwan.net/poem50209.html","البسيط"],[456,"الليل بعد اليأس أطمع ناظري","https://www.aldiwan.net/poem56175.html","الكامل"],[503,"العار","https://www.aldiwan.net/poem42463.html","البسيط"],[549,"قل للذين إذا دعوا","https://www.aldiwan.net/poem48036.html","مجزوء الكامل"],[556,"هذا الطريق الأقرب","https://www.aldiwan.net/poem34925.html","مجزوء الكامل"],[573,"عادني من هوى الأحبة عيد","https://www.aldiwan.net/poem3078.html","الخفيف"]],"verses":[["لا تَهتَدي نُوَبُ الزَمانِ لِدَولَةٍ","اللَهُ فيها وَالنَبِيُّ وَأَنتُمُ",0,"م",1,0],["لا تَهجُريني عَلى مَا بي بِعَيشِكُمُ","إِنّي لَتَرحَمُ نَفسي كُلَّ مَهجورِ",1,"ر",1,0],["لاَ تُهِجْ بِالذِّكْرِ مِنْ جَلَدِي","نَارَ شَوقٍ شَقَّ مُحْتَمَلُهْ",2,"ه",1,1],["لا تهُلْكَ الثّيابُ إنْ كان فيها","إنّما في الثّيابِ لوْمٌ وعارُ",3,"ر",1,0],["لا تُهِنّي بَعدَ إِكرامِكَ لي","فَشَديدٌ عادَةٌ مُنتَزَعَه",4,"ع",2,0],["لاتَ هَنّا ذِكرى جُبَيرَةَ أَو مَن","جاءَ مِنها بِطائِفِ الأَهوالِ",5,"ل",1,0],["لا تُهمِلوا في الصالِحاتِ فَإِنَّكُم","لا تَجهَلونَ عَواقِبَ الإِهمالِ",6,"ل",1,0],["لا تَهجَعوا إِنَّهُم لَن يَهجَعوا أَبَداً","وَطالِبوهُم وَلَكِن أَجمِلوا الطَلَبا",7,"ب",2,0],["لا تهلكي جزعاً فإن بيوتناً","ما للملمّ بأهلها تسريح",8,"ح",1,0],["لا تُهملوا الضرر اليسير فإنه","أن دام ضاقت دونه الفلوات",9,"ت",1,0],["لا تَهجُ قَيساً وَلَكِن لَو شَكَرتَهُمُ","إِنَّ اللَئيمَ لَأَهلِ السَروِ عَيّابُ",10,"ب",1,0],["لا تهني بعد ما أكرمتني","فشديدٌ عادةٌ منتزَعه",11,"ع",2,0],["لا تَهُولنَّكَ شمسٌ كسفَتْ","دون أن تطلعَ مِنْ مغربِها",12,"ب",3,1],["لا تهاوَنْ بطيرةٍ أيُّها النَّظْ","ظارُ واعلم بأنَّها عنوان",13,"ن",1,0],["لا تهجُرنَّ أليفا إلا لفاحشةٍ","إن الكريم يرى أُلّافَهُ وطنا",14,"ن",2,0],["لا تهابي فلست اوّل روح","وغلت في هذا الفضاء المديد",15,"د",1,0],["لا تهابي فانت يا نفس بعدي","مثل صمصام ليس بالمغمود",15,"د",1,0],["لا تَهتَدي الريحُ الهَبو","بُ لَها وَلا الغَيثُ الهَتون",16,"ن",1,0],["لا تَهجَعَنَّ إِلى الزَما","نِ فَقَد يُنَبَّهُ مَن هَجَع",17,"ع",1,0],["لا تَهضِمُ الراحُ حَدَّهُ أُصُلاً","وَلا تَبيتُ الأَوتارُ تَضطَهِدُه",18,"د",2,0],["لا تَهولَنَّكَ السَوابِغُ وَالبي","ضُ فَمِن تَحتِها قُلوبُ العَذاري",19,"ر",2,0],["لا تَهتَبِل إِغضاءَتي إِذ كُنتُ قَد","أَغضَيتُ مُشتَمِلاً عَلى جَمرِ الغَضا",20,"ض",2,0],["لا تَهنَإِ الرومَ اِستِراحَتَهُم فَقَد","هَدَأوا بِأَفواهِ الدُروبِ وَناموا",21,"م",3,0],["لا تُهدِ شَيئاً لَم يَكُن حَسَناً","أَو طُرفَةً عُدَّت مِنَ النَزرِ",22,"ر",1,1],["لا تَهَدّى سُبلَ العُروقِ وَلا تَن","سلُّ في مِفصَلٍ بِغَيرِ دَليلِ",23,"ل",1,0],["لا تَهولَنَّكَ الكِباشُ فَقَد أُع","طيتَ ما شِئتَ مِن أَداةِ النِطاحِ",24,"ح",1,0],["لا تَهجُرُ الأَنواءُ مَنبِتَها وَلا","قَلبُ الثَرى القاسي عَلَيها قاسي",25,"س",2,0],["لا تهينوا أهلَ علمٍ","فإذا همْ سمُّ ساعَهْ",26,"ه",1,0],["لا تُهلِكيني في عَذابِكُمُ","فَاللَهُ يَعلَمُ غائِبَ القَلبِ",27,"ب",1,0],["لا تَهب قَلبك الكَريمَ لَئيماً","تَحتَ رجليهِ عابثاً يَلقيهِ",28,"ه",1,0],["لاتَ هَنا ذِكرى بُلَهنِيَةِ الدَه","رِ وَأَنّى ذِكرى السِنينَ المَواضي",29,"ض",2,0],["لا تَهوَيَنَّ يَزيداً","بَعدَ الَّذي قَد أَراكا",30,"ك",2,0],["لا تَهجُرَنَّ الحَبيبَ إِن هَجَرا","وَلا تُعاقِبهُ بِالَّذي فَعَلا",31,"ل",2,1],["لا تَهزَأَن بِالشَيخِ كَم مِن لَيلَةٍ","جازَت بِهِ كَالبَدرِ يَحسُنُ دَلُّهُ",32,"ل",2,0],["لا تَهَبهُ وَلا سِواهُ مِنَ الطَي","رِ فَما يَتَّقي أَخو الُبِّ تَبلَه",33,"ل",2,0],["لا تُهاوِن بِصَغيرٍ مِن عِدىً","فَقَديماً كَسَرَ الرُمحُ القَلَم",34,"م",1,0],["لا تُهادِ القُضاةُ كَي تَظلِمَ الخَ","صمَ وَلا تَذكُرَنَّ ماتُهديهِ",35,"ه",1,1],["لا تَهتضِمْ إن بتَّ ضَيفاً له","فخُبزُهُ في الجوفِ هاضُومُ",36,"م",1,0],["لا تهمل الداء الصَغير فإنه","يَنمو ويصبح فيك وهو عقام",37,"م",1,1],["لا تهربن من النار الَّتي اضطرمت","وإن رمتك فنالَت منك بالشرر",38,"ر",1,0],["لا تَهجُونَّ انس منك فَرُبَّما","تَهجُو أباكَ وأنتَ لا تَدري",39,"ي",1,0],["لا تَهُن خَطبنَا فإِن يَثبُتِ ال","يَجريُ تَذَكَّر قَولي وَصدرُكَ عالِ",40,"ل",1,0],["لا تَهابِي دارَ العُلُومِ مُلِمّاً","آفةُ المجدِ والعُلاَ أَنْ تَهابي",41,"ب",2,0],["لا تَهْتِفُوا بشعاراتٍ مُزَيَّفَة","مَا السلم، والأمن إلا المَيْنُ والكذب",42,"ب",1,0],["لا تُهمليِه واذكري أتعابَهُ","وثقي بسعدٍ فهو لا ينساك",43,"ك",1,0],["لا تَهْنِىءِ الرّومَ استِرَاحَتُهُمْ، فقدْ","هَدَأُوا بأفْوَاهِ الدّرُوبِ، وَنَامُوا",44,"م",3,0],["لا تهمل الكاس حينَ يَحملها","مَن هُوَ في الحُسن واحد فَرد",45,"د",1,1],["لا تُهمِلِ الشِركَ في اِستِئصالِ شَأفَتِها","كَأَنَّما الشامُ جِسمٌ رَأسُهُ حَلَبُ",46,"ب",1,0],["لا تُهَلِّلَن فَرُبَّت ريحٍ","قَد قَفا مِنها النَسيمُ الهَيوفا",47,"ف",2,0],["لا تُهِنْ نفسَك النفيسة بالبخ","ل بهَوْنٍ من تالدٍ وطريف",48,"ف",1,0],["لا تهربوا من لقائي","ويلٌ لكم إن هربتم",49,"م",1,0],["لا تُهِنّي عند خصمٍ","إنما صُنّي، تجدني",50,"ن",2,0],["لا تهملوا من قد غدا","يسموا بكم بين العباد",51,"د",1,0],["لا تَهْجُروا إنّي على ما نابَني","في الدّهرِ إلاّ هَجْرَكم لجَليد",52,"د",1,0],["لا تُهَنّيهِ بِالسَلامَه مِنها","بَل يُعَزّي في نَفسِهِ بِالسَلامَه",53,"م",2,0],["لاتَ هَنَّا ولَيْتَنِي طَرَفَ الزُّجْ","جِ وأَهْلِي بالشَّأْمِ ذاتِ القُرونِ",54,"ن",1,0],["لا تهملوا أمر الشبابِ فربَّم","صاروا مع الإهمالِ كالألغامِ",55,"م",1,0],["لا تَهتَدي الجنُّ فيها من تفاوتها","ولا يتم الصَبا بالوبل وَالحرب",56,"ب",1,0],["لا تهتدي طُرُقُ الصلاح بغيركم","والناسُ بين مضلَّلٍ أو حائرِ",57,"ر",1,0],["لا تهدمِ الكعبة فتنهضَ الهِمَمو","وابْنِ البروجَ جِوارَها فتنحجبُ",58,"ب",1,0],["لا تَهدِموا ما قَد بنا","هُ لَكُمْ كِرامٌ وَاِبتَنيتُ",59,"ت",1,0],["لا تهربوا منه تروا","منه إليه المهرب",60,"ب",1,0],["لا تُهوِّن مِنَ الغَرامِ شَديداُ","إِنَّ بأْسَ الغَرَامِ بَأْسٌ شَدِيد",61,"د",1,0]]}