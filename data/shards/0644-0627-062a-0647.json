,"وَطالِبوهُم وَلَكِن أَجمِلوا الطَلَبا",7,"ب",2,0],["لا تهلكي جزعاً فإن بيوتناً","ما للملمّ بأهلها تسريح",8,"ح",1,0],["لا تُهملوا الضرر اليسير فإنه","أن دام ضاقت دونه الفلوات",9,"ت",1,0],["لا تَهجُ قَيساً وَلَكِن لَو شَكَرتَهُمُ","إِنَّ اللَئيمَ لَأَهلِ السَروِ عَيّابُ",10,"ب",1,0],["لا تهني بعد ما أكرمتني","فشديدٌ عادةٌ منتزَعه",11,"ع",2,0],["لا تَهُولنَّكَ شمسٌ كسفَتْ","دون أن تطلعَ مِنْ مغربِها",12,"ب",3,1],["لا تهاوَنْ بطيرةٍ أيُّها النَّظْ","ظارُ واعلم بأنَّها عنوان",13,"ن",1,0],["لا تهجُرنَّ أليفا إلا لفاحشةٍ","إن الكريم يرى أُلّافَهُ وطنا",14,"ن",2,0],["لا تهابي فلست اوّل روح","وغلت في هذا الفضاء المديد",15,"د",1,0],["لا تهابي فانت يا نفس بعدي","مثل صمصام ليس بالمغمود",15,"د",1,0],["لا تَهتَدي الريحُ الهَبو","بُ لَها وَلا الغَيثُ الهَتون",16,"ن",1,0],["لا تَهجَعَنَّ إِلى الزَما","نِ فَقَد يُنَبَّهُ مَن هَجَع",17,"ع",1,0],["لا تَهضِمُ الراحُ حَدَّهُ أُصُلاً","وَلا تَبيتُ الأَوتارُ تَضطَهِدُه",18,"د",2,0],["لا تَهولَنَّكَ السَوابِغُ وَالبي","ضُ فَمِن تَحتِها قُلوبُ العَذاري",19,"ر",2,0],["لا تَهتَبِل إِغضاءَتي إِذ كُنتُ قَد","أَغضَيتُ مُشتَمِلاً عَلى جَمرِ الغَضا",20,"ض",2,0],["لا تَهنَإِ الرومَ اِستِراحَتَهُم فَقَد","هَدَأوا بِأَفواهِ الدُروبِ وَناموا",21,"م",3,0],["لا تُهدِ شَيئاً لَم يَكُن حَسَناً","أَو طُرفَةً عُدَّت مِنَ النَزرِ",22,"ر",1,1],["لا تَهَدّى سُبلَ العُروقِ وَلا تَن","سلُّ في مِفصَلٍ بِغَيرِ دَليلِ",23,"ل",1,0],["لا تَهولَنَّكَ الكِباشُ فَقَد أُع","طيتَ ما شِئتَ مِن أَداةِ النِطاحِ",24,"ح",1,0],["لا تَهجُرُ الأَنواءُ مَنبِتَها وَلا","قَلبُ الثَرى القاسي عَلَيها قاسي",25,"س",2,0],["لا تهينوا أهلَ علمٍ","فإذا همْ سمُّ ساعَهْ",26,"ه",1,0],["لا تُهلِكيني في عَذابِكُمُ","فَاللَهُ يَعلَمُ غائِبَ القَلبِ",27,"ب",1,0],["لا تَهب قَلبك الكَريمَ لَئيماً","تَحتَ رجليهِ عابثاً يَلقيهِ",28,"ه",1,0],["لاتَ هَنا ذِكرى بُلَهنِيَةِ الدَه","رِ وَأَنّى ذِكرى السِنينَ المَواضي",29,"ض",2,0],["لا تَهوَيَنَّ يَزيداً","بَعدَ الَّذي قَد أَراكا",30,"ك",2,0],["لا تَهجُرَنَّ الحَبيبَ إِن هَجَرا","وَلا تُعاقِبهُ بِالَّذي فَعَلا",31,"ل",2,1],["لا تَهزَأَن بِالشَيخِ كَم مِن لَيلَةٍ","جازَت بِهِ كَالبَدرِ يَحسُنُ دَلُّهُ",32,"ل",2,0],["لا تَهَبهُ وَلا سِواهُ مِنَ الطَي","رِ فَما يَتَّقي أَخو الُبِّ تَبلَه",33,"ل",2,0],["لا تُهاوِن بِصَغيرٍ مِن عِدىً","فَقَديماً كَسَرَ الرُمحُ القَلَم",34,"م",1,0],["لا تُهادِ القُضاةُ كَي تَظلِمَ الخَ","صمَ وَلا تَذكُرَنَّ ماتُهديهِ",35,"ه",1,1],["لا تَهتضِمْ إن بتَّ ضَيفاً له","فخُبزُهُ في الجوفِ هاضُومُ",36,"م",1,0],["لا تهمل الداء الصَغير فإنه","يَنمو ويصبح فيك وهو عقام",37,"م",1,1],["لا تهربن من النار الَّتي اضطرمت","وإن رمتك فنالَت منك بالشرر",38,"ر",1,0],["لا تَهجُونَّ انس منك فَرُبَّما","تَهجُو أباكَ وأنتَ لا تَدري",39,"ي",1,0],["لا تَهُن خَطبنَا فإِن يَثبُتِ ال","يَجريُ تَذَكَّر قَولي وَصدرُكَ عالِ",40,"ل",1,0],["لا تَهابِي دارَ العُلُومِ مُلِمّاً","آفةُ المجدِ والعُلاَ أَنْ تَهابي",41,"ب",2,0],["لا تَهْتِفُوا بشعاراتٍ مُزَيَّفَة","مَا السلم، والأمن إلا المَيْنُ والكذب",42,"ب",1,0],["لاتهملن ذرة في عبث","فلست متروكا كما شئت سدى",43,"ا",1,0],["لا تُهمليِه واذكري أتعابَهُ","وثقي بسعدٍ فهو لا ينساك",44,"ك",1,0],["لا تَهْنِىءِ الرّومَ استِرَاحَتُهُمْ، فقدْ","هَدَأُوا بأفْوَاهِ الدّرُوبِ، وَنَامُوا",45,"م",3,0],["لا تهمل الكاس حينَ يَحملها","مَن هُوَ في الحُسن واحد فَرد",46,"د",1,1],["لا تُهمِلِ الشِركَ في اِستِئصالِ شَأفَتِها","كَأَنَّما الشامُ جِسمٌ رَأسُهُ حَلَبُ",47,"ب",1,0],["لا تُهَلِّلَن فَرُبَّت ريحٍ","قَد قَفا مِنها النَسيمُ الهَيوفا",48,"ف",2,0],["لا تُهِنْ نفسَك النفيسة بالبخ","ل بهَوْنٍ من تالدٍ وطريف",49,"ف",1,0],["لا تهربوا من لقائي","ويلٌ لكم إن هربتم",50,"م",1,0],["لا تُهِنّي عند خصمٍ","إنما صُنّي، تجدني",51,"ن",2,0],["لا تهملوا من قد غدا","يسموا بكم بين العباد",52,"د",1,0],["لا تَهْجُروا إنّي على ما نابَني","في الدّهرِ إلاّ هَجْرَكم لجَليد",53,"د",1,0],["لا تُهَنّيهِ بِالسَلامَه مِنها","بَل يُعَزّي في نَفسِهِ بِالسَلامَه",54,"م",2,0],["لاتَ هَنَّا ولَيْتَنِي طَرَفَ الزُّجْ","جِ وأَهْلِي بالشَّأْمِ ذاتِ القُرونِ",55,"ن",1,0],["لا تهملوا أمر الشبابِ فربَّم","صاروا مع الإهمالِ كالألغامِ",56,"م",1,0],["لا تَهتَدي الجنُّ فيها من تفاوتها","ولا يتم الصَبا بالوبل وَالحرب",57,"ب",1,0],["لا تهتدي طُرُقُ الصلاح بغيركم","والناسُ بين مضلَّلٍ أو حائرِ",58,"ر",1,0],["لا تهدمِ الكعبة فتنهضَ الهِمَمو","وابْنِ البروجَ جِوارَها فتنحجبُ",59,"ب",1,0],["لا تَهدِموا ما قَد بنا","هُ لَكُمْ كِرامٌ وَاِبتَنيتُ",60,"ت",1,0],["لا تهربوا منه تروا","منه إليه المهرب",61,"ب",1,0],["لا تُهوِّن مِنَ الغَرامِ شَديداُ","إِنَّ بأْسَ الغَرَامِ بَأْسٌ شَدِيد",62,"د",1,0],["لا تهلكن على الصيام صبابةً","سيعود شهركَ قابلاً فاستبشرِ",63,"ر",1,0],["لا تَهُبّني","لا تنفُضي عذبَ البَشامِ",64,"م",1,0],["لاتُهِن صاحبَ البذاذَاةِ والفق","رِ بإكرامِكَ الغنيَّ الرَّواءَ",65,"ا",2,0],["لا تُهملوا فرصةً في اليومِ مُمكِنةٌ","فقد يجيءُ بما لا تشتهون غد",66,"د",1,0],["لا تُهينَنَّ لَبيباً عَضَّه","عَنَتُ الدَّهرِ بِنابِ النُّوَب",67,"ب",1,0],["لا تهجونَّ دنيّاً","واعدُدْهُ في بطنِ رَمْسِه",68,"ه",1,1],["لا تهدي المغرم يا لاحي","فهداك ضلالٌ لا رشدُ",69,"د",1,0],["لا تُهِيلُوا على الأقاحِي تُراباً","فَحرامٌ تَعَفُّرِ الأزْهارِ",70,"ر",1,0],["لا تهملنَّ لذاذةَ الدنيا فقد","رقَّ النسيمُ وراقتِ الصهباءُ",71,"ا",2,0],["لا تهملِ الرجلَ النحيفَ فربما","سبقَ البدينَ إلى لقا الشجعانِ",72,"ن",1,1],["لا تهتك ستري الذي","ألبستني تكرما",73,"م",2,0],["لا تهملن جنسكا","لا تجهلن نَفسَكا",74,"ك",2,0],["لا تهبط الأرض وسر أينما","شئت ولو وُوريت طي البحار",75,"ر",1,0],["لا تهذبه يافعاً إن فيه","للكمالات شيمة شماء",76,"ا",2,0],["لا تهزئي مني فربّت عائب","ما لا يعيب الناس وهو معيب",77,"ب",1,0],["لا تهرجي وَتدرجي وَتبرجي","هَذا الفؤاد لسرك التابوت",78,"ت",1,0],["لا تهيني غلامه فغلام ال","سمح سمحٌ يفاخر الأحرارا",79,"ر",2,0],["لا تهدّدني بشي","لست منه أتوقّى",80,"ق",2,0],["لا تهابُ المنون شيئا ولا تر","عى على والدٍ ولا مولودِ",81,"د",1,0],["لا تهجون أسنَّ منك فربما","تهجو أباك وأنت لا تدري",82,"ي",1,0],["لاَ تهْجَعَنّ وقد سهرتُ فرُبما","سهر الكريمُ لدى الجوار الأنجب",83,"ب",1,0],["لا تُهملنَّ محبتي ومدائحي","وتوسلي وتنصّلي وتغرّبي",83,"ب",2,0],["لا تُهملوا صحبتي زمانَ قُبَا","فلن يضيعُ الكرامُ من صحبوا",84,"ب",3,0],["لا تهيجُ الأُسْدَ من غاباتها","لا تثيرُ النارَ مِنْ تحت الضّرَم",85,"م",1,1],["لا تهجروا من هو محب لكم","من غ