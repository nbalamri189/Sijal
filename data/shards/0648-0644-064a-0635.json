{"poems":[[53,"هب للديار بقية الجلد","https://www.aldiwan.net/poem30519.html","الكامل"],[63,"دعتني بذي الرمث الصبابة موهنا","https://www.aldiwan.net/poem45707.html","الطويل"],[63,"ألا هل يفيق الدهر من سكراته","https://www.aldiwan.net/poem45912.html","الطويل"],[42,"أرقت وهاجتني الهموم الحواضر","https://www.aldiwan.net/poem50385.html","الطويل"],[71,"ولي صاحب يغشى الوغى وهو فارس","https://www.aldiwan.net/poem3865.html","الطويل"],[93,"وافى الحديث إلى غريب الدار","https://www.aldiwan.net/poem11068.html","الكامل"],[93,"أقبلت حرة الشمائل تجلو","https://www.aldiwan.net/poem11264.html","الخفيف"],[23,"إذا ما ترعرع فينا الغلام","https://www.aldiwan.net/poem21628.html","المتقارب"],[72,"الله جارك إن دمعي جاري","https://www.aldiwan.net/poem18715.html","الكامل"],[72,"ولي صديق أرجفته مدحتي","https://www.aldiwan.net/poem19328.html","الرجز"],[72,"ولي صاحب قد غيرته سعادة","https://www.aldiwan.net/poem20520.html","الطويل"],[70,"أأرحل من مصر وطيب نعيمها","https://www.aldiwan.net/poem42799.html","الطويل"],[12,"أقيموا بني أمي صدور مطيكم","https://www.aldiwan.net/poem1219.html",""],[85,"رضي المسلمون والإسلام","https://www.aldiwan.net/poem63740.html","الخفيف"],[43,"عقبى اليمين على عقبى الوغى ندم","https://www.aldiwan.net/poem10529.html","البسيط"],[45,"سلام عليكم لا وفاء ولا عهد","https://www.aldiwan.net/poem63506.html","الطويل"],[66,"ولي صاحب يسترجع الناس كلما","https://www.aldiwan.net/poem38593.html","الطويل"],[66,"ولي صاحب كهواء الخريف","https://www.aldiwan.net/poem38777.html","المتقارب"],[69,"ولي صاحب بالمدح والهجو كسبه","https://www.aldiwan.net/poem28974.html","الطويل"],[52,"ولي صارم فيه المنايا كوامن","https://www.aldiwan.net/poem27323.html","الطويل"],[133,"ما للحوادث تنئينا وتدنينا","https://www.aldiwan.net/poem49191.html","البسيط"],[158,"متى ياتي بقربكم البشير","https://www.aldiwan.net/poem58949.html","الوافر"],[162,"ولي صاحب ما كنت أهوى اقترابه","https://www.aldiwan.net/poem67824.html","الطويل"],[210,"أشاقك رسم أم أشاقك مربع","https://www.aldiwan.net/poem37864.html","الطويل"],[227,"وراح عليها كالجمان المدحرج","https://www.aldiwan.net/poem51197.html","الطويل"],[227,"ولى صاحب لا يمرض العقل جهله","https://www.aldiwan.net/poem51253.html","الطويل"],[257,"من رام نيل النعم الخالده","https://www.aldiwan.net/poem35824.html","الرجز"],[280,"لحاظ المهى لا بابل تنفث السحرا","https://www.aldiwan.net/poem32789.html","الطويل"],[283,"أمحمد بن الشيخ يا فخر القضا","https://www.aldiwan.net/poem39394.html","الكامل"],[301,"ولي صاحب لو شريت الودا","https://www.aldiwan.net/poem58197.html","المتقارب"],[346,"ولي صغيران أعرى من سيوف وغى","https://www.aldiwan.net/poem20254.html","البسيط"],[364,"ولي صاحب ما خفت من جور حادث","https://www.aldiwan.net/poem17144.html","الطويل"],[364,"إليك بعد انقضاء الجد واللعب","https://www.aldiwan.net/poem17151.html","البسيط"],[364,"ولي صاحب ما منه لي عند حاجة","https://www.aldiwan.net/poem17375.html","الطويل"],[369,"ولي صاحب صاحبته ذو قرابة","https://www.aldiwan.net/poem57216.html","الطويل"],[390,"أشبب لكن بالمعالي أشبب","https://www.aldiwan.net/poem53620.html","الطويل"],[462,"ولي صاحب لا حاطه الله صاحباً","https://www.aldiwan.net/poem3433.html","عموديه"],[466,"تشتت شمل الصبر واتصل الضد","https://www.aldiwan.net/poem60222.html","الطويل"],[493,"ولي صاحب لما أتاني كتابه","https://www.aldiwan.net/poem9880.html","الطويل"],[536,"هم المعذبون في الأرض","https://www.aldiwan.net/poem48310.html","عموديه"],[549,"لذ بالعزاء فلا خل تضن به","https://www.aldiwan.net/poem47346.html","البسيط"],[549,"ولي صاحب لا يصحب الضيم ربه","https://www.aldiwan.net/poem48089.html","الطويل"]],"verses":[["وَلَيَصبِرَنَّ لِوَقعِ صاعِقَتي","وَيوَطَّنَنَّ حَشاً عَلى الزُؤُدِ",0,"د",1,0],["وَلي صاحِبٌ مِن عَبدِ شَمسٍ أَبُثُّهُ","شُجوني حَليفُ المَجدِ حُلوٌ شَمائِلُهْ",1,"ل",2,0],["وَلي صاحِبٌ مِنْ عَبْدِ شَمْسٍ إِذا انْتَمى","تَسَنَّمَ أَعْلَى ذِرْوَةِ الشَّرَفِ الضَّخْمِ",2,"م",1,0],["وَلي صاحِبٌ قَد رابَني أَو ظَلَمتُهُ","كَذَلِكَ ما الخَصمانِ بَرٌّ وَفاجِر",3,"ر",1,0],["وَلي صاحِبٌ يَغشى الوَغى وَهوَ فارِسٌ","وَيَعجَزُ أَن يَغشى الوَغى وَهوَ راجِلُ",4,"ل",1,1],["وليصبروا للحادثات إذا عصت","آمالهم فالفوز للصبار",5,"ر",1,0],["وَلِيَصِيبَا مِنْ كُلِّ سَعْدٍ وَمَجْدٍ","مَا إِلَيْهِ قَلْبَاهُمَا يَصْبُوَانِ",6,"ن",1,0],["وَلي صاحِبٌ مِن بَني الشَيصَبانِ","فَطَوراً أَقولُ وَطَوراً هُوَه",7,"ه",3,0],["وليصطبر متفجع فلربما","فقد المنى ومثوبة الصبَّار",8,"ر",1,0],["ولي صديق أرجفته مدحتي","وكانَ ظنِّي أنه لا يرتجف",9,"ف",1,1],["ولي صاحب قد غيرته سعادة","فما كدت من بعد التواصل ألقاه",10,"ه",1,1],["وَلي صَبوَةُ العُشّاقِ في الشِعرِ وَحدَهُ","وَأَمّا سِواها فَهيَ مِنِّيَ طالِقُ",11,"ق",1,0],["وَلي صاحِبٌ من دونِهم لا يَخونني","إِذا التبسَت كفِّي بِهِ يَتَأكّلُ",12,"ل",1,0],["وَليَصولوا بِمَن لَهُ الدَهرُ عَبدٌ","وَلَهُ السَعدُ تابِعٌ وَغُلامُ",13,"م",1,0],["وَلّى صَوارِمَهُ إِكذابَ قَولِهِمِ","فَهُنَّ أَلسِنَةٌ أَفواهُها القِمَمُ",14,"م",1,0],["وَلي صاحِبٌ عَضبُ المَضارِبِ صارِمٍ","طَويلُ النَجادِ ما يُفَلُّ لَهُ حَدُّ",15,"د",1,0],["وَلي صاحِبٌ يَستَرجِعُ الناسَ كُلَّما","ذَكَرتُ لَهُم أَوصافَهُ وَنُعوتَهُ",16,"ت",2,1],["وَلي صاحِبٌ كَهَواءِ الخَريفِ","يُضِرُّ وَإِن كانَ يُستَعذَبُ",17,"ب",1,1],["ولي صاحبٌ بالمدحِ والهجوِ كسبه","يقول أتدري كيفَ أصنعُ بالخلْقِ",18,"ق",1,1],["وَلي صارِمٌ فيهِ المَنايا كَوامِنٌ","فَما يُنتَضى إِلّا لِسَفكِ دِماءِ",19,"ا",2,1],["وليصحُ من سكرِهِ وليعرفنّ لنا","نزاهةَ العرض مما كان يرمينا",20,"ن",2,0],["ولي صبرٌ بأيديكم قتيلٌ","وقلب بين أظهركم أسيرُ",21,"ر",1,0],["وَلي صاحِبٌ ما كُنتُ أَهوى اِقتِرابَهُ","فَلَمّا اِلتَقَينا كانَ أَكرَمَ صاحِبِ",22,"ب",1,1],["ولي صَعَقات قد عَلَتْ خلف ظعنِهم","وقلبي على فرقاهم يتقطّع",23,"ع",1,0],["ولي صاحبٌ كالمسك بالشهد طبعه","إذا وجَدَ الصَّهباءَ لم يَتَحرَّج",24,"ج",1,0],["ولى صاحب لا يُمْرِضُ العقلَ جهلُه","ولا تَتأذّى النفس منه ولا القلبُ",25,"ب",1,1],["وليصل الأرحام وليعتبر","بما أتى في سورة المائدهْ",26,"ه",1,0],["وَلي صِحابٌ عَمَّني وَعَمَّهُم","بِمَكرُماتٍ ما تَزالُ تَترى",27,"ر",2,0],["وليصبر الباقون ان شاءوا وان","جهلوا فعذرهم لدي ضئيل",28,"ل",1,0],["ولي صاحبٌ لو شريت الودا","د منه بروحي لن أغبنا",29,"ن",2,1],["وَلي صَغِيرانِ أَعْرَى مِن سُيُوف وَغىً","في كَفِّ ذِي حَنَقٍ قَد حَثَّهُ النَّارُ",30,"ر",1,1],["وَلي صاحِبٌ ما خفت مِن جَورِ حادِثٍ","مِنَ الدَهرِ إِلّا كانَ لي مِن وَرائِهِ",31,"ه",1,1],["وَلّى صِباهُ وَأَبقى شُهبَ لَيلَتِهِ","وَالصُبحُ لَيسَ بِمَأمونٍ عَلى الشُهُبِ",32,"ب",1,0],["وَلي صاحِبٌ ما مِنهُ لي عِندَ حاجَةٍ","سِوى الحِلمِ إِن الحِلمَ لي عَنهُ حاجِزُ",33,"ز",1,1],["ولي صاحِبٌ صاحبتُه ذو قَرابةٍ","حَريصٌ علَيها أن تُبَرَّ وتُوصَلا",34,"ل",2,1],["وَلي صبوَةٌ لكِن إِلى حَضرَة العلى","وَبي ظَمَأ لكِن من العِزِّ أَشرَبُ",35,"ب",1,0],["ولي صاحبً لا حاطه الله صاحباً","به الشر ما بين الخلائق يخلقُ",36,"ق",1,1],["وَلي صاحِبٌ ماضي الغِرارِ مُخَدَّمٌ","صَقيلٌ بِهِ تُزهى عضلى العَرَبِ الهِندُ",37,"د",1,0],["ولي صاحب لما أتاني كتابه","نثرت على عنوانه قبلي نثرا",38,"ر",2,1],["وَلي صديقٌ واحدٌ","قَد قالَ قولاً بَرَّاه",39,"ا",2,0],["ولي صديقُ الضّواحي وهو مضطبِعٌ","من العداوة أثواباً له سَلَكا",40,"ك",2,0],["وَلِي صاحِبٌ لا يَصحب الضّيمَ ربُّهُ","لَهُ في دِماءِ الدّارعين قِرابُ",41,"ب",1,1]]}