{"poems":[[55,"هب للديار بقية الجلد","https://www.aldiwan.net/poem30519.html","الكامل"],[65,"دعتني بذي الرمث الصبابة موهنا","https://www.aldiwan.net/poem45707.html","الطويل"],[65,"ألا هل يفيق الدهر من سكراته","https://www.aldiwan.net/poem45912.html","الطويل"],[44,"أرقت وهاجتني الهموم الحواضر","https://www.aldiwan.net/poem50385.html","الطويل"],[73,"ولي صاحب يغشى الوغى وهو فارس","https://www.aldiwan.net/poem3865.html","الطويل"],[95,"وافى الحديث إلى غريب الدار","https://www.aldiwan.net/poem11068.html","الكامل"],[95,"أقبلت حرة الشمائل تجلو","https://www.aldiwan.net/poem11264.html","الخفيف"],[23,"إذا ما ترعرع فينا الغلام","https://www.aldiwan.net/poem21628.html","المتقارب"],[74,"الله جارك إن دمعي جاري","https://www.aldiwan.net/poem18715.html","الكامل"],[74,"ولي صديق أرجفته مدحتي","https://www.aldiwan.net/poem19328.html","الرجز"],[74,"ولي صاحب قد غيرته سعادة","https://www.aldiwan.net/poem20520.html","الطويل"],[72,"أأرحل من مصر وطيب نعيمها","https://www.aldiwan.net/poem42799.html","الطويل"],[12,"أقيموا بني أمي صدور مطيكم","https://www.aldiwan.net/poem1219.html",""],[87,"رضي المسلمون والإسلام","https://www.aldiwan.net/poem63740.html","الخفيف"],[45,"عقبى اليمين على عقبى الوغى ندم","https://www.aldiwan.net/poem10529.html","البسيط"],[47,"سلام عليكم لا وفاء ولا عهد","https://www.aldiwan.net/poem63506.html","الطويل"],[68,"ولي صاحب يسترجع الناس كلما","https://www.aldiwan.net/poem38593.html","الطويل"],[68,"ولي صاحب كهواء الخريف","https://www.aldiwan.net/poem38777.html","المتقارب"],[71,"ولي صاحب بالمدح والهجو كسبه","https://www.aldiwan.net/poem28974.html","الطويل"],[54,"ولي صارم فيه المنايا كوامن","https://www.aldiwan.net/poem27323.html","الطويل"],[96,"البلبل الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=12827",""],[139,"ما للحوادث تنئينا وتدنينا","https://www.aldiwan.net/poem49191.html","البسيط"],[164,"متى ياتي بقربكم البشير","https://www.aldiwan.net/poem58949.html","الوافر"],[168,"ولي صاحب ما كنت أهوى اقترابه","https://www.aldiwan.net/poem67824.html","الطويل"],[216,"أشاقك رسم أم أشاقك مربع","https://www.aldiwan.net/poem37864.html","الطويل"],[234,"وراح عليها كالجمان المدحرج","https://www.aldiwan.net/poem51197.html","الطويل"],[234,"ولى صاحب لا يمرض العقل جهله","https://www.aldiwan.net/poem51253.html","الطويل"],[264,"من رام نيل النعم الخالده","https://www.aldiwan.net/poem35824.html","الرجز"],[287,"لحاظ المهى لا بابل تنفث السحرا","https://www.aldiwan.net/poem32789.html","الطويل"],[290,"أمحمد بن الشيخ يا فخر القضا","https://www.aldiwan.net/poem39394.html","الكامل"],[308,"ولي صاحب لو شريت الودا","https://www.aldiwan.net/poem58197.html","المتقارب"],[353,"ولي صغيران أعرى من سيوف وغى","https://www.aldiwan.net/poem20254.html","البسيط"],[371,"ولي صاحب ما خفت من جور حادث","https://www.aldiwan.net/poem17144.html","الطويل"],[371,"إليك بعد انقضاء الجد واللعب","https://www.aldiwan.net/poem17151.html","البسيط"],[371,"ولي صاحب ما منه لي عند حاجة","https://www.aldiwan.net/poem17375.html","الطويل"],[376,"ولي صاحب صاحبته ذو قرابة","https://www.aldiwan.net/poem57216.html","الطويل"],[398,"أشبب لكن بالمعالي أشبب","https://www.aldiwan.net/poem53620.html","الطويل"],[469,"ولي صاحب لا حاطه الله صاحباً","https://www.aldiwan.net/poem3433.html","عموديه"],[473,"تشتت شمل الصبر واتصل الضد","https://www.aldiwan.net/poem60222.html","الطويل"],[500,"ولي صاحب لما أتاني كتابه","https://www.aldiwan.net/poem9880.html","الطويل"],[543,"هم المعذبون في الأرض","https://www.aldiwan.net/poem48310.html","عموديه"],[556,"لذ بالعزاء فلا خل تضن به","https://www.aldiwan.net/poem47346.html","البسيط"],[556,"ولي صاحب لا يصحب الضيم ربه","https://www.aldiwan.net/poem48089.html","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86614","الطويل"],[981,"","https://poetry.dctabudhabi.ae/diwan/poem/147731","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62524","الوافر"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61188","الطويل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61164","المتقارب"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61158","الطويل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56278","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64707","المتقارب"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65049","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49567","السريع"],[1724,"","https://poetry.dctabudhabi.ae/diwan/poem/144782","الطويل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120744","الرمل"],[2366,"","https://poetry.dctabudhabi.ae/diwan/poem/146912","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60828","البسيط"],[2443,"","https://poetry.dctabudhabi.ae/diwan/poem/144867","الطويل"],[2491,"","https://poetry.dctabudhabi.ae/diwan/poem/115071","الطويل"],[2512,"","https://poetry.dctabudhabi.ae/diwan/poem/203821","المتقارب"],[563,"","https://poetry.dctabudhabi.ae/diwan/poem/199179","الطويل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58427","الطويل"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115823","الرجز"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115576","المنسرح"],[3176,"","https://poetry.dctabudhabi.ae/diwan/poem/203962","المتقارب"],[3344,"","https://poetry.dctabudhabi.ae/diwan/poem/146487","الطويل"],[3362,"","https://poetry.dctabudhabi.ae/diwan/poem/31652","الطويل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/140037","الطويل"],[3484,"","https://poetry.dctabudhabi.ae/diwan/poem/216443",""],[3760,"","https://poetry.dctabudhabi.ae/diwan/poem/143919","المنسرح"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32803","المتقارب"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32780","الطويل"],[3904,"","https://poetry.dctabudhabi.ae/diwan/poem/202481","الطويل"],[4039,"","https://poetry.dctabudhabi.ae/diwan/poem/32995","البسيط"],[4258,"","https://poetry.dctabudhabi.ae/diwan/poem/18999","الطويل"],[4671,"","https://poetry.dctabudhabi.ae/diwan/poem/199873","المنسرح"],[4703,"سقى بلداً أهلي به وأقاربي","https://www.poetsgate.com/ViewPoem.aspx?id=181311",""],[4767,"شمس الهدى","https://www.poetsgate.com/ViewPoem.aspx?id=179940",""],[5038,"إبن الفراتين","https://www.poetsgate.com/ViewPoem.aspx?id=188955",""],[5225,"مدارات","https://www.poetsgate.com/ViewPoem.aspx?id=36080",""],[5409,"ولي صاحبٌ قد كنت أوثر حبه","https://www.poetsgate.com/ViewPoem.aspx?id=155377",""],[5431,"وماالنصر إلا من قلوبٍ جسورة","https://www.poetsgate.com/ViewPoem.aspx?id=187798",""],[5431,"شغوفٌ كما قلبي..","https://www.poetsgate.com/ViewPoem.aspx?id=190343",""],[5431,"ولكن أداينه ....","https://www.poetsgate.com/ViewPoem.aspx?id=214829",""],[5616,"وثن","https://www.poetsgate.com/ViewPoem.aspx?id=203456",""],[402,"أقبلت حرة الشمائل تلججو","https://www.poetsgate.com/ViewPoem.aspx?id=36478",""],[5804,"لا متواضع ولا متكبر","https://www.poetsgate.com/ViewPoem.aspx?id=195258",""],[5818,"دعابة","https://www.poetsgate.com/ViewPoem.aspx?id=186920",""],[5818,"دعي شِعري يموجُ","https://www.poetsgate.com/ViewPoem.aspx?id=187478",""],[5953,"ولي صاحب إذا كان تقديره الغنى","https://www.poetsgate.com/ViewPoem.aspx?id=93864",""],[6147,"شهوة سريالية.. ليلة سقوط بغداد..","https://www.poetsgate.com/ViewPoem.aspx?id=151487",""]],"verses":[["وَلَيَصبِرَنَّ لِوَقعِ صاعِقَتي","وَيوَطَّنَنَّ حَشاً عَلى الزُؤُدِ",0,"د",1,0],["وَلي صاحِبٌ مِن عَبدِ شَمسٍ أَبُثُّهُ","شُجوني حَليفُ المَجدِ حُلوٌ شَمائِلُهْ",1,"ل",2,0],["وَلي صاحِبٌ مِنْ عَبْدِ شَمْسٍ إِذا انْتَمى","تَسَنَّمَ أَعْلَى ذِرْوَةِ الشَّرَفِ الضَّخْمِ",2,"م",1,0],["وَلي صاحِبٌ قَد رابَني أَو ظَلَمتُهُ","كَذَلِكَ ما الخَصمانِ بَرٌّ وَفاجِر",3,"ر",1,0],["وَلي صاحِبٌ يَغشى الوَغى وَهوَ فارِسٌ","وَيَعجَزُ أَن يَغشى الوَغى وَهوَ راجِلُ",4,"ل",1,1],["وليصبروا للحادثات إذا عصت","آمالهم فالفوز للصبار",5,"ر",1,0],["وَلِيَصِيبَا مِنْ كُلِّ سَعْدٍ وَمَجْدٍ","مَا إِلَيْهِ قَلْبَاهُمَا يَصْبُوَانِ",6,"ن",1,0],["وَلي صاحِبٌ مِن بَني الشَيصَبانِ","فَطَوراً أَقولُ وَطَوراً هُوَه",7,"ه",3,0],["وليصطبر متفجع فلربما","فقد المنى ومثوبة الصبَّار",8,"ر",1,0],["ولي صديق أرجفته مدحتي","وكانَ ظنِّي أنه لا يرتجف",9,"ف",1,1],["ولي صاحب قد غيرته سعادة","فما كدت من بعد التواصل ألقاه",10,"ه",1,1],["وَلي صَبوَةُ العُشّاقِ في الشِعرِ وَحدَهُ","وَأَمّا سِواها فَهيَ مِنِّيَ طالِقُ",11,"ق",1,0],["وَلي صاحِبٌ من دونِهم لا يَخونني","إِذا التبسَت كفِّي بِهِ يَتَأكّلُ",12,"ل",1,0],["وَليَصولوا بِمَن لَهُ الدَهرُ عَبدٌ","وَلَهُ السَعدُ تابِعٌ وَغُلامُ",13,"م",1,0],["وَلّى صَوارِمَهُ إِكذابَ قَولِهِمِ","فَهُنَّ أَلسِنَةٌ أَفواهُها القِمَمُ",14,"م",1,0],["وَلي صاحِبٌ عَضبُ المَضارِبِ صارِمٍ","طَويلُ النَجادِ ما يُفَلُّ لَهُ حَدُّ",15,"د",1,0],["وَلي صاحِبٌ يَستَرجِعُ الناسَ كُلَّما","ذَكَرتُ لَهُم أَوصافَهُ وَنُعوتَهُ",16,"ت",2,1],["وَلي صاحِبٌ كَهَواءِ الخَريفِ","يُضِرُّ وَإِن كانَ يُستَعذَبُ",17,"ب",1,1],["ولي صاحبٌ بالمدحِ والهجوِ كسبه","يقول أتدري كيفَ أصنعُ بالخلْقِ",18,"ق",1,1],["وَلي صارِمٌ فيهِ المَنايا كَوامِنٌ","فَما يُنتَضى إِلّا لِسَفكِ دِماءِ",19,"ا",2,1],["ولي صاحب أعقيته من موّدتي","وما كان مجنون الغرور ليصحبا",20,"ب",2,0],["وليصحُ من سكرِهِ وليعرفنّ لنا","نزاهةَ العرض مما كان يرمينا",21,"ن",2,0],["ولي صبرٌ بأيديكم قتيلٌ","وقلب بين أظهركم أسيرُ",22,"ر",1,0],["وَلي صاحِبٌ ما كُنتُ أَهوى اِقتِرابَهُ","فَلَمّا اِلتَقَينا كانَ أَكرَمَ صاحِبِ",23,"ب",1,1],["ولي صَعَقات قد عَلَتْ خلف ظعنِهم","وقلبي على فرقاهم يتقطّع",24,"ع",1,0],["ولي صاحبٌ كالمسك بالشهد طبعه","إذا وجَدَ الصَّهباءَ لم يَتَحرَّج",25,"ج",1,0],["ولى صاحب لا يُمْرِضُ العقلَ جهلُه","ولا تَتأذّى النفس منه ولا القلبُ",26,"ب",1,1],["وليصل الأرحام وليعتبر","بما أتى في سورة المائدهْ",27,"ه",1,0],["وَلي صِحابٌ عَمَّني وَعَمَّهُم","بِمَكرُماتٍ ما تَزالُ تَترى",28,"ر",2,0],["وليصبر الباقون ان شاءوا وان","جهلوا فعذرهم لدي ضئيل",29,"ل",1,0],["ولي صاحبٌ لو شريت الودا","د منه بروحي لن أغبنا",30,"ن",2,1],["وَلي صَغِيرانِ أَعْرَى مِن سُيُوف وَغىً","في كَفِّ ذِي حَنَقٍ قَد حَثَّهُ النَّارُ",31,"ر",1,1],["وَلي صاحِبٌ ما خفت مِن جَورِ حادِثٍ","مِنَ الدَهرِ إِلّا كانَ لي مِن وَرائِهِ",32,"ه",1,1],["وَلّى صِباهُ وَأَبقى شُهبَ لَيلَتِهِ","وَالصُبحُ لَيسَ بِمَأمونٍ عَلى الشُهُبِ",33,"ب",1,0],["وَلي صاحِبٌ ما مِنهُ لي عِندَ حاجَةٍ","سِوى الحِلمِ إِن الحِلمَ لي عَنهُ حاجِزُ",34,"ز",1,1],["ولي صاحِبٌ صاحبتُه ذو قَرابةٍ","حَريصٌ علَيها أن تُبَرَّ وتُوصَلا",35,"ل",2,1],["وَلي صبوَةٌ لكِن إِلى حَضرَة العلى","وَبي ظَمَأ لكِن من العِزِّ أَشرَبُ",36,"ب",1,0],["ولي صاحبً لا حاطه الله صاحباً","به الشر ما بين الخلائق يخلقُ",37,"ق",1,1],["وَلي صاحِبٌ ماضي الغِرارِ مُخَدَّمٌ","صَقيلٌ بِهِ تُزهى عضلى العَرَبِ الهِندُ",38,"د",1,0],["ولي صاحب لما أتاني كتابه","نثرت على عنوانه قبلي نثرا",39,"ر",2,1],["وَلي صديقٌ واحدٌ","قَد قالَ قولاً بَرَّاه",40,"ا",2,0],["ولي صديقُ الضّواحي وهو مضطبِعٌ","من العداوة أثواباً له سَلَكا",41,"ك",2,0],["وَلِي صاحِبٌ لا يَصحب الضّيمَ ربُّهُ","لَهُ في دِماءِ الدّارعين قِرابُ",42,"ب",1,1],["ولي صبغة بالحادثات حديثة","وأخرى بأسرار الوجوب قديمة",43,"ه",1,0],["وَلي صارم في حدّه الحَتف كامَنٌ","يَبلغني ما أَشتَهي مِن مَآرب",44,"ب",1,0],["ولي صاحب أفسى البرية كلّها","يشككني فيه إذا ما تنفسا",45,"س",2,1],["ولي صدر به علم غزير","كأن البحر يلتطم التطاما",46,"م",2,0],["وَلي صُحبة لَم يَسأموا طولَ صُحبَتي","وَما منهم إِلا موات مساعد",47,"د",1,1],["وَلي صاحِبان إِذا ما جَزعت","يُصافح هذاك ذا مسرعا",48,"ع",2,1],["وَلي صاحب ما إِن أحب فراقه","وَلا يَستطيع القَلب عَنهُ تَصبرا",49,"ر",2,1],["وليصحبنّ ركابك السعد الذي","لم تدعه إلا أجاب نعم نعمْ",50,"م",1,0],["وَلي صاحِبٌ لسْتُ أَكْفَى أَذا","هُ إِلاّ إذا ما حَواهُ الجَدَثْ",51,"ث",1,1],["ولي صاحِبٌ أَخْتارُهُ فَيُطيعُني","ويُؤْنِسُني إِنْ أَوْ أَوْحشَتْني الْوَساوِسُ",52,"س",1,1],["ولي صديقٌ من بني أغْلَبٍ","يَدٌ تُوَاسِي ويدٌ تَاسُو",53,"س",2,0],["ولي صدق برهان على ما ادعيته","فإن ثمار الأرض فضل سحائبي",54,"ب",2,0],["وَليَصِل زهواً على سحر القنا","وليهزَّ العطف إن هزت قدودا",55,"د",2,0],["ولي صاحب ما حال عن حسن عهده","ولم تر عيني منه أوفى وأكرما",56,"م",2,1],["ولي صَحَائفُ شوقٍ فيك لو قُرئِت","على السَّحاب لمذا كَفّتْ لَهُ دِيمُ",57,"م",1,0],["ولي صاحب ينفي الأذى عن جوارحي","فيخرجني منه نقيا مطهرا",58,"ر",2,1],["ولي صاحبٌ سرِّي المكتَّمُ عِندَهُ","مخاريقُ نيرانٍ بِلَيلٍ تُحَرَّقُ",59,"ق",1,1],["ولي صاحب ليس لي منية","سوى أن يرى باقياً في تراثي",60,"ي",1,1],["ولي صارم لما اقتحمت به الورى","وحوّمت في الصفين قصد قتال",61,"ل",1,1],["ولي صاحِبٌ طلقُ المحيّا بِصُبغَةٍ","بَهِيُّ المحيّا نَحوهُ النّفسُ حنّت",62,"ت",1,0],["ولي صديق جرت في أفعاله","طورا هناء لي وطورا تعزيه",63,"ي",2,1],["ولي صديقٌ أودّ صحبتهُ","أرَقُّ معنىً من النسيم سرى",64,"ر",2,1],["ولي صاحبان على هامتي","قعودهما مثل حد الوتد",65,"د",1,1],["ولي صاحبٌ قد كمل اللهُ خَلقَه","وليس به نقصٌ يعاب فيُذكرُ",66,"ر",1,1],["وَلي صَاحِبٌ نَحْسٌ على كُلِّ صَاحِبِ","هو الدّاءُ أَعْيا أَنْ يُصيبَ دَواءَ",67,"ا",2,1],["وليٌّ صفيٌّ شرّف اللّه قدره","فأودعه العليا ورفّعهُ عُلوا",68,"و",2,0],["ولي صاف عشب فْوادي أسقاه","أحيا وْرِقَه من عقب لِحْفوف",69,"ف",1,0],["ولي صديق ما مني عدو","مذ وقعت عينه على عدمي",70,"م",2,1],["وَلي صاحِبٌ زُرتُهُ لِلسّلامِ","فَقابَلَني بِالحِجابِ الصُراحِ",71,"ح",1,1],["وَلي صاحِبٌ لا قَدَّسَ اللَهُ روحَهُ","وَكانَ مِنَ الخَيراتِ غَيرَ قَريبِ",72,"ب",1,1],["ولي صاحبٌ أحنو عليه وإنّه","ليوجعني حيناً فلا أتوجّع",73,"ع",1,1],["وَلِيَّ صَحابَتُهُ عَن حَرِّ مَلحَمَةٍ","وَشَدَّ عِمرانُ كَالضَرغامَةِ الهَصَرِ",74,"ر",1,0],["وَلي صاحيبٌ في الغارِ هَدَّكَ صاحِباً","هُوَ الجَونُ إِلّا أَنَّهُ لا يُعَلَّلُ",75,"ل",1,0],["ولي صديق ما مسني عدم","مذ وقعت عينه على عدمي",76,"م",2,1],["ولي صبية مثل الفراخ بقفرة","مضى حاضناها فاطحتها الطوائح",77,"ح",1,0],["وليصدعِ الحق أمراً كان منتظِراً","فاليوم قد ساء للطاغين مُنقلَبا",78,"ب",2,0],["ولي صيتُ كوفانٍ وتاريخُ حيدرٍ","وآثارُ أهْلِ الْبيتِ نورُ المراقدِ",79,"د",1,0],["ولي صديقٍ للظبي ناصب شرك","يحسب أن الظبي في أمره غتير",80,"ر",1,0],["ولي صاحبٌ قد كنت أوثر حبه","فلما أساء انسل من قلبي الحب",81,"ب",1,1],["ولي صهوة الشعر الجموح إذا سما","له حمحمات الخيل قبل تقحم",82,"م",1,0],["ولي صبر أيوب وعزمٌ كنملة","ويسعى معي نملي جيوشا ترافقُ",83,"ق",1,0],["ولي صدق أنكيدو إذا الموت ضمّه","وفيّا فلم يحنث بخلٍّ يواطنه",84,"ن",2,0],["ولي صديق إذا ما مسني سغب","أراه قبل أوان الخبز قد عجنا",85,"ن",2,0],["وليصيبا من كل سعد ومجد","ما غليه قلباهما يصبوان",86,"ن",1,0],["ولي صولةٌ لو كانَ يعلمُ شأنَها","لطأطأَ رأسًا واستعاذَ من الشرِّ",87,"ر",1,0],["ولي صديقٌ إذا أودَعْتُهُ سِرًّا","رمَاهُ في البحرِ ف الأسْرارُ مغمورهْ",88,"ر",2,0],["ولي صوتٌ ب أعماقي حبيسٌ","يعارضني ويحسبها شجاعَهْ",89,"ع",2,0],["ولي صاحب إذا كان تقديره الغنى","ونحن بحيث الكل من معدن الأصل",90,"ل",1,1],["ولي صولجان وتاج وعرش","وحولي الحشود تُحَنّي الظهورا",91,"ر",2,0]]}