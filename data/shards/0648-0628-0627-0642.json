{"poems":[[37,"فلولا الله ثم ندى ابن ليلى","https://www.aldiwan.net/poem39178.html","الوافر"],[66,"ثلاثة أحرف لا عجم فيها","https://www.aldiwan.net/poem67614.html","الوافر"],[47,"لما وصلت أسماء من حبلنا شكر","https://www.aldiwan.net/poem63563.html","الطويل"],[60,"إذا عاش الفتى ستين عاما","https://www.aldiwan.net/poem30886.html","الوافر"],[82,"وباقة مستحسن نورها","https://www.aldiwan.net/poem31558.html","السريع"],[119,"بدأت ببسم الله في مبدأ الأمر","https://www.aldiwan.net/poem42205.html","الطويل"],[190,"وليلة حسبت فيها نفسي","https://www.aldiwan.net/poem43726.html","الرجز"],[215,"عدنا إلى الحب عدنا","https://www.aldiwan.net/poem46249.html","المجتث"],[228,"حين أقبلت والهوى فيك يحبو","https://www.aldiwan.net/poem39723.html","الخفيف"],[275,"العيد بالنور والأزهار حياك","https://www.aldiwan.net/poem35258.html","البسيط"],[276,"لكل خطب مهم حسبي الله","https://www.aldiwan.net/poem52129.html","البسيط"],[324,"ألم تسمع بمعركة الهبود","https://www.aldiwan.net/poem23902.html","الوافر"],[398,"يا زائرين اجتمعوا جموعا","https://www.aldiwan.net/poem53509.html","الرجز"],[435,"وباقة زهر من أقاح منحتها","https://www.aldiwan.net/poem41431.html","الطويل"],[435,"وباقة زهر من مليك منحتها","https://www.aldiwan.net/poem41433.html","الطويل"],[449,"عندما النور تدلى كالسجوف","https://www.aldiwan.net/poem56032.html","عموديه"],[463,"هل في الشموس التي تحدى بها العير","https://www.aldiwan.net/poem56166.html","البسيط"],[473,"وباقلاء مونق المنظر","https://www.aldiwan.net/poem60015.html","السريع"],[563,"بحمد الله من أَلهَم","https://www.aldiwan.net/poem32904.html","عموديه"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126754","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38182","الطويل"],[901,"","https://poetry.dctabudhabi.ae/diwan/poem/77452","الوافر"],[1204,"","https://poetry.dctabudhabi.ae/diwan/poem/123659","الوافر"],[1459,"","https://poetry.dctabudhabi.ae/diwan/poem/138019",""],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79999","السريع"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124720","السريع"],[2029,"","https://poetry.dctabudhabi.ae/diwan/poem/123709","الوافر"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137927",""],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47112","الطويل"],[2451,"","https://poetry.dctabudhabi.ae/diwan/poem/103353","المجتث"],[2457,"","https://poetry.dctabudhabi.ae/diwan/poem/99074","الهزج"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65945","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74202","الطويل"],[3082,"","https://poetry.dctabudhabi.ae/diwan/poem/202457","الطويل"],[3083,"","https://poetry.dctabudhabi.ae/diwan/poem/137985",""],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132550","الخفيف"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86319","الوافر"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132138","البسيط"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117922","الخفيف"],[3722,"","https://poetry.dctabudhabi.ae/diwan/poem/202359","الرجز"],[3797,"","https://poetry.dctabudhabi.ae/diwan/poem/103805","الرجز"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114370","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77070","الرجز"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119435","الرجز"],[4029,"","https://poetry.dctabudhabi.ae/diwan/poem/119402","السريع"],[4083,"","https://poetry.dctabudhabi.ae/diwan/poem/147649","الكامل"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102756","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136489",""],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83391","الطويل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117281","الطويل"],[4374,"","https://poetry.dctabudhabi.ae/diwan/poem/130562","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139542",""],[4737,"باب النجار مخلع","https://www.poetsgate.com/ViewPoem.aspx?id=212576",""],[4869,"الحياه الملوكيّه","https://www.poetsgate.com/ViewPoem.aspx?id=137909",""],[4869,"بشار الاسد وحمزه كاشغري وباقي الفئران ...","https://www.poetsgate.com/ViewPoem.aspx?id=151705",""],[4883,"صورة با الألوان","https://www.poetsgate.com/ViewPoem.aspx?id=48361",""],[4899,"الوصايا","https://www.poetsgate.com/ViewPoem.aspx?id=177222",""],[5081,"الله","https://www.poetsgate.com/ViewPoem.aspx?id=185837",""],[3591,"حلفتُ بأن أدوم على هواكا","https://www.poetsgate.com/ViewPoem.aspx?id=149396",""],[5136,"سيدي يا شرف الدين","https://www.poetsgate.com/ViewPoem.aspx?id=121936",""],[5150,"المرأة .. بنصف عقل ...!","https://www.poetsgate.com/ViewPoem.aspx?id=203061",""],[5198,"ضحكتك حفلة","https://www.poetsgate.com/ViewPoem.aspx?id=135389",""],[5431,"تضيئ قناديل حروفٍ وتَسْرجُ","https://www.poetsgate.com/ViewPoem.aspx?id=188077",""],[5490,"نساء","https://www.poetsgate.com/ViewPoem.aspx?id=176174",""],[5525,"الشفق","https://www.poetsgate.com/ViewPoem.aspx?id=921",""],[469,"جزتَ في المجد والفعال الشريفِ","https://www.poetsgate.com/ViewPoem.aspx?id=76859",""],[5866,"لوكان فكري يحمر العين مشلول","https://www.poetsgate.com/ViewPoem.aspx?id=182811",""],[5893,"لو أكتبك","https://www.poetsgate.com/ViewPoem.aspx?id=141384",""],[5953,"باب الهداية باب واحد أبدي","https://www.poetsgate.com/ViewPoem.aspx?id=93783",""],[6167,"جمهورية الخلفاء الراشدين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85473&r=&rc=2",""]],"verses":[["وَباقي الوُدِّ ما قَطَعَت قَلوصي","مَهامِه بَينَ مِصرَ إِلى غُرابِ",0,"ب",1,0],["وَباق الحَرفِ مَرموزٌ مُعَمّى","فَلا سَفَرٌ هُناكَ وَلا مُقامُ",1,"م",1,0],["وَباقي شَبابٍ في مَشيبٍ مَغَلَّبٍ","عَلَيهِ اِختِتاءُ اليَومِ يَكثُرُهُ الشَهرُ",2,"ر",1,0],["وَباقي العُمرِ أَسقامٌ وَشَيبٌ","وَهَمٌّ بِاِرتِحالٍ وَاِنتِقالِ",3,"ل",1,0],["وباقةٍ مُسْتَحْسَنٌ نَوْرُهَا","وقد خلتْ في الشمّ من كل طيبْ",4,"ب",1,1],["وباقي فابقيني بوصلك باقياً","ووارث ورثني الوصول كما تدري",5,"ر",2,0],["وباقلي مطيّب وخسّ","وكامخ من نوع كل جنس",6,"س",1,0],["وباقة من زهور","من عطرها قد غفوتم",7,"م",1,0],["وَباقٍ عَلى قَلبي إِلى حينَ أُقبَرُ","مَن تُراها تَكونُ طوبى لِحُبٍّ",8,"ب",1,0],["وباقة الحبّ والإخلاص أفضلُ من","باقاتِ زهرٍ لها نضرٌ بيمناك",9,"ك",1,0],["وَباقر العلم فالمَيمون جعفره","وَكاظم الغيظ موسى من كموساه",10,"ا",2,0],["وَباقي تَغلِبٍ وَبَني إيادٍ","وَحَيُّ النَمرِ رَهطِ أَبي كَنودِ",11,"د",1,0],["وَباقِر العِلم أَخي الذَخائِرِ","وَمَعدن العَلياء وَالمَفاخِر",12,"ر",1,0],["وباقة زهر من أقاح منحتها","تشير بأوصاف البشير وبذله",13,"ل",2,1],["وباقة زهر من مليك منحتها","معطرة الأرواح مثل ثنائه",14,"ا",3,1],["وباقصاه بدا ما هاله","إذ رأى الشمس لها وجه سقيم",15,"م",1,0],["وباقيات على الأحساب سائرة","تصول نحوك حتى يُنفَخَ الصورُ",16,"ر",1,0],["وَباقِلاءٍ مونِقِ المَنظَرِ","أَنفاسُهُ أَذكى مِنَ العَنبَرِ",17,"ر",1,1],["وباقي من حواهُ السفحُ","من قاسيون واستلزمْ",18,"م",1,0],["وَبِأقدامهم على مُلتقاها","قَد أَصابوا عزّاً قديماً ونصرا",19,"ر",2,0],["وَباقَةُ وَردٍ يُدهِشُ العَقلَ نَظمُها","عَلى حُسنِ جَمعٍ مُحكَمِ الضّبطِ وَالرّبطِ",20,"ط",1,1],["وَباقي العَشرَةِ المَرضِيّ عَنهُم","سموا وَعَلا ابنُ عَوفِهم الشِهابا",21,"ب",2,0],["وباقيه مع التصحيف كسْبٌ","إذا ما زدته حرفاً تعُدّه",22,"د",2,0],["وَباقٍ شرعهُ في كُلِّ وَقتٍ","إلى يومِ القيامةِ وارتحالِ",23,"ل",1,0],["وباقرُ الفضل وروحُ العلى","عيسى فهل فخرٌ كذا يوجد",24,"د",1,0],["وباقرُ الدوس فقد رخصوا","في بولها في ساعةِ الحصرِ",25,"ر",1,0],["وباقي الأسم اسم أعجميّ","ويقرأ بأطراد وانعكاس",26,"س",1,0],["وباقيه ادار لمصر ظهراً","وشمّر ذيله هرباً وفرّا",27,"ر",2,0],["وبَاقِرٌ علم وهو والدُ جعفرٍ","أبي الكاظم القرم الهُمامِ بلا جَحْدِ",28,"د",1,0],["وباقلاّءٌ قد أبدى","بنَوره الحسنَ مَحضَه",29,"ض",2,0],["وباقية معي يذه","ب في البر على ظهري",30,"ر",2,0],["وباقيه يعطى فارساً ضعف راجل","وترصخ للملوك والخود والولد",31,"د",1,0],["وَباقي الشُيوخ الصالِحين وَمَن سَعى","إِلى الحَق لَم يَجنح لِظَن وَلا حَدس",32,"س",1,0],["وباقتربت أدعو القريب من الدعا","تعالى وبالرحمن والصمد الوتر",33,"ر",1,0],["وباقي ما معي من كتب في كل مذهب","قسم باحلف على كفك الضخم المخضب",34,"ب",1,0],["وبأقواس نارها ما أصابت","غرضاً بل اصيبت الراميات",35,"ت",1,0],["وَباقِيَه هُو اِسمٌ شهر غَدا","تَراه مَوجوداً لَدى كُل باب",36,"ب",1,0],["وباقةٍ من جميل الشعر أضفرها","عقداً لأفضل من باقات أزهار",37,"ر",1,0],["وبأقوال جعفر حيث صحت","عنه نقضي ونتبع الآثارا",38,"ر",2,0],["وباقي رجالِ النَّقْلِ حَقَّاً مُبَيّناً","وتفسيرُ قَوْلِ الله في الكُلِّ قدَّرَا",39,"ر",2,0],["وباقلاء باقل","يعجب حسناً من رمق",40,"ق",1,1],["وباقي العلوم آلةٌ أو نتيجةٌ","وإلا ضلالات بها القلب يظلمُ",41,"م",1,0],["وَباقِيَ الاِسناد فَليُراجِع","فيهِ الَّذي حَرَّرتَهُ وَيَقنَع",42,"ع",1,0],["وباقلاء أزهر","مثل سموط الجوهر",43,"ر",1,1],["وباقلاء عامر طيبها","من حسنه الناظر مبهوت",44,"ت",1,1],["وبأقحوان قد تضاحك إذ بكت","عين الغمام بمدمع ثجاحِ",45,"ج",3,0],["وباقيهم أهل الفضائل كلهم","فأكرم بهم صحبا كراما أعاليا",46,"ي",2,0],["وباقرهُا علماً وزاخرهُا ندىً","أخو عزماتس ليس تُدرك بالحصر",47,"ر",1,0],["وَباقي لَياليها رَجاءٌ وَرَحمَةٌ","بِمَن جاءَ مَبعوثاً لنا خير رَحمَةِ",48,"ه",1,0],["وباقى الصحاب الغرّ من آل هاشم","ذوى العزّ والعلياء والمجد والفخر",49,"ر",1,0],["وباقصى السعود ناديت ارخ","شيع الآل فادخلوا بسلام",50,"م",1,0],["وباقر العلم الذي نوره","أوضح داجى العلم بل شعَّبا",51,"ب",2,0],["وبأقصى عافيةٍ أبقى","ادفعُها.. لكنْ لا تُدفَعْ",52,"ع",1,0],["وبآقول يآمن تفرعنتي","معْك الحيآه الملوكيّه",53,"ي",2,0],["وبآقي ندرعم في خضم الملآمه","وحربٍ بدون سلآح مآردّت حمآر",54,"ر",1,0],["وباقي من الثلث ليل وراح ثلثين","وأنا اتدّفى على صورتك بردان",55,"ن",1,0],["وباقي الفروض احرص عليها بتدبير","بالك تخلي ركن منهن وتحتار",56,"ر",1,0],["وباقٍ مُلْكُهُ أبدا","كفرنا أو عبدناهُ",57,"ا",2,0],["وباقيهم لئام ليس فيهم","سوى من كان مبتغيا إذا كان",58,"ك",3,0],["وبإقدامك أضحيت","في الناس المقدم",59,"م",1,0],["وباقي النصفِ أوهبهُ","لمهرِ الحبِّ في القلبِ",60,"ب",1,0],["وباقي وصوفك باهياتٍ مطلّة","تسبي عقول وتسرق قلوب وارواح",61,"ح",1,0],["وباقات إبداع أصيل به ارتقت","تطوف قناديل الحروفِ وتَسْرجُ",62,"ج",1,0],["وباقاتُ زهر لأعياد حب","وجمرات عِشق لبرد الشتاء؟",63,"ا",2,0],["وباقي العمر لو عمره يطول","ما يجي سطر في ذهن الورق",64,"ق",1,0],["وبأقلامك الهجاء إذا تفزع من","ها إلى الرّماح الهيف",65,"ف",1,0],["وباقي الصحابة عندنااكرام وزحول","رب ارض عنهم ياعزيز الجلالي",66,"ل",2,0],["وباقي وصوفك خلها بين قوسين","واللي عرفته عنك يا زين ليّه",67,"ي",2,0],["وباقي الكل أنوار ترى لهم","مراتب في سماء الله في الصعد",68,"د",1,0],["وباقي الخلق منقول ومنتسخ","ما بين ذي ظلم أو نير يقد",68,"د",1,0],["وباقى الناسِ يَتْبعُهُمْ بِنَصٍّ","يُقَلِّدُ ما بَنَوهُ وما أقاموا",69,"م",3,0]]}