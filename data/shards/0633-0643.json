الوجدان","https://www.poetsgate.com/ViewPoem.aspx?id=179082",""],[90,"بم أستهل","https://www.poetsgate.com/ViewPoem.aspx?id=179014",""],[90,"بغداد على الغرق","https://www.poetsgate.com/ViewPoem.aspx?id=179069",""],[90,"ثورة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=179144",""],[90,"القرية العراقية","https://www.poetsgate.com/ViewPoem.aspx?id=179130",""],[90,"عقابيل داء","https://www.poetsgate.com/ViewPoem.aspx?id=179142",""],[45,"بِتُّ أُبْدي وَجْداً وَأكْتُمُ وَجْدا","https://www.poetsgate.com/ViewPoem.aspx?id=32950",""],[45,"لَوَتْ بالسّلامِ بَنَاناً خَضِيبا","https://www.poetsgate.com/ViewPoem.aspx?id=31577",""],[80,"سكنَ القلبَ هوى ذي صَلَفٍ","https://www.poetsgate.com/ViewPoem.aspx?id=3645",""],[91,"أنا وهي","https://www.poetsgate.com/ViewPoem.aspx?id=53009",""],[94,"الحبّ والله","https://www.poetsgate.com/ViewPoem.aspx?id=15625",""],[64,"سكنتَ قلبي وفيه منك أسرار","https://www.poetsgate.com/ViewPoem.aspx?id=8511",""],[101,"مَلَّ مِنْ وَجْدِهِ وَمِنْ فَرْطِ مَا بِهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62429&r=&rc=21",""],[91,"أنا وهي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67746&r=&rc=67",""],[92,"مالي سكتُّ، ولا أُهِبْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14598&r=&rc=43",""]],"verses":[["سَكَنتِ القَلبَ حَيثُ خُلِقتِ مِنهُ","فَأَنتِ مِنَ الحَشى وَالناظِرَينِ",0,"ن",1,0],["سَكَنتَ سَوادَ القَلبِ إِذ كُنتَ شِبهَهُ","فَلَم أَدرِ مِن عِزٍّ مِنَ القَلبِ مِنكُما",1,"م",2,0],["سَكَناتُها مَحذورَةٌ وَعُهودُها","مَنقوضَةٌ وَحِبالُها أَنكاثُ",2,"ث",1,0],["سَكَنَ الهَضبَ مِن قَبا فَوَجَدنا","أَثَراً لِلهَوى بِذاكَ الهَضبِ",3,"ب",1,0],["سَكَنتُكِ وَالأَيّامُ بيضٌ كَأَنَّها","مِنَ الطيبِ في أَثوابِنا تَتَقَلَّبُ",4,"ب",1,0],["سَكَتُّ وَلَم أَملِك شَهاداتِ حُبِّكم","وَنَمَّت عَلى وَجهي وِجِسمي نَواطِقُه",5,"ق",2,0],["سُكوتي بَلاءٌ لا أُطيقُ اِحتِمالَهُ","وَقَلبي أَلوفٌ لِلهَوى غَيرُ نازِعِ",6,"ع",1,1],["سكّةُ اللهِ فسُبْحانَ الذي","قدّرَ الصّرْفَ وأعطى ومنَعْ",7,"ع",1,0],["سَكَنْتُمْ فَحَرَّكْتُمْ جحِيمَ جَوَانِحِي","وَغِبْتُمْ فَأَحْضَرْتُمْ لَوَاعِجَ أَحْزَانِي",8,"ي",1,0],["سُكّانُها قد أُسكِنوا جنّهْ","فهُمْ يُلقَّوْنَ بها نَضْرَهْ",9,"ه",1,1],["سكَنَ الحُبُّ فؤادي وعَمَرْ","ونَهَى الشّوْقُ بقَلْبي وأمَرْ",10,"ر",1,1],["سكَنَتْ مَعانيهَا سَوادَ مِدادِها","إنّ المُدامَةَ سِرُّها في القارِ",11,"ر",1,0],["سَكَتُّ فَلَم يَبلُغ بيَ السَكتُ نَقرَةً","وَقُلتُ فَلَم أبلغ بِذمٍّ وَلا مَدحِ",12,"ح",1,0],["سَكَنَت أَنفاسُ حِفني بَعدَ ما","طَيَّبَت في الشَرقِ أَنفاسَ الأَديبِ",13,"ب",1,0],["سَكَنَ الفَيلَسوفُ بَعدَ اِضطِرابِ","إِنَّ ذاكَ السُكونَ فَصلُ الخِطابِ",14,"ب",1,1],["سَكَتنا فَعَزَّ عَلَينا السُكوتُ","وَهانَ الكَلامُ عَلى المُدَّعي",15,"ع",2,0],["سَكَتُّ فَأَصغَروا أَدَبي","وَقُلتُ فَأَكبَروا أَرَبي",16,"ب",2,1],["سَكَنتُ إِلَيكُم وَلَم تَسكُنوا","إِلَيَّ وَقَد كُنتُ نِعمَ الفَتى",17,"ا",1,0],["سَكَنتُمُ جَنَّةً فَيحاءَ لَيسَ بِها","عَيبٌ سِوى أَنَّها في العالَمِ الفاني",18,"ي",1,0],["سَكَنَ الظَلامُ وَباتَ قَلبُكَ يَخفِقُ","وَسَطا عَلى جَنبَيكَ هَمٌّ مُقلِقُ",19,"ق",1,1],["سُكْرُ النّدامى من يديه ولحظه","متعاقب مهما سقى وإذا نظَرْ",20,"ر",1,0],["سكوتٌ على قرع الكؤوس مغرّدٌ","بلحن سرور يترك الهمّ منشقا",21,"ق",2,0],["سكبت لكم منا المَقاول صِرفها","كالراح تسكب من فم الإبريق",22,"ق",1,0],["سكنت الخان في بلدن كأني","أخو سفر تَقاذَفُه الدروب",23,"ب",1,0],["سكنّا ولم يسكن حَراكُ التبدّد","مواطنَ فيها اليوم أيمن من غد",24,"د",1,1],["سَكِرتُ مِن لَحظِهِ لا مِن مُدامَتِهِ","وَمالَ بِالنَومِ عَن عَيني تَمايُلُهُ",25,"ل",2,1],["سَكِّنَنهُ وَاِكفُف إِلَيكَ مِنَ الغَر","بِ تَجِد مائِحاً قَليلَ السِقاطِ",26,"ط",1,0],["سكراً أحيطتْ أبارِيقُ المُدامِ بهِ","فرجعت صوتَ تمتامٍ وفأفاء",27,"ا",2,0],["سكبَ الزمانُ بها غمائمهُ","شهداً فيا لحلاوةِ السّكب",28,"ب",1,0],["سكران من قهوة الساقي ومقلته","فاترك ملامك في السكْرين يا صاحي",29,"ح",2,0],["سكن الثرى فكأنه سكن الحشا","من فرط ما شغلت به أفكاري",30,"ر",2,0],["سكنتُ داراً لصاحبٍ لي","وقصده يستعير داره",31,"ر",2,0],["سكنتُ وابني بدارِ قومٍ","أوقاتنا تارَةً وتارَه",32,"ه",1,1],["سكني الذي مهدت من قلبِي ومن","كبدِي له بينَ الجوانح مفرشا",33,"ش",2,0],["سكنت بالنيل لو لم تكن","جيرانه لم تكُ بالشافي",34,"ي",1,1],["سكاب دموع جرت في مدا","بكاها فأعيت على الآحق",35,"ق",1,0],["سكندريٌّ قلت لما بدا","في صحبه كالبدر في الأنجم",36,"م",1,1],["سَكِرتُ مِنَ المَعنى الَّذي هُوَ طَيِّبُ","وَلَكِن سُكري بِالمَحَبَّةِ أَعجَبُ",37,"ب",1,1],["سُكوتٌ ثُمَّ صَمتٌ ثُمَّ خَرسٌ","وَعِلمٌ ثُمَّ وَجدٌ ثُمَّ رَمسُ",38,"س",1,1],["سَكَنتَ قَلبي وَفيهِ مِنكَ أَسرارُ","فَلتَهنِكَ الدارُ بَل فَليَهنِكَ الجارُ",39,"ر",1,1],["سِكِّينُنَا هذا له حِدَّةٌ","تصلح للتقطيع والوجْءِ",40,"ج",2,1],["سَكَنْتَ سكُوناً كان رَهْناً بِعَدْوَةٍ","عَمَاسٍ كذاكَ اللَّيْثُ للوَثْب يَلْبَدُ",41,"د",1,0],["سَكْرى شبابٍ لا يعاقبه","هرمٌ وعيشٌ دائم رغَدُهْ",42,"د",2,0],["سَكرى وما باتتْ تُعلُّ الأكؤُسا","أذاكَ أمْ أفعى نآدا دهْرسا",43,"س",2,0],["سكرانَ ليلٍ عابراً أو حرسا","لو فرشوها الجندل المضُرَّسا",43,"س",2,0],["سكنت ميماً غير ساكنة","وجعلت ربَّك أنجماً سبعه",44,"ع",2,0],["سُكونٌ كإطراقِ الشُّجاع وسورةٌ","كسورته لا بل أشدُّ وأعْرَمُ",45,"م",1,0],["سُكرٌ ولكنَّهُ من شيمةٍ كَرُمَتْ","لا من كؤوسٍ تعاطاهُنَّ ندمان",46,"ن",1,0],["سَكَتنا وَلَكِنَّ العُيونَ نَواطِقٌ","أَرَقُّ حَديثٍ ما العُيونُ بِهِ تَشدو",47,"د",2,0],["سَكِرنا وَلا خَمر وَلَكِنَّهُ الهَوى","إِذا اِشتَدَّ في قَلبِ اِمرِئٍ ضَعُفَ الرُشدُ",47,"د",1,0],["سَكَتَّ فَقامَ في الأَذهانِ شَكٌّ","وَقُلتَ فَأَصبَحَ الشَكُّ اِعتِقَدا",48,"د",2,0],["سَكَتَ البَدرُ الَّذي راقَبَنا","وَذَوَت في الرَوضِ هاتيكَ الوُرود",49,"د",1,0],["سَكَتَ الغَديرُ كَأَنَّما اِلتَحَفَ الثَرى","وَسَها النَسيمُ كَأَنَّهُ مَذعورُ",50,"ر",1,0],["سَكَنَ الدَهرُ وَحانَت غَفلَةٌ مِنهُ وَغِرَّه","إِنَّهُ العيدُ وَإِنَّ العيدَ مِثلُ العُرسِ مَرَّه",51,"ر",2,0],["سَكَتُّ سُكوتَ الطَيرِ في الرَوضِ بَعدَما","ذَوى الرَوضُ وَاِجتاحَ النَباتَ ذُبولُ",52,"ل",1,0],["سَكَتَ الَّذي راضَ الكَلامَ وَقادَهُ","حَتّى كَأَنَّ لِسانَهُ مَكبولُ",53,"ل",1,0],["سُكّانَ لُبنانَ العَزيزَ وَجِلَّقٍ","حَيّاكُمُ عَنّا النَسيمُ المُرسَلُ",54,"ل",1,0],["سَكَتَّ خَوفاً وَقُلتَ الصَفحَ مِن خُلُقي","وَنِمتَ جُبناً وَقُلتَ الحِلمُ مِن شِيَمي",55,"ي",1,1],["سُكري بِها أَو بِالن