{"poems":[[53,"ألم تسأل اليوم الظباء الكوانس","https://www.aldiwan.net/poem64666.html","الطويل"],[53,"أعاذل غضي بعض هذي الملاوم","https://www.aldiwan.net/poem66072.html","الطويل"],[53,"ألم تُسأل اليوم الظباءُ الكوانسُ","https://www.poetsgate.com/ViewPoem.aspx?id=29406",""],[147,"مساعيك لا تحصى فتدرك بالعد","https://www.aldiwan.net/poem11749.html","الطويل"],[214,"ما كنت أدري قبل نبت العذار","https://www.aldiwan.net/poem13361.html","السريع"],[214,"أما ولماه ورشف القبل","https://www.aldiwan.net/poem13565.html","المتقارب"],[466,"يغشى سراة لقاح الحي منزله","https://www.aldiwan.net/poem15684.html","البسيط"],[487,"من هو أصل وجود","https://www.aldiwan.net/poem24334.html","عموديه"],[612,"","https://poetry.dctabudhabi.ae/diwan/poem/82792","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96641","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79997","الطويل"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106992","الطويل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132605","المتقارب"],[3307,"","https://poetry.dctabudhabi.ae/diwan/poem/145544","الطويل"],[3547,"","https://poetry.dctabudhabi.ae/diwan/poem/134219","الطويل"],[3560,"","https://poetry.dctabudhabi.ae/diwan/poem/117147","الطويل"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85233","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102974","الطويل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69956","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91000","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94554","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94583","البسيط"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35451","الوافر"],[4767,"دوحة الآداب","https://www.poetsgate.com/ViewPoem.aspx?id=194943",""],[1012,"باب الكريم","https://www.poetsgate.com/ViewPoem.aspx?id=186322",""],[4578,"رنا جفنه للأسد بالسحر يقنص","https://www.poetsgate.com/ViewPoem.aspx?id=49452",""],[5183,"نهر الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=186612",""],[4045,"أأحزنك الأولى ردّوا","https://www.poetsgate.com/ViewPoem.aspx?id=200274",""],[5582,"أَلا هَلْ تَوَلَّتْ نَوارٌ نَوارا","https://www.poetsgate.com/ViewPoem.aspx?id=186999",""],[5877,"فتل الاشناب","https://www.poetsgate.com/ViewPoem.aspx?id=37471",""]],"verses":[["به صدَق اللَه الأماني حديثَها","وقد مر دهرٌ والأماني وساوس",0,"س",1,0],["به صدموا الأعداء دُونَ مُناهُمُ","قديماً فهدُّوا ركن كُلِّ مُصادِمِ",1,"م",1,0],["به صدَّق الله الأماني حديثَها","وقد مرّض دهرٌ والأماني وساوس",2,"س",1,0],["بِهِ صَمَمٌ عِندَ السُؤالِ فَإِن لَحى","عَلى الجودِلاحٍ كانَ أَسمَعَ مِن خُلدِ",3,"د",1,0],["به صغار الدر قد نظمت","والثغر احلى الدر فيه الصغار",4,"ر",1,0],["به صرت بين الورى مثلة","ويضرب بي في هواه المثل",5,"ل",1,0],["به صُماتٌ عن العوراء ذو شَرفٍ","حتى اذا سيمَ خيراً مُجْدياً نَطَقا",6,"ق",2,0],["به صدمنا جبالا","محمد عبد صالح",7,"ح",1,0],["بِهِ صُدفة عَما يَرى في زَمانه","وَفيهِ إِلى ماض الزَمان حَنين",8,"ن",1,0],["بِهِ صَلُحت أيّامنا وَعُصورنا","وَقَد زايَلت أوقاتهنَّ المفاسدُ",9,"د",1,0],["به صاحَ ناعيه فأشغلت مسمعي","وقد مضَّ في قعر الحشا منه صائحُ",10,"ح",1,0],["به صرنا لأدنى ما حبانا","من المجد الأثيل مُحَسَّدينا",11,"ن",2,0],["به صبوتي ذات اختلاف فمدمعي","طليق وقلبي بالصبابة موثق",12,"ق",1,0],["به صور الحسن قد مثلت","فلله صانع تلك الصور",13,"ر",1,0],["به صفت الدنيا ودر نعيمها","وطابت لياليها فأهلا ومرحبا",14,"ب",2,0],["به صاحب الأحزان يبدي مسرة","ويخلو يفيض الدمع في الخلوات",15,"ت",1,0],["بهِ صدَأٌ قد عابَهُ فجَلَوتهُ","بِكَفَّيَ حتّي ضوءهُ ضوءُ كوكَبِ",16,"ب",1,0],["بِهِ صَعَدَت هِمّاتِهِ وَهِباتِهِ","إِلى مَنزِلٍ فَوقَ النُجومِ الثَواقِبِ",17,"ب",1,0],["به صحت الأيام بعد اعتلالها","ولولا وجود الخمر ما وجد السكر",18,"ر",1,0],["بِهِ صبح الهِداية قَد نلالا","كَبَرقٍ شَقَّ ديجور الظَلامِ",19,"م",1,0],["به صوموا تصحوا صدقوني","فإن القول ما قالت جزام",20,"م",1,0],["بهِ صونُ آلِ العرض من كل مفترٍ","به درءُ من في الناسِ ضرّاً تعمَّدا",21,"د",2,0],["به صفاتٌ مباهيها موحَّدةٌ","تغني عن العدِّ في التعريف شهرتهُ",22,"ت",2,0],["بِهِ صارَ التَّعَدُّدُ ذا اِتِّحادٍ","بِلا مَزجٍ فَذا شَيءٌ أَحارا",23,"ر",2,0],["به صنتَ المبادىءَ دون خوفٍ","مِنَ المجهولِ مِنْ خلف الستار",24,"ر",1,0],["به صحف الأرواح أشرق نورها","وصين عن الألواح إذ كن أظلما",25,"م",2,0],["به صح إسناد المعارف والندى","وفيما سواه فالحديث تخرص",26,"ص",1,0],["به صارم كالبرق تنفاء دونه","حداد المواضي لا تطاق مخالبه",27,"ب",2,0],["به صدأ الحديد مما","زجا مسكا له أرج",28,"ج",1,0],["بِهِ صارَ رُكْنِي إِلَى قُوَّةٍ","وَراقَ بِهِ رَوْضُ رَبْعِي اخْضِرارا",29,"ر",2,0],["به صاحبٍ يدهن جروحك بالاطياب","وبه صاحبٍ لا رحت تدمي العراقيب",30,"ب",1,0]]}