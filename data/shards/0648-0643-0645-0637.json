{"poems":[[63,"إذا زم للبين الغداة جمال","https://www.aldiwan.net/poem46158.html","الطويل"],[63,"سرت وظلام الليل ستر على الساري","https://www.aldiwan.net/poem46202.html","الطويل"],[3,"دهتني صروف الدهر وانتشب الغدر","https://www.aldiwan.net/poem165.html",""],[77,"رأيت هدايا الأرض دونك قدرها","https://www.aldiwan.net/poem36497.html","الطويل"],[51,"ومن ظن أن الاستزادة في الهوى","https://www.aldiwan.net/poem61896.html","الطويل"],[51,"ثنى شوقه والمرء يصحو ويسكر","https://www.aldiwan.net/poem63015.html","الطويل"],[43,"فدا لك من يقصر عن مداكا","https://www.aldiwan.net/poem9756.html","الوافر"],[45,"أقصر حميد لا عزاء لمغرم","https://www.aldiwan.net/poem65656.html","الطويل"],[28,"أهاج لك الشوق القديم خياله","https://www.aldiwan.net/poem5604.html","الطويل"],[97,"تعال نزف للثغرِ السلاما","https://www.aldiwan.net/poem24357.html","الوافر"],[80,"كفى سيفك الإسلام عادية الكفر","https://www.aldiwan.net/poem31440.html","الطويل"],[46,"لقد ترفع فوق المشتري زحل","https://www.aldiwan.net/poem22192.html","البسيط"],[46,"بوارق للحاب لا للسحاب","https://www.aldiwan.net/poem22301.html","المتقارب"],[46,"عوى في سواد الليل عاف لعله","https://www.aldiwan.net/poem22994.html","الطويل"],[46,"لو كان يدري أويس ماجنت يده","https://www.aldiwan.net/poem23343.html","البسيط"],[46,"لأمواه الشبيبة كيف غضنه","https://www.aldiwan.net/poem23485.html","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142015","الوافر"],[77,"رأيت هدايا الأرض دونك قدرها","https://www.poetsgate.com/ViewPoem.aspx?id=34130",""],[107,"وكم طارحت من ورقاء تشدو","https://www.aldiwan.net/poem16413.html","الوافر"],[113,"شيخي الرفاعي طريقه الأدب","https://www.aldiwan.net/poem41248.html","عموديه"],[113,"عقول الورى تاهت بسلطانك الأعلى","https://www.aldiwan.net/poem42204.html","الطويل"],[124,"للحب دين وللأشواق باقينا","https://www.aldiwan.net/poem794.html",""],[140,"إذا نثر الناس الهرقلية الصفرا","https://www.aldiwan.net/poem58435.html","الطويل"],[141,"شفاء الهدى يا سيفه العضب أن تشفا","https://www.aldiwan.net/poem11779.html","الطويل"],[158,"برغم سنة خير العجم والعرب","https://www.aldiwan.net/poem59217.html","البسيط"],[167,"اليوم سر العلا واستبشر الأدب","https://www.aldiwan.net/poem1607.html",""],[184,"أبا طالب لله در مناقب","https://www.aldiwan.net/poem43271.html","الطويل"],[187,"رأى مدح خير الخلق صعبا فأحجما","https://www.aldiwan.net/poem35105.html","الرمل"],[196,"كم زورة لي بالزوراء خضت بها","https://www.aldiwan.net/poem51870.html","البسيط"],[269,"لاقيت يا نفس حقا ما حكى الحاكي","https://www.aldiwan.net/poem52112.html","البسيط"],[306,"ثورة الشك","https://www.aldiwan.net/poem63238.html","عموديه"],[346,"نصف شهبا قد أرسلتها أهلة","https://www.aldiwan.net/poem20225.html","الطويل"],[359,"هل ذاك ثغر تبسم","https://www.aldiwan.net/poem68065.html","المجتث"],[362,"أقلا عند طيتي المقالا","https://www.aldiwan.net/poem60808.html","الوافر"],[362,"أثرها فقد طال الغداة وقوعها","https://www.aldiwan.net/poem60849.html","الطويل"],[364,"لكل مودة أجر وأجري","https://www.aldiwan.net/poem17316.html","الوافر"],[400,"علام يلام القلب إن ظل حيرانا","https://www.aldiwan.net/poem33375.html","الطويل"],[400,"سلام على نجد ومن حل في نجد","https://www.aldiwan.net/poem33956.html","الطويل"],[403,"ألا هل لعهد العامرية جاحد","https://www.aldiwan.net/poem50184.html","الطويل"],[429,"وكم طويت بساط البيد منفردا","https://www.aldiwan.net/poem12802.html","البسيط"],[436,"تبلج عن إشراق غرتك الصبح","https://www.aldiwan.net/poem34816.html","الطويل"],[436,"شوق شديد ووصل من حبيبين","https://www.aldiwan.net/poem34830.html","البسيط"],[436,"لعل سنا البرق الذي أنا شائم","https://www.aldiwan.net/poem34877.html","الطويل"],[456,"أمن كل حظ قل قسمي أقله","https://www.aldiwan.net/poem56071.html","الطويل"],[456,"أشاقك من حسناء وهنا طروقها","https://www.aldiwan.net/poem56101.html","الطويل"],[459,"بقيت لكل مكرمة وبأس","https://www.aldiwan.net/poem16169.html","الوافر"],[462,"كيف الوقوف على آثار مرتحل","https://www.aldiwan.net/poem3470.html","عموديه"],[480,"بكعبة أنوار أنخت مطيتي","https://www.aldiwan.net/poem24323.html","عموديه"],[513,"أمنت من الغرام على فؤادي","https://www.aldiwan.net/poem12064.html","الوافر"],[513,"أيا أذن الأيام إن قلت فاسمعي","https://www.aldiwan.net/poem12176.html","الطويل"],[549,"سلا عنا المنازل لم بلينا","https://www.aldiwan.net/poem47176.html","الوافر"],[549,"ماذا على الريم لو حيا فأحيانا","https://www.aldiwan.net/poem47179.html","البسيط"],[549,"تطالبني نفسي بما غيره الرضا","https://www.aldiwan.net/poem48086.html","الطويل"],[573,"نعم هذه دار النعيم المعجل","https://www.aldiwan.net/poem2735.html","الطويل"]],"verses":[["وكمْ طَرَقَتْني والنّجومُ كأنّها","على مَفْرِقِ الليْلِ الأحَمِّ ذُبالُ",0,"ل",1,0],["وكمْ طَرَقَتْنا وهْيَ تَدَّرِعُ الدُّجى","وتَمشي الهُوَيْنى بينَ عُونٍ وأبْكارِ",1,"ر",1,0],["وَكَم طَرَقَتني نَكبَةٌ بَعدَ نَكبَةٍ","فَفَرَّجتُها عَنّي وَما مَسَّني ضُرُّ",2,"ر",1,0],["وكمْ طُرْفَةٍ أوْرَدْتُها وغَريبةٍ","يُحَلّى بِها في مجلسِ المُلْكِ نحْرُهُ",3,"ر",2,0],["وكم طالبٍ ربحاً إلى أصل ماله","فآب حَريباً أوْبة الخائب المُكْدِي",4,"د",2,0],["وكم طامح ذي نخوة قد رددتُه","إلى قيمة دون الذي كان يقْدِر",5,"ر",1,0],["وَكَم طَرِبِ المَسامِعِ لَيسَ يَدري","أَيَعجَبُ مِن ثَنائي أَم عُلاكا",6,"ك",2,0],["وَكَم طَلَبَتهُم مِن سَوابِقِ عَبرَةٍ","مَتى ما تُنَهنَه بِالمَلامَةِ تَسجُمِ",7,"م",1,0],["وَكَم طَرَّحَت رَحلاً بِكُلِّ مَفازَةٍ","مِنَ الأَرضِ في دَوِّيَّةٍ وَحُزومِ",8,"م",1,0],["وكم طافَ الرفاقُ وغادروني","كَعُوَّادٍ ومروا بي كراما",9,"م",2,0],["وكم طائرٍ منهم قصصتَ جناحَهُ","فأصبحَ مسجوناً عنِ النَهضِ في الوكرِ",10,"ر",1,0],["وَكَم طَلَبتَ أُموراً لَستَ مُدرِكَها","تَبارَكَ اللَهَ مَن أَغراكَ بِالطَلَبِ",11,"ب",1,0],["وَكَم طَمِحتُ بِاللَبيبِ الأَريبِ","فَأُسقِطَ عَن ظَهرِ طَمّاحِها",12,"ح",3,0],["وَكَم طالِبٍ وافى وَقَد شارَفَ الغِنى","سَوافِيَ ريحٍ فَاِنثَنى بِسُوافِ",13,"ف",1,0],["وَكَم طَرَقتَ عَتوداً بَينَ أَعنِزَةٍ","يَوماً فَفَرَّيتَ من أَحشائِهِ الأَدَما",14,"م",2,0],["وَكَم طَيرٍ قُصِصنَ لِغَيرِ ذَنبٍ","وَأُلزِمنَ السُجونَ فَما نَهَضنَه",15,"ن",2,0],["وكم طيرٍ تسلى عن هواهُ","إذا غنى الأمين زقى وزاكا",16,"ك",2,0],["وكم طرفة أوردتها وغريبة","تجلى بها من مجلس الملك نحره",17,"ر",2,0],["وَكَم طارَحَت مِن وَرقاء تَشدو","عَلى الشرفين بِالوادي السَعيد",18,"د",1,1],["وكم طوى نفسه وذللها","والعجم قد اعظمته والعرب",19,"ب",1,0],["وكم طهرت سراً وكم طيبت جوى","وكم عطرت نفساً وكم أصلحت فعلا",20,"ل",2,0],["وكم طغى السعد في أنحائنا مرحاً","إذا ترنم فوق الرمل شادينا",21,"ن",2,0],["وكم طالبٍ فيه نصيبا وإنه","ليَقبِضُ كفَّيْه إذا عَرف السِّعرا",22,"ر",2,0],["وَكَم طالِبٍ ذا المَجدَ حاوَلَ عَطفَهُ","فَلَمّا أَبى عِزّاً ثَنى دونَهُ عِطفا",23,"ف",2,0],["وكم طيالسة أمست توافقه","على الفصوص وما في تلكم الكتب",24,"ب",1,0],["وَكَم طَرقتُ رِجالاً ينذِرونَ دَمي","أَسقيتُهُم عَلقَماً غَصباً لَهُ شَرِبُوا",25,"ب",3,0],["وكم طالب جدواك أخصبت رحله","وكم غارم أنقذته من مغارم",26,"م",1,0],["وَكَم طاوعَ الشيطانَ فيهِ حواسد","عليهِ لَهُم مِن كلّ شيءٍ شواهدُ",27,"د",1,0],["وكم طرقتُ قِبابَ الحيِّ مرتديا","بصارمٍ مثلِ عزمي هُنْدوانيه",28,"ه",1,0],["وَكَم طيبة صوب المزن منسجما","ما طابَ نفسا بغير حين وافاك",29,"ك",1,0],["وَكَمْ طَافَتْ عَلَيَّ ظِلاَلُ شَكٍّ","أَقَضَّتْ مَضْجَعِي وَاسْتَعْبَدَتْنِي",30,"ن",2,0],["وَكَمْ طَيْرِ مَاءٍ في الرِّياضِ لَهُ دَمٌ","تُضَاهِيهِ مِن حُمْرِ الشَّقَائِقِ زَاهِرُ",31,"ر",1,0],["وَكَم طَلَبت عليا","فَقالَ لا لا وَصمم",32,"م",1,0],["وكم طلَبَ الحَسودُ فلم يُقابِلْ","لنَعْلِك تاجُ مَفْرِقهِ قِبالا",33,"ل",2,0],["وكم طَرَحَ الأعداءَ من سَطَواتهِ","مَطارِحَ لا يرجو انتعاشاً صَريعها",34,"ع",3,0],["وَكَم طَمِعَ الفَتى في غَيرِ كُنهٍ","وَعُرَّ لِصَحبِهِ مِن غَيرِ عُرِّ",35,"ر",1,0],["وكم طائف حول الفنا متخشع","يقبل أحجارً ويلمس أركانا",36,"ن",2,0],["وكم طائف حول القبور مُقبِّل","ويلتمس الأركان منهن بالأيدي",37,"ي",1,0],["وَكَم طلبت عَينايَ في الناس ماجِداً","كَريماً فَناداني النَدى لَيسَ ماجِدُ",38,"د",1,0],["وكم طويتُ بساطِ البيدِ منْفَرداً","والأفْقُ يَنْثُرُ في أرجائه الغَسَقا",39,"ق",2,1],["وكم طَردُوا من تحتِ غيلٍ وغابَةٍ","إِلَيْكَ أُسوداً مَا يُمَلُّ لَهَا ذَبْحُ",40,"ح",1,0],["وكم طَلَبْتُ بِهَا الأَيَّامَ مجتهداً","طِلابَ ربِّ نَفيسِ الدَّيْنِ بالدَّيْنِ",41,"ن",1,0],["وكم طَمَسَتْ عَيْنَيْهِ بَرْقَةُ مُقدِمٍ","تَلأْلأَ فِيهَا مَجْدُكَ المُتَقَادِمُ",42,"م",1,0],["وكم طالبٍ مدحي ليمنعَ رِفدَه","فيُهجَى فيُحيي ذكرَه الميْتَ بخلُهُ",43,"ل",2,0],["وكم طمعٍ في غير نصرك طافَ بي","فما زلتُ خوف المنِّ عني أفُلُّهُ",43,"ل",2,0],["وكم طرِبٍ لي وهو يُنشِد نفسَه","إلى الحول يصبو نحوَها ويتوقُها",44,"ق",3,0],["وكمْ طوَّقْتَ من مِنَنٍ رِقاباً","تَؤودُ كِرامَ أعْناقِ الرِّجالِ",45,"ل",1,0],["وكم طرقت سنا نارْ عزمت لها","والسير بالعزمِ فوق السَّير بالإبلِ",46,"ل",1,0],["وكم طرحتنا مقلة الحرب بغتة","فصرنا أحاديثا بألسن سوقتي",47,"ت",2,0],["وكم طردتنا من مناهل قربها","خواطر لم تنبت على ساق هفوتي",47,"ت",2,0],["وكم طرب الهدى ما تغنت","ظباه في الكواهل والهوادي",48,"ي",1,0],["وكم طوقتني من يد عاضدية","سرت بين يقظى في العيون وهجع",49,"ع",1,0],["وَكَم طافتْ بدَوحَتنا عيونٌ","فلم تَرَ في جوانبها هَجِينا",50,"ن",2,0],["وكم طلبنا مَراماً عزّ مطلبُهُ","لَمّا اِنثَنينا بيَأسٍ عنه واتانا",51,"ن",2,0],["وَكَم طالِبٍ لِي فُتُّه وَسَبقتُهُ","وَلَم يَنجُ منّي هاربٌ أنَا طالِبُهْ",52,"ب",2,0],["وكم طائرٍ من رأْسِهِ الماءُ طَائِرٌ","على أَنَّهُ في وَكْرِه كالمُكبَّل",53,"ل",1,0]]}