i.ae/diwan/poem/81735","الرجز"],[4324,"","https://poetry.dctabudhabi.ae/diwan/poem/105516","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141676","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120384","الوافر"],[4679,"يجد الفتى كما يعيش مُخلَّدَا","https://www.poetsgate.com/ViewPoem.aspx?id=142735",""],[4717,"مرثية الدكتور أحمد زويل","https://www.poetsgate.com/ViewPoem.aspx?id=199624",""],[4767,"موسم الأمطار","https://www.poetsgate.com/ViewPoem.aspx?id=180857",""],[4927,"قصيدة الثورة على الشبيحة","https://www.poetsgate.com/ViewPoem.aspx?id=79601",""],[5013,"دهى هاشما ناع نعى في محرم","https://www.poetsgate.com/ViewPoem.aspx?id=170967",""],[5039,"حطين","https://www.poetsgate.com/ViewPoem.aspx?id=48128",""],[5046,"أنشكو سقاما.. !","https://www.poetsgate.com/ViewPoem.aspx?id=200960",""],[585,"صوتٌ تجاوب بين الهمس والعلن","https://www.poetsgate.com/ViewPoem.aspx?id=161884",""],[5145,"أسير وقلبي في هواك أسير","https://www.poetsgate.com/ViewPoem.aspx?id=108064",""],[5183,"بين القبر والمنبر","https://www.poetsgate.com/ViewPoem.aspx?id=180164",""],[5225,"مسير العاشقينا","https://www.poetsgate.com/ViewPoem.aspx?id=18633",""],[592,"ألا قل لذي جهل تهور في الردى","https://www.poetsgate.com/ViewPoem.aspx?id=128719",""],[5387,"أعودُ إليكِ","https://www.poetsgate.com/ViewPoem.aspx?id=53780",""],[5748,"كم زورة لي بالزوراء خضت بها","https://www.poetsgate.com/ViewPoem.aspx?id=26253",""],[6136,"عبرة إلى الشام","https://www.poetsgate.com/ViewPoem.aspx?id=36239",""],[520,"أيا اذن الأيام ان قلت فاسمعي","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577575",""],[6224,"طواف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88194&r=&rc=9",""],[463,"أمن كلِّ حظٍّ قلَّ قسمي أقلُّهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60189&r=&rc=245",""],[6367,"أشواق حجازية الإيقاع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80598&r=&rc=1",""]],"verses":[["وكمْ طَرَقَتْني والنّجومُ كأنّها","على مَفْرِقِ الليْلِ الأحَمِّ ذُبالُ",0,"ل",1,0],["وكمْ طَرَقَتْنا وهْيَ تَدَّرِعُ الدُّجى","وتَمشي الهُوَيْنى بينَ عُونٍ وأبْكارِ",1,"ر",1,0],["وَكَم طَرَقَتني نَكبَةٌ بَعدَ نَكبَةٍ","فَفَرَّجتُها عَنّي وَما مَسَّني ضُرُّ",2,"ر",1,0],["وكمْ طُرْفَةٍ أوْرَدْتُها وغَريبةٍ","يُحَلّى بِها في مجلسِ المُلْكِ نحْرُهُ",3,"ر",2,0],["وكم طالبٍ ربحاً إلى أصل ماله","فآب حَريباً أوْبة الخائب المُكْدِي",4,"د",2,0],["وكم طامح ذي نخوة قد رددتُه","إلى قيمة دون الذي كان يقْدِر",5,"ر",1,0],["وَكَم طَرِبِ المَسامِعِ لَيسَ يَدري","أَيَعجَبُ مِن ثَنائي أَم عُلاكا",6,"ك",2,0],["وَكَم طَلَبَتهُم مِن سَوابِقِ عَبرَةٍ","مَتى ما تُنَهنَه بِالمَلامَةِ تَسجُمِ",7,"م",1,0],["وَكَم طَرَّحَت رَحلاً بِكُلِّ مَفازَةٍ","مِنَ الأَرضِ في دَوِّيَّةٍ وَحُزومِ",8,"م",1,0],["وكم طافَ الرفاقُ وغادروني","كَعُوَّادٍ ومروا بي كراما",9,"م",2,0],["وكم طائرٍ منهم قصصتَ جناحَهُ","فأصبحَ مسجوناً عنِ النَهضِ في الوكرِ",10,"ر",1,0],["وَكَم طَلَبتَ أُموراً لَستَ مُدرِكَها","تَبارَكَ اللَهَ مَن أَغراكَ بِالطَلَبِ",11,"ب",1,0],["وَكَم طَمِحتُ بِاللَبيبِ الأَريبِ","فَأُسقِطَ عَن ظَهرِ طَمّاحِها",12,"ح",3,0],["وَكَم طالِبٍ وافى وَقَد شارَفَ الغِنى","سَوافِيَ ريحٍ فَاِنثَنى بِسُوافِ",13,"ف",1,0],["وَكَم طَرَقتَ عَتوداً بَينَ أَعنِزَةٍ","يَوماً فَفَرَّيتَ من أَحشائِهِ الأَدَما",14,"م",2,0],["وَكَم طَيرٍ قُصِصنَ لِغَيرِ ذَنبٍ","وَأُلزِمنَ السُجونَ فَما نَهَضنَه",15,"ن",2,0],["وكم طيرٍ تسلى عن هواهُ","إذا غنى الأمين زقى وزاكا",16,"ك",2,0],["وكم طرفة أوردتها وغريبة","تجلى بها من مجلس الملك نحره",17,"ر",2,0],["وَكَم طارَحَت مِن وَرقاء تَشدو","عَلى الشرفين بِالوادي السَعيد",18,"د",1,1],["وكم طوى نفسه وذللها","والعجم قد اعظمته والعرب",19,"ب",1,0],["وكم طهرت سراً وكم طيبت جوى","وكم عطرت نفساً وكم أصلحت فعلا",20,"ل",2,0],["وكم طغى السعد في أنحائنا مرحاً","إذا ترنم فوق الرمل شادينا",21,"ن",2,0],["وكم طالبٍ فيه نصيبا وإنه","ليَقبِضُ كفَّيْه إذا عَرف السِّعرا",22,"ر",2,0],["وَكَم طالِبٍ ذا المَجدَ حاوَلَ عَطفَهُ","فَلَمّا أَبى عِزّاً ثَنى دونَهُ عِطفا",23,"ف",2,0],["وكم طيالسة أمست توافقه","على الفصوص وما في تلكم الكتب",24,"ب",1,0],["وَكَم طَرقتُ رِجالاً ينذِرونَ دَمي","أَسقيتُهُم عَلقَماً غَصباً لَهُ شَرِبُوا",25,"ب",3,0],["وكم طالب جدواك أخصبت رحله","وكم غارم أنقذته من مغارم",26,"م",1,0],["وَكَم طاوعَ الشيطانَ فيهِ حواسد","عليهِ لَهُم مِن كلّ شيءٍ شواهدُ",27,"د",1,0],["وكم طرقتُ قِبابَ الحيِّ مرتديا","بصارمٍ مثلِ عزمي هُنْدوانيه",28,"ه",1,0],["وَكَم طيبة صوب المزن منسجما","ما طابَ نفسا بغير حين وافاك",29,"ك",1,0],["وَكَمْ طَافَتْ عَلَيَّ ظِلاَلُ شَكٍّ","أَقَضَّتْ مَضْجَعِي وَاسْتَعْبَدَتْنِي",30,"ن",2,0],["وَكَمْ طَيْرِ مَاءٍ في الرِّياضِ لَهُ دَمٌ","تُضَاهِيهِ مِن حُمْرِ الشَّقَائِقِ زَاهِرُ",31,"ر",1,0],["وَكَم طَلَبت عليا","فَقالَ لا لا وَصمم",32,"م",1,0],["وكم طلَبَ الحَسودُ فلم يُقابِلْ","لنَعْلِك تاجُ مَفْرِقهِ قِبالا",33,"ل",2,0],["وكم طَرَحَ الأعداءَ من سَطَواتهِ","مَطارِحَ لا يرجو انتعاشاً صَريعها",34,"ع",3,0],["وَكَم طَمِعَ الفَتى في غَيرِ كُنهٍ","وَعُرَّ لِصَحبِهِ مِن غَيرِ عُرِّ",35,"ر",1,0],["وكم طائف حول الفنا متخشع","يقبل أحجارً ويلمس أركانا",36,"ن",2,0],["وكم طائف حول القبور مُقبِّل","ويلتمس الأركان منهن بالأيدي",37,"د",2,0],["وَكَم طلبت عَينايَ في الناس ماجِداً","كَريماً فَناداني النَدى لَيسَ ماجِدُ",38,"د",1,0],["وكم طويتُ بساطِ البيدِ منْفَرداً","والأفْقُ يَنْثُرُ في أرجائه الغَسَقا",39,"ق",2,1],["وكم طَردُوا من تحتِ غيلٍ وغابَةٍ","إِلَيْكَ أُسوداً مَا يُمَلُّ لَهَا ذَبْحُ",40,"ح",1,0],["وكم طَلَبْتُ بِهَا الأَيَّامَ مجتهداً","طِلابَ ربِّ نَفيسِ الدَّيْنِ بالدَّيْنِ",41,"ن",1,0],["وكم طَمَسَتْ عَيْنَيْهِ بَرْقَةُ مُقدِمٍ","تَلأْلأَ فِيهَا مَجْدُكَ المُتَقَادِمُ",42,"م",1,0],["وكم طالبٍ مدحي ليمنعَ رِفدَه","فيُهجَى فيُحيي ذكرَه الميْتَ بخلُهُ",43,"ل",2,0],["وكم طمعٍ في غير نصرك طافَ بي","فما زلتُ خوف المنِّ عني أفُلُّهُ",43,"ل",2,0],["وكم طرِبٍ لي وهو يُنشِد نفسَه","إلى الحول يصبو نحوَها ويتوقُها",44,"ق",3,0],["وكمْ طوَّقْتَ من مِنَنٍ رِقاباً","تَؤودُ كِرامَ أعْناقِ الرِّجالِ",45,"ل",1,0],["وكم طرقت سنا نارْ عزمت لها","والسير بالعزمِ فوق السَّير بالإبلِ",46,"ل",1,0],["وكم طرحتنا مقلة الحرب بغتة","فصرنا أحاديثا بألسن سوقتي",47,"ت",2,0],["وكم طردتنا من مناهل قربها","خواطر لم تنبت على ساق هفوتي",47,"ت",2,0],["وكم طرب الهدى ما تغنت","ظباه في الكواهل والهوادي",48,"د",2,0],["وكم طوقتني من يد عاضدية","سرت بين يقظى في العيون وهجع",49,"ع",1,0],["وَكَم طافتْ بدَوحَتنا عيونٌ","فلم تَرَ في جوانبها هَجِينا",50,"ن",2,0],["وكم طلبنا مَراماً عزّ مطلبُهُ","لَمّا اِنثَنينا بيَأسٍ عنه واتانا",51,"ن",2,0],["وَكَم طالِبٍ لِي فُتُّه وَسَبقتُهُ","وَلَم يَنجُ منّي هاربٌ أنَا طالِبُهْ",52,"ب",2,0],["وكم طائرٍ من رأْسِهِ الماءُ طَائِرٌ","على أَنَّهُ في وَكْرِه كالمُكبَّل",53,"ل",1,0],["وكم طارت على الأرجا نساء","يبارين الطيور محلقات",54,"ت",1,0],["وكم طفلةٍ لك قد أعولت","وجمرتها في الحشى قادحه",55,"ح",2,0],["وكم طعمَةٍ مانالها مُتطاوِلٌ","يَمُدُّ يَديه نالَها المُتَقاصِر",56,"ر",1,0],["وكم طم محل ورب الرشاد","خصيب المواسم منه استغل",57,"ل",1,0],["وَكَم طَغَيت وَبَغيت في الخلا","وَأَشتَكي لِلّه ما قَد نَزَلا",58,"ل",2,0],["وَكَم طَبَقٍ رَدَدتُ وَلَيسَ فيهِ","مِنَ البَقلِ المُحَصَّلِ حَبَّتانِ",59,"ن",1,0],["وكم طامع ألقاه في الهون حرصه","فأضحى سليب العز في كفة الذل",60,"ل",1,0],["وَكَمْ طَلَبْتُ اللَّيَالِي أنْ تُغَيِّبَهُ","عَنِ المنَايَا فَلَمْ تَفْعَلْ وَلَمْ تَكِدِ",61,"د",1,0],["وكم طعنت قبل هذا عليه","فيما تقول وما تفعل",62,"ل",1,0],["وَكَمْ طَوَيْنَ مِنْ هَنٍ وَهَنْتِ","تَعَسُّفاً وَهَكَذَا بِالسَمْتِ",63,"ت",1,0],["وكم طوت لابن طيٍّ ذكر مكرمة","له بها الفخر من دون الورى نسبا",64,"ب",2,0],["وَكَم طَلَعَت فيها الشُموسُ وَكَم مَشَت","عَلى الأَرضِ أَقمارٌ بِها وَكَواكِبُ",65,"ب",1,0],["وكم طالبٍ رقي بنعماه لم يَصِل","إليه وإن كَانَ الرَّئيسَ الُمعظَّما",66,"م",2,0],["وكم طامحٍ طامع في عُلاكمْ","تزحزح عنكم مكاناً قصّيا",67,"ي",2,0],["وكم طالب في العُلى شأو ذُهلٍ","وما نال من نعلِه بالشّراكِ",68,"ك",1,0],["وكم طامحٍ نحو السّماء بِنظرةٍ","إليه فردَّ الطَّرفَ وهو حسيرُهُ",69,"ر",2,0],["وكم طفِقتْ بك مصر تطول","عليها وتكثُرها الموصلُ",70,"ل",1,0],["وكم طائف بالبيت من طائف","فمهما تمنى وفاد وساد",71,"د",1,0],["وكم طمحت له أطماع ملك","وطاحت في ثنايها عضينا",72,"ن",2,0],["وكم طغوا لم يقابلهم بما صنعوا","قلب تخلى عن العدوان والأضم",73,"م",1,0],["وكم طغت البلاد وساكنوها","فلم أر في الورى خلا وفيا",74,"ي",2,0],["وَكَم طَلَبُوا اللَحاقَ وَما تَهَدَّت","قَرائِحُهُم إِلى هَذي المَعاني",75,"ن",2,0],["وَكَم طَلَبُوا لَكَ بُؤسَ الحَياةِ","فَما أَنجَحَ اللَهُ ذاكَ الطَلَب",76,"ب",1,0],["وكم طالِبٍ مَسْعاتَهم فتقاصَرَتْ","به قَدَمٌ من دون ذاك وساقُ",77,"ق",1,0],["وكم طَلْحٍ نضيدٍ كهربيٍّ","يجودُ عَقِيبَ طارفِهِ اتِّلادَهْ",78,"د",2,0],["وكم طعام مثل سُمّاقِيَّهْ","ومثل أكشاش وأَرنَبِيَّهْ",79,"ه",1,0],["وكم طبيب ناصح","لي بأمان المرقد",80,"د",1,0],["وكم طرقتني نازلات حوادث","فبتّ بها مستأنساً كنزيل",81,"ل",1,0],["وَكَم طَعنَةٍ أَنفَدتَها في أَديمِهِ","فَجافَت وَلَم يَألَم لَها فيهِ مَوضِعُ",82,"ع",1,0],["وكم طافت عليَّ بصرف راح","تحاكي الشمس في وقت الطلوع",83,"ع",1,0],["وَكَم طَلَبَت ماء الأَحصِّ بِآمِدٍ","وَذَلِكَ ظُلمٌ لِلرَّجاء كَبيرُ",84,"ر",1,0],["وَكَم طالِبٍ أَمراً وَفيهِ حِمامُهُ","وَسارِيَةٍ تَسعى إِلى ما يُضيرُها",85,"ر",3,0],["وكم طواف ببيت الله كان له","وكم وقوف بباب الله في وجل",86,"ل",1,0],["وكم طرقت حماها والهوى عجب","أمشي وقد ثوب الداعي على مهل",87,"ل",1,0],["وكم طعنة عنه أخطيفةٍ","يقيء فمَ الجرح مسبارَها",88,"ر",3,0],["وكم طربتُ لما أبدتهُ من ملح","يصبو لها كلّ ذي عقلٍ وآراء",89,"ا",2,0],["وَكَم طفر النِظام أَقبَح طفرة","وَكانَ لَهُ عِندَ اللقاء هيام",90,"م",1,0],["وكم طفنا بوادي الحب ليلا","كما كنا ومسرحنا الضمير",91,"ر",1,0],["وكم طيباتٍ فِي مديحي تركتُها","بدارٍ لَهَا فِي القلب سُكْنَى ومَرْتع",92,"ع",1,0],["وكم طامح الآمال همَّ فقصّرتْ","خطاه به إن العلا صعبة المرقى",93,"ق",2,1],["وَكَم طابقت معنى الهَوى إن تضمنت","لُزومَ الهَوى نَفسٌ فَزالَت فَزلت",94,"ت",1,0],["وكم طامعٍ في الجاه والجاه عصمة","ولكنه كالمعقل المتأشب",95,"ب",1,0],["وكم طعنة في مهجتي من قوامهم","كمسك له فوق الشفاه ختام",96,"م",1,0],["وكم طاعنٍ في ديننا ومثلب","رميناه إذ هاجا بقاصمة الظهر",97,"ر",1,0],["وكم طلع النهار فعز قومٌ","وذلوا عندما هبط الظلام",98,"م",1,0],["وكم طاف بي في لجّة الليل طيفكم","ودر نجوم الافق طافٍ وراكس",99,"س",1,0],["وكم طسم الدهر من جبلتي","فرد نضارة ما قد طسم",100,"م",1,0],["وَكَم طافَ الغُرور بِراح عَجب","عَلى وَلم اِفق من فرق خبلى",101,"ل",2,0],["وكم طربنا ولا كيوم لنا","تمّ الهنا بالحسين والطرب",102,"ب",1,0],["وكم طابت مزاجا حيث كنتم","لها الأسى من الداء العضال",103,"ل",1,0],["وكم طلبت إمام العصر أفركها","وأطلب الرتبة العليا لأدركها",104,"ه",2,0],["وَكَم طَوَى البَيداءَ في تَلَطُّفٍ","فلَم يُثِر سِربَ القَطا لَمَّا قَطَا",105,"ا",1,0],["وكم طفل تشكاه لطفل","لوجه اللَه وجهاً لا يولي",106,"ي",1,0],["وكم طامع في الملك منهم سفاهة","كتائبه أقلامه والقراطيس",107,"س",1,0],["وكم طلبوا فاغنتهم","بما جادت وما منت",108,"ت",1,0],["وكم طلعت جند الخطوب فردها","وسلَّ من الرأي الصقيل مهندا",109,"د",2,0],["وكم طفلٍ يُوارَى كلَّ يومٍٍ","ومِن قَبْلُ المشايخُ والكهولُ",110,"ل",1,0],["وكم طلبنا من ذوي الشأن الذي","ن يعلمونَ شأن كل دار",111,"ر",1,0],["وَكَمْ طِفْلَةٍ قَدْ أَنْحَلَ الْخَوْفُ جِسْمَهَاْ","وَلَيْسَ لِمَنْ أَمْسَىْ هُنَاْلِكَ حَاْمِيَاْ",112,"ي",2,0],["وكم طويت مني الضلوع على جوى","وحزنا على مولى همام معظم",113,"م",1,0],["وكم طفل باسك بحلمه وأستدار وحبا","وكم شايب أمسا شباب وجاك يصهل صهيل",114,"ل",1,0],["وكم طال من قبل الفراق وصالُنا","حُسدنا فطالت بافتراقٍ سنيننا",115,"ن",2,0],["وكم طوى العمر تحت اللج من صدف","حتى استقل بدرٍ فيه مختزن",116,"ن",1,0],["وكم طلبوا أن يفرعوا قلّة العلى","ودون المعالي أجبل ووعور",117,"ر",1,0],["وكم طمى بي ذهولي دون رؤيتها","فاندك طوديَ بين الغمِّ والغمم",118,"م",1,0],["وكم طبّع بحركم من سفنّا","ونسبح في لجاجه مخطرينا",119,"ن",2,0],["وكم طائفٍ حول القبور مقبلٍ","ومستلم الأركان منهن باليد",120,"د",1,0],["وكم طاردتُ أشباحاً وفي نفسي","تطاردني شياطينُ من اللهبِ",121,"ب",1,0],["وكم طرقت قباب الحيّ مرتدياً","بصارمٍ مثلِ عزمي هُنْدواني",122,"ي",1,0],["وكمْ طاغٍ أرادَ بها مُراداً","بِثَوْبِ الذُلّ يَرْفُلُ ثُمّ يَعْدو",123,"د",2,0],["وكم طرقتني من يدٍ عاضديةٍ","سرت بين يقظي من عيون وهجع",124,"ع",1,0],["وَكَمْ طَائِفٍ بالقَلْبِ مَا نالَ حَجَّةً","وَأَنْتَ بِلا طَوْفٍ تَحُجُّ وتَعْمُرُ",125,"ر",1,1],["وكم طالبٍ مدحي ليمنعَ رفده","فيهجي فيحي ذكره الميتَ بخلُهُ",126,"ل",2,0],["وكم طال إبحاري وكم تاه مرفئي","وكم غرني برق وكم غالني رعد",127,"د",1,0]]}