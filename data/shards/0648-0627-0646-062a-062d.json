نت حسبي أولاً وآخرا","وأنت حسبي باطناً وظاهرا",123,"ر",2,0],["وأن تُحِبّني حُبَّ من يتوبْ","وأن تملّكني جسماً والقلوبْ",124,"ب",1,0],["وان تحميله فآمالنا","حملت وحقك أَن تفخري",125,"ر",2,0],["وان تحرسيها فقد بددوا","لعمرك من ريحها الأصفر",125,"ر",1,0],["وأنت حياة النفس بل غاية المنى","ونفسك من نفسي وقلبك من قلبي",126,"ب",2,0],["وَأَنتَ حَقّاً سَيِّدي","وَسُؤدُدي وَمَولَلي",127,"ل",2,0],["وَإِن تَحَقَّقَ أَنَّهُ مَنِيُّ","وَجوبُ غَسلِ الذَكَرِ جَلِيُّ",128,"ي",1,0],["وأنت حمامة الوادي أبيني","اشدواً كان صوتك أم نعيا",129,"ي",2,0],["وأنت حقيقة هذا المثال","وبيتك زمزم ثم المقام",130,"م",1,0],["وأنت حديثي بين قومي وجيرتي","واياك أعني عند ذكر سعاد",131,"د",1,0],["وإن تحمل أعباء الكفاح أخو","عزمٍ فشَّمر للهيَجاء واقتربا",132,"ب",2,0],["وَاِنتَحى روضَة الحَبيب لِيَحظى","بِلِقاء الحَبيب غايَ الأَماني",133,"ن",2,0],["وأنت حيدرة الغاب الذي أسد الب","رج السماوي عنه خاسئا رجعا",134,"ع",2,0],["وأنت حري بالمديح الذي غدا","تسير به الركبان برا كذا بحرا",135,"ر",2,0],["وَأَن تَحتَلَّها غَبراءَ ضَنكاً","كَما يُستَودَعُ السَيفُ القِرابا",136,"ب",2,0],["وأنتَ حفظته وغنيتَ عنه","فليس عليك فيما قلتَ عارُ",137,"ر",1,0],["وأنت حصون المشركين ففاتح","وأنت رقاب العالمين فمالك",138,"ك",1,0],["وانتحرى صدق / حنا نجهله","في الحقيقة / للعذل حنا / نجوع",139,"ع",1,0],["وأنت حصنٌ لمن لا حصنَ يحفظه","ما زال يغشاه من كيد الورى وجلُ",140,"ل",1,0],["وإنْ تحسبوا الطيفَ جِنّاً ويحضرْ","وإنْ تحسبوني بعقلٍ ... تبخَّرْ",141,"ر",1,1],["وأنت حديقةُ عشقي التي","شتاءُ خيالي بها يُزهرُ",142,"ر",1,0],["وَإنْ تَحْمِلْكَ نَفْسُكَ أنْ تَراني","فَليسَ عَليكَ إلاّ الإِعْتِذارُ",143,"ر",1,0],["وإن تحتك شيخاً طول لحيته","يخفي عن الناس ما تجنيه كفاه",144,"ا",2,0],["وأنت حين تغطي الشيب تفضحه","فكيف تحسب ما بينت لم يبن",145,"ن",1,0],["وأنت حسيبي يا حبيب وجنتي","وسيفي فيما نابني حسبي الله",146,"ه",1,0],["وأنت حليفي على المعتدي","إذا خان ميثاقه جاري8ه",147,"ر",3,0],["وانتحرنا يا حبيبي","بالرموش المشرعة ؟",148,"ع",2,0],["وأنتَ حضينُ الكُلّ لَوْ أَنْ تَعزّزَتْ","عَلَى قَلبِهِ الأشجانُ يَشكُو التّحَطُّمَا",149,"م",2,0],["وأنت حشا