,"البسيط"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136391",""],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35077","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139777",""],[2052,"على هذه الدنيا بملكك رونق","https://www.poetsgate.com/ViewPoem.aspx?id=189617",""],[4764,"تعشقين اثنين","https://www.poetsgate.com/ViewPoem.aspx?id=27727",""],[4767,"ساعة الصفر","https://www.poetsgate.com/ViewPoem.aspx?id=179844",""],[4852,"صباحك سكر","https://www.poetsgate.com/ViewPoem.aspx?id=214435",""],[4929,"سحر الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=199428",""],[4958,"الشيءْ ..","https://www.poetsgate.com/ViewPoem.aspx?id=53952",""],[585,"قل للنجوم البسي الظلماء حالكةً","https://www.poetsgate.com/ViewPoem.aspx?id=161970",""],[585,"يا شيب إن أوان الشيب لم يحن","https://www.poetsgate.com/ViewPoem.aspx?id=161874",""],[5136,"بمن يستغيث العبد إلا بمولاه","https://www.poetsgate.com/ViewPoem.aspx?id=121766",""],[5183,"جَارِيَهْ (الملغزة الإثنا عشرية)","https://www.poetsgate.com/ViewPoem.aspx?id=186409",""],[5185,"الأقنعة","https://www.poetsgate.com/ViewPoem.aspx?id=73329",""],[5266,"جَوَى الْوَطَنْ","https://www.poetsgate.com/ViewPoem.aspx?id=210298",""],[5277,"رسائلُ عشقٍ بغدادية..5","https://www.poetsgate.com/ViewPoem.aspx?id=191524",""],[5277,"مكسورها الأخضر","https://www.poetsgate.com/ViewPoem.aspx?id=192000",""],[308,"لحماي نَار جاءها مِنْك جنَّة","https://www.poetsgate.com/ViewPoem.aspx?id=189403",""],[470,"والآن ها قد قطعنا الشوط يا وطني","https://www.poetsgate.com/ViewPoem.aspx?id=178097",""],[5582,"نَفْسُ المُتَيَّمِ دِينُ الحُبِّ مَذْهَبُها","https://www.poetsgate.com/ViewPoem.aspx?id=186667",""],[2598,"لِسَانُكَ مِنْ شكْرٍ ثَقِيلٌ عَنِ التُّقَى","https://www.poetsgate.com/ViewPoem.aspx?id=20732",""],[5742,"بيت السبحية","https://www.poetsgate.com/ViewPoem.aspx?id=206895",""],[5751,"من منكنّ أحلى","https://www.poetsgate.com/ViewPoem.aspx?id=215030",""],[5874,"مَوْقفُ الشِّعْرِ","https://www.poetsgate.com/ViewPoem.aspx?id=212191",""],[5939,"أنا جدّا عليكِ أغار","https://www.poetsgate.com/ViewPoem.aspx?id=178598",""],[5956,"مناجاتي لابنتي هنادي","https://www.poetsgate.com/ViewPoem.aspx?id=192383",""],[5957,"حبي الكبير","https://www.poetsgate.com/ViewPoem.aspx?id=12485",""],[6093,"اللومُ عنديَ أنْ تفنى على طللِ (البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176200",""],[5377,"حراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79568&r=&rc=24",""],[6257,"صعلكة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87176&r=&rc=1",""]],"verses":[["وأنت حبيس الدار بالحلق غصة","تبوح بها طورا وطوراً تخالد",0,"د",1,0],["وَأَنتَ حَمَيتَنا مِن كُلِّ ضَيمٍ","وَقَد ضَرِيَت عَلى الطَمَعِ الخُصومُ",1,"م",1,0],["وَإِن تَحَوَّنَ جِسمي ما عَلِمتُ بِهِ","فَالرُمحُ يَنآدُ طَوراً ثُمَّ يَعتَدِلُ",2,"ل",1,0],["وأنتَ حُسامُ اللهِ والله ناصِرٌ","وأنتَ أمينُ اللهِ واللهُ رَزّاقُ",3,"ق",1,0],["وأنْتَ حُسامُ المُلْكِ ناصِرُهُ الذي","تَذودُ العِدَى عنْ جانِبَيْهِ وتَمْنَعُ",4,"ع",1,0],["وَأَنْتَ حُسَامِي كُلَّمَا جَلَّ حَادِثٌ","أَذُودُ بِهِ عَنْ حَوْزَتِي وَأَصُولُ",5,"ل",1,0],["وأن تحمدوا منهُ الأيادي فإنني","أنا اليوم من بعد الأيادي قسَه",6,"س",2,0],["وَإِن تَحلِقوا مِنّا رُؤوساً فَإِنَّنا","حَلَقنا رُؤوساً بِالقَنا وَالغَلاصِمِ",7,"م",1,0],["وَأَنتَ حِجابُ القَلبِ عَن سِرِّ غَيبِهِ","وَلَولاكَ لَم يَطبَع عَلَيهِ خِتامَهُ",8,"ه",1,0],["وانتحرت في فنائه بُهَمُ ال","حرب وصِيد الملوك من مُضرِ",9,"ر",1,0],["وَإِن تَحمِلوا عَنهُم فَما مِن حَمالَةٍ","وَإِن ثَقُلَت إِلّا دَمُ القَومِ أَثقَلُ",10,"ل",1,0],["وَإِن تَحجُلوا بَينَنا بِالخِداعِ","فَلَن تَخدَعوا رَجُلاً مُؤمِنا",11,"ن",2,0],["وإن تحير بي قوم فلا عجب","إن الحقيقة سبل نحوها الرّيب",12,"ب",1,0],["وَإِن تَحَكَّمَ فيها الجَهلُ أَسلَمَها","لِفاتِكٍ مِن عَوادي الذُلِّ قَتّالِ",13,"ل",1,0],["وَأَنتَ حَياتُهُم غَضِبَت عَلَيهِم","وَهَجرُ حَياتِهِم لَهُمُ عِقابُ",14,"ب",1,0],["وَاِنتَحى القَتلُ فيكُمُ فَبَكَينا","بِدِماءِ الدُموعِ تِلكَ الدِماءَ",15,"ا",2,0],["وَأَنتَ حَريصٌ أَن يَكونَ مُجاشِعٌ","أَباكَ وَلَكِنَّ اِبنَهُ عَنكَ شاغِلُه",16,"ل",2,0],["وأنت حرارة الشمس","وأنت هناءة الظلِّ",17,"ل",1,0],["وانتحينا معا مكاناً قصياً","نتهادى الحديث أخذاً وردا",18,"د",2,1],["وَأَن تَحفَظي بِالغَيبِ سِرّي وَتَمنَحي","جَليسَكِ طَرفاً في المَلامِ كَليلا",19,"ل",2,0],["وَاِنتَحَينا مِن طَرفِهِ وَيَدَيهِ","وَلَماهُ وَوَجنَتَيهِ مُدامَه",20,"م",2,0],["وانتحينا من جانب البحر مجرىً","مطمئنَّ الأمواه شاجي الخريرِ",21,"ر",1,0],["وَانْتَحَى يُرْهِقُهُمْ خَتْراً فَمَا","عَاقِلٌ فِي مَعقِلٍ يَأْمَنُ خَترَا",22,"ر",2,0],["وَانْتَحَيْتُ الشَّمَالَ فَالْهَيْكَلَ الْ","حَيَّ بِهِ مِنْ غِرَاسِ عَهْدٍ عَهِيد",23,"د",1,0],["وانتحوا من قبره ناحيةً","واحذروا أن تزحموا الروح الأمين",24,"ن",1,0],["وانتحار المضيم أخصر للضيّم","وأجدى من أن يطول خضوعه",25,"ع",2,0],["وأنت حنين ينادي حنينا","وألف سؤال يلبّي ألوف",26,"ف",1,0],["وانتحت فيه مكانا موحشا","هو مع وحشته ذروة رمس",27,"س",1,0],["وأَنْ تَحْفَظي بِکلْغَيْبِ سِرّي وَتَمْنَحي","جليسكِ طرفاً، في الملامِ، كليلا",28,"ل",2,0],["وانت حامي الحمى في كل نازلة","بها السيوف انذهالا ليس تنجذب",29,"ب",1,0],["وأنت حياتي والنعيم وجنّتي","مليكة قلبي لا سعاد ولا أمل",30,"ل",1,0],["وانتَحَى سَاحَةَ الأُوَيجِنِ يُهدَى","أسَدِيّاً مِن نَوئِهِ مَركُومَا",31,"م",2,0],["وِإن تَحفَظِى العَهدَ الذِي كَانَ بَينَنَا","وقَد يَحفَظُ المَومُوقُ عَهداً لِوَامِقِ",32,"ق",1,0],["وإنْ تَحلّبَ دَرّ النّقسِ في يده","فالطِّرسُ دُرْجٌ لدُرِّ منهُ مُنسلكِ",33,"ك",1,0],["وأنت حتف للعدا وقتل","وفي عيون حاسديك سبل",34,"ل",1,0],["وَإِن تَحتَج إِلى عِلمي","فَطِبّي لَكَ مَبذولُ",35,"ل",1,0],["وإن تحجَّبتِ عنّي","لا عطرَ بعدَ عروس",36,"س",1,0],["وَأَنتَ حيابه تحيا البَرايا","وَتَنتَعِش الارامل وَاليَتيم",37,"م",1,0],["وَإِن تَحَكَّمتَ تيهاً","فَأَنتَ أَهلٌ لِذاكا",38,"ك",2,0],["وَأَنتَ حِرزُ بَني مَروانَ كُلُّهُمُ","أَنتَ لَهُم وَلِمَن يَعروهُمُ جَبَلُ",39,"ل",1,0],["وأنت حبك فوق","الردى وفوق الزمان",40,"ن",1,0],["وأن تُحرَمي صوب الربيع وتَدلفي","بزِقِّ لندماني كُلّ صباحِ",41,"ح",1,0],["وإنْ تَحلَّى بِنا الصَّدْ","رُحَلْيَ ذاتِ الحِجَالِ",42,"ل",1,0],["وَاِنتَحَلوا السَنَةَ دَعوى عَلى","رَفضِهِم حُكمَ الكِتابِ المُبين",43,"ن",1,0],["وأنْ تَحُلَّ عِقالَ الدّهرِ عن أَمَلي","فيَدْنو النّازحانِ الأهلُ والوَطَن",44,"ن",1,0],["وأنت حلَلْتَ عُقْدةَ شاهِديزٍ","وأنتَ عَقْدْتَ سِكْرَ المَسْرُتان",45,"ن",1,0],["وإن تحمَّلته وجَدتُ له","بينَ ضلوعي أذكي من النارِ",46,"ر",1,0],["وإن تَحُلَّ ميِّتاً قد انفصلْ","تَخْطأْ خَطاءً مفرِطاً كمن قتلْ",47,"ل",1,0],["وإِنْ تحدَّثتُ على بابِكمْ","كَأَنَّنِي لستُ على البابِ",48,"ب",1,0],["وإن تَحْبُنيها عَنْ تَناهِيكَ فِي النُّهى","فقِدْماً حَبانِيها أبوكَ مِنَ المَهْدِ",49,"د",1,0],["وإِنْ تُحْيِ يَا يَحْيَى حُشاشَةَ نفسِها","فَنُغْبَةُ حَسْوِ الموتِ موشِكَةُ الجَزْعِ",50,"ع",1,0],["وأنت حسبي ومولاي ومعتمدي","بعد الإله بكم لا زلت متشقا",51,"ق",2,0],["وإن تحمل الأحزانَ دونك أضلُعي","فَوَالله لا جِلدي يخورُ ولا عظمي",52,"م",2,0],["وأن تحِنَّ نعمةٌ قد فارقتْ","أوطانَها حتى تعودَ أنعُما",53,"م",2,0],["وانتحال المدح يسرِي راكباً","كلَّ فتلاء ضمورٍ في الرحَالَهْ",54,"ل",2,0],["وانتحت الأشواقُ قلبي فما","يفوتني القاصدُ والعائرُ",55,"ر",1,0],["وانتحاني صرفُ الزمان فلماً","جاءني مقبلاً نداك تولَّى",56,"ل",2,0],["وانتحبي سودُ الحوادث فانتاش","ببيض الأفعال منهنَّ ضبعي",57,"ع",2,0],["وأنتَ حَبيبُ المُصْطَفى وابنُ بنتِهِ","فما خابَ من تُشكى لعَلْياكَ حَالُهُ",58,"ل",2,0],["وأنت حرام حرمة الحج والهوى","على العين ألا هفوة اللحظات",59,"ت",1,0],["وأَنْتَ حَيْثُ ظَنِّي","في نَفْعِ مَنْ هُوَ مِنِّي",60,"ي",1,0],["وأنت حياةُ النفسِ إن كنتَ حاضِرا","تُرَى كغُصونٍ نَشوَة تَتَأوَّدُ",61,"د",1,0],["وَأنتَ حَريصٌ أَن يقاَل مؤمِّلٌ","وَإنّي عَلى كسبِ العُلا غيرُ حارِصِ",62,"ص",1,0],["وَأَنتَ حَميتَ المُلكَ مِن كلِّ طالِعٍ","عَليهِ كَما تُحمى العرينةُ بالأسدِ",63,"د",1,0],["وإِن تحلَّتْ فَوسْواسُ الحُلِيِّ لها","خِصَامُ ما بين ذاك الخَصْرِ والكَفل",64,"ل",1,0],["وانتحى قلبه فرن صداه","في حشى الدين صرة الآذان",65,"ن",1,0],["وَإن تَحيَّرَ قارٍ في كِتابَتِهِ","فالبيضُ تَشكُلُهُ والسُّمرُ تُعجِمُهُ",66,"م",2,0],["وَاِنتَحى نَحوَ مَصره بَعد عام","بِوَقار وَسُؤدد أَلِفاه",67,"ا",2,0],["وَأَنتَ حَياة العالمين بقطرها","وَإِنسان عَين المُلك بَين حصونها",68,"ن",3,0],["وَانتحت مِن خَير دارِ","نَحو أَقطار بَعيدهْ",69,"ه",1,0],["وأنت حبيب الشعب تحيي حياته","وعندك ما يرجو وترجوه عنده",70,"د",2,0],["وَانْتَحَى آكِلاً لِلَحْمِي وَرَضَّ الْ","عَظْمِ مِنِّي بِكَلْكَلٍ رَضَّاضِ",71,"ض",1,0],["وإن تحاربْ تصرْ كالغنز أهملها الرْ","راعي وقد حصلت بين الضراغيم",72,"م",1,0],["وأنت حمامة الوادي أبيني","أنوحك كان شدواً أم نعيّا",73,"ي",2,0],["وأن تحسم الاحسان والحمد والحيا","وأن تمنح الأحباب مع حلمك الحقدا",74,"د",2,0],["وَأنْتَ حَقًّا فِي السُّوَيْدَا فَلِمْ","قُلْتَ اكْفُفُواَ ما في السُّوَيْدَا رِجَالْ",75,"ل",1,0],["وأنتحي لمديحي فسل فاطمة","وأنتفي عن غبي للوصي نفا",76,"ف",2,0],["وَإِن تَحضُر بِجيلَةُ يَومَ بَأسٍ","تُكَشِّف عَن مَنَاكِبَى الزِّحَامَا",77,"م",2,0],["وأنت حلمي ان تكوني غداً","بعد انقضاء العمر ذاك الرجاء",78,"ا",2,0],["وأن تحتمي بالبيضِ والسُمرِ فالهوى","يهونُ عندَ العاشقِ الضربَ والطعنا",79,"ن",2,0],["وَإِن تَحَدَّى قَرمَ قَومٍ مُقرَمُه","سَامى بِهَدَّارٍ جُرازٍ شَيظَمُه",80,"م",2,0],["وإن تحجبوا من فضله كلّ باهر","فليس ضياء الشمس يحجب باهره",81,"ر",2,0],["وأنت حبيب يا مصفى وانني","على كل شيء في رضاك قدير",82,"ر",1,0],["وأنت حري بتمحيصِ من","يعادل بين المُسي والبري",83,"ر",2,0],["وإن تحجبي بالبيض والسمر فالهوى","يهون عند العاشق الضرب والطعنا",84,"ن",2,0],["وإن تحلقوا منا الرؤوس فانَّنا","قطعنا رؤوساً منكم بالغلاصِمِ",85,"م",1,0],["وَاِنتَحَوا بِالفَرشِ تتبعُهُم","مُنَّةٌ مِن نَفسِكَ السَقِمَة",86,"م",2,0],["وأنتَ حيث باسمه شاركته","لا تفتخرْ يا أيها المهنَّد",87,"د",1,0],["وانتحبَ الكاتبان إذ قد","فاتهما وردُها الصحيحُ",88,"ح",1,0],["وانتحب فيه من ضلوعي غصوناً","مائلاتٍ تسلو بها الاشجارا",89,"ر",2,0],["وإن تحاسَبنَا فقولي لنا","مَن أنتِ يا بدليس من أنتِ",90,"ت",1,0],["وأنت حبيب اللَه أكرم خلقه","وطابت بك الأيام في الدهر والعصر",91,"ر",1,0],["وانتحلوا جماعةً باسمها","وفارقوها فهُم اليعرُ",92,"ر",1,0],["وانتحب في صلاصل الرعد تحكي","ضجتي في سلاسلي وقيودي",93,"د",2,0],["وانتحوا أرض الأعادي بالقنا","والظبي تشتاق هام الدارعين",94,"ن",1,0],["وانتحت مروان في غافي الثرى","وابن هند رجل الدهر الركين",95,"ن",1,0],["وَانتَحى النُّورُ ساطِعاً","عَمَّ لِلأُفقِ وَالبَلاَد",96,"د",1,0],["وانتحى عند ملعب ا