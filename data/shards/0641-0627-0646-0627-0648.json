{"poems":[[9,"لميثاء دار قد تعفت طلولها","https://www.aldiwan.net/poem21963.html","الطويل"],[29,"أنا ابن أبي سعد وعمرو ومالك","https://www.aldiwan.net/poem5727.html","الطويل"],[29,"بان الخليط غداة الجناب","https://www.aldiwan.net/poem5783.html","المتقارب"],[49,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[23,"أولئك قومي فإن تسألي","https://www.aldiwan.net/poem21241.html","المتقارب"],[23,"لست إلى عمر ولا المرء منذر","https://www.aldiwan.net/poem21369.html","الطويل"],[74,"لي في ندى ومحاسن","https://www.aldiwan.net/poem18269.html","مجزوء الكامل"],[40,"ألم يسأل الركب الديار العوافيا","https://www.aldiwan.net/poem7821.html","الطويل"],[47,"أما وهواك حلفة ذي اجتهاد","https://www.aldiwan.net/poem63502.html","الوافر"],[30,"لعمري لقد أوفى وزاد وفاؤه","https://www.aldiwan.net/poem1239.html",""],[30,"أهاج لك الشوق القديم خياله","https://www.aldiwan.net/poem5604.html","الطويل"],[76,"أما لديك حلاوه","https://www.aldiwan.net/poem13273.html","المجتث"],[107,"أخا الدهر ما الدهر إذ ينسب","https://www.aldiwan.net/poem43389.html","الكامل"],[15,"لمن دمنة أقوت بحرة ضرغد","https://www.aldiwan.net/poem45272.html","الطويل"],[30,"لعمري لقد أوفى وزاد وفاؤه","https://www.poetsgate.com/ViewPoem.aspx?id=21369",""],[119,"ترفع عن دني الطبع دهرا","https://www.aldiwan.net/poem40638.html","عموديه"],[128,"قالوا أناب وما أناب","https://www.aldiwan.net/poem23721.html","مجزوء الكامل"],[136,"أشاقتك ورق اللوى هتفا","https://www.aldiwan.net/poem54796.html","المتقارب"],[138,"تطاول ليلي بهم وصب","https://www.aldiwan.net/poem20978.html","المتقارب"],[201,"حب تغلغل في الصميم","https://www.aldiwan.net/poem39893.html","مجزوء الكامل"],[214,"حديث غرامي فيك أضحى مقيدا","https://www.aldiwan.net/poem13468.html","الطويل"],[369,"اليوم يومي ويوم الأينق الذلل","https://www.aldiwan.net/poem60675.html","البسيط"],[422,"متى يشتفي كبد مؤلم","https://www.aldiwan.net/poem53957.html","المتقارب"],[449,"حسب المحب على الغرام دليلا","https://www.aldiwan.net/poem56060.html","عموديه"],[463,"يذنب دهر ويستقيل","https://www.aldiwan.net/poem55932.html","مخلع البسيط"],[519,"إلى الله نشكو فادحات النوائب","https://www.aldiwan.net/poem20840.html","الطويل"],[534,"هذا العقيق فقف على أبوابه","https://www.aldiwan.net/poem37529.html","الكامل"],[541,"تعدون قتلاً في الحرام عظيمة","https://www.aldiwan.net/poem23871.html","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38875","الطويل"],[855,"","https://poetry.dctabudhabi.ae/diwan/poem/138856",""],[1017,"","https://poetry.dctabudhabi.ae/diwan/poem/45203","الطويل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61072","المديد"],[1117,"","https://poetry.dctabudhabi.ae/diwan/poem/142496","المتقارب"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101979","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56096","الكامل"],[1477,"","https://poetry.dctabudhabi.ae/diwan/poem/134232","الطويل"],[1668,"","https://poetry.dctabudhabi.ae/diwan/poem/31377","الوافر"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124734","الوافر"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69329","المتقارب"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71059","الكامل"],[2096,"","https://poetry.dctabudhabi.ae/diwan/poem/144614","الطويل"],[2124,"","https://poetry.dctabudhabi.ae/diwan/poem/45459","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27274","الرمل"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111251","البسيط"],[3493,"","https://poetry.dctabudhabi.ae/diwan/poem/100575","الطويل"],[3570,"","https://poetry.dctabudhabi.ae/diwan/poem/35907","المنسرح"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138711",""],[3637,"","https://poetry.dctabudhabi.ae/diwan/poem/106772","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91356","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91296","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54419","المنسرح"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94582","الكامل"],[4379,"","https://poetry.dctabudhabi.ae/diwan/poem/62083","الكامل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66158","الرمل"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147260","الكامل"],[4531,"","https://poetry.dctabudhabi.ae/diwan/poem/147256","الكامل"],[4767,"مرايا الحب","https://www.poetsgate.com/ViewPoem.aspx?id=215048",""],[4796,"الى دعد في عامنا الثالث عشر","https://www.poetsgate.com/ViewPoem.aspx?id=34721",""],[4852,"بمحمد حرف المديح سيعبق","https://www.poetsgate.com/ViewPoem.aspx?id=214333",""],[4859,"ملام العذل","https://www.poetsgate.com/ViewPoem.aspx?id=186848",""],[4927,"أنا والوردُ والعصفورُ والحبُّ","https://www.poetsgate.com/ViewPoem.aspx?id=29617",""],[4929,"صدى الواقع","https://www.poetsgate.com/ViewPoem.aspx?id=199284",""],[4940,"وطني القصائد","https://www.poetsgate.com/ViewPoem.aspx?id=214010",""],[4973,"راحل","https://www.poetsgate.com/ViewPoem.aspx?id=188875",""],[4984,"ودع رفاقك","https://www.poetsgate.com/ViewPoem.aspx?id=175794",""],[5212,"رزءُ العليل","https://www.poetsgate.com/ViewPoem.aspx?id=212052",""],[5277,"لا شيء في كفّي","https://www.poetsgate.com/ViewPoem.aspx?id=187908",""],[307,"مرآة الوجود","https://www.poetsgate.com/ViewPoem.aspx?id=215293",""],[5345,"عودي","https://www.poetsgate.com/ViewPoem.aspx?id=2464",""],[5353,"ارح صوتك الدامي","https://www.poetsgate.com/ViewPoem.aspx?id=212647",""],[5358,"طرقتُ بابَك","https://www.poetsgate.com/ViewPoem.aspx?id=183427",""],[5408,"أوجاع يوسفية","https://www.poetsgate.com/ViewPoem.aspx?id=190737",""],[5550,"وردةٌ أنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=213309",""],[5561,"خذني إليك ...","https://www.poetsgate.com/ViewPoem.aspx?id=206453",""],[5582,"أَتَرْدَعُنِي بِاللَّوْمِ وَالدَّهْرُ أَرْدَعُ","https://www.poetsgate.com/ViewPoem.aspx?id=63534",""],[5660,"ألا فَابْكِ يا عَيْنايَّ ما سَحَّ دَمْعُكِ","https://www.poetsgate.com/ViewPoem.aspx?id=23707",""],[5688,"وطني","https://www.poetsgate.com/ViewPoem.aspx?id=200833",""],[5691,"شرفة الأيام...","https://www.poetsgate.com/ViewPoem.aspx?id=206875",""],[5725,"لاتنر لي ايها البدر طريقا","https://www.poetsgate.com/ViewPoem.aspx?id=179413",""],[4623,"أعلى الزمان أخذت عهد أمان (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146772",""],[5771,"شُكرًا","https://www.poetsgate.com/ViewPoem.aspx?id=189157",""],[5897,"حلم","https://www.poetsgate.com/ViewPoem.aspx?id=156535",""],[5943,"كلا وربِّكَ","https://www.poetsgate.com/ViewPoem.aspx?id=34410",""],[6031,"أَلاَ هَلْ تجاوَزْتَ الخِباءَ المحجَّبَا","https://www.poetsgate.com/ViewPoem.aspx?id=46274",""],[303,"رئيس المجلس البلدي (غلبْ)","https://www.poetsgate.com/ViewPoem.aspx?id=148789",""],[6178,"قبلة ماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85528&r=&rc=4",""],[6275,"مهرجان من حنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83609&r=&rc=1",""],[6315,"قَبائلُ النِّسْرِين !! هامشٌ على قرطاسِ المُتَنَبّي ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87575&r=&rc=0",""],[6339,"أبواب الحنين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87890&r=&rc=2",""]],"verses":[["فَإِنّا وَجَدنا النيبَ إِن تَفصِدونَها","يُعيشُ بَنينا سيئُها وَجَميلُها",0,"ل",3,0],["فَإِنّا وَجَدنا إِذ وَفَدنا إِلَيكُمُ","صُدورَ القَنا وَالخَيلَ مِن خَيرِ وافِدِ",1,"د",1,0],["فَإِنّا وَجَدنا اِبنَ جَوخى القُيونِ","لَئيمَ المُواطِنِ خَوّارَها",2,"ر",3,0],["فَإِنّا وَإِيّاكُم ذُراها وَهامُها","إِذِ الناسُ أَعناقٌ لَها وَكَراكِرُ",3,"ر",1,0],["فَإِنّا وَأَولادَنا جُنَّةٌ","نَقيكَ وَفي مالِنا فَاِحتَكَم",4,"م",1,0],["فَإِنّا وَمَن يُهدي القَصائِدَ نَحوَنا","كَمُستَبضِعٍ تَمراً إِلى أَهلِ خَيبَرا",5,"ر",2,0],["فأنا وراحة مالِكي","كالبحرِ يمطره السَّحاب",6,"ب",1,0],["فَإِنّا وَبِشراً كَالنُجومِ رَأَيتُها","يَمانِيَةً يَتبَعنَ بَدراً شَآمِيا",7,"ي",2,0],["فَإِن أوطِن فَقَد وَطَدتُ رُكني","وَإِن أَرحَل فَقَد وَفَّرتُ زادي",8,"د",2,0],["فَإِنّا وَجَدنا الغَدرَ أَعظَمَ سُبَّةً","وَأَفضَحَ مِن قَتلِ اِمرِئٍ غَيرِ مُذنِبِ",9,"ب",1,0],["فَإِنّا وَإِيّاهُم كَعَبدٍ وَرَبِّهِ","إِذا فَرَّ مِنهُ رَدَّهُ بِرُغومِ",10,"م",1,0],["فَإِنَّ أَوحَشَ شَيءٍ","جَساوَةٌ في غَباوَه",11,"ا",3,0],["فَإِن أورِثِ الخِصبَ هذي العقولَ","فممّا تعلِّمني تخصبُ",12,"ب",1,0],["فَإِنّا وَمَن قَد بادَ مِنّا فَكَالَّذي","يَروحُ وَكَالقاضي البَتاتِ لِيَغتَدي",13,"د",2,0],["فإنّا وَجَدْنا الغَدْرَ أعْظَمَ سُبّةً،","وَأفضَحَ من قَتلِ امرِىءٍ غيرِ مُذْنِبِ",14,"ب",1,0],["فان اولي السفاسف والدنايا","اخس لدى الرجال من النعال",15,"ل",1,0],["فأنا وأنت حياتنا","عرصاتها قفر يباب",16,"ب",1,0],["فَإِنَّ أُولِى العِلمِ في سَبِّهِم","مِنَ القُرُبِ لِلَّهِ مَا يُصطفي",17,"ف",2,0],["فَإِنّا وَمَن حَجَّ مِن راكِبٍ","وَكَعبَة مَكَّةَ ذاتِ الحُجُب",18,"ب",1,0],["فأنا وأنت بموطن","فيه الموارد من حميم",19,"م",1,0],["فان اوغلوا في السير خوفا وابعدوا","فبالعزم قد ادركت افضى وابعدا",20,"د",2,0],["فإنَّ أوجُهَنا منه إلى ملِكٍ","فِناؤه الدَّهرَ يُمشَى فيه بالقُلَل",21,"ل",1,0],["فإنَّا وَقَفْنا عليها ضحًى","وكلٌّ من الرّكب مستغرم",22,"م",1,0],["فأنا ومن فلق النوى صب نوى","أن لا يرى عن عشقها تحويلا",23,"ل",2,0],["فإنّ أولى من رابَ قولي","مَن فعلُهُ ضدُّ ما أقولُ",24,"ل",1,0],["فإنّا وإنْ ساءَتْ إلَيْنا صُروفُها","فقد حسّنَتْ أخلاقُنا بالتّجارِبِ",25,"ب",1,0],["فأَنا وَلا فَخْرُ الخَبِيرُ بِأَرْضِهِ","وأَنا العَرُوفُ بِشَامِخَاتِ عُقَابِهِ",26,"ب",2,0],["فَإِنّا وَإِن عَيَّرتُمونا بِقَتلِهِ","وَأَرجَفَ بِالإِسلامِ باغٍ وَحاسِدُ",27,"د",1,0],["فَإِن أوعَدت بِالرّميِ مِن نَبلِ جَفنِها","فَإِيعادُها بِالرّمي غَير مطولِ",28,"ل",1,0],["فأنا وليِّكم البريءُ من العدى","والله رَبي والصلاة ختام",29,"م",1,0],["فَإِنّا وَأَنتُم في البَلِيَّةِ عُصبَةٌ","عَلى صَبرِ أَمرٍ مِن شَناً وَذُحولِ",30,"ل",1,0],["فَأَنا وَهي شج ما أَردنا","فهمان بِالضنا عارِفان",31,"ن",1,0],["فإن أُودِعَ الشعرُ بين الضلوع ِ","فأنتِ القريضُ وأنتِ اللسانْ",32,"ن",1,0],["فإن أوتادها ثلت وليس لها","بعد الحسين بنا في الناس من أرب",33,"ب",1,0],["فاناوايم الله صبٌ قد صبا","لصبابةٍ صمصامها قد جُرّدا",34,"د",2,0],["فإن أوحشت تلك المعاهد أهلها","فقد سكنوا مني فؤاداً وأضلعا",35,"ع",2,0],["فإن أودى الشبابُ فلم أضعهُ","ولم أتكلُ على أني غُذيتُ",36,"ت",1,0],["فإن أودى فقيمة ذاك يعطى","فقيراً أو لمستسعى رهينِ",37,"ن",1,0],["فَإِن أَوصَلَتنا الفَتى المُدرِكيّ","فَقَد أَوصَلَتنا الوفِيَّ الذِمَم",38,"م",1,0],["فأَنا وربّي لا أَزال مُؤَنِّبا","للعُرْب في نثري وفي منظومِي",39,"م",2,0],["فإن أوله مني الثناء فأهله","وإني وشعري للمقل وجهده",40,"د",2,0],["فَإِنّا وَمَولانا رَبيعَة مَعشَرٌ","نَعيشُ عَلى الشَحناءِ مِن كُلِّ كاشِحِ",41,"ح",1,0],["فأنا والأمُّ والجدّ","ةُ والجدُّ المعاني",42,"ن",2,0],["فان أولاد يعقوب النبي على","قميص يوسف جاؤا بالدم الكذب",43,"ب",1,0],["فأنا وإن طال البقاء فأمرنا","إلى الموت من بعد الحياة يؤول",44,"ل",1,0],["فَإِنَّ أولى بِهِ لَتابِعهُ","مِنّا وَمِنكُم فَلَيِّنوا الكَلِمَه",45,"م",2,0],["فان أو جزوان اطنب بمدح","فدون صفاته العليا كلامي",46,"م",2,0],["فإنَّا وإن شَطَّ التَّزاورُ بيننا","لُمُلتَزِمُو العَهدَ القديمَ الذي تدرِي",47,"ر",2,0],["فَأَنا وَمَن أَهوى كَذا","بَين افتضاحٍ واحتراز",48,"ز",1,0],["فَأَنا وَأَنتَ وَأُنسُنا","لا شَكَّ مِن حَظ الزَمَن",49,"ن",1,0],["فإنا وليس بنا من عياءٍ","نبدد جيشاً رماه العيا",50,"ي",2,0],["فإنَّ أَولى الورى بها ملكٌ","غدا بعبءِ الخطوبِ مُضطلعا",51,"ع",2,0],["فأنا ونظمي عاجزان بمدحه","إذ ليس ينجز بالثناءِ أوابد",52,"د",1,0],["فأنا وفروي خوف تمزيقي لها","أحكي معاوية لجنب الأحنف",53,"ف",1,0],["فانا والحُبُّ يَكْوِي مُهْجَتي","أَسَدٌ قَدْ صادَهُ لَحْظُ ظُبَيّ",54,"ي",1,0],["فأنا وأحلامي رُفضنا كوننا","لسنا نجيد طرائق التقبيلِ",55,"ل",1,0],["فأنا وجودي مقبلٌ في لحظة","وبلحظةٍ أخرى وجودي يدبر",56,"ر",1,0],["فأنا وأنتِ لبعضنا","ما للأنام وما لنا",57,"ن",2,0],["فأنا وأنتِ الصادِقانِ ولم نزَلْ","نُزْكي اصالاتٍ بما نَتَخَلَّقُ",58,"ق",1,0],["فأنا .. وإنْ كنتُ التي بقنوطِها","أبكي لأجلِ شفاعةٍ .. أتملقُ",59,"ق",1,0],["فأنا وإن أُبعدت عن درب الهوى","قسراً وأصبحتِ القلوب بمعزلِ",60,"ل",1,0],["فَأَنَاْº وَالْوَرْدُº وَالْعُصْفُوْرُ قَدْ","جَرَّنَا الْحُزْنُ إِلَىْ غُدْرَاْنِهِ",61,"ن",2,0],["فآنَ أوانُ أن نُعطيْ اعتبارًا","لأنفسنا ونمتلِكَ القرارا",62,"ر",2,0],["فأنا وأنت على يقينك توأم","والقلب عانقه بهاؤك فاكتملْ",63,"ل",1,0],["فأنا وربّ الكون اعشق ُ طيفكم","وأحس ّ فيكم دون وجه ِخداع ِ",64,"ع",1,0],["فأنا وإن أبك الشباب مودعا","فهْي البقاء تواصل وخلود",65,"د",1,0],["فَأنا وَرِزْءُ الطَّفِّ عانَقْنا الثَّرى","وَأَبي يُعانِقُ طِفْلَهُ بَيْنَ الكَفَنْ",66,"ن",1,0],["فأنا ورائي البحرُ أغرقَ خطوتي","ويظلُّ في عينيك دربي مبهما",67,"م",2,0],["فأنا وهذا الكونُ مرْآةٌ له","فيها تجلّى قدرةً لا تُقهرُ",68,"ر",1,0],["فأنا وقلبي والهوى والقصائد","غرقي نمارس عيشة الأسماك",69,"ك",1,0],["فإن أوقدوا للحربِ ناراً ومصطلىً","وجاسوا خلال الدّارِ وعداً وموعدا",70,"د",2,0],["فأنا ودجْلَةُ والفُراتُ","وما بِنا صِرْنا نِصَابَكْ",71,"ك",1,0],["فأنا وهمْ والسجْنُ نعشقُ بعضَنا","ولبعضِنا من أجلِنا نتصرّفُ",72,"ف",1,0],["فأنا وَاقفٌ هنا زَوِّديني","نَظرة ً فابْتسامَةً فَكلاما",73,"م",2,0],["فأنا وجدتُ هوايَ عندكَ مُلهمي","ووجدتُ حُبّكَ يعتري وجداني",74,"ن",2,0],["[ فإِنْ أَوْجَعَتْكَ الحادِثاتُ لِفَقْدِهِ","فَفُقْدانُهُ فِي مُهْجَةِ المَجْدِ أَوْجَعُ ]",75,"ع",1,0],["فَإنَّاْ وَ أسْنَاْنُ الرِّمًاْحِ جَمِيْعُنَا","حُمَاْةُ حِمَاْكِ حَاْفِظُونَ عَرِيْنَكِ",76,"ك",1,0],["فأنا ووُلْدي والكرام كمثلنا","لا غير ضَرْبٍ بالسّيوف نُجيد",77,"د",1,0],["فإنَّ أُولي الطُّغْيانِ في الأرْضِ رُتَّعٌ","بشرْعِ وُحوشِ الغابِ...دونَ ضَمائِرِ !",78,"ر",1,0],["فأنا والكاس نلهو والهوى","في ليالٍ نرقب القد الرشيقا",79,"ق",2,0],["فانا وأحبابي بفضلك نرتجي","نيل الأماني في كمال أمان",80,"ن",1,0],["فأنا ومِنْ بين الرُّكام نَزعتُني","وَجعلتُ مني للمنافذِ مَعبرا",81,"ر",2,0],["فأنا ورفيقاتي أضحت","كل قضيتنا سيارةْ",82,"ر",2,0],["فأنا وصبري في المعامعِ أمَّةٌ","ما طأطأتْ رأسًا لهمٍّ أوبلاءْ",83,"ا",2,0],["فإنْ أَوْجَبَتْ أَن لا تَوَدَّ فَغَالِبٌ","من الشَّوقِ أن يُصْفَى لها الودُّ أوجبا",84,"ب",2,0],["فإِنْ أَودى ادفنوه بها لتبقى","له ذكرى عَلَى كرِّ العجائب",85,"ب",1,0],["فأنا وان ذهب الحياء بقبلتي","ساعيش دوما لحظة استثناء",86,"ا",2,0],["فإنا ولدنا وفي الطين حلم","بان الذي ضاع لابد جاء",87,"ا",2,0],["فَأَنَا ( وَ أَرمَلَةُ الحُرُوفِ ) عَشيرَةٌ","زَحَفَتْ إلى فِرْدَوسِهَا أَحزَابا",88,"ب",2,0],["فأنا ودمعي والهوى وتوجسي","وتألمي وصبابتي أترابُ",89,"ب",1,0]]}