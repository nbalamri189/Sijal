{"poems":[[45,"إني لأعلم واللبيب خبير","https://www.aldiwan.net/poem9573.html","الكامل"],[33,"ضاق الغداة بحاجتي صدري","https://www.aldiwan.net/poem42515.html","الكامل"],[69,"عرج برامة إنها لمرامي","https://www.aldiwan.net/poem18099.html","الكامل"],[50,"راح الشقي على الربوع يهيم","https://www.aldiwan.net/poem65108.html","الكامل"],[408,"غير مستنكر من الأيام","https://www.aldiwan.net/poem46973.html","الخفيف"],[463,"لو شاء سار ليلة النعف وقف","https://www.aldiwan.net/poem56113.html","الرجز"],[543,"نظرت بلحظ بالقلوب لعوب","https://www.aldiwan.net/poem48277.html","عموديه"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34407","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38985","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62481","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56014","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55938","الكامل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108511","الكامل"],[2242,"","https://poetry.dctabudhabi.ae/diwan/poem/216394",""],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67258","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94039","الرمل"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147324","البسيط"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52976","المتدارك"],[3827,"","https://poetry.dctabudhabi.ae/diwan/poem/139843",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139520",""],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[5397,"متى آمن الدنيا من الغدر أخدع","https://www.poetsgate.com/ViewPoem.aspx?id=157923",""],[5561,"حسٌّ وتراب","https://www.poetsgate.com/ViewPoem.aspx?id=197538",""],[5853,"((الى ابنتي ..خلود))","https://www.poetsgate.com/ViewPoem.aspx?id=175625",""],[520,"لو كان ينفع ان تجود بمائها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577424",""],[463,"لو شاءَ سارٍ ليلة َ النَّعفِ وقفْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60144&r=&rc=200",""]],"verses":[["بِمُزَوَّدٍ كَفَنَ البِلى مِن مُلكِهِ","مُغفٍ وَإِثمِدُ عَينِهِ الكافورُ",0,"ر",1,0],["بِمُزَيَّنٍ رَدعُ العَبيرِ بِهِ","حَسَنِ التَرائِبِ واضِحِ النَحرِ",1,"ر",1,0],["بمَ زادَ عنْكَ أَبو يَزِيدَ وقد","غَدَتْ مِصْرٌ مُفَضَّلَةً عَلَى بسْطامِ",2,"م",1,0],["بِمُزَمزِمينَ غَدَوا بِسُدفَةِ لَيلَةٍ","وَاللَيلُ مُلتَبِسُ الظَلامِ يَهيمُ",3,"م",1,0],["بِمَزيدِ الجلال دُونَ البرايا","خصَّهُ ذُو الْجلالِ والأَكرامِ",4,"م",1,0],["بمزلق من العيون ما لمن","يطلبها فائتة إلا الأسفْ",5,"ف",1,0],["بمَزيَّةِ السَّبقِ التي نالت به","ذا اليومِ يَومِ فخَارِها المنسُوب",6,"ب",1,0],["بِمُزدَلِفاتٍ أَقبل الوفدُ مقبلاً","وَلاقَت مِن البشرى النُفوسُ اِقتِبالها",7,"ل",3,0],["بِمُزَّمِّل ربّي بِمدَّثِّرٍ عَلا","كَذا بِقِيامِ الخَلقِ للَّه ذي الجَدِّ",8,"د",1,0],["بمزيد من رجال لو يزاحمه","بحر الفرات بصدر منه لأفتضحا",9,"ح",2,0],["بمزيد اقبالٍ وعيش ارغدٍ","ومديد عمرٍ لا يزال موفقا",10,"ق",2,0],["بمزيد انعام من ال","مولى عليك مخلدهْ",11,"د",2,0],["بمزيد يمن سرورها وسرور عا","هلها المعظم سيد الخلفاء",12,"ا",2,0],["بْمزنةٍ غَرَّا من الغرب تِنْقاد","ويْسوقها ريح السهيلي بْجادي",13,"د",2,0],["بمزاياً كالسواري زاهرات","فهي لا تُحصى كرملِ الفلَوات",14,"ت",1,0],["بمزايا آصفي العصر من","بابي الفضل مسماه كني",15,"ن",2,0],["بِمِزْهَرِيَّةِ آيَاتِي أُنَسِّجُهَا","وَأقْتَفِي بِقَمِيصِ الخُلْدِ مَلْحَمَتِي",16,"ت",2,0],["بمزاياهم فاقوا البشرا","فهم الأمَرا وهم الأعيان",17,"ن",1,0],["بمزايا هن النجوم الدراري","غدا يهتدي بها المدلجونا",18,"ن",2,0],["بمزاياه ضاقت الكتبُ الغر","رُ وأعيت وسع الوجود اكتتابا",19,"ب",2,0],["بِمُزدَلِفاتٍ في طَريقِ غَرامِكُم","عَوائِقُ مِن دونِ اللِقا وَقَواطِعُ",20,"ع",1,0],["بمزدلف ضنك لدى الروع مأزق","لكل كمي بالحديد مقنع",21,"ع",1,0],["بمزاجهِ مُتناقضٌ","يبكي ويضحكُ مِن جواهُ",22,"ا",2,0],["بمزنٍ للورى ذكراً تسامى","تَعطّرَ من روائعهِ الوجودُ",23,"د",1,0],["بمزيد تلقى النوائب نفسه","في كل نائبةٍ بحسن عزائها",24,"ا",3,0],["بمزاقٍ منَ العيونِ ما لمنْ","يطلبها فائتة ً إلاَّ الأسفْ",25,"ف",1,0]]}