{"poems":[[55,"من رأى أعينا حذفن","https://www.aldiwan.net/poem29625.html","مجزوء الخفيف"],[55,"أترى السحاب إذا سرت عشراؤه","https://www.aldiwan.net/poem30778.html","الكامل"],[65,"زاهر العود وطيبه","https://www.aldiwan.net/poem45824.html","مجزوء الرمل"],[65,"خدع المنى وخواطر الأوهام","https://www.aldiwan.net/poem46123.html","الكامل"],[65,"هو ما ترى فأقل من تعنيفي","https://www.aldiwan.net/poem46129.html","الكامل"],[79,"ما على القلب بعدكم من جناح","https://www.aldiwan.net/poem36623.html","الخفيف"],[79,"خطب ألم فأذهب الأخ والأبا","https://www.aldiwan.net/poem36779.html","الكامل"],[88,"أيها القائمون بالأمر فينا","https://www.aldiwan.net/poem10694.html","الخفيف"],[75,"أيها الظافر أبشر بالظفر","https://www.aldiwan.net/poem11957.html","الرمل"],[53,"لهف نفسي على العيون المراض","https://www.aldiwan.net/poem64947.html","الخفيف"],[53,"يا من هواه من القلوب مكين","https://www.aldiwan.net/poem66463.html","الكامل"],[93,"إبسمي كالورد في فجر الصباء","https://www.aldiwan.net/poem8733.html","عموديه"],[87,"لا السهد يدنيني إليه ولا الكرى","https://www.aldiwan.net/poem63716.html","الطويل"],[51,"قطعت منك حبائل الآمال","https://www.aldiwan.net/poem63049.html","الكامل"],[82,"أمطتك همتك الغريمة فاركب","https://www.aldiwan.net/poem31243.html","الكامل"],[107,"في حمى الحق ومن حول الحرم","https://www.aldiwan.net/poem42091.html","الرمل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85757","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54913","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54320","الرمل"],[108,"قومي بين الشرق والغرب","https://www.poetsgate.com/ViewPoem.aspx?id=179442",""],[111,"ريب المنون مقارض الأعمار","https://www.poetsgate.com/ViewPoem.aspx?id=521",""],[79,"أهلا بِمَقْدمِكَ السَّنِّي ومرْحبا","https://www.poetsgate.com/ViewPoem.aspx?id=33308",""],[147,"ما الحسان فما لهن عهود","https://www.aldiwan.net/poem11745.html","الكامل"],[202,"أهزز معاطف رائح ومبكر","https://www.aldiwan.net/poem51948.html","الطويل"],[369,"حسن الهجر مع القرب لعيني","https://www.aldiwan.net/poem60622.html","الرمل"],[369,"عدد لكم أن سرت في تشييعي","https://www.aldiwan.net/poem60845.html","الكامل"],[376,"دار ما دار بيننا وتردد","https://www.aldiwan.net/poem57500.html","الخفيف"],[387,"منع النوم ماوي التهمام","https://www.aldiwan.net/poem433.html",""],[408,"مولاي صبرا للقضا","https://www.aldiwan.net/poem46509.html","مجزوء الكامل"],[411,"إن كنت تطلب رتبة الأشراف","https://www.aldiwan.net/poem49865.html","الكامل"],[411,"وإذا أعوز الصواب وأضحى","https://www.aldiwan.net/poem50073.html","الخفيف"],[412,"أوقد البين في الخميس خميسا","https://www.aldiwan.net/poem50154.html","الخفيف"],[412,"طرقت خيالا بعد طول صدودها","https://www.aldiwan.net/poem50186.html","الكامل"],[422,"ما لها مفرية بيدا فبيدا","https://www.aldiwan.net/poem53936.html","الرمل"],[422,"هل عرفت الديار من آل نعمى","https://www.aldiwan.net/poem54169.html","الخفيف"],[453,"لم توف أشواقي ولا لوعاتي","https://www.aldiwan.net/poem53723.html","الكامل"],[520,"أصنيعة الطهر الإمام","https://www.aldiwan.net/poem12265.html","مجزوء الكامل"],[556,"بنقا الرمث من شراف غزال","https://www.aldiwan.net/poem47338.html","الخفيف"],[556,"عل الهوى يهفو به العذل","https://www.aldiwan.net/poem47341.html","أحذ الكامل"],[563,"أنا أدرى كنه ذاته","https://www.aldiwan.net/poem33517.html","مجزوء الرمل"],[563,"كن مع الله تر الله معك","https://www.aldiwan.net/poem34279.html","الرمل"],[567,"نهنه دموعك أيها الباكي فما","https://www.aldiwan.net/poem52751.html","الكامل"],[580,"صح من دهرنا وفاة الحياء","https://www.aldiwan.net/poem2790.html","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122779","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87037","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64070","الكامل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/37996","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72271","الرجز"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72293","الكامل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/17130","الكامل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/17134","الكامل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109122","الكامل"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78167","الكامل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49570","الكامل"],[1753,"","https://poetry.dctabudhabi.ae/diwan/poem/105873","الكامل"],[1890,"","https://poetry.dctabudhabi.ae/diwan/poem/89713","الرمل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124730","الرمل"],[2021,"","https://poetry.dctabudhabi.ae/diwan/poem/139325",""],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48196","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28027","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77341","الخفيف"],[2552,"","https://poetry.dctabudhabi.ae/diwan/poem/144428","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93907","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201230","الكامل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103523","الكامل"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134025","الكامل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87571","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108268","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108347",""],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131965","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91334","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216818","الرمل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131259",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131239",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131220",""],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133297","الكامل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102981","الخفيف"],[4087,"","https://poetry.dctabudhabi.ae/diwan/poem/131666",""],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198225","الخفيف"],[5087,"إن الكتاب وإن تضمن طية","https://www.poetsgate.com/ViewPoem.aspx?id=96350",""],[5183,"ألف أهلا","https://www.poetsgate.com/ViewPoem.aspx?id=185692",""],[5206,"حياة الأرواح","https://www.poetsgate.com/ViewPoem.aspx?id=187335",""],[5939,"البوحُ في كتمانِنا","https://www.poetsgate.com/ViewPoem.aspx?id=185512",""],[6045,"لا تيأس","https://www.poetsgate.com/ViewPoem.aspx?id=138521",""]],"verses":[["وَإِذا أَعوَزَ الجَزا","ءُ جَزَيتُ القَوافِيا",0,"ي",2,0],["وَإِذا أَعادَ الحَولُ يَومَكَ عادَني","مِثلَ السَليمِ يَعودُهُ آناؤُهُ",1,"ا",3,0],["وَإِذا اعتَلَّ حَديثٌ","فالقُشَيريُّ طَبيبُهْ",2,"ب",2,0],["وإذا اعتَزَوا أوْرى زِنادَهُمُ أبٌ","مُرُّ الحَفيظَةِ للحَقيقةِ حامِ",3,"م",1,0],["وإذا اعْتَرَكْنَ بمِسْمَعٍ قرَّطْنَهُ","فِقَراً كَسِمْطِ اللؤلُؤِ المَرْصوفِ",4,"ف",1,0],["وإذا أعْوَزَ الجُسومَ التّلاقِي","نابَ عنْهُ تَعارُفُ الأرْواحِ",5,"ح",1,0],["وَإِذَا اعْتَمَدْتَ اللهَ يَوْمَاً مَفْزَعَاً","لَمْ تُلْفِ مِنْهُ سِوَى إِلَيْهِ المَهْرَبَا",6,"ب",2,0],["وَإِذا أَعوَزَتكُمُ ذاتُ طَوقٍ","بَينَ تِلكَ الرُبا فَصيدوا العِبادا",7,"د",2,0],["وَإِذا أَعتَبَ في مَعتَبَةٍ","لانَ مِنهُ جانِبُ السَمحِ اليَسَر",8,"ر",1,0],["وإذا أعمل الدَّهاءَ فصِلٌّ","يُغمضُ الكيدَ أيَّما إغماض",9,"ض",1,0],["وإذا اعتصمتُ بجوده فكأنما","غدتِ العواصم لي وقنَّسرين",10,"ن",1,0],["وَإِذا أَعياكِ أَن تُعطي الغِنى","فَاِفرَحي أَنَّكِ تُعطينَ الرَجاء",11,"ا",2,0],["وَإِذا اِعتَلى بِالكَهرُباءِ لِذَروَةٍ","عَصماءَ هَمَّ مُعانِقاً مُتَسَوِّرا",12,"ر",2,0],["وَإِذا اِعتَبَرتُ رَأَيتُ حَطَّ حَوادِثٍ","يَجرينَ بِالأَرزاقِ وَالآجالِ",13,"ل",1,0],["وإذا اعتقدتَ العدلَ ثم وزنتَني","رَجحتْ حصاتي في القريض بكبكبِ",14,"ب",1,0],["وإذا أعوز هَمٌّ أو أسىً","فاستمدِّي الهمَّ من هذا القَلمْ",15,"م",1,0],["واذا اِعتلت السياسة يوماً","مرض الشعبُ ثم عز الشفاء",16,"ا",2,1],["وَإِذَا أَعوَزَ الوَفِيَّ نَصِيرٌ","يَدْرَأُ الضَّيْمَ كانَ ذَاك النَّصِيرَا",17,"ر",2,0],["وإذا أعطى أبيْتُم أَنَفاً","أن تعُدُّوا حاتماً في الكرمَاءْ",18,"ا",2,0],["وإذا أعار بني أبيه نظرة","فبمقلة الأعمى أو المتعامي",19,"م",2,0],["واذا اعتبرت حياتك الدنيا تجد","ان الحياة مظنة الأعذار",20,"ر",1,0],["وإذا اعْتَمَدْتَ الله يوماً مَفْزَعا","لمْ تُلْف منه سِوى إليه مَهْرَبا",21,"ب",2,0],["وَإِذا اِعتَرَفتُ بِهِ وَقَصَّرَ شاطِرِي","عِيّاً فَذاكَ الإِعتِرافُ جُحودُ",22,"د",1,0],["وإذا اعترتك ملمّةٌ فلتنتصرْ","بعلا الوزيرِ على الحوادثِ تُنْصَر",23,"ر",1,0],["وإذا أعملَ حَدَّيْ رأيه","في عَدُوٍّ كان أمضَى المُرهَفيْن",24,"ن",1,0],["وإذا اعتَنى لك بالأمورِ أَتمّها","من غيرِ تقصيرٍ ولا تَضْجيع",25,"ع",1,0],["وإذا اعتدَّ كل بانٍ من المج","دِ على الناسِ بالقَصيرِ المعدَّد",26,"د",1,0],["وَإِذا أَعرَضَت تَقولُ قُصورٌ","مِن سَماهيجَ فَوقَها آطامُ",27,"م",1,0],["وإذا أعانَ كمالُكَ الدَّهرَ","الخؤونَ فمَنْ تُحَاربْ",28,"ب",1,0],["وإذا اعتدى خِلٌّ عليكَ فخَلَّهِ","والدَّهرَ فهْوَ لهُ مُكافٍ كافِ",29,"ف",1,0],["وإذا أعوزَ الصَّوابُ وأضحى","مِنهُمُ القَولُ مُرْتَجَ الأبوابِ",30,"ب",1,1],["وَإِذا أَعقَبَ النُحوسَ سُعوداً","لِلفَتى أَتبع السُعودَ نُحوسا",31,"س",2,0],["وَإِذا اعتَبَرَت فروعه بأصولِهِ","أَيقَنَت أَنَّ دُخانِهِ مِن عودِها",32,"د",3,0],["وإذا أعربتَ عن أبنائهم","فاذكر الآباء منهم والجدودا",33,"د",2,0],["وإذا اعتلت العلاء بداءٍ","حسموا داءها على الفور حسما",34,"م",2,0],["واذا اعتبرت محققا أحواله","الفيتهن افكار بديهيات",35,"ت",1,0],["وإذا اعتزامك كان في","كفي غنيت عن الحسام",36,"م",1,0],["وإذا أعوَزَ التَّجَمُّلُ فالإعْ","وازُ منه الإحسانُ والإجمالُ",37,"ل",1,0],["وإذا أعار القولَ منطقُه","خَفَتَ الكلامُ وأَمْسَكَ الزَّمِلُ",38,"ل",1,0],["وإذا أعرض عني","أنا ميت وحياته",39,"ت",2,0],["وإذا أعطاك من يمنعه","ثم من يعطي إذا ما منعك",40,"ك",1,0],["وإذا اعتَرَى الظَّرفَ الفَسادُ لذاتهِ","كيفَ الرَّجاءُ لما بهِ أن يسلَما",41,"م",2,0],["وإِذا أَعْرَضَ التصبُّرُ للقل","ب أَبَى منَّةً عليَّ إِبَائِي",42,"ي",1,0],["وَإذا اعتَزَيتُ لدَعبَلٍ وَكُثَيّرٍ","أَصغَى إلى فَقُدتُه بِزمامِهِ",43,"م",2,0],["وَإِذا اِعتَراني مِن صدودك شدّةٌ","وَرضيت عَن قَوم حفاة الأَرجُل",44,"ل",1,0],["وإذا اعتصمتُ بمعقلٍ من خندفٍ","وعلوتُ من سعدِ بنِ ضبَّةَ نيقا",45,"ق",2,0],["وَإِذا اِعتَقَلت مِنَ الرِّماح بِأَسمَرٍ","تَبدو القُلوبُ مِنَ الصدورِ وتنزعُ",46,"ع",1,0],["وإذا اعترى غيري ارتيا","ع منه زاد به ارتياحي",47,"ح",2,0],["وإذا اعتصمت بهم نجوت من الردى","وإذا انتصرت بهم وجنانهم معي",48,"ع",2,0],["وإذا اعتبرت عقولهم ألفيتهم","بقراً ولكن ما لها أذنابُ",49,"ب",1,0],["وإذا اعتبرت عقولهم ألفيتهم","ألفيتهم بقراً بلا أذناب",50,"ب",1,1],["وإذا اعتمدت على سوا","ك فما اعتمدت على أحد",51,"د",1,0],["وَإِذا اِعتَلا مَتنَ الجَواد حَسِبتَهُ","طوداً بِصَهوةِ أَشهَب أَو أَدهَم",52,"م",1,0],["وإذا اعتبرتَ العُمْرَ فهو ظُلامَةٌ","ولاموتُ منه موضعُ التوقيع",53,"ع",1,0],["واذا اعتزى فإِلى البنفسج يَعتزي","واليه يُنسَبُ كي يعزّ قَليلا",54,"ل",2,0],["وَإِذا أَعلَنت أَمراً حسناً","فَليَكُن أَحسَن مِنهُ ما تَسر",55,"ر",1,1],["وإذا أعتق عبداً سيدٌ","رفع الخدمة عنه والرهق",56,"ق",1,0],["وإذا أعتقه في مرضٍ","وهو مأخوذ بدين مرتبق",56,"ق",1,0],["وإذا أعتق منه عشراً","ذهب الباقي جميعاً فانمحق",56,"ق",1,0],["وإذا أعتق منه إصبعاً","وقع العتق عليه فاستحق",56,"ق",1,0],["وإذا أعتق يوما حصةً","من غلام بين أحزاب فرق",56,"ق",1,0],["وإذا أعتقه في بيعه","وجب العتق إذا البيع صفق",56,"ق",1,0],["وإذا أعتق عبداً سيدٌ","خيفه حاذر منه وفرق",56,"ق",1,0],["وإذا أعرضَ قطريه لنا","وفيا واستوفيا قداً بقد",57,"د",1,1],["وإِذا اعتززتُ به تدفَّقَ سائلاً","وادي القريضِ الرحْبِ من حَوْبائِي",58,"ا",2,0],["وإذا أعماله عرضت","بان ارباح وخسران",59,"ن",1,0],["وَإِذا أعوزَ الوَقودُ فَلِلرَك","بِ قُلوبٌ قَد اِحتَرَقنَ اِشتِياقا",60,"ق",2,0],["وإذا أعلنْ باللّهِ","قَفُلْ للعُودِ أعلِنْ",61,"ن",1,0],["وإذا أعربت تلاحين شاد","عن حلاها يهزني الإطراب",62,"ب",1,0],["وإذا اعتراه تهدُّمٌ بمحطة","يلقى بركبٍ قادم ترميما",63,"م",2,0],["وإذا اعتذرت إلى أخٍ من زلةٍ","واشكت بين محيله ومبينه",64,"ن",2,0],["وإذا اعتراها أي غاشية معا","ذ الله فاقصد خير آسٍ واق",65,"ق",1,0],["واذا اِعتبرتَ الامرَ هان عليك ان","تُبقيها من دون ثقلٍ فابلُهُ",66,"ل",2,0],["وإذا أعاد له الزيارة طارق","فسروره في عوده يتجدّد",67,"د",1,0],["واذا اعتري وجه الامور عبوسةٌ","لجلائها يبدو سنى مشكاته",68,"ت",2,0],["وَإِذا أَعادَت بَعد شَهرينِ الدِما","تِلكَ اِستَحاضَةٌ بَعدَ ذي الشَهرانِ",69,"ن",1,0],["وإذا أعوزك الصبر فنم","وترقب زورتي عند الكرى",70,"ر",2,0],["وَإِذا اِعتَدى في سَكرة الحُبِّ اِغتَدى","ثَملاً بِما تُهدي المراشفُ وَاِغتَدا",71,"د",2,0],["وإذا أعجزكم أن تفعلوا","فاشكروا من يحرم الخلق السؤالا",72,"ل",2,0],["وإذا أعاصير الشقاق تناوحت","راحت على ذكر التضاغن تشرب",73,"ب",1,0],["وإذا أعاظم أمةٍ نشدوا العلى","بات التسفل يستثيرُ طغامها",74,"م",3,0],["وإذا اعتادت فتاةٌ عادةً","رسخت في نفسها كالجبل",75,"ل",1,0],["وإذا اعتدى يوما عليكم معتد","فسيوف أرباب البرازخ باتره",76,"ر",2,0],["وإذا أعوز الملوك عبير","تخذ العشير المثار عبيرا",77,"ر",2,0],["وإذا أعطيته خشخاشة","فهي تكفيه طعاماً إن أكل",78,"ل",1,0],["وإذا أعطيت مشروباً له","مص منه في الهوى مثل الوشل",78,"ل",1,0],["وإذا أعْملوا البَواتِرَ غَطُّوا","بِبساطِ الأَشلاءِ وَجْهَ الصَّعيدِ",79,"د",1,0],["وإذا أعانته عناية حامل","فجوابه يأتي بنجح مفلس",80,"س",1,0],["وإذا أعطشني البع","د سقاني الطيف ريا",81,"ي",2,0],["وَإِذَا أَعَنْتَ بِكَ المُطِيْعَ لِرَبِّهِ","صِرْتَ الوَلِيَّ وَأنْتَ أَنْتَ حَلابِسُ",82,"س",1,0],["وَإِذَا أَعَنْتَ عَلَيكَ حِزبَ طَريدِهِ","فَبِذَاكَ أَنْتَ لَفِي البِعَادِ الهايِسُ",82,"س",1,0],["وإذا اعتراكِ تهورٌ","وهمَمْتِ بي قتلا، قِفي",83,"ف",2,0],["وإذا اعترتك من الصعاب مُلِمّةٌ","وسألت نفسك: من يروم صعابا ؟",84,"ب",2,0]]}