,[5961,"الدعاء في عرفات","https://www.poetsgate.com/ViewPoem.aspx?id=199815",""],[6069,"ألآل ضواحكٌ أم ثغور","https://www.poetsgate.com/ViewPoem.aspx?id=105665",""],[6115,"يابيوت الشعر حدي واستعدي","https://www.poetsgate.com/ViewPoem.aspx?id=180465",""],[6124,"الفارس الذي لا يأتي","https://www.poetsgate.com/ViewPoem.aspx?id=201237",""],[6318,"مواكب بدر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66158&r=&rc=8",""]],"verses":[["ثُمَّ ساوَتها فَخاراً مُضَرٌ","بِعَلِيِّ الطاهِرِ المُنقَبَتَينِ",0,"ن",1,0],["ثُمَّ سِبطاهُ شَهيدانِ فَذا","بَحَسا السُمَّ وَهَذا بِالظُبى",1,"ا",1,0],["ثُمَّ سَخَّرتُمُ الرِياحَ فَسُستُم","حَيثُ شِئتُم جَنوبَها وَالشَمالا",2,"ل",2,0],["ثم ساروا في حكمها سير فُلك","هم بها آخذون بالسُكّان",3,"ن",1,0],["ثم سمَّوه بالأمير وهذا","من ضروب الخِداع في التعبير",4,"ر",1,0],["ثُمَّ سَكَنتَ البِلادَ لا بَشَرٌ","أَنتَ وَلا نُطفَةٌ وَلا عَلَقُ",5,"ق",1,0],["ثُمَّ سمَّاهُ باسْمِه سَيِّدُ السَّا","داتِ غيْرَ المدافع المَجْحُودِ",6,"د",1,0],["ثم سَقيتُ الدماء تربتَها","لم أشفِ ما في الفؤاد من وَحَرِ",7,"ر",1,0],["ثم سعى بعد ذاك مكتسباً","للمجد حتى ارتداهُ واعْتَجره",8,"ر",2,0],["ثم سام الأميرُ سوم الملاهي","وخلا بالمُدامِ والنُّدمان",9,"ن",1,0],["ثُمَّ سَلَّطتُهُ عَلى الشاهِ وَالرَخ","خِ فَعَجَّلتُ أَخذَهُ بَعدَ ذَينِ",10,"ن",1,0],["ثُمَّ سارَت بِهِ الحَمِيَّةُ قُدماً","فَأَماتَ العِدى وَماتَ كَريما",11,"م",2,0],["ثُمَّ سَما مِن بَعدُ لِلشَآمَين","فَجُرِّعوا مِن كَأسِهِ الأَمَرَّين",12,"ن",1,0],["ثم سَمّتْ له اليهوديَّةُ الشَا","ةَ وَكم سَامَ الشِّقْوَةَ الأَشقِيَاءُ",13,"ا",2,0],["ثم سيرا على الأصابع في صمْ","تٍ وفي حضرةِ الأميرِ دعاني",14,"ن",2,0],["ثمَّ سدَّ الأفقَ الدُّخانُ تعالى","من بيوتٍ للنارِ فيها شُبوب",15,"ب",1,0],["ثمَّ سدَّ الدُروبَ جيشُ \" الكَدودين \"","طَوالَ النَّهارِ في أتعاب",16,"ب",1,0],["ثمّ سوموا السجود كبرا وتيها","إذ تمرّون : شيخنا والغلاما",17,"م",2,0],["ثمَّ سارَت شمسُ الوجودِ بليلٍ","معَها البدرُ أفقها البيداءُ",18,"ا",2,0],["ثمَّ سارَ النبيُّ نحوَ حُنينٍ","بِخَميسٍ ما ضرّه أربعاءُ",18,"ا",2,0],["ثُمَّ سادَت سَكينَةٌ وَتَوارَت","جُزُرُ النورِ في الفَضاء الرَمادي",19,"ي",1,0],["ثم سل عن كل دمع","هل جرى من غير ذنب",20,"ب",1,0],["ثم سارت كأسهمٍ","عن قسي موتره",21,"ر",2,0],["ثُمَّ سلامُ اللَه سبحانَهُ","عليك صَبٌّ دائمٌ سَرمدُ",22,"د",1,0],["ثمّ سَألتهم فَقالوا تجاهل","تُ وَساءَلتنا على عرفانِ",23,"ن",1,0],["ثُمَّ ساروا وَتَواصَوا كُلُّهُم","بِاِجتِياحي لِلرِضا بِالمُلحدين",24,"ن",1,0],["ثمّ سِرٌّ غَامِضٌ مِن دُونِهِ","قَصرت واللهِ أعنَاقُ الفُحولِ",25,"ل",1,0],["ثُمّ سارَتْ وفي الجَوانحِ منّي","خُرَقٌ غادرَتْ فؤاديَ رَضْفا",26,"ف",2,0],["ثُمَّ سخا وما اقتَصَر","في كُلِّ بَدْوٍ وحَضَر",27,"ر",1,0],["ثُمَّ ساداتي فَاِنَّ ال","قَولُ يُلقى في ذَراها",28,"ا",3,0],["ثم سرحت الطرف في روض نظم","هو واللّه آية من كلامك",29,"ك",1,0],["ثم سارت بأعين اللّه تجري","وترينا من كل بر رماله",30,"ل",2,0],["ثم سَدَّدْتُمُ سهام دعاء","خُضِبَتْ بالدموع للمعبود",31,"د",1,0],["ثم سرح أجفان فكرك إن كن","ت فتى ناظراً بفكر اللبيب",32,"ب",1,0],["ثم سلام نَشْرُهْ","من كل نشر أطيب",33,"ب",1,0],["ثم سِرنا والطير يحسُدنا بالأم","س لإسراعنا على الطيران",34,"ن",1,0],["ثم سَلِ الفرسَ وبيت النار","من الذي فَلَّ شبا الكفار",35,"ر",1,0],["ثم سَدُّوا علَيهِمُ كُلَّ بابٍ","لِلنَّجاةِ المُرَجَّاةِ بِرّاً وبَحرا",36,"ر",2,0],["ثُمّ سالَت منهُ بِال","طعنِ وَالضربِ شِعابُ",37,"ب",1,0],["ثم سرنا نزيل آثار نومٍ","فحططنا إلى منازل قومٍ",38,"م",1,0],["ثم سقهم إلى حماك قبولا","واسقهم منك رائق الينبوع",39,"ع",1,0],["ثم سر غامض من دونه","ضربت واللَه أعناق الفحول",40,"ل",1,0],["ثُم سَلسلتُها إلى جَسدٍ مَي","تٍ فأحيَتهُ فاعتبر باعتباري",41,"ر",2,0],["ثم سال الدمع من وجنتها","فتلقته بأطراف الردن",42,"ن",1,0],["ثُمَّ سِرْ نَحوَ دِمشقٍ وَاِغنما","فُرصَةَ السَّيرِ بِوقتِ الغلسِ",43,"س",1,0],["ثم سلِّمْ وقفْ وقُل بعدَ تسلي","مكَ قول امرئٍ مجدَّدِ عَهدِ",44,"د",1,0],["ثُمَ سَعى بَينَ الوَرى وَقاما","وَهمَّ يَبغي بَينَهُم مَقاما",45,"م",2,0],["ثم سليمانَ فتى حمير","مَنْ يُرتجَى عند الأمور العِظام",46,"م",1,0],["ثم ساروا بعون رب البرايا","قاصدى يثرب خيار البلاد",47,"د",1,0],["ثُمَّ سِيرا وَخَبِّرا القَومَ أَنِّي","بَعدَ فَقدِ الحَياةِ أَمشي سَويَّا",48,"ي",2,0],["ثم سلطته على كل شيءٍ","منك يا ربي كونه قد تركبْ",49,"ب",1,0],["ثم سلمى وزينب وسعاد","ان في ذكرهم صفاء الطويه",50,"ي",2,0],["ثم سقانا قهوة لم يدع","أطيب منها بقرى شامه",51,"م",2,0],["ثم سلام الله يغشاه من","صفّي ود لم يحل وامق",52,"ق",1,0],["ثم سيقَ الجاني إلى السجنِ يلقى","ما جنته يداهُ موتاً زُؤاما",53,"م",2,0],["ثم ساد السكوت والنقطة الأُخر","ى تجلَّى في وجنتيها الحياءُ",54,"ا",2,0],["ثُمَّ سُلَيمانُ بنُ عَبدِ المُلكِ","اِختيرَ لِلعَهدِ وَلَمّا يَترُكِ",55,"ك",1,0],["ثم سالت بالجود منه سيولٌ","تنعش المرملين بعد الشتاء",56,"ا",2,0],["ثم سيقَ الكفارُ نحوَ جحيمٍ","يستغيثونَ حيثُ حلَّ البلاء",57,"ا",2,0],["ثم سبح خمساً وقل هو ربي","وسع الناس رحمةً ونكالا",58,"ل",2,0],["ثم سامح أخاك بالصفح فضلا","حيث ألقى لديك منه السلاحا",59,"ح",2,0],["ثم سادَ السكون في الغبراءِ","تحت حزنِ الطبيعةِ البكماءِ",60,"ا",2,0],["ثم سائل غمدان إن شئتَ عن","سيف إذا ما شككت في الحادثات",61,"ت",1,0],["ثم سارت مطيهم تذرع البي","د ولكن قلوبنا تلقاها",62,"ا",3,0],["ثم سلام اللَه مني على","جنابكم ما غرد العندليب",63,"ب",1,0],["ثُمَّ سَمَرقند مع بُخَارى","لِحَدِّ فرغانَةَ كلٌ سَارَا",64,"ر",2,0],["ثُمَّ سَراياه أَتَت للحلَّه","وَنحو بَغداد بِغَير عِلَّه",65,"ه",1,0],["ثُمَّ سَلْني عَنْ لَحْنكَ الفاضح الفا","حشِ بحرِ الخفيفِ وهو ثَقيلُ",66,"ل",1,0],["ثم سقا يرش بالقربة الس","وق أيضاً: سريعاً ذيلي به مبلول",67,"ل",1,0],["ثُم سَلام ضم لِلصَلاة","عَلى نَبي خص بِالصَلات",68,"ت",1,0],["ثُم سَلام قَد سَما وَراقا","لأَنَّهُ قَد زين الأَوراقا",68,"ق",2,0],["ثُم سَلام قَد حكى صوب الحَيا","يهدي لأَولادك أَرباب الحَيا",68,"ي",2,0],["ثُم سر بي نَحوَ سربي فالقوى","للجوى أَضحَت مَناخاً وَمَقاما",69,"م",2,0],["ثم سر نحو زهرتي فإذا ما","عسعس الليل فانسرب لحماها",70,"ا",3,0],["ثم سلام نشره طيب","وافى به نظمي في ختمه",71,"م",2,0],["ثم سعوا في القتل بالتدبير","بزعمهم يخفى على البصير",72,"ر",1,0],["ثم ساقوني إلى الفيحا دمشق","لأقَضّي السجن في قلعتها",73,"ه",2,0],["ثم سليمان تولى الملكا","وساسه حتى تولى هلكا",74,"ك",2,0],["ثم ساق القضاء نجبي وحكم ال","حق بالحق واجب الامتثال",75,"ل",1,0],["ثُمَّ سَلِّم لي عَلى رَشا","هامَ قَلبي فيهِ مِن صُغرِهِ",76,"ر",2,0],["ثم سار كلاهما يتمنىلا","باشتياق دوام هذا التداني",77,"ي",1,0],["ثم سارت بنا هنالك بكر","هي ليست بفارض أو عوان",78,"ن",1,0],["ثم سرحنا بعد ذاك الهَجَرَه","بِزفَّةٍ مضمرةٍ ومَحجِرَة",79,"ه",1,0],["ثُمَّ سَارُوا إِلَى النَّجَاشِيِّ صَارُوا","فِي حِمَى كُلَيبٍ بِهِ لَم يُسَاؤُا",80,"ا",2,0],["ثُمَّ سَارَت بِهِ إلَى المَسجِدِ الأقصَى","فَصَلَّى والأسرِيَاءُ وَرَاءُ",80,"ا",2,0],["ثم ساروا بهن فوراً وجدوا","وإلى السور أقبلوا أسرابا",81,"ب",2,0],["ثُمَّ سارُوا وأَوفَدُوا بنُذُورٍ","شائقاتٍ لِلرَّبِّ خَيرَ وفاده",82,"د",2,0],["ثمَّ ساد السكوتُ حتى لقد تسمع","نَقرَ القلوبِ في الأَجسامِ",83,"م",1,0],["ثم سُدْهمْ بالقوتين جميعا","مستميتا إلى بلوغ المرام",84,"م",1,0],["ثم سال الدمعُ لكن","مدمعي دمع الشموع",85,"ع",1,0],["ثم سارت كغزالٍ نافرٍ","من يد الصيّاد مغلول الحبال",86,"ل",1,0],["ثم سلام البارئ السلام","على فتى سما على السلامي",87,"ي",1,0],["ثم سالك يا مطرب خذ القول واسمع","عن به في دجا الداجي ولا عاد تهجع",88,"ع",1,0],["ثم سواه فتنة للبرايا","بشرا في جفونه الملكان",89,"ن",1,0],["ثم سقينا البيد والسباسبا","من الدموع ما قضينا الواجبا",90,"ب",2,0],["ثم سعوا يا صاح سعى العمره","ممتثلين أمر رب القدرة",90,"ه",1,0],["ثم سما إلى الجسيرِ مُزجيا","مِن دِرَّةِ القَطر لَهُ ما قَد زَجا",91,"ا",1,0],["ثم سالت كيف تُطفي غلةً","لم يزدها الدمعُ الا لهبَا",92,"ب",2,0],["ثم سنَوا لكلِّ مجدٍ سبيلاً","فيه نالوا مجداً وحازوا الثوابا",93,"ب",2,0],["ثم ساد البِشر والأنسُ ملكْ","ببهاءٍ فوق عرشِ المُهَجَاتْ",94,"ت",1,0],["ثُمَّ سارَت مَفتُولَةَ السَّاقِ تَتلُو","مَن تَلَاها، وتَشتَهِي مِنه \"فَزعَة\"",95,"ع",2,0],["ثم سل من آمنوا إنهمُ","بعد ما قد سمعوا كل ينوح",96,"ح",1,0],["ثمَّ سارت كلُّ لما فيه كانت","ولكلٍّ على الأصول استواء",97,"ا",2,0],["ثمّ سحبتُ شِباكَ الصّيدِ مُبتَسِماً","فما وجدتُ سوى نَعلَيْنِ قد تُرِكَا",98,"ك",2,0],["ثم سر فيه على بحر الهوى","هائما خلف القِسِي القاسيات",99,"ت",1,0],["ثُمَّ سَلاَّهُ وَصَبَّرَهُ","بِمَقَالٍ عَاطِفٍ وَيَدِ(٧)",100,"د",1,0],["ثم سلم عليه عني إذا اتبعت","وافي صلاتك التسليما",101,"م",2,0],["ثم سلم والثم ثرى الأرض ما اسطعت","وكرر في تربها التقبيلا",102,"ل",2,0],["ثم سلعا والمصلى سقيا","أدمع العشاق إن لم تمطرا",103,"ر",2,0],["ثم ساد الظلامُ شيئاً فشيئاً","بغيومٍ بهيمةٍ كالغيوب",104,"ب",1,0],["ثم سارتْ تخطُّ للكونِ نهجاً","أحمديَّ الهدىٰ نقيَّ المدادِ",105,"د",1,0],["ثم سكينة تناسب منك الذ","هن في لطفها وحسن الصفاء",106,"ا",2,0],["ثم سبعون واثنان كانوا","خيرة من هدية البيعتان",107,"ن",1,0],["ثم سلم واقبلن نظم عبد جاهل","واعف عنه ياولي واجل عنه الظلمات",108,"ت",1,0],["ثم ساروا والعيس من وله البين","على أنفس الكماة تسير",109,"ر",1,0],["ثم سيري واكسبي رهن التحدّي","يوم كلن قام يعلن ويش رصيده",110,"د",2,0],["ثُمَّ سَارَتْ فِي مَرَاحٍ نَحْوَ طِفْلٍ","قَدْ زَرَعْنَاهُ الأَمَانِيْ بِالخَمَائِلْ",111,"ل",1,0],["ثُمَّ سَمَّوهُ فلسَفَاتٍ وفِكْراً","بين جُورِ الضَّلالِ والبُهْتَانِ",112,"ن",1,0]]}