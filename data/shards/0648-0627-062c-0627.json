/poem/138442",""],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59473","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114050","الخفيف"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133298","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133226","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111435","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90832","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94586","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81698","الكامل"],[4388,"","https://poetry.dctabudhabi.ae/diwan/poem/115305","الطويل"],[4625,"","https://poetry.dctabudhabi.ae/diwan/poem/124112","الرمل"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52133","الرمل"],[4767,"صرح الفضيلة","https://www.poetsgate.com/ViewPoem.aspx?id=100459",""],[4852,"كيف لك..؟","https://www.poetsgate.com/ViewPoem.aspx?id=214328",""],[5136,"الحق أبلج واضح للمهتدي","https://www.poetsgate.com/ViewPoem.aspx?id=121802",""],[5183,"بين الهيمنة والهينمة","https://www.poetsgate.com/ViewPoem.aspx?id=180155",""],[5275,"شهداء الخبزفي بلادي_جابر الشكرجي","https://www.poetsgate.com/ViewPoem.aspx?id=35816",""],[5401,"الشيطنه والشقاوه","https://www.poetsgate.com/ViewPoem.aspx?id=85139",""],[5442,"ما آذنته بينها أسماء","https://www.poetsgate.com/ViewPoem.aspx?id=114772",""],[5607,"وحياء ذاك الوجه بل وحياته","https://www.poetsgate.com/ViewPoem.aspx?id=181265",""],[5685,"قبلة الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=36763",""],[5952,"لم يكفنا التفاح","https://www.poetsgate.com/ViewPoem.aspx?id=203994",""],[5953,"قد أضأ بالقائم النيران","https://www.poetsgate.com/ViewPoem.aspx?id=93851",""],[5989,"يا راحلاً قد شاقهُ الغرقُ","https://www.poetsgate.com/ViewPoem.aspx?id=181565",""],[6102,"تعدو دعد","https://www.poetsgate.com/ViewPoem.aspx?id=183318",""],[5724,"يا ليل ظلامك يحبسني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55136&r=&rc=3",""],[6213,"وطن وتراب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76251&r=&rc=8",""],[6280,"لاَمَ في أُمِّ مَالِكٍ عاذِلاكَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27897&r=&rc=52",""]],"verses":[["وأجاد سام ما أراد محركاً","قلب الدجى بعوامل الأوتار",0,"ر",1,0],["وأجابتْ : أنا من أندلسٍ","جنةِ الدنيا سهولاً وجبالا",1,"ل",2,0],["وأجاب الملّاحُ في بطنها المل","لاحَ يَحْتَثُّ بالسَّفين الحُداءَ",2,"ا",2,0],["وَإِجّانَةٌ فيها الزُجاجُ كَأَنَّها","طَوافي بَناتِ الماءِ في لُجَّةِ البَحرِ",3,"ر",1,0],["وَأَجابَ داعي الخَطبِ عَنكَ بِمالِهِ","وَالماضِيَينِ مُهَنَّدٍ وَسِنانِ",4,"ن",1,0],["وأَجابتْ وكلّها فتنةٌ تُغ","وي وتُغري بالحبِّ بلْ بالجنونِ",5,"ن",1,0],["واجاعها شحاً ولم","يحسب لجوعتها حسابا",6,"ب",2,0],["وَأَجارَ الدُنيا مِنَ الخَوفِ وَالحَي","فِ فَهَل يَشكُرُ المُجيرَ المُجارُ",7,"ر",1,0],["وَإِجّانَةٍ رَيّا الشَروبِ كَأَنَّها","إِذا اِغتُمِسَت فيها الزُجاجَةُ كَوكَبُ",8,"ب",1,1],["وَأَجارَني إِذ حاوَلَت دَمِيَ العِدى","وَرَأَت شِفاءَ صُدورِها في وِردِهِ",9,"د",2,0],["وأجالَ الربيعُ أخضَرَ كفَّي","هِ ليمحو اصفرارَه المُتراكم",10,"م",1,0],["وأُجاجُ الماءِ بِكَثرَتِهِ","لا رَيِّ بِهِ لِغَليلِ صَدِ",11,"د",1,0],["وَأَجازَت بِها البِغالُ تَهادى","نَحوَ خَبتٍ حَتّى إِذا جُزنَ خَبتا",12,"ت",2,0],["وأجابها عثمانُ دعوةَ ناصحٍ","يأبى الهوى ويُجانِبُ الآثاما",13,"م",2,0],["وَأَجابَتني وَلَم أَد","رِ أَجدّاً أَم مُجونا",14,"ن",2,0],["وَأَجادَت بِلادُهُ بِنَباتٍ","عِرقُهُ بارِدُ الشَرابِ غَنِيُّ",15,"ي",1,0],["وأجازَهَا قُذَفاتِ كلّ مُنِيفَةٍ","وَكْرُ العُقابِ بها وبيْتُ الأعْصَمِ",16,"م",1,0],["وَأَجَادُوا الدمَى فَجَازَ عَلَيْهِمْ","أَنَّهَا الآمِرَاتُ فِي الأَقْدَارِ",17,"ر",1,0],["وأجاب هر هرة فأجال في","وجه السكون توسم العرّاف",18,"ف",1,0],["وأجادت من الفراغ وجودها","وجبالها ، من الشموخ المنيف",19,"ف",1,0],["وأجادوا فيه السبابا ولكن","يحسن الشمّ من يسيء الفعالا",20,"ل",2,0],["وَأَجادَ فيكَ الشعر يَقطر حُسنَهُ","مِن كُل عقد بِالنُجوم منضد",21,"د",1,0],["وأجاد في تهذيبه وكأنه","طبع كما سار النسيم رقيقُ",22,"ق",1,0],["وأجاريهم وأضحك سرّا","أتغابى وقد عرفت الصوابا",23,"ب",2,0],["وَأجابَهم غضب الإلهِ قدِ اِنتهى","وَأَنا لَها وَأَنا لَها وأنا لَها",24,"ه",2,0],["وأجال عادية الجياد محارباً","وأذلَّ أعناق البلاد منيلا",25,"ل",2,0],["وَأَجالَ العُيونَ في الغُرفَةِ الس","وداءِ عَلَّ الظَلامَ يَكشِفُ سِرّا",26,"ر",2,0],["وَأَجابَ رَشيدٌ لَم يَرجع","وَجَميل أَواه مضجعُهُ",27,"ع",2,0],["وَأَجابَ دَعوَةَ مَن دَعا وَلَو أَنَّهُ","عَبدٌ يُباعُ بِأَحقَرِ الأَثمانِ",28,"ن",1,0],["وأجارَني موسى بما","أسدَاهُ من تِلكَ العَوارِف",29,"ف",1,0],["وأجاروكم من القوم الألى","أمعنوا فيكم نكالاً وجلاء",30,"ا",2,0],["وأجاب أني عن ذرى ال","عذراء كنت مؤوِّبا",31,"ب",2,0],["وأجابوا بجوابات لهم","كلها في حَلِّه غير جلي",32,"ل",2,0],["وأجابتْه بالصّليلِ سُيوفٌ","ظَامئاتٌ وبالصَّهِيلِ خُيولُ",33,"ل",1,0],["وَأَجاباكَ إِذ دَعَوتَ بِلَبَّي","كَ كَما قَد أَجَبتَ إِذ دَعَواكا",34,"ك",2,0],["وأَجارَ خلقَ اللهِ فاعْتَرَفُوا","عِوَضاً من الأَوْطَانِ والأَهْلِ",35,"ل",1,0],["وَأَجَارَ قَدْرَكَ أَن يَسُوغَ لِقائِلٍ","جَارَ الزَّمَانُ وأَنْتَ مِنهُ جَارُ",36,"ر",1,0],["وأجال خمر الوجنتين لم يشنْ بذبوله","والبدر غيرَ سراره وكسوفه",37,"ف",2,0],["وأَجازَ قَتْلي فاقْضِهِ مُتَبَتِّلاً","أَو فاجْعَلْنِ دِينَ الغَرامِ هو الحَكَمْ",38,"م",1,0],["وأَجابَ من قبلِ النِّدا","وأَعادَ قَبْل الإِسْتِعادَه",39,"د",2,0],["وأجادَ مضجعكَ الندآءُ مكلّلاً","صَفَحاتهِ البيضآء في الأَسحارِ",40,"ر",1,0],["وَأُجازَى مِنَ اللَيالي بِغَدرٍ","وَأَنا آمنٌ بِدار النَعيم",41,"م",1,0],["وَأَجابَت بجوق يَشا في دُعاها","للخديوي رَعيةٌ وَجُنود",42,"د",1,0],["وَأَجابه عِندَ السؤال وَخصه","مِنهُ بِحُسن تَحية وَسَلام",43,"م",1,0],["وأجاز البقاءَ حولكم من","كان عنكم مطالباً بالجلاء",44,"ا",2,0],["وأجار الملك من غاصبه","وكفى الأوطان شر الحدثان",45,"ن",1,0],["وَآجالَهم قَصِّرْ وَأَفْنِ رجالَهم","إِلَهي لَهم أَهلِكْ إِلهي لَهم أَرْدي",46,"د",2,0],["وإجابة يومَ الوَغى","لتفرق الجمع الكثيفْ",47,"ف",1,0],["واجاجي وبؤس عيشي وطيشي","بعد رهطي أولى المشيب الوقير",48,"ر",1,0],["وأجال فيك مديحه","وأجاد فيك المعتقد",49,"د",1,0],["وأجار في الوادي الغزالة إذ شكت","فغدت تقول مقال حق فيصل",50,"ل",1,0],["وَأَجارَني من كلّ جورٍ إنّه","ملكٌ يجيرُ ولا عليه يجارُ",51,"ر",1,0],["وَأَجالوا في المجالِ","في هوى ذاتِ الدلالِ",52,"ل",1,0],["وَأجازيه جَزاء حَسَناً","وَأريه ما أَراني مِن مشاق",53,"ق",1,0],["وأجاد بالصوم الذي أيامه","أيام تجديد الطهارة والنقا",54,"ق",2,0],["واجال جري الصافنات رحي بها","من صدره طحنت دقيق الأعظم",55,"م",1,0],["وأجادَت سَلبي بأسمَرِ قَدٍّ","وأذابَت قلبي بِبِيض التَراقِي",56,"ق",2,0],["وأجابهم داعي التنازع والبقا","هذي نتائج انكم ضعفاء",57,"ا",2,0],["وأجاب الهوى حكمت عليكم","إنهن الحكام والأمراء",58,"ا",2,0],["وأجاب العلى فقال جهارا","ما بهائي إلا هوى في هباء",59,"ا",2,0],["وأجاب الندى فقال ذروني","قبل ماء العيون شد وكاء",59,"ا",2,0],["وأجاب داعيه وخلفني","وحديثه فكأنما يحيا",60,"ي",2,0],["وأجاب الندا واعتزل الأه","ل وخلى الأولاد والأموالا",61,"ل",2,0],["وأجازوا على الصفا السعي من","غير طهورٍ ولم يروه ابتذالا",61,"ل",2,0],["وأجاز العض محبوبٌ على","شهرةِ الفقدانِ من قال شهد",62,"د",1,0],["وأَجابت الداعي إلى ما شاءَه","منها ولَوْ في أَبعد الأَخطارِ",63,"ر",1,0],["وأجاد داود الشكور سوابغا","مددولة الأردان والأزرار",64,"ر",1,0],["وَأجَارَكَ الرَّحمَنُ مِن ضَربٍ وَتَع","زِيرٍ وَمِن سَبٍّ وَمِن سَجَّانِ",65,"ن",1,0],["وَأَجادَ حَتّى لَيسَ يُلحَقُ حافِظٌ","فيها وَأَعجَزَ أَحمَدٌ وَخَليلُ",66,"ل",1,0],["وَأَجابَ المُحارِبونَ إِلى السِّل","مِ فَراراً مِنَ الطِّعانِ وَكُفرا",67,"ر",2,0],["وأجابه الخطباء كل محسن","يزرى بنظم الدرّ منه نثار",68,"ر",1,0],["وأجاد فيما قد أفاد بمنطق","طوع المراد أمدّه استحضار",68,"ر",1,0],["وأجادَنا بمعارِفٍ وعوارِفٍ","حتَّى امتلا حزنُ الفضاءِ بغمضِهِ",69,"ض",2,0],["وَأَجادَ السُطورَ في صفحة الخد","دِ وَلِم لا يُجيدُ وَهوَ ابن مُقله",70,"ه",1,0],["وأجأر وقل أنافي جوار محمد","يا للرجال لعل رجلك ترسخ",71,"خ",1,0],["وأجادت تفصيل ما أجملوه","وجلت عن ضمائر مستكنه",72,"ن",2,0],["واجأر وقل أنت لي مجير","يوم رجائي سواك خابا",73,"ب",2,0],["وإجابة المكروب حين ندائه","وجلائل الرحمات للضعفاء",74,"ا",2,0],["وأجال رأيك في الإيالة منصفا","ترعى مصالحها وتجمع شملها",75,"ل",3,0],["وأجَابَ اسْتِدعَاهُ الشَّجَرُ المنقا","دُ طَوْعاً لمَّا أريد انْقِيادُه",76,"د",2,0],["وأجاب الإله فيك دئي","غافر الذنب سامع الأصوات",77,"ت",1,0],["وأجَارنا حينَ الجوارُ غنيمةٌ","ماضٍ على غلوائِه سَبَّاقُ",78,"ق",1,0],["وأَجاد تربك وابلٌ متعهِدٌ","من أَنْ تَروِّعه صباً وجنَوبُ",79,"ب",1,0],["وأجابته طيعاً بل وما اختل","نظام ولم يكن من فساد",80,"د",1,0],["وأُجالد القرمَ الكريمَ جَلاده","وأذِلهُّ وهو العزيزُ الأرْوَعُ",81,"ع",1,0],["وَأجَابَتهُ أمَّةٌ مَا طَ غَينَا","عَنهُمُ نُورُهُ بِهم قَرَّ عَينَا",82,"ن",2,0],["وأجاب مضطرا وأمن خائفا","وشفى بنظرته الكثير من العلل",83,"ل",1,0],["وأجاب دع عنك الملام وخلني","إن الملامة عندنا إغراء",84,"ا",2,0],["وأَجالَ في يُمنَاهُ أَعظَمَ عَاسِلٍ","بِقُوى المَعَاصِمِ دَارَ في راحاتِهِ",85,"ت",2,0],["وأجاج ملح به صار فى الحا","ل فراتا عذبا مروّى الظماء",86,"ا",2,0],["وأجابت الندوان داعيها إلى ال","ألحان والساقي بموعده وفا",87,"ف",2,0],["وأجاد في جودِ العواطف واللُهى","غنمت وبات الطرف منها قريرُ",88,"ر",1,0],["وأجابَ دعوتَك الكريمة كلُّ من","للخير واليسرى سعى أو يُسِّرا",89,"ر",2,0],["وآجالُنا في كلِ يومٍ وليلةٍ","الينا على غِرّاتِنا تتقَرَّبُ",90,"ب",1,0],["وأجافي كل أرباب الهوى","من يكن ما بي من العشق شعاره",91,"ر",2,0],["وأجابت وَلَها دمعٌ سجيمْ","فوق خدّ بِالبَهَا مزدَهِرِ",92,"ر",1,0],["وأجاب سائلَه إذا","ما جاءه مستفهما",93,"م",2,0],["وأجارني ..مِن هَوْلِ عافيةٍ بلا ..","حُبٍّ .. فلا أحياكَ مَن لا قَتَّلَكْ",94,"ك",1,0],["وأجاب بواني النبي منوا","أنا حلة حتى ابو ملحدي",95,"د",2,0],["واجأر إليه وناده متبتلا","فلعله يدنيك من عليائه",96,"ا",3,0],["واجانه الليل لاصوت اليهز الليل","ولا ريح الهوى ونلكه الخبر عنده",97,"د",2,0],["واجابتي نفسها يالليل وسدني","معصم سباتك وتقفللي ملفاتك",98,"ك",1,0],["وإجابة الشجار حين دعابها","تسعى إليه كأنهن الماء",99,"ا",2,0],["وأجاهدن عواذلي في حبه","بالمرهفات على من لحظاته",100,"ت",2,0],["وأجابني ماء ُ الفرات ِ ولونهُ","مِنْ حُرْقَة ِالعَتَبِ المريرِ دمائي",101,"ا",2,0],["واجّاذَبَتْ طرفَ الحديثِ بقولِها","الوصلُ سهلٌ والوصولُ مُتاحُ",102,"ح",1,1],["وأجابته أفراخ نور تداعت","جوف أوكار لها بالرنان",103,"ن",1,0],["وأجابوا دعوة الرجس قوم","أنكروا الحق لدى الامتحان",103,"ن",1,0],["وأجال في دنياه أعينَه","فتراءت الأقلام والورق .",104,"ق",1,0],["وَ اجَّاوَزَتنِي وَ المُنَى حُلُمٌ","فِي مُهجَتِي بِالمَكثِ يَشتَدُّ",105,"د",1,0],["وأجالده ووأجاهده","والذكر الدائم يحرسني",106,"ن",2,0],["وأجابني إن التراب ترابنا","والموت أشرف من سلاك لتربتي",107,"ت",2,0],["وأجاباك إذ دعوت بلبيكَ","كَ كَما قَدْ أجَبْتَ إذْ دَعَواكَا",108,"ك",2,0]]}