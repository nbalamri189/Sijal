{"poems":[[56,"تهتم علينا بأن الذئب كلمكم","https://www.aldiwan.net/poem27362.html","البسيط"],[53,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8499.html","البسيط"],[107,"أمم العروبة جاء يومك فاعلمي","https://www.aldiwan.net/poem41936.html","الكامل"],[107,"قصوا الحديث عن الفريق النائي","https://www.aldiwan.net/poem42116.html","الكامل"],[107,"يا أمة أودت بها الأحلام","https://www.aldiwan.net/poem43369.html","الكامل"],[107,"جاء الرسول كتابه بيمينه","https://www.aldiwan.net/poem44005.html","الكامل"],[48,"فرق بدا ومن الحوادث يفرق","https://www.aldiwan.net/poem23023.html","الكامل"],[96,"اتسألين عن الخمسين ؟","https://www.poetsgate.com/ViewPoem.aspx?id=15626",""],[189,"هذا الفراق وهذه الأظعان","https://www.aldiwan.net/poem14686.html","الكامل"],[216,"برق تبدى خفية بسناء","https://www.aldiwan.net/poem37922.html","الكامل"],[275,"سحرا مشى الفتيان مبتسمينا","https://www.aldiwan.net/poem35623.html","الكامل"],[435,"أضحى الهناء جميلا في تلاقينا","https://www.aldiwan.net/poem41417.html","البسيط"],[447,"الرزء أعظم أن تراق دموع","https://www.aldiwan.net/poem14460.html","الكامل"],[529,"هذا الحبيب وصفوة الجبار","https://www.aldiwan.net/poem13289.html","الكامل"],[534,"هذا السحاب وبرقه الخفاق","https://www.aldiwan.net/poem37304.html","الكامل"],[567,"ضاق السبيل على الباكي الحزين فلا","https://www.aldiwan.net/poem52765.html","البسيط"],[1217,"","https://poetry.dctabudhabi.ae/diwan/poem/143777","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77913","البسيط"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47117","الكامل"],[2360,"","https://poetry.dctabudhabi.ae/diwan/poem/119154","البسيط"],[2810,"","https://poetry.dctabudhabi.ae/diwan/poem/204027","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204870","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205083","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100758","الكامل"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87666","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89358","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108176","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205884",""],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133297","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90949","الكامل"],[4262,"","https://poetry.dctabudhabi.ae/diwan/poem/81927","الكامل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133147","الكامل"],[4755,"هذا السَّرَابُ القائِمُ القاعِدُ","https://www.poetsgate.com/ViewPoem.aspx?id=183630",""],[4755,"هذا السَّعِيدُ \"تَقَدَّسَتْ أَسماؤُهُ\"","https://www.poetsgate.com/ViewPoem.aspx?id=188670",""],[4858,"سلام الضعفاء","https://www.poetsgate.com/ViewPoem.aspx?id=34883",""],[4908,"إليها في غِيَابِها","https://www.poetsgate.com/ViewPoem.aspx?id=207383",""],[5038,"رذاذ القسطل","https://www.poetsgate.com/ViewPoem.aspx?id=189378",""],[3591,"هذا السّريّ إذا نظرت لوجهه","https://www.poetsgate.com/ViewPoem.aspx?id=149444",""],[5106,"يَا مِسْكَةَ العَرَبِ ..","https://www.poetsgate.com/ViewPoem.aspx?id=154846",""],[5150,"حب الجنوب ...!","https://www.poetsgate.com/ViewPoem.aspx?id=204038",""],[5285,"على بساط الأمل","https://www.poetsgate.com/ViewPoem.aspx?id=203535",""],[5493,"أعلام الفتح","https://www.poetsgate.com/ViewPoem.aspx?id=197086",""],[5517,"أشجار وراء السياج","https://www.poetsgate.com/ViewPoem.aspx?id=199054",""],[5790,"هزوا قدودهم ذوابل","https://www.poetsgate.com/ViewPoem.aspx?id=112123",""],[5848,"جهة خامسة للبكاء","https://www.poetsgate.com/ViewPoem.aspx?id=53190",""],[5848,"ممنوعة اللمس","https://www.poetsgate.com/ViewPoem.aspx?id=53359",""],[5848,"مولاتي","https://www.poetsgate.com/ViewPoem.aspx?id=50538",""],[5887,"أحيمد","https://www.poetsgate.com/ViewPoem.aspx?id=35261",""],[5906,"سُكَّر","https://www.poetsgate.com/ViewPoem.aspx?id=188224",""],[5956,"يا رحمة المولى على أنقى امرِئ","https://www.poetsgate.com/ViewPoem.aspx?id=183551",""],[5956,"كرّسْتَ وقتك من أجلي","https://www.poetsgate.com/ViewPoem.aspx?id=194263",""],[6301,"مبارك هذا النجاح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80679&r=&rc=43",""],[6302,"بَغدادْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86227&r=&rc=25",""]],"verses":[["هَذا السُنَيدِيُّ لا أَصلٌ وَلا طَرَفٌ","يُكَلِّمُ الفيلَ تَصعيداً وَتَصويبا",0,"ب",2,0],["هذا السِّنانُ مَنيكاً في استِه أبداً","وكم نَقيذٍ بهاديهِ ومُشتعِبِ",1,"ب",1,0],["هذا السَّبيلُ لِكُلِّ شعبٍ ماجدٍ","عالي اللِّواءِ إلى العُروبةِ ينتمي",2,"م",2,0],["هذا السّبيلُ فأين مُرتادُ الهُدَى","هذا الدواءُ فأين نِضوُ الدّاءِ",3,"ا",2,0],["هَذا السَبيلُ إِلى الحَياةِ وَهَذِهِ","سُنَنُ الهُدى لَو ترشدُ الأَفهامُ",4,"م",1,0],["هَذا السّبيلُ فأينَ يذهبُ من أبى","أوَ ليس نُور اللهِ قد كشفَ الدُّجَى",5,"ج",2,0],["هَذا السِفاهُ كَأَنَّنا حِمضيَّةٌ","أَو خَيطُ بِلِقعَةٍ غَذاهُ العِشرِقُ",6,"ق",1,0],["هذا السلاف أدام الله سكرته","من الشفاه البخيلات اعتصرناه",7,"ا",2,0],["هذا السَّقامُ على ضميرِك شاهد","عَدْلٌ فماذا ينفع الكتمان",8,"ن",1,0],["هذا السعيديّ الذي ملك الورى","طُرَّاً وَيَزْوي جودُه بالطَائي",9,"ا",2,0],["هذا السَّلامُ حواهُ شعرٌ خالدٌ","في الأرضِ لا يُفنيه ما يُفنينا",10,"ن",2,0],["هذا السني الذي حزنا الثناء به","وعمنا الفضل قاصينا ودانينا",11,"ن",2,0],["هذا السحاب بكى عليك بعبرة","للرعد فيه زماجر وبعيع",12,"ع",1,0],["هَذا السِّراج لمُهتد هَذا البَشي","ر لمقتد في عزلة مُتَواري",13,"ر",2,0],["هَذَا السَّحابُ وَبَرْقُهُ الْخَفَّاقُ","مِنْ نَحْوِ أَرْضِ شَهارَةٍ مُنْساقُ",14,"ق",1,1],["هذا السبيلُ الذي لا بُدَّ منهُ لنا","يوماً فنحنُ إليهِ نَقطعُ السُّبُلا",15,"ل",2,0],["هذا السويسي الذي","في وجهه من فيه دبر",16,"ر",1,0],["هَذا السَماع وَإِخوان الصفاء معاً","ذكر المهيمن فيهم ملء كل فم",17,"م",1,0],["هذا السّبيلُ وإن بَنَاهُ وزيرُه","فيه ومنه تَيَسَّرَ الإِمدَادُ",18,"د",1,0],["هذا السنيدي لا تخفى دمامته","يكلم الفيل تصعيداً وتصويبا",19,"ب",2,0],["هذا السنيديُّ ما ساوى إتاوته","يُكلمُ الفيلَ تصعيداً وتصويبا",20,"ب",2,0],["هذا السلاح الذي لا درع يمنعه","هذا المذّل لذي كبر وطغيان",21,"ن",1,0],["هذا السلاح لدينا كيف نهمله","ونلتجي لسلاح في الوغى ثان",21,"ن",1,0],["هذا السرير من الجماد وصلته","وأنا أخو الحسن الرقيق حرمتني",22,"ن",2,0],["هذا السريّ وذا الوجيه وآخر","رغم الضلال شريف بيت طاهر",23,"ر",1,0],["هذا السري ومعروفٌ وقطبهم","ابو يزيد وسهل مع جنيدهم",24,"م",1,0],["هَذا السَليمُ كما يسمىّ سالماً","مِمّا يُحاولُ حاسدوهُ والعدى",25,"د",2,0],["هذا السرور أضاء أم طفئ الحزنْ","شيخ مضى وأتى إمامٌ مؤتمنْ",26,"ن",1,1],["هذا السلام له لديَّ كرامةٌ","وأعده منه جميلاً يصنع",27,"ع",1,0],["هذا الستار فنحِّ جانبه","تجد القضاء يهيئ اللعبا",28,"ب",2,0],["هذا السباعي وابنه بحياله","أو ما ترى تلك البحور الزاخره",29,"ر",2,0],["هذا السفر جل بالغبار سترته","كي نكتفي لوم الرقيب إذا حضر",30,"ر",1,0],["هذا السلالة من نزار فمن","عرف الجميع فأنه الكلُّ",31,"ل",1,0],["هذا السبيل لكل حي ما ترى","ذا قوةٍ إلا وهي بكماله",32,"ل",2,0],["هذا السَّرَابُ القائِمُ القاعِدُ","ثَلاثَةٌ يا لَيلُ؟! أَم واحِدُ!",33,"د",1,1],["هذا السَّعِيدُ \"تَقَدَّسَتْ أَسماؤُهُ\"","هاجَتْ عَلَيهِ وقَرفَصَت ظَلْمَاؤُهُ",34,"ا",3,1],["هَذَا الّسلامُ الّذي تبغونَ يا عَربُ ؟","فلملموا الخزيَ حتىّ تنقضي الحقبُ",35,"ب",1,1],["هَذا السَّرِيرُ وذا الشُّبَّاكُ يَسْألني","يا سَاهرَ الليلِ أينَ الكَوْكَبُ السَّارِي؟",36,"ر",2,0],["هذا السخيُّ يحبّهُ اللهُ كما","أيْدي الْهدى تلْقاهُ يوم الْفيصلِ",37,"ل",1,0],["هذا السّريّ إذا نظرت لوجهه","ألفيت فيه كلّ خير يشرق",38,"ق",1,1],["هَذَاْ السَّمَيْذَعُ فَاْدٍ قَدْ أَنَاْخَ لَكُمْ","إِيْوَاْنَ كِسْرَىْ عَلَىْ الْأَقْدَاْمِ وَالرُّكَبِ",39,"ب",1,0],["هذا السلامُ سلامُ الذلِّ نرفضُهُ","كُلاً وجُزءاً ومجموعاً ومنفردا",40,"د",2,0],["هذا السبيلُ قصدتُه في رحلتي","ضاعَ السبيلُ وأُهملتْ ألحاني",41,"ن",2,0],["هذا السراج يضيء الكون من قبس","والنصر أعلامه رمز البشارات",42,"ت",1,0],["هذا السلاحُ القاتلي في(بصْرةٍ)","هو نفسهُ(بحماةَ) عبَّ دمائيا",43,"ي",2,0],["هذا السلاح سلاحهم","ومن الذي يقوى يقاتل",44,"ل",1,0],["هذا السهر إنشودته غنّت معي في كل بيت","ترقّص على شفّة دموعي من ورا خمس الجهات",45,"ت",1,0],["هذا السهر قاسي وصمته كوابيس","خليك قربي ننتظر مطلع الشمس",46,"س",1,0],["هذا السهر خنجرٍ يقتات من ضعفي","يطعن ويقتل معه بعض احتمالاتي",47,"ت",2,0],["هذا السبيل سبيل من طلب العلا","هذا السبيل سبيل مرشدنا الإمام",48,"م",1,0],["هذا السؤال ووجه لي","فأجبت بكلا .. لم أخبر",49,"ر",1,0],["هذا السُّمُوُّ العاطفيُّ المرتقي","لا ينتمي إلا إلى العربانِ",50,"ن",1,0],["هذا السمو العاطفي وجوده","بجزيرة العربان لا الأكوانِ",50,"ن",1,0],["هذا السمير رفيق الروح من قِدَم","مهما تأخر جِسْماناْ عن الرحمِ",51,"م",1,0],["هذا السَّبيلُ وقدْ خَبِرْتُمْ وَعْرهُ","إِذْ ما مُنِحْتِمْ نورَ علمٍ سرْمدِي",52,"د",2,0],["هذا السََّّبيلُ .. وما إليكِ سبيلُ","أَمّلتُ حتى ملَّني التأميلُ",53,"ل",1,1]]}