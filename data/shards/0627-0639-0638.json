[208,"أوميض برق بالحمى يتوهم","https://www.aldiwan.net/poem13505.html","الطويل"],[229,"شواهد قلب الصب لا تقبل الرشا","https://www.aldiwan.net/poem44563.html","الطويل"],[229,"سبح لربك في الظلام الداجي","https://www.aldiwan.net/poem44595.html","الكامل"],[268,"أدمشق ما أمضى سيوف بنيك","https://www.aldiwan.net/poem35644.html","الكامل"],[268,"أدمشق أين بنو أمية قولي","https://www.aldiwan.net/poem35651.html","الكامل"],[269,"كم ذا أراها نحو طيبة ترتمي","https://www.aldiwan.net/poem52047.html","الكامل"],[273,"عبر البحر يؤم الأبحرا","https://www.aldiwan.net/poem25568.html","الرمل"],[296,"إن كان باليمن هذا اليوم قد سنحا","https://www.aldiwan.net/poem36252.html","عموديه"],[296,"لله وللمثل الأعلى","https://www.aldiwan.net/poem36299.html","عموديه"],[296,"تحية طيبة","https://www.aldiwan.net/poem36305.html","عموديه"],[303,"برق به أفق الرجاء أنارا","https://www.aldiwan.net/poem56540.html","الكامل"],[351,"جلت لنا هذه الآداب والصور","https://www.aldiwan.net/poem40190.html","البسيط"],[351,"حيا الندامى بشمس الراح مصطبحا","https://www.aldiwan.net/poem40544.html","البسيط"],[388,"الحمدلله على ما أولى","https://www.aldiwan.net/poem54480.html","عموديه"],[399,"لولا ضني جسدي والمدمع الجاري","https://www.aldiwan.net/poem46918.html","البسيط"],[431,"كم كان فيها من كرام سادة","https://www.aldiwan.net/poem25692.html","الكامل"],[436,"شهدت لك الأعياد أنك عيدها","https://www.aldiwan.net/poem34893.html","الكامل"],[456,"هل لقتيل على اللوى ثائر","https://www.aldiwan.net/poem56169.html","المنسرح"],[477,"للّه بيتا بنيت فابشر","https://www.aldiwan.net/poem36892.html","مخلع البسيط"],[477,"رأت أقوامها اغتصبت بلادي","https://www.aldiwan.net/poem36904.html","الوافر"],[477,"كأس من الراح أم كأس من الأدب","https://www.aldiwan.net/poem36934.html","البسيط"],[477,"صبرا لحكمك صبرا","https://www.aldiwan.net/poem37050.html","المجتث"],[477,"أيقظ شعورك واطرح برقع الكسل","https://www.aldiwan.net/poem37601.html","البسيط"],[480,"يا واردا من ليلى قف متصاغيا","https://www.aldiwan.net/poem24336.html","عموديه"],[498,"قف بالركاب فهذه الأطلال","https://www.aldiwan.net/poem37628.html","الكامل"],[498,"بدر حسن راق العيون شهوده","https://www.aldiwan.net/poem38027.html","الخفيف"],[498,"ها أين يا ريح الصبا","https://www.aldiwan.net/poem38086.html","مجزوء الرجز"],[498,"سر بطريق الله حتى المنتهى","https://www.aldiwan.net/poem38094.html","الرجز"],[503,"ذو الأوتاد","https://www.aldiwan.net/poem27895.html","البسيط"],[522,"الله أكبر كم وافت بشارات","https://www.aldiwan.net/poem13287.html","البسيط"],[522,"في حسن مطلع أقمار بذي سلم","https://www.aldiwan.net/poem13294.html","البسيط"],[536,"شبل القساور من أبناء مزوار","https://www.aldiwan.net/poem48190.html","عموديه"],[560,"عندنا في مدينة الشمس برج","https://www.aldiwan.net/poem52726.html","الخفيف"]],"verses":[["أَعظَمتُمُ حَسَبي وَلَمّا تَحفِلوا","ما رَثَّ مِن سَلَبي وَلا أَطماري",0,"ي",1,0],["أَعظِم بِأُسطولِ الهَوا","ءِ إِذِ اِنبَرى فَسَطا وَشَدّا",1,"د",2,0],["أُعَظِّمُهُ مِمّا أَرى مِن جَمالِهِ","كَما عَظَّمَ القِسيسُ عيسى بنَ مَريَما",2,"م",2,0],["أَعْظِمْ بِلُطْفِ اللهِ عَوْناً عَلَى","صِيَانَةِ البَائِسَةِ القَاصِرَهْ",3,"ر",2,0],["أَعْظِمْ بِخُطَّتِهَا الحَمِيدَةِ قُدْوَةً","لِمَنِ اشْتَرَى خُلْداً بِعُمْرِ فَانِ",4,"ن",1,0],["أَعْظِمْ بِخَطْبِكَ فِي البِلادِ وَإِنَّمَا","عِظَمُ المُصاَبِ يُقَاسُ بِالحِرْمَانِ",5,"ن",1,0],["أَعْظِمْ بِحَرْقَةِ أَهْلِهِ وَبِلادِهِ","إِذْ كَانَ مَرجُوّاً لِكُلِّ عَظِيمِ",6,"م",1,0],["أَعْظِمْ بِهَذَا البَطْرِيَرْكِ المُجْتَبَى","مِنْ سَيِّدٍ عَالِي الْجَنَابِ مُعَظَّمِ",7,"م",1,0],["أَعْظِمْ بِمَا لَكَ مِنْ أَيَادٍ فِي الحِمَى","عَمَّتْ وَلَمْ تَخْصُصْ بِهَا إِقْلِيمَا",8,"م",2,0],["أَعْظِمْ بِهِ إِذْ تَوَلَّى الأَمْرَ أَجْمَعُهُ","وَرَأْيُهُ فِيهِ مَاضٍ مَا بِهِ ثُلَمُ",9,"م",1,0],["أعظم به طود مجد طال طائله","فكيف في ساعة بالموت فد نسفا",10,"ف",2,0],["أعظم برزئك في الأيام من حدَث","هزّت عليّ به الأيام عسّالا",11,"ل",2,0],["أعظم بها من مساعٍ عنك سائرةً","فقد سلكت طريقاً غير ذي عوج",12,"ج",1,0],["أعظم بها من حكمةٍ محجوبةٍ","ما للتعمُّق نحوها إيضاح",13,"ح",1,0],["أعظمْ به من حجرٍ للهدى","كأنَّه خالٌ على خده",14,"د",2,0],["أعظم به تاجاً لعليائهِ","يعطف ردّ المدح عطف النسق",15,"ق",1,0],["أعظمْ بهاتيك اليراعة إنها","حصنٌ لأقطار البلاد حصين",16,"ن",1,0],["أعظمنه فدعونه","ربّاً وإن صحَّفنه",17,"ن",2,0],["أُعَظِّم شأَن أبيات أتتني","وأهداها إليّ أخ حميمُ",18,"م",1,1],["أَعظُمُ اللَيثِ تَلقاها الشَرى","وَرُفاتُ النَسرِ حازَتهُ الوُكون",19,"ن",1,0],["أَعظِم بِهِم مِن آسِري","نَ وَبِالخَليفَةِ مِن أَسير",20,"ر",1,0],["أَعظَمُ الرُزءِ أَن تُقَدَّمَ قَبلي","وَمِنَ الرُزءِ أَن تُؤَخَّرَ بَعدي",21,"د",2,0],["أَعظَموا المَسجِدَ الجَديدَ فَأَبدوا","وَأَعادوا في الشُكرِ عَنهُ المُذاعِ",22,"ع",1,0],["أَعظِم بِمَقدَمِهِ فَخراً وَمَنقبَةً","لِمَعشَرِ الأَوسِ وَالأَحياءِ مِن جُشَمِ",23,"م",1,0],["أعظمُ ذنبي عندَهُ ووزري","أني مذكورٌ بكلِّ قطر",24,"ر",1,0],["أعظمُ الآثامِ في شِرعتها","وطنٌ يُغزَى وشعبٌ يُلتَهمْ",25,"م",1,0],["أعظِمْ بها آيةً لولا جَهالَتُكُمْ","كانت لخيرِ البرايا خيرَ مِصدَاقِ",26,"ق",1,0],["أَعظم به من مشهد","جمع البغام إلى الزَئير",27,"ر",1,0],["أعظِمْ بتاجكَ جوهراً لم يحوهِ","كنزٌ ولم يحرزْ جُلاهُ مِنجَمُ",28,"م",1,0],["أًعْظِمْ بِعَبدِ اللهِ نَجلاً صَالِحاً","يَقفُو أَبَاهُ حِجىً وَحُسْنَ بَلاَءِ",29,"ا",2,0],["أَعْظِمْ بِمَا بَلَّغْتَ مِصْرَكَ","فِي الْيَسِيرِ مِنَ الأَوَانِ",30,"ن",1,0],["أَعْظِمْ بِهِ فِي كُلِّ عَاديَةٍ عَدَتْ","مِنْ أَرْيَحِيّ لِلْبِلاَدِ ثِمَالِ",31,"ل",1,0],["أَعْظِمُ بِيَوْمِك فِي الزَّمَانِ وَمَنْ لَهُ","بِكَ واصِفاً ذَاكَ الجلاَلَ فَيُوصَفا",32,"ف",2,0],["أَعْظِمْ بِهَا فِي ذلِكَ الْجِ","سْمِ الصَّغِيرِ الأَضْرَعِ",33,"ع",1,0],["أَعْظِمْ بِمَا خَلَّفْتَ فِي الجِيلِ الَّذي","عَايَشْتَهُ مِنْ خَالِد الأَيادي",34,"د",2,0],["أَعْظِمْ بِخِدْمَتِكُمْ لِشَعْبٍ عَاثِرٍ","مُسْتَصْرِخٍ لِسَوَادِهِ المَنْكُوبِ",35,"ب",1,0],["أَعْظِمْ بِشَوْقِي ذَائِداً عَنْ قَوْمِهِ","وَبِلاَدِهِ فِي الأَزْمَةِ النَّكْرَاءِ",36,"ا",2,0],["أَعْظِمْ بِهذا الحَفْلِ فِيهِ وَكُلُّهُ","مِنْ صَفْوَةِ الوُزَرَاءِ وَالأقْيَالِ",37,"ل",1,0],["أَعْظِمْ بِهِ فِي الحَرْبِ مِنْ قائِدٍ","يَفْتُكُ بِالرَّأْيِ وَبِالمُنْصَل",38,"ل",1,0],["أَعْظِمْ بِمِصْرٍ حُرَّةً قَدْ جَدَّدَتْ","غُرَراً لِسَابِقِ مَجْدِهَا وَحُجُولاَ",39,"ل",2,0],["أَعْظمْتُ هَمَّكَ وَالمَعَالِي","وَاقِعَاتٌ دُونَ قَصْدِكْ",40,"ك",1,0],["أَعْظِمْ بِهِ مِنْ سَيَّدٍ مُكَمَّلٍ","حِسّاً وَمَعْنّى أَلْطَفَ التَّكْمِيلِ",41,"ل",1,0],["أَعْظِمْ بِمَا تَبْغِي وَكُلُّ عَظِيمَةٍ","إِنْ تَبْغِها بِالصِّدْقِ لَمْ تتَعَذَّرِ",42,"ر",1,0],["أَعْظِمْ بِآياتِ الهَوَى إِذْ يَرْتَقِي","مُتجَرِّداً كَالجَوهَرِ الوضَّاءِ",43,"ا",2,0],["أعظَمُ الرُّزْءِ أنْ تُقَدَّمَ عِندِي،","وَمِنَ الرزء أنْ تُؤخَّرَ بَعْدِي",44,"د",2,0],["أعظَمْنَه فدعونه","رِيا وإن صَحَّفْنه",45,"ن",2,0],["أَعظِم بِها كُتُباً جاءَتكَ حائِزَةً","مَناقِباً كَثَّرَت ما حازَتِ الكُتَبُ",46,"ب",1,0],["أَعظِم بِهِ حَدَثاً أَفضى إِلى جَدَثٍ","عَرّى القُلوبَ مِنَ الأَوجالِ حينَ عَرا",47,"ر",2,0],["أعظمُ من هذا وذا أنّني","أعطي خراجي من صحاح الحلق",48,"ق",1,0],["أَعظمُ النعمةِ أنّي صبّهُ","دائِماً أحمده أشكرهُ",49,"ه",1,0],["أَعظمُ كلّ العالمينَ هِمَما","محمّدُ المؤيِّدُ المؤيّدُ",50,"د",1,0],["أَعظَموا الأمرَ وهو فعلُ عظيمٍ","لَم تُشابه صفاته العظماءُ",51,"ا",2,0],["اعظم بها في وصف حسنك مدجة","فلقدرك العالي اجل واعظم",52,"م",1,0],["أعظم أخفافا كرائم ترتمي","إلى الفاتح الختام أكرم من مشى",53,"ش",2,0],["أعظم بها آياتٌ انقطعت بها","أسباب كل معاند محجاج",54,"ج",1,0],["أعظِم بمجدٍ تُطلِعينَ نجومَهُ","والكونُ عَرشُكِ والورى راويك",55,"ك",1,0],["أعظِم بقوّادٍ كآسادِ الشرى","فلّوا جيوشاً أدبرت بفلول",56,"ل",1,0],["أعظم به يوم القيامة انه","أَهل الشَفاعة عند أَعظم أَعظم",57,"م",1,0],["أعْظَمُ الأمّةِ وِزْراً نَاكِبٌ","عنهُمُ لَم يَعتَمِدْهم وَزَرا",58,"ر",2,0],["أعظمْ بهم سلفاً وَأعجبْ له خلفاً","للذل والهونِ من بعد العلى جنحا",59,"ح",2,0],["أَعظمْ (بأُميَّة) إِذْ فتحتْ","بالسيفِ الدنيا والقلم",60,"م",1,0],["أَعظمْ بها مليكةً","أَعدلْ بها وَأَحبب",61,"ب",1,0],["أَعظِم به دونَ الخليفةِ باذلاً","نَفسَ الغيورِ غدا يحوطُ ذِمارا",62,"ر",2,0],["أَعظم بِفَضل مُشير دون غايَتِهِ","زهر الكَواكب مِنها الشَمس وَالقَمَرُ",63,"ر",1,0],["أَعظم بِبأس مشيرٍ لَو أَشار إلى","مُطهّمِ الفلك الدوّار ما جمَحا",64,"ح",2,0],["أعظم بهم ومحبيهم وصاحبهم","ذا النص ليس بتخمين وحسبان",65,"ن",1,0],["اعظم به من بلاد فيه كم نزلت","آي من الله يتلوها بقرآن",65,"ن",1,0],["اعظِمْ به من قدومٍ قد هزمتَ به","عن قلب كلّ محبّ جيشَ أكدارِ",66,"ر",1,0],["أَعْظِمْ بِتِلْكَ مُصيبَةً ما تَنْجَلي","حَسَراتُها أَوْ يَنْقضي المَلَوانِ",67,"ن",1,0],["أعظِم بِهَا نِعَماً وَفيتَ بشُكْرها","فَوَليُّ عهدِ المسلمينَ مزيدُها",68,"د",3,0],["أُعظمها عن سواك أنك لل","أموال فيها مستصغِرٌ حاقرْ",69,"ر",1,0],["أعظم بمسجدك المعلى","يدعولك الركن والحطيم",70,"م",1,0],["أعظم شأنها حين اقترابي","وأحفظ عهدها حين ابتعادي",71,"ي",1,0],["أعظم به الأدب المحجوب من سبب","يدني الزميلين بل ناهيك من سبب",72,"ب",1,0],["أعظم لرزئه رزءا","مذ غاله الموت غدرا",73,"ر",2,0],["أعظم به أي مشروع يمائله","من المشاريع في الأقطار والملل",74,"ل",1,0],["أعظم به رزءا أتاح مصائبا","فت القلوب ووشاح",75,"ح",1,0],["اعظم به رجلاً علا متواضعاً","ويقال ما كلُّ الرجال رجال",76,"ل",1,0],["أَعظَمَتْهُ الأَقْطابُ جيلاً فجيلاً","وعَلَتْ قمَّةَ الفَخارِ سُعُودُهْ",77,"د",2,0],["أَعظَمْتُهُمْ أَجلَلْتُهُمْ","كاتَمْتُ في الرُّقَبَا",78,"ب",2,0],["أعظِمْ شُؤُنَ الصَّحبِ طُرًّا إنَّهم","أَئمَّةٌ والكُلُّ منهم مُقْتَدَى",79,"ا",1,0],["أعظمْ بهِ فارساً ما من خزعبلةٍ","إلا وصيّره من بثّها البَطلا!",80,"ل",2,0],["أَعظم بِها لَيلة جَلت بَدائعها","وَأفصحت بِالهَنا فيها الجمادات",81,"ت",1,0],["أَعظِم بِهِ مِن نَبيّ مُرسل نَزلت","في مَدحِهِ مُحكَمُ الآياتِ مِن حِكَمِ",82,"م",1,0],["أَعظِم بِهِ مِن نَبيّ سَيّد سَنَد","هادٍ سِراج مُنير صَفوَةِ القُدُمِ",82,"م",1,0],["أعظِم به سيِّداً لاحت سِيادَتُه","فَطبَّقَ الذِّكرُ منه كلَّ أقطار",83,"ر",1,0],["أعظَمُ المُعجزاتِ أيسَرُ شيءٍ","منهُ باعُ المُلوكِ عنهُ قصيرُ",84,"ر",1,0]]}