الوطني88","https://www.poetsgate.com/ViewPoem.aspx?id=199938",""],[402,"اليوم عيد البائس المتألم","https://www.poetsgate.com/ViewPoem.aspx?id=36427",""],[402,"باليمن قد آنست يا سيدي","https://www.poetsgate.com/ViewPoem.aspx?id=36255",""],[402,"ألشرق طال سباته الروحاني","https://www.poetsgate.com/ViewPoem.aspx?id=36487",""],[5830,"كَتبْتُ شِعْرِيَ","https://www.poetsgate.com/ViewPoem.aspx?id=201124",""],[5956,"لو أتى السيّاف","https://www.poetsgate.com/ViewPoem.aspx?id=182114",""],[6142,"مذ صلصل الله من طين خليقته","https://www.poetsgate.com/ViewPoem.aspx?id=155709",""],[6142,"يا آية الله هل إلاك من أحدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=155713",""],[5309,"أعظم الناس من يبوح بعاره","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573851",""],[463,"هلْ لقتيلٍ على اللِّوى ثائرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60089&r=&rc=145",""]],"verses":[["أَعظَمتُمُ حَسَبي وَلَمّا تَحفِلوا","ما رَثَّ مِن سَلَبي وَلا أَطماري",0,"ر",2,0],["أَعظِم بِأُسطولِ الهَوا","ءِ إِذِ اِنبَرى فَسَطا وَشَدّا",1,"د",2,0],["أُعَظِّمُهُ مِمّا أَرى مِن جَمالِهِ","كَما عَظَّمَ القِسيسُ عيسى بنَ مَريَما",2,"م",2,0],["أَعْظِمْ بِلُطْفِ اللهِ عَوْناً عَلَى","صِيَانَةِ البَائِسَةِ القَاصِرَهْ",3,"ر",2,0],["أَعْظِمْ بِخُطَّتِهَا الحَمِيدَةِ قُدْوَةً","لِمَنِ اشْتَرَى خُلْداً بِعُمْرِ فَانِ",4,"ن",1,0],["أَعْظِمْ بِخَطْبِكَ فِي البِلادِ وَإِنَّمَا","عِظَمُ المُصاَبِ يُقَاسُ بِالحِرْمَانِ",5,"ن",1,0],["أَعْظِمْ بِحَرْقَةِ أَهْلِهِ وَبِلادِهِ","إِذْ كَانَ مَرجُوّاً لِكُلِّ عَظِيمِ",6,"م",1,0],["أَعْظِمْ بِهَذَا البَطْرِيَرْكِ المُجْتَبَى","مِنْ سَيِّدٍ عَالِي الْجَنَابِ مُعَظَّمِ",7,"م",1,0],["أَعْظِمْ بِمَا لَكَ مِنْ أَيَادٍ فِي الحِمَى","عَمَّتْ وَلَمْ تَخْصُصْ بِهَا إِقْلِيمَا",8,"م",2,0],["أَعْظِمْ بِهِ إِذْ تَوَلَّى الأَمْرَ أَجْمَعُهُ","وَرَأْيُهُ فِيهِ مَاضٍ مَا بِهِ ثُلَمُ",9,"م",1,0],["أعظم به طود مجد طال طائله","فكيف في ساعة بالموت فد نسفا",10,"ف",2,0],["أعظم برزئك في الأيام من حدَث","هزّت عليّ به الأيام عسّالا",11,"ل",2,0],["أعظم بها من مساعٍ عنك سائرةً","فقد سلكت طريقاً غير ذي عوج",12,"ج",1,0],["أعظم بها من حكمةٍ محجوبةٍ","ما للتعمُّق نحوها إيضاح",13,"ح",1,0],["أعظمْ به من حجرٍ للهدى","كأنَّه خالٌ على خده",14,"د",2,0],["أعظم به تاجاً لعليائهِ","يعطف ردّ المدح عطف النسق",15,"ق",1,0],["أعظمْ بهاتيك اليراعة إنها","حصنٌ لأقطار البلاد حصين",16,"ن",1,0],["أعظمنه فدعونه","ربّاً وإن صحَّفنه",17,"ن",2,0],["أُعَظِّم شأَن أبيات أتتني","وأهداها إليّ أخ حميمُ",18,"م",1,1],["أَعظُمُ اللَيثِ تَلقاها الشَرى","وَرُفاتُ النَسرِ حازَتهُ الوُكون",19,"ن",1,0],["أَعظِم بِهِم مِن آسِري","نَ وَبِالخَليفَةِ مِن أَسير",20,"ر",1,0],["أَعظَمُ الرُزءِ أَن تُقَدَّمَ قَبلي","وَمِنَ الرُزءِ أَن تُؤَخَّرَ بَعدي",21,"د",2,0],["أَعظَموا المَسجِدَ الجَديدَ فَأَبدوا","وَأَعادوا في الشُكرِ عَنهُ المُذاعِ",22,"ع",1,0],["أَعظِم بِمَقدَمِهِ فَخراً وَمَنقبَةً","لِمَعشَرِ الأَوسِ وَالأَحياءِ مِن جُشَمِ",23,"م",1,0],["أعظمُ ذنبي عندَهُ ووزري","أني مذكورٌ بكلِّ قطر",24,"ر",1,0],["أعظمُ الآثامِ في شِرعتها","وطنٌ يُغزَى وشعبٌ يُلتَهمْ",25,"م",1,0],["أعظِمْ بها آيةً لولا جَهالَتُكُمْ","كانت لخيرِ البرايا خيرَ مِصدَاقِ",26,"ق",1,0],["أَعظم به من مشهد","جمع البغام إلى الزَئير",27,"ر",1,0],["أعظِمْ بتاجكَ جوهراً لم يحوهِ","كنزٌ ولم يحرزْ جُلاهُ مِنجَمُ",28,"م",1,0],["أًعْظِمْ بِعَبدِ اللهِ نَجلاً صَالِحاً","يَقفُو أَبَاهُ حِجىً وَحُسْنَ بَلاَءِ",29,"ا",2,0],["أَعْظِمْ بِمَا بَلَّغْتَ مِصْرَكَ","فِي الْيَسِيرِ مِنَ الأَوَانِ",30,"ن",1,0],["أَعْظِمْ بِهِ فِي كُلِّ عَاديَةٍ عَدَتْ","مِنْ أَرْيَحِيّ لِلْبِلاَدِ ثِمَالِ",31,"ل",1,0],["أَعْظِمُ بِيَوْمِك فِي الزَّمَانِ وَمَنْ لَهُ","بِكَ واصِفاً ذَاكَ الجلاَلَ فَيُوصَفا",32,"ف",2,0],["أَعْظِمْ بِهَا فِي ذلِكَ الْجِ","سْمِ الصَّغِيرِ الأَضْرَعِ",33,"ع",1,0],["أَعْظِمْ بِمَا خَلَّفْتَ فِي الجِيلِ الَّذي","عَايَشْتَهُ مِنْ خَالِد الأَيادي",34,"د",2,0],["أَعْظِمْ بِخِدْمَتِكُمْ لِشَعْبٍ عَاثِرٍ","مُسْتَصْرِخٍ لِسَوَادِهِ المَنْكُوبِ",35,"ب",1,0],["أَعْظِمْ بِشَوْقِي ذَائِداً عَنْ قَوْمِهِ","وَبِلاَدِهِ فِي الأَزْمَةِ النَّكْرَاءِ",36,"ا",2,0],["أَعْظِمْ بِهذا الحَفْلِ فِيهِ وَكُلُّهُ","مِنْ صَفْوَةِ الوُزَرَاءِ وَالأقْيَالِ",37,"ل",1,0],["أَعْظِمْ بِهِ فِي الحَرْبِ مِنْ قائِدٍ","يَفْتُكُ بِالرَّأْيِ وَبِالمُنْصَل",38,"ل",1,0],["أَعْظِمْ بِمِصْرٍ حُرَّةً قَدْ جَدَّدَتْ","غُرَراً لِسَابِقِ مَجْدِهَا وَحُجُولاَ",39,"ل",2,0],["أَعْظمْتُ هَمَّكَ وَالمَعَالِي","وَاقِعَاتٌ دُونَ قَصْدِكْ",40,"ك",1,0],["أَعْظِمْ بِهِ مِنْ سَيَّدٍ مُكَمَّلٍ","حِسّاً وَمَعْنّى أَلْطَفَ التَّكْمِيلِ",41,"ل",1,0],["أَعْظِمْ بِمَا تَبْغِي وَكُلُّ عَظِيمَةٍ","إِنْ تَبْغِها بِالصِّدْقِ لَمْ تتَعَذَّرِ",42,"ر",1,0],["أَعْظِمْ بِآياتِ الهَوَى إِذْ يَرْتَقِي","مُتجَرِّداً كَالجَوهَرِ الوضَّاءِ",43,"ا",2,0],["أعظم باملاك باردية المج","رة طنبت بالمكرمات خيامها",44,"م",3,0],["أعظمتها يوم أهل الدار ترفعها","واليوم ترمي كرمي العفر والبقر",45,"ر",1,0],["أعظِمْ بتاجِكَ جوهرًا لم يحوِهِ","كَنْزٌ ولم يحرِزْ حُلاهُ مِنْجَمُ",46,"م",1,0],["أعظَمُ الرُّزْءِ أنْ تُقَدَّمَ عِندِي،","وَمِنَ الرزء أنْ تُؤخَّرَ بَعْدِي",47,"د",2,0],["أعظَمْنَه فدعونه","رِيا وإن صَحَّفْنه",48,"ن",2,0],["أَعظِم بِها كُتُباً جاءَتكَ حائِزَةً","مَناقِباً كَثَّرَت ما حازَتِ الكُتَبُ",49,"ب",1,0],["أَعظِم بِهِ حَدَثاً أَفضى إِلى جَدَثٍ","عَرّى القُلوبَ مِنَ الأَوجالِ حينَ عَرا",50,"ر",2,0],["أعظمُ من هذا وذا أنّني","أعطي خراجي من صحاح الحلق",51,"ق",1,0],["أَعظمُ النعمةِ أنّي صبّهُ","دائِماً أحمده أشكرهُ",52,"ه",1,0],["أَعظمُ كلّ العالمينَ هِمَما","محمّدُ المؤيِّدُ المؤيّدُ",53,"د",1,0],["أَعظَموا الأمرَ وهو فعلُ عظيمٍ","لَم تُشابه صفاته العظماءُ",54,"ا",2,0],["اعظم بها في وصف حسنك مدجة","فلقدرك العالي اجل واعظم",55,"م",1,0],["أعظم أخفافا كرائم ترتمي","إلى الفاتح الختام أكرم من مشى",56,"ش",2,0],["أعظم بها آياتٌ انقطعت بها","أسباب كل معاند محجاج",57,"ج",1,0],["أعظِم بمجدٍ تُطلِعينَ نجومَهُ","والكونُ عَرشُكِ والورى راويك",58,"ك",1,0],["أعظِم بقوّادٍ كآسادِ الشرى","فلّوا جيوشاً أدبرت بفلول",59,"ل",1,0],["أعظم به يوم القيامة انه","أَهل الشَفاعة عند أَعظم أَعظم",60,"م",1,0],["أعْظَمُ الأمّةِ وِزْراً نَاكِبٌ","عنهُمُ لَم يَعتَمِدْهم وَزَرا",61,"ر",2,0],["أعظمْ بهم سلفاً وَأعجبْ له خلفاً","للذل والهونِ من بعد العلى جنحا",62,"ح",2,0],["أَعظمْ (بأُميَّة) إِذْ فتحتْ","بالسي