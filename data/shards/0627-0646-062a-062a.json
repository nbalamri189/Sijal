{"poems":[[86,"أيهذا الثرى إلام التمادي","https://www.aldiwan.net/poem10499.html","الخفيف"],[93,"تكتب يومياتها عادله","https://www.aldiwan.net/poem11125.html","السريع"],[93,"أنت تبغي السيرا","https://www.aldiwan.net/poem11269.html","مجزوء الرمل"],[93,"في أي جو بالأسى مفعم","https://www.aldiwan.net/poem11348.html","السريع"],[93,"يا أميراً به خبرت سمواً","https://www.aldiwan.net/poem11422.html","الخفيف"],[88,"أيها الناظر ذا الفقر","https://www.aldiwan.net/poem45076.html","مجزوء الرمل"],[23,"والله ربي لا نفارق ماجدا","https://www.aldiwan.net/poem21417.html","الكامل"],[72,"جاءت العاذلات شيئا فريا","https://www.aldiwan.net/poem20564.html","الخفيف"],[51,"أنت تيس والتيس أش","https://www.aldiwan.net/poem8717.html","مجزوء الخفيف"],[51,"قل لنجح أخطأت باب النجاح","https://www.aldiwan.net/poem9402.html","الخفيف"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[92,"أنت كالزهرة الجميلة في الغاب","https://www.aldiwan.net/poem38949.html","الخفيف"],[92,"عذبة أنت كالطفولة كالأح","https://www.aldiwan.net/poem38954.html","الخفيف"],[85,"يحكون أن أمة الأرانب","https://www.aldiwan.net/poem8038.html","الرجز"],[85,"أمن البحر صائغ عبقري","https://www.aldiwan.net/poem8086.html","الخفيف"],[45,"عند ظباء الرمل أو عينه","https://www.aldiwan.net/poem66816.html","السريع"],[66,"فلتة كان منك عن غير قصد","https://www.aldiwan.net/poem40442.html","الخفيف"],[97,"أحسد الشيب على رأسك","https://www.aldiwan.net/poem24404.html","مجزوء الرمل"],[80,"للأقاحي بفيك نور ونور","https://www.aldiwan.net/poem31434.html","الخفيف"],[44,"إن حزني عليك ليس عليكا","https://www.aldiwan.net/poem30190.html","الخفيف"],[81,"كيف أصغي للعاذلين","https://www.aldiwan.net/poem61482.html","مجزوء الخفيف"],[67,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[46,"ما وقع التقصير في لفظنا","https://www.aldiwan.net/poem23491.html","السريع"],[46,"إن شئتما أن تنسكا فاسكنا","https://www.aldiwan.net/poem23553.html","السريع"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85607","الخفيف"],[92,"","https://poetry.dctabudhabi.ae/diwan/poem/66003","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54705","البسيط"],[106,"إلى مجلس الأمن","https://www.poetsgate.com/ViewPoem.aspx?id=179350",""],[100,"نصيحة سيئة","https://www.poetsgate.com/ViewPoem.aspx?id=50448",""],[90,"عدِّ عنك الكؤوس","https://www.poetsgate.com/ViewPoem.aspx?id=179009",""],[90,"عريانة!","https://www.poetsgate.com/ViewPoem.aspx?id=179125",""],[51,"يا لائمي في الرَّاح غيرَ مُقَصِّرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=27408",""],[89,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[138,"أم سلام لو لقيت من الوجد","https://www.aldiwan.net/poem67967.html","الخفيف"],[161,"ما جود راحتيك والأنواء","https://www.aldiwan.net/poem58975.html","الرجز"],[198,"أي وعينيك فاض كأس غرامي","https://www.aldiwan.net/poem39807.html","الخفيف"],[200,"إن تجد قلبا كقلبي","https://www.aldiwan.net/poem45212.html","مجزوء الرمل"],[205,"شاقني الأهل لم تشقني الديار","https://www.aldiwan.net/poem53085.html","الخفيف"],[205,"أنا أفديك من ملول أَلوف","https://www.aldiwan.net/poem53242.html","الخفيف"],[212,"كاتب سوف يفوق الكاتبين","https://www.aldiwan.net/poem46288.html","الرمل"],[224,"يا ملاك الماضي ورمز فؤادي","https://www.aldiwan.net/poem41873.html","الخفيف"],[226,"إن ما بت تشتكي منه داء","https://www.aldiwan.net/poem55207.html","الخفيف"],[236,"ياسمي النبي يا ابن علي","https://www.aldiwan.net/poem31970.html","الخفيف"],[242,"أيها الفاتك الأثيم رويدا","https://www.aldiwan.net/poem45755.html","الخفيف"],[251,"ما بال قوادي وعلقي","https://www.aldiwan.net/poem15002.html","مجزوء الكامل"],[257,"يا بان بشر يا سيدي يا ابن بشر","https://www.aldiwan.net/poem48484.html","الخفيف"],[257,"سيدي شكرك عندي","https://www.aldiwan.net/poem48577.html","مجزوء الرمل"],[298,"نفحتنا بنشرها المستطاب","https://www.aldiwan.net/poem33332.html","الخفيف"],[305,"كم بقلبي فيك من شجن","https://www.aldiwan.net/poem16838.html","المديد"],[305,"يا وجيه الدين والكرم","https://www.aldiwan.net/poem16840.html","المديد"],[321,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[329,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[354,"من لصب صبا المعاهد أشجاه","https://www.aldiwan.net/poem40001.html","الخفيف"],[365,"أبقيت بالجزع ما أبليت من طلل","https://www.aldiwan.net/poem60678.html","البسيط"],[372,"من لطول الهم والحزن","https://www.aldiwan.net/poem57098.html","المديد"],[404,"قد عجزنا عن شكرنا لامتنانك","https://www.aldiwan.net/poem33402.html","الخفيف"],[404,"كم أقاسي في الهوى من شغل","https://www.aldiwan.net/poem33482.html","الرمل"],[410,"وافى كتابك مفتوحا فبشرني","https://www.aldiwan.net/poem32255.html","البسيط"],[417,"يا سيد السادات من هاشم","https://www.aldiwan.net/poem53871.html","السريع"],[440,"فكأن من حاني السحائب جودها","https://www.aldiwan.net/poem34842.html","الكامل"],[453,"يا رخيم الدلال يا أتلع الجي","https://www.aldiwan.net/poem13948.html","الخفيف"],[466,"الموجعة","https://www.aldiwan.net/poem59030.html","عموديه"],[469,"أيها اللائم لي في حب من","https://www.aldiwan.net/poem59535.html","الرمل"],[516,"لا وعيون لحظها ساهر","https://www.aldiwan.net/poem12116.html","السريع"],[516,"بات يرعى السها بطرف مؤرق","https://www.aldiwan.net/poem12185.html","الخفيف"],[542,"لم يبق يا ويحكُم إلا تلاقيها","https://www.aldiwan.net/poem676.html",""],[552,"ما أرادت إلا الجفاء ظلوم","https://www.aldiwan.net/poem47245.html","الخفيف"],[552,"قل لمن كلما سبقت إلى العلياء","https://www.aldiwan.net/poem47730.html","الخفيف"],[552,"يا مليك الورى ومن عقد الله","https://www.aldiwan.net/poem48114.html","الطويل"],[554,"أنت تفسو إذا نطقت ومن سبح","https://www.aldiwan.net/poem68316.html","الخفيف"],[559,"عالم النطق عالم الأنفاس","https://www.aldiwan.net/poem34442.html","الخفيف"],[576,"كل خطب إذا تخطاك عمدا","https://www.aldiwan.net/poem2785.html","الخفيف"]],"verses":[["أَنتَ تَروى مِن مَدمَعٍ كُلَّ يَومٍ","وَتُغَذّى مِن هَذِهِ الأَجسادِ",0,"د",1,0],["إِنْ تَتَكَلَّمْ فَهْيَ مَجْهُودَةٌ","أَوْ تَتَحَرَّكْ فَهْيَ مُثَّاقِلَهْ",1,"ل",2,0],["أَنْتَ تَبْغِي السِّيَرَا","شَاغِلاً عَمَّا تَرَى",2,"ر",2,1],["إِنْ تَتَبَيَّنْ كُنْهَهُ لَمْ تَجِدْ","أَمْثَالَ ذَاكَ الْكَنْزِ فِي مَنْجَمِ",3,"م",1,0],["أَنْتَ تُعْطِي حَقِيقَةَ العَيْشِ مَعْنىً","قَصُرَتْ دُونَهُ مَعَانِي الخَيَالِ",4,"ل",1,0],["أنت تغدو بكساء","وهو من غير كساء",5,"ا",2,0],["إِن تَترُكوهُ فَإِنَّ رَبّي قادِرٌ","أَمسى يَعودُ بِفَضلِهِ العَوّادِ",6,"د",1,0],["أنتَ ترعى الأمور والله يرعا","كَ فلا زلت راعياً مرعيّا",7,"ي",2,0],["أنت تيسٌ والتيسُ أش","بهُ شيءٍ بخِلْقَتِكْ",8,"ك",1,1],["أنت تُهْدِي وتِلْكَ تُهْدي هَدَايَا","كَ إلى كل أيِّرٍ نَكَّاحِ",9,"ح",1,0],["أنت ترعاه وهو يرعى بك المج","دَ فيا بِئس ما رَعى الرَّاعيان",10,"ن",1,0],["أنتِ تحتَ السَّماءِ روحٌ جميلٌ","صاغَهُ الله من عَبيرِ الوُرودِ",11,"د",1,0],["أَنتِ تُحيينَ في فؤاديَ مَا قدْ","ماتَ في أَمسيَ السَّعيدِ الفقيدِ",12,"د",1,0],["أَن تُترَكَ الأَرضُ لِذي الخُرطومِ","كَي نَستَريحَ مِن أَذى الغَشومِ",13,"م",1,0],["أَنتَ تَغلي إِلى القِيامَةِ كَالقِد","رِ فَلا حَطَّ يَومُها لَكَ قِدرا",14,"ر",2,0],["إِن تَتَعَجَّب فَلِأَبكارِ ما","يَأتي بِهِ دَهرُكَ أَو عونِهِ",15,"ن",2,0],["أَنتَ تَدري ما كانَ بَعدَكَ حالي","فَتُرى كَيفَ كانَ حالُكَ بَعدي",16,"د",2,0],["أنت تدري أيّ ضن","كٍ في لياليه أقامَا",17,"م",2,0],["أَنتِ تَسبينَ ذا العَفافِ بِدَلٍّ","يَستَخِفُّ الحليمَ وهو وقورُ",18,"ر",1,0],["أَنتَ تُزهى بِصورَةٍ غَدَتِ الأَب","صارُ مِن حُسنِها وَراحَت عَلَيكا",19,"ك",2,0],["أَنتَ تَدري سَريرَتي","دونَ شَكٍّ بِاِسمٍ وَعَين",20,"ن",1,0],["إنْ تَتْلُها خِيفَةً مِنْ حَرِّ نارِ لَظىً","أَطْفَأْتَ نارَ لَظىً مِنْ وِرْدِها الشَّبِمِ",21,"م",1,0],["إِن تَتَطَيَّر أَو تَفاءَل فَما","تَملِكُ ريبَ الدَهرِ أَن تَرسِنَه",22,"ن",2,0],["إِن تَتبَعا في مَذهَبٍ جاهِلاً","فَالحَقُّ مِن خُلقِكُما تَترُكان",23,"ن",1,0],["أنت تنحو من المنى","برزخا أيّ برزخ",24,"خ",1,1],["انت تستصرخ الغنى","وَالغنى غير مصرخ",24,"خ",1,0],["أَنْتَ تدري أنَّ الحياةَ قُطو","بٌ وخُطوبٌ فما حياةُ القُطوبِ",25,"ب",1,0],["إِنْ تَتَشَبَّهْ أَوْفَى الْغَوَانِي","بِهَا تَشَبَّهْن مِنْ بَعِيدِ",26,"د",1,0],["إن تَترُكوهُمْ، فلن يُشْفَى سُعَارُهُمو","يومًا، ولن يَقْنَعُوا يومًا بما سَلَبُوا",27,"ب",3,0],["أنت تشرينهم بدفء الليالي","فيبيعون في هواك الإمارة",28,"ر",2,0],["انتَ تدري حرمانَ ذي العقل في الناسِ","فزدني منها جُنوناً ومَسا",29,"س",2,0],["أنتِ تدرين أنني ذو لُبانَهْ","الهوى يستثيرُ فيَّ المَجانَهْ",30,"ن",2,1],["أنت تهدي وتلك هدايا","ك إلى كل أير نكاح",31,"ح",1,0],["أنت تستهوي كل فرد فيغفي","وإذا ما أغفى فلا يستفيق",32,"ق",1,0],["أَنتِ تَفدينَ عَبدَ مِن كُلِّ خَيرٍ","وَمِنَ السوءِ هِيَ تَكونُ فِداكِ",33,"ك",1,0],["أنت تجود بالكثير باسما","والغيث جود سيحه بكاء",34,"ا",2,0],["أنت تدري بأنّني بك صبٌّ","لست أعمى يا أيّها المتسامي",35,"م",2,0],["أنتَ تصبيني فما لي","لا أرى أولَ صبِ",36,"ب",1,0],["أنت تدري أن الهوى ليس يحلو","طعمُه أو يكون فيه مرارُ",37,"ر",1,0],["أنت تجني عَلَيَّ طوراً وطوراً","ليَ بين الترفيه والتعنيفِ",38,"ف",1,0],["أنت تشكو إن هذا مستحيل","فافترس دنياك بالصبر الجميل",39,"ل",1,0],["أَنتَ تحيا أَوّاهُ أَيَّ حياةٍ","لَم يَكُن ما نَظَرتُه بِاِعتِقادي",40,"د",2,0],["إِن تُتَرجَم كانت أَحاديثَ أحلى","ما يُؤَدّي بِمِثلِهِنَّ الرَجاء",41,"ا",2,0],["أَنتَ تَسمو عَلى البَريَّةِ طُرّاً","بِمَحَلٍّ عالٍ وَبَيتٍ كَبيرٍ",42,"ر",1,0],["أَنت تقضى والله يقضى بعدلٍ","في البرايا والله أكبر أيدا",43,"د",2,0],["إن تتركاني تائباً","من فاتحتي عن كل فسقِ",44,"ق",1,0],["أنت تدري وحسب عبدك فميا","يرتجي منك قولهُ أنت تدري",45,"ر",2,0],["أنت تدري أنه يد","فع عن مالي وجاهي",46,"ا",3,0],["أَنتَ تُملي من عالَمِ الغَيبِ إِلها","ماً وَشِعري من عالم الأَسبابِ",47,"ب",1,0],["أنت ترياقي من العلل","ومن الآفات والمحن",48,"ن",1,0],["أنت ترجو بعدهم خلف","صالح ماض على القدم",49,"م",1,0],["إِن تَتلُها خيفَةً مِن حُرِّ نارِ لَظى","أَطفَأتُ حَرَّ لَظى مِن وَردِها الشَبَمِ",50,"م",1,0],["أنت تخشى نار الغرام عليّا","وترجى النجاة من أنفاسه",51,"ه",1,0],["أَنتَ تاج العُلى وَكِسرى بن داراه","ما غَلَونا في ذا المَقام مَقالا",52,"ل",2,0],["إن تَتْبَعِ العُرْفَ تَعْريفاً بدأْتَ بهِ","فلستَ بالرِّفدِ بعدَ الرِّفْدِ ذا بَخَل",53,"ل",1,0],["أنتَ تأتي المَجدَ مُبتَدِعاً","لا بتَمثيِلٍ عَليهِ بُنِي",54,"ن",2,0],["أنت تدري بأن أصلك ماء","كان في الصلب مستقر مكانك",55,"ك",1,0],["أنت تهوى هذه قلت نعم","فدع التعنيف ثم انتقل",56,"ل",1,0],["أنتَ تَقضِي بالحَقّ لستَ وإن زا","لَتْ جِبَالُ الأرضِينَ عنه تَزولُ",57,"ل",1,0],["أَنْتَ تقينا بأسَ ما نتّقي","وكلّ ما نخشاه من أجْلِهِ",58,"ل",2,0],["أَنْ تُتْبِعِ الدَّلْوَ السَّجُوفَ رشاءها","يوم الخَوامِسِ والجوادَ لِجَامَها",59,"م",3,0],["أنتَ ترعى حُشاشَةَ الصبِّ من","غير اكتراثٍ لاهٍ بها مُتَوانِ",60,"ن",1,0],["أنتِ تَدرينَ أنَّني مَرِح ٌ","طولَ عُمْري..مُشاكِسٌ،غَرِد ُ",61,"د",1,0],["أَنتَ تَدري أَنَّ ما مِن شَهوَتي","أَن أَرى قَلبي أَسيراً في يَدَيهِ",62,"ي",2,0],["أنت تفي بالعهد واف به","وهو بما يعقده غادر",63,"ر",1,0],["أنت تجري على سجية نفس","كل ساع لشأوها ليس يلحق",64,"ق",1,0],["إِن تَترُكوا وائِلاً لِلحَربِ يا مُضَرٌ","فَسَوفَ يَلقاكُمُ ما كانَ لاقيها",65,"ي",3,0],["أنت تُعنى به وإنْ لم يَقُلْ في","ك ومَن قيل فيه فَهوَ المَلومُ",66,"م",1,0],["أنتَ تَجنِي في كلّ يوم على عِرْ","ضِكِ عمداً فكيف يسلم عِرضِي",67,"ض",2,0],["أَنتَ تَجزي عَفواً وَصَفحاً فإنْ أُحْ","رِجْتَ أَجريتَ بِالسيوفِ الدّماءا",68,"ا",3,0],["أَنتَ تَفسو إِذا نَطَقتَ وَمَن سَبَّ","حَ مِن فَسوِ قالَ إِثماً وَزورا",69,"ر",2,1],["أنت تقديره وتصويره في","علمه سابقاً وما هو ناسي",70,"س",2,0],["أَنت تيها تَصُدُّ عَنْ طَرب النَّفْ","سِ فَلِمَ صِرْتَ للْهمومِ تَصدَّى",71,"د",2,0]]}