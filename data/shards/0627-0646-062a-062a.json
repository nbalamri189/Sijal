/ViewPoem.aspx?id=15893",""],[5976,"تتذاكى على استاذك !!","https://www.poetsgate.com/ViewPoem.aspx?id=30349",""],[6031,"عَاطِنيها قبلَ ابتِسَامِ الصَّبَاحِ","https://www.poetsgate.com/ViewPoem.aspx?id=46257",""],[6068,"إن تتركيني في الغرام وتهربي -03-","https://www.poetsgate.com/ViewPoem.aspx?id=175882",""],[520,"لا وعيون لحظها ساحر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577520",""],[6268,"هذيان بائع الدموع","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82917&r=&rc=3",""],[6355,"موطني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66616&r=&rc=76",""]],"verses":[["أَنتَ تَروى مِن مَدمَعٍ كُلَّ يَومٍ","وَتُغَذّى مِن هَذِهِ الأَجسادِ",0,"د",1,0],["إِنْ تَتَكَلَّمْ فَهْيَ مَجْهُودَةٌ","أَوْ تَتَحَرَّكْ فَهْيَ مُثَّاقِلَهْ",1,"ل",2,0],["أَنْتَ تَبْغِي السِّيَرَا","شَاغِلاً عَمَّا تَرَى",2,"ر",2,1],["إِنْ تَتَبَيَّنْ كُنْهَهُ لَمْ تَجِدْ","أَمْثَالَ ذَاكَ الْكَنْزِ فِي مَنْجَمِ",3,"م",1,0],["أَنْتَ تُعْطِي حَقِيقَةَ العَيْشِ مَعْنىً","قَصُرَتْ دُونَهُ مَعَانِي الخَيَالِ",4,"ل",1,0],["أنت تغدو بكساء","وهو من غير كساء",5,"ا",2,0],["إِن تَترُكوهُ فَإِنَّ رَبّي قادِرٌ","أَمسى يَعودُ بِفَضلِهِ العَوّادِ",6,"د",1,0],["أنتَ ترعى الأمور والله يرعا","كَ فلا زلت راعياً مرعيّا",7,"ي",2,0],["أنت تيسٌ والتيسُ أش","بهُ شيءٍ بخِلْقَتِكْ",8,"ك",1,1],["أنت تُهْدِي وتِلْكَ تُهْدي هَدَايَا","كَ إلى كل أيِّرٍ نَكَّاحِ",9,"ح",1,0],["أنت ترعاه وهو يرعى بك المج","دَ فيا بِئس ما رَعى الرَّاعيان",10,"ن",1,0],["أنتِ تحتَ السَّماءِ روحٌ جميلٌ","صاغَهُ الله من عَبيرِ الوُرودِ",11,"د",1,0],["أَنتِ تُحيينَ في فؤاديَ مَا قدْ","ماتَ في أَمسيَ السَّعيدِ الفقيدِ",12,"د",1,0],["أَن تُترَكَ الأَرضُ لِذي الخُرطومِ","كَي نَستَريحَ مِن أَذى الغَشومِ",13,"م",1,0],["أَنتَ تَغلي إِلى القِيامَةِ كَالقِد","رِ فَلا حَطَّ يَومُها لَكَ قِدرا",14,"ر",2,0],["إِن تَتَعَجَّب فَلِأَبكارِ ما","يَأتي بِهِ دَهرُكَ أَو عونِهِ",15,"ن",2,0],["أَنتَ تَدري ما كانَ بَعدَكَ حالي","فَتُرى كَيفَ كانَ حالُكَ بَعدي",16,"د",2,0],["أنت تدري أيّ ضن","كٍ في لياليه أقامَا",17,"م",2,0],["أَنتِ تَسبينَ ذا العَفافِ بِدَلٍّ","يَستَخِفُّ الحليمَ وهو وقورُ",18,"ر",1,0],["أَنتَ تُزهى بِصورَةٍ غَدَتِ الأَب","صارُ مِن حُسنِها وَراحَت عَلَيكا",19,"ك",2,0],["أَنتَ تَدري سَريرَتي","دونَ شَكٍّ بِاِسمٍ وَعَين",20,"ن",1,0],["إنْ تَتْلُها خِيفَةً مِنْ حَرِّ نارِ لَظىً","أَطْفَأْتَ نارَ لَظىً مِنْ وِرْدِها الشَّبِمِ",21,"م",1,0],["إِن تَتَطَيَّر أَو تَفاءَل فَما","تَملِكُ ريبَ الدَهرِ أَن تَرسِنَه",22,"ن",2,0],["إِن تَتبَعا في مَذهَبٍ جاهِلاً","فَالحَقُّ مِن خُلقِكُما تَترُكان",23,"ن",1,0],["أنت تنحو من المنى","برزخا أيّ برزخ",24,"خ",1,1],["انت تستصرخ الغنى","وَالغنى غير مصرخ",24,"خ",1,0],["أَنْتَ تدري أنَّ الحياةَ قُطو","بٌ وخُطوبٌ فما حياةُ القُطوبِ",25,"ب",1,0],["إِنْ تَتَشَبَّهْ أَوْفَى الْغَوَانِي","بِهَا تَشَبَّهْن مِنْ بَعِيدِ",26,"د",1,0],["إن تَترُكوهُمْ، فلن يُشْفَى سُعَارُهُمو","يومًا، ولن يَقْنَعُوا يومًا بما سَلَبُوا",27,"ب",3,0],["ان تتبعوه فعين الرشد خطتكم","أو تعرضوا عنه فالإعراض طغيان",28,"ن",1,0],["أنت تشرينهم بدفء الليالي","فيبيعون في هواك الإمارة",29,"ر",2,0],["انتَ تدري حرمانَ ذي العقل في الناسِ","فزدني منها جُنوناً ومَسا",30,"س",2,0],["أنتِ تدرين أنني ذو لُبانَهْ","الهوى يستثيرُ فيَّ المَجانَهْ",31,"ن",2,1],["أنت تهدي وتلك هدايا","ك إلى كل أير نكاح",32,"ح",1,0],["أنت تستهوي كل فرد فيغفي","وإذا ما أغفى فلا يستفيق",33,"ق",1,0],["أَنتِ تَفدينَ عَبدَ مِن كُلِّ خَيرٍ","وَمِنَ السوءِ هِيَ تَكونُ فِداكِ",34,"ك",1,0],["أنت تجود بالكثير باسما","والغيث جود سيحه بكاء",35,"ا",2,0],["أنت تدري بأنّني بك صبٌّ","لست أعمى يا أيّها المتسامي",36,"م",2,0],["أنتَ تصبيني فما لي","لا أرى أولَ صبِ",37,"ب",1,0],["أنت تدري أن الهوى ليس يحلو","طعمُه أو يكون فيه مرارُ",38,"ر",1,0],["أنت تجني عَلَيَّ طوراً وطوراً","ليَ بين الترفيه والتعنيفِ",39,"ف",1,0],["أنت تشكو إن هذا مستحيل","فافترس دنياك بالصبر الجميل",40,"ل",1,0],["أَنتَ تحيا أَوّاهُ أَيَّ حياةٍ","لَم يَكُن ما نَظَرتُه بِاِعتِقادي",41,"د",2,0],["إِن تُتَرجَم كانت أَحاديثَ أحلى","ما يُؤَدّي بِمِثلِهِنَّ الرَجاء",42,"ا",2,0],["أَنتَ تَسمو عَلى البَريَّةِ طُرّاً","بِمَحَلٍّ عالٍ وَبَيتٍ كَبيرٍ",43,"ر",1,0],["أَنت تقضى والله يقضى بعدلٍ","في البرايا والله أكبر أيدا",44,"د",2,0],["إن تتركاني تائباً","من فاتحتي عن كل فسقِ",45,"ق",1,0],["أنت تدري وحسب عبدك فميا","يرتجي منك قولهُ أنت تدري",46,"ر",2,0],["أنت تدري أنه يد","فع عن مالي وجاهي",47,"ا",3,0],["أَنتَ تُملي من عالَمِ الغَيبِ إِلها","ماً وَشِعري من عالم الأَسبابِ",48,"ب",1,0],["أنت ترياقي من العلل","ومن الآفات والمحن",49,"ن",1,0],["أنت ترجو بعدهم خلف","صالح ماض على القدم",50,"م",1,0],["إِن تَتلُها خيفَةً مِن حُرِّ نارِ لَظى","أَطفَأتُ حَرَّ لَظى مِن وَردِها الشَبَمِ",51,"م",1,0],["أنت تخشى نار الغرام عليّا","وترجى النجاة من أنفاسه",52,"ه",1,0],["أَنتَ تاج العُلى وَكِسرى بن داراه","ما غَلَونا في ذا المَقام مَقالا",53,"ل",2,0],["إن تَتْبَعِ العُرْفَ تَعْريفاً بدأْتَ بهِ","فلستَ بالرِّفدِ بعدَ الرِّفْدِ ذا بَخَل",54,"ل",1,0],["أنتَ تأتي المَجدَ مُبتَدِعاً","لا بتَمثيِلٍ عَليهِ بُنِي",55,"ن",2,0],["أنت تدري بأن أصلك ماء","كان في الصلب مستقر مكانك",56,"ك",1,0],["أنت تهوى هذه قلت نعم","فدع التعنيف ثم انتقل",57,"ل",1,0],["أنتَ تَقضِي بالحَقّ لستَ وإن زا","لَتْ جِبَالُ الأرضِينَ عنه تَزولُ",58,"ل",1,0],["أَنْتَ تقينا بأسَ ما نتّقي","وكلّ ما نخشاه من أجْلِهِ",59,"ل",2,0],["أَنْ تُتْبِعِ الدَّلْوَ السَّجُوفَ رشاءها","يوم الخَوامِسِ والجوادَ لِجَامَها",60,"م",3,0],["أنتَ ترعى حُشاشَةَ الصبِّ من","غير اكتراثٍ لاهٍ بها مُتَوانِ",61,"ن",1,0],["أنتِ تَدرينَ أنَّني مَرِح ٌ","طولَ عُمْري..مُشاكِسٌ،غَرِد ُ",62,"د",1,0],["أَنتَ تَدري أَنَّ ما مِن شَهوَتي","أَن أَرى قَلبي أَسيراً في يَدَيهِ",63,"ي",2,0],["أنت تفي بالعهد واف به","وهو بما يعقده غادر",64,"ر",1,0],["أنت تجري على سجية نفس","كل ساع لشأوها ليس يلحق",65,"ق",1,0],["إِن تَترُكوا وائِلاً لِلحَربِ يا مُضَرٌ","فَسَوفَ يَلقاكُمُ ما كانَ لاقيها",66,"ي",3,0],["أنت تُعنى به وإنْ لم يَقُلْ في","ك ومَن قيل فيه فَهوَ المَلومُ",67,"م",1,0],["أنتَ تَجنِي في كلّ يوم على عِرْ","ضِكِ عمداً فكيف يسلم عِرضِي",68,"ض",2,0],["أَنتَ تَجزي عَفواً وَصَفحاً فإنْ أُحْ","رِجْتَ أَجريتَ بِالسيوفِ الدّماءا",69,"ا",3,0],["أَنتَ تَفسو إِذا نَطَقتَ وَمَن سَبَّ","حَ مِن فَسوِ قالَ إِثماً وَزورا",70,"ر",2,1],["أنت تقديره وتصويره في","علمه سابقاً وم