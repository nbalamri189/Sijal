{"poems":[[65,"من أغفل الحزم أدمى كفه ندما","https://www.aldiwan.net/poem46181.html","البسيط"],[49,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[58,"سهام لحاظ من قسي الحواجب","https://www.aldiwan.net/poem58453.html","الطويل"],[45,"رضاك رضاي الذي أوثر","https://www.aldiwan.net/poem9564.html","المتقارب"],[63,"صنائع الله لا نحصي لها عددا","https://www.aldiwan.net/poem51725.html","البسيط"],[51,"ما لي رأيتك راكبا لهواكا","https://www.aldiwan.net/poem62207.html","الكامل"],[51,"كفتني العناية من ثابت","https://www.aldiwan.net/poem64228.html","الكامل"],[68,"كفي القتال وفكي قيد أسراك","https://www.aldiwan.net/poem38480.html","البسيط"],[33,"تقول غداة التقينا الربا","https://www.aldiwan.net/poem42026.html","المتقارب"],[41,"لولا فوارس مذحج ابنة مذحج","https://www.aldiwan.net/poem53776.html","الكامل"],[69,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[77,"وهب الدهر نفيسا فاسترد","https://www.aldiwan.net/poem69086.html","الطويل"],[52,"دعاك الحب بالشعب","https://www.aldiwan.net/poem64830.html","الهزج"],[48,"كفتك حوادث الأيام قتلا","https://www.aldiwan.net/poem22298.html","الوافر"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140993",""],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54976","الطويل"],[111,"ألا هل لداعي الله في الأرض سامع","https://www.poetsgate.com/ViewPoem.aspx?id=103",""],[92,"النجوى","https://www.poetsgate.com/ViewPoem.aspx?id=178987",""],[111,"ألا هل لداعي الله في الأرض سامع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=545618",""],[137,"أهدي إليك ثناء العرب والعجم","https://www.aldiwan.net/poem4217.html","البسيط"],[189,"لما تلطفت حتى صح وعدك لي","https://www.aldiwan.net/poem14641.html","البسيط"],[240,"هل لأخي صبوة نزوع","https://www.aldiwan.net/poem31892.html","مجزوء البسيط"],[240,"حتام أرضى في هواك وتغضب","https://www.aldiwan.net/poem32181.html","الكامل"],[276,"أرى برق الغوير اذا تراءى","https://www.aldiwan.net/poem52103.html","الوافر"],[280,"لم يخن في الحب تأويلي","https://www.aldiwan.net/poem25541.html","المديد"],[303,"ثكلت مقلته طيب الكرى","https://www.aldiwan.net/poem36847.html","عموديه"],[310,"يا أهل بيت له العلياء والعظم","https://www.aldiwan.net/poem56405.html","البسيط"],[371,"كلفت بتعنيفي بلا طلب عذري","https://www.aldiwan.net/poem17192.html","الطويل"],[382,"الله قد خلق الإنسان مرتسما","https://www.aldiwan.net/poem59268.html","البسيط"],[408,"ملك به عز الشريعة مظهر","https://www.aldiwan.net/poem46933.html","الكامل"],[463,"ليل السرى مثل نهار المقام","https://www.aldiwan.net/poem55886.html","السريع"],[463,"تمنى رجال أن تزل بي النعل","https://www.aldiwan.net/poem55997.html","الطويل"],[463,"لو شاء سار ليلة النعف وقف","https://www.aldiwan.net/poem56113.html","الرجز"],[463,"بلوت هذا الدهر أطواره","https://www.aldiwan.net/poem56171.html","السريع"],[463,"أمكنت العاذل من قيادها","https://www.aldiwan.net/poem56218.html","الرجز"],[463,"ليتك لما تكن مسعدا","https://www.aldiwan.net/poem56237.html","السريع"],[463,"سل في الغضا وصبا الأصائل تنفح","https://www.aldiwan.net/poem56248.html","الكامل"],[463,"نأت والأمانِي بها تقرب","https://www.aldiwan.net/poem56282.html","المتقارب"],[466,"أما اذا سلم الامام الأعظم","https://www.aldiwan.net/poem16018.html","الكامل"],[520,"ثغر الزمان بنجم الدين مبتسم","https://www.aldiwan.net/poem12263.html","البسيط"],[543,"ملامكما كفا فقد قضي الأمر","https://www.aldiwan.net/poem48170.html","عموديه"],[545,"كفتك قياد القلب أيام مثعر","https://www.aldiwan.net/poem56740.html","الطويل"],[563,"بحمد الله خلاق الوجود","https://www.aldiwan.net/poem34612.html","الوافر"],[567,"أقول لعطفها عند النهوض","https://www.aldiwan.net/poem52931.html","الوافر"],[591,"أبدا بذكرك تنقضي أوقاتي","https://www.aldiwan.net/poem17455.html","الكامل"],[612,"","https://poetry.dctabudhabi.ae/diwan/poem/82790","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122555","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122709","الكامل"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63864","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59113","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64875","الطويل"],[1269,"","https://poetry.dctabudhabi.ae/diwan/poem/122886","الرمل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1356,"","https://poetry.dctabudhabi.ae/diwan/poem/200257","الكامل"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137864",""],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132836","الطويل"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132874","البسيط"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132834","الطويل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50014","البسيط"],[1473,"","https://poetry.dctabudhabi.ae/diwan/poem/124028","البسيط"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141341","الكامل"],[1759,"","https://poetry.dctabudhabi.ae/diwan/poem/107344","الخفيف"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105430","الطويل"],[1858,"","https://poetry.dctabudhabi.ae/diwan/poem/106711","الطويل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52090","البسيط"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52047","الطويل"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100472","الوافر"],[2103,"","https://poetry.dctabudhabi.ae/diwan/poem/137930",""],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53175","الكامل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28484","الطويل"],[2521,"","https://poetry.dctabudhabi.ae/diwan/poem/110671","البسيط"],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132362","الوافر"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87334","الطويل"],[2818,"","https://poetry.dctabudhabi.ae/diwan/poem/101868","البسيط"],[3098,"","https://poetry.dctabudhabi.ae/diwan/poem/131896","الطويل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139946","البسيط"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/140024","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62765","الطويل"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123915","الوافر"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48316","الكامل"],[3600,"","https://poetry.dctabudhabi.ae/diwan/poem/178025","الكامل"],[3640,"","https://poetry.dctabudhabi.ae/diwan/poem/141892","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66490","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110059","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114275","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199111","الوافر"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102752","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81683","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136505",""],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146759","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72490","الطويل"],[4575,"","https://poetry.dctabudhabi.ae/diwan/poem/31520","البسيط"],[4664,"","https://poetry.dctabudhabi.ae/diwan/poem/101169","الكامل"],[4717,"وكأنه وطن..","https://www.poetsgate.com/ViewPoem.aspx?id=200114",""],[4767,"الفرحة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=91838",""],[4822,"بحبك أيها الظبي الغرير","https://www.poetsgate.com/ViewPoem.aspx?id=171235",""],[4578,"نشرت على رمح القوام عصائبا","https://www.poetsgate.com/ViewPoem.aspx?id=49349",""],[4852,"رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=214379",""],[5186,"اليسر في العسرى على مقدارها","https://www.poetsgate.com/ViewPoem.aspx?id=156462",""],[5582,"أَتَرْدَعُنِي بِاللَّوْمِ وَالدَّهْرُ أَرْدَعُ","https://www.poetsgate.com/ViewPoem.aspx?id=63534",""],[5672,"كف....في ذكرى الطفوف","https://www.poetsgate.com/ViewPoem.aspx?id=206556",""],[5956,"الإعجابُ والحبّ","https://www.poetsgate.com/ViewPoem.aspx?id=182655",""],[6117,"مانعةُ الرَّخَاء","https://www.poetsgate.com/ViewPoem.aspx?id=182789",""],[469,"يا خائنا ما كنت احس","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574831",""]],"verses":[["كَفَتْهُ كُتْبُكَ أن تُزْجى كتائِبُهُ","وأُلْهِمَ السّيفُ أن يَستنْجِدَ القَلَما",0,"م",2,0],["كَفَت غَدَواتِ الغَيثِ دِرّاتُ كَفِّهِ","فَأَمرَعَ بادٍ وَاِجتَنى العَيشَ حاضِرُ",1,"ر",1,0],["كَفَتْكَ النّوى عَذْلَ المُعَنّى فأَقْصِري","بما رُمْتِ فيه مِنْ فراقِ الحبايبِ",2,"ب",1,0],["كَفَتكَ المُروأَةُ ما تَتَّقي","وَآمَنَكَ الوُدُّ ما تَحذَرُ",3,"ر",1,0],["كَفَّتْ يدَ الدَّهرِ إذ مُدَّت إلى ملكٍ","ما زالَ يَبسُطُ بالجَدوى إليَّ يَدا",4,"د",2,0],["كَفَتيلَةِ المِصباحِ تَحرُقُ نَفسَها","وَتُنيرُ واقِدَها وَأَنتَ كَذاكا",5,"ك",2,0],["كَفَتني العِنايَةُ مِن ثابِتٍ","بِتَثميرِ ما كانَ مِن غَرسِهِ",6,"ه",1,1],["كَفَّت عَنِ السَيرِ لِلمَرعى مُحاوَلَةً","فَقُلتُ سيري إِلى مَرعى النَدى الزاكي",7,"ك",2,0],["كَفَّت سَوابِقَ مِن عَبرَةٍ","كَما اِرفَضَّ نَظمٌ ضَعيفُ السِلاكِ",8,"ك",1,0],["كَفَتِ الَّذينَ تَغَيَّبوا مِن قَومِهِم","مَن كانَ يُعرَفُ مِنهُمُ أَو يُنكَرُ",9,"ر",1,0],["كَفَتْهُ سُطاهُ أَنْ يُجَهِّزَ عَسْكَراً","وآراؤُهُ أَنْ يُسْتَشارَ وَزِيرُ",10,"ر",1,0],["كفَتاةٍ كَسَرَتْ خَلْخالَها","ضاعَ نصْفٌ منه والنصْفُ وُجِد",11,"د",1,0],["كَفَتكِ الغايَةُ الدُنيا","مَعَ القُصوى الَّتي تُكبي",12,"ب",2,0],["كَفَتكَ حَوادِثُ الأَيّامِ قَتلاً","فَلا تَعرِض لِسَيفٍ أَو لِرُمحِ",13,"ح",1,1],["كفٌّ تَلُمُّ العمر والعُمر راح","وقبضةٌ تجمع شمل الرياح",14,"ح",1,0],["كفتك المروءة ما تتّقى","وآمنك الودّ ما تحذر",15,"ر",1,0],["كَفَتْهَا لَيَالٍ نزْرَةٌ فَتَجَدَّدَتْ","ثوَابِتَ أَرْكَانٍ رَوَاسِخَ آسَاسِ",16,"س",1,0],["كفته لقيمات يقومن صلبه","وطمر من الانهاج بأياه راقع",17,"ع",1,0],["كفتنيْ الكرى واجباتُ المِحاق","فجئتُ تَماسَحُ مني الجفونا",18,"ن",2,0],["كفته لقيمات يقومن صلبه","وطمر من الانهاج يأباه رافع",19,"ع",1,0],["كفته أمر أعاديه سعادته","فنال ما رامه فيهم ولم يرم",20,"م",1,0],["كفَّت عن الخير كفٌّ منه باخِلة","كأنها بين أَصْفاد وأغلال",21,"ل",1,0],["كَفَّت يَدَ الخَطبِ مِنهُ كَفٌّ","كَالدَهرِ ضَرّارَةٌ نَفوعُ",22,"ع",1,0],["كَفٌّ تَكُفُّ الحادِثاتِ وَراحَةٌ","تَرتاحُ لِلجَدوى وَقَلبٌ قُلَّبُ",23,"ب",1,0],["كفته كَرامة المعراج فَضلا","بها في القرب ساد الانبياء",24,"ا",2,0],["كَفَتِ التَّنْجِيمَ أسْعُدُهُ","أمْرَ تَعْديدٍ وَتَعْديلِ",25,"ل",1,0],["كفتاةٍ أَثبتتْ في حبها","نظراً حيناً وَغضَّته حيا",26,"ا",1,0],["كفّت بكفّك أدواءٌ ودرّ بها","ضرعٌ وسحبٌ وماءٌ واِنسَرى لممُ",27,"م",1,0],["كَفَتكَ اللَيالي ما تَخافُ فَإِنَّها","عَلى خَوفِها مِنكُم تَخافُ عَلى الحُرِّ",28,"ر",1,0],["كُفَّت بصائرُهم منها فما انتزحوا","عنها فتشكو بَصيرتْهُم من السَقَم",29,"م",1,0],["كفُّ ترى الأَملاكَ لثْمَ بنانِها","شرفاً ويحسدُها الغمامُ الممطرُ",30,"ر",1,0],["كفَته منه قبلَ أيامِهِ","آراءُ نصرٍ هنُّ بيضٌ ولامْ",31,"م",1,0],["كفتني يداه في الندى كلَّ طلقةٍ","مقبَّلةٍ على مكارمها كَلُّ",32,"ل",1,0],["كفتنيَ الرزقَ يدٌ واحدةٌ","والناس طرّاً واحدٌ منهم خَلَفْ",33,"ف",1,0],["كفَت به القدرةُ لما سطت","أيدٍ مع القدرة جبّارَهْ",34,"ر",2,0],["كفتْكَ كسبَ العزّ نفسٌ حرةٌ","أحرزتِ العزّةَ من ميلادِها",35,"د",3,0],["كفَّتهُمُ عنِّيَ أو ليتُهمْ","كانوا جميعاً للحسين الفدى",36,"د",2,0],["كفٌّ تخفُّ مع الرياح سماحةً","ومهابةٌ تزن الجبالَ وتَرجَحُ",37,"ح",1,0],["كفته بديهةُ حِدْثانهِ","قديمَ الرجالِ وما جَرّبوا",38,"ب",3,0],["كُفَّتْ يداهُ عن النَّدى من بعدما","حسدَ الغمامُ بَنانهُ والخِضْرِمُ",39,"م",1,0],["كف تقبلها الأفواه تكرمة","والركن يومي إليه حين يستلم",40,"م",1,0],["كَفَت وَرِعاً يَخشى منَ الإثمِ شُربَها","بِرُؤيتِها في الكأسِ يَنشَرِح الصَّدرُ",41,"ر",1,0],["كَفَتكَ قيادَ القَلبِ أَيّامُ مَثعَرٍ","وَأَيّامُنا إِذ يَجمَعُ الحَيَّ مُخلِفُ",42,"ف",1,1],["كفتهُ عن الطريق بلا التفاتٍ","إلى تقوى الخواصِّ ولا صعود",43,"د",1,0],["كَفَتْهُ منَ الزَّمانِ سُطورُ صُحْفٍ","فتِلكَ الدَّهرُ من سُودٍ وبيضِ",44,"ض",1,0],["كَفٌّ تُمَدُّ بِجُودِهِ نَحْوِي وَأُخْ","رَى لِلسَّماءِ بِصَالحِ الدَّعَواتِ",45,"ت",1,0],["كَفته خِيانات اللئام عَدوه","وَما بَثَ مِن جُند الفَساد وَأَرصَدا",46,"د",2,0],["كفتني كًفُّ سُلطانَ التَّمنّي","وقَولي عَلَّه وعَسَى وليتَه",47,"ت",2,0],["كَفٌّ تَعَوَّدَت السَّماحَ فَلم تَزَل","مُذ كانَ مُمسِكُهُ عَلى الأمساكِ",48,"ك",1,0],["كفٌ تُخالُ من اللجينِ مصوغةً","وأَناملٌ من لينها كالقز",49,"ز",1,0],["كَفَّتْ بَلاَغَتُهَا أيْدِي مُعَارِضِهَا","كَالشهبِ كُفَّتْ بِهَا أيدي الشياطينِ",50,"ن",1,0],["كفَتْهُ اللَّيالي ما يَخافُ فطالما","كَفانا نَداهُ الحاتميُّ وما اكْتَفَى",51,"ف",2,0],["كفتاة الخدر أبدت وجهها","من أعالي قصرها مطلعه",52,"ع",2,0],["كفتح لام الشاطبي أولا","وقس عليها في الضروب موئلا",53,"ل",2,0],["كفتحة الراء التي في المخترق","فهذه ست بها كل نطق",53,"ق",1,0],["كفتاة زنج في حُلَىَ كَحْلى الملا","حفت ببعض كرائم الأعلاج",54,"ج",1,0],["كفتني ليالي دهرنا خبرة بها","بما ذقت من حلو وما نلت من مر",55,"ر",1,0],["كَفَتنَا حُمَيَّا الخمرِ رِقةُ لفظِها","وأَمَّنَنَا تهذيبُها هَفوةِ السكرِ",56,"ر",1,0],["كفتكَ آثارُ كَفَّيكَ التي ابتدعت","في المجد شاده آباؤك الأُولُ",57,"ل",1,0],["كَفَتنَا وإياك المعاذير نيَّةٌ","إذا خَلُصَت لم تذكر الوصلَ والهجرا",58,"ر",2,0],["كفّ تصوب نُضاراً كلَّ صابحةٍ","على العُفاة كصوب العارض الهطلِ",59,"ل",1,0],["كف تكُف اخا العناد وراحةٌ","مرتاحةٌ لغنى العديم المقتر",60,"ر",1,0],["كفّ تجسّ بها يديه وبال","أخرى تهدئ قلبها جلدا",61,"د",2,0],["كُفَّت المُقلَتانِ في الحُزنِ مِن ه","ذا وذاك المبيعِ بَيعَ الهَوانِ",62,"ن",1,0],["كفته عداه واغتدت مهجاتها","له جننا من نيلها المتكاوس",63,"س",1,0],["كَفتكَ ظُبَى المأمونِ كُلَّ مُلِمَّةٍ","ومُبهَمِ خطبٍ مُسدِلٍ ذَيلَ أجنَان",64,"ن",1,0],["كَفَتْكَ أنْ تَرتَجِي تَعدِيلَ شَاهِدِهَا","لاَيَسْطَعُ الطِّيبُ ما لم تُصلحِ الجُوَنُ",65,"ن",1,0],["كَفَتني مِنَ المَولى القَويّ حِمايَةٌ","ومَا بَعدَ عَونِ اللهِ فِي شِدَّةٍ جُندُ",66,"د",1,0],["كفتنا منه أخلاق حسان","برقتها ونفحتها انتشينا",67,"ن",2,0],["كفتهُ حاجهُ من كل شيءٍ","وزادت فوقها أشياءَ أخرى",68,"ر",2,0],["كفت يدي قسراً على رغم العلا","عما أروم قناعة وخمول",69,"ل",1,0],["كَفَتنا ثَقيلَ الهَمِّ حَتّى كَأَنَّما","رَمَينا بِهِ فَوقَ الذُرى وَالغَوارِبِ",70,"ب",1,0],["كف تكفكف دمعي في الطلول ولي","كف تسائل ابن الركب قد بانا",71,"ن",2,0],["كفت فيها القدود عن العوالي","وألحاظُ الظِّباءِ عن النبالش",72,"ل",2,0],["كَفَت أحمَدَ السَعدِي شَفَاعَةُ أحمَدٍ","إذَا مَا رَمَى يَومُ الوَعيدِ بِصَايِبِ",73,"ب",1,0],["كفّ تجود على كل الأنام ندى","منه الأنام بإذن الله قد رزقوا",74,"ق",3,0],["كفتية إحسان أتوه قواصدا","تراهم على الأنضاء مثل الأجادل",75,"ل",1,0],["كفُّ تُسالم مَنْ يلقاه مُستلما","كما تُقاسمَ من يأتيه مُلتمسا",76,"س",2,0],["كفتكة وحشي بحمزة عمّه","ووحشةُ أهل الأرضِ في ذلك الفتك",77,"ك",1,0],["كفَتْهُ تجاريبَ الأورِ ظُنونُهُ","ولم يكفِ صرف الدّهرِ كلَّ مجرِّبِ",78,"ب",1,0],["كفتهم انما في الذكر فاكفف","فعنك لهم بها خير اكتفاء",79,"ا",2,0],["كفٌّ تعُمُّ القاصِدينَ هِباتُها","فتكُفُّ غائلَةَ الزّمانِ المُمْحلِ",80,"ل",1,0],["كفت المناصف أن تذب أكفها","عنها إذا جعلت تفوح ذبابا",81,"ب",2,0],["كفت كفّه استسقاء سكان قطره","ولو لم يجد دهراً بقطر جهامه",82,"م",2,0],["كفّت عن السير للمرعى محاولةً","فَذُدتها قائلاً يا ناق بُشراكِ",83,"ك",1,0],["كفِتيةِ كهفٍ ما دَرَى منهم امرؤٌ","بَسَبتِ مَنامٍ مُنذُ ما هُوَ نائِمُ",84,"م",1,0],["كَفَت وَأنتَ فِي الحَشَا جَيشَ حُبشٍ إِذ","أتَى مَكَّةً لِلفَتكِ فِيهَا وَمَا فَتَك",85,"ك",1,0],["كَفِتيَةٍ بِزُمرَةِ الكِلابِ","تَقنِصُ خِرنَوصاً بِبَطنِ الغابِ",86,"ب",1,0],["كفته مكارم الآباء لكن","أبى إلا معانقة الحسان",87,"ن",1,0],["كف تفجج بالنمير بنانها","وهمى كاسحم بالقطار هتون",88,"ن",1,0],["كفٌّ تكفُّ أذى العدوّ وكفُّهُ","قبضاً وتبسطُ للعُفاةِ رجاءها",89,"ا",3,0],["كفته عن الحراس ليلاً ذوائبه","وأغنته عن حمل السلاح حواجبه",90,"ب",2,1],["كفتك عن عذلي الدموع الوكَّفُ","ونهتك عن عتبي الضلوع الرجَّفُ",91,"ف",1,1],["كفتنا من الغيث المطل بوكفه","بكل صفات المجد أبناء صنفه",92,"ه",1,0],["كَفَّتُّ ثَوبِيَ لا أَلوي عَلى أَحَدٍ","إِنّي شَنِئتُ الفَتى كَالبَكرِ يُختَطَمُ",93,"م",1,0],["كف تشيد على العلى اطنابها","نزعت رزايا النائبات بنانها",94,"ن",3,0],["كفتاةِ ليلٍ قدْ رأَتْ إيلامَها","عشقًا .. فما أخزَى المريضَ وعشْقَهُ !",95,"ق",2,0],["كفتنا صاح معذرة","فقم وانشد لنا شعرا",96,"ر",2,0],["كفته خلافة من بعد طه","بها للمؤمنين هو الأمير",97,"ر",1,0],["كفَّت بغزل جفونها عين الذي","وشَّى بها ثوب الملامة قاطبا",98,"ب",2,0],["كفٌّ ..تُمَدُّ ..عسى تَجِد ..","أخرى .. نَوَتْ .. ألا تُكَفْ",99,"ف",1,0],["كف تمد اتسترد بعزمها","وغنى صناعتها قوى أظفارها",100,"ر",3,0],["[ كَفَتْكَ العُلا وَالمَكْرُماتُ نَعِيَّهُ","فَها هِيَ لَمْ يَرْقَ لَها الآنَ مَدْمَعُ ]",101,"ع",1,0],["كفُّ تناولها العباسُ مفتخراً","فانزاحَ من دونهِ في كفِّهِ الوصفُ",102,"ف",1,1],["كفتْنِيَ إلهاماً عيونٌ بريئة","تؤسِّس لي كوخاً بعمق وُكونها",103,"ن",3,0],["كفتكَ الشاردات بعقلِ غرِّ","أبى إلا مخالطةَ الوباءِ",104,"ا",2,0],["كفتى زبيد في العما","رة وابن صورة في الأمانه",105,"ن",2,0]]}