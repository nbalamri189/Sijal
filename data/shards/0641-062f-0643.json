{"poems":[[93,"هجرت القوافي ما بنفسي ملالة","https://www.aldiwan.net/poem9055.html","عموديه"],[93,"حكاية حال","https://www.poetsgate.com/ViewPoem.aspx?id=53184",""],[556,"كتمت من أسماء ما كان علن","https://www.aldiwan.net/poem47149.html","الرجز"],[556,"يا طلل الحي بذات النقا","https://www.aldiwan.net/poem47363.html","السريع"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27259","الطويل"],[2451,"","https://poetry.dctabudhabi.ae/diwan/poem/103360","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132726","الكامل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121622","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109887","الكامل"],[5663,"فلينبت القمح","https://www.poetsgate.com/ViewPoem.aspx?id=200907",""]],"verses":[["فَدَكَّ مَباني عِزِّهِ الدَهرُ بَغتَةً","وَقَلَّمَ مِنهُ الظُفرُ فَهوَ كَليلُ",0,"ل",1,0],["فدكّ مباني غزّه الدّهر بغتة","وقلّم منه الظّفر فهو كليل",1,"ل",1,0],["فد كنتُمُ هادنتمونا مرّةً","ثمَّ اِلتَويْتُمْ هُدْنَةً على دَخَنْ",2,"ن",1,0],["فد كنتُ أخشى مِيتتِي قبلَه","فجنّب اللّهُ الّذي يُتَّقى",3,"ق",2,0],["فدكَّ الجبالَ الراسياتِ جلاله","وأصعقَ موسى فاختفى العرشُ في الكرسي",4,"س",2,0],["فدك اتئد عن لومهِ جهلاً به","فجمالُه زارٍ على اللُّوامِ",5,"م",1,0],["فد كنت ترعاهم بعين عناية","يقضى وتسهر والعيون نيام",6,"م",1,0],["فَدَكٌ قد قضَتْ عليْنا بهذا","وحديثُ العَبَّاسِ والأعْلامِ",7,"م",1,0],["فَدكِ افتِخاراً باذخاً يا بِيعةً","معصومةً من وَصمةِ الإِغواءِ",8,"ا",2,0],["فدَكًّا على دَكٍّ عبرْنا ظِلالها","فلمْ ينجُ مِنْ إِرهابِ مِعْولنا صَرْحُ",9,"ح",1,0]]}