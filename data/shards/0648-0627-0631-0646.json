{"poems":[[85,"منتزه العباس للمجتلى","https://www.aldiwan.net/poem7924.html","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54993","الطويل"],[270,"أحن إلى طيب الغدائر والفم","https://www.aldiwan.net/poem35634.html","الطويل"],[270,"تصبته ريحا شمأل وجنوب","https://www.aldiwan.net/poem35639.html","الطويل"],[271,"لاقيت يا نفس حقا ما حكى الحاكي","https://www.aldiwan.net/poem52112.html","البسيط"],[452,"بكرت مهينمة الصبا تغليسا","https://www.aldiwan.net/poem13806.html","الكامل"],[538,"دعنى من ذكر حداة الأينق","https://www.aldiwan.net/poem47549.html","عموديه"]],"verses":[["وَأَرنَبٌ كَالنَملِ إِن أُحصِيَت","تَنبُتُ في الرَملِ وَأَبياتِهِ",0,"ت",2,0],["وَأَرْنُو إِليْهَا بَاسِماً مُتَكَلَّفاً","فَتَفْشِي مِرَاراً سِرَّ خوْفِي أَدْمُعِي",1,"ع",2,0],["وأرنو إِلى الآثارِ في وحشَةِ النَّوى","فتَطلعُ من ليلِ الهُمومِ كأنجُم",2,"م",1,0],["وأرنو مَشوقاً من خِلالِ مَدامعي","إلى جبلٍ بادي الصخورِ مهيب",3,"ب",1,0],["وارنى لِقَلبي بما في سحر عينك من","حَبائِل مرصدات لي واشراك",4,"ك",1,0],["وارنّ في عذْب الأراك سواجعٌ","هيَّجْن من بُرَح الغرام رسيسا",5,"س",2,0],["وَارنُ لها جوَّابةً أُفقَ الفضَا","مَدَّت جَنَاحى طائِرٍ مُحَلِّق",6,"ق",1,0]]}