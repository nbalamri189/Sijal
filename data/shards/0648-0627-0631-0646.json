{"poems":[[87,"منتزه العباس للمجتلى","https://www.aldiwan.net/poem7924.html","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54993","الطويل"],[275,"أحن إلى طيب الغدائر والفم","https://www.aldiwan.net/poem35634.html","الطويل"],[275,"تصبته ريحا شمأل وجنوب","https://www.aldiwan.net/poem35639.html","الطويل"],[276,"لاقيت يا نفس حقا ما حكى الحاكي","https://www.aldiwan.net/poem52112.html","البسيط"],[457,"بكرت مهينمة الصبا تغليسا","https://www.aldiwan.net/poem13806.html","الكامل"],[543,"دعنى من ذكر حداة الأينق","https://www.aldiwan.net/poem47549.html","عموديه"],[905,"","https://poetry.dctabudhabi.ae/diwan/poem/146462","السريع"],[1090,"","https://poetry.dctabudhabi.ae/diwan/poem/96454","الكامل"],[1430,"","https://poetry.dctabudhabi.ae/diwan/poem/101924","الطويل"],[2177,"","https://poetry.dctabudhabi.ae/diwan/poem/138791",""],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87321","الرجز"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74220","الطويل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112674","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111423","الرجز"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52162","الخفيف"],[4684,"يا حبيبي","https://www.poetsgate.com/ViewPoem.aspx?id=201381",""],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[4830,"ذكرُ الأهل والأحبة","https://www.poetsgate.com/ViewPoem.aspx?id=195139",""],[5111,"زَهْراءُ قَرْطَاجَ","https://www.poetsgate.com/ViewPoem.aspx?id=212239",""],[5183,"بين الهوى والتجمل","https://www.poetsgate.com/ViewPoem.aspx?id=180223",""],[5189,"سأبحرُ في الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=190524",""],[5219,"نسمات عشق","https://www.poetsgate.com/ViewPoem.aspx?id=194912",""],[5302,"ملحمة الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=200060",""],[5376,"أذودُ عن الحوض ِالمنيعِ برفعةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=188375",""],[5442,"اشرفت في السواد ذات الثور","https://www.poetsgate.com/ViewPoem.aspx?id=114768",""],[5956,"الرَّصيفُ ذو الحصى العسليّ","https://www.poetsgate.com/ViewPoem.aspx?id=184884",""],[6167,"بين الإثم والهوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85542&r=&rc=25",""],[6167,"عمارة الضباء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85571&r=&rc=54",""],[6213,"دنان العشق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85492&r=&rc=95",""],[6247,"الحياة التفات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80275&r=&rc=14",""],[5190,"شرود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85062&r=&rc=137",""],[6364,"قبر في المرج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82466&r=&rc=5",""]],"verses":[["وَأَرنَبٌ كَالنَملِ إِن أُحصِيَت","تَنبُتُ في الرَملِ وَأَبياتِهِ",0,"ت",2,0],["وَأَرْنُو إِليْهَا بَاسِماً مُتَكَلَّفاً","فَتَفْشِي مِرَاراً سِرَّ خوْفِي أَدْمُعِي",1,"ع",2,0],["وأرنو إِلى الآثارِ في وحشَةِ النَّوى","فتَطلعُ من ليلِ الهُمومِ كأنجُم",2,"م",1,0],["وأرنو مَشوقاً من خِلالِ مَدامعي","إلى جبلٍ بادي الصخورِ مهيب",3,"ب",1,0],["وارنى لِقَلبي بما في سحر عينك من","حَبائِل مرصدات لي واشراك",4,"ك",1,0],["وارنّ في عذْب الأراك سواجعٌ","هيَّجْن من بُرَح الغرام رسيسا",5,"س",2,0],["وَارنُ لها جوَّابةً أُفقَ الفضَا","مَدَّت جَنَاحى طائِرٍ مُحَلِّق",6,"ق",1,0],["وارنُ لبلوى دنفٍ حاله","مفصل إيضاحه مُجمَلُ",7,"ل",1,0],["وأَرَنَّ حَادِيهِم عَلَى أُخرَاهُمُ","بِصُلاَصِلٍ خَلفَ الرِّكَابِ وَأزملِ",8,"ل",1,0],["وأرنوا لها بين الخيام ودونها","رقيب ومغناها إلي قريب",9,"ب",1,0],["وارنجت الارض والسبع الشداد وقد","أصاب أهل السموات العلى الوجل",10,"ل",1,0],["وآرنُقخٌ للكُحِّ وكُن مُنتَبِه","بعد حسابٍ سوفَ أُنبيكَ به",11,"ه",1,0],["وَأَرنو إِلى ذاكَ المُحيا وَحسنه","وَأسمع في ضمن العِتاب كَلامَها",12,"م",3,0],["وأرني طَلعَتَهُ الرَشيده","والغَرّةَ الباهرةَ الحميده",13,"ه",1,0],["وأرنِيا ذَاتش الكُرُومِ المُخصِبه","وميدِيا ونِيسَةَ المُقَرَّبَه",14,"ه",1,0],["وَارِني في النهارِ عن أَعيُنِ الناسِ","فإني خِدنُ الليالي السُّودِ",15,"د",1,0],["وأرنو للسراب رجاء سقيا","فتعطش مهجة الصادي اللبيب",16,"ب",1,0],["وأرنو إلى الدنيا بعين تفكر","فلم أرني أرنو إلى غير هجران",17,"ن",1,0],["وارنو وجوها كالبدور اذا بدتْ","عليها ابتساماتُ اللقاء الروائعُ",18,"ع",1,0],["وَأَرْنُو إِلىَ وَجْهِيْ أُمَنِّيهِ بِالْمُنَى","وَأتْلُو صَلاَةً لِلْأمَانِ تُبَشِّرُ",19,"ر",1,0],["وأرنوك في قربي وبعدي كأنني","أرى الله في آياته متكرما",20,"م",2,0],["وأرنُو إلى أن أكون بديعاً","ونجماً يُضيءُ بِساحِ الفضا",21,"ا",1,0],["وأرنو كي أنال وصال خل ..","فأزهرت الأقاحي في رباها",22,"ا",3,0],["وأرنو لأن تحيا بحب أزقتي","ولكن صبياني هنا ما تنازلوا",23,"ل",3,0],["وأرنو الى العلياء لا أخطب النوى","وغيري له دنياه حيث الغنائمُ",24,"م",1,0],["وأرنا بنورها كل خير","لم يحل علمه لنا في الضمير",25,"ر",1,0],["وأرنو وراهُ حصىً عاطفيًّ","يُذكِّرني برصيف الطريقْ",26,"ق",1,0],["وأرنو سفاهاً الي كل لحظٍ","وإنَّ اللحاظَ بريقٌ هَوَى",27,"و",2,0],["وارنُ وادنُ من خطوبِ الكونِ فانثرها هباءْ","كن خطيباً في نواصي الكونِ في بحرِ السناءْ",28,"ا",2,0],["وأرنو نحو لؤلؤة","فأعشق لحظكِ الراني",29,"ن",2,0],["وأرنو بليلي: أَلا من سبيلٍ؟","ويَرتدُّ طرفي حسيراً إ ليّا",30,"ي",2,0],["وأرنو إلى الشمسِ وقت الغروبْ","فأعجبُ من صنعِ ربٍّ حسيبْ",31,"ب",1,1],["وأرنو إلىطيفٍ يُغيضُ ابتسامَه","ذبولاً على كفّ الفناء المُباكرِ",32,"ر",1,0]]}