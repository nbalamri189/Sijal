رّ","https://www.poetsgate.com/ViewPoem.aspx?id=213762",""],[5431,"ليس لي في الأمر يد!!...","https://www.poetsgate.com/ViewPoem.aspx?id=214123",""],[5680,"قريب على بعد أنا منك","https://www.poetsgate.com/ViewPoem.aspx?id=204357",""],[5720,"مناجي","https://www.poetsgate.com/ViewPoem.aspx?id=206474",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5848,"آلهة أغريق","https://www.poetsgate.com/ViewPoem.aspx?id=53457",""],[5956,"ذَبُلَ الحب الكبير","https://www.poetsgate.com/ViewPoem.aspx?id=182133",""],[2991,"يا سَريا سما به الإسراء","https://diwany.org/%D9%8A%D8%A7-%D8%B3%D9%8E%D8%B1%D9%8A%D8%A7-%D8%B3%D9%85%D8%A7-%D8%A8%D9%87-%D8%A7%D9%84%D8%A5%D8%B3%D8%B1%D8%A7%D8%A1/%D9%85%D8%AD%D9%85%D8%AF-%D9%81%D8%B1%D8%BA%D9%84%D9%8A-%D8%A7%D9%84%D8%B7%D9%87%D8%B7%D8%A7%D9%88%D9%8A/","الخفيف"],[572,"فما وَحْشِيَّة ٌ أدماءُ ترعى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9499&r=&rc=356",""]],"verses":[["بِأَجهَدَ مِنّي حَرَّ شَوقٍ وَلَوعَةٍ","عَلَيكِ وَلَكِنَّ العَدوَّ عَداني",0,"ن",2,0],["بِأَجْدَى إِذَا ضَنَّ الْغَمَامُ مِنَ الْحَيَا","وَأَهْدَى إِذَا جَنَّ الظَّلاَمُ مِنَ النَّجْمِ",1,"م",1,0],["بِأَجَلَّ مِنْ نَظَرِي لِوَجْهِكَ سَاعَةً","عِنْدِي وَأَحْلَى مِنْ ثَنَائِكَ فِي فَمِي",2,"م",2,0],["بِأَجوَدَ مِنهُ نائِلاً إِنَّ بَعضَهُم","كَفى ما لَهُ بِاِسمِ العَطاءِ المُوَعَّدِ",3,"د",1,0],["بِأَجوَدَ مِنهُ بِأُدمِ الرِكا","بِ لَطَّ العَلوقُ بِهِنَّ اِحمِرارا",4,"ر",2,0],["بِأَجوَدَ مِنهُ بِما عِندَهُ","فَيُعطي المِئينَ وَيُعطي البُدورا",5,"ر",2,0],["بِأَجوَدَ مِنهُ نائِلاً إِنَّ بَعضَهُم","إِذا سُئِلَ المَعروفَ صَدَّ وَجَمجَما",6,"م",2,0],["بِأَجوَدَ مِنهُ بِما عِندَهُ","إِذا ما سَمائُهُم لَم تَغِم",7,"م",1,0],["بِأَجرَأَ مِن ذاكَ الوَزيرِ مُصادِماً","إِرادَةَ إِسماعيلَ وَالمَوتُ يَسمَعُ",8,"ع",1,0],["بِأَجرَعَ مِقفار بَعيدٍ مِنَ القُرى","فَلاةٍ وَحُفَّت بِالفَلاةِ جَوانِبُه",9,"ب",2,0],["بأجزع من فؤادي يوم قالوا","برغم منك فارقك الحبيب",10,"ب",1,0],["بِأَجَشِّ الصَوتِ يَعبوبٍ إِذا","طَرَقَ الحَيَّ مِنَ الغَزوِ صَهَل",11,"ل",1,0],["بِأَجوَدَ سَيباً مِن يَزيدَ إِذا غَدَت","بِهِ بُختُهُ يَحمِلنَ مُلكاً وَسُؤدَدا",12,"د",2,0],["بِأَجوَدَ مِن مَأوى اليَتامى وَملَجَأِ ال","مُضافِ وَوَهّابِ القِيانِ أَبي عَمروِ",13,"ر",2,0],["بأجمل منه من فعل الجميل","فكنا القادرين الصافحينا",14,"ن",2,0],["بِأَجسامٍ يَحَرُّ القَتلُ فيها","وَما أَقرانُها إِلّا الطَعامُ",15,"م",1,0],["بِأَجوَدَ عِندَ الجودِ مِنكَ وَلا الَّذي","عَلا بِغُثاءٍ سورَ عانَةَ غارِبُه",16,"ب",2,0],["بِأَجرَدٍ مِلءِ الحِزامِ سَلهَبِ","مُختَبَرٍ كَالبَطَلِ المُجَرَّبِ",17,"ب",1,0],["بِأَجنِحَةٍ يَمُرنَ بِهِنَّ حُردٍ","وَأَعناقٍ حُنينَ لِغَيرِ أَونِ",18,"ن",1,0],["بِأَجوَدَ مِنكَ وَلا مُدجِنٌ","تَدَلَّت غَياطِلُهُ الدالِحَه",19,"ح",2,0],["بِأَجرَعَ جَعدِ الثَرى مُكتَسٍ","مِنَ البَقلِ حَوذانَهُ وَالدُعاعا",20,"ع",2,0],["بِأَجرَأَ مِنهُ حَدَّ بَأسٍ وَعَزمَةٍ","إِذا ما نَزا قَلبُ الجَبانِ إِلى النَحرِ",21,"ر",1,0],["بأجراحٍ يميلُ الطعنُ عنها","إلى الأردافِ تزلجُ في الفقاحِ",22,"ح",1,0],["بأجنحةٍ كرؤى الخالدين","لغير الصبابةِ لم تخفِقِ",23,"ق",1,0],["بأجل من نظري لوجهك ساعة","عندي وأحلى من ثنائك في فم",24,"م",1,0],["بَأَجْودَ مِنْكَ، ولاَ مُدْجِنٌ","عَلَى الجُرْدِ تَهْوِي هُوِيَّ الدِّلاَ",25,"ل",2,0],["بِأَجنِحَةِ الفُتخِ اِرتَقَيتَ مُحَلِّقَاً","وَأَحسَبُهُم طاروا بِأَجنِحَةِ الرُبدِ",26,"د",1,0],["باجتماع الشهوة العل","يا مع السفلى لعله",27,"ل",2,0],["بإجاص بين في سيسبان سلوة","وعنّاب وتزيد آيس",28,"س",1,0],["بِأَجوَدَ مِن أَبي حَفصٍ إِذا ما","أَتَتهُ العيسُ تَختَرِقُ النِقالا",29,"ل",2,0],["بِأَجرَأَ مِنهُ حينَ تَختَلِفُ القَنا","وَتُدعى نَزالِ في القَماقِمةِ البُهَم",30,"م",1,0],["بأجرد لو كلفت سرعة سيره","وشأو مداه البرق أطرق مهطعا",31,"ع",2,0],["بأجمل من أسنانِكِ البيضِ في فمٍ","يكادُ إذا ما افترَّ يمتصُّهُ النَّحل",32,"ل",1,0],["بأجملَ من وجهٍ تُرفرِفُ نفسُهُ","عليهِ وفي العَينَينِ تُلقي خيالها",33,"ل",3,0],["بِأجْوَدَ مِنْ نَدى كَفَّيْكَ جُوداً","وَلا طامِي الْغَوارِبِ ذُو الثجاجِ",34,"ج",1,0],["بِأَجَلِّ مَوْلُودٍ لأَكْرَمِ والِدٍ","سَمْجٍ مُبارَكِ مَوْلِدٍ مَيْمُونِهِ",35,"ن",2,0],["بِأَجوَدَ مِنهُ إِذا جِئتَهُ","عَلى حادِثِ الدَهرِ يَوماً نَوالا",36,"ل",2,0],["بأجملِ الخَلْقِ موْصوْف ومتّصفٌ","وبالأمانةِ والأخلاقِ مُنفردُ",37,"د",1,0],["بأجيادها جادت سحائب رحمة","على كل ذي قلبٍ منيبٍ وحاضر",38,"ر",1,0],["بأجدادكم قد أظهر اللَه دينه","وأَشهره في شرقها والمغارب",39,"ب",1,0],["باجتماع شملي","من قبل أن تغدو إلى الرمال",40,"ل",1,0],["بأجمل صبر في القضا متأدبا","باخلاص قلب في عبادة رحمن",41,"ن",1,0],["بإجْراء مالٍ للعُفاةِ معونةً","وإجراء ماءٍ بالفلاةِ مَعين",42,"ن",1,0],["بأجلّ من أفردته بفرائدي","وأجلّ من قَلَّدْتُه بقلائدي",43,"د",2,0],["بأجلّ من ولي الأُمور","وجادها حلاًّ وعقدا",44,"د",2,0],["بأَجْمَعِ مولىً لشملِ العبيدِ","وأَخشَعِ عبدٍ لربِّ العبادِ",45,"د",1,0],["بأجْرأ من غِياثِ الدين قلْباً","اذا ما الشمسُ أغْدفتِ اللِّثاما",46,"م",2,0],["بأجْرى من الفضل الإِمامِ عزيمةً","إذا ما عدا العزْم الجريءُ المُقحِّما",47,"م",2,0],["بأجلَ منه مواهباً ورغائباً","لا زال هذا المجد حول فنائه",48,"ا",3,0],["بأَجْرَعِهِ من لَعْلَعِ الحَيِّ لوعَةٌ","أَقامَتْ على الكاساتِ قائِمَ جَرْعِهِ",49,"ع",2,0],["بأجفُنِ بيضِه حُمرُ المَنايا","وتحتَ قِبابه بيضُ الأماني",50,"ن",2,0],["بأَجْزَعَ مِنِّي إنْ نَظضرْتُ مَعارِفِي","بِهِمْ فَاقَةٌ مَسْتُورَةٌ بالتَّجلُّدِ",51,"د",1,0],["بأَجلادٍ من التَّتْريفِ بيضِ","وأعراضٍ من التَّقْريف غُبْسِ",52,"س",1,0],["بِأَجسامٍ منَ التّقوى مِراضٍ","لِمبصرها وأديانٍ صِحاحِ",53,"ح",1,0],["بِأَجْزَعَ مِنْكَ يَوْمَ تَقُولُ غَدْرَاً","أَفِي الغَادِيْنَ أَنْتَ أَمْ أَنْتَ ثَاوِي",54,"ي",1,0],["بأَجرأَ منه عَلى بُهمَةٍ","وأَقدَم منه صِراحا صِداقا",55,"ق",2,0],["بِأَجرَدَ مُعرِقِ الطَّرفَينِ يُدلي","بِنُسبَةِ ذي الخِمارِ وَذي العَوالي",56,"ل",2,0],["بأجسامِ يَلِجُنَ السَّردَ بيضاً","وَهاماتٍ تَصُكُّ البيضَ صُلعا",57,"ع",2,0],["بأجزاء مأكول لتنطيف نطفة","حكيم تجلى في دقائق حكمة",58,"ه",1,0],["بأجلِّ هادٍ للخلائِقِ مُرْشدٍ","وأتمِّ نورٍ للْخَلائقِ مُقْبسِ",59,"س",1,0],["بِإِجازَةٍ غَرّاء قَد شُرِّفت مِن","شَيخي الجَليلِ الماجِدِ الشَّهمِ السَّري",60,"ر",2,1],["بأجياد له أطواق فضل","وفي أخرى تحكمتِ الظُباةُ",61,"ه",1,0],["باجدى من نداك وأين منه","عطايا آل برمك والفرات",62,"ت",1,0],["بأجمل منه وهو للشعر منصت","ضحوك المحيا كالصباح وسيم",63,"م",1,0],["بِأَجرَأَ جُرأَةً مِنهُ وَأَدهى","إِذا ما كارِبُ المَوتَ اِستَدارا",64,"ر",2,0],["بأجودَ من أنواء كفِّكَ ديمةً","وأسخى بوبَلي نائلٍ وحباءِ",65,"ا",2,0],["بأجَلِّ أحوالٍ وأيمنِ مقدمٍ","وأتمِّ إقبالٍ يليه دوامُ",66,"م",1,0],["بِأَجداث لَهُم ظل ظَليل","بِهُم نَرجو الشَفاعة يَوم عَرض",67,"ض",1,0],["باجدى من حيا المزن","إذا نحنُ سألناهُ",68,"ا",2,0],["باجتماعٍ من نَدامى سراعٍ","واستماعٍ لطريف الأغاني",69,"ن",2,0],["بأجوَد من يُمناكَ يا ذَهْلُ في النَّدى","بما وَهبت من انعُمٍ وازلَّتِ",70,"ت",1,0],["باجود مني لدى غاية","ومد اليدين ونعت الكرم",71,"م",1,0],["بِأَجوَدَ مِنّي يَومَ كَفَّتُّ عادِياً","وَأَخطَأَني خَلفَ الثَنِيَّةِ أَسهُمُ",72,"م",1,0],["بِأَجوَدَ مِن كَفِّ الوَزير مُحَمّد","إِذا ما تَوالَت لِلسِنين مُحُولُ",73,"ل",1,0],["بِأَجمادِ العَقيقِ إِلى مُراخٍ","فَنَعفِ سُوَيقَةٍ فَنِعافِ نَسرِ",74,"ر",1,1],["بِإِجّانَةٍ لَو أَنَّهُ خَرَّ بازِلٌ","مِنَ البُختِ فيها ظَلَّ لِلشقِّ يَسبَحُ",75,"ح",1,0],["بأجسادهن المنعمات تأوُّدٌ","وللدرّ في أجيادهن قعاقع",76,"ع",1,0],["باجازيه الوفا والنصح مني","ولو جازاني بهيره وصده",77,"د",2,0],["بأجناد مجندة كثاف","تكل الطرف مثل الطيلسان",78,"ن",1,0],["بِأَجزَعَ مِنّي إِذ تَقولُ عَدَيتُهُ","تَراكَ عَلى رَغمِ الزَّمانِ تَراني",79,"ن",2,0],["باجتماع للشمل في مصر لازل","ت جميع الشمل الكريم المفدّى",80,"د",2,0],["بأجل من يضنو لسطوة قهره","قنن الجبال مقلدا بزحاف",81,"ف",1,0],["بأجدلَ من حُمر الصقور مؤدَّب","وأكرمُ ما جرَّبتَ منها الأحامر",82,"ر",1,0],["بأجفانِ لطفٍ قبَلوني وقبّلوا","كذاك جفوني فهي أفضلُ قبلةِ",83,"ه",1,0],["بأَجَلَّ من إِنعامِ مريمَ مَن بها","بالفضل حقاً قد يُؤَمُّ ويُقتدَي",84,"د",2,0],["باجتلاء المدام في الأكواب","عندما صفقت برقص الحباب",85,"ب",1,1],["بإجَّانَةٍ لَو أَنَّها خَرَّ بازِلٌ","مِن البُختِ فيها ظَلَّ للشِّقِّ يَسبَحُ",86,"ح",1,0],["بأجودَ مني لا ولا البحرُ هيَّجت","أواذَّيه يوماً عَرانينُ شِمْآلِ",87,"ل",1,0],["بأجردَ مثل قضيب الأشا","مستأنس تئقٍ هيكل",88,"ل",1,1],["بأَجهَرِ الصَّوتِ نَادَوهُم وما لَبِثُوا","أَن أَقبَلُوا مُستَتِمِّي العَدِّ والعُددِ",89,"د",1,0],["بأجفانك المرضى وَلَو لَم تكن قضَت","عَلى مهج جرحى فدتها من القسم",90,"م",1,0],["بأجرأ منه إذا ما الشجا","عُ لم يحتمله قوى زجلهِ",91,"ل",2,0],["بأجانحا للاتحاد وحزبه","دع قول أمسى فإن قولي في غد",92,"د",1,0],["بأجر مُهديه وسع الكون ضاق كما","من دهرنا ضاق ما قد كان منفسحا",93,"ح",2,0],["بأجمل منظرا من وجه ليلى","إذا ذكر الخرائد والحسانُ",94,"ن",1,0],["بأجيب الكرسي قبالك وباطلق مهرة المسجون","احاسيسك تصفق لي تزيد التاره بتاره",95,"ر",2,0],["باجتماعٍ لها هنالك أمسى","لفروعٍ منها عليك انطواء",96,"ا",2,0],["ب اجسادها للدين هي درع وحزام","واِقدامها موج (ن) قوي التطامه",97,"م",2,0],["بأجنِحتي يطيرُ مُحلقا بي","وذي الأحلامِ شهدتُها بحبري",98,"ر",2,0],["بإجماع أهل العلم من كل عالم","وذلك كالأعمى لدى كل حازم",99,"م",1,0],["بأجوبة تسمو وتسمق بالهدى","سماء مبانيها عن الأعتدى جلوى",100,"و",2,0],["بأجواف طيرٍ جاء في النص أنها","لتسرح في الجنات تعلق للثمر",101,"ر",1,0],["باجتراحات شهقةٍ في بياضٍ","عابق الليلِ لاهب وشهيّ",102,"ي",1,0],["باجتياحٍ يُسرّعُ القلبَ رعبا","أجْجّيها : إنّ الوغى إيحاءُ",103,"ا",2,0],["باجتراحٍ واطّراح","وامتشاقٍ مستعدْ",104,"د",1,0],["بأجسامنا نفدي وننصر ديننا","وننشره نورا ونقبضه جمرا",105,"ر",2,0],["بأجملِ ما تَمَثَّلَهُ شبابٌ","وأزهىٰ ما يكونُ من الجمالِ",106,"ل",1,0],["بأجداده الروحانيين كراسي","النبوة عينا بل عروش الرسالتي",107,"ت",2,0],["باجيك مارد والجفاف ابريق","والبرد موحش واليدين لحاف",108,"ف",1,0],["باجتهاد من كِلينا","نغرس الصخرَ زهورْ",109,"ر",1,0],["باِجتِلاء لورد وجه تفتح","وَهوَ حقاً بحسنه يتمدَّح",110,"ح",1,0],["بأجزَعَ منكِ يومَ يقولُ خُلّي","أفي الغادِينَ أنتَ أَمَ انتَ ثَاوي",111,"ا",3,0]]}