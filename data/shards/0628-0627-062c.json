{"poems":[[34,"وما حائمات حمن يوما وليلة","https://www.aldiwan.net/poem4939.html","الطويل"],[77,"ألا هكذا تبنى المدارس للعلم","https://www.aldiwan.net/poem36089.html","الطويل"],[77,"فتحت سعودك كل باب مبهم","https://www.aldiwan.net/poem36122.html","الكامل"],[9,"أترحل من ليلى ولما تزود","https://www.aldiwan.net/poem21924.html","الطويل"],[9,"أأزمعت من آل ليلى ابتكارا","https://www.aldiwan.net/poem21940.html","المتقارب"],[9,"غشيت لليلى بليل خدورا","https://www.aldiwan.net/poem21941.html","المتقارب"],[9,"ألم خيال من قتيلة بعدما","https://www.aldiwan.net/poem21981.html","الطويل"],[9,"أتهجر غانية أم تلم","https://www.aldiwan.net/poem21984.html","المتقارب"],[86,"رياض أفق من غمرة الموت واستمع","https://www.aldiwan.net/poem10488.html","الطويل"],[30,"وقفت على ربع لمية ناقتي","https://www.aldiwan.net/poem29613.html","الطويل"],[88,"بدت كالشمس يحضنها الغروب","https://www.aldiwan.net/poem45008.html","الوافر"],[4,"إن تقوى ربنا خير نفل","https://www.aldiwan.net/poem21191.html","الرمل"],[29,"صحا القلب إلا من ظعائن فاتني","https://www.aldiwan.net/poem6052.html","الطويل"],[29,"ألا يا اسلمي يا أم بشر على الهجر","https://www.aldiwan.net/poem6070.html","الطويل"],[85,"جلوسك أم سلام العالمينا","https://www.aldiwan.net/poem7798.html","الوافر"],[43,"فؤاد ما تسليه المدام","https://www.aldiwan.net/poem10538.html","الوافر"],[28,"أبا حاتم ما حاتم في زمانه","https://www.aldiwan.net/poem1270.html",""],[66,"قد ارتدى ذيل الظلام الأشيب","https://www.aldiwan.net/poem40942.html","الرجز"],[39,"أمن دمن بشاجنة الحجون","https://www.aldiwan.net/poem53733.html","الوافر"],[39,"قفا فاسألا الدمنة الماصحه","https://www.aldiwan.net/poem53809.html","المتقارب"],[40,"خليلي عوجا نحي نباعا","https://www.aldiwan.net/poem42311.html","المتقارب"],[52,"سلمت أمير المؤمنين على الدهر","https://www.aldiwan.net/poem27019.html","الطويل"],[48,"قل لأبي الأنكح إن جئته","https://www.aldiwan.net/poem66243.html","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[77,"فتحت سعودك كل باب مبهم","https://www.poetsgate.com/ViewPoem.aspx?id=34204",""],[39,"قفَا فاسألاَ الدِّمنَة َ المَاصحَة ْ","https://www.poetsgate.com/ViewPoem.aspx?id=4239",""],[143,"مساعيك لا تحصى فتدرك بالعد","https://www.aldiwan.net/poem11749.html","الطويل"],[186,"يا معل الناس بالعي","https://www.aldiwan.net/poem43457.html","الرمل"],[186,"شربت لما في القلب منكم شريبة","https://www.aldiwan.net/poem43723.html","الطويل"],[195,"علاني الشيب واشتعل اشتعالا","https://www.aldiwan.net/poem54419.html","الوافر"],[203,"ألا من لعين باتت الليل لم تنم","https://www.aldiwan.net/poem68152.html","الطويل"],[261,"سقاك الحيا ريا وحياك أربعا","https://www.aldiwan.net/poem38378.html","الطويل"],[270,"قد اجتمعت فيك المحاسن يا جمل","https://www.aldiwan.net/poem35426.html","الطويل"],[270,"هزئتم بنفس تجهلون خلالها","https://www.aldiwan.net/poem35616.html","الطويل"],[280,"متى أنا طاعن قلب الفجاج","https://www.aldiwan.net/poem60722.html","الوافر"],[280,"أترى الهلال أنار ضوء جبينه","https://www.aldiwan.net/poem60770.html","الكامل"],[287,"كلفت بليلى خدين الشباب","https://www.aldiwan.net/poem1913.html","المتقارب"],[302,"يا صاحب القبة الخضراء","https://www.aldiwan.net/poem65690.html","البسيط"],[304,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[304,"جزى الله خيرا سيدا وابن سيد","https://www.aldiwan.net/poem16831.html","الطويل"],[304,"يا نسيم الأسحار","https://www.aldiwan.net/poem16906.html","عموديه"],[304,"أطع ربك البارى وصفوة رحمان","https://www.aldiwan.net/poem16908.html","الطويل"],[364,"وبرق مشيب في ظلام ذوائب","https://www.aldiwan.net/poem60634.html","الطويل"],[416,"أعلمت أي معالم ومعاهد","https://www.aldiwan.net/poem54097.html","الطويل"],[416,"قلب يذوب عليك وجدا","https://www.aldiwan.net/poem54142.html","مجزوء الكامل"],[439,"وفيهن أضحيت يوم الأضاحي","https://www.aldiwan.net/poem34845.html","المتقارب"],[461,"جلبت الخيل تمرح بالعوالي","https://www.aldiwan.net/poem15906.html","الوافر"],[461,"ضروب قذال القرن فذا لدى الوغى","https://www.aldiwan.net/poem16039.html","الطويل"],[495,"برق الربيع لنا برونق مائه","https://www.aldiwan.net/poem9761.html","الكامل"],[500,"رآني بمرط الإنكسار أخو الهوى","https://www.aldiwan.net/poem37972.html","الطويل"],[514,"تصاحى وهو مخمور الجنان","https://www.aldiwan.net/poem20821.html","الوافر"],[529,"وما ذات أفراح جياع بعشها","https://www.aldiwan.net/poem37456.html","الطويل"],[551,"ألا إني وهبت اليوم نفسي","https://www.aldiwan.net/poem47748.html","الوافر"],[551,"ألا يا قوم للقدر المتاح","https://www.aldiwan.net/poem47892.html","الوافر"],[567,"رأيت الرياسة مقرونة","https://www.aldiwan.net/poem69475.html","المتقارب"],[583,"كبيشة عرسي تمنى الطلاقا","https://www.aldiwan.net/poem443.html",""]],"verses":[["بِأَجهَدَ مِنّي حَرَّ شَوقٍ وَلَوعَةٍ","عَلَيكِ وَلَكِنَّ العَدوَّ عَداني",0,"ي",1,0],["بِأَجْدَى إِذَا ضَنَّ الْغَمَامُ مِنَ الْحَيَا","وَأَهْدَى إِذَا جَنَّ الظَّلاَمُ مِنَ النَّجْمِ",1,"م",1,0],["بِأَجَلَّ مِنْ نَظَرِي لِوَجْهِكَ سَاعَةً","عِنْدِي وَأَحْلَى مِنْ ثَنَائِكَ فِي فَمِي",2,"م",2,0],["بِأَجوَدَ مِنهُ نائِلاً إِنَّ بَعضَهُم","كَفى ما لَهُ بِاِسمِ العَطاءِ المُوَعَّدِ",3,"د",1,0],["بِأَجوَدَ مِنهُ بِأُدمِ الرِكا","بِ لَطَّ العَلوقُ بِهِنَّ اِحمِرارا",4,"ر",2,0],["بِأَجوَدَ مِنهُ بِما عِندَهُ","فَيُعطي المِئينَ وَيُعطي البُدورا",5,"ر",2,0],["بِأَجوَدَ مِنهُ نائِلاً إِنَّ بَعضَهُم","إِذا سُئِلَ المَعروفَ صَدَّ وَجَمجَما",6,"م",2,0],["بِأَجوَدَ مِنهُ بِما عِندَهُ","إِذا ما سَمائُهُم لَم تَغِم",7,"م",1,0],["بِأَجرَأَ مِن ذاكَ الوَزيرِ مُصادِماً","إِرادَةَ إِسماعيلَ وَالمَوتُ يَسمَعُ",8,"ع",1,0],["بِأَجرَعَ مِقفار بَعيدٍ مِنَ القُرى","فَلاةٍ وَحُفَّت بِالفَلاةِ جَوانِبُه",9,"ب",2,0],["بأجزع من فؤادي يوم قالوا","برغم منك فارقك الحبيب",10,"ب",1,0],["بِأَجَشِّ الصَوتِ يَعبوبٍ إِذا","طَرَقَ الحَيَّ مِنَ الغَزوِ صَهَل",11,"ل",1,0],["بِأَجوَدَ سَيباً مِن يَزيدَ إِذا غَدَت","بِهِ بُختُهُ يَحمِلنَ مُلكاً وَسُؤدَدا",12,"د",2,0],["بِأَجوَدَ مِن مَأوى اليَتامى وَملَجَأِ ال","مُضافِ وَوَهّابِ القِيانِ أَبي عَمروِ",13,"ر",2,0],["بأجمل منه من فعل الجميل","فكنا القادرين الصافحينا",14,"ن",2,0],["بِأَجسامٍ يَحَرُّ القَتلُ فيها","وَما أَقرانُها إِلّا الطَعامُ",15,"م",1,0],["بِأَجوَدَ عِندَ الجودِ مِنكَ وَلا الَّذي","عَلا بِغُثاءٍ سورَ عانَةَ غارِبُه",16,"ب",2,0],["بِأَجرَدٍ مِلءِ الحِزامِ سَلهَبِ","مُختَبَرٍ كَالبَطَلِ المُجَرَّبِ",17,"ب",1,0],["بِأَجنِحَةٍ يَمُرنَ بِهِنَّ حُردٍ","وَأَعناقٍ حُنينَ لِغَيرِ أَونِ",18,"ن",1,0],["بِأَجوَدَ مِنكَ وَلا مُدجِنٌ","تَدَلَّت غَياطِلُهُ الدالِحَه",19,"ح",2,0],["بِأَجرَعَ جَعدِ الثَرى مُكتَسٍ","مِنَ البَقلِ حَوذانَهُ وَالدُعاعا",20,"ع",2,0],["بِأَجرَأَ مِنهُ حَدَّ بَأسٍ وَعَزمَةٍ","إِذا ما نَزا قَلبُ الجَبانِ إِلى النَحرِ",21,"ر",1,0],["بأجراحٍ يميلُ الطعنُ عنها","إلى الأردافِ تزلجُ في الفقاحِ",22,"ح",1,0],["بأجنحةٍ كرؤى الخالدين","لغير الصبابةِ لم تخفِقِ",23,"ق",1,0],["بأجل من نظري لوجهك ساعة","عندي وأحلى من ثنائك في فم",24,"م",1,0],["بَأَجْودَ مِنْكَ، ولاَ مُدْجِنٌ","عَلَى الجُرْدِ تَهْوِي هُوِيَّ الدِّلاَ",25,"ل",2,0],["بِأَجنِحَةِ الفُتخِ اِرتَقَيتَ مُحَلِّقَاً","وَأَحسَبُهُم طاروا بِأَجنِحَةِ الرُبدِ",26,"د",1,0],["باجتماع الشهوة العل","يا مع السفلى لعله",27,"ل",2,0],["بإجاص بين في سيسبان سلوة","وعنّاب وتزيد آيس",28,"س",1,0],["بِأَجوَدَ مِن أَبي حَفصٍ إِذا ما","أَتَتهُ العيسُ تَختَرِقُ النِقالا",29,"ل",2,0],["بِأَجرَأَ مِنهُ حينَ تَختَلِفُ القَنا","وَتُدعى نَزالِ في القَماقِمةِ البُهَم",30,"م",1,0],["بأجرد لو كلفت سرعة سيره","وشأو مداه البرق أطرق مهطعا",31,"ع",2,0],["بأجمل من أسنانِكِ البيضِ في فمٍ","يكادُ إذا ما افترَّ يمتصُّهُ النَّحل",32,"ل",1,0],["بأجملَ من وجهٍ تُرفرِفُ نفسُهُ","عليهِ وفي العَينَينِ تُلقي خيالها",33,"ل",3,0],["بِأجْوَدَ مِنْ نَدى كَفَّيْكَ جُوداً","وَلا طامِي الْغَوارِبِ ذُو الثجاجِ",34,"ج",1,0],["بِأَجَلِّ مَوْلُودٍ لأَكْرَمِ والِدٍ","سَمْجٍ مُبارَكِ مَوْلِدٍ مَيْمُونِهِ",35,"ن",2,0],["بِأَجوَدَ مِنهُ إِذا جِئتَهُ","عَلى حادِثِ الدَهرِ يَوماً نَوالا",36,"ل",2,0],["بأجملِ الخَلْقِ موْصوْف ومتّصفٌ","وبالأمانةِ والأخلاقِ مُنفردُ",37,"د",1,0],["بأجيادها جادت سحائب رحمة","على كل ذي قلبٍ منيبٍ وحاضر",38,"ر",1,0],["بأجدادكم قد أظهر اللَه دينه","وأَشهره في شرقها والمغارب",39,"ب",1,0],["باجتماع شملي","من قبل أن تغدو إلى الرمال",40,"ل",1,0],["بأجمل صبر في القضا متأدبا","باخلاص قلب في عبادة رحمن",41,"ن",1,0],["بإجْراء مالٍ للعُفاةِ معونةً","وإجراء ماءٍ بالفلاةِ مَعين",42,"ن",1,0],["بأجلّ من أفردته بفرائدي","وأجلّ من قَلَّدْتُه بقلائدي",43,"د",2,0],["بأجلّ من ولي الأُمور","وجادها حلاًّ وعقدا",44,"د",2,0],["بأَجْمَعِ مولىً لشملِ العبيدِ","وأَخشَعِ عبدٍ لربِّ العبادِ",45,"د",1,0],["بأجْرأ من غِياثِ الدين قلْباً","اذا ما الشمسُ أغْدفتِ اللِّثاما",46,"م",2,0],["بأجْرى من الفضل الإِمامِ عزيمةً","إذا ما عدا العزْم الجريءُ المُقحِّما",47,"م",2,0],["بأجلَ منه مواهباً ورغائباً","لا زال هذا المجد حول فنائه",48,"ا",3,0],["بأَجْرَعِهِ من لَعْلَعِ الحَيِّ لوعَةٌ","أَقامَتْ على الكاساتِ قائِمَ جَرْعِهِ",49,"ع",2,0],["بأجفُنِ بيضِه حُمرُ المَنايا","وتحتَ قِبابه بيضُ الأماني",50,"ن",2,0],["بأَجْزَعَ مِنِّي إنْ نَظضرْتُ مَعارِفِي","بِهِمْ فَاقَةٌ مَسْتُورَةٌ بالتَّجلُّدِ",51,"د",1,0],["بأَجلادٍ من التَّتْريفِ بيضِ","وأعراضٍ من التَّقْريف غُبْسِ",52,"س",1,0],["بِأَجسامٍ منَ التّقوى مِراضٍ","لِمبصرها وأديانٍ صِحاحِ",53,"ح",1,0],["بِأَجْزَعَ مِنْكَ يَوْمَ تَقُولُ غَدْرَاً","أَفِي الغَادِيْنَ أَنْتَ أَمْ أَنْتَ ثَاوِي",54,"ي",1,0],["بأَجرأَ منه عَلى بُهمَةٍ","وأَقدَم منه صِراحا صِداقا",55,"ق",2,0]]}