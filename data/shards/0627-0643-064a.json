{"poems":[[55,"لمن دمن بذي سلم وضال","https://www.aldiwan.net/poem29896.html","الوافر"],[45,"لجنية أم غادة رفع السجف","https://www.aldiwan.net/poem9728.html","الطويل"],[107,"أخالد إنك ذو نجدة","https://www.aldiwan.net/poem44022.html","المتقارب"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85430","الكامل"],[275,"هذا البنفسج فيه قد لمع الندى","https://www.aldiwan.net/poem35297.html","الكامل"],[463,"لمن دار على إضم","https://www.aldiwan.net/poem55893.html","مجزوء الوافر"],[469,"دمعي بتلك الطول مطلول","https://www.aldiwan.net/poem3158.html","عموديه"],[534,"ولست بممحض ودا لشخص","https://www.aldiwan.net/poem37417.html","الوافر"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130209","البسيط"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48238","الطويل"],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11257","الوافر"],[3102,"","https://poetry.dctabudhabi.ae/diwan/poem/113894","الطويل"],[4767,"أكياسنا","https://www.poetsgate.com/ViewPoem.aspx?id=214166",""],[4816,"هلا","https://www.poetsgate.com/ViewPoem.aspx?id=8472",""],[4867,"موعد غير منتظر","https://www.poetsgate.com/ViewPoem.aspx?id=25023",""],[4869,"احبك لحالك","https://www.poetsgate.com/ViewPoem.aspx?id=151550",""],[4869,"ياطير حنا في زمان المحابيل","https://www.poetsgate.com/ViewPoem.aspx?id=151687",""],[4877,"كويتية","https://www.poetsgate.com/ViewPoem.aspx?id=29463",""],[4877,"أكيد ابزعل","https://www.poetsgate.com/ViewPoem.aspx?id=36090",""],[5055,"حشد روس الفحول","https://www.poetsgate.com/ViewPoem.aspx?id=101193",""],[5220,"يابنت","https://www.poetsgate.com/ViewPoem.aspx?id=37048",""],[5664,"الغيبوبه","https://www.poetsgate.com/ViewPoem.aspx?id=176683",""],[5776,"خاتمٌ بلا إصبع","https://www.poetsgate.com/ViewPoem.aspx?id=199329",""],[6093,"نفس كشمس","https://www.poetsgate.com/ViewPoem.aspx?id=197702",""]],"verses":[["أَكَيداً بَعدَ أَن رُفِعَت مَناري","وَأَرسَت في مَقاعِدِها جِبالي",0,"ل",2,0],["أَكيداً لَنا يا بَينُ واصَلتَ وَصلَنا","فَلا دارُنا تَدنو وَلا عَيشُنا يَصفو",1,"ف",2,0],["أُكيدرُ ليس لنفسٍ وَقاء","إذا ما ابتلى اللَّهُ مَن يبتلي",2,"ل",2,0],["أكئبْ بهاتيك الطلول وَما بها","من مشهدٍ يدعو إلى الأشجان",3,"ن",1,0],["أكياسُ أهلِ الكاسِ يُرجى خَيرُهُم","فلطالما مدّوا الأكفَّ إلى النَّدى",4,"د",2,0],["أكيدُ به النوائبَ أو","تكونَ بأمره خدمي",5,"م",2,0],["أكياسهُ من لهُاه مقفرةٌ","وربعهُ بالعفاةِ مأهول",6,"ل",1,0],["أَكيلُ لَهُمْ بِمكْيالٍ تراهُ","عَلَى مِكْيالِهِمْ أَبَداً يَدُورُ",7,"ر",1,0],["أكياسهم عشقت يوم الندى فجرت","ولا تسل عن حديث العشق كيف جرى",8,"ر",2,0],["أكيلُ صِياعاً كلَّ خصمٍ بصاعِهِ","وأضرِم في حَوْبَاهُ نارَ اكْتِئابِهِ",9,"ب",2,0],["أَكيدُهُمُ مُكايَدَةَ الأَعادي","وَأَختِلُهُم مُخاتَلَةَ الذِئابِ",10,"ب",1,0],["أكيد الليالي بالسقوط دهاها","أم المجد من سوء الفعال قلاها",11,"ا",3,1],["أكياسنا السوداء أصليةٌ","ليست بما تحمله زائفة",12,"ف",2,1],["أكياسنا بالعز ريانة","لم تبد مِن عز جرى ناشفة",12,"ف",2,0],["أكياسنا لا خوف ينتابها","والغرب منه ابنته خائفة",12,"ف",2,0],["اكيد ان الليالي اللي مضت ترجع لك بطيبه","لأن السيل يعود أثره ولو طول بمغيابه",13,"ب",2,0],["اكيد حلوه مثل البدر واشعاعه..","او انها زهرة خزام وبساتين،،",14,"ن",1,0],["اكيّف بشوفتك واشرب خيآلك","واسوي بطآريك ألفين دلّه",15,"ل",2,0],["اكيل من حزني وانا اشوفك تكيل","والدمع مايرحم على الخد راعيه",16,"ي",2,0],["أكيد بك شي أو تشكين من علّه","لا مستحيل إنتِ إنسانه طبيعيّه ؟!",17,"ي",2,0],["اكيد ابزعل واجرحك في كلامي","وانت الذي سويت فيني شويه",18,"ي",2,1],["أكيد وموقفي واضح.. ولا فتنه ولا خناس","مثل ما قالها قبلي:- ( نهايتها إلى التقييم )",19,"م",1,0],["اكيد بنتظرك ولو البعد طال","في غيبتك يابنت عايش لحالي",20,"ل",2,0],["اكيد انه وسط قبره سمع طق الخطاوي الان","الا ياليت انا المدفون وانا اسمع طق خطواته",21,"ت",2,0],["أكياناً للوهمِ تُنادي","وتُوَاعِدُ في دارِ الأرقمْ؟!",22,"م",1,0],["أ ( كِيَادُ) صَارَ فَتَاكِ مُلْهِمَنَا","وصُمُودُهُ في صَعْدَةٍ دَرْسُ",23,"س",1,0]]}