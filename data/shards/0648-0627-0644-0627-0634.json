{"poems":[[33,"إني ومن أحرم الحجيج له","https://www.aldiwan.net/poem41281.html","المنسرح"],[107,"اذهب حيي مذمما مشؤوما","https://www.aldiwan.net/poem44195.html","الكامل"],[78,"","https://poetry.dctabudhabi.ae/diwan/poem/39518","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[47,"يا عليٌّ، بلْ يا أبَا الحَسَنِ المَا","https://www.poetsgate.com/ViewPoem.aspx?id=32883",""],[128,"هلملم هلم نلم شعث قريضنا","https://www.aldiwan.net/poem23771.html","الكامل"],[275,"برزت وقد شقت حجاب الأعصر","https://www.aldiwan.net/poem35653.html","الكامل"],[287,"هلم يا لائمي قد أثمر البان","https://www.aldiwan.net/poem32409.html","البسيط"],[325,"مالي أراك أخا الإيناس والسلم","https://www.aldiwan.net/poem67233.html","البسيط"],[370,"لمن الديار بروضة السلان","https://www.aldiwan.net/poem44474.html","الكامل"],[428,"مرثية رجل عظيم","https://www.aldiwan.net/poem24295.html","عموديه"],[443,"أرأيت ما صنعت لحاظ الغيد","https://www.aldiwan.net/poem2612.html","الكامل"],[463,"لكل هوى من رائد الحزم رادع","https://www.aldiwan.net/poem56130.html","الطويل"],[568,"يا عاصمي يا سالمي يا قاسمي","https://www.aldiwan.net/poem13606.html","الكامل"],[1067,"","https://poetry.dctabudhabi.ae/diwan/poem/138062","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25325","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25318","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128720","البسيط"],[1935,"","https://poetry.dctabudhabi.ae/diwan/poem/202163","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/28044","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109522","الوافر"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94320","الرجز"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/134003","الطويل"],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11320","الخفيف"],[3277,"","https://poetry.dctabudhabi.ae/diwan/poem/125986","البسيط"],[3332,"","https://poetry.dctabudhabi.ae/diwan/poem/127916","الرجز"],[3369,"","https://poetry.dctabudhabi.ae/diwan/poem/117043","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48276","السريع"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91519","الطويل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40104","الكامل"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93280","الطويل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136675",""],[4545,"","https://poetry.dctabudhabi.ae/diwan/poem/216343",""],[4737,"لله يا أنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=212818",""],[4767,"سر الكون","https://www.poetsgate.com/ViewPoem.aspx?id=204763",""],[4797,"تقرير في صورة مثايل","https://www.poetsgate.com/ViewPoem.aspx?id=178138",""],[5237,"بإحسان ذي الطول أهل الكرم","https://www.poetsgate.com/ViewPoem.aspx?id=113118",""],[592,"الحمد لله حمداً دائماً وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=128796",""],[5906,"أختاه","https://www.poetsgate.com/ViewPoem.aspx?id=188222",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[463,"لكلِّ هوى منْ رائدِ الحزمِ رادعٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60127&r=&rc=183",""]],"verses":[["وَالأَشعَثِ الطائِفِ المُهِلِّ وَما","بَينَ الصَفا وَالمَقامِ وَالرُكنِ",0,"ن",1,0],["والأشهليّةُ إذ يجيءُ رسولُها","يمشي بِجَفْنَتِها أغَرَّ وسيما",1,"م",2,0],["والأَشترُ المُهجَّنُ العَروضا","ما كانَ منهُ آخرٌ مَقبوضا",2,"ض",2,0],["وَالإِشارَاتِ الَّتِي يُبْدُونَهَا","فِي تَعَادِيهِمْ إِلى يُمْنى وَيسْرَى",3,"ر",2,0],["وَالإشَارَاتِ بالعُيُونِ وَبالأيْ","دي، وَأخْذِ الميعَادِ للإلْتِقَاءِ",4,"ا",2,0],["والأشرفية ما على ظبياتها","أَن لا تكون رمالها يبرين",5,"ن",1,0],["والأشرفيةُ في دمشقَ ومثلُها","ألفٌ بناها العربُ بعد تحضّر",6,"ر",1,0],["وَالأَشرَفُ المَلِكُ القَيلُ الجَوادُ لَهُ","مَكارِمٌ تَملَأُ الدُنيا وَإِحسانُ",7,"ن",1,0],["وَالأَشقِياءُ دَهى كُلٌّ بِرَوعَتِهِ","فَإِنَّهُ عِندَ ما قامَ بِدَعوَتِهِ",8,"ه",1,0],["والأَشعثُ الكِنديُّ حينَ سَما لنا","من حَضرَمَوتَ مُجَنِّبَ الذُكرانِ",9,"ن",1,0],["والأشياء الملساء, مجرد أشياء ملساء","يجعلنا أحيانا نضحك, إذ يضحك كالخمر السوداء",10,"ا",2,0],["والأشراف المنصور أشرف همة","من أن أراني ليس يورق عودي",11,"د",2,0],["وإلا شجيجٌ أعجلَ السيرُ نزعَهُ","عسا فتعافته الرياح الزعازعُ",12,"ع",1,0],["وَالأَشعَرِيُّ الشَيخُ أَشهَدُ أَنَّهُ","لَم يَرمِ قِبلِيّاً بِكُفرٍ قاصِمِ",13,"م",1,0],["وَالاشْتِكالُ وَكَذا التَّرَدُّدُ","فِي الاجْتِهادِ مُطْلَقاً لا يَرِدُ",14,"د",1,0],["وَالأَشْرَف الأَشْرَف وَالأَخايِرا","وَالاَطْيَبِينَ الطِيبَ وَالاَكاثِرا",15,"ر",2,0],["وَالأَشْقِياءُ يَزْجُرُونَ البُرُحَا","وَالجُودُ لا يَنْزِعُ إِلّا مُرْبِحا",16,"ح",2,0],["والاشتباه ستّة لفيف","سريعها منسرح خفيف",17,"ف",1,0],["والأشعريّون أصحاب السفينة","نجاهم وهول المنايا عنهم صرفا",18,"ف",2,0],["والأَشْرَفَيْن خَلائقاً والأَكْرَمَيْ","ن طرائقاً والغامِرَين عَطاءَ",19,"ا",2,0],["والأشعريُّ يقول مثلَ مقالتي","وإنْ أنصفوا وكذا الرجالُ الأوّلُ",20,"ل",1,0],["وإلا شادناً كالغصن قدّاً","يباهي في محاسنه الكواكب",21,"ب",1,0],["والأشعَريُّ يقُولُ تَفسِيرُ استَوَى","بحَقِيقَةِ استَولَى مِنَ البُهتَانِ",22,"ن",1,0],["وَالإِشتِرَاكُ وَبِالمَجَازِ وَحَذفِ مَا","شَاؤُوا بِدَعوَاهُم بِلاَ بُرهَانش",22,"ن",2,0],["والأ شعري أنكر الأحوالا","وردها والحق أن لا حالا",23,"ل",2,0],["وإلا شكوت الدهر من جوره إلى","حسين السجايا ثابت العدل والفضل",24,"ل",1,0],["والأشارات بالعيونِ وبالأي","م دي واخذ الميعادِ للألتقاءِ",25,"ا",2,0],["وآلُ اشور اجروا من فراتهم","جداول التبر قاخضلَّت بها الترب",26,"ب",1,0],["والاشرفي من شمال التربه","منفردا جاور فيها ربّه",27,"ه",1,0],["والأشرف الغورى ناظمها بهم","وبحسن طاعتهم له سلطان",28,"ن",1,0],["والأشْرفانِ بِحُلَى مُلكِهِ","مَدْحي لموْلايَ وما أكْتُبُ",29,"ب",1,0],["وَالاِشتِهَارُ فِى مَبَانِى الأُولَى","يُبدِيهِ وزنُ أُرَبَى وَالطُّولَى",30,"ل",2,0],["والأَشعَريُّ يَقولُ يأتي أَمرُهُ","وَيَعيبُ وَصفَ اللَهِ بالإِتيانِ",31,"ن",1,0],["وَإِلا شُجوني أَحرقته بنارِها","وَإِلا فَدمعي ردّه حَيثُ أَرسلا",32,"ل",2,0],["والأَشْعَرِيُّ بما يؤو","لُ إِلَيهِ أمرُهُما شَعَرْ",33,"ر",1,0],["وإِلاّ شباباً فلَّلَ الشيبُ حَدَّهُ","إِذا ما هفا نحو التّصابي تَلَهَّفا",34,"ف",2,0],["والاشاراتُ قد أشارت لَمعناك","وأنت الذي إليه يُشار",35,"ر",1,0],["والاّ شِمَت بِك واستوى فِيك قايل","والناس مِنْ ولها تعَدِّل مِقالها",36,"ل",3,0],["والاشتياقُ صراخٌ ليسَ يسكتُهُ","سوى حبيبةِ قلبي.. \"عندما تأتي\"",37,"ت",2,0],["والأشرفَ الجَدِّ الذي ما لهُ","في الكونِ مَن يعدِلُه منصِبا",38,"ب",2,0],["وإلا شاهين مثل حالول فعله","طارحينه في فويرط بالمحايل",39,"ل",1,0],["والأشجار لما دعاها أتت","تخب بساق خلت من قدم",40,"م",1,0],["والأشعرية أعني من بغوا وغلوا","في الدين منهم بما قد خالفوا الحنفا",41,"ف",2,0],["والأشْهُرُ الحُرمُِ في تاريخِنْا أَزَلُ","أَضْحَتْ وَنَعلَمُ أنَّ الحِلَّ بِالسَّبَبِ",42,"ب",1,0],["وَالأَشجار تُورق ثُم تينع ثمارها","وَتاكل مَخاليق البَسيطة جنالها",43,"ل",3,0],["وإلاَّ شجيجٌ أعجلَ السَّيرُ نزعهُ","عسا فتعافتهُ الرِّياعَ الزعازعُ",44,"ع",1,0]]}