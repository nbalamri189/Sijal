"أوْدَعْتُه حُزْني فَلَمْ تَعْبَثْ بِهِ","شكْوَى ولا صَدَع الدجَى بِنُواحِ",137,"ح",1,0],["أوْدَتْ بأشجعِ من حَفّ الرّعيلُ به","يومَ النِّضالِ ومَنْ نادَى ومَن نودي",138,"د",2,0],["أوْدَتْ بمن تعرفُ الساحاتُ كَرّتَه","إذا تنكَّبَ عنها كلُّ مَزْءود",138,"د",1,0],["أُودِّعهم ما بَيْنَ لَوْعَةِ وَاجدٍ","تَطِيرُ به الذِّكْرَى وَزفْرَةِ مُشْفِق",139,"ق",1,0],["أوْدَى أبو الفتحِ الْمُرجَّى واختَفَى","عَلَمٌ طَواه الدهرُ في طَيَّاتِه",140,"ت",2,0],["أو دَعُوني أنظِمْ سجاياه طرًّا","في نشيد مُرَتَّل يحفظونه",141,"ن",2,0],["أودعته قلبي بجانب ربِّه","وخشيتُ من حرِّ الغرام عليهما",142,"م",2,0],["أودى صريعَ الداء، يبري جسمه","صفر اليدين، عن الديار بعيدا",143,"د",2,0],["أودع الله في يديك سلاحا","كلُّ جُرْح بحدِّه يَلْتَامُ",144,"م",1,0],["أودى بأهلي الغدير فانقرضوا","لم يبقَ منهمُ رأسٌ ولا ذنبُ",145,"ب",1,0],["أودى الذي كان تِيْهُ المكرُمات به","على سواهن تِيه الخُرَّدِ العُرُب",146,"ب",1,0],["اودى بحسّاده غيظاً كأنّبه","\" محمد \" وبشانيه \" أبالهب \"",146,"ب",1,0],["أُودُوا إلى اللَّهِ، ما أُدٌّ مفخرُها","شيءٌ يُعَدُّ، ولا أُودٌ ولا أُودُ",147,"د",1,1],["أودعتَنيها فدع الخديعهْ","ثم السلامُ وهي القطيعهْ",148,"ع",2,0],["أوْ ديمة الغيث كلما طمِع الطْ","طَامعُ في أن يكفَّها وَكفا",149,"ف",2,0],["أَوْ دُرَّة ٌ بَيْضَاءُ بِكْرٌ أُطْبِقَتْ","حبلاً على ياقوتة ٍ حمراءِ",150,"ا",2,0],["اودعكم والشوق بالصبر فاتك","كفتك الملوكِ المستبدين بالأمر",151,"ر",1,0],["أَوَدُّ وما وُدُّ امْرِىء ٍ نافِعاً لَهُ","وإن كانَ ذا عقلٍ إذا لم يكن جدُّ",152,"د",1,0],["أودّعها قبل الفراق وإنّني","أفارقها والقلب لهفان وكاسف",153,"ف",1,0]]}