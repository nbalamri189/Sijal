e/diwan/poem/55018","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54626","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54578","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[19,"","https://poetry.dctabudhabi.ae/diwan/poem/2241","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141960","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43659","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43797","المجتث"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43832","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43764","المنسرح"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43675","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54261","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54233","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54218","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54228","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54224","البسيط"],[106,"هو ليلاي","https://www.poetsgate.com/ViewPoem.aspx?id=179378",""],[106,"خيال في يقظة","https://www.poetsgate.com/ViewPoem.aspx?id=179676",""],[106,"ذكرى فريد !","https://www.poetsgate.com/ViewPoem.aspx?id=179479",""],[106,"الطبيب إمام","https://www.poetsgate.com/ViewPoem.aspx?id=179382",""],[50,"عامت \"سليمى \" ومسّها سغبُ","https://www.poetsgate.com/ViewPoem.aspx?id=17136",""],[90,"ليت الذي بك في وقع النوائب بي !","https://www.poetsgate.com/ViewPoem.aspx?id=179093",""],[46,"أُودُوا إلى اللَّهِ، ما أُدٌّ مفخرُها","https://www.poetsgate.com/ViewPoem.aspx?id=18341",""],[51,"يا رُبَّ لهفانَ على صنيعَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=29481",""],[51,"أبا عليٍّ طلبتُ عيبك ما اس","https://www.poetsgate.com/ViewPoem.aspx?id=29588",""],[44,"قَدْكَ ائَّئِبْ أَرْبَيْتَ في الغُلَوَاءِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=15644&r=&rc=4",""],[88,"اعرني لساناً ايها الشعر للشكر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19582&r=&rc=85",""],[87,"هو البينُ حتَّى لاسلامٌ ولا ردُّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23842&r=&rc=104",""],[96,"الطريد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66355&r=&rc=31",""]],"verses":[["أَودى وَما أَودَت مَناقِبُهُ","وَمِنَ الرِجالِ مُعَمَّرُ الذِكرِ",0,"ر",1,0],["أوَدَّعُ في كُلِّ يَومٍ حَبيبا","وَأُهدي إِلى الأَرضِ شَخصاً غَرَيبا",1,"ب",2,1],["أَودى بِسادَتِنا وَقَد","تَرَكوا لَنا حَلَقاً وَجُردا",2,"د",2,0],["أَو دُرَّةٌ عِندَ الخَلا","ئِفِ لَيسَ يُدرى مَن سَباها",3,"ا",3,0],["اَوْدَى بِصَبْرِي صُدْغُهُ لَمَّا بَدَا","وَجَنَى عَلَيَّ فَسَلْسَلُوهُ عِقَابَا",4,"ب",2,0],["أَودى بِكَ السُكَّرُ المُضني وَلا عَجَبٌ","أَن يورِثَ الحُلوُ مُرَّ العَيشِ أَحيانا",5,"ن",2,0],["أَودى فَتى الشَرقِ بَل شَيخُ الصَحافَةِ بَل","شَيخُ الوَفائِيَّةِ الوَضّاحَةِ الحَسَبِ",6,"ب",1,0],["أَودى بِهِ ذاكَ الجِهادُ وَهَدَّهُ","عَزمٌ يَهُدُّ جَلائِلَ الأَخطارِ",7,"ر",1,0],["أَودى المَعَرّي تَقِيُّ الشِعرِ مُؤمِنُهُ","فَكادَ صَرحُ المَعالي بَعدَهُ يودي",8,"د",2,0],["أَودى سُلَيمانٌ فَأَودى بَعدَهُ","حُسنُ الوَفاءِ وَبَهجَةُ العَلياءِ",9,"ا",2,0],["أَو داسَ أَرضَكِ باغٍ","لَدُستُهُ وَبَغَيتُ",10,"ت",1,0],["أَودَعوها جَوفَ دَنٍّ مُظلِمٍ","وَلَدَيهِ بَشَّروها بِالخُلود",11,"د",1,0],["أَو دَعوهُ فِداؤُهُ إِن تَغَنّى","كُلُّ نَفسٍ وَكُلُّ ما في الوُجودِ",12,"د",1,0],["أَودَعَ اللَهُ صَدرَهُ حِكمَةَ العِل","مِ وَأَجرى عَلى يَدَيهِ الشِفاءَ",13,"ا",2,0],["أَودَعتَ نُعماكَ مِنهُم شَرَّ مُغتَرَسٍ","لَن يَكرُمَ الغَرسُ حَتّى تُكرَمُ البُقَعُ",14,"ع",1,0],["أَوَدُّ لَكُم خَيراً وَتَطَّرِحونَني","أَكَعبَ بنَ عَمرٍو لِاِختِلافِ الصَنائِعِ",15,"ع",1,0],["أَودى أَبو حَسّانَ واحَسرَتا","وَكانَ صَخرٌ مَلِكُ العالِيَه",16,"ي",2,0],["أودع ذي مجد وأوفى أخي","عهدي وأندى كل ذي وفر",17,"ر",1,0],["أودت بإسماعيل نجدته","وأضناه سهاده",18,"د",2,0],["أَوَدِيعُ نَقْضِيكَ الوَدَاعَ وَكُلُّنَا","ذَاكِي الحَشَى مُسْتَعْبِرُ الأَجْفَانِ",19,"ن",1,0],["أَوْدَعْتَ فِي الكُتُبِ الَّتِي صَنَّفْتَهَا","أَزْكَى ثِمَارِ العِلْمِ لِلأَذْهَانِ",20,"ن",1,0],["أَوْدَعَتْهَا عِنَايَةُ الل","هِ حِيناً مِنَ الزَّمَنْ",21,"ن",1,0],["أَودى بِها كُلُّ عَرّاصٍ أَلَثَّ بِها","وَجافِلٌ مِن عَجاجِ الصَيفِ مَهجومُ",22,"م",1,0],["أَودى بِها الدَهرُ قِدماً وَاِستَحالَ بِها","بِكُلِّ داجٍ مُسِفِّ الوَدقِ مَبحورِ",23,"ر",1,0],["أودى الذي غيث العباد بكفه","يُزري بواكف غيثك الغيداقِ",24,"ق",1,0],["أودى الحريق بدار كنت أسكنها","وكنت من بعضها للقوت اكتال",25,"ل",1,0],["أوَدّع أصحابي وهم مُحدِقون بي","وقدِ ضقت بالبين المُشِتّ ذراعا",26,"ع",2,0],["أودّعهم في الكرخ والطرف مرسِل","إلى الجانب الشَرقيّ منه شُعاعا",26,"ع",2,0],["أَو دُختَنوسَ غَداةَ جُزَّ قُرونُها","وَدَعَت بِدَعوَةِ ذِلَّةٍ وَثُبورِ",27,"ر",1,0],["أَوَدُّكَ وُدّاً لا الزَمانُ يُبيدُهُ","وَلا النَأيُ يُفنيهِ وَلا الهَجرُ ثالِمُه",28,"م",2,0],["أودت فعالكِ يا أسما بأحشائي","وا حيرتي بين أفعال وأسماء",29,"ا",2,1],["أودع مولانا على نيَّة اللقا","سريعاً وعودي نحو إحسانه الغمر",30,"ر",1,1],["أو دبيب المَلالِ في مُسْتهامَيْ","ن إلى غاية من البغضاءِ",31,"ا",2,0],["أودُّ إذا ما الموتُ أوْفَدَ مَعْشَراً","إلى عَسْكَر الأمْواتِ أنِّي من الوفْدِ",32,"د",1,0],["أودى بِبستانَ وهي حُلّتهُ","فقد غدا عارياً من الحبرِ",33,"ر",1,0],["أؤدي إن فعلت الخير خيراً","إليك وإن فعلت الشر شرا",34,"ر",2,0],["أوْدِع سِواه الذي جمعتَ لهُ","إن كنت ترعاه يا أبا البقر",35,"ر",1,0],["أودعْه أهلَ الوفاءِ في مِننٍ","تُعقَد لا في الصِّرار والبِدَر",35,"ر",1,0],["أودِعْ له المال لا على جهة ال","إيداع بل كالجِباء والشَّبر",35,"ر",1,0],["أودى بصبري الأذى وبرَّح بي ال","فَقْرُ وأنتَ المَلاذ والعَصَر",36,"ر",1,0],["أودت بهنَّ الباكيا","تُ الضاحكات الرُجَّسُ",37,"س",1,0],["أو دبَّ فيه الذرُّ فاختلفت","تفراه أكرُعه وأذرعه",38,"ع",2,0],["أو ديمة الغيث كلما طمع ال","طامع في أن يكفَّها وكفا",39,"ف",2,0],["أودى الزمانُ بمن يعلّم أهلهُ","كيف النعيمُ فكيف ينعم بالُ",40,"ل",1,0],["أودى محمدٌ بنُ نصرٍ بعدما","ضُربت به في سروه الأمثالُ",40,"ل",1,0],["أَودى بَنِيَّ وَأَعقَبوني غُصَّةً","بَعدَ الرُقادِ وَعَبرَةً لا تُقلِعُ",41,"ع",1,0],["أَودَت عِكَبٌّ ما تُحَسُّ وَخالِدٌ","وَسادَ بَنو الشَيطانِ وَالمَجَراتُ",42,"ت",1,1],["أَودوا بِها نَسفا وَماتوا عِندَها","غَرَقا وَيَأبى الباسِلونَ العارا",43,"ر",2,0],["أَو ديكاً يَنقُدُ أَو رَجُلاً","يَمشي أَو مَهراً أَو عَرَبه",44,"ه",1,0],["أَودى فَنورُ الفَرقَدَينِ ضَئيلُ","وَعَلى المَنازِلِ رَهبَةٌ وَذُهولُ",45,"ل",1,1],["أَودى ضَحِيَّةَ جَهلِهِ كَم بائِسٍ","أَودى شَهيدَ الجَهلِ وَالإِهمالِ",46,"ل",1,0],["أَودَعتُهُ الخَفِيَّ مِن أُموري","فَكانَ مِثلَ النارِ في البَخورِ",47,"ر",1,0],["أَودُّ بروحي عِناقَ الوُجُودِ","بما فيهِ مِنْ أَنْفُسٍ أَو شَجَرْ",48,"ر",1,0],["أو دعوه قبرا من الأرض ضنكا","ما به شرفة ولا توسيع",49,"ع",1,0],["أودُّ لو كان ما أود","أني عنكم أطوى المسيرا",50,"ر",2,0],["أَودى فَغابَ الرفقُ وَاِختَفى النَدى","وَحُجِبَ الحِلمُ وَغُيِّب الذَكا",51,"ا",1,0],["أَوَدِدتَ لَو صارَت نِساءُ النيلِ ما","كانَت نِساءُ قُضاعَةٍ وَنِزارِ",52,"ر",1,0],["أَودى الجَريءُ إِذا جَرى","وَالمُستَميتُ إِذا أَغار",53,"ر",1,0],["أَودى الحِمامُ بِشَيخِهِم","وَمَآبِهِم في المُعضِلاتِ",54,"ت",1,0],["أَودى الرَدى بِمُهذَّبٍ لا تَنتَهي","إِلّا إِلَيهِ شَمائِلُ الرُؤَساءِ",55,"ا",2,0],["أَودى حَرَفاً إِلّا رَمَقاً","يُبقيهِ عَلَيكَ وَتُنفِدُهُ",56,"د",2,0],["أَودى بِزينَتِها الزَمانُ وَحَليِها","وَالحُسنُ باقٍ وَالشَبابُ الرَيِّقُ",57,"ق",1,0],["أَو دَوائِرٌ دُرَرٌ","مائِجٌ بِها لَبَبُ",58,"ب",1,0],["أَودى مُعاوِيَةٌ بِهِ","وَبَعَثتَهُ قَبلَ النُشور",59,"ر",1,0],["أَو دَع لِسانَكَ وَاللُغاتِ فَرُبَّما","غَنّى الأَصيلُ بِمَنطِقِ الأَجدادِ",60,"د",1,0],["أَوْدَى ولَوْ مَدَّ عَيْنَهُ أَسَدَ الغا","بِ لناجى السِّرْحَانَ في الهَرَبِ",61,"ب",1,0],["أَوْدَى عَلِيٌّ صَلّى على رُوحِهِ","اللّهُ صَلاةً طويلةَ الدَّأَبِ",61,"ب",1,0],["أَوَدُّ مِنَ الأَيّامِ مالا تَوَدُّهُ","وَأَشكو إِلَيها بَينَنا وَهيَ جُندُهُ",62,"د",2,1],["أو دامَ بالأعداء وقعتُها","ضَجرَ الردى وتبرَّم العَطَبُ",63,"ب",1,0],["أَودى بِلُقمانَ بنِ عادٍ بَعدَما","أَودَت شَبيبَتُهُ بِسَبعَةِ أَنسُرِ",64,"ر",1,0],["أَوَدُّ لَها سُقيا السَحابِ وَمَحوُها","بِسُقيا السَحابِ حينَ يَصدُقُ خالُها",65,"ل",3,0],["أَودى اِبنُ موسى وَالمَكارِمُ وَالنَدى","وَالعِزُّ عِندَ تَحَفُّظِ السُلطانِ",66,"ن",1,0],["أودَعَتْه الرّيحُ ما استَوْ","دَعَها زَهْرُ النَّباتِ",67,"ت",1,0],["أَودى الزَمانُ بِأَسلافي وَخَلَّفَني","وَسَوفَ يُلحِقُني يَوماً بِأَسلافي",68,"ي",1,0],["أَودى بِجَدَّتِكَ البِلى","وَأَرى مُناكَ كَما هِيَه",69,"ي",2,0],["أود حسادي أن يكثروا","وأعذر الحاسد في فعله",70,"ه",1,1],["أَو دَبَّ بِالحسنِ فَوقَ عارِضِهِ","نَملٌ أَصابَ المدادُ أَرجُلَها",71,"ل",3,0],["أَودى الغريبُ بعلِّةٍ تعتادُهُ","بالكَربَ وهيَ غَريبَة العوّادِ",72,"د",1,0],["أَودى بِخَيرِ إِمامٍ اِضطَرَبَت بِهِ","شُعَبُ الرِجالِ وَقامَ خَيرُ إِمامِ",73,"م",1,0],["أَو دُرَّةٌ بَيضاءُ بِكرٌ أُطبِقَت","حَمَلاً عَلى ياقوتَةٍ حَمراءِ",74,"ا",2,0],["أَودى بِهِ حَمزَةُ الصِّندِيدُ فِي نَفَرٍ","نالوا الشَّهادَةَ تَحتَ العارِضِ الرَّزِمِ",75,"م",1,0],["أَودى الشَبابُ وَأَمسى المَوتُ يَخلُفُهُ","لا مَرحَباً بِمَحَلِّ الشَيبِ إِذ نَزَلا",76,"ل",2,0],["أُوَدِّعُها الغَداةَ فَكُلُّ نَفسٍ","مُفارِقَةٌ إِذا بَلَغَت مَداها",77,"ه",2,0],["أَوْدَى بأهلِ التّيهِ مِن أوهامهِ","تِيهٌ عَواقِبُه أَضَرُّ وأشْأمُ",78,"م",1,0],["أودى رَصاصُ القاذفين بفتيةٍ","هُمْ بالنُّفوسِ لَدَى الفداءِ سماحُ",79,"ح",1,0],["أودى عليٌّ بعد أحمدَ فانظروا","مَهوى الجبالِ ومَغرِبَ الأقمارِ",80,"ر",1,0],["أَودى بِدينِ الحَقِّ دينُ غوايَةٍ","كانَت مُلوكُ الشَرقِ مِن أَصنامِهِ",81,"م",2,0],["أَودى بِها عَبدُ العَزيزِ وَقَومُهُ","قَومُ الخَليعِ وَشيعَةُ السَكرانِ",82,"ن",1,0],["أَودى الرُماةُ بِوادِعينَ تَتابَعوا","في غَيرِ ما ذَنبٍ يُعَدُّ وَيُحسَبُ",83,"ب",1,0],["أَودى بِأَعراسِ المَمالِكِ مَأتَمٌ","طاحَت لَهُ المُهجاتِ وَالأَكبادُ",84,"د",1,0],["أَودى بِهِ حُكمُ أَقوامٍ جَبابِرَةٍ","أَغرى سَياسَتَهُم بِالظُلمِ مُغريها",85,"ي",3,0],["أَودى بِنا بَينَ الشُعوبِ تَباغُضٌ","صَدَعَ القُلوبَ وَمَزَّقَ الأَوصالا",86,"ل",2,0],["أَوْدَى بِكَ ابنُ أنيسٍ","فَأقفَرَ الحيُّ بَعْدَكْ",87,"ك",1,0],["أودَى بِعتُبَةِ والوليدِ وشَيْبةٍ","وأميّةَ القدَرُ الذي لا يُدْرَح",88,"ح",1,0],["أَودى بِقَلبي لِذاكَ الصُدغِ عَقرَبُهُ","لَو أَنَّ دِرياقَ ذاكَ الريقِ مُنتَعِشي",89,"ش",2,0],["أودعتُ في مُهجِ الشبي","بة نفْحةَ الرّوحِ الوفيَّةْ",90,"ي",2,0],["أَودَلَّهُم بَعضَ مَن يَرتادُ مَشتَمَتي","عَلَيَّ فَليَحذَروا وَاطعَمَ الذي اِرتادوا",91,"د",3,0],["أودِعَت قَمحاً فَلَمّا نُثِرَت","كُلُّ أَرضٍ أَنبَتَت شَوكَ القَتادِ",92,"د",1,0],["أَو دارَةُ البَدرِ إِذا ما استَوى","وَتَمَّ لِلعَدِّ المَواقيتُ",93,"ت",1,0],["أَوَدُّ مَن لَم يَنَلني مِن مَوَدَّتِهِ","إِلا سَلاماً يَرِدُّ القَلبَ حَيرانا",94,"ن",2,0],["أَو دَعاني أَمُت بِهِ","بَلَغَت نَفسِيَ المَدى",95,"د",2,0],["أَودى بِأَهلِ الغَديرِ فَاِنقَرَضوا","لَم يَبقَ مِنهُم رَأسٌ وَلا ذَنَبُ",96,"ب",1,0],["أَو دُرَّةٍ صَدَفِيَّةٍ غَوّاصُها","بَهِجٌ مَتى يَرَها يُهِلَّ وَيَسجُدِ",97,"د",1,0],["أَو دُميَةٍ مِن مَرمَرٍ مَرفوعَةٍ","بُنِيَت بِآجُرٍّ تُشادُ وَقَرمَدِ",97,"د",1,0],["أَودَعَهُم رَبُّهُم سِرَّها","مِن بَعدِ ما أَطعَمَهُم سُحَتها",98,"ت",3,0],["أَودى رَداهُ بِأَجيالٍ فَكَم حُفِرَت","أَجداثُ قَومٍ وَلَم يُحفَر لَهُ جَدَثُ",99,"ث",1,0],["أُوَدِّعُ يَومي عالَماً إِنَّ مِثلَهُ","إِذا مَرَّ عَن مِثلي فَلَيسَ يَعودُ",100,"د",1,1],["أودوا إِلى اللَهِ ما أودٌ وَمفخَرُها","شَيءٌ يُعَدُّ وَلا أودٌ وَلا أودُ",101,"د",1,1],["أَودى بِفُرسانِ كُلِّ جيلٍ","مِن سَبِطٍ فيهِمُ وَجَعدِ",102,"د",1,0],["أَودى أَبوها وَهوَ أَسوَدُ حالِكٌ","فَأَقامَ يَخلُفُهُ عَلَيها القارُ",103,"ر",1,0],["أَودى الزَمانُ بِذي الأَمانِ فَلا ال","عَرجِيُّ مَوجودٌ وَلا جَبرُ",104,"ر",1,0],["أَودِعتَ ضِغناً فَلا تَجحَدهُ مَودِعَهُ","إِنَّ الأَمانَةَ لَم تُرفَع مِنَ الناسِ",105,"س",1,0],["أَودى المُلوكَ عَلى اِحتِرا","سِهِمُ وَلم تَبقَ المَمالِك",106,"ك",1,0],["أَودى السُرورُ بِدارٍ كُلُّها حَزَنُ","فَلا تُبالِ عَلى ما صابَتِ المُزُنُ",107,"ن",1,1],["أوْدَى فلَيتَ الحادِثاتِ كَفَافِ","مالُ المُسيفِ وعنبرُ المُستافِ",108,"ف",1,1],["أَودى رَبيعُ الصَعاليكِ الأُلى اِنتَجَعو","وَكُلَّ ما فَوقَها مِن صالِحٍ مودي",109,"د",2,0],["أَودى وَهَل تَنفَعُ الإِشاحَةُ مِن","شَيءٍ لِمَن قَد يُحاوِلُ البِدَعا",110,"ع",2,0],["أَودَعْتُ قلبي إلى مَن ليس يحفظُه","أبصرْتُ خلفي وما طالعتُ قدَّامي",111,"م",2,0],["أو درة قد أُخرجت","عند الصباح من البحار",112,"ر",1,0],["أَو دعوة كان فيها","عَلى الحقوق اجتماع",113,"ع",1,0],["أود أن تحفروا في","جنب النواسيّ قبري",114,"ر",2,0],["أودعهم وَالقَلب ممتلئٌ لهم","حناناً وَج