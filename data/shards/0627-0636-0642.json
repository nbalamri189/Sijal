{"poems":[[49,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83315","الطويل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110282","الطويل"]],"verses":[["أَضَقنَ عَلَيهِ البيدَ وَهيَ فَضافِضٌ","وَأَضلَلنَهُ عَن سُبلِهِ وَهوَ خابِرُ",0,"ر",1,0],["أضقامَهُم في الشَرقِ يُحيونَ شَأنَهُ","فَإِذا هَل عَمّا نالَ عاداً وَجَرَّهُما",1,"م",2,0],["اضقت علينا العيش حتى اجعتنا","فجع واعتبر يا مشبع الحوت في البحر",2,"ر",1,0]]}