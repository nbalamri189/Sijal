{"poems":[[57,"أذن مجتازا بنا بالصلاة","https://www.aldiwan.net/poem26442.html","السريع"],[73,"خبروها بأنه ما تصدى","https://www.aldiwan.net/poem4014.html","الخفيف"],[75,"قل لأبي حفص ولم تكذب","https://www.aldiwan.net/poem11984.html","السريع"],[74,"طلبت ري الغليل منها","https://www.aldiwan.net/poem20549.html","مخلع البسيط"],[53,"عنفت شيخي أذان في مواثبة","https://www.aldiwan.net/poem65949.html","البسيط"],[93,"يا رب قائلة والقول أجمله","https://www.aldiwan.net/poem8757.html","عموديه"],[93,"لا تقلقي يوم النوى أو فاقلقي","https://www.aldiwan.net/poem8985.html","عموديه"],[82,"غيرته غير الدهر فشاب","https://www.aldiwan.net/poem31541.html","الرمل"],[71,"أثر الحزن بقلبي أثرا","https://www.aldiwan.net/poem29053.html","الرمل"],[50,"يا خليلي من بني مخزوم","https://www.aldiwan.net/poem65102.html","الخفيف"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16627","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55163","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54744","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[96,"دمعة على الشام","https://www.poetsgate.com/ViewPoem.aspx?id=12814",""],[96,"عيد الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=12815",""],[53,"عنَّفتُ شيخيْ في مواثبة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=30282",""],[133,"حدث الشاعر عن نور القمر","https://www.aldiwan.net/poem60382.html","الرمل"],[139,"شقوا القلوب وغادروا الأطواقا","https://www.aldiwan.net/poem49169.html","الكامل"],[214,"لحظ يسبيك مقلده","https://www.aldiwan.net/poem13325.html","المتدارك"],[257,"ما نام بعد البين يستحلي الكرى","https://www.aldiwan.net/poem1416.html",""],[358,"أترع الأكواب من صافي الشراب","https://www.aldiwan.net/poem40771.html","الرمل"],[376,"يا عباد الله قابلني","https://www.aldiwan.net/poem57190.html","المديد"],[415,"إن لم تطيقا يوم رامه","https://www.aldiwan.net/poem32384.html","مجزوء الكامل"],[457,"عم صباحاً واسلم بأرغد عيش","https://www.aldiwan.net/poem13644.html","الخفيف"],[463,"من بسلع مطلع لي","https://www.aldiwan.net/poem56295.html","مجزوء الرمل"],[469,"عاد من عيد وصله ما تولى","https://www.aldiwan.net/poem3155.html","عموديه"],[469,"لندى يديك ويمن رأيك","https://www.aldiwan.net/poem3314.html","عموديه"],[469,"أما النسيم فما يغب وروده","https://www.aldiwan.net/poem3545.html","عموديه"],[469,"أمهى الفتون سيوف ألحاظه المهى","https://www.aldiwan.net/poem3573.html","عموديه"],[469,"في القلب منزلة الغزال الشامس","https://www.aldiwan.net/poem3577.html","عموديه"],[482,"حن فأجرى للنوى دموعا","https://www.aldiwan.net/poem15204.html","السريع"],[520,"من أجل هيبة ذا المقام المذهل","https://www.aldiwan.net/poem12202.html","الكامل"],[520,"شأن الغرام أجل أن يلحاني","https://www.aldiwan.net/poem12277.html","الكامل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126867","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122690","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122691","الرجز"],[755,"","https://poetry.dctabudhabi.ae/diwan/poem/121048","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38965","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55908","المجتث"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64817","الكامل"],[1320,"","https://poetry.dctabudhabi.ae/diwan/poem/198181","الرمل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48199","البسيط"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96037","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27967","الرمل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109395","السريع"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28558","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93700","الكامل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102559","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93922","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94048","البسيط"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104676","الخفيف"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115531","الرمل"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216567",""],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36733","الرجز"],[3778,"","https://poetry.dctabudhabi.ae/diwan/poem/90030","الكامل"],[3778,"","https://poetry.dctabudhabi.ae/diwan/poem/89990","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133290","الكامل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76446","الرمل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86472","السريع"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86453","الكامل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36388","الدوبيت"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54464","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94519","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72432","الكامل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35082","البسيط"],[4755,"عَمَّ يَتَحَدَّثُون ؟!","https://www.poetsgate.com/ViewPoem.aspx?id=184735",""],[5038,"جيش العراق","https://www.poetsgate.com/ViewPoem.aspx?id=195220",""],[5136,"عذروني وعنفوني مراراً","https://www.poetsgate.com/ViewPoem.aspx?id=121583",""],[5293,"المتكبرة","https://www.poetsgate.com/ViewPoem.aspx?id=186134",""],[5431,"أعلنوه انسحابا ...","https://www.poetsgate.com/ViewPoem.aspx?id=212773",""],[5455,"صمت المكان","https://www.poetsgate.com/ViewPoem.aspx?id=34700",""],[5791,"وشم ..!","https://www.poetsgate.com/ViewPoem.aspx?id=208559",""],[5956,"أنهكتَ نفسك لتنفعني وتنفعَ العالم","https://www.poetsgate.com/ViewPoem.aspx?id=206262",""],[520,"شأن الغرام اجل ان يلحاني","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577660",""],[5555,"مُعَلَّقَةٌ لِلِاحتِفَاءِ بِالْهَشَاشَةِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87404&r=&rc=0",""],[6302,"رَجَاحَهْ ..!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86239&r=&rc=37",""],[6325,"معراج روح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88021&r=&rc=3",""]],"verses":[["عَنَّفَني الأَقوامُ في حُبِّها","إِلا أَخا شَيبانَ ذا المَكرُمات",0,"ت",1,0],["عَنَّفَت طَيفَها عَلى ظَنِّها أَنَّ","خَيالاً مِنها إِلَينا تَسَدّى",1,"د",2,0],["عَنِّفهُ بِاللَهِ عَلى فِعلِهِ","وَاِشتِم وَإِن لَم يَستَقِم فَاِضرِبِ",2,"ب",1,0],["عنفني ثم قال تسلى","عن حبِّ ماما فقلت لالا",3,"ل",2,0],["عنَّفتُ شيخَيْ أذانٍ في مواثبةٍ","تَواثباها وقد يَعْوَجُّ معتدلُ",4,"ل",1,1],["عَنَّفتِه وَهوَ لا ذَنبَ جَناهُ سِوى","أَن لَيسَ يَرضى بِأَن يَغدو لَها ذَنَبا",5,"ب",2,0],["عَنَّفتُ قَلبِيَ حينَ طالَ خُفوقُهُ","فَأَجابَ بَل لُمني إِذا لَم أَخفُقِ",6,"ق",1,0],["عَنّفَتْ رُسْلي وَرَدّتْ تُحَفي","وأتَتْ تقرعُ سَمعي بالعِتاب",7,"ب",1,0],["عنَّفَ العاذلُ في حزني ومِنْ","حقِّه تمهيد عذري لو درى",8,"ر",2,0],["عَن فَتاةٍ كَأَنَّها حينَ تَبدو","طَلعَةُ الشَمسِ في سَوادِ الغُيومِ",9,"م",1,0],["عن فضْلِه نَطَقَ الكِتاب وبَشّرَتْ","بقُدُومِه التّوْرَاةُ والإنْجِيلُ",10,"ل",1,0],["عنْ فِطْنةٍ لا يَكَادُ يُخْفَى","فِي الحَالِ عَنْهَا وَجْهُ المَآلِ",11,"ل",1,0],["عَنْ فَتَاهَا الشَّاكِي السِّلاَحَيْنِ وَالمَا","ضِيهِمَا فِي شَوَاكِلِ الأضْدَادِ",12,"د",1,0],["عَنْ فِطْرَةٍ سَامَى بِهَا","نقَاؤُهَا أَسْمَى الفِطرْ",13,"ر",1,0],["عنف الطغاة به ويسخر كبره","بالشامتين طلاقة ومراحا",14,"ح",2,0],["عنف باريس شجاني أمره","بدعة الأقدار عنف الجبناء",15,"ا",2,0],["عنَّفتُ شيخيْ في مواثبة ٍ","تَواثباها وقد يَعْوَجُّ معتدلُ",16,"ل",1,1],["عن فقيرٍ حاسدٍ طَيرَ السَما","عن طَريدٍ ما لَهُ العُمرَ مَقَرّ",17,"ر",1,0],["عن فضلهِ حدّثْ فطيب حديثه","يشفي المحب ويطرب المشتاقا",18,"ق",2,0],["عن فيه صحاح الدر روت","ما صح عنه مبرده",19,"د",2,0],["عَنفَ العَذولُ وَما رآهُ جَهالَةً","وَأَغارُ وَجداً أَن يَراهُ فَيُعذَرا",20,"ر",2,0],["عَنّفوني بِسَخائي وَالنَدى","لِيَ طَبع فَلَما أَبدوا عِتابي",21,"ب",2,0],["عَن فُؤادِي ما الَّذي فَعلَت","فيهِ عَيناها وَما فَعَلا",22,"ل",2,0],["عَنّفْتُمَانِي أنْ مَررْ","تُ بِمنْزلٍ أقْضِي ذِمَامَهْ",23,"م",2,0],["عن فؤاد يبين عن حسن ودٍّ","خالصٍ للجناب غير مشوب",24,"ب",1,0],["عنَّفوا القلبَ على قَا","تِلِه وهو حبيبُهْ",25,"ب",2,0],["عنفَ الشّوقُ بالمحبين والشَّو","قُ شبيهٌ بالحرب أسراً وقتلا",26,"ل",2,0],["عنفت لياليهم بهم فش","كا عبيدك من إمايك",27,"ك",1,0],["عنفَ العذولُ مفنّداً بمتّيمٍ","لا عذلهُ يجدي ولا تفنيده",28,"د",2,0],["عنّفتَ حين عرفت من أحببتهُ","وجهلتَ ما صدعَ الفؤادَ وما دهى",29,"ه",2,0],["عنفتْ بباكٍ في هواكِ لضاحكٍ","وبساهرِ الليل التّمام لناعس",30,"س",1,0],["عَنَّ ففاضتْ مقلةٌ بعدَهم","بُدِّلَ دُرُّ دمِعها نجيعا",31,"ع",2,0],["عنفتهم ولو ابتليت عذرتهم","لا يعذر المبلي إلا من بلي",32,"ل",2,0],["عنفت أجفاني فقام بعذرها","وجه يبيح ودائع الأجفان",33,"ن",1,0],["عن فضل هذا ورأى من رأيه","إن أجلس البعض على ردائه",34,"ه",1,0],["عَن فلسطين جاهَدت ليس ترضى","أن تَرى الجيشَ للبلاد مُلازِم",35,"م",1,0],["عَنَّفتَ بي وَطَريقُ الرُّشدِ بَيِّنَةٌ","مِن أينَ يُطلَبُ مِنكَ البِرُّ يا عُقَقُ",36,"ق",1,0],["عَنَّفتَ بي في اللَّومِ رَفِّه وأرِح","فالرِّفقُ أولى بِكَ يا رَفيقُ",37,"ق",1,0],["عن فتية فتكوا في الدين وانتهكوا","حماه جهلا برأي فيه إفساد",38,"د",1,0],["عَن فَضلِهِ وَهوَ بَحر قُل وَلا حرج","فَما عَنِ البحرِ لِلتّحديثِ تَحديدُ",39,"د",1,0],["عن فضل ذي الفضل ينبي","عقداً بديعاً جميلا",40,"ل",2,0],["عنَّفْتَني فيما مَضَى وَغَدَرْتَ إِذْ","نادَمتَني وشَرِبْتَ فَضْلَةَ كاسي",41,"س",2,0],["عنَّفَ الصّبَّ ولو شاءَ رَفَقْ","رَشأٌ يرشُق عن قوس الحَدَقْ",42,"ق",1,1],["عن فضلِهم كادت الأقلامُ من طربٍ","تخطُّ لا بيد الكتَّابِ في الكتبِ",43,"ب",1,0],["عنفاً أمال رقابها","إذ اوشكت تتكثر",44,"ر",1,0],["عن فُضيلِ بن عياض","وهو من أهل الزياده",45,"د",2,0],["عن فيضه تروي الغوادي ومن","بعض عطاياه الخيول العِراب",46,"ب",1,0],["عَن فَهمِهِ كَتَقَاصُرِ الأفهَامِ عَن","قَولِ الإِمَامِ الأعظَمِ الشَّيبَانِي",47,"ن",2,0],["عَن فِعلِهِ إذ فَعَلُهُ مَفعُولُهُ","لَكِنَّهُ مَا قَامَ بِالرَّحمَنِ",47,"ن",1,0],["عَنَّفتَني في حُبِّهِ وَلَرُبَّما","أَبصَرتَهُ فَأَتَيتَ غَيرَ مُعَنَّفِ",48,"ف",1,0],["عَن فيهِ يَنطق إِن غَدا متكلماً","ويبين مِنهُ شَمائِلاً وَقواما",49,"م",2,0],["عن فعلهم لكون لسان طباعهم","قد قال لي حاشاهم أن يرجعوا",50,"ع",3,0],["عن فضل مطرانه حدث ولا حرج","كم من مكارم تروي عن بسليوس",51,"س",1,0],["عن فخر أثاره حدث ولا حرج","فكل مأثور فخر عن علاه روي",52,"و",2,0],["عُنفواناً تَوَلّى","وَتَقَضّى وَزالا",53,"ا",1,0],["عنّف اللاحى وكثّر","ليتَهُ لو كان قصّر",54,"ر",1,1],["عَنْ فِيْ شَملِك غاب واشيك","فِيْ مِنحنى طعوس الأكامي",55,"م",2,0],["عَن فِكرَة شاردةٍ","وِخاطر مُقسَّمِ",56,"م",1,0],["عنفوا عليَّ بلومهم سفهاً","لو جُرِّعوا كأس الهوى رفقوا",57,"ق",3,0],["عَنَفَ الرَّقيبُ فلو مَنَنَتَ دمجتني","بينَ الوشاح وخَصرِك المجدولِ",58,"ل",1,0],["عن فضل مولانا الإمام","حدث ولا تخش الملام",59,"م",1,1],["عن فَوقَ الدوح بالصَوت الرَفيع","يَسمع المَحزون تلك الزَقزَقة",60,"ه",1,0],["عنفني فيك فلم يلوني","فلم لوى جيدك إذ عنفك",61,"ك",1,0],["عن فطنة تذكو فتوقد مندلاً","فض اللطيمة تاجرٌ لتفوحا",62,"ح",2,0],["عَن فِلقِ فَمٍ يُريكَ شهداً وَبَرَد","كَم ناوَلَني الرِضابَ من غَير حَرَد",63,"د",1,1],["عنّفت في حبِّ السّماحةِ مُؤثراً","عُدْمَ الكريم على ثراءِ الباخلِ",64,"ل",1,0],["عن فرط وجدي ودمعٍ سحَّ من مقلٍ","وحرّ قلبي وإحراقي وإسعاري",65,"ر",2,0],["عن فتكه في مهجة","ذابت عليك تلهفا",66,"ف",2,0],["عَن فِتيَةٍ نَزَلوا عُليا سَرارَتِها","عَفَت مَحاسِنُهُم إِلّا مِنَ الكُتُبِ",67,"ب",1,0],["عَن فِكرَةِ التَّخدِيرِ باسْمِ الذي","وَلَّى, وألقاهَا عَلى المَاكِثِ ؟",68,"ث",1,0],["عَنْ فَوجِ موسى يَومَ قَلَّدَ جُنْدَهُ","أَبْهى الْخِصالِ السَّيفَ وَالْإِيمانا",69,"ن",2,0],["عنفوني على الخلاعة في الحب","ولا غرو إن خلعت العذارا",70,"ر",2,0],["عُنْفٌ بِعُنْفٍ وَ إِعْصَارٌ بِزَوْبَعَةٍ","إِنْ جَارَ جُرْنَا وَ إِنْ أَرْخَى نُوَاتِيهِ",71,"ي",2,0],["عن فيوضي وقد شربتم فؤادي","سلسبيلا معتّقا مستطابا",72,"ب",2,0],["عن فتاةٍ غير كل اللي قرينا في الحكايا","صمتها طيش وقصيد .. وطيشها صمت وأمان",73,"ن",1,0],["عن فكرة البدءِ يحكي سرّ مهبطهِ","أنْ ظلّ يسعاك إنجيلاً ويعرجكِ",74,"ك",1,0],["عن فكرِ عَزة أقبيقٍ ورفعَتِها","وليس فضلُك ينسى دعمَ كلِّ ولي",75,"ل",2,0],["عنفت أجفاني فقام بعذرها","وجدٌ يبيح ودائع الأجفان",76,"ن",1,0],["عَنْ فِكْرَةٍ فِي السَّمَاءِ نَرْسُمُهَا","لِفِكْرَةٍ فِي الضَّمِيرِ حَاضِرَةِ",77,"ه",1,0],["عُنفوانُ الحزن ..لاَ.. ما عادَ يُذكي","جذْوةَ اللحنِ..وإنْ ضَرَّى جِراحَهْ!",78,"ح",2,0],["عن فكرةٍ أو صورةٍ شعريةٍ","راحتْ تمدُّ إلى القصيدةِ جِسْرا",79,"ر",2,0]]}