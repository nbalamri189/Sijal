{"poems":[[63,"وظلماء من ليل التمام طويتها","https://www.aldiwan.net/poem45727.html","الطويل"],[55,"امزجا لي بماء دجلة كأسا","https://www.aldiwan.net/poem26444.html","الخفيف"],[88,"ألا خلياني في الكلام من السجع","https://www.aldiwan.net/poem44972.html","الطويل"],[47,"أروح القلب ببعض الهزل","https://www.aldiwan.net/poem25176.html","الرجز"],[72,"أمزق قلبي في هواك تحرقا","https://www.aldiwan.net/poem19325.html","الطويل"],[51,"أفسدت توبتي علي غلام","https://www.aldiwan.net/poem66362.html","الخفيف"],[91,"بالأمس بادرني صديق حائر يستفهم","https://www.aldiwan.net/poem62704.html","عموديه"],[45,"بات نديما لي حتى الصباح","https://www.aldiwan.net/poem62685.html","السريع"],[66,"ما للجبال الراسيات تسير","https://www.aldiwan.net/poem40122.html","الكامل"],[33,"أمزمعة للبين ليلى ولم تمت","https://www.aldiwan.net/poem25853.html","الطويل"],[22,"يأيها الملك الذي أمست له","https://www.aldiwan.net/poem22019.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39617","الكامل"],[91,"أنفس العشّاق","https://www.poetsgate.com/ViewPoem.aspx?id=53240",""]],"verses":[["أُمَزِّقُ جِلبابَ الظَّلامِ كَما فَرى","أَخو الحُزنِ ما نالَت يَداهُ مِنَ البُردِ",0,"د",1,0],["اِمزُجا لي بِماءِ دِجلَةَ كَأساً","إِنَّني قَد مَلَلتُ ماءَ الفُراتِ",1,"ت",1,1],["أمزّق دعواهم إذا ما طعنتها","ولو أنها كانت من الدين في دِرْع",2,"ع",1,0],["أَمزَحُ فيهِ مَزحَ أَهلِ الفَضلِ","وَالمَزحُ أَحياناً جَلاءُ العَقلِ",3,"ل",1,0],["أمزِّق قلبي في هواك تحرُّقاً","وجفنيَ تسهيداً وليتك تعرف",4,"ف",1,1],["امزجِ الراحَ لي بريق غلام","فألذُّ الهوى المعاصي التُّؤام",5,"م",1,0],["أَم زَمهَريرٌ قارِسٌ قاسٍ وَكَونٌ مُظلِمُ","فَأَجَبتُهُ ما الزَمَريرُ وَما اللَذى المُتَضَرِّمُ",6,"م",1,0],["أَمزُجُ كَأسي بِجَنا ريقِهِ","وَإِنَّما أَمزُجُ راحاً بِراح",7,"ح",1,0],["أَم زالَتِ الدُنيا فَيَذبُلُ يَذبُلٌ","مِنها وَيَدعي بِالثَبورِ ثَبيرُ",8,"ر",1,0],["أَمُزمِعَةٌ لِلبَينِ لَيلى وَلَم تَمُت","كَأَنَّكَ عَمّا قَد أَظَلَّكَ غافِلُ",9,"ل",1,1],["أُمٌّ زَعَمتَ لَهُم وَماتَت أُمُّهُم","في عَهدِ عادٍ حينَ ماتَ التُبَّعُ",10,"ع",1,0],["أم زُغْتَ يوم الانتخا","بِ ولستَ عضوَ البرلمنْتْ",11,"ت",1,0],["أم زمهرير قارس قاس وكون مظلم ؟","فأحببته ، ما الزمهرير وما اللّظى المتضرّم",12,"م",1,0]]}