{"poems":[[65,"وظلماء من ليل التمام طويتها","https://www.aldiwan.net/poem45727.html","الطويل"],[57,"امزجا لي بماء دجلة كأسا","https://www.aldiwan.net/poem26444.html","الخفيف"],[90,"ألا خلياني في الكلام من السجع","https://www.aldiwan.net/poem44972.html","الطويل"],[49,"أروح القلب ببعض الهزل","https://www.aldiwan.net/poem25176.html","الرجز"],[74,"أمزق قلبي في هواك تحرقا","https://www.aldiwan.net/poem19325.html","الطويل"],[53,"أفسدت توبتي علي غلام","https://www.aldiwan.net/poem66362.html","الخفيف"],[93,"بالأمس بادرني صديق حائر يستفهم","https://www.aldiwan.net/poem62704.html","عموديه"],[47,"بات نديما لي حتى الصباح","https://www.aldiwan.net/poem62685.html","السريع"],[68,"ما للجبال الراسيات تسير","https://www.aldiwan.net/poem40122.html","الكامل"],[35,"أمزمعة للبين ليلى ولم تمت","https://www.aldiwan.net/poem25853.html","الطويل"],[22,"يأيها الملك الذي أمست له","https://www.aldiwan.net/poem22019.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39617","الكامل"],[93,"أنفس العشّاق","https://www.poetsgate.com/ViewPoem.aspx?id=53240",""],[216,"برق تبدى خفية بسناء","https://www.aldiwan.net/poem37922.html","الكامل"],[240,"ملكت قلبي في الحكم فاحتكمي","https://www.aldiwan.net/poem31767.html","المنسرح"],[240,"طاف يسعى بها على الجلاس","https://www.aldiwan.net/poem31916.html","الخفيف"],[302,"سرت موهنا والنجم في أذنها قرط","https://www.aldiwan.net/poem33231.html","الطويل"],[302,"زهر الدراري أم نظام الجوهر","https://www.aldiwan.net/poem33261.html","الكامل"],[371,"زار الصباح فكيف حالك يا دجى","https://www.aldiwan.net/poem17148.html","الكامل"],[385,"واحر غلة قلبي الوقاد","https://www.aldiwan.net/poem48838.html","الكامل"],[422,"أنا في هواكم مطلق ومقيد","https://www.aldiwan.net/poem54136.html","الكامل"],[463,"عِمي صباحا بعدنا واسلمي","https://www.aldiwan.net/poem55887.html","السريع"],[470,"يا شاديَ الأيك","https://www.aldiwan.net/poem43677.html","عموديه"],[505,"رفع البدر علينا سجفا","https://www.aldiwan.net/poem37954.html","الرمل"],[580,"امزج بريقك أو بمدح العادل","https://www.aldiwan.net/poem3022.html","الكامل"],[747,"","https://poetry.dctabudhabi.ae/diwan/poem/143279","المتقارب"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62500","الرمل"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107200","الرمل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64588","الوافر"],[1718,"","https://poetry.dctabudhabi.ae/diwan/poem/44755","الرمل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69319","الطويل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77395","الرمل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129958","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100216","الطويل"],[2886,"","https://poetry.dctabudhabi.ae/diwan/poem/147791","الطويل"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115607","المنسرح"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115444","الرمل"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147325","البسيط"],[3204,"","https://poetry.dctabudhabi.ae/diwan/poem/95815",""],[3271,"","https://poetry.dctabudhabi.ae/diwan/poem/142238","المنسرح"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74036","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62863","الطويل"],[3620,"","https://poetry.dctabudhabi.ae/diwan/poem/77735","الكامل"],[3970,"","https://poetry.dctabudhabi.ae/diwan/poem/205128","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86356","الرمل"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105107","الكامل"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104536","السريع"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72545","السريع"],[4888,"أزهرَتْ مطامِحُنا","https://www.poetsgate.com/ViewPoem.aspx?id=207683",""],[4931,"لمّي القصايد","https://www.poetsgate.com/ViewPoem.aspx?id=32545",""],[5111,"مدُّ الْحَضَارةِ","https://www.poetsgate.com/ViewPoem.aspx?id=212264",""],[5187,"للصبر حدرد","https://www.poetsgate.com/ViewPoem.aspx?id=29248",""],[5213,"أهي الطلول تلوح من ربواتها","https://www.poetsgate.com/ViewPoem.aspx?id=170424",""],[5273,"أسئلة بظهر الغيب","https://www.poetsgate.com/ViewPoem.aspx?id=176796",""],[5277,"الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=186873",""],[5596,"عبق الزهر","https://www.poetsgate.com/ViewPoem.aspx?id=205463",""],[5725,"الخمر يرقص والكؤوس تصفق","https://www.poetsgate.com/ViewPoem.aspx?id=200695",""],[5786,"ما الغيث لمّا جرى بالسَّيل واديه","https://www.poetsgate.com/ViewPoem.aspx?id=50656",""],[5976,"امزعزعين امضعضعين","https://www.poetsgate.com/ViewPoem.aspx?id=30537",""],[6004,"في مجون اللهو","https://www.poetsgate.com/ViewPoem.aspx?id=33759",""],[6016,"حيا الإله تحيات مضاعفة","https://www.poetsgate.com/ViewPoem.aspx?id=90897",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""],[6271,"زمان الصّمت","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80699&r=&rc=5",""],[5567,"وكن روحي لتفنى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69067&r=&rc=6",""],[4890,"الهزيمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=72560&r=&rc=137",""]],"verses":[["أُمَزِّقُ جِلبابَ الظَّلامِ كَما فَرى","أَخو الحُزنِ ما نالَت يَداهُ مِنَ البُردِ",0,"د",1,0],["اِمزُجا لي بِماءِ دِجلَةَ كَأساً","إِنَّني قَد مَلَلتُ ماءَ الفُراتِ",1,"ت",1,1],["أمزّق دعواهم إذا ما طعنتها","ولو أنها كانت من الدين في دِرْع",2,"ع",1,0],["أَمزَحُ فيهِ مَزحَ أَهلِ الفَضلِ","وَالمَزحُ أَحياناً جَلاءُ العَقلِ",3,"ل",1,0],["أمزِّق قلبي في هواك تحرُّقاً","وجفنيَ تسهيداً وليتك تعرف",4,"ف",1,1],["امزجِ الراحَ لي بريق غلام","فألذُّ الهوى المعاصي التُّؤام",5,"م",1,0],["أَم زَمهَريرٌ قارِسٌ قاسٍ وَكَونٌ مُظلِمُ","فَأَجَبتُهُ ما الزَمَريرُ وَما اللَذى المُتَضَرِّمُ",6,"م",1,0],["أَمزُجُ كَأسي بِجَنا ريقِهِ","وَإِنَّما أَمزُجُ راحاً بِراح",7,"ح",1,0],["أَم زالَتِ الدُنيا فَيَذبُلُ يَذبُلٌ","مِنها وَيَدعي بِالثَبورِ ثَبيرُ",8,"ر",1,0],["أَمُزمِعَةٌ لِلبَينِ لَيلى وَلَم تَمُت","كَأَنَّكَ عَمّا قَد أَظَلَّكَ غافِلُ",9,"ل",1,1],["أُمٌّ زَعَمتَ لَهُم وَماتَت أُمُّهُم","في عَهدِ عادٍ حينَ ماتَ التُبَّعُ",10,"ع",1,0],["أم زُغْتَ يوم الانتخا","بِ ولستَ عضوَ البرلمنْتْ",11,"ت",1,0],["أم زمهرير قارس قاس وكون مظلم ؟","فأحببته ، ما الزمهرير وما اللّظى المتضرّم",12,"م",1,0],["أم زال عن أسمْاَ نياطُ لثامها","فتبسمتْ بالروضةِ الخضراءِ",13,"ا",2,0],["أَمزُجُ شَكوايَ بِالخُضوعِ لَها","وَدَمعَ عَيني صَبابَةً بِدَمي",14,"م",2,0],["أَمزُجُ الكاسَ مِن جَناهُ وَكَم لَي","لَةِ صَدٍّ مَزَجتُ بِالدَمعِ كاسي",15,"س",2,0],["أُمزِّقُ جلبابَ العَفافِ ولم أَزَل","أَقلِّبها حتّى اِلتقى الحِجلُ والقُرطُ",16,"ط",1,0],["أَم زَهر روضٍ قد تبسَّم ضاحِكاً","إِذ جادَه صوبُ الغمام المُمطرِ",17,"ر",1,0],["أَم زُرتَني وَمِنَ النُجومِ رَكائِبٌ","فَأَرى ثُرَيّاها تُريني هَودَجا",18,"ج",2,0],["أَمزوُ دي يَوم الرَحيل بِنَظرة","كانَت بِرَغمي مِنهُ آخر زادي",19,"د",2,0],["أمزيلَ نحس الوافدين بسعده","شقيتْ بك الحساد فيما تسعد",20,"د",1,0],["أمزج كأسي معَه بالبكا","منه ولا أشربُ إلا دمي",21,"م",2,0],["أم زادَ قَدْرُكُمو في الذ ُّلِّ مَرتَبَة ً","إذ صرتُم الآنَ خُدَّاما ً وعُبدانا؟!",22,"ن",2,0],["أمْ زُلَيْخاءُ الهَوى قد أُذْهِلَتْ","حينَما طَلَّ عليها يوسُفُ",23,"ف",1,0],["امْزِجْ بريقكِ أَو بمدحِ العادِل","فكلاهُما خُلقا لمزجِ البَابِلي",24,"ل",2,1],["أمَزِّقُ أعراضهمْ دائباً","كما وقعَ الذئبُ في الماشيهْ",25,"ش",3,0],["أم زئير من أسود","أم من الصُّمْع زماجر",26,"ر",1,0],["امزجُوا الكاسَ بذِكرى ما صَفا","لكُمُ يَوماً كَما مَرَّ فَأنّى",27,"ن",2,0],["امزق باسمك الأعلى صفاتي","والبس من صفاتك ما أشاء",28,"ا",2,0],["إِمزجاها واِسقياني واِشرَبا","وَدَعا العاذِلَ يَهذي كَيفَ شا",29,"ش",2,1],["أَمُزمِعَةٌ بِالبَينِ قَتلي تَرَفَّقي","فَفي الرِفقِ إِحسانٌ لَدَيكِ وَإِجمالُ",30,"ل",1,0],["أَم زَعَمتُم أَن ذو","بَ التِبرِ في ماءِ الغَمام",31,"م",1,0],["أم زارها ساري النسيم بسحرَةٍ","فغدت إلى لقيا المعانق تعنق",32,"ق",1,0],["أمزمعة للقبر حسبكِ من أبٍ","يضن بدمع أو يجودك ساكبا",33,"ب",2,0],["أمزحٌ بشيخٍ بعد تسعين حجّةً","طوتني كأني من بقية جرهم",34,"م",1,0],["أمزجُ منهُ مدامةً لطفُت","لولا سناها خفت عن الحسّ",35,"س",1,0],["امزج الراح بماء السحبِ","واسقنيها يا نديمي واشرَبِ",36,"ب",1,1],["أُمَزِّقُ الغَيْبَ مُشْتَاقًا لأحْجَيَتِيْ","أَحُلُّ شَفْرَتَهَا حَرْفًا عَلَى قَلَقِ",37,"ق",1,0],["امزج بمسبوك اللجين","ذهباً حكته دموع عيني",38,"ن",2,1],["أم زارها في مِهادها نَسَمٌ","وراح من فتنةٍ يُجاذبُها",39,"ب",3,0],["أَمزوّدين قُلوبنا","برح الأَسى زوّدتمونا",40,"ن",2,0],["أُمزِّقُهُ ما مزَّقَتْني صُروفُهُ","وآخذُ منه ثَارَ كلِّ مُطَالِبِ",41,"ب",1,0],["أُمزُجهُ يا ربِّ بِلَحمي مَع دَمي","واِغسِل بِهِ قَلبي مِنَ الأضغاني",42,"ن",2,0],["امزجي يا مدام كأس المدام","قد مضى وانقضى ذمام الصيام",43,"م",1,1],["أم زليخا مصر زارت يوسفا","فسبت أرجاءه بالعبق",44,"ق",1,0],["إمزج بعذب لماك كأسك واسقني","جهراً فمن كأسيك ساغ المشرب",45,"ب",1,0],["أم زورق الحسن على حافة","يعوم في مسبحة من عرق",46,"ق",1,0],["أم زهر روض نمَّ نمامه","والودق بالقطر له نمنما",47,"م",2,0],["أم زِنادُ صَحْوتِنا","بالمنى قد انقَدَحا؟",48,"ح",2,0],["أمزج قصيد الحبّ معْ نطق فمّك","والفَرح اضمّه حيل ملزوم ملزوم",49,"م",1,0],["أُمَزِّقُ كُلَّ حُدُوْدِ انْتِصَابٍ","وَأَرْسُمُ بِا لصَّمْتِ مَدَّ الْحَضَارَهْ",50,"ر",2,0],["أُمزِّقُ الوَهمَ حينَ يَطْغى","ويَمزُجُ الطُهرَ بالفَسادِ",51,"د",1,0],["امزجها كالسهم في كبد الفلا","حرفا تفوت العين في لحظاتها",52,"ت",3,0],["أمزَّقْتِ أوراقَ شِعْريَ ثأراً؟","دعيها فللشِّعْرِ سَمْعٌ وصَوْتُ",53,"ت",1,0],["امزجْ بنا كأسَ الوصالِ وقلْ لنا:","هيَّا بيومِ ربيعِكمْ فتعلَّلوا",54,"ل",3,0],["ام زادك الله على خلقه","بسطة حسنٍ منه لما خلق",55,"ق",1,0],["امزلزل الآهات تحت قلوبنا","لم يبق شيئ للمواجع يصعقُ",56,"ق",1,0],["أم زوجهُ أم بنيه أم أُخوَّتهُ","لأحمدٍ أم قضاهُ في فتاويه",57,"ي",2,0],["امزعزعين امضعضعين بْمتاهات","بقْلوب كنّه قِفّلت بالمفاتيح",58,"ح",1,0],["أَمْ زِنَادُ الْغَوْثِ وَلىّ مِنْ مَعِينٍ","مِثلَ وِردٍ كَانَ عَذْباً ، صَارَ طِينَا",59,"ن",2,0],["أمزمان قلت لعذالي وقد عذلوا","يوم الطريقة بين الرمل والجرد",60,"د",1,0],["امزجنها من ريق (بسمةَ) فهو ال","بلسمُ الحق والدواء الحُذاقي",61,"ق",2,0],["إم زرياب أنت قبست ضوءا","وبوزن عودك الشادي صهيب",62,"ب",1,0],["أمزقُ عن رؤى روحي ضبابا","يُحوكُ على مسافاتي شباكا",63,"ك",2,0],["أمزج بالنعمة الجريمه","ناسِجاً راية الترابْ",64,"ب",1,0]]}