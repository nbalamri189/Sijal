{"poems":[[63,"وظلماء من ليل التمام طويتها","https://www.aldiwan.net/poem45727.html","الطويل"],[55,"امزجا لي بماء دجلة كأسا","https://www.aldiwan.net/poem26444.html","الخفيف"],[88,"ألا خلياني في الكلام من السجع","https://www.aldiwan.net/poem44972.html","الطويل"],[47,"أروح القلب ببعض الهزل","https://www.aldiwan.net/poem25176.html","الرجز"],[72,"أمزق قلبي في هواك تحرقا","https://www.aldiwan.net/poem19325.html","الطويل"],[51,"أفسدت توبتي علي غلام","https://www.aldiwan.net/poem66362.html","الخفيف"],[91,"بالأمس بادرني صديق حائر يستفهم","https://www.aldiwan.net/poem62704.html","عموديه"],[45,"بات نديما لي حتى الصباح","https://www.aldiwan.net/poem62685.html","السريع"],[66,"ما للجبال الراسيات تسير","https://www.aldiwan.net/poem40122.html","الكامل"],[33,"أمزمعة للبين ليلى ولم تمت","https://www.aldiwan.net/poem25853.html","الطويل"],[22,"يأيها الملك الذي أمست له","https://www.aldiwan.net/poem22019.html","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39617","الكامل"],[91,"أنفس العشّاق","https://www.poetsgate.com/ViewPoem.aspx?id=53240",""],[212,"برق تبدى خفية بسناء","https://www.aldiwan.net/poem37922.html","الكامل"],[235,"ملكت قلبي في الحكم فاحتكمي","https://www.aldiwan.net/poem31767.html","المنسرح"],[235,"طاف يسعى بها على الجلاس","https://www.aldiwan.net/poem31916.html","الخفيف"],[297,"سرت موهنا والنجم في أذنها قرط","https://www.aldiwan.net/poem33231.html","الطويل"],[297,"زهر الدراري أم نظام الجوهر","https://www.aldiwan.net/poem33261.html","الكامل"],[366,"زار الصباح فكيف حالك يا دجى","https://www.aldiwan.net/poem17148.html","الكامل"],[380,"واحر غلة قلبي الوقاد","https://www.aldiwan.net/poem48838.html","الكامل"],[416,"أنا في هواكم مطلق ومقيد","https://www.aldiwan.net/poem54136.html","الكامل"],[458,"عِمي صباحا بعدنا واسلمي","https://www.aldiwan.net/poem55887.html","السريع"],[465,"يا شاديَ الأيك","https://www.aldiwan.net/poem43677.html","عموديه"],[500,"رفع البدر علينا سجفا","https://www.aldiwan.net/poem37954.html","الرمل"],[575,"امزج بريقك أو بمدح العادل","https://www.aldiwan.net/poem3022.html","الكامل"]],"verses":[["أُمَزِّقُ جِلبابَ الظَّلامِ كَما فَرى","أَخو الحُزنِ ما نالَت يَداهُ مِنَ البُردِ",0,"د",1,0],["اِمزُجا لي بِماءِ دِجلَةَ كَأساً","إِنَّني قَد مَلَلتُ ماءَ الفُراتِ",1,"ت",1,1],["أمزّق دعواهم إذا ما طعنتها","ولو أنها كانت من الدين في دِرْع",2,"ع",1,0],["أَمزَحُ فيهِ مَزحَ أَهلِ الفَضلِ","وَالمَزحُ أَحياناً جَلاءُ العَقلِ",3,"ل",1,0],["أمزِّق قلبي في هواك تحرُّقاً","وجفنيَ تسهيداً وليتك تعرف",4,"ف",1,1],["امزجِ الراحَ لي بريق غلام","فألذُّ الهوى المعاصي التُّؤام",5,"م",1,0],["أَم زَمهَريرٌ قارِسٌ قاسٍ وَكَونٌ مُظلِمُ","فَأَجَبتُهُ ما الزَمَريرُ وَما اللَذى المُتَضَرِّمُ",6,"م",1,0],["أَمزُجُ كَأسي بِجَنا ريقِهِ","وَإِنَّما أَمزُجُ راحاً بِراح",7,"ح",1,0],["أَم زالَتِ الدُنيا فَيَذبُلُ يَذبُلٌ","مِنها وَيَدعي بِالثَبورِ ثَبيرُ",8,"ر",1,0],["أَمُزمِعَةٌ لِلبَينِ لَيلى وَلَم تَمُت","كَأَنَّكَ عَمّا قَد أَظَلَّكَ غافِلُ",9,"ل",1,1],["أُمٌّ زَعَمتَ لَهُم وَماتَت أُمُّهُم","في عَهدِ عادٍ حينَ ماتَ التُبَّعُ",10,"ع",1,0],["أم زُغْتَ يوم الانتخا","بِ ولستَ عضوَ البرلمنْتْ",11,"ت",1,0],["أم زمهرير قارس قاس وكون مظلم ؟","فأحببته ، ما الزمهرير وما اللّظى المتضرّم",12,"م",1,0],["أم زال عن أسمْاَ نياطُ لثامها","فتبسمتْ بالروضةِ الخضراءِ",13,"ا",2,0],["أَمزُجُ شَكوايَ بِالخُضوعِ لَها","وَدَمعَ عَيني صَبابَةً بِدَمي",14,"م",2,0],["أَمزُجُ الكاسَ مِن جَناهُ وَكَم لَي","لَةِ صَدٍّ مَزَجتُ بِالدَمعِ كاسي",15,"س",2,0],["أُمزِّقُ جلبابَ العَفافِ ولم أَزَل","أَقلِّبها حتّى اِلتقى الحِجلُ والقُرطُ",16,"ط",1,0],["أَم زَهر روضٍ قد تبسَّم ضاحِكاً","إِذ جادَه صوبُ الغمام المُمطرِ",17,"ر",1,0],["أَم زُرتَني وَمِنَ النُجومِ رَكائِبٌ","فَأَرى ثُرَيّاها تُريني هَودَجا",18,"ج",2,0],["أَمزوُ دي يَوم الرَحيل بِنَظرة","كانَت بِرَغمي مِنهُ آخر زادي",19,"ي",1,0],["أمزيلَ نحس الوافدين بسعده","شقيتْ بك الحساد فيما تسعد",20,"د",1,0],["أمزج كأسي معَه بالبكا","منه ولا أشربُ إلا دمي",21,"م",2,0],["أم زادَ قَدْرُكُمو في الذ ُّلِّ مَرتَبَة ً","إذ صرتُم الآنَ خُدَّاما ً وعُبدانا؟!",22,"ن",2,0],["أمْ زُلَيْخاءُ الهَوى قد أُذْهِلَتْ","حينَما طَلَّ عليها يوسُفُ",23,"ف",1,0],["امْزِجْ بريقكِ أَو بمدحِ العادِل","فكلاهُما خُلقا لمزجِ البَابِلي",24,"ل",2,1]]}