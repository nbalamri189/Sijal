{"poems":[[73,"شاورت بعض أخلائي وقلت له","https://www.aldiwan.net/poem3728.html","البسيط"],[73,"وحاجة ظلت أشكوها إلى عمر","https://www.aldiwan.net/poem3810.html","البسيط"],[87,"مر الغراب بشاة","https://www.aldiwan.net/poem8039.html","المجتث"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[50,"يا قلب يا خائن الحبيب","https://www.aldiwan.net/poem10820.html","مجزوء البسيط"],[50,"قد كان لي حمدان ذا زورة","https://www.aldiwan.net/poem64453.html","السريع"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66835","المنسرح"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63937","المنسرح"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133874","المنسرح"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109841","الرجز"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112629","الرجز"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85284","الرجز"]],"verses":[["فَقالَ ذلِكَ جُرذانٌ وَمَصلَحَةٌ","أَن لا يُحَطَّ كِتابٌ عِندَ جُرذانِ",0,"ن",1,0],["فَقالَ ذو فِطنَةٍ نَبَّه لَها عَمَراً","فَقُلتُ واخَيبَتي إِن لَم يَنَم عُمَرُ",1,"ر",1,0],["فَقالَ ذو البَينِ لِلأُم","مِ حينَ وَلَّت تَهيمُ",2,"م",1,0],["فَقالَ ذُو رَأيِهِم لا تَعجَلُوا وَخُذُوا","بِالحَزم فَهوَ الَّذي يَشفِي مِنَ الحَزَمِ",3,"م",1,0],["فَقالَ ذَنبٌ عَزايَ عَنهُ","فَقُلتُ مِن أَعظَمِ الذُنوبِ",4,"ب",1,0],["فَقالَ ذو الخُبرِ بِهِ بَعدَما","سَكَّنتُ نَفساً ذاتِ إِشفاقِ",5,"ق",1,0],["فقالَ ذاكَ الناصحُ","ما كُلُّ سَعيٍ ناجحُ",6,"ح",1,0],["فقال ذاكَ الحازِمُ","طوع النَصيح لازِمُ",6,"م",1,0],["فقال ذاك الخِلُّ","الخَيرُ لا يُمَلُّ",6,"ل",1,0],["فقال ذاكَ الفارُ","جَفا الصَديقَ عارُ",6,"ر",1,0],["فقال ذا للبتولِ فاطمةٍ","أوثرها مرّةً وتُؤثرني",7,"ن",2,0],["فقال ذا اليومُ ليس من عملي","ذا اليومُ يومٌ كما ترى أَبْرَص",8,"ص",1,0],["فقال ذاك الفراش ماك قد","مت كذا فاغتسل ولا تبل",9,"ل",1,0],["فقال ذاك الثوب ما انصفتني","بما من الكتمان قد كلفتني",10,"ي",1,0],["فقالَ ذلكَ الظلومُ المُعتدي","إنّي قد أجلتُهُم إلى غد",11,"د",1,0],["فقال ذاك الحازم","طوع النصوح لازم",12,"م",1,0],["فقال ذاك الفار","جفى الصديق عار",12,"ر",1,0]]}