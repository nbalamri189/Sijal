81,"انظر إلى لون الأصيل كأنه","https://www.aldiwan.net/poem61449.html","البسيط"],[81,"يوم تضاحك نوره الوضاء","https://www.aldiwan.net/poem61561.html","الكامل"],[40,"فكم من كاعب حوراء رود","https://www.aldiwan.net/poem42292.html","الوافر"],[22,"لا يبعد الله إذ ودعت أرضهم","https://www.aldiwan.net/poem22065.html","البسيط"],[75,"الشمس عنه كليلة أجفانها","https://www.aldiwan.net/poem69029.html","الكامل"],[75,"فتكات طرفك أم سيوف أبيك","https://www.aldiwan.net/poem69051.html","الكامل"],[48,"لما جفاني الحبيب وامتنعت","https://www.aldiwan.net/poem63333.html","المنسرح"],[48,"لأقطعن نياط الهم بكاس","https://www.aldiwan.net/poem63429.html","البسيط"],[48,"يزيد ماذا دهاكا","https://www.aldiwan.net/poem64487.html","المجتث"],[50,"طيف خيال يعتريني زائرا","https://www.aldiwan.net/poem63813.html","الرجز"],[50,"يا سلم إن الرزق جم وقوت","https://www.aldiwan.net/poem64741.html","الكامل"],[50,"تأبدت برقة الروحاء فاللبب","https://www.aldiwan.net/poem64839.html","البسيط"],[50,"قد لعب الدهر على هامتي","https://www.aldiwan.net/poem64882.html","السريع"],[46,"نبذتم الأديان من خلفكم","https://www.aldiwan.net/poem22506.html","السريع"],[46,"قل للمشيب يد الأيام دائبة","https://www.aldiwan.net/poem23090.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85438","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85588","الكامل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125577","الرجز"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125571","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16681","السريع"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16622","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16637","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54681","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43859","البسيط"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24207","السريع"],[106,"ميلاد الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179497",""],[106,"بطل الريف","https://www.poetsgate.com/ViewPoem.aspx?id=179606",""],[100,"هو ... وهي","https://www.poetsgate.com/ViewPoem.aspx?id=50135",""],[4,"راحَ القَطينُ بِهَجْرٍ بَعدَ ما ابتَكرُوا","https://www.poetsgate.com/ViewPoem.aspx?id=804",""],[45,"تَبًّا لِلَحْمِكَ أَيُّها اللَّحَّام","https://www.poetsgate.com/ViewPoem.aspx?id=31851",""],[51,"أما الزمانُ إلى سلمى فقد جَنَحا","https://www.poetsgate.com/ViewPoem.aspx?id=27419",""],[51,"بيومِ بدرٍ أعزَّ الدينَ ناصرُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=26819",""],[51,"خفِّض أبا الصقر فكم طائرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=25844",""],[85,"ضجَّتْ لمصرع غالبٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9594&r=&rc=84",""],[4,"راحَ القطينُ بهَجْرٍ بَعدَما ابتَكَرُوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10916&r=&rc=12",""]],"verses":[["لَأَقبِلَنَّ مَعشَراً","تِلكَ الطَوالَ اللُدُنا",0,"ن",2,0],["لا قى خُبَيبٌ وَيَزيدٌ روقَها","مِن غَيبَةٍ ماطِرُها القَنا اللَدَن",1,"ن",1,0],["لا قُلتُ بَعدَكَ لِلمَدامِعِ كَفكِفي","مِن عَبرَةٍ وَلَوَ اِنَّ دَمعي مِن دَمي",2,"م",2,0],["لا قَدَّسَ اللَهُ نَفساً مِنكَ جامِعَةً","كَيدَ البِغالِ إِلى ذي الجُلَّةِ الشَرَفِ",3,"ف",1,0],["لَأَقضِيَهُنَّ أَو أَقضي بِهَمّي","غَريبَ الوَجهِ في البَلَدِ الغَريبِ",4,"ب",1,0],["لأُقلِّدَنّكَ مِدْحَةً أمَويَّةً","فانْظُرْ مَنِ المُهدي لَها والقائِلُ",5,"ل",1,0],["لا قَدَّرَ اللَهُ بَعدَ اليَومِ تَعرِيَةً","إِلّا هَناءً عَلى عِزٍّ وَتَخليدِ",6,"د",1,0],["لَأَقفَرَ الجيدُ مِن دُرٍّ يُحيطُ بِهِ","وَالثَغرُ مِن لُؤلُؤٍ وَالكَأسُ مِن حَبَبِ",7,"ب",1,0],["لاقى رَبيعَةَ في الوَغى فَأَصابَهُ","طَعنٌ بِجائِفَةٍ إِلى الصَدرِ",8,"ر",1,0],["لاقَوا بِهَا مَا سَرَّهُمْ","مِنْ رِقَّةٍ وَمِنْ دِعَهْ",9,"ع",2,0],["لا قَسمَ أَوفَرُ مِن قَسَمٍ تَنالُ بِهِ","وِقايَةَ الدينِ وَالأَعراضِ وَالحَسَبِ",10,"ب",1,0],["لاَ قُوَّتِي قُوَّةُ الرَّاعِي رَكَائِبَهُ","يَأوِي فَيَأوِي إِلَيهِ الكَلبُ وَالرَّبَعُ",11,"ع",1,0],["لاقى قَناتِيَ مِضراراً عَشَوزَنَةً","لَم يَلقَ في مَتنِها وَصماً وَلا لينا",12,"ن",2,0],["لاقَوا فَوارِسَ يَطعَنونَ ظُهورَهُم","نَشطَ البُزاةِ عَواتِقَ الخِربانِ",13,"ن",1,0],["لاقوا بُعوثَ أَميرِ المُؤمِنينَ لَهُم","كَالريحِ إِذ بُعِثَت نَحساً عَلى عادِ",14,"د",1,0],["لاقَت جُحافٌ وَكَذّابٌ أَقادَهُمُ","مَسقِيَّةَ السُمِّ شُهباً غَيرَ أَغمادِ",14,"د",1,0],["لاقَت جُحافٌ هَواناً في حَياتِهِمُ","وَما تُقُبِّلَ مِنهُم روحُ أَجسادِ",14,"د",1,0],["لاقى بَنو الأَشعَثِ الكِندِيِّ إِذ نَكَثوا","وَاِبنُ المُهَلَّبِ حَرباً ذاتَ عُصوادِ",14,"د",1,0],["لاقَيتَ أَعيَنَ وَالزُبَيرَ وَجِعثِناً","أَعدالَ مُخزِيَةٍ عَلَيكَ ثِقالِ",15,"ل",1,0],["لاقى الفَرَزدَقُ ضَيعَةً لَم يُغنِها","إِنَّ الفَرَزدَقَ عَنكِ في أَشغالِ",15,"ل",1,0],["لاقى البَدِيُّ الكِلابَ فَاِعتَلَجا","مَوجُ أَتِيَّيهِما لِمَن غَلَبا",16,"ب",2,0],["لاقَت أَخا قَنَصٍ يَسعى بِأَكلُبِهِ","شَأنَ البَنانِ لَدَيهِ أَكلُبٌ جُسُرُ",17,"ر",1,0],["لَأَقولُ قَولاً لايُرَدُّ","وَلا يُرى لي فيهِ لا إِم",18,"م",1,0],["لاقيته والحال أنكد ما أرى","فأعادني والحال أوفق ما أشا",19,"ش",2,0],["لاقيته فشفى رجايَ وعانقت","كفاي من جدواه أطيب مُعتنَق",20,"ق",1,0],["لأقلام مولانا ثناً متضوّعٌ","فهل هي في الكافور تكتب بالمسك",21,"ك",1,0],["لاقَ بذا قرب ذا فقلنا","ما أليق البدر بالكمال",22,"ل",1,0],["لاقيتهُ وأنا المملوءُ من غضب","على الزمان فسرَّى عنِّيَ الغضبا",23,"ب",2,0],["لا قُدِّستْ من أبي العباس جاعرةٌ","ماء الفَياشل منها الدهر مسكوبُ",24,"ب",1,0],["لاقيت من صُدْغٍ عليه مُعَقْرَب","أفْعى تبرِّحُ بالفؤاد وعقربا",25,"ب",2,0],["لاقى الرجالُ غبوقَ المجد فاغتبقوا","منه ولاقَى صبوحَ المجد فاصطبحا",26,"ح",2,0],["لاقيتُ من لا أبالي بعده أبداً","من ضنَّ عني بمعروفٍ ومن سمحا",26,"ح",2,0],["لأقمع كل عفريت وجنٍّ","بكل مفازة وبكل بيدِ",27,"د",1,0],["لا قَدَّس اللَه بالإقبال دولتَكُم","فإن إقبالكمْ لِلناس إدبارُ",28,"ر",1,0],["لأقربُ من إصعاق غيثٍ غياثُهُ","وإن رجّع الغيثُ الرعودَ وأومضا",29,"ض",2,0],["لا قدَّسَ الخَلَفُ المخلَّفُ منكُمُ","ولداً ولا فُرَّاطُكمْ فُرّاطا",30,"ط",2,0],["لاقى هنالك كلَّ ذلك لم يخم","عنه وهمْ من ضارطٍ أو ناحط",31,"ط",1,0],["لا قاتَل اللَّه ربُّ الناس لؤمَكُمُ","بل قاتل الكاذبَ المكذوب من طمعي",32,"ع",2,0],["لا قدست نعمى تسربلتها","كم حجة فيها لزنديق",33,"ق",1,0],["لا قصوراً من الكرامة عنا","غير أن اللقاء أضحى معوقا",34,"ق",2,0],["لاقيتُ من لاقى الزمانَ تحامياً","عني فَنَكّلَ صرفهُ تنكيلا",35,"ل",2,0],["لاقيتُ إبراهيمَ واحدَ عصرِه","وكَفى به من جُملة تفصيلا",35,"ل",2,0],["لاقيتُ مَنْ ألوى بنحسي سعدُهُ","لا زال سعداً للنحوسِ مُزيلا",35,"ل",2,0],["لاقى رجالاً ذوي مجدٍ قد اغتبقوا","آساره ولقوهُ وهو صبحان",36,"ن",1,0],["لاقيتَني ساعة لاقيتني","أثقلَ خلق اللَّه أجفانا",37,"ن",2,0],["لاقيتُ إبراهيمَ يرجحُ في الندى","والحلم والتقوى بكل وَزين",38,"ن",1,0],["لا قَدرَ لِلجُهَلاءِ حَتّى يَعمَلوا","لافَضلَ لِلعُلَماءِ حَتّى يَعمَلوا",39,"ل",3,0],["لا قلبَ يقتحمُ الحياةَ ولا حِجًى","يَسْمو سُمُوَّ الطَّائرِ الجوّابِ",40,"ب",1,0],["لا قلب الا وفيه الحزن مرتكم","وما لأبعاد هذا الحزن تحديد",41,"د",1,0],["لاقى اسامة وهو الضيغم الضاري","في الغاب صياد آساد وأنمار",42,"ر",1,1],["لاقى على سعد السعود صباحه","وجه تهلل كالصباح منوِّرا",43,"ر",2,0],["لاقَوا أُبُوَّتَهُم","غُرِّ المَناقِبِ وَالصِفاتِ",44,"ت",1,0],["لاقِ الزَمانَ تَجِدهُمو","عَن رَكبِهِ مُتَخَلِّفين",45,"ن",1,0],["لا قَلَّبَت أَيدي الفَوارِسِ بَعدَهُ","رُمحاً وَلا حَمَلَت جَواداً أَربَعُ",46,"ع",1,0],["لَأَقشَعَ عَن تِلكَ الوُجوهِ سَوادَها","وَأَمطَرَ في تِلكَ الأَكُفِّ الشَواحِبِ",47,"ب",1,0],["لاقَيتُ جودَكَ بِالسَماعِ وَدونَنا","شُغلُ المَهاري مِن فَضاءٍ سَبسَبِ",48,"ب",1,0],["لا قُدِّسَت تِلكَ الدَويُّ وَلا زَكَت","يَومَ التَغابُنِ تِلكُمُ الأَقلامُ",49,"م",1,0],["لِأَقتَلِعَن صَفاةَ الشِعرِ عَنهُ","فَما أَنا مِن دَوامِغِهِ بِغُمرِ",50,"ر",1,0],["لِأَقرَبَ أَرضَ الشَأمِ وَالناسُ لِم يَقُم","لَهُم خَيرُهُم ما بَلَّ عَيناً بِلالُها",51,"ل",3,0],["لا قَومَ أَكرَمُ مِن تَميمٍ إِذ غَدَت","عوذُ النِساءِ يُسَقنَ كَالآجالِ",52,"ل",1,1],["لاقتهم أينما ساروا تحيتنا","وجادهم حيث حلوا الوابل الغدق",53,"ق",1,1],["لَأَقطَعَنَّ القِفارَ مُمتَطِياً","جَوادَ عَزمٍ لِلنَجمِ مُنتَعِلا",54,"ل",2,0],["لاقَ بِأَمثالِهِ وَمُحكَمُهُ","لِمَن غَدا ذِكرُ حِلمِهِ مَثَلا",54,"ل",2,0],["لاقَيتَهُم وَالعِجاجُ لَو خُضِبَت","بِهِ فُروعُ الدُجى لَما نَصَلا",54,"ل",2,0],["لا قاهُمُ بِكُماةٍ عِندَ كَرِّهِمِ","عَلى الجُسومِ دُروعٌ مِن قُلوبِهِمِ",55,"م",1,0],["لاقَيتَنا مَلقى الكَريمِ لِضَيفِهِ","وَضَمَمتَنا ضَمَّ الكَميِّ لِسَيفِهِ",56,"ف",2,1],["لاقَيتَ أَبطالاً تَحُثُّ إِلى","ضَنكِ المَقامِ شَوازِباً قُبّا",57,"ب",2,0],["لا قَضى اللَهُ لي وِصالَكَ إِن كُن","تُ أَراني أَشتاقُ إِلّا إِلَيكا",58,"ك",2,0],["لاقى الكَريهَةَ وَهوَ مُغمِدُ رَوعِهِ","فيها وَلَكِن سَيفُهُ مَسلولُ",59,"ل",1,0],["لاقى إِذَن غَرسُهُم أَكدى ثَرىً وَجَرَت","مِنّي ظُنونُهُم في شَرِّ مَيدانِ",60,"ن",1,0],["لاقاهُمُ مَلِكٌ حَباهُ بِالعُلى","جَرسٌ وَجانا خُرَّةُ المَيمونُ",61,"ن",1,0],["لاقاكَ بابَكُ وَهوَ يَزئِرُ فَاِنثَنى","وَزَئيرُهُ قَد عادَ وَهوَ أَنينُ",61,"ن",1,0],["لاقى شَكائِمَ مِنكَ مُعتَصِمِيَّةً","أَهزَلنَ جَنبَ الكُفرِ وَهوَ سَمينُ",61,"ن",1,0],["لا قَدحَ في عودِ الإِمامَةِ بَعدَما","مَتَّت إِلَيكَ بِحُرمَةٍ وَذِمامِ",62,"م",1,0],["لاقاهُ بِالكاوي العَنيفِ بِدائِهِ","لَمّا رَآهُ لَم يُفِق بِالطالي",63,"ل",2,0],["لاقى الحِمامَ بِسُرَّ مَن راءَ الَّتي","شَهِدَت لِمَصرَعِهِ بِصِدقِ الفالِ",63,"ل",1,0],["لاقاكَ أَوَّلُهُ بِأَوَّلِ شِعرِهِ","فَأَهِب بِأَوَّلِهِ يَكُن لَكَ آخِرُه",64,"ر",2,0],["لا قلتَ حسبي وإنْ أسكرتَ لبيَ إذْ","أسرْتَ قلبي فهذا الأسرُ إحسانُ",65,"ن",1,0],["لأقلامِكَ السمرِ العوالي تواضعَتْ","وهابَتْكَ في أغمادِهنَّ المناصلُ",66,"ل",1,0],["لأقلامِكَ الرفعُ تُبنى بها","على الفتحِ أفعالُكَ الماضيَهْ",67,"ي",2,0],["لا قبضَ في صرفهمُ","ما همْ خيارُ المجلسِ",68,"س",1,0],["لاقاك حمزةُ في اللّواءِ مُكبِّراً","ومَشَى النبيُّ مُهَلِّلاً يَتَبَسَّمُ",69,"م",1,0],["لاقيتَ ربَّك قائماً تقضي الذي","يقضي الوفيُّ لأُمّةٍ وديارِ",70,"ر",1,0],["لا قُبَّةُ الإِسلامِ قائِمَةٌ وَلا","مُلكُ الخَلائِفِ ثابِتُ الأَركانِ",71,"ن",1,0],["لاقى بعكرمةٍ وبابنِ أُميَّةٍ","شَرّاً يَعُبُّ عُبَابَهُ وعُراما",72,"م",2,0],["لاقَت بِحُمرَتِها الخَليجَ فَأَلَّفا","خَجَلَ الصِبا وَمَدامِعَ العُشّاقِ",73,"ق",1,0],["لاقى نَداهُ نَبتَها فَتَرى يَداً","بَيضاءَ حَيثُ حَديقَةٌ خَضراءُ",74,"ا",2,0],["لِأَقرَبِها إِذا نُسِبُوا لِخَيرٍ","وَأَوراها إِذا اِنتُقى المُناقي",75,"ق",2,0],["لاقَيتُهُ ثَلِجاً تَندى أَنامِلُهُ","إِن يُعطِكَ اليَومَ لا يَمنَعكَ ذاكَ غَدا",76,"د",2,0],["لا قلتَ إنّ الدّينَ والدّنْيا لَهُ","عِوَضٌ ولُؤمُ مقالةٍ بُهْتانُها",77,"ن",3,0],["لاقيتَ كلَّ كتيبةٍ وفَلَلتَ كل","لَ ضريبَةٍ وألَنتَ كلَّ عَرِيك",78,"ك",1,0],["لا قُلتُ شِعراً وَلا سَمِعتُ غِناً","وَلا جَرى في مَفاصِلي السَكَرُ",79,"ر",1,0],["لَأَقطَعَنَّ نِياطَ الهَمِّ بِكاسِ","فَلَيسَ لِلهَمِّ مِثلُ الكاسِ مِن آسِ",80,"س",1,1],["لَأَقمِطَنَّكَ في عَص","بَةٍ بِفَضلِ رِداكا",81,"ك",2,0],["لاقى بِما قالَ لَموحاً باصِرا","فَأَصبَحَ العَبدُ الذَميمُ ذاعِرا",82,"ر",2,0],["لاقَيتُ مِن حُبِّكِ جَهدَ الهَوى","لِلَّهِ دَرّي في الهَوى ما لَقيت",83,"ت",1,0],["لاقَيتَ دُفّاعَ بَحرٍ لا يُضَعضِعُهُ","لِلمُشرِعينَ عَلى أَرجائِهِ شُرُبُ",84,"ب",1,0],["لاقى أَخاهُ مُسلِماً مُحرِماً","بِطَعنَةٍ في الصُبحِ نَجلاءِ",85,"ا",2,0],["لا قاضِيَ المِصرِ أَطَعتُم وَلا","الحَبرَ وَلا القَسُّ وَلا الموبَذا",86,"ذ",2,0],["لاقاكَ بِالخَطَرِ مَغرورٌ عَلى خَطَرٍ","وَكُنتَ بِالعِطرِ أَولى في تَلَقّيكا",87,"ك",2,0],["لاقى الردى فوق الجواد كأَنَّما","متن الجواد إلى التَلاقي موعد",88,"د",1,0],["لاقيتُ أَياما خفافاً مثلما","قاسيتُ أَياما عليّ ثقالا",89,"ل",2,0],["لاقيتُها أرقصُ بش","راً وأُغنِّي طربا",90,"ب",2,0],["لاقيتُها والريحُ تجمعُ شملَها","والسُّحبُ تجمع بَرقَها وغَمامَها",91,"ه",2,0],["لاقى بها طالُوتُ في حَرْبِهِ","جالوتَ صَدْرَ الزَّمَنِ الأقْدَم",92,"م",1,0],["لاقاكِ في العامِ الذي وَلّى فلمْ","يَسْألْكِ إلا قُبْلَةً في قابلِ",93,"ل",1,0],["لأقْضيَ هَمَّ النفسِ قبْلَ مَجَلَّةٍ","كأنّ عِظامي البالِياتِ بها خَطّ",94,"ط",1,0],["لاَ قَوْلَ غَيْرَ الْحَقِّ لِي","قَوْلٌ وَهَذا النَّهْجُ نَهْجِي",95,"ي",1,0],["لا قَضاءَ لِلشُّهُبِ الز","زهرِ بل مُسَخِّرها",96,"ر",3,0],["لاقَيتُ ما هَدَّ رُكنَ مَجدي","وَهَزَّ يمنايَ وَالشِمالا",97,"ل",2,0],["لا قدست نعمى تسربتها","كم حجة فيها لزنديق",98,"ق",1,0],["لا قلبَ إلا أحرفُ اسمك لحنُهُ","إن دقَّ، رتَّلهُنَّ في دقاته",99,"ت",2,0],["لا قدْسَ للأحكام إِلاَّ","حين تصدُرُ عن حكيم",100,"م",1,0],["لا قيتها وهي تهواني وأهواها","فما أحيلى تلاقينا وأحلاها",101,"ا",3,1],["لاقيتها وأغاريد الهوى بفمي","تشدو وتشدو وتستوحي محيّاها",101,"ا",3,0],["لاقَتْ أخَا قَنَصٍ يَسْعَى بأكْلُبِهِ","شَثْنَ البَنانِ لدَيْهِ أكلُبٌ جُسُرُ",102,"ر",1,0],["لا قُدِّسَتْ تِلكَ الدّوِيُّ ولا زَكَتْ","يَوْمَ التَّغابُنِ الأَقْلامُ",103,"م",1,0],["لاقيتُ أكرمَ من خبَّ المطيُّ به","ومن مشى فوق ظهر الأرض مذ سطحا",104,"ح",2,0],["لا قيتهُ وأنا المملوءُ من غضب","على الزمان فتسرَّى عنيّ الغضبا",105,"ب",2,0],["لا قُدِّستْ نعمى تسربلتها","أرقه مدحُك لا مُجدياً",106,"ي",2,0],["لاقوا أُبوّتَهم على","غُرِّ المناقبِ والصفات",107,"ت",1,0],["لاقَتْ أخَا قَنَصٍ يَسْعَى بأكْلُبِهِ","شَئْنَ البَنانِ لدَيْهِ أكلُبٌ جُسُرُ",108,"ر",1,0]]}