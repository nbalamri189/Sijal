بطال يوم كفاحها","https://www.aldiwan.net/poem34817.html","الكامل"],[441,"الرزء أفجع لو أطلت بكائي","https://www.aldiwan.net/poem14434.html","الكامل"],[441,"الرزء أفجع أن نسح دموعا","https://www.aldiwan.net/poem14461.html","الكامل"],[441,"على الشهيد الشريف اللوذعي علي","https://www.aldiwan.net/poem14474.html","البسيط"],[443,"معهن سارت بعض روحي فاذكري","https://www.aldiwan.net/poem55918.html","عموديه"],[448,"إن كان غير أهيل نجد","https://www.aldiwan.net/poem53764.html","مجزوء الكامل"],[453,"إرفيني إلى سمائك حتى","https://www.aldiwan.net/poem61563.html","الخفيف"],[458,"لعل الركب أن خلصوا نجيا","https://www.aldiwan.net/poem55813.html","الوافر"],[458,"طاف عليه بالرقمتينِ","https://www.aldiwan.net/poem55834.html","مخلع البسيط"],[458,"صدق الوشاة العهد عندك ضائع","https://www.aldiwan.net/poem56138.html","الكامل"],[458,"أولى لها أن يرعوي نفارها","https://www.aldiwan.net/poem56170.html","الرجز"],[458,"تهوى وأنت محلأ مصدود","https://www.aldiwan.net/poem56216.html","الكامل"],[461,"ضعي لامتداحي ما استطعت من العذر","https://www.aldiwan.net/poem15104.html","الطويل"],[461,"أجأ وسلمى أم بلاد الزاب","https://www.aldiwan.net/poem15904.html","الكامل"],[461,"إذا الشمس غابت عن مسالك مسهل","https://www.aldiwan.net/poem16148.html","الطويل"],[464,"عداك وجدي فعد عن عذلي","https://www.aldiwan.net/poem3178.html","عموديه"],[479,"بالله أيكما الميت فنبكيه","https://www.aldiwan.net/poem36867.html","البسيط"],[479,"الموت درس وعزرائيل ملقيه","https://www.aldiwan.net/poem36869.html","البسيط"],[479,"يا حادي الشوق يمم دار ماريانو","https://www.aldiwan.net/poem36918.html","البسيط"],[479,"ناشدتك الله في فتاك","https://www.aldiwan.net/poem36919.html","مخلع البسيط"],[479,"يا صاحب الذوق السلي","https://www.aldiwan.net/poem36980.html","مجزوء الكامل"],[479,"يا مفخر البيت الحسي","https://www.aldiwan.net/poem37045.html","مجزوء الكامل"],[479,"وحق سيف أنور","https://www.aldiwan.net/poem37204.html","مجزوء الرجز"],[479,"يا سفر سيفر وإن خطوك بالذهب","https://www.aldiwan.net/poem37206.html","البسيط"],[479,"الدهر دهر والرجال رجال","https://www.aldiwan.net/poem37622.html","الكامل"],[515,"صفو الحياة وإن طال المدى كدر","https://www.aldiwan.net/poem12141.html","البسيط"],[516,"أرق المحب وعاده سهده","https://www.aldiwan.net/poem48696.html","أحذ الكامل"],[529,"ما للطعام وللثياب أتيته","https://www.aldiwan.net/poem37126.html","الكامل"],[529,"لا قدس الله أرواح الروافض ما","https://www.aldiwan.net/poem37248.html","البسيط"],[538,"إن غاب صفو العيش عنا برهة","https://www.aldiwan.net/poem47565.html","عموديه"],[551,"قد مضى شهر الصيام","https://www.aldiwan.net/poem47208.html","مجزوء الرمل"],[551,"ما أرادت إلا الجفاء ظلوم","https://www.aldiwan.net/poem47245.html","الخفيف"],[551,"لا قضى الله لقلبي","https://www.aldiwan.net/poem47894.html","البسيط"],[553,"عاود عزاءك لا يعنف بك الذكر","https://www.aldiwan.net/poem68392.html","البسيط"],[553,"استمطر العين أن أحبابه احتملوا","https://www.aldiwan.net/poem68393.html","البسيط"],[558,"لا ووجه مسفر حاز الجمالا","https://www.aldiwan.net/poem33532.html","الرمل"],[558,"يا من تقاصر شكري عن أياديه","https://www.aldiwan.net/poem33626.html","البسيط"],[558,"أنا في الملاح على اليقين","https://www.aldiwan.net/poem33819.html","مجزوء الكامل"],[561,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[562,"قد نال يوسف بعد اليأس في كبر","https://www.aldiwan.net/poem52614.html","البسيط"],[575,"من ذا الذي من مقلتيه يقيني","https://www.aldiwan.net/poem2839.html","الكامل"]],"verses":[["لَأَقبِلَنَّ مَعشَراً","تِلكَ الطَوالَ اللُدُنا",0,"ن",2,0],["لا قى خُبَيبٌ وَيَزيدٌ روقَها","مِن غَيبَةٍ ماطِرُها القَنا اللَدَن",1,"ن",1,0],["لا قُلتُ بَعدَكَ لِلمَدامِعِ كَفكِفي","مِن عَبرَةٍ وَلَوَ اِنَّ دَمعي مِن دَمي",2,"م",2,0],["لا قَدَّسَ اللَهُ نَفساً مِنكَ جامِعَةً","كَيدَ البِغالِ إِلى ذي الجُلَّةِ الشَرَفِ",3,"ف",1,0],["لَأَقضِيَهُنَّ أَو أَقضي بِهَمّي","غَريبَ الوَجهِ في البَلَدِ الغَريبِ",4,"ب",1,0],["لأُقلِّدَنّكَ مِدْحَةً أمَويَّةً","فانْظُرْ مَنِ المُهدي لَها والقائِلُ",5,"ل",1,0],["لا قَدَّرَ اللَهُ بَعدَ اليَومِ تَعرِيَةً","إِلّا هَناءً عَلى عِزٍّ وَتَخليدِ",6,"د",1,0],["لَأَقفَرَ الجيدُ مِن دُرٍّ يُحيطُ بِهِ","وَالثَغرُ مِن لُؤلُؤٍ وَالكَأسُ مِن حَبَبِ",7,"ب",1,0],["لاقى رَبيعَةَ في الوَغى فَأَصابَهُ","طَعنٌ بِجائِفَةٍ إِلى الصَدرِ",8,"ر",1,0],["لاقَوا بِهَا مَا سَرَّهُمْ","مِنْ رِقَّةٍ وَمِنْ دِعَهْ",9,"ع",2,0],["لا قَسمَ أَوفَرُ مِن قَسَمٍ تَنالُ بِهِ","وِقايَةَ الدينِ وَالأَعراضِ وَالحَسَبِ",10,"ب",1,0],["لاَ قُوَّتِي قُوَّةُ الرَّاعِي رَكَائِبَهُ","يَأوِي فَيَأوِي إِلَيهِ الكَلبُ وَالرَّبَعُ",11,"ع",1,0],["لاقى قَناتِيَ مِضراراً عَشَوزَنَةً","لَم يَلقَ في مَتنِها وَصماً وَلا لينا",12,"ن",2,0],["لاقَوا فَوارِسَ يَطعَنونَ ظُهورَهُم","نَشطَ البُزاةِ عَواتِقَ الخِربانِ",13,"ن",1,0],["لاقوا بُعوثَ أَميرِ المُؤمِنينَ لَهُم","كَالريحِ إِذ بُعِثَت نَحساً عَلى عادِ",14,"د",1,0],["لاقَت جُحافٌ وَكَذّابٌ أَقادَهُمُ","مَسقِيَّةَ السُمِّ شُهباً غَيرَ أَغمادِ",14,"د",1,0],["لاقَت جُحافٌ هَواناً في حَياتِهِمُ","وَما تُقُبِّلَ مِنهُم روحُ أَجسادِ",14,"د",1,0],["لاقى بَنو الأَشعَثِ الكِندِيِّ إِذ نَكَثوا","وَاِبنُ المُهَلَّبِ حَرباً ذاتَ عُصوادِ",14,"د",1,0],["لاقَيتَ أَعيَنَ وَالزُبَيرَ وَجِعثِناً","أَعدالَ مُخزِيَةٍ عَلَيكَ ثِقالِ",15,"ل",1,0],["لاقى الفَرَزدَقُ ضَيعَةً لَم يُغنِها","إِنَّ الفَرَزدَقَ عَنكِ في أَشغالِ",15,"ل",1,0],["لاقى البَدِيُّ الكِلابَ فَاِعتَلَجا","مَوجُ أَتِيَّيهِما لِمَن غَلَبا",16,"ب",2,0],["لاقَت أَخا قَنَصٍ يَسعى بِأَكلُبِهِ","شَأنَ البَنانِ لَدَيهِ أَكلُبٌ جُسُرُ",17,"ر",1,0],["لَأَقولُ قَولاً لايُرَدُّ","وَلا يُرى لي فيهِ لا إِم",18,"م",1,0],["لاقيته والحال أنكد ما أرى","فأعادني والحال أوفق ما أشا",19,"ش",2,0],["لاقيته فشفى رجايَ وعانقت","كفاي من جدواه أطيب مُعتنَق",20,"ق",1,0],["لأقلام مولانا ثناً متضوّعٌ","فهل هي في الكافور تكتب بالمسك",21,"ك",1,0],["لاقَ بذا قرب ذا فقلنا","ما أليق البدر بالكمال",22,"ل",1,0],["لاقيتهُ وأنا المملوءُ من غضب","على الزمان فسرَّى عنِّيَ الغضبا",23,"ب",2,0],["لا قُدِّستْ من أبي العباس جاعرةٌ","ماء الفَياشل منها الدهر مسكوبُ",24,"ب",1,0],["لاقيت من صُدْغٍ عليه مُعَقْرَب","أفْعى تبرِّحُ بالفؤاد وعقربا",25,"ب",2,0],["لاقى الرجالُ غبوقَ المجد فاغتبقوا","منه ولاقَى صبوحَ المجد فاصطبحا",26,"ح",2,0],["لاقيتُ من لا أبالي بعده أبداً","من ضنَّ عني بمعروفٍ ومن سمحا",26,"ح",2,0],["لأقمع كل عفريت وجنٍّ","بكل مفازة وبكل بيدِ",27,"د",1,0],["لا قَدَّس اللَه بالإقبال دولتَكُم","فإن إقبالكمْ لِلناس إدبارُ",28,"ر",1,0],["لأقربُ من إصعاق غيثٍ غياثُهُ","وإن رجّع الغيثُ الرعودَ وأومضا",29,"ض",2,0],["لا قدَّسَ الخَلَفُ المخلَّفُ منكُمُ","ولداً ولا فُرَّاطُكمْ فُرّاطا",30,"ط",2,0],["لاقى هنالك كلَّ ذلك لم يخم","عنه وهمْ من ضارطٍ أو ناحط",31,"ط",1,0],["لا قاتَل اللَّه ربُّ الناس لؤمَكُمُ","بل قاتل الكاذبَ المكذوب من طمعي",32,"ع",2,0],["لا قدست نعمى تسربلتها","كم حجة فيها لزنديق",33,"ق",1,0],["لا قصوراً من الكرامة عنا","غير أن اللقاء أضحى معوقا",34,"ق",2,0],["لاقيتُ من لاقى الزمانَ تحامياً","عني فَنَكّلَ صرفهُ تنكيلا",35,"ل",2,0],["لاقيتُ إبراهيمَ واحدَ عصرِه","وكَفى به من جُملة تفصيلا",35,"ل",2,0],["لاقيتُ مَنْ ألوى بنحسي سعدُهُ","لا زال سعداً للنحوسِ مُزيلا",35,"ل",2,0],["لاقى رجالاً ذوي مجدٍ قد اغتبقوا","آساره ولقوهُ وهو صبحان",36,"ن",1,0],["لاقيتَني ساعة لاقيتني","أثقلَ خلق اللَّه أجفانا",37,"ن",2,0],["لاقيتُ إبراهيمَ يرجحُ في الندى","والحلم والتقوى بكل وَزين",38,"ن",1,0],["لا قَدرَ لِلجُهَلاءِ حَتّى يَعمَلوا","لافَضلَ لِلعُلَماءِ حَتّى يَعمَلوا",39,"ل",3,0],["لا قلبَ يقتحمُ الحياةَ ولا حِجًى","يَسْمو سُمُوَّ الطَّائرِ الجوّابِ",40,"ب",1,0],["لا قلب الا وفيه الحزن مرتكم","وما لأبعاد هذا الحزن تحديد",41,"د",1,0],["لاقى اسامة وهو الضيغم الضاري","في الغاب صياد آساد وأنمار",42,"ر",1,1],["لاقى على سعد السعود صباحه","وجه تهلل كالصباح منوِّرا",43,"ر",2,0],["لاقَوا أُبُوَّتَهُم","غُرِّ المَناقِبِ وَالصِفاتِ",44,"ت",1,0],["لاقِ الزَمانَ تَجِدهُمو","عَن رَكبِهِ مُتَخَلِّفين",45,"ن",1,0],["لا قَلَّبَت أَيدي الفَوارِسِ بَعدَهُ","رُمحاً وَلا حَمَلَت جَواداً أَربَعُ",46,"ع",1,0],["لَأَقشَعَ عَن تِلكَ الوُجوهِ سَوادَها","وَأَمطَرَ في تِلكَ الأَكُفِّ الشَواحِبِ",47,"ب",1,0],["لاقَيتُ جودَكَ بِالسَماعِ وَدونَنا","شُغلُ المَهاري مِن فَضاءٍ سَبسَبِ",48,"ب",1,0],["لا قُدِّسَت تِلكَ الدَويُّ وَلا زَكَت","يَومَ التَغابُنِ تِلكُمُ الأَقلامُ",49,"م",1,0],["لِأَقتَلِعَن صَفاةَ الشِعرِ عَنهُ","فَما أَنا مِن دَوامِغِهِ بِغُمرِ",50,"ر",1,0],["لِأَقرَبَ أَرضَ الشَأمِ وَالناسُ لِم يَقُم","لَهُم خَيرُهُم ما بَلَّ عَيناً بِلالُها",51,"ل",3,0],["لا قَومَ أَكرَمُ مِن تَميمٍ إِذ غَدَت","عوذُ النِساءِ يُسَقنَ كَالآجالِ",52,"ل",1,1],["لاقتهم أينما ساروا تحيتنا","وجادهم حيث حلوا الوابل الغدق",53,"ق",1,1],["لَأَقطَعَنَّ القِفارَ مُمتَطِياً","جَوادَ عَزمٍ لِلنَجمِ مُنتَعِلا",54,"ل",2,0],["لاقَ بِأَمثالِهِ وَمُحكَمُهُ","لِمَن غَدا ذِكرُ حِلمِهِ مَثَلا",54,"ل",2,0],["لاقَيتَهُم وَالعِجاجُ لَو خُضِبَت","بِهِ فُروعُ الدُجى لَما نَصَلا",54,"ل",2,0],["لا قاهُمُ بِكُماةٍ عِندَ كَرِّهِمِ","عَلى الجُسومِ دُروعٌ مِن قُلوبِهِمِ",55,"م",1,0],["لاقَيتَنا مَلقى الكَريمِ لِضَيفِهِ","وَضَمَمتَنا ضَمَّ الكَميِّ لِسَيفِهِ",56,"ف",2,1],["لاقَيتَ أَبطالاً تَحُثُّ إِلى","ضَنكِ المَقامِ شَوازِباً قُبّا",57,"ب",2,0],["لا قَضى اللَهُ لي وِصالَكَ إِن كُن","تُ أَراني أَشتاقُ إِلّا إِلَيكا",58,"ك",2,0],["لاقى الكَريهَةَ وَهوَ مُغمِدُ رَوعِهِ","فيها وَلَكِن سَيفُهُ مَسلولُ",59,"ل",1,0],["لاقى إِذَن غَرسُهُم أَكدى ثَرىً وَجَرَت","مِنّي ظُنونُهُم في شَرِّ مَيدانِ",60,"ن",1,0],["لاقاهُمُ مَلِكٌ حَباهُ بِالعُلى","جَرسٌ وَجانا خُرَّةُ المَيمونُ",61,"ن",1,0],["لاقاكَ بابَكُ وَهوَ يَزئِرُ فَاِنثَنى","وَزَئيرُهُ قَد عادَ وَهوَ أَنينُ",61,"ن",1,0],["لاقى شَكائِمَ مِنكَ مُعتَصِمِيَّةً","أَهزَلنَ جَنبَ الكُفرِ وَهوَ سَمينُ",61,"ن",1,0],["لا قَدحَ في عودِ الإِمامَةِ بَعدَما","مَتَّت إِلَيكَ بِحُرمَةٍ وَذِمامِ",62,"م",1,0],["لاقاهُ بِالكاوي العَنيفِ بِدائِهِ","لَمّا رَآهُ لَم يُفِق بِالطالي",63,"ل",2,0],["لاقى الحِمامَ بِسُرَّ مَن راءَ الَّتي","شَهِدَت لِمَصرَعِهِ بِصِدقِ الفالِ",63,"ل",1,0],["لاقاكَ أَوَّلُهُ بِأَوَّلِ شِعرِهِ","فَأَهِب بِأَوَّلِهِ يَكُن لَكَ آخِرُه",64,"ر",2,0],["لا قلتَ حسبي وإنْ أسكرتَ لبيَ إذْ","أسرْتَ قلبي فهذا الأسرُ إحسانُ",65,"ن",1,0],["لأقلامِكَ السمرِ العوالي تواضعَتْ","وهابَتْكَ في أغمادِهنَّ المناصلُ",66,"ل",1,0],["لأقلامِكَ الرفعُ تُبنى بها","على الفتحِ أفعالُكَ الماضيَهْ",67,"ي",2,0],["لا قبضَ في صرفهمُ","ما همْ خيارُ المجلسِ",68,"س",1,0],["لاقاك حمزةُ في اللّواءِ مُكبِّراً","ومَشَى النبيُّ مُهَلِّلاً يَتَبَسَّمُ",69,"م",1,0],["لاقيتَ ربَّك قائماً تقضي الذي","يقضي الوفيُّ لأُمّةٍ وديارِ",70,"ر",1,0],["لا قُبَّةُ الإِسلامِ قائِمَةٌ وَلا","مُلكُ الخَلائِفِ ثابِتُ الأَركانِ",71,"ن",1,0],["لاقى بعكرمةٍ وبابنِ أُميَّةٍ","شَرّاً يَعُبُّ عُبَابَهُ وعُراما",72,"م",2,0],["لاقَت بِحُمرَتِها الخَليجَ فَأَلَّفا","خَجَلَ الصِبا وَمَدامِعَ العُشّاقِ",73,"ق",1,0],["لاقى نَداهُ نَبتَها فَتَرى يَداً","بَيضاءَ حَيثُ حَديقَةٌ خَضراءُ",74,"ا",2,0],["لِأَقرَبِها إِذا نُسِبُوا لِخَيرٍ","وَأَوراها إِذا اِنتُقى المُناقي",75,"ق",2,0],["لاقَيتُهُ ثَلِجاً تَندى أَنامِلُهُ","إِن يُعطِكَ اليَومَ لا يَمنَعكَ ذاكَ غَدا",76,"د",2,0],["لا قلتَ إنّ الدّينَ والدّنْيا لَهُ","عِوَضٌ ولُؤمُ مقالةٍ بُهْتانُها",77,"ن",3,0],["لاقيتَ كلَّ كتيبةٍ وفَلَلتَ كل","لَ ضريبَةٍ وألَنتَ كلَّ عَرِيك",78,"ك",1,0],["لا قُلتُ شِعراً وَلا سَمِعتُ غِناً","وَلا جَرى في مَفاصِلي السَكَرُ",79,"ر",1,0],["لَأَقطَعَنَّ نِياطَ الهَمِّ بِكاسِ","فَلَيسَ لِلهَمِّ مِثلُ الكاسِ مِن آسِ",80,"س",1,1],["لَأَقمِطَنَّكَ في عَص","بَةٍ بِفَضلِ رِداكا",81,"ك",2,0],["لاقى بِما قالَ لَموحاً باصِرا","فَأَصبَحَ العَبدُ الذَميمُ ذاعِرا",82,"ر",2,0],["لاقَيتُ مِن حُبِّكِ جَهدَ الهَوى","لِلَّهِ دَرّي في الهَوى ما لَقيت",83,"ت",1,0],["لاقَيتَ دُفّاعَ بَحرٍ لا يُضَعضِعُهُ","لِلمُشرِعينَ عَلى أَرجائِهِ شُرُبُ",84,"ب",1,0],["لاقى أَخاهُ مُسلِماً مُحرِماً","بِطَعنَةٍ في الصُبحِ نَجلاءِ",85,"ا",2,0],["لا قاضِيَ المِصرِ أَطَعتُم وَلا","الحَبرَ وَلا القَسُّ وَلا الموبَذا",86,"ذ",2,0],["لاقاكَ بِالخَطَرِ مَغرورٌ عَلى خَطَرٍ","وَكُنتَ بِالعِطرِ أَولى في تَلَقّيكا",87,"ك",2,0],["لاقى الردى فوق الجواد كأَنَّما","متن الجواد إلى التَلاقي موعد",88,"د",1,0],["لاقيتُ أَياما خفافاً مثلما","قاسيتُ أَياما عليّ ثقالا",89,"ل",2,0],["لاقيتُها أرقصُ بش","راً وأُغنِّي طربا",90,"ب",2,0],["لاقيتُها والريحُ تجمعُ شملَها","والسُّحبُ تجمع بَرقَها وغَمامَها",91,"ه",2,0],["لاقى بها طالُوتُ في حَرْبِهِ","جالوتَ صَدْرَ الزَّمَنِ الأقْدَم",92,"م",1,0],["لاقاكِ في العامِ الذي وَلّى فلمْ","يَسْألْكِ إلا قُبْلَةً في قابلِ",93,"ل",1,0],["لأقْضيَ هَمَّ النفسِ قبْلَ مَجَلَّةٍ","كأنّ عِظامي البالِياتِ بها خَطّ",94,"ط",1,0],["لاَ قَوْلَ غَيْرَ الْحَقِّ لِي","قَوْلٌ وَهَذا النَّهْجُ نَهْجِي",95,"ي",1,0],["لا قَضاءَ لِلشُّهُبِ الز","زهرِ بل مُسَخِّرها",96,"ر",3,0],["لاقَيتُ ما هَدَّ رُكنَ مَجدي","وَهَزَّ يمنايَ وَالشِمالا",97,"ل",2,0],["لا قدست نعمى تسربتها","كم حجة فيها لزنديق",98,"ق",1,0],["لا قلبَ إلا أحرفُ اسمك لحنُهُ","إن دقَّ، رتَّلهُنَّ في دقاته",99,"ت",2,0],["لا قدْسَ للأحكام إِلاَّ","حين تصدُرُ عن حكيم",100,"م",1,0],["لا قيتها وهي تهواني وأهواها","فما أحيلى تلاقينا وأحلاها",101,"ا",3,1],["لاقيتها وأغاريد الهوى بفمي","تشدو وتشدو وتستوحي محيّاها",101,"ا",3,0],["لاقَتْ أخَا قَنَصٍ يَسْعَى بأكْلُبِهِ","شَثْنَ البَنانِ لدَيْهِ أكلُبٌ جُسُرُ",102,"ر",1,0],["لا قُدِّسَتْ تِلكَ الدّوِيُّ ولا زَكَتْ","يَوْمَ التَّغابُنِ الأَقْلامُ",103,"م",1,0],["لاقيتُ أكرمَ من خبَّ المطيُّ به","ومن مشى فوق ظهر الأرض مذ سطحا",104,"ح",2,0],["لا قيتهُ وأنا المملوءُ من غضب","على الزمان فتسرَّى عنيّ الغضبا",105,"ب",2,0],["لا قُدِّستْ نعمى تسربلتها","أرقه مدحُك لا مُجدياً",106,"ي",2,0],["لاقوا أُبوّتَهم على","غُرِّ المناقبِ والصفات",107,"ت",1,0],["لاقَتْ أخَا قَنَصٍ يَسْعَى بأكْلُبِهِ","شَئْنَ البَنانِ لدَيْهِ أكلُبٌ جُسُرُ",108,"ر",1,0],["لا قصد للقلب الاهم اجل وله","بحبهم في الهوى نهي واثبات",109,"ت",1,0],["لاقتْ بهم خُوصُ المهارىَ مثلما","لاقى بأربَعِها الثرى واليَرْمعُ",110,"ع",1,0],["لأقمت في نعماءَ مطمئنَّةٍ","تُحكِّم الفؤادَ في إطرابهِ",111,"ب",2,0],["لَاقَوهُمُ بِرِماحٍ طالَما اِنحَطَمَت","وَاِستَخلَفَت في العِدى الهِندِيَّةَ القُضَبا",112,"ب",2,0],["لَأَقَمتَ مِن حُجّابِ قَصرِكَ قَيصَراً","وَلَكانَ مِن أَتباعِ مُلكِكَ تُبَّعُ",113,"ع",1,0],["لاقى البَوارَ فَعاذَ بِالعَفوِ الَّذي","يَمحو الذُنوبَ وَيَغفِرُ الإِجراما",114,"م",2,0],["لاقى الشدائد بالتّسليم منتظراً","لطف الإله ولم يظهر له مضض",115,"ض",1,0],["لا قلتُ إِنَّ الودَّ باكتسابِ","ما لم يكنْ طبعاً من الأَحبابِ",116,"ب",1,0],["لا قَصْرَ فِيها عَلَى الدَّوَامِ سَجَا","أَوْ دَامَ مُلْكٌ ... كذَلِكَ الدُّنْيَا",117,"ي",2,0],["لاقوا وراء الحلم ينثر عزمهُ","يبني المذاكي منهم والفرحا",118,"ح",2,0],["لاقت بعطفيك ولاقى بها","كالعنق للحسناء في الحلية",119,"ه",1,0],["لَأَقَرَّ كُلٌّ طائِعينَ بِأَنَّهُ","أَولاهُمُ بِفَصاحَةٍ وَبَيانِ",120,"ن",1,0],["لَأُقيمَنَّ لِأَبناءِ الوَغى","سوقَ إِقدامٍ وَطَعنٍ وَجِلادِ",121,"د",1,0],["لِأَقضِي بَعضَ واجِبِهِ وَأَحظى","بِلَفظٍ مِنهُ كَالدُرِّ اِنتِقادا",122,"د",2,0],["لاقُوا ثَلاثَةَ آلافٍ وَما جَبُنُوا","عَنهُم وَلا اِستَشعَرُوا خَوفاً وَلا بَرَما",123,"م",2,0],["لأَقْتَضِي لَذَّةً مُطْلِتُ بِهَا","يَعُودُ رِبْحِي فِيها إلَى خُسْرِ",124,"ر",1,0],["لاقَى الصَوارمَ وَالأَقلامَ فَاِنبَلَجَتْ","نارٌ وَنورٌ عَلى رُشدٍ يُلاقيها",125,"ي",3,0],["لاقتَضَى الحزم أن نخاف إذِ المم","كِنُ في العقلِ جائزُ الإمْضاءِ",126,"ا",2,0],["لا قدّس الله قوما إن بدوا وعظوا","حتى إذا غلقوا أبوابهم فسقوا",127,"ق",3,0],["لاقَ قَلبي بَنانَه فَمَدادُ ال","عَينِ مِن هَجرِ مالِكي في اِنهِمالِ",128,"ل",1,0],["لا قَضى اللَهُ بِبَينٍ","أَبَداً بَيني وَبَينَه",129,"ه",1,1],["لا قَينَ عَيشاً مِنَ الدُنيا سُعِدنَ بِهِ","وَما المَعيشَةُ إِلّا مُتعَةٌ سَلَفُ",130,"ف",1,0],["لاقَيتُ في غَربِ الشَبابِ فَلَم يَكُن","قَلبي لَها غَرَضاً وَلَم أَستَقتِلِ",131,"ل",1,0],["لا قريب حنا عليها ولا","خل شفيق بحزنها واساها",132,"ا",3,0],["لا قَضى اللَه بيننا بالفراقِ","إنَّ طعمَ الفراق مُرُّ المذاقِ",133,"ق",1,1],["لأقبلن لأجلكم ذاك الثرى","وأعفر الخدين بالصوان",134,"ن",1,0],["لا قارِحٌ مِنهُمُ أُؤَمَّلُ أَن","يَنالَني خَيرُهُ وَلا جَذَعُ",135,"ع",1,0],["لأقضينَ حياتي كلها كمداً","مُشَتَّتَ الشملِ حتَّى آخِرِ الأَبَدِ",136,"د",1,0],["لاقيتُ من بعد فِراقي له","وَجداً شجاعاً وسُلُواً جَبَان",137,"ن",1,0],["لَأَقسَمتُ لا تَنفَكُّ مِنّى مُحارِبٌ","عَلى آلَةٍ حَدباءَ حَتّى تَنَدَّما",138,"م",2,0],["لاقيت يا نفس حقا ما حَكى الحاكي","فامضى لشأنك اني لست أَلحاك",139,"ك",1,1],["لاقَى السَّلامَةَ فالزّمَانُ مُسالِمٌ","دونَ انْتِقاضٍ والأَمانُ مُشايِعُ",140,"ع",1,0],["لاقَى الرَّدَى بِأبي يَحْيَاهُم فَغَدا","لَقىً وعَهْدِي بِهِ كالليْثِ شَيْحانا",141,"ن",2,0],["لاقَى بِيَ الجَدُّ العَثورُ عِصَابَةً","ذَهَبَتْ بِمَالِي كَيْ يَسُوءَ مآلِي",142,"ل",2,0],["لا قَبَضَ الدَّهْرُ يَدِي عَنْ غِنىً","وَهْيَ إِلى جُودِكَ مَبْسُوطَهْ",143,"ط",2,0],["لأَقصُدَن مَلِكاً أَعيَت فَصاحَتُهُ","قُساً وَما نالَها مِن قَبلُ سَحبانُ",144,"ن",1,0],["لَأُقَوِّضَن عَنهُم خِيامي قاصِداً","دارَ النَعيمِ بِظِلِّها الإِنعامُ",145,"م",1,0],["لا قَوسَ إِلّا ما بَرَتهُ يَمينُهُ","شَتّانَ بَينَ السَيفِ وَالعُكّازِ",146,"ز",1,0],["لاقى الألاقي لأجل الشام حيث رَمَتْ","به عن الأهل مضطراً نوى قذُفُ",147,"ف",1,0],["لا قَبْلنا في ذا المصابِ عزاءَ","أحسنَ الدهرُ بَعدَها أو أساءَ",148,"ا",2,1],["لاقَى الدُّجَى مِن شَعْرِهِ بالدُّجَى","والصُّبْحَ مِن طَلْعَتهِ بِالصَّباحْ",149,"ح",1,0],["لِإِقدامي لِأَقدامي مَخاضٌ","بِبَحرٍ مالَهُ قَعرٌ يُرامُ",150,"م",1,1],["لأَقسم بِالنُجوم مِن الدَراري","بِجيدك وَالهِلال مِن السِوارِ",151,"ر",1,0],["لأَقرِيَنَّ ضيوفَ الهمِّ نازلةً","شُحومَ أسنمةِ العِيديّةِ البُزُل",152,"ل",1,0],["لَأَقرَضنَ دُرّاً مِن غِناءِ سَواجِعٍ","فَوَفَّيتُ دُرّاً مِن بُكاءِ سَواجِمِ",153,"م",1,0],["لا قُلتُ مالي وَإِن أَثَرَت يَدي أَبَداً","يُشيرُ بِالنَفى ما يا قائِلاً مالي",154,"ي",1,0],["لأقيمنَّ ما حَيِيتُ على الشُّك","رِ لِهذا وذاكَ إذ حَكياكا",155,"ك",2,0],["لا قَولَ عِندَهُما ولَي","سا يَعرِفانِ سِوى الفِعالِ",156,"ل",1,0],["لا قلبَ إلا كَقَلبي ليسَ يأيسُ إن","آيَستُه فَإذا أطمَعتُه طَمِعا",157,"ع",2,0],["لاقى جَذيمةَ في جأواءَ مُشعَلةًٍ","فيها حراشِفُ بالنيرانِ تَرتَشقُ",158,"ق",1,0],["لاقت لهم أُمّاً ولاقَ ابناً لها","إذ منطق المعلول علَّتُه الفم",159,"م",1,0],["لاقاه عرياناً بمهجته وقد","نبذ الورى الخدّاع عنه إلى الورا",160,"ر",2,0],["لاقى عدوًّا بلا وعيٍّ ولا خُلُقٍ","فكانَ أحسنَ في الميدانِ أخلاقا",161,"ق",2,0],["لا قضت عيناي فيها واجباً","إن تكن عيناي تستجدي السحابا",162,"ب",2,0],["لاقَوا غَداةَ قُلابَ حَتفَهُمُ","سَوقَ العَتيرِ يُساقُ لِلعَترِ",163,"ر",1,0],["لاقى المنية وهو يعتنق التقى","ولغير فعل البر لم يك يألف",164,"ف",1,0],["لاقى المنية في التسعين متشحاً","برّ الفضائل في عمدٍ وفي عرضِ",165,"ض",1,0],["لاق المدامة بالمسرة لاقي","واقرن مع الصهبا رضاب الساقي",166,"ق",2,1],["لاقى المنية باسماً لكنه","أبكى العيون ودمعها مطلولُ",167,"ل",1,0],["لا قرّ طرفي بالوصالِ ولا دَنا","بدُنوّ داركُمُ إليّ مُرادي",168,"د",2,0],["لا قلتُ أُفٍّ فإنّها","شررٌ بأفِّ تعودُ جَمْرا",169,"ر",2,0],["لاقيتهم ووجوه الخيل عابسة","والبيض ضاحكة والموت محتشد",170,"د",1,0],["لاقَتْكَ دونَ حُصُونِها فَكَأَنَّما","لاقَتْ سُيُوفَكَ فِي فضاءِ بَرَاحِها",171,"ح",3,0],["لا قلب إِلا في لظاه مقلب","لا مقلة إِلا بكت بدماء",172,"ا",2,0],["لا قلب إلا في أسى متقلب","حزناً عليك وحرقة ونزوعا",173,"ع",2,0],["لاقى المنايا وما لاقت عوارضه","بياض شيب ومن حلم نفى كهل",174,"ل",1,0],["لا قوة تستطيع مس جنابها","ولو انها بلغت علا الأملاك",175,"ك",1,0],["لاقر دون محجر","واهيله وجدى ومجدى",176,"د",2,0],["لا قيود الورى ولا العرف يجدي","إن أبى الحب أو أراد المحالا",177,"ل",2,0],["لأقضيَ فيك حقَّ الشكر شيئاً","كما قضَّيتَ حقَّ الودِّ فيَّا",178,"ي",2,0],["لا قاد ذلُّ الأطماع رأسي","ما دام لي ذو الرياستينِ",179,"ن",1,0],["لا قِرن لي وعليَّ منه وفي يدي","درعٌ مضاعفةٌ وسيفٌ قاطعُ",180,"ع",1,0],["لا قلَّصتْ عنكم ظلالَ مُلككم","نوائبُ الدهر ولا أقدارُها",181,"ر",3,0],["لا قبلَ نائله إذا سُئل الندى","وعدٌ ولا قبل اللقاءِ وعيدُ",182,"د",1,0],["لاقتحمنَّ الحي عزَّ حريمهُ","بشعواء تحوي شارد المجد والفخر",183,"ر",1,0],["لاقيتَ فخر الدين يكْشفُ نقْعها","كشف الغزالةِ مُضْمحلَّ ضبَاب",184,"ب",1,0],["لأقلامِه في كل ذُعْرٍ وأزْمَةٍ","رَدىً وندىً مُستعظَمٌ ومُذالُ",185,"ل",1,0],["لا قرعت بعدها الآكام ولا","ريعت بشدّ النسوع الجُدُل",186,"ل",1,0],["لاقيت صهرك يا متبوعه عجلا","يرثيك في صهرك الميهوب راثيه",187,"ي",2,0],["لاقت أباها ولم تجزع لفاجعة","فيه فلاقت سرورا في تلاقيه",188,"ي",2,0],["لاقلت أمست خلاء فهي عامرة","ولا أقول خراب وهو عمران",189,"ن",1,0],["لاقيت سمعا مري تطاعي","إني السميع إلى نداك",190,"ك",1,0],["لأقمت تيجان البيا","ن براحة التيجاني",191,"ن",2,0],["لاقيت في ذي القعدة ال","مولى بوجه نائر",192,"ر",1,0],["لاقت بأيدي الظلما","وحق آساد الحمى",193,"م",2,0],["لاقت يداها من الأحرار ما اقترفت","لما استطالت رماها اللّه بالعطب",194,"ب",1,0],["لاقى المبرة في العواصم كلها","ما حل إلا حفه الإجلال",195,"ل",1,0],["لا قدست ليلة كادت صبيحتها ال","أكباد حزناً على أيوب تنفطر",196,"ر",1,0],["لا قَومُهُ قَومي وَلا بَلَدي","فَنَكونُ حيناً جيرَة بلدُه",197,"د",2,0],["لا قَدَّسَ الرَّحْمنُ عَبْدَ مَطامِعٍ","يُمْسي ويُصْبِحُ في طِلابِ الْفَانِي",198,"ي",1,0],["لا قَدَّسَ اللهُ أَرْواحَ الرَّوافِضِ ما","تَبَسَّمَ البَرْقُ بَيْنَ العارِضِ الهَطِلِ",199,"ل",1,1],["لا قَلبَنَا مُتَوجِّعٌ لا بَالَنا","مُتَصَدِّعٌ لا زَفرَةً تَتَرَجَّعُ",200,"ع",1,0],["لا قَضى اللَّهُ لما أعْ","طاك إلّا بالتّمامِ",201,"م",1,0],["لا قَلاك الّذي علاك من السَّعْ","دِ ملالاً ولا جفاك النَّعيمُ",202,"م",1,0],["لا قَضى اللَّه لِقَلبي","في الهَوى أَن يَستَريحا",203,"ح",2,1],["لاقى بَنو قَيصَرٍ لَمّا هَمَمتَ بِهِم","مِثلَ الَّذي سَوفَ تَلقى مِثلَهُ الخَزَرُ",204,"ر",1,0],["لاقى بِكَ المَجدُ قَوماً يَحتَلونَ بِهِ","فَقَلَّدوكَ حُلِيَّ المَجدِ إِذ عُطِلوا",205,"ل",3,0],["لاق بالقلب هوى ساكنه","وهو يفنيه ويبقيه محالا",206,"ل",2,0],["لا قهر يلحقه لا عون ينصره","لا حصر يجمعه لا قطر يحويه",207,"ي",2,0],["لا قيد لي في مطلق ال","حسن المفرِّح للحزين",208,"ن",1,0],["لا قَدحَ إِن لم تُورِ ناراً بِهَجَر","ذاتَ سَناً يُوقِدُها مَنِ اِفتَخَر",209,"ر",1,0],["لاقاهُ إذ قلتُ تأريخاً أُبشِّرُهُ","كيوسُفِ الحُسنِ إذ لاقاهُ يعقوبُ",210,"ب",1,0],["لاقيتُه يوماً فقال أَما ترى","ما قد جرى منهم لَقدْ ظلمُوني",211,"ي",1,0]]}