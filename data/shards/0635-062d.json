يط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55147","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55168","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54920","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54576","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55418","الخفيف"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67319","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141981","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43849","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43643","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54297","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54273","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54272","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54236","المجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54220","البسيط"],[106,"هرم يهوي 2","https://www.poetsgate.com/ViewPoem.aspx?id=179486",""],[106,"صحا الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=179625",""],[106,"فقيدُ الإسلام!","https://www.poetsgate.com/ViewPoem.aspx?id=179686",""],[106,"موكب الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=179775",""],[90,"ماهذه النفوس قداح","https://www.poetsgate.com/ViewPoem.aspx?id=178947",""],[45,"لمَّا اسْتَعَنْتُ على اَلخُطُوبِ بِصَالحٍ","https://www.poetsgate.com/ViewPoem.aspx?id=32111",""],[91,"الطبيعة","https://www.poetsgate.com/ViewPoem.aspx?id=52956",""],[31,"أَبيني، اليَومَ، يا نُعْمُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19082&r=&rc=345",""],[91,"تحيّة الدستور العثماني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67927&r=&rc=206",""],[3,"سَلا القلبَ عَمّا كان يهْوى ويطْلبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10653&r=&rc=7",""],[96,"الملك البطل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66347&r=&rc=23",""]],"verses":[["صِحاحُ أَديمِ الوُدِّ لا عَيبَ فيهِمُ","سِوى ما يَقولُ الجادِبُ المُتَعَلِّلُ",0,"ل",1,0],["صَحِبتُ الرِجالَ الخابِطينَ إِلى العُلى","فَشَبَّطَني لُؤمُ الزَمانُ وَأُسرِعُ",1,"ع",1,0],["صَحَوتُ مِن سُكرِهِ وَلَكِن","بي مِن بَقايا الهَوى خُمارُ",2,"ر",1,0],["صَحِبنا الدَهرَ وَالأَيّامُ بيضٌ","وَنَحنُ نَواضِرٌ سودُ الشُعورِ",3,"ر",1,0],["صَحِبتُم خِضابَ الزاعِبيّاتِ ناصِلاً","وَمِن عَلَقِ الأَقرانِ ما لا يُخَضِّبُ",4,"ب",1,0],["صَحبْتُكُمُ وَالْعَيْشُ أَغْبَرُ وَالغِنى","تَحَسَّرَ عَنْكُم وَالرِّياحُ سُكونُ",5,"ن",1,0],["صَحِبْتُهُ حينَ لا خِلٌّ يؤازِرُهُ","ولا يَخُبُّ إِلى واديه مَنجودُ",6,"د",1,0],["صَحا بَعدَ سُكرٍ وَاِنتَخى بَعدَ ذِلَّةٍ","وَقَلبُ الَّذي يَهوى العُلا يَتَقَلَّبُ",7,"ب",1,0],["صَحا مِن سُكرِهِ قَلبي وَفاق","وَزارَ النَومُ أَجفاني اِستِراقا",8,"ق",2,1],["صَحائِفُ عِندي لِلعِتابِ طَوَيتُها","سَتُنشَرُ يَوماً وَالعِتابُ يَطولُ",9,"ل",1,1],["صَحَّحتِ مِنكِ وَعيداً","وَالوَعدُ مِنكِ عَليلُ",10,"ل",1,0],["صَحا كُلُّ ذي لُبٍّ وَكُلُّ مُتَيَّمٍ","وَقَلبي بِلُبنى ما حَيَيتُ مُرَوَّعُ",11,"ع",1,0],["صَحا كُلَّ ذي وِدٍّ عَلِمتُ مَكانَهُ","سِوايَ فَإِنّي ذاهِبُ العَقلِ مُغرَمُ",12,"م",1,0],["صحِبَ اللهُ حيْثُ سِرْتَ رِكاباً","قدْ سَرَى الطّيبُ منْهُ في الآفاقِ",13,"ق",1,0],["صِحْتُ مَنْ ينْصُرُ الغَريبَ فلمّا","لمْ أجِدْ ناصِراً بلَعْتُ دُموعي",14,"ي",1,0],["صَحِب الرَّكَائِبَ وَالحُمُولُ حَدِيثُهَا","حَتَّى تَجَاوَزَ لِلْعِرَاقِ الشَّامَا",15,"م",2,0],["صِحْتُ بِالرَّبْعِ فَلَمْ يَسْتَجِيبُوا","لَيْتَ شِعْرِي أيْنَ يَمْضِي الْغَرِيبُ",16,"ب",1,1],["صَحَّ الهَوَاءُ فَمَا يَعْتَلُّ مِنْ أَحَدٍ","إِلاَّ النَّسِيمُ ولاَ يَرْتَاعُ مِنْ دَاءِ",17,"ا",2,0],["صَحا القَلبُ مِن ذِكرى قُتَيلَةَ بَعدَما","يَكونُ لَها مِثلَ الأَسيرِ المُكَبَّلِ",18,"ل",1,1],["صَحِبتُكَ حِقبَةً فَصَحِبتُ حُرّاً","أَبِيّاً لا يُهانُ وَلا يُهينُ",19,"ن",1,0],["صَحِبَتني قَبلَ اِصطِحابِكَ دَهراً","بِدلَةٌ في تَلَوُّنِ الحِرباءِ",20,"ا",2,0],["صَحِبتُهُ دَهراً فَأَلفَيتُهُ","فَتىً كَريمَ الأَصلِ وَالمَنزِعِ",21,"ع",1,0],["صَحِبتُ الهُدى عِشرينَ يَوماً وَلَيلَةً","فَقَرَّ يَقيني بَعدَما كانَ يَرجُفُ",22,"ف",1,0],["صَحا قَلبُهُ يا عَزَّ أَو كادَ يَذهَلُ","وَأَضحى يُريدُ الصَرمَ أَو يَتَبَدَّلُ",23,"ل",1,1],["صحح فقولي أفكه الأسمار لا","تغلط فتقرأ أفكه الأثمار",24,"ر",1,0],["صَحَّتْ عَقِيدَتُهُمْ فَلَيْسَ تَهِي","فِي حَادِثٍ جَلَلٍ وَلا تَهِنُ",25,"ن",1,0],["صَحَائِفُ المَجْدُ خَطُّوهَا وَزَيَّنَها","عَبْدُ العَزِيزِ بِتَاجٍ فَوْقَ عُنْوَانِ",26,"ن",1,0],["صَحِبَ الحَيَاةَ وَمَا لَهُ مِنْ حَاسِدٍ","يَوْماً عَلَى النُّعْمَى وَمَا مِنْ شَانِي",27,"ن",2,0],["صُحُفٌ بِلا عَدٍّ لَهَا آثَارُهَا","مَا كَرَّتِ الأَحْقَابُ فِي الأَزْمَانِ",28,"ن",1,0],["صُحُفِيٌّ بِمِثْلِهِ","إِنْ كَبَتْ تَنْهَضُ الأُمَمْ",29,"م",1,0],["صَحا القَلبُ عَن سَلمى وَقَد بَرَّحَت بِهِ","وَما كانَ يَلقى مِن تُماضِرَ أَبرَحُ",30,"ح",1,0],["صَحا القَلبُ مِن سَلمى وَعَن أُمِّ عامِرِ","وَكُنتُ أُراني عَنهُما غَيرَ صابِرِ",31,"ر",1,1],["صِحتُ وَصاحَ القَومُ بِالتَكبيرِ","وَغَيرُنا يُضمِرُ في الصُدورِ",32,"ر",1,0],["صِحتُ أَهَذا البازُ أَم دَجاجَه","لَيتَ جَناحَيهِ عَلى دُرّاجَه",32,"ه",1,0],["صِحتُ بِهِ اِركَب فَاِستَقَلَّ عَن يَدي","مُبادِراً أَسرَعَ مِن قَولِ قَدِ",32,"د",1,0],["صِحتُ إِلى الطَبّاخِ ماذا تَنتَظِر","إِنزِل عَنِ المَهرِ وَهاتِ ما حَضَر",32,"ر",1,0],["صحبتْ ركابَك حيث سرتَ مسرةٌ","موصولةٌ بسعادةٍ وهناء",33,"ا",2,1],["صحيفة حسنٍ قابلتها ملاحة","ألم ترهُ سطراً عليها مخرَّجا",34,"ج",2,0],["صحا القلب لولا نسمةٌ تتخطَّر","ولمعةُ برق بالغضا تتسعَّر",35,"ر",1,1],["صحَّت بصحّتك الدُّنيا فليس بها","غير الذي في جفونِ الغيد من مرض",36,"ض",1,0],["صحَّت إمامة أقلامٍ براحتِه","فأصبحت بخبير الخير تلتفع",37,"ع",1,0],["صحاب قصدنا عن لقاهم منافعاً","فلم نرَ شيئاً من وجوه المنافع",38,"ع",1,1],["صحّ الوداد لقلبي والأسى فلذا","أبكيكَ بالبحرِ لا أبكيكَ بالملق",39,"ق",1,0],["صحبتك لا ألوِي على صاحبٍ عطا","بجيدِ معمٍّ في العشيرة مخوَل",40,"ل",1,0],["صحبنا أناساً عاطفين فغيَّروا","ومالوا مع الأيام حيث تميل",41,"ل",1,1],["صحّت بك الأيام حتَّى ما يرى","متأمّل إلا النسيم عليلا",42,"ل",2,0],["صحةُ الدينِ والجوارح والعرْ","ضِ وإحرازُ مُسكة الحوباءِ",43,"ا",2,0],["صحيحٌ عُلْوهُ جَلْد","عليلٌ سُفْله مُضْنى",44,"ن",2,0],["صُحِّحُوا وال