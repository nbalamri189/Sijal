بي على زوجتي السائحة النائحة في إيطاليا والمتفضلين على الأدب","https://www.poetsgate.com/ViewPoem.aspx?id=203551",""],[5956,"إشعاع الإنسانية في الإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=204680",""],[5956,"هم لم يطيقوا أن يكونوا دولة واحدة","https://www.poetsgate.com/ViewPoem.aspx?id=205384",""],[5956,"جُزْتِ التصورَ عمّا كنتُ أحسبُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=207235",""],[5956,"يعفو لأنه مثلُنا متسامحُ","https://www.poetsgate.com/ViewPoem.aspx?id=213371",""],[5956,"صلواتٌ في ذكرى الخليل بن أحمد الفراهيدي","https://www.poetsgate.com/ViewPoem.aspx?id=215185",""],[5956,"أشكو لمن ليخففَ الأحزانا؟","https://www.poetsgate.com/ViewPoem.aspx?id=215830",""],[5956,"يرجون ميراث أبيهمِ العباس وهو حيٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=215975",""],[5970,"حبست نفسي على العلياء أطلبها","https://www.poetsgate.com/ViewPoem.aspx?id=130658",""],[6052,"دارنا","https://www.poetsgate.com/ViewPoem.aspx?id=34810",""],[6053,"تِلْكَ الرِّسَالَةُ ... !","https://www.poetsgate.com/ViewPoem.aspx?id=197035",""],[6093,"همٌّ يُبايتني وغمٌّ يسهدُ ( الكامل )","https://www.poetsgate.com/ViewPoem.aspx?id=176381",""],[6100,"اشتقت لك وإلا لك الحال مشتاق","https://www.poetsgate.com/ViewPoem.aspx?id=52593",""],[6101,"زمرة الشيطان / حسن الأفندي","https://www.poetsgate.com/ViewPoem.aspx?id=120281",""],[6102,"فوائد الحقد","https://www.poetsgate.com/ViewPoem.aspx?id=182744",""],[6102,"تحاميل","https://www.poetsgate.com/ViewPoem.aspx?id=183310",""],[6102,"من وحي فوز أبي لهب...","https://www.poetsgate.com/ViewPoem.aspx?id=183473",""],[6127,"يا نونُ ... يا قلمُ","https://www.poetsgate.com/ViewPoem.aspx?id=188718",""],[6127,"كنز اليتامى","https://www.poetsgate.com/ViewPoem.aspx?id=190114",""],[6127,"سلامٌ على جرحك","https://www.poetsgate.com/ViewPoem.aspx?id=199923",""],[6152,"وعد ممطول","https://www.poetsgate.com/ViewPoem.aspx?id=202351",""],[6152,"ميلاد قلب","https://www.poetsgate.com/ViewPoem.aspx?id=203021",""],[6153,"غني الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577054",""],[5309,"أولعت بالعدل لا الأحداث تلهيني","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573551",""],[6189,"خصوصية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83572&r=&rc=39",""],[6200,"غَابَةُ الأَطْفالِ وَ الحِجَارَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81373&r=&rc=15",""],[6202,"إن تمكري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86708&r=&rc=9",""],[2588,"شاخصة ( افتئات)","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65586&r=&rc=18",""],[2588,"لابسات الشنوف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65569&r=&rc=3",""],[6285,"هذه الشام لا تقولي كفانا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86807&r=&rc=0",""]],"verses":[["هُمُ يَومَ النَدى غَيمٌ جَهامٌ","وَفي اللَأواءِ ريحٌ جِربِياءُ",0,"ا",2,0],["همُ يَمنعونَ الجارَ والخَطْبُ فاغِرٌ","إذا رَمَزَتْ إحدى اللّيالي بِمُعْظَمِ",1,"م",1,0],["هم يفرشون لجيش الغزو أعينهم","ويدعون وثوباً قبل أن يثبوا",2,"ب",3,0],["هَمّي مِنَ الدُنيا خُلُوّي بِها","بِذاكَ أَدعو خالِقي في الصَلاة",3,"ه",1,0],["هُم يُنبِئونَكَ أَنَّ كُل","لَ الكائِناتِ إِلى بَوار",4,"ر",1,0],["هُم يَذكُرونَكَ إِن عَدّوا عُدولَهُمُ","وَنَحنُ نَذكُرُ إِن عَدّوا لَنا عُمَرا",5,"ر",2,0],["هُمُ يَملَأونَ لِليَتيمِ إِناءَهُ","وَهُم يُنجِزونَ لِلخَليلِ المُواعِدا",6,"د",2,0],["هَمٌّ يُسَاوِرُهُ لِنَهْضَةِ شَعْبِهِ","فِي كُلِّ مُرْتَحَلٍ وَكُلِّ مُقَامِ",7,"م",1,0],["هم يطلُبون قصوراً ينعمون بها","ونحن نطلب للأوطان عمرانا",8,"ن",2,0],["هم يُعَدُّون بالمئات ذكوراً","وإناثاً لهم قصور مُشاله",9,"ل",2,1],["هُمُ يَمنَعونَ السَرحَ لا يَمنَعونَهُ","مِنَ الجَيشِ أَن يَزدادَ نَفراً عَلى نَفرِ",10,"ر",1,0],["هَمّي بِهِ وَلَهٌ عَلَيكَ","يَا مَن إِشارَتُنا إِلَيك",11,"ك",1,1],["هم يبسطون لسان العيي","ي مجداً يُصَنِّعُ غير الصَنِع",12,"ع",1,0],["هُمُ يَومَ ذي قارٍ أَناخوا فَجالَدوا","غَداةَ أَتاهُم بِالفُيولِ الأَساوِرُ",13,"ر",1,0],["هُمْ يَسْخَرونَ بهَمْسِ","الزُّهُورِ وهْوَ بَديعُ",14,"ع",1,0],["هم يضنون في الحياة بما قا","ل ويُلفَون في الحياة أضنا",15,"ن",2,0],["هُم يَحسُدوني عَلَيهِ","وَيَغبِطوني بِسَعدي",16,"د",2,0],["هُم يَضُنّونَ في الحَياةِ بِما قا","لَ وَيُلفَونَ في المَماتِ أَضَنّا",17,"ن",2,0],["هُم يَطلُبونَ فَمَن أَدرَكوا","وَهُم يَكذِبونَ فَمَن يَقبَلُ",18,"ل",1,0],["هُمُ يُظلَمونَ وَلا يَظلِمونَ","إِذا العيسُ شُدَّت بِأَكوارِها",19,"ر",3,0],["هُمُ يَومَ ذي قارٍ أَناخوا فَصادَموا","بِرَأسٍ بِهِ تُرمى صَفاةُ المُصادِمِ",20,"م",1,0],["هُم يَضرِبونَ حَبيكَ البَيضِ إِذ لَحِقوا","لا يَنكُصونَ إِذا ما اِستُلحِموا وَحَموا",21,"م",3,0],["هَمى فَرَأَيتُ مِنهُ السُحَّ شُحّاً","سَحاباً ما عَهِدتُ بِهِ العِهادا",22,"د",2,0],["هُمُ يَضرِبونَ الكَبشَ يَبرُقُ بَيضُهُ","عَلى وَجهِهِ مِنَ الدِماءِ سَبائِبُ",23,"ب",1,0],["همّي كسِقطِ القَبسِ لكنْ طُعمُهُ","عُمْرٌ إذا أفْناهُ فيَّ فنيتُ",24,"ت",1,0],["هُم يَشرَعونَ لَها المَذاهِبَ تَهتَدي","لِلصالِحاتِ إِذا اِهتَدوا وَتَجورُ",25,"ر",1,0],["هُم يَزعُمونَ فروقَ لاحِقَةً بِهِم","وَيَرَونَها الحَقَّ الَّذي لا يَذهَبُ",26,"ب",1,0],["هُم يَخطِبونَ عَلى المَقاعِدِ ما دَروا","أَنَّ السُيوفَ عَلى الجَماجِمِ أَخطَبُ",26,"ب",1,0],["هُم يَعرِفونَ الحَقَّ فَاِنصَح غَيرَهُم","إِن كانَ هَذا النُصحُ مِمّا يَنفَعُ",27,"ع",1,0],["هم يَجبرون المَهيضَ الكسيرَ","إِذا فلَّلَ الدَهرُ مِن شَوكَتِه",28,"ت",2,0],["هَمّي إِذا ما حُروبُهُم غَلَبَت","أَيُّ الطَريقَينِ لي إِلى الهَرَبِ",29,"ب",1,0],["هُم يَجورونَ في المُزاحِ عَلَيهِ","وَهوَ يَحكي بِعَدلِهِ العُمَرَينِ",30,"ن",1,0],["هَمُّ يُوَكِّلُني بِحُبِّكِ وَالرَدى","عِلمي بِذَلِكَ أَنَّهُ مَقدورُ",31,"ر",1,0],["هُمُ يَرِدونَ المَوتَ عِندَ لِقائِهِ","إِذا كانَ وِردُ المَوتِ لا بُدَّ أَكرَما",32,"م",2,0],["همّي الهمّ لو تكشّف للنّاس","لأغرى حسنا وراع بريقا",33,"ق",2,0],["هُمْ يُعْجَبُونَ بلُطْفِ مَا","تُبْدِيهِ منْ غَنَجِ الفوَاجرْ",34,"ر",1,0],["هُمُ يَبْكُونَ وَالمَكِيُّ فِيهِمْ","غَرِيبٌ لاَ جَوَابَ وَلاَ خِطَابَا",35,"ب",2,0],["هُمُ يُطفِؤونَ المَجدَ وَاللَهُ موقِدٌ","وَكَم يَنقُصونَ الفَضلَ وَاللَهُ واهِبُ",36,"ب",1,0],["هَمّي غَدا هِمَّتي مِن ابني","سَلامَتي سُلَّمُ التَباهي",37,"ه",2,0],["هم يعلنون عن الشعوب كأنها","سلع، ونرضى بالسكوت خمولا",38,"ل",2,0],["هم يشربون دماء الناس إن ظمئوا","ويأكلون لُحُومَ الناس إن سغبوا",39,"ب",3,0],["همي ضميري فإن أرضيته فعلى","رأى العباد السلام المستخفينا",40,"ن",2,0],["هميمك في لقيماتٍ فَتُعطَى","لقيمات السويل والطفيل",41,"ل",1,0],["هِم يا فؤادُ فما عليك جُناحُ","كم في الصبابةِ والهيامِ نجاحُ",42,"ح",1,1],["هُمْ يَحْسُدُوني عَلَى مَوْتِي فَوا أَسَفِي","حَتَّى عَلَى المَوْتِ لا أَخْلوُ مِنَ الحَسَدِ",43,"د",1,0],["همي رضاه وهمكُم أموالهُ","كل إلى ما يشتهيه يفيضُ",44,"ض",1,0],["هَمّي عَتيٌّ لا يُهدُّ بِمُنْيةٍ","صمصامُ نَصْلٍ في الحَنايا يَفْتِكُ",45,"ك",1,0],["هُم يهودٌ هوازنٌ والأحابي","شُ قريشٌ وبئست الحلفاءُ",46,"ا",2,0],["هُم يَستَجيبونَ لِلداعي وَيكرِهُمُم","حَدَّ الخَميسِ وَيَستَهمونَ في البُهَمِ",47,"م",1,1],["هم يحسدونك يا زكيّ ولو رأوا","شكواك بلوا من شجاك غليلا",48,"ل",2,0],["هُم يَعشَقونَ بِشِعرِهِم","أَمّا أَنا فَبِأَدمُعي",49,"ي",1,0],["هُم يَقولونَ ما بِهِ وَهواه","حسبُما يَبتَغي وَطوعُ بنانه",50,"ن",2,0],["هُم يَشهَدونَ عَلى عُيوب سِواهُم","وَعُيوبهم في سُترَةٍ وَصِيانِ",51,"ن",1,0],["هَمِّي بِمَا جَاشَتْ بِهِ أَزَمَاتُهُ","طَيْرٌ أَحَصُّ جَنَاحِهِ مَقْصُوصُهُ",52,"ص",2,0],["هم يحسبون ولكن","لم يحسنوا بي صنعا",53,"ع",2,0],["هُم يَمَّموا البَيتَ العَتيقَ لِقَتلِنا","بِئسَ الفِعالُ وَنِعمَ بَيتاً يَمَّموا",54,"م",3,0],["هُم يُنشِدونَ لِبَلواهُم وَراحَتهِ","وا حَرَّ قَلباهُ مِمَّن قَلبُهُ شَبِمُ",55,"م",1,0],["هم يدّعون بأن عصرهم","لمن أزهى العصور",56,"ر",1,0],["همْ يمترونَ بأَنّا مثلهمْ فَأَبِنْ","لديهمُ أَننا جيلٌ من البشرِ",57,"ر",1,0],["همْ يعبدون عن الحقِّ","وَللباطل حزب",58,"ب",1,0],["هم يدَّعون بأنَّ العقلَ رائدُهم","وما دعوا لسوى غيٍّ وإفساد",59,"د",1,0],["هم يسألوا عنا ونسأل عنهم","ونرجو وصالاً والزمان شحيح",60,"ح",1,0],["هم يقولون جنّ بالفكر والشعر","ألا ما أسمى الجنون الصوابا",61,"ب",2,0],["هم يحسبوني مجنوناً به شده","ولست إلا طراز الشاعر العالي",62,"ل",2,0],["هُمُ يومَ زَمُّوا للفراقِ رِكابَهم","رَمونا بسَهْمٍ في القلوبِ فلم يُخْطوا",63,"ط",3,0],["هم يَنذُرونَ دمي وأن","ذُرُ إِن لقيتُ بأن أَشُدَّا",64,"د",2,0],["هَمّي بِهِم زائِدٌ زادَتهُ أَربَعَةٌ","يَنمي وَيَهمي وَيَستَشري وَيَزدادُ",65,"د",1,0],["هم ينجدون عقولنا","نحو الفضيلة والتقى",66,"ا",1,0],["هم يسرقون البساتين التي غُرست","بالحق والصدق والإيمان أشجارا",67,"ر",2,0],["هُمْ يحرسُونَ الدَّارَ من مُتسلِّلٍ","يرْمي بحربتِهِ صُدورَ نِيامِ",68,"م",1,0],["هم يصعدون إلى السماءِ وأنتَ في","أوحال وهمِك ما تزال وَضيعا",69,"ع",2,0],["هم يلجؤون إلى الإله وأنت لا","يرضيك إلاَّ أن تسوق قطيعا",69,"ع",2,0],["هم ينظرون بأَعيُنٍ مجلوَّةٍ","فيرون فعلك في العباد شنيعا",69,"ع",2,0],["هُمُ يَمزِجون الدَرَّ لِلطِّفلِ بِالعُلى","وَيَنشأ عَلَيها لَحمُها وَعِظامُها",70,"م",3,0],["هَمِّي منازلةُ الأقرانِ أحسَبُهُم","فَرائسِي فَهُمُ منِّي على وَجَلِ",71,"ل",1,0],["هُم يَعلمونَ أنّني أصلَبُ مِن","صُمِّ الصَّفَا فما عَدا مِمَّا بَدا",72,"د",2,0],["هُمُ يَروْن المالَ ذُخراً باقياً","وإنّما ذُخُر الفَتى أن يُحمَدَا",72,"د",2,0],["هُمُ يَمنَعونَ الجارَ حَتّى كَأَنَّما","لِجارِهِمُ بَينَ السِماكَينِ مَنزِلُ",73,"ل",1,0],["هُمُ يَعدِلونَ السَمكَ مِن قُبَّةِ الهُدى","كَما تَعدِلُ البَيتَ الحَرامَ القَواعِدُ",74,"د",1,0],["هُمُ يوم النوال بحارُ جود","وفي يوم النزال هم الأُسود",75,"د",1,0],["همى فهو جود للعفاة وإنّما","عنى قاصديه إذ همى لهم منمى",76,"م",2,0],["هُمُ يردون الخيل مُلْساً إلى الوغى","ويثنونها بالطَّعن تدْمى كلُومها",77,"م",3,0],["هَمى أرتقيَّ الجود تجلو بروقهُ","دُجى الحظِّ من أيامنا واللياليا",78,"ي",2,0],["هَمى ومُرًّ اِبائي غيرُ مُغتْصبٍ","مني وأقعس عزِّي غيرُ مُهتْضمِ",79,"م",1,0],["همى أبو الفرجِ الفيَّاض يُمطره","بوابلٍ من عطايا كفِّه رَذِمِ",80,"م",1,0],["هَمى عَضدُ الدين الوزيرُ فمَدَّتِ","الشِّعابُ أتِيّاً ذا غَواربَ مُفْعَما",81,"م",2,0],["هم يقتدون تحققاً بكماله","سيراً على أخلاقه المرضيَّة",82,"ه",1,0],["هَمِّي عَليهِ ضَياعي","وهَمُّ غَيري ضِياعُ",83,"ع",1,0],["هم يمين على العدى حين يسطو","وهو قطب به رحاهم تدور",84,"ر",1,0],["هم يسألون عنه حيث انفصلوا","بالنفس قاموا لا به ما اتصلوا",85,"ل",3,0],["هم يروني في شتات","مثل ما هم في شتات",86,"ت",1,0],["هم يَذكرُونَ من الكريمِ فضيلةً","وأنا أعُدُّ النَجْمَ حينَ أُعدِّدُ",87,"د",1,0],["هَمَى النَّجيعُ فأَبْقَى الجُرْدَ عَاطِ