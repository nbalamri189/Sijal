,"أأرجوا من الإلمام بالطلل البالي","https://www.aldiwan.net/poem48836.html","الطويل"],[399,"أخفض للخل من جناحي","https://www.aldiwan.net/poem46410.html","المنسرح"],[403,"عبسن من شعر في الرأس مبتسم","https://www.aldiwan.net/poem50128.html","البسيط"],[403,"حكم المنية في البرية جاري","https://www.aldiwan.net/poem50178.html","الكامل"],[403,"أتروم تغطية الهوى بجحوده","https://www.aldiwan.net/poem50187.html","الكامل"],[406,"لما رأوا وجدي بهم تجرموا","https://www.aldiwan.net/poem32531.html","الرجز"],[406,"باحت بسرك أدمع تكف","https://www.aldiwan.net/poem32563.html","أحذ الكامل"],[418,"ركبت بحرا من الدموع","https://www.aldiwan.net/poem46373.html","مخلع البسيط"],[436,"أخفضا نوت فينا النوى ولعلها","https://www.aldiwan.net/poem34863.html","الطويل"],[456,"وابن سررت به إذ قيل لي ذكر","https://www.aldiwan.net/poem56109.html","البسيط"],[456,"إما تقومون كذا أو فاقعدوا","https://www.aldiwan.net/poem56238.html","الرجز"],[462,"ما سرت عن جلق أبغي البديل بها","https://www.aldiwan.net/poem3222.html","عموديه"],[468,"لقد سلا كل صب أو قضى وطرا","https://www.aldiwan.net/poem4718.html","البسيط"],[475,"أغار إذا وصفتك من لساني","https://www.aldiwan.net/poem16190.html","الوافر"],[484,"قالت ولم تقصد لقول الخنا","https://www.aldiwan.net/poem479.html",""],[498,"كتبت غيبا على ما قام في الأزل","https://www.aldiwan.net/poem37814.html","البسيط"],[498,"عوجا إلى الوادي المقدس بالسرى","https://www.aldiwan.net/poem37817.html","الكامل"],[511,"أريتني النجم يجري بالنهار فلا","https://www.aldiwan.net/poem67796.html","البسيط"],[512,"ضربوا القباب وطنبوها بالقنا","https://www.aldiwan.net/poem20802.html","الكامل"],[513,"طمع المرء في الحياة غرور","https://www.aldiwan.net/poem12101.html","الخفيف"],[538,"إذا لم يكن عند امرىء لي معول","https://www.aldiwan.net/poem56717.html","الطويل"],[549,"إن كنت يا عمرو قد أسأت فقد","https://www.aldiwan.net/poem47227.html","المنسرح"],[549,"لا تسأل المرء ما تجني عشيرته","https://www.aldiwan.net/poem47764.html","البسيط"],[556,"يا صاحب الجهل المركب","https://www.aldiwan.net/poem34920.html","مجزوء الكامل"],[560,"أعطى محمد عزة من فضله","https://www.aldiwan.net/poem52936.html","الكامل"],[565,"كم من أخ لي كنت أجعل عنده","https://www.aldiwan.net/poem69685.html","الكامل"],[573,"شفاك الله من دائك","https://www.aldiwan.net/poem2699.html","الهزج"],[573,"تجنى لواحظه وتستعدي","https://www.aldiwan.net/poem2971.html","أحذ الكامل"],[584,"قلق يحن إلى الأجيرع قلبه","https://www.aldiwan.net/poem17977.html","الكامل"]],"verses":[["أُخَفِّضُ عَزمِيَ عَن رُتبَةٍ","أُبَلِّغُها بِالحُظوظِ السَوامي",0,"م",2,0],["أَخَفُّ إِلى يَومِ الوَغى مِن سِنانِهِ","وَأَمضى عَلى هامِ العِدى مِن قَضيبِهِ",1,"ب",2,0],["أُخفي الهَوى وَهوَ لا يَخَفى عَلى أَحَدٍ","إِنّي لَمُستَتِرٌ في غَيرِ مُستَتَرِ",2,"ر",1,0],["أَخْفَيْتُ مِنْ حُزْنِي عَلَيْكَ وَفِي الْحَشَا","نَارٌ لَهَا بَيْنَ الضُّلُوعِ ضِرَامُ",3,"م",1,0],["أَخفَيتَ ما أَضمَرتَهُ","وَأَبَنتَ وُدَّ الصاحِبِ",4,"ب",1,0],["أَخفَيتَ أَسرارَ الفُؤادِ وَإِنَّما","سِرُّ الفُؤادِ مِنَ النَواظِرِ يُسرَقُ",5,"ق",1,0],["أَخفَيتُهُ عَنكَ وَلكِنَّهُ","يَبدو بِما غَرَّكَ مِن جَفني",6,"ي",1,0],["أُخفي اِسمَ مَن أُحِبُّهُ مَخافَةً","وَذِكرُهُ في القَلبِ شَوقٌ وَأَرَق",7,"ق",1,1],["أُخَفِّضُهُ بِالنَقرِ لَمّا عَلَوتُهُ","وَيَرفَعُ طَرفاً غَيرَ جافٍ غَضيضِ",8,"ض",1,0],["أخفى عليكم دعة فخره","ولم يشأ أن تعلموا قدره",9,"ه",1,0],["أَخَفُّ عَلى المَرءِ مِن حاجَةٍ","يُكَلِّفُ غَسّانَها مُرتَقِب",10,"ب",1,0],["أخفي بكميَّ الدموع تلوّنت","فكأنها الأزهار في الأكمام",11,"م",1,0],["أُخفي الأسى ولسان دمعي يعلنُ","وأرى الدّمى ترنو إليَّ فأُفتن",12,"ن",1,1],["أخِفتَ المجاعة ياهاشمي","ي متَّهِماً لأمان الألاف",13,"ف",1,0],["أخفى من الطيف إلا أن بهجته","حسناً جلت بسنا أنواره الأفقا",14,"ق",2,0],["أخفتَ عواقب السوءى فخَفْها","فكلُّ إساءةٍ مَجْنى وَبال",15,"ل",1,0],["أخفقتْ رَوْحَتي من الربرب العِي","ن وطاشتْ من الرمايا سِهامي",16,"م",2,0],["إخْفارُهُ ذِمَّةَ الأمير ولم","يمرِ وريديه صارمٌ خَذِم",17,"م",1,0],["أَخِفُّ عَلى لُقيا الحَبيبِ وَإِنَّني","لَعَمرُكَ في كُلِّ الأُمورِ وَقورُ",18,"ر",1,0],["أَخِفتِ اللَهَ في إِحياءِ نَفسٍ","مَتى عُصِيَ الإِلَهُ بِأَن أُطيعا",19,"ع",2,0],["أَخِفْتِ أنْ تلجِي غُدْرانَ أدمُعِنا","فما جشمتِ وُلوجاً بين غُدرانِ",20,"ن",1,0],["أُخفي هَوىً لَكِ في الضُلوعِ وَأُظهِرُ","وَأُلامُ في كَمَدٍ عَلَيكِ وَأُعذَرُ",21,"ر",1,1],["أَخَفُّ عَلى الشَيخِ العِبادي مَؤونَةً","وَأَهوَنُ مِن حَربي إِذا صَرَّ نابُها",22,"ب",3,0],["أَخفاه بين ضلوعِه فجَفَت به","حُرَقٌ تُظاهِرُه على إظهارِه",23,"ر",2,0],["إِخفِض جَناحاً لِمَن تُعاشِرُهُ","وَلِن إِذا ما قَسَت خَلائِقُه",24,"ه",1,1],["أَخَفُّ إِلى الحَربِ مِن ذابِلٍ","وَأَثقَلُ في الحِلمِ مِن يَذبُلِ",25,"ل",1,0],["أَخفَيتَ بِرَّكَ لي فَأَعلَنَ مَنطِقي","لا يَشكُرُ النَعماءَ مَن لَم يُعلِنِ",26,"ن",1,0],["أَخفى المُلوكَ تَجَلّيهِ لِأَنَّهُمُ","شُهبٌ إِذا بَزَغَت شَمسُ الضُحى نَزَحَت",27,"ت",1,0],["أَخفَيتَ وَجهَ الأَرضِ مِن جُثَثِ العِدى","حَتّى جَعَلتَ لَكَ الوُحوشَ وُفودا",28,"د",2,0],["أخفي المخاوفَ عنه وَهيَ جليلةٌ","مرسومةٌ في ناظري الفضَّاحِ",29,"ح",1,0],["اخف جراحك واستعز بفتكها","غريدك الشادي المحلق في الذرى",30,"ر",2,0],["أَخفَيتَهُ فَخَفَيتُهُ وَطَوَيتَهُ","فَنَشَرتُهُ وَالشَخصُ مِنهُ عَميمُ",31,"م",1,0],["أَخَفَّ عَلى قَلبٍ وَأَثقَلَ قيمَةً","وَأَقصَرَ في سَمعِ الجَليسِ وَأَطوَلا",32,"ل",2,0],["أَخفَقَ فَاِستَقدَمَ في هِمَّةٍ","وَغادَرَ الرَتعَةَ لِلراتِعِ",33,"ع",1,0],["أَخْفَيْتُ عَنْهُ سَرِيرَتِي فَوَشَى بِهَا","دَمْعٌ أَبَاحَ لَهُ حِمَى كِتْمَانِي",34,"ي",1,0],["اخفُق عَلى الجُندِ الَّذي بِسِلاحِهِ","يُحمى الذِمارُ وَيُدفَعُ المُتَوَثِّبُ",35,"ب",1,0],["أَخَفُّ أَذىً وَأَقرَبُ مِن رَشادٍ","وَأَبعَدُ عَن مُماحَكَةٍ وَنُكرِ",36,"ر",1,0],["أخفى محاسنَها الكبرى فكيف بكم","إذا تَكَشَّفُ عن وجهٍ لها عارِ",37,"ر",1,0],["اخفقي يا عمامتي واعلُ يا رم","حي فقد خفت أن تعود كسيرا",38,"ر",2,0],["أخفينها تحت الجنا","ح ونمن ملءَ جفونهنّه",39,"ن",2,0],["أَخفَوا نَدامَتَهُم وَعَجَّلَ حينَهُم","ضَربٌ وَطَعنٌ لَيسَ عَنهُ مَحيدُ",40,"د",1,0],["أَخَفُّ مِن لا شَيءَ في سَجدَتِهِ","كَأَنَّهُ يُلسَعُ في جَبهَتِه",41,"ت",2,1],["أَخفي لَهُ الرَحمَنُ يَعلَمُهُ","حُبّاً يُؤَرِّقُني غَوارِبُهُ",42,"ب",2,0],["أَخَفتَ عَلى المَآثِمِ ضَعفَ أَيدٍ","وَرُمتَ بِشُربِ ذَلِكَ شَدَّ أَزرِ",43,"ر",1,0],["أَخَفُّ عَلَيكَ مِن سُقمٍ طَويلٍ","وَمَوتٍ بَعدَ ذاكَ عَلى الفِراشِ",44,"ش",1,0],["أَخَفَّت حُلومُ الناسِ أَم كانَ مَن مَضى","مِنَ القَومِ جُهّالاً خِفافَ حُلومِ",45,"م",1,1],["أخفَّ من الوَجِيهِ يداً ورِجْلاً","وأكْرَمَ في الجِيادِ أباً وخالا",46,"ل",2,0],["أخفَيتُ حُبّكُمُ فأخفاني أسىً","حتى لعَمري كِدْتُ عني أختفي",47,"ي",1,0],["أخِفّ لذِكْراهُ وأحْفَظُ غَيْبَهُ","وأنْهَضُ فِعْلَ الناسِك المُتَخَشِّع",48,"ع",1,0],["أَخَفُّ عَلَى الأَسْمَاعِ مِنْ نَغَمِ الْحُدَا","وَأَلْطَفُ عِنْدَ الْنَّفْسِ مِنْ زَمَنِ الْوَرْدِ",49,"د",1,0],["أَخْفَقْتَ فِي الأُوْلَى فَلَمْ تَكُ قَانِطاً","وَالنُّجْحُ تَدْرِي لاِمْرِئٍ نَظَّارِ",50,"ر",1,0],["أخِفُّ إلى المرآة كلَّ صبيحةٍ","أرى هل أشابَ الهمُّ بالأمس مفرِقي",51,"ق",2,0],["أخٌ في للمَكْرُمَاتِ يُعَدُّ فيها،","لَهُ فَضلُ الشّقِيقِ على الحَمِيلِ",52,"ل",1,0],["أخفى هواك فنمته مدامعه","والعين تعرب عما ضمت الكبد",53,"د",1,0],["أخفُّ مناطاً في الرقاب وأوْكَدُ","على ما مضى ؟أم حسرة ٌ تتجدد؟",54,"د",1,1],["اخفى جراحك واستعز بفتكها","غريدك الشادي المحلق في الذرى",55,"ر",2,0],["اخفيت سرك والهوى","في باطني ما زال ظاهر",56,"ر",1,0],["أخفت أن تأخذ العينان منقصةً","في حسنك الغض والإنسان إنسان",57,"ن",1,0],["أَخَفتَ الزَمانَ وَهوَ راضٍ مُسَلِّمٌ","وَأَمَّنَهُ قَومٌ مَضَوا وَهوَ مُغضَبُ",58,"ب",1,0],["أَخَفُّ مِنَ البُردِ المُحَبَّرِ مَلبَساً","وَأَسرَعُ في قَطعِ البِلادِ مِنَ البُردِ",59,"د",1,0],["أَخفَوا ضِباباً كُداها في صُدورِهِمُ","وَهُم ضِبابٌ لَها فَرطُ الخُضوعِ كُدا",60,"د",2,0],["أَخفَقَ المُترَفُ الجَنوحُ إِلى الخَف","ضِ وَفازَ المُخاطِرُ المِقدامُ",61,"م",1,0],["أَخفَوا هِباتِهِمُ وَخَفّوا لِلنَدى","وَالمُستَغيثِ وَيَثقُلونَ حُلوما",62,"م",2,0],["أَخَفتَ الآمِنينَ سُطىً فَلَمّا","عَفَوتَ غَدَوتَ أَمنَ الخائِفينا",63,"ن",2,0],["أَخْفَتْ عَنِ القَوْمِ مَا أَبْدَتْ عَزِيمَتُهُمْ","وَأَظْهَرَتْ لِلنَّوى وَالْبَيْنِ مَا كُتِما",64,"م",2,1],["أَخفيتُ سلوةَ حُرٍّ في تذلُّلِه","وإِنَّما قيلَ قلبٌ من تقلُّبِهِ",65,"ب",2,0],["أَخفافُهُنَّ مِن حَفاً وَمِن وَجى","مَرثومَةٌ تَخضبُ مُبيَضَّ الحَصى",66,"ا",1,0],["أُخفي وَأُعلِنُ بِاِضطِرارٍ أنَّني","لا أَستَطيعُ لِما أُجِنُّ خَفاءَ",67,"ا",2,0],["أخْفيْتُ في الوجْدان لُجَّتَهُ","لكِنّهُ يقظٌ وما هَجَعا",68,"ع",2,0],["أخَفُّ إلى الهيْجاءِ من وَفْدِ عاصفٍ","وأَثَبتُ حِلْما من هِضاب شَمام",69,"م",1,0],["أخفّ عليّ من تلف وعار","فرمت العيش عن سبب ضعيف",70,"ف",1,0],["أخفها بباريها ويوم معادها","لتقلع عن عاداتها وهناتها",71,"ت",3,0],["أخفُّ عندي ممن ضنيتُ به","روحاً وأخفى من الضَّنا شبحا",72,"ح",2,0],["أخفيتُ حبَّك حتى كدتُ من حَذَري","عليه أُخفيه عن سمعي وعن بصري",73,"ر",2,1],["أُخفي جميلاً كما أُبدي ويسترني","من البليّات علّامُ الخفيّاتِ",74,"ت",1,0],["أخفى جواي بحبها","أصبحت أو من بالنفاق",75,"ق",1,0],["أَخفَى مِن السِّرِّ لكْن حُسنُ صورتِه","إذا تأمّلتَه أَبْدَى مِن العَلَنِ",76,"ن",1,0],["أخَفّف تسليمي وأُصفِي مودَّتي","وأطوى على نصحي لك القلب والصدرا",77,"ر",2,1],["أخفيت إشاراتي عن العذال","بالرند وبانة الحمى والضال",78,"ل",1,1],["أخفيك من عّذلي صوناً ومكرمة","بل المدامع والأنفاس تبديكي",79,"ك",2,0],["أُخفي بِهِ حُزني وَيَأ","بى حُسنُهُ إِلّا اِفتِضاحي",80,"ي",1,0],["أَخَفُّ عَلَى الْفَتَى مِنْ عًرْفِ فَدْمٍ","يَمُنُّ عَلَى الوَضُوخِ مِنَ النُّقَاخِ",81,"خ",1,0],["أخفيت ما بي اليوم منها فما","تطلع الناس على ما بي",82,"ي",1,0],["أخف منه الحمام بطشاً","فأنه قاتل يربح",83,"ح",1,0],["أخفيت إلا عليك عسري","والحر بالسر لا يبوح",83,"ح",1,0],["أَخفى محبتهم عنهم وأجحدها","وأصعب المذهب العذرى أَخفاه",84,"ا",2,0],["أُخْفِي سُؤالي لَو شُفِيتُ إِجابَةً","مَا لِي وَما لِلْبَيْنِ بي يتَوقَّعُ",85,"ع",1,0],["أَخفى عَن الواشين موقعَنا فَلَم","يَدرِ الرَقيبُ بنا هنالكَ لا دَرى",86,"ر",2,0],["أَخفى بمنشورِ الذوا","ئب من محاسنه وأَبدى",87,"د",2,0],["أخفيك ما أخفيك بل أخفيك ما","أخفيك جزنا بعد ذا الحماما",88,"م",2,0],["أَخفيت سرّك عَن وشاتي في الحَشا","فَوَشى بِهِ دَمعي وَقَد بَرح الخَفا",89,"ف",2,0],["أَخِفُّ إليها كُلَّ يومٍ وليلةٍ","وأَسألُ عنها والحَفيُّ سَؤول",90,"ل",1,0],["أخْفَى إذا فارقتُ وجْهَكِ من ضنىً","فأدِقُّ عن دَرْكِ العيونِ وأَصغُر",91,"ر",1,0],["أخفَيتَ عَزمكَ للفِراقِ فَما خَفي","حذراً عَلى قَلبِ المُعنَّى المُدنِفِ",92,"ف",1,1],["أَخفتُ بمنظري كُ