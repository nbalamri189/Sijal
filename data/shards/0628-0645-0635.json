3er&doWhat=shqas&qid=22745&r=&rc=6",""]],"verses":[["بِمِصْرَ الجَدِيدَةِ قَدْ أُنْشِئَتْ","وَتَشْمَلُ جِيرَانَهَا المُعْوَزينْ",0,"ن",1,0],["بمصابيح شعرك ازدانت الارض","كما ازدانت بالنجوم السماء",1,"ا",2,0],["بِمِصرَ مُلوكٌ لَهُم مالَهُ","وَلَكِنَّهُم ما لَهُم هَمُّهُ",2,"م",2,0],["بِمُصيبَةٍ لا تُستَقالُ جَليلَةٍ","غَلَبَت عَزاءَ القَومِ وَالنِسوانِ",3,"ن",1,0],["بِمِصرَ وَأَيُّ مَأرُبَةٍ بِمِصرٍ","وَقَد شَعَبَت أَكابِرَها شَعوبُ",4,"ب",1,0],["بِمُصَعَّدٍ مِن حُسنِهِ وَمُصَوَّبٍ","وَمُجَمَّعٍ في خَلقِهِ وَمُفَرَّقِ",5,"ق",1,0],["بمصرٍ صبابات إليك وطالما","صرمتَ ولهفي من حبيبٍ يصارم",6,"م",1,0],["بِمَصونَةٍ قَد صانَ بَهجَةَ كَأسِها","كِنُّ الخُدورِ وَخاتَمُ الدَنّانِ",7,"ن",1,0],["بِمُصطَحِباتٍ مِن لَصافٍ وَثَبرَةٍ","يَزُرنَ إِلالاً سَيرُهُنَّ التَدافُعُ",8,"ع",1,0],["بمَصَاعِبِ الأَسْفَارِ فِي نَقْلٍ","وَمَتَاعِبِ الأَسْفَارِ وَالْكُتُبِ",9,"ب",1,0],["بمصلاه ومدرسه الذي","هدى من التوحيد يانع زهره",10,"ر",2,0],["بمصرَ ومصرٌ ما تزال طريدةً","شرى الظلمُ منها ما أراد وباعا",11,"ع",2,0],["بمصلاه ومدرسه الذي","أهدى من التوحيد يانع زهره",12,"ر",2,0],["بمصيبة ٍ لا تستقالُ جليلة ٍ","غَلَبَتْ عَزَاءَ الْقَوْمِ وللشُّبان",13,"ن",1,0],["بِمُصَدِّقِ الأَمَلِ الَّذي أَنضَيتُهُ","أَرجو البَخيلَ وَأَحمَدُ المَذموما",14,"م",2,0],["بمصباح العدالة والمرجّى","لما يجنى به ثمَرُ الجناني",15,"ن",2,0],["بمصر دفنت يا روحاً عزيزاً","فريداً لا يقام له مثال",16,"ل",1,0],["بمصالح وفوائد وعوائد","والكل إن حققتهن مفاسد",17,"د",1,0],["بمصطكي القهوة في","فنجانها المذهب",18,"ب",1,1],["بِمَصائِبٍ مِنْ فادِعٍ وأَشائِبٍ","مَمَّنْ تَجَمَّعَ مِنْ بَني دَهْمانِ",19,"ن",1,0],["بمصمِّمٍ للخير غير مُنكِّبٍ","ومُنكِّبٍ في الشرِّ غير مُصمِّمِ",20,"م",1,0],["بمصرٍ كما بي من جَوىً وصبابة","كلانا مُعَنًّى بالأَحبَّة مُغْرَمُ",21,"م",1,0],["بمصقولٍ قضيفِ حدّ","ه في غايةِ القَضَف",22,"ف",1,0],["بمصر داري فلا والله مذ رفعت","عني التمائم ما أوليتها مللا",23,"ل",2,1],["بمصاب عز اصطباري عليه","جرحه لم يزل بقلبي جديدا",24,"د",2,0],["بمصابه عزِ الورى","إذ لا ترى إلا مصابا",25,"ب",2,0],["بِمَصاليتِ الوَغى ثُبُتٍ","وَعَناجيحٍ لَها نَحَمَة",26,"م",2,0],["بِمَصرَعِ أَحمَدٍ عزَّ الأَعادي","وَذلَّ الرُمحُ وَالسَيفُ الحُسامُ",27,"م",1,0],["بمصابيحيَ استضيء فمن شمسي","يبدو فيكِ الصباحُ سَفورا",28,"ر",2,0],["بمصْعَبةٍ ذاتِ احتباكٍ جُلالةٍ","تزيدُ مراحاً إذ تلين العرائك",29,"ك",1,0],["بمصيبة أوردت بلب حشاشتي","شعل يطيش دخانها بدماغي",30,"غ",2,0],["بمصلتة بيض الصفاح كأنهاغ","بوارق في جنح الدجى تتخطف",31,"ف",1,0],["بمَصَرَّعٍ ومُرَصَّع ومُوَشَّحٍ","ومُسَجَّعٍ ومُفَرَّع وموجَّه",32,"ه",1,0],["بمصر وغيرها من كل مصر","وفيما طفت من يمن وشام",33,"م",1,0],["بمصباح ناديها بنار منارها","بديمة واديها بخصب سنينها",34,"ن",3,0],["بمصر كل غبي ساكن فلكا","والعبقرى بها سكناه من حطب",35,"ب",1,0],["بمصاب مولانا سلالة مدلج","ذي الفضل والحسب الرفيع الفاخر",36,"ر",1,0],["بمصر حل يهودي","قضى عليه الإله",37,"ا",3,1],["بمصر اِنقَضى عَصرُ الشَباب فديتُه","وَفي أَرض طويران لي المنةُ الكبرى",38,"ر",2,0],["بمصائر الأحوال قبل وقوعها","ثق من فراسته بأصدق مخبر",39,"ر",1,0],["بمصطفى ومجتبى ومنتقى","رقِّ مقامي لأعلى مرتقى",40,"ق",2,0],["بمصرنا وليّ العتل","ذاك الذي بالشقا تمسك",41,"ك",1,1],["بمصباح صبح أصبح الكون منه في","أجل جمال في جلال مجمل",42,"ل",1,0],["بمصابيح ما سواها بجوم","لشياطين لوعة الأحزان",43,"ن",1,0],["بمصر الشمس برجٌ قَد تَعالى","على برج الغزالة في العلاءِ",44,"ا",2,1],["بمصاب الحسين ضاق الفضاءُ","وتوالت برزئه الأرزاءُ",45,"ا",2,1],["بمصرَ نأت كيما تعانقَ رفعة","لتنهلَ من نهرِ العلومِ وتكسبا",46,"ب",2,0],["بمصر الحب نادمني نديم","سبى الألباب مذ كشف الخمارا",47,"ر",2,0],["بمصاليتِ الوغى ثبتٍ","وَعَنَاجِيجٍ لَها نَحَمَة ْ",48,"م",2,0],["بمصابي بصاحبي وصديقي","وأخي ذلك النسيب الصريح",49,"ح",1,0],["بمصابيحها تضيء المشايا","فكأن الصباح عين مسائك",50,"ك",1,0],["بمصابيحي استضيء ربا معال","شرفا بيت ربك المعمورا",51,"ا",1,0]]}