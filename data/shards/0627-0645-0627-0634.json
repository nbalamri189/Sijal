{"poems":[[53,"تواعد ذا الخليط لأن يبينا","https://www.aldiwan.net/poem29647.html","الوافر"],[53,"ألا لله بادرة الطلاب","https://www.aldiwan.net/poem30747.html","الوافر"],[55,"أروني وجه نسرين","https://www.aldiwan.net/poem26047.html","الهزج"],[93,"تمضي وأنت مضنة الأوطان","https://www.aldiwan.net/poem11245.html","الكامل"],[93,"أيزيدك التبجيل والتكريم","https://www.aldiwan.net/poem11415.html","الكامل"],[47,"أيا قلبي أما تخشع","https://www.aldiwan.net/poem25231.html","الهزج"],[80,"أيا خلج المدامع لا تغيضي","https://www.aldiwan.net/poem31397.html","الوافر"],[80,"تفشي يداك سرائر الأغماد","https://www.aldiwan.net/poem31483.html","الكامل"],[50,"وهبت لنا يا فتى منقر","https://www.aldiwan.net/poem62288.html","المتقارب"],[50,"خشاب هل لمحب عندكم فرج","https://www.aldiwan.net/poem63988.html","البسيط"],[46,"أيا شجر العرا أوسعت ريا","https://www.aldiwan.net/poem22995.html","الوافر"],[46,"وجدت الموت للحيوان داء","https://www.aldiwan.net/poem23353.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85466","المتقارب"],[141,"لا تخش عدوى من أبحت ذماره","https://www.aldiwan.net/poem11831.html","الطويل"],[235,"أدام الله مولانا العليا","https://www.aldiwan.net/poem19746.html","الوافر"],[303,"تبكي عيون النجم ملء غروبها","https://www.aldiwan.net/poem56607.html","الكامل"],[390,"بدت عذارى مدت سرادقها","https://www.aldiwan.net/poem53489.html","المنسرح"],[436,"هل تثنين غروب دمع ساكب","https://www.aldiwan.net/poem34884.html","الكامل"],[582,"الأحول الأثعل المشؤوم طائره","https://www.aldiwan.net/poem69372.html","البسيط"]],"verses":[["أَما شَهِدوا لَيالي السوسِ مِنها","وَمَسحَبَها القَنِيَّ بِدارِ زينا",0,"ن",2,0],["أَما شَرِقَ التُرابُ بِساكِنيهِ","فَيَلفَظَهُم إِلى النِعَمِ الرُغابِ",1,"ب",1,0],["أَما شَيءٌ مِنَ الأَشيا","ءِ مِن وَصلِكِ يُدنيني",2,"ي",1,0],["أمَّا شَمَائلُهُ فَفي نَفَحَاتِها","عَبَقُ القَرَابَةِ مِنْ أُولِي التِّيجَانِ",3,"ن",1,0],["أَمَّا شَمَائِلُهُ فَقُلْ فِي نَفْحَةٍ","لِلرَّوْضِ مَرَّ بِهِ الغَدَاةَ نَسِيمُ",4,"م",1,0],["أَما شَيَّعتُ أَمثالي","إِلى ضيقٍ مِنَ المَضجَع",5,"ع",1,0],["أَما شَرَحَتْ له عِبَرُ اللَّيالي","معانِيَ بَعْدَ مُلْتَبِسِ الغموضِ",6,"ض",1,0],["أمّا شِدَادُ المجرمين فعزُّهُ","أبقاهُمُ بالذلّ غيرَ شدادِ",7,"د",1,0],["أَمَ اَشوي وَأَطبُخُ مِن لَحمِها","وَأَطيبُ مِن ذاكَ مَضغُ السَلا",8,"ل",2,0],["أَما شَعَرتِ فَدَتكِ النَفسُ جارِيَةً","أَن لَيسَ لي دونَ ما مَنَّيتِني فَرَجُ",9,"ج",1,0],["أَما شُغِلَ الأَنامُ عَنِ التَقافي","بِما وَعَدَ الزَمانُ مِنَ التَقَفّي",10,"ي",1,0],["أَما شاهَدتَ كُلَّ أَبي وَليدٍ","يَؤُمُ طَريقَ حَتفٍ مُستَقيما",11,"م",2,0],["أَما شيبي وَقَد اِستَولى","فَبَياض ما إِن أَحمده",12,"د",2,0],["أَمّا شَبيهُكَ في الأَنامِ فَإِنَّهُ","ما كانَ قَطُّ وَلا يَجوزُ كِيانُهُ",13,"ن",2,0],["أَمَا شَاقَتْكَ فَاسُفَقَبْلُ شَاقَتْ","لَيَالِي السَّفْحِ مَوْلاَنَا الرَّضِيَّا",14,"ي",2,0],["أمّا شمائِلهُ الكرام فإنّها","قد جُمّعت لِقرينها وَضريبها",15,"ب",3,0],["أَم أَشرَقَت فِقرَةٌ بَدائِعُها","حَديقَةٌ زانَها طَرائِقُها",16,"ق",3,0],["إِمَّا شجيتِ برحلتي فاستبشِري","بجميل ظنّي من جميلِ عواقبي",17,"ب",2,0],["أما شمرت أباً رباك من صغرٍ","حتى شببت شباباً غير محجون",18,"ن",1,0]]}