{"poems":[[55,"تواعد ذا الخليط لأن يبينا","https://www.aldiwan.net/poem29647.html","الوافر"],[55,"ألا لله بادرة الطلاب","https://www.aldiwan.net/poem30747.html","الوافر"],[57,"أروني وجه نسرين","https://www.aldiwan.net/poem26047.html","الهزج"],[95,"تمضي وأنت مضنة الأوطان","https://www.aldiwan.net/poem11245.html","الكامل"],[95,"أيزيدك التبجيل والتكريم","https://www.aldiwan.net/poem11415.html","الكامل"],[49,"أيا قلبي أما تخشع","https://www.aldiwan.net/poem25231.html","الهزج"],[82,"أيا خلج المدامع لا تغيضي","https://www.aldiwan.net/poem31397.html","الوافر"],[82,"تفشي يداك سرائر الأغماد","https://www.aldiwan.net/poem31483.html","الكامل"],[52,"وهبت لنا يا فتى منقر","https://www.aldiwan.net/poem62288.html","المتقارب"],[52,"خشاب هل لمحب عندكم فرج","https://www.aldiwan.net/poem63988.html","البسيط"],[48,"أيا شجر العرا أوسعت ريا","https://www.aldiwan.net/poem22995.html","الوافر"],[48,"وجدت الموت للحيوان داء","https://www.aldiwan.net/poem23353.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85466","المتقارب"],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[147,"لا تخش عدوى من أبحت ذماره","https://www.aldiwan.net/poem11831.html","الطويل"],[242,"أدام الله مولانا العليا","https://www.aldiwan.net/poem19746.html","الوافر"],[310,"تبكي عيون النجم ملء غروبها","https://www.aldiwan.net/poem56607.html","الكامل"],[398,"بدت عذارى مدت سرادقها","https://www.aldiwan.net/poem53489.html","المنسرح"],[445,"هل تثنين غروب دمع ساكب","https://www.aldiwan.net/poem34884.html","الكامل"],[589,"الأحول الأثعل المشؤوم طائره","https://www.aldiwan.net/poem69372.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138258",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138380",""],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59658","الطويل"],[1421,"","https://poetry.dctabudhabi.ae/diwan/poem/117100","البسيط"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46437","الطويل"],[2100,"","https://poetry.dctabudhabi.ae/diwan/poem/34928","البسيط"],[2167,"","https://poetry.dctabudhabi.ae/diwan/poem/177828","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53098","الكامل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120734","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87317","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87318","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[3243,"","https://poetry.dctabudhabi.ae/diwan/poem/140232",""],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86293","الطويل"],[3707,"","https://poetry.dctabudhabi.ae/diwan/poem/124643","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123507","الطويل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123492","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90975","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95067","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28769","البسيط"],[4571,"","https://poetry.dctabudhabi.ae/diwan/poem/99123","البسيط"],[4767,"كوكب عمان","https://www.poetsgate.com/ViewPoem.aspx?id=204152",""],[4955,"تخاطبني الدموع بلا كلام","https://www.poetsgate.com/ViewPoem.aspx?id=197905",""],[4978,"رد على قصيدة أعظم بخشان","https://www.poetsgate.com/ViewPoem.aspx?id=178645",""],[5050,"هو المجد فاطلبه وإن عز طالبه","https://www.poetsgate.com/ViewPoem.aspx?id=38193",""],[5183,"سَعد وسُعَيد","https://www.poetsgate.com/ViewPoem.aspx?id=180217",""],[5358,"أتى وحيدُكِ","https://www.poetsgate.com/ViewPoem.aspx?id=183426",""],[5458,"الفشل هو الموت","https://www.poetsgate.com/ViewPoem.aspx?id=72167",""],[5596,"سمائل المذهلة","https://www.poetsgate.com/ViewPoem.aspx?id=206486",""],[5688,"زدني من الحبر","https://www.poetsgate.com/ViewPoem.aspx?id=200692",""],[5736,"يقين","https://www.poetsgate.com/ViewPoem.aspx?id=203823",""],[5829,"نكبة 2012","https://www.poetsgate.com/ViewPoem.aspx?id=152668",""],[5975,"عودي","https://www.poetsgate.com/ViewPoem.aspx?id=53132",""]],"verses":[["أَما شَهِدوا لَيالي السوسِ مِنها","وَمَسحَبَها القَنِيَّ بِدارِ زينا",0,"ن",2,0],["أَما شَرِقَ التُرابُ بِساكِنيهِ","فَيَلفَظَهُم إِلى النِعَمِ الرُغابِ",1,"ب",1,0],["أَما شَيءٌ مِنَ الأَشيا","ءِ مِن وَصلِكِ يُدنيني",2,"ن",2,0],["أمَّا شَمَائلُهُ فَفي نَفَحَاتِها","عَبَقُ القَرَابَةِ مِنْ أُولِي التِّيجَانِ",3,"ن",1,0],["أَمَّا شَمَائِلُهُ فَقُلْ فِي نَفْحَةٍ","لِلرَّوْضِ مَرَّ بِهِ الغَدَاةَ نَسِيمُ",4,"م",1,0],["أَما شَيَّعتُ أَمثالي","إِلى ضيقٍ مِنَ المَضجَع",5,"ع",1,0],["أَما شَرَحَتْ له عِبَرُ اللَّيالي","معانِيَ بَعْدَ مُلْتَبِسِ الغموضِ",6,"ض",1,0],["أمّا شِدَادُ المجرمين فعزُّهُ","أبقاهُمُ بالذلّ غيرَ شدادِ",7,"د",1,0],["أَمَ اَشوي وَأَطبُخُ مِن لَحمِها","وَأَطيبُ مِن ذاكَ مَضغُ السَلا",8,"ل",2,0],["أَما شَعَرتِ فَدَتكِ النَفسُ جارِيَةً","أَن لَيسَ لي دونَ ما مَنَّيتِني فَرَجُ",9,"ج",1,0],["أَما شُغِلَ الأَنامُ عَنِ التَقافي","بِما وَعَدَ الزَمانُ مِنَ التَقَفّي",10,"ف",2,0],["أَما شاهَدتَ كُلَّ أَبي وَليدٍ","يَؤُمُ طَريقَ حَتفٍ مُستَقيما",11,"م",2,0],["أَما شيبي وَقَد اِستَولى","فَبَياض ما إِن أَحمده",12,"د",2,0],["أما شعرتم أنها داهية","شعواء لا فصية منها بالولى",13,"ا",1,0],["أَمّا شَبيهُكَ في الأَنامِ فَإِنَّهُ","ما كانَ قَطُّ وَلا يَجوزُ كِيانُهُ",14,"ن",2,0],["أَمَا شَاقَتْكَ فَاسُفَقَبْلُ شَاقَتْ","لَيَالِي السَّفْحِ مَوْلاَنَا الرَّضِيَّا",15,"ي",2,0],["أمّا شمائِلهُ الكرام فإنّها","قد جُمّعت لِقرينها وَضريبها",16,"ب",3,0],["أَم أَشرَقَت فِقرَةٌ بَدائِعُها","حَديقَةٌ زانَها طَرائِقُها",17,"ق",3,0],["إِمَّا شجيتِ برحلتي فاستبشِري","بجميل ظنّي من جميلِ عواقبي",18,"ب",2,0],["أما شمرت أباً رباك من صغرٍ","حتى شببت شباباً غير محجون",19,"ن",1,0],["أما شمائلك الحسان فإنها","مثل الحسان عشقتها يا ماجد",20,"د",1,0],["أم اشرق اليمن في أفق الجلال وقد","أزرى سناهُ باقمارٍ بأوج سما",21,"م",2,0],["أما شاهدي قلبي لديك وناظري","وإن جَرحَته في الهوى أعينٌ نُجل",22,"ل",1,0],["أما شبابي فقد أبليت جدته","بين المحابر والأقلام والكتب",23,"ب",1,0],["أَما شبُهت مِن قَبل ذاكَ بمثل ذا","فَحَولٌ بَهاليل فَكَيفَ الصَقالب",24,"ب",1,0],["إِمّا شَرِبتَ بِكأسٍ دارَ أَوَّلُها","عَلى القُرونِ فَذاقوا جُرعَةَ الكاسِ",25,"س",1,0],["أما شاقكم روض القتال وقد سرى","إليكم نسيم النصر وهو معطر",26,"ر",1,1],["أم أشتكي دهراً ببابك بعد ما","يممته وجلاً ببلغة زاد",27,"د",1,0],["أما شُعوبٌ فخيّمَت بشعابِ","فسطت عليَّ وقطّعت أسبابِي",28,"ب",2,1],["أَمَّا شُمُطرَه يا أخي قد جُرِّبَت","من تَكوَةٍ في السِّلِّبارِ استُقربَت",29,"ت",1,0],["أَمَّا شَمَالِيهِ عليه الجاهُ","خَمسٌ صحيحَه ما به إشباهُ",30,"ه",1,0],["أمَّا شَمَالِيهُم الإفرنجِ وَالمَغَارِبِ","إقهَم كَلاَمِي وَآعتَيِر يَا صَاحِبي",31,"ي",1,0],["أما شيد العلياء حتى بنى لها","من العز بيتا ساميات مناصبه",32,"ب",2,0],["اما شِئت ان تَسمو عَلى الشُهب رِفعَة","بِطالِع سَعد في مَقام مُمجد",33,"د",1,0],["أم اشتِمُ جِيراني فَأصبحَ مِثلَهُ","أَعَوذُ بِرَبِّي أَنَّ أَكُونَ لَهُ مِثلا",34,"ل",2,0],["أما شاهدوا بدر السماء وكأنه","مذ انشق برد من يد الحائك انقصا",35,"ص",2,0],["أما شهد الصلد القسىّ ببعثه","فلله اعجاز لمن صدّ شادخ",36,"خ",1,0],["أما شديد بطشه وعقابه","فيه وأما محسن وغفور",37,"ر",1,0],["أما شمتَ يا لُبي بغيرك عبرةً","وكم سحَّ من عين ميازيب عبرةِ",38,"ه",1,0],["أَم أَشقَرَ البَرقِ الَّذي جالَ بِهِ","فَتَحَ فاهُ بالصَهيلِ وَشَحَا",39,"ا",1,0],["أَمَّا شَبابي فَلَم أَذمُم صَحابَتَهُ","وَالشَّيبُ حينَ عَلاني زادَني وَرَعا",40,"ع",2,1],["أما شبا السيف مسلولاً على القمم","فقد حمدنا ولم نذمم شبا القلم",41,"م",1,1],["أما شريكتُه فكانت كلما","للبيت عاد بِما جناه ترحب",42,"ب",1,0],["أما شاهدتَ أنَّاتِ الثَّكالى","تفوحُ زهورها بؤسًا وقهرا",43,"ر",2,0],["أما شمول النهج فهو موجه","لذوي النهى، هم قلّةٌ تعنيكا",44,"ك",2,0],["أما شيد العلياء حتى بنى لهها","من العز بيتا سامكات مناصبه",45,"ب",2,0],["أم اشتاق للمغنى المريع وأهله","مطالع أقمار الحياتين سرمدا",46,"د",2,0],["أمَّا شموخي فإني شامِخٌ أبداً","ولنْ تراني ضعيفَ القلبِ إطلاقا",47,"ق",2,0],["أما شواهدها فأكثر حكمة","قالت بأن اليأس مصدره الفشل",48,"ل",1,0],["أما شاهدتِ روحاً فيك هامت","على الوادي ذهاباً أو إيابا",49,"ب",2,0],["أما شعرتِ بنار الوجد تحرقني","حتّى تزيدي لهذي النّار إضراما",50,"م",2,0],["إما شقيٌ بالشدائد مبتلى","أو مُسعد وله الحظوظُ تلينُ",51,"ن",1,0],["أمّا شقيق وقد أودى بأخوته","والأمهات هنا يندبن في التُرب",52,"ب",1,0],["أما شفقتِ على قلبٍ برتْهُ أذىً","أسقامُهُ وشكا دمعاً وأحزانا",53,"ن",2,0]]}