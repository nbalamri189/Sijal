"],[1179,"","https://poetry.dctabudhabi.ae/diwan/poem/69190","الطويل"],[1400,"","https://poetry.dctabudhabi.ae/diwan/poem/137855",""],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49547","الوافر"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60940","الطويل"],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65958","الطويل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140052",""],[3162,"","https://poetry.dctabudhabi.ae/diwan/poem/142904","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62808","الوافر"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86245","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91407","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77153","الطويل"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199065","الطويل"],[4691,"بحجم الكون لو قيسا","https://www.poetsgate.com/ViewPoem.aspx?id=207367",""],[4755,"لِأَنَّ الحُرَّ يَأبَى مَن يَجُورُ","https://www.poetsgate.com/ViewPoem.aspx?id=202738",""],[4818,"بركان روحي","https://www.poetsgate.com/ViewPoem.aspx?id=203508",""],[4876,"كالغيب","https://www.poetsgate.com/ViewPoem.aspx?id=207495",""],[4981,"رسول اللّه","https://www.poetsgate.com/ViewPoem.aspx?id=190521",""],[5064,"معنى العدم","https://www.poetsgate.com/ViewPoem.aspx?id=199102",""],[5444,"كُرَةُ اللَّهَب","https://www.poetsgate.com/ViewPoem.aspx?id=205082",""],[5582,"أَمِنْ ذِكْرِ أَطْلالٍ خَلَتْ وَتَعَفَّتِ","https://www.poetsgate.com/ViewPoem.aspx?id=63472",""],[5784,"ألا يا زمان التيه","https://www.poetsgate.com/ViewPoem.aspx?id=196957",""],[5956,"بنيَّ سعادتَه المنجزاتُ","https://www.poetsgate.com/ViewPoem.aspx?id=192380",""],[6120,"أَيَا طَالِبَ الْبُعْد","https://www.poetsgate.com/ViewPoem.aspx?id=216032",""],[6160,"غَزَالةُ المَجَازاتِ البَعِيْدَة ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87085&r=&rc=2",""],[6180,"رسالتي الأخيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81076&r=&rc=10",""],[6190,"أتيتُ سهواً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87002&r=&rc=8",""],[5080,"بلالٌ دونَ مئذنةٍ أنايا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88134&r=&rc=4",""]],"verses":[["وكيف سلُوُّ القلب عنها وقد غدا","لها كل قلبٍ سخّرتْه مسخّرا",0,"ر",2,0],["وكيف سُخطي عليه","وطِيزُها المترضِّي",1,"ض",2,0],["وَكَيفَ سُؤالُنا عَرَصاتِ رَبعٍ","تُرِكنَ بِقَفرَةٍ حَتّى بَلينا",2,"ن",2,0],["وَكَيفَ سُكوني إِلى غَيبِهِ","وَلَونُ يَدي عِندَهُ لَونُهُ",3,"ن",2,0],["وكيف ساس رعاة الشاء مملكة","ماساسها قيصر من قبل أو شاه",4,"ا",2,0],["وَكَيفَ سُلُوّي عَنكَ يا مَن بِكَفِّهِ","حَياتي لَهُ غادٍ عَلَيَّ وَطارِقُ",5,"ق",1,0],["وكيف ساس رعاة الشاة مملكة","ًما ساسها قيصرٌ من قبل أو شاهُ",6,"ا",2,0],["وكيف سلوي وارتياحي بغيرها","وعنبرة الاكوان نفس ترابها",7,"ب",3,0],["وكيف سلوُّ ظمآن عن الما","بشهر أو بأكثر أو أقلا",8,"ل",2,0],["وكيف سُلُوّي والجوى في ضمائري","وسلطان تذكاري عليَّ تَجَبَّرا",9,"ر",2,0],["وَكَيفَ سلوّي مَن أَلِفتُ وإنَّنا","لإِلفان مُذ نيطَت بكلٍّ تمائمُه",10,"م",2,0],["وكيف ساروا وروحي بَعضُ مَن معهم","وما أَرى عُمُري للبَيْنِ مُنقَرِضا",11,"ض",2,0],["وكيفَ ساجلَت الغمام الذي","ليس له في الصيفِ أمطارُ",12,"ر",1,0],["وَكَيفَ سطا بِهِما وَاِستَطال","وَأَرضُ بِساطِهِما النَيِّرانِ",13,"ن",1,0],["وكيف سلوّ أهل الخيف وُدّي","ولم أسْلُ لهم في البين وُدّا",14,"د",2,0],["وكيف سؤالُ رسمٍ عن فريقٍ","ولم تعرف فتخبرك الرّسومُ",15,"م",1,0],["وكيف سُلوِّي عن حبيبٍ إذا مضى","فلا متعةٌ لي بعدهُ بحبيبِ",16,"ب",1,0],["وكَيْفَ سُكُوني بَعْد بُعْدِي لِحفْظِه","بعَهدي وقِدْماً كُنْتُ أَتَّهِمُ القُرْبَا",17,"ب",2,0],["وكيف سرى خيالُكِ مِن أناحٍ","فَحيّا الركبَ مِن جَبَلَي جياده",18,"د",2,0],["وكيفَ سَلوتَ عن أرضٍ بأرضٍ","يَفوحُ تُرابُها مِسكاُ ونَداّ",19,"د",2,0],["وكيفَ سَها المُلُوكُ فلم يميلُوا","إليهِ التّاجَ عنهُم والسَّريرا",20,"ر",2,0],["وَكَيفَ سَلاها القَلبُ وَهوَ محلّها","سَلا هَل سلا إِجمالها أَو جَمالها",21,"ل",3,0],["وَكَيفَ سلُوِّي وَالهَوى لِيَ مَذهَب","وَدينُ الهَوى قَد صَحَّ أَنّي إِمامُهُ",22,"م",2,0],["وكيفَ سُلُوُّ النَفسِ عَنكِ وإنَّها","لَوَحشٌ فَواءٌ من سِواكِ حِمى لكِ",23,"ك",1,0],["وَكيفَ سفكُ دَمي عنها يحالُ وقد","أقرَّ منها اِحمرارُ الخدِّ واِعتَرفا",24,"ف",2,0],["وكيف سباحتي في بطن بحر","بعيد الشاطئين من الدواء",25,"ا",2,0],["وَكَيف سُلّوي عَن حَبيب خَيالُه","أَمامي وَخَلفي في مَقامي وَمَقعَدي",26,"د",2,0],["وكيف سموك اعلانا وما التفتوا","نحو القلوب وما سموك مرّانا",27,"ن",2,0],["وكيف سَمَا الزمانُ إلى مَحَلٍّ","يَضِلُّ الطيفُ فيه عن الدَّبيب",28,"ب",1,0],["وكيفَ سُلوِى عنْ أناس أحُبِهُم","وما حُبّك الانسان إلاَّ تّحَبَّبَا",29,"ب",2,0],["وكيف سطا في الأربعين عشية","على عسكر لم يلقه قط عسكر",30,"ر",1,0],["وكيف سكنت في احشا صب","يذوب بحرها صم الجمادي",31,"د",2,0],["وكيف سارت بنا الأمواج هادئة","حينا، وهائجة حينا ، إلى الجُزُر",32,"ر",1,0],["وكيفَ سبى نسيمُ الريحِ بَعدي","ثَرى تلكَ المعالمِ والرسومِ",33,"م",1,0],["وَكَيفَ سلوّي من محيا جَمالِها","لَهُ في سَماءِ الحُسنِ تَزهو مَطالِع",34,"ع",1,0],["وَكَيفَ سُلوّي عَن غَرامٍ تحكّمت","قِواه بنفس بادي عزتها أَذل",35,"ل",1,0],["وَكَيف سلوى عَن كِرام أَعِزَّة","بِهِم أَخصَب العافي وَعزَّ المُجاوِر",36,"ر",1,0],["وكيف سلوي عن مغان عهدتها","مجامع فضل بل وجامعة الفخر",37,"ر",1,0],["وكيفَ سأضمرُ النيرانَ","حينَ تصيرُ ملبوسا",38,"س",2,0],["وكَيفَ سَيَحتَمِي بالجَيشِ شَعبٌ","يَقُودُ زِمَامَهُ عُمْيٌ وعُورُ؟!",39,"ر",1,0],["وكيفَ سلبتني كلّي، حبيبي؟","مددتَ براحةٍ، ثمَّ اتكأتا؟",40,"ت",2,0],["وكيفَ سأبني للخليقةِ كوكبًا","محمَّده عيسى وموساهُ أحمدُ",41,"د",1,0],["وكيف سَأبلُغُ العلياءَ حتى","أُدَاني فوقَها خِلّاً مُقيما",42,"م",2,0],["وكَيفَ سأحزَنُ مَا دامَ عُمرِي","سيمضِي أمامِي مُضِيَّ الحُلُمْ",43,"م",1,0],["وكَيفَ سأعرفُ معنى السَّعادَةِ","لَو أنَّني عِشتُ دُونَ أَلَمْ",43,"م",1,0],["وكيف سيَرضى أنْ يعيشْ بدُونِها","إذا رَحلَت عنَّا المَحبةُ والمُحِب",44,"ب",1,0],["وَكَيْفَ سُلُوِّي وَهيَ رُوحِي وَراحَتِي","وَسَعْدِي وَنَحْسِي وَهيَ نارِي وَجَنَّتِي",45,"ت",2,0],["وكيف سيرضي الناس ما أنت كاتب","وكل امرئ قد غيرته المذاهب",46,"ب",1,1],["وكيف سنبني الحضارة عَلْيا","وفوق حمير الضنا نرتحِلْ؟",47,"ل",1,0],["وَكَيفَ سَأَنسَاكَ مِنْ بَعدِ هَجرٍ","وَكُلُّ اِشْتِيَاقٍ يُؤَدِّي إِلَيْكْ",48,"ك",1,0],["وَكَيْفَ سَأَسْلُوْ أَنَا عَنْ هَوَاك","مُحَالٌ وَقَلْبِيَ بَيْنَ يَدَيكْ؟",48,"ك",1,0],["وَكَيفَ سَيُغرِيهَا دَهَاءُ قَصَائِدِي ...","إِذا كانَ جَفْنُ العَيْنِ بِالمَكْرِ مُوصَدَا",49,"د",2,0],["وكيف ستسكنين دروب قلبي","إذا خطَّ الرحيلُ ليَ الدروبا",50,"ب",2,0],["وكيفَ سأطلقُ الإبداعَ نهراً","إذَا حُريّتي ضاقتْ بِسِجْني",51,"ن",2,0],["وكيفَ ستشربُ الطرقاتُ عمري","وعمري بات ملجؤهُ أسايا",52,"ا",3,0]]}