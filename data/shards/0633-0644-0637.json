{"poems":[[53,"أكذا المنون تقنطر الأبطالا","https://www.aldiwan.net/poem29888.html","الكامل"],[55,"ظلمت عينك عيني إنها","https://www.aldiwan.net/poem26224.html","الرمل"],[55,"أصبحت في هم وفي كرب","https://www.aldiwan.net/poem26541.html","السريع"],[71,"قد أصبح الرزق ما له سبب","https://www.aldiwan.net/poem3781.html","المنسرح"],[93,"بني أخي هيا بنا نلعب","https://www.aldiwan.net/poem11081.html","السريع"],[72,"يا روضة الحسن إن النفس خضراء","https://www.aldiwan.net/poem18201.html","البسيط"],[72,"سلوت لكن قلبي يا سعاد سلي","https://www.aldiwan.net/poem19470.html","البسيط"],[51,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8499.html","البسيط"],[51,"ذاد عن مقلتي لذيذ المنام","https://www.aldiwan.net/poem66325.html","الخفيف"],[51,"إن إسماعيل قرد مجرم","https://www.aldiwan.net/poem66398.html","الرمل"],[51,"ناشدتك الله أن تستفسد المننا","https://www.aldiwan.net/poem66517.html","البسيط"],[85,"في ذي الجفون مصارع الأكباد","https://www.aldiwan.net/poem6821.html","الكامل"],[85,"قم سابق الساعة واسبق وعدها","https://www.aldiwan.net/poem62977.html","الرجز"],[62,"يا ابن الألى خضعت لملكهم","https://www.aldiwan.net/poem52378.html","أحذ الكامل"],[45,"أصبحت في جهد وفي كرب","https://www.aldiwan.net/poem11485.html","السريع"],[28,"ما إن أبو بشر ولا أبواهما","https://www.aldiwan.net/poem5442.html","الكامل"],[66,"سفح المزاج على حميا الكاس","https://www.aldiwan.net/poem38490.html","الكامل"],[66,"كان الزمان بلقياكم يمنينا","https://www.aldiwan.net/poem40132.html","البسيط"],[66,"زار وصبغ الظلام قد نصلا","https://www.aldiwan.net/poem40970.html","المنسرح"],[66,"حوشيت من زفرات قلبي الواله","https://www.aldiwan.net/poem41372.html","الكامل"],[80,"كم غريب حنت إليه غريبه","https://www.aldiwan.net/poem31553.html","الخفيف"],[69,"سلطاننا اليوم طفل والأكابر في","https://www.aldiwan.net/poem28988.html","البسيط"],[105,"سيد الرسل وأم المؤمنين","https://www.aldiwan.net/poem44196.html","الرمل"],[75,"ألا هكذا فليهد من قاد عسكرا","https://www.aldiwan.net/poem69082.html","الطويل"],[46,"سلطانك النار إن تعدل فنافعة","https://www.aldiwan.net/poem23020.html","البسيط"],[76,"يا من تجلد للزما","https://www.aldiwan.net/poem39457.html","مجزوء الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54894","الكامل"],[90,"ثورة الوجدان","https://www.poetsgate.com/ViewPoem.aspx?id=179082",""],[107,"صاد الأسود بمقلة وسناء","https://www.aldiwan.net/poem16412.html","الكامل"],[113,"ان الحبيب الذي باللطف افنانا","https://www.aldiwan.net/poem40461.html","عموديه"],[113,"ريم زها جماله","https://www.aldiwan.net/poem40603.html","عموديه"],[113,"سلطاننا عبد الحميد الذي","https://www.aldiwan.net/poem40939.html","عموديه"],[113,"لذ بالرفاعي الحسيني الذي","https://www.aldiwan.net/poem41070.html","عموديه"],[113,"باب الوصول لفيض طه الهادي","https://www.aldiwan.net/poem41126.html","عموديه"],[113,"سلطان الحي وسيده","https://www.aldiwan.net/poem41169.html","عموديه"],[113,"سر الغيوب افاض اللارواح","https://www.aldiwan.net/poem41185.html","عموديه"],[113,"لك الاضافات بالاسرار والنسب","https://www.aldiwan.net/poem41224.html","عموديه"],[113,"لك بين سفار الحمى اسماء","https://www.aldiwan.net/poem41467.html","عموديه"],[113,"للغوث عبد القادر الجيلاني","https://www.aldiwan.net/poem41764.html","الكامل"],[113,"لكل أمر تسول بابن عدنان","https://www.aldiwan.net/poem42169.html","البسيط"],[113,"الحمد لله الذي قد أنعما","https://www.aldiwan.net/poem42187.html","الرجز"],[158,"الملك الناصر سلطاننا","https://www.aldiwan.net/poem58962.html","السريع"],[162,"جزعت أن يقال دام عبيط","https://www.aldiwan.net/poem67813.html","الخفيف"],[183,"يا بنى الهالكين هل من وقاء","https://www.aldiwan.net/poem14082.html","الخفيف"],[208,"بقوامه والطلعة الغراء","https://www.aldiwan.net/poem13313.html","الكامل"],[220,"قمر تجلى في سماء كماله","https://www.aldiwan.net/poem55413.html","الكامل"],[221,"غلواء ما أحلى المعطارا","https://www.aldiwan.net/poem39711.html","الرجز"],[230,"فديت من حبي له","https://www.aldiwan.net/poem14768.html","مجزوء الرجز"],[233,"دار الهوى بين اللوى وشراف","https://www.aldiwan.net/poem31818.html","الكامل"],[233,"سرب مها أم دمى محاريب","https://www.aldiwan.net/poem32184.html","المنسرح"],[268,"أنت المقيل المرتجى يا هتلر","https://www.aldiwan.net/poem35585.html","الكامل"],[273,"سما بأمرك إسعاد وإنجاد","https://www.aldiwan.net/poem25589.html","البسيط"],[280,"أنا بالغزلان وبالغزل","https://www.aldiwan.net/poem32672.html","المتدارك"],[283,"فغدت رياض العلم مزهرة فيا","https://www.aldiwan.net/poem39340.html","الكامل"],[283,"طاب الحديث بذكر المطربات فذا","https://www.aldiwan.net/poem39415.html","البسيط"],[283,"ما الفخر بالأهرام عندي حجة","https://www.aldiwan.net/poem39424.html","الكامل"],[283,"ظهرت محاسن ذا الزمان فقابلت","https://www.aldiwan.net/poem39432.html","الكامل"],[295,"لله مدرسة علا بنيانها","https://www.aldiwan.net/poem33090.html","الكامل"],[301,"سلطان حسن إن سطت أجفانه","https://www.aldiwan.net/poem58092.html","الكامل"],[346,"عشقت من ريقته قرقف","https://www.aldiwan.net/poem19888.html","السريع"],[351,"يا مالك الملك العزيز","https://www.aldiwan.net/poem39573.html","مجزوء الكامل"],[351,"بالفتح لاح لنا الهناء مبشرا","https://www.aldiwan.net/poem40350.html","الكامل"],[364,"لو كنت جاوبت الحمائم نائحا","https://www.aldiwan.net/poem16963.html","الكامل"],[369,"ومن بني القواد من يغنه","https://www.aldiwan.net/poem56925.html","السريع"],[374,"حزت الرئاسة في الآفاق قاطبة","https://www.aldiwan.net/poem59301.html","البسيط"],[379,"منع النوم ماوي التهمام","https://www.aldiwan.net/poem433.html",""],[426,"للعلم انشاها الذي عم الورى","https://www.aldiwan.net/poem39823.html","الكامل"],[451,"اقطعوها وانبذوا من قد دعاها","https://www.aldiwan.net/poem61709.html","الرمل"],[456,"أمكنت العاذل من قيادها","https://www.aldiwan.net/poem56218.html","الرجز"],[456,"من عذيري يوم شرقي الحمى","https://www.aldiwan.net/poem56251.html","الرمل"],[462,"كم بين أكناف العذيب وحاجر","https://www.aldiwan.net/poem3505.html","عموديه"],[477,"إيطاليا قيل قالت","https://www.aldiwan.net/poem37202.html","المجتث"],[498,"أبكي وبدري بالجمال توارى","https://www.aldiwan.net/poem37625.html","الكامل"],[498,"القلب يفزع في المهمة ضارعا","https://www.aldiwan.net/poem37696.html","الكامل"],[498,"جرد لبر الشرق همة زائر","https://www.aldiwan.net/poem38011.html","الكامل"],[498,"لنا بنفي شؤون الغير إثبات","https://www.aldiwan.net/poem38062.html","البسيط"],[512,"سلطان حسنك بحكم الجور خليته","https://www.aldiwan.net/poem20915.html","المواليا"],[565,"معتدل من كل أعطافه","https://www.aldiwan.net/poem69779.html","السريع"],[584,"هويت من ريقته قرقف","https://www.aldiwan.net/poem17443.html","السريع"]],"verses":[["سُلطانُ مِلكٍ كُنتَ أَنتَ تُعِزُّهُ","وَلَرُبَّ سُلطانٍ أَعَزُّ رِجالا",0,"ل",2,0],["سُلِّطَ الشَوقُ عَلى الدَمعِ فَما","هَبَّ داعي الشَوقِ إِلّا اِندَفَقا",1,"ق",2,0],["سَلَّطَتِ الحُزنَ بِإِعراضِها","ظَلومُ فَاِستَولَت عَلى لُبّي",2,"ي",1,0],["سُلطاننا أَعرَجٌ وَكاتِبُهُ","ذو عَمَشٍ وَالوَزيرُ مُنحَدِبُ",3,"ب",1,0],["سلطاننا ثم من القيم","من بعده عباس أحسنتم",4,"م",1,0],["سلطاننا حسن الأوصافِ أجمعها","يروي بها عن صحيح الملك أبناءُ",5,"ا",2,0],["سلطان مصر الرخا والأمن عمَّ فما","بها سوى النيل قطَّاع على السبل",6,"ل",1,0],["سلِّطْ عليه عُبيد الله إنَّ له","سيفين ذو خُطَبٍ تَتْرى وذو شُطَبِ",7,"ب",1,0],["سُلِّطَ البَثْقُ والحريقُ عليهم","فتداعت أركانُها بانهدامِ",8,"م",1,0],["سَلَّطَ اللَّهُ عليهِ طِبَّهُ","وكفاه طِبَّهُ لا بَلْ كفاني",9,"ن",2,0],["سلِّط عليَّ حيائي منك حَسْبُكَهُ","ولا تُسلط علي الهمَّ والحَزنا",10,"ن",2,0],["سلطت في تأديبهم رعدا على","رعد وجلادا على جلاد",11,"د",1,0],["سُلطانَها وَعِزَّها وَرَغدَها","وَكَيفَ يُعطى المُتَّقونَ خُلدَها",12,"د",3,0],["سُلطَتُهُ إِلى بَنينا رَدَّها","يا رَبِّ قَوِّ يَدَها وَشُدَّها",12,"د",3,0],["سُلطانُ فضلِكَ فوقَ مُلكِهمُ","فاقْنَعُ به بَدَلاً بلا بَخْسِ",13,"س",1,0],["سَلَّطَتِ الحُزنَ بِإِعراضِها","ظَلومُ فَاِستَولَت عَلى القَلبِ",14,"ب",1,0],["سُلطانَهُ وَعَصا النَبِيِّ وَخاتَماً","أَلقى لَهُ بِجِرانِهِ وَالكَلكَلِ",15,"ل",1,0],["سُلطانُ عَدلٍ بَل خَليفَةُ مَنصِبٍ","أَحيَت مَناقِبُهُ بَني العَبّاسِ",16,"س",1,0],["سُلطانُ عَصرٍ إِلَهُ العَرشِ بَوَّأَهُ","مِنَ المَعالي وَلِلخَيراتِ هَيَّأَهُ",17,"ه",1,0],["سُلطانِ عَصرٍ مُسَمّى","عَلى الوَلي",18,"ي",1,0],["سُلطانُ عَصرٍ عَزمُهُ راضَ الوَرى","فَكَفاهُ ماضيهِ عَنِ اِستِقبالِهِ",19,"ل",2,0],["سُلّطَتْ كرْبةُ التنائي علينا","فعسى فرحةُ التداني قريبهْ",20,"ب",2,0],["سلطانُنَا اليومَ طفلٌ والأكابرُ في","خِلْفٍ وبينهُم الشيطانُ قَدْ نزغا",21,"غ",2,1],["سَلَّطَ الضربَ على مولاتها","أيُّ سرٍّ عندها للضاربين",22,"ن",1,0],["سَلِطُ السنابك باللُّجَينِ مُخَّدمٌ","وأُذيبَ منْه على الأديم نُضار",23,"ر",1,0],["سُلطانُكَ النارُ إِن تَعدِل فَنافِعَةٌ","وَإِن تَجُر فَلَها ضَيرٌ وَإِحراقُ",24,"ق",1,1],["سَلِّطْ نُهاكَ عَلَى هَوَا","كَ وَعُدَّ يَوْمَك لَيْسَ مِنْ غَد",25,"د",1,0],["سَلْ طَيْفَ جُلْجُلَةٍ وَقَدْ تَرَكَ الطَّوَى","مِنْهُ ضِيَاءً فِي بَيَاضِ إِزَارِ",26,"ر",1,0],["سَلْ طَائِراً فِي جَنَّةٍ","غَنَّاءَ فَائِحةِ العَبِيرْ",27,"ر",1,0],["سلَّطتُ عقلي على مَيلي وعاطفتي","صَبْراً كما سَلَّطُوا ماءً على نار",28,"ر",1,0],["سُلطان حسن في المَلاحة قَدهُ","قَد خَصَهُ مِن شِعرِهِ بِلِواءِ",29,"ا",2,0],["سلطان اهل الوحا قطب الرحاوسنا","شمس الضحى عينها علما وتبيانا",30,"ن",2,0],["سلطان حسن والقلو","ب كلها عماله",31,"ل",2,0],["سلطاننا عبد الحميد الذي","زهابه المحراب والمنبر",32,"ر",1,1],["سلطان كل الاولياء وعارف","نهضت به في سيره الاقدار",33,"ر",1,0],["سلطان عرفان يلاذ بظله","في حالة الاصدار والايراد",34,"د",1,0],["سلطان الحي وسيده","شيخ الديوان واحمده",35,"د",2,1],["سلطان اقطاب الرجال وتاجهم","فلك الوحا ذو المظهر الوضاح",36,"ح",1,0],["سلطان غر صدور الاولياء ابو ال","عرجاء من كشفت جهرا له الحجب",37,"ب",1,0],["سلطان اهل الله شيخ كبارهم","حامي الحمى ان انشبت غماء",38,"ا",2,0],["سلطان كبكبة الرجال وصاحب ال","قدم الرفيع وفارس الميدان",39,"ن",1,0],["سلطان حضرة قدس ضمن حضرته","في كل زاويةٍ ملك سليماني",40,"ي",1,0],["سلطان أهل الحال والسماع","شمس العراق أحمد الرفاعي",41,"ي",1,0],["سلطاننا المرتجا ذو العلى","ليث الشرا رب العطا والجدا",42,"د",2,0],["سُلِّطَ الصَبرُ وَالرَجاءُ عَلى النا","سِ سَيُغريهِما بِهِ التَسليطُ",43,"ط",1,0],["سُلِّطت حيلةُ العقول على كُ","لّ خَفىٍّ من غامضِ الأشياء",44,"ا",2,0],["سلطان حسن قد بدا بجبينه","يختال تحت عصابة بيضاء",45,"ا",2,0],["سلطاننا عبدالحميد وناصر ال","دين الذي حمدت جميع خلاله",46,"ل",2,0],["سُلطانَةُ البِحارِ وَالأَسفارِ","مَليكَةُ البَرنيرِ وَالنُضارِ",47,"ر",1,0],["سَل طَرفَكَ الفَتّانَ لِم","أَقسَم لا يَرحَمُني",48,"ن",2,0],["سُلطانُ أَرضِ اللَهِ وَالحامي حِمى ال","إِسلامِ وَالظِلُّ المَديدُ الضافي",49,"ف",2,0],["سُلطانِ أَرضِ اللَهِ الَّذي ضَمِنَت","رِماحُهُ نَصرَ كُلِّ مَحروبِ",50,"ب",1,0],["سلطانُها سلطانُ خالقِها الذي","عنهُ تنوبُ فحقُّها لا يُنكر",51,"ر",1,0],["سُلطانُهُ خَرقَ العاداتِ فائتَلَفَت","على المراشِدِ أغيارٌ وأضدادُ",52,"د",1,0],["سُلطانُ جَمالِكَ دَولَتُهُ","تَنقادُ لَها كُلُّ الدُوَلِ",53,"ل",1,0],["سلطاننا عبد الحميد المنتحى","فخر الملوك حسام كل محارب",54,"ب",1,0],["سلطاننا معشر الاسلام قاطبة","شرقا وغربا بيلا ريب ولا جرم",55,"م",1,0],["سلطاننا وولي نعمتنا الذي","ذكر اسمه في العالمين شعار",56,"ر",1,0],["سلطاننا وولي نعمة حزبنا","وخليفة المختار نبراس الشهيد",57,"د",1,0],["سلطانُ شاهِ حسينٍ الملك الَّذي","طابَت به الدُنيا وطاب زَمانُها",58,"ن",3,0],["سلطان حسن إن سطت أجفانه","فقوى التصبر عندها متلاشيه",59,"ه",1,1],["سُلُطَانُ حُسْنٍ زَادَ في عَدْلهِ","فاخْتَارَ أَنْ يَبقَى بِلا حَاجِبِ",60,"ب",1,0],["سُلطاننا عَبد العَزيز","شَمس العُلى سامي المَعالي",61,"ي",1,0],["سُلطاننا العالي عَلى فلك العُلى","عَبدِ المَجيدِ الأَوحد السامي الذُرى",62,"ر",2,0],["سَلطائِراً صَدَعَ الفُؤادَ بِسُحرَةٍ","أَتُراهُ غَرَّد صادِعاً أَم صادِحا",63,"ح",2,0],["سُلطانُ عَينَيهِ لَه سَطوَةٌ","أشَدُّ مِن سَطوَةِ سُلطانِهِ",64,"ه",1,0],["سلطانُك العامُ بالإطلاقِ عمَّ به","غرباً وشرقاً لأن اللَه ولّاكا",65,"ك",2,0],["سُلِّطَ الدَهرُ وَالمَنونُ عَلَيهِم","فَلَهُم في صَدى المَقابِرِ هامُ",66,"م",1,0],["سلطاننا بدر الملوك ومن بهِ","زهت المعالم حين أشرق ربعها",67,"ع",3,0],["سلطةُ الشعبش هي الأم التي","أنمت الأحرارَ لا دَعوى سواهَا",68,"ا",3,0],["سلَّطتِ الوجدَ على جوانحي","تسلُّطَ الخُلفِ على ميعادِها",69,"د",3,0],["سل طريق العيس من وادي الغضا","كيف أغسقتَ لنا رَأْدَ الضحى",70,"ح",2,0],["سلطان مقلتها أباح جوانحي","عدوانَ عاملها وجورِ الناظر",71,"ر",1,0],["سل