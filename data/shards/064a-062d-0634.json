{"poems":[[55,"بمجال عزمي يملأ الملوان","https://www.aldiwan.net/poem29659.html","الكامل"],[24,"أمن دمنة الدار أقوت سنينا","https://www.aldiwan.net/poem21884.html","المتقارب"],[29,"ألا حي المنازل بالجناب","https://www.aldiwan.net/poem5664.html","الوافر"],[29,"غدا باجتماع الحي نقضي لبانة","https://www.aldiwan.net/poem5735.html","الطويل"],[2,"صحا القلب عن سلمى وقد كاد لا يسلو","https://www.aldiwan.net/poem25064.html","الطويل"],[70,"ته دلالا فأنت أهل لذاكا","https://www.aldiwan.net/poem1517.html",""],[102,"أسمار القرية","https://www.poetsgate.com/ViewPoem.aspx?id=50334",""],[24,"أمِنْ دِمْنة ِ الدَّارِ أَقْوَتْ سِنِينَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10886&r=&rc=27",""],[342,"عفا بطن قو من سليمى فعالز","https://www.aldiwan.net/poem45428.html","الطويل"],[396,"يا تاركين الصلاة","https://www.aldiwan.net/poem54601.html","عموديه"],[566,"أما ورب البيت لو لم أشغل","https://www.aldiwan.net/poem27840.html","الرجز"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113976","الطويل"],[2131,"","https://poetry.dctabudhabi.ae/diwan/poem/89546","الطويل"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147348","البسيط"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136943",""],[4866,"وصايا العز","https://www.poetsgate.com/ViewPoem.aspx?id=133584",""],[5351,"الشعب العظيم","https://www.poetsgate.com/ViewPoem.aspx?id=202103",""],[6038,"الاقصى","https://www.poetsgate.com/ViewPoem.aspx?id=27219",""],[4442,"مواهب كفك لا تحتقر","https://www.poetsgate.com/ViewPoem.aspx?id=171213",""]],"verses":[["يَحشونَ أَحشاءَ الوِفاضِ إِذا هُمُ اِح","تَزَموا بِفَضلِ ذَوائِبِ الشُجعانِ",0,"ن",1,0],["يُحَشرِجُ مِنهُنَّ قَيدَ الذِراعِ","وَيَضرِبنَ خَيشومَهُ وَالجَبينا",1,"ن",2,0],["يَحُشّونَ الحُروبَ بِمُقرَباتٍ","وَداؤودِيَّةٍ كَأَضا الحَبابِ",2,"ب",1,0],["يَحُشّونَ نيرانَ الحُروبِ بِعارِضٍ","عَلَتهُ نُجومُ البيضِ حَتّى تَوَقَّدا",3,"د",2,0],["يَحُشّونَها بِالمَشرَفِيَّةِ وَالقَنا","وَفِتيانِ صِدقٍ لا ضِعافٌ وَلا نُكلُ",4,"ل",1,0],["يُحْشَرُ العاشقونَ تحتَ لِوائي","وجميعُ المِلاحِ تحتَ لِواكا",5,"ك",2,0],["يحشر السّمّر الضجيع عليها","من شظايا نعش السنين البوائد",6,"د",1,0],["يحشرجُ منهنّ قيدَ الذراعِ","ويَضْرِبْنَ خَيْسُومَه والجَبِينَا",7,"ن",2,0],["يُحَشرِجُها طَوراً وَطَوراً كَأَنَّما","لَها بِالرُغامى وَالخَياشيمِ جارِزُ",8,"ز",1,0],["يحشر مع الكافرين","وكل مشرك وعات",9,"ت",1,0],["يَحُشُّ قَتلاً بِأَكُفِّ القُتَّلِ","إِلّا جَلوا عَنهُ عَجاجَ القَسطَلِ",10,"ل",1,0],["يَحُشّونَ حوماتِ الوَغى بنُفوسهم","إذا هابَها الثبتُ المِحَشُّ المُباسِلُ",11,"ل",1,0],["يَحُشُّ لظاها أَو يَبوخُ سَعيرُها","بِمَصقولَةٍ من عَهدِ كِسرى وتُبَّعا",12,"ع",2,0],["يُحَشْرِجُ الكَوْنَ فِيْ أَحْضَانِ مسغبةٍ","تُحَاوِلُ النَّصْرَ أَوْ قَبْرًا مِنَ الشَّرَرِ",13,"ر",1,0],["يحشوش يا عرس الربيع","ومنبت الأدب الصحيح",14,"ح",1,0],["يحشد جيوش الكره والغدر كلّه","ويبدا يحارب كلّ خير بْمشاعرك",15,"ك",1,0],["يحشد الأقدار في ساحاتهِ","كلها كيما تبارك محتواه",16,"ا",2,0],["يحشرك ربي مع بوش وبلير","وعسى يا كل عميل الجحيم فالك",17,"ك",1,0],["يحشى بها الفستق المنتقى","فيهفو له السكر المعتصر",18,"ر",1,0]]}