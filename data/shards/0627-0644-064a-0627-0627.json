{"poems":[[112,"يمسهّر النوّيم ومحضضّ النوم","https://www.poetsgate.com/ViewPoem.aspx?id=8402",""],[112,"خزنة ملك","https://www.poetsgate.com/ViewPoem.aspx?id=8383",""],[4702,"عزام بن عبدالعزيز الشاطري","https://www.poetsgate.com/ViewPoem.aspx?id=155109",""],[4702,"ياليتها تاقف الساعة","https://www.poetsgate.com/ViewPoem.aspx?id=155199",""],[4702,"مارد وشيطانيه","https://www.poetsgate.com/ViewPoem.aspx?id=155200",""],[4702,"اليا اختلط وكر الصقور بشي من ريش النعام","https://www.poetsgate.com/ViewPoem.aspx?id=155320",""],[4702,"المبسم الحالي","https://www.poetsgate.com/ViewPoem.aspx?id=156813",""],[5198,"سمو النبض","https://www.poetsgate.com/ViewPoem.aspx?id=135067",""],[5431,"وإن ضاقتِ السُبْلُ","https://www.poetsgate.com/ViewPoem.aspx?id=190098",""],[5652,"شفرة الموس","https://www.poetsgate.com/ViewPoem.aspx?id=208679",""],[5756,"أهل الجنوب","https://www.poetsgate.com/ViewPoem.aspx?id=34581",""],[5866,"مجاراة لقصيدة الشاعر حسن عامر","https://www.poetsgate.com/ViewPoem.aspx?id=182812",""]],"verses":[["اليا اصغرت عينك.؟ فلانيب ملزوم","ارفع حواجبها وكبّر صغرها",0,"ر",3,0],["اليا أنتصفتيه؟ يضيق .. وكل ماله يضيق","كنّك ..كوكايين .. وأرصفته خشم .. مدمنه",1,"ن",2,0],["اليا انكسرت وصرت تطمع للوقوف","واللي قضى دين القضا مايخسري",2,"ر",2,0],["اليا اقبلت في خفا للحب مطواعه","قلبي يرحّب لها والعقل طار بها",3,"ب",3,0],["اليا اقْبلت وادبرت","مارد وشيطانيه",4,"ن",3,0],["الْيا اخْتلط وكر الصقور بشي من ريش النعام","تنبت مخاليب الرخم واسترخمت منها الصقور",5,"ر",1,1],["اليا اقبلت عجلة ولااحدٍ يساويها","مقدم بانوراما على مسح طبلونه",6,"ن",2,0],["اليا ارتقيت وسمو النبض مطلاعي","عن طرقتي دفة الاشواق مااحرفها",7,"ف",3,0],["إليَّا إليَّا بالقبور تضمني","لعلَّ القبور الحانيات بها وصْلُ",8,"ل",1,0],["اليا انكفوا عجلين يعطونك دروس","هماجهم ه الوقت أصبح قراحي",9,"ح",2,0],["اليا ادمحت لي هالخطا بدمح لها كل الذنوب","وإن جابت الحسنة معي تبشر بعشر أمثالها",10,"ل",3,0],["اليا اشتغل يطربك صوت الشكاميني","تقول طيارةً في جوها أمغيرة",11,"ر",2,0]]}