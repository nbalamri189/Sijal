poetry.dctabudhabi.ae/diwan/poem/76776","الخفيف"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64038","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70931","الرمل"],[996,"","https://poetry.dctabudhabi.ae/diwan/poem/82240","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119887","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120049","المنسرح"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136159","الخفيف"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35780","الرمل"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202146","الرمل"],[2020,"","https://poetry.dctabudhabi.ae/diwan/poem/46495","الخفيف"],[2121,"","https://poetry.dctabudhabi.ae/diwan/poem/143010","الخفيف"],[2275,"","https://poetry.dctabudhabi.ae/diwan/poem/28103","الخفيف"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28600","الرمل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60891","المتدارك"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102566","الرمل"],[2607,"","https://poetry.dctabudhabi.ae/diwan/poem/34891","الرمل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93875","البسيط"],[3382,"","https://poetry.dctabudhabi.ae/diwan/poem/144922","الخفيف"],[3660,"","https://poetry.dctabudhabi.ae/diwan/poem/125930","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91068","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216589","الرمل"],[3760,"","https://poetry.dctabudhabi.ae/diwan/poem/143918","الخفيف"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131273",""],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32929","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111521","الخفيف"],[4025,"","https://poetry.dctabudhabi.ae/diwan/poem/122154","الرمل"],[4260,"","https://poetry.dctabudhabi.ae/diwan/poem/200369","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83382","الخفيف"],[5186,"رب خير يولى ولا من بشير","https://www.poetsgate.com/ViewPoem.aspx?id=156485",""],[5776,"الصاعدون للخلود","https://www.poetsgate.com/ViewPoem.aspx?id=199396",""],[6023,"رب خذ للشعر من زمرٍ","https://www.poetsgate.com/ViewPoem.aspx?id=123925",""]],"verses":[["رُبَّ خَرقٍ مِن دونِها يُخرِسُ السَف","رَ وَميلٍ يُفضي إِلى أَميالِ",0,"ل",1,0],["رُبَّ خَرقٍ أَجَزتُ مَلعَبَةِ الجِن","نِ مَعي صارِمُ الحَديدِ إِباطي",1,"ط",2,0],["رُبَ خالَةٍ لَكَ بَينَ قُدسَ وَآرَةٍ","تَحتَ البَشامِ وَرَفغُها لَم يُغسَلِ",2,"ل",1,1],["رُبَّ خالٍ لِيَ لَو أَبصَرتَهُ","سَبِطِ المِشيَةِ في اليَومِ الخَصِر",3,"ر",1,0],["رُبَّ خلقٍ أرقّ من أدمع الخن","سا وقلب يوم الوغى مثل صخر",4,"ر",1,0],["رب خطب صدعت فيه بحكم ال","لَه لو لم تكن لأصبح رتقا",5,"ق",2,0],["رب خيل ركضن في حلبة السبق","فخلين الدرب للسباق",6,"ق",1,0],["رب خير ملئت منه سرورا","ذكّر الخيرين فاهتجت حزنا",7,"ن",2,0],["رب خليل بكيت أرجو","لحقه بالبكى قضاء",8,"ا",2,0],["رُبَّ خَفضٍ تَحتَ السُرى وَغَناءٍ","مِن عَناءٍ وَنَضرَةٍ مِن شُحوبِ",9,"ب",1,0],["ربَّ خوْليٍّ بدا مِنْ","جنَّةْ وهْوَ ينادي",10,"ي",1,1],["رَبُّ خَوفٍ خَرَجتُ مِنهُ فَزالَ ال","بَأسُ مِنّي وَأُقحِمَ التَرخيمُ",11,"م",1,0],["رُبَّ خَفضٍ أَتاكَ مِن بَعدِ بَأسا","ءَ وَبوئسٍ لَقيتَهُ غِبَّ خَفضِ",12,"ض",1,0],["رُبّ خَرْقٍ مِنْ دُونِها قَذَفٌ","ما بِهِ غَيْرَ الجِنِّ مِنْ أَحَدِ",13,"د",1,0],["رَبِّ خُذْ لِي مِن الْعُيُونِ بِحَقِّي","وَأَجِرْنِي مِنْ ظَالِمٍ لَيْسَ يَبْقِي",14,"ق",2,1],["رُبَّ خِلٍّ تَرَاهُ طَلْقَ الْمُحَيَّا","وَهْوَ جَهْمُ الضَّمِيرِ بِالأَحْقَادِ",15,"د",1,0],["رب خطب عُني الدهر به","وزنه في رأينا مثقال ذر",16,"ر",1,0],["رَبِّ خُذْ لِي مِنْ حَسُودٍ","حَجَبَ الظَّبْيَ الرَّبِيبَا",17,"ب",2,0],["رُبَّ خَصمٍ أَرق مِن كُلِّ روح","وَلِفَرطِ الذَكا يَكادُ يَطيرُ",18,"ر",1,0],["رُبَّ خَلقٍ في جانِبَيكَ كَريمٍ","يَتَمَشّى جَلالُه في الدودِ",19,"د",1,0],["رُبَّ خَرقٍ رُزِئتُهُ مِن بَني قَي","سٍ وَخَرقٍ رُزِئتُ مِن شَيبانِ",20,"ن",1,0],["رُبَّ خَطب بِهِ رَمَتني الأَعادي","قصرت عَنهُ أَلسُنُ الخُطَباءِ",21,"ا",2,0],["رَبِّ خُذْ من طَرفْهِ السَّحّارِ","وامتَحِنْهُ بحُرقةِ الاِنتظار",22,"ر",1,0],["رَب خَل قَد عفت لُقياهُ إِذا ضَ","جَ في وَجه ودهِ تَلوين",23,"ن",1,0],["رب خذ بالعدل قوماً","أهل ظلم متوالِ",24,"ل",1,1],["رُبَّ خِرقٍ مِثلِ الهِلالِ وَبَيضا","لَعوبٍ بالجِزعِ مِن عَمواسِ",25,"س",1,1],["رب خرقٍ خرَقتُ والل","سيلُ مُلقى الرفارف",26,"ف",1,0],["رُب خِبٍّ جائر قلت له","وَيْك أقسِطْ فتعدَّى وقسط",27,"ط",1,0],["رُبَّ خالٍ مُتَوّجٍ لي وَعَمٍّ","ماجِدٍ مُجتَدىً كَريم النِّصابِ",28,"ب",1,0],["رب خطب فصلته بخطاب","لك لم يوت حكمه داود",29,"د",1,0],["ر ب خلال كالروض غب حيا","دبج من مفرد ومزدوجِ",30,"ج",1,0],["رب خوداء قد ارتنا بليل","فلق الصبح في جلابيب سود",31,"د",1,0],["رُبَّ خَرقٍ قَد تَعَسَّف","تُ لَهُ ميلاً فَميلا",32,"ل",2,0],["رب خذ للناس من أوثانهم","فيروا وحدك رباً يعبدون",33,"ن",1,0],["رُب خَمارَةٍ سريت إِلَيها","وَالدُجى في ثِيابهِ الزُنجيه",34,"ي",2,0],["رب ! خفف عنها عناء الولادة","واجعل الخير حظها والسعادة",35,"د",2,1],["رُبَّ خَيرٍ أَتاكَ مِن","حَيثُ تَأتي المكَارِه",36,"ه",1,1],["رُبَّ خِلٍّ طَمَحَ الغَيُّ بِهِ","فَوَهَبنا اللُّؤمَ فيهِ لِلكَرَم",37,"م",1,0],["رَبَّ خُرْعُبةٍ ومُثْقَّبَة","ومُحَجَّبة بالظُبا الخُذُم",38,"م",1,0],["ربّ خصر زانه كثر الضنا","كم به أجسامنا تشكو الضنا",39,"ن",2,0],["رُبَّ خَودٍ ذاتَ دَلٍّ","وَهيَ كَالغُصنِ الوَريقِ",40,"ق",1,0],["رب خليق لمكرمات","بها سواه يكون أخلق",41,"ق",1,0],["رب خود عرفت في عرفات","سلبتني في حسنها حسناتي",42,"ت",2,1],["رب خل في صدره كل غدر","وخداع يلقاك بالترحاب",43,"ب",1,0],["رب خالٍ متى علا وردَ خدٍّ","هام روضٌ وَجنّت السوداء",44,"ا",2,0],["ربّ خير بت أجريه على","منهج الفتنة والشر العميم",45,"م",1,0],["رُبَّ خَودٍ عرفتُ في عرفات","سلبتْني بحُسنها حَسَناتي",46,"ت",2,1],["رب خودٍ تريك جسماً سميناً","تحت اضلاعه ضمير هزيل",47,"ل",1,0],["رُبَّ خِلٍّ طَرَقتُهُ لِلسَلامِ","ظَنَّ أَنّي أَتَيتُهُ لِلطَعامِ",48,"م",1,1],["رب خطبٍ إليك من بعد يسعى","قال يحكي فريام آل الخلود",49,"د",1,0],["رُبَّ خالٍ لي لو أبصرتَهُ","سَبِطَ المشيةِ أباءٌ أنف",50,"ف",1,1],["رب خيل وزعتها كالسعالي","بذنوب طوالة الأقراب",51,"ب",1,1],["رَبّ خُذني إلى حَبيبيَ وَاِشفِ","أَلَم النَفس من جَميع الخُطوبِ",52,"ب",1,0],["رب خير يولى ولا من بشير","رب شر يجزى ولا من نذير",53,"ر",1,1],["رب خذ من دمائنا ما تريد ُ","لرضاك اللهم إنا نجودُ",54,"د",1,1],["رب خذ للشعر من زمرٍ","أسمعونا منه ما أضنى",55,"ن",2,1]]}