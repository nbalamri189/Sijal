33,"أبا الجود ما ناديك بالجود معمور","https://www.aldiwan.net/poem31600.html","الطويل"],[233,"سرب مها أم دمى محاريب","https://www.aldiwan.net/poem32184.html","المنسرح"],[235,"يا دار من أهوى رعاك الله","https://www.aldiwan.net/poem19729.html","الكامل"],[244,"قالت مخافة بيننا وبكت به","https://www.aldiwan.net/poem56323.html","الكامل"],[250,"هذا هو السعي لا ما يدعي الواني","https://www.aldiwan.net/poem1430.html",""],[254,"أيها السيد الذي طاب في المجد","https://www.aldiwan.net/poem48372.html","الخفيف"],[280,"لست أسلو الشادن الأحوى الأغنا","https://www.aldiwan.net/poem32385.html","الرمل"],[280,"رموا الجمار وفي فؤادي منهم","https://www.aldiwan.net/poem32451.html","الكامل"],[295,"بكيت أسى لو رد عنك البكا حتفا","https://www.aldiwan.net/poem33216.html","الطويل"],[296,"لا هم دمعي من طول البكا نفدا","https://www.aldiwan.net/poem36823.html","عموديه"],[301,"أفدي الذي تيمني","https://www.aldiwan.net/poem57838.html","مجزوء الرجز"],[320,"بانت سليمى وأقوى بعدها تبل","https://www.aldiwan.net/poem56346.html","البسيط"],[362,"يا من رأى ظعن الحي الذي شحطا","https://www.aldiwan.net/poem60857.html","البسيط"],[362,"بيض طوالع من خيام سود","https://www.aldiwan.net/poem60954.html","الكامل"],[369,"إن الهوى المجحودا","https://www.aldiwan.net/poem57497.html","المجتث"],[377,"برق بدا جنح الدجى يتألق","https://www.aldiwan.net/poem48835.html","الكامل"],[390,"قد ظل يجرح صدري","https://www.aldiwan.net/poem53660.html","المجتث"],[403,"لو جادهن غداة رمن رواحا","https://www.aldiwan.net/poem50194.html","الكامل"],[426,"مولاي يا بحر الفضائل والندى","https://www.aldiwan.net/poem39895.html","الكامل"],[429,"قدر الأثير على الأثير علي","https://www.aldiwan.net/poem12765.html","الكامل"],[456,"أدرك ما شاء غلام فطنا","https://www.aldiwan.net/poem55840.html","الرجز"],[456,"تربعت بين العذيب فالنقا","https://www.aldiwan.net/poem56093.html","الرجز"],[456,"بكرت هيما تحل الربطا","https://www.aldiwan.net/poem56142.html","الرمل"],[456,"لمن الطلول تراقصت","https://www.aldiwan.net/poem56192.html","مجزوء الكامل"],[462,"بقبرك فلتسحب ذيول السحائب","https://www.aldiwan.net/poem3210.html","عموديه"],[466,"ما لغياث من غياث إذا","https://www.aldiwan.net/poem59780.html","السريع"],[475,"لا تخدعن فتصطفي لك صاحبا","https://www.aldiwan.net/poem15315.html","الكامل"],[502,"أفنى الضنا جسدي وابلى بالي","https://www.aldiwan.net/poem38411.html","الكامل"],[502,"حلت حين ما حلت على المصايب","https://www.aldiwan.net/poem38413.html","الطويل"],[536,"لما استقام ولم يفز بمرامه","https://www.aldiwan.net/poem48130.html","عموديه"],[556,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[558,"من يعرف الشوق ؟","https://www.aldiwan.net/poem67275.html","عموديه"],[560,"عاج المتيم بالأطلال في العلم","https://www.aldiwan.net/poem52913.html","البسيط"],[573,"جاد وما ضن عليه ضناه","https://www.aldiwan.net/poem2996.html","السريع"]],"verses":[["لَو مالَ بِالقَرنَينِ خَوفُهُما","لِلمَوتِ ما اِضطَغنا عَلى الوِترِ",0,"ر",1,0],["لوْ منكمُ كانَ فينا لمْ ينلْ ابداً","حتى تُلاقَى أُمُورٌ ذاتُ آثارِ",1,"ر",1,0],["لو مت في زمن مضى لعلمت كم","من ناظمٍ فيه وكم من ناثر",2,"ر",1,0],["لُؤمَ المَواطِنِ يا قُيونَ مُجاشِعٍ","في الناسِ أَنجَدَ خِزيُهُنَّ وَغارا",3,"ر",2,0],["لو مس تهذيبهُ أو رِفقه حجراً","مسته في حالتيهِ ألفُ سرّاء",4,"ا",2,0],["لَؤُمْتُ لَعمر اللَّه فيما أَتيتُهُ","وإن كنتُ من قومٍ كرام المناصِبِ",5,"ب",1,0],["لَؤُمَ الرجالُ فزهَّدوا ذا رغبة","وكرمت حتى استرغب الزهادُ",6,"د",1,0],["لؤْمٌ أبى لك شكْرَ ما أولاكَهُ","والشرُّ منه لنفْسِه أمْدادُ",7,"د",1,0],["لؤُمتَ فلو كنت السماء لأمسكت","حياها وأمسى جوُّها وهو أغبر",8,"ر",1,0],["لو مدحت غيركم فحولُهمُ","لقصر اللوم عن شقاشقها",9,"ق",3,0],["لو مدحناكَ بالمديح الذي قد","قيل في الناس لم يكن مسروقا",10,"ق",2,0],["لومٌ ولا لؤمٌ ولستُم بالعُجُل","ولا لنُعْمَى عن وليّ بالنُّقل",11,"ل",1,0],["لو مَسَّهُ الألمُ الذي أحذاكه","أو دونَ ذاك لما استفاقَ صليلا",12,"ل",2,0],["لُؤمتُ وللنفسِ الكريمةِ رَجعةٌ","إلى الحَمأ المسنونِ ثمَّ تُكرَّمُ",13,"م",1,0],["لو مرَّ بالأجداث آونةً","لجرتْ به الأرواحُ في الرِّممِ",14,"م",1,0],["لو مكانَ الهجاء سَدَّدَهْ نَحْ","وي توليتُ هارباً خَوْف طعْنه",15,"ن",2,0],["لو مِن ثَرىً مَزَّقتُها بِيَدِ الثَرى","لَكِنَّها سُجُفٌ مِنَ الأَضواءِ",16,"ا",2,0],["لَو مَلَكتَ الحُقولَ في الأَرضِ طُرّاً","لَم تَكُن مِن فَراشَةِ الحَقلِ أَسعَد",17,"د",1,0],["لُؤمٌ لَعَمرُ أَبيكَ لَم يَرَ مِثلَهُ","التاريخُ مُنذُ اِستَقرَأَ الأَخبارا",18,"ر",2,0],["لَو مالَ عَنكِ شِراعُها وَبُخارُها","لَم يَبقَ غَيرُ الصَيدِ وَالمُتَصَيِّدِ",19,"د",1,0],["لَؤُمَت مِنهُما الطِباعُ وَلَكِن","وَلَدُ العاصِيَينِ شَرٌّ لَآمَه",20,"م",2,0],["لَو مَدَحتُكُم زَمَني","لَم أَقُم بِما يَجِبُ",21,"ب",1,0],["لُؤمُ الحَياةِ مَشى في الناسِ قاطِبَةً","كَما مَشى آدَمٌ فيهِم وَحَوّاءُ",22,"ا",2,0],["لَو مَرَّ بِالوِلدانِ طَيفُ جَمالِها","في الخُلدِ خَرّوا رُكَّعاً وَسُجودا",23,"د",2,0],["لَو مَرَّ يَركُضُ في سُطورِ كِتابَةٍ","أَحصى بِحافِرِ مُهرِهِ ميماتِها",24,"ت",3,0],["لو ما ترى سفكه بقدرته","كان دم العالمين في عنقِهْ",25,"ق",2,0],["لَو مِنَ الغَيثِ الَّذي تَجري بِهِ","راحَتاهُ مِن عَطاءٍ لَنَفِد",26,"د",1,0],["لَؤُمَت خَلائِقُهُم فَكَذَّبَ سَعيُهُم","عَن سَعيِ فَردٍ في المَكارِمِ أَوحَدِ",27,"د",1,0],["لُؤمٌ بِنارِ الشَوقِ إِن لَم تَحتَدِم","وَخَساسَةٌ بِالدَمعِ إِن لَم يَسجُمِ",28,"م",1,0],["لو ملكنا بقيةً من إباءٍ","لانتخينا.. لكننا جبناء",29,"ا",2,0],["لَو مَرَّ عادُ بنُ شَدّادٍ بِجَنَّتِهِ","أَقامَ يَقرَعُ فيها سِنَّ مَغرورِ",30,"ر",1,0],["لَو مُتَّ لَم تَعدِل وَفاتُكَ بَغتَةً","حُلماً يُخَوِّفُني بِيَومِ فِراقِهِ",31,"ق",2,0],["لُؤمٌ تَدينُ بِحُلوِهِ وَبِمُرِّهِ","فَكَأَنَّهُ جُزءٌ مِنَ التَوحيدِ",32,"د",1,0],["لَو مَثَّلَت لَهُمُ المَنايا في الوَغى","أَقرانَهُم لَم تَلقَ مِنهُم مُدبِرا",33,"ر",2,0],["لو مُعافىً من خُطوبٍ عُوفِيَتْ","لَقْوَةٌ بينَ هِضابٍ ونُجُد",34,"د",1,0],["لوما فَلا لَومَ بَعدَها أَبَداً","صاحِبُكُم وَالجَليلِ مُحتَضَرُ",35,"ر",1,0],["لَو ما تخَيَّرَنا مَهدِيُّ أُمَّتِهِ","عَمّا يَرى وَكُماةُ الحَربِ تَطَّرِدُ",36,"د",1,0],["لَو مُتُّ ثُمَّ سَقَيتَني بِرُضابِهِ","رَجَعَت حَياةُ جَنازَتي بِرُضابِهِ",37,"ب",2,0],["لَو مُلِّكَ الشَمسَ قَومٌ قَبلَهُم مَلَكوا","شَمسَ النَهارِ وَبَدرَ اللَيلِ لا كَذِبُ",38,"ب",1,0],["لَو مُتِّ ماتَ وَلَو لَطُفتِ لَهُ","لَرَأى هَواكِ لِقَلبِهِ طَرَبا",39,"ب",2,0],["لَو ماجِدَ النَجمُ أَهلَ الأَرضِ عارَضَهُ","مِنهُم رِجالٌ فَقالوا أَنتَ مَمجودُ",40,"د",1,0],["لُؤِمَت كَرمِيَّةٌ تَشرَبُها","وَنَداماكَ حَصورٌ وَحَصِر",41,"ر",1,0],["لَو مَلَكتِ الأَراكَ أَجمَعَ وَالأَ","سحِلَ لَم تَحصَلي عَلى مِضوازِ",42,"ز",1,0],["لَو مَلَكتُ الرَحيلَ جَوَّلتُ في ال","آفاقِ حَتّى يَمَلُّني التَجويلُ",43,"ل",1,0],["لَو ماتَ لَاِستَبدَلتُ مِنهُ فَتىً","إِنّي أَراهُ مُحرِماً لا يَحِلّ",44,"ل",1,0],["لَوْمُهُ صَبّاً لدى الحِجْرِ صَبا","بِكُمُ دَلّ على حِجْرِ صُبَي",45,"ي",1,0],["لَو مَلَكنا غَيرَ المَقالِ لَجُدنا","إِنَّ جُهدَ المُقِلِّ حُسنُ المَقالِ",46,"ل",1,0],["لو مر بالولدان طيف جمالها","في الحلم في الحلم راحوا ركعاً وسجودا",47,"د",2,0],["لو مرّ سيفٌ بيننا لم نكن","نعلم هل أجرى دمي أو دمَك",48,"ك",1,0],["لوْ مَسَّ غَيْرَكَ هَذا الذُّلُّ من أسَدٍ","لَعَضَّ جِبْهَتَهُ سَيْفٌ وحَنَّاها‍",49,"ا",3,0],["لَوْ مَادَتِ الأَجْبَالُ مِنْ تَحْتِهِ","أَوْ خَرَّتِ الأفْلاَكُ ما زُعْزِعا",50,"ع",2,0],["لو مدحنا من لا يَحِقُّ له المد","حُ لوَى الشعرُ رأَسه فهجانا",51,"ن",2,0],["لو مات منهم تِسعَةٌ","لم يرهب الإِقدامَ عاشر",52,"ر",1,0],["لو مرّ سيف بيننا لم نكن","نعلم هل أجرى دمي أم دمك",53,"ك",1,0],["لو ملكنا هذي اللُّحومَ لكانت","للذُباب المنحطِّ نِعمَ الولائم",54,"م",1,0],["لؤم بعيني أن يلائمها الكرى","عن سلوة، وبمائها أن يجمدا",55,"د",2,0],["لو مدحناه بالذي ليس فيه","وقعَ المدحُ منه موقعَ قَرْفِ",56,"ف",1,0],["لَو مَسكَت المِرآة يا أَوحديٌّ","لَرَأَيتُ الجَميع في مِرآتك",57,"ك",1,0],["لَو مَرَت الريح تَروي عَن ذَوائِبِهِ","لَم يَبقَ مِن عَهد عادَ ثَمَّ مَلحود",58,"د",1,0],["لو مس وجهي بثرى بابه","وذا هو المأمول والمقصد",59,"د",1,0],["لو مَلكنا الأرضَ أو لو أطقنا","لسَددنا برُباها الخَصاصا",60,"ص",2,0],["لَو مَيَّزَتكَ سَجيَّةٌ عَن ضِدِّها","لَعَلِمتُ ما آتي وَما أَتَجَنَّبُ",61,"ب",1,0],["لَوْ مَرَّ لي نَفَسٌ بالنَّارِ أَحْرَقَها","بِحَرِّهِ ولو أَنَّ النَّارَ مِنْ بَعَدِ",62,"د",1,1],["لو مازج البحر الاجاج بعضها","لصار عذبا طعم ماء البحر",63,"ر",1,0],["لَو مُثِّلَ الحَتفُ لَهُ قِرناً لَما","صَدَّتهُ عَنهُ هَيبَةٌ وَلا اِنثَنى",64,"ا",1,0],["لو مَرَّ بالكِنْدِىِّ أَيْسَرُ لفظةٍ","من شِعْره لَثم التراب ببابه",65,"ب",2,0],["لو مَلك الدنيا امرؤ جاهلٌ","لكان ممن فاته الحظ",66,"ظ",1,0],["لو مرَّ بالظبياتِ لاستأنستْ","وجداً بمثلِ الرشإ النافرِ",67,"ر",1,0],["لو مات كان الموتُ أيسرَ عنده","مما يكابد في الهوى ويقاسي",68,"س",2,0],["لو مسَّ ذا سَقَمٌ قامت قيامتُه","لعِلمه أنَّ مَن يهواه قد سقما",69,"م",2,0],["لو مات من مات حقاً لا نقضى أثرٌ","لذاهب لم يعش إلا بجثمان",70,"ن",1,0],["لو مَلَكنا شَيئا أَشَدُّ من القَت","لِ جَزاءً لَنِلتَه من جَزاءِ",71,"ا",2,0],["لو مرَّ يخطو في الكثيب الأعفرِ","وهْو شديد العَدْو لم يؤثّر",72,"ر",1,0],["لومُ لئيم كلّما اشتدّ خابْ","والشَّوقُ لا يُصْغِي لبعض العِتاب",73,"ب",1,1],["لَؤُمتَ فَلا مَن ظَلَّ يَهجوكَ في الوَرى","مَلومٌ وَلا مَن باتَ يَرجوكَ مَعذورُ",74,"ر",1,0],["لَومُكَ لِلصَبِّ في مُعَذَّبِهِ","سَوطُ عَذابٍ عَلَيهِ مَصبوبِ",75,"ب",1,0],["لَوْ مَا الذِي أَرْجُوهُ مِنْ جَمْعٍ عَلَى","دَعَةٍ قَضَيْتُ كَآبَةً لَوْمَاهُ",76,"ا",2,0],["لو ماتَ شيءٌ من مخافةِ فُرقةٍ","لأماتَني للبين طولُ تخوفي",77,"ي",1,0],["لَو مُدىً في مَداها غَيرُ هيِّنَةٍ","ِذا لَنالَ المَعالي كُلُّ اِنسانِ",78,"ن",1,0],["لو مشى بي الشيخ الفرق لسابقت","ك سيراً إلى الوداع ذميلاً",79,"ل",2,0],["لَومُهُ أَعدى كِراماً فَغَدَوا","في نَداهُم يُخلفونَ الظَنَّ ضَنّا",80,"ن",2,0],["لَو مُلِّكَ الدُّنيا لَجادَ بِها عَلى","مَن يَعتَفيهِ مُبادِراً لا يَندَمُ",81,"م",1,0],["لؤمتُ إِذا لَم أسقكَ الدمعَ هاطِلاً","وأَصبحت أَستَسقي لك الديمَ الوطفا",82,"ف",2,0],["لؤمٌ بمنْ لا يريق الدمعَ تكرمةً","لمن أريقتْ دِماهم للبلادِ فدا",83,"د",2,0],["لو مت وهو حاضري","عشت إذا قبلني",84,"ي",1,0],["لَو ماتَ حَيٌّ مِن الأَطلالِ تَقتُلُهُ","إِذَن لَمِتُّ وَعَيني دَمعُها سَبَلُ",85,"ل",1,0],["لُوموا على ذاك أو كُفّوا لشأْنِكم","بَرْحُ الفِراقِ على بَرْحِ المَلامِ غِطا",86,"ط",2,0],["لو مُزِّقَتْ لرقَعْنَها بذَوائبٍ","أو قُوَضَتْ لدعَمْنَها بقُدود",87,"د",1,0],["لو مُنِّيت لتمنَّت","أن تستطيعَ مَزيدا",88,"د",2,0],["لَو مَسَ أَخمَص نَعلِهِ صَم الحَصى","لَغَدَت تَرف مَع النَبات وَتَورقُ",89,"ق",1,0],["لَو مُلِّكَتهُ ظَلومٌ","حَلتهُ في عِقدِ نَحر",90,"ر",1,0],["لَو مَسَّ مِن إِقبالِهِ حَجَراً جَرى","ماءً عَلى ظَهرِ الثَرى طَفّاحا",91,"ح",2,0],["لو ماج بحرٌ واحدٌ ما خفتهُ","لكنما يتموج البحرانِ",92,"ن",1,0],["لو ملّك اللهُ المسيحَ مِثالَها","لأطاعه الإنسيُّ والجِنيُّ",93,"ي",1,0],["لو مسَح الجوَّ ببطن كفّهِ","قائلُها كنتُ بذاك قَمِنا",94,"ن",2,0],["لو ما رميتُ الحجرَ الصلدَ بها","أخدعه عَمايةً لانفلقا",95,"ق",2,0],["لو مشى حولاً على شوك القنا","ورأى الضيم قَعوداً ما امتطى",96,"ط",2,0],["لو ما تقدّم عصرُها","وتردَّدتْ أدوارُها",97,"ر",3,0],["لوم زماناً ليس يحنو للائم","وأعتب دهراً لا يميل لعاتب",98,"ب",1,0],["لَو ماتَ لي أَلفٌ وَأَبصَرتُهُ","لَبُلتُ في ثَوبي مِنَ الضَحِكِ",99,"ك",1,0],["لَؤمَتْ مغارسُ أصلِه فتكدَّرتْ","نُطَفُ الاِخاءِ بمثلِه وتكدَّرا",100,"ر",2,0],["لوم العواذل لا يضر صبابتي","شرف العلى بمصايب الاهوالي",101,"ل",2,0],["لومونني في العشق لكن لدى الذكا","معايب أفعال المحب مناقب",102,"ب",1,0],["لَؤمُوا وإن جادَ الزَّمانُ بِفاضِلٍ","إنكَارُ فَضلِه ماله إنكارُ",103,"ر",1,0],["لُ ومَلَّ الحادي وتاه الدليلُ","هيَّ بي يا محبهم نحوهم هيّْ",104,"ي",1,0],["لو مسنا من ضيمه قُرَحٌ","ما مسّه من ضيمنا قَرْحُ",105,"ح",1,0],["لو مَرَّ من قَمَرٍ شهرٌ ولم أرَهُ","لم ألقَهُ بعدَها إلاّ بِطَرْفِ عَمِي",106,"م",2,0],["لو مدَّ صَرْف الدَّهر نَحْوي يداً","واحدةً منه لشُلَّت يداه",107,"ا",2,0]]}