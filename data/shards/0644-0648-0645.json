{"poems":[[53,"أوما رأيت وقائع الدهر","https://www.aldiwan.net/poem30444.html","الكامل"],[10,"يا عين فيضي بدمع منك مغزار","https://www.aldiwan.net/poem20941.html","عموديه"],[93,"كم فاض في أثر الهلال العاثر","https://www.aldiwan.net/poem9848.html","الكامل"],[27,"ما بال نومك بالفراش غرارا","https://www.aldiwan.net/poem5750.html","الكامل"],[72,"ليلاي كم ليلة بالشعر ليلاء","https://www.aldiwan.net/poem18172.html","البسيط"],[51,"دع اللوم إن اللوم عون النوائب","https://www.aldiwan.net/poem8312.html","الطويل"],[51,"أنى تماطلني وأنت جواد","https://www.aldiwan.net/poem61868.html","الكامل"],[51,"يا ابن المدبر غرني الرواد","https://www.aldiwan.net/poem61893.html","الكامل"],[51,"ثنى شوقه والمرء يصحو ويسكر","https://www.aldiwan.net/poem63015.html","الطويل"],[51,"يا نجدة الروم في بطارقها","https://www.aldiwan.net/poem65502.html","المنسرح"],[51,"لم يزل قلبه إليهم مشوقا","https://www.aldiwan.net/poem65527.html","الخفيف"],[51,"يا رجلا أوفى على كل رجل","https://www.aldiwan.net/poem65868.html","الرجز"],[51,"ما استشرفت منك العيون ضئيلا","https://www.aldiwan.net/poem65928.html","الكامل"],[51,"ندمت على أن كنت يوما دعوتني","https://www.aldiwan.net/poem66019.html","الطويل"],[51,"ضحك الربيع إلى بكا الديم","https://www.aldiwan.net/poem66296.html","أحذ الكامل"],[51,"طلب البيهقي قرنا فلم يحرمه","https://www.aldiwan.net/poem66478.html","البسيط"],[91,"روحي التي بالأمس كانت ترتع","https://www.aldiwan.net/poem8723.html","عموديه"],[91,"نسي الطين ساعة أنه طين","https://www.aldiwan.net/poem8817.html","عموديه"],[91,"ما بالهم نقضوا العهود جهارا","https://www.aldiwan.net/poem8862.html","عموديه"],[85,"أمس انقضى واليوم مرقاة الغد","https://www.aldiwan.net/poem8102.html","الكامل"],[85,"قف بطوكيو وطف على يوكاهامه","https://www.aldiwan.net/poem63698.html","الخفيف"],[85,"حف كأسها الحبب","https://www.aldiwan.net/poem63726.html","المقتضب"],[85,"أعلى الممالك ما كرسيه الماء","https://www.aldiwan.net/poem63727.html","الكامل"],[85,"بأبي وروحي الناعمات الغيدا","https://www.aldiwan.net/poem63773.html","الكامل"],[43,"سرب محاسنه حرمت ذواتها","https://www.aldiwan.net/poem9518.html","الكامل"],[43,"شغلي عن الربع أن أسائله","https://www.aldiwan.net/poem10614.html","المنسرح"],[45,"جائر في الحكم لو شاء قصد","https://www.aldiwan.net/poem63483.html","الطويل"],[45,"ما يستفيق دد لقلبك من دد","https://www.aldiwan.net/poem63490.html","البسيط"],[45,"هذي المعاهد من سعاد فسلم","https://www.aldiwan.net/poem66637.html","البسيط"],[99,"إفادة في محكمة الشعر","https://www.aldiwan.net/poem6630.html","عموديه"],[66,"من نفخة الصور أم من نفحة الصور","https://www.aldiwan.net/poem41361.html","البسيط"],[44,"وأخ بشعت بعرفه ومذاقه","https://www.aldiwan.net/poem29714.html","الكامل"],[44,"عياش يا ذا البخل والتصريد","https://www.aldiwan.net/poem30051.html","الكامل"],[81,"ذد عن موارد أدمعي طير الكرى","https://www.aldiwan.net/poem61523.html","الكامل"],[75,"وهب الدهر نفيسا فاسترد","https://www.aldiwan.net/poem69086.html","الطويل"],[50,"قد لامني في خليلتي عمر","https://www.aldiwan.net/poem63825.html","المنسرح"],[50,"أقوى وعطل من فراطة الثمد","https://www.aldiwan.net/poem63936.html","البسيط"],[50,"ما رد سلوته إلى إطرابه","https://www.aldiwan.net/poem64822.html","الكامل"],[50,"تأبدت برقة الروحاء فاللبب","https://www.aldiwan.net/poem64839.html","البسيط"],[50,"طرب الحمام فهاج لي طربا","https://www.aldiwan.net/poem64861.html","الكامل"],[46,"إن جاد بالمال سمح يبتغي شرفا","https://www.aldiwan.net/poem22390.html","البسيط"],[46,"قصر اليوم بكأس كاس من","https://www.aldiwan.net/poem22741.html","الرمل"],[46,"صنعة عزت الأنام بلطف","https://www.aldiwan.net/poem22771.html","الخفيف"],[46,"وفر هذا الفتى مديد بسيط","https://www.aldiwan.net/poem23155.html","الخفيف"],[46,"أشهد أني رجل ناقص","https://www.aldiwan.net/poem23271.html","السريع"],[68,"سائق الأظعان يطوي البيد طي","https://www.aldiwan.net/poem1535.html",""],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20251","الخفيف"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202641","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142050","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141930","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54249","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54252","الخفيف"],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[98,"قبلات الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=55307",""],[90,"الشاعر الجبَار","https://www.poetsgate.com/ViewPoem.aspx?id=179153",""],[45,"هل أنت مصطبر على مضض الأسى","https://www.poetsgate.com/ViewPoem.aspx?id=31300",""],[51,"وبديعٍ من البدائع يَسْبي","https://www.poetsgate.com/ViewPoem.aspx?id=29591",""]],"verses":[["لَو مالَ بِالقَرنَينِ خَوفُهُما","لِلمَوتِ ما اِضطَغنا عَلى الوِترِ",0,"ر",1,0],["لوْ منكمُ كانَ فينا لمْ ينلْ ابداً","حتى تُلاقَى أُمُورٌ ذاتُ آثارِ",1,"ر",1,0],["لو مت في زمن مضى لعلمت كم","من ناظمٍ فيه وكم من ناثر",2,"ر",1,0],["لُؤمَ المَواطِنِ يا قُيونَ مُجاشِعٍ","في الناسِ أَنجَدَ خِزيُهُنَّ وَغارا",3,"ر",2,0],["لو مس تهذيبهُ أو رِفقه حجراً","مسته في حالتيهِ ألفُ سرّاء",4,"ا",2,0],["لَؤُمْتُ لَعمر اللَّه فيما أَتيتُهُ","وإن كنتُ من قومٍ كرام المناصِبِ",5,"ب",1,0],["لَؤُمَ الرجالُ فزهَّدوا ذا رغبة","وكرمت حتى استرغب الزهادُ",6,"د",1,0],["لؤْمٌ أبى لك شكْرَ ما أولاكَهُ","والشرُّ منه لنفْسِه أمْدادُ",7,"د",1,0],["لؤُمتَ فلو كنت السماء لأمسكت","حياها وأمسى جوُّها وهو أغبر",8,"ر",1,0],["لو مدحت غيركم فحولُهمُ","لقصر اللوم عن شقاشقها",9,"ق",3,0],["لو مدحناكَ بالمديح الذي قد","قيل في الناس لم يكن مسروقا",10,"ق",2,0],["لومٌ ولا لؤمٌ ولستُم بالعُجُل","ولا لنُعْمَى عن وليّ بالنُّقل",11,"ل",1,0],["لو مَسَّهُ الألمُ الذي أحذاكه","أو دونَ ذاك لما استفاقَ صليلا",12,"ل",2,0],["لُؤمتُ وللنفسِ الكريمةِ رَجعةٌ","إلى الحَمأ المسنونِ ثمَّ تُكرَّمُ",13,"م",1,0],["لو مرَّ بالأجداث آونةً","لجرتْ به الأرواحُ في الرِّممِ",14,"م",1,0],["لو مكانَ الهجاء سَدَّدَهْ نَحْ","وي توليتُ هارباً خَوْف طعْنه",15,"ن",2,0],["لو مِن ثَرىً مَزَّقتُها بِيَدِ الثَرى","لَكِنَّها سُجُفٌ مِنَ الأَضواءِ",16,"ا",2,0],["لَو مَلَكتَ الحُقولَ في الأَرضِ طُرّاً","لَم تَكُن مِن فَراشَةِ الحَقلِ أَسعَد",17,"د",1,0],["لُؤمٌ لَعَمرُ أَبيكَ لَم يَرَ مِثلَهُ","التاريخُ مُنذُ اِستَقرَأَ الأَخبارا",18,"ر",2,0],["لَو مالَ عَنكِ شِراعُها وَبُخارُها","لَم يَبقَ غَيرُ الصَيدِ وَالمُتَصَيِّدِ",19,"د",1,0],["لَؤُمَت مِنهُما الطِباعُ وَلَكِن","وَلَدُ العاصِيَينِ شَرٌّ لَآمَه",20,"م",2,0],["لَو مَدَحتُكُم زَمَني","لَم أَقُم بِما يَجِبُ",21,"ب",1,0],["لُؤمُ الحَياةِ مَشى في الناسِ قاطِبَةً","كَما مَشى آدَمٌ فيهِم وَحَوّاءُ",22,"ا",2,0],["لَو مَرَّ بِالوِلدانِ طَيفُ جَمالِها","في الخُلدِ خَرّوا رُكَّعاً وَسُجودا",23,"د",2,0],["لَو مَرَّ يَركُضُ في سُطورِ كِتابَةٍ","أَحصى بِحافِرِ مُهرِهِ ميماتِها",24,"ت",3,0],["لو ما ترى سفكه بقدرته","كان دم العالمين في عنقِهْ",25,"ق",2,0],["لَو مِنَ الغَيثِ الَّذي تَجري بِهِ","راحَتاهُ مِن عَطاءٍ لَنَفِد",26,"د",1,0],["لَؤُمَت خَلائِقُهُم فَكَذَّبَ سَعيُهُم","عَن سَعيِ فَردٍ في المَكارِمِ أَوحَدِ",27,"د",1,0],["لُؤمٌ بِنارِ الشَوقِ إِن لَم تَحتَدِم","وَخَساسَةٌ بِالدَمعِ إِن لَم يَسجُمِ",28,"م",1,0],["لو ملكنا بقيةً من إباءٍ","لانتخينا.. لكننا جبناء",29,"ا",2,0],["لَو مَرَّ عادُ بنُ شَدّادٍ بِجَنَّتِهِ","أَقامَ يَقرَعُ فيها سِنَّ مَغرورِ",30,"ر",1,0],["لَو مُتَّ لَم تَعدِل وَفاتُكَ بَغتَةً","حُلماً يُخَوِّفُني بِيَومِ فِراقِهِ",31,"ق",2,0],["لُؤمٌ تَدينُ بِحُلوِهِ وَبِمُرِّهِ","فَكَأَنَّهُ جُزءٌ مِنَ التَوحيدِ",32,"د",1,0],["لَو مَثَّلَت لَهُمُ المَنايا في الوَغى","أَقرانَهُم لَم تَلقَ مِنهُم مُدبِرا",33,"ر",2,0],["لو مُعافىً من خُطوبٍ عُوفِيَتْ","لَقْوَةٌ بينَ هِضابٍ ونُجُد",34,"د",1,0],["لوما فَلا لَومَ بَعدَها أَبَداً","صاحِبُكُم وَالجَليلِ مُحتَضَرُ",35,"ر",1,0],["لَو ما تخَيَّرَنا مَهدِيُّ أُمَّتِهِ","عَمّا يَرى وَكُماةُ الحَربِ تَطَّرِدُ",36,"د",1,0],["لَو مُتُّ ثُمَّ سَقَيتَني بِرُضابِهِ","رَجَعَت حَياةُ جَنازَتي بِرُضابِهِ",37,"ب",2,0],["لَو مُلِّكَ الشَمسَ قَومٌ قَبلَهُم مَلَكوا","شَمسَ النَهارِ وَبَدرَ اللَيلِ لا كَذِبُ",38,"ب",1,0],["لَو مُتِّ ماتَ وَلَو لَطُفتِ لَهُ","لَرَأى هَواكِ لِقَلبِهِ طَرَبا",39,"ب",2,0],["لَو ماجِدَ النَجمُ أَهلَ الأَرضِ عارَضَهُ","مِنهُم رِجالٌ فَقالوا أَنتَ مَمجودُ",40,"د",1,0],["لُؤِمَت كَرمِيَّةٌ تَشرَبُها","وَنَداماكَ حَصورٌ وَحَصِر",41,"ر",1,0],["لَو مَلَكتِ الأَراكَ أَجمَعَ وَالأَ","سحِلَ لَم تَحصَلي عَلى مِضوازِ",42,"ز",1,0],["لَو مَلَكتُ الرَحيلَ جَوَّلتُ في ال","آفاقِ حَتّى يَمَلُّني التَجويلُ",43,"ل",1,0],["لَو ماتَ لَاِستَبدَلتُ مِنهُ فَتىً","إِنّي أَراهُ مُحرِماً لا يَحِلّ",44,"ل",1,0],["لَوْمُهُ صَبّاً لدى الحِجْرِ صَبا","بِكُمُ دَلّ على حِجْرِ صُبَي",45,"ي",1,0],["لَو مَلَكنا غَيرَ المَقالِ لَجُدنا","إِنَّ جُهدَ المُقِلِّ حُسنُ المَقالِ",46,"ل",1,0],["لو مر بالولدان طيف جمالها","في الحلم في الحلم راحوا ركعاً وسجودا",47,"د",2,0],["لو مرّ سيفٌ بيننا لم نكن","نعلم هل أجرى دمي أو دمَك",48,"ك",1,0],["لوْ مَسَّ غَيْرَكَ هَذا الذُّلُّ من أسَدٍ","لَعَضَّ جِبْهَتَهُ سَيْفٌ وحَنَّاها‍",49,"ا",3,0],["لَوْ مَادَتِ الأَجْبَالُ مِنْ تَحْتِهِ","أَوْ خَرَّتِ الأفْلاَكُ ما زُعْزِعا",50,"ع",2,0],["لو مدحنا من لا يَحِقُّ له المد","حُ لوَى الشعرُ رأَسه فهجانا",51,"ن",2,0],["لو مات منهم تِسعَةٌ","لم يرهب الإِقدامَ عاشر",52,"ر",1,0],["لو مرّ سيف بيننا لم نكن","نعلم هل أجرى دمي أم دمك",53,"ك",1,0],["لو ملكنا هذي اللُّحومَ لكانت","للذُباب المنحطِّ نِعمَ الولائم",54,"م",1,0],["لؤم بعيني أن يلائمها الكرى","عن سلوة، وبمائها أن يجمدا",55,"د",2,0],["لو مدحناه بالذي ليس فيه","وقعَ المدحُ منه موقعَ قَرْفِ",56,"ف",1,0]]}