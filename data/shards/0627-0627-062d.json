ps://poetry.dctabudhabi.ae/diwan/poem/116053","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141684","الطويل"],[4701,"رام الله","https://www.poetsgate.com/ViewPoem.aspx?id=176659",""],[4755,"تَقُولُ الليالي الطِوَالْ:","https://www.poetsgate.com/ViewPoem.aspx?id=183545",""],[4797,"أشوفك في خيالي قبل أشوفك والقدر جابك","https://www.poetsgate.com/ViewPoem.aspx?id=174648",""],[4858,"قلبٌ بين نارَين","https://www.poetsgate.com/ViewPoem.aspx?id=138782",""],[4119,"لكم من فؤادي ما اباحكم الوجد","https://www.poetsgate.com/ViewPoem.aspx?id=16112",""],[4045,"أأحزنك الأولى ردّوا","https://www.poetsgate.com/ViewPoem.aspx?id=200274",""],[308,"هَل الْبَرْق قد وشى مطارف ديجور","https://www.poetsgate.com/ViewPoem.aspx?id=189361",""],[5362,"أأحمد يابن خير الخلق طرا","https://www.poetsgate.com/ViewPoem.aspx?id=170335",""],[5431,"العالم القلق","https://www.poetsgate.com/ViewPoem.aspx?id=182973",""],[5442,"لعل حداة العيش أن يترفقوا","https://www.poetsgate.com/ViewPoem.aspx?id=114754",""],[5442,"إذا البرق من تلقاء كاظمة عنا","https://www.poetsgate.com/ViewPoem.aspx?id=114776",""],[5484,"تباريح الجوى","https://www.poetsgate.com/ViewPoem.aspx?id=206307",""],[5790,"لك الله من برقٍ أعان متيما","https://www.poetsgate.com/ViewPoem.aspx?id=112134",""],[5790,"غرامي إليكم ما عليه مزيد","https://www.poetsgate.com/ViewPoem.aspx?id=111993",""],[469,"محيّكِ أحيا الوجدَ بل اتلفَ الصبّا","https://www.poetsgate.com/ViewPoem.aspx?id=76783",""],[5829,"وليس لعاشق عنها حياد","https://www.poetsgate.com/ViewPoem.aspx?id=204665",""],[5840,"أأحبابنا من بالقطيعة أغراكم","https://www.poetsgate.com/ViewPoem.aspx?id=181435",""],[6031,"هَتَفَتْ بِدَمْعِ العَينِ وَهْي سَجُومُ","https://www.poetsgate.com/ViewPoem.aspx?id=46292",""],[6031,"أأحْبَابَنَا إنْ أجمَعَ البُعْدُ بَعدَكُمْ","https://www.poetsgate.com/ViewPoem.aspx?id=46386",""],[6047,"أأحبابنا إن خلف البين بعدكم","https://www.poetsgate.com/ViewPoem.aspx?id=182571",""],[6069,"أبت عبرات العين بعدك أن ترقا","https://www.poetsgate.com/ViewPoem.aspx?id=105692",""],[6097,"وتزعم أنني أنسى!","https://www.poetsgate.com/ViewPoem.aspx?id=197433",""],[520,"لكم من ودادي ناصر ليس يخذل","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577593",""],[520,"أأحبابنا كم تبخلون وكم نسخوا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577467",""],[242,"سلام عليكم والحوادث الوان","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563731",""],[5957,"أأحببت غيري!؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82406&r=&rc=41",""],[6229,"قلادة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65192&r=&rc=17",""],[4222,"أأحبابنا من بعدنا كيف أنتم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52890&r=&rc=182",""],[4222,"بين أمر حلاوة العيش الشهي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52919&r=&rc=211",""]],"verses":[["أأحْلاهُما في صَفَعةِ الليلِ مَنْظَراً","أمَيمَةُ أم رأْيُ المُحِبِّ فلا أدري",0,"ر",2,0],["أأحْمَدُ إنْ جلَّ الذي بي مِن الجَوى","وأصبَحْتُ ما لي في هَواكَ نصيرُ",1,"ر",1,0],["أَأَحبابَنا لا أَسأَلُ الطَيفَ زَورَةً","وَهَيهاتَ أَينَ الديلَمياتُ مِن عَدَن",2,"ن",1,0],["أَأَحبابِنا أَلوَت بِحادِثِ عَهدِنا","حَوادِثُ لاعَقدٌ عَلَيها وَلا شَرطُ",3,"ط",1,0],["أَأَحِلفُ لا أَنسى وَإِن شَطَّتِ النَوى","ذَواتِ الثَنايا الغُرِّ وَالأعيُنِ النُجلا",4,"ل",2,1],["أأحبابنا أعدَا تغير عهدكم","دموعي فأمست مثلكم ذات ألوان",5,"ن",1,0],["أأحبابنا داركم والعيش نعمان","والسفح دمعي ودار القلب حران",6,"ن",1,1],["أأحييتَني بالأمس ثم تُميتني","برفضي وإقصائي وحقِّيَ أن أُدْنَى",7,"ن",2,0],["أَأُحب قوماً لم يحبوا ربهم","إلا لفردوسٍ لديه ونار",8,"ر",1,0],["أأحمد لا والله لا ذقت فيشتي","فإن شئت فانسبني إلى الخنث أو دعِ",9,"ع",1,1],["أأحمدُ نفسي أن تُطيبَ لك الثَّنا","وأنت الذي تذكو وأنت الذي تزكو",10,"ك",2,0],["أَأَحبابَنا إِنّي ضَنينٌ بِوُدِّكُم","وَما كُنتُ يَوماً قَبلَهُ بِضَنينِ",11,"ن",1,0],["أَأَحبابَنا هَذا الضَنى قَد أَلِفتَهُ","فَلَو زالَ لَاستَوحَشتُ حينَ يَزولُ",12,"ل",1,0],["أَأَحبابَنا ما ذا الرَحيلُ الَّذي دَنا","لَقَد كُنتُ مِنهُ دائِماً أَتَخَوَّفُ",13,"ف",1,1],["أَأَحبابَنا إِنّي عَلى القُربِ وَالنَوى","أَحِنُّ إِلَيكُم حَيثُ كُنتُم وَأَعطِفُ",13,"ف",1,0],["أَأَحبابِنا أَمّا غَرامِيَ بَعدُكُم","فَقَد زادَ عَمّا تَعرِفونَ وَأَعرِفُ",14,"ف",1,0],["أَأَحبابَنا هَل ذَلِكَ العَيشُ عائِدٌ","كَما كانَ إِذ أَنتُم وَنَحنُ جَميعُ",15,"ع",1,0],["أَأَحبابَنا بِالرَغمِ مِنّي فِراقُكُم","وَيا طولَ شَوقي نَحوَكُم وَوَلوعي",16,"ع",2,1],["أَأَحبابَنا لَم أَنسَكُم وَحَياتِكُم","وَما كانَ عِندي وُدُّكُم بِمُضَيَّعِ",17,"ع",1,0],["أَأَحبابَنا حاشاكُمُ مِن عِيادَةٍ","فَذَلِكَ أَمرٌ في القُلوبِ مَضيضُ",18,"ض",1,1],["أَأَحبابَنا بِاللَهِ كَيفَ تَغَيَّرَت","خَلائِقُ غُرٌّ فيكُمُ وَغَرائِزُ",19,"ز",1,1],["أَأَحبابَنا أَينَ الَّذي كانَ بَينَنا","وَأَينَ الَّذي أَسلَفتُمُ مِن مَواعِدِ",20,"د",1,0],["أَأَحبابَنا إِنَّ المَشيبَ لَشارِعٌ","لَيَنسَخَ أَحكامَ الصَبابَةِ وَالصِبا",21,"ب",2,0],["أَأُحِبُّهُ وَأُحِبُّ فيهِ مَلامَةً","إِنَّ المَلامَةَ فيهِ مِن أَعدائِهِ",22,"ا",3,0],["أَأَحزَمَ ذي لُبٍّ وَأَكرَمَ ذي يَدٍ","وَأَشجَعَ ذي قَلبٍ وَأَرحَمَ ذي كِبدِ",23,"د",1,0],["أأحسبُ العسرَ جاراً لا يُفارقُني","وضامنُ اليُسْرِ عندي غيرُ متَّهَمِ",24,"م",1,0],["أَأَحبابَنا قَد أَنجَزَ البَينُ وَعدَهُ","وَشيكاً وَلَم يُنجَز لَنا مِنكُمُ وَعدُ",25,"د",1,0],["أَأَحمَدُ هَل لِأَعيُنِنا اِتِّصالٌ","بِوَجهٍ مِنكَ أَبيَضَ حارِثِيِّ",26,"ي",1,1],["أأحمدُ إني بينَ قومً تبرَّؤُوا","من العُرْفِ حتَّى قد حَسِبناهُ مُنكَرا",27,"ر",2,0],["أَأَحمَدُ إِنَّ الحاسِدينَ كَثيرُ","وَما لَكَ إِن عُدَّ الكِرامُ نَظيرُ",28,"ر",1,1],["أَأَحمَدَ إِنَّ الحاسِدينَ حُشودُ","وَإِنَّ مَصابَ المُزنِ حَيثُ تُريدُ",29,"د",1,1],["أأحمدَ فاضلٍ وأجلَّ صدرٍ","وأسعدَ كاتبٍ وأعزَّ ماحِ",30,"ح",1,0],["أَأَحبابَنا بِالعَدوَتَينِ صَمَمتُمُ","بِحُكمِ اللَيالي أَن تُجيبوا المُنادِيا",31,"ي",2,0],["أَأَحبَبتُ لَيلى جِهدَ حُبِّكِ كُلَّهُ","لِعَمرِ أَبي لَيلى وَزِدتَ عَلى الجَهدِ",32,"د",1,0],["أأحمدُ هل رأيتَ الموتَ إلا","أحقَّ الطّبِ بالمرضى رِحابا",33,"ب",2,0],["أَأَحرارٌ نُجاهِدُ أَم تِجارٌ","وَهَل في مِصرَ بيعٌ أَو شِراءُ",34,"ا",2,0],["أَأُحيطَ بِالمُلكِ الكبيرِ كَما يَرى","أَم ما تَراهُ العينُ مِن أَحلامِهِ",35,"م",2,0],["أَأُحرَجُ بالرَحمنِ إِن كُنتَ مُسلِماً","كَلامِيَ فاقعُد ما بَدا لَكَ أَو قُمِ",36,"م",1,0],["أَأُحِبُّهُ وَأَمَلُّ مِن ذِكرِي لَهُ","ليسَ المُحِبُّ لِمَنْ يُحِبُّ مَلُولا",37,"ل",2,0],["أَأَحزَنَكَ الأُلى ظَعَنوا فَساروا","أَجَل فَالنَومُ بَعدَهُمُ غِرارُ",38,"ر",1,1],["أَأُحرَمُ منكَ الرِّضا","وتَذْكُرُ ما قد مَضى",39,"ض",2,1],["أَأَحكم بين المدعين بباطل","فأَحمل أَوزاراً ينوء بها ظهري",40,"ر",2,0],["أأحمد اليوم تلاه الدُّجى","أم أحمد الليل تلاه النهار",41,"ر",1,0],["أَإِحْدَى بَنِي عَبْسٍ ذَكَرْتَ ودُونَهَا","سَنِيحٌ ومِنْ رَمْلِ البَعُوضَةِ مَنْكِبُ",42,"ب",1,0],["أَأَحْيَا بَعْدَ أَنْ رُضَّتْ حَصَاتِي","وَعَمَّتْ مَا يحِيْطُ بِي الشُّرُورُ",43,"ر",1,0],["أَأَحبابَنا حَتّى مَتى وَإِلى مَتى","أُعَرِّضُ بِالشَكوى لَكُم وَأُصَرِّحُ",44,"ح",1,0],["أأحملُ السحر إلى بابلٍ","واسكبُ العطرَ على الياسمين",45,"ن",1,0],["أَأَحسب لي مَعنى وَإِن كُنتُ واحِداً","شَأى القَومَ في آدابِهِ وَتَفَذَّذا",46,"ذ",2,0],["أَأَحمدُ أين الأمْسُ والأمسُ لم يَعُدْ","سِوىَ ذِكرياتٍ للخيال المُؤَرِّقِ",47,"ق",1,0],["أَأَحْمَدُ إِنْ تَمْرُرْ بِوَالي فَحَيِّه","وَبَلِّغْه أَشْوَاقَ الفُؤادِ المُحَرَّقِ",47,"ق",1,0],["أأحاسب امرأة على نسيانها","ومتى استقام مع النساء حساب",48,"ب",1,0],["أأحيا كسير النفس والسيف عانيا","وسيف الأباضيين في الخصم شارع",49,"ع",1,0],["أأحمد إن جل الذي بي من الهوى","وأصبحت مالي في هواك نصير",50,"ر",1,0],["أأحبابنا ماذا التغير لا الهوى","بصاف ولا تلك الوجوه صباح",51,"ح",1,0],["أ\"أحمدُ \" م أبْثَثَتُكَ الهمَّ والجوى","مكاشفةً إلا لأنك \" عارفُ \"",52,"ف",1,1],["أأحمد إنّي ناصحٌ لكَ مُشْفِقٌ","ألا فاستمعْ قولَ الشفيقِ المُعَلّمِ",53,"م",1,0],["أأحبابنا منكم حياةٌ لنا الوصلُ","وساداتنا منكم ممات لنا المَطْلُ",54,"ل",1,1],["أاحرم ورد جودك وهو غيث","يعطل عنده الغيث الهتون",55,"ن",1,0],["أأحبابنا ما أوحش الأرض بعدكم","علينا لقد ضاقت بأربابها السبل",56,"ل",1,0],["أَأَحبابنا هَل أَورق الرَّندُ بِعدَنا","وَهَل أَفرَشَتْكُم رَوضة البان مقعَدا",57,"د",2,0],["أأحبابَنا بالثَّغْرِ ما كانَ من بَعْدِي","تُراكم وإنْ طالَ البعادُ على العَهْدِ",58,"د",1,1],["أأحبابنا بالثغرِ إني وإنْ نأتْ","بيَ الدارُ عنكم ما استحلْتُ عن العهدِ",59,"د",1,1],["أأحبابنا هل الليالي التي مضت","لنا قبل رَوْعاتِ الفِراقِ مَعاد",60,"د",1,1],["أأَحْبابَنا هل لي إلى ما عَهِدتُم","من العيش فيكم مثلَ ما كنتُ مَطْمَعُ",61,"ع",1,1],["أَأَحبابَنا ما خنتُ عهدكم قطُّ","فهَل بعدَ هذا القبضِ يحصل لي بسطُ",62,"ط",1,1],["أأحْقِنُ دمعي لا أُريقُ غمامةً","وفي الحَلْي ساجي الطرفِ للدم سافكُ",63,"ك",1,0],["أأحمدُ لِم تخلِف فإنك خائفٌ","ولن يُعذر الغدّارُ إلا ليُخلِفا",64,"ف",2,0],["أأحبابنا صدوا ورقوا وأعرضوا","وجودوا وجوروا واعذلوا وتحكموا",65,"م",3,0],["أأحبابنا ليت الذي بيننا سعى","والقى حديث الزور يلقى الذي القى",66,"ق",2,0],["أأحبابنا يكفي من الدمع ما جرى","وفي عبرتي للصب عظم عبرة",67,"ه",1,0],["أأحجارُهم تبغى عليها إمارة","وهنّ من الموت المؤبّد نوّام",68,"م",1,0],["أأُحصي أياديه ومِن بعضها أنا","أم أنعت جدواه ومن بعضها قدري",69,"ر",2,0],["أَأَحبابَنا بِالجَزعِ هَل يَسمَعُ النَوى","بِيَومٍ يَكونُ القُربُ مِن حَسَناتِهِ",70,"ت",2,0],["أَأَحبابَنا بِنتُم عَنِ الخيفِ فَاِشتَكَت","لِبُعدِكُم آصالَها وَضُحاها",71,"ا",3,0],["أَأَحبابَنا كَيفَ السَبيلُ إِلى اللِقا","عَزيزٌ عَلَينا أَن يَطولَ التَفَرُّقُ",72,"ق",1,0],["أَأَحبابَنا بِنتُم فَما غُصنُ النَقا","وَريقٌ وَلا ماءَ المَسَرَّةِ رائِقُ",73,"ق",1,0],["أَأُحرَمُ دَولَتَكُم بَعدَ ما","رَكِبتُ الأَماني فَأَنضَيتُها",74,"ه",2,1],["أَأَحْبَابَنَا يَا جَنَّةَ الْخُلْدِ بَهْجَةً","لِبَيْنِكُمُ بَيْنَ الْجَوَانِحِ نِيرَانُ",75,"ن",1,0],["أَأَحْبَابَنَا يَا أَرْجَحَ النَّاسِ نُهْيَةً","عُبَيْدُكُمُ مُذْ سِرْتُمُ عَنُْه حَيْرَانُ",75,"ن",1,0],["أَأَحْبَابَنَا يَا يَا أَرْبَحَ النَّاسِ صَفْقَةً","مَسِيرُكُمُ دُونِي لِلْقَلْبِ خُسْرَانُ",75,"ن",1,0],["أَأَحْبَابَنَا يَا أَصْدَقَ النَّاسِ صَدِّقُوا","ظُنُونِي بِقُرْبٍ فَالْحَشَا مِنْهُ ظَمْآنُ",75,"ن",1,0],["أَأَحْسَنَ شَيْءٍ شَانَنِي الْبُعْدُ عَنْكُمُ","وَكَنْتُ بِكُمْ يَا أَجْمَلَ النَّاسِ أَزْدَانُ",75,"ن",1,0],["أَأَحْبَابَنَا فِيهَا هَلِ الدَّهْرُ سَامِحٌ","بِلُقْيَاكُمُ قَبْلَ الْحُلُولِ بِشَرْجَعِ",76,"ع",1,0],["أأحبابَنا إن ألَّف الدهرُ شَملَنا","تحلى بلُقياكم من العيش عاطلُه",77,"ل",2,0],["أأحجمت ام كنت ممن يقول","لعينيك مالي وروحي الفدا",78,"د",2,0],["أأحبُّ خوداً في محبَّتها","سيّانِ نقضُ العهدِ والحفظُ",79,"ظ",1,0],["أَأَحْمِلُ يا هَجْرُ جَوْرَ الْبِعادِ","وَجَوْرَكَ إِنِّي إِذا لَلْجَلِيدُ",80,"د",1,0],["أَأَحبابَنا أَمّا الأَسى فَهوَ عِندَنا","كَثيرٌ وَأَمّا الصَبرُ فَهوَ قَليلُ",81,"ل",1,0],["أَأَحبابنا والهجرُ حظّيَ منكمُ","فَما لنسيمِ اليأسِ لا يتنسّمُ",82,"م",1,0],["أأحبابنا والعهد بيني وبينكم","كريم وما عهد الكريم يحول",83,"ل",1,0],["أأحلام نفسي ليتني كنت قادرا","على بعثِ ما ولّى ونسيان ما جرّا",84,"ر",2,0],["أأحلام نفسي ليتني كنت عاجزا","عييّ الحجا غفلان لا أدرك الفكرا",84,"ر",2,0],["أأحلام نفسي كل يوم له غد","وكل غد أمسٌ إذا عهده مرّا",84,"ر",2,0],["أأحلامَ نفسي ليت لي منك ذرّة","أعيش بها الأسير إذا فرّا",84,"ر",2,0],["أَأَحبابَ قَلبي إِن يَكُن لَكُمُ رضا","بقتلي أَسىً سلّمتُ أَمرى لِلقَضا",85,"ا",1,1],["أأحِبَّتي والعَيشُ مُذْ فارقْتُكمْ","قد حال عن عَهْدِ الصّفاء حُؤولا",86,"ل",2,0],["أأحبابَنا هَبْكمْ عُذِرْتُم على النَّوى","فهل لصُدودِ الطَّيْفِ باللّيلِ من عُذر",87,"ر",1,0],["أأحبابَنا قد شُقْتمُونا فأسْعِدوا","ولا تُجْمِعوا أن تُسهِرونا وتَرقُدوا",88,"د",3,1],["أأحبابَنا كم تَجْرحون بهَجْرِكم","فؤاداً يَبيتُ الدّهرَ بالهَمِّ مُكْمَدا",89,"د",2,0],["أأحِبّتي الشاكِينَ طُولَ تَغَيّبي","والذّاهبينَ منَ الهوى في مَذْهبي",90,"ب",2,1],["أأحبابَنا جادتْ معاهدُ أُنسها","بقُربكُمُ غُرُّ السَّحابِ الهواضب",91,"ب",1,0],["أَأَحبابَنا إِن كُنتُ لِلنَفسِ خاسِراً","عَلَيكُم فَإِنّي بَعدَ ذاكَ رابِحُ",92,"ح",1,0],["أَأَحبابَنا هَل تَسمَعونَ عَلى النَوى","تَحِيَّةَ عانٍ أَو شَكِيَّةَ عاتِبِ",93,"ب",1,1],["أَأُحِيطُ بِالبَحرِ المُحي","طِ بعيد بَينَ السَّاحِلَينِ",94,"ن",1,0],["أَأَحبابَنا حتّى مَتى وإلى مَتَى","أُرَى ذاكراً بالغَيب مَن ظلّ ينساني",95,"ن",2,0],["أأَحْلَلْتُمُ أخذ الزكاة وأكلها","كإحلال أهل السبت صَيْدَ الجزائر",96,"ر",1,0],["أَأَحبابنا في وَصلِكُم وَبِعادكم","رَجاء وَخَوف هام بَينَهُما القَلبُ",97,"ب",1,0],["أأحبابَنَا هلاّ سبقتُم بوصلِنَا","صُروفَ اللّيالِي قبلَ أن نَتَفَرّقَا",98,"ق",2,1],["أَأحبابَنا خطبُ التّفرقِ شاغلٌ","عَن