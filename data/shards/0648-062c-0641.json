{"poems":[[53,"أثر الهوادج في عراص البيد","https://www.aldiwan.net/poem30633.html","الكامل"],[53,"من اي الثنايا طالعتنا النوائب","https://www.aldiwan.net/poem30739.html","الطويل"],[63,"وشادن نبهته والكرى","https://www.aldiwan.net/poem45925.html","السريع"],[63,"طرقت ونحن بسرة البطحاء","https://www.aldiwan.net/poem46215.html","الكامل"],[86,"ملكت علي مذاهبي","https://www.aldiwan.net/poem68864.html","مجزوء الكامل"],[93,"طفت والصبح طالباً في الجنان","https://www.aldiwan.net/poem11230.html","الخفيف"],[83,"لو تروا حب ما اجمل","https://www.aldiwan.net/poem54199.html","الخفيف"],[72,"سهرت عليك لواحظ الرقباء","https://www.aldiwan.net/poem18175.html","الكامل"],[72,"رب عيش نصبت كأس مدامه","https://www.aldiwan.net/poem19674.html","الخفيف"],[51,"للناس فيما يكلفون مغارم","https://www.aldiwan.net/poem66333.html","الكامل"],[91,"بت أرعى في الظلام الأنجما","https://www.aldiwan.net/poem8872.html","عموديه"],[85,"قف بهذا البحر وانظر ما غمر","https://www.aldiwan.net/poem62971.html","الرمل"],[43,"لهوى النفوس سريرة لا تعلم","https://www.aldiwan.net/poem10567.html","الكامل"],[62,"إن يحل دهر أو يمر فإنني","https://www.aldiwan.net/poem52313.html","الكامل"],[45,"رحلت وأودعت الفؤاد لواحظا","https://www.aldiwan.net/poem66839.html","الكامل"],[28,"ولو لقيت الذي تكنى بكنيته","https://www.aldiwan.net/poem5222.html","البسيط"],[61,"سألت الله مما كان عفوا","https://www.aldiwan.net/poem51398.html","الوافر"],[97,"متى يرق الحظ يا قاسي","https://www.aldiwan.net/poem24796.html","السريع"],[80,"وجفنين أوفى بالمنية فيهما","https://www.aldiwan.net/poem31429.html","الطويل"],[80,"للأقاحي بفيك نور ونور","https://www.aldiwan.net/poem31434.html","الخفيف"],[44,"مثل ودي لا يغيره","https://www.aldiwan.net/poem30596.html","المديد"],[105,"حماة الوغى أين السلام الموطد","https://www.aldiwan.net/poem43104.html","الطويل"],[105,"صبوح دم يساجله غبوق","https://www.aldiwan.net/poem43115.html","الوافر"],[102,"هل كفر كنه مرجع لي ذكرها","https://www.aldiwan.net/poem33006.html","الكامل"],[102,"جئت تتلو علي صفحة ماض","https://www.aldiwan.net/poem33091.html","الخفيف"],[22,"يأيها الملك الذي أمست له","https://www.aldiwan.net/poem22019.html","الكامل"],[52,"ما بال قلبك لا يقر خفوقا","https://www.aldiwan.net/poem26809.html","الكامل"],[52,"أتاك الربيع بصوب البكر","https://www.aldiwan.net/poem26985.html","المتقارب"],[52,"يا مقلة أدنفت كما دنفت","https://www.aldiwan.net/poem27208.html","المنسرح"],[52,"من يذود الهموم عن مكروب","https://www.aldiwan.net/poem27241.html","الخفيف"],[48,"لم أزل أخلع في الحب الرسن","https://www.aldiwan.net/poem66112.html","البسيط"],[48,"أحمد الله الذي أسكننى","https://www.aldiwan.net/poem66161.html","مجزوء الرمل"],[50,"حن قلبي إلى غزال ربيب","https://www.aldiwan.net/poem64826.html","الخفيف"],[76,"يا غليلا كالنار في كبدي","https://www.aldiwan.net/poem39333.html","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39660","الطويل"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199486","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43761","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54266","السريع"],[90,"ستالينغراد","https://www.poetsgate.com/ViewPoem.aspx?id=179193",""],[109,"من مبلغ قصر الأمير بأنه","https://www.aldiwan.net/poem16370.html","الكامل"],[124,"يا مدعي عام اللواء","https://www.aldiwan.net/poem23712.html","مجزوء الكامل"],[128,"هاكم من أخى وداد سلاما","https://www.aldiwan.net/poem50527.html","الخفيف"],[128,"خليلى هل بعد السنين الغوائر","https://www.aldiwan.net/poem50598.html","الطويل"],[128,"ورمتني الأيام أو","https://www.aldiwan.net/poem50671.html","مجزوء الكامل"],[132,"سرى الطيف من لبنى فهاج الضنى وهنا","https://www.aldiwan.net/poem54730.html","الطويل"],[132,"أبعد الشيب تبكى بالديار","https://www.aldiwan.net/poem54834.html","الوافر"],[135,"ولقد ذكرتك والطبيب بجانبي","https://www.aldiwan.net/poem49075.html","الكامل"],[142,"النجاء النجاء من أرض نجد","https://www.aldiwan.net/poem58420.html","البسيط"],[150,"أنا مذ بنت يا أبا العباس","https://www.aldiwan.net/poem68467.html","الخفيف"],[204,"من حديثي أن ابن بكر دعاني","https://www.aldiwan.net/poem52998.html","الخفيف"],[210,"قتيل هواك ليس يروم ثاره","https://www.aldiwan.net/poem13365.html","الوافر"],[222,"يا سعد سر مترنما","https://www.aldiwan.net/poem55397.html","مجزوء الكامل"],[235,"أيها الرائح المجد","https://www.aldiwan.net/poem31822.html","مجزوء الخفيف"],[237,"الحسن فيك قد اكتمل","https://www.aldiwan.net/poem18863.html","مجزوء الكامل"],[262,"وجفاني الأمير كي أتقرا","https://www.aldiwan.net/poem68181.html","الخفيف"],[270,"أرى أبدا قلبي الجريء جريحا","https://www.aldiwan.net/poem35214.html","الطويل"],[270,"من حسنك شعري قد سرقا","https://www.aldiwan.net/poem35437.html","المتدارك"],[271,"ضحك تبروق الابرقين تبسما","https://www.aldiwan.net/poem52106.html","الكامل"],[290,"هند عذراء أسلمتها المقادير","https://www.aldiwan.net/poem11680.html","الخفيف"],[298,"أعن اللهم من صورته من حزن","https://www.aldiwan.net/poem36850.html","عموديه"],[303,"ليس أشكو غير خديه التي","https://www.aldiwan.net/poem57552.html","الرمل"],[305,"بصادق عزم تفخر الدولة الوسطى","https://www.aldiwan.net/poem56490.html","الطويل"],[328,"الندامى وما أحب الندامى","https://www.aldiwan.net/poem54938.html","الخفيف"],[349,"مذ أفقرت ممن أحب الأربع","https://www.aldiwan.net/poem15781.html","الكامل"],[371,"سر مع الوجد والأسى في طريق","https://www.aldiwan.net/poem57258.html","الخفيف"],[371,"أرأيت بي من حادث إشفاقا","https://www.aldiwan.net/poem57262.html","الكامل"],[380,"أصبا الأصيل تحملي","https://www.aldiwan.net/poem49234.html","مجزوء الكامل"],[380,"فؤاد ملؤه ألم","https://www.aldiwan.net/poem49238.html","مجزوء الوافر"],[380,"أترى أراك بلا رقيب","https://www.aldiwan.net/poem49250.html","مجزوء الكامل"],[396,"أقول لما أتاني هُلكُ سيدنا","https://www.aldiwan.net/poem599.html",""],[403,"جادت على قبر الجلال","https://www.aldiwan.net/poem33476.html","مجزوء الكامل"],[403,"بث سر الهوى عليه النحول","https://www.aldiwan.net/poem33486.html","الخفيف"],[403,"يا رفاقا حلوا بأكناف صنعا","https://www.aldiwan.net/poem33687.html","الخفيف"],[409,"أبا حسن قد ران بعد بعادكم","https://www.aldiwan.net/poem32256.html","الطويل"],[416,"أسفا على تلك المحاسن","https://www.aldiwan.net/poem53829.html","مجزوء الكامل"],[416,"يا قلب هل لك في السلو","https://www.aldiwan.net/poem53909.html","مجزوء الكامل"],[416,"قلب يذوب عليك وجدا","https://www.aldiwan.net/poem54142.html","مجزوء الكامل"],[416,"أكرم بطيف خيالكم من زائر","https://www.aldiwan.net/poem54150.html","الكامل"],[416,"رمينا بأدهى المعضلات النوائب","https://www.aldiwan.net/poem54172.html","الطويل"],[416,"أتراك تعرف علتي وشفائي","https://www.aldiwan.net/poem54187.html","الكامل"],[432,"أيها اللائم لم غي","https://www.aldiwan.net/poem12544.html","مجزوء الرمل"],[437,"لهيب جوى قد أضمرته ضلوعه","https://www.aldiwan.net/poem2540.html","الطويل"],[437,"أمن الهجران غدا جسدي","https://www.aldiwan.net/poem2563.html","المتدارك"],[437,"أبى الدهر إلا أن تلم نوازله","https://www.aldiwan.net/poem2576.html","الطويل"],[437,"فؤاد عصاه صبره وهو طالبه","https://www.aldiwan.net/poem2577.html","الطويل"],[443,"ظبي تهاب الأسد موقف طعنه","https://www.aldiwan.net/poem56062.html","عموديه"],[458,"من موصل بالسؤال والقسم","https://www.aldiwan.net/poem55894.html","المنسرح"],[458,"ما كنت لولا طمعي في الخيال","https://www.aldiwan.net/poem55936.html","السريع"],[458,"سأل اللوى وسؤاله إلحاف","https://www.aldiwan.net/poem56110.html","الكامل"],[464,"سقاني بكأسي ريقه ومدامه","https://www.aldiwan.net/poem3446.html","عموديه"],[551,"بأبي زائرا أتاني جنحا","https://www.aldiwan.net/poem47172.html","الخفيف"],[558,"إن في قرع المثاني","https://www.aldiwan.net/poem33780.html","مجزوء الرمل"],[558,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[558,"أوميض برق بالأبيرق لاحا","https://www.aldiwan.net/poem34658.html","الكامل"],[561,"بكيت والمحتزن البكي","https://www.aldiwan.net/poem27848.html","الرجز"],[563,"أحداج تلك الجمال","https://www.aldiwan.net/poem13601.html","المجتث"],[567,"قفل الدجى وأتى الصباح حميدا","https://www.aldiwan.net/poem69716.html","الكامل"],[586,"كفى شرفا أني بحبك أعرف","https://www.aldiwan.net/poem17599.html","الطويل"]],"verses":[["وَجَفانِ جودٍ كَالرَكايا تُستَقى","أَبَداً بِأَيدي نُزَّلٍ وَوُفودَ",0,"د",1,0],["وَجَفَّت عُيونُ الباكِياتِ وَأُنسِيَت","مِنَ الغَدِ ما كانَت تَقولُ النَوادِبُ",1,"ب",1,0],["وَجَفْنُهُ يَثْقُلُ مِنْ سُكْرِهِ","وَكَفُّهُ بِالكَأْسِ نَحوي تَخِفّْ",2,"ف",1,0],["وجُفونِكِ المَرضَى الصَّحيحةِ لا دَرَتْ","ما الدّاءُ بل لا أفْرَقَتْ مِن داءِ",3,"ا",2,0],["وَجَفا يُراعي الصاحِبا","نِ فَلا النَثيرُ وَلا النَظيمُ",4,"م",1,0],["وَجُفُونٌ مِنْ نَرْجِسٍ دَاخَلَتْهَا","صُفْرَةُ الدَّاءِ فِي مَحَاجِرِ عَانِي",5,"ي",1,0],["وجفون تسبي من نظر","ما يزولوا يتغزّل",6,"ل",1,0],["وجفونكِ اللاتي تبرّحُ بالورى","وتقول لا حرَجٌ على الضعفاء",7,"ا",2,0],["وجفاني بعد اللقاء فيا نا","ر فؤاد المحب بعد سلامه",8,"م",2,0],["وجفاءُ لذَّاتٍ ورفضُ مكاسبٍ","لو خُولفتْ حُرِستْ من الإعدام",9,"م",1,0],["وَجُفونٌ أَشبَهَتني سَقَماً","كَمَنَ السِحرُ بِها وَاِستَتَرا",10,"ر",2,0],["وَجَفَت قَلباً وَخارَت جُؤجُؤاً","وَنَزَت جَنباً وَناءَت مِن أُخَر",11,"ر",1,0],["وَجُفونُهُ ما تَستَقِرُّ كَأَنَّها","مَطروفَةٌ أَو فُتَّ فيها حِصرِمُ",12,"م",1,0],["وجفتنيَ الدنيا وسوف تَبُرُّنِي","إِن عادَ ذاك المقبِلُ المتقَبِّلُ",13,"ل",1,0],["وَجُفونِ كافورٍ أَعادَ بِها الصَبا","ضَعَفاً فَهُنَّ مَرائِضُ الأَجفانِ",14,"ن",1,0],["وَجَفنَةً مِثلَ حَوضِ البِئرِ مُترَعَةً","تَطرُدُ عَمَّن أَتاها الجوعَ وَالخَصَرا",15,"ر",2,0],["وجَفَّ قضيبُه الميَّاسُ رَقصاً","وطارَ هَزارُه الغِرِّيدُ شأوا",16,"و",2,0],["وجفَّ أو ذاب على نورها","كما يذُوب الطلّ بالآس",17,"س",1,0],["وجفنَينِ أوْفَى بالمنِيَّة فيهما","عليكَ من الغزلان وَسْنانُ أحْوَرُ",18,"ر",1,1],["وجفونٌ تشيرُ بالحبِّ منها","عن فؤادٍ إلى فؤادٍ سفيرُ",19,"ر",1,0],["وَجُفوني لا يَزالُ بِها","طَيفُ حِلمٍ مِنكَ يَطَّرِدُ",20,"د",1,0],["وَجَفَّ مَعينُ المالِ فَالرِزقُ مُعوزٌ","وَإِن أَمعَنَ الساعي إِلى القوتِ يَجهَدُ",21,"د",1,0],["وَجَفَ الريقُ حَتّى وَدَّ قَومٌ","لَوَ اَنَّ السُمَّ في اللَهَواتِ ريقُ",22,"ق",1,0],["وجَفَتْ مضاجِعَها الجنوب وملؤها","خفقان مضطَرمِ الهوى وثّابِ",23,"ب",1,0],["وَجُفونٍ ما بَينَ قَتلٍ بَعُنفٍ","أَنا مِنها وَبَينَ قَتلٍ بِلُطفِ",24,"ف",1,0],["وَجَفاءَ مَولايَ الضَنينِ بِمالِهِ","وَوَلوعَ نَفسٍ هَمُّها بِيَ موزَعُ",25,"ع",1,0],["وَجُفونُ عَينِكَ قَد نَثَرنَ مِنَ البُكا","فَوقَ المَدامِعِ لُؤلُؤً وَعَقيقا",26,"ق",2,0],["وَجَفَّت عَلى المَرءِ أَثوابُهُ","إِذا رَحَ في حاجَةٍ أَو بَكَر",27,"ر",1,0],["وَجَفنُها ساحِرٌ ليَّقتِلَني","فَتُبتُ مِن تَوبَتي الَّتي سَلَفتُ",28,"ت",1,0],["وَجَفاهُ الإِخوانُ حَتّى وَحَتّى","سَمِّ مَن شِئتَ مِن حَبيبٍ قَريبِ",29,"ب",1,0],["وَجُفوني ساكِباتٌ دَمعَها","وَالحَشا في حَشوِهِ مِنّي الحَزَن",30,"ن",1,0],["وَجَفاني كُلُّ مَن أَم","مَلتُهُ حَتّى لِساني",31,"ي",1,0],["وَجَفاني الصَديقُ مِن يَأسِ أَن أَب","رَأَ وَاِعتَلَّ عائِدي مِن نَسيبي",32,"ب",2,0],["وَجُفُوناً تذري الدمُوعَ أسىً","وَتَبيعُ الرُّقادَ بالسُّهدِ",33,"د",1,0],["وجفَّتْ حشاشاتٌ وُعِدْنَ بمائِهِ","فلما دَنَا أَلفَتْ سرابَ وعودِ",34,"د",1,0],["وجفَّ (بويبُ) إلاّ من هلاكٍ","وغارَ (الهورُ) إلا من زعاقِ",35,"ق",1,0],["وَجَفَت قُلوبُ حَبائِبي","وَجَفَت كأن لَم تَرعَ شاني",36,"ي",1,0],["وجفَّ ماءُ العَيْنِ في مُوقِها","ماذا أفَاد العينَ من هَمْرِه",37,"ر",2,0],["وجف الغربُ على وطأتِها","وأمالت كلكلَ الشرقِ فناء",38,"ا",2,0],["وَجفا ملث الغاديات رُسومُهُ","وَأَزبل عَنهُ الدَمع وَهُوَ مصونُ",39,"ن",1,0],["وجفته حيهلة الاماء","وهسة العبد الونية",40,"ي",2,0],["وجفاءً مِني لبيعِي سِواكُم","خيفةً أن يثيرَ وردى زُكاما",41,"م",2,0],["وجفنٌ سقيمٌ فاتنُ اللحظِ فاترٌ","كحيلٌ فما وَجْدى عليه بفاتِر",42,"ر",1,0],["وجفا الأقاربُ ساحتى","وانحلَّ عقد عصائبي",43,"ب",2,0],["وجَفنٍ كَأنَّ الصَّابَ في حِضنِ عَينِهِ","يُهَجهِجُ طَيفَ النَّومِ إِن طَرَقَ الجَفنَا",44,"ن",2,0],["وجَفنُك دَائمُ التَّسهِيدِ شَوقاً","ولَيلُكَ مُظلِمٌ بَادِى إعتِكَارِ",45,"ر",1,0],["وجفونُ عينيِ بالملاقط فتّحت","وبها المباضعُ تغتدي وتروحُ",46,"ح",1,0],["وجفونٌ جرينَ مدًّا وماءُ ال","بحر يرتاحُ بين جزرٍ ومدِّ",47,"د",1,0],["وجفون تعلمت صنعة السحر","فضلت بها حلوم الناس",48,"س",1,0],["وجفان مثل الجوابي ولكن","ليس فيهنَّ ما يُرى بالعيانِ",49,"ن",1,0],["وجفن قد حكى جسمي سقاما","وما اقوى على ضعفي اقتداره",50,"ر",2,0],["وجفوتم الأوطان رع","باً وانقلبتم خاسرين",51,"ن",1,0],["وجفوتمونا بعد م