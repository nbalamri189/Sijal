www.poetsgate.com/ViewPoem.aspx?id=178825",""],[4830,"الذُبول","https://www.poetsgate.com/ViewPoem.aspx?id=195424",""],[4830,"بَرَقَ الشّيب","https://www.poetsgate.com/ViewPoem.aspx?id=201357",""],[4830,"أسفرَ الصبحُ","https://www.poetsgate.com/ViewPoem.aspx?id=202281",""],[4830,"سلاماً ياعِراق","https://www.poetsgate.com/ViewPoem.aspx?id=207947",""],[4984,"نازفة الجراح","https://www.poetsgate.com/ViewPoem.aspx?id=175562",""],[5007,"رجفة الصّبر","https://www.poetsgate.com/ViewPoem.aspx?id=144624",""],[585,"هو الصوت دوّى من فلسطين عالياً","https://www.poetsgate.com/ViewPoem.aspx?id=161906",""],[5087,"أيها اللائمي لحبي عليا","https://www.poetsgate.com/ViewPoem.aspx?id=96364",""],[5112,"فما الجوعين","https://www.poetsgate.com/ViewPoem.aspx?id=212832",""],[5136,"دعه يبكي فمن بكى يستريح","https://www.poetsgate.com/ViewPoem.aspx?id=121548",""],[5150,"وجدتها .. وجدتها","https://www.poetsgate.com/ViewPoem.aspx?id=202800",""],[5213,"هوى قمر الامامة للافول","https://www.poetsgate.com/ViewPoem.aspx?id=170520",""],[2365,"أدرك الدّهر الذي طلبا","https://www.poetsgate.com/ViewPoem.aspx?id=200641",""],[5246,"وصف رحلة","https://www.poetsgate.com/ViewPoem.aspx?id=187032",""],[5268,"باسمِكِ أستنيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=206994",""],[5277,"حبيبةٌ مطلسمة","https://www.poetsgate.com/ViewPoem.aspx?id=185608",""],[5281,"أما بعد","https://www.poetsgate.com/ViewPoem.aspx?id=199300",""],[5324,"مكانك ظلّ يسألني","https://www.poetsgate.com/ViewPoem.aspx?id=211465",""],[5397,"تدلت لأفنان النقا عذباتها","https://www.poetsgate.com/ViewPoem.aspx?id=157920",""],[5512,"قضيت العمر أعجنه بصبري","https://www.poetsgate.com/ViewPoem.aspx?id=204500",""],[5596,"عودة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=205675",""],[5612,"ماذا جَرى لكْ !!","https://www.poetsgate.com/ViewPoem.aspx?id=179543",""],[5660,"يا قُنبُلُةَ الهَجرِ انفَجِري","https://www.poetsgate.com/ViewPoem.aspx?id=37065",""],[5690,"خلَعَ الزمان الآن ثوب حداحدهِ","https://www.poetsgate.com/ViewPoem.aspx?id=172149",""],[5703,"مازال صوتكَ","https://www.poetsgate.com/ViewPoem.aspx?id=211773",""],[5725,"يا رشيقا","https://www.poetsgate.com/ViewPoem.aspx?id=195333",""],[5759,"عد إلينا","https://www.poetsgate.com/ViewPoem.aspx?id=213623",""],[5829,"أوراق الخريف","https://www.poetsgate.com/ViewPoem.aspx?id=155357",""],[5861,"حكاية من الطريق","https://www.poetsgate.com/ViewPoem.aspx?id=188299",""],[5897,"على بركات الله","https://www.poetsgate.com/ViewPoem.aspx?id=177077",""],[6102,"تقولين خذني","https://www.poetsgate.com/ViewPoem.aspx?id=183319",""],[6102,"صراحة مفرطة ...","https://www.poetsgate.com/ViewPoem.aspx?id=184430",""],[6104,"أريج الصبايا","https://www.poetsgate.com/ViewPoem.aspx?id=25365",""],[6185,"غزو الهموم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87032&r=&rc=18",""],[6129,"وسقط صدام ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74362&r=&rc=0",""],[5616,"أمي ..!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1926&r=&rc=1",""],[5001,"الرسم بالحروف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80718&r=&rc=8",""]],"verses":[["وَجَفانِ جودٍ كَالرَكايا تُستَقى","أَبَداً بِأَيدي نُزَّلٍ وَوُفودَ",0,"د",1,0],["وَجَفَّت عُيونُ الباكِياتِ وَأُنسِيَت","مِنَ الغَدِ ما كانَت تَقولُ النَوادِبُ",1,"ب",1,0],["وَجَفْنُهُ يَثْقُلُ مِنْ سُكْرِهِ","وَكَفُّهُ بِالكَأْسِ نَحوي تَخِفّْ",2,"ف",1,0],["وجُفونِكِ المَرضَى الصَّحيحةِ لا دَرَتْ","ما الدّاءُ بل لا أفْرَقَتْ مِن داءِ",3,"ا",2,0],["وَجَفا يُراعي الصاحِبا","نِ فَلا النَثيرُ وَلا النَظيمُ",4,"م",1,0],["وَجُفُونٌ مِنْ نَرْجِسٍ دَاخَلَتْهَا","صُفْرَةُ الدَّاءِ فِي مَحَاجِرِ عَانِي",5,"ن",2,0],["وجفون تسبي من نظر","ما يزولوا يتغزّل",6,"ل",1,0],["وجفونكِ اللاتي تبرّحُ بالورى","وتقول لا حرَجٌ على الضعفاء",7,"ا",2,0],["وجفاني بعد اللقاء فيا نا","ر فؤاد المحب بعد سلامه",8,"م",2,0],["وجفاءُ لذَّاتٍ ورفضُ مكاسبٍ","لو خُولفتْ حُرِستْ من الإعدام",9,"م",1,0],["وَجُفونٌ أَشبَهَتني سَقَماً","كَمَنَ السِحرُ بِها وَاِستَتَرا",10,"ر",2,0],["وَجَفَت قَلباً وَخارَت جُؤجُؤاً","وَنَزَت جَنباً وَناءَت مِن أُخَر",11,"ر",1,0],["وَجُفونُهُ ما تَستَقِرُّ كَأَنَّها","مَطروفَةٌ أَو فُتَّ فيها حِصرِمُ",12,"م",1,0],["وجفتنيَ الدنيا وسوف تَبُرُّنِي","إِن عادَ ذاك المقبِلُ المتقَبِّلُ",13,"ل",1,0],["وَجُفونِ كافورٍ أَعادَ بِها الصَبا","ضَعَفاً فَهُنَّ مَرائِضُ الأَجفانِ",14,"ن",1,0],["وَجَفنَةً مِثلَ حَوضِ البِئرِ مُترَعَةً","تَطرُدُ عَمَّن أَتاها الجوعَ وَالخَصَرا",15,"ر",2,0],["وجَفَّ قضيبُه الميَّاسُ رَقصاً","وطارَ هَزارُه الغِرِّيدُ شأوا",16,"و",2,0],["وجفَّ أو ذاب على نورها","كما يذُوب الطلّ بالآس",17,"س",1,0],["وجفنَينِ أوْفَى بالمنِيَّة فيهما","عليكَ من الغزلان وَسْنانُ أحْوَرُ",18,"ر",1,1],["وجفونٌ تشيرُ بالحبِّ منها","عن فؤادٍ إلى فؤادٍ سفيرُ",19,"ر",1,0],["وَجُفوني لا يَزالُ بِها","طَيفُ حِلمٍ مِنكَ يَطَّرِدُ",20,"د",1,0],["وَجَفَّ مَعينُ المالِ فَالرِزقُ مُعوزٌ","وَإِن أَمعَنَ الساعي إِلى القوتِ يَجهَدُ",21,"د",1,0],["وَجَفَ الريقُ حَتّى وَدَّ قَومٌ","لَوَ اَنَّ السُمَّ في اللَهَواتِ ريقُ",22,"ق",1,0],["وجَفَتْ مضاجِعَها الجنوب وملؤها","خفقان مضطَرمِ الهوى وثّابِ",23,"ب",1,0],["وَجُفونٍ ما بَينَ قَتلٍ بَعُنفٍ","أَنا مِنها وَبَينَ قَتلٍ بِلُطفِ",24,"ف",1,0],["وَجَفاءَ مَولايَ الضَنينِ بِمالِهِ","وَوَلوعَ نَفسٍ هَمُّها بِيَ موزَعُ",25,"ع",1,0],["وَجُفونُ عَينِكَ قَد نَثَرنَ مِنَ البُكا","فَوقَ المَدامِعِ لُؤلُؤً وَعَقيقا",26,"ق",2,0],["وَجَفَّت عَلى المَرءِ أَثوابُهُ","إِذا رَحَ في حاجَةٍ أَو بَكَر",27,"ر",1,0],["وَجَفنُها ساحِرٌ ليَّقتِلَني","فَتُبتُ مِن تَوبَتي الَّتي سَلَفتُ",28,"ت",1,0],["وَجَفاهُ الإِخوانُ حَتّى وَحَتّى","سَمِّ مَن شِئتَ مِن حَبيبٍ قَريبِ",29,"ب",1,0],["وَجُفوني ساكِباتٌ دَمعَها","وَالحَشا في حَشوِهِ مِنّي الحَزَن",30,"ن",1,0],["وَجَفاني كُلُّ مَن أَم","مَلتُهُ حَتّى لِساني",31,"ن",2,0],["وَجَفاني الصَديقُ مِن يَأسِ أَن أَب","رَأَ وَاِعتَلَّ عائِدي مِن نَسيبي",32,"ب",2,0],["وَجُفُوناً تذري الدمُوعَ أسىً","وَتَبيعُ الرُّقادَ بالسُّهدِ",33,"د",1,0],["وجفَّتْ حشاشاتٌ وُعِدْنَ بمائِهِ","فلما دَنَا أَلفَتْ سرابَ وعودِ",34,"د",1,0],["وجفَّ (بويبُ) إلاّ من هلاكٍ","وغارَ (الهورُ) إلا من زعاقِ",35,"ق",1,0],["وَجَفَت قُلوبُ حَبائِبي","وَجَفَت كأن لَم تَرعَ شاني",36,"ي",1,0],["وجفَّ ماءُ العَيْنِ في مُوقِها","ماذا أفَاد العينَ من هَمْرِه",37,"ر",2,0],["وجف الغربُ على وطأتِها","وأمالت كلكلَ الشرقِ فناء",38,"ا",2,0],["وَجفا ملث الغاديات رُسومُهُ","وَأَزبل عَنهُ الدَمع وَهُوَ مصونُ",39,"ن",1,0],["وجفته حيهلة الاماء","وهسة العبد الونية",40,"ي",2,0],["وجفاءً مِني لبيعِي سِواكُم","خيفةً أن يثيرَ وردى زُكاما",41,"م",2,0],["وجفنٌ سقيمٌ فاتنُ اللحظِ فاترٌ","كحيلٌ فما وَجْدى عليه بفاتِر",42,"ر",1,0],["وجفا الأقاربُ ساحتى","وانحلَّ عقد عصائبي",43,"ب",2,0],["وجَفنٍ كَأنَّ الصَّابَ في حِضنِ عَينِهِ","يُهَجهِجُ طَيفَ النَّومِ إِن طَرَقَ الجَفنَا",44,"ن",2,0],["وجَفنُك دَائمُ التَّسهِيدِ شَوقاً","ولَيلُكَ مُظلِمٌ بَادِى إعتِكَارِ",45,"ر",1,0],["وجفونُ عينيِ بالملاقط فتّحت","وبها المباضعُ تغتدي وتروحُ",46,"ح",1,0],["وجفونٌ جرينَ مدًّا وماءُ ال","بحر يرتاحُ بين جزرٍ ومدِّ",47,"د",1,0],["وجفون تعلمت صنعة السحر","فضلت بها حلوم الناس",48,"س",1,0],["وجفان مثل الجوابي ولكن","ليس فيهنَّ ما يُرى بالعيانِ",49,"ن",1,0],["وجفن قد حكى جسمي سقاما","وما اقوى على ضعفي اقتداره",50,"ر",2,0],["وجفوتم الأوطان رع","باً وانقلبتم خاسرين",51,"ن",1,0],["وجفوتمونا بعد ما","علق الهوى بالمغرمين",51,"ن",1,0],["وَجُفونٌ لِوَ شكِ بَي","نِكَ بِالدَمعِ مُترِعَه",52,"ع",2,0],["وَجَفَوْتَهُ مِنْ غَيْرِ مَا","جُرْمٍ بِجَانِبِكُمْ أَخَلْ",53,"ل",1,0],["وجفاني الأمير كي أتقرا","فتقرأت مكرها لجفائه",54,"ا",3,1],["وجفنايَ مربوطانِ والنومُ مطلقٌ","وليلي كحفّارٍ يسدُّ ضريحا",55,"ح",2,0],["وجفونكِ ذابلةٌ كحلاً","وجفُوني ذابلةٌ أرقا",56,"ق",2,0],["وَجفاك اذ زار الرِفاق وَلَم يزر","ما يَستَطيع يرد امرا مبرما",57,"م",2,0],["وجفاها أترابها من عذارى الحي","إذ قارفت من الأمر نكرا",58,"ر",2,0],["وَجفا اللهوَ فلو واصله اللهوُ شكاهْ","نفْسُهُ ليس لها غيرُ الأَسى من سَكَنِ",59,"ن",1,0],["وجفونٍ زانها عارضه","ما نبت أسيافها لما نبت",60,"ت",1,0],["وَجَفنٌ حَبا إِنسانهُ كلَّ فترةٍ","بِوَحيٍ دَعا النصرَ العزيزَ فما أبطا",61,"ط",2,0],["وجفا الكاس راحتي ونأى السا","قى وأغفت عيني ضنى وسقاما",62,"م",2,0],["وَجَفا الحَيا أَطلالَها لَمّا جَفَوا","فَجَرَت عَلَيهِم لا عَلَيها الأَدمُعُ",63,"ع",1,0],["وجُفُونٍ شَرِبتُ مِنها شَراباً","زادَ سُكراً عَلى الشَّرابِ العَتيقِ",64,"ق",1,0],["وجفونِ غانِيَةٍ رَمَت فتَراهَنَت","أَرواحُنا لنِصالِها أَسباقا",65,"ق",2,0],["وَجَفا الهَوى وَبَغى الزَمان","ن وَلَم أَجِد مِن مُسعِف",66,"ف",1,0],["وَجفن غَمامِهِ يَبكي","وَثَغر البَرق يَبتَسم",67,"م",1,0],["وَجُفونَهُ توحي بِأَن","البَشَر في طَي القُطوب",68,"ب",1,0],["وجفنة كنضيح البئر متأقسة","ترى جوانبها باللحم مفتوقا",69,"ق",2,0],["وجفاه قوم ما دروا","كيف السمين من لهزال",70,"ل",1,0],["وجفون مسهدات من الوج","د ودمع على الخدود يسيل",71,"ل",1,0],["وجفا جفني المنام وقد صا","ر لطول البعاد نومِيَ دمعا",72,"ع",2,0],["وجفوةُ مجدِ الدّين أَعدَلُ شاهِدٍ","على أنّ أهواءَ القلوبِ تَحُولُ",73,"ل",1,0],["وجَفاه من يَهواه حتَّى","لا يزورُ ولا يزار",74,"ر",1,0],["وجفاك من نهوى فلا","منه إليك اليوم قربُ",75,"ب",1,0],["وجفون صبٍّ لا تزال","بهذه العَبرات تَنْدى",76,"د",2,0],["وجفا الخيال ولم يزرني بعدها","أين الخيال من الكئيب الساهر",77,"ر",1,0],["وجفن يهلُّ الدمع من عبراته","على طيّب الأعراق وابن الأطايب",78,"ب",1,0],["وجفا وملّ أخا الهوى من بعد ما","كنا عقيدي ألفةٍ وإخاء",79,"ا",2,0],["وجفونٍ ساحراتٍ","مذ رأيناها تَوينا",80,"ن",2,0],["وجفن جفاه الغمض شوقا وإنما","لبعد التداني بأن عنه هجوعه",81,"ع",2,0],["وجفونك ترشقني أبداً","بنبال تنفذ في الزرد",82,"د",1,0],["وجفني إلا أن تصوبَ دموعهُ","وأن لا يرى من فوق خدّي سائله",83,"ل",2,0],["وجفن تداعت للفراق شؤونهُ","فسالت دما لما تناءت حيايبه",84,"ب",2,0],["وجفاك فرق بين جفني والكرى","وسحاب جفني صب آخر مزنه",85,"ن",2,0],["وجفوةٌ لو شربتُها في إنا","ء الماءِ صَديانَ ما شَفى قَرَمي",86,"م",2,0],["وجفّت الأقلامُ في صُحفه","يأسا وخانته سيوفُ القتالْ",87,"ل",1,0],["وجفت خلائقُ كنت إن جاذبتُها","سهلَ القياد ولانت الأعطافُ",88,"ف",1,0],["وجفنٍ حماه لذَّةَ الغمض جفنهُ","وبدَّل مرُّ السهد حلو منامهِ",89,"م",2,0],["وجفا بالنّهار من بعد أن خي","يِلَ لِي أنّه أتانِيَ وَهْنا",90,"ن",2,0],["وجفون العين فيها","حفظ أسرار العيان",91,"ن",1,0],["وجفون قد قرحتها من الدمْ","ع حثيثاً إلى لقاكم سيول",92,"ل",1,0],["وجفون عين كلما نوت البكا","ملأت نواحي أرض مصر نواحا",93,"ح",2,0],["وَجَفَّ عَنهُ العَرَقُ الأَمسِيُّ","قُرقُورُ ساجٍ ساجُهُ مَطلِيُّ",94,"ي",1,0],["وَجَفنُها وَهَواها","في صِحَّةٍ وَاِعتِلالِ",95,"ل",1,0],["وجفتْكَ لائِمةٌ وزارَكَ مُسْعِدٌ","وغَدَتْ عليكَ الشّمْسُ تحمِلُ عُودَا",96,"د",2,0],["وَجَفْنُكَ نَبَّالٌ وَشَعْرُكَ مُسْبَلٌ","وقدّكَ خَطِّيٌّ وَلَحْظُكَ مُرْهَفُ",97,"ف",1,0],["وجفا الفراش وبات يطلب ثأره","أسفاً وإنْ أغضى ولم يتكلّمِ",98,"م",1,0],["وَجَفاني بَدرُ التمام فَحَتّا","مَ أُغطّي تحرُّقي وَأُواري",99,"ي",1,0],["وَجفنٍ كَسَيفٍ وجنتاكِ فرِندُهُ","صَقيلٍ وَلَكِنّ القلوب غمودهُ",100,"د",2,0],["وجفنٌ غنجه سهمٌ إذا ما","رمت كبداً به انقطع أو تناله",101,"ل",2,0],["وجفنك مذْ سددت نحوي سهمه","تجافت عن التغميض والنوم أجفاني",102,"ن",2,0],["وجَفْنٍ قَريحٍ قد أضرَّ به البُكَا","ففي كلِّ وقتٍ دمعُه يتحَدَّرُ",103,"ر",1,0],["وجفن بدمع فيك مازال طافياً","على أن جسمي بالمدامع غارق",104,"ق",1,0],["وجفوني لا زاهدين ولكن","كرهوا في الهناء أن ينظروني",105,"ن",2,0],["وجفا فما نجى غناه معسراً","يشكو إليه ولا أغاث كميدا",106,"د",2,0],["وجفّ مزادُ القومِ فهي أشنّةٌ","وخفّ لوردِ الموتِ كفٌّ ومِعصمُ",107,"م",1,0],["وَجَفنُهُ مُذ بَدا في الكَسْرِ يَسْحرني","فَصَحَّ عِندي أَنَّ الجفنَ سحّارُ",108,"ر",1,0],["وَجَفناً باتَ يَغزونا بِسحرٍ","فَنالَ النَّصرَ مُذ أَمسى كَسيرا",109,"ر",2,0],["وَجُفونُهُ قَد صحَّحَت في كَسرِها","سِحرَ اللِّحاظِ فَشِمتُ ما لم يُحسَبِ",110,"ب",1,0],["وجفا فما هو مانحي","وصلا ولا أنا عنه صابر",111,"ر",1,0],["وَجَفاهُ نَوْمٌ كانَ يَأْلَفُ جَفْنَهُ","قِدْماً وَأَضْحى لِلحُتُوفِ مُعَرَّضا",112,"ض",2,0],["وجَفونٌ مُفَتَّراتٌ مِرَاضٌ","وحديثُ الْمُؤَنَّثِ اللَّفْظِ رَطْبُ",113,"ب",1,0],["وجفني كأن الخدَّ ميدانُه وقد","أجال الجيادَ الحمر من عبراته",114,"ت",2,0],["وجفت دجاجته وحير صفره","بصر الصفوف مكافحاً ومسوما",115,"م",2,0],["وجفوتمُ وخيالُكم","من رحمةٍ ليَ زائري",116,"ر",2,0],["وجُفُونٌ لَها اللِّحاظُ نُصُولٌ","وَعُيونٌ دُعجُ المَحاجِرِ سُودُ",117,"د",1,0],["وجفون عين أقسمت","أن لا يلم بها المنامُ",118,"م",1,0],["وجفون معتلّ الجفون سقيمها","تدوى الصحيح ولا تبلّ من السقم",119,"م",1,0],["وجفون مذ تجافا","ها الكرى ذات نفساح",120,