abudhabi.ae/diwan/poem/67354","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43902","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43863","السريع"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43675","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54258","الوافر"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54267","المجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54259","الطويل"],[106,"وطن ينادي أهله!","https://www.poetsgate.com/ViewPoem.aspx?id=179349",""],[106,"رويدك يا جمال!","https://www.poetsgate.com/ViewPoem.aspx?id=179353",""],[106,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179289",""],[77,"قلبي وسمعي في شغل عن الفند","https://www.poetsgate.com/ViewPoem.aspx?id=33815",""],[90,"اليأس المنشود","https://www.poetsgate.com/ViewPoem.aspx?id=179218",""],[90,"تحرك اللحد !","https://www.poetsgate.com/ViewPoem.aspx?id=179160",""],[90,"وادي العرائش","https://www.poetsgate.com/ViewPoem.aspx?id=179145",""],[90,"أبو العلاء المعري","https://www.poetsgate.com/ViewPoem.aspx?id=179199",""],[90,"النجوى","https://www.poetsgate.com/ViewPoem.aspx?id=178987",""],[90,"شباب يذوي !","https://www.poetsgate.com/ViewPoem.aspx?id=179111",""],[34,"وَددتُ مِنَ الشَّوقِ الذي بي أنَّنِي","https://www.poetsgate.com/ViewPoem.aspx?id=22465",""],[45,"أَمَا وَهَذَا الزَّمَانُ يَمْتَحِنُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31639",""],[45,"يكادُ يُبْدي لسعدى غَيْبَ ما أجِدُ","https://www.poetsgate.com/ViewPoem.aspx?id=31630",""],[45,"سَلامٌ عَلَيْكُمْ، لا وَفَاءٌ وَلاَ عَهْدُ","https://www.poetsgate.com/ViewPoem.aspx?id=31425",""],[91,"كتابي","https://www.poetsgate.com/ViewPoem.aspx?id=53230",""],[46,"عاقبةُ الميّتِ محمودةٌ،","https://www.poetsgate.com/ViewPoem.aspx?id=18068",""],[46,"ما الخيرُ صومٌ يذُوبُ الصّائمونَ له،","https://www.poetsgate.com/ViewPoem.aspx?id=18561",""],[99,"إلى رجل","https://www.poetsgate.com/ViewPoem.aspx?id=565",""],[51,"إذا أبو قاسمٍ جادتْ لنا يدهُ","https://www.poetsgate.com/ViewPoem.aspx?id=29184",""],[33,"تذكرتُ ليلى والسنين الخواليا ( المؤنسة )","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=14184&r=&rc=118",""]],"verses":[["وَأَنَّ ما بُزُّ مِن مَقادِمِنا","يُخلِفُهُ اللَهُ في عَقائِلِنا",0,"ن",2,0],["وَإِنَّما جَعَلنَها","لِرَدِّ قَولٍ أَلسُنا",1,"ن",2,0],["وَإِنَّما الصَونُ عَلى","قَدرِ المَضاءِ وَالغِنا",1,"ن",2,0],["وَإِن مَنَعوا النَصفَ اِقتَضَوهُ وَأَفضَلوا","عَلى النَصفِ بِالأَيدي الطِوالِ الغَواشِمِ",2,"م",1,0],["وَإِنَّ مِلاكَ الرَأيِ نَزعُ حُماتِها","قُبَيلَ أُمورٍ ما لَهُنَّ مِلاكُ",3,"ك",1,0],["وَإِن مُدَّتِ الأَيّامُ بَيني وَبَينَكُم","أَطَلتُ بُكاءَ العاجِزِ المُتَهاتِفِ",4,"ف",1,0],["وَإِن مَجَّ نَصلٌ مِن دَمِ الصِربِ أَحمَراً","أَراقَ دَماً مِن مَقتَلِ الخَطبِ أَسوَدا",5,"د",2,0],["وَإِنَّ مَنائِحَها لِلفَتى","لَرَهنٌ لَهُ بِنِكاياتِها",6,"ت",3,0],["وَإِنَّما الدُنيا عَلى طولِها","ثَنِيَّةٌ مَطلَعُها المَوتُ",7,"ت",1,0],["وَإِنَّ مَنازِلَ هَذا الزَمانِ","لِأَبنائِهِ نُوَبٌ أَو عُقَب",8,"ب",1,0],["وَإِنَّ مُزايِلَ العَيشِ اِختِصاراً","مُساوٍ لِلَّذينَ بَقوا فَشابوا",9,"ب",3,0],["وَإِنَّ مُقامَ مِثلي في الأَعادي","مُقامُ البَدرِ تَنبَحُهُ الكِلابُ",9,"ب",1,0],["وَإِنَّ مَحَلّاً حَلَّ فيهِ لَواسِعٌ","وَإِنَّ زَماناً عاشَ فيهِ لَطَيِّبُ",10,"ب",1,0],["وإنّما الطّيْفُ يَسْتَشْفي برؤيَتِهِ","على النّوى مُستَميتُ الشّوقِ وسْنانُ",11,"ن",1,0],["وإنْ مَدَّ عَبدُ اللهِ للفَخْرِ باعَها","أُريحَتْ إلَيْها بَسْطَةُ المُتَحكِّمِ",12,"م",1,0],["وَإِنَّما هاجَ لَهُ شَوقَهُ","طَيِّبَةٌ يَحظى بِها الطيبُ",13,"ب",1,0],["وَإِن مَسَّني لِلضُرِّ مِنكِ كَآبَةٌ","وَإِن نالَ جِسمي لِلفُراقِ خُشوعُ",14,"ع",1,0],["وإنْ مكّنَتْني منْ أمْرِها","فشِمْتُ السّيوفَ وصُنْتُ الطّلا",15,"ل",2,0],["وإنْ مُدِحوا اهتَزّوا كَما هبّتِ الصَّبا","على كُلِّ ممْطورٍ منَ البانِ مُلْتَفِّ",16,"ف",1,0],["وإنْ مُدِحوا اهْتَزّوا ارْتِياحاً كأنّهم","نَشاوَى تمشّتْ في مَفاصِلِهِمْ خَمْرُ",17,"ر",1,0],["وإنّما اخْتَلفا منْ بَعْدِ ما ائتَلَفا","معْنىً بشَيْئَيْنِ منْ قَدْرٍ ومِنْ بَلَدِ",18,"د",1,0],["وإنّما أنا روْضٌ والعُلومُ لهُ","غيْثٌ فإنّي جَنى إنْ شِئْتَهُ تَجِدِ",19,"د",1,0],["وإنْ مِدَحٌ في المَكْرُماتِ تَعارَضَتْ","فأنْتَ الى الأدْنى منَ اللهِ جانِحُ",20,"ح",1,0],["وَإِن مَعشَرٌ دَبَّت إِلَيكَ عَداوَةً","عَقارِبُهُم دَبَّت إِلَيهم عَقارِبي",21,"ي",1,0],["وَإِنَّ مَعَدّاً لَن تُجازَ بِفِعلِها","وَإِنَّ إِياداً لَم تُقَدِّر مِثالَها",22,"ل",3,0],["وَإِنَّما العاقِلُ الرَشيدُ","مَن سارَ في مَنهَجِ النَجاء",23,"ا",2,0],["وَإِنَّما العَبدُ أَهدى كُنهَ قُدرَتِهِ","وَالنَملُ يُعذَرُ في القدرِ الَّذي حَمَلا",24,"ل",2,0],["وَإِنَّ مَن شارَفَ التِسعينَ في شُغُل","عَنِ القَوافي جَديرٌ أَن يَقولَ هُرا",25,"ر",2,0],["وَأَنَّ مَتابي لَم يُضِعهُ مُحَمَّدٌ","خَليفَتُكَ العَدلُ الرِضى وَابنُكَ البَرُّ",26,"ر",1,0],["وَإِنَّما بَينَهُما رَوحَةٌ","في إِثرِ غادٍ سارَ حَدَّ النَهار",27,"ر",1,0],["وأن مولى الكل عبد الحميد","لركبه الرائع في كل عيد",28,"د",1,0],["وَإِنَّ مَكَانَكُمْ فِي كُلِّ عَصْرٍ","يَحِق لَهُ الوَلاءُ وَالاِحْتِرَامُ",29,"م",1,0],["وَإِنَّمَا سُؤْلُهُ إِعْزَازُ مَوْطِنِهِ","وَقَوْمِهِ بِاتِّحَادِ الرَّأْيِ وَالهِمَمِ",30,"م",1,0],["وَأَنَّ مَا بَيْنَ مَاضِينَا وَحَاضِرَنَا","مِنَ العَلاقَةِ حَبْلاً غَيْرَ مُنْفَصِمِ",30,"م",1,0],["وَإِنَّ مَا أُوخِذْتَ زُوراً بِهِ","بَرَاءةُ الصِّدْقِ وَغُرُّ الشِّيَمْ",31,"م",1,0],["وَإِنَّمَا سِرُّ مَنْ تَعْنُو الرِّجَالُ لَهُ","إِدْرَاكُهُ فِي اخْتِلافِ الْحَالِ سِرَّهُمُ",32,"م",1,0],["وَإِنْ مُنِيتَ بِعُدْمٍ","فَمَا مُرَجِّيكَ عَادِمْ",33,"م",1,0],["وَإنَّمَا ذَنْبُكُمْ ذَنْبُ الأُولَى جَعَلُوا","صِدْقَ الهَوَى لِلحِمَى دِيناً وَتَعْلِيمَا",34,"م",2,0],["وَإِن ماتَ مِنهُم واحِدٌ لا يُهِمُّها","وَإِن ضَلَّ لَم تَتبَعهُ في بَلَدٍ شِبرا",35,"ر",2,0],["وإنما هو يجري في مسالكه","دفعاً بقّوة غازٍ فيه مشبوب",36,"ب",1,0],["وإنما العمر شباب فإذا","زال فحزن وشقاء وضنى",37,"ا",1,0],["وإنما أنتم بنو زمن","إذا ذكرناه تخجل الحقب",38,"ب",1,0],["وإنما العيش للأقوى فمن ضَعُفت","أركانه فهو في الثاوين مُختَرم",39,"م",1,0],["وإن مياه الأرض تَعْذُب ما جرت","ويُفْسدها فوق الصعيد ركودها",40,"د",3,0],["وإنما هي أنفاس مصعَّدةٌ","ترمي بها حسراتي طائرَ الشَرَر",41,"ر",1,0],["وإنما العلم للنُهى عَصَبٌ","والحسّ في الجسم جاء من عصبه",42,"ب",2,0],["وإن من الشعر ائتلاق كواكب","بجنح الدجى باتت يضاحكها البدر",43,"ر",1,0],["وإنما نحن فوق نجم","نحيا محاطين بالهواء",44,"ا",2,0],["وانمار وإن رغِمت أنوفٌ","معديو العمومة والخؤولِ",45,"ل",1,1],["وَإِنَّ مُقيماً مَنهَجَ العَجزِ خائِبٌ","وَإِنَّ مُريغاً خائِبَ الجُهدِ نائِلُ",46,"ل",1,0],["وَإِنَّ مَسامِعي عَن كُلِّ عَذلٍ","لَفي شُغلٍ بِحَمدٍ أَو سُؤالِ",47,"ل",1,0],["وَإِن مُتُّ فَالإِنسانُ لابُدَّ مَيِّتٌ","وَإِن طالَتِ الأَيّامُ وَاِنفَسَحَ العُمرُ",48,"ر",1,0],["وَإِنَّما وَقَّتِ الدُنيا مُوَقِّتَها","مِنهُ وَعُمِّرَ لِلإِسلامِ عامِرُهُ",49,"ر",2,0],["وَإِنَّ مَعاليهِ لَكُثرٌ غَوالِبٌ","وَإِنَّ أَياديهِ لَغُرٌّ غَرائِرُ",50,"ر",1,0],["وَإِنَّما الشِعرُ لُبُّ المَرءِ يَعرِضُهُ","عَلى المَجالِسِ إِن كَيساً وَإِن حُمُقا",51,"ق",2,1],["وأن محمداً لحبيب أنس","وجنهمو لنعليه فداء",52,"ا",2,0],["وأنملٌ في الوغى والسلمِ كاتبةٌ","إما بأسمرَ نضوٍ أو بسمراء",53,"ا",2,0],["وإنما لعليّ في الورى نعم","كادت تعيد لهم شرخ الصبى النائي",54,"ا",2,0],["وإن مشت الآمال نحو جنابه","رأت جود كفَّيه لها كيفَ يهرع",55,"ع",1,0],["وأنمل تحنو على معدمٍ","تحنن الثدِي على المرضع",56,"ع",1,0],["وإن منع الماضون من سعيهم لنا","فإنا عن المسعى لهم ليس نمنع",57,"ع",1,0],["وإنما المفترون قد حفظوا","تلجي الضرورات في الأمور إلى",58,"ل",2,0],["وإن منع الغيَّاب أن يقدموا لنا","فإنا على غيابنا سوف نقدم",59,"م",1,0],["وإنما قومك شهب الهدى","في الأجرِ من صبرهم يرغبون",60,"ن",1,0],["وإنما زار مالكاً فرأى","زَقُّومَ صدقٍ فظل ينتخبُهْ",61,"ب",2,0],["وإنما حاجتي إليه","حاجة ديك إلى دجاجَهْ",62,"ج",2,0],["وأن مَشِيبي واعدٌ بلَحَاقه","وإنْ قال قوم إنه يَتَوَعَّدُ",63,"د",1,0],["وإنَّ مَنْ يَتَمَنَّى أن يُوَاتِيَهُ","رَعْيُ النُّجوم لَمَجْهُودُ المجاهيدِ",64,"د",1,0],["وإن مديحاً لا يُثاب لنُدبةٌ","لميْتٍ وإن لم يُقبرِ الميتَ مُقْبر",65,"ر",1,0],["وإنما هو برد والسلام لهُ","شَفْع وفيك طباع زَنْده واري",66,"ر",2,0],["وإنما الظلم منعُ الشيب لِمّتهُ","عند انقضاء الشباب اللدن والوطر",67,"ر",1,0],["وإنْ مضى رأيه أو حدُّ عزمتِهِ","تأخر الماضيان السيف والقدر",68,"ر",1,0],["وإن منعت الصحاب أكسيةً","تقي أذى القرِّ أو أذى اللثق",69,"ق",1,0],["وإنما الغصنُ يُسقى","مِنْ عِرْقه فتفهَّمْ",70,"م",1,0],["وإنما تتبعُ الأهواءُ قَادتَها","إلى المناظر ذات الزينِ لا الشين",71,"ن",1,0],["وإن مطلتَ فلام الناسُ قال لهم","غيثٌ يجود إذا ما ربُّه أذنا",72,"ن",2,0],["وَإِن ماتَ لَم تَستَبدِلِ الأَرضُ مِثلَهُ","لِأَخذِ نَصيبٍ أَو لِأَمرٍ يَعولُها",73,"ل",3,0],["وَإِن مَضى العافونَ عَن بابِهِ","سارَت عَطاياهُ وَراءَ العُفاة",74,"ه",1,0],["وَإِنَّما أَنكَرَت في الأَرضِ وِحدَتَها","كَذَلِكَ الطَيرُ إِما فارَقَ الوَكرا",75,"ر",2,0],["وَإِنَّما الإِنسانُ أَخلاقُهُ","لا يَستَوي الناقِصُ وَالكامِلُ",76,"ل",1,0],["وَإِن مَرَّ بي طِفلٌ رَأَيتُ بِهِ الوَرى","مِنَ المَثَلِ الأَدنى إِلى المَثَلِ الأَعلى",77,"ل",2,0],["وَإِنَّما أَنتَ وَالأَقوامُ قَد عَلِموا","لَولا خُمولُكَ لَم تَسكُت وَلَم تَنَمِ",78,"م",1,0],["وَإِن مَشَينا فَوقَ كُثبانِها","لاحَت فَشاقَتنا أَدانيها",79,"ي",3,0],["وَإِن مَشى رَأَيتُ فَو","قَ الأَرضِ مِنها غَبَرَه",80,"ر",2,0],["وَإِن مُدَّتِ الأَيدي إِلى الزادِ لَم أَكنُ","بِأَعجَلِهِم إِذ أَجشَعُ القَومِ أَعجَلُ",81,"ل",1,0],["وَإِنَّما أَنا ساعٍ في رِضاك فَإِن","أَخفَقتُ فيه فَلا يُفسَح ليَ العُمُرُ",82,"ر",1,0],["وانما العلم لأد","راك المعالي سلم",83,"م",1,0],["وانما النقد النزيه","نفعه مسلم",84,"م",1,0],["وانما اغراؤهم فتنة","كالنار تحت الحطب اليبس",85,"س",1,0],["وانما في ليلها انجمي","وانما في يومها شمسي",85,"ي",1,0],["وانما غاية الزوجين واحدة","وان تعددت الاسباب والسبل",86,"ل",1,0],["وإنما صقلته ال","خطوب والنكبات",87,"ت",1,0],["وإنما أنا سار في سنا قمر","يقول للبدر في غاياته اكتمل",88,"ل",1,0],["وإن موليير نجم لا أفول له","وأن تغيب في الأحقاب واحتجبا",89,"ب",2,1],["وإن مولاي من سارت مواكبه","لراية الله في أيدي الجماعات",90,"ت",1,0],["وإن ما تشتكي الأوطان من أود","إلى صلاح بنعماه وعمران",91,"ن",1,0],["وإنما الأمم الأخلاق ما بقيت","فإن همو ذهبت أخلاقهم ذهبوا",92,"ب",3,0],["وَأَن مَروانَ إِلَيهِ سلَّما","وَأَن يَومَ الزاب يَكفي سُلَّما",93,"م",2,0],["وَأَنَّ مَناهِلاً كُنّا لَدَيها","سَتَدنو لِلتَأَنُّسِ وَالوُرودِ",94,"د",1,0],["وَإِنَّما أَنا بَعضُ الغابِطينَ وَمَن","يَغبِط وَلِيَّكَ لا يُذمَم وَلا يُلَمِ",95,"م",1,0],["وَإِنَّما يُنَبَّهُ ال","غافِلُ عِندَ الغَرغَرَه",96,"ر",2,0],["وَإِنَّما الأُمَمُ الأَخلاقُ ما بَقِيَت","فَإِن تَوَلَّت مَضَوا في إِثرِها قُدُما",97,"م",2,0],["وَإِنَّ مِنَ العَجائِبِ أَن تَراني","فَتَعدِلَ بي أَقَلَّ مِنَ الهَباءِ",98,"ا",2,0],["وَإِنَّما قُلتُ ما قُل","تُ رَحمَةً لا مَحَبَّه",99,"ب",2,0],["وَأَنَّ مَن بَغدادُ دارٌ لَهُ","لَيسَ مُقيماً في ذَرى عَضبِهِ",100,"ب",2,0],["وَإِنَّ مُحالاً إِذ بِكَ العَيشُ أَن أَرى","وَجِسمُكَ مُعتَلٌّ وَجِسمِيَ صالِحُ",101,"ح",1,0],["وَإِنَّما يُظهِرُ تَحكيمُهُ","تَحَكُّمَ الإِفسادِ في حِسِّهِ",102,"س",2,0],["وَإِنَّما تَحتالُ في جَذبِهِ","كَأَنَّكَ المَلّاحُ في قَلسِهِ",102,"س",2,0],["وَإِنَّما عَرَّضَ اللَهُ الجُنودَ بِكُم","لِكَي يَكونوا بِلا فَسلٍ إِذا رَجَعوا",103,"ع",3,0],["وَإِن مارَيتَني فَاِركَب حِصاناً","وَمَثِّلهُ تَخِرَّ لَهُ صَريعا",104,"ع",2,0],["وَإِنَّما قيلَ لِم خُلِقتَ كَذا","وَخالِقُ الخَلقِ خالِقُ الخُلُقِ",105,"ق",1,0],["وَإِنَّما يَذكُرُ الجُدودَ لَهُم","مَن نَفَروهُ وَأَنفَدوا حِيَلَه",106,"ل",2,0],["وَإِنَّما يَبلُغُ الإِنسانُ طاقَتُهُ","ما كُلُّ ماشِيَةٍ بِالرَحلِ شِملالُ",107,"ل",1,0],["وَإِنَّما الناسُ بِالمُلوكِ وَما","تُفلِحُ عُربٌ مُلوكُها عَجَمُ",108,"م",1,0],["وَإِنَّ مَنِيَّتَهُ عِندَهُ","لَكَالخَمرِ سُقِّيَهُ كَرمُهُ",109,"م",2,0],["وَإِنَّما نَحنُ في جيلٍ سَواسِيَةٍ","شَرٍّ عَلى الحُرِّ مِن سُقمٍ عَلى بَدَنِ",110,"ن",1,0],["وإنما صبغها تولّد من","مزاج أركانها بمقدارِ",111,"ر",1,0],["وإنما تصبو إلى تربها","لأنه في الأصل من جنسِها",112,"س",3,0],["وإنما النار والهواء هما","غذؤه دائما فيا عجبا",113,"ب",2,0],["وإنما هذه الأشياء واحدة","وإن تغاير القاب وأعلامُ",114,"م",1,0],["وإنما أكثروا الأسماء مدهشة","للجاهلين فلا تغترّ وافتكرِ",115,"ر",1,0],["وإنما إكليلها ثديها","يرضعه الأصغر فالأكبر",116,"ر",1,0],["وإنما الصنعة في جنب ما","عَلِّمَنا اللهُ جزاءٌ حقير",117,"ر",1,0],["وإنما تعريض أسلافنا","بالرمز والترجمة الساتره",118,"ر",2,0],["وإن مُتُّ من قبلِ الوصولِ بحسرةٍ","فكم حسراتٍ في نفوسِ كرامِ",119,"م",1,0],["وإن متُّ من قبلِ اللقاءِ فإنَّني","سأُنشَرُ إنْ مرَّتْ عليَّ يَداكُما",120,"م",2,0],["وإنّما رجلُ الدُّنيا وواحِدُها","من لا يعوِّلُ في الدُّنيا على رَجُلِ",121,"ل",1,0],["وإنْ مسَّ عِرنينَ اليَراعةِ كَفُّهُ","تناهتْ وعرنينُ الذوابلِ أجدَعُ",122,"ع",1,0],["وَإِنَّما أُمُّ بَني واصِلٍ","خِنزيرَةٌ سَفسَفتَ في حُبِّها",123,"ب",3,0],["وَإِنَّ مُقامي حَيثُ خَيَّمتُ مِحنَةٌ","تُخَبِّرُ عَن فَهمِ الكِرامِ الأَجاوِدِ",124,"د",1,0],["وَإِن مَلَكتَ اِعتِبادي بِاِرتِجاعَتِهِ","فَالحُرُّ يُملَكُ بِالنُعمى وَيُعتَبَدُ",125,"د",1,0],["وَإِن مِتُّ لَم أَظفَر فَلَيسَ عَلى اِمرِئٍ","غَدا طالِباً إِلّا تَقَصّيهِ وَالجَهدُ",126,"د",1,0],["وَإِن مَشى في فُضولِ الدِرعِ قَلَّصَها","مُبَجَّلٌ بَينَ تَشميرٍ وَإِسبالِ",127,"ل",1,0],["وَإِنَّما هَلَكَت مِن قَبلِكُم إِرَمٌ","لِأَنَّهُم نُصِحوا دَهراً فَما قَبِلوا",128,"ل",3,0],["وَإِنَّما لُؤلُؤَةٌ تَبَسُّمُه","ما غَرَّ دَهراً رابَني تَغَشُّمُه",129,"م",2,0],["وَإِنَّما العارُ أَن يُرى حَذِراً","يُزَيِّنُ الفَقرَ عِندَهُ خَنَتُه",130,"ن",3,0],["وَإِنَّ مُجاشِعاً قَد حَمَّلَتني","أُموراً لَن أُضَيِّعَها كِبارا",131,"ر",2,0],["وَإِنَّ مُناخي فيكُمُ سَوفَ يَلتَقي","بِهِ الرَكبُ مِن نَجدٍ وَأَهلُ المَواسِمِ",132,"م",1,0],["وإن من فتح الأبواب يغلقه","وإن من أشعل النيران يطفيها",133,"ي",3,0],["وَإِن مالا لِوَعثٍ خاذَمَتهُ","بِأَلواحٍ مَفاصِلُها ظِماءُ",134,"ا",2,0],["وَإِنَّما مَثَلُ الآدابِ تَجمَعُها","في عِنفُوانِ الصِبا كَالنَقشِ في الحَجَرِ",135,"ر",1,0],["وَإِنَّما أُمَّهاتُ الناسِ أَوعِيَةٌ","مُستَودِعاتٌ وَلِلأَحسابِ آباءُ",136,"ا",2,0],["وَإِنَّما العِلمُ مِن قِياسٍ","وَمِن عِيانٍ وَمِن سَماعِ",137,"ع",1,1],["وَإِنَّما المَرءُ في الدُنيا بِساعَتِهِ","سائِل بِذالِكَ أَهلَ العِلمِ بِالزَمَنِ",138,"ن",1,0],["وَإِنَّما قالَ قَولاً كانَ غايَتَهُ","أَن صَرَّحَ العُذرَ أَو لِلحالِ قَد شَرَحا",139,"ح",2,0],["وَإِنَّما كانَ اِتَّفاقاً جَرى","وَسَوفَ أَجزيكَ بِهِ عَن قَليل",140,"ل",1,0],["وَإِنَّما الحِكمَةُ في شُربِهِ","شَرابَهُ بَينَ طَعامَينِ",141,"ن",1,0],["وَإِنَّما ذابَ جَليدُ قَلبِهِ","فَطَرفُهُ يَرشَحُ مِن مَعينِهِ",142,"ن",2,0],["وإنما الحبُّ حديثُ العلى","أنشودةُ الخلدِ ونحنُ الرواه",143,"ا",2,0],["وَإنَّما الفكرُ في الأجفانِ مَثَّلَها","فَما كَذَبتُ على جَفني ولا صَدَقا",144,"ق",2,0],["وإنّما يبكي بكائي شجناً","وَوَجِعٌ يعرف فيه وجَعي",145,"ي",1,0],["وإنّما دافعوا عن حتف أنفسهم","إذ خَذّمَتْهُمْ به الهنديّةُ البترُ",146,"ر",1,0],["وإنّما يُحْسِنُ تفسيرَهُ","دَمْعٌ حِمَى السرّ به مُسْتَباح",147,"ح",1,0],["وَإِنَّما الفَتكُ لِذي لَأمَةٍ","شَبعانَ أَو ذي كَرَمٍ جائِعِ",148,"ع",1,0],["وَإِن مَرَرتَ عَلى الرَّوحاءِ فَامرِ لَها","أَخلافَ سارِيَةٍ هَتّانَةِ الدِّيَمِ",149,"م",1,0],["وَإِنَّما هِيَ أَبياتٌ رَجَوتُ بِها","نَيلَ المُنى يَومَ تَحيا بَذَّةُ الرِّمَمِ",149,"م",1,0],["وَإِنَّما نَحْنُ نُطْرِيهِ كَمَا سَبَقَتْ","بِهِ الإِرَادَةُ مِنْ وَصْفٍ وَتِبْيَانِ",150,"ن",1,0],["وإنما ربَّيْتُ غرساً له","نضارةٌ كنتُ بها ذا اهتمامْ",151,"م",1,0],["وإنما خَرْجُ دهري","كذا فنفَّقْتُ نظمي",152,"م",2,0],["وإنما أنا عبدٌ من عبيدِكَ مِنْ","دأبي ابتداءً دعاءٌ صدقُهُ خَبَرُ",153,"ر",1,0],["وإنما كلفتني خطةً","تُوهي قوى المستأسدِ الخادِرِ",154,"ر",1,0],["وإنَّما هي صفوٌ منْ مُمارَسَةٍ","للطارئات، وإمعَانٍ، وتمرين",155,"ن",1,0],["وإنَّما هي نفسٌ همُّ صاحبها","أنْ لا تُصدِّقَ مدحوضَ البراهين",155,"ن",1,0],["وَإِنَّما جالَ بِها ناظِرٌ","في مُقلَةٍ تَنظُرُ زَرقاءِ",156,"ا",2,0],["وَإِنَّما ضاءَ بِلَيلِ الصِبا","صُبحُ مَشيبٍ ساءَني أَن أَضا",157,"ض",2,0],["وَإِن مِتُّ مِن داءِ الصَبابَةِ أَبلِغا","شَبيهَةَ ضَوءِ الشَمسِ مِنّي سَلامِيا",158,"ي",2,0],["وَإِنَّما الرِقَّةُ أَسنى حَلاه","لَيسَ الضَنى عَيباً لِبيضِ الشِفار",159,"ر",1,0],["وَأَنَّ ما جَمَّعَت وَأَعجَبَها","مِن عَيشِها مَرَّةً مُفارِقُها",160,"ق",3,0],["وَإِنَّما صرمي لِغَي","ظِي وَبُعادِي قَرَّبُوا",161,"ب",3,0],["وَإِنَّما رَبِحتُ في التِجارَه","وَلَم أَكُن في المالِ ذا خَسارَه",162,"ه",1,0],["وَإِنَّما كانَ حِدادُ الهيمِ","عَلى الحُسَينِ وَعَلى اِبراهيمِ",162,"م",1,0],["وَإِنَّ محمداً لرَسولُ حَقٍّ","حَسيبٌ في نُبُوَّتِهِ نَسِيبُ",163,"ب",1,0],["وَأَنَّ مَناراً قائماً بإزائها","بَنانٌ إلى فضلِ الأَمِيرِ تشيرُ",164,"ر",1,0],["وَإنَّ مِثْلِي عِندَهْ اليَوْمَ كال","صَخْرَةِ عندَ الجَبلِ الراسِي",165,"ي",1,0],["وإنَّ مَنْ باعَ في الدُّنيا مَحَبَّتُهُمْ","بِبُغْضِهِ اللهَ في الأُخْرَى لَمَرْذُولُ",166,"ل",1,0],["وَإنَّما ذاكَ مَجْهُودِي وَمَقْدِرَتِي","وَطاقَتِي في حِجاناتِ الثَّعابِينِ",167,"ن",1,0],["وإنْ مَنَعُوا تَقَوَّلْنا عَلَيْهِمْ","بأنَّهُمْ عُصَاةٌ مُفْسِدُونا",168,"ن",2,0],["وإنّ مُلُوكاً أنْجَبَتْ ليَ مِثْلَهُ","أحَقُّ بني الدنْيا بتأبينِ عاقل",169,"ل",1,0],["وإنّ مُلْكاً أقَرَّ اللّهُ قُبّتَهُ","بابنِ الإمامِ لَمُلْكٌ غيرُ منتقِل",170,"ل",1,0],["وَآنَ مِن شُهدِها وَقتُ الشِيارِ فَلَم","تَلبَث بِأَن شُيِّرَت في يَومِ أَضواءِ",171,"ا",2,0],["وَإِنَّما روحِيَ كُلُّ اِمرِئٍ","مَنزِلُهُ الجَنّاتُ وَالغابُ",172,"ب",1,0],["وَإِن مالَ إِلى الفِقهِ","فَلَلفِقهُ لَهُ أَفسَد",173,"د",1,0],["وَإِنَّما العَبّاسُ في قَومِهِ","كَالثومِ بَينَ الوَردِ وَالآسِ",174,"س",1,0],["وَأَنمَرِ الجِلدَةِ صَيَّرتُهُ","في الناسِ زاغاً أَو شِقِرّاقا",175,"ق",2,1],["وإن مالَ إلى الرأي","فللرأي لهُ أَفسد",176,"د",1,0],["وَإِنَّ موسى وَموسى أَيُّما مَلِكٍ","عَلَيهِ بَعدَ عَمودِ الدينِ يُعتَمَدُ",177,"د",1,0],["وَإِن مَرَّ مُجتازٌ عَلَينا تَقَنَّعَت","مَخافَةَ قَولِ الفاحِشِ المُتَزَيِّدِ",178,"د",1,0],["وَإِن مالَ بِها النِسيا","نُ ذَكَّرتِ وَسَمَّيتِ",179,"ت",1,0],["وَإِن مَضَت في الهَواءِ الرَحبِ هالِكَةً","هَلاكَ جِسمِيَ في تُربي فَواشجَبا",180,"ب",2,0],["وَإِنَّما الجِسمُ تُربٌ خَيرُ حالَتِهِ","سُقيا الغَمائِمِ فَاِستَسقوا لَهُ السُحُبا",181,"ب",2,0],["وَإِن مُدِحتُ بِخَيرٍ لَيسَ مِن شِيَمي","حَسِبتُني بِقَبيحِ الذَمِّ فُرّيتُ",182,"ت",1,0],["وَإِنَّما حَمَّلَ التَوراةَ قارِئَها","كَسبُ الفَوائِدِ لا حُبُّ التِلاواتِ",183,"ت",1,0],["وَإِنَّ مُقاتِلَ الفُرسانِ عِندي","مَصارِعُ تِلكُمُ الغُنمِ الرُبابِ",184,"ب",1,0],["وَإِنَّما الخَودَ في مَسارِبِها","كَرَبَّةِ السُمِّ في تَسَرُّبِها",185,"ب",3,0],["وَإِنَّما غودِرَ في مُدَّني","كَقابِ قَوسٍ مُدَّ أَو بَعضِ قاب",186,"ب",1,0],["وَإِنَّ مِنهاجَ الرَدى يَستَوي","فيهِ مَسوَدُ القَومِ وَالسائِدُ",187,"د",1,0],["وَإِنَّما يَلقى شُجاعُ الوَغى","كَما يُلاقي النافِرُ الحائِدُ",187,"د",1,0],["وَإِن مَرَّ الصُوارُ فَلا تَلَفَّت","بِمُطَرَّدِ النَسيمِ إِلى الصُوارِ",188,"ر",1,0],["وَإِنَّما تُحمَدُ رَدانَةٌ","باتَت مِنَ اللَهِ عَلى خِدرِها",189,"ر",3,0],["وَإِنَّما هَذِهِ الدُنِّيا لَنا تَلَفٌ","إِذا الفَقيرُ تَصَدّى لِليَسارِ فَقِر",190,"ر",1,0],["وَإِنَّما سائِسُكُم دائِبٌ يُر","عى المَطايا وَيَسوقُ الحَمير",191,"ر",1,0],["وَإِنَّما جَعَلوا لِلقَومِ مَأَكَلَةً","وَصَيَّروا لِجَميعِ الناسِ ناموسا",192,"س",2,0],["وَإِنَّما هُوَ حَظٌّ لا تُجاوِزُهُ","وَالسَعدُ غَيمٌ إِذا طَلَّ الفَتى وَبَلا",193,"ل",2,0],["وَإِنَّما رامَ نُسواناً تَزَوَّجَها","بِما اِفتَراهُ وَأَموالاً تَمَوَّلَها",194,"ل",3,0],["وَإِنَّما هِيَ أَقدارٌ مُرَتَّبَةٌ","ما عُلِّقَت بِإِساءاتٍ وَإِجمالِ",195,"ل",1,0],["وَإِنَّما هُوَ تَخليدٌ بِلا أَمَدٍ","تَمضي الدُهورُ وَصالي النارِ ما رُحِما",196,"م",2,0],["وَإِن مَسَّتِ الأَرزاءُ نَفسَكَ لَم يَكُن","لَها ناصِرٌ إِلّا بِحُسنِ التَغَمُّمِ",197,"م",1,0],["وَإِنَّما رامَ عِزّاً في مَعيشَتِهِ","أَو خافَ ضَربَةَ ماضي الحَدِّ قَلّامِ",198,"م",1,0],["وَإِنَّما نَحنُ في سَوداءَ طامِيَةٍ","وَهَل تُخَلِّصُ مِن أَمثالِها السُفُنُ",199,"ن",1,0],["وَإِنَّما يَتَقَضّى المُلكُ مِن غِيَرٍ","كَما تَقَضَّت بَنو نَصرٍ وَغَسّانُ",200,"ن",1,0],["وَإِنَّ مُلوكَ غَسّانٍ تَقَضَّوا","وَلَم يُترَك لَهُم في المُلكِ غُسنَه",201,"ن",2,0],["وَإِنَّما تِلكَ خِفَّةٌ حَدَثَت","عَنها فَجاءَت بِأَثقَلِ الغَبَنِ",202,"ن",1,0],["وَإِنَّما نَحنُ أَسارى بِها","وَسَوفَ تودي بِالأَساري هي",203,"ي",1,0],["وَأَنمى إِلى مَجدٍ تَليدٍ وَسورَةٍ","تَكونُ تُراثاً عِندَ حَيٍّ لِهالِكِ",204,"ك",1,0],["وإنما دمع عيني","دَليل آلام قَلبي",205,"ي",1,0],["وإنما عادة الإنسان ناجمة","من المحيط بفعل فيه متصل",206,"ل",1,0],["وأن منه نزولي","ميسر كطُلوعي",207,"ي",1,0],["وإنما العقل نبراسٌ لحامله","يضئ ما حوله في سدفة الريب",208,"ب",1,0],["وإنما العز مشروح خلاصتُه","في متن أبيضَ ماضي الغرب ذي شطب",208,"ب",1,0],["وأنّ من بغداد دارٌ له","ليس مقيماً في ذرا عضبه",209,"ب",2,0],["وإنّ مديح النّاس حقٌّ وباطلٌ","ومدحك حقٌّ ليس فيه كذاب",210,"ب",1,0],["وأن مصر بحريَّاتها ظفِرتْ","فأهلها اليوم أحرارٌ أعزَّاءُ",211,"ا",2,0],["وإنّ مِن الصَّراةِ إلى مَجَرّ ال","فُراتِ إلى قُوَيْقٍ مُسْتَرَادا",212,"د",2,0],["وإن ملكت مرة أن تصنَعَه","فاخش بأن تخلقه وتُصْنِعَه",213,"ه",1,0],["وَإِنَّما هِيَ شورى اللَهِ جاءَ بِها","كِتابُهُ الحَقُّ يُعليها وَيُغليها",214,"ي",3,0],["وإِنَّما اعتلَّ منَ الأجزاءِ","في الفصلِ والغائي والابتداءِ",215,"ا",2,0],["وإِنَّما عَروضُ كُلِّ قافِيهْ","جارٍ على أجزائهِ الثَّمانِيَهْ",215,"ه",1,0],["وإنّما تَدخلُ في الأسبابِ","لأنَّها تُعرفُ باضطرابِ",215,"ب",1,0],["وإنَّما أَجازَهُ الخليلُ","مُجازفاً إذ خانَهُ الدَّليلُ",215,"ل",1,0],["وإنَّما يَنفكُّ في الأَوتادِ","فلم يضِرْها الخرمُ في التَّمادي",215,"ي",1,0],["وإنّما تَكونُ في الغاياتِ","تُزادُ في أواخرِ الأَبياتِ",215,"ت",1,0],["وَإِنْ مَرَرْتَ عَلَى الْمِقْيَاسِ فَاهْدِ لَهُ","مِنِّي تَحِيَّةَ نَفْسٍ ذَاتِ أَعْلاقِ",216,"ق",1,0],["وَإِنَّمَا الإِثْمُ حَيْثُما خَبُثَتْ","ضَمَائِرٌ فهْوَ صَنْعَةٌ البَشَرِ",217,"ر",1,0],["وَإِنَّمَا يُنْصِفُ الشَّعْ","بُ حِينَ يُوجِبُ نَصْفَهْ",218,"ف",2,0],["وَإِنَّمَا الأرَاءُ أَنْ تَجْلُوَهَا","مَا تَفْعَلُ السُّيُوفُ فِي الأَغْمَادِ",219,"د",1,0],["وَأَنْمُلاَتٌ بِضَّةٌ تَبْتَنِي","لِمِصْرَ ذُخْراً وَالمَبَانِي جِبَالْ",220,"ل",1,0],["وإِنمَا العَاثِرُ عَنْ وَهْمِهِ","كَالْحَاكِمِ الْهَاوِي عَنِ الكٌرْسِي",221,"س",2,0],["وَإِنَّ مَديحَ الناصِرِ بنِ مُحَمَّدٍ","لَيَصبو إِلَيهِ كُلُّ قَلبٍ وَيَجنَحُ",222,"ح",1,0],["وإِنَّما قُوَّةُ الإنْسانِ ما عَمُرَتْ","عَارِيّةٌ كارتِدَادِ الثَّوب لِلسَّانِ",223,"ن",1,0],["وإنّما أَلجأَنا","إلى هُنَا إِلهنا",224,"ن",2,0],["وَإِنَّما أَطيَبُ أَشعارِهِ","نِصفُ خراسانَ أَو القَيرَوان",225,"ن",1,0],["وَإِنَّما هِيَ أَضغاثٌ تُضَغِّثُها","خَواطِرُ الوَهمِ فيها أَيَّ تَضغيثِ",226,"ث",1,0],["وأنَ ملاعباً ضحِكَتْ زماناً","غدت بيد البِلَى طلَلاً رُكَاما",227,"م",2,0],["وإنَّما الناس ظَعْنٌ","يسيرُ في إثْرِ ظعْنِ",228,"ن",1,0],["وإن مسَّ جُرْحٌ من فِلَسْطين إصْبعاً","شكا حاجِرٌ منه وأنّ المحَصَّبُ",229,"ب",1,0],["وإن متُّ، لم تُنسنيكِ الجنانُ","وَحُورُ الجنَانِ وَولْدَانُها",230,"ن",3,0],["وأنَّ مَن استقر عليه، تُلْقَى","على كتفيه أعباء ثِقَال",231,"ل",1,0],["وإنما القدر المحتوم لاحِقُهم","يومًا، وللقدر المحتوم ميعاد",232,"د",1,0],["وإنما أنا روض والعلوم له","غيث فأي جنى إن شئته تجد",233,"د",1,0],["وأنَّ من حَسَناتِ اليأس أنَّ له","حَدّاً ، اذا كَلَّ حَدُّ غيرهُ قطَعَا",234,"ع",2,0],["وإنما الصُبحُ بالأعمال زاهيةً","لا الوعدُ يُغري ولا الأقوالُ تنتَشِر",235,"ر",1,0],["وإنَّما الحبُّ زَحليٌّ فلا صِلةٌ","ولا صدودٌ ، ولا بُخْلٌ ، ولا جود",236,"د",1,0],["وأنَّ مِن حِكمةٍ أنْ يجتني الرُّطَبا","فردٌ بجَهد ألوفٍ تعلكُ الكَرَبا",237,"ب",2,0],["وإنَّ ممنَ الشّعْر وهو الخيالُ","عروشاً وأنهمُ المالكونا",238,"ن",2,0],["وإنَّما أنا والدُّنيا ومحنتُها","كطالبِ الماء لمَّا غَصَّ بالماء",239,"ا",2,0],["وإنَّ کمْرَأً في بَلْدَة ٍ نِصْفُ نَفْسِهِ","ونِصْفٌ بِأُخْرَى إنَّه لَصبورُ",240,"ر",1,0],["وإِنَّما العَارُ أَن يُرَى حَذِراً","يُزَيِّنُ الفَقرَ عِندَهُ خَنَنُهْ",241,"ن",2,0],["وَإنْ ملكْتَ اعتِبادي بارتِجاعِكَتهُ،","فالحُرُّ يُمْلَكُ بالنُّعمَى، وَيُعتَبَدُ",242,"د",1,0],["وإنْ مُتُّ لمْ أظفَرْ، فلَيسَ على امرِىءٍ","غَدا طالباً، إلاّ تَقَصّيهِ، والجُهْدُ",243,"د",1,0],["وان مرّ طفل رأيت به الورى","من المثل الأدنى الى المثل الأعلى",244,"ل",2,0],["وإنما غُودرَ، في مُدَّنَا","، كقابِ قوسٍ مُدّ أو بعض قاب",245,"ب",1,0],["وإنّما هوَ ترْكُ الشرّ مُطّرَحاً،","ونفضُكَ الصّدْرَ من غِلٍّ ومن حسَد",246,"د",1,0],["وإن من فتح الأبواب يغلقها","وإن من أشعل النيران يطفيها",247,"ي",3,0],["وإنْ مضى رأيه أو حدُّ عزمتِهِ","تأخر الماضي ان لسيف والقدر",248,"ر",1,0],["وإن مت من داءالصبابةفأبلغا","شبيهةضوء الشمس مني سلاميا",249,"ي",2,0]]}