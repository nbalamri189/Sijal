{"poems":[[23,"ولا والله ما تدري هذيل","https://www.aldiwan.net/poem21332.html","الوافر"],[23,"لعمري لقد شانت هذيل بن مدرك","https://www.aldiwan.net/poem21617.html","الطويل"],[53,"ألا ليس شيبك بالمتزع","https://www.aldiwan.net/poem65398.html","المتقارب"],[107,"وضح اليقين لمن يرى أو يسمع","https://www.aldiwan.net/poem44221.html","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54275","الطويل"],[111,"تلك ربوع الحي في سفح النقا ( المقصورة )","https://www.poetsgate.com/ViewPoem.aspx?id=104",""],[208,"حسب الأنام من الأيام ما عرفوا","https://www.aldiwan.net/poem53098.html","البسيط"],[244,"فعالك تسهتوي القلوب فتطرب","https://www.aldiwan.net/poem23839.html","الطويل"],[285,"يقيني يقيني حادثات النوائب","https://www.aldiwan.net/poem60788.html","الطويل"],[290,"فغدت رياض العلم مزهرة فيا","https://www.aldiwan.net/poem39340.html","الكامل"],[309,"أحسنت يا وجيه دين الله","https://www.aldiwan.net/poem16832.html","الرجز"],[310,"دليل اصطفاء الله للعبد علمه","https://www.aldiwan.net/poem56414.html","الطويل"],[353,"ما بعد قربك للآمال منتزح","https://www.aldiwan.net/poem19953.html","البسيط"],[366,"أنا في عرض آل بيت نبي","https://www.aldiwan.net/poem68104.html","الخفيف"],[484,"كيف الصنيع وهم نشاوى بالذي","https://www.aldiwan.net/poem36979.html","الكامل"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130152","الطويل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145848","الخفيف"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126128","الرجز"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126124","الرجز"],[2347,"","https://poetry.dctabudhabi.ae/diwan/poem/89516","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60983","الطويل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93564","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93794","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204793","الخفيف"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118811","السريع"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67995","الطويل"],[3493,"","https://poetry.dctabudhabi.ae/diwan/poem/100575","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62817","المنسرح"],[3544,"","https://poetry.dctabudhabi.ae/diwan/poem/116854","الوافر"],[5186,"حي المشيد للعمران تكريما","https://www.poetsgate.com/ViewPoem.aspx?id=156456",""],[5273,"حقيقة","https://www.poetsgate.com/ViewPoem.aspx?id=191949",""],[5277,"رحيلٌ بلا إياب","https://www.poetsgate.com/ViewPoem.aspx?id=200947",""],[5493,"يا طائرًا بالنور","https://www.poetsgate.com/ViewPoem.aspx?id=197223",""],[5956,"المضحوك عليهم.!","https://www.poetsgate.com/ViewPoem.aspx?id=192182",""],[5956,"حرِّروا نيويورك من صهيونها","https://www.poetsgate.com/ViewPoem.aspx?id=194434",""],[6127,"إلى موسى(ع)","https://www.poetsgate.com/ViewPoem.aspx?id=203675",""]],"verses":[["هُمُ غَرّوا بِذِمَّتِهِم خُبَيناً","فَبِئسَ العَهدُ عَهدُهُمُ الكَذوبُ",0,"ب",1,0],["هُمُ غَدَروا يَومَ الرَجيعِ وَأَسلَمَت","أَمانَتُهُم ذا عِفَّةٍ وَمَكارِمِ",1,"م",1,0],["هم غضبوا للعلا فاشتروا","مدائح بيعت فلم تستبع",2,"ع",1,0],["هم غادروه ثلاثةً في دارِهِ","لا الدّارُ تَلفظهُ ولا هُوَ يَنزعُ",3,"ع",1,0],["هُمُ غَرَسُوا دَوْحَ الحَضَارةِ وارفاً","تُظَللُنا مِنْهُ غُصُونٌ وأَفْرُع",4,"ع",1,0],["هم غربوا وشرقوا وأيمنوا","وأشأموا ومهدوا لنا الذرى",5,"ا",1,0],["هم غافلون وما الآجال غافلةٌ","ومطمئنون والأرواحُ تُختَطَفُ",6,"ف",1,0],["هم غدروا فهداً فكان جزاؤهم","من الله أن ينفوا وأن يتغربوا",7,"ب",3,0],["هُمُ غَادَرُوا بِالْعِزِّ حَصْبَاءَ أَرْضِهِمْ","أَعَزَّ مَنَالاً مِنْ نُجُومِ الْغَيَاهِبِ",8,"ب",1,0],["هم غرة الجبل النفوسي نوره","هم عزه فاهجر مقال الغائب",9,"ب",1,0],["هم غيشاً في المحل والجدوب","وغوثنا في الكرب والخطوب",10,"ب",1,0],["هُمُ غَرسوا دوحَ التمدّن فرعُه الر","رياضيّ وَالعلمُ الطبيعيّ جذمهُ",11,"م",2,0],["هُمْ غُرَّةٌ في جَبِينِ الدَّهْرِ واضِحَةٌ","مِن غَيْرِ سُوْءٍ ولكنْ غَيْرُهُمْ وَضَحُ",12,"ح",1,0],["هُم غياثي من شَرّ يَوم عَبوس","اِنَّهُ كانَ شَرّ مُستَطيرا",13,"ر",2,0],["هم غربوا وأنا المشرق بينهم","شتان بين مشرق ومغرب",14,"ب",1,0],["هم غرسوا بالحلم اشجار مجدهم","ومذ أينعت بالحلم تجنى ثمارها",15,"ر",3,0],["هُمْ غبارٌ بشسعِ نعلِكَ ماذا","لو على نعلِكَ استقرَ الغبارُ",16,"ر",1,0],["هم غرسوا وغيرهم يجني الثمر","أكثرهم غرساً",17,"س",2,0],["هم غرسوا وغيرهم يجني الثمر","أكثرهم غرسا أبو حفص عمر",18,"ر",1,0],["هم غضبوا لما اغتصبنا تراثهم","بمكة والإخوان للضيم تغضب",19,"ب",1,0],["هُمُ غدوره كي يكونوا مكانه","كما غدرت قدماً بكسرى مرازبه",20,"ه",1,1],["هُم غادروا نَهج الضَلالة طامِساً","وَأَبدوا لَنا نَهج الرَشاد وَأَوضَحوا",21,"ح",3,0],["هم غرة في جبهة الدنيا بدت","تزهو ببهجتها كنجم ناجم",22,"م",1,0],["هم غريبون رغم قرب لسان","غربة في الصفات والعزمات",23,"ت",1,0],["هم غيبوني عن جميع الورى","وحرروني من شهود السوى",24,"و",2,0],["همُ غرسوا بَيْنَ الأَضالع والحَشَا","هواهم وفيهم لو علمت هوائيا",25,"ي",2,0],["هم غرر في جبهة المجد والعلى","شباب تسامى للعلى وكهول",26,"ل",1,0],["هُمُ غنمٌ في حِماكَ راتعةٌ","وصبيةٌ في يديكَ أغمارُ",27,"ر",1,0],["هُمُ غضبوا لنا وحَنَوا علينا","كما تحنو على البَوِّ الرَّؤومُ",28,"م",1,0],["هم غنموا الجور في نادي معاهدهم","وغرموا العدل والإحسان تغريما",29,"م",2,0],["هُمْ غَارِقونَ بِعَتْمِ ليلِ نُفُوسِهِمْ","وأنا بِلَيْلِكَ في الضِّياءِ سَأغرَقُ",30,"ق",1,0],["هم غادروكَ...ورمحَ الفقدِ يرتكزُ","ومخرزٌ تحتَ رحلِ القلبِ قد غرزوا",31,"ز",3,1],["همْ غصّةٌ في القلبِ شقَّ زوالُها","همْ في فمِ الأحرارِ محضُ لجامِ",32,"م",1,0],["همُ غشوهم ولكن سوف يلقَ","ون قريباً بعد وهمٍ مقلبا",33,"ب",2,0],["هم غزوا غزة هذي بغتة","بجواسيس هدتهم للغلَبْ",34,"ب",1,0],["هُمْ غَيَّبُوكَ، وقالوا غابَ عائِلُنا!","فَمَنْ تَرَاهُ يَعُولُ الناسَ مُذْ فَتَرَا",35,"ر",2,0],["هُمْ غالبُوكَ على إيقاظِ مَنْ سُكِرَتْ","أبصارُهُمْ، وتَمَنَّوْا لَيْلَهُمْ دَهَرا",35,"ر",2,0]]}