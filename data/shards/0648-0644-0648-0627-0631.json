{"poems":[[65,"رمى الله سعدا بالذي هو أهله","https://www.aldiwan.net/poem45926.html","الطويل"],[3,"إذا كشف الزمان لك القناع","https://www.aldiwan.net/poem176.html",""],[90,"للمسلمين على نزورة وفرهم","https://www.aldiwan.net/poem44431.html","الكامل"],[90,"تيقظ فما أنت بالخالد","https://www.aldiwan.net/poem44977.html","المتقارب"],[53,"نعال كنباية والعنبر","https://www.aldiwan.net/poem62886.html","الطويل"],[34,"تنادى آل بثنة بالرواح","https://www.aldiwan.net/poem27788.html","الوافر"],[87,"شأنك والدمع والبكاء","https://www.aldiwan.net/poem7111.html","مخلع البسيط"],[30,"رأيت سماء الله والأرض ألقتا","https://www.aldiwan.net/poem5612.html","الطويل"],[68,"رو عظامي بسلا","https://www.aldiwan.net/poem38502.html","مجزوء الرجز"],[48,"إذا وهب الله لي نعمة","https://www.aldiwan.net/poem22377.html","المتقارب"],[34,"","https://poetry.dctabudhabi.ae/diwan/poem/8248","الطويل"],[92,"تحية الحلة","https://www.poetsgate.com/ViewPoem.aspx?id=179146",""],[92,"إلى الشباب السوري","https://www.poetsgate.com/ViewPoem.aspx?id=179164",""],[123,"يا رشأ السدرِ ولو أنني","https://www.aldiwan.net/poem4354.html","السريع"],[147,"ما مرتقاك على من رامه أمم","https://www.aldiwan.net/poem11824.html","البسيط"],[251,"ألا هل فؤادي عن صبا اليوم صافح","https://www.aldiwan.net/poem56331.html","الطويل"],[275,"أرى حبي شرارا مستطيرا","https://www.aldiwan.net/poem35589.html","الوافر"],[354,"إن قلت حل بذا وحا","https://www.aldiwan.net/poem15957.html","مجزوء الكامل"],[369,"نزل الأحبة خطة الأعداء","https://www.aldiwan.net/poem61017.html","الكامل"],[398,"حمدا لرب جل عن نديد","https://www.aldiwan.net/poem53683.html","الرجز"],[408,"لا نال منك فؤادي ما يرجيه","https://www.aldiwan.net/poem46474.html","البسيط"],[438,"احكم على الثقلين الإنس والجان","https://www.aldiwan.net/poem12753.html","البسيط"],[454,"إن العروبة بالإسلام عزتها","https://www.aldiwan.net/poem996.html",""],[505,"أهلا بليلى قد جلت هلالها","https://www.aldiwan.net/poem37710.html","الرجز"],[556,"وزائر زارني وهنا يغالطني","https://www.aldiwan.net/poem47758.html","البسيط"],[563,"قلبي الذي في ذاتكم يتقلب","https://www.aldiwan.net/poem34938.html","الكامل"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[580,"قلبي يقول لطيف منك يطرقني","https://www.aldiwan.net/poem2997.html","البسيط"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87181","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48751","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70724","البسيط"],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105448","المتقارب"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119934","المنسرح"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59414","السريع"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59411","البسيط"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46516","الرجز"],[1415,"","https://poetry.dctabudhabi.ae/diwan/poem/102331","الطويل"],[1513,"","https://poetry.dctabudhabi.ae/diwan/poem/35811","الوافر"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141271","الكامل"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47161","البسيط"],[2406,"","https://poetry.dctabudhabi.ae/diwan/poem/100120","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60827","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60829","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60846","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93708","السريع"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137015",""],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109814","البسيط"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100830","البسيط"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112622","الرجز"],[3386,"","https://poetry.dctabudhabi.ae/diwan/poem/124616","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62971","البسيط"],[3582,"","https://poetry.dctabudhabi.ae/diwan/poem/45257","البسيط"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45736","الكامل"],[3667,"","https://poetry.dctabudhabi.ae/diwan/poem/125785","البسيط"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85204","البسيط"],[3778,"","https://poetry.dctabudhabi.ae/diwan/poem/89989","الطويل"],[4155,"","https://poetry.dctabudhabi.ae/diwan/poem/178123","البسيط"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72457","المنسرح"],[4674,"يا بحر","https://www.poetsgate.com/ViewPoem.aspx?id=207085",""],[5816,"( العبيرية ) في وصف الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=125964",""],[6259,"لو جادهنَّ غداة رمنَ رواحا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59361&r=&rc=9",""],[454,"إن العروبة بالإسلام عزتها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82660&r=&rc=24",""]],"verses":[["وَلَوْ أَرِّقَتْهُ هِمَّةٌ أُمَويَّةٌ","لَما نَامَ عَمّا أَقْتَني مِنْ مَآثِرِ",0,"ر",1,0],["وَلَو أَرسَلتُ رُمحي مَع جَبانٍ","لَكانَ بِهَيبَتي يَلقى السِباعا",1,"ع",2,0],["ولو ارتقوا بجناحه في عصرهم","لأطارهم بقوادم وخوافي",2,"ف",2,0],["ولو أراد دخولاً في جوانحهم","لكي يقيس الخنى فيها بمقياس",3,"س",1,0],["ولو أردنا اللوم أعجزْتَنا","وهل يُنال القمر الأزهر",4,"ر",1,0],["وَلَو أَرسَلتِ تَستَهدينَ نَفسي","أَتاكِ بِها رَسولُكِ في سَراحِ",5,"ح",1,0],["ولو أرادوا متاع دنيا","لأدركوا الحكم والثراء",6,"ا",2,0],["وَلَو أُرسِلَ الروحُ الأَمينُ إِلى اِمرِئٍ","سِوى الأَنبِياءِ المُصطَفَينَ الأَكارِمِ",7,"م",1,0],["وَلَو أَرَدتُ حَصرَ بَع","ضِ وَصفِهِم لَم أُطِقِ",8,"ق",1,0],["وَلَو أُرسِلَت في المَهَبِّ الجَنوب","لَما عَجَزَت عَن سُلوكِ المَهَبّ",9,"ب",1,0],["وَلَو أَرسَلَت يَوماً بُثَينَةُ تَبتَغي","يَميني وَلَو عَزَّت عَلَيَّ يَميني",10,"ن",2,0],["ولو أردَتُم لكانَتْ زينةً لكُمُ","بها يُفاخَرُ ماكرَّ الجديدان",11,"ن",1,0],["ولو أردتُ بكِ التقريع عن مِقَةٍ","لقلتُ : أنفُكِ رغمَ العزِّ مُجتدع",12,"ع",1,0],["ولو أراد اللَّهُ رفقاً به","لم يكحل الأجفانَ بالسحرِ",13,"ر",1,0],["وَلَو أَرَدتَ لَأَغرَيتَ التُرابَ بِهِم","فَلَم يَكُن لَهُمُ في الأَرضِ مُنهَزَمُ",14,"م",1,0],["ولو ارسلتْ وحياً إليّ عرفتُهُ","معَ الرّيحِ في مَوارِها المتناوحِ",15,"ح",1,0],["ولو أرخَيتِهِ رَفَعَتهُ عَيني","وقد رَمقَتكِ ناهبةً جَسورا",16,"ر",2,0],["وَلَو اِرتَأَيتَ رَأَيتَهُ","في العَينِ مِنكَ بِعَينِهِ",17,"ن",2,0],["ولو ارتَضاه خادماً لرأى له","ماذا يُضاعَفُ من سناً وسنَاء",18,"ا",2,0],["وَلَو أَرادَ رَبُّنا أَن يُشتَما","وَفَعَلَ الشاتِمُ ما قَد حَتَما",19,"م",2,0],["وَلَو أَرادَ مَنعَنا بِالقَسرِ","لكانَ سَهلاً ما بِهِ مِن عُسرِ",19,"ر",1,0],["ولو أردْتُ غناءٌ لاَمْتَدحْتُ فتىً","ينالُ مَادِحُه أَقْصى أمانيه",20,"ي",2,0],["ولو أردت بفضلِ القولِ قمتَ به","يوماً مَقاماً بفضلِ حول سحبانِ",21,"ن",1,0],["ولو أردنا له حصراً لأعجزن","فهم على مثل هذا الحال قد دأبوا",22,"ب",3,0],["ولو أراد ذورة البدر بما","أعطاه فضلا ربه لطالها",23,"ل",3,0],["وَلَو أَراد خِداعي غير ذي وَسَنٍ","لَكانَ مِن نيل ما يبغي على غَرَرِ",24,"ر",1,0],["ولوارثيه من البرية صحبة","فهم الرجال ولي إليهم قربة",25,"ه",1,0],["ولو أراد ذلكم ما خصا","به عليا دونهم إذ نصا",26,"ص",2,0],["ولو أَراد لَحَاقي كنتُ أَسبقُه","لكنْ مَدامِعُ عيني سَوف تسْبِقُني",27,"ن",2,0],["وَلَو أَراد مَجيد حَصر ما كَتبت","يُمناه مما يُحلِّي جيد أَزمان",28,"ن",1,0],["ولو ارتضيتم بالنضار شراءها","حالت نضاراً هذه الأهرام",29,"م",1,0],["ولو أردتَ بها صيداً لأصبحَ مِنْ","قنيصك الأيِّلاتُ الغُلْبُ والعُصُم",30,"م",1,0],["ولو أردت تصيد الطائرات بها","لكان من صيدك العِقْبان لا الرخم",30,"م",1,0],["ولو أركبوني حد السيوف","وناب الأسود وسم الأساود",31,"د",1,0],["ولو أراد الحبيب أن لا","يضيمني ما استطاب هجري",32,"ر",2,0],["ولو أردت ألقت لك الأرض ما","في بطنها من كنز أهل الحطام",33,"م",1,0],["ولو أراد كنوز الأرض لتفتحت","ولم يغيب منها عنه محصول",34,"ل",1,0],["وَلَو أَرَدت غَزوَهُم لَم أقدر","إِلا بإتعاب الجِياد الضمر",35,"ر",1,0],["ولو أراد سلوة يشفى بها موجوعه","ثنته نار الوعة تجنها ضلوعه",36,"ع",2,0],["وَلَو أَرسَلتها دَمَغَت رِجالاً","وَصالَت في الأَحِشَّةِ وَالشُؤونِ",37,"ن",1,0],["ولو ارتضى لبرا العوالم قفرةً","وارتاح من تأثير شر عباده",38,"د",2,0],["ولو أرى سيكة تدني مودّته","كان العراق على ملكي ومِنْ خَدَمي",39,"م",2,0],["ولو أراد لأجرى من أنامله","سيلاً يلف حضيض القاع بالأكم",40,"م",1,0],["ولو اراد متابي مَا ذرى وبرى","لإِبنة الكرمِ يتلوها ابنتُ الكرمِ",41,"م",1,0],["ولو أرى لهُمُ نقشاً على حَجَرٍ","قبّلْتُ ذلك حتى يمّحي بفَمِي",42,"م",2,0],["ولو أردتَ الثريا من مطالِعها","قلعتضها وهِي أمُّ السبعةِ الشهبِ",43,"ب",1,0],["وَلو أَردت الحلفَ في وَجهك ال","وضاحِ لَم أَحنث وَلم آثم",44,"م",1,0],["ولو ارسلت رأيك في خفي","لاصبح فيه ليل الشك فجرا",45,"ر",2,0],["ولو ارادت وفاء الفضل ادمعهم","لاستنزفت اسفاً والفضل ما نزفا",46,"ف",2,0],["ولو اردنا جزيناهم بما اكتسبوا","شر الجزاء ولكنا ذوو كرم",47,"م",1,0],["ولو أراد محوَهُم محاهُمُ","عن صفحة الكون وما أبقاهُم",48,"م",1,0],["ولو أردن سجال النيل نلن لهى","تعيى على العد مثل العارض الهتن",49,"ن",1,0],["ولو أَراقَ دماءَ الناسِ كلهِم","ولم يدع لهم لحماً على وضمِ",50,"م",1,0],["وَلَو أَرَدتُ قُفولاً ما تَجَهَّمَني","إِذنُ الأَميرِ وَلا الكِتابِ إِذ رَقَموا",51,"م",3,0],["وَلو اِرتَقوا يَوماً لأَخمصه اِنتَهوا","لِمَراتب ما فَوقَهنَّ عَلاءُ",52,"ا",2,0],["ولو أرومتها تحت الثرى قدمت","وجذعها مات بين الترب ينعفرُ",53,"ر",1,0],["ولو أراد بلمح من نواعسه","أفنى ليوث الشرى من شدة الفرق",54,"ق",1,0],["ولوا رجائي أن يؤوب مسلِّماً","وشيكاً على رَغم العدا زرت ملحي",55,"ي",1,0],["ولو أرادوا جميعاً كتم معجزه","أبى له الله ما يأتون والكرم",56,"م",1,0],["وَلَو أَرادَ سَوقَ كِسرى فارِسٍ","بِها ثَناهُ وَهوَ مَكسُورُ المَطا",57,"ا",1,0],["ولو أردت ازدياد معرفة","فوق الذي قد عرفت لم تزد",58,"د",1,0],["ولو أرسلتَ ماءك لي دموعًا","لما أغنت وما انقطع البكاءُ",59,"ا",2,0],["ولو أرسلت دون السماء ذؤابة","لطيب بين الخافقين عطورها",60,"ر",3,0],["ولو ارتقى شخصُ امرئٍ كمحله","يوماً لصافحتِ النجوم صفاحا",61,"ح",2,0],["ولو أردنا له حصراً لأعجزنا","فهم على مثل هذا الحال قد دأبوا",62,"ب",3,0]]}