{"poems":[[55,"أودع في كل يوم حبيبا","https://www.aldiwan.net/poem30733.html","المتقارب"],[57,"أضن عن الدنيا بطرفي وطرفها","https://www.aldiwan.net/poem26207.html","الطويل"],[88,"علمونا الصبر يطفي ما استعر","https://www.aldiwan.net/poem10353.html","الرمل"],[88,"أثنى الحجيج عليك والحرمان","https://www.aldiwan.net/poem68941.html","الكامل"],[72,"هذا كتاب محب","https://www.aldiwan.net/poem42719.html","المجتث"],[72,"أضنى الفؤاد فمن يريحه","https://www.aldiwan.net/poem42980.html","مجزوء الكامل"],[47,"ضلالا لها ماذا أرادت إلى الصد","https://www.aldiwan.net/poem63507.html","الطويل"],[99,"راحوا بأرواحٍ ظماء","https://www.aldiwan.net/poem24773.html","مجزوء الكامل"],[92,"أرج الشباب وخمره المسكوب","https://www.aldiwan.net/poem60158.html","عموديه"],[76,"ومعين ماء البشر أبرق هشة","https://www.aldiwan.net/poem12839.html","الكامل"],[107,"هدايتك اللهم إني أرى الألى","https://www.aldiwan.net/poem43127.html","الطويل"],[78,"وصحائح مرضى العيون شحائح","https://www.aldiwan.net/poem39292.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42716","الوافر"],[54,"","https://poetry.dctabudhabi.ae/diwan/poem/9487","الرجز"],[100,"أضنيتنى بالهجر","https://www.poetsgate.com/ViewPoem.aspx?id=55337",""],[119,"اضنى وحق الهوى وجدا له حسدي","https://www.aldiwan.net/poem40463.html","عموديه"],[170,"أضنى الهوى جسدي وأكسف بالي","https://www.aldiwan.net/poem46876.html","الكامل"],[203,"إليك فانبئهم بأني كفيتهم","https://www.aldiwan.net/poem45164.html","الطويل"],[275,"خير التقى رفق إنسان بإنسان","https://www.aldiwan.net/poem35216.html","البسيط"],[275,"بروحي التي وقفت واجله","https://www.aldiwan.net/poem35255.html","المتقارب"],[275,"نراودها عجوزا دردبيسا","https://www.aldiwan.net/poem35298.html","الوافر"],[303,"إن كان وصلك لم يدم","https://www.aldiwan.net/poem36806.html","عموديه"],[415,"حتى متى يا قلب لا تستفيق","https://www.aldiwan.net/poem32561.html","السريع"],[422,"أعلمت أي معالم ومعاهد","https://www.aldiwan.net/poem54097.html","الطويل"],[454,"يزهو القريض به","https://www.aldiwan.net/poem972.html",""],[463,"ألا صاحب كالسيف حلو شمائله","https://www.aldiwan.net/poem55994.html","الطويل"],[482,"دعني من العذل يا من بات يلحاني","https://www.aldiwan.net/poem15203.html","البسيط"],[518,"ولما أتونا بالمطايا وقربوا","https://www.aldiwan.net/poem67763.html","الطويل"],[519,"ضربوا القباب وطنبوها بالقنا","https://www.aldiwan.net/poem20802.html","الكامل"],[543,"أضحى الفؤاد متيما","https://www.aldiwan.net/poem47932.html","عموديه"],[556,"هل العز إلا في متون السوابق","https://www.aldiwan.net/poem47358.html","الطويل"],[556,"أضنا بالتواصل والتصافي","https://www.aldiwan.net/poem47391.html","الوافر"],[556,"أضن بنفسي عن هوى البيض كلما","https://www.aldiwan.net/poem48038.html","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122758","البسيط"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62723","الكامل"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35347","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56399","الكامل"],[173,"","https://poetry.dctabudhabi.ae/diwan/poem/29577","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64691","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64709","الكامل"],[1473,"","https://poetry.dctabudhabi.ae/diwan/poem/124024","البسيط"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110239","الطويل"],[2332,"","https://poetry.dctabudhabi.ae/diwan/poem/82126","الطويل"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101703","الكامل"],[2430,"","https://poetry.dctabudhabi.ae/diwan/poem/147414","المتقارب"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93822","الوافر"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100420","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204786",""],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118806","المجتث"],[3206,"","https://poetry.dctabudhabi.ae/diwan/poem/145875","الرمل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68122","البسيط"],[3477,"","https://poetry.dctabudhabi.ae/diwan/poem/132940","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91085","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91426","الكامل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117912","الكامل"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128947","السريع"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131267",""],[3957,"","https://poetry.dctabudhabi.ae/diwan/poem/139396",""],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119615","السريع"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93302","السريع"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104536","السريع"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72673","الرجز"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105193","الكامل"],[4723,"إلى تتيانا","https://www.poetsgate.com/ViewPoem.aspx?id=61757",""],[4778,"أَضْنى فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=193623",""],[4830,"نبضات عاشق","https://www.poetsgate.com/ViewPoem.aspx?id=195005",""],[1901,"أنساك ما سَرَّكَ من بُعدِه","https://www.poetsgate.com/ViewPoem.aspx?id=160412",""],[4888,"لذة","https://www.poetsgate.com/ViewPoem.aspx?id=207678",""],[4942,"إني ٱنطلقت","https://www.poetsgate.com/ViewPoem.aspx?id=188393",""],[5002,"على متن الخيال...","https://www.poetsgate.com/ViewPoem.aspx?id=202663",""],[5064,"مقدّمة منسية لشاعر قديم","https://www.poetsgate.com/ViewPoem.aspx?id=199161",""],[5155,"يا دنيا ..!","https://www.poetsgate.com/ViewPoem.aspx?id=176238",""],[5185,"حلاوة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=72851",""],[5191,"يا من ظلمتَ","https://www.poetsgate.com/ViewPoem.aspx?id=211975",""],[5219,"أضنيت قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=193839",""],[5324,"أضناك ياجرح اصطباري.","https://www.poetsgate.com/ViewPoem.aspx?id=211605",""],[812,"من العقيق ومن تذكاري ذي سلمٍ","https://www.poetsgate.com/ViewPoem.aspx?id=115769",""],[5376,"سمراءُ غيداءُ خلفَ الأسرِ تكويني","https://www.poetsgate.com/ViewPoem.aspx?id=188442",""],[5376,"قمْ للصلاةِ وصلِّ الفجرَ منفردا","https://www.poetsgate.com/ViewPoem.aspx?id=206384",""],[5409,"أهزةٌ أيقظت من روعها البلدا","https://www.poetsgate.com/ViewPoem.aspx?id=155458",""],[5410,"رقيب","https://www.poetsgate.com/ViewPoem.aspx?id=109732",""],[5602,"سمراء","https://www.poetsgate.com/ViewPoem.aspx?id=204986",""],[5672,"كتاب وداد","https://www.poetsgate.com/ViewPoem.aspx?id=215349",""],[5674,"الحزن حبر دواتي","https://www.poetsgate.com/ViewPoem.aspx?id=189930",""],[5674,"ستلقى في رحيلي مصرعك","https://www.poetsgate.com/ViewPoem.aspx?id=192276",""],[5674,"أنت الآمره","https://www.poetsgate.com/ViewPoem.aspx?id=203943",""],[5703,"أشواق وهواجس","https://www.poetsgate.com/ViewPoem.aspx?id=208968",""],[5704,"يا ليت...","https://www.poetsgate.com/ViewPoem.aspx?id=198741",""],[5725,"ومضى الفتى","https://www.poetsgate.com/ViewPoem.aspx?id=177495",""],[5736,"مستاءة لغيابك","https://www.poetsgate.com/ViewPoem.aspx?id=203915",""],[2430,"تأملت اختبر المدعين","https://www.poetsgate.com/ViewPoem.aspx?id=90261",""],[5943,"حبيبتي الشامُ","https://www.poetsgate.com/ViewPoem.aspx?id=34360",""],[5956,"أين قصيدُهُ؟","https://www.poetsgate.com/ViewPoem.aspx?id=182156",""],[5956,"صراع بين التفاؤل والتشاؤم","https://www.poetsgate.com/ViewPoem.aspx?id=207548",""],[6082,"يا قلب","https://www.poetsgate.com/ViewPoem.aspx?id=59132",""],[6093,"إنِّيْ وإنْ كُنْتَ كُلِّيْ","https://www.poetsgate.com/ViewPoem.aspx?id=204933",""],[6102,"حسب الدموع","https://www.poetsgate.com/ViewPoem.aspx?id=183652",""],[5309,"ألشعر عاطفة بروحك تلمع","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573519",""],[5464,"نسيب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66708&r=&rc=9",""],[5001,"سمراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83395&r=&rc=16",""],[6320,"جَوَى الأَشْجَان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84337&r=&rc=34",""]],"verses":[["أَضِنُّ عَلى القَطرِ أَن يَستَهِلَّ","عَلى غَيرِ أَجداثِكُم أَو يَصوبا",0,"ب",2,0],["أَضِنُّ عَن الدُنيا بِطَرفي وَطَرفِها","فَهَل بَعدَ هَذا مِن مَقالٍ لِمُشفِقِ",1,"ق",1,1],["أَضَنِنتُم أَن تُقيموا بَينهُم","شاهِداً مِنّا لِكُتّابِ السِيَر",2,"ر",1,0],["أَضناهُما شَوقٌ قَدِ اِبيَضَّت لَهُ","كَبِداهُما وَتَصَدَّعَ القَلبانِ",3,"ن",1,0],["أَضناهُ فَرطُ اِشتِياقٍ","فَرَقَّ حَتّى كَلامُه",4,"م",2,0],["أَضنى الفُؤادَ فَمَن يُريحُهُ","وَحَمى الرُقادَ فَمَن يُبيحُه",5,"ح",2,1],["أَضِنُّ أَخِلّاءٍ وَضِنُّ أَحِبَّةٍ","فَلا خِلَّةٍ تَصفى وَلا صِلَةٍ تَجدي",6,"د",2,0],["أضنى قواه ولم يدع","من جسمه إلا ذماء",7,"ا",2,0],["أضناهُمُ تعبٌ وخيرُ مجاهدٍ","مُضنى يُعَبِّئُ أمّةً \" متعوب \"",8,"ب",1,0],["أَضنى الحُسامَ حَسادَةً فَفِرِندُهُ","دَمعٌ تَرَقرَقَ فَوقَهُ لَم يَسكُبِ",9,"ب",1,0],["أَضِنُّ بِنَفسي أَن تَسيرَ وَراءَهُم","وَأَخشى عَلَيها عادِياتِ المَهالِكِ",10,"ك",1,0],["أَضْنَينَني بِلواحِظٍ تَشكو الضَّنَى","وَكَسَوْنَني ما هُنَّ مِنْهُ عَوارِي",11,"ر",2,0],["أَضِنُّ بِصَاحِبِي وَأَذُودُ عَنْهُ","وَأَمْنَحُهُ السَّوِيَّةَ فِي الْحُقُوقِ",12,"ق",1,1],["أَضنَيتَهُ فَلَم يُطِق","مِن ضُعفِهِ حَملَ اِسمِهِ",13,"م",2,0],["أضنيتنى بالهجر ما أظلمك","فارحم عسى الرحمن أن يرحمك",14,"ك",1,1],["اضنى وحق الهوى وجدا له حسدي","غزيل قد سقاني المر الوانا",15,"ن",2,1],["أَضنى الهوى جَسدي وأَكسفَ بالي","وحُرمتُ وصلَ الشادِنِ الطّبَّالِ",16,"ل",1,1],["أضنُّ بلفظي أن يقالَ استحقّهُ","على نزعاتِ الهجوِ منه لئيمُ",17,"م",1,0],["أضناهُ داءٌ عياءٌ هدَّ بنيتَهُ","والمرءُ في الداءِ مهدومٌ كبنيان",18,"ن",1,0],["أضنُّ بدقَّةِ هذي القدم","وليسَ أديمي على قدره",19,"ه",1,0],["أضنُّ بقطرةٍ منها وسؤرٍ","فكُن في السَّكب مُحترِساً لميسا",20,"س",2,0],["أَضننتِ حتّى بالخيا","لِ فأيْنَ للعربِ الكَرَم؟",21,"م",1,0],["أضنَاكَ إشفاقُكَ من غَدرِهمْ","وما عَسى يُجدي حِذَارُ الشَّفِيقْ",22,"ق",1,0],["أضناني الشَّوق المبرّح في الحشا","حتَّى خفيت من الضنى عن عابدي",23,"د",2,0],["أضنيت راحلة الوئام ولم تزل","حتى بأعتى نافر تترفق",24,"ق",1,0],["أضنّ به ما ضنّ جفني بمقلتي","فلا أنا مهديه ولا أنا باذلُهْ",25,"ل",2,0],["أضناهمُ الوجدُ والاِرقالُ فوق مَطا","المطيَّ يا بؤسَ أجمالٍ وركبانِ",26,"ن",1,0],["أضن بها عمن يرى الملك دونها","وأبذلها طوعاً لمن لا يريدها",27,"د",3,0],["أضناهُ طولُ نَواكَ حتّى أنّه","دلّ النحولُ على هَواهُ وبرهَنا",28,"ن",2,0],["أضنَى فُؤادى عِندما","لاحظتُه فَتَبَسَّما",29,"ا",1,0],["أضنّاً بتأثيل المودّةِ بيننا","وبذلاً لتقطيع القوى والعلائقِ",30,"ق",1,0],["أَضَنّاً بالتّواصلِ والتّصافي","وبذلاً للتّقاطعِ والتّجافي",31,"ف",2,1],["أضنُّ بِنَفسي عَن هوى البيضِ كلّما","تيقّنت أنّ الحبَّ ذُلٌّ لصاحِبهْ",32,"ب",2,1],["أضُنُّ عَني بٍهِ كَي لا تَبُوحَ بِهِ","جَوارِحي فَلِساني لا يُتَرجِمُهُ",33,"م",2,0],["أضنيتَ جسمي بالبعاد وبالأذى","ورميتَ جفني بالسُهاد وبالقذى",34,"ذ",2,0],["أَضنى الغَزالَةَ حُسنُهُ حَسَداً لِذا","أَبدى عَلَيها لِلأَصيلِ شُحوبا",35,"ب",2,0],["أضنى وأنهك في التقشف جسمه","منذ الصبا لبلوغ سن أكملِ",36,"ل",1,0],["أَضِنُّ بِها عَن غَيرِكُم وَأَصونُها","وَلَو بُعِثَ الطائيُّ ذُو الجودِ أَو كَعبُ",37,"ب",1,0],["أَضْنى فؤادِيَ فتَّانُ الجَمالِ إِذا","طلبتُ شِبْهاً لهُ في النَّاسِ لَم أَصِبِ",38,"ب",1,0],["أَضْناهُ شُرْبُ صُدودِهِ صِرْفاً وَلَوْ","مُزِجَ الوِصالُ بِهِ لَصَحَّ مِزاجُهُ",39,"ج",2,0],["أضنوكَ بالبين حتى قيل من راق","والتفّت الساق يوم اليبن بالساق",40,"ق",1,1],["اضنُّ بشعري ان اغنيه حيث لا","يحلُّ من الآذان اكرمَ آذان",41,"ن",1,0],["أضنوا بما قدمت شيبان وائل","بطرفهم علمي أضن وأرغب",42,"ب",1,1],["أضناه طول أساه حتى إنه","يحكى لفرط ضناه ذاوي آس",43,"س",1,0],["اضن بودي ويسخو به","وَقَدْ كنت أسخو به للودود",44,"د",1,0],["أضن بغمض جفني في هواه","وأسخو بالدموع سخاء سامي",45,"م",2,0],["أضنى فؤاديَ ظبي الفرس حين رنا","بمقلة نفثت بالسحر جفناها",46,"ه",2,1],["أضن أن أودعها","الطرس وان أحملها",47,"ل",3,0],["أضناهُ هجر سعاد","والحال عن ذاك ينبي",48,"ب",2,0],["أضنت النفس بإنكاري وصدي","ودواء النفس بالوصل شفاها",49,"ا",3,0],["أَضْنَى الفؤادَ فمن يُرِيحُهْ","قَمَرِيُّ وجهٍ بل صَبيحه",50,"ه",1,1],["أَضنَيتَ جِسمِي فلم تُغَادرِ","منِّي دليلاً على الوُجُودِ",51,"د",1,0],["أَضنَى الفُؤاد وَأَنضى الجسم زخرفُه","حَتّى إِذا ما ضَفَى ثَوب الغُرور نَضا",52,"ض",2,0],["أَضنى وَضنّ بلفظه","وَالمَوت من ذا وَالضَنى",53,"ن",2,0],["أضنى المحب جمالها وكسته بر","داً أصفراً لما تمادت في الصدود",54,"د",1,0],["أضناني الحب حتى","قد صار جسمي كرسم",55,"م",1,0],["أضن بثغري 