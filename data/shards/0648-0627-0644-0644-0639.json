{"poems":[[580,"لست أدري بأي فتح تهنا","https://www.aldiwan.net/poem3001.html","الخفيف"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124725","البسيط"],[2018,"","https://poetry.dctabudhabi.ae/diwan/poem/76794","الكامل"],[2296,"","https://poetry.dctabudhabi.ae/diwan/poem/138927","الرجز"]],"verses":[["واللَّعين الإِبْرَنْس أَصبح مذبو","حاً تمنَّى لم يَعْدِم اليومَ يُمنا",0,"ن",2,0],["واللعن مختلفٌ فيه وأكثرهم","بفتى بصوم يمين مرسلٍ فسل",1,"ل",1,0],["واللَعْضُ وهو تناولٌ بلسانه","والضادُ بعد الكاف لا تُتَوَهَّمُ",2,"م",1,0],["وأل لعهد وحقيقة وقد","يفيد الاستغراق أو لما انفرد",3,"د",1,0]]}