an.net/poem33688.html","الطويل"],[407,"أبان لنا من دره يوم ودعا","https://www.aldiwan.net/poem50150.html","الطويل"],[417,"تبين حق للعباد وباطل","https://www.aldiwan.net/poem53998.html","الطويل"],[417,"لقد خفقت في النحر ألوية النصر","https://www.aldiwan.net/poem54141.html","الطويل"],[430,"سل البان هل مرت عليه النوافح","https://www.aldiwan.net/poem41406.html","الطويل"],[438,"تبسم برق الحيا فانتحب","https://www.aldiwan.net/poem2604.html","المتقارب"],[438,"لهم طلل ما بين يبرين والحمى","https://www.aldiwan.net/poem2616.html","الطويل"],[442,"دع الزفرات صاعدة طوامي","https://www.aldiwan.net/poem14481.html","الوافر"],[454,"تبارك الله هل كافور فنان","https://www.aldiwan.net/poem61601.html","البسيط"],[459,"قفا نضويكما بالغمر نسأل","https://www.aldiwan.net/poem56264.html","الوافر"],[464,"أكسف من سماء ساقط أم","https://www.aldiwan.net/poem927.html",""],[465,"أيا ملكاً بات صرح العلى","https://www.aldiwan.net/poem3133.html","عموديه"],[465,"أما وابتسام البرق في عابس الدجن","https://www.aldiwan.net/poem3514.html","عموديه"],[465,"خلا منك طرفي والحشا لك أوطان","https://www.aldiwan.net/poem3542.html","عموديه"],[465,"ألمت سليمى والنسيم عليل","https://www.aldiwan.net/poem3634.html","عموديه"],[539,"بما بيننا من حرمة ايها الصحب","https://www.aldiwan.net/poem48303.html","عموديه"],[552,"رقدت وأسهرت ليلا طويلا","https://www.aldiwan.net/poem47320.html","المتقارب"],[552,"أقول لها لما التقينا على منى","https://www.aldiwan.net/poem47696.html","الطويل"],[552,"أما رأيت ضحيا","https://www.aldiwan.net/poem47867.html","المجتث"],[559,"خذا الروح عني فاتحا منك دنها","https://www.aldiwan.net/poem34244.html","الطويل"],[563,"لقد خطرت مخضبة البنان","https://www.aldiwan.net/poem52719.html","الوافر"],[563,"أقول اليوم صار الشرق شرقا","https://www.aldiwan.net/poem52881.html","البسيط"],[576,"تنسك شيطاني فيا ليته غدا","https://www.aldiwan.net/poem3081.html","الطويل"],[576,"ببرقة ثغر لا ببرقة ثهمد","https://www.aldiwan.net/poem3084.html","الطويل"]],"verses":[["لَقَد خِفتُ عَيني أَن تَكونَ طَليعَةً","لَكُم وَفُؤادي أَن يَكونَ دَسيسا",0,"س",2,0],["لَقَد خِفتُ أَن لا تَقنَعَ النَفسُ بَعدَها","بِشَيءٍ مِنَ الدُنيا وَإِن كانَ مَقنَعا",1,"ع",2,1],["لَقَدْ خَلَصَتْ لِلَّهِ مِنْكَ سَجِيَّةٌ","جَزَاكَ عَلَى الإِحْسَانِ مِنْكَ بِإِحْسَانِ",2,"ن",1,0],["لَقَد خارَ مِرداساً عَلى الناسِ قاتِلُه","وَلَو عادَهُ كَنّاتُهُ وَحَلائِلُه",3,"ل",2,0],["لَقَد خَلَّفَ الأَهوازَ مِن خَلفِ ظَهرِهِ","وَزَيدٌ وَراءَ الزابِ مِن أَرضِ كَسكَرِ",4,"ر",1,1],["لَقَد خَطَّ رومِيٌّ وَلا زَعَماتِهِ","لِعُتبَةَ خَطّاً لَم تُطَبَّق مَفاصِلُه",5,"ل",2,0],["لَقَد خَفَقَ النَسرانِ وَالنَجمُ بازِلٌ","بِمَنصَفِ وَصلٍ لَيلَةَ القَومِ كَالنَهبِ",6,"ب",1,1],["لقد خربوا البلاد ودوّخوها","وجُنّوا في تناحُرهم جنونا",7,"ن",2,0],["لَقَد خَزِيَ الفَرَزدَقُ في مَعَدٍّ","فَأَمسى جَهدُ نُصرَتِهِ اِغتِيابا",8,"ب",2,0],["لَقَد خَبَّرَتني النَفسُ أَنّي مُزايِلٌ","شَبابي وَوَصلَ المُنفِساتِ الأَوانِسِ",9,"س",1,0],["لَقَد خاقَت بُحوري أَصلَ تَيمٍ","فَقَد غَرِقوا بِمُنتَطِحِ السُيولِ",10,"ل",1,0],["لَقَد خابَ قَومٌ غابَ عَنهُم نَبِيُّهُم","وَقَد سُرَّ مَن يَسري إِلَيهِم وَيَغتَدي",11,"د",2,1],["لقد خضعت إلى وجدي كما خضعت","إلى المؤيدِ أعناقُ الصناديد",12,"د",1,0],["لقد خفقت منَّا القلوب تشوّقاً","وعدت فكادتْ أن تطير سرورا",13,"ر",2,1],["لقد خلقت للعشق فيكم جوانحي","كما خلق الملك المؤيد للثنا",14,"ن",2,0],["لقد خِيرَ فيه للوزير ولم يزلْ","أبو الصقر مختاراً له الخِيرَاتُ",15,"ت",1,0],["لقد خابَ من أضحى إليك مُبغَّضاً","وأمسى إلى الأعداء فيك مُبغَّضا",16,"ض",2,0],["لقد خُلّطتْ فيه البذورُ بحقِّها","إذا خلّطَ التدبير أهوجُ بطّالُ",17,"ل",1,0],["لَقَد خَشيتُ وُشاةَ الناسِ عِندَكُمُ","وَلا صَحيحَ عَلى الأَعداءِ وَالكَلِمِ",18,"م",1,0],["لَقَد خَرَطوا مِنّي لَأَعبُرَ هارِباً","يُبادِرُ ضَوءَ الصُبحِ سَهماً خَفيدَدا",19,"د",2,0],["لَقَد خُنتُهُ في الوُدِّ إِذ عِشتُ بَعدَهُ","وَما كُنتُ في وُدِّ الصَديقِ بِخَوّانِ",20,"ن",1,0],["لَقَد خابَ الَّذي كُنتَ","لَهُ في شِدَّةٍ ذُخرا",21,"ر",2,0],["لَقَد خِفتُ أَن أَلقى المَنِيَّةَ بَغتَةً","وَفي النَفسِ حاجاتٌ إِلَيكِ كَما هِيا",22,"ي",2,0],["لَقَد خابَ فيها جاهِدٌ وَهوَ ناطِقٌ","وَأُعطِيَ مِنها وادِعٌ وَهوَ مُفحِمُ",23,"م",1,0],["لَقَد خَوَّلَ اللَهُ الإِمامَ مُحَمَّداً","خُصوصَ مَعالٍ في قُرَيشٍ عُمومُها",24,"م",3,0],["لَقَد خابَ مِن أَولادِ دارِمَ مَن مَشى","إِلى النارِ مَشدودَ الخِناقَةِ أَزرَقا",25,"ق",2,1],["لَقَد خُنتَ قَوماً لَو لَجَأتَ إِلَيهِمِ","طَريدَ دَمٍ أَو حامِلاً ثِقلَ مَغرَمِ",26,"م",1,0],["لقد خلَعَتْ بتوبتِكَ المَلاهي","ثيابَ الكِبْرِ واكتسَتِ الخُشوعا",27,"ع",2,0],["لَقَد خابَ مِن غرَّتهُ دُنيا دنِيَّة","وَما هِي وإِن غَرَت قروناً بِباطِلِ",28,"ل",1,1],["لقد خمّسَ التأويبَ والعزمَ والسرى","وعَودَ الفلا عُودٌ عليه صليبُ",29,"ب",1,0],["لَقَد خَلَقَ اللَهُ الهَوى لَكَ خالِصاً","وَمَكَّنَهُ في الصَدرِ مِنّي بِلا غِشِّ",30,"ش",1,0],["لَقَد خَوَّفَتني النائِباتُ صُروفَها","وَلَو أَمَّنَتني ما قَبِلتُ أَمانَها",31,"ن",3,0],["لَقَد خَلَعَت في أَخذِها بِرِدائِهِ","جِهاراً وَما كانَت بِعَهدِيَ تَخلَعُ",32,"ع",1,0],["لَقَد خابَ مَن ظَنَّ الأَساطيلَ عُدَّةً","تَقيهِ الرَدى إِن قامَ لِلحَربِ قائِمُ",33,"م",1,0],["لَقَد خَلَّفتَنا لِخُطوبِ دَهرٍ","غَوالِبَ ما لَنا مِنها اِعتِصامُ",34,"م",1,0],["لَقَد خَلَّفتُها بَعدَ اِبتِذالٍ","لَها وَمَلَلتُها قَبلَ الذَهابِ",35,"ب",1,0],["لَقَد خَبَّت عَلَيكَ وَأَنتَ ساهٍ","فَكُن خِبّاً إِذا لاقَيتَ خِبّا",36,"ب",2,0],["لَقَد خابَ مَن يَبتَغي نُصرَتي","وَعاجِزَةٌ عَن يَميني شِمالي",37,"ل",2,0],["لَقَد خابَ الَّذي حَلَبَت يَداهُ","سَفاهَةَ عَقلِهِ بِأَذىً وَغَرمِ",38,"م",1,0],["لَقَد خَدَعَتني أُمُّ دَفرٍ وَأَصبَحَت","مُؤَيِّدَةً مِن أُمِّ لَيلى بِسُلطانِ",39,"ن",1,0],["لَقَد خرقت منه الرصاصة ساعداً","لسعد طويلاً ثم صدراً له رحبا",40,"ب",2,0],["لَقَد خمد الثوار بعد شبوبهم","وَقَد لا تشب النار بعد خمود",41,"د",1,0],["لقد خاب من يخشى مقالة كاشح","وما فاز باللذات غير جسور",42,"ر",1,0],["لَقَدْ خَفَّفَ الْبَلْوَى وَإِنْ هِيَ أَشْرَفَتْ","عَلَى النَّفْسِ ما أَرْجُوهُ مِنْ مَوْعِدِ الْحَشْرِ",43,"ر",1,0],["لقد خَزِيَتْ بِغَدْرَتِها الحُبورُ","كذاكَ الدّهْرُ ذو صَرفٍ يَدُورُ",44,"ر",1,1],["لَقَد خِفتُ في الدُنيا وَأَيّامِ سَعيِها","وَإِنّي لَأَرجو الأَمنَ بَعدَ وَفاتي",45,"ت",2,0],["لقد خلتُهُ يغني عيالي من الطوى","فكان كمضروبٍ من النقد زائف",46,"ف",1,0],["لقد خَبُثَتْ الأنفاسُ حتى","لروحي منك بالروح اختناق",47,"ق",1,0],["لَقَدْ خِفْتُ ألاّ تَقْنَعَ النَّفْسُ بَعْدَها","بشيءٍ مِنَ الدُّنيا إن كانَ مَقنَعا",48,"ع",2,1],["لقَدْ خَرَطوا مِنّي لأعينَ هارِباً","يُبادِرُ ضوءَ الصُّبحِ سهماً خَفَيدَدَ",49,"د",1,0],["لقد خنت حتّى لا يغار أخو هوى","أحبّك من وجد طريف ملابس",50,"س",1,0],["لقد خبطت كالممطرات وحينما","ظننا بها ريا تجلت غيومها",51,"م",3,0],["لقد خنت الذمام فعد كريما","كريم الاصل راع اللذمام",52,"م",1,0],["لقد خان لؤما نعمة لم يكن بها","لآبائه النذل الجحود رجاء",53,"ا",2,1],["لقد خلع الأغيار بالصدق وانتحى","إلى طور سينا القرب من غير تلوين",54,"ن",1,0],["لَقَد خَلَجَت عَيني وَأَحسِبُ أَنَّها","لِقُربِ أَبي الخَطّابِ ذَلِكَ مَزعَمي",55,"م",2,0],["لَقَد خابَ ما أَمَّلتُ مُذ سِرتُ عَنكُمُ","وَمِن رَكِبَ الآمال لَم يَحمَدِ السُرى",56,"ر",2,0],["لقد خلعَ التصابىَ مستَجدٌّ","نُصولُ هذراه غِمداً مُحلىً",57,"ل",2,0],["لَقَد خُنتَ في صَرفِ صَرفِ الخُطوبِ","قِيامَ المَلِيِّ بِكَشفِ الكُرَب",58,"ب",1,0],["لَقَد خَذَلَتني حينَ حاوَلتُ نَصرَها","وَما زِلتُ غَلّاباً بِها وَهيَ لي جُندُ",59,"د",1,0],["لَقَد خابَ مَن عاداهُ أَخسَرَ خَيبَةٍ","رَسولٌ غَدا لِلوَحي أَحفَظَ عَيبَةٍ",60,"ه",1,0],["لقد خاب ذو علم تعاصى ولم يقم","ويجعل أعداء الإله له شغلا",61,"ل",2,0],["لقد خصك البارى بنصرة دينه","واجماع أهل العلم ما اختلفت فتوى",62,"و",2,0],["لَقَد خِفتُ أَن يَلقانِى المَوتُ بَغتَةَ","وَفِى النَّفسِ حاجاتٌ إِلَيكِ كَما هِيَا",63,"ي",2,0],["لَقَد خَطَّ رَيحانُ الجَمالِ عِذارَهُ","فَأَبدى عَلى وَردِ الخُدودِ اِخضِرارَهْ",64,"ر",2,1],["لقد خِلتُ فضلَ الأفضلَ اختصني به","كعادته لو لم يُزله ذهاب",65,"ب",1,0],["لقد خِفتُ إنْ مرَّ فيها النسيم","فلامَسَ خَدَّيْه أن يجرحه",66,"ه",1,0],["لقد خطوا لكَ السوآ","تِ حرفاً بعدَهُ حرفُ",67,"ف",1,0],["لقد خذل السلوانُ قلبي لأنه","تأمّل خصراً للرَّوادف حامِلا",68,"ل",2,0],["لقد خلت الدنيا خلت من وداده","فأضحيت مقهوراً وخلّفني وحدى",69,"د",2,0],["لقد خلت الدنيا خلت من أحبتي","فيا لك من دنيا تضيم وترهق",70,"ق",1,0],["لقد خدعوا شهماً يغرُّ على الندى","فيسخو بلا منّ ويعطى بلا وعد",71,"د",1,0],["لقد خسف الهلال فكان رهصاً","بموتٍ سوف يعرفه الهلال",72,"ل",1,0],["لقد خاب ظن القوم إن كان غرهم","جنوح البحور الطاغيات إلى الجزر",73,"ر",1,0],["لقد خاب ظن القوم إن ان غرّهم","جنوح البحور الطاغيات إلى الجزر",74,"ر",1,0],["لقد خشينا العدى فأمسى","رسول قبلاتنا الهواء",75,"ا",2,0],["لقد خضعتْ لك شمسُ النهار","وصلِّى لك القمر المستنير",76,"ر",1,0],["لقد خسرت فيه العيينة منقذا","بابعاده والجهل بالعقل يلعب",77,"ب",1,0],["لقد خيّموا قلباً تجلّى صبابةً","وزاد غراماً عنه كلت مصاقع",78,"ع",1,0],["لقد خاب من بالغدر رام محله","كما خاب من يرقى السماء من الجن",79,"ن",1,0],["لَقَد خَاصَمَتنِي دُهَاةُ الرِّجَالِ","وَخَاصَمتُهَا سَنَةً وافِيَه",80,"ف",3,1],["لقد خفَّ القطينُ ولا قطينٌ","لدارٍ رَبعُها خالٍ رثيث",81,"ث",1,0],["لَقَد خصرت بفرقته قريش","وَكان لهم لو اِعتَمَدوه ركنا",82,"ن",2,0],["لقد خاب من حلمه خِفّةً","يشولُ ومن وزرهُ يرجحُ",83,"ح",1,0],["لَقَدْ خَسِروهَا صَفْقةً يَومَ فتَّحَت","عَلَيْهِم سُيوفُ الحَقِّ ما أَشَّبُوا صِفقَا",84,"ق",2,0],["لقد خَبر التجارِبَ منه حَزْمٌ","وقلّبَ دهَره ظهراً لبطن",85,"ن",1,0],["لَقَد خَصَّها مُذ حَلَّ فيها وَعَمَّها","جَمالٌ وَإِجمالٌ وَفَضلٌ وَإِفضالُ",86,"ل",1,0],["لقد خضبت كفها أحمرا","وبعض محاسنها قد كفى",87,"ف",2,1],["لَقَد خابَ الشَقِيُّ وَضَلَّ عَجزاً","وَزالَ القَلبُ مِنهُ عَنِ النِياطِ",88,"ط",1,0],["لَقَد خانَنا فيكَ هذا الزَمان","فَلا كانَ هذا الزَمان الخؤن",89,"ن",1,0],["لقد خيطَتِ الأجفانُ منكم على الكرى","وجَفْني كحيلٌ بالظّلامِ مُسَهَّد",90,"د",1,0],["لَقَد خَدَعَتكَ أَلحاظٌ مِراضٌ","وَتَمَّمَ بِالفُتورِ عَلَيكَ سِحرَه",91,"ر",2,0],["لقَد خَسِرَ الدَّارَينِ مَن صَدَّ وجهَهُ","فَلا أنتَ مُبقِيهِ ولا اللَّهُ راحِمُه",92,"م",2,0],["لقد خمدَت نار المجوس بنوره","وقد حطت الأوثان والكفر ذاهل",93,"ل",1,0],["لقد خسر في دينه ودنياه","وسوف يندم عند ختم الأعمار",94,"ر",1,0],["لقد خفضتَ جناحَ الذلِّ لي أدباً","وقد قضيت لُبَانَاتي وأوطاري",95,"ر",2,0],["لقد خلطت بالإبتداع عقائدُ","ترى كل ذي علم عليها يدافع",96,"ع",1,1],["لَقَد خلقت عَيناه لِلسَّحرِ مَعدِناً","كَما خُلق الطَيموم للجودِ مَنبَعا",97,"ع",2,0],["لقد خاب مسعاه وطال وقوفه","على مطلب ما تحته اليوم طائل",98,"ل",1,0],["لقدْ خَفَقَتْ في النَّحر ألويةُ النَّصْرِ","وكانَ انمحاقُ الشَّرِّ في ذلك النَّحر",99,"ر",1,1],["لقد خضع الأعدا لماضي يراعه","فكيف إذا جاء العدى وهو رامح",100,"ح",1,0],["لقد خصّهُ اللّه بالمكرمات","على من بقي وعلى من ذهب",101,"ب",1,0],["لقد خجِلَت منه السحائبُ فانزوَت","فلمّا أتى جاءته تهمى تزعّما",102,"م",2,0],["لقد خرجوا به وبجانبيه","صواعق دونها صعق القيام",103,"م",1,0],["لقد خُدعنا وإلاَّ فهو ذا مرضٌ","والفجرُ كالسُّقمِ ألوانٌ وألوان",104,"ن",1,0],["لقد خُولستُ وُسطَى العِقدِ منكم","به وخُدِعتُ عن أُخرى القناةِ",105,"ه",1,0],["لقد خلفتنا عطشى حيارى","لنا في النفس حاجات تطوف",106,"ف",1,0],["لقد خاب سعيُ لئيمٍ يقول","مالك أنفع ما تملك",107,"ك",1,0],["لقد خصَّ سكّان الغضا بجوانحي","كما انفردَ الملك المعزّ بما أثني",108,"ن",2,0],["لقد خانني فيها النسيم بضوعه","فيا للغوالي كيف يؤمنُ خوّان",109,"ن",1,0],["لقد خلف المبعوثَ خيرُ خليفة","قؤولٌ لما يرضي الإله فعول",110,"ل",1,0],["لقَد خبثت مِنهم نفوسٌ شَريرَةٌ","وخُبثُ النفُوسِ الداءُ ليسَ له طِبُّ",111,"ب",1,0],["لَقَد خَصّك اللَّه بالمأثُراتِ","إذا ما عُددن عدمن العديلا",112,"ل",2,0],["لقد خان مَن أدّى المحالَ إليكُمُ","ومان علينا في المقال المبلِّغُ",113,"غ",1,0],["لَقد خَلفتُ ألوفاً","للنّاس عهداً ووُدّا",114,"د",2,0],["لقد خُطَّ فيها لو تأملت خطَّها","ألا كل شيء ما خلا الله باطل",115,"ل",1,0],["لقد خَطَرَتْ مخضَّبةَ البَنانِ","كأقلامٍ تَخُطُّ بأُرجُوانِ",116,"ن",1,1],["لَقد خَلَفَ الزَّمانُ اليومَ عَمَّنْ","مَضَى عَنَّا وأيُّ النَّاس يَبْقى",117,"ق",2,0],["لقد خافَ مِنْه وهو في المهد دَهْرُنا","فوطَّأَ أَكْنَافاً له وتَمَهَّدَا",118,"د",2,0],["لقد خِلْتُه لما تفرَّدَ سَالِكاً","إِلى المجدِ يَخْشَى وحشةَ المتفرِّد",119,"د",1,0]]}