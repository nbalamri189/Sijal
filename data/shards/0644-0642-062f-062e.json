tps://www.poetsgate.com/ViewPoem.aspx?id=160690",""],[5616,"حوت","https://www.poetsgate.com/ViewPoem.aspx?id=203472",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5910,"فسبِّحْ بحمدِ اللهِ","https://www.poetsgate.com/ViewPoem.aspx?id=206240",""],[5956,"حكيماً كان سيدنا","https://www.poetsgate.com/ViewPoem.aspx?id=192635",""],[5956,"أعيش بسِجْنٍ من دُخانٍ مسَوَّر","https://www.poetsgate.com/ViewPoem.aspx?id=194481",""],[5956,"نايُ الحب","https://www.poetsgate.com/ViewPoem.aspx?id=206677",""],[5956,"أساريرُ فلسطيني أسير","https://www.poetsgate.com/ViewPoem.aspx?id=207867",""],[6102,"ظهيرة تحت رحمة الكهرباء","https://www.poetsgate.com/ViewPoem.aspx?id=184444",""],[6102,"عَجِيب !!","https://www.poetsgate.com/ViewPoem.aspx?id=184446",""],[6308,"وتسألُ الدار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87722&r=&rc=0",""],[6320,"بَلْسَمُ الرُّوح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84332&r=&rc=29",""],[5126,"ملل ويأس وأفكار سوداء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87789&r=&rc=4",""],[6355,"خائنة الليالي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66560&r=&rc=20",""]],"verses":[["لَقَد خِفتُ عَيني أَن تَكونَ طَليعَةً","لَكُم وَفُؤادي أَن يَكونَ دَسيسا",0,"س",2,0],["لَقَد خِفتُ أَن لا تَقنَعَ النَفسُ بَعدَها","بِشَيءٍ مِنَ الدُنيا وَإِن كانَ مَقنَعا",1,"ع",2,1],["لَقَدْ خَلَصَتْ لِلَّهِ مِنْكَ سَجِيَّةٌ","جَزَاكَ عَلَى الإِحْسَانِ مِنْكَ بِإِحْسَانِ",2,"ن",1,0],["لَقَد خارَ مِرداساً عَلى الناسِ قاتِلُه","وَلَو عادَهُ كَنّاتُهُ وَحَلائِلُه",3,"ل",2,0],["لَقَد خَلَّفَ الأَهوازَ مِن خَلفِ ظَهرِهِ","وَزَيدٌ وَراءَ الزابِ مِن أَرضِ كَسكَرِ",4,"ر",1,1],["لَقَد خَطَّ رومِيٌّ وَلا زَعَماتِهِ","لِعُتبَةَ خَطّاً لَم تُطَبَّق مَفاصِلُه",5,"ل",2,0],["لَقَد خَفَقَ النَسرانِ وَالنَجمُ بازِلٌ","بِمَنصَفِ وَصلٍ لَيلَةَ القَومِ كَالنَهبِ",6,"ب",1,1],["لقد خربوا البلاد ودوّخوها","وجُنّوا في تناحُرهم جنونا",7,"ن",2,0],["لَقَد خَزِيَ الفَرَزدَقُ في مَعَدٍّ","فَأَمسى جَهدُ نُصرَتِهِ اِغتِيابا",8,"ب",2,0],["لَقَد خَبَّرَتني النَفسُ أَنّي مُزايِلٌ","شَبابي وَوَصلَ المُنفِساتِ الأَوانِسِ",9,"س",1,0],["لَقَد خاقَت بُحوري أَصلَ تَيمٍ","فَقَد غَرِقوا بِمُنتَطِحِ السُيولِ",10,"ل",1,0],["لَقَد خابَ قَومٌ غابَ عَنهُم نَبِيُّهُم","وَقَد سُرَّ مَن يَسري إِلَيهِم وَيَغتَدي",11,"د",2,1],["لقد خضعت إلى وجدي كما خضعت","إلى المؤيدِ أعناقُ الصناديد",12,"د",1,0],["لقد خفقت منَّا القلوب تشوّقاً","وعدت فكادتْ أن تطير سرورا",13,"ر",2,1],["لقد خلقت للعشق فيكم جوانحي","كما خلق الملك المؤيد للثنا",14,"ن",2,0],["لقد خِيرَ فيه للوزير ولم يزلْ","أبو الصقر مختاراً له الخِيرَاتُ",15,"ت",1,0],["لقد خابَ من أضحى إليك مُبغَّضاً","وأمسى إلى الأعداء فيك مُبغَّضا",16,"ض",2,0],["لقد خُلّطتْ فيه البذورُ بحقِّها","إذا خلّطَ التدبير أهوجُ بطّالُ",17,"ل",1,0],["لَقَد خَشيتُ وُشاةَ الناسِ عِندَكُمُ","وَلا صَحيحَ عَلى الأَعداءِ وَالكَلِمِ",18,"م",1,0],["لَقَد خَرَطوا مِنّي لَأَعبُرَ هارِباً","يُبادِرُ ضَوءَ الصُبحِ سَهماً خَفيدَدا",19,"د",2,0],["لَقَد خُنتُهُ في الوُدِّ إِذ عِشتُ بَعدَهُ","وَما كُنتُ في وُدِّ الصَديقِ بِخَوّانِ",20,"ن",1,0],["لَقَد خابَ الَّذي كُنتَ","لَهُ في شِدَّةٍ ذُخرا",21,"ر",2,0],["لَقَد خِفتُ أَن أَلقى المَنِيَّةَ بَغتَةً","وَفي النَفسِ حاجاتٌ إِلَيكِ كَما هِيا",22,"ي",2,0],["لَقَد خابَ فيها جاهِدٌ وَهوَ ناطِقٌ","وَأُعطِيَ مِنها وادِعٌ وَهوَ مُفحِمُ",23,"م",1,0],["لَقَد خَوَّلَ اللَهُ الإِمامَ مُحَمَّداً","خُصوصَ مَعالٍ في قُرَيشٍ عُمومُها",24,"م",3,0],["لَقَد خابَ مِن أَولادِ دارِمَ مَن مَشى","إِلى النارِ مَشدودَ الخِناقَةِ أَزرَقا",25,"ق",2,1],["لَقَد خُنتَ قَوماً لَو لَجَأتَ إِلَيهِمِ","طَريدَ دَمٍ أَو حامِلاً ثِقلَ مَغرَمِ",26,"م",1,0],["لقد خلَعَتْ بتوبتِكَ المَلاهي","ثيابَ الكِبْرِ واكتسَتِ الخُشوعا",27,"ع",2,0],["لَقَد خابَ مِن غرَّتهُ دُنيا دنِيَّة","وَما هِي وإِن غَرَت قروناً بِباطِلِ",28,"ل",1,1],["لقد خمّسَ التأويبَ والعزمَ والسرى","وعَودَ الفلا عُودٌ عليه صليبُ",29,"ب",1,0],["لَقَد خَلَقَ اللَهُ الهَوى لَكَ خالِصاً","وَمَكَّنَهُ في الصَدرِ مِنّي بِلا غِشِّ",30,"ش",1,0],["لَقَد خَوَّفَتني النائِباتُ صُروفَها","وَلَو أَمَّنَتني ما قَبِلتُ أَمانَها",31,"ن",3,0],["لَقَد خَلَعَت في أَخذِها بِرِدائِهِ","جِهاراً وَما كانَت بِعَهدِيَ تَخلَعُ",32,"ع",1,0],["لَقَد خابَ مَن ظَنَّ الأَساطيلَ عُدَّةً","تَقيهِ الرَدى إِن قامَ لِلحَربِ قائِمُ",33,"م",1,0],["لَقَد خَلَّفتَنا لِخُطوبِ دَهرٍ","غَوالِبَ ما لَنا مِنها اِعتِصامُ",34,"م",1,0],["لَقَد خَلَّفتُها بَعدَ اِبتِذالٍ","لَها وَمَلَلتُها قَبلَ الذَهابِ",35,"ب",1,0],["لَقَد خَبَّت عَلَيكَ وَأَنتَ ساهٍ","فَكُن خِبّاً إِذا لاقَيتَ خِبّا",36,"ب",2,0],["لَقَد خابَ مَن يَبتَغي نُصرَتي","وَعاجِزَةٌ عَن يَميني شِمالي",37,"ل",2,0],["لَقَد خابَ الَّذي حَلَبَت يَداهُ","سَفاهَةَ عَقلِهِ بِأَذىً وَغَرمِ",38,"م",1,0],["لَقَد خَدَعَتني أُمُّ دَفرٍ وَأَصبَحَت","مُؤَيِّدَةً مِن أُمِّ لَيلى بِسُلطانِ",39,"ن",1,0],["لَقَد خرقت منه الرصاصة ساعداً","لسعد طويلاً ثم صدراً له رحبا",40,"ب",2,0],["لَقَد خمد الثوار بعد شبوبهم","وَقَد لا تشب النار بعد خمود",41,"د",1,0],["لقد خاب من يخشى مقالة كاشح","وما فاز باللذات غير جسور",42,"ر",1,0],["لَقَدْ خَفَّفَ الْبَلْوَى وَإِنْ هِيَ أَشْرَفَتْ","عَلَى النَّفْسِ ما أَرْجُوهُ مِنْ مَوْعِدِ الْحَشْرِ",43,"ر",1,0],["لقد خَزِيَتْ بِغَدْرَتِها الحُبورُ","كذاكَ الدّهْرُ ذو صَرفٍ يَدُورُ",44,"ر",1,1],["لَقَد خِفتُ في الدُنيا وَأَيّامِ سَعيِها","وَإِنّي لَأَرجو الأَمنَ بَعدَ وَفاتي",45,"ت",2,0],["لقد خلتُهُ يغني عيالي من الطوى","فكان كمضروبٍ من النقد زائف",46,"ف",1,0],["لقد خلفت ذا قلب طعين","بفقدك عل رثيت لذا الطعين",47,"ن",1,0],["لقد خَبُثَتْ الأنفاسُ حتى","لروحي منك بالروح اختناق",48,"ق",1,0],["لَقَدْ خِفْتُ ألاّ تَقْنَعَ النَّفْسُ بَعْدَها","بشيءٍ مِنَ الدُّنيا إن كانَ مَقنَعا",49,"ع",2,1],["لقَدْ خَرَطوا مِنّي لأعينَ هارِباً","يُبادِرُ ضوءَ الصُّبحِ سهماً خَفَيدَدَ",50,"د",1,0],["لقد خنت حتّى لا يغار أخو هوى","أحبّك من وجد طريف ملابس",51,"س",1,0],["لقد خلفت ذا قلب طعين","بفقدك هل رثيت لذا الطعين",52,"ن",1,0],["لقد خبطت كالممطرات وحينما","ظننا بها ريا تجلت غيومها",53,"م",3,0],["لقد خنت الذمام فعد كريما","كريم الاصل راع اللذمام",54,"م",1,0],["لقد خان لؤما نعمة لم يكن بها","لآبائه النذل الجحود رجاء",55,"ا",2,1],["لقد خلع الأغيار بالصدق وانتحى","إلى طور سينا القرب من غير تلوين",56,"ن",1,0],["لَقَد خَلَجَت عَيني وَأَحسِبُ أَنَّها","لِقُربِ أَبي الخَطّابِ ذَلِكَ مَزعَمي",57,"م",2,0],["لَقَد خابَ ما أَمَّلتُ مُذ سِرتُ عَنكُمُ","وَمِن رَكِبَ الآمال لَم يَحمَدِ السُرى",58,"ر",2,0],["لقد خلعَ التصابىَ مستَجدٌّ","نُصولُ هذراه غِمداً مُحلىً",59,"ل",2,0],["لَقَد خُنتَ في صَرفِ صَرفِ الخُطوبِ","قِيامَ المَلِيِّ بِكَشفِ الكُرَب",60,"ب",1,0],["لَقَد خَذَلَتني حينَ حاوَلتُ نَصرَها","وَما زِلتُ غَلّاباً بِها وَهيَ لي جُندُ",61,"د",1,0],["لَقَد خابَ مَن عاداهُ أَخسَرَ خَيبَةٍ","رَسولٌ غَدا لِلوَحي أَحفَظَ عَيبَةٍ",62,"ه",1,0],["لقد خاب ذو علم تعاصى ولم يقم","ويجعل أعداء الإله له شغلا",63,"ل",2,0],["لقد خصك البارى بنصرة دينه","واجماع أهل العلم ما اختلفت فتوى",64,"و",2,0],["لَقَد خِفتُ أَن يَلقانِى المَوتُ بَغتَةَ","وَفِى النَّفسِ حاجاتٌ إِلَيكِ كَما هِيَا",65,"ي",2,0],["لَقَد خَطَّ رَيحانُ الجَمالِ عِذارَهُ","فَأَبدى عَلى وَردِ الخُدودِ اِخضِرارَهْ",66,"ر",2,1],["لقد خِلتُ فضلَ الأفضلَ اختصني به","كعادته لو لم يُزله ذهاب",67,"ب",1,0],["لقد خِفتُ إنْ مرَّ فيها النسيم","فلامَسَ خَدَّيْه أن يجرحه",68,"ه",1,0],["لقد خطوا لكَ السوآ","تِ حرفاً بعدَهُ حرفُ",69,"ف",1,0],["لقد خذل السلوانُ قلبي لأنه","تأمّل خصراً للرَّوادف حامِلا",70,"ل",2,0],["لقد خلت الدنيا خلت من وداده","فأضحيت مقهوراً وخلّفني وحدى",71,"د",2,0],["لقد خلت الدنيا خلت من أحبتي","فيا لك من دنيا تضيم وترهق",72,"ق",1,0],["لقد خدعوا شهماً يغرُّ على الندى","فيسخو بلا منّ ويعطى بلا وعد",73,"د",1,0],["لقد خسف الهلال فكان رهصاً","بموتٍ سوف يعرفه الهلال",74,"ل",1,0],["لقد خاب ظن القوم إن كان غرهم","جنوح البحور الطاغيات إلى الجزر",75,"ر",1,0],["لقد خاب ظن القوم إن ان غرّهم","جنوح البحور الطاغيات إلى الجزر",76,"ر",1,0],["لقد خشينا العدى فأمسى","رسول قبلاتنا الهواء",77,"ا",2,0],["لقد خضعتْ لك شمسُ النهار","وصلِّى لك القمر المستنير",78,"ر",1,0],["لقد خسرت فيه العيينة منقذا","بابعاده والجهل بالعقل يلعب",79,"ب",1,0],["لقد خيّموا قلباً تجلّى صبابةً","وزاد غراماً عنه كلت مصاقع",80,"ع",1,0],["لقد خاب من بالغدر رام محله","كما خاب من يرقى السماء من الجن",81,"ن",1,0],["لَقَد خَاصَمَتنِي دُهَاةُ الرِّجَالِ","وَخَاصَمتُهَا سَنَةً وافِيَه",82,"ف",3,1],["لقد خفَّ القطينُ ولا قطينٌ","لدارٍ رَبعُها خالٍ رثيث",83,"ث",1,0],["لَقَد خصرت بفرقته قريش","وَكان لهم لو اِعتَمَدوه ركنا",84,"ن",2,0],["لقد خاب من حلمه خِفّةً","يشولُ ومن وزرهُ يرجحُ",85,"ح",1,0],["لَقَدْ خَسِروهَا صَفْقةً يَومَ فتَّحَت","عَلَيْهِم سُيوفُ الحَقِّ ما أَشَّبُوا صِفقَا",86,"ق",2,0],["لقد خَبر التجارِبَ منه حَزْمٌ","وقلّبَ دهَره ظهراً لبطن",87,"ن",1,0],["لَقَد خَصَّها مُذ حَلَّ فيها وَعَمَّها","جَمالٌ وَإِجمالٌ وَفَضلٌ وَإِفضالُ",88,"ل",1,0],["لقد خضبت كفها أحمرا","وبعض محاسنها قد كفى",89,"ف",2,1],["لَقَد خابَ الشَقِيُّ وَضَلَّ عَجزاً","وَزالَ القَلبُ مِنهُ عَنِ النِياطِ",90,"ط",1,0],["لَقَد خانَنا فيكَ هذا الزَمان","فَلا كانَ هذا الزَمان الخؤن",91,"ن",1,0],["لقد خيطَتِ الأجفانُ منكم على الكرى","وجَفْني كحيلٌ بالظّلامِ مُسَهَّد",92,"د",1,0],["لَقَد خَدَعَتكَ أَلحاظٌ مِراضٌ","وَتَمَّمَ بِالفُتورِ عَلَيكَ سِحرَه",93,"ر",2,0],["لقَد خَسِرَ الدَّارَينِ مَن صَدَّ وجهَهُ","فَلا أنتَ مُبقِيهِ ولا اللَّهُ راحِمُه",94,"م",2,0],["لقد خمدَت نار المجوس بنوره","وقد حطت الأوثان والكفر ذاهل",95,"ل",1,0],["لقد خسر في دينه ودنياه","وسوف يندم عند ختم الأعمار",96,"ر",1,0],["لقد خفضتَ جناحَ الذلِّ لي أدباً","وقد قضيت لُبَانَاتي وأوطاري",97,"ر",2,0],["لقد خلطت بالإبتداع عقائدُ","ترى كل ذي علم عليها يدافع",98,"ع",1,1],["لَقَد خلقت عَيناه لِلسَّحرِ مَعدِناً","كَما خُلق الطَيموم للجودِ مَنبَعا",99,"ع",2,0],["لقد خاب مسعاه وطال وقوفه","على مطلب ما تحته اليوم طائل",100,"ل",1,0],["لقدْ خَفَقَتْ في النَّحر ألويةُ النَّصْرِ","وكانَ انمحاقُ الشَّرِّ في ذلك النَّحر",101,"ر",1,1],["لقد خضع الأعدا لماضي يراعه","فكيف إذا جاء العدى وهو رامح",102,"ح",1,0],["لقد خصّهُ اللّه بالمكرمات","على من بقي وعلى من ذهب",103,"ب",1,0],["لقد خجِلَت منه السحائبُ فانزوَت","فلمّا أتى جاءته تهمى تزعّما",104,"م",2,0],["لقد خرجوا به وبجانبيه","صواعق دونها صعق القيام",105,"م",1,0],["لقد خُدعنا وإلاَّ فهو ذا مرضٌ","والفجرُ كالسُّقمِ ألوانٌ وألوان",106,"ن",1,0],["لقد خُولستُ وُسطَى العِقدِ من