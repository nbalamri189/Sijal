الطويل"],[500,"رأيت رسول الله سبعين مرة","https://www.aldiwan.net/poem37969.html","الطويل"],[514,"ما حركت سكنات الأعين النجل","https://www.aldiwan.net/poem20788.html","البسيط"],[514,"ينم عليه الدمع وهو جحود","https://www.aldiwan.net/poem20831.html","الطويل"],[514,"هل المحرم فاستهل مكبرا","https://www.aldiwan.net/poem20838.html","الكامل"],[529,"هب أن بدر التم يوما يأفل","https://www.aldiwan.net/poem37264.html","الكامل"],[551,"صمت العواذل في أساك وسلموا","https://www.aldiwan.net/poem47242.html","الكامل"],[551,"ألا يا ابنة الحيين ما لي وما لك","https://www.aldiwan.net/poem47344.html","الطويل"],[551,"أبي الزمان سوى ما يكره الشرف","https://www.aldiwan.net/poem47404.html","البسيط"],[551,"عجبت لقلبي كيف يصبو ويكلف","https://www.aldiwan.net/poem47405.html","البسيط"],[551,"هبت تلوم على الندى هند","https://www.aldiwan.net/poem47877.html","أحذ الكامل"],[551,"وما مرح الفتى تزور عنه","https://www.aldiwan.net/poem47893.html","الوافر"],[551,"كم ذا سرى بالموت عنا مدلج","https://www.aldiwan.net/poem48018.html","الكامل"],[551,"سائل بيثرب هل ثوى الركب","https://www.aldiwan.net/poem48101.html","أحذ الكامل"],[558,"أنا التعين والرب المهين ما","https://www.aldiwan.net/poem34077.html","البسيط"],[558,"نقطة الكون تحت باء الوجود","https://www.aldiwan.net/poem34601.html","الخفيف"],[558,"تحقق فإن الروح في الكل واحد","https://www.aldiwan.net/poem34622.html","الطويل"],[562,"أتى مثل موسى حينما عاد من مصر","https://www.aldiwan.net/poem52768.html","الطويل"],[567,"عذيري من صرف هذا الزمن","https://www.aldiwan.net/poem69497.html","المتقارب"],[567,"ألم تر أن تكرار الليالي","https://www.aldiwan.net/poem69692.html","الوافر"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[569,"إن أدع مسكينا فما قصرت","https://www.aldiwan.net/poem52007.html","أحذ الكامل"],[575,"أيا دار في جنات عدن له دار","https://www.aldiwan.net/poem2783.html","الطويل"],[575,"يا قاعداً معنا ويزعم","https://www.aldiwan.net/poem2805.html","مجزوء الكامل"],[575,"إنني من عتقائك","https://www.aldiwan.net/poem3042.html","مجزوء الرمل"],[575,"أمجلس لهوي ليس لي منك مجلس","https://www.aldiwan.net/poem3058.html","الطويل"],[586,"عفا الله عن قوم عفا الصبر منهم","https://www.aldiwan.net/poem17715.html","الطويل"],[586,"عذارك من ند يجل عن الند","https://www.aldiwan.net/poem17980.html","الطويل"]],"verses":[["وَيَصحَبُني ذُؤالَةُ مُستَريباً","بِشَخصي في الأَماعِزِ كَالخَفيرِ",0,"ر",1,0],["ويُصيبُ أعْقابَ الأمورِ إذا ارْتَأى","عَفْواً وآراءُ الرِّجالِ تَفيلُ",1,"ل",1,0],["ويُصْبِحُ كلُّ ناجِيَةٍ ذَمولٍ","بهادِيَةٍ كَخُوطِ الخَيْزُرانِ",2,"ن",1,0],["ويَصْبو إِلى وادِيهِ والرّوْضُ باسِمٌ","يُغازِلُهُ عافي النّسيمِ إذا هَبّا",3,"ب",2,0],["وَيَصحَبُني مِن آلِ عَبسٍ عِصابَةٌ","لَها شَرَفٌ بَينَ القَبائِلِ يَمتَدُّ",4,"د",1,0],["وَيَصُدُّ عَنكَ بِوَجهِهِ","وَتُلِحُّ أَنتَ فَلا تُغِبُّهُ",5,"ه",1,0],["وَيَصْغُرُ عِنْدَ الشَّمْسِ في رَوْنَقِ الضُّحَى","سَنَاهَا إِذَا دَارَتْ عَلَيْكَ الْمَوَاكِبُ",6,"ب",1,0],["وَيُصبِحُ كَالسَيفِ الصَقيلِ إِذا غَدا","عَلى ظَهرِ أَنماطٍ لَهُ وَوَسائِدا",7,"د",2,0],["وَيَصولُ بِالأَبدانِ كُلُّ مُسَفَّرٍ","مِثلَ الشِهابِ إِذا تَوَقَّدَ بِالغَضا",8,"ا",1,0],["وَيَصرِفُهُ الهَوى عَن ذِكرِ مِصرٍ","وَمِصرٌ في يَدِ الباغي تُضامُ",9,"م",1,0],["وَيَصيرُ بِالتَرخيمِ إِن نادَيتَهُ","ضداً لِتَصحيفِ الَّذي لا يَنحَلُ",10,"ل",1,0],["ويصاد بين صغاره","إن عز في القحم اصطياده",11,"د",2,0],["وَيَصِيبُ الرِّجَالُ أَسْمَى مَجَالٍ","تَتَجَارَى فِيهِ عُقُولُ الرِّجَالِ",12,"ل",1,0],["ويُصبح كل تمويه وغِشّ","لأنظار البرية مستبينا",13,"ن",2,0],["ويصبح كل خدّاع كذوب","رجيماً في سياسته لعينا",13,"ن",2,0],["ويصبح كل شعب مستقلاً","عزيزاً لن يذِلّ ولن يهونا",13,"ن",2,0],["ويصبح كل محتَرَث مُشاعاً","لمن فيه ثَوَوا متواطنينا",13,"ن",2,0],["ويصقلها الجمال إذا رأته","وتصدئها القبائح والهموم",14,"م",1,0],["ويصدع كلّ بالحقيقة ناطقاً","ويترك ما لم يدر منها لمن يدري",15,"ر",2,0],["وَيَصُدُّ عَنّا الظالِمينَ","إِذا لَقينا القَومَ صيدا",16,"د",2,0],["وَيُصبِحُ الضَيفُ أَولانا بِمَنزِلِنا","نَرضى بِذاكَ وَيَمضي حُكمُهُ فينا",17,"ن",2,0],["وَيَصُدُّ عَنّي المُفحَمونَ كَما","صَدَّ البِكارَةُ عَن حَرى الفَحلِ",18,"ل",1,0],["ويصنع فينا الجودُ صفواً مهنّئاً","ولا حظراً فيه عليك ولا قذى",19,"ذ",2,0],["ويصغي إلى الواشي وليسَ بقائل","ويقضي على علم بكلِّ مخرّق",20,"ق",1,0],["ويصحّ علم الكيمياء وسيفه","فترى اللجين يعود كالعقيان",21,"ن",1,0],["ويصبح المدح إلاَّ في مناقبه","كالبكر زوَّجها الأهلون عنينا",22,"ن",2,0],["ويُصْحبُك الإلهُ على الأَعادي","مساعدةَ المَقادرِ والقضاءِ",23,"ا",2,0],["ويُصِمُّ من سمع الْتِطَا","م الموج فيه واصطخابهْ",24,"ب",2,0],["ويصونُ الوليّ بالجاه والما","لِ كصونِ الكَميِّ نصلَ الحسام",25,"م",1,0],["ويصونون باللُّهى حُرمَ الأع","راض صونَ السيوف بالأجفان",26,"ن",1,0],["وَيَصطَخِبونَ إِن قَرُبَت","وَعِندي يَحسُنُ الطَرَبُ",27,"ب",1,0],["وَيُصبِحُ النابِهُ في مَأمَنٍ","مِن عَنَتِ المالِ وَعَيثِ الحُسام",28,"م",1,0],["وَيُصلى جَحيماً وَهيَ في الحُسنِ جَنَّةٌ","وَيُسقى دِهاقاً وَهيَ صَهباءُ قَرقَفُ",29,"ف",1,0],["ويَصُوغُ أَحلامَ الطَّبيعَةِ فاجعلي","عُمُري نشيداً ساحرَ الأَنغامِ",30,"م",1,0],["ويُصبحُ في ظُلُماتِ القبورِ","هباءً حقيراً وتُرْباً زهيدْ",31,"د",1,0],["ويصبح الجرح الذي","يمضه يلتئم",32,"م",1,0],["ويصحب الناس راض","ين عنه أو جاهلينا",33,"ن",2,0],["وَيُصبِحُ لا غُبارَ عَلى","سَريرَتِهِ كَما يُمسي",34,"ي",1,0],["وَيُصعِدُ في السَماءِ عَلى بُروجٍ","غَداً هِيَ في العالَمِ بارِجاتُ",35,"ت",1,0],["وَيُصانُ مِن سِرِّ الصَبابَةِ عِندَهُ","ما باتَ عِندَ الأَكثَرينَ مُذالا",36,"ل",2,0],["وَيَصطَنِعُ المَعروفَ مُبتَدِئً بِهِ","وَيَمنَعُهُ مِن كُلِّ مَن ذَمُّهُ حَمدُ",37,"د",1,0],["وَيَصدُقُ وَعدُها وَالصِدقُ شَرٌّ","إِذا أَلقاكَ في الكُرَبِ العِظامِ",38,"م",1,0],["ويصِحُّ لي قولُ الوُشاةِ عليكُمُ","فأردُّهُ عنكمْ بظَنٍّ فاسدِ",39,"د",1,0],["ويصدُّنِي حُبُّ المقامِ وأفرُخٌ","زُغْبٌ تَرُدُّ إِذا عزمتُ طِماحِي",40,"ي",1,0],["وَيُصنَعُ في مُعانَدَتي لِقَومٍ","وَبَعضَ الصُنعِ مِن سَبَبٍ بَعيدِ",41,"د",1,0],["وَيُصبِحُ مَعروفاً لَهُ الفَضلُ دونَهُم","وَما يَتَداعاهُ الأَباعِدُ مُنكَرا",42,"ر",2,0],["ويُصبحُ بِشْرُكَ المحجوبُ عَنِّي","يُبَشِّرُني بسَعْدِ إضحِيانِ",43,"ن",1,0],["ويصونُها مسرَى روائِحِها","من أن تباشَرها بشمَّتِها",44,"ت",3,0],["وَيَصدُرُ كُلٌّ إِلى مَوقِفٍ","يُقيمُ الكُهولَ وَأَطفالَها",45,"ل",3,0],["وَيُصبِحُ شاحِطَ المَثوى","مُفَجَّعَةً ثَواكِلُهُ",46,"ل",2,0],["وَيُصبِحُ عَن عَيبِ الخَلائِقِ لاهِياً","وَعَن رَعيِهِم بِالعَدلِ لا يَعرِفُ السَهوا",47,"و",2,0],["وَيُصغونَ لي عِلماً بِأَنّي لِبَحثِهِمُ","عُذَيقُ جَناهُ وَالجُذيلُ المُحَكَّكُ",48,"ك",1,0],["ويصعبُ بعدَ الضّرْبِ إغْمادُ سيفِهِ","لِكُلِّ دَمٍ في مَتْنِهِ غَير سائِلِ",49,"ل",1,0],["ويُصْبحُ سربَ الحَمامِ الحِمامُ","ويَجْنَحُ مثلَ الجناح الخفوق",50,"ق",1,0],["ويصبحُ من وَصْلِ سلمى الغنيّ","يُقَلّبُ منه يَدَيْ مُفْلِسِ",51,"س",1,0],["ويُصميهِ سهمٌ مُصْرَدٌ ليس يُتّقَى","له في الحشا رامٍ تَسَتّرَ بالخلبِ",52,"ب",1,0],["وَيَصرَعُ ساقيها بِإِنصافِ شَربِها","وَصَرعُهُمُ بِالجَورِ في صورَةِ العَدلِ",53,"ل",1,0],["وَيَصعَدُ حَتّى لَظَنَّ الجَهولُ","أَنَّ لَهُ مَنزِلاً في السَماءِ",54,"ا",2,0],["وَيَصْحَبُنِي فِي كُلِّ رَوْعٍ ثَلاثَةٌ","حُسَامٌ وَطِرْفٌ أَعْوَجِيٌّ وَلَهْذَمُ",55,"م",1,0],["وَيَصدَعُ شَملَ اللَيلَةِ الخَبلِ كُلَّما","بَدا فَيلَقٌ مِلءُ الفَضاءِ وَفَيلَقُ",56,"ق",1,0],["ويصعدُ بالذّرى وهي السّنامُ","نَهضتَ لها وما هبَّ النيامُ",57,"م",1,0],["وَيَصُبُّوا عليكَ من صفوةِ الما","لِ حَياً ماطراً وَغيثاً غزيرا",58,"ر",2,0],["وَيُصبِحَ قَبري بَطنَ نَسرٍ مَقيلُهُ","بِجَوِّ السَماءِ في نُسورٍ عَوائِفِ",59,"ف",1,0],["وَيُصبِحُ يَنفُضُ عَنهُ النَدى","كَما هَمَتِ الشَنَّةُ الناضِحَه",60,"ح",2,0],["وَيَصرِفُ أَسرارَ الهَوى عَن عُداتِها","وَيَلقى بِها مِن حُبِّها المُتَلَقِّفا",61,"ف",2,0],["وَيُصمي الفَتى سَهمٌ مِنَ الدَهرِ صائِبٌ","وَإِن صُرِفَت عَنهُ السِهامُ الزَوالِجُ",62,"ج",1,0],["وَيَصيرُ في شَيبانَ مَجنى غَرسِها","وَيَعودُ مَسقِطُ ثَلجِها في آبِها",63,"ب",3,0],["وَيَصيرُ ماقَضى مِنَ ال","أَيّامِ أَحلاماً تُعَبَّر",64,"ر",1,0],["وَيُصبِحُ الجِسمُ بَعدَ الروحِ مُنتَبِذاً","صِفراً كَنَبذِكَ مَكسورَ البَواقيلِ",65,"ل",1,0],["وَيُصبِحُ في الحِجى التَشريقُ رُزءاً","وَأَنّى يُبهِجُ الرُكنَ اِستِلامُ",66,"م",1,0],["وَيُصبِحُ مَنثورُ البِلى كَنَظيمَةٍ","بَناها عُبَيدٌ لا يُقيمُ لَها وَزنا",67,"ن",2,0],["وَيَصهِلُ في مِثلِ جَوفِ الطَوِيّ","صَهيلاً يُبَيّنُ لِلمُعربِ",68,"ب",1,0],["ويصطنع المعروف مبتدئاً به","ويمنعه من كل من ذمه حمد",69,"د",1,0],["ويصور الأحلامَ فتنةَ شاعرٍ","تُوحي الخيالَ لريشة الرسَّامِ",70,"م",1,0],["ويَصُدّ ابنَ دَأيَةَ الجَوْنَ عنها","رَبُّهَا بعدما ثَناها حَسيرا",71,"ر",2,0],["ويَصُدّها قِصَرُ العِنان فما لها","يومَ الرّهانِ إلى الأميرِ وُصولُ",72,"ل",1,0],["وَيَصْحَبُنِي يَوْمَ الْخَلاعَةِ وَالصِّبَا","نَدِيمٌ وَكَأْسٌ رَيَّةٌ وَمُدِيرُ",73,"ر",1,0],["وَيَصْدمُ المَكْرَ غَيْرَ مُلْتَفِتٍ","وَيَقْحَمُ الدَّهْرَ غَيْرَ مُرْتَعِد",74,"د",1,0],["وَيَصْطَفِي رِفَاقَهُ","لِلاِئْتِنَاسِ وَالسَّمَرْ",75,"ر",1,0],["ويَصِيبُ مِنْهُ كُلَّ طَالِبِ نَجْدَةٍ","حَظّاً إِذَا مَا قِيلَ هَلْ مِنْ مُنْجِدِ",76,"د",1,0],["ويصيدُ العدولُ مال اليَتامى","باقتناص كما يصيدُ العقابُ",77,"ب",1,0],["ويصْرَعُ الفارِسَ المِغْوارَ إِن لَعِبَتْ","كَفّاهُ بالسَّيْفِ أرْدَى كلَّ مِغْوَار",78,"ر",1,0],["ويصيبُ «المِكْروبَ» مبضعُ ياس","ينَ» ولو كان في الفؤاد كمينا",79,"ن",2,0],["ويصحو الغرام يرى أنّه","على ظهر أغنية من خشب",80,"ب",1,0],["ويصلّون والمحاريب تستفتي","متى تصبح الأفاعي حمائم ؟",81,"م",1,0],["ويصوغ الصمت ضحى غزلا","وأصيلا ورديا أكحل",82,"ل",1,0],["ويصوغ العالم ثانية","أو يأمره أن يتحول",82,"ل",1,0],["ويصغي ويصغي فلم يستمع","سوى هاتف اللإثم في المسمع",83,"ع",1,0],["ويصرف للكون ما في يديه","وما الكون إلا نذير الفساد",84,"د",1,0],["ويصوغ عطرا كلما شدّ الأسى","بيديه يعرك قلبه الوثّابا",85,"ب",2,0],["ويصور عنترة العبسي","ويصور عرش الإسكندر",86,"ر",1,0],["ويصور عنترة العبسي","يصور عرش الاسكندر",87,"ر",1,0],["ويُصْبِحُ يَنْفُضُ عَنْهُ النَّدَى","لَهُمْ، وبِلاَ أَنْفُسٍ ناصِحَهْ",88,"ح",2,0],["ويصوغ الصمت ضحى غزل","وأصيلا ورديا أكحل",89,"ل",1,0],["ويصفو جوّنا بعد انكدار","ويسقى أرضنا المطر الرّهام",90,"م",1,0],["ويصلح لي من لا يراني صالحا","ويحفظ قلبي في الهوى من يضيعه",91,"ع",2,0],["ويصدبر عنا الناس ريا قلوبهم","ونحن عطاش بينهم نتلهف",92,"ف",1,0],["ويصرف عنك الشيون قلوبهم","وتغضى غداً عنك اللحاظ الغوادر",93,"ر",1,0],["ويصبحُ كلُ ممهَتَنٍ مَهَيباً","ويصبحُ كُلُّ مُغتَرِبٍ قريبا",94,"ب",2,0],["ويصبحُ مَادِرٌ مَعنًى كَمَعنٍ","ويصبحُبَاقِلٌ قسّاً خَطِيبَا",94,"ب",2,0],["وَيُصرعَ حَولَهُ مِنّا رِجالٌ","وَتَمنَعهُ الخُؤولَةُ وَالعُمومُ",95,"م",1,0],["ويصون دين الله من شُبه العدا","ويردّ غارةَ من به يتمارى",96,"ر",2,0],["ويصبح والآلاء ساعدت القوى","على فعل ما يرضى وللشر نباذا",97,"ذ",2,0],["ويصبُّ من سحب الشئون مجلجل","صبا ملث المزن سخ المنسكب",98,"ب",1,0],["ويصبحُ والعفات من الاعادي","نبال كالعقامِ قد استقالوا",99,"ل",3,0],["ويصغر جرم العبد في جنب عفونا","وان كان جر ما مثله يوجب السخطا",100,"ط",2,0],["ويصيبها خير فتحسبه لها","أبدا وقد أخذته باستحقاقها",101,"ق",3,0],["وَيَصُكُّ البيضَ بِالبيضِ إِذا","حُطِّمَت في الصيدِ أَطرافُ الصِعادِ",102,"د",1,0],["وَيُصطَفى مَن أَبُوهُ كانَ عَبدَ أَبي","دُوني وَيُقطَعُ فِيما بَينَكُم رَحِمي",103,"م",2,0],["ويصير عبدا في يديه وخادما","ويصونه ويزيده إشفاقه",104,"ق",2,0],["وَيَصعبُ تغييرُ العقيدةِ بعدما","يَعيشُ عَليها المرءُ في قومهِ عمرا",105,"ر",2,0],["ويصطفي المرءُ ألفَ خلٍّ","ولا يفي منهمُ خليلُ",106,"ل",1,0],["ويصبح ريحانُ الهوى حين نلتقي","نَماءَ المنى من ذلك النظر الشزرِ",107,"ر",1,0],["وَيَصومُ حَتّى لا يُظَنُّ فُطورُهُ","أَبَداً يُريدُ بِهِ رِضى الرَحمَنِ",108,"ن",1,0],["وَيَصْبِرُ لِلْبَلْوَى وَيَحْتَمِلُ الأَذَى","وَيَحْلُمُ عَمَّنْ قَدْ أَسَاءَ وَيَصْفَحُ",109,"ح",1,0],["وَيُصْلِتُ فِيهَا الرُّشْدُ عَضْبَ هِدَايَةٍ","يُصِيبُ ضَلاَلاَتِ الْعِدَا فِي الرَّوَاهِشِ",110,"ش",1,0],["ويصدق فيهم قول من هو مادح","إذا غاب عنهم كوكب لاح كوكب",111,"ب",1,0],["ويصرف من هم ويسعف من اذى","وينصف من ظلم ويكشف من لبس",112,"س",1,0],["ويصفح عفواً عن المذنبين","فيعذر في الدهر من أذنبا",113,"ب",2,0],["ويصنع أسطولا كثيرٌ سفينُه","لصدِّ مغارٍ أو لنقلِ تجارة",114,"ه",1,0],["وَيصدع بالنبر يزان قام خاطِبا","وَيُنسيك تَطريب الحَمامِ المُغَرِدِ",115,"د",1,0],["وَيَصير حظى بالشقاء نَعيما","صلوا عليه وَسَلموا تَسليما",116,"م",2,0],["ويَصْمُدُهُمْ بالعَقْرِ في عَقْرِ دارِهِمْ","لِيُحْيِيَ فيهِمْ سُنَّة الحسِّ والْحَصِّ",117,"ص",1,0],["وَيُصمي قَوسُ حاجِبِهِ بِنَبلِ ال","لَواحِظِ عاشِقيهِ وَلَم يُوَلّوا",118,"ل",3,0],["وَيَصولُ في نادي الجِدالِ كَأَجدَلٍ","كُلٌّ لَدَيهِ كَالقَطا المَقصوصِ",119,"ص",1,0],["وَيُصبحُ الشملُ في اِجتماعٍ","والقربُ من بُعدنا بَديلُ",120,"ل",1,0],["وَيُصبح مَن دوني نَقيعاً أوامُهُ","يَسوغُ له عذبُ الموارد أثعوبُ",121,"ب",1,0],["ويصفه حل وإن تحذف ال","أول من أحرفه لفا",122,"ف",2,0],["ويصلحنا ويمنحنا نعيما","وروحاً في الحياة وفي المآل",123,"ل",1,0],["وَيَصيرُ كَجيفَةٍ","بَل أَخسَ وَأَبشَعُ",124,"ع",1,0],["ويصنوه ووليه وصفيه","المرتضي البر التقي الناصر",125,"ر",1,0],["ويصبو إليهم كلما هبت الصاب","وإن ناحت الورقاء بات مؤرقا",126,"ق",2,0],["ويُصمي من الصمّاء مخرت سمّها","وَمن خطبِ شكلٍ عصل شاكلة الخطبِ",127,"ب",1,0],["وَيصبح من قد سرّ فيّ بعتبكم","مساءً بما أسدت إليّ يد العتبى",128,"ب",2,0],["وَيُصيبُ بَعدَ القادِمَينِ زَميلَها","رَيّانُ ناعَمَ نَبتَهُ إِعقامُها",129,"م",3,0],["وَيَصرَعُ خَصمَهُ ذو الجَهلِ يَوماً","وَيَبطُرُ عِندَ حُجَّتِهِ الجَليدُ",130,"د",1,0],["ويصبح البر من دمانا","ومن دماء العدوّ بحرا",131,"ر",2,0],["ويصرع داء الجسم داء أخفه","سهوم واحدي راحتيه جنون",132,"ن",1,0],["وَيُصبِحُ في اللَيلِ المَديدِ مُنَوِّراً","لِلَيلِ ذَوي الأَبصارِ في البَرِّ وَالبَحرِ",133,"ر",1,0],["وَيصرع قَلبي إِذ تهبُّ هبوبها","أَهيم بِذكراكم إِذا ما تَرَنَّما",134,"ا",1,0],["ويُصلِّي عَلَيَّ حَيّاً شَهيداً","وأُرَوّي من النَجيعِ السِّنانا",135,"ن",2,0],["وَيَصُنَّ الوُجوهَ في المَيسَنانِي","يِ كَما صانَ قَرنَ شَمسٍ غَمامُ",136,"م",1,0],["ويصونُها العلماءُ من نزقِ الهوى","فيعزُّ ساكنها ويأمنُ جارُها",137,"ر",3,0],["ويصحّ عن دعوى الغرام رجوعُه","والبرق يفشي سرَّه ويذيعُه",138,"ه",1,0],["ويَصبو إلى الأَغْصَانِ أغصان رامةٍ","إذا ذكّرتْه قَدَّ مَنْ كَانَ يهواهُ",139,"ه",1,0],["ويصفو العيش بعد كدرته","بما جناه البعاد من درن",140,"ن",1,0],["ويصرف الدمع إلى محاجري","وقد حشاها مبلَّة بالسُّهد",141,"د",1,0],["ويصبح فينا كالمعافى بِخُلْقِهِ","وفي خَلْقِه عما يلاقيه ما ينبي",142,"ب",2,0],["وَيصدُقُ فيهِ المَدحُ حَتّى كَأَنَّما","يَسبح مِن صدق المَقالَةِ شاعِرُهُ",143,"ر",2,0],["وَيصغر كل الناس في جَنب طيىءٍ","وَيصغر في جنب الأَمير كَبيرُها",144,"ر",3,0],["وَيصدق في الهامات إِيماض سَيفِهِ","عَلى أَنَّ إِيماض الصَوارِم خُلَّبُ",145,"ب",1,0],["ويصدّنَا عمّا نُحا","وِله جِهاراً واغْتِيالاَ",146,"ل",2,0],["ويصيبُ والرامي تطيشُ سِهامُه","فلكلِّ سهمٍ من عدُوٍّ مَقْتَلُ",147,"ل",1,0],["ويَصدُقَكِ العيانُ بأي حبلٍ","من ابن العامِرِيِّ وصلتُ حبلي",148,"ي",1,0],["ويُصْلي بِحَرِّ الشمسِ حُرَّ جبينِهِ","ليَبْسُطَ لِلإِسْلامِ من نُورِهِ فَيَّا",149,"ي",2,0],["ويَصْدَعُ مَا ضَمَّ الوَدَاعُ تفرُّقٌ","كما انشَعَبَتْ تَحْتَ العواصِفِ أَغصانُ",150,"ن",1,0],["ويصطنع الاخوان في اللَه إنها","لاغلاق أَبواب المسائل تفتح",151,"ح",1,0],["ويصد سمعا عن حديث مطامع","ومظالم وخيالة وحقود",152,"د",1,0],["ويصبح الكل كي يسير على","يأس على شدة على زلق",153,"ق",1,0],["ويصلح أن يحظى بخدمة مثلكم","فخدمتكم فيها هدى ورشاد",154,"د",1,0],["ويصوغُ للأقدار سيرتها غداً","فَتكيفُ الأحلامَ والأقدارا",155,"ر",2,0],["ويصرع كلَّ جبارٍ سفيهٍ","يُغررُ بالعقول ويستخُّف",156,"ف",1,0],["ويُصغي إليها الآلهُ الطروب","فَيجبلها الروح في الآدمى",157,"م",2,0],["ويصطلمون ما محكوا ولجّوا","وهم خلقاء أن يعفوا ويُبقوا",158,"ق",3,0],["ويصعبُ أحياناً وينتظر الغنى","فيأتي ولم يخضع له وهو طيِّعُ",159,"ع",1,0],["ويُصيبُ مرتجلاً بأوّل خَطْرةٍ","أغراضَ كلِّ مخمِّر ومُبيِّتِ",160,"ت",1,0],["ويَصحُّ معناه ويسلَم لفظُهُ","ونظامُهُ وهناك باقي العلَّةِ",160,"ه",1,0],["ويُصغى له ما لم يكن ذا لُبانَةٍ","فانْ كان لم تُنْصتْ له أذُنانِ",161,"ن",1,0],["ويصدأُ في الطُّول النُّضار تدنساً","وعِرْضك برَّقُ الأديمِ صَقيلُ",162,"ل",1,0],["ويصدقُ وعْدهُ في مُعْتَفيهِ","اذا كَذَبَ البَوارقُ والرُّعودُ",163,"د",1,0],["ويصْدُر السَّفْر عنء سلْسالِ موْرِدِه","وقد سَقَى القَوْمَ منهُ العَلُّ والنَّهلُ",164,"ل",1,0],["ويصلب أن عزه فادح","وإن هزه مادح لأن عودا",165,"د",2,0],["ويصيبُ شاكلة الرقي بسهمهِ","فكأنما يرمي بلحظٍ مرسل",166,"ل",1,0],["ويصدى إلى ماء الملاحة والصّبا","فحدّث بصادٍ وهو في الماءِ سابح",167,"ح",1,0],["وَيصبحَ الزمانُ طلقاً وجهُه","وَتنثني أوقاتُه ربيعا",168,"ع",2,0],["ويصبوا إلى باناتِ سَلْعٍ إذا انبرتْ","تَمايلُ مِن مرَّ الرياحِ النواسمِ",169,"م",1,0],["ويصاخ بالإذعان للأمر الذي","قد قاله للأنبيا التنزيل",170,"ل",1,0],["ويُصلِحُ بالتَّوحيدِ أَوْهامَ قلبِهِ","على منهَجِ الإيمانِ في الجمعِ والفَرْقِ",171,"ق",1,0],["ويُصلِتُني سيفاً على كلِّ بِعدَةٍ","وأَصحابِها أَهْلِ الغَوايَةِ بالطَّبْعِ",172,"ع",1,0],["ويَصدرُ النّبْلُ عنّا ليس يَنفذُنا","إلّا إذا كان مطبوعاً من الكحَلِ",173,"ل",1,0],["ويصحو فتأتيهِ الصِّبا بروايةٍ","عنِ البانِ تسقيهِ الطُّلى فيَميدُ",174,"د",1,0],["ويَصونُها صونَ الكريمِ لعِرْضِه","حتّى له الأجَلُ المُتاحُ تقدّرا",175,"ر",2,0],["ويَصُدُّ إنْ لاحَتْ بُروقُ مَطامِعٍ","تَسْعَى إذَا لَمَعَتْ إليْها الأَرْجُلُ",176,"ل",1,0],["وَيصونُ عِرضَهمُ الّذي شحّوا به","دينارُهمْ في بذلِهِ والدِّرْهَمُ",177,"م",1,0],["ويُصبحُ إمّا مالُهُ في مُلِمَّةٍ","تنوبكُمُ أو شِلْوُهُ للمناهكِ",178,"ك",1,0],["ويصرف الهمَّ عن قلبٍ أطاف به","مَن قلبُهُ لنواصي الهمّ مكتنفُ",179,"ف",1,0],["ويُصبح منّي ساكنَ القلب والحَشا","وفي كلّ يومٍ منه قلبِيَ يرجُفُ",180,"ف",1,0],["وَيَصُدُّ عَن تَزويقِ زينتها","حَيث اِستثيرَ فأعوَزَ الصَّدُّ",181,"د",1,0],["ويُصبِحُ بين إعراضٍ مُبينٍ","بلا سببٍ وهجرانٍ صَراحِ",182,"ح",1,0],["ويُصَدُّ عنك القاصدون فما لهمْ","أبداً على شِعْبٍ حَلَلْتَ مُعَرّجُ",183,"ج",1,0],["وَيَصدُّ عَنّي غَيرَ مُحتَشِمٍ","مُتَيقّنٌ أَنّي بهِ صَبُّ",184,"ب",1,0],["ويصبح القطب في سامي دوائره","وفي الحقائق يمسي المفرد العلما",185,"م",2,0],["ويصير الوجود عنك خفياً","لست تدري منه سوى فرط جود",186,"د",1,0],["ويصبح مشغولاً ويمسي بنفسه","وقلب له في كل ما عاق زاهد",187,"د",1,0],["ويصبو إلى بِيضِ الطُّروسِ وسُودِها","من الحِبرِ لا بِيضَ الدَّراهمِ والصُّفرِ",188,"ر",1,0],["وَيَصْرِفُ عَنْهُ عُيُونَ الحِسَانِ","وَقَدْ كُنَّ يَخْلَعْنَ فِيْهِ الرَّسَنْ",189,"ن",1,0],["ويُصْقِلُ جَوْهَرَ الأَلْبَابِ حَتّى","يصيرُ صُفْرَ معدِنِها نُضَارا",190,"ر",2,0],["ويصلح السبل والبلادا","ويقطع البدع والفسادا",191,"د",2,0],["وَيصم عما كان بينهما","سَمعي وَما بي غيره وقرُ",192,"ر",1,0],["ويصبح فخّاراً على أَهل جِنسه","وينسى بأَنّ الأَصل من قبل فخّارُ",193,"ر",1,0],["ويصدُّ عَنَّا أَيْ بأَنِّي","تائِبٌ وكذاك يَزْعُمْ",194,"م",1,0],["ويصيرُ الماءُ وهْو ال","مِلْحُ شَهْداً في إِنَائِكْ",195,"ك",1,0],["ويُصْبِحُ مثلي حليُها عاشقاً لها","أَلسْتَ تَراه أَصْفراً يَتَوسْوسُ",196,"س",1,0],["وَيَصْدُقُ مِنْكُمُ وَعْدٌ مَقالاً","وَيَحْوي مَنْ له مقامُ",197,"م",1,0],["وَيُصْبِحُ لِلإخْلاصِ قَلْبِي تَالياً","وَيُمْسِي لِسَانِي تَالياً سُورةَ الحَمْدِ",198,"د",1,0]]}