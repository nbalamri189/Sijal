net/poem15247.html","الطويل"],[482,"أقلع بقشك أيها الأسطول","https://www.aldiwan.net/poem37195.html","الكامل"],[503,"ولما دعينا والدجا في غلالة","https://www.aldiwan.net/poem37936.html","الطويل"],[503,"رأيت رسول الله سبعين مرة","https://www.aldiwan.net/poem37969.html","الطويل"],[517,"ما حركت سكنات الأعين النجل","https://www.aldiwan.net/poem20788.html","البسيط"],[517,"ينم عليه الدمع وهو جحود","https://www.aldiwan.net/poem20831.html","الطويل"],[517,"هل المحرم فاستهل مكبرا","https://www.aldiwan.net/poem20838.html","الكامل"],[532,"هب أن بدر التم يوما يأفل","https://www.aldiwan.net/poem37264.html","الكامل"],[554,"صمت العواذل في أساك وسلموا","https://www.aldiwan.net/poem47242.html","الكامل"],[554,"ألا يا ابنة الحيين ما لي وما لك","https://www.aldiwan.net/poem47344.html","الطويل"],[554,"أبي الزمان سوى ما يكره الشرف","https://www.aldiwan.net/poem47404.html","البسيط"],[554,"عجبت لقلبي كيف يصبو ويكلف","https://www.aldiwan.net/poem47405.html","البسيط"],[554,"هبت تلوم على الندى هند","https://www.aldiwan.net/poem47877.html","أحذ الكامل"],[554,"وما مرح الفتى تزور عنه","https://www.aldiwan.net/poem47893.html","الوافر"],[554,"كم ذا سرى بالموت عنا مدلج","https://www.aldiwan.net/poem48018.html","الكامل"],[554,"سائل بيثرب هل ثوى الركب","https://www.aldiwan.net/poem48101.html","أحذ الكامل"],[561,"أنا التعين والرب المهين ما","https://www.aldiwan.net/poem34077.html","البسيط"],[561,"نقطة الكون تحت باء الوجود","https://www.aldiwan.net/poem34601.html","الخفيف"],[561,"تحقق فإن الروح في الكل واحد","https://www.aldiwan.net/poem34622.html","الطويل"],[565,"أتى مثل موسى حينما عاد من مصر","https://www.aldiwan.net/poem52768.html","الطويل"],[570,"عذيري من صرف هذا الزمن","https://www.aldiwan.net/poem69497.html","المتقارب"],[570,"ألم تر أن تكرار الليالي","https://www.aldiwan.net/poem69692.html","الوافر"],[571,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[572,"إن أدع مسكينا فما قصرت","https://www.aldiwan.net/poem52007.html","أحذ الكامل"],[578,"أيا دار في جنات عدن له دار","https://www.aldiwan.net/poem2783.html","الطويل"],[578,"يا قاعداً معنا ويزعم","https://www.aldiwan.net/poem2805.html","مجزوء الكامل"],[578,"إنني من عتقائك","https://www.aldiwan.net/poem3042.html","مجزوء الرمل"],[578,"أمجلس لهوي ليس لي منك مجلس","https://www.aldiwan.net/poem3058.html","الطويل"],[589,"عفا الله عن قوم عفا الصبر منهم","https://www.aldiwan.net/poem17715.html","الطويل"],[589,"عذارك من ند يجل عن الند","https://www.aldiwan.net/poem17980.html","الطويل"],[652,"","https://poetry.dctabudhabi.ae/diwan/poem/216883",""],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/20894","الوافر"],[856,"","https://poetry.dctabudhabi.ae/diwan/poem/18076","الطويل"],[862,"","https://poetry.dctabudhabi.ae/diwan/poem/21213","الكامل"]],"verses":[["وَيَصحَبُني ذُؤالَةُ مُستَريباً","بِشَخصي في الأَماعِزِ كَالخَفيرِ",0,"ر",1,0],["ويُصيبُ أعْقابَ الأمورِ إذا ارْتَأى","عَفْواً وآراءُ الرِّجالِ تَفيلُ",1,"ل",1,0],["ويُصْبِحُ كلُّ ناجِيَةٍ ذَمولٍ","بهادِيَةٍ كَخُوطِ الخَيْزُرانِ",2,"ن",1,0],["ويَصْبو إِلى وادِيهِ والرّوْضُ باسِمٌ","يُغازِلُهُ عافي النّسيمِ إذا هَبّا",3,"ب",2,0],["وَيَصحَبُني مِن آلِ عَبسٍ عِصابَةٌ","لَها شَرَفٌ بَينَ القَبائِلِ يَمتَدُّ",4,"د",1,0],["وَيَصُدُّ عَنكَ بِوَجهِهِ","وَتُلِحُّ أَنتَ فَلا تُغِبُّهُ",5,"ه",1,0],["وَيَصْغُرُ عِنْدَ الشَّمْسِ في رَوْنَقِ الضُّحَى","سَنَاهَا إِذَا دَارَتْ عَلَيْكَ الْمَوَاكِبُ",6,"ب",1,0],["وَيُصبِحُ كَالسَيفِ الصَقيلِ إِذا غَدا","عَلى ظَهرِ أَنماطٍ لَهُ وَوَسائِدا",7,"د",2,0],["وَيَصولُ بِالأَبدانِ كُلُّ مُسَفَّرٍ","مِثلَ الشِهابِ إِذا تَوَقَّدَ بِالغَضا",8,"ا",1,0],["وَيَصرِفُهُ الهَوى عَن ذِكرِ مِصرٍ","وَمِصرٌ في يَدِ الباغي تُضامُ",9,"م",1,0],["وَيَصيرُ بِالتَرخيمِ إِن نادَيتَهُ","ضداً لِتَصحيفِ الَّذي لا يَنحَلُ",10,"ل",1,0],["ويصاد بين صغاره","إن عز في القحم اصطياده",11,"د",2,0],["وَيَصِيبُ الرِّجَالُ أَسْمَى مَجَالٍ","تَتَجَارَى فِيهِ عُقُولُ الرِّجَالِ",12,"ل",1,0],["ويُصبح كل تمويه وغِشّ","لأنظار البرية مستبينا",13,"ن",2,0],["ويصبح كل خدّاع كذوب","رجيماً في سياسته لعينا",13,"ن",2,0],["ويصبح كل شعب مستقلاً","عزيزاً لن يذِلّ ولن يهونا",13,"ن",2,0],["ويصبح كل محتَرَث مُشاعاً","لمن فيه ثَوَوا متواطنينا",13,"ن",2,0],["ويصقلها الجمال إذا رأته","وتصدئها القبائح والهموم",14,"م",1,0],["ويصدع كلّ بالحقيقة ناطقاً","ويترك ما لم يدر منها لمن يدري",15,"ر",2,0],["وَيَصُدُّ عَنّا الظالِمينَ","إِذا لَقينا القَومَ صيدا",16,"د",2,0],["وَيُصبِحُ الضَيفُ أَولانا بِمَنزِلِنا","نَرضى بِذاكَ وَيَمضي حُكمُهُ فينا",17,"ن",2,0],["وَيَصُدُّ عَنّي المُفحَمونَ كَما","صَدَّ البِكارَةُ عَن حَرى الفَحلِ",18,"ل",1,0],["ويصنع فينا الجودُ صفواً مهنّئاً","ولا حظراً فيه عليك ولا قذى",19,"ذ",2,0],["ويصغي إلى الواشي وليسَ بقائل","ويقضي على علم بكلِّ مخرّق",20,"ق",1,0],["ويصحّ علم الكيمياء وسيفه","فترى اللجين يعود كالعقيان",21,"ن",1,0],["ويصبح المدح إلاَّ في مناقبه","كالبكر زوَّجها الأهلون عنينا",22,"ن",2,0],["ويُصْحبُك الإلهُ على الأَعادي","مساعدةَ المَقادرِ والقضاءِ",23,"ا",2,0],["ويُصِمُّ من سمع الْتِطَا","م الموج فيه واصطخابهْ",24,"ب",2,0],["ويصونُ الوليّ بالجاه والما","لِ كصونِ الكَميِّ نصلَ الحسام",25,"م",1,0],["ويصونون باللُّهى حُرمَ الأع","راض صونَ السيوف بالأجفان",26,"ن",1,0],["وَيَصطَخِبونَ إِن قَرُبَت","وَعِندي يَحسُنُ الطَرَبُ",27,"ب",1,0],["وَيُصبِحُ النابِهُ في مَأمَنٍ","مِن عَنَتِ المالِ وَعَيثِ الحُسام",28,"م",1,0],["وَيُصلى جَحيماً وَهيَ في الحُسنِ جَنَّةٌ","وَيُسقى دِهاقاً وَهيَ صَهباءُ قَرقَفُ",29,"ف",1,0],["ويَصُوغُ أَحلامَ الطَّبيعَةِ فاجعلي","عُمُري نشيداً ساحرَ الأَنغامِ",30,"م",1,0],["ويُصبحُ في ظُلُماتِ القبورِ","هباءً حقيراً وتُرْباً زهيدْ",31,"د",1,0],["ويصبح الجرح الذي","يمضه يلتئم",32,"م",1,0],["ويصحب الناس راض","ين عنه أو جاهلينا",33,"ن",2,0],["وَيُصبِحُ لا غُبارَ عَلى","سَريرَتِهِ كَما يُمسي",34,"س",2,0],["وَيُصعِدُ في السَماءِ عَلى بُروجٍ","غَداً هِيَ في العالَمِ بارِجاتُ",35,"ت",1,0],["وَيُصانُ مِن سِرِّ الصَبابَةِ عِندَهُ","ما باتَ عِندَ الأَكثَرينَ مُذالا",36,"ل",2,0],["وَيَصطَنِعُ المَعروفَ مُبتَدِئً بِهِ","وَيَمنَعُهُ مِن كُلِّ مَن ذَمُّهُ حَمدُ",37,"د",1,0],["وَيَصدُقُ وَعدُها وَالصِدقُ شَرٌّ","إِذا أَلقاكَ في الكُرَبِ العِظامِ",38,"م",1,0],["ويصِحُّ لي قولُ الوُشاةِ عليكُمُ","فأردُّهُ عنكمْ بظَنٍّ فاسدِ",39,"د",1,0],["ويصدُّنِي حُبُّ المقامِ وأفرُخٌ","زُغْبٌ تَرُدُّ إِذا عزمتُ طِماحِي",40,"ح",2,0],["وَيُصنَعُ في مُعانَدَتي لِقَومٍ","وَبَعضَ الصُنعِ مِن سَبَبٍ بَعيدِ",41,"د",1,0],["وَيُصبِحُ مَعروفاً لَهُ الفَضلُ دونَهُم","وَما يَتَداعاهُ الأَباعِدُ مُنكَرا",42,"ر",2,0],["ويُصبحُ بِشْرُكَ المحجوبُ عَنِّي","يُبَشِّرُني بسَعْدِ إضحِيانِ",43,"ن",1,0],["ويصونُها مسرَى روائِحِها","من أن تباشَرها بشمَّتِها",44,"ت",3,0],["وَيَصدُرُ كُلٌّ إِلى مَوقِفٍ","يُقيمُ الكُهولَ وَأَطفالَها",45,"ل",3,0],["وَيُصبِحُ شاحِطَ المَثوى","مُفَجَّعَةً ثَواكِلُهُ",46,"ل",2,0],["وَيُصبِحُ عَن عَيبِ الخَلائِقِ لاهِياً","وَعَن رَعيِهِم بِالعَدلِ لا يَعرِفُ السَهوا",47,"و",2,0],["وَيُصغونَ لي عِلماً بِأَنّي لِبَحثِهِمُ","عُذَيقُ جَناهُ وَالجُذيلُ المُحَكَّكُ",48,"ك",1,0],["ويصعبُ بعدَ الضّرْبِ إغْمادُ سيفِهِ","لِكُلِّ دَمٍ في مَتْنِهِ غَير سائِلِ",49,"ل",1,0],["ويُصْبحُ سربَ الحَمامِ الحِمامُ","ويَجْنَحُ مثلَ الجناح الخفوق",50,"ق",1,0],["ويصبحُ من وَصْلِ سلمى الغنيّ","يُقَلّبُ منه يَدَيْ مُفْلِسِ",51,"س",1,0],["ويُصميهِ سهمٌ مُصْرَدٌ ليس يُتّقَى","له في الحشا رامٍ تَسَتّرَ بالخلبِ",52,"ب",1,0],["وَيَصرَعُ ساقيها بِإِنصافِ شَربِها","وَصَرعُهُمُ بِالجَورِ في صورَةِ العَدلِ",53,"ل",1,0],["وَيَصعَدُ حَتّى لَظَنَّ الجَهولُ","أَنَّ لَهُ مَنزِلاً في السَماءِ",54,"ا",2,0],["وَيَصْحَبُنِي فِي كُلِّ رَوْعٍ ثَلاثَةٌ","حُسَامٌ وَطِرْفٌ أَعْوَجِيٌّ وَلَهْذَمُ",55,"م",1,0],["وَيَصدَعُ شَملَ اللَيلَةِ الخَبلِ كُلَّما","بَدا فَيلَقٌ مِلءُ الفَضاءِ وَفَيلَقُ",56,"ق",1,0],["ويصعدُ بالذّرى وهي السّنامُ","نَهضتَ لها وما هبَّ النيامُ",57,"م",1,0],["وَيَصُبُّوا عليكَ من صفوةِ الما","لِ حَياً ماطراً وَغيثاً غزيرا",58,"ر",2,0],["وَيُصبِحَ قَبري بَطنَ نَسرٍ مَقيلُهُ","بِجَوِّ السَماءِ في نُسورٍ عَوائِفِ",59,"ف",1,0],["وَيُصبِحُ يَنفُضُ عَنهُ النَدى","كَما هَمَتِ الشَنَّةُ الناضِحَه",60,"ح",2,0],["وَيَصرِفُ أَسرارَ الهَوى عَن عُداتِها","وَيَلقى بِها مِن حُبِّها المُتَلَقِّفا",61,"ف",2,0],["وَيُصمي الفَتى سَهمٌ مِنَ الدَهرِ صائِبٌ","وَإِن صُرِفَت عَنهُ السِهامُ الزَوالِجُ",62,"ج",1,0],["وَيَصيرُ في شَيبانَ مَجنى غَرسِها","وَيَعودُ مَسقِطُ ثَلجِها في آبِها",63,"ب",3,0],["وَيَصيرُ ماقَضى مِنَ ال","أَيّامِ أَحلاماً تُعَبَّر",64,"ر",1,0],["وَيُصبِحُ الجِسمُ بَعدَ الروحِ مُنتَبِذاً","صِفراً كَنَبذِكَ مَكسورَ البَواقيلِ",65,"ل",1,0],["وَيُصبِحُ في الحِجى التَشريقُ رُزءاً","وَأَنّى يُبهِجُ الرُكنَ اِستِلامُ",66,"م",1,0],["وَيُصبِحُ مَنثورُ البِلى كَنَظيمَةٍ","بَناها عُبَيدٌ لا يُقيمُ لَها وَزنا",67,"ن",2,0],["وَيَصهِلُ في مِثلِ جَوفِ الطَوِيّ","صَهيلاً يُبَيّنُ لِلمُعربِ",68,"ب",1,0],["ويصطنع المعروف مبتدئاً به","ويمنعه من كل من ذمه حمد",69,"د",1,0],["ويصور الأحلامَ فتنةَ شاعرٍ","تُوحي الخيالَ لريشة الرسَّامِ",70,"م",1,0],["ويَصُدّ ابنَ دَأيَةَ الجَوْنَ عنها","رَبُّهَا بعدما ثَناها حَسيرا",71,"ر",2,0],["ويَصُدّها قِصَرُ العِنان فما لها","يومَ الرّهانِ إلى الأميرِ وُصولُ",72,"ل",1,0],["وَيَصْحَبُنِي يَوْمَ الْخَلاعَةِ وَالصِّبَا","نَدِيمٌ وَكَأْسٌ رَيَّةٌ وَمُدِيرُ",73,"ر",1,0],["وَيَصْدمُ المَكْرَ غَيْرَ مُلْتَفِتٍ","وَيَقْحَمُ الدَّهْرَ غَيْرَ مُرْتَعِد",74,"د",1,0],["وَيَصْطَفِي رِفَاقَهُ","لِلاِئْتِنَاسِ وَالسَّمَرْ",75,"ر",1,0],["ويَصِيبُ مِنْهُ كُلَّ طَالِبِ نَجْدَةٍ","حَظّاً إِذَا مَا قِيلَ هَلْ مِنْ مُنْجِدِ",76,"د",1,0],["ويصيدُ العدولُ مال اليَتامى","باقتناص كما يصيدُ العقابُ",77,"ب",1,0],["ويصْرَعُ الفارِسَ المِغْوارَ إِن لَعِبَتْ","كَفّاهُ بالسَّيْفِ أرْدَى كلَّ مِغْوَار",78,"ر",1,0],["ويصيبُ «المِكْروبَ» مبضعُ ياس","ينَ» ولو كان في الفؤاد كمينا",79,"ن",2,0],["ويصدع في قبة الشمس من","غوائله صدعة صاعده",80,"د",2,0],["ويصحو الغرام يرى أنّه","على ظهر أغنية من خشب",81,"ب",1,0],["ويصلّون والمحاريب تستفتي","متى تصبح الأفاعي حمائم ؟",82,"م",1,0],["ويصوغ الصمت ضحى غزلا","وأصيلا ورديا أكحل",83,"ل",1,0],["ويصوغ العالم ثانية","أو يأمره أن يتحول",83,"ل",1,0],["ويصغي ويصغي فلم يستمع","سوى هاتف اللإثم في المسمع",84,"ع",1,0],["ويصرف للكون ما في يديه","وما الكون إلا نذير الفساد",85,"د",1,0],["ويصوغ عطرا كلما شدّ الأسى","بيديه يعرك قلبه الوثّابا",86,"ب",2,0],["ويصور عنترة العبسي","ويصور عرش الإسكندر",87,"ر",1,0],["ويصور عنترة العبسي","يصور عرش الاسكندر",88,"ر",1,0],["ويُصْبِحُ يَنْفُضُ عَنْهُ النَّدَى","لَهُمْ، وبِلاَ أَنْفُسٍ ناصِحَهْ",89,"ح",2,0],["ويصح من ذي لكنة ان كان ما","تجزي الصلاة به من الآي استقر",90,"ر",1,0],["ويصوغ الصمت ضحى غزل","وأصيلا ورديا أكحل",91,"ل",1,0],["ويصفو جوّنا بعد انكدار","ويسقى أرضنا المطر الرّهام",92,"م",1,0],["ويصلح لي من لا يراني صالحا","ويحفظ قلبي في الهوى من يضيعه",93,"ع",2,0],["ويصدبر عنا الناس ريا قلوبهم","ونحن عطاش بينهم نتلهف",94,"ف",1,0],["ويصرف عنك الشيون قلوبهم","وتغضى غداً عنك اللحاظ الغوادر",95,"ر",1,0],["ويصبحُ كلُ ممهَتَنٍ مَهَيباً","ويصبحُ كُلُّ مُغتَرِبٍ قريبا",96,"ب",2,0],["ويصبحُ مَادِرٌ مَعنًى كَمَعنٍ","ويصبحُبَاقِلٌ قسّاً خَطِيبَا",96,"ب",2,0],["وَيُصرعَ حَولَهُ مِنّا رِجالٌ","وَتَمنَعهُ الخُؤولَةُ وَالعُمومُ",97,"م",1,0],["ويصون دين الله من شُبه العدا","ويردّ غارةَ من به يتمارى",98,"ر",2,0],["ويصبح والآلاء ساعدت القوى","على فعل ما يرضى وللشر نباذا",99,"ذ",2,0],["ويصبُّ من سحب الشئون مجلجل","صبا ملث المزن سخ المنسكب",100,"ب",1,0],["ويصبحُ والعفات من الاعادي","نبال كالعقامِ قد استقالوا",101,"ل",3,0],["ويصغر جرم العبد في جنب عفونا","وان كان جر ما مثله يوجب السخطا",102,"ط",2,0],["ويصيبها خير فتحسبه لها","أبدا وقد أخذته باستحقاقها",103,"ق",3,0],["وَيَصُكُّ البيضَ بِالبيضِ إِذا","حُطِّمَت في الصيدِ أَطرافُ الصِعادِ",104,"د",1,0],["وَيُصطَفى مَن أَبُوهُ كانَ عَبدَ أَبي","دُوني وَيُقطَعُ فِيما بَينَكُم رَحِمي",105,"م",2,0],["ويصير عبدا في يديه وخادما","ويصونه ويزيده إشفاقه",106,"ق",2,0],["وَيَصعبُ تغييرُ العقيدةِ بعدما","يَعيشُ عَليها المرءُ في قومهِ عمرا",107,"ر",2,0],["ويصطفي المرءُ ألفَ خلٍّ","ولا يفي منهمُ خليلُ",108,"ل",1,0],["ويصبح ريحانُ الهوى حين نلتقي","نَماءَ المنى من ذلك النظر الشزرِ",109,"ر",1,0],["وَيَصومُ حَتّى لا يُظَنُّ فُطورُهُ","أَبَداً يُريدُ بِهِ رِضى الرَحمَنِ",110,"ن",1,0],["وَيَصْبِرُ لِلْبَلْوَى وَيَحْتَمِلُ الأَذَى","وَيَحْلُمُ عَمَّنْ قَدْ أَسَاءَ وَيَصْفَحُ",111,"ح",1,0],["وَيُصْلِتُ فِيهَا الرُّشْدُ عَضْبَ هِدَايَةٍ","يُصِيبُ ضَلاَلاَتِ الْعِدَا فِي الرَّوَاهِشِ",112,"ش",1,0],["ويصدق فيهم قول من هو مادح","إذا غاب عنهم كوكب لاح كوكب",113,"ب",1,0],["ويصرف من هم ويسعف من اذى