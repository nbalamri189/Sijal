يفشي سرَّه ويذيعُه",140,"ه",1,0],["ويَصبو إلى الأَغْصَانِ أغصان رامةٍ","إذا ذكّرتْه قَدَّ مَنْ كَانَ يهواهُ",141,"ه",1,0],["ويصفو العيش بعد كدرته","بما جناه البعاد من درن",142,"ن",1,0],["ويصرف الدمع إلى محاجري","وقد حشاها مبلَّة بالسُّهد",143,"د",1,0],["ويصبح فينا كالمعافى بِخُلْقِهِ","وفي خَلْقِه عما يلاقيه ما ينبي",144,"ب",2,0],["وَيصدُقُ فيهِ المَدحُ حَتّى كَأَنَّما","يَسبح مِن صدق المَقالَةِ شاعِرُهُ",145,"ر",2,0],["وَيصغر كل الناس في جَنب طيىءٍ","وَيصغر في جنب الأَمير كَبيرُها",146,"ر",3,0],["وَيصدق في الهامات إِيماض سَيفِهِ","عَلى أَنَّ إِيماض الصَوارِم خُلَّبُ",147,"ب",1,0],["ويصدّنَا عمّا نُحا","وِله جِهاراً واغْتِيالاَ",148,"ل",2,0],["ويصيبُ والرامي تطيشُ سِهامُه","فلكلِّ سهمٍ من عدُوٍّ مَقْتَلُ",149,"ل",1,0],["ويَصدُقَكِ العيانُ بأي حبلٍ","من ابن العامِرِيِّ وصلتُ حبلي",150,"ل",2,0],["ويُصْلي بِحَرِّ الشمسِ حُرَّ جبينِهِ","ليَبْسُطَ لِلإِسْلامِ من نُورِهِ فَيَّا",151,"ي",2,0],["ويَصْدَعُ مَا ضَمَّ الوَدَاعُ تفرُّقٌ","كما انشَعَبَتْ تَحْتَ العواصِفِ أَغصانُ",152,"ن",1,0],["ويصطنع الاخوان في اللَه إنها","لاغلاق أَبواب المسائل تفتح",153,"ح",1,0],["ويصد سمعا عن حديث مطامع","ومظالم وخيالة وحقود",154,"د",1,0],["ويصبح الكل كي يسير على","يأس على شدة على زلق",155,"ق",1,0],["ويصلح أن يحظى بخدمة مثلكم","فخدمتكم فيها هدى ورشاد",156,"د",1,0],["ويصوغُ للأقدار سيرتها غداً","فَتكيفُ الأحلامَ والأقدارا",157,"ر",2,0],["ويصرع كلَّ جبارٍ سفيهٍ","يُغررُ بالعقول ويستخُّف",158,"ف",1,0],["ويُصغي إليها الآلهُ الطروب","فَيجبلها الروح في الآدمى",159,"م",2,0],["ويصطلمون ما محكوا ولجّوا","وهم خلقاء أن يعفوا ويُبقوا",160,"ق",3,0],["ويصعبُ أحياناً وينتظر الغنى","فيأتي ولم يخضع له وهو طيِّعُ",161,"ع",1,0],["ويُصيبُ مرتجلاً بأوّل خَطْرةٍ","أغراضَ كلِّ مخمِّر ومُبيِّتِ",162,"ت",1,0],["ويَصحُّ معناه ويسلَم لفظُهُ","ونظامُهُ وهناك باقي العلَّةِ",162,"ه",1,0],["ويُصغى له ما لم يكن ذا لُبانَةٍ","فانْ كان لم تُنْصتْ له أذُنانِ",163,"ن",1,0],["ويصدأُ في الطُّول النُّضار تدنساً","وعِرْضك برَّقُ الأديمِ صَقيلُ",164,"ل",1,0],["ويصدقُ وعْدهُ في مُعْتَفيهِ","اذا كَذَبَ البَوارقُ والرُّعودُ",165,"د",1,0],["ويصْدُر السَّفْر عنء سلْسالِ موْرِدِه","وقد سَقَى القَوْمَ منهُ العَلُّ والنَّهلُ",166,"ل",1,0],["ويصلب أن عزه فادح","وإن هزه مادح لأن عودا",167,"د",2,0],["ويصيبُ شاكلة الرقي بسهمهِ","فكأنما يرمي بلحظٍ مرسل",168,"ل",1,0],["ويصدى إلى ماء الملاحة والصّبا","فحدّث بصادٍ وهو في الماءِ سابح",169,"ح",1,0],["وَيصبحَ الزمانُ طلقاً وجهُه","وَتنثني أوقاتُه ربيعا",170,"ع",2,0],["ويصبوا إلى باناتِ سَلْعٍ إذا انبرتْ","تَمايلُ مِن مرَّ الرياحِ النواسمِ",171,"م",1,0],["ويصاخ بالإذعان للأمر الذي","قد قاله للأنبيا التنزيل",172,"ل",1,0],["ويُصلِحُ بالتَّوحيدِ أَوْهامَ قلبِهِ","على منهَجِ الإيمانِ في الجمعِ والفَرْقِ",173,"ق",1,0],["ويُصلِتُني سيفاً على كلِّ بِعدَةٍ","وأَصحابِها أَهْلِ الغَوايَةِ بالطَّبْعِ",174,"ع",1,0],["ويَصدرُ النّبْلُ عنّا ليس يَنفذُنا","إلّا إذا كان مطبوعاً من الكحَلِ",175,"ل",1,0],["ويصحو فتأتيهِ الصِّبا بروايةٍ","عنِ البانِ تسقيهِ الطُّلى فيَميدُ",176,"د",1,0],["ويَصونُها صونَ الكريمِ لعِرْضِه","حتّى له الأجَلُ المُتاحُ تقدّرا",177,"ر",2,0],["ويَصُدُّ إنْ لاحَتْ بُروقُ مَطامِعٍ","تَسْعَى إذَا لَمَعَتْ إليْها الأَرْجُلُ",178,"ل",1,0],["وَيصونُ عِرضَهمُ الّذي شحّوا به","دينارُهمْ في بذلِهِ والدِّرْهَمُ",179,"م",1,0],["ويُصبحُ إمّا مالُهُ في مُلِمَّةٍ","تنوبكُمُ أو شِلْوُهُ للمناهكِ",180,"ك",1,0],["ويصرف الهمَّ عن قلبٍ أطاف به","مَن قلبُهُ لنواصي الهمّ مكتنفُ",181,"ف",1,0],["ويُصبح منّي ساكنَ القلب والحَشا","وفي كلّ يومٍ منه قلبِيَ يرجُفُ",182,"ف",1,0],["وَيَصُدُّ عَن تَزويقِ زينتها","حَيث اِستثيرَ فأعوَزَ الصَّدُّ",183,"د",1,0],["ويُصبِحُ بين إعراضٍ مُبينٍ","بلا سببٍ وهجرانٍ صَراحِ",184,"ح",1,0],["ويُصَدُّ عنك القاصدون فما لهمْ","أبداً على شِعْبٍ حَلَلْتَ مُعَرّجُ",185,"ج",1,0],["وَيَصدُّ عَنّي غَيرَ مُحتَشِمٍ","مُتَيقّنٌ أَنّي بهِ صَبُّ",186,"ب",1,0],["ويصبح القطب في سامي دوائره","وفي الحقائق يمسي المفرد العلما",187,"م",2,0],["ويصير الوجود عنك خفياً","لست تدري منه سوى فرط جود",188,"د",1,0],["ويصبح مشغولاً ويمسي بنفسه","وقلب له في كل ما عاق زاهد",189,"د",1,0],["ويصبو إلى بِيضِ الطُّروسِ وسُودِها","من الحِبرِ لا بِيضَ الدَّراهمِ والصُّفرِ",190,"ر",1,0],["وَي