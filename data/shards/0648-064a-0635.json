{"poems":[[53,"أما ذعرت بنا بقر الخدور","https://www.aldiwan.net/poem30468.html","الوافر"],[63,"هو طيفها وطروقه تعليل","https://www.aldiwan.net/poem46153.html","الكامل"],[63,"مراحك إنه البرق اليماني","https://www.aldiwan.net/poem46172.html","الوافر"],[63,"أثرها فلا ماء أصابت ولا عشبا","https://www.aldiwan.net/poem46174.html","الطويل"],[3,"لأي حبيب يحسن الرأي والود","https://www.aldiwan.net/poem146.html",""],[57,"ومن البلية أن تحب","https://www.aldiwan.net/poem24728.html","مجزوء الكامل"],[77,"سعودك لا ما تدعيه الكواكب","https://www.aldiwan.net/poem36771.html","الطويل"],[9,"أجدك ودعت الصبى والولائدا","https://www.aldiwan.net/poem21922.html","الطويل"],[24,"هلا سألت وأنت غير عيية","https://www.aldiwan.net/poem21857.html","الكامل"],[86,"لقد نصل الدجى فمتى تنام","https://www.aldiwan.net/poem10686.html","الوافر"],[71,"ما اسم حرام للنساء فعاله","https://www.aldiwan.net/poem3884.html","الكامل"],[93,"ألطائر العالي مراده","https://www.aldiwan.net/poem11144.html","السريع"],[93,"يا لسان الدفاع عن خير دار","https://www.aldiwan.net/poem11461.html","الخفيف"],[88,"أطالوا الحرب طاحنة زبونا","https://www.aldiwan.net/poem44459.html","الوافر"],[88,"أرى للروح بالبدن اتصالا","https://www.aldiwan.net/poem45062.html","الوافر"],[88,"متى تطلق الأيام حرية الفكر","https://www.aldiwan.net/poem45065.html","الطويل"],[4,"لن تفنيا خيرات أر","https://www.aldiwan.net/poem21158.html","مجزوء الكامل"],[47,"إذا مررت بواد جاش غاربه","https://www.aldiwan.net/poem25129.html","البسيط"],[23,"سماه معشره أبا حكم","https://www.aldiwan.net/poem21392.html","الكامل"],[72,"كذا أبدا تلقى الأهلة طالعا","https://www.aldiwan.net/poem18688.html","الطويل"],[72,"رأى الغصن أعطاف الغزال المقرطق","https://www.aldiwan.net/poem19355.html","الطويل"],[72,"سلت صوارمها من الأجفان","https://www.aldiwan.net/poem20146.html","الكامل"],[72,"أعدى بغيركم دمع المحبينا","https://www.aldiwan.net/poem20172.html","البسيط"],[51,"أحب المهرجان لأن فيه","https://www.aldiwan.net/poem7934.html","الوافر"],[51,"أنى هجوت بني ثوابه","https://www.aldiwan.net/poem8174.html","مجزوء الكامل"],[51,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[91,"أقاح ذاك أم شنب وريق ذاك أم ضرب","https://www.aldiwan.net/poem8741.html","عموديه"],[91,"ما وعظ الإنسان مثل الحمام","https://www.aldiwan.net/poem62748.html","عموديه"],[70,"أغصن النقا لولا القوام المهفهف","https://www.aldiwan.net/poem42817.html","الطويل"],[92,"بيت بنته لي الحياة من الشذى","https://www.aldiwan.net/poem38908.html","الكامل"],[92,"أتفنى ابتسامات تلك الجفون","https://www.aldiwan.net/poem38959.html","المتقارب"],[89,"تعلموا تعلموا","https://www.aldiwan.net/poem44642.html","مجزوء الرجز"],[85,"مشيئة الله كانت","https://www.aldiwan.net/poem6834.html","المجتث"],[85,"عفيف الجهر والهمس","https://www.aldiwan.net/poem8074.html","الهزج"],[85,"ممات في المواكب أم حياة","https://www.aldiwan.net/poem62910.html","الوافر"],[85,"العام أقبل قم نحي هلالا","https://www.aldiwan.net/poem63751.html","الكامل"],[43,"أقل فعالي بله أكثره مجد","https://www.aldiwan.net/poem9542.html","الطويل"],[43,"ملومكما يجل عن الملام","https://www.aldiwan.net/poem10571.html","الوافر"],[62,"إني لأذكركم وقد بلغ الظما","https://www.aldiwan.net/poem52443.html","الكامل"],[62,"مولاي أكرم من ألوذ بظله","https://www.aldiwan.net/poem52461.html","الكامل"],[45,"أإبراهيم دعوة مستعيد","https://www.aldiwan.net/poem63459.html","الوافر"],[45,"سرى من خيال المالكية ما سرى","https://www.aldiwan.net/poem63587.html","البسيط"],[61,"بلاني الحب فيك بما بلاني","https://www.aldiwan.net/poem51417.html","الوافر"],[61,"أهدت على نأي المحل وقد","https://www.aldiwan.net/poem51757.html","أحذ الكامل"],[58,"إذا قربت ساعة يا لها","https://www.aldiwan.net/poem30902.html","المتقارب"],[49,"لمن طلل أسائله","https://www.aldiwan.net/poem63087.html","مجزوء الوافر"],[66,"وحقك إني قانع بالذي تهوى","https://www.aldiwan.net/poem38475.html","الطويل"],[66,"الجيش الحيا في مأقظ الروض معرك","https://www.aldiwan.net/poem39076.html","الطويل"],[80,"متى صدرت عيناك عن أرض بابل","https://www.aldiwan.net/poem31321.html","الطويل"],[80,"وأكلف منسره ذو شغا","https://www.aldiwan.net/poem31367.html","المتقارب"],[80,"شموس دعاهن وشك الفراق","https://www.aldiwan.net/poem31415.html","المتقارب"],[80,"خطاب الرزايا إنه جلل الخطب","https://www.aldiwan.net/poem31550.html","الطويل"],[44,"أصب بحميا كأسها مقتل العذل","https://www.aldiwan.net/poem29689.html","الطويل"],[44,"نعاء إلى كل حي نعاء","https://www.aldiwan.net/poem30325.html","المتقارب"],[87,"ألم يأن أن يرضى عن الدهر مغرم","https://www.aldiwan.net/poem8248.html","الطويل"],[74,"لذكرك ماعب الخليج يصفق","https://www.aldiwan.net/poem13194.html","الطويل"],[105,"أدأبك أن تريد المستحيلا","https://www.aldiwan.net/poem44213.html","الوافر"],[105,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[39,"وإني لمقتاد جوادي وقاذف","https://www.aldiwan.net/poem53761.html","الطويل"],[39,"قفا فاسألا الدمنة الماصحه","https://www.aldiwan.net/poem53809.html","المتقارب"],[52,"ألا فاسقنيها قد مشى الصبح في الدجى","https://www.aldiwan.net/poem26827.html","الطويل"],[46,"جماجم أمثال الكرات هفت بها","https://www.aldiwan.net/poem22240.html","الطويل"],[46,"إدأب لربك لا يلومك عاقل","https://www.aldiwan.net/poem22349.html","الكامل"],[46,"عش مجبرا أو غير مجبر","https://www.aldiwan.net/poem22737.html","مجزوء الكامل"],[46,"يا أذن سوف يظل السمع مفتقدا","https://www.aldiwan.net/poem23228.html","البسيط"],[46,"إذا لؤم الفتى لم يخشى مما","https://www.aldiwan.net/poem23313.html","الوافر"],[46,"إذا أعمل الفكر الفتى جعل الغنى","https://www.aldiwan.net/poem23467.html","الطويل"],[8,"سما لك هم ولم تطرب","https://www.aldiwan.net/poem21770.html","المتقارب"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140901",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39546","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16683","الخفيف"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16627","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42601","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54759","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54730","الكامل"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116947","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54239","البسيط"],[106,"الطبيب يس","https://www.poetsgate.com/ViewPoem.aspx?id=179703",""],[100,"أثيم الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=50095",""],[84,"أعينا امرءا نزحت عينه","https://www.poetsgate.com/ViewPoem.aspx?id=26320",""],[99,"بالأحمرِ فقَط","https://www.poetsgate.com/ViewPoem.aspx?id=16902",""],[99,"بالأحمر فقط","https://www.poetsgate.com/ViewPoem.aspx?id=14387",""],[39,"قفَا فاسألاَ الدِّمنَة َ المَاصحَة ْ","https://www.poetsgate.com/ViewPoem.aspx?id=4239",""]],"verses":[["وَيَصحَبُني ذُؤالَةُ مُستَريباً","بِشَخصي في الأَماعِزِ كَالخَفيرِ",0,"ر",1,0],["ويُصيبُ أعْقابَ الأمورِ إذا ارْتَأى","عَفْواً وآراءُ الرِّجالِ تَفيلُ",1,"ل",1,0],["ويُصْبِحُ كلُّ ناجِيَةٍ ذَمولٍ","بهادِيَةٍ كَخُوطِ الخَيْزُرانِ",2,"ن",1,0],["ويَصْبو إِلى وادِيهِ والرّوْضُ باسِمٌ","يُغازِلُهُ عافي النّسيمِ إذا هَبّا",3,"ب",2,0],["وَيَصحَبُني مِن آلِ عَبسٍ عِصابَةٌ","لَها شَرَفٌ بَينَ القَبائِلِ يَمتَدُّ",4,"د",1,0],["وَيَصُدُّ عَنكَ بِوَجهِهِ","وَتُلِحُّ أَنتَ فَلا تُغِبُّهُ",5,"ه",1,0],["وَيَصْغُرُ عِنْدَ الشَّمْسِ في رَوْنَقِ الضُّحَى","سَنَاهَا إِذَا دَارَتْ عَلَيْكَ الْمَوَاكِبُ",6,"ب",1,0],["وَيُصبِحُ كَالسَيفِ الصَقيلِ إِذا غَدا","عَلى ظَهرِ أَنماطٍ لَهُ وَوَسائِدا",7,"د",2,0],["وَيَصولُ بِالأَبدانِ كُلُّ مُسَفَّرٍ","مِثلَ الشِهابِ إِذا تَوَقَّدَ بِالغَضا",8,"ا",1,0],["وَيَصرِفُهُ الهَوى عَن ذِكرِ مِصرٍ","وَمِصرٌ في يَدِ الباغي تُضامُ",9,"م",1,0],["وَيَصيرُ بِالتَرخيمِ إِن نادَيتَهُ","ضداً لِتَصحيفِ الَّذي لا يَنحَلُ",10,"ل",1,0],["ويصاد بين صغاره","إن عز في القحم اصطياده",11,"د",2,0],["وَيَصِيبُ الرِّجَالُ أَسْمَى مَجَالٍ","تَتَجَارَى فِيهِ عُقُولُ الرِّجَالِ",12,"ل",1,0],["ويُصبح كل تمويه وغِشّ","لأنظار البرية مستبينا",13,"ن",2,0],["ويصبح كل خدّاع كذوب","رجيماً في سياسته لعينا",13,"ن",2,0],["ويصبح كل شعب مستقلاً","عزيزاً لن يذِلّ ولن يهونا",13,"ن",2,0],["ويصبح كل محتَرَث مُشاعاً","لمن فيه ثَوَوا متواطنينا",13,"ن",2,0],["ويصقلها الجمال إذا رأته","وتصدئها القبائح والهموم",14,"م",1,0],["ويصدع كلّ بالحقيقة ناطقاً","ويترك ما لم يدر منها لمن يدري",15,"ر",2,0],["وَيَصُدُّ عَنّا الظالِمينَ","إِذا لَقينا القَومَ صيدا",16,"د",2,0],["وَيُصبِحُ الضَيفُ أَولانا بِمَنزِلِنا","نَرضى بِذاكَ وَيَمضي حُكمُهُ فينا",17,"ن",2,0],["وَيَصُدُّ عَنّي المُفحَمونَ كَما","صَدَّ البِكارَةُ عَن حَرى الفَحلِ",18,"ل",1,0],["ويصنع فينا الجودُ صفواً مهنّئاً","ولا حظراً فيه عليك ولا قذى",19,"ذ",2,0],["ويصغي إلى الواشي وليسَ بقائل","ويقضي على علم بكلِّ مخرّق",20,"ق",1,0],["ويصحّ علم الكيمياء وسيفه","فترى اللجين يعود كالعقيان",21,"ن",1,0],["ويصبح المدح إلاَّ في مناقبه","كالبكر زوَّجها الأهلون عنينا",22,"ن",2,0],["ويُصْحبُك الإلهُ على الأَعادي","مساعدةَ المَقادرِ والقضاءِ",23,"ا",2,0],["ويُصِمُّ من سمع الْتِطَا","م الموج فيه واصطخابهْ",24,"ب",2,0],["ويصونُ الوليّ بالجاه والما","لِ كصونِ الكَميِّ نصلَ الحسام",25,"م",1,0],["ويصونون باللُّهى حُرمَ الأع","راض صونَ السيوف بالأجفان",26,"ن",1,0],["وَيَصطَخِبونَ إِن قَرُبَت","وَعِندي يَحسُنُ الطَرَبُ",27,"ب",1,0],["وَيُصبِحُ النابِهُ في مَأمَنٍ","مِن عَنَتِ المالِ وَعَيثِ الحُسام",28,"م",1,0],["وَيُصلى جَحيماً وَهيَ في الحُسنِ جَنَّةٌ","وَيُسقى دِهاقاً وَهيَ صَهباءُ قَرقَفُ",29,"ف",1,0],["ويَصُوغُ أَحلامَ الطَّبيعَةِ فاجعلي","عُمُري نشيداً ساحرَ الأَنغامِ",30,"م",1,0],["ويُصبحُ في ظُلُماتِ القبورِ","هباءً حقيراً وتُرْباً زهيدْ",31,"د",1,0],["ويصبح الجرح الذي","يمضه يلتئم",32,"م",1,0],["ويصحب الناس راض","ين عنه أو جاهلينا",33,"ن",2,0],["وَيُصبِحُ لا غُبارَ عَلى","سَريرَتِهِ كَما يُمسي",34,"ي",1,0],["وَيُصعِدُ في السَماءِ عَلى بُروجٍ","غَداً هِيَ في العالَمِ بارِجاتُ",35,"ت",1,0],["وَيُصانُ مِن سِرِّ الصَبابَةِ عِندَهُ","ما باتَ عِندَ الأَكثَرينَ مُذالا",36,"ل",2,0],["وَيَصطَنِعُ المَعروفَ مُبتَدِئً بِهِ","وَيَمنَعُهُ مِن كُلِّ مَن ذَمُّهُ حَمدُ",37,"د",1,0],["وَيَصدُقُ وَعدُها وَالصِدقُ شَرٌّ","إِذا أَلقاكَ في الكُرَبِ العِظامِ",38,"م",1,0],["ويصِحُّ لي قولُ الوُشاةِ عليكُمُ","فأردُّهُ عنكمْ بظَنٍّ فاسدِ",39,"د",1,0],["ويصدُّنِي حُبُّ المقامِ وأفرُخٌ","زُغْبٌ تَرُدُّ إِذا عزمتُ طِماحِي",40,"ي",1,0],["وَيُصنَعُ في مُعانَدَتي لِقَومٍ","وَبَعضَ الصُنعِ مِن سَبَبٍ بَعيدِ",41,"د",1,0],["وَيُصبِحُ مَعروفاً لَهُ الفَضلُ دونَهُم","وَما يَتَداعاهُ الأَباعِدُ مُنكَرا",42,"ر",2,0],["ويُصبحُ بِشْرُكَ المحجوبُ عَنِّي","يُبَشِّرُني بسَعْدِ إضحِيانِ",43,"ن",1,0],["ويصونُها مسرَى روائِحِها","من أن تباشَرها بشمَّتِها",44,"ت",3,0],["وَيَصدُرُ كُلٌّ إِلى مَوقِفٍ","يُقيمُ الكُهولَ وَأَطفالَها",45,"ل",3,0],["وَيُصبِحُ شاحِطَ المَثوى","مُفَجَّعَةً ثَواكِلُهُ",46,"ل",2,0],["وَيُصبِحُ عَن عَيبِ الخَلائِقِ لاهِياً","وَعَن رَعيِهِم بِالعَدلِ لا يَعرِفُ السَهوا",47,"و",2,0],["وَيُصغونَ لي عِلماً بِأَنّي لِبَحثِهِمُ","عُذَيقُ جَناهُ وَالجُذيلُ المُحَكَّكُ",48,"ك",1,0],["ويصعبُ بعدَ الضّرْبِ إغْمادُ سيفِهِ","لِكُلِّ دَمٍ في مَتْنِهِ غَير سائِلِ",49,"ل",1,0],["ويُصْبحُ سربَ الحَمامِ الحِمامُ","ويَجْنَحُ مثلَ الجناح الخفوق",50,"ق",1,0],["ويصبحُ من وَصْلِ سلمى الغنيّ","يُقَلّبُ منه يَدَيْ مُفْلِسِ",51,"س",1,0],["ويُصميهِ سهمٌ مُصْرَدٌ ليس يُتّقَى","له في الحشا رامٍ تَسَتّرَ بالخلبِ",52,"ب",1,0],["وَيَصرَعُ ساقيها بِإِنصافِ شَربِها","وَصَرعُهُمُ بِالجَورِ في صورَةِ العَدلِ",53,"ل",1,0],["وَيَصعَدُ حَتّى لَظَنَّ الجَهولُ","أَنَّ لَهُ مَنزِلاً في السَماءِ",54,"ا",2,0],["وَيَصْحَبُنِي فِي كُلِّ رَوْعٍ ثَلاثَةٌ","حُسَامٌ وَطِرْفٌ أَعْوَجِيٌّ وَلَهْذَمُ",55,"م",1,0],["وَيَصدَعُ شَملَ اللَيلَةِ الخَبلِ كُلَّما","بَدا فَيلَقٌ مِلءُ الفَضاءِ وَفَيلَقُ",56,"ق",1,0],["ويصعدُ بالذّرى وهي السّنامُ","نَهضتَ لها وما هبَّ النيامُ",57,"م",1,0],["وَيَصُبُّوا عليكَ من صفوةِ الما","لِ حَياً ماطراً وَغيثاً غزيرا",58,"ر",2,0],["وَيُصبِحَ قَبري بَطنَ نَسرٍ مَقيلُهُ","بِجَوِّ السَماءِ في نُسورٍ عَوائِفِ",59,"ف",1,0],["وَيُصبِحُ يَنفُضُ عَنهُ النَدى","كَما هَمَتِ الشَنَّةُ الناضِحَه",60,"ح",2,0],["وَيَصرِفُ أَسرارَ الهَوى عَن عُداتِها","وَيَلقى بِها مِن حُبِّها المُتَلَقِّفا",61,"ف",2,0],["وَيُصمي الفَتى سَهمٌ مِنَ الدَهرِ صائِبٌ","وَإِن صُرِفَت عَنهُ السِهامُ الزَوالِجُ",62,"ج",1,0],["وَيَصيرُ في شَيبانَ مَجنى غَرسِها","وَيَعودُ مَسقِطُ ثَلجِها في آبِها",63,"ب",3,0],["وَيَصيرُ ماقَضى مِنَ ال","أَيّامِ أَحلاماً تُعَبَّر",64,"ر",1,0],["وَيُصبِحُ الجِسمُ بَعدَ الروحِ مُنتَبِذاً","صِفراً كَنَبذِكَ مَكسورَ البَواقيلِ",65,"ل",1,0],["وَيُصبِحُ في الحِجى التَشريقُ رُزءاً","وَأَنّى يُبهِجُ الرُكنَ اِستِلامُ",66,"م",1,0],["وَيُصبِحُ مَنثورُ البِلى كَنَظيمَةٍ","بَناها عُبَيدٌ لا يُقيمُ لَها وَزنا",67,"ن",2,0],["وَيَصهِلُ في مِثلِ جَوفِ الطَوِيّ","صَهيلاً يُبَيّنُ لِلمُعربِ",68,"ب",1,0],["ويصطنع المعروف مبتدئاً به","ويمنعه من كل من ذمه حمد",69,"د",1,0],["ويصور الأحلامَ فتنةَ شاعرٍ","تُوحي الخيالَ لريشة الرسَّامِ",70,"م",1,0],["ويَصُدّ ابنَ دَأيَةَ الجَوْنَ عنها","رَبُّهَا بعدما ثَناها حَسيرا",71,"ر",2,0],["ويَصُدّها قِصَرُ العِنان فما لها","يومَ الرّهانِ إلى الأميرِ وُصولُ",72,"ل",1,0],["وَيَصْحَبُنِي يَوْمَ الْخَلاعَةِ وَالصِّبَا","نَدِيمٌ وَكَأْسٌ رَيَّةٌ وَمُدِيرُ",73,"ر",1,0],["وَيَصْدمُ المَكْرَ غَيْرَ مُلْتَفِتٍ","وَيَقْحَمُ الدَّهْرَ غَيْرَ مُرْتَعِد",74,"د",1,0],["وَيَصْطَفِي رِفَاقَهُ","لِلاِئْتِنَاسِ وَالسَّمَرْ",75,"ر",1,0],["ويَصِيبُ مِنْهُ كُلَّ طَالِبِ نَجْدَةٍ","حَظّاً إِذَا مَا قِيلَ هَلْ مِنْ مُنْجِدِ",76,"د",1,0],["ويصيدُ العدولُ مال اليَتامى","باقتناص كما يصيدُ العقابُ",77,"ب",1,0],["ويصْرَعُ الفارِسَ المِغْوارَ إِن لَعِبَتْ","كَفّاهُ بالسَّيْفِ أرْدَى كلَّ مِغْوَار",78,"ر",1,0],["ويصيبُ «المِكْروبَ» مبضعُ ياس","ينَ» ولو كان في الفؤاد كمينا",79,"ن",2,0],["ويصغي ويصغي فلم يستمع","سوى هاتف اللإثم في المسمع",80,"ع",1,0],["ويصرف للكون ما في يديه","وما الكون إلا نذير الفساد",81,"د",1,0],["ويصور عنترة العبسي","ويصور عرش الإسكندر",82,"ر",1,0],["ويصور عنترة العبسي","يصور عرش الاسكندر",83,"ر",1,0],["ويُصْبِحُ يَنْفُضُ عَنْهُ النَّدَى","لَهُمْ، وبِلاَ أَنْفُسٍ ناصِحَهْ",84,"ح",2,0]]}