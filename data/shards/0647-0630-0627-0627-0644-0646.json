{"poems":[[79,"قسما بالليل وما وسقا","https://www.aldiwan.net/poem35922.html","المتدارك"],[9,"رحلت سمية غدوة أجمالها","https://www.aldiwan.net/poem21970.html","الكامل"],[93,"يا شاعر الحسن هذي روعة العيد","https://www.aldiwan.net/poem8808.html","عموديه"],[99,"من شاطئ لشواطئ جدد","https://www.aldiwan.net/poem24763.html","أحذ الكامل"],[46,"الحق أبلج والسيوف عوار","https://www.aldiwan.net/poem30507.html","الكامل"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[107,"أقبل فتلك ديار يثرب تقبل","https://www.aldiwan.net/poem44226.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39580","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39647","البسيط"],[102,"كلمة كل نهار","https://www.poetsgate.com/ViewPoem.aspx?id=50427",""],[93,"روعة العيد","https://www.poetsgate.com/ViewPoem.aspx?id=53024",""],[154,"بركات رسل الله غير خفية","https://www.aldiwan.net/poem68443.html","الكامل"],[154,"يا ذا المعني بهذا الذكر تسمعه","https://www.aldiwan.net/poem68450.html","البسيط"],[186,"هذا النطاسي الذي من بعده","https://www.aldiwan.net/poem61072.html","الكامل"],[208,"صار التغزل في هواه عتابا","https://www.aldiwan.net/poem53367.html","الكامل"],[276,"راح الزمان ولا علم عن العلم","https://www.aldiwan.net/poem52057.html","البسيط"],[408,"لو كان يعلم أنها الأحداق","https://www.aldiwan.net/poem46984.html","الكامل"],[409,"هذا النسيم أتاك من نجد","https://www.aldiwan.net/poem33970.html","الكامل"],[422,"نزلوا بحيث السفح من نعمان","https://www.aldiwan.net/poem54001.html","الكامل"],[447,"ألق العصي فهذا مقتضى الأرب","https://www.aldiwan.net/poem14330.html","البسيط"],[447,"صب صبته إلى ليلى صبابته","https://www.aldiwan.net/poem14340.html","البسيط"],[482,"ما ضر أهل الحمى لو أنهم رجعوا","https://www.aldiwan.net/poem15287.html","البسيط"],[543,"لم أستمع لشكاية من شاك","https://www.aldiwan.net/poem48003.html","عموديه"],[543,"زارت ضيوف النيل منا المغربا","https://www.aldiwan.net/poem48267.html","عموديه"],[558,"طرق الخيال فهاج لي بلبالا","https://www.aldiwan.net/poem68406.html","الكامل"],[563,"لي رتبة العلامة الشهم الأَسد","https://www.aldiwan.net/poem34635.html","الكامل"],[622,"","https://poetry.dctabudhabi.ae/diwan/poem/130718","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122787","البسيط"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34434","السريع"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70651","المجتث"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72305","الكامل"],[1483,"","https://poetry.dctabudhabi.ae/diwan/poem/130659","البسيط"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102056","البسيط"],[1954,"","https://poetry.dctabudhabi.ae/diwan/poem/188167","البسيط"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113737","الكامل"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141200","الدوبيت"],[3112,"","https://poetry.dctabudhabi.ae/diwan/poem/130449","الرجز"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132794","الرجز"],[3641,"","https://poetry.dctabudhabi.ae/diwan/poem/202258","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91093","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91073","البسيط"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34548","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133226","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133235","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133231","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133248","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133232","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133257","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133249","البسيط"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133241","البسيط"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29329","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111495","الرجز"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101381","البسيط"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78230","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90975","الكامل"],[4376,"","https://poetry.dctabudhabi.ae/diwan/poem/131916","الكامل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66180","الكامل"],[4802,"الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=34355",""],[4814,"أنا ما بكيت","https://www.poetsgate.com/ViewPoem.aspx?id=194406",""],[4858,"رثاء البطل الشهيد مجاهد شحادة","https://www.poetsgate.com/ViewPoem.aspx?id=33320",""],[5038,"رشأ هفا","https://www.poetsgate.com/ViewPoem.aspx?id=188323",""],[3271,"من مرج عبقر","https://www.poetsgate.com/ViewPoem.aspx?id=104125",""],[5106,"يَا مِسْكَةَ العَرَبِ ..","https://www.poetsgate.com/ViewPoem.aspx?id=154846",""],[5121,"هَذَا النَّدِيُّ","https://www.poetsgate.com/ViewPoem.aspx?id=215090",""],[5213,"أرح قلوصك من كد ومن تعب","https://www.poetsgate.com/ViewPoem.aspx?id=170412",""],[5219,"القول المسدد في معارضة همزية أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=193910",""],[5271,"فرح","https://www.poetsgate.com/ViewPoem.aspx?id=123671",""],[5365,"إلى راحلة لمّا تعُد","https://www.poetsgate.com/ViewPoem.aspx?id=191263",""],[5365,"خمرة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=191265",""],[5368,"يا صرخة المخنوق","https://www.poetsgate.com/ViewPoem.aspx?id=186650",""],[5376,"قفْ ودِّعِ الكفرَ فالإسلامُ في نهم","https://www.poetsgate.com/ViewPoem.aspx?id=188508",""],[5376,"أتاك قلبي ببعضِ الصمتِ يختصرُ","https://www.poetsgate.com/ViewPoem.aspx?id=214061",""],[5493,"مدن السراب","https://www.poetsgate.com/ViewPoem.aspx?id=197089",""],[5497,"حنت إلى خطواته","https://www.poetsgate.com/ViewPoem.aspx?id=206938",""],[5497,"هذا النبي محمدٌ","https://www.poetsgate.com/ViewPoem.aspx?id=207252",""],[5528,"عذرا رسول الله ! - صلى الله عليه وسلم -","https://www.poetsgate.com/ViewPoem.aspx?id=201136",""],[5536,"إلى هوازن من عدنان منتسبي","https://www.poetsgate.com/ViewPoem.aspx?id=37054",""],[5672,"في يوم الطف...","https://www.poetsgate.com/ViewPoem.aspx?id=206518",""],[5770,"ذكرت لوزان","https://www.poetsgate.com/ViewPoem.aspx?id=178266",""],[5815,"غصّة","https://www.poetsgate.com/ViewPoem.aspx?id=190032",""],[5956,"لحن الحب","https://www.poetsgate.com/ViewPoem.aspx?id=186141",""],[5956,"النبأ المُفْجع","https://www.poetsgate.com/ViewPoem.aspx?id=192921",""],[5956,"أنهكتَ نفسك لتنفعني وتنفعَ العالم","https://www.poetsgate.com/ViewPoem.aspx?id=206262",""],[6093,"إِنَّ السُّمَاةَ إِلى مَدِيْحِ مُحَمَّدٍ","https://www.poetsgate.com/ViewPoem.aspx?id=186686",""],[406,"يا قدس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=835&r=&rc=26",""],[6318,"القدس في خطر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66164&r=&rc=14",""],[6327,"لامية الهمج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86571&r=&rc=6",""]],"verses":[["هَذا النّيْروزُ أتاكَ بِما","تهْواهُ وبالبُشْرَى سَبَقا",0,"ق",2,0],["هَذا النَهارُ بَدا لَها مِن هَمِّها","ما بالُها بِاللَيلِ زالَ زَوالُها",1,"ل",3,0],["هَذا النَعيمُ الَّذي كُنتَ تُنشِدُهُ","لا تَلهُ عَنهُ بِشَئي غَيرِ مَوجودِ",2,"د",1,0],["هذا النعيم وهاته المحن","يتنافسان الدهر إقلاعا",3,"ع",2,0],["هَذا النَبِيُّ وَكانَ صَفوَةَ رَبِّهِ","مِن بَينٍ بادٍ في الأَنامِ وَقارِ",4,"ر",1,0],["هَذا النَّبيُّ وَذاكَ الجَيشُ مُنتَشِرٌ","مِلءَ الفَضا فَاِستَبق لِلخَيرِ تَغتَنِمِ",5,"م",1,0],["هذا النْذيرُ فإن أبيتِ سوى الأذى","فالأرضُ بالدّمِ لا محالةَ تُغسلُ",6,"ل",1,0],["هذا النشيدُ الأسيويُّ مَعادُهُ","نبأٌ تقَرُّ به الشعوبُ وتنعَمُ",7,"م",1,0],["هذا النشيدُ نشيدُ الحبِّ تعزِفُهُ","له عرائسُ مِثلُ الورد أبكارُ",8,"ر",1,0],["هذا النشور ، أو الميلاد ، مدّ فما","الى الأعالي ، فدلّى نهده القمر",9,"ر",1,0],["هذا النعيم الذي قد كنت تنشده","لا تله عنه بشيء غير موجود",10,"د",1,0],["هذا النبي الهاشمي هو الذي","هُدي الأنام به وبان المسلك",11,"ك",1,0],["هذا النبي ومن آيات أثرته","في الطِّيب والطوّل لا تجري بمقياس",12,"س",1,0],["هَذا النَطاسِيُّ الَّذي مِن بَعدِهِ","بَكَتِ العُيونُ بِدَمعِ كُلِّ عَليلِ",13,"ل",1,1],["هذا النبيُّ مُكرَّماً بشفاعة","للناس إذ لا يملكُون خطابا",14,"ب",2,0],["هَذا النهارىالَّذي في ضمن تربته","حج وَمُعتَمِر للأَنيق الرسم",15,"م",1,0],["هَذَا النّقا حَيثُ النّفوسُ تُباح","والأَلْبابُ تُسْلَبُ والدَماءُ تُراقُ",16,"ق",1,0],["هذا النسيم أتاك من نجد","متفصلاً من صورة الصد",17,"د",1,1],["هذا النقيب الهاشميُّ ويا له","إنسانُ عين العزِّ من إنسان",18,"ن",1,0],["هذا النبي الأبي المصطفى العربي","نور الذبيحين مبري ومطلب",19,"ب",1,0],["هذا النبي الذي صحت نبوته","من قبل خلق السما والأرض والشهب",19,"ب",1,0],["هذا النبي المنبا غير مشتبه","هذا المنيع الحمى والمستلاذ به",19,"ه",1,0],["هذا النبي الذي لولاه ما خلقت","دنيا وأخرى ولولاه لما رزقت",19,"ت",1,0],["هذا النبي الذي عمت فضائله","وأوسعت من على الدنيا فواضله",19,"ه",1,0],["هذا النبي الذي نصت فضائله","وعمت الخق بالجدوى سماحته",20,"ت",2,0],["هذا النظيمُ الذي أضحى يُطاوعُني","في سبكهِ النُّظّامِ يَسْتَنِعُ",21,"ع",1,0],["هَذا النَّدَى بل هذِه غَايَاتُه","أو مَا رَأت لُطفَ الندَى عَينَاك",22,"ك",1,0],["هذا النجَاحُ وهذِه غَايَاتُه","ليسَ النَّجَاح لِمُبتغِيه بأصَعَبَا",23,"ب",2,0],["هَذا النَعيمُ فَكَيفَ لي بِدَوامِهِ","أَنّى يَدومُ وَعَيشُهُ قَد زالا",24,"ل",2,0],["هذا النعيم هو المقيم إلى الأبدْ","يا نسوة الحظ الخسيس رويدكن",25,"ن",1,0],["هذا النزيلُ وأنتم أدرى به","وضميرهُ في سترهِ كالمبرزِ",26,"ز",1,0],["هَذا النِّقابُ أوَجهٌ فيهِ أَم قَمَرٌ","وَفي الغُلالَةِ قَدُّ مِنكَ أَم غُصُنُ",27,"ن",1,0],["هَذا النِظام","وَقلت يا قَلبيَ يا مستهام",28,"م",1,0],["هذا النبي الشفيعُ الْها","دي بغير امتراءِ",29,"ا",2,0],["هذا النجاح فكل ما قد رمته","قد عم فانظر منه في تحقيقه",30,"ق",2,0],["هذا النشيط من الطلاب بشرنا","باننا نرتقي مستقبل العمر",31,"ر",1,0],["هذا النبي الكريم المرتجى سنداً","في دار دنيا وأخرى معدن الكرم",32,"م",1,0],["هذا النداء ندار العرب أطلقه","قلب تألق إخلاصاً وإيمانا",33,"ن",2,0],["هذا النخيلُ وتلك دارُ المصطفى","أفلا تَرى الأنوارَ فيها تظهرُ",34,"ر",1,0],["هذا النَّبَأُ العظيُم ما فيه كلامْ","هذا لِمَلائِكِ السَّموات إمامْ",35,"م",1,1],["هذا النبي لك بالخير ضمن","وربك الغفور ذو الرحمة إن",36,"ن",1,0],["هذا النضار مثل لوني احمر","وفضله بين الورى لا ينكر",37,"ر",1,0],["هذا النجاشي قد سارت كتائبه","مع الليوث عليها البيض تتقد",38,"د",1,0],["هَذا النَبيّ الَّذي كانَت حَقيقته","سرّ الوُجود وَوافاه كَعنوان",39,"ن",1,0],["هَذا النبي الَّذي لَولاه ما رُحِمت","نَفسٌ وَلا ظَل قَلبٌ غَيرَ مضطرب",40,"ب",1,0],["هذا النعيم ولا عيشٌ تكونُ به","هندٌ برابيةٍ من بعد أسماء",41,"ا",2,0],["هذا النبي الهاشمي هو الذي","ردّت له عند الغروب ذكاء",42,"ا",2,0],["هذا النبي أتى بأشرف شرعة","وأجل ما ارتاحت له العقلاء",42,"ا",2,0],["هذا النبي به الأكوان قد شرفت","والعرش والفرش والأملاك والشهب",43,"ب",1,0],["هذا النبي له الأحجار قد نطقت","هذا النبي به قد بشرت كتب",43,"ب",1,0],["هذا النبي الذي سارت بسيرته ال","كبان وانجلت الأحزان والكرب",43,"ب",1,0],["هذا النبي الذي لولا نبوته","ما كان ركن ولا شرط ولا سبب",43,"ب",1,0],["هذا النبي الذي كانت نبوّته","طب القلوب فداوات كل مرضاها",44,"ا",3,0],["هذا النبي لنا ركن وملتجا","من يلتجىء لسواه ضل أوتاها",44,"ا",3,0],["هذا النبي المصطفى من معشر","كانوا الأفق المجد بدرا نيرا",45,"ر",2,0],["هذا النبي له الفخار فدينه","لمكارم الأخلاق جاء مقررا",45,"ر",2,0],["هذا النبي أباد الكفر صارمه","من بعد ما عاندوا في رد دعواه",46,"ا",2,0],["هذا النبي له الأشجار قد سجدت","والضب أعرب بالفصحى وحيّاه",46,"ا",2,0],["هذا النبي هو المختار في أزل","فحبذا من أكنّ الغيب والأزل",47,"ل",1,0],["هذا النبي له الأشجار قد سجدت","والضب كلمه والظبي والجمل",47,"ل",1,0],["هذا النبي له الأحجار قد نطقت","والنخل أدنى لخير الخلق أثماره",48,"ر",2,0],["هذا النبي الذي كانت بشاشته","على الكمال وآيات الهدى شاره",48,"ر",2,0],["هذا النبي حباه الله منعته","كما حبا صحبه عزا وأنصاره",48,"ر",2,0],["هذا النبي به الأكوان قد شرفت","ومنه نالت بفضل الله إسعادا",49,"د",2,0],["هذا النَهارُ خِلالَ السُحبِ يَظهَرُ لي","لَقَد لَمَحتُ عَلى الوادي بَشائِرَهُ",50,"ه",1,0],["هَذا النِطاسِيُّ الذي يَستَخرِجُ","سَهماً بِكَرّاتِ الصِدامِ يولَجُ",51,"ج",1,0],["هذا النعيم الذي انصبت موارده","عليكم واستدارت حوله النعم",52,"م",1,0],["هذا النَعيمُ بِهِ الاِحبَّة تَلتَقي","لا عَيشَ اِلّا عيشه المَبرور",53,"ر",1,0],["هذا النعيم ونعم جنات بها","فاز التقي العالم النحرير",54,"ر",1,0],["هذا النفاق ومن ينافق فاسق","والفاسقون باسفل النيران",55,"ن",1