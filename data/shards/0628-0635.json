tml","الكامل"],[465,"أعيا وقد عاينتم الآية العظمى","https://www.aldiwan.net/poem3135.html","عموديه"],[465,"يا كم هزمنا عسكر","https://www.aldiwan.net/poem3258.html","عموديه"],[465,"فؤادي وفودي بعد لمياء أشيب","https://www.aldiwan.net/poem3559.html","عموديه"],[480,"رأيت الناس أقساما","https://www.aldiwan.net/poem37621.html","مجزوء الوافر"],[501,"يا إلهي يا معين العاجزين","https://www.aldiwan.net/poem37550.html","الرمل"],[501,"يا آلهي بدولة الأسماء","https://www.aldiwan.net/poem37720.html","الخفيف"],[501,"ليل المحب إذا تطاول بالسهر","https://www.aldiwan.net/poem38019.html","الكامل"],[515,"روت عن تراقيها العقود عن النحر","https://www.aldiwan.net/poem20796.html","الطويل"],[515,"هذا الحمى فانزل على جرعائه","https://www.aldiwan.net/poem20799.html","الكامل"],[515,"أموا بنا نحو العقيق وأدلجوا","https://www.aldiwan.net/poem20813.html","الكامل"],[515,"أتنكر بأس أحداق العذارى","https://www.aldiwan.net/poem20826.html","الوافر"],[516,"بصعود منزلة وجد صاعد","https://www.aldiwan.net/poem12058.html","الكامل"],[516,"بصفات مجدك يشرف التمجيد","https://www.aldiwan.net/poem12060.html","الكامل"],[552,"أترى يؤوب زماننا","https://www.aldiwan.net/poem47734.html","مجزوء الكامل"],[559,"طريقتنا قل بأقوالها","https://www.aldiwan.net/poem33500.html","المتقارب"],[559,"ظهر الحق للعيان وبينا","https://www.aldiwan.net/poem33801.html","الخفيف"],[559,"شمس وحي ظهرت في قمري","https://www.aldiwan.net/poem34473.html","الرمل"],[562,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[563,"لنا ليلة قد أشبهت ليلة القدر","https://www.aldiwan.net/poem52721.html","الطويل"],[563,"أتى في أوان القطر أشهى من القطر","https://www.aldiwan.net/poem52777.html","الطويل"],[564,"هو الأجل الموقوت لا يتخلف","https://www.aldiwan.net/poem13603.html","الطويل"],[568,"نطق الود باللسان الفصيح","https://www.aldiwan.net/poem69741.html","الخفيف"],[587,"لو رمت إبقاء الوداد بحاله","https://www.aldiwan.net/poem17687.html","الكامل"]],"verses":[["بصدر الناس في طخياء عمت","رؤوسهم زماناً والذنابا",0,"ب",2,0],["بَصيرٌ بِتَصريفِ الأَعِنَّةِ إِن سَرى","لِيَومِ نِزالٍ أَو لِبَومِ رِهانِ",1,"ن",1,0],["بِصَفحَتَيهِ جُلَبٌ قُرِّفَت","مِنَ اللَيالي وَكُلومٌ دَوام",2,"م",1,0],["بِصَوائِبٍ كَالشُهبِ تَتبَعُ مِثلَها","وَرِعالِ خَيلٍ يَتَّبِعنَ رِعالا",3,"ل",2,0],["بَصيرٌ بِرَميِ القَطرِ حَتّى كَأَنَّهُ","عَلى الرَملِ قاريُّ السِهامِ نَجيبُ",4,"ب",1,0],["بِصِيامِ يَومِ القَيظِ تَلهَبُ شَمسُهُ","وَقِيامِ طولِ اللَيلَةِ اللَيلاءِ",5,"ا",2,0],["بِصَفيحَةٍ بَيْضاءَ لَمّا شِمْتُها","دَلَفَتْ إِليْهِ مَنِيَّةٌ سَوْدَاءُ",6,"د",3,0],["بصُعْرٍ تَبارَتْ في الأزِمّةِ شُمَّذٍ","تَؤُمُّ بنا فَجّاً منَ الأرضِ مَجْهَلا",7,"ل",2,0],["بصُيّابَةٍ مَجْرٍ وكُرّامَةٍ ثُبًى","ومُرهَفَةٍ بيضٍ ومُشرَعَةٍ سُمْرِ",8,"ر",1,0],["بِصارِمٍ حَيثُما جَرَّدتُهُ سَجَدَت","لَهُ جَبابِرَةُ الأَعجامِ وَالعَرَبِ",9,"ب",1,0],["بِصارِمِ عَزمٍ لَو ضَرَبتُ بِحَدِّهِ","دُجى اللَيلِ وَلّى وَهوَ بِالنَجمِ يَعثَرُ",10,"ر",1,0],["بَصَرتَ بِها كَوماءَ حَوساءَ جَلدَةً","مِنَ المولياتِ الهامِ حَدَّ الظَهائِرِ",11,"ر",1,0],["بَصَرتَ بِأَنَّنا أَصحابُ حَقٍّ","نُدِلُّ بِهِ وَإِخوانٌ وَجيرَه",12,"ر",2,0],["بَصيرٌ بِأَدغالِ الضَراءِ إِذا خَدى","يَعيلُ وَيَخفى بِالجِهادِ وَيَمثُلُ",13,"ل",1,0],["بِصَبرٍ وَإِبقاءٍ عَلى جُلِّ قَومِكُم","عَلى كُلِّ حالٍ بِالأُنا وَالتَحَنُّنِ",14,"ن",1,0],["بَصائِرُ رُشدٍ لِلفَتى مُستَبينَةٌ","وَأَخلاقُ صِدقٍ عِلمُها بِالتَعَلُّمِ",15,"م",1,0],["بِصَوْنِهِمْ مُلْكَهُمْ صَانُوا حَقِيقَتَهُمْ","مِنْ أَنْ تُرَى السَّادَةُ الأمْجَادُ فِي الخَدَم",16,"م",1,0],["بِصُلبِ المِعى أَو بُرقَةِ الثَورِ لَم يَدَع","لَها جِدَّةً جَولُ الصَبا وَالجَنائِبِ",17,"ب",1,0],["بصاد أقسمُ ما للعينِ إن عشقتْ","سواك نونٌ ولا ظاءٌ ولا راءُ",18,"ا",2,0],["بصالحِ حمصٍ نستعينُ على الثنا","لديك ونرجوه لنظمِ المدائح",19,"ح",1,1],["بصمّ الحصى ترمي الحداة كأنما","تغارُ على محبوبها حين يُذكر",20,"ر",1,0],["بصوتك أركان الشريعة شيّدت","وصينت ثغور كلها باسم الثغر",21,"ر",1,0],["بصائبٍ من سهام الرأي أيَّدَهُ","بالبحث والفحص لا بالرِّيشِ والعَقَبِ",22,"ب",1,0],["بَصَّرْتَهُ رشْدَه في نصر سادته","بضوء رأيك حتى بان فاتضحا",23,"ح",2,0],["بصيرُ سِنان الرمح يرمي أمامه","بطرفٍ له نحوَ المقاتل شاخص",24,"ص",1,0],["بَصيرٌ بِأُخراها يَسوفُ فُروجَها","عَلَيهِنَّ ذَيّالٌ خَفيفٌ ذَلاذِلُه",25,"ل",2,0],["بِصُلبِ قَناةِ الأَمرِ ما إِن يَصورُها ال","ثِقافُ إِذا بَعضُ القَنا صيرَ بِالأَطرِ",26,"ر",1,0],["بِصَحيفَةٍ نورُ العُيونِ سَوادُها","وَبَياضُها مِن ناصِعِ الأَجيادِ",27,"د",1,0],["بَصَرتُ لَكِن مِثلَما شاءَ الكَمَد","شاعِراً مِن مُقلَتي أَرتَجِلُ",28,"ل",1,0],["بَصباصَةُ الخِمسِ في زَوراءَ مَهلَكَةٍ","يَهدي الأَدِلّاءَ فيها كَوكَبٌ وَحَدُ",29,"د",1,0],["بِصَفنَةِ راكِبٍ وَمُوَصَّلاتٍ","جَمَعتُ الرَثَّ مِنها وَالمَتينا",30,"ن",2,0],["بَصُرتُ بِأَخلاقِ الرِجالِ فَلَم أَجِد","وَإِن جَلَتِ الأَخلاقُ لِلعَزمِ ثانِيا",31,"ي",2,0],["بِصَباً يُذكِرُ الرِياضَ صَباهُ","وَحِجازٍ أَرَقُّ مِن أَسحارِهِ",32,"ر",2,0],["بَصيرٌ بِأَخذِ الحَمدِ مِن كُلِّ مَوضِعٍ","وَلَو خَبَّأَتهُ بَينَ أَنيابِها الأُسدُ",33,"د",1,0],["بِصارِمي مُرتَدٍ بِمَخبُرَتي","مُجتَزِئٌ بِالظَلامِ مُشتَمِلُ",34,"ل",1,0],["بِصُدورِ أَقلامٍ تَرُدُّ إِلَيهِمُ","أَمرَ الخِلافَةِ أَو صُدورِ رِماحِ",35,"ح",1,0],["بِصُدورِ أَقلامٍ تَرُدُّ إِلَيهِمُ","شَرَفَ الرِياسَةِ أَو صُدورِ رِماحِ",36,"ح",1,0],["بِصَريمَةٍ كَالسَيفِ هَزَّ غِرارَهُ","ماضي الجَنانِ بِهِ طَويلُ الساعِدِ",37,"د",1,0],["بِصَديقِكَ الصِدقِ الَّذي جَمَعَتكُما","قِدَمُ الفُتوَّةِ وَاِرتِضاعُ الأَكؤُسِ",38,"س",1,0],["بِصَولَتِهِ كانَ اِنقِضاضُ بِنائِهِ","لِأَسفَلٍ سُفلِ وَاِنفِضاضُ جُموعِهِ",39,"ع",2,0],["بِصَحراءَ مِكماءٍ تُرَدُّ جُناتُها","إِلَيها الجَنى في ثَوبِ مَن يَستَثيرُها",40,"ر",3,0],["بِصَفحةِ مصقولِ الأديمِ كأنَّما","سَفائِنُهُ رُبْدُ النَّعامِ المُشرَّدِ",41,"د",1,0],["بَصيرةُ ليلٍ ولكنَّها","ضريرَتُه عندَ إصباحِها",42,"ح",3,0],["بصبحٍ من محاسِنِه تجلَّى","وليلٍ من ذوائِبه يذوبُ",43,"ب",1,0],["بَصُروا بِفَروِكَ فَازدَروكَ لِحالَةٍ","أَضحى بِها مَعروفُ حُسنِكَ مُنكَرا",44,"ر",2,1],["بِصارِمٍ لا يَرُدُّ الدِرعُ ضَربَتَهُ","وَلَو سَنى نَسجَهُ المَردودَ داوودُ",45,"د",1,0],["بِصِفاحٍ تُخالُ مَوجَ المَنايا","في صَفا مَتنِها عُيونُ الجَرادِ",46,"د",1,0],["بصرت به والصحن بالصحن يلتقي","فلم أر أبهى من غنيم و