ps://www.aldiwan.net/poem3135.html","عموديه"],[464,"يا كم هزمنا عسكر","https://www.aldiwan.net/poem3258.html","عموديه"],[464,"فؤادي وفودي بعد لمياء أشيب","https://www.aldiwan.net/poem3559.html","عموديه"],[479,"رأيت الناس أقساما","https://www.aldiwan.net/poem37621.html","مجزوء الوافر"],[500,"يا إلهي يا معين العاجزين","https://www.aldiwan.net/poem37550.html","الرمل"],[500,"يا آلهي بدولة الأسماء","https://www.aldiwan.net/poem37720.html","الخفيف"],[500,"ليل المحب إذا تطاول بالسهر","https://www.aldiwan.net/poem38019.html","الكامل"],[514,"روت عن تراقيها العقود عن النحر","https://www.aldiwan.net/poem20796.html","الطويل"],[514,"هذا الحمى فانزل على جرعائه","https://www.aldiwan.net/poem20799.html","الكامل"],[514,"أموا بنا نحو العقيق وأدلجوا","https://www.aldiwan.net/poem20813.html","الكامل"],[514,"أتنكر بأس أحداق العذارى","https://www.aldiwan.net/poem20826.html","الوافر"],[515,"بصعود منزلة وجد صاعد","https://www.aldiwan.net/poem12058.html","الكامل"],[515,"بصفات مجدك يشرف التمجيد","https://www.aldiwan.net/poem12060.html","الكامل"],[551,"أترى يؤوب زماننا","https://www.aldiwan.net/poem47734.html","مجزوء الكامل"],[558,"طريقتنا قل بأقوالها","https://www.aldiwan.net/poem33500.html","المتقارب"],[558,"ظهر الحق للعيان وبينا","https://www.aldiwan.net/poem33801.html","الخفيف"],[558,"شمس وحي ظهرت في قمري","https://www.aldiwan.net/poem34473.html","الرمل"],[561,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[562,"لنا ليلة قد أشبهت ليلة القدر","https://www.aldiwan.net/poem52721.html","الطويل"],[562,"أتى في أوان القطر أشهى من القطر","https://www.aldiwan.net/poem52777.html","الطويل"],[563,"هو الأجل الموقوت لا يتخلف","https://www.aldiwan.net/poem13603.html","الطويل"],[567,"نطق الود باللسان الفصيح","https://www.aldiwan.net/poem69741.html","الخفيف"],[586,"لو رمت إبقاء الوداد بحاله","https://www.aldiwan.net/poem17687.html","الكامل"]],"verses":[["بَصيرٌ بِتَصريفِ الأَعِنَّةِ إِن سَرى","لِيَومِ نِزالٍ أَو لِبَومِ رِهانِ",0,"ن",1,0],["بِصَفحَتَيهِ جُلَبٌ قُرِّفَت","مِنَ اللَيالي وَكُلومٌ دَوام",1,"م",1,0],["بِصَوائِبٍ كَالشُهبِ تَتبَعُ مِثلَها","وَرِعالِ خَيلٍ يَتَّبِعنَ رِعالا",2,"ل",2,0],["بَصيرٌ بِرَميِ القَطرِ حَتّى كَأَنَّهُ","عَلى الرَملِ قاريُّ السِهامِ نَجيبُ",3,"ب",1,0],["بِصِيامِ يَومِ القَيظِ تَلهَبُ شَمسُهُ","وَقِيامِ طولِ اللَيلَةِ اللَيلاءِ",4,"ا",2,0],["بِصَفيحَةٍ بَيْضاءَ لَمّا شِمْتُها","دَلَفَتْ إِليْهِ مَنِيَّةٌ سَوْدَاءُ",5,"د",3,0],["بصُعْرٍ تَبارَتْ في الأزِمّةِ شُمَّذٍ","تَؤُمُّ بنا فَجّاً منَ الأرضِ مَجْهَلا",6,"ل",2,0],["بصُيّابَةٍ مَجْرٍ وكُرّامَةٍ ثُبًى","ومُرهَفَةٍ بيضٍ ومُشرَعَةٍ سُمْرِ",7,"ر",1,0],["بِصارِمٍ حَيثُما جَرَّدتُهُ سَجَدَت","لَهُ جَبابِرَةُ الأَعجامِ وَالعَرَبِ",8,"ب",1,0],["بِصارِمِ عَزمٍ لَو ضَرَبتُ بِحَدِّهِ","دُجى اللَيلِ وَلّى وَهوَ بِالنَجمِ يَعثَرُ",9,"ر",1,0],["بَصَرتَ بِها كَوماءَ حَوساءَ جَلدَةً","مِنَ المولياتِ الهامِ حَدَّ الظَهائِرِ",10,"ر",1,0],["بَصَرتَ بِأَنَّنا أَصحابُ حَقٍّ","نُدِلُّ بِهِ وَإِخوانٌ وَجيرَه",11,"ر",2,0],["بَصيرٌ بِأَدغالِ الضَراءِ إِذا خَدى","يَعيلُ وَيَخفى بِالجِهادِ وَيَمثُلُ",12,"ل",1,0],["بِصَبرٍ وَإِبقاءٍ عَلى جُلِّ قَومِكُم","عَلى كُلِّ حالٍ بِالأُنا وَالتَحَنُّنِ",13,"ن",1,0],["بَصائِرُ رُشدٍ لِلفَتى مُستَبينَةٌ","وَأَخلاقُ صِدقٍ عِلمُها بِالتَعَلُّمِ",14,"م",1,0],["بِصَوْنِهِمْ مُلْكَهُمْ صَانُوا حَقِيقَتَهُمْ","مِنْ أَنْ تُرَى السَّادَةُ الأمْجَادُ فِي الخَدَم",15,"م",1,0],["بِصُلبِ المِعى أَو بُرقَةِ الثَورِ لَم يَدَع","لَها جِدَّةً جَولُ الصَبا وَالجَنائِبِ",16,"ب",1,0],["بصاد أقسمُ ما للعينِ إن عشقتْ","سواك نونٌ ولا ظاءٌ ولا راءُ",17,"ا",2,0],["بصالحِ حمصٍ نستعينُ على الثنا","لديك ونرجوه لنظمِ المدائح",18,"ح",1,1],["بصمّ الحصى ترمي الحداة كأنما","تغارُ على محبوبها حين يُذكر",19,"ر",1,0],["بصوتك أركان الشريعة شيّدت","وصينت ثغور كلها باسم الثغر",20,"ر",1,0],["بصائبٍ من سهام الرأي أيَّدَهُ","بالبحث والفحص لا بالرِّيشِ والعَقَبِ",21,"ب",1,0],["بَصَّرْتَهُ رشْدَه في نصر سادته","بضوء رأيك حتى بان فاتضحا",22,"ح",2,0],["بصيرُ سِنان الرمح يرمي أمامه","بطرفٍ له نحوَ المقاتل شاخص",23,"ص",1,0],["بَصيرٌ بِأُخراها يَسوفُ فُروجَها","عَلَيهِنَّ ذَيّالٌ خَفيفٌ ذَلاذِلُه",24,"ل",2,0],["بِصُلبِ قَناةِ الأَمرِ ما إِن يَصورُها ال","ثِقافُ إِذا بَعضُ القَنا صيرَ بِالأَطرِ",25,"ر",1,0],["بِصَحيفَةٍ نورُ العُيونِ سَوادُها","وَبَياضُها مِن ناصِعِ الأَجيادِ",26,"د",1,0],["بَصَرتُ لَكِن مِثلَما شاءَ الكَمَد","شاعِراً مِن مُقلَتي أَرتَجِلُ",27,"ل",1,0],["بَصباصَةُ الخِمسِ في زَوراءَ مَهلَكَةٍ","يَهدي الأَدِلّاءَ فيها كَوكَبٌ وَحَدُ",28,"د",1,0],["بِصَفنَةِ راكِبٍ وَمُوَصَّلاتٍ","جَمَعتُ الرَثَّ مِنها وَالمَتينا",29,"ن",2,0],["بَصُرتُ بِأَخلاقِ الرِجالِ فَلَم أَجِد","وَإِن جَلَتِ الأَخلاقُ لِلعَزمِ ثانِيا",30,"ي",2,0],["بِصَباً يُذكِرُ الرِياضَ صَباهُ","وَحِجازٍ أَرَقُّ مِن أَسحارِهِ",31,"ر",2,0],["بَصيرٌ بِأَخذِ الحَمدِ مِن كُلِّ مَوضِعٍ","وَلَو خَبَّأَتهُ بَينَ أَنيابِها الأُسدُ",32,"د",1,0],["بِصارِمي مُرتَدٍ بِمَخبُرَتي","مُجتَزِئٌ بِالظَلامِ مُشتَمِلُ",33,"ل",1,0],["بِصُدورِ أَقلامٍ تَرُدُّ إِلَيهِمُ","أَمرَ الخِلافَةِ أَو صُدورِ رِماحِ",34,"ح",1,0],["بِصُدورِ أَقلامٍ تَرُدُّ إِلَيهِمُ","شَرَفَ الرِياسَةِ أَو صُدورِ رِماحِ",35,"ح",1,0],["بِصَريمَةٍ كَالسَيفِ هَزَّ غِرارَهُ","ماضي الجَنانِ بِهِ طَويلُ الساعِدِ",36,"د",1,0],["بِصَديقِكَ الصِدقِ الَّذي جَمَعَتكُما","قِدَمُ الفُتوَّةِ وَاِرتِضاعُ الأَكؤُسِ",37,"س",1,0],["بِصَولَتِهِ كانَ اِنقِضاضُ بِنائِهِ","لِأَسفَلٍ سُفلِ وَاِنفِضاضُ جُموعِهِ",38,"ع",2,0],["بِصَحراءَ مِكماءٍ تُرَدُّ جُناتُها","إِلَيها الجَنى في ثَوبِ مَن يَستَثيرُها",39,"ر",3,0],["بِصَفحةِ مصقولِ الأديمِ كأنَّما","سَفائِنُهُ رُبْدُ النَّعامِ المُشرَّدِ",40,"د",1,0],["بَصيرةُ ليلٍ ولكنَّها","ضريرَتُه عندَ إصباحِها",41,"ح",3,0],["بصبحٍ من محاسِنِه تجلَّى","وليلٍ من ذوائِبه يذوبُ",42,"ب",1,0],["بَصُروا بِفَروِكَ فَازدَروكَ لِحالَةٍ","أَضحى بِها مَعروفُ حُسنِكَ مُنكَرا",43,"ر",2,1],["بِصارِمٍ لا يَرُدُّ الدِرعُ ضَربَتَهُ","وَلَو سَنى نَسجَهُ المَردودَ داوودُ",44,"د",1,0],["بِصِفاحٍ تُخالُ مَوجَ المَنايا","في صَفا مَتنِها عُيونُ الجَرادِ",45,"د",1,0],["بصرت به والصحن بالصحن يلتقي","فلم أر أبهى من غنيم وأظرفا",46,"ف",2,0],["بصيرٌ بمردي الطعن يُغْري سنانه","بجارحةٍ في طيّها الوِرْدُ والغَمْرُ",47,"ر",1,0],["بِصَقيلِ اللَّ