ps://www.aldiwan.net/poem31480.html","المتدارك"],[80,"تدرعت صبري جنة للنوائب","https://www.aldiwan.net/poem31551.html","الطويل"],[44,"لقد أخذت من دار ماوية الحقب","https://www.aldiwan.net/poem30580.html","الطويل"],[44,"السيف أصدق أنباء من الكتب","https://www.aldiwan.net/poem30591.html","البسيط"],[31,"خليلي مرا بي على رسم منزل","https://www.aldiwan.net/poem41841.html","الطويل"],[31,"يقولون لي أقصر ولست بمقصر","https://www.aldiwan.net/poem42538.html","الطويل"],[105,"طغت الدماء وفاضت الأرواح","https://www.aldiwan.net/poem43145.html","الكامل"],[105,"بني عامر ردوا عن الشر عامرا","https://www.aldiwan.net/poem44014.html","الطويل"],[105,"أخالد إنك ذو نجدة","https://www.aldiwan.net/poem44022.html","المتقارب"],[105,"لمن الجموع كثيرة تتألب","https://www.aldiwan.net/poem44040.html","الكامل"],[105,"أدأبك أن تريد المستحيلا","https://www.aldiwan.net/poem44213.html","الوافر"],[13,"فقد أطلقت كلب إليكم عهودها","https://www.aldiwan.net/poem2234.html","الطويل"],[40,"إني زائر ظبيا","https://www.aldiwan.net/poem42304.html","الهزج"],[52,"لا صيد إلا بوتر","https://www.aldiwan.net/poem26974.html","مجزوء الرجز"],[67,"أزمعوا البين وشدوا الركابا","https://www.aldiwan.net/poem18030.html","المديد"],[48,"قولا لهارون إمام الهدى","https://www.aldiwan.net/poem62600.html","السريع"],[48,"مضى ليل وأخلفت النجوم","https://www.aldiwan.net/poem65101.html","الوافر"],[48,"ليتني ليت ليتني","https://www.aldiwan.net/poem66221.html","مجزوء الخفيف"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140866",""],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39630","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55195","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54912","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54693","الرجز"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142016","الكامل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24377","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54269","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54227","الطويل"],[106,"الكبش والقصاب","https://www.poetsgate.com/ViewPoem.aspx?id=179575",""],[106,"تحية فريال","https://www.poetsgate.com/ViewPoem.aspx?id=179501",""],[106,"سلاح غاندي","https://www.poetsgate.com/ViewPoem.aspx?id=179409",""],[67,"جِوَارُكَ منْ جَوْرِ الزَّمانِ يُجِيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=14535",""],[4,"معلقة لبيد بن ربيعة العامري","https://www.poetsgate.com/ViewPoem.aspx?id=30298",""],[90,"تحية الوزير","https://www.poetsgate.com/ViewPoem.aspx?id=179070",""],[99,"قدر أنتِ بشكل إمرأه","https://www.poetsgate.com/ViewPoem.aspx?id=14388",""]],"verses":[["بَصيرٌ بِتَصريفِ الأَعِنَّةِ إِن سَرى","لِيَومِ نِزالٍ أَو لِبَومِ رِهانِ",0,"ن",1,0],["بِصَفحَتَيهِ جُلَبٌ قُرِّفَت","مِنَ اللَيالي وَكُلومٌ دَوام",1,"م",1,0],["بِصَوائِبٍ كَالشُهبِ تَتبَعُ مِثلَها","وَرِعالِ خَيلٍ يَتَّبِعنَ رِعالا",2,"ل",2,0],["بَصيرٌ بِرَميِ القَطرِ حَتّى كَأَنَّهُ","عَلى الرَملِ قاريُّ السِهامِ نَجيبُ",3,"ب",1,0],["بِصِيامِ يَومِ القَيظِ تَلهَبُ شَمسُهُ","وَقِيامِ طولِ اللَيلَةِ اللَيلاءِ",4,"ا",2,0],["بِصَفيحَةٍ بَيْضاءَ لَمّا شِمْتُها","دَلَفَتْ إِليْهِ مَنِيَّةٌ سَوْدَاءُ",5,"د",3,0],["بصُعْرٍ تَبارَتْ في الأزِمّةِ شُمَّذٍ","تَؤُمُّ بنا فَجّاً منَ الأرضِ مَجْهَلا",6,"ل",2,0],["بصُيّابَةٍ مَجْرٍ وكُرّامَةٍ ثُبًى","ومُرهَفَةٍ بيضٍ ومُشرَعَةٍ سُمْرِ",7,"ر",1,0],["بِصارِمٍ حَيثُما جَرَّدتُهُ سَجَدَت","لَهُ جَبابِرَةُ الأَعجامِ وَالعَرَبِ",8,"ب",1,0],["بِصارِمِ عَزمٍ لَو ضَرَبتُ بِحَدِّهِ","دُجى اللَيلِ وَلّى وَهوَ بِالنَجمِ يَعثَرُ",9,"ر",1,0],["بَصَرتَ بِها كَوماءَ حَوساءَ جَلدَةً","مِنَ المولياتِ الهامِ حَدَّ الظَهائِرِ",10,"ر",1,0],["بَصَرتَ بِأَنَّنا أَصحابُ حَقٍّ","نُدِلُّ بِهِ وَإِخوانٌ وَجيرَه",11,"ر",2,0],["بَصيرٌ بِأَدغالِ الضَراءِ إِذا خَدى","يَعيلُ وَيَخفى بِالجِهادِ وَيَمثُلُ",12,"ل",1,0],["بِصَبرٍ وَإِبقاءٍ عَلى جُلِّ قَومِكُم","عَلى كُلِّ حالٍ بِالأُنا وَالتَحَنُّنِ",13,"ن",1,0],["بَصائِرُ رُشدٍ لِلفَتى مُستَبينَةٌ","وَأَخلاقُ صِدقٍ عِلمُها بِالتَعَلُّمِ",14,"م",1,0],["بِصَوْنِهِمْ مُلْكَهُمْ صَانُوا حَقِيقَتَهُمْ","مِنْ أَنْ تُرَى السَّادَةُ الأمْجَادُ فِي الخَدَم",15,"م",1,0],["بِصُلبِ المِعى أَو بُرقَةِ الثَورِ لَم يَدَع","لَها جِدَّةً جَولُ الصَبا وَالجَنائِبِ",16,"ب",1,0],["بصاد أقسمُ ما للعينِ إن عشقتْ","سواك نونٌ ولا ظاءٌ ولا راءُ",17,"ا",2,0],["بصالحِ حمصٍ نستعينُ على الثنا","لديك ونرجوه لنظمِ المدائح",18,"ح",1,1],["بصمّ الحصى ترمي الحداة كأنما","تغارُ على محبوبها حين يُذكر",19,"ر",1,0],["بصوتك أركان الشريعة شيّدت","وصينت ثغور كلها باسم الثغر",20,"ر",1,0],["بصائبٍ من سهام الرأي أيَّدَهُ","بالبحث والفحص لا بالرِّيشِ والعَقَبِ",21,"ب",1,0],["بَصَّرْتَهُ رشْدَه في نصر سادته","بضوء رأيك حتى بان فاتضحا",22,"ح",2,0],["بصيرُ سِنان الرمح يرمي أمامه","بطرفٍ له نحوَ المقاتل شاخص",23,"ص",1,0],["بَصيرٌ بِأُخراها يَسوفُ فُروجَها","عَلَيهِنَّ ذَيّالٌ خَفيفٌ ذَلاذِلُه",24,"ل",2,0],["بِصُلبِ قَناةِ الأَمرِ ما إِن يَصورُها ال","ثِقافُ إِذا بَعضُ القَنا صيرَ بِالأَطرِ",25,"ر",1,0],["بِصَحيفَةٍ نورُ العُيونِ سَوادُها","وَبَياضُها مِن ناصِعِ الأَجيادِ",26,"د",1,0],["بَصَرتُ لَكِن مِثلَما شاءَ الكَمَد","شاعِراً مِن مُقلَتي أَرتَجِلُ",27,"ل",1,0],["بَصباصَةُ الخِمسِ في زَوراءَ مَهلَكَةٍ","يَهدي الأَدِلّاءَ فيها كَوكَبٌ وَحَدُ",28,"د",1,0],["بِصَفنَةِ راكِبٍ وَمُوَصَّلاتٍ","جَمَعتُ الرَثَّ مِنها وَالمَتينا",29,"ن",2,0],["بَصُرتُ بِأَخلاقِ الرِجالِ فَلَم أَجِد","وَإِن جَلَتِ الأَخلاقُ لِلعَزمِ ثانِيا",30,"ي",2,0],["بِصَباً يُذكِرُ الرِياضَ صَباهُ","وَحِجازٍ أَرَقُّ مِن أَسحارِهِ",31,"ر",2,0],["بَصيرٌ بِأَخذِ الحَمدِ مِن كُلِّ مَوضِعٍ","وَلَو خَبَّأَتهُ بَينَ أَنيابِها الأُسدُ",32,"د",1,0],["بِصارِمي مُرتَدٍ بِمَخبُرَتي","مُجتَزِئٌ بِالظَلامِ مُشتَمِلُ",33,"ل",1,0],["بِصُدورِ أَقلامٍ تَرُدُّ إِلَيهِمُ","أَمرَ الخِلافَةِ أَو صُدورِ رِماحِ",34,"ح",1,0],["بِصُدورِ أَقلامٍ تَرُدُّ إِلَيهِمُ","شَرَفَ الرِياسَةِ أَو صُدورِ رِماحِ",35,"ح",1,0],["بِصَريمَةٍ كَالسَيفِ هَزَّ غِرارَهُ","ماضي الجَنانِ بِهِ طَويلُ الساعِدِ",36,"د",1,0],["بِصَديقِكَ الصِدقِ الَّذي جَمَعَتكُما","قِدَمُ الفُتوَّةِ وَاِرتِضاعُ الأَكؤُسِ",37,"س",1,0],["بِصَولَتِهِ كانَ اِنقِضاضُ بِنائِهِ","لِأَسفَلٍ سُفلِ وَاِنفِضاضُ جُموعِهِ",38,"ع",2,0],["بِصَحراءَ مِكماءٍ تُرَدُّ جُناتُها","إِلَيها الجَنى في ثَوبِ مَن يَستَثيرُها",39,"ر",3,0],["بِصَفحةِ مصقولِ الأديمِ كأنَّما","سَفائِنُهُ رُبْدُ النَّعامِ المُشرَّدِ",40,"د",1,0],["بَصيرةُ ليلٍ ولكنَّها","ضريرَتُه عندَ إصباحِها",41,"ح",3,0],["بصبحٍ من محاسِنِه تجلَّى","وليلٍ من ذوائِبه يذوبُ",42,"ب",1,0],["بَصُروا بِفَروِكَ فَازدَروكَ لِحالَةٍ","أَضحى بِها مَعروفُ حُسنِكَ مُنكَرا",43,"ر",2,1],["بِصارِمٍ لا يَرُدُّ الدِرعُ ضَربَتَهُ","وَلَو سَنى نَسجَهُ المَردودَ داوودُ",44,"د",1,0],["بِصِفاحٍ تُخالُ مَوجَ المَنايا","في صَفا مَتنِها عُيونُ الجَرادِ",45,"د",1,0],["بصرت به والصحن بالصحن يلتقي","فلم أر أبهى من غنيم وأظرفا",46,"ف",2,0],["بصيرٌ بمردي الطعن يُغْري سنانه","بجارحةٍ في طيّها الوِرْدُ والغَمْرُ",47,"ر",1,0],["بِصَقيلِ اللَّفظِ مُنَقَّحِهِ","لا سَمعَ يَمرّ به بِصَدِ",48,"د",1,0],["بصادقِ عزْم في الأماني يُحِلّني","على أمَلٍ من همّةِ النفس كاذِبِ",49,"ب",1,0],["بِصاغِرَةِ القُصوى وَطِمَّينِ وَاِقتَرى","بِلادَ قَرَنطاووسَ وابِلُكَ السَكبُ",50,"ب",1,0],["بَصُرتَ بِالراحَةِ الكُبرى فَلَم تَرَها","تُنالُ إِلّا عَلى جِسرٍ مِنَ التَعَبِ",51,"ب",1,0],["بِصَهباءِ دِرياقِ المُدامِ كَأَنَّها","إِذا ما صَفا راوُوقُها ماءُ مَفصِلِ",52,"ل",1,0],["بِصَوتٍ حَزينٍ مُثكِلٍ مُتَوَجِّعِ","وَنَفسِ مَريضِ القَلبِ أَورَثنَهُ ذِكرا",53,"ر",2,0],["بَصَرا بِأَربَعَةٍ وَلَوَّحَ خامِسٌ","فَتَأَمَّلا فَبَدا الجَميعُ وَلاحوا",54,"ح",3,0],["بصاعقةٍ ممّا رَمَى اللهُ إذ رمى","ثموداً وعاداً والقرون الغوابرا",55,"ر",2,0],["بصاعقةٍ مَنْ يَذُقْها يَقُلْ","كأنَّ الصّواعقَ لم تُرْسَلِ",56,"ل",1,0],["بَصُرُوا بها فتزايلت أوصالُهُم","رُعْباً وضَاقَ سَبيلُهُم والمَذهَبُ",57,"ب",1,0],["بِصارمِ حمزة البطلِ النّجيدِ","هَوى عثمانُ إثرَ أخٍ فقيدِ",58,"د",1,0],["بَصَرتُ بِنارٍ شِمتُها حينَ أوقِدَت","تَلوحُ لَنا بَعدَ الرُتَيلَةِ فَالهَضبِ",59,"ب",1,0],["بِصَوبِ البارِقِ الأَسحَ","مِ أَدنَتهُ سَواقِيهِ",60,"ي",2,0],["بِصِغَرٍ وَلا كِبَر","أَشبَهِ طينٍ بِحَجَر",61,"ر",1,0],["بَصَّر العُمْيَ فيا لَيْتَ عَيْني","مُلِئَتْ مِنْ أخْمَصَيْه تُرابا",62,"ب",2,0],["بِصادِقِ الطاعَةِ دَيّانِها","وَواحِدِ الغائِبِ وَالشاهِدِ",63,"د",1,0],["بِصافِيَةٍ إِذا قُرِعَت بِماءٍ","جَرى عَن مَتنِها دُرٌّ يَحومُ",64,"م",1,0],["بِصَوتِ أَخي الحِجازِ فَهاجَ شَوقي","لِمَن طَلَلٌ بِرامَةَ لا يَريمُ",64,"م",1,0],["بصُمُلِّ مقددِّ","أعجر الرأسِ أقشره",65,"ر",2,0],["\"بصارمي مرتدٍ، بمخبرتي","مجتزىءٌ بالظلام مشتمل\"",66,"ل",1,0],["بصيحة السِّلم لا يأخذْكَ إغراءُ","فللمطامع إغراءٌ وإغواءُ",67,"ا",2,0],["بِصَوْتٍ إِذَا بَحَّتْهُ غَاشِيَةُ الأَسى","فَذِكْراكَ تَجْلوهُ عَلَى مَسْمَعِ المَلاَ",68,"ل",2,0],["بِصِدْقِ مَنْ يُوِقظُ حِبّاً لَهُ","وَقَدْ غَفَا عَن طارِيءٍ مُنْذرِ",69,"ر",1,0],["بِصِحَّةِ الشُّورى نَصِحُّ كُلُّنَا","فَإِنْ أَرَبْنَا قَتَلَتْنَا عَمْدَا",70,"د",2,0],["بصرت به رث الثياب، بلا","مأوى بلا أهل بلا بلد",71,"د",1,0],["بصرْتُ بفحلٍ على خالدٍ","فقالَ وكم حكمةٍ قالَها",72,"ل",3,1],["بَصِيرَةٌ كَضِيَاءِ الصُّبْحِ لَوْ لَطَمَتْ","غَيَاهِبَ اللَّيْلِ لم يُظْلِمْ وَلَمْ يُهَبِ",73,"ب",1,0],["بَصِيرٌ إِذا سَاسَ الأُمُور تكَشَّفَتْ","وبانَ لَهُ مِنْ كُلِّ أَمْرٍ عَوَاقِبه",74,"ب",2,0],["بصرت بالكبش والقصاب يسحبُهُ","إذا ونى خُطوةً، بالسوط يُلهبُه",75,"ب",2,1],["بِصَيِّبٍ من عطفها تحبوك","بين الجفون أهلُها صانوك",76,"ك",1,0],["بصوت الحق قد نادى","وصوت الحق كالرعد",77,"د",1,0],["بِصارِمِهِ جَمْعَ الهَشِيمَ حَظِيرُ","فأخلقْ بأن يبقى ويبقى لمُلكهِ",78,"ه",1,0],["بصبوح صافية وجذب كرينة","بموتر تأتاله إبهامها",79,"م",3,0],["بصّرت بعدك من ياتي بواجبه","نحو البلاد كما أخجلتَ مَنْ ذهبا",80,"ب",2,0],["بصري أنتِ .. وهل يمكنها","أن ترى العينانِ دونَ البصرِ؟",81,"ر",1,0]]}