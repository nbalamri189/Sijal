463,"يا عاقدا وضن الجمال البزل","https://www.aldiwan.net/poem16248.html","الكامل"],[466,"أعيا وقد عاينتم الآية العظمى","https://www.aldiwan.net/poem3135.html","عموديه"],[466,"يا كم هزمنا عسكر","https://www.aldiwan.net/poem3258.html","عموديه"],[466,"فؤادي وفودي بعد لمياء أشيب","https://www.aldiwan.net/poem3559.html","عموديه"],[481,"رأيت الناس أقساما","https://www.aldiwan.net/poem37621.html","مجزوء الوافر"],[502,"يا إلهي يا معين العاجزين","https://www.aldiwan.net/poem37550.html","الرمل"],[502,"يا آلهي بدولة الأسماء","https://www.aldiwan.net/poem37720.html","الخفيف"],[502,"ليل المحب إذا تطاول بالسهر","https://www.aldiwan.net/poem38019.html","الكامل"],[516,"روت عن تراقيها العقود عن النحر","https://www.aldiwan.net/poem20796.html","الطويل"],[516,"هذا الحمى فانزل على جرعائه","https://www.aldiwan.net/poem20799.html","الكامل"],[516,"أموا بنا نحو العقيق وأدلجوا","https://www.aldiwan.net/poem20813.html","الكامل"],[516,"أتنكر بأس أحداق العذارى","https://www.aldiwan.net/poem20826.html","الوافر"],[517,"بصعود منزلة وجد صاعد","https://www.aldiwan.net/poem12058.html","الكامل"],[517,"بصفات مجدك يشرف التمجيد","https://www.aldiwan.net/poem12060.html","الكامل"],[553,"أترى يؤوب زماننا","https://www.aldiwan.net/poem47734.html","مجزوء الكامل"],[560,"طريقتنا قل بأقوالها","https://www.aldiwan.net/poem33500.html","المتقارب"],[560,"ظهر الحق للعيان وبينا","https://www.aldiwan.net/poem33801.html","الخفيف"],[560,"شمس وحي ظهرت في قمري","https://www.aldiwan.net/poem34473.html","الرمل"],[563,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[564,"لنا ليلة قد أشبهت ليلة القدر","https://www.aldiwan.net/poem52721.html","الطويل"],[564,"أتى في أوان القطر أشهى من القطر","https://www.aldiwan.net/poem52777.html","الطويل"],[565,"هو الأجل الموقوت لا يتخلف","https://www.aldiwan.net/poem13603.html","الطويل"],[569,"نطق الود باللسان الفصيح","https://www.aldiwan.net/poem69741.html","الخفيف"],[588,"لو رمت إبقاء الوداد بحاله","https://www.aldiwan.net/poem17687.html","الكامل"],[735,"","https://poetry.dctabudhabi.ae/diwan/poem/200327",""],[744,"","https://poetry.dctabudhabi.ae/diwan/poem/67381","الطويل"],[744,"","https://poetry.dctabudhabi.ae/diwan/poem/67362","الطويل"],[765,"","https://poetry.dctabudhabi.ae/diwan/poem/31497","البسيط"],[852,"","https://poetry.dctabudhabi.ae/diwan/poem/31366","الطويل"],[860,"","https://poetry.dctabudhabi.ae/diwan/poem/17734","الطويل"],[930,"","https://poetry.dctabudhabi.ae/diwan/poem/133883","الكامل"],[1099,"","https://poetry.dctabudhabi.ae/diwan/poem/114916","المتقارب"],[1139,"","https://poetry.dctabudhabi.ae/diwan/poem/29456","الكامل"]],"verses":[["بصدر الناس في طخياء عمت","رؤوسهم زماناً والذنابا",0,"ب",2,0],["بَصيرٌ بِتَصريفِ الأَعِنَّةِ إِن سَرى","لِيَومِ نِزالٍ أَو لِبَومِ رِهانِ",1,"ن",1,0],["بِصَفحَتَيهِ جُلَبٌ قُرِّفَت","مِنَ اللَيالي وَكُلومٌ دَوام",2,"م",1,0],["بِصَوائِبٍ كَالشُهبِ تَتبَعُ مِثلَها","وَرِعالِ خَيلٍ يَتَّبِعنَ رِعالا",3,"ل",2,0],["بَصيرٌ بِرَميِ القَطرِ حَتّى كَأَنَّهُ","عَلى الرَملِ قاريُّ السِهامِ نَجيبُ",4,"ب",1,0],["بِصِيامِ يَومِ القَيظِ تَلهَبُ شَمسُهُ","وَقِيامِ طولِ اللَيلَةِ اللَيلاءِ",5,"ا",2,0],["بِصَفيحَةٍ بَيْضاءَ لَمّا شِمْتُها","دَلَفَتْ إِليْهِ مَنِيَّةٌ سَوْدَاءُ",6,"د",3,0],["بصُعْرٍ تَبارَتْ في الأزِمّةِ شُمَّذٍ","تَؤُمُّ بنا فَجّاً منَ الأرضِ مَجْهَلا",7,"ل",2,0],["بصُيّابَةٍ مَجْرٍ وكُرّامَةٍ ثُبًى","ومُرهَفَةٍ بيضٍ ومُشرَعَةٍ سُمْرِ",8,"ر",1,0],["بِصارِمٍ حَيثُما جَرَّدتُهُ سَجَدَت","لَهُ جَبابِرَةُ الأَعجامِ وَالعَرَبِ",9,"ب",1,0],["بِصارِمِ عَزمٍ لَو ضَرَبتُ بِحَدِّهِ","دُجى اللَيلِ وَلّى وَهوَ بِالنَجمِ يَعثَرُ",10,"ر",1,0],["بَصَرتَ بِها كَوماءَ حَوساءَ جَلدَةً","مِنَ المولياتِ الهامِ حَدَّ الظَهائِرِ",11,"ر",1,0],["بَصَرتَ بِأَنَّنا أَصحابُ حَقٍّ","نُدِلُّ بِهِ وَإِخوانٌ وَجيرَه",12,"ر",2,0],["بَصيرٌ بِأَدغالِ الضَراءِ إِذا خَدى","يَعيلُ وَيَخفى بِالجِهادِ وَيَمثُلُ",13,"ل",1,0],["بِصَبرٍ وَإِبقاءٍ عَلى جُلِّ قَومِكُم","عَلى كُلِّ حالٍ بِالأُنا وَالتَحَنُّنِ",14,"ن",1,0],["بَصائِرُ رُشدٍ لِلفَتى مُستَبينَةٌ","وَأَخلاقُ صِدقٍ عِلمُها بِالتَعَلُّمِ",15,"م",1,0],["بِصَوْنِهِمْ مُلْكَهُمْ صَانُوا حَقِيقَتَهُمْ","مِنْ أَنْ تُرَى السَّادَةُ الأمْجَادُ فِي الخَدَم",16,"م",1,0],["بِصُلبِ المِعى أَو بُرقَةِ الثَورِ لَم يَدَع","لَها جِدَّةً جَولُ الصَبا وَالجَنائِبِ",17,"ب",1,0],["بصاد أقسمُ ما للعينِ إن عشقتْ","سواك نونٌ ولا ظاءٌ ولا راءُ",18,"ا",2,0],["بصالحِ حمصٍ نستعينُ على الثنا","لديك ونرجوه لنظمِ المدائح",19,"ح",1,1],["بصمّ الحصى ترمي الحداة كأنما","تغارُ على محبوبها حين يُذكر",20,"ر",1,0],["بصوتك أركان الشريعة شيّدت","وصينت ثغور كلها باسم الثغر",21,"ر",1,0],["بصائبٍ من سهام الرأي أيَّدَهُ","بالبحث والفحص لا بالرِّيشِ والعَقَبِ",22,"ب",1,0],["بَصَّرْتَهُ رشْدَه في نصر سادته","بضوء رأيك حتى بان فاتضحا",23,"ح",2,0],["بصيرُ سِنان الرمح يرمي أمامه","بطرفٍ له نحوَ المقاتل شاخص",24,"ص",1,0],["بَصيرٌ بِأُخراها يَسوفُ فُروجَها","عَلَيهِنَّ ذَيّالٌ خَفيفٌ ذَلاذِلُه",25,"ل",2,0],["بِصُلبِ قَناةِ الأَمرِ ما إِن يَصورُها ال","ثِقافُ إِذا بَعضُ القَنا صيرَ بِالأَطرِ",26,"ر",1,0],["بِصَحيفَةٍ نورُ العُيونِ سَوادُها","وَبَياضُها مِن ناصِعِ الأَجيادِ",27,"د",1,0],["بَصَرتُ لَكِن مِثلَما شاءَ الكَمَد","شاعِراً مِن مُقلَتي أَرتَجِلُ",28,"ل",1,0],["بَصباصَةُ الخِمسِ في زَوراءَ مَهلَكَةٍ","يَهدي الأَدِلّاءَ فيها كَوكَبٌ وَحَدُ",29,"د",1,0],["بِصَفنَةِ راكِبٍ وَمُوَصَّلاتٍ","جَمَعتُ الرَثَّ مِنها وَالمَتينا",30,"ن",2,0],["بَصُرتُ بِأَخلاقِ الرِجالِ فَلَم أَجِد","وَإِن جَلَتِ الأَخلاقُ لِلعَزمِ ثانِيا",31,"ي",2,0],["بِصَباً يُذكِرُ الرِياضَ صَباهُ","وَحِجازٍ أَرَقُّ مِن أَسحارِهِ",32,"ر",2,0],["بَصيرٌ بِأَخذِ الحَمدِ مِن كُلِّ مَوضِعٍ","وَلَو خَبَّأَتهُ بَينَ أَنيابِها الأُسدُ",33,"د",1,0],["بِصارِمي مُرتَدٍ بِمَخبُرَتي","مُجتَزِئٌ بِالظَلامِ مُشتَمِلُ",34,"ل",1,0],["بِصُدورِ أَقلامٍ تَرُدُّ إِلَيهِمُ","أَمرَ الخِلافَةِ أَو صُدورِ رِماحِ",35,"ح",1,0],["بِصُدورِ أَقلامٍ تَرُدُّ إِلَيهِمُ","شَرَفَ الرِياسَةِ أَو صُدورِ رِماحِ",36,"ح",1,0],["بِصَريمَةٍ كَالسَيفِ هَزَّ غِرارَهُ","ماضي الجَنانِ بِهِ طَويلُ الساعِدِ",37,"د",1,0],["بِصَديقِكَ الصِدقِ الَّذي جَمَعَتكُما","قِدَمُ الفُتوَّةِ وَاِرتِضاعُ الأَكؤُسِ",38,"س",1,0],["بِصَولَتِهِ كانَ اِنقِضاضُ بِنائِهِ","لِأَسفَلٍ سُفلِ وَاِنفِضاضُ جُموعِهِ",39,"ع",2,0],["بِصَحراءَ مِكماءٍ تُرَدُّ جُناتُها","إِلَيها الجَنى في ثَوبِ مَن يَستَثيرُها",40,"ر",3,0],["بِصَفحةِ مصقولِ الأديمِ كأنَّما","سَفائِنُهُ رُبْدُ النَّعامِ المُشرَّدِ",41,"د",1,0],["بَصيرةُ ليلٍ ولكنَّها","ضريرَتُه عندَ إصباحِها",42,"ح",3,0],["بصبحٍ من محاسِنِه تجلَّى","وليلٍ من ذوائِبه يذوبُ",43,"ب",1,0],["بَصُروا بِفَروِكَ فَازدَروكَ لِحالَةٍ","أَضحى بِها مَعروفُ حُسنِكَ مُنكَرا",44,"ر",2,1],["بِصارِمٍ لا يَرُدُّ الدِرعُ ضَربَتَهُ","وَلَو سَنى نَسجَهُ المَردودَ داوودُ",45,"د",1,0],["بِصِفاحٍ تُخالُ مَوجَ المَنايا","في صَفا مَتنِها عُيونُ الجَرادِ",46,"د",1,0],["بصرت به والصحن بالصحن يلتقي","فلم أر أبهى من غنيم وأظرفا",47,"ف",2,0],["بصيرٌ بمردي الطعن يُغْري سنانه","بجارحةٍ في طيّها الوِرْدُ والغَمْرُ",48,"ر",1,0],["بِصَقيلِ اللَّفظِ مُنَقَّحِهِ","لا سَمعَ يَمرّ به بِصَدِ",49,"د",1,0],["بصادقِ عزْم في الأماني يُحِلّني","على أمَلٍ من همّةِ النفس كاذِبِ",50,"ب",1,0],["بِصاغِرَةِ القُصوى وَطِمَّينِ وَاِقتَرى","بِلادَ قَرَنطاووسَ وابِلُكَ السَكبُ",51,"ب",1,0],["بَصُرتَ بِالراحَةِ الكُبرى فَلَم تَرَها","تُنالُ إِلّا عَلى جِسرٍ مِنَ التَعَبِ",52,"ب",1,0],["بِصَهباءِ دِرياقِ المُدامِ كَأَنَّها","إِذا ما صَفا راوُوقُها ماءُ مَفصِلِ",53,"ل",1,0],["بِصَوتٍ حَزينٍ مُثكِلٍ مُتَوَجِّعِ","وَنَفسِ مَريضِ القَلبِ أَورَثنَهُ ذِكرا",54,"ر",2,0],["بَصَرا بِأَربَعَةٍ وَلَوَّحَ خامِسٌ","فَتَأَمَّلا فَبَدا الجَميعُ وَلاحوا",55,"ح",3,0],["بصاعقةٍ ممّا رَمَى اللهُ إذ رمى","ثموداً وعاداً والقرون الغوابرا",56,"ر",2,0],["بصاعقةٍ مَنْ يَذُقْها يَقُلْ","كأنَّ الصّواعقَ لم تُرْسَلِ",57,"ل",1,0],["بَصُرُوا بها فتزايلت أوصالُهُم","رُعْباً وضَاقَ سَبيلُهُم والمَذهَبُ",58,"ب",1,0],["بِصارمِ حمزة البطلِ النّجيدِ","هَوى عثمانُ إثرَ أخٍ فقيدِ",59,"د",1,0],["بَصَرتُ بِنارٍ شِمتُها حينَ أوقِدَت","تَلوحُ لَنا بَعدَ الرُتَيلَةِ فَالهَضبِ",60,"ب",1,0],["بِصَوبِ البارِقِ الأَسحَ","مِ أَدنَتهُ سَواقِيهِ",61,"ي",2,0],["بِصِغَرٍ وَلا كِبَر","أَشبَهِ طينٍ بِحَجَر",62,"ر",1,0],["بَصَّر العُمْيَ فيا لَيْتَ عَيْني","مُلِئَتْ مِنْ أخْمَصَيْه تُرابا",63,"ب",2,0],["بِصادِقِ الطاعَةِ دَيّانِها","وَواحِدِ الغائِبِ وَالشاهِدِ",64,"د",1,0],["بِصافِيَةٍ إِذا قُرِعَت بِماءٍ","جَرى عَن مَتنِها دُرٌّ يَحومُ",65,"م",1,0],["بِصَوتِ أَخي الحِجازِ فَهاجَ شَوقي","لِمَن طَلَلٌ بِرامَةَ لا يَريمُ",65,"م",1,0],["بصُمُلِّ مقددِّ","أعجر الرأسِ أقشره",66,"ر",2,0],["بِصَافٍ شَدِيدِ الرُّسْغِ أَصْمَعَ كَعْبُهُ","مُدَاخَلَةٌ أْصَلاَبُهُ وشَرَاجِبُهْ",67,"ب",2,0],["\"بصارمي مرتدٍ، بمخبرتي","مجتزىءٌ بالظلام مشتمل\"",68,"ل",1,0],["بصيحة السِّلم لا يأخذْكَ إغراءُ","فللمطامع إغراءٌ وإغواءُ",69,"ا",2,0],["بِصَوْتٍ إِذَا بَحَّتْهُ غَاشِيَةُ الأَسى","فَذِكْراكَ تَجْلوهُ عَلَى مَسْمَعِ المَلاَ",70,"ل",2,0],["بِصِدْقِ مَنْ يُوِقظُ حِبّاً لَهُ","وَقَدْ غَفَا عَن طارِيءٍ مُنْذرِ",71,"ر",1,0],["بِصِحَّةِ الشُّورى نَصِحُّ كُلُّنَا","فَإِنْ أَرَبْنَا قَتَلَتْنَا عَمْدَا",72,"د",2,0],["بصرت به رث الثياب، بلا","مأوى بلا أهل بلا بلد",73,"د",1,0],["بصرْتُ بفحلٍ على خالدٍ","فقالَ وكم حكمةٍ قالَها",74,"ل",3,1],["بَصِيرَةٌ كَضِيَاءِ الصُّبْحِ لَوْ لَطَمَتْ","غَيَاهِبَ اللَّيْلِ لم يُظْلِمْ وَلَمْ يُهَبِ",75,"ب",1,0],["بَصِيرٌ إِذا سَاسَ الأُمُور تكَشَّفَتْ","وبانَ لَهُ مِنْ كُلِّ أَمْرٍ عَوَاقِبه",76,"ب",2,0],["بصرت بالكبش والقصاب يسحبُهُ","إذا ونى خُطوةً، بالسوط يُلهبُه",77,"ب",2,1],["بِصَيِّبٍ من عطفها تحبوك","بين الجفون أهلُها صانوك",78,"ك",1,0],["بصوت الحق قد نادى","وصوت الحق كالرعد",79,"د",1,0],["بِصارِمِهِ جَمْعَ الهَشِيمَ حَظِيرُ","فأخلقْ بأن يبقى ويبقى لمُلكهِ",80,"ه",1,0],["بصبوح صافية وجذب كرينة","بموتر تأتاله إبهامها",81,"م",3,0],["بصّرت بعدك من ياتي بواجبه","نحو البلاد كما أخجلتَ مَنْ ذهبا",82,"ب",2,0],["بصري أنتِ .. وهل يمكنها","أن ترى العينانِ دونَ البصرِ؟",83,"ر",1,0],["بِصَدر مُعَذِبي سَطَّرت ضاضاً","مُؤَرخة لِأَيّام السُعود",84,"د",1,1],["بصبح وجه حبيب","خال جلاه لنا اللَه",85,"ل",2,1],["بصهرك ابن العم حيدرة الرضى","على أبي السبطين عزى وعلواني",86,"ن",2,0],["بصهر الرضى السيد المرتضى","جليل المقام علي الإمام",87,"م",1,0],["بصاحب الطريقة المسلسله","علي الكرار شيخ السلسله",88,"ه",1,0],["بصير فبصرني بنفسي وعيبها","ويا حكم احكم لي بغيبك في الستر",89,"ر",1,0],[