{"poems":[[50,"غرد الديك الصدوح","https://www.aldiwan.net/poem62532.html","مجزوء الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54690","الخفيف"],[230,"إنني أستغفر الله لكم","https://www.aldiwan.net/poem55137.html","الرمل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138350",""],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203784","الخفيف"],[1818,"","https://poetry.dctabudhabi.ae/diwan/poem/87834","الخفيف"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205423","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200868","الخفيف"],[3697,"","https://poetry.dctabudhabi.ae/diwan/poem/140258",""],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91015","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83519","الخفيف"],[4823,"سر فني","https://www.poetsgate.com/ViewPoem.aspx?id=190878",""],[182,"","https://www.poetsgate.com/ViewPoem.aspx?id=72802",""],[5135,"يا شِعْر","https://www.poetsgate.com/ViewPoem.aspx?id=202019",""],[5459,"كيف نعلو ..","https://www.poetsgate.com/ViewPoem.aspx?id=197648",""]],"verses":[["بُحَّ صَوتُ المالِ مِمّا","مِنكَ يَشكو وَيَصيحُ",0,"ح",1,0],["بُحَّ صَوْتٌ لأُمَّةٍ","أَسِفَ الْفَضْلُ أَنْ يُبَحُّ",1,"ح",1,0],["بحَّ صَوتي داعِياً مُستَنهِضاً","صارِخاً حتى تولّاني الكلال",2,"ل",1,0],["بحصيف رأيك قد أدرت شؤونها","ورعيتها متيقظا لا تغفل",3,"ل",1,0],["بُحَّ صوتي وأنت بالبلسم الشا","في وبالمكرمات أولى وأدرى",4,"ر",2,0],["بحَّ صَوتُ القِثارِ في كَفِّ حاديه","لَيتِ لي أَن أَرى سَنا كَرنفالِه",5,"ل",2,0],["بحَّ صوتي في ضجّة الناس لا أس","مع فيهم تناوحي وأنيني",6,"ن",2,0],["بحّ صوتي من الغنا في ضجيجٍ","افتجْدي في الصُمّ ألحان خُرس",7,"س",1,1],["بحصى البطحا فولوا أجمعاً","يركب الظهر جنود المسلمين",8,"ن",1,0],["بحصن حصين جارهم حيث ظلهم","حمى عنه حول اللَه لم يتحول",9,"ل",1,0],["بُحَّ صَوتي مردِّداً كلَّ آهٍ","من لصوتي برجعِه آهاته",10,"ت",2,0],["بُحّ صوتي فَعُدتُ في حَسَراتٍ","من لصبّ يطوي عَلى حَسَراتِه",10,"ت",2,0],["بح صوتي وما أزال أغني","فكأني به......سواي المغني",11,"ن",2,1],["بُحَّ صَوتُ البَغداد ذَاتَ دَمارٍ","فَتَغاضَيْنا وارْتَضَيْنا الزَّوِيّا",12,"ي",2,0],["بحصادِ مِقْوَلِهِ يُكَبُّ لوجهِهِ","في النارِ يصلاها مَلُوماً مُوثَقا",13,"ق",2,0],["بُحَّ صوتُ المستصرخينَ نيامًا..","هل يلبي النداءَ قومٌ نيامُ ..؟!",14,"م",1,0]]}