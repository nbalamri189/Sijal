/www.aldiwan.net/poem59714.html","البسيط"],[510,"حي المنازل أقفرت بسهام","https://www.aldiwan.net/poem750.html",""],[515,"لا بر في الحب يا أهل الهوى قسمي","https://www.aldiwan.net/poem20785.html","البسيط"],[516,"ليست صفات علاك مما يمترى","https://www.aldiwan.net/poem12109.html","الكامل"],[530,"الحمد لله على كل حال","https://www.aldiwan.net/poem37239.html","السريع"],[559,"إن النصارى واليهود كلاهما","https://www.aldiwan.net/poem34613.html","الكامل"],[559,"إن الزجاجة عبرة للرائي","https://www.aldiwan.net/poem35082.html","الكامل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["إِنّا لَنَرجوكَ وَالأَيّامُ راغِمَةٌ","وَالرَوضُ يَرجو نَوالَ العارِضِ الخَضِلِ",0,"ل",1,0],["إِنّا لَنَعجَبُ كَيفَ حُمَّ حِمامُهُ","عَن صِحَّةٍ وَيَغيبُ عَنّا داؤُهُ",1,"ا",3,0],["إِنَّ النِساءَ حَسَدنَ وَجهَكِ حُسنَهُ","حُسنُ الوجوهِ لِحُسنِ وَجهِكِ ساجِدُ",2,"د",1,0],["إِنّا لَنَشكو واثِقي","نَ بِعَدلِ مَن يُشكي الشِكايَه",3,"ا",3,0],["إِنّا لَنَلهو إِذ نَجِدُّ وَإِنَّهُ","لَيَجِدُّ إِذ يَلهو بِنَظمِ جُمانِهِ",4,"ن",2,0],["إِنَّ النَعِيَّ لَجَهوَرٍ وَمُحَمَّدٍ","أَبكى الغَمامَ فَدَمعُهُ مُنثالُ",5,"ل",1,0],["إِنَّا لَنَفْخَرَ وَالأَعْمَالُ شَاهِدَةٌ","بِحِبْرِ أَحْبَارِنَا الْعَلاَّمَةِ الأَرِبِ",6,"ب",1,0],["إن الندى هو ما رقي","ت بفضله هذا المقام",7,"م",1,0],["إِنَّا لَنَسْتَقْبِلُ الْحُسْنَى وَقَدْ بَرَزَتْ","لَنَا مُصَوَّرَةً فِي وَجْهِكَ الْحَسَنِ",8,"ن",1,0],["إِنَّا لَنَهْوَاهَا وَنَرْعَى عَهْدَهَا","أَفَنَحْنُ فِي هَذَا الْهَوَى سِيَّانِ",9,"ن",1,0],["إِنَّ النَشيدَ بِحُبِّ آلِ مُحَمَّدٍ","أَزكى وَأَنفَعُ لي مِنَ القُنياتِ",10,"ت",1,0],["إنا لنعرف لُغزاً في سياستكم","وما السياسة إلاّ بيت ألغاز",11,"ز",1,0],["إنا لنعجب من شعر تؤجّجه","ناراً ولم يحترق في كفّك القلم",12,"م",1,0],["إِنّا لَنَعرِفُ ما أَبوكَ بِحاجِبٍ","فَاِلحَق بِأَصلِكَ مِن بَني دُهمانِ",13,"ن",1,0],["إِنّا لَنَستَلِبُ الجَبابِرَ تاجَهُم","قابوسُ يَعلَمُ ذاكَ وَالجونانِ",13,"ن",1,0],["إِنّا لَنَذعَرُ يا قُفَيرَ عَدُوَّنا","بِالخَيلِ لاحِقَةَ الأَياطِلِ قودا",14,"د",2,0],["إِنّا لَنَذكُرُ ما يُقالُ ضُحى غَدٍ","عِندَ الحِفاظِ وَنَقتُلُ الصِنديدا",14,"د",2,0],["إِنّا لَنَأمُلُ مِنكَ سَيباً عاجِلاً","يا اِبنَ الخَليفَةِ ثُمَّ نَرجوكُم غَدا",15,"د",2,0],["إِنّا لَنَعلَمُ ما غَدا لِمُجاشِعٍ","وَفدٌ وَما مَلَكوا وَثاقَ أَسيرِ",16,"ر",1,0],["إِنَّ النَدى مِن بَني ذُبيانَ قَد عَلِموا","وَالمَجدَ في آلِ مَنظورِ بنِ سَيّارِ",17,"ر",1,1],["إِنّا لَنَرجو إِذا ما الغَيثُ أَخلَفَنا","مِنَ الخَليفَةِ ما نَرجو مِنَ المَطَرِ",18,"ر",1,0],["إِنّا لَنَبلو سُيوفاً غَيرَ مُحدَثَةٍ","في كُلِّ مُعتَقِدِ التاجَينِ جَبّارِ",19,"ر",1,0],["إِنّا لَنَربَعُ بِالخَميسِ تَرى لَهُ","رَهَجاً وَنَضرِبُ قَونَسَ الجَبّارِ",20,"ر",1,0],["إِنّا لَنَعرِفُ مِن نِجارِ مُجاشِعٍ","هَدَّ الحَفيفِ كَما يَحِفُّ الخِروَعُ",21,"ع",1,0],["إِنّا لَنَلقى الخَطبَ فيكَ وَغَيرَهُ","بِمُوَفَّقٍ عِندَ الخُطوبِ مُعانِ",22,"ن",1,0],["إِنَّ النَضيرَةَ رَبَّةَ الخِدرِ","أَسرَت إِلَيكَ وَلَم تَكُن تُسري",23,"ر",2,1],["إِنّا لَنَمنَعُ مَن أَرَدنا مَنعَهُ","وَنَجودُ بِالمَعروفِ لِلمُعتامِ",24,"م",1,0],["إنا لَنستحيي وقد وافيتنا","من بعد يأسٍ أنْ نَكُدَّك بالطّلَبْ",25,"ب",1,0],["إِنّا لَنَقتادُ الجِيادَ عَلى الوَجى","نَحوَ العُدى بِمَساعِرٍ أَبطالِ",26,"ل",1,0],["إِنَّ النُفوسَ تَغُرُّها آمالُها","وَتَظَلُّ عاكِفَةً عَلى آمالِها",27,"ل",3,0],["إِنَّ النِساءَ إِذا أَمرَضنَ نَفسَ فَتىً","فَلَيسَ غَيرُ تَدانيهِنَّ يَشفَيها",28,"ي",3,0],["أَنَّ النُجومَ الَّتي غابَت قَد اِقتَرَبَت","مَنّا مَطالِعُها تَسري إِلى القَمَرِ",29,"ر",1,0],["ان النجاح امامكم","فامشوا ولا تخشوا عثارا",30,"ر",2,0],["إنا لنفزع من مصا","ئب لاجئين إلى مصائب",31,"ب",1,0],["إن النفوس كما علمت حرائر","كذب الأولى قالوا النفوس إماء",32,"ا",2,0],["إِنَّ النَواصِحَ كُلَّهُم","قالوا بِتَبديلِ الهَوا",33,"و",2,0],["إِنَّ النَوابِغَ أَهلَ بَد","رٍ ما لَهُم مِن سَيِّئاتِ",34,"ت",1,0],["إِنَّ النُفوسَ عَدَدُ الآجالِ","سَقياً لِدَشتِ الأَرزُنِ الطُوالِ",35,"ل",1,0],["إِنَّ النواظرَ والقلوبَ صغيرةٌ","تحوي الكبيرَ وليس بالمستبدَع",36,"ع",1,0],["إِنَّ النُجومَ نُجومَ اللَيلِ أَصغَرُها","في العَينِ أَذهَبُها في الجَوِّ إِصعادا",37,"د",2,0],["إِنَّ النَوالَ وَإِن أَكثَرتَ مَبلَغَهُ","يَقِلُّ في جَنبِ إِغرابي وَتَسييري",38,"ر",2,0],["إِنَّ النَعِيَّ بِمَروِ الشاهِجانِ غَداً","لَباعِثٌ رَهَجاً في الشَرقِ مُرتَفَعا",39,"ع",2,0],["إِنَّ النَوائِحَ لا يَعدونَ في عُمَرٍ","ما كانَ فيهِ وَلا المَولى إِذا اِفتَخَرا",40,"ر",2,1],["إِنّا لَنَرجو أَن تُعيدَ لَنا","سُنَنَ الخَلائِفِ مِن بَني فِهرِ",41,"ر",1,0],["إِنَّ النَدى وَيَدَ العَبّاسِ فَاِرتَحِلوا","مِثلُ الفُراتِ إِذا ما مَوجُهُ زَخَرا",42,"ر",2,0],["إِنَّ النَدى صاحِبَ العَبّاسِ حالَفَهُ","وَالجودَ هُم إِخوَةٌ قَد أَغرَقوا البَشَرا",43,"ر",2,0],["إِنّا لَنُنصِفُ مِنّا بَعدَ مَقدُرَةٍ","عَلى هَضيمَتِهِ مَن لَيسَ يَنتَصِفُ",44,"ف",1,1],["إِنّا لَنَضرِبُ رَأسَ كُلَّ قَبيلَةٍ","وَأَبوكَ خَلفَ أَتانِهِ يَتَقَمَّلُ",45,"ل",1,0],["إِنّا لِنَنزِلُ ثَغرَ كُلِّ مَخوفَةٍ","بِالمُقرَباتِ كَأَنَّهُنَّ سَعالي",46,"ل",2,0],["إنَّ النُّجومَ التي تُضئُ لنا","أصغرُها في العُيونِ أَعلاها",47,"ا",3,0],["إنَّ النُّضارَ إذا تَتابعَ سَبْكُهُ","خَلَصَ النُّضَارُ وزادَ نَضْرَةَ مَنْظَرِ",48,"ر",1,0],["إِنّا لَنَرجو أُموراً نَستَعِدُّ لَها","وَالمَوتُ دونَ الَّذي نَرجوهُ مُعتَرِضُ",49,"ض",1,0],["إِنّا لَنَلقى المَرءَ تَشرَهُ نَفسُهُ","فَيَضيقُ عَنهُ كُلُّ أَمرٍ مُتَّسِع",50,"ع",1,0],["إِنّا لَنَعلَمُ أَنّا لاحِقونَ بِمَن","وَلّى وَلَكِنَّ في آمالِنا طولا",51,"ل",2,0],["إِنّا لَنَزدادُ اغتِراراً بِها","وَاللَهُ قَد عَرَّفَنا حالَها",52,"ل",3,0],["إِنّا لَنَعمُرُ مِنكِ نا","حِيَةً وَنُخرِبُ ناحِيَه",53,"ي",2,0],["إنّ النوى غرَّبته وهي عالمة","أني رجعت أُداري النار بالضرم",54,"م",1,0],["إنَّ النّواعمَ في العتابِ لها","غَرَضٌ إليه جميعُها تَرْمي",55,"م",2,0],["إِنّا لَنخجل في الإِنشادِ بينَ يَدي","رَبِّ القوافي الَّتي حُلّينَ بالفقرِ",56,"ر",1,0],["إِنَّ النَفورَ لَهُ عِندي مَقَرُّ هَوىً","يَحُلُّ مِنّي مَحَلَّ السَمعِ وَالبَصَرِ",57,"ر",1,0],["إنَّا لنُجري دموعاً في محبتِهِ","فكمْ جُمانٍ معَ الحصباءِ منتثرِ",58,"ر",1,0],["إنّا لَنَخْنُقُ في الأَضْلاعِ غُرْبَتَنا","وإنْ تَنَزَّتْ على أَحْداقِنا حُرَقا",59,"ق",2,0],["إِنَّ النَهارَ وَذاكَ حَقٌّ واضِحٌ","وَاللَيلُ يَخفى بِالظَلامِ رِكابُهُ",60,"ب",2,0],["إِنَّ النَجاةَ بَعيدَةٌ","فَاِسلُك بِنا قَصدَ الطَريقِ",61,"ق",1,0],["إنّا لننصرُ ربَّنا ونُعِزُّه","ولَنَحنُ أَوْلَى من يُعِزُّ ويَنْصُرُ",62,"ر",1,0],["إنّا لَنعلمُ أَنَّ آكِلَ لحمِهم","سيخوضُ منّا في الدِّماءِ ليَشْربا",63,"ب",2,0],["إنّا لَنمنعُ أن تكونَ بلادُنا","سَلَباً لِكلِّ مُشَاغِبٍ يَتَهجَّمُ",64,"م",1,0],["إنّا لَنَأْنَفُ أن يُغيِّرَ دِينَنا","رجلٌ قليلُ المالِ شبَّ يتيما",65,"م",2,0],["إنّا لَنلمحُ في جَبيِنكَ آيةً","ممّا يَخطُّ الوحيُ والإلهامُ",66,"م",1,0],["إنّا لَنَذْكُرها جَوازِعَ جُفَّلاً","فَتَبِيتُ تَجْفُلُ حَوْلَها الأكبادُ",67,"د",1,0],["إنّا لَنَعلمُ حِينَ يُهضَمُ حقُّنا","أنّ الحياةَ على النُّفوسِ حَرامُ",68,"م",1,0],["إنّا لَنطمعُ أن تثوبَ حُلومُهم","بعد المغيبِ وتَسكُنَ النَّعَراتُ",69,"ت",1,0],["إنّا لَنَحِمي تُراثَ الأوّلين فما","تشكو العظامُ ولا تَستصرخُ الحُفَرُ",70,"ر",1,0],["إنّا لنَحفظُ قومَنا ونَعدُّهم","خَيْرَ العتادِ وأنفعَ الأَبدالِ",71,"ل",1,0],["إِنّا لَنَذكُرُ لِلكِنانَةِ حَقَّها","وَنَرى الكَثيرَ مِنَ الوَفاءِ قَليلا",72,"ل",2,0],["إِنَّ النُفوسَ عَلى جَلالِ سُكونِها","لَتَجيشُ لِلحَدثِ الجَليلِ وَتَفزَعُ",73,"ع",1,0],["إِنّا لَنَضرِبُ في غَياهِبَ غَمرَةٍ","تَتَكَشَّفُ الغَمَراتُ وَهيَ كَما هِيا",74,"ي",2,0],["إِنّا لَنمنعُ أَن يُضامَ حَريمُنا","وَنُزلزلُ الأَرضين حينَ يُضامُ",75,"م",1,0],["إنّا لنَعرفُهُ رشيداً حازماً","ونراه شَهماً في الرجالِ هُماما",76,"م",2,0],["إنّ النبيَّ لَيُمضِي الأمرَ في وَضَحٍ","من حكمةِ اللّهِ يجلو نورهُ الرِيَبا",77,"ب",2,0],["إِنّا لَنَعلَمُ أَنّا ما بَقِيتَ لَنا","فِينا السَماحُ وَفِينا العِزُّ وَالكَرَمُ",78,"م",1,0],["إِنّا لِنَنتابُ العُداةَ وَإِن نَأَوا","وَنَهُزُّ أَحشاءَ البِلادِ جُموعا",79,"ع",2,0],["إنَّ النبيَّ محمداً مِنْ رَبِّه","كَرَماً بكلِّ فضيلةٍ مَمْنُوحُ",80,"ح",1,0],["إنَّ النَّصارَى بالمَحَلَّةِ وُدُّهُمْ","لو كانَ جَامِعُها يكونُ كَنِيسا",81,"س",2,0],["إنَّ النَّصَارَى واليَهودَ مَعاشِرٌ","جُبِلوا على التَّحْرِيفِ والتبْدِيلِ",82,"ل",1,1],["إنّا لَنُؤتَى من تَجارِبِهَا","عِلماً بما نأتي وما نَذَر",83,"ر",1,0],["إِنّا لَنَنفَسُ في دُنيا مُوَلِّيَةٍ","وَنَحنُ قَد نَكتَفي مِنها بِأَدناها",84,"ا",3,0],["إِنَّ النِساءَ مُضيئاتٌ ظَواهِرُها","لَكِن بَواطِنُها ظُلمٌ وَإِظلامُ",85,"م",1,1],["إِنَّ النُسُكُ وَأَصحابِهِ","إِذا فاتِكُ القَومِ لَم يَرتَحِ",86,"ح",1,1],["إِنَّ النَجاشِيَّ نالَ المُلكَ عَن قَدَرٍ","بِرَغمِ ناسٍ لِبَعضِ التَجرِ باعوهُ",87,"ع",3,0],["إِنّا لَنَعلَمُ أَن سَيُدرِكُنا","غَيثٌ يُصيبُ سَوامَنا مَطَرُه",88,"ر",2,0],["إِنّا لَنَكسوهُم وَإِن كَرِهوا","ضَرباً يَطيرُ خِلالَهُ شَرَرُه",88,"ر",2,0],["إن النساء رَبيعُ","لنا ونعم الرَبيعُ",89,"ع",1,1],["انا لنحميك بالدمْ","من ذلةٍ وَهَوان",90,"ن",1,0],["إن النفوس إذا اقتنت لعقيدة","مثل الجسوم يُرى لها استمرار",91,"ر",1,0],["إن النساء من القو","م للحفاوة أَهل",92,"ل",1,0],["إن النهار مطية","وَالليل من بعد النهار",93,"ر",1,0],["إن النَهار نَصير أَعدائي فَكُن","يا لَيل أَنتَ على النهار نَصيري",94,"ر",2,0],["إِنَّ النَدى وَالرِضى فيهِ وَأُسرَتِهِ","وَاللَهُ لِلخَيرِ هاديهِ وَهاديها",95,"ي",3,0],["إِنَّ النَّصِيحَةَ لا تَحُضْ","ضُ عَلَى الأَذَى إِنْ لَمْ تَزَعْ",96,"ع",1,1],["إِنَّ النَّمِيمَةَ وَالأَفْوَاهُ تُضْرِمُهَا","نَارٌ مُحَرِّقَةٌ لَيْسَتْ لَهَا شُعَلُ",97,"ل",1,0],["إِنَّا لَنَسْمَعُ مِنْ سُكُوتِكَ حِكْمَةً","وَنَرَى هُدىً فِي وَجْهِكَ المُتَوارِي",98,"ر",2,0],["إِنَّا لَنَبْكِي كُلَّ ثَاوٍ هَامِدٍ","مِنْكُمْ بِأَكْبَادٍ عَلَيْهِ حِرَارِ",98,"ر",1,0],["إِنَّا لَنَعْرِفُ قَدْرَهَا وَهْيَ الَّتِي","جَعَلَتْ لَنَا قَدْراً مِنَ الأَقْدَارِ",98,"ر",1,0],["إِنَّ النَّسِيمَ قُبَيْلَ سَكْنَتهِ","لَيَعِجُّ بَيْنَ الْبَانِ وَالرَّنْدِ",99,"د",1,0],["إِنَّا لَنَدْعُوكُمْ وَنَطْ","مَعُ في الْجَمِيل مِنَ الجَوَابِ",100,"ب",1,0],["إِنَّا لَنُعْظِمُ فِي شَمَائِلِهِ الَّتِي","كمُلَتْ صَفَاءَ النَّفْسِ وَالإِيثَارَا",101,"ر",2,0],["أَنَّا لَنَشْرَبَ كَأْسَنَا فِي وُدِّكُمْ","وَمَزَاجُهَا مِنْهُ أَرَقُّ مَزَاجِ",102,"ج",1,0],["إنّ النُّفوسَ تَضِيقُ وَهْيَ صَغِيرةٌ","ويَضِيق عنها الكَوْنُ وَهْي كِبَار",103,"ر",1,0],["ان النبيذ هنا نار معطرة","فهل عيون نساء الشام أقداح",104,"ح",1,0],["إنا لنرخص في سبيل الودِّ، يا","بغداد، ما يغلو من الأعمار",105,"ر",1,0],["إنَّ النمورَ تَتيهُ باسم سميِّها","طَهَ على الآسادِ في الآجام",106,"م",1,0],["إن النسيم رسول الزهر حمَّله","سرَّ العبير، وللأسرار كتمان",107,"ن",1,0],["إنا لنرجو أن يكون صُمُودُكمْ","لِنْكُوصنَا يوم الحسابُ مكفِّرا",108,"ر",2,0],["إنا لنُحْرِمُ في حماه، وإنهُ","بدمائِنا ومَتَاعِنَا يتكفَّل",109,"ل",1,0],["إنا لنُشْهد أهلَ بَدْرٍ أننا","في النصر أو نيل الشهادة نَأمُل",109,"ل",1,0],["إن النقود مفتاح كل مقاتل","ما كان اصدق حكمة الاسلاف!",110,"ف",1,0],["إنا لنخنق في الأعناق غربتنا","حتى تمور على أحداقنا حرقا",111,"ق",2,0],["إنا لنأبى على الطاغي تهضمنا","حتى نهوِّز في الهيجاء تهويزا",112,"ز",2,0],["ان النجيب اذا تبا","عد للامانة ينصرف",113,"ف",1,0],["إن الندى لحياة الزهر يضر به","والحب للحسن طلّق ليس بالوشل",114,"ل",1,0],["إنا لنرجو فَوْزَنا بدعائهم","فالله يرحُمنا بِهم ويقينَا",115,"ن",2,0],["إنا لنلهو والمنايا شُرَّعٌ","لا بدَّ تأتينا على الغَفَلانِ",116,"ن",1,0],["إِنّا لَنَدعو بِالبَقاءِ لِتَسلَمَ","أَبَداً وَلا نَدعو بِقُربِ لِقاءِ",117,"ا",2,0],["إِنَّ النَباهَةَ أَدنى ما سَعَيتَ لَهُ","فِإِن خُصِصتَ بِأَقصاها فَلا عَجَبُ",118,"ب",1,0],["إن النوى لم تنتقص","مما عهدت ولا قلامه",119,"م",2,0],["إنَّا لنذكر أوصافاً مكرّمه","ونحن لا حَبَضٌ فينا ولا نبض",120,"ض",1,0],["إن النضالَ كان عند المصطفى","والطعنُ محتاج إلى التذكرِ",121,"ر",1,0],["إن النبيط لها اشتقاق","يجيد في اللفظ البيانا",122,"ن",2,0],["إنا لنمضي لدُن يمضي الشباب ولا","يعيش من بعدهِ الاَّ اسامينا",123,"ن",2,0],["إنَّ النفوسَ لما منعنَ شديدة","ظمأً وينسى الماءُ عندَ فُراتهِ",124,"ت",2,0],["إن النساء خلائقٌ إن فتْنها","فهي الأسارى والحليُّ قيودا",125,"د",2,0],["إن النوابغ في مصر لهم زمن","قاس هو الهول أثقال وأهوال",126,"ل",1,0],["إن النجوم تغار","من لطف هذا السرار",127,"ر",1,0],["أَنَالَنَا مِنْهُ وَالأَنْذَالُ لاَهِيَةٌ","مَا لَمْ يَنَلْ سُوقَةٌ قَطُّ وَلاَ مَلِكُ",128,"ك",1,0],["إنا لنختار المام المنون بنا","ولا على ذلة للعيش نختار",129,"ر",1,1],["إنِ النَّاسُ غَطّوني تَغَطَّيتُ عَنهُمُ","وَإن بَحَثوا عَنِّي فَفِيهم مَبَاحِثُ",130,"ث",1,1],["إنّ النساءَ تنوَّعَت أشكالُها","وثيابُها لِتَنوُّعِ الأذواق",131,"ق",1,0],["إنّ النَّبيِّينَ في التَّوراةِ أكثرُنا","عِشقاً فداوودُ قد أغرى سُليمانا",132,"ن",2,0],["إنَّ النوابغ أبناءُ التجاربِ في","كلِّ العصورِ التي انشَقَّت لضَربهم",133,"م",1,0],["إنّا لنذكرُ نُعماها وتذكُرنا","فلم يضع بيننا عهدُ المحبّينا",134,"ن",2,0],["إن النفوسَ تقودُها ملكاتُها","والنفسُ عاشقةٌ لما تعتاد",135,"د",1,0],["ان النفوس عَلى اختلاف طباعها","طمعت من الدنيا بما لم تظفر",136,"ر",1,0],["إِنَّ النَّعِيمَ لِباسٌ خَوَّلَتْهُ بِكُمْ","فَدامَ مِنْكُمْ عَلَى أَيَّامِها وَضَفا",137,"ف",2,0],["إِنَّ النَسيمَ عَليلُهُ يُهدي إِلى","الصَبِّ العَليلِ شِفاءهُ بِطَبيبِهِ",138,"ب",2,0],["إنا لنعلمه ولم نحظ به","ذوقاً لما معنا من التشتيت",139,"ت",1,0],["إِنّ النقابةَ حلّت شمسُها حملاً","مِنهُ نعم وَضحاها إنّه قسمُ",140,"م",1,0],["إِنّا لَنَأمُلُ فَتحَ الرومِ وَالصينِ","بِمَن أَذَلَّ لَنا مِن مُلكِ شَروينِ",141,"ن",1,1],["أنا لن أبالي حادثات","الدهر يمطرها عليّا",142,"ي",2,0],["إِنَّ النُصولَ إِذا بَدا","فَكَأَنَّهُ شَيبٌ جَديدُ",143,"د",1,0],["إنّا لِنَأبى أَن يَكون أَبا الثَنا","إِلّا أَبو النَصر اِبن أَكرَم مَن سَما",144,"م",2,0],["إِنَّ النِساءَ كَأَشجارٍ نَبَتنَ مَعاً","مِنها المِرارُ وَبَعضُ المُرِّ مَأكولُ",145,"ل",1,0],["إِنَّ النِساءَ مَتى يَنهَينَ عَن خُلُقٍ","فَإِنَّهُ واجِبٌ لا بُدَّ مَفعولُ",145,"ل",1,0],["إنّا لنسأَلُ منك مَنْ في طَبْعهِ","أن يَبْتدي كَرماً وإن هو لم يُسَل",146,"ل",1,0],["إنّ النّسيمَ الّذي تَحيا النُّفوسُ به","أَصحُّ ما كان أنفاساً إذا مَرِضا",147,"ض",2,0],["إنّا لنرخص يوم الروع أنفسنا","ولو نسام بها في الأمن أُغْلينا",148,"ن",2,0],["إنَّ النَّوائبَ في جوا","رِك قد جَرَت وعَلى مَنِ",149,"ن",1,1],["أَنّا لَنسمع مِن تِلقاءِ مَضجَعِهِ","أَنين صَبٍّ وَلَكن لا نَرى أَحَدا",150,"د",2,0],["أنا لنْ أُجيبكَ، كمْ سؤالٍ دونهُ","وخْزٌ منَ الألم المُبرِّح قاتِلُ",151,"ل",1,0],["إنا لنا كل شيء من مواهبه","ما لا تحيط به عين ولا أذن",152,"ن",1,0],["إن النوى يا أباه شر مدخر","وأنت صيرته في البطن ينكتم",153,"م",1,0],["إن النوى وغراب البين في قرن","فشوم هذا وهذا فيهما شيم",153,"م",1,0],["إن النجاة من المهالك كلها","لم تأت إلا في سلوك سبيله",154,"ل",2,0],["إنَّ النَّهارَ وإنْ أضاءَ فإنَّها","يَهدي الضّياءَ إلى ذوي الأبصارِ",155,"ر",1,0],["إِنَّ النَفيس وَلَو أَبيحَ أَبى لَهُ","عِزُّ النَفاسَة أَن يَكون مُباحا",156,"ح",2,0],["أنَّ النَّدى قد مات فاستعصِموا","باليأسِ من دانٍ ومِن شاسِعِ",157,"ع",1,0],["إنّا لَنُنْكِرُ سوءَ عاقبةِ الورَى","فيها ونَهْوَاها على إِنكارها",158,"ر",3,0],["إنّا لَنحفظُ فيكم مَعْ بِعادِكُم","شَرِيعةً سنّها في دينِنا الكرَمُ",159,"م",1,0],["إنّ النقابة قَرَّتْ فيك أعْيُنها","وفاخَرتْ بك كبّاراً وأعيانا",160,"ن",2,0],["إنَّ النَّقيب عَليًّا طابَ عنصُرُه","وشَرَّفَ الله في السادات محتدَه",161,"د",2,1],["إنَّ النقيب القادريّ لعوذتي","من حادث الدُّنيا ومن عدوانها",162,"ن",3,0],["إنَّا لنسمع بالكرام فأين هم","هيهات ما هم غير لمع الآلِ",163,"ل",1,0],["أَنالَني في اغترابِي كُلَّ مُغْرِبَةٍ","فما النفيرُ بمعدومٍ ولا النَّفَر",164,"ر",1,0],["إِنّا لَنَضرِبُ بِالصَوارِمِ هامَها","ضَربَ القُدارِ نَقيعَةَ القُدّامِ",165,"م",1,0],["أنالني منكم سعادات بها","مازال يوعدنى رجائى منكم",166,"م",1,0],["أنا لن أسجل ههنا تاريخه","فسجله بالمكرمات مرصع",167,"ع",1,0],["إن النميرَ لِواردي فتعلّما","يا صاحبيَّ من الذي ترِدانِ",168,"ن",1,0],["إن النفوس فاعلمي إن حُمِلتْ","مسجونةٌ في هذه الأجسادِ",169,"د",1,0],["أنا لنسأل هل كانت مصادفة","أن أشرعت بين بيتي أهلنا الأسل؟",170,"ل",1,0],["إِنّا لَنَبن عَلى ما أَسَّسَتهُ لَنا","آباؤُنا الغُرُّ مِن مَجدٍ وَمِن كَرَمِ",171,"م",1,1],["إِنَّ النَبيذَ نَبيلٌ في خَصائِلِهِ","حَقّاً فَلا تَجعَلَن لامَ اِسمِهِ ذالا",172,"ل",2,1],["أنّا لَنَمنَعُ بِالطِعانِ دِيارَنا","وَالضَربُ تَحسَبُهُ شِهابَ ضِرامِ",173,"م",1,0],["إنّ النفوسَ الّتي تَقضي هَوىً وجوىً","فيهِمْ لأوْضَحُ عُذراً منْ وُجوهِهمِ",174,"م",1,0],["إن النزاهة والنباهة أقسما","لا صاحباً أحداً سواك من الورى",175,"ر",2,0],["أَنالَني ما لَسْتُ أَهْلاً لَهُ","فَضْلاً وطَوْلاً من عَظيمِ الجَلالْ",176,"ل",1,0],["إن النصارى واليهود كلاهما","لا عقل فيهم والعقول شواهدُ",177,"د",1,1],["إن النفوس هي الزجاجات التي","طبعت على سعد لها وشقاء",178,"ا",2,0],["إن النبي عند رأي العين","كان ثقيلا ليلة الإثنين",179,"ن",1,0],["إن النبي قال لست أورث","وما تركت فيكم لا يلبث",179,"ث",1,0]]}