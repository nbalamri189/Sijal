","الطويل"],[76,"سبحان من لم تحوه أقطار","https://www.aldiwan.net/poem38845.html","الرجز"],[68,"صد حمى ظمئي لماك لماذا","https://www.aldiwan.net/poem1495.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85845","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85598","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85547","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39540","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39595","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39596","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39579","الخفيف"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20250","الرمل"],[36,"","https://poetry.dctabudhabi.ae/diwan/poem/72185","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42505","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42506","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54775","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54719","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54639","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55232","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54993","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54537","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54886","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67306","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142035","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141998","الخفيف"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/13598","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43899","المنسرح"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43697","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54209","المتقارب"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54267","المجتث"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54231","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54199","الخفيف"],[106,"قالوا أحيل","https://www.poetsgate.com/ViewPoem.aspx?id=179396",""],[106,"سفينة الموت","https://www.poetsgate.com/ViewPoem.aspx?id=179666",""],[23,"جزى اللهُ ربُّ الناسِ، خيرَ جزائهِ","https://www.poetsgate.com/ViewPoem.aspx?id=11420",""],[90,"ثورة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=179144",""],[0,"غشيتُ ديارَ الحي بالبكراتِ","https://www.poetsgate.com/ViewPoem.aspx?id=4735",""],[45,"أقُولُ لعَنْسٍ، كالعَلاة، أمُونِ","https://www.poetsgate.com/ViewPoem.aspx?id=32017",""],[45,"نَفْسِي فِدَاؤُك أَيُّهَا الغَضْبَانُ","https://www.poetsgate.com/ViewPoem.aspx?id=31820",""],[45,"أقصرا قد أطلتما تفنيدي،","https://www.poetsgate.com/ViewPoem.aspx?id=31347",""],[91,"أيا نيل","https://www.poetsgate.com/ViewPoem.aspx?id=53039",""],[51,"لا تُكذبنَّ فما وجدي بمفقودِ","https://www.poetsgate.com/ViewPoem.aspx?id=28482",""],[51,"وَلع الزمانُ بأن يحرِّكَ ساكِناً","https://www.poetsgate.com/ViewPoem.aspx?id=30806",""],[43,"بم التعلل لا اهل ولا وطن","http://www.aldiwanalarabi.com/poemDescription.do?poemId=481880",""],[88,"بدت كالشمس يحضنها الغروب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19504&r=&rc=7",""]],"verses":[["فَغَيرِيَ إِمّا طارَ غادَرَ صَحبَهُ","دُوَينَ المَعالي واقِعينَ وَحَلَّقا",0,"ق",2,0],["فَغالَبَ أَطماعي عَليكَ مُّغالِبٌ","وَقارَعَ آمالي عَليكَ قَروعُ",1,"ع",1,0],["فَغَرَ العَدُوُّ يُريدُ ذَمَّ فَضائِلي","هَيهاتَ أُلجِمَ فوكَ بِالجُلمودِ",2,"د",1,0],["فَغَيثٌ يُعانِقُني في السَحابِ","وَبَدرٌ يُنادِمُني في السَما",3,"ا",1,0],["فغَضَّ طِماحَ الحرْبِ وهْيَ أبيّةٌ","بكُلِّ عُقَيْليٍّ كَريمِ العَناصِرِ",4,"ر",1,0],["فغُضّي مَلاماً يا بْنَةَ القَومِ إنني","مُقيمٌ بحيثُ الوَجْهِ للقِرْنِ بارِزُ",5,"ز",1,0],["فَغدا بِها الإسلامُ يَسْحَبُ ذَيْلَهُ","مَرَحاً ويخْطِرُ خِطْرَةَ المُتَبَخْتِرِ",6,"ر",1,0],["فَغادَرَني صَرْفُ الزَّمانِ بمَنْزِلٍ","أطأطِئُ فيهِ للخَصاصَةِ جانِبي",7,"ب",2,0],["فغَدا الرَّعيَّةُ لائِذينَ بظِلِّهِ","يَرْجُونَ غَيْثَ حَياً ولَيْثَ حَياءِ",8,"ا",2,0],["فَغيَّرَها الزَمانُ وَكُلُّ شَيءٍ","يَصيرُ إِلى التَغيُّرِ وَالنَفادِ",9,"د",1,0],["فَغَيقَةُ فَالأَخيافُ أَخيافُ ظَبيَةٍ","بِها مِن لُبَينى مَخرَفٌ وَمَرابِعُ",10,"ع",1,0],["فَغَدَا لِقَاءُ أُولِي الْفَضَائِلِ بُغْيَتِي","وَرَأَيْتُ هَذَا الْقَصْدَ شَرْطَ كَمَالِ",11,"ل",1,0],["فغَطِّ على نقْصِهِ بالكَمالِ","وأوِّل قُبولَكَ منّي اعْتِذارا",12,"ر",2,0],["فغزَتْ عدوَّ المَحْلِ في أحْجارِهِ","حتّى إذا طُفِيَتْ بهِنّ جِمارُهُ",13,"ر",2,0],["فَغَدا ومِنْ صوفِ الصّفاءِ شِعارُهُ","واعْتاضَهُ مِنْ لِبْسَةِ الدِّيباجِ",14,"ج",1,0],["فَغَدَا أَحَقَّ بِهَا وَقَامَ بِعِبْئِهَا","وَسَمَا بِأَقْرَبِهَا إِلَى غَايَاتِهَا",15,"ت",3,0],["فَغَضَّ جَديدَ الأَرضِ إِن كُنتَ ساخِطاً","بِفيكَ وَأَحجارَ الكُلابِ الرَواهِصا",16,"ص",2,0],["فَغَبّوا نَحوَنا لَجِباً","يَهُدُّ السَهلَ وَالأَكَما",17,"م",2,0],["فَغَدَونا عَلَيهِمُ بَكَرَ الوِر","دِ كَما تورِدُ النَضيحَ الهِياما",18,"م",2,0],["فَغَدا بِمُعتَدِلَينِ لَم يُسلَبُهُما","لا فيهِما عِوَجٌ وَلا نَقِدانِ",19,"ن",1,0],["فَغَدا يُصَرِّفُ مِن أَعِن","نَتِها تَصاريفَ القَديرِ",20,"ر",1,0],["فَغَدا هَذا سَماءً لِلعُلا","وَغَدا ذَلِكَ فيها كَوكَبا",21,"ب",2,0],["فَغالَها الدَهرُ كَما غالَهُ","حَتّى غَدا كَالطَلَلِ الدَرسِ",22,"س",1,0],["فَغَنِّ رُبوعَ النيلِ وَاِعطِف بِنَظرَةٍ","عَلى ساكِني النَهرَينِ وَاِصدَح وَأَبدِعِ",23,"ع",1,0],["فَغَدَوتَ تَسكُنُ في القُلوبِ وَتَرتَعي","حَبّاتِها وَتَحُلُّ في الوِجدانِ",24,"ن",1,0],["فَغَطّوا جَميعاً في المَنامِ لِيَصرِفوا","شَبا صارِمي عَنهُم وَقَد كانَ مُغمَدا",25,"د",2,0],["فَغَدا يُكَتِّمُ أَمرَهُ وَمُصابَهُ","طَمَعاً بِأَن يَخفى وَقَد بَرِحَ الخَفا",26,"ف",2,0],["فَغَدَوتُ أُنشِدُ جودَهُ مُتَمَثِّلاً","وَنَوالُهُ مِثلُ السُيولِ الدُفَّعِ",27,"ع",1,0],["فَغَولٍ فَحِلّيتٍ بِأَكنافِ مُنعَجٍ","إِلى عاقِلٍ فَالجُبِّ ذي الأَمَراتِ",28,"ت",1,0],["فَغادَرتُها مِن بَعدِ بُدنِ رَذِيَّةٍ","تُغالي عَلى عوجٍ لَها كَدِناتِ",28,"ت",1,0],["فَغادَرنَ عَسبَ الوالِقِيِّ وَناصِحٍ","تَخُصُّ بِهِ أُمُّ الطَريقِ عِيالَها",29,"ل",3,0],["فَغَيقُهُ فاَلأَكفالُ أَكفالُ ظَبيَةٍ","تَظَلُّ بِها أُدمُ الظِباءِ تَرودُ",30,"د",1,0],["فَغَدَوْنَا طَيْفَيْنِ تَرْمُقُ رَسْمِي","مِنْهُ عَيْنٌ وَرَسْمُهُ نُصْبَ عَيْنِي",31,"ي",1,0],["فَغَضَّ الطَّرْفَ ثُمَّ رَنَا فَأَلْقَى","مُفَاضَتَهُ يُضِيءُ بِهَا وِسَامُ",32,"م",1,0],["فَغادَرَ الغُضفَ يَسعى وَاِنصَمى جَنِفاً","يَمُرُّ مَرَّ شِهابٍ اِنقَضَّ مَحدورِ",33,"ر",1,0],["فَغَلَّسَت وَعَمودُ الصُبحِ مُنصَدِعٌ","عَنها وَسائِرُهُ بِاللَيلِ مُحتَجِبُ",34,"ب",1,0],["فغادر أطلال الضلال دوارساً","وجدّد بالإسلام أرفع بنيانِ",35,"ن",1,0],["فغدا يلقنني الأسى من عينها","لحظٌ برقراق الدموع سيوح",36,"ح",1,0],["فغدت في ارتهازها تتلكّا","بكلام لا تستتّم بيانه",37,"ن",2,0],["فغادة عضّت الحرب الضروس بها","عضاً بنابٍ حديدٍ غير مرضوح",38,"ح",1,0],["فغاضب زوجَها الخلطاءُ يوماً","بأمر للخلاف به نُشوب",39,"ب",1,0],["فَغَيرُكَ أَدّى لِلخَليفَةِ عَهدَهُ","وَغَيرُكَ جَلّى عَن وُجوهِ الأَهاتِمِ",40,"م",1,0],["فَغُضَّ الطَرفَ إِنَّكَ مِن نُمَيرٍ","فَلا كَعباً بَلَغتَ وَلا كِلابا",41,"ب",2,0],["فَغادَرَ مُلحَماً وَعَدَلنَ عَنهُ","وَقَد خَضَبَ الفَرائِصَ مِن طِحالِ",42,"ل",1,0],["فَغادَرَها صَرعى لَدى كُلِّ مَزحَفٍ","تَرى القَدَّ في أَعناقِهِنَّ قَوافِلا",43,"ل",2,0],["فَغَدَت كِلا الفَرجَينِ تَحسَبُ أَنَّهُ","مَولى المَخافَةِ خَلفُها وَأَمامُها",44,"م",3,0],["فغيث أنت للضركاء منا","بسيبك حين تنجد أو تغورُ",45,"ر",1,1],["فغادرتها تحبو عقيراً ونشنشوا","حقيبتها بين التوزُّع والنترِ",46,"ر",1,1],["فَغادَرنا أَبا جَهلٍ صَريعاً","وَعُتبَةَ قَد تَرَكنا بِالجَبوبِ",47,"ب",1,0],["فَغَزَّةَ فَالمَروتِ فَالخَبتِ فَالمُنى","إِلى بَيتِ زَمّاراءَ تُلداً عَلى تُلدِ",48,"د",1,0],["فَغادَروني وَالنَفسُ غالِبُها","ما شَفَّها وَالهُمومُ تَعتَكِفُ",49,"ف",1,0],["فَغادَرتَهُ مُقعَصاً في الوَغا","وَكَفُّكَ في الرُمحِ لَم تَشنَجِ",50,"ج",1,0],["فغدا الآنَ ذلك العسرُ يسراً","بحقيقٍ وذلكَ المنعُ رِفدا",51,"د",2,0],["فغِث وأغث مغرماً وابْقَ ذا","نوالٍ بسيطٍ وفضلٍ مديد",52,"د",1,0],["فغيرُ مستنكرٍ حمارٌ","أهدى حزاماً إلى جواد",53,"د",1,0],["فغدا الفكر في التغابن عجزاً","وهيَ عنه في غاية التحريم",54,"م",1,0],["فَغَدا كالْخلافِ يُورقُ للعي","ن ويأبى الإثمار كل الإباءِ",55,"ا",2,0],["فغدا يُ