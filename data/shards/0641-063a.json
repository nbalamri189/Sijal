"فغدا به مثلاً تناقله الى","أقصى القبائل ألسن الركبان",193,"ن",1,0],["فغسلت الجراح بالسلسل العذبد","وصيرت كل خلف وفاقا",194,"ق",2,0],["فَغَرَت إِلَيكَ فَفُتَّها وَتَراجَعَت","فَفَرَتهُ بِالأَنيابِ وَالأَضراسِ",195,"س",1,0],["فغِبتُ عن مجلِس العَزاءِ عَلى","رَغْمِي وإن كان مِقْوَلِي حَضَرَه",196,"ر",2,0],["فَغاثوا بِهِ الأَرضَ رَيّا مِنَ البُكا","وَطافوا بَرِيّا قَبره الطَيِّبَ الشَذا",197,"ذ",2,0],["فَغرِّد كما شِئْتَ لا فُضّ فُوكَ","وعِش بَطَلَ الضّادِ مِغْوارها",198,"ر",3,0],["فغادرتْهُ رُكاماً","أجفَّ من عودِ تِبن",199,"ن",1,0],["فَغَرَّدَ في الأَجواءِ باسْمِكَ طيرُهُ","ورَدَّدَ في الآفاقِ ذكرَكَ هادِلُهْ",200,"ل",2,0],["فغدا كالصريع يلتمسُ الْجُهْ","دَ ليحيا به فلم يَلْقَ جُهدا",201,"د",2,0],["فَغَدًا تُتَاجر في النَّحَا","س، وفي الصفيح، وفي الحديد",202,"د",1,0],["فَغَرَ اليمُّ فاه للرُّكبانِ","وطغى الماءُ، واختفى الشاطئان",203,"ن",1,1],["فغادرها رهناً لديها لحالبٍ","يرددها فِي مصدرٍ ثمّ موردِ",204,"د",1,0],["فغُودرتُ منها في عَراءٍ تَلُفُّني","مَفاوِزُ لا أعتادُها ومجاهل",205,"ل",1,0],["فغُوْلٍ فحِلّيتٍ فأكنَافِ مُنْعِجٍ","إلى عاقل فالجبّ ذي الأمرات",206,"ت",1,0],["فغادَرْتُها من بَعدِ بُدْنِ رَزِيّة","ٍ تغالي على عُوج لها كدنات",206,"ت",1,0],["فَغَيرُ عَجيبٍ إنْ رَأيْتِهِ أنْ تَرَيْ","تَلَهُّبَ ضَرْبٍ في شَوَاكِ مُبِينِ",207,"ن",1,0],["فَغَلاَمَ يُنْسَى ، أَو يُضَاعُ عَلَى النَّوَى","وُدِّي الرَّخيصُ وشِعْرِيَ المَجَّانُ",208,"ن",1,0],["فغدوا، إذا غدا عليهم، حصيداً","بالعوالي وقائما كحصيد",209,"د",1,0],["فغورست في مصر يسدّد سهمه","إليه وقنّاص الوحوش يضافره",210,"ر",2,0],["فغالني الدهر فيه بالفراق كما","قد طعم كرى عيْني بتسهيدِ",211,"د",1,0],["فغدوتَ تعتدُّ القلوبَ مُصافيا","وسواك يَعتَدُّ القلوبَ مُشاجنا",212,"ن",2,0],["فَغادَرَ الهَجرُ ما بَيني وَبَينَكُمُ","يَهماهَ تَكذِبُ فيها العَينُ وَالأُذُنُ",213,"ن",1,0],["فغاضت زوجها الخلطاءُ يوماً","بامر للخلاف به نشوب",214,"ب",1,0]]}