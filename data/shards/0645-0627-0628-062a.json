{"poems":[[74,"مذ قيل فرعك بالذوائب عرشا","https://www.aldiwan.net/poem19056.html","الكامل"],[74,"ما بت فيك بدمع عيني أشرق","https://www.aldiwan.net/poem19350.html","الكامل"],[107,"عيد الفداء جرى باليمن طائره","https://www.aldiwan.net/poem42105.html","البسيط"],[70,"ما أحسن ما بلبل منه الصدغ","https://www.aldiwan.net/poem1509.html",""],[113,"ما أحمل القلب للبلوى واصبره","https://www.aldiwan.net/poem16290.html","البسيط"],[113,"روحي الفداء لفتاك لواحظه","https://www.aldiwan.net/poem16464.html","البسيط"],[164,"من بات مثلي للنجوم نزيلا","https://www.aldiwan.net/poem59095.html","الكامل"],[190,"لا والذي بيته في حرمة الحرم","https://www.aldiwan.net/poem43299.html","البسيط"],[190,"باتت تلوم على طول الونى وغدت","https://www.aldiwan.net/poem43360.html","البسيط"],[190,"لا والذي أنا عبده","https://www.aldiwan.net/poem43540.html","مجزوء الكامل"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[409,"منعت عن مقلة الصب كراها","https://www.aldiwan.net/poem33364.html","الرمل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96723","الكامل"],[1376,"","https://poetry.dctabudhabi.ae/diwan/poem/118103","البسيط"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79946","البسيط"],[1782,"","https://poetry.dctabudhabi.ae/diwan/poem/128768","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53165","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53073","الكامل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67202","الكامل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100902","السريع"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93875","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91266","الكامل"],[4169,"","https://poetry.dctabudhabi.ae/diwan/poem/116601","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81698","الكامل"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136726",""],[307,"عام الأحزان","https://www.poetsgate.com/ViewPoem.aspx?id=215697",""],[5732,"ياغزال الريم ياظبي الفلا","https://www.poetsgate.com/ViewPoem.aspx?id=177889",""],[6202,"فليسقط الشعر -2","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86741&r=&rc=42",""]],"verses":[["ما بتُّ ملآن الحشا من لوعةٍ","لولا الولوع بحبِّ مهضمة الحشا",0,"ش",2,0],["ما بتّ فيك بدمع عيني أشرق","إلا وأنت من الغزالة أشرق",1,"ق",1,1],["ما بِتُّ إلا أظنُّ الصُّبحَ يكشف لي","عَن غُرَّةِ الزمن الوضّاحِ سافِرُهُ",2,"ر",2,0],["ما بِتُّ لَدِيغاً مِنْ هَوَاهُ وَحْدِي","من عَقْرَبَهِ في كلِّ قلبٍ لَدْغُ",3,"غ",1,0],["ما بتُّ أَرقب لَيلاً صَج مَوعده","إِلّا وَلِلحَشر أَلقاهُ وَأَنذَرَهُ",4,"ر",2,0],["ما بِتُ أَضمر في قَلبي زِيارَتَهُ","إِلّا وَأَرسَل طَيفاً مِنهُ يَدعوني",5,"ن",2,0],["ما بتك أشكو الضيم مذ جاورته","أبدا ولا أمسى دمي مطلولا",6,"ل",2,0],["ما بتّ أذكر يا مذكور بعض جوى","شوقي ووجدي لكنّي علىوجم",7,"م",1,0],["ما بتّ أشجى بذل الرد عن طلب","ولا تصبّحت من خصمي على وجل",8,"ل",1,0],["ما بتّ أفرحُ بالنديم","وبالرفيق وبالصديق",9,"ق",1,0],["ما بِتطويلِ مدحهِ ينتهي الفض","لُ فَقصّر أو قل بهِ ما تشاءُ",10,"ا",2,0],["ما بتلك الدار قلبي مغرم","أو بمن حل من القيد رباها",11,"ا",3,0],["ما بتُّ مُذ أزمعتَ هجري ليلةً","إلّا أكابدُ حسرةً وهموما",12,"م",2,0],["ما بت أرعى الدجا شوقاً إلى قمر","ولا معنى بطيفٍ طارق طارى",13,"ر",2,0],["ما بتُّ مستمطراً من مقلتي جزعاً","نوء المدامع بين النؤى والطنب",14,"ب",1,0],["ما بت طوع يد ابن آدم خاضعاً","لكنني أصبحت طوع دلاله",15,"ل",2,0],["ما بت أستهدي سقام جفونه","برءاً وأستجدي عذاراً سائلا",16,"ل",2,0],["ما بت من هجرانه متعوذا","لو لم يكن لصدوده متعوّدا",17,"د",2,0],["ما بتُّ إلاّ بات من","ه خيال شخصٍ لي ضجيعي",18,"ع",2,0],["ما بتُّ بينا الناسُ تشكو الطوى","ألعبُ بالدينار والدرهم",19,"م",1,0],["ما بت بالدمع فيه أشرق","إلا لخد زها وأشرق",20,"ق",1,1],["ما بت أَجتاب الفَيافي مُفرداً","أَبَداً وَأُصبح فَوق طِرفٍ أَجرد",21,"د",1,0],["ما بتَّ من كرم الطبائع ليلةً","إلا لِعرضكَ من نوالكَ واقِ",22,"ق",1,0],["ما بُتّ مثلُ نَداك في نادٍ ولم","يَفْرَعْ بمثل حُلاك داعٍ منبرا",23,"ر",2,0],["ما بتَّ تلهو بالنديم وبالطلا","لو كان شأنُك في الصَبابة شاني",24,"ي",1,1],["ما بتّ أسمعُ بالآفقِ مذْ عصفتْ","إلّا التعازي عنواناً وتأبينا",25,"ن",2,0],["ما بتّ أسمعُ لا عرساً ولا فرحاً","فكلّ فجرٍ علا بالموتِ مقرونا",25,"ن",2,0],["مابتليت بحب غيرك لاولا","زارني طيف سوى طيفك حرام",26,"م",1,0],["ما بت أنظر إلا العجز أنسجه","والنار تُشعل من نار بها نارا",27,"ر",2,0]]}