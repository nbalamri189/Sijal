 يحتاج كفواً يبّله","https://www.poetsgate.com/ViewPoem.aspx?id=180840",""],[4988,"فيض الاحساس","https://www.poetsgate.com/ViewPoem.aspx?id=187412",""],[5009,"في ذكرى المولد","https://www.poetsgate.com/ViewPoem.aspx?id=24366",""],[5009,"مناجاة ليلة القدر","https://www.poetsgate.com/ViewPoem.aspx?id=24372",""],[5055,"كومة أحزاب","https://www.poetsgate.com/ViewPoem.aspx?id=101660",""],[585,"مهلاً فلست بجاحدٍ أو عات","https://www.poetsgate.com/ViewPoem.aspx?id=161934",""],[5136,"شوقي إلى دست الخلافة شيق","https://www.poetsgate.com/ViewPoem.aspx?id=121631",""],[5185,"الوحدة","https://www.poetsgate.com/ViewPoem.aspx?id=70900",""],[5185,"شمس العماد","https://www.poetsgate.com/ViewPoem.aspx?id=118566",""],[5277,"دستورُ حبّكِ","https://www.poetsgate.com/ViewPoem.aspx?id=188010",""],[5376,"دُسْ عليها واهْرسِ الجسْمَ النحيلا","https://www.poetsgate.com/ViewPoem.aspx?id=188451",""],[5376,"لقد استبحتم أرضنا وسماءنا","https://www.poetsgate.com/ViewPoem.aspx?id=190448",""],[5431,"في القلب لوحك منقوشٌ كما الوجعُ","https://www.poetsgate.com/ViewPoem.aspx?id=185716",""],[5542,"الباحة اليوم","https://www.poetsgate.com/ViewPoem.aspx?id=10055",""],[5561,"الثائرون","https://www.poetsgate.com/ViewPoem.aspx?id=207881",""],[5609,"مملكة السحاب","https://www.poetsgate.com/ViewPoem.aspx?id=215574",""],[5690,"دهر يزعزع ركن المجد والأدب","https://www.poetsgate.com/ViewPoem.aspx?id=172140",""],[5691,"بشائر النور","https://www.poetsgate.com/ViewPoem.aspx?id=206731",""],[5701,"أهلا بمقدمك العظيم وأكرم","https://www.poetsgate.com/ViewPoem.aspx?id=164676",""],[5853,"دستور حبكِ","https://www.poetsgate.com/ViewPoem.aspx?id=175705",""],[5956,"نوعٌ جديد","https://www.poetsgate.com/ViewPoem.aspx?id=192427",""],[5975,"ما عدت من موتي أخافْ","https://www.poetsgate.com/ViewPoem.aspx?id=85138",""],[6008,"زواج الأمير فهد نواف الشعلان","https://www.poetsgate.com/ViewPoem.aspx?id=60993",""],[6035,"رسالة إلى الجار ، والآخر هناك !","https://www.poetsgate.com/ViewPoem.aspx?id=176961",""],[6102,"لُمْ نَفسَك!!","https://www.poetsgate.com/ViewPoem.aspx?id=186291",""],[463,"من موصلٌ بالسؤال والقسمِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60304&r=&rc=360",""]],"verses":[["دُسْتُورُ مِصْرَ أُعِيدَ عَنْ ثِقَةٍ","بِالحَقِّ لَمْ تَضْعَفْ وَلَمْ تَهْنِ",0,"ن",1,0],["دَسَّت حُبَيبَةُ مَوهِناً","إِنِّي وَعَيشِكِ يَا سَكَن",1,"ن",1,0],["دستور كتاب مولانا بمصر طوى","عني وأعمدهُ بالشامِ منشورا",2,"ر",2,0],["دسيسٌ لليهود إلى النصارى","ليفضَحهم فَقُبِّح من دسيس",3,"س",1,0],["دُسمُ العَمائِمِ مُسحٌ لا لَحومَ لَهُم","إِذا أَحَسّوا بِشَخصٍ نابِئٍ لَبَدوا",4,"د",3,0],["دَسِمَ الثِيابِ كَأَنَّ فَروَةَ رَأسِهِ","زُرِعَت فَأَنبَتَ جانِباها فُلفُلا",5,"ل",2,0],["دسَستُ اِسمَكِ الحُلوَ في طيّ شِعري","وَألّفتُ فيهِ حُروفَ اِعتِمادِ",6,"د",1,0],["دَسَمبِرُ شَعبانُ عِندَ الجَميعِ","وَشَعبانُ لِلكُلِّ ديسَمبِرُ",7,"ر",1,0],["دَسَّ لِلناشِقينَ في","زَنبَقِ الشِعرِ عَقرَبا",8,"ب",2,0],["دُستورُهُم عَجَبُ الدُنيا وَشاعِرُهُم","يَدٌ عَلى خَلقِهِ لِلَّهِ بَيضاءُ",9,"ا",2,0],["دَسَّت إِلَيَّ بِأَنَّ القَومَ إِن قَدَروا","عَلَيكَ يَشفوا صُدوراً ذاتَ تَوغيرِ",10,"ر",1,0],["دَساكِرٌ ورياضٌ حينَ ساعدَني","دِينُ البَطالَةِ كانت لي محاريبا",11,"ب",2,0],["دُس هامَةَ العَلياءِ وَاِبقَ مُمَلَّكاً","أَبَداً يَحِلُّ بِكَ الزَمانُ وَيَعقُدُ",12,"د",1,0],["دسوقي إذا أقللتُ فاقبل تحيتي","فما أنا شاديهم ولا خيرهم أنا",13,"ن",2,0],["دسوقي لا الوزارة قربتنا","ولا قامت على صلة دليلا",14,"ل",2,0],["دَسَّت إِلَيهِ الحادِثاتُ تَحِيَّةً","فيها صَلاحٌ لِلغُلامِ الفاسِدِ",15,"د",1,0],["دَسَّت إِلَيَّ رَسولاً لا تَكُن فَرِقاً","وَاِحذَر وُقيتَ وَأَمرُ الحازِمِ الحَذَرُ",16,"ر",1,0],["دُستورُ حقٍّ في يمينِ مُحمّدٍ","يحمي الضَّعيفَ ويَنصرُ المظلوما",17,"م",2,0],["دَسَّ إِلَيهِ قاصِداً أَبا الأَغَر","بِحيلَةٍ مَكتومَةٍ عَنِ البَشَر",18,"ر",1,0],["دَسَّت بُنَيَّةُ بِسطامٍ عَقارِبَها","نَحوي وَنامَت عَلى الأَضغانِ وَالحَنَقِ",19,"ق",1,1],["دَسَستَ كَيداً لَهُ تُخفي مَسالِكَهُ","كَأَنَّهُ فارِسٌ في قَوسِهِ نَزَعا",20,"ع",2,0],["دَسَّت لَهُ طَيفَها كَيما تُصالِحُهُ","في النَومِ حينَ تَأَبّى الصُلحَ يَقظانا",21,"ن",2,1],["دَسَستُ إِلَيها أَبا مِجلَزٍ","وَأَيَّ فَتىً إِن أَصابَ اِعتَزَم",22,"م",1,0],["دَسَستُ إِلَيها مَنطِقي وَكَسَوتُها","مَناسِبَ مِثلَ الوَشي فَالحِبَراتِ",23,"ت",1,0],["دَسَّت إِلَيَّ البَنّانَ تُخبِرُني","عَنها فَمَنّى وَرُبَّما كَذَبا",24,"ب",2,0],["دستوره الوحي والمختار عاهله","والمسلمون وأن شتوا رعاياه",25,"ا",2,0],["دستوره وَحدةٌ مُثلى وشرعتهُ","بالحق ناطقةٌ بالحبِّ سَمْحاءُ",26,"ا",2,0],["دُستُورها ما خَطَّ من أحكامه","وتناقلَ الفُقهاءُ من آرائه",27,"ا",3,0],["«دسوقيُّ»، لو لم تسد بأبيك","وجدِّكَ، سُدت بسحر البيان",28,"ن",1,0],["دسّ يوما في جيبه شبه ظرف","قرمزيّ ، لمحته مستطيلا",29,"ل",2,0],["دستورُ شَعبٍ لا يُمَسُّ وشِرعةٌ","هي فوقَ ما سنَّ الرجال وشرَّعوا",30,"ع",3,0],["دَسِمَ الثِّيَابِ كَأَنَّ فَرْوَة َ رَأْسِهِ","زرعتْ فأنبتَ جانبها فلفلا",31,"ل",2,0],["دسَستُ اِسمَكِ الحُلوَ في طيّه","وَألّفتُ فيهِ حُروفَ \"اِعتِمادِ\"",32,"د",1,0],["دَسَّتْ إلَيَّ رَسُولاً لا تَكُنْ فَرِقاً","وکحْذَرْ وُقَيْتَ وأَمْرُ الحَازِمِ الحَذَرُ",33,"ر",1,0],["دس فينا خط الفراق كما قد","قرق الحاجبين خط البياض",34,"ض",1,0],["دسَتُ الوزارةِ يبتغى حَجَرا","منكم ليستنِجى من الخَبَثِ",35,"ث",1,1],["دُسناهُمُ دَوسَةً مِرِّيَّةً جَمَعَت","أَشلاهُمُ وَضِباعَ الجَوِّ وَالرَخَما",36,"م",2,0],["دَسائِسًا تَحتَ جُنْحِ اللَّيلِ قَدْ نَسَجوا","أوطانَهُم صَلبوا والغَبْنَ قَدْ وَرَدوا",37,"د",3,0],["دسائس عادت بالوبال لأهلها","وما شفت الأحقاد والدهر قلب",38,"ب",1,0],["دَسْتُ الوِزارةِ لم يَزَلْ مَنْ حَلَّهُ","ولَئنْ تَجلّى ملءُ عَيْنَيْ مَنْ رَنا",39,"ن",2,0],["دستِ العُلا والمكرماتِ بنا","ودَعا الجمالَ الماءُ والعُشب",40,"ب",1,0],["دُستُم بأخمص صدقكم","أريوسَ ألطاغي الجنان",41,"ن",1,0],["دسائس لا تدري اليهود بعُشرها","دعته طباعُ السَّوْء للنهش والعض",42,"ض",1,0],["دَسْتٌ بياذِقُهُ سطَتْ بشِياهِهِ","وتَحكَّمتْ فيهِ بحكْمٍ غالِب",43,"ب",1,0],["دُسْنا ترابَكِ بالمناسِم والهوى","لو أنه بشفاهنا ملثومُ",44,"م",1,0],["دستُ رؤوسَ العدا بمجدكُمُ","وهان هاماتُهم على قدمي",45,"م",2,0],["دَسُّوا المَكايِدَ في مواعدَ حُلوةٍ","كانت عقاربَ والكِذابُ حُماتِها",46,"ت",3,0],["دَسُت الوَزارَة ضَاءَ مِنْه بمشرقِ ال","وَجَنَاتِ وَضَّاحِ الجبين مُمجَدِ",47,"د",1,0],["دسائسها سم تهيئ هلكها","وعلتها داء لصحتها سقم",48,"م",1,0],["دست بكفي وردتين وسنبله","ومضت تجر بخطوة متثاقله",49,"ل",2,1],["دستور مصرَ وليدٌ بينكم فخذوا","من السلام له مهداً ومحتضنا",50,"ن",2,0],["دستُمْ صميمَ المجدِ في اللحدِ ويحكمْ","فحتَّامَ يبقى المجدُ في اللحدِ مدسوسا",51,"س",2,0],["دست شباك هلاك تحت زخرفها","فما تورط فيها غير باغيها",52,"ي",3,0],["دَسراً إِذا حَمِيَ الهِياجُ بِحَدِّه","وَجَعَلتَ تَسمَعُ لِلرِّماحِ قِراشا",53,"ش",2,0],["دستورهم منشورهم مسطورهم","في رقهم والسند باد الواري",54,"ر",2,0],["دستا وَجولي","سكراً لدينا",55,"ن",2,0],["دَسَسْنَا لَهَا تَحْتَ العَجَاجَ ابنْ مُلْجَمِ","جَرِيئاً إذَا ما جَاءَ نَفْساً كِتَابُهَا",56,"ه",2,0],["دسقار ما حلّ حالوم به أبداً","ذاك المدوّد لا حُيّيَ في الأقطار",57,"ر",1,0],["دسَّ الزمانُ جديدَكُنَّ فلوْعَتي","قدُمَتْ بوجْدِ حديثِها المتجدِّدِ",58,"د",1,0],["دسَّ الرَّدَى في لحظهنَّ سِهامَهُ","فولغْنَهُ في مهجةِ المتودِّدِ",58,"د",1,0],["دس الجور بالحق امحق التيه بالهدى","دع الغي للرشد امحض الحق للشجي",59,"ج",2,0],["دسمبر فيك نزعنا الحجاب","بنعلنها ثورة قانيه",60,"ي",2,0],["دسمبر سلحت أشبالنا","وعبأت أجيالنا الآتيه",60,"ي",2,0],["دس شقي هذه البريه","جعدة بنت الأشعث الكنديه",61,"ه",1,0],["دَسّيتْ سَدَّهْ فِيْ الحشا دَس","وما يِعْلَم الا عالِم الغيب",62,"ب",1,0],["دسست له تحت الظلام غوائلاً","بها أصبح الإسلام محدودب الظهر",63,"ر",1,0],["دُسْنا ولم نَفْشلْ هوازِنَ دَوْسةً","تركَتْ هوازِنَ كالفريدِ الأعْزلِ",64,"ل",1,1],["دسَّ الطِبيبُ يَدِي فارتاع مِن مَرضِي","وَقَالَ دَاؤُك يُعيي طِبَّ إبلِيس ِ",65,"س",1,1],["دس هامة المَجد الرَفيع السُؤددِ","وارقى بِسَعدك فوقَ فرق الفَرقَدِ",66,"د",1,1],["دست دست الكلام بُسْت بُسْتاً","فأتى الفتح أم من الكشكول",67,"ل",1,0],["دَسائس مصر ما تُغني إِذا ما","رأَيت السَيف يَقترف اِقتِرافه",68,"ف",2,0],["دسي بهاك وَموتي موتة اللهج","لا أَبتَغيك فاني لست بالبهج",69,"ج",1,1],["دسَّ الوشاة بسمعها خبراً","ان الذي تهواه في سفر",70,"ر",1,0],["دست هام النجوم بالنعل حتى","ود كيوان أن يكون شراكا",71,"ك",2,0],["دَسَّتَ رَسولاً أَنِ اِئتِنا رَقدَةَ ال","حَيِّ إِذا ما عَلِمتَهُم غَفَلوا",72,"ل",3,0],["دَسَّت سُعادُ رَسولاً غَيرَ مُتَّهَمٍ","وَصيفَةً فَأَتَت إِتيانَ مُنكَتِمِ",73,"م",1,1],["دست بعنادي ظروف عاندني","قلت أباصل لو غدى الموت الوصول",74,"ل",1,0],["دَسَّ عرقٌ فيهِ من عُمقٍ بدا.","يَعلُنُ الصّدقَ وفي السّرِ غَدَرْ",75,"ر",1,0],["دستورها القرأن ماهوب غيره","دار تحكم الشرع والدين مصيون",76,"ن",1,0],["دسمة شواربهم زفر زايد البوس","للزيف والتدليس خيط ومسلّه",77,"ل",2,0],["دستور يا حظرة هل البيت دستور","جيت ومعي من فيض الاحساس قافي",78,"ف",2,1],["دستورهم لا فرنسا قننتْه ولا","روما، ولكن قد اختاروه قرآنا",79,"ن",2,0],["دستور حق وتشريع وتربية","يبقى وإن زال هذا العالم الفاني",80,"ن",2,0],["دسرٍ وألواحٍمع شْراع وأخشاب","وبلغتهم بالحق ما قال ربّي",81,"ب",2,1],["دست إليّ مع الحفيف رسالةً","هبطت عليّ بخافت الهمسات",82,"ت",1,0],["دست تجلى طالعاً من وجه من","قمر العلا أنواره تتالق",83,"ق",1,0],["دستورنا القرآن أعلن وحدة","فأثار حمق الأغبياء غباء",84,"ا",2,0],["دستورها القرآن خير شريعة","من منهج الله استمد حقائقه",85,"ق",2,0],["دستورُ حبِّكِ أنْ أبيتَ على ضنى","يقضي بأنْ أبقى كذاكَ مُقَنِّنا",86,"ن",2,1],["دُسْ عليها واهْرسِ الجسْمَ النحيلا","واملأ الدنيا ظلاماً وعويلا",87,"ل",2,1],["دُسْ عليها واهْرسِ العظْمات هرْساً","فمن العظْمِ صنعْناه صقيلا",87,"ل",2,0],["دستم على عظم الرضيع بوحشة","وكأنكم نلتم به أحياءنا",88,"ن",2,0],["دستورُ عشقك لا يُعنى بما وضعوا","في القلب لوحك منقوشٌ كما الوجعُ",89,"ع",1,1],["دستورنتا الحق، لا نرضى به بدلا","به نسير إلى أهدافنا صُعُدا",90,"د",2,0],["دستورُنا ضَحِكٌ على آمالِنا","والخائنونَ ببندِهِ قد سادوا",91,"د",3,0],["‏‎دُسْتورُنا الْقُرآنُ سَيِّد أَمرِنا","فَبِهِ الْحَياةُ سَمتْ وَعانَقتً السَّما",92,"م",2,0],["دست الرسوم وكشاف الهموم ومص","باح العلوم حميد الفعل واللقبِ",93,"ب",1,0],["دُسْتورُهُ القُرْآنُ أشْمَلُ مُنْزَل ٍ","وأساسُهُ الإسْلامُ أكْمَلُ سِيمى",94,"م",2,0],["دستور دنيا العالمين ودينهم","مرقى الفلاح وعصمة المستعصم",95,"م",1,0],["دستور حبكِ ظل الطيب والألما","يستلهم الصبح في عين الغرام سما",96,"م",2,1],["دُسْ فوق رقبته وَوسِّخْ جزمةً","تُجْزَ الثوابَ بسحقِ صرصور الخلا",97,"ل",2,0],["دسّي سمومَكِ في دمي","ما عدتُ من موتي أخافْ",98,"ف",1,1],["دسّي سمومَكِ .. والجفا","يا حلوتي سمٌّ زعافْ",98,"ف",1,0],["دستورنا الإسلام من نهج قرآن","وبفضل ولي ٍ للسماحه وهبنا",99,"ن",2,0],["دسَسْتُم البُغضَ في طيّات مِئْزَرِها","وطَرْفُها بقَتَام الغدر يكتحلُ",100,"ل",1,0],["دُسْ فَوقَ طِيبِكَ يَرقَ بَعضُكَ بَعضَكْ","فَالهَطلُ في الأَرضِ البَوارِ أَمَضَّكْ",101,"ك",1,1],["دستُ رءوسَ العدا بمجدكمُ","وهان هاماتهم على قدمي",102,"م",2,0]]}