{"poems":[[93,"لم يخطيء التوفيق صاحبه","https://www.aldiwan.net/poem11208.html","أحذ الكامل"],[41,"يا روضة الوضاح قد","https://www.aldiwan.net/poem42348.html","مجزوء الكامل"],[72,"خلفت بالقلب بيتا منك معمورا","https://www.aldiwan.net/poem18733.html","البسيط"],[51,"صرمت اليوم حبلك من لميس","https://www.aldiwan.net/poem64658.html","الوافر"],[29,"حلت صبيرة أمواه العداد وقد","https://www.aldiwan.net/poem6069.html","البسيط"],[38,"صدقت معية نفسه فترحلا","https://www.aldiwan.net/poem7809.html","الكامل"],[78,"أغائبة الشخص عن ناظري","https://www.aldiwan.net/poem14007.html","المتقارب"],[85,"صغار بحلوان تستبشر","https://www.aldiwan.net/poem8065.html","المتقارب"],[85,"يا ابن زيدون مرحبا","https://www.aldiwan.net/poem8080.html","مجزوء الخفيف"],[85,"أعلى الممالك ما كرسيه الماء","https://www.aldiwan.net/poem63727.html","الكامل"],[28,"كيف ببيت قريب منك مطلبه","https://www.aldiwan.net/poem5081.html","البسيط"],[61,"إذا السحاب حداه البرق مجنونا","https://www.aldiwan.net/poem51780.html","البسيط"],[66,"دمع مزائد قطره لا تجمد","https://www.aldiwan.net/poem38494.html","الكامل"],[97,"متى نلتها كانت لأنفسنا منى","https://www.aldiwan.net/poem24587.html","الطويل"],[97,"وزيري الطيب الحر الجليلا","https://www.aldiwan.net/poem24972.html","الوافر"],[44,"الآن لما صار حوض الوارد","https://www.aldiwan.net/poem30052.html","الكامل"],[31,"قف بالديار عفا من أهلها الأثر","https://www.aldiwan.net/poem42547.html","البسيط"],[105,"الكون أشرق نضرة ونعيما","https://www.aldiwan.net/poem42064.html","الكامل"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[52,"دست بنية بسطام عقاربها","https://www.aldiwan.net/poem26796.html","البسيط"],[52,"يا قاتلا لا يبالي بالذي صنعا","https://www.aldiwan.net/poem26855.html","البسيط"],[48,"دست له طيفها كيما تصالحه","https://www.aldiwan.net/poem66093.html","البسيط"],[50,"ونبئت قوما بهم جنة","https://www.aldiwan.net/poem62253.html","المتقارب"],[50,"فتاتي نديمي غنيا بحياتي","https://www.aldiwan.net/poem64737.html","الطويل"],[50,"يا صاحبي العشية احتسبا","https://www.aldiwan.net/poem64817.html","المنسرح"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39630","البسيط"],[106,"شيخ القضاة","https://www.poetsgate.com/ViewPoem.aspx?id=179683",""],[106,"غرام يزيد 2","https://www.poetsgate.com/ViewPoem.aspx?id=179759",""],[106,"وقفة على طلل","https://www.poetsgate.com/ViewPoem.aspx?id=151389",""],[90,"الى السعدون..","https://www.poetsgate.com/ViewPoem.aspx?id=179037",""],[38,"صَدَقَتْ مُعَيَّة َ نَفْسُهُ فَتَرَحَّلاَ","https://www.poetsgate.com/ViewPoem.aspx?id=21224",""],[78,"أَغائِبَةَ الشَّخصِ عَن ناظِري","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86500&r=&rc=45",""],[31,"قفْ بالديارِ عفا من اهلها الأثرُ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18856&r=&rc=119",""],[113,"حسد الدهر ساعة جمعتنا","https://www.aldiwan.net/poem41655.html","الخفيف"],[140,"دست الوزارة يبتغى حجرا","https://www.aldiwan.net/poem58364.html","أحذ الكامل"],[167,"قم فاشدد العيس للترحال معتزماً","https://www.aldiwan.net/poem1675.html",""],[176,"إلا من رحم ربي","https://www.aldiwan.net/poem50699.html","البسيط"],[237,"فعالك تسهتوي القلوب فتطرب","https://www.aldiwan.net/poem23839.html","الطويل"],[362,"ورد الخدود ودونه شوك القنا","https://www.aldiwan.net/poem60636.html","الكامل"],[362,"عوجوا عليها أيها الركب","https://www.aldiwan.net/poem60987.html","أحذ الكامل"],[374,"أولى مسيري ذا الأمان","https://www.aldiwan.net/poem59233.html","مجزوء الكامل"],[413,"وفظ غليظ القلب أيقنت أنه","https://www.aldiwan.net/poem54019.html","الطويل"],[429,"أما الكواكب فاحتموا بمواكب","https://www.aldiwan.net/poem12405.html","الكامل"],[456,"لمن الطلول كأنهن رقوم","https://www.aldiwan.net/poem55864.html","الكامل"],[456,"من موصل بالسؤال والقسم","https://www.aldiwan.net/poem55894.html","المنسرح"],[456,"دعها تكن كالسلف من أخواتها","https://www.aldiwan.net/poem56263.html","البسيط"],[573,"كحل العيون بمرود من عسجد","https://www.aldiwan.net/poem3085.html","الكامل"]],"verses":[["دُسْتُورُ مِصْرَ أُعِيدَ عَنْ ثِقَةٍ","بِالحَقِّ لَمْ تَضْعَفْ وَلَمْ تَهْنِ",0,"ن",1,0],["دَسَّت حُبَيبَةُ مَوهِناً","إِنِّي وَعَيشِكِ يَا سَكَن",1,"ن",1,0],["دستور كتاب مولانا بمصر طوى","عني وأعمدهُ بالشامِ منشورا",2,"ر",2,0],["دسيسٌ لليهود إلى النصارى","ليفضَحهم فَقُبِّح من دسيس",3,"س",1,0],["دُسمُ العَمائِمِ مُسحٌ لا لَحومَ لَهُم","إِذا أَحَسّوا بِشَخصٍ نابِئٍ لَبَدوا",4,"د",3,0],["دَسِمَ الثِيابِ كَأَنَّ فَروَةَ رَأسِهِ","زُرِعَت فَأَنبَتَ جانِباها فُلفُلا",5,"ل",2,0],["دسَستُ اِسمَكِ الحُلوَ في طيّ شِعري","وَألّفتُ فيهِ حُروفَ اِعتِمادِ",6,"د",1,0],["دَسَمبِرُ شَعبانُ عِندَ الجَميعِ","وَشَعبانُ لِلكُلِّ ديسَمبِرُ",7,"ر",1,0],["دَسَّ لِلناشِقينَ في","زَنبَقِ الشِعرِ عَقرَبا",8,"ب",2,0],["دُستورُهُم عَجَبُ الدُنيا وَشاعِرُهُم","يَدٌ عَلى خَلقِهِ لِلَّهِ بَيضاءُ",9,"ا",2,0],["دَسَّت إِلَيَّ بِأَنَّ القَومَ إِن قَدَروا","عَلَيكَ يَشفوا صُدوراً ذاتَ تَوغيرِ",10,"ر",1,0],["دَساكِرٌ ورياضٌ حينَ ساعدَني","دِينُ البَطالَةِ كانت لي محاريبا",11,"ب",2,0],["دُس هامَةَ العَلياءِ وَاِبقَ مُمَلَّكاً","أَبَداً يَحِلُّ بِكَ الزَمانُ وَيَعقُدُ",12,"د",1,0],["دسوقي إذا أقللتُ فاقبل تحيتي","فما أنا شاديهم ولا خيرهم أنا",13,"ن",2,0],["دسوقي لا الوزارة قربتنا","ولا قامت على صلة دليلا",14,"ل",2,0],["دَسَّت إِلَيهِ الحادِثاتُ تَحِيَّةً","فيها صَلاحٌ لِلغُلامِ الفاسِدِ",15,"د",1,0],["دَسَّت إِلَيَّ رَسولاً لا تَكُن فَرِقاً","وَاِحذَر وُقيتَ وَأَمرُ الحازِمِ الحَذَرُ",16,"ر",1,0],["دُستورُ حقٍّ في يمينِ مُحمّدٍ","يحمي الضَّعيفَ ويَنصرُ المظلوما",17,"م",2,0],["دَسَّ إِلَيهِ قاصِداً أَبا الأَغَر","بِحيلَةٍ مَكتومَةٍ عَنِ البَشَر",18,"ر",1,0],["دَسَّت بُنَيَّةُ بِسطامٍ عَقارِبَها","نَحوي وَنامَت عَلى الأَضغانِ وَالحَنَقِ",19,"ق",1,1],["دَسَستَ كَيداً لَهُ تُخفي مَسالِكَهُ","كَأَنَّهُ فارِسٌ في قَوسِهِ نَزَعا",20,"ع",2,0],["دَسَّت لَهُ طَيفَها كَيما تُصالِحُهُ","في النَومِ حينَ تَأَبّى الصُلحَ يَقظانا",21,"ن",2,1],["دَسَستُ إِلَيها أَبا مِجلَزٍ","وَأَيَّ فَتىً إِن أَصابَ اِعتَزَم",22,"م",1,0],["دَسَستُ إِلَيها مَنطِقي وَكَسَوتُها","مَناسِبَ مِثلَ الوَشي فَالحِبَراتِ",23,"ت",1,0],["دَسَّت إِلَيَّ البَنّانَ تُخبِرُني","عَنها فَمَنّى وَرُبَّما كَذَبا",24,"ب",2,0],["دستوره وَحدةٌ مُثلى وشرعتهُ","بالحق ناطقةٌ بالحبِّ سَمْحاءُ",25,"ا",2,0],["دُستُورها ما خَطَّ من أحكامه","وتناقلَ الفُقهاءُ من آرائه",26,"ا",3,0],["«دسوقيُّ»، لو لم تسد بأبيك","وجدِّكَ، سُدت بسحر البيان",27,"ن",1,0],["دستوره الوحي والمختار عاهله","والمسلمون وإن شتّوا رعاياه",28,"ا",2,0],["دستورُ شَعبٍ لا يُمَسُّ وشِرعةٌ","هي فوقَ ما سنَّ الرجال وشرَّعوا",29,"ع",3,0],["دَسِمَ الثِّيَابِ كَأَنَّ فَرْوَة َ رَأْسِهِ","زرعتْ فأنبتَ جانبها فلفلا",30,"ل",2,0],["دسَستُ اِسمَكِ الحُلوَ في طيّه","وَألّفتُ فيهِ حُروفَ \"اِعتِمادِ\"",31,"د",1,0],["دَسَّتْ إلَيَّ رَسُولاً لا تَكُنْ فَرِقاً","وکحْذَرْ وُقَيْتَ وأَمْرُ الحَازِمِ الحَذَرُ",32,"ر",1,0],["دس فينا خط الفراق كما قد","قرق الحاجبين خط البياض",33,"ض",1,0],["دسَتُ الوزارةِ يبتغى حَجَرا","منكم ليستنِجى من الخَبَثِ",34,"ث",1,1],["دُسناهُمُ دَوسَةً مِرِّيَّةً جَمَعَت","أَشلاهُمُ وَضِباعَ الجَوِّ وَالرَخَما",35,"م",2,0],["دَسائِسًا تَحتَ جُنْحِ اللَّيلِ قَدْ نَسَجوا","أوطانَهُم صَلبوا والغَبْنَ قَدْ وَرَدوا",36,"د",3,0],["دسائس عادت بالوبال لأهلها","وما شفت الأحقاد والدهر قلب",37,"ب",1,0],["دَسْتُ الوِزارةِ لم يَزَلْ مَنْ حَلَّهُ","ولَئنْ تَجلّى ملءُ عَيْنَيْ مَنْ رَنا",38,"ن",2,0],["دستِ العُلا والمكرماتِ بنا","ودَعا الجمالَ الماءُ والعُشب",39,"ب",1,0],["دُستُم بأخمص صدقكم","أريوسَ ألطاغي الجنان",40,"ن",1,0],["دسائس لا تدري اليهود بعُشرها","دعته طباعُ السَّوْء للنهش والعض",41,"ض",1,0],["دَسْتٌ بياذِقُهُ سطَتْ بشِياهِهِ","وتَحكَّمتْ فيهِ بحكْمٍ غالِب",42,"ب",1,0],["دُسْنا ترابَكِ بالمناسِم والهوى","لو أنه بشفاهنا ملثومُ",43,"م",1,0],["دستُ رؤوسَ العدا بمجدكُمُ","وهان هاماتُهم على قدمي",44,"م",2,0],["دَسُّوا المَكايِدَ في مواعدَ حُلوةٍ","كانت عقاربَ والكِذابُ حُماتِها",45,"ت",3,0],["دَسُت الوَزارَة ضَاءَ مِنْه بمشرقِ ال","وَجَنَاتِ وَضَّاحِ الجبين مُمجَدِ",46,"د",1,0]]}