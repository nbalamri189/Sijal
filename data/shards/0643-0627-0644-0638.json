{"poems":[[65,"واها لأيامي بأكناف اللوى","https://www.aldiwan.net/poem46135.html","الرجز"],[46,"قف بالطلول الدارسات علاثا","https://www.aldiwan.net/poem30565.html","الكامل"],[83,"يا واحدا في الفضل حالفني ندى","https://www.aldiwan.net/poem61454.html","الكامل"],[170,"أراك مستعجلا يا حادي الإبل","https://www.aldiwan.net/poem46896.html","البسيط"],[199,"عرف الديار توهما فاعتادها","https://www.aldiwan.net/poem54421.html","الكامل"],[240,"يا خير منتصر لخير إمام","https://www.aldiwan.net/poem31765.html","الكامل"],[240,"غاداك من بحر الرواعد مسبل","https://www.aldiwan.net/poem31795.html","الكامل"],[240,"لا أوحش الله ممن","https://www.aldiwan.net/poem31995.html","المجتث"],[240,"يا علو أغريت السهاد بناظري","https://www.aldiwan.net/poem32015.html","الكامل"],[369,"أأحبتي الشاكين طول تغيبي","https://www.aldiwan.net/poem60990.html","الطويل"],[408,"دعا فؤادي يقاسي الشوق والكمدا","https://www.aldiwan.net/poem46752.html","البسيط"],[438,"لم ترض أني قد حرمت وصالها","https://www.aldiwan.net/poem12711.html","الكامل"],[469,"قف أن وقفت فذاك وادي المنحى","https://www.aldiwan.net/poem3179.html","عموديه"],[469,"ما للخيال جفا وقد بعد المدى","https://www.aldiwan.net/poem3191.html","عموديه"],[469,"وجدي كوجدك بالظباء الغيد","https://www.aldiwan.net/poem3208.html","عموديه"],[469,"هل هز بالأعطاف سمر صعاده","https://www.aldiwan.net/poem3623.html","عموديه"],[580,"شربت شرب الهيم","https://www.aldiwan.net/poem3010.html","مجزوء الرجز"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59660","السريع"],[469,"","https://poetry.dctabudhabi.ae/diwan/poem/205228","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120048","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120016","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119920","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120017","الكامل"],[1762,"","https://poetry.dctabudhabi.ae/diwan/poem/89628","السريع"],[1827,"","https://poetry.dctabudhabi.ae/diwan/poem/75802","السريع"],[1832,"","https://poetry.dctabudhabi.ae/diwan/poem/126638","الكامل"],[1887,"","https://poetry.dctabudhabi.ae/diwan/poem/114035","البسيط"],[2173,"","https://poetry.dctabudhabi.ae/diwan/poem/142782","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53199","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53079","الكامل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60844","الكامل"],[2606,"","https://poetry.dctabudhabi.ae/diwan/poem/198979","الكامل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129806","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66458","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91359","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91356","الكامل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132096","الكامل"],[3763,"","https://poetry.dctabudhabi.ae/diwan/poem/124146","البسيط"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35558","الكامل"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29277","الرمل"],[4091,"","https://poetry.dctabudhabi.ae/diwan/poem/141843","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73189","الكامل"],[4691,"هيفاء يا حبي الذي اشتدا","https://www.poetsgate.com/ViewPoem.aspx?id=61729",""],[4927,"عشق ورغد","https://www.poetsgate.com/ViewPoem.aspx?id=29945",""],[5038,"أبحث عن وطن","https://www.poetsgate.com/ViewPoem.aspx?id=189952",""],[5582,"قِفْ بِالرُّسُومِ وَسائِلْ الأَطْلالا","https://www.poetsgate.com/ViewPoem.aspx?id=187237",""],[5582,"سَلْ بُرْقَةَ العَلَمَيْنِ ثُمَّ البانا","https://www.poetsgate.com/ViewPoem.aspx?id=187309",""],[6093,"كنهه لا شيء","https://www.poetsgate.com/ViewPoem.aspx?id=197063",""],[6093,"لا يَنحني إلا ليلتقطَ الفصولْ","https://www.poetsgate.com/ViewPoem.aspx?id=203946",""],[199,"عَرَفَ الدِّيَارَ تَوَهُّماً فاعْتَادَهَا","https://www.poetsgate.com/ViewPoem.aspx?id=20775",""],[6178,"مرافي محطمة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85529&r=&rc=5",""]],"verses":[["كالظّبْيَةِ الغَيْداءِ جِيداً إنْ عَطَتْ","والجؤْذَرِ الوَسْنانِ طَرْفاً إنْ رَنا",0,"ا",1,0],["كَالظَبيَةِ الأَدماءِ صافَت فَاِرتَعَت","زَهرَ العَرارِ الغَضِّ وَالجَثجاثا",1,"ث",2,0],["كَالظِلِّ إِلّا نورُهُ وَثُبوتُهُ","كَالشَمسِ إِلّا في لَظاها المُحرِقِ",2,"ق",1,0],["كالظبي لولا اعتلالٌ في نواظرِها","والظبيُ لا يشتكي من عارضِ العِلَلِ",3,"ل",1,0],["كَالظَبيَةِ البِكرِ الفَريدَةِ تَرتَعي","مِن أَرضِها قَفَراتِها وِعِهادَها",4,"د",3,0],["كَالظَبيِ مَصقولِ العِذارِ لَهُ إِذا اِع","تَرَكَ الفَوارِسُ وَثبَةُ الضِرغامِ",5,"م",1,0],["كَالظَبيِ يَومَ السِلمِ وَهوَ لِفَتكِهِ","يَومَ الوَغى لَيثُ العَرينِ المُشبِلُ",6,"ل",1,0],["كَالظَبيِ وَالظَبيُ أَحوى","ساجي اللِحاظِ غَريرُ",7,"ر",1,0],["كَالظَبيِ مَصفودِ التَرائِبِ فاتِرِ","اللَحَظاتِ ما وَجدي عَلَيهِ بِفاتِرِ",8,"ر",1,0],["كالظَّبيةِ الأدماءِ يَرتَعُ سرْبُها","في كلِّ وادٍ بالأسنّةِ مُعشِب",9,"ب",1,0],["كالظَّبي حين عطا والليثُ حين سطا","والغصن حين خطا والبدرُ حين بدا",10,"د",2,0],["كالظبيةِ الأدْماءِ أتْلعَ جيدَها","رامٍ على شرفٍ رأتْهُ فهالَها",11,"ل",3,0],["كالظَّبي يعطو أو يلاِحظ رانياً","والبدرِ يبدو والقضيب إذا انثنى",12,"ن",2,0],["كالظَّبي طرفاً والسُّلافةِ ريقةً","والدعص ردفاً والقضيب تأوُّدا",13,"د",2,0],["كالظّبي لا في ردفها وقوامها","بل لحظها ونفارها والجيد",14,"د",1,0],["كالظبي فتي لفتاته ونفارهِ","والبدر في إشراقهِ وبعاده",15,"د",2,0],["كالظَّبْي لا حاشَاه مِنْ","فَمٍ له مَهْتُوم",16,"م",1,0],["كالظل لم أسطع فراقاً له","وقد غدا يجذبُ أذيالي",17,"ل",2,0],["كالظبي في لفتاته ونفارهِ","والبدر في إشراقهِ وبعاده",18,"د",2,0],["كالظبي أعينا يرينك أعنا","ق ظباء مخلوقة للعناقِ",19,"ق",1,0],["كالظبية الجيداء لولا ما بها","من صمت خلخال ونطق حقابِ",20,"ب",1,0],["كالظبي مرتاعا إذا نظرت","والغصن وهو مهفهف نضرُ",21,"ر",1,0],["كالظبية الأدماء سانحة","لكنها تتصيد الأسدا",22,"د",2,0],["كالظَبيةِ الفاردَة الخاذِلِ","المَخروفَةِ المُقفِرةِ المُطفلِ",23,"ل",1,0],["كالظَبيةِ الفارِدَةِ الخاذِلِ","المَخورفَةِ المُقفِرَةِ المُطفِلِ",24,"ل",1,0],["كالظبية الظمياء في","بطن البوادى سادره",25,"ر",2,0],["كالظبّي جيداً او ألحاظاً فمقلتها","مكحولة ما لها ميلٌ وكحّالُ",26,"ل",1,0],["كالظَّبي لولا الذي بالظبي من خَنَسٍ","والبدر لولا الذي بالبدر مِنْ كَلَفِ",27,"ف",1,0],["كالظاهر الملك الموفي بذمته","دون الملوك إذا ما ذمت الذمم",28,"م",1,0],["كالظبي حسناً والمدامة ريقةً","والغصن عطفاً والغزالة جيدا",29,"د",2,0],["كالظبية الأدماء بل كالبانة الم","لداء أو كالرملة الوَعساء",30,"ا",2,0],["كالظبي في تكليمه والجذع في","تحنينه والبدر في تشقيقه",31,"ق",2,0],["كالظبي كالشمس المنيرة كالنقا","كالغصن يثني معطفيه رخاء",32,"ا",2,0],["كالظبي لحظاً ولكن بين مقلته","وسحر هاروت حقاً أقرب النسب",33,"ب",1,0],["كالظبي لا يُنئيه إلا قصدُهُ","كَاللَيث لا يدنيه منك سِوى الشرس",34,"س",1,0],["كَالظبي يَخشى ضَيغماً","كَالوُرْق تحذر قربَ باز",35,"ز",1,0],["كالظبي فارق في الفلاة أليفه","فارتاع أو كالطائر المتفزع",36,"ع",1,0],["كالظلّ في النور أو كالشمس عارضها","خطٌّ من الغيم أو كالمحو في القمر",37,"ر",1,0],["كَالظَّبيِ آنسَ نَبأة مِن قانِصٍ","فَرَنا بِمُقلةِ خائفٍ متوجّسِ",38,"س",1,0],["كَالظِلِّ لَو أَسرى","بِصَفحَةِ الماءِ",39,"ا",2,0],["كالظَّبْى والضبّ اللذين تأدّبا","عند التشهد بالسان المفهمِ",40,"م",1,0],["كالظَّبيِ خلقاً بل كرئبالِ الشَّرى","خُلقاً يُعيدُ به العزيزَ ذَليلا",41,"ل",2,0],["كالظل أنت ِ وفية فعدي","متلهفاً ولتنجزي الوعدا",42,"د",2,0],["كَالظَّبْيِ تَقْطُرُ حُسْناً كُلَّمَاْ خَطَرَتْ","وَسْنَاْنَةُ الطَّرْفِ نَحْسَبُ سُّهْدَهَاْ º رمَدَاْ",43,"د",2,0],["كَالظِّلِّ تَتْبَعُني بَنادِقُ داعِشٍ","وَتُريدُ مِنّي أَنْ أَموتَ بِلا كَفَنْ",44,"ن",1,0],["كالظَّبْيَةِ القَفْراءِ إِلاَّ أَنَّها","لَيْسَتْ مُذَعَّرَةً وَلا مِعْطالا",45,"ل",2,0],["كالظَّبْيَةِ الأَدْماءِ ظَلَّتْ تَرْتَعِي","ثَمَرَ الأَراكِ الغَضَّ وَالحَوْذانا",46,"ن",2,0],["كالظل -قالت- لو جعلت وصالنا","والناس تمدح في الهجير الفيء",47,"ي",2,0],["كالظِّلِ يعكسُ صورةً لدَواخِليْ","هلَّا خرجتَ على المَحافِلِ يا خَجُولْ",48,"ل",1,0],["كالظبية ِ البكرِ الفريدة ِ ترتعي","من أرضها قفاتها وعهادها",49,"د",3,0],["كالظل يرصفني التيار في جهتي","يا وجهي الصدفي المنحوت يغريها",50,"ي",3,0]]}