{"poems":[[87,"أحق أنهم دفنوا عليا","https://www.aldiwan.net/poem7117.html","الوافر"],[87,"به هجر يتيمه","https://www.aldiwan.net/poem7140.html","مجزوء الوافر"],[47,"عناني من صدودك ما عناني","https://www.aldiwan.net/poem66682.html","الوافر"],[107,"هو الخطب حتى ينكر التاج صاحبه","https://www.aldiwan.net/poem43380.html","الطويل"],[52,"خليلي عفا عن سهيل بن سالم","https://www.aldiwan.net/poem63809.html","الطويل"],[147,"بقيت لذا العز الذي عز مطلبا","https://www.aldiwan.net/poem11733.html","الطويل"],[154,"أطع مولاك تظفر بالنجاح","https://www.aldiwan.net/poem68533.html","الوافر"],[203,"هي الأفلاك لا شم القباب","https://www.aldiwan.net/poem45404.html","الوافر"],[240,"حث كؤوس الراح","https://www.aldiwan.net/poem32118.html","مجزوء الرجز"],[369,"طلعت نجوم الدين فوق الفرقد","https://www.aldiwan.net/poem60958.html","الكامل"],[398,"أسد ولكن الكلاب","https://www.aldiwan.net/poem53595.html","مجزوء الكامل"],[543,"بمقدمك الحمراء قد عبقت عطرا","https://www.aldiwan.net/poem48185.html","عموديه"],[567,"لعينك يا غزال الرقمتين","https://www.aldiwan.net/poem52794.html","الوافر"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138327",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122814","الطويل"],[238,"","https://poetry.dctabudhabi.ae/diwan/poem/46007","الطويل"],[1141,"","https://poetry.dctabudhabi.ae/diwan/poem/130713","المتقارب"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50042","المتقارب"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50034","الطويل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93845","البسيط"],[3508,"","https://poetry.dctabudhabi.ae/diwan/poem/20546","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131008",""],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114370","الطويل"],[4099,"","https://poetry.dctabudhabi.ae/diwan/poem/73547","الرجز"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139637",""],[5005,"هما ندّان..","https://www.poetsgate.com/ViewPoem.aspx?id=190156",""],[5542,"يا فارس الكرسي","https://www.poetsgate.com/ViewPoem.aspx?id=9679",""],[5701,"رعى الله على دِجل","https://www.poetsgate.com/ViewPoem.aspx?id=164597",""],[5717,"بحار دم أجرت عيون محبيه","https://www.poetsgate.com/ViewPoem.aspx?id=170591",""],[5956,"أقصوصة شاعر وحانوت","https://www.poetsgate.com/ViewPoem.aspx?id=193640",""],[6106,"هم الطهارة ( سادتنا أهل البيت )","https://www.poetsgate.com/ViewPoem.aspx?id=6304",""]],"verses":[["هما كالسيف لا تنصفه يفسد","عليك وخذه مكتملا سويا",0,"ي",2,0],["هما كادا لمهجته","ومنك الكيد معظمه",1,"م",2,0],["هُما كَنزي لِأَحداثِ اللَيالي","إِذا خيفَت وَذُخري لِلزَمانِ",2,"ن",1,0],["هُمُ اِكتَنَفوهُ بِالدَسائِسِ وَاِفتَروا","مِنَ القَولِ ما يَعمى عَنِ الرُشدِ كاذِبُه",3,"ب",2,0],["هُما كَلَّفاني أَن أَكونَنَّ أَيِّراً","جِهاراً وَلا وَاللَهِ ما خَلَقَ البَشَر",4,"ر",1,0],["هُما كَوكَبا سَعدٍ أَنافا وَأَشرَقا","فَلا أَفَلا ما أَطلَعَ اللَيلُ كَوكَبا",5,"ب",2,0],["هما كنفاك في لُطفٍ وصون","ورعي بالغُدُوِّ وبالرّواح",6,"ح",1,0],["همُ اكتسبوا لغيرهمُ فأمسى","عليمُ الاكتسابُ بالاكتئابِ",7,"ب",1,0],["هُم أَكرَمُ الناسِ","وَأَنداهُم بُطونَ راحِ",8,"ح",1,0],["هم أكرموني فانتحلتُ مديحَهم","مَن يَحتَبِلْني بالكرامةِ يَصطَد",9,"د",1,0],["هُم أَكَّدوا أَمر الدَعِ","يِّ يَزيد مَلفوظِ السفاحِ",10,"ح",1,0],["هما كَفَّتا الميزانِ فانظُر إليهما","إذا رجَحت إحداهُما طاشتِ الأُخرى",11,"ر",2,0],["هما كالفرقَدينِ على اجتماعٍ","نَرومُ لهُ دَوامَ الفرقدَينِ",12,"ن",1,0],["هما كصنوين لكن قلباً اتحدا","واي عينَ رأت صنوين ما اختلفا",13,"ف",2,0],["هٌمٌ اكتًنًفُوا مُوسَى وَعيسَى وَأبدَلُوا","عَلّيَاً وَوَهاساً بِخَوفِهِما أَمنا",14,"ن",2,0],["هُما كَنَفا الأَرضِ اللَذا لَو تَزَعزَعا","تَزَعزَعَ ما بَينَ الجَنوبِ إِلى السُدِّ",15,"د",1,0],["هما كاليدين وكالمقلتين","وكالنيرين لنفع العباد",16,"د",1,0],["هم أَكرم النّاس مُرداً وشيباً","ومن كان في المهد منهم صبيّا",17,"ي",2,0],["هما كَفياني عُسرتي وتكفلا","لرزقي من اقتاره بأمانِ",18,"ن",1,0],["هما كريمان قد فاقا الورى نسبا","وليس ذو كرم أصلاً كذي لؤم",19,"م",1,0],["هُمُ أَكرَموني في الجِوارِ وخِلتُنى","إِذا كُنتُ مَولى نِعمةٍ لا أَضيعُها",20,"ع",3,0],["هما كفيا الجيش المجاهد فاقة","فباتا ذخرا وكان بلا ذخر",21,"ر",1,0],["هما كفتانِ للقياس مناطِ الاج","هاطِ بهِ يبدو الذي هو مبهمُ",22,"م",1,0],["هُما كَمالُ ذي الحِجى","لَو أَنَّ ذا نَقصٍ كَمُل",23,"ل",1,0],["هما كوكبا مجدٍ وشمسا مناقبٍ","وبدران كلٌّ من مطالعه السعد",24,"د",1,0],["هما كفّانِ تصطفقانِ خُسْراً","وقد فتكَ الجرادُ لدى الحصادِ",25,"د",1,0],["هم أكسبوكَ من السِّباقِ رِهانا","فربحتَ أنتَ وأدركوا الخسرانا",26,"ن",2,1],["هما كانا هدى شعر","لنا في ليله أسرى",27,"ر",2,0],["هما كوكبا علم اذا ما تجليا","تجلي صباح الرشد وانجاب داجيه",28,"ي",2,0],["هم أكرم الدنيا لذلك أحتفي","بكبار مَن هم قدوةٌ ومناقبُ..",29,"ب",1,0],["هم أكرم الناس إن حققت عنصرهم","أتقى الخلائق فلننظر لفعلهم",30,"م",1,0]]}