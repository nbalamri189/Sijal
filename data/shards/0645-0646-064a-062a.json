te.com/ViewPoem.aspx?id=181494",""],[6068,"يَا طَارِقَ الأَسْحَارِ -06-","https://www.poetsgate.com/ViewPoem.aspx?id=175904",""],[6198,"الموجةُ الطروبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79239&r=&rc=13",""],[6199,"بغداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66252&r=&rc=5",""],[6259,"لست في بينها الغداة بلاحِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59363&r=&rc=11",""],[572,"سامعة ٌ للهوى مُطِيعة ْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9381&r=&rc=238",""]],"verses":[["مُنيتَ بِشَوقٍ يَنحَرُ الدَمعَ سَيفُهُ","إِذا حادَثَتهُ بِالصِقالِ المَعاهِدُ",0,"د",1,0],["مَنَّيتُ نَفسي مِن وَفائِكِ ضَلَّةً","وَلَقَد تَغُرُّ المَرءَ بارِقَةُ المُنى",1,"ن",2,0],["مَنّيتَنا بِغَدٍ وَبَعدَ غَدٍ","حَتّى بَخَلتَ كَأَسوَءِ البُخلِ",2,"ل",1,0],["من يتحف البيت العتيق وزمزماً","والوفد وفدُ الله فيه ينزلُ",3,"ل",1,0],["من يتركِ الشر خوفاً من معاقبة","فليس يحسب ذا فضل وأن فضَلا",4,"ل",2,0],["مَن يَتَّبِع غَيرَ مَتبوعٍ فَإِنَّ لَنا","في اِبنَي نِزارٍ نَصيباً غَيرَ مَخسوسِ",5,"س",1,0],["مُنيتُها أن تكون أجرتُها","من كسب لِصٍّ وكدح نبّاش",6,"ش",1,0],["منيتها أير عريض القفا","مضلَّع تغمز أضلاعه",7,"ع",2,0],["مُنِيَتْ بخَصْمٍ مثلِها حَكَمٍ","في كل قلبٍ أيَّما حكمِ",8,"م",1,0],["مَن يَتبَعِ العُميانَ حُبّاً بِالهُدى","لا يَأمَنَّن تَعَثُّرَ العُميانِ",9,"ن",1,0],["مَنَّيتَ نَفسَكَ باطِلاً","فَإِلى مَتى تَرضى بِباطِل",10,"ل",1,0],["مَنَّيتِني فَلَوَيتِ ما مَنَّيتِني","وَجَعَلتِ عاجِلَ ما وَعَدتِ كَآجِلِ",11,"ل",1,0],["منَّيته في ذا الشباب","منىً فهلا كنّ صدقا",12,"ق",2,0],["مُنيتُ بِأَوضَعِ الثَقَلَينِ قَدراً","فَيا هُلكى هُناكَ وَيادَمارى",13,"ر",2,0],["مَن يَتَصَرَّع في إِثرِ مَكرُمَةٍ","فَدَأبُهُ في إِبتِغائِها دَأَبُه",14,"ب",2,0],["مَن يَتَجاوَز عَن مُطاوَلَةِ العَي","شِ تَقَعقَع مِن مَلَّةٍ عَمَدُه",15,"د",2,0],["مَنَّيتِنا عَلَلاً وَما أَنهَلتِنا","وَالوَقتُ لَيسَ يُحيلُ حَتّى يُشهِرا",16,"ر",2,0],["مَنَّيتَني الأَدهَمَ مِن بَعدِ ما","فَجَعتَني بِالأَشهَبِ الجَونِ",17,"ن",1,0],["مَن يَتَجَرَّم لي المَناطِقَ ظالِماً","فَيَجرِ إِلى شَأوٍ بَعيدٍ وَيَسبَحِ",18,"ح",1,1],["مَنَّيتِنا وَغَرَرتِنا","يا دارُ أَربابِ الغُرورِ",19,"ر",1,0],["مُنيَتي بُغيَتي حَبيبي نَصيبي","مالِكُ الرِقِّ سَيَّدي مَولائي",20,"ا",3,0],["من يُتْبِعُ القولَ من إحسانه عملاً","والقولُ يورقُ والإثمارُ للعمَلِ",21,"ل",1,0],["مَنَّيتِنا فَرَجاً إِن كُنتِ صادِقَةً","يا بِنتَ مَروَةَ حَقّاً ما تُمَنّيني",22,"ن",2,0],["مَنَّيتُها النَفسَ حَتّى قَد أَضَرَّ بِها","وَأَحدَثَت خُلُفاً مِمّا أُمَنّيها",23,"ه",2,0],["مَنَّيتِنا فَرَحاً إِن كُنتِ صادِقَةً","يا حَبَّ نَفسٍ أَحَقّاً ما تُمَنِّيني",24,"ن",2,0],["مُنيتُ بِالمُتَحَرّي","في كُلِّ أَمرٍ مَساتي",25,"ت",2,0],["مَنَّيتِني مُنيَةً هَشَّ الفُؤادُ لَها","ثُمَّ اِنصَرَفتِ وَما زَوَّدتِني زادا",26,"د",2,0],["مَنَّيتُها النَفسَ حَتّى لامَني","وَشَفَّني الحُبُّ تَقريباً وَإِبعادا",27,"د",2,0],["مَنَّيتَني بِشراً وَبِشرُ فَتىً","لا يَشتَري الحَمدَ بِإِعطاءِ",28,"ا",2,1],["مَنِيَّتُهُ تَجري لِوَقتٍ وَقَصرُهُ","مُلاقاتُها يَوماً عَلى غَيرِ مَوعِدِ",29,"د",1,0],["مِنْ يَتُبْ عَنْ حُبِّ مَعْشُوقِهِ","لَسْتُ عَنْ حُبِّي لَهُ تَائِبا",30,"ب",2,0],["مُنيتُ بِقَلبٍ لَيسَ يَنفَكُّ مُقصَداً","بِلَحظَةِ طَرفٍ أَو بِشُربِ مُدامِ",31,"م",1,0],["مَنْ يَتَّبِعْ قَوْلَ النّبيِّ إِنَّهُ","فِينَا مُطَاعُ الأمْرِ حَقُّ مُصَدَّقِ",32,"ق",1,0],["مُنيتُ مِن أَهلي وَمِن أَهلِها","بِالجُهدِ مِن كَثرَةِ قالٍ وَقيل",33,"ل",1,0],["مَنِيَّتُهُ أَولى بِهِ مِن حَياتِهِ","إِذا كانَ شَكوى الحبِّ ضَربَة لازِمِ",34,"م",1,0],["مَنِيَّتي مُنيَتي وَإِلّا","فَعَيشُ حَرّانَ مُستَهامِ",35,"م",1,0],["منَّيتَ قومَك بالوعو","د فأين تحقيق الوعود؟",36,"د",1,0],["منِّي تعلَّمتِ الثبا","تَ الرَّاسِيَاتُ من الجبال؟",37,"ل",1,0],["مَنّيْتَني الأَدْهَمَ، مِنْ بعد أن","فَجَعْتَني بالأَشْهَبِ الجَوْنِ",38,"ن",1,0],["مَنْ يَتَجَاوَزْ على مُطَاوَلَةِ العَيْ","شِ تُقَعْقِعْ منْ مَلّةٍ عُمُدُهْ",39,"د",2,0],["منيتي بعاده","ومنيتي وصاله",40,"ل",2,0],["مَن يَتِّقِ اللَهَ يَجِد غِبَّ التُقى","يَومَ الحِسابِ صائِراً إِلى الهُدى",41,"د",2,0],["مُنْيتُهُ للطارق المجتدى","أن يُدرجَ الأرضَ فتُطوَى لَهْ",42,"ل",2,0],["مَنِيَّتُهُم بِجِوارِ الصَليبِ","وَمَن لَم تُجِر مِنهُمُ لَم يُجَر",43,"ر",1,0],["من يتبع أثر الهوى مشى به","في طرق الريبة والمشابه",44,"ب",2,0],["من يتقِ الله يجعلْ مخرجاً حسناً","له يروقه من غير ما احتسبا",45,"ب",2,0],["مُنيتُ مِنَ الزَمانِ بِعَنقَفيرٍ","قَليلٌ عِندَها حَزُّ الشِفارِ",46,"ر",1,0],["مُنيَتي بِالجزعِ والسفح ربا","عطّرت كلَّ الوَرى من نشرها",47,"ه",2,0],["مُنيَتي طيبة لا أَبغي سواها","فَبِها الحسنُ لِعمري قد تَناهى",48,"ا",3,1],["مَنَّيْتُ نفسي بعفوٍ","مولايَ منكَ ومني",49,"ن",2,0],["من يتعظ فصروفُ الدهرِ موعظةٌ","وما مواعظِ دهرٍ كلّهُ عبرُ",50,"ر",1,0],["مِنِّيَ تُقياً ومنكَ مَكرُ","وفِيَّ بلوىً وفيك صَبرُ",51,"ر",1,1],["منيتي لو وفيت ما كان احلى","حين قبلت وجنتيك وفاك",52,"ك",1,0],["مُنيَتي هَل تَذكُرينا","وَقفَةً قُربَ الغَدير",53,"ر",1,0],["منيتي قربٌ وودٌّ","واحترامٌ للوفاق",54,"ق",1,0],["منيتي غفرانُ ذنبٍ","كفرُ قلبٍ قد جناهُ",55,"ا",2,0],["مُنْيَتي عَوْدٌ فدمعي","حار والأشجانُ حُبْلى",56,"ل",2,0],["منّي تحبُّ البناتُ","إذ هنُّ مُبتكراتُ",57,"ت",1,1],["مَنِيتُ بِها مُسْتَكْرَهاً فَاجْتويْتُها","كَما يَجْتَوِي دارَ الْهَوانِ نَزِيلُها",58,"ل",3,0],["مُنِيتُ بِبَيْعِ الشِّعْرِ مِنْ كُلِّ بَاخِلٍ","بِخُلْفِ مَوَاعِيدٍ وَزُورِ أَمَانِي",59,"ن",2,0],["مُنِيّتُها مَنزلةً قد عَلَتْ","وَانحَطَّ عَنها الفَلَكُ السَّابِعُ",60,"ع",1,1],["مَنيتُها تفرق مِن عَاذِلي","أَن يَحملَ النُّصحَ إِلى قابِلِ",61,"ل",1,1],["منيَّتُنا كالفيء لاحقةٌ بنا","وهمَّتنا في الزائلات من العمر",62,"ر",1,0],["مَنْ يَتَّقِ الله يُحْمَدُ في عَواقِبِه","وَيكفِهِ شَرَّ مَنْ عزُّوا ومَنْ هانُوا",63,"ن",3,0],["مُنيَتْ بحَمْلِ غَرامِنا وغَرامِها","فَتجشّمتْ مالا تُطيقُ الأيْنُقُ",64,"ق",1,0],["مَنَّيْتَنِي بالوَصْلِ عاماً أَوَّلاً","فَقَنِعْتُ منكَ بقُبْلَةٍ في قابلِ",65,"ل",1,0],["منيتي لحاظه ومنيتي","ابيض وضاحٌ وساجٍ أكحل",66,"ل",1,0],["مُنيتَ مِنّي وَقَد هاجَ الرِهانُ بِنا","بِغايَةٍ مَنَعَتكَ الفَوتَ وَالطَلَبا",67,"ب",2,0],["منيتي في مستواها","تبعث الروح هفيفا",68,"ف",2,0],["مَنْ يَتَطَبَّعْ بِغَيْرِ طَبْعٍ","يَرْجِعْ صَغِيْرَاً إِلَى الطَّبِيْعَهْ",69,"ع",2,0],["من يتب خشية العقاب فإني","تبت أُنْساً بهذه الأجزاءِ",70,"ا",2,1],["من يتبع الحقَّ المبين فانما","يطأُ الغُواةَ كما وطئتِ عداك",71,"ك",1,0],["مَنَّيتِنا بِغَدٍ وَبعد غَدٍ","حَتّى بَخِلتِ كأَسوإ البُخلِ",72,"ل",1,0],["من يتق الرحمن يعصم حاله","ومن رحمة المولى يجيه وسيل",73,"ل",1,0],["من يتبعْ سيدَ البرايا","يكنْ مع الناسِ غيرَ عاجزْ",74,"ز",1,1],["مُنيَتي في غُربَتي قَبلَ الرَدى","أَن أُمَلّي مِن مَجاليكَ البَصَرْ",75,"ر",1,0],["من يتبع النفس الغر","يرةَ ترمه في كل شهر",76,"ر",1,0],["مُنِيتُ في وَجْهِ دَهْرِي مَا يُكَلِّفُهُ","لَمَّا كَفَانِيَ مَا قَدْ عَزَّ مِنْ كُلَفِ",77,"ف",1,0],["منيِتي فعدوتُ في أثر الهوى","عدوا ولم أحفل بيوم مآبي",78,"ي",1,0],["منيتي حتى تملكني الهوى","فخذلتني والحب في ابّانه",79,"ن",2,1],["مُنيتُ بِها فَما أَشفَقتَ مِنها","وَأَشفَقَتِ العُلا مِما مَناكا",80,"ك",2,0],["مَنّيْتَهُمْ أنْ آثَرْوكَ مَثُوبَةً","فَرَشَدْتَ إذْ لَمْ تُوفِ بِالْمِيعَادِ",81,"د",1,0],["مَنَّيتُموني أَمانِيّاً قَنَعتُ بِها","حَتّى إِذا ما جَعَلتُم مقنعاً دوني",82,"ن",2,0],["مَنيتي باهي المَحيا","صاحب القَد الرَشيق",83,"ق",1,0],["منيتي يا ذا القِوام الأَميسِ","يا أَسبل الخَد لَحظَك فارِسي",84,"ي",1,1],["منيتَ ابتداءاً بدرِّ المقال","ويا بحرُ بالطبع منك الكرم",85,"م",1,0],["من يتبع الحق لم تعثر له قدمٌ","ومن تخلق بالآباء ما ظلما",86,"م",2,0],["مُنيتي لذّتي سروري حبوري","راحتي قرقفى وشهدي وقندي",87,"د",2,0],["مَن يَتَّقِ اللَهَ في الدُنيا فَإِن لَهُ","أَجرَ التَقي إِذا وَفى الحِسابَ غَدا",88,"د",2,0],["منيتي مذ رام هجري","وبدا لي منه حرب",89,"ب",1,1],["من يتخذ غيرَ الإله جلياً","أضحى عليه مُقدَّماً ورئيسا",90,"س",2,1],["من يتجلى حكمه في الورى","بصورةِ المظلوم والظالم",91,"م",1,0],["منيتُ عليكم بالذي جئتكم به","على ألسن الأرسال حبالكم منا",92,"ن",2,0],["مَنْ يَتَّبِعْ آثَارَنَا فَلَهُ الهنا","دارُ النَّعِيمِ ودينُه الإسلام",93,"م",1,0],["من يتقي الذمَ ومَنْ يفعَل الحُسَنى","فهم في روضةٍ يُحبرَون",94,"ن",1,0],["منيتمونا رقياً باذخاً وغنى","إلى عمارة أقطار وبلدان",95,"ن",1,1],["مَنَّيتِني أُمنيَّةً فَتَرَكتُها","وَرَكبتِ حالاً فاِنصرفتُ لِحالي",96,"ل",2,0],["منيتي في الزَمان ذكر علىّ","عند سعي الأَقدام في الاقدام",97,"م",1,0],["م