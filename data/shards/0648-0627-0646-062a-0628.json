تَ مُفْلِتي","بِحَزْمِكَ فاحْزُمْ يا أُقَيْشِرُ وَآعْجَلِ",255,"ل",1,0],["وإنْ تَبْغِ إحساناً وإحمادَ مَقْصَدٍ","فحسيك أن تلقى ابن معن محمدا",256,"د",2,0],["وأنت بعد الفراق اليوم يائسة","وأُركِس الحبّ في النّسيان وانتكسا",257,"س",2,0],["وأن تبد عنهن النزاهة همن من","ورائك وجدا في الاقامة والظعن",258,"ن",1,0],["وإنْ تُبادِرْ إلَيْهِ بالنَّصيحَةِ لا","يقْبَلْ بِها حَرَداً والقَلْبُ منْخوبُ !",259,"ب",1,0],["وأنتَ .. بفضلِ ربك من جنودٍ","علوا بالحق .. أركاناً صِلابا",260,"ب",2,0],["وانت بنا جذوة لا تموت","حسبناه امسى رماداً نسيّا",261,"ي",2,0],["وأنتِ بَيدرُ أفرا حٍ تؤثِّثُهُا","عيناكِ يا امْرَأةٌ أمسَيتِ لي عَدَنا",262,"ن",2,0],["وان تبوسم لي بعينه والشفا مضمومة","والله ان مدري وش اللي بعدها يجرالي",263,"ل",2,0],["وانت باكر بتعرف على ناس جداد","والكلام يجيك من كل شكل وكل لون",264,"ن",1,0],["وانت بردك برد .. ماهمّه دفاك اللي تضمّه","والا انا بردي مواجع يوم جمرك ما تهيّا",265,"ي",2,0],["وان تبقى لي ضياعي فيك .. ضعتك واهتديتك","واختصرت حكايتي في صيف ما مرّه سحايب",266,"ب",1,0],["وإنْ تَبدَّلَ معيارٌ فلا عَجَبٌ","هذي الطبيعةُ ينمو كلُّ ما فيها",267,"ي",3,0],["وانتبهنا حينما الصبح دنا","وطيور ظللتنا كالسحابْ",268,"ب",1,0],["وإنتبهت وقمت من نومي وإلاني آتحلمّ","قلت أنا يالله دخيلك فرحتي راحت خساره",269,"ر",2,0],["وَانتَبَهنا؛ بَعدَ ما الضَّوءُ سَرى","بِخُيُوطِ الفَجرِ, ثُمَّ انتَشَرا",270,"ر",2,1],["وَ انتَبِهْ . أَيُّها الخَصِيمُ , لَعَمرِي","قَدْ تَرَفَّعتَ مِنزَلًا بَعدَ رَدِّي",271,"د",2,0],["وَ أَنْ تُبَاهِي جَمِيعَ النَّاسِ مَا مَلَكَتْ","يَدَاكِ مِنْ لُؤلُؤٍ فِي تُربِكِ اعتَفَرا",272,"ر",2,0],["وانتبه ثم انتبه للخط به تدويره","لاتفتل في شماغ العقل والبسامي",273,"م",2,0],["وانتبهتُ العمرُ يمضي بين شكٍ","واصطفائي خارجاً بي عن مداري",274,"ر",2,0],["وَانْتَبَهْنَا واللَّيَالِي، قدْ أَتَانَا","طيفُ محبوبٍ على وعدٍ حنونِ",275,"ن",1,0],["وأنتَ بدنياك لاهِ بعيد","تُطيل الرقادَ؛ وتهوى السهر",276,"ر",1,0],["وإن تبخل الدنيا بتأليف شملنا","فرأي المقام الناصري جميل",277,"ل",1,0],["وأنت بعد أثينا للفكر مهدٌ ثان","وأخت كل جمال وأم كل الأماني",278,"ن",2,0],["وأنتَ بيني وبينَ الوصلِ أوردَةٌ","فرّتْ مِنَ الدَّمعِ فارتدَّتْ بِها الحَدَقُ!",279,"ق",1,0],["وإن تبدّت لك الأضواء في بلدٍ","به الحطيم فقل : يكفيك يا جملُ",280,"ل",1,0],["وأنتَ بلا أملٍ تَستطيلْ","تُحاولُ رَسْمكَ فوقَ السَحابْ",281,"ب",1,0],["وأنت بخمس دقائق منك","نسفت ادعائي عبر الأثير",282,"ر",1,0],["وأنتَ بعضُ ابتهالاتي وبعض دمي","وبعض بعضي وأجزائي ومرتهني",283,"ن",2,0],["وأنت بِذِكرِ لُبْنَى مُسْتَهامٌ","مُعَنًّى حَيْثُ ما شَحَطَتْ نَواها",284,"ا",3,0],["وإن تبين منه هيكلا تعبا","بوقره فهوفي آن خفيف دم",285,"م",1,0],["وأن تبخس النّاس أشياءهم","وأن تدعي الفضل للأغبياء",286,"ا",2,0]]}