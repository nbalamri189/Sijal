ttps://www.poetsgate.com/ViewPoem.aspx?id=215014",""],[5756,"الاولي والتالي","https://www.poetsgate.com/ViewPoem.aspx?id=5415",""],[5756,"الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=5184",""],[5848,"السويدي والعليّا","https://www.poetsgate.com/ViewPoem.aspx?id=50604",""],[5848,"فستان وردي","https://www.poetsgate.com/ViewPoem.aspx?id=50594",""],[5956,"لمّا الحقائق تُجْلَى","https://www.poetsgate.com/ViewPoem.aspx?id=184524",""],[5957,"يا حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=25885",""],[6056,"الحر تكفيه الإشارة","https://www.poetsgate.com/ViewPoem.aspx?id=130510",""],[6102,"وَمَضَينا!","https://www.poetsgate.com/ViewPoem.aspx?id=182771",""],[6102,"خَطٌّ أَحمَر ..","https://www.poetsgate.com/ViewPoem.aspx?id=183988",""],[6102,"سُحقًا لِقَلبكِ ..","https://www.poetsgate.com/ViewPoem.aspx?id=184412",""],[6115,"انت ياشاشه بريمته بيدي غيره","https://www.poetsgate.com/ViewPoem.aspx?id=180505",""],[6124,"أمسيات","https://www.poetsgate.com/ViewPoem.aspx?id=105842",""],[6124,"فتنة الشوق","https://www.poetsgate.com/ViewPoem.aspx?id=194524",""],[6152,"كفاك غيابا فشوقي إليك","https://www.poetsgate.com/ViewPoem.aspx?id=213201",""],[520,"ألا قل لعز الدين لا زال جده","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577603",""],[1100,"مداك عمر الزمان فروعي الحدثان","http://www.aldiwanalarabi.com/poemDescription.do?poemId=612991",""],[6196,"موعدُ العمرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83044&r=&rc=0",""],[6223,"يا حادي الركب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1210&r=&rc=7",""],[5080,"إلى لحظتيكَ يحجّ السراب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88130&r=&rc=0",""],[6233,"في خمس دقائق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82085&r=&rc=30",""],[6257,"سامرتُه حلما ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87182&r=&rc=7",""],[6267,"بَكِيتُ، نَعَمْ بَكيتُ وَكُلُّ إلْفٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=8337&r=&rc=46",""],[402,"نهاية الفخر لي في هذه الكلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54056&r=&rc=908",""],[2638,"دنيا الأذكياء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87840&r=&rc=4",""]],"verses":[["وأنتَ بتَتْميمِ الصّنائِعِ كافِلٌ","الى أن يعودَ الجاهُ والعِزُّ والوَفْرُ",0,"ر",1,0],["وَأَنتَ بِحَمدِ اللَهِ ما زِلتَ قادِراً","عَلى النَفعِ فَاِستَنهِض بَيانَكَ وَاِنقَعِ",1,"ع",1,0],["وَأَن تَبنِيَ المَجدَ الَّذي مالَ رُكنُهُ","وَأَن تُرهِفَ السَيفَ الَّذي قَد تَثَلَّما",2,"م",2,0],["وَإِن تَبخَل عَلَيهِ فَرُبَّ دَهرٍ","وَهَبتَ لَهُ رِضاكَ بِلا حِسابِ",3,"ب",1,0],["وَإِن تَبخَلي يا ليلَ عَنّي فَإِنَّني","تُوَكَّلُني نَفسي بِكُلِّ بَخيلِ",4,"ل",1,0],["وأنت بالحق جديرٌ بما","أدركته من جاهك الأكمل",5,"ل",1,0],["وَإِنْ تَبَيَّنْتَ مِنْهُ هَيْكَلاً تَعِباً","بِوِقْرِهِ فَهْوَ فِي آنٍ خَفِيفُ دَمِ",6,"م",1,0],["وأن تُبصر الأشياء بيضاً نواصعاً","فتُظهرها للناس قانية حمرا",7,"ر",2,0],["وَإِن تَبتَغوا يا تَيمُ ذِكراً بِشَتمِنا","فَقَد ذُكِرَت تَيمٌ بِذِكرٍ يَشينُها",8,"ن",3,0],["وَأَنتَ بي مِن أَضَنِّ الناسِ كُلِّهِمِ","فَكَيفَ تَبذُلُني لِلسُمرِ وَالقُضُبِ",9,"ب",1,0],["وأنت بالفضلِ تملينا معاينة","والسيف أصدق أنباء من الكتب",10,"ب",1,0],["وأنت بجنَّات النعيم مهنأ","بما كنت تبلى في تطلبه العمرا",11,"ر",2,0],["وانتبهْ لي من رقدةِ الملك تَعْلَمْ","أن لله مَعْشراً علماءَ",12,"ا",2,0],["وإن تبدّى بصوتٍ خَرَّ سامعُهُ","للبرد مَيْتاً ولو درَّعتَه سقرا",13,"ر",2,0],["وأنتَ بأن تُحْبَى على أن قَبلْتَها","أحقُّ ولكنَّا ظلمناك فاغفرِ",14,"ر",1,0],["وأنت بكر على الهجاء فصن","عرضك إن الأبكار تُفتَرع",15,"ع",1,0],["وأنت بتحقيقِ ما أرتجيه","وإبطال أسوأ ظنٍّ زعيمُ",16,"م",1,0],["وَاِنتِباه وَرُقاد وَحَديث وَسُكوتُ","فَبِما أَمتازُ عَنها لَيتَ شِعري لَستُ أَدري",17,"ي",1,0],["وَأَنتَ بَينَ المَوتِ وَالحَياةِ","مِن تُخمَة أَلقَتكَ في الفَلاةِ",18,"ه",1,0],["وَأَنتَ بِما نُلتَنا مالِكٌ","يُثَمِّرُ مِن مالِهِ مالَهُ",19,"ل",2,0],["وَاِنتَبَهنا كَما اِنتَبَهتَ بِلا شَي","ءٍ وَكانَ النَوالُ قَدرَ الكَلامِ",20,"م",1,0],["وَإِن تَبعَثوني بَعدَ سَبعينَ حِجَّةً","أَكُن كَعَذابِ النارِ ذاتِ الجَحائِمِ",21,"م",1,0],["وَأَنتَ بِوادي الكَلبِ لا أَنتَ ظاعِنٌ","وَلا واجِدٌ يا اِبنَ المَراغَةِ بانِيا",22,"ي",2,0],["وَإِن تَبَرَّمتَ فَاِدلُلنا عَلى مَلِكٍ","يَحكيكَ لِيَ فَدَليلُ الخَيرِ فاعِلُه",23,"ه",1,0],["وَاِنتَبَهَ الدَهرُ لَنا","مِن بَعدِ ما كانَ رَقَد",24,"د",1,0],["وانتبهنا بعد ما زال الرحيق","وأفقنا ليتَ أنا لا نفيق",25,"ق",1,0],["وَأَنتَ بِمِصرٍ غايَتي وَقَرابَتي","بِها وَبَنو الآباءِ فيها بَنو أَبي",26,"ب",2,0],["وَإِن تَبِن غَربَةٌ عَنّا بِها قَذَفٌ","فَما تَقَضّى الهَوى مِنّا وَلا الوَطَرُ",27,"ر",1,0],["وَإِن تَبعُدي يا لَيلُ بِم أَسلُ عَنكُمُ","وَلَكِنَّ حُبّي وَالغَرامُ جَديدُ",28,"د",1,0],["وَاِنتَبَهَت لِلشُهبِ تِلكَ الحُلى","وَفاضَ في الآفاقِ نَهرُ النَهار",29,"ر",1,0],["وَأَنتَ بِفَضلٍ مِنكَ نَجيِّتَ يونُساً","وَقَد باتَ في أَضعافِ حوتٍ لَيالِيا",30,"ي",2,0],["وأنتَ بها فارْدُدْ تحيّةَ بعضنا","إذا قَبّلتْ كَفّيكَ عنّا الغمائمُ",31,"م",1,0],["وأنتَ بدأتَ الصّفْحَ عن كلّ مُذنبٍ","وأنْتَ سَنَنْتَ العفْوَ عن كلّ مجْرِم",32,"م",1,0],["وَأَنتِ بِما قَرَّبتِني وَاِصطَفَيتِني","خَلاءٌ وَقَد باعَدتِني بُعدَ مُذنِبِ",33,"ب",1,0],["وَإِن تَبدُ في الصُبحِ الثَرَيّا فَإِنَّها","تُيَمِّمُ بِالتِسيارِ آلَ قَراسِ",34,"س",1,0],["وَأَنتَ بِاللَيلِ تَسمو الحادِثاتُ إِلى","سُهاكَ عَمداً وَلا تُخلي ثُرَيّاكَ",35,"ك",1,0],["وأن تُبسَطَ الآمالُ في ساحةِ العُلا","رجاءً يداوي الشوقَ وهو يشُوقُ",36,"ق",1,0],["وأنت باقٍ والجمال الذي","غنّى به شعري ليومي الأخير",37,"ر",1,0],["وانتبهنا كما انتبهت بلا شي","ءٍ فكان النّوال قدر الكلام",38,"م",1,0],["وأنتَ بأفقِكَ ساجي اللحاظِ","تُطِلُّ على سُبُحاتِ الفِكَرْ",39,"ر",1,0],["وأنت بالعهد من هواها","ربيبها وابنها النجيب",40,"ب",1,0],["وَإِنْ تَبْكِ سُورِيَّا فَقَدْ كُنْتَ رُكْنَهَا","وَكُنتَ أَبَرَّ ابْنٍ لأَجْزَعِ ثَاكِلِ",41,"ل",1,0],["وَإِنْ تَبْكِ أَربابُ الصَّحَائِفِ تَرْحَةً","فَقَدْ يَعْرِفُ التَّالُونَ فَضْلَ الأَوَائِل",41,"ل",1,0],["وأنت بأحكام الامام وحقه","عليك وأحكام الولاية عالم",42,"م",1,0],["وإن تُبْتُمْ فذالكمُ وإلا","تُصِرُّ على البلية إن تُصرّوا",43,"ر",3,0],["وإن تبغني في حلقة القوم تلقني","وإن تقتنصني في الحوانيت تصطد",44,"د",1,0],["وَإنْ تَبْعَثُوني بَعْدَ سَبْعِينَ حِجّةً","أكُنْ كَذابِ النّارِ ذاتِ الجَحائِمِ",45,"م",1,0],["وأنتِ بقلبي ملصوقةُ","يطولُ على الأرض إغماؤنُا",46,"ن",2,0],["وأنتَ بظاهر الفسطاطِ قاعا","نزلتَ بعالمٍ خرق القضايا",47,"ا",1,0],["وانت بكل مفخرة عريق","وانت بكل مكرمة جدير",48,"ر",1,0],["وانت بعد الله مقصوده","تسأل بل تطلب بل تقصد",49,"د",1,0],["وأنت بدنياه وآخراه غوثه","وأنت الرجا الأقوى لتحليل عقله",50,"ل",2,0],["وأنت بالليل حلم غير منقطع","وأنت في الصبح عزم غير متصل",51,"ل",1,0],["وأنت بين أبابيلٍ مغردةٍ","كأنهن على الأغصان قنوان",52,"ن",1,0],["وإِن تَبَدَّت بِنَادِيها مُغَنِّيةً","تَوَقَّدَ الغَيظُ ما بَينَ السمعِ والبَصَرِ",53,"ر",1,0],["وَإِن تَبِعوا زَعيمَهُمُ وَنالوا","مَنالاً كُذِّبَت فيهِ الظُنونُ",54,"ن",1,0],["وأنت بالرشد أولى والرجوع إلى","ما يقتضيه العلا والمجد والشرفُ",55,"ف",1,0],["وأنت بالصبر أولى من سواك فما","في طاعة الحزن للسادات من عذر",56,"ر",1,0],["وأنت بهم أحفى من الأب بابنه","وألين فيهم منه خلقا وأسهل",57,"ل",1,0],["وأنت بأمر لو علمت اجتنبته","عظيم لدين المسلمين مغاير",58,"ر",1,0],["وأنت بكلّ ما قد كان منّي","وما هو كائن منّي عليمُ",59,"م",1,0],["وانتبَه الصبحُ بُعَيْدَ الكرى","كذي هوىً مِن غَشيَةٍ قد أَفاق",60,"ق",1,0],["وأنتِ بينهمْ في كلِّ منزلةٍ","صفرُ اليسارِ بهِ يستكملُ العددُ",61,"د",1,0],["وَإن تَبكِ مَيتاً ضمَّهُ القَبرُ فادَّخِر","لِمَيتٍ عَلى قيدِ الحياةِ دُموعا",62,"ع",2,0],["وأنت بها يا بن النبي محمد","أحَقّ إذا ما بانت الحُجَجُ الزُهْر",63,"ر",1,0],["وَأَنتَ بِالقُربِ إِلى جانِبي","أَحسَن مِن حَسناءَ تَحتَ الحُلى",64,"ل",2,0],["وأنت بميدان السياسة سابق","متى جاءك الأقطاب منهم تكهربوا",65,"ب",3,0],["وإن تبعوا الهوى بالطوع شحّاً","وإعجاباً لرأيٍ في المحاضر",66,"ر",1,0],["وَأَنتَ بِما نَفَثتُ بِهِ خَبيرٌ","فَكَيفَ أُنَبِّئُ الفَطنَ الخَبير",67,"ر",1,0],["وَأَنتَ بَدرُ المَعالي في أُفقِ مَنزِلِنا","وَالبَدرُ في السَيرِ لا يَعدو مَنازِلَهُ",68,"ه",1,0],["وَأَنتَ بِالسَعدِ أَرخَ","عامَ سَني لِأَحمَدِ",69,"د",1,0],["وأنت بمعنى الغيب أدرى فطالما","فَرَرت إلى تحقيقه من تظَنُّني",70,"ي",1,0],["وأنت بما نكابِدُه","من الالام لا تدري",71,"ي",1,0],["وانتبهنا أنا ونفسي من الحُل","مِ وكم ضاع فيه يومى وأمسي",72,"ي",1,0],["وَاِنتِباهي في مَنامي","وَاِعتِرافي في جُحودي",73,"د",2,0],["وَإِن تَبَسَّطَ بَعدَ القَومِ خَطوُهُمُ","مَدَّت إِلَيهِ الخُطا الخَطِّيَّةُ السُلُبُ",74,"ب",1,0],["وَأَنتَ بِحَمدِ اللَهِ أَعدَلُ حاكِمٍ","فَلا تَرفَعَنَّ الحَجرَ عَن سَفَهِ الدَهرِ",75,"ر",1,0],["وَأنتِ بَعَثتِ لَهُ سَلوَةً","تَسُلُّ الهَوى أَوَّلاً أَوَّلا",76,"ل",2,0],["وأنت بإنطاكيةٍ كنتَ دافعاً","عن الدين قبلاً من عدوٍّ معاند",77,"د",1,0],["وَإِن تَبقني الأَشواق لِلحُزن وَالضَنا","أَعش كاسِفاً بالي بِهَمٍّ وَاوجال",78,"ل",1,0],["وَإِن تَبغِ إِتلافي فَفي الدَهر مقنع","يَسوق الرَدى لِلحَرّ بِالهَم وَالحُزن",79,"ن",1,0],["وأنْتَ بإخلافِ المواعيد في الورى","عُرفْتَ ولَمْ يُعرَفْ بإخلاف مَوعدِ",80,"د",1,0],["وأنت بمعزل عن ذا وهذا","فقل لي ما اتخذت لك الملاذا",81,"ذ",2,0],["وأنت بحمد اللّه قد فزت بالهدى","عليك سلام من رشيد ومرشد",82,"د",1,0],["وإن تباعدت الأقطار بينهما","بالشام شخص وفي صنعا مقام أبي",83,"ب",2,0],["وأنت بالله لا بالجيش منتصر","فيا لمستنصر بالله منتصر",84,"ر",1,0],["وأَنْتَ بَحْرُ الندى لَمْ يَأْلُ أَنْ عَذُبا","وأَنتَ حِزْبُ الهُدى لَمْ يَعْدُ أَنْ غَلَبا",85,"ب",2,0],["وأَنْتَ بسَمْعِ رَأْفَتِهِ سَمِيعٌ","لَهُمْ وبِعَيْنِهِ فِي العَطْفِ راءِ",86,"ا",2,0],["وأَنت بميراثِهِنَّ المحيطُ","لأَنكَ فِيهَا الوسيطُ الصَّميمُ",87,"م",1,0],["وإِنْ تَبْرَمِ الأَيْسَارُ فِي أَزَمَاتِهِمْ","فأَحْبِبْ بِأَيْسارٍ قَمَرْتُ لَهُمْ يُسْرِي",88,"ر",2,0],["وأنت بأخفاف الملاكد واقف","وطرفك مطروف وعنسك ظالع",89,"ع",1,0],["وأنت بها الرؤوف وإن أساءت","فلطفك للأسى فيها أساها",90,"ا",3,0],["وأنت بقيت لي الذخر المرجى","تجمل لي بحبك كل شيء",91,"ي",2,0],["وأنت بهاءُ الدين من غير مِرْيَةٍ","له منكَ رُكْنٌ راسِخٌ ودَعائمُ",92,"م",1,0],["وَإِن تَبَدَّت وَجُنحُ اللَيلِ مُعتَكِرٌ","عادَ الصَباحُ كَأَنَّ الشَمسَ لَم تَغِبِ",93,"ب",1,0],["وأَنت بالسُوّر السبع الطِوال على","كلِّ الورى حاكمٍ باللَه محكومِ",94,"م",1,0],["وأَنْتَ بحرٌ إِلهيٌّ أُقيمَ على","شِراعِ إحْسانِهِ المَمْلوكُ والمَلِكُ",95,"ك",1,0],["وإن تبخل الدنيا بتأليف جمعنا","فرأي المقام الناصري جم