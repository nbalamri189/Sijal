,"https://www.poetsgate.com/ViewPoem.aspx?id=53584",""],[5691,"شهيد الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=206246",""],[5717,"ومن شرائط النبي حمله","https://www.poetsgate.com/ViewPoem.aspx?id=170604",""],[5718,"صحابة أحمد","https://www.poetsgate.com/ViewPoem.aspx?id=213795",""],[5720,"تَهَامِيَّةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=204870",""],[5742,"رثاء الأماجد","https://www.poetsgate.com/ViewPoem.aspx?id=206966",""],[5776,"جيرون والباهوت","https://www.poetsgate.com/ViewPoem.aspx?id=205842",""],[5816,"( العبيرية ) في وصف الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=125964",""],[5818,"وإن باعوك","https://www.poetsgate.com/ViewPoem.aspx?id=186921",""],[5839,"لكِ الله..","https://www.poetsgate.com/ViewPoem.aspx?id=62047",""],[5937,"باحثٌ عن أناهُ في مابعد الحداثة","https://www.poetsgate.com/ViewPoem.aspx?id=211893",""],[6167,"لا رجعية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85486&r=&rc=15",""],[201,"لاالروض روض ولا الصهباء صهباء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65315&r=&rc=18",""],[6317,"هذا الجمال !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86083&r=&rc=1",""]],"verses":[["وَفي جانِبِ الماءِ الَّذي كانَ يَبتَغي","بِهِ الرِيَّ دَبّابٌ إِلى الصَيدِ عَالِمُ",0,"م",1,0],["وَفي جَمعِها نقصٌ وَتَصحيفُ عكسه","يَكونُ لَهُ صيتٌ وَلَيسَ لَهُ ذِكرى",1,"ر",2,0],["وفي جبل الفتح اجتَنَوْهُ تفاؤلاً","بفَتْح لباب الوصل يمنح عَطْفَهُ",2,"ف",2,0],["وفي جيده طوقٌ لنعماك لازِبٌ","أبى ربُّه إلا قيامَ شهودِهِ",3,"د",2,0],["وفي جودِ إبراهيم طال بقاؤه","لنا عِوض مُعتاضُهُ غير خاسِر",4,"ر",1,0],["وَفي جَوانِحِكَ اللاتي سَمَحتَ بِها","فَلَو تَرَفَّقتَ لَم تَسمَح بِأَعضائي",5,"ي",1,0],["وَفي جيدِ الخَميلَةِ مِنهُ عِقدٌ","وَفي آذانِها قُرطٌ وَسَلسُ",6,"س",1,0],["وَفي جودِ كَفَّيكَ ما جُدتَ لي","بِنَفسي وَلَو كُنتُ أَشقى ثَمودِ",7,"د",1,0],["وَفي جودِهِ بِالبَحرِ وَالبَحرُ لَو رَمى","إِلى ساعَةٍ مِن جودِهِ ما وَفى بِها",8,"ب",3,0],["وفي جُسومٍ كخَيطِ العاج ماثلةٍ","تُغْنِي النواظرَ عن حُسنِ التَّماثيلِ",9,"ل",1,0],["وَفي جَميلِ القُنوعِ يَنخَفِضُ ال","عَيشُ وَبِالحِرصِ يَعظُمُ التَعَبُ",10,"ب",1,0],["وَفي جَحدَرٍ لُؤمٌ وَفي آلِ مَسمَعٍ","صَلاحٌ وَلَكِن دِرهَمُ القَومِ كَوكَبُ",11,"ب",1,0],["وفي جريحٍ أعزلٍ تحتمي","من أي هولٍ هي لم تعلمِ",12,"م",1,0],["وَفِي جِدٍّ وَفِي هَزْلٍ تَجَلَّتْ","لَهُ فَطِنٌ بِهَا بِدَعٌ ضُرُوبُ",13,"ب",1,0],["وَفِي جَلاَ الصَّبَاحِ أَبْدَتْ","قُرَّةَ عَيْنٍ لِكُلِّ رَاءِ",14,"ا",2,0],["وَفِي جِهَادِكِ لَمْ تَأْلِي مُرَاعِيَة","مَا لِلعُرُوبَةِ مِنْ إِصْرٍ وَمِنْ نَسَبِ",15,"ب",1,0],["وَفي جِوارِكَ أَحبَب","تُ مَضجَعي لَو مَهَدتُه",16,"ت",2,0],["وفي جَانبي غَورِ الغَدِيرِ مَرَابِعٌ","دَوَارِسُ هِىَّ الدّاءُ لِى وَهِىَ الدَّوا",17,"و",2,0],["وفي جَلهَتَى ذَاتِ الجِمَالِ ونَعفِهَا","إِلَى مُلتَوَى الوَعسَاءِ مِن حَيثُ مَا التَوَى",17,"و",2,0],["وفي جانَبيْ ذاك الخليج مَرابعٌ","سحبت بها ذيل الصِّبا والصِّبا بُرْدِى",18,"د",2,0],["وَفي جزءِ شَعبانٍ من العامِ نفسهِ","بِبيروت للإسلامِ قد جوّزَ الكفرا",19,"ر",2,0],["وفي جحيمِ الجوى نفسٌ معذّبةٌ","وما لطَرفيَ مذ فارقت إغفاءُ",20,"ا",2,0],["وَفيِ جَهْرِي وَفيِ هَجْزِي","وَفيِ هَدْئِي وَفيِ رَهْزِي",21,"ز",2,0],["وفي جمل الناس غلمانهم","وليس سوائي في جملتي",22,"ت",2,0],["وفي جيدها عَقدُ درّ ثمينٍ","إذا برزت في الظلامِ أنارا",23,"ر",2,0],["وفي جرجانَ عزَّتهُ قليلاً","فلم يعبأ بأعمالِ البريد",24,"د",1,0],["وَفي جهنم نار","لَها العصاة وقود",25,"د",1,0],["وَفي جَمعٍ مالَ خَوفَ فَقرَ فَأَصبَحوا","وَقَد لَبِسوا قَمصاً مِنَ الجُبنِ وَالبُخلِ",26,"ل",1,0],["وفي جوفها تستكنّ الهموم","وتنسلُ حياتها الزاحفة",27,"ه",1,0],["وفي جوفها مثل عمقِ الفضاء","إذا سوّرَتهُ رؤوس الجبال",28,"ل",1,0],["وفي جيدِهِ ما صِيغَ من مثْلِ لَوْنِه","قلائدُ والَى نَظْمَها فيهِ ناظِم",29,"م",1,0],["وفي جُودِ عَبدِ اللَّهِ ما رَدَّ صَرفَها","كَما لا يُحبُّ الدَّهر مُنصَرَفاً عَنِّي",30,"ن",2,0],["وفي جمع الجوامع نقل قول","بأن البحث فيه من الحرام",31,"م",1,0],["وفي جسمي سقام عيون خشف","عدت منها لي الداء العضالا",32,"ل",2,0],["وَفي جَفنَةٍ ما يُغلَق البابُ دونها","مُكلَّلةٍ لَحماً مُدَفِّقةٍ ثَردا",33,"د",2,0],["وفي جيدِ زنجيِّ الدجى من خلاله","وأنجمُهُ طوقٌ له وقلائدُ",34,"د",1,0],["وَفِي جبينِكَ سِيَما المُلْكِ قَدْ بَهَرَتْ","وَفِي يمينِكَ قِدْحُ الحقِّ قَدْ فَلَجا",35,"ج",2,0],["وفي جانب الوادي حمامة أيكة","من الوُرْق تشكو البَيْن في الورَق الخُضر",36,"ر",1,0],["وفي جميع ناحيها كأن بها","لذكرك السمح تقديسا وتاليها",37,"ي",3,0],["وفي جميع مباديها التي انتشرت","فرنّحت أمما شتى مباديها",37,"ي",3,0],["وفي جَوِّ عجلٍ إذا أعتمتْ","وضلَّتْ نجومُ هُدىً تَزْهَرُ",38,"ر",1,0],["وَفي جِنانِكَ أَمسى","هِلالُ عِزِّيَ بَدرا",39,"ر",2,0],["وفي جلساته جلس السروجي","وحيانا نثيره والنظيم",40,"م",1,0],["وفي جبينك نور من نبوته","وشاهد الحق لا تخفى دلائله",41,"ل",2,0],["وفي جَحيمةِ قَلبُ الصَّبِّ مُحتَرِقٌ","وها رَمادُه في الألحاظِ ذو شَرَرِ",42,"ر",1,0],["وفي جوَارِك قَلْبي فَارْعَ حُرمَتَه","وقد عَهدْتُك تَرعَى حُرمَةَ الجَارِ",43,"ر",1,0],["وفي جبل الصعود صعدت منه","إلى الأعلى رقى عيسى رقيه",44,"ي",2,0],["وفي جوارِ الحسين السبط منزلهُ","داراً تفيض عليها دائماً سحبُ",45,"ب",1,0],["وفي جلل الإجلال عج عجاجها","وقد أعجز الإعجاز منها علاجها",46,"ه",2,0],["وفي جهلنا عين اليقين بحقه","وجدناه منا قاب قوسين أو أدنى",47,"ن",2,0],["وَفي جانب الكوبريّ لاحَت بروجها","عَلَيها مَدار الأَمن في كُل لحظة",48,"ه",1,0],["وفي جهَازِها الفاخِ","رِ منْ لِبْدٍ ومنْ نِطْع",49,"ع",1,0],["وَفي جَميلِ مَنظَرٍ بَهي","يسلي فُؤادَ الحزنِ الشَّجي",50,"ي",1,0],["وفي جَوانبه عينُ الحياة فمن","يشرب بها فهو حيُّ الحال يزدانُ",51,"ن",1,0],["وَفِي جَفِيرِ النَبْلِ حَشرَاتُ الرَشَقْ","سَاوَى بِأَيْديهِنَّ مِنْ قَصْدِ اللَمَقْ",52,"ق",1,0],["وفي جنان المزيد","عسى من الخالدين",53,"ن",1,0],["وفي جواب اسم لفعل أو خبر","فليس إلا الرفع بعد الفا يقَر",54,"ر",1,0],["وفي جواب الشرط ثم التابعه","لمفرد إو جملة في السابعه",54,"ه",1,0],["وفي جواب قسم كالواقعه","بالصدر في ياسين أو في الواقعه",54,"ه",1,0],["وفي جزى تقديم مضمر حكم","ومثله في بيته يؤتى الحكم",55,"م",1,0],["وَفِي جُرُفَي رَوضٍ هُنَاكَ تَجَافَيَا","بِنَهرٍ يَوَدُّ الأُفقُ لَو زَارَهُ فَجرا",56,"ر",2,0],["وفي جامع المعيار من ذاك مقنعٌ","ونص بأنوار الفروق منوّر",57,"ر",1,0],["وفي جبيرين اذ صفوا بزحفهم","ولوا خزايا وقد فلوا وقد قهروا",58,"ر",3,0],["وفِي جُنْحِ لَيلٍ أدْلَجَتْ مُسْتَعِدَّةً","تُرَاقِب مُجْريهِ بِعَينِ المْرَاقِبِ",59,"ب",1,0],["وفي جذعاتها خمسٌ وسبعٌ","عن الثنياء ليس بحد قودٍ",60,"د",1,0],["وَفي جُيوشك بَأس عز مرغمه","وَفي جَنانك جَيش لَيسَ ينهَزم",61,"م",1,0],["وفي جمع وخيف مني","لعمرك مجمع الهمم",62,"م",1,0],["وَفي جَنابِكَ مِن عِزٍّ وَمِن شَرَفٍ","وَفي رِحابِكَ مِن أَهلٍ وَمِن نَعَمِ",63,"م",1,0],["وَفي جَبينكَ مِن شَمسٍ وَمِن قَمَر","وَفي يَمينِكَ مِن بَحرٍ وَمِن دِيَمِ",63,"م",1,0],["وفي جلها أن المطيع لأمرهم","سينجو إذا ما حاق في غيره المكر",64,"ر",1,0],["وَفي جانِبِ الماء الَّذي تَرِدينَهُ","مَواعيدُ ما يُنكِرنَ ليّاً وَلا خُلفا",65,"ف",2,0],["وَفي جَفنها الوَسنان سَيف وَسائف","وَفي قَدّها المنآد رمح رامح",66,"ح",1,0],["وفي جُمجُمَه والبادرانِ قياسُهم","أصابعُ خمسٌ نُفِّسَت بالأمايِر",67,"ر",1,0],["وفي جنوبي جاوةٍ والصينِ","والفالِ علماً صادقَ اليقينِ",68,"ن",1,0],["وَفي جرابِ أَبي هرٍ عَجائب كَم","يَمتار مِنهُ فَمأكولٌ وَمَبذولُ",69,"ل",1,0],["وفي جنباتها زهر","كألسنة العصافير",70,"ر",1,0],["وفي جوّه صدح الكروان","ينادي على بعده تائمه",71,"م",2,0],["وفي جنبات الروض نهرٌ ودوحةٌ","يروقك منها سندسٌ ونضار",72,"ر",1,1],["وفي جبين هاشم","والمجد ذلاً وسما",73,"م",2,0],["وفي جفونِ مدير الراح ترجمةٌ","تنبي بلطف الذي من صرفها اصطبحا",74,"ح",2,0],["وفي جوفها للعَبد أستَرُ منزلٍ","وفي ظهرها يَقضِي فرائضَه العبدُ",75,"د",1,1],["وفي جبَل الفتْحَينِ كمْ جدَّ عزْمُهُ","سِباقاً إلى داعِي الهُدَى وتسرُّعا",76,"ع",2,0],["وَفِى جوَابِ كَيفَ زَيدٌ قُل دَنِف","فَزَيدٌ استُغنِىَ عَنهُ إذ عُرِف",77,"ف",1,0],["وَفِى جَمِيعِهَا تَوَسُّطَ الخَبَر","أجِز وَكُلٌّ سَبقَهُ دَامَ حَظَر",77,"ر",1,0],["وفي جميع ما ذكرنا عبره","لمن له دراية وخبره",78,"ه",1,0],["وفي جلق واعٍ، وفي القدس شاخصٌ","وفي برقة شادٍ يجاوب شاديا",79,"ي",2,0],["وَفي جَنابِكَ وُدٌّ لا يُغَيِّرُهُ","عَلى مُرور اللَيالي حادِثُ الغِيَرِ",80,"ر",1,0],["وفي جَنَّةٍ طُوبى بِدَارِهِ دَلَّلَت","فُرُوعاً بِدُورِ الكُلِّ مُبدِيَةً رُوَا",81,"و",2,0],["وَفِي جَامِعِ السُّلطَانِ أظهَرَ جِدَّهُ","وَأبرَزَ تَقرِيراً بِلَبَّتِهِ دُراَّ",82,"ر",2,0],["وفي جميع الليلِ بل بوقتي","هذا أجبْ دعائي لا بمقتِ",83,"ت",1,0],["وفي جنة الفردوس فاجعل دخولنا","وفي وجهك الأعلى إلهي ننظرُ",84,"ر",1,0],["وفي جبينك من رقمي ظبى وقنا","حروف مجد خلت من مثلها الكتب",85,"ب",1,0],["وَفي جيدها قطر كان بجيدها","عقودا كَما تَدري بها تتجمل",86,"ل",1,0],["وَفي جَذبِ أَنواعِ الحَديدِ لِبَعضِهِ","بِقُوَّة تَأثيرِ غَرامٍ بِلا رِيَبِ",87,"ب",1,0],["وفي جنة الفردوس منزل زايدٍ","ورضوانُ غادٍ بالعطايا وآيبُ",88,"ب",1,0],["وفي جل عن من ومين","إذا الموفون والكرماء مانوا",89,"ن",3,0],["وفي جوابٍ وفي نفيٍ وأدعيةٍ","بذاك واضعُ حُكمِ النطق قد حتما",90,"م",2,0],["وَفي جلَّق قامَت عَلَينا عصابَةٌ","تَكيد لَنا كيد العدوِّ المحارِبِ",91,"ب",1,0],["وفي جهة العطا بحرٌ خضمٌّ","وهل بحرٌ تنقصه الدلاءُ",92,"ا",2,0],["وفي جيدهِ السبع السواري تنضدت","لتلبسَهُ طوقاً فألبسها حليا",93,"ي",2,0],["وفي جمع ذا الديوان قد قام نجله","ففاز وحاز الشكر مع وافر الاجر",94,"ر",1,0],["وفي جسمِها الناريّ كانت جهنّمٌ","تطهّرُ إيماني به وتجددُ",95,"د",1,0],["وفي جنبَيَّ دقاق رهيف","عيون الغيد صادته فهاما",96,"م",2,0],["وفي جمع شمر كاسبين النواميس","اقبلت معطي ما قبلت العطايا",97,"ا",3,0],["وفِي جدرانِ مدرستي وعَينَيْ","معلمتي كما الأمواهُ زُرقا",98,"ق",2,0],["وَفِيْ جَبَلِ السُّمَّاْقِ جَاْلَتْ خُيُوْلُنَاْ","فَمَاْ غَاْدَرَتْ يَوْماً مَمَراًّ لِحَاْئِدِ",99,"د",1,0],["وَفِيْ جَرْجَنَاْزَ يَثُوْرُ الْكِرَاْمُ","لِصَدِّ اللِّئَاْمِ جُنَاْةِ الْوَزَرْ",100,"ر",1,0],["وفي جواهرِها النوراء ِ بصمتُها","بها تداوَى النَّدى والغيثُ والزهرُ",101,"ر",1,0],["وفي جملتي كلُّ فعلٍ سناءْ","وأجعلُ فاعلَ فعلي سناءْ",102,"ن",3,0],["وفي جُعْبتيْ ليلٌ تقهقرَ بدرُهُ","فلمّا أرادوا نَومَهُ أيْقَظَ الشَّمْعا",103,"ع",2,0],["وفي جنباتِها كمْ همتُ حبَّاً","وبتُّ بهنَّ منْ شوقي وحيدا",104,"د",2,0],["وفي جنبي همة لوذعي","وفي كفي بتار صقيل",105,"ل",1,0],["وَ فِي جُبَّةِ الحَلَّاجِ أَجْمَعُ فُرْقَتِي","لأَرْقُصَ مِنْ فَرْطِ الشَّتَاتِ تَرَنُّحَا",106,"ح",2,0],["وفي جريدِ سَعْف ِ بُستانهِ","خط َّ لنا سِفرَيْهِما ( الأحمدانْ ) (5)",107,"ن",1,0],["وفي جَبينِكَ أنْوارٌ تُطالِعُنا","لَها على غُرَّةِ الجَوْزا