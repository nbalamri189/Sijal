{"poems":[[24,"وهاجرة لا تستريد ظباؤها","https://www.aldiwan.net/poem21882.html","الطويل"],[71,"ومملوكة عندي حديث نتاجها","https://www.aldiwan.net/poem3851.html","الطويل"],[83,"يقر بعيني أن أرى الزهر يانعا","https://www.aldiwan.net/poem54271.html","الطويل"],[51,"قدمت قدوم البدر بيت سعوده","https://www.aldiwan.net/poem61823.html","الطويل"],[51,"يضن أبو عيسى علينا بقطنة","https://www.aldiwan.net/poem62850.html","الطويل"],[85,"سويجع النيل رفقا بالسويداء","https://www.aldiwan.net/poem63685.html","البسيط"],[85,"تحية شاعر يا ماء جكسو","https://www.aldiwan.net/poem63712.html","الوافر"],[43,"أيا خدد الله ورد الخدود","https://www.aldiwan.net/poem9535.html","المتقارب"],[45,"معاد من الأيام تعذيبنا بها","https://www.aldiwan.net/poem10908.html","الطويل"],[61,"إذا المجرة مالت بعد تعديل","https://www.aldiwan.net/poem51485.html","البسيط"],[49,"من لم يعظه التجريب والأدب","https://www.aldiwan.net/poem10379.html","المنسرح"],[50,"أصفراء ما في العيش بعدك مرغب","https://www.aldiwan.net/poem64815.html","الطويل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125622","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54628","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54512","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54641","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43667","المجتث"],[130,"أراحت لقلبي عازب الهم والهوى","https://www.aldiwan.net/poem54687.html","الطويل"],[183,"أأحبابنا بالثغر ما كان من بعدي","https://www.aldiwan.net/poem14497.html","الطويل"],[187,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[195,"لا الروض روض ولا الصهباء صهباء","https://www.aldiwan.net/poem39803.html","البسيط"],[235,"تعززت بذي العز","https://www.aldiwan.net/poem18832.html","الهزج"],[254,"خليلي قد اتسعت محنتي","https://www.aldiwan.net/poem48498.html","المتقارب"],[268,"فتاتي الصغيرة تهوى النقارا","https://www.aldiwan.net/poem35454.html","المتقارب"],[268,"شربناها على ذكر الوليد","https://www.aldiwan.net/poem35590.html","الوافر"],[269,"تنبهوا يا رقود","https://www.aldiwan.net/poem52048.html","المجتث"],[302,"أقوم بفرض العامرية والنفل","https://www.aldiwan.net/poem16749.html","الطويل"],[326,"أراقت عليها معاني الفناء","https://www.aldiwan.net/poem54979.html","المتقارب"],[326,"غفا بعد أن مرت الزوبعه","https://www.aldiwan.net/poem54994.html","المتقارب"],[362,"أتلك رياض أم خدود نواعم","https://www.aldiwan.net/poem60665.html","الطويل"],[369,"أرى نوب الأيام تجني ولا أرى","https://www.aldiwan.net/poem57007.html","الطويل"],[400,"لقد صدرت إلى أعلى مقام","https://www.aldiwan.net/poem33449.html","الوافر"],[413,"سطا بحسام مقلته وصالا","https://www.aldiwan.net/poem54125.html","الوافر"],[417,"يعاتبني في الدين قومي وإنما","https://www.aldiwan.net/poem4848.html","الطويل"],[429,"أما إنه لولا الخيال المعاود","https://www.aldiwan.net/poem12609.html","الطويل"],[436,"ما أطبق الهم إلا ريثما انفرجا","https://www.aldiwan.net/poem34794.html","البسيط"],[450,"إِذا ما مضى للمرء يوم من البشر","https://www.aldiwan.net/poem13763.html","الطويل"],[451,"مؤسس الدولة المرهوب جانبها","https://www.aldiwan.net/poem61383.html","البسيط"],[456,"أدمعك أم عارض ممطر","https://www.aldiwan.net/poem56182.html","المتقارب"],[466,"يا سهل سهلت عيشي","https://www.aldiwan.net/poem60027.html","المجتث"],[477,"أدرها من سلافك يا نديم","https://www.aldiwan.net/poem37037.html","الوافر"],[513,"تقبل الله صوماً أنت واصله","https://www.aldiwan.net/poem12203.html","البسيط"],[536,"رأيتها وهى في سيارة السفر","https://www.aldiwan.net/poem48165.html","عموديه"],[573,"يا ساكناً بين جنات وأنهار","https://www.aldiwan.net/poem2784.html","البسيط"]],"verses":[["وَفي جانِبِ الماءِ الَّذي كانَ يَبتَغي","بِهِ الرِيَّ دَبّابٌ إِلى الصَيدِ عَالِمُ",0,"م",1,0],["وَفي جَمعِها نقصٌ وَتَصحيفُ عكسه","يَكونُ لَهُ صيتٌ وَلَيسَ لَهُ ذِكرى",1,"ر",2,0],["وفي جبل الفتح اجتَنَوْهُ تفاؤلاً","بفَتْح لباب الوصل يمنح عَطْفَهُ",2,"ف",2,0],["وفي جيده طوقٌ لنعماك لازِبٌ","أبى ربُّه إلا قيامَ شهودِهِ",3,"د",2,0],["وفي جودِ إبراهيم طال بقاؤه","لنا عِوض مُعتاضُهُ غير خاسِر",4,"ر",1,0],["وَفي جَوانِحِكَ اللاتي سَمَحتَ بِها","فَلَو تَرَفَّقتَ لَم تَسمَح بِأَعضائي",5,"ي",1,0],["وَفي جيدِ الخَميلَةِ مِنهُ عِقدٌ","وَفي آذانِها قُرطٌ وَسَلسُ",6,"س",1,0],["وَفي جودِ كَفَّيكَ ما جُدتَ لي","بِنَفسي وَلَو كُنتُ أَشقى ثَمودِ",7,"د",1,0],["وَفي جودِهِ بِالبَحرِ وَالبَحرُ لَو رَمى","إِلى ساعَةٍ مِن جودِهِ ما وَفى بِها",8,"ب",3,0],["وفي جُسومٍ كخَيطِ العاج ماثلةٍ","تُغْنِي النواظرَ عن حُسنِ التَّماثيلِ",9,"ل",1,0],["وَفي جَميلِ القُنوعِ يَنخَفِضُ ال","عَيشُ وَبِالحِرصِ يَعظُمُ التَعَبُ",10,"ب",1,0],["وَفي جَحدَرٍ لُؤمٌ وَفي آلِ مَسمَعٍ","صَلاحٌ وَلَكِن دِرهَمُ القَومِ كَوكَبُ",11,"ب",1,0],["وفي جريحٍ أعزلٍ تحتمي","من أي هولٍ هي لم تعلمِ",12,"م",1,0],["وَفِي جِدٍّ وَفِي هَزْلٍ تَجَلَّتْ","لَهُ فَطِنٌ بِهَا بِدَعٌ ضُرُوبُ",13,"ب",1,0],["وَفِي جَلاَ الصَّبَاحِ أَبْدَتْ","قُرَّةَ عَيْنٍ لِكُلِّ رَاءِ",14,"ا",2,0],["وَفِي جِهَادِكِ لَمْ تَأْلِي مُرَاعِيَة","مَا لِلعُرُوبَةِ مِنْ إِصْرٍ وَمِنْ نَسَبِ",15,"ب",1,0],["وَفي جِوارِكَ أَحبَب","تُ مَضجَعي لَو مَهَدتُه",16,"ت",2,0],["وفي جَانبي غَورِ الغَدِيرِ مَرَابِعٌ","دَوَارِسُ هِىَّ الدّاءُ لِى وَهِىَ الدَّوا",17,"و",2,0],["وفي جَلهَتَى ذَاتِ الجِمَالِ ونَعفِهَا","إِلَى مُلتَوَى الوَعسَاءِ مِن حَيثُ مَا التَوَى",17,"و",2,0],["وفي جانَبيْ ذاك الخليج مَرابعٌ","سحبت بها ذيل الصِّبا والصِّبا بُرْدِى",18,"د",2,0],["وَفي جزءِ شَعبانٍ من العامِ نفسهِ","بِبيروت للإسلامِ قد جوّزَ الكفرا",19,"ر",2,0],["وفي جحيمِ الجوى نفسٌ معذّبةٌ","وما لطَرفيَ مذ فارقت إغفاءُ",20,"ا",2,0],["وَفيِ جَهْرِي وَفيِ هَجْزِي","وَفيِ هَدْئِي وَفيِ رَهْزِي",21,"ز",2,0],["وفي جمل الناس غلمانهم","وليس سوائي في جملتي",22,"ت",2,0],["وفي جيدها عَقدُ درّ ثمينٍ","إذا برزت في الظلامِ أنارا",23,"ر",2,0],["وفي جرجانَ عزَّتهُ قليلاً","فلم يعبأ بأعمالِ البريد",24,"د",1,0],["وَفي جهنم نار","لَها العصاة وقود",25,"د",1,0],["وَفي جَمعٍ مالَ خَوفَ فَقرَ فَأَصبَحوا","وَقَد لَبِسوا قَمصاً مِنَ الجُبنِ وَالبُخلِ",26,"ل",1,0],["وفي جوفها تستكنّ الهموم","وتنسلُ حياتها الزاحفة",27,"ه",1,0],["وفي جوفها مثل عمقِ الفضاء","إذا سوّرَتهُ رؤوس الجبال",28,"ل",1,0],["وفي جيدِهِ ما صِيغَ من مثْلِ لَوْنِه","قلائدُ والَى نَظْمَها فيهِ ناظِم",29,"م",1,0],["وفي جُودِ عَبدِ اللَّهِ ما رَدَّ صَرفَها","كَما لا يُحبُّ الدَّهر مُنصَرَفاً عَنِّي",30,"ن",2,0],["وفي جمع الجوامع نقل قول","بأن البحث فيه من الحرام",31,"م",1,0],["وفي جسمي سقام عيون خشف","عدت منها لي الداء العضالا",32,"ل",2,0],["وَفي جَفنَةٍ ما يُغلَق البابُ دونها","مُكلَّلةٍ لَحماً مُدَفِّقةٍ ثَردا",33,"د",2,0],["وفي جيدِ زنجيِّ الدجى من خلاله","وأنجمُهُ طوقٌ له وقلائدُ",34,"د",1,0],["وَفِي جبينِكَ سِيَما المُلْكِ قَدْ بَهَرَتْ","وَفِي يمينِكَ قِدْحُ الحقِّ قَدْ فَلَجا",35,"ج",2,0],["وفي جانب الوادي حمامة أيكة","من الوُرْق تشكو البَيْن في الورَق الخُضر",36,"ر",1,0],["وفي جميع ناحيها كأن بها","لذكرك السمح تقديسا وتاليها",37,"ي",3,0],["وفي جميع مباديها التي انتشرت","فرنّحت أمما شتى مباديها",37,"ي",3,0],["وفي جَوِّ عجلٍ إذا أعتمتْ","وضلَّتْ نجومُ هُدىً تَزْهَرُ",38,"ر",1,0],["وَفي جِنانِكَ أَمسى","هِلالُ عِزِّيَ بَدرا",39,"ر",2,0],["وفي جلساته جلس السروجي","وحيانا نثيره والنظيم",40,"م",1,0],["وفي جبينك نور من نبوته","وشاهد الحق لا تخفى دلائله",41,"ل",2,0],["وفي جَحيمةِ قَلبُ الصَّبِّ مُحتَرِقٌ","وها رَمادُه في الألحاظِ ذو شَرَرِ",42,"ر",1,0],["وفي جوَارِك قَلْبي فَارْعَ حُرمَتَه","وقد عَهدْتُك تَرعَى حُرمَةَ الجَارِ",43,"ر",1,0]]}