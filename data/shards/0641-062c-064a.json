 الْحبّ قصتي","https://www.poetsgate.com/ViewPoem.aspx?id=188722",""],[5649,"ركب الخير","https://www.poetsgate.com/ViewPoem.aspx?id=39018",""],[5759,"مخامرة","https://www.poetsgate.com/ViewPoem.aspx?id=214731",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5854,"فصحى اللغات","https://www.poetsgate.com/ViewPoem.aspx?id=208608",""],[5861,"جدال الروح","https://www.poetsgate.com/ViewPoem.aspx?id=190862",""],[5937,"متحف الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=211894",""],[5984,"يا طلل الحىّ جادك الطّلل","https://www.poetsgate.com/ViewPoem.aspx?id=200383",""],[6102,"ظهيرة تحت رحمة الكهرباء","https://www.poetsgate.com/ViewPoem.aspx?id=184444",""],[6102,"وهم الحب","https://www.poetsgate.com/ViewPoem.aspx?id=185329",""],[6102,"لا كرامة لنبي في قومه ..","https://www.poetsgate.com/ViewPoem.aspx?id=186289",""],[6152,"استودع الله قلبك","https://www.poetsgate.com/ViewPoem.aspx?id=203393",""],[1453,"أحب النساء الصفر من اجل تكتم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=581732",""],[6189,"رسالة إلى أميرة الغرابة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83587&r=&rc=54",""],[6189,"الريحانة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83581&r=&rc=48",""],[6202,"رسالة إلى الكبيسي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86725&r=&rc=26",""],[3216,"أواه.. يا كسلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=67793&r=&rc=2",""],[6291,"فتوى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87670&r=&rc=3",""],[6315,"رُؤى على شفير الحداد !!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87579&r=&rc=4",""],[6366,"آتٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86672&r=&rc=1",""]],"verses":[["فَجِئتُكَ راكِباً صَهَواتِ دَهرٍ","كَثيرِ وَقائِعِ الجَدِّ العَثورِ",0,"ر",1,0],["فَجئنَ يا ساقياتِ الخَمرِ صافيَةً","بِها قُبَيلَ اِبتِسامِ الفَجرِ عَن كَثَبِ",1,"ب",1,0],["فَجِئناهُمُ قَسراً نَفودُ سَراتَها","كَما ذُبِّبَت مِنَ الجَمالِ المَصاعِبُ",2,"ب",1,0],["فَجِئنا عَلى عَمياءَ ما جَمَعوا لَن","بِأَرعَنَ لا خَلٍّ وَلا مُتَكَشِّفِ",3,"ف",1,0],["فَجِئنَ وَجاءَت في الظَلامِ تَأَطُّراً","كَمِثلِ المَها أَقبَلنَ يَمشينَ في الوَحلِ",4,"ل",1,0],["فَجِئتُكُمُ عَلى ظَمَإٍ لِأَروى","فَلَم يَكُ عِندَكُم بَلَلٌ لِصادِ",5,"د",1,0],["فَجِيَادُهُ لِلآمِلِينَ مَرَاكِبُ","وَخِيَامُهُ لِلْقَاصِدينَ أَرَائِكُ",6,"ك",1,0],["فجِئْتُ مَرينيَّ المَضا لمَنِ انْتَضى","وإنْ كنْتُ مَنسوبَ النِّجارِ الى الهِنْدِ",7,"د",1,0],["فَجِئتُكَ مُرتادَ ما خَبَّروا","وَلَولا الَّذي خَبَّروا لَم تَرَن",8,"ن",1,0],["فَجِئنَ فَأَوجَسنَ مِن خَشيَةٍ","وَلَم يَعتَرِفنَ لِنَفَرٍ يَقينا",9,"ن",2,0],["فَجِئتُ وَبي ما يَعلَمُ اللَهُ مِن أَسىً","وَمِن كَمَدٍ قَد شَفَّني وَبَراني",10,"ن",2,0],["فَجِئتَ بِهِ وَالناسُ قَد طالَ شَوقُهُمُ","إِلى أَلمَعِيٍّ بِالبَراهينِ يَصدَعُ",11,"ع",1,0],["فَجِئتُها بِحَديثٍ","أَسوقُهُ لِلجُلوسِ",12,"س",1,0],["فَجِئتُ وَقَد نَضَّت لِنَومٍ ثِيابَه","لَدى السِترِ إِلّا لِبسَةَ المُتَفَضِّلِ",13,"ل",1,0],["فَجِئنا عَلى خوصٍ كَأَنَّ عُيونَها","صَباباتُ زَيتٍ في أَواقي مِن صُفرِ",14,"ر",1,0],["فَجِئتِ وَقَد أَيقَنتُ أَن تَستَقيدَني","وَقَد طارَ قَلبي مِن عَدُوٍّ أُحاذِرُه",15,"ر",2,0],["فَجِئنَ وَقَد بُدِّلنَ حِلما وَصورَةً","سِوى الصورَةِ الأُولى وَهُنَّ ضَوامِرُ",16,"ر",1,0],["فَجِئ بِفَوارِسٍ كَالآلِ مِنكُم","إِذا التَمجيدُ أَنجَدَ ثُمَّ غارا",17,"ر",2,0],["فجئنا ولم يعي الصفار مطيّنا","كأن لم نكن سفراً على ظهرها ركبا",18,"ب",2,0],["فجّيِشوِا جيش علم من شبيبتنا","عرمرماً تضرِب الدنيا به المثلا",19,"ل",2,0],["فجئت وجسمي قد تغشتّه رجفة","كما يرجف المقرور من شدة البرد",20,"د",1,0],["فجئت أعاطيها العزاء وادمعي","كأدمعها تنهلّ منّي على النحر",21,"ر",1,0],["فَجِئنا وَقَد عادَت مَراعاً وَبَرَّكَت","عَلَيها مَخاضٌ لَم تَجِد مَن يُثيرُها",22,"ر",3,0],["فجئت أسعى على المحاجر والع","ين سعيداً رملي وإحساسي",23,"س",2,0],["فَجِئتُ مُستَلِماً إِلَيهِ","حَبلُ قِيادي بِكَفِّ سِلمي",24,"م",2,0],["فجئنا بالتي هيَ ضِد","دُها لتُلينَ ما صَعُبا",25,"ب",2,0],["فجئني برأيٍ يمْنَعُ الفُلْكَ جَرْيَها","ويمْلكُ غربَ اليعْمُلاتِ الرواسمِ",26,"م",1,0],["فَجِئنَ وَجاءَت بَينَهُنَّ وَإِنَّهُ","لَيَسمَحُ ذِفراها تَزَغَّمُ كَالفَحلِ",27,"ل",1,0],["فَجِئتُ بِتَخفيرِ الوَصيلِ وَشاعَني","أَخو الهَمِّ مِقدامٌ عَلى الهَولِ كَالصَقرِ",28,"ر",1,0],["فَجِئتُ أُغِذُّ السَيرَ حَتّى كَأَنَّني","لإفراط إِغذاذي عَلى أَظهُرِ النُجبِ",29,"ب",1,0],["فَجئتُ أُغِذُّ السَيرَ حَتّى كَأَنَّما","تَطيرُ بِسَيري في الفَلاةِ عُقابُ",30,"ب",1,0],["فجئته ادنى الخطى قابساً","ولم اخف صعقي لدى القبس",31,"س",1,0],["فجئت به سبط القوام شمردلا","فكان لعمري شر اعدائك اللد",32,"د",1,0],["فجئتكَ كيما أخبر الحال إنها","شجتني فمرني بالذي أنت طالبُ",33,"ب",1,0],["فجئناها بألوية صعاب","وجندنا الجنود لها ضروبا",34,"ا",1,0],["فَجِئتُ فَتاةَ التُركِ أَجزي دِفاعَها","عَنِ المُلكِ وَالأَوطانِ ما الحَقُّ يوجِبُ",35,"ب",1,0],["فَجِئناكَ دونَ الشَمسِ وَالبَدرِ في النَوى","وَدونَكَ في أَحوالِكَ الشَمسُ وَالبَدرُ",36,"ر",1,0],["فَجيعَةٌ مِن صُروفِ الدَهرِ مُعضِلَةٌ","لَو يَعلَمُ الدَهرُ فيها كُنهَ ماصَنعا",37,"ع",2,0],["فَجِئتُ مِنَ الجَنبِ الجَحيشِ وَقَد أَرى","مَخافَةَ مَن يَأتي الرَبابَ وَشَعفَرا",38,"ر",2,0],["فَجِئنا بِهِ مِن أَرضِ بَكرِ اِبنِ وائِلٍ","نَسوقُ قَصيرَ الأَنفِ حُرداً قَوادِمُه",39,"م",2,0],["فَجِئتَ أُقَيشِرَ الخَدَّي","نِ أَزرَقَ عارِمَ الذَنَبِ",40,"ب",1,0],["فَجِئتُكَ راكِباً أَمَلَ القَوافي","عَلى ثِقَةٍ مِنَ البَلَدِ البَعيدِ",41,"د",1,0],["فجيدُهُ أصلُ ما بي","والجيدُ لا يتغيرُ",42,"ر",1,0],["فَجِئتُ فَقُلتُ صَبٌّ زَل","لَ مِن واشٍ أَخي إِثمِ",43,"م",1,0],["فَجِئتُ أَمشي وَلَم يُغفِ الأُلى سَمَروا","وَصاحِبي هِندُوانِيٌّ بِهِ أُثُرُ",44,"ر",1,0],["فَجِئتُ مَجوداً بِالكَرى باتَ سَرجُهُ","وِساداً لَهُ يَنحاشُ أَن يَتَقَلَّبا",45,"ب",2,0],["فَجِئتُ عَلى خَوفٍ وَكُنتُ مُعَوِّذاً","أُحاذِرُ أَيقاظاً عُداةً وَنُوَّما",46,"م",2,0],["فَجِئتُ اِنسِلالَ السَيلِ أَقتارُ غِرَّةً","لَهُنَّ وَلي مِن أَن أَعِنَّ ذَريعُ",47,"ع",1,0],["فَجِئتُ قَسراً وَما نَفسِي بِناجِيَةٍ","إِذا دَعاها إِلى حينٍ مقاديرُ",48,"ر",1,0],["فِجِئنَ وَما يَكَدنَ إِذا اِرجَحَنَّت","بِها الأَعجازُ مِن ثِقَلٍ يَنُونا",49,"ن",2,0],["فَجِئتُ أَمشي عَلى هَولٍ أُجَشَّمُهُ","تَجَشُّمُ المَرءِ هَولاً في الهَوى كَرَمُ",50,"م",1,0],["فَجِئتُكَ مُعتَذِراً راجِياً","لِعَفوِكَ أَرهَبُ مِنكَ النِكالا",51,"ل",2,0],["فَجِئنَ أَمثالَ الأُكَر","لَم يَختَلِفنَ في الصُوَر",52,"ر",1,0],["فَجِئتُ عَلى خَوفٍ وَرُقبَةِ غائِرٍ","أُحاذِرُ حُرّاساً غِضاباً وَحُجّابا",53,"ب",2,0],["فَجِئْنا بالنِّهابِ وَبِالسَّبايا","وجاءُوا بالرِّجالِ مُصَفَّدِينا",54,"ن",2,0],["فجيئوا بمن ضَمَّتْ لُؤيُّ بن غالبٍ","وجيئوا بمن أدتْ كِنانَةُ والنَّضْر",55,"ر",1,0],["فجئتَ كما شئتَ من جانبَيك","فأنتَ الحياةُ وأنتَ الرّدى",56,"ا",1,0],["فَجِئتُ إِلى صَحبي بِظَبيٍ مُفَتَّقٍ","فَلَمّا تَراؤوا ضَوءَ خَدَّيهِ سَبَّحوا",57,"ح",3,0],["فَجِئتُ إِلَيكُمُ طَرَباً وَشَوقاً","فَما أَخطَأتُ دارَكُمُ بِدارِ",58,"ر",1,0],["فَجِئتَ كَبَغلِ السوءِ بَينَ عَرينَةٍ","وَبَينَ حِمارٍ حُطَّ عَنهُ مَزادُ",59,"د",1,0],["فَجِئتُ بِبَيعي مولِياً لا أَزيدُهُ","عَلَيهِ بِها حَتّى يَؤوبَ المُنَخَّلُ",60,"ل",1,0],["فَجِئنا إِلى الموتِ الصُهابيّ بَعدَما","تَجَرَّدَ عُريانٌ مِنَ الشَّرِّ أَخدَبُ",61,"ب",1,0],["فجئت تغصب منها ال","حقوق إذ أنت كهلُ",62,"ل",1,0],["فجئت إليه ناصراً ومؤازراً","وَدَمعي لإشفاقي عليه صَبيبُ",63,"ب",1,0],["فجئت بغداد ليلاً","على نزوح المزار",64,"ر",1,0],["فجئت وجوفَ الطبل يرغو وحوله","شباب وولدان عليه تجمعوا",65,"ع",3,0],["فجئتُ أُجريهِ دمعاً في يدي رجُلٍ","قد صاغه اللّه من حقٍّ وإِيمانِ",66,"ن",1,0],["فجئتُ للقبر بما يجملُ","من صُور الدنيا الفَتونِ الغَرورْ",67,"ر",1,0],["فَجِئنا عَلى عَمياءَ ما جَمَعوا لَنا","بِأَرعَنَ لا خَلٍّ وَلا مُتَكَشِّفِ",68,"ف",1,0],["فجِيعَةٌ فِي نَوْعِهَا فذَّةٌ","كأَنّهَا مِنْ بِدْعِهَا بِكْرُ",69,"ر",1,0],["فَجِئْتَ بِالآيَاتِ تَعْيَا دُونَهَا","عَزَائِمُ الجُمُوعِ لاَ الآحَاد",70,"د",1,0],["فجئنَا إلى هَوجٍ من البحرِ وَسْطَهُ","أحابيشُ منهمْ حَاسِرٌ ومقنّعُ",71,"ع",1,0],["فَجِئتُ وَقَد نَضَّت لِنَومٍ ثِيابَها","لَدى السِترِ إِلّا لِبسَةَ المُتَفَضِّلِ",72,"ل",1,0],["فجئت إليك كمن يلتجي","إلى واجه من جحيم الهجير",73,"ر",1,0],["فجيوش الجهاد تزحف للثأ","ر وتهفو إلى الحمى المنشود",74,"د",1,0],["فجئتُ بها مبغى أديبٍ مقدّرِ","ومنعى حسودٍ موَغرِ الصدرِ أخرق",75,"ق",1,0],["فجئن بأوفى من تُحلُّ له ال