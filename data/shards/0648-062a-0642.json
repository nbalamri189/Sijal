دا","https://www.poetsgate.com/ViewPoem.aspx?id=34092",""],[77,"وفعلك للصنع الجميل محالف","https://www.poetsgate.com/ViewPoem.aspx?id=34137",""],[77,"دعاكَ بأقصى المغربينِ غريبُ","https://www.poetsgate.com/ViewPoem.aspx?id=33820",""],[100,"فارس الاصطياف","https://www.poetsgate.com/ViewPoem.aspx?id=50417",""],[100,"يا نجوم","https://www.poetsgate.com/ViewPoem.aspx?id=50456",""],[18,"أثبت مرة والسيوف شواهر","https://www.poetsgate.com/ViewPoem.aspx?id=27779",""],[27,"وأَقبَّ كالسِّرحان تم له","https://www.poetsgate.com/ViewPoem.aspx?id=180957",""],[90,"يا بدرداجيَة الخطوب","https://www.poetsgate.com/ViewPoem.aspx?id=179157",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[90,"يدي هذه رهن","https://www.poetsgate.com/ViewPoem.aspx?id=179108",""],[90,"ناغيت لبنانا","https://www.poetsgate.com/ViewPoem.aspx?id=179224",""],[1,"لِخَوْلَةَ أَطْلالٌ بِبُرْقَةِ ثَهْمَدِ","https://www.poetsgate.com/ViewPoem.aspx?id=10033",""],[51,"يا قحطبي كما يقالُ وربما","https://www.poetsgate.com/ViewPoem.aspx?id=30756",""],[99,"مهرجة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=362&r=&rc=67",""],[20,"ليس شيء على المنون بباق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=70018&r=&rc=40",""],[88,"تذكرت في أوطاني الأهلَ والصحبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19533&r=&rc=36",""],[103,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""],[27,"حيوا أمامة َ واذكروا عهداً مضى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=16336&r=&rc=0",""]],"verses":[["وَتَقرو كُلَّ مَجهَلَةٍ","بِلا نَضَدٍ وَلا عَلَمِ",0,"م",1,0],["وَتَقتَرِنُ القَوارِعُ في جَنابي","قِرانَ النَبلِ في الغَرَضِ الرَجيمِ",1,"م",1,0],["وَتَقولُ لَمّا جِئتُ أَسأَلُها","كَيفَ الشِفاءُ لِداءِ ذي النَكسِ",2,"س",1,0],["وَتَقَعقَعَت بَينَ الكُلى قِصَدُ القَنا","فَكَأَنَّ كُلَّ حَشىً رِبابَةُ مَيسِرِ",3,"ر",1,0],["وَتُقبَلُ في سِواهُ مَتى","جَنى جُرماً مَعاذِرُه",4,"ر",2,0],["وَتَقرَبُ في قَبيلِ الفَضلِ مِنّي","عَلى بُعدِ القَبائِلِ وَالشُعوبِ",5,"ب",1,0],["وَتُقسَمُ هَذِهِ الأَرزاقُ فِينا","فَما نَدري أَتُخطيءُ أَم تُصيبُ",6,"ب",1,0],["وتَقْطَعُ عنْ حَيَّيْ نِزارٍ علائِقي","صُروف الليالي والخُطوبُ تَضيمُ",7,"م",1,0],["وتَقابَلَتْ غاياتُها فتَماثَلَتْ","حتّى تعَذّرَ بَينَها التفضيلُ",8,"ل",1,0],["وتَقاسَمَتْني بعْدَهُ عُقَبُ النّوى","حتى لَفَفْتُ تَهائِماً بنُجودِ",9,"د",1,0],["وتَقْرونَ والآفاقُ يَمْري نَجيعَها","شَآميّةٌ تَستَجْمِعُ الشَّوْلَ حَرْجَفُ",10,"ف",1,0],["وَتَقولُ إِنّي قَد تَرَكتُ غَوايَتي","فَاِذهَب لِشَأنِكَ راشِداً لَم تُطرَدِ",11,"د",1,0],["وَتُقْرِبُهُ الآمَال مِنْكَ تَعَلُّلاً","وَيُبْعِدُهُ الْمِقْدَارُ عَمَّا يَرُومُهُ",12,"م",2,0],["وَتَقَرُّ عَيْنُ عَلاَكَ مِنْهُ بِوَارِثٍ","بَهَرَتْ حُلاَهُ نُهَى أَولى الأَلْبَابِ",13,"ب",1,0],["وَتُقْضَى دُيُونِي بَعْدَمَا مَطَلَ الْمَدَى","وَيَنْفُدُ بَيْعِي وَالْمَبيعُ مَعِيبُ",14,"ب",1,0],["وَتَقولُ مالَك لا تَقول مَقالَتي","وَلِسانُ ذا طَلق وَذا مَكظومُ",15,"م",1,0],["وَتَقَدَّموا في سَهمِكُم مِن هاشِمٍ","خَيرِ البَريَّةِ في كِتابِ الباري",16,"ر",2,0],["وَتَقوادُهُ الخَيلَ حَتّى يَطو","لَ كَرُّ الرُواةِ وَئيغالُها",17,"ل",3,0],["وَتَقتالُ النُسوعَ بِجَوزِ قَرمٍ","مُواشِكَةً إِذا ما اليَومُ صاما",18,"م",2,0],["وَتَقَحَّمتُ الرَدى في غارَةٍ","أَسدَلَ النَقعُ عَلَيها هَيدَبا",19,"ب",2,0],["وَتَقضي عَلَيكَ قُضاةُ الضَلالِ","طِوالَ اللَيالي بِأَن تَرقُدا",20,"د",2,0],["وَتَقَوَّلوا عَنكَ القَبيحَ وَهَكَذا","يُمنى الكَريمُ بِغارَةِ الأَشرارِ",21,"ر",1,0],["وَتَقبَلُ مِن أَحكامِهِ كُلُّ أُمَّةٍ","وَلا بَخسَ فيهِ لِلأَنامِ وَلا هَضما",22,"م",2,0],["وَتَقولُ أَهلُ دِمَشقَ أَكرَمُ مَعشَرٍ","وَأَجَلُّهُم وَدِمَشقُ أَفضَلُ مَنزِلِ",23,"ل",1,0],["وتقدموا ولهم على أعدائهم","حنق العدا وحمية الأنصار",24,"ر",1,0],["وَتَقاصَرَت أُصُلاً شُخوصُ أُرومِها","حَتّى مَثَلنَ وَأَعرَضَت أَغفَالُها",25,"ل",3,0],["وتقرأ الآيات من نظمه","عبراً فتستكشف منها اللباب",26,"ب",1,0],["وَتَقْبَلُ المَدْحَ عَلَى أَنَّهُ","مِصْدَاقُ مَا فِي المُقْلَةِ النَّاظِرَهْ",27,"ر",2,0],["وَتَقْبَلُ العُذْرَ مِمَّنْ جَاءَ مُعْتَذِراً","وَتَغْفِرُ الوِزْرَ لِلمُسْتَغْفِرِ الجَانِي",28,"ن",2,0],["وَتَقَلَّدِ السَّيْفَ الَّذِي إِنْ يَدْعُهُ","دَاعِي الحَقِيقَةِ لَمْ يَكُنْ بكَهَامِ",29,"م",1,0],["وَتَقَلَّدْتَهُ كَمَا الفَضْلُ يُرْجَى","لا لِحَرْبٍ تُثَارُ بَلْ لِسَلامِ",30,"م",1,0],["وَتَقْلِيبِ شِبْهِ البَرْقِ وَرْياً وَرَوْنَقاً","مِنَ الرَّأْيِ فِي أدْجَى مِنَ السُّحُبِ الدُّهْمِ",31,"م",1,0],["وتقول عني لجاره","الفقير مالو تجاره",32,"ه",1,0],["وتقبل عد بدينا","وتحن الينا الأرواح",33,"ح",1,0],["وتقحّمت مَوهج الحبّ حتى","أصبح القلب صالياً معمعانه",34,"ن",2,0],["وتقول من مضض الفرا","ق مقال ذي قلب كسير",35,"ر",1,0],["وتقول يا لأَبي الخلائف لو ترى","أركان مجدي وهي مُنهدِمات",36,"ت",1,0],["وتقعد بي دون المدى في خطوبها","وغاية همّ النفس أن أبلغ المدى",37,"د",2,0],["وتَقْذِفهم تلك القبور بضغطها","عليهم لحرّ الساحة المتوقِّد",38,"د",1,0],["وَتَقولُ إِنّي قَد لَقيتُ بَلِيَّةً","مِن مَسحِ عَينِكَ ما يَزالُ بِها قَذى",39,"ا",1,0],["وَتَقولُ عاذِلَةٌ رَخِيٌّ بالُها","ما بالَ نَومِكَ لا يَزالُ مُسَهَّدا",40,"د",2,0],["وَتَقولُ جِعثِنُ لِلفَرَزدَقِ لا أَرى","داراً كَدارِكُمُ الخَبيثَةِ دارا",41,"ر",2,0],["وَتَقولُ طَيبَةُ إِذ رَأَتكَ مُقَنَّعاً","أَنتَ الخَبيثُ عِمامَةً وَإِزارا",41,"ر",2,0],["وَتَقولُ بَوزَعُ قَد دَبَبتَ عَلى العَصا","هَلّا هَزِئتِ بِغَيرِنا يا بَوزَعُ",42,"ع",1,0],["وَتَقولُ جِعثِنُ إِذ رَأَتكَ مُنَقَّباً","قُبِّحتَ مِن أَسَدٍ أَبي أَشبالِ",43,"ل",1,0],["وَتَقَنَّعَ الأَبرامُ في حُجُراتِهِم","وَتَجَزَّأَ الأَيسارُ كُلَّ مُشَهَّرِ",44,"ر",1,0],["وتقدَّمت في كلِّ محفل سؤددٍ","تقديمَ بسمِ اللهِ في الأسماء",45,"ا",2,0],["وتقشَّعت أنواءُ كلّ غمامةٍ","وهباتُه تجرِي على عاداتها",46,"ت",3,0],["وتقلدتْ عنقي عطاياك التي","حكّمت في الأيام عن تقليدها",47,"د",3,0],["وتقبيل حلو الغزو للمحل قاتل","حلاوته سكبٌ وجنديهُ يجري",48,"ر",2,0],["وتقاتل العذّال فيك وربما","قوّى جفاك مطامع العذَّال",49,"ل",1,0],["وتقيّ طرحتها عليك فحبّذا","غيث خلال الروض تحت غمام",50,"م",1,0],["وتقولُ غرّ مدائحي لمحاسنٍ","علويةٍ تعلو على التحسين",51,"ن",1,0],["وَتُقى وَعِلمٌ وَاِقتِداٌ وَصَفا","وَرِضىً وَصِدقٍ وَوَفاً بِسَماحِ",52,"ح",1,0],["وتُقرُّ أنك جاهلٌ","لم تأتِ من أمرٍ صَوابهْ",53,"ب",2,0],["وتقديمُ من قَدَّمت شيءٌ بحقِّهِ","فَدَعْ عنك سَحَّ الدمع والزفراتِ",54,"ت",1,0],["وتقود كلَّ نَوَى شَطُون هِمَّةٌ","ونوى الكريم بعيدةُ التَطْويحِ",55,"ح",1,0],["وتقتل الهمّ شرّ قتلتِهِ","بغير عون يكون من أُخرِ",56,"ر",1,0],["وتقدّمتْها قبل ذاك ثَرائد","مثل الرياض بمثلهن يُصَدَّر",57,"ر",1,0],["وتقول للضيفِ المُلمّ سماحةً","إن شئت في استي فأْتني أو في حرِ",58,"ر",1,0],["وتُقْنِعُها بالذُّلِّ وهْيَ عزيرةٌ","يُكانِفها من عزمها الصبر والنصر",59,"ر",1,0],["وتقبيلَه لما حللتَ عقالَهُ","وعَلَّيتَ فودَيه بأصفرَ وارِس",60,"س",1,0],["وتُقى هلوعٍ من وعيد إلهه","من نائبات الدهر غير هلوع",61,"ع",1,0],["وتقوى على دسِّه","وعن سلِّه تضعف",62,"ف",1,0],["وتقاسون بالسراة وما زل","تم تفوقون فائقاً لا مفوقا",63,"ق",2,0],["وتقاضيتُ بالسكوتِ إلى أنْ","لامني في لُزومه اللُّوَّامُ",64,"م",1,0],["وتقود عرسَك للزناة مسوَّماً","بالقَرنِ مُعترفاً بكلِّ هوان",65,"ن",1,0],["وَتَقولُ عَيني قَد فَقَدتُ ضِيائي","وَيَقولُ قَلبي قَد فَقَدتُ رَجائي",66,"ي",1,0],["وَتَقبُضُ مِن مَبسوطِهِ نَفَحاتُهُ","كَما قَبَضَ الثَوبَ المُطَرَّزَ ناشِرُه",67,"ر",2,0],["وَتَقَطَّعَت أَمراسُ آمالي بِها","وَهيَ الَّتي مِن قَبلُ لَم تَتَقَطَّعِ",68,"ع",1,0],["وَتَقَدَّمَ الشُرطِيُّ يَمشي نَحوَهُ","مَشيَ الفَخورِ بِنَفسِهِ المُختالِ",69,"ل",1,0],["وَتَقَدَّما لِلرَقصِ يَق","رَء ناظِرَيهِ ناظِراها",70,"ا",3,0],["وَتَقولُ أَوصَيتَ الخَطي","بِ فَهَل نَفَوهُ مِنَ البَلَد",71,"د",1,0],["وتَقْنَعُ بالعيشِ بَيْنَ الكهوفِ","فأَينَ النَّشيدُ وأينَ الإِيَاهْ",72,"ا",2,0],["وتقدّموا لي بالضَّحايا منهُمُ","فَرحينَ شأنَ العابدِ الأوّابِ",73,"ب",1,0],["وَتَقولُ بِت عِندي فَدَيتُكَ لَيلَةً","أَشكو إِلَيكَ فَإِنَّ ذاكَ يَسيرُ",74,"ر",1,0],["وتقصى يبين ما لم يكن يو","ما لمن كان قبله مستبينا",75,"ن",2,0],["وتقدموا متواثبين لتلحقوا","بالسابقين الغر في المضمار",76,"ر",1,0],["وتقوم بالعمل المفيد لأهلها","من نسج أردِيَة لهم وبُرود",77,"د",1,0],["وتقبل منهمو تلك الخطى","وأعنهم وأثبهممجزلا",78,"ل",2,0],["وتقول كل حزينة في خدرها","ذهب القاسة وجاءنا الرحماء",79,"ا",2,0],["وتقول ما لم تعتقد","حتى يضج المجلس",80,"س",1,0],["وتقول قلت وقال لي","مولى تواريه ولاك",81,"ك",1,0],["وتقول وصوتها رعد قوىّ","ونحل في الضمير لها دوى",82,"د",3,0],["وَتَقولُ إِذ تَأتيكَ تَلتَمِسُ الهُدى","سِيّانِ هَذا في الجَلالِ وَذاكا",83,"ك",2,0],["وَتَقومُ الظُهرَ وَالعَص","رَ بِأَورادٍ شَريفَه",84,"ف",2,0],["وَتَقعُدُ في مَأتَمِ اِبنِ الإِمامِ","وَتَبكيهِ بِالعَبَراتِ الهُتُن",85,"ن",1,0],["وَتَقَلَّدوا النَعشَ الكَريمَ يَتيمَةً","وَلَكَم نُعوشٍ في الرِقابِ زِيافِ",86,"ف",1,0],["وَتَقَبَل وَداعَ باكٍ عَلى فَق","دِكَ وافٍ لِعَهدِكَ المَحمودِ",87,"د",1,0],["وَتَقَوَّضَت لِلفَنِّ أَطوَلُ سَرحَةٍ","يُغدى إِلى أَفيائِها وَيُراحُ",88,"ح",1,0],["وَتَقَلَّدي لُغَةَ الكِتابِ فَإِنَّها","حَجَرُ البِناءِ وَعُدَّةُ الإِنشاءِ",89,"ا",2,0],["وَتَقَدَّموا حَتّى إِذا ما بَلَّغوا","أَوحوا إِلى مِصرَ الفَتاةِ تَقَدَّمي",90,"م",2,0],["وَتَقابَلَت فيها عَلى السُرُرِ الدُمى","مُستَردِياتِ الذُلِّ لا تَتَفَتَّقُ",91,"ق",1,0],["وَتَقليلِها كُلَّ جَمِّ السَنا","وَتَصغيرِها كُلَّ عالٍ مَشيد",92,"د",1,0],["وَتَقَدَّمَت تُزجي الصُفوفَ كَأَنَّها","جاندَركُ في يَدِها اللِواءُ مُظَفَّرا",93,"ر",2,0],["وَتُقدِمُ إِقدامَ اللُيوثِ وَتَنثَني","وَتُدبِرُ عِلماً بِالوَغى وَتُعَقِّبُ",94,"ب",1,0],["وَتَقَلَّدتُ شامَةً في نَداهُ","جِلدُها مُنفِساتُهُ وَعَتادُه",95,"د",2,0],["وَتَقصُرُ ما كُنتَ في جَوفِها","وَتُركَزُ فيها القَنا الذُبَّلُ",96,"ل",1,0],["وتقيَّلتْ أبناؤُهم أسلافَهمْ","فتشابَه الأعراقُ والأغصانُ",97,"ن",1,0],["وتقودُ ذا لجَبٍ كأن زُهَاءَهُ","وطفاء تُحدى بالبليلِ الزعزعِ",98,"ع",1,0],["وتقولُ ما للطَّيفِ أبطأَ بعدَما","كنَّا اشترطنا أنْ يُقيمَ يسِيرا",99,"ر",2,0],["وَتَقَرّى آثارَ مَصقَلَةَ البَكرِ","يَّ حَتّى تَجَدَّدَت آثارُه",100,"ر",2,0],["وَتَقتُلوا بِفَتى الفِتيانِ قاتِلَهُ","أَو تُقتَلونَ جَميعاً غَيرَ أَشتاتِ",101,"ت",1,0],["وَتَقديمٌ إِذا اِعتَرَكَ المَنايا","بِجُردِ الخَيلِ في اللُجَجِ الغِمارِ",102,"ر",1,0],["وَتَقتيلُ المُلوكِ وَإِنَّ مِنهُم","فَوارِسَ يَومَ طِخفَةَ وَالنِسارِ",102,"ر",1,0],["وَتَقولُ كَيفَ يَميلُ مِثلُكَ لِلصِبا","وَعَلَيكَ مِن سِمَةِ ال