","بِغَدٍ وَلا ما بَعدَهُ عِلمُ",151,"م",1,1],["وَتقلَّبت فوق التراب كأنها","حملٌ تعجَّل ذبحَهُ القصّاب",152,"ب",1,0],["وَتَقول يا أم استبد بحكمه","فيَّ القضاء فَلي عليه عتاب",152,"ب",1,0],["وَتقذف طياراتها نار غيظها","فتفتك بالأجناد أَو بالطَلائع",153,"ع",1,0],["وَتَقَهقَرَت الأكفاء وَكا","نوا قبل الرجعة قد قهروا",154,"ر",3,0],["وَتَقتَحم الحرب أَبطالها","فتسأم وَالموت لا يسأم",155,"م",1,0],["وَتقدح بالفكر أَلبابنا","زناداً وَلا يَنجَلي المبهم",156,"م",1,0],["وتُقسم المرآة لي أنني","رَقَّعتُ بالآمال ثوب الأجل",157,"ل",1,0],["وتقرأينَ الآنَ في صمتِهِ","تَمرُّدَ الرُّوحِ على ربهِ",158,"ه",1,0],["وتقَبَّضَ المستَقتِلونَ وعربدَتْ","أيدي الرُّماةِ وعرَّدَ البتَّارُ",159,"ر",1,0],["وتقوَّض الحِصنُ المنيعُ ولم يكن","إلَّا جِدارٌ يحتويهِ دَمارُ",159,"ر",1,0],["وتقتل أم ليلى أم عمرٍو","لمن يغدو سميتها قتيلا",160,"ل",2,0],["وَتَقنُصُني ظِبا السَعدِي وَتَسطو","عَلَيَّ مَها الشَرَبَّةِ وَالخُزامِ",161,"م",1,0],["وتقولُ العُداةُ أَودَى عَدِيٌّ","وبَنُوهُ قَد أَيقَنُوا بِغلاقِ",162,"ق",1,0],["وَتَقَضَّى بَغْيُ البُغَاةِ عَلَيْهِمْ","وَتَقَضَّى الإعْنَاتُ وَالإرْغَامُ",163,"م",1,0],["وَتَقَبَّلُوا مِنِّي تَحِيَّ","اتِ التَّجِلَّةِ وَالْوِدَادْ",164,"د",1,0],["وَتُقِرُّ عَيْنَكَ مُتْعةٌ أَهْلِيَّةٌ","أَغْنَتْ عَنِ النَّسَّاجِ وَالغَزَّالِ",165,"ل",1,0],["وَتقاتَلُوا يَوْمَينِ لَمْ","يَظهَرْ مٍنَ للجَيْشَيْنِ ظَاهِرْ",166,"ر",1,0],["وَتَقَضِي شُعُوبٌ كِبَارَ الْمُنَى","وَأَنْتَ الْمؤَازِرُ وَالْمُسْعِدُ",167,"د",1,0],["وَتَقُولُ قَدْ ثَكِلَتْ سَمَائِي كَوْكَباً","لَكِنَّ قُدْوَتَهُ وَلُودُ كَوَاكِبِ",168,"ب",1,0],["وتقطعت خصل الحسان ونثرت","بدل الكروم على التلال غدائرا",169,"ر",2,0],["وَتَقَاسَمَا فَضْل الْفَخا","رِ وَنَادَيَا هَلْ مِنْ مُفَاخِرْ",170,"ر",1,0],["وتقلدتُه حساماً لمصرٍ","تتوقى الخطوبُ وَقْعَ شَابته",171,"ت",2,0],["وتقطَّعَتْ بين السماء وبينه","شتى الصَّلاتِ تقطُّعَ الأوتار",172,"ر",1,0],["وتقدَّما، والموت -عن","كثب- يصيح: إلى الوراء",173,"ا",2,0],["وتَقَاضَتْهُ المعالي حقْبَةً","ثمنَ العزة فقرًا أدقَعه",174,"ع",2,0],["وتقاول الكهان أن رئيها","أضحى لديك مقرنا مصفودا",