{"poems":[[47,"محل على القاطول أخلق داثره","https://www.aldiwan.net/poem63630.html","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79910","المتقارب"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100993","الطويل"]],"verses":[["وَلَو لِعُبَيدِ اللَهِ عَونٍ عَلَيهِمِ","لَضاقَت عَلى وُرّادِ أَمرٍ مَصادِرُه",0,"ر",2,0],["ولو لعواقدِها سحرُها","لحلَّت به عزمَ آسادِها",1,"د",3,0],["ولول علمت من أنت لم تطع الصبا","فتشغلها عنك المخيلة والكبر",2,"ر",1,0]]}