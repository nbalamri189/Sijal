ب على شاطئ البحر","https://www.poetsgate.com/ViewPoem.aspx?id=183228",""],[5957,"أيها المجنون","https://www.poetsgate.com/ViewPoem.aspx?id=213547",""],[6031,"قُلْ لِمَنْ يُرْجِعُ الحَوَائجَ","https://www.poetsgate.com/ViewPoem.aspx?id=46404",""],[5309,"ذلك البدر كنت ادري مصيره","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573542",""],[6229,"ليلى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65190&r=&rc=16",""]],"verses":[["ثُمَّ يُضحي مِن فَورِهِ ذا هِبابٍ","يَستَطيرُ الحَصى بِخُفٍّ كَثيفِ",0,"ف",1,0],["ثم يجيء الدامع المشوي","بطيبه فيخجل المحشي",1,"ي",1,0],["ثُمَّ يَظَلّونَ كَأَنَّ لَم يَبرَحوا","كَأَنَّما أَمسوا بِحَيثُ أَصبَحوا",2,"ح",3,0],["ثُمَّ يَعمى إِذا خَفينَ عَلَينا","أَطِوالٌ أَمراسُها أَم قِصارُ",3,"ر",1,0],["ثم يَخْفَى عليك أنّي صديقٌ","رُبَّما عزَّ مِثلُه بالغَلاءِ",4,"ا",2,0],["ثم يهتزّ كالقضي","ب إذا هبّت الصَّبَا",5,"ب",2,0],["ثم يقول كالقَنُوع الزاهدِ","أغنى عن الطارف حِفْظُ التالدِ",6,"د",1,0],["ثم يدعَى جريحه السالم الغا","نم إذ أخْطَأتْه حال الفَريس",7,"س",1,0],["ثم يأتي مكان رأسٍ برجْلَي","ن ضلالاً لذاك من تَرْئيس",7,"س",1,0],["ثم يلجيه إلى الحش","شٍ بصغر فيطيعه",8,"ع",2,0],["ثم يبدي منه صوتاً","ود لو صم سميعه",8,"ع",2,0],["ثم يأبى الهجاءُ أو يَتلافى","وَكْسَ ما بين غثِّكم وسميني",9,"ن",2,0],["ثم يَخْلُون بعد ذلك بالحُوْ","رِ إذا ما تشوَّقوا الأوطانا",10,"ن",2,0],["ثمَّ يَسْمو طائراً كالبلبلِ","الشَّادي السَّعيدْ",11,"د",1,0],["ثمَّ يأتي الصَّباحْ","وتَمُرُّ الفُصُولْ",12,"ل",1,0],["ثم يرقى حتى يكون سراجاً","لذويه فيه هدى واناره",13,"ر",2,0],["ثم يرقى حتى يكون مع ال","أيام ناراً حمراء ذات حراره",13,"ر",2,0],["ثم يرقى حتى يكون اتونا","بحراراته تذوب الحجاره",13,"ر",2,0],["ثم يرقى حتى يكون حريقاً","فيه هلك لاهله وخساره",13,"ر",2,0],["ثم يرقى حتى يمثل بركا","ناً يرى الناس من بعيد ناره",13,"ر",2,0],["ثم يرقى حتى يكون جحيما","عن تفاصيلها تضيق العباره",13,"ر",2,0],["ثُمَّ يَقولُ الجيلُ بَعدَ الجيلِ","قَد أَكَلَ الأَرنَبُ عَقلَ الفيلِ",14,"ل",1,0],["ثُمَّ يَزْدادُ ضَوْءُهُ فتراهُ","قَمَراً في السّماءِ غيرَ هِلالِ",15,"ل",1,0],["ثم يسخلف فيهم مثلهم","ولداً أزهر علوي الصفات",16,"ت",1,0],["ثُمَ يَجلو النَهارَ رَبٌ كَريمٌ","بِمَهاةٍ شُعاعُها مَنشورُ",17,"ر",1,0],["ثُمَّ يُؤتى بِهِ وَخَصماهُ وَسطَ ال","جِنِّ وَالإِنسِ رِجلُهُ وَيَدُه",18,"د",2,0],["ثُمَّ يَغدوا مَرِحاً إِن سَبَّني","وَيَرى لَحمِيَ مِن أَطيَبِ زادِ",19,"د",1,0],["ثُمَّ يَعودُ الإِنكارُ مَعرِفَةً","مِنكَ إِذا قِستَهُ إِلى الصُوَرِ",20,"ر",1,0],["ثُمَّ يَعتَمُّ الحِجاجُ بِهِ","كَاعتِمامِ الفوفِ في عُشرِه",21,"ر",2,0],["ثم يأتي ثم يمضي","فهو ما زال يدور",22,"ر",1,0],["ثم يرقى حتى يكون مع الأي","يام ناراً حمراء ذات حراره",23,"ر",2,0],["ثُمَّ يأَتي المريخ فهو لنا يب","دو مضيئاً كنقطة حَمراء",24,"ا",2,0],["ثم يأَتي وَراءه زحلٌ في","حلقاتٍ عليه ذات ضياء",24,"ا",2,0],["ثُمَّ يُرَجّيكَ أَن تُنادي","رَبِّ أَبي اِرحَم بِهِ اِكتِراثي",25,"ث",2,0],["ثُمَّ يَقولُ النَبيُّ حَقّاً","أَغِثهُ يا خَيرَ مُستَغاثِ",25,"ث",1,0],["ثم يُغْضي مُهمهِماً مثلما جرّ","بتَ بالْجَسِّ شادياتِ المثاني",26,"ن",2,0],["ثمَّ يَخْفَى فَلاَ تَرَاهُ عُيُونٌ","ثُمَّ يَبْدُو فَلاَ تَشُكَّ عِيَانَه",27,"ن",2,0],["ثُمَّ يُمْلي كَأَنهُ مِنْ كِتابٍ","قَارِىءٌ في سُهولَةٍ ومَرَانَهْ",27,"ن",2,0],["ثمَّ يستفظعون إثمَ الذي قالوا","فينوونَ عندهُ أنْ يتوبوا",28,"ب",3,0],["ثم يُدعَى جريحُه السالم الغا","نم إذا أخْطَأتْه حال الفَريس",29,"س",1,0],["ثم يُلجيه إلى ال","حش بصُغْرٍ فيطعيه",30,"ع",3,0],["ثُمَ يا رَب سَلاماً دائِماً","وَأَصلاً مِنكَ لجد الحسنين",31,"ن",1,0],["ثم يهدينهَ إلى القلبِ حتى","صارَ في غصةٍ وفي أَشْغَالِ",32,"ل",1,0],["ثُم يَنسى المَتجرَ الأسمى","لدى حَسبِ الأجور",33,"ر",1,0],["ثم يأوي لِمَن جفوه قديما","فيملونَه المَلاَلَ القديما",34,"م",2,0],["ثم يرى برقوق في خيله","يهز متن الرمح للحمله",35,"ل",2,0],["ثُمَّ يَصِحنَ يا حُسَينَاهُ أَما","بَعدَ فِراقِ اليَومِ مِن تَجَمُّعِ",36,"ع",1,0],["ثم يأتي على البدي","ه الذي منه أحذر",37,"ر",1,0],["ثمَّ يَدنو ولا يسفِّه أحلا","ماً فما هم بزعمهم سفهاءُ",38,"ا",2,0],["ثم يخلي من المياه إناءين","اذا شاء بعد يمتلئان",39,"ن",1,0],["ثم يدني الغطاء منه ويأتيك","بزوج من الحمام يماني",39,"ن",2,0],["ثم يملي إشارة فنراها","رجعت عمة من الدبلان",39,"ن",1,0],["ثم يفري فتاته فتراها","مالها بالحياة قط يدان",39,"ن",1,0],["ثم يأتيك بعد ذاك سريعاً","ولك الشكر وهو خيرُ ثوابِ",40,"ب",1,0],["ثم يوم الغَدِير ما قد علمتم","خَصّه دون سائر الحُضَّار",41,"ر",1,0],["ثم يصفو في ذرَاكِ لنا","طِيبُ عيشٍ ما به كَدَر",42,"ر",1,0],["ثم يعطى وسيلة هي أعلى","درجات الجنان دار البقاء",43,"ا",2,0],["ثمّ يشفى من لسعة البين صبٌّ","باللقا وهو معظم الترياق",44,"ق",1,0],["ثم يطويه الزمان ولم","يبلغ المرجوّ من وطَره",45,"ر",2,0],["ثُمَّ يَكسي بِخَرقِهِ","وَلِقَبرٍ يَشيعُ",46,"ع",1,0],["ثُمَّ يَبلى وَيَمحي","وَإِلى الأَصلِ يَرجِعُ",46,"ع",1,0],["ثمّ يَهمي دمعُه من بعدما","صَعّدته زَفراتُ الأنفسِ",47,"س",1,0],["ثُمَّ يَجتَبنَهُ فَيَخرُجنَ مِنهُ","شَطبَةٌ لَقوَةٌ وَفَحلٌ طَحورُ",48,"ر",1,0],["ثم يبقى لديّ من صبواتي","ثروة في مواسم الحب تغنى",49,"ن",2,0],["ثم يسلو على المدى أبواه","وهما كالفقيد بعض الحكايه",50,"ه",1,0],["ثم يمّمن معبد الأرباب","حيث توّجن بالخلود شبابي",51,"ي",1,0],["ثم يفنى الوجود في كف باريه","لتحيا الحياة في الألباب",52,"ب",1,0],["ثُمَّ يُقيمُ ويُصلّي شَطْرَه","واللهُ من عَبْدٍ بذاكَ يَكْتَفي",53,"ف",2,0],["ثم يا حبَّذا النَّوائبُ مادا","مَ يُرجَّى لِدفعِها النُّعمانُ",54,"ن",1,0],["ثُمَّ يَأتي عَلَى المُدامِ بخلقٍ","مِثلها بالمِزاجِ لا وهيَ صِرفُ",55,"ف",1,0],["ثم يصلي على الهادي حميد الخصال","ثم يسلم مع الترتيب في ذي الفعال",56,"ل",1,0],["ثم يأتي حكم صحيح إليكم","قد أقرت لحكمه الثقلان",57,"ن",1,0],["ثم يعود مثنياً","عليك من قد تربك",58,"ك",1,0],["ثمين لئالي العقد حالية به","من الفضل أعناق الحجى ورقابه",59,"ب",2,0],["ثم يا اخا الود لا تغضب لما أثموا","فليس لبنان ذا بل بعض لبنان",60,"ن",1,0],["ثم يعلو بجيشه ملك اللي","ل مدلا بفوزه في الرهان",61,"ن",1,0],["ثم يستوقفه هدر جمل","أو نعيق أو غزال قد نفر",62,"ر",1,0],["ثم ينهى المحب من بعد إِهداء سلا","م وافى بنشرٍ وطيبِ",63,"ب",1,0],["ثم يُنهى من بعد وصف اشتياق","للجناب الأعزّ ملء القلوب",63,"ب",1,0],["ثم ينهي المحبُّ فرط اشتياق","جلَّ عن أن تبثّهُ الأخبار",64,"ر",1,0],["ثم يمضى الحوتُ يبقى أكلكم","لقمةً واحدةَ غير ضنين",65,"ن",1,0],["ثم يعودان لم يُزالا","بنقصِ نورٍ ولا نُقولِ",66,"ل",1,0],["ثمينةَ البُضعِ حصيناً سرّها","على الرجال حرّةً لا تُسترَقّْ",67,"ق",1,0],["ثم يعود مثلُها عليكُمُ","بألف عيدٍ عَرَباً وفُرُسا",68,"س",2,0],["ثُمَّ يا لهْفي على ذي شُطَبٍ","كَلَّ منْ غيرِ ضِرابٍ وقِتالِ",69,"ل",1,0],["ثُمَّ يَأتيكَ في السَكارِجِ خَلٌّ","حُبُّهُ ما حَييتَ في القَلبِ باقِ",70,"ق",1,0],["ثُم يُهديها إلى مَن","بِقَريضٍ لا يُبالي",71,"ي",1,0],["ثُم يُوالِي لحنَه","حالَة طفلِ المكتبِ",72,"ب",1,0],["ثُمَّ يا فَريدَ عَلى يَقينِكَ أَنَّهُ","يَومَ تَأَذَّنَ بِالخَلاصِ عَتيدا",73,"د",2,0],["ثم يؤتى بما هويت من التش","ريف عندي والبر والتبجيلِ",74,"ل",1,0],["ثُمَّ يُعيدُ الماءَ ناراً حامِيَهْ","يَزيدُ في كَربِ القُلوبِ الصادِيَهْ",75,"ه",1,0],["ثُمَّ يَليها مَطَرٌ مُداوِمُ","كَأَنَّهُ خَصمٌ لَنا مُلازِمُ",75,"م",1,0],["ثم يميلُ واهناً","مستسلماً للعطب",76,"ب",1,0],["ثمَّ يَمِّمْ طيبةً وَاِنزِل بِها","لَكَ تُبدي مِن ثَناياها اِبتِساما",77,"م",2,0],["ثُمَ يَفيقُ بَعد لِقواه","وَيَقتل القاتِل إِن رَآه",78,"ه",1,0],["ثُمَّ يؤمّ بَيتَه الكَريما","وَيَترُك الوَزير وَالخَديما",79,"م",2,0],["ثُمَّ يَنامُ تارَةً وَتاره","يدبّر الأُمور وَالإِداره",79,"ه",1,0],["ثم يجعلْ ما بينه وهوَى مُهْ","جَتِه والشيطان سبعينَ مِيلا",80,"ل",2,0],["ثم يُثنى بعده بالحمد لك","يا عادلاً في حكمه ما أعْدَلك",81,"ك",1,0],["ثُمَّ يُدَانِي اللَّهُ بَيْنَ الشَمْلِ","وَعِنْدَهُ مِقْدارُ كُلِّ أَجْلِ",82,"ل",1,0],["ثم يعفو ويرحمنّ عجوزاً","صيرته الهموم هرماً كهولا",83,"ل",2,0],["ثم يعود للقتال جاهداً","يقط كشحا ويقد مفرقا",84,"ق",2,0],["ثم يا ريح الصبا","فازيلي وصبا",85,"ب",2,0],["ثُم يَقوم قائِماً فَيَخطب","وَيَمدَح الحاكم ثُم يطنب",86,"ب",1,0],["ثم يخضر عشبها","وفم الدهر يبتسم",87,"م",1,0],["ثم يكون مُستديمَ العملِ","إذ لم يفز مقصرٌ بالأملِ",88,"ل",1,0],["ثُمَّ يَبيتُ عِندَهُ مَسدوحا","مُهَشَّمَ الهامَةِ أَو مَذبوحا",89,"ح",2,0],["ثم يرمى بي الجحيمُ جهاراً","في خمير وفي دراهم قمرِ",90,"ر",1,0],["ثم يريك الله فيه الرّضا","ومنيةَ النفس إلى الاحتلامْ",91,"م",1,0],["ثم يعيشان بقاء المدى","على نعيم حسن الالتئامْ",91,"م",1,0],["ثم يبقى صليله وهو يتلو","رنة الفوز أو أنين الكسادِ",92,"