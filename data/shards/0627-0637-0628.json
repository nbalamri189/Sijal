{"poems":[[90,"كان أبو الطيب امرأ قوله","https://www.aldiwan.net/poem44436.html","المنسرح"],[23,"سألت قريشا فقد خبروا","https://www.aldiwan.net/poem21445.html","المتقارب"],[53,"أبا علي طلبت عيبك ما اسطعت","https://www.aldiwan.net/poem65452.html","المنسرح"],[53,"أطبقت للنوم جفنا ليس ينطبق","https://www.aldiwan.net/poem65707.html","البسيط"],[93,"راودني النوم وما برحا حتى طأطأت له راسي","https://www.aldiwan.net/poem8971.html","عموديه"],[64,"بعثت إلي تلومني في هجعة","https://www.aldiwan.net/poem52408.html","الكامل"],[47,"ليالينا بين اللوى فمحجر","https://www.aldiwan.net/poem63636.html","الطويل"],[92,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[104,"ما لك والذكريات تذعرها","https://www.aldiwan.net/poem32915.html","المنسرح"],[52,"سلم على الدار بذي تنضب","https://www.aldiwan.net/poem64870.html","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39612","الكامل"],[108,"تمثال فينوس","https://www.poetsgate.com/ViewPoem.aspx?id=179776",""],[47,"لَيَالينا بَينَ اللّوَى، فمُحَجَّرِ،","https://www.poetsgate.com/ViewPoem.aspx?id=31220",""],[228,"أطبق جناحيك معقودا لك الظفر","https://www.aldiwan.net/poem39690.html","البسيط"],[234,"وبركة تزهو بنيلوفر","https://www.aldiwan.net/poem51206.html","السريع"],[240,"خليفة الله الذي","https://www.aldiwan.net/poem31808.html","مجزوء الرجز"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[303,"حيتك باسمة ثغور الزنبق","https://www.aldiwan.net/poem36840.html","عموديه"],[303,"لو رأيت الكأس والوجه الصبيحا","https://www.aldiwan.net/poem36853.html","عموديه"],[343,"قل لهارون إن حللت","https://www.aldiwan.net/poem68727.html","مجزوء الخفيف"],[463,"هل في الشموس التي تحدى بها العير","https://www.aldiwan.net/poem56166.html","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122777","المنسرح"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38277","البسيط"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202130","الرجز"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/80005","الخفيف"],[1585,"","https://poetry.dctabudhabi.ae/diwan/poem/26649","السريع"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101015","الطويل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110275","الرمل"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110280","الرمل"],[2110,"","https://poetry.dctabudhabi.ae/diwan/poem/109341","الرمل"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130751","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199917","الخفيف"],[3291,"","https://poetry.dctabudhabi.ae/diwan/poem/106695","الكامل"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82805","الوافر"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112319","الرمل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62826","الوافر"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135682","المجتث"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97098","الكامل"],[5122,"((((( عيون الاخبار )))))","https://www.poetsgate.com/ViewPoem.aspx?id=37320",""],[5376,"هل أنشدُ الدارَ قحطاناً وعدنانا.","https://www.poetsgate.com/ViewPoem.aspx?id=188463",""],[5408,"دمعة حزن","https://www.poetsgate.com/ViewPoem.aspx?id=190864",""],[5431,"فإن الصبرَ من عزم الأمور","https://www.poetsgate.com/ViewPoem.aspx?id=187730",""],[5431,"فيرميه الصباح على سريري","https://www.poetsgate.com/ViewPoem.aspx?id=198702",""],[5431,"وطن الأكفان ...","https://www.poetsgate.com/ViewPoem.aspx?id=198867",""],[5691,"أطبق الصمت...!","https://www.poetsgate.com/ViewPoem.aspx?id=206739",""],[5842,"على ضفافِ القلق \\ محمد حسام الدين دويدري","https://www.poetsgate.com/ViewPoem.aspx?id=126129",""],[5881,"قسمت روحي","https://www.poetsgate.com/ViewPoem.aspx?id=183797",""],[5956,"صور إيمانية","https://www.poetsgate.com/ViewPoem.aspx?id=192502",""],[5956,"لقطات من تاريخ سيد المرسلين","https://www.poetsgate.com/ViewPoem.aspx?id=192573",""],[6083,"لابسات المساء","https://www.poetsgate.com/ViewPoem.aspx?id=151966",""],[6198,"عبق الذكرى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79291&r=&rc=65",""],[5355,"أطبق جفونك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86679&r=&rc=2",""],[6212,"مُكَاشَفَاتٌ أَخِيْرَةٌ في مَهَبِّ اللَّيل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1623&r=&rc=4",""],[6256,"مداعبة صديق","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65926&r=&rc=14",""],[6268,"إضاءة في خيمة الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82915&r=&rc=1",""],[6304,"بغداد في الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1610&r=&rc=0",""]],"verses":[["أطبعه بالذكاء متقداً","أم نفسه بالاباء مشتمله",0,"ل",2,0],["أَطَبخُ الإِهالَةِ أَم حَقنُها","فَأَنفُكَ مِن ريحِها وارِمُ",1,"م",1,0],["أطب وأقلل فإن أطبت وأك","ثرت نصيبي فيا له شرفا",2,"ف",2,0],["أطبقت للنوم جفناً ليس ينطبقُ","وبتُّ والدمع في خديَّ يستبقُ",3,"ق",1,1],["أَطبَقتُ جُفونِيَ فَاِنفَتَحا","بابُ الرُؤيا وَالوَسواسِ",4,"س",1,0],["أطبقتُ أجفانِي عليه وسُمْتُه","خوضَ الدُّموعِ فما أطاقَ عُبورَا",5,"ر",2,0],["أَطَبتَ وَأَكثَرتَ العَطاءَ مُسَمِّحاً","فَطِب نامِياً في نَضرَةِ العَيشِ وَاِكثُرِ",6,"ر",1,0],["أطبقتُ جَفناً على جَفنٍ لأبصُرَه","حتى كأنَّ بريقَ الموتِ يُعشيني",7,"ن",2,0],["أَطبق أَهدابَها فَقيَّدها","لَولا اِضطِرابٌ يَكاد يَنثرها",8,"ر",3,0],["أَطَبَّ لِلدينِ إِذا رَنَّقَت","عَيناهُ مِن طاغِيَةٍ مُجرِبِ",9,"ب",1,0],["أطبقتِ كالنَّسرِ المحلِّقِ ما لهمْ","منه ولا من مِخلبيهِ فِرارُ",10,"ر",1,0],["اطبَع على الفنِّ الشَّبا","ب، وبالتَّذَوُّق أغره",11,"ر",2,0],["أطَبْتَ، فأكْثَرْتَ العَطاءَ مُسَمِّحاً،","فَطِبْ نامِياً في نَضرَةِ العَيشِ واكثُرِ",12,"ر",1,0],["أَطبِق جَناحَيكَ مَعقوداً لَكَ الظَفَرُ","فَقَد وَصَلتَ وَشَوطُ المَجدِ مُختَصَرُ",13,"ر",1,1],["أطبَق جفنيه على خدّه","وغاص في البركة خوف الرقيبْ",14,"ب",1,0],["أَطبِق أَبا سَعدٍ وَخُذ","مِنهُ قَراحَ الطَبَقَه",15,"ق",2,0],["أَطبخُ للحُجّاج","من لحمِ الدَجاجِ",16,"ج",1,0],["أَطباقُها مثل الأناملِ شُبّكتْ","في كل كمٍّ تلتقي في مأْزق",17,"ق",1,0],["أَطبقَ البابُ فماً خلفهما","فهما كالسرِّ يحويه ضمير",18,"ر",1,0],["أَطبَقَ المَوتُ وَالنُفو","سُ عَلى اللَهوِ مُطبِقَه",19,"ق",2,0],["أطبقتُ جفني على ضوء الصباح لهم","حفظاً فما لنهارٍ فيهما نورُ",20,"ر",1,0],["أَطبَق أجفانَهُ عَلَى سُهُدٍ","وَعُوجَ أضلاعِهِ عَلَى ضَرَمِ",21,"م",1,0],["أُطبِّبُ النّفسَ بِالآمالِ تَأملها","ما أَزهَقَ النَّفسَ لَولا الطبّ بِالأَملِ",22,"ل",1,0],["أطب في مصالح المعاد","ما طب جالينوس في الأجساد",23,"د",1,0],["أطبقت ظلمةُ الخطوب ولكن","بأخيه من ليلها شقَّ فجرا",24,"ر",2,0],["أطبق جفنيه على إلفه","وغاص في الماء حذار الرقيب",25,"ب",1,0],["أطباءه لو يستطيع فداءه","بنو مصر غالوا في الفداء وأسرفوا",26,"ف",3,0],["اطبق الداء عليه فهوى","طالباً في قبره معتصما",27,"م",2,0],["اطبق اليأس عليه فقضى","من أساه وهو في شرخ الصبا",28,"ب",2,0],["أطبق الجفن وقل يا با الهدى","وانظر الليل انجلى أم أقمرا",29,"ر",2,0],["أطبقت أجفانهن الساهرات","في ظلام الشك أطرافُ اليقين",30,"ن",1,0],["أطبقوا كلهم على الحق خنقا","وفلسطين أفصح الشهداء",31,"ا",2,0],["أطبَقتُ أحشَائِي عَلَى نارِ الجوى","للصَّبرِ فِيهَا مَنازِلٌ تتهدَّمُ",32,"م",1,0],["أَطِبّائي بِعَجزِهمُ أَقَرّوا","فَلَيسَ سِواكَ يُرجى لِلشِّفاء",33,"ا",2,0],["أطبَقَ الفَخُّ عَلَيهِ ماسكاً","عنقَهُ في مخلبٍ يفري الحديد",34,"د",1,0],["أطبُّ بداءٍ ما يصابُ دواؤُهُ","وأعلم بالأنواءِ أينَ تَجودُ",35,"د",1,0],["أطبّ كل عليلٍ","أسرع إليّ بطبّي",36,"ب",2,0],["أطبقت بالأرضين سبع طباقها","ونسفت من شم الجبال رعانها",37,"ن",3,0],["اطب داخل فيضت الشعر وأختار","اخذ من اثقاله وجنب أخفافه",38,"ف",2,0],["أطْبقَ ليلٌ علينا في دجى دهمٍِ","حتى ظننا بأن الليلَ يغشانا",39,"ن",2,0],["أطبقت جفني والسؤال يهزني","هل يرجعون إذا يطول تضرّعُ",40,"ع",1,0],["أطبقتنا بشرٍ مستطيرِ","مقطعة الوصال بلا مُجيرِ",41,"ر",1,1],["أطببه بأنفاسٍ ولمسٍ","وشمعٍ قد تضوعَ بالبخورِ",42,"ر",1,0],["أطباقك السبع بالخيرات مترعة","وصدرك الرحب مهد العشق والنجوى",43,"و",2,0],["أطْبقَ الصَّمْتُ لا احْتِجاجَ ولا","شجْبَ كأنّا لا نُدْمِنُ الإحْتِجاجا !",44,"ج",2,0],["أطبقت جفني هانئاً في لحظةٍ","وبدأت أحلم بالفلاح وأنشدُ",45,"د",1,0],["أطبقت عيني والظلام سجى","وخرجت من تنوره بددا",46,"د",2,0],["أطبق يديك على الفقير حماية","أغدقْ عليه بأكرم المنحاتِ",47,"ت",1,0],["أطْبَقَ الشركُ عليهم فكَّهُ","وأراد الله عنهم فكّهُ",48,"ه",1,1],["أطباعي الهادئة .. فيها بقايا جموح","وانا عن الخيل .. خيلي ما تجي مُلجمة",49,"م",2,0],["أطبقتُ هُدبي على ذكراكِ آونةً","لتستحمّ ضفافُ الوقتِ... بالعبَق",50,"ق",1,0],["أطْبِقْ جُفُوْنَكَ إنَّ الْعَيْنَ تغْتَسِلُ","فَلَنْ أرَاكَ لِدَمْعِ الْعَيْنِ تَحْتَمِلُ",51,"ل",1,1],["أطبقْتَ فوق شِفاهِ البئرِ تشربني؛","ماءُ الطَّوَايَا دمي ، يصفو ويَنْكَدِرُ!‏",52,"ر",1,0],["أطبقت في قسوة تلهو بناعمة","لم تدر غير الهوى إن ضمّه السحر",53,"ر",1,0],["أَطبقَ الصمتُ ولكن فَجأة","لمعت في خيمة الليل إضاءة",54,"ا",3,0],["أطبقتْ أجفانها في ساعة","أطبقَ التُربُ على (قيسٍ) مُهانا",55,"ن",2,0]]}