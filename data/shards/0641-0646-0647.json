],[5183,"بين العيد والمدرسة","https://www.poetsgate.com/ViewPoem.aspx?id=185683",""],[5302,"ملكت فؤادي","https://www.poetsgate.com/ViewPoem.aspx?id=202727",""],[5353,"الآتي الأخير","https://www.poetsgate.com/ViewPoem.aspx?id=212460",""],[5413,"عقيدتي","https://www.poetsgate.com/ViewPoem.aspx?id=200595",""],[5425,"يَا طَاعِنَاً ... والمُستَحِيْلُ حِرَابُهُ (جيش العراق)","https://www.poetsgate.com/ViewPoem.aspx?id=198923",""],[5447,"هطول","https://www.poetsgate.com/ViewPoem.aspx?id=208328",""],[5545,"ذَنبٌ يُفترى","https://www.poetsgate.com/ViewPoem.aspx?id=185000",""],[5690,"تسامت بك الدنيا فأنت أميرُها","https://www.poetsgate.com/ViewPoem.aspx?id=172156",""],[5690,"فديتك قم وارشف كؤوس المنافع","https://www.poetsgate.com/ViewPoem.aspx?id=172167",""],[5691,"وجبة تحقيق","https://www.poetsgate.com/ViewPoem.aspx?id=206390",""],[5943,"تشطير لتشطير ( ماذا عساني في هواك )","https://www.poetsgate.com/ViewPoem.aspx?id=138285",""],[5956,"الحب المُعَاد","https://www.poetsgate.com/ViewPoem.aspx?id=181934",""],[5956,"العدل نِسْبيٌّ","https://www.poetsgate.com/ViewPoem.aspx?id=184126",""],[5956,"القناعة كنز لا يفنى","https://www.poetsgate.com/ViewPoem.aspx?id=192382",""],[5956,"يزاحم موت الجديد القديما","https://www.poetsgate.com/ViewPoem.aspx?id=192401",""],[5957,"يا غيثَ قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=46976",""],[6043,"مرثيّة الأرض العالقة","https://www.poetsgate.com/ViewPoem.aspx?id=215591",""],[391,"ألاَ إنَّ هتداً أمسِ رثَّ جديدها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=16117&r=&rc=2",""]],"verses":[["فَنَهَضْنَا وَلا نُوَاحَ ثَكَالَى","وَرَقَدْنَا وَلا بُكَاءَ يَتَامَى",0,"م",2,0],["فَنَهنِهوهُ فَإِنّي غَيرُ تارِكُكُم","إِن عادَ ما اِهتَزَّ ماءٌ في ثَرى عودِ",1,"د",1,0],["فنهانا عنك الحياءُ طويلاً","ثم قد ردنا إليك الحياءُ",2,"ا",2,0],["فَنَهَضوا ثانِيَةً كُلُّهُم","وَرَفَعوا الكاساتِ تَنويها",3,"ي",3,0],["فَنَهَضتُ إِكراماً لَهُ","عَجِلاً وَقُمتُ تَأَدُّبا",4,"ب",2,0],["فَنَهَضَ الفيلُ وَزيرُ العُلا","وَقالَ يا ذا الشَرَفِ الأَرفَعِ",5,"ع",1,0],["فَنَهَضَ الأَوَّلُ لِلخِطابِ","فَقالَ إِنَّ الرَأيَ ذا الصَوابِ",6,"ب",1,0],["فَنَهَضَ الفيلُ المُشيرُ السامي","وَقالَ ما يَليقُ بِالمَقام",7,"م",1,0],["فَنَهرُ نَيزَكَ وِردٌ مِن مَوارِدِها","وَساحَةُ التَلِّ مُغنىً مِن مَغانيها",8,"ي",3,0],["فَنَهنَهَها ساعَةً ثُمَّ قالَ","لِلوازِعِيهِنَّ خَلّوا السَبيلا",9,"ل",2,0],["فَنَهاري جَليسُ لَيثِ عَرينٍ","وَمَسائي ضَجيعُ ظَبيِ كِناسِ",10,"س",1,0],["فنهضتُ أشرَقُ بالدموعِ كما","شَرِقَ الفضاء بكثرةِ السيلِ",11,"ل",1,0],["فَنُهْدي على عَجَلٍ قُبْلَةً","إلى شَفَةِ الرّشأِ الألْعَسِ",12,"س",1,0],["فَنَهَضتَ تَسحَبُ ذَيلَ جَيشٍ ساقَهُ","حُسنُ اليَقينِ وَقادَهُ الإِقدامُ",13,"م",1,0],["فَنَهَضنا نَمشي نُعَفّى مُروطاً","وَبُروداً وَهناً عَلى الآثارِ",14,"ر",1,0],["فَنَهى سُبحَةَ اليَقينُ وَما لا","قى عِطافٌ وَالمَوتُ مُحتَرِدُه",15,"د",2,0],["فَنَهَضَت نَحوَهُ حَثيثَةً","وَحَرَدَت حَردَةً تَسيبُ",16,"ب",1,0],["فَنَهنَهتُهُ حَتّى لَبِستُ مُفَاضَةً","مُضاعَفَةً كَالنِهيِ رِيحَ وأُمطِرا",17,"ر",2,0],["فنهوه عَن الحكومة لما","عاثَ فيها واستأثر استئثارا",18,"ر",2,0],["فنهضت بأمره العنايه","تحسن في نشأته البنايه",19,"ه",1,0],["فَنَهَضتُ أَشكو ما لَقيتُ لِبُعدِها","فَتَنَفَّسَت مِسكاً يُخالِطُ عَنبَرا",20,"ر",2,0],["فَنَهَارُهُ غَيْثُ اللَّهِيفِ ولَيْلُهُ","في طَاعَةِ الرَّحْمَنِ لَيْلُ الْعُبَّدِ",21,"د",1,0],["فَنهَضْتَ تَنْفَحُ عنْ قَضِيَّتِهِ","مَتحَمِّلاً مِنْ شَأْنِهَا وِقْرَا",22,"ر",2,0],["فَنَهارُه للصَّالحاتِ ولَيْلُهُ","لِلْبَاقياتِ وللنَّدَى والْجُودِ",23,"د",1,0],["فَنَهَضَتْ نَحْوَهُ حَثِيثًا","وحَرَّدتْ حَرْدَهُ تَسِيبُ",24,"ب",1,0],["فنُهدي على عجلٍ قُبلة","ً إلى شَفَة ِ الرّشَإ في الألْقسِ",25,"س",1,0],["فَنَهتَزُّ لِلُقيا وَنَقنَعُ بِالريا","إِلى اللَهِ أَشكو بَثَّ قَلبي وَوَجدَهُ",26,"ه",1,0],["فَنَهتَزُّ كالأَغصانِ ماسَ رَطيبُها","نَقولُ وَقَد طالَتوَقامَ خَطيبُها",27,"ه",2,0],["فنهضت عنها وهي تجذب ميزري","وتقول لي هل لا وقفت قليلا",28,"ل",2,0],["فنهارهُ صومٌ وأما ليلَه","فعلى استماعِ تلاوةِ القرآنِ",29,"ن",1,0],["فنهضت قبل الجيش لاستنقاذه","كالليث لا وكلا ولا متواني",30,"ن",2,0],["فَنَهنَهتُ عَنهُ القَومَ حَتّى كَأَنَّما","حَبا دونَهُ لَيثٌ بِخَفّانَ خادِرُ",31,"ر",1,0],["فنِهاية العَلْياءِ أنْ","زلُ ما علوتَ منَ المَراتب",32,"ب",1,0],["فنهضتُ مضطرباً أرى فإذا","بيديَّ من أسفي على قلبي",33,"ب",2,0],["فَنَهَت عُلومُ السِحرِ مِنهُ مُقلَةً","أَضحَت تَسِنُّ لَنا الغَرامَ وَتَفرِضُ",34,"ض",1,0],["فَنَهَضتَ نَهضَةَ حازِمٍ مُتَيَقِّظٍ","راضَ الأُمورَ مُدَرَّباً وَمُعَوَّدا",35,"د",2,0],["فنهضَت إليه","وَجلسَت لدَيهِ",36,"ه",1,0],["فَنِهايَةُ المُتَعَمِّقي","نَ تُجيرِ يا مُمعِنا",37,"ن",2,0],["فَنَهوى عَلَيهِ بِالعشية وَالَّذي","يَليها مِن اللَيل البَهيم عَلى القَتب",38,"ب",1,0],["فَنَهوهُ فَقُلتُ لا تَمنَعوهُ","وَدَعوهُ يَدورُ في حِلِّ شِعرِهِ",39,"ه",1,0],["فنهضت معتضداً وقد برز الهدى","من فيك والبركاتُ والرضوان",40,"ن",1,0],["فَنَهنَهتُ مِنها وَالمَناسِمُ تَرتَمي","بِمَعزاءَ شَتّى لا يُرَدُّ عَنودُها",41,"د",3,0],["فنهوى ثم تهوى","إلى أدنى الدنيات",42,"ت",1,0],["فَنَهبُك أرواحٌ تُنفِّلُها الظُّبَا","وسُمْرُ العَوالي والبلادُ مغانِمُ",43,"م",1,0],["فنهارُ البينِ لا كا","نَ نهارٌ ونُهارُ",44,"ر",1,0],["فنهاية الآمال عندك قطرة","من ذلك البحر الخضمّ الطامي",45,"م",2,0],["فَنَهَبْتَ عُمْرَ حياتِها وَحَوَيْتَ رِق","قَ حَريمِها وحَكَمْتَ فِي أَرواحِها",46,"ح",3,0],["فنهانا بك ما به سهو ولا","لغوٌ ونورك بالظلام يشوع",47,"ع",1,0],["فَنَهَجتُ أَنظُرُ ما الخَيالُ فَراعَني","وَالعَينُ غَيرُ حَديثَةٍ بِغِرارِ",48,"ر",1,0],["فنهر دمعي للوج","د في دمشق يزيد",49,"د",1,0],["فنهبٌ مباحٌ كل كنزٍ حياله","وما حظه إلاّ رضى المتفلسف",50,"ف",1,0],["فنهضَتْ بسُوقها ودرَجتْ","كَهلاً أثيثاً ومَعيناً غَدَقا",51,"ق",2,0],["فنهضت مسلوب البشاشة مقسما","ألا وطيت محاجر الوقاح",52,"ح",1,0],["فَنَهَضتُ في البَركِ الهُجودِ وَفي يَدي","لَونُ المَهَزَّةِ ذو كعوبٍ كَالنَوى",53,"ا",1,0],["فنهضة تاج المرسلين قويَّةٌ","وهمَّةُ مولانا الرفاعي عاليه",54,"ي",2,0],["فَنَهنَهتُ أولى القَومِ عَنّي بِضَربَةٍ","تَنَفَّسَ مِنها كُلُّ حَشيانِ مُجحَرِ",55,"ر",1,0],["فنَهوَى مَن تراهٌ العينُ طَوراً","ونَهَوى تارةً مَن لا تَراهُ",56,"ا",2,0],["فنهضتَ فيها قائِماً","بسِدادها والغيرُ قاعد",57,"د",1,0],["فنهودها الرمان فوق صدورها","منها حلا للناظرين المنظر",58,"ر",1,0],["فنهضت بالفرض المقدس ناهجاً","خير المناهج إنما لا تفخر",59,"ر",1,0],["فَنَهَضتُ لِلعَليا بِنَفسِكَ طالِعاً","أَنجادِها وَالفَضلُ لَيسَ يُعارُ",60,"ر",1,0],["فنهجت في دنياك أقومَ مَنهج","وفعلتِ ما يرضى بهِ مولاك",61,"ك",1,0],["فنهاه خياط الروايا قائلاً","هل غادر الشعراء من متردم",62,"م",1,0],["فنهارٌ تزورُ فيه نهارا","نِ وليلٌ تزورُ فيه نهار",63,"ر",1,0],["فنهضنا الى أشمّ كصدْرِ ال","رُمْح صعْلٍ في حالبيهِ اضطمارُ",64,"ر",1,0],["فنهجهم للمعالي لستَ تنهَجه","ولا تُريعُ لهم سرباً وتُزعِجه",65,"ه",1,0],["فنهى ولكن عن حقوقِ مودَّةٍ","لم يغدُ منتقِصاً عليَّ أساسُها",66,"س",3,0],["فنهنه من الوجدِ ما قد يعيبُ","وكفكفْ من العينِ دمعاً سكوبا",67,"ب",2,0],["فنهاني وقال هاك رضابي","وسقانيه طائعاً مسرورا",68,"ر",2,0],["فنهودهن تريكهن كواعبا","وعيونهن تريكهن رباربا",69,"ب",2,0],["فنهارنا بعد ارتحالك مقلةٌ","عمياء أو ديجورةً دهماء",70,"ا",2,0],["فنهنيك يا أغر السجايا","بقدوم من حجة التقريب",71,"ب",1,0],["فنِهايةُ المُثْني عليه وإِنْ غَلا","في وصفه التقصيرُ معْ إِطنابهِ",72,"ب",2,0],["فنهوضًا يا بني قومي إلى","شرف عالٍ ومجد مُعلَم",73,"م",1,0],["فنهضمُ فيها كُلَّ شكلٍ مسدسِ","كقطعةِ صخرِ حطَّه السيلُ من عَلوى",74,"و",2,0],["فَنهوضُها مَثنىً إِذا نَهَضت","مِن ثِقلَهِ وَقُعودها فَردُ",75,"د",1,0],["فنهر كالسجلجل قد تراءت","على شطيه جنات النعيم",76,"م",1,0],["فنهضنا لموعد كان منا","إذ سمعنا تجارب البكمان",77,"ن",1,0],["فنهضت مضطلعاً باعباء الهوى","من بين أهليه بغير تكلف",78,"ف",1,0],["فنهضتَ فيها داعياً ومبشّراً","مثلَ ابنِ عبداللهِ فى عدنان",79,"ن",1,0],["فَنهصُرُ مِن ذاكَ القوام أَراكَةً","وَتلثُمُ خَدّاً فيهِ وَردٌ مُضَعَّفُ",80,"ف",1,0],["فَنهصُرُ مِنهُ الغُصنَ وَالغُصنُ مائِسٌ","وَنُبصِرُ مِنهُ البَدرَ وَالبَدرُ طالِعُ",81,"ع",1,0],["فنهنه فتى العليا من الوجد بالأسى","فإنك جلدٌ والسى للفتى الجلد",82,"د",1,0],["فَنَهاري منَ البّلادةِ ليلٌ","في التساوي الليلُ مثلُ النّهارِ",83,"ر",1,0],["فنهضنا وقد تركنا بيوت الله","ومن بعدنا قفاراً طلولا",84,"ل",2,0],["فنهضت استرها وتسترني على","خوف الرقيب وحقنا ان نجزعا",85,"ع",2,0],["فنهارُنا قد كان ليلا مظل