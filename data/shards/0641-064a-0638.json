{"poems":[[53,"ولقد شهدت الخيل دامية","https://www.aldiwan.net/poem30449.html","الكامل"],[77,"زارت ونجم الدجى يشكو من الأرق","https://www.aldiwan.net/poem35921.html","البسيط"],[71,"ما قام لولا هواك المدنف الوصب","https://www.aldiwan.net/poem4015.html","البسيط"],[71,"لو لم يخالط يوم بينك أدمعي","https://www.aldiwan.net/poem4029.html","الكامل"],[71,"ماذا على طيف الأحبة لو سرى","https://www.aldiwan.net/poem4031.html","الكامل"],[93,"إنا نحيي حفلكم ويسرنا","https://www.aldiwan.net/poem11405.html","الكامل"],[88,"يا عدل طال الانتظار فعجل","https://www.aldiwan.net/poem44798.html","الكامل"],[37,"في ظل من عنت الوجوه له","https://www.aldiwan.net/poem6988.html","أحذ الكامل"],[72,"بالنصر والإقبال والبركات","https://www.aldiwan.net/poem18389.html","الكامل"],[72,"عود ببيت على الأفلاك معمور","https://www.aldiwan.net/poem18732.html","البسيط"],[51,"أحمد الله حمد شاكر نعمى","https://www.aldiwan.net/poem8505.html","الخفيف"],[51,"الحب ريحان المحب وراحه","https://www.aldiwan.net/poem9398.html","الكامل"],[51,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[51,"يسمو إلى المجد أقوام فتلهزهم","https://www.aldiwan.net/poem64525.html","البسيط"],[51,"لعدوك الحد الأفل","https://www.aldiwan.net/poem65918.html","مجزوء الكامل"],[91,"أنت والكأس في يدي فلمن أنت في غد","https://www.aldiwan.net/poem8801.html","عموديه"],[38,"بان الأحبة بالعهد الذي عهدوا","https://www.aldiwan.net/poem7699.html","البسيط"],[92,"نحن نمشي وحولنا هاته الأك","https://www.aldiwan.net/poem38888.html","الخفيف"],[92,"يا لاابتسامة قلب","https://www.aldiwan.net/poem38892.html","مجزوء الكامل"],[92,"يا أيها الطفل الذي قد","https://www.aldiwan.net/poem38926.html","مجزوء الكامل"],[92,"عجبا لي أود أن أفهم الكون","https://www.aldiwan.net/poem38932.html","الخفيف"],[92,"أيها الشعب ليتني كنت حطابا","https://www.aldiwan.net/poem38934.html","الخفيف"],[89,"طلعت كقرن الشمس بعد تبرقع","https://www.aldiwan.net/poem44950.html","الكامل"],[85,"أسلم محمد سيدى","https://www.aldiwan.net/poem6818.html","مجزوء الكامل"],[85,"يا قصر رأس التين","https://www.aldiwan.net/poem7145.html","السريع"],[85,"سر أبا صالح إلى الله واترك","https://www.aldiwan.net/poem62903.html","الخفيف"],[28,"تبعوا رسولهم بسنته","https://www.aldiwan.net/poem5130.html","الكامل"],[66,"إن جئت سلعا فسل عن جيرة العلم","https://www.aldiwan.net/poem38503.html","البسيط"],[66,"حوشيت من زفرات قلبي الواله","https://www.aldiwan.net/poem41372.html","الكامل"],[66,"صبرا على وعد الزمان وإن لوى","https://www.aldiwan.net/poem41578.html","الكامل"],[97,"طلق شجونك في ثرى الأحبابِ","https://www.aldiwan.net/poem24392.html","الكامل"],[97,"يا شطر نفسي وغرامي الوحيد","https://www.aldiwan.net/poem24986.html","السريع"],[80,"لله شمس كان أولها السها","https://www.aldiwan.net/poem31264.html","الكامل"],[80,"أوميض البرق في الليل البهيم","https://www.aldiwan.net/poem31292.html","الرمل"],[80,"أين مني عتب أحباب هجود","https://www.aldiwan.net/poem31481.html","الرمل"],[69,"في ظرف خمر خان مخدومه","https://www.aldiwan.net/poem28895.html","السريع"],[31,"صاد قلبي اليوم ظبي","https://www.aldiwan.net/poem42601.html","مجزوء الرمل"],[31,"حدث حديث فتاة حي مرة","https://www.aldiwan.net/poem42666.html","الكامل"],[105,"إنا أتينا بالثناء نسوقه","https://www.aldiwan.net/poem43402.html","الكامل"],[102,"لم تزل تهجرني منذ سنين","https://www.aldiwan.net/poem32920.html","الرمل"],[52,"يا رب يوم قد مضى","https://www.aldiwan.net/poem26683.html","مجزوء الكامل"],[48,"هل عرفت الربع أجلى","https://www.aldiwan.net/poem65035.html","مجزوء الرمل"],[48,"يا خليلي من بني مخزوم","https://www.aldiwan.net/poem65102.html","الخفيف"],[48,"حي الديار إذ الزمان زمان","https://www.aldiwan.net/poem66132.html","الكامل"],[50,"إن أمس منقبض اليدين عن الغنى","https://www.aldiwan.net/poem24572.html","الكامل"],[50,"يا دار بين الفرع والجناب","https://www.aldiwan.net/poem64871.html","الرجز"],[66,"","https://poetry.dctabudhabi.ae/diwan/poem/14439","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39632","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39601","الكامل"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30476","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54711","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55116","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55084","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54837","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54270","المديد"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54266","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54284","الخفيف"],[106,"لله شعرك!","https://www.poetsgate.com/ViewPoem.aspx?id=179701",""],[106,"تحية وقضية","https://www.poetsgate.com/ViewPoem.aspx?id=179292",""],[77,"زارت ونجم الدجى يشكو من الأرق","https://www.poetsgate.com/ViewPoem.aspx?id=34208",""],[100,"حزبية.. ومخبرون","https://www.poetsgate.com/ViewPoem.aspx?id=183586",""],[90,"في الطيارة أو على أبواب المفاوضات","https://www.poetsgate.com/ViewPoem.aspx?id=179078",""],[94,"نغمات عودي","https://www.poetsgate.com/ViewPoem.aspx?id=15651",""],[51,"لا يُعدمُ اللهُ يديك الصَّولا","https://www.poetsgate.com/ViewPoem.aspx?id=30269",""],[51,"أقسمتُ والحنثُ له آثامُ","https://www.poetsgate.com/ViewPoem.aspx?id=30408",""]],"verses":[["في ظُلمَةٍ مِن لَيلِ غَيهَبِها","ما إِن لَها إِلّا الرَدى فَجرُ",0,"ر",1,0],["في ظلِّ ممْلَكة منْ دونِ ساحَتِها","رِدْءٌ منَ اللهِ يحْمي حَوْزَها ويَقي",1,"ق",2,0],["في ظِلِّ أَبلَجَ يُستَسقى الغَمامُ بِهِ","فَيَستَهِلُّ وَيُستَشفى بِهِ الكلَبُ",2,"ب",1,0],["في ظِلِّ وَضّاحِ الجَبينِ سَمَيذَعٍ","مِن نَسلِ وَضّاحِ الجَبينِ سَميذَعِ",3,"ع",1,0],["في ظِلِّ مَيمونِ النَقيبَةِ طاهِر ال","أَعراقِ مَنصورِ اللِواءِ مُظَفَّرا",4,"ر",2,0],["فِي ظِلِّ زَيْنِ شَبَابِ مِصْرَ وَمَنْ لَهُ","فِي الشَّرْقِ أَجْمَعِهِ أَعَزِّ مَقَامِ",5,"م",1,0],["فيَظَلّ في دار الخِلافة راشياً","حتى يعود بمنصب كالأول",6,"ل",1,0],["في ظل من عنت الوجوه له","ملك الملوك ومالك الغَفْرِ",7,"ر",1,1],["في ظلّ ملك بالسعود تمنحت","في سائر الحركات والسكنات",8,"ت",1,0],["في ظلِّ ملكٍ تسرّ السيف نضرته","فهو الرشيد لديه سيف مسرور",9,"ر",1,0],["في ظلالٍ من الحرور وأَكنا","نٍ من القُرِّ جَمَّةِ الحُجَّابِ",10,"ب",1,0],["في ظله أمِنَ النَّخِيبُ فؤادُه","وبجوده انجبر الكسيرُ جَنَاحُهُ",11,"ح",2,0],["فيظل يَقْصُرُ للمسير طويلُه","ويبيت يُقْبَض للسُّرَى رحراحُه",11,"ح",2,0],["في ظلهِ الكلأُ المَري","عُ خلالَه الماء النميرُ",12,"ر",1,0],["في ظل عيشٍ مقيم لا زوال لهُ","وفي رداء شباب غير مبزوزِ",13,"ز",1,0],["في ظل عيش لا يزا","ل من النعيم عليهِ ظِلُّ",14,"ل",1,0],["فَيَظَلَّ الهِيامُ بي","يَنتَهي حَيثُ يَبتَدي",15,"ي",1,0],["في ظِلِّ مُرتَجِزٍ تَجلو بَوارِقُهُ","لِلناظِرَينِ رِواقاً تَحتَهُ نَضَدُ",16,"د",1,0],["في ظلامِ الفَنَاءِ أَدفُنُ أَيَّا","مي ولا أستطيعُ حتَّى بكاها",17,"ه",2,0],["في ظُلْمَةِ اللَّيلِ فاضَتْ","على الوُجُودِ حياتُهْ",18,"ه",1,0],["في ظُلْمَةِ اللَّيل الحزين","وفي الكُهوف العاريهْ",19,"ه",1,0],["في ظلامِ الكُهوفِ أَشباحُ شؤمٍ","وبهذا الفَضَاءِ أَطيافُ نَحْسِ",20,"س",1,0],["في ظلال الصَّنَوْبَرِ الحلوِ والزَّيتونِ","يقضي الحياة حَرْساً بحرْسِ",21,"س",1,0],["في ظل عيش نمت تحت جَناحه","نومَ الرضيع على ذراع المرضعِ",22,"ع",1,0],["في ظل أفضل جدَّة","ملأت سماء النيل طهرا",23,"ر",2,0],["في ظل رايات إما الهدى","وليس في الإمام آرتياب",24,"ب",1,0],["في ظِلالِ المُلوكِ تُدني إِلَيهِم","كُلَّ آوٍ لِظِلِّكَ المَمدودِ",25,"د",1,0],["في ظِلِّ مَن عَنَتِ الوُجوهُ لَهُ","حَكَمِ الحُكومِ وَمالِكِ القَهرِ",26,"ر",1,0],["في ظِلِّ أَبلَجَ مَنصورِ اللِواءِ لَهُ","عَدلٌ يُؤَلِّفُ بَينَ الذِئبِ وَالغَنَمِ",27,"م",1,0],["في ظِلِّ مَلكٍ مُذ حَلَلتُ بِرَبعِهِ","جاءَ الزَمانُ يَرومُ حَلَّ عِقالِهِ",28,"ل",2,0],["في ظِلِّ مَلكٍ مُذ حَلَلتُ بِرَبعِهِ","أَمسى لِسانُ الدَهرِ عَنّي أَلكَنا",29,"ن",2,0],["فيظل يدفع عنهم شبح الردى","ويردُّ ردَّ الواثق الغلابِ",30,"ب",1,0],["في ظل حبينا رحيب طليق","وكل ركن طيب في الوجود",31,"د",1,0],["في ظلّ منسدل الدجى جارتْ به","عيني التي هُدِيَتْ بأذن حصاني",32,"ن",2,0],["في ظلامٍ بَرَقَ الصبحُ له","فتولى عنه إجفالَ الظليم",33,"م",1,0],["في ظلامٍ طَنّبَتْ أكنافُهُ","فوق أرجاءِ وهادٍ وَنُجود",34,"د",1,0],["في ظرفِ خمرٍ خانَ مخدومَهُ","فامتلأَ المخدومُ غيظاً عليهْ",35,"ه",1,1],["في ظِباءٍ تَتَهادى","عامِداً لِلجَمَراتِ",36,"ت",1,0],["في ظِلِّ دانِيَةِ الغُصونِ وَريقَةٍ","نَبَتَت بِأَبطَحَ طَيِّبِ الثَرياءِ",37,"ا",2,0],["في ظِلِّ قَسوَرِكَ المُبارَكِ عَهدُهُ","عاشَ الَّذي لَقِيَ الحِمامَ مِرارا",38,"ر",2,0],["في ظلام الليل لاحت نجمةٌ","وهنا نجمٌ إليها مُطرِقا",39,"ق",2,0],["في ظِلِّ كَرمٍ لا يَطو","فُ بِهِ الهَجيرُ وَلا السُمومُ",40,"م",1,0],["في ظِباءٍ يَتَزاوَر","نَ فَيَمشينَ ثِقالا",41,"ل",2,0],["في ظِلالٍ مَحفوفَةٍ بِظِلالٍ","مِن كُرومٍ وَمِن عَريشِ كُرومِ",42,"م",1,0],["فَيَظَلُّ لِاِستِنبائِهِ وَكَأَنَّهُ","عَينٌ عَلى ما غَيَّبَ الكِتمانُ",43,"ن",1,0],["في ظِلِّ عَيشِ عَشيرَةٍ مَحمودَةٍ","تَندَى يَدي وَيُخافُ فَرطُ لِساني",44,"ن",2,0],["في ظِلِّ عَيشٍ مُترَعِ الحِلابِ","فَاِبكِ الصِبا في طَلَلٍ يَبابِ",45,"ب",1,0],["في ظِلالٍ عَلى الأَرائِكِ مِنها","وَالدَوالي ذاتِ القُطوفِ الدَواني",46,"ن",2,0],["في ظلالِ السِّلم أو نورِ الصفاءِ","حنَّ قيثاري لشعري وغنائي",47,"ي",1,0],["في ظُلَّةٍ باتت تُداعبُها","أنفاسُ ليْلٍ مُقمِرِ السُّحُبِ",48,"ب",1,0],["في ظِلِّ لَيْلٍ مِن الماذِىِّ مُعْتَكرٍ","يجلُو إِلى الخَيْلِ منه وَجْهُكَ الفَلقَا",49,"ق",2,0],["فِي ظِلِّ عَبَّاسِ العَظِيمِ مَلِيكِنَا","فَخْرِ الإِمَارَةِ رَبِّ هَذَا الْوَادِي",50,"د",2,0],["فَيَظَلُّ كَالمُغْضِي وَلَيْسَ بِحَاجِبٍ","عيْنَيْهِ سِتْرٌ مُحْكَمُ الإِسْبَالِ",51,"ل",1,0],["فِي ظِلاَلِ الخَمَائِلِ الخُضْرِ وَالصَّحرَاءُ","مِنْ حَوْلِهِ نِطَاقُ حَريقِ",52,"ق",1,0],["فيَظَلُّ البُطْل فِيهِ عَالِياً","وَيَظلُّ الحَقُّ عَنْهُ مُسْتَسِرَّا",53,"ر",2,0],["فِي ظِلِّ سَيِّدِنَا انْقَضَى لَكِنْ لَهُ","مَهْما يَغِبْ فِي الأَنْفُسِ اسْتِحْضَارُ",54,"ر",1,0],["في ظِلاَلٍ حَوْلهَا نَهَرٌ","غَيْرُ مَسْنُونٍ ولا أُسِن",55,"ن",1,0],["في ظُلُماتٍ مَوْجُها زاخرٌ","كأنّهُ ذو النُّونِ في بَحْرِهِ",56,"ر",2,0],["في ظِلالِ المَْلِيكِ عَزَّتْ وَطَالَتْ","واسْتَعَادَتْ فِرْدَوْسَها الْمَفْقُودا",57,"د",2,0],["في ظلِّ «مدرسة الق","ضاء»، وفي حمى «دار العلوم»",58,"م",1,0],["في ظلِّه لبَّى الجميعُ، وكبَّروا","وشَدَوْا بآياتِ الدعاء، ورتَّلوا",59,"ل",3,0],["في ظل مملكة من دون ساحتها","ردء من الله يحمي حوزها ويق",60,"ق",1,0],["فيظنوني أُناطق شيئاً","ويجيؤون لايرون نطيقي",61,"ق",2,0],["في ظل مغناك الكريم ولطفِه","ابداً أُجيد \" خواطراً \" ..و \" سوانحا \"",62,"ح",2,0],["في ظلمة الأحزان من نغماته","نفسي الحزينة تستعير النورا",63,"ر",2,0],["في ظلّ عيشٍ لم يخالط غَولا","تُجِدُّ فعلاً وتجدُّ قولا",64,"ل",2,0],["في ظلّ عزٍ منك لا يرامُ","يهضِمُه منك امرؤ هَضَّامُ",65,"م",1,0]]}