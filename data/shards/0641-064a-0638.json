et/poem47247.html","البسيط"],[549,"لي منزل ولمن سلاكم منزل","https://www.aldiwan.net/poem47334.html","الكامل"],[549,"عل البخيلة أن تجود لعاشق","https://www.aldiwan.net/poem47359.html","الكامل"],[549,"ريعت لتنعاب الغراب الهاتف","https://www.aldiwan.net/poem47390.html","الكامل"],[549,"يا خير باد في الأنام وحاضر","https://www.aldiwan.net/poem47789.html","الكامل"],[549,"هل هاج شوقك صوت الطائر الغرد","https://www.aldiwan.net/poem47848.html","البسيط"],[549,"يا طيف ألا زرتنا بسواد","https://www.aldiwan.net/poem47852.html","الكامل"],[549,"تلك الديار برامتين همود","https://www.aldiwan.net/poem47881.html","الكامل"],[556,"صدقت عباد الله أسماؤه الحسنى","https://www.aldiwan.net/poem33741.html","الخفيف"],[556,"الناس موصوفون بالأفعال","https://www.aldiwan.net/poem34198.html","الرجز"],[556,"إن ترم أن تعرف الأحوال","https://www.aldiwan.net/poem34230.html","المديد"],[556,"وجود حقيقي هو الغيب مطلق","https://www.aldiwan.net/poem34303.html","الطويل"],[556,"إن الوجود الحق بي يتلفظ","https://www.aldiwan.net/poem34399.html","الكامل"],[556,"أنا البرق والرب المناجي هو الرعد","https://www.aldiwan.net/poem34590.html","الطويل"],[560,"في ظل سلطاننا عبد العزيز بنى","https://www.aldiwan.net/poem52535.html","الطويل"],[560,"هجرت فبت بمقلة لم ترقد","https://www.aldiwan.net/poem52915.html","الكامل"],[560,"إن قلت ويحك فافعل أيها الرجل","https://www.aldiwan.net/poem52932.html","البسيط"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["في ظُلمَةٍ مِن لَيلِ غَيهَبِها","ما إِن لَها إِلّا الرَدى فَجرُ",0,"ر",1,0],["في ظلِّ ممْلَكة منْ دونِ ساحَتِها","رِدْءٌ منَ اللهِ يحْمي حَوْزَها ويَقي",1,"ق",2,0],["في ظِلِّ أَبلَجَ يُستَسقى الغَمامُ بِهِ","فَيَستَهِلُّ وَيُستَشفى بِهِ الكلَبُ",2,"ب",1,0],["في ظِلِّ وَضّاحِ الجَبينِ سَمَيذَعٍ","مِن نَسلِ وَضّاحِ الجَبينِ سَميذَعِ",3,"ع",1,0],["في ظِلِّ مَيمونِ النَقيبَةِ طاهِر ال","أَعراقِ مَنصورِ اللِواءِ مُظَفَّرا",4,"ر",2,0],["فِي ظِلِّ زَيْنِ شَبَابِ مِصْرَ وَمَنْ لَهُ","فِي الشَّرْقِ أَجْمَعِهِ أَعَزِّ مَقَامِ",5,"م",1,0],["فيَظَلّ في دار الخِلافة راشياً","حتى يعود بمنصب كالأول",6,"ل",1,0],["في ظل من عنت الوجوه له","ملك الملوك ومالك الغَفْرِ",7,"ر",1,1],["في ظلّ ملك بالسعود تمنحت","في سائر الحركات والسكنات",8,"ت",1,0],["في ظلِّ ملكٍ تسرّ السيف نضرته","فهو الرشيد لديه سيف مسرور",9,"ر",1,0],["في ظلالٍ من الحرور وأَكنا","نٍ من القُرِّ جَمَّةِ الحُجَّابِ",10,"ب",1,0],["في ظله أمِنَ النَّخِيبُ فؤادُه","وبجوده انجبر الكسيرُ جَنَاحُهُ",11,"ح",2,0],["فيظل يَقْصُرُ للمسير طويلُه","ويبيت يُقْبَض للسُّرَى رحراحُه",11,"ح",2,0],["في ظلهِ الكلأُ المَري","عُ خلالَه الماء النميرُ",12,"ر",1,0],["في ظل عيشٍ مقيم لا زوال لهُ","وفي رداء شباب غير مبزوزِ",13,"ز",1,0],["في ظل عيش لا يزا","ل من النعيم عليهِ ظِلُّ",14,"ل",1,0],["فَيَظَلَّ الهِيامُ بي","يَنتَهي حَيثُ يَبتَدي",15,"ي",1,0],["في ظِلِّ مُرتَجِزٍ تَجلو بَوارِقُهُ","لِلناظِرَينِ رِواقاً تَحتَهُ نَضَدُ",16,"د",1,0],["في ظلامِ الفَنَاءِ أَدفُنُ أَيَّا","مي ولا أستطيعُ حتَّى بكاها",17,"ه",2,0],["في ظُلْمَةِ اللَّيلِ فاضَتْ","على الوُجُودِ حياتُهْ",18,"ه",1,0],["في ظُلْمَةِ اللَّيل الحزين","وفي الكُهوف العاريهْ",19,"ه",1,0],["في ظلامِ الكُهوفِ أَشباحُ شؤمٍ","وبهذا الفَضَاءِ أَطيافُ نَحْسِ",20,"س",1,0],["في ظلال الصَّنَوْبَرِ الحلوِ والزَّيتونِ","يقضي الحياة حَرْساً بحرْسِ",21,"س",1,0],["في ظل عيش نمت تحت جَناحه","نومَ الرضيع على ذراع المرضعِ",22,"ع",1,0],["في ظل أفضل جدَّة","ملأت سماء النيل طهرا",23,"ر",2,0],["في ظل رايات إما الهدى","وليس في الإمام آرتياب",24,"ب",1,0],["في ظِلالِ المُلوكِ تُدني إِلَيهِم","كُلَّ آوٍ لِظِلِّكَ المَمدودِ",25,"د",1,0],["في ظِلِّ مَن عَنَتِ الوُجوهُ لَهُ","حَكَمِ الحُكومِ وَمالِكِ القَهرِ",26,"ر",1,0],["في ظِلِّ أَبلَجَ مَنصورِ اللِواءِ لَهُ","عَدلٌ يُؤَلِّفُ بَينَ الذِئبِ وَالغَنَمِ",27,"م",1,0],["في ظِلِّ مَلكٍ مُذ حَلَلتُ بِرَبعِهِ","جاءَ الزَمانُ يَرومُ حَلَّ عِقالِهِ",28,"ل",2,0],["في ظِلِّ مَلكٍ مُذ حَلَلتُ بِرَبعِهِ","أَمسى لِسانُ الدَهرِ عَنّي أَلكَنا",29,"ن",2,0],["فيظل يدفع عنهم شبح الردى","ويردُّ ردَّ الواثق الغلابِ",30,"ب",1,0],["في ظل حبينا رحيب طليق","وكل ركن طيب في الوجود",31,"د",1,0],["في ظلّ منسدل الدجى جارتْ به","عيني التي هُدِيَتْ بأذن حصاني",32,"ن",2,0],["في ظلامٍ بَرَقَ الصبحُ له","فتولى عنه إجفالَ الظليم",33,"م",1,0],["في ظلامٍ طَنّبَتْ أكنافُهُ","فوق أرجاءِ وهادٍ وَنُجود",34,"د",1,0],["في ظرفِ خمرٍ خانَ مخدومَهُ","فامتلأَ المخدومُ غيظاً عليهْ",35,"ه",1,1],["في ظِباءٍ تَتَهادى","عامِداً لِلجَمَراتِ",36,"ت",1,0],["في ظِلِّ دانِيَةِ الغُصونِ وَريقَةٍ","نَبَتَت بِأَبطَحَ طَيِّبِ الثَرياءِ",37,"ا",2,0],["في ظِلِّ قَسوَرِكَ المُبارَكِ عَهدُهُ","عاشَ الَّذي لَقِيَ الحِمامَ مِرارا",38,"ر",2,0],["في ظلام الليل لاحت نجمةٌ","وهنا نجمٌ إليها مُطرِقا",39,"ق",2,0],["في ظِلِّ كَرمٍ لا يَطو","فُ بِهِ الهَجيرُ وَلا السُمومُ",40,"م",1,0],["في ظِباءٍ يَتَزاوَر","نَ فَيَمشينَ ثِقالا",41,"ل",2,0],["في ظِلالٍ مَحفوفَةٍ بِظِلالٍ","مِن كُرومٍ وَمِن عَريشِ كُرومِ",42,"م",1,0],["فَيَظَلُّ لِاِستِنبائِهِ وَكَأَنَّهُ","عَينٌ عَلى ما غَيَّبَ الكِتمانُ",43,"ن",1,0],["في ظِلِّ عَيشِ عَشيرَةٍ مَحمودَةٍ","تَندَى يَدي وَيُخافُ فَرطُ لِساني",44,"ن",2,0],["في ظِلِّ عَيشٍ مُترَعِ الحِلابِ","فَاِبكِ الصِبا في طَلَلٍ يَبابِ",45,"ب",1,0],["في ظِلالٍ عَلى الأَرائِكِ مِنها","وَالدَوالي ذاتِ القُطوفِ الدَواني",46,"ن",2,0],["في ظلالِ السِّلم أو نورِ الصفاءِ","حنَّ قيثاري لشعري وغنائي",47,"ي",1,0],["في ظُلَّةٍ باتت تُداعبُها","أنفاسُ ليْلٍ مُقمِرِ السُّحُبِ",48,"ب",1,0],["في ظِلِّ لَيْلٍ مِن الماذِىِّ مُعْتَكرٍ","يجلُو إِلى الخَيْلِ منه وَجْهُكَ الفَلقَا",49,"ق",2,0],["فِي ظِلِّ عَبَّاسِ العَظِيمِ مَلِيكِنَا","فَخْرِ الإِمَارَةِ رَبِّ هَذَا الْوَادِي",50,"د",2,0],["فَيَظَلُّ كَالمُغْضِي وَلَيْسَ بِحَاجِبٍ","عيْنَيْهِ سِتْرٌ مُحْكَمُ الإِسْبَالِ",51,"ل",1,0],["فِي ظِلاَلِ الخَمَائِلِ الخُضْرِ وَالصَّحرَاءُ","مِنْ حَوْلِهِ نِطَاقُ حَريقِ",52,"ق",1,0],["فيَظَلُّ البُطْل فِيهِ عَالِياً","وَيَظلُّ الحَقُّ عَنْهُ مُسْتَسِرَّا",53,"ر",2,0],["فِي ظِلِّ سَيِّدِنَا انْقَضَى لَكِنْ لَهُ","مَهْما يَغِبْ فِي الأَنْفُسِ اسْتِحْضَارُ",54,"ر",1,0],["في ظِلاَلٍ حَوْلهَا نَهَرٌ","غَيْرُ مَسْنُونٍ ولا أُسِن",55,"ن",1,0],["في ظُلُماتٍ مَوْجُها زاخرٌ","كأنّهُ ذو النُّونِ في بَحْرِهِ",56,"ر",2,0],["في ظِلالِ المَْلِيكِ عَزَّتْ وَطَالَتْ","واسْتَعَادَتْ فِرْدَوْسَها الْمَفْقُودا",57,"د",2,0],["في ظلِّ «مدرسة الق","ضاء»، وفي حمى «دار العلوم»",58,"م",1,0],["في ظلِّه لبَّى الجميعُ، وكبَّروا","وشَدَوْا بآياتِ الدعاء، ورتَّلوا",59,"ل",3,0],["في ظل مملكة من دون ساحتها","ردء من الله يحمي حوزها ويق",60,"ق",1,0],["فيظنوني أُناطق شيئاً","ويجيؤون لايرون نطيقي",61,"ق",2,0],["في ظل مغناك الكريم ولطفِه","ابداً أُجيد \" خواطراً \" ..و \" سوانحا \"",62,"ح",2,0],["في ظلمة الأحزان من نغماته","نفسي الحزينة تستعير النورا",63,"ر",2,0],["في ظلّ عيشٍ لم يخالط غَولا","تُجِدُّ فعلاً وتجدُّ قولا",64,"ل",2,0],["في ظلّ عزٍ منك لا يرامُ","يهضِمُه منك امرؤ هَضَّامُ",65,"م",1,0],["في ظلمة القبر للثاوي به فرجٌ","وفي التراب تواف الهم أحيان",66,"ن",1,0],["في ظل خربوش واهي الطنب ذي طنف","رث حقير كأهليه المساكين",67,"ن",1,0],["في ظل متبوعي أمير الأمرا","أَمعسر تقول هبه معسرا",68,"ر",2,0],["فيَظُنَّ زَفرَتك النِّيام","بوقَ النُشورِ ليوم دِين",69,"ن",1,0],["فَيَظَلُّ القَلبُ مِنها","هائِماً في كُلِّ وادي",70,"د",2,0],["في ظِلِّ أَروعَ إِن تَسأَلهُ مُنفِسَهُ","يَهَب وَإِن باشَرَ الهَيجاءَ لَم يَهَبِ",71,"ب",1,0],["في ظِلِّ أَروَعَ أَعجَزَت أَفعالُهُ","هَذا الأَنامَ وَأَعوَزَت أَنظارُهُ",72,"ر",2,0],["في ظِلِّ أَروَعَ لا يَمُرُّ بِبُقعَةٍ","إِلّا وَكانَ تُرابُها مَلثوما",73,"م",2,0],["في ظِلِّ خَيرِ خَلِيفَةٍ مِن هاشِمٍ","وَرِثَ الكِتابَ وَأُلهِمَ التَنزيلا",74,"ل",2,0],["في ظلِّ نعمةِ شاهِنْشاهَ مشتملا","بفضلِه حيث لا ضعفٌ ولا هَرَم",75,"م",1,0],["في ظلِّ شاهِنْشاهَ مرتِفعٌ","عن نائبات الدهر في حَرَم",76,"م",1,0],["فيظن سامعُها لحُسن نظامها","أن قد نثرتُ لسامعيه سِخابا",77,"ب",2,0],["في ظلال على الارائك اسقى","سلسبيلا ختامها من رحيق",78,"ق",1,0],["في ظلها طال بي شقائي","إني شقيٌ بها سعيد",79,"د",1,0],["في ظل أهداب عيونك وود خدّك آل","وحسن يوسف ميراث عنه لوجهك آل",80,"ل",1,1],["في ظِلِّ بابِكَ أَفنَيتُ الصِبا مَرَحاً","فَحاشَ لِلَهِ أَن تَشقي بِكَ الهَدمُ",81,"م",1,0],["في ظُهورِ الجِيادِ مِنهُم أُسودٌ","وَصُدورِ الدُسوتِ مِنهُم جِبالُ",82,"ل",1,0],["في ظِلِ نُعمى لا تَنقَضي أَبَدا","ما اِمتَدَّ مِنها وَيَنقَضي الأَمَدُ",83,"د",1,