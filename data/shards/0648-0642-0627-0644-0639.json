{"poems":[[74,"بروحي مشروط على الخد أسمر","https://www.aldiwan.net/poem19145.html","الطويل"],[74,"وقالع من جنتي خده","https://www.aldiwan.net/poem20105.html","السريع"],[47,"تحمل آل سعدى للفراق","https://www.aldiwan.net/poem65210.html","الوافر"],[46,"أمالك إن الحزن أحلام حالم","https://www.aldiwan.net/poem30352.html","الطويل"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[164,"ألا يا رسول الله غارة ثائر","https://www.aldiwan.net/poem59215.html","الطويل"],[409,"ألم بجسمي عارض طال مكثه","https://www.aldiwan.net/poem33451.html","الطويل"],[409,"رجعت عن النظم الذي قلت في النجدي","https://www.aldiwan.net/poem33948.html","الطويل"],[422,"على أي وجد طويت الضلوعا","https://www.aldiwan.net/poem53848.html","المتقارب"],[520,"في مثل مدحك شرح القول مختصر","https://www.aldiwan.net/poem12117.html","البسيط"],[563,"تفاخر الماء والهواء","https://www.aldiwan.net/poem35076.html","مخلع البسيط"],[572,"تبارك فاطر القمر اقتدارا","https://www.aldiwan.net/poem69691.html","الوافر"],[877,"","https://poetry.dctabudhabi.ae/diwan/poem/204000","الوافر"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77539","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77496","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77561","الرجز"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59425","الطويل"],[1115,"","https://poetry.dctabudhabi.ae/diwan/poem/138805",""],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112715","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112877","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84506","البسيط"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122057","الطويل"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44877","البسيط"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124716","الطويل"],[2105,"","https://poetry.dctabudhabi.ae/diwan/poem/101775","الرجز"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53159","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/141735","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109453","الرجز"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129823","السريع"],[2789,"","https://poetry.dctabudhabi.ae/diwan/poem/21596","الطويل"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140069",""],[3112,"","https://poetry.dctabudhabi.ae/diwan/poem/130449","الرجز"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138698",""],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199030","الرجز"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199029","الرجز"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128919","المجتث"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111496","البسيط"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127058","البسيط"],[4859,"أنين القهر","https://www.poetsgate.com/ViewPoem.aspx?id=186799",""],[592,"ألا قل لذي جهلٍ بكل الحقائق","https://www.poetsgate.com/ViewPoem.aspx?id=128798",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5444,"عصامي العلا","https://www.poetsgate.com/ViewPoem.aspx?id=205517",""],[5790,"صبا وهو غربيب الذوائب ما صبا","https://www.poetsgate.com/ViewPoem.aspx?id=111942",""],[5956,"الرسالة المحمدية","https://www.poetsgate.com/ViewPoem.aspx?id=184653",""]],"verses":[["وقال على اللثم اشترطنا فلا تزد","فقبَّلته ألفاً على ذلك الشرط",0,"ط",1,0],["وقالع من جنتي خدّه","نبتاً به العشاق قد هاموا",1,"م",3,1],["وَقالَ عَواذِلي رِفقاً وَمَن لي","بِرِفقٍ عِندَ تَفريقِ الرِفاقِ",2,"ق",1,0],["وَقالَ عَلِيٌّ في التَعازي لِأَشعَثٍ","وَخافَ عَلَيهِ بَعضَ تِلكَ المَآثِمِ",3,"م",1,0],["وَقالَ عَنهُ بُحَيرا حِينَ أَبصَرَهُ","بَأَرضِ بُصرى مَقالاً غَيرَ مُتَّهَمِ",4,"م",1,0],["وقال عذاب الله عذب وربنا","ينعم في نيرانه كل فاجر",5,"ر",1,0],["وقال عذاب النار عذب لأهله","فما سقر إلا كدار سلام",6,"م",1,0],["وقال عَليٌّ في الخوارج إنهم","من الكفر فَرُّوا بعد فعلهم الْمُرْدِي",7,"د",2,0],["وقال عذولُك لما رآك","وما كنتَ للوجد يوماً مذيعا",8,"ع",2,0],["وقال عزمك لما أن ألح ولم","تلح له منهم عين ولا أثر",9,"ر",1,0],["وقال عني الإله رجس ال","شيطان بي ذاهب هباء",10,"ا",2,0],["وقال عطاردُ كُنْ لي نَظِيْراً","فَكُنْتَ لَهُ أجَلَّ من النّظِيْرِ",11,"ر",1,0],["وقال علي بالطباخ حتى","يزيد من البوازد والبقول",12,"ل",1,0],["وَقالَ عُذري يا بن عَمّي جَهلي","وَقلّة المال وَفَقر أهلي",13,"ي",1,0],["وَقالَ عَن إِذنك يا تيس الجَبَل","قَد خَرَجَ الشَيطان مِثلَما دَخَل",14,"ل",1,0],["وَقالَ عَن إِذنك يا ديك الخَلا","في مَرة أُخرى أَراكَ مُقبِلا",15,"ل",2,0],["وقال عذولي أنت في الحب مدعي","فهل لك في إبطال دعوى المنازع",16,"ع",1,0],["وقالع صخرة القليب وقد","أعيت جموعا بجذب راحته",17,"ت",2,0],["وق العذاب وجد بالعفو وارض وهب","حسن القبول وإدراك السعادات",18,"ت",1,0],["وق العذاب وجنبني الهوى أبدا","واجعل ثناك بقلبي دائماً وفمي",19,"م",2,0],["وقال عندي يا إمام من لحن","واللحن في أبنائنا من المحن",20,"ن",1,0],["وقال عودي فعادت وهي يانعة","خضراء وكانت أضعف الرتم",21,"م",1,0],["وَقَالَ عَذُولِي حِينَ لاَحَ عِذَارُهُ","بِوَجْنَتِهِ انْهَرْهُ وَإِنِّي لَقَائِلُ",22,"ل",1,1],["وَقالَ عَنهُ العَذولُ سالٍ","قَلَّدَهُ اللَّهُ ما تَقَلَّد",23,"د",1,0],["وقال على العرشِ استوى فاستواؤه","عليه استواءٌ الملك للفرد ذي القدم",24,"م",1,0],["وقال عليهم صل يعني ترحما","به للنبي الطاهر الزاهر الأشم",24,"م",1,0],["وقالَ عنِّي إنني","كنتُ نَدِيم المُتَّقِي",25,"ق",2,0],["وقال عذَّالي سَلا عن حبهم","وراحتي في قولهم لو صدقوا",26,"ق",3,0],["وقال عليكم مثلُ ما جئتم به","فقامَ خبيرُ القومِّ يمنحني القِرى",27,"ا",1,0],["وقال عنها ان علم الكيميا","يكون منها وكذاك السيميا",28,"ي",2,0],["وقال عنها شيخنا المبرد","ان الشقي بهواها يسعد",28,"د",1,0],["وقال عرّفهُ بأنّي سأح","تال فما أجتنبُ المكتبا",29,"ب",2,0],["وَقالَ عَلَيكِ الصَبرَ كَوني سَبيَّةً","كَما كُنتِ أَو مَوتي فَذَلِكَ أَقرَبُ",30,"ب",1,0],["وقال عوضت هذا عن الس","وسن فاكتمه ولا تبدي",31,"د",2,0],["وقال عندما أتى اليه","شيثٌ ونورث المصطفى لديهِ",32,"ه",1,0],["وقال على الدار لما اصبت","بني العفا برياح النكاد",33,"د",1,0],["وقال عباد به فصدقوا","بأنه حي لديه يرزق",34,"ق",1,0],["وقال عن هشام المؤيد","بأنه قد صار رهن الملحد",35,"د",1,0],["وقال عودي اليه","فأيدت ذاك أمي",36,"ي",1,0],["وَقالَ عُوِّدتَ هَكطورٌ مُعارَضَتي","إِذا اِقتَرَحتُ مَقالاً بَينَنا حَسُنا",37,"ن",2,0],["وقالع الصخرة الصماء إذ عجزت","عنا الألوف من الجيش العراقي",38,"ي",1,0],["وقال:عودي إلى الرحمنِ راغبةً","فعند ربي هناء المؤمنِ الفطنِ",39,"ن",1,0],["وقال عناد للهداة الذين هم","أحق وأهدى من غوى منافق",40,"ق",1,0],["وقال علي بن الحسين لمن أتى","إلى فرحةٍ يدعو مقالة ذي رشد",41,"د",1,0],["وقال عليكم باتباعٍ لسنتي","وما الخلفا سنوه بعدي ليعلما",42,"م",2,0],["وقال: عمانُ استقبلي قلبَ عاشقٍ","فألفى على شطآنِ أمجادِها صحبا",43,"ب",2,0],["وقال على رأسي أزورك صاغرا","إذا لم يكن غير الأسنة مركبا",44,"ب",2,0],["وقال عبادة الأصنا","مِ رجسٌ لوّثَ الفِكَرا",45,"ر",2,0]]}