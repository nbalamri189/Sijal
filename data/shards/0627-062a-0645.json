s://www.aldiwan.net/poem46616.html","الطويل"],[209,"تصارع في سلم الجمال","https://www.aldiwan.net/poem46803.html","الطويل"],[229,"يا حداة الركب الحجازي ميلوا","https://www.aldiwan.net/poem44577.html","الخفيف"],[268,"أدر خمرة ما بين هم وتفليس","https://www.aldiwan.net/poem35283.html","الطويل"],[268,"لأبي عبيدة في دمشق وخالد","https://www.aldiwan.net/poem35645.html","الكامل"],[303,"إلى بيتك اللهم بالعزم أقبلنا","https://www.aldiwan.net/poem56383.html","الطويل"],[326,"كذبت هند حين قالت لك القل","https://www.aldiwan.net/poem54941.html","الخفيف"],[326,"فوق هذي الربا أقمت وحيدا","https://www.aldiwan.net/poem54989.html","الخفيف"],[336,"أتم الناس أعرفهم بنقصه","https://www.aldiwan.net/poem68654.html","الكامل"],[351,"من لعين اروقة لا تنام","https://www.aldiwan.net/poem40589.html","عموديه"],[361,"ولم أر هالكا من أهل نجد","https://www.aldiwan.net/poem1710.html","الوافر"],[362,"لست أنسى لياليا قد تقضت","https://www.aldiwan.net/poem60606.html","الخفيف"],[362,"أمل على القلب الغرام فأبلغا","https://www.aldiwan.net/poem60842.html","الطويل"],[364,"أتملأ من خديك كأس مدامة","https://www.aldiwan.net/poem17095.html","الطويل"],[374,"علاك الفضل في طي الجمال","https://www.aldiwan.net/poem59291.html","الوافر"],[374,"لك الله من علم إلى الحق رافع","https://www.aldiwan.net/poem59347.html","الطويل"],[377,"أصبح الجسم بالجروح موشى","https://www.aldiwan.net/poem49224.html","الخفيف"],[377,"مسني الضر من صدودك عني","https://www.aldiwan.net/poem49257.html","الخفيف"],[429,"أتمنحنا أوطانهن الكواكب","https://www.aldiwan.net/poem12564.html","الطويل"],[450,"ليت عندي الحبيب أو","https://www.aldiwan.net/poem13719.html","مجزوء الخفيف"],[451,"غطست فيه حين بعثرت","https://www.aldiwan.net/poem61334.html","الخفيف"],[456,"سل بسلع شجنا كان وكنا","https://www.aldiwan.net/poem55822.html","الرمل"],[456,"أتمنى والمنى جهد المقل","https://www.aldiwan.net/poem55996.html","الرمل"],[462,"طرقت ريح الصبا ميثاء وهنا","https://www.aldiwan.net/poem3594.html","عموديه"],[477,"بعد أحبابي كساني الأرقا","https://www.aldiwan.net/poem36922.html","الرمل"],[498,"لي قلب في الحب مضنى عليل","https://www.aldiwan.net/poem37927.html","الخفيف"],[538,"أتمضي ولم تلمم على الطلل الفقر","https://www.aldiwan.net/poem56816.html","الطويل"],[549,"ألا يا أيها الحادي","https://www.aldiwan.net/poem47850.html","الهزج"],[549,"أتمضي كذا أيدي الردى بالمصاعب","https://www.aldiwan.net/poem48057.html","الكامل"],[549,"لا تسلني عما أراه فإني","https://www.aldiwan.net/poem48071.html","الخفيف"],[562,"أأنت على عهد المحبة ماكث","https://www.aldiwan.net/poem830.html",""],[573,"طراز غرامي في المحبة مذهب","https://www.aldiwan.net/poem2984.html","الطويل"],[584,"بتثني قوامك الممشوق","https://www.aldiwan.net/poem17628.html","الخفيف"]],"verses":[["أَتَمَنّى لَكِ أَن تَب","قَي عَلى النَأيِ وَريقَه",0,"ق",2,0],["أَتَمشي بِهِ شُمَّ الأُنوفِ عُداتُهُ","وَرَبُّ الحِمى يَمشي بِأَنفٍ مُجَدَّعِ",1,"ع",1,0],["أَتَمَناهُم وَهَيهاتَ أَقصى ال","دَهرُ عَنهُم داري وَشَطَّ مَزاري",2,"ي",1,0],["أَتَمَّ لَهَا بِبِرٍّ ابْنُ وَفَّى","أَعَزَّ مَطَامِعِ الأُمِّ الرَؤُومِ",3,"م",1,0],["أَتَمَنَّى الإسْهَابَ وَالشَّوْطُ رَحْبٌ","غَيْرَ أَنِّي أَخَافُ غَيْظَ الحَلِيمِ",4,"م",1,0],["أَتَمُوتُ حَتفَ الأَنْفِ يَا ضِرْغَامُ","وَتَنَالُ مِنْ عِزمَاتِكَ الأَسْقَامُ",5,"م",1,1],["أتمنّى له السعادة لكن","ليس لي فيه ناقة منتوجه",6,"ج",2,0],["أتمنّى بأن أطير إليهم","بجناح وأين مِنّي الجناح",7,"ح",1,0],["أَتَمدَحُ يا اِبنَ القَينِ سَعداً وَقَد جَرَت","لِجِعثِنَ فيهِم طَيرُها بِالأَشائِمِ",8,"م",1,0],["أَتَمدَحُ مالِكاً وَترَكتَ تَيماً","وَقَد كانوا هُمُ الغَرَضَ المُصابا",9,"ب",2,0],["أَتَمنَعُ مُخضَرَّ السَحابِ عَجائِزٌ","لَهُنَّ بِأَطنابِ البُيوتِ هَريرُ",10,"ر",1,0],["أَتَمدَحُ سَعداً حينَ أَخزَت مُجاشِعاً","عَقيرَةُ سَعدٍ وَالخِباءُ مُكَشَّفُ",11,"ف",1,0],["أَتَمَّ اللَهُ نِعمَتَهُ عَلَيكُم","وَزادَ اللَهُ مُلكَكُمُ تَماما",12,"م",2,0],["أَتَمضونَ الرُسومَ وَلا تُحَيّا","كَلامُكُمُ عَلَيَّ إِذاً حَرامُ",13,"م",1,0],["أتمت مساعيك الزّكية نسكها","وما فاتنا من جود كفّك منجع",14,"ع",1,0],["أتمَّت حلا مرآه حليَة حبره","فلا عدِمت منه العلى بدرَ تمّها",15,"م",3,0],["أتُمتِعُني عيني عليك بدمعة","وأنت لأذيال الرَّوامس مُدْرَجُ",16,"ج",1,0],["أتمَّ له الإحسانُ حُسْنَ روائهِ","وأضحى من الإحسان والحُسْنِ حاليا",17,"ل",3,0],["أَتَمضي أَنتَ مُنفَرِداً وَأَبقى","لَقَد غَدَرَتكَ نَفسُكَ ياوَفِيُّ",18,"ي",1,0],["أَتَمَنّى لِمِصرَ أَن يَجري الخَي","رُ لَها مِن يَمينِهِ وَشِمالِه",19,"ل",2,0],["أَتُمَنِّعينَ قِرىً فَتَفتَضِحي","أَم تَبذُلينَ لَهُ الَّذي يَسَلُ",20,"ل",1,0],["أَتُمسِكُ ما أَولَيتَهُ يَدُ عاقِلٍ","وَتُمسِكُ في كُفرانِهِ بِعِنانِ",21,"ن",1,0],["أَتَمَّ سَعدَكَ مَن لَقّاكَ أَوَّلَهُ","وَلا اِستَرَدَّ حَياةً مِنكَ مُعطيها",22,"ي",3,0],["أَتَمَّ اللَهُ نُعماكُم فَإِنّي","رَأَيتُكُمُ النِهايَةَ في التَمامِ",23,"م",1,0],["أَتَمُّ الناسُ أَعرَفُهُم بِنَقصِه","وَأَقمَعُهُم لِشَهوَتِهِ وَحِرصِه",24,"ص",2,1],["أَتَمَنّى العِراقَ في أَرضِ حَرّا","نَ وَهَل تُدرِكُ الثُرَيّا سُهيلا",25,"ل",2,0],["أتمنى الموت من مقلته","ما الذي يمنع أن أشتاق فاه",26,"ا",2,0],["أتمعن في الهجر حتى ترانا","بكينا دما واحترقنا فما",27,"م",2,0],["أَتُمتَحَنُ القِسِيُّ بِغَيرِ نَبلٍ","أَيُخطِئُ مُبتَليها أَم يُصيبُ",28,"ب",1,0],["أَتَمَنَّاهُمُ وَدُونَ التَّلاقِي","قُذُفَاتٌ مِنْ لُجِّ أَخْضَرَ طَامِي",29,"م",2,0],["أَتَمُرُّ لا تَلوي عَلى مَثوى أَخي","ثِقَةً وَلا تَقِفُ الرِكابَ فُواقا",30,"ق",2,0],["أَتَملِكُ دَوحَةُ المُلكِ اِرتِفاعاً","إِذا مالَت حِفافَيها الغُصونُ",31,"ن",1,0],["أَتُمْسِي الأمُّ تُعزَلُ عن بَنِيها","لِمَوْلىً غيرِ مولاهم وجَارِ",32,"ر",1,0],["أَتَمَنَّيت فِراقي","فَلَقَد نِلتَ مُناكا",33,"ك",2,0],["أَتَمنَعُ ريقَكَ المَعسولَ عَنّي","وَأَنتَ عَلى الجِدارِ بِهِ تَجودُ",34,"د",1,0],["أَتَمَنّى وَما بِكَفِّيَ مِنها","غَيرُ مَطلٍ وَغَيرُ سوءِ اِنتِظارِ",35,"ر",1,0],["أَتَمُّ مِنَ النُسورِ بَقاءَ عُمرٍ","نُسورُ الطَيرِ لا الشُهُبِ السَواري",36,"ي",1,0],["آت من الشمس فيما","تفيضه من ضياء",37,"ا",2,0],["أَتَموت أَم تعنو لأح","كامٍ عليها قد قَضاها",38,"ا",3,0],["أتملَّاها سماتٍ عربيّهْ","وأنادي أنتِ يا أندلسيَّهْ",39,"ه",1,0],["أتَمْشي القَوافي تحتَ غيرِ لِوائنا","ونحْنُ على قُوّالِهَا أُمَراء",40,"ر",3,0],["أَتَمَنَّاهُ غَيْرَ أَنَّ فُؤَادِي","مِنْ إِسَارِ النَّوَى مُحَاطٌ بِجُنْدِ",41,"د",1,0],["أُتِمَّ بِالخُلْقِ الرَّاقِي تَأَدُّبُهُمْ","وَلاَ نَجَاحَ بِلاَ عَوْنٍ مِنَ الخُلُقِ",42,"ق",1,0],["أَتَمْضِي أَبَا شَادٍ وَفِي ظَنِّ مَنْ يَرَى","زُهُورَكَ أَنَّ النَّجْمَ قَبْلَكَ خَالِي",43,"ي",1,0],["أَتْمْكِنُنَا مِنْ بَارِحِ الأُنْسِ عُزْلَةٌ","وَجَارَا رِضَانَا نَاقِمٌ وَغَضُوبُ",44,"ب",1,0],["أَتَمَّ فِيهَا هَنَاءَ سَامِرِهَا","فَأَوْدَعَ المَاءَ نَشْوَةَ الخَمْرِ",45,"ر",1,0],["أَتْمِمْ حَلاَهُ بِحُلَى لاَبِسِهِ","مِنْ حِكْمَةٍ وَرَحْمَةٍ وَخَيْرِ",46,"ر",1,0],["أَتَمَثَّلَتْ لَكَ مِصْرُ فِي تَصْوِيرهِ","بِضَفَافِهَا وَجِنَانِهَا الْفيْحَاءِ",47,"ا",2,0],["أتموت من فرط الهزال صغاركم","لتعزّ شوكتها ويسمن كيسها",48,"س",3,0],["أَتَمَنّى وَلَيسَ لي عَمَلٌ زا","كٍ وَلكِن وَسيلَتي الإِسلامُ",49,"م",1,0],["أتموت بين عشية ونهارِ؟","يا للدمارِ، وقسوة الأقدارِ؟",50,"ر",1,1],["أتمنى لو كنت بؤبؤ عيني","أتراني طلبت ما ليس يطلب",51,"ب",1,0],["أتمنى الموت من قلِتهِ","ما الذي يمنع أن أشتاق فاه",52,"ا",2,0],["أَتَمَّ وُلاة الحَق عِلماً وَهمة","وَأَشرَف مَن دانَت لِهِمَتِهِ العُليا",53,"ي",2,0],["أَتَمنى خَيالَهُ وَبَعيد","أَن يَزور الخَيال طَيف الخَيال",54,"ل",1,0],["أَتَمنى دَفع الرَدى وَالأَماني","ساخِرات مِن طالِعي وَجُدودي",55,"ي",1,0],["اتمرضنا وانت لنا طبيب","وتبعدنا وانت لنا قريب",56,"ب",1,1],["أتم طيباً وحسناً منك ما نظرت","عيني ولا سمعت في الدهر آداني",57,"ي",1,0],["أتمناه ولكن","كيف لي بالأهبات",58,"ت",1,0],["أتمنّى بأن تعودَ لَيَالِينا","وظنّي بأنها لنْ تعودَا",59,"د",2,0],["أتَملِّي من محاسِنها","من بَعيدٍ وهي لا تَدري",60,"ر",2,1],["أَتمضي الحياةُ سُدى","وما طالَ فيها المَقام",61,"م",1,0],["أتَمَنَّى رُجُوعَ دَهرِكَ لَكِن","سالِفُ الدَّهرِ مَالَهُ مِن رُجُوعِ",62,"ع",1,0],["أتَمدَحُ بِالعلمِ إمرءاً غَيرَ عَالمٍ","وتَحسِبُ مِن أهلِ الهُدَى جَاهلَ الهُدَى",63,"د",2,0],["أتممتَ ما قد أمَّلُوه ففاتُهُم","من نصرِ دينِ الواحِدِ القهَّارِ",64,"ر",1,0],["أتمّ السلام لحبر الأنام","سمى المقام فريد الزمنْ",65,"ن",1,1],["أَتَمُّ الوَرى عِلماً بِحَقِّ إِلَهِهِ","وَأَصدَقهُمُ في نَومِهِ واِنتِباهِهِ",66,"ه",1,0],["أتمَّ سرورٌ يرى الوالدُ الابنا","ينافسَ في الأعلى ويسمو عن الأدنى",67,"ن",2,1],["أتم لك الله المنى فشكرته","وبالشكر للمولى يدوم نعيمه",68,"م",2,0],["أتمنّى الطوافَ بالبيتِ فأذَنْ","إنّ فيهِ لمُنيةُ المُتَمَنِّي",69,"ن",2,0],["أَتمَُّ مُناكَ ما تَسعى إَلَيهِ","بِنَفسكَ عامِداً لا تَستَعيرُ",70,"ر",1,0],["أتمّهمُ فضلا عليهم تعذّرا","إذا ما الهوى ناجاه بالعقل ظاهره",71,"ر",2,0],["أتمنى لو تعرفُ الحبَّ يوماً","غيرَ أني أخافُ ان يبكيكا",72,"ك",2,0],["أتمنى وكيفَ لا أتمنى","أن لي في الأنامِ خلاً وفيَّاً",73,"ي",2,1],["أتمنع بِرَّكَ من شاكرٍ","بشكرِكَ أفصح من جُلجُلِ",74,"ل",1,0],["أتمضى ليالي الصيف لا تنفع الجوى","مباسمُ بالعذب النمير تجود",75,"د",1,0],["أتمسى ضلوعي طعمة لغريمة","طفيلية يضرى بها الأسد الورد",76,"د",1,0],["أتمضى ليالي الصيف لا تنقع الجوى","مباسمُ بالعذب النمير تجود",77,"د",1,0],["أتمنى الدنو منها وقد حا","ل عن القرب وعرها والسهول",78,"ل",1,0],["أتمنَعُني عن شِربها في كآبتي","وفي الخمر لهوٌ عن خِداعٍ وتدليس",79,"س",1,0],["أتميلُ عن عربٍ إِلى عجَمٍ ولا","تَرعي ذِمامَ أحبَّةٍ ومعَاهد",80,"د",1,0],["أَتمنَعُنا منها ذنوبٌ تَعاظَمت","وَها نحنُ قَد بُؤنا بِها وتنصّلنا",81,"ن",2,0],["أتمنى عليك أن تلهمييني","بعض ما تلهمينه من معاني",82,"ي",1,0],["أتملّى الحياة بدءاً عجيباً","وأحِسُّ الختام بدءا جديدا",83,"د",2,0],["أَتَمُّ الناس أَعرفُهُم بِنَقصِه","وَأَقمَعُهُم لِشَهوَتِهِ وَحَمصِه",84,"ص",2,1],["اتمنى شهودهم حالة الن","وم ويوما قد تصدق الاحلام",85,"م",1,0],["أَتَمَّ شَبيبَةً وَأَعَزَّ فَقداً","عَلى المَولى وَأَكرَمَ في المَساعي",86,"ي",1,0],["أتمنَّى تلك اللّيالي المُنيرا","تِ وجَهْدُ المُحِبِّ أَن يتَمنّى",87,"ن",2,0],["أَتملِكُ غَضَّ الطَّرْفِ يا صاحِ بعدما","تَزيّنَ بالحَلْيِ الثَّرى وتَزيّغا",88,"غ",2,0],["أَتَملأُ مِن خَدَّيكَ كَأسَ مُدامَةٍ","وَتَمنَعُني أَن أَقطِفَ الوَردَ مِنهُما",89,"م",2,1],["أتمَّ اللَه فيه ما يراه","من الإحسان في حسن الخصال",90,"ل",1,0],["أتمَّ بنا بنيانَ تعليمِ علمِنا","بأعمالنا يا خير سامٍ وسامع",91,"ع",1,0],["أَتَمنى إِذا بَدا البَدر بَدري","أَو حَماماً إِذا سَجى اللَيل يَغشى",92,"ش",2,0],["أَتَمَنى رُضاكَ عَني وَهَيها","ت وُقوع العَنقاءِ لِلمُتَعني",93,"ن",2,0],["أتمنحُنا أوطانهُنّ الكواكبُ","وتصدُقُنا الأيامُ وهْيَ كواذِبُ",94,"ب",1,1],["أتمناه كلّما","إِن تذكّرتُ ودّهُ",95,"د",2,0],["أتملاه في مزيج الأحاسيس","قريرا بفرحة لم تترجم",96,"م",1,0],["أتمنَّاكم على اليأس ومَنْ","تركوهُ ومُنَى النفسِ تمنَّى",97,"ن",2,0],["أتمنَّى والمنَى جهدُ المقِلّْ","وأقضِّي الدهر في ليت وهلْ",98,"ل",1,1],["أتمنّاه على شحط النّوى","وقصارى عاشقٍ أن يتمنّى",99,"ن",2,0],["أتمنى قربه يبعدني","شد ما عذبني ظبي النقى",100,"ق",2,0],["أتَمَنَّى المَماتَ حتَّى أَراكُمْ","والتَّمَنِّي من بعضِهِ المُسْتَحيلُ",101,"ل",1,0],["أًَتَمضي وَلَم تُلَمِم عَلى الطَلَلِ الفَقرِ","لِسَلمَى وَرَسمٍ بالغَريَّينِ كالسَطرِ",102,"ر",1,1],["أتمَّ اللَّهُ ما أعطا","كَ من عزٍّ ومن آدِ",103,"د",1,0],["أَتمضي كَذا أيدي الرّدى بالمصاعبِ","وَتذهب عنّا بالذُرى والغواربِ",104,"ب",1,1],["أَتَمنّى لَو باتَ مِنّي بعيداً","كلُّ مَن كانَ في جِواري قَريبا",105,"ب",2,0],["أتمنع طيب الوصل من جد في الهوى","وتمنحه من يدعى وهو عابث",106,"ث",1,0],["أَتمنَحُني بالبُعْدِ والهَجْرِ مُهلِكِي","وحُبُّكَ لي بَيْن البَرِيَّةِ مطلبُ",107,"ب",1,0],["أَتمَنَّاكَ كُلَّما سَارَ بَرْقٌ","لَيْسَ مِثْلي وَجْداً على التَّحْقِيقِ",108,"ق",1,0]]}