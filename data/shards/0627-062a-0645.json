ewPoem.aspx?id=199337",""],[402,"نبا بك دهر بالأفاضل نابي","https://www.poetsgate.com/ViewPoem.aspx?id=35320",""],[402,"علا مفرقي بعد الشباب مشيب","https://www.poetsgate.com/ViewPoem.aspx?id=35055",""],[5813,"هذا خيالي","https://www.poetsgate.com/ViewPoem.aspx?id=176823",""],[5943,"جنَّةُ النارِ","https://www.poetsgate.com/ViewPoem.aspx?id=41590",""],[5943,"غصنٌ من الرند","https://www.poetsgate.com/ViewPoem.aspx?id=41650",""],[5956,"‏ رثاء حب الطفولة","https://www.poetsgate.com/ViewPoem.aspx?id=182240",""],[5956,"أرى الأموالَ نِفطاً للوجودِ.. ‏","https://www.poetsgate.com/ViewPoem.aspx?id=184186",""],[5956,"الشعور بالنقص حافزٌ للكمال","https://www.poetsgate.com/ViewPoem.aspx?id=184481",""],[5956,"جُلُّ رسالتي في الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=185735",""],[5956,"يخفون عني نبأ ما","https://www.poetsgate.com/ViewPoem.aspx?id=193144",""],[5956,"السَّقام والإلهام","https://www.poetsgate.com/ViewPoem.aspx?id=203300",""],[5976,"يا ملكْة الشعْر ..","https://www.poetsgate.com/ViewPoem.aspx?id=31767",""],[6038,"العشق","https://www.poetsgate.com/ViewPoem.aspx?id=25688",""],[6056,"عيونه الخرسا","https://www.poetsgate.com/ViewPoem.aspx?id=130503",""],[6082,"فتاة شرقية","https://www.poetsgate.com/ViewPoem.aspx?id=60252",""],[6089,"عجبي للعقولِ","https://www.poetsgate.com/ViewPoem.aspx?id=212942",""],[6093,"لقد سالت المآقي","https://www.poetsgate.com/ViewPoem.aspx?id=178383",""],[6102,"مِزَعُ الشَّرِّ !!","https://www.poetsgate.com/ViewPoem.aspx?id=185056",""],[6127,"إليكِ يا أنا","https://www.poetsgate.com/ViewPoem.aspx?id=203112",""],[402,"هنيئا أيها العلم المفدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=54059&r=&rc=911",""]],"verses":[["أَتَمَنّى لَكِ أَن تَب","قَي عَلى النَأيِ وَريقَه",0,"ق",2,0],["أَتَمشي بِهِ شُمَّ الأُنوفِ عُداتُهُ","وَرَبُّ الحِمى يَمشي بِأَنفٍ مُجَدَّعِ",1,"ع",1,0],["أَتَمَناهُم وَهَيهاتَ أَقصى ال","دَهرُ عَنهُم داري وَشَطَّ مَزاري",2,"ر",2,0],["أَتَمَّ لَهَا بِبِرٍّ ابْنُ وَفَّى","أَعَزَّ مَطَامِعِ الأُمِّ الرَؤُومِ",3,"م",1,0],["أَتَمَنَّى الإسْهَابَ وَالشَّوْطُ رَحْبٌ","غَيْرَ أَنِّي أَخَافُ غَيْظَ الحَلِيمِ",4,"م",1,0],["أَتَمُوتُ حَتفَ الأَنْفِ يَا ضِرْغَامُ","وَتَنَالُ مِنْ عِزمَاتِكَ الأَسْقَامُ",5,"م",1,1],["أتمنّى له السعادة لكن","ليس لي فيه ناقة منتوجه",6,"ج",2,0],["أتمنّى بأن أطير إليهم","بجناح وأين مِنّي الجناح",7,"ح",1,0],["أَتَمدَحُ يا اِبنَ القَينِ سَعداً وَقَد جَرَت","لِجِعثِنَ فيهِم طَيرُها بِالأَشائِمِ",8,"م",1,0],["أَتَمدَحُ مالِكاً وَترَكتَ تَيماً","وَقَد كانوا هُمُ الغَرَضَ المُصابا",9,"ب",2,0],["أَتَمنَعُ مُخضَرَّ السَحابِ عَجائِزٌ","لَهُنَّ بِأَطنابِ البُيوتِ هَريرُ",10,"ر",1,0],["أَتَمدَحُ سَعداً حينَ أَخزَت مُجاشِعاً","عَقيرَةُ سَعدٍ وَالخِباءُ مُكَشَّفُ",11,"ف",1,0],["أَتَمَّ اللَهُ نِعمَتَهُ عَلَيكُم","وَزادَ اللَهُ مُلكَكُمُ تَماما",12,"م",2,0],["أَتَمضونَ الرُسومَ وَلا تُحَيّا","كَلامُكُمُ عَلَيَّ إِذاً حَرامُ",13,"م",1,0],["أتمت مساعيك الزّكية نسكها","وما فاتنا من جود كفّك منجع",14,"ع",1,0],["أتمَّت حلا مرآه حليَة حبره","فلا عدِمت منه العلى بدرَ تمّها",15,"م",3,0],["أتُمتِعُني عيني عليك بدمعة","وأنت لأذيال الرَّوامس مُدْرَجُ",16,"ج",1,0],["أتمَّ له الإحسانُ حُسْنَ روائهِ","وأضحى من الإحسان والحُسْنِ حاليا",17,"ل",3,0],["أَتَمضي أَنتَ مُنفَرِداً وَأَبقى","لَقَد غَدَرَتكَ نَفسُكَ ياوَفِيُّ",18,"ي",1,0],["أَتَمَنّى لِمِصرَ أَن يَجري الخَي","رُ لَها مِن يَمينِهِ وَشِمالِه",19,"ل",2,0],["أَتُمَنِّعينَ قِرىً فَتَفتَضِحي","أَم تَبذُلينَ لَهُ الَّذي يَسَلُ",20,"ل",1,0],["أَتُمسِكُ ما أَولَيتَهُ يَدُ عاقِلٍ","وَتُمسِكُ في كُفرانِهِ بِعِنانِ",21,"ن",1,0],["أَتَمَّ سَعدَكَ مَن لَقّاكَ أَوَّلَهُ","وَلا اِستَرَدَّ حَياةً مِنكَ مُعطيها",22,"ي",3,0],["أَتَمَّ اللَهُ نُعماكُم فَإِنّي","رَأَيتُكُمُ النِهايَةَ في التَمامِ",23,"م",1,0],["أَتَمُّ الناسُ أَعرَفُهُم بِنَقصِه","وَأَقمَعُهُم لِشَهوَتِهِ وَحِرصِه",24,"ص",2,1],["أَتَمَنّى العِراقَ في أَرضِ حَرّا","نَ وَهَل تُدرِكُ الثُرَيّا سُهيلا",25,"ل",2,0],["أتمنى الموت من مقلته","ما الذي يمنع أن أشتاق فاه",26,"ا",2,0],["أتمعن في الهجر حتى ترانا","بكينا دما واحترقنا فما",27,"م",2,0],["أَتُمتَحَنُ القِسِيُّ بِغَيرِ نَبلٍ","أَيُخطِئُ مُبتَليها أَم يُصيبُ",28,"ب",1,0],["أَتَمَنَّاهُمُ وَدُونَ التَّلاقِي","قُذُفَاتٌ مِنْ لُجِّ أَخْضَرَ طَامِي",29,"م",2,0],["أَتَمُرُّ لا تَلوي عَلى مَثوى أَخي","ثِقَةً وَلا تَقِفُ الرِكابَ فُواقا",30,"ق",2,0],["أَتَملِكُ دَوحَةُ المُلكِ اِرتِفاعاً","إِذا مالَت حِفافَيها الغُصونُ",31,"ن",1,0],["أَتُمْسِي الأمُّ تُعزَلُ عن بَنِيها","لِمَوْلىً غيرِ مولاهم وجَارِ",32,"ر",1,0],["أَتَمَنَّيت فِراقي","فَلَقَد نِلتَ مُناكا",33,"ك",2,0],["أَتَمنَعُ ريقَكَ المَعسولَ عَنّي","وَأَنتَ عَلى الجِدارِ بِهِ تَجودُ",34,"د",1,0],["أَتَمَنّى وَما بِكَفِّيَ مِنها","غَيرُ مَطلٍ وَغَيرُ سوءِ اِنتِظارِ",35,"ر",1,0],["أَتَمُّ مِنَ النُسورِ بَقاءَ عُمرٍ","نُسورُ الطَيرِ لا الشُهُبِ السَواري",36,"ر",2,0],["آت من الشمس فيما","تفيضه من ضياء",37,"ا",2,0],["أَتَموت أَم تعنو لأح","كامٍ عليها قد قَضاها",38,"ا",3,0],["أتملَّاها سماتٍ عربيّهْ","وأنادي أنتِ يا أندلسيَّهْ",39,"ه",1,0],["أتَمْشي القَوافي تحتَ غيرِ لِوائنا","ونحْنُ على قُوّالِهَا أُمَراء",40,"ر",3,0],["أتمنّى اللّحاق فيك وأشكو","للقضاء التأخير والتعويقا",41,"ق",2,0],["أَتَمَنَّاهُ غَيْرَ أَنَّ فُؤَادِي","مِنْ إِسَارِ النَّوَى مُحَاطٌ بِجُنْدِ",42,"د",1,0],["أُتِمَّ بِالخُلْقِ الرَّاقِي تَأَدُّبُهُمْ","وَلاَ نَجَاحَ بِلاَ عَوْنٍ مِنَ الخُلُقِ",43,"ق",1,0],["أَتَمْضِي أَبَا شَادٍ وَفِي ظَنِّ مَنْ يَرَى","زُهُورَكَ أَنَّ النَّجْمَ قَبْلَكَ خَالِي",44,"ي",1,0],["أَتْمْكِنُنَا مِنْ بَارِحِ الأُنْسِ عُزْلَةٌ","وَجَارَا رِضَانَا نَاقِمٌ وَغَضُوبُ",45,"ب",1,0],["أَتَمَّ فِيهَا هَنَاءَ سَامِرِهَا","فَأَوْدَعَ المَاءَ نَشْوَةَ الخَمْرِ",46,"ر",1,0],["أَتْمِمْ حَلاَهُ بِحُلَى لاَبِسِهِ","مِنْ حِكْمَةٍ وَرَحْمَةٍ وَخَيْرِ",47,"ر",1,0],["أَتَمَثَّلَتْ لَكَ مِصْرُ فِي تَصْوِيرهِ","بِضَفَافِهَا وَجِنَانِهَا الْفيْحَاءِ",48,"ا",2,0],["أتموت من فرط الهزال صغاركم","لتعزّ شوكتها ويسمن كيسها",49,"س",3,0],["أَتَمَنّى وَلَيسَ لي عَمَلٌ زا","كٍ وَلكِن وَسيلَتي الإِسلامُ",50,"م",1,0],["أتموت بين عشية ونهارِ؟","يا للدمارِ، وقسوة الأقدارِ؟",51,"ر",1,1],["أتمضي والزمان على شحوب","وكان لديك في خصب ولين",52,"ن",1,0],["أتمضي والمشاكل ناصبات","أكنت قد اعتمدت على ضمين",52,"ن",1,0],["أتمرح إن شاهدت نعشا لهالك","إليك أكف الحاملين تشير",53,"ر",1,0],["أتمنى لو كنت بؤبؤ عيني","أتراني طلبت ما ليس يطلب",54,"ب",1,0],["أتمنى الموت من قلِتهِ","ما الذي يمنع أن أشتاق فاه",55,"ا",2,0],["أَتَمَّ وُلاة الحَق عِلماً وَهمة","وَأَشرَف مَن دانَت لِهِمَتِهِ العُليا",56,"ي",2,0],["أَتَمنى خَيالَهُ وَبَعيد","أَن يَزور الخَيال طَيف الخَيال",57,"ل",1,0],["أَتَمنى دَفع الرَدى وَالأَماني","ساخِرات مِن طالِعي وَجُدودي",58,"د",2,0],["اتمرضنا وانت لنا طبيب","وتبعدنا وانت لنا قريب",59,"ب",1,1],["أتم طيباً وحسناً منك ما نظرت","عيني ولا سمعت في الدهر آداني",60,"ن",2,0],["أتمناه ولكن","كيف لي بالأهبات",61,"ت",1,0],["أتمنّى بأن تعودَ لَيَالِينا","وظنّي بأنها لنْ تعودَا",62,"د",2,0],["أتَملِّي من محاسِنها","من بَعيدٍ وهي لا تَدري",63,"ر",2,1],["أَتمضي الحياةُ سُدى","وما طالَ فيها المَقام",64,"م",1,0],["أتَمَنَّى رُجُوعَ دَهرِكَ لَكِن","سالِفُ الدَّهرِ مَالَهُ مِن رُجُوعِ",65,"ع",1,0],["أتَمدَحُ بِالعلمِ إمرءاً غَيرَ عَالمٍ","وتَحسِبُ مِن أهلِ الهُدَى جَاهلَ الهُدَى",66,"د",2,0],["أتممتَ ما قد أمَّلُوه ففاتُهُم","من نصرِ دينِ الواحِدِ القهَّارِ",67,"ر",1,0],["أتمّ السلام لحبر الأنام","سمى المقام فريد الزمنْ",68,"ن",1,1],["أَتَمُّ الوَرى عِلماً بِحَقِّ إِلَهِهِ","وَأَصدَقهُمُ في نَومِهِ واِنتِباهِهِ",69,"ه",1,0],["أتمَّ سرورٌ يرى الوالدُ الابنا","ينافسَ في الأعلى ويسمو عن الأدنى",70,"ن",2,1],["أتم لك الله المنى فشكرته","وبالشكر للمولى يدوم نعيمه",71,"م",2,0],["أتمنّى الطوافَ بالبيتِ فأذَنْ","إنّ فيهِ لمُنيةُ المُتَمَنِّي",72,"ن",2,0],["أَتمَُّ مُناكَ ما تَسعى إَلَيهِ","بِنَفسكَ عامِداً لا تَستَعيرُ",73,"ر",1,0],["أتمّهمُ فضلا عليهم تعذّرا","إذا ما الهوى ناجاه بالعقل ظاهره",74,"ر",2,0],["أتمنى لو تعرفُ الحبَّ يوماً","غيرَ أني أخافُ ان يبكيكا",75,"ك",2,0],["أتمنى وكيفَ لا أتمنى","أن لي في الأنامِ خلاً وفيَّاً",76,"ي",2,1],["أتمنع بِرَّكَ من شاكرٍ","بشكرِكَ أفصح من جُلجُلِ",77,"ل",1,0],["أتمضى ليالي الصيف لا تنفع الجوى","مباسمُ بالعذب النمير تجود",78,"د",1,0],["أتمسى ضلوعي طعمة لغريمة","طفيلية يضرى بها الأسد الورد",79,"د",1,0],["أتمضى ليالي الصيف لا تنقع الجوى","مباسمُ بالعذب النمير تجود",80,"د",1,0],["أتمنى الدنو منها وقد حا","ل عن القرب وعرها والسهول",81,"ل",1,0],["أتمنَعُني عن شِربها في كآبتي","وفي الخمر لهوٌ عن خِداعٍ وتدليس",82,"س",1,0],["أتميلُ عن عربٍ إِلى عجَمٍ ولا","تَرعي ذِمامَ أحبَّةٍ ومعَاهد",83,"د",1,0],["أَتمنَعُنا منها ذنوبٌ تَعاظَمت","وَها نحنُ قَد بُؤنا بِها وتنصّلنا",84,"ن",2,0],["أتمنى عليك أن تلهمييني","بعض ما تلهمينه من معاني",85,"ن",2,0],["أتملّى الحياة بدءاً عجيباً","وأحِسُّ الختام بدءا جديدا",86,"د",2,0],["أَتَمُّ الناس أَعرفُهُم بِنَقصِه","وَأَقمَعُهُم لِشَهوَتِهِ وَحَمصِه",87,"ص",2,1],["اتمنى شهودهم حالة الن","وم ويوما قد تصدق الاحلام",88,"م",1,0],["أَتَمَّ شَبيبَةً وَأَعَزَّ فَقداً","عَلى المَولى وَأَكرَمَ في المَساعي",89,"ع",2,0],["أتمنَّى تلك اللّيالي المُنيرا","تِ وجَهْدُ المُحِبِّ أَن يتَمنّى",90,"ن",2,0],["أَتملِكُ غَضَّ الطَّرْفِ يا صاحِ بعدما","تَزيّنَ بالحَلْيِ الثَّرى وتَزيّغا",91,"غ",2,0],["أَتَملأُ مِن خَدَّيكَ كَأسَ مُدامَةٍ","وَتَمنَعُني أَن أَقطِفَ الوَردَ مِنهُما",92,"م",2,1],["أتمَّ اللَه فيه ما يراه","من الإحسان في حسن الخصال",93,"ل",1,0],["أتمَّ بنا بنيانَ تعليمِ علمِنا","بأعمالنا يا خير سامٍ وسامع",94,"ع",1,0],["أَتَمنى إِذا بَدا البَدر بَدري","أَو حَماماً إِذا سَجى اللَيل يَغشى",95,"ش",2,0],["أَتَمَنى رُضاكَ عَني وَهَيها","ت وُقوع العَنقاءِ لِلمُتَعني",96,"ن",2,0],["أتمنحُنا أوطانهُنّ الكواكبُ","وتصدُقُنا الأيامُ وهْيَ كواذِبُ",97,"ب",1,1],["أتمناه كلّما","إِن تذكّرتُ ودّهُ",98,"د",2,0],["أتملاه في مزيج الأحاسيس","قريرا بفرحة لم تترجم",99,"م",1,0],["أتمنَّاكم على اليأس ومَنْ","تركوهُ ومُنَى النفسِ تمنَّى",100,"ن",2,0],["أتمنَّى والمنَى جهدُ المقِلّْ","وأقضِّي الدهر في ليت وهلْ",101,"ل",1,1],["أتمنّاه على شحط النّوى","وقصارى عاشقٍ أن يتمنّى",102,"ن",2,0],["أتمنى قربه يبعدني","شد ما عذبني ظبي النقى",103,"ق",2,0],["أتَمَنَّى المَماتَ حتَّى أَراكُمْ","والتَّمَنِّي من بعضِهِ المُسْتَحيلُ",104,"ل",1,0],["أًَتَمضي وَلَم تُلَمِم عَلى الطَلَلِ الفَقرِ","لِسَلمَى وَرَسمٍ بالغَريَّينِ كالسَطرِ",105,"ر",1,1],["أتمَّ اللَّهُ ما أعطا","كَ من عزٍّ ومن آدِ",106,"د",1,0],["أَتمضي كَذا أيدي الرّد