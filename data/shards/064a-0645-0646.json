ت","https://www.poetsgate.com/ViewPoem.aspx?id=179836",""],[5616,"يمن","https://www.poetsgate.com/ViewPoem.aspx?id=203463",""],[243,"ثورة 14 رمضان","https://www.poetsgate.com/ViewPoem.aspx?id=19625",""],[5674,"ياقدس","https://www.poetsgate.com/ViewPoem.aspx?id=195389",""],[5691,"شدّوا الحزام...!","https://www.poetsgate.com/ViewPoem.aspx?id=207057",""],[5694,"من العايدين","https://www.poetsgate.com/ViewPoem.aspx?id=132100",""],[5732,"ان سلمت بعيونها","https://www.poetsgate.com/ViewPoem.aspx?id=177899",""],[5732,"الملحمة الزايدية","https://www.poetsgate.com/ViewPoem.aspx?id=177865",""],[5732,"يا معذبي بالحب","https://www.poetsgate.com/ViewPoem.aspx?id=177938",""],[5776,"النّهرُ العيّاب","https://www.poetsgate.com/ViewPoem.aspx?id=199331",""],[5853,"((لمن ..أغني ؟))","https://www.poetsgate.com/ViewPoem.aspx?id=175660",""],[5853,"قطوف الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=175683",""],[5885,"نتقاتل","https://www.poetsgate.com/ViewPoem.aspx?id=194800",""],[5922,"أفضل امرءة في التاريخ","https://www.poetsgate.com/ViewPoem.aspx?id=183795",""],[5952,"حبَّات العِقد","https://www.poetsgate.com/ViewPoem.aspx?id=196747",""],[5956,"البائس","https://www.poetsgate.com/ViewPoem.aspx?id=184693",""],[5956,"نحن كالموتى ونصغي صوتهم","https://www.poetsgate.com/ViewPoem.aspx?id=194718",""],[5997,"جائحة","https://www.poetsgate.com/ViewPoem.aspx?id=214297",""],[6031,"يا طِرْسُ قُلْ لخَليلَيَّ اللذَينِ هُمَا","https://www.poetsgate.com/ViewPoem.aspx?id=46349",""],[6089,"عدتَ ياعيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=213024",""],[6124,"طَلْعُ نيلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=109746",""],[6185,"شدو","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87030&r=&rc=16",""],[463,"ما على منجد رأى ما أهمَّهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60295&r=&rc=351",""],[6351,"جواب يفتش عن سؤال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86046&r=&rc=6",""]],"verses":[["يُمَنّينَ الوُرودَ فَإِن دَنَونا","ضَرَبنَ عَلى المَوارِدِ بِالحِبالِ",0,"ل",1,0],["يُمَنِّعُ الطَودَ فَلا","راقٍ وَلا مُطاوِلُ",1,"ل",1,0],["يَمنَعُني النَومَ بِالصُدودِ فَإِن","أَعتَبَ شَيئاً فَذاكَ أَحيانا",2,"ن",2,0],["يَمنَعُكَ الصَبرَ إِذا رُمتَهُ","تَذكارُ مَن خَلَّفتَ بِالرافِقَه",3,"ه",1,1],["يَمُنُّ وَلا يُعطي وَيَزعُم أَنَّهُ","كَريمٌ وَتأبى نَفسُهُ وَضَرائِبُه",4,"ب",2,0],["يَمْنَعُ الثَّغْرَ يَدْفَعُ العُسْرَ بِاليُسْ","رِ يَذُودُ العِلاّتِ وَالآلاما",5,"م",2,0],["يَمُنّونَ أَن خَلّوا ثِيابي وَإِنَّما","عَلَيَّ ثِيابٌ مِن دِمائِهِمُ حُمرُ",6,"ر",1,0],["يمنايَ يسرايَ فوقي","تحتي أمامي ورائي",7,"ا",3,0],["يمنح من قبلِ امْتداحِ مجدِه","جائزةً ثمَّ يراها واجبة",8,"ه",1,0],["يمنى إمام الوقت قد أنشأت","من يمنكَ لي عادات إحسان",9,"ن",1,1],["يمنعها الشيخُ من اشْتهاها","أو يحبس الأصلعَ في دَباها",10,"ا",3,0],["يُمنِّيننا منهنَّ نجحَ مواعدٍ","أكفٌّ بحباتِ القلوب ضَوابثُ",11,"ث",1,0],["يَمَّنَ اللَّهُ طلْعَةَ الموْلُودِ","وَحَبَا أَهْلَه بطول السعودِ",12,"د",1,1],["يُمنٍ إذا مسَّ ذا الوقود خَبا","عَفْواً وإن مَسَّ ذا الخمود ذكا",13,"ك",2,0],["يُمناً ورأياً مجنَّباً أبداً","كلّ ضلالٍ وكلَّ تضليلِ",14,"ل",1,0],["يُمْنَى يَدَيْ ذي الوزارتين وعيْ","نَاه ومُفْتَرُّه إذا ابتسما",15,"م",2,0],["يُمْناً وحَزْماً غير ذي خللٍ","وصريحَ نُصْحٍ غير مُتَّهَمِ",16,"م",1,0],["يمَّنَ اللَّهُ طلعة المِهرجانِ","كلَّ يمنٍ على الأميرِ الهِجانِ",17,"ن",1,1],["يَمنِحنَهُ شَزرَ إِنكارٍ بِمَعرِفَةٍ","لَواغِبَ الطَرفِ قَد حَلَّقنَ كَالقُلُبِ",18,"ب",1,0],["يَمُنُّ لِمَن يَرجوهُ مِن غَيرِ مِنَّةٍ","فَإِن قُلتَ مَنّانٌ فَقُل غَيرَ مَنّانِ",19,"ن",1,0],["يمنع الناس ما به يسعد النا","س ويعطى جماً ويعري ويكسي",20,"س",2,0],["يمنح من شاء الكنى","مجاملا لمن طلب",21,"ب",1,0],["يَمَنٌ سَلَّت ظُباها وَالشَآم","شامَها هِندِيَّةً ذاتَ صَليل",22,"ل",1,0],["يَمنَعُها حِلمَهُ","إِن دَفَعَتهُ اِحتَشَم",23,"م",1,0],["يَمنَعُ القَيدُ أَن تَقومَ فَهَل تا","جٌ فَبِالتاجِ لِلبِلادِ قِيامُ",24,"م",1,0],["يَمنَعُها أَن يُصيبُها مَطَرٌ","شِدَّةُ ما قَد تَضايَقَ الأَسَلُ",25,"ل",1,0],["يَمنَحُ المُستَهامَ خَمرَ رُضابٍ","في حَبابٍ مِن ثَغرِهِ اللُؤلُؤِيِّ",26,"ي",1,0],["يُمنى الزَمانِ طَوَت مَعروفَها وَغَدَت","يُسراهُ وَهيَ لَنا مِن بَعدِها بَدَلُ",27,"ل",1,0],["يَمنَعُ القُبلَةَ مَن يَه","واهُ وَالتَسليمُ قوتُ",28,"ت",1,0],["يُمناكَ فيها جحيمٌ للعدى ولمن","والاكَ ينبعُ ماءٌ كافي الزمر",29,"ر",1,0],["يَمنعُ الإسلامَ من أعدائِهِ","بدمٍ يأبَى له أن يَمنعَهْ",30,"ع",2,0],["يُمناه أم يُسراه أعظمُ حرمةً","أم ساعداه وصدرُه والمنكب",31,"ب",1,0],["يَمنعُ القومَ أن يصدّوا رسولَ ال","لَهِ عن بيتِه وَيَأبَى الخُفورا",32,"ر",2,0],["يَمنُ الوَزيرِ إِذا رَعَيتَ بِلادَهُ","وَلَقَد يَدِرُّ بِيُمنِهِ الجُلمودُ",33,"د",1,0],["يَمنَعُ ما شاءَ وَيَعطي الَّتي","تَسمو إِلَيها عَينُ بِأَقسامِها",34,"م",3,0],["يَمنَحُ الجَلسَ عُطاظِيَّةً","رُكَّبَت في ظَلِفاتٍ جِسام",35,"م",1,0],["يُمني ذوي آدابِها وشبابَهَا","أن زيدَ في شعرائِها وقحابِها",36,"ه",2,0],["يَمَنِيّةُ الأرْبابِ نجرانيّةُ ال","أنسابِ حيثُ سَمَتْ بها نَجرانُها",37,"ن",3,0],["يَمَنِيٌّ وَفارِسِيٌّ وَشامِيٌّ","وَغادٍ مِن أَهلِ غَربَةَ راحِل",38,"ل",1,0],["يَمنعُهم مِن انتشارِ خَيلهمْ","وحارساً في يَومِهم ولَيلهِمْ",39,"م",1,0],["يمْنحُ الحُبُّ لِمَنْ","يَلْتَمِسُ السِّتْرَ الأَمَانْ",40,"ن",1,0],["يَمْنَحُ الْفَخْرَ مِثْلَ مَا يَمْنَحُ الْوَفْرَ","وَهَذِي الآلاءُ هَيْهَاتْ تُجْحَدْ",41,"د",1,0],["يَمْنَحُ الجَارَ فَوْقَ مَا يَتَمَنَّى","جَارُهُ المُسْتَضَامُ مِنْ تَأْيِيدِ",42,"د",1,0],["يُمناكَ لَو عِشتَ لي معيني","وَرَوضَتي خُلقُكَ الرَضِيُّ",43,"ي",1,0],["يُمْناك يُمْنٌ للبلاد ورَحْمةٌ","غَدَقٌ ويُسْرَى راحَتَيْك يَسارُ",44,"ر",1,0],["يمنى ويسرى، رجلاه في جدل","أو قل هما في الشعار سيفان",45,"ن",1,0],["يمّنوني ، يسّروني ، توّجوا،","من دعوها الوسط المتزنه",46,"ن",2,0],["يمنعه المبدأ أن ينثني","والدين والجَرأةُ أن يكذِبا",47,"ب",2,0],["يمنى تعدّ لك المتاع وأختها","تلد الشقاء وتخلق التنكيلا",48,"ل",2,0],["يمنى السراب على الصحراء حانية","تضاحك الرّكب واحات وغدرانا",49,"ن",2,0],["يمَّنَ اللهُ طلعة المهرجان","صم كلَّ يمنٍ على الأميرِ الهِجانِ",50,"ن",1,1],["يمنحُ الجلسَ عكاظيَّة","ً ركَّبتْ في ظلفاتٍ جسامْ",51,"م",1,0],["يمني الخَليفةِ والخَليلِ المُصطفي","جَعَلَت تُفَرِّقُ أَينُقاً وَأَجامِلا",52,"ل",2,0],["يَمُنُّ وَطَولُ الإِقتِدارِ مُساعِدٌ","وَيَحلُمُ في وَقتٍ بِهِ الحِلمُ عازِبُ",53,"ب",1,0],["يمنُّ ونعصيه فيعفو تفضلا","تباركت غفاراً ذنوب الخلائق",54,"ق",1,0],["يَمِنُوا لِأَن راحُوا وَلَيسَ قَبيلَةٌ","إِلّا لَها مِنهُم صَباحٌ أَنكَدُ",55,"د",1,0],["يُمَنِّينَنا حَتَّى تَزِيغَ عُقُولُنا","وَيَخلِطنَ نمَطلاً ظاهِراً بِلَيانِ",56,"ن",1,0],["يُمَنّينَنا حتّى تَزِيغَ عُقُولُنَا","ويَخلِطنَ مَطلاً ظاهِراً بلَيانِ",57,"ن",1,0],["يمنونَ السعادةَ وهيَ منهمْ","منالَ الماءِ في بحرِ السرابِ",58,"ب",1,0],["يمناه لي بحر اذا ما عاهدت","فتشير لي كل اصبع بوفاء",59,"ا",2,0],["يمنح وصلا يبتديه بخل","والهجر عقباه يلذ الوصل",60,"ل",1,0],["يُمْنُ النَّقِيبَة في أُولَى مَنَاقِبهِ","يَرْمِي فَيُصمِي وَغاياتُ المُنَى هَدَفُ",61,"ف",1,0],["يُمْنُ الخِلافَةِ بُورِكَتْ وَيَمِينُها","جَادا عَلَيْها بِالْجَدا الهَطَّالِ",62,"ل",1,0],["يُمناهُ مِثل المزن ترْسلُ وابِلاً","غَدقاً وترْسل في الكَريهَةِ حاصِبا",63,"ب",2,0],["يُمناكَ بَحرٌ وَالعِدا القَصباءُ وَال","سَيفُ بِها مُضرَمَةٌ نيرانُهُ",64,"ن",2,0],["يَمنَحُ المُدّاحَ بِالمالِ وَكَم","عادَ عَنهُ ذو غَناءٍ بِالعَنا",65,"ن",2,0],["يمنعُني العذبَ ولَمّا يَزل","يُنهلني بالآجنِ المُنقَعِ",66,"ع",1,0],["يمنُ اللَه لَو كُشِف المغطّى","ووجهُ اللَه لَو رُفِع الحجابُ",67,"ب",1,0],["يمنعُ ذا الودادِ","مواردَ الإمدادِ",68,"د",1,0],["يَمنى النَفسَ أَمراً لَيسَ يُدرِكُهُ","إِنَّ الأَماني مَقطاعَ عَنِ المِنَنِ",69,"ن",1,0],["يَمنَعُ اللَهُ عَبدَهُ نَظَراً مِن","هُ وَيُسني لَهُ العَطِيَّةَ مَكرا",70,"ر",2,0],["يَمْنَعُني بَاخِلٌ وَسَمْحٌ","وَليسَ لي مِنهُما نَصِيرُ",71,"ر",1,1],["يُمنَتي وَيَساري","أَرضٌ سَماءُ السامي",72,"م",2,0],["يُمناهُ بعدُ منَ التَّسليمِ ما فرغَتْ","إذ مَدَّ يُسراهُ للتَّوديعِ عَجْلانا",73,"ن",2,0],["يُمناهُ واليُمْنُ إن لاقَيْتَهُ وكذا","يُسراهُ واليُسْرُ مَقْرونانِ في قَرَن",74,"ن",1,0],["يُمناهُ يُمْنٌ للمُطي","فِ به كما يُسْراهُ يُسر",75,"ر",1,0],["يُمْنُك أَغناهُمُ","عن عُدَّةٍ أَو عَتاد",76,"د",1,0],["يُمناهُ محرابٌ إليه صَلاتُها","من طاعةٍ لكَماله المَعْبود",77,"د",1,0],["يمنن بتوبه صحيحه باطنه ظاهره","يمحى بها كل ما أخفى وما أظهره",78,"ر",2,0],["يَمنعني وصلَه لِحَيْني","كأنّما وصلَه حرامُ",79,"م",1,1],["يَمُنُّ عَليَّ بلا طائلٍ","وذاكَ لعَمْري بِئْسَ الخُلُقْ",80,"ق",1,1],["يمنعني لذة الشراب وإن","كان قطابا كأنه العسل",81,"ل",1,0],["يمنع البيض خطّ أقلامك السم","ر بلاغاً أن تسبق الأقلاما",82,"م",2,0],["يمنعُ ضيفَ العينِ منه القِرى","وهو مباحٌ ليدِ أو فَمِ",83,"م",1,0],["يُمناهُ فِي قائِمِ السيفِ المُقامِ لَهُ","فِي العَدْلِ والقِسطِ عندَ اللهِ ميزانا",84,"ن",2,0],["يمنع الجانبَ العريضَ إذا سُد","دَتْ به ثُغرةُ الأمورِ المهمَّهْ",85,"م",2,0],["يمنعُ أو ينغِّصُ ال","عطاءَ إن لم يمنعِ",86,"ع",1,0],["يمنع الرشفةَ لا ترزأهُ","ويفرّي باللحاظ النَبطا",87,"ط",2,0],["يمنُّون الطَّوَى ليلاً بليلٍ","وتعريسَ السُّرَى فجراً بفجرِ",88,"ر",1,0],["يمنع الرِّفد وتَلقَى وفدَه","قِحَةُ البخلِ بإدلالِ الوهوبِ",89,"ب",1,0],["يمنحُه أبْلَجُ زَيْنبيُّ","مُطهَّرُ الأعْراقِ هاشميُّ",90,"ي",1,0],["يمنى يديك سطتْ وما في سطوها","عارٌ وعدتَ إلى المحلّ الألطف",91,"ف",1,0],["يمنعنا وهو ربيعٌ خدَّه","فهو على الحاظنا مُحرَّم",92,"م",1,0],["يمُنُّ عليه اللهُ جلَّ جَلالُهُ","ويُفرِغُ فيه نقطَةَ الوصلِ في الخَلْقِ",93,"ق",1,0],["يمن بك الدنيا علي فكيف لا","تمن ولى في الدهر أنت معاصر",94,"ر",1,0],["يُمْنُ العُلا والأماني البيض في يده الْ","يُمنى وحُمرُ المَنايا في أمانيهِ",95,"ي",2,0],["يُمنى يَدَيكَ لَنا جَدوى مُطَبَّقَةٍ","هَذا السَحابُ بِأَعلى الأُفقِ يَحكيها",96,"ي",3,0],["يمنة الحي خيمة لعريب","نزلوا قبلُ بالحمى الحاجريِّ",97,"ي",1,0],["يُمناكَ غيث للورى","فاضَت له جوداً وبذلا",98,"ل",2,0],["يُمناهُ بالبذلِ والإحسان قد عرفت","تنهلّ للناس مثل الغيث والمطرِ",99,"ر",1,0],["يَمنيٌّ تَرافَدَتهُ عُرُوقُ الذَّوي","ن الأخوالُ والأَعمامُ",100,"م",1,0],["يمنّ به الإلاه عليّ فضلاً","فراجي الفضلِ منه لا يخيبُ",101,"ب",1,0],["يمنكم مذ أرخوه وافر","جاء فتاح بعدل كسروي",102,"ي",1,1],["يمنُّ بما يُبدي كأن لِيَ حاجَة","إلى وُدّه الممقوت أم خُلقه الوَعر",103,"ر",1,0],["يُمَنّيكَ الإِمارَةَ كُلُّ رَكبٍ","لِاِنقاضِ العِراقَ بِها رَسيمُ",104,"م",1,0],["يمناك بالمعروف معروفه","والكرم التالد موصوفَه",105,"ف",2,1],["يُمناه في الشكل كيسراه لا","يَعرفه إ