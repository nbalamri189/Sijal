47212.html","أحذ الكامل"],[552,"أطواد عزك لا ترام","https://www.aldiwan.net/poem47240.html","مجزوء الكامل"],[552,"صمت العواذل في أساك وسلموا","https://www.aldiwan.net/poem47242.html","الكامل"],[552,"أما الشباب فقد مضت أيامه","https://www.aldiwan.net/poem47253.html","الكامل"],[552,"لم تدع لي نوب الأي","https://www.aldiwan.net/poem47305.html","مجزوء الرمل"],[552,"نولِينا منك الغداة قليلا","https://www.aldiwan.net/poem47318.html","الخفيف"],[552,"ما قربوا إلا لبين نوقا","https://www.aldiwan.net/poem47365.html","الكامل"],[552,"من أين زرت خيال ذات البرقع","https://www.aldiwan.net/poem47707.html","الكامل"],[552,"يا خير باد في الأنام وحاضر","https://www.aldiwan.net/poem47789.html","الكامل"],[552,"إِن كان غيبك التراب الأحمر","https://www.aldiwan.net/poem47823.html","الكامل"],[552,"أجر المدامع كيف شيتا","https://www.aldiwan.net/poem48033.html","مجزوء الكامل"],[552,"لم يبق لي بعد المشيب تصابي","https://www.aldiwan.net/poem48055.html","الكامل"],[552,"أعلى العهد منزل بالجناب","https://www.aldiwan.net/poem48064.html","الخفيف"],[559,"كل من بالناس يختلط","https://www.aldiwan.net/poem34409.html","المديد"],[559,"لذاتي بذاتي لا لكم أنا ظاهر","https://www.aldiwan.net/poem34556.html","الطويل"],[564,"حمدنا الله ذا العرش المجيد","https://www.aldiwan.net/poem13602.html","الوافر"],[568,"عادات طيفك أن يعاود","https://www.aldiwan.net/poem69711.html","مجزوء الكامل"],[568,"وصب الهوى ما كان من أوصابه","https://www.aldiwan.net/poem69816.html","الكامل"],[576,"من فر منك فما يلام","https://www.aldiwan.net/poem3009.html","مجزوء الكامل"],[576,"ليس لي منه سوى لا","https://www.aldiwan.net/poem3032.html","مجزوء الرمل"],[576,"باتت معانقتي ولكن في الكرى","https://www.aldiwan.net/poem3062.html","الكامل"],[576,"مالي هجرت بغير ذنب","https://www.aldiwan.net/poem3104.html","مجزوء الكامل"]],"verses":[["فَمَتَّعَ ناظِرِي بِأَغَرَّ طَلْقٍ","بِهِ فَضَلاتُ بِشْرٍ وَابْتِسامِ",0,"م",1,0],["فمَتى اللّقاءُ ودونَ ذلكَ فِتيَةٌ","ضُرِبَتْ قِبابُهُمُ بقُنّةِ عَرْعَرِ",1,"ر",1,0],["فَمُت كَمَداً أَو عِش سَقيماً فَإِنَّما","تُكَلِّفُني مالا أَراكَ تُطيقُ",2,"ق",1,0],["فمَتى جنَحْتُ الى السُلوِّ تَعلُّلاً","غلَبَ التّطَبُّعُ شيمَةَ المَطْبوعِ",3,"ع",1,0],["فَمَتى أَرى أُسطولَ مِص","رَ يُثيرُ فَوقَ البَحرِ رَعدا",4,"د",2,0],["فَمَتى أَرادَ اللَهُ رِفعَةَ مَنصِبٍ","أَفضى إِلَيكَ فَنالَ أَشرَفَ مَنزِلِ",5,"ل",1,0],["فَمَتى يفيقُ وَقيذُ نافِذَةٍ","مَشحوذَةٍ بِالسِحرِ وَالكحَلِ",6,"ل",1,0],["فَمَتى سَأَلتُكَ حاجَةً أَبَداً","فَاِشدُد بِها قُفلاً عَلى غَلَقِ",7,"ق",1,0],["فَمُت كَمَداً يا بَعلَ مَيّ فَإِنَّما","قُلوبُ لِمَيّ آمِنو العَيبِ نُصُّحُ",8,"ح",1,0],["فمتى يجود لنا الزما","ن ولو بَمْذقٍ من وطابه",9,"ب",2,0],["فمتى سعيُكم وماذا التَواني","وإلى كم أُحثّكم بالنشيد",10,"د",1,0],["فمتّم ميتةً بيضاء منها","بأعيننا قد أسودّ الفضاء",11,"ا",2,0],["فمتاع الحياة أحقر من أن","يستفزّ القلوب بالأحقاد",12,"د",1,0],["فمتى تفطن النفوس فتحيا","بك سقياً موات هذي البلاد",12,"د",1,0],["فَمَتى يَنقَع صُراخٌ صادِقٌ","يَحلِبوهُ ذاتَ جَرسٍ وَزَجَل",13,"ل",1,0],["فَمَتى أَهلِك فَلا أَحفِلُهُ","بَجَلي الآنَ مِنَ العَيشِ بَجَل",13,"ل",1,0],["فمتى أحاولُ غفلةً ومرادُهم","بيعُ الرّقاد بلذَّة استحلاء",14,"ا",2,0],["فمتى تقل بيتاً فقلْ إنَّ الذي","ومتى يُدِرْ سجعاً فقلْ إنَّ التي",15,"ي",1,0],["فمتى أراهُ وخلفه","عاتٍ من الأقوام عاد",16,"د",1,0],["فمتى ما أردتَ صاحبَ فحصٍ","كنتُ ممن يُشارك الحكماءَ",17,"ا",2,0],["فمتى شئتَ فامتحنِّي وأَولى","بك عفوٌ يُقابل استعفاءَ",17,"ا",2,0],["فمتى ما رأى الثلاثة عندي","فهْي حسبي لديه من آرابي",18,"ب",2,0],["فمتى ما رأى له قوتَ شهرٍ","عدَّهُ المَلْكَ في اقتبال الشبابِ",18,"ب",1,0],["فمتى ما قَطَعْتَهُ جرَّ قطعاً","للعطايا من سائر الأصحابِ",18,"ب",1,0],["فمتى أطرتَ لهم بريح عداوةٍ","فَلَك البَريحُ وأبرحُ الأبراحِ",19,"ح",1,0],["فمتى يُرَوْن من الشِّحاحِ على اللُّهَا","وهُمُ على الأرواح غيرُ شِحَاح",19,"ح",1,0],["فمتى اسْتَكَنُّوا مِنْ نَدَاهُ وبَأسِهِ","فالمسْتَكِنُّ هُنَاكَ في قِرْواحِ",19,"ح",1,0],["فمتى نظرتُ إلى سنا","هُ فحُقَّ لي أن أسعدا",20,"د",2,0],["فمتى رأى زللاً أقا","لَ وإن رأى خللاً تغمَّدْ",21,"د",1,0],["فمتى بذلتَ فللبقاء تَنَفُّسٌ","ومتى كنزت فللبقاءِ نفادُ",22,"د",1,0],["فمتى استَهْضمتَه اسْتَحْمَشْتَهُ","مثلَ ما يسْتَحْمِشُ النارَ الوقودُ",23,"د",1,0],["فمتى كان مَغْرَمٌ ومُقامٌ","كان من بين أهله صنْديدَك",24,"ك",1,0],["فمتى جريتَ على طباعك مثلَها","فكأن طِرْفك بعدُ من فخّارِ",25,"ر",1,0],["فمتى رأيت حميدهم وذميمهم","فبفضل إيثار على إيثارِ",25,"ر",1,0],["فمتى ظُفِّروا بزُور ظريفٍ","أعجبتْهم زخارف التزوير",26,"ر",1,0],["فمتى حَلمتُ لقيتَ أحنفَ دَهرِهِ","ومتى جهلتُ مُنيتَ بالبرَّاض",27,"ض",1,0],["فمتى اشتكتْ أطفالُهم من جِنَّةٍ","دلفُوا لهم من مائِهِ بمساعِط",28,"ط",1,0],["فمتى هجوْتَ أبا الوليد هَجَوْتَهُم","وهَجَوْتَ في عُرْض الهجاء أباكا",29,"ك",2,0],["فمتى ما أردتُ كنتَ جنوباً","ومتى ما أردتُ كنتَ شمالا",30,"ل",2,0],["فمتى نوَّل امرؤٌ بشفيعٍ","فلحمدٍ إلى الشفيعِ مُمالي",31,"ل",2,0],["فمتى دعا المعتافَ نحوك مرةً","فألٌ دَعتني من فعالِك أفْؤُلُ",32,"ل",1,0],["فمتى تقدّمَ أو تأخّر شاعرٌ","عن شأوِ صاحبه ففيك تحمُّلُ",32,"ل",1,0],["فمُتِّع بابنيه متاعاً يسرُّه","على رغم من أضحى لذلك راغما",33,"م",2,0],["فمتى جرى جعلَ التخْل","لُفَ وَكْدَهُ بعد التَّقدُّمْ",34,"م",1,0],["فمتى ما أجلتَ طرفكَ فيها","فهْي كالشمسِ صُوِّرتْ إنسانا",35,"ن",2,0],["فمتى أراك بصرفِهِ زِيَناً","فهِيَ الزخارفُ منه لا الزِّينُ",36,"ن",1,0],["فمتى هجاك فدارِه لقرونه","ليكونَ مما قد خشيتَ أمانا",37,"ن",2,0],["فَمَتى كَرَّرتَ ذِكرا","هُ يَزِد فيهِ غَرامي",38,"م",2,0],["فَمَتى أَرَدتِ شَرَحتُها","لَكِ بِالدَلائِلِ وَالأَمائِر",39,"ر",1,0],["فَمَتى أَخلُصُ مِنهُ","وَمتى يا لَيتَ شِعري",40,"ر",2,0],["فَمُت كَمَداً يا حاسِدي فَأَنا الَّذي","لَهُ صِلَةٌ مِمَّن يُحِبُّ وَعائِدُ",41,"د",1,0],["فَمَتى اليَومُ الَّذي أَب","لُغُ فيهِ ما أُريدُ",42,"د",1,0],["فَمَتى يُبَلِّغُني الزَما","نُ بِقُربِكُم يَوماً مُرادي",43,"د",2,0],["فَمَتى أَفوزُ بِنَظرَةٍ","مِن وَجهِكَ الحَسَنِ المَليحِ",44,"ح",1,0],["فَمَتَّعَني اللَهُ بالحَظّ مِنك","وَلا زِلتَ لي مؤنِساً سَرمَدا",45,"د",2,0],["فَمُتُّ وَلَم تُعلَم عَلَيَّ خِيانَةٌ","أَلا رُبَّ باغي الرِبحِ لَيسَ بِرابِحِ",46,"ح",1,0],["فمتى الهمة الشماء فضلك سابق","وشعبك جاز بالولاء شكور",47,"ر",1,0],["فَمَتى يُكَذَّبُ مُدَّعٍ لَكَ فَوقَ ذا","وَاللَهُ يَشهَدُ أَنَّ حَقّاً ما اِدَّعى",48,"ع",2,0],["فَمَتى أَقومُ بِشُكرِ ما أَولَيتَني","وَالقَولُ فيكَ عُلُوُّ قَدرِ القائِلِ",49,"ل",1,0],["فَمَتى شِئتَ مالَ مِنها قَضيبٌ","وَمَتى شِئتَ هالَ مِنها كَثيبُ",50,"ب",1,0],["فَمَتى غابَ في مِراسِ الأَعادي","فَسَواءٌ مَغيبُهُ أَو حُضورُه",51,"ر",2,0],["فَمَتى فاضَ مِن أَكُفِّ بَني الفَيا","ضِ نَيلٌ فَالنَيلُ وَاِستِبحارُه",52,"ر",2,0],["فَمَتى ما أَرابَني مِنهُ رَيبٌ","لَيسَ فيهِ إِلّا إِلَيكَ مَفَرّي",53,"ر",2,0],["فَمَتى خَشيتَ مِنَ الزَمانِ مُلِمَّةً","لاقَيتُها فَدَفَعتُها بِوَصيفِ",54,"ف",1,0],["فَمَتى أَرومُ الغَربَ نَحوَكَ ماتِحاً","غَربَ النَدى فَأَرى الغِنى وَأَراكا",55,"ك",2,0],["فَمَتى تُخَيِّمُ بِالشَآمِ فَيَكتَسي","بَلَدي نَباتاً مِن نَداكَ المُسبِلِ",56,"ل",1,0],["فَمَتى يَقِف تَقِفِ العُلا وَمَتى يَسِر","مُتَوَجِّهاً تَسِرِ العُلا في ظِلِّهِ",57,"ل",2,0],["فَمَتى سَمَت عَينُ الحَسودِ لِفَخرِهِ","رَجَعَت بِطَرفٍ عَن عُلاهُ كَليلِ",58,"ل",1,0],["فمتى أزورُ قِبابَ مُشرفَةِ الذُّرى","فأوردَ بينَ النَّسرِ والعَيُّوقِ",59,"ق",1,0],["فمَتى أرادَ الجَحْدَ حاسِدُه","شَهِدَتْ غَمائمُهُ وأبحرُه",60,"ر",2,0],["فمتى لم أَقُم بشُكْرِكَ في النا","سِ خطيباً فلا وُقِيتُ الخُطوبا",61,"ب",2,0],["فَمَتى أَملِكُ القِيادَ وَيُضحي ال","شَيبُ حَولي عَساكِراً وَجُنودا",62,"د",2,0],["فَمَتى يُسعِدُ الزَمانُ بِلُقيا","كَ مُحِبّاً مِنَ النَوى في جَحيمِ",63,"م",1,0],["فمتّ بما شاءَ الإلهُ ولم أمُتْ","لِيَكْتُبَ عمري من حياتي الذي يملي",64,"ل",2,0],["فمتى يَرْحَمُ الصِّبا منك صَبّاً","فاضَ مُستَولِياً عَلَيه القتيرُ",65,"ر",1,0],["فمتى يَفْلُقُ عن أبصارها","هامَةَ اللَّيل منَ الصبحِ عَمود",66,"د",1,0],["فمتى نلتقي فتصبحَ منّا","كلّ نفسٍ لكلّ نفسٍ طَبيبه",67,"ب",2,0],["فَمَتى النُهوضُ بِحَقِّ شُكرِكَ إِن جَنَت","بِالغَيبِ كَفُّكَ لي ثِمارَ فِعالِهِ",68,"ل",2,0],["فَمَتى تُلِمُّ بِهِ تَؤُب مُستَيقِناً","أَن لَيسَ أَولى مِن سِواهُ بِمالِهِ",69,"ل",2,0],["فَمَتى أُرَوّي مِن لِقائِكَ هِمَّتي","وَيُفيقُ قَولي مِن سِواكَ وَمِقوَلي",70,"ل",2,0],["فَمَتى تَعَثَّرَ بِالرِفاقِ ذَكَرتَهُ","فَيَمُرُّ تَحتي قِطعَ لَيلٍ أَغضَفِ",71,"ف",1,0],["فَمَتَى يَسْمَحُ الزَّمَانُ فَأَلْقَى","بِشَكِيبٍ مَا فَاتَنِي مِنْ مَرَامِ",72,"م",1,0],["فمتى رأى الإنسانُ في فمهِ دماً","أيِسَ الحياةَ وفرَّ منهُ الأقربا",73,"ب",2,0],["فَمُت كَمَداً يا قَلبِ أَو عِش فَإِنَّما","رَأَيتُكَ بِالجافي البَخيلِ مُوَكَّلُ",74,"ل",1,0],["فَمَتى تَثوبُ إِلى السُيوفِ حُلومُها","وَيَكُفُّ غَيَّ المُرعِداتِ رَشادُ",75,"د",1,0],["فَمَتى يَكونُ الغَيثُ مِن أَكفائِهِ","وَالغَيثُ مِن حَسَناتِهِ مَعدودُ",76,"د",1,0],["فَمَتى حَمَلتُ لَكَ الثَناءَ فَإِنَّما","هُوَ لُؤلُؤٌ في بَحرِهِ مَردودُ",76,"د",1,0],["فَمَتى يَفوزُ وَمِن عِداهُ بَعضُهُ","وَمَتى يُفيقُ وَمِن ضَناهُ طَبيبُهُ",77,"ب",2,0],["فمتى يا هرجي منك الرضى","ومتى يصفوا الهوى لكن أراكْ",78,"ك",1,0],["فَمَتى رَأى مُوسى الإِرادَةَ عِندَهُ","خِضرُ الحقيقةِ نَالَ أَقصى المَقصدِ",79,"د",1,0],["فمتى هَمَمْتُ بشُكْرٍ سالفِ نِعْمَةٍ","أَلْفَيْتُ سالِفَتي بأُخْرَى مُثْقَلَهْ",80,"ل",2,0],["فَمِتُّم بِأَيديكُم فَلا ماتَ غَيرُكُم","وَغَنّى بِكُم أَبناءُ دارَةَ في الشِربِ",81,"ب",1,0],["فَمَتَّعتُ نَفسي وَالنَدامى بِشُربِها","فَهَذا شَقاءٌ مَرَّ بي وَنَعيمُ",82,"م",1,0],["فَمَتى تُدرِكُ ما لا","يُتَحَرّى بِالعُيونِ",83,"ن",1,0],["فَمَتى يُنَبَّهُ مِن رُقادٍ مُهلِكٍ","مَن قَد أَضَرَّ بِعَينِهِ هَجَعاتُها",84,"ت",3,0],["فَمَتَى واغِلٌ يَنُبهُم يَحبُو","ه وتُعطَف عَليهِ كَاسُ السَّاقي",85,"ي",1,1],["فَمَتَى يَبُوحُ بِمَا أَجَنَّ ضَمِيرُهُ","إِنْ كُنْتِ عَنْهُ بِنَجْوَةٍ لَمْ تَسْمَعِي",86,"ع",2,0],["فَمَتَى أَقُومُ بِشُكْرِ مَا أَوْلَيْتَنِي","وَالنَّجْمُ أَقْرَبُ غَايَةً مِنْ مَنْزِعِي",86,"ع",2,0],["فَمُتَّ وَقالَ الحَمدُ لِلَّهِ مُشفِقٌ","بِأَسمائِهِ الحُسنى رَقاكَ وَعَوَّذا",87,"ذ",2,0],["فمتَى تَهْدَأُ القُلُوبُ إلى الْحُبِّ","وتُهْدَى النفوسُ بعد ضَلال",88,"ل",1,0],["فمتى متى ابقى ويظعن صاحب","اودع منه راحلا غير ايب",89,"ب",1,0],["فمتعت نفسي والندامى بشربها","وهذا شقاء مر بي ونعيم",90,"م",1,0],["فمتى تحرّق بالدما أصفادها","وتبيد من صنعوا لها الأصفادا",91,"د",2,0],["فمتى يرى الإنسان دنيا غضّة","سمحا فلا ظلم ولا متظلّمُ ؟",92,"م",1,0],["فمتى أعرف الطلاقةَ والأنسَ","ألمَّا أكونُ تحت التراب؟",93,"