",0,"م",1,0],["فمَتى اللّقاءُ ودونَ ذلكَ فِتيَةٌ","ضُرِبَتْ قِبابُهُمُ بقُنّةِ عَرْعَرِ",1,"ر",1,0],["فَمُت كَمَداً أَو عِش سَقيماً فَإِنَّما","تُكَلِّفُني مالا أَراكَ تُطيقُ",2,"ق",1,0],["فمَتى جنَحْتُ الى السُلوِّ تَعلُّلاً","غلَبَ التّطَبُّعُ شيمَةَ المَطْبوعِ",3,"ع",1,0],["فَمَتى أَرى أُسطولَ مِص","رَ يُثيرُ فَوقَ البَحرِ رَعدا",4,"د",2,0],["فَمَتى أَرادَ اللَهُ رِفعَةَ مَنصِبٍ","أَفضى إِلَيكَ فَنالَ أَشرَفَ مَنزِلِ",5,"ل",1,0],["فَمَتى يفيقُ وَقيذُ نافِذَةٍ","مَشحوذَةٍ بِالسِحرِ وَالكحَلِ",6,"ل",1,0],["فَمَتى سَأَلتُكَ حاجَةً أَبَداً","فَاِشدُد بِها قُفلاً عَلى غَلَقِ",7,"ق",1,0],["فَمُت كَمَداً يا بَعلَ مَيّ فَإِنَّما","قُلوبُ لِمَيّ آمِنو العَيبِ نُصُّحُ",8,"ح",1,0],["فمتى يجود لنا الزما","ن ولو بَمْذقٍ من وطابه",9,"ب",2,0],["فمتى سعيُكم وماذا التَواني","وإلى كم أُحثّكم بالنشيد",10,"د",1,0],["فمتّم ميتةً بيضاء منها","بأعيننا قد أسودّ الفضاء",11,"ا",2,0],["فمتاع الحياة أحقر من أن","يستفزّ القلوب بالأحقاد",12,"د",1,0],["فمتى تفطن النفوس فتحيا","بك سقياً موات هذي البلاد",12,"د",1,0],["فَمَتى يَنقَع صُراخٌ صادِقٌ","يَحلِبوهُ ذاتَ جَرسٍ وَزَجَل",13,"ل",1,0],["فَمَتى أَهلِك فَلا أَحفِلُهُ","بَجَلي الآنَ مِنَ العَيشِ بَجَل",13,"ل",1,0],["فمتى أحاولُ غفلةً ومرادُهم","بيعُ الرّقاد بلذَّة استحلاء",14,"ا",2,0],["فمتى تقل بيتاً فقلْ إنَّ الذي","ومتى يُدِرْ سجعاً فقلْ إنَّ التي",15,"ي",1,0],["فمتى أراهُ وخلفه","عاتٍ من الأقوام عاد",16,"د",1,0],["فمتى ما أردتَ صاحبَ فحصٍ","كنتُ ممن يُشارك الحكماءَ",17,"ا",2,0],["فمتى شئتَ فامتحنِّي وأَولى","بك عفوٌ يُقابل استعفاءَ",17,"ا",2,0],["فمتى ما رأى الثلاثة عندي","فهْي حسبي لديه من آرابي",18,"ب",2,0],["فمتى ما رأى له قوتَ شهرٍ","عدَّهُ المَلْكَ في اقتبال الشبابِ",18,"ب",1,0],["فمتى ما قَطَعْتَهُ جرَّ قطعاً","للعطايا من سائر الأصحابِ",18,"ب",1,0],["فمتى أطرتَ لهم بريح عداوةٍ","فَلَك البَريحُ وأبرحُ الأبراحِ",19,"ح",1,0],["فمتى يُرَوْن من الشِّحاحِ على اللُّهَا","وهُمُ على الأرواح غيرُ شِحَاح",19,"ح",1,0],["فمتى اسْتَكَنُّوا مِنْ نَدَاهُ وبَأسِهِ","فالمسْتَكِنُّ هُنَاكَ في قِرْواحِ",19,"ح",1,0],["فمتى نظرتُ إلى سنا","هُ فحُقَّ لي أن أسعدا",20,"د",2,0],["فمتى رأى زللاً أقا","لَ وإن رأى خللاً تغمَّدْ",21,"د",1,0],["فمتى بذلتَ فللبقاء تَنَفُّسٌ","ومتى كنزت فللبقاءِ نفادُ",22,"د",1,0],["فمتى استَهْضمتَه اسْتَحْمَشْتَهُ","مثلَ ما يسْتَحْمِشُ النارَ الوقودُ",23,"د",1,0],["فمتى كان مَغْرَمٌ ومُقامٌ","كان من بين أهله صنْديدَك",24,"ك",1,0],["فمتى جريتَ على طباعك مثلَها","فكأن طِرْفك بعدُ من فخّارِ",25,"ر",1,0],["فمتى رأيت حميدهم وذميمهم","فبفضل إيثار على إيثارِ",25,"ر",1,0],["فمتى ظُفِّروا بزُور ظريفٍ","أعجبتْهم زخارف التزوير",26,"ر",1,0],["فمتى حَلمتُ لقيتَ أحنفَ دَهرِهِ","ومتى جهلتُ مُنيتَ بالبرَّاض",27,"ض",1,0],["فمتى اشتكتْ أطفالُهم من جِنَّةٍ","دلفُوا لهم من مائِهِ بمساعِط",28,"ط",1,0],["فمتى هجوْتَ أبا الوليد هَجَوْتَهُم","وهَجَوْتَ في عُرْض الهجاء أباكا",29,"ك",2,0],["فمتى ما أردتُ كنتَ جنوباً","ومتى ما أردتُ كنتَ شمالا",30,"ل",2,0],["فمتى نوَّل امرؤٌ بشفيعٍ","فلحمدٍ إلى الشفيعِ مُمالي",31,"ل",2,0],["فمتى دعا المعتافَ نحوك مرةً","فألٌ دَعتني من فعالِك أفْؤُلُ",32,"ل",1,0],["فمتى تقدّمَ أو تأخّر شاعرٌ","عن شأوِ صاحبه ففيك تحمُّلُ",32,"ل",1,0],["فمُتِّع بابنيه متاعاً يسرُّه","على رغم من أضحى لذلك راغما",33,"م",2,0],["فمتى جرى جعلَ التخْل","لُفَ وَكْدَهُ بعد التَّقدُّمْ",34,"م",1,0],["فمتى ما أجلتَ طرفكَ فيها","فهْي كالشمسِ صُوِّرتْ إنسانا",35,"ن",2,0],["فمتى أراك بصرفِهِ زِيَناً","فهِيَ الزخارفُ منه لا الزِّينُ",36,"ن",1,0],["فمتى هجاك فدارِه لقرونه","ليكونَ مما قد خشيتَ أمانا",37,"ن",2,0],["فَمَتى كَرَّرتَ ذِكرا","هُ يَزِد فيهِ غَرامي",38,"ي",1,0],["فَمَتى أَرَدتِ شَرَحتُها","لَكِ بِالدَلائِلِ وَالأَمائِر",39,"ر",1,0],["فَمَتى أَخلُصُ مِنهُ","وَمتى يا لَيتَ شِعري",40,"ر",2,0],["فَمُت كَمَداً يا حاسِدي فَأَنا الَّذي","لَهُ صِلَةٌ مِمَّن يُحِبُّ وَعائِدُ",41,"د",1,0],["فَمَتى اليَومُ الَّذي أَب","لُغُ فيهِ ما أُريدُ",42,"د",1,0],["فَمَتى يُبَلِّغُني الزَما","نُ بِقُربِكُم يَوماً مُرادي",43,"د",2,0],["فَمَتى أَفوزُ بِنَظرَةٍ","مِن وَجهِكَ الحَسَنِ المَليحِ",44,"ح",1,0],["فَمَتَّعَني اللَهُ بالحَظّ مِنك","وَلا زِلتَ لي مؤنِساً سَرمَدا",45,"د",2,0],["فَمُتُّ وَلَم تُعلَم عَلَيَّ خِيانَةٌ","أَلا رُبَّ ب