y.dctabudhabi.ae/diwan/poem/65362","الرمل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132572","الخفيف"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126297","الطويل"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126257","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62864","الكامل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126914","الخفيف"],[3567,"","https://poetry.dctabudhabi.ae/diwan/poem/61276","الرجز"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101240","الرمل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66427","المتقارب"],[3709,"","https://poetry.dctabudhabi.ae/diwan/poem/36022","الرجز"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85199","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111466","الطويل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70092","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70000","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77032","الكامل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127125","الطويل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90975","الكامل"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28749","البسيط"],[4550,"","https://poetry.dctabudhabi.ae/diwan/poem/107129","الطويل"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104893","البسيط"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52131","الرمل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204294","الخفيف"],[5277,"هلال الكرخ","https://www.poetsgate.com/ViewPoem.aspx?id=188113",""],[2079,"إلى كم أداري والحبيب نفور","https://www.poetsgate.com/ViewPoem.aspx?id=123849",""],[6008,"من الجوف","https://www.poetsgate.com/ViewPoem.aspx?id=60806",""],[4442,"أناخ على ذكا فخبت ضياء","https://www.poetsgate.com/ViewPoem.aspx?id=171228",""],[6259,"تعاتب سعدى إن تنقل دارها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59383&r=&rc=31",""]],"verses":[["بمَقامِ إبْراهيمَ عُذْ واصْرِفْ بِهِ","فِكَراً توَرِّقُ عنْ بَواعِثَ تنْبَري",0,"ر",2,1],["بِمُقَوَّمٍ لَدنِ الكُعوبِ سِنانُهُ","ذَربِ الشَباةِ كَقادِمِ النِسرِ",1,"ر",1,0],["بِمِقْوَلٍ لا يُجَارَى فِي فَصَاحَتِهِ","نَاهِيكَ بِالْوَحْيِ مِنْ عَلاَّمَةٍ لَسِنِ",2,"ن",1,0],["بِمُقَوَّرَةِ الأَلياطِ مِمّا ترَجَحَّتَ","بِرُكبانِها بيَنَ الخُروقِ المَهالِكِ",3,"ك",1,0],["بِمُقوَرَّةٍ الأَلياطِ عوجٍ مِنَ البُرى","تَساقَطُ في آثارِهِنَّ السَرائِحُ",4,"ح",1,0],["بِمُقلَةِ أَقنى يَنفِضُ الطَلَّ باكِرٍ","تَجَلّى الدُجى عَن طَرفِهِ حينَ يُصبِحُ",5,"ح",1,0],["بِمُقابِلٍ سَرِبِ المَخارِزِ عِدلُهُ","قَلِقُ المَحالَةِ جارِنٌ مَسلومُ",6,"م",1,0],["بمقامكَ المرفوع يخفض ذنبنا ال","منصوب إنَّ رجاءَنا المجزوم",7,"م",1,0],["بمقدمِكَ السعيد قد اسْتنارت","دمشق وبشرت بسنا عليّ",8,"ي",1,1],["بمقلةٍ حوراء في سَحْنَةٍ","حمراء كالنرجس في الوردِ",9,"د",1,0],["بِمُقلَةٍ لا تُغَرُّ صادِقَةٍ","يَطحَرُ عَنها القَذاةَ حاجِبُها",10,"ب",3,0],["بِمُقلَتِكِ النَّجلاءِ عَمداً قَتَلتِني","ولا قَوَدٌ في القتل بالأعيُنِ النجلِ",11,"ل",1,0],["بِمُقتَنَصِ الهَوى وَصَّلنَ مِنهُ","مَعاتِبَ نَقَّبَت قَصَبَ الوَتينِ",12,"ن",1,0],["بِمقانِبٍ فيها المَنا","يا بَينَ أَثناءِ القَساطِل",13,"ل",1,0],["بِمُقلَةٍ وَقفٍ عَلى الصَوابِ","فَكَم وَكَم مِن أَجرَدٍ وَثّابِ",14,"ب",1,0],["بِمُقلَةٍ قَليلَةِ التَكذيبِ","طَرّاحَةٍ خَلفَ لَقى الغُيوبِ",15,"ب",1,0],["بمقامك الألقابُ تزهو، مثلما","تزهو العقودُ بنضرة الأجياد",16,"د",1,0],["بِمَقدَم قاضي الشام مُحيي رُبوعِها","فَحَمداً لِمَن أُحيي بِهِ الأَرض قاضيا",17,"ي",2,0],["بمقري الباز مولانا حمانا","سراج الدين من للقوم ساقي",18,"ق",2,1],["بمقدم أستاذنا مَن بهِ","مِن الله نرجو صلاح الأمورْ",19,"ر",1,0],["بِمَقالٍ لا أَستَزيدُ بِهِ زُل","فى وَلا أَبتَغي عَلَيهِ ثَوابا",20,"ب",2,0],["بِمُقرَباتٍ كَساها نَقعُ أَرجُلِها","أَضعافَ ما بَزَّها التَقريبُ وَالخَبَبُ",21,"ب",1,0],["بمقام إسمعيل ذى الجود الذي","العلياء في تسريبه تسرى به",22,"ب",2,0],["بِمِقدارِ ما خانَ البلادَ وما أتى","لأعدائِها نُصحاً علا عندَهُم قدرا",23,"ر",2,0],["بمقدمه الميمون سرت قلوبنا","وقد حسدتمنا العيون المسامع",24,"ع",1,0],["بمقدمك السعيد لقد انارت","ربوع الانس وارتفع النهار",25,"ر",1,0],