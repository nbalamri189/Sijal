5,"أقصِرْ، فإنّ الدّهرَ ليسَ بمُقْصِرِ","https://www.poetsgate.com/ViewPoem.aspx?id=31214",""],[91,"الى الصديق","https://www.poetsgate.com/ViewPoem.aspx?id=53275",""],[51,"حقُّ الأديب لازمٌ لذي الكرمْ","https://www.poetsgate.com/ViewPoem.aspx?id=30404",""],[51,"لي أربعون من السِّني","https://www.poetsgate.com/ViewPoem.aspx?id=27684",""],[105,"لمن الجلال يفوق كل جلال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55132&r=&rc=302",""],[31,"هَلْ عِنْدَ رَسْمٍ بَرَامَة ٍ خَبَرُ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18875&r=&rc=138",""],[61,"وشاحبِ اللِّبسة ِ والأَعضاءِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59469&r=&rc=2",""],[96,"إلى البحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66354&r=&rc=30",""],[4,"طَلَل لخولة َ بالرُّسيسِ قديمُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10943&r=&rc=38",""]],"verses":[["أَوَما اِتَّقَيتَ وَقَد كُفيتَ فَوارِساً","يَتَجاذَبونَ عَوالِيَ المُرانِ",0,"ن",1,0],["أَو مُفلِتٍ حُمَةَ السِنانِ نَجَت بِهِ","رَوعاءُ لا تَدَعُ العِذارَ لِمُلجِمِ",1,"م",1,0],["أَوَما رَأَيتَ العيسَ آخِذَةً","لَكَ أُهبَةَ الإِدلاجِ وَالعَمَلِ",2,"ل",1,0],["أَو مُصعَباً لَمّا دَنا ميقاتُهُ","وَضَرَبَ المِقدارُ بِالحَبائِلِ",3,"ل",1,0],["أَو ما شَمَمتَ بِذي الأَبارِقِ نَفحَةً","خَلَصَت إِلى كَبِدِ الفَتى المُشتاقِ",4,"ق",1,0],["أَومَوا إِلى الغَرَضِ البَعيدِ فَكُلُّهُم","ماضٍ يَخُبُّ مَعَ الرَجاءِ وَيُعنِقُ",5,"ق",1,0],["أَوَما رَأَيتَ وَقائِعَ الدَهرِ","أَفَلا تُسيءُ الظَنَّ بِالعُمرِ",6,"ر",1,1],["أَو مَليكٍ وَقَعَ الدَهرُ بِهِ","فَأَماطَ الطَوقَ عَنهُ وَالسِوارا",7,"ر",2,0],["أُؤَمَّلُ ما أَبقى الزَمانُ وَإِنَّما","سَوالِفُهُ مَعقودَةٌ بِالغَوابِرِ",8,"ر",1,0],["أَوما كَفاكَ بِأَنَّ أُمَّكَ فاطِمٌ","وَأَبوكَ حَيدَرَةٌ وَجَدُّكَ أَحمَدُ",9,"د",1,0],["أُؤَمِّلُ ما لا يَبلُغُ العُمرُ بَعضَهُ","كَأَنَّ الَّذي بَعدَ المَشيبِ شَبابُ",10,"ب",1,0],["أؤَمِّلُ أن ألقى الخُطوبَ فتَنْثَني","نَوابيَ عن شِلْوي لَدَيْهِمْ نُيوبُها",11,"ب",3,0],["أَو مَنَعتُم ما تُسأَلونَ فَمَن حُ","دِّثتُمُوهُ لَهُ عَلَينا العَلاءُ",12,"ا",2,0],["أَو مُقلَةٌ ذاقَت كَراها لَيلَةً","إِلّا وَأَعقَبَتِ الخُطوبُ هُجودَها",13,"د",3,0],["أُؤَمِّلُكُم حَتّى إِذا ما رَجَعتُمُ","أَتاني صُدودٌ مِنكُمُ وَتَجَنُّبُ",14,"ب",1,0],["أَو مَرَّ عَنْتَرَةٌ عَلَيْهَا لَمْ يَقُلْ","هَلْ غَادَرَ الشُّعَرَاءُ مِنْ مُتَرَدَّمِ",15,"م",1,0],["أوَ ما تَرى الملِكَ ابْنَ نصْرٍ يوسُفاً","أسَداً وأنْصارُ النّبيِّ نِجارُهُ",16,"ر",2,0],["أو مَا تَرى طوفانَ فَيْضِ مَدامِعي","يُذْكي جَحيماً بالضّلوعِ تأجّجَا",17,"ج",2,0],["أَو مِن عِتابٍ بَينَ مَح","بوبٍ وَحِبٍّ مُعذِرِ",18,"ر",1,0],["أَو مَجلِسٍ لِلخَمرِ مَع","قودٍ بِيَومٍ مُمطِرِ",18,"ر",1,0],["أَوَ ما تَرى الجَوزاءَ كَيفَ تَعَرَّضَت","وَالنَجمَ في أُفقِ المَغارِبِ آفِلا",19,"ل",2,0],["أَو ما اِكتَفى مِن عارِضَيكَ بِأَرقُمٍ","حَتّى لَوى مِن فَضلِ صُدغِكَ عَقرَبا",20,"ب",2,0],["أَو ما تَرى أَظعانَهُنَّ بَواكِر","كَالنَخلِ مِن شَوكانَ حينَ صِرامِ",21,"م",1,0],["أو مقلة من فتيت التبر محكمة","لها من الفضة البيضاء أشفارُ",22,"ر",1,0],["أَو مَصابيحَ راهِبٍ في يَفاعٍ","سَغَّمَ الزَيتَ ساطِعاتِ الذُبالِ",23,"ل",1,0],["أَو مَن يَعودُ بِحِلمِهِ","عِندَ التَنازُعِ في الشَكَس",24,"س",1,0],["أَوْ مَنْ لَهُ تِلْكَ الثَّقَافَةُ","وَالْحَصَافَةُ إِنْ كَتَبْ",25,"ب",1,0],["أو من مفارخ في البلاد ثوابتٍ","أخلدتها ولمثلها الإخلاد",26,"د",1,0],["أو من صفاء الروح في ملكٍ","عصمته فطرته عن الوزر",27,"ر",1,0],["أو من شمائل في النفوس لها","نفحات أشتات من العطر",27,"ر",1,0],["أو من طباق شأنه عجب","في هذه الحورية البكر",27,"ر",1,0],["أَو مُزنَةٌ فارِقٌ يَجلو غَوارِبَها","تَبَوُّجُ البَرقِ وَالظَلماءُ عُلجومُ",28,"م",1,0],["أَو مُخطَفُ البَطنِ لاحَتهُ نَحائِصُهُ","بِالقُنَّتَينِ كِلا لِيَتيِهِ مَكدومُ",28,"م",1,0],["أَو مُقحَمٌ أَضعفَ الإِبطانَ حادِجُهُ","بِالأَمس فَاِستَأخَرَ العِدلانِ وَالقَتَبُ",29,"ب",1,0],["أو مبلغ سالفَ الأنصار مأكلةً","والله بالخلد في الفردوس يَجزيها",30,"ي",3,0],["أو ما ترى البدر المنير إذا بدا","يكسو الدجى من نوره سربالا",31,"ل",2,0],["أو ما أمرنا في عظات كتابنا","بالعدل والإحسان ان نتديّنا",32,"ن",2,0],["أوَ ما تُبصر اضطرابي إذا ما","خفقت في جوانبي الأرواح",33,"ح",1,0],["أوَ ما ترى قطر العراق بحسنه","قد فاق مُقِفره على مَأهوله",34,"ل",2,0],["أؤم المؤمنين إليك نشكو","مصيبتنا بجهل المؤمنات",35,"ت",1,0],["أو مثل محتطب بليل دامس","أيَدوس أفعى أم يلامس عقربا",36,"ب",2,0],["أوَ ما تعلم في هذي الحياة","أن رب العلم حيٌّ لا يموت",37,"ت",1,0],["أو ما يشجيك منه","أنه في برَ حاء",38,"ا",2,0],["أو ما يشجيك منه","نفس ذو صُعَداء",38,"ا",2,0],["أَو مِثلَ جَزءٍ حينَ تَصطَكُّ القَنا","وَالحَربُ كاشِرَةٌ عَنِ الأَنيابِ",39,"ب",1,0],["أَو مِثلَ فارِسِ ذي الخِمارِ وَمَعقِلٍ","أَو فارِسٍ كَعُمارَةَ بنِ جَنابِ",39,"ب",1,0],["أَو مِثلِ آلِ زُهَيرٍ وَالقَنا قِصَدٌ","وَالخَيلُ في رَهَجٍ مِنها وَإِعصارِ",40,"ر",1,0],["أَو مَذهَبٌ جَدَدٌ عَلى أَلواحِهِن","نَ الناطِقُ المَبروزُ وَالمَختومُ",41,"م",1,0],["أَو مِسحَلٍ سَنِقٍ عِضادَةَ سَمحَجٍ","بِسَراتِها نَدَبٌ لَهُ وَكُلومُ",41,"م",1,0],["أَو مُلمِعٌ وَسَقَت لِأَحقَبَ لاحَهُ","طَردُ الفُحولِ وَضَربُها وَكِدامُها",42,"م",3,0],["أَو مُسلَمٌ عَمِلَت لَهُ عُلوِيَّةٌ","رَصَنَت ظُهورَ رَواجِبٍ وَبَنانِ",43,"ن",1,0],["أؤَمِّلُ عَدلاً عَسَى أن أنَا","لَ ما بَينَ شَرقٍ الى مَغرِبِ",44,"ب",1,0],["أَوما كَشَفتَ عَنِ اِبنِ دا","وُودٍ ثَقيلاتِ الكُبولِ",45,"ل",1,0],["أَو مِن بَني نَوفَلٍ أَو وُلدِ مُطَّلِبٍ","لِلَّهِ دَرُّكَ لَم تَهمُم بِتَهديدي",46,"د",2,0],["أَو مِن سَرارَةُ أَقوامٍ أُلي حَسَبٍ","لَم تُصبِحِ اليَومَ نِكساً مائِلَ العودِ",46,"د",1,0],["أَومى إِلى الكَوماءِ هَذا طارِقٌ","نَحَرَتنِيَ الأَعداءُ إِن لَم تُنحَري",47,"ي",1,0],["أو مخلبٌ مدَّهُ نسرُ السماءِ لهم","فكلّ طائرِ قلبٍ منه مذعور",48,"ر",1,0],["أو منجلٌ بحصاد القوم منعطف","أو خنجرٌ مرهفُ النصلين مطرور",48,"ر",1,0],["أوَما لجفنك أو لفعلك ماضي","في سفكهِ لدمي وفي الأعراض",49,"ض",1,1],["أوما كنت إذا البغي اعتدى","موجة من لهب أو من دم !؟",50,"م",1,0],["أو مَسيرِ القضاء في ظُلمِ الغي","ب إلى من يُريده بالتَّواءِ",51,"ا",2,0],["أو من المنكرين وعْظَ المحقِّي","نَ وإن لم يُلَقَّبوا شعراءَ",52,"ا",2,0],["أوَ ما أبصرتْ لك الخيرُ عينا","ك رُباها مُصفَرَّةَ الأرجاءِ",53,"ا",2,0],["أو مثل عبد الإله ذي الشرفَ ال","باذخ يُلقى إلى العُلى سَبَبُهْ",54,"ب",2,0],["أو ما ترى فيما أباح محمدٌ","عما حماهُ من الخبائث مَرْغبا",55,"ب",2,0],["أو ما أرى ولدي قُوىً","منِّي بنقْضي تُسْتَجَدْ",56,"د",1,0],["أو من يَرَاهُ فلا يُعْطيك خِلْعَتَه","لا تُكذَبنَّ فما بالصدق من ناس",57,"س",1,0],["أؤمل في النيروز رِبعيَّ جوده","وخِرفِيَّهُ في المهرجان فأُخلَف",58,"ف",1,0],["أو من شفاء طاردٍ ضيفَ سقمْ","أو نعمٍ ملبوسة بعد نقمْ",59,"م",1,0],["أو من ثغورٍ واضحات تبتسمْ","أو من صدور كاعبات تُلتزَمْ",59,"م",1,0],["أو من ثُدِيّ ناهداتٍ تُستَلمْ","أو من تناغي النَّقرات والنغمْ",59,"م",1,0],["أو من هُدوّ بعد إقلاقٍ ألمّْ","كأنها من كلّ قلبٍ تُنتظمْ",59,"م",1,0],["أو ما رأيتِ ذوِي الخصا","ئصِ في الهوى وذوِي العمومِ",60,"م",1,0],["أَوَ ما يسرُّك أن تُشبَّهَ بالذي","يُحيي العظامَ وأنت غيرُ لعين",61,"ن",1,0],["أوَ ما درَى أن السماحة في الفتى","إغلاؤه ثمناً لغيرِ ثمين",61,"ن",1,0],["أَو مِثلَ ما نالَ نوحٌ في سَفينَتِهِ","إِذِ اِستَجابَ لِنوحٍ وَهوَ مَنجودُ",62,"د",1,0],["أَو مُقفِرٌ خاضِبُ الأَظلافِ قادَ لَهُ","غَيثٌ تَظاهَرَ في مَيثاءَ مِبكارِ",63,"ر",1,0],["أَو ما تَريني عِندَما اِشتَدَّ الدُجى","وَاِشتَدَّ دائي نامَ عَنّي عُوَّدي",64,"د",2,0],["أَو ما تَراهُم كُلَّما اِنتَسَبوا","نَصَلوا فَلا عُرباً وَلا عَجَما",65,"م",2,0],["أَو مَجلِسٌ لِلحُبِّ في ظِلِّ الصَبا","إِنَّ الحَياةَ جَميعُها هَذانِ",66,"ن",1,0],["أَوَما تَرى ثَغرَ الأَزاهرِ باسِماً","فَرَحاً وَعُريانَ الغُصونِ قَد اِرتَدى",67,"د",2,0],["او من طيور الخلد","يرففن على المشارب",68,"ب",1,0],["او مرقص للهو في قاعاته","تتخاصر الفتيات والفتيان",69,"ن",1,0],["أو ما ترى أهل البلاد تقيّدوا","للغرب من حاجاتهم بقُيود",70,"د",1,0],["أو من لها أن تستعد وأن تُرى","عقدا بأفراح الأمير منضدا",71,"د",2,0],["أو من عناق التصابي","وقرع خدّ بخد",72,"د",1,0],["أو من حديث ابن هانى","يعيد فيه ويبدى",72,"د",2,0],["أو من حنين الهوادى","إلى العَرار ونجد",72,"د",1,0],["أو مثل مطران الذي","أقبل يوما وانقلب",73,"ب",1,0],["أَوَ ما تَراها في البِلادِ كَقاهِرٍ","في كُلِّ ناحِيَةٍ يُسَيِّرُ عَسكَرا",74,"ر",2,0],["أَو مانِعٍ جاراً يُناضِلُ دونَهُ","أَو حافِظٍ لِعُهودِهِ ميفاءِ",75,"ا",2,0],["أَو مُفَنِّداً","يَخلُقُ الرِيَب",76,"ب",1,0],["أَوَما تَرَونَ الأَرضَ خُرِّبَ نِصفُها","وَدِيارُ مِصرٍ لا تَزالُ جِنانا",77,"ن",2,0],["أَوَ ما تَراهُم ذَبَّحوا جيرانَهُم","بَينَ البُيوتِ كَأَنَّهُم أَغنامُ",78,"م",1,0],["أَوَ ما تَرونَ عَلى المَنابِعِ عُدَّةً","لا تَنجَلي وَعَلى الضِفافِ عَديدا",79,"د",2,0],["أَوَمَا تَرَى طِمْرَيَّ بينهما","رَجُلٌ أَلَحَّ بِهَزْلِهِ الجِدُّ",80,"د",1,1],["أَوَ ما وَجَدتُم في الصَراةِ مُلوحَةً","مِمّا أُرَقرِقُ في الفُراتِ دُموعي",81,"ي",1,0],["أو ما رأوا حكماءنا جمعوا","بين الغرائب نسبة وولد",82,"د",1,0],["أو ما ترى الحمى التي","عاد المريض عدادُها",83,"د",3,0],["أومِّلُ منه دولةً تكبتُ العِدى","ونصراً يَرُدُّ الجيشَ وهو كَهامُ",84,"م",1,0],["أَوَ ما بَدا لك في الإِفاقة والأُلى","نازعتَهمْ كأسَ الغرام أفاقوا",85,"ق",3,0],["أَوَ ما سمعتَ مقالَ قائِلهمْ","اِفعلْ جميلاً وارمِ في البحرِ",86,"ر",1,0],["أوما رأيتَ النارَ تأكلُ نفسها","حتى تعودَ إِلى الرَّمادِ الهامدِ",87,"د",1,0],["أوَمَا درتْ أني أنزِّهْ شيمتي","كيلا أبيتَ وعِرضِيَ المَسْبوبُ",88,"ب",1,0],["أَوما يَرى الأرزاق تطلُب غافلاً","وتَصُدُّ عن لهفانَ وهو طَلوبُ",88,"ب",1,0],["أَومَضنَ مِن خَلَلِ الخُدورِ فَراعَنا","بَرقانِ خالٌ ما يُنالُ وَخُلَّبُ",89,"ب",1,0],["أُؤَمِّلُ جَدواهُ وَأَرجو نَوالَهُ","وَما الآمِلُ الراجي نَداهُ بِخائِبِ",90,"ب",1,0],["أَوَ ما سَمِعتَ بِيَومِهِ المَشهودِ في","لُكّامِهِم إِن كُنتَ لَمّا تَشهَدِ",91,"د",1,0],["أَوَما كَفانا أَن بَكَينا غُرَّباً","حَتّى شَجانا بِالمَنازِلِ ثَهمَدُ",92,"د",1,0],["أُؤَمِّلُها وَأَفرَقُها جَميعاً","وَأَقرَبُ ما أُؤَمِّلُهُ بَعيدُ",93,"د",1,0],["أَو ما تَرَونَ الشامِتينَ أَمامَكُم","وَوَراءَكُم مِن مُضمِرٍ أَو مُظهِرِ",94,"ر",1,0],["أَو مُستَجيراً بِوَصلٍ مِنكَ تَرحَمُهُ","مِثلَ الَّذي قالَ في سِرٍّ وَإِجهارِ",95,"ر",1,0],["أَوَ ما رَأَيتَ الخُنثَ في أَعطافِهِ","وَمَقَصَّ تِلكَ اللِحيَةِ المَجزوزَه",96,"ز",2,0],["أَو ما عَلِمتُم أَنَّ سَيفَ مُحَمَّدِ","أَمسى عَذاباً بِالطُغاةِ مُحيقا",97,"ق",2,0],["أَو ما تَرى الدِمَنَ المُحيلَةَ تَشتَكي","غَدَراتِ عَهدٍ لِلزَمانِ مُحيلِ",98,"ل",1,0],["أَو ما رَأَيتَ المَجدَ أَلقى رَحلَهُ","في آلِ طَلحَةَ ثُمَّ لَم يَتَحَوَّلِ",99,"ل",1,0],["أَوَ ما تَرى حُسنَ الرَبيعَ وَما بَدا","وَأَعادَ في أَيَّمِهِ المُتَوَكِّلُ",100,"ل",1,0],["أَو ما عَلِمتَ بِأَنَّ مَن طَلَبَ العُلا","بِالسَيفِ في يَومِ الوَغى لَم يَسلَمِ",101,"م",1,0],["أَوَ ما تَراهُ تَغَيَّرَت قَمَرِيَّةٌ","في لَونِهِ فَتَغَيَّرَت أَلوانُها",102,"ن",3,0],["أَوَماكَفاكِ بِدَمعِ عَيني شاهِداً","بِصَبابَتي وَمُخَبِّراً عَن شاني",103,"ي",1,0],["أَو مُقرَبٍ رَحبِ المَناخِرِ سابِحٍ","يَشجى بِهِ يَومَ اللِقاءِ عِداهُ",104,"ا",2,0],["أَو مِن فُراتِ أَبي العاصي إِذا اِلتَطَمَت","أَثباجُهُ بِمَكانٍ واسِعِ الثَلَمِ",105,"م",1,0],["أو ما رأيت هلال شهرك قد بدا","في الأفق مثل شعيرة السكين",106,"ن",1,0],["أو ما رأيت الغيث سفه رأيه","لما تشبه بالأمير فوائدا",107,"د",2,0],["أو مادحاً وجدَ المديحَ مُسَيَّراً","ورأى الكلامَ مُصَدَّقاً فتكلَّما",108,"م",2,0],["أو مُتَمَطٍّ هَبَّ من منامِه","بمُلجَمٍ قد باتَ في لِجامِه",109,"م",2,0],["أُؤمِّلُ مَعْشراً جَهِلُوا المَعالي","فضَلُّوا وَهْيَ واضحِةُ السَّبيلِ",110,"ل",1,0],["أوَ ما رأيتَ ضَراغِمَ الدْ","ندُيا لِوَثْبَتِهِ فَرائِس",111,"س",1,0],["أو من حَبيرِ مُزنَةٍ غرَّاءِ","غذاؤنا بوركَ من غَذَاءِ",112,"ا",2,0],["أَو مَسَّكَ الضُرُّ أَو بُليتَ بِهِ","فَاِصبِر فَإِنَّ الرَخاءَ في أَثَرِه",113,"ر",2,0],["أَو ما تَقولُ إِذا حَلَلتَ مَحَلَّةً","لَيسَ الثِقاتُ لَأَهلِها بِثِقاتِ",114,"ت",1,0],["أَو ما تَقولُ وَلَيسَ حُكمُكَ نافِذاً","فيما تُخَلِّفُهُ مِنَ التَرِكاتِ",114,"ت",1,0],["أُؤَمِّلُ أَن أَخَلَّدَ وَالمَنايا","يَثِبنَ عَلَيَّ مِن كُلِّ النَواحي",115,"ي",1,1],["أَوَما تَرى أَنَّ المَصائِبَ جَمَّةٌ","وَتَرى المَنِيَّةَ لِلعِبادِ بِمَرصَدِ",116,"د",1,0],["أَوما تَرى الأَيّامَ تَخ","تَلِسُ النُفوسَ وَتَنتَقي",117,"ي",1,0],["أَو ما تَرى الدُنيا وَمَصدَرُ أَهلِها","ضَنكٌ وَمَورِدُها كَريهٌ آجِنُ",118,"ن",1,0],["أَوما عَلِمتَ وَمِثلُ جَهلِكَ غالِبٌ","أَنَّ المِزاحَ هُوَ السِبابُ الأَكبَرُ",119,"ر",1,0],["أَومَت إِلَيَّ مُشيرَةً أَن لا تَخَف","وَابشِر فَإِنَّكَ في ذُرى العَلياءِ",120,"ا",2,0],["أُؤَمِّلُ غُفرانَ ذَنبي إِلَيكَ","لِما كانَ عِندَكَ لي مِن مَكانِ",121,"ن",1,1],["أَوَما تَرى الغَيمَ الرَقيقَ وَما بَدا","لِلعَينِ مِن أَشكالِهِ وَطُرودِهِ",122,"د",2,0],["أَوَما تَرى في كُلِّ قُطرٍ مُنيَةً","مِن جانِبَيها وَهيَ مُجتَمَعُ المُنى",123,"ن",2,0],["أَو مَن تَدَرَّعَ بِالعَجاجَةِ عِندَما","نادى مُنادي القَومِ يا خَيلُ اِحمِلي",124,"ي",1,0],["أو مدركٍ عمقَ المعانِي التي","في لمحةٍ عابرةٍ تحتشد",125,"د",1,0],["أو ما ترى الضيف الذي قدما","يطوي الغيوب ويذرع الظلما",126,"م",2,0],["أو منحتَ الكهامَ منك مضاءً","فَلَقَ الهامَ وهو غيرُ كهامِ",127,"م",1,0],["أو ماردٍ في غرامٍ من تَمَرّدِهِ","بمثله العُصْمُ في الأطواد تعتصمُ",128,"م",1,0],["أوَميضُ البرقِ في الليل البهيمْ","أم أياةُ الشمس في كأس النديم",129,"م",1,1],["أو مُشْبِهٍ لعس الشفاهِ فكُلَّما","رَشَفَتْهُ بالنّظَرِ العيونُ أحالا",130,"ل",2,0],["أوَ ما رَأَوْا يحيَى سعادَتُهُ","وقفٌ عليها النّصْرُ والظّفَرُ",131,"ر",1,0],["أوَ ما علمتَ بأنّ فُتّاكَ الهوى","حُورٌ تكافحُ بالعيون مِلاحُ",132,"ح",1,0],["أَو مِثلَ راعي السوءِ أَتلَفَ ضَأنَهُ","لَيلاً وَأَصبَحَ فَوقَ نَشزٍ يَنعَقُ",133,"ق",1,0],["أَوَ ما رَأَيتَ مَنازِلَ اِبنَةِ مالِكٍ","رَسَمَت لَهُ كَيفَ الزَفيرُ رُسومُها",134,"م",3,0],["أَوَ ما تَراها ما تَراها هِزَّةً","تَشأى العُيونَ تَعَجرُفاً وَذَميلا",135,"ل",2,0],["أَوَ ما رَأَيتَ الوَردَ أَتحَفَنا بِهِ","إِتحافَ مَن خَطَرَ الصَديقُ بِبالِهِ",136,"ل",2,0],["أَوَما رَأَت بُردَيَّ مِن نَسجِ الصِبى","وَرَأَت خِضابَ اللَهِ وَهوَ خِضابي",137,"ب",2,0],["أَوَ مَا بَدَا لَكَ أَنْ تَعُو","دَ عَنِ الصِّبَا أَوَ مَا بَدَا لَكْ",138,"ك",1,0],["أو ما ترى وجهَ الربيعِ وحسنَهُ","والروضَ يضحكُ والحيا يتهللُ",139,"ل",1,0],["أوَ ما علمتَ بأنَّ ما","حرفٌ يكفُّ عنِ العملْ",140,"ل",1,0],["أُؤَمِّنُ فَاِدعُ اللَهَ يَجمَعُ بَينَنا","بِحَبلٍ شَديدِ العَقدِ لا يَتَحَلَّلُ",141,"ل",1,0],["أَوَما أَتاكُمُ بِالمُحَصَّبِ مِن مِنىً","مِن أُمِّ عَمروٍ تِربِها ذِكرُ",142,"ر",1,0],["أَو مَجلِسَ النِسوَةِ الثَلازِ لَدى ال","خَيماتِ حَتّى تَبَلَّجَ السَحَرُ",143,"ر",1,0],["أَومَت بِعَينَيها مِنَ الهَودَجِ","لَولاكَ في ذا العامِ لَم أَحجُجِ",144,"ج",1,1],["أُؤَمِّلُ أَن أَعِلَّ بِشُربِ لَيلى","وَلَم أَنهَل فَكَيفَ لِيَ العَليلُ",145,"ل",1,0],["أوَمَا كَفَى نَوْمُ الحماةِ وما جَنَتْ","تلك المضاجعُ من أذىً وخَبالِ",146,"ل",1,0],["أوَ ما رَأَيْتُم كيف كان يَزِينُه","للحقِّ نُورٌ سَاطِعٌ وبَيانُ",147,"ن",1,0],["أَوَ مَا لَمستَ صُدورَهم فعرفتَها","ومن التّرائبِ والصُّدورِ ضرامُ",148,"م",1,0],["أَوَ ما كَفَى ما ذَاقَ مِن آلامِه","شَعبٌ على نُوَبِ الزّمانِ صَبورُ",149,"ر",1,0],["أوَ ما كفاكَ الجُّودُ بالنّفسِ التي","حمَّلتَها عِبءَ الجهادِ المُضلِعِ",150,"ع",1,0],["أوما رأيتَ مُحمدّاً في نُورهِ","وشَهِدتَ رِفقتَهُ الكِرامَ الشُّوسا",151,"س",2,0],["أَوَما تَرَوْنَ الشّرقَ كيف أضاعَهُ","عَبَثُ الهوَى وتحكُّمُ الأفرادِ",152,"د",1,0],["أَوَ ما رَأَت صُنعَ الخَليلِ فَأَكبَرَت","في العالَمينَ جَليلَ صُنعِ الباري",153,"ر",2,0],["أَومَأتَ فَاِستَنفَرَت تُدلي بِبَيعَتِها","وَاِستَرسَلَت مِن زُرافاتٍ وَوحدانِ",154,"ن",1,0],["أوَ ما كفى شهرٌ يجرُّ وراءَهُ","شَهراً لِمن يبغِي المحَجَّةَ مِنهُمُ",155,"م",1,0],["أوَ ما كَفَاكُمْ ما يَقُولُ إلهُكُم","في مَدْحِكُمْ وَيَضُمُّ منه المُصْحَفُ",156,"ف",1,0],["أَوَما تَرى الأَيّامَ كَيفَ تَبَسَّمَت","عَن وَصلِ موسى بَعدَ طولِ عُبوسِ",157,"س",1,0],["أَو مُدَّتِ الأَيدي لَهُ تَدعو فَكَم","مُدَّت إِلى إِحسانِهِ المُتَوَكِّفِ",158,"ف",1,0],["أَوَما كَفاهُم مَنعُهُم حَتّى رَمَوا","مِنها مُبَرَّأَةً بِرَجمِ ظُنونِ",159,"ن",1,0],["أَومى إِلَيَّ بِلَحظِهِ فَتَناثَرَت","خِيَلانُهُ في الخَدِّ مِن أَشفارِهِ",160,"ر",2,0],["أَو مَسَّ عوداً ذابِلاً بِبَنانِهِ","مَسّاً لَأَورَقَ في يَدَيهِ وَنَوَّرا",161,"ر",2,0],["أَوَما تَرِقُّ عَلى رَهينِ بَلابِلٍ","رَقَّت عَلَيكَ دُموعُهُ وَنَسيبُهُ",162,"ب",2,0],["أَو مُعزِبٌ وَحدٌ أَضَلَّ أَفائِلاً","لَيلاً فَأَصبَحَ فَوقَ قَرنٍ يَنشُدُ",163,"د",1,0],["أُؤَمِّلُ مِنكَ أَيادي نَدىً","منَ الجُودِ ناحِلَةً مانِحَه",164,"ح",2,0],["أَومى إِلَيها بِالزِما","مِ فَلَم تَدَع لِلسَطوِ عَدوا",165,"و",2,0],["أَوَما تَعلَمُ أَنَّ ال","غَيمَ ساقٍ مُسَتَحَثُّ",166,"ث",1,0],["أَوَ ما عَجِبتَ لِصاحِبٍ لي شَرُّهُ","لا يَتَّقي أَن يَستَشيرَ وَيَبحَثا",167,"ث",2,0],["أَوَما كُنتَ قَد نَزَعتَ عَنِ الغِي","يِ وَسافَرتَ في التُقى وَرَجَعتا",168,"ت",2,0],["أوَ ما حَرَّمَ الإِلهُ نِكَاحَ ال","أُختِ بعدَ التحليلِ فَهْوَ الزِّناءُ",169,"ا",2,0],["أوَ ما تَرَى حُبَّ السَّلامَةِ جاعِلِي","أُلْقِي السَّلامَ مُسالِماً والكِيسا",170,"س",2,0],["أوَ ما تَرَى الدِّينَ الحَنِيفَ بِسَيْفِهِ","جَعَلَ الطّهورَ لهُ دَماً مَطلولا",171,"ل",2,0],["أوَما تَراها رِيقُها يُحلِي الجَنَى","وبِناؤُها في غايَةِ الإِحْكَامِ",172,"م",1,0],["أوَ ما كانَ عِدَّةَ الفُقها","ألْفُ فَقِيهٍ مِنْ بَعِدِها مِئَتَانِ",173,"ن",1,0],["أوَما ترى الدّنْيا وجامعَ حُسنْهِا","صُغرى لديه وهي يعظُمُ شانها",174,"ن",3,0],["أوَما سَمِعْتُمْ عن وقائِعِهِ التي","لم تُبْقِ إشراكاً ولا تبديلا",175,"ل",2,0],["أوَمَا يَعْجَبُ مِنّا أنّنَا","عَرَبٌ نُوتِرُ لا نُعْطي القَودَ",176,"د",1,0],["أوَما اتَّقَيْتَ اللّه في العضْوِ الذي","يَفديه أجمعُ مُهجةِ الصِّنديد",177,"د",1,0],["أوَما خشيتَ من الصّوارمِ حولَه","تهتزُّ من حَنَقٍ عليك شديد",177,"د",1,0],["أوَما ترى الأعمارَ لو قُسمتْ على","قَدْرِ الكِرام لَفُزْتَ بالتَّخليد",177,"د",1,0],["أوَما ترَى دُوَلَ الملوكِ تُطيعه","فكأنّها خَوَلٌ لهُ وإماء",178,"ا",2,0],["أَوَما تَرعَوي عَنِ ال","غَيِّ في شَرِّ مَن مَشى",179,"ش",2,0],["أَوما بِعَينَيهِ بِتَسليمَةٍ","وَقَلبُهُ مِن وَجَلٍ يَخفِقُ",180,"ق",1,0],["أَوَما تَرى الخَضراءَ لابِسَةً","شِقَقاً كَمِثلِ كَوافِنِ السَومِ",181,"م",1,0],["أَوَ ما رَأَيتَ الكَأسَ حينَ مَزَجتَها","فَتَبَلَّدَت كَتَبَلُّدِ الفَدمِ",182,"م",1,0],["أَوَما تَرى أَيدي السَحائِبِ رُقِّشَت","حُلَلَ الثَرى بِبَدائِعِ الرَيحانِ",183,"ن",1,0],["أَو مِسكَةٌ خالَطَها عَنبَرٌ","وَاستَودَعَت طاقَةَ رَيحانِ",184,"ن",1,0],["أو مستهاماً بدارِ قومٍ","بادوا كما بادَ قومُ هودِ",185,"د",1,0],["أوّما ترى العصرين عن قوسِ الردى","يتناضلان تقضّيَ الأعمارِ",186,"ر",1,0],["أَو مُتُّ مِن حُبّي لَها","فَأَنا القَتيلُ بِهِ الشَهيدُ",187,"د",1,0],["أَو ما يُبصِرونَ فِعلَ الرَدى كَي","فَ يَبيدُ الأَصهارُ وَالأَحماءُ",188,"م",3,0],["أَو مَأَت لِلحِذاءِ كَفُّ الثُرَيّا","ثُمَّ صُدَّ الحَديثُ وَالإيماءُ",188,"م",3,0],["أَو ماتَفيقُ مِنَ الغَرامِ بِفارِكٍ","مَشهورَةٍ مَعَ غَيرِنا وَقَعاتُها",189,"ت",3,0],["أُؤَمِّلُ عَفوَ اللَهِ وَالصَدرُ جائِشٌ","إِذا خَلَجَتني لِلمَنونِ الخَوالِجُ",190,"ج",1,0],["أُؤَمَّلُ جَنَّةً رَحُبَت وَراحَت","وَتَعجَزُ قُدرَتي عَن نَيلِ فِترِ",191,"ر",1,0],["أَو ما رَأَيتَ جَنائِزاً مَحمولَةً","تَمشي الغُواةُ أَمامَها وَعِراضَها",192,"ض",3,0],["أَوَما قَرَأتَ سِجِلَّ دَهرِكَ ناطِقاً","بِالهُلكِ يُشَكَّلُ بِالخُطوبِ وَيُنقَطُ",193,"ط",1,0],["أَوَما تَرى حُكمَ النُجومِ مُصَوِّراً","بَيتَ الحَياةِ يَليهِ بَيتُ المالِ",194,"ل",1,0],["أَو مِن مُعَتَّقَةٍ وَرهاءَ نَشوَتُه","أَو مِن أَنابيبِ رُمّانٍ وَتُفّاحِ",195,"ح",1,0],["أَو مُهرَةٌ مِن عِتاقِ الخَيلِ سابِحَةٌ","كَأَنَّها سَحقُ بُردٍ بَينَ أَرماحِ",196,"ح",1,0],["أَوْمَتْ إِليكَ جُفونُها بِوَادعِ","خَوْدٌ بَدَتْ لكَ مِنْ وَراءِ قِناعِ",197,"ع",1,1],["أَوَ ما سَمِعْتَ بِمَنْ مَضَى","هَذَا يُذَمُّ وَذاكَ يُحْمَدْ",198,"د",1,0],["أوَميضُ بَرْقٍ بالأُبَيْرِقِ لاَحا","أم في رُبَى نجد أرى مِصباحا",199,"ح",2,1],["أو مُرِ الغُمْضَ أَنْ يَمُرّ بجَفْنِي","فكأني بِهِ مُطِيعاً عَصَاكا",200,"ك",2,0],["أَو مدلجاً في لَيلها","وَاللَيل معتكر مخوف",201,"ف",1,0],["أو ملحة عذبةٍ جلاها","أسلوبه الساحر اللعوب",202,"ب",1,0],["أوَ ما تبصرُ الكواكبَ غرقى","في دياجيه كاسفاتٍ خوابي",203,"ب",2,0],["أو ما تُطلقينها من دياجي","كِ أما تبعثينها بعد موتِ",204,"ت",1,0],["أوْمى لها الماضي فجنَّ حديدُها","حتى تكادَ بغيرِ كفٍّ تُمشقُ",205,"ق",1,0],["أو مَنْهَلٌ طافَتِ الحَمامُ به","فالرّيشُ طافٍ عليهِ لم يَصِم",206,"م",1,0],["أوَما رأيتِ الليلَ يُلْقي شُهْبَه","حتى يُجاوِزَها بحُلّةِ عاطِلِ",207,"ل",1,0],["أَوْ مُتَّ قبْلي فما مَنْعَاكَ لِي عَجَبٌ","إِنَّ الكَرِيمَ إِلى الأَصْحابِ مَنْعِيُّ",208,"ي",1,0],["أو مِن نُسُورٍ حَولَ مَوتَى مَعاً","يَأكلُنَ لَحماً مِن طَرِيِّ الفريض",209,"ض",1,0],["أَوْ مِشْقَصٍ إِنْ فَوَّقَتْ نَصْلَهُ","إِلَى امْرِئٍ غَيْرُ يَدٍ أَقْصَدا",210,"د",2,0],["أَو مِن بَني شِجِعٍ إِن كُنتَ ذا نَسَبٍ","حُرٍّ مِنَ القَومِ مَنسوبٍ وَمَعلومِ",211,"م",1,0],["أَوْ مَا لَنَا فِي تَالِدٍ أَوْ طَارِفٍ","مَجْدٍ لَهُ رَجْعٌ عَلَى الأَيَّامِ",212,"م",1,0],["أَوْ مَا لِهَذَا الغِيلِ زَأْرٌ مُنْذِرٌ","لِلطَّارِقِينَ بِيَقْظَةِ الضِّرْغَامِ",212,"م",1,0],["أَوْ مَا تَعَوَّدْتَ البُلُوغَ إِلَى المُنَى","فِيمَا اضْطَلَعْتَ بِهِ وَلَيْسَ قَلِيلاَ",213,"ل",2,0],["أَو مَا رَأَيْنَاهَا تَشِيدُ مَمَالِكاً","وَتُعِزُّ أَقْطاراً عَلى أَقْطَارِ",214,"ر",1,0],["أوْ مِنْ وُلُوعٍ لِلأَمِي","رِ بِكُلِّ مطْلُوبٍ جُسَامِ",215,"م",1,0],["أَوَ مَا صَحَّ أَنْ فِي كُلِّ عَصرٍ","أَنْذَرَ النَّاسِ مُحْسِنٌ مَجْهُولُ",216,"ل",1,0],["أوْ مَا تُرَى فَوْقَ الحُبَابِ خُطُورَهَا","بَيْنَ ابْتِسَامِ الموْجِ والتَّقْبِيلِ",217,"ل",1,0],["أَوْ مُحْرِزاً جَاهاً عَرِيضاً قَلَّمَا","سَمَحَتْ بِهِ الأيَّامُ لِلافْرَادِ",218,"د",1,0],["أَوْ مِنْ أَدِيبٍ أَوْ صُنَاعٍ سَاقَهُمْ","شَوْقٌ إِلى رَوْضِ الْكَمَالِ الزَّاهِرِ",219,"ر",1,0],["أَوَ مَا نَرَى شُهُبَ السَّمَاءِ كَأَنَّهَا","أُكَرٌ بِهَا تَتَلاعَبُ الأَقْدَارُ",220,"ر",1,0],["أَوْ مَائِهَا الْعَذْبِ الْبَرودِ إِذَا","مَا الْقَيْظُ أُوقِدَ شَرَّ إِيقَادِ",221,"د",1,0],["أَو مِن مُعَتَّقَةٍ وَرهاءَ نَشوَتُها","أَو مِن أَنابيبِ رُمّانٍ وَتُفّاحِ",222,"ح",1,0],["أو مثلَ مَشْيِ أُسُودِ الظّلِّ ألثَقَها","يَوْمُ زَذَاذٍ منَ الجَوْزَاءِ مَشْمُولُ",223,"ل",1,0],["أو مريها بأن تكون شموعا","طويلةَ الأعمار",224,"ر",1,0],["أَو ما فَدَّتهُ يَومَ خَوى","شُهُبٌ كانَت لَهُ خولا",225,"ل",2,0],["أَو ما تَرى أَظعانَهُنَّ بَواكِراً","كَالنَخلِ مِن شَوكانَ حينَ صِرامِ",226,"م",1,0],["أو ما كنت إذا البغي اعتدى","موجة من لهب أو دم",227,"م",1,0],["أوما تحذَرُ من يو","مٍ عبوس قمطريرِ",228,"ر",1,0],["أَوْ مَزَّقَتْ طَيْلَسَانَ اللَّيْلِ مِنْ خَبَبٍ","كَسَتْ خَيَالَ الأمَاني ثَوْبَ مَوْجُودِ",229,"د",1,0],["أو مُشكل قد راض جا","محَهُ، وذلَّلَ من صِعابه",230,"ب",2,0],["أو ما نظرتِ إلى الكنانة أعينا","تهمي، وأفئدةً بغير قرار؟",231,"ر",1,0],["أومى إليه بالحديث، كأنما","أنا جاره، وكأنما هو جاري",232,"ر",2,0],["أوَ ما ترى قلب الدجى متوهِّجًا","يحكي فؤادَ الصبِّ يومَ بعاد؟",233,"د",1,0],["أو ما استعار «التركُ» منا تاجها","لجبين «محمود»، ورأس «مراد»؟",233,"د",1,0],["أو ما رأيتَ الطامعين بخيلهم","حول الحمى، يقفون بالمرصاد؟",233,"د",1,0],["أو ما تراه في ربي","ع العمر يدركه المشيب؟",234,"ب",1,0],["أو ما كفاها معشرٌ من أهلها","ترك العروبة جانبًا واستعجما؟",235,"م",2,0],["أو ما رأيتَ العلمَ ينقُضُ ما بنى","ويُهدِّدُ العُمران بالإشعاع؟",236,"ع",1,0],["أو من عصير الزَّنْبَق الفَوَّاح","لله ومضُ نورِها اللَّمَاح!",237,"ح",1,0],["أَوْمضْ علينا ومضة الإ","يمان في ليل الجحود",238,"د",1,0],["أو ماشكا الأسطولُ من","طول التثاؤب والرقود؟",238,"د",1,0],["أوما رأيتَ البحرَ فيه كأَنَّما","لاحت تَوائمهُ بغير محار؟",239,"ر",1,0],["أو ما رأيتَ القوم قد نظروا","بمحاجرٍ كوجوههم حُمرِ؟",240,"ر",1,0],["أو ما ترى صَرْحَ الفضيلةِ قد هوَى","باسم الهوى والحب؟ قلتُ: نعم، أرى!",241,"ر",2,0],["أو ما رأيت الغَرْب ألقَى سيفَهُ","وسطا تحدى علمه واستعمرا؟",241,"ر",2,0],["أو منْشِدٌ للنَّشْءِ شِعْرَ حماسةٍ","أَو نادِبٌ طَلَلاً من الأَطْلالِ",242,"ل",1,0],["أوَ مَا نَظَرتُ إلى المهندسِ كادِحًا","في القَيْظِ بين جَنادِلٍ ورِمالِ؟!",242,"ل",1,0],["أو ما رأيت الحكْم با","تَ الآن في أيدي الطَّغام؟",243,"م",1,0],["أو ملكها وقسيمها عن أمره","يعطي بأمرك ما تشاء ويمنعُ",244,"ع",1,0],["او ما تلمحينه كيف يعدو","يطحن الريح والشظايا المُثاره",245,"ر",2,0],["أوْ مُذْهَبٌ جَدَدٌ على ألْوَاحِهِ","نَّ الناطقُ المَبْرُوزُ والمَخْتُومُ",246,"م",1,0],["أو مَا ترى شعري كأنَّ خِلالَه","نسيَ النسيمُ جناحَهُ المبلولا",247,"ل",2,0],["أو ما ترى أضغانهن بواكراً","كالنّخلِ من شَوْكانَ حينَ صِرَامِ",248,"م",1,0],["أوْمضْنَ مِنْ خَلَلِ الخذورِ، فرَاعَنا","بَرْقانِ: خالٌ مَا يُنَالُ وَخُلَّبُ",249,"ب",1,0],["أو َمَا تَرَى حُسنَ الزّمانِ، وَمَا بَدا،","وأعَادَ في أيّامِهِ المُتَوَكّلُ",250,"ل",1,0],["أوَ مَا تَرَوْنَ الشّامِتِينَ أمَامَكُمْ،","وَرَاءَكُمْ، مِنْ مُضْمِرٍ أوْ مُظهِرِ",251,"ر",1,0],["أو ما تراهم، كلّما انتسبوا","نصلوا فلا عربا ولا عجنا",252,"ن",2,0],["أومن هُدوّ بعد إقلاق الم","كأنما من كلّ قلب تُنتطم",253,"م",1,0],["أو ما أرى ولدي قُوى ً","منِّيب نقْصي تُسْتَجَدْ",254,"د",1,0],["أو ما كفى نوم الحماة وما جنت","المضاجع من أذى أذى وخبال",255,"ل",1,0],["أَوْ مَجْلِسَ النِّسْوَة ِ الثَّلاثِ لَدَى کلْ","الخيماتِ، حتى تبلج السحر",256,"ر",1,0],["أومن حَبيرِ مُزنَة ٍ غرَّاءِ","غداؤنا بوركَ من غَذَاءِ",257,"ا",2,0],["أو ما تبصر الكواكب غرقى","في دياجه كاسفات خوابي؟",258,"ب",2,0],["أو مِسْحلٍ سَنِقٍ عِضَادة َ سَمحجٍ","بسرائِها ندبٌ له وكُلُومُ",259,"م",1,0]]}