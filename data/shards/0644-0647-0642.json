صر الدهر راضيا","https://www.aldiwan.net/poem16201.html","الطويل"],[118,"بحيث اندهش الفكر","https://www.aldiwan.net/poem41097.html","عموديه"],[145,"ماذا يعيب رجال الحى في النادي","https://www.aldiwan.net/poem58426.html","البسيط"],[150,"ألا فاقر الخليل خليل باشا","https://www.aldiwan.net/poem47637.html","الوافر"],[163,"إذا جادت الروض الحديث غمائمه","https://www.aldiwan.net/poem59001.html","الطويل"],[188,"بدا شيبه قبل ابتداء شبابه","https://www.aldiwan.net/poem14116.html","الطويل"],[189,"سهرت وما مثلي ينام ويرقد","https://www.aldiwan.net/poem43910.html","الطويل"],[213,"سلوا فاتر الأجفان عن كبدي الحرا","https://www.aldiwan.net/poem13338.html","الطويل"],[213,"حديث غرامي فيك أضحى مقيدا","https://www.aldiwan.net/poem13468.html","الطويل"],[235,"هم حملوني في الهوى فوق طاقتي","https://www.aldiwan.net/poem14834.html","الطويل"],[238,"يا ابن الزريشي ما زريش","https://www.aldiwan.net/poem31907.html","مجزوء البسيط"],[255,"أوجدي كذا أم هكذا كل من يهوى","https://www.aldiwan.net/poem1420.html",""],[285,"بكاء الحمائم ضحك الحمام","https://www.aldiwan.net/poem32419.html","المتقارب"],[285,"ذكرتك إذ شمت بالشام برقا","https://www.aldiwan.net/poem32694.html","المتقارب"],[285,"سرى طيف علوة من بانياسا","https://www.aldiwan.net/poem32735.html","المتقارب"],[353,"أعرفت رسم الدار بالحبس","https://www.aldiwan.net/poem640.html",""],[367,"أطاعك مني القلب العصي","https://www.aldiwan.net/poem60562.html","الوافر"],[367,"أأجفان بيض هن أم بيض أجفان","https://www.aldiwan.net/poem60628.html","الطويل"],[367,"إذا ضربوا بكاظمة الخياما","https://www.aldiwan.net/poem60656.html","الوافر"],[367,"بغرة وجهك منا القسم","https://www.aldiwan.net/poem60658.html","المتقارب"],[367,"أتلك رياض أم خدود نواعم","https://www.aldiwan.net/poem60665.html","الطويل"],[367,"سرى ولثام الصبح قد كاد ينحط","https://www.aldiwan.net/poem60859.html","الطويل"],[367,"ألا من عذيري من جوى في الجوانح","https://www.aldiwan.net/poem60966.html","الطويل"],[367,"حياءك من غصن بدمعي ثابت","https://www.aldiwan.net/poem60980.html","الطويل"],[367,"زمان قليل من بنيه نجيب","https://www.aldiwan.net/poem60998.html","الطويل"],[408,"فديت أبا نصر المرتجى","https://www.aldiwan.net/poem49512.html","المتقارب"],[409,"هي البدر لكن تستر مدى الدهر","https://www.aldiwan.net/poem50169.html","الطويل"],[409,"ألم وليلي بالكواكب أشيب","https://www.aldiwan.net/poem50207.html","الطويل"],[435,"غناء حمام في معاطف بان","https://www.aldiwan.net/poem12392.html","الطويل"],[435,"لأية حال فيض دمعك هتان","https://www.aldiwan.net/poem12754.html","الطويل"],[435,"علمنا وقد مات الكمال التساويا","https://www.aldiwan.net/poem12769.html","الطويل"],[440,"إذا بارق من بارق لاح مومضاً","https://www.aldiwan.net/poem2536.html","الطويل"],[440,"قف العيس هذا ربع سلمى فسلم","https://www.aldiwan.net/poem2538.html","الطويل"],[444,"لك اللهم تبت من المعاصي","https://www.aldiwan.net/poem14376.html","الوافر"],[460,"صحا القلب لكن صبوة وحنين","https://www.aldiwan.net/poem55824.html","الطويل"],[460,"أجاذبها لو أمكنت من زِمامها","https://www.aldiwan.net/poem55889.html","الطويل"],[463,"أهم بشكوى الدهر ثم تردني","https://www.aldiwan.net/poem16154.html","الطويل"],[466,"فؤادي وفودي بعد لمياء أشيب","https://www.aldiwan.net/poem3559.html","عموديه"],[516,"هلم بنا يا برق في أبرق الحمى","https://www.aldiwan.net/poem20828.html","الطويل"],[564,"أرى الدهر يقضي كل يوم ديونه","https://www.aldiwan.net/poem52787.html","الطويل"],[569,"يا حبذا الصرة أهدى لنا","https://www.aldiwan.net/poem69727.html","السريع"],[575,"له قلم تنقاد بيض الظبا له","https://www.aldiwan.net/poem3642.html","الطويل"],[577,"أضاء بثغرك وادي أضا","https://www.aldiwan.net/poem3054.html","المتقارب"],[577,"ببرقة ثغر لا ببرقة ثهمد","https://www.aldiwan.net/poem3084.html","الطويل"],[651,"","https://poetry.dctabudhabi.ae/diwan/poem/216883",""]],"verses":[["لَهُ قَلَمٌ إِن جَرى غَربُهُ","أَمِنّا القَنا وَخَشينا اليَراعا",0,"ع",2,0],["لَهُ قَلَمٌ ماضي الشَباةِ كَأَنَّما","أَقامَ بِشِقَّيهِ القَضاءُ المُحَتَّمُ",1,"م",1,0],["لَهُ قَصباتُ السَبقِ في كُل مَوطِنٍ","يُطيلُ إِذا أَسدى لِمَن لا يُناسِبُه",2,"ب",2,0],["لَهُ قَصرَيا عيرٍ وَساقا نَعامَةٍ","كَفَحلِ الهَجانِ يَنتَحي لِلعَضيضِ",3,"ض",1,0],["له قلم عزّ القرائح شاعراً","كما ابتزّ فُرسان البلاغة كاتبا",4,"ب",2,0],["له قلم به تحيا المعاني","كما يحيا من المطر الجديب",5,"ب",1,0],["له قلمٌ يحمِي الحمى برقاعه","ويكتب بالنعمى وبالعلمِ مزوِجا",6,"ج",2,0],["له قلمٌ في صدرِ محراب درجه","لباريه في كلِّ المقاصد ماجد",7,"د",1,0],["له قلبٌ ولي دمعٌ عليه","فهذا قاسيون وذا يزيد",8,"د",1,0],["له قلمٌ يدعو الدواة كتابةً","ويعزى به عيش الملوك إلى النّضر",9,"ر",1,0],["له قلمٌ تنهلّ بالجودِ سحبه","وتشرق في أفق الفضائلِ زُهره",10,"ر",2,0],["له قلمٌ ينحو الجميل فرفعه","لرتبة داعيه وللضدّ كسره",11,"ر",2,0],["له قلمٌ سريُّ النفع سار","يبيت على الممالك كالخفير",12,"ر",1,0],["له قلم قد جاوز الغيث فاغتدى","ينمق في أرجاء مهرقه الزّهرا",13,"ر",2,0],["له قلمٌ كالغصن بالماءِ مثمرٌ","ولكنه غصنٌ إلى الجودِ مائل",14,"ل",1,0],["له قلمٌ إن قال روّى سجله","مسامعنا أو جالَ روّت سجاله",15,"ل",2,0],["له قلم مدّ البيان عنانه","وجال فقلنا فارس النثر والنظم",16,"م",1,0],["له قلم تقسّم ريقتاه","شهاد فم المحاول أو سمامهْ",17,"م",2,0],["له قلمٌ إن ماسَ كانَ لمعتفٍ","حياةً وإلا للعدوِّ حماما",18,"م",2,0],["له قلمٌ يجدي ويردي به العِدى","فلله طعَّام اليراعة طعَّانُ",19,"ن",1,0],["له قلمٌ يكفُّ الخطب كفًّا","وينهمل الندَى منه انْهمالا",20,"ل",2,0],["له قرونٌ سَمَقَتْ في العلا","أطالها ربُّ البَريَّاتِ",21,"ت",1,1],["له قلم في السِّلم كافٍ وربما","تحوَّل رُمحاً حين تَحمَى المآقطُ",22,"ط",1,0],["له قلم يستتبع السيف طائعاً","تطوع ذناباه التي لا تفارقُهْ",23,"ه",1,1],["له قد حلا الموت الذي قد حماه من","أذاه على عهد الحياة الذي مرا",24,"ر",2,0],["لَهُ قَدَمٌ لا تَستَقِرُّ بِمَوضِعٍ","كَما يَتَنَزّى في الحَصى غَيرُ ناعِلِ",25,"ل",1,0],["لَهُ قَدَمٌ في المَجدِ تَعلَمُ أَنَّهُ","بِسُؤدُدِها يُربى مِراراً وَيُفضِلُ",26,"ل",1,0],["له قَلَمٌ تجري النجومُ بجَرِيه","يُطيعُ له حَتْمَ القَضاء ويَسمعُ",27,"ع",1,1],["لَهُ قَلَمٌ إِن خَرَّ في الطِرسِ ساجِداً","يَخُرُّ لَهُ ذو التاجِ في الأَرضِ حاكِيا",28,"ي",2,0],["لَهُ قَلَمٌ فيهِ المَنِيَّةُ وَالمُنى","فَديمَتُهُ تَهمي وَسَطوَتُهُ تُصمي",29,"م",2,0],["له قلم في الأذن تحسَبُ أنه","بِنَصرك للتوقيع في الجيش حُرِّفا",30,"ف",2,0],["لهُ قلمٌ بفضلِ اللهِ يُحيي","لنا نحيا به بعدَ انتزاحِ",31,"ح",1,0],["له قباءٌ خلْتُ تطريزَهُ","لحسنِه تطريزَ خدِّيهِ",32,"ه",1,1],["له قَطَراتٌ من سنا الوحيِ أشرقتْ","من الحُسنِ إشراقَ الجُمانِ المُنَضَّدِ",33,"د",1,0],["لَهُ قَلَمٌ يُسفِرُ النَّفعُ مِن","هُ وَالضُّرُّ عَن بَاسِمٍ بَاسِلِ",34,"ل",1,0],["لَهُ قَلَمٌ قَد أوتِيَ الحُكمَ شيمَةً","فَلَو كانَ طِفلاً كانَ في المَهدِ يَنطِقُ",35,"ق",1,0],["لَهُ قِحَّةٌ في كُلِّ شَيءٍ وَسِرُّهُ","مُباحٌ وَخِدناهُ خَناً وَغُرُورُ",36,"ر",1,0],["له قَلَمٌ بالبأْس يَجْرِي وَبالنَّدَى","فَفِي جانِبَيْهِ جَنَّةٌ وَسَعِيرُ",37,"ر",1,0],["لَهُ قَهقَهَةٌ فيهِ","عَلى حِبَّةِ أَنفاسِ",38,"س",1,0],["لَهَقاً كَأَنَّ سَراتَهُ كُسِيَت","خَرَزاً نَقا لَم يَعدُ أَن قَشُبا",39,"ب",2,0],["لَهُ قَائِدٌ دُهْمُ الرَّبَابِ وخَلْفَهُ","رَوَايَا يُبَجَّسْنَ الغَمَامَ الكَنَهْوَرَا",40,"ر",2,0],["لَهُ قُصَّةٌ فَشَغَت حاجِبَيهِ","والعَينُ تُبصِرُ ما في الظُّلُم",41,"م",1,1],["لَهُ قَلَمٌ لَوْ كَانَ لِلسَّيْفِ حَدُّهُ","لَفَلَّ حَبِيكَ السَّرْدِ فِي كُلِّ مَوْقِفِ",42,"ف",1,0],["لَهُ قَلَمٌ لَوْلا غَزَارَةُ فِكْرِهِ","لَجَفَّتْ لَدَيهِ السُّحْبُ أَوْ نَفِدَ الْبَحْرُ",43,"ر",1,0],["له قَلَمٌ لو لاَمَس الطِّرْسَ مَرَّةً","تَدَانَى له صَعْبُ القَرِيض ونَافِرُه",44,"ر",2,0],["له قطرات لا يُبَل بها صدى","ولا يابس تبقى عليه ولا رطب",45,"ب",1,0],["له قطع مخروط وجيد غزالة","ومنقار طاووس وجفنة مستسق",46,"ق",1,0],["لَهُ قُصْرَيَا غَيرٍ وَسَاقَا نَعَامَة","ٍ كَفَحلِ الهِجانِ يَنتَحي للعَضِيضِ",47,"ض",1,0],["ِلَّهِ قاضي دَينَدوزَ فَإِنَّهُ","قاضٍ إِذا أَسدى أَطالَ وَأَعرَضا",48,"ض",2,1],["لَهُ قَلَمٌ كَم صَدَّ بيضاً فَواتِكاً","بِقاطع أَحكام وَسُمراً عَواليا",49,"ي",2,0],["له قد خط في لوح ال","علا قبل الاولى السطر",50,"ر",1,0],["له قِبابٌ بطيب الذكرِ شيَّدها","فما دُعِمنَ بأطنابٍ وأوتادٍ",51,"د",1,0],["له قل يا شقيق الروح عني","علام هجرت بلدتنا بروسا",52,"س",2,0],["له قوة لا تزدهي بخديعة","فخذ في الكلام الحذر يامن يكالمه",53,"م",2,0],["له قلمٌ يستخدِم السيفَ والقَنا","وتُغْنى وتُفْنى