{"poems":[[53,"تخيرته أطول القوم باعا","https://www.aldiwan.net/poem30153.html","المتقارب"],[86,"يحييك من أرض الكنانة شاعر","https://www.aldiwan.net/poem68927.html","الطويل"],[71,"لي الشرف الأعلى الذي عز جانبه","https://www.aldiwan.net/poem3929.html","الطويل"],[0,"أعني على برق أراه وميضِ","https://www.aldiwan.net/poem54.html","الطويل"],[88,"هي النفس أغشى في رضاها المعاطبا","https://www.aldiwan.net/poem44814.html","الطويل"],[88,"لهذا اليوم في التأريخ ذكر","https://www.aldiwan.net/poem44990.html","الوافر"],[72,"حلفت بليل الشعر منه إذا سجى","https://www.aldiwan.net/poem18453.html","الطويل"],[72,"تنهدت لما أذكرتني النواهد","https://www.aldiwan.net/poem18571.html","الطويل"],[72,"رشا بالصالحية سفح عيني","https://www.aldiwan.net/poem18660.html","الوافر"],[72,"وقائع حب حار في كرها فكري","https://www.aldiwan.net/poem18705.html","الطويل"],[72,"تجلى فقلت البدر والليل شعره","https://www.aldiwan.net/poem18708.html","الطويل"],[72,"هنيئا لأفق الفضل إنك بدره","https://www.aldiwan.net/poem18711.html","الطويل"],[72,"أما وتلفت الرشاء الغرير","https://www.aldiwan.net/poem18712.html","الوافر"],[72,"تذكرت مصرا والأخلاء والدهرا","https://www.aldiwan.net/poem18713.html","الطويل"],[72,"له كل يوم فيك واش وعاذل","https://www.aldiwan.net/poem19479.html","الطويل"],[72,"أسائله يوم النوى كيف حاله","https://www.aldiwan.net/poem19483.html","الطويل"],[72,"فديت محيا في مسائله ينمي","https://www.aldiwan.net/poem19669.html","الطويل"],[72,"قوامك تحت شعرك يا أمامه","https://www.aldiwan.net/poem19681.html","الوافر"],[72,"تفهمه قلبي الشجي فهاما","https://www.aldiwan.net/poem19682.html","الطويل"],[72,"سرى والدجى كالصدر بالهم ملآن","https://www.aldiwan.net/poem20168.html","الطويل"],[72,"بدت ورنت لواحظه دلالا","https://www.aldiwan.net/poem20544.html","الوافر"],[51,"له قرون سمقت في العلا","https://www.aldiwan.net/poem8708.html","السريع"],[51,"بدا الشيب إلا ما تداوي المواشط","https://www.aldiwan.net/poem65000.html","البسيط"],[51,"له قلم يستتبع السيف طائعا","https://www.aldiwan.net/poem65520.html","الطويل"],[89,"إني غير مختار وفارق مضطرا","https://www.aldiwan.net/poem45097.html","الطويل"],[85,"لنا صاحب قد مس إلا بقية","https://www.aldiwan.net/poem63700.html","الطويل"],[45,"فؤاد بذكر الظاعنين موكل","https://www.aldiwan.net/poem65589.html","الطويل"],[61,"له قلم تجري النجوم بجريه","https://www.aldiwan.net/poem51563.html","الطويل"],[66,"ليالي الحمى ما كنت إلا لآليا","https://www.aldiwan.net/poem40988.html","الطويل"],[66,"ألست ترى ما في العيون من السقم","https://www.aldiwan.net/poem41585.html","الطويل"],[80,"صفا لي من ورد الشبيبة ما صفا","https://www.aldiwan.net/poem31377.html","الطويل"],[69,"أأقتل بين جدك والمزاح","https://www.aldiwan.net/poem28551.html","الوافر"],[69,"له قباء خلت تطريزه","https://www.aldiwan.net/poem29287.html","السريع"],[105,"إلى الغاية القصوى وإن شئت فازدد","https://www.aldiwan.net/poem42066.html","الطويل"],[81,"أسيف الوزارة بوركت من","https://www.aldiwan.net/poem61329.html","المتقارب"],[81,"أرقت لبرق بالحمى يتألق","https://www.aldiwan.net/poem61455.html","الطويل"],[40,"إذا حرم المرء الحياء فإنه","https://www.aldiwan.net/poem42268.html","الطويل"],[67,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[50,"ومالت كف ساقينا","https://www.aldiwan.net/poem62361.html","الهزج"],[19,"حلًت تماضر بعدنا رببا","https://www.aldiwan.net/poem322.html",""],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21097","المتقارب"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42697","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42607","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54279","الطويل"],[106,"شبح الحرب","https://www.poetsgate.com/ViewPoem.aspx?id=179421",""],[77,"أمحي رسوم الأنس إن شئت أن تبقي","https://www.poetsgate.com/ViewPoem.aspx?id=34185",""],[0,"أعِنّي عَلَى بَرْقٍ أراهُ وَمِيضِ","https://www.poetsgate.com/ViewPoem.aspx?id=4734",""],[71,"ِلَّهِ قاضي دَينَدوزَ فَإِنَّهُ","https://www.poetsgate.com/ViewPoem.aspx?id=43015",""],[110,"خليلي مالي أبصر الدهر راضيا","https://www.aldiwan.net/poem16201.html","الطويل"],[116,"بحيث اندهش الفكر","https://www.aldiwan.net/poem41097.html","عموديه"],[143,"ماذا يعيب رجال الحى في النادي","https://www.aldiwan.net/poem58426.html","البسيط"],[148,"ألا فاقر الخليل خليل باشا","https://www.aldiwan.net/poem47637.html","الوافر"],[161,"إذا جادت الروض الحديث غمائمه","https://www.aldiwan.net/poem59001.html","الطويل"],[186,"بدا شيبه قبل ابتداء شبابه","https://www.aldiwan.net/poem14116.html","الطويل"],[187,"سهرت وما مثلي ينام ويرقد","https://www.aldiwan.net/poem43910.html","الطويل"],[211,"سلوا فاتر الأجفان عن كبدي الحرا","https://www.aldiwan.net/poem13338.html","الطويل"],[211,"حديث غرامي فيك أضحى مقيدا","https://www.aldiwan.net/poem13468.html","الطويل"],[233,"هم حملوني في الهوى فوق طاقتي","https://www.aldiwan.net/poem14834.html","الطويل"],[236,"يا ابن الزريشي ما زريش","https://www.aldiwan.net/poem31907.html","مجزوء البسيط"],[253,"أوجدي كذا أم هكذا كل من يهوى","https://www.aldiwan.net/poem1420.html",""],[283,"بكاء الحمائم ضحك الحمام","https://www.aldiwan.net/poem32419.html","المتقارب"],[283,"ذكرتك إذ شمت بالشام برقا","https://www.aldiwan.net/poem32694.html","المتقارب"],[283,"سرى طيف علوة من بانياسا","https://www.aldiwan.net/poem32735.html","المتقارب"],[351,"أعرفت رسم الدار بالحبس","https://www.aldiwan.net/poem640.html",""],[365,"أطاعك مني القلب العصي","https://www.aldiwan.net/poem60562.html","الوافر"],[365,"أأجفان بيض هن أم بيض أجفان","https://www.aldiwan.net/poem60628.html","الطويل"],[365,"إذا ضربوا بكاظمة الخياما","https://www.aldiwan.net/poem60656.html","الوافر"],[365,"بغرة وجهك منا القسم","https://www.aldiwan.net/poem60658.html","المتقارب"],[365,"أتلك رياض أم خدود نواعم","https://www.aldiwan.net/poem60665.html","الطويل"],[365,"سرى ولثام الصبح قد كاد ينحط","https://www.aldiwan.net/poem60859.html","الطويل"],[365,"ألا من عذيري من جوى في الجوانح","https://www.aldiwan.net/poem60966.html","الطويل"],[365,"حياءك من غصن بدمعي ثابت","https://www.aldiwan.net/poem60980.html","الطويل"],[365,"زمان قليل من بنيه نجيب","https://www.aldiwan.net/poem60998.html","الطويل"],[406,"فديت أبا نصر المرتجى","https://www.aldiwan.net/poem49512.html","المتقارب"],[407,"هي البدر لكن تستر مدى الدهر","https://www.aldiwan.net/poem50169.html","الطويل"],[407,"ألم وليلي بالكواكب أشيب","https://www.aldiwan.net/poem50207.html","الطويل"],[433,"غناء حمام في معاطف بان","https://www.aldiwan.net/poem12392.html","الطويل"],[433,"لأية حال فيض دمعك هتان","https://www.aldiwan.net/poem12754.html","الطويل"],[433,"علمنا وقد مات الكمال التساويا","https://www.aldiwan.net/poem12769.html","الطويل"],[438,"إذا بارق من بارق لاح مومضاً","https://www.aldiwan.net/poem2536.html","الطويل"],[438,"قف العيس هذا ربع سلمى فسلم","https://www.aldiwan.net/poem2538.html","الطويل"],[442,"لك اللهم تبت من المعاصي","https://www.aldiwan.net/poem14376.html","الوافر"],[459,"صحا القلب لكن صبوة وحنين","https://www.aldiwan.net/poem55824.html","الطويل"],[459,"أجاذبها لو أمكنت من زِمامها","https://www.aldiwan.net/poem55889.html","الطويل"],[462,"أهم بشكوى الدهر ثم تردني","https://www.aldiwan.net/poem16154.html","الطويل"],[465,"فؤادي وفودي بعد لمياء أشيب","https://www.aldiwan.net/poem3559.html","عموديه"],[515,"هلم بنا يا برق في أبرق الحمى","https://www.aldiwan.net/poem20828.html","الطويل"],[563,"أرى الدهر يقضي كل يوم ديونه","https://www.aldiwan.net/poem52787.html","الطويل"],[568,"يا حبذا الصرة أهدى لنا","https://www.aldiwan.net/poem69727.html","السريع"],[574,"له قلم تنقاد بيض الظبا له","https://www.aldiwan.net/poem3642.html","الطويل"],[576,"أضاء بثغرك وادي أضا","https://www.aldiwan.net/poem3054.html","المتقارب"],[576,"ببرقة ثغر لا ببرقة ثهمد","https://www.aldiwan.net/poem3084.html","الطويل"]],"verses":[["لَهُ قَلَمٌ إِن جَرى غَربُهُ","أَمِنّا القَنا وَخَشينا اليَراعا",0,"ع",2,0],["لَهُ قَلَمٌ ماضي الشَباةِ كَأَنَّما","أَقامَ بِشِقَّيهِ القَضاءُ المُحَتَّمُ",1,"م",1,0],["لَهُ قَصباتُ السَبقِ في كُل مَوطِنٍ","يُطيلُ إِذا أَسدى لِمَن لا يُناسِبُه",2,"ب",2,0],["لَهُ قَصرَيا عيرٍ وَساقا نَعامَةٍ","كَفَحلِ الهَجانِ يَنتَحي لِلعَضيضِ",3,"ض",1,0],["له قلم عزّ القرائح شاعراً","كما ابتزّ فُرسان البلاغة كاتبا",4,"ب",2,0],["له قلم به تحيا المعاني","كما يحيا من المطر الجديب",5,"ب",1,0],["له قلمٌ يحمِي الحمى برقاعه","ويكتب بالنعمى وبالعلمِ مزوِجا",6,"ج",2,0],["له قلمٌ في صدرِ محراب درجه","لباريه في كلِّ المقاصد ماجد",7,"د",1,0],["له قلبٌ ولي دمعٌ عليه","فهذا قاسيون وذا يزيد",8,"د",1,0],["له قلمٌ يدعو الدواة كتابةً","ويعزى به عيش الملوك إلى النّضر",9,"ر",1,0],["له قلمٌ تنهلّ بالجودِ سحبه","وتشرق في أفق الفضائلِ زُهره",10,"ر",2,0],["له قلمٌ ينحو الجميل فرفعه","لرتبة داعيه وللضدّ كسره",11,"ر",2,0],["له قلمٌ سريُّ النفع سار","يبيت على الممالك كالخفير",12,"ر",1,0],["له قلم قد جاوز الغيث فاغتدى","ينمق في أرجاء مهرقه الزّهرا",13,"ر",2,0],["له قلمٌ كالغصن بالماءِ مثمرٌ","ولكنه غصنٌ إلى الجودِ مائل",14,"ل",1,0],["له قلمٌ إن قال روّى سجله","مسامعنا أو جالَ روّت سجاله",15,"ل",2,0],["له قلم مدّ البيان عنانه","وجال فقلنا فارس النثر والنظم",16,"م",1,0],["له قلم تقسّم ريقتاه","شهاد فم المحاول أو سمامهْ",17,"م",2,0],["له قلمٌ إن ماسَ كانَ لمعتفٍ","حياةً وإلا للعدوِّ حماما",18,"م",2,0],["له قلمٌ يجدي ويردي به العِدى","فلله طعَّام اليراعة طعَّانُ",19,"ن",1,0],["له قلمٌ يكفُّ الخطب كفًّا","وينهمل الندَى منه انْهمالا",20,"ل",2,0],["له قرونٌ سَمَقَتْ في العلا","أطالها ربُّ البَريَّاتِ",21,"ت",1,1],["له قلم في السِّلم كافٍ وربما","تحوَّل رُمحاً حين تَحمَى المآقطُ",22,"ط",1,0],["له قلم يستتبع السيف طائعاً","تطوع ذناباه التي لا تفارقُهْ",23,"ه",1,1],["له قد حلا الموت الذي قد حماه من","أذاه على عهد الحياة الذي مرا",24,"ر",2,0],["لَهُ قَدَمٌ لا تَستَقِرُّ بِمَوضِعٍ","كَما يَتَنَزّى في الحَصى غَيرُ ناعِلِ",25,"ل",1,0],["لَهُ قَدَمٌ في المَجدِ تَعلَمُ أَنَّهُ","بِسُؤدُدِها يُربى مِراراً وَيُفضِلُ",26,"ل",1,0],["له قَلَمٌ تجري النجومُ بجَرِيه","يُطيعُ له حَتْمَ القَضاء ويَسمعُ",27,"ع",1,1],["لَهُ قَلَمٌ إِن خَرَّ في الطِرسِ ساجِداً","يَخُرُّ لَهُ ذو التاجِ في الأَرضِ حاكِيا",28,"ي",2,0],["لَهُ قَلَمٌ فيهِ المَنِيَّةُ وَالمُنى","فَديمَتُهُ تَهمي وَسَطوَتُهُ تُصمي",29,"م",2,0],["له قلم في الأذن تحسَبُ أنه","بِنَصرك للتوقيع في الجيش حُرِّفا",30,"ف",2,0],["لهُ قلمٌ بفضلِ اللهِ يُحيي","لنا نحيا به بعدَ انتزاحِ",31,"ح",1,0],["له قباءٌ خلْتُ تطريزَهُ","لحسنِه تطريزَ خدِّيهِ",32,"ه",1,1],["له قَطَراتٌ من سنا الوحيِ أشرقتْ","من الحُسنِ إشراقَ الجُمانِ المُنَضَّدِ",33,"د",1,0],["لَهُ قَلَمٌ يُسفِرُ النَّفعُ مِن","هُ وَالضُّرُّ عَن بَاسِمٍ بَاسِلِ",34,"ل",1,0],["لَهُ قَلَمٌ قَد أوتِيَ الحُكمَ شيمَةً","فَلَو كانَ طِفلاً كانَ في المَهدِ يَنطِقُ",35,"ق",1,0],["لَهُ قِحَّةٌ في كُلِّ شَيءٍ وَسِرُّهُ","مُباحٌ وَخِدناهُ خَناً وَغُرُورُ",36,"ر",1,0],["له قَلَمٌ بالبأْس يَجْرِي وَبالنَّدَى","فَفِي جانِبَيْهِ جَنَّةٌ وَسَعِيرُ",37,"ر",1,0],["لَهُ قَهقَهَةٌ فيهِ","عَلى حِبَّةِ أَنفاسِ",38,"س",1,0],["لَهَقاً كَأَنَّ سَراتَهُ كُسِيَت","خَرَزاً نَقا لَم يَعدُ أَن قَشُبا",39,"ب",2,0],["لَهُ قُصَّةٌ فَشَغَت حاجِبَيهِ","والعَينُ تُبصِرُ ما في الظُّلُم",40,"م",1,1],["لَهُ قَلَمٌ لَوْ كَانَ لِلسَّيْفِ حَدُّهُ","لَفَلَّ حَبِيكَ السَّرْدِ فِي كُلِّ مَوْقِفِ",41,"ف",1,0],["لَهُ قَلَمٌ لَوْلا غَزَارَةُ فِكْرِهِ","لَجَفَّتْ لَدَيهِ السُّحْبُ أَوْ نَفِدَ الْبَحْرُ",42,"ر",1,0],["له قَلَمٌ لو لاَمَس الطِّرْسَ مَرَّةً","تَدَانَى له صَعْبُ القَرِيض ونَافِرُه",43,"ر",2,0],["له قطرات لا يُبَل بها صدى","ولا يابس تبقى عليه ولا رطب",44,"ب",1,0],["له قطع مخروط وجيد غزالة","ومنقار طاووس وجفنة مستسق",45,"ق",1,0],["لَهُ قُصْرَيَا غَيرٍ وَسَاقَا نَعَامَة","ٍ كَفَحلِ الهِجانِ يَنتَحي للعَضِيضِ",46,"ض",1,0],["ِلَّهِ قاضي دَينَدوزَ فَإِنَّهُ","قاضٍ إِذا أَسدى أَطالَ وَأَعرَضا",47,"ض",2,1],["لَهُ قَلَمٌ كَم صَدَّ بيضاً فَواتِكاً","بِقاطع أَحكام وَسُمراً عَواليا",48,"ي",2,0],["له قد خط في لوح ال","علا قبل الاولى السطر",49,"ر",1,0],["له قِبابٌ بطيب الذكرِ شيَّدها","فما دُعِمنَ بأطنابٍ وأوتادٍ",50,"د",1,0],["له قل يا شقيق الروح عني","علام هجرت بلدتنا بروسا",51,"س",2,0],["له قوة لا تزدهي بخديعة","فخذ في الكلام الحذر يامن يكالمه",52,"م",2,0],["له قلمٌ يستخدِم السيفَ والقَنا","وتُغْنى وتُفْنى قطرةٌ من لُعابه",53,"ب",2,0],["له قيّم لا قوّم الله ظهره","يبيع الذي يبقى بما هو ينفد",54,"د",1,0],["له قلم ان جاد يوم ترسل","فينظمها عقدا وينثرها درا",55,"ر",2,0],["له قلم لو لم يكن ذا بلاغة","لما خلته واله الا مهندا",56,"د",2,0]