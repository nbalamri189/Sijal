 وأعاديا",79,"ي",2,0],["له قلم قد شيّد الملك حدّه","وجمّع أشتات المعالي وروّضا",80,"ض",2,0],["له قلم كلت لهيبته الظبا","إذا ما انتضاه مصلتا فاغر الفم",81,"م",1,0],["له قلب إلى الأهواء لين","ولكن عن فعال الخير قاصي",82,"ص",2,0],["له قَلَقٌ مهما وهبتَ كأنّه","سليمٌ بما تُعطِي العفاةَ طعينُ",83,"ن",1,0],["له قِدَمُ الإسلامِ والفوزُ في غدٍ","بجنَّةِ عَدْنٍ بَردِها وسلامِها",84,"م",3,0],["له قسْوةٌ تحت العَوالي وغِلْظةٌ","وفي النَّصرِ لُطْفٌ سابغٌ ومراحم",85,"م",1,0],["له قامة كالسمهريّ مثقّفاً","ولحظٌ كسيف الدين في الحرب مقضب",86,"ب",1,0],["له قلمٌ يجري الزّمان بما جرى","ويسعى القَضا في إثر مَسعاهُ حيثُما",87,"م",2,0],["لهُ قَلَمٌ يجري على الصُّحْفِ راقماً","فتحسُدُ أرقامُ الطِّراز فنونَهُ",88,"ن",2,0],["له قَلَمٌ حياةٌ حين يَرْضَى","وإن يَسْخَطْ فحيةُ بَطْنِ وادي",89,"د",2,0],["لَهُ قَلَمٌ تَنقادُ بيضُ الظُبا لَهُ","وَإِن لَقَحَت حَربٌ وَزُرقُ اللَهازِمِ",90,"م",1,1],["له قلمٌ جائلٌ في الطروسِ","فتحسبُه أَرقَماً نَضْنَضَا",91,"ض",2,0],["له قلمٌ إِن لاح بالنقشِ كاتباً","فما هُو إِلا كالحُسَام المجرَّدِ",92,"د",1,0],["لهق كنار الرأس بال","علياء تذكيها الأعابد",93,"د",1,0]]}