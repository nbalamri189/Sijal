px?id=49491",""],[4927,"عَفْرَاْءُ الدَّوَاْءُ الْمُتَوَهَّم","https://www.poetsgate.com/ViewPoem.aspx?id=30174",""],[585,"يا رب أقدام كان الداء منحسما","https://www.poetsgate.com/ViewPoem.aspx?id=161846",""],[5120,"لَيْلَةٌ فِي اَلْحُبِّ","https://www.poetsgate.com/ViewPoem.aspx?id=179956",""],[5183,"إلى الباكستان","https://www.poetsgate.com/ViewPoem.aspx?id=185671",""],[5183,"ضالة المؤمن","https://www.poetsgate.com/ViewPoem.aspx?id=180165",""],[5219,"استغاثة شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=194538",""],[5277,"خاتمةُ المراثي","https://www.poetsgate.com/ViewPoem.aspx?id=199869",""],[5376,"دع عنك شعرا بما هيجته أدبا","https://www.poetsgate.com/ViewPoem.aspx?id=189134",""],[402,"بحمدون إن تنشق عليل نسيمها","https://www.poetsgate.com/ViewPoem.aspx?id=36323",""],[5961,"اضرب عن الناس","https://www.poetsgate.com/ViewPoem.aspx?id=199763",""],[6080,"ورب ليلة سعد قد حظيت بها","https://www.poetsgate.com/ViewPoem.aspx?id=127326",""],[6300,"نقش قديم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82860&r=&rc=31",""],[6300,"أنا والشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82868&r=&rc=39",""]],"verses":[["وَراقَت بِها الأَنواءُ كُلَّ صَبيحَةٍ","وَرَقَّت بِها الأَرواحُ كُلَّ ظَلامِ",0,"م",1,0],["وَراقِبوا يَومَ لا تُغني حَصائِدُهُ","فَكُلُّ حَيٍّ سَيُجزى بِالَّذي اِكتَسَبا",1,"ب",2,0],["وَراقَكِ سِحرُ العِدا المُفتَرى","وَغَرَّكِ زورُهُمُ المُفتَعَل",2,"ل",1,0],["وَرَاقَتْ مَسَاقِيهَا وَطَابَتْ ثِمَارُهَا","فَمَا الْعَيْشُ إِلاَّ صِحَّةٌ وَتَنَعمُ",3,"م",1,0],["وراقصةٍ في البحر طوع عِنانها","تراجع ألحانَ القيان الأغانيا",4,"ي",2,0],["وراق من الثغر الغريب ابتسامُه","وهزّ له الإسلام أعطاف مزدانِ",5,"ن",1,0],["ورَّاقُ ساباطَ لِم هجاني","عُثنونُهُ في استه خضيبُ",6,"ب",1,0],["وراقبي غفلةً منهُ لتنتهزِي","لي فُرصةً وتعودي منه بالظَّفَرِ",7,"ر",1,0],["وَراقَبتُ الرَسولَ وَقُلتُ يَأتي","بِتِبيانٍ فَما جاءَ الرَسولُ",8,"ل",1,0],["وَرَاقِصَةٍ لَقَطَتْ رِجْلُها","حسابَ يدٍ نَقَرَتْ طارَها",9,"ر",3,0],["وَرَاقِصَةٍ بِالسحرِ في حَرَكاتِها","تُقيمُ بِهِ وَزْنَ الغِناءِ عَلى حَدّ",10,"د",1,1],["وَراقِصِ الغُصنَ وَهوَ رَطبٌ","يَقطُرُ أَو طارِحِ الحَماما",11,"م",2,0],["وَرَاقَ مُحَيَّا الدَّهرِ وَافتَرَّ ثَغرُهُ","وَحُلِّيَ جِيدٌ مِنهُ وَاشتَدَّ كَاهِلُ",12,"ل",1,0],["وَراقِبِ اللَهَ أَن تَغُشَّ فَقَد","يَفسُدُ رَأيُ اللَبيبِ حينَ يُغَش",13,"ش",1,0],["وراقت الدنيا ورقّ الدينُ","وانفجر التمصير والتمدينُ",14,"ن",1,0],["وراقَ الهَوى منَّا عُيُونٌ كَرِيمةٌ","تَبسَّمْنَ حتى ما تَرُوقُ المباسِمُ",15,"م",1,0],["وَرَاقَتْكَ بَهْجَةُ تِلْكَ الدُّمُو","عِ بِمَرْأَى أبٍ لابْنِهِ يَلْثَمُ",16,"م",1,0],["وراقب وصايا الله سرا وجهرة","ففي كل نفس غفلة وفتور",17,"ر",1,0],["وراقَ بين الرياض فهْو كما","فَرَّج فوق الغلالِة اليَلْمَق",18,"ق",1,0],["وراقبني مقبلاً فاختفى","فنمّ عليه شذا عرفه",19,"ف",2,0],["وَرَاقِمِ الشِّعْرِ بِمَجْدِهِمُ","أَصْلِحْهُمَا وَالأَهْلَ وَالصِّبْيَهْ",20,"ي",2,0],["وراقبني بجهر السوء بغياً","على ضري ولا يخشى رقيبهْ",21,"ب",2,0],["وراقِب غيرَ مُكترثٍ بُغاةً","عُتاةً يضحكونَ مِنَ الكريث",22,"ث",1,0],["وراقِب لُصوصا غادِرينَ تَرَبّصوا","خَناجِرُهم تَنبثُّ منها الجرائمُ",23,"م",1,0],["وَراقب ربه وَعصى هواه","وحاسب نفسه قبل الحساب",24,"ب",1,0],["وراقَهُ لُؤْلُؤٌ رَطْبٌ َيفيضُ بهِ","نَحْرٌ يَرَى كُلَّ نَحْرٍ دُونَهُ يَبِسَا",25,"س",2,0],["وَراقِبي اللَهَ في ضَعيفٍ","أَمسى لِثَقيلِ الغَرامِ حامِل",26,"ل",1,0],["وراقَ العيونَ لها عارِضٌ","إذا ضَحِك البرق فيه بكَى",27,"ا",1,0],["وراقبه في حال التصرف مفززاً","فداء كما داءٌ وجرحاً كما جرح",28,"ح",1,0],["وراقِبْ أمره في كلّ حالٍ","يُفرَجْ في القيامَةِ ضيقَ حالِكْ",29,"ك",1,0],["وراقب الشيخ في أحواله فعسى","يرى عليك من استحانهِ أثَرا",30,"ر",2,0],["وراق منظرهُ للعين في طربٍ","كأنه من مرائي دهرك الرغدِ",31,"د",1,0],["وراق للعين لما راق مورده","ونزّه القلب عن همٍّ وعن كربِ",32,"ب",1,0],["وراق به ورد الهناء وقد جنى","ثمار المنى ميسوره وقد",33,"د",1,0],["وراقَبَها نجمُ الثُّريَّا بِمَطْلَعٍ","كَمَا انْفَرَقَتْ فِي العِذْقِ ناجِمَةُ الطَّلْعِ",34,"ع",1,0],["وراقته الأكلة منجداتٍ","فغار سلوة وشكا الكلالا",35,"ل",2,0],["وراقصات من بنات الزنجِ","تغدو على الرقص وضرب الصنجِ",36,"ج",1,0],["وراقصها ببابِلَ ضوءُ نارٍ","لحيّ من بني أسَدٍ مُبِنِّ",37,"ن",1,0],["وراقَبْتَ صَوْني وهو أشْرَفُ شيمَتي","وما كُلُّ مُحْتاجٍ إلى الجودِ كانِعُ",38,"ع",1,0],["وراقب إله العرش دأبا لتحفظن","طوارق آداب ولا تك لاهيا",39,"ي",2,0],["وراقته الملاح فلم يبيت","رويَّة حازم فيصيب رَايا",40,"ا",3,0],["وراقِبِ اللهَ إذا ما جِئْتَهُ","لَدى السُّؤالِ إذْ عنِ الفِعْلِ سَألْ",41,"ل",1,0],["وراقِصاتٍ على الضِّلعَيْنِ قُلْنَ أَفِقْ","ما شأْنُ مُنْتَدِبٍ يسعَى كمَنْدوبِ",42,"ب",1,0],["وَراقبني كُلُّ الرّجالِ بسالةً","وما فيهمُ مَنْ بتُّ يوماً أُراقبُهْ",43,"ب",2,0],["وراقب الله في الأحوال أجمعها","واحضر لديه به قد فاز من حضرا",44,"ر",2,0],["وراق خمر الوجود منها","ونحن من فوقه حباب",45,"ب",1,0],["وراقبهم لو أنهم لك اسلموا","فما طبعهم إلا الخيانة والغدر",46,"ر",1,0],["وراقَتْكَ على الآرِيْ","ي مَنْفُوجٌ وَمَنْفُوجَهْ",47,"ج",2,0],["وراقصَةٍ على كُرَةٍ وحَبْلٍ","كخطْف البرقِ أو لَمْعِ السّرابِ",48,"ب",1,0],["وراقصةٍ أسبلت لِمّةً","عليها تُؤنّق في قصِّها",49,"ص",3,1],["وَراقبني فَإِني عَبد سُوء","صرفت العُمر في زُور الكَلام",50,"م",1,0],["وَراقبي اللَهَ إِنّي","بادي السقام وَخافِ",51,"ف",1,0],["وراقب يلي منك تولّيت الاحرار","الدهر دوراته ترى باعتيالي",52,"ل",2,0],["وراقهمُ والذي كادَهُمْ","وكل ظلومٍ جهولٍ كفور",53,"ر",1,0],["وراقصات وغلمانٌ قلوبُهمُ","يَرُوضها للهوى واللهوِ إبليسُ",54,"س",1,0],["وَراقَبَ الناسُ تَفاصيلَها","لكِنَّهُ ما إِن وَعاها رَقيبْ",55,"ب",1,0],["وَرَاقَتْ حِيَاضُ الزَّهْرِ سَرْحَ سَحَائِبٍ","لِتَكْرَعَ فِيهَا مِثْلَمَا كَرَعَ البَطُّ",56,"ط",1,0],["وراقب الله في كل الأمور ومن","يراقب الله إجلالا فقد عصما",57,"م",2,0],["ورَاقِبوا اللهَ في مُحِبٍّ","رَقَّتْ لَهُ فيكُمُ العُداةُ",58,"ه",1,0],["وراقِبُوا مِنهُ حالاً غيرَ حائِلَةٍ","كما عَهِدْتُمْ وقَلْباً غَيْرَ مُنْقَلِب",59,"ب",1,0],["وراقم في برود العلم نقش حقي","ق الحق من وارد بالحق يمليه",60,"ي",2,0],["وراق من مبتسم ال","ثغرِ ومن مستعبرِ",61,"ر",1,0],["وَراقِب إِلَهَكَ في حِزبِهِ","فَحِزبُ الإِلَهِ هُمُ الغالِبون",62,"ن",1,0],["وراقت أزاهير الحدائق بالضحا","نواظر عن أحداق نوارها النضر",63,"ر",1,0],["وراقت أزاهير الرياض كأنها","مزايا رشاً عذب اللمى ناحل الخصر",64,"ر",1,0],["وراقبوا الله في هجران مكتئب","في عنفوان الصبا شابت نواصيه",65,"ي",2,0],["وراقَ صوغي القوافي حُليا","كجوهرٍ زانَ نحر العليا",66,"ي",2,0],["وراقبها بأرضك طالعات","كما يهدي صواعقها الغمام",67,"م",1,0],["وراقتْ رباها كلَّ حسنٍ كأنما","تُنَشَّرُ فيما بينهن الدَّرَانك",68,"ك",1,0],["وراق لبهاج المعالى بها","حلياً بها الابهاج غضٌّ نضير",69,"ر",1,0],["وراقبوا الله في ظُلْمي وبَغْيكُمُ","جَوْراً علىَّ ولا تستضعفوا خَبَري",70,"ر",2,0],["وراقصة هاجت بنا حركاتها","لواعج نفس ما لهن سكون",71,"ن",1,1],["وَرَاقت نغمة الوُرْقِ","وَشَاقَتْ حَنَّة النِّيبِ",72,"ب",1,0],["وراقب جناب الحق من غير أن ترى","لنفسك فعلا من فعال جميلة",73,"ه",1,0],["وراقم الخال حين أهوى","وصير المسك فمه حبره",74,"ر",2,0],["وراقصة ليست تحرك دون أن","يحركها سيف من الماء مصلت",75,"ت",1,1],["وراق لنا كأس المسرة صافيا","وأبدت رياض الأنس من حسنها زهرا",76,"ر",2,0],["وراقت سماء البشر في حسنها وقد","تجلت على آفاقها الأنجم الزهر",77,"ر",1,0],["وراقت كؤوس الأنس واتضح الضحى","بشمس هناء تزدرى طلعة البدر",78,"ر",1,0],["وراق ماء الجدول السلطاني","كم سار من روض إلى بستان",79,"ن",1,0],["وراقب اللّه فيما أنت طالبه","كيما تفوز بخير الورد والصدر",80,"ر",1,0],["وَراق صَفير العَندَليب وَهَمزه","عَلى عذبات الرند إِذ نَزَل القطر",81,"ر",1,0],["وراق الصفا والصفو وانقشعت غما","ئم الغم عنا واعتنقنا التهانيا",82,"ي",2,0],["وراق الزمان وراق المكان","وجاء أوان السرور المجدد",83,"د",1,0],["وَراقب صولة اللَيث","إِذا هَمهم أَو زمجر",84,"ر",1,0],["وراقَ النّهى ما راعَ من قَطْفِ هامِها","وقد أيْنَعَتْ للمجْتَني ثمَراتُها",85,"ت",3,0],["وراقبت غفلة واشٍ وبي","إذا صرت نحوهُم مادرى",86,"ر",2,0],["وَراقت حين رقّت لي","بما رَقرقتَ راووقا",87,"ق",2,0],["وَراقني منظرٌ للدهر بعد نَوىً","وَشاقَني بَعدَ نُسكي الأُنسُ للغيد",88,"د",1,0],["وَراقبَ مَن أَهوى مِنَ الدَهر فُرصةً","فَواصلني مِن بَعد هَجرٍ وَمنعة",89,"ه",1,0],["وراقبوا العداد تحصوا به","كم فاض من شؤم وكم ساحا",90,"ح",2,0],["وراقبوا الجو ولا تتقوا","غوصًا وراء الغائص السابحِ",91,"ح",1,0],["وَراقِب إِلَهَ العَرشِ وَاعلَم بِأَنَّهُ","يَرى ما خَفي مِن كُلِّ أَمرٍ مُكَتَّمِ",92,"م",1,0],["وراقصت الفتيان مثنى وموحداً","فلم تك خيراً من بنات المقاصف",93,"ف",1,0],["وراقصت أهيف غض الشبيب","ة يمسي ويصبح مستطربا",94,"ب",2,0],["وراقب الحق دواماً فلا","يسطيع أن يخرج عن امره",95,"ر",2,0],["وراقبَ اللَه في نفسٍ وصاحبه","وابنٍ وقومهم تقويم مرتحمِ",96,"م",1,0],["وراق بمدحه نظمي","ورقَّ وجاده السَّبكُ",97,"ك",1,0],["وراقصٍ مثل غصن البان قامتهُ","فجَنَّ بطرس دبسٍ في تغزُّلهِ",98,"ل",2,1],["وَراقَت لنا الصهباءُ من كفّ شادنٍ","كما طابَت الأشعار من طيب أنفاسِ",99,"س",1,0],["وراقصٍ يستحثُّ الكفَّ بالقدم","مستملح الشَّكل والأعطاف والشِّيم",100,"م",1,1],["وراقَ ماؤُكَ يا ثَورا ولا بَرحَت","تميلُ فوقكِ بالأطيارِ أغصانُ",101,"ن",1,0],["وراقصةٍ رَقصُهَا لِلُّحُونِ","عَرُوضٌ تُقيِّدُ أوزانَها",102,"ن",3,0],["وَراقَ الرَوضُ طاووساً بَهِيّاً","تَهُبُّ عَلَيهِ أَنفاسُ الرِياحِ",103,"ح",1,0],["وراقت ليالي الصفو في الدهر واغتدى","به العيش أصفى من فؤاد أخ الودّ",104,"د",1,0],["وراق ل أبراهيم منه حبورُه","بأوبٍ به أضحى العنا عنه نازحا",105,"ح",2,0],["وراق بهِ عيش المحبين بالمنى","ورقت ليالي الصب بالوصل رونقا",106,"ق",2,0],["وَرَاْقَبَنِي الرَّقِيْبُ بِكُلِ قُطْرٍ","وَأَيَّدَهُ الْعَوَاْذِلُº وَالإِمَاْءُ",107,"ا",2,0],["وراقبوا الله في أرض تكادها","ضيم يؤز بها أحداثه الحطما",108,"م",2,0],["وَ رَاقِبِينِي، كَمِرْآةٍ مُحَطَّمَةٍ","مَشَى إِلَيْهَا غُبَارُ اَلرَّيْبِ،وَ انْتَشَرَا",109,"ر",2,0],["وراقبي الله سعيا في أوامره","كما يحب ونأياً عن نواهيه",110,"ي",2,0],["وراقب إلهك في بطشه","وكن واقفاً تحت ميزابه",111,"ب",2,0],["وراق الوصف حرفا بعد حرف","يصوغ اللفظ من حسن كساه",112,"ا",2,0],["وراقبَ عترةَ المختارِ ترنو","إليهِ وخيْمُهمْ بالريحِ تَعرى",113,"ر",2,0],["وراقص النجم لا ترجو لليلته","اذا بلغت بليل فانظر الشهبا",114,"ب",2,0],["وراقت مساقيها وطابت ثمارها","فما العيش غلا صحة وتنعم",115,"م",1,0],["وراقب الله عند الختم واشك له","هواء نفس وقطاع عن الله",116,"ل",2,0],["وراقص تفضح الأقمار طلعته","مرقرق الوجنات العندميات",117,"ت",1,0],["وراقصوا فِتَنَ الأيام فانفتحتْ","لهُمْ مدائنُ مَنْ قَدْ بجّلُوا هُبَلا",118,"ل",2,0],["وراقصتُ المشاعِرَ في جُنونٍ","لأسدِلَ عَنْ خفايَاها الستارا",119,"ر",2,0]]}