{"poems":[[55,"إن كان ذاك الطود خر","https://www.aldiwan.net/poem29890.html","مجزوء الكامل"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133764","الخفيف"],[4796,"االى حيرى","https://www.poetsgate.com/ViewPoem.aspx?id=34821",""],[5184,"قَطَّعْتُ كلَّ اصابعي","https://www.poetsgate.com/ViewPoem.aspx?id=196813",""],[5199,"الموادع","https://www.poetsgate.com/ViewPoem.aspx?id=146781",""],[5324,"خبئ همومك.","https://www.poetsgate.com/ViewPoem.aspx?id=210937",""],[5829,"ربيع الكشافة","https://www.poetsgate.com/ViewPoem.aspx?id=161988",""],[6102,"على !!","https://www.poetsgate.com/ViewPoem.aspx?id=184455",""],[199,"فما بهِ بطنُ وادٍ غبَّ نضحتهِ","https://www.poetsgate.com/ViewPoem.aspx?id=22427",""]],"verses":[["وَاِستَذرَتِ الأَيّامُ مِن","نَفَحاتِهِ ظِلّاً ظَليلا",0,"ل",2,0],["واستذلوا حيال آتن مصر","قبل فجر الأهرام قبل العوادي",1,"د",2,0],["واستذابَ الإنسانُ فتَّاكاً بلا قلب رحيمِ","والخلقُ تَحسَبَهٌمْ سكارى دونما بنت الكرومِ",2,"م",1,0],["وَاسْتَذْأبَ الحُزْنُ حتّى باتَ يَخْنُقُنا","بالنَّوْحِ مُذْ غَصّ في الحُلْقومِ تَغْريْدُ",3,"د",1,0],["واستذكرك واقراك مثل القرائه","واحفظك قبل اكتبك واطربك واسمعك",4,"ك",1,0],["واستذكر الأيام حين تبسمت","واستحضر الزمن الجميل جليسا",5,"س",2,0],["واستذكري حباً من أسسوا وبنوا","من أوقدوا شُعلاً , للحق تهدينا",6,"ن",2,0],["وَاستَذأَبا لَمَّا مَدَدتُ يَدِي","فَتَناهَبَانِي عِندَما اقتَتَلا",7,"ل",2,0],["واسْتَذْفَرُوا بِنَوى ً حَذَّاءَ تَقْذِفُهُمْ","إلى أقاصي نواهمْ ساعة َ انطلقوا",8,"ق",3,0]]}