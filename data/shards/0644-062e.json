{"poems":[[53,"يا دين قلبك من","https://www.aldiwan.net/poem30734.html","المجتث"],[55,"أظلوم لما أن مللت وحلت عن","https://www.aldiwan.net/poem26058.html","الكامل"],[55,"ألا كتبت تنهى وتأمر بالهجر","https://www.aldiwan.net/poem26313.html","الطويل"],[77,"لخير بني نصر صنعت محمد","https://www.aldiwan.net/poem36416.html","الطويل"],[27,"عرفت الدار بعد بلى الخيام","https://www.aldiwan.net/poem5986.html","الوافر"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[51,"صفا لك شرب العيش غير مثرب","https://www.aldiwan.net/poem8338.html","الطويل"],[51,"لخالد زوجة مكرعة","https://www.aldiwan.net/poem63021.html","المنسرح"],[51,"لخالد زوجة يلقمها","https://www.aldiwan.net/poem63991.html","المنسرح"],[51,"لخالد بيت سوء مثل ساكنه","https://www.aldiwan.net/poem65074.html","البسيط"],[29,"لخولة بالدومي رسم كأنه","https://www.aldiwan.net/poem6210.html","الطويل"],[85,"فلوس الشغل ما تأخير","https://www.aldiwan.net/poem7900.html","الكامل"],[56,"ومحجوبة في الخدر عن كل ناظر","https://www.aldiwan.net/poem58468.html","الطويل"],[45,"كفي الملامة أو دومي على العذل","https://www.aldiwan.net/poem65639.html","البسيط"],[28,"إن الذي أعطى الرجال حظوظهم","https://www.aldiwan.net/poem5592.html","الطويل"],[61,"وسألت عنه فقيل مات لما به","https://www.aldiwan.net/poem51761.html","الكامل"],[49,"لخير إمام قام من خير معشر","https://www.aldiwan.net/poem64197.html","الطويل"],[44,"تناء بدؤه ذنب التداني","https://www.aldiwan.net/poem30100.html","الوافر"],[44,"أقرم بكر تباهي أيها الحفض","https://www.aldiwan.net/poem30477.html","البسيط"],[31,"راح صحبي ولم أحي النوارا","https://www.aldiwan.net/poem42529.html","الخفيف"],[33,"لخطاب ليلى بال برثن منكم","https://www.aldiwan.net/poem25993.html","الطويل"],[40,"رد الخليط الجمال فانتقلا","https://www.aldiwan.net/poem42312.html","المنسرح"],[75,"أحبب بتياك القباب قبابا","https://www.aldiwan.net/poem69103.html","الكامل"],[48,"طربت إلى قطربل فأتيتها","https://www.aldiwan.net/poem65293.html","الطويل"],[50,"لخديك من كفيك في كل ليلة","https://www.aldiwan.net/poem63867.html","الطويل"],[50,"أخشاب حقا أن دارك تزعج","https://www.aldiwan.net/poem63985.html","الطويل"],[46,"لخالقنا الحكم القديم وكم فتى","https://www.aldiwan.net/poem23062.html","الطويل"],[1,"لخولة أطلال ببرقة ثهمد","https://www.aldiwan.net/poem20973.html","الطويل"],[1,"لخولة بالأجزاع من إضم طلل","https://www.aldiwan.net/poem34009.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39670","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21117","الوافر"],[100,"مدينة الغد","https://www.poetsgate.com/ViewPoem.aspx?id=24212",""],[50,"نبا بك خلف الظاعنين وساد","https://www.poetsgate.com/ViewPoem.aspx?id=22565",""],[28,"إن الذي أعطى الرجال حظوظهم","https://www.poetsgate.com/ViewPoem.aspx?id=20005",""],[96,"الأمير المجاهد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66474&r=&rc=150",""],[116,"لخرقة خير الوجود الذي","https://www.aldiwan.net/poem42003.html","المتقارب"],[121,"فتى مزق الحب البرح قلبه","https://www.aldiwan.net/poem49299.html","الطويل"],[122,"جف الكرى عكس الدموع معاً دما","https://www.aldiwan.net/poem23824.html","الكامل"],[136,"سعى بالكاس مخضوب البنان","https://www.aldiwan.net/poem48995.html","الوافر"],[144,"ما مرتقاك على من رامه أمم","https://www.aldiwan.net/poem11824.html","البسيط"],[151,"قضى القلب من عهد الشباب ديونه","https://www.aldiwan.net/poem68583.html","الطويل"],[151,"لذكر رسول الله يرتاح من هدى","https://www.aldiwan.net/poem68592.html","الطويل"],[161,"لو كنت تعلم ما بأهل زبيد","https://www.aldiwan.net/poem58886.html","الكامل"],[182,"هل القلب عن ذكرى أميمة ذاهل","https://www.aldiwan.net/poem59086.html","الطويل"],[183,"لخليل نحاس الأسيف مناحة","https://www.aldiwan.net/poem61125.html","الكامل"],[183,"لخليل باسيلا ضريح كرامة","https://www.aldiwan.net/poem61194.html","الكامل"],[187,"هذا المورث قال لي","https://www.aldiwan.net/poem43233.html","مجزوء الكامل"],[205,"ألا يا من إذا ولوه جارا","https://www.aldiwan.net/poem53266.html","الوافر"],[205,"كتابك كان فاتحة السرور","https://www.aldiwan.net/poem53311.html","الوافر"],[205,"أخي لا تؤاخذني وإن كان لي","https://www.aldiwan.net/poem53356.html","الطويل"],[236,"ختان جرى بالنجح واليمن طائره","https://www.aldiwan.net/poem32012.html","الطويل"],[238,"أبت جمرة من شوق حمزة تفتر","https://www.aldiwan.net/poem18794.html","الطويل"],[262,"صب بلا لوعة ولا كمد","https://www.aldiwan.net/poem38340.html","المنسرح"],[276,"لرأيك كانت الأزمان تصغي","https://www.aldiwan.net/poem25481.html","الوافر"],[311,"هل غير بابك للغريب مؤمل","https://www.aldiwan.net/poem59512.html","الكامل"],[327,"بايع هارون إمام الهدى","https://www.aldiwan.net/poem44253.html","السريع"],[365,"لما تراءت راية الربيع","https://www.aldiwan.net/poem60555.html","الرجز"],[365,"خيال زائر مني خيالا","https://www.aldiwan.net/poem60676.html","الوافر"],[365,"لما تراءت راية الربيع","https://www.aldiwan.net/poem60851.html","الرجز"],[372,"كتبت والنائبات أذن","https://www.aldiwan.net/poem57078.html","مخلع البسيط"],[394,"يا زائرا قد قصد المشاهدا","https://www.aldiwan.net/poem53586.html","الرجز"],[403,"لخالقنا سبحانه الحل والعقد","https://www.aldiwan.net/poem46991.html","الطويل"],[410,"لخمس عشرة نازلت الكماة إلى","https://www.aldiwan.net/poem32186.html","البسيط"],[417,"هذه يا صاح أوقات الهنا","https://www.aldiwan.net/poem54091.html","الرمل"],[440,"يا صفوة الأجفان من عبراتها","https://www.aldiwan.net/poem34761.html","الطويل"],[440,"خلا الدهر من خطب يضيق له ذرعي","https://www.aldiwan.net/poem34853.html","الطويل"],[459,"نقيل مع الدنيا وقد أورقت لنا","https://www.aldiwan.net/poem55852.html","الطويل"],[459,"عذيرك من حلمك المهتضم","https://www.aldiwan.net/poem55892.html","المتقارب"],[465,"جد بقلبي وهزل","https://www.aldiwan.net/poem3313.html","عموديه"],[465,"ما لطيف زار منكم موهنا","https://www.aldiwan.net/poem3343.html","عموديه"],[494,"كم منة للظلام في عنقي","https://www.aldiwan.net/poem67351.html","المنسرح"],[543,"لخير إمام قام من خير عنصر","https://www.aldiwan.net/poem34032.html","الطويل"],[552,"يا يوم أي شجى بمثلك ذاقه","https://www.aldiwan.net/poem47153.html","الكامل"],[563,"لخليل نعمان على ولد له","https://www.aldiwan.net/poem52688.html","الكامل"],[569,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["لَخاضَ فيها سِنانٌ","ماضٍ وَطَبَّقَ عَضبُ",0,"ب",1,0],["لَخَزَنتُ وُدَّكِ في الفُؤادِ وَلَم أَزَل","لَكِ حافِظاً وَمَنَحتُكِ الهِجرانا",1,"ن",2,0],["لَخالٌ بِذاكَ الخَدِّ أَحسَنُ عِندَنا","مِنَ النُكتَةِ السَوداءِ في وَضَحِ البَدرِ",2,"ر",1,0],["لخَيْرِ بَني نصْرٍ صُنِعْتُ محمّدٍ","فيُهْديك معنى العِزِّ ما بيَ والنّصْرِ",3,"ر",1,1],["لَخافوا أَن تَلومَهُمُ قُرَيشٌ","فَرَدّوا الخَيلَ دامِيَةَ الكِلامِ",4,"م",1,0],["لخَير أبُوَّة عُلمَت فَعَالاً","وسابقَةً وخَيرهُم بَنينا",5,"ن",2,0],["لَخُطَّةُ فَصلٍ من سديدٍ قضاؤُهُ","وخُطَّةُ فضلٍ من كريمِ المُرَكَّبِ",6,"ب",1,0],["لخالدٍ زوجةٌ مكرَّعةٌ","تكريعُها في البلاد مشهورُ",7,"ر",1,1],["لخالدٍ زوجة يُلقِّمها","بكفه من أطايب الكَمرِ",8,"ر",1,1],["لخالد بيت سوء مثل ساكنه","بلعنة الله محفوف الترابيع",9,"ع",1,1],["لِخَولَةَ بِالدومِيِّ رَسمٌ كَأَنَّهُ","عَنِ الحَولِ صُحفٌ عادَ فيهِنَّ كاتِبُ",10,"ب",1,1],["لخصتها لأميرتي وأتيت أع","رضها على الأعتاب مختصرات",11,"ت",1,0],["لَخَالٌ بذاتِ الخالِ أَحْسَنُ مَنْظَراً","مِنَ النُّقْطَةِ السّوْداءِ في وَضحِ البَدْرِ",12,"ر",1,0],["لِخالِدِ بنِ يَزيدٍ بِكرُ مَكرُمَةٍ","لَو رامَ هادِيَهُ العَيّوقَ لَم يَنَلِ",13,"ل",1,0],["لِخِندِفَ قَبلَ الناسِ بَيتانِ فيهِما","عَديدُ الحَصى وَالمَأثُراتِ العَظائِمِ",14,"م",1,0],["لخِطابِه لجوابِه لِصوابِه","لِحفاظِه لِثوابِه لِعقابِه",15,"ب",2,0],["لِخَيرِ إِمامٍ قامَ مِن خَيرِ مَعشَرٍ","وَأَكرَمِ بَسّامٍ عَلى عودِ مِنبَرِ",16,"ر",1,1],["لِخَدَّيهِ دَقائِقُ لَو تَراها","إِذَن لَسَأَلتَ عَنها في المَعاني",17,"ن",2,0],["لِخالِدٍ عِوَضٌ في كُلِّ ناحِيَةٍ","مِنهُ وَلَيسَ لَهُ مِن خالِدٍ عِوَضُ",18,"ض",1,0],["لِخَليلٍ يَهوى هَوانا مُؤاتٍ","كانَ لي عِندَ مِثلِها نَظّارا",19,"ر",2,0],["لَخُطّابُ لَيلى بالَ بُرثُنَ مِنكُمُ","أَذَلُّ وَأَمضى مِن سُلَيكَ المَقانِبِ",20,"ب",1,1],["لَخَرَّ بِالأَرضِ لا تَقُومُ لَهُ","يُسِيلُ مِنها الأَركانَ وَالقُلَلا",21,"ل",2,0],["لخَضَبْت شَيباً في عِذاري كاذباً","ومَحَوْت محْوَ النِّقسِ عنه شبابا",22,"ب",2,0],["لَخَمّارَةٍ دينُ ابنِ عِمرانَ دينُها","مُهَذَّبَةٍ تُكنى بِأُمِّ حُصَينِ",23,"ن",1,0],["لِخَدَّيكَ مِن كَفيَّكَ في كُلِّ لَيلَةٍ","إِلى أَن تَرى وَجهَ الصَباحِ وِسادُ",24,"د",1,1],["لِخُشّابَةَ السُلوانُ وَالعِطرُ وَالجَنا","وَلي حُرَقٌ تَحتَ الهَوى تَتَوَهَّجُ",25,"ج",1,0],["لِخالِقِنا الحُكمُ القَديمُ وَكَم فَتىً","لَهُ خُلُقٌ رَحبٌ وَعيشَتُهُ ضَنكُ",26,"ك",1,1],["لِخَولَةَ أَطلالٌ بِبُرقَةِ ثَهمَدِ","تَلوحُ كَباقي الوَشمِ في ظاهِرِ اليَدِ",27,"د",1,1],["لِخَولَةَ بِالأَجزاعِ مِن إِضَمٍ طَلَل","وَبِالسَفحِ مِن قَوٍّ مُقامٌ وَمُحتَمَل",28,"ل",1,1],["لخلاص دارٍ أو فكاك عَشِيرةٍ","خُضْتَ الحياةَ كثيرةَ الآلامِ",29,"م",1,0],["لخُطبَتِهِ الَّتي غَدَرَت وخانَت","وهُنَّ ذَواتُ غائِلَةٍ لُحينا",30,"ن",2,0],["لخطاه عبير (نيسان) أوأش","ذى لتحديقه، أجد إناره",31,"ر",2,0],["لخدك من كفيك في كل ليلة","ٍ إِلى أَنْ تَرَى وَجْهَ الصَّبَاحِ وِسَادُ",32,"د",1,0],["لخِنْدِفَ قَبْلَ النّاسِ بَيتانِ فيهِما","عَديدُ الحَصَى والمَأثُرًّتِ العَظائِمِ",33,"م",1,0],["لخلاص دار وفكاك عشيرة","خضت الحياة كثيرة الآلام",34,"م",1,0],["لخرقة خير الوجود الذي","تشبث في ذيله الأنبيا",35,"ي",2,1],["لخلفتني عاري الجمال من التي","تزين وكم أمسى وأصبح كاسيا",36,"ي",2,0],["لخصاله ووصاله وفصاله","محمودة أيامه للمنأما",37,"م",2,0],["لخطَّ ابن الحسين أبا خضير","جمعت وحسن نظم الأرّجاني",38,"ن",2,0],["لِخَيلِ فُرسانِهِ مِن طَعنِ ما لَقِيَت","بَراقِعٌ وَلَهُم مِن نَقعِها لُثُمُ",39,"م",1,0],["لَخَيرُ الوَرى مَن كانَ أَو هوَ كائِنُ","وَأَفضَلُ مَذخورٍ لَهُ الحُبُّ وَالوَصلُ",40,"ل",1,0],["لِخَولَةَ أَطلالٌ بِبُرقَةِ ثَهمَدِ","صَرَفتُ إِلى مَدحِ النَبيِّ مُحَمَّدِ",41,"د",1,0],["لخصصتها دون المدائن كلها","وخصصت أهليها بكل مزيد",42,"د",1,0],["لَخَذَّلَ إِخوَانى إِذا ما رَأَيتُهُ","عَلَىَّ مَعَ القَومِ الَّذِينَ أُقَاتِلُ",43,"ل",1,0],["لخليلِ نحّاسَ الأَسيفَ مَناحةٌ","لسُرى حَنينةَ عِندَ زَهرةِ عُمرِها",44,"ر",3,1],["لخليلِ باسيلا ضَريحُ كَرامةٍ","سُكِبَت عَلَيهِ مَراحِمُ الرّحمانِ",45,"ن",1,1],["لخلافه لنبيّه","والميل عن قرآنه",46,"ن",2,0],["لخلقك نسخة في اللوح كانت","تَخَيَّرَها مُكوِّنُها اختيارا",47,"ر",2,0],["لخلوة مجلسٍ ولأنس وصلٍ","تُضَمُّ به النحورُ إلى النحورِ",48,"ر",1,0],["لخالفتُ توحيدي وعفت أئمتي","وملتُ الى الجِبتِ المضلل والنصبِ",49,"ب",1,0],["لَخَرَّت عَلى الأَرضِ السَماءُ وَزُلزِلَت","رَواسيهِ إِجلالاً وَغَيضَت زَواخِرُه",50,"ر",2,0],["لِخِلِّي ابْنِ عَبْدِ اللهِ مَنْ بِكَمَالِهِ","وَأَوْصَافِهِ بُرْدُ الْمَعَالِي مُحَبَّرُ",51,"ر",1,0],["لخوفه ان يقال ثم فتى","يعيش في دهره بلا رغد",52,"د",1,0],["لخَيْلِ اللَّهِ إذْ أقْبَلْنَ وَلَّى","خَضيبَ الدَّمعِ عَنْ دَمها بصَبْغِ",53,"غ",1,0],["لخصت كتب الأولين لجمعها","وأتيت أولها بما قد أغفلوا",54,"ل",3,0],["لِخَيرِ عَبّاسٍ إِذا حُصِّلوا","وَالمُفضِلِ المَجدِيِّ عَلى العائِلِ",55,"ل",1,0],["لِخَيلِهِ في الصَخرِ نوناتٌ تُخَطُّ","لَهُنَّ آثارُ المَساميرِ تُقَط",56,"ط",1,0],["لخُوزِسْتانَ بُشْرَى أن رأَيْنا","به لرِكابِه العالي احْتِلالا",57,"ل",2,0],["لخيلهِ في الصّخْرِ نوناتٌ تُخَطْ","لَهنَّ آثارُ المَساميرِ نُقَطْ",58,"ط",1,0],["لخَوفهِا أن يَطولَ بَيني","وبَينهَا من نَداك بَينُ",59,"ن",1,0],["لِخَير مَن قَد ضَمَّهُ الصَعيدُ","ذاكَ الحسينُ السَيِّدُ الشَهيدُ",60,"د",1,0],["لخالِقِنا سبحانه الحلُّ والعقدُ","فلا زحلٌ نحسُ ولا المشْتري سعدُ",61,"د",1,1],["لخمسَ عشرةَ نازلتُ الكُماةَ إلى","أن شبتُ فيها وخيرُ الخيلِ ما قَرَحَا",62,"ح",2,1],["لختان النُّجبِ البيضِ الفعال","الميامينِ وما أدراكُمُ",63,"م",1,0],["لخطبٍ رمى فِي آلِ خَطَّابَ سَهْمَهُ","فَفُجِّعَتِ الدُّنيا بأَسْرى سَرَاتِها",64,"ت",3,0],["لخطبٍ أَبوهُ البغيُ والحربُ أُمُّهُ","ودرَّتْ عَلَيْهِ فِتْنَةٌ حافِلُ الضَّرْعِ",65,"ع",1,0],["لخولستُ منك البدرَ ليلةَ تمِّهِ","وجوذبتُ منك الغصنَ ساعةَ يجتنَى",66,"ن",2,0],["لخاضت إليكم بطونَ البطاح","وداست رؤوس الرُّبَى والأَكَمْ",67,"م",1,0],["لخدّهِ عند سجو","د الدمع تعفير القبل",68,"ل",1,0],["لخلعت الطوق واعتضتِ الأسى","ولما عانقتِ منها فننا",69,"ن",2,0],["لَخِلتَ أَن الهَواءَ لاطَفَني","بِالشَمسِ في قِطعَةٍ مِنَ الأُفُقِ",70,"ق",1,0],["لخيرُ إمامٍ قامَ من خير عُنصُرِ","وأفضل راقٍ فوق أعوادِ منبرِ",71,"ر",1,1],["لخَضَبْتُ سيفي من نجيع عدوّهمْ","ومحوتُ من دمهمْ حُجول حصاني",72,"ن",2,0],["لخليل نُعمانٍ على وَلدٍ لهُ","نَوحٌ يكادُ يلينُ منهُ قبرهُ",73,"ه",1,1],["لخوفهم منه وأشخصوه","مستوثقا منه ليقتلوه",74,"ه",1,0],["لخوفه عليه من أعدائه","إلا ثقات مخض أوليائه",74,"ه",1,0]]}