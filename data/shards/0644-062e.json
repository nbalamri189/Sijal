{"poems":[[55,"يا دين قلبك من","https://www.aldiwan.net/poem30734.html","المجتث"],[57,"أظلوم لما أن مللت وحلت عن","https://www.aldiwan.net/poem26058.html","الكامل"],[57,"ألا كتبت تنهى وتأمر بالهجر","https://www.aldiwan.net/poem26313.html","الطويل"],[79,"لخير بني نصر صنعت محمد","https://www.aldiwan.net/poem36416.html","الطويل"],[29,"عرفت الدار بعد بلى الخيام","https://www.aldiwan.net/poem5986.html","الوافر"],[39,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[53,"صفا لك شرب العيش غير مثرب","https://www.aldiwan.net/poem8338.html","الطويل"],[53,"لخالد زوجة مكرعة","https://www.aldiwan.net/poem63021.html","المنسرح"],[53,"لخالد زوجة يلقمها","https://www.aldiwan.net/poem63991.html","المنسرح"],[53,"لخالد بيت سوء مثل ساكنه","https://www.aldiwan.net/poem65074.html","البسيط"],[31,"لخولة بالدومي رسم كأنه","https://www.aldiwan.net/poem6210.html","الطويل"],[87,"فلوس الشغل ما تأخير","https://www.aldiwan.net/poem7900.html","الكامل"],[58,"ومحجوبة في الخدر عن كل ناظر","https://www.aldiwan.net/poem58468.html","الطويل"],[47,"كفي الملامة أو دومي على العذل","https://www.aldiwan.net/poem65639.html","البسيط"],[30,"إن الذي أعطى الرجال حظوظهم","https://www.aldiwan.net/poem5592.html","الطويل"],[63,"وسألت عنه فقيل مات لما به","https://www.aldiwan.net/poem51761.html","الكامل"],[51,"لخير إمام قام من خير معشر","https://www.aldiwan.net/poem64197.html","الطويل"],[46,"تناء بدؤه ذنب التداني","https://www.aldiwan.net/poem30100.html","الوافر"],[46,"أقرم بكر تباهي أيها الحفض","https://www.aldiwan.net/poem30477.html","البسيط"],[33,"راح صحبي ولم أحي النوارا","https://www.aldiwan.net/poem42529.html","الخفيف"],[35,"لخطاب ليلى بال برثن منكم","https://www.aldiwan.net/poem25993.html","الطويل"],[42,"رد الخليط الجمال فانتقلا","https://www.aldiwan.net/poem42312.html","المنسرح"],[77,"أحبب بتياك القباب قبابا","https://www.aldiwan.net/poem69103.html","الكامل"],[50,"طربت إلى قطربل فأتيتها","https://www.aldiwan.net/poem65293.html","الطويل"],[52,"لخديك من كفيك في كل ليلة","https://www.aldiwan.net/poem63867.html","الطويل"],[52,"أخشاب حقا أن دارك تزعج","https://www.aldiwan.net/poem63985.html","الطويل"],[48,"لخالقنا الحكم القديم وكم فتى","https://www.aldiwan.net/poem23062.html","الطويل"],[1,"لخولة أطلال ببرقة ثهمد","https://www.aldiwan.net/poem20973.html","الطويل"],[1,"لخولة بالأجزاع من إضم طلل","https://www.aldiwan.net/poem34009.html","الطويل"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/29340","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39670","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21117","الوافر"],[102,"مدينة الغد","https://www.poetsgate.com/ViewPoem.aspx?id=24212",""],[52,"نبا بك خلف الظاعنين وساد","https://www.poetsgate.com/ViewPoem.aspx?id=22565",""],[30,"إن الذي أعطى الرجال حظوظهم","https://www.poetsgate.com/ViewPoem.aspx?id=20005",""],[98,"الأمير المجاهد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66474&r=&rc=150",""],[118,"لخرقة خير الوجود الذي","https://www.aldiwan.net/poem42003.html","المتقارب"],[123,"فتى مزق الحب البرح قلبه","https://www.aldiwan.net/poem49299.html","الطويل"],[124,"جف الكرى عكس الدموع معاً دما","https://www.aldiwan.net/poem23824.html","الكامل"],[138,"سعى بالكاس مخضوب البنان","https://www.aldiwan.net/poem48995.html","الوافر"],[146,"ما مرتقاك على من رامه أمم","https://www.aldiwan.net/poem11824.html","البسيط"],[153,"قضى القلب من عهد الشباب ديونه","https://www.aldiwan.net/poem68583.html","الطويل"],[153,"لذكر رسول الله يرتاح من هدى","https://www.aldiwan.net/poem68592.html","الطويل"],[163,"لو كنت تعلم ما بأهل زبيد","https://www.aldiwan.net/poem58886.html","الكامل"],[184,"هل القلب عن ذكرى أميمة ذاهل","https://www.aldiwan.net/poem59086.html","الطويل"],[185,"لخليل نحاس الأسيف مناحة","https://www.aldiwan.net/poem61125.html","الكامل"],[185,"لخليل باسيلا ضريح كرامة","https://www.aldiwan.net/poem61194.html","الكامل"],[189,"هذا المورث قال لي","https://www.aldiwan.net/poem43233.html","مجزوء الكامل"],[207,"ألا يا من إذا ولوه جارا","https://www.aldiwan.net/poem53266.html","الوافر"],[207,"كتابك كان فاتحة السرور","https://www.aldiwan.net/poem53311.html","الوافر"],[207,"أخي لا تؤاخذني وإن كان لي","https://www.aldiwan.net/poem53356.html","الطويل"],[238,"ختان جرى بالنجح واليمن طائره","https://www.aldiwan.net/poem32012.html","الطويل"],[240,"أبت جمرة من شوق حمزة تفتر","https://www.aldiwan.net/poem18794.html","الطويل"],[264,"صب بلا لوعة ولا كمد","https://www.aldiwan.net/poem38340.html","المنسرح"],[278,"لرأيك كانت الأزمان تصغي","https://www.aldiwan.net/poem25481.html","الوافر"],[313,"هل غير بابك للغريب مؤمل","https://www.aldiwan.net/poem59512.html","الكامل"],[329,"بايع هارون إمام الهدى","https://www.aldiwan.net/poem44253.html","السريع"],[367,"لما تراءت راية الربيع","https://www.aldiwan.net/poem60555.html","الرجز"],[367,"خيال زائر مني خيالا","https://www.aldiwan.net/poem60676.html","الوافر"],[367,"لما تراءت راية الربيع","https://www.aldiwan.net/poem60851.html","الرجز"],[374,"كتبت والنائبات أذن","https://www.aldiwan.net/poem57078.html","مخلع البسيط"],[396,"يا زائرا قد قصد المشاهدا","https://www.aldiwan.net/poem53586.html","الرجز"],[405,"لخالقنا سبحانه الحل والعقد","https://www.aldiwan.net/poem46991.html","الطويل"],[412,"لخمس عشرة نازلت الكماة إلى","https://www.aldiwan.net/poem32186.html","البسيط"],[419,"هذه يا صاح أوقات الهنا","https://www.aldiwan.net/poem54091.html","الرمل"],[442,"يا صفوة الأجفان من عبراتها","https://www.aldiwan.net/poem34761.html","الطويل"],[442,"خلا الدهر من خطب يضيق له ذرعي","https://www.aldiwan.net/poem34853.html","الطويل"],[460,"نقيل مع الدنيا وقد أورقت لنا","https://www.aldiwan.net/poem55852.html","الطويل"],[460,"عذيرك من حلمك المهتضم","https://www.aldiwan.net/poem55892.html","المتقارب"],[466,"جد بقلبي وهزل","https://www.aldiwan.net/poem3313.html","عموديه"],[466,"ما لطيف زار منكم موهنا","https://www.aldiwan.net/poem3343.html","عموديه"],[495,"كم منة للظلام في عنقي","https://www.aldiwan.net/poem67351.html","المنسرح"],[544,"لخير إمام قام من خير عنصر","https://www.aldiwan.net/poem34032.html","الطويل"],[553,"يا يوم أي شجى بمثلك ذاقه","https://www.aldiwan.net/poem47153.html","الكامل"],[564,"لخليل نعمان على ولد له","https://www.aldiwan.net/poem52688.html","الكامل"],[570,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/29471","الوافر"],[853,"هدمت الحياض فلم يغادر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=510748",""]],"verses":[["لَخاضَ فيها سِنانٌ","ماضٍ وَطَبَّقَ عَضبُ",0,"ب",1,0],["لَخَزَنتُ وُدَّكِ في الفُؤادِ وَلَم أَزَل","لَكِ حافِظاً وَمَنَحتُكِ الهِجرانا",1,"ن",2,0],["لَخالٌ بِذاكَ الخَدِّ أَحسَنُ عِندَنا","مِنَ النُكتَةِ السَوداءِ في وَضَحِ البَدرِ",2,"ر",1,0],["لخَيْرِ بَني نصْرٍ صُنِعْتُ محمّدٍ","فيُهْديك معنى العِزِّ ما بيَ والنّصْرِ",3,"ر",1,1],["لَخافوا أَن تَلومَهُمُ قُرَيشٌ","فَرَدّوا الخَيلَ دامِيَةَ الكِلامِ",4,"م",1,0],["لخَير أبُوَّة عُلمَت فَعَالاً","وسابقَةً وخَيرهُم بَنينا",5,"ن",2,0],["لَخُطَّةُ فَصلٍ من سديدٍ قضاؤُهُ","وخُطَّةُ فضلٍ من كريمِ المُرَكَّبِ",6,"ب",1,0],["لخالدٍ زوجةٌ مكرَّعةٌ","تكريعُها في البلاد مشهورُ",7,"ر",1,1],["لخالدٍ زوجة يُلقِّمها","بكفه من أطايب الكَمرِ",8,"ر",1,1],["لخالد بيت سوء مثل ساكنه","بلعنة الله محفوف الترابيع",9,"ع",1,1],["لِخَولَةَ بِالدومِيِّ رَسمٌ كَأَنَّهُ","عَنِ الحَولِ صُحفٌ عادَ فيهِنَّ كاتِبُ",10,"ب",1,1],["لخصتها لأميرتي وأتيت أع","رضها على الأعتاب مختصرات",11,"ت",1,0],["لَخَالٌ بذاتِ الخالِ أَحْسَنُ مَنْظَراً","مِنَ النُّقْطَةِ السّوْداءِ في وَضحِ البَدْرِ",12,"ر",1,0],["لِخالِدِ بنِ يَزيدٍ بِكرُ مَكرُمَةٍ","لَو رامَ هادِيَهُ العَيّوقَ لَم يَنَلِ",13,"ل",1,0],["لِخِندِفَ قَبلَ الناسِ بَيتانِ فيهِما","عَديدُ الحَصى وَالمَأثُراتِ العَظائِمِ",14,"م",1,0],["لخِطابِه لجوابِه لِصوابِه","لِحفاظِه لِثوابِه لِعقابِه",15,"ب",2,0],["لِخَيرِ إِمامٍ قامَ مِن خَيرِ مَعشَرٍ","وَأَكرَمِ بَسّامٍ عَلى عودِ مِنبَرِ",16,"ر",1,1],["لِخَدَّيهِ دَقائِقُ لَو تَراها","إِذَن لَسَأَلتَ عَنها في المَعاني",17,"ن",2,0],["لِخالِدٍ عِوَضٌ في كُلِّ ناحِيَةٍ","مِنهُ وَلَيسَ لَهُ مِن خالِدٍ عِوَضُ",18,"ض",1,0],["لِخَليلٍ يَهوى هَوانا مُؤاتٍ","كانَ لي عِندَ مِثلِها نَظّارا",19,"ر",2,0],["لَخُطّابُ لَيلى بالَ بُرثُنَ مِنكُمُ","أَذَلُّ وَأَمضى مِن سُلَيكَ المَقانِبِ",20,"ب",1,1],["لَخَرَّ بِالأَرضِ لا تَقُومُ لَهُ","يُسِيلُ مِنها الأَركانَ وَالقُلَلا",21,"ل",2,0],["لخَضَبْت شَيباً في عِذاري كاذباً","ومَحَوْت محْوَ النِّقسِ عنه شبابا",22,"ب",2,0],["لَخَمّارَةٍ دينُ ابنِ عِمرانَ دينُها","مُهَذَّبَةٍ تُكنى بِأُمِّ حُصَينِ",23,"ن",1,0],["لِخَدَّيكَ مِن كَفيَّكَ في كُلِّ لَيلَةٍ","إِلى أَن تَرى وَجهَ الصَباحِ وِسادُ",24,"د",1,1],["لِخُشّابَةَ السُلوانُ وَالعِطرُ وَالجَنا","وَلي حُرَقٌ تَحتَ الهَوى تَتَوَهَّجُ",25,"ج",1,0],["لِخالِقِنا الحُكمُ القَديمُ وَكَم فَتىً","لَهُ خُلُقٌ رَحبٌ وَعيشَتُهُ ضَنكُ",26,"ك",1,1],["لِخَولَةَ أَطلالٌ بِبُرقَةِ ثَهمَدِ","تَلوحُ كَباقي الوَشمِ في ظاهِرِ اليَدِ",27,"د",1,1],["لِخَولَةَ بِالأَجزاعِ مِن إِضَمٍ طَلَل","وَبِالسَفحِ مِن قَوٍّ مُقامٌ وَمُحتَمَل",28,"ل",1,1],["لخلّين بيني راغمات وبينها","وروقي بأطراف الغضا يتمرس",29,"س",1,0],["لخلاص دارٍ أو فكاك عَشِيرةٍ","خُضْتَ الحياةَ كثيرةَ الآلامِ",30,"م",1,0],["لخُطبَتِهِ الَّتي غَدَرَت وخانَت","وهُنَّ ذَواتُ غائِلَةٍ لُحينا",31,"ن",2,0],["لخطاه عبير (نيسان) أوأش","ذى لتحديقه، أجد إناره",32,"ر",2,0],["لخدك من كفيك في كل ليلة","ٍ إِلى أَنْ تَرَى وَجْهَ الصَّبَاحِ وِسَادُ",33,"د",1,0],["لخِنْدِفَ قَبْلَ النّاسِ بَيتانِ فيهِما","عَديدُ الحَصَى والمَأثُرًّتِ العَظائِمِ",34,"م",1,0],["لخلاص دار وفكاك عشيرة","خضت الحياة كثيرة الآلام",35,"م",1,0],["لخرقة خير الوجود الذي","تشبث في ذيله الأنبيا",36,"ي",2,1],["لخلفتني عاري الجمال من التي","تزين وكم أمسى وأصبح كاسيا",37,"ي",2,0],["لخصاله ووصاله وفصاله","محمودة أيامه للمنأما",38,"م",2,0],["لخطَّ ابن الحسين أبا خضير","جمعت وحسن نظم الأرّجاني",39,"ن",2,0],["لِخَيلِ فُرسانِهِ مِن طَعنِ ما لَقِيَت","بَراقِعٌ وَلَهُم مِن نَقعِها لُثُمُ",40,"م",1,0],["لَخَيرُ الوَرى مَن كانَ أَو هوَ كائِنُ","وَأَفضَلُ مَذخورٍ لَهُ الحُبُّ وَالوَصلُ",41,"ل",1,0],["لِخَولَةَ أَطلالٌ بِبُرقَةِ ثَهمَدِ","صَرَفتُ إِلى مَدحِ النَبيِّ مُحَمَّدِ",42,"د",1,0],["لخصصتها دون المدائن كلها","وخصصت أهليها بكل مزيد",43,"د",1,0],["لَخَذَّلَ إِخوَانى إِذا ما رَأَيتُهُ","عَلَىَّ مَعَ القَومِ الَّذِينَ أُقَاتِلُ",44,"ل",1,0],["لخليلِ نحّاسَ الأَسيفَ مَناحةٌ","لسُرى حَنينةَ عِندَ زَهرةِ عُمرِها",45,"ر",3,1],["لخليلِ باسيلا ضَريحُ كَرامةٍ","سُكِبَت عَلَيهِ مَراحِمُ الرّحمانِ",46,"ن",1,1],["لخلافه لنبيّه","والميل عن قرآنه",47,"ن",2,0],["لخلقك نسخة في اللوح كانت","تَخَيَّرَها مُكوِّنُها اختيارا",48,"ر",2,0],["لخلوة مجلسٍ ولأنس وصلٍ","تُضَمُّ به النحورُ إلى النحورِ",49,"ر",1,0],["لخالفتُ توحيدي وعفت أئمتي","وملتُ الى الجِبتِ المضلل والنصبِ",50,"ب",1,0],["لَخَرَّت عَلى الأَرضِ السَماءُ وَزُلزِلَت","رَواسيهِ إِجلالاً وَغَيضَت زَواخِرُه",51,"ر",2,0],["لِخِلِّي ابْنِ عَبْدِ اللهِ مَنْ بِكَمَالِهِ","وَأَوْصَافِهِ بُرْدُ الْمَعَالِي مُحَبَّرُ",52,"ر",1,0],["لخوفه ان يقال ثم فتى","يعيش في دهره بلا رغد",53,"د",1,0],["لخَيْلِ اللَّهِ إذْ أقْبَلْنَ وَلَّى","خَضيبَ الدَّمعِ عَنْ دَمها بصَبْغِ",54,"غ",1,0],["لخصت كتب الأولين لجمعها","وأتيت أولها بما قد أغفلوا",55,"ل",3,0],["لِخَيرِ عَبّاسٍ إِذا حُصِّلوا","وَالمُفضِلِ المَجدِيِّ عَلى العائِلِ",56,"ل",1,0],["لِخَيلِهِ في الصَخرِ نوناتٌ تُخَطُّ","لَهُنَّ آثارُ المَساميرِ تُقَط",57,"ط",1,0],["لخُوزِسْتانَ بُشْرَى أن رأَيْنا","به لرِكابِه العالي احْتِلالا",58,"ل",2,0],["لخيلهِ في الصّخْرِ نوناتٌ تُخَطْ","لَهنَّ آثارُ المَساميرِ نُقَطْ",59,"ط",1,0],["لخَوفهِا أن يَطولَ بَيني","وبَينهَا من نَداك بَينُ",60,"ن",1,0],["لِخَير مَن قَد ضَمَّهُ الصَعيدُ","ذاكَ الحسينُ السَيِّدُ الشَهيدُ",61,"د",1,0],["لخالِقِنا سبحانه الحلُّ والعقدُ","فلا زحلٌ نحسُ ولا المشْتري سعدُ",62,"د",1,1],["لخمسَ عشرةَ نازلتُ الكُماةَ إلى","أن شبتُ فيها وخيرُ الخيلِ ما قَرَحَا",63,"ح",2,1],["لختان النُّجبِ البيضِ الفعال","الميامينِ وما أدراكُمُ",64,"م",1,0],["لخطبٍ رمى فِي آلِ خَطَّابَ سَهْمَهُ","فَفُجِّعَتِ الدُّنيا بأَسْرى سَرَاتِها",65,"ت",3,0],["لخطبٍ أَبوهُ البغيُ والحربُ أُمُّهُ","ودرَّتْ عَلَيْهِ فِتْنَةٌ حافِلُ الضَّرْعِ",66,"ع",1,0],["لخولستُ منك البدرَ ليلةَ تمِّهِ","وجوذبتُ منك الغصنَ ساعةَ يجتنَى",67,"ن",2,0],["لخاضت إليكم بطونَ البطاح","وداست رؤوس الرُّبَى والأَكَمْ",68,"م",1,0],["لخدّهِ عند سجو","د الدمع تعفير القبل",69,"ل",1,0],["لخلعت الطوق واعتضتِ الأسى","ولما عانقتِ منها فننا",70,"ن",2,0],["لَخِلتَ أَن الهَواءَ لاطَفَني","بِالشَمسِ في قِطعَةٍ مِنَ الأُفُقِ",71,"ق",1,0],["لخيرُ إمامٍ قامَ من خير عُنصُرِ","وأفضل راقٍ فوق أعوادِ منبرِ",72,"ر",1,1],["لخَضَبْتُ سيفي من نجيع عدوّهمْ","ومحوتُ من دمهمْ حُجول حصاني",73,"ن",2,0],["لخليل نُعمانٍ على وَلدٍ لهُ","نَوحٌ يكادُ يلينُ منهُ قبرهُ",74,"ه",1,1],["لخوفهم منه وأشخصوه","مستوثقا منه ليقتلوه",75,"ه",1,0],["لخوفه عليه من أعدائه","إلا ثقات مخض أوليائه",75,"ه",1,0],["لِخَوْلَةَ إذ هُمُ مَغْنَى، وأهْلِي","وَأَهْلُكَ ساكنونَ مَعًا رِثَاءُ",76,"ا",2,0],["لِخَولةَ إِذ هُمُ مَغنىً وَأَهلي","وَأَهلُكِ ساكِنونَ مَعاً رِئاءُ",77,"ا",2,0]]}