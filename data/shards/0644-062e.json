{"poems":[[53,"يا دين قلبك من","https://www.aldiwan.net/poem30734.html","المجتث"],[55,"أظلوم لما أن مللت وحلت عن","https://www.aldiwan.net/poem26058.html","الكامل"],[55,"ألا كتبت تنهى وتأمر بالهجر","https://www.aldiwan.net/poem26313.html","الطويل"],[77,"لخير بني نصر صنعت محمد","https://www.aldiwan.net/poem36416.html","الطويل"],[27,"عرفت الدار بعد بلى الخيام","https://www.aldiwan.net/poem5986.html","الوافر"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[51,"صفا لك شرب العيش غير مثرب","https://www.aldiwan.net/poem8338.html","الطويل"],[51,"لخالد زوجة مكرعة","https://www.aldiwan.net/poem63021.html","المنسرح"],[51,"لخالد زوجة يلقمها","https://www.aldiwan.net/poem63991.html","المنسرح"],[51,"لخالد بيت سوء مثل ساكنه","https://www.aldiwan.net/poem65074.html","البسيط"],[29,"لخولة بالدومي رسم كأنه","https://www.aldiwan.net/poem6210.html","الطويل"],[85,"فلوس الشغل ما تأخير","https://www.aldiwan.net/poem7900.html","الكامل"],[56,"ومحجوبة في الخدر عن كل ناظر","https://www.aldiwan.net/poem58468.html","الطويل"],[45,"كفي الملامة أو دومي على العذل","https://www.aldiwan.net/poem65639.html","البسيط"],[28,"إن الذي أعطى الرجال حظوظهم","https://www.aldiwan.net/poem5592.html","الطويل"],[61,"وسألت عنه فقيل مات لما به","https://www.aldiwan.net/poem51761.html","الكامل"],[49,"لخير إمام قام من خير معشر","https://www.aldiwan.net/poem64197.html","الطويل"],[44,"تناء بدؤه ذنب التداني","https://www.aldiwan.net/poem30100.html","الوافر"],[44,"أقرم بكر تباهي أيها الحفض","https://www.aldiwan.net/poem30477.html","البسيط"],[31,"راح صحبي ولم أحي النوارا","https://www.aldiwan.net/poem42529.html","الخفيف"],[33,"لخطاب ليلى بال برثن منكم","https://www.aldiwan.net/poem25993.html","الطويل"],[40,"رد الخليط الجمال فانتقلا","https://www.aldiwan.net/poem42312.html","المنسرح"],[75,"أحبب بتياك القباب قبابا","https://www.aldiwan.net/poem69103.html","الكامل"],[48,"طربت إلى قطربل فأتيتها","https://www.aldiwan.net/poem65293.html","الطويل"],[50,"لخديك من كفيك في كل ليلة","https://www.aldiwan.net/poem63867.html","الطويل"],[50,"أخشاب حقا أن دارك تزعج","https://www.aldiwan.net/poem63985.html","الطويل"],[46,"لخالقنا الحكم القديم وكم فتى","https://www.aldiwan.net/poem23062.html","الطويل"],[1,"لخولة أطلال ببرقة ثهمد","https://www.aldiwan.net/poem20973.html","الطويل"],[1,"لخولة بالأجزاع من إضم طلل","https://www.aldiwan.net/poem34009.html","الطويل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39670","الكامل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21117","الوافر"],[100,"مدينة الغد","https://www.poetsgate.com/ViewPoem.aspx?id=24212",""],[50,"نبا بك خلف الظاعنين وساد","https://www.poetsgate.com/ViewPoem.aspx?id=22565",""],[28,"إن الذي أعطى الرجال حظوظهم","https://www.poetsgate.com/ViewPoem.aspx?id=20005",""]],"verses":[["لَخاضَ فيها سِنانٌ","ماضٍ وَطَبَّقَ عَضبُ",0,"ب",1,0],["لَخَزَنتُ وُدَّكِ في الفُؤادِ وَلَم أَزَل","لَكِ حافِظاً وَمَنَحتُكِ الهِجرانا",1,"ن",2,0],["لَخالٌ بِذاكَ الخَدِّ أَحسَنُ عِندَنا","مِنَ النُكتَةِ السَوداءِ في وَضَحِ البَدرِ",2,"ر",1,0],["لخَيْرِ بَني نصْرٍ صُنِعْتُ محمّدٍ","فيُهْديك معنى العِزِّ ما بيَ والنّصْرِ",3,"ر",1,1],["لَخافوا أَن تَلومَهُمُ قُرَيشٌ","فَرَدّوا الخَيلَ دامِيَةَ الكِلامِ",4,"م",1,0],["لخَير أبُوَّة عُلمَت فَعَالاً","وسابقَةً وخَيرهُم بَنينا",5,"ن",2,0],["لَخُطَّةُ فَصلٍ من سديدٍ قضاؤُهُ","وخُطَّةُ فضلٍ من كريمِ المُرَكَّبِ",6,"ب",1,0],["لخالدٍ زوجةٌ مكرَّعةٌ","تكريعُها في البلاد مشهورُ",7,"ر",1,1],["لخالدٍ زوجة يُلقِّمها","بكفه من أطايب الكَمرِ",8,"ر",1,1],["لخالد بيت سوء مثل ساكنه","بلعنة الله محفوف الترابيع",9,"ع",1,1],["لِخَولَةَ بِالدومِيِّ رَسمٌ كَأَنَّهُ","عَنِ الحَولِ صُحفٌ عادَ فيهِنَّ كاتِبُ",10,"ب",1,1],["لخصتها لأميرتي وأتيت أع","رضها على الأعتاب مختصرات",11,"ت",1,0],["لَخَالٌ بذاتِ الخالِ أَحْسَنُ مَنْظَراً","مِنَ النُّقْطَةِ السّوْداءِ في وَضحِ البَدْرِ",12,"ر",1,0],["لِخالِدِ بنِ يَزيدٍ بِكرُ مَكرُمَةٍ","لَو رامَ هادِيَهُ العَيّوقَ لَم يَنَلِ",13,"ل",1,0],["لِخِندِفَ قَبلَ الناسِ بَيتانِ فيهِما","عَديدُ الحَصى وَالمَأثُراتِ العَظائِمِ",14,"م",1,0],["لخِطابِه لجوابِه لِصوابِه","لِحفاظِه لِثوابِه لِعقابِه",15,"ب",2,0],["لِخَيرِ إِمامٍ قامَ مِن خَيرِ مَعشَرٍ","وَأَكرَمِ بَسّامٍ عَلى عودِ مِنبَرِ",16,"ر",1,1],["لِخَدَّيهِ دَقائِقُ لَو تَراها","إِذَن لَسَأَلتَ عَنها في المَعاني",17,"ن",2,0],["لِخالِدٍ عِوَضٌ في كُلِّ ناحِيَةٍ","مِنهُ وَلَيسَ لَهُ مِن خالِدٍ عِوَضُ",18,"ض",1,0],["لِخَليلٍ يَهوى هَوانا مُؤاتٍ","كانَ لي عِندَ مِثلِها نَظّارا",19,"ر",2,0],["لَخُطّابُ لَيلى بالَ بُرثُنَ مِنكُمُ","أَذَلُّ وَأَمضى مِن سُلَيكَ المَقانِبِ",20,"ب",1,1],["لَخَرَّ بِالأَرضِ لا تَقُومُ لَهُ","يُسِيلُ مِنها الأَركانَ وَالقُلَلا",21,"ل",2,0],["لخَضَبْت شَيباً في عِذاري كاذباً","ومَحَوْت محْوَ النِّقسِ عنه شبابا",22,"ب",2,0],["لَخَمّارَةٍ دينُ ابنِ عِمرانَ دينُها","مُهَذَّبَةٍ تُكنى بِأُمِّ حُصَينِ",23,"ن",1,0],["لِخَدَّيكَ مِن كَفيَّكَ في كُلِّ لَيلَةٍ","إِلى أَن تَرى وَجهَ الصَباحِ وِسادُ",24,"د",1,1],["لِخُشّابَةَ السُلوانُ وَالعِطرُ وَالجَنا","وَلي حُرَقٌ تَحتَ الهَوى تَتَوَهَّجُ",25,"ج",1,0],["لِخالِقِنا الحُكمُ القَديمُ وَكَم فَتىً","لَهُ خُلُقٌ رَحبٌ وَعيشَتُهُ ضَنكُ",26,"ك",1,1],["لِخَولَةَ أَطلالٌ بِبُرقَةِ ثَهمَدِ","تَلوحُ كَباقي الوَشمِ في ظاهِرِ اليَدِ",27,"د",1,1],["لِخَولَةَ بِالأَجزاعِ مِن إِضَمٍ طَلَل","وَبِالسَفحِ مِن قَوٍّ مُقامٌ وَمُحتَمَل",28,"ل",1,1],["لخلاص دارٍ أو فكاك عَشِيرةٍ","خُضْتَ الحياةَ كثيرةَ الآلامِ",29,"م",1,0],["لخُطبَتِهِ الَّتي غَدَرَت وخانَت","وهُنَّ ذَواتُ غائِلَةٍ لُحينا",30,"ن",2,0],["لخطاه عبير (نيسان) أوأش","ذى لتحديقه، أجد إناره",31,"ر",2,0],["لخدك من كفيك في كل ليلة","ٍ إِلى أَنْ تَرَى وَجْهَ الصَّبَاحِ وِسَادُ",32,"د",1,0],["لخِنْدِفَ قَبْلَ النّاسِ بَيتانِ فيهِما","عَديدُ الحَصَى والمَأثُرًّتِ العَظائِمِ",33,"م",1,0]]}