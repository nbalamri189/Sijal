الحياض فلم يغادر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=510748",""],[463,"عذيرك من حلمك المهتضمْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60306&r=&rc=362",""],[6289,"دِمّشْقْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81753&r=&rc=5",""]],"verses":[["لَخاضَ فيها سِنانٌ","ماضٍ وَطَبَّقَ عَضبُ",0,"ب",1,0],["لَخَزَنتُ وُدَّكِ في الفُؤادِ وَلَم أَزَل","لَكِ حافِظاً وَمَنَحتُكِ الهِجرانا",1,"ن",2,0],["لَخالٌ بِذاكَ الخَدِّ أَحسَنُ عِندَنا","مِنَ النُكتَةِ السَوداءِ في وَضَحِ البَدرِ",2,"ر",1,0],["لخَيْرِ بَني نصْرٍ صُنِعْتُ محمّدٍ","فيُهْديك معنى العِزِّ ما بيَ والنّصْرِ",3,"ر",1,1],["لَخافوا أَن تَلومَهُمُ قُرَيشٌ","فَرَدّوا الخَيلَ دامِيَةَ الكِلامِ",4,"م",1,0],["لخَير أبُوَّة عُلمَت فَعَالاً","وسابقَةً وخَيرهُم بَنينا",5,"ن",2,0],["لَخُطَّةُ فَصلٍ من سديدٍ قضاؤُهُ","وخُطَّةُ فضلٍ من كريمِ المُرَكَّبِ",6,"ب",1,0],["لخالدٍ زوجةٌ مكرَّعةٌ","تكريعُها في البلاد مشهورُ",7,"ر",1,1],["لخالدٍ زوجة يُلقِّمها","بكفه من أطايب الكَمرِ",8,"ر",1,1],["لخالد بيت سوء مثل ساكنه","بلعنة الله محفوف الترابيع",9,"ع",1,1],["لِخَولَةَ بِالدومِيِّ رَسمٌ كَأَنَّهُ","عَنِ الحَولِ صُحفٌ عادَ فيهِنَّ كاتِبُ",10,"ب",1,1],["لخصتها لأميرتي وأتيت أع","رضها على الأعتاب مختصرات",11,"ت",1,0],["لَخَالٌ بذاتِ الخالِ أَحْسَنُ مَنْظَراً","مِنَ النُّقْطَةِ السّوْداءِ في وَضحِ البَدْرِ",12,"ر",1,0],["لِخالِدِ بنِ يَزيدٍ بِكرُ مَكرُمَةٍ","لَو رامَ هادِيَهُ العَيّوقَ لَم يَنَلِ",13,"ل",1,0],["لِخِندِفَ قَبلَ الناسِ بَيتانِ فيهِما","عَديدُ الحَصى وَالمَأثُراتِ العَظائِمِ",14,"م",1,0],["لخِطابِه لجوابِه لِصوابِه","لِحفاظِه لِثوابِه لِعقابِه",15,"ب",2,0],["لِخَيرِ إِمامٍ قامَ مِن خَيرِ مَعشَرٍ","وَأَكرَمِ بَسّامٍ عَلى عودِ مِنبَرِ",16,"ر",1,1],["لِخَدَّيهِ دَقائِقُ لَو تَراها","إِذَن لَسَأَلتَ عَنها في المَعاني",17,"ن",2,0],["لِخالِدٍ عِوَضٌ في كُلِّ ناحِيَةٍ","مِنهُ وَلَيسَ لَهُ مِن خالِدٍ عِوَضُ",18,"ض",1,0],["لِخَليلٍ يَهوى هَوانا مُؤاتٍ","كانَ لي عِندَ مِثلِها نَظّارا",19,"ر",2,0],["لَخُطّابُ لَيلى بالَ بُرثُنَ مِنكُمُ","أَذَلُّ وَأَمضى مِن سُلَيكَ المَقانِبِ",20,"ب",1,1],["لَخَرَّ بِالأَرضِ لا تَقُومُ لَهُ","يُسِيلُ مِنها الأَركانَ وَالقُلَلا",21,"ل",2,0],["لخَضَبْت شَيباً في عِذاري كاذباً","ومَحَوْت محْوَ النِّقسِ عنه شبابا",22,"ب",2,0],["لَخَمّارَةٍ دينُ ابنِ عِمرانَ دينُها","مُهَذَّبَةٍ تُكنى بِأُمِّ حُصَينِ",23,"ن",1,0],["لِخَدَّيكَ مِن كَفيَّكَ في كُلِّ لَيلَةٍ","إِلى أَن تَرى وَجهَ الصَباحِ وِسادُ",24,"د",1,1],["لِخُشّابَةَ السُلوانُ وَالعِطرُ وَالجَنا","وَلي حُرَقٌ تَحتَ الهَوى تَتَوَهَّجُ",25,"ج",1,0],["لِخالِقِنا الحُكمُ القَديمُ وَكَم فَتىً","لَهُ خُلُقٌ رَحبٌ وَعيشَتُهُ ضَنكُ",26,"ك",1,1],["لِخَولَةَ أَطلالٌ بِبُرقَةِ ثَهمَدِ","تَلوحُ كَباقي الوَشمِ في ظاهِرِ اليَدِ",27,"د",1,1],["لِخَولَةَ بِالأَجزاعِ مِن إِضَمٍ طَلَل","وَبِالسَفحِ مِن قَوٍّ مُقامٌ وَمُحتَمَل",28,"ل",1,1],["لخلّين بيني راغمات وبينها","وروقي بأطراف الغضا يتمرس",29,"س",1,0],["لخلاص دارٍ أو فكاك عَشِيرةٍ","خُضْتَ الحياةَ كثيرةَ الآلامِ",30,"م",1,0],["لخُطبَتِهِ الَّتي غَدَرَت وخانَت","وهُنَّ ذَواتُ غائِلَةٍ لُحينا",31,"ن",2,0],["لخطاه عبير (نيسان) أوأش","ذى لتحديقه، أجد إناره",32,"ر",2,0],["لخدك من كفيك في كل ليلة","ٍ إِلى أَنْ تَرَى وَجْهَ الصَّبَاحِ وِسَادُ",33,"د",1,0],["لخِنْدِفَ قَبْلَ النّاسِ بَيتانِ فيهِما","عَديدُ الحَصَى والمَأثُرًّتِ العَظائِمِ",34,"م",1,0],["لخلاص دار وفكاك عشيرة","خضت الحياة كثيرة الآلام",35,"م",1,0],["لخرقة خير الوجود الذي","تشبث في ذيله الأنبيا",36,"ي",2,1],["لخلفتني عاري الجمال من التي","تزين وكم أمسى وأصبح كاسيا",37,"ي",2,0],["لخصاله ووصاله وفصاله","محمودة أيامه للمنأما",38,"م",2,0],["لخطَّ ابن الحسين أبا خضير","جمعت وحسن نظم الأرّجاني",39,"ن",2,0],["لِخَيلِ فُرسانِهِ مِن طَعنِ ما لَقِيَت","بَراقِعٌ وَلَهُم مِن نَقعِها لُثُمُ",40,"م",1,0],["لَخَيرُ الوَرى مَن كانَ أَو هوَ كائِنُ","وَأَفضَلُ مَذخورٍ لَهُ الحُبُّ وَالوَصلُ",41,"ل",1,0],["لِخَولَةَ أَطلالٌ بِبُرقَةِ ثَهمَدِ","صَرَفتُ إِلى مَدحِ النَبيِّ مُحَمَّدِ",42,"د",1,0],["لخصصتها دون المدائن كلها","وخصصت أهليها بكل مزيد",43,"د",1,0],["لَخَذَّلَ إِخوَانى إِذا ما رَأَيتُهُ","عَلَىَّ مَعَ القَومِ الَّذِينَ أُقَاتِلُ",44,"ل",1,0],["لخليلِ نحّاسَ الأَسيفَ مَناحةٌ","لسُرى حَنينةَ عِندَ زَهرةِ عُمرِها",45,"ر",3,1],["لخليلِ باسيلا ضَريحُ كَرامةٍ","سُكِبَت عَلَيهِ مَراحِمُ الرّحمانِ",46,"ن",1,1],["لخلافه لنبيّه","والميل عن قرآنه",47,"ن",2,0],["لخلقك نسخة في اللوح كانت","تَخَيَّرَها مُكوِّنُها اختيارا",48,"ر",2,0],["لخلوة مجلسٍ ولأنس وصلٍ","تُضَمُّ به النحورُ إلى النحورِ",49,"ر",1,0],["لخالفتُ توحيدي وعفت أئمتي","وملتُ الى الجِبتِ المضلل والنصبِ",50,"ب",1,0],["لَخَرَّت عَلى الأَرضِ السَماءُ وَزُلزِلَت","رَواسيهِ إِجلالاً وَغَيضَت زَواخِرُه",51,"ر",2,0],["لِخِلِّي ابْنِ عَبْدِ اللهِ مَنْ بِكَمَالِهِ","وَأَوْصَافِهِ بُرْدُ الْمَعَالِي مُحَبَّرُ",52,"ر",1,0],["لخوفه ان يقال ثم فتى","يعيش في دهره بلا رغد",53,"د",1,0],["لخَيْلِ اللَّهِ إذْ أقْبَلْنَ وَلَّى","خَضيبَ الدَّمعِ عَنْ دَمها بصَبْغِ",54,"غ",1,0],["لخصت كتب الأولين لجمعها","وأتيت أولها بما قد أغفلوا",55,"ل",3,0],["لِخَيرِ عَبّاسٍ إِذا حُصِّلوا","وَالمُفضِلِ المَجدِيِّ عَلى العائِلِ",56,"ل",1,0],["لِخَيلِهِ في الصَخرِ نوناتٌ تُخَطُّ","لَهُنَّ آثارُ المَساميرِ تُقَط",57,"ط",1,0],["لخُوزِسْتانَ بُشْرَى أن رأَيْنا","به لرِكابِه العالي احْتِلالا",58,"ل",2,0],["لخيلهِ في الصّخْرِ نوناتٌ تُخَطْ","لَهنَّ آثارُ المَساميرِ نُقَطْ",59,"ط",1,0],["لخَوفهِا أن يَطولَ بَيني","وبَينهَا من نَداك بَينُ",60,"ن",1,0],["لِخَير مَن قَد ضَمَّهُ الصَعيدُ","ذاكَ الحسينُ السَيِّدُ الشَهيدُ",61,"د",1,0],["لخالِقِنا سبحانه الحلُّ والعقدُ","فلا زحلٌ نحسُ ولا المشْتري سعدُ",62,"د",1,1],["لخمسَ عشرةَ نازلتُ الكُماةَ إلى","أن شبتُ فيها وخيرُ الخيلِ ما قَرَحَا",63,"ح",2,1],["لختان النُّجبِ البيضِ الفعال","الميامينِ وما أدراكُمُ",64,"م",1,0],["لخطبٍ رمى فِي آلِ خَطَّابَ سَهْمَهُ","فَفُجِّعَتِ الدُّنيا بأَسْرى سَرَاتِها",65,"ت",3,0],["لخطبٍ أَبوهُ البغيُ والحربُ أُمُّهُ","ودرَّتْ عَلَيْهِ فِتْنَةٌ حافِلُ الضَّرْعِ",66,"ع",1,0],["لخولستُ منك البدرَ ليلةَ تمِّهِ","وجوذبتُ منك الغصنَ ساعةَ يجتنَى",67,"ن",2,0],["لخاضت إليكم بطونَ البطاح","وداست رؤوس الرُّبَى والأَكَمْ",68,"م",1,0],["لخدّهِ عند سجو","د الدمع تعفير القبل",69,"ل",1,0],["لخلعت الطوق واعتضتِ الأسى","ولما عانقتِ منها فننا",70,"ن",2,0],["لَخِلتَ أَن الهَواءَ لاطَفَ