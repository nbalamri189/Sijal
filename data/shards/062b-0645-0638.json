{"poems":[[54,"صاح بالوعظ شيب رأس مضي","https://www.aldiwan.net/poem26582.html","الخفيف"],[401,"هل بالمنازل إن كلمتها خرسُ","https://www.aldiwan.net/poem587.html",""],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63895","السريع"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53218","الرمل"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58288","الخفيف"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82812","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83578","الخفيف"],[5691,"ذيول العباءات","https://www.poetsgate.com/ViewPoem.aspx?id=205882",""]],"verses":[["ثُمَّ ظَنّي بِأَنَّ ما يَسعَدُ العا","قِلُ وَالحاسِدُ المُعَنّى الشَقِيُّ",0,"ي",1,0],["ثمَّ ظلِلنا تغنّي القومَ داجِنةٌ","لعساءُ لا ثَعَلٌ فيها ولا كَسَسُ",1,"س",1,0],["ثم ظللنا ليس منَّا فتىً","تُسْعِدُهُ رِجْلٌ ولا راس",2,"س",1,0],["ثم ظنت كل قلب عوذة","فهي كالأحراز في خُرصانها",3,"ه",2,0],["ثمَّ ظفّرهُ بالقلوبِ كما شا","ء وُلوعي بُحبّهِ وَهُيامي",4,"م",2,0],["ثُمَّ ظَنَّت إِمهالُها إِهمالاً","وَبِهذا الشَيطانُ قَد أَغواني",5,"ن",2,0],["ثُمَّ ظَنّ السكوتَ عَنهُ لإشفا","قٍ عَلَيهِ قَد كان من إِشفاق",6,"ق",1,0],["ثُمَّ ظَنّوا أنْ خبَّأوا وَضَحَ الشَّمْسِ","بأيْدٍ قدْ لُطِّخَتْ بالدِّماءِ",7,"ا",2,0]]}