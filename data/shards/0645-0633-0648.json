{"poems":[[55,"دع من دموعك بعد البين للدمن","https://www.aldiwan.net/poem29648.html","البسيط"],[53,"قل للأمير أدام الله غبطته","https://www.aldiwan.net/poem10869.html","البسيط"],[53,"اسعد بعيد أخي نسك وإسلام","https://www.aldiwan.net/poem66052.html","البسيط"],[31,"عفا من آل فاطمة الدخول","https://www.aldiwan.net/poem6061.html","الوافر"],[63,"أجل هو الفتح لا فتح يشاكله","https://www.aldiwan.net/poem51478.html","البسيط"],[63,"أقررت في شكرك بالتقصير","https://www.aldiwan.net/poem51655.html","الرجز"],[46,"يا برق طالع منزلا بالأبرق","https://www.aldiwan.net/poem30397.html","الكامل"],[76,"ركضوا الجياد إلى الجلاد صباحا","https://www.aldiwan.net/poem12884.html","الكامل"],[77,"هل تملك الدار رجع سائلها","https://www.aldiwan.net/poem69023.html","البسيط"],[50,"هل مخطئ حتفه عفر بشاهقة","https://www.aldiwan.net/poem64454.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85430","الكامل"],[111,"تلك البوارق حاديهن مرنان","https://www.poetsgate.com/ViewPoem.aspx?id=100",""],[111,"غوث الوجود اغثني ضاق مصطبري","https://www.poetsgate.com/ViewPoem.aspx?id=517",""],[358,"خذي من ودادي العين يا قرة العين","https://www.aldiwan.net/poem39773.html","الطويل"],[412,"ألمت ودوني من تهامة بيدها","https://www.aldiwan.net/poem50189.html","الطويل"],[422,"سؤالك هذا الربع أين جوابه","https://www.aldiwan.net/poem54156.html","الطويل"],[453,"وسبحة قد ظللت أحصي","https://www.aldiwan.net/poem53785.html","مخلع البسيط"],[466,"إذا ما عقيل باهلت يوم فخرها","https://www.aldiwan.net/poem15174.html","الطويل"],[520,"إذا قدرت على العلياء بالغلب","https://www.aldiwan.net/poem12009.html","البسيط"],[520,"أمنت من الغرام على فؤادي","https://www.aldiwan.net/poem12064.html","الوافر"],[556,"ألا يا قوم للقدر المتاح","https://www.aldiwan.net/poem47892.html","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62577","الرجز"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64625","الرجز"],[1403,"","https://poetry.dctabudhabi.ae/diwan/poem/115354","الكامل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128716","الطويل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69404","السريع"],[2155,"","https://poetry.dctabudhabi.ae/diwan/poem/96033","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53122","الرجز"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76040","البسيط"],[3400,"","https://poetry.dctabudhabi.ae/diwan/poem/130612","الرجز"],[3515,"","https://poetry.dctabudhabi.ae/diwan/poem/103626","الطويل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86361","البسيط"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93747","الطويل"],[4737,"التنوير","https://www.poetsgate.com/ViewPoem.aspx?id=212156",""],[1012,"أباة الضيم","https://www.poetsgate.com/ViewPoem.aspx?id=186325",""],[4876,"مسٌ بشعرك","https://www.poetsgate.com/ViewPoem.aspx?id=207498",""],[5136,"نصر من الله وفتح قريب","https://www.poetsgate.com/ViewPoem.aspx?id=121520",""],[5277,"القدسُ..القدسُ..يا عربُ","https://www.poetsgate.com/ViewPoem.aspx?id=194614",""],[5756,"التمثال","https://www.poetsgate.com/ViewPoem.aspx?id=1366",""],[5776,"( لحى اليسار )","https://www.poetsgate.com/ViewPoem.aspx?id=199823",""],[5816,"( العبيرية ) في وصف الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=125964",""],[5897,"الحياء في لحظات الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=157485",""]],"verses":[["مُسَوِّدٌ قَصَبَ الأَقلامِ نالَ بِها","نَيلَ المُحَمِّرِ أَطرافَ القَنا اللُدُنِ",0,"ن",1,0],["مُسَوَّمينَ بسيما اليُمْنِ في غُررٍ","مولودةٍ بنجومٍ غير أنكادِ",1,"د",1,0],["مُسوّمين على جُردٍ مسومةٍ","مثل القداحِ بأيدي غيرِ أبرامِ",2,"م",1,0],["مُسَوَّمَةٍ كَأَنَّ مُحافِظيها","تُصَدَّعُ بَينَهُم كَأسٌ شَمولُ",3,"ل",1,0],["مُسوَدَّةً من لَظىً حامٍ مَلاعِبُه","مُحمَرَّةً من دَمٍ جارٍ جَداوِلُه",4,"ل",2,0],["مُسوَدَّةُ الاعجازِ والصُّدورِ","سُودٌ عليها رَونَقُ الذُّكورِ",5,"ر",1,0],["مُسوَدُّ شَطرٍ مِثلَ ما اِسوَدَّ الدُجى","مُبيَضٌّ شَطرٍ كَاِبيِضاضِ المُهرَقِ",6,"ق",1,0],["مُسوَدَّ ساحاتِ المَنازِلِ وَحشَةً","مَملوءَ أَفنِيَةِ الدِيارِ نِياحا",7,"ح",2,0],["مسومات إلى قوانسها","مخضبات إلى كواهلها",8,"ل",3,0],["مُسَوَّرٌ مِن حَباءِ اللَهِ أَسوِرَةً","يَركَبنَ مِنها وَظيفَ القَينِ وَالساقا",9,"ق",2,0],["مسودة بالنار تحسب أَنَّها","مطلية بالقار وَالقطران",10,"ن",1,0],["مسومين لنصر الله أنفسهم","أرواحهم في سبيل الله قربان",11,"ن",1,0],["مسومين بنور الله يقدمهم","حيزوم والملأ الأعلى على الأثر",12,"ر",1,0],["مَسوّمةً تَأوي الشآمَ جيادُها","وَأَصواتها ما بينَ صنعاء والعينِ",13,"ن",1,0],["مُسوَّدُها مقدامها كَنز عِزَّها","سنميدعها مصداقها وَرَشيدها",14,"د",3,0],["مسوقٌ إلى ذي اللب في الناس رزؤه","ووقفٌ على الحر الكريم مصابه",15,"ب",2,0],["مسودة وهوغير بدع","إذ كنت أمحو بها ذنوبي",16,"ي",1,0],["مُسوَّدُها يوم الوغى وأميرُها","ومرجوُّها يوم النَّدى وكريمُها",17,"م",3,0],["مسومات عراب لم تزل أبداً","تكسى وتحلى بما بزت من السلب",18,"ب",1,0],["مسومة تسوم عداه خسفاً","إذا نزلت بساحات الأعادي",19,"د",2,0],["مَسوقٌ في الأمورِ إِلى هُداها","وَمَدْلولٌ على بابِ النّجاحِ",20,"ح",1,0],["مسوَّد مؤيَّد","مهنَّد مجرَّد",21,"د",1,0],["مسوم الجرد العوادي عندها","مثل لعاب النحل مسفوح الطلا",22,"ا",1,0],["مسودة مبيضة فكأنها","دهم مولوعة الشوى ببياض",23,"ض",1,0],["مسومة فيه ملائكة السما","كأنهم فيه ليوث بواسل",24,"ل",1,0],["مُسوَدَّةِ الأَرجاءِ مُشتَقَّةٍ","في اللَونِ مِن لَونِ المَساعي القِباح",25,"ح",1,0],["مسودين اذناباً جاهلية","تسدد نصلاً حين تغرق منزعا",26,"ع",2,0],["مسوّم الخيل وحاميها إذا","فرَّ الجبان خيفة وأدبرا",27,"ر",2,0],["مُسوَدُّ فَودِكَ بِالمبيضِّ مُشتعِل","وَأَنتَ بِالهزل وَقتَ الجدِّ مُشتغِلُ",28,"ل",1,1],["مسوّد ساد الانام يافعا","وعاد كهلا بالتقى مقترنا",29,"ن",2,0],["مسوّمة تحكي سبائكها الصفا","وتنقض منها بالضراغم عقبانُ",30,"ن",1,1],["مسودة الجعد لولا ضوء غرتها","لما هدتني إليها نار أشواقي",31,"ق",2,0],["مَسوقين إِلا أَن تَكُون سياسة","يصرفها ماضي الغرار لَبيب",32,"ب",1,0],["مسوخُ الدِّينِ تجهضُ كلَّ نضجٍ","ببطنِ الوعي قد أضحى جنينا",33,"ن",2,0],["مسورة بأجبال عليها","قلاع فوق هاتيك الأكام",34,"م",1,0],["مسٌ وتنتزع القصيدة قبلةً","حاكَ احتضار نزيفها زريابُ",35,"ب",1,0],["مسور سور الملك لما غدا","طوعاً لعلياك بصدر رحيب",36,"ب",1,0],["مسوخُ هودٍ وصهيونٍ عليكِ عدتْ","عذراً فإنَّا منَ الممسوخِ نرتعبُ",37,"ب",1,0],["مسوي في حياتي شي مايذكر ولا ينقال","حتى العدو واهو العدو ما يعمل اعمالك",38,"ك",1,0],["مُسوخٌ بزيفِ الكأسِ ما عاقروا المُنى","وقد سكروا موتاً بكأسِ المَدَافعِ",39,"ع",1,0],["مسورة أيديهم وخلاخل","لهم زجل في مشيهم يستحيرها",40,"ر",3,0],["مسوخٌ جُرِّدتْ من كل معنى","وحادت في عتوٍّ عن سبيلي",41,"ل",2,0]]}