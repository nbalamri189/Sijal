{"poems":[[53,"أغر أيامي مني ذا الطلل","https://www.aldiwan.net/poem29853.html","الرجز"],[53,"بحيث انعقد الرمل","https://www.aldiwan.net/poem29854.html","الهزج"],[53,"أيرجع ميتا رنة وعويل","https://www.aldiwan.net/poem29891.html","الطويل"],[53,"نطق اللسان عن الضمير","https://www.aldiwan.net/poem30476.html","مجزوء الكامل"],[53,"جري النسيم على ماء العناقيد","https://www.aldiwan.net/poem30625.html","البسيط"],[77,"إذا أنا لم أوثر هواي على عزمي","https://www.aldiwan.net/poem36126.html","الطويل"],[77,"أمولاي خذها بنت فكري تغيبت","https://www.aldiwan.net/poem36346.html","الطويل"],[77,"لمن طلل نائي المزار بعيده","https://www.aldiwan.net/poem36615.html","الطويل"],[71,"وقاك الله مجد الدين عين الحسود","https://www.aldiwan.net/poem3850.html","الوافر"],[93,"يا ترب عصرك بيتي","https://www.aldiwan.net/poem11464.html","المجتث"],[88,"أرى الدهر لا يألو بستر الحقائق","https://www.aldiwan.net/poem45013.html","الطويل"],[47,"نفى النوم عن عيني خيال مسلم","https://www.aldiwan.net/poem25134.html","الطويل"],[72,"تصرمت الأيام دون وصالك","https://www.aldiwan.net/poem19437.html","الطويل"],[72,"سرى بشبيه البدر آل هلال","https://www.aldiwan.net/poem19482.html","الطويل"],[72,"رمى حشاي ويا شوقي إلى الرامي","https://www.aldiwan.net/poem19676.html","البسيط"],[51,"أبا الصقر لست أرى مهديا","https://www.aldiwan.net/poem8301.html","المتقارب"],[51,"صبا من شاب مفرقه تصابي","https://www.aldiwan.net/poem8494.html","الوافر"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"بلغك الله أن يهنأ مولودك","https://www.aldiwan.net/poem61871.html","المنسرح"],[51,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[51,"لك الخير إني أستزيد ولا أشكو","https://www.aldiwan.net/poem65797.html","الطويل"],[51,"يا عصمة لست منها باغيا بدلا","https://www.aldiwan.net/poem65886.html","البسيط"],[51,"أقاسم لا تسدد سبيلي إلى الرضا","https://www.aldiwan.net/poem65997.html","الطويل"],[51,"أرى الشعراء حظوا عندكم","https://www.aldiwan.net/poem66395.html","المتقارب"],[91,"لمن يضوع العبير لمن تغني الطيور","https://www.aldiwan.net/poem8821.html","عموديه"],[14,"إذا المرء لم يبعث سواما ولم يرح","https://www.aldiwan.net/poem38315.html","الطويل"],[92,"أزنبقة السفح ما لي أراك","https://www.aldiwan.net/poem38887.html","المتقارب"],[92,"أتفنى ابتسامات تلك الجفون","https://www.aldiwan.net/poem38959.html","المتقارب"],[85,"محمد ما أخلفتنا ما وعدتنا","https://www.aldiwan.net/poem7775.html","الطويل"],[85,"آشيم يا من بحبه نعلو","https://www.aldiwan.net/poem7804.html","المنسرح"],[43,"ما أنصف القوم ضبه وأمه الطرطبه","https://www.aldiwan.net/poem9511.html","المجتث"],[43,"آخر ما الملك معزى به","https://www.aldiwan.net/poem9512.html","السريع"],[43,"ما سدكت علة بمورود","https://www.aldiwan.net/poem9527.html","المنسرح"],[43,"طوال قنا تطاعنها قصار","https://www.aldiwan.net/poem9568.html","الوافر"],[43,"أيقدح في الخيمة العذل","https://www.aldiwan.net/poem9940.html","المتقارب"],[62,"اعمل بجد وجلد","https://www.aldiwan.net/poem52155.html","مجزوء الرجز"],[62,"قد خلط البياض بالسواد","https://www.aldiwan.net/poem52215.html","الرجز"],[45,"حاجة ذا الحيران أن ترشده","https://www.aldiwan.net/poem63481.html","البسيط"],[45,"مغاني سليمى بالعقيق ودورها","https://www.aldiwan.net/poem63610.html","الطويل"],[45,"أبا العباس برزت على قومك","https://www.aldiwan.net/poem64567.html","الهزج"],[45,"بأي أسى تثنى الدموع الهوامل","https://www.aldiwan.net/poem65575.html","الطويل"],[45,"هواها على أن الصدود سبيلها","https://www.aldiwan.net/poem65583.html","الطويل"],[45,"على الحي سرنا عنهم وأقاموا","https://www.aldiwan.net/poem65687.html","الطويل"],[61,"عزاء يا أبا الفضل","https://www.aldiwan.net/poem51391.html","الهزج"],[61,"أما وأبيك لا أنساه تدمي","https://www.aldiwan.net/poem51394.html","الوافر"],[61,"لا تأخذني بجرم كاسات","https://www.aldiwan.net/poem51753.html","المنسرح"],[2,"صحا القلب عن سلمى وقد كاد لا يسلو","https://www.aldiwan.net/poem25064.html","الطويل"],[49,"ألا هل على زمني مسعد","https://www.aldiwan.net/poem62050.html","المتقارب"],[49,"تفكر قبل أن تندم","https://www.aldiwan.net/poem63115.html","مجزوء الوافر"],[80,"أخذت برأي في الصبا أنا تاركه","https://www.aldiwan.net/poem31356.html","الطويل"],[80,"بكى فقدك العز المؤيد والمجد","https://www.aldiwan.net/poem31472.html","الطويل"],[80,"بلى جر أذيال الصبا وتصابى","https://www.aldiwan.net/poem31543.html","الطويل"],[44,"متى أنت عن ذهلية الحي ذاهل","https://www.aldiwan.net/poem30372.html","الطويل"],[44,"شهدت لقد أقوت مغانيكم بعدي","https://www.aldiwan.net/poem30537.html","الطويل"],[69,"إذا كرهت منزلا","https://www.aldiwan.net/poem28781.html","مجزوء الرجز"],[105,"أعندك أنا لم ندع بعدك الوجدا","https://www.aldiwan.net/poem41928.html","الطويل"],[105,"أمنك الذكر يعصف بالقلوب","https://www.aldiwan.net/poem42121.html","الوافر"],[105,"سيد الرسل وأم المؤمنين","https://www.aldiwan.net/poem44196.html","الرمل"],[81,"لولا قضاؤك بين الحكم والحكم","https://www.aldiwan.net/poem61492.html","البسيط"],[39,"أعرفت ربعا غير آهل","https://www.aldiwan.net/poem53755.html","مجزوء الكامل"],[22,"أرى العير تحدى بين قو وضارج","https://www.aldiwan.net/poem22003.html","الطويل"],[22,"وإن جياد الخيل لا تستفزنا","https://www.aldiwan.net/poem22074.html","الطويل"],[52,"قد غضبت بنت النميرية","https://www.aldiwan.net/poem26572.html","السريع"],[75,"قفا فلأمر ما سرينا وما نسري","https://www.aldiwan.net/poem69081.html","الطويل"],[48,"دع الأطلال تسفيها الجنوب","https://www.aldiwan.net/poem10768.html","الوافر"],[48,"رغيف سعيد عنده عدل نفسه","https://www.aldiwan.net/poem62435.html","السريع"],[48,"إذا أجرى أمين الله","https://www.aldiwan.net/poem63434.html","الهزج"],[48,"ملكت على طير السعادة واليمن","https://www.aldiwan.net/poem66136.html","الطويل"],[50,"ألا طرقت موهنا مهدد","https://www.aldiwan.net/poem63884.html","الوافر"],[50,"ألا من لمطروب الفؤاد عميد","https://www.aldiwan.net/poem63957.html","الطويل"],[46,"وجدتك أعطيت الشجاعة حقها","https://www.aldiwan.net/poem22188.html","الطويل"],[46,"ترنم في نهارك مستعينا","https://www.aldiwan.net/poem22214.html","الوافر"],[46,"ترج بلطف القول رد مخالف","https://www.aldiwan.net/poem22648.html","الطويل"],[46,"لا أسأل المرء قرضا من شهادته","https://www.aldiwan.net/poem22890.html","البسيط"],[46,"أما الزمان فأوقات مواصلة","https://www.aldiwan.net/poem22941.html","البسيط"],[46,"لقد فقد الخير بين الأنا","https://www.aldiwan.net/poem23555.html","المتقارب"],[8,"خليلي غضا ساعة وتهجرا","https://www.aldiwan.net/poem21784.html","الطويل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125573","الرمل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16654","الوافر"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202530","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42603","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54935","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43888","المديد"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/50356","السريع"],[77,"إذا أنا لم أوثر هواي على عزمي","https://www.poetsgate.com/ViewPoem.aspx?id=34203",""],[100,"فارس الاصطياف","https://www.poetsgate.com/ViewPoem.aspx?id=50417",""],[103,"ملكنا هذه الدنيا قرونا","https://www.poetsgate.com/ViewPoem.aspx?id=1234",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[45,"حاجةُ ذا الحَيرَانِ أنْ تُرْشِدَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31625",""],[45,"بأيّ أسًى تُثْنَى الدّمُوعُ الهَوَامِلُ","https://www.poetsgate.com/ViewPoem.aspx?id=32193",""],[80,"أخذتُ برأيٍ في الصبا أنا تاركُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=3425",""]],"verses":[["وَاِنجُ مِنَ الهَونِ كَما يَنجو البَطَل","مَن لَم يَئِل مِن بَعدِها فَلا وَأَل",0,"ل",1,0],["وَإِن جُزتُ عَنِ العِزِّ","فَلا جاوَزَني الذُلُّ",1,"ل",1,0],["وَإِن جَهِلَ الأَقدارَ وَالدَهرَ عاقِلٌ","فَأَضيَعُ شَيءٍ في الرِجالِ عُقولُ",2,"ل",1,0],["وَاِنجابَتِ الظُلماءُ عَن","وَضَحِ الصَباحِ المُستَنيرِ",3,"ر",1,0],["وَإِن جَرَى شِرِقَت بِالحَصلِ راحَتُهُ","أَخَذاً وَبَدَّدَ أَنفاسَ المَجاهيدِ",4,"د",1,0],["وَإِنْ جَدَّ يَوْماً لَمْ يَبِتْ دُونَ غَايَةٍ","وَإِنْ جَادَ مَا ذُو الْعُسْرِ يَوْماً بِمُهْتَمِّ",5,"م",1,0],["وَأَنْجِزْ جَمِيلَ الْوَعْدِ وَاعْلَمْ بِأَنَّهُ","تُلاَزِمُ أَقْوَالَ الْكَرِيمِ فِعَالُهُ",6,"ل",2,0],["وَإِنْ جُدْتَ لِي يَوْماً فَنَوِّهْ بِرُتْبَتِي","فَمِثْلِيَ مَلْحُوظٌ لَدَيْكَ انْتِقَالُهُ",6,"ل",2,0],["وأنْجَبَهُ للدّينِ يحْمي ذِمارَهُ","كما أنْجَبَتْ لَيْثَ العَرينِ أسودُهُ",7,"د",2,0],["وَإِن جُلِيَت عَرائِسُها عَلَينا","نَدينُ لَها الفَرَزدَقَ أَو جَريرا",8,"ر",2,0],["وَأَنْجُمٌ وَشُمُوسٌ","مِنْ عِفَّةٍ وَجَمَالِ",9,"ل",1,0],["وأن جاء أغضى من رآه تهيّباً","سوى نظر منهم بعينَيْ مسارق",10,"ق",1,0],["وَإِنَّ جُفوني إِن وَنَت لِلَئيمَةٍ","وَإِنَّ فُؤادي إِن سَلَوتُ لَأَلأَمُ",11,"م",1,0],["وإن جرَّ في صوبِ الثغور رؤوسها","جلت قلح الأعدا جلاء المساوك",12,"ك",1,0],["وإن جهّز السمر الذوابل للوغى","فقل في قصير شدّ أزر طوال",13,"ل",1,0],["وأنجمٍ خدمت علياك فهي إذاً","نعم الجواري التي تدعى بخدَّام",14,"م",1,0],["وأنجدتنا على الأمداح منك لُهًى","إلى الورَى ذات إنجادٍ وإتهام",14,"م",1,0],["وإنَّ جنابيَ لو جاده","لأزكى نباتاً وأزكى ترابا",15,"ب",2,0],["وإن جادَهُ العُرْفُ أجْنَى جنىً","من الشكر مستعذباً مستطابا",15,"ب",2,0],["وإن جاوزتُ مدحَك لم يزل بي","تكذُّبيَ المدائحَ واجتلابي",16,"ب",2,0],["وأنجبُ ما ولَّدت منه مسرةً","إذا ما بَنَاتُ الصَّدْر ظلت توَلَّدُ",17,"د",1,0],["وأن جدَّ الفتى الوزير أبو ال","قاسم فرْدُ الجلالِ واحِدُهُ",18,"د",2,0],["وإن جرى الدمع غير معتنَفٍ","وسمَّح الشِّعر غير معتَسرِ",19,"ر",1,0],["وإنَّ جفاءً منك محضاً وقسْوة","لَتَركُك خِلّاً لا يساعده التركُ",20,"ك",1,0],["وإن جرى الأرقُش النضناض في يده","جرى شجاعٌ يمجُّ السمَّ والعسلا",21,"ل",2,0],["وإن جُدتَ لي بالكُثْر قالوا مبغَّضٌ","فدى نفسَه مِنْ قُربِه بجزيلِ",22,"ل",1,0],["وإن جدتْ لي بالقُلّ قال خطيبُهم","قليلٌ رُمِي في وجهه بقليلِ",22,"ل",1,0],["وإن جئتكُمْ زَمِناً قلتُمُ","أتاكُمْ أبو الليثِ صولر تكِن",23,"ن",1,0],["وَأَنجُد وَوِهادٌ","لَكِنَّهُ مَهجورُ",24,"ر",1,0],["وَإِن جارَتي أَلوَت رِياحٌ بِبَيتِها","تَغافَلتُ حَتّى يَستُرَ البَيتَ جانِبُه",25,"ب",2,0],["وإنْ جَرَفَتْني أَكفُّ المنونِ","إلى اللَّحْدِ سَحَقكِ الخطوبْ",26,"ب",1,0],["وإنَّ جمالَ الكمالِ الطُّموحُ","وما دامَ فكراً يُرَى من بعيدْ",27,"د",1,0],["وإن جردوا الأقلام جردت إثرها","يراعا له في الخافقين صرير",28,"ر",1,0],["وأنجم الهند ما طلعن لنا","وما رعتنا عيونها النجل",29,"ل",1,0],["وَإِن جَهِلتَ مُرادي","فَإِنَّهُ بِكَ أَشبَه",30,"ب",2,0],["وَأَنَّ جَدَّ المَرءِ أَوطانُهُ","مَن لَيسَ مِنها لَيسَ مِن صُلبِهِ",31,"ب",2,0],["وَإِن جَزِعنا لَهُ فَلا عَجَبٌ","ذا الجَزرُ في البَحرِ غَيرُ مَعهودِ",32,"د",1,0],["وَإِن جُنحُ الظَلامِ اِنجابَ عَنهُم","أَضاءَ المَشرَفِيَّةُ وَالنَهارُ",33,"ر",1,0],["وَإِن جادَ قَبلَكَ قَومٌ مَضَوا","فَإِنَّكَ في الكَرَمِ الأَوَّلُ",34,"ل",1,0],["وإن جهلت الوزن فاع","دنه ففي العجن الرشد",35,"د",1,0],["وأنجب الروحان في الميلادِ","كأنما كانا على ميعادِ",36,"د",1,0],["وَأَنجُمُ الأُفقِ نِظامٌ ذَلا","ما خالَفَت أَنحُسُهُ أَسعَدَه",37,"د",2,0],["وَإِنَّ جِمامَ الماءِ يَزدادُ نَفعُها","إِذا صَكَّ أَسماعَ العِطاشِ خَريرُها",38,"ر",3,0],["وَإِن جَنَّستَ لَم تَستَكرِهِ القَولَ","وَإِن طابَقتَهُ طَرَّزتَ تَطريزا",39,"ز",2,0],["وَإِن جاءَنا يَحكي أَباهُ فَلَم تَزَل","لَهُ مِن أَبيهِم شِيمَةٌ وَشَمائِلُ",40,"ل",1,0],["وَإِن جَهَدَ الواشونَ في صَرمِ حَبلِها","وَأَبدَعَ في فَرطِ المَلامِ عَذولُها",41,"ل",3,0],["وَإِنَّ جُحودي سوءُ ظَنٍّ بِمُنعِمٍ","وَعَدّي مَعاذيري عَلَيهِ خِصامُ",42,"م",1,0],["وإن جارعلى أهلك","صرف الدهر بالجلى",43,"ا",1,0],["وإن جَرَحَ الأخادعَ مُطْمَئِناً","كسا الأوداجَ دِيباجاً بَهِيّا",44,"ي",2,0],["وإن جرَت زَلَّةٌ على سَكَرٍ","فإنها اليومَ بِكرُ زَلاَّتي",45,"ت",2,0],["وَإِن جِئتَهُم أَلفَيتَ حَولَ بُيوتِهِم","مَجالِسَ قَد يُشفى بِأَحلامِها الجَهلُ",46,"ل",1,0],["وَإِن جَمَدَت عَنكَ أَيدي العِبادِ","فَإِنَّ يَدَ اللَهِ لا تَجمَدُ",47,"د",1,0],["وَإِنَّ جَديدَها يَبلى","وَإِنَّ شَبابَها يَهرَم",48,"م",1,0],["وَإِن جَنّ لَيلٌ أقبَلَتْ نَحوَ سَفْرِهِ","مُجَلَّحَةً أغوالُهُ وصعالِكُه",49,"ك",2,0],["وإن جادَ كانَ الجودُ منه مهنأً","كغَيثٍ هَمَى ما فيه برقٌ ولا رعدُ",50,"د",1,0],["وإِن جَزموا الأعمارَ في الحربِ صَيّروا","عواملهم في الدّارِعينَ حِرابا",51,"ب",2,0],["وَإِنَّ جَزيلاتِ الصَنائِعِ لِاِمرِىءٍ","إِذا ما اللَيالي ناكَرَتهُ مَعاقِلُ",52,"ل",1,0],["وَأَنجَدتُمُ مِن بَعدِ إِتهامِ دارِكُم","فَيا دَمعُ أَنجِدني عَلى ساكِني نَجدِ",53,"د",1,0],["وإنْ جفاكَ صاحبٌ","فكنْ بهِ مستبدِلا",54,"ل",2,0],["وإن جانب الإنصاف في الحكم ذو هوى","فكن أنت حرا لا تكن للهوى عبدا",55,"د",2,0],["وإن جَرَتِ الرِّياحُ بها لهيباً","فتلكَ حَرارةُ الوجدِ المُذيبِ",56,"ب",1,0],["وانجلى اللّيلُ عن الخطبِ الذي","غادرَ الإصباحَ مُسَودَّ الجبينْ",57,"ن",1,0],["وَإِن جَنَيتُ بِكَ التَرفيهِ مِن شَظَفٍ","فَرُبَّ مَغفِرَةٍ تُنجي مِنَ النَدَمِ",58,"م",1,0],["وَاِنجَبنَ عَن حَدَبِ الإِكا","مِ وَعَن جَماعيرِ الجَراوِل",59,"ل",1,0],["وَإِن جاهَدَتهُ جاهَدَت ذا كَريهَةٍ","وَإِن تَعدُ عَدواً يَعدُ عادٍ مُناقِلُ",60,"ل",1,0],["وَإِنَّ جِيادَ الخَيلِ لا تَستَفِزُّنا","وَلا جاعِلاتُ الريطِ فَوقَ المَعاصِمِ",61,"م",1,1],["وَإِن جَرى ذِكري لَها أَعرَضَت","وَمَسَحَت ذِكري بِلا نِيَّه",62,"ي",2,0],["وأنْجَدَني يحيَى على كلِّ حادثٍ","وقلَّدَني منه بصَمصَامتَيْ عَمْرِو",63,"ر",2,0],["وَإِن جَمَّشتُهُ خَلَبَتكَ مِنهُ","طَرائِفُ تُستَخَفُّ لَها القُلوبُ",64,"ب",1,0],["وَإِن جائَهُ المَسكينُ يَطلُبُ فَضلَهُ","فَقَد ثَكَلَتهُ أُمُّهُ وَأَقارِبُه",65,"ب",2,0],["وَإِن جاذَبتَهُ نامَ","وَإِن هازَلتَهُ باسا",66,"س",2,0],["وَإِن جَرَتِ الأَلفاظُ مِنّا بِمِدحَةٍ","لِغَيرِكَ إِنساناً فَأَنتَ الَّذي نَعني",67,"ي",1,0],["وَإِن جِئتَ يَوماً إِلى زَلَّةٍ","أَكَلتَ كَما يَأكُلُ القُرهُدُ",68,"د",1,0],["وَإِن جيدَ مَنَّتهُ المُنى بِلِقائِهِ","خَلايا وَلا يَلقاهُ غَيرَ مَجودِ",69,"د",1,0],["وَإِنَّ جُيوبَ السَردِ مِن سُبُلِ الرَدى","إِذا لَم يَكُن مِن تَحتُ نُصحِ جُيوبِ",70,"ب",1,0],["وَإِن جِئنَ المُنَجَّمَ سائِلاتٍ","فَلَسنَ عَنِ الضَلالِ بِمُنجَماتِ",71,"ت",1,0],["وَإِن جاءَ ضَيفٌ طارِقٌ عَن ضَرورَةٍ","فَذُخرٌ لِقاريهِ الطَعامُ الَّذي يَقري",72,"ر",2,0],["وَإِن جُعِلتُ بِحُكمِ اللَهِ في خَزَفٍ","يَقضي الطُهورَ فَإِنّي شاكِرٌ راضِ",73,"ض",1,0],["وَإِن جَهِلتَ هَداكَ اللَهُ مِن كِبَرٍ","فَكُلُّ طودٍ مُنيفٍ شَأنُهُ الصَلَعُ",74,"ع",1,0],["وَإِن جاءَكَ المَوتُ فَاِفرَح بِهِ","لِتَخلُصَ مِن عالَمٍ قَد لُعِن",75,"ن",1,0],["وَإِن جاءَ أَمرٌ لا تُطِيقانِ دَفعَهُ","فَلاَ تَجزَعا مِمّا قَضى اللَهُ واِصبِرا",76,"ر",2,0],["وانج منه ببقايا رَمَقٍ","أو حُطامٍ وقليلٌ مَن نجا",77,"ج",2,0],["وإنْ جارَتْكَ هُوجُ الرّيحِ كانت","أكَلَّ رَكائباً وأقَلَّ زادا",78,"د",2,0],["وأنجز الله النبي وعده","وساد قومه الزمان بعده",79,"ه",1,0],["وَأَنْجُمٌ تِلْكَ أَمْ فُرْسَانُ عَادِيَةٍ","تَخْتَالُ فِي مَوْكِبٍ كَالْبَحْرِ مَسْجُورِ",80,"ر",1,0],["وَانْجَلَى لَحْظُهَا عَنْ الزَّهَرِ","الغَضِّ وَعَذْبِ الْجَنَى وَطِيبِ العَبِيرِ",81,"ر",1,0],["واِنجلَتْ عن حُسْنِ مالِقَةٍ","بِفَقِيهيها قَبائِحُهُ",82,"ح",2,0],["وإنْ جَفا عَبْداً له واصلاً","مُعتَلِقاً بالوُدِّ أيَّ اعتِلاق",83,"ق",1,0],["وإن جد يوما لم يبت دون غاية","وإن جاد ما ذو العطر يوما بمهتم",84,"م",1,0],["وانجر يهمس ، للطيوف ويجتلي","وعدا، من الأغداق والإسراف",85,"ف",1,0],["وإن جن المساء فلا تراهم","من الإشفاق إلا ساجدينا",86,"ن",2,0],["وانجاب عن مترددينَ طِلاؤُهم","وانزاحَ عن متربصِّينَ لِثام",87,"م",1,0],["وأنجُمُ الأفْقِ نِظَامٌ، خَلاَ","ما خَالَفَتْ أنْحُسُهُ أصْعُدَهْ",88,"د",2,0],["وَإنْ جَاءَنَا يَحْكي أباهُ، فلَم تَزَل","لَهُ مِنْ أبيهِ شِيمَةٌ وَشَمَائِلُ",89,"ل",1,0],["وإن جنّ ليلٌ أقبلتْ نحو سفرِهِ","مجلَّجة ً أغوالهُ وصعالكه",90,"ك",2,0]]}