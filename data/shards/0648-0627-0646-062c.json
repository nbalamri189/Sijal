 الصبر والجلد","https://www.aldiwan.net/poem47882.html","البسيط"],[551,"أتمضي كذا أيدي الردى بالمصاعب","https://www.aldiwan.net/poem48057.html","الكامل"],[551,"شد غروض المطي مغتربا","https://www.aldiwan.net/poem48085.html","المنسرح"],[558,"يا من تكلم فينا بالذي فيه","https://www.aldiwan.net/poem33664.html","البسيط"],[558,"تجلت لنا ذات وفعل بدا واسم","https://www.aldiwan.net/poem34074.html","الطويل"],[558,"فريدة حسن وجهها البدر طالع","https://www.aldiwan.net/poem34394.html","الطويل"],[558,"هذه الأثواب والخلع","https://www.aldiwan.net/poem34397.html","المديد"],[558,"فرحي يا فرحي يا فرحي","https://www.aldiwan.net/poem34662.html","الرمل"],[558,"ظهرت ذاتي لذاتي","https://www.aldiwan.net/poem34729.html","مجزوء الرمل"],[562,"سلام على من لا نمر بباله","https://www.aldiwan.net/poem52813.html","الطويل"],[567,"باكر الصبحة هذا","https://www.aldiwan.net/poem69516.html","الرمل"],[567,"أجل هو الرزء جل فادحه","https://www.aldiwan.net/poem69740.html","مجزوء البسيط"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[575,"لقد عفت عيشي بعد العفيف","https://www.aldiwan.net/poem2791.html","المتقارب"],[586,"متى يعطف الجاني وتقضى وعوده","https://www.aldiwan.net/poem17488.html","الطويل"],[586,"فديتك كم علي عليك عذل","https://www.aldiwan.net/poem17649.html","الوافر"]],"verses":[["وَاِنجُ مِنَ الهَونِ كَما يَنجو البَطَل","مَن لَم يَئِل مِن بَعدِها فَلا وَأَل",0,"ل",1,0],["وَإِن جُزتُ عَنِ العِزِّ","فَلا جاوَزَني الذُلُّ",1,"ل",1,0],["وَإِن جَهِلَ الأَقدارَ وَالدَهرَ عاقِلٌ","فَأَضيَعُ شَيءٍ في الرِجالِ عُقولُ",2,"ل",1,0],["وَاِنجابَتِ الظُلماءُ عَن","وَضَحِ الصَباحِ المُستَنيرِ",3,"ر",1,0],["وَإِن جَرَى شِرِقَت بِالحَصلِ راحَتُهُ","أَخَذاً وَبَدَّدَ أَنفاسَ المَجاهيدِ",4,"د",1,0],["وَإِنْ جَدَّ يَوْماً لَمْ يَبِتْ دُونَ غَايَةٍ","وَإِنْ جَادَ مَا ذُو الْعُسْرِ يَوْماً بِمُهْتَمِّ",5,"م",1,0],["وَأَنْجِزْ جَمِيلَ الْوَعْدِ وَاعْلَمْ بِأَنَّهُ","تُلاَزِمُ أَقْوَالَ الْكَرِيمِ فِعَالُهُ",6,"ل",2,0],["وَإِنْ جُدْتَ لِي يَوْماً فَنَوِّهْ بِرُتْبَتِي","فَمِثْلِيَ مَلْحُوظٌ لَدَيْكَ انْتِقَالُهُ",6,"ل",2,0],["وأنْجَبَهُ للدّينِ يحْمي ذِمارَهُ","كما أنْجَبَتْ لَيْثَ العَرينِ أسودُهُ",7,"د",2,0],["وَإِن جُلِيَت عَرائِسُها عَلَينا","نَدينُ لَها الفَرَزدَقَ أَو جَريرا",8,"ر",2,0],["وَأَنْجُمٌ وَشُمُوسٌ","مِنْ عِفَّةٍ وَجَمَالِ",9,"ل",1,0],["وأن جاء أغضى من رآه تهيّباً","سوى نظر منهم بعينَيْ مسارق",10,"ق",1,0],["وَإِنَّ جُفوني إِن وَنَت لِلَئيمَةٍ","وَإِنَّ فُؤادي إِن سَلَوتُ لَأَلأَمُ",11,"م",1,0],["وإن جرَّ في صوبِ الثغور رؤوسها","جلت قلح الأعدا جلاء المساوك",12,"ك",1,0],["وإن جهّز السمر الذوابل للوغى","فقل في قصير شدّ أزر طوال",13,"ل",1,0],["وأنجمٍ خدمت علياك فهي إذاً","نعم الجواري التي تدعى بخدَّام",14,"م",1,0],["وأنجدتنا على الأمداح منك لُهًى","إلى الورَى ذات إنجادٍ وإتهام",14,"م",1,0],["وإنَّ جنابيَ لو جاده","لأزكى نباتاً وأزكى ترابا",15,"ب",2,0],["وإن جادَهُ العُرْفُ أجْنَى جنىً","من الشكر مستعذباً مستطابا",15,"ب",2,0],["وإن جاوزتُ مدحَك لم يزل بي","تكذُّبيَ المدائحَ واجتلابي",16,"ب",2,0],["وأنجبُ ما ولَّدت منه مسرةً","إذا ما بَنَاتُ الصَّدْر ظلت توَلَّدُ",17,"د",1,0],["وأن جدَّ الفتى الوزير أبو ال","قاسم فرْدُ الجلالِ واحِدُهُ",18,"د",2,0],["وإن جرى الدمع غير معتنَفٍ","وسمَّح الشِّعر غير معتَسرِ",19,"ر",1,0],["وإنَّ جفاءً منك محضاً وقسْوة","لَتَركُك خِلّاً لا يساعده التركُ",20,"ك",1,0],["وإن جرى الأرقُش النضناض في يده","جرى شجاعٌ يمجُّ السمَّ والعسلا",21,"ل",2,0],["وإن جُدتَ لي بالكُثْر قالوا مبغَّضٌ","فدى نفسَه مِنْ قُربِه بجزيلِ",22,"ل",1,0],["وإن جدتْ لي بالقُلّ قال خطيبُهم","قليلٌ رُمِي في وجهه بقليلِ",22,"ل",1,0],["وإن جئتكُمْ زَمِناً قلتُمُ","أتاكُمْ أبو الليثِ صولر تكِن",23,"ن",1,0],["وَأَنجُد وَوِهادٌ","لَكِنَّهُ مَهجورُ",24,"ر",1,0],["وَإِن جارَتي أَلوَت رِياحٌ بِبَيتِها","تَغافَلتُ حَتّى يَستُرَ البَيتَ جانِبُه",25,"ب",2,0],["وإنْ جَرَفَتْني أَكفُّ المنونِ","إلى اللَّحْدِ سَحَقكِ الخطوبْ",26,"ب",1,0],["وإنَّ جمالَ الكمالِ الطُّموحُ","وما دامَ فكراً يُرَى من بعيدْ",27,"د",1,0],["وإن جردوا الأقلام جردت إثرها","يراعا له في الخافقين صرير",28,"ر",1,0],["وأنجم الهند ما طلعن لنا","وما رعتنا عيونها النجل",29,"ل",1,0],["وَإِن جَهِلتَ مُرادي","فَإِنَّهُ بِكَ أَشبَه",30,"ب",2,0],["وَأَنَّ جَدَّ المَرءِ أَوطانُهُ","مَن لَيسَ مِنها لَيسَ مِن صُلبِهِ",31,"ب",2,0],["وَإِن جَزِعنا لَهُ فَلا عَجَبٌ","ذا الجَزرُ في البَحرِ غَيرُ مَعهودِ",32,"د",1,0],["وَإِن جُنحُ الظَلامِ اِنجابَ عَنهُم","أَضاءَ المَشرَفِيَّةُ وَالنَهارُ",33,"ر",1,0],["وَإِن جادَ قَبلَكَ قَومٌ مَضَوا","فَإِنَّكَ في الكَرَمِ الأَوَّلُ",34,"ل",1,0],["وإن جهلت الوزن فاع","دنه ففي العجن الرشد",35,"د",1,0],["وأنجب الروحان في الميلادِ","كأنما كانا على ميعادِ",36,"د",1,0],["وَأَنجُمُ الأُفقِ نِظامٌ ذَلا","ما خالَفَت أَنحُسُهُ أَسعَدَه",37,"د",2,0],["وَإِنَّ جِمامَ الماءِ يَزدادُ نَفعُها","إِذا صَكَّ أَسماعَ العِطاشِ خَريرُها",38,"ر",3,0],["وَإِن جَنَّستَ لَم تَستَكرِهِ القَولَ","وَإِن طابَقتَهُ طَرَّزتَ تَطريزا",39,"ز",2,0],["وَإِن جاءَنا يَحكي أَباهُ فَلَم تَزَل","لَهُ مِن أَبيهِم شِيمَةٌ وَشَمائِلُ",40,"ل",1,0],["وَإِن جَهَدَ الواشونَ في صَرمِ حَبلِها","وَأَبدَعَ في فَرطِ المَلامِ عَذولُها",41,"ل",3,0],["وَإِنَّ جُحودي سوءُ ظَنٍّ بِمُنعِمٍ","وَعَدّي مَعاذيري عَلَيهِ خِصامُ",42,"م",1,0],["وإن جارعلى أهلك","صرف الدهر بالجلى",43,"ا",1,0],["وإن جَرَحَ الأخادعَ مُطْمَئِناً","كسا الأوداجَ دِيباجاً بَهِيّا",44,"ي",2,0],["وإن جرَت زَلَّةٌ على سَكَرٍ","فإنها اليومَ بِكرُ زَلاَّتي",45,"ت",2,0],["وَإِن جِئتَهُم أَلفَيتَ حَولَ بُيوتِهِم","مَجالِسَ قَد يُشفى بِأَحلامِها الجَهلُ",46,"ل",1,0],["وَإِن جَمَدَت عَنكَ أَيدي العِبادِ","فَإِنَّ يَدَ اللَهِ لا تَجمَدُ",47,"د",1,0],["وَإِنَّ جَديدَها يَبلى","وَإِنَّ شَبابَها يَهرَم",48,"م",1,0],["وَإِن جَنّ لَيلٌ أقبَلَتْ نَحوَ سَفْرِهِ","مُجَلَّحَةً أغوالُهُ وصعالِكُه",49,"ك",2,0],["وإن جادَ كانَ الجودُ منه مهنأً","كغَيثٍ هَمَى ما فيه برقٌ ولا رعدُ",50,"د",1,0],["وإِن جَزموا الأعمارَ في الحربِ صَيّروا","عواملهم في الدّارِعينَ حِرابا",51,"ب",2,0],["وَإِنَّ جَزيلاتِ الصَنائِعِ لِاِمرِىءٍ","إِذا ما اللَيالي ناكَرَتهُ مَعاقِلُ",52,"ل",1,0],["وَأَنجَدتُمُ مِن بَعدِ إِتهامِ دارِكُم","فَيا دَمعُ أَنجِدني عَلى ساكِني نَجدِ",53,"د",1,0],["وإنْ جفاكَ صاحبٌ","فكنْ بهِ مستبدِلا",54,"ل",2,0],["وإن جانب الإنصاف في الحكم ذو هوى","فكن أنت حرا لا تكن للهوى عبدا",55,"د",2,0],["وإن جَرَتِ الرِّياحُ بها لهيباً","فتلكَ حَرارةُ الوجدِ المُذيبِ",56,"ب",1,0],["وانجلى اللّيلُ عن الخطبِ الذي","غادرَ الإصباحَ مُسَودَّ الجبينْ",57,"ن",1,0],["وَإِن جَنَيتُ بِكَ التَرفيهِ مِن شَظَفٍ","فَرُبَّ مَغفِرَةٍ تُنجي مِنَ النَدَمِ",58,"م",1,0],["وَاِنجَبنَ عَن حَدَبِ الإِكا","مِ وَعَن جَماعيرِ الجَراوِل",59,"ل",1,0],["وَإِن جاهَدَتهُ جاهَدَت ذا كَريهَةٍ","وَإِن تَعدُ عَدواً يَعدُ عادٍ مُناقِلُ",60,"ل",1,0],["وَإِنَّ جِيادَ الخَيلِ لا تَستَفِزُّنا","وَلا جاعِلاتُ الريطِ فَوقَ المَعاصِمِ",61,"م",1,1],["وَإِن جَرى ذِكري لَها أَعرَضَت","وَمَسَحَت ذِكري بِلا نِيَّه",62,"ي",2,0],["وأنْجَدَني يحيَى على كلِّ حادثٍ","وقلَّدَني منه بصَمصَامتَيْ عَمْرِو",63,"ر",2,0],["وَإِن جَمَّشتُهُ خَلَبَتكَ مِنهُ","طَرائِفُ تُستَخَفُّ لَها القُلوبُ",64,"ب",1,0],["وَإِن جائَهُ المَسكينُ يَطلُبُ فَضلَهُ","فَقَد ثَكَلَتهُ أُمُّهُ وَأَقارِبُه",65,"ب",2,0],["وَإِن جاذَبتَهُ نامَ","وَإِن هازَلتَهُ باسا",66,"س",2,0],["وَإِن جَرَتِ الأَلفاظُ مِنّا بِمِدحَةٍ","لِغَيرِكَ إِنساناً فَأَنتَ الَّذي نَعني",67,"ي",1,0],["وَإِن جِئتَ يَوماً إِلى زَلَّةٍ","أَكَلتَ كَما يَأكُلُ القُرهُدُ",68,"د",1,0],["وَإِن جيدَ مَنَّتهُ المُنى بِلِقائِهِ","خَلايا وَلا يَلقاهُ غَيرَ مَجودِ",69,"د",1,0],["وَإِنَّ جُيوبَ السَردِ مِن سُبُلِ الرَدى","إِذا لَم يَكُن مِن تَحتُ نُصحِ جُيوبِ",70,"ب",1,0],["وَإِن جِئنَ المُنَجَّمَ سائِلاتٍ","فَلَسنَ عَنِ الضَلالِ بِمُنجَماتِ",71,"ت",1,0],["وَإِن جاءَ ضَيفٌ طارِقٌ عَن ضَرورَةٍ","فَذُخرٌ لِقاريهِ الطَعامُ الَّذي يَقري",72,"ر",2,0],["وَإِن جُعِلتُ بِحُكمِ اللَهِ في خَزَفٍ","يَقضي الطُهورَ فَإِنّي شاكِرٌ راضِ",73,"ض",1,0],["وَإِن جَهِلتَ هَداكَ اللَهُ مِن كِبَرٍ","فَكُلُّ طودٍ مُنيفٍ شَأنُهُ الصَلَعُ",74,"ع",1,0],["وَإِن جاءَكَ المَوتُ فَاِفرَح بِهِ","لِتَخلُصَ مِن عالَمٍ قَد لُعِن",75,"ن",1,0],["وَإِن جاءَ أَمرٌ لا تُطِيقانِ دَفعَهُ","فَلاَ تَجزَعا مِمّا قَضى اللَهُ واِصبِرا",76,"ر",2,0],["وانج منه ببقايا رَمَقٍ","أو حُطامٍ وقليلٌ مَن نجا",77,"ج",2,0],["وإنْ جارَتْكَ هُوجُ الرّيحِ كانت","أكَلَّ رَكائباً وأقَلَّ زادا",78,"د",2,0],["وأنجز الله النبي وعده","وساد قومه الزمان بعده",79,"ه",1,0],["وَأَنْجُمٌ تِلْكَ أَمْ فُرْسَانُ عَادِيَةٍ","تَخْتَالُ فِي مَوْكِبٍ كَالْبَحْرِ مَسْجُورِ",80,"ر",1,0],["وَانْجَلَى لَحْظُهَا عَنْ الزَّهَرِ","الغَضِّ وَعَذْبِ الْجَنَى وَطِيبِ العَبِيرِ",81,"ر",1,0],["واِنجلَتْ عن حُسْنِ مالِقَةٍ","بِفَقِيهيها قَبائِحُهُ",82,"ح",2,0],["وإنْ جَفا عَبْداً له واصلاً","مُعتَلِقاً بالوُدِّ أيَّ اعتِلاق",83,"ق",1,0],["وإن جد يوما لم يبت دون غاية","وإن جاد ما ذو العطر يوما بمهتم",84,"م",1,0],["وانجر يهمس ، للطيوف ويجتلي","وعدا، من الأغداق والإسراف",85,"ف",1,0],["وإن جن المساء فلا تراهم","من الإشفاق إلا ساجدينا",86,"ن",2,0],["وانجاب عن مترددينَ طِلاؤُهم","وانزاحَ عن متربصِّينَ لِثام",87,"م",1,0],["وأنجُمُ الأفْقِ نِظَامٌ، خَلاَ","ما خَالَفَتْ أنْحُسُهُ أصْعُدَهْ",88,"د",2,0],["وَإنْ جَاءَنَا يَحْكي أباهُ، فلَم تَزَل","لَهُ مِنْ أبيهِ شِيمَةٌ وَشَمَائِلُ",89,"ل",1,0],["وإن جنّ ليلٌ أقبلتْ نحو سفرِهِ","مجلَّجة ً أغوالهُ وصعالكه",90,"ك",2,0],["وَإِن جَرَدت سَيفي أَو لِساني","فَلم أَترُك لِذي ضغن أَمانا",91,"ن",2,0],["وانجلالي لامعا كوكبها","ولغيري خلته لم يلمع",92,"ع",1,0],["وانجلت طلعة الصباح بنور","مشرق في الاغوار والانجاد",93,"د",1,0],["وانجلى في حضائر المدد العا","لي وليا من عهد آن الرضاع",94,"ع",1,0],["وإن جزت صبحاً بالغري وكربلا","وطبت شذى نحوي قبيل الأسى مرا",95,"ر",2,0],["وانجلت شبهةُ الفؤاد ولولا","عدلُه الحقُّ ما انجلت شبهاتُه",96,"ت",2,0],["وإِن جِئتُهُ أبدَى طَلاَقَةَ وَجهِهِ","وخَالَسَ في رَدِّ السَّلاَمِ التَّبُسَمَا",97,"م",2,0],["وإن جئتَه سَائِلهُ عَن فَرضِ عَينِه","وإِنَّكَ لَو ساءَلتَهُ لَتَبَلَّدَا",98,"د",2,0],["وأنجدَ في الدنيا وغارَ حديثُهُ","فراقَت بهِ حُسناً وطابَت بهِ نَشرا",99,"ر",2,0],["وإن جاك حرامي في طنطا","يطْلع من السرْحه ندمانِ",100,"ن",1,0],["وإن جحد الغر الجهول فخارهم","فهذا دليل أن آثارهم غُرُ",101,"ر",1,0],["وَإِن جادَتِ الأَنواءُ في الخِصبِ فاتَها","وَإِن بَخِلَت في المَحلِ كانَ لَها ضِدّا",102,"د",2,0],["وَإِن جاوَزَ الجَوزاءَ دَستٌ عَلَوتَهُ","فَقَد طالَها مِن قَبلِ أَن تُفطَمَ المَهدُ",103,"د",1,0],["وَإِن جَحَدوهُ وَلَن يَقدِروا","فَإِنَّ الإِمامَ بِهِ قَد أَقَرّ",104,"ر",1,0],["وَأَنجَزَ لي رَبُّ السَمَواتِ وَعدَهُ ال","كَريمَ بِأَنَّ العُسرَ مِن بَعدِهِ يُسرُ",105,"ر",1,0],["وَأَنجُمُ عَزمٍ أَشرَقَ المُلكُ مُذ بَدَت","فَدامَت لَهُ وَقفاً وَدُمتَ لَها أُفقا",106,"ق",2,0],["وَإِن جَلَّ ما خَوَّلتَني وَكَتَمتَهُ","جَلالاً فَما اِستَودَعتِنيهِ لِأَكتُما",107,"م",2,0],["وَإِن جاوَزتَ قَدرَ المَدحِ حَتّى","لَأَصبَحَ جاهِدٌ فيهِ كَوانِ",108,"ن",1,0],["وإن جمعت للمرء هذي وهذه","فذاك الذي لا يبتغى بعده نعمى",109,"م",2,0],["وإن جمعتنا في الظواهر نسبةٌ","تَخيلُ فإنّ القار في الهون كالمسك",110,"ك",1,0],["وَأَنجَزَ في الدُنيا وَفي الدينِ وَعدَهُ","فَكُلٌّ عَلى الإِطلاقِ قَد نالِ رِفدَهُ",111,"ه",1,0],["وإنَّ جفوني ما تلاقت وراءكم","ولا غمضت إِلا على دمعةٍ تبدو",112,"د",2,0],["وإِنَّ جفوني ما تلاقت وراءكم","وغمضت إِلا على دمعةٍ تبدو",112,"د",2,0],["وإن جانبت أرضى سحائب جوده","فكم سحبت حولي ذيول الحيا قشبا",113,"ب",2,0],["وَإِن جادَ قالوا مُسرِفٌ وَمُبَذِّرٌ","وَإِن لَم يَجُد قالوا شَحيحٌ وَباخِلُ",114,"ل",1,0],["وَإِنَّ جَليلَ الخَطبِ عِندي لَهَيِّنٌ","إِذا لَزِمت دارَ اِبن عَمّي عَقارِبُهْ",115,"ب",2,0],["وَإِن جَعَلَت فَوقَ الأريكِ مَقيلَها","رِجالٌ فَسَل عَنهُ رِجالَ الأَوارِكِ",116,"ك",1,0],["وَإن جادَ بَذَّ المَرثدِيِّينَ جُودُهُ","وَأَنسى بَني الآمالِ جُودَ البَرامِكِ",116,"ك",1,0],["وَإِن جاءَ يَوماً نازِلاً لِهَوانِهِ","تَلَقّاهُ مِنهُ بِالإِقامَةِ وَالنُزلِ",117,"ل",1,0],["وإنْ جهلوا وهلمتَ انفردْتَ","بأخذِ الفضيلة بعد الزِّحام",118,"م",1,0],["وإن جاد قالوا أحمقٌ ومبذِّر","وإِن لم يَجُد قالوا شحيح وباخل",119,"ل",1,0],["وَاِنجلى عن قُلوبهم كلُّ غيمٍ","مِن ضلالٍ وَزالت الغمّاءُ",120,"ا",2,0],["وانجابَ ظلُّ الأنسِ فهو مقلَّصٌ","وامتدَّ ليلُ الخطب فهو تمام",121,"م",1,0],["وانجلتْ لواحظها","فانجلى لهُ العطبُ",122,"ب",1,0],["وانجو من اليوم الشديد عقابه","اذا ما الجيال الشامخات غدت عهنا",123,"ن",2,0],["وان جودك جود غير مكتسب","عليه قد دلت الاخلاق والشيم",124,"م",1,0],["وإنْ جئتَ مَعْ باناتِ سَلْعٍ وضارجٍ","فَبَلِّغْ تحياتي لها ورسائِلي",125,"ي",1,0],["وانجلَى الغَيْمُ بعدَ ما أَضحك الرو","ضَ بكاءُ السّحابِ فيه بوبْلِ",126,"ل",1,0],["وأنْجُم الجوزاء لم تغوِّر","كأنها تحت الرواق الأخضرِ",127,"ر",1,0],["وأن جميع الكافرين مصيرُهُمْ","إلى النار في يوم القيامة والحشر",128,"ر",1,0],["وأن جميع الغَيبِ لله وحدَه","تباركَ من ربّ ومن صَمَد وَتْر",128,"ر",1,0],["وأنجلى الغيمُ عن هلالٍ تبدّى","في يد الأُفْق مثلَ نصف سِوارِ",129,"ر",1,0],["وإن جهاد المسلمين عدوهم","لفرض وقرن الشمس في الغرب يطلع",130,"ع",1,0],["وإن جرى ذكر سلع في مسامعه","فإنه لدواعي وجده سبب",131,"ب",1,0],["وَإِن جِئتَ يَوماً إِلى بابِهِ","لِأَمرٍ عَرى أَو مُهِمٍّ طَرَق",132,"ق",1,0],["وَأَنجَحَ مَسعى طالِبي الحاجِ عِندَهُ","وَما كُلُّ مَسعى طالِبي الحاجِ يَنجَحُ",133,"ح",1,0],["وَأَنْجِدِي عَبْدَكِ فِي","حَرْبِ عِدىً يَقْلُونَهْ",134,"ن",2,0],["وَأَنْجَبُوا بِإِمَامٍ","أَبْدَى سَنَاهُ بِضَعْفِ",135,"ف",1,0],["وإن جئتَهُ بالمدح يلقاك باللَّهَى","فكم مرةٍ قد قابل النظم بالنثرِ",136,"ر",1,0],["وإن جزتما روضاً صَباه تنفّست","بألطف أنفاسٍ وأزكى روائح",137,"ح",1,0],["وَأَنجَينَ مَن أَبقَينَ مِنّا بِخُطَّةٍ","مِنَ العُذرِ لَم يَدنَس وَإِن كانَ مُؤلَما",138,"م",2,0],["وانجم ليل ولكنني اراقب","منهن مرأى شنيعا",139,"ع",2,0],["وإن جنيتُك أذكرْ غادةً حملَت","من الأزاهِر أشكالاً وألوانا",140,"ن",2,0],["وان جَفاك صديق أونب زمن","فحسبك اللَيل وَالبزل المَراسيل",141,"ل",1,0],["وأَنْجَزَتِ الأَيَّامُ دَيْناً لَوَتْ بِهِ","وَدَيْنُ المُنَى فِي مَقطَعِ الحَقِّ لا يُلْوَى",142,"و",2,0],["وانْجَابَتِ الحَرَكاتُ عَنْ إسْكانِهِ","ما بَيْنَ أجْداثٍ وبَيْنَ رِمَامِ",143,"م",1,0],["وَإِن جُدْتَ فِيها بِأَقْلامِه","جَمَعْتَ الذَّوابِلَ فِي مَلْحَمَهْ",144,"م",2,0],["وَإِن جَنَحَت لِلسِلمِ وَالصُلحِ نَفسُهُ","أَبى لَحظُهُ مَيلاً إِلى السِلمِ وَالصُلحِ",145,"ح",1,0],["وَأَنجدَ الأَصحابا","إِن رَيبُ دَهرٍ رابا",146,"ب",2,0],["وإِن جلَّ خَطبي في هواكم فمخلصي","إِذا عَظُم الخطبُ الجنابُ المعظَّمُ",147,"م",1,0],["وإِن جَلاها بلا مزجٍ مُشَعشعُها","يَكادُ من لهبِ اللألاءِ يَحتَرِقُ",148,"ق",1,0],["وإنْ جادلتَ في أمرٍ فَأجْمِلْ","فما استقْصى كريمٌ في الجدال",149,"ل",1,0],["وَاِنجي فَإِنّي إِخالُ الناسَ في نَكَصٍ","وَأَنَّ يَحيى غِياثُ الناسِ وَالعُصُرُ",150,"ر",1,0],["وإن جاد لم يخجل لجود يمينه","سوى السحب لما أن تصوب غزارها",151,"ر",3,0],["وَاِنجذاب لربّه واِدّكارٌ","في عوادٍ يشغلن ملء الزمانِ",152,"ن",1,0],["وَاِنجَلى منهُ على خدّ أسيل","ماءُ حسنٍ جالَ في نارٍ تُشَب",153,"ب",1,0],["وَأنجز الدّهر لي وَعداً يماطلني","بهِ ولولاك ما أوفى وَلا وَعدا",154,"د",2,0],["وَإِن جابهت فضلي بصفحة مُعرض","ولمحة ذي غض أذمّ له ذبّا",155,"ب",2,0],["وَإنّ جمال العذر في أعينِ الرضا","لمقتحم إن جابَه العفوَ والعتبا",155,"ب",2,0],["وَإِن جَرِبَت بَواطِنُ حالِبَيهِ","فَإِنَّ العَرَّ يَشفيهِ الهِناءُ",156,"ا",2,0],["وَإِن جاهَدتَهُ بِالخَبارِ اِنبَرى لَها","بِذاوٍ وَإِن يَهبِط بِهِ السَهلُ يَمعَجِ",157,"ج",1,0],["وَإِنجيلي عَلى صَدري وَكَفّي","بِها كَأسي وَقَدَّ يَسي سَطيحُ",158,"ح",1,0],["وَإِن جست الأَوتار تصلح شَأنها","سَمعت لَها صَوت العَليل إِذا أَنّا",159,"ن",2,0],["وإنْ جَرَّدْتَه في وجهِ خطْبٍ","تَجرَّدَ باترُ الحَدَّيْنِ صارم",160,"م",1,0],["وإن جُنَّ في جانبي صَرْفُه","فلا غَرْو أن يُصِلحَ السَّهمَ فُوق",161,"ق",1,0],["وَإِنَّ جَناياتِ العِدا لَكَبيرَةٌ","وَأَكبَرُها ما قَد جَناهُ الحَبائِبُ",162,"ب",1,0],["وَإِن جَمُدَت فيهِ العُيونُ فَرُبَّما","تُلِحُّ عَلَيهِ في البُكاءِ قُلوبُ",163,"ب",1,0],["وَاِنجَلَت مِصرُ إِذ تَجَلّى عَروساً","وَكَأَنَّ الأَهرامَ فيها نُهودُ",164,"د",1,0],["وإن جلسَ الأقوامُ عَن واجِبِ النَّدى","وحقِّ العَطايا كانَ أوَّلَ قائِمِ",165,"م",1,0],["وإنَّ جَوهرَ قَولي","من فِعلِه لَبَسيطُ",166,"ط",1,0],["وإن جرى حادثٌ جرت يده","يلحقُ فيه اليراعُ بالجردِ",167,"د",1,0],["وانجدوني لدى الشفيعة إني","في حماها الرحيب صرت نزيلا",168,"ل",2,0],["وَأَنجِب بِهِ مِن آلِ نَصرٍ سَمَيدَعٍ","أَغَرَّ كَلَونِ الهُندُوانِيَّ رَونَقِ",169,"ق",1,0],["وانجلتْ ساحةُ الخداعِ لتُبدي","لضحايا الأَوهام ذئباً خَؤُونا",170,"ن",2,0],["وإنّ جميل الصبر فيكم لَعادةٌ","إذا جار حُكمْ الحادثات أو اعْتدى",171,"د",2,0],["وإِنْ جاءَتْكَ خاطبةً فأعرِضْ","وقُلْ مَهْلاً فما أنا مِنْ رجالِكْ",172,"ك",1,0],["وإن جعلت صدره مؤخراً","أصبح كل الناس تحت ظله",173,"ل",2,0],["وإن جاءهم فيه الدليل موافقاً","لما كان للآبا إليه ذهاب",174,"ب",1,0],["وإنْ جاشَ طوفانُ الهَلاكِ فإنَّني","هنالِكَ نوحٌ واعتِزالِيَ كالفُلْكِ",175,"ك",1,0],["وأنجمُه تبدو كأعشارِ عَسْجَدٍ","تضمَّنَها في الجَوِّ جامِعُ قار",176,"ر",1,0],["وانجاب عَن فوديَّ لَيل الصِبا","لِكُلِّ لَيلٍ مُدلَهِمٍّ صَباح",177,"ح",1,0],["وأنَّ جارَك جارٌ للسِّمَوءَلِ لا","يَخشَى الأعادِي ولا تَغتالُه النِّقَمُ",178,"م",1,0],["وإن جَحدوا الحبَّ خوفَ الوُشاةِ","أقرّتْ بهِ أدمعٌ تَهمِلُ",179,"ل",1,0],["وإنَّ جياد الخيل عندي هو الغنى","وليس الغنى بالمال والبيض والصفر",180,"ر",1,0],["وإن جئتَنا في آخر الدهر رحمة","إذا عُدَّت الأمجاد كنت المقدما",181,"م",2,0],["وإن جاشتِ النفس من وجدها","فتعليلها بحديث المنى",182,"ا",1,0],["وَإنْ جَرَّ يَوْماً عَسْكَراً ذُو تَجَمُّعٍ","فَسَيْفُكَ فَرْداً في قتَالِكَ عَسْكَرُكْ",183,"ك",1,0],["وإن جفته غوادي المزن باخلةً","سقتهُ ما روّضت للبين أجفان",184,"ن",1,0],["وإن جفتك غوادي المزن هامية","سقاك دمع جفون جدّ منسكب",185,"ب",1,0],["وإِنْ جَزِعْتُمْ فَرُزْءٌ لا يقومُ لَهُ","فيضُ الدُّموعِ ولا يُشْفَى لَهُ وَجَعُ",186,"ع",1,0],["وإِنْ جَلَّ فينا فقدُهُ ومصابُهُ","ليبلُونا فِي الصبرِ عنهُ ويَبْلُوهُ",187,"و",2,0],["وأَنْجَبهُ لِلطَّعْنِ وَالضَّرْبِ عَمْرُهُ","وأَخْلَصَهُ لِلْجُودِ والحَمْدِ حَاتِمُهْ",188,"م",2,0],["وأَنْجَمِ أَنْواءٍ تَنْوءُ بِهَا النَّوى","وَلَيْسَ لَهَا إِلّا دُمُوعِيَ مِنْ قَطْرِ",189,"ر",1,0],["وإن جدي السعد عندك سابقاً فما","ضامني في الموقفين مضيم",190,"م",1,0],["وإن جهلت بني الأيام معرفة","فإن منطقهم شرح الجهالات",191,"ت",1,0],["وإن جثت بهم ركب المنايا","فنحن بهم مع الركب الجثاث",192,"ث",1,0],["وإن جهلت بنو الأيام قدري","فقد جهل ابن أزرٍ في المجوس",193,"س",1,0],["وإِن جمدت منا الدموع تسيلها","رعود وأبرق من الحسرات",194,"ت",1,0],["وإن جماعة قد كنت فيها","تبلغك السلام المندليا",195,"ي",2,0],["وأنجمت السماء بحيث وافى","بها البدر المنير بلا نِقاب",196,"ب",1,0],["وانجلى الصُبْحُ عن مواليد مُزنِ","أوْدَعتها ضمائِر الأفنانِ",197,"ن",1,0],["وأنجب فيها للحياة معانيا","ضخاما تعالت لا تحد وقد تنمى",198,"م",2,0],["وإن جفا بوصله فقد وفَى","بماله وفاءَ عَدلٍ محسنِ",199,"ن",1,0],["وأنجز النَّكثُ العذابَ فيهمُ","بعد اعتزالٍ منهمُ بما مُطِلْ",200,"ل",1,0],["وأنجمهم لك رعياً تضيء","فتوري وشمسُهُمُ تُشرِقُ",201,"ق",1,0],["وإن جئتَ محتلباً كفَّه","سقى من أوامك ضرعٌ دَرورُ",202,"ر",1,0],["وإن جهدتَ النفسَ في مكسَبٍ","فالمجدَ إنَّ المجدَ مكسوبُ",203,"ب",1,0],["وان جدَّ تلْقاماتُها في سَديفِها","أضَبَّ بأحْداقِ الرجالِ نسورها",204,"ر",3,0],["وإنْ جِئْتُ في وَصْفِهِ بالعُجابِ","وأحسنتُ في القولِ والخاطِرِ",205,"ر",1,0],["وإن جزتَ قبلي طريق المدى","فإني على نهجِ ذاك الجدْ",206,"د",1,0],["وإن جُليتْ إلاَّ عليك عرائسٌ","أَبى نحو زاهِ أن يدلّلها الدَلُّ",207,"ل",1,0],["وإن جاذبتهم في النديِّ عنانها","فكلُّ فتىً قيسٌ تجاذبهُ لبنى",208,"ن",2,0],["وإن جد فالدنيا به وبسيفه","تشد أواخيها ويحمى حريمها",209,"م",3,0],["وان جنحت شمسُ الأصيل حسبتها","عرائس تجلى ضمخت بخلوق",210,"ق",1,0],["وإن جلسنا إلى نادي ندىً وهدىً","فحسبنا ذكر تاج الدين من سمرِ",211,"ر",1,0],["وَأَنجُمُ النَبتِ تُجلى في قَلائِدِها","جيدُ السَحابِ الَّتي أَقمارُها البِرَكُ",212,"ك",1,0],["وَإِن جَمَحَ الزَمانُ إِلى التَصابي","فَحََّ عِنانَهُ طَوعَ الجِماحِ",213,"ح",1,0],["وَإِن جَرى مِنِّيَ ما قَد جَرى","فَالثَلمُ قَد يَحدُثُ في العَضبِ",214,"ب",1,0],["وأنجادِ حربٍ ما بدتْ جبهاتُهمْ","مِنَ النقعِ إلا وَهيْ كالأنجُمِ الزُّهرِ",215,"ر",1,0],["وانجلى الإشراك عنا","بالحبيب مولاي محمد",216,"د",1,0],["وأنجد في التطلاب يقبس مشكاة","بجدوة أنوار المواهب في القفر",217,"ر",1,0],["وإن جنى جنايةً لم يعتذر","مفوق سهما إذا شك انسمر",218,"ر",1,0],["وانجلت في الكون قطبيَّتنا","وسمت في الملك غوثيتنا",219,"ن",2,0],["وانْجِلاءِ الشُّؤُنِ من كُلِّ رَمزٍ","مَعْنَوِيٍّ في الطِّرزِ أو عَيْنِيِّ",220,"ي",1,0],["وإنْ جاءَ عنَّا ما يُوافِقُ قولَهُمْ","فخُذْهُ وإلاَّ رُدَّنا كلَّنا إِلاَّ",221,"ل",2,0],["وإنْ جالَ جَلْجالُ الجَلالَةِ جالِياً","جَلائلَ قَلبي جُلْتُ للجُلْجُلِ الجَالِي",222,"ي",1,0],["وانْجَلى لي مظهَرُ الأُنْسِ الجَليلْ","فزَوَى عنِّي عَلاقاتِ الوُجودْ",223,"د",1,0],["وأنجدُهم وأطولهم نِجاداً","وأفخرُهم وأطهرُهم إزارا",224,"ر",2,0],["وانْجِماعٌ واتِّضَاعٌ","وانْقِطاعٌ ووُصُولُ",225,"ل",1,0],["وإنْ جاءَتْكَ شِدَّاتٌ ثِقالٌ","جَعَلْتَ اللهَ للشِّدات عِدَّه",226,"ه",1,0],["وإنْ جاذَبَتْهُ بَحْثَ عِلْمٍ رُواتُهُ","رَوَى مَا تُرَوّي كُلَّ سائِلِ صَادِي",227,"ي",1,0],["وانجَلت منهم ثَنايا","بَسَمَت عنها الثُّغورُ",228,"ر",1,0],["وإن جُدتَ عنه بما يَرتجِي","فدونَكَ مُهجتَه فاحكمَا",229,"م",2,0],["وانجابَ ليلُ جَهالةٍ وَسَرت على","هَدي إِناث لِلعُلاَ وذُكورُ",230,"ر",1,0],["وإِن جاهدَت مِصرٌ بعَهدِ ملِيكِها","ففي السَّاعِد المُمتدِّ صَارمُه العَضبُ",231,"ب",1,0],["وإنْ جئتهمْ تشكو مضيضَ مُلِمَّةٍ","تَقَوْا بك مغلولَ اليدين شَباها",232,"ا",3,0],["وإنْ جرى لِيَ مدحٌ في مقالتِه","فقل لمن شاء في الأقوام يهجوني",233,"ي",1,0],["وإنْ جانبوا بعضَ الأثامِ تورُّعاً","فَأنتَ الّذي جانبتَ كلَّ أَثامِ",234,"م",1,0],["وَإِنّ جلودها تهمي نجيعاً","طلاها اليومَ بالقَطِرانِ طالي",235,"ي",1,0],["وَأَنجمُ ليلٍ ما علون طوالعاً","لأعيننا حتّى هبطن أُفولا",236,"ل",2,0],["وأنجدتُهمْ بالرّأي والرّأيُ عازبٌ","وجُدتُ لهمْ بالحزمِ والحزمُ ماطلُ",237,"ل",1,0],["وإنْ جَفَتِ الأنواءُ تُرباً فلم يزلْ","تمرّ به وهو المَجودُ المبلَّلُ",238,"ل",1,0],["وإنْ جاءها فوق أيدي الرّجال","فبالرّغم من أنفِهِ ينزلُ",239,"ل",1,0],["وأنّ جَميمَكَ لا يُخْتَلى","وأنّ قِلالك لا تُفرَعُ",240,"ع",1,0],["وَإنْ جرّ دهرٌ نحوكمْ بعضَ سعدِهِ","فَما أنتُمُ في الدّهرِ إلّا المناحسُ",241,"س",1,0],["وإنْ جَزِعتَ لأَنْ مدّت إليك يدٌ","فبالّذي عشتَ ما مُدّت إليك يَدُ",242,"د",1,0],["وإنْ جَثَموا بالتُّربِ طوعَ حِمامِهمْ","فكم جرّروا فينا ذيولَ المواكِبِ",243,"ب",1,0],["وَإِنْ جرَوْا كنتَ أَنت غُرّتَهم","سَبْقاً وَكان الحِزام واللّبَبَا",244,"ب",2,0],["وإن جهلت فما بالكفر يعذر ذو","جهل لدى الشرع والشيطان يطغيه",245,"ي",2,0],["وإن جهل الأقوام ذلك واختفى","عليهم فللتوحيد توليدهم هدم",246,"م",1,0],["وإن جهاد القلب للنفس واجب","عليهم لفتح الروح فهو المصارع",247,"ع",1,0],["وانجلت عين الوجود لنا","وسحاب الجهل منقشع",248,"ع",1,0],["وانجمع إن شئت طوراً وافترق","كيفما كنت ولا تقترح",249,"ح",1,0],["وانجلت شمسي وهم بال","جسم خلف الهضبات",250,"ت",1,0],["وإن جنَّ ديجورُ الخطوبِ تلقيَّا","دُجاهُ بصبحٍ شقَّ جيبَ ظِلالهِ",251,"ل",2,0],["وَانْجَلَى مِثْلَ انْجِلاَءِ","الغِمْدِ عِنْ مَتْنِ الحُسَامِ",252,"م",1,0],["وإن جَرَوُا في العفافِ بَذَّهُمُ","بالسَّبْقِ عودَ الجَرَاءِ قارِحُهْ",253,"ح",2,0],["وأنجز الله له من وعده","ما قد أتى على لسان جده",254,"ه",1,0],["وإِن جفَّ فيكَ دمٌ واحدٌ","فقد سَالَ من مُقْلَتَيَّ دِمَاءُ",255,"ا",2,0],["وَإِنْ جِئْتُ أَبْغي وَصْلَهُ زَادَ صَدَّهُ","كَأَنِّي منُ هِجْرانِهِ اسْتَزِيدُهُ",256,"د",2,0],["وَإِنْ جُلِيَتْ بِوَجْنَتِهِ مُدامٌ","يُرى لِعذارهِ دَوْرٌ وَنَزْلُ",257,"ل",1,0]]}