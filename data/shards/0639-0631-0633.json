{"poems":[[80,"من للملوك بشأو الأصيد البطل","https://www.aldiwan.net/poem14155.html","البسيط"],[87,"الضلوع تتقد","https://www.aldiwan.net/poem62893.html","المقتضب"],[71,"لي صديق صنان إبطيه صعب","https://www.aldiwan.net/poem28429.html","الخفيف"],[107,"لك يا شهيد الحق قام المأتم","https://www.aldiwan.net/poem42059.html","الكامل"],[107,"إن جل غنم المسلمين بخيبر","https://www.aldiwan.net/poem44059.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55071","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54907","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54666","الكامل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142005","البسيط"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141998","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141987","الرمل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141971","الخفيف"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141965","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54324","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54248","البسيط"],[108,"ظلال الثورة مصر وسوريا","https://www.poetsgate.com/ViewPoem.aspx?id=179583",""],[96,"مصرع الشمس","https://www.poetsgate.com/ViewPoem.aspx?id=12923",""],[96,"دمعة على الشام","https://www.poetsgate.com/ViewPoem.aspx?id=12814",""],[121,"مسقط","https://www.aldiwan.net/poem24041.html","الخفيف"],[190,"عرسك من نفسك موصولة","https://www.aldiwan.net/poem43962.html","السريع"],[210,"بشرى فهذا المنى والفضل والشرف","https://www.aldiwan.net/poem915.html",""],[210,"مهلاً فهذا المنى قد جاء والوطر","https://www.aldiwan.net/poem917.html",""],[237,"وبمهجتي من زارني","https://www.aldiwan.net/poem14821.html","مجزوء الكامل"],[266,"نفيس أماني القلب والعين والنفس","https://www.aldiwan.net/poem38254.html","الطويل"],[295,"يا ليالينا بوادي السلط قد","https://www.aldiwan.net/poem11711.html","الرمل"],[350,"أمن الجميع بذي البقاع ربوع","https://www.aldiwan.net/poem4472.html","الكامل"],[371,"قم فاسقني مما تروق","https://www.aldiwan.net/poem17235.html","مجزوء الكامل"],[415,"كيف أنساك يا أبا بكر أم كيغف","https://www.aldiwan.net/poem31853.html","الخفيف"],[438,"عرس بالتوفيق والسعد","https://www.aldiwan.net/poem12394.html","السريع"],[466,"رفقا بها يا أيها الزاجر","https://www.aldiwan.net/poem16434.html","السريع"],[469,"هي دار مية يا طليق العدل","https://www.aldiwan.net/poem3282.html","عموديه"],[469,"أهلاً بطيف زار بعد جفائه","https://www.aldiwan.net/poem3611.html","عموديه"],[543,"هل أريك النجوم صارت بدورا","https://www.aldiwan.net/poem48187.html","عموديه"],[580,"عرسكم يأيها الشرب طالق","https://www.aldiwan.net/poem2733.html","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48642","الكامل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25329","الرجز"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55995","الكامل"],[1224,"","https://poetry.dctabudhabi.ae/diwan/poem/130644","الكامل"],[440,"","https://poetry.dctabudhabi.ae/diwan/poem/47449","الرمل"],[1460,"","https://poetry.dctabudhabi.ae/diwan/poem/1898","الكامل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79852","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79845","الخفيف"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100991","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53080","الخفيف"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109463","الخفيف"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109454","الرمل"],[2300,"","https://poetry.dctabudhabi.ae/diwan/poem/97807","المنسرح"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110614","الرمل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67212","الرمل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102660","الرجز"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109881","الكامل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/53009","الرجز"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123945","السريع"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109977","الكامل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40100","البسيط"],[3949,"","https://poetry.dctabudhabi.ae/diwan/poem/127769","الطويل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107521","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86460","الكامل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127197","الرجز"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91002","الرمل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90831","الرمل"],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117298","الرمل"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104893","البسيط"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139486",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139696",""],[4857,"الشاعر الخشن","https://www.poetsgate.com/ViewPoem.aspx?id=53888",""],[4858,"حافلة الموت","https://www.poetsgate.com/ViewPoem.aspx?id=138780",""],[4858,"عرسُ الشّهادة في مدينة جنين","https://www.poetsgate.com/ViewPoem.aspx?id=159593",""],[4927,"أم العيون السود","https://www.poetsgate.com/ViewPoem.aspx?id=12984",""],[4927,"قصيدة لعيني عُروة وعَفْراء","https://www.poetsgate.com/ViewPoem.aspx?id=29954",""],[5232,"شموخ الأرز","https://www.poetsgate.com/ViewPoem.aspx?id=212986",""],[5239,"عرس بجزين يا مستعبد النجف","https://www.poetsgate.com/ViewPoem.aspx?id=190941",""],[5296,"أماه لا تبكي","https://www.poetsgate.com/ViewPoem.aspx?id=152482",""],[5431,"كم مسنا الضر ياحنان انت لها","https://www.poetsgate.com/ViewPoem.aspx?id=189875",""],[5431,"قصيدة وجودية ...","https://www.poetsgate.com/ViewPoem.aspx?id=207830",""],[5533,"دَرْبُ الشَّهِيدِ مَنارَةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=176474",""],[5582,"سُلطانُ لا زِلْتَ فِي عَلْياكَ سُلْطانا","https://www.poetsgate.com/ViewPoem.aspx?id=187305",""],[5605,"ستُونَ عَامًا","https://www.poetsgate.com/ViewPoem.aspx?id=160307",""],[5628,"الى صاحب برج العذراء في ليلة زفافه","https://www.poetsgate.com/ViewPoem.aspx?id=178467",""],[5776,"فهارس الفراغ","https://www.poetsgate.com/ViewPoem.aspx?id=199335",""],[5829,"ربيع الكشافة","https://www.poetsgate.com/ViewPoem.aspx?id=161988",""],[5854,"همًّ تعرّاني فبتُّ أسِيفا ((اعتذار إلى أخ حبيب))","https://www.poetsgate.com/ViewPoem.aspx?id=191828",""],[5861,"زفوا بشائر نصرنا","https://www.poetsgate.com/ViewPoem.aspx?id=190010",""],[6134,"يا فاضلاً للفخر جئت مكملاً","https://www.poetsgate.com/ViewPoem.aspx?id=169538",""],[6171,"عُرسُ الوطن","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86324&r=&rc=7",""],[6198,"عرس الطبيعة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79233&r=&rc=7",""],[6218,"الخزيُ للشعراء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=65910&r=&rc=63",""]],"verses":[["عِرسُ المُلوك لَنا في قَصرِها عُرُسٌ","كُلّ المُلوك بِهِ في مَأتَم الوَجَلِ",0,"ل",1,0],["عُرسُهُ وَمَأتَمُهُ","غايَتاهُما نَفَدُ",1,"د",1,0],["عرسُهُ منْ صنانِهِ شابَ قرنا","ها فقالتْ بَعلي تأبَّطَ شرَّا",2,"ر",2,0],["عُرسٌ أُتِيحَ لنا وما مِن رِيبةٍ","في العُرسِ يَجرِي في نَواحيهِ الدَّمُ",3,"م",1,0],["عُرْسُ النبيِّ وأيُّ عُرسٍ مِثلُه","هَيهاتَ تلك فضيلةٌ لا تُنْكَرُ",4,"ر",1,0],["عُرْسٌ مُدَلَّهَةٌ وَأُمٌّ ثاكِلٌ","وَشَقِيقَةٌ مَحْزُونَةٌ وَشَقِيقُ",5,"ق",1,0],["عُرْسٌ لَهُ فِي كُلِّ مُجْتَمَعٍ صَدى","وَبِهِ تَجَاوَبَتِ الْبِلادُ سُرُورَا",6,"ر",2,0],["عُرْسٌ بِهِ جَمَعَ النَّقِيُّ مِنَ الهَوَى","زَيْنَ الشَّبَابِ وَزَيْنَةَ الفَتَيَاتِ",7,"ت",1,1],["عرسٌ أهازيجهُ حمرٌ وأكؤسهُ","يرويك مغتبقا منها ومصطبحا",8,"ح",2,0],["عُرسٌ ماجت البشائرُ فيه","وتوالت صبابةً وعناقا",9,"ق",2,1],["عرس الأحرار أن تسقي العدى","اكؤسا حمرا وأنغاما حزانى",10,"ن",2,0],["عرسٌ للرياض للطير للأنهار","لم يبقِ للمباهجِ مجدا",11,"د",2,0],["عُرْسٌ مِنَ الجِنِّ في الصَّحْراءِ قَدْ نَصبَوا‏‏‏","لَهُ السُّرادِقَ تَحْتَ الَّليْلِ وَالقُبَبا‏‏‏",12,"ب",2,0],["عُرْسٌ أقيمَ على الدمِ المسفوكِ","أأُرَدِّدُ الألحانَ أم أبكيكِ",13,"ك",1,1],["عُرْسُ الأمانِّي أحيا كلَّ ذي أملٍ","وطافَ بالغُلَّةِ الظَمْأَى فروَّاهَا",14,"ا",3,0],["عُرسانِ: في بنْتِ المعزِّ، وجلَّقَا","هَزَّا بلحنهما الشجيِّ المشرقَا",15,"ق",2,1],["عرس في الجنان فالحور يطفرن","على ميعة الضياء البديد",16,"د",1,0],["عرس الشام طغى عليه ظالم","فطوى البساط وحطّم الأقداحا",17,"ح",2,0],["عَرَّسَتْ في (عُمان) زُرقُ الغَوادي","وتَخُطُّ البُروقُ عَقْدَ القِرانِ",18,"ن",1,0],["عرسك من نفسك موصولة","مثل اتصال الكف بالساعد",19,"د",1,1],["عرسٌ سعيدٌ اتى بالبشر متشحاً","وبالمهابة والإجلال متصف",20,"ف",1,0],["عرس سعيد بالسّعود بدأ","طوالع المجد فيه ليس تنحصر",21,"ر",1,0],["عُرسِيَّةً ضَرَبَت طُبو","لَ رُعودِها أَيدي شَباطِ",22,"ط",1,0],["عرست به ورد الحياء بنظرة","وقبلته كيما أنال جنا غرسي",23,"س",2,0],["عرسٌ لم يشهد الدهر له","مثلاً في الأيك تطريباً ولحنا",24,"ن",2,0],["عَرَّسنَ دائِرَةَ الظَهيرَةِ بَعدَما","وَغِّرنَ وَالحَدقُ الكَنينُ خَشوعُ",25,"ع",1,0],["عرسُ المَسَرَّةِ لَيسَ في","هِ سِوى المُدامَةِ مِن مُخَلِّق",26,"ق",1,0],["عرَّسَ الأوَّلونَ والآخرُ التَّا","لي إليهِمْ عمّا قليلٍ يؤولُ",27,"ل",1,0],["عَرَّسَ بالتوفيقِ والسَّعْدِ","أَبو الوفاءِ بْنُ أَبي سَعْدِ",28,"د",1,1],["عَرِّسْ ونَمْ مُسْترسِلاً آمناً","واهْمِلْ فلا ذُعْرٌ ولا ذاعِرُ",29,"ر",1,0],["عرسٌ من اللَّذات رقت شمسهُ","طوراً مكتَّمة وطوراً تنجلى",30,"ل",2,0],["عرسٌ من الأحلام زفُّ لمقلتي","فيه زفاف البدر في ظلمائه",31,"ا",3,0],["عُرسٌ أضحى يُزري بقولٍ عتيقٍ","عُرسَ بورانَ سِلعةً لن تَبورا",32,"ر",2,0],["عَرُسُكُمُ يأَيُّها الشَّرْبُ طَالِقٌ","وإِنَ فَتَنَتْ من حُسْنِها كُلَّ مُجْتَلي",33,"ي",1,1],["عرس الإمارة عرس مصر وأهلها","والنيل إذ جارى نداك النيلا",34,"ل",2,0],["عَرِّسْ وَلَمّا تُمْنَعِ التَعْرِيسا","مِنْ صَكِّ أُخْرَى أَوْ تَقَعْ فَرِيسا",35,"س",2,0],["عرسٌ به كل الهنا","واحتاطنا الفرح المزيدْ",36,"د",1,0],["عرس لنجلكم فؤاد","للمسرة دام سرا",37,"ر",2,0],["عرس قد ابتهجت به","الدنيا وعاد العسر يسرا",37,"ر",2,0],["عِرْسُهُ مِنْ غَيْرِ ضَيْرِ","عِرْسُ زَيْدِ بْنِ عُمَيْرِ",38,"ر",1,1],["عَرَّستُهُ وَوِسادُ رَأسِيَ ساعِدٌ","خاظي البَضيعِ عُروقُهُ لَم تَدسَعِ",39,"ع",1,0],["عُرسه غادر الحواسدَ بالأم","س سكارى وما هم بسكارى",40,"ر",2,0],["عرسَ الدهرُ قبلها الذنبَ عندي","فغدا مثمراً بعفوٍ قريبِ",41,"ب",1,0],["عرس الدهر بالمنى","عند بابي وهجرا",42,"ر",2,0],["عرس زينت به الأرض والأف","ق من النقع وجهه في ارتياد",43,"د",1,0],["عُرسهُ اورد النفوس لعمري","من زلال النعيم أعذب وِرد",44,"د",1,0],["عرسه قد جعل السعد له","موسماً سر به كل سري",45,"ر",2,0],["عرس المولّي طالِق","وَالعار فيهِ لاحِق",46,"ق",1,0],["عرس من قد عرسا فوق السما","وبها كم شيدا من أغرف",47,"ف",1,0],["عرس أسنى فرقدين اتحدا","شرفا طال السهى والفرقدا",47,"د",2,0],["عرس من بحر يديه","بمذاب التبر جاري",48,"ر",2,0],["عرس فهذا منتهى المطالب","قد طنبت سفح اللوى المضارب",49,"ب",1,1],["عرس ظفرت مورخاً ببهائه","وبلغت ما بين الورى آماليا",50,"ل",3,0],["عرسُ المشير ثالثِ الأنجالِ","في غاية التبجيلِ والجمالِ",51,"ل",1,0],["عرس ركب البشر فيه فقل","عرس ابن موسى فيه قد ضمنا",52,"ن",2,0],["عَرَّستُ في أَرجاءِ حَلبةِ مجدِها","فَغِنيتُ عن عِرسٍ وعن أعراسِ",53,"س",1,0],["عُرْسُ الربيعِ الَّذي فُضَّت دَراهِمُهُ","عَلَيهِ وَاِنتَثَرَتْ فيه الدَّنانيرُ",54,"ر",1,0],["عرست بها بكراً ودرّاً نظامها","لخودٍ بدت والدرّ دمعاً تردعُ",55,"ع",1,0],["عرسٌ على الأسكندريَّةِ ضوؤُهُ","وشعاعُهُ يمتدُّ في الآفاقِ",56,"ق",1,0],["عرست والعليا يحالفك الهدى","ورحلت والتقوى يشيعك السنا",57,"ن",2,0],["عرسك يا من حبه","للروح مني قد ملك",58,"ك",1,1],["عرس في طالع السعد محا","صبحه بالصفو ليل الكدر",59,"ر",1,0],["عرس قد عطر الكون شذا","مذ بمجلاه استنار الملوان",60,"ن",1,0],["عرس الأحداج والظعن بنا","كم تطيل في طلابنا العنا",61,"ن",2,0],["عرس به الهم عاد يطوى","لابل به الميت كاد ينشر",62,"ر",1,0],["عرس فتى أبهر البرايا","في حسني منظر ومخبر",62,"ر",1,0],["عرس خدن العلا محمدٍ النّد","ب سنا الحمد نور كل سناء",63,"ا",2,0],["عرس الحسينِ أخ المجد القويم ومن","له الزمان بطوعِ منه قد خضعا",64,"ع",2,0],["عُرْسُ المَسَاءَاتِ آثارٌ تُعَدِّدُهَا","وَدَمْعَةٌ فِي مَرَايَا العَيْنِ تَأتَلِقُ",65,"ق",1,0],["عُرُسُ الصّباح رنتْ إلي","ه طفولةٌ تهوى الجديد",66,"د",1,0],["عرسُ الشّهادة في\" جنينَ\" فَخارُ","في كلِّ حينٍ ثُلّةٌ تُختارُ",67,"ر",1,1],["عُرْسُ الْحَضَاْرَةِ !! صَاْرِ فِيْهَاْ مَأْتَماً !!","يَبْكِي الْكِرَاْمُ - بِهِ - تُرَاْثَ جُدُوْدِ",68,"د",1,0],["عُرسُ الطَّبِيْعَةِ قَدْ تَلأَلأَ نُوْرُهُ","لَيْلاًº فَصَاْرَ مَسَاْؤُنَاْ إِصْبَاْحَاْ",69,"ح",2,0],["عرسُ العذارى وربَّا