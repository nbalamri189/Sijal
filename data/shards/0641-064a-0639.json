tps://poetry.dctabudhabi.ae/diwan/poem/54959","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54759","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55068","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54748","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54700","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54528","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54933","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55354","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67331","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141919","المقتضب"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199490","الرجز"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43811","المنسرح"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54208","الكامل"],[61,"","https://poetry.dctabudhabi.ae/diwan/poem/50356","السريع"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/205861","الكامل"],[106,"ظلال الثورة مصر وسوريا","https://www.poetsgate.com/ViewPoem.aspx?id=179583",""],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[106,"بين عهدين","https://www.poetsgate.com/ViewPoem.aspx?id=179345",""],[77,"إذا أنا لم أوثر هواي على عزمي","https://www.poetsgate.com/ViewPoem.aspx?id=34203",""],[100,"فارس الاصطياف","https://www.poetsgate.com/ViewPoem.aspx?id=50417",""],[9,"أصَرَمْتَ حَبْلَكَ مِنْ لَمِي س","https://www.poetsgate.com/ViewPoem.aspx?id=20020",""],[99,"أنا يا صديقتي متعب بعروبتي","https://www.poetsgate.com/ViewPoem.aspx?id=24608",""]],"verses":[["في عانَةٍ تُطيعُهُ مُحامِياً","فَإِن رَآها شُرَّداً أَطاعَها",0,"ع",3,0],["في عُصبَةٍ جُنِبوا إِلى آجالِهِم","وَالدَهرُ يُعجِلُهُم عَنِ الإِروادِ",1,"د",1,0],["في عَذارى بِجَلابي","بِ الدُّجَى مُعتَجِراتِ",2,"ت",1,0],["في عُصَبٍ يُضْني الكَريمَ قُرْبُهُمْ","وشرُّ أدْوائِكَ ما فيهِ الضّنى",3,"ا",1,0],["فَيُعْفَى عَنِ الأَوْزَارِ فِي ذَلِكَ الْحِمَى","وَتُغْتَفَرُ الآَثَامُ فِي ذَلِكَ اللَّتْمِ",4,"م",1,0],["فِي عَارضِ التَّيْسِ لِي شِفَاءٌ","فَكَيْفَ فِي عَارِضِ الْغَزَالِ",5,"ل",1,0],["فِي عَسْكَرٍ لَجِبٍ كَأَنَّ جُمُوعَهُ","فَوْق الْوِهَادِ إِذَا زَحَفْنَ سُيُولُ",6,"ل",1,0],["فيُعيدُ ذاكَ الماءَ ذائِبَ فِضّةٍ","ويُعيدُ ذاكَ التّرْبَ ذوْبَ نُضارِ",7,"ر",1,0],["في عازِبٍ وَسَميِّ شَه","رٍ لَن يُعَزِّبَني مَصابُه",8,"ب",2,0],["في عارِضٍ مِن وائِلٍ إِن تَلقَهُ","يَومَ الهِياجِ يَكُن مَسيرُكَ أَنكَدا",9,"د",2,0],["في عُصبَةٍ مِن قُرَيشٍ قالَ قائِلُهُم","بِبَطنِ مَكَّةَ لَمّا أَسَلَموا زولوا",10,"ل",3,0],["فَيَعلَمَ النيلُ أَنّا خَيرُ مَن وَرَدوا","وَيَستَطيلَ اِختِيالاً ذَلِكَ الهَرَمُ",11,"م",1,0],["في عيدِ مَولانا الصَغي","رِ وَعيدِ مَولانا الكَبيرِ",12,"ر",1,1],["في عشيشة الرهبان لكن","لا صلاة ولا صيام",13,"م",1,0],["فِي عُودِ دَوُدَ الَّذِي خَلَبَ النُّهَى","مَا فِيهِ مِنْ ذَاكَ الصَّدَى الرَّنَّانِ",14,"ن",1,0],["في عَرضِهَا عِظَةٌ عَلَى تَكْرَارِهَا","تَزْكُو وَإنْ تَكُ مِلءَ كُلِّ جَنَانِ",15,"ن",1,0],["فِي عَزِيزٍ بَنَى مِنَ الجَاهِ صَرْحاً","لَمْ يُطَاوِلْ بُنْيَانَهُ بُنْيَانُ",16,"ن",1,0],["فِي عَصْرِنَا لِلضَّادِ فَتْحٌ بَاهِرٌ","زَيدَتْ بِهِ فَخْراً فَهَلْ مِنْ مَأْثَمِ",17,"م",1,0],["فِي عِزَّةِ المُلْكِ غَيرَ أَنَّ بِهِ","لِكُلِّ حَالٍ نَشَاطِ مُعْتَزِمِ",18,"م",1,0],["فِي عَهْدِ مَرْجُوِّ المَثُوبَةِ","عامِلٌ وَلَّى وَعالِمْ",19,"م",1,0],["في عهد فيصلنا المعظّم انشئت","علماً يشير لأشرف الأهداف",20,"ف",1,0],["في عينه حور في ثغره شنب","يفترّ عن عقد دّرٍ وسط مرجان",21,"ن",1,0],["في عُقَدٍ من هَواي مُحكَمَةٍ","ظُوهِرَ منها العِنَاجُ والكَرَبُ",22,"ب",1,0],["في عمر نوح لأن الفال أفهمنا","لما أتى جودك الأوفى بطوفانِ",23,"ن",1,0],["في عصبة عادلة في الحكم","وغلمة مثل بدور التمّ",24,"م",1,0],["فَيُعْجِزُ الحيلةَ منْزُورُها","إلا إذا ما أنا لطَّفْتُها",25,"ت",3,0],["في عض خدٍّ ولثم ثغرٍ","ورشف ريقٍ وشرب راحِ",26,"ح",1,0],["فَيَعذبُ لي مِلْحٌ من العيْشِ آسِنٌ","ويَسْهُلُ لي وعْرٌ من الدهر قَرْدَدٌ",27,"د",1,0],["فَيُعْمونَ من شئت في ساعة","ولم يَحْتسبْ قَطُّ أن يَرْمَدا",28,"د",2,0],["فيُعرضُ عنه السامعونَ وإنني","لذو المذهب المحمود والمنطق الجزلِ",29,"ل",1,0],["في عانَةٍ بِجُنوبِ السِيِّ مَشرَبُها","غَورٌ وَمَصدَرُها عَن مائِها نُجُدُ",30,"د",1,0],["في عارِضٍ مِن كِلابٍ يُبرِقونَ إِذا","نالَ الأَعادِيَ مِنهُم فَيلَقٌ هَبَروا",31,"ر",3,0],["في عارِضٍ مِن كِلابٍ يُبرِقونَ إِذا","صابَ الأَعادِيَ مِنهُم وابِلٌ قُشِروا",32,"ر",3,0],["في عانَةٍ رَعَتِ الأَوعارَ صَيفَتَها","حَتّى إِذا زَهِمَ الأَكفالُ وَالسُرَرُ",33,"ر",1,0],["في عُيونِ الأَنامِ عَنكِ نُبوٌّ","لَم يَكُن في العُيونِ لَو لَم تُسائي",34,"ا",2,0],["فَيَعلَقَ في أَثوابِكُم مِن تُرابِهِ","شَذا المِسكِ مَهما يُغسَلِ الثَوبُ يَسطَعِ",35,"ع",1,0],["في عهده صار يُبكى الحيفُ أعيننا","دماً ويضحكه ما كان يبكينا",36,"ن",2,0],["في عَلاليك من فنون المعالي","ما بفحواه عَيَّت الشعراء",37,"ا",2,0],["في عالم شد الرحال نزيله","وخيال دنيا ذاهب من جاءها",38,"ا",3,0],["في عالَمٍ صَحِبَ الحَياةَ مُقَيَّداً","بِالفَردِ مَخزوماً بِهِ مَغلولا",39,"ل",2,0],["في عالَمٍ سُكّانُهُ أَنفاسُهُم","طيبٌ وَهَمسُ حَديثِهِم إِنجيلُ",40,"ل",1,0],["في عَدلِ فاتِحِهِم وَقانونِيِّهِم","ما يَحتَذي الخُلَفاءُ حَذوَ مِثالِهِ",41,"ل",2,0],["فيعثُرُ ما بينَ السؤالِ ورجعهِ","لساني بكم حتَّى ينُمَّ بحالي",42,"ي",1,0],["في عارِضٍ يَدِقُ الرَدى أَلهَبتَهُ","بِصَواعِقِ العَزَماتِ وَالآراءِ",43,"ا",2,0],["في عارِضٍ تَعرِضُ أَجوازُهُ","بَينَ سُوى خَبتِ فَرمَلِ الشُقوق",44,"ق",1,0],["فيُعطي الرَّغائبَ منصورُنا","ويُدمي التَّرائبَ سَفَّاحُنا",45,"ن",2,0],["في عانَةٍ بَذَلَ العِهادُ لَها","وَسمِيَّ غَيثٍ صادِقِ النَجمِ",46,"م",1,0],["في عِدادِ المَوتى وَفي ساكِني الدُن","يا أَبو جَعفَرٍ أَخي وَخَليلي",47,"ي",1,1],["فَيُعفيني قُبولُكَ عَن جَوابٍ","إِذا يُتلى نَقُصتُ بِهِ وَزادا",48,"د",2,0],["في عابر النسمات مرتجفاً","في النجم فضض صفحة الماء",49,"ا",2,0],["في عباب غامض التيار يجري","واصلاً ما بين عينيك وعمري",50,"ي",1,0],["في عَذاةٍ مَهضوبَةٍ كانَ فيها","ناضِرُ الرَوضِ لِلسَحابِ نَديما",51,"م",2,0],["في عتيقٍ منْ مدامٍ","وجديدٍ من عِذارِ",52,"ر",1,0],["فيعبرونَ مدى الكتَّابِ إنْ كتبوا","وينشرون فتى الخطَّابِ أنْ خطبوا",53,"ب",3,0],["في عِمَّةٍ خَلَعَت عَلَيهِ كَلِ