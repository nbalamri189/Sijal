ام أن تتجنى","https://www.aldiwan.net/poem55839.html","الخفيف"],[456,"لها كل يوم نشطة وعقال","https://www.aldiwan.net/poem55906.html","الطويل"],[456,"سلا من سلا من بنا استبدلا","https://www.aldiwan.net/poem56005.html","المتقارب"],[456,"أعينوني على طلب المعالي","https://www.aldiwan.net/poem56066.html","الوافر"],[456,"هل تقبلون إنابة الدهر","https://www.aldiwan.net/poem56194.html","أحذ الكامل"],[456,"لمن الحمول بجو ضاحي","https://www.aldiwan.net/poem56255.html","مجزوء الكامل"],[456,"هل عند عينيك على غرب","https://www.aldiwan.net/poem56286.html","السريع"],[459,"خفضا لا موت الا بأجل","https://www.aldiwan.net/poem15467.html","الرمل"],[459,"نبأ عاد له الصبح دجى","https://www.aldiwan.net/poem16016.html","الرمل"],[459,"وعلى الأيام من نعمائه","https://www.aldiwan.net/poem16075.html","الرمل"],[462,"جزعت وأين سبيل الجلد","https://www.aldiwan.net/poem3142.html","عموديه"],[462,"أإن بعدت لمياء والإلف ينزح","https://www.aldiwan.net/poem3417.html","عموديه"],[475,"حقيق بأن يبكي الديار غريبها","https://www.aldiwan.net/poem15295.html","الطويل"],[477,"الحب داء دفين","https://www.aldiwan.net/poem36935.html","المجتث"],[477,"بشراكمو بازديادي","https://www.aldiwan.net/poem37053.html","المجتث"],[491,"في عارض ضاقت الأرض الفسيحة عن","https://www.aldiwan.net/poem67325.html","البسيط"],[493,"دعا فأجابه القدح","https://www.aldiwan.net/poem9811.html","مجزوء الوافر"],[498,"حب النبي الهاشمي ديني","https://www.aldiwan.net/poem37768.html","الرجز"],[503,"تائية القافلة","https://www.aldiwan.net/poem27889.html","البسيط"],[503,"الأجير","https://www.aldiwan.net/poem56765.html","البسيط"],[511,"لا تلزمني في رعي الهوى سرفا","https://www.aldiwan.net/poem67791.html","البسيط"],[536,"بما بيننا من حرمة ايها الصحب","https://www.aldiwan.net/poem48303.html","عموديه"],[549,"يوم الحمى ما أنت من همي","https://www.aldiwan.net/poem47212.html","أحذ الكامل"],[549,"يا طيف ألا زرتنا بسواد","https://www.aldiwan.net/poem47852.html","الكامل"],[551,"استمطر العين أن أحبابه احتملوا","https://www.aldiwan.net/poem68393.html","البسيط"],[556,"أدر صرفا خمور الأندرينا","https://www.aldiwan.net/poem33755.html","الوافر"],[556,"ما لابن مريم في تلك الأساطين","https://www.aldiwan.net/poem33794.html","البسيط"],[556,"الحمد لله لا جاه ولا مال","https://www.aldiwan.net/poem34213.html","البسيط"],[556,"يشف ثوب عنه لي مخيط","https://www.aldiwan.net/poem34404.html","الرجز"],[556,"كلامنا غير ما تعطى العبارات","https://www.aldiwan.net/poem34718.html","البسيط"],[559,"تطاول الليل على من لم ينم","https://www.aldiwan.net/poem27846.html","الرجز"],[560,"في عهد عبد العزيز المستغاث به","https://www.aldiwan.net/poem52555.html","البسيط"],[560,"ماذا التعلل في دنياك بالأمل","https://www.aldiwan.net/poem52780.html","البسيط"],[560,"بناء العلى بين القنا والبوارق","https://www.aldiwan.net/poem52969.html","الطويل"],[562,"سرور المعالي عاد والعود اجمل","https://www.aldiwan.net/poem884.html",""],[565,"له شغل عن سؤال الطلل","https://www.aldiwan.net/poem69529.html","المتقارب"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[571,"بشراي دالت دولة المعصوم","https://www.aldiwan.net/poem3641.html","الكامل"],[573,"سجا ليل همي بالعذار الذي سجا","https://www.aldiwan.net/poem3092.html","الطويل"]],"verses":[["في عانَةٍ تُطيعُهُ مُحامِياً","فَإِن رَآها شُرَّداً أَطاعَها",0,"ع",3,0],["في عُصبَةٍ جُنِبوا إِلى آجالِهِم","وَالدَهرُ يُعجِلُهُم عَنِ الإِروادِ",1,"د",1,0],["في عَذارى بِجَلابي","بِ الدُّجَى مُعتَجِراتِ",2,"ت",1,0],["في عُصَبٍ يُضْني الكَريمَ قُرْبُهُمْ","وشرُّ أدْوائِكَ ما فيهِ الضّنى",3,"ا",1,0],["فَيُعْفَى عَنِ الأَوْزَارِ فِي ذَلِكَ الْحِمَى","وَتُغْتَفَرُ الآَثَامُ فِي ذَلِكَ اللَّتْمِ",4,"م",1,0],["فِي عَارضِ التَّيْسِ لِي شِفَاءٌ","فَكَيْفَ فِي عَارِضِ الْغَزَالِ",5,"ل",1,0],["فِي عَسْكَرٍ لَجِبٍ كَأَنَّ جُمُوعَهُ","فَوْق الْوِهَادِ إِذَا زَحَفْنَ سُيُولُ",6,"ل",1,0],["فيُعيدُ ذاكَ الماءَ ذائِبَ فِضّةٍ","ويُعيدُ ذاكَ التّرْبَ ذوْبَ نُضارِ",7,"ر",1,0],["في عازِبٍ وَسَميِّ شَه","رٍ لَن يُعَزِّبَني مَصابُه",8,"ب",2,0],["في عارِضٍ مِن وائِلٍ إِن تَلقَهُ","يَومَ الهِياجِ يَكُن مَسيرُكَ أَنكَدا",9,"د",2,0],["في عُصبَةٍ مِن قُرَيشٍ قالَ قائِلُهُم","بِبَطنِ مَكَّةَ لَمّا أَسَلَموا زولوا",10,"ل",3,0],["فَيَعلَمَ النيلُ أَنّا خَيرُ مَن وَرَدوا","وَيَستَطيلَ اِختِيالاً ذَلِكَ الهَرَمُ",11,"م",1,0],["في عيدِ مَولانا الصَغي","رِ وَعيدِ مَولانا الكَبيرِ",12,"ر",1,1],["في عشيشة الرهبان لكن","لا صلاة ولا صيام",13,"م",1,0],["فِي عُودِ دَوُدَ الَّذِي خَلَبَ النُّهَى","مَا فِيهِ مِنْ ذَاكَ الصَّدَى الرَّنَّانِ",14,"ن",1,0],["في عَرضِهَا عِظَةٌ عَلَى تَكْرَارِهَا","تَزْكُو وَإنْ تَكُ مِلءَ كُلِّ جَنَانِ",15,"ن",1,0],["فِي عَزِيزٍ بَنَى مِنَ الجَاهِ صَرْحاً","لَمْ يُطَاوِلْ بُنْيَانَهُ بُنْيَانُ",16,"ن",1,0],["فِي عَصْرِنَا لِلضَّادِ فَتْحٌ بَاهِرٌ","زَيدَتْ بِهِ فَخْراً فَهَلْ مِنْ مَأْثَمِ",17,"م",1,0],["فِي عِزَّةِ المُلْكِ غَيرَ أَنَّ بِهِ","لِكُلِّ حَالٍ نَشَاطِ مُعْتَزِمِ",18,"م",1,0],["فِي عَهْدِ مَرْجُوِّ المَثُوبَةِ","عامِلٌ وَلَّى وَعالِمْ",19,"م",1,0],["في عهد فيصلنا المعظّم انشئت","علماً يشير لأشرف الأهداف",20,"ف",1,0],["في عينه حور في ثغره شنب","يفترّ عن عقد دّرٍ وسط مرجان",21,"ن",1,0],["في عُقَدٍ من هَواي مُحكَمَةٍ","ظُوهِرَ منها العِنَاجُ والكَرَبُ",22,"ب",1,0],["في عمر نوح لأن الفال أفهمنا","لما أتى جودك الأوفى بطوفانِ",23,"ن",1,0],["في عصبة عادلة في الحكم","وغلمة مثل بدور التمّ",24,"م",1,0],["فَيُعْجِزُ الحيلةَ منْزُورُها","إلا إذا ما أنا لطَّفْتُها",25,"ت",3,0],["في عض خدٍّ ولثم ثغرٍ","ورشف ريقٍ وشرب راحِ",26,"ح",1,0],["فَيَعذبُ لي مِلْحٌ من العيْشِ آسِنٌ","ويَسْهُلُ لي وعْرٌ من الدهر قَرْدَدٌ",27,"د",1,0],["فَيُعْمونَ من شئت في ساعة","ولم يَحْتسبْ قَطُّ أن يَرْمَدا",28,"د",2,0],["فيُعرضُ عنه السامعونَ وإنني","لذو المذهب المحمود والمنطق الجزلِ",29,"ل",1,0],["في عانَةٍ بِجُنوبِ السِيِّ مَشرَبُها","غَورٌ وَمَصدَرُها عَن مائِها نُجُدُ",30,"د",1,0],["في عارِضٍ مِن كِلابٍ يُبرِقونَ إِذا","نالَ الأَعادِيَ مِنهُم فَيلَقٌ هَبَروا",31,"ر",3,0],["في عارِضٍ مِن كِلابٍ يُبرِقونَ إِذا","صابَ الأَعادِيَ مِنهُم وابِلٌ قُشِروا",32,"ر",3,0],["في عانَةٍ رَعَتِ الأَوعارَ صَيفَتَها","حَتّى إِذا زَهِمَ الأَكفالُ وَالسُرَرُ",33,"ر",1,0],["في عُيونِ الأَنامِ عَنكِ نُبوٌّ","لَم يَكُن في العُيونِ لَو لَم تُسائي",34,"ا",2,0],["فَيَعلَقَ في أَثوابِكُم مِن تُرابِهِ","شَذا المِسكِ مَهما يُغسَلِ الثَوبُ يَسطَعِ",35,"ع",1,0],["في عهده صار يُبكى الحيفُ أعيننا","دماً ويضحكه ما كان يبكينا",36,"ن",2,0],["في عَلاليك من فنون المعالي","ما بفحواه عَيَّت الشعراء",37,"ا",2,0],["في عالم شد الرحال نزيله","وخيال دنيا ذاهب من جاءها",38,"ا",3,0],["في عالَمٍ صَحِبَ الحَياةَ مُقَيَّداً","بِالفَردِ مَخزوماً بِهِ مَغلولا",39,"ل",2,0],["في عالَمٍ سُكّانُهُ أَنفاسُهُم","طيبٌ وَهَمسُ حَديثِهِم إِنجيلُ",40,"ل",1,0],["في عَدلِ فاتِحِهِم وَقانونِيِّهِم","ما يَحتَذي الخُلَفاءُ حَذوَ مِثالِهِ",41,"ل",2,0],["فيعثُرُ ما بينَ السؤالِ ورجعهِ","لساني بكم حتَّى ينُمَّ بحالي",42,"ي",1,0],["في عارِضٍ يَدِقُ الرَدى أَلهَبتَهُ","بِصَواعِقِ العَزَماتِ وَالآراءِ",43,"ا",2,0],["في عارِضٍ تَعرِضُ أَجوازُهُ","بَينَ سُوى خَبتِ فَرمَلِ الشُقوق",44,"ق",1,0],["فيُعطي الرَّغائبَ منصورُنا","ويُدمي التَّرائبَ سَفَّاحُنا",45,"ن",2,0],["في عانَةٍ بَذَلَ العِهادُ لَها","وَسمِيَّ غَيثٍ صادِقِ النَجمِ",46,"م",1,0],["في عِدادِ المَوتى وَفي ساكِني الدُن","يا أَبو جَعفَرٍ أَخي وَخَليلي",47,"ي",1,1],["فَيُعفيني قُبولُكَ عَن جَوابٍ","إِذا يُتلى نَقُصتُ بِهِ وَزادا",48,"د",2,0],["في عابر النسمات مرتجفاً","في النجم فضض صفحة الماء",49,"ا",2,0],["في عباب غامض التيار يجري","واصلاً ما بين عينيك وعمري",50,"ي",1,0],["في عَذاةٍ مَهضوبَةٍ كانَ فيها","ناضِرُ الرَوضِ لِلسَحابِ نَديما",51,"م",2,0],["في عتيقٍ منْ مدامٍ","وجديدٍ من عِذارِ",52,"ر",1,0],["فيعبرونَ مدى الكتَّابِ إنْ كتبوا","وينشرون فتى الخطَّابِ أنْ خطبوا",53,"ب",3,0],["في عِمَّةٍ خَلَعَت عَلَيهِ كَلِمَةً","وَذُؤابَةً قُرِنَت بِها كَعِذارِ",54,"ر",1,0],["في عِصمَةِ الشورى وَتَحتَ ظِلالِها","تُحمى المَمالِكُ كُلُّها وَتُصانُ",55,"ن",1,0],["في عُصبةٍ ممّن يَليكَ دَعَوْتَهَا","فالبأسُ يَدلفُ والحميَّةُ تُسرِعُ",56,"ع",1,0],["فَيَعشو لَهُ الأَعشى إِذا لاحَ نورُهُ","وَيَجري جَريرٌ ظالِعاً حينَ يُعنِقُ",57,"ق",1,0],["في عِزِّنا اِنتَصَرَ النَبِيُّ مُحَمَّدٌ","وَبِنا تَثَبَّتَ في دِمَشقَ المِنبَرُ",58,"ر",1,0],["في عازِبٍ نامَ لَيلُ السارِياتِ بِهِ","مِنَ الأَوائِلِ وَا