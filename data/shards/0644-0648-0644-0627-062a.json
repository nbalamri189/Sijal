,"الكامل"],[4542,"","https://poetry.dctabudhabi.ae/diwan/poem/76556","البسيط"],[4691,"جزء من القلب مفقود","https://www.poetsgate.com/ViewPoem.aspx?id=175526",""],[4771,"كأنّما الفحمُ والنيرانُ تُلهبُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=106580",""],[4984,"قَدْ خَابَ رُشْدُكَ","https://www.poetsgate.com/ViewPoem.aspx?id=201915",""],[5277,"جُبٌّ...ولا دِلَاء","https://www.poetsgate.com/ViewPoem.aspx?id=199916",""],[5504,"سطعت سيوف الهند باللّمعان","https://www.poetsgate.com/ViewPoem.aspx?id=124901",""],[4623,"من يعذر المشتاق في شطحاته ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146691",""],[402,"يا صورة شبهت صخرا بإنسان","https://www.poetsgate.com/ViewPoem.aspx?id=36833",""],[5956,"حتى المَكيف قد أقام حِدادا","https://www.poetsgate.com/ViewPoem.aspx?id=192400",""],[5956,"لولا تركتُ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=192796",""],[5956,"الحمد لله حمداً لا يفارقني","https://www.poetsgate.com/ViewPoem.aspx?id=193794",""],[5956,"حربُ تَشرين التحريرية","https://www.poetsgate.com/ViewPoem.aspx?id=194123",""],[5956,"أحسِنْ إلى الفقراء وابعدْ عنهمو","https://www.poetsgate.com/ViewPoem.aspx?id=207268",""],[6031,"يا مَوْرِداً لا يُغيضُ النَزحُ جَمَّتَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=46258",""],[6079,"في ذكرى ميلاد والدي حفظه الله تعالى","https://www.poetsgate.com/ViewPoem.aspx?id=210598",""]],"verses":[["لَولا تَذَكُّرُ أَيّامي بِذي سَلَمٍ","وَعِندَ رامَةَ أَوطاري وَأَوطاني",0,"ن",2,0],["لَولا تَكاليفُكَ لَم","أُعطِ الزَمانَ مِقوَدا",1,"د",2,0],["لَولا تأخُّرُهُ وقد أوْقَرْتَهُ","كَرَماً لنَمَّ بفَضْلِهِ التّنْزيلُ",2,"ل",1,0],["لَوْلا تَمَاثِيلُهُ الأُخْرَى مُحَطَّمَةً","مَا جَالَ فِي ظَنِّ فَانٍ أَنَّهُ فَانِ",3,"ن",1,0],["لَوْلا تَغَافُلُنَا لَوْلا تَخَاذُلُنَا","لَوْلا تَوَاكُلُنَا تَاللهِ مَا اقْتَحَمُوا",4,"م",3,0],["لَولا تَكونُ كَكاتِبٍ لَكَ رَبعَةٌ","يَقضي الحَوائِجَ مُستَطيلَ الراسِ",5,"س",1,1],["لَولا تَشاغُلُ نَفسي بِالأُلى سَلَفوا","مِن أَهلِ بَيتِ رَسولِ اللَهِ لَم أَقِرِ",6,"ر",1,0],["لولا تألق بارق التذكارِ","ما صابَ واكفُ دمعيَ المدرارِ",7,"ر",1,1],["لَولا تَميمٌ وَكَرُّ الخَيلِ ضاحِيَةً","يا تَيمُ لَم تَعرِفوا أَنقاءَ وَهبينا",8,"ن",2,0],["لَولا تُسَلّيكَ اللِبانَةَ حُرَّةٌ","حَرَجٌ كَأَحناءِ الغَبيطِ عَقيمُ",9,"م",1,0],["لَولا تَذَكُّرُ مَن هَويتُ بِحاجِرٌ","لَم أَبكِ فيهِ مَواقِدَ النيرانِ",10,"ن",1,0],["لَولا تَنَكُّبُهُنَّ الوَعثَ دَمَّرَها","كَما تَنَكَّبَ غَربَ البِئرِ مَتّاحُ",11,"ح",1,0],["لَولا تَناوُلُكُم إِيّايَ ما عَلِقَت","كَفّي بِأَرجائِها القُصوى وَلا قَدَمي",12,"م",2,0],["لولا ترامي الغايتينِ لأقسمَ ال","راؤونَ أنَّ حَراكَها تسكينُ",13,"ن",1,0],["لولا تأخّرُ عصرهِ نزلتْ","في شأنه الآياتُ والكُتْبُ",14,"ب",1,0],["لَولا تَكاثُرُهُنَّ في عَرَصاتِها","لَصُبِغنَ نَوراً أَو بُنينَ مَساجِدا",15,"د",2,0],["لَولا تُعَنِّفُني لَقُلتُ المَنزِلُ","مَغناً تَبَيَّنَهُ وَمَغناً مُشكِلُ",16,"ل",1,1],["لَولا تَأَلُّفُهُ وَالصَدعُ مُنفَرِجٌ","بِالقَومِ ما اِلتَأَمَ الشَعبُ الَّذي اِلتَأَما",17,"م",2,0],["لَولا تَأَتّيهِ لِلدُنيا وَنَبوَتِها","ما لانَ مِن جانِبِ العَيشِ الَّذي لانا",18,"ن",2,0],["لولا تَعشّقُكَ الهيجاءَ ما ركبَتْ","بك العزيمةُ فيها صَهْوَةَ الخطَرِ",19,"ر",1,0],["لَولا تَناهي كُلِّ مَخلوقٍ لَقَد","خِلنا نَوالَكَ لَيسَ بِالمُتَناهي",20,"ه",2,0],["لولا تُسَكِّنُ مِن حَمِيَّتهِ","عِندَ احْتِدامِ البأسِ لاشْتَعلا",21,"ل",2,0],["لولا تُقيمُ بناءَهُ وتحوطُهُ","لعفا كما تعفو الطُّلُولُ وتَمصَحُ",22,"ح",1,0],["لَولا تَعرُّضُهُنَّ لِي","يا قَسُّ كُنتُ كَأَنتَ قَسّا",23,"س",2,0],["لَولا تَنَحّيكَ وَفى نَذرَهُ","فيكَ فَأَصبَحتَ مَعَ الزادِ",24,"د",1,0],["لَولا تَقَضّي الشَبابِ عَنّي","عَصَيتُ في الغَيِّ عاذِلِيّا",25,"ل",3,0],["لَولا تُسَلّيكَ جُمالِيَّةٌ","أَدماءُ دامٍ خُفُّها بازِلُ",26,"ل",1,0],["لَولا تفاقمُ شرٍّ ليس يحتملُ","ما كنت عن وطني بغداد أَرتحلُ",27,"ل",1,1],["لولا تحِيّةُ بعضِ الأربُعِ الدُّرُسِ","ما هابَ حَدُّ لِساني حادثَ الحَبَسِ",28,"س",1,1],["لَوْلاَ تَيَقُّظُ أَحْمَدَ وَجهَابِذَ","مِنْ ضَرْبِه أَعْيَا عَلَى الحُلاَّلِ",29,"ل",1,0],["لَوْلاَ تَنَزَّلَتِ البَرَاءَةُ مِنْ عَلٍ","مَا رَدَّ عَنْكَ القَبْرُ غَيْبَةَ غَائِبِ",30,"ب",1,0],["لَوْلاَ تُعَنّفُني لَقُلْتُ: المُنْزِلُ،","مَعْنًى تُبَيِّنُهُ، وَمَغْنًى مُشْكِلُ",31,"ل",1,1],["لَوْلاَ تَدَاهُ ، ولَوْلاَ سَيْفُ نِقْمَتهِ","دَارَتْ رَحَى الدِّينِ والدُّنيَا على ثِكَلِ",32,"ل",1,0],["لولا تعلل قلبي حين أذكركم","لما قضيت من الأيام أوطارا",33,"ر",2,1],["لَولا تَقادُمُها لَقُلنا إِنَّها","لا شَكَّ مِن عَزمِ المُظَفَّرِ تُطبَعُ",34,"ع",1,0],["لَولا تَواليها لَزُرتُكَ وافِداً","كَوُفودِ حَسّانٍ عَلى بنِ الأَيهَمِ",35,"م",1,0],["لولا تأتي الأمر لا تظنه","ما كان في هذا الزمان عجب",36,"ب",1,0],["لولا تَثنِّى خصره في رِدْفه","ما خِلتُ إلا أنه مغروز",37,"ز",1,0],["لولا تَعلُّقُ عينيه لما تركتْ","أخلاقُه بالقِلى والصد إنسانا",38,"ن",2,0],["لولا تشرّفهم به لتشعّثت","جدرانه وتقلبت ألوانه",39,"ن",2,0],["لو لا تزهُّدُ هِمَّتي في نيْلها","لم تَخْشَ ذاتُ يدي صروفَ نفاد",40,"د",1,0],["لولا تذَكُّرُ أَيّامٍ لنا سَلَفت","ما باتَ يَبكى دماً في الحَيِّ باكينا",41,"ن",2,0],["لَولا تَمَسُّكُها بِطاعَتِهِ لَما","صَحَّت عَقيدَتُها وَلا إِسلامُها",42,"م",3,0],["لَولا تُسَلّي الهَمَّ عَنكَ بِجَسرَةٍ","عَيرانَةٍ مِثلِ الفَنيقِ المُكدَمِ",43,"م",1,0],["لَولا تلوّنُ ودِّه ما كانَ لي","طَرفٌ يَحار الدَمعُ في تَلوينِهِ",44,"ن",2,0],["لولا تجنيك لم يعذب جناك ولا","طابت عليك لذات الصب لذاتُ",45,"ت",1,0],["لَولا تَغلّب حالي في هَواك لَما","أَضحى لَدَيك فُؤاد الصَبّ مُرتَهَنا",46,"ن",2,0],["لَولا تَوَفُّرُ خَوفٍ مِن مَهابَتِكُم","كانَت إِلى القَومِ مِن أَغمادِها تَثِبُ",47,"ب",1,0],["لَولا تَمَتُّعُ مُقلَتي بِلِقائِهِ","لَوَهَبتُها لِمُبَشِّري إِيابِهِ",48,"ه",1,0],["لولا تردد فكرتي في داركم","كنت الفريد بشقوتي وتوائي",49,"ي",1,0],["لَولا تَحجبُهُ لَما حملت","نَفسي الهَوان وَلا صَبا القَلب",50,"ب",1,0],["لولا تأَلُّمُهُ لِماَ","يَلْقَى لَعُدَّ مِنَ الجمَادِ",51,"د",1,0],["لولا تذكر عهد بالحمى سلفا","ما فاض دمعي على ربع ولا وكفا",52,"ف",2,1],["لولا تعالميكم اللاتي قد ازدهرت","مدى العصور لعم الأرض طوفان",53,"ن",1,0],["لولا تلافِي الفجرِ خابطةَ السُّرَى","لقضى عليها الليل وهو بهيمُ",54,"م",1,0],["لولا تُقَى سُؤَّالها","لاستُهوِنَتْ أعمارُها",55,"ر",3,0],["لولا تضمُّن ما أقول من العُلى","وثناك كنتُ عن المديح بمعزل",56,"ل",1,0],["لولا تناولها وقرب مكانه","خيلت بروقاً في سماء تلمع",57,"ع",1,0],["لَولاَ تَهاديكَ أَهدي","صُلحاً إِلَيَّ الصَلاحُ",58,"ح",1,0],["لولا تملُّكُكُمْ رِقّي بأنعُمِكم","ما راقَ شِعري ولا رقّتْ مَبانِيهِ",59,"ي",2,0],["لولا تعجّبُها منه لما اِجتمعَتْ","لا يحدُثُ الضّحكُ حتّى يحدُثَ العجَبُ",60,"ب",1,0],["لولا تعثره بأذيال الثرى","ما كان مذروراً عليه العثير",61,"ر",1,0],["لولا تجسمه فيهم لكان على","ضعف البصائر للأبصار مختطفا",62,"ف",2,0],["لولا تقدم ذنب الدهر ما حسنت","عندي مواقع ما يولي من النعم",63,"م",1,0],["لَولا تَخَفُّرُها لَأَطعَمَنا","فيها مَعارِضُ ضَحكَةِ البَذلِ",64,"ل",1,0],["لَولا تُثيرُكَ عَن مَقامِكَ هِمَّةٌ","يَنجو بِها كَلَبُ الهُمومِ العُوَّدِ",65,"د",1,0],["لولا تجليه بالأفعال ما عقلت","عقولنا أنه الحق الذي خلقا",66,"ق",2,0],["لولا تدارك طيف الحلم يأتيه","لم ألق في الكون شيئاً قط يعجبني",67,"ي",1,0],["لَوْلا تَثنِّي رُدَيْنِيِّ القَوامِ بِهِ","حَلفْتُ أَلْفَ يَمِينٍ أَنَّه صَنَمُ",68,"م",1,0],["لولا تفيق من البكا أو ترعوى","هيهات تندب من عفت أعلامها",69,"م",3,0],["لولا تعلق ارواح به لابي","اي احتفاء به جمهور سكان",70,"ن",1,0],["لولا تنسّمها من نشر أرضكم","ما أصبحت من أليم الوجد تبريني",71,"ن",2,0],["لولا تلهب قلبه بلظى النوى","ما بات وهو على اللقاء يلهب",72,"ب",1,0],["لولا تَجنِّيهِ قُلْتُ الخُلدُ مَنْشؤُهُ","وأنَّ رِضْوانَ في الفِردَوْسِ رَبَّاهُ",73,"ا",2,0],["لولا تصرفك المنزه لم تسع","حسناته الروّادَ والورّادا",74,"د",2,0],["لولا تَيَقُّظُهُ لَمَزَّق بَدْرُهَا","من حَضْرِها ما كان قبل مُفَرَّقا",75,"ق",2,0],["لولا ترى الندب المفدى جعفراً","أرأيت طوداً شامخا إملودا",76,"د",2,0],["لوْ لا تَلافي الطَّيفِ أَن يَنْفِرا","سَلَلْتُ مِنْ جَفني غِرارَ الكَرَى",77,"ر",2,1],["لولا تنكر واردي في ذوقه","ما بين الوجدان معنى واجده",78,"د",2,0],["لولا تقلُّله بكاسي مُدامة","ورسائل الصَّابي وشعر كشاجم",79,"م",1,0],["لولا تعرضك القبيح لبيعتي","جورا وعمدا كنت ظلت وشاني",80,"ن",2,0],["لولا تبسُّمُ ذاك الظَّلمِ والبَرَدِ","قبلتُ نُصحَكَ إلاَّ في هوى الغَيدِ",81,"د",1,1],["لولا تكعب نهدها وجمالها","لتوهموها من شيوخ الجامع",82,"ع",1,0],["لولا