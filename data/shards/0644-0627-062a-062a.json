{"poems":[[53,"دع الذميل إلى الغايات والرتكا","https://www.aldiwan.net/poem29920.html","البسيط"],[53,"لو كان يرتدع القضاء بمردع","https://www.aldiwan.net/poem30148.html","الكامل"],[63,"يا من يساجلني وليس بمدرك","https://www.aldiwan.net/poem45825.html","الكامل"],[55,"مرت بنا تشرق الدنيا ببهجتها","https://www.aldiwan.net/poem26419.html","البسيط"],[77,"قلم المحاسن خط نون عذاره","https://www.aldiwan.net/poem36094.html","الكامل"],[77,"ما أوبق الأنفس إلا الأمل","https://www.aldiwan.net/poem36351.html","الرجز"],[77,"مولاي يا خير ملوك الورى","https://www.aldiwan.net/poem36766.html","السريع"],[73,"الدهر إن أملى فصيح أعجم","https://www.aldiwan.net/poem11979.html","الكامل"],[93,"صدقت في عتبكم أو يصدق الشمم","https://www.aldiwan.net/poem11361.html","البسيط"],[88,"لا يبلغ المرء منتهى أربه","https://www.aldiwan.net/poem45001.html","المنسرح"],[88,"ابنوا المدارس واستقصوا بها الأملا","https://www.aldiwan.net/poem45004.html","البسيط"],[27,"إن الفرزدق أخزته مثالبه","https://www.aldiwan.net/poem5672.html","البسيط"],[27,"بان الخليط برامتين فودعوا","https://www.aldiwan.net/poem5799.html","الكامل"],[27,"حيوا الديار وأهلها بسلام","https://www.aldiwan.net/poem6005.html","الكامل"],[47,"يا حسرة ما أكاد أحملها","https://www.aldiwan.net/poem25170.html","المنسرح"],[23,"أعرض عن العوراء إن أسمعتها","https://www.aldiwan.net/poem21441.html","الكامل"],[72,"ما للعذول على هواك وما لي","https://www.aldiwan.net/poem19526.html","الكامل"],[51,"يا أسدا يا ابن جهور طرقت","https://www.aldiwan.net/poem61867.html","المنسرح"],[51,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[51,"ما طلت باللهو والأيام تنتجز","https://www.aldiwan.net/poem64547.html","البسيط"],[51,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[51,"ما أحسن العفو من المالك","https://www.aldiwan.net/poem65785.html","السريع"],[51,"علي دين ثقيل أنت قاضيه","https://www.aldiwan.net/poem66716.html","البسيط"],[91,"من الفرنسيس قيد العين صورتها","https://www.aldiwan.net/poem8873.html","عموديه"],[91,"يا رب ليل بلا سناء","https://www.aldiwan.net/poem62711.html","عموديه"],[91,"أروي لكمعن شاعر ساحير","https://www.aldiwan.net/poem62815.html","عموديه"],[43,"باد هواك صبرت أم لم تصبرا","https://www.aldiwan.net/poem9608.html","الكامل"],[62,"لا تتهم من شق فاك فإنه","https://www.aldiwan.net/poem52471.html","الكامل"],[45,"هين ما يقول فيك اللاحي","https://www.aldiwan.net/poem62696.html","الخفيف"],[45,"أصبا الأصائل إن برقة منشد","https://www.aldiwan.net/poem63446.html","الكامل"],[45,"قلت للائم في الحب أفق","https://www.aldiwan.net/poem65180.html","الرمل"],[28,"أنسيت صحبتها ومن يك مقرفا","https://www.aldiwan.net/poem5255.html","الكامل"],[28,"إن ابن أحوز قد داوت كتائبه","https://www.aldiwan.net/poem5637.html","البسيط"],[58,"لا تتهم ربك فيما قضى","https://www.aldiwan.net/poem30999.html","السريع"],[49,"لله عاقبة الأمور","https://www.aldiwan.net/poem62098.html","مجزوء الكامل"],[49,"كن عند أحسن ظن من ظنا","https://www.aldiwan.net/poem63145.html","الكامل"],[66,"دق شوال في قفا رمضان","https://www.aldiwan.net/poem39193.html","الخفيف"],[66,"كم قد أفضنا من دموع ودما","https://www.aldiwan.net/poem41378.html","الرجز"],[66,"مادام وعد الأماني غير منتجز","https://www.aldiwan.net/poem41555.html","البسيط"],[80,"بك يا صبور القلب هام جزوعه","https://www.aldiwan.net/poem31382.html","الكامل"],[44,"وأخ أملى عليه اختلاط ال","https://www.aldiwan.net/poem29717.html","الخفيف"],[44,"ولي من الدنيا هوى واحد","https://www.aldiwan.net/poem30257.html","السريع"],[105,"مصر اذكري في الخالدين فتاك","https://www.aldiwan.net/poem42088.html","الكامل"],[105,"يا قوم إن كان مجد النيل مطلبكم","https://www.aldiwan.net/poem42128.html","البسيط"],[105,"من كان يؤثر أن يجيب فقد دعا","https://www.aldiwan.net/poem43048.html","الكامل"],[105,"شجن بقلبك يطمئن ويفزع","https://www.aldiwan.net/poem43093.html","الكامل"],[105,"خوضوا الوغى يا أهل وادي القرى","https://www.aldiwan.net/poem44051.html","السريع"],[39,"هل يدنيك من أجارع واسط","https://www.aldiwan.net/poem53778.html","الكامل"],[52,"لا تتبع النفس شيئا فات مطلبه","https://www.aldiwan.net/poem27177.html","البسيط"],[67,"أمدائح لي فيك أم تسبيح","https://www.aldiwan.net/poem18045.html","الكامل"],[48,"يا سالب الأذهان","https://www.aldiwan.net/poem66123.html","المجتث"],[50,"أنى دعاه الشوق فارتاحا","https://www.aldiwan.net/poem63965.html","السريع"],[50,"يا صاحبي أعيناني على طرب","https://www.aldiwan.net/poem64828.html","البسيط"],[46,"قد أصبحت ونعاتها نعاتها","https://www.aldiwan.net/poem22158.html","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85389","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85490","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85647","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39627","السريع"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30496","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42727","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54767","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54697","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54266","السريع"],[106,"لا نكسة","https://www.poetsgate.com/ViewPoem.aspx?id=179333",""],[106,"كلب بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179351",""],[84,"أما الرياح بجو عاصم","https://www.poetsgate.com/ViewPoem.aspx?id=26356",""],[90,"تحرك اللحد !","https://www.poetsgate.com/ViewPoem.aspx?id=179160",""],[45,"أصَبَا الأصَائِلِ إنّ بُرْقَةَ مُنْشِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=32956",""]],"verses":[["لا تَتبَعوا في المَساعي غَيرَ أَخمَصِهِ","فَأَخصَرُ الطُرقِ في العَلياءِ ما سَلَكا",0,"ك",2,0],["لا تَتبَعوا شُبَهَ الأُمورِ فَإِنَّهُ","شَبَهٌ يُتيحُ الحَقَّ عِندَ المَقطَعِ",1,"ع",1,0],["لا تَتعَبَنَّ فَدونَ ما أَمَّلتَهُ","خَرطُ القَتادَةِ وَاِمتطاءُ الكَوكَبِ",2,"ب",1,0],["لا تَترُكي مِن فُؤادي خالياً جَسَدي","رُدّي الفُؤادَ وَإِلا فَاِقتُلي الجَسَدا",3,"د",2,0],["لاَ تَتَّقُوا عَيْناً تُصِيبُ جَمَالَهُ","فَاللهُ عَوَّذَهُ بِنُونٍ وَالْقَلَمْ",4,"م",1,0],["لاَ تَتْرُكَنْهَا فِي عَمىً وَحَيْرَةٍ","عَنْ هَوْلِ مَا بَيْنَ يَدَيْهَا تَغْفُلُ",5,"ل",1,0],["لاَ تَتَّهِمْنِي إِنَّنِي مُمْتَلٍ","مِنْ حِكَمِ الْمُلْكِ وَآدَابِهِ",6,"ب",2,0],["لا تَترُكَن لِلناسِ مَوضِعَ شُبهَةٍ","وَاِحزُم فَمِثلُكَ في العَظائِمِ أَحزَمُ",7,"م",1,0],["لا تَتْرُكُوهُ يُرَادِيهِمْ وَقَدْ قَعَدَتْ","بِلا قِتَالٍ تُلاشِي بَأْسَهَا البُهَمُ",8,"م",1,0],["لا تتّكل بعده على نَسَب","فالعلم يُغني النسيب عن نسبه",9,"ب",2,0],["لا تتركوا الشَوك ينمو في مَنابتها","أعني بذلكم الأهواء والنّحلا",10,"ل",2,0],["لا تَترُكوا الحَدَّ في لَيلى فَكُلُّكُمُ","مِن شَأنِ لَيلى وَشَأنِ القَينِ مُرتابُ",11,"ب",1,0],["لا تُتبَعُ النَخَباتُ يَومَ عَظيمَةٍ","بُلِغَت عَزائِمُهُ وَلَكِن تَتبَعُ",12,"ع",1,0],["لا تَترُكَنّي لِلَّذي بِيَ مُسلَماً","فَيُصابَ سَمعي أَو تُسَلَّ عِظامي",13,"م",2,0],["لاتَتَيَمَّم وَالماءُ تُدرِكُهُ","غَيرُكَ يَرضى الصُغرى وَيَقبَلُها",14,"ل",3,0],["لا تَتبَعَنَّ غَوايَةً لِصَبابَةٍ","إِنَّ الغَوايَةَ كُلَّ شَرٍّ تَجمَعُ",15,"ع",1,0],["لا تتخذ بدلاً لديه وعدّة","في هذه الدنيا من الأبدال",16,"ل",1,0],["لا تترك العيْثَ من أبي حسن","يُميل عرشي وأنت لي سندُ",17,"د",1,0],["لا تَتركوا الطِّرفَ الجوا","دَ خليعَ مضيعةٍ يَعير",18,"ر",1,0],["لا تتركن بين طَوري لذةٍ خَللاً","إن الشبابَ وأيامَ الصبا نُهَزُ",19,"ز",1,0],["لا تترك الدهر مغروراً بغرته","ولا تُرى للصحيح الجلد قرّافا",20,"ف",2,0],["لا تَتْرُكَنّي رحمةً بعدما","هتكْتَني أفديك من هاتِكِ",21,"ك",1,0],["لا تتركنَّ وليَّاً ذا محافظة","ونارُ حَسْرةِ فَوْتِ الحظ تكويه",22,"ي",2,0],["لا تَتَّقي اللَهَ فيه وَهوَ في يَدِها","وَتَتَّقي فيهِ فَوقَ الوَجنَةِ النَظَرا",23,"ر",2,0],["لا تَتبَعوا سُنَّةَ البَقاءِ","فَإِنَّها سُنَّةٌ ظَلومُ",24,"م",1,0],["لا تَتَرَضّاني رِياءً وَلا","تَلثُمُني كَذِباً وَتَمويها",25,"ي",3,0],["لا تَترَبِ الأَيدي المُقيمَةُ فَوقَهُ","كِسرى مُقامَ الحاجِبَينِ وَقَيصَرا",26,"ر",2,0],["لا تَتَّهِمْ من شَقَّ فاك فإنَّهُ","ضَمِنَ الحياةَ وقدَّرَ الأقواتا",27,"ت",2,1],["لا تُتِمُّ السُقيا بِساحَةِ قَومٍ","لَم يَبيتوا في نائِلٍ وَسَماحِ",28,"ح",1,0],["لا تُتعِبي عَرَصاتِها إِنَّ الهَوى","مُلقاً عَلى تِلكَ الرُسومِ الهُمَّدِ",29,"د",1,0],["لا تَتَّبِع فائِتاً مِن خَيرِهِ","آيَسَ الرَهنُ فَدَعهُ إِذ غَلِق",30,"ق",1,0],["لا تَترُكُنَّ وَلا يَزالَن عِندَها","مِنكُم بِحَدِّ شِتائِها مَيّارُ",31,"ر",1,0],["لا تَتَّقي خَيلُهُ وَطءَ القَتيلِ وَلا","خَوضَ الدِماءِ إِذا كانَت إِلى الثُنَنِ",32,"ن",1,0],["لا تَتَّهِم رَبَّكَ فيما قَضى","وَهَوِّنِ الأَمرَ عَلى النَفسِ",33,"س",1,1],["لَأَتَت عَلَيكَ دَوائِرُ الدُ","نيا وَكَرّاتُ الشُهورِ",34,"ر",1,0],["لا تُتبِعَنَّ يَداً بَسَطتَ بِها ال","مَعروفَ مِنكَ أَذىً وَلا مَنّا",35,"ن",2,0],["لا تَتِمُّ الأَفراحُ إِلّا إِذا عا","دَ سَنا بَدرِهِ إِلى نُقصانِ",36,"ن",1,0],["لا تَتَشَكّى نَصَباً وَلا وَجىً","إِذا دَجا اللَيلُ عَلى الرَكبِ وَجَن",37,"ن",1,0],["لا تَترُكِ الثَأرَ مِن قَومٍ مُرادُهُمُ","إِخفاءُ ذِكرٍ لَنا في الناسِ مُنتَبِزِ",38,"ز",1,0],["لا تَتّهِمْني في الوفاءِ فإنّني","كَتمْتُ سرّكَ والدموعُ تُذيعُهُ",39,"ع",2,0],["لا تَتِه إِن أَطالَ هَزَّكَ مَدحي","وَاِعذِرَن لَستَ بَعدَها مِن سُيوفي",40,"ف",2,0],["لا تَترُكَنّي فيهِ يا ذا العُلا","أُحدوثَةَ الصادِرِ وَالوارِدِ",41,"د",1,0],["لا تتركي يا مصرُ ذِكرَى شيِّقٍ","وَلهانَ ليس بِتاركٍ ذكراكِ",42,"ك",1,0],["لا تتبعوا مِلّةَ الغاوين واجتنبوا","أهواءَ قومٍ على أوثانهم عكفوا",43,"ف",3,0],["لا تَتْبَعوا المُتخلِّفين فإنّهم","جُنْدُ الغُواةِ وشِيعةُ الأغرارِ",44,"ر",1,0],["لا تَترُكي المُتَطَيِّرينَ لِيَأسِهِم","اليَأسُ يَكذِبُ وَالتَطَيُّرُ يَخدَعُ",45,"ع",1,0],["لا تتركوا جَيْشَ الأُلَى اسْتَمْسَكوا","بالكفرِ حتّى يَرجعَ القهقرى",46,"ر",2,0],["لا تَترُكَن مُرُطاً وَنَبلُ مَعاشِرٍ","دوني تُزَيُّنُها بِريشِ نِسارِ",47,"ر",1,0],["لا تَترُكَن سُدىً فَيُعضِلَ حَلُّها","وَتَطيشَ حينَ تَحُثُّ بِالأَوتارِ",47,"ر",1,0],["لا تُتبِعِ النَفسَ شَيئاً فاتَ مَطلَبُهُ","وَاِشرَب ثَلاثاً تَجِد مِن هَمِّهِ فَرَجا",48,"ج",2,1],["لا تُتْعِبَنَّ بِذِكْرِهِمْ قَلْبَاً غَدا","ولهُ بِذِكْرِ مُحمَّدٍ تَرْوِيحُ",49,"ح",1,0],["لا تَترُكَنّي مُعَنّىً","بِطَرفِكَ الفَتّانِ",50,"ن",1,0],["لا تَترُكَنّا غَرَضاً لِلعِدى","إِن كُنتَ لِلأَهوالِ سَبّاحا",51,"ح",2,0],["لا تُتعِبيني فَإِنّي مِن حَديثِكُمُ","بَعدَ الصُدودِ الَّذي حُدِّثتُ في تَعَبِ",52,"ب",1,0],["لا تَتبَعَنَّ الغانِياتِ مُماشِياً","إِنَّ الغَوانِيَ جَمَّةٌ تَبِعاتُها",53,"ت",3,0],["لا تَتْهميه بالسلو فَربما","عاقته في أَسفاره أَسباب",54,"ب",1,0],["لا تتركنَّ الشرور تَنمو","فأَول النار من شرارِ",55,"ر",1,1],["لا تتبعنَّ الظن إِن","نَ الظن أكثره كذوب",56,"ب",1,0],["لا تتركي زورقَنا المُجْهَدا","يجري به اليأسُ ويمضي العذابْ",57,"ب",1,1],["لا تَتْرُكَنْ صرم الزمَا","نِ على ظُبَى تِلْكَ الصَّوارِمْ",58,"م",1,0],["لا تَتْرُكُوا الْجِدَّ أَوْ يَبْدُو الْيَقِينُ لَكُمْ","فَالْجِدُّ مِفْتَاحُ بَابِ الْمَطْلَبِ الْعَضِلِ",59,"ل",1,0],["لا تَتَأَتَّى ثَرْوَةٌ طَفْرَةً","إِنْ هِيَ إِلاَّ حِكْمَةٌ وَاقْتِصَادْ",60,"د",1,0],["لاَ تَتْعَبُوا لاَ تَمَلُّوا إنَّ ظَمْأَتَكُمْ","إِلى غَدِيرٍ مِنَ الأَقْوَامِ مَوْرُودِ",61,"د",1,0],["لا تَتْرُكُ الذِئْبَةُ أجْراءَها","ولا يغيبُ الكلبُ عن وَجْرِه",62,"ر",2,0],["لا تتركوهم يَنْعَمُون برَوْضَةٍ","في القُدْس، أو يجنون كَرْمًا مُثْمِرا",63,"ر",2,0],["لا تتركوا أحدًا يرتاد واديَكم","وصَيِّرُوهُ على الصِّهْيَون مقصورا",64,"ر",2,0],["لا تتركن صرم الزمان","على ظبا تلك الصوارم",65,"م",1,0],["لا تَتْرُكوا اليأسَ يَلقى في نُفوسكم","لَه مَدَبَّاً ولا يأخُذْكُمُ الخَوَر",66,"ر",1,0],["لا تُتْعِبي عَرَصَاتِهَا، إنّ الهَوَى","مُلْقًى عَلى تِلْكَ الرّسُومِ الهُمّدِ",67,"د",1,0]]}