ب خطه ملك","https://www.aldiwan.net/poem60873.html","البسيط"],[372,"شهد البكاء وما أتيت بشاهد","https://www.aldiwan.net/poem57494.html","الكامل"],[381,"استغر الله العظيم العفو","https://www.aldiwan.net/poem47411.html","الرجز"],[381,"قد نمت عن أشواقه","https://www.aldiwan.net/poem49233.html","مجزوء الكامل"],[388,"لا تتركنكُم ذور عين وسكسكٌ","https://www.aldiwan.net/poem549.html",""],[403,"دعا فؤادي يقاسي الشوق والكمدا","https://www.aldiwan.net/poem46752.html","البسيط"],[403,"أين استقر السلف الأول","https://www.aldiwan.net/poem47005.html","الكامل"],[404,"لا توردن على سمعي من الكلم","https://www.aldiwan.net/poem33446.html","البسيط"],[404,"هذي مناسك أحمد وصفاته","https://www.aldiwan.net/poem33477.html","الكامل"],[404,"يا ساري الريح ساعدني على وطري","https://www.aldiwan.net/poem33913.html","البسيط"],[406,"تأن في الشيء إذا رمته","https://www.aldiwan.net/poem49434.html","السريع"],[442,"ما حال حي ثوى ما بين أموات","https://www.aldiwan.net/poem14354.html","البسيط"],[459,"أين تريد يا مثير الظعن","https://www.aldiwan.net/poem55836.html","الرجز"],[459,"من مبلغ عني وإن تعذرت","https://www.aldiwan.net/poem55897.html","الرجز"],[459,"أولى لها أن يرعوي نفارها","https://www.aldiwan.net/poem56170.html","الرجز"],[459,"كم النوى قد جزع الصابر","https://www.aldiwan.net/poem56172.html","السريع"],[459,"نبهته فقام مشبوح العضد","https://www.aldiwan.net/poem56228.html","الرجز"],[469,"يا أنظف العالم في الغسل","https://www.aldiwan.net/poem59722.html","السريع"],[469,"يا من يروح ويغتدي","https://www.aldiwan.net/poem59970.html","مجزوء الكامل"],[469,"يا راحتي وعذابي","https://www.aldiwan.net/poem60424.html","المجتث"],[478,"دع عنك ما زخرف الواشي وما زعما","https://www.aldiwan.net/poem15273.html","البسيط"],[511,"لا تتعرض لنا فإن لنا","https://www.aldiwan.net/poem1587.html",""],[516,"يا مطلق العبرات وهي غزار","https://www.aldiwan.net/poem12104.html","الكامل"],[552,"أرقت للبرق بالعلياء يضطرم","https://www.aldiwan.net/poem47247.html","البسيط"],[552,"يا حادي الأظعان عرج","https://www.aldiwan.net/poem47389.html","مجزوء الكامل"],[586,"خان المحالف والمعاهد","https://www.aldiwan.net/poem1569.html",""]],"verses":[["لا تَتبَعوا في المَساعي غَيرَ أَخمَصِهِ","فَأَخصَرُ الطُرقِ في العَلياءِ ما سَلَكا",0,"ك",2,0],["لا تَتبَعوا شُبَهَ الأُمورِ فَإِنَّهُ","شَبَهٌ يُتيحُ الحَقَّ عِندَ المَقطَعِ",1,"ع",1,0],["لا تَتعَبَنَّ فَدونَ ما أَمَّلتَهُ","خَرطُ القَتادَةِ وَاِمتطاءُ الكَوكَبِ",2,"ب",1,0],["لا تَترُكي مِن فُؤادي خالياً جَسَدي","رُدّي الفُؤادَ وَإِلا فَاِقتُلي الجَسَدا",3,"د",2,0],["لاَ تَتَّقُوا عَيْناً تُصِيبُ جَمَالَهُ","فَاللهُ عَوَّذَهُ بِنُونٍ وَالْقَلَمْ",4,"م",1,0],["لاَ تَتْرُكَنْهَا فِي عَمىً وَحَيْرَةٍ","عَنْ هَوْلِ مَا بَيْنَ يَدَيْهَا تَغْفُلُ",5,"ل",1,0],["لاَ تَتَّهِمْنِي إِنَّنِي مُمْتَلٍ","مِنْ حِكَمِ الْمُلْكِ وَآدَابِهِ",6,"ب",2,0],["لا تَترُكَن لِلناسِ مَوضِعَ شُبهَةٍ","وَاِحزُم فَمِثلُكَ في العَظائِمِ أَحزَمُ",7,"م",1,0],["لا تَتْرُكُوهُ يُرَادِيهِمْ وَقَدْ قَعَدَتْ","بِلا قِتَالٍ تُلاشِي بَأْسَهَا البُهَمُ",8,"م",1,0],["لا تتّكل بعده على نَسَب","فالعلم يُغني النسيب عن نسبه",9,"ب",2,0],["لا تتركوا الشَوك ينمو في مَنابتها","أعني بذلكم الأهواء والنّحلا",10,"ل",2,0],["لا تَترُكوا الحَدَّ في لَيلى فَكُلُّكُمُ","مِن شَأنِ لَيلى وَشَأنِ القَينِ مُرتابُ",11,"ب",1,0],["لا تُتبَعُ النَخَباتُ يَومَ عَظيمَةٍ","بُلِغَت عَزائِمُهُ وَلَكِن تَتبَعُ",12,"ع",1,0],["لا تَترُكَنّي لِلَّذي بِيَ مُسلَماً","فَيُصابَ سَمعي أَو تُسَلَّ عِظامي",13,"م",2,0],["لاتَتَيَمَّم وَالماءُ تُدرِكُهُ","غَيرُكَ يَرضى الصُغرى وَيَقبَلُها",14,"ل",3,0],["لا تَتبَعَنَّ غَوايَةً لِصَبابَةٍ","إِنَّ الغَوايَةَ كُلَّ شَرٍّ تَجمَعُ",15,"ع",1,0],["لا تتخذ بدلاً لديه وعدّة","في هذه الدنيا من الأبدال",16,"ل",1,0],["لا تترك العيْثَ من أبي حسن","يُميل عرشي وأنت لي سندُ",17,"د",1,0],["لا تَتركوا الطِّرفَ الجوا","دَ خليعَ مضيعةٍ يَعير",18,"ر",1,0],["لا تتركن بين طَوري لذةٍ خَللاً","إن الشبابَ وأيامَ الصبا نُهَزُ",19,"ز",1,0],["لا تترك الدهر مغروراً بغرته","ولا تُرى للصحيح الجلد قرّافا",20,"ف",2,0],["لا تَتْرُكَنّي رحمةً بعدما","هتكْتَني أفديك من هاتِكِ",21,"ك",1,0],["لا تتركنَّ وليَّاً ذا محافظة","ونارُ حَسْرةِ فَوْتِ الحظ تكويه",22,"ي",2,0],["لا تَتَّقي اللَهَ فيه وَهوَ في يَدِها","وَتَتَّقي فيهِ فَوقَ الوَجنَةِ النَظَرا",23,"ر",2,0],["لا تَتبَعوا سُنَّةَ البَقاءِ","فَإِنَّها سُنَّةٌ ظَلومُ",24,"م",1,0],["لا تَتَرَضّاني رِياءً وَلا","تَلثُمُني كَذِباً وَتَمويها",25,"ي",3,0],["لا تَترَبِ الأَيدي المُقيمَةُ فَوقَهُ","كِسرى مُقامَ الحاجِبَينِ وَقَيصَرا",26,"ر",2,0],["لا تَتَّهِمْ من شَقَّ فاك فإنَّهُ","ضَمِنَ الحياةَ وقدَّرَ الأقواتا",27,"ت",2,1],["لا تُتِمُّ السُقيا بِساحَةِ قَومٍ","لَم يَبيتوا في نائِلٍ وَسَماحِ",28,"ح",1,0],["لا تُتعِبي عَرَصاتِها إِنَّ الهَوى","مُلقاً عَلى تِلكَ الرُسومِ الهُمَّدِ",29,"د",1,0],["لا تَتَّبِع فائِتاً مِن خَيرِهِ","آيَسَ الرَهنُ فَدَعهُ إِذ غَلِق",30,"ق",1,0],["لا تَترُكُنَّ وَلا يَزالَن عِندَها","مِنكُم بِحَدِّ شِتائِها مَيّارُ",31,"ر",1,0],["لا تَتَّقي خَيلُهُ وَطءَ القَتيلِ وَلا","خَوضَ الدِماءِ إِذا كانَت إِلى الثُنَنِ",32,"ن",1,0],["لا تَتَّهِم رَبَّكَ فيما قَضى","وَهَوِّنِ الأَمرَ عَلى النَفسِ",33,"س",1,1],["لَأَتَت عَلَيكَ دَوائِرُ الدُ","نيا وَكَرّاتُ الشُهورِ",34,"ر",1,0],["لا تُتبِعَنَّ يَداً بَسَطتَ بِها ال","مَعروفَ مِنكَ أَذىً وَلا مَنّا",35,"ن",2,0],["لا تَتِمُّ الأَفراحُ إِلّا إِذا عا","دَ سَنا بَدرِهِ إِلى نُقصانِ",36,"ن",1,0],["لا تَتَشَكّى نَصَباً وَلا وَجىً","إِذا دَجا اللَيلُ عَلى الرَكبِ وَجَن",37,"ن",1,0],["لا تَترُكِ الثَأرَ مِن قَومٍ مُرادُهُمُ","إِخفاءُ ذِكرٍ لَنا في الناسِ مُنتَبِزِ",38,"ز",1,0],["لا تَتّهِمْني في الوفاءِ فإنّني","كَتمْتُ سرّكَ والدموعُ تُذيعُهُ",39,"ع",2,0],["لا تَتِه إِن أَطالَ هَزَّكَ مَدحي","وَاِعذِرَن لَستَ بَعدَها مِن سُيوفي",40,"ف",2,0],["لا تَترُكَنّي فيهِ يا ذا العُلا","أُحدوثَةَ الصادِرِ وَالوارِدِ",41,"د",1,0],["لا تتركي يا مصرُ ذِكرَى شيِّقٍ","وَلهانَ ليس بِتاركٍ ذكراكِ",42,"ك",1,0],["لا تتبعوا مِلّةَ الغاوين واجتنبوا","أهواءَ قومٍ على أوثانهم عكفوا",43,"ف",3,0],["لا تَتْبَعوا المُتخلِّفين فإنّهم","جُنْدُ الغُواةِ وشِيعةُ الأغرارِ",44,"ر",1,0],["لا تَترُكي المُتَطَيِّرينَ لِيَأسِهِم","اليَأسُ يَكذِبُ وَالتَطَيُّرُ يَخدَعُ",45,"ع",1,0],["لا تتركوا جَيْشَ الأُلَى اسْتَمْسَكوا","بالكفرِ حتّى يَرجعَ القهقرى",46,"ر",2,0],["لا تَترُكَن مُرُطاً وَنَبلُ مَعاشِرٍ","دوني تُزَيُّنُها بِريشِ نِسارِ",47,"ر",1,0],["لا تَترُكَن سُدىً فَيُعضِلَ حَلُّها","وَتَطيشَ حينَ تَحُثُّ بِالأَوتارِ",47,"ر",1,0],["لا تُتبِعِ النَفسَ شَيئاً فاتَ مَطلَبُهُ","وَاِشرَب ثَلاثاً تَجِد مِن هَمِّهِ فَرَجا",48,"ج",2,1],["لا تُتْعِبَنَّ بِذِكْرِهِمْ قَلْبَاً غَدا","ولهُ بِذِكْرِ مُحمَّدٍ تَرْوِيحُ",49,"ح",1,0],["لا تَترُكَنّي مُعَنّىً","بِطَرفِكَ الفَتّانِ",50,"ن",1,0],["لا تَترُكَنّا غَرَضاً لِلعِدى","إِن كُنتَ لِلأَهوالِ سَبّاحا",51,"ح",2,0],["لا تُتعِبيني فَإِنّي مِن حَديثِكُمُ","بَعدَ الصُدودِ الَّذي حُدِّثتُ في تَعَبِ",52,"ب",1,0],["لا تَتبَعَنَّ الغانِياتِ مُماشِياً","إِنَّ الغَوانِيَ جَمَّةٌ تَبِعاتُها",53,"ت",3,0],["لا تَتْهميه بالسلو فَربما","عاقته في أَسفاره أَسباب",54,"ب",1,0],["لا تتركنَّ الشرور تَنمو","فأَول النار من شرارِ",55,"ر",1,1],["لا تتبعنَّ الظن إِن","نَ الظن أكثره كذوب",56,"ب",1,0],["لا تتركي زورقَنا المُجْهَدا","يجري به اليأسُ ويمضي العذابْ",57,"ب",1,1],["لا تَتْرُكَنْ صرم الزمَا","نِ على ظُبَى تِلْكَ الصَّوارِمْ",58,"م",1,0],["لا تَتْرُكُوا الْجِدَّ أَوْ يَبْدُو الْيَقِينُ لَكُمْ","فَالْجِدُّ مِفْتَاحُ بَابِ الْمَطْلَبِ الْعَضِلِ",59,"ل",1,0],["لا تَتَأَتَّى ثَرْوَةٌ طَفْرَةً","إِنْ هِيَ إِلاَّ حِكْمَةٌ وَاقْتِصَادْ",60,"د",1,0],["لاَ تَتْعَبُوا لاَ تَمَلُّوا إنَّ ظَمْأَتَكُمْ","إِلى غَدِيرٍ مِنَ الأَقْوَامِ مَوْرُودِ",61,"د",1,0],["لا تَتْرُكُ الذِئْبَةُ أجْراءَها","ولا يغيبُ الكلبُ عن وَجْرِه",62,"ر",2,0],["لا تتركوهم يَنْعَمُون برَوْضَةٍ","في القُدْس، أو يجنون كَرْمًا مُثْمِرا",63,"ر",2,0],["لا تتركوا أحدًا يرتاد واديَكم","وصَيِّرُوهُ على الصِّهْيَون مقصورا",64,"ر",2,0],["لا تتركن صرم الزمان","على ظبا تلك الصوارم",65,"م",1,0],["لا تَتْرُكوا اليأسَ يَلقى في نُفوسكم","لَه مَدَبَّاً ولا يأخُذْكُمُ الخَوَر",66,"ر",1,0],["لا تُتْعِبي عَرَصَاتِهَا، إنّ الهَوَى","مُلْقًى عَلى تِلْكَ الرّسُومِ الهُمّدِ",67,"د",1,0],["لا تتركوا المرأة غير صقيلة","الشعب روح شبابه مرآته",68,"ت",2,0],["لا تُتْعبي يدَكِ الرقيقةَ. إنني","أخشى على البللور أن يتوجعا..",69,"ع",2,0],["لا تَتَهم بِالسوءِ دَهرك أَنَّهُ","جَبل يُجيب صَداكَ مِنهُ صَداءِ",70,"ا",2,1],["لا تتزوَّج قطعاً طليقَةَ زوجٍ","وهْي فيه شديدةُ البُرَحاءِ",71,"ا",2,0],["لا تتركيني في دياركِ مثلما","تُرِكَ الفويسقُ ضَائِعا في الدار",72,"ر",1,0],["لا تَترُكُن نُصحي فَإِنّي ناصِحُ","إِنَّ الطَريقَ فَاِعلَمُنَّ واضِحُ",73,"ح",1,0],["لا تتَّرِكْ نُهزَةً عنَّتْ سلَّمَةً","إلى علاك فإن الدهرَ أطوارُ",74,"ر",1,0],["لا تَتَّخِذ رُسُلاً سِوى بيضِ الظُبى","فَشِفارُها أَبَداً بِأَمرِكَ تَصدَعُ",75,"ع",1,0],["لا تُتعِبِ اللَومَ الَّذي أَنضَيتَهُ","في كُلِّ مُعتَدِلِ القَوامِ رَشيقِهِ",76,"ق",2,0],["لا تترك الإسلام والقول الذي","قد قاله الرحمن في القرآن",77,"ن",1,0],["لا تتكل في تَرقِّيها على نسبٍ","واعملْ لنفسِك واحذرْ خطةَ السَّأمِ",78,"م",1,0],["لا تُتِعب الضرس ولا الثَّنِيَّة","كأنها تُشْتَفُّ في الصِّينية",79,"ن",3,0],["لا تتركنّ لوارث","إلا الدموع على المحاجر",80,"ر",1,0],["لا تَترُكوا مُستَحيلاً في اِستِحالتِهِ","حتّى يُميطَ لكُم عن وجهِ إمكانِ",81,"ن",1,0],["لا تَتَيهِوا ولم تَرَوْ","نِي فإنّي بلا مِثالْ",82,"ل",1,0],["لا تَتَّهمني بالجَفا ظالماً","حَسْبي من الأيام رؤياكا",83,"ك",2,0],["لا تترك القدَحَ المملوء في يده","إني أخاف عليها من تَلَهّبه",84,"ب",2,0],["لا تَتَّهِمني في هَواكَ بِزَلَّةٍ","ما كانَ لي ذَنبٌ إِلَيكَ سِوى الوَفا",85,"ف",2,0],["لا تُتلِفوا بِالبَينِ مُهجَةَ عاشِقٍ","سِيّانِ بَينُ حَميمِها وَحِمامُها",86,"م",3,0],["لا تُتعِبوا أَفكارَكُم","وَلا تَكُدّوا الهِمَما",87,"م",2,0],["لا تَتَرَقّى نَحوَهُ هِمَّةٌ","فَغيرُهُ في الناسِ مَحسودُ",88,"د",1,0],["لا تتركي لا تتركي لغدي","تعكير يومي ما يكون غدي",89,"ي",1,0],["لا تتركنّي وَما أَمَلَّتُ في سَفَري","سِواكَ أُقفِلُ نَحوَ الأَهل صُعلوكا",90,"ك",2,0],["لا تتبع النفس في هَواها","ان اتباع الهوى هوان",91,"ن",1,0],["لاَ تَتَّقِي وَهُو المُبَارَكُ سُنَّةً","سنَةً لَحُوساً لِلنَّبَاتِ مَحُوشا",92,"ش",2,0],["لا تَترُكَنَّ التُّقى يَوماً فَتُهمِلَهُ","نَوماً فَلَستَ بِمَتروكٍ وَلا هَمَلِ",93,"ل",1,0],["لا تترك الزِيارَه","فتركُها حَقارَه",94,"ه",1,0],["لا تتعجب من جنوني فقد","تحكمت في مهجتي السودا",95,"د",2,0],["لا تتعجب إن عدمت ال