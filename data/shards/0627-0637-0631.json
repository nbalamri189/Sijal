Poem.aspx?id=161937",""],[585,"نظر المشيب إليك قبل أوان","https://www.poetsgate.com/ViewPoem.aspx?id=161877",""],[5080,"مدائن التمر","https://www.poetsgate.com/ViewPoem.aspx?id=184906",""],[5111,"تَحْلِيقٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212205",""],[5111,"هَجْرٌ","https://www.poetsgate.com/ViewPoem.aspx?id=212525",""],[5111,"آمَالُنَا","https://www.poetsgate.com/ViewPoem.aspx?id=212646",""],[5121,"أُنْشُودَةُ الطُّيُورْ","https://www.poetsgate.com/ViewPoem.aspx?id=33500",""],[5121,"هَدِيَّةُ مَوْلِدِي","https://www.poetsgate.com/ViewPoem.aspx?id=214758",""],[5136,"هنيت بالإقبال والنصر","https://www.poetsgate.com/ViewPoem.aspx?id=121574",""],[5136,"ما هز عطفي ملة الحنفاء","https://www.poetsgate.com/ViewPoem.aspx?id=121489",""],[5174,"لغة الخلود","https://www.poetsgate.com/ViewPoem.aspx?id=199065",""],[5277,"كتابي","https://www.poetsgate.com/ViewPoem.aspx?id=191689",""],[5277,"سقياه..","https://www.poetsgate.com/ViewPoem.aspx?id=193316",""],[5295,"بَيْنَ الثُّلُوجِ","https://www.poetsgate.com/ViewPoem.aspx?id=177209",""],[5358,"طرقتُ بابَك","https://www.poetsgate.com/ViewPoem.aspx?id=183427",""],[5358,"شوقاً لعينيكَ","https://www.poetsgate.com/ViewPoem.aspx?id=211501",""],[5397,"أطربتني نغمات لحن المنشد","https://www.poetsgate.com/ViewPoem.aspx?id=157934",""],[5397,"هلا سألت مرابعا وطلولا","https://www.poetsgate.com/ViewPoem.aspx?id=157941",""],[333,"الفتنة الخرساء","https://www.poetsgate.com/ViewPoem.aspx?id=98233",""],[5437,"السر الدفين","https://www.poetsgate.com/ViewPoem.aspx?id=152567",""],[5443,"درس الحب","https://www.poetsgate.com/ViewPoem.aspx?id=185153",""],[5493,"شَفْشاوُن سليلة الأندلس","https://www.poetsgate.com/ViewPoem.aspx?id=200238",""],[5493,"غضبى","https://www.poetsgate.com/ViewPoem.aspx?id=206893",""],[5518,"في ذكرى المولد النبوي الشريف","https://www.poetsgate.com/ViewPoem.aspx?id=187775",""],[5525,"رسالة من بدوي","https://www.poetsgate.com/ViewPoem.aspx?id=906",""],[5542,"حرقة عالى حال الأمة","https://www.poetsgate.com/ViewPoem.aspx?id=10062",""],[5562,"قارئ الضوء","https://www.poetsgate.com/ViewPoem.aspx?id=190067",""],[5638,"ملحمة حر","https://www.poetsgate.com/ViewPoem.aspx?id=197920",""],[5677,"ميثاق غلا ...!","https://www.poetsgate.com/ViewPoem.aspx?id=179806",""],[5691,"الحبر والورقة","https://www.poetsgate.com/ViewPoem.aspx?id=206386",""],[5725,"يغتابنا العصفور","https://www.poetsgate.com/ViewPoem.aspx?id=193602",""],[5818,"اطرقِ الأبواب","https://www.poetsgate.com/ViewPoem.aspx?id=196542",""],[5849,"يا راحماً فوجَ الحجيج","https://www.poetsgate.com/ViewPoem.aspx?id=191080",""],[5873,"روعة السحر","https://www.poetsgate.com/ViewPoem.aspx?id=215411",""],[5897,"فضاءات حمد","https://www.poetsgate.com/ViewPoem.aspx?id=156362",""],[5943,"يامنيةَ الرُّوحِ","https://www.poetsgate.com/ViewPoem.aspx?id=11152",""],[5943,"ياحزن قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=34654",""],[5943,"لوما اعتصامي","https://www.poetsgate.com/ViewPoem.aspx?id=92974",""],[5950,"سكّر","https://www.poetsgate.com/ViewPoem.aspx?id=128151",""],[5956,"الرَّنين","https://www.poetsgate.com/ViewPoem.aspx?id=184781",""],[6001,"خطاك الشر","https://www.poetsgate.com/ViewPoem.aspx?id=407",""],[6056,"صوت وصدى","https://www.poetsgate.com/ViewPoem.aspx?id=130319",""],[4442,"بالأعالي فتنت لا بالأسافل","https://www.poetsgate.com/ViewPoem.aspx?id=171204",""],[243,"المساء الأخير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68160&r=&rc=152",""],[6212,"صوت القادم من سواد الأسئلة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1628&r=&rc=9",""],[463,"أيقظني للبرقِ وهو نائمُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60187&r=&rc=243",""],[581,"أَطردتني حذر الهجاء ولا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69748&r=&rc=35",""],[6355,"ليلة الأمس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66688&r=&rc=148",""],[6356,"آخرُ شموعِ الخريفْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81908&r=&rc=9",""],[572,"عندي لأَضْيَافي إذا اشتدَّ السَّغَبْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9164&r=&rc=21",""]],"verses":[["أُطِرنَ مِنَ الأَينِ حَتّى بُري","نَ أَطرَ القِسيِّ وَبَريَ النِبالِ",0,"ل",1,0],["إِطراقَةٌ كَقُبوعِ الصِلِّ يَتبَعُها","عَزمٌ يَسورُ فَلا يُبقي وَلا يَذَرُ",1,"ر",1,0],["أَطَرتُ الكَرى عَنهُ وَقَد مالَ رَأسُهُ","كَما مالَ رَشّافُ الفِضالِ المُرَنّحُ",2,"ح",1,0],["أطربتهم بلحنها الأنغام","حين أدمت قلوبنا الآلام",3,"م",1,1],["أَطَرِبتَ أَن هَتَفَ الحَمامُ وَرُبَّما","أَبكاكَ بَعدَ هَواكَ شَجوُ حَمامِ",4,"م",1,0],["أَطَرنَا الحَشوَ والعُسفَاءَ عَنهُ","وَأَقعَصنَا جَبَابِرَ مُترَفِينَا",5,"ن",2,0],["اِطرَحوا الأَمرَ إِلَينا","وَاِحمِلوا الكُلَّ عَلَينا",6,"ن",2,1],["أطرق القلبُ ، وغامتْ أعيني","برؤاها ، وتجاهلتُ السؤالا",7,"ل",2,0],["أطريت غثَّك لا سمينك ضلَّةً","واخترت من خُلقَيْكَ غيرَ خيارِ",8,"ر",1,0],["أطرافَ كفٍّ فوق خدْ","دٍ منه ماء الحسن يَقْطرْ",9,"ر",1,0],["أطربَ القومَ ليس عودُك بل جو","دُك طوعاً بخبزك المخبوز",10,"ز",1,0],["أطرفه بالجود في دهر غدا عُطُلاً","من كل عرف فلم يُعدمك إطرافا",11,"ف",2,0],["أَطرَبَتنا الأَقلامُ لَمّا تَغَنَّت","بِالمُساواةِ بَينَنا وَالإِخاءِ",12,"ا",2,0],["اطردوه ولا تُصيخوا إليه","فهو روحٌ شريرةٌ ذاتُ نحْسِ",13,"س",1,0],["أطريت سيدة إلى ال","إطراء ليست بالفقيره",14,"ر",2,0],["اطَّرح واسترح فكل خليل","سوف يدنو ترابه من ترابك",15,"ك",1,0],["أطريقانِ طريقٌ دونَه","في حياتي وطريقٌ معه",16,"ه",1,0],["أَطِرْ عَنكَ نَوْمَكَ وانظُرْ إِلى","نَهارٍ أَفاضَ على اللَّيل نُورَه",17,"ر",2,0],["أَطَرفُهُ أَحسَنُ أَم ظِرفُهُ","أَو وَجهُهُ أَحسَنُ أَم عَقلُهُ",18,"ل",2,0],["اطرحْ وتاجا ما ترى","يا سيدي أحجيتُهْ",19,"ه",1,0],["أَطِرسُكَ أَم ثَغرٌ تَبَسَّمَ واضِحُ","وَلَفظُكَ أَم رَوضٌ تَنَفَّسَ نافِحُ",20,"ح",1,1],["اطْرُدْ دُعاةَ السُّوءِ عنه ولا تَدَعْ","في المؤمنين الصّادقين دسيسا",21,"س",2,0],["أَطرَيتُ أَبلَجَ مِن غَطارِفِ يَعرُبٍ","وَمَدَحتُ أَروَعَ مِن شُيوخِ نِزارِ",22,"ر",1,0],["أطريْتُ فيكِ وفي المختارِ مُؤمنةً","عَزَّتْ بأبلجَ ما تُحْصَى مَزَاياهُ",23,"ا",2,0],["أطْربَ السامعينَ ذِكْرُ عُلاهُ","يا لَرَاحٍ مَالَتْ بهَا النُّدَماءُ",24,"ا",2,0],["إِطراقُهُ مَطمَعٌ وَالوَصلُ مُمتَنِعٌ","فَأَنتَ مِنهُ عَلى الأَطماعِ وَالياسِ",25,"س",1,0],["أطرف بقدركَ لولا أنها عبرت","ولا يلاحظها نارٌ ولا دسمُ",26,"م",1,1],["أَطرِق كَرى لَيسَ لي عِلمٌ بِشَأنِ غَدٍ","وَلا لِغَيري وَلا يَزِنكَ إِطراقي",27,"ق",2,0],["أَطَرَدتَ عَنّا فارِساً ذا رُجلَةٍ","ساقَتهُ حاجَتُهُ وَلَيلٌ مُظلِمُ",28,"م",1,0],["أَطرِق كَأَنَّكَ في الدُنيا بِلا نَظَرٍ","وَاِصمُت كَأَنَّكَ مَخلوقٌ بِغَيرِ فَمِ",29,"م",1,1],["أَطرَبوني وَما اِبنُ سَبرَةَ في السَب","رَةِ إِلّا مَنِيَّةُ الأَطرَبونِ",30,"ن",1,0],["أطْرَبَتْنا ألْفاظُهُ طَرَبَ ال","عُشّاقِ للمُسْمِعاتِ بالألْحانِ",31,"ن",1,0],["أُطرَحُ بِالكَافِرِينَ في الدَرَكِ ال","أَسفَلِ يَا رِبِّ أصطَلي الصَرِما",32,"م",2,0],["أطر الشجاعة في الرجا","ل فتلك من خير الصفات",33,"ت",1,0],["أَطْرَبَتْنِي أَنْفَاسُهُ فَكَأَنِّي","مِلْتُ سُكْرَاً مِنْ جُرْعَةٍ مِنْ بِرَنْدِي",34,"د",2,0],["أَطْرَبَتْهُ وَهَذَّبَتْهُ وَحَثَّتْ","هُ عَلَى الصَّالِحَاتِ دُنْيَا وَدِينَا",35,"ن",2,0],["أطرق الطرف وغامت أعيني","برؤاها وتجاهلت السؤالا",36,"ل",2,0],["أطرت روح حياة العلم فانجذبت","وللمعارف روح تنشط الهمما",37,"م",2,0],["أطِرْ عنك نعوْمَكَ وانظُرْ إلى","نهارٍ أفاضَ على الليل نوره",38,"ر",2,0],["أطريت فتنتها فدع في غيّه","من راح يعذل حسنها ويفنّد",39,"د",1,0],["اطرنا العيس ثائرة اليكم","حثثناها لساحتكم حثيثا",40,"ث",2,1],["أَطَرفةُ ناظرٍ أسمَى","يُقلِّبُ في الوَرى جَفنا",41,"ن",2,0],["إطراقهُ يُخشىَ ويُرهَبُ صَمتُه","والسيفُ محذورٌ وإن لم يُشهَرِ",42,"ر",1,0],["أطرب من أرضاه عن طلابه","بذلا كأنما سقى الطلا به",43,"ب",2,0],["أَطَرِبتَ أَم رُفِعَت لَعَينِكَ غُدوَةً","بَينَ المَكَيمِنِ وَالزُجَيجِ حُمولُ",44,"ل",1,1],["أَطرَحُ قَلبي لِلهَوى مجمَرَه","فَغَمغَمَت غَلواءُ ما اكفَرَه",45,"ه",1,0],["أَطرب الحُبَّ كَي يكفَّن ماضي","هِ بِثَوبٍ من جِنسِهِ غير بالِ",46,"ل",1,0],["أَطْرَبَتْنِي أَلْفَاظُكُمْ وَقَدِيماً","أَطْرَبَتْنِي نَفَائِسُ الأَعْلاَقِ",47,"ق",1,0],["أَطَرتَ القلوبَ بهذا الجمالِ","وأوقَعتَهَا في الأسى والأَسف",48,"ف",1,0],["أطرفَةَ في العشرين فاجأك الرّدى","ويا ابن زُريقٍ متَّ من طولِ إهمال",49,"ل",1,0],["أَطرَبَتهُ عَينا مَضايا وَبَقَّي","نَ فَلِلَهِ تانِكَ العَينانِ",50,"ن",1,0],["أَطرَبَني صَوتُ حَمامٍ شَدا","كَأَنَّ في أَيكَتِهِ مَعبَدا",51,"د",2,1],["أطربت فردا يا زمان مزعزعا","ركنا به حزب الشهامة قد صفا",52,"ف",2,0],["أَطَرَقَ الطبيبُ فَلَمْ","يبتدئْ وَلم يعد",53,"د",1,0],["أطربت روحي وسري","حين أهدت لي التحية",54,"ه",1,0],["أطرقي أطرقي فقد ضمك الل","ل وألقى عليك ثوب ظلامه",55,"ه",1,1],["أطرقي فالحياة في قلبك المظ","لم ما تت موءودةً في حطامه",55,"ه",1,0],["أطرقه مستصرخا شاكيا","حيران بين العقل والحمق",56,"ق",1,0],["أطرق الشاكي ونام الموجَعُ","وانتَشى الليل بكاساتِ السكون",57,"ن",1,1],["أطربت محزون الهوى","وأثرت محطوم الجناح",58,"ح",1,0],["أطرقت في ضراعة تذكر الل","ه وفي صمتها يذوب النداء",59,"ا",2,1],["أطرقي يا صغيرتي واسأل رب","ك أن يسعد الحزين اللقاء",59,"ا",2,0],["أطرِفْ به سيفَ طَرْفٍ ما تَقلَّدَهُ","للفَتْكِ إلاّ وصُدْغاهُ نِجادان",60,"ن",1,0],["أطرقَ والفِكرَةُ للمُطرِقِ","فيما مَضى مِنهُ وما قَد بَقي",61,"ق",2,1],["أطرفُ ما تسمعُه في الوَرى","أني رأيتُ الشادنَ الأَحوَرا",62,"ر",2,1],["أَطَرْتُ لديه طائِرَ اليمن أسعداً","وكنَّا أطرنا طائر النحس أشأما",63,"م",2,0],["أطرَبتْنا الوُرقُ في ألحانها","يا فدتها في الغواني أُمُّ معبد",64,"د",1,0],["أطرّزُ باسمه بُرْدَ القوافي","كوشي البرد طرز بالذهاب",65,"ب",1,0],["أطرب إن شاهدته مطرباً","وما على المطرب فيه جناح",66,"ح",1,0],["أطرباني بذكرها يا نديميّ","وزيدا ولز ملاما وعدا",67,"د",2,0],["أطربْتَها وهْناً بذكركَ فانبرتْ","كالجأبِ أُنسّ بنائه المرتادِ",68,"د",1,0],["أَطَرْتَ إِلَى ناظِرَيْهِ عَجاجاً","تركتَ بِهِ عَقْلَهُ مُسْتَطارا",69,"ر",2,0],["أطربت من غير صوت مثلما","أفصحت من غير نطق بفم",70,"م",1,0],["أطرِّد سَرحَها في كلِّ يوم","شِلالا بين رابيةٍ ورَعنِ",71,"ن",1,0],["أطرتمُ منها إلى أعدائكم","أجادلا أوكارُها الجماجمُ",72,"م",1,0],["أطّر للأرض سهاماً لم يدع","جسمَ فلاةٍ بحصاها دارعا",73,"ع",2,0],["أطربني غناؤه","فقلتُعاشَ مَعْبَدُه",74,"د",2,0],["أطرَبها الدوحُ فناحتْ على","أفنانهِ وهو لها مُونِعُ",75,"ع",1,0],["أطرق بكفك بابا غير موصود","لم تستفزك إلا نخوة الصيد",76,"د",1,1],["اطرح الحجا فبه","كل عاقل تعب",77,"ب",1,0],["أطرقُ الحبَّ بقلبٍ خافقٍ","فأرى الدَّمعَ لدرعي يط