{"poems":[[53,"يا من عكفنا عليه لائذين به","https://www.aldiwan.net/poem66386.html","البسيط"],[347,"وليلة قضيتها في الاسى","https://www.aldiwan.net/poem55332.html","السريع"],[2909,"","https://poetry.dctabudhabi.ae/diwan/poem/96413","المتقارب"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103407","الطويل"],[3793,"","https://poetry.dctabudhabi.ae/diwan/poem/124786","الرجز"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111499","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4927,"الشبيح الصفوي","https://www.poetsgate.com/ViewPoem.aspx?id=80796",""]],"verses":[["وفي ادِّراعِكَ ثوباً منظرٌ حسنٌ","ولم يُحَسِّنْكَ مثلُ المَسْمَع الحَسَنِ",0,"ن",1,0],["وفي ادّكار الهجر يا ويلتي","ما اصعب الهجر على المبتلى",1,"ل",2,0],["وفي أدبٍ منهمُ ما نشأت","فنعم لعمركَ ما أدبوا",2,"ب",3,0],["وفي أددٍ حلم تزيَّنَ بالحجا","إذا الحلم أزهاه قطوبُ الحواجب",3,"ب",1,0],["وفي إدامٍ نفدَ الطعامُ","لم يبق إلاّ الرزّ والأَدام",4,"م",1,0],["وفي أدبة الأرباب مجداً تصدري","أبثكم من خبره شر مخبر",5,"ر",1,0],["وَفي ادِّكار الحادِثاتِ عِبَرٌ","يُسلى بِها عن مِثلِها وَيُؤتَسى",6,"ا",1,0],["وَفِيْ إِدْلِبَ الْخَضْرَاْءِ شَعْبٌ مُكَاْفِحٌ","حَلِيْمٌ كَرِيْمٌ لِلْوَفَاْءِ مُصَاْحِبُ",7,"ب",1,0]]}