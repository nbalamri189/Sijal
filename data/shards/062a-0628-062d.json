{"poems":[[29,"أكلفت تصعيد الحدوج الروافع","https://www.aldiwan.net/poem5914.html","الطويل"],[53,"تبحثت عن أخباره فكأنما","https://www.aldiwan.net/poem9224.html","الطويل"],[53,"تبحثت عن أخباره فكأنما","https://www.aldiwan.net/poem66449.html","الطويل"],[30,"رحلت إلى عبد الإله مطيتي","https://www.aldiwan.net/poem5196.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39561","السريع"],[102,"عينة جديدة من الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=50414",""],[53,"تَبحَّثتُ عن أخباره فكأنما","https://www.poetsgate.com/ViewPoem.aspx?id=30609",""],[280,"رأى الله ما أرضاه من سعيه الأسنى","https://www.aldiwan.net/poem25512.html","الطويل"],[280,"أوائل فتح ما لهن أواخر","https://www.aldiwan.net/poem25552.html","الطويل"],[534,"أيا بين كم كدرت صفو المشارب","https://www.aldiwan.net/poem37536.html","الطويل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145926","الرجز"],[1858,"","https://poetry.dctabudhabi.ae/diwan/poem/106706","المتقارب"],[2275,"","https://poetry.dctabudhabi.ae/diwan/poem/28058","الطويل"],[2332,"","https://poetry.dctabudhabi.ae/diwan/poem/82156","الطويل"],[4492,"","https://poetry.dctabudhabi.ae/diwan/poem/35421","البسيط"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120381","الطويل"],[4680,"الحلم المجنون","https://www.poetsgate.com/ViewPoem.aspx?id=199898",""],[4797,"عاصفة الحزم","https://www.poetsgate.com/ViewPoem.aspx?id=178128",""],[592,"لعمرك ما يدري الغبي بأنه","https://www.poetsgate.com/ViewPoem.aspx?id=128805",""]],"verses":[["تَبَحبَحَ هَذا المُلكُ في مُستَقَرِّهِ","فَلَيسَ إِلى قَومٍ سِواكُم بِراجِعِ",0,"ع",1,0],["تبحّثْتُ عن أخبارِه فكأنما","نبشتُ صداهُ بعد مرِّ ثَلاثِ",1,"ث",1,1],["تَبحَّثتُ عن أخباره فكأنما","نَبَشْتُ صداه بعد ثالثة الدَّفْنِ",2,"ن",1,1],["تَبَحبَحتُمُ مَن بِالجِبابِ وَسِرِّها","طَمَت بِكُمُ بَطحاؤُها وَالظَواهِرُ",3,"ر",1,0],["تبحثُ عن نجمٍ بتلك الرجامْ","هوتْ به الأقدارُ عن أفقهِ",4,"ه",1,0],["تبحث الأحزان في الأحزان عن","وتر باك وعن حلق ربابة",5,"ب",2,0],["تَبحَّثتُ عن أخباره فكأنما","نَبَشْتُ سداه بعد ثالثة الدَّفْنِ",6,"ن",1,1],["تَبَحْبَحَ في السُّلْطانِ والمَجْدِ والعُلَى","فَمَظْهَرُهُ الأَسْمَى وعُنْصُره الأَسْنَى",7,"ن",2,0],["تَبَحْبَحَ في العَليا فَطَابَتْ شَمائِلٌ","مُقَدَّسةٌ مِنْهُ وطَابَتْ عَناصِرُ",8,"ر",1,0],["تَبَحْبَحَ في بَحْبوحَةِ العِزِّ وارْتَدَى","بمُطْرفِ مَجْدٍ في صَمِيمِ المناصِبِ",9,"ب",1,0],["تبحَثُ عن وليدِها فلمْ تجدْ","سِوى بقاياهُ على الوسَادْ",10,"د",1,0],["تُبحبِحُ هذي البلادُ بما","لهُ من جُنودٍ ومكرٍ مُذال",11,"ل",1,0],["تَبَحبَحتَ في بَحبُوحَةِ المَجدِ مِنهُمُ","بِرابِيَةٍ تَعلو الرَوابِيَ مِن عَلُ",12,"ل",1,0],["تبحثتم سخطي فغير بحثكم","نخيلة نفس كان نصحاً ضميرها",13,"ر",3,1],["تبحر الحُبّ في مَعنايَ فَاِنبَجَسَت","عَينايَ مِنهُ بِسيحون وَجيحونِ",14,"ن",1,0],["تبحر في كل الفنون وكم بها","ابر على من سابقوا في اطلاعها",15,"ع",3,0],["تبحث عن سوف بما كان","وعن كان بما سوف يكونْ",16,"ن",1,0],["تبحث يديها القاع عرض وتنفر","وذيولها فوق العراقيب شلال",17,"ل",1,0],["تبحر في كل الفنون فلم يكن","يشق له فيها غبار ولن وماه",18,"م",3,0]]}