{"poems":[[53,"ومعتذر من نعمة قد أفادها","https://www.aldiwan.net/poem65998.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85498","الكامل"],[164,"كفاك سرورا بالحسين قدومه","https://www.aldiwan.net/poem59062.html","الطويل"],[168,"لا تركنن إلى الهوى","https://www.aldiwan.net/poem67809.html","مجزوء الكامل"],[398,"من لقلب يهيم في كل وادي","https://www.aldiwan.net/poem53585.html","الخفيف"],[409,"الحمد كل الحمد للخلاق","https://www.aldiwan.net/poem33620.html","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48670","الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56634","الوافر"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86287","الطويل"],[5026,"بوابة تطل على الأمنيات","https://www.poetsgate.com/ViewPoem.aspx?id=210777",""],[5431,"على الغيم من ثقب الجدار أبصبصُ","https://www.poetsgate.com/ViewPoem.aspx?id=197644",""],[5550,"لا تكنْ","https://www.poetsgate.com/ViewPoem.aspx?id=215331",""],[5751,"أنا وأنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=215023",""],[5956,"من الجلوس اللّا سليم ظهر نجلي اْحدَودَب","https://www.poetsgate.com/ViewPoem.aspx?id=194784",""]],"verses":[["سيضطرني حتى أكررَ مدحَه","تتابعُ كرَّاتٍ له بالفواضلِ",0,"ل",1,0],["سَيُضيف مجداً حادِثاً","منه إِلى مجد قدام",1,"م",1,0],["سيضرب أعناق الكماة بسيفه","ويحمى لديك الدين ممن يضيمه",2,"م",2,0],["سَيَضيقُ مُتَّسَعُ المَلا","بِالمُخرَجينَ مِنَ المَلاءِ",3,"ا",2,0],["سَيَضحّي فيهِ بِمَن لا يُوالي","هِ وَيَبقى بَقِيَّة الأَعيادِ",4,"د",1,0],["سيضم هذا ربنا من فوقها","فتكون عشر الألف للإِنفاق",5,"ق",1,0],["سيضم جمعَهم لواءٌ واحدٌ","وتقوم وحدك فيهمُ متحكِّما",6,"م",2,0],["سيضى المنزل الداني بعيداً","ويمسي المنزل النائي قريباً",7,"ب",2,0],["سَيَضمَن اِحزاني عَلى فَقدِهِ البَقا","وَيكفَلها مِنّي عَلَيهِ دَوام",8,"م",1,0],["سيُضَمِّدُ الأملُ الجراحَ سيحْتسي","قَلْبي فَناجينَ المُنى والمِنَّهْ",9,"ن",2,0],["سيضحك قمح القلب إنْ فاض غيمه","عيونٌ به نشوى وبالغيم تشْخَصُ",10,"ص",1,0],["سيضيق الوجودُ يوْمًا بمنْ في","طلب المَجْد ما مَشى قطُّ مِيلا",11,"ل",2,0],["سيُضيء حتماً ذلك الأملُ","وتغردُ الأحلامُ والقُبلُ",12,"ل",1,1],["سيضيع وقته ألف ضعفٍ في الضنا","ما بين مشفىً أبعداً أو أقربا",13,"ب",2,0]]}