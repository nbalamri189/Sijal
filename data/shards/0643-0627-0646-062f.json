اء العلى والمكارم","https://www.aldiwan.net/poem25526.html","الطويل"],[280,"ألم تك للملوك الغر تاجا","https://www.aldiwan.net/poem60700.html","الوافر"],[282,"يا راكب الناقة الوجناء يزجيها","https://www.aldiwan.net/poem32302.html","البسيط"],[282,"سرى طيف علوة من بانياسا","https://www.aldiwan.net/poem32735.html","المتقارب"],[282,"إليك المطايا أعنقت يا محمد","https://www.aldiwan.net/poem32811.html","الطويل"],[282,"ما شد أزرار القبا","https://www.aldiwan.net/poem32867.html","مجزوء الرجز"],[305,"عظم الأجر عن عظيم المصاب","https://www.aldiwan.net/poem56609.html","الكامل"],[322,"ألا طال التنظر والثواء","https://www.aldiwan.net/poem56353.html","الوافر"],[364,"شفته تحيات العيون العلائل","https://www.aldiwan.net/poem60810.html","الطويل"],[364,"أحضر الليل منك عقدا وثغرا","https://www.aldiwan.net/poem60893.html","الخفيف"],[377,"كأن دموع النفس في نحرها سلك","https://www.aldiwan.net/poem59304.html","الطويل"],[405,"كان ينابيع الثرى ثدي مرضع","https://www.aldiwan.net/poem49510.html","الطويل"],[410,"ويوم عسول الآل حام كأنما","https://www.aldiwan.net/poem67532.html","الطويل"],[412,"وحقة مسك مِن نساء لبسته","https://www.aldiwan.net/poem44.html","الطويل"],[432,"كأن دارين لها دار","https://www.aldiwan.net/poem12610.html","السريع"],[439,"لك الفوز من صوم زكي ومن فطر","https://www.aldiwan.net/poem34870.html","الطويل"],[441,"وداعاً أيها الطهر النبي","https://www.aldiwan.net/poem14344.html","الوافر"],[452,"لعينيك في الأحشاء ما نفث السحر","https://www.aldiwan.net/poem13762.html","الطويل"],[453,"شربت فلسفتي من نبع آلامي","https://www.aldiwan.net/poem61251.html","البسيط"],[458,"من الغادي تحط به وتعلو","https://www.aldiwan.net/poem56250.html","الوافر"],[461,"أقول ودمعي مستهل وددتني","https://www.aldiwan.net/poem15113.html","الطويل"],[461,"ألا حبذا مسعى تميم بن خندف","https://www.aldiwan.net/poem15149.html","الطويل"],[464,"ويوم كظل السمهري قصرته","https://www.aldiwan.net/poem3348.html","عموديه"],[464,"صبر قلبي عان ودمعي طليق","https://www.aldiwan.net/poem3398.html","عموديه"],[464,"فؤادي وفودي بعد لمياء أشيب","https://www.aldiwan.net/poem3559.html","عموديه"],[468,"أنحلني بصده","https://www.aldiwan.net/poem60183.html","مجزوء الرجز"],[477,"دع العيس ترفل في الفدفد","https://www.aldiwan.net/poem15189.html","المتقارب"],[477,"أقفر من سكانه المعهد","https://www.aldiwan.net/poem15224.html","السريع"],[500,"هذا الوجود على مجلاك إيماء","https://www.aldiwan.net/poem38106.html","البسيط"],[514,"تلثم بالعقيق على اللآلي","https://www.aldiwan.net/poem20793.html","الوافر"],[514,"بقيت بقاء الدهر يا بهجة الدهر","https://www.aldiwan.net/poem20808.html","الطويل"],[553,"كأن درا إذا هي ابتسمت","https://www.aldiwan.net/poem68319.html","المنسرح"],[567,"داو خماري بكأس خمر","https://www.aldiwan.net/poem69458.html","مخلع البسيط"],[567,"دخيل في الكتابة لا روي","https://www.aldiwan.net/poem69470.html","الوافر"],[586,"لا خلت من سناكم الأحياء","https://www.aldiwan.net/poem17398.html","الخفيف"]],"verses":[["كأنّ دِيارَ العامريّةِ باللِّوى","صَحائِفُ تَطويها اللّيالي وتَنْشُرُ",0,"ر",1,0],["كأنَّ دِيارَ الحَيِّ في جَنَباتها","صَحائِفُ والرَّكْبَ الوُقوفَ بِها سَطْرُ",1,"ر",1,0],["كَأَنَّ دُفوفَ مَرجِعِ مِرفَقَيهِ","تَوارَثَها مَنازيعُ السِهامِ",2,"م",1,0],["كَأَنَّ دِماءَ الفُرسِ حينَ تَحَدَّرَت","خَلوقُ العَذارى أَو قُباءَ مُدَبَّجُ",3,"ج",1,0],["كَأَنَّ دُخانَ الرَمثِ خالَطَ لَونَهُ","يُغَلُّ بِهِ مِن باطِنٍ وَيُجَلَّلُ",4,"ل",1,0],["كَأَنَّ دَمَ الأَعفاجِ مِن فَوق متنِهِ","عُصارَةُ حِنّاءٍ بِشَيبٍ مُرَجَّلِ",5,"ل",1,0],["كَأَنَّ دِماءَ الهادِياتِ بِنَحرِهِ","عُصارَةُ حِنّاءٍ بِشَيبٍ مُرَجَّلِ",6,"ل",1,0],["كَأَنَّ دِماءَ الهادِياتِ بِنَحرِهِ","عُصارَةُ حَنّاءٍ بِشَيبٍ مُخَضَّبِ",7,"ب",1,0],["كَأَنَّ دُمى شَغفٍ عَلى ظَهرِ مَرمَرٍ","كَسا مُزبِدَ الساجومِ وَشياً مُصَوَّرا",8,"ر",2,0],["كَأَنَّ دِثاراً حَلَّقَت بِلَبونِهِ","عُقابُ تَنوفى لا عُقابُ القَواعِلِ",9,"ل",1,0],["كَأَنَّ دِماءَ الهادِياتِ بِنَحرِهِ","عُصارَةَ حِنّاءٍ بِشَيبٍ مُفَرَّقِ",10,"ق",1,0],["كَأَنَّ دُموعَ العَينِ واهِيَةُ الكُلى","وَعَت ماءَ غَربٍ يَومَ ذاكَ سَجيلِ",11,"ل",1,0],["كَأَنَّ دُموعَ العَينِ لَمّا تَخَلَّلَت","مَخارِمَ بيضاً مِن تَمَنّي جِمالُها",12,"ل",3,0],["كَأَنَّ دُموعَ عَيني يَومَ بانَت","دَلاةٌ بَلَّها فَرَطٌ مَهيجُ",13,"ج",1,0],["كَأَنَّ دَهْراً رَمَاهُ","رَمَى الْعُلَى فِي الصَّمِيمِ",14,"م",1,0],["كَأَنَّ دَوِيَّهُ مِن بَعدِ هَدءٍ","دَوِيُّ غِناءِ أَروَعَ مُستَهامِ",15,"م",1,0],["كَأَنَّ دِيارَ الحَيِّ بِالزُرقِ خَلقَةٌ","مِنَ الأَرضِ أَو مَكتوبَةٌ بِمِدادِ",16,"د",1,1],["كَأَنَّ دَفَّتَيهِ إِذ تَزَيّدا","مَوجانِ طَلاً لِلجُنوبِ مُطَرِدا",17,"د",2,0],["كَأَنَّ دِيارَ الحَيِّ مِن قِدَمِ البِلى","قَراطيسُ رُهبانٍ أَحالَت سُطورُها",18,"ر",3,0],["كَأَنَّ دِياراً بَينَ أَسنِمَةِ النَقا","وَبَينَ هَذاليلِ النَحيزَةِ مُصحَفُ",19,"ف",1,0],["كَأَنَّ دُموعَهُ غَربا سُناةٍ","يُحيلونَ السِجالَ عَلى السِجالِ",20,"ل",1,0],["كَأَنَّ دِمائَهُم تَجري كُمَيتاً","وَوَرداً قانِئً شَعَرٌ مَدوفُ",21,"ف",1,1],["كأنَّ دروجَ الخطّ منه لحسنها","خصورُ ملاحٍ يستبين انْدماجها",22,"ج",3,0],["كان دمعي على هواك لجيناً","فأحالته نارُ قلبي نضارا",23,"ر",2,0],["كأن دموعي في ثيابي بهجره","عصارة حناءٍ بشيبٍ مرجّل",24,"ل",1,0],["كأنّ ديار الملك غاب إذا انقضى","به ضيغمٌ أنشابهُ الدهر ضيغما",25,"م",2,0],["كأن داوود كان يومئذٍ","يتلو زبوراً مُلَيِّنَ الزبرِ",26,"ر",1,0],["كأنَّ دويَّ النحل أخرى دويِّها","إذا ما حفيف الريح أوعاه مسمعا",27,"ع",2,0],["كَأَنَّ دَنانيراً تَسّاقَطُ فَوقَهُ","وَلَيسَ دَنانيرٌ سِوى الوَرَقِ النَضرِ",28,"ر",1,0],["كَأَنَّ دَوِيَّ الحَليِ تَحتَ ثِيابِها","حَصادُ السَنا لاقى الرِياحَ الزَعازِعا",29,"ع",2,0],["كَأَنَّ دُموعَ العَينِ يَومَ تَحَمَّلَت","بُثَينَةُ يَسقيها الرِشاشَ مَعينُ",30,"ن",1,0],["كأنَّ دموعَ العاشقينَ تَرقرقَتْ","بِأَكْؤُسها تَجري على كلِّ شاربِ",31,"ب",1,0],["كَأَنَّ دُجاهُ يَجذِبُها سُهادي","فَلَيسَ تَغيبُ إِلّا أَن يَغيبا",32,"ب",2,0],["كَأَنَّ دَمَ الجَماجِمِ في العَناصي","كَسا البُلدانَ ريشَ الحَيقُطانِ",33,"ن",1,0],["كَأَنَّ دَلوحاً تُرتَقى في صُعودِها","يُصيبُ مَسيلَي مُقلَتَيَّ سِلامُها",34,"م",3,0],["كأنَّ دُهْماً تبارَتْ في السِّباقِ به","دُهْمُ الجِيادِ تبارَتْ في المَضاميرِ",35,"ر",1,0],["كأنَّ دُولابَها إذ حَنَّ مُغتَرِبٌ","نأى فَحنَّ إلى أوطانِه طَرَبا",36,"ب",2,0],["كَأَنَّ دَبيبَ النَملِ في جونِ مَتنِهِ","وَلَم يَرَ قَومٌ نَجلَ مازِنَ في المُزنِ",37,"ن",1,0],["كَأَنَّ دُجَى اللَّيلِ لمَّا استَرق","نَمومٌ مِنَ الصُّبحِ يُفْشي سَريرَه",38,"ر",2,0],["كانَ داءَ الإِشراكِ سَيفُكَ وَاِشتَد","دَت شَكاةُ الهُدى فَكُنتَ طَبيبا",39,"ب",2,0],["كَأَنَّ دُموعَ العَينِ تَسقي جُفونَها","غَداةَ رَأَت أَظعانَ لَيلى غَوادِيا",40,"د",3,0],["كَأَنَّ دُموعَ العَينِ يَومَ تَحَمَّلوا","جُمانٌ عَلى جَنبِ القَميصِ يَسيلُ",41,"ل",1,0],["كَأنَّ دُمُوع العَينِ مِنِّي لَفَقدِهِ","عَلَى أمَد الأيَّامِ تَجرِي بِطُوفَانِ",42,"ن",1,0],["كَأَنَّ دَلِيلَهُنَّ بِهنَّ يَهدى","جَوازئَ مِن نِعاجِ الرَملِ عِينا",43,"ن",2,0],["كَأَنَّ دُموعي سَحُّ واهِيَةِ الكُلى","سَقاها فَرَوّاها مِنَ العَينِ مُخلِفُ",44,"ف",1,0],["كَأَنَّ ديباجَةً في وَجهِهِ نَشَرَت","تَطريزَةً حَثَّها في حُسنِ تَطريزِ",45,"ز",1,0],["كَأَنَّ دِماءَ القَومِ يَومَ لِقائِهِ","رُداعُ عَروسٍ بِالذِراعَينِ وَالنَحرِ",46,"ر",1,0],["كَأَنَّ دُنياكَ ماءُ حَوضٍ","آخِرُهُ آجِنٌ خَبيطُ",47,"ط",1,0],["كأنّ دُعاء الموتِ باسْمِكَ نَكْزَةٌ","فَرَتْ جَسَدي والسّمُّ يُنفثُ في أُذني",48,"ن",2,0],["كأن دجلة إذ بارحت ضفتها","ضاقَت عَلى رحبها في عين محزون",49,"ن",1,0],["كأنَّ دُجاهُ الهجْرُ والصّبْحُ موْعِدٌ","بوَصْلٍ وضَوْءُ الفجرِ حِبٌّ مُماطل",50,"ل",1,0],["كأَنَّ دُفوقَ جَونٍ تَعتَريِه","تُجانِبُ قاصِباً فَحَنِينَ نِيبِ",51,"ب",1,0],["كانَ دَمعي قَبلَ فُقداني لَهُ","في يَدِ الصَبرِ أَسيراً فَاِنطَلَق",52,"ق",1,0],["كَأنَّ دَاوُدَ أَلْقَى عِنْدَ بَرْيَتِهِ","أَثَارَةً مِنْ تَرَانِيمٍ وَأسْرَارِ",53,"ر",1,0],["كأندلُسِ لَمَّا تَدَهْوَرَ مُلْكُها","مُكَنّى جُزافاً عِندنَا ومُلَقَّب",54,"ب",1,0],["كأن دماء الهدايات بنحرهِ","عُصَارَة ُ حِنّاءٍ بِشَيْبٍ مُفَرَّقِ",55,"ق",1,0],["كأنّ دنانير تساقط فوقه","وليس دنانير سوى الورق النّضر",56,"ر",1,0],["كأنَّ دَويَّ النحلِ أحرى دويَّها","إذا ما حفيفُ الريح أوْعاه مَسمعا",57,"ع",2,0],["كأنَّ دماءَ الفرسِ حين تحادرتْ","خلوقُ العذارى أو خباءُ مدبجُ",58,"ج",1,0],["كَأنَّ دُمُوعَ العَينِ وَطفاءُ قَد مَرَى","قَوادِمَها مَرُّ الجَنُوبِ هتُونَا",59,"ن",2,0],["كأن ديوانك في عينهِ","رسالةٌ من عندِ عزريلِ",60,"ل",1,0],["كأَنَّ دُجى الشَّكِّ في سُخْطِها","وَضَوْءَ الرِّضَا فِي بَياضِ اليَقِينِ",61,"ن",1,0],["كأَنَّ دَمْعِي عَلَى خَدَّي وَصُفْرَتَهُ","حَبَابُ دَمْعِ النَّدى مِنْ حَوْلِ نِسْرِيْنِ",62,"ن",1,0],["كأَنَّ دُمُوعي عَلَى وَجْنَتِي","لُجَيْنٌ عَلَى ذَهَبٍ مُحْرَقُ",63,"ق",1,0],["كأَنَّ دَمي يومَ الفِراقِ سَرَوْا بِهِ","وَقَدْ سفكُوهُ بِاحتِثَاثِ الرَّكائِبِ",64,"ب",1,1],["كأن دموعي ضَرَّجت وَجَناتِه","إذا فاض منها للبكاء نَجيع",65,"ع",1,0],["كانَ دَيناً في ذمَّة الدهرِ هذا ال","فتحُ وَاليومَ حلّ منه الأداءُ",66,"ا",2,0],["كأن دموعي تبصر الوصل هارباً","فمن أجل ذا تجري لتدركه سبقا",67,"ق",2,0],["كأن دارك رأس الرجا","ء وداري في بعدها الموصل",68,"ل",1,0],["كأنّ دموعي على وجهه","نِظام جُمانٍ وَهَي عِقْدُه",69,"د",2,0],["كأن دم العدا فيه شقيق","جرت في ضمنه للماء عين",70,"ن",1,0],["كأنّ دِيباجَتَي خَدَّيهِ مِن ذَهَبٍ","إذا تَشَرَّفَ في أثوابِهِ السُّودِ",71,"د",1,0],["كأَنَّ دِلاءً مِنْ جُفونِيَ أُفْرِغَتْ","فَلا نُكْرَ إِنْ لَمْ يَعْرِفُوا الفَرْغَ وَالدَّلوَا",72,"و",2,0],["كَأَنَّ دَماً أذْكَى أَديم تُرَابِها","وقَدْ مَازَجَتْهُ الرّيحُ مِسْكُ اللطائِمِ",73,"م",1,0],["كَأَنَّ دَبىً وَرِجْلاً مِنْ جَرادٍ","بِها وَالْغابَ يُرْقِلُ وَالْحِراجا",74,"ج",2,0],["كَأَنَّ دَوحاتِهِ الفازاتُ إِذ ضُرِبَت","مِن سُندُسٍ فَحَكَت مَعشوقَ رائيها",75,"ي",3,0],["كَأَنَّ دُجاها غُرابٌ تَنَف","فَضَ إِذ أَعيُنُ السُحبِ تَهمي اِنبِجاسا",76,"س",2,0],["كَأَنَّ دُموعي لاشتِياقي لَآلِئٌ","فَمِن بَينِ أَصدافِ الجُفونِ تُبَدَّدُ",77,"د",1,0],["كَأَنَّ دُرَّ ثَغرِهِ","نَظَّمَ فيهِ الحَبَبا",78,"ب",2,0],["كان دونَ الخطورِ حولَ حماها","عودُ عصرِ الصبا وشيب الغرابِ",79,"ب",1,0],["كَأَنَّ دِفافَ مَأدبُةٍ وَعُرسٍ","وَرَجّازٍ يُجاوِبُهُ الحُداءُ",80,"ا",2,0],["كأنّ ديارَ المُمطَرينَ حجارةٌ","جَعلْتَ أعاليها مَكانَ الأسافل",81,"ل",1,0],["كان دَهْري ليلاً فقيراً إلى أنْ","أَطلَعَ اللهُ للوَرى فيه بَدرا",82,"ر",2,0],["كأن دموع النفس في نحرها سِلكُ","غداةَ يناديها الفراقُ وهي تشكو",83,"ك",2,1],["كأنَّ دَواتي مُطْفِلٌ حَبشيَّةٌ","بَناني لَها بَعْلٌ ونَفْسي لَهَا نَسْلُ