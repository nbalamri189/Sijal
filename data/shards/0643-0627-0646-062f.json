om/ViewPoem.aspx?id=178449",""],[5628,"إليك يا من تتفجّر نارا ونورا","https://www.poetsgate.com/ViewPoem.aspx?id=178471",""],[5660,"لَعَمرُكَ ما يُغني البُكى وَ التَوَجُّعُ","https://www.poetsgate.com/ViewPoem.aspx?id=28435",""],[5660,"صَليلُ السَّيفِ لا يُرجى سِواهُ","https://www.poetsgate.com/ViewPoem.aspx?id=32089",""],[5855,"بوادر دمعك ما تنزف","https://www.poetsgate.com/ViewPoem.aspx?id=186553",""],[5957,"ثناء","https://www.poetsgate.com/ViewPoem.aspx?id=179803",""],[6024,"قوس الحاجب","https://www.poetsgate.com/ViewPoem.aspx?id=186344",""]],"verses":[["كأنّ دِيارَ العامريّةِ باللِّوى","صَحائِفُ تَطويها اللّيالي وتَنْشُرُ",0,"ر",1,0],["كأنَّ دِيارَ الحَيِّ في جَنَباتها","صَحائِفُ والرَّكْبَ الوُقوفَ بِها سَطْرُ",1,"ر",1,0],["كَأَنَّ دُفوفَ مَرجِعِ مِرفَقَيهِ","تَوارَثَها مَنازيعُ السِهامِ",2,"م",1,0],["كَأَنَّ دِماءَ الفُرسِ حينَ تَحَدَّرَت","خَلوقُ العَذارى أَو قُباءَ مُدَبَّجُ",3,"ج",1,0],["كَأَنَّ دُخانَ الرَمثِ خالَطَ لَونَهُ","يُغَلُّ بِهِ مِن باطِنٍ وَيُجَلَّلُ",4,"ل",1,0],["كَأَنَّ دَمَ الأَعفاجِ مِن فَوق متنِهِ","عُصارَةُ حِنّاءٍ بِشَيبٍ مُرَجَّلِ",5,"ل",1,0],["كَأَنَّ دِماءَ الهادِياتِ بِنَحرِهِ","عُصارَةُ حِنّاءٍ بِشَيبٍ مُرَجَّلِ",6,"ل",1,0],["كَأَنَّ دِماءَ الهادِياتِ بِنَحرِهِ","عُصارَةُ حَنّاءٍ بِشَيبٍ مُخَضَّبِ",7,"ب",1,0],["كَأَنَّ دُمى شَغفٍ عَلى ظَهرِ مَرمَرٍ","كَسا مُزبِدَ الساجومِ وَشياً مُصَوَّرا",8,"ر",2,0],["كَأَنَّ دِثاراً حَلَّقَت بِلَبونِهِ","عُقابُ تَنوفى لا عُقابُ القَواعِلِ",9,"ل",1,0],["كَأَنَّ دِماءَ الهادِياتِ بِنَحرِهِ","عُصارَةَ حِنّاءٍ بِشَيبٍ مُفَرَّقِ",10,"ق",1,0],["كَأَنَّ دُموعَ العَينِ واهِيَةُ الكُلى","وَعَت ماءَ غَربٍ يَومَ ذاكَ سَجيلِ",11,"ل",1,0],["كَأَنَّ دُموعَ العَينِ لَمّا تَخَلَّلَت","مَخارِمَ بيضاً مِن تَمَنّي جِمالُها",12,"ل",3,0],["كَأَنَّ دُموعَ عَيني يَومَ بانَت","دَلاةٌ بَلَّها فَرَطٌ مَهيجُ",13,"ج",1,0],["كَأَنَّ دَهْراً رَمَاهُ","رَمَى الْعُلَى فِي الصَّمِيمِ",14,"م",1,0],["كَأَنَّ دَوِيَّهُ مِن بَعدِ هَدءٍ","دَوِيُّ غِناءِ أَروَعَ مُستَهامِ",15,"م",1,0],["كَأَنَّ دِيارَ الحَيِّ بِالزُرقِ خَلقَةٌ","مِنَ الأَرضِ أَو مَكتوبَةٌ بِمِدادِ",16,"د",1,1],["كَأَنَّ دَفَّتَيهِ إِذ تَزَيّدا","مَوجانِ طَلاً لِلجُنوبِ مُطَرِدا",17,"د",2,0],["كَأَنَّ دِيارَ الحَيِّ مِن قِدَمِ البِلى","قَراطيسُ رُهبانٍ أَحالَت سُطورُها",18,"ر",3,0],["كَأَنَّ دِياراً بَينَ أَسنِمَةِ النَقا","وَبَينَ هَذاليلِ النَحيزَةِ مُصحَفُ",19,"ف",1,0],["كَأَنَّ دُموعَهُ غَربا سُناةٍ","يُحيلونَ السِجالَ عَلى السِجالِ",20,"ل",1,0],["كَأَنَّ دِمائَهُم تَجري كُمَيتاً","وَوَرداً قانِئً شَعَرٌ مَدوفُ",21,"ف",1,1],["كأنَّ دروجَ الخطّ منه لحسنها","خصورُ ملاحٍ يستبين انْدماجها",22,"ج",3,0],["كان دمعي على هواك لجيناً","فأحالته نارُ قلبي نضارا",23,"ر",2,0],["كأن دموعي في ثيابي بهجره","عصارة حناءٍ بشيبٍ مرجّل",24,"ل",1,0],["كأنّ ديار الملك غاب إذا انقضى","به ضيغمٌ أنشابهُ الدهر ضيغما",25,"م",2,0],["كأن داوود كان يومئذٍ","يتلو زبوراً مُلَيِّنَ الزبرِ",26,"ر",1,0],["كأنَّ دويَّ النحل أخرى دويِّها","إذا ما حفيف الريح أوعاه مسمعا",27,"ع",2,0],["كَأَنَّ دَنانيراً تَسّاقَطُ فَوقَهُ","وَلَيسَ دَنانيرٌ سِوى الوَرَقِ النَضرِ",28,"ر",1,0],["كَأَنَّ دَوِيَّ الحَليِ تَحتَ ثِيابِها","حَصادُ السَنا لاقى الرِياحَ الزَعازِعا",29,"ع",2,0],["كَأَنَّ دُموعَ العَينِ يَومَ تَحَمَّلَت","بُثَينَةُ يَسقيها الرِشاشَ مَعينُ",30,"ن",1,0],["كأنَّ دموعَ العاشقينَ تَرقرقَتْ","بِأَكْؤُسها تَجري على كلِّ شاربِ",31,"ب",1,0],["كَأَنَّ دُجاهُ يَجذِبُها سُهادي","فَلَيسَ تَغيبُ إِلّا أَن يَغيبا",32,"ب",2,0],["كَأَنَّ دَمَ الجَماجِمِ في العَناصي","كَسا البُلدانَ ريشَ الحَيقُطانِ",33,"ن",1,0],["كَأَنَّ دَلوحاً تُرتَقى في صُعودِها","يُصيبُ مَسيلَي مُقلَتَيَّ سِلامُها",34,"م",3,0],["كأنَّ دُهْماً تبارَتْ في السِّباقِ به","دُهْمُ الجِيادِ تبارَتْ في المَضاميرِ",35,"ر",1,0],["كأنَّ دُولابَها إذ حَنَّ مُغتَرِبٌ","نأى فَحنَّ إلى أوطانِه طَرَبا",36,"ب",2,0],["كَأَنَّ دَبيبَ النَملِ في جونِ مَتنِهِ","وَلَم يَرَ قَومٌ نَجلَ مازِنَ في المُزنِ",37,"ن",1,0],["كَأَنَّ دُجَى اللَّيلِ لمَّا استَرق","نَمومٌ مِنَ الصُّبحِ يُفْشي سَريرَه",38,"ر",2,0],["كانَ داءَ الإِشراكِ سَيفُكَ وَاِشتَد","دَت شَكاةُ الهُدى فَكُنتَ طَبيبا",39,"ب",2,0],["كَأَنَّ دُموعَ العَينِ تَسقي جُفونَها","غَداةَ رَأَت أَظعانَ لَيلى غَوادِيا",40,"د",3,0],["كَأَنَّ دُموعَ العَينِ يَومَ تَحَمَّلوا","جُمانٌ عَلى جَنبِ القَميصِ يَسيلُ",41,"ل",1,0],["كَأنَّ دُمُوع العَينِ مِنِّي لَفَقدِهِ","عَلَى أمَد الأيَّامِ تَجرِي بِطُوفَانِ",42,"ن",1,0],["كَأَنَّ دَلِيلَهُنَّ بِهنَّ يَهدى","جَوازئَ مِن نِعاجِ الرَملِ عِينا",43,"ن",2,0],["كَأَنَّ دُموعي سَحُّ واهِيَةِ الكُلى","سَقاها فَرَوّاها مِنَ العَينِ مُخلِفُ",44,"ف",1,0],["كَأَنَّ ديباجَةً في وَجهِهِ نَشَرَت","تَطريزَةً حَثَّها في حُسنِ تَطريزِ",45,"ز",1,0],["كَأَنَّ دِماءَ القَومِ يَومَ لِقائِهِ","رُداعُ عَروسٍ بِالذِراعَينِ وَالنَحرِ",46,"ر",1,0],["كَأَنَّ دُنياكَ ماءُ حَوضٍ","آخِرُهُ آجِنٌ خَبيطُ",47,"ط",1,0],["كأنّ دُعاء الموتِ باسْمِكَ نَكْزَةٌ","فَرَتْ جَسَدي والسّمُّ يُنفثُ في أُذني",48,"ن",2,0],["كأن دجلة إذ بارحت ضفتها","ضاقَت عَلى رحبها في عين محزون",49,"ن",1,0],["كَأَنَّ دُبَّاءَةً شُدَّ الحِزَامُ بِهَا","في جَوْفِ أَهْوَجَ بِالتَّقْرِيبِ والحَضَرِ",50,"ر",1,0],["كأنَّ دُجاهُ الهجْرُ والصّبْحُ موْعِدٌ","بوَصْلٍ وضَوْءُ الفجرِ حِبٌّ مُماطل",51,"ل",1,0],["كأَنَّ دُفوقَ جَونٍ تَعتَريِه","تُجانِبُ قاصِباً فَحَنِينَ نِيبِ",52,"ب",1,0],["كانَ دَمعي قَبلَ فُقداني لَهُ","في يَدِ الصَبرِ أَسيراً فَاِنطَلَق",53,"ق",1,0],["كَأنَّ دَاوُدَ أَلْقَى عِنْدَ بَرْيَتِهِ","أَثَارَةً مِنْ تَرَانِيمٍ وَأسْرَارِ",54,"ر",1,0],["كأندلُسِ لَمَّا تَدَهْوَرَ مُلْكُها","مُكَنّى جُزافاً عِندنَا ومُلَقَّب",55,"ب",1,0],["كأن دماء الهدايات بنحرهِ","عُصَارَة ُ حِنّاءٍ بِشَيْبٍ مُفَرَّقِ",56,"ق",1,0],["كأنّ دنانير تساقط فوقه","وليس دنانير سوى الورق النّضر",57,"ر",1,0],["كأنَّ دَويَّ النحلِ أحرى دويَّها","إذا ما حفيفُ الريح أوْعاه مَسمعا",58,"ع",2,0],["كأنَّ دماءَ الفرسِ حين تحادرتْ","خلوقُ العذارى أو خباءُ مدبجُ",59,"ج",1,0],["كَأنَّ دُمُوعَ العَينِ وَطفاءُ قَد مَرَى","قَوادِمَها مَرُّ الجَنُوبِ هتُونَا",60,"ن",2,0],["كأن ديوانك في عينهِ","رسالةٌ من عندِ عزريلِ",61,"ل",1,0],["كأَنَّ دُجى الشَّكِّ في سُخْطِها","وَضَوْءَ الرِّضَا فِي بَياضِ اليَقِينِ",62,"ن",1,0],["كأَنَّ دَمْعِي عَلَى خَدَّي وَصُفْرَتَهُ","حَبَابُ دَمْعِ النَّدى مِنْ حَوْلِ نِسْرِيْنِ",6