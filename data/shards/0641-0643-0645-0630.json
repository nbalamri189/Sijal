{"poems":[[35,"ألا أيها الشيخ الذي ما بنا يرضى","https://www.aldiwan.net/poem25891.html","الطويل"],[87,"قِفوا بالقبور نُسائِلْ عُمَرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9605&r=&rc=95",""],[119,"عقول الورى تاهت بسلطانك الأعلى","https://www.aldiwan.net/poem42204.html","الطويل"],[154,"ألا فاشكروا نعمى الإله يزدكم","https://www.aldiwan.net/poem68580.html","الطويل"],[193,"هو الله لا نحصي لآلائه شكرا","https://www.aldiwan.net/poem35095.html","الطويل"],[275,"كفى الحر أن يشقى وأن يتألما","https://www.aldiwan.net/poem35217.html","الطويل"],[468,"مساحب كف سيدنا الحسين","https://www.aldiwan.net/poem928.html",""],[473,"أبا الفضل تبدي تمصبطرما","https://www.aldiwan.net/poem59771.html","المتقارب"],[556,"إساءات وإحسان","https://www.aldiwan.net/poem47186.html","الهزج"],[556,"أروني امرءا من قبضة الدهر مارقا","https://www.aldiwan.net/poem47364.html","الطويل"],[556,"خذوا من جفوني ماءها فهي ذرف","https://www.aldiwan.net/poem47400.html","الطويل"],[556,"صبرت ومثلك لا يجزع","https://www.aldiwan.net/poem47722.html","المتقارب"],[556,"ألا هل لما فات من مطلب","https://www.aldiwan.net/poem48061.html","المتقارب"],[569,"أعيدوا لنا التاريخ احيوا لنا الذكرى","https://www.aldiwan.net/poem854.html",""],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138299",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122644","الوافر"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63889","الهزج"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62555","الوافر"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35407","الوافر"],[1185,"","https://poetry.dctabudhabi.ae/diwan/poem/75731","الطويل"],[1258,"","https://poetry.dctabudhabi.ae/diwan/poem/117686","الطويل"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31644","الطويل"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6749","الوافر"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79990","الطويل"],[2331,"","https://poetry.dctabudhabi.ae/diwan/poem/110640","المنسرح"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60948","المتقارب"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204434","الطويل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48357","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127018","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45855","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91519","الطويل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136954",""],[4373,"","https://poetry.dctabudhabi.ae/diwan/poem/117216","الطويل"],[4858,"الأم","https://www.poetsgate.com/ViewPoem.aspx?id=30460",""],[3558,"بدأنا بحمد الله فهو سناء","https://www.poetsgate.com/ViewPoem.aspx?id=43376",""],[5092,"مَسَاوات","https://www.poetsgate.com/ViewPoem.aspx?id=152405",""],[5189,"صِغار الذنوب","https://www.poetsgate.com/ViewPoem.aspx?id=191019",""],[5277,"ماتت(ثريّا)","https://www.poetsgate.com/ViewPoem.aspx?id=193286",""],[5431,"وما أحلى الرجوع إلى الطحينِ...","https://www.poetsgate.com/ViewPoem.aspx?id=199868",""],[5493,"بركانُ الشرْق","https://www.poetsgate.com/ViewPoem.aspx?id=196985",""],[402,"هو العيش جهد طائل وفتون","https://www.poetsgate.com/ViewPoem.aspx?id=36535",""],[5790,"أرى في الصبا من نشر رياهم عرفا","https://www.poetsgate.com/ViewPoem.aspx?id=112080",""]],"verses":[["فَكَم ذاكِرٍ لَيلى يَعيشُ بِكُربَةٍ","فَيَنفُضَ قَلبي حينَ يَذكُرُها نَفضا",0,"ض",2,0],["فكم ذلك كالنَّجم من رحلة ٍ","رأَى البدوُ آثارَهَا والحَضَر",1,"ر",1,0],["فكم ذوبت قلباً وكم أحرقت حشا","وكم غيبت لبا وكم أذهلت عقلا",2,"ل",2,0],["فَكَم ذي سَفاهٍ رَدَّهُ عَن سَفاهِهِ","وَبَصَّرَهُ قَلباً بِحَقِّ إِلَهِهِ",3,"ه",1,0],["فَكَم ذا أرادَ النصبَ في درس جامعٍ","فَأولاهُ أربابُ التُقى الخفضَ والجرّا",4,"ر",2,0],["فكم ذُلَّ شهم القوم واحتاجَ ضيغمٌ","الى كلبِ سوقٍ كان يجمعُ أعظُما",5,"م",2,0],["فكم ذكر الاله بها الوفا","مع الآلاف ألوف مع مئين",6,"ن",1,0],["فَكَم ذا وَأَنتَ تُغَنّي لَنا","غِناءَ أَمَرَّ مِنَ الحَنظَلِ",7,"ل",1,0],["فكْم ذا أيها الدّهر","زياداتٌ ونقصانُ",8,"ن",1,0],["فكمْ ذا نبتغي الرِّبْح","وبعضُ الرّبحُ خُسرانُ",8,"ن",1,0],["فكم ذا تغول النّائباتُ نفوسَنا","وتستلب الأهلين ثمّ الأصادقا",9,"ق",2,0],["فكم ذا أُلاقِي منهُمُ كلَّ رابحٍ","وَما أَنا إلّا أَعزلُ الكفِّ أكشفُ",10,"ف",1,0],["فكم ذا لنا خاطبٌ مِصقَعٌ","وكم ذا لنا عالمٌ مُقنِعُ",11,"ع",1,0],["فكم ذا أُعلّلُ بالمُبْرِضاتِ","وأُخدَعُ بالبارق الخُلّبِ",12,"ب",1,0],["فكم ذئب انس قدمته سيوفه","قرا ذئب وحش مرمل يسكن القفرا",13,"ر",2,0],["فكم ذوت منه ازهار لنا نضرت","وكم لوى غصّ أغصان وكم كسرا",14,"ر",2,0],["فكَم ذَنبٍ عَلا رَأساً فيا لي","مِنَ لاأذنابِ يَعلُونَ الرُّءوُسا",15,"س",2,0],["فكم ذكَّر ذاك القص","رُ بالجنَّةِ منْ ناس",16,"س",1,0],["فكم ذي عسرة قد لاذ فيه","فأغناهُ وكم عارٍ كسَاهُ",17,"ا",2,0],["فَكَم ذو التاجِ ضَنَّ بِها سَفاهاً","فَأَنفَذتُم لِمُهجَتِهِ رَداها",18,"ا",3,0],["فَكَم ذا اعاني في انحصار خلاله","بحثت كَثيراً ثم اعجزَني البحث",19,"ث",1,0],["فكم ذهبت من ناظرٍ بسوادهِ","وخلت بياضاً خلفها ومآقيا",20,"ي",2,0],["فكم ذي جُنودٍ قد أَماتَ بِعَضْبِهِ","وذي سَطَواتٍ قد أَبانَ عَلى عَقْبِ",21,"ب",1,0],["فَكَم ذا أَنتَ مَخدوعٌ وَحَتّى","مَتى لا تَرعَوي عَنها وَحَتّى",22,"ت",2,0],["فَكَم ذا أَنتَ وَحَتّى","إِلى ما فيهِ حَظُّكَ إِن عَقَلتا",22,"ت",2,0],["فكم ذات خدرٍ كانَ أولى بها البقا","وكم رجلٍ أولى بأن يسكن التربا",23,"ب",2,0],["فكم ذوو العلم من مناهله","قد اطفئت في الحشى لها غلل",24,"ل",1,0],["فكم ذا الملالُ وكم ذا الدلالُ","وكم ذا المِطال وكم ذا الرحيل",25,"ل",1,0],["فكم ذرة تفنى وتولد ذرة","بجسمي كما تحيا وتفنى العقائد",26,"د",1,0],["فكَمْ ذا تَلوماني على كلَفي به","كأن لم يذُقْ طعْمَ الهَوى عاشِقٌ قبْلي",27,"ل",2,0],["فكم ذب فيه عن حقيقة هاشم","وخير الورى من ذب دون الحقائق",28,"ق",1,0],["فَكَم ذا التَمادي في التَمادي وَمَطمَعي","لَأَشبَع مَما لَم يُؤمله أَشعَب",29,"ب",1,0],["فَكَم ذا أُلاقي البين في كُل مَركبٍ","يَمدّ إِلى حَربي خَميساً وَجَحفلا",30,"ل",2,0],["فكم ذا أشرقت شمس الاماني","وكم غربت وقد غرب السبيل",31,"ل",1,0],["فكم ذو على أو ما لدرك مقامها","فمر ولم يدرك مرامى مرامها",32,"م",3,0],["فكم ذقت النعيم بساعديكِ","وصيرت المضيْق عليّ رُحبا",33,"ب",2,0],["فكم ذي سخى أغرى السخاء ببذله","لأنقى برت أنقاءه برحاء",34,"ا",2,0],["فكم ذي غشأ أضحى غشاء مهندٍ","صلاه لكي يختار منه صلاء",34,"ا",2,0],["فكمْ ذَبُلتْ حياةٌ من فِراقٍ","ويكفي الموتُ في حِضْنِ الحبيبِ",35,"ب",1,0],["فكم ذنباً يمرُّ بدونِ وعيٍّ","وبالأجسادِ أوزارٌ مخيفهْ",36,"ه",1,0],["فكم ذُبحنا..وكم عانتْ حرائرُنا","بمن تقرّبَ للتوباذِ بالرممِ",37,"م",1,0],["فكم ذاقت شفاه الحبّ بُعدا","وكم صام اللسان عن القرينِ",38,"ن",1,0],["فَكَمْ ذَليلٍ بِسَاقِ الجَوْرِ مُنْتَصِبٍ","وَكَمْ عَزِيزٍ قَضَى فِي سِجْنِه عُمُرَهْ",39,"ر",2,0],["فكم ذارف دمعا وكم صافق أسى","كما يصفق الاراه وهو غبين",40,"ن",1,0],["فكم ذكرى قلبا وكم هيجت هوى","وكم قلبت قلبا وكم جددت لهفا",41,"ف",2,0]]}