ئله","https://www.aldiwan.net/poem55994.html","الطويل"],[460,"حبست وأيام الملوك كذاكا","https://www.aldiwan.net/poem56082.html","الطويل"],[460,"أفاق بها من طول سكرته الدهر","https://www.aldiwan.net/poem56161.html","الطويل"],[460,"رعى الله في الحاجات كل نجيب","https://www.aldiwan.net/poem56301.html","الطويل"],[463,"وفتيان صدق من تميم تناثلوا","https://www.aldiwan.net/poem15083.html","الطويل"],[463,"عجبت لحي لا تحل حباهم","https://www.aldiwan.net/poem16062.html","الطويل"],[463,"نعمت صباحا ما تغنت حمامة","https://www.aldiwan.net/poem16155.html","الطويل"],[463,"تبلج وجه الدهر بعد قطوبه","https://www.aldiwan.net/poem16344.html","الطويل"],[463,"أبر صلاح الدين وابن صلاحه","https://www.aldiwan.net/poem16398.html","الطويل"],[466,"عتبت المنايا فيكم آل منقذ","https://www.aldiwan.net/poem3118.html","عموديه"],[466,"جزعت وأين سبيل الجلد","https://www.aldiwan.net/poem3142.html","عموديه"],[470,"زحفت إلى خارجي العدم","https://www.aldiwan.net/poem59655.html","المتقارب"],[470,"رأيتك بصاص الثياب مزوقا","https://www.aldiwan.net/poem60030.html","الطويل"],[470,"أتى زائري من لا أزال له عبدا","https://www.aldiwan.net/poem60211.html","الطويل"],[470,"ينادي من الساري إلي ومزعجي","https://www.aldiwan.net/poem60224.html","الطويل"],[507,"اليقِينيّة","https://www.aldiwan.net/poem27893.html","مجزوء الوافر"],[512,"رماني الدهر بالنكبات حتى","https://www.aldiwan.net/poem1589.html",""],[515,"تسليت عن ذكر الحبيب بغيره","https://www.aldiwan.net/poem67740.html","الطويل"],[515,"ولما وقفنا للوداع وبيننا","https://www.aldiwan.net/poem67764.html","الطويل"],[517,"إذا ما لقيت الأكرم الندب فاعتذر","https://www.aldiwan.net/poem12100.html","الطويل"],[517,"سجوداً فهذا صاحب الركن والحجر","https://www.aldiwan.net/poem12107.html","الطويل"],[518,"فما زال بردي طيبا من ثيابها","https://www.aldiwan.net/poem47412.html","الطويل"],[518,"بدأن بنا وابن الليالي كأنه","https://www.aldiwan.net/poem48636.html","الطويل"],[538,"تولى الجود وانقرض الكرام","https://www.aldiwan.net/poem23847.html","الوافر"],[538,"أتذكر داراً بين دمخ ومنورا","https://www.aldiwan.net/poem23850.html","الطويل"],[540,"كما قلتم لن يرتضي السلم مجرم","https://www.aldiwan.net/poem47935.html","عموديه"],[553,"إذا جئت أعلام العذيب فسلم","https://www.aldiwan.net/poem47211.html","الطويل"],[553,"لك الليل بعد الذاهبين طويلا","https://www.aldiwan.net/poem47299.html","الطويل"],[553,"ألم خيال من أميمة طارق","https://www.aldiwan.net/poem47373.html","الطويل"],[553,"تراءت لنا بالأبرقين بروق","https://www.aldiwan.net/poem47376.html","الطويل"],[553,"أمنك الشوق أرقني فهاجا","https://www.aldiwan.net/poem47908.html","الوافر"],[555,"خليلي لست أرى الحب عارا","https://www.aldiwan.net/poem68409.html","المتقارب"],[561,"أيا سعد قل للقس من داخل الدير","https://www.aldiwan.net/poem69361.html","الطويل"],[569,"وجارية تستميل القلوب","https://www.aldiwan.net/poem69777.html","المتقارب"],[571,"أتى يخبط الظلماء والليل دامس","https://www.aldiwan.net/poem51995.html","البسيط"],[588,"لعل أراك الحي ليلا أراكه","https://www.aldiwan.net/poem17998.html","الطويل"],[589,"ألا أيها الغادي مجداً بنجداً","https://www.aldiwan.net/poem11509.html","عموديه"],[756,"","https://poetry.dctabudhabi.ae/diwan/poem/17654","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/28057","الطويل"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/21446","الطويل"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/21444","الطويل"],[892,"","https://poetry.dctabudhabi.ae/diwan/poem/22609","الطويل"],[925,"","https://poetry.dctabudhabi.ae/diwan/poem/200309","الطويل"],[1072,"","https://poetry.dctabudhabi.ae/diwan/poem/18715","الطويل"],[1139,"","https://poetry.dctabudhabi.ae/diwan/poem/29462","المتقارب"],[1180,"","https://poetry.dctabudhabi.ae/diwan/poem/31519","الطويل"]],"verses":[["فَما زِلتَ تَستَوفي مَراميهِ وَالقُوى","تُقَطَّعُ وَالإِقبالُ عَنهُ يَميلُ",0,"ل",1,0],["فَما زِلتُ أُطرِبُهُ بِالحَنينِ","وَأُذكِرُهُ المَنزِلَ المُقفِرا",1,"ر",2,0],["فَما زالَ يَنمى حُبُّها في شَبيبَتي","وَفي الشَّيبِ إِذ أَلقى يَداً في المَفارِقِ",2,"ق",1,0],["فما زالَ يَطْويها ويَطوينَهُ الفَلا","إِلى أنْ أنَخْناهُنَّ عندَ المُحَصِّبِ",3,"ب",1,0],["فما زِلْتُ أحْدوهُ إليكَ مُحَبَّراً","وللهِ دَرّي أيَّ ذي فِقَرٍ أحْدو",4,"د",2,0],["فَما زِدتِني إِلّا صُدوداً وَغِلظَةً","وَقَد كُنتُ عَن دارِ الهَوان بِمَعزِلِ",5,"ل",1,0],["فَما زِلتُ أَحسوها بِكَأَسَينِ كُلَّما","شَرِبتُ بِكَأسٍ لَم تَزَل أُختُها مَعي",6,"ع",2,0],["فَما زِلتَ ذا عَفوٍ عَنِ الذَنبِ لَم تَزَل","تَجودُ وَتَعفو مِنَّةً وَتَكَرُّما",7,"م",2,0],["فَمَازِلْتَ تَهْدِي فِي الْبَرِّيةِ هَدْيَهُ","وَتَقْضِي بِمَا يُرْضِيهِ سِرّاً وَإِعْلاَنَا",8,"ن",2,0],["فَما زادَهُ رَبُّهُ قُوَّةً","وَمِثلُ مُجاوِرِهِ لَم يُقِم",9,"م",1,0],["فَما زِلتُ أَمرَحُ في قَدِّهِنَّ","وَيَمرَحنَ مِنّي بِرَوضٍ جَني",10,"ن",2,0],["فَما زادَ قَدرُ القِردِ حينَ اِستَخَصَّهُ","يَزيدُ وَلا حَطَّ الحُسَينَ مَصايِبُه",11,"ب",2,0],["فَما زالَتِ الأَيّامُ تُمهي شِفارَها","وَتَشحَذُ حَتّى اِستَأصَلَت كُلَّ ما عِندي",12,"د",2,0],["فَما زِلتُمُ بِالناسِ حَتّى كَأَنَّهُم","مِنَ الخَوفِ طَيرٌ أَخذَأَتها الأَجاذِلُ",13,"ل",1,0],["فَما زِلتُ أُبقي الظَعنَ حَتّى كَأَنَّها","أَواقي سَدىً تَغتالُهُنَّ الحَوائِكُ",14,"ك",1,0],["فَما زالَ يَستَشري وَما زِلتُ ناصِباً","لَهُ بَصَري حَتّى غَدا يَتَعَجرَفُ",15,"ف",1,0],["فَما زالإِسآدي عَلى الأَينِ وَالسُرى","بِحَزَّةَ حَتّى أَسلَمَتها العَجارِفُ",16,"ف",1,0],["فَمَا زَالَ حَتَّى أَنْجَحَ اللهُ قَصْدَهُ","وَدُونَ الَّذِي يَبْغِي تُفْل اللَّهَاذِمُ",17,"م",1,0],["فَما زالَ في نَفسي هُلاعٌ مُراجِعٌ","مِنَ الشَوقِ حَتّى كادَ يَبدو ضَميرُها",18,"ر",3,0],["فَما زالَ فَوقَ الأَكوَمِ الفَردِ رابِئاً","يُراقِبُ حَتّى فارَقَ الأَرضَ نورُها",18,"ر",3,0],["فَمازِلتُ أَطوي النَفسَ حَتّى كَأَنَّها","بِذي الرِمثِ لَم تَخطُر عَلى بالِ ذاكِرِ",19,"ر",1,0],["فَما زِلتُ أَكسو كُلَّ يَومٍ سَراتَها","خَصاصَةَ مَعلوفٍ مِن المَيسٍ قاتِرِ",19,"ر",1,0],["فَما زِلتُ أَدعو اللَهَ في الدَارِ طامِعا","بِخَفضِ النَوى حَتَّى تَضَمَّنَها الخِدرُ",20,"ر",1,0],["فَما زالَ يَغلو حُبُّ مَيَّةَ عِندَنا","وَيَزدادُ حَتّى لَم نَجِد ما يَزيدُها",21,"د",3,0],["فَما زادَني بُعدُ المَدى نَقضَ مِرَّةٍ","وَلا رَقَّ عَظمي لِلضُروسِ العَواجِمِ",22,"م",1,0],["فَمازالَ يَستَنعي الهَوى وَيَقودُني","بِحَبلَينِ حَتّى قالَ صَحبي أَلا اِركَبِ",23,"ب",1,0],["فَما زالَ مَعقولاً عِقالٌ عَنِ العُلى","وَما زالَ مَحبوساً عَنِ المَجدِ حابِسُ",24,"س",1,0],["فَما زادَنا بَأواً عَلى ذي قَرابَةٍ","غِنانا وَلا أَزرى بِأَحسابِنا الفَقرُ",25,"ر",1,0],["فما زَادَها إلا يُبُوساً وما أرَى","لَهُم رَحِمَاً والحَمدُ لِلَّه تُوصَلُ",26,"ل",1,0],["فَما زالَ في الإِسلامِ مِن آلِ هاشِمٍ","دَعائِمُ عِزٍّ لا يَزولُ وَمَفخَرُ",27,"ر",1,0],["فما زادني في الحبّ إلاَّ تسرُّعاً","وما زادني في الصبر إلا تثبُّطا",28,"ط",2,0],["فما زلتُ في خوفٍ وجوعٍ ووحشةٍ","وفي سَهَرٍ يستغرقُ الليلَ واصبِ",29,"ب",1,0],["فما زال يُوفي خدمة المجدِ حقَّها","إلى أن دعاه المجد أفديك خادما",30,"م",2,0],["فَما زالَ عَنها السَيرُ حَتّى تَواضَعَت","عَرائِكُها مِمّا تُحَلُّ وَتُرحَلُ",31,"ل",1,0],["فَما زالَ يَسفي بَطنَ خَبتٍ وَعَرعَرٍ","وَأَرضَهُما حَتّى اِطمَأَنَّ جَسيمُها",32,"م",3,0],["فَما زادَ الدُجى خَوفي","وَلا زادَ الضُهى أَمني",33,"ي",1,0],["فَما زِلتَ حَتّى أَيَّدَ اللَهُ حِزبَهُ","وَأَشرَقَ وَجهُ الأَرضِ جَذلانَ بِالنَصرِ",34,"ر",1,0],["فَما زِلنَ حَتّى عادَ طَرقاً وَشِبنَهُ","بِأَصفَرَ تَذريهِ سِجالاً أَيانِقُه",35,"ق",2,0],["فما زدنا الكتاب الفخم حرفا","ولا زدنا العصور الزُهر ساعا",36,"ع",2,0],["فَما زِلتُ بِالأَهوالِ حَتّى اِقتَحَمتُها","وَقَد تُركِبُ الحاجاتُ ما لَيسَ يُركَبُ",37,"ب",1,0],["فَما زِلتُمُ حَتّى نَزَلتُم بُروجَهُ","وَلَم تَحتَضِر شَمسُ النَهارِ فَتَغرُبُ",37,"ب",1,0],["فَما زِلتَ جارَ البِرِّ وَالسَيِّدَ الَّذي","إِلى فَضلِهِ مِن عَدلِهِ الجارُ يَهرُبُ",37,"ب",1,0],["فَما زالَت تَرى وَاللَيلُ داجٍ","لِسَيفِ الدَولَةِ المَلِكِ اِئتِلافا",38,"ف",2,0],["فَما زالَ لَولا نورُ وَجهِكَ جُنحُهُ","وَلا جابَها الرُكبانُ لَولا الأَيانِقُ",39,"ق",1,0],["فَما زِلتَ حَتّى أَذعَنَ الشَرقُ عَنوَةً","وَدانَت عَلى صُغرٍ أَعالي المَغارِبِ",40,"ب",1,0],["فَما زالَ في الإِملاءِ حَتّى أَصارَهُ","إِلى النارِ مِن بَعدِ السُيوفِ القَواضِبِ",41,"ب",1,0],["فَما زِلتُ حَتّى أَصعَدَتني حِبالُها","إِلَيها وَلَيلي قَد تَخامَصَ آخِرُه",42,"ر",2,0],["فَما زِلتُ أُسقاها وَما زِلتُ 