مازالَ يَسقينا بِكَأسٍ مُجِدَّةٍ","تُوَلّي وَأُخرى بَعدَ ذاكَ تَؤوبُ",65,"ب",1,0],["فَما زِلتُ أَرقيهِ وَأَلثُمُ خَدُّهُ","إِلى أَن تَغَنّى راضِياً وَلَهُ الشُكرُ",66,"ر",1,0],["فَما زالَ هَذا دَأبُنا وَغِذاءَنا","ثَلاثينَ يَوماً مَع لَيالٍ غَوابِرِ",67,"ر",1,0],["فَما زِلتُ بِالأَشعارِ في كُلِّ مَشهَدٍ","أُلَيِّنُها وَالشِعرُ مِن عُقَدِ السِحرِ",68,"ر",1,0],["فَما زِلتُ في رِفقٍ وَنَفسي تَقولُ لي","جُوَيرِيَّةٌ بِكرٌ وَذا جَزَعُ البِكرِ",68,"ر",1,0],["فَما زادَني اللاحونَ إِلّا لَجاجَةً","عَلَيها لِأَنّي ما حَيّتُ رَفيقُها",69,"ق",3,0],["فَما زالَ حَتّى ذاقَها مُتَكَرِّهاً","فَرَدَّت إِلَيهِ روحَهُ في المَفاصِلِ",70,"ل",1,0],["فَما زالَت تُصَرِّفُ فيهِ حَتّى","حَكَتهُ في الفِعالِ وَفي الكَلامِ",71,"م",1,0],["فما زالت تجمّشني طويلاً","وتأخذني أحاديثُ التصابي",72,"ب",2,0],["فَما زِلتَ حَتّى اِستَنصَرَ الدينُ أَهلَهُ","عَلَيكَ فَعادوا بِالسُيوفِ الصَوارِمِ",73,"م",1,0],["فَما زالَ حَتّى أَنابَت لَهُ","فَراحَ وَحَلَّ لَنا ما حَرُم",74,"م",1,0],["فَمازِلتَ في رَأيٍ تَحوزُ بِهِ العُلا","وَلازِلتَ عَن عَقلٍ تَشيدُ بِهِ مَجدا",75,"د",2,0],["فَما زالَت تُعاني الثُقلَ حَتّى","أَتاها الوَضعُ وَاِتَّصَلَ الحِسابُ",76,"ب",1,0],["فَما زيدَ مِنها قَبضَةَ الكَفِّ زَبدُها","وَلا عَمِرَت فيها لِخَيرٍ عُمورُها",77,"ر",3,0],["فَما زالَ يَفري الشَدَّ حَتّى كَأَنَّما","قَوائِمُهُ في جانِبَيهِ الزَعانِفُ",78,"ف",1,0],["فَما زالَ حَتّى نالَها وَهوَ مُعصِمٌ","عَلى مَوطِنٍ لَو زَلَّ عَنهُ تَفَصَّلا",79,"ل",2,0],["فما زال ينمو الشر في كل جانب","ويزداد بين الناس ظلم وعدوان",80,"ن",1,0],["فَمَا زَالَ حَتَّى نَالَهُ مُتَغَلْغِلٌ","تَخَيَّرَ مِنْ أَمْثَالِهِ مَا تَخَيَّرَا",81,"ر",2,0],["فما زالت ترى والليل داجٍ","لسيف الدّولة الملك ائتلاقا",82,"ق",2,0],["فَما زِلتَ في إِعمالِ طَرفِكَ نَحوَنا","إِذا جِئتَ حَتّى كادَ حُبُّكَ يَظهَرُ",83,"ر",1,0],["فَما زالَ في أَكلٍ وشُرْبٍ مُدارَكٍ","إِلى أَنْ تَشَهَّى التَّرْكَ شَهْوَةَ وانِي",84,"ن",2,0],["فَما زِلتُ مَغشِيّاً عَليَّ وَقَد مَضَت","أَناةٌ وَما عِندي جَوابٌ وَلا رَدُّ",85,"د",1,0],["فَمَا زِلْتُ أَسْقِيهِ وَأَشْرَبُ مِثْلَهُ","إِلَى أَنْ هَفَا س