لتم لن يرتضي السلم مجرم","https://www.aldiwan.net/poem47935.html","عموديه"],[549,"إذا جئت أعلام العذيب فسلم","https://www.aldiwan.net/poem47211.html","الطويل"],[549,"لك الليل بعد الذاهبين طويلا","https://www.aldiwan.net/poem47299.html","الطويل"],[549,"ألم خيال من أميمة طارق","https://www.aldiwan.net/poem47373.html","الطويل"],[549,"تراءت لنا بالأبرقين بروق","https://www.aldiwan.net/poem47376.html","الطويل"],[549,"أمنك الشوق أرقني فهاجا","https://www.aldiwan.net/poem47908.html","الوافر"],[551,"خليلي لست أرى الحب عارا","https://www.aldiwan.net/poem68409.html","المتقارب"],[557,"أيا سعد قل للقس من داخل الدير","https://www.aldiwan.net/poem69361.html","الطويل"],[565,"وجارية تستميل القلوب","https://www.aldiwan.net/poem69777.html","المتقارب"],[567,"أتى يخبط الظلماء والليل دامس","https://www.aldiwan.net/poem51995.html","البسيط"],[584,"لعل أراك الحي ليلا أراكه","https://www.aldiwan.net/poem17998.html","الطويل"],[585,"ألا أيها الغادي مجداً بنجداً","https://www.aldiwan.net/poem11509.html","عموديه"]],"verses":[["فَما زِلتَ تَستَوفي مَراميهِ وَالقُوى","تُقَطَّعُ وَالإِقبالُ عَنهُ يَميلُ",0,"ل",1,0],["فَما زِلتُ أُطرِبُهُ بِالحَنينِ","وَأُذكِرُهُ المَنزِلَ المُقفِرا",1,"ر",2,0],["فَما زالَ يَنمى حُبُّها في شَبيبَتي","وَفي الشَّيبِ إِذ أَلقى يَداً في المَفارِقِ",2,"ق",1,0],["فما زالَ يَطْويها ويَطوينَهُ الفَلا","إِلى أنْ أنَخْناهُنَّ عندَ المُحَصِّبِ",3,"ب",1,0],["فما زِلْتُ أحْدوهُ إليكَ مُحَبَّراً","وللهِ دَرّي أيَّ ذي فِقَرٍ أحْدو",4,"د",2,0],["فَما زِدتِني إِلّا صُدوداً وَغِلظَةً","وَقَد كُنتُ عَن دارِ الهَوان بِمَعزِلِ",5,"ل",1,0],["فَما زِلتُ أَحسوها بِكَأَسَينِ كُلَّما","شَرِبتُ بِكَأسٍ لَم تَزَل أُختُها مَعي",6,"ي",1,0],["فَما زِلتَ ذا عَفوٍ عَنِ الذَنبِ لَم تَزَل","تَجودُ وَتَعفو مِنَّةً وَتَكَرُّما",7,"م",2,0],["فَمَازِلْتَ تَهْدِي فِي الْبَرِّيةِ هَدْيَهُ","وَتَقْضِي بِمَا يُرْضِيهِ سِرّاً وَإِعْلاَنَا",8,"ن",2,0],["فَما زادَهُ رَبُّهُ قُوَّةً","وَمِثلُ مُجاوِرِهِ لَم يُقِم",9,"م",1,0],["فَما زِلتُ أَمرَحُ في قَدِّهِنَّ","وَيَمرَحنَ مِنّي بِرَوضٍ جَني",10,"ن",2,0],["فَما زادَ قَدرُ القِردِ حينَ اِستَخَصَّهُ","يَزيدُ وَلا حَطَّ الحُسَينَ مَصايِبُه",11,"ب",2,0],["فَما زالَتِ الأَيّامُ تُمهي شِفارَها","وَتَشحَذُ حَتّى اِستَأصَلَت كُلَّ ما عِندي",12,"ي",1,0],["فَما زِلتُمُ بِالناسِ حَتّى كَأَنَّهُم","مِنَ الخَوفِ طَيرٌ أَخذَأَتها الأَجاذِلُ",13,"ل",1,0],["فَما زِلتُ أُبقي الظَعنَ حَتّى كَأَنَّها","أَواقي سَدىً تَغتالُهُنَّ الحَوائِكُ",14,"ك",1,0],["فَما زالَ يَستَشري وَما زِلتُ ناصِباً","لَهُ بَصَري حَتّى غَدا يَتَعَجرَفُ",15,"ف",1,0],["فَما زالإِسآدي عَلى الأَينِ وَالسُرى","بِحَزَّةَ حَتّى أَسلَمَتها العَجارِفُ",16,"ف",1,0],["فَمَا زَالَ حَتَّى أَنْجَحَ اللهُ قَصْدَهُ","وَدُونَ الَّذِي يَبْغِي تُفْل اللَّهَاذِمُ",17,"م",1,0],["فَما زالَ في نَفسي هُلاعٌ مُراجِعٌ","مِنَ الشَوقِ حَتّى كادَ يَبدو ضَميرُها",18,"ر",3,0],["فَما زالَ فَوقَ الأَكوَمِ الفَردِ رابِئاً","يُراقِبُ حَتّى فارَقَ الأَرضَ نورُها",18,"ر",3,0],["فَمازِلتُ أَطوي النَفسَ حَتّى كَأَنَّها","بِذي الرِمثِ لَم تَخطُر عَلى بالِ ذاكِرِ",19,"ر",1,0],["فَما زِلتُ أَكسو كُلَّ يَومٍ سَراتَها","خَصاصَةَ مَعلوفٍ مِن المَيسٍ قاتِرِ",19,"ر",1,0],["فَما زِلتُ أَدعو اللَهَ في الدَارِ طامِعا","بِخَفضِ النَوى حَتَّى تَضَمَّنَها الخِدرُ",20,"ر",1,0],["فَما زالَ يَغلو حُبُّ مَيَّةَ عِندَنا","وَيَزدادُ حَتّى لَم نَجِد ما يَزيدُها",21,"د",3,0],["فَما زادَني بُعدُ المَدى نَقضَ مِرَّةٍ","وَلا رَقَّ عَظمي لِلضُروسِ العَواجِمِ",22,"م",1,0],["فَمازالَ يَستَنعي الهَوى وَيَقودُني","بِحَبلَينِ حَتّى قالَ صَحبي أَلا اِركَبِ",23,"ب",1,0],["فَما زالَ مَعقولاً عِقالٌ عَنِ العُلى","وَما زالَ مَحبوساً عَنِ المَجدِ حابِسُ",24,"س",1,0],["فَما زادَنا بَأواً عَلى ذي قَرابَةٍ","غِنانا وَلا أَزرى بِأَحسابِنا الفَقرُ",25,"ر",1,0],["فما زَادَها إلا يُبُوساً وما أرَى","لَهُم رَحِمَاً والحَمدُ لِلَّه تُوصَلُ",26,"ل",1,0],["فَما زالَ في الإِسلامِ مِن آلِ هاشِمٍ","دَعائِمُ عِزٍّ لا يَزولُ وَمَفخَرُ",27,"ر",1,0],["فما زادني في الحبّ إلاَّ تسرُّعاً","وما زادني في الصبر إلا تثبُّطا",28,"ط",2,0],["فما زلتُ في خوفٍ وجوعٍ ووحشةٍ","وفي سَهَرٍ يستغرقُ الليلَ واصبِ",29,"ب",1,0],["فما زال يُوفي خدمة المجدِ حقَّها","إلى أن دعاه المجد أفديك خادما",30,"م",2,0],["فَما زالَ عَنها السَيرُ حَتّى تَواضَعَت","عَرائِكُها مِمّا تُحَلُّ وَتُرحَلُ",31,"ل",1,0],["فَما زالَ يَسفي بَطنَ خَبتٍ وَعَرعَرٍ","وَأَرضَهُما حَتّى اِطمَأَنَّ جَسيمُها",32,"م",3,0],["فَما زادَ الدُجى خَوفي","وَلا زادَ الضُهى أَمني",33,"ي",1,0],["فَما زِلتَ حَتّى أَيَّدَ اللَهُ حِزبَهُ","وَأَشرَقَ وَجهُ الأَرضِ جَذلانَ بِالنَصرِ",34,"ر",1,0],["فَما زِلنَ حَتّى عادَ طَرقاً وَشِبنَهُ","بِأَصفَرَ تَذريهِ سِجالاً أَيانِقُه",35,"ق",2,0],["فما زدنا الكتاب الفخم حرفا","ولا زدنا العصور الزُهر ساعا",36,"ع",2,0],["فَما زِلتُ بِالأَهوالِ حَتّى اِقتَحَمتُها","وَقَد تُركِبُ الحاجاتُ ما لَيسَ يُركَبُ",37,"ب",1,0],["فَما زِلتُمُ حَتّى نَزَلتُم بُروجَهُ","وَلَم تَحتَضِر شَمسُ النَهارِ فَتَغرُبُ",37,"ب",1,0],["فَما زِلتَ جارَ البِرِّ وَالسَيِّدَ الَّذي","إِلى فَضلِهِ مِن عَدلِهِ الجارُ يَهرُبُ",37,"ب",1,0],["فَما زالَت تَرى وَاللَيلُ داجٍ","لِسَيفِ الدَولَةِ المَلِكِ اِئتِلافا",38,"ف",2,0],["فَما زالَ لَولا نورُ وَجهِكَ جُنحُهُ","وَلا جابَها الرُكبانُ لَولا الأَيانِقُ",39,"ق",1,0],["فَما زِلتَ حَتّى أَذعَنَ الشَرقُ عَنوَةً","وَدانَت عَلى صُغرٍ أَعالي المَغارِبِ",40,"ب",1,0],["فَما زالَ في الإِملاءِ حَتّى أَصارَهُ","إِلى النارِ مِن بَعدِ السُيوفِ القَواضِبِ",41,"ب",1,0],["فَما زِلتُ حَتّى أَصعَدَتني حِبالُها","إِلَيها وَلَيلي قَد تَخامَصَ آخِرُه",42,"ر",2,0],["فَما زِلتُ أُسقاها وَما زِلتُ ساقِياً","تُفيتُ يَدي في بَذلِها كُلَّ مُنفِسِ",43,"س",1,0],["فَما زِلتُ عَن سَعدٍ لَدُن أَن هَجَوتُها","أَخُصُّ وَتاراتٍ أَعُمُّ فَأَجمَعُ",44,"ع",1,0],["فما زهَرَتْ إلا لديكَ نجومُها","ولا حَسُنَتْ إلا عليكَ عُقودُها",45,"د",3,0],["فما زالَتْ غَوادي الدَّمعِ تُبْدي","خَفِيَّ الوَجْدِ للظُّعْنِ الغَوادي",46,"ي",1,0],["فَما زالَ سُلطاناً أَخٌ لي أَوَدُّهُ","فَيَقطَعُني جُرماً قَطيعَةَ صالِحِ",47,"ح",1,0],["فما زَال سَهبُ الأرْض قوتاً لأرْضِهِ","ولا انفكّ قوتُ الرّحل شحمَ سنامهِ",48,"م",2,0],["فَما زُجِرَت طُيورُكَ عَن سَنيحٍ","وَلا طَلَعَت نُجومُكَ بِالسُعودِ",49,"د",1,0],["فَمازالَ يَفرَعُ تِلكَ العُلى","مَعَ النَجمِ مُرتَدِياً بِالعَماءِ",50,"ا",2,0],["فَما زِلنَ يَستَشرينَ حَتّى كَأَنَّما","عَلى أُفُقِ الدُنيا سُيوفٌ رَوامِضُ",51,"ض",1,0],["فما زادوا الصديقَ على سلامٍ","لهذا سُمِّيَتْ دارَ السلامِ",52,"م",1,0],["فَما زِلتُ في لَيلٍ طَويلٍ مُلَثِّماً","لَذيذَ رُضابِ المِسكِ كَالمُتَشَهِّدِ",53,"د",1,0],["فَما زادَني الواشونَ إِلّا صَبابَةً","وَما زادَني الناهونَ إِلّا أَعادِيا",54,"ي",2,0],["فما زالَ حتَّى ريعَ من وَثَباتِها","على بأسهِ الرِّئبالُ ذو المخلب الدّامي",55,"ي",1,0],["فَما زالَ حَتّى دانَ لِلَهِ مَغرَبٌ","وَما زالَ حَتّى دانَ لِلَهِ مَشرِقُ",56,"ق",1,0],["فما زالَ حتّى أذّنَ الدِّيكُ وانْبَرى","مِنَ القومِ داعٍ يَرفعُ الصَّوتَ ناعيا",57,"ي",2,0],["فَما زالَ بي ما ضَمَّنتِني مِنَ الجَوى","وَسُقمٍ بِهِ أَعيا عَلى مَن تَطَبَّبا",58,"ب",2,0],["فَما زالَتِ العَوجاءُ تَجري ضُفورُها","إِلَيكَ اِبنَ شَمّاسٍ تَروحُ وَتَغتَدي",59,"د",2,0],["فَما زِلتَ تُعطي النَفسَ حَتّى تَجاوَزَت","مُناها فَأَعطِ الآنَ إِن شِئتَ أَو دَعِ",60,"ع",1,0],["فَما زِلتُ أُسقاها بِكَفِّ مُقَرطِقٍ","كَغُصنٍ ثَنَتهُ الريحُ بَينَ غُصونِ",61,"ن",1,0],["فَما زالَ حَتّى النَبتُ يَرفَعُ نَفسَهُ","بِهامِ الرُبى وَالعِرقُ في الأَرضِ ناخِسُ",62,"س",1,0],["فَما زِلنا نَقولُ لَها أَعيدي","وَلِلساقي أَلا هَل مِن مَزيدِ",63,"د",1,0],["فَما زالَ مَدمَعُها باكِياً","عَلى التُربِ حَتّى اِكتَسى ما اِكتَسى",64,"ا",1,0],["فَما زالَ يُدئِبُها ماجِدٌ","عَلى الأَينِ حَتّى اِنطَوَت وَاِنطَوى",64,"ا",1,0],["فَمازالَ يَسقينا بِكَأسٍ مُجِدَّةٍ","تُوَلّي وَأُخرى بَعدَ ذاكَ تَؤوبُ",65,"ب",1,0],["فَما زِلتُ أَرقيهِ وَأَلثُمُ خَدُّهُ","إِلى أَن تَغَنّى راضِياً وَلَهُ الشُكرُ",66,"ر",1,0],["فَما زالَ هَذا دَأبُنا وَغِذاءَنا","ثَلاثينَ يَوماً مَع لَيالٍ غَوابِرِ",67,"ر",1,0],["فَما زِلتُ بِالأَشعارِ في كُلِّ مَشهَدٍ","أُلَيِّنُها وَالشِعرُ مِن عُقَدِ السِحرِ",68,"ر",1,0],["فَما زِلتُ في رِفقٍ وَنَفسي تَقولُ لي","جُوَيرِيَّةٌ بِكرٌ وَذا جَزَعُ البِكرِ",68,"ر",1,0],["فَما زادَني اللاحونَ إِلّا لَجاجَةً","عَلَيها لِأَنّي ما حَيّتُ رَفيقُها",69,"ق",3,0],["فَما زالَ حَتّى ذاقَها مُتَكَرِّهاً","فَرَدَّت إِلَيهِ روحَهُ في المَفاصِلِ",70,"ل",1,0],["فَما زالَت تُصَرِّفُ فيهِ حَتّى","حَكَته