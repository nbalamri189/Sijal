8","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54815","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54559","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55160","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55040","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54972","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54896","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54637","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55126","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55122","الوافر"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67351","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142012","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43896","المتقارب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43904","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43884","المتدارك"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24724","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54214","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54202","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54212","الرمل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/205801","الخفيف"],[106,"زفاف الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179500",""],[106,"خيال في يقظة","https://www.poetsgate.com/ViewPoem.aspx?id=179676",""],[106,"في ذكرى الكواكبي","https://www.poetsgate.com/ViewPoem.aspx?id=179601",""],[77,"دعاكَ بأقصى المغربينِ غريبُ","https://www.poetsgate.com/ViewPoem.aspx?id=33820",""],[77,"يا سراج الجمالِ يا بن سِراج","https://www.poetsgate.com/ViewPoem.aspx?id=33799",""],[84,"هل أبصرت عيناك يا خليلي","https://www.poetsgate.com/ViewPoem.aspx?id=26349",""],[50,"غدا سلفٌ فأصْعَدَ «بالرَّبَابِ»","https://www.poetsgate.com/ViewPoem.aspx?id=17144",""],[50,"بِأبِي وأمِّي منْ يُقَارِبُنِي","https://www.poetsgate.com/ViewPoem.aspx?id=17120",""],[90,"عُدنا وقودا","https://www.poetsgate.com/ViewPoem.aspx?id=179221",""],[90,"الشباب المر","https://www.poetsgate.com/ViewPoem.aspx?id=178970",""],[90,"شباب ضائع","https://www.poetsgate.com/ViewPoem.aspx?id=179161",""],[45,"عَارَضْنَنا أُصُلاً، فَقُلْنَا الرّبْرَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=31698",""],[45,"أُرَجِّمُ في لَيْلَى الظُّنُونَ، وَإِنَّمَا","https://www.poetsgate.com/ViewPoem.aspx?id=31685",""],[29,"أحِبُّوا الخيلَ واصطَبروا عليها","https://www.poetsgate.com/ViewPoem.aspx?id=180964",""],[51,"من عذيري من الخلائف حَلُّوا","https://www.poetsgate.com/ViewPoem.aspx?id=30422",""],[51,"من عذيري مِنَ الخلائفِ ضلّوا","https://www.poetsgate.com/ViewPoem.aspx?id=30231",""],[51,"أغرُّ مُخيلاتِ الأماني لَمُوعها","https://www.poetsgate.com/ViewPoem.aspx?id=29518",""]],"verses":[["نَقصُ الجَديدينِ مِن عُمري يَزيدُ عَلى","ما يُنقِصانِ عَلى الأَيّامِ مِن حالي",0,"ي",1,0],["نَقولُ مَقيلٌ في الكَرى لِجُنوبِنا","وَهَل غَيرُ أَحشاءِ القُبورِ مَقيلُ",1,"ل",1,0],["نَقَصَت أَداةُ الفَضلِ بَعدَكَ كُلُّها","فَوَعى بِمُصطَلَمٍ وَشَمَّ بِأَجدَعِ",2,"ع",1,0],["نُقِضَت مَرائِرُهُم وَكُنَّ أَكُفُّهُم","مَبلولَةً بِالنَقضِ وَالإِمرارِ",3,"ر",1,0],["نُقَوِّمُ أَيدي اليَعمَلاتِ وَراؤَهُ","وَنَعدِلُ مِنها أَينَ أَومى رِقابَها",4,"ب",3,0],["نَقَلتَ الطَعنَ في الجِلدِ","إِلى طَعنِكَ في القَلبِ",5,"ب",1,0],["نَقَضوا عَهدي وَقَد أَبرَمتُهُ","وَعُرى الدينِ فَما أَبقوا عُرى",6,"ا",1,0],["نِقَمِي تَتْبَعُها نِعَمي","وَيَميني دَرَّةُ الدِّيَمِ",7,"م",1,1],["نَقلُ الجِبالِ الرَواسي عَن مَواضِعِها","أَخَفُّ مِن نَقلِ نَفسٍ حينَ تَنصَرِفُ",8,"ف",1,1],["نَقَضَتْ مِنْ سُبْحَةِ الَّليْلِ يَدٌ","نَظَمتْ مِنْ سَبَجٍ مَا نَقَضَتْ",9,"ت",1,0],["نَقْطَعُ اللّيلَ في التِئامٍ وضَمٍّ","وسُرورٍ وغِبْطَةٍ وابْتِهاجِ",10,"ج",1,0],["نَقُودُ إِلَى هَيْجَائِهَا كُلَّ صَاهِلٍ","كَمَا رِيعَ مَكْحُولَ اللِّحَاظِ دَبِيبُ",11,"ب",1,0],["نُقيمُ لَها سوقَ الجِلادِ وَنَغتَلي","بِأَسيافِنا حَتّى نُوَجِّهَ خالَها",12,"ل",3,0],["نُقيمُ لَها سوقَ الضِرابِ وَنَعتَصي","بِأَسيافِنا حَتّى نُوَجِّهَ خالَها",13,"ل",3,0],["نَقَبَ الخُفِّ لِلسُرى فَتَرى الأَن","ساعَ مِن حِلِّ ساعَةٍ وَاِرتِحالِ",14,"ل",1,0],["نَقصٌ مِنَ الشَرقِ وَمِن زَهوِهِ","فَقدُ اليَراعِ المُعجِزِ المُبدِعِ",15,"ع",1,0],["نَقَلَت لَنا الأَسلاكُ عَنكَ رِسالَةً","باتَت لَها أَحشاؤُنا تَتَلَهَّبُ",16,"ب",1,0],["نَقَصَت حَياتُكَ حينَ فَضلُكَ كامِلٌ","هَلا اِستُضيفَ إِلى الكَمالِ كَمالُ",17,"ل",1,0],["نَقودُ الخَيلَ دامِيَةً كُلاه","إِلى الأَعداءِ لاحِقَةً بُطونا",18,"ن",2,0],["نَقِيٌّ طاهِرُ الأَثوابِ بَرٌّ","لِكُلِّ الخَيرِ مُصطَنِعٌ مُحيلُ",19,"ل",1,0],["نقية لم تطالع","بأعين مرتابه",20,"ب",2,0],["نقلته عن أصله جاهداً","في جعله كالأصل من غير عاب",21,"ب",1,0],["نَقَائِضُ فِينَا لَمْ لأُعَدِّدْ جِسَامَهَا","وَلَكِنَّنِي عَدَّدْتُ مَا هُوَ أَجْسَمُ",22,"م",1,0],["نُقِشَت بِالحُسنِ صورَتُهُ","مِن ذُرى قَرنٍ إِلى قَدَمِ",23,"م",1,0],["نُقَلّبه لِنُخبر حالَتَيهِ","فَنُخبرُ منهما كرماً ولينا",24,"ن",2,0],["نَقِيَّ المَآقي سامِيَ الطَّرفِ إِذ غَدا","إِلى كُلِّ أَشباحٍ بَدَت يَستَحيلُها",25,"ل",3,0],["نَقُدُّ بِها الفَلاةَ وَبِالمَطايا","إِلى الأَعدآءِ يَنتَظِرُ الغِوارا",26,"ر",2,0],["نَقَّحنَ جِسمي عَن نُضارِ العودِ","بَعد اِهتِزازِ الغُصُنِ الأُملودِ",27,"د",1,0],["نقطعه بيضا نقيّا","لا مخاف ولا تقيّا",28,"ي",2,0],["نقلوا المعالي كابراً عن كابرٍ","كالرمح مطّردِ الكعوبِ مقوَّمِ",29,"م",1,0],["نقش الزمان بصرفه في صفحة","كلُّ اجتماع مؤذنٌ بفراقِ",30,"ق",1,0],["نقض القوم عهدكم قبل هذا","واستخفُوا بحفظه في صوان",31,"ن",1,0],["نقوم إلى الهياج بلا توان","ونبتدر النزال بلا احتراز",32,"ز",1,0],["نَقيسُ بَقِيّاتِ النِطافِ عَلى الحَصى","وَهُنَّ عَلى طَيِّ الحَيازيمِ جُنَّحُ",33,"ح",1,0],["نُقيمُ لَها النَهارَ إِذا اِدَّلَجنا","وَنَسري وَالقَطا خُرُدٌ هُجودُ",34,"د",1,0],["نُقارِعُهُم وَتَسأَلُ بِنتُ تَيمٍ","أَرَخفٌ زُبدُ أَيسَرَ أَم نَهيدُ",35,"د",1,0],["نَقودُ الجِيادَ المُقرَباتِ عَلى الوَجى","لِأَعدائِكُم حَتّى أَبَرناهُمُ قَسرا",36,"ر",2,0],["نَقودُ جِياداً لَم تَقُدها مُجاشِعٌ","تَكونُ مِنَ الأَعداءِ مَرأىً وَمَسمَعا",37,"ع",2,0],["نُقيمُ عَلى ثُغورِ بَني تَميمٍ","وَنَصدَعُ بَيضَةَ المَلِكِ الهُمامِ",38,"م",1,0],["نَقَلنا سَبيَهُم صِرماً فَصِرماً","إِلى صِرمٍ كَما نُقِلَ النَصيبُ",39,"ب",1,0],["نُقَتِّلُهم جِيلاً فجِيلاً نَرَاهُمُ","شَعَائِرَ قُربانٍ بِهِم يُتقَرَّبُ",40,"ب",1,0],["نُقَتِّلُ يَومَ الوَغى بِالصَفي","حِ بَينَ الكَتيبَةِ قُوّادَها",41,"د",3,0],["نَقتُلُهُم وَالسُيوفُ تَأخُذُهُم","أَخذاً عَنيفاً وَأَنتُمُ كُشُفُ",42,"ف",1,0],["نَقودُ جِيادَ الخَيلِ قُبّاً كَأَنَّها","سِراحَ عَدَت في ذي أَهاضيبِ ماطِرِ",43,"ر",1,0],["نقطعُ اليوم كالدجى في سكونٍ","ودجاهُ كاليومِ في الأضواء",44,"ا",2,0],["نقشُ الفصوص أعادَ صا","حبنا على نقش الحصير",45,"ر",1,0],["نقطة خالٍ ووجنةٌ فعلا","في اللهو لي بعد توبتي غبطه",46,"ه",1,1],["نقلوا أنني سلوت هواك","آه من نقل آثمٍ أفَّاك",47,"ك",1,1],["نقلت شمائله صفات جدوده","نقل الرياض عن الغمامِ الهاطل",48,"ل",1,0],["نقصت بهجة الحياة فلا ين","كر تأثير للنقصِ بعد الكمال",49,"ل",1,0],["نقّب على ودّ الجميل","وقنّع الصبّ بالقليل",50,"ل",1,1],["نقَّصت قوَّتي عن المدحِ فاصْفح","في نظامي عن خجلة التتميم",51,"م",1,0],["نقل الضنا عن مهجتي","خبر الصبابة والجوى",52,"و",2,1],["نقيصةٌ في الشعر من ذكره","أقبحُ في شِعْريَ من خرمِ",53,"م",1,0],["نُقلٌ ونفلٌ إلى نبتٍ لهُ وضِرٍ","كأنه منه في حانوت سمَّان",54,"ن",1,0],["نَقتادُ كُلَّ طِمِرَّةٍ رَأدَ الضُحى","وَعِنانَ كُلِّ مُجَلجِلٍ صَهّالِ",55,"ل",1,0],["نَقَلَ الأَعصُرَ الخَوالي إِلَينا","في كِتابٍ لِلَّهِ مِن مُعجِزاتِه",56,"ت",2,0],["نُقِلَت إِلَيَّ جَميعُها","حَتّى كَأَنّي كُنتُ حاضِر",57,"ر",1,0],["نَقَصتُ إِذ جَعَلتُهُ كَبيري","كَما تُزادُ الياءُ في التَصغيرِ",58,"ر",1,0],["نُقارِبُ أَفنانَ الصِبى وَيَرُدُّنا","حَياءٌ إِذا كِدنا نُلِمُّ فَنَجمَحُ",59,"ح",1,0],["نَقانِقُ أَشباهٌ بَرى قَمَعاتِها","بُكورٌ وَإِسآدٌ وَمَيسٌ مُشَيَّحُ",59,"ح",1,0],["نَقِفُ الحَديثَ إِذا خَشِينا كاشِحاً","ونَلِطُّ حينَ نَخافُ بالأَمثَالِ",60,"ل",1,0],["نَقِف بِمَغانٍ قَد مَحا رَسمَها البِلى","تُعاقِبُها الأَيّامُ بِالريحِ وَالوَبلِ",61,"ل",1,0],["نقدت قريضي ثلة","لا تعرف الأدب اللبابا",62,"ب",2,1],["نقرأ الآراء الجريئة في الدين","فلا نلحوها ولا نتحزب",63,"ب",1,0],["نقدت نزيها ما نقدت فلا تخف","وعيداً واتمم ما بدأت وعقب",64,"ب",1,0],["نقصت حق بنى مصر وليس لهم","ذنب سوى أنهم طلاب دستور