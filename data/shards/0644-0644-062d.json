{"poems":[[63,"إيها فكم تهصر أغصان الضال","https://www.aldiwan.net/poem46152.html","الرجز"],[55,"عدل من الله أبكاني وأضحككم","https://www.aldiwan.net/poem26256.html","البسيط"],[55,"جربت من هذه الدنيا شدائدها","https://www.aldiwan.net/poem26275.html","البسيط"],[55,"للحب في قلبي أشجار","https://www.aldiwan.net/poem26328.html","السريع"],[73,"للحب في تلك القباب مراد","https://www.aldiwan.net/poem11948.html","الكامل"],[93,"قد قام عرشك في أعز مكان","https://www.aldiwan.net/poem11213.html","الكامل"],[88,"للجعفرين شهادة الأبرار","https://www.aldiwan.net/poem45042.html","الكامل"],[4,"درس المنا بمتالع فأبان","https://www.aldiwan.net/poem21206.html","الكامل"],[23,"ولقد بكيت وعز مهلك جعفر","https://www.aldiwan.net/poem21429.html","الكامل"],[72,"خلعة قاضي القضاة لا برحت","https://www.aldiwan.net/poem18469.html","المنسرح"],[72,"صرفت فعلي في الأسى وقولي","https://www.aldiwan.net/poem20616.html","الرجز"],[51,"للحريثي أبي بكر غبب","https://www.aldiwan.net/poem8500.html","الرمل"],[51,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[51,"للحريثي نكهة","https://www.aldiwan.net/poem66535.html","مجزوء الخفيف"],[91,"وطن النجوم أنا هنا","https://www.aldiwan.net/poem62783.html","عموديه"],[92,"ههنا في خمائل الغاب تحت الزا","https://www.aldiwan.net/poem38901.html","المديد"],[78,"لله در الحب ماذا يصنع","https://www.aldiwan.net/poem14250.html","الكامل"],[89,"قد عدت بعد ذهاب منك يا عيد","https://www.aldiwan.net/poem44645.html","البسيط"],[89,"ما للحياة وراء الموت تجديد","https://www.aldiwan.net/poem44788.html","البسيط"],[85,"من أي عهد في القرى تتدفق","https://www.aldiwan.net/poem63707.html","الكامل"],[45,"إن الظباء غداة سفح محجر","https://www.aldiwan.net/poem63628.html","البسيط"],[61,"وسألت عنه فقيل مات لما به","https://www.aldiwan.net/poem51761.html","الكامل"],[49,"الخير والشر عادات وأهواء","https://www.aldiwan.net/poem10313.html","البسيط"],[66,"للحسن حلاوة وبالعين تذاق","https://www.aldiwan.net/poem39631.html","الدوبيت"],[44,"أصم بك الناعي وإن كان أسمعا","https://www.aldiwan.net/poem30308.html","الطويل"],[44,"سعدت غربة النوى بسعاد","https://www.aldiwan.net/poem30559.html","الخفيف"],[105,"خلت المنازل منك والأوطان","https://www.aldiwan.net/poem41941.html","الكامل"],[105,"قصوا الحديث عن الفريق النائي","https://www.aldiwan.net/poem42116.html","الكامل"],[105,"من حق ركبك أن يهز النيلا","https://www.aldiwan.net/poem43063.html","الكامل"],[105,"من لي بأجنحة العواصف مركبا","https://www.aldiwan.net/poem43146.html","الكامل"],[105,"هم سادة الحرب من شيب وشبان","https://www.aldiwan.net/poem43573.html","البسيط"],[105,"الكتب تترى والكتائب تدلف","https://www.aldiwan.net/poem43999.html","الكامل"],[105,"تعلموا كيف تبني مجدها الأمم","https://www.aldiwan.net/poem44217.html","البسيط"],[102,"إخواننا أهل الوفاء","https://www.aldiwan.net/poem32979.html","مجزوء الكامل"],[48,"متتايه بجماله صلف","https://www.aldiwan.net/poem66181.html","الكامل"],[7,"هذا غلام حسن وجهه","https://www.aldiwan.net/poem1964.html","السريع"],[46,"للحال بالقدر اللطيف تغير","https://www.aldiwan.net/poem22559.html","الكامل"],[46,"الليالي مغيرات السجايا","https://www.aldiwan.net/poem23004.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85405","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85499","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39556","البسيط"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42608","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42696","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54774","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141918","الكامل"],[106,"تحية مولود","https://www.poetsgate.com/ViewPoem.aspx?id=179596",""],[106,"لا نكسة","https://www.poetsgate.com/ViewPoem.aspx?id=179333",""],[90,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[90,"الى الخاتون المسبل","https://www.poetsgate.com/ViewPoem.aspx?id=179039",""],[45,"إنّ الظّبَاءَ، غَداةَ سَفحِ مُحَجَّرِ","https://www.poetsgate.com/ViewPoem.aspx?id=31190",""],[51,"أقسمتُ والحنثُ له آثامُ","https://www.poetsgate.com/ViewPoem.aspx?id=30408",""],[99,"الى صديقة جديدة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=347&r=&rc=53",""],[87,"لِهَوَى الْكَواعِبِ ذِمَّة ٌ لاَ تُخْفَرُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23922&r=&rc=184",""],[113,"مهيجة ذات وجد","https://www.aldiwan.net/poem40625.html","عموديه"],[117,"من لم يؤدبه تأديب الكتاب فما","https://www.aldiwan.net/poem4362.html","البسيط"],[124,"للحب دين وللأشواق باقينا","https://www.aldiwan.net/poem794.html",""],[183,"هجر العذول وراح طوع غواته","https://www.aldiwan.net/poem14131.html","الكامل"],[183,"كم قدر ما أخفي الهون وأصون","https://www.aldiwan.net/poem14687.html","الكامل"],[193,"ألمم على طلل عفا متقادم","https://www.aldiwan.net/poem54417.html","الكامل"],[196,"مطلول أملود الصبا مياسه","https://www.aldiwan.net/poem51937.html","الكامل"],[197,"للحسان الدلال والخيلاء","https://www.aldiwan.net/poem45375.html","الخفيف"],[202,"قلب تمكن فيه الشوق فاحترقا","https://www.aldiwan.net/poem53224.html","البسيط"],[208,"سواه لو ذبت من نواه","https://www.aldiwan.net/poem13359.html","مخلع البسيط"],[273,"مهج تساق إلى الردى فتشاق","https://www.aldiwan.net/poem25476.html","الكامل"],[273,"طنب قبابك هذا العز والشرف","https://www.aldiwan.net/poem25479.html","البسيط"],[280,"في عنفوان الصبا ما كنت بالغزل","https://www.aldiwan.net/poem32668.html","البسيط"],[280,"يا ذا العذار الذي به عذري","https://www.aldiwan.net/poem32766.html","المنسرح"],[295,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[347,"للحق في كل وجه","https://www.aldiwan.net/poem15701.html","المجتث"],[364,"للحسن في ذا الوجه معجزة","https://www.aldiwan.net/poem17072.html","أحذ الكامل"],[369,"أبقى الرسيم من الركاب رسوما","https://www.aldiwan.net/poem57136.html","الكامل"],[397,"للحب قلب نابض","https://www.aldiwan.net/poem6705.html","عموديه"],[406,"نفسي الفداء لظالم متعتب","https://www.aldiwan.net/poem31844.html","الكامل"],[429,"لذي الظلامة عد الظلم والشنب","https://www.aldiwan.net/poem12438.html","البسيط"],[436,"طلعت نجوم السعد من آفاقها","https://www.aldiwan.net/poem34800.html","الكامل"],[438,"بئس الصداقة عقباها العداوات","https://www.aldiwan.net/poem14353.html","البسيط"],[447,"إلى ربيع العمر","https://www.aldiwan.net/poem1006.html",""],[456,"يذنب دهر ويستقيل","https://www.aldiwan.net/poem55932.html","مخلع البسيط"],[462,"بكت وقد أبصرتني ضاحك الشعر","https://www.aldiwan.net/poem3471.html","عموديه"],[477,"الحب داء دفين","https://www.aldiwan.net/poem36935.html","المجتث"],[498,"للحق نور ليس يحجب ضؤه","https://www.aldiwan.net/poem37552.html","الكامل"],[498,"يا بارقا قد تلوى","https://www.aldiwan.net/poem37978.html","المجتث"],[512,"رنا فسل على العشاق أحوره","https://www.aldiwan.net/poem20792.html","البسيط"],[512,"روى عن الريق منها الثغر والشنب","https://www.aldiwan.net/poem20812.html","البسيط"],[542,"أنّى التفتّ فثمّ إسمك","https://www.aldiwan.net/poem67251.html","عموديه"],[556,"أحزاننا بلقائكم أفراح","https://www.aldiwan.net/poem34674.html","الكامل"],[558,"معايدات سريعة","https://www.aldiwan.net/poem67272.html","عموديه"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["للحَدْوِ بالأهْزاجِ قبلَ الأرْمالْ","قدْ وشّجَتْ بالغَدَواتِ الآصالْ",0,"ل",1,0],["لِلحُبِّ في كُلِّ عُضوٍ لي عَلى حِدَةٍ","لَذعٌ يُفَرِّقُ عَنهُ الصَبرَ وَالجَزَعا",1,"ع",2,0],["لِلحُبِّ كَأسٌ مِنَ الرَوعاتِ مُترَعَةٌ","فَكُلُّ مَن كانَ ذا طَرفٍ بِها حاسِ",2,"س",1,0],["للحُبِّ في قَلبِيَ أَشجَارُ","تُنبِتُها لِلشَّوقِ أَنهارُ",3,"ر",1,1],["لِلحُبِّ في تِلكَ القِبابِ مَرادُ","لَو ساعَفَ الكَلِفَ المَشوقَ مُرادُ",4,"د",1,1],["لِلْحُسْنِ آيَاتٌ مَوَاثِلُ حَوْلَهُ","مِنْ مُثْلِجٍ صَدْراً وَمِنْ فَتَّانِ",5,"ن",1,0],["للحقّ والشرف المخلّد في الدنى","قاما قيام المنجد المغيار",6,"ر",1,0],["لِلحَنظَلِيَّةِ أَصبَحَت آياتُها","يَبرُقنَ تَحتَ كَنَهبُلِ الغُلّانِ",7,"ن",1,0],["لِلحَقِّ حينَ يَنوبُ غَيرَ تَنَحُّلٍ","كَذِباً وَأَغمَرِها يَداً وَأَقَلَّها",8,"ل",3,0],["للحكمِ كالملكِ أنتِ صالحةٌ","يا خلعةَ الطيلسان والتاج",9,"ج",1,0],["للحظهِ المسكر فعل يطرب","مفعولهُ مثل سقى ويشرب",10,"ب",1,0],["للحُريثيِّ أبي بكرٍ غَبَبْ","وله قَرنانِ أيضاً وذَنَبْ",11,"ب",1,1],["لِلْحِلمِ والرَّأْيِ فيهم حين تَخْبرُهُمْ","شيخانُ صِدْقٍ وللْهيجاءِ فِتيان",12,"ن",1,0],["للحريثيّ نكهةٌ","تترك البيتَ مُنتنا",13,"ن",2,1],["لِلحَقلِ يَرتَجِلُ الرَواَئيع","زَنبَقاً أَُ سَوسَنا",14,"ن",2,0],["للحياةِ التي تغنِّي حوالَيَّ","على السَّهْلِ والرُّبى والحُزُونِ",15,"ن",1,0],["لِلحُبِّ سُلطانٌ عَظيمٌ شانُهُ","مَهما يَقُل قَولاً فَقَلبي يَسمَعُ",16,"ع",1,0],["للحق حام وفي الايام متسع","الست تؤمن ان الله موجود",17,"د",1,0],["للحي جهد جهيد للحياة وما","للميت كيما يدوم الموت مجهود",18,"د",1,0],["لِلحَقِّ فيهِ جَولَةٌ وَلَهُ سَناً","كَالصُبحِ مِن جَنَباتِها يَتَفَلَّقُ",19,"ق",1,0],["لِلحُبِّ عَهدٌ في فُؤادي لَم يَهِن","مِنهُ السُلُوُّ وَذِمَّةٌ لَم تُخفَرِ",20,"ر",1,0],["للحَملِ عن مُنتابِه للنُّصْحِ عن","أسبابِه للصَّفْحِ عن مُغتابِه",21,"ب",2,0],["لِلحِلمِ شاهِدُ صِدقٍ حينَ ما غَضَبٌ","وَلِلحَليمِ عَنِ العَوراتِ إِغضاءُ",22,"ا",2,0],["لِلحُسنِ حَلاوَةٌ وَبِالعَينِ تُذاقُ","إِن كُنتَ تَراها بِعُيونِ العُشّاق",23,"ق",1,1],["لِلَحدِ أَبي نَصرٍ تَحِيَّةُ مُزنَةٍ","إِذا هِيَ حَيَت مُمعِراً عادَ مُمرِعا",24,"ع",2,0],["لِلحَمالاتِ وَالحَمائِلِ فيهِ","كَلُحوبِ المَوارِدِ الأَعدادِ",25,"د",1,0],["لِلحقِّ صَوْلَتُه وشِدّةُ بأسهِ","وَلِمَنْ يُحارِبُ جُندَه الخِذلانُ",26,"ن",1,0],["لِلحقِّ في ظُلَمِ الأُمورِ مَسالكٌ","بيضُ المعالمِ غيرِ ذاتِ خَفاءِ",27,"ا",2,0],["لِلحُرِّ أَخلاقٌ تَميلُ بِنَفسِهِ","عَن أَن يُغَيِّر عَهدَهُ وَيَحولا",28,"ل",2,0],["لِلحَقِّ جُندٌ إِن مَشى بِلِوائِهِ","غَلَبَ الأَعَزَّ مِنَ الجُنودِ الأَغلَبا",29,"ب",2,0],["للحقِّ سُلطانُهُ فليأتِ مُنكِرُهُ","إنِ اسْتَطاعَ له رَدّاً بِسُلطَانِ",30,"ن",1,0],["لِلحقِّ مِئذنةٌ وَدَاعٍ مُسمِعٌ","في كلِّ شيءٍ بالخلائقِ يَهتِفُ",31,"ف",1,0],["لِلحقِّ نَشوتُهُ في نفس شاربِه","وليس يشربه إلا امرؤٌ فَهِمُ",32,"م",1,0],["للحَقَّ سَطْرٌ في صحا","فتِنا وللتَّضْليلِ نهرُ",33,"ر",1,0],["لِلحُسنِ في وَجَناتِهِ بِدَعٌ","ما إِن يَمَلُّ الدَرسَ فاريها",34,"ي",3,0],["لِلحارِثِ الأَكبَرِ وَالحارِثِ ال","أَصغَرِ وَالأَعرَجِ خَيرِ الأَنام",35,"م",1,0],["لِلحالِ بِالقَدَرِ اللَطيفِ تَغَيُّرُ","فَليَنأَ عَنكَ تَفاؤُلٌ وَتَطَيُّرُ",36,"ر",1,1],["لِلحَديدِ العُلا عَلى سائِرِ الجَو","هَرِ ذُلُّ العِدى وَعِزُّ الضُيوفِ",37,"ف",1,0],["للحَرب وَيلات بِنِس","بَتها هنالك تكبرُ",38,"ر",1,1],["للحرب كسر في عظا","مِ رجالها لا يجبر",38,"ر",1,0],["للحَياة الرقيُّ في كل يوم","غرض ماجد من الأغراض",39,"ض",1,0],["للحُبِّ أولُ أشعارٍ هتفتُ بها","وللجمالِ بها أولى رسالاتي",40,"ي",1,0],["لِلْحُسْنِ أَسْحِلَةٌ إِذَا مَا اسْتَجْمَعَتْ","فِي حَوْمَةٍ لا يَتَّقِيهَا مغْفَرُ",41,"ر",1,0],["لِلْحُبِّ مِنْ مُهْجَتِي كَهْفٌ يَلُوذُ بِهِ","مِنْ غَدْرِ كُلِّ امْرِئٍ بِالشَّرِّ وَقَّاعِ",42,"ع",1,0],["لِلْحُسْنِ فِيهَا مَحْضرٌ","جَمٌّ عَجَائِبهُ وَمَبْدَى",43,"د",2,0],["للحب أكثرها وبعض كثيرها","لرقى الجمال وبعضهما للراح",44,"ح",1,0],["للحقِّ نور تجلَّى حولَ جبهتِهِ","وللذكاءِ شُعاعٌ في مُحَّياهُ",45,"ا",2,0],["للحرب جندٌ يصبرون على الطَّوى","يوم اللقاء، ويلبسون العِثْيَرا",46,"ر",2,0],["للحاكمينَ بأمرِهم عن غَيرِهم!","ولصَفْوةِ الأسباطِ والأصهار",47,"ر",1,0],["للحشر بين حلوقِكم وضلوعِكم","من فضلِ ما صنعوا كحزِ مواسي",48,"س",2,0],["للحُبّ عَهدٌ في فُؤادي لَمْ يَحِنْ","مِنْهُ السّلُوُّ، وَذِمّةٌ لَمْ تُخْفَرِ",49,"ر",1,0],["للحمال يرضى ظلمَه الحكامُ","سيشكر الشهرُ لك الحرامُ",50,"م",1,0],["للحسن ثوراتٌ فلا تهابي","وجرِّبي أختاهُ أن تثوري",51,"ر",2,0],["لِلْحُسْنِ أَسْلِحَة ٌ إِذَا مَا اسْتَجْمَعَتْ","فِي حَوْمَة ٍ لا يَتَّقِيهَا مغْفَرُ",52,"ر",1,0],["للحسن يا ريم يوما","بالرغم عنك زوال",53,"ل",1,0],["للحرب جلُّ مساعيه وما تَرَكَت","منه الحروبُ تهادَتهُ المحاريبُ",54,"ب",1,0],["للحب دين وللأشواق باقينا","وللصبابة ما أبقى الصبا فينا",55,"ن",2,1],["للحبِّ حَبةُ قلبِهِ فكأنّه","من ذاتِها وكأنها من ذاتِهِ",56,"ت",2,0],["للحربِ والمِحْرابِ منه مَواقفٌ","عَمِرت بها الدنيا وعزَّ الدين",57,"ن",1,0],["لِلحَمدِ فيهِ مَذاهِبٌ ما تَنتَهي","وَمَكارِمٌ يَعلونَ كُلَّ مَكارِمِ",58,"م",1,0],["للحسنِ مرقوماً على وجناته","سطرٌ وصفحةُ خدِّه قرطاسه",59,"س",2,0],["للحسانِ الدلالُ والخيلاءُ","ولكِ الأمرُ بعدُ يا حسناءُ",60,"ا",2,1],["للحبِّ نارٌ على الأكباد مُشعَلةٌ",