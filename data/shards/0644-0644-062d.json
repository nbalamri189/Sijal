px?id=155676",""],[6149,"سبحان من صاغه وكون","https://www.poetsgate.com/ViewPoem.aspx?id=169628",""],[6167,"أغنية الأحزان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85547&r=&rc=30",""],[6177,"لن أعود إليك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79464&r=&rc=24",""],[1583,"عيناكِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=73061&r=&rc=18",""],[5355,"يا قدس مهلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87121&r=&rc=16",""],[6072,"رُحى الحُب والحرب !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85442&r=&rc=29",""],[6243,"أكان يصعُبُ !؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84431&r=&rc=5",""],[6325,"صورة أخرى للحرب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88018&r=&rc=0",""],[6352,"هي دار غيبته فحي قبابها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22743&r=&rc=4",""]],"verses":[["للحَدْوِ بالأهْزاجِ قبلَ الأرْمالْ","قدْ وشّجَتْ بالغَدَواتِ الآصالْ",0,"ل",1,0],["لِلحُبِّ في كُلِّ عُضوٍ لي عَلى حِدَةٍ","لَذعٌ يُفَرِّقُ عَنهُ الصَبرَ وَالجَزَعا",1,"ع",2,0],["لِلحُبِّ كَأسٌ مِنَ الرَوعاتِ مُترَعَةٌ","فَكُلُّ مَن كانَ ذا طَرفٍ بِها حاسِ",2,"س",1,0],["للحُبِّ في قَلبِيَ أَشجَارُ","تُنبِتُها لِلشَّوقِ أَنهارُ",3,"ر",1,1],["لِلحُبِّ في تِلكَ القِبابِ مَرادُ","لَو ساعَفَ الكَلِفَ المَشوقَ مُرادُ",4,"د",1,1],["لِلْحُسْنِ آيَاتٌ مَوَاثِلُ حَوْلَهُ","مِنْ مُثْلِجٍ صَدْراً وَمِنْ فَتَّانِ",5,"ن",1,0],["للحقّ والشرف المخلّد في الدنى","قاما قيام المنجد المغيار",6,"ر",1,0],["لِلحَنظَلِيَّةِ أَصبَحَت آياتُها","يَبرُقنَ تَحتَ كَنَهبُلِ الغُلّانِ",7,"ن",1,0],["لِلحَقِّ حينَ يَنوبُ غَيرَ تَنَحُّلٍ","كَذِباً وَأَغمَرِها يَداً وَأَقَلَّها",8,"ل",3,0],["للحكمِ كالملكِ أنتِ صالحةٌ","يا خلعةَ الطيلسان والتاج",9,"ج",1,0],["للحظهِ المسكر فعل يطرب","مفعولهُ مثل سقى ويشرب",10,"ب",1,0],["للحُريثيِّ أبي بكرٍ غَبَبْ","وله قَرنانِ أيضاً وذَنَبْ",11,"ب",1,1],["لِلْحِلمِ والرَّأْيِ فيهم حين تَخْبرُهُمْ","شيخانُ صِدْقٍ وللْهيجاءِ فِتيان",12,"ن",1,0],["للحريثيّ نكهةٌ","تترك البيتَ مُنتنا",13,"ن",2,1],["للحقلِ يرتجلُ الرّوائعَ","زَنبقا أو سوسنا",14,"ن",2,0],["لِلحَقلِ يَرتَجِلُ الرَواَئيع","زَنبَقاً أَُ سَوسَنا",15,"ن",2,0],["للحياةِ التي تغنِّي حوالَيَّ","على السَّهْلِ والرُّبى والحُزُونِ",16,"ن",1,0],["لِلحُبِّ سُلطانٌ عَظيمٌ شانُهُ","مَهما يَقُل قَولاً فَقَلبي يَسمَعُ",17,"ع",1,0],["للحق حام وفي الايام متسع","الست تؤمن ان الله موجود",18,"د",1,0],["للحي جهد جهيد للحياة وما","للميت كيما يدوم الموت مجهود",19,"د",1,0],["لِلحَقِّ فيهِ جَولَةٌ وَلَهُ سَناً","كَالصُبحِ مِن جَنَباتِها يَتَفَلَّقُ",20,"ق",1,0],["لِلحُبِّ عَهدٌ في فُؤادي لَم يَهِن","مِنهُ السُلُوُّ وَذِمَّةٌ لَم تُخفَرِ",21,"ر",1,0],["للحَملِ عن مُنتابِه للنُّصْحِ عن","أسبابِه للصَّفْحِ عن مُغتابِه",22,"ب",2,0],["لِلحِلمِ شاهِدُ صِدقٍ حينَ ما غَضَبٌ","وَلِلحَليمِ عَنِ العَوراتِ إِغضاءُ",23,"ا",2,0],["لِلحُسنِ حَلاوَةٌ وَبِالعَينِ تُذاقُ","إِن كُنتَ تَراها بِعُيونِ العُشّاق",24,"ق",1,1],["لِلَحدِ أَبي نَصرٍ تَحِيَّةُ مُزنَةٍ","إِذا هِيَ حَيَت مُمعِراً عادَ مُمرِعا",25,"ع",2,0],["لِلحَمالاتِ وَالحَمائِلِ فيهِ","كَلُحوبِ المَوارِدِ الأَعدادِ",26,"د",1,0],["لِلحقِّ صَوْلَتُه وشِدّةُ بأسهِ","وَلِمَنْ يُحارِبُ جُندَه الخِذلانُ",27,"ن",1,0],["لِلحقِّ في ظُلَمِ الأُمورِ مَسالكٌ","بيضُ المعالمِ غيرِ ذاتِ خَفاءِ",28,"ا",2,0],["لِلحُرِّ أَخلاقٌ تَميلُ بِنَفسِهِ","عَن أَن يُغَيِّر عَهدَهُ وَيَحولا",29,"ل",2,0],["لِلحَقِّ جُندٌ إِن مَشى بِلِوائِهِ","غَلَبَ الأَعَزَّ مِنَ الجُنودِ الأَغلَبا",30,"ب",2,0],["للحقِّ سُلطانُهُ فليأتِ مُنكِرُهُ","إنِ اسْتَطاعَ له رَدّاً بِسُلطَانِ",31,"ن",1,0],["لِلحقِّ مِئذنةٌ وَدَاعٍ مُسمِعٌ","في كلِّ شيءٍ بالخلائقِ يَهتِفُ",32,"ف",1,0],["لِلحقِّ نَشوتُهُ في نفس شاربِه","وليس يشربه إلا امرؤٌ فَهِمُ",33,"م",1,0],["للحَقَّ سَطْرٌ في صحا","فتِنا وللتَّضْليلِ نهرُ",34,"ر",1,0],["لِلحُسنِ في وَجَناتِهِ بِدَعٌ","ما إِن يَمَلُّ الدَرسَ فاريها",35,"ي",3,0],["لِلحارِثِ الأَكبَرِ وَالحارِثِ ال","أَصغَرِ وَالأَعرَجِ خَيرِ الأَنام",36,"م",1,0],["لِلحالِ بِالقَدَرِ اللَطيفِ تَغَيُّرُ","فَليَنأَ عَنكَ تَفاؤُلٌ وَتَطَيُّرُ",37,"ر",1,1],["لِلحَديدِ العُلا عَلى سائِرِ الجَو","هَرِ ذُلُّ العِدى وَعِزُّ الضُيوفِ",38,"ف",1,0],["للحَرب وَيلات بِنِس","بَتها هنالك تكبرُ",39,"ر",1,1],["للحرب كسر في عظا","مِ رجالها لا يجبر",39,"ر",1,0],["للحَياة الرقيُّ في كل يوم","غرض ماجد من الأغراض",40,"ض",1,0],["للحُبِّ أولُ أشعارٍ هتفتُ بها","وللجمالِ بها أولى رسالاتي",41,"ت",2,0],["لِلْحُسْنِ أَسْحِلَةٌ إِذَا مَا اسْتَجْمَعَتْ","فِي حَوْمَةٍ لا يَتَّقِيهَا مغْفَرُ",42,"ر",1,0],["لِلْحُبِّ مِنْ مُهْجَتِي كَهْفٌ يَلُوذُ بِهِ","مِنْ غَدْرِ كُلِّ امْرِئٍ بِالشَّرِّ وَقَّاعِ",43,"ع",1,0],["لِلْحُسْنِ فِيهَا مَحْضرٌ","جَمٌّ عَجَائِبهُ وَمَبْدَى",44,"د",2,0],["للحب أكثرها وبعض كثيرها","لرقى الجمال وبعضهما للراح",45,"ح",1,0],["للحقِّ نور تجلَّى حولَ جبهتِهِ","وللذكاءِ شُعاعٌ في مُحَّياهُ",46,"ا",2,0],["للحرب جندٌ يصبرون على الطَّوى","يوم اللقاء، ويلبسون العِثْيَرا",47,"ر",2,0],["للحاكمينَ بأمرِهم عن غَيرِهم!","ولصَفْوةِ الأسباطِ والأصهار",48,"ر",1,0],["للحشر بين حلوقِكم وضلوعِكم","من فضلِ ما صنعوا كحزِ مواسي",49,"س",2,0],["للحين باقي بدربه من رحيقك رحيق","وللحين أيتمتم حكينا العذب .. ويدندنه",50,"ن",2,0],["للحُبّ عَهدٌ في فُؤادي لَمْ يَحِنْ","مِنْهُ السّلُوُّ، وَذِمّةٌ لَمْ تُخْفَرِ",51,"ر",1,0],["للحمال يرضى ظلمَه الحكامُ","سيشكر الشهرُ لك الحرامُ",52,"م",1,0],["للحسن ثوراتٌ فلا تهابي","وجرِّبي أختاهُ أن تثوري",53,"ر",2,0],["لِلْحُسْنِ أَسْلِحَة ٌ إِذَا مَا اسْتَجْمَعَتْ","فِي حَوْمَة ٍ لا يَتَّقِيهَا مغْفَرُ",54,"ر",1,0],["للحسن يا ريم يوما","بالرغم عنك زوال",55,"ل",1,0],["للحرب جلُّ مساعيه وما تَرَكَت","منه الحروبُ تهادَتهُ المحاريبُ",56,"ب",1,0],["للحب دين وللأشواق باقينا","وللصبابة ما أبقى الصبا فينا",57,"ن",2,1],["للحبِّ حَبةُ قلبِهِ فكأنّه","من ذاتِها وكأنها من ذاتِهِ",58,"ت",2,0],["للحربِ والمِحْرابِ منه مَواقفٌ","عَمِرت بها الدنيا وعزَّ الدين",59,"ن",1,0],["لِلحَمدِ فيهِ مَذاهِبٌ ما تَنتَهي","وَمَكارِمٌ يَعلونَ كُلَّ مَكارِمِ",60,"م",1,0],["للحسنِ مرقوماً على وجناته","سطرٌ وصفحةُ خدِّه قرطاسه",61,"س",2,0],["للحسانِ الدلالُ والخيلاءُ","ولكِ الأمرُ بعدُ يا حسناءُ",62,"ا",2,1],["للحبِّ نارٌ على الأكباد مُشعَلةٌ","لو أُشعِلَت في ضرام النار لاحترقا",63,"ق",2,0],["للحظه الظبي قال احكي","وقال قولا وما حكاه",64,"ا",2,0],["لِلْحلمِ سُوقٌ في نَفَاقٍ عِنْدهُ","وبِمَا يُخَوِّلُ تَكْسُد الأَعْلاقُ",65,"ق",1,0],["لِلحَقِّ مُمْتَعِضٌ في اللَّهِ مُرْتَمِضٌ","بِاللَّهِ مُنْتَصِرٌ للَّهِ مُنْصَرِفُ",66,"ف",1,0],["لِلحَقِّ قالَ وَهَل تَلقاهُ مُنفَعِلاً","لِلمَدحِ وَهوَ شَديدُ العِشقِ لِلبَخَلِ",67,"ل",1,0],["لِلحَربِ مِنهُ اللَيثُ المُدِلُّ إِذا","كَرَّ صَئولاً في الجَحفَلِ المَجرِ",68,"ر",1,0],["للحرصِ طَعمٌ مُرُّ","وشرُّه شِمِرُّ",69,"ر",1,0],["لِلحَقِّ في كُلِّ وَجهٍ","لِلخَلقِ وَجهٌ مُنيرُ",70,"ر",1,1],["لِلحُسنِ في ذا الوَجهِ مُعجِزَةٌ","نَطَقَت لِتُخرِسَ ناطِقَ العُقَلا",71,"ل",2,1],["للحادِثاتِ مَعي حَديثٌ مُبهَمٌ","أضحَى النَّهارُ عليَّ مِنه بَهيما",72,"م",2,0],["للحبِّ قلبٌ نابضٌ ولسانُ","وله حسامٌ صارمٌ وسنانُ",73,"ن",1,1],["للحبِّ وردته التي في عطره","سرٌ به أوراقُها تزدانُ",73,"ن",1,0],["للحبِّ خيمته الكبيرة تحته","تلقى الأمانَ وتسعدُ الأوطانُ",73,"ن",1,0],["لِلِحاظِهِ في القلبِ وَقعُ سهامِهِ","لكنَّ تلكَ تطيشُ وَهيَ تُصيبُ",74,"ب",1,0],["للحسن روضٌ رأيتُ اللحظَ يقطِفُه","منه الغصونُ التي يحكونَ والكُثُبُ",75,"ب",1,0],["للحاجِبِ الأَعْلى المُصَرِّف هِمَّةً","موصولةً بشآمِها وعِراقِها",76,"ق",3,0],["للحب والبغض آيات تدلهما","وكل شيءٍ له وصفٌ وآيات",77,"ت",1,0],["للحسن فيك بديعه وبيانه","ولي القصيد جمانه ونضاره",78,"ر",2,0],["للحسن وجهٌ أغرُّ منها","والحسن في غيرها حجُولُ",79,"ل",1,0],["للحزن في القلب آثارٌ مبيَّنةٌ","لا خيرَ في القلب من حزنٍ بلا أثرِ",80,"ر",1,0],["للحب وهو الجنين","إذا فنحن حبالى",81,"ل",2,0],["للحقِّ نورٌ ليس يحجب ضؤهُ","عتمٌ ولا يطوي هداه ساتر",82,"ر",1,1],["للحُبِّ والَهْفَ قلبي","على الطِّباعِ انْطِباعِ",83,"ع",1,0],["للحتفِ في جفنهِ السّاجي مُضارعةٌ","لذلك اِشتُقَّ من ماضيهِ مَصدَرُهُ",84,"ر",2,0],["للحُسنِ سرٌّ طواهُ في مراشِفِها","أوحاهُ منه إليها النّحْلُ والعِنَبُ",85,"ب",1,0],["للحُبِّ (مُزْدَلَفٌ) لديكِ و(مَشْعَرُ)","أنا ذا (أَحُجُّ)كِ مُغْرَماً و(أُقَصِّرُ)",86,"ر",1,1],["للحب حيث به تنير ربوعهم","لما تزايد بالفراق ولوعهم",87,"م",1,0],["للحُزنِ فيْ قَسَماتِ الطفلِ أُغنيةٌ","من اليَباسِ وحُلْمٌ مات مَقتُولا",88,"ل",2,0],["للحج لما إن رأته حصرا"