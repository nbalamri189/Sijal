w.poetsgate.com/ViewPoem.aspx?id=30810",""],[5277,"روحُ العيد","https://www.poetsgate.com/ViewPoem.aspx?id=189672",""],[5277,"خاتمةُ المراثي","https://www.poetsgate.com/ViewPoem.aspx?id=199869",""],[5277,"طبائعُ الغربة","https://www.poetsgate.com/ViewPoem.aspx?id=206055",""],[5338,"دمشق الصمود دمشق الفدا","https://www.poetsgate.com/ViewPoem.aspx?id=189744",""],[5358,"مسار الكواكب","https://www.poetsgate.com/ViewPoem.aspx?id=21906",""],[5431,"فديتك...","https://www.poetsgate.com/ViewPoem.aspx?id=196955",""],[5677,"بني عزيز ..!","https://www.poetsgate.com/ViewPoem.aspx?id=179980",""],[5690,"أما ينقضي هذا التدلل والصدُّ","https://www.poetsgate.com/ViewPoem.aspx?id=172154",""],[5722,"أحبابي الموتى","https://www.poetsgate.com/ViewPoem.aspx?id=12692",""],[6106,"هم الطهارة ( سادتنا أهل البيت )","https://www.poetsgate.com/ViewPoem.aspx?id=6304",""],[520,"عنان اليالي في يديك مسلم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577658",""],[5190,"في رثاء النفس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85067&r=&rc=142",""]],"verses":[["وَيا طَوقاً تَخاوَصُ عَن","جَوانِبِهِ جَبايِرُه",0,"ر",2,0],["وَيا طِبّاً رَجَوتُ صَلاحَ جِسمي","بِكَفَّيهِ فَزادَ بَلاءَ جُرحي",1,"ح",2,0],["ويا طاعِناً نحْرَ الدُّجُنّةِ يَبْتَغي","طُلوعَ سَنى الخَيْماتِ في مَطْلَعِ الفَجْرِ",2,"ر",1,0],["وَيا طالِبي الدُستورِ لا تَسكُنوا وَلا","تَبيتوا عَلى يَأسٍ وَلا تَتَضَجَّروا",3,"ر",3,0],["ويا طبيب القوم لا تؤذِهم","إن دواء الموت لا ينجع",4,"ع",1,0],["ويا طربي فيها إلى سود أعينٍ","على مثلها في كلِّ داجيةٍ أبكي",5,"ك",2,0],["ويا طالبَ المعروفِ من غيرِ وجههِ","إليهم فثَمّ النيْلُ لا شك والنالُ",6,"ل",1,0],["وَيا طالَما أَحدَقوهُ بِالفَتى","كَما تُحدِقُ الجُندُ بِالظافِرِ",7,"ر",1,0],["وَيا طَبيباً يُداوي الناسَ مِن عِلَلٍ","داءُ الأَسى اليَومَ فيهِم مَن يُداويهِ",8,"ي",2,0],["وَيا طالَما بِتنا وَلا ثالِثَ لَنا","سِوى الراحِ نُدنيها فَتُدني الأَمانِيا",9,"ي",2,0],["وَيا طيبَ نادٍ في ذُرى البَيتِ بِالضُحى","وَظِلٍّ يَقومُ العودُ فيهِ بِحينِ",10,"ن",1,0],["ويا طير يهنيك طيب الكرى","وطول العناق وفرط النعيم",11,"م",1,0],["وَيَا طَالَمَا رُمْتُ الْقَوَافِي فَأَقْبَلَتْ","سِرَاعاً فَلا أَرْوَى ذَكَرْتُ وَلا حُزْوَى",12,"و",2,0],["وَيا طولَ وَجدي عَلى أُمَّةٍ","أَساءَ الزَمانُ بِها ما أَرادا",13,"د",2,0],["وَيا طيبَ سُكرِ الحُبِّ لَولا جُنونُهُ","مَحا لَذَّةَ النَشوانِ سُخفُ المُعَربِدِ",14,"د",1,0],["ويا طِيبَ تَشْبِيبي بِطَيْبَةَ لا ثَنَى","عِنانَ لِساني عنكَ غَوْرٌ ولا نَجْدُ",15,"د",1,0],["ويا طارقَ الجيلِ الجديدِ تلفُتاً","إلى جبلٍ إجتازه طارقٌ دَرْبا",16,"ب",2,0],["ويا طالما ثُنِيَ السادِرونَ","بما اقتِيدَ من سادرٍ ما ارعوى",17,"ا",1,0],["ويا طلعةَ البِشر اذ ينجلي","ويا ضِحكةَ الفجر إذ يَبسِم",18,"م",1,0],["ويا طبيبا يداوي الناس مع علل","داء الأسى اليوم فيهم من يداويه ؟",19,"ي",2,0],["ويا طالما أحدقوا بالفتى","كما تحدق الجند بالظافر",20,"ر",1,0],["ويا طالما خلنا سرابا بقيعة","كؤس رحيق وانصرفنا نرومها",21,"م",3,0],["ويا طير حبي هل تخاف ودادتي","وتكره أن يصبو إليك أديب",22,"ب",1,0],["ويا طير حبي إن لحنا تقوله","يرد إلي العيش وهو خصيب",22,"ب",1,0],["ويا طالما عانت نقاب جمالها","عداةٌ وهم بين الأنام عداها",23,"ا",3,0],["وَيا طامِعاً في نَيلِ ما نالَ مِن عُلاً","مَتى صَدَقَ الظَنَّ الكَذوبَ مَنامُ",24,"م",1,0],["وَيا طالما قَد نزّعَت مِن رِقابِها","مَدارِعُها شَدَّ الضُحى وَفِراها",25,"ا",3,0],["ويا طالب الأيام صفواً أما ترى","ليومك ما يبيضُّ إلا ليسودَّا",26,"د",2,0],["ويا طلعةَ البدرِ إما سفرتِ","كما تسفرُ الخودُ في المجلسِ",27,"س",1,0],["ويا طيبَ أنفاسٍ على حسن مَضحكٍ","فذا المسك بل أذكى وذا الدرُّ بل أصفى",28,"ف",2,0],["ويا طالما قد عضّنا منه ناجذٌ","رمى الله أنياباً له بالقوادح",29,"ح",1,0],["ويا طرابلسَ الغربِ التي نكدت","بحكمِ رومةَ إسغاباً وإلغابا",30,"ب",2,0],["ويا طالما قبلتها والتزمتها","وقد هجعت عين الرقيب المدابر",31,"ر",1,0],["وَيا طالَما متعت بِالجيد ساعدي","وَما صَدّني اِثن وَلا عاقَني وَزر",32,"ر",1,0],["وَيا طيبَ ما تُحنَى عَلَيهِ ضَمائِري","مِنَ الوُدِّ لَو أَنَّ الَّذي تَمَّ فاتِحُ",33,"ح",1,0],["ويا طيف الأحبة لا عتاب","عليك إذا جفوت ولا ملام",34,"م",1,0],["ويا طالما شافهتكم بنصيحتي","وبحث بما تلقونه غير كاتم",35,"م",1,0],["ويا طالما وافى على حين غفلة","فأصْبَحْتُ منه خائفاً مترقبا",36,"ب",2,0],["ويا طُولَ ظِمْئِي لِخَمْسٍ وعَشْرٍ","طريدَ الحياضِ بعيدَ الإِضاءِ",37,"ا",2,0],["ويا طالما دأبت والآل سابح","فكنت سفينا فيه لما تموجا",38,"ج",2,0],["ويا طالما أدخلت والليل أليل","ومن يبتغي ما يبتغي النوم أدلجا",38,"ج",2,0],["ويا طالما رافقت في الدوريدها","وفجفجت حيث الأجدل السهم فجفجا",38,"ج",2,0],["وَيا طالباً شرح السؤال فآنه","على خَمسة قرَّبته لك مطلبا",39,"ب",2,1],["ويا طاهر الأعراض والخيم والجدا","وصافي السجايا والنديم المنادم",40,"م",1,0],["ويا طاهر الجثمان والالف والكرى","وسهد المنى والذيل والجيب والردن",41,"ن",1,0],["ويا طالما راقبتَ عَودِي كأنَّنا","عشيقانِ لم يستمرئا أيَّ فرقُة",42,"ه",1,0],["ويا طالما أسدى الى دَماثةً","ولطفا وعلما بالفرائد مُسعفى",43,"ف",2,0],["ويا طيبَ ما استعجلتُ كُتْبَ ودادِكم","لو انّي ببعدٍ لم يَرُعْنِيَ آجلُهْ",44,"ل",2,0],["ويا طرفةً في مقلةٍ ذاب لو جرى","على الخدّ خلطاً دُرّها وعقيقُها",45,"ق",3,0],["ويا طولَ غيظ الكاشحين لمرَّها","وقد جهلوا أنباءها وعرفناها",46,"ا",3,0],["ويا طَيْفَهُنًّ إذا ما هَجَعْتُ","بحقَّكَ زُرني بِلا موعدِ",47,"د",1,0],["ويا طالما كشفت عنها عظيمة","يكاد لها وجه المقطم يحطم",48,"م",1,0],["ويا طالما ثوباً لبسناه زينة","وداراً سكناه وفيه ندوس",49,"س",1,0],["وَيا طَرْفَهُ كَيْفَ السبيلُ لِمغْرَمٍ","عَلَيْكَ إلى وَصْلٍ وَسَيْفُكَ صارِمُ",50,"م",1,0],["ويا طَرفُ إن جفَّت دموعكَ فاتَّخِذ","دم القلب دمعاً فوق تربتهِ يُذرَى",51,"ر",2,0],["وَيا طالما مرّت ليالٍ بِأنسنا","عَلى رقص عيدان وَناي زنام",52,"م",1,0],["وَيا طوسن احتفل بالعلم وَاِفتَح","مَطالبه فَأَنتَ لَها أَمير",53,"ر",1,0],["وَيا طال ما أَغنى محيّاهُ عَن شَذا","رياض وَأَلوان من الراح والزهرِ",54,"ر",1,0],["ويا طالما أرغمتُ أنفَ خُطوبِه","بتربيبِ طَبٍّ بالعواقبِ ذي خُبرِ",55,"ر",1,0],["وَيا طيِّباً صيتاً على حُسنِ سؤددٍ","لِأَدناهُ وَدَّت لَو تَطولُ الفَراقِدُ",56,"د",1,0],["وَيَا طالما قيل َما أنت َوَالوَهْ","مُ أضحَك ُبلْ ما أنا وَالرِّيَاءُ",57,"ا",2,0],["ويا طالما دِنَّا بحفظ عهودهم","فلم نُلف يوماً ما وفاء ولا حفظا",58,"ظ",2,0],["ويا طالما حاربتُ حزْبَ صروفها","ألينُ إذ لانت وأسطو إذا تسطو",59,"ط",2,0],["وَيا طالَما أَعرَضتَ عَن هاتِفِ الصِّبا","وفيكَ لعِزِّ المُلكِ عنهُ نفُورُ",60,"ر",1,0],["وَيا طِيبَ صَدٍّ لِلحَبيبِ بِهِ رِضاً","وَإِن غاظَنِي مِمَّن يَلُومُ شَمَاتُهُ",61,"ت",2,0],["ويا طالب الدنيا بجمع حطامها","ستترك ما جمعت يوم تحطم",62,"م",1,0],["ويا طريدا أرى الخذلان يقعده","أما أقامتك للتوفيق عزمات",63,"ت",1,0],["ويا طول احزاني على فقد ذا الفتى","ولله من اهوال يوم التودعِ",64,"ع",1,0],["ويا طالما كنت أوليه صداً","ويا شد ما صرت أوليه ودا",65,"د",2,0],["ويا طَيْفُ أَنّى بِتُّ بِتَّ مُضاجِعي","كَأَنَّكَ ما قَدْ سارَ في الأَرْضِ مِنْ ذِكْري",66,"ر",2,0],["ويا طالما قد كنت أرجو لقاءه","فاصحت أشكو من لقاه وأهرب",67,"ب",1,0],["ويا طالما صاغ الدراري فزينت","عروس أمانيه بعقدٍ من الشهب",68,"ب",1,0],["ويا طالبَ الإصلاح صبراً على الدّجى","فإنّ فتى الإصلاح يَرضعُ في المهد",69,"د",1,0],["وياطالما شنوا الاغارة بيننا","ففزنا بما نرجوه من زائد النصر",70,"ر",1,0],["وياطيف هل زدتَ إلا جوى","فؤادي وجسميَ إلا ضَنى",71,"ا",1,0],["وياطود المعالى طبت مثوى","تهاوت عند مصرعك القلاع",72,"ع",1,0],["وَيا طالِباً طَيبَةً زائِراً","وَيا سالِكينَ بِهذا الطَريقِ",73,"ق",1,0],["ويا طيب يوم به جادلي","وداجي الهموم انمحي واضمحل",74,"ل",1,0],["ويا طالما نلت المنى والهنا بها","وبت على رغم الحسود منعما",75,"م",2,0],["وَيا طالَما كانَت رَسائلُ بَيننا","يَبرّدن ما تطوي الجَوانح مِن جَمر",76,"ر",1,0],["ويا طيب أنسى غير أن مت فيكم","وما بهجتي إلا تلافى لمهجتي",77,"ي",1,0],["ويا طول أحزان الفؤاد أقم به","ويا قلب فاضرب عن نوال الشفا صفحا",78,"ح",2,0],["ويا طالِبَ العَليا وَقد ظَفِرَت بِها","يَدٌ مِنكَ صِدقاً وَعدُها وَوَعِيدُها",79,"د",3,0],["ويا طيبَ نفس المرء والرَبع آهل","وقد كان عريانا يرنّ به الصدى",80,"د",2,0],["ويا طيبَ أيامي بِجلد عميرةٍ","فكم حَفِظَتْ عِرضي لَدَيها وفِضّتي",81,"ي",1,0],["ويا طرف كفكف في همولك بعدهم","فما في مجاري الدمع غير حشا يذري",82,"ر",2,0],["ويا طامعاً في الرشد أقصر فقد قضى ال","ذي هو هاد للبرايا ومرشد",83,"د",1,0],["ويا طلعة تابوت","على موكب أعراس",84,"س",1,0],["ويا طالبي الجود كفوا السؤال","فلم يبق بالجود من يؤثر",85,"ر",1,0],["ويا طالب البرهان في كل حجة","عليك بنيل العلم لا تتكاسل",86,"ل",1,0],["ويا طالما بؤتم بخسر وخيبة","من السعي سعي الغي والغبن والريب",87,"ب",1,0],["وَيا طالَما ظنَّ الحقيقةَ طيفَها","فَخابَت على الحالين منهُ المطامِعُ",88,"ع",1,0],["وَيا طالَما خالستُ ميَّةَ نظرةً","فَقالَت بعينيها وَقَلبيَ سامعُ",88,"ع",1,0],["ويا طالما ضر الحليم اصطباره","وجرعه الورد الذعاف مشاربه",89,"ب",2,0],["ويا طلعةَ الوجهِ البشوشِ فأسفِري","فإنّا بكِ الدهرَ العَبوسَ سنَدْفع",90,"ع",1,0],["ويَا طائراً من وَرَاءِ الغُيُوم","كَقلبي فديتُكَ من طائِرِ",91,"ر",1,0],["ويا طالما عانقت شوقاً لقدِّه","غُصيناً ليشفي وجدَ قلبي وما أشفى",92,"ف",2,0],["ويا طاعني صدر الكتائب مالكم","قعدتم وفي ايديكم قائم العضب",93,"ب",1,0],["ويا طاحني هام العدى ما انتظاركم","وقد طحنتكم في الحروب رحى الحرب",93,"ب",1,0],["ويا طائر القدس أبي وقعت","بهذي القيود وهذي الحلق",94,"ق",1,0],["ويا طالَما صدّت ولم تَثْنِ مَعطِفاً","ولذّتْ وقد جاذَبْتُها غُصُناً لَدْنا",95,"ن",2,0],["ويا طالَما جادَ لي مُنعِماً","وما بدَأ الفَضْلَ إلا أعادْ",96,"د",1,0],["وَيا طالَما مُستَيقِظينَ قضوا عَلى","حِراسَتِها الاعِوامُ وَالدَهر وَالشَهرا",97,"ر",2,0],["ويا طالبي الرشد بدر الهدى","عراه الافول فلم يطلع",98,"ع",1,0],["ويا طالما حنت إليها حشاشتي","وتاقت لأن تغدو بها ساحب البرد",99,"د",1,0],["وَيا طالَما أَفنى الجموع بِسَيفه","وَمِن حَولِهِ لِلأعوجية سور",100,"ر",1,0],["ويا طالما زاغت عتوا ومن يزغ","فليس له إلا الحسام مقوما",101,"م",2,0],["وَيا طالما سيقت إِلَيك مَواكبٌ","وَحجّت لك الآمال تقتادُها البشرى",102,"ر",2,0],["وَيا طالما زَيَّنتُ باسمك مدحةً","وَكُنتَ تَرى نَهياً وَكُنتَ تَرى أَمرا",102,"ر",2,0],["وَيا طالما طابت بِأنسي مجالسٌ","وَطافَت بِلاد اللَه فيهم قَصائدي",103,"د",2,0],["وَيا طرّةً فَوق الجَبين كَأَنَّها","عَلى جَنَّة للحسن ظلٌّ ضفا فَظَل",104,"ل",1,0],["ويا طول مبكى ناظرٍ لم يرَ الهُدى","أَضلَّ طريقاً فهو يشقى بجدِّه",105,"د",2,0],["وَيا طالما كانَت مَواردَ لذةٍ","نعاودها في كُل يَوم وَليلة",106,"ه",1,0],["وَيا طالما والت وولّت لذائذٌ","وَرعتُ المَنايا إذ قنصتُ الأَمانيا",107,"ي",2,0],["وَيا طالما أَحسنت ظَني وَلم أَقل","سَيسلبُ ما أَعطى الزَمان مراديا",10