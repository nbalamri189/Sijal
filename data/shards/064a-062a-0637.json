{"poems":[[55,"ملك الملوك نداء ذي شجن","https://www.aldiwan.net/poem29742.html","الكامل"],[24,"من سره كرم الحياة فلا يزل","https://www.aldiwan.net/poem21866.html","الكامل"],[49,"ويقول في الحاسدون تكذبا","https://www.aldiwan.net/poem25204.html","الكامل"],[74,"أشكو إليك حالة قد أوقعت","https://www.aldiwan.net/poem20509.html","الرجز"],[53,"متشبث بعلائقي متخلص","https://www.aldiwan.net/poem64932.html","الكامل"],[68,"ما للجبال الراسيات تسير","https://www.aldiwan.net/poem40122.html","الكامل"],[46,"غنى فشاقك طائر غريد","https://www.aldiwan.net/poem30528.html","الكامل"],[107,"وفت الظنون وبرت الآمال","https://www.aldiwan.net/poem42085.html","الكامل"],[107,"أقبل فتلك ديار يثرب تقبل","https://www.aldiwan.net/poem44226.html","الكامل"],[108,"سمر الأدباء","https://www.poetsgate.com/ViewPoem.aspx?id=179454",""],[190,"جيران بيتي كنت آملهم","https://www.aldiwan.net/poem43970.html","الكامل"],[226,"مولاي قد نامت عيون","https://www.aldiwan.net/poem55273.html","مجزوء الكامل"],[240,"يا صلاح الدين خذ حذ","https://www.aldiwan.net/poem31807.html","مجزوء الرمل"],[266,"أأبحت يا هذي دم المهجور","https://www.aldiwan.net/poem38277.html","الكامل"],[422,"لو كنت حاضر طرفه وفؤاده","https://www.aldiwan.net/poem54051.html","الكامل"],[463,"الآن إذ برد السلو ظمائي","https://www.aldiwan.net/poem56313.html","الكامل"],[484,"قضيا المعيشة في مضيق","https://www.aldiwan.net/poem37614.html","مجزوء الكامل"],[438,"","https://poetry.dctabudhabi.ae/diwan/poem/58919","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48728","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48782","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48774","الكامل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62500","الرمل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56616","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49973","الكامل"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/101067","الكامل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100417","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111472","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81280","الخفيف"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204299","الكامل"],[5121,"صَبَاحُ الْهَمْسِ","https://www.poetsgate.com/ViewPoem.aspx?id=214145",""],[5147,"للفوز أجهزة تداول صرفها","https://www.poetsgate.com/ViewPoem.aspx?id=166743",""],[5542,"لغة الحجارة","https://www.poetsgate.com/ViewPoem.aspx?id=10192",""],[5897,"غداً القصاص","https://www.poetsgate.com/ViewPoem.aspx?id=160569",""],[5956,"القناعة كنز لا يفنى","https://www.poetsgate.com/ViewPoem.aspx?id=192382",""],[6129,"يفدي حذاءَك باعةُ الأبقارِ","https://www.poetsgate.com/ViewPoem.aspx?id=13877",""],[831,"ذكرى جلوسك مظهرُ الأوطانِ","https://diwany.org/%D8%B0%D9%83%D8%B1%D9%89-%D8%AC%D9%84%D9%88%D8%B3%D9%83-%D9%85%D8%B8%D9%87%D8%B1%D9%8F-%D8%A7%D9%84%D8%A3%D9%88%D8%B7%D8%A7%D9%86%D9%90/","الكامل"]],"verses":[["يَتَطَلَّبونَ لِيَ العُيوبَ وَيَر","موني بِأَفرادٍ مِنَ الظِنَنِ",0,"ن",1,0],["يَتَطَّهرونَ كَأَنَّهُ نُسُكٌ لَهُم","بِدِماءِ مَن عَلِقوا مِنَ الكُفّارِ",1,"ر",1,0],["يَتَطَلَّبونَ إِساءَتي لاذِمَّتي","إِنَّ الحَسودَ بِما يَسوءُ مُوَكَّلُ",2,"ل",1,0],["يتطَّلب المال ولا يناله","لا راحة الفقر ولا عيش الغنى",3,"ن",2,0],["يتطرَّفُ اللذاتِ دوني خائفاً","مني هناك كأنه متلصِّصُ",4,"ص",1,0],["يَتَطَهَّرُ الماءُ القَراحُ بِغَسلِهِ","وَبِطيبِهِ يَتَعَطَّرُ الكافورُ",5,"ر",1,0],["يَتَطَعَّمانِ بِريقِ هَذا هَذِهِ","مَجعاً وَذاكَ بِريقِ تِلكَ مُعيدُ",6,"د",1,0],["يَتطلَّعونَ إلى الحياةِ بِأَعْيُنٍ","حَيْرَى اللّحاظِ ودونها أهوالُ",7,"ل",1,0],["يُتطلّعون إلى الفجاج وقولُهُمْ","أفما يُطالِعُنا النبيُّ المُرسَلُ",8,"ل",1,0],["يتطارحون القولَ فيما بينهم","يحكي كُئُوس الرَّاح حين تُدار",9,"ر",1,0],["يتطلبون معايبي حسدا","فهم عليّ أشدّ من أسد",10,"د",1,0],["يتطاحن الغرباء في","ساحاتها والأقربون",11,"ن",1,0],["يتطاحن الصناع","والتجار والمستخدمون",11,"ن",1,0],["يتطاحن الأخوان والآباء","فيها والبنون",11,"ن",1,0],["يتطاحنون وأنت تعرف","فيم هم يتطاحنون",11,"ن",1,0],["يَتَطَلَّعنَ إِلى رُؤ","ياهُ مِن غَيرِ اِشتِياقِ",12,"ق",1,0],["يتطاولون لطولها ولطولها","ان التطاول عغاية التقصير",13,"ر",1,0],["يتطفَّلون على موائد فضله","يتبرَّكون بمائه وبزاده",14,"د",2,0],["يتطاولون ليبلُغوك ولم يكن","ليضمَّهم وعلاك خطُّ سواءِ",15,"ا",2,0],["يتطلبان عدالة","تقضي وأين هي الحقوق",16,"ق",1,0],["يتطفّلُ الكرماءُ في أحرازِه","وعليهِ يحسُنُ منهمُ التطْفيلُ",17,"ل",1,0],["يتطلب الدستورَ أقوامٌ ولو","وليت حكم شعوب قيصر أخلدوا",18,"د",3,0],["يتطلبون الحكم وهو هوىً ولو","هوت السماء وأقفر العمران",19,"ن",1,0],["يتطلبون الثأر منك وما رعوا","معروفك الجاري مكان الثار",20,"ر",1,0],["يتطلبَّن ديوناً","من قلوب للنواظرْ",21,"ر",1,0],["يتطالعون إذا خطوا فكأنهم","يخطون في الأغلال والأصفاد",22,"د",1,0],["يتطلّبون المجدَ بين ديارهم","مأوى اللهيف ومستَزارَ المعسرِ",23,"ر",1,0],["يتطلعون إذا هفت","بيض الغمام بهم وجونه",24,"ن",2,0],["يتطلعون على الملاعب غزلةً","غناء تمرح في ظلال البان",25,"ن",1,0],["يَتَطَلَّبنَ زَلَّةً مِنهُ تُهمِي","فَوقَ ذَاكَ العاتي وَبالاً أَمَرَّا",26,"ا",1,0],["يتطرى بِهِ الفُؤاد وَيَندى","كُلُ حس وَيَرتَوي كُلُ خاطر",27,"ر",1,0],["يتطرق الأستار لا عن نيةٍ","ولو استطاع لها الصيانة صانا",28,"ن",2,0],["يَتَطَرَّى مَعَ الصَّبَاحِ شُعُورٌ","مِثْلَ نَحْلٍ يَمْتَصُّ رُوحَ الدِّبْسِ",29,"س",1,0],["يتطاولون بها ومن هو قاصر","عنها تقاصر عن حدود منالها",30,"ل",3,0],["يتطلع الاقصى اليّ وحوله","عين تراقبه وسمع مرهف",31,"ف",1,0],["يتطاولون على العلي وعنده","تعنو الوجوه وتنطق الأوصالُ",32,"ل",1,0],["يتطلبان وظيفتين تُريهما","كيف الرفاهة والصراط العالي",33,"ل",2,0],["يتطهّر الطُهرُ البريء بطهرهِ","والمجدُ يلبسُ منه تاج فخارِ",34,"ر",1,0],["يتطلعون إلى بني العمران","قد كفَّروا آثامهم بدمائهم",35,"م",1,0]]}