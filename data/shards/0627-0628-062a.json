.com/ViewPoem.aspx?id=21997",""],[51,"يا أبا الصقرِ زادكَ اللَّه في ال","https://www.poetsgate.com/ViewPoem.aspx?id=29584",""],[32,"أبت مقلتي كتمان ما بي","https://www.poetsgate.com/ViewPoem.aspx?id=116",""],[103,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""]],"verses":[["أَبَت هِمَمي تَسيغُ الماءَ صَفواً","إِذا ما الذُلُّ حامَ عَلى الزُلالِ",0,"ل",1,0],["أَبتَغي عَدلَ زَمانٍ قاسِطٍ","إِنَّما الناسُ عَلى دينِ المَلِك",1,"ك",1,0],["أَبَت لِقحَةُ الدُنيا دُروراً لِعاصِبٍ","وَيَحلُبُها مَن لا يُعاني عِصابَها",2,"ب",3,0],["أَبَت لي صَبوَتي إِلّا اِلتِفاتاً","إِلى الدَمَنِ البَوائِدِ وَاِنثِناءَ",3,"ا",2,0],["أبَتْ إبِلي والليلُ وَحْف الغَدائِرِ","رَشيفَ صَرىً في مُنْحَنى الوِرْدِ غائِرِ",4,"ر",1,1],["أَبَتْ غَيْرَ مَحْضِ الْعِزِّ نَفْسِي فَلَيْسَ لِي","بِسَاحَةِ ضَيْمٍ مَا حيِيتُ نُزُولُ",5,"ل",1,0],["أَبَت نَفسي لَهُ إِلّا وِصالاً","وَتَأبى نَفسُهُ إِلّا اِنقِطاعا",6,"ع",2,0],["أَبَت أَعناقُهُم عِزّاً","فَما يُعطونَ مَن غَشَما",7,"م",2,0],["أَبَت ذِكرَةٌ مِن حُبِّ لَيلى تَعودُني","عِيادَ أَخي الحُمّى إِذا قُلتُ أَقصَرا",8,"ر",2,1],["أَبَت سُنَّةُ العُمرانِ إِلّا تَناحُراً","وَكَدحاً وَلَو أَنَّ البَقاءَ يَسيرُ",9,"ر",1,0],["أَبَت أُمَيَّةُ أَن تَفنى مَحامِدُها","عَلى المَدى وَأَبى أَبناءُ غَسّانِ",10,"ن",1,0],["أَبَت أَجَأٌ أَن تُسلِمَ العامَ جارَه","فَمَن شاءَ فَليَنهَض لَها مِن مُقاتِلِ",11,"ل",1,0],["أَبَت وَأَبى وَجدي بِعَزَّةَ إِذ نَأَت","عَلى عُدواءِ الدارِ أَن يَتَصَّرَما",12,"م",2,0],["أَبَت إِيلي مَاءَ الرَداهِ وَشَفَّها","بَنو العَمَّ يَحمونَ النَضيحَ المُبَرَّدا",13,"د",2,1],["أبٌ تَوَلَّى وَإِخْوَةٌ دَرَجُوا","لَوْ شَفَّعَ المَجْدُ فِيهِمْ سَلِّمُوا",14,"م",3,0],["أَبْتَغِي فِيهِ مِنْ مُصَابٍ","لَمْ يُلَطِّفْهُ عَهْدُهُ المُتَقَادِمْ",15,"م",1,0],["أَبَت بالشَّامِ نَفسِي أَن تَطيبَا","تَذَكَّرَت المنَازِلَ والحَبيبَا",16,"ب",2,1],["أَبَت بَعدَ هَيجِ الأَرضِ إِلّا تَعَلُّقاً","بِعَهدِ الثَرى حَتّى طَواها ذُبولُها",17,"ل",3,0],["أَبَت ذِكَرٌ عَوَّدنَ أَحشاءَ قَلبِهِ","خُفوقاً وَرَفضاتُ الهَوى في المَفاصِلِ",18,"ل",1,0],["أَبَت عَزلاءُ كُلِّ نَشاصِ نَجمٍ","عَلى آثارِها إِلّا اِنحِلالا",19,"ل",2,0],["أَبَت إِبِلي أَن تَعرِفَ الضَيمَ نِيبُها","إِذا اِجتِنبَ لِلحَربِ العَوانِ السَنَوَّرُ",20,"ر",1,0],["أبت الجزيرة أن يفوق هزارها","صرد زقى في مصر زَقيَ غرابها",21,"ب",3,0],["أبَتِ السياسة أن تدوم حكومة","خُصَّت برأي مُقَّدس لم يُسأل",22,"ل",1,0],["أبت حركات الكون إلا تَبايناً","دوافعه فَعّالة وجواذبه",23,"ب",2,0],["أَبَت عَيناكَ بِالحَسَنِ الرُقادا","وَأَنكَرتَ الأَصادِقَ وَالبِلادا",24,"د",2,1],["أَبَت لِيَ ذاكُم أُسرَةٌ ثُعَلِيَّةٌ","كَريمٌ غِناها مُستَعِفٌّ فَقيرُها",25,"ر",3,0],["أَبَت لي هِمَّتي وَغِرارُ سَيفي","وَعَزمي وَالمَطِيَّةُ وَالقِفارُ",26,"ر",1,0],["أَبَت عَبَراتُهُ إِلّا اِنسِكابا","وَنارُ غَرامِهِ إِلّا اِلتِهابا",27,"ب",2,1],["أبت لي دموعِي أن أماكس في الهوى","فحسنك يشريها وجفني يبيعها",28,"ع",3,0],["أبت أعجازُها بمقدَّماتٍ","لها إلا مطاوعةَ الجنُوبِ",29,"ب",1,0],["أبَتْ لي قبولَ الخسف نفسٌ أبيَّةٌ","تبيعُ بعزِّ الموتِ ذلَّ حياتِها",30,"ت",3,0],["أبتْ آثارُ دهرك أن تُعَفَّى","بكفِّك شئتَ ذلك أم أبَيْتا",31,"ت",2,0],["أبت لابن حماد مساعيه أن يُرى","إذا ابتدر الساعون غيرَ مبادر",32,"ر",1,0],["أبت نفسي الهُلاع لرزء شيءٍ","كفى شجواً لنفسي رزءُ نفسي",33,"س",2,0],["أبت نفسك المعروف حتى تبتلت","إلى اليأس نفس واطمأن مروعها",34,"ع",3,0],["أبت شجرات أن تطيب ثمارها","وقد خبثت أعراقها وفروعها",34,"ع",3,0],["أبت ذكر حزوى منكمُ واشتياقكم","إليها قلوب ذكرُ جُوخَى يَضوعها",34,"ع",3,0],["أبت الجمع منك روحاء من كف","فَيك تزداد ما حييت اتساعا",35,"ع",2,0],["أبتْ لك تخييبَ المرجِّين شيمةٌ","تَذِرُّ إذا ضنَّ البخيل وترأمُ",36,"م",1,0],["أَبَت أَن تَرُدَّ النَفسَ في مُستَقَرِّها","وَما وَصَلَت حَبلَ اِمرِئٍ كانَ واصِلا",37,"ل",2,0],["أَبَت نَفسُها أَن يَكحَلَ النَومُ جَفنَها","وَجَفنُ المُعَنّى بِالسُهادِ كَحيلُ",38,"ل",1,0],["أَبتَ أَن تَعرِفَ الشَكوى","مِنَ التَرحالِ وَالحِلِّ",39,"ل",1,0],["أَبَت إِلّا السُكوتَ وَبِتُّ أَشكو","وَأَنّى يَصحَبُ الوَجدَ اِكتِتامُ",40,"م",1,0],["أَبَت إِلّا عِنادُهُم اللَيالي","فَما يَإِسوا الغَداةَ وَلا اِستَناموا",40,"م",3,0],["أَبتَغي أَن أَقوَلَ شَيئاً فَيَعصا","ني لِسانِيَ وَالسِحرُ تَحتَ لِساني",41,"ي",1,0],["أَبَت آياتُ حُبَّى أَن تَبينا","لَنا خَبَراً فَأَبكَينَ الحَزينا",42,"ن",2,1],["ابتغى في جوار رمسك رمساً","حبذا في جوار رمسك رمسي",43,"ي",1,0],["اِبتَغوا ناصِيَةَ الشَمسِ مَكانا","وَخُذوا القِمَّةَ عَلَماً وَبَيانا",44,"ن",2,1],["أَبَتِ التَقَيُّدَ بِالهَوى وَتَقَيَّدَت","بِالحَقِّ أَو بِالواجِبِ الأَحرارُ",45,"ر",1,0],["آبَت مِنَ السَفَرِ البَعيدِ جُنودُهُ","وَأَتَتهُ بِالفَتحِ السَعيدِ الفَيلَقُ",46,"ق",1,0],["آبَت ثَكالى أَيامى بَعدَ ما أَخَذَت","مِن حَولِهِنَّ النَوى وَالأَينُقُ الرَسُمُ",47,"م",1,0],["أَبَت لَكَ ذَمّي نَخوَةٌ يَمَنِيَّةٌ","وَنَفسٌ بِها في مَأزِقٍ أَبَداً تَرمي",48,"ي",1,0],["أَبَت لَكَ أَن تَأبى المَكارِمَ أُسرَةٌ","أَبوها عَنِ الفِعلِ الدَنِيِّ يَذودُها",49,"د",3,0],["أَبَت أَن تُبَقّي رَغبَةً عِندَ صاحِبي","لَيالٍ يُريني الدَهرُ بَعدَ لَيالِ",50,"ل",1,0],["أَبَت لَكُم أَن تَنالوا فَضلَ مَكرُمَةٍ","لِحى التُيوسِ وَأَعطافُ البَراذينِ",51,"ن",1,0],["أَبَت لِبِلالٌ عُصبَةٌ أَشعَرِيَّةٌ","إِذا فَزِعَت كانَت سَريعاً رُكوبُها",52,"ب",3,0],["أَبَت مُضَرُ الحَمراءُ إِلّا تَكَرُّماً","عَلى الناسِ يَعلو كُلَّ جَدٍّ جُدودُها",53,"د",3,0],["أَبَت مُقلَتا عَينَيَّ وَالصاحِبُ الَّذي","عَصى الظَنَّ مُذ كُنتُ الغُلامَ الحَزَوَّرا",54,"ر",2,0],["أَبَت ناقَتي إِلّا زِياداً وَرَغبَتي","وَما الجودُ مِن أَخلاقِهِ بِبَديعِ",55,"ع",1,0],["أَبَت يَدُهُ إِلّا اِنبِساطاً بِمالِها","إِذا ما يَدٌ كانَت عَلى مالِها قُفلا",56,"ل",2,0],["أَبَتِ المَوالي أَن تَكونَ صَميمَها","وَنَفَتكَ عَن أَحسابِها مَخزومُ",57,"م",1,0],["أَبَت لِهِشامٍ عادَةٌ يَستَعيدُها","وَكَفُّ جَوادٍ لا يُسَدُّ اِنثِلامُها",58,"م",3,0],["أَبَت لِبَني سَعدٍ جِبالٌ رَسَت بِهِم","شَوامِخُها لا تُرتَقى بِالسَلالِمِ",59,"م",1,0],["أَبَت خِندِفٌ إِلّا عُلُوّاً وَقَيسُها","إِذا فَخَرَ الأَقوامُ غَيرَ نُجومِ",60,"م",1,0],["أَبَت عامِرٌ أَن يَأخُذوا بِأَسيرِهِم","مِئينَ مِنَ الأَسرى لَهُم عِندَ دارِمِ",61,"م",1,0],["أَبَتِ الرَّكائِبُ أن تَعُنَّ وقد دَعَتْ","قلباً تأبَّى ثم أَصحَبَ طائِعا",62,"ع",2,0],["أَبَت ذِكَرٌ مِن حُبِّ لَيلى تَعودُني","عِيادَ أَخي الحُمّى إِذا قُلتُ أَقصَرا",63,"ر",2,1],["أَبَت طَرَفاتُ كُلِّ قَريرِ عَينٍ","بِها إِلّا اِضطِراباً وَاِنقِلابا",64,"ب",2,0],["أَبَتِ الدُنيا عَلى كُلِّ حَيٍّ","آخِرَ الأَيّامِ إِلّا ذَهابا",65,"ب",2,0],["أَبَتِ الدُنيا عَلى سُكّانِها","في البِلى وَالنَقصِ إِلّا ما أَتَت",66,"ت",1,0],["أَبَتِ الساعاتُ إِلّا سُرعَةً","في بِلى جِسمي بِلَيلٍ وَنَهار",67,"ر",1,0],["أَبَتِ الأَجداثُ أَلّا يَزوروا","ما ثَوَوا فيها وَأَن لا يُزاروا",68,"ر",3,0],["اِبتَنى الناسُ مِنَ البُن","يانِ ما لَم يَسكُنوهُ",69,"و",2,0],["أَبَتِ الوِصالَ مَخافَةَ الرُقَباءِ","وَأَتَتكَ تَحتَ مَدارِعِ الظُلَماءِ",70,"ا",2,1],["آبَت إِلى جَسَدي لِتَنظُرَ ما اِنتَهَت","مِن بَعدِها فيهِ يَدُ البُرَحاءِ",70,"ا",2,0],["أَبَت هِمَّتي لي أَن أَذُلَّ لَنا كِثٍ","عَرى العَهدِ أَو أَرضى مِن الوِرد بِالبَرضِ",71,"ض",1,0],["أبتغي عندك التأسي وما تملكُ","ردَّا ولا تجيبُ نداءَ",72,"ا",2,0],["أبَتّها في حشاك مُغْرَقَةً","وبتُّ في ساحليك أبكيها",73,"ي",3,0],["أَبَتِ البَخيلَةُ أَن تَنولَني","فَأَظُنُّ أَنّي زائِرٌ رَمسي",74,"س",2,1],["أَبتِ الرَوادِفُ وَالثُدِيُّ لِقُمصِها","مَسَّ البُطونِ وَأَن تَمَسَّ ظُهورا",75,"ر",2,1],["أَبَت لَيلَةٌ بِالغَيلِ يا أُمَّ مالِكٍ","لَكُم غَيرَ حُبٍّ صادِقٍ لَيسَ يَكذِبُ",76,"ب",1,1],["أَبَتِ القُعودَ مع الخوالفِ بعدما","أَخذَ اللّواءَ القائدُ الميمونُ",77,"ن",1,0],["أبَتِ الأرضُ فكنتم شَعَثاً","طائراً في كل وادٍ ما يُلَمّْ",78,"م",1,0],["أَبَت وَأَبَيتَ فَاِقتَحَمَتكَ غَضبى","وَكانَ فِرارُكَ النَصرَ المُبينا",79,"ن",2,0],["أَبَت أُمَّةُ اليُونانِ أَن تسكنَ الظُبى","فَهبَّ الرَدى فيها تَلظّى مَضارِبُهْ",80,"ب",2,0],["أبتْ شمسُ الهدى إلا طُلوعا","ففاضَ شُعاعُها يغشى الرُّبوعا",81,"ع",2,0],["ابتدر يا سعدُ فالزّادُ نَفَدْ","واصطناعُ الخيْرِ أشهى ما تَودّ",82,"د",1,0],["أَبُتي إِنَّني جَزَيتُكَ بِالَّلهِ تَقيّاً","بِهِ عَلى كُلِ حالِ",83,"ل",1,0],["أَبَت شَفَتايَ اليَومَ إِلّا تَكَلُّماً","بِشَرٍّ فَما أَدري لِمَن أَنا قائِلُه",84,"ه",1,1],["ابْتَسَمَتْ عَنْ مِثْلِ كَأْسِ الحُمَيَّا","نَظَمَ الماءُ عليها حُبابا",85,"ب",2,0],["أَبَتْ النَّفْسُ أَنْ تُطِيعَ وقالَتْ","إنَّ حُبِّي لا يَدْخُلُ القِنِّينَهْ",86,"ن",2,0],["أبَتْ لي سبيلَ القوم في الشعر هِمّةٌ","طَمُوحٌ ونفْسٌ للدنِيَّة فارك",87,"ك",1,0],["أَبَت لَكَ يا عَبّاسُ نَفسٌ سَخِيَّةٌ","بِزِبرِجَ دُنيانا وَعَتقِ نَجارِ",88,"ر",1,0],["أَبَت عَينايَ بَعدَكِ أَن تَناما","وَكَيفَ يَنامُ مَن ضَمِنَ السُقاما",89,"م",2,1],["أَبتَدِعُ الكَسبَ لِلمَعاني","بِأَوجُهٍ عَفَّةٍ حِسانِ",90,"ن",1,0],["أَبتَغي سَلمى وَأَخشى","نَظَرَ الرائي المُريبِ",91,"ب",1,0],["أَبَت فاقِداتُ الحِسِّ حَملَ رَزِيَّةٍ","وَهَل رابَ صَخّراً نَحتُهُ بَقَدومِ",92,"م",1,0],["ابْتَعتُ بالدَّينِ والدُّنيا مَودَّتَهُ","فَخانَني فَعَلى مَن يَرجِعُ الدَّرَكُ",93,"ك",1,0],["أَبَتْ وأَبَوْا فما تألو استعارا","ولا تُحْصَى وإن عُدَّت مِرارا",94,"ر",2,0],["أَبتِ المُضِيَّ ولم يكن ليعوقها","لو شاءَ ربُّكَ مَبركٌ أو مجثَمُ",95,"م",1,0],["أَبت أن تراها كل يوم جميلة","وَدلبر تبلى في التراب وَتدثر",96,"ر",1,0],["أَبَت نفس حر أَن تذل لضائِمٍ","وأَحرِ بها أَن لا تذل له أَحرِ",97,"ر",1,0],["أبَتْ أن تَمَسَّاهُ بالراحتينِ","ويرضى الهوى ويريدُ الجمالْ",98,"ل",1,0],["أبت صنفا النواعب من نياقٍ","وطيرٍ أن نقيم وأن نقيلا",99,"ل",2,0],["آبت به سيناء والإسراء","الوهم يبعد في الظنون ويقرب",100,"ب",1,0],["أَبَتْ لِيَ حَمْلَ الضَّيْمِ نَفْسٌ أَبِيَّةٌ","وقَلْبٌ إِذَا سِيمَ الأَذَى شَبَّ وَقْدُهُ",101,"د",2,0],["أَبِتِلْكَ الحَيَاةِ وَالعَجَبِ المَا","لِيءِ أَقْسَامَهَا يُحيطُ كَلامُ",102,"م",1,0],["أَبَتِ السلاَمَةُ أَنْ تُعِيذَكَ بِاسْمِهَا","أَجَلُ الفَتَى لاَ يَقبَلُ التَّأْجِيَلا",103,"ل",2,0],["أَبَتِ الصَّبَابَةُ مَوْرِداً","إِلاَّ شؤُونَك وَهِيَ شكْرَى",104,"ر",2,1],["أَبْتغِي البَثَّ وَالشَّجَا غضَّ مِنْ صَوْ","تِي وَحَرُّ الأَسَى أَجَفَّ مِدَادِي",105,"د",2,0],["آبَتْ إِلَى اللهِ الْكَرِيمِ مُقِلَّةٌ","حُسْنَ الطَّوِيَّةِ وَالْفِعَالَ الطَّيِّبَا",106,"ب",2,0],["آبَتْ وَتَعْلَمُ مِنْ وَفَائِكَ أَنَّهُ","لاَ يَكْرَهُ الحُسْنَى لَهَا مُتَأَوَّبَا",106,"ب",2,0],["أَبْتَغِي وَحْشَةَ الأَنِيسِ وَمَا","أُنْكِرُ الْقَفْرَ آنَسَ الْوَحْشَا",107,"ش",2,0],["أَبَت إِلّا لجاجاً في ال","بُكا فَدُموعُها لَجَجُ",108,"ج",1,0],["أَبَت أَجَأٌ أَن تُسلِمَ العامَ جارَها","فَمَن شاءَ فَليَنهَض لَها مِن مُقاتِلِ",109,"ل",1,0],["أبتْ لك أنْ تكنى بحسنٍ مُصغَّرٍ","محاسنُ ما مقدارُها بصغير",110,"ر",1,0],["ابتنوا للعُلا وللنيلِ مجداً","واسكُبوا من حياتكم في حياتهْ",111,"ت",2,0],["أَبَتْ عَلَى الدَّهْرِ ليناً","سِيّانِ عُسْرٌ وَيُسْر",112,"ر",1,0],["أَبَتِ الضَّيْمَ فمَا مَدَّتْ يَداً","لذَوي النُّعْمَى وَلمْ تَغْفِر جِباهَا",113,"ا",3,0],["أبتِ الرواسمَ، واستقَلَّتْ مَركبا","بالكهرباءِ وبالبخار مُسَيَّرَا",114,"ر",2,0],["أبَتِ الدّنْيَا على سُكّانِها،","في البِلى والنّقصِ، إلاّ ما أبَتْ",115,"ت",1,0],["أَبَتْ عَيْنَايَ بَعْدَكَ أَنْ تَكُفَّا","كَأَنَّ غَضَا الْقَتَادِ لَهَا شِفَارُ",116,"ر",1,0],["أبت تمسّاه بالرّاحتين","ويرضى الهوى ، ويريد الجمال !",117,"ل",1,0],["أبَتْ ليَ ذاكُمْ أُسرَة ٌ ثُعْلِيّة ٌ","كريم غناها، مستعفف فقيرها",118,"ر",3,0],["أبَتِ القوارِعُ أن تُميلَ طريقَها","عني فعدت لسِنِّيَ المقروع",119,"ع",1,0],["أبت سَورةُ الأعراب إلا وقيعةً","بها انتكَصَ الإسلام رَجْعاً إلى الوَرَا",120,"ر",2,0],["أبت الجوانح أن تقر ، فمن يطق","ملكا فلست بمالك لضلوعي",121,"ع",2,0],["أَبَتْ أَن تُبَقِّي رَغْبةً عِتْدَ صَاحِبي","لَيالٍ يُريني الدَّهْرُ بَعْدَ لَيَالِ",122,"ل",1,0],["أبَتْ لكَ أنْ تَأبَى المَكارِمَ أُسرَةٌ،","أبُوها عَنِ الفِعلِ الديني يَذُودُهَا",123,"د",3,0],["أبَتْ إبلي مَاءَ الرِّداهِ وَشَفَّها","بنوا العمِّ يحمونَ النّضيحَ المبرَّدا",124,"د",2,1],["أبتِ الجمعَ منك روحاءُ من","كفيك تزداد ما حييتَ اتساعا",125,"ع",2,0],["أبت مقلتي كتمان ما بي وبيّنت","مكان الذي أخفي وفاض المدامع",126,"ع",1,1],["أبتاه ماذا قد يخطُّ بناني","والحبلُ والجلادُ ينتظراني",127,"ن",2,1],["أَبَتاهُ إِنْ طَلَعَ الصَّباحُ عَلَى الدُّنى","وَأَضاءَ نُورُ الشَّمْسِ كُلَّ مَكانِ",127,"ن",1,0]]}