لى بين وقط فضلفع","https://www.aldiwan.net/poem1699.html","الطويل"],[364,"من كان فوق سراة المجد معتليا","https://www.aldiwan.net/poem60558.html","البسيط"],[364,"أعزيز بغداد أعد نظرا لنا","https://www.aldiwan.net/poem60811.html","الكامل"],[364,"البحر أجمع لو غدا أنقاسي","https://www.aldiwan.net/poem60869.html","الكامل"],[364,"من حكم طرفي إذ يكون مريبا","https://www.aldiwan.net/poem60989.html","الكامل"],[366,"لين القدود وتضريج الخدود وتف","https://www.aldiwan.net/poem16933.html","البسيط"],[366,"أيا نازحا أفنى نواظرنا نزحا","https://www.aldiwan.net/poem17168.html","الطويل"],[366,"تدب دبيب النار والهم فحمها","https://www.aldiwan.net/poem17727.html","الطويل"],[371,"سل من أقام من استقلا","https://www.aldiwan.net/poem57228.html","مجزوء الكامل"],[371,"جفن على شوك القتادة يطبق","https://www.aldiwan.net/poem57276.html","الطويل"],[377,"أوائل السهد أقصى لذة الوسن","https://www.aldiwan.net/poem59234.html","البسيط"],[400,"ابتهل","https://www.aldiwan.net/poem6733.html","عموديه"],[406,"أبت لحظات عزمك أن تناما","https://www.aldiwan.net/poem50108.html","الوافر"],[416,"كم قد ألين لمن قسا بصدوده","https://www.aldiwan.net/poem53923.html","الكامل"],[416,"أنيخاها فقد بلغت مناها","https://www.aldiwan.net/poem54083.html","الوافر"],[416,"هل عرفت الديار من آل نعمى","https://www.aldiwan.net/poem54169.html","الخفيف"],[424,"نعم الورى بسوابغ النعماء","https://www.aldiwan.net/poem26461.html","الكامل"],[432,"طرحنا فوق غاربها الزمانا","https://www.aldiwan.net/poem12375.html","الوافر"],[432,"راح يوافي طراده طرده","https://www.aldiwan.net/poem12432.html","المنسرح"],[432,"نسخ الجد مقال اللعب","https://www.aldiwan.net/poem12556.html","الرمل"],[432,"طلعت ربيعا من ربيع وأربع","https://www.aldiwan.net/poem12659.html","الطويل"],[432,"يا برق سق حيا السحاب الأبرقا","https://www.aldiwan.net/poem12682.html","الكامل"],[432,"لولا ظبى تنسل من لحظاته","https://www.aldiwan.net/poem12779.html","الكامل"],[439,"هل تثنين غروب دمع ساكب","https://www.aldiwan.net/poem34884.html","الكامل"],[453,"كم زعيم مسخر شرفه","https://www.aldiwan.net/poem61355.html","الخفيف"],[458,"ما المجد إلا بالعزيمة فاعزِمِ","https://www.aldiwan.net/poem55904.html","الكامل"],[458,"قضى دين سعدى طيفها المتأوب","https://www.aldiwan.net/poem56292.html","الطويل"],[461,"أود ولي من شيمة المجد عاصم","https://www.aldiwan.net/poem15146.html","الطويل"],[461,"سل الحي عني هل أناخت خسيفة","https://www.aldiwan.net/poem15293.html","الطويل"],[461,"على مهل يا ابن الحسين فانما","https://www.aldiwan.net/poem15464.html","الطويل"],[464,"ما للخيال جفا وقد بعد المدى","https://www.aldiwan.net/poem3191.html","عموديه"],[464,"مضى صاحب الصدر الذي حازه الصدر","https://www.aldiwan.net/poem3394.html","عموديه"],[464,"سقيت حياً جفني يا بانة الحمى","https://www.aldiwan.net/poem3501.html","عموديه"],[479,"أبت الوداع فبكرت برحيل","https://www.aldiwan.net/poem36916.html","الكامل"],[479,"الله أكبر في ضريح واحد","https://www.aldiwan.net/poem37048.html","الكامل"],[479,"أبتي كيف غالك الموت غدرا","https://www.aldiwan.net/poem37049.html","الخفيف"],[479,"روضا غرسته في الحياة نضيرا","https://www.aldiwan.net/poem37591.html","الكامل"],[505,"إلهٌ من نباح","https://www.aldiwan.net/poem42459.html","مخلع البسيط"],[513,"أبت غلبات الشوق ألا تقربا","https://www.aldiwan.net/poem67785.html","الطويل"],[515,"تبسم في ليل الشباب مشيب","https://www.aldiwan.net/poem12010.html","الطويل"],[515,"في مثل ذا الموقف المشهود تحتلب","https://www.aldiwan.net/poem12012.html","البسيط"],[516,"حلفت بمن حجت قريش لبيته","https://www.aldiwan.net/poem48704.html","الطويل"],[538,"إبتسم فالحياة تبدي ابتساما","https://www.aldiwan.net/poem47943.html","عموديه"],[551,"أبت زفرات الحب إلا تصعدا","https://www.aldiwan.net/poem47866.html","الطويل"],[551,"أما سمعت حمام الأيك إذ صدحا","https://www.aldiwan.net/poem47895.html","البسيط"],[553,"وساحرة العينين ما تحسن السحرا","https://www.aldiwan.net/poem68429.html","الطويل"],[573,"أجيرة بيتي ما لكم بكم السهو","https://www.aldiwan.net/poem3636.html","الطويل"],[586,"ملامك لا ربط لديه ولا حل","https://www.aldiwan.net/poem17642.html","الطويل"]],"verses":[["أَبَت هِمَمي تَسيغُ الماءَ صَفواً","إِذا ما الذُلُّ حامَ عَلى الزُلالِ",0,"ل",1,0],["أَبتَغي عَدلَ زَمانٍ قاسِطٍ","إِنَّما الناسُ عَلى دينِ المَلِك",1,"ك",1,0],["أَبَت لِقحَةُ الدُنيا دُروراً لِعاصِبٍ","وَيَحلُبُها مَن لا يُعاني عِصابَها",2,"ب",3,0],["أَبَت لي صَبوَتي إِلّا اِلتِفاتاً","إِلى الدَمَنِ البَوائِدِ وَاِنثِناءَ",3,"ا",2,0],["أبَتْ إبِلي والليلُ وَحْف الغَدائِرِ","رَشيفَ صَرىً في مُنْحَنى الوِرْدِ غائِرِ",4,"ر",1,1],["أَبَتْ غَيْرَ مَحْضِ الْعِزِّ نَفْسِي فَلَيْسَ لِي","بِسَاحَةِ ضَيْمٍ مَا حيِيتُ نُزُولُ",5,"ل",1,0],["أَبَت نَفسي لَهُ إِلّا وِصالاً","وَتَأبى نَفسُهُ إِلّا اِنقِطاعا",6,"ع",2,0],["أَبَت أَعناقُهُم عِزّاً","فَما يُعطونَ مَن غَشَما",7,"م",2,0],["أَبَت ذِكرَةٌ مِن حُبِّ لَيلى تَعودُني","عِيادَ أَخي الحُمّى إِذا قُلتُ أَقصَرا",8,"ر",2,1],["أَبَت سُنَّةُ العُمرانِ إِلّا تَناحُراً","وَكَدحاً وَلَو أَنَّ البَقاءَ يَسيرُ",9,"ر",1,0],["أَبَت أُمَيَّةُ أَن تَفنى مَحامِدُها","عَلى المَدى وَأَبى أَبناءُ غَسّانِ",10,"ن",1,0],["أَبَت أَجَأٌ أَن تُسلِمَ العامَ جارَه","فَمَن شاءَ فَليَنهَض لَها مِن مُقاتِلِ",11,"ل",1,0],["أَبَت وَأَبى وَجدي بِعَزَّةَ إِذ نَأَت","عَلى عُدواءِ الدارِ أَن يَتَصَّرَما",12,"م",2,0],["أَبَت إِيلي مَاءَ الرَداهِ وَشَفَّها","بَنو العَمَّ يَحمونَ النَضيحَ المُبَرَّدا",13,"د",2,1],["أبٌ تَوَلَّى وَإِخْوَةٌ دَرَجُوا","لَوْ شَفَّعَ المَجْدُ فِيهِمْ سَلِّمُوا",14,"م",3,0],["أَبْتَغِي فِيهِ مِنْ مُصَابٍ","لَمْ يُلَطِّفْهُ عَهْدُهُ المُتَقَادِمْ",15,"م",1,0],["أَبَت بالشَّامِ نَفسِي أَن تَطيبَا","تَذَكَّرَت المنَازِلَ والحَبيبَا",16,"ب",2,1],["أَبَت بَعدَ هَيجِ الأَرضِ إِلّا تَعَلُّقاً","بِعَهدِ الثَرى حَتّى طَواها ذُبولُها",17,"ل",3,0],["أَبَت ذِكَرٌ عَوَّدنَ أَحشاءَ قَلبِهِ","خُفوقاً وَرَفضاتُ الهَوى في المَفاصِلِ",18,"ل",1,0],["أَبَت عَزلاءُ كُلِّ نَشاصِ نَجمٍ","عَلى آثارِها إِلّا اِنحِلالا",19,"ل",2,0],["أَبَت إِبِلي أَن تَعرِفَ الضَيمَ نِيبُها","إِذا اِجتِنبَ لِلحَربِ العَوانِ السَنَوَّرُ",20,"ر",1,0],["أبت الجزيرة أن يفوق هزارها","صرد زقى في مصر زَقيَ غرابها",21,"ب",3,0],["أبَتِ السياسة أن تدوم حكومة","خُصَّت برأي مُقَّدس لم يُسأل",22,"ل",1,0],["أبت حركات الكون إلا تَبايناً","دوافعه فَعّالة وجواذبه",23,"ب",2,0],["أَبَت عَيناكَ بِالحَسَنِ الرُقادا","وَأَنكَرتَ الأَصادِقَ وَالبِلادا",24,"د",2,1],["أَبَت لِيَ ذاكُم أُسرَةٌ ثُعَلِيَّةٌ","كَريمٌ غِناها مُستَعِفٌّ فَقيرُها",25,"ر",3,0],["أَبَت لي هِمَّتي وَغِرارُ سَيفي","وَعَزمي وَالمَطِيَّةُ وَالقِفارُ",26,"ر",1,0],["أَبَت عَبَراتُهُ إِلّا اِنسِكابا","وَنارُ غَرامِهِ إِلّا اِلتِهابا",27,"ب",2,1],["أبت لي دموعِي أن أماكس في الهوى","فحسنك يشريها وجفني يبيعها",28,"ع",3,0],["أبت أعجازُها بمقدَّماتٍ","لها إلا مطاوعةَ الجنُوبِ",29,"ب",1,0],["أبَتْ لي قبولَ الخسف نفسٌ أبيَّةٌ","تبيعُ بعزِّ الموتِ ذلَّ حياتِها",30,"ت",3,0],["أبتْ آثارُ دهرك أن تُعَفَّى","بكفِّك شئتَ ذلك أم أبَيْتا",31,"ت",2,0],["أبت لابن حماد مساعيه أن يُرى","إذا ابتدر الساعون غيرَ مبادر",32,"ر",1,0],["أبت نفسي الهُلاع لرزء شيءٍ","كفى شجواً لنفسي رزءُ نفسي",33,"س",2,0],["أبت نفسك المعروف حتى تبتلت","إلى اليأس نفس واطمأن مروعها",34,"ع",3,0],["أبت شجرات أن تطيب ثمارها","وقد خبثت أعراقها وفروعها",34,"ع",3,0],["أبت ذكر حزوى منكمُ واشتياقكم","إليها قلوب ذكرُ جُوخَى يَضوعها",34,"ع",3,0],["أبت الجمع منك روحاء من كف","فَيك تزداد ما حييت اتساعا",35,"ع",2,0],["أبتْ لك تخييبَ المرجِّين شيمةٌ","تَذِرُّ إذا ضنَّ البخيل وترأمُ",36,"م",1,0],["أَبَت أَن تَرُدَّ النَفسَ في مُستَقَرِّها","وَما وَصَلَت حَبلَ اِمرِئٍ كانَ واصِلا",37,"ل",2,0],["أَبَت نَفسُها أَن يَكحَلَ النَومُ جَفنَها","وَجَفنُ المُعَنّى بِالسُهادِ كَحيلُ",38,"ل",1,0],["أَبتَ أَن تَعرِفَ الشَكوى","مِنَ التَرحالِ وَالحِلِّ",39,"ل",1,0],["أَبَت إِلّا السُكوتَ وَبِتُّ أَشكو","وَأَنّى يَصحَبُ الوَجدَ اِكتِتامُ",40,"م",1,0],["أَبَت إِلّا عِنادُهُم اللَيالي","فَما يَإِسوا الغَداةَ وَلا اِستَناموا",40,"م",3,0],["أَبتَغي أَن أَقوَلَ شَيئاً فَيَعصا","ني لِسانِيَ وَالسِحرُ تَحتَ لِساني",41,"ي",1,0],["أَبَت آياتُ حُبَّى أَن تَبينا","لَنا خَبَراً فَأَبكَينَ الحَزينا",42,"ن",2,1],["ابتغى في جوار رمسك رمساً","حبذا في جوار رمسك رمسي",43,"ي",1,0],["اِبتَغوا ناصِيَةَ الشَمسِ مَكانا","وَخُذوا القِمَّةَ عَلَماً وَبَيانا",44,"ن",2,1],["أَبَتِ التَقَيُّدَ بِالهَوى وَتَقَيَّدَت","بِالحَقِّ أَو بِالواجِبِ الأَحرارُ",45,"ر",1,0],["آبَت مِنَ السَفَرِ البَعيدِ جُنودُهُ","وَأَتَتهُ بِالفَتحِ السَعيدِ الفَيلَقُ",46,"ق",1,0],["آبَت ثَكالى أَيامى بَعدَ ما أَخَذَت","مِن حَولِهِنَّ النَوى وَالأَينُقُ الرَسُمُ",47,"م",1,0],["أَبَت لَكَ ذَمّي نَخوَةٌ يَمَنِيَّةٌ","وَنَفسٌ بِها في مَأزِقٍ أَبَداً تَرمي",48,"ي",1,0],["أَبَت لَكَ أَن تَأبى المَكارِمَ أُسرَةٌ","أَبوها عَنِ الفِعلِ الدَنِيِّ يَذودُها",49,"د",3,0],["أَبَت أَن تُبَقّي رَغبَةً عِندَ صاحِبي","لَيالٍ يُريني الدَهرُ بَعدَ لَيالِ",50,"ل",1,0],["أَبَت لَكُم أَن تَنالوا فَضلَ مَكرُمَةٍ","لِحى التُيوسِ وَأَعطافُ البَراذينِ",51,"ن",1,0],["أَبَت لِبِلالٌ عُصبَةٌ أَشعَرِيَّةٌ","إِذا فَزِعَت كانَت سَريعاً رُكوبُها",52,"ب",3,0],["أَبَت مُضَرُ الحَمراءُ إِلّا تَكَرُّماً","عَلى الناسِ يَعلو كُلَّ جَدٍّ جُدودُها",53,"د",3,0],["أَبَت مُقلَتا عَينَيَّ وَالصاحِبُ الَّذي","عَصى الظَنَّ مُذ كُنتُ الغُلامَ الحَزَوَّرا",54,"ر",2,0],["أَبَت ناقَتي إِلّا زِياداً وَرَغبَتي","وَما الجودُ مِن أَخلاقِهِ بِبَديعِ",55,"ع",1,0],["أَبَت يَدُهُ إِلّا اِنبِساطاً بِمالِها","إِذا ما يَدٌ كانَت عَلى مالِها قُفلا",56,"ل",2,0],["أَبَتِ المَوالي أَن تَكونَ صَميمَها","وَنَفَتكَ عَن أَحسابِها مَخزومُ",57,"م",1,0],["أَبَت لِهِشامٍ عادَةٌ يَستَعيدُها","وَكَفُّ جَوادٍ لا يُسَدُّ اِنثِلامُها",58,"م",3,0],["أَبَت لِبَني سَعدٍ جِبالٌ رَسَت بِهِم","شَوامِخُها لا تُرتَقى بِالسَلالِمِ",59,"م",1,0],["أَبَت خِندِفٌ إِلّا عُلُوّاً وَقَيسُها","إِذا فَخَرَ الأَقوامُ غَيرَ نُجومِ",60,"م",1,0],["أَبَت عامِرٌ أَن يَأخُذوا بِأَسيرِهِم","مِئينَ مِنَ الأَسرى لَهُم عِندَ دارِمِ",61,"م",1,0],["أَبَتِ الرَّكائِبُ أن تَعُنَّ وقد دَعَتْ","قلباً تأبَّى ثم أَصحَبَ طائِعا",62,"ع",2,0],["أَبَت ذِكَرٌ مِن حُبِّ لَيلى تَعودُني","عِيادَ أَخي الحُمّى إِذا قُلتُ أَقصَرا",63,"ر",2,1],["أَبَت طَرَفاتُ كُلِّ قَريرِ عَينٍ","بِها إِلّا اِضطِراباً وَاِنقِلابا",64,"ب",2,0],["أَبَتِ الدُنيا عَلى كُلِّ حَيٍّ","آخِرَ الأَيّامِ إِلّا ذَهابا",65,"ب",2,0],["أَبَتِ الدُنيا عَلى سُكّانِها","في البِلى وَالنَقصِ إِلّا ما أَتَت",66,"ت",1,0],["أَبَتِ الساعاتُ إِلّا سُرعَةً