],["أَبَت كُلَّ مَن أَنضى إِلَيها رِكابَهُ","فَلا حازِمٌ أَفضى إِلَيها وَلا غَمرُ",135,"ر",1,0],["أَبَتِ الظَلامَةَ هِمَّةٌ كَعبِيَّةٌ","نامَ الأَنامُ وَرَبُّها لا يَهجَعُ",136,"ع",1,0],["أَبَت لَكَ أَن تُسامَ الخَسفَ نَفسٌ","إِلى غَيرِ الفَضائِلِ لَن تَتوقا",137,"ق",2,0],["أَبَت لِيَ ذاكَ ديمَةٌ ناصِرِيَّةٌ","تَفوقُ الحَيا نَفعاً وَتَكثُرُهُ وَدقا",138,"ق",2,0],["أبت العصمة أن يشتبها","ليس بين النّجم والشّمس اشتباه",139,"ا",2,0],["أبت مقلتي إلا مجانبة الكرى","فواخجلتي هل لي إلى الطيف من عذر",140,"ر",1,0],["أَبَت لِي ذاكَ آباءٌ كِرامٌ","إِذا وُلِدَ اِمرُؤٌ مِنهُم أَفادا",141,"د",2,0],["أَبَت لِي وِصالَ البِيضِ هِمّاتُ ماجِدٍ","بَعيدِ الحَمايا غَيرِ نِكسٍ وَلا وَغلِ",142,"ل",1,0],["أَبَت عِزَّةً أَن تَقبَلَ الضَيمَ نَفسُهُ","وَذُو العِزَّةِ القَعساءِ كَيفَ يُضامُ",143,"م",1,0],["أَبَت لَكَ العِزَّةُ القَعساءُ وَالكَرَمُ","أَن تَقبَلَ الضَيمَ أَو تَرضى بِما يَصِمُ",144,"م",1,1],["أَبَت نُوَبُ الأَيّامِ إِلّا تَمادِيا","فَوَا شِقوَتا ما لِلّيالي وَما لِيا",145,"ي",2,1],["أَبَت إِلا تَعُودُكَ مِن هَواها","دَوَاعِ يَستَقيمُ لها عَويِصى",146,"ص",2,0],["أَبتَغي عارِفةً من نولِها","وهيَ تَرعانيَ تحتَ الحللِ",147,"ل",1,0],["أَبتَغي في جوارِ داركَ دارا","لستُ أَرضى سِواك في الخلقِ جارا",148,"ر",2,0],["أَبَت لَكُمُ مَواطِنُ طَيِّباتٌ","وَأَحلامٌ لَكُم تَزِنُ الجِبالا",149,"ل",2,0],["أبت كفُّهُ إلاّ السماحةَ والنَّدى","وهمَّته إلاّ المكارمَ والمجدا",150,"د",2,0],["أبتْ عيناكَ إلا أن تصوبا","وهذا القلبُ إلا أن يذوبا",151,"ب",2,1],["أَبَت كَبِدي لا أَكذِبَنكَ قِتالَهُم","وَكفّي وَتأباهُ عَلَيَّ أَنامِلي",152,"ل",2,0],["ابتدع إثماً جديداً ولتقل","إن هذا الإثم إثمٌ اول",153,"ل",1,0],["أبتغى آسياً فقد عيل صبري","من توالى الوجيب والخفقان",154,"ن",1,0],["أبتغى صاحباً تولّه قبلى","وشجاه من الجوى ما شجاني",154,"ي",1,0],["أَبَت عَطايا عَلِيٍّ أَن أَمُدَّ إِلى","يَدي يَداً كَفَّني مَعروفُهُ وَكَفا",155,"ف",2,0],["أَبَتْ جَمْرَةٌ مِنْ شَوْقِ حَمْزَةَ تَفْتُرُ","أَمَا فِي اللِّقَا مِنْ خَمْرَةٍٍ مِنْهُ تُنْشَرُ",156,"ر",1,1],["أبتْ كثرةُ الأعداء أنْ يتجنّبوا","كلابيَ حتى يُستثارَ عَقورُها",