 اليَأسَ وَالرِضا","فَها أَنا لا ذَمّاً أَصوغُ وَلا مَدحا",179,"ح",2,0],["أَبَت كاسِيا أَن تَلبَسَ اللَيلَ أَسوَداً","وَلا الهَمَّ إِنَّ الهَمَّ كَاللَيلِ أَسوَدُ",180,"د",1,0],["أبَتِ الهِدايَةُ أَن تَصُد","دَ عَنِ السَّبيلِ وأَن تُضِلا",181,"ل",2,0],["أبَتِ الإمامَةُ أن تَليقَ بِغَيرِهم","أهلُ الرِّسالةِ بِالإمامَةِ أليَقُ",182,"ق",1,0],["أبت صفاتُ سجايانا محاسنَها","كالضَّبِّ لا يلتقي والنونَ في وطن",183,"ن",1,0],["ابتهلْ، فالسَّماءُ تفتَحُ باب","ومضيقُ الأسى يَصير رحابا",184,"ب",2,1],["ابتهلْ صادقاً، تَرَ النورَ يَهمي","وترى ما طلبتَه مُستجابا",184,"ب",2,0],["ابتهلْ، يقتربْ إليكَ بعيدٌ","لم تكنْ قبله تظنُّ اقترابا",184,"ب",2,0],["أَبَت لَحظات عَزمِكَ أَن تَناما","وَقَد حَمَّلتها المِنَن الجِساما",185,"م",2,1],["أبَتِ المحاسنُ والمكارم في النَّدى","إلاَّ بقاءً بعدهم وخلودا",186,"د",2,0],["أبَتْ نفسي مداناة الدّنايا","وأغنتها القناعة عن غناها",187,"ا",3,0],["أبتغي الفوز بالثناء عليكم","وأراه فيما أحاول غنما",188,"م",2,0],["أَبَتِ الإمارَةُ أَنْ تُزَوَّجَ غَيْرَهُ","مِنْ بَعْدِ ما خُطِبَتْ أَشَدَّ إِباءِ",189,"ا",2,0],["أَبَتْ لِيَ أَنْ أُضامَ صفاتُ مَجْدٍ","أَبيَ لولا سَمَاحُكَ أَنْ يُضَاما",190,"م",2,0],["أَبَتْ له ذاك هِمَّةٌ شُغِفَتْ","بالجُودِ لو ساعَدَتْ عليه جِدَه",191,"د",2,0],["أبتِ النفسُ التي ألزمْتها","ليَ أن أجعل شِعري مكسبي",192,"ب",2,0],["أبت شمسُه إلا الغروبَ وقد سَما","لها مُكلِفي من كلّ عضو بيُوشَعِ",193,"ع",1,0],["أبتِ الوصالَ فقُلتُ هلاّ في الكَرى","فحمَتْ جُفوني طيفَها أن يُطْرِقا",194,"ق",2,0],["أبَتِ المكارمُ أن يضنّ بمشْربٍ","أن غرّقَ الثَقَلينِ بحرُ هِباتِه",195,"ت",2,0],["أَبَتِ العزيمةُ من فؤادٍ جامِدٍ","أَنْ تستقيدَ لِماءِ جفنٍ ذائبِ",196,"ب",1,0],["إبتدره إن شئت أو لا","فحتم مصرع الظلم فوق ما سلفه",197,"ف",2,0],["أبتاع عزّاً بالحياة ومَن يَمِلْ","حبُّ الحياة به يُهَنْ أو يُظْلَمِ",198,"م",1,0],["أَبَتْ أن يُطيف الرائضون بجنْبها","فقوَّدتَها مملوكةَ الظَّهرِ تُركَبُ",199,"ب",1,0],["أبت غير زأرٍ أسد خفَّان مرعبٍ","وللنَّوحِ بالدوْح النضير الحمائمُ",200,"م",1,0],["أبتْ مُرهفاتٌ كالمنايا طَريرةٌ","وجُرْدٌ كسيلِ الطَّوْد غيرُ بطاءِ",201,"ا",2,0],["أبتْ لوفاءٍ هِمَّةٌ دارِ ميَّةٌ","يُطاول عُلْويَّ النجومِ قصيرُها",202,"ر",3,0],["أبتِ الصَّبابةُ أن أبيت مهوّماً","ومن العجائب أن يزور مسهَّداً",203,"د",2,0],["أبت أن تمسّ الطيب طيّ برودها","وقد أقسمتْ أن لا يكون لها نشر",204,"ر",1,0],["أبت بعده الأيام إلاَّ تلوُّناً","كعهدك واللذّاتُ إلاَّ تلوُّما",205,"م",2,0],["أبت الوداع فبكرت برحيل","أجناية أم أتعمت بجميل",206,"ل",1,1],["أبتي التحقت بها فضمك قبرها","بشرى لوالدتي بهذا الوافد",207,"د",1,0],["أبتي مضت حجج عليك ثلاثة","ولدي منك الطيف أحسن وارد",207,"د",1,0],["أبتي كيف غالك الموت غدرا","لا اعتراضا وانما ضقت صدرا",208,"ر",2,1],["أبتي عليك غوادق الرحمات إذ","لا زلت أجني من رضاك زهورا",209,"ر",2,0],["أبتزّ لحمَ الجسومِ حولاً","يُردُّ عظماً من الأضاحي",210,"ي",1,0],["أبت غلبات الشوق ألا تقربا","إليك ونأي العذل ألا تجنبا",211,"ب",2,1],["أبت ذاك من أبناء زريك عصبة","صباح عدو صحبته عصيب",212,"ب",1,0],["أبت عليهم يد آلية ويد","تعزى إلى آل رزيك وتنتسب",213,"ب",1,0],["ابِت نائِماً اما فُؤادي فَهمه","قَليلُ وَاما مَس جِلدي فَبارِد",214,"د",1,0],["إبتسم فالحياةُ تُبدي ابتسامَا","لك وأملأ سماعَها أنغاما",215,"م",2,1],["أَبَتْ زَفراتُ الحبِّ إلّا تصعُّدا","وَيَأبى لَهيبُ الوجْدِ إِلّا تَوقُّدا",216,"د",2,1],["أبَتْ ملاحَتُهُ من أنْ يجودَ لنا","فليتَه في عيونِ العِشقِ ما مَلُحا",217,"ح",2,0],["أَبَت حَدَقُ الواشينَ أَن يَصفُوَ الهَوى","لَنا فَتَعاطَينا التَعَزِّيَ وَالصَبرا",218,"ر",2,0],["أَبَت أَن يَنالَ الدُنُّ مَسَّ أَديمِها","فَحاكَ لَها الإِزبادُ مِن دونِها سِترا",218,"ر",2,0],["أَبَت كَبِدُ المُشتاقِ أَن تَسأَمَ الجَوى","وَلضو سَئِمَت لَم يَسأَمِ الجَسَدُ النَضوُ",219,"و",1,0],["أَبتْ رِقّتي إِلّا الَّذي يَقْتَضِي الهَوَى","وَعَزْمِي إِلّا ما اقْتَضَى الرَّأيُ والعَقْلُ",220,"ل",1,0]]}