{"poems":[[65,"هو طيفها وطروقه تعليل","https://www.aldiwan.net/poem46153.html","الكامل"],[4,"عفت الديار محلها فمقامها","https://www.aldiwan.net/poem21196.html","الكامل"],[52,"أخداش أنت ابن الثلاثة","https://www.aldiwan.net/poem64722.html","مجزوء الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42676","البسيط"],[125,"أضحى فؤادي والأشواق مرتبضا","https://www.aldiwan.net/poem23822.html","البسيط"],[164,"برغم سنة خير العجم والعرب","https://www.aldiwan.net/poem59217.html","البسيط"],[228,"إيه برناس هيكل الشعراء","https://www.aldiwan.net/poem41899.html","الخفيف"],[384,"ينشنه نوشاً بأمثال السطع","https://www.aldiwan.net/poem4566.html","الرجز"],[556,"لا تقربن عضيهة","https://www.aldiwan.net/poem48037.html","مجزوء الكامل"],[556,"لم يبق لي بعد المشيب تصابي","https://www.aldiwan.net/poem48055.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122595","الكامل"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18499","السريع"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133808","الخفيف"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25308","الرجز"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137129",""],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97949","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110105","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216779","السريع"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[4166,"","https://poetry.dctabudhabi.ae/diwan/poem/203266","البسيط"],[4767,"ابتلاء","https://www.poetsgate.com/ViewPoem.aspx?id=200419",""],[4830,"في حال الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=195226",""],[585,"يا رائد القوم إن القوم أنضاء","https://www.poetsgate.com/ViewPoem.aspx?id=161878",""],[5096,"لغة الضاد","https://www.poetsgate.com/ViewPoem.aspx?id=211320",""],[5170,"ضايق الصدر","https://www.poetsgate.com/ViewPoem.aspx?id=175541",""],[5883,"عجب عجاب","https://www.poetsgate.com/ViewPoem.aspx?id=24072",""],[5939,"مكرُ الأنوثة","https://www.poetsgate.com/ViewPoem.aspx?id=185494",""],[5994,"كلام في الظل","https://www.poetsgate.com/ViewPoem.aspx?id=184662",""]],"verses":[["فالضّيْفُ إلا عَنْ نَداهُ مُدَفَّعٌ","والجارُ إلا في ذَراهُ ذَليلُ",0,"ل",1,0],["فَالضَيفُ وَالجارُ الجَنيبُ كَأَنَّما","هَبَطا تَبالَةَ مُخصِباً أَهضامُها",1,"م",3,0],["فَالضامِنينَ لِجارِهِم","وَلِكُلِّ مُنتَجَعٍ غِياثَه",2,"ث",2,0],["فَالضَّوْءُ مُحْتَبِسٌ وَالْمَاءُ مُنْطَلِقٌ","وَالْجَوُّ مُنْقَبِضٌ وَالظِّلُّ مُنْبَسِطُ",3,"ط",1,0],["فالضَّبْدُ رؤيته والضَّهْدُ همته","والغض حرفته مع رتبة الغرضا",4,"ض",2,0],["فالضرب بالكف دون الدف موقعه","وما صفير فم كالصفر في القصب",5,"ب",1,0],["فَالضِياءُ الأَكيدُ في مقلَة الشا","عِرِ لا في النُجومِ أَو في ذُكاءِ",6,"ا",2,0],["فالضارب الأيسر من حيث ضلع","بها المسيل ذات كهفٍ فضجع",7,"ع",1,0],["فالضّاحكاتُ وقد نعم","نَ بهنَّ هنّ الباكياتُ",8,"ت",1,0],["فالضَّربُ في هاماتهمْ منثورةٌ","فوق الثّرى والطّعن في الأَقرابِ",9,"ب",1,0],["فالضَّغنُ تُكمِنُه القُلوب مَخافَةً","والجَمرُ يُكمنُهُ خُمودُ رَماده",10,"د",2,0],["فَالضَيفُ مَعروفٌ لَهُ حَقُّهُ","لَهُ عَلى أَبوابِكُم فاتِحُ",11,"ح",1,0],["فالضياءُ الدفيقُ من كل صوب","يترامى على الغصون الغيد",12,"د",1,0],["فَالضَيْفُ يُقْرَى وَالمُؤدّي يُحْبا","الْهِنْءُ غَيْثاً وَالجَزِيلُ وَهْبا",13,"ب",2,0],["فَالضَّيفُ والمأكُولُ شَيءٌ وَاحِدٌ","والوَهمُ يَحسِبُ هَاهُنَا شَيئَانِ",14,"ن",1,0],["فَالضِّدُّ مَعرِفَةُ الإِلَهِ بِضِدِّ مَا","فِي النَّفسِ مِن عَيبٍ وَمِن نُقصَانِ",14,"ن",1,0],["فالضاد رافلة به في حلة","ليست بها تبلى على طول المدى",15,"د",2,0],["فالضل عند الأولين يعيبهم","والخبل عن الآخرين سواء",16,"و",3,0],["فالضِيقُ لي في الجُوع قُوتٌ وَهوَ لي","عندَ التلهُّب مَورِدٌ ومَعينُ",17,"ن",1,0],["فالضرب لا يرضيه في وتره","والموت لا يجزيه عن ثأره",18,"ر",2,0],["فَالضَروراتُ لَها حُكمٌ عَظيم","إِنَّما عَن مَوقِفِ الطَعنِ نُقم",19,"م",1,0],["فالضيق اذهب والتوفيق سبب و","التنسيق رتب في تصديق حكمهم",20,"م",1,0],["فالضغط لم يثبتْ له في حالةٍ","يعلو ويهبط نازلاً متحوِّلا",21,"ل",2,0],["فالضاحكُ والباكي قالا","في الموتِ تشابه كأسانا",22,"ن",2,0],["فالضأن تفرسهم والناس تفرسها","فشد ما افترس الآباء أبناء",23,"ا",2,0],["فالضاد فيها من دلائل عزَّتي","أُفُقٌ يطاول شاهِق البنيان",24,"ن",1,0],["فالضما ما يفرق بين قحط وشعيب","في سراب المواصل الهجر يقبره",25,"ر",2,0],["فا لضعف عدتنا وعمدة أمرنا","هو عندنا أمضى من البيض الصقال",26,"ل",1,0],["فالضَّعفُ حينًا حكمةٌ","لينًا عَشِقْتُ إهابَها",27,"ب",3,0],["فالضوء بينكما يرثله المدى","كلِماً يزفك نبضَه، أين المفرْ",28,"ر",1,0]]}