{"poems":[[63,"هو طيفها وطروقه تعليل","https://www.aldiwan.net/poem46153.html","الكامل"],[4,"عفت الديار محلها فمقامها","https://www.aldiwan.net/poem21196.html","الكامل"],[50,"أخداش أنت ابن الثلاثة","https://www.aldiwan.net/poem64722.html","مجزوء الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42676","البسيط"],[122,"أضحى فؤادي والأشواق مرتبضا","https://www.aldiwan.net/poem23822.html","البسيط"],[161,"برغم سنة خير العجم والعرب","https://www.aldiwan.net/poem59217.html","البسيط"],[224,"إيه برناس هيكل الشعراء","https://www.aldiwan.net/poem41899.html","الخفيف"],[380,"ينشنه نوشاً بأمثال السطع","https://www.aldiwan.net/poem4566.html","الرجز"],[552,"لا تقربن عضيهة","https://www.aldiwan.net/poem48037.html","مجزوء الكامل"],[552,"لم يبق لي بعد المشيب تصابي","https://www.aldiwan.net/poem48055.html","الكامل"]],"verses":[["فالضّيْفُ إلا عَنْ نَداهُ مُدَفَّعٌ","والجارُ إلا في ذَراهُ ذَليلُ",0,"ل",1,0],["فَالضَيفُ وَالجارُ الجَنيبُ كَأَنَّما","هَبَطا تَبالَةَ مُخصِباً أَهضامُها",1,"م",3,0],["فَالضامِنينَ لِجارِهِم","وَلِكُلِّ مُنتَجَعٍ غِياثَه",2,"ث",2,0],["فَالضَّوْءُ مُحْتَبِسٌ وَالْمَاءُ مُنْطَلِقٌ","وَالْجَوُّ مُنْقَبِضٌ وَالظِّلُّ مُنْبَسِطُ",3,"ط",1,0],["فالضَّبْدُ رؤيته والضَّهْدُ همته","والغض حرفته مع رتبة الغرضا",4,"ض",2,0],["فالضرب بالكف دون الدف موقعه","وما صفير فم كالصفر في القصب",5,"ب",1,0],["فَالضِياءُ الأَكيدُ في مقلَة الشا","عِرِ لا في النُجومِ أَو في ذُكاءِ",6,"ا",2,0],["فالضارب الأيسر من حيث ضلع","بها المسيل ذات كهفٍ فضجع",7,"ع",1,0],["فالضّاحكاتُ وقد نعم","نَ بهنَّ هنّ الباكياتُ",8,"ت",1,0],["فالضَّربُ في هاماتهمْ منثورةٌ","فوق الثّرى والطّعن في الأَقرابِ",9,"ب",1,0]]}