{"poems":[[90,"من أين من أين يا ابتدائي","https://www.aldiwan.net/poem45073.html","مخلع البسيط"],[74,"سرت لك آمالي وإن عاقني الضنى","https://www.aldiwan.net/poem18504.html","الطويل"],[53,"عنفت شيخي أذان في مواثبة","https://www.aldiwan.net/poem65949.html","البسيط"],[93,"أنت والكأس في يدي فلمن أنت في غد","https://www.aldiwan.net/poem8801.html","عموديه"],[91,"قد قلت حقا فلم تقبله أذهان","https://www.aldiwan.net/poem44873.html","البسيط"],[45,"ضيف ألم برأسي غير محتشم","https://www.aldiwan.net/poem10532.html","البسيط"],[68,"يا سمي الذي به اتهم الذئ","https://www.aldiwan.net/poem39533.html","الخفيف"],[53,"عنَّفتُ شيخيْ في مواثبة ٍ","https://www.poetsgate.com/ViewPoem.aspx?id=30282",""],[173,"ما أنصف الطلل العافي بماوانا","https://www.aldiwan.net/poem1685.html",""],[203,"قمر أطلعت أخاه السماء","https://www.aldiwan.net/poem45628.html","الخفيف"],[280,"حسب الوجود على التأييد برهانا","https://www.aldiwan.net/poem25507.html","البسيط"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[302,"وسائل لي عن أشياء كيف أتت","https://www.aldiwan.net/poem33338.html","البسيط"],[447,"رضى بما قدر الله الحكيم رضى","https://www.aldiwan.net/poem14455.html","البسيط"],[453,"لما علمت بما ألقى من الوصب","https://www.aldiwan.net/poem53774.html","الطويل"],[463,"قفا نضويكما بالغمر نسأل","https://www.aldiwan.net/poem56264.html","الوافر"],[520,"الحمد لله الذي","https://www.aldiwan.net/poem12285.html","مجزوء الرجز"],[556,"كذا تكشف الغماء بعد ظلامها","https://www.aldiwan.net/poem47193.html","الطويل"],[563,"إلى الله نرفع أمرا ألم","https://www.aldiwan.net/poem34070.html","المتقارب"],[567,"طيف إلي سرى عن غير ميعاد","https://www.aldiwan.net/poem52954.html","البسيط"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34406","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48688","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70834","الوافر"],[2136,"","https://poetry.dctabudhabi.ae/diwan/poem/203569","الوافر"],[2207,"","https://poetry.dctabudhabi.ae/diwan/poem/33855","الوافر"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205787","الرمل"],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136973",""],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133969","الطويل"],[240,"","https://poetry.dctabudhabi.ae/diwan/poem/12991","المتقارب"],[3206,"","https://poetry.dctabudhabi.ae/diwan/poem/145877","الرمل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89009","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62765","الطويل"],[3519,"","https://poetry.dctabudhabi.ae/diwan/poem/145149","المتقارب"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81687","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83451","البسيط"],[4717,"رثاء مصطفى القاسم","https://www.poetsgate.com/ViewPoem.aspx?id=199669",""],[5136,"يا بروحي المدلل البتاه","https://www.poetsgate.com/ViewPoem.aspx?id=121772",""],[5186,"يا هنائي ساعة اللقيا وقد","https://www.poetsgate.com/ViewPoem.aspx?id=156511",""],[5277,"حواء..ولدتني شمساً..وأولدتُها قمرين","https://www.poetsgate.com/ViewPoem.aspx?id=192760",""],[5722,"حنين مغترب","https://www.poetsgate.com/ViewPoem.aspx?id=12689",""],[5897,"حلم","https://www.poetsgate.com/ViewPoem.aspx?id=156535",""],[5309,"أنوار هادي الورى في كعبة الحرم","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573517",""]],"verses":[["فإن أجزاء كل جسم","مبتعدات بلا التقاء",0,"ا",2,0],["فإن أجدَبت كفِّي فأنتَ غياثها","وإن فسدت حالِي فأنتَ صلاحها",1,"ح",3,0],["فإن أجدنا سفادَ السانحات لنا","فثَمَّ تقوَى معانينا وتكتملُ",2,"ل",1,0],["فَأُناجيكَ في الضُحى","وَهوَ أَمراسُ عَسجَدِ",3,"د",1,0],["فان اجدت فمن جدواك جودته","وان اسأت فكم قد خاب فنان",4,"ن",1,0],["فَإِن أَجابوا فَما قَصدي بِها لَهُمُ","وَإِن تَوَلَّوا فَما أَرضى لَها بِهِمِ",5,"م",1,0],["فَأُناجي بِكُلِّ مَعنىً دَقيقٍ","وَأُناجي بِكُلِّ لَفظٍ وَجيزِ",6,"ز",1,0],["فإن أجدنا سفادَ السانحات لنا","فثَمَّ تقوى معانينا وتكتهل",7,"ل",1,0],["فَإِن أُجَمجِم وَأُخفي عَنهُمُ خَبري","حَمِيَّةً جَلَبَت هَوناً وَنُقصانا",8,"ن",2,0],["فأناجيهِ مثلما عردَ الطي","رُ وناجتْ أليفها الورقاءُ",9,"ا",2,0],["فَإِنْ أُجَوِّدْ فَمَا زَالَتْ سَعَادَتُهُم","تَهْدِي وَتُهْدِي إِلى ذِي العِيِّ تِبْيانَا",10,"ن",2,0],["فإن أَجبتَ دَعوتَه","فاِحذَر وجانِب جَفوتَه",11,"ه",1,0],["فإِن أَجابَكَ أَو أَولاكَ مَعرفةً","فلِلأَفاضِل إِفضالٌ وإِيلاءُ",12,"ا",2,0],["فإن أجبت الدعا مني ظفرت بما","أهوى ونلت المنى والغاي والغرضا",13,"ض",2,0],["فان اجد فى امتثالى ما أمرت بها","فذاك من غرس فضل منك مكتسب",14,"ب",1,0],["فإن أَجزعْ فماضٍ كلُّ ماضٍ","وإن أصبِرْ فآتٍ كلُّ آتِ",15,"ت",1,0],["فإن أجزت بيعتي","فما أخاف الغبنا",16,"ن",2,0],["فإنْ أجرمتْ فيك اللّيالِي فقد أَتَتْ","على عَجَلٍ منها بمحوِ اِجتِرامها",17,"م",3,0],["فإنا جميعاً عبيد له","وفي بابه قد وقفنا خدم",18,"م",1,0],["فإنْ أجَبْتَ فما حَقُّ الجَوابِ لها","لكن ليَظَهرَ فَرْقٌ بينَ أضدادِ",19,"د",1,0],["فَإِن أَجملَت أَو إِن أَخَلَّت قَصائِدي","فَكُن لي عَلى الحالين أَجمَل ناقِدِ",20,"د",1,0],["فإن أجر الذي يسعى لينقذها","لأجر من حال بين الذئب والشاة",21,"ه",1,0],["فإن أجرَى دموعي حشْ","شَ جمراً في الحِشا وُارِي",22,"ر",2,0],["فإن أجزع فلي قلب جليد","وإن أصبر فلي قلب كئيب",23,"ب",1,0],["فَإِن أَجزَع عَلَيكَ فَلا مَلومٌ","وَإِن أَصبِر فَلِلحُرِّ اِصطِبارُ",24,"ر",1,0],["فأناجيك بألحان الهوى","سابقات خاطري في شفتى",25,"ا",1,0],["فأناجي الشمس والبدر معا","وأنادي بالنشيد الملاين",26,"ن",1,0],["فإن اجتهادي في الكمالات نافعي","وتوفيق مولانا العزيز مواصلي",27,"ل",2,0],["فَإِنَّ اِجتِماعَ الغِنى وَالنُهى","مَرامٌ يَشُقُّ عَلى الطالِبِ",28,"ب",1,0],["فأناجي النفس كيف الصد عني","فيجيب الدمع عنها وأنيني",29,"ي",1,0],["فإن أجدِ المحراثَ لم ألق حارثاً","وإن أجد المعزاق لم ألق فحّاتا",30,"ت",2,0],["فإنّ اجتنابَ الشّرّ سوف يُعيدُها","إلى شِيمَةٍ أخلاقُها لم تُؤَدَّبِ",31,"ب",1,0],["فإنا جنود الإله الألى","بإصرارها تتحدى الردى",32,"د",2,0],["فإن أجتلب شعراً إليه فإنَّني","إلى هجرِ تمراً كما قيل جالب",33,"ب",1,0],["فإن أجبتَ غنمتُ الفَضل منكَ وَإِن","أَبيتَ حاشاكَ فات الصَبَّ مغنمُهُ",34,"م",2,0],["فَأُنَاجِيكَ حَيْثُ صَوْتُكَ حَوْلي","وَجَرَى دَمْعِي حَيْثُ طَيْفُكَ عَنَّا",35,"ن",2,0],["فأناجيه خاليا فافدي","إذ أناجيه حسنه وحلاه",36,"ا",2,0],["فأناجي بين ضحك وبكا","وتناغي بين عطف وحنين",37,"ن",1,0],["فإنَّا جِدبُ روحٍ قدْ تمارتْ","فأزهرَ غصنُها في العفوِ عَطفا",38,"ف",2,0],["فأناجي وما أملُّ المناجا","ةَ وأصبو وللهوى استرسال",39,"ل",1,0],["فأنا جزء من تاريخ","أهدى للدنيا أنوارَهْ",40,"ر",2,0],["فإن أَجَدتُ بِهذا الطَّلِّ مَدحَكُمُ","فَكُلُّ مَعنىً بِكُم كالهاطِلِ العَرِمِ",41,"م",1,0]]}