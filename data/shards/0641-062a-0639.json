أَرَأَيتَ طِفلاً عَلَّلوهُ بِداحِ",3,"ح",1,0],["فَتَعَهَّدوها بِالصَلا","حِ وَأَحسِنوا فيها الوِصايَه",4,"ا",3,0],["فَتَعَلَّموا فَالعِلمُ مِفتاحُ العُلا","لَم يُبقِ باباً لِلسَعادَةِ مُغلَقا",5,"ق",2,0],["فتعرف الفضل الذي بثه","أبوك في أمته عن صواب",6,"ب",1,0],["فَتَعَلَّمَا النُّطْقَ الصَّحِيحَ وَعُوِّدَا","خَطَّ الحُرُوفِ كِلاهُمَا فِي آنِ",7,"ن",1,0],["فَتَعَدَّدَتْ أَرْزَاؤُهَا وَتَفَاقَمَتْ","فِي رُزْئِهِ المُتَعَدِّدِ المُتَفَاقِمِ",8,"م",1,0],["فَتَعَدَّدَتْ وَالبِرُّ مِنْ أغْرَاضِهَا","وَالنُّصْحُ وَالتَّثْقِيفُ وَالتَّقْوِيمُ",9,"م",1,0],["فَتَعجِزُ عَنهُمُ الأَمصارُ ضَيِّقاً","وَتَمتَلِىءُ المَنازِلُ وَالبِلادُ",10,"د",1,0],["فتعبّست منه السماء وأمطرت","ناراً وقد أخذ اللهيب يسيح",11,"ح",1,0],["فتعلو من سفاهته بمدّ","وتسفل من فهاهته بجزر",12,"ر",1,0],["فتعرّيت مثلها ثم أشرع","ت إلى الطعن صعدة مرّانه",13,"ن",2,0],["فتعلو في ديارهم المباني","وتُخصِب في بلادهم المراعي",14,"ع",2,0],["فَتَعَلَّقَن بِبَناتِ نَعشٍ هارِباً","أَو بِالبُحورِ وَشِدَّةِ الأَمواجِ",15,"ج",1,0],["فَتَعَزَّ إِن نَفَعَ العَزاءُ مُكَلَّفاً","فَالشَوقُ يُظهِرُ لِلفِراقِ عَويلا",16,"ل",2,0],["فَتَعَزَّ عَن هَذا وَقُل في غَيرِهِ","وَاِذكُر شَمائِلَ مِن أَخيكَ المُنجِبِ",17,"ب",1,0],["فَتَعلَمَ أَن لا أَنتَ مُدرِكُ ما مَضى","وَلا أَنتَ مِمّا تَحذَرُ النَفسُ وائِلُ",18,"ل",1,0],["فَتَعَطَّرَت ريحُ الصَبا من عِطرِهِم","وَسَرَت بِنَشرِ رَوائِح نَفَحاتُ",19,"ت",1,0],["فتعالتْ فَوّارَةٌ تحسدُ الخض","راءُ إغداقَ مائِها الغبراءَ",20,"ا",2,0],["فتعذَّرتْ طلباتُهم وَتَنَهْنَهُوا","مثل الحوائم ذادها الذُّوَّادُ",21,"د",1,0],["فتعوَّضا الدنيا الدنيّة كاسمها","من تلكمُ الجنَّاتِ والأنهارِ",22,"ر",1,0],["فتعدَّوا على الزمان بعدوا","ك وكانوا لا يأملون انتصافا",23,"ف",2,0],["فتعوَّذْ بحنطةِ الكشكِ منها","عائداً بالجميل عودَ الكرامِ",24,"م",1,0],["فَتُعِزُّ دُنيا قَد طَوَت آبائي","وَتَهِشُّ دُنيا أَطلَعَت أَبنائي",25,"ي",1,0],["فَتَعالَي وَقَبِّلي شَفَتَيهِ","وَيَدَيهِ وَشَعرِهِ وَجَبينَه",26,"ن",2,0],["فتعيشَ في الدُّنيا بقلبٍ زاخرٍ","يقظِ المشاعرِ حالمٍ مسحورِ",27,"ر",1,0],["فتعاورتني للشكوك وساوس","سود وعافت مجلسي جلاسي",28,"س",2,0],["فتعانقنا مقسمين على انا","على الحفظ للمواعيد ندأب",29,"ب",1,0],["فَتُعطي مَن بَقى مالاً جَسيماً","وَتُعطي مَن مَضى شَرَفاً عَظيما",30,"م",2,0],["فَتَعلَمُ أَن لَو كُنتَ خَيراً عَلَيهِمُ","كَذَبتَ وَأَخزاكَ الَّذي أَنتَ قائِلُه",31,"ل",2,0],["فتعيشُ بعدَ مماتِه أشعارُه","وتموتُ قبلَ مماتِها أشعارُها",32,"ر",3,0],["فَتَعرُكُّمُ عَركَ الرَحى بِثِفالِها","وَتَلقَح كِشافاً ثُمَّ تَحمِل فَتُتئِمِ",33,"م",1,0],["فَتَعَجَّبتُ مِن سَماءٍ بِأَرضٍ","كُلَّ يَومِ يَلوحُ فيها هِلالُ",34,"ل",1,0],["فَتَعجَبُ لَبّاتُ الكُماةِ بِطَعنِهِ","وَيُعرِبُ هاماتِ الحُماةِ بِضَربِهِ",35,"ب",2,0],["فتعرَّض الماضي الجمي","لُ بوجهه متهلِّلا",36,"ل",2,0],["فتعالي روّي الظما في عيوني","واجنوني لقطرة من حنانِ",37,"ن",1,0],["فتعلم كيف تنسى","وتعلم كيف تمحو",38,"و",1,0],["فَتُعطي الَّذي تُعطيهِمُ الخَيلُ وَالقَنا","أَكُفٌّ لِإِرثِ المَكرُماتِ مَوانِعُ",39,"ع",1,0],["فَتَعَمُّقُ الوُزَراءِ يَطفو فَوقَها","طَفوَ القَذى وَتَعَقُّبُ العُذّالِ",40,"ل",1,0],["فَتَعَفّى مِنَ الرَبابِ فَأَمسى ال","قَلبُ في إِثرِها عَميداً مُصابا",41,"ب",2,0],["فَتَعَزَّيتُ عَن هَواها لِرُشدي","حِنَ لاحَ القَذالُ مِنّي فَشابا",42,"ب",2,0],["فَتَعَرَّضتُ وَأَلقَي","تُ جَلابيبَ الحَياءِ",43,"ا",2,0],["فَتَعاقَدنا يَداً بِيَدٍ","وَتَعاهَدنا فَماً لِفَمِ",44,"م",1,0],["فَتَعَالَى مَنْ بَرَا صُورَتَهُ","مِنْ جَمَالٍ أُودِعَ الماءَ المَهينا",45,"ن",2,0],["فَتَعايا التَيسُ حينَ كَبا","وَدَنا فوهُ مِنَ العَجبِ",46,"ب",1,0],["فَتَعَزَّيتُ بِصِرفٍ عُقارٍ","نَشَأَت في حِجرِ أُمِّ الزَمانِ",47,"ن",1,0],["فتعالى اللَه ما في الأر","ضِ قاضٍ أو أميرُ",48,"ر",1,0],["فَتَعَرَّضَت لَكَ لِلَّذي حاذَرتَهُ","حَوراءُ في عِقدٍ لَها وَوِشاحِ",49,"ح",1,0],["فَتَعَزَّيتُ عَن عُبَي","دَةَ وَالحُبُّ غالِبي",50,"ب",2,0],["فَتَعاطَيتُ جيدَها ثُمَّ مالَت","مَيَلانَ الكَثيبِ بَينَ الرِمالِ",51,"ل",1,0],["فَتَعلَم بَغداد على بعد أرضها","بأن ابنها في مصر منزله حمد",52,"د",1,0],["فَتَعلَم أَنَّ الموت حق وأنها","إذا لَم تَرِدْه فَهو سوف يرودها",53,"د",3,0],["فَتَعاتَبنا عَلى طول النوى","وَكِلانا حالف معتذر",54,"ر",1,0],["فتعاليَ هنا نجدد ذماما","ونخبّىء خطيئة وغراما",55,"م",2,0],["فتعالي إني أدحرج أرضا","لك تحت الظلام بيت الراعي",55,"ي",1,0],["فَتَعاهَدنا عَلى دَفعِ الأَذى","بِرُكوبِ الحَزمِ حَتّى نَظفَرا",56,"ر",2,0],["فَتَعَرَّضْتُ لتَسْلِيمٍ له","فإِذا التَيَّاهُ لا يَعْبأُ بي",57,"ي",1,0],["فَتَعَالَتْ بِهَامِهَا مَا اسْتَطَاعَتْ","وَأَطَالَتْ مِنْ ظِلِّهَا المَنْشُورِ",58,"ر",1,0],["فَتَعْدِلُ بِالأَصْدَافِ مَا رُحْتَ مُزْجِياً","وَتَبْذُلُ فِيه عَائِداً ثَمَنَ الدُّرِّ",59,"ر",1,0],["فَتَعْرِفُهَا وَبِهَا حِلْيَتَايَ","سِحْرُ الجَمَالِ وَسرُّ الذَّكَاءْ",60,"ا",2,0],["فَتَعاظَمَتْهُ جُرْأَةُ الْعَادِي بِلاَ","عُذْرٍ وَقُدْرَتُهُ عَلَى الإِبْطَالِ",61,"ل",1,0],["فَتَعَلَّمُوا ثُمَّ اعْمَلُوا وَثِقُوا","أَنَّ الْحَيَاةَ بِقَدْرِ مَا تُجْدِي",62,"د",2,0],["فَتُعِيدُ سِيرَةَ ذلِكَ القُطْبِ الَّذِي","بِجَلالِهِ هُوَ قُدْوَةُ الأَقْطَابِ",63,"ب",1,0],["فتعَاهَدَا وَتَعَاقَدَا","بِدِمَاهُمَا لا بِالخَنَاصِرْ",64,"ر",1,0],["فتعالى يا عين نبك عليها","من حياة إن كان يغنى بكاها",65,"ا",3,0],["فتعانَقا عند المنام","وملء ثغرهما ابتسام",66,"م",1,0],["فتعتلي منه بأحشاءِ مِلا","تضحكُ عن مثلِ صغيراتِ المِدى",67,"ا",1,0],["فتعاطيه مناهُ أكؤساً","من دخانٍ، واحتضاناً من هباءِ",68,"ا",2,0],["فتعهَّدوهُ ، فراحَ طوعَ بَنانِهمْ","يَبْرُونَ أنياباً له ومَخالبا",69,"ب",2,0],["فَتَعْرُكُكُمْ عَرْكَ الرَّحَى بِثِفَالِهَا","وَتَلْقَحْ كِشَافاً ثُمَّ تُنْتَجْ فَتُتْئِمِ",70,"م",1,0],["فتعزيتُ عن هواها لرشدي","حينَ لاحَ القذالُ مني فشابا",71,"ب",2,0],["فتعيشَ في الدنيا بقلبٍ زاجرٍ","يقظِ المشاعرِ، حالمٍ، مسحورِ",72,"ر",1,0],["فتعهدي قلبي بحبك واسمعي","ما شئت من شدوي ومن ألحانه",73,"ن",2,0],["فتعال حيث أنا هنا","وأحذر فقيد النار شارة",74,"ر",2,0],["فَتَعلَمَ أَنَّ عودي قَد يُعَيّا","عَلى غَمزِ المُقَوِّمِ وَالثِقافِ",75,"ف",1,0],["فَتَعَلَّمي أَنّي اِمرِأٌ ذو مِرَّةٍ","فيما اَلَمَّ مِنَ الخُطوبِ صَليبُ",76,"ب",1,0],["فتعساً لقومٍ كذَّبوا بمحمدٍ","وطُوبَى لقومٍ آمنوا بمحمدِ",77,"د",1,0],["فَتَعلُو وتهبُطُ منّا الصُدورُ","ونَهفُو وأبصارُنا مُطرِقَة",78,"ق",2,0],["فَتَعَاطَى مِنَ المُجُونِ مُداماً","شَوبُه بِالعَفَافِ دُ