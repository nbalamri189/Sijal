{"poems":[[53,"إطمح بطرفك هل ترى","https://www.aldiwan.net/poem30202.html","مجزوء الكامل"],[77,"ما لليراع خواضع الأعناق","https://www.aldiwan.net/poem35907.html","الكامل"],[77,"كن من صروف الردى على حذر","https://www.aldiwan.net/poem36441.html","المنسرح"],[86,"شيخان قد خبرا الوجود وأدركا","https://www.aldiwan.net/poem68877.html","الكامل"],[27,"طاف الخيال وأين منك لماما","https://www.aldiwan.net/poem6018.html","الكامل"],[72,"نعاه للفضل والعلياء والنسب","https://www.aldiwan.net/poem18241.html","البسيط"],[72,"بدا وقامته تختال بالتيه","https://www.aldiwan.net/poem20562.html","البسيط"],[51,"يا ثوبه الأزرق الذي قد","https://www.aldiwan.net/poem8147.html","مخلع البسيط"],[51,"أنت فضل وفضلة الشيء لغو","https://www.aldiwan.net/poem64008.html","الخفيف"],[51,"يا ابن أبي الجهم احتقب هذا اللطف","https://www.aldiwan.net/poem65467.html","الرجز"],[51,"لا عرتك الخطوب يا ابن حريث","https://www.aldiwan.net/poem65778.html","الخفيف"],[51,"أيها السيد الذي اختاره السيد","https://www.aldiwan.net/poem65973.html","الخفيف"],[51,"كان للأرض مرة ثقلان","https://www.aldiwan.net/poem66418.html","الخفيف"],[51,"يا ثلج ماء مالح آسن","https://www.aldiwan.net/poem66752.html","السريع"],[70,"يا ثقيلا لي من رؤيته","https://www.aldiwan.net/poem42752.html","مجزوء الرمل"],[85,"يا ثرى النيل في نواحيك طير","https://www.aldiwan.net/poem62831.html","الخفيف"],[85,"يموت في الغاب أو في غيره الأسد","https://www.aldiwan.net/poem62890.html","البسيط"],[85,"عرضوا الأمان على الخواطر","https://www.aldiwan.net/poem63665.html","مجزوء الكامل"],[45,"لي حبيب قد لج في الهجر جدا","https://www.aldiwan.net/poem63498.html","الخفيف"],[45,"يا ثقيلا على القلوب إذا عن","https://www.aldiwan.net/poem63535.html","الوافر"],[49,"ومهمه قد قطعت طامسه","https://www.aldiwan.net/poem64134.html","الطويل"],[66,"وافى وقد شفع التقطب وجهه","https://www.aldiwan.net/poem38606.html","الكامل"],[80,"يا أيها المعرض الذي رقدت","https://www.aldiwan.net/poem31258.html","المنسرح"],[69,"قولوا لمن يفخر بالعظم","https://www.aldiwan.net/poem28565.html","السريع"],[31,"يا ثريا الفؤاد ردي السلاما","https://www.aldiwan.net/poem41340.html","الخفيف"],[52,"يا قلب ويحك خنتني وفعلتها","https://www.aldiwan.net/poem27202.html","الكامل"],[46,"كم أمة لعبت بها جهالها","https://www.aldiwan.net/poem22346.html","الكامل"],[46,"يا ثالث الثنيين في خمسة","https://www.aldiwan.net/poem22957.html","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39548","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55097","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54762","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54308","الخفيف"],[106,"زفاف الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179500",""],[90,"ستالينغراد","https://www.poetsgate.com/ViewPoem.aspx?id=179193",""],[90,"إلى الشباب السوري","https://www.poetsgate.com/ViewPoem.aspx?id=179164",""],[45,"يا ثقيلاً على القلوب إذا ع","https://www.poetsgate.com/ViewPoem.aspx?id=31324",""],[46,"كم أمّةٍ لعبتْ بها جُهّالُها،","https://www.poetsgate.com/ViewPoem.aspx?id=18037",""],[31,"يا ثُرَيَّا الفُؤادِ رُدّي السِّلاَمَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19065&r=&rc=328",""],[115,"هيج البعد هواها","https://www.aldiwan.net/poem40431.html","عموديه"],[115,"كر الجديدين تبدو منه الوان","https://www.aldiwan.net/poem40479.html","عموديه"],[120,"يا حسن واحسرتا على غرر","https://www.aldiwan.net/poem49263.html","المنسرح"],[132,"هاج ما اكتن من دفين الدار","https://www.aldiwan.net/poem54898.html","البسيط"],[142,"نبئت أن فلانا قد شحا فمه","https://www.aldiwan.net/poem58395.html","البسيط"],[169,"ما أنصف الطلل العافي بماوانا","https://www.aldiwan.net/poem1685.html",""],[185,"يا ساحل الثغر كم لي فيك من أرب","https://www.aldiwan.net/poem14109.html","البسيط"],[185,"ياثالث القمرين حسبك أنني","https://www.aldiwan.net/poem14111.html","الكامل"],[197,"غادة حطم الفؤاد بكاها","https://www.aldiwan.net/poem39820.html","الخفيف"],[198,"يا ثاويا بضلوعي ما يفارقها","https://www.aldiwan.net/poem51929.html","البسيط"],[199,"كتابها قد جاءني حاملا","https://www.aldiwan.net/poem45147.html","السريع"],[261,"لو لم أطل أمل التلاق","https://www.aldiwan.net/poem38226.html","مجزوء الكامل"],[298,"إن كان للموت حتما كل مولود","https://www.aldiwan.net/poem36254.html","عموديه"],[303,"يا ثغره ليس الثنايا التي","https://www.aldiwan.net/poem57965.html","السريع"],[305,"يا ثغر حييت بالمرابط","https://www.aldiwan.net/poem56489.html","مخلع البسيط"],[305,"خير حام مجير عبد المجيد","https://www.aldiwan.net/poem56552.html","الطويل"],[305,"خير حام مجد مجير العبيد","https://www.aldiwan.net/poem56553.html","الخفيف"],[320,"عاد العزيز فاهلا","https://www.aldiwan.net/poem67227.html","المجتث"],[328,"هات الدموع فأنت شاعر","https://www.aldiwan.net/poem55048.html","مجزوء الكامل"],[356,"زارت وليل غطمطم الظلما دجا","https://www.aldiwan.net/poem24535.html","الكامل"],[371,"يا ثالث القمرين النيرين أرى","https://www.aldiwan.net/poem56942.html","البسيط"],[388,"يا ثقاتي نقل الأعداء","https://www.aldiwan.net/poem3690.html","مجزوء الرمل"],[393,"يا ثنويا لج في حكمه","https://www.aldiwan.net/poem53684.html","السريع"],[409,"يا ثانيا للنفس وهو","https://www.aldiwan.net/poem32283.html","مجزوء الكامل"],[417,"يا ثغره من صدغه وبناظر","https://www.aldiwan.net/poem4104.html","الكامل"],[432,"لا تثن جيدك إن الروض قد جيدا","https://www.aldiwan.net/poem12586.html","البسيط"],[432,"لو حل عن خديه عقد لثامه","https://www.aldiwan.net/poem12734.html","الكامل"],[439,"يا غياث العباد إن بخل المز","https://www.aldiwan.net/poem34805.html","الخفيف"],[441,"الرزء أفجع لو أطلت بكائي","https://www.aldiwan.net/poem14434.html","الكامل"],[441,"هذا هو الرزء الجن والبشرا","https://www.aldiwan.net/poem14454.html","البسيط"],[443,"يا ثلج في مصبحي وفي غسقي","https://www.aldiwan.net/poem56012.html","عموديه"],[458,"ذكر العيش بالحمى فبكى له","https://www.aldiwan.net/poem55940.html","الخفيف"],[458,"ما بعد يومك سلوة لمعلل","https://www.aldiwan.net/poem55988.html","الكامل"],[458,"ما للدسوت وللسروج تسائل","https://www.aldiwan.net/poem56069.html","الكامل"],[466,"يا ثور لا تشتمن عرضي فداك أبي","https://www.aldiwan.net/poem50422.html","البسيط"],[479,"لله يا ثغر زانك الشنب","https://www.aldiwan.net/poem37063.html","المنسرح"],[479,"يا ثابت الراي في الأعمال تجريها","https://www.aldiwan.net/poem37595.html","البسيط"],[479,"في الجد أو في اللعب","https://www.aldiwan.net/poem37612.html","مجزوء الرجز"],[551,"يا ثاويا خلف الرتاج المطبق","https://www.aldiwan.net/poem47356.html","الكامل"],[562,"جاد الزمان بنعمة متصدقا","https://www.aldiwan.net/poem52797.html","الكامل"],[575,"أصبحت بعدك في الحياة كفان","https://www.aldiwan.net/poem2773.html","الكامل"],[575,"يا ثالث العمرين علماً","https://www.aldiwan.net/poem3011.html","مجزوء الكامل"],[586,"يا ثغره المحمي منه بنابل","https://www.aldiwan.net/poem17984.html","الكامل"]],"verses":[["يا ثانِياً لِلنَفسِ بَل","يا ثالِثَ العَينَينِ عِزّا",0,"ز",2,0],["يا ثاوِياً بطْنَ الضّريحِ وذكْرُهُ","أبَداً رَفيقُ رَكائِبٍ ورِفاقِ",1,"ق",1,0],["يا ثُكْلَ تلكَ الصّمّاءِ أمِّهِمُ","وظاعِنُ الموْتِ غيرُ منتَظِرِ",2,"ر",1,0],["يا ثَروَةَ القُرّاءِ مِن عِلمٍ وَمِن","فَضلٍ وَمِن حِكَمٍ وَمِن آدابِ",3,"ب",1,0],["يا ثَلطَ حامِضَةٍ تَرَوَّحَ أَهلُها","عَن ماسِطٍ وَتَنَدَّتِ القُلّاما",4,"م",2,0],["يا ثاوياً والثَّنى والحمدُ ينشرهُ","بقيتَ أنتَ وأفنتْنا يدُ الكرب",5,"ب",1,0],["يا ثاني العطف من تيهٍ ومن غضبٍ","حتَّى كأنيَ قلت الغصن ثانيه",6,"ي",2,0],["يا ثوبَهُ الأزرقَ الذي قد","فاقَ العِراقيَّ في السناءِ",7,"ا",2,1],["يا ثقيلاً على القلوب خفيفاً","في الموازين دون وزن النقير",8,"ر",1,0],["يا ثلج ماء مالح فيه جِيَف","يا خزف التنور يا شر الخزف",9,"ف",1,0],["يا ثقيلَ القرونِ يا جبلَ العا","رِ أما يستفزك التحريكُ",10,"ك",1,0],["يا ثمالَ المؤمِّلينَ أبا إس","حاقَ عندَ انقطاع كلِّ ثمالِ",11,"ل",1,0],["يا ثقيلَ الثِّقالِ أقذيتَ عَيْني","ليتَ أنِّي كما أراك تراني",12,"ن",2,0],["يا ثلج ماءٍ مالح آسنٍ","فاض من الحمَّام في الجيَّهْ",13,"ي",2,1],["يا ثَقيلاً لِيَ مِن رُؤ","يَتِهِ هَمٌّ طَويلُ",14,"ل",1,1],["يا ثَرى النيلِ في نَواحيكَ طَيرٌ","كانَ دُنيا وَكانَ فَرحَةَ جيلِ",15,"ل",1,1],["يا ثَروَةَ الوَطَنِ الغالي كَفى عِظَةً","لِلناسِ أَنَّكَ كَنزٌ في الثَرى بَدَدُ",16,"د",1,0],["يا ثَغرَها أَمسَيتُ كَال","غَوّاصِ أَحلُمُ بِالجَواهِر",17,"ر",1,0],["يا ثِمالَ الدُنيا عَطاءً وَبَذلاً","وَجَمالَ الدُنيا سَناءً وَمَجدا",18,"د",2,0],["يا ثَقيلاً عَلى القُلوبِ إِذا عَن","نَ لَها أَيقَنَت بِطولِ الجِهادِ",19,"د",1,1],["يا ثاقُ خُبّي بِنا وَلا تَعدي","نَفسَكِ مِمّا تَرَينَ راحاتِ",20,"ت",1,0],["يا ثِقلَ صورَتِهِ وَخِفَّةَ رَأسِهِ","هَلّا نَقَلتِ إِلى هُنا مِن هاهُنا",21,"ن",2,0],["يا ثانيَ البَدْرِ في تَكامُلِهِ","ها أنا في القَسْمِ للسُّها ثانِ",22,"ن",1,0],["يا ثانيَ المختارِ في غارِهِ","وقبرهِ الزاكي وفي الحكمِ",23,"م",1,0],["يا ثُرَيّا الفُؤادِ رُدّي السَلاما","وَصِلينا وَلا تَبُتّي الزِمامَ",24,"م",1,1],["يا ثالِثَ الوُزَراءِ كَم مِن حَلقَةٍ","لِلكَربِ وَالأَحزانِ قَد فَرَّجتَها",25,"ت",3,0],["يا ثُلَّةً في غَفلَةٍ وَأُوَيسُها ال","القَرَنِيُّ مِثلُ أُوَيسِها أَي ذيبِها",26,"ب",3,0],["يا ثالِثَ الثِنيَينِ في خَمسَةٍ","إِربَع لِكَي تَستَخيرَ الأَربُعا",27,"ع",2,1],["يا ثورةً مشبوبةَ النَّارِ","أقلقت جسم الكائنِ الحيِّ",28,"ي",1,0],["يَا ثَاكِلاً بَعْضَهُ","مَسَّ الرَّدَى أَجْمَعَك",29,"ك",1,0],["يَا ثَالِثَ الأخَوَيْنِ كَمْ مُتَخَلِّفٍ","فِيهِ كِفَاءُ الْمَجْدِ وَهْوَ وَحِيدُ",30,"د",1,0],["يا ثَقِيلَ الظِلال آذَيْتَ بِالْما","لِ وَبالنَّفْسِ فَالرحِيلَ الرَحيلاَ",31,"ل",2,0],["يا ثالثَ العُمَرين، أنت أريتنا","بالعين ما يُرْوى عن الزهَّاد",32,"د",1,0],["يا ثرياً وهبَ الناسَ الثراء","قُمْ ترَ الناسَ جميعا أثرياء",33,"ا",2,0],["يا ثورةً قرَّبَ الظلمُ اللِّقاحَ بها","سيلمسُ المتجِّني شرَّ ما تضع",34,"ع",1,0],["يا ثقيلاً على القلوب إذا ع","ن لها أيقنت بطول الجهاد",35,"د",1,1],["يا ثُلّةً في غفلةٍ، وأُوَيسُها ال","قَرَنيُّ مثلُ أُوَيسها، أي ذيبها",36,"ب",3,0],["يا ثُرَيَّا الفُؤادِ رُدّي السِّلاَمَا","وصلينا، ولا تبتي الزماما",37,"م",2,1],["يا ثرى ما شمل الع","لة الا وشفاها",38,"ا",3,0],["يا ثالث الخلفاء الزهر خذ بيدي","وارحم حنيني فللايام عدوان",39,"ن",1,0],["يا ثاني العطف بعض زهوك إن","العيش وردٌ مرنق الصدر",40,"ر",1,0],["يا ثِمَالَ الأيتَامِ والناسِ طُرّاً","يَا مُفِيضَ الآلاءِ في اللاَّوَاءِ",41,"ا",2,0],["يا ثورُ خلِّ لروضِ الحَزِن زهرتَهُ","فإنّ مرعاكَ قُلاّمٌ وطُبّاقُ",42,"ق",1,0],["يا ثُكلَ أُمِّ العِدى وَالمَكرُماتِ أَما","لَو يَنطِقُ الدَهرُ عَزّاها وَعَزّانا",43,"ن",2,0],["يا ثغرَ لَهْوِى وثَغراً كنتُ أَرشفُه","بُكاىَ من كلِّ ثَغرٍ ظلَّ يلعبُ بي",44,"ب",2,0],["ياثالثَ القَمريْن حَسْبُك أنني","أصبحتُ ثالث عاذلٍ ورقيبِ",45,"ب",1,1],["يا ثريا قضوا عليك فواها","يا ثريا على شبابك واها",46,"ا",3,0],["يا ثاوياً بضلوعي ما يُفارقُها","وإنْ تَحَمَّلَ عن أكنافِ أَربُعِهِ",47,"ه",1,1],["يا ثغرها فيك نسيم الندى","فكيف قلبي في نداك احترق",48,"ق",1,0],["يا ثالث القمرين إلا في","الكسوف وفي المحاق",49,"ق",1,0],["يا ثاقبَ الرأْي في (الشورى) إذا أَفنتْ","آراءُ أَهليه أَضحى غيرَ مردود",50,"د",1,0],["يا ثغره ليس الثنايا التي","تبسم غيرَ الأنجمِ الغر",51,"ر",1,1],["يا ثغرُ حيّيت بِالمُرابِط","كَم لَك مِن حاسدٍ وغابِط",52,"ط",1,1],["يا ثِمالَ نَجوى صريعٍ برجسٍ","نَصر جفٍّ ربل ثمال الوجودِ",53,"د",1,0],["يا ثِمالَ رجعٍ بِنجوى نصير","لِصريعٍ برثدِ مجنى نجيدِ",54,"د",1,0],["يا ثَغرُ بادِر وَقَبِّل","مَواطِئَ الأَقدامِ",55,"م",1,0],["يا ثقل ما حملته","منها على مر السنين",56,"ن",1,0],["يا ثالث البدرين يا طرف الورى","يا زاخرا حفّت نجومك بالرجا",57,"ج",2,0],["يا ثالِثَ القَمَرَين النَّيِّرين أرَى","أمامَ حالي سَواداً ما لَه هادِي",58,"ي",1,1],["يا ثِقاتي نَقَل الأَع","داءُ لي عنكم وَعنّي",59,"ن",2,1],["يا ثَنَويّاً لَجَّ في حُكمِهِ","يَقولُ أَصلُ العالَمِ اِثنانِ",60,"ن",1,1],["يَا ثَانياً للنَّفسِ وهْ","وَ لِنَاظِرَيَّ أعزُّ ثَالِثْ",61,"ث",1,1],["يا ثَغَره من صُدغه وبناظرٍ","من طَرفه وبسائف من خَدِّه",62,"د",2,1],["يا ثعلبَ الفجرِ لا سرحانَ أوله","خذ الثريا فقد صادفتَ عنقودا",63,"د",2,0],["يا ثغرَهُ سِرْ فيّ سيرةَ كأسِه","ورضابِه خُذْ فيّ أخذَ مُدامِه",64,"م",2,0],["يا ثِمالَ العُفاةِ يَا مَلِكَ الدُّنْ","يا ومن فازَ بالغِنى آمِلُوهُ",65,"و",2,0],["يا ثلمة وقعت ولا جبر لها","كتجبّر الأَعضاء بالأَعضاء",66,"ا",2,0],["يا ثلمة وقعت في الدين فاغرة","وها هو الكسر في الاسلام ما جبرا",67,"ر",2,0],["يا ثلج في مصبحي وفي غسقي","يا ثلج في مفرقي وفي طرقي",68,"ق",2,1],["يا ثقاتي على الغرام وأحلا","فيَ في طاعة الصبا والبطالة",69,"ل",2,0],["يا ثاوياً وسَّدتُ 