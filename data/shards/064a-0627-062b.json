انقطاع كلِّ ثمالِ",11,"ل",1,0],["يا ثقيلَ الثِّقالِ أقذيتَ عَيْني","ليتَ أنِّي كما أراك تراني",12,"ن",2,0],["يا ثلج ماءٍ مالح آسنٍ","فاض من الحمَّام في الجيَّهْ",13,"ي",2,1],["يا ثَقيلاً لِيَ مِن رُؤ","يَتِهِ هَمٌّ طَويلُ",14,"ل",1,1],["يا ثَرى النيلِ في نَواحيكَ طَيرٌ","كانَ دُنيا وَكانَ فَرحَةَ جيلِ",15,"ل",1,1],["يا ثَروَةَ الوَطَنِ الغالي كَفى عِظَةً","لِلناسِ أَنَّكَ كَنزٌ في الثَرى بَدَدُ",16,"د",1,0],["يا ثَغرَها أَمسَيتُ كَال","غَوّاصِ أَحلُمُ بِالجَواهِر",17,"ر",1,0],["يا ثِمالَ الدُنيا عَطاءً وَبَذلاً","وَجَمالَ الدُنيا سَناءً وَمَجدا",18,"د",2,0],["يا ثَقيلاً عَلى القُلوبِ إِذا عَن","نَ لَها أَيقَنَت بِطولِ الجِهادِ",19,"د",1,1],["يا ثاقُ خُبّي بِنا وَلا تَعدي","نَفسَكِ مِمّا تَرَينَ راحاتِ",20,"ت",1,0],["يا ثِقلَ صورَتِهِ وَخِفَّةَ رَأسِهِ","هَلّا نَقَلتِ إِلى هُنا مِن هاهُنا",21,"ن",2,0],["يا ثانيَ البَدْرِ في تَكامُلِهِ","ها أنا في القَسْمِ للسُّها ثانِ",22,"ن",1,0],["يا ثانيَ المختارِ في غارِهِ","وقبرهِ الزاكي وفي الحكمِ",23,"م",1,0],["يا ثُرَيّا الفُؤادِ رُدّي السَلاما","وَصِلينا وَلا تَبُتّي الزِمامَ",24,"م",1,1],["يا ثالِثَ الوُزَراءِ كَم مِن حَلقَةٍ","لِلكَربِ وَالأَحزانِ قَد فَرَّجتَها",25,"ت",3,0],["يا ثُلَّةً في غَفلَةٍ وَأُوَيسُها ال","القَرَنِيُّ مِثلُ أُوَيسِها أَي ذيبِها",26,"ب",3,0],["يا ثالِثَ الثِنيَينِ في خَمسَةٍ","إِربَع لِكَي تَستَخيرَ الأَربُعا",27,"ع",2,1],["يا ثورةً مشبوبةَ النَّارِ","أقلقت جسم الكائنِ الحيِّ",28,"ي",1,0],["يَا ثَاكِلاً بَعْضَهُ","مَسَّ الرَّدَى أَجْمَعَك",29,"ك",1,0],["يَا ثَالِثَ الأخَوَيْنِ كَمْ مُتَخَلِّفٍ","فِيهِ كِفَاءُ الْمَجْدِ وَهْوَ وَحِيدُ",30,"د",1,0],["يا ثَقِيلَ الظِلال آذَيْتَ بِالْما","لِ وَبالنَّفْسِ فَالرحِيلَ الرَحيلاَ",31,"ل",2,0],["يا ثالثَ العُمَرين، أنت أريتنا","بالعين ما يُرْوى عن الزهَّاد",32,"د",1,0],["يا ثرياً وهبَ الناسَ الثراء","قُمْ ترَ الناسَ جميعا أثرياء",33,"ا",2,0],["يا ثورةً قرَّبَ الظلمُ اللِّقاحَ بها","سيلمسُ المتجِّني شرَّ ما تضع",34,"ع",1,0],["يا ثقيلاً على القلوب إذا ع","ن لها أيقنت بطول الجهاد",35,"د",1,1],["يا ثُلّةً في غفلةٍ، وأُوَيسُها ال","قَرَنيُّ مثلُ أُوَيسها، أي ذيبها",36,"ب",3,0],["يا ثُرَيَّا الفُؤادِ رُدّي السِّلاَمَا","وصلينا، ولا تبتي الزماما",37,"م",2,1]]}