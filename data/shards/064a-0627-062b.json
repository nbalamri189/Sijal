://www.poetsgate.com/ViewPoem.aspx?id=122798",""],[5829,"درة الدهر الشآم","https://www.poetsgate.com/ViewPoem.aspx?id=152342",""],[5829,"لقاء","https://www.poetsgate.com/ViewPoem.aspx?id=175183",""],[5829,"شيء من الاحلامِ","https://www.poetsgate.com/ViewPoem.aspx?id=213519",""],[5842,"كي لا ينضب الماءُ","https://www.poetsgate.com/ViewPoem.aspx?id=73684",""],[5847,"إشراقة وطن","https://www.poetsgate.com/ViewPoem.aspx?id=176962",""],[5895,"دُمُوع ُالأَقْصَى","https://www.poetsgate.com/ViewPoem.aspx?id=202143",""],[5943,"كيفَ الرُّكون إلى السلامِ","https://www.poetsgate.com/ViewPoem.aspx?id=11285",""],[5956,"صعبٌ عليكِ تُفارقين حبيبا","https://www.poetsgate.com/ViewPoem.aspx?id=194464",""],[5956,"يا من تُسَمِّي أجملَ الأسماءِ","https://www.poetsgate.com/ViewPoem.aspx?id=205262",""],[5986,"عوفيت إذ عوفي بك الكرم","https://www.poetsgate.com/ViewPoem.aspx?id=162959",""],[5994,"بوغاز","https://www.poetsgate.com/ViewPoem.aspx?id=184585",""],[6078,"وتنفّسَتِ الحرّيّةُ","https://www.poetsgate.com/ViewPoem.aspx?id=204015",""],[6102,"ثغر","https://www.poetsgate.com/ViewPoem.aspx?id=183322",""],[6102,"حالة استسلام","https://www.poetsgate.com/ViewPoem.aspx?id=183613",""],[6127,"يا ثورة الآس","https://www.poetsgate.com/ViewPoem.aspx?id=205889",""],[6142,"يا أول الناس للإسلام مرتبة","https://www.poetsgate.com/ViewPoem.aspx?id=155742",""],[6152,"ثوب يوسف","https://www.poetsgate.com/ViewPoem.aspx?id=203032",""],[6200,"غَابَةُ الأَطْفالِ وَ الحِجَارَة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81373&r=&rc=15",""],[6210,"ألق السلام على القباب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78228&r=&rc=20",""],[6235,"تراتيل الليل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77691&r=&rc=6",""],[406,"أما لهذا الليل من آخر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63269&r=&rc=73",""],[2638,"بغداد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87865&r=&rc=22",""]],"verses":[["يا ثانِياً لِلنَفسِ بَل","يا ثالِثَ العَينَينِ عِزّا",0,"ز",2,0],["يا ثاوِياً بطْنَ الضّريحِ وذكْرُهُ","أبَداً رَفيقُ رَكائِبٍ ورِفاقِ",1,"ق",1,0],["يا ثُكْلَ تلكَ الصّمّاءِ أمِّهِمُ","وظاعِنُ الموْتِ غيرُ منتَظِرِ",2,"ر",1,0],["يا ثَروَةَ القُرّاءِ مِن عِلمٍ وَمِن","فَضلٍ وَمِن حِكَمٍ وَمِن آدابِ",3,"ب",1,0],["يا ثَلطَ حامِضَةٍ تَرَوَّحَ أَهلُها","عَن ماسِطٍ وَتَنَدَّتِ القُلّاما",4,"م",2,0],["يا ثاوياً والثَّنى والحمدُ ينشرهُ","بقيتَ أنتَ وأفنتْنا يدُ الكرب",5,"ب",1,0],["يا ثاني العطف من تيهٍ ومن غضبٍ","حتَّى كأنيَ قلت الغصن ثانيه",6,"ي",2,0],["يا ثوبَهُ الأزرقَ الذي قد","فاقَ العِراقيَّ في السناءِ",7,"ا",2,1],["يا ثقيلاً على القلوب خفيفاً","في الموازين دون وزن النقير",8,"ر",1,0],["يا ثلج ماء مالح فيه جِيَف","يا خزف التنور يا شر الخزف",9,"ف",1,0],["يا ثقيلَ القرونِ يا جبلَ العا","رِ أما يستفزك التحريكُ",10,"ك",1,0],["يا ثمالَ المؤمِّلينَ أبا إس","حاقَ عندَ انقطاع كلِّ ثمالِ",11,"ل",1,0],["يا ثقيلَ الثِّقالِ أقذيتَ عَيْني","ليتَ أنِّي كما أراك تراني",12,"ن",2,0],["يا ثلج ماءٍ مالح آسنٍ","فاض من الحمَّام في الجيَّهْ",13,"ي",2,1],["يا ثَقيلاً لِيَ مِن رُؤ","يَتِهِ هَمٌّ طَويلُ",14,"ل",1,1],["يا ثَرى النيلِ في نَواحيكَ طَيرٌ","كانَ دُنيا وَكانَ فَرحَةَ جيلِ",15,"ل",1,1],["يا ثَروَةَ الوَطَنِ الغالي كَفى عِظَةً","لِلناسِ أَنَّكَ كَنزٌ في الثَرى بَدَدُ",16,"د",1,0],["يا ثَغرَها أَمسَيتُ كَال","غَوّاصِ أَحلُمُ بِالجَواهِر",17,"ر",1,0],["يا ثِمالَ الدُنيا عَطاءً وَبَذلاً","وَجَمالَ الدُنيا سَناءً وَمَجدا",18,"د",2,0],["يا ثَقيلاً عَلى القُلوبِ إِذا عَن","نَ لَها أَيقَنَت بِطولِ الجِهادِ",19,"د",1,1],["يا ثاقُ خُبّي بِنا وَلا تَعدي","نَفسَكِ مِمّا تَرَينَ راحاتِ",20,"ت",1,0],["يا ثِقلَ صورَتِهِ وَخِفَّةَ رَأسِهِ","هَلّا نَقَلتِ إِلى هُنا مِن هاهُنا",21,"ن",2,0],["يا ثانيَ البَدْرِ في تَكامُلِهِ","ها أنا في القَسْمِ للسُّها ثانِ",22,"ن",1,0],["يا ثانيَ المختارِ في غارِهِ","وقبرهِ الزاكي وفي الحكمِ",23,"م",1,0],["يا ثُرَيّا الفُؤادِ رُدّي السَلاما","وَصِلينا وَلا تَبُتّي الزِمامَ",24,"م",1,1],["يا ثالِثَ الوُزَراءِ كَم مِن حَلقَةٍ","لِلكَربِ وَالأَحزانِ قَد فَرَّجتَها",25,"ت",3,0],["يا ثُلَّةً في غَفلَةٍ وَأُوَيسُها ال","القَرَنِيُّ مِثلُ أُوَيسِها أَي ذيبِها",26,"ب",3,0],["يا ثالِثَ الثِنيَينِ في خَمسَةٍ","إِربَع لِكَي تَستَخيرَ الأَربُعا",27,"ع",2,1],["يا ثورةً مشبوبةَ النَّارِ","أقلقت جسم الكائنِ الحيِّ",28,"ي",1,0],["يَا ثَاكِلاً بَعْضَهُ","مَسَّ الرَّدَى أَجْمَعَك",29,"ك",1,0],["يَا ثَالِثَ الأخَوَيْنِ كَمْ مُتَخَلِّفٍ","فِيهِ كِفَاءُ الْمَجْدِ وَهْوَ وَحِيدُ",30,"د",1,0],["يا ثَقِيلَ الظِلال آذَيْتَ بِالْما","لِ وَبالنَّفْسِ فَالرحِيلَ الرَحيلاَ",31,"ل",2,0],["يا ثالثَ العُمَرين، أنت أريتنا","بالعين ما يُرْوى عن الزهَّاد",32,"د",1,0],["يا ثرياً وهبَ الناسَ الثراء","قُمْ ترَ الناسَ جميعا أثرياء",33,"ا",2,0],["يا ثورةً قرَّبَ الظلمُ اللِّقاحَ بها","سيلمسُ المتجِّني شرَّ ما تضع",34,"ع",1,0],["يا ثقيلاً على القلوب إذا ع","ن لها أيقنت بطول الجهاد",35,"د",1,1],["يا ثُلّةً في غفلةٍ، وأُوَيسُها ال","قَرَنيُّ مثلُ أُوَيسها، أي ذيبها",36,"ب",3,0],["يا ثُرَيَّا الفُؤادِ رُدّي السِّلاَمَا","وصلينا، ولا تبتي الزماما",37,"م",2,1],["يا ثرى ما شمل الع","لة الا وشفاها",38,"ا",3,0],["يا ثالث الخلفاء الزهر خذ بيدي","وارحم حنيني فللايام عدوان",39,"ن",1,0],["يا ثاني العطف بعض زهوك إن","العيش وردٌ مرنق الصدر",40,"ر",1,0],["يا ثِمَالَ الأيتَامِ والناسِ طُرّاً","يَا مُفِيضَ الآلاءِ في اللاَّوَاءِ",41,"ا",2,0],["يا ثورُ خلِّ لروضِ الحَزِن زهرتَهُ","فإنّ مرعاكَ قُلاّمٌ وطُبّاقُ",42,"ق",1,0],["يا ثُكلَ أُمِّ العِدى وَالمَكرُماتِ أَما","لَو يَنطِقُ الدَهرُ عَزّاها وَعَزّانا",43,"ن",2,0],["يا ثغرَ لَهْوِى وثَغراً كنتُ أَرشفُه","بُكاىَ من كلِّ ثَغرٍ ظلَّ يلعبُ بي",44,"ب",2,0],["ياثالثَ القَمريْن حَسْبُك أنني","أصبحتُ ثالث عاذلٍ ورقيبِ",45,"ب",1,1],["يا ثريا قضوا عليك فواها","يا ثريا على شبابك واها",46,"ا",3,0],["يا ثاوياً بضلوعي ما يُفارقُها","وإنْ تَحَمَّلَ عن أكنافِ أَربُعِهِ",47,"ه",1,1],["يا ثغرها فيك نسيم الندى","فكيف قلبي في نداك احترق",48,"ق",1,0],["يا ثالث القمرين إلا في","الكسوف وفي المحاق",49,"ق",1,0],["يا ثاقبَ الرأْي في (الشورى) إذا أَفنتْ","آراءُ أَهليه أَضحى غيرَ مردود",50,"د",1,0],["يا ثغره ليس الثنايا التي","تبسم غيرَ الأنجمِ الغر",51,"ر",1,1],["يا ثغرُ حيّيت بِالمُرابِط","كَم لَك مِن حاسدٍ وغابِط",52,"ط",1,1],["يا ثِمالَ نَجوى صريعٍ برجسٍ","نَصر جفٍّ ربل ثمال الوجودِ",53,"د",1,0],["يا ثِمالَ رجعٍ بِنجوى نصير","لِصريعٍ برثدِ مجنى نجيدِ",54,"د",1,0],["يا ثَغرُ بادِر وَقَبِّل","مَواطِئَ الأَقدامِ",55,"م",1,0],["يا ثقل ما حملته","منها على مر السنين",56,"ن",1,0],["يا ثالث البدرين يا طرف الورى","يا زاخرا حفّت نجومك بالرجا",57,"ج",2,0],["يا ثالِثَ القَمَرَين النَّيِّرين أرَى","أمامَ حالي سَواداً ما لَه هادِي",58,"ي",1,1],["يا ثِقاتي نَقَل الأَع","داءُ لي عنكم وَعنّي",59,"ن",2,1],["يا ثَنَويّاً لَجَّ في حُكمِهِ","يَقولُ أَصلُ العالَمِ اِثنانِ",60,"ن",1,1],["يَا ثَانياً للنَّفسِ وهْ","وَ لِنَاظِرَيَّ أعزُّ ثَالِثْ",61,"ث",1,1],["يا ثَغَره من صُدغه وبناظرٍ","من طَرفه وبسائف من خَدِّه",62,"د",2,1],["يا ثعلبَ الفجرِ لا سرحانَ أوله","خذ الثريا فقد صادفتَ عنقودا",63,"د",2,0],["يا ثغرَهُ سِرْ فيّ سيرةَ كأسِه","ورضابِه خُذْ فيّ أخذَ مُدامِه",64,"م",2,0],["يا ثِمالَ العُفاةِ يَا مَلِكَ الدُّنْ","يا ومن فازَ بالغِنى آمِلُوهُ",65,"و",2,0],["يا ثلمة وقعت ولا جبر لها","كتجبّر الأَعضاء بالأَعضاء",66,"ا",2,0],["يا ثلمة وقعت في الدين فاغرة","وها هو الكسر في الاسلام ما جبرا",67,"ر",2,0],["يا ثلج في مصبحي وفي غسقي","يا ثلج في مفرقي وفي طرقي",68,"ق",2,1],["يا ثقاتي على الغرام وأحلا","فيَ في طاعة الصبا والبطالة",69,"ل",2,0],["يا ثاوياً وسَّدتُ منه في الثرى","عَلَماً يطول به البقاءُ وإن بَلي",70,"ل",2,0],["يا ثاوياً لم تقض حقَّ مصابه","كِبدٌ محرّقة وجفنٌ هاملُ",71,"ل",1,0],["يا ثَورُ لا تَشتُمَن عِرضي فِداكَ أَبي","فَإِنَّما الشَتمُ لِلقَومِ العَواويرِ",72,"ر",1,1],["يا ثغر يا ثغر أنت لؤلؤة","في الكوثر العذب إيه ما السبب",73,"ب",1,0],["يا ثابت الراي في الأعمال تجريها","عن حكمة بلغت أقصى أقاصيها",74,"ي",3,1],["يا ثاني الفرسان في الم","يدان يا ذاك الصبي",75,"ب",2,0],["يا ثاوِياً خَلفَ الرّتاجِ المُطْبقِ","أَعزز عليَّ بِأنّنا لا نلتقي",76,"ق",2,1],["يا ثغرَ بيروتَ ابتسمْ متهلِلاً","وليَبتهجْ شَجَرُ الغياضِ مُصفِّقا",77,"ق",2,0],["يا ثالثَ القَمرَيْنِ حُسناً قد بكى","حزناً لأَجْل مُصابِكَ القَمَرَانِ",78,"ن",1,0],["يا ثالِثَ العُمَرينِ عِلْماً","أَنا ثالثُ الخصريْنِ سُقْماً",79,"م",2,1],["يا ثَغْرَهُ المَحْمِي