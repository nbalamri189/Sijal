رجز"],[3642,"","https://poetry.dctabudhabi.ae/diwan/poem/203454","الطويل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66463","الطويل"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118760","المجتث"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91601","الوافر"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91587","الطويل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117842","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131292",""],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59496","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59466","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59511","البسيط"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35590","المنسرح"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77067","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77089","الطويل"],[3957,"","https://poetry.dctabudhabi.ae/diwan/poem/139422",""],[3992,"","https://poetry.dctabudhabi.ae/diwan/poem/73670","السريع"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78308","البسيط"],[4150,"","https://poetry.dctabudhabi.ae/diwan/poem/21556","البسيط"],[4315,"","https://poetry.dctabudhabi.ae/diwan/poem/143040","الطويل"],[4386,"","https://poetry.dctabudhabi.ae/diwan/poem/33826","البسيط"],[4564,"","https://poetry.dctabudhabi.ae/diwan/poem/147635","الطويل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139718",""],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[1012,"أباة الضيم","https://www.poetsgate.com/ViewPoem.aspx?id=186325",""],[1012,"لقد دارت على رغم الحسود","https://www.poetsgate.com/ViewPoem.aspx?id=124956",""],[4578,"زفافٌ لبدر العز بالسعد أشرقا","https://www.poetsgate.com/ViewPoem.aspx?id=49491",""],[4927,"شيخ الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=4577",""],[4929,"الطموا خدكم","https://www.poetsgate.com/ViewPoem.aspx?id=199184",""],[4935,"إلهي فرج الكربا","https://www.poetsgate.com/ViewPoem.aspx?id=129287",""],[5005,"على عين العدل","https://www.poetsgate.com/ViewPoem.aspx?id=198658",""],[5056,"<< نُحاةُ الأدب..>>","https://www.poetsgate.com/ViewPoem.aspx?id=34139",""],[5277,"قبضةُ الغزل","https://www.poetsgate.com/ViewPoem.aspx?id=205047",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[5397,"أيرمي سواد الليل عيني بالغمض","https://www.poetsgate.com/ViewPoem.aspx?id=157930",""],[5397,"أهل بسط كف تحجب الشمس والبدرا","https://www.poetsgate.com/ViewPoem.aspx?id=157931",""],[709,"حتّامَ أسألها الذّنوَّ فتنزَحُ","https://www.poetsgate.com/ViewPoem.aspx?id=2908",""],[5582,"عُوجُوا فَحَيُّوا مَغانِي رَبَّةِ الخالِ","https://www.poetsgate.com/ViewPoem.aspx?id=63561",""],[5660,"ما بَينَ ثائِرَةِ الرِّياحِ السَجسَجِ","https://www.poetsgate.com/ViewPoem.aspx?id=27724",""],[5737,"في فضيلة ليلة القدر","https://www.poetsgate.com/ViewPoem.aspx?id=177809",""],[5845,"حروفُ معانٍ أو عقودُ جواهرِ","https://www.poetsgate.com/ViewPoem.aspx?id=198430",""],[5953,"أوالي النبي وآل النبي","https://www.poetsgate.com/ViewPoem.aspx?id=93808",""],[5956,"أرفرفُ كالطير في رمضانِ","https://www.poetsgate.com/ViewPoem.aspx?id=204409",""],[6046,"فصل لربك وانحر","https://www.poetsgate.com/ViewPoem.aspx?id=36742",""],[6068,"رَأَيْتُ الْشَّوْق يأكُلُ مِن عِقَاليِ -11-","https://www.poetsgate.com/ViewPoem.aspx?id=175789",""],[5190,"وليمة رفضت تناولها أعشاب البحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78294&r=&rc=7",""]],"verses":[["وَأَبْرَحُ ما أَلْقَى رِئاسَةُ عُصْبَةٍ","أَخَسُّ زَمانٍ نالَ مِنِّي زَمانُها",0,"ن",3,0],["وأبْرَحُ ما ألْقاهُ في الحُبِّ رائِعٌ","منَ الشّيبِ بالفَوْدَيْنِ منّي تضرّما",1,"م",2,0],["وأبْرَزَني كرْسيَّ سعْدٍ ومُلْتَقى","بُدورٍ ومَيْداناً لكُلِّ وِدادِ",2,"د",1,0],["وَأَبرَأَتَها لَم يَجرَحِ الكَلمُ عَظمَها","وَلَو غِبتَ عَنها رُبِّعَت ثُمَّ أُمَّتِ",3,"ت",1,0],["وَإِبْرَةٍ لَكِ فِيهَا","آيَاتُ سِحْرٍ حَلاَلِ",4,"ل",1,0],["وَأَبرَهَةَ اِصطادَت صُدورُ رِماحِنا","جِهارَاً وَعُثنونُ العَجاجَةِ أَكدَرُ",5,"ر",1,0],["وَأَبَرنَ مِن بَكرٍ قَبائِلَ جَمَّةً","وَمِنَ الأَراقِمِ قَد أَبَرنَ جُدودا",6,"د",2,0],["وَأُبرِزُ قِدري بِالفَضاءِ قَليلُه","يُرى غَيرَ مَضنونٍ بِهِ وَكَثيرُها",7,"ر",3,0],["وأبرع الناس نطقاً ليس محتفلاً","فكيف حين يراعى فكر محتفل",8,"ل",1,0],["وأبرح شيءٍ فُرقةٌ بعد أُلفةٍ","وفقدُكَ من عُلِّقت بعد التقاربِ",9,"ب",1,0],["وأبَّرتْ على كُلْيب وجسَّا","سٍ جميعاً وحارثٍ وعُبادِهْ",10,"د",2,0],["وَأَبَرنَ قَومَكَ ياجَريرُ وَغَيرَهُم","وَأَبَرنَ مِن حَلَقِ الرِبابِ حِلالا",11,"ل",2,0],["وأبرق في العباب كأن سرا","بأسطول الجزيرة قد أهابا",12,"ب",2,0],["وَأَبرَإِ مَن تَبَرَّأَ مِن عَداءٍ","وَأَنزَهِ مَن تَنَزَّهَ مِن شَماتِ",13,"ت",1,0],["وَأَبرَزَتِ الخُدورُ مُخَبَّآتٍ","يَضَعنَ النَقسَ أَمكِنَةَ الغَوالي",14,"ل",2,0],["وَأَبرَزتُها صَفراءَ تَحسِبُ كَأسَها","غِشاءً مِنَ البَلورِ يَحمِلُ كَهرَبا",15,"ب",2,0],["وَإِبرِقٍ لَهُ نُطقٌ عَجيبٌ","إِذا ما أُرسِلَت مِنهُ السَلافُ",16,"ف",1,1],["وَاِبرِز بِنا لَيسَ العِيانُ كَالخَبَر","فَاِغتَنِم الصَفوَ بِنا قَبلَ الكَدَر",17,"ر",1,0],["وأَبرَزَ مِنها في الزُّجاجَةِ جَوهَراً","نُسائِلُهُ بِالشَّمِّ عن عَرَضِ السُّكرِ",18,"ر",1,0],["وَأَبرَشَتَويمٍ وَالكَذاجِ وَمُلتَقى","سَنابِكِها وَالخَيلُ تَردي وَتَمزَعُ",19,"ع",1,0],["وَأَبرَزتِني لِلناسِ ثُمَّ تَرَكتِني","لَهُم غَرَضاً أُرمى وَأَنتِ سَليمُ",20,"م",1,0],["وأبرحُ ما تَلْقَى النُّفوسُ مِن الرَّدَى","إذا اغترَّ عانٍ أو تمرَّدَ خاضعُ",21,"ع",1,0],["وَأَبرَحُ ما يَجني العَدُوُّ إِذا رَمى","كَأَهون ما يَجني الصديقُ المُسالمُ",22,"م",1,0],["وإبرة الآسي على نفعها","أفعل منها نظرةٌ ساجيه",23,"ي",2,0],["وَأُبرِزوا بِصَعيدٍ مُستَوٍ جُرُزٍ","وَأُنزِلَ العَرشُ وَالميزانُ وَالزُبُرُ",24,"ر",1,0],["وَإِبريقُ شَربٍ قَد أَجَبتُ دُعاتَهُ","كَأَنَّ مُديرَ الراحِ في الكَأسِ دارِجُه",25,"ج",2,0],["وَأَبرَزَ بِكراً مُزَّةَ الطَعمِ قَرقَفاً","صَنيعَةَ دِهقانٍ تَراخى لَهُ العُمرُ",26,"ر",1,0],["وَأَبرَزَها وَقَد بَطِرَت وَصارَت","شَمولاً مِن مُماطَلَةِ الجِمامِ",27,"م",1,0],["وَأَبراراً نَعودُ إِذا غَضِبنا","بِأَحلامٍ رَواجِحَ كَالهِضابِ",28,"ب",1,0],["وَأَبُرُّ مِن شُربِ المَدامَةِ صُفِّنَت","في عَسجَدٍ شُربُ الرَثيئَةِ في العُلَب",29,"ب",1,0],["وأبر منها في موا","صلة المحب بكل حال",30,"ل",1,0],["وأبْرَزَهُ مِن نارِهِ القيْنُ أخْضَراً","كأنْ غِيثَ فيها بالتّلَهّبِ والسَّفع",31,"ع",1,0],["وأَبرَزَها الَحوادِثُ والَمنايا","وأَيُّ مُعَمِّرٍ لا يَبتَلينا",32,"ن",2,0],["وَأَبْرَزَ نَهْدَيْ فَتَاةٍ كِعَا","بٍ بِطَرْفٍ حَيِيٍّ وَوَجْهٍ نَدِي",33,"د",2,0],["وَابرُزْ إِليْهِ مِنَ الزِّحَامِ وَحَيِّهِ","بِتَحِيَّةِ الإِكْبَارِ وَالإِعْجَابِ",34,"ب",1,0],["وَأَبَرَّ النِّسَاءِ زَوْجاً وَأُمَّا","فِي ذَوَاتِ الحِجَى وَطُهْرِ الخِلاَلِ",35,"ل",1,0],["وَأَبرَزَ الطِفلَ ثُمَّ أَلهَمَهُ الن","نجدَينِ رِزقاً نَمى بِهِ وَنَغى",36,"غ",2,0],["وَأُبرِزُ قِدري بِالفَضاءِ قَليلُها","يُرى غَيرَ مَضنونٍ بِهِ وَكَثيرُها",37,"ر",3,0],["وأبرقَ ما بينَ الدُّروبِ سَحابُه","فصابَ ولكنْ صَوبُ بارِقه الدَّمُ",38,"م",1,0],["وابرز نهدي فتاة كعاب","بطرف حي ووجه ندي",39,"د",2,0],["وأبرزُ قدري بالفضاء، قليلها","يرى غير مضمون به، وكثيرها",40,"ر",3,0],["وأبرأتها لم يجرحِ الكلمُ عظمَها","إذا غبت عنها رُبِّعتْ ثمَّ أمَّتِ",41,"ت",1,0],["وابرز مظهر الهادي بطور","تجلت فيه نفحة طورسينا",42,"ن",2,0],["وابرز من خلال الجفن سحرا","يفسر شأنه السحر الحلالا",43,"ل",2,0],["وأبرح ما يكون الوجد يوما","إذا دنت الخيام من الخيام",44,"م",1,0],["وإبرِيقٍ بِهىٍّ فِيهِ شَىُّ","مِنَ التَّصوِيرِ مَومُوقٌ بَهِيُّ",45,"ي",1,1],["وَابرِزِى الوَجهَ إِنَّ ذَينِ شِفَاءٌ","وَمُنًى لِلمُحِبِّ والمُتَمَنِّي",46,"ن",2,0],["وأبرَزَ الشَّمسَ مِن تَحتِ الخِبَاءِ لَنَا","والأنجُمَ الزُّهرَ في بُرجٍ عَلاَ وسَمَا",47,"م",2,0],["وأبرَزُ سَائِسُ الكاسَاتِ كِيلاً","مٍنَ المَفتُولِ جَادَ بِعَرفِ جَادِى",48,"د",2,0],["وأبرأت أدواء الجزائر بعدما","ألمَّ بها خطب من الشرِّ فادح",49,"ح",1,0],["وَأَبرَهَةُ بنُ صَبّاحٍ فَجَعنَا","بِهِ أَصحَابَهُ المُتَجَبِّرِينَا",50,"ن",2,0],["وأبرأَ داءَ الحب في كل منزع","من البغض داءٌ لا يُساغ مريرُ",51,"ر",1,0],["وأبردَ من لَثْم ثَغرِ الحبيب","على مهجة المُستهام الكئيب",52,"ب",1,0],["وَأَبرَحُ ما قاسَيتُهُ أَنَّ مُسقِمي","بِما حَلَّ بي مِن حُبِّهِ غَيرَ حالِمِ",53,"م",1,0],["وَأَبَرُّ ما تَلقاهُ مُع","تَرِفَ الإِساءَةِ مُذنِبا",54,"ب",2,0],["وأبرح ما يكون الشوق يوماً","إذا دنت الديار من الديار",55,"ر",1,0],["وأبرصٍ من بني الزواني","ملمعٍ أبلق اليدين",56,"ن",1,1],["وابر يزتبر بزمن النظم فتحت","قوافيه زهرا في رياض الدفاتر",57,"ر",1,0],["وأُبرِئُ مَن يَشكُو وإن شَفَّنِي الضّنَى","وأنفَع مَنْ يَرجو وإنْ مَسَّنِي الضرُّ",58,"ر",1,0],["وأبرك فيل إبرهة","غداة أراد فلهم",59,"م",1,0],["وأَبرَزتها بطحاءَ مكَّة بعدما","أَصات المنادي بالصَّلاةِ فأعتما",60,"م",2,1],["وابرد غليلَ (أَبي بكر) وَ (صاحبه)","وَواس (عثمانَ) في خطبٍ طغى وَطما",61,"م",2,0],["وَأَبرِد بِها صَدري فإنّك لَم تَزل","أَياديكَ برداً في حَشا كلّ محرورِ",62,"ر",1,0],["وَأَبرزت كفّاً ما رأى الدهرُ درّة","سِواها حَوت بحراً كفى العدم والجدبا",63,"ب",2,0],["وَأبرز منشورٌ كأنّ سطورهُ","أَسارير بشرٍ في جَبين العلى هبّا",63,"ب",2,0],["وأبرزها من قعر أسود مظلم","كإشراق بدر مشرق اللون كالبدر",64,"ر",1,0],["وَأَبرَحُ ما أُكابِدُهُ","مِنَ الإِخوانِ بِالحَسَدِ",65,"د",1,0],["وَأَبرَحُ ما أَلقاهُ أَنَّ مَزارِكُم","قَريبٌ وَلي الزَيارَةُ مانِعُ",66,"ع",1,0],["وَإِبريقُ المُدامِ بِريقٍ فيهِ","وَلَم أَشرَب فَكَيفَ وَجَدتُ سُكرَه",67,"ر",2,0],["وأبرزه جسماً كريماً منزَّهاً","عن الدنس الأصلي والنقص والعَتب",68,"ب",1,0],["وَأَبرح ما يُبلى السُرور فراق ذي","وِداد صَحيح في التَباعُد وَالقُرب",69,"ب",1,0],["وأبرزَهُ في حَلْبَةِ المجدِ والعُلَى","جواداً إذا صَلَّتْ فوارسُها جلَّى",70,"ل",2,0],["وأبرع استهلال قول القائل","عند ابتداء التحبير للرسائل",71,"ل",1,0],["وأَبْرَزَ الموتُ عن مُسْوَدِّ أَوْجُهِهِ","فالصبرُ يَبْعُدُ والأَقرانُ تَزْدَلِفُ",72,"ف",1,0],["وأَبْرَزَتِ الجوزاءُ صدرَ زُمُرُّدٍ","مُحَلَّى بأَفذاذٍ من الدُّرِّ والوَدْعِ",73,"ع",1,0],["وأَبرَزوا كلَّ شبلِ غابٍ","بكُلِّ ذي لبدةٍ هِزَبْرِ",74,"ر",1,0],["وابرا قلوباً كمهت وأفئدة","قد اكتسبت من قبل مبلغه رانا",75,"ن",2,0],["وَأَبرَزَتِ الهَوادِجُ ناعِماتٍ","عَلَيهِنَّ المَجاسِد وَالعُقودُ",76,"د",1,0],["وأبرُّهم من كان عنه مُوَقِّيا","حَوباءَهُ فوق الفراش وفاديا",77,"ي",2,0],["وأبرأُ ممن يعاديكُمُ","فإن البراءةَ أصلُ الولا",78,"ل",2,0],["وابرزها بيضاءَ تنصُفُ كفَّه","وميضاً ترى وجهَ الغنى فيه مشرِقا",79,"ق",2,0],["وابرز لهم جَلْداً وغصنُك مصفِرٌ","تنفي الشماتة في اهتزاز وريقِ",80,"ق",1,0],["وأبرحُ من فقده أنّني","أظنُّ الأراكةَ عنّي تعِي",81,"ع",2,0],["وأُبرمُ فيهمُ مِدَحاً مِتاناً","فتلقاها معايبهم بنقضِ",82,"ض",1,0],["وأبرحُ من تعنيسها وهي أيِّمٌ","إذا غبتَ من يُسمى لها وهي تُخطَبُ",83,"ب",1,0],["وَأَبرَزتَ مِن خِدرِ الإِشارَةِ مَقطَعاً","تَنَزَّهَ طَرفي مِنهُ في حَسَنِ الشَخصِ",84,"ص",1,0],["وَأَبرَزَها عَذراءَ أَحلى مِنَ المَنى","كَشَمسِ الضُحى أَو كَاللَظى المُتَوَقِّدِ",85,"د",1,0],["وَأَبرَزَ مِنهُ في الإِبريقِ راحاً","أَلَذَّ وَردٍ جَنِيٍّ في أَقاحِ",86,"ح",1,0],["وأبرياء اضطهدت","ما للهلال الأحمر",87,"ر",1,0],["وأبرأت بلطفها سقامها","جهراً وداوت منةً عضالها",88,"ل",3,0],["وا بروحي نهْلَةً من خمرِ مَنْ","سكَنَتْ رُوحي المَدى عندَهُمُ",89,"م",1,0],["وأَبرزَ من سُلطانِ نورِ جمالِكُمْ","شُهوداً إلهِيًّا لعينِ المُراقِبِ",90,"ب",1,0],["وأبرقت مواضينا:","تقبَّلوا تعازينا",91,"ن",2,0],["وأبرد مني جوى لوعة","نهت نفس الليل أن يبردا",92,"د",2,0],["وابْرُزْ لِعِلْم الصَّرْفِ في كِسْوَةٍ","كانَتْ عَلَى ظَهْرِ الكِسائي تُرَى",93,"ر",2,0],["وأبْرَزُ ما يَبُوحُ بهِ شجِيٌّ","إلى أَحْبابِهِ بَثٌّ الشَّجَاءِ",94,"ا",2,0],["وابرِ إن لَم تُبارِ واللهُ في عَو","نِ المُجِدِّ الأَقلامَ والأُقوَاما",95,"م",2,0],["وأبرَزَتِ الخَلاعَةُ مِعصَميْها","وباتَ الجَهْلُ ممدُودَ الرِّواقِ",96,"ق",1,0],["وأَبرى مِنك بالبرءِ","قلوباً لأَودَّائك",97,"ك",1,0],["وأَبرأَ الحالَ النحي","فَ بالنَّدى الجسيم",98,"م",1,0],["وأبرّ ابناء إلى آبائهم","نهضوا بما الحب الصحيح يحتم",99,"م",1,0],["وَأَبرِد غَليلي يا خَليلي بِدعوةٍ","تُنَزِّهُ سِرِّي في شُهُودِ جَلِيَّتِي",100,"ي",1,0],["وأبرزت مكنون الجواهر للورى","لأنك بحر ماله من مساحل",101,"ل",1,0],["وأبرزت الكف الخضيب مختماً","وصاغت هلال الأفق طوق نضار",102,"ر",1,0],["وأبرق من لمع السيوف غمامها","فأقطرت من ورد الوريد شفارها",103,"ر",3,0],["وأبرُّ ممن فك أسرى أمة","ترجو لمصرَ الجيش والأسطولا",104,"ل",2,0],["وأبر من سعة القلوب لميت","سعة الديار لسائر الأحياء",105,"ا",2,0],["وأبرَّ أعوان الخليفة حسبُهُ","في الأمر والتدبير منك نصيح",106,"ح",1,0],["وأبر ما تختاره سبباً إلى"