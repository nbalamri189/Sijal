diwan/poem/94327","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133150","الكامل"],[3163,"","https://poetry.dctabudhabi.ae/diwan/poem/123460","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58039","الوافر"],[4718,"ياهاجسي عطني جزيل القصايد","https://www.poetsgate.com/ViewPoem.aspx?id=137250",""],[4729,"يَا خاتَم الأنبياءِ قَاطِبَةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=109461",""],[4767,"سفينة النجاة","https://www.poetsgate.com/ViewPoem.aspx?id=179958",""],[4767,"كف الجود","https://www.poetsgate.com/ViewPoem.aspx?id=198231",""],[4578,"رق النرجس في وجه الرياض","https://www.poetsgate.com/ViewPoem.aspx?id=49456",""],[4858,"هنيئاً ذا التّخرّجُ يا صُهيبُ","https://www.poetsgate.com/ViewPoem.aspx?id=156818",""],[4888,"زف الدماء","https://www.poetsgate.com/ViewPoem.aspx?id=207759",""],[4888,"دمعة البحر","https://www.poetsgate.com/ViewPoem.aspx?id=207760",""],[4927,"يا ليل","https://www.poetsgate.com/ViewPoem.aspx?id=29641",""],[4929,"في طلب دعم صفحة الفيس","https://www.poetsgate.com/ViewPoem.aspx?id=201205",""],[4929,"قراءة دخانية","https://www.poetsgate.com/ViewPoem.aspx?id=207715",""],[4935,"ألا يا نفس ما هذا التواني","https://www.poetsgate.com/ViewPoem.aspx?id=129284",""],[5038,"الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=190147",""],[5213,"حتام تبقى بظهر الغيب محتجبا","https://www.poetsgate.com/ViewPoem.aspx?id=170420",""],[5219,"رفقا معذبتي","https://www.poetsgate.com/ViewPoem.aspx?id=194913",""],[5274,"أشواق دمشقية","https://www.poetsgate.com/ViewPoem.aspx?id=203450",""],[5376,"عادت قريشُ لتعبدَ الصنما","https://www.poetsgate.com/ViewPoem.aspx?id=194868",""],[5377,"تحية الخروج من العزلة","https://www.poetsgate.com/ViewPoem.aspx?id=61892",""],[5387,"أعودُ إليكِ","https://www.poetsgate.com/ViewPoem.aspx?id=53780",""],[5397,"ما لهذا الدهر في الغي تمادى","https://www.poetsgate.com/ViewPoem.aspx?id=157914",""],[5431,"((أني معك!))","https://www.poetsgate.com/ViewPoem.aspx?id=198345",""],[5436,"مهابة التأريخ(جواد بركات علي)","https://www.poetsgate.com/ViewPoem.aspx?id=34913",""],[5444,"نجومُ الأحساء","https://www.poetsgate.com/ViewPoem.aspx?id=205512",""],[5493,". ربيع الشعر .","https://www.poetsgate.com/ViewPoem.aspx?id=197946",""],[5542,"قالوا تطرف جيلنا","https://www.poetsgate.com/ViewPoem.aspx?id=10190",""],[5582,"قِفا صاحِبَيْ نَبْكِ فَقَدْ وَجَبَ البُكا","https://www.poetsgate.com/ViewPoem.aspx?id=187215",""],[2110,"سريت بها والليل داجي الحنادس","https://www.poetsgate.com/ViewPoem.aspx?id=156274",""],[5691,"ثوْر","https://www.poetsgate.com/ViewPoem.aspx?id=206097",""],[5725,"الى فراشة","https://www.poetsgate.com/ViewPoem.aspx?id=178660",""],[5786,"يميناً بها إن كنت للصبّ مُسعِدا","https://www.poetsgate.com/ViewPoem.aspx?id=50660",""],[5829,"نفحات السحر","https://www.poetsgate.com/ViewPoem.aspx?id=152736",""],[5897,"أول الميزان","https://www.poetsgate.com/ViewPoem.aspx?id=157277",""],[5956,"شعرتُ بأني غبارٌ عليك","https://www.poetsgate.com/ViewPoem.aspx?id=182531",""],[5956,"ذهب القطينُ إلى جنازتها","https://www.poetsgate.com/ViewPoem.aspx?id=196839",""],[5956,"حارس الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=206676",""],[5956,"حنينٌ لقرية \"بيت أجنادٍ\" ثم انطفاءُ الحنين","https://www.poetsgate.com/ViewPoem.aspx?id=207910",""],[5956,"لله درُّ الأريحية سامِيا","https://www.poetsgate.com/ViewPoem.aspx?id=208562",""],[5957,"عزة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=177510",""],[5960,"بغدادُ أغلى انتماءاتي","https://www.poetsgate.com/ViewPoem.aspx?id=30808",""],[6031,"أَبا هَاشمٍ أُنهِي إليكَ تحيةً","https://www.poetsgate.com/ViewPoem.aspx?id=46265",""],[6097,"وتزعم أنني أنسى!","https://www.poetsgate.com/ViewPoem.aspx?id=197433",""],[6112,"تطاول ليلي لم أنمه تقلباً","https://www.poetsgate.com/ViewPoem.aspx?id=186531",""],[6142,"لمن أذيل عقيق الأدمع السجم","https://www.poetsgate.com/ViewPoem.aspx?id=155760",""],[6142,"عهدي بربعهم أغن المعهد","https://www.poetsgate.com/ViewPoem.aspx?id=155758",""],[6142,"سل كربلا والوغى والبيض والأسلا","https://www.poetsgate.com/ViewPoem.aspx?id=155747",""],[6225,"شراع وريح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80914&r=&rc=183",""]],"verses":[["سَلَكتَ في مَحَجَّةٍ","لا نَهَجاً وَلا لَقَم",0,"م",1,0],["سَلَكتُ فِجاجَ الأَرضِ غُفلاً وَمَعلَماً","تَجِدُّ بِها أَيدي المَطايا وَتَلعَبُ",1,"ب",1,0],["سَلَكْتُ فِيهَا عَلَى نَهْجِ الإِمَامِ أَبِي","وَطَالَمَا أَشْبَهَ النَّجْلُ الْكَرِيِمُ أَبَا",2,"ب",2,0],["سَلَكتُ إِذا ما جَنَّ ثَغَر طَريقِهِ","أَغَمُّ دَجوجيٌّ مِنَ اللَيلِ غَيهَبُ",3,"ب",1,0],["سَلَكا سَبيلَ الحَقِّ ما","عاشا وَما أَولاهُما",4,"م",2,0],["سَلَكتَ إِلى المَجدِ مِنهاجَهُ","فَقَد طابَقَ الأَطرَفُ الأَتلَدا",5,"د",2,0],["سَلَكتُ سَبيلَ الرَئِحاتِ عَشِيَّةً","مَخارِمَ نِصعٍ أَو سَلَكنَ سَبيلي",6,"ل",2,0],["سَلْ كلَّ مَنْقَبَةٍ عَنْهُ وَمَحْمَدَةٍ","سَلِ الهُدَى وَالنَّدَى وَالصَّفْحَ وَالكَرَمَا",7,"م",2,0],["سَلَكَ البيانُ بها سبيل إجادةٍ","لولا صفاتك كان عنها يعدلُ",8,"ل",1,0],["سلكتك السما ينابيع في الأر","ض أمدتك أيّما امداد",9,"د",1,0],["سَلَكتَ لِأَهلِ البَرِّ بَرّاً فَنِلتَهُم","وَفي اليَمِّ يَأتَمُّ السَفينُ الجَوافِلُ",10,"ل",1,0],["سلكت راحتاك ما اسْتصعب النا","س من الجودِ والعلى في الحزون",11,"ن",1,0],["سلكتَ سبيل المجد وحدَك ممعناً","ولم يبقَ منها موطئٌ يُتَرَسَّمُ",12,"م",1,0],["سَلَكوا بِنا في كُلِّ وادٍ ضَيِّقٍ","حَتّى قَنِطنا أَن يُصيبوا ضَيِّقا",13,"ق",2,0],["سلك الألى عاشوا طويلا بيننا","نحو الردى متن الطريق الأبعد",14,"د",1,0],["سلكتها يا غازي","أبية المجاز",15,"ز",1,0],["سِلك لآلٍ مِن بَني الأَعمامِ","وَمُلكُ آلٍ مِن بَني الغَمامِ",16,"م",1,1],["سَلَكتُ سَبيلَ المُترَفينَ وَلَذَّ لي","بَنونَ وَمالٌ وَالحَياةُ غُرورُ",17,"ر",1,0],["سَل كِلوبَترَةَ المُكايِدِ هَلّا","صَدَّها عَن وَلاءِ روما الدَهاءُ",18,"ا",2,0],["سَلَكتُ صُروفَ الدَهرِ حَتّى لَقَيتُهُ","عَلى ظَهرِ عَزمٍ مُؤيَداتٍ قَوائِمُه",19,"م",2,0],["سَلَكَت تَماثيلَ القِبابِ الجِنُّ مِن","شَوقٍ بِها فَأَدَرنَ فيكَ الأَعيُنا",20,"ن",2,0],["سَلَكوا بِنِيّاتِ الطَريقِ فَأَصبَحوا","مُتَنَكِّبينَ عَنِ الطَريقِ الأَكبَرِ",21,"ر",1,0],["سَلَكَتْ بَعْضُ الْوُشَاةِ بِهِ","مِنْ نَمِيمِ الْغَيِّ فِي سَنَنِ",22,"ن",1,0],["سَلَكوا خَلَّ الصِفاحِ لَهُم","زَجَلٌ أَحداجُهُم زُمَرُ",23,"ر",1,0],["سَلَكوا شَعبَ النِقابِ بِها","زُمَراً تَحُتَثُّهُم زُمَرُ",23,"ر",1,0],["سَلَكنَ الجَنبَ مِن رَكَكٍ","وَضَوءُ الفَجرِ قَد وَضَحا",24,"ح",2,0],["سلكَ المحجّةَ حين كُنتَ دليلَهُ","ومضى لحاجتهِ بأطيبِ زادِ",25,"د",1,0],["سلكوا الطريقَ الوعرَ يَسطعُ نُوره","وأضلَّ غيرَهم الطريقُ المُظلِمُ",26,"م",1,0],["سَلكوا السَّبيلَ مُسدَّدين تُضيئهُ","آيُ المُفصَّل يَتبعونَ هُداها",27,"ا",3,0],["سَلَكو الطَريقَ وَريقُهُم بِحُلوقِهِم","حَنَقاً وَكادَت تَستَمِرُّ بِجُندُبِ",28,"ب",1,1],["سَلَكنَ الخَبتَ مِن رَكَكٍ","وَضَوءُ الفَجرِ قَد وَضَحا",29,"ح",2,0],["سلكتْ سبيلَ المُلحِدينَ ولم يكُنْ","من بعد ذاكَ إلى الحياةِ سبيل",30,"ل",1,0],["سَلَكَ النَجدَ في قِطارِ المَنايا","قَطَرِيٌّ وَنَجدَةٌ وَشَبيبُ",31,"ب",1,0],["سلَكتُ طُرُقَ المَعالي ثُمَّ قُلتُ لَهُم","سيروا وَرائي فَلَمّا شارَفوا خَنَسوا",32,"س",3,0],["سَلَكْنَ لُكَيْزاً بِاليَمِين ولَوْزَةً","شِمَالاً ومُفْضَى السَّيْلِ ذِي الغَذَيانِ",33,"ن",1,0],["سُلَكُوا مَنهَجَ الَمنايا فباُدوا","وأَرانا قَد كانَ مِنَّا وُرُودُ",34,"د",1,0],["سَلَكَتْ نَفْسِي سَبِيلاً فِي الْهَوَى","لَمْ تَدَعْ فِيهِ لِغَيْرِي مَسْلَكَا",35,"ك",2,0],["سَلْ كِبَاراً بَلَغَوا تَأْدِيبَهُمْ","وَصَغَاراً لَمْ يَزَالُوا فِي الطَّلَبْ",36,"ب",1,0],["سَلَكُوا كُلَّ مَسْلَكٍ حَسَنٍ فِي","طَاعَة اللهِ وَالتِزَامِ الحُدُودِ",37,"د",1,0],["سَل كُلَّ جَبّارٍ عَنيدٍ ما لَهُ","بَعدَ القُصورِ مَحلّهُ الناووسُ",38,"س",1,0],["سَلَكْتُ كُلّ مَقامٍ في مَحَبّتِكُمْ","وما ترَكْتُ مقاماً قطُّ قُدّامي",39,"م",2,0],["سَلَكَتْ إِلَى الْمَجْدِ الْقَدِيمِ","مَحَجَّةَ النَهْجِ السدِيدِ",40,"د",1,0],["سَلكَتْ أوْسطَ الطَّريقِ وجَازَتْ","كُلَّ ما في الطَّرِيقِ من عَقَباتِ",41,"ت",1,0],["سَلَكَتْ سَبِيلاً لَيِّناً","سَهْلاً وَجافَتْ كُلَّ صَلْد",42,"د",1,0],["سَلْ كُلَّ مَنْ كَتَب الكَتائب غَازِياً","هل رَدَّ الْجَيْشُ سَهْم مماتِهِ",43,"ت",2,0],["سَلَكت نَفسِى سبيلاً فى الهَوى","لم تَدَع فيهِ لِغيرَتِى مَسلَكا",44,"ك",2,0],["سل كل قلب في الكنانة نابضٍ","عما يريدُ، يجبْك: أنت مرادي!",45,"د",2,0],["سلكوا بمحياهم وبعد مماتهم","اذ وفقوا بمسالك الأبرار",46,"ر",1,0],["سلَكْتُ فيها نهْج الإمام أبي","وطالما أشْبهَ النّجْلُ الكريمُ أبا",47,"ب",2,0],["سلكوا بنا في كلّ ضيّق","حتّى قنطا أن يصيبوا ضيّقا",48,"ق",2,0],["سَلْ كُلَّ مَنْ كَتَب الكَتائب غَازِياً","هل رَدَّ عنه الْجَيْشُ سَهْم مماتِهِ",49,"ت",2,0],["سَلَكتَ بيض الوَجوه أَوديَةً","رَأيك لَولاهُ قَط ما سَلَكوا",50,"ك",3,0],["سلك الطريق مقلداً بسلوككم","وأضاع خدمة سلككم بمقاله",51,"ل",2,0],["سل كم شربت ومن علمت وشربها","خمرين خمر طلى وخمر عيون",52,"ن",1,0],["سلكت طرائقاً لم يحظ منها","سواك بغير لقلقة اللسانِ",53,"ن",1,0],["سَلَكتَ إِلى الثَناءِ بِلا دَليلٍ","سَبيلاً ما تَقَدَّمَ فيهِ سائِل",54,"ل",1,0],["سَلَكتَ إِلى نَيلِ ما رُمتَهُ","سَبيلاً لِغَيرِكَ لَم يَستَقِم",55,"م",1,0],["سِلْكانِ لِلدَّمعِ مَحْلولٌ وَمَعْقُودُ","عَلَى التي لَحْدُها في القَلْبِ مَلْحُودُ",56,"د",1,1],["سلكت طريقا وهي لله آية","يراها ذوو الألباب أكبر آية",57,"ه",1,0],["سلكت إلى جذب القلوب طريقة","بلطف صنيع قل من يحوه اهتدا",58,"د",2,0],["سلكت في طلب الرز","ق كل حزن وسهل",59,"ل",1,0],["سلك التليفون في شرع الهوى عجب","أليس فيه إلى الأحباب إسرائي",60,"ي",1,0],["سلكتها جميعها في زمام","منذ خلق الوجود أقدر ذات",61,"ت",1,0],["سَلَكنا مُعضِلَ الدُنيا وَلكِن","شُفيتَ مِنَ الشَقاءِ وَما شُفيتُ",62,"ت",1,0],["سلكت طريق الفقر ظنا بأنني","أضاهي جنيداً أو أناسب معروفا",63,"ف",2,1],["سلكت به الأقدار أقومَ منهجٍ","لم يلق ربّ المدح فيه من هجا",64,"ج",2,0],["سلكت طريق الأخسرين فملت عن","طريق الهدى إذ ضلّ سعيك عن رشد",65,"د",1,0],["سَلَكتِ سبيلَ الصالحاتِ وكنتِ لي","معلمةً تَبغي هُدى ونِظاما",66,"م",2,0],["سَلَكْتَ وَإِيَّاهُ سَبيلاً غَدَا بِهِ","زَمَانُكُمَا في قِسْمَةِ الْجَوْرِ يَعْدِلُ",67,"ل",1,0],["سلكتَ وأَسلكتَ الأَسى في حشاشتي","ممرَّ سَبيل ما سواه سَبيلُ",68,"ل",1,0],["سَلَكوا من بطن فجٍّ سُبُلاً","لا عَدى صَوبُ الحيا تلك الفِجاجا",69,"ج",2,0],["سلكت من الهوى حظا توعر","فتعثيري به أضحى مكرر",70,"ر",1,1],["سَلَكنا الفَيافي وَالقفار عَلى النَجب","يَحدو بِنا الأَشواق لا حادي الرَكب",71,"ب",1,1],["سَلَكت يا عابد الرَحمَن سبل هُدىً","وَكُنت لِلهديِ مِصباحاً لِمَن 