{"poems":[[53,"ألمع برق أم ضرم","https://www.aldiwan.net/poem29820.html","مجزوء الرجز"],[53,"لغير العلى مني القلى والتجنب","https://www.aldiwan.net/poem30749.html","الطويل"],[77,"الحمد لله موصولا كما وجبا","https://www.aldiwan.net/poem36772.html","البسيط"],[42,"ألا تلك عرسي أم سكن تنكرت","https://www.aldiwan.net/poem50437.html","الطويل"],[86,"علمان من أعلام مصر","https://www.aldiwan.net/poem10473.html","مجزوء الكامل"],[73,"أفاض سماحك بحر الندى","https://www.aldiwan.net/poem11956.html","المتقارب"],[35,"ألا حييا ليلى أجد رحيلي","https://www.aldiwan.net/poem39100.html","الطويل"],[93,"فداحة الخطب أبكتني عليك دماً","https://www.aldiwan.net/poem11349.html","البسيط"],[83,"بشرى كما وضح الزمان وأجمل","https://www.aldiwan.net/poem54256.html","الكامل"],[88,"نحن من أرضنا على منطاد","https://www.aldiwan.net/poem45072.html","الخفيف"],[27,"شعفت بعهد ذكرته المنازل","https://www.aldiwan.net/poem5966.html","الطويل"],[72,"يا بروقا على ربى يبرين","https://www.aldiwan.net/poem20165.html","الخفيف"],[51,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[91,"إني سكت وما عدمت المنطقا","https://www.aldiwan.net/poem9046.html","عموديه"],[89,"لهفي على شيخ العروبة احمد","https://www.aldiwan.net/poem44636.html","الكامل"],[85,"فشودة رواية","https://www.aldiwan.net/poem7797.html","مجزوء الرجز"],[85,"سلك لآل من بني الأعمام","https://www.aldiwan.net/poem7910.html","الرجز"],[85,"تولستوي تجري آية العلم دمعها","https://www.aldiwan.net/poem62870.html","الطويل"],[85,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[43,"وفاؤكما كالربع أشجاه طاسمه","https://www.aldiwan.net/poem10140.html","الطويل"],[43,"الحب ما منع الكلام الألسنا","https://www.aldiwan.net/poem10585.html","الكامل"],[58,"ذهب الرجال المقتدى بفعالهم","https://www.aldiwan.net/poem31041.html","الكامل"],[87,"يا قرير العين بالوسن","https://www.aldiwan.net/poem8234.html","المديد"],[31,"يا خليلي هاجني الذكر","https://www.aldiwan.net/poem42511.html","المديد"],[31,"ألا هل هاجك الأظعان إذ","https://www.aldiwan.net/poem42591.html","مجزوء الوافر"],[105,"قل ما أردت فما عليك جناح","https://www.aldiwan.net/poem42081.html","الكامل"],[105,"منك الحنين ومنه ما هو أعظم","https://www.aldiwan.net/poem44066.html","الكامل"],[105,"طف بالمصارع واستمع نجواها","https://www.aldiwan.net/poem44218.html","الكامل"],[13,"سلكو الطريق وريقهم بحلوقهم","https://www.aldiwan.net/poem2232.html","الكامل"],[40,"ألا هل هاجك الأظعان","https://www.aldiwan.net/poem42290.html","مجزوء الوافر"],[75,"يوم عريض في الفخار طويل","https://www.aldiwan.net/poem69050.html","الكامل"],[46,"ما الثريا عنقود كرم ملاح","https://www.aldiwan.net/poem22111.html","الخفيف"],[46,"من لي بأني وحيد لا يصاحبني","https://www.aldiwan.net/poem22789.html","البسيط"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21019","الخفيف"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42722","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54629","الرمل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54750","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43800","الكامل"],[68,"","https://poetry.dctabudhabi.ae/diwan/poem/25961","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54229","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54211","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54288","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54224","البسيط"],[87,"غلب الوجد عليه فبكي","https://www.poetsgate.com/ViewPoem.aspx?id=18210",""],[106,"زفاف الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179500",""],[77,"الحمدُ لله مَوْصُولا كما وجبا","https://www.poetsgate.com/ViewPoem.aspx?id=33314",""],[91,"عام 1910","https://www.poetsgate.com/ViewPoem.aspx?id=53146",""],[101,"مَلكَ المُصَابُ عليه كُلَّ جِهاتِه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62439&r=&rc=31",""],[109,"أميرنا لا برحت في رتب","https://www.aldiwan.net/poem16298.html","المنسرح"],[115,"من للفقير المشتكي من حاله","https://www.aldiwan.net/poem41750.html","الكامل"],[124,"خل السجاير وادن لي غليوني","https://www.aldiwan.net/poem23756.html","الكامل"],[135,"سعى بالكاس مخضوب البنان","https://www.aldiwan.net/poem48995.html","الوافر"],[143,"أما وهوى عصيت له العواذل","https://www.aldiwan.net/poem11798.html","الوافر"],[143,"تفردت بالمجد دون الأمم","https://www.aldiwan.net/poem11809.html","المتقارب"],[155,"سلكان للدمع محلول ومعقود","https://www.aldiwan.net/poem55734.html","البسيط"],[160,"هلالك شبهناه وهو ابن ليلة","https://www.aldiwan.net/poem58904.html","الطويل"],[160,"بنى السيف علياه وشيدها الندى","https://www.aldiwan.net/poem58906.html","الطويل"],[186,"دعني فلم أر مثلي","https://www.aldiwan.net/poem43365.html","المجتث"],[211,"مضت أسابيع والهتاف محتجب","https://www.aldiwan.net/poem46764.html","البسيط"],[221,"رب لحن سرى مع النسمات","https://www.aldiwan.net/poem55258.html","الخفيف"],[223,"تذكرني وحقك ما نسيت","https://www.aldiwan.net/poem39692.html","الوافر"],[231,"سلكت طريق الفقر ظنا بأنني","https://www.aldiwan.net/poem44560.html","الطويل"],[259,"قسما بصبح الحسن حين تبلجا","https://www.aldiwan.net/poem35816.html","الكامل"],[259,"ألا أيها الميال عن منهل الورد","https://www.aldiwan.net/poem35819.html","الطويل"],[270,"أفيقي فردي بسمة وسلاما","https://www.aldiwan.net/poem35622.html","الطويل"],[280,"إذا لم يكن من حادث الدهر موئل","https://www.aldiwan.net/poem60784.html","الطويل"],[297,"لنا كل يوم رنة وعويل","https://www.aldiwan.net/poem33181.html","الطويل"],[297,"ما على حاديهم لو كان عاجا","https://www.aldiwan.net/poem33310.html","الرمل"],[303,"سلكت من الهوى حظا توعر","https://www.aldiwan.net/poem58295.html","الوافر"],[304,"سلكنا الفيافي والقفار على النجب","https://www.aldiwan.net/poem16797.html","الطويل"],[353,"ما راح بدر المعالي يمتطي الفلكا","https://www.aldiwan.net/poem40008.html","البسيط"],[353,"فدى لك ذا العبد مع ما ملك","https://www.aldiwan.net/poem40009.html","المتقارب"],[353,"لولا العذار ولولا طرفك الساجي","https://www.aldiwan.net/poem40547.html","البسيط"],[377,"أفأي عين لا ترف وتدمع","https://www.aldiwan.net/poem59345.html","الكامل"],[377,"أسلاف سلامكم أم خطاب","https://www.aldiwan.net/poem66943.html","الخفيف"],[380,"قلب يحبك مولع","https://www.aldiwan.net/poem48747.html","مجزوء الكامل"],[391,"يا طالب الأيصا هداك الله خذ مني كلام","https://www.aldiwan.net/poem54503.html","عموديه"],[416,"قدمت فحياك المهيمن بندرا","https://www.aldiwan.net/poem53902.html","الطويل"],[416,"ما مات من بعد عبد الواحد الجود","https://www.aldiwan.net/poem53941.html","البسيط"],[416,"أنيخاها فقد بلغت مناها","https://www.aldiwan.net/poem54083.html","الوافر"],[416,"تنقلت مثل البدر يا طلعة البدر","https://www.aldiwan.net/poem54158.html","الطويل"],[416,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[439,"أهلي قد أنى لك أن تهلي","https://www.aldiwan.net/poem34788.html","الوافر"],[458,"أما لنجوم ليلك بالمصلى","https://www.aldiwan.net/poem56087.html","الوافر"],[458,"سلك الخيال بحاجر","https://www.aldiwan.net/poem56096.html","مجزوء الكامل"],[458,"مل معي لا عليك ضري ونفعي","https://www.aldiwan.net/poem56120.html","الخفيف"],[458,"شفى الله نفسا لا تذل لمطلب","https://www.aldiwan.net/poem56303.html","الطويل"],[458,"حمام اللوى رفقا به فهو لبه","https://www.aldiwan.net/poem56306.html","الطويل"],[461,"زرت الامامين عن قلب طويته","https://www.aldiwan.net/poem15942.html","البسيط"],[464,"سر الحسود بما أساء وارجفا","https://www.aldiwan.net/poem3261.html","عموديه"],[464,"سقيت دمشق وجارتا جيرونها","https://www.aldiwan.net/poem3549.html","عموديه"],[500,"تركونا أي قوم تركوا","https://www.aldiwan.net/poem37930.html","الرمل"],[540,"ظعن الخليط بلبك المتقسم","https://www.aldiwan.net/poem56660.html","الكامل"],[546,"ألا يا اسلمي لا صرم لي اليوم فاطما","https://www.aldiwan.net/poem1864.html","الطويل"],[553,"قبر ببرذعة استسر ضريحه","https://www.aldiwan.net/poem68330.html","الكامل"],[553,"وساحرة العينين ما تحسن السحرا","https://www.aldiwan.net/poem68429.html","الطويل"]],"verses":[["سَلَكتَ في مَحَجَّةٍ","لا نَهَجاً وَلا لَقَم",0,"م",1,0],["سَلَكتُ فِجاجَ الأَرضِ غُفلاً وَمَعلَماً","تَجِدُّ بِها أَيدي المَطايا وَتَلعَبُ",1,"ب",1,0],["سَلَكْتُ فِيهَا عَلَى نَهْجِ الإِمَامِ أَبِي","وَطَالَمَا أَشْبَهَ النَّجْلُ الْكَرِيِمُ أَبَا",2,"ب",2,0],["سَلَكتُ إِذا ما جَنَّ ثَغَر طَريقِهِ","أَغَمُّ دَجوجيٌّ مِنَ اللَيلِ غَيهَبُ",3,"ب",1,0],["سَلَكا سَبيلَ الحَقِّ ما","عاشا وَما أَولاهُما",4,"م",2,0],["سَلَكتَ إِلى المَجدِ مِنهاجَهُ","فَقَد طابَقَ الأَطرَفُ الأَتلَدا",5,"د",2,0],["سَلَكتُ سَبيلَ الرَئِحاتِ عَشِيَّةً","مَخارِمَ نِصعٍ أَو سَلَكنَ سَبيلي",6,"ل",2,0],["سَلْ كلَّ مَنْقَبَةٍ عَنْهُ وَمَحْمَدَةٍ","سَلِ الهُدَى وَالنَّدَى وَالصَّفْحَ وَالكَرَمَا",7,"م",2,0],["سَلَكَ البيانُ بها سبيل إجادةٍ","لولا صفاتك كان عنها يعدلُ",8,"ل",1,0],["سلكتك السما ينابيع في الأر","ض أمدتك أيّما امداد",9,"د",1,0],["سَلَكتَ لِأَهلِ البَرِّ بَرّاً فَنِلتَهُم","وَفي اليَمِّ يَأتَمُّ السَفينُ الجَوافِلُ",10,"ل",1,0],["سلكت راحتاك ما اسْتصعب النا","س من الجودِ والعلى في الحزون",11,"ن",1,0],["سلكتَ سبيل المجد وحدَك ممعناً","ولم يبقَ منها موطئٌ يُتَرَسَّمُ",12,"م",1,0],["سَلَكوا بِنا في كُلِّ وادٍ ضَيِّقٍ","حَتّى قَنِطنا أَن يُصيبوا ضَيِّقا",13,"ق",2,0],["سلك الألى عاشوا طويلا بيننا","نحو الردى متن الطريق الأبعد",14,"د",1,0],["سلكتها يا غازي","أبية المجاز",15,"ز",1,0],["سِلك لآلٍ مِن بَني الأَعمامِ","وَمُلكُ آلٍ مِن بَني الغَمامِ",16,"م",1,1],["سَلَكتُ سَبيلَ المُترَفينَ وَلَذَّ لي","بَنونَ وَمالٌ وَالحَياةُ غُرورُ",17,"ر",1,0],["سَل كِلوبَترَةَ المُكايِدِ هَلّا","صَدَّها عَن وَلاءِ روما الدَهاءُ",18,"ا",2,0],["سَلَكتُ صُروفَ الدَهرِ حَتّى لَقَيتُهُ","عَلى ظَهرِ عَزمٍ مُؤيَداتٍ قَوائِمُه",19,"م",2,0],["سَلَكَت تَماثيلَ القِبابِ الجِنُّ مِن","شَوقٍ بِها فَأَدَرنَ فيكَ الأَعيُنا",20,"ن",2,0],["سَلَكوا بِنِيّاتِ الطَريقِ فَأَصبَحوا","مُتَنَكِّبينَ عَنِ الطَريقِ الأَكبَرِ",21,"ر",1,0],["سَلَكَتْ بَعْضُ الْوُشَاةِ بِهِ","مِنْ نَمِيمِ الْغَيِّ فِي سَنَنِ",22,"ن",1,0],["سَلَكوا خَلَّ الصِفاحِ لَهُم","زَجَلٌ أَحداجُهُم زُمَرُ",23,"ر",1,0],["سَلَكوا شَعبَ النِقابِ بِها","زُمَراً تَحُتَثُّهُم زُمَرُ",23,"ر",1,0],["سَلَكنَ الجَنبَ مِن رَكَكٍ","وَضَوءُ الفَجرِ قَد وَضَحا",24,"ح",2,0],["سلكَ المحجّةَ حين كُنتَ دليلَهُ","ومضى لحاجتهِ بأطيبِ زادِ",25,"د",1,0],["سلكوا الطريقَ الوعرَ يَسطعُ نُوره","وأضلَّ غيرَهم الطريقُ المُظلِمُ",26,"م",1,0],["سَلكوا السَّبيلَ مُسدَّدين تُضيئهُ","آيُ المُفصَّل يَتبعونَ هُداها",27,"ا",3,0],["سَلَكو الطَريقَ وَريقُهُم بِحُلوقِهِم","حَنَقاً وَكادَت تَستَمِرُّ بِجُندُبِ",28,"ب",1,1],["سَلَكنَ الخَبتَ مِن رَكَكٍ","وَضَوءُ الفَجرِ قَد وَضَحا",29,"ح",2,0],["سلكتْ سبيلَ المُلحِدينَ ولم يكُنْ","من بعد ذاكَ إلى الحياةِ سبيل",30,"ل",1,0],["سَلَكَ النَجدَ في قِطارِ المَنايا","قَطَرِيٌّ وَنَجدَةٌ وَشَبيبُ",31,"ب",1,0],["سلَكتُ طُرُقَ المَعالي ثُمَّ قُلتُ لَهُم","سيروا وَرائي فَلَمّا شارَفوا خَنَسوا",32,"س",3,0],["سُلَكُوا مَنهَجَ الَمنايا فباُدوا","وأَرانا قَد كانَ مِنَّا وُرُودُ",33,"د",1,0],["سَلَكَتْ نَفْسِي سَبِيلاً فِي الْهَوَى","لَمْ تَدَعْ فِيهِ لِغَيْرِي مَسْلَكَا",34,"ك",2,0],["سَلْ كِبَاراً بَلَغَوا تَأْدِيبَهُمْ","وَصَغَاراً لَمْ يَزَالُوا فِي الطَّلَبْ",35,"ب",1,0],["سَلَكُوا كُلَّ مَسْلَكٍ حَسَنٍ فِي","طَاعَة اللهِ وَالتِزَامِ الحُدُودِ",36,"د",1,0],["سَل كُلَّ جَبّارٍ عَنيدٍ ما لَهُ","بَعدَ القُصورِ مَحلّهُ الناووسُ",37,"س",1,0],["سَلَكْتُ كُلّ مَقامٍ في مَحَبّتِكُمْ","وما ترَكْتُ مقاماً قطُّ قُدّامي",38,"ي",1,0],["سَلَكَتْ إِلَى الْمَجْدِ الْقَدِيمِ","مَحَجَّةَ النَهْجِ السدِيدِ",39,"د",1,0],["سَلكَتْ أوْسطَ الطَّريقِ وجَازَتْ","كُلَّ ما في الطَّرِيقِ من عَقَباتِ",40,"ت",1,0],["سَلَكَتْ سَبِيلاً لَيِّناً","سَهْلاً وَجافَتْ كُلَّ صَلْد",41,"د",1,0],["سَلْ كُلَّ مَنْ كَتَب الكَتائب غَازِياً","هل رَدَّ الْجَيْشُ سَهْم مماتِهِ",42,"ت",2,0],["سَلَكت نَفسِى سبيلاً فى الهَوى","لم تَدَع فيهِ لِغيرَتِى مَسلَكا",43,"ك",2,0],["سل كل قلب في الكنانة نابضٍ","عما يريدُ، يجبْك: أنت مرادي!",44,"د",2,0],["سلَكْتُ فيها نهْج الإمام أبي","وطالما أشْبهَ النّجْلُ الكريمُ أبا",45,"ب",2,0],["سلكوا بنا في كلّ ضيّق","حتّى قنطا أن يصيبوا ضيّقا",46,"ق",2,0],["سَلْ كُلَّ مَنْ كَتَب الكَتائب غَازِياً","هل رَدَّ عنه الْجَيْشُ سَهْم مماتِهِ",47,"ت",2,0],["سَلَكتَ بيض الوَجوه أَوديَةً","رَأيك لَولاهُ قَط ما سَلَكوا",48,"ك",3,0],["سلك الطريق مقلداً بسلوككم","وأضاع خدمة سلككم بمقاله",49,"ل",2,0],["سل كم شربت ومن علمت و