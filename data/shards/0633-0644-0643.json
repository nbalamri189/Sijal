{"poems":[[55,"ألمع برق أم ضرم","https://www.aldiwan.net/poem29820.html","مجزوء الرجز"],[55,"لغير العلى مني القلى والتجنب","https://www.aldiwan.net/poem30749.html","الطويل"],[79,"الحمد لله موصولا كما وجبا","https://www.aldiwan.net/poem36772.html","البسيط"],[44,"ألا تلك عرسي أم سكن تنكرت","https://www.aldiwan.net/poem50437.html","الطويل"],[88,"علمان من أعلام مصر","https://www.aldiwan.net/poem10473.html","مجزوء الكامل"],[75,"أفاض سماحك بحر الندى","https://www.aldiwan.net/poem11956.html","المتقارب"],[37,"ألا حييا ليلى أجد رحيلي","https://www.aldiwan.net/poem39100.html","الطويل"],[95,"فداحة الخطب أبكتني عليك دماً","https://www.aldiwan.net/poem11349.html","البسيط"],[85,"بشرى كما وضح الزمان وأجمل","https://www.aldiwan.net/poem54256.html","الكامل"],[90,"نحن من أرضنا على منطاد","https://www.aldiwan.net/poem45072.html","الخفيف"],[29,"شعفت بعهد ذكرته المنازل","https://www.aldiwan.net/poem5966.html","الطويل"],[74,"يا بروقا على ربى يبرين","https://www.aldiwan.net/poem20165.html","الخفيف"],[53,"خصيم الليالي والغواني مظلم","https://www.aldiwan.net/poem66006.html","الطويل"],[93,"إني سكت وما عدمت المنطقا","https://www.aldiwan.net/poem9046.html","عموديه"],[91,"لهفي على شيخ العروبة احمد","https://www.aldiwan.net/poem44636.html","الكامل"],[87,"فشودة رواية","https://www.aldiwan.net/poem7797.html","مجزوء الرجز"],[87,"سلك لآل من بني الأعمام","https://www.aldiwan.net/poem7910.html","الرجز"],[87,"تولستوي تجري آية العلم دمعها","https://www.aldiwan.net/poem62870.html","الطويل"],[87,"همت الفلك واحتواها الماء","https://www.aldiwan.net/poem63788.html","الخفيف"],[45,"وفاؤكما كالربع أشجاه طاسمه","https://www.aldiwan.net/poem10140.html","الطويل"],[45,"الحب ما منع الكلام الألسنا","https://www.aldiwan.net/poem10585.html","الكامل"],[60,"ذهب الرجال المقتدى بفعالهم","https://www.aldiwan.net/poem31041.html","الكامل"],[89,"يا قرير العين بالوسن","https://www.aldiwan.net/poem8234.html","المديد"],[33,"يا خليلي هاجني الذكر","https://www.aldiwan.net/poem42511.html","المديد"],[33,"ألا هل هاجك الأظعان إذ","https://www.aldiwan.net/poem42591.html","مجزوء الوافر"],[107,"قل ما أردت فما عليك جناح","https://www.aldiwan.net/poem42081.html","الكامل"],[107,"منك الحنين ومنه ما هو أعظم","https://www.aldiwan.net/poem44066.html","الكامل"],[107,"طف بالمصارع واستمع نجواها","https://www.aldiwan.net/poem44218.html","الكامل"],[13,"سلكو الطريق وريقهم بحلوقهم","https://www.aldiwan.net/poem2232.html","الكامل"],[42,"ألا هل هاجك الأظعان","https://www.aldiwan.net/poem42290.html","مجزوء الوافر"],[77,"يوم عريض في الفخار طويل","https://www.aldiwan.net/poem69050.html","الكامل"],[48,"ما الثريا عنقود كرم ملاح","https://www.aldiwan.net/poem22111.html","الخفيف"],[48,"من لي بأني وحيد لا يصاحبني","https://www.aldiwan.net/poem22789.html","البسيط"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62244","الطويل"],[20,"","https://poetry.dctabudhabi.ae/diwan/poem/21019","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42722","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54629","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54750","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43800","الكامل"],[70,"","https://poetry.dctabudhabi.ae/diwan/poem/25961","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54229","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54211","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54288","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54224","البسيط"],[89,"غلب الوجد عليه فبكي","https://www.poetsgate.com/ViewPoem.aspx?id=18210",""],[108,"زفاف الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179500",""],[111,"ريب المنون مقارض الأعمار","https://www.poetsgate.com/ViewPoem.aspx?id=521",""],[79,"الحمدُ لله مَوْصُولا كما وجبا","https://www.poetsgate.com/ViewPoem.aspx?id=33314",""],[93,"عام 1910","https://www.poetsgate.com/ViewPoem.aspx?id=53146",""],[103,"مَلكَ المُصَابُ عليه كُلَّ جِهاتِه","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62439&r=&rc=31",""],[113,"أميرنا لا برحت في رتب","https://www.aldiwan.net/poem16298.html","المنسرح"],[119,"من للفقير المشتكي من حاله","https://www.aldiwan.net/poem41750.html","الكامل"],[128,"خل السجاير وادن لي غليوني","https://www.aldiwan.net/poem23756.html","الكامل"],[139,"سعى بالكاس مخضوب البنان","https://www.aldiwan.net/poem48995.html","الوافر"],[147,"أما وهوى عصيت له العواذل","https://www.aldiwan.net/poem11798.html","الوافر"],[147,"تفردت بالمجد دون الأمم","https://www.aldiwan.net/poem11809.html","المتقارب"],[159,"سلكان للدمع محلول ومعقود","https://www.aldiwan.net/poem55734.html","البسيط"],[164,"هلالك شبهناه وهو ابن ليلة","https://www.aldiwan.net/poem58904.html","الطويل"],[164,"بنى السيف علياه وشيدها الندى","https://www.aldiwan.net/poem58906.html","الطويل"],[190,"دعني فلم أر مثلي","https://www.aldiwan.net/poem43365.html","المجتث"],[215,"مضت أسابيع والهتاف محتجب","https://www.aldiwan.net/poem46764.html","البسيط"],[225,"رب لحن سرى مع النسمات","https://www.aldiwan.net/poem55258.html","الخفيف"],[227,"تذكرني وحقك ما نسيت","https://www.aldiwan.net/poem39692.html","الوافر"],[235,"سلكت طريق الفقر ظنا بأنني","https://www.aldiwan.net/poem44560.html","الطويل"],[263,"قسما بصبح الحسن حين تبلجا","https://www.aldiwan.net/poem35816.html","الكامل"],[263,"ألا أيها الميال عن منهل الورد","https://www.aldiwan.net/poem35819.html","الطويل"],[274,"أفيقي فردي بسمة وسلاما","https://www.aldiwan.net/poem35622.html","الطويل"],[284,"إذا لم يكن من حادث الدهر موئل","https://www.aldiwan.net/poem60784.html","الطويل"],[301,"لنا كل يوم رنة وعويل","https://www.aldiwan.net/poem33181.html","الطويل"],[301,"ما على حاديهم لو كان عاجا","https://www.aldiwan.net/poem33310.html","الرمل"],[307,"سلكت من الهوى حظا توعر","https://www.aldiwan.net/poem58295.html","الوافر"],[308,"سلكنا الفيافي والقفار على النجب","https://www.aldiwan.net/poem16797.html","الطويل"],[357,"ما راح بدر المعالي يمتطي الفلكا","https://www.aldiwan.net/poem40008.html","البسيط"],[357,"فدى لك ذا العبد مع ما ملك","https://www.aldiwan.net/poem40009.html","المتقارب"],[357,"لولا العذار ولولا طرفك الساجي","https://www.aldiwan.net/poem40547.html","البسيط"],[381,"أفأي عين لا ترف وتدمع","https://www.aldiwan.net/poem59345.html","الكامل"],[381,"أسلاف سلامكم أم خطاب","https://www.aldiwan.net/poem66943.html","الخفيف"],[384,"قلب يحبك مولع","https://www.aldiwan.net/poem48747.html","مجزوء الكامل"],[395,"يا طالب الأيصا هداك الله خذ مني كلام","https://www.aldiwan.net/poem54503.html","عموديه"],[420,"قدمت فحياك المهيمن بندرا","https://www.aldiwan.net/poem53902.html","الطويل"],[420,"ما مات من بعد عبد الواحد الجود","https://www.aldiwan.net/poem53941.html","البسيط"],[420,"أنيخاها فقد بلغت مناها","https://www.aldiwan.net/poem54083.html","الوافر"],[420,"تنقلت مثل البدر يا طلعة البدر","https://www.aldiwan.net/poem54158.html","الطويل"],[420,"أجاب ما سألته لما انثنى","https://www.aldiwan.net/poem54174.html","الرجز"],[443,"أهلي قد أنى لك أن تهلي","https://www.aldiwan.net/poem34788.html","الوافر"],[461,"أما لنجوم ليلك بالمصلى","https://www.aldiwan.net/poem56087.html","الوافر"],[461,"سلك الخيال بحاجر","https://www.aldiwan.net/poem56096.html","مجزوء الكامل"],[461,"مل معي لا عليك ضري ونفعي","https://www.aldiwan.net/poem56120.html","الخفيف"],[461,"شفى الله نفسا لا تذل لمطلب","https://www.aldiwan.net/poem56303.html","الطويل"],[461,"حمام اللوى رفقا به فهو لبه","https://www.aldiwan.net/poem56306.html","الطويل"],[464,"زرت الامامين عن قلب طويته","https://www.aldiwan.net/poem15942.html","البسيط"],[467,"سر الحسود بما أساء وارجفا","https://www.aldiwan.net/poem3261.html","عموديه"],[467,"سقيت دمشق وجارتا جيرونها","https://www.aldiwan.net/poem3549.html","عموديه"],[503,"تركونا أي قوم تركوا","https://www.aldiwan.net/poem37930.html","الرمل"],[543,"ظعن الخليط بلبك المتقسم","https://www.aldiwan.net/poem56660.html","الكامل"],[549,"ألا يا اسلمي لا صرم لي اليوم فاطما","https://www.aldiwan.net/poem1864.html","الطويل"],[556,"قبر ببرذعة استسر ضريحه","https://www.aldiwan.net/poem68330.html","الكامل"],[556,"وساحرة العينين ما تحسن السحرا","https://www.aldiwan.net/poem68429.html","الطويل"],[628,"","https://poetry.dctabudhabi.ae/diwan/poem/21184","الطويل"],[1073,"","https://poetry.dctabudhabi.ae/diwan/poem/18748","الوافر"]],"verses":[["سَلَكتَ في مَحَجَّةٍ","لا نَهَجاً وَلا لَقَم",0,"م",1,0],["سَلَكتُ فِجاجَ الأَرضِ غُفلاً وَمَعلَماً","تَجِدُّ بِها أَيدي المَطايا وَتَلعَبُ",1,"ب",1,0],["سَلَكْتُ فِيهَا عَلَى نَهْجِ الإِمَامِ أَبِي","وَطَالَمَا أَشْبَهَ النَّجْلُ الْكَرِيِمُ أَبَا",2,"ب",2,0],["سَلَكتُ إِذا ما جَنَّ ثَغَر طَريقِهِ","أَغَمُّ دَجوجيٌّ مِنَ اللَيلِ غَيهَبُ",3,"ب",1,0],["سَلَكا سَبيلَ الحَقِّ ما","عاشا وَما أَولاهُما",4,"م",2,0],["سَلَكتَ إِلى المَجدِ مِنهاجَهُ","فَقَد طابَقَ الأَطرَفُ الأَتلَدا",5,"د",2,0],["سَلَكتُ سَبيلَ الرَئِحاتِ عَشِيَّةً","مَخارِمَ نِصعٍ أَو سَلَكنَ سَبيلي",6,"ل",2,0],["سَلْ كلَّ مَنْقَبَةٍ عَنْهُ وَمَحْمَدَةٍ","سَلِ الهُدَى وَالنَّدَى وَالصَّفْحَ وَالكَرَمَا",7,"م",2,0],["سَلَكَ البيانُ بها سبيل إجادةٍ","لولا صفاتك كان عنها يعدلُ",8,"ل",1,0],["سلكتك السما ينابيع في الأر","ض أمدتك أيّما امداد",9,"د",1,0],["سَلَكتَ لِأَهلِ البَرِّ بَرّاً فَنِلتَهُم","وَفي اليَمِّ يَأتَمُّ السَفينُ الجَوافِلُ",10,"ل",1,0],["سلكت راحتاك ما اسْتصعب النا","س من الجودِ والعلى في الحزون",11,"ن",1,0],["سلكتَ سبيل المجد وحدَك ممعناً","ولم يبقَ منها موطئٌ يُتَرَسَّمُ",12,"م",1,0],["سَلَكوا بِنا في كُلِّ وادٍ ضَيِّقٍ","حَتّى قَنِطنا أَن يُصيبوا ضَيِّقا",13,"ق",2,0],["سلك الألى عاشوا طويلا بيننا","نحو الردى متن الطريق الأبعد",14,"د",1,0],["سلكتها يا غازي","أبية المجاز",15,"ز",1,0],["سِلك لآلٍ مِن بَني الأَعمامِ","وَمُلكُ آلٍ مِن بَني الغَمامِ",16,"م",1,1],["سَلَكتُ سَبيلَ المُترَفينَ وَلَذَّ لي","بَنونَ وَمالٌ وَالحَياةُ غُرورُ",17,"ر",1,0],["سَل كِلوبَترَةَ المُكايِدِ هَلّا","صَدَّها عَن وَلاءِ روما الدَهاءُ",18,"ا",2,0],["سَلَكتُ صُروفَ الدَهرِ حَتّى لَقَيتُهُ","عَلى ظَهرِ عَزمٍ مُؤيَداتٍ قَوائِمُه",19,"م",2,0],["سَلَكَت تَماثيلَ القِبابِ الجِنُّ مِن","شَوقٍ بِها فَأَدَرنَ فيكَ الأَعيُنا",20,"ن",2,0],["سَلَكوا بِنِيّاتِ الطَريقِ فَأَصبَحوا","مُتَنَكِّبينَ عَنِ الطَريقِ الأَكبَرِ",21,"ر",1,0],["سَلَكَتْ بَعْضُ الْوُشَاةِ بِهِ","مِنْ نَمِيمِ الْغَيِّ فِي سَنَنِ",22,"ن",1,0],["سَلَكوا خَلَّ الصِفاحِ لَهُم","زَجَلٌ أَحداجُهُم زُمَرُ",23,"ر",1,0],["سَلَكوا شَعبَ النِقابِ بِها","زُمَراً تَحُتَثُّهُم زُمَرُ",23,"ر",1,0],["سَلَكنَ الجَنبَ مِن رَكَكٍ","وَضَوءُ الفَجرِ قَد وَضَحا",24,"ح",2,0],["سلكَ المحجّةَ حين كُنتَ دليلَهُ","ومضى لحاجتهِ بأطيبِ زادِ",25,"د",1,0],["سلكوا الطريقَ الوعرَ يَسطعُ نُوره","وأضلَّ غيرَهم الطريقُ المُظلِمُ",26,"م",1,0],["سَلكوا السَّبيلَ مُسدَّدين تُضيئهُ","آيُ المُفصَّل يَتبعونَ هُداها",27,"ا",3,0],["سَلَكو الطَريقَ وَريقُهُم بِحُلوقِهِم","حَنَقاً وَكادَت تَستَمِرُّ بِجُندُبِ",28,"ب",1,1],["سَلَكنَ الخَبتَ مِن رَكَكٍ","وَضَوءُ الفَجرِ قَد وَضَحا",29,"ح",2,0],["سلكتْ سبيلَ المُلحِدينَ ولم يكُنْ","من بعد ذاكَ إلى الحياةِ سبيل",30,"ل",1,0],["سَلَكَ النَجدَ في قِطارِ المَنايا","قَطَرِيٌّ وَنَجدَةٌ وَشَبيبُ",31,"ب",1,0],["سلَكتُ طُرُقَ المَعالي ثُمَّ قُلتُ لَهُم","سيروا وَرائي فَلَمّا شارَفوا خَنَسوا",32,"س",3,0],["سَلَكْنَ لُكَيْزاً بِاليَمِين ولَوْزَةً","شِمَالاً ومُفْضَى السَّيْلِ ذِي الغَذَيانِ",33,"ن",1,0],["سُلَكُوا مَنهَجَ الَمنايا فباُدوا","وأَرانا قَد كانَ مِنَّا وُرُودُ",34,"د",1,0],["سَلَكَتْ نَفْسِي سَبِيلاً فِي الْهَوَى","لَمْ تَدَعْ فِيهِ لِغَيْرِي مَسْلَكَا",35,"ك",2,0],["سَلْ كِبَاراً بَلَغَوا تَأْدِيبَهُمْ","وَصَغَاراً لَمْ يَزَالُوا فِي الطَّلَبْ",36,"ب",1,0],["سَلَكُوا كُلَّ مَسْلَكٍ حَسَنٍ فِي","طَاعَة اللهِ وَالتِزَامِ الحُدُودِ",37,"د",1,0],["سَل كُلَّ جَبّارٍ عَنيدٍ ما لَهُ","بَعدَ القُصورِ مَحلّهُ الناووسُ",38,"س",1,0],["سَلَكْتُ كُلّ مَقامٍ في مَحَبّتِكُمْ","وما ترَكْتُ مقاماً قطُّ قُدّامي",39,"م",2,0],["سَلَكَتْ إِلَى الْمَجْدِ الْقَدِيمِ","مَحَجَّةَ النَهْجِ السدِيدِ",40,"د",1,0],["سَلكَتْ أوْسطَ الطَّريقِ وجَازَتْ","كُلَّ ما في الطَّرِيقِ من عَقَباتِ",41,"ت",1,0],["سَلَكَتْ سَبِيلاً لَيِّناً","سَهْلاً وَجافَتْ كُلَّ صَلْد",42,"د",1,0],["سَلْ كُلَّ مَنْ كَتَب الكَتائب غَازِياً","هل رَدَّ الْجَيْشُ سَهْم مماتِهِ",43,"ت",2,0],["سَلَكت نَفسِى سبيلاً فى الهَوى","لم تَدَع فيهِ لِغيرَتِى مَسلَكا",44,"ك",2,0],["سل كل قلب في الكنانة نابضٍ","عما يريدُ، يجبْك: أنت مرادي!",45,"د",2,0],["سلكوا بمحياهم وبعد مماتهم","اذ وفقوا بمسالك الأبرار",46,"ر",1,0],["سلَكْتُ فيها نهْج الإمام أبي","وطالما أشْبهَ النّجْلُ الكريمُ أبا",47,"ب",2,0],["سلكوا بنا في كلّ ضيّق","حتّى قنطا أن يصيبوا ضيّقا",48,"ق",2,0],["سَلْ كُلَّ مَنْ كَتَب الكَتائب غَازِياً","هل رَدَّ عنه الْجَيْشُ سَهْم مماتِهِ",49,"ت",2,0],["سَلَكتَ بيض الوَجوه أَوديَةً","رَأيك لَولاهُ قَط ما سَلَكوا",50,"ك",3,0],["سلك الطريق مقلداً بسلوككم","وأضاع خدمة سلككم بمقاله",51,"ل",2,0],["سل كم شربت ومن علمت وشربها","خمرين خمر طلى وخمر عيون",52,"ن",1,0],["سلكت طرائقاً لم يحظ منها","سواك بغير لقلقة اللسانِ",53,"ن",1,0],["سَلَكتَ إِلى الثَناءِ بِلا دَليلٍ","سَبيلاً ما تَقَدَّمَ فيهِ سائِل",54,"ل",1,0],["سَلَكتَ إِلى نَيلِ ما رُمتَهُ","سَبيلاً لِغَيرِكَ لَم يَستَقِم",55,"م",1,0],["سِلْكانِ لِلدَّمعِ مَحْلولٌ وَمَعْقُودُ","عَلَى التي لَحْدُها في القَلْبِ مَلْحُودُ",56,"د",1,1],["سلكت طريقا وهي لله آية","يراها ذوو الألباب أكبر آية",57,"ه",1,0],["سلكت إلى جذب القلوب طريقة","بلطف صنيع قل من يحوه اهتدا",58,"د",2,0],["سلكت في طلب الرز","ق كل حزن وسهل",59,"ل",1,0],["سلك التليفون في شرع الهوى عجب","أليس فيه إلى الأحباب إسرائي",60,"ي",1,0],["سلكتها جميعها في زمام","منذ خلق الوجود أقدر ذات",61,"ت",1,0],["سَلَكنا مُعضِلَ الدُنيا وَلكِن","شُفيتَ مِنَ الشَقاءِ وَما شُفيتُ",62,"ت",1,0],["سلكت طريق الفقر ظنا بأنني","أضاهي جنيداً أو أناسب معروفا",63,"ف",2,1],["سلكت به الأقدار أقومَ منهجٍ","لم يلق ربّ المدح فيه من هجا",64,"ج",2,0],["سلكت طريق الأخسرين فملت عن","طريق الهدى إذ ضلّ سعيك عن رشد",65,"د",1,0],["سَلَكتِ سبيلَ الصالحاتِ وكنتِ لي","معلمةً تَبغي هُدى ونِظاما",66,"م",2,0],["سَلَكْتَ وَإِيَّاهُ سَبيلاً غَدَا بِهِ","زَمَانُكُمَا في قِسْمَةِ الْجَوْرِ يَعْدِلُ",67,"ل",1,0],["سلكتَ وأَسلكتَ الأَسى في حشاشتي","ممرَّ سَبيل ما سواه سَبيلُ",68,"ل",1,0],["سَلَكوا من بطن فجٍّ سُبُلاً","لا عَدى صَوبُ الحيا تلك الفِجاجا",69,"ج",2,0],["سلكت من الهوى حظا توعر","فتعثيري به أضحى مكرر",70,"ر",1,1],["سَلَكنا الفَيافي وَالقفار عَلى النَجب","يَحدو بِنا الأَشواق لا حادي الرَكب",71,"ب",1,1],["سَلَكت يا عابد الرَحمَن سبل هُدىً","وَكُنت لِلهديِ مِصباحاً لِمَن سَلَكا",72,"ك",2,0],["سَلَكت سَبيل الهُدى تابِعاً","هُدى سَيّد الخَلق فيما سَلَك",73,"ك",1,0],["سَلَكتُ في حُبّه مِنهاج ذي وَلَهٍ","وَهَل لِسالك ذا المِنهاج مِن هاجي",74,"ج",2,0],["سِلكُ الدموع به فرائدُ ذكرِكم","ما أحسنَ الأشعارَ حين تُرصَّع",75,"ع",1,0],["سلك نظمٍ كأنه نظمُ سلكٍ","وعروضٌ حواه بحرٌ عُباب",76,"ب",1,0],["سَلَكوا طَريقاً في المَكا","رم أَيأست مِن يَتبع",77,"ع",1,0],["سلكوا عليها صدق جعلوها غذاهم والأدام","مازاغوا أوراعوا ولا سمعوا لعذل أو ملام",78,"م",1,0],["سلكتَ سبيلَ الأَوَّلين فلم تَحِدْ","عن الرُّشد أو تُلقى عن الورد مصدرا",79,"ر",2,0],["سَلَكْتَ كلَّ سبيلٍ كانَ يسلكه","فكلُّ فعلك يا محمود محمودُ",80,"د",1,0],["سلكتُ بها فجاج الأرض حتَّى","أضَرَّ بها وأوهنها قواها",81,"ا",3,0],["سلكتُ فجاجها ومَرَقْتُ منها","مروقَ النَّبل يبعُدُ مرتماها",81,"ا",3,0],["سلكت بتلك الخيم ما سلكت به","وما سلكت إلاَّ بمسلكها الوعر",82,"ر",1,0],["سلكت من كلِّ الفجاج وعرها","وذقت منها ما أمر وحلا",83,"ا",1,0],["سلكتَ سبيلَهُ هَدْياً بهديٍ","وقمتَ مقامَهُ مِثْلاً بِمِثلِ",84,"ل",1,0],["سلكتُ ولا أنيسَ سوى اعتزامي","ولا صوتٌ سوى الأصداء يزقو",85,"ق",2,0],["سَلكَ الخيالُ بحاجرٍ","طَرْفاً كراه مؤرِّقُهْ",86,"ق",2,1],["سلكوا في الكمال فانتظموه","مُولَج الخيط في ثقوبِ الجَزعِ",87,"ع",1,0],["سَلكتُ فأدَّاني بقلبٍ ملفَّحٍ","عظائمً ما أَلقَى وجسمٍ مجرَّبِ",88,"ب",1,0],["سلكتُ مجازَ العزّ بيني وبينه","تُحَطُّ روابيه وتُهْتَكُ حُجْبُهُ",89,"ب",2,0],["سلكت في سَننٍ من وصف مجدهما","فكنت من قبلُ زَوَّاراً ولم تَزُرِ",90,"ر",1,0],["سلكن نهجاً واضحاً هو في العلى","جدد يؤم مدى الزمان ويقتفى",91,"ف",2,0],["سلكتْ بطونَ وهادها وشعابها","وفلتْ ظهور سهولها وحزونها",92,"ن",3,0],["سَلَكُوا وهماً على آرائهِمْ","ليتَهُمْ إذْ سَلَكُوا ما سَلَكُوا",93,"ك",3,0],["سَلَكوا عَلى صَفَرٍ كَأَنَّ حُمولَهُم","بالرَضمَتَينِ ذُرى سَفينٍ عُوَّمِ",94,"م",1,0],["سَلَكْنَ القُرى والجزْعَ تُحْدى جِمالُهُمْ","ووَرَّكْنَ قَوّاً واجْتَزَعْنَ المَخارِما",95,"م",2,0],["سَلَكَت بِكَ العَرَبُ السَبيلَ إِلى العُلا","حَتّى إِذا سَبَقَ الرَدى بِكَ حاروا",96,"ر",3,0],["سَلَكنا سَبيلاً لِلصِبا أَجنَبِيَّةً","ضَمِنّا لَها أَن نَعصِيَ اللَومَ وَالزَجرا",97,"ر",2,0],["سَلَكتَ سَبيلَ العالَمينَ فَما لَهُم","وَراءَ الَّذي لاقَيتَ مَعدىً وَلا قَصرُ",98,"ر",1,0],["سَلَكتُ مَجامِعَ الأَوصالِ مِنهُ","بِمُطرَدِ الوَقيعَةِ كَالخَلالِ",99,"ل",1,1]]}