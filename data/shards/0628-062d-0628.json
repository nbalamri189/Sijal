0],["بِحُبِّكِ يا لَيلى قَدَ اَصبَحتُ شُهرَةً","وَكُلٌّ بِما أَلقاهُ عِندَكِ يَفهَمُ",6,"م",1,1],["بِحُبِّكِ يا لَيلى اِبتُليتُ وَإِنَّني","حَليفُ الأَسى باكي الجُفونِ فَقيدُ",7,"د",1,0],["بِحُبِّكَ عاشَرْتُ الهمُومَ صَبابَةً","كَأَنِّي لَها تِرْبٌ وَهُنَّ لِداتِي",8,"ت",2,0],["بحب قاتلتي والشيب تعذيبي","هواي طفلاً وشيبي بالغ الحلم",9,"م",1,0],["بحب (أمير المؤمنين ابن راشد)","أدين وأنف الخصم خزيان راغم",10,"م",1,0],["بحبك ذاب يا مولاي كلي","وتبغضني فذا شيء عجيب",11,"ب",1,0],["بُح باسمهِ وعليّ عه","دٌ أنني سأصونُ سِرّكْ",12,"ك",1,0],["بِحُبِّكً هَل لِي في لِقَائكَ مَطمَعٌ","فإنِّيَ مِن كَرب عَلَيكَ إلَى كَربِ",13,"ب",1,0],["بِحُبِّ رَسولِ اللَهِ نَرجو جِوارَهُ","وَكُلُّ مُحِبٍّ فالحَبيبُ لَهُ حَسبُ",14,"ب",1,0],["بُح بِالهَوى وَاِصحَب العُشّاقَ مُنهَتِكاً","وَلا تُطِع غَيرَ غاويها وَمُغوِيها",15,"ي",3,0],["بحبِّك صار عاشقُك المُعَنّى","على العشّاق يفتخر افتخارا",16,"ر",2,0],["بُح بِالسَرائِرِ وَاِهمِ دَمعَكَ بَعدَهُم","وَجداً وَبِتَّ النَومَ عَنكَ مُطَلَّقا",17,"ق",2,0],["بحبيبٍ نهجَ الحقّ حذا","مولاي بسرّ الجمع كذا",18,"ذ",2,0],["بحبيبك طه رحمتنا","ووسيلتنا ماحي الدجج",19,"ج",1,0],["بحبكِ فقتِهِ كرماً وحلماً","فلي منهُ النَّدى ولكِ الحسام",20,"م",1,0],["بحبّ جنانٍ كان قولُ ابن هانئٍ","وقد نالَ وصلاً بعد طولِ التدلّل",21,"ل",1,0],["بحبِّكِ حبَّبتِ الحياةَ وزنتِها","كما حبَّبَ الحلمُ الجميلُ مَناما",22,"م",2,0],["بحبّ الخمرِ شارَكني نَديمٌ","رشيقُ القدّ أطولُ من عمود",23,"د",1,0],["بحُبِّكِ أسري كان نصري فمن رأى","أسيراً غدا يخشى الخلاصَ من الأسر",24,"ر",1,0],["بحبيب القلوب معتمد الحل","قِ أبي القاسم النبيِّ الشفيعِ",25,"ع",1,1],["بِحُبِّ مَن أَراهُ لا مثلَ لَهُ","في الحُسنِ يَوماً أَنا في الحُزنِ مَثَل",26,"ل",1,0],["بِحُبِّ أَبي بَكر بنِ أَيّوبَ دانَتِ ال","وَرى فَتَساوَت شيعَةٌ وَنَواصِبُ",27,"ب",1,0],["بحبكِ ما بذلت من ال","حياة علَى الهوى حسبك",28,"ك",1,0],["بحبّكم دانَ أهلُ الأرضِ قاطبةً","وَإِن تَبايَنتِ النحلات والإممُ",29,"م",1,0],["بحُبّي بأشواقي بدَمعي الذي همى","بشكّى بإيماني وأوّاه منهما",30,"م",2,1],["بِحَبلِ الوَزيرِ أَبي طالِبٍ","عَلِيَّ بنِ أَحمَدَ فَ