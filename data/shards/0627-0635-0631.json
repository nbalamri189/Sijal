ttps://poetry.dctabudhabi.ae/diwan/poem/100313","الوافر"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115635","المنسرح"],[2958,"","https://poetry.dctabudhabi.ae/diwan/poem/100569","الطويل"],[3022,"","https://poetry.dctabudhabi.ae/diwan/poem/120167","الخفيف"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100834","الوافر"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103830","الطويل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35494","البسيط"],[4042,"","https://poetry.dctabudhabi.ae/diwan/poem/69244","الطويل"],[4626,"","https://poetry.dctabudhabi.ae/diwan/poem/102885","الطويل"],[4955,"ما لي ألقاك بلا أملٍ","https://www.poetsgate.com/ViewPoem.aspx?id=188772",""],[4978,"تشطير","https://www.poetsgate.com/ViewPoem.aspx?id=183247",""],[4984,"لا عدوى","https://www.poetsgate.com/ViewPoem.aspx?id=186523",""],[5189,"فوا عجبا","https://www.poetsgate.com/ViewPoem.aspx?id=212237",""],[5377,"الأمن الزائف","https://www.poetsgate.com/ViewPoem.aspx?id=61898",""],[5431,"ياقلبُ قلْ لي...","https://www.poetsgate.com/ViewPoem.aspx?id=185004",""],[5431,"زمْجِرْ وعبِّر لاأحبك هادئا","https://www.poetsgate.com/ViewPoem.aspx?id=185563",""],[5431,"ياللشفاه السمر...","https://www.poetsgate.com/ViewPoem.aspx?id=198921",""],[5561,"إغضب","https://www.poetsgate.com/ViewPoem.aspx?id=195081",""],[5573,"سلة ضروفي","https://www.poetsgate.com/ViewPoem.aspx?id=200317",""],[5756,"القدس","https://www.poetsgate.com/ViewPoem.aspx?id=5431",""],[1920,"شكرا لك","https://www.poetsgate.com/ViewPoem.aspx?id=191695",""],[5956,"إنَّ بي عيباً وحيدا","https://www.poetsgate.com/ViewPoem.aspx?id=181894",""],[5956,"اصرخ فخيرُ البرِّ أن لا تسكت","https://www.poetsgate.com/ViewPoem.aspx?id=204411",""],[6102,"يَفعَلُ البُعدُ ..","https://www.poetsgate.com/ViewPoem.aspx?id=185335",""],[5080,"أُصرِّف آياتي على سورة النبضِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88131&r=&rc=1",""],[2220,"أصرِّفه في كلِّ وقتٍ تصرُّفا أصرِّفه في كلِّ وقتٍ تصرُّفا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11549&r=&rc=423",""]],"verses":[["أُصَرِّفُ فَهمي وَالمَقاوِلُ سُرَّعٌ","وَأَملِكُ حِلمي وَالعَوامِلُ شُرَّعُ",0,"ع",1,0],["إِصرِف فُؤادَكَ يا عَبّاسُ مُنصَرِفاً","عَنها يَكُن عَنكَ كَربُ الحُبِّ مُنصَرِفاً",1,"ف",2,0],["اِصرِف فُؤادَكَ يا عَبّاسُ مُلتَفِتاً","عَنها وَإِلا فَمُت مِن حُبِّها كَمَدا",2,"د",2,1],["أَصرَمتَ حَبلَكَ مِن لَمي","سَ اليَومَ أَم طالَ اِجتِبابُه",3,"ب",2,1],["أَصَرفَ الرَدى لَو أَنَّ لِلسَيفِ مَضرِباً","لَما رُعتَنا أَو أَنَّ في القَوسِ مَنزَعا",4,"ع",2,0],["أُصَرِّحُ عَنْ وَلاءٍ لَمْ يَضِرْهُ","تَقَادُمُهُ بِأَبْلَغِ تُرْجُمَانِ",5,"ن",1,0],["اِصرِميني يا خِلقَةَ المِجدارِ","وَصِليني بِطولِ بُعدِ المَزارِ",6,"ر",1,1],["أَصَرَمتِ إِذ طَمِعَ الوُشاةُ بِصَرمِنا","صَبّاً لَعَمرُكِ يا أُمَيمَ وَدودا",7,"د",2,0],["أَصرَمتَ حاجَتَكَ الَّتي قَضَّيتَها","وَمَعَ الظَعائِنِ حاجَةٌ لَم تُصرَمِ",8,"م",1,0],["أَصرَعُها تارَةً وَتَصرَعُني","لَكِن لَها السَبقُ حينَ أَلقاها",9,"ا",3,0],["أصرِفُ العُمْرَ في الجبالِ وفي الغاباتِ","بَيْنَ الصّنوبرِ الميَّادِ",10,"د",1,0],["أُصَرِّفُ ذِهني في أُمورٍ كَبيرَةٍ","وَأَعلَمُ أَنَّ الدائِراتِ تَدورُ",11,"ر",1,0],["أُصَرِّفُ نَفسي كَما أَشتَهي","وَأَملِكُها وَالقَنا أَحمَرُ",12,"ر",1,0],["اِصرِب بِطَرفِكَ في الدُنيا فَإِنَّ لَهُ","ما شِئتَ مِن عِبَرٍ فيها وَمِن مَثَلِ",13,"ل",1,0],["أُصَرِّفُ مُقلَتَيَّ في إِثرِ قَومٍ","تَبايَنَتِ البِلادُ بِهِم فَغاروا",14,"ر",3,0],["أَصَرَمتِ الَّذي دَعاهُ هَواكُم","وَبَرى لَحمَهُ فَلَم يُبقِ لَحما",15,"م",2,0],["اصرِفِ اللَّهُمَّ عن أبنائِهِ","باطِلَ الدُّنيا ومكروهَ القَدَرْ",16,"ر",1,0],["أَصرَعُ العَقلَ بِالهَوى فَسِراجُ ال","راشِدِ مِن تَحتُ بِالظَلامِ خَفِيُّ",17,"ي",1,0],["إِصرِف شَرابي قَد هَجَرتُ كُؤوسُهُ","شَهرَ الصِيامِ وَإِعفُني مِن مائِهِ",18,"ا",3,1],["أًصرَعُ القِرنَ إِذا نازَلتُهُ","وَإِذا صارَعَني الحُبُّ صَرَع",19,"ع",1,0],["أَصرِفُ نَفسي عَنها وَقَد غَلَقَت","هَيهاتَ دَوِّيَّةٌ أَشِبُ",20,"ب",1,0],["أصَرَمْتَ حَبْلَكَ مِنْ لَمِي","سَ اليومَ أمْ طالَ اجتنابهْ",21,"ب",2,1],["أصرمت عن ذكر الغرامِ وأهلهِ","صفحاً وايقظت المنى والسولا",22,"ل",2,0],["أَصَرَّ العَذولُ عَلى العَذلِ فيهِ","وَقَلبي عَلى الوَجدِ فيهِ مُصِرُّ",23,"ر",1,0],["أَصَرَمتَ حَبلَ الوَصلِ مِن فِترِ","وَهَجَرتَها وَلَجَجتَ في الهَجرِ",24,"ر",1,1],["أصرعها تراة وتصرعني","لكن لها السبق حين ألقاها",25,"ا",3,0],["اِصرف إِلهي عَنّي شَرّ عائِدةٍ","يا مَن أَياديهِ عِندي غَيرُ واحدةٍ",26,"ه",1,0],["اِصرف السُوءَ يا إِلَهيَ عَنّي","وَاِحمِني مِن شَماتَةِ الأَعداءِ",27,"ا",2,0],["اِصْرِفُوا أوجُهَ المَطيِّ إليه","ثُمّ لا تَحذَروا من الدَّهْرِ صَرْفا",28,"ف",2,0],["أصرفُ النَّوى يَهواكَ لما استقلَّ بي","عَلى غَيرِ تَوديعٍ فولَّيتُ مُسرِعا",29,"ع",2,1],["أصرّحُ باسْمه طَوراً وطوراً","أخافُ حواسدي فيه فأَكْني",30,"ن",2,0],["اصرفه في كل معنى اريده","فتبدو له فوق الطروس بدائع",31,"ع",1,0],["اُصَرِّفهُ أمْراً ونهْياً كأنني","عليه أميرٌ حيثُ عَنَّتْ مآربي",32,"ب",2,0],["أصرِفُ العمرَ صرفَهُ بين كذبِ ال","وَعْدِ منه وصِدقِ يومِ الوَعيدِ",33,"د",1,0],["أصرّوا على العِصيانِ سرّاً وأظهروا","له طاعة والكلُّ بالعَهدِ غادِرُ",34,"ر",1,0],["أصرِفُ الأكدارَ والأح","زانَ عنِّي إن صَرَفتُك",35,"ك",1,0],["أصريعة لأب جهول أنت أم","أمسيت صيداً لقفته جوارح",36,"ح",1,0],["أصريعاً أكون في القبر مبكي","ياً من الفضل والهدى والعلاء",37,"ا",2,0],["أَصرَمتَ رامَةَ أم تَجَدَّدَ حَبلُها","أَم قَد مَلِلتَ عَلى التَّنائي وَصلَها",38,"ل",3,1],["أصرت تأبى نفعه لضرى","تمنعه الخير لقصد شرى",39,"ر",2,0],["أصرح بالشكوى ولا أتأول","إذا أنت لم تجمل فلم أتجمل؟",40,"ل",1,1],["اصرفت عمرك بالعفاف ونلت من","مولاك أضعاف الجزا يا يوسفُ",41,"ف",1,0],["أصرح بالتذكير في كل محفل","وادعو إلى كسب العلى كل مقبل",42,"ل",1,1],["أَصَريعٌ كَلمٍ أَم صَريعُ ضَنىً","أَودى فَلَيسَ مِنَ الرَدى بُدُّ",43,"د",1,0],["أَصَريعُ كَلمٍ أَم صَريعُ ردى","أَودى فَلَيسَ مِنَ الرَدى بُدُّ",44,"د",1,0],["أَصرِفُ هَمّي بِالمُنى","لَو أَنَّهُ يَنصَرِفُ",45,"ف",1,0],["أصرِّفه في كلِّ وقتٍ تصرُّفا","لأني سمعتُ الله قال سنفرغُ",46,"غ",1,1],["اصرف سفاتج هذا الشرب عن رجلٍ","له بُضَيِّعَةٌ في الشرب مزجاةُ",47,"ه",1,1],["أَصُرمٌ مِنكِ هَذا أَم دَلالٌ","فَقَد عَنّى الدلالُ إِذن وَطالا",48,"ل",2,0],["اصرِفوا عنِّي طَبِيبي","وَدَعُوني وَحَبيبي",49,"ب",2,1],["أَصَرَمتَ حَبلَكَ مِن أُمامَه","مِن بَعدِ أَيّامٍ بِرامَه",50,"م",2,1],["أصرح بالمديح له وأثني","إذا ما النكس الغز بالرموز",51,"ز",1,0],["اصرِف جيوشَ الهموم بالصرفِ","واعطِف على كلّ ليّنِ العطفِ",52,"ف",1,1],["أصرف رداه من هداك لنقده","فما أنت إلا صيرفي وناقد",53,"د",1,0],["اصرفى ما استطعت عنك الهموما","واحذري الحزن والأسى أن يقيما",54,"م",2,1],["أصر على الجفاء ونحن شعب","أضر به التعسف والوعيد",55,"د",1,0],["أصرفها حيث انصرفت وكيفما","تقلبت كالمنعوت في النحو والنعت",56,"ت",1,0],["إِصرِف كُؤوسَكَ عَنّي يا مصرّفها","فَلَيسَ لي بَعدَها في اللَهوِ مِن أَرَبِ",57,"ب",1,0],["أَصرَمٌ بليلى حادِثٌ أَم تَجنُّبُ","أَم الحَبلُ مِنها واهِنٌ مُتَقَضِّبُ",58,"ب",1,1],["أصرف ذهني في أمورٍ كثيرةٍ","وأعلم أن الدائرات تدور",59,"ر",1,0],["اصرف وسواساً أرَّقني","من جاءكَ حاشا أن يخسرْ",60,"ر",1,0],["إصرِف لنا شِعرًا وهاتِ رغيفنا","(نرنو إليه بلهفة الجوعانِ)",61,"ن",1,0],["اصرخ ما شئت من العددِ","كالذكر وإن ترقى فزدِ",62,"د",1,1],["أصرخ فلعل الأذن بها","صمم ما شئت لها أعدِ",62,"د",1,0],["أصرَّ على معاداةٍ","وعن نهج الهدى انصرفَا",63,"ف",2,0],["إصرخوا في الآذان : الله أحمدْ","واجعلوه رباً سوى الله يعبد",64,"د",1,1],["اصرخ لعلّ من الصدى من يسمعك!","اصرخ لعلّ من الورى من يتبعك!",65,"ك",1,0],["اصرخ بوجه الظالمين ولاتخف!","سرّ الحياة بصرخة الإنسان",66,"ن",1,0],["اصرخ وخلِّ الشمس تحرقني","واعطِ الخطايا السبع قبعتي",67,"ت",2,0],["اصرخ بأعلى ما استطعتَ فإنني","سأكون هادئةً كصمت عيوني",68,"ن",2,0],["أصرخ من اول منه واليوم ونيت","ولازال حولي بالوساوس يحوفي",69,"ف",2,0],["أصرخ على كل البشر وأجهر أجهار","وخل اليهود إن مادروا عنك يدرون",70,"ن",1,0],["اصرخ وخاصِم ما تشاء فإنه","حملَ الحقائب مذ رآك هناكا",71,"ك",2,0],["‏ ‏أصرف العمر اشتهاءْ","‏ ‏ دون إشباع الظماءْ",72,"ا",2,0],["اصرخ فخيرُ البِرِّ أن لا تسكتا","عمَّا يدور من الأذى في غزةَ",73,"ه",1,1],["أَصرِمُ الوَقتَ ثَورَةً وَهَياجًا","بِانتِقامِي, وَغَضبَتِي طُوفانُ",74,"ن",1,0],["أُصرِّفُ آياتي على سورةِ النَّبضِ","وأُدركُ سرَّ الضّوءِ في لحظةِ الغمضِ",75,"ض",1,1],["أصرِّفه في كلِّ وقتٍ تصرُّفا أصرِّفه في كلِّ وقتٍ تصرُّفا","لأني سمعتُ الله قال سنفرغُ",76,"غ",1,1]]}