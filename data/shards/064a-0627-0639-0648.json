{"poems":[[4,"قومي إذا نام الخلي","https://www.aldiwan.net/poem21188.html","مجزوء الكامل"],[66,"يا عوضي من عوضي","https://www.aldiwan.net/poem67557.html","مجزوء الرجز"],[53,"قل للثوابي إذا جئته","https://www.aldiwan.net/poem64001.html","السريع"],[147,"أما الزمان ففي يديك عنانه","https://www.aldiwan.net/poem11830.html","الكامل"],[541,"يا عوف ويحك هلا قلت عارفة","https://www.aldiwan.net/poem23858.html","البسيط"],[572,"ياعوضا من فائت","https://www.aldiwan.net/poem69617.html","مجزوء الرجز"],[605,"","https://poetry.dctabudhabi.ae/diwan/poem/216403",""],[605,"","https://poetry.dctabudhabi.ae/diwan/poem/216393",""],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199599","المسحوب"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199586","المسحوب"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77954","البسيط"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114743","السريع"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199634","المسحوب"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60880","السريع"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/26149","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100373","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201647","الخفيف"],[3286,"","https://poetry.dctabudhabi.ae/diwan/poem/28231","الكامل"],[3314,"","https://poetry.dctabudhabi.ae/diwan/poem/216563",""],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102972","الكامل"],[4755,"السلام على ثأري الهارب","https://www.poetsgate.com/ViewPoem.aspx?id=201770",""],[4816,"عادة الحب","https://www.poetsgate.com/ViewPoem.aspx?id=8459",""],[4929,"لصوص في منعطف التأريخ","https://www.poetsgate.com/ViewPoem.aspx?id=199532",""],[5232,"يا عودُ","https://www.poetsgate.com/ViewPoem.aspx?id=213107",""],[5273,"العود","https://www.poetsgate.com/ViewPoem.aspx?id=28768",""],[5277,"جُبٌّ...ولا دِلَاء","https://www.poetsgate.com/ViewPoem.aspx?id=199916",""],[5307,"يا عويد البان","https://www.poetsgate.com/ViewPoem.aspx?id=10540",""],[5357,"جيت أشتكي لك","https://www.poetsgate.com/ViewPoem.aspx?id=15717",""],[5376,"الدهرُ أمتعنا بالرود والغيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=188404",""],[5461,"عَزّ القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=5233",""],[5652,"رماد إنسان","https://www.poetsgate.com/ViewPoem.aspx?id=178409",""],[5725,"ذكرى","https://www.poetsgate.com/ViewPoem.aspx?id=211771",""],[5956,"ذهب القطينُ إلى جنازتها","https://www.poetsgate.com/ViewPoem.aspx?id=196839",""]],"verses":[["يا عَوفُ أَحلَمَ كُلِّ ذي","حِلمٍ وَأَقولَ كُلِّ قائِل",0,"ل",1,0],["يا عَوفُ كُنتَ إِمامَنا","وَبَقِيَّةَ النَفَرِ الأَوائِل",0,"ل",1,0],["يا عِوَضي مِن عَوَضي","وَصِحَّتي مِن مَرَضي",1,"ض",2,1],["يا عُوذةَ الدارِ التي أُنعِمتْ","عليه بل يا بومة الدارِ",2,"ر",1,0],["يا عَونَ مَن غَدَرَت بِهِ أَيّامُهُ","وَمُعينَ مَن تَنبو بِهِ أَوطانُهُ",3,"ن",2,0],["يا عَوفُ وَيحَكَ هَلّا قُلتَ عارِفَةً","مِنَ الكَلامِ وَلَم تَتبَع بِهِ طَبِعا",4,"ع",2,1],["يَاعِوضَاً مِنْ فَائِتٍ","لِمْ يُحْتَسَبْ مِنْهُ عِوَضْ",5,"ض",1,1],["يا عَوَضْ لو كنت مِتْخيِّرْ","وانْ كلٍّ والي شورَهْ",6,"ر",2,1],["يا عَوَضْ سِرْ بالخِبَرْ عاني","إعتِذر لي واطْلُبِ الزَلّهْ",7,"ل",2,1],["يا عوقٍ في حشايه","كلما كتمته باح",8,"ح",1,0],["يا عون من نادى لي","باسمي ولو غلطان",9,"ن",1,1],["يا عون أَهل الصبر","يا نطق أَهل الصمت",10,"ت",1,0],["يا عَوضُ ما أَعجَلَ ما عُضتَهُ","حمامَةً ناصعةً مِن حُمَم",11,"م",1,0],["يا عونة الله ذاب قلبي وانا لوب","ما نلت منه الا الشقا والتراحي",12,"ح",2,0],["يا عونُ مَنْ مثلكض مشبِةٌ","أباك بل جدَّك باني العُلا",13,"ل",2,0],["يا عودُ مِن أَيَّةِ الأَشجارِ أَنتَ فَلا","جَفا ثَراها وَلا اَعضاءَها الماءُ",14,"ا",2,1],["يا عولة العرب التي من بعده","ملأت عليه الدهر بالاعوال",15,"ل",1,0],["يا عويناتيَ التي قلتُ ضاعت","وهي معقودة بعيني وأُذني",16,"ي",1,1],["يا عَوفُ وَيَحَكَ فيما تَأخُذُ صِرمَتي","وَلَكُنتُ أَسرَحُها أَمامَكَ عُزَّبا",17,"ب",2,0],["يا عُود يَا تَايه يَا مَيّاسْ","رِف بالطَّهَف والشمس وبنا",18,"ن",2,0],["يا عود أحمد عد بكل جميلة","كالشمس جارية على المعتاد",19,"د",1,0],["يا عُواءَ المَجانِينِ في اللَّيلِ إِذ","يَغمِسُ البَردُ رِجلَيهِ في الحَالِبِ",20,"ب",1,0],["يا عونك اللي في الحشى مشيد ساس","لك بالمحبه عهد باقي ومضمون",21,"ن",1,0],["يا عورةَ التاريخ في يعربٍ","ومجمع الامثال في المنذله",22,"ل",2,0],["يا عُودُ رنِّمْ فمنْ شَوق ِ الهوى فينا","صَبْرٌ على غربة ِالأيامِ تكفينا",23,"ن",2,1],["يا عودُ ذقنا منَ الأيَّام غُربتها","وغربة ُ الرُّوح ِ قدْ أدْمَتْ مآقينا",23,"ن",2,0],["يا عُودُ رنِّمْ لعلَّ الصَّوت َ يُنسينا","ما غصَّ بالقلب ِ مِنْ أحلام ِ ماضينا",23,"ن",2,0],["يا عودُ فؤادي ليسَ لهُ","إلاكَ رفيقٌ في السهرِ",24,"ر",1,0],["يا عودَ قلبي والسنينُ رواجعٌ","والبانُ عودُ الأغنياتِ الراحلهْ",25,"ل",2,0],["يا عويد البان يا خلي","يا فريد الحسن باخوانه",26,"ن",2,1],["يا عونة الله ما بقى شي ما راح","مدري ألوم الوقت والا ألومك",27,"ك",1,0],["يا عود زان على الأعطاف بهرجه","يميس بالقد في ملبوس أملودِ",28,"د",1,0],["يا عونة الرحمن وين النكوفه","لين انتحىٰ الخفّاق وش عاد يثنيه",29,"ي",2,0],["ياعون مالي في قسى الوقت فرعون","ونفوس تقسى كل صبح وعشية",30,"ي",2,0],["يا عود البان كفى عتبُ","قد بان بعينك أغلبهُ",31,"ب",2,0],["يا عَونَ أسرتها التي انفجعت بها","حملتْ متاعبَ أسوإ الأخبارِ",32,"ر",1,0]]}