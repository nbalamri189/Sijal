3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77007","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77009","المجتث"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77134","الطويل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77070","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77006","الطويل"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199119","الرجز"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119639","الطويل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119604","البسيط"],[4189,"","https://poetry.dctabudhabi.ae/diwan/poem/102741","الطويل"],[4224,"","https://poetry.dctabudhabi.ae/diwan/poem/146101","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94468","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94332","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94801","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94791","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81718","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83401","الطويل"],[4480,"","https://poetry.dctabudhabi.ae/diwan/poem/28939","الطويل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33637","السريع"],[4560,"","https://poetry.dctabudhabi.ae/diwan/poem/143253","الهزج"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120367","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139551",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139729",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139693",""],[4629,"","https://poetry.dctabudhabi.ae/diwan/poem/75797","الطويل"],[382,"","https://poetry.dctabudhabi.ae/diwan/poem/112010","الوافر"],[4641,"","https://poetry.dctabudhabi.ae/diwan/poem/28807","الطويل"],[4660,"","https://poetry.dctabudhabi.ae/diwan/poem/143982","الطويل"],[4727,"هَراق عليه العشقَ فهو غريقُ.","https://www.poetsgate.com/ViewPoem.aspx?id=208845",""],[4767,"مهوى القلوب","https://www.poetsgate.com/ViewPoem.aspx?id=178758",""],[669,"ففاروق بين الهدى والضلال","https://www.poetsgate.com/ViewPoem.aspx?id=19348",""],[4932,"قضى وَلم يقْض من أحبابه أرباً","https://www.poetsgate.com/ViewPoem.aspx?id=189376",""],[5057,"خاصمتها","https://www.poetsgate.com/ViewPoem.aspx?id=183939",""],[585,"سلوه وقد مال السرير المطنب","https://www.poetsgate.com/ViewPoem.aspx?id=161851",""],[585,"ذكرت له أيامنا فتنهدا","https://www.poetsgate.com/ViewPoem.aspx?id=161845",""],[5183,"لشيخ الشريعة","https://www.poetsgate.com/ViewPoem.aspx?id=180209",""],[5183,"عُمان","https://www.poetsgate.com/ViewPoem.aspx?id=186489",""],[5212,"فَقدَ الجَّواد","https://www.poetsgate.com/ViewPoem.aspx?id=212103",""],[592,"إلى الله نشكو إننا بمحلة","https://www.poetsgate.com/ViewPoem.aspx?id=128840",""],[592,"تلألأ نور الحق في الخلق وانتشر","https://www.poetsgate.com/ViewPoem.aspx?id=128721",""],[592,"سفاسط أملاها الغبي وسطرا","https://www.poetsgate.com/ViewPoem.aspx?id=128722",""],[592,"وقفت على نظم حوى الكفر والشرا","https://www.poetsgate.com/ViewPoem.aspx?id=128720",""],[5410,"انتظار","https://www.poetsgate.com/ViewPoem.aspx?id=139635",""],[5431,"رأيت الله","https://www.poetsgate.com/ViewPoem.aspx?id=183076",""],[5442,"لعل حداة العيش أن يترفقوا","https://www.poetsgate.com/ViewPoem.aspx?id=114754",""],[5536,"إلى هوازن من عدنان منتسبي","https://www.poetsgate.com/ViewPoem.aspx?id=37054",""],[5582,"أَتَجْحَدُ داءَ الحُبِّ عِنْدَ المُشاهِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=186906",""],[5605,"مصائب حب","https://www.poetsgate.com/ViewPoem.aspx?id=159789",""],[5770,"ذكرت لوزان","https://www.poetsgate.com/ViewPoem.aspx?id=178266",""],[5910,"تَطاولَ ليلي","https://www.poetsgate.com/ViewPoem.aspx?id=206227",""],[6093,"اللومُ عنديَ أنْ تفنى على طللِ (البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176200",""],[6102,"مرثية كل يوم","https://www.poetsgate.com/ViewPoem.aspx?id=185050",""],[549,"الفارس والصهيل المكسر","https://www.poetsgate.com/ViewPoem.aspx?id=203001",""],[5309,"وشحرور ايك كم تغنى بألحاني","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573789",""],[242,"ذكرتك والبحر طلق المحيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563774",""]],"verses":[["فَفاقوا في المَراتِبِ وَالمَعالي","وَفُقنا في الضَرائِبِ وَالسَجايا",0,"ا",3,0],["فَفارَقَها وَالمُلكَ لَمّا رَآهُما","يَجُرّانِ إِذلالَ النُفوسِ الكَرائِمِ",1,"م",1,0],["فَفارَقَ هَذا الأَبلَقَ الفَردَ بَغتَةً","وَوَدَّعَ ذا بَعدَ النَعيمِ الخَوَرنَقا",2,"ق",2,0],["ففازَ غياثُ الدّينِ منكَ بِصارِمٍ","على عاتِقِ العَلْياءِ منهُ الحَمائِلُ",3,"ل",1,0],["ففازَ بِما يهْواهُ منْ فضْلِ ربِّه","وأمُّ الذي يهْوى لهُ الشّرُّ هاوِيَهْ",4,"ه",1,0],["فَفاضَت دُموعي كَفَيضِ الغُرو","بِ إِمّا وَكَيفاً وَإِمّا اِنحِدارا",5,"ر",2,0],["فَفاضَت دُموعُ العَينِ مِنّي صَبابَةً","عَلى النَحرِ حَتّى بَلَّ دَمعِيَ مِحمَلي",6,"ل",2,0],["فَفَارَقُوهَا وَظَلَّتْ","تَسْتَوَقِفُ الآسِفِينَا",7,"ن",2,0],["ففاجأنا الطليان من بَعد مُلكهم","لكي يسلبونا في طرابلس الأمرا",8,"ر",2,0],["ففارت ملياً فيه ثم تصعّدت","بخاراً بانبيق من السحر والنَفث",9,"ث",1,0],["ففاجأتنا يدُ التفريقِ مسفرةً","عن سفرةٍ طال فيها شجوُ مرتقب",10,"ب",1,0],["فَفارَقنَ الخَليطَ عَلى سَفينٍ","تَشُقُّ بِهِنَّ أَمواجاً صِعابا",11,"ب",2,0],["فَفاءَت كَما فاءَت مِنَ الأُدمِ مُغزِلٌ","بِبيشَةَ تَرعى في أَراكٍ وَحُلَّبِ",12,"ب",1,0],["فَفاضَت خُمورٌ وَسالَت دُموعٌ","وَشَعَّث بُروقٌ وَلاحَت صُوَر",13,"ر",1,0],["فَفارَقَ الدُنيا وَلَمّا تَزَل","فيها خُمورٌ وَأَغاريدُ",14,"د",1,0],["فَفاتيني إِلى حَكَمٍ مِنَ اَهلي","وَأَهلِكِ لا يَحيفُ وَلا يَميلُ",15,"ل",1,0],["ففاجأها موت فراحت وخلفها","يشب ضراماً قلب عاشقها الصب",16,"ب",1,0],["ففازَ لديهِ الذئبُ يوماً بخلوةٍ","فقال كفاكَ الثعلبُ اليومَ مطعما",17,"م",2,0],["فَفاجَأَتكَ بِرِفقٍ لَم يُذِقكَ ضَنىً","وَلَم تُقاسِ بِها في مَرضَةٍ أَلَما",18,"م",2,0],["فَفاضَ بِالدرِّ ثَدياها وَقَد غَنِيَت","لَيالياً وَهيَ لَم تطعَم وَلَم تَنَمِ",19,"م",1,0],["ففازَ منْ حجرٍ عظيمٍ وهلْ","يرضى بضربِ الحجرِ وهْو الرشيدْ",20,"د",1,0],["فَفاضَت عَبرَةٌ مِنها","فَكادَ الدَمعُ يُبكينا",21,"ن",2,0],["فَفاجَأنَني غَيرَ ذي غِرَّةٍ","شَديدَ الفَقارَةِ بَعدَ النَهَل",22,"ل",1,0],["ففَارقَهم على سُخْطٍ وضِغْنٍ","ورَاحَ يقولُ لا نِعْمَ القبيلُ",23,"ل",1,0],["ففاضتْ نفسُه نوراً عليها","وماج الجوُّ وامتدَّ العُباب",24,"ب",1,0],["فَفاضَت عَبرَةٌ أَشفَقتُ مِنها","تَسيلُ كَأَنَّ وابِلَها الفَريدُ",25,"د",1,0],["فَفارِق إِلى اللَهِ الجَديدَينِ راضِياً","وَلا تَعقِدِ الأَدناسَ في سَمَليكا",26,"ك",2,0],["فَفارَت لَهُم يَوماً إِلى اللَيلِ قِدرُنا","تَصُكُّ حَرابِيَّ الظُهورِ وَتَدسَعُ",27,"ع",1,0],["ففازَ حِزْبُ اللَّهِ بالعِلْجانِ","وانهزمتْ بِطانةُ الشَّيطانِ",28,"ن",1,0],["فَفَاجَأَهَا وقَد جَمَعَت جُموعاً","عَلَى أَبوابِ حِصنٍ مُصلتينا",29,"ن",2,0],["فَفَاجَأَهُمْ هَابِطٌ كَالْقَضَا","ءِ فِي شَكْلِ غَضِّ الصَّبِي أَمْرَدِ",30,"د",1,0],["فَفَاضَتْ بَجَدْواكَ العقولُ وَبلَّلتْ","بمصْرَ ظمِاءً كان حَرَّقَها الصَّدَى",31,"د",2,0],["ففاضت عبرة ٌ أشفقت منها","تيسل كأن وابلها الفريد",32,"د",1,0],["ففاجاهم هابطا كالقضا","في شكل غض الصبا امرد",33,"د",1,0],["ففاضتْ دُموعُ العين مني صبابة","على النحر حتى بدل دَمْعِىَ محملي",34,"ل",2,0],["ففارقنا من لا يريدُ فِراقنا","وقاربنا من لا نراهُ يَشُوقُ",35,"ق",1,0],["ففارقتنا عمداً ونحن بحاجة","لمن ينصف التاريخَ فينا ويحكم",36,"م",1,0],["فَفاتَهُمُ بِعَزمِكَ ما أَرادوا","وَآلَ بِهِم إِلى ما لَم يُريدوا",37,"د",3,0],["فَفاهَ بِوَصفِكَ مَن لا يَمينُ","وَخَبَّرَ عَن سُؤدُدٍ مَن خَبَر",38,"ر",1,0],["فَفازَ بِكَسرٍ عَجَّلَ اللَهُ جَبرَهُ","وَأَعقَبَهُ الكَسرُ الَّذي لَيسَ يُجبَرُ",39,"ر",1,0],["فَفاضَت دُموعٌ لا تَقومُ بِحَقِّهِ","وَلَو نَزَحَت أَمواهَ دِجلَةَ أَجمَعا",40,"ع",2,0],["فَفازوا مِنَ البَحرِ الَّذي جُبتِ لُجَّهُ","إِلى الحَمدِ بِالمَوجِ الَّذي أَغرَقَ السُفنا",41,"ن",2,0],["ففاضت دموعي على وجنتي","وأبديت للبين ما اكتم",42,"م",1,0],["ففاز بالوصل هذا الآن دونهم","ولم يخبه رجىً فيكم ولا أمل",43,"ل",1,0],["ففاتت حصون لا يبالى بفوتها","ورد له ما فوته قاصم الظهر",44,"ر",1,0],["ففازَ منهُ بركنٍ غيرِ منُهدمٍ","عندَ الخطوبِ وحَبلٍ غيرِ مُنْبَتِكِ",45,"ك",1,0],["فَفاضِلٍ غَيرِ خَوّارٍ وَلا وَكلٍ","في الكائِناتِ وَلا وانٍ وَلا وَعِبِ",46,"ب",1,0],["فَفاضَت عَليهِ مِن مَعارفِ شَيخنا","سُيولٌ أَرتهُ علمهُ عندهُ قَطرا",47,"ر",2,0],["فَفَازَ بإسلامٍ وأرواهُ جعفرٌ","وَأَجرى على عمرٍو بتوبيخه نهرا",48,"ر",2,0],["فَفازَ بالحقِّ حُكماً غير منتقضٍ","لَهُ بِصفحةِ هذا الدهر تسجيلُ",49,"ل",1,0],["ففاضَ بمدحها دمعي","ونطقُ الطفلِ أن يبكي",50,"ك",2,0],["ففازت بها رغم مطلي لها","مطرزة ليس فيها وقع",51,"ع",1,0],["فَفاءُوا إلى الحُسنى ولو لَم تَحُجُّهُم","لَعادَت زَئيراً صَيحَةُ القَومِ داوِيا",52,"ي",2,0],["ففاض دمعي سروراً","وذابَ قلبي كُلُوما",53,"م",2,0],["ففاضِلْ ملوكَ الأَرض تَفْضُلْهُم عُلاً","وسابقْهُمُ في الفخرِ تَظْفَر وتَسْبِقِ",54,"ق",1,0],["ففاطمة الزهراءُ تُفْديك يابْنَها","وتسأل أن تَبْقَى ويبقَى لك العُمْرُ",55,"ر",1,0],["فَفاجَأَهُ مِن أَوَّلِ الرَأيِ غُدوَةً","وَلَمّا يُسَكِّنهُ إِلى الأَرضِ مَرتَعُ",56,"ع",1,0],["فَفاجَأَتهُ وَلَم يَرهَب فُجاءَتَها","غُضفٌ نَواحِلُ في أَعناقِها القِدَدُ",57,"د",1,0],["فَفاضَت دُموعُ العَينِ حَتّى رأَيتَني","تَلفَّتُّ نحو الدارِ لا أَستَبينُها",58,"ن",3,0],["ففارقت صحبي والأقارب والحما","وكم انعمٍ يمرى على البعد ضرعها",59,"ع",3,0],["فَفاضَت دموعي بعدَ طولِ انحباسِها","ومنها لنفسي راحةٌ وعزاء",60,"ا",2,0],["فَفاضَت على العافين كفُّ نَواله","فَكَم كفَّ من عُسرٍ وكم فَكَّ من أَسرِ",61,"ر",1,0],["فَفاءَت بعدَ أَن زاغَت لهديٍ","قلوبٌ وَاِنسرى الظنُّ الفنودُ",62,"د",1,0],["فَفاخِر به ما شئت من دولٍ على","ففخرُ إِيالاتِ الممالكِ صيدُها",63,"د",3,0],["ففاتحة الكتاب فإن فيها","لما أملت سراً أي سر",64,"ر",1,0],["فَفاضَت دُموعي في الرِداءِ كَأَنَّما","عَزالى شَعيبَي مُخلِفٍ وَكُلاهُما",65,"م",2,0],["فَفاءَت إِلى قَومٍ تُريحُ رِعاؤُهُم","عَلَيها اِبنَ عِرسٍ وَالإِوَزَّ المُكَفَّرا",66,"ر",2,0],["فَفازَ بِنَهبٍ فيهِ مِنهُم عَقيلَةٌ","لَها بَشَرٌ صَافٍ وَرَخصٌ مُخَضَّبُ",67,"ب",1,0],["ففارقَ فَرقَدُ العَلْيا أَخاهُ","وأُفرِدَتِ اليَمينُ عنِ الشِّمال",68,"ل",1,0],["ففاءوا بالفصاحة مذ تَردَّوا","رداءً بالمعالي قد تلالا",69,"ل",2,0],["ففاجتهم على ذُعرٍ رجالٌ","سَراةٌ لا يهابون الرجالا",69,"ل",2,0],["فَفاضَت لَها عَين لتذكار ما مَضى","سَكوب شُؤُن الماقيين نُضوح",70,"ح",1,0],["ففارقته كرهاً وقلبيَ خافق","ودمعي على خدي عقود لآلي",71,"ل",2,0],["ففارقني دمعي وصبري وودَّعا","فلم أدر أيَّ الظاعنين أودع",72,"ع",1,0],["ففاز منك بأَفعالٍ تُزَيِّنُهُ","كما يُزَيِّنُ عِقْدٌ جِيدَ مِعْطَالِ",73,"ل",1,0],["ففازَ بنورِ الرَّبِّ يدعو إِلى الهُدَى","ويُحْيي لنا المَوْتَى ويُبْرِي من السُّقْمِ",74,"م",1,0],["فَفَاحَ تَضَوُّعُ ذا من ضَياعِي","كَمَا لاحَ مَطْلَعُ ذا من غُرُوبِي",75,"ب",2,0],["ففازَ قِدحُكَ بالفتحِ المُبِينِ ضُحىً","والكُفْرُ مُنْتَهَبُ الأَقطارِ مُنتَسفُ",76,"ف",1,0],["ففارَقْنَ الديارَ بلا وداعٍ","ولاقَيْنَ الوجوهَ بِلا سلامِ",77,"م",1,0],["فَفازُوا بِنَفْسي غَيْرَ جُزْءٍ ذَخَرْتُهُ","لِما شَفَّ مِنْ خَطْبٍ وَمَا مَسَّ مِنْ ضُرِّ",78,"ر",1,0],["ففازَ بالعِزِّ من نادى بِبَيْعَتِكُمْ","وبَاءَ بالخِزْيِ هَيَّانُ بنُ بَيَّانا",79,"ن",2,0],["ففاز بالشرف الأعلى وقد محضت","وأبلغت كل ذي روحٍ رسالته",80,"ت",2,0],["ففاء وقد أعطي الرسالة راقياً","مطارح قد كان منه يريدها",81,"د",3,0],["ففارقته حزناً بقلب معذب","وأرمدت طرفاً بالبكا غير أرمد",82,"د",1,0],["ففاز سمعك مئناس القريض بها","فليس يألوك إِبداعاً وتهذيبا",83,"ب",2,0],["ففاز بعذرها وأوتْ أيامَى","إلى كنَفَين من بخلٍ وجُبنِ",84,"ن",1,0],["ففاتهم فوتَ الزعازعِ أعصفَتْ","هُبوباً وقالت للطَّلوبِ ألا الحقِ",85,"ق",1,0],["ففاقَ عُلا آبائه وعُلاهُمُ","تٌقِرُّ بها يومَ الفخارِ القبائلُ",86,"ل",1,0],["ففارقتُ منه فارس البأس والنَّدى","إذا ما دعاهُ مُسْتجيرٌ ومُعْدِمُ",87,"م",1,0],["ففارسُ الخيل نجم الدين من كرمٍ","بالمدح مني جديرٌ عِرْضهُ قَمِن",88,"ن",1,0],["ففاز بهم وليس لهم","على الأيام مقتَرَح",89,"ح",1,0],["ففاخِر به مَن شئتَ لمَّا بَدا لهم","بِيُمنَاك هذاك الحُسامُ المهنَّدُ",90,"د",1,0],["ففاجأهم داعي المنية هادماً","قصوراً بهم كانت تضيء وتزهر",91,"ر",1,0],["ففالج بيَ مَن شئتَ","فما واللهِ ما تُفلَج",92,"ج",1,0],["فَفارَقتُ الأحَمَّ ولَم اُعَرِّج","عَليهِ فِراقَ قابيةٍ لِقوب",93,"ب",1,0],["ففازَ بها منهم عليٌّ وسادَهُم","وما ذاكَ من عاداتهِ بغريبِ",94,"ب",1,0],["ففازَ قِدماً بها واللهُ أكرَمُهُ","وكان سبّاقَ غاياتٍ إذا ابتَدَروا",95,"ر",3,0],["فَفاز مِن الأَوطان بِالشُكر وَالثَنا","وَأَومى إليه سعدُه ببنان",96,"ن",1,0],["فَفازَ تَحتَ ظِلال العَدل مِنكَ بِما","قَد كانَ يَبغى وَفي