{"poems":[[53,"تأبى الليالي أن تديما","https://www.aldiwan.net/poem29749.html","مجزوء الكامل"],[55,"إني لأحسب والأقدار غالبة","https://www.aldiwan.net/poem26409.html","البسيط"],[24,"هل حبل رملة قبل البين مبتور","https://www.aldiwan.net/poem21897.html","البسيط"],[88,"من سامع قصة لي كنت شاهدها","https://www.aldiwan.net/poem45041.html","البسيط"],[27,"قل للديار سقى أطلالك المطر","https://www.aldiwan.net/poem5764.html","البسيط"],[45,"أجدر وأخلق أن ترن عوائدي","https://www.aldiwan.net/poem63548.html","الكامل"],[66,"ما زال كحل النوم في ناظري","https://www.aldiwan.net/poem39669.html","السريع"],[66,"ما كنت أعلم والضمائر تنطق","https://www.aldiwan.net/poem40644.html","الكامل"],[102,"تحية لك يا مصر الفراعين","https://www.aldiwan.net/poem33034.html","السريع"],[50,"هل من رسول مخبر","https://www.aldiwan.net/poem64796.html","مجزوء الرجز"],[46,"يا ساهر البرق أيقظ راقد السمر","https://www.aldiwan.net/poem23634.html","البسيط"],[15,"أنبئت أن بني جديلة أوعبوا","https://www.aldiwan.net/poem45285.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141937","البسيط"],[95,"عودي","https://www.poetsgate.com/ViewPoem.aspx?id=720",""],[106,"تقدير أديب","https://www.poetsgate.com/ViewPoem.aspx?id=179698",""],[106,"زفاف الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179500",""],[106,"هل عاد قيس؟","https://www.poetsgate.com/ViewPoem.aspx?id=179386",""],[167,"كم أرجع الزفرات في أحشائي","https://www.aldiwan.net/poem1594.html",""],[183,"هذا الفراق وهذه الأظعان","https://www.aldiwan.net/poem14686.html","الكامل"],[183,"لا غرو أن رحل الشباب وبانا","https://www.aldiwan.net/poem14688.html","الكامل"],[195,"صهرت في قدح الصهباء أحزاني","https://www.aldiwan.net/poem39945.html","البسيط"],[227,"ما استحسن الحب حتى استقبح العذل","https://www.aldiwan.net/poem50848.html","البسيط"],[247,"لمن الديار غشيتها بالأنعم","https://www.aldiwan.net/poem2093.html","الكامل"],[257,"بمدام أنس مقام إبراهيما","https://www.aldiwan.net/poem35807.html","الكامل"],[269,"أعلمت من ركب البراق عتيما","https://www.aldiwan.net/poem52097.html","الكامل"],[273,"كأننا لم نصل تلك الأصائل في","https://www.aldiwan.net/poem25500.html","البسيط"],[340,"أيا ضباب حياتي","https://www.aldiwan.net/poem55343.html","المجتث"],[392,"قالوا بياض الشيب نور ساطع","https://www.aldiwan.net/poem3670.html","الكامل"],[403,"قولا له هل دار في حوبائه","https://www.aldiwan.net/poem50212.html","الكامل"],[451,"رف الربيع على الشتاء الماحل","https://www.aldiwan.net/poem61771.html","الكامل"],[456,"سأل اللوى وسؤاله إلحاف","https://www.aldiwan.net/poem56110.html","الكامل"],[466,"أستودع الله ظبيا كان يلبسني","https://www.aldiwan.net/poem60327.html","البسيط"],[549,"أعلى الركائب سارت الأحداج","https://www.aldiwan.net/poem48017.html","الكامل"],[573,"شربت شرب الهيم","https://www.aldiwan.net/poem3010.html","مجزوء الرجز"]],"verses":[["حَتّى سَما فَحَدا بِها","بَزلاءَ ناجِيَةً سَعوما",0,"م",2,0],["حَتّى سَعَت بَينَنا يا فَوزُ ساعِيَةٌ","مَشهورَةٌ عُرِفَت بِالنَفثِ في العُقَدِ",1,"د",1,0],["حَتّى سَقى اللَيلَ سَقيَ الجِنِّ فَاِنغَمَسَت","في جَوزِهِ إِذ دَجا الآكامُ وَالقورُ",2,"ر",1,0],["حتى سألت عن الباكي وقصته","فقيل هذا هو الشعر ابن جبران",3,"ن",1,0],["حَتّى سَمِعتُ بِخِنزيرٍ ضَغا جَزَعاً","مِنهُم فَقُلتُ أَرى الأَمواتَ قَد نُشِروا",4,"ر",3,0],["حَتّى سَمِعتُ عَنِ الضَغائِنِ قَولَهُم","وَفِعالَهُم فِعلَ الظَلومِ الحاسِدِ",5,"د",1,0],["حَتّى سَرَقتَ الغُمضَ مِن مُقلَتَي","يا سارِقَ الكُحلِ مِنَ العَينِ",6,"ن",1,0],["حَتّى سَمِعتُ بِذِكرِكُم فَهَوَيتُكُم","وَكَذاكَ أَسبابُ المَحَبَّةِ تَعلَقُ",7,"ق",1,0],["حَتّى سمت ليَ جنات النَخيل عَلى","ضفاف مطرد النَعماءِ مَيمون",8,"ن",1,0],["حَتّى سَقَيناها وَما","نَبدَهُ نَهرَي حَلَبِ",9,"ب",1,0],["حتى سطَرْنا بها البَيْداءَ عن عُرُضٍ","وكلُّ وَجْناءَ مثْلُ النّونِ في السَّطَرِ",10,"ر",1,0],["حَتّى سَقَيناهُم بِكَأسٍ مُرَّةٍ","فيها المُثَمَّلُ ناقِعاً فَليَشرَبوا",11,"ب",3,0],["حتى سفرت على أشلائها قمراً","ونور وجهك يطفو في نواحيها",12,"ي",3,0],["حتى سمعت ورائي رجع زفرتها","حتى لمست حيالي قدها اللدنا",13,"ن",2,0],["حتى سعى نحوَك التَّقديرُ متَّئِدًا","ولم تكن أنتَ للتقدير مُرتقبا",14,"ب",2,0],["حتى سألتُ: أمصر في شرخ الصبا","أم مصر أقدم من ثمودَ وعاد؟",15,"د",1,0],["حتى سألتُ: أعاد قَيْ","سٌ، قيسُ ليلى، من سَفر؟",16,"ر",1,0],["حَتّى سَقوا عَلَلاً صُدورَ سُيوفِهِم","عَلَقاً يُبَرِّدُ غُلَّةَ الشَحناءِ",17,"ا",2,0],["حتى سموتُ إلى رفيعٍ يبصر ال","إنسانَ في صَفحاته الإنسان",18,"ن",1,0],["حتى سبقتُ السابقين لشَأوِها","وحويت أوطارا وحُزْتُ رِهانا",19,"ن",2,0],["حتّى سَكَبت على ذِكراهُ أغنيةً","من وَحيِ بُؤسي ومن إلهامِ خِرماني",20,"ي",1,0],["حتّى سَقَى دارَهُمْ من صَوْبِه دِيَماً","فِيها لغُلَّةِ أكبادِ الثَّرَى عَلَلُ",21,"ل",1,0],["حَتّى سَقَينا الناسَ كَأساً مُرَّةً","مَكروهَةً حُسُواتُها كَالعَلقَمِ",22,"م",1,0],["حتّى سكرنا في بديع شرابه","وغدا لنا مدح الجناب نديما",23,"م",2,0],["حَتّى سَما فوق السماء قدوما","ودنا فكلم ربه تَكليما",24,"م",2,0],["حَتَّى سَمَا الصُّبْحُ لِلظَّلْماءِ يَصْدَعُها","كالسَّيْلِ فَاضَ عَلَى مُخْضَرَّةِ الدِّمَنِ",25,"ن",1,0],["حتى سئمت حياتي","وعفت ذاتي وحالي",26,"ي",1,0],["حتى سرت وخطاته في مفرقي","فوددت أن لا أفقد الظلماء",27,"ا",2,0],["حَتّى سُيوفٌ رِجالِهِ وَهيَ القَضا","أَشوا جِراحاً مِن عُيونِ نِسائِهِ",28,"ا",3,0],["حتى سكنت الى الممات وطالما","قد كنت تهزأ بالممات الهازل",29,"ل",1,0],["حتى سلا صبٌّ وأعرض مقبلٌ","عني وأنكر خابرٌ عرَّافُ",30,"ف",1,0],["حَتّى سَعى بَينَنا بَينٌ فَفَرَّقنا","فَصارَ يَأجوجُ لَيلى بَعدَهُ عوجا",31,"ج",2,0],["حتّى سوَيعاتُ السّرور قصيرةٌ","فيكمْ ووضعُ الحاملاتِ خِداجُ",32,"ج",1,0],["حتَّى سمعتُ بفمِي","التَّسليمَ من تَسْنِيم",33,"م",1,0]]}