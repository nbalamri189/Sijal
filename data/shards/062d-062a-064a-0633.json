What=shqas&qid=60147&r=&rc=203",""],[6259,"قولا له هل دارَ في حوبائهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59352&r=&rc=0",""],[6267,"بَانَتْ لُبَيْنَى فَهَاجَ القَلْبَ مَنْ بانا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=8334&r=&rc=43",""],[6355,"عام رحل","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66623&r=&rc=83",""]],"verses":[["حَتّى سَما فَحَدا بِها","بَزلاءَ ناجِيَةً سَعوما",0,"م",2,0],["حَتّى سَعَت بَينَنا يا فَوزُ ساعِيَةٌ","مَشهورَةٌ عُرِفَت بِالنَفثِ في العُقَدِ",1,"د",1,0],["حَتّى سَقى اللَيلَ سَقيَ الجِنِّ فَاِنغَمَسَت","في جَوزِهِ إِذ دَجا الآكامُ وَالقورُ",2,"ر",1,0],["حتى سألت عن الباكي وقصته","فقيل هذا هو الشعر ابن جبران",3,"ن",1,0],["حَتّى سَمِعتُ بِخِنزيرٍ ضَغا جَزَعاً","مِنهُم فَقُلتُ أَرى الأَمواتَ قَد نُشِروا",4,"ر",3,0],["حَتّى سَمِعتُ عَنِ الضَغائِنِ قَولَهُم","وَفِعالَهُم فِعلَ الظَلومِ الحاسِدِ",5,"د",1,0],["حَتّى سَرَقتَ الغُمضَ مِن مُقلَتَي","يا سارِقَ الكُحلِ مِنَ العَينِ",6,"ن",1,0],["حَتّى سَمِعتُ بِذِكرِكُم فَهَوَيتُكُم","وَكَذاكَ أَسبابُ المَحَبَّةِ تَعلَقُ",7,"ق",1,0],["حَتّى سمت ليَ جنات النَخيل عَلى","ضفاف مطرد النَعماءِ مَيمون",8,"ن",1,0],["حَتّى سَقَيناها وَما","نَبدَهُ نَهرَي حَلَبِ",9,"ب",1,0],["حتى سطَرْنا بها البَيْداءَ عن عُرُضٍ","وكلُّ وَجْناءَ مثْلُ النّونِ في السَّطَرِ",10,"ر",1,0],["حَتّى سَقَيناهُم بِكَأسٍ مُرَّةٍ","فيها المُثَمَّلُ ناقِعاً فَليَشرَبوا",11,"ب",3,0],["حتى سفرت على أشلائها قمراً","ونور وجهك يطفو في نواحيها",12,"ي",3,0],["حتى سمعت ورائي رجع زفرتها","حتى لمست حيالي قدها اللدنا",13,"ن",2,0],["حتى سعى نحوَك التَّقديرُ متَّئِدًا","ولم تكن أنتَ للتقدير مُرتقبا",14,"ب",2,0],["حتى سألتُ: أمصر في شرخ الصبا","أم مصر أقدم من ثمودَ وعاد؟",15,"د",1,0],["حتى سألتُ: أعاد قَيْ","سٌ، قيسُ ليلى، من سَفر؟",16,"ر",1,0],["حَتّى سَقوا عَلَلاً صُدورَ سُيوفِهِم","عَلَقاً يُبَرِّدُ غُلَّةَ الشَحناءِ",17,"ا",2,0],["حتى سموتُ إلى رفيعٍ يبصر ال","إنسانَ في صَفحاته الإنسان",18,"ن",1,0],["حتى سبقتُ السابقين لشَأوِها","وحويت أوطارا وحُزْتُ رِهانا",19,"ن",2,0],["حتّى سَكَبت على ذِكراهُ أغنيةً","من وَحيِ بُؤسي ومن إلهامِ خِرماني",20,"ن",2,0],["حتّى سَقَى دارَهُمْ من صَوْبِه دِيَماً","فِيها لغُلَّةِ أكبادِ الثَّرَى عَلَلُ",21,"ل",1,0],["حَتّى سَقَينا الناسَ كَأساً مُرَّةً","مَكروهَةً حُسُواتُها كَالعَلقَمِ",22,"م",1,0],["حتّى سكرنا في بديع شرابه","وغدا لنا مدح الجناب نديما",23,"م",2,0],["حَتّى سَما فوق السماء قدوما","ودنا فكلم ربه تَكليما",24,"م",2,0],["حَتَّى سَمَا الصُّبْحُ لِلظَّلْماءِ يَصْدَعُها","كالسَّيْلِ فَاضَ عَلَى مُخْضَرَّةِ الدِّمَنِ",25,"ن",1,0],["حتى سئمت حياتي","وعفت ذاتي وحالي",26,"ي",1,0],["حتى سرت وخطاته في مفرقي","فوددت أن لا أفقد الظلماء",27,"ا",2,0],["حَتّى سُيوفٌ رِجالِهِ وَهيَ القَضا","أَشوا جِراحاً مِن عُيونِ نِسائِهِ",28,"ا",3,0],["حتى سكنت الى الممات وطالما","قد كنت تهزأ بالممات الهازل",29,"ل",1,0],["حتى سلا صبٌّ وأعرض مقبلٌ","عني وأنكر خابرٌ عرَّافُ",30,"ف",1,0],["حَتّى سَعى بَينَنا بَينٌ فَفَرَّقنا","فَصارَ يَأجوجُ لَيلى بَعدَهُ عوجا",31,"ج",2,0],["حتّى سوَيعاتُ السّرور قصيرةٌ","فيكمْ ووضعُ الحاملاتِ خِداجُ",32,"ج",1,0],["حتَّى سمعتُ بفمِي","التَّسليمَ من تَسْنِيم",33,"م",1,0],["حتى سرى نبأُ الشفاءِ مُباركاً","عيداً لنا فيهِ الشموعُ تُنارُ",34,"ر",1,0],["حتّى سليمان أَتى","وَرآه مِن قصرٍ مشيدِ",35,"د",1,0],["حَتّى سُرِرنا سُروراً لَم نُسرَّ بِهِ","وَلا نُسَرَّ وَقَد طِرنا كَأَرياحِ",36,"ح",1,0],["حتى سبتني بدَل من معاطفها","هيفاءُ رائقةُ الخدين والجيد",37,"د",1,0],["حتى سبقنا أسهُماً طاشت لنا","منهم إلينا بالخيول الضّمر",38,"ر",1,0],["حتى سمعنا وقع خطب سُحرةً","والليلُ فيه للحوادث مرصدُ",39,"د",1,0],["حتى سمعنا اليوم في من حذا","حذو غفولٍ لم يهب لا يميهْ",40,"ي",2,0],["حتى سَمَا الشَّيبُ إِلى مَفْرِقي","كَأَرْقمٍ أَوجَرَني سُمَّهْ",41,"م",2,0],["حتى سمعت كلاما لست اعرفه","كأنه زجل الغربان والبوم",42,"م",1,0],["حتى سقاني الدهر كأس فراقه","فسكرت سكراً لا يفيق خماره",43,"ر",2,0],["حتى سمعت من المعالي نوحها","لبست عليه للحداد ثيابا",44,"ب",2,0],["حتى سطا الصبح على قلبه","بخنجر الفجر فأدماه",45,"ا",2,0],["حتى سئمت وقد تضاءل بالضنى","جسدي ونال الهم من هماته",46,"ت",2,0],["حَتّى سَلَكنَ الشوى مِنهُنَّ في مَسكٍ","مِن نَسل جَوّابَةِ الآفاقِ مِهداجِ