{"poems":[[55,"ما زلت أطرق المنازل بالنوى","https://www.aldiwan.net/poem29737.html","الكامل"],[55,"تأمل أن تفرح في دار الحزن","https://www.aldiwan.net/poem29747.html","الرجز"],[95,"في أي جو بالأسى مفعم","https://www.aldiwan.net/poem11348.html","السريع"],[74,"يا دار جيرتنا بسفح الأجرع","https://www.aldiwan.net/poem19161.html","الكامل"],[74,"في ثغرها الحلو أو في جيدها الحالي","https://www.aldiwan.net/poem19473.html","البسيط"],[53,"لا بدع إن ضحك القتير","https://www.aldiwan.net/poem61997.html","مجزوء الكامل"],[64,"ما بعد يومك للحزين الموجع","https://www.aldiwan.net/poem52353.html","الكامل"],[82,"لو أن ربع غير مندرس","https://www.aldiwan.net/poem31407.html","البسيط"],[69,"وسلن حبقوق المصرح باسمه","https://www.aldiwan.net/poem18080.html","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19016","الكامل"],[261,"قد صخب البم مع الزير","https://www.aldiwan.net/poem48462.html","السريع"],[358,"حمدا لمن جعل التاريخ عقد حلى","https://www.aldiwan.net/poem39584.html","البسيط"],[445,"كسيت بدولتك اليالي نورا","https://www.aldiwan.net/poem34851.html","الكامل"],[463,"أفلح قوم إذا دعوا وثبوا","https://www.aldiwan.net/poem56299.html","المنسرح"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44582","الرجز"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63872","الكامل"],[482,"","https://poetry.dctabudhabi.ae/diwan/poem/62351","البسيط"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84487","الرجز"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/50027","البسيط"],[1624,"","https://poetry.dctabudhabi.ae/diwan/poem/45384","البسيط"],[2332,"","https://poetry.dctabudhabi.ae/diwan/poem/82168","الرجز"],[2610,"","https://poetry.dctabudhabi.ae/diwan/poem/22598","الكامل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108043","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59492","الكامل"],[4163,"","https://poetry.dctabudhabi.ae/diwan/poem/106735","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81690","الكامل"],[4767,"علم الضاد","https://www.poetsgate.com/ViewPoem.aspx?id=178417",""],[4940,"وادٍ غير ذي يَبسٍ","https://www.poetsgate.com/ViewPoem.aspx?id=207468",""],[5155,"الطائفية ..في العهد المباد","https://www.poetsgate.com/ViewPoem.aspx?id=176170",""],[5815,"غصّة","https://www.poetsgate.com/ViewPoem.aspx?id=190032",""],[5909,"شوقٌ إذا حل المساءُ كففته","https://www.poetsgate.com/ViewPoem.aspx?id=210235",""]],"verses":[["مِن كُلِّ دارٍ تَستَظِلُّ رِواقَها","أَدماءُ غانِيَةٌ عَنِ الجيرانِ",0,"ن",1,0],["مِن كُلِّ دَهماءَ لَها هَماهِمٌ","تُلَقَّمُ البازِلَ جُمعاً كَالفَدَن",1,"ن",1,0],["مِنْ كُل دِينٍ كَانَ أَصْحَابُهُ","وَكَانَ حَقَّ المُؤْمِنِ المُسْلِمِ",2,"م",1,0],["من كلّ دائرة القناع على سنا","بدرٍ يراغم بدر كلّ مقنّع",3,"ع",1,0],["من كلّ داعٍ وما جاوبته سقماً","كأنه واقفٌ منِّي بأطلال",4,"ل",1,0],["من كلّ دانية الجَنَى","للطير فيها قَرْقَريرُ",5,"ر",1,0],["من كلِّ دُرِّيِّ الفِرَنْدِ كأنما","حبَّاتُ عِقْدٍ فوقَهُ متقطِّعِ",6,"ع",1,0],["من كلّ دامِيةِ الأخفافِ مرْقلةٍ","ترتاعُ مِنْ صَوْتِ حادٍ خَلْفها شرِسِ",7,"س",1,0],["مِن كلِّ دامِيَةِ الأَيَاطِلِ زِدتُها","عَنَقاً إذا كلَّفْتُها التَّمهِيلا",8,"ل",2,0],["مِن كُلِّ داعي الحَقِّ هِمَّةُ سَيفِهِ","فَلِسَيفِهِ في الراسِياتِ مَضاءُ",9,"ا",2,0],["من كل دن دم أوداجه","أحل من لحم الخنازير",10,"ر",1,0],["مِن كُلِّ دُرّة غَوّاص غلت ثَمَناً","حَتّى عَلَت فَجَلَت نَظماً حَلا مَثَلا",11,"ل",2,0],["من كل دهرٍ لا يزالُ كَأَنَّهُ","لَوْحٌ يلُوحُ بفخْرِكُمْ مَسْطُورا",12,"ر",2,0],["من كلِّ دهماءِ أُنسُها الليلُ تع","زوه إلى لونها وتَنتسِبُ",13,"ب",1,0],["مِن كُلِّ دُبسِيٍّ لَهُ رَنينُ","وَكُلُّ قُمرِيٍّ لَهُ حَنينُ",14,"ن",1,0],["من كل داجي اللونِ إلا غُرَّةٌ","عادتْ دجاهُ عداوةَ النبراس",15,"س",1,0],["مِن كلِّ دعجاءَ قنواءِ اللثامِ لها","لحظٌ بقلبيَ فتاكُ وفتانُ",16,"ن",1,0],["من كُلِّ دُبٍّ طف نقطٌ في الطرف","إن كان كافُه بنصبٍ اتصَف",17,"ف",1,0],["من كل داعية لِللَهو مائِلَةٍ","أذنيك بالحبّ عن نَهي النُّهى صَمَما",18,"م",2,0],["مِن كُلِّ درعٍ نَسيمُ الريحِ غَضَّنَها","وَصارِمٌ بِالحبابِ اِعتاضَ مِن أَثَرِ",19,"ر",1,0],["من كل دهماء زلوج الوقر","يضربن بالأمراس حول البحر",20,"ر",1,1],["مِن كُلِّ دانٍ مُسبِلٍ هَطلٍ","مُتَتابِعٍ سَحٍّ مِنَ الرِّهَمِ",21,"م",1,0],["من كل دمعة فاضل سجمت أسى","تسوى دماً من جفن وغد ساجما",22,"م",2,0],["من كل درفسةٍ أمُونٍ حُرة","تطِسُ الأكام وكلَّ فحلٍ راقلِ",23,"ل",1,0],["مِن كُلِّ دِمرٍ طالَما خاضَ الوَغى","صالٍ بِنيرانِ الحُروبِ مُسَعَّرِ",24,"ر",1,0],["من كلِّ دامي الطَّرف ليس إذا رمى","كفيه في قُتراتِهِ بالمُتْلِج",25,"ج",1,0],["من كل دارٍ زانَها","ثوبُ الكرامة والقِيم",26,"م",1,0],["من كل درب في الفؤاد تساقطت","مني الخطى وتفتَّحت أبوابُ",27,"ب",1,0],["من كل دجال ومن متزعم","جعل الزعامة سلم الاهواء",28,"ا",2,0],["من كلّ داجيةِ الأشْباهِ قدْ جُمِعوا","يحْدو بِهمْ باطلٌ في السرِّ والعلنِ",29,"ن",1,0],["من كل درويشٍ عليّ عباءة","وعليّ يَبلى الوجدُ والأثوابُ",30,"ب",1,0]]}