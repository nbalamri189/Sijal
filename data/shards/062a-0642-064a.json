wan/poem/54397","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94436","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94801","الطويل"],[4308,"","https://poetry.dctabudhabi.ae/diwan/poem/34760","الهزج"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136523",""],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83411","الطويل"],[4510,"","https://poetry.dctabudhabi.ae/diwan/poem/119529","الطويل"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76705","الطويل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141675","الطويل"],[4679,"لعمرك إن كل الناس رهنٌ","https://www.poetsgate.com/ViewPoem.aspx?id=142754",""],[4690,"أمْنيات أسيرة","https://www.poetsgate.com/ViewPoem.aspx?id=120284",""],[4691,"جمالها خريطة للهوى","https://www.poetsgate.com/ViewPoem.aspx?id=186003",""],[4733,"الرَّبيع","https://www.poetsgate.com/ViewPoem.aspx?id=188199",""],[4755,"صنعاء والدولار","https://www.poetsgate.com/ViewPoem.aspx?id=200384",""],[3464,"تحكم بما تهوى لك الحسن مسعدُ","https://www.poetsgate.com/ViewPoem.aspx?id=158768",""],[4847,"قل هو الحب وطن","https://www.poetsgate.com/ViewPoem.aspx?id=175537",""],[4858,"في ظل الحضارة الزائفة","https://www.poetsgate.com/ViewPoem.aspx?id=33863",""],[4859,"وأدت طيفك!","https://www.poetsgate.com/ViewPoem.aspx?id=207181",""],[4878,"مصابك فيه ركن الدين هدا","https://www.poetsgate.com/ViewPoem.aspx?id=170951",""],[4882,"اجبني فحتى الماء فجره الصخرُ_بهاء الدين الخاقاني","https://www.poetsgate.com/ViewPoem.aspx?id=7332",""],[4929,"قراءة دخانية","https://www.poetsgate.com/ViewPoem.aspx?id=207715",""],[4966,"أتوق إليك...","https://www.poetsgate.com/ViewPoem.aspx?id=196714",""],[4984,"لمن تُعزف النجوى ؟","https://www.poetsgate.com/ViewPoem.aspx?id=175545",""],[5030,"يا أعز الناس","https://www.poetsgate.com/ViewPoem.aspx?id=215812",""],[5038,"سرابيل الذنوب","https://www.poetsgate.com/ViewPoem.aspx?id=188436",""],[585,"هل في القطين وراء المنش مستمع","https://www.poetsgate.com/ViewPoem.aspx?id=161904",""],[5183,"العراقين","https://www.poetsgate.com/ViewPoem.aspx?id=180174",""],[5183,"وادي الخيال","https://www.poetsgate.com/ViewPoem.aspx?id=180171",""],[5273,"رسالة إلى المستقبل","https://www.poetsgate.com/ViewPoem.aspx?id=185035",""],[592,"على الحبر بحر العلم الحقائق","https://www.poetsgate.com/ViewPoem.aspx?id=128858",""],[592,"على الحبر بحر العلم بدر المنابر","https://www.poetsgate.com/ViewPoem.aspx?id=128847",""],[592,"لعمرك ما يدري الغبي بأنه","https://www.poetsgate.com/ViewPoem.aspx?id=128805",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5397,"هي الدنيا لها وصل وصد","https://www.poetsgate.com/ViewPoem.aspx?id=157913",""],[5409,"طواك الموت قيثاراً بديعا","https://www.poetsgate.com/ViewPoem.aspx?id=155460",""],[5430,"وداعا سماحة الشيخ","https://www.poetsgate.com/ViewPoem.aspx?id=1444",""],[5431,"لامانع لأمر الله","https://www.poetsgate.com/ViewPoem.aspx?id=185253",""],[5431,"ومازال للعشاق غيمٌ ومرتفعْ!!","https://www.poetsgate.com/ViewPoem.aspx?id=199292",""],[5431,"سينقذنا همامٌ عنتريٌ ولا يخشى لعولمةٍ شِراكا","https://www.poetsgate.com/ViewPoem.aspx?id=201631",""],[5584,"تقي","https://www.poetsgate.com/ViewPoem.aspx?id=174842",""],[1638,"رشا من بني الأتراك صاد بصاده","https://www.poetsgate.com/ViewPoem.aspx?id=123935",""],[5781,"تراخى على القدِّ","https://www.poetsgate.com/ViewPoem.aspx?id=211099",""],[5881,"أحاديث شوقٍ","https://www.poetsgate.com/ViewPoem.aspx?id=183772",""],[5956,"زهور البراري","https://www.poetsgate.com/ViewPoem.aspx?id=183157",""],[5956,"لماذا؟!","https://www.poetsgate.com/ViewPoem.aspx?id=193850",""],[6084,"أبا موسى اليك شددت رحلي","https://www.poetsgate.com/ViewPoem.aspx?id=170864",""]],"verses":[["تَقَيتُ الشَوكَ بِالنَعلِ","فَشاكَت قَدَمي النَعلُ",0,"ل",1,0],["تَقيلُ في ظِلِّها بيضاءَ آنسةٌ","تكادُ تَنشُرها لِيناً وتَطويها",1,"ي",3,0],["تَقِيٌّ حَذَا حَذْوَ الْخَلاَئِفِ وَاقْتَدَى","بِهِمْ مِثْلَ مَا خُطَّ الْكِتَابُ عَلَى الرَّسْمِ",2,"م",1,0],["تَقَيّلَ أخْلاقَ كسْبِ الثّناءِ","فأيّدَ طارفَها بالتّلِيدْ",3,"د",1,0],["تَقَيَّلَ في العِزِّ مِن حِميَرٍ","مَقاوِلَ عَزّوا جَميعَ الأُمَم",4,"م",1,0],["تَقَيَّلَ في المَهدِ ظِلَّ اللِواءَ","وَسيمَ النُهوضَ بِهِ فَاِستَقَلّ",5,"ل",1,0],["تَقي الله فيه أُمَّ عمروٍ ونَوّلي","مَوَدَّتَهُ لا يَطلُبَنَّكِ طَالِبُ",6,"ب",1,0],["تَقِيَّةَ إِنْفَاقِ أَضْعَافِهَا","وَلا أَجْرَ إِذْ ذَاكَ لِلْمُنْفِقِينْ",7,"ن",1,0],["تَقِيٌّ لا يُدَاجِي فِي تُقَاهُ","عَزِيزُ النَّفْسِ لِلْشَّكْوَى كَتُومُ",8,"م",1,0],["تُقىً لِلَّذي فَوقَ السَماءِ وَنَجدَةً","وَحِلماً يُساوي حِلمَ لُقمانَ وافِيا",9,"ي",2,0],["تَقَيَّظَ الرَملَ حَتّى هَزَّ خِلفَتَهُ","تَرَوُّحُ البَردِ ما في عَيشِهِ رَتَبُ",10,"ب",1,0],["تقيمُ رسوم المعلُوات بمغرب","وذكرُك في أقصى البسيطة جائلُ",11,"ل",1,0],["تَقيكَ نَفسي السوءَ مِن حاكِمِ","ما كانَ هَذا بَينَنا الشَرطُ",12,"ط",1,0],["تَقَيَّلَ الأخلاقَ أُمّاً له","نيكتْ ولم تُمهَرْ ولم تُخطبِ",13,"ب",1,0],["تقينا شُحَّ أنفسنا وذاكم","إذا ذُكِر الفلاح من الفلاحِ",14,"ح",1,0],["تَقيّل الأَقيالَ مِن آبائِهِ","وَزَيدَ إِقبالَ الجُدود وَالحُظا",15,"ا",1,0],["تَقَيَّدَ في التُرابِ بِغَيرِ قَيدٍ","وَحَلَّ عَلى جَوانِبِهِ رَهينا",16,"ن",2,0],["تَقي جَبَهاتُهُم ما في ذَراهُم","إِذا بِشِفارِها حَمِيَ اللِطامُ",17,"م",1,0],["تَقَيَّلَ مِن عَبدِ العَزيزِ سَجِيَّةً","مِنَ المَجدِ تِمّاً بَل تَزيدُ عَلى المَجدِ",18,"د",1,0],["تَقَيَّلتَ مِن أَخلاقِ يَزدادَ أَنجُماً","تَوَقَّدُ في داجٍ مِنَ اللَيلِ دامِسِ",19,"س",1,0],["تُقَيَّضُ لي مِن حَيثُ لا أَعلَمُ النَوى","وَيَسري إِلَيَّ الشَوقُ مِن حَيثُ أَعلَمُ",20,"م",1,0],["تَقي السَيفَ إِن جاوَزتِ قُلَّةَ ساطِحٍ","وَضَمَّكِ وَالمَعروفَ بَطنُ طَرونِ",21,"ن",1,0],["تَقَيَّلَ مِن آلِ المُدَبِّرِ سَيِّداً","يَقودُ إِلى العَلياءِ مُتَّبِعيهِ",22,"ي",2,0],["تُقى اللَهِ وَالحُكمَ الَّذي لَيسَ مِثلُهُ","وَرَأفَةَ مَهدِيٍّ عَلى الناسِ عاطِفِ",23,"ف",1,0],["تُقيمُ بِدارٍ قَد تَغَيَّرَ جِلدُها","وَطالَ وَنيرانُ العَذابِ اِشتِعالُها",24,"ل",3,0],["تُقىً وَضَمانَةً لِلناسِ عَدلاً","وَأَكثَرَ مَن يُلاثَ بِهِ نَوالا",25,"ل",2,0],["تَقيهِمُ البَأسَ يَومَ البَأسِ إِذ رَكِبوا","سَوابِغٌ كَالأَضا بيضاً وَأَبدانا",26,"ن",2,0],["تَقيَّلَ أوَّلَيهِ فجاءَ يجري","على نَهجِ السماحِ المُستقيمِ",27,"م",1,0],["تَقَيَّلْتَ عبدَ اللهِ في البأسِ والنَّدى","فما حِدْتَ يوماً عن طريقتِه المُثلى",28,"ا",1,0],["تَقِيٌّ نَقِيٌّ لَم يُكَثِّر غَنيمَةً","بِنَهكَةِ ذي قُربى وَلا بِحَقَلَّدِ",29,"د",1,0],["تَقِيٍّ مِن ثِيابِ العارِ عارٍ","بِهِمَّتِهِ لِأَنفِ الدَهرِ عارِن",30,"ن",1,0],["تَقَيّدْ من القطر العزيز بموطنٍ","وَمُتْ عند رَبْعٍ من ربوعكَ أو رسمِ",31,"م",1,0],["تقيَّلتَ آباءً ملوكاً كأنّما","يُفَتَّقُ للأسماعِ فخرهمُ مسكا",32,"ك",2,0],["تُقَيَّدُ بالسبقِ الأوابدُ فَوْقَهُ","ولَو مَرَّ في آثارِهِنَّ مُقَيَّدا",33,"د",2,0],["تَقي جَمَحاتي لَستُ طَوعَ مُؤَنِّبي","وَلَيسَ جَنيبي إِن عَذَلتِ بِمُصحِبي",34,"ب",2,1],["تقيُّ الدينِ أحمدُ خيرُ حَبْرٍ","خُروقُ المفصلاتِ بهِ تُخاطُ",35,"ط",1,0],["تُقيمُ عَلى رُؤوسِ الرَكبِ شَمساً","كَصولِ القِرنِ بِالذَكَرِ الحُسامِ",36,"م",1,0],["تَقيكَ دِماءُ القِرْنِ من مُتَخَمِّطٍ","على القِرنِ مشبوحِ اليدين حُلاحِل",37,"ل",1,0],["تقيك اللّيالي والزمانُ وأهلُهُ","ومُصْفِيكَ محْضَ الودِّ والمُتصَنِّع",38,"ع",1,0],["تَقَيَّلا مِنكَ أَباكَ الَّذي","جَرَت لَهُ في الخَيرِ آثارُ",39,"ر",1,0],["تَقي بَنانَ الكَفِّ لا تَخصُرا","وَغَمزَةَ البازي إِذا ما طَفَرا",40,"ر",2,0],["تقيسون بكم نفسي","وفي الشأن ألا أُجحِد",41,"د",1,0],["تقيّ النفسِ أزهرُ قرطقيّ","رشيق القدّ كالظبي النعوس",42,"س",1,0],["تُقَيِّدُ لَفظَها عَن كُلِّ بِرٍّ","مَواشٍ بِالحُليِّ مُقَيَّداتُ",43,"ت",1,0],["تُقيمُ عَلى الدَهرِ الفَوارِسُ في الدُجى","وَتَرحَلُ مِن فَوقِ الجِيادِ الفَوارِسُ",44,"س",1,0],["تَقيٌّ يُعاني ظِمئَهُ وَمُضَلَّلٌ","لَهُ صابِحٌ مِن غَيرِ حِلٍّ وَغابِقُ",45,"ق",1,0],["تُقيمُ إذا لاقَتْ من الأرضِ حاجِزا","وتَجْري إذا ما رَقْرَقَتْها الأمالِس",46,"س",1,0],["تقيّل الأقيال من آبائه","وزيد إقبال الجدود والخطا",47,"ا",1,0],["تَقِينَا الْرَّزَايَا رَأْفَةُ اللهِ بِالصِّبَا","وَتَدْرَأُ عَنَّا الْحَادِثَاتِ غُيُوبُ",48,"ب",1,0],["تقيلوا مدح القرآن أجمعها","اذا استحق مديح الله ايمان",49,"ن",1,0],["تقيل أخلاق كسب الثنا","فأيد طارفها بالتليد",50,"د",1,0],["تَقي السّيرَ، إنْ جاوَزْتِ قِلّةَ ساطحٍ،","وَضَمّ