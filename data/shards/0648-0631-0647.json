{"poems":[[95,"وفاء كهذا العهد فليكن العهد","https://www.aldiwan.net/poem9845.html","الطويل"],[23,"منع النوم بالعشاء الهموم","https://www.aldiwan.net/poem21237.html","الخفيف"],[31,"أيا راكبا إما عرضت فبلغن","https://www.aldiwan.net/poem6172.html","الطويل"],[72,"علا حس النواعير","https://www.aldiwan.net/poem42906.html","الهزج"],[87,"اختلاف النهار والليل ينسي","https://www.aldiwan.net/poem63713.html","الخفيف"],[30,"إن كنت تخشى ضلع خندف فانطلق","https://www.aldiwan.net/poem5033.html","الطويل"],[30,"وإن نقدت يداه فزل عنها","https://www.aldiwan.net/poem5240.html","الوافر"],[107,"هفت العروش وزلزلت زلزالا","https://www.aldiwan.net/poem43155.html","الكامل"],[22,"فمن مبلغ حيان عني وعاصما","https://www.aldiwan.net/poem22001.html","الطويل"],[50,"بمعودية الدين العتيقِ","https://www.aldiwan.net/poem66571.html","الوافر"],[48,"مثل الفتى عند التغرب والنوى","https://www.aldiwan.net/poem22634.html","الكامل"],[19,"أجاعلة أم الحصين خزاية","https://www.aldiwan.net/poem346.html",""],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19668","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67312","الطويل"],[138,"خليلي ما أذني لأول عاذل","https://www.aldiwan.net/poem21027.html","الطويل"],[138,"سقى الله رهطا هم بالحجون","https://www.aldiwan.net/poem21032.html","المتقارب"],[154,"صدروا وسحر لحاظهم يغريني","https://www.aldiwan.net/poem68480.html","الكامل"],[174,"شفاء الحب تقبيل وضم","https://www.aldiwan.net/poem2040.html","الوافر"],[190,"حسبي ضجرت من الأدب","https://www.aldiwan.net/poem44151.html","مجزوء الكامل"],[369,"نمت بأسرار ليل كان يخفيها","https://www.aldiwan.net/poem60595.html","البسيط"],[382,"خليلي مرا بي على ربع ناسك","https://www.aldiwan.net/poem59305.html","الطويل"],[410,"والله لولا كرمي وخيري","https://www.aldiwan.net/poem1123.html",""],[458,"حلمت أنك قد أصبحت معتزلا","https://www.aldiwan.net/poem61371.html","البسيط"],[463,"من راكب تنجو به ممسوسة","https://www.aldiwan.net/poem55832.html","الكامل"],[463,"سلك الخيال بحاجر","https://www.aldiwan.net/poem56096.html","مجزوء الكامل"],[463,"لو كان يرفق ظاعن بمشيع","https://www.aldiwan.net/poem56116.html","البسيط"],[563,"أنا عندي أن الشهود حجاب","https://www.aldiwan.net/poem34967.html","الخفيف"],[581,"أطردتني حذر الهجاء ولا","https://www.aldiwan.net/poem1778.html","أحذ الكامل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138441",""],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83276","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48858","الخفيف"],[1165,"","https://poetry.dctabudhabi.ae/diwan/poem/101342","الطويل"],[1294,"","https://poetry.dctabudhabi.ae/diwan/poem/101151","الطويل"],[2218,"","https://poetry.dctabudhabi.ae/diwan/poem/97732","المتقارب"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/121016","الطويل"],[2346,"","https://poetry.dctabudhabi.ae/diwan/poem/18007","الوافر"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121187","الطويل"],[2721,"","https://poetry.dctabudhabi.ae/diwan/poem/20691","الطويل"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104683","الطويل"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99391","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74040","المديد"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/126978","الوافر"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117982","الطويل"],[3827,"","https://poetry.dctabudhabi.ae/diwan/poem/139843",""],[3881,"","https://poetry.dctabudhabi.ae/diwan/poem/95326","الرجز"],[4069,"","https://poetry.dctabudhabi.ae/diwan/poem/22628","الوافر"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127281","البسيط"],[4162,"","https://poetry.dctabudhabi.ae/diwan/poem/67794","البسيط"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81233","الخفيف"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104541","البسيط"],[4927,"الْحُبُّ الْمُتَوَقِّدُ","https://www.poetsgate.com/ViewPoem.aspx?id=29846",""],[5106,"هَلْ بِعَيْنَيْكَ الْهَوَىْ قَدْ ذَاْبَ سِحْرَاْ","https://www.poetsgate.com/ViewPoem.aspx?id=150043",""],[5183,"السِّمَات","https://www.poetsgate.com/ViewPoem.aspx?id=186460",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[5357,"الثريا","https://www.poetsgate.com/ViewPoem.aspx?id=16497",""],[5431,"هكذا تكلمت ريمادشت...","https://www.poetsgate.com/ViewPoem.aspx?id=202692",""],[194,"ما بالُ عَينٍ شَوقُها استَبكاها","https://www.poetsgate.com/ViewPoem.aspx?id=51514",""],[5616,"موال فلسطيني خاص جدًّا","https://www.poetsgate.com/ViewPoem.aspx?id=205045",""],[6104,"بعدَ الرِّيّ","https://www.poetsgate.com/ViewPoem.aspx?id=24195",""]],"verses":[["ورة ذاك اللفظ في كل موقفٍ","يصان به عرض ويقني به ود",0,"د",1,0],["وَرَهَنتُ اليَدَينِ عَنهُم جَميعاً","كُلُّ كَفٍّ فيها جُزٌ مَقسومُ",1,"م",1,0],["وَرَهطَ أَبي لَيلى فَأَطفَأتُ نارَهُم","وَأَقرَرتُ عَيني مِن جِداءِ الحَبَلَّقِ",2,"ق",1,0],["وَرُهبانٌ كَما تَدري","مِنَ القِبطِ النَحاريرِ",3,"ر",1,0],["وَرَهينُ الرِمالِ أَفطَسُ إِلّا","أَنَّهُ صُنعُ جِنَّةٍ غَيرُ فُطسِ",4,"س",1,0],["وَرَهطِ اِبنِ ذي الجَدَّينِ قَيسِ بنِ خالِدٍ","إِلى كُلِّ شَدّاخِ الحَمالَةِ سَيِّدِ",5,"د",1,0],["وَرَهطِ أُثالٍ أَو قُتادَةَ عَمِّهِ","وَهَوذَةَ في أَعلى البِناءِ المُشَيَّدِ",5,"د",1,0],["وَرَهطَ اِبنِ الحُصَينِ فَلا تَدَعهُم","ذَوي يَمَنٍ وَعاظِمني خِطارا",6,"ر",2,0],["وَرَهاءَ تَخذُلُ مَن يَقومُ بِنَصرِها","وَتَظَلُّ تَنصُرُ دوَنَهُ الخُذّالا",7,"ل",2,0],["وَرَهطَ اِبنِ حَبّاسٍ فَأَنّى غَنِمتُمُ","لَكُم بِأَحاديثَ الخُرافَةِ أَمثالي",8,"ل",2,0],["ورهبان الصوامع في ذُراها","مقامهمُ على جهدٍ وضيق",9,"ق",1,0],["وَرهاءُ مُفسِدَةٌ أَهانَت عِرضَها","حَتّى أُصيبَ وَأَكرَمَت دينارَها",10,"ر",3,0],["وَرَهطَ بَني عَمرٍ وَعَمروَ بنِ عامِرٍ","وَتَيماً فَجاشَت مِن لِقائِهِمُ نَفسي",11,"س",2,0],["ورهين إذن دون بابك مدنف","حارا من السر الخفى بنفنف",12,"ف",1,0],["ورهطٌ مع الفَارُوقِ والمرءُ عَامِرٌ","وَزَيْدُ وزيدُ الأميرِ أبي بكرِ",13,"ر",1,0],["وَرَهطُ نُفَيلٍ شَرُّ مَن وَطئَ الحَصى","وَأَلأَمُ حافٍ مِن مَعَدٍّ وَناعِلِ",14,"ل",1,0],["وَرَهبَةَ عارٍ عَلى أُسرَتي","إِذا ما أَتى أَرضَنا المَوسِمُ",15,"م",1,0],["ورهنت لُبَّى والحياة بوقفة","ضنوا بها من بعد قبض رهون",16,"ن",1,0],["وَرهزٌ تهملُ العينان منهُ","وَأخذٌ بالمناكب والقرونِ",17,"ن",1,0],["ورهنت ديوان النقا","ئض واسترحت من التعب",18,"ب",1,0],["وَرْهاءُ لم يَبْدُ للأبصارِ لابِسُها","يوماً ولم يَحْتَجِبْ عنهُنَّ عاريها",19,"ي",3,0],["ورهبانُه فيه صفوفُ ملائكٍ","يعارضهم فيه صفوفُ ملائك",20,"ك",1,0],["ورهبة الجلواذ والترتور","لجلت عن شيخ بني البعير",21,"ر",1,0],["ورهبة الريف في نبت وفي حجر","كمعبد مستقر منذ أدهار",22,"ر",1,0],["وَرهاءُ يحلَم ذو السَّفاهِ من الونى","ومراحُها في غيِّه وجنونه",23,"ن",2,0],["ورهنتُ قلبي لاعباً","والحبّ عندكِ يُغلقُهْ",24,"ق",2,0],["ورهاء ما نَفضتْ يداً من حاجر","إلا وقد غَمست يداً في لعلعِ",25,"ع",1,0],["ورَهابينُها رعيَّةُ حكمي","كل داع بي عندهم مستجاب",26,"ب",1,0],["وَرَهَنتَني هِنداً وَعِرضَكَ في","صُحُفٍ تَلوحُ كَأَنَّها خِلَلُ",27,"ل",1,0],["ورهبان قد انقطعوا نهارا","وليلا للعبادات الوفيه",28,"ي",2,0],["وَرَهطٍ دَعَوني أَن أُجيبَ نِداءَهُم","فَلَمّا دَعَوني لَم يَرَوني بِقُعدُدِ",29,"د",1,1],["ورهين الديون ما زال للبي","ع مسوماً برهنه وأقلّا",30,"ل",2,0],["ورهط المعالي الغر أبناء هاشم","شموس بدت لا يعتريها افولها",31,"ل",3,0],["ورهط قريط كم لهم من قضية","وكم من جريح منهم جاء داميا",32,"ي",2,0],["وَرهط المجالد قَد جلّلت","فَواضل نُعماك أَجبالها",33,"ل",3,0],["ورهطُكَ أهلُ البيتِ بيتش محمدٍ","فأعظم به بيتاً وأكرم بهم رهطا",34,"ط",2,0],["وَرَهطَ أَبي أُمَيَّةَ قَد أَبَحنا","وَأَوسَ اللَهِ أَتبَعنا ثَمودا",35,"د",2,0],["ورهط من الاعجام بين مدرع","على لاحق وافى وبين مزرد",36,"د",1,0],["وَرَهطُ كُلَيبٍ قَد جَزاهُم بظُلمِهِم","بِبَطنِ شُبَيثٍ إِذ يَنوءُ وَيُصرَعُ",37,"ع",1,0],["ورهطٍ رأوك الدهر مراي وأرصدوا","لأهل الهوى صلاحهم لاح والهدى",38,"د",2,0],["ورهنت حتى قد رهنت منادمي","ومناشدي ومذكري ومعللي",39,"ل",2,0],["وَرَهيف الحدّ ذي هَيَفٍ","بِهلال الحتف منتقبِ",40,"ب",1,0],["ورهطك من قديم الدهر كانوا","خضارمة بيوم الجود صيدا",41,"د",2,0],["ورهطي أعز الناس بيتاً ومنبتاً","وسادات ساميَّ الخليقة والحامي",42,"م",2,0],["ورهطك هم رهط الحسين الذي به","تجر ذيول الفخر دور بلكرام",42,"م",1,0],["ورهيف مر النسيم يثنيه","شمالا إذا مشى أو يمينا",43,"ن",2,0],["ورُهَصِت فرس زيد في حجر","أَصابها في حافر حيث عثر",44,"ر",1,0],["وَرَهطِ المازِنِيِّ اَبي كُعَيبٍ","تَرَكناهُم كَباقِيَةِ الرَمادِ",45,"د",1,0],["ورهطك الشهب في أفق العلى نجمعوا","قدما وكم رجموا في الحرب شيطانا",46,"ن",2,0],["وَرَهْطُهُ عِصْمَةٌ فِي دِينِنَا وَلَهُمْ","فَضْلٌ عَلَيْنَا وَحَقُّ واجِبٌ فِينَا",47,"ن",2,0],["وَرِهام مِن رُوحي الهائم الوَ","لهان أَمكَنَت في الزَمان وَثّاقَه",48,"ق",2,0],["ورهاء إن صافح الأرجاء وابلها","يجلل الخصب قاصيها ودانيها",49,"ي",3,0],["وَرَهَنْتَ قَلْبَكَ مُخْلِصًا، وَلأَجْلِهَاْ","لَحَّنْتَ مِنْ نَبْضِ الْفُؤَاْدِ نَشِيْدَاْ",50,"د",2,0],["وَرُهَاْمُ الْمُزْنِ فُتَّتْ فِيْ هَيَامٍ","وَسَرَتْ فِيْكَ مِنَ الأشْوَاْقِ أَجْرَاْ",51,"ر",2,0],["ورهيب الجد سلاّب النهى","بين طيش العزم أو حزم الأناة",52,"ه",1,0],["ورهبته منه كذاك خضوعه","لعزته والاستغاثة عن جهد",53,"د",1,0],["ورّهم كيف تقدر شي ما يقدرونه ... علّم اهل الثرى وشلون رقص الثريّا","خلّهم يفقدون العقل ويودعونه ... سوّ فيهم سواتك قبل ما اعرفك فيّا",54,"ي",2,0],["ورهينٌ لغربةٍ واغترابٍ","وغريبٌ عن الفسوقِ بسجني!!",55,"ن",2,0],["وَرَهبَةَ النّارِ بِاَن نَصلاها","اَو يَدعُوَ النَّاسُ عَلَينا اللاّها",56,"ا",3,0],["وَرُهْبَانُ السِّيَاسَةِ قَدْ تَدَاعَوْا","عَلَى أَجْسَادِهِمْ خَفَقَتْ مُسُوحُ",57,"ح",1,0],["ورهبانُ قدِّي إلى النبع طاروا","جياعًا وعطْشَى لماءٍ بدَا",58,"د",2,0]]}