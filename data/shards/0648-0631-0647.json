{"poems":[[95,"وفاء كهذا العهد فليكن العهد","https://www.aldiwan.net/poem9845.html","الطويل"],[23,"منع النوم بالعشاء الهموم","https://www.aldiwan.net/poem21237.html","الخفيف"],[31,"أيا راكبا إما عرضت فبلغن","https://www.aldiwan.net/poem6172.html","الطويل"],[72,"علا حس النواعير","https://www.aldiwan.net/poem42906.html","الهزج"],[87,"اختلاف النهار والليل ينسي","https://www.aldiwan.net/poem63713.html","الخفيف"],[30,"إن كنت تخشى ضلع خندف فانطلق","https://www.aldiwan.net/poem5033.html","الطويل"],[30,"وإن نقدت يداه فزل عنها","https://www.aldiwan.net/poem5240.html","الوافر"],[107,"هفت العروش وزلزلت زلزالا","https://www.aldiwan.net/poem43155.html","الكامل"],[22,"فمن مبلغ حيان عني وعاصما","https://www.aldiwan.net/poem22001.html","الطويل"],[50,"بمعودية الدين العتيقِ","https://www.aldiwan.net/poem66571.html","الوافر"],[48,"مثل الفتى عند التغرب والنوى","https://www.aldiwan.net/poem22634.html","الكامل"],[19,"أجاعلة أم الحصين خزاية","https://www.aldiwan.net/poem346.html",""],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19668","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67312","الطويل"],[137,"خليلي ما أذني لأول عاذل","https://www.aldiwan.net/poem21027.html","الطويل"],[137,"سقى الله رهطا هم بالحجون","https://www.aldiwan.net/poem21032.html","المتقارب"],[153,"صدروا وسحر لحاظهم يغريني","https://www.aldiwan.net/poem68480.html","الكامل"],[173,"شفاء الحب تقبيل وضم","https://www.aldiwan.net/poem2040.html","الوافر"],[189,"حسبي ضجرت من الأدب","https://www.aldiwan.net/poem44151.html","مجزوء الكامل"],[367,"نمت بأسرار ليل كان يخفيها","https://www.aldiwan.net/poem60595.html","البسيط"],[380,"خليلي مرا بي على ربع ناسك","https://www.aldiwan.net/poem59305.html","الطويل"],[407,"والله لولا كرمي وخيري","https://www.aldiwan.net/poem1123.html",""],[455,"حلمت أنك قد أصبحت معتزلا","https://www.aldiwan.net/poem61371.html","البسيط"],[460,"من راكب تنجو به ممسوسة","https://www.aldiwan.net/poem55832.html","الكامل"],[460,"سلك الخيال بحاجر","https://www.aldiwan.net/poem56096.html","مجزوء الكامل"],[460,"لو كان يرفق ظاعن بمشيع","https://www.aldiwan.net/poem56116.html","البسيط"],[560,"أنا عندي أن الشهود حجاب","https://www.aldiwan.net/poem34967.html","الخفيف"],[578,"أطردتني حذر الهجاء ولا","https://www.aldiwan.net/poem1778.html","أحذ الكامل"],[823,"","https://poetry.dctabudhabi.ae/diwan/poem/97732","المتقارب"],[848,"","https://poetry.dctabudhabi.ae/diwan/poem/18007","الوافر"],[906,"","https://poetry.dctabudhabi.ae/diwan/poem/20691","الطويل"],[1110,"","https://poetry.dctabudhabi.ae/diwan/poem/22628","الوافر"],[193,"ما بالُ عَينٍ شَوقُها استَبكاها","https://www.poetsgate.com/ViewPoem.aspx?id=51514",""]],"verses":[["ورة ذاك اللفظ في كل موقفٍ","يصان به عرض ويقني به ود",0,"د",1,0],["وَرَهَنتُ اليَدَينِ عَنهُم جَميعاً","كُلُّ كَفٍّ فيها جُزٌ مَقسومُ",1,"م",1,0],["وَرَهطَ أَبي لَيلى فَأَطفَأتُ نارَهُم","وَأَقرَرتُ عَيني مِن جِداءِ الحَبَلَّقِ",2,"ق",1,0],["وَرُهبانٌ كَما تَدري","مِنَ القِبطِ النَحاريرِ",3,"ر",1,0],["وَرَهينُ الرِمالِ أَفطَسُ إِلّا","أَنَّهُ صُنعُ جِنَّةٍ غَيرُ فُطسِ",4,"س",1,0],["وَرَهطِ اِبنِ ذي الجَدَّينِ قَيسِ بنِ خالِدٍ","إِلى كُلِّ شَدّاخِ الحَمالَةِ سَيِّدِ",5,"د",1,0],["وَرَهطِ أُثالٍ أَو قُتادَةَ عَمِّهِ","وَهَوذَةَ في أَعلى البِناءِ المُشَيَّدِ",5,"د",1,0],["وَرَهطَ اِبنِ الحُصَينِ فَلا تَدَعهُم","ذَوي يَمَنٍ وَعاظِمني خِطارا",6,"ر",2,0],["وَرَهاءَ تَخذُلُ مَن يَقومُ بِنَصرِها","وَتَظَلُّ تَنصُرُ دوَنَهُ الخُذّالا",7,"ل",2,0],["وَرَهطَ اِبنِ حَبّاسٍ فَأَنّى غَنِمتُمُ","لَكُم بِأَحاديثَ الخُرافَةِ أَمثالي",8,"ل",2,0],["ورهبان الصوامع في ذُراها","مقامهمُ على جهدٍ وضيق",9,"ق",1,0],["وَرهاءُ مُفسِدَةٌ أَهانَت عِرضَها","حَتّى أُصيبَ وَأَكرَمَت دينارَها",10,"ر",3,0],["وَرَهطَ بَني عَمرٍ وَعَمروَ بنِ عامِرٍ","وَتَيماً فَجاشَت مِن لِقائِهِمُ نَفسي",11,"س",2,0],["ورهين إذن دون بابك مدنف","حارا من السر الخفى بنفنف",12,"ف",1,0],["ورهطٌ مع الفَارُوقِ والمرءُ عَامِرٌ","وَزَيْدُ وزيدُ الأميرِ أبي بكرِ",13,"ر",1,0],["وَرَهطُ نُفَيلٍ شَرُّ مَن وَطئَ الحَصى","وَأَلأَمُ حافٍ مِن مَعَدٍّ وَناعِلِ",14,"ل",1,0],["وَرَهبَةَ عارٍ عَلى أُسرَتي","إِذا ما أَتى أَرضَنا المَوسِمُ",15,"م",1,0],["ورهنت لُبَّى والحياة بوقفة","ضنوا بها من بعد قبض رهون",16,"ن",1,0],["وَرهزٌ تهملُ العينان منهُ","وَأخذٌ بالمناكب والقرونِ",17,"ن",1,0],["ورهنت ديوان النقا","ئض واسترحت من التعب",18,"ب",1,0],["وَرْهاءُ لم يَبْدُ للأبصارِ لابِسُها","يوماً ولم يَحْتَجِبْ عنهُنَّ عاريها",19,"ي",3,0],["ورهبانُه فيه صفوفُ ملائكٍ","يعارضهم فيه صفوفُ ملائك",20,"ك",1,0],["ورهبة الجلواذ والترتور","لجلت عن شيخ بني البعير",21,"ر",1,0],["ورهبة الريف في نبت وفي حجر","كمعبد مستقر منذ أدهار",22,"ر",1,0],["وَرهاءُ يحلَم ذو السَّفاهِ من الونى","ومراحُها في غيِّه وجنونه",23,"ن",2,0],["ورهنتُ قلبي لاعباً","والحبّ عندكِ يُغلقُهْ",24,"ق",2,0],["ورهاء ما نَفضتْ يداً من حاجر","إلا وقد غَمست يداً في لعلعِ",25,"ع",1,0],["ورَهابينُها رعيَّةُ حكمي","كل داع بي عندهم مستجاب",26,"ب",1,0],["وَرَهَنتَني هِنداً وَعِرضَكَ في","صُحُفٍ تَلوحُ كَأَنَّها خِلَلُ",27,"ل",1,0],["وَرهط المجالد قَد جلّلت","فَواضل نُعماك أَجبالها",28,"ل",3,0],["وَرَهطَ أَبي أُمَيَّةَ قَد أَبَحنا","وَأَوسَ اللَهِ أَتبَعنا ثَمودا",29,"د",2,0],["وَرَهطُ كُلَيبٍ قَد جَزاهُم بظُلمِهِم","بِبَطنِ شُبَيثٍ إِذ يَنوءُ وَيُصرَعُ",30,"ع",1,0],["وَرَهطِ المازِنِيِّ اَبي كُعَيبٍ","تَرَكناهُم كَباقِيَةِ الرَمادِ",31,"د",1,0],["وَرَهبَةَ النّارِ بِاَن نَصلاها","اَو يَدعُوَ النَّاسُ عَلَينا اللاّها",32,"ا",3,0]]}