رتك نعمى","https://www.aldiwan.net/poem61759.html","الخفيف"],[456,"لمن الطلول كأنهن رقوم","https://www.aldiwan.net/poem55864.html","الكامل"],[456,"لله ساع بلغته قدمه","https://www.aldiwan.net/poem55865.html","الرجز"],[456,"انظر معي فهي نظرة أمم","https://www.aldiwan.net/poem55899.html","المنسرح"],[456,"أروض الوادي أم ابيض الغسق","https://www.aldiwan.net/poem56090.html","الرجز"],[456,"صفراء من غير مرض","https://www.aldiwan.net/poem56145.html","مجزوء الرجز"],[456,"بلوت هذا الدهر أطواره","https://www.aldiwan.net/poem56171.html","السريع"],[456,"أمكنت العاذل من قيادها","https://www.aldiwan.net/poem56218.html","الرجز"],[456,"أفلح قوم إذا دعوا وثبوا","https://www.aldiwan.net/poem56299.html","المنسرح"],[462,"يا صاحبي قضية حيرتني","https://www.aldiwan.net/poem3250.html","عموديه"],[476,"لوركا","https://www.aldiwan.net/poem2292.html","عموديه"],[477,"سمعا لصوتك سمعا أيها الشادي","https://www.aldiwan.net/poem36952.html","البسيط"],[493,"أخوان من أم وأب لا يفتران عن الشغب","https://www.aldiwan.net/poem9766.html","مجزوء الكامل"],[493,"أخرجته يا سيدي","https://www.aldiwan.net/poem9810.html","مجزوء الرجز"],[493,"سفينة لم تعتمل بنجر","https://www.aldiwan.net/poem9864.html","مشطور الرجز"],[503,"العار","https://www.aldiwan.net/poem42463.html","البسيط"],[513,"رتبة الحكم السنيه","https://www.aldiwan.net/poem12308.html","مجزوء الرمل"],[527,"أقول بعد الحمد","https://www.aldiwan.net/poem37446.html","مجزوء الرجز"],[536,"أخرجني مفضل","https://www.aldiwan.net/poem47965.html","عموديه"],[556,"يا راحم الشيب في شيبه","https://www.aldiwan.net/poem33524.html","السريع"]],"verses":[["أَخرَجتِني مِنها وَأَعقَبتِني","مُخيلَةً مِن كاذِباتِ السَحاب",0,"ب",1,0],["أَخرَجَتهُ قَهباءُ مُسبِلَةُ الوَد","قِ رَجوسٌ قُدّامُها فُرّاقُ",1,"ق",1,0],["أَخرَجَ السَيرُ وَالهَواجِرُ مِنها","قَطِراناً وَلَونَ رُبٍّ عَصيرا",2,"ر",2,0],["أَخرَجَتهُ مِنَ اللَيالي رَجوسٌ","لَيلَةً هاجَها السِماكُ دَرورا",2,"ر",2,0],["اِخرِقِ السَمعَ سِوى مِن نَبَإٍ","خَرَقَ السَمعَ فَأَدمى فَوَقَر",3,"ر",1,0],["أَخرَجَتهُم مِنَ الدِيارِ عُراةً","حَذَرَ المَوتِ يَطلُبونَ الفِرارا",4,"ر",2,0],["أَخرِقُ الدُفَّ لَو رَأَيتُ شَكيبا","وَأَفُضُّ الأَذكارَ حَتّى يَغيبا",5,"ب",2,1],["أَخرَقاءُ لِلبَينِ اِستَقَلَّت حُمولُها","نَعَم غَربَةً فَالعَينُ يَجري مَسيلُها",6,"ل",3,1],["أخرس الحزن منطقي بنحيبٍ","ألسن الدمع فيه ذلق فصاح",7,"ح",1,0],["اخرس الشعر يوم منعاك لكن","ناب عنه تأوّه وعويل",8,"ل",1,0],["أخرَجَ قِدحَيهم المُفيضُونَ للمَجدِ","أمَامَ القِداحِ إن ضَرَبُوا",9,"ب",3,0],["أَخرَجتِ مُرقِصَةً إِلى أُحُدٍ","في القَومِ مُعنِقَةً عَلى بَكرِ",10,"ر",1,0],["أخربت قلبي الذي صيَّرته وطناً","أيام لم تكُ ذا زيغٍ ولا عوج",11,"ج",1,1],["آخر أمجاده كأوَّلهم","كحلقةٍ بدؤها كعقباها",12,"ا",3,0],["أخرجت من باب المشيئة مثل ما","خرجتْ فأنت على الطبيعة جاري",13,"ر",2,0],["آخر جهلي بك الغداةَ عِتا","بيك وما للعقابِ والحجرِ",14,"ر",1,0],["أخرسُ عن غِيبة الصديق وعن","طِيب نَثاه فلستُ بالخَرس",15,"س",1,0],["أُخرجتُ من جنتي مفاجأة","آمن ما كنت في حدائقها",16,"ق",3,0],["أخَّرتُ تسليمي عليكَ كراهةً","لِزِحامِ من يلقاكَ للتَّسليمِ",17,"م",1,0],["أُخرجُ من خاطري معاهدَهُ","بعد اشتغالي به وإغرامي",18,"م",2,0],["أَخرَقَهُ وَهوَ في أَكنافِ سِدرَتِهِ","يَومٌ تُضَرِّمُهُ الجَوزاءُ مَشمولُ",19,"ل",1,0],["آخرك المثير للحزن","ينافي اولك",20,"ك",1,0],["اخر المسلمين عمن سواهم","رهق المسلمين للمسلمات",21,"ت",1,0],["اخرستهم عن الكلام المنايا","ولقد كانوا قبلها غير خرس",22,"س",1,0],["أخرست أفصح القياصر سيفا","بأساطيل في الخصومة لُدّ",23,"د",1,0],["أخرجتهم للعالمين حَجاحجِا","عُربا وأبناء الكريم كرام",24,"م",1,0],["أخرجه دلكاس","ألعوبة للناس",25,"س",1,0],["أَخرَجتَ هَذا العَقلَ مِن ظُلُماتِهِ","وَهَدَيتَهُ النورَ المُبينَ سَبيلا",26,"ل",2,0],["أَخرِج لِأَبناءِ الحَضارَةِ مَجلِساً","يُبقي عَلى اِسمِكَ في العُصورِ ثَناءَ",27,"ا",2,0],["أَخرَجَها اللَهُ كَال","زَهرَةِ وَالحُسنُ كِم",28,"م",1,0],["آخَرَ العَهدِ بِالجَزيرَةِ كانَت","بَعدَ عَركٍ مِنَ الزَمانِ وَضَرسِ",29,"س",1,0],["أَخرَجتِ لِلعُربِ الفِصاحِ بَيانَهُ","قَبَساً يُضيءُ الشَرقَ مِثلَ كَمالِهِ",30,"ل",2,0],["أَخرَجتَ مِن قَبرٍ كِتابَ حَضارَةٍ","الفَنُّ وَالإِعجازُ مِن أَبوابِهِ",31,"ب",2,0],["أَخرَجتَ لِلناسِ مِن ذُلٍّ وَمِن فَشَلٍ","شَعباً وَراءَ العَوالي غَيرَ مُنشَعِبِ",32,"ب",1,0],["آخِرُ ما المَلكُ مُعَزّى بِهِ","هَذا الَّذي أَثَّرَ في قَلبِهِ",33,"ب",2,1],["أَخَّرَني عَن مَعشَرٍ كُلُّهُم","مُؤَخَّرٌ عَني وَعَن شِعري",34,"ي",1,0],["أَخَّرتِ ظالِمَةً حَقَّ المَشوقِ وَما","عايَنتِ مِن حُرَقِ الشَوقِ الَّذي عانى",35,"ن",2,0],["أخرسُ يُنبيكَ بإطراقِهِ","عن كلِّ ما شِئتَ من الأمرِ",36,"ر",1,1],["أَخرَجَهُ المَوتُ عَن دَساكِرِهِ","وَعَن فَساطيطِهِ وَعَن حُجَرِه",37,"ر",2,0],["أَخرِجوهُ فَوقَ أَعوا","دِ المَنايا شَيِّعوهُ",38,"و",2,0],["أَخرَبتِ قَلبي إِذ مَلَكتِ صَميمَهُ","أَكَدا يَكونُ تَصَرُّفُ المُلّاكِ",39,"ك",1,0],["أَخَرِستَ إِذ عايَنتَني حَتّى إِذا","ما غِبتَ عَن بَصَري ظَلِلتَ تَشَدَّقُ",40,"ق",1,0],["أَخرَجتَهُم بَل أَخرَجَتهُم فِتنَةٌ","سَلَبَتهُمُ مِن نَضرَةٍ وَنَعيمِ",41,"م",1,0],["أَخرَجتُموهُ بِكُرهٍ مِن شَجِيَّتِهِ","وَالنارُ قَد تُنتَضى مِن ناضِرِ السَلَمِ",42,"م",1,0],["أَخْرَجَنِي عَمَّا حَوَتْهُ يَدِي","مِنْ كَسْبِيَ الْحُرِّ بِلا نَاطِلِ",43,"ل",1,0],["أخرجوكم إلى الصعيدِ لعذرٍ","غيرُ مجدٍ في ملتي واعتقادي",44,"ي",1,1],["أخرجتَ قومَك مِن غياهبِ أزمةٍ","لَولاكَ لم تَنْجَبْ ولم تتقشَّعِ",45,"ع",1,0],["آخرُ الزادِ إن أردنا له اسماً","وأراهُ أجلُّ من أنْ يُسَمَّى",46,"م",2,0],["اُخرُجوا في حِمَى الكتابِ أُسوداً","وَاطلعوا في سَنا النبيِّ بُدورا",47,"ر",2,0],["أَخرَجتَ جارَهُمُ مِن قَعرِ مُظلِمَةٍ","لَو لَم تُغِثهُ ثَوى في قَعرِها حِقَبا",48,"ب",2,0],["أخرَجوه منها وآوَاهُ غارٌ","وَحَمَتْهُ حَمامَةٌ وَرقاءُ",49,"ا",2,0],["أخَّرَتْهُ الأعمالُ والمالُ عَمَّا","قدَّمَ الصَّالحُونَ والأغنياءُ",49,"ا",2,0],["أَخَّرتَ رُشدَكَ في غَدٍ فَغَدٍ","بَل كَيفَ تَأمَنُ ما يَسوقُ غَدُ",50,"د",1,0],["أخرَجاني منها وشدَّا وثاقي","بنسوعٍ كما يشدُّ البعير",51,"ر",1,0],["أَخرَجته وَاللَيل أسود داج","من فؤاد يحكي حَزين فؤادي",52,"ي",1,0],["أَخرجتها من حمأة الذل أَيد","قادرات لهاشم إخراجا",53,"ج",2,0],["أخر المسلمين عن أمم الأر","ض حجابٌ تشقى به المسلمات",54,"ت",1,0],["أخَّر في عصورها وقدّما","وانتحل المرقع المهدما",55,"م",2,0],["أَخرَجتَهُم لِلعالَمينَ جَحاجِحاً","عُرباً وَأَبناءُ الكَريمِ كِرامُ",56,"م",1,0],["أَخرجها من كِنِّها وسِنِّها","ما لم يُزِلْ طولُ المدى من ضِغنها",57,"ه",2,0],["أَخْرَجْتَ رَوْضاً مِنْ نَبَا","تِ الْعَبْقَرِيَّةِ لا الرَّغَامِ",58,"م",1,0],["آخِرُ الْجَهْدِ رَاحَ يُنْفِقُهُ المَائِ","تُ فِي سَجْدَةٍ لِذِي اسْتِبْدَادِ",59,"د",1,0],["أَخْرَجْتِ لِلأَسْمَاعِ مِنْهَا","خَيْرَ مَا ادَّخَرَتْ وَصَانَتْ",60,"ت",1,0],["أَخَّرَتني سَيِّئاتي بَعدَهُ","وَجَرى لِلخُلدِ قَبلي فَسَبَق",61,"ق",1,0],["أخرجوا منها فما كا","نَ لديهم من نكيرِ",62,"ر",1,0],["أَخْرَجَ الرَّوضُ أَطْيبَ الثمراتِ","هَاتِ ما شِئتَ من قَرِيِضكَ هَاتِ",63,"ت",1,1],["أخرسَتْ كلَّ ناطق، تركَتْ كلَّ","لسانٍ من عيِّهِ معقودا",64,"د",2,0],["آخر الأخبار: قالت زحلةٌ","أغصنت نار التحدي في زنادي",65,"د",2,0],["آخِرُها أولُها من العجل","ثم أجنَّتها غياباتُ الكِلل",66,"ل",1,0],["أخرج السَّير والهواجر منها","قَطِراناً ولو رُبٍّ عصيرا",67,"ر",2,0],["إخرس فأهل الخير ليس لهم","يا مصطفى عن فعله رجعة",68,"ع",2,0],["آخَرَ خُطبَةٍ وقَد يَستَقبِلُ","قِبلَتَه ولِلرَّدَاءِ يُحَوِّلُ",69,"ل",1,0],["أخرَجتُ مِن قَعرِهِ مَكنُونَ لُؤلئِه","هَل يَستوي اللُّولُؤ المَكنُونُ والزَّبَدُ",70,"د",1,0],["أخرجت من برج الخلافة شمسها","وفجعت فيها الليث وسط عرينه",71,"ن",2,0],["أخرجته من مجلس العلم وقد","دنسه بما به يأتفك",72,"ك",1,0],["أخرّ القول إن في الصمت حكما","وإذا أنت قلت قولا فزنه",73,"ن",2,0],["أخرجت من عدم الوجود","إلى وجود في عدم",74,"م",1,0],["آخر العيش هو المو","ت ويحويك الضريح",75,"ح",1,0],["آخرُها ساكنُها والأكثرُ","رويّه مقدّمٌ فالأكثرُ",76,"ر",1,0],["اخرِجيني من الظلامِ إلى النور","وفرضٌ أن يُسعِفُ الجارُ جارَه",77,"ر",2,0],["أخرجوها من حشا الدّنِّ ونا","دوا حنيناً ليرى بنتُ حنينْ",78,"ن",1,0],["إِخرج فَقَد آنَ أَوانُ الصَليل","وَحقّ لِلإِخلاصِ أَن يعضُدَك",79,"ك",1,0],["أَخرج فيه لِصِباً من صِباً","وَأستحثّ الخمرَ بالخمرِ",80,"ر",1,0],["أَخرَسَت كُلَّ فَصيحٍ فَغَدا","يُفصِحُ الحاسِدُ بِاِستِحسانِها",81,"ن",3,0],["أخرج الطاغين منها عنوة","وهم بين عناد وعناء",82,"ا",2,0],["اخرُج لِتَبغِ لنا مالاً ومَزرَعَةً","كَمَا لِجِيرانِنا مَالٌ ومُزدَرَعُ",83,"ع",1,0],["أخرَجتِ من شفتيَّ رُوحي عِندَما","قبَّلتُ ثغراً فيهِ يبسمُ لي الرجا",84,"ج",2,0],["أَخرجتهُ مِنها خروجَ أخيهِ","لعنةٌ أَسكَنته دار الهوانِ",85,"ن",1,0],["أَخّرتُ وسطى حانَ وقتُ أدائِها","لأَداءِ نفلٍ إن يؤخّر يحرمِ",86,"م",1,0],["أخرجتموني ناطقين بأنني","عبد الإله وإنني لمجاهد",87,"د",1,0],["آخِرٌ يَفضُل الأوائلَ مَعنىً","مثْلما يَفضُلُ الرَّويُّ الرِّدْفا",88,"ف",2,0],["أخّرتُ كتُبْي كي أكونَ مُقدّماً","منّي إليك معَ الوفودِ رَداحا",89,"ح",2,0],["آخِرةٌ في الزمانِ سابقة","فلا يَزلْ رَبُّها يُمَلَّؤها",90,"ا",3,0],["أَخرَجتُموني مِنَ الدُنيا وَما خَرَجَت","نَفسي وَفارَقَها مَن لا لَهُ أَمَلُ",91,"ل",1,0],["أَخرِج حَديثَكَ مِن سَمعي وَما دَخَلا","لا تَرمِ بِالقَولِ سَهماً رُبَّما قَتَلا",92,"ل",2,1],["أخرجتني من عزلتي وكسرتَ باب","لولاكَ لمْ يكسَرْ ، ولم أجدِ البريقا",93,"ق",2,0],["أخرجَ الدنيا من القلبِ، وفي","كفِّه منها بلاغُ الراحلين",94,"ن",1,0],["أخّرَتْني عَلَى نَباهَةِ قدري","عَنْ أَناسٍ عن المعالي نِيامِ",95,"م",1,0],["إخراجهم حتماً بغير تردد","عن أرضنا فالنص فيه وارد",96,"د",1,0],["أخٌ راح في الآدابِ ربّ فضيلةٍ","تعالَتْ على القولِ المُعارضِ والحَجْبِ",97,"ب",1,0],["أخرتُها من بعدِ ما","طُلبتْ فصحّ القولُ أقدَمْ",98,"م",1,0],["أخرى من السنوات أبدؤها غدا","متهللا كالورد في أيار",99,"ر",1,0],["أخرستني الهمومث وهي ضوار","ناهشاتٍ قلباً وفياً طعينا",100,"ن",2,0],["أُخِّرتُ عنهم للشقاوة بعدَهم","ونجا بهم من عيشِيَ التقديمُ",101,"م",1,0],["أُخرِجُ من مكمنهِ الصِّلَّ وما","فيهم بسِحري من يصِحُّ سَقَمُهْ",102,"م",2,0],["أخَّرها الدهرَ عن بلوغ مدا","هُنَّ وهمٌّ ماتت له الهِمَمُ",103,"م",1,0],["أخَّرها الميلادُ وهي رتبةً","في الشعر بالتقديم أولى وأحقّْ",104,"ق",1,0],["أخرسُ يُبدي كلَّ ما","دقَّ خفيَّاً وغمضْ",105,"ض",1,0],["أُخرِست الفتنةُ عن ملكه","بالأمس والفتنةُ نعَّارَهْ",106,"ر",2,0],["أخَّرتُ نفسي بل قعدتُ حَجْرةً","مزمِّلاً بالذلّ في بِجادِها",107,"د",3,0],["أخَّرَ أَقدامَهم وقدّمكم","أنّهُمُ يحسبون ما كَتَبوا",108,"ب",3,0],["أخرجوا مالكاً وردوا أخاه","لم يكن قط مالك في الجنان",109,"ن",1,0],["آخر الأخبار من مدريد ’ أن الجرح قال :","شبع الصابر صبرا !",110,"ر",2,0],["أخرجت من ذلك الجب الذي سقطت","فيه الصحائف مذ أرست على الوادي",111,"د",2,0],["أخرجه إخراج الذكي","فقد وصفت كما وجبْ",112,"ب",1,0],["أخرجته يا سيدي","لا مثل إخراج الشجا",113,"ج",2,1],["أخرج وإلا فمقص الشعر","لما اعمّيه مكان مقر",114,"ر",1,0],["أُخرجْ الى الناسِ فما عدْت بينهمو","ذاك الذميمَ الذي يُخشى ويُجتنبُ",115,"ب",1,1],["أخرب الجهال منها","كل ثغر وثنيه",116,"ن",3,0],["أَخْرَجَ عَنْهُ التِّرمِذيّ","حَدِيثه والنسئي",117,"ي",1,0],["أَخْرَجَها النَّسائِي","عَنْهُ حَدِيثاً بلها خفاء",117,"ا",2,0],["أخرجَني مُفَضَّلٌ","عَن عادَتي المُفَضَّلَه",118,"ل",2,1],["أخرج يداً بيضاء فاسلك بها","للعبد يا مولاي في جيبه",119,"ب",2,0]]}