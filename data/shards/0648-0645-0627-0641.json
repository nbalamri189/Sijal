 من شاطئي مصر","https://www.aldiwan.net/poem12144.html","الطويل"],[516,"أبا المجد إن تزمع رحيلاً فللندى","https://www.aldiwan.net/poem12210.html","الطويل"],[516,"عطية إن صادفت روح محمد","https://www.aldiwan.net/poem12220.html","الطويل"],[530,"نظام يا ابن ودي أم لآلي","https://www.aldiwan.net/poem37270.html","الوافر"],[530,"إلى الدرعية الغراء تسري","https://www.aldiwan.net/poem37443.html","الوافر"],[530,"مسامع من ناديت يا عمرو سدت","https://www.aldiwan.net/poem37501.html","الطويل"],[552,"خذوا من جفوني ماءها فهي ذرف","https://www.aldiwan.net/poem47400.html","الطويل"],[552,"لنا من ثناياك الغريض المرشف","https://www.aldiwan.net/poem47403.html","الطويل"],[552,"أمن أجل أن أعفاك دهرك تطمع","https://www.aldiwan.net/poem47720.html","الطويل"],[552,"أيا حادي الأظعان لم لا تعرس","https://www.aldiwan.net/poem47754.html","الطويل"],[552,"إن قطعتني علتي عن قصدي","https://www.aldiwan.net/poem47845.html","الرجز"],[552,"سئمت مقامي في الغبينة مغمدا","https://www.aldiwan.net/poem47869.html","الطويل"],[554,"وأبيض أما جسمه فمدور","https://www.aldiwan.net/poem68398.html","الطويل"],[559,"اجمع جميع الحوادث كلها جمله","https://www.aldiwan.net/poem33502.html","المواليا"],[559,"بأسماء رب العالمين ابتدائيا","https://www.aldiwan.net/poem33573.html","الطويل"],[559,"فؤادي له في رتبة الحب ما نوى","https://www.aldiwan.net/poem34088.html","الطويل"],[559,"وجودي جل عن جسمي","https://www.aldiwan.net/poem34248.html","الهزج"],[559,"ومن أعجب الأمر هذا الخفا","https://www.aldiwan.net/poem34360.html","المتقارب"],[559,"أزال عن الوجه الجميل قناعه","https://www.aldiwan.net/poem34366.html","الطويل"],[559,"دللناك يا من أنت ذمي ديننا","https://www.aldiwan.net/poem34710.html","الطويل"],[563,"أسحرا كان شغلي في هواكا","https://www.aldiwan.net/poem52945.html","الوافر"],[564,"غرام سقى قلبي مدامته صرفا","https://www.aldiwan.net/poem13596.html","الطويل"],[576,"ألا فانتبه من أفقها طلع الفجر","https://www.aldiwan.net/poem3064.html","الطويل"],[576,"على كل حال ليس لي عنك مذهب","https://www.aldiwan.net/poem3109.html","الطويل"],[587,"وما فيه من حسن سوى أن طرفه","https://www.aldiwan.net/poem17481.html","الطويل"]],"verses":[["وَما فيهِمُ مَن يَقسِمُ القَومُ أَمرَهُ","وَلا ضارِعٌ يَنقادُ طَوعَ الخَزائِمِ",0,"م",1,0],["وَما فَضلي عَلى قَومي بِخافٍ","كَما فَضلِ القَريعِ عَلى الإِفالِ",1,"ل",1,0],["وَما فَرَحي إِن جاوَرَتكَ حَديقَةٌ","وَقَبرُكَ مَملوءٌ بِغُرِّ الحَدائِقِ",2,"ق",1,0],["وَما في الغَواني مِن سُرورٍ لِناظِرٍ","وَلا في الخُزامى مِن نَسيمٍ لِناشِقِ",3,"ق",1,0],["وَما فَضلُ شَوقِيَ لَولا البُكا","ءُ وَالشَوقُ عُنوانُهُ الأَدمُعُ",4,"ع",1,0],["وَمافِ الأَرضِ أَحسَنُ مِن يَسارٍ","إِذا اِستَولى عَلى أَمرٍ مُطاعِ",5,"ع",1,0],["وَما فَخرُ العَفيفِ الجِس","مِ إِن فَسَقَت سَرائِرُه",6,"ر",2,0],["وَما فيهِ شَيءٌ خالِدٌ لِمُكادِحٍ","وَكُلٌّ لِغاياتِ الأُمورِ طَلوبُ",7,"ب",1,0],["وَما في نِجادِ السَيفِ زَينٌ لِحامِلٍ","وَلا الزَينُ إِلّا لِلفَتى يَومَ يَضرِبُ",8,"ب",1,0],["وَما في سُلوِّ النَّفسِ عَنكِ طَماعَةٌ","فَما هَذِهِ الأَهواءُ إِلّا غَرائِزُ",9,"ز",1,0],["وَما فَتخاءُ تَنفُضُ كُلَّ أَرضٍ","بِعَينٍ إِن رَنَتْ بَلَغَتْ مَداها",10,"ا",3,0],["وَما في الوَرى إِلَّا لَكَ البَدْرُ والِدٌ","وَلا لِسواكَ النَّيِّراتُ قَبيلُ",11,"ل",1,0],["وَما فارَقتُ لُبنى عَن تَقالٍ","وَلَكِن شِقوَةٌ بَلَغَت مَداها",12,"ه",2,0],["وَمَا فَتِئتْ أَنْ أَمْكَنَتْ مِنْ قِيَادِهَا","يَداً سَاءَ فِي الأَمْلاَكِ مِنْهَا لَهَا حُكْمُ",13,"م",1,0],["وَما فَلَجٌ يَسقي جَداوِلَ صَعنَبى","لَهُ شَرَعٌ سَهلٌ عَلى كُلِّ مَورِدِ",14,"د",1,0],["وَما فَخرُهُ إِلّا بِأَن كانَ مُصغِياً","لِأَمرِكَ إِن نادَيتَ لَبّى فَأَسرَعا",15,"ع",2,0],["وَما فَعَلوا فِعلَ العُوَيرِ بِجارِهِ","لَدى بابِ هِندٍ إِذ تَجَرَّدَ قائِما",16,"م",2,0],["وَمَا فِي مَنْزِلٍ للعُرْبِ إِلاَّ","تَباشِير وَزِينَاتٌ تُقَامُ",17,"م",1,0],["وَما فَخرُ مَن لَيسَت لَهُ أَوَّليَّةٌ","تُعَدُّ إِذا عُدَّ القَديمُ وَلا ذِكرُ",18,"ر",1,0],["وما فَقَد المسيحَ الناسُ لمّا","أعدتِ لهم خلائقه الكراما",19,"م",2,0],["وَما فارَقَت يا جَنبُ حَتّى حَبَستَها","مُسَلسَلَةً وافى الهِلالَ جُنونُها",20,"ن",3,0],["وَما في مُباحاتِ الحَديثِ لَنا هَواً","وَلَكِن هَوانا المُنفِساتُ العَقائِلُ",21,"ل",1,0],["وَما في طَلَبِ اللَهوِ","عَلى الفِتيانِ مِن عارِ",22,"ر",1,0],["وَما فَقَدَ الماضونَ مِثلَ مُحَمَّدٍ","وَلا مِثلُهُ حَتّى القِيامَةِ يُفقَدُ",23,"د",1,0],["وما فيه من عيبٍ يعدّ لناقدٍ","سوى أنه بالجود مستعبد الحرّ",24,"ر",1,0],["وما في السحب مثل ندى يديه","ولا في الأرض مثليَ من شكور",25,"ر",1,0],["وما فيه من عيب يعد لعائب","سوى أنه بالجود يستعبد الحرَّا",26,"ر",2,0],["وما فتر هذا الهلال القديم","لخلق عليها سوى خافق",27,"ق",1,0],["وما في شهور العالم بعدكُم هناً","فذا صفرٌ يدعى وهذا محرّم",28,"م",1,0],["وما فيه من عيب سوى أنَّ عنده","أيادٍ تعيد الحرّ في يده قنَّا",29,"ن",2,0],["وما فاته في الصومِ فِطْرٌ لأنهٌ","مُدارِسُ علمٍ والدِّارسُ غذاءُ",30,"ا",2,0],["وما فَخْرُ قومٍ والمَفاخرُ كلُّها","بهم عند ذكر الفخر مُفتخِراتُ",31,"ت",1,0],["وما فرّ منهم بل نَفوه وإنهُ","ليورِد رأياً في الرجوع ويُصدر",32,"ر",1,0],["وما في الناسِ أجودُ من شجاعٍ","وإنْ أعطى القليلَ من النوالِ",33,"ل",1,1],["وما فمي بمفيق من معاتبةٍ","حتى يشافِهَ تلك الكفَّ بالقُبلِ",34,"ل",1,0],["وما فخرُ مَنْ لو فاخر الفخر أصبَحَتْ","مقاليدُه عفواً إليه تسلَّمُ",35,"م",1,0],["وَما فَتِئَت خَيلٌ تَثوبُ وَتَدَّعي","إِلى النَمرِ حَتّى غَصَّ بِالقَومِ عَرعَرُ",36,"ر",1,0],["وَما فيكِ عُضوٌ وَلا مِفصَلٌ","فَتَقطَعُ أَوصالُكِ الأَنصُلُ",37,"ل",1,0],["وَما في الكَونِ مِثلُ الكَونِ فانٍ","كَما تَفنى الدِيارُ كَذا القَطينُ",38,"ن",1,0],["وَما في فُؤادي مَوضِعٌ لِسِواكُمُ","فَمِن أَينَ فيهِ وَهوَ بِالشَوقِ مَلآنُ",39,"ن",1,0],["وَما فَتَنَت قَلبي البِلادُ وَإِنَّما","نَدى المَلِكِ المَسعودِ لِلناسِ فَتّانُ",40,"ن",1,0],["وَما فارَقتَني طَوعاً وَلَكِن","دَهاكَ مِنَ المَنِيَّةِ ما دَهاكا",41,"ك",2,0],["وَما فَرِحَت مِصرٌ بِذا الفَتحِ وَحدَها","لَقَد فَرِحَت بَغدادُ أَكثَرَ مِن مِصرِ",42,"ر",1,0],["وما فعلت تلك السوالف في الثرى","وما فعلت في الترب تلك الترائب",43,"ب",1,0],["وما فتن الحظ بالكركدِّن","وما أعجب المال من سحنته",44,"ه",1,0],["وَما في الشَجاعَةِ حَتفُ الشُجاعِ","وَلا مَدَّ عُمرَ الجَبانِ الجُبُن",45,"ن",1,0],["وَما فَكَّرتُ قَبلَكَ في مُحالٍ","وَلا جَرَّبتُ سَيفي في هَباءِ",46,"ا",2,0],["وَما في سَطوَةِ الأَربابِ عَيبٌ","وَلا في ذِلَّةِ العُبدانِ عارُ",47,"ر",1,0],["وَما في طِبِّهِ أَنّي جَوادٌ","أَضَرَّ بِجِسمِهِ طولُ الجِمامِ",48,"م",1,0],["وما فاتهمْ في أولِ الدهرِ عن قِلىً","ولكن رأى الشيءَ المبيَّتَ أدوَما",49,"م",2,0],["وما فارقتُهمْ طوعاً ولكنْ","قضاءٌ ما ملكتُ لهُ اختياري",50,"ر",2,0],["وما فُضِّلَ الإبريزُ إلّا لأَنّهُ","صبورٌ إِذا ما مَسَّهُ وهجُ الجمرِ",51,"ر",1,0],["وَما في السِتارَةِ مِن حاجِزٍ","إِذا قَرَعَت رُكبَةٌ رُكبَه",52,"ب",2,0],["وَما فيكَ لِلرَكبِ المُرَجّينَ مُرغَبٌ","فَتُلقى وَلَكِنَّ الرَكائِبَ كَلَّتِ",53,"ت",1,0],["وَما فُقِدَ الجَميلُ لِقُربِ عَهدٍ","فَنَسأَلَ عَنهُ بَل نُسِيَ الجَميلُ",54,"ل",1,0],["وَما فَدَحَتنا نَكبَةٌ كَاِفتِقادِنا","أَبا الفَضلِ نَجلَ الأَكرَمينَ الأَفاضِلِ",55,"ل",1,0],["وَما في سُؤالِ الدارِ إِدراكُ حاجَةٍ","إِذا اِستَعجَمَت آياتُها أَن تَكَلَّما",56,"م",2,0],["وَما فَرِقتُ وَقَد كانَت مَحاضِرُنا","مِنها قَريباً حِذاري وِردَها هَجَرُ",57,"ر",1,0],["وَما فَرِحتُ بِبُرءٍ مِن ضَنى مَرَضٍ","كَفَرحَةٍ يَومَ قالوا أَخبَرَ الخَبَرا",58,"ر",2,0],["وَما فارَقتُها شِبَعاً وَلَكِن","رَأَيتُ الدَهرَ يَأخُذُ ما يُعارُ",59,"ر",1,0],["وَما فَرَّ مِن جَيشٍ أَميرٌ عَلِمتُهُ","فَيُدعى طِوالَ الدَهرِ إِلّا مِنافِقا",60,"ق",2,0],["وَما في الناسِ مِن أَحَدٍ يُساوي","زُرارَةُ أَو يَنالُ بَني عِقالِ",61,"ل",1,0],["وَما فيهِما إِلّا سَيُصبِحُ جارُهُ","تَطَلَّعُ في جَوِّ السَماءِ سَلالِمُه",62,"ه",1,0],["وَما فازَ أَهلُ الفَضلِ إِلّا بِصَبرِهِم","عَنِ الشَهَواتِ وَاحتِمالِ المَكارِهِ",63,"ه",1,0],["وَما فيهِ مِن عَيبٍ عَليَّ وَإِنَّما","عَليكَ بِهَذا لا عَليَّ يُعابُ",64,"ب",1,0],["وما فَرحي يْومَ المَسَرّةِ طائعاً","ولا حَزَني يْومَ المساءَةِ عاصيا",65,"ي",2,0],["وما فضلُ الطلول على شَمُولٍ","تمجّ المسك في نَفَس النسيمِ",66,"م",1,0],["وما فَقدت إلّا عَظيماً وفَقدُهُ","به بين أحشاءِ العلى يُوجَدُ الوَجدُ",67,"د",1,0],["وَما فَضلُ العِتاقِ إِذا أَلَظَّت","بِها وَتَأَثَّلَت فيها العُيوبُ",68,"ب",1,0],["وَما في الأَرضِ أَعصى لِاِمتِناعٍ","يَسوقُ الذَمَّ مِن جودٍ مُطاعِ",69,"ع",1,0],["وما فضلُ مولانا ببدْعٍ فكمْ لهُ","مآثرِ إحسانٍ جليٍّ وضوحُها",70,"ح",3,0],["وما في البريةِ مِنْ رافضٍ","لفضلي إلا لَهُ مصرعُ",71,"ع",1,0],["وما في سطوةِ الخلاّقِ عيبٌ","ولا في ذلّةِ المخلوقِ عارُ",72,"ر",1,0],["وما فَضْلُ الشُّعوبِ إذا أضاعتْ","أواخرُها تُراثَ الأوّلينا",73,"ن",2,0],["وما في الأرضِ أعدلُ من حُسامٍ","إذا جَمحَ الهوى بالحاكمينا",73,"ن",2,0],["وَما في الأَرضِ أَسعَدُ مِن وَفِيٍّ","أَمينِ العَهدِ مَأمونِ الجِنايَهْ",74,"ا",3,0],["وَما فَضَلوكُم غَيرَ أَنَّ أَباكُمُ","أَطالَ فَأَكدى ثُمَّ قالَ فَأَنكَدا",75,"د",2,1],["وَمَا فيهِمُ لا بارَكَ اللَّهُ فيهمُ","أَخُو قَلَمٍ إِلَّا يَخُونُ ويَغْدِرُ",76,"ر",1,0],["وما فِرْعَوْنُ فيها غَيْرَ مُوسَى","يَسُومُ المُسْلِمينَ أَذَىً وهُونا",77,"ن",2,0],["وَما فَوقَ ظَهرِ الأَرضِ أَنعَمُ عيشَةً","وَأَعرَضُ دُنيا مِن مُحِبٍّ إِذا اقتَدَر",78,"ر",1,0],["وَما في هَلاكِ اِبنِ الخُلَيقِ لِرَهطِهِ","فَسادٌ وَلَكِن في البَقاءِ فَسادُ",79,"د",1,0],["وَما في سُهَيلٍ طائِلٌ غَيرَ أَنَّهُ","إِذا نيكَ أَعطى غَيرَ كِزٍّ وَلا جَحِد",80,"د",1,0],["وَما فارَقتُ مِن سَرَفٍ وَلَكِن","طَغى طَرَبي وَمالَ بِيَ الفَتاءُ",81,"ا",2,0],["وَما في يَدٍ قُلُبٌ وَلا أَسؤُقٍ بُراً","وَلا مَفرَقٍ تاجٌ وَلا أُذُنٍ رَعَث",82,"ث",1,0],["وَما فَتِئَت وُلاةُ الأَمرِ فيها","على الصَفراءِ تُصرِفُ أَو تَشِجُّ",83,"ج",1,0],["وَما فَقِهتُ المَرادَ مِنها","كُلُّ فَقيهٍ لَهُ مُعيدُ",84,"د",1,0],["وَما فِعلَتُهُ عُبّادُ النَصارى","وَلا شَرعِيَّةٌ صَبَأوا وَهادوا",85,"د",3,0],["وَما فَوقَ هَذي الأَرضِ إِلّا مُؤَهَّلٌ","لِهَمٍّ فَقارِب في الظُنونِ وَباعِدِ",86,"د",1,0],["وَما فَسَدَت أَخلاقُنا بِاِختِيارِنا","وَلَكِن بِأَمرٍ سَبَّبَتهُ المَقادِرُ",87,"ر",1,0],["وَما فيكُم عَلى الإِحسانِ جازٍ","وَلا مِنكُم عَلى النُعمى شَكورُ",88,"ر",1,0],["وَما فَتِئَت نيرانُ فارِسَ يَعتَلي","بِها العِزُّ حَتّى أَبطَلَتها الأَحامِسُ",89,"س",1,0],["وَما في الأَرضِ مِن شِربٍ كَريمٍ","يُسَرُّ بِوَردِهِ الصادي العَيوفُ",90,"ف",1,0],["وَما فَتِئَت رُسُلُ الحِمامِ تَزورُنا","إِذا لَم تُشافِه ذَكَّرَتنا أَلوكُها",91,"ك",3,0],["وَما فَتِئتُ وَأَيّامي تُجَدَّدُ لي","حَتّى مَلَلتُ وَلَم يَظهَر بِها مَلَلُ",92,"ل",1,0],["وَما في الأَرضِ مِن أَحَدٍ غَنِيٍّ","وَلَكِن كُلُّنا فُقَراءُ عالَه",93,"ل",2,0],["وَما فَتِأَت روحُ الفَتى في نَوائِبٍ","تُمارِسُها حَتّى اِستَقَلَّت عَنِ الجِسمِ",94,"م",1,0],["وَما في الناسِ أَجهَلُ مِن غَبِيٍّ","يَدومَ لَهُ إِلى الدُنيا رُكونُ",95,"ن",1,0],["وَما فَتِئَت تَرمي الفَتى عَن قُسِيَّها","بِكُلِّ الرَزايا مِن جَميعِ الأَماكِنِ",96,"ن",1,0],["وَما فَتِئَ الفَتَيانِ الحَياةَ","يَروحانِ بِالشَرِّ أَو يَغدُوانِ",97,"ن",1,0],["وَما فَتَلاهُ عَن سَجاياهُ بَعدَما","أَجادَ كِتاباً مُحكَماً فَتَلاهُ",98,"ل",3,0],["وَما فَعَلوا وَلَكِن باكَروهُ","بِأَسبابِ الحِمامِ فَقَضَّبوهُ",99,"ب",3,0],["وَما في نَشرِ هَذا الخَلقِ نُعمى","فَهَل يُلحى الزَمانُ إِذا طَواهُ",100,"و",3,0],["وما فَقَدَ الحُسَينَ ولا عَلِيّاً","وَلِيُّ هُدىً رآكَ له نَصيحا",101,"ح",2,0],["وما فتئت تأتي الطبيعة فعلها","فتنشأ أكوان وتخرب أكوان",102,"ن",1,0],["وما في بلاد اللَه كالظلم هادمٍ","ولا مثل حكم العدل بانٍ يشيدها",103,"د",3,0],["وَما فئة الإصلاح إلا كبارق","يغرك بالقطر الَّذي ليس يهطل",104,"ل",1,0],["وما في الجوانح خاف عليك","وقلبك يعلم ما غيبا",105,"ب",2,0],["وما في جبينك يا ابنَ الخيال","سِماتٌ تحدِّث عن غَدرِها",106,"ر",3,0],["وما فنُّهُ ما أراهُ سوى","أداةِ مطامعِه الواسعهْ",107,"ه",1,0],["وما فِيَّ إِلَّا الشِّعْر أَثْبَتَهُ الهَوى","فسارَ به في العالَمِين فَرِيدُ",108,"د",1,0],["وَمَا فِي الدَّهْرِ خَيْرٌ مِنْ حَيَاةٍ","يَكُونُ قِوَامُها رَوْحَ الشَّبَابِ",109,"ب",1,0],["وَمَا فِي النَّسَاءِ الفُضْلَيَاتِ كَزَوْجِهِ","وَلاَ كَبَنِيهِ الغُرِّ فِي صالِحِ النَّسْل",110,"ل",1,0],["وَمَا فِي سَيْفِهِ الْمَاضِي كَلاَلٌ","إِذَا لَمْ يُغْنِ رَأْيٌ عَنْ مَكَرِّ",111,"ر",1,0],["وَمَا فَارَقْتُ عَنْ مَلَلٍ وَهَجْرٍ","وَلَكِنْ شَاءَ رَبُّكِ كُلَّ أَمْرِ",112,"ر",1,0],["وَمَا فِكْرُهُ فِي نَهْضَةِ العَصْرِ جَامِدٌ","وَمَا حِسُّهُ فِي مَوْطِنِ البِرِّ جَامِدُ",113,"د",1,0],["وما فكَّكَ الشَّعبَ مثلُ النزاعِ","إذا هُوَ بينَ بنيه احتَدَمْ",114,"م",1,0],["وما فضل طفلٍ إذا ما استهلّ","تلقتهُ في المهد أيدي الإماء؟",115,"ا",2,0],["وما فتئ الزمان يدور حت","ى مضى بالمجد قوم آخرونا",116,"ن",2,0],["وما فارسٌ الا جنانٌ مُضاعةٌ","ويا رُبَّ خمْرٍ لم تجد من مُصفق",117,"ق",1,0],["وما فَلَّتِ الايامُ مني صرامة","ولا زحزحت علمي بانيَ باسل",118,"ل",1,0],["وما فيك يا عرش الشباب مزية","على الشيب الا السير فيك على عمى",119,"م",2,0],["وما في يدي إلاّ فؤادي أنَرْته","لِيُلْقي على سُودِ الخطوبِ شُعاعا",120,"ع",2,0],["وما فارَقَتْني المُلْهِباتُ وإنَّما","تطامَنْتُ حتّى جمرُها غيرُ لاذعي",121,"ع",2,0],["وما فيك عضو ولا مفصل","فتقطع أوصلك الأنصل",122,"ل",1,0],["وما في يدٍ قُلبٌ، ولا أسؤقٍ بُرىً،","ولا مَفرَقٍ تاجٌ، ولا أُذُنٍ رَعث",123,"ث",1,0],["وما فيك لي بَلَلٌ من صَدى","فما بيدٍ عن يدٍ من غنى",124,"ا",1,0],["وما فتنتْ بعد ابن عمران قومهُ","بما عبدوا إلا ليهلكَ عابد",125,"د",1,0],["وما فاز الا الصالحون ومن مضى","الى الله من كل المآثم تائبا",126,"ب",2,0],["وما فتئ المقدار يمضي قضاءه","وما انفك صرف الدهر يعطي ويسلب",127,"ب",1,0],["وما فرحي ان الرياح رواقدٌ","إذا كنت سهران الفؤاد مدى الدهر",128,"ر",1,0],["وَما في العِدا مَن كانَ يَحجَدُ فَضلَهُ","قَطَعنا بِإِجماعٍ عَلى أَنَّ مِثلَهُ",129,"ه",1,0],["وما فتأ الزمانُ يسوم روحي","من التعذيبِ سوما سرمديا",130,"ي",2,0],["وما في غنى من يختشي العدم مقنع","لمن رزقه في كفّ من لم يخف عدما",131,"م",2,0],["وما فات ما يمسي القضاء يحوشه","إليك ويحببا من أمام ومن خلف",132,"ف",1,0],["وما في الأرض ان فتّشتَ ملكٌ","يعدُّ ثلاثةً إِلاّ كذوبا",133,"ب",2,0],["وما فخر المباهي بالركايا","على من سيل مفخره جلاخ",134,"خ",1,0],["وما فضُلها خافٍ على السيف والقنا","وصحبتُها للكفِّ أكثر بل أَهنا",135,"ن",2,0],["وما فهمت بالعورآء فيمن يسؤني","فدع من اياديه علي تدفق",136,"ق",1,0],["وما فيه لا والله مثقال ذرة","وحاشاه مما أنت في النوم حالمه",137,"م",2,0],["وما فخر زاه عجلت طيباته","على مسلم بالامتحان يهذب",138,"ب",1,0],["وما في مصير المرء بعد صداقة","عدواً إذا صافي العدو تريب",138,"ب",1,0],["وَما في الأَرضِ أَشقى مِن مُحِبٍّ","وَإِن وَجَدَ الهَوى حُلوَ المَذاقِ",139,"ق",1,1],["وَما فَضلُ مَن لا يُرتَجى لِمُلِمَّةٍ","تُلِمُّ وَلا تُبغى لَدَيهِ الفَوائِدُ",140,"د",1,0],["وَما في بَني قَحطانَ إِن شُنَّتِ الوَغى","تَوانٍ وَلا يَنبُو لَدَينا حُسامُها",141,"م",3,0],["وما في قصده شك","ولا يدري متى يصل",142,"ل",1,0],["وَما فارَقتني لَحظةً منذُ نَشأتي","وَما ذُقتُ في عُمري بوقتٍ لَها هَجرا",143,"ر",2,0],["وَما في الغَوطتين سِوى زَفير","يصعِّدُهُ مِن الآلامِ عُمقُ",144,"ق",1,0],["وَما في الجامِعِ الأَمَوِيِّ إِلّا","صُراخٌ من تَفَجُّعِهِ وَشَهقُ",144,"ق",1,0],["وَما فِعلُ سَهمٍ سَدَّدَتهُ من النَوى","كَفِعلِ حُسامٍ جَرَّدَته من الصَدِّ",145,"د",1,0],["وما فاتَني فيه منْ المجد والغنى","فما أنا إذ نلتُ الحجا فيه نادم",146,"م",1,0],["وما فارَقونا يَرْتَضُون فِراقَنا","ولكنْ مُلِمّاتُ الزمانِ ضُروبُ",147,"ب",1,0],["وما فَضّ لامِي صادَها بجنايةٍ","سوى قولِها إن المسيح لها رَبُّ",148,"ب",1,0],["وما فخر عبد لا يكون ولاؤه","لأكرم خلق الله حافٍ ومحتذى",149,"ذ",2,0],["وَما فيهِ غَيرُكَ مَن يُستَماحُ","وَما فيهِ إِلّاكَ مَن يُسأَلُ",150,"ل",1,0],["وَما فارَقَت بيضُ السُيوفِ غُمودَها","وَلا حَمَلَت أُسدَ العَرينِ ضَوامِرُه",151,"ر",2,0],["وما فتىء الطماع يلقي شباكه","ويبسم في أسنانه وهي أنيب",152,"ب",1,0],["وما فتحت عيناك إلا على علىً","من المجد لا تألو لها تتطلب",152,"ب",1,0],["وَما فاه الّا بِالَّذي قَد فَعلته","فَأَنتَ الَّذي أَطريتَ نفسك",153,"ك",1,0],["وَما في فيكَ من بَرَدٍ وَشُهد","وَفي خَديك مِن وَردٍ وَراحِ",154,"ح",1,0],["وما فضل طول حياة الفتى","إذا لم يعش ابداً سرمدا",155,"د",2,0],["وما في نَصرنا فخرٌ ولكن","أرَدنا أن نكونَ مؤدّبينا",156,"ن",2,0],["وَما فعل الرمل العَقيقي هَل ذرت","عليه شمال أَم صبا وَجنوب",157,"ب",1,0],["وَما فَارَقَتْ في السِّلم والحَرْب ما انْتَحَى","مَقَاصِدُ فاروقِيَّةٌ وشَمَائِلُ",158,"ل",1,0],["وَما فارَقْتَ مَنْ يُسْلى وَلكِنْ","سِوى الآسادِ تُحْزِنُها الشُّبُولُ",159,"ل",1,0],["وَما فَقْدُ الْفُرُوعِ كَبيرُ رُزْءٍ","إِذا سَلِمَتْ عَلى الدَّهْرِ الأُصُولُ",159,"ل",1,0],["وَما فَضْلُ بِنْتِ الْكَرْمِ يَوْماً ببَيِّنٍ","إِذا لَمْ يَطُلْ عَهْدُ ابْنَةِ الْكَرْمِ بِالْكَرْمِ",160,"م",1,0],["وَمَا فُقْتُهمْ حَتّى تَفَرَّدْتَ دُونَهُمْ","بِرَأْيِكَ في صَرْفِ الْخُطُوبِ اللَّوَازِبِ",161,"ب",1,0],["وَما فَعَلَت سُيوفُ الهن","دِ ما فعلت بِنا المُقَلُ",162,"ل",1,0],["وما في طريق القوم يدعوك لاِنتها","مخالفة للشرع فاسمع وانصت",163,"ت",1,0],["وما فات مات فخل الندا","مة وانفض غبار السأم",164,"م",1,0],["وَمَافي ذاكَ مِنَ بأْسٍ","فَقُلْتُ لَهُمْ وَلا جُودُ",165,"د",1,0],["وَما في الكَونِ مِن كَونٍ","بِهِ وَلَهُ وَمُعجِزُه",166,"ز",2,0],["وَما في الحَجّ مِن عَمَلٍ تَراه","لِوَجه اللَه فَهوَ بِهِ عَليمُ",167,"م",1,0],["وَما في زباها من قَوام مهفهَف","عَلا وَغَلا عَن أَن يُباع وَأَن يشرى",168,"ر",2,0],["وما فُرَصُ الإمكانِ إلاّ مُعارةٌ","فإن كُنتُما لم تَعْلَما ذاك فاعْلَما",169,"م",2,0],["وما في بنى ماءِ السماء أُشابَةٌ","تُعَدُّ وهل ماءُ السّماءِ مَشوب",170,"ب",1,0],["وَما في يَدي مِنهُ سِوى أَنَّ خاطِري","بِعابِرَةِ الأَخبارِ عَنهُ يُخَبَّرُ",171,"ر",1,0],["وَما فَوقَ التُرابِ يُعَدُّ مِنهُ","فَلا تَقنَ الثَرى وَاِقنَ الحَياءَ",172,"ا",2,0],["وَما فَوقَ ما قَد نِلتَهُ مِن زِيادَةٍ","بَلِ اللَهُ أَولى بِالزِيادَةِ فَاِزدَدِ",173,"د",1,0],["وَما في الأَرضِ أَشعُرُ مِن أَديبٍ","يَقولُ الشِعرَ في البُخَلاءِ سُخرَه",174,"ر",2,0],["وَما في يَدي مِن نَيلِ عَفوِكَ حُجَّةٌ","بَلى في يَدي ما في يَدَيكَ مِنَ الفَضلِ",175,"ل",1,0],["وَما في صُدورِ الزغفِ غَيرُ وَدائِعٍ","وَلا في ظُهورِ الخَيلِ غَيرُ غَنائِمِ",176,"م",1,0],["وما فارَقتُها شِبراً","إلى أن بلعَت شِبرا",177,"ر",2,0],["وَما فَضل حَرّ ذل في طَلَب الغِنى","وَرَب الوَرى يَكفيهِ مِن غَير إِشكالِ",178,"ل",1,0],["وَما فَضل عَيش لا يُنازع كَأسُهُ","حَبيبٌ صَبيحٌ أَو أَغَرُّ فَصيح",179,"ح",1,0],["وَما فَضل نَفسي الحُرّ وَاللَهُ كافل","لِأَرزاقِهِ إِن ذلَّ يَوماً لِيَستَغني",180,"ن",2,0],["وما فقدتك في لعب ولهو","ولافقدتك في أمر مُريب",181,"ب",1,0],["وما فن حوى القرطاس إلا","وقرطس في مراميه سهامي",182,"م",2,0],["وما فَقرُ قَفْرٍ طالَ بالرىِّ عَهدُه","إلى صَيبٍ جَوْدٍ يُرَوِّي غَليلَها",183,"ه",2,1],["وما في ضَربها ألمٌ بشيءٍ","من الأَشياءِ إلا بِالهُموم",184,"م",1,0],["وما في الصُّبحِ لي رَوحٌ ولكن","به يتعلَّلُ الدَّنِفُ العَليلُ",185,"ل",1,0],["وَما فَعَلَت بَنو مَروانَ خَيراً","وَلا فَعَلَت بَنو مَروانَ شَرّاً",186,"ر",2,1],["وما فَرَّقْتُ شمل الدَّمع إلاَّ","غداةَ البين إذ ظعن الفريق",187,"ق",1,0],["وما فتنة العشَّاق إلاَّ نواظر","تصابُ قلوب عندها وعقول",188,"ل",1,0],["وما فات قصدٌ من جسور على الرَّدى","بعيد مناط الهمّ جمّ المقاصد",189,"د",1,0],["وما فيكم إلاَّ طموح إلى العُلى","جموحٌ إلى مجد طريف وتالد",189,"د",1,0],["وما فيك ما تعطي مَلالاً ولا قلىً","وغيرك إنْ سيمَ العطاء ملول",190,"ل",1,0],["وما في النَّاس من تَلْقاهُ إلاَّ","ويَسْأَلُ من عُلومِكَ أو نوالك",191,"ك",1,0],["وما فَعَلتْ بأصحابي المنايا","فأبْقَتْني وقد أخَذَتْ صحابي",192,"ب",2,0],["وما في الماجدين أجلُّ قدراً","ولا أورى وأثقب منكَ زندا",193,"د",2,0],["وما فاحَ فينا غيرُ ذكراكَ روضةٌ","ولا ساحَ فينا غيرُ نُغماكَ مورِدُ",194,"د",1,0],["وما فرقي من حادث ظلت جازعا","له وشهاب الدين بالجود غالبُه",195,"ب",2,0],["وما فوّقت أيدي البعاد لشملنا","سهام النهوى والخطبُ وسنان نائمُ",196,"م",1,0],["وما فرقي والحادثات تلمّ بي","من الدهر والملك المعظّمُ عاصم",196,"م",1,0],["وما فارقت قومي إن رآني","بعين رضىً أبو حسن عليّ",197,"ي",1,0],["وَمَا فِي لَحْظِ طَرْفِكَ من نُبُوٍّ","ولا فِي نُورِ رَأْيِكَ من هَباءِ",198,"ا",2,0],["وَمَا فِي وَعْدِ رَبِّ العَرْشِ خُلْفٌ","بِما لِلْمُحْسِنِينَ مِنَ الجَزَاءِ",198,"ا",2,0],["وَمَا فات صَرْفَ الرَّدى مَنْ عَلَيْهِ","لِنَصْرِكَ عَيْنُ رَقِيبٍ عَتِيدِ",199,"د",1,0],["وما فيها إذا قصدت صديق","وبئس الدار دار بلا صديق",200,"ق",1,0],["وما فرقت أيدي المنايا مجمع","وما جمعت أيدي البرايا مفرق",201,"ق",1,0],["وما فتَّقَتْ أيدي القِطارِ بسحْرَةٍ","من النَّور في جيدِ الغصونِ النواعمِ",202,"م",1,0],["وما فاضَ حتى ضاق عنه إناؤه","وقد يملأ القَطرُ الإناءَ فيُفعَمُ",203,"م",1,0],["وما فيهمُ جامعٌ ما جمعتَ","إذا أنتَ حصَّلت أوحصَّلوا",204,"ل",3,0],["وما فات مطلوبٌ سرى الجد خلفه","وضامِنُه العمرُ المؤخَّر والصبرُ",205,"ر",1,0],["وما فاتني نصرُكم باللسان","إذا فاتني نصرُكم باليدِ",206,"د",1,0],["وما فضلَ الكرامُ الناسَ إِلا","فضلْت على السَّراةِ من الكرِام",207,"م",1,0],["وما فاخرَتْهُ في المضاءِ قواضِبٌ","من البيض اِلا كان أمضى وأقْدرا",208,"ر",2,1],["وما فقت الورى سعة ودنيا","ولكن فقتهم كرماً ودينا",209,"ن",2,0],["وما فضلت في القيمة القصبَ القنا","مع الشّبه لولا هزَّها في الذوابل",210,"ل",1,0],["وما فاض دمع العين حتى تبسّمتْ","طلائع برقٍ من تهامة تلمحُ",211,"ح",1,0],["وما فارقتها العينُ إلاَّ قريحةً","ولا القلبُ إلاّ مستهاماً متيّماً",212,"م",2,0],["وما في فؤادي للتجلد فضلةٌ","فيشكو النوى خطبُ النوى اليوم شاغله",213,"ل",2,0],["وما في الناسِ أشقى مِن مُحِبًّ","تكلَّفَ عن أحبتِه اصطبارا",214,"ر",2,0],["وما في الديارِ غداةَ","الرحيلِ إلا فتَّى لبُه طائحِ",215,"ح",1,0],["وما في استنارته من نظير","فأشبه في نوره القمرين",216,"ن",1,0],["وما في الأرض إن فكرت شيء","أحقّ بطول سجن من لسان",217,"ن",1,0],["وما فسدت لي يشهد اللَه نية","ولكنما استفسدتني فأتهمتني",218,"ن",2,0],["وما فَقْرُ مَثواه الرّويِّ إلى الحَيا","وفيهِ انطَوى بحرٌ لذيذ المَشاربِ",219,"ب",1,0],["وما في بَناتِ النّعشِ حاجةُ نعشِهِ","كفى ما حوَتْهُ من حِسانِ المَناقِبِ",219,"ب",1,0],["وما فارقني نعمة صالحية","كأني من مصر رحلت إلى مصر",220,"ر",1,0],["وما فرحت إخميم قبلك بامرئ","له غرر من فضله وحجول",221,"ل",1,0],["وما في بني ذا الجيل من هو مثلكم","كما ليس في آبائهم أحد مثلي",222,"ل",2,0],["وَما في سُنّةٍ للطُّهُرِ طَهَ","مُسَلْسَلةٍ بأسْنادِ الرّجالِ",223,"ل",1,0],["وَمَا في قَالَ زَيْدٌ قال عَمْرٌو","مَفَادٌ إنْ تَزَاحَمَتِ الْوُفُودُ",224,"د",1,0],["وَما فَاضَ مِنْ فَضْلِ الإلَهِ عَلَى الألي","مَضَوْا فَهْوَ فَيَّاضٌ عَلَيْهمْ بِحِكْمَةِ",225,"ه",1,0],["وَما فَخرنا إلّا الّذي هَبَطَتْ به ال","ملائك أو ما قد حوى منه مُصْحَفُ",226,"ف",1,0],["وَما فيهمُ إِلّا الّذي يشهد الوغى","فيُحيي بها من ذا يشاء ويُتْلِفُ",227,"ف",1,0],["وما فيهمُ والحربُ تقتنصُ الطُّلى","بِأَيدي الظّبا إِلّا الغلامُ المُشَيَّعُ",228,"ع",1,0],["وَما فيهِمُ لِلهُونِ مَرعىً ومَجْثَمٌ","ولا منهُمُ للذّلِّ خدٌّ ومَعْطِسُ",229,"س",1,0],["وما فَراهمْ فهْوَ فارٍ جِلدي","ما لَهمُ واللَّه مِثلي بَعدِي",230,"د",2,0],["وَما فيهمُ إلّا فَتىً ما تلبّستْ","بِهِ الحَربُ إلّا كانَ عَضْباً مجرّدا",231,"د",2,0],["وَما فيهِ مِن نَفعٍ سِوى خَطِّ رَأسِهِ","وَبَعدُ فَفيهِ زينَةٌ وَوَقارُ",232,"ر",1,0],["وما فضل بعد هذا فاشمُلُهْ شملَهْ","هو الوجود الحقيقي صاحب العملهْ",233,"ه",1,0],["وما في حروف الكائنات من الذي","له نورك الفياض لا زال حاويا",234,"ي",2,0],["وما فاتني شيء إذا كنت ألقاكم","أحباي إني المستهام المجردُ",235,"د",1,0],["وما في عالمي غيري","فخفض عنك يا خلي",236,"ل",2,0],["وما في الوجود سوى واحد","ولكن تكثَّر لما صفا",237,"ف",2,0],["وما في يدهم غير دعوى وعندهم","سراب شراب لا يزالون قاعه",238,"ع",2,0],["وما فعل القاضي قبيحاً وإنما","فعلت قبيحاً أنت بين البرية",239,"ه",1,0],["وما فَقَدَ اليتيمُ أباً كريماً","إذا غطَّاهُ فَضلٌ من رِداكا",240,"ك",2,0],["وَما في ذِراعِ الشاةِ مِمّا تَعَمَّدَت","يَهودُ وَلَكِن ما أَعَفَّ وَما أَعفا",241,"ف",2,0],["وما فاتَه إِلا الجيوشُ يَجُرُّها","وقد جَرَّ منها ما يَضيقُ بِه البَرُّ",242,"ر",1,0],["وَمَا فيهما مُحصٍ ولكن مُقَصِّرٌ","ومعترفٌ أَن ليسَ يُحسِنُ مُحسِب",243,"ب",1,0],["وَمَا فَيهِ مِنْ حُسْنٍ سِوَى أَنَّ طَرْفَهُ","لِكُلِّ فُؤَادٍ في البَرِيَّةِ صَائِدُ",244,"د",1,1]]}