an.net/poem23545.html","المتقارب"],[46,"لعمري الخير الذخر في كل شدة","https://www.aldiwan.net/poem23557.html","الطويل"],[46,"قد اختل الأنام بغير شك","https://www.aldiwan.net/poem23561.html","الوافر"],[46,"تحمل عن أبيك الثقل يوما","https://www.aldiwan.net/poem23564.html","الوافر"],[46,"ألاح وقد رأى برقا مليحا","https://www.aldiwan.net/poem23637.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85845","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85439","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85552","الطويل"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125511","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39578","المتقارب"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[84,"","https://poetry.dctabudhabi.ae/diwan/poem/30450","الطويل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42506","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55168","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54856","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54836","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54752","الطويل"],[106,"صدى الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=179584",""],[106,"عدل السماء","https://www.poetsgate.com/ViewPoem.aspx?id=179777",""],[103,"ملكنا هذه الدنيا قرونا","https://www.poetsgate.com/ViewPoem.aspx?id=1234",""],[90,"الذكرى المؤلمة","https://www.poetsgate.com/ViewPoem.aspx?id=179016",""],[90,"ثورة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=179144",""],[90,"صحو بعد سكر","https://www.poetsgate.com/ViewPoem.aspx?id=178933",""],[90,"شباب ضائع","https://www.poetsgate.com/ViewPoem.aspx?id=179161",""],[90,"أجب أيُّها القلب","https://www.poetsgate.com/ViewPoem.aspx?id=179171",""],[91,"ريح الشمال","https://www.poetsgate.com/ViewPoem.aspx?id=53198",""],[46,"ثِيابيَ أكفاني، ورَمْسيَ منزِلي،","https://www.poetsgate.com/ViewPoem.aspx?id=18128",""],[75,"ألا كلُّ آتٍ قريبُ المَدى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10783&r=&rc=3",""],[67,"جَنابكِ منه تُسْتَفَادُ الفَوائدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13730&r=&rc=6",""]],"verses":[["وَما فيهِمُ مَن يَقسِمُ القَومُ أَمرَهُ","وَلا ضارِعٌ يَنقادُ طَوعَ الخَزائِمِ",0,"م",1,0],["وَما فَضلي عَلى قَومي بِخافٍ","كَما فَضلِ القَريعِ عَلى الإِفالِ",1,"ل",1,0],["وَما فَرَحي إِن جاوَرَتكَ حَديقَةٌ","وَقَبرُكَ مَملوءٌ بِغُرِّ الحَدائِقِ",2,"ق",1,0],["وَما في الغَواني مِن سُرورٍ لِناظِرٍ","وَلا في الخُزامى مِن نَسيمٍ لِناشِقِ",3,"ق",1,0],["وَما فَضلُ شَوقِيَ لَولا البُكا","ءُ وَالشَوقُ عُنوانُهُ الأَدمُعُ",4,"ع",1,0],["وَمافِ الأَرضِ أَحسَنُ مِن يَسارٍ","إِذا اِستَولى عَلى أَمرٍ مُطاعِ",5,"ع",1,0],["وَما فَخرُ العَفيفِ الجِس","مِ إِن فَسَقَت سَرائِرُه",6,"ر",2,0],["وَما فيهِ شَيءٌ خالِدٌ لِمُكادِحٍ","وَكُلٌّ لِغاياتِ الأُمورِ طَلوبُ",7,"ب",1,0],["وَما في نِجادِ السَيفِ زَينٌ لِحامِلٍ","وَلا الزَينُ إِلّا لِلفَتى يَومَ يَضرِبُ",8,"ب",1,0],["وَما في سُلوِّ النَّفسِ عَنكِ طَماعَةٌ","فَما هَذِهِ الأَهواءُ إِلّا غَرائِزُ",9,"ز",1,0],["وَما فَتخاءُ تَنفُضُ كُلَّ أَرضٍ","بِعَينٍ إِن رَنَتْ بَلَغَتْ مَداها",10,"ا",3,0],["وَما في الوَرى إِلَّا لَكَ البَدْرُ والِدٌ","وَلا لِسواكَ النَّيِّراتُ قَبيلُ",11,"ل",1,0],["وَما فارَقتُ لُبنى عَن تَقالٍ","وَلَكِن شِقوَةٌ بَلَغَت مَداها",12,"ه",2,0],["وَمَا فَتِئتْ أَنْ أَمْكَنَتْ مِنْ قِيَادِهَا","يَداً سَاءَ فِي الأَمْلاَكِ مِنْهَا لَهَا حُكْمُ",13,"م",1,0],["وَما فَلَجٌ يَسقي جَداوِلَ صَعنَبى","لَهُ شَرَعٌ سَهلٌ عَلى كُلِّ مَورِدِ",14,"د",1,0],["وَما فَخرُهُ إِلّا بِأَن كانَ مُصغِياً","لِأَمرِكَ إِن نادَيتَ لَبّى فَأَسرَعا",15,"ع",2,0],["وَما فَعَلوا فِعلَ العُوَيرِ بِجارِهِ","لَدى بابِ هِندٍ إِذ تَجَرَّدَ قائِما",16,"م",2,0],["وَمَا فِي مَنْزِلٍ للعُرْبِ إِلاَّ","تَباشِير وَزِينَاتٌ تُقَامُ",17,"م",1,0],["وَما فَخرُ مَن لَيسَت لَهُ أَوَّليَّةٌ","تُعَدُّ إِذا عُدَّ القَديمُ وَلا ذِكرُ",18,"ر",1,0],["وما فَقَد المسيحَ الناسُ لمّا","أعدتِ لهم خلائقه الكراما",19,"م",2,0],["وَما فارَقَت يا جَنبُ حَتّى حَبَستَها","مُسَلسَلَةً وافى الهِلالَ جُنونُها",20,"ن",3,0],["وَما في مُباحاتِ الحَديثِ لَنا هَواً","وَلَكِن هَوانا المُنفِساتُ العَقائِلُ",21,"ل",1,0],["وَما في طَلَبِ اللَهوِ","عَلى الفِتيانِ مِن عارِ",22,"ر",1,0],["وَما فَقَدَ الماضونَ مِثلَ مُحَمَّدٍ","وَلا مِثلُهُ حَتّى القِيامَةِ يُفقَدُ",23,"د",1,0],["وما فيه من عيبٍ يعدّ لناقدٍ","سوى أنه بالجود مستعبد الحرّ",24,"ر",1,0],["وما في السحب مثل ندى يديه","ولا في الأرض مثليَ من شكور",25,"ر",1,0],["وما فيه من عيب يعد لعائب","سوى أنه بالجود يستعبد الحرَّا",26,"ر",2,0],["وما فتر هذا الهلال القديم","لخلق عليها سوى خافق",27,"ق",1,0],["وما في شهور العالم بعدكُم هناً","فذا صفرٌ يدعى وهذا محرّم",28,"م",1,0],["وما فيه من عيب سوى أنَّ عنده","أيادٍ تعيد الحرّ في يده قنَّا",29,"ن",2,0],["وما فاته في الصومِ فِطْرٌ لأنهٌ","مُدارِسُ علمٍ والدِّارسُ غذاءُ",30,"ا",2,0],["وما فَخْرُ قومٍ والمَفاخرُ كلُّها","بهم عند ذكر الفخر مُفتخِراتُ",31,"ت",1,0],["وما فرّ منهم بل نَفوه وإنهُ","ليورِد رأياً في الرجوع ويُصدر",32,"ر",1,0],["وما في الناسِ أجودُ من شجاعٍ","وإنْ أعطى القليلَ من النوالِ",33,"ل",1,1],["وما فمي بمفيق من معاتبةٍ","حتى يشافِهَ تلك الكفَّ بالقُبلِ",34,"ل",1,0],["وما فخرُ مَنْ لو فاخر الفخر أصبَحَتْ","مقاليدُه عفواً إليه تسلَّمُ",35,"م",1,0],["وَما فَتِئَت خَيلٌ تَثوبُ وَتَدَّعي","إِلى النَمرِ حَتّى غَصَّ بِالقَومِ عَرعَرُ",36,"ر",1,0],["وَما فيكِ عُضوٌ وَلا مِفصَلٌ","فَتَقطَعُ أَوصالُكِ الأَنصُلُ",37,"ل",1,0],["وَما في الكَونِ مِثلُ الكَونِ فانٍ","كَما تَفنى الدِيارُ كَذا القَطينُ",38,"ن",1,0],["وَما في فُؤادي مَوضِعٌ لِسِواكُمُ","فَمِن أَينَ فيهِ وَهوَ بِالشَوقِ مَلآنُ",39,"ن",1,0],["وَما فَتَنَت قَلبي البِلادُ وَإِنَّما","نَدى المَلِكِ المَسعودِ لِلناسِ فَتّانُ",40,"ن",1,0],["وَما فارَقتَني طَوعاً وَلَكِن","دَهاكَ مِنَ المَنِيَّةِ ما دَهاكا",41,"ك",2,0],["وَما فَرِحَت مِصرٌ بِذا الفَتحِ وَحدَها","لَقَد فَرِحَت بَغدادُ أَكثَرَ مِن مِصرِ",42,"ر",1,0],["وما فعلت تلك السوالف في الثرى","وما فعلت في الترب تلك الترائب",43,"ب",1,0],["وما فتن الحظ بالكركدِّن","وما أعجب المال من سحنته",44,"ه",1,0],["وَما في الشَجاعَةِ حَتفُ الشُجاعِ","وَلا مَدَّ عُمرَ الجَبانِ الجُبُن",45,"ن",1,0],["وَما فَكَّرتُ قَبلَكَ في مُحالٍ","وَلا جَرَّبتُ سَيفي في هَباءِ",46,"ا",2,0],["وَما في سَطوَةِ الأَربابِ عَيبٌ","وَلا في ذِلَّةِ العُبدانِ عارُ",47,"ر",1,0],["وَما في طِبِّهِ أَنّي جَوادٌ","أَضَرَّ بِجِسمِهِ طولُ الجِمامِ",48,"م",1,0],["وما فاتهمْ في أولِ الدهرِ عن قِلىً","ولكن رأى الشيءَ المبيَّتَ أدوَما",49,"م",2,0],["وما فارقتُهمْ طوعاً ولكنْ","قضاءٌ ما ملكتُ لهُ اختياري",50,"ر",2,0],["وما فُضِّلَ الإبريزُ إلّا لأَنّهُ","صبورٌ إِذا ما مَسَّهُ وهجُ الجمرِ",51,"ر",1,0],["وَما في السِتارَةِ مِن حاجِزٍ","إِذا قَرَعَت رُكبَةٌ رُكبَه",52,"ب",2,0],["وَما فيكَ لِلرَكبِ المُرَجّينَ مُرغَبٌ","فَتُلقى وَلَكِنَّ الرَكائِبَ كَلَّتِ",53,"ت",1,0],["وَما فُقِدَ الجَميلُ لِقُربِ عَهدٍ","فَنَسأَلَ عَنهُ بَل نُسِيَ الجَميلُ",54,"ل",1,0],["وَما فَدَحَتنا نَكبَةٌ كَاِفتِقادِنا","أَبا الفَضلِ نَجلَ الأَكرَمينَ الأَفاضِلِ",55,"ل",1,0],["وَما في سُؤالِ الدارِ إِدراكُ حاجَةٍ","إِذا اِستَعجَمَت آياتُها أَن تَكَلَّما",56,"م",2,0],["وَما فَرِقتُ وَقَد كانَت مَحاضِرُنا","مِنها قَريباً حِذاري وِردَها هَجَرُ",57,"ر",1,0],["وَما فَرِحتُ بِبُرءٍ مِن ضَنى مَرَضٍ","كَفَرحَةٍ يَومَ قالوا أَخبَرَ الخَبَرا",58,"ر",2,0],["وَما فارَقتُها شِبَعاً وَلَكِن","رَأَيتُ الدَهرَ يَأخُذُ ما يُعارُ",59,"ر",1,0],["وَما فَرَّ مِن جَيشٍ أَميرٌ عَلِمتُهُ","فَيُدعى طِوالَ الدَهرِ إِلّا مِنافِقا",60,"ق",2,0],["وَما في الناسِ مِن أَحَدٍ يُساوي","زُرارَةُ أَو يَنالُ بَني عِقالِ",61,"ل",1,0],["وَما فيهِما إِلّا سَيُصبِحُ جارُهُ","تَطَلَّعُ في جَوِّ السَماءِ سَلالِمُه",62,"ه",1,0],["وَما فازَ أَهلُ الفَضلِ إِلّا بِصَبرِهِم","عَنِ الشَهَواتِ وَاحتِمالِ المَكارِهِ",63,"ه",1,0],["وَما فيهِ مِن عَيبٍ عَليَّ وَإِنَّما","عَليكَ بِهَذا لا عَليَّ يُعابُ",64,"ب",1,0],["وما فَرحي يْومَ المَسَرّةِ طائعاً","ولا حَزَني يْومَ المساءَةِ عاصيا",65,"ي",2,0],["وما فضلُ الطلول على شَمُولٍ","تمجّ المسك في نَفَس النسيمِ",66,"م",1,0],["وما فَقدت إلّا عَظيماً وفَقدُهُ","به بين أحشاءِ العلى يُوجَدُ الوَجدُ",67,"د",1,0],["وَما فَضلُ العِتاقِ إِذا أَلَظَّت","بِها وَتَأَثَّلَت فيها العُيوبُ",68,"ب",1,0],["وَما في الأَرضِ أَعصى لِاِمتِناعٍ","يَسوقُ الذَمَّ مِن جودٍ مُطاعِ",69,"ع",1,0],["وما فضلُ مولانا ببدْعٍ فكمْ لهُ","مآثرِ إحسانٍ جليٍّ وضوحُها",70,"ح",3,0],["وما في البريةِ مِنْ رافضٍ","لفضلي إلا لَهُ مصرعُ",71,"ع",1,0],["وما في سطوةِ الخلاّقِ عيبٌ","ولا في ذلّةِ المخلوقِ عارُ",72,"ر",1,0],["وما فَضْلُ الشُّعوبِ إذا أضاعتْ","أواخرُها تُراثَ الأوّلينا",73,"ن",2,0],["وما في الأرضِ أعدلُ من حُسامٍ","إذا جَمحَ الهوى بالحاكمينا",73,"ن",2,0],["وَما في الأَرضِ أَسعَدُ مِن وَفِيٍّ","أَمينِ العَهدِ مَأمونِ الجِنايَهْ",74,"ا",3,0],["وَما فَضَلوكُم غَيرَ أَنَّ أَباكُمُ","أَطالَ فَأَكدى ثُمَّ قالَ فَأَنكَدا",75,"د",2,1],["وَمَا فيهِمُ لا بارَكَ اللَّهُ فيهمُ","أَخُو قَلَمٍ إِلَّا يَخُونُ ويَغْدِرُ",76,"ر",1,0],["وما فِرْعَوْنُ فيها غَيْرَ مُوسَى","يَسُومُ المُسْلِمينَ أَذَىً وهُونا",77,"ن",2,0],["وَما فَوقَ ظَهرِ الأَرضِ أَنعَمُ عيشَةً","وَأَعرَضُ دُنيا مِن مُحِبٍّ إِذا اقتَدَر",78,"ر",1,0],["وَما في هَلاكِ اِبنِ الخُلَيقِ لِرَهطِهِ","فَسادٌ وَلَكِن في البَقاءِ فَسادُ",79,"د",1,0],["وَما في سُهَيلٍ طائِلٌ غَيرَ أَنَّهُ","إِذا نيكَ أَعطى غَيرَ كِزٍّ وَلا جَحِد",80,"د",1,0],["وَما فارَقتُ مِن سَرَفٍ وَلَكِن","طَغى طَرَبي وَمالَ بِيَ الفَتاءُ",81,"ا",2,0],["وَما في يَدٍ قُلُبٌ وَلا أَسؤُقٍ بُراً","وَلا مَفرَقٍ تاجٌ وَلا أُذُنٍ رَعَث",82,"ث",1,0],["وَما فَتِئَت وُلاةُ الأَمرِ فيها","على الصَفراءِ تُصرِفُ أَو تَشِجُّ",83,"ج",1,0],["وَما فَقِهتُ المَرادَ مِنها","كُلُّ فَقيهٍ لَهُ مُعيدُ",84,"د",1,0],["وَما فِعلَتُهُ عُبّادُ النَصارى","وَلا شَرعِيَّةٌ صَبَأوا وَهادوا",85,"د",3,0],["وَما فَوقَ هَذي الأَرضِ إِلّا مُؤَهَّلٌ","لِهَمٍّ فَقارِب في الظُنونِ وَباعِدِ",86,"د",1,0],["وَما فَسَدَت أَخلاقُنا بِاِختِيارِنا","وَلَكِن بِأَمرٍ سَبَّبَتهُ المَقادِرُ",87,"ر",1,0],["وَما فيكُم عَلى الإِحسانِ جازٍ","وَلا مِنكُم عَلى النُعمى شَكورُ",88,"ر",1,0],["وَما فَتِئَت نيرانُ فارِسَ يَعتَلي","بِها العِزُّ حَتّى أَبطَلَتها الأَحامِسُ",89,"س",1,0],["وَما في الأَرضِ مِن شِربٍ كَريمٍ","يُسَرُّ بِوَردِهِ الصادي العَيوفُ",90,"ف",1,0],["وَما فَتِئَت رُسُلُ الحِمامِ تَزورُنا","إِذا لَم تُشافِه ذَكَّرَتنا أَلوكُها",91,"ك",3,0],["وَما فَتِئتُ وَأَيّامي تُجَدَّدُ لي","حَتّى مَلَلتُ وَلَم يَظهَر بِها مَلَلُ",92,"ل",1,0],["وَما في الأَرضِ مِن أَحَدٍ غَنِيٍّ","وَلَكِن كُلُّنا فُقَراءُ عالَه",93,"ل",2,0],["وَما فَتِأَت روحُ الفَتى في نَوائِبٍ","تُمارِسُها حَتّى اِستَقَلَّت عَنِ الجِسمِ",94,"م",1,0],["وَما في الناسِ أَجهَلُ مِن غَبِيٍّ","يَدومَ لَهُ إِلى الدُنيا رُكونُ",95,"ن",1,0],["وَما فَتِئَت تَرمي الفَتى عَن قُسِيَّها","بِكُلِّ الرَزايا مِن جَميعِ الأَماكِنِ",96,"ن",1,0],["وَما فَتِئَ الفَتَيانِ الحَياةَ","يَروحانِ بِالشَرِّ أَو يَغدُوانِ",97,"ن",1,0],["وَما فَتَلاهُ عَن سَجاياهُ بَعدَما","أَجادَ كِتاباً مُحكَماً فَتَلاهُ",98,"ل",3,0],["وَما فَعَلوا وَلَكِن باكَروهُ","بِأَسبابِ الحِمامِ فَقَضَّبوهُ",99,"ب",3,0],["وَما في نَشرِ هَذا الخَلقِ نُعمى","فَهَل يُلحى الزَمانُ إِذا طَواهُ",100,"و",3,0],["وما فَقَدَ الحُسَينَ ولا عَلِيّاً","وَلِيُّ هُدىً رآكَ له نَصيحا",101,"ح",2,0],["وما فتئت تأتي الطبيعة فعلها","فتنشأ أكوان وتخرب أكوان",102,"ن",1,0],["وما في بلاد اللَه كالظلم هادمٍ","ولا مثل حكم العدل بانٍ يشيدها",103,"د",3,0],["وَما فئة الإصلاح إلا كبارق","يغرك بالقطر الَّذي ليس يهطل",104,"ل",1,0],["وما في الجوانح خاف عليك","وقلبك يعلم ما غيبا",105,"ب",2,0],["وما في جبينك يا ابنَ الخيال","سِماتٌ تحدِّث عن غَدرِها",106,"ر",3,0],["وما فنُّهُ ما أراهُ سوى","أداةِ مطامعِه الواسعهْ",107,"ه",1,0],["وما فِيَّ إِلَّا الشِّعْر أَثْبَتَهُ الهَوى","فسارَ به في العالَمِين فَرِيدُ",108,"د",1,0],["وَمَا فِي الدَّهْرِ خَيْرٌ مِنْ حَيَاةٍ","يَكُونُ قِوَامُها رَوْحَ الشَّبَابِ",109,"ب",1,0],["وَمَا فِي النَّسَاءِ الفُضْلَيَاتِ كَزَوْجِهِ","وَلاَ كَبَنِيهِ الغُرِّ فِي صالِحِ النَّسْل",110,"ل",1,0],["وَمَا فِي سَيْفِهِ الْمَاضِي كَلاَلٌ","إِذَا لَمْ يُغْنِ رَأْيٌ عَنْ مَكَرِّ",111,"ر",1,0],["وَمَا فَارَقْتُ عَنْ مَلَلٍ وَهَجْرٍ","وَلَكِنْ شَاءَ رَبُّكِ كُلَّ أَمْرِ",112,"ر",1,0],["وَمَا فِكْرُهُ فِي نَهْضَةِ العَصْرِ جَامِدٌ","وَمَا حِسُّهُ فِي مَوْطِنِ البِرِّ جَامِدُ",113,"د",1,0],["وما فكَّكَ الشَّعبَ مثلُ النزاعِ","إذا هُوَ بينَ بنيه احتَدَمْ",114,"م",1,0],["وما فضل طفلٍ إذا ما استهلّ","تلقتهُ في المهد أيدي الإماء؟",115,"ا",2,0],["وما فتئ الزمان يدور حت","ى مضى بالمجد قوم آخرونا",116,"ن",2,0],["وما فارسٌ الا جنانٌ مُضاعةٌ","ويا رُبَّ خمْرٍ لم تجد من مُصفق",117,"ق",1,0],["وما فَلَّتِ الايامُ مني صرامة","ولا زحزحت علمي بانيَ باسل",118,"ل",1,0],["وما فيك يا عرش الشباب مزية","على الشيب الا السير فيك على عمى",119,"م",2,0],["وما في يدي إلاّ فؤادي أنَرْته","لِيُلْقي على سُودِ الخطوبِ شُعاعا",120,"ع",2,0],["وما فارَقَتْني المُلْهِباتُ وإنَّما","تطامَنْتُ حتّى جمرُها غيرُ لاذعي",121,"ع",2,0],["وما فيك عضو ولا مفصل","فتقطع أوصلك الأنصل",122,"ل",1,0],["وما في يدٍ قُلبٌ، ولا أسؤقٍ بُرىً،","ولا مَفرَقٍ تاجٌ، ولا أُذُنٍ رَعث",123,"ث",1,0],["وما فيك لي بَلَلٌ من صَدى","فما بيدٍ عن يدٍ من غنى",124,"ا",1,0],["وما فتنتْ بعد ابن عمران قومهُ","بما عبدوا إلا ليهلكَ عابد",125,"د",1,0]]}