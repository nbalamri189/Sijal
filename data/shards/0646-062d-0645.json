{"poems":[[55,"أوما رأيت وقائع الدهر","https://www.aldiwan.net/poem30444.html","الكامل"],[29,"إني امرؤ يبني لي المجد البان","https://www.aldiwan.net/poem4434.html","الرجز"],[29,"لولا الحياء لعادني استعبار","https://www.aldiwan.net/poem5740.html","الكامل"],[29,"حي الهدملة من ذات المواعيس","https://www.aldiwan.net/poem5787.html","البسيط"],[53,"يا ناعي ابن رسول الله في البشر","https://www.aldiwan.net/poem64080.html","البسيط"],[53,"نحمد الله حين من وأبقى","https://www.aldiwan.net/poem65511.html","الخفيف"],[87,"سعي الفتى في عيشه عباده","https://www.aldiwan.net/poem8014.html","الرجز"],[63,"لنا غرفة حسنت منظرا","https://www.aldiwan.net/poem51645.html","المتقارب"],[107,"أعلى المآتم تخفق الأعلام","https://www.aldiwan.net/poem42080.html","الكامل"],[107,"اشهدي يا مصر أعمال البنين","https://www.aldiwan.net/poem43070.html","الرمل"],[107,"مضت السيوف وولت الأرباب","https://www.aldiwan.net/poem44194.html","الكامل"],[15,"يا ذا المخوفنا بقت","https://www.aldiwan.net/poem45242.html","مجزوء الكامل"],[15,"حلت كبيشة بطن ذات رؤام","https://www.aldiwan.net/poem45247.html","الكامل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125573","الرمل"],[119,"صباح خير توسلنا لبارينا","https://www.aldiwan.net/poem42168.html","البسيط"],[133,"يا رفيقي على طريق الحزاني","https://www.aldiwan.net/poem67450.html","الخفيف"],[173,"بعض الذي نالنا يا دهر يكفينا","https://www.aldiwan.net/poem1686.html",""],[203,"في الشفاه اللعس ما يشفي الألم","https://www.aldiwan.net/poem45345.html","الرمل"],[240,"حث كؤوس الراح","https://www.aldiwan.net/poem32118.html","مجزوء الرجز"],[264,"نحمد مولانا الذي قد اصطفى","https://www.aldiwan.net/poem35821.html","الرجز"],[309,"يا رب يا عالم الحال","https://www.aldiwan.net/poem16759.html","المجتث"],[309,"يا رحمة الله زوري","https://www.aldiwan.net/poem16858.html","المجتث"],[309,"حي حياليا الوصل في وادي الغيد","https://www.aldiwan.net/poem16898.html","عموديه"],[348,"أبلغ مهلهل عن بكر مغلغلة","https://www.aldiwan.net/poem24182.html","البسيط"],[463,"إذا لم يقرب منك إلا التذلل","https://www.aldiwan.net/poem56075.html","الوافر"],[466,"جعلت من الحدثان أحصن أدرع","https://www.aldiwan.net/poem15148.html","الكامل"],[612,"","https://poetry.dctabudhabi.ae/diwan/poem/82793","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62541","الرمل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126124","الرجز"],[1240,"","https://poetry.dctabudhabi.ae/diwan/poem/198736","البسيط"],[1378,"","https://poetry.dctabudhabi.ae/diwan/poem/216837",""],[1586,"","https://poetry.dctabudhabi.ae/diwan/poem/96345","المتقارب"],[2045,"","https://poetry.dctabudhabi.ae/diwan/poem/104814","الخفيف"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199821","المسحوب"],[2202,"","https://poetry.dctabudhabi.ae/diwan/poem/199630","المسحوب"],[2436,"","https://poetry.dctabudhabi.ae/diwan/poem/17736","الكامل"],[2510,"","https://poetry.dctabudhabi.ae/diwan/poem/111285","الرجز"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74157","الرجز"],[3052,"","https://poetry.dctabudhabi.ae/diwan/poem/133966","الرجز"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132679","السريع"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126281","الخفيف"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87580","الخفيف"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112672","الرجز"],[3419,"","https://poetry.dctabudhabi.ae/diwan/poem/130745","الرجز"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108369",""],[3793,"","https://poetry.dctabudhabi.ae/diwan/poem/124786","الرجز"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136926",""],[4257,"","https://poetry.dctabudhabi.ae/diwan/poem/117143","الرجز"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133185","الرمل"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133162","البسيط"],[4679,"مرحباً بالكرام أهل الحمَّية","https://www.poetsgate.com/ViewPoem.aspx?id=142757",""],[4927,"ضِيم الكرام","https://www.poetsgate.com/ViewPoem.aspx?id=80798",""],[4994,"سفر في تفاصيل الجرح","https://www.poetsgate.com/ViewPoem.aspx?id=209153",""],[5131,"نحْنُ هنا إِنْ يحنِ الموعدُ","https://www.poetsgate.com/ViewPoem.aspx?id=58246",""],[5307,"دنيا محلا وطرها","https://www.poetsgate.com/ViewPoem.aspx?id=10547",""],[5324,"رأس مال المفلسين.","https://www.poetsgate.com/ViewPoem.aspx?id=211508",""],[5410,"والتقينا","https://www.poetsgate.com/ViewPoem.aspx?id=152249",""],[5664,"سلامات","https://www.poetsgate.com/ViewPoem.aspx?id=176698",""],[5672,"البعد بالأحباب أودى...","https://www.poetsgate.com/ViewPoem.aspx?id=206517",""],[5866,"نحمد الله","https://www.poetsgate.com/ViewPoem.aspx?id=182813",""],[5866,"قال من لا يعجزه نظم الحروف الابجدية","https://www.poetsgate.com/ViewPoem.aspx?id=182872",""],[5952,"عاشوا","https://www.poetsgate.com/ViewPoem.aspx?id=211568",""],[5956,"يا إله الناس أسْعِدْ كل أنثى","https://www.poetsgate.com/ViewPoem.aspx?id=181922",""],[5978,"رسالة إلى المتنبي","https://www.poetsgate.com/ViewPoem.aspx?id=191364",""],[6008,"الواسطه ..!","https://www.poetsgate.com/ViewPoem.aspx?id=60803",""],[6045,"شباب الحلوة","https://www.poetsgate.com/ViewPoem.aspx?id=123996",""],[6093,"شيطان صعدة","https://www.poetsgate.com/ViewPoem.aspx?id=198391",""],[6153,"غنى الذي من واهج الضيم والنيا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577067",""]],"verses":[["نَحمي المَطاعِمِ لِلبَقاءِ وَذي","الآجالُ مِلءُ فُروجِها تَجري",0,"ر",2,0],["نَحمي ذِمارَ جَدَفٍ بِمَرّان","نَحنُ اِستَلَبنا الجَونَ وَاِبنِ حَسّان",1,"ن",1,0],["نَحمي مُخاطَرَةً عَلى أَحسابِنا","كَرُمَ الحُماةُ وَعَزَّتِ الأَخطارُ",2,"ر",1,0],["نَحمي وَنَغتَصِبُ الجَبّارَ نَجنُبُهُ","في مُحصَدٍ مِن حِبالِ القِدِّ مَخموسِ",3,"س",1,0],["نحمي حمانا بأسيافٍ مجردةٍ","مَقِيلُها قُلَّةُ المستأسد الأشر",4,"ر",1,0],["نحمد الله حين منَّ وأبقى","بعدما كاد كوكب الأرض يرقى",5,"ق",2,1],["نَحمِلُ ما يَصبِرُ الجِمالُ","عَن بَعضِهِ لَو أَنَّها نِمالُ",6,"ل",1,0],["نحمله سبيحاً أسوداً","فيَجعلُه ذَهَباً أحمَرا",7,"ر",2,0],["نَحمِي حِمَى اسْتقلالِها وَنَصونُها","حتّى تَدينَ لِعزِّها الأقوامُ",8,"م",1,0],["نَحمِلُ الأَقلامَ غُرّاً وَلَنا","صُحُفُ الأَبرارِ بَينَ الكاتِبينْ",9,"ن",1,0],["نَحمِي مَدِينَتَنَا ونَمنعُ نخلَها","مِن أن يَحُومَ على جَنَاهُ ذُبَابُ",10,"ب",1,0],["نَحمي حَقيقَتَنا وَبَع","ضُ القَومِ يَسقُطُ بَينَ بَينا",11,"ن",2,0],["نَحمي حَقيقَتَنا وَنَمنَعُ جارَنا","وَنَلُفُّ بَينَ أَرامِلِ الأَيتامِ",12,"م",1,0],["نَحمَدُ الله على أنَّا بها","لم نَصُن من ذِلَّةٍ إلا الجباه",13,"ه",1,0],["نحمي به من ملمات الزمان ومن","كل المصائب فيه اللَه ينجينا",14,"ن",2,0],["نَحمِلُ الحُزنَ شِعاراً","لشَقاء واحتِمالِ",15,"ل",1,0],["نَحمي عَلى الجارِ وَالمَولى وَيَأمَنُنا","عَلى اِختِلافِ اللَيالي مَن يُصافِينا",16,"ن",2,0],["نَحمي وَنَضرِبُ رَبَّ التاجِ دُونَهُمُ","ضَرباً يُطيرُ فِراخُ الهامِ سِجّينا",16,"ن",2,0],["نحمدُ اللهَ فإنَّ الشمسَ لو","فعلتْ فعلكَ عشنا في ظُلَمْ",17,"م",1,0],["نَحمَدُهُ في حالَتَي","هِ الجِدِّ وَالمِزاحِ",18,"ح",1,0],["نحمد مولانا الّذي قد اصطفى","من خلقه قوماً لحان الاصطِفا",19,"ف",2,1],["نحمده سراً وجهراً","وبالغدو والآصال",20,"ل",1,0],["نحمده نشكره نثني","عليه طول الدهور",21,"ر",1,0],["نحمده نشكره من غير حصر وتعديد","ثم صلوا على الهادي محمد بترديد",22,"د",1,0],["نَحمي الذِمارَ وَنَحمي كُلَّ أَرمَلَةٍ","حَقّاً وَنَدفَعُ عَنها مَن يُعاديها",23,"ي",3,0],["نحمِّسُ من آثاركم وعلاكُمُ","وننسبُ من أحلامكم ونُغزِّلُ",24,"ل",1,0],["نحمتْ فلما ألجِمَتْ حوت العلى","واليأسُ للمحظوظِ أكرم مطمعِ",25,"ع",1,0],["نَحمد الشَمس يَوم تَطلَع فيها","بِضِياء وَنَحمد اللَه عَشرا",26,"ر",2,0],["نحمد الله على نيل المراد","وعلى ما خصّنا دون العبادْ",27,"د",1,1],["نحمده سبحانه ونشكره","نعبده تذللاً ونذكره",28,"ه",1,0],["نحمده بالجملة الاسمية","وثانيا بالجملة الفعلية",28,"ه",1,0],["نحمده حمداً كثيراً يرضي","ملء السموات وملء الأرض",28,"ض",1,0],["نحمده حمداً كثيرا طيبا","مباركاً فيه ورزقاً صيِّبا",28,"ب",2,0],["نحمد حمداً يوافي نعمه","بدرع شكره نرد نقمه",28,"ه",1,0],["نحمده حمداً يدوم أبدا","ما نفس من داخل الفم بدا",28,"د",2,0],["نَحْمي الجِوَارَ وَنَحْمِيْ كُلَّ أُمَّتِنَا","بَنُو الإِمَارَاتِ مَنْ رَاعَى نُرَاعيْهِ",29,"ي",2,0],["نحْمِد إلهٍ عَنْ فَضلْهُمْ غِنانا","أغْلاظْ الاوْجِهْ لي تْروغكْ مِنْ بْعيد",30,"د",1,0],["نحمل على الثغر عند الحروب","فننكى العدو ونحوي الغنم",31,"م",1,0],["نَحمَدُ اللهَ حَمدض مَن","نالَ بالحَمدِ لِلمُرَاد",32,"د",1,0],["نحمد الله ثم نثني بالشكر","ما نحاتي شيّ في الدّنيا اقصور",33,"ر",1,0],["نحمد الله لي وهبنا ما وهب","نيتغي دينه وجنبنا الجحود",34,"د",1,0],["نَحمي حَقيقَتَنا وَيُدرِكُ حَقَّنا","إِذا اِجتَمَعَ الجَماجِمُ مِجهَرُ",35,"ر",1,0],["نحمدك اللهم يا من شرعا","دينا به النبي طه صدعا",36,"ع",2,1],["نحمدك اللَهم يا ذا المَن","وَلا نَقول قَول أَهل المن",37,"ن",1,1],["نحمدك اللهم حمداً دائماً","يا مانح الخير لمن تعلما",38,"م",2,1],["نحمل ثقل الخطب ما لم يكن","ضيماً فحمل الضيم ما لا يطاق",39,"ق",1,0],["نحمد الله مذ اتيت الينا","قد امنا فلا نخاف الهلا كا",40,"ك",2,0],["نَحمد اللَه لِلَّذي قد حَبانا","وَنرجيِّه انهُ خير واهب",41,"ب",1,0],["نحمَدُه على عظيمِ الأمرِ","وما جَرى من فاجعاتِ الدهرِ",42,"ر",1,0],["نحمده جل على الإنعام","بنعمة الإيمان والإسلام",43,"م",1,0],["نحمى عن الاحشاء نيران الهوى","والخد يحمي قطف ودر جنانهِ",44,"ن",2,0],["نحمده حمداً يوافي نِعَمَهُ","ونستزيد جوده وكربته",45,"ه",1,0],["نحمي حمى الأرزِ لا الابطال ترهبنا","ولا نهاب عديداً من اعادينا",46,"ن",2,0],["نحمده حمداً كثيراً نشكره","نتوب من زلاتنا نستغفره",47,"ه",1,0],["نحمد الله تعالى ربنا","ما علينا الدهر من شخصٍ يسود",48,"د",1,0],["نحمدك يا رب يا رحمن يا مرتجى","حمداً يقوم يوافي نعمتك كلها",49,"ه",2,0],["نحمدك يا رب كم أسديت من نعمةٍ","وحاصل القول لا تحصى لمن عدها",49,"ه",2,0],["نحمد الله أننا في زمانٍ","فيه ضاءت أشعة المدنية",50,"ي",2,0],["نَحْمِيْ بِلاْدَ الشَّاْمِ مِنْ طَاْغٍ طَغَىْ","وَأَرَاْدَ ذُلَّ الشَّعْبِ كَيْفَ يَشَاْءُ",51,"ا",2,0],["نحمِّلُ الحظَّ وِزراً في هَزائمِنا","نَشكو المَصيرَ ونَمضي في خَطايانا",52,"ن",2,0],["نحمي حمانا بفعال الألى","سادوا فما جاروا ولا استعْبدوا",53,"د",3,0],["نحمد لذي صورها","وو هب لها الاخيار",54,"ر",1,0],["نحمد الله على العشق كثيرا","إنّ خير المالِ مالُ العاشقين",55,"ن",1,0],["نحمل الصبر في حنايا ضلوعٍ","أسكرتها حلاوة الإشفاق ِ",56,"ق",1,0],["نحمد الله على كل حال وانت الحال والخلان","ويكفي قبل كل هذي العيون قلوب تصعد لك",57,"ك",1,0],["نح مثل نوح حمامة","او نوح نوق حين تحدى",58,"د",2,0],["نحمد الله يوم ربي حفظ كل الحجيج","ادوأ الحجّة وهم في رحّاب المملكة",59,"ك",2,1],["نحمد الله عايشين ابخير والعيشة هنية","فرق ما بين السنين الراهنة والماضياتي",60,"ت",2,0],["نحمل المشكاة والزيت لهم","يحملون النار والموت الزؤاما",61,"م",2,0],["نَحْمَدُ الله على كل زواجٍ","ناجحٍ فيه وِقاءٌ منْ فَسادِ",62,"د",1,0],["نُحْ ما بصدركَ أفرغْ أنَّة القصبِ","ما الشعرُ إلا ضياءٌ قُدَّ من لهبِ",63,"ب",1,1],["نحمدك يالمعبود يوم اللذي جابه","اللي أفعاله بالشهامه منفلها",64,"ل",3,0],["نحمّله الحبّ نُسجي به","من الزاد من خيره ما نجد",65,"د",1,0],["نحمي ثراه من الغوائل كلما","قرعت طبول الحرب في الأغلاس",66,"س",1,0],["نحمل مغايظهم وَلا اِحنا بحالهم","لَو جردوها من حلب لمعان",67,"ن",1,0]]}