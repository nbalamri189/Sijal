{"poems":[[55,"أين الغزال الماطل","https://www.aldiwan.net/poem29906.html","مجزوء الرجز"],[90,"من مبسم الغازي إلى الفاروق","https://www.aldiwan.net/poem44800.html","الكامل"],[90,"خاض الدجى وظلام الليل مختلط","https://www.aldiwan.net/poem44831.html","البسيط"],[66,"فيك معنى يدعو النفوس إليكا","https://www.aldiwan.net/poem67588.html","الخفيف"],[53,"عنفت شيخي أذان في مواثبة","https://www.aldiwan.net/poem65949.html","البسيط"],[93,"جئت لا أعلم من أين ولكني أتيت","https://www.aldiwan.net/poem8766.html","عموديه"],[93,"الأربعون لو انها تتكلم","https://www.aldiwan.net/poem62688.html","عموديه"],[94,"أنت يا شعر فلذة من فؤادي","https://www.aldiwan.net/poem38953.html","الخفيف"],[94,"عذبة أنت كالطفولة كالأح","https://www.aldiwan.net/poem38954.html","الخفيف"],[45,"مالنا كلنا جو يا رسول","https://www.aldiwan.net/poem9980.html","الخفيف"],[68,"خذ من الدهر لي نصيب","https://www.aldiwan.net/poem41371.html","مجزوء الخفيف"],[99,"بأي لفظ يفيك شعري","https://www.aldiwan.net/poem24969.html","مجزوء البسيط"],[46,"ما عهدنا كذا نحيب المشوق","https://www.aldiwan.net/poem30395.html","الخفيف"],[70,"ته دلالا فأنت أهل لذاكا","https://www.aldiwan.net/poem1517.html",""],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16622","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55145","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54210","الخفيف"],[108,"زيارة طرابلس","https://www.poetsgate.com/ViewPoem.aspx?id=179604",""],[147,"عاذ بالصفح من أَحب البقاء","https://www.aldiwan.net/poem11716.html","الخفيف"],[189,"يا دار دارت بك السعود","https://www.aldiwan.net/poem14512.html","مخلع البسيط"],[228,"ذلك الطير لم عراه ذهول","https://www.aldiwan.net/poem39724.html","الخفيف"],[234,"أصبح الملك من أبي المنصور","https://www.aldiwan.net/poem51113.html","الخفيف"],[284,"برزت للناس في قميص","https://www.aldiwan.net/poem2645.html","مخلع البسيط"],[333,"فيك معنى من المعاني بعيد","https://www.aldiwan.net/poem54991.html","الخفيف"],[347,"صرفند معقل الاحرار ما","https://www.aldiwan.net/poem55320.html","الرمل"],[369,"أقول يا أهل تبريز لكلكم","https://www.aldiwan.net/poem60936.html","البسيط"],[382,"دهرنا قد تزندقا","https://www.aldiwan.net/poem59319.html","مجزوء الخفيف"],[406,"برقية شعرية إلى الصحافة العربية","https://www.aldiwan.net/poem10295.html","عموديه"],[422,"زادك الله بهجة ووقارا","https://www.aldiwan.net/poem53883.html","الخفيف"],[438,"حمد السرى من كنت وجه صباحه","https://www.aldiwan.net/poem12584.html","الكامل"],[443,"لك في المجد أول وأخير","https://www.aldiwan.net/poem2590.html","الخفيف"],[466,"يا آل جعفر الفياض جودكم","https://www.aldiwan.net/poem16418.html","البسيط"],[505,"أيها الفجر النسيمات شذت","https://www.aldiwan.net/poem38044.html","الرمل"],[542,"إن يكن ولى الأمير فقد","https://www.aldiwan.net/poem69397.html","المديد"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126677","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122558","الخفيف"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122549","الرمل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48565","الرمل"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25346","الرجز"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95586","الخفيف"],[1840,"","https://poetry.dctabudhabi.ae/diwan/poem/216656",""],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102133","المنسرح"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67256","الرمل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93634","الخفيف"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102513","الكامل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205793","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201839","الخفيف"],[3101,"","https://poetry.dctabudhabi.ae/diwan/poem/107063","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89115","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89221","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110134","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91227","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205560","الرمل"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117848","الخفيف"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85132","الخفيف"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133306","الوافر"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29274","الخفيف"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40060","المنسرح"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136927",""],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73272","الخفيف"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146753","الخفيف"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57991","السريع"],[4679,"ما درت مثل عيدك الأعيادُ","https://www.poetsgate.com/ViewPoem.aspx?id=142749",""],[4726,"ام ذي عقود في سموط بلاغة","https://www.poetsgate.com/ViewPoem.aspx?id=146657",""],[4728,"يا صغيّر وحقك تشرب الشاي مرّ","https://www.poetsgate.com/ViewPoem.aspx?id=176971",""],[4856,"أشجان","https://www.poetsgate.com/ViewPoem.aspx?id=36271",""],[4908,"عقلي متيم","https://www.poetsgate.com/ViewPoem.aspx?id=209097",""],[4980,"حديث الطيف","https://www.poetsgate.com/ViewPoem.aspx?id=196794",""],[5194,"ما يسوى غلاك","https://www.poetsgate.com/ViewPoem.aspx?id=32207",""],[5277,"سيدي العراق","https://www.poetsgate.com/ViewPoem.aspx?id=201721",""],[5302,"أيها الحلو","https://www.poetsgate.com/ViewPoem.aspx?id=200602",""],[5431,"ليس إلاه راحما قمْ تقرّبْ","https://www.poetsgate.com/ViewPoem.aspx?id=199933",""],[5433,"جابك الله","https://www.poetsgate.com/ViewPoem.aspx?id=36260",""],[5689,"حطمت لي يد القضا كل فلس","https://www.poetsgate.com/ViewPoem.aspx?id=143434",""],[5694,"البيعة","https://www.poetsgate.com/ViewPoem.aspx?id=129888",""],[6056,"بركان المشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=130135",""],[6124,"منك كلي","https://www.poetsgate.com/ViewPoem.aspx?id=128747",""],[6124,"فيكِ مالت","https://www.poetsgate.com/ViewPoem.aspx?id=174833",""],[6124,"الفارس الذي لا يأتي","https://www.poetsgate.com/ViewPoem.aspx?id=201237",""],[5724,"راية المصطفى اخفقى في السماء","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55158&r=&rc=25",""],[6260,"يا غزالا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=68359&r=&rc=51",""]],"verses":[["فيكُم يَنابيعُ النَدى","وَالدُلَّحُ الهَوامِلُ",0,"ل",1,0],["فيكم جهابذة العلوم بحورها","من كل نطس في الفنون عريق",1,"ق",1,0],["فيكم غُلُوّ وتقصير وبينهما","ضاع المراد أنتم أمة وَسَط",2,"ط",1,0],["فيكَ مَعنى يَدعو النُفوسَ إِلَيكا","وَدَليلٌ يَدُلُّ مِنكَ عَلَيكا",3,"ك",2,1],["فيكم من الشرّ ما يزري بخيركُمُ","فأين تذهبُ عنه أَيُّها الثَّمِلُ",4,"ل",1,0],["فيكَ مِثلي أَيُّها الجَبّارُ أَصداف وَرَملُ","إِنَّما أَنتَ بِلا ظِل وَلي في الأَرضِ ظِلُّ",5,"ل",1,0],["فيكُم جَميعُ صِفاتِها وَخِلالِها","وَالرَوضُ يَحويهِ عُطوراً قَمقَمُ",6,"م",1,0],["فيكَ مَا في جوانحي مِنْ حنينٍ","أبديٍّ إلى صميمِ الوُجُودِ",7,"د",1,0],["فيكَ مَا في خواطري مِنْ بكاءٍ","فيكَ مَا في عواطفي مِنْ نشيدِ",7,"د",1,0],["فيكَ مَا في مَشَاعري مِنْ وُجُومٍ","لا يُغَنِّي ومِنْ سُرورٍ عَهيدِ",7,"د",1,0],["فيكَ مَا في عَوَالمي مِنْ ظلامٍ","سَرْمديٍّ ومِنْ صباحٍ وَليدِ",7,"د",1,0],["فيكَ مَا في عَوَالمي مِنْ ضبابٍ","وسرابٍ ويقظةٍ وهُجُودِ",7,"د",1,0],["فيكَ مَا في طفولتي مِنْ سلامٍ","وابتسامٍ وغبطةٍ وسُعودِ",7,"د",1,0],["فيكَ مَا في شبيبتي مِنْ حنينٍ","وشجونٍ وبَهْجةٍ وجُمودِ",7,"د",1,0],["فيكَ مَا في الوُجُودِ مِنْ حَلَكٍ دا","جٍ وما فيه مِنْ ضياءٍ بعيدِ",7,"د",1,0],["فيكَ مَا في الوُجُودِ مِنْ نَغَمٍ","حُلْوٍ وما فيه من ضجيجٍ شَديدِ",7,"د",1,0],["فيكَ مَا في الوُجُودِ مِنْ جَبَلٍ وَعْ","رٍ وما فيه مِنْ حَضيضٍ وهِيدِ",7,"د",1,0],["فيكَ مَا في الوُجُودِ مِنْ حَسَكٍ يُدْ","مِي وما فيه مِنْ غَضيضِ الوُرودِ",7,"د",1,0],["فيكَ مَا في الوُجُودِ حَبَّ بنو الأَر","ضِ قصيدي أَمْ لَمْ يُحبُّوا قَصيدي",7,"د",2,0],["فيكِ مَا فيهِ من غموضٍ وعُمْقٍ","وجَمَالٍ مقَدَّسٍ معبودِ",8,"د",1,0],["فيكِ مَرعى جِيادِنا وَالمَطايا","وَإِلَيها وَجيفُنا وَالذَميلُ",9,"ل",1,0],["فيكُم لَفظُها يَطيب","لا بِمَعنى بِها ظَهَر",10,"ر",1,0],["فيك من البحر كل معنى","فمن سمو إلى وقار",11,"ر",1,0],["في كُماةٍ يُكسَونَ نَسجَ السَلوقِيِّ","وَتَغدو بِهِم كِلابُ سَلوقِ",12,"ق",1,0],["فيكَ معنىً حَلاّكَ في عينِ عقلي","وبه ناظري مُعَنّى حِلاكا",13,"ك",2,0],["فيكمْ غَداتَئِذٍ جَوادٌ صامِتٌ","في الحَيّ أثْمَنُ من جَوادٍ صاهِلِ",14,"ل",1,0],["فِيكِ مَعْنًى مِنَ الكَمَالِ وَفِيهِ","مَا تُحِبِّينَ مِنْ مَعَانِي الكَمَالِ",15,"ل",1,0],["فِيكَ منهُ الْجَبينُ والْخُلُقُ الرَحْبُ","وبُعْدُ المَدَى وفِيكَ إِبَاؤه",16,"ا",3,0],["فيكم من البدو أخلاقٌ مبرَّأَةٌ","من كلِّ ما حوتِ الأَمصارُ من دَنَسِ",17,"س",1,0],["في كُماةٍ تَمشي البَراحَ إِلى المَو","تِ إِذا دَبَّتِ الكُماةُ الضَراءَ",18,"ا",2,0],["فيكِ من الحُسنِ كلُّ معنى","يُقَصِّر عن مثله الوُجود",19,"د",1,0],["فيكَ مِنهُ اِختِلاجَةٌ وَعَلى ري","شِكَ ظِلٌّ مِن مُقلَتَيهِ بَليلُ",20,"ل",1,0],["في كمال المعِزِّ في هيبة القا","ئِم في حسن هيئةِ المنصور",21,"ر",1,0],["فيك من الحُسْنِ كلُّ فنّ","وفيك للنفس كلُّ سُول",22,"ل",1,0],["فيك معنى من المعاني بعيدٌ","عن مرامي العقول والأفكار",23,"ر",1,1],["فيك من كل أبيّ باسل","يدفع الضيم أذا ما امتهنا",24,"ن",2,0],["فيكم جَوادٌ وفيكم مَن يَضِنُّ غِنىً","فدفْنُ مَن شَحَّ منكم في اسْتِ مَن جادا",25,"د",2,0],["فيك مات الهدى سُدىً","فيك عاش الشَقا لِقا",26,"ق",2,0],["فيكم من الأقلام ما لا ينتمي","إلا إليه العنفُ والإرهابُ",27,"ب",1,0],["فيك مولاي سؤْلُه ومناه","وإذا غبتَ كانَ عنك سؤاله",28,"ل",2,0],["فيكم سَرى الإخصابُ في أجدابِه","وبكم سَطا الأفراحُ في أتراحه",29,"ح",2,0],["فيكم رونق الزمان وللنا","س بكم فرحة ومنكم سرور",30,"ر",1,0],["فيكُمْ على قَسْوَةِ الأيَّامِ مَرْحمَةٌ","ومنْكُمُ يُسْتَفادُ الصَّبْرُ والجَلَدُ",31,"د",1,0],["فيكَ معنًى بارعٌ في سرِّهِ","كَلماتٌ رُحْنَ يُلْكِنَّ الفِصاحا",32,"ح",2,0],["فيكُمُ مُستَيقِظٌ فَهِمٌ","قُلقُلانٌ حَيّةٌ ذَكَرُ",33,"ر",1,0],["فيكم لنا السلوان بعد فقيدِكُم","فَخُذوا عن الصبرِ الجميلِ عزاءها",34,"ا",3,0],["فيكَ من ذي الرياستين ومن فت","حِ خلالٌ قُدنَ الكباشَ نِعاجا",35,"ج",2,0],["فيكُمُ مِن غانمٍ شَنشَنةٌ","إنَّ مَعنى الخَمر سِرُّ العشنب",36,"ب",1,0],["فيك ما أنشده من غزلِ","ظنه السامع في ذات دلالْ",37,"ل",1,0],["فِيكُمْ جَلالاتٌ عَنِ الدِقاقِ","عَرَّضْتُ نَفْسِي وَدَنَا انْطِلاقِي",38,"ق",2,0],["فيك مجد مؤثل شف عنه","منك خلق ونزعة غراءُ",39,"ا",2,0],["فيك مَا اسْمَعْ قَوْل وشايٍ وشا","مِنِّكْ قَلْبِيْ دايم بروح الشباب",40,"ب",1,0],["فيكَ مع الغناءِ","فجُد بذي المطالِب",41,"ب",1,0],["فيكَ ما فيك وهل يُدرك ما","فيكَ يا رمل الحمى بالفكر",42,"ر",1,0],["فيكما اليَوم نثلب الجبت وَالطا","غوت وَالجاثليق وَالقسيسا",43,"س",2,0],["فيكم ضني جسمي وسالت أدمعي","وبكم لبست من التوى حلل الضنا",44,"ن",2,0],["فيك معني الحياة من بدرها الضا","حي ومن حُسْنِ روضها الفينان",45,"ن",1,0],["فيك من هضمك الثقيلَ دم ٌ منه","فمن يهضم الثقيلَ ثقيل",46,"ل",1,0],["فيك معنى مفسر ليس يخفى","مثل شمس على الربوع مضيه",47,"ي",2,0],["فيك معنى جليل قدر لطيف","رقة الطبع والذكا والحميه",47,"ي",2,0],["فيكم المجد ظاهرٌ يا بني اِسما","عيل بالمصطفى الأمين الأمير",48,"ر",1,0],["فيكم رونق الإمارة زاهٍ","منكم الكوكب السعيد المنير",48,"ر",1,0],["فيكم رونق الإمارة يزهو","ونفوسٌ تصفو عن الأمراض",49,"ض",1,0],["فيكُمُ عِلَّتانِ ليسَ هما من","اصلِ تِسعٍ بل قد تَفرَّعنَ تِسعا",50,"ع",2,0],["فيكم عِنايتُه منكم هدايتُه","ما ضل غايتَه من نحوكم عكفا",51,"ف",2,0],["فيك من شمس الضحى العين التي","ترسل اللمح مضيئًا في الظلامْ",52,"م",1,1],["فيك من بدر الدجى أحلامه","حين يسري نائمًا بين نيامْ",52,"م",1,0],["فيك من كل ربيع طلعة","تنبت النضرة عامًا بعد عامْ",52,"م",1,0],["فيك من نار الحياتين الهوى","هل حياة الحي إلا من ضرامْ",52,"م",1,0],["فيك من دنياك نقص رائق","ومن الأخرى تباشير التمامْ",52,"م",1,0],["فيك من أرضك حظ وافر","وحظوظ من سماء لا تُرامْ",52,"م",1,0],["فيك من هندسة علوية","ما استدار الخط فيه واستقامْ",52,"م",1,0],["فيك مني ومن الناس ومن","كل موجود وموعود تؤامْ",52,"م",1,0],["فيكم يعذب المديح ويحلو","وبه يسرع القريض انقياده",53,"د",2,0],["فيك ما تشتهي النفوس من الإن","شاد والدوح والوحوه الملاح",54,"ح",1,0],["فيكمد حاسد ويقول قوم","عصا هذا الغلام من العصية",55,"ي",2,0],["فيكَ ماتَت هذي السُنونُ أَيا لَي","لَ وَباقي الأَحقابِ في اِضمِحلالِ",56,"ا",2,0],["فيك مَعَانٍ لو أنّها جُمِعَتْ","في الشمس لَم يَغْشَ نُورَها الظُّلَمُ",57,"م",1,0],["فيك من خمرة الالمب معان","فاملأي أكؤس الهوى واسكرينا",58,"ن",2,0],["فيكَ مَعنىً م