{"poems":[[74,"لغرة الأفق بياض شدخ","https://www.aldiwan.net/poem18533.html","السريع"],[93,"خبروني ماذا رأيتم أأطفالا","https://www.aldiwan.net/poem62818.html","عموديه"],[87,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43831","المديد"],[246,"يا يراعي لولا يد لك عندي","https://www.aldiwan.net/poem45751.html","الخفيف"],[408,"هات عن أهل الحمى ما فعلوا","https://www.aldiwan.net/poem46738.html","الرمل"],[469,"جزت حد المديح قولاً وفعلا","https://www.aldiwan.net/poem3134.html","عموديه"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138330",""],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83278","الكامل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59755","البسيط"],[1167,"","https://poetry.dctabudhabi.ae/diwan/poem/101990","الخفيف"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79423","السريع"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94046","الرجز"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109809","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66375","الرمل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127240","السريع"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72489","الكامل"],[4679,"مرحباً بالكرام أهل الحمَّية","https://www.poetsgate.com/ViewPoem.aspx?id=142757",""],[4689,"عبقري الدهر","https://www.poetsgate.com/ViewPoem.aspx?id=152814",""],[4814,"قبضة السامري","https://www.poetsgate.com/ViewPoem.aspx?id=194785",""],[4578,"رنا جفنه للأسد بالسحر يقنص","https://www.poetsgate.com/ViewPoem.aspx?id=49452",""],[4978,"تشطير بلقيسيات","https://www.poetsgate.com/ViewPoem.aspx?id=177255",""],[5072,"يا صاحب العقل","https://www.poetsgate.com/ViewPoem.aspx?id=53672",""],[5431,"مات الحسين وفاض القلب أحزانا","https://www.poetsgate.com/ViewPoem.aspx?id=191499",""],[5956,"القاضي الظالم","https://www.poetsgate.com/ViewPoem.aspx?id=193647",""]],"verses":[["كم اثر نيران إذا ما رعى","بالثلجِ يجري ماءَه قبل سخ",0,"خ",1,0],["كَم أَثيمٍ في السِجنِ لَو أَدرَكَتهُ","رَحمَةُ اللَهِ كانَ حُرّاً سَرِيّا",1,"ي",2,0],["كَم أَثَرٍ لِجَوهَرٍ نَفيسُهُ","إِلى المُعزِّ ذي المَآثر اِعتَزى",2,"ا",1,0],["كَم أَثارَت صَولَتي مِن كَمينٍ","وَكَم اِبتَزَّت يَدي من كَمِيِّ",3,"ي",1,0],["كم أثارَ اليراعُ خَطباً كَمِيناً","وأماتُ اليراعُ خَطبا مُثَاراً",4,"ر",2,0],["كم أثاروا مِن جوىً في مهجتي","عِندما قَالوا سَلاَ قُلتُ سلوا",5,"ل",3,0],["كم أثارت من قسطلٍ فيرى من","فوق أطلابها تراباً ورملاً",6,"ل",2,0],["كم آثر الحر الرحيل على ثوا","دار تذل ولا تعز ضيوفا",7,"ف",2,0],["كَم اَثبَتَ التاريخُ في صَفَحاتِهِ","أُمَماً غَدا اِنشادُها إِنشاءَها",8,"ا",3,0],["كم أثبتوا قدماً كم جدَّلوا صَنماً","كم شيدوا للمعالي أربعاً دُرُساً",9,"س",2,0],["كم أثارت ما عز فيه التعري","من مصاب بمثله مشفوع",10,"ع",1,0],["كَمْ أثرٍ في الدين أثَّرْتَهُ","يقصِرُ عنهُ أثرُ الصُّبْحِ",11,"ح",1,0],["كم أثر فيها زها رونقه","فاق على الكواكب الدريه",12,"ر",3,0],["كمآثر العلماء يخلد ذكرها","ويزيدها طول المدى وكروره",13,"ر",2,0],["كم أثار الوجد ربع","بكئيب ذاب قلبه",14,"ه",1,0],["كم أثمرت أغصان أقلامه","زهرا له الأحشاء أضحت كمام",15,"م",1,0],["كم أثرت بقرانها تأثيرا","آراء والده نجوم دجنة",16,"ه",1,0],["كم أثار النحاة فيهم حروباً","وبها أزعجوا جميع البريَّةْ",17,"ي",2,0],["كم أثبت الوحي قولاً منه جاء به","موافقاً للذي جاءت به السور",18,"ر",1,0],["كمْ أثقلتْ صرخاتُهمْ عَبرتيْ","فانهالَ حزنُ الكونِ مِنْ ناظريْ",19,"ر",2,0],["كما ثغر بيروت تبسم فرحة","وطرف علاها نحو مرآه أخوص",20,"ص",1,0],["كمْ أثَرْتَ الشوقَ عندي","( منذ طالعت مقالَكْ )",21,"ك",1,0],["كم أثبت َ الموت ُ أن َّ القبر َ موعدُنا","فهل شغلنا بهذا الموت ِطروانا ؟؟؟",22,"ن",2,0],["كم أُثقل القلب من أحقادهم عبثا","كم أترع الدرب أوجاعا وأحزانا",23,"ن",2,0],["كم آثمٍ شهِدَ الحقيقة إنما","كتم الشهادة مثلما هو أبكمُ",24,"م",1,1]]}