{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142061","الخفيف"],[102,"المحكوم عليه","https://www.poetsgate.com/ViewPoem.aspx?id=50352",""],[240,"عد نصحا ملامي العذال","https://www.aldiwan.net/poem31788.html","الخفيف"],[240,"لا وجدتم يا أهل نعمان وجدي","https://www.aldiwan.net/poem32096.html","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48527","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48868","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120088","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62829","الخفيف"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131106",""],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29303","الخفيف"],[4961,"في ظلال ِ الصَّدق ِ تُنْتَخَبُ الجواهر","https://www.poetsgate.com/ViewPoem.aspx?id=58865",""],[5061,"الامير","https://www.poetsgate.com/ViewPoem.aspx?id=147171",""],[5757,"برقيّةٌ إلى المتنبّي","https://www.poetsgate.com/ViewPoem.aspx?id=59801",""],[5956,"يا رباطي في حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=185431",""],[6268,"بعثريني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82933&r=&rc=19",""]],"verses":[["أَنْتَ أَغْرَيْتَ بِظُلْمٍ كُلَّ ذِي","صَوْلَةٍ غَيْرَ مُبَالٍ أَنْ يُعَرَّا",0,"ر",2,0],["أنت أغنيةُ السيوفَ إذا","ثارت لتبني مجدا وتَهدِمَ مجدا",1,"د",2,0],["أنت أغلى أحبتي من زمان","كنت شهما ، وما زال نبيلا",2,"ل",2,0],["أَنتَ أَغنَيتَني وَداوَيتَ بِالمَع","روفِ فَقري وَالفَقرُ داءٌ عِضالُ",3,"ل",1,0],["أَنتَ أَغنَيتَني وَصُنتَ بِمَعرو","فِكَ قَدري عَن كُلِّ خِسٍّ وَوَغدِ",4,"د",1,0],["أنت أغنى عن أن أثيبك فيما","لك عندي من نعمة وحقوق",5,"ق",1,0],["أنت أغنى عن أن تجازى أياد","يك كلاماً وأنت موسى الكليم",6,"م",1,0],["أنت أغليت من صداق القوافي","حين حبرت من مديحك صدقا",7,"ق",2,0],["أنتَ أغنيتَ عن ظُباها وأعدَيْ","تَ عليْها مَجاريَ الأطْواقِ",8,"ق",1,0],["أنت اغتصبت بحسن وجهك قلبه","فشكا اليّ لأنني كابيه",9,"ي",2,0],["أَنتِ أَغوَيتِني بِأَن أَلقاكِ","خَلفَ سورِ الحَياةِ فَوقَ رُباكِ",10,"ك",1,0],["أنتِ أغلى مِنَ المشارق ِ قدْراً","وعلى قدْرِكِ المشارقُ أغلى",11,"ل",2,0],["انت أغلا من ملكته يا »أمير «","انت احلا من سكن قرة عيوني",12,"ن",2,0],["أنتَ ٱغتيالُ النّبض ِبعدَ حِصَارهِ","بخيالنا .. لمْ يعتمِدْهُ النّاسُ",13,"س",1,0],["أنت أغلى نعمةٍ في عيشتي","أبْعَدَتْني عن سقوطي في الرَّدَى",14,"د",2,0],["أنتِ أغلى إليَّ من كلِ غالٍ","أنا لولا هواكِ ما كنتُ حيَّا",15,"ي",2,0]]}