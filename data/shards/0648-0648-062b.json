{"poems":[[87,"يحكون أن أمة الأرانب","https://www.aldiwan.net/poem8038.html","الرجز"],[47,"وأمر من عللي تخلى ناظري","https://www.aldiwan.net/poem66681.html","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39663","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39607","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39590","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55303","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54771","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55093","الكامل"],[96,"ابتهالات","https://www.poetsgate.com/ViewPoem.aspx?id=12695",""],[98,"طارق بن زياد في طريقه إلى الأندلس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66419&r=&rc=95",""],[98,"شاعر مصر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66378&r=&rc=54",""],[124,"عباس إن ابني لي مفزع","https://www.aldiwan.net/poem49262.html","السريع"],[408,"يا واهب الجرد السلاهب","https://www.aldiwan.net/poem46913.html","مجزوء الكامل"],[415,"إن لم أمت أسفا عليه فإنني","https://www.aldiwan.net/poem32480.html","الكامل"],[463,"دعها تكن كالسلف من أخواتها","https://www.aldiwan.net/poem56263.html","البسيط"],[469,"لا تلمني فلات حين ملام","https://www.aldiwan.net/poem3141.html","عموديه"],[473,"يا من هو الأم لنا والأب","https://www.aldiwan.net/poem60460.html","السريع"],[556,"عتاب لدهر لا يمل عتابي","https://www.aldiwan.net/poem48065.html","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48822","الخفيف"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48750","الكامل"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72325","الطويل"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100453","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53125","الرجز"],[2606,"","https://poetry.dctabudhabi.ae/diwan/poem/198979","الكامل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109821","الكامل"],[3236,"","https://poetry.dctabudhabi.ae/diwan/poem/121821","السريع"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145062","الكامل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74039","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62820","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62800","الطويل"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46012","الكامل"],[3989,"","https://poetry.dctabudhabi.ae/diwan/poem/147364","الخفيف"],[4908,"دمعة حزن على جراح الوطن","https://www.poetsgate.com/ViewPoem.aspx?id=207338",""],[585,"أقسمتُ أنكَ روضةٌ وجنان","https://www.poetsgate.com/ViewPoem.aspx?id=161909",""],[5183,"المْفَتُوْن","https://www.poetsgate.com/ViewPoem.aspx?id=186475",""],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""],[592,"أهاجك أم أشجاك رسم المعاهد","https://www.poetsgate.com/ViewPoem.aspx?id=128839",""],[5442,"قد براها جذب البرى والأزمة","https://www.poetsgate.com/ViewPoem.aspx?id=114766",""],[6152,"الوكالة","https://www.poetsgate.com/ViewPoem.aspx?id=201644",""],[6192,"هل أتاكم حديث الخيول ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63746&r=&rc=12",""],[463,"دعها تكنْ كالسلفِ من أخواتها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=59994&r=&rc=50",""]],"verses":[["وَوَثَبَ الثاني فَقالَ إِنّي","أَعهَدُ في الثَعلَبِ شَيخَ الفَنِّ",0,"ن",1,0],["وَوَثَقتُ بِالخَلَفِ الجَميلِ مُعَجَّلاً","مِنهُ فَأَعطَيتُ الَّذي أَعطاني",1,"ن",2,0],["ووثبُ الخيل أفراسُ الأماني","إِلى خَطَرٍ تعشَّقه ورامهْ",2,"م",2,0],["وَوَثَبْتَ فوق صخورها وتلمَّسَتْ","كفَّاكَ قلباً ثائرَ الأهواءِ",3,"ا",2,0],["ووثبةُ ذِهنٍ يَقنصُ البرقَ طائراً","ويغزو بروجَ النَّجْمِ غيرَ مُحاذِرِ",4,"ر",1,0],["وَوُثُوبَ أَبْنَاءِ الدِّيَا","رِ بِهِ إِلَى حيث انْهَزَمْ",5,"م",1,0],["وَوَثْبُهُمَا عِنْدَمَا أُطْلِقَا","بِعَزْمٍ إِلى ظَاهِرِ المِجْسَد",6,"د",1,0],["وَوَثِقْتَ أَنَّ عَظِيمَ حُزْ","نِكَ إِنَّمَا يُدْمِي حَشَاكْ",7,"ك",1,0],["ووثقت أنّ النهر ملك يدي ففاجأني السراب","أنا لا أرجّي غير جبّار السماء ولا أهاب",8,"ب",1,0],["ووثبت فوقها صخورها وتلمّست","كفّاك قلبا ثائر الأهواء",9,"ا",2,0],["ووثبة ذهن ، ينقص البرق طائرا","ويغزو بروج النّجم غير محاذر",10,"ر",1,0],["ووثبه بين ألاعيبه","وكلها أكبر من قدره",11,"ر",2,0],["ووثقتُ منكَ بماجدٍ","جمَّ المحامدِ والمناقب",12,"ب",1,0],["ووثقتُ باللّطفِ الخفيِّ من الذي","تَجري بما يَلقى الفَتَى أقدَارُهُ",13,"ر",2,0],["ووثيقةٍ ألجأتَ ظهرَك مُسنَداً","بغرورها فسقطتَ في مَهواتِها",14,"ت",3,0],["ووثوق بعروةٍ قبلها الموتُ","رمى كلَّ عروة بانفصامِ",15,"م",1,0],["ووَثَمَّ طَرذينٌ وَسَنبوسَقٌ","إِلَيهِما في السَغبِ المَهرَبُ",16,"ب",1,0],["وَوثبة مَفتول الذّراعِ قُصاقِصٍ","يُساعد ظُفراً في الصّريع بنابِ",17,"ب",1,0],["ووثقتم من الغضابِ على الده","رِ لكم بالرضى وبالإقرارِ",18,"ر",1,0],["ووثيقة للشعب طاعته إذا","أرضى الوزير الشعب والمستوزر",19,"ر",1,0],["ووثعلبة أضحوا بنا قد تأسدوا","فما لهم في المشركين مقادم",20,"م",1,0],["ووثلن عليه معظماً","كيما تزاد بذاك أجرا",21,"ر",2,0],["ووثبتي على المُدام ثملاً","مُنَكِّباً إلا عن الكبير",22,"ر",1,0],["ووثقت من حبل اعتمادي عمدة","لتمسكي بقويه ووثيقه",23,"ق",2,0],["ووثقت عندك بالنجاح فخلته","قد صار رهن اناملي او كادا",24,"د",2,0],["ووثْبةُ الأرْنَبِ كم خَلَّفتْ","كَلْباً على حِرْمانِه يَعْوِي",25,"ي",1,0],["ووثوقه بالنفس وهي كحية","رقطاء فيه خفية الأجحار",26,"ر",1,0],["وَوَثبة تستفزّ الكون سيرتها","إِذا تَداوَلَت الأَذكار وَالسيرُ",27,"ر",1,0],["ووَثِقْتُ منهُ بالغَنيمةِ آجلاً","ورَبِحْتُ رؤيةَ وجهِهِ في العاجلِ",28,"ل",1,0],["ووثبةَ ضرغامٍ كأنّ زئيرَهُ","تَهَدُّمُ طودٍ من هِضابِ يَلَمْلَمِ",29,"م",1,0],["وَوَثقتُ مِن فِردَوس عَدنٍ بِالَّذي","ذكرَ الأَيمَّةُ مِن نَعيمِ خُلودِ",30,"د",1,0],["ووثوبا ً إلى غد ووصولا","لغد والطريق رند ودفلى",31,"ل",2,0],["ووثيقةُ العهدِ الذي ما بيننا","تحيا البلادُ وترحلُ الأحزابُ",32,"ب",1,0],["ووثبت تخترق الصفوف مجاهداً","والنقع أكدر والسماءُ دخان",33,"ن",1,0],["ووثير فرش كم وطئت به فغبت بسكرتك","وخريدةٍ كالبدر تجلو الحسن فوق أسرّتك",34,"ك",1,0],["ووثبة الموتور في امتعاضعها","أفتك من جساس بكر إذ رمى",35,"ا",1,0],["ووثبة ضرغام أبى سميدع","إذ الحرب ألقت بالدواهي الشدائد",36,"د",1,0],["ووثوقي بعفو ربي وافراً","ري بذنبي وفاقتي للرحمة",37,"م",2,0],["ووثّق كلّ دينٍ في كتابٍ","وأشهدْ شاهدين بلا ملالةْ",38,"ل",2,0],["وَوَثيرِ الفِرَاشِ كُلَّ مَسَاءٍ","وصَبَاحٍ في حِضْنِ طَرْفٍ كَحِيلِ",39,"ل",1,0],["ووثيقة ٍ ألجأتَ ظهرك مسنداً","بغرورها فسقطتَ في مهراتها",40,"ت",3,0]]}