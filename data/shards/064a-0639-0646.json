d=175027",""],[5652,"صدر الشمالي","https://www.poetsgate.com/ViewPoem.aspx?id=206703",""],[5664,"لا يالقصيده","https://www.poetsgate.com/ViewPoem.aspx?id=176686",""],[5664,"حفيف الجرح","https://www.poetsgate.com/ViewPoem.aspx?id=176687",""],[5764,"دقت الساعه ..","https://www.poetsgate.com/ViewPoem.aspx?id=137058",""],[5791,"وشم ..!","https://www.poetsgate.com/ViewPoem.aspx?id=208559",""],[5794,"قضايانا","https://www.poetsgate.com/ViewPoem.aspx?id=100754",""],[5821,"الروح للروح","https://www.poetsgate.com/ViewPoem.aspx?id=113758",""],[5848,"ضحكه وتنهيده","https://www.poetsgate.com/ViewPoem.aspx?id=51951",""],[5848,"والله لاجي قدام بيتك","https://www.poetsgate.com/ViewPoem.aspx?id=53210",""],[5848,"عطني زايد","https://www.poetsgate.com/ViewPoem.aspx?id=48809",""],[5862,"لوحة شقاوة حُ ب ... !!","https://www.poetsgate.com/ViewPoem.aspx?id=34637",""],[5950,"شايف حالي ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128334",""],[242,"يا حسنه والحسن قيد","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563695",""],[147,"أَمّا الْفِراقُ فَقَدْ عاصَيْتُهُ فَأَبى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=27437&r=&rc=4",""]],"verses":[["يَعْنِي بِمَا يَتَوَخَّى غَيْرَ مُتَّئِدٍ","فَمَا يَخَالُ لَهُ إِلاَّهُ مِنْ أَرَبِ",0,"ب",1,0],["يَعْنِي مَقَالَتَهُ وَلا تُلْفِيهِ فِي","حَالٍ يُغَمُّ عَلَيْكَ مَا هُوَ عَانِ",1,"ن",1,0],["يَعْنِيهِ أَمْرُ بِلادِهِ لا نَفْسُهُ","وَبِهِ تُفَاضِلُ عِنْدَهُ الأَيَّامُ",2,"م",1,0],["يعنو لها البدر المنير وقد علا","والبدر تاج بالنجوم مُرَصَّعُ",3,"ع",1,0],["يعنى بذا دون هذا مع تماثله","وقسْ على ما تراه السين والشينا",4,"ن",2,0],["يَعني معانيه ويلفظُ لفظَه","لحناً بذلك كُلِّهِ لا لاحنا",5,"ن",2,0],["يُعَنِّفُهُ الصَحابُ فَلا يُنيبُ","وَيَزجُرُهُ المَشيبُ فَلا يَتوبُ",6,"ب",1,0],["يُعَنِّفُني مَن كُنتُ أَدعوهُ صاحِباً","فَما اِنفَكَّ حَتّى بِتُّ أَدعوهُ لاحِيا",7,"ي",2,0],["يُعَنّيهِ أَمامٌ أَو وَراءٌ","إِذا اِختَلّ الأَمامُ أَو الوَراءُ",8,"ا",2,0],["يُعنى بِسُؤدُدِ قَومِهِ وَحُقوقِهِم","وَيَذودُ حياضَهُم وَيُحامي",9,"م",2,0],["يُعَنِّفُني عَلى بَغَتاتِ عَزمي","وَكُنتُ وَلا يُعَنِّفُني الأَريبُ",10,"ب",1,0],["يُعَنبِرُ أنفاسَ الرِّياحِ بِشِلوهِ","فَتَعبَقُ من أنفاسِ تلك الشَّمائلِ",11,"ل",1,0],["يُعنِّفُني أنْ أطَلْتُ النَّحيبَا","وأسكُبُ للبَيْنِ دمعاً سَكوبا",12,"ب",2,1],["يُعَنِّفُني أَن ضِقتُ ذَرعاً بِنَأيِهِ","وَيَجزَعُ أَن ضاقَت عَلَيهِ خَلاخِلُهُ",13,"ل",2,0],["يَعْنُو لِسَوْرَتِهِ الْمَلِيكُ وَلا","يَقْوَى عَلَى صَدَمَاتِهِ الشَّهْمُ",14,"م",1,0],["يُعَنّيهِ البَعُوضُ بكُلّ غابٍ","فَريشٍ بالجَماجِمِ واللِّمامِ",15,"م",1,0],["يعنون بالوزن وَاللفظ المقيم له","كأَنَّما الشعر ألفاظ وأوزان",16,"ن",1,0],["يَعْنُو لِقُدْرَتِهِ الْمَلِيكُ الْمُتَّقَي","وَيَهَابُ صَوْلَتَهُ الْكَمِيُّ الْقَسْوَرُ",17,"ر",1,0],["يَعْنُو لَهَا الْخَصْمُ الأَلَدُّ وَيَغْتَذِي","بِلِبَانِهَا ذِهْنُ الْخَطِيبِ الْمِصْقَعِ",18,"ع",1,0],["يُعْنَى بِوُلْدِهِمْ الضِّعَافِ لِيَرْتَقُوا","عِلْماً وَآدَاباً وَحُسْنَ خِصَالِ",19,"ل",1,0],["يعنو لطلعته، ويهتف باسمه","ويكاد يتلو قولَه إنجيلا",20,"ل",2,0],["يُعَني بما تَلد الليالي حيطةً","ويُعِدُّ للأيام الفَ حساب",21,"ب",1,0],["يُعنَّى به حُرٌّ لإحقاقِ جرئٍ غايةٍ","ويَخرُجُ عنه آخرٌ للتضرُّع",22,"ع",1,0],["يعني كل شي حطّه فعقلك .. وحاته","الاّ بخصوص أنّي أحبّك .. لاتحاتي",23,"ت",2,0],["يعني ليا رموني حقيرين الجناب","صار زولي عشرة ازوال وعيوني",24,"ي",1,0],["يعنّفني من كنت أدعوه صاحبا","فما انفكّ حتّى يتّ أدعوه لاحيا",25,"ي",2,0],["يُعْنَى بِسُؤدد قومِه، وحُقوقِهم","ويذودُ دونَ حياضهم، ويحامي",26,"م",2,0],["يعنو لك اللفظ والمعنى كما امتثلت","هذي العوالم أمر الخالق الراعي",27,"ع",2,0],["يعني رأيت مين في الجواز اتنصف","اللي انكسر ضهرُه وإللي اتوحس",28,"س",1,0],["يَعِنُّ ذِكرُكَ أَحياناً فَيُخبِرُني","فَرطُ الإِصاخَةِ عَن قَلبٍ إِلَيكَ صَبا",29,"ب",2,0],["يعني صفيراً وتصفيقاً ففعلكم","أشد من فعلهم قبحاً فلا تعب",30,"ب",1,0],["يعني بمِسْواك الأَراك بمثلِه","ويُقابل الكثبانَ بالكثبان",31,"ن",1,0],["يعنفني فيه العذول بجهله","وهل يبصر الشمس المنيرة أرمد",32,"د",1,0],["يَعْنُو لَهُ الْجَبَّارُ ذُو ال","بَتَّارِ وَهْوَ بهِ مُقَلَّدْ",33,"د",1,0],["يُعَنِّفني في الحُزنِ عِندَ مَغيبِهِ","سَليمُ الحَشا ما ذاقَ فِرقةَ الفهِ",34,"ف",2,0],["يعنيك من أَصل وَفرع أوسكن","في ظلنا المَمدود من محن الزمن",35,"ن",1,0],["يُعْنَى بِها لَوْ أَنَّها تُعْنَى بهِ","عَانٍ لَه بَرحُ الغَرامِ وِثَاقُ",36,"ق",1,0],["يُعَنَّفُ مَنْ لَمْ يَأْتِهِ يَوْمَ جُودِهِ","وَيُعْذَرُ مَنْ لَمْ يَلْقَهُ يَوْمَ حَرْبِهِ",37,"ب",2,0],["يَعِنُّ لَهُ بِمِذنَبِ كُلِّ وادٍ","إِذا ما الغَيثُ أَخضَلَ كُلَّ ريعِ",38,"ع",1,0],["يَعَنُّ لِطالِبِ الدُنيا ثَلاثٌ","ثِيَ الشُعَبُ الثَلاثُ بِغَيرِ مينِ",39,"ن",1,1],["يَعنَى بدينٍ منَ التَّقوى ويَخْدُمه","من عزِّه كلُّ مَنْ يُعْنَى بدِيوان",40,"ن",1,0],["يَعنف لاحي مَن يَهيم بِحُبِهِ","وَيَمدح مُطريهِ وَيَأثم عائِبه",41,"ب",2,0],["يَعْنو لِفضلكَ مَنْ في أنفِه شمَمٌ","طوعاً ويَسْجدُ مَن في خدِّ صَعَرُ",42,"ر",1,0],["يعنفني في الدار صبحي على البكا","فيال ويح قلبي من خلي وجاهل",43,"ل",1,1],["يَعِنُّ لَها طَوراً يَروقُها","عَلى الأُنسِ منه جرأةٌ وَتَوثُّبُ",44,"ب",1,0],["يعن لي ذكرها من كل ذي ملحٍ","لأنه في جميع الحسن ملغوزُ",45,"ز",1,0],["يعنون في مليحٍ كل شعرٍ","يكون به وما بالغير في من",46,"ن",1,0],["يعنِّفُ في حُبِّ البداوة فارغٌ","من الوجد لم يَقْرِ الغرامَ الجوانحا",47,"ح",2,0],["يُعنِّفُ فيك أَنْ صُدِعَتْ ضلوعي","خَليُّ القلبِ من تلك الهَناتِ",48,"ت",1,0],["يعنو القويُّ للضعيف عنده","ويبلغ الجدُّ فعال الهازل",49,"ل",1,0],["يُعَنوِنُ بِالإِنصافِ كُتبَ إِخائِهِ","وَيَختِمُ بِالإِنجازِ طينَ المَواعِدِ",50,"د",1,0],["يعنين عمر غدت في خدرها قمر","زهت تتيه على بدر بدا زحل",51,"ل",1,0],["يعنف حجاج بيتِ الإله","ويسطو بهم سطوةَ الجائر",52,"ر",1,0],["يُعنِّفُني قومٌ بأنّي أُطيعكمْ","وَلم يرضكمْ إلّا الّذي هو أَطوعُ",53,"ع",1,0],["يُعَنُّ فَيجري مِلْءَ كل فروجِهِ","وَيُتلى غداةَ الجَريِ منه بناكِصِ",54,"ص",1,0],["يعني به نسبتنا","لله حقاً والدين",55,"ن",1,0],["يعني على حسب الذي أنا عارف","لا مقتضى ما يقتفيه الجاحد",56,"د",1,0],["يَعني إذا كان في علم الإله له","سعادةٌ عُلمت من غير إشقاء",57,"ا",2,0],["يُعْنَوْنَ بِالدِّيْوَانِ وَالمَيْدَانِ","وَلاَ يَعِفُّونَ عَنِ القِيَانِ",58,"ن",1,0],["يعنون إسماعيل فيما ساقوا","وقال قوم منهم إسحاق",59,"ق",1,0],["يعنون نحو ابن أبي قحافة","ليوجبوا بذلك استخلافه",59,"ه",1,0],["يعني أبا عبيدة أو عمرا","وبهما كان على القول اجترا",59,"ر",2,0],["يعني أبا هاشم وهو ابنه","حتى إذا أتاه قالوا حينه",59,"ه",1,0],["يُعَنِّفُ طَبعاًن وما عُنْفُ وَان","عنِ المَجدِ ليسَ بِذي عُنفُوانِ",60,"ن",1,0],["يُعَنوِنُ عَن بَثَّ الحَديثِ حَديثُهُ","وَيُعلِنُ عَن سِرِّ القَديمِ قَديمُهُ",61,"م",2,0],["يَعنُو لِسَطوَتِهِ في البَأسِ عامِرُهُ","قَهراً وَيَتبَعُهُ في الجُودِ حاتِمُهُ",62,"م",2,0],["يعن لها مبرك في ثراك","فَتَشتاق في تربه أَن تحل",63,"ل",1,0],["يُعَنّفُني بِالعذلِ وَاللّومِ ناصِحاً","يُريدُ بِهِ جَهلاً لِوَجدي بها حبطا",64,"ط",2,0],["يعنو له كلُّ محتاجٍ وكم قطعتْ","إليه كلُّ الورى قفراً وأنجادا",65,"د",2,0],["يعنو له يحيى بن أكتم","والفتى زيد بن أرقم",66,"م",1,0],["يعنو لسواد صحائف","في كفه البيض الصفاحُ",67,"ح",1,0],["يعني بجود سائر مثلا","في الناس ينسي ذكره معنا",68,"ن",2,0],["يُعنّي الخاضب الأخر","ج في ذي عمدٍ صهب",69,"ب",1,0],["يَعنو لِهَيبتهِ الزما","نُ إِذا توعّد أَو غَضب",70,"ب",1,0],["يَعنو إِلى المَسنونِ مِن أَسيافِهِ","قَلبُ المُعانِدِ وَهوَ قَلبٌ واجِبُ",71,"ب",1,0],["يُعنى بِها النَصر لا يَنفَكُّ يَلزَمُهُ","كَأَنَّهُ عِلَّةٌ وَالنَصرُ مَعلولُ",72,"ل",1,0],["يعنبرك الصفايا عنبريه","ويسقيك الحيا بضحى عشيه",73,"ي",2,0],["يَعنون أن العَيش في التَدبير","وَلَيسَ بِالقسمة وَالتقدير",74,"ر",1,0],["يعنفني العذول وبي غرام","يحذرني مطاوعة العذول",75,"ل",1,0],["يَعْنُو لَهُ فِي غَرْبِهِ مَنْ كَانَ مِنْ","صِنْهَاجَةٍ وَيَذِلُّ كُلُّ مَجَاصِ",76,"ص",1,0],["يُعنِّفُنِى فيها وفى الحبِّ للنّدى","أناسٌ إذا عُدَّ اللئامُ لِئامُ",77,"م",1,0],["يعنفني على كسب المعالي","وأخذي من معادنها نصيبي",78,"ب",2,0],["يعنف فيك سليب الحجا","معنى بحب الظبا مستهاما",79,"م",2,0],["يُعنَى بِهَا المتلُوُّ فَهُو كَلاَمُهُ","هُوض غَيرُ مَخلُوقٍ كذِي الأكوَانِ",80,"ن",1,0],["يعني الحقائق لا تماثل هذه","وكلاهما في الاسم متفقان",80,"ن",1,0],["يعنف أن رأى سري مذاعاً","به علم الأقاصي والأداني",81,"ي",1,1],["يُعنِّفُني الأريبُ إذا تَبدَّت","مَساوينا ويَصدَعُ بالعِتابِ",82,"ب",1,0],["يعنفها الطاغي الدعي شماتة","بمشهد كبار الفري