21764",""],[5358,"أتى وحيدُكِ","https://www.poetsgate.com/ViewPoem.aspx?id=183426",""],[5411,"شاعر الثورة","https://www.poetsgate.com/ViewPoem.aspx?id=198605",""],[5431,"ليرتل الإشراق ترتيلا","https://www.poetsgate.com/ViewPoem.aspx?id=214920",""],[5458,"الاخلاق قبل العلم","https://www.poetsgate.com/ViewPoem.aspx?id=72160",""],[5493,"مساجدُ الإسلام","https://www.poetsgate.com/ViewPoem.aspx?id=205714",""],[5496,"أنت واحدها","https://www.poetsgate.com/ViewPoem.aspx?id=212780",""],[5561,"المجد","https://www.poetsgate.com/ViewPoem.aspx?id=205111",""],[5628,"شر المصائب","https://www.poetsgate.com/ViewPoem.aspx?id=178705",""],[5649,"درة صور","https://www.poetsgate.com/ViewPoem.aspx?id=38967",""],[5691,"شموع","https://www.poetsgate.com/ViewPoem.aspx?id=206531",""],[5742,"الأمل المعلق","https://www.poetsgate.com/ViewPoem.aspx?id=206974",""],[5751,"طيلسان الريح","https://www.poetsgate.com/ViewPoem.aspx?id=214790",""],[487,"ببسم إله العرش أهتف داخلا","https://www.poetsgate.com/ViewPoem.aspx?id=129582",""],[5861,"ياربنا","https://www.poetsgate.com/ViewPoem.aspx?id=188087",""],[5943,"في ملتقى شبَّابنا","https://www.poetsgate.com/ViewPoem.aspx?id=34292",""],[5956,"يتسلل النور الجميل لمهجتي","https://www.poetsgate.com/ViewPoem.aspx?id=194211",""],[5970,"آمال مصر بهذا القصر مودعة","https://www.poetsgate.com/ViewPoem.aspx?id=130660",""],[6093,"تبني رأي","https://www.poetsgate.com/ViewPoem.aspx?id=206327",""],[6239,"المؤتلفة/ المختلفة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76056&r=&rc=107",""],[6305,"حروفي تسكُت في حضرتِك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87352&r=&rc=25",""],[6318,"صِدْقُ الوَفَاءِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66153&r=&rc=3",""],[5922,"مذكرة سرية ل\"غاليليو غاليلي\"","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88225&r=&rc=0",""]],"verses":[["تبنّى حُسامَ النّصْرِ منّيَ مُرْضَعاً","وعُوِّصْتُ حِجْرَ المُسْتَعينِ منَ المَهْدِ",0,"د",1,0],["تَبَنَّتهُ فَقالَ وَأَنتِ أُمّي","فَأَنّى بَعدَها لَكَ زَيدُ أُمُّ",1,"م",1,0],["تَبني الرِجالَ وَتَبني كُلَّ شاهِقَةٍ","مِنَ المَعالي وَتَبني العِزَّ وَالغَلَبا",2,"ب",2,0],["تَبني سَنابِكُهُم مِن فَوقِ أَرؤُسِهِم","سَقفاً كَواكِبُهُ البيضُ المَباتيرُ",3,"ر",1,1],["تبنين للوطن الرجال وإنما","هم في مدارس شدتها أولاد",4,"د",1,0],["تَبني بُيوتاً عَلى قَفرٍ يُهَدِّمُها","جَعدُ الثَرى مُصعَبٌ في دَفِّهِ زَوَرُ",5,"ر",1,0],["تبني مكارم مُرْساةً قواعدها","على مكارم آباءٍ وأجدادِ",6,"د",1,0],["تبنى الحياة حريصة آمالها","والموت في اعقابها هدام",7,"م",1,0],["تَبَنّاكِ المُلوكُ وَكُنتِ مِنهُم","بِمَنزِلَةِ البَنينِ أَوِ البَناتِ",8,"ت",1,0],["تبنى له في بحرنا قبة","حصينة الأرجاء كالقصرِ",9,"ر",1,0],["تَبَنّى فيهِما شَرَفُ المَعالي","خَراطيمَ الجَحاجِحَةِ الكِبارِ",10,"ر",1,0],["تُبنى بُيوتُ بَني سَعدٍ وَبَيتُكُمُ","عَلى ذَليلٍ مِنَ المَخزاةِ مَهدومِ",11,"م",1,0],["تُبْنَى الصّوامِعُ مِن رُؤوسِهِمُ بما","كَانَت على هَدمِ الصَّوامِعِ تَغتَدي",12,"د",2,0],["تبني سلاهبُهُ سماءَ عجاجةٍ","من ذُبّلِ الأرماح ذاتَ عمادِ",13,"د",1,0],["تُبنى المَعالي في ظِلِّهِ وَلَهُ","حَظٌّ مِنَ المُلكِ غَيرُ مُختَلَسِ",14,"س",1,0],["تَبني سَماءً عَلى أَرضٍ مُعَلَّقَةٍ","كَأَنَّها عَلَقٌ وَالأَرضُ بَيضاءُ",15,"ا",2,0],["تَبني المَنازِلَ أَعمارٌ مُهَدَّمَةٌ","مِنَ الزَمانِ بِأَنفاسٍ وَساعاتِ",16,"ت",1,0],["تَبَنَّوا خَيمَهُم فَوُقوا هَجيراً","وَأَعوَزَني مَكانٌ لِلتَبَنّي",17,"ن",2,0],["تبني سعادتها الشعو","ب على اتحاد وانضمام",18,"م",1,0],["تُبنى صروح الغالبي","نَ عَلى الجماجم وَالرفات",19,"ت",1,0],["تبنونَ للوطنِ الحياةَ وهكذا","تبني الحياةَ مصارعُ الشجعانِ",20,"ن",1,0],["تبنى الشعوب على فربى ومرحمة","وما بنى الحقد لا شعبا ولا رغدا",21,"د",2,0],["تُبْنَى الممالكُ والبطولَةُ أُسَّها","وعزائمُ الأحرار من صُفَّاحها",22,"ح",3,0],["تبني لمصرَ -بلا منٍ- سواعدُهم","جيلاً إلى الشرق والإسلام ينتَسب",23,"ب",1,0],["تَبْني الحضارةَ بُنيانًا على أُسُسٍ","وتَزْرَعُ السِّلمَ فوق الأرض بستانا",24,"ن",2,0],["تبنى حسام النصر مني مرضعا","وعوضت حجر المستعين من المهد",25,"د",1,0],["تُبنى الصوامع من رؤوسهم بها","كانت على هدم الصوامع تغتدي",26,"د",2,0],["تبّنته فجاء يهزّ عطفا","ببردتها ويخطر في حلاها",27,"ا",3,0],["تبني وتهدم كالحياة وربّما","غزلت لتنكث خيطها المغزولا",28,"ل",2,0],["تَبْني سماءً في أرضٍ مُعَلَّقَة ٍ ،","كأنّها عَلَقٌ، والأرضُ بيضاءُ",29,"ا",2,0],["تبني الحياة على هدى إيمانها","والعقل مثبت غيرها والماحي",30,"ح",2,0],["تُبِن غَيرَ أَن قَد أَومَأَت فَعَمَدنَها","كَشارِبِ مَكنونِ الشَرابِ المُخَتَّمِ",31,"م",1,0],["تبنى سنان ضلة أن يخيفني","ويأمن ما هذا بفعل المسالم",32,"م",1,0],["تبني وتهدم ما بنته وتنثني","تعطي وتأخذ من يدي مستامها",33,"م",3,0],["تبنا ولكن قلبي","يزوركم لو عطفتم",34,"م",1,0],["تبنا اليك ولقد نقض","نا ألف مرةٍ المتاب",35,"ب",1,0],["تُبنى المَمالِكُ بِالوَشيجِ الأَسمَرِ","وَالبيضُ تَلمَعُ في العَجاجِ الأَكدَرِ",36,"ر",1,1],["تبني من الأبياتِ كلَّ ممردٍ","من شأْنِه التشييدُ والإِحكام",37,"م",1,0],["تَبني عَلَيها ثُمَّ تَنسى","أَنَّها تُبنى عَلَيكا",38,"ك",2,0],["تبني يمينُك وهي النيلُ كلّ عُلا","والنَيْلُ يهدِمُ دفعاً كلّ بُنيانِ",39,"ن",1,0],["تَبْني عَلَى الآفاقِ مِنْ جَعْدِ الثَّرى","فَلَكاً بِزُرْقِ السَّمْهَرِيّ مُكَوْكَبا",40,"ب",2,0],["تبنا وأبنا إن قبلت متابنا","أوسع لنا يا مستعان ذرعنا",41,"ن",2,0],["تبني على الفتح ما شادته جازمة","بالرفع من شأنها خفضا لمنسحب",42,"ب",1,0],["تبنّاهُ السّحابُ فكان أحرى","بذي الدّعوى عليه النَّيّرانِ",43,"ن",1,0],["تبني رجاك على شفيرانها","قد خيبت من قبل مأمل كل صب",44,"ب",1,0],["تبني لها لتقرَّ هل","فيها لمخلوق مَقَرّ",45,"ر",1,0],["تبنا وافصحن عما عرانا","في مصاب أجرى عيون العين",46,"ن",1,0],["تبنى الزراعة فنَّاً","والشعبَ تحيي اقتصاده",47,"د",2,0],["تبني وتنشئ أمةً عصرية","وتُجلُّ في حرم الندى العلماء",48,"ا",2,0],["تبني به الهز لا على اسنامها دور","ويشيل عنّا بالفرح كلّ ضيجه",49,"ج",2,0],["تُبنا عَنِ الخَمرِ رَبّي وَالفُسوقِ مَعاً","صُمنا لِذاتِكَ أَصبَحنا مُصَلّينا",50,"ن",2,0],["تَبنينَ مَجدَكِ مِن شُطوطِ بِلادِنا","بِالتُرَهاتِ إِلى شُطوطِ الكابِ",51,"ب",1,0],["تبنا كلانا وسوف ننسى","لكِنّني عدت من قريب",52,"ب",1,0],["تبنى بنا كعبة التقوى فطاف بنا","من يبتغي الدين رجلاناً وركبانا",53,"ن",2,0],["تبني عليَّ الليالي من نوائبها","سجناً فتنفذ روحي من مبانيها",54,"ي",3,0],["تَب