"ت",2,0],["منازلُ خَلْقٍ قَدْرُهُنَّ نَصِيبُ","فإِجلالُ هذا دُونَ ذاكَ ذنوبُ!",177,"ب",1,1],["مَنازِلٌ ما سَرَتْ في حَيِّها مُهَجٌ","إِلَّا وأَوْقَفَها في حُبِّهِ الفِكَرُ",178,"ر",1,0],["مَنازِلاً كُنْتُ بِهَا مُصَرِّفاً","أَعِنَّةَ اللَّهو لَدَى مَيْدانِهِ",179,"ن",2,0],["مَنازِلُ مِن هِندٍ وَكانَ أَميرُها","إِذا ما أَحَسَّ القَيظَ تِلكَ مَصايِرُه",180,"ر",2,0],["مَنازِلُ يَقفوهنَّ كُلّ عَشيَّةٍ","وَكُلّ ضُحىً سفسافُ مُورٍ وَحافِلُه",181,"ل",2,1],["مَنازِلُ يُبكينَ الفَتى فَكَأَنَّما","تَسُحُّ بِغَربَي ناضِحٍ فَوقَ جَدوَلِ",182,"ل",1,0],["مَنازِلَ هِندٍ لَيتَ أَنّي لَم أَكُن","عَهِدتُ بِها هِنداً وَلَم أَدرِ ما هِيا",183,"ي",2,0],["مِنازِلَ مِن حَيَّيْ ذُوَيبِ بنِ مازِنٍ","وَغَيظٍ وَكَعبٍ قَبلَ أَن يَتَفَرَّقوا",184,"ق",3,0],["مَنازِلُ عَذْبةِ الأنْيابِ خَوْدٍ","فما إنْ مِثْلُها في الناسِ نيِمُ",185,"م",1,0]]}