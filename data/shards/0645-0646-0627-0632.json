://www.aldiwan.net/poem15322.html","الطويل"],[479,"قف بي على منزل بالربع قد دثرا","https://www.aldiwan.net/poem15341.html","البسيط"],[479,"بي من جوى التبريح اشفاق","https://www.aldiwan.net/poem15351.html","السريع"],[488,"أتعرف رسماً كالرداء المحبر","https://www.aldiwan.net/poem483.html",""],[553,"أأغفل والدهر لا يغفل","https://www.aldiwan.net/poem47339.html","المتقارب"],[564,"منازل عسفان فدتك المنازل","https://www.aldiwan.net/poem52753.html","الطويل"],[569,"سلام على دير القصير وسفحه","https://www.aldiwan.net/poem69772.html","الطويل"],[581,"منازل خلق قدرهن نصيب","https://www.aldiwan.net/poem56778.html","الطويل"],[588,"جيش الملاحة مقرون به الظفر","https://www.aldiwan.net/poem17513.html","البسيط"],[588,"حي غزالا سل من أجفانه","https://www.aldiwan.net/poem17822.html","الرجز"],[827,"","https://poetry.dctabudhabi.ae/diwan/poem/10453","الطويل"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/21472","الطويل"],[855,"","https://poetry.dctabudhabi.ae/diwan/poem/18051","الطويل"],[860,"","https://poetry.dctabudhabi.ae/diwan/poem/17741","الطويل"],[917,"","https://poetry.dctabudhabi.ae/diwan/poem/45537","الطويل"],[1093,"","https://poetry.dctabudhabi.ae/diwan/poem/75829","الوافر"]],"verses":[["منازل ربع عاصرتها دوارس","وهن على مر الزمان خوالد",0,"د",1,0],["مَنازِلُ مَمنونٌ عَلى الرَكبِ زادُها","نَزورٌ عَلى كَدِّ المِطالِ جَداها",1,"ا",3,0],["مَنازِلَ كانَ الطَرفُ يَرتاحُ بَينَها","لِخُضرٍ جَميمٍ أَو لِزُرقِ جِمامِ",2,"م",1,0],["مَنازِلُ لا يُعطي القِيادَ مُقيمُها","مُغالَبَةً وَلا يُهانُ نَزيلُها",3,"ل",3,0],["مُنازِلُ العَقّالِ وَالرِباقِ","مُوَطِّنُ المَنزِلِ لِلرِفاقِ",4,"ق",1,0],["مَنازِلُ لَم تَسلَم عَلَيهِنَّ مُقَلَّةٌ","وَلا جَفَّ بَعدَ البَينِ فيهِنَّ مَدمَعُ",5,"ع",1,0],["مَنازِلٌ لا يُرَجّى عِندَها أَمَلٌ","عَلى اللَيالي وَلا يُقضى بِها وَطَرُ",6,"ر",1,0],["مَنازِلُ ناشَدتُ السَحابَ فَما قَضى","فَريضَتَها عَنّي السَحابُ وَلا أَدّى",7,"د",2,0],["مَنازِلُهُم عَقرُ المَطايا وَإِنَّما","تُعَقِّلُها بِالبِشرِ وَالنائِلِ الجَعدِ",8,"د",1,0],["مَنازِلٌ كانَ فيها","لِلقَومِ أَمنٌ وَرُعبُ",9,"ب",1,0],["مُنازَعَةً إِلى العَلياءِ حَتّى","أَزُرَّ عَلى ذَوائِبِها جُيوبي",10,"ب",2,0],["مَنازِلٌ تَطلُعُ البُدورُ بِه","مُبَرقَعاتٍ بِظُلمَةِ الشَعَرِ",11,"ر",1,0],["مَنازِلُ فيما بَينَهنُّ أَحِبَّةٌ","هُمُ عَذَّبوا روحي وَهُم دَلَّهوا عَقلي",12,"ل",2,0],["مَنازِلٌ ما دَعا تَذَكُّرُها","إِلّا وَلَبّى عَلى النَوى لُبّي",13,"ب",2,0],["مَنازِلُ أُنسٍ ما أَمَحَّت وَلا اِمَّحَت","بِمَرِّ الغَوادي وَالسَواري سُطورُها",14,"ر",3,0],["مَنازِلَ لَم يَعفُ التَنائي قَديمَها","وَأُخرى بِمَيّا فارِقينَ فَمَوزَنِ",15,"ن",1,0],["مَنَازِلُ مِن أَسماءَ لَم تُعفِ رَسمَها","رِياحُ ا لثُرَيّا خِلفَةً فَضَريبُها",16,"ب",3,0],["مَنازِلُ الحَيِّ مِن غُمدانَ فَالنَضَدِ","فَمَأرِبٍ فَظَفارِ المُلكِ فَالجَنَدِ",17,"د",1,1],["مَنازِلُ مِن مَيٍّ بِوَهبينَ جادَها","أَهاضيبٌ طَلٍّ دَجنُها وَاِنهِمامُها",18,"م",3,0],["مَنازِلَ الحَيِّ إِذ لا الدَارُ نازِحَةٌ","بِالأَصفِياءِ وَإِذ لا العَيشُ مَذمومُ",19,"م",1,0],["مَنازِلُ الحَيِّ إِذ حَبلُ الصَفا عَلقٌ","مِن آلِ مَيٍّ جَديدٍ غَيرِ مَبتورِ",20,"ر",1,0],["مَنَازِلُ كُلِّ آنِسَةٍ رَداحٍ","يَزينُ بَياضُ مَحجِرِها الخِمارا",21,"ر",2,0],["مَنازِلَ قَد خَلَت مِن ساكِنيها","عَفَت إِلّا الدَعائِمَ وَالثُماما",22,"م",2,0],["مَنازِلُ مِن بيضِ الخُدودِ كَأَنَّها","نِعاجُ المَلا مِن مُعصِرٍ وَعَوانِ",23,"ن",1,0],["منازلهن دور بني سُليم","فدومة فالأباطح فالشقيرُ",24,"ر",1,1],["منازلُ فيها للرماح مغارسٌ","قديماً وللخيل العِراب مَرابِط",25,"ط",1,0],["مَنازِلُ أَقفَرَت مِن أُمِّ عَمرٍ","يَظَلُّ سَرابُها فيها يَجولُ",26,"ل",1,0],["مِن أَزرَقٍ كَالسَماءِ اوَرَهُ","أَحمَرٌ قانٍ كَأَنَّهُ الشَفَقُ",27,"ق",1,0],["مَنازِلُ كانَت لي بِهِنَّ مَنازِلٌ","وَكانَ الصِبا إِلفي بِها وَقَريني",28,"ن",2,0],["مَنازِلُ حَولَها بَلَدٌ رِقاقٌ","تَجِرُّ الرامِساتُ بِها الغُبارا",29,"ر",2,0],["مَنازِلُ آسادٍ وَبِيضِ نَواعِمٍ","فَناهيكَ من غيل وَناهيك مِن خِدرِ",30,"ر",1,0],["مَنازِلُ لَم يَزَل مِنها خَيالٌ","يُشَيِّعُني إِلى النِوبَنذَجانِ",31,"ن",1,0],["مَنازِلُ لا الأَيّامُ تُعدي عَلى البِلى","رُباها وَلا أَوبُ الخَليطِ يُقيدُها",32,"د",3,0],["مَنازِلُ أَضحَت لِلرِياحِ مَنازِلاً","تَرَدَّدُ فيها بَينَ نُؤيِ وَرِمدِدِ",33,"د",1,0],["مَنازِلٌ أَنكَرَتنا بَعدَ مَعرِفَةٍ","وَأَوحَشَت مِن هَوانا بَعدَ إيناسِ",34,"س",1,0],["مَنازِلُ لا صَوتي بِهِنَّ مُخَفَّضٌ","غَريبٌ وَلا سَهمي لَدَيهِنَّ أَفوَقُ",35,"ق",1,0],["مَنازِلٌ لا تُجيبُ الصَبَّ مِن خَرَسٍ","وَلا تَريعُ إِلى شَكواهُ مِن صَمَمِ",36,"م",1,0],["مَنازِلٌ لَم يُذَمَّم عَهدُ مُغرَمِنا","فيها وَلا ذُمَّ يَوماً عَهدُها فينا",37,"ن",2,0],["مَنازِلُ كانَت مِن أُناسٍ عَهِدتُهُم","غَطاريفَ مُردٍ سادَةً وَأَشايِبِ",38,"ب",1,0],["مَنازِلُ أَعرَتها جُبَيرَةُ وَاِلتَقَت","بِها الريحُ شَرقِيّاتُها وَدَبورُها",39,"ر",3,0],["مَنازيلُ عَن ظَهرِ القَليلِ كَثيرُنا","إِذا ما دَعا في المَجلِسِ المُتَرَدِّفُ",40,"ف",1,1],["مَنازِلُنا التي لَبِسَت بِلاَها","وحاَلت بَعدَ نُضرَتِها حِلاَها",41,"ا",3,1],["مَنازِلُ مرفوعٌ لحاضِركم بها","قِبابٌ وللبَادي الأغرِّ خِيامُ",42,"م",1,0],["مَنازِلُ ما أَبقى البِلى مِن عِراصِها","سِوى أَرسُمٍ مَعفُوَّةِ الآيِ هُمَّدِ",43,"د",1,0],["مَنازِلُ ما لاقَيتُ فيها نَدامَةً","سِوى أَنَّني قَضيتُ في غَيرِها عُمري",44,"ر",2,0],["مَنازِلٌ لَو قَصَدناها بِأَرؤُسِنا","لَكانَ ذاكَ عَلَينا بَعضَ ما يَجِبُ",45,"ب",1,0],["مَنازِلُ لَم أَذكُر بِها السِقطَ وَاللِوى","وَلَم يُصبِني عَنها الدُخولُ فَتوضِحُ",46,"ح",1,0],["من أزاحَ الفقْرَ إذْ أسْدَى الغنى","وأباحَ الوَفْرَ إذ صانَ الحريم",47,"م",1,0],["مَنازِلٌ لِهَواها بَينَ جانِحَتي","وَدِيعَةٌ سِرُّها لَم يَتَّصِل بِفَمي",48,"م",2,0],["منازلُ كانتْ مربعي زمنَ الصِّبا","فأبعدَني المقدورُ عنها وأنهضا",49,"ض",2,0],["منازلٌ كُسيتْ بالمصطفى شرفاً","بأفضلِ الخلقِ مِنْ بدوٍ ومِنْ حضرِ",50,"ر",1,0],["مَنازِلَ بَيضاءَ كانَت تَكونُ","بِسِرِّ هَواكَ وَإِعلانِكا",51,"ك",2,0],["مَنازِلُ أَقفَرَت مِن أُمِّ عَمروٍ","وَلَو طالَ اللَيالي وَالدُهورُ",52,"ر",1,0],["مَنازِلُ الحَيِّ أَقوَت بَعدَ ساكِنِها","أَمسَت تَرودُ بِها الغِزلانُ وَالبَقَرُ",53,"ر",1,0],["مَنازِلُ لَو مَرَّت عَلَيها جَنازَتي","لَقالَ الصَدى يا حامِلَيَّ اِنزِلا بِيا",54,"ي",2,0],["منازل فتيةٍ فزعوا إليها","بآمالِ العُناةِ المُرهَقينا",55,"ن",2,0],["مَنازِلُ البَدرِ لا تَحتاجُ تَح