{"poems":[[47,"توهم ليلى وأظعانها","https://www.aldiwan.net/poem66665.html","البسيط"],[99,"أحببت مية حبا لا يعادله","https://www.aldiwan.net/poem24864.html","البسيط"],[234,"أحب عدوي فيك والكاشح الذي","https://www.aldiwan.net/poem50965.html","الطويل"],[416,"أفي كل يوم أنت صب وليلة","https://www.aldiwan.net/poem67502.html","الطويل"],[591,"أحب عليا وهو سؤلي وبغيتي","https://www.aldiwan.net/poem17423.html","الطويل"],[1942,"","https://poetry.dctabudhabi.ae/diwan/poem/76813","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205031","الوافر"],[3017,"","https://poetry.dctabudhabi.ae/diwan/poem/117142","المتقارب"],[3589,"","https://poetry.dctabudhabi.ae/diwan/poem/34906","الوافر"],[3642,"","https://poetry.dctabudhabi.ae/diwan/poem/203454","الطويل"],[4092,"","https://poetry.dctabudhabi.ae/diwan/poem/141697","الطويل"],[4537,"","https://poetry.dctabudhabi.ae/diwan/poem/96075","الوافر"],[4927,"غيابُ عفراء","https://www.poetsgate.com/ViewPoem.aspx?id=29828",""],[5131,"أخذت المبادئ عن عصبةٍ","https://www.poetsgate.com/ViewPoem.aspx?id=42206",""],[5358,"حبات الزجاج","https://www.poetsgate.com/ViewPoem.aspx?id=21760",""],[5461,"يامدور الهين","https://www.poetsgate.com/ViewPoem.aspx?id=26284",""],[5790,"أما وبدور الكلل","https://www.poetsgate.com/ViewPoem.aspx?id=112122",""],[5956,"عيون الحب","https://www.poetsgate.com/ViewPoem.aspx?id=182112",""]],"verses":[["أُحِبُّ عَلى كُلِّ ما حالَةٍ","إِساءَةَ لَيلى وَإِحسانَها",0,"ن",3,0],["أُحبُّ عمري الذي في قرب ميَّ وما","قد مرَّ من دونها ما كان أضيعه",1,"ع",2,0],["أُحِبُّ عدوّي فيك والكاشح الذي","يَنُمُّ علينا والرقيبَ الذي يسعى",2,"ع",2,1],["أُحِبُّ عَلى الهِجرانِ أَكنافَ بَيتِها","فَيالَكَ مِن بَيتٍ يُحَبُّ وَيُهجَرُ",3,"ر",1,0],["أُحِبُّ عَليّاً وهو سُؤْلي وَبُغْيتي","وَمَا زَار إلّا قُلْتُ أَهْلاً ومَرْحَبَا",4,"ب",2,1],["أحب عَلى ما نالَني منك من قِلىً","وأُغضي عَلى أشياءَ منك تَريبُ",5,"ب",1,1],["أحب عبادة النيران شوقا","لنار سعّرتها وجنتاكا",6,"ك",2,0],["أحب علياً كحب النبي","على رغم ذي الشك والارتياب",7,"ب",1,0],["أُحِبُّ عُمانَ مِن حُبّي سُلَيمى","وَما طِيّي بِحُبِّ قُرى عُمانِ",8,"ن",1,0],["أُحبّ عليّاً والبتول وولدها","ولا أجحد الشّيخين حقّ التّقدّم",9,"م",1,1],["أُحبُّ علياً والبَتُولَ وَوُلدَها","ولا أجحدُ الشيخين فضل التَّقدمِ",10,"م",1,1],["أُحبُّ على لذاذتنا شقيقا","وأبغضُ مثلَ ثعلبةَ الثقيل",11,"ل",1,1],["أُحِبُّ عَفْراءَ إِنْ غَاْبَتْº وَإِنْ حَضَرَتْ","أَئِنُّ  مِنْ حُبِّهَاْ  مِثْلَ النَّوَاْعِيْرِ",12,"ر",1,0],["أحبُ عمان وأهفو إلى","نجومٍ بأجوائِها تلمعُ",13,"ع",1,0],["أُحِبّ ُعيونَ (يَمّ ٍ) وهْيَ تبكي","فقد زادَ الأسى فيها جَمالا",14,"ل",2,0],["أحب عسف المهرة اللي تغلى","واحب أروض كل طرف يموقي",15,"ق",2,0],["أحب على مهجتي","من الأمن بعد الوجل",16,"ل",1,0],["أحبُّ عيونك العسليَّ","ةَ الملأى من الشَّهَدِ",17,"د",1,0]]}