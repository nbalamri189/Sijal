{"poems":[[54,"أي رسم لآل هند ودار","https://www.aldiwan.net/poem27050.html","الخفيف"],[50,"غرد الديك الصدوح","https://www.aldiwan.net/poem62532.html","مجزوء الرمل"],[96,"مصرع الشمس","https://www.poetsgate.com/ViewPoem.aspx?id=12923",""],[119,"شيخ اهل البيت ذو القدر العلي","https://www.aldiwan.net/poem40856.html","عموديه"],[240,"طاف يسعى بها على الجلاس","https://www.aldiwan.net/poem31916.html","الخفيف"],[240,"من عذيري فيه وهل من عذير","https://www.aldiwan.net/poem32017.html","الخفيف"],[240,"خجلت من عطائك الأنواء","https://www.aldiwan.net/poem32200.html","الخفيف"],[276,"من لنفس ثناها","https://www.aldiwan.net/poem52122.html","مجزوء الرمل"],[331,"عجبا للذي نعى الناعيان","https://www.aldiwan.net/poem44240.html","الخفيف"],[369,"قسما مني بأيام الصفاء","https://www.aldiwan.net/poem61005.html","الطويل"],[409,"غنت الورق فوق غصن البان","https://www.aldiwan.net/poem33370.html","الخفيف"],[422,"إسأل الأرسم لو ردت جوابا","https://www.aldiwan.net/poem54032.html","الرمل"],[505,"تحت سبر المرفرف الأزلي","https://www.aldiwan.net/poem37723.html","الخفيف"],[505,"وحد الله ولا تشرك به","https://www.aldiwan.net/poem38033.html","الرمل"],[505,"إن معنى الهيام بالأولياء","https://www.aldiwan.net/poem38101.html","الخفيف"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2465","الخفيف"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83266","الخفيف"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126835","الخفيف"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66658","الخفيف"],[758,"","https://poetry.dctabudhabi.ae/diwan/poem/97704","الخفيف"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96642","الرمل"],[1183,"","https://poetry.dctabudhabi.ae/diwan/poem/18231","المنسرح"],[1183,"","https://poetry.dctabudhabi.ae/diwan/poem/18235","المنسرح"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74178","الرمل"],[3369,"","https://poetry.dctabudhabi.ae/diwan/poem/117044","الرمل"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82807","الخفيف"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62920","الخفيف"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85235","الرمل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90877","الرمل"],[669,"هاشمي مهذي احمدي","https://www.poetsgate.com/ViewPoem.aspx?id=18392",""],[5057,"غنِّ يا شام","https://www.poetsgate.com/ViewPoem.aspx?id=207360",""],[2365,"ذكرت شيب العذارين نوار","https://www.poetsgate.com/ViewPoem.aspx?id=200648",""],[5582,"لائِمِي فِي الحُبِّ مَهْلاً فَلَقَدْ","https://www.poetsgate.com/ViewPoem.aspx?id=63495",""],[6152,"هاشميون","https://www.poetsgate.com/ViewPoem.aspx?id=203020",""]],"verses":[["هاشِميٌّ إِذا نُسِبتُ وَمَخصو","صٌ يَبيتُ مِن هاشِمٍ غَيرَ عارٍ",0,"ر",1,0],["هاشِمِيٌّ عَبدَلِيٌّ","عِندَهُ يَغلو المَديحُ",1,"ح",1,0],["هاشمي الهوى أحبّ فما دارى","وعادى على هواكم وعودي",2,"د",2,0],["هاشمي رب عزم فاتك","جربت همته للامل",3,"ل",1,0],["هاشِميٌّ لَهُ زَئيرُ سُطىً يُن","سي الأُسودَ الزَئيرَ في الأَخياسِ",4,"س",1,0],["هاشِمِيٌّ مُؤَيَّدُ الرَأيِ وَالنُط","قِ جَميعاً وَالعَزمِ وَالتَفكيرِ",5,"ر",1,0],["هاشِمِيٌّ عَلى مُحَيّاهُ مِن هَد","يِ النَبِيِّ اِبنِ عَمِّهِ سيماءُ",6,"ا",2,0],["هاشمي نماه","مِن قريش ذراها",7,"ا",3,0],["هاشِمِيُّ التَشميرِ لا يَحمِلُ الثِق","لَ عَلى غارِبِ الشَرودِ الهِدانِ",8,"ن",1,0],["هاشِمي عاقد حبوتَه","في ذُرا بيتٍ رَبوبِيِّ البِناء",9,"ا",2,0],["هاشم من غدا هو الفرد حقاً","في بني هاشم فهل من ثاني",10,"ن",2,0],["هاشميٌّ علويٌّ ضاربٌ","في أعالي قُلل الفخر قبابا",11,"ب",2,0],["هاشِمِيُّ النِّجارِ في النَّسَقِ الأَزْ","هَرِ نوعاً من غَيْرِ ظُلْمَةِ فَيِّ",12,"ي",1,0],["هاشِمِيٌّ أَطْلَعَتْ هِمَّتُهُ","لأُولي الجُحْدِ شِهاباً رَصَدَا",13,"د",2,0],["هاشِمِيُّ الجَنابِ من أهلِ بيتٍ","عزَّ رُكناً بالسَّادةِ الأَوصِياءِ",14,"ا",2,0],["هاشِمِيٌّ بِكَفِّهِ مِن سِجالِ ال","مَجدِ سَجلٌ يُهانُ فيهِ المَتاعُ",15,"ع",1,0],["هاشِمِيٌّ أَشُمُّ أَنفَ كَذا مَعَ","شَمَمِ الأَنفِ هِمَّةٌ شَمّاءُ",16,"ا",2,0],["هاشميّ له إباءٌ وحزم","وتجاريب سادَ فيها الرجالا",17,"ل",2,0],["هاشميٌّ مهبّبٌ أحمديٌّ","من قريشِ القُرى وأهلِ الكتابِ",18,"ب",1,1],["هاشم الخيرِ ذي الجلالةِ والحم","وَ وذي الباعِ وَالندى والصميمِ",19,"م",1,0],["هاشميّ خُصّ بالوحيِ فأخ","جلَ ما في قلبهِ كانَ اِعتَقَد",20,"د",1,0],["هاشِمُ شَمسٌ بِالسَعدِ مَطلَعُها","إِذا بَدَت أَخفَتِ النُجومَ مَعا",21,"ع",2,1],["هاشِمُ بَحرٌ إِذا سَما وَطَما","أَخمَدَ حَرَّ الحَريقِ وَاِضطَرَما",22,"م",2,1],["هاشميٌّ أسرى به الحقُّ ليلاً","وبمرآهُ كبرَ المسجدانِ",23,"ن",1,0],["هاشمي هشمت فطنته","هَيكل الجَهل وَأَولاه حساما",24,"م",2,0],["هاشمي عربي","شرف الكون وزان",25,"ن",1,0],["هاشِمِيٌ آباؤُه الغر آبا","ءٌ كِرامٌ تناسلوا مِن كرامِ",26,"م",1,0],["هاشميٌّ جبينه يُخجلُ البد","رَ ويغتالُ لونَها الوبَّصَا",27,"ص",2,0],["هاشِمِيٌّ قَرَشِيٌّ طاهِرٌ","حسن الأخلاقِ زاكي الأصلِ سمحُ",28,"ح",1,0],["هاشمي هشم المولى به","مارن القوم الطغاة المجرمين",29,"ن",1,0],["هاشمي مهذي احمدي","من قريش القرى وأهل الكتاب",30,"ب",1,1],["هاشِمِيٌ لهُ القلوبُ ديارٌ","حاتِمِيٌ يفوقُ حدّ السّخاءِ",31,"ا",2,0],["هاشم فخر قصيّ كلها","أين تيم وعدّي والفخار؟",32,"ر",1,0],["هاشِمِيٌّ خُصَّ بِالوَحْيِ فَأَخْ","لَصَ ما فِي قَلْبِهِ كانَ اعْتَقَدْ",33,"د",1,0],["هاشميون والمكارم أرثُ","قد ربينا على الفضائل رشُدا",34,"د",2,1],["هاشميون والمودة حق","خاب عبد بحقهم قد تردى",34,"د",2,0],["هاشميون والمعالي غمارُ","كم ملأنا البطاح فضلا ورفدا",34,"د",2,0],["هاشميون رغم أنف المُعادي","من يظن العداء يُكسب حمدا!؟",34,"د",2,0],["هاشميون والكرامات تترى","كل نهج بنورهم فهو أهدى",34,"د",2,0]]}