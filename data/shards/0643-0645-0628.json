","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54759","المنسرح"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54920","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54912","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54882","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/116961","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54257","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54266","السريع"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54194","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54251","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54199","الخفيف"],[106,"في مهرجان الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179291",""],[46,"كم بالمدينةِ من غريبٍ نازِلٍ،","https://www.poetsgate.com/ViewPoem.aspx?id=20130",""],[46,"خلَصتُ من سبراتٍ في السّباريتِ،","https://www.poetsgate.com/ViewPoem.aspx?id=18114",""],[39,"شتَّ شعبُ الحيِّ بعدَ التئامْ","https://www.poetsgate.com/ViewPoem.aspx?id=4269",""],[89,"كل ما تبتغيه منا الحياة","https://diwany.org/%D9%83%D9%84-%D9%85%D8%A7-%D8%AA%D8%A8%D8%AA%D8%BA%D9%8A%D9%87-%D9%85%D9%86%D8%A7-%D8%A7%D9%84%D8%AD%D9%8A%D8%A7%D8%A9/","الخفيف"],[88,"لا تشك للناس يوماً عسرة الحال","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19556&r=&rc=59",""],[87,"ما لي وَ للدارِ منْ \" ليلى \" أحييها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23936&r=&rc=198",""]],"verses":[["كَم باعِ أَبّاءٍ تَفُلَّ بُطونُها","وَأَديمِ جَبّارٍ يَقُدُّ أَديمُها",0,"م",3,0],["كَم باتَ رَبّاءً لِسَيّارَةٍ","طارِقَةٍ غَيرَ أَوانِ الطُروق",1,"ق",1,0],["كَم بَينَ أَثناءِ الضَلوعِ لَهُنَّ مِن","قِرفٍ بِأَظفارِ النَوى مَقروفَ",2,"ف",1,0],["كَم باتَ في لَهَواتِ اللَيلِ تَعرُكُهُ","ما بَينَ أَكوارِها المَهرِيَّةُ الصُعُرُ",3,"ر",1,0],["كَم بَينَ أَيديكُم وَبَي","نَ النَجمِ مِن قُربٍ وَبُعدِ",4,"د",1,0],["كَم بانَ في المُتَحَمِّلينَ عَشِيَّةً","مِن ذي لَمىً خِصرِ الرَضابِ بَرودِ",5,"د",1,0],["كم بكت عيناك لمّا رأتا","بصري يطفا ويطوي في الحجاب",6,"ب",1,0],["كَم بِمِصرٍ زَفرَةٌ مِن حَرِّها","كُنِسَ الأَعفَرُ وَالطَيرُ وَكَر",7,"ر",1,0],["كَم بِها والِدَةٍ والِهَةٍ","عَضَّها الثُكلُ بِنابٍ فَعَقَر",7,"ر",1,0],["كَم بَغَت دَولَةٌ عَلَيَّ وَجارَت","ثُمَّ زالَت وَتِلكَ عُقبى التَعَدّي",8,"ي",1,0],["كَم بالَةٍ سَبَّبَت وَبالا","وَأَشبَهَت لامِعَ السَرابِ",9,"ب",1,0],["كَم باتَ يَلتَحِمُ العُرو","ضَ وَجاءَ بِالأَمرِ الفَري",10,"ر",2,0],["كَم باتَ يُلهيني بِها مَصنوعَةُ ال","أَلحانِ أَو مَطبوعَةُ الأَسجاعِ",11,"ع",1,0],["كَم باتَ يَدري لَيلَهُ الغِربيبا","لَمّا اِنثَنى في سُكرِهِ قَضيبا",12,"ب",2,0],["كَمْ بِيعَةٍ قَدِمَتْ عَهْداً فَجَدَّدَهَا","وَبِيعَةٍ شَادَهَا مَرْفُوعَةَ القِبَبِ",13,"ب",1,0],["كَمْ بَنَتْ مَأْوىً وَشَادَتْ مَلْجَأً","لِلأَيَامَى وَاليَتَامَى البَائِسِينْ",14,"ن",1,0],["كَمْ بَدَتْ مِنْكَ بَادِرَاتُ نُبُوغٍ","حَيَّرَتْ بِابْتِكَارِهَا الأَحْلامَا",15,"م",2,0],["كم بلدةٍ للكفر قد عوّضت من","ناقوسها التكبيرَ والتهليلا",16,"ل",2,0],["كم بلّ نائرةً فأطفأ نارها","من بين مشتبك الصوارم والقنا",17,"ن",2,0],["كم بِتَّ معتلج الهموم بليلة","ما للظلام بفجرها تقويض",18,"ض",1,0],["كم بأرض البلقان منكم قتيِل","وأيامي مضاعة ويتامى",19,"م",2,0],["كم بات ذو الحُمق خِلواً في مضاجعه","وبات ذو العقل فيها كاسِف البال",20,"ل",1,0],["كم بات سهران في تحقيق منيته","وفي الأمانيّ ما يستوجب السهرا",21,"ر",2,0],["كَم بِالمَواسِمِ مِن شَعثاءَ أَرمَلَةٍ","وَمِن يَتيمٍ ضَعيفِ الصَوتِ وَالنَظَرِ",22,"ر",1,0],["كم بسطتْ راحتاهُ من أمل","ونفستْ بالجميلِ من كربه",23,"ب",2,0],["كم بين أبيات أمداحِي له شيمٌ","كأنَّهنَّ نجومٌ بين أبراج",24,"ج",1,0],["كم بشر بالثلج لما غدا","كالحجرِ المطروحِ قبل المسخّ",25,"خ",1,0],["كم بعثنا إلى الدواوين طرساً","خائباً كاده الزمان فكدا",26,"د",2,0],["كم باب نصرٍ وكم باباً إلى فرجٍ","فتحت يا فائزَ المسعى وظافرَه",27,"ر",2,0],["كم بيمناه قصة قد أجيبت","وسؤولٌ بها أجيب سؤاله",28,"ل",2,0],["كم بيت مدح قلت فيك لنظمه","يا بيت عاتكة الذي أتغزّل",29,"ل",1,0],["كم بُلغةٍ ما دونها بُلغةٌ","قد نافرَتْني إذ تألَّفْتُها",30,"ت",3,0],["كم بِتَّ بين أيورهم مُتقسَّماً","حتى كأنك بينها ميراثُ",31,"ث",1,0],["كم بغوْر الشَّآم غادرتُ منهمْ","غَائراً مُوفياً على أهل نجدِ",32,"د",1,1],["كم بها سرباً من الوح","شِ كحيلاً باحورار",33,"ر",1,0],["كم بها سرباً من الإن","س له فيها تباري",33,"ر",2,0],["كم بها من صُدُغ أسْ","وَدَ معشوقِ المَدار",33,"ر",1,0],["كم بها من شاربٍ أخ","ضرَ حلو المُسْتدار",33,"ر",1,0],["كمبغض أمرٍ غامسٍ فيه نفسَه","وقد كان عنه في ذَرى المنظر العالي",34,"ل",2,0],["كم بين وسواس الحُلِي","يِ وبينَ وسواسِ الهمومِ",35,"م",1,0],["كم بدا في الكتاب لي من ضياءٍ","كان مِنْ قبلُ دونه كالقَتام",36,"م",1,0],["كم بكَّتوني وعيَّروا أدبي","لمّا جفاني مَحلُّ إعظامي",37,"م",2,0],["كَم بَِلجَزيرَةِ لَو يُتاحُ لِيَ الهَوى","مِن غادَةٍ تَحكي بِطُلعَتِها القَمَر",38,"ر",1,0],["كَم بِنا صَباً عَليلا","لا يُداويهِ سِواك",39,"ك",1,0],["كَم بَدا البَدرُ ضَحوكا","راقِصاً فَوقَ الكُروم",39,"م",1,0],["كَم بَينَ طَيّاتِ العُصورِ الخالِيَه","عِظَةٍ لِأَبناءِ الدُهورِ الآتِيَه",40,"ي",2,1],["كَم بِها قَد مَرَّ لي أَس","تَغفِرُ اللَهَ سُرورُ",41,"ر",1,0],["كمْ بقلبِ الظَّلامِ مِنْ أنَّةٍ","تهفو بغصَّاتِ صِبْيَةٍ أَيتامِ",42,"م",1,0],["كَم بِتُّ مِنكُم بَينَ غُصنَي بانَةٍ","كالسَيف تَضغَطُ مَتنَهُ الأَغمادُ",43,"د",1,0],["كم به من قصائد","كل ابياتها غرر",44,"ر",1,0],["كم بهذا الفضاء من","سعة تدهش الفكر",44,"ر",1,0],["كم بك الدهر تمخض","حتى نجلك",45,"ك",1,0],["كم بدور ودّعت يوم النوى","وشموس شيعت يوم الرحيل",46,"ل",1,0],["كم بيوت ضاقت الدنيا بها","بعدما عزت على طول السنين",47,"ن",1,0],["كَمُبصِرٍ أَدارَ عَي","ناً في الدُجى وَقَلَّبا",48,"ب",2,0],["كَم باتَ يَذبَحُ صَدرَهُ لِشَكاتِهِ","أَتُراهُ يَحسَبُها مِنَ الأَضيافِ",49,"ف",1,0],["كَم بِنتِ فيهِ وَكَم خَفيتِ كَأَنَّهُ","ثَوبُ المُمَثِّلِ أَو لِباسُ المَرفَعِ",50,"ع",1,0],["كم بينَ طرَّةِ شادنِ قد صُفِّفَتْ","وتَصفُّفِ الأقرانِ يومَ طِعَانِ",51,"ن",1,0],["كَم بَثَّ في حاضِرِ النَهرَينِ مِن نَفَلٍ","مُلقىً عَلى حاضِرِ النَهرَينِ مَصبوبِ",52,"ب",1,0],["كَم بِالكَثيبِ مِنِ اِعتِراضِ كَثيبِ","وَقَوامِ غُصنٍ في الثِيابِ رَطيبِ",53,"ب",1,1],["كَم بُكِّتوا بِصَنيعَةٍ مِن طَولِهِ","تُخزى وُجوهُهُم بِها وَتُشاهُ",54,"ا",2,0],["كم بينَ تلك السُّجوفِ من مُقَلٍ","تَبْذُلُ من دَمعِها الذي تَجدُه",55,"د",2,0],["كَم بَينَ مَن أَقسَمَ اللَهُ العَلِيُّ بِهِ","وَبَينَ مَن جاءَ بِاِسمِ اللَهِ في القَسَمِ",56,"م",1,0],["كَم بَينَ خَمرٍ يَخافُ الحَدَّ شارِبُها","وَخَمرَةٍ ما عَلى شُرّابِها باسُ",57,"س",1,0],["كَم بِها مِن بَديعِ زَهرٍ أَنيقٍ","كَفُصولٍ مَنظومَةٍ وَعُقودِ",58,"د",1,0],["كَم بَنَت بِالفِكرِ بَيتَ مَعانٍ","وَاِنثَنَت بِالذِكرِ بَيتَ مَعالي",59,"ي",1,0],["كَم بِدَرٍ أَعطى الوُفودَ وَلُهىً","وَكانَ يُرضيهِم كَفافاً وَلُهَن",60,"ن",1,0],["كم بتُّ منتبهاً أصغي لخطوته","أراه في الوهم أحياناً وأسمعُه",61,"ع",2,0],["كم به من سوانحٍ في المغاني","آمناتٍ من نبأةِ الخوفِ ترتَع",62,"ع",1,0],["كم بأرْضِ الشرك من معمورةٍ","أصبحت في غَزْوِهِ وهي يَبَاب",63,"ب",1,0],["كَم بِتَّ تَأخُذُها وَباتَ مُنادِمٌ","لَكَ وَهوَ يَأخُذُ مِنكَ ما لا يَترُكُ",64,"ك",1,0],["كَم بَينَ قَومٍ إِنَّما نَفَقاتُهُم","مالٌ وَقَومٍ يُنفِقونَ نُفوسا",65,"س",2,0],["كَم بَينَ حيطانِها مِن فارِسٍ بَطَلٍ","قاني الذَوائِبِ مِن آني دَمٍ سَرَبِ",66,"ب",1,0],["كَمْ بَيْنَ دَاثِرَةٍ أَقْوَتْ مَعَالِمُهَا","وَبَيْنَ عَامِرَةٍ تَزْهُو بِمَنْ فِيهَا",67,"ي",3,0],["كَمْ بَيْنَ شَرٍّ ظَاهِرٍ مُسْتَدْرَكٍ","مِنْهُ الْخَلاصُ وَبَيْنَ شَرٍّ بَاطِنِ",68,"ن",1,0],["كَمْ بَيْنَ مَا تَلْفِظُ الأَسْيَافُ مِنْ عَلَقٍ","وَبَيْنَ مَا تَنْفُثُ الأَقْلامُ مِنْ حِكَمِ",69,"م",1,0],["كم باذلٍ في منصبٍ مالَهُ","ماتَ وما هُنِّيَ بالمنصبِ",70,"ب",1,0],["كم بكيتمْ إذْ أصبحَ الماءُ غوراً","فاضحكوا حيثُ أصبحَ الغورُ ماءَ",71,"ا",2,0],["كم بدا لي فيهِ بدرٌ طالعٌ","وتثنى فيهِ غصنٌ أهيفُ",72,"ف",1,0],["كمْ بمصرٍ من وجوهٍ","نَفَضَ النيلُ عليها",73,"ه",2,0],["كَم بِالحَرامِ وَلَو كُنّا نُحالِفُهُ","مِن كاشِحٍ وَدَّ أَنّا لا نُرى أَبَدا",74,"د",2,0],["كَم بِصَدرِيَ فيكَ مِن حُرَقٍ","وَبِكَفِّيَ مِنكَ مِن نِعَمِ",75,"م",1,0],["كَم بِلاد تَهزكم لَيسَ فيها","لَكُمُ جيرة وَلا إِخوان",76,"ن",1,0],["كَم بَينَ بَدرٍ وَالعَقَن","قَلِ مِن مَرازبَةٍ جَحاجِح",77,"ح",1,0],["كَم بِهِ مِن مَكءِ وَحشِيَّةٍ","قيضَ في مُنتَثَلٍ أَو شِيام",78,"م",1,0],["كَم بِالحَرامِ وَلَو كُنّا نُجامِلُهُ","مِن كاشِحٍ وَدَّ أَنّا لا نُرى أَبَدا",79,"د",2,0],["كمْ بَيْنَ جِسْمٍ عَدَّلَتْ حَرَكَاته","رُوحٌ وَعُودٍ مَيَّلَتْهُ الرِّيحُ",80,"ح",1,0],["كَمْ بَيْنَ ضِكْرِ الصَّاحِبِ بنِ مَحَمَّدٍ","فينا وذِكْرِ أُولئكَ الأقوامِ",81,"م",1,0],["كَم بَينَ مَن يَشتَري خَمراً يَلَذُّ بِها","وَبَينَ باكٍ عَلى نُؤيٍ وَمُنتَضَدِ",82,"د",1,0],["كَم بَينَ فَضلٍ مُنذُ هاجَيتُهُ","وَبَينَهُ قَبلَ أُهاجيهِ",83,"ي",2,0],["كم بين ناعتِ خمرِ في دساكرهِ","وبين باكٍ عل نوءٍ ومنتضدِ",84,"د",1,0],["كَم بَكَّتَ المَوتُ الحَريصَ عَلى الَّذي","يَأتي فَسَحَّت مُقلَتاهُ وَبَكَّتا",85,"ت",2,0],["كَم بِالسَماوَةِ مِن صِلٍّ وَمِن أَسَدٍ","كِلاهُما خُصَّ في شِدقٍ بِتَهريبِ",86,"ب",1,0],["كَم بِالمَدينَةِ مِن غَريبٍ نازِلٍ","لا ضابِئٌ مِنهُم وَلا قَيّارُ",87,"ر",1,1],["كَم بادَ في حَدَثانِ لِلدَهرِ مِن مَلَإٍ","وَسادَ في دُوَلِ الأَيّامِ مِن قُزُمِ",88,"م",1,1],["كم باتَ حوْلَكِ من ريمٍ وجازِيَةٍ","يَستَجدِيانِكِ حُسْنَ الدّلّ والحَوَرِ",89,"ر",1,0],["كم باتَ طَوْعَ يدي والوصلُ يجمعُنا","في بُرْدَتَيْهِ التّقى لا نعرِفُ الدّنَسا",90,"س",2,0],["كم بأحشاء الليل ينبض قلب","فهو يَبدو ككوكب وقاد",91,"د",1,0],["كم بالجزيرة لو يتاح لي الهوى","من غادة تحكي بطلعتها القمر",92,"ر",1,0],["كم بثّ من أنّةٍ وألقى","بهمسةٍ ضائعٌ صداها",93,"ه",2,0],["كم بمَكَرّ الظّعان تَحْبِسُها","وكم وراء العَدُوّ تطْرُدُها",94,"د",3,0],["كم بَلْدَةٍ فارَقْتُها ومَعاشِرٍ","يُذْرُونَ من أسَفٍ علَيّ دُمُوعا",95,"ع",2,1],["كم بنينا من حصاها أربعا","وانثنينا فمحونا الأربعا",96,"ع",2,0],["كَمْ بَيْنَ مُنْتَدِبٍ يَدْعُو لِمَكْرُمَةٍ","وَبَيْنَ مُعْتَكِفٍ يَبْكِي عَلَى طَلَلِ",97,"ل",1,0],["كَمْ بَيْنَ عَادِيٍّ تَمَلَّى عُمْرَهُ","حِقَباً وَبَيْنَ حَدِيثَةِ الْمِيلادِ",98,"د",1,0],["كَمْ بَاتَ مُلْتَاعٌ تَسُحُّ دُموعُهُ","حُزْناً عَلَيْكَ وَفِي حَشَاهُ حُرُوقُ",99,"ق",1,0],["كَمْ بَطَلٍ عَاشَ وَهْوَ ذُو صَيَدٍ","فَرَدَّهُ الثُكْلُ غَيْرَ ذِي صَيَد",100,"د",1,0],["كَمْ بكَاهُ فِي كل مَعهَدِ إِحْسَا","ن عَلِيلٌ وَعَاجِزٌ وَفَقِيرُ",101,"ر",1,0],["كَمْ بَطَلٍ أَمْسى وَلَمْ يَسْمُرِ","تَحْتَ هِلالِ الرَّحْمةِ الأَحّمَرِ",102,"ر",1,1],["كمْ بِتَّ أَسْتَشْفِعُ مِنْهَا لَهَا","وَنوْمُهَا مِنْ رَيْبِهِ مُسْهِرِي",102,"ر",2,0],["كَمْ بَاتَ يَشْهَدُهَا وَقَدْ","شَفَّتْ لَهُ عَنْهَا الغُيُوبُ",103,"ب",1,0],["كَمْ بِتَّ فِي سُهْدٍ وَأَنْتَ","لِغَايَةٍ شَقَّتْ طَلُوبُ",103,"ب",1,0],["كَمْ بَاهِلٍ مُتحَيِّرٍ فِي أَمْرِهِ","بِهُدَاك عَادَ وَليْسَ بِالمُتحَيِّرِ",104,"ر",1,0],["كَم بَصيرٍ ضَلَّ في غَيرِ الدُجى","وَثَبوتٍ زَلَّ في غَيرِ الزَلَق",105,"ق",1,0],["كم ببطين الأرض ثاوٍ","من شريفٍ ووزيرِ",106,"ر",1,0],["كَمْ بلغْنا ما أَردْنَا","من صلاح النفسِ في رفقٍ ولينْ",107,"ن",1,0],["كم بَسْمَةٍ أرسلَها مُحْسنٌ","أزْهَى من الروْضِ ومن زَهْرِه",108,"ر",2,0],["كَمْ بُعُوثٍ للغَرْبِ بَعْدَ بُعُوثٍ","وَوُفُودٍ للشرقِ بَعْدَ وُفودِ",109,"د",1,0],["كم بسطنا الأكُفَّ نَضْرَعُ لِلرَحْمنِ","والليلُ مُسْبِلُ الأسْدال",110,"ل",1,0],["كم بكتْ أُمُّها عليها فما أغْ","نَى نُواحٌ ولا التحسُّرُ أجْدَى",111,"د",2,0],["كم باسمها نشر العلو","مَ، وأَسَّسَ العَرَبُ الحواضر",112,"ر",1,0],["كم بالمدينةِ من غريبٍ نازِلٍ","، لا ضابىءٌ منهمْ، ولا قيّارُ",113,"ر",1,1],["كم بالسّماوة من صِلٍّ ومن أسدٍ،","كلاهما خُصّ في شِدْقٍ بتهْريت",114,"ت",1,0],["كمْ بهِ منْ مكِ وحشيَّة","ٍ قيضَ في منتثلٍ أوْ شيامْ",115,"م",1,0],["كم بطفل فجعت أما رؤوما","وفجعت الأبناء بالأمهات",116,"ت",1,0],["كم بات ذا الحمق خلوا في مضاجعه","وبات ذو العقل فيها كاسف البال",117,"ل",1,0],["كمْ بينَ دائرة ٍ أقوتْ معالمها","وَبَيْنَ عَامِرَة ٍ تَزْهُو بِمَنْ فِيهَا؟",118,"ي",3,0]]}