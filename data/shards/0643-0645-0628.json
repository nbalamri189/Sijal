يف"],[500,"ما على عاشق الحبيب ملامة","https://www.aldiwan.net/poem37642.html","الخفيف"],[500,"كم نشرنا من طامس وطوينا","https://www.aldiwan.net/poem37722.html","الخفيف"],[500,"كيف لا أندب الطلول غراما","https://www.aldiwan.net/poem37782.html","الخفيف"],[500,"قل لمستصغرنا عن حسد","https://www.aldiwan.net/poem38008.html","الرمل"],[514,"حتام أسألها الدنو فتنزح","https://www.aldiwan.net/poem20804.html","الكامل"],[514,"قد براها للسرى جذب براها","https://www.aldiwan.net/poem20825.html","الرمل"],[516,"ليس السواد ناقصي ما دام لي","https://www.aldiwan.net/poem48709.html","الكامل"],[529,"وإذا دهتك وساوس أو حيرة","https://www.aldiwan.net/poem37123.html","الكامل"],[529,"قلب تقلب في فنون","https://www.aldiwan.net/poem37273.html","مجزوء الكامل"],[529,"بدر بأفلاك البلاغة طالع","https://www.aldiwan.net/poem37341.html","الكامل"],[538,"قد أثرتم لواعجا وشجونا","https://www.aldiwan.net/poem47587.html","عموديه"],[538,"ألشمس من ألم النوى مصفرة","https://www.aldiwan.net/poem47948.html","عموديه"],[538,"شرط العظيم وصفه بالمهتدي","https://www.aldiwan.net/poem48235.html","عموديه"],[541,"كم باكياتٍ تُرى يرثين في أسدٍ","https://www.aldiwan.net/poem682.html",""],[551,"أيها اللائم الذي لا يمل اللوم","https://www.aldiwan.net/poem47139.html","الخفيف"],[551,"رضيت بالدون لما لم أجد وزرا","https://www.aldiwan.net/poem47161.html","البسيط"],[551,"صمت العواذل في أساك وسلموا","https://www.aldiwan.net/poem47242.html","الكامل"],[551,"من أين زرت خيال ذات البرقع","https://www.aldiwan.net/poem47707.html","الكامل"],[551,"أما الحبيب فقد فزنا بزورته","https://www.aldiwan.net/poem47760.html","البسيط"],[553,"طيف الخيال حمدنا منك إلماما","https://www.aldiwan.net/poem68427.html","البسيط"],[558,"إن أحبابنا وهم سادة الحي","https://www.aldiwan.net/poem34214.html","الخفيف"],[558,"قطع الجهول زمانه بتغزل","https://www.aldiwan.net/poem34311.html","الكامل"],[558,"أنا كلي منك إنعام وجود","https://www.aldiwan.net/poem34607.html","الخفيف"],[562,"وردا على الخد لا وردا ببستان","https://www.aldiwan.net/poem52759.html","البسيط"],[562,"ويلاه من عرس تحول مأتما","https://www.aldiwan.net/poem52772.html","الكامل"],[562,"من كان كاتب نون هذا الحاجب","https://www.aldiwan.net/poem52841.html","الكامل"],[567,"يا من لأجفان قريحه","https://www.aldiwan.net/poem69759.html","مجزوء الرجز"],[575,"يا معرضاً قد آن أن تقبلا","https://www.aldiwan.net/poem2887.html","السريع"],[586,"قد مال سمعي إلى عذاله فيكا","https://www.aldiwan.net/poem17635.html","البسيط"],[586,"وذي ثنايا لم تدع عاشقا","https://www.aldiwan.net/poem17776.html","السريع"],[586,"حي غزالا سل من أجفانه","https://www.aldiwan.net/poem17822.html","الرجز"]],"verses":[["كَم باعِ أَبّاءٍ تَفُلَّ بُطونُها","وَأَديمِ جَبّارٍ يَقُدُّ أَديمُها",0,"م",3,0],["كَم باتَ رَبّاءً لِسَيّارَةٍ","طارِقَةٍ غَيرَ أَوانِ الطُروق",1,"ق",1,0],["كَم بَينَ أَثناءِ الضَلوعِ لَهُنَّ مِن","قِرفٍ بِأَظفارِ النَوى مَقروفَ",2,"ف",1,0],["كَم باتَ في لَهَواتِ اللَيلِ تَعرُكُهُ","ما بَينَ أَكوارِها المَهرِيَّةُ الصُعُرُ",3,"ر",1,0],["كَم بَينَ أَيديكُم وَبَي","نَ النَجمِ مِن قُربٍ وَبُعدِ",4,"د",1,0],["كَم بانَ في المُتَحَمِّلينَ عَشِيَّةً","مِن ذي لَمىً خِصرِ الرَضابِ بَرودِ",5,"د",1,0],["كم بكت عيناك لمّا رأتا","بصري يطفا ويطوي في الحجاب",6,"ب",1,0],["كَم بِمِصرٍ زَفرَةٌ مِن حَرِّها","كُنِسَ الأَعفَرُ وَالطَيرُ وَكَر",7,"ر",1,0],["كَم بِها والِدَةٍ والِهَةٍ","عَضَّها الثُكلُ بِنابٍ فَعَقَر",7,"ر",1,0],["كَم بَغَت دَولَةٌ عَلَيَّ وَجارَت","ثُمَّ زالَت وَتِلكَ عُقبى التَعَدّي",8,"ي",1,0],["كَم بالَةٍ سَبَّبَت وَبالا","وَأَشبَهَت لامِعَ السَرابِ",9,"ب",1,0],["كَم باتَ يَلتَحِمُ العُرو","ضَ وَجاءَ بِالأَمرِ الفَري",10,"ر",2,0],["كَم باتَ يُلهيني بِها مَصنوعَةُ ال","أَلحانِ أَو مَطبوعَةُ الأَسجاعِ",11,"ع",1,0],["كَم باتَ يَدري لَيلَهُ الغِربيبا","لَمّا اِنثَنى في سُكرِهِ قَضيبا",12,"ب",2,0],["كَمْ بِيعَةٍ قَدِمَتْ عَهْداً فَجَدَّدَهَا","وَبِيعَةٍ شَادَهَا مَرْفُوعَةَ القِبَبِ",13,"ب",1,0],["كَمْ بَنَتْ مَأْوىً وَشَادَتْ مَلْجَأً","لِلأَيَامَى وَاليَتَامَى البَائِسِينْ",14,"ن",1,0],["كَمْ بَدَتْ مِنْكَ بَادِرَاتُ نُبُوغٍ","حَيَّرَتْ بِابْتِكَارِهَا الأَحْلامَا",15,"م",2,0],["كم بلدةٍ للكفر قد عوّضت من","ناقوسها التكبيرَ والتهليلا",16,"ل",2,0],["كم بلّ نائرةً فأطفأ نارها","من بين مشتبك الصوارم والقنا",17,"ن",2,0],["كم بِتَّ معتلج الهموم بليلة","ما للظلام بفجرها تقويض",18,"ض",1,0],["كم بأرض البلقان منكم قتيِل","وأيامي مضاعة ويتامى",19,"م",2,0],["كم بات ذو الحُمق خِلواً في مضاجعه","وبات ذو العقل فيها كاسِف البال",20,"ل",1,0],["كم بات سهران في تحقيق منيته","وفي الأمانيّ ما يستوجب السهرا",21,"ر",2,0],["كَم بِالمَواسِمِ مِن شَعثاءَ أَرمَلَةٍ","وَمِن يَتيمٍ ضَعيفِ الصَوتِ وَالنَظَرِ",22,"ر",1,0],["كم بسطتْ راحتاهُ من أمل","ونفستْ بالجميلِ من كربه",23,"ب",2,0],["كم بين أبيات أمداحِي له شيمٌ","كأنَّهنَّ نجومٌ بين أبراج",24,"ج",1,0],["كم بشر بالثلج لما غدا","كالحجرِ المطروحِ قبل المسخّ",25,"خ",1,0],["كم بعثنا إلى الدواوين طرساً","خائباً كاده الزمان فكدا",26,"د",2,0],["كم باب نصرٍ وكم باباً إلى فرجٍ","فتحت يا فائزَ المسعى وظافرَه",27,"ر",2,0],["كم بيمناه قصة قد أجيبت","وسؤولٌ بها أجيب سؤاله",28,"ل",2,0],["كم بيت مدح قلت فيك لنظمه","يا بيت عاتكة الذي أتغزّل",29,"ل",1,0],["كم بُلغةٍ ما دونها بُلغةٌ","قد نافرَتْني إذ تألَّفْتُها",30,"ت",3,0],["كم بِتَّ بين أيورهم مُتقسَّماً","حتى كأنك بينها ميراثُ",31,"ث",1,0],["كم بغوْر الشَّآم غادرتُ منهمْ","غَائراً مُوفياً على أهل نجدِ",32,"د",1,1],["كم بها سرباً من الوح","شِ كحيلاً باحورار",33,"ر",1,0],["كم بها سرباً من الإن","س له فيها تباري",33,"ر",2,0],["كم بها من صُدُغ أسْ","وَدَ معشوقِ المَدار",33,"ر",1,0],["كم بها من شاربٍ أخ","ضرَ حلو المُسْتدار",33,"ر",1,0],["كمبغض أمرٍ غامسٍ فيه نفسَه","وقد كان عنه في ذَرى المنظر العالي",34,"ل",2,0],["كم بين وسواس الحُلِي","يِ وبينَ وسواسِ الهمومِ",35,"م",1,0],["كم بدا في الكتاب لي من ضياءٍ","كان مِنْ قبلُ دونه كالقَتام",36,"م",1,0],["كم بكَّتوني وعيَّروا أدبي","لمّا جفاني مَحلُّ إعظامي",37,"م",2,0],["كَم بَِلجَزيرَةِ لَو يُتاحُ لِيَ الهَوى","مِن غادَةٍ تَحكي بِطُلعَتِها القَمَر",38,"ر",1,0],["كَم بِنا صَباً عَليلا","لا يُداويهِ سِواك",39,"ك",1,0],["كَم بَدا البَدرُ ضَحوكا","راقِصاً فَوقَ الكُروم",39,"م",1,0],["كَم بَينَ طَيّاتِ العُصورِ الخالِيَه","عِظَةٍ لِأَبناءِ الدُهورِ الآتِيَه",40,"ي",2,1],["كَم بِها قَد مَرَّ لي أَس","تَغفِرُ اللَهَ سُرورُ",41,"ر",1,0],["كمْ بقلبِ الظَّلامِ مِنْ أنَّةٍ","تهفو بغصَّاتِ صِبْيَةٍ أَيتامِ",42,"م",1,0],["كَم بِتُّ مِنكُم بَينَ غُصنَي بانَةٍ","كالسَيف تَضغَطُ مَتنَهُ الأَغمادُ",43,"د",1,0],["كم به من قصائد","كل ابياتها غرر",44,"ر",1,0],["كم بهذا الفضاء من","سعة تدهش الفكر",44,"ر",1,0],["كم بك الدهر تمخض","حتى نجلك",45,"ك",1,0],["كم بدور ودّعت يوم النوى","وشموس شيعت يوم الرحيل",46,"ل",1,0],["كم بيوت ضاقت الدنيا بها","بعدما عزت على طول السنين",47,"ن",1,0],["كَمُبصِرٍ أَدارَ عَي","ناً في الدُجى وَقَلَّبا",48,"ب",2,0],["كَم باتَ يَذبَحُ صَدرَهُ لِشَكاتِهِ","أَتُراهُ يَحسَبُها مِنَ الأَضيافِ",49,"ف",1,0],["كَم بِنتِ فيهِ وَكَم خَفيتِ كَأَنَّهُ","ثَوبُ المُمَثِّلِ أَو لِباسُ المَرفَعِ",50,"ع",1,0],["كم بينَ طرَّةِ شادنِ قد صُفِّفَتْ","وتَصفُّفِ الأقرانِ يومَ طِعَانِ",51,"ن",1,0],["كَم بَثَّ في حاضِرِ النَهرَينِ مِن نَفَلٍ","مُلقىً عَلى حاضِرِ النَهرَينِ مَصبوبِ",52,"ب",1,0],["كَم بِالكَثيبِ مِنِ اِعتِراضِ كَثيبِ","وَقَوامِ غُصنٍ في الثِيابِ رَطيبِ",53,"ب",1,1],["كَم بُكِّتوا بِصَنيعَةٍ مِن طَولِهِ","تُخزى وُجوهُهُم بِها وَتُشاهُ",54,"ا",2,0],["كم بينَ تلك السُّجوفِ من مُقَلٍ","تَبْذُلُ من دَمعِها الذي تَجدُه",55,"د",2,0],["كَم بَينَ مَن أَقسَمَ اللَهُ العَلِيُّ بِهِ","وَبَينَ مَن جاءَ بِاِسمِ اللَهِ في القَسَمِ",56,"م",1,0],["كَم بَينَ خَمرٍ يَخافُ الحَدَّ شارِبُها","وَخَمرَةٍ ما عَلى شُرّابِها باسُ",57,"س",1,0],["كَم بِها مِن بَديعِ زَهرٍ أَنيقٍ","كَفُصولٍ مَنظومَةٍ وَعُقودِ",58,"د",1,0],["كَم بَنَت بِالفِكرِ بَيتَ مَعانٍ","وَاِنثَنَت بِالذِكرِ بَيتَ مَعالي",59,"ي",1,0],["كَم بِدَرٍ أَعطى الوُفودَ وَلُهىً","وَكانَ يُرضيهِم كَفافاً وَلُهَن",60,"ن",1,0],["كم بتُّ منتبهاً أصغي لخطوته","أراه في الوهم أحياناً وأسمعُه",61,"ع",2,0],["كم به من سوانحٍ في المغاني","آمناتٍ من نبأةِ الخوفِ ترتَع",62,"ع",1,0],["كم بأرْضِ الشرك من معمورةٍ","أصبحت في غَزْوِهِ وهي يَبَاب",63,"ب",1,0],["كَم بِتَّ تَأخُذُها وَباتَ مُنادِمٌ","لَكَ وَهوَ يَأخُذُ مِنكَ ما لا يَترُكُ",64,"ك",1,0],["كَم بَينَ قَومٍ إِنَّما نَفَقاتُهُم","مالٌ وَقَومٍ يُنفِقونَ نُفوسا",65,"س",2,0],["كَم بَينَ حيطانِها مِن فارِسٍ بَطَلٍ","قاني الذَوائِبِ مِن آني دَمٍ سَرَبِ",66,"ب",1,0],["كَمْ بَيْنَ دَاثِرَةٍ أَقْوَتْ مَعَالِمُهَا","وَبَيْنَ عَامِرَةٍ تَزْهُو بِمَنْ فِيهَا",67,"ي",3,0],["كَمْ بَيْنَ شَرٍّ ظَاهِرٍ مُسْتَدْرَكٍ","مِنْهُ الْخَلاصُ وَبَيْنَ شَرٍّ بَاطِنِ",68,"ن",1,0],["كَمْ بَيْنَ مَا تَلْفِظُ الأَسْيَافُ مِنْ عَلَقٍ","وَبَيْنَ مَا تَنْفُثُ الأَقْلامُ مِنْ حِكَمِ",69,"م",1,0],["كم باذلٍ في منصبٍ مالَهُ","ماتَ وما هُنِّيَ بالمنصبِ",70,"ب",1,0],["كم بكيتمْ إذْ أصبحَ الماءُ غوراً","فاضحكوا حيثُ أصبحَ الغورُ ماءَ",71,"ا",2,0],["كم بدا لي فيهِ بدرٌ طالعٌ","وتثنى فيهِ غصنٌ أهيفُ",72,"ف",1,0],["كمْ بمصرٍ من وجوهٍ","نَفَضَ النيلُ عليها",73,"ه",2,0],["كَم بِالحَرامِ وَلَو كُنّا نُحالِفُهُ","مِن كاشِحٍ وَدَّ أَنّا لا نُرى أَبَدا",74,"د",2,0],["كَم بِصَدرِيَ فيكَ مِن حُرَقٍ","وَبِكَفِّيَ مِنكَ مِن نِعَمِ",75,"م",1,0],["كَم بِلاد تَهزكم لَيسَ فيها","لَكُمُ جيرة وَلا إِخوان",76,"ن",1,0],["كَم بَينَ بَدرٍ وَالعَقَن","قَلِ مِن مَرازبَةٍ جَحاجِح",77,"ح",1,0],["كَم بِهِ مِن مَكءِ وَحشِيَّةٍ","قيضَ في مُنتَثَلٍ أَو شِيام",78,"م",1,0],["كَم بِالحَرامِ وَلَو كُنّا نُجامِلُهُ","مِن كاشِحٍ وَدَّ أَنّا لا نُرى أَبَدا",79,"د",2,0],["كمْ بَيْنَ جِسْمٍ عَدَّلَتْ حَرَكَاته","رُوحٌ وَعُودٍ مَيَّلَتْهُ الرِّيحُ",80,"ح",1,0],["كَمْ بَيْنَ ضِكْرِ الصَّاحِبِ بنِ مَحَمَّدٍ","فينا وذِكْرِ أُولئكَ الأقوامِ",81,"م",1,0],["كَم بَينَ مَن يَشتَري خَمراً يَلَذُّ بِها","وَبَينَ باكٍ عَلى نُؤيٍ وَمُنتَضَدِ",82,"د",1,0],["كَم بَينَ فَضلٍ مُنذُ هاجَيتُهُ","وَبَينَهُ قَبلَ أُهاجيهِ",83,"ي",2,0],["كم بين ناعتِ خمرِ في دساكرهِ","وبين باكٍ عل نوءٍ ومنتضدِ",84,"د",1,0],["كَم بَكَّتَ المَوتُ الحَريصَ عَلى الَّذي","يَأتي فَسَحَّت مُقلَتاهُ وَبَكَّتا",85,"ت",2,0],["كَم بِالسَماوَةِ مِن صِلٍّ وَمِن أَسَدٍ","كِلاهُما خُصَّ في شِدقٍ بِتَهريبِ",86,"ب",1,0],["كَم بِالمَدينَةِ مِن غَريبٍ نازِلٍ","لا ضابِئٌ مِنهُم وَلا قَيّارُ",87,"ر",1,1],["كَم بادَ في حَدَثانِ لِلدَهرِ مِن مَلَإٍ","وَسادَ في دُوَلِ الأَيّامِ مِن قُزُمِ",88,"م",1,1],["كم باتَ حوْلَكِ من ريمٍ وجازِيَةٍ","يَستَجد