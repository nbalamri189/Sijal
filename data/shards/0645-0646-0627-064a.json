امل"],[513,"أمالي من عذولكم عذير","https://www.aldiwan.net/poem12131.html","الوافر"],[536,"حدثوا عن خائن","https://www.aldiwan.net/poem48300.html","عموديه"],[549,"من أين لي معد على الأيام","https://www.aldiwan.net/poem47204.html","الكامل"],[549,"ما صيد قلبك إلا بابنة الكلل","https://www.aldiwan.net/poem47265.html","البسيط"],[549,"إن العقيق يزيدني خبلا","https://www.aldiwan.net/poem47321.html","أحذ الكامل"],[549,"قل للذين تناكصت ثقتي","https://www.aldiwan.net/poem47331.html","أحذ الكامل"],[549,"من أين زرت خيال ذات البرقع","https://www.aldiwan.net/poem47707.html","الكامل"],[549,"لا تسأل المرء ما تجني عشيرته","https://www.aldiwan.net/poem47764.html","البسيط"],[549,"أنجد إذا شئت في الأرزاق أو أغر","https://www.aldiwan.net/poem47787.html","البسيط"],[549,"كم ذا سرى بالموت عنا مدلج","https://www.aldiwan.net/poem48018.html","الكامل"],[549,"زعازع ثم نكب","https://www.aldiwan.net/poem48102.html","الطويل"],[556,"من أين للسعد ما ندري وللرازي","https://www.aldiwan.net/poem34456.html","البسيط"],[556,"هذا الوجود وهذا الواحد الأحد","https://www.aldiwan.net/poem34575.html","البسيط"],[565,"من أين يفرغ أو يأوي لنا فلك","https://www.aldiwan.net/poem69538.html","الطويل"],[565,"أي أب رزيته","https://www.aldiwan.net/poem69562.html","مجزوء الرجز"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[584,"لا عذر للصب إن لم يألف التلفا","https://www.aldiwan.net/poem17604.html","البسيط"]],"verses":[["مِن أَيِّ خَطبٍ مِن خُطوبِكِ أَشتَكي","وَعَنَ اَيِّ ذَنبٍ مِن ذُنوبِكِ أَصفَحُ",0,"ح",1,0],["مِنَ اَيِّ الثَنايا طالَعَتنا النَوائِبُ","وَأَيُّ حِمىً مِنّا رَعَتهُ المَصائِبُ",1,"ب",1,1],["مِنْ أَيِّ أَقْطارِهِ أَتَيْتَ ثَنى","إِلَيْكَ أَعْطافَهُ مِنَ الكَرَمِ",2,"م",1,0],["مِن أَينَ تَدري الدارُ أَنَّكَ عاشِقٌ","أَو عِندَها خَبَرٌ بِأَنَّكَ مُبتَلى",3,"ل",2,0],["مِن أَينَ أَبغي دَواءَ ما بي","وَإِنَّما دائِيَ الطَبيبُ",4,"ب",1,0],["مِنّا يُغافِصنَهُ لَو كانَ يَمنَعُهُ","بَأسٌ لَصادَفَنا حَيّاً أُلي باسِ",5,"س",1,0],["مَنْ آيَةِ النُّورِ وَلأْلاَتِهَا","يَا أَسَفَاً أَنْ دَالَ هَذَا الظَّلامْ",6,"م",1,0],["مِن أَيِّ ثَنِيَّةٍ طَلَعَت قُرَيشٌ","وَكانوا مَعشَراً مُتَنَبِّطينا",7,"ن",2,0],["من أين للشمس نطق كله حكم","يفيدها كلَّ حين منك مُبديها",8,"ي",3,0],["من أين للشمس المنيرة منطق","ببيانه دُرُّ الكلام يُفصّلُ",9,"ل",1,0],["من أين للبدر المنير شمائلٌ","تسري بريّاها الصِّبا والشَّمالُ",9,"ل",1,0],["من أين للبدر المنير مناقبٌ","بجهادها تُنضى المطيُّ الذُلَّلُ",9,"ل",1,0],["من أين كانت مصر في أقباطها","كمواطن الأعراب في أعرابها",10,"ب",3,0],["من أين يُرجى للعراق تقدّم","وسبيل مُمتلِكيه غيرُ سبيله",11,"ل",2,0],["من أيّ وجه تبتغي رزقها","وطرقها بالجهل مستَبْهِمه",12,"م",2,0],["من أين يَنهض قائماً مَن نصفه","يشكو السقام بفالِج ُمتَوَصِّبا",13,"ب",2,0],["من أين من أين يا ابتدائي","ثم إلى أين يا انتهائي",14,"ا",2,1],["مَنأى الفَرورِ فَما يَأتي المُريدَ وَما","يَسلو الصُدودَ إِذا ما كانَ يَقتَدِرُ",15,"ر",1,0],["مِن أَينَ لِلرَشا الغَريرِ الأَحوَرِ","في الخَدِّ مِثلُ عِذارِهِ المُتَحَدِّرِ",16,"ر",1,1],["من أينَ للقومِ الأولى قوَّضوا","كذهنكَ المقتدح الممترخ",17,"خ",1,0],["من أين للآمالِ مثلك كافلٌ","أم أين للأحوالِ غيرك كاف",18,"ف",1,0],["من أين للآمال مثل مقامه","ألروض أفيح والغمائم هتن",19,"ن",1,0],["من أين لليل أصداغٌ معقربة","تردِي النفوس وتحييهنَّ أحيانا",20,"ن",2,0],["من أياديهِ قاسمٌ حسْبُ مَنْ عد","دَ بذاك المعْدُودِ من مَعْدُودِ",21,"د",1,0],["من أياديك التي لو جُحدَتْ","مرةً قام لها منْهُ شُهودُ",22,"د",1,0],["مَنايا يُقَرِّبنَ الحُتوفَ لِأَهلِها","جِهاراً وَيَستَمتِعنَ بِالأَنَسِ الجَبلِ",23,"ل",1,0],["مِن أَينَ جِئتَ وَكَيفَ عَجتَ بِبابي","يا مَوكِبَ الأَجيالِ وَالأَحقابِ",24,"ب",1,1],["مِن أَينَ قُدِّرَ الفِراقُ لَنا","لَم يَجرِ في خَلَدي وَلا وَهمي",25,"ي",1,0],["مِن أَينَ أَنتَ وَهَذا الشَيءَ تَذكُرُهُ","أَراكَ تَقرَعُ باباً عَنكَ مَسدودا",26,"د",2,0],["من أين قد جلب الزمان خميرتي","أو أين قد جبل الزمان جلافي",27,"ي",1,0],["من اين قد جاءك هذا","الحول والتحكم",28,"م",1,0],["مِن أَيِّ عَهدٍ في القُرى تَتَدَفَّقُ","وَبِأَيِّ كَفٍّ في المَدائِنِ تُغدِقُ",29,"ق",1,1],["مَنايا أَبى اللَهُ إِذ ساوَرَتكَ","فَلَم يَلقَ نابَيهِ ثُعبا