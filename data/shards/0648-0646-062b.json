{"poems":[[55,"لكل مجتهد حظ من الطلب","https://www.aldiwan.net/poem30753.html","البسيط"],[88,"وقف الخلق ينظرون جميعاً","https://www.aldiwan.net/poem10675.html","الخفيف"],[73,"جعل العتاب إلى الصدود توصلا","https://www.aldiwan.net/poem4030.html","الكامل"],[95,"ألشرق طال سباته الروحاني","https://www.aldiwan.net/poem11226.html","الكامل"],[95,"يا رئيسي وأوليائي وآلي","https://www.aldiwan.net/poem11467.html","الخفيف"],[32,"أراح فريق جيرتك الجمالا","https://www.aldiwan.net/poem29550.html","الوافر"],[74,"مدمع سائل لغير رحيم","https://www.aldiwan.net/poem19679.html","الخفيف"],[53,"إنما يبكي شجي شجنه","https://www.aldiwan.net/poem66464.html","الرمل"],[94,"نحن نمشي وحولنا هاته الأك","https://www.aldiwan.net/poem38888.html","الخفيف"],[94,"اسكني يا جراح","https://www.aldiwan.net/poem38902.html","مجزوء المتدارك"],[87,"قم سابق الساعة واسبق وعدها","https://www.aldiwan.net/poem62977.html","الرجز"],[50,"تذكر أمير الله والعهد يذكر","https://www.aldiwan.net/poem63364.html","الطويل"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141998","الخفيف"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43785","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54244","الكامل"],[111,"أبلغ إليك رسالة","https://www.poetsgate.com/ViewPoem.aspx?id=536",""],[92,"أخي جعفر","https://www.poetsgate.com/ViewPoem.aspx?id=179226",""],[96,"إيه حكيم الدّهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66311&r=&rc=29",""],[136,"جعلت بيننا الرباب النمو ما","https://www.aldiwan.net/poem54747.html","الخفيف"],[173,"قم فاشدد العيس للترحال معتزماً","https://www.aldiwan.net/poem1675.html",""],[197,"صدف الحبيب بوصله","https://www.aldiwan.net/poem13076.html","مجزوء الكامل"],[226,"أشكو لهيب الأسى لموقده","https://www.aldiwan.net/poem55407.html","المنسرح"],[239,"هل أنت يا أخت القضيب الناضر","https://www.aldiwan.net/poem31983.html","الرجز"],[241,"صلاة السميع العليم","https://www.aldiwan.net/poem19788.html","المتقارب"],[274,"هربت إلى حجر اليقين من الشك","https://www.aldiwan.net/poem35234.html","الطويل"],[274,"بما فيه سعد الجاهلين شقيت","https://www.aldiwan.net/poem35604.html","الطويل"],[274,"تصبته ريحا شمأل وجنوب","https://www.aldiwan.net/poem35639.html","الطويل"],[274,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[384,"من منصفي من مفرق في عنفه","https://www.aldiwan.net/poem48821.html","الكامل"],[406,"فراقكم هاج اشتياقي وأشجاني","https://www.aldiwan.net/poem46756.html","الطويل"],[409,"صدف الحبيب بوصله","https://www.aldiwan.net/poem49841.html","مجزوء الكامل"],[410,"إن الحمول غداة غربة غرب","https://www.aldiwan.net/poem50208.html","الكامل"],[420,"متى يشتفي كبد مؤلم","https://www.aldiwan.net/poem53957.html","المتقارب"],[420,"متى يشتفي هذا الفؤاد المتيم","https://www.aldiwan.net/poem54074.html","الطويل"],[517,"مضى خلف الأبرار والسيد الطهر","https://www.aldiwan.net/poem20839.html","الطويل"],[518,"شكا ألم التوديع وهو أليم","https://www.aldiwan.net/poem12252.html","الطويل"],[554,"هل ليالي بالمنقى رجوع","https://www.aldiwan.net/poem47718.html","الخفيف"]],"verses":[["وَنَثرَةٌ فَوقَها صَبرٌ تُظاهِرُهُ","أَرَدُّ مِنها لِأَذرابِ القَنا السَلَبِ",0,"ب",1,0],["وَنُثيرُ الفَوضى عَلى جانِبَيهِ","فَيُعيدُ الجَهولُ فيها وَيُبدي",1,"د",2,0],["وَنَثَرتَ بِالبيضِ المُهَنَّدَةِ الطُلى","وَنَظَمتَ بِالسُمرِ المُثَقَّفَةِ الكُلى",2,"ل",2,0],["وَنَثَرْتَ بَيْنَ كِتَابَةٍ وَخَطَابَةٍ","مَا لا يَجُودُ بِدُرِّهِ البَحْرَانِ",3,"ن",1,0],["وَنَثَرْتَ النَّثْرَ البَدِيعَ بِمَا فَضْلُكَ","أُوْحَى وَإِنْ عَدَا اسْتِئْهَالِي",4,"ل",2,0],["وَنَثَرتُها وَجَبهَتُها هَراقَت","عَلَيهِ الماءَ فَاِكتَهَلَ اِكتِهالا",5,"ل",2,0],["ونثار من البكى مستفاض","في الهوى من لقاءِ ثغرٍ نظيم",6,"م",1,0],["ونثا قومٍ دُخانات الندى","ولقد أضحى نثاكم دُخنه",7,"ن",2,0],["ونَثَرْنا الأَحْلامَ والحبَّ والآلا","مَ واليأسَ والأَسى حيثُ شِينا",8,"ن",2,0],["ونثرتُ الدُّموعْ","لرِيَاحِ العَدَمْ",9,"م",1,0],["وَنَثَرَت فَوقَ الطَريقِ وَردَها","وَاِستَقبَلَت فُؤادَها وَوَفدَها",10,"د",3,0],["وَنَثري عَلَيكَ الدُرَّ يا دُرَّ هاشِمٍ","فَيا مَن رَأى دُرّاً عَلى الدُرِّ يُنثَرُ",11,"ر",1,0],["ونَثَرنَ الأزهار مما كسا الروضَ","ومما كسا القدود الرشاقا",12,"ق",2,0],["وَنَثرُ عَقيقٍ ذابَ فيهِ دِماؤُهُ","جَرى مِثلَ جَمعي ثُمَّ لَم يَتَوَقَّفِ",13,"ف",1,0],["ونَثرتُها دُرراً فودّتْ أنجمٌ","لو عَدّهُنَّ الحسنُ بين صِحاحهَا",14,"ح",3,0],["ونثرت عرضي في نوا","دي القوم تذروه الرياح",15,"ح",1,0],["ونَثَّرَ أضلاعها نَثْرةَ","شَتاتاً كما صُرّفَ الدرهم",16,"م",1,0],["ونثرت جوهر ثغرها من عقده","فصحاحه العطرات غير صحاح",17,"ح",1,0],["وَنَثَرنَ الدُّموعَ نَثرَ لآلٍ","يَتَحَدَّرنَ لُؤلُؤاً مَنظومَا",18,"م",2,0],["وَنَثرَةٍ أَخفَرَ الهِندِيُّ ذِمَّتَها","إِنَّ السُيُوفَ المَواضي تَخفِرُ الذِمما",19,"م",2,0],["وَنَثَرتُ لُؤلُؤَ عَبرَةٍ","أَضحى لَها جَفني صَدَف",20,"ف",1,0],["ونثرها في العقود منتظم","ونظمها فتنة لمنشده",21,"د",2,0],["وَنَثرَةٍ تِخالُها مِن رَأيِهِ","مُحكَمَةَ السَردِ وَطَرفٍ ضامِرِ",22,"ر",1,0],["وَنُثْبِتُ حِلْيَ الْبَدِيعْ","بِتِيجَانِ شَهْرِ رَبِيعْ",23,"ع",1,0],["ونثّرتِ منها الدمعَ حتى حَسبتُهُ","لآلئَ عقدٍ يَنتَثِرنَ عن السّلك",24,"ك",1,0],["ونثَّرتُ دَمعي في النّوى وقصائدي","وبالشعرِ والدّمعِ السخينِ شفيت",25,"ت",1,0],["ونثَّرَ آمالاً على كلِّ شاطئٍ","وسارَ كسيرَ القلبِ بينَ شُعوب",26,"ب",1,0],["ونثأرُ بَطّاشينَ بعد سُكوتِنا","وقد حرَّكَ التّذكارُ حِقداً مُدثَّرا",27,"ر",2,0],["وَنَثَرتُ دَمعي مِن تَذَكُر نَظمِهِ","وَجداً فَيُمسي كَالبِحار بِوَكفِهِ",28,"ف",2,0],["ونثراً كما رقَتْ كؤوس سلافةٍ","ونَظْماً كما راقْت قلائدُ عقْيانِ",29,"ن",1,0],["ونثَرتُ لؤلؤَ أَدْمُعٍ","أضحى لَها جَفني صَدَفْ",30,"ف",1,0],["ونثرنَ مِن صدفِ الجُفونِ لبيننا","درين بَينَ مضرَّس وَمُحَبَّبِ",31,"ب",1,0],["ونثرُكَ يُزري بعِقْد الجمان","فَدُرُّ المعاني بها تُنظم",32,"م",1,0],["ونثني عليك الخير في كل ساعةٍ","ونبتدئ الذكرَ الجميلَ ونختم",33,"م",1,0],["ونُثني عليها رغبةً في ثنائِها","ليَعبَقَ في الأفواهِ من طيبِها عِطْرُ",34,"ر",1,0],["ونثلم من بعد الثرى بطن راحة","أناملها فوق الغيوم غيوم",35,"م",1,0],["ونثاً لم يخُنْهُ فينا عيانٌ","وأُصولٌ ما كذّبتْها فُروعُ",36,"ع",1,0]]}