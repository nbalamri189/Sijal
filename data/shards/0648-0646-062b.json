031,"حب على ابواب الوطن المذبوح","https://www.poetsgate.com/ViewPoem.aspx?id=147674",""],[5038,"يا هاجرا","https://www.poetsgate.com/ViewPoem.aspx?id=188832",""],[5155,"حرب.... وانتصار","https://www.poetsgate.com/ViewPoem.aspx?id=176309",""],[5155,"يا دنيا ..!","https://www.poetsgate.com/ViewPoem.aspx?id=176238",""],[5190,"الكذبة الكبرى","https://www.poetsgate.com/ViewPoem.aspx?id=153355",""],[5302,"إلى الصقر الجريح .. وكفى","https://www.poetsgate.com/ViewPoem.aspx?id=200920",""],[5310,"مَعْبَدُ الْقَصِيْدَةِ","https://www.poetsgate.com/ViewPoem.aspx?id=211298",""],[5397,"جلى صباح الهدى للخطب جنح دجى","https://www.poetsgate.com/ViewPoem.aspx?id=157955",""],[5397,"زها زمنا روض الشبيبة مونقا","https://www.poetsgate.com/ViewPoem.aspx?id=157957",""],[5431,"كي لا تُداس وتُكسرا","https://www.poetsgate.com/ViewPoem.aspx?id=196669",""],[5431,"أهواك حيّا ..","https://www.poetsgate.com/ViewPoem.aspx?id=196754",""],[5447,"عكا، كنعان","https://www.poetsgate.com/ViewPoem.aspx?id=208334",""],[5451,"لكم مزماركم ولي مزماري","https://www.poetsgate.com/ViewPoem.aspx?id=155932",""],[5464,"أوصيك بي شراً اذا خنت الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=7560",""],[2229,"أُعِيدُُها هيفا بربّ الفَلَقِ","https://www.poetsgate.com/ViewPoem.aspx?id=49795",""],[5525,"هام القصايد","https://www.poetsgate.com/ViewPoem.aspx?id=30108",""],[349,"موقف","https://www.poetsgate.com/ViewPoem.aspx?id=146247",""],[5720,"لكَ أنتَ","https://www.poetsgate.com/ViewPoem.aspx?id=200979",""],[5815,"خَلَجات","https://www.poetsgate.com/ViewPoem.aspx?id=190305",""],[5859,"عودي","https://www.poetsgate.com/ViewPoem.aspx?id=29413",""],[5873,"روعة السحر","https://www.poetsgate.com/ViewPoem.aspx?id=215411",""],[5890,"درب الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=192584",""],[6273,"قواف ٍ في ركب السراة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78507&r=&rc=5",""]],"verses":[["وَنَثرَةٌ فَوقَها صَبرٌ تُظاهِرُهُ","أَرَدُّ مِنها لِأَذرابِ القَنا السَلَبِ",0,"ب",1,0],["وَنُثيرُ الفَوضى عَلى جانِبَيهِ","فَيُعيدُ الجَهولُ فيها وَيُبدي",1,"د",2,0],["وَنَثَرتَ بِالبيضِ المُهَنَّدَةِ الطُلى","وَنَظَمتَ بِالسُمرِ المُثَقَّفَةِ الكُلى",2,"ل",2,0],["وَنَثَرْتَ بَيْنَ كِتَابَةٍ وَخَطَابَةٍ","مَا لا يَجُودُ بِدُرِّهِ البَحْرَانِ",3,"ن",1,0],["وَنَثَرْتَ النَّثْرَ البَدِيعَ بِمَا فَضْلُكَ","أُوْحَى وَإِنْ عَدَا اسْتِئْهَالِي",4,"ل",2,0],["وَنَثَرتُها وَجَبهَتُها هَراقَت","عَلَيهِ الماءَ فَاِكتَهَلَ اِكتِهالا",5,"ل",2,0],["ونثار من البكى مستفاض","في الهوى من لقاءِ ثغرٍ نظيم",6,"م",1,0],["ونثا قومٍ دُخانات الندى","ولقد أضحى نثاكم دُخنه",7,"ن",2,0],["ونَثَرْنا الأَحْلامَ والحبَّ والآلا","مَ واليأسَ والأَسى حيثُ شِينا",8,"ن",2,0],["ونثرتُ الدُّموعْ","لرِيَاحِ العَدَمْ",9,"م",1,0],["وَنَثَرَت فَوقَ الطَريقِ وَردَها","وَاِستَقبَلَت فُؤادَها وَوَفدَها",10,"د",3,0],["وَنَثري عَلَيكَ الدُرَّ يا دُرَّ هاشِمٍ","فَيا مَن رَأى دُرّاً عَلى الدُرِّ يُنثَرُ",11,"ر",1,0],["ونَثَرنَ الأزهار مما كسا الروضَ","ومما كسا القدود الرشاقا",12,"ق",2,0],["وَنَثرُ عَقيقٍ ذابَ فيهِ دِماؤُهُ","جَرى مِثلَ جَمعي ثُمَّ لَم يَتَوَقَّفِ",13,"ف",1,0],["ونَثرتُها دُرراً فودّتْ أنجمٌ","لو عَدّهُنَّ الحسنُ بين صِحاحهَا",14,"ح",3,0],["ونثرت عرضي في نوا","دي القوم تذروه الرياح",15,"ح",1,0],["ونَثَّرَ أضلاعها نَثْرةَ","شَتاتاً كما صُرّفَ الدرهم",16,"م",1,0],["ونثرت جوهر ثغرها من عقده","فصحاحه العطرات غير صحاح",17,"ح",1,0],["وَنَثَرنَ الدُّموعَ نَثرَ لآلٍ","يَتَحَدَّرنَ لُؤلُؤاً مَنظومَا",18,"م",2,0],["وَنَثرَةٍ أَخفَرَ الهِندِيُّ ذِمَّتَها","إِنَّ السُيُوفَ المَواضي تَخفِرُ الذِمما",19,"م",2,0],["وَنَثَرتُ لُؤلُؤَ عَبرَةٍ","أَضحى لَها جَفني صَدَف",20,"ف",1,0],["ونثرها في العقود منتظم","ونظمها فتنة لمنشده",21,"د",2,0],["وَنَثرَةٍ تِخالُها مِن رَأيِهِ","مُحكَمَةَ السَردِ وَطَرفٍ ضامِرِ",22,"ر",1,0],["وَنُثْبِتُ حِلْيَ الْبَدِيعْ","بِتِيجَانِ شَهْرِ رَبِيعْ",23,"ع",1,0],["ونثّرتِ منها الدمعَ حتى حَسبتُهُ","لآلئَ عقدٍ يَنتَثِرنَ عن السّلك",24,"ك",1,0],["ونثَّرتُ دَمعي في النّوى وقصائدي","وبالشعرِ والدّمعِ السخينِ شفيت",25,"ت",1,0],["ونثَّرَ آمالاً على كلِّ شاطئٍ","وسارَ كسيرَ القلبِ بينَ شُعوب",26,"ب",1,0],["ونثأرُ بَطّاشينَ بعد سُكوتِنا","وقد حرَّكَ التّذكارُ حِقداً مُدثَّرا",27,"ر",2,0],["وَنَثَرتُ دَمعي مِن تَذَكُر نَظمِهِ","وَجداً فَيُمسي كَالبِحار بِوَكفِهِ",28,"ف",2,0],["ونثراً كما رقَتْ كؤوس سلافةٍ","ونَظْماً كما راقْت قلائدُ عقْيانِ",29,"ن",1,0],["ونثَرتُ لؤلؤَ أَدْمُعٍ","أضحى لَها جَفني صَدَفْ",30,"ف",1,0],["ونثرنَ مِن صدفِ الجُفونِ لبيننا","درين بَينَ مضرَّس وَمُحَبَّبِ",31,"ب",1,0],["ونثرُكَ يُزري بعِقْد الجمان","فَدُرُّ المعاني بها تُنظم",32,"م",1,0],["ونثني عليك الخير في كل ساعةٍ","ونبتدئ الذكرَ الجميلَ ونختم",33,"م",1,0],["ونُثني عليها رغبةً في ثنائِها","ليَعبَقَ في الأفواهِ من طيبِها عِطْرُ",34,"ر",1,0],["ونثلم من بعد الثرى بطن راحة","أناملها فوق الغيوم غيوم",35,"م",1,0],["ونثاً لم يخُنْهُ فينا عيانٌ","وأُصولٌ ما كذّبتْها فُروعُ",36,"ع",1,0],["وَنَثَرنَ دُرَّ الدَمعِ فَوقَ تَرائبٍ","عُوِّضنَها مِن جامِدٍ بِمُذابِ",37,"ب",1,0],["وَنُثني عَلَيهِ في المحافل بِالَّذي","بِهِ يَتَحلَّى في الثَنا عقدُ ناظم",38,"م",1,0],["وَنَثَرتَ مَيمنةً وَمَيسرةً بِها","ذَهَباً كَثيراً ما لَهُ تَحديد",39,"د",1,0],["ونثر لفظ وثغرُ","كما تنظم عِقد",40,"د",1,0],["ونثرةً مسرودة","زعفا ونهدا أجردا",41,"د",2,0],["ونَثْرِكَ الْهامَ مِنْ عَدُوٍّ","ونَظْمِكَ الدُّرَّ في حَبيبِ",42,"ب",1,0],["ونثرتُ روحي بعدَ ما ملكتْ يدي","وخررتُ بيت يَدَي هواه قتيلا",43,"ل",2,0],["ونثرت سلكَ النيرات فصغتها","بعقودِ شعرك لؤلؤاً منضودا",44,"د",2,0],["ونثرت من أبكار فكري من عقو","د درائر وأجدت للأوصاف",45,"ف",1,0],["ونثل عرش عصابة","أمست علينا باغيه",46,"ي",2,0],["ونَثَر الفِضّة زَيْني والذَّهبْ","والسَّعْدُ وافى والعَناءُ قد ذَهبْ",47,"ب",1,0],["ونثارهُ ألقاه جائزةً لها","لمّا يزل بيَدِ النسيم يُبَدّدُ",48,"د",1,0],["ونثا لونه البهي عليها","ذهبا سائلا وتبراً مهيلا",49,"ل",2,0],["ونثا ضوءه على صفحة الني","ل فأضحت من فضة في نثار",50,"ر",1,0],["ونثرتُ الاشواقَ في كلّ قلبِ","واحتواني في كلِّ صدرٍ ضميرُ",51,"ر",1,0],["ونثرت لي ذكرا علا من بعدما","كان الحسود بزعمه يطويه",52,"ي",2,0],["ونثرت ياقوت الدموع تذكراً","لفم تضمن لؤلؤاً وعقيقا",53,"ق",2,0],["ونثأر بالشعر من عصبة","تشد على الشر أكوارها",54,"ر",3,0],["ونثرةٌ 