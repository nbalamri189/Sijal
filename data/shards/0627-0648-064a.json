{"poems":[[53,"أحظى الملوك من الأيام والدول","https://www.aldiwan.net/poem29908.html","البسيط"],[53,"كل شيء من الزمان طريف","https://www.aldiwan.net/poem29965.html","الخفيف"],[53,"أبكيك لو نقع الغليل بكائي","https://www.aldiwan.net/poem30779.html","الكامل"],[55,"ضن الطبيب على المري","https://www.aldiwan.net/poem26549.html","مجزوء الكامل"],[77,"يا ربة البيت الممنع جاره","https://www.aldiwan.net/poem36516.html","الكامل"],[86,"إن صوروك فإنما قد صوروا","https://www.aldiwan.net/poem68950.html","الكامل"],[35,"شجا أظعان غاضرة الغوادي","https://www.aldiwan.net/poem39157.html","الوافر"],[93,"يا مسهد القوم أطلت السنه","https://www.aldiwan.net/poem11117.html","السريع"],[93,"يا صورة شبهت صخراً بإنسان","https://www.aldiwan.net/poem11173.html","البسيط"],[93,"عد لابساً ثوب الخلود وعلم","https://www.aldiwan.net/poem11356.html","الكامل"],[93,"ألتاج تاج مملكين عظام","https://www.aldiwan.net/poem11386.html","الكامل"],[83,"لو كنت أعطي من لقائك سولا","https://www.aldiwan.net/poem54262.html","الكامل"],[83,"أغرى سراة الحي بالإطراق","https://www.aldiwan.net/poem54268.html","الكامل"],[88,"هكذا يدرك في الدنيا الكمال","https://www.aldiwan.net/poem45045.html","الرمل"],[27,"حي المنازل بالأجزاع فالوادي","https://www.aldiwan.net/poem5722.html","البسيط"],[4,"أقوى وعري واسط فبرام","https://www.aldiwan.net/poem21194.html","الكامل"],[37,"كأم البيض تلحفه غدافا","https://www.aldiwan.net/poem7420.html","الوافر"],[47,"ضلال مارأيت من الضلال","https://www.aldiwan.net/poem25209.html","الوافر"],[72,"أطلق دموعك إن القلب معذور","https://www.aldiwan.net/poem18717.html","البسيط"],[72,"حاشاك من وحشة تحت الثرى وجلا","https://www.aldiwan.net/poem20546.html","البسيط"],[51,"للحريثي أبي بكر غبب","https://www.aldiwan.net/poem8500.html","الرمل"],[51,"بان شبابي فعز مطلبه وانبت بيني وبينه نسبه","https://www.aldiwan.net/poem8518.html","المنسرح"],[51,"سيدي أنت شاخص مصحوب","https://www.aldiwan.net/poem8526.html","الخفيف"],[51,"وقف الهوى بك بعد طول وجيفه","https://www.aldiwan.net/poem65460.html","الكامل"],[51,"يا نجدة الروم في بطارقها","https://www.aldiwan.net/poem65502.html","المنسرح"],[51,"الخير مصنوع بصانعه","https://www.aldiwan.net/poem65816.html","أحذ الكامل"],[51,"يا رجلا أوفى على كل رجل","https://www.aldiwan.net/poem65868.html","الرجز"],[51,"قل لمن ألبس الجمال جمالا","https://www.aldiwan.net/poem65878.html","الخفيف"],[51,"ما لحيتاننا جفتنا وأنى","https://www.aldiwan.net/poem66012.html","الخفيف"],[51,"أنا صب مستهام","https://www.aldiwan.net/poem66023.html","مجزوء الرمل"],[51,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[51,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[91,"هم ألم به مع الظلماء","https://www.aldiwan.net/poem8725.html","عموديه"],[91,"روض إذا زرته كئيبا","https://www.aldiwan.net/poem8761.html","عموديه"],[92,"أيها الشعب ليتني كنت حطابا","https://www.aldiwan.net/poem38934.html","الخفيف"],[92,"عش بالشعور وللشعور فإنما","https://www.aldiwan.net/poem38938.html","البسيط"],[85,"شر البلية أن يكون زعيما","https://www.aldiwan.net/poem7255.html","الكامل"],[85,"لا يقيمن على الضيم الأسد","https://www.aldiwan.net/poem8101.html","الرمل"],[85,"لا السهد يدنيني إليه ولا الكرى","https://www.aldiwan.net/poem63716.html","الطويل"],[85,"حف كأسها الحبب","https://www.aldiwan.net/poem63726.html","المقتضب"],[43,"حسم الصلح ما اشتهته الأعادي","https://www.aldiwan.net/poem9554.html","الخفيف"],[43,"غاضت أنامله وهن بحور","https://www.aldiwan.net/poem9574.html","الكامل"],[45,"اسمع هديت أبا يحيى مقال أخ","https://www.aldiwan.net/poem64548.html","البسيط"],[28,"أبلغ معاوية الذي بيمينه","https://www.aldiwan.net/poem5603.html","الكامل"],[28,"لحا الله ماء حنبل قيم له","https://www.aldiwan.net/poem5644.html","الطويل"],[61,"بكرت عليك مغيرة الأعراب","https://www.aldiwan.net/poem51793.html","الكامل"],[2,"إن الخليط أجد البين فانفرقا","https://www.aldiwan.net/poem25062.html","البسيط"],[49,"عتب ما للخيال","https://www.aldiwan.net/poem64292.html","مجزوء الخفيف"],[66,"يا سليما من داء قلبي السليم","https://www.aldiwan.net/poem39535.html","الخفيف"],[66,"لو يرد الردى ببذل الأيادي","https://www.aldiwan.net/poem40136.html","الخفيف"],[66,"جلت الظلماء بللهب","https://www.aldiwan.net/poem40672.html","المديد"],[97,"ذات مساء صفا المساء","https://www.aldiwan.net/poem24348.html","مخلع البسيط"],[80,"قم هاتها من كف ذات الوشاح","https://www.aldiwan.net/poem31520.html","السريع"],[44,"ما للدموع تروم كل مرام","https://www.aldiwan.net/poem30362.html","الكامل"],[44,"هي فرقة من صاحب لك ماجد","https://www.aldiwan.net/poem30554.html","الكامل"],[31,"قد صبا القلب صبا غير دني","https://www.aldiwan.net/poem38731.html","الرمل"],[31,"طال ليلي لسرى طيف ألم","https://www.aldiwan.net/poem41333.html","الرمل"],[105,"يا وفود النيل ترتج القرى","https://www.aldiwan.net/poem43055.html","الرمل"],[105,"طالت أناتك في القوم الألى جهلوا","https://www.aldiwan.net/poem43393.html","البسيط"],[39,"شث شعب الحي التئام","https://www.aldiwan.net/poem53751.html","المديد"],[48,"يا قلب يا خائن الحبيب","https://www.aldiwan.net/poem10820.html","مجزوء البسيط"],[46,"لا تلبس الدنيا فإن لباسها","https://www.aldiwan.net/poem22351.html","الكامل"],[46,"أوى ربي إلي فما وقوفي","https://www.aldiwan.net/poem22692.html","الوافر"],[46,"العدل صعب وكلما عدل ال","https://www.aldiwan.net/poem23185.html","المنسرح"],[46,"العقل إن يضعف يكن مع","https://www.aldiwan.net/poem23593.html","الكامل"],[15,"ليس رسم على الدفين ببالي","https://www.aldiwan.net/poem45253.html","الخفيف"],[15,"أقفر من أهله ملحوب","https://www.aldiwan.net/poem45286.html","مخلع البسيط"],[76,"وشادن ذي دلال","https://www.aldiwan.net/poem39017.html","المجتث"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85819","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39551","السريع"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39612","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39673","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39556","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39539","الرمل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202542","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55147","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54931","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54519","المتقارب"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54860","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54632","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54745","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54549","الكامل"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199479","الهزج"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43703","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54267","المجتث"],[106,"طوى الموت إبراهيم!","https://www.poetsgate.com/ViewPoem.aspx?id=179679",""],[106,"معترك السباب!","https://www.poetsgate.com/ViewPoem.aspx?id=179427",""],[106,"تجار العقائد","https://www.poetsgate.com/ViewPoem.aspx?id=179441",""],[106,"لا نكسة","https://www.poetsgate.com/ViewPoem.aspx?id=179333",""],[90,"عُدنا وقودا","https://www.poetsgate.com/ViewPoem.aspx?id=179221",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[91,"رثاء","https://www.poetsgate.com/ViewPoem.aspx?id=53186",""],[28,"لحَا الله مَاءً، حَنْبَلٌ قَيّمٌ لَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=17942",""],[51,"أقسمتُ والحنثُ له آثامُ","https://www.poetsgate.com/ViewPoem.aspx?id=30408",""],[51,"دابر أوطاره إلى الذِّكَرِ","https://www.poetsgate.com/ViewPoem.aspx?id=29169",""],[31,"طال لَيْلي لِسُرَى طَيْفٍ أَلَمّ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19072&r=&rc=335",""],[91,"الفقير","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66212&r=&rc=13",""],[4,"أقْوَى وَعُرِّيَ واسِطٌ فَبَرَامُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10944&r=&rc=39",""]],"verses":[["أَوَيتَهُ مِن نِزالِ المُستَطيلِ إِلى","مَرعىً أَنيقٍ وَظِلٍّ غَيرِ مُنتَقِلِ",0,"ل",1,0],["أَو يَكُن أَنكَرَ الإِخاءَ قَديماً","مِنكَ قَلبٌ فَإِنَّ قَلبي عَروفُ",1,"ف",1,0],["آوي إِلى بَردِ الظِلالِ كَأنَّني","لِتَحَرُّقي آوي إِلى الرَمضاءِ",2,"ا",2,0],["أَو يَشتَفي مِمّا يُجِنَّ","إِذا خَلا بِبُكائِهِ",3,"ا",3,0],["آوَى لظِلّهِم الهُدى ولَقَبْلُما","أرْدى الضّلالَ بعزِّهِمْ مُخْتارُه",4,"ر",2,0],["أَو يَبلُغوا عَلياكَ حَتّى يَبلُغوا","بَينَ الزَواهِرِ صورَةَ الجَبّارِ",5,"ر",1,0],["أُوَيتِ لِعاشِقٍ لَم تَشكُميهِ","نَوَافِذُهُ تَلَذَّعُ بِالزَنَادِ",6,"د",1,0],["أَوْ يَبْرَحِ المَنْصِبَ تَنْهَضْ عَلَى","قُدرَتهِ فِي ذَاتِهِ البَيِّنَهْ",7,"ن",2,0],["أَوْ يَرْشُدُ الشَّعْبُ يُنْسِ الأَمْرُ فِي يَدِهِ","وَلا اعْتِدادَ بِأَمْلاكٍ وَأَعْيَانِ",8,"ن",1,0],["أَوْ يُسْتَشَفُّ بِهِ مَشِيبٌ لَمْ يَكْنِ","إِلاَّ رَمَادَ الْخَاطِرِ المُتَضَرِّمِ",9,"م",1,0],["أَوْ يَرْكَبِ الأَخْطَارَ فَهْوَ كَمِيُّهَا","هَلْ تُدْرِكُ الأَخْطَارُ بِالإِحْجَامِ",10,"م",1,0],["أو يُخلف الناسَ الغمامُ وأمحلوا","فنداه لا يَخْشَى العفاة محولا",11,"ل",2,0],["أو يرفعوك على العواتق طالما","رُفِّعْتَ ظهر منابر وعِتاقِ",12,"ق",1,0],["أو يكن عن أعين القوم اختفى","فله في أنفس القوم خيال",13,"ل",1,0],["آوي إِلى صَخرَةٍ صَمّاءَ راسِيَةٍ","تُنبي الصَفا حينَ يَردي صَخرَها الرادي",14,"ي",1,0],["آوَيتُهُ حَتّى تَكَفَّتَ حامِداً","وَأَهَلَّ بَعدَ جُمَدِيَينِ حَرامُ",15,"م",1,0],["أوين إلى ملاطفة خضود","لمأكلهن طفطاف الربُول",16,"ل",1,0],["أَوَينا بَينَ أَطنابِ الأَعادي","إِلى بَلَدٍ مِنَ النُصّارِ خالِ",17,"ل",1,0],["أو يغد بيتك يشكو للزمان وغىً","فإنه ببقاء السيف منصور",18,"ر",1,0],["أو ينقضي للمنايا بعدنا شغل","فقد تركنَ بقلبِي للأسى شغلا",19,"ل",2,0],["أو يكن بابن عِياضٍ فاخراً","فلعمري فيه فخرٌ وحَسَبْ",20,"ب",1,0],["أو يأكلَ اللحمَ غيرَ مُتَّزِعٍ","ويتركَ الجسمَ ناحلاً قَصَبُهْ",21,"ب",2,0],["أوْ يَرَى غَيْرَ ذاك من يرعوي الرأْ","يُ إلى وجهِ رأيهِ ويَتوبُ",22,"ب",1,0],["أو يقرني دهري مذيقَ حليبه","فلقد قراني من وَريَّ سديفه",23,"ف",2,0],["أو يخلف البدر نور ضحكته","إذا انجلى الليل عن بوارقها",24,"ق",3,0],["أو يخلف الغيث راحتيه لنا","كلا وأخلاقه وخالقها",24,"ق",3,0],["أو يخلف البحر ما تجيش به","أفكاره تلك من دقائقها",24,"ق",3,0],["أو يَسْتَقيدَ له وينْصُرَهُ","ويصيبَ بالتَكْديرِ مَشْرَبكا",25,"ك",2,0],["أو يغفلُ الأذكونَ أو يذكو الغُفل","أقسمتُ لا تفعل إلا ما جَمُل",26,"ل",1,0],["أو يردُّ الفراتَ أو يردعُ السَّي","لَ إذا وافقَ المسيلَ فسالا",27,"ل",2,0],["أو يقولونَ لا نجيئُك مَجَّا","ناً فنرتادُ كافياً يشتريهِمْ",28,"م",1,0],["أو يكنْ للحسن خَلفاً","فهْو للحسن أَمامُ",29,"م",1,0],["أو يبطُلُ الحقُّ بينَ الناسِ كُلِّهمُ","فليسَ للحقِّ عند الله بُطلان",30,"ن",1,0],["أو يُخلَّى عنان ذاك وهذا","سبَقا موقتيهما في الزمان",31,"ن",1,0],["أَو يُنكِروا أَدَبي فَلا تَتَعَجَّبوا","فَالرَمدُ يُؤلِمُهُم طُلوعُ ذَكاءِ",32,"ا",2,0],["أَو يَتَجنّى عَلى خَصيبٍ","أَعادَهُ قاحِلاً جَديبا",33,"ب",2,0],["أَو يغنِّي بَيْنَ الصَّنَوْبَرِ أَو يرنو","إلى سُدْفَةِ الظَّلامِ المُمَسِّي",34,"ي",1,0],["أَو يلمسُ العودَ المقدَّسَ واصفاً","للموت للأَيَّامِ للدَّيجورِ",35,"ر",1,0],["أو يطلبوا إيلام كل مهذب","فلقد أذقتهم العذاب أليما",36,"م",2,0],["أَو يَزيدَ البِرَّ داراً قَعَدَت","لِكِفاحِ السُلِّ أَو حَربِ الرَمَد",37,"د",1,0],["آوي إِلى الشَجَراتِ وَهيَ تَهُزُّني","وَقَدِ اِطمَأَنَّ الطَيرُ فيها بِالكَرى",38,"ر",2,0],["أَو يَدٌ وَباطِنُها","عاطِلٌ وَمُختَضِبُ",39,"ب",1,0],["أَو يَكونَ الوَلِيُّ أَشقى عَدُوٍّ","بِالَّذي تَذخُرانِهِ مِن عَتادِ",40,"د",1,0],["أَو يَرغَبوا بِقُصورِهِم عَن حُفرَةٍ","حَيّاهُ فيها مُنكَرٌ وَنَكيرُ",41,"ر",1,0],["أَو يَستَعيدَ إِلى العُتبى فَأَترُكُهُ","لِأَنَّهُ وَتِحٌ مِن نَسلِ أَنزارِ",42,"ر",1,0],["أَو يَستَقيمَ إِلى أَبيهِ فَإِنَّهُ","ضَوءُ النَهارِ جَلا دُجى الأَظلامِ",43,"م",1,0],["أَوَيتُ لِأَبناءِ الطَريقِ مِنِ اِمرِئٍ","شَروبُ الأَداوي لِلرَكِيِّ دَفونِ",44,"ن",1,0],["أو يَهبُطا من ذَلَّةٍ فأنا الذي","ضُربَتْ على الشَّرَفِ المُطِلِّ قبابي",45,"ب",2,0],["أَو يَسبِقاهُ عَلى ما كانَ مِن مَهَلٍ","فَمِثلُ ما قَدَّما مِن صالِحٍ سَبَقا",46,"ق",2,0],["أَو يَراني عَدُوّي","لانَ مِن سوءِ حالي",47,"ل",2,0],["أَو يَكُن خاطِري بِذِكرِكَ في الخُ","دِ فَعَينايَ في العَذابِ الأَليمِ",48,"م",1,0],["أَو يُنادى لِلمَكرُماتِ فَلا يَس","بِقُ مِنكَ النَدى نِداءَ المُنادي",49,"د",2,0],["أَو يَواقيتاً مُنَضَّدَةً","بَينَ أَيدينا عَلى قُضُبِ",50,"ب",1,0],["أو يخلُع الغيمَ ثم يبدو","طفلاً مصوغاً من الضياء",51,"ا",2,0],["أو يطويَ الظلُّ بساطاً إذا","ما بَرِحَ الطلّ له عنْ بَرَاح",52,"ح",1,0],["أَو يُفتَقَد ذو النونِ في الهَيجا فَقَد","دَفَعَ الإِلَهُ لَنا عَنِ الصَمّامِ",53,"م",1,0],["أَو يَختَلِف ماءُ الوِصالِ فَماؤُنا","عَذبٌ تَحَدَّرَ مِن غَمامٍ واحِدِ",54,"د",1,0],["أَو يَفتَرِق نَسَبٌ يُؤَلِّفُ بَينَنا","أَدَبٌ أَقَمناهُ مُقامَ الوالِدِ",54,"د",1,0],["أَو يَكُن أَمسى تَقِيّاً قَلبُهُ","فَلَعَمري إِنَّ قَلبي لَغَوي",55,"ي",1,0],["أَو يَرُدَّ الحُكمَ عَنهُ بِالرِضا","فَعَلَينا حُكمُهُ فيما اِحتَكَم",56,"م",1,0],["أو يرى الأَنفُسَ إن هَمَّتْ بها","ضرَباتُ القومِ في حِرزٍ أَمينْ",57,"ن",1,0],["أَو يُصبِحوا قَد أَظَلَّتهُم عَمايَتُهُم","فَسَوفَ تَنجابُ عَنهُم هَذِهِ الظُلَلُ",58,"ل",1,0],["أَو يُصادِف خَفَقاً يُصفِهِم","بِعَتيقِ الخَشلِ دونَ الطَعام",59,"م",1,0],["أَو يُقرَنُ القَلبُ بِالوَجيبِ","وَتُغمَرَ الأُذنُ بِالنَحيبِ",60,"ب",1,0],["آوى بِها اللَهُ الأَنامَ فَما أَوى","لِمُحالِفي دَدِها وَلا أَوّابِها",61,"ب",3,0],["أَوى رَبّي إِلَيَّ فَما وُقوفي","عَلى تِلكَ المَنازِلِ وَالأَواري",62,"ي",1,1],["أَو يَعتَقِلهُ فَالرُمحُ أَحوَجُ ما","كانَ إِلَيهِ الفَتى إِذا اِعتَقَلَه",63,"ل",2,0],["أَو يَقوَ فَهِيَ لَهُ كَحُرَّةٍ عاقِلٍ","حَسناءَ يَهواها وَلا تُهويهِ",64,"ه",1,0],["أَو يَكُن طِبُّكِ الزِيالَ فَإِنَّ ال","بَينَ أَن تَعطِفي صُدورَ الجِمالِ",65,"ل",1,0],["أَو يَكُ أَقفَرَ مِنها جَوُّها","وَعادَها المَحلُ وَالجُدوبُ",66,"ب",1,0],["أَوْ يَلتقي في مَنامي","خيالُهُ معْ خَيالي",67,"ي",1,0],["أو يبصرو في العالم المستور ما","لم يبصروا في العالم المنظور",68,"ر",1,0],["أوى إلى كهفٍ بسفح الجبلْ","عساهُ يقضي ليله في سلامْ",69,"م",1,0],["أو يقرأوا تاريخَهُ فصحيفةٌ","إمضاؤُه فيها عُلىً وفخارُ",70,"ر",1,0],["أو يبحثوا عن قبْرِهِ فمكانهُ","فيما يُظِلُّ العُشْبُ والأزهارُ",70,"ر",1,0],["أو يكُن بات لا يرى الحب هذا ال","كوكب الهادي الصدوقَ الوفيّا",71,"ي",2,0],["أو يكُن جسمُك الحيّ عرَتهُ","هزّةٌ من عواطفٍ كامنات",71,"ت",1,0],["أو يكن قد تورّدَ الخدّان","خَجَلاً من رؤىً ملئنَ أثاما",71,"م",2,0],["آوي إلى جنباتِ الصخرِ منفرداً","أبكي لأمسيةٍ مرَّت وليلاتِ",72,"ت",1,0],["أو يُلاشي فيك حَيّا مثلما","يتلاشى في الضحى لُمح الشهابْ",73,"ب",1,0],["أوى الى أطنابه اليمامُ","لأنها الرحمة والغمامُ",74,"م",1,0],["أَوْ يَقْحَمُ المَوْتَ الجَسُورُ وَعَلَّهُ","قَدْ جَرَّأَتْهُ عَقِيدَةُ الآجَالِ",75,"ل",1,0],["أَوْ يَسْتَقِلُّ بِهِ مُغَيرٌ مُنْجِدٌ","جَوَّابُ آفَاقٍ كَبَرْقٍ وَارِي",76,"ر",2,0],["أَوَيْتُ إلَى السَّمْحِ مِنْ ظِلِّهَا","وَفِي ظِلِّهَا الرَّوْحُ لِي وَالشِّفَاءْ",77,"ا",2,0],["أَوَى إِلى وَكْرٍ عَلَى شاِمخٍ","فَخانَهُ فِي المَأْمَنِ الوَكْرُ",78,"ر",1,0],["أوْ يُبْرِزُ الخَلْقَ السَّوِيَّ","فَلِلْحَيَاةِ بِهِ دَبِيبُ",79,"ب",1,0],["أَوْ يُتَابِعْ آثَارَهَا يَتَبَيَّنْ","مِنْ مَدَاهَا مَا لَيْسَ بِالمَحدُود",80,"د",1,0],["آوَيتُهُنَّ إلى الحَشَا","فَمَلأْنَ رَأْسِي بِالغِنَاءِ",81,"ا",2,0],["أو يستعبد البشر","فقولي إنه القمر!.",82,"ر",1,0],["آوى إِلى جَنَّةِ المَأوى وَغادَرَني","في غابِرينَ إِذا ما قُلتُ فوا لاذوا",83,"ذ",3,0],["أو يشتفي ببكاءٍ","مَن شأنُه مثلُ شأني",84,"ي",1,0],["أوى السجن فيه كلُّ شيخٍ مهدَّمٍ","وكلُّ صبيّ ناعماتُ أظافره",85,"ر",2,0],["أو يصدقوا فيه فيا","لله من هَوْل المصاب!",86,"ب",1,0],["أو ينتفعْ بمحمد","صلَّى عليه وسلَّما",87,"م",2,0],["أو يَدْرُجُوا فوق الثَّرى، لا تلبث الْ","أَقدام بالأَلْغام أن تتعثَّرا",88,"ر",2,0],["أو يرقدوا، حلموا بضرٍّ منكمو","قد هبَّ من تحت السرير مُشَمِّرا",88,"ر",2,0],["أو يطََّرِدْ قانِصٌ قَنيصاً","أو تُعْجبِ الأغيدِينَ غِيد",89,"د",1,0],["أو يكثُرُ الأبطالُ حين سِلاحُهم","بين الجْموع قَصيدةٌ وكَلام؟",90,"م",1,0],["أوى فنور الفرقدين ضئيل","وعلى المنازل رهبة وذهول",91,"ل",1,1],["أوَيْتُ لأبْنَاءِ الطّرِيقِ مِن امْرِىءٍ","شَرُوبِ الأداوِي للرّكِيّ دَفُونِ",92,"ن",1,0],["أو يلتقي الإضْحاءُ والإعْتَامُ","بحران ما بينهما التئامُ",93,"م",1,0],["أو يذو أغصانَها الزمانُ فقد","جنيتُ منها مَطايب الثمر",94,"ر",1,0],["أو يردَّ الحكمَ عنه بالرضى ،","فَعَلَيْنَا حُكْمُهُ فِيمَا کحْتَكَمْ",95,"م",1,0],["أو ينكروا أدبي فلا تتعجبوا","فالرمد طلوع ذكاء",96,"ا",2,0],["آويتُهُ حتى تكفّتَ حامِداً","وأهلَّ بَعْدَ جُماديينَ حَرامُ",97,"م",1,0]]}