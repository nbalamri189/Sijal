لتئم","https://www.aldiwan.net/poem55869.html","البسيط"],[456,"ردوا لها أيامها بالغميم","https://www.aldiwan.net/poem55888.html","السريع"],[456,"كم النوى قد جزع الصابر","https://www.aldiwan.net/poem56172.html","السريع"],[456,"الليل بعد اليأس أطمع ناظري","https://www.aldiwan.net/poem56175.html","الكامل"],[456,"لو كنت تبلو غداة السفح أخباري","https://www.aldiwan.net/poem56179.html","البسيط"],[456,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[459,"شكرا لدهري بالضمير وبالفم","https://www.aldiwan.net/poem15142.html","الكامل"],[459,"زهي المباسل لانتضاء المقصل","https://www.aldiwan.net/poem15147.html","الكامل"],[459,"يا للصوارم والرماح الذبل","https://www.aldiwan.net/poem15925.html","الكامل"],[459,"بت حيث شئت ولا يرعك المنزل","https://www.aldiwan.net/poem16015.html","الكامل"],[462,"يا من تلون عهده وتغيرا","https://www.aldiwan.net/poem3198.html","عموديه"],[477,"انظر على جبل المنار غزالا","https://www.aldiwan.net/poem37065.html","الكامل"],[480,"إذا غازلتك الجاذبات الشعاعية","https://www.aldiwan.net/poem24501.html","عموديه"],[512,"ضربوا القباب وطنبوها بالقنا","https://www.aldiwan.net/poem20802.html","الكامل"],[513,"لا وعيون لحظها ساهر","https://www.aldiwan.net/poem12116.html","السريع"],[534,"ولقد عجبت لأهل هذا الطائف","https://www.aldiwan.net/poem23873.html","الكامل"],[536,"دمت للفن ودام الفن لك","https://www.aldiwan.net/poem47968.html","عموديه"],[549,"أرني العجائب يا أباها","https://www.aldiwan.net/poem47144.html","مجزوء الكامل"],[549,"دع الهوى يتبعه الأخرق","https://www.aldiwan.net/poem47377.html","السريع"],[549,"شد غروض المطي مغتربا","https://www.aldiwan.net/poem48085.html","المنسرح"],[556,"ربما يكذب حسادي علي","https://www.aldiwan.net/poem33569.html","الرمل"],[556,"أنا في الملاح على اليقين","https://www.aldiwan.net/poem33819.html","مجزوء الكامل"],[556,"كل قول على العقول يشق","https://www.aldiwan.net/poem34304.html","الخفيف"],[556,"إني أنا جسم فنفس فروح","https://www.aldiwan.net/poem34668.html","السريع"],[557,"طاب شرب المدام في الخلوات","https://www.aldiwan.net/poem69367.html","الخفيف"],[565,"أي حراك غال منك السكون","https://www.aldiwan.net/poem69478.html","السريع"],[565,"عجبت من قناعتي وقعودي","https://www.aldiwan.net/poem69730.html","الكامل"],[585,"قلب المحب من الهجران مكلوم","https://www.aldiwan.net/poem11515.html","عموديه"]],"verses":[["أَوَيتَهُ مِن نِزالِ المُستَطيلِ إِلى","مَرعىً أَنيقٍ وَظِلٍّ غَيرِ مُنتَقِلِ",0,"ل",1,0],["أَو يَكُن أَنكَرَ الإِخاءَ قَديماً","مِنكَ قَلبٌ فَإِنَّ قَلبي عَروفُ",1,"ف",1,0],["آوي إِلى بَردِ الظِلالِ كَأنَّني","لِتَحَرُّقي آوي إِلى الرَمضاءِ",2,"ا",2,0],["أَو يَشتَفي مِمّا يُجِنَّ","إِذا خَلا بِبُكائِهِ",3,"ا",3,0],["آوَى لظِلّهِم الهُدى ولَقَبْلُما","أرْدى الضّلالَ بعزِّهِمْ مُخْتارُه",4,"ر",2,0],["أَو يَبلُغوا عَلياكَ حَتّى يَبلُغوا","بَينَ الزَواهِرِ صورَةَ الجَبّارِ",5,"ر",1,0],["أُوَيتِ لِعاشِقٍ لَم تَشكُميهِ","نَوَافِذُهُ تَلَذَّعُ بِالزَنَادِ",6,"د",1,0],["أَوْ يَبْرَحِ المَنْصِبَ تَنْهَضْ عَلَى","قُدرَتهِ فِي ذَاتِهِ البَيِّنَهْ",7,"ن",2,0],["أَوْ يَرْشُدُ الشَّعْبُ يُنْسِ الأَمْرُ فِي يَدِهِ","وَلا اعْتِدادَ بِأَمْلاكٍ وَأَعْيَانِ",8,"ن",1,0],["أَوْ يُسْتَشَفُّ بِهِ مَشِيبٌ لَمْ يَكْنِ","إِلاَّ رَمَادَ الْخَاطِرِ المُتَضَرِّمِ",9,"م",1,0],["أَوْ يَرْكَبِ الأَخْطَارَ فَهْوَ كَمِيُّهَا","هَلْ تُدْرِكُ الأَخْطَارُ بِالإِحْجَامِ",10,"م",1,0],["أو يُخلف الناسَ الغمامُ وأمحلوا","فنداه لا يَخْشَى العفاة محولا",11,"ل",2,0],["أو يرفعوك على العواتق طالما","رُفِّعْتَ ظهر منابر وعِتاقِ",12,"ق",1,0],["أو يكن عن أعين القوم اختفى","فله في أنفس القوم خيال",13,"ل",1,0],["آوي إِلى صَخرَةٍ صَمّاءَ راسِيَةٍ","تُنبي الصَفا حينَ يَردي صَخرَها الرادي",14,"ي",1,0],["آوَيتُهُ حَتّى تَكَفَّتَ حامِداً","وَأَهَلَّ بَعدَ جُمَدِيَينِ حَرامُ",15,"م",1,0],["أوين إلى ملاطفة خضود","لمأكلهن طفطاف الربُول",16,"ل",1,0],["أَوَينا بَينَ أَطنابِ الأَعادي","إِلى بَلَدٍ مِنَ النُصّارِ خالِ",17,"ل",1,0],["أو يغد بيتك يشكو للزمان وغىً","فإنه ببقاء السيف منصور",18,"ر",1,0],["أو ينقضي للمنايا بعدنا شغل","فقد تركنَ بقلبِي للأسى شغلا",19,"ل",2,0],["أو يكن بابن عِياضٍ فاخراً","فلعمري فيه فخرٌ وحَسَبْ",20,"ب",1,0],["أو يأكلَ اللحمَ غيرَ مُتَّزِعٍ","ويتركَ الجسمَ ناحلاً قَصَبُهْ",21,"ب",2,0],["أوْ يَرَى غَيْرَ ذاك من يرعوي الرأْ","يُ إلى وجهِ رأيهِ ويَتوبُ",22,"ب",1,0],["أو يقرني دهري مذيقَ حليبه","فلقد قراني من وَريَّ سديفه",23,"ف",2,0],["أو يخلف البدر نور ضحكته","إذا انجلى الليل عن بوارقها",24,"ق",3,0],["أو يخلف الغيث راحتيه لنا","كلا وأخلاقه وخالقها",24,"ق",3,0],["أو يخلف البحر ما تجيش به","أفكاره تلك من دقائقها",24,"ق",3,0],["أو يَسْتَقيدَ له وينْصُرَهُ","ويصيبَ بالتَكْديرِ مَشْرَبكا",25,"ك",2,0],["أو يغفلُ الأذكونَ أو يذكو الغُفل","أقسمتُ لا تفعل إلا ما جَمُل",26,"ل",1,0],["أو يردُّ الفراتَ أو يردعُ السَّي","لَ إذا وافقَ المسيلَ فسالا",27,"ل",2,0],["أو يقولونَ لا نجيئُك مَجَّا","ناً فنرتادُ كافياً يشتريهِمْ",28,"م",1,0],["أو يكنْ للحسن خَلفاً","فهْو للحسن أَمامُ",29,"م",1,0],["أو يبطُلُ الحقُّ بينَ الناسِ كُلِّهمُ","فليسَ للحقِّ عند الله بُطلان",30,"ن",1,0],["أو يُخلَّى عنان ذاك وهذا","سبَقا موقتيهما في الزمان",31,"ن",1,0],["أَو يُنكِروا أَدَبي فَلا تَتَعَجَّبوا","فَالرَمدُ يُؤلِمُهُم طُلوعُ ذَكاءِ",32,"ا",2,0],["أَو يَتَجنّى عَلى خَصيبٍ","أَعادَهُ قاحِلاً جَديبا",33,"ب",2,0],["أَو يغنِّي بَيْنَ الصَّنَوْبَرِ أَو يرنو","إلى سُدْفَةِ الظَّلامِ المُمَسِّي",34,"ي",1,0],["أَو يلمسُ العودَ المقدَّسَ واصفاً","للموت للأَيَّامِ للدَّيجورِ",35,"ر",1,0],["أو يطلبوا إيلام كل مهذب","فلقد أذقتهم العذاب أليما",36,"م",2,0],["أَو يَزيدَ البِرَّ داراً قَعَدَت","لِكِفاحِ السُلِّ أَو حَربِ الرَمَد",37,"د",1,0],["آوي إِلى الشَجَراتِ وَهيَ تَهُزُّني","وَقَدِ اِطمَأَنَّ الطَيرُ فيها بِالكَرى",38,"ر",2,0],["أَو يَدٌ وَباطِنُها","عاطِلٌ وَمُختَضِبُ",39,"ب",1,0],["أَو يَكونَ الوَلِيُّ أَشقى عَدُوٍّ","بِالَّذي تَذخُرانِهِ مِن عَتادِ",40,"د",1,0],["أَو يَرغَبوا بِقُصورِهِم عَن حُفرَةٍ","حَيّاهُ فيها مُنكَرٌ وَنَكيرُ",41,"ر",1,0],["أَو يَستَعيدَ إِلى العُتبى فَأَترُكُهُ","لِأَنَّهُ وَتِحٌ مِن نَسلِ أَنزارِ",42,"ر",1,0],["أَو يَستَقيمَ إِلى أَبيهِ فَإِنَّهُ","ضَوءُ النَهارِ جَلا دُجى الأَظلامِ",43,"م",1,0],["أَوَيتُ لِأَبناءِ الطَريقِ مِنِ اِمرِئٍ","شَروبُ الأَداوي لِلرَكِيِّ دَفونِ",44,"ن",1,0],["أو يَهبُطا من ذَلَّةٍ فأنا الذي","ضُربَتْ على الشَّرَفِ المُطِلِّ قبابي",45,"ب",2,0],["أَو يَسبِقاهُ عَلى ما كانَ مِن مَهَلٍ","فَمِثلُ ما قَدَّما مِن صالِحٍ سَبَقا",46,"ق",2,0],["أَو يَراني عَدُوّي","لانَ مِن سوءِ حالي",47,"ل",2,0],["أَو يَكُن خاطِري بِذِكرِكَ في الخُ","دِ فَعَينايَ في العَذابِ الأَليمِ",48,"م",1,0],["أَو يُنادى لِلمَكرُماتِ فَلا يَس","بِقُ مِنكَ النَدى نِداءَ المُنادي",49,"د",2,0],["أَو يَواقيتاً مُنَضَّدَةً","بَينَ أَيدينا عَلى قُضُبِ",50,"ب",1,0],["أو يخلُع الغيمَ ثم يبدو","طفلاً مصوغاً من الضياء",51,"ا",2,0],["أو يطويَ الظلُّ بساطاً إذا","ما بَرِحَ الطلّ له عنْ بَرَاح",52,"ح",1,0],["أَو يُفتَقَد ذو النونِ في الهَيجا فَقَد","دَفَعَ الإِلَهُ لَنا عَنِ الصَمّامِ",53,"م",1,0],["أَو يَختَلِف ماءُ الوِصالِ فَماؤُنا","عَذبٌ تَحَدَّرَ مِن غَمامٍ واحِدِ",54,"د",1,0],["أَو يَفتَرِق نَسَبٌ يُؤَلِّفُ بَينَنا","أَدَبٌ أَقَمناهُ مُقامَ الوالِدِ",54,"د",1,0],["أَو يَكُن أَمسى تَقِيّاً قَلبُهُ","فَلَعَمري إِنَّ قَلبي لَغَوي",55,"ي",1,0],["أَو يَرُدَّ الحُكمَ عَنهُ بِالرِضا","فَعَلَينا حُكمُهُ فيما اِحتَكَم",56,"م",1,0],["أو يرى الأَنفُسَ إن هَمَّتْ بها","ضرَباتُ القومِ في حِرزٍ أَمينْ",57,"ن",1,0],["أَو يُصبِحوا قَد أَظَلَّتهُم عَمايَتُهُم","فَسَوفَ تَنجابُ عَنهُم هَذِهِ الظُلَلُ",58,"ل",1,0],["أَو يُصادِف خَفَقاً يُصفِهِم","بِعَتيقِ الخَشلِ دونَ الطَعام",59,"م",1,0],["أَو يُقرَنُ القَلبُ بِالوَجيبِ","وَتُغمَرَ الأُذنُ بِالنَحيبِ",60,"ب",1,0],["آوى بِها اللَهُ الأَنامَ فَما أَوى","لِمُحالِفي دَدِها وَلا أَوّابِها",61,"ب",3,0],["أَوى رَبّي إِلَيَّ فَما وُقوفي","عَلى تِلكَ المَنازِلِ وَالأَواري",62,"ي",1,1],["أَو يَعتَقِلهُ فَالرُمحُ أَحوَجُ ما","كانَ إِلَيهِ الفَتى إِذا اِعتَقَلَه",63,"ل",2,0],["أَو يَقوَ فَهِيَ لَهُ كَحُرَّةٍ عاقِلٍ","حَسناءَ يَهواها وَلا تُهويهِ",64,"ه",1,0],["أَو يَكُن طِبُّكِ الزِيالَ فَإِنَّ ال","بَينَ أَن تَعطِفي صُدورَ الجِمالِ",65,"ل",1,0],["أَو يَكُ أَقفَرَ مِنها جَوُّها","وَعادَها المَحلُ وَالجُدوبُ",66,"ب",1,0],["أَوْ يَلتقي في مَنامي","خيالُهُ معْ خَيالي",67,"ي",1,0],["أو يبصرو في العالم المستور ما","لم يبصروا في العالم المنظور",68,"ر",1,0],["أوى إلى كهفٍ بسفح الجبلْ","عساهُ يقضي ليله في سلامْ",69,"م",1,0],["أو يقرأوا تاريخَهُ فصحيفةٌ","إمضاؤُه فيها عُلىً وفخارُ",70,"ر",1,0],["أو يبحثوا عن قبْرِهِ فمكانهُ","فيما يُظِلُّ العُشْبُ والأزهارُ",70,"ر",1,0],["أو يكُن بات لا يرى الحب هذا ال","كوكب الهادي الصدوقَ الوفيّا",71,"ي",2,0],["أو يكُن جسمُك الحيّ عرَتهُ","هزّةٌ من عواطفٍ كامنات",71,"ت",1,0],["أو يكن قد تورّدَ الخدّان","خَجَلاً من رؤىً ملئنَ أثاما",71,"م",2,0],["آوي إلى جنباتِ الصخرِ منفرداً","أبكي لأمسيةٍ مرَّت وليلاتِ",72,"ت",1,0],["أو يُلاشي فيك حَيّا مثلما","يتلاشى في الضحى لُمح الشهابْ",73,"ب",1,0],["أوى الى أطنابه اليمامُ","لأنها الرحمة والغمامُ",74,"م",1,0],["أَوْ يَقْحَمُ المَوْتَ الجَسُورُ وَعَلَّهُ","قَدْ جَرَّأَتْهُ عَقِيدَةُ الآجَالِ",75,"ل",1,0],["أَوْ يَسْتَقِلُّ بِهِ مُغَيرٌ مُنْجِدٌ","جَوَّابُ آفَاقٍ كَبَرْقٍ وَارِي",76,"ر",2,0],["أَوَيْتُ إلَى السَّمْحِ مِنْ ظِلِّهَا","وَفِي ظِلِّهَا الرَّوْحُ لِي وَالشِّفَاءْ",77,"ا",2,0],["أَوَى إِلى وَكْرٍ عَلَى شاِمخٍ","فَخانَهُ فِي المَأْمَنِ الوَكْرُ",78,"ر",1,0],["أوْ يُبْرِزُ الخَلْقَ السَّوِيَّ","فَلِلْحَيَاةِ بِهِ دَبِيبُ",79,"ب",1,0],["أَوْ يُتَابِعْ آثَارَهَا يَتَبَيَّنْ","مِنْ مَدَاهَا مَا لَيْسَ بِالمَحدُود",80,"د",1,0],["آوَيتُهُنَّ إلى الحَشَا","فَمَلأْنَ رَأْسِي بِالغِنَاءِ",81,"ا",2,0],["أو يستعبد البشر","فقولي إنه القمر!.",82,"ر",1,0],["آوى إِلى جَنَّةِ المَأوى وَغادَرَني","في غابِرينَ إِذا ما قُلتُ فوا لاذوا",83,"ذ",3,0],["أو يشتفي ببكاءٍ","مَن شأنُه مثلُ شأني",84,"ي",1,0],["أوى السجن فيه كلُّ شيخٍ مهدَّمٍ","وكلُّ صبيّ ناعماتُ أظافره",85,"ر",2,0],["أو يصدقوا فيه فيا","لله من هَوْل المصاب!",86,"ب",1,0],["أو ينتفعْ بمحمد","صلَّى عليه وسلَّما",87,"م",2,0],["أو يَدْرُجُوا فوق الثَّرى، لا تلبث الْ","أَقدام بالأَلْغام أن تتعثَّرا",88,"ر",2,0],["أو يرقدوا، حلموا بضرٍّ منكمو","قد هبَّ من تحت السرير مُشَمِّرا",88,"ر",2,0],["أو يطََّرِدْ قانِصٌ قَنيصاً","أو تُعْجبِ الأغيدِينَ غِيد",89,"د",1,0],["أو يكثُرُ الأبطالُ حين سِلاحُهم","بين الجْموع قَصيدةٌ وكَلام؟",90,"م",1,0],["أوى فنور الفرقدين ضئيل","وعلى المنازل رهبة وذهول",91,"ل",1,1],["أوَيْتُ لأبْنَاءِ الطّرِيقِ مِن امْرِىءٍ","شَرُوبِ الأداوِي للرّكِيّ دَفُونِ",92,"ن",1,0],["أو يلتقي الإضْحاءُ والإعْتَامُ","بحران ما بينهما التئامُ",93,"م",1,0],["أو يذو أغصانَها الزمانُ فقد","جنيتُ منها مَطايب الثمر",94,"ر",1,0],["أو يردَّ الحكمَ عنه بالرضى ،","فَعَلَيْنَا حُكْمُهُ فِيمَا کحْتَكَمْ",95,"م",1,0],["أو ينكروا أدبي فلا تتعجبوا","فالرمد طلوع ذكاء",96,"ا",2,0],["آويتُهُ حتى تكفّتَ حامِداً","وأهلَّ بَعْدَ جُماديينَ حَرامُ",97,"م",1,0],["اويقات لدى حبي قصار","وآهاتي لفرقته طوال",98,"ل",1,0],["أو يُبْرِئُ اللهُ إنسانًا يَلُوذُ بهِ","حياتُه الزَّيْفُ، والتَّضليلُ والعِلَلُ",99,"ل",1,0],["أو يعبس النور من شجوٍ يهضمني","أو يخرس الطير بلبالي ووسواسي",100,"ي",1,0],["أو يشعب الصبر أكباداً فيذهلها","عن ذكرنا ففؤادي ليس بالناسي",100,"ي",1,0],["أو يكوننّ بعيداً نازحاً","فزرِ العامَ عزيزاً أو أَقِلُّ",101,"ل",1,0],["أو يَرَى القَولَ صَادَمَ الذِّكرَ أو صَا","دَمَ لِلمُصطفي الأمِينِ مَقَالا",102,"ل",2,0],["أَو يَنتَهونَ عَنِ الأَمرِ الَّذي وَقَفوا","فيهِ وَيَرضَونَ مِنّا بَعدُ بِالدونِ",103,"ن",1,0],["أَو يُؤمِنوا بِكتابٍ مُنزَلٍ عَجَبٍ","عَلى نَبِيٍّ كَموسى أَو كَذي النونِ",103,"ن",1,0],["أو ينتهينَ إلى جنابٍ ترتعى","فيه الوفودُ منابتَ الإحسانِ",104,"ن",1,0],["أَو يَحتَمي مُستَجيرُ الرومِ مِن مَلِكٍ","يُزجي الكَتائِبَ مِلءَ الأَرضِ بِالكُتُبِ",105,"ب",1,0],["أَو يَنثَني بِدَمِ الكُماةِ مُخَلَّقاً","مِثلَ العَروسِ مُضَمَّخاً بِخَلوقِهِ",106,"ق",2,0],["أو ينصر الدين والجهال تهضمه","ويستحي أو يراعي حرمة الصحب",107,"ب",1,0],["آوى إِلى نارِيَ وَهيَ مَألَفٌ","يَدعو العُفاةَ ضَوؤُها إِلى القِرى",108,"ا",1,0],["أَو يَكُن ما اِنفَكَّ لَدغُ زَمانٍ","فَعَساهُ أَن يَرُفَّ رَفيفا",109,"ف",2,0],["أَو يَكُن هَبَّ نَسيماً","فَلَهُ يَوماً هُيوفُ",110,"ف",1,0],["أوَ يُرْتَجى مِن قابعٍ سَبْرُ العُلى ؟","إنَّ العُلى لا تَرتضي مَنْ أقْفَرا",111,"ر",2,0],["أُويْقاتُ أَعطافِ الشَبيبةِ غَضةٌ","عَلى نَسَمات اللَّهوِ مالَت تَأَوّدا",112,"د",2,0],["أويناديك بخطب","صاحب فيه كدوح",113,"ح",1,0],["أو يعاطيك كؤوس","الراح معشوق صبيح",113,"ح",1,0],["أَو يَكُن في الفُؤادِ داءٌ قَديمٌ","فَلَدَيهِم لِكُلِّ داءٍ دَواءُ",114,"ا",2,0],["أَو يَرَوني أَفلَستُ مِن عَمَلِ البر","رِ فَمِنهُم نالَ الغِنى الأَغنِياءُ",114,"ا",2,0],["أَو يكونُ القبولُ منكم جواباً","وَجَزاءً له ونعم الجزاءُ",114,"ا",2,0],["أَو يَبغِ مَعروفاً لَدَيكَ غَداً","يَنحى عَلَيهِ حادِثٌ نُكرُ",115,"ر",1,0],["أو يَنتَشي إلّا بدَمعي","حينَ يُذنِبُ واعتِذاري",116,"ي",1,0],["أو يَرتجي إلّا قُنوطي","ليسَ إلّا وانتِحاري",116,"ي",1,0],["أو يَبتَغي إلّا انقِباضي في","التداني وانِحصاري",116,"ي",1,0],["أو يَغلِبِ الشرُّ لا كانَت عصابَتُه","عُدِدتَ في صَرحهِ أقوى الأَساطينِ",117,"ن",1,0],["أو يستنيموا للخطر","وبحسبهم منك النظر !",118,"ر",1,0],["أو يَلحَقا رُتبتي لديك وهل","يَلحَق حافٍ بِذي جَناحين",119,"ن",1,0],["أو يممَّتْنا تروم نُصْرتنا","صارخةٌ باسمنا حَميْناها",120,"ا",3,0],["أَو يَنجَعُ العَذلُ في مُحِبٍّ","دُموعُهُ فيكُمُ نَجيعُ",121,"ع",1,0],["أَو يَطمَعُ الأَعداءُ فيهِ وَأَنتُم","أَبطالُهُ وَلُيوثُهُ وَكُماتُهُ",122,"ت",2,0],["أو يدرك الرادار رجع صدى له","حول السهى بتذبذب الأمواج",123,"ج",1,0],["أو يخضع الإنسان عنصر ذره","بسديد تفكير وحسن علاج",123,"ج",1,0],["أو يَغتَدى كَلَفاً بلَثم عذاره","يَومَ الوداع وقد أماط لثَامَهُ",124,"م",2,0],["أو يخفي عليك يا لوذعي","النقد زيف طليته تزيينا",125,"ن",2,0],["أو يخفى ساري الدياجي وقد","لاح له من جبينه مصباح",126,"ح",1,0],["أَوَيْتُ إلَى عَلْيَاءَ غَيْرَ مُنَهْنِهٍ","فُؤَاداً عَلَى الإِخفَاقِ يَسْتَنجِزُ الوَأْيَا",127,"ي",2,0],["أَوَيْتُ إِلى دارِ الإمارَةِ أجْتَلِي","مَطالِعَ نُور لِلهِدايَة لائِح",128,"ح",1,0],["أوَى الدّين من سُلطانِه لِمُناجِزٍ","مُناوئَه بَسْلٍ على الدّم بالذّبِّ",129,"ب",1,0],["أوَى إلى أضْعَف الأركان مُستنداً","وأين من كاسراتِ الطير يُؤْيُؤُهُ",130,"ا",2,0],["أَوى لي فَآواني يَفاعاً مُمَنَّعاً","حَمِيّاً حَميدَ الفِعلِ غَيرَ مُذَمَّمِ",131,"م",1,0],["آوَيتُ دِهليزَكَ مُنذُ أَربَعٍ","وَلَم أَكُن آوي الدَهاليزا",132,"ز",2,1],["آوى بها كلَّ العلوم فأَصبحت","وَطناً لها إذ أَقفرت أَوطانُها",133,"ن",3,0],["أو يكن فرداً وَحيداً","حاوَل القومُ اهتضامه",134,"م",2,0],["أَو يُصبِحَ الرَحلُ لَنا آيَةً","لا يَعذِرُ الناسُ بِما نَعتَذِر",135,"ر",1,0],["أَو يَنسَأَن يَومي إِلى غَيرِهِ","أَنّي حَوالِيٌّ وَأَنّي حَذِر",135,"ر",1,0],["أو يعود الذي قد","فات يا مستعيد",136,"د",1,0],["أو يَعلمُ الجراحُ أىَّ يتيمةٍ","قُطعت لدامَ من الفجيعةِ ذاهلا",137,"ل",2,0],["أَو يُشرِكَنَّكَ ما اِستَطاعَ بِجُهدِهِ","في حَملِهِ فَالعاشِقونَ رِفاقُ",138,"ق",1,0],["أو يمتّع كلاهما بشباب","أفدح الخطب ميتةٌ في الشباب",139,"ب",1,0],["أويا إلى الغار الكريم فعشّ","شت فوق المغار هواتف الأسحار",140,"ر",1,0],["أو يُدّوّرهما فما أظمَأ القب","لة تهفو إلى خدود الحسان",141,"ن",1,0],["أو يحدّي عن الغرام فقد تص","بح أنت الخليّ عبد الغواني",141,"ن",2,0],["أويكُ الحزن نشيداً فهو","في الأرض صداه",142,"ه",1,0],["أو يبابا تزمزِمُ الجنّ فيه","وترى العين رقصة المتشفّى",143,"ف",2,0],["أَو يُسأَلُ المالَ فِداءً لا اِفتَدى","أَو يَغفُلُ القَومُ قَليلاً لا اِنقَضى",144,"ا",1,0],["أوَيتُ رَبعاً لا المُقيمَ بِظِلِّهِ","عَوني وَلا لي مَطمَعٌ في رَفدِهِ",145,"د",2,1],["أَو يُرجِعُ الدَهرُ لي بَمَعهَدِهِم","عَهدَ اِجتِمعي بِعودِ أَعيادي",146,"د",2,0],["أَو يَنل بِالنَهي أَخو الحلم مَجدا","فَلأَنتَ الأَحَقُّ بِالتَمجيدِ",147,"د",1,0],["آوى الوفاءَ إلى كريمِ جَنابه","إذ كان في هذا الزّمان غَريبا",148,"ب",2,0],["أَو يَتَمادى فقَد شَكرتُ وحم","مَلتُ ركاباً ورَكبها ثِقلا",149,"ل",2,0],["أَو يُعيدَ الكَرى كَما كانَ لا يو","حِشُني مِن خَيالِكَ الطرَّاقِ",150,"ق",1,0],["أو يرى المسجون فيها","مجرماً ذِكْرَ النباههْ",151,"ا",3,0],["أو يختشي عند دفع الظلم من ظالم","بالحق للحق ناصر مسعد قائم",152,"م",1,0],["أو يمَّمَ الطلاّبُ يَمَّ مكارمٍ","إلاّ وأنت مُنَاهمُ والمقصدُ",153,"د",1,0],["أو يبلغ لي حتى ولو كتاب","أكتبه من نور عيني",154,"ي",1,0],["أو يكن قرره مَنْ دونه","فقد انسدت طريق الجدل",155,"ل",1,0],["أو يؤخر عشاءه فهو أولى","إن أحب الضياء ترك عتابي",156,"ي",1,0],["أو يُروَّى بِرُؤْيتِي وجهَه المي","مونَ قَلبِي الصّادِي وطَرْفي السّكُوبُ",157,"ب",1,0],["أو يَخفى عن عيونٍ أبْصَرَتْ","بوجود ابن ذكاء ابن جلا",158,"ل",2,0],["أوَيُغريني وميضٌ خُلَّبٌ","وشراب لم يكن إلاَّ سرابا",159,"ب",2,0],["أوى إلى الله فيا حبَّذا","مأوى جميل الظَّنّ مستيقن",160,"ن",1,0],["أو يطلقون من الأسار عصابة","غلّتهم الأَشواق في أَغلال",161,"ل",1,0],["أو يتحسَّسُ بلسان الحكمة, واللامعنى","حين يمصُّ ثنايا امرأة في قُبلتها الأولى",162,"ل",2,0],["أويقات أنس قد سلفن بلذة","وعصر هنيّ كان يحسب من عمري",163,"ر",2,0],["أو يقاسُ الصحيحُ بالفَدْمِ أو هل","ينظرَنْ ظلمةَ الدُجى كالنُورِ",164,"ر",1,0],["أو يهُمَّ السماءَ أن ينبحَ الكل","بُ ألا فابعُدَنْ بكلبٍ حقيرِ",164,"ر",1,0],["أو يوازي برأيك الشم أخجل","ت من الرأي والحجا ابني شمام",165,"م",1,0],["او يذكر الفضل كان الفضل فضلهم","فالعلم والحلم والايمان والورع",166,"ع",1,0],["أَوْ يَحْسُدُونَكَ رُتْبَةً فَليَرْتَقُوا","فَالشَّمْسُ فِي جَوِّ السماءِ السَّامِي",167,"م",2,0],["أَوْ يُوجِسُ السَّمْعُ النَّذِيرَ بِمُنْذِرٍ","ضَرِمَ العَجَاجِ مُصَمِّمَ الصَّمْصامِ",167,"م",1,0],["أو يستعير كسيوة","من غيره يتقسس",168,"س",1,0],["أو يبغضوني بنو دهري عذرتهم","قبلي فقد بغض الهادي أبو لهب",169,"ب",1,0],["أو يدانيه ذبول أو غير","أو كبحر مذ صفا الماء به",170,"ه",1,0],["أو يجمعوا لمجدهم في قصر","زينة كل بلدة وقطر",171,"ر",1,0],["أو ينعموا يوما على ذي فقر","بنعمة قصد الثنا والشكر",171,"ر",1,0],["أويتهم ساروا على","منهاج اجداد هزابر",172,"ر",1,0],["أو يفلق الذرات فهي جهنم","للغاشمين وجنة العلماء",173,"ا",2,0],["أو يستحلَّ حِماك الجدبُ يقتلُه","عاماً فعاماً فهذي الأشهرُ الحُرُمُ",174,"م",1,0],["أو يُقْذَ وقتٌ ثم يُجلَى القذى","فالجوّ لا يُمطِرُ حتى يغيمْ",175,"م",1,0],["أو يُكفَر الحقُّ ولابدَّ أن","يُحرَمَ طيبَ النعمةِ الكافرُ",176,"ر",1,0],["آوي إلى حِصن الشبابِ يجود لي","ما لا يحوط قبائلي وعشائري",177,"ر",2,0],["أو يُنضَ بعدَك عنها حسنُها فلها","بقربِ غيركِ أثوابٌ من العارِ",178,"ر",1,0],["أو يجلسوا نظراً ليوم تشاورٍ","فالريثُ أحزمُ ما أرابَ بِدارُ",179,"ر",1,0],["آويته فحميته من ذُعْرِه","دُون الرجال وكان عينَ المُسلَمِ",180,"م",1,0],["آويتَ ثم قرَيْت غيرَ مُسوِّفٍ","وكففتَ من هَمِّ المُسيفِ المرمل",181,"ل",1,0],["آويتهُ فحميتهُ ورفَدتَهُ","فغَدا بجْورِ زمانه لم يحْفِلِ",182,"ل",1,0],["آوى أميرُ المؤمنينَ مُحمَّدٌ","بددَ الضيوف فكلُّ وعْرٍ مُسْهَل",183,"ل",1,0],["أو ينتصرْ لي فالسحاب إذا سقى","أدنى وأيسرُ حقهِ أن يُشكرا",184,"ر",2,0],["آويته في القلب وهو كناسه","فعلام تملوه الجفون نصالا",185,"ل",2,0],["أويقات أنفاس اليواقيت تنقضي","سبهللا إلا في الصفات البهيميه",186,"ي",2,0],["أو يَقتَفيهِ البدرُ في سعي العُلا","لم يرضَ في شرفِ الثُريّا مَسكنا",187,"ن",2,0],["أو يهدي الركب إذا أظلموا","نجم أبوه القمر الزاهر",188,"ر",1,0],["أَو يَهلَكوا كَهَلاكِ عادٍ قَبلَهُم","بِهُبوبِ ريحٍ ذاتِ سافٍ عاصِفِ",189,"ف",1,0],["أَو يُؤمِنوا بِمُحَمَّدٍ وَيُكَبِّروا","ذا العَرشِ ما إِن مُؤمِنٌ كَمُخالِفِ",189,"ف",1,0],["أوَ يَحظى الشَّرقُ دَوماً بك إذ","لا يَرَاكَ الغَربُ يا ما أعدَلك",190,"ك",1,0],["آوِي هَواها بعدما","أسكنتُ في أَعلا رُباها",191,"ا",3,0],["أَو يَلحقوا ما اِمتدَّ من شَأْوِنا","في طلب العزّ فلم يلحقوا",192,"ق",3,0],["أَو يَبتَغي في نَجاحِ حاجَتِهِ","إِلّا ظُبا البيضِ وَالقَنا سَببَا",193,"ب",2,0],["أَو يَتبعوا ساعةً مِنَ الدّهرِ مَن","كانَ لِمَن شئتَ تابعاً حَقِبا",193,"ب",2,0],["أو يدسون بنثري نثرهم","ذلك الكفر ويلقون لدي",194,"ي",1,0],["أو يستوى الإلهام بالأ","ملاك معْ نُطْقِ القرين",195,"ن",1,0],["أو يشأ قال وحدة النور عنه","كلمات ما هن للدين خرق",196,"ق",1,0],["أو يترك الإنكار إن لم يكن","يدري ويصغي لكلام النصوح",197,"ح",1,0],["أو يجوزُ الطَّوافُ والسَّعْيُ بها","وَيَلَبَّى ويُرْمى بالخْمرَاتْ",198,"ت",1,0],["أو يجوزُ القرآنُ والذكرُ بها","أو يجوزُ التسْبيحُ في الصَّلوَاتْ",198,"ت",1,0],["أَوْ يَبْلَ مِنْ جِسْمِكَ رَيْعَانُهُ","فَهَكَذَا تَنْمِي وَتَبْلَى القُرُونْ",199,"ن",1,0],["أو يَنَاجِي عبدَ الحميد لِمّا أعْ","جَبَ مَرْوَانَ لفظُ عبدِ الحمِيْدِ",200,"د",1,0],["او يجمع الله شملاً بالنوى انصدعت","منه العصا ففؤاد الصب مكلوم",201,"م",1,0]]}