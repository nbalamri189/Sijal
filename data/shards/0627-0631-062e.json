{"poems":[[65,"لله أي فتى مجد تناوشه","https://www.aldiwan.net/poem45903.html","البسيط"],[88,"لله درك كنت من رجل","https://www.aldiwan.net/poem10491.html","أحذ الكامل"],[75,"وضح الحق المبين","https://www.aldiwan.net/poem11841.html","مجزوء الرمل"],[75,"أرخصتني من بعد ما أغليتني","https://www.aldiwan.net/poem11889.html","الكامل"],[75,"خنت عهدي ولم أخن","https://www.aldiwan.net/poem11969.html","مجزوء الخفيف"],[95,"هو يوم أغر مبتسم","https://www.aldiwan.net/poem11188.html","الخفيف"],[95,"ربة الدولة والجاه المكين","https://www.aldiwan.net/poem11231.html","الرمل"],[95,"لا تبن أيها المحيا الوسيم","https://www.aldiwan.net/poem11339.html","الخفيف"],[49,"ما العمر ماطالت به الدهور","https://www.aldiwan.net/poem24771.html","الرجز"],[74,"مبلبل الأصداغ والطره","https://www.aldiwan.net/poem18697.html","السريع"],[53,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[93,"أمست ثيابي وكلها خرق","https://www.aldiwan.net/poem8984.html","عموديه"],[93,"ما للهموم الطارقات ومالي","https://www.aldiwan.net/poem62625.html","عموديه"],[72,"يا قلب بعض الناس هل","https://www.aldiwan.net/poem42398.html","مجزوء الكامل"],[87,"سكن الزمان ولانت الأقدار","https://www.aldiwan.net/poem62969.html","الكامل"],[64,"يا أيها المولى الذي اصطنع الورى","https://www.aldiwan.net/poem52507.html","مجزوء الكامل"],[60,"إن المنية شربة مورودة","https://www.aldiwan.net/poem30927.html","الكامل"],[68,"يا نسمة لأحاديث الحمى شرحت","https://www.aldiwan.net/poem41359.html","البسيط"],[71,"زنار بنت النصارى","https://www.aldiwan.net/poem28137.html","المجتث"],[71,"واعجبي من طول ليلي وقد","https://www.aldiwan.net/poem28254.html","السريع"],[107,"حملت سناك مواكب الأعوام","https://www.aldiwan.net/poem42074.html","الكامل"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[50,"ما لي بدار خلت من أهلها شغل","https://www.aldiwan.net/poem64514.html","البسيط"],[52,"أنى شبابك قد مضى محمودا","https://www.aldiwan.net/poem63930.html","الكامل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62212","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54605","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54264","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54244","الكامل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54220","البسيط"],[111,"لا تترك الأنفاس في الهزل سدى","https://www.poetsgate.com/ViewPoem.aspx?id=532",""],[92,"قتل العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179140",""],[93,"بالاسكندرية","https://www.poetsgate.com/ViewPoem.aspx?id=53217",""],[96,"الحبّ والله","https://www.poetsgate.com/ViewPoem.aspx?id=15625",""],[119,"قسما برقة خصرك الميال","https://www.aldiwan.net/poem40624.html","عموديه"],[119,"يا عين جودي بالدموع وهات","https://www.aldiwan.net/poem41197.html","عموديه"],[146,"عذب من الماء قد سدت موارده","https://www.aldiwan.net/poem58328.html","البسيط"],[164,"أرخا أثيث الدجى الجاني على الفلق","https://www.aldiwan.net/poem59000.html","البسيط"],[182,"أرخى الضفائر","https://www.aldiwan.net/poem50716.html","البسيط"],[216,"وميالة العطفين غرثانة الحشى","https://www.aldiwan.net/poem37870.html","الطويل"],[225,"أرخصت يوم فراقك الدمعا","https://www.aldiwan.net/poem55275.html","أحذ الكامل"],[233,"تميط الأذى عن حامليها الصوارم","https://www.aldiwan.net/poem50832.html","الطويل"],[239,"أصبحت ظلا على من ظل دولته","https://www.aldiwan.net/poem31952.html","البسيط"],[274,"يا جنة الحسن حر الصيف أمحلك","https://www.aldiwan.net/poem35314.html","البسيط"],[274,"سلت مهندها فخف من حده","https://www.aldiwan.net/poem35414.html","الكامل"],[274,"صافح من العرب الأمجاد أحبابا","https://www.aldiwan.net/poem35654.html","البسيط"],[275,"ضحك تبروق الابرقين تبسما","https://www.aldiwan.net/poem52106.html","الكامل"],[309,"يمم جياد القول خير ميمم","https://www.aldiwan.net/poem56411.html","الكامل"],[324,"يا سريا له السعادة وافت","https://www.aldiwan.net/poem67206.html","الخفيف"],[332,"أبنجواي من رقيق النشيد","https://www.aldiwan.net/poem55060.html","الخفيف"],[357,"ما راح بدر المعالي يمتطي الفلكا","https://www.aldiwan.net/poem40008.html","البسيط"],[365,"بدا فأشبه غصن البان في الميل","https://www.aldiwan.net/poem68076.html","البسيط"],[365,"خد عليه الورد ما","https://www.aldiwan.net/poem68081.html","مجزوء الكامل"],[365,"أبدا تحن اليكم الارواح","https://www.aldiwan.net/poem68126.html","الكامل"],[404,"خديجة رضي الله عنها","https://www.aldiwan.net/poem6774.html","عموديه"],[420,"إسأل الأرسم لو ردت جوابا","https://www.aldiwan.net/poem54032.html","الرمل"],[420,"في الأربعاء لخمس كن من صفر","https://www.aldiwan.net/poem54082.html","البسيط"],[433,"ورق التهاني الوافيه","https://www.aldiwan.net/poem41000.html","مجزوء الكامل"],[433,"يا بيعة مشرقة","https://www.aldiwan.net/poem41060.html","مجزوء الكامل"],[436,"لو حل عن خديه عقد لثامه","https://www.aldiwan.net/poem12734.html","الكامل"],[461,"ما كنت لولا طمعي في الخيال","https://www.aldiwan.net/poem55936.html","السريع"],[467,"باحت بنجد وهوى غزلانها","https://www.aldiwan.net/poem3273.html","عموديه"],[480,"خاطبت بعدكم الأطلال والدمنا","https://www.aldiwan.net/poem15328.html","البسيط"],[554,"خذ صاحبي عني الذي أملي","https://www.aldiwan.net/poem47284.html","أحذ الكامل"],[554,"لو كنت في مثل حالي لم ترد عذلي","https://www.aldiwan.net/poem47288.html","البسيط"],[561,"يا قلب أحبابنا جسمي بهم بالي","https://www.aldiwan.net/poem34245.html","البسيط"],[562,"للعيس شوق قادها نحو السري","https://www.aldiwan.net/poem69355.html","الكامل"]],"verses":[["أُرْخِي عِطافِي وِأُضْحِي غَيْرَ مُحْتَفِلٍ","بِها وَقَدْ شُدَّ مِنْ غَيْري لَها الأُزُرُ",0,"ر",1,0],["أَرخَصتُ فيها كُلَّ غالِيَةٍ","وَذَكَرتُ فيها وَقفَةَ الطَلَلِ",1,"ل",1,0],["أَرخَصَ الحُبُّ فُؤادي","لَكَ وَالعِلقُ ثَمينُ",2,"ن",1,0],["أَرخَصتِني مِن بَعدِ ما أَغلَيتِني","وَحَطَطتِني وَلَطالَما أَعلَيتِني",3,"ن",2,1],["أَرخِصِ البَيعَ كَيفَ شِئ","تَ وَذَرني لَتَندَمَن",4,"ن",1,0],["أَرَّخَ الشَّرْقَ فَهْوَ عَالِمُهُ","وَهْوَ مُعْطِيهِ عُمْرَهُ الثَّانِي",5,"ن",2,0],["أَرْخَصَ العَسْجَدَ حَتَّى إِنَّهُ","جَازَ فِي المَأْلُوفِ أَنْ يُسْمَى بِطِينْ",6,"ن",1,0],["أَرَّخَ النُّوبَ لَمْ يَفُتْهُ حَدِيثٌ","مُسْتَفَادٌ وَلَمْ يَفُتْهُ قَدِيمُ",7,"م",1,0],["أَرخى لَهُ بِنَبجِهِ رِجلَيهِ","وَالمَوتُ قَد سابَقَهُ إِلَيهِ",8,"ه",1,0],["أرخى على أعطافه شعرة","قد جذبتني فيه للحسره",9,"ر",2,0],["أرخصتْ كفُّهُ العطايا وأغْلَتْ","حَمْدَ سُوَّامِها على السُّوَّام",10,"م",1,0],["أَرخى الدُجى ذَيلَهُ وَرُحتُ أَجُرُّ","الذَيلَ عُجباً وَغَيرِيَ النَزِقُ",11,"ق",1,0],["أَرخَصنَ ماءَ الجَفنِ ثُمَّ أَذَلنَهُ","وَلَقَد يَكونُ الدَمعُ غَيرَ مُذالِ",12,"ل",1,0],["أَرخَصتُ فيكَ مَدامِعاً","لَولاكَ كانَت غالِيَه",13,"ي",2,0],["أَرخى الأَعِنَّةَ لِلخُطوبِ وَرَدَّها","فَلَكٌ بِكُلِّ فُجاءَةٍ دَوّارُ",14,"ر",1,0],["أرخَى فضولَ عِنانه لمَّا جَرَى","فكبَا وكَبَّا",15,"ب",2,0],["إِرخِ الزِمامَ وَلا تَخَف مِن عائِقٍ","فَاللَهُ يُرديهُم عَنِ التَنكيلِ",16,"ل",1,0],["أَرخى الحِذارُ عَلى الأَرماحِ أَيديهِم","فَكُلَّما حاوَلوا طَعناً بِها سَبَحَت",17,"ت",1,0],["أرخانيَ الشدُّ منْهُ","وكثرةُ الشدِّ ترخي",18,"ي",1,0],["أرخى على الليلِ ذؤاباتِهِ","فما استطاعَ الظبيُ أن يدخلا",19,"ل",2,0],["أَرْخِي زمامَكِ لا عِثارَ لآخذٍ","من ربّه وكتابهِ بزمامِ",20,"م",1,0],["أَرْخَصُوا في الوغَى نُفُوسَ مُلُوكٍ","حارَبُوها أسلابُها إغْلاءُ",21,"ا",2,0],["أَرخَت عُقوداً مِنَ الياقوتِ مِدمَجَةً","صُفراً وَحُمراً بِها كَالجَمرِ يَشتَعِلُ",22,"ل",1,0],["أَرخَت عَلى قَصَبِ الرَوادِفِ فَاِنثَنَت","كَالخَيزُرانَةِ لَدنَةً أَملودا",23,"د",2,0],["أُرْخِي العِذَارَ وإِنْ طَالَتْ قَبَائِلُهُ","عَنْ حَشْرَةٍ مِثْلِ سِنْفِ المَرْخَةِ الصَّفِرِ",24,"ر",1,0],["أَرْخَصْتُمُ مَا عَزَّ فِي تَهْذِيبِهِمْ","وَلِكُلِّ تُفْدِيةٍ جَمِيلُ ثَوَابِ",25,"ب",1,0],["أرختْ شعوراً للنسيمِ كأنّما","أظلالُها تحت الغَمامِ غمام",26,"م",1,0],["أرخى غدائرَها الحياءُ كأنها","عَذراءُ تخلِطُ لينها بجِماحها",27,"ح",3,0],["أرختْ غدائرَها أخلاطَ نافِجةٍ","وأرسلتْ ذيلَها ورداً ونِسْرينا",28,"ن",2,0],["أرخته صدقا هيا بشراكم","مدارج الكمال طبعا كملا",29,"ل",2,0],["أرخَصّتُها وهي علقٌ لا كِفاءَ لَهُ","ورُحْتُ أصْفِقُ فيها كَفَّ مغلوب",30,"ب",1,0],["أرخصن ماء الجفن ثمّ أذلته","ولقد يكون الدّمع غير مذال",31,"ل",1,0],["أرخصت للدمع جفني ثم باكره","في هدأة الفجر طيف منك أغلاه",32,"ا",2,0],["ارخصتني فقطعت حبل مودتي","يا ايها الريم العزيز الغالي",33,"ل",2,0],["ارخته وادي الصفاء ممجد","علم الحما حسن ابو البركات",34,"ت",1,0],["أرخى ذوائَبه دونى يُشكِّكُنى","أَهْى التي سترتُه أم ولائدُهُ",35,"د",2,0],["أرخا أثيث الدجى الجاني على الفلق","وسل مصقولة بيضا من الحدق",36,"ق",1,1],["أرْخي الضَّفائرَ عَلّ الشّعْرَ يُلْهِمُني","شِعْراً يُكَفكِفُ دمعَ الحرفِ في وَرَقي",37,"ق",2,1],["أرَخص نفسي في هواها وأدْمُعي","وما عُوِّدَتْ قبلَ العَلاقةِ تَرّخُصُ",38,"ص",1,0],["أرخصت يوم فراقك الدمعا","وأصم وقع أنينك السمعا",39,"ع",2,1],["أرْخَتْ على الّليالي جَوْرَهُنّ ومَنْ","أيّامُه ظَلمتْه سوف يَنْظَلِمُ",40,"م",1,0],["أَرخى عَلى مَجلِسٍ ذَلَّ الزَمانُ لَهُ","فَاِستَخدَمَ النَصرَ وَالتَأيِيدَ وَالظَفَرا",41,"ر",2,0],["أرخي النقابَ فنعمايَ الحنينُ إلى","ذَيَّالِكَ الفلكِ البادي من الحَلك",42,"ك",1,0],["أرخي النِّقابَ على المحيّا فالسَّنى","أن يَطلعَ المبيضُّ من مِسوَدّه",43,"د",2,0],["أرخي النقاب على الوجهِ الحيي ولا","تُعَرّضيه لعلجٍ عاب واغتابا",44,"ب",2,0],["أرخل من النيابَتين قَلائصا","في الدونا فرة تَبارى الاسهما",45,"م",2,0],["أَرخى ذَوائبهُ الوزيرُ المصطفى","أَكرِم بذلكِ منتمى للمنتمي",46,"م",2,0],["أَرخَتهُ يَدُ التَهاني فَقالَت","جانِسِ المَجدَ رُتبَةَ الناضوري",47,"ر",2,0],["أرخص الروح في الدفاع عن الدي","ن بعزم يفلّ غفل الحديد",48,"د",1,0],["أَرّخت عُد حائِزاً بِالعود نَيل هنا","تَقبّل اللَه مِنكَ الحَجّ وَالنُسكا",49,"ك",2,0],["أَرخى عَلى الصُبح لَيلا من ذَوائِبِهِ","فَاِستَقبَح الصُبح أَن يَبدو من الخَجَل",50,"ل",1,0],["أَرّختُه زهر الربا","في وَجهِ اِبراهيمَ راق",51,"ق",1,0],["أَرّخته أَبدا بِعَهدِ جاكم","لاِبي الفَلاح تَجَدّد الاِفراح",52,"ح",1,0],["أرختْ لهُ جناحه","في رغبةٍ ورهَبِ",53,"ب",1,0],["أرْخَصَتْ لي كلَّ غالٍ فكأنْ","وَجَدتْ في جودها التبر ترابا",54,"ب",2,0],["أَرَّخْتُ طالِعَ داودٍ بمولِدِه","وكانتِ الشَّمسُ بالجوزاء طالِعَهُ",55,"ه",1,0],["ارخت فزت بنعمة","بكل عام آتيه",56,"ي",2,0],["أرّخت ان لآلها","فاضت بروح القدس",57,"س",1,0],["أرْخى ذوائبَهُ نقابَهُ","كالبدرِ بين ظلامِه وغمامِه",58,"م",2,0],["أرخصَ منها الودُّ ممنوعةً","غلتْ فلم يقدِر عليها المُغالْ",59,"ل",1,0],["أرخصت من مدامعي لآلنا","لو جمدت غاليت في أثمانها",60,"ن",3,0],["أرخصتُه بعدما بِنتمْ على دِمَنٍ","لم يبقَ للدمعِ مِن بعدِ النوى ثمنا",61,"ن",2,0],["أرخصتُ غيرَهمُ لأنّهمُ","يُغلون أثماني كما أُغلي",62,"ل",2,0],["أرخى لكمْ فحسبتُم لا زمامَ لكم","وليس يفْرِق فَوْتاً مُمِسكُ الطِّوَلِ",63,"ل",1,0],["أرخصتموا في هواكم مدمعي سفهاً","وهو العزيز الذي عهدي به غالي",64,"ي",1,0],["أرخ الازمَّة واتبعْها إِنهَّا","تدري الحمى النَّجْدِيّ مع من درى",65,"ر",2,0]]}