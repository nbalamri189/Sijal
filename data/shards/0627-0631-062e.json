sgate.com/ViewPoem.aspx?id=36281",""],[5121,"هَدِيَّةُ مَوْلِدِي","https://www.poetsgate.com/ViewPoem.aspx?id=214758",""],[5122,"غريب طبعك","https://www.poetsgate.com/ViewPoem.aspx?id=18651",""],[5187,"زيارة لقصر العظم","https://www.poetsgate.com/ViewPoem.aspx?id=29065",""],[5187,"سكرة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=29253",""],[5213,"صدقتك سلمى وعدها وودادها","https://www.poetsgate.com/ViewPoem.aspx?id=170455",""],[5213,"فئة قد أبغضونا","https://www.poetsgate.com/ViewPoem.aspx?id=170398",""],[5213,"وبعد أن تم الحديث الشافي","https://www.poetsgate.com/ViewPoem.aspx?id=170396",""],[5219,"جفف دموعك","https://www.poetsgate.com/ViewPoem.aspx?id=194802",""],[5277,"لست الحطيئة","https://www.poetsgate.com/ViewPoem.aspx?id=190909",""],[5353,"مشنقة","https://www.poetsgate.com/ViewPoem.aspx?id=214896",""],[5365,"ياشام","https://www.poetsgate.com/ViewPoem.aspx?id=190818",""],[5365,"تراتيل في محراب الألم","https://www.poetsgate.com/ViewPoem.aspx?id=191272",""],[5410,"صرخات من أعلى المنارة","https://www.poetsgate.com/ViewPoem.aspx?id=142533",""],[5411,"هذا غرامك","https://www.poetsgate.com/ViewPoem.aspx?id=185524",""],[5434,"يامشتري حظ","https://www.poetsgate.com/ViewPoem.aspx?id=37626",""],[5525,"هداج","https://www.poetsgate.com/ViewPoem.aspx?id=7284",""],[5546,"أرخ لها زمامها والأنسعا","https://www.poetsgate.com/ViewPoem.aspx?id=181006",""],[5574,"خالد","https://www.poetsgate.com/ViewPoem.aspx?id=206041",""],[5628,"أطياف على الضفاف","https://www.poetsgate.com/ViewPoem.aspx?id=178549",""],[5781,"فاتِحةُ الجمالِ وأولُ جرحٍ ...أنت","https://www.poetsgate.com/ViewPoem.aspx?id=208986",""],[5956,"حيوية حب","https://www.poetsgate.com/ViewPoem.aspx?id=182312",""],[5956,"غيري من الشعراء...","https://www.poetsgate.com/ViewPoem.aspx?id=193359",""],[5969,"لَيلُ العراق","https://www.poetsgate.com/ViewPoem.aspx?id=208708",""],[5975,"يا ظبيةً","https://www.poetsgate.com/ViewPoem.aspx?id=58787",""],[5977,"لا تعد","https://www.poetsgate.com/ViewPoem.aspx?id=213267",""],[6048,"أنَا المُدانَةُ","https://www.poetsgate.com/ViewPoem.aspx?id=197749",""],[6124,"أرق المنسرح","https://www.poetsgate.com/ViewPoem.aspx?id=104137",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[6198,"الموجةُ الطروبُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79239&r=&rc=13",""],[6314,"جدارية عارية للبحر والجسد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88073&r=&rc=8",""],[6318,"القدس في خطر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66164&r=&rc=14",""],[6358,"دخان الخرائط","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77584&r=&rc=43",""]],"verses":[["أُرْخِي عِطافِي وِأُضْحِي غَيْرَ مُحْتَفِلٍ","بِها وَقَدْ شُدَّ مِنْ غَيْري لَها الأُزُرُ",0,"ر",1,0],["أَرخَصتُ فيها كُلَّ غالِيَةٍ","وَذَكَرتُ فيها وَقفَةَ الطَلَلِ",1,"ل",1,0],["أَرخَصَ الحُبُّ فُؤادي","لَكَ وَالعِلقُ ثَمينُ",2,"ن",1,0],["أَرخَصتِني مِن بَعدِ ما أَغلَيتِني","وَحَطَطتِني وَلَطالَما أَعلَيتِني",3,"ن",2,1],["أَرخِصِ البَيعَ كَيفَ شِئ","تَ وَذَرني لَتَندَمَن",4,"ن",1,0],["أَرَّخَ الشَّرْقَ فَهْوَ عَالِمُهُ","وَهْوَ مُعْطِيهِ عُمْرَهُ الثَّانِي",5,"ن",2,0],["أَرْخَصَ العَسْجَدَ حَتَّى إِنَّهُ","جَازَ فِي المَأْلُوفِ أَنْ يُسْمَى بِطِينْ",6,"ن",1,0],["أَرَّخَ النُّوبَ لَمْ يَفُتْهُ حَدِيثٌ","مُسْتَفَادٌ وَلَمْ يَفُتْهُ قَدِيمُ",7,"م",1,0],["أَرخى لَهُ بِنَبجِهِ رِجلَيهِ","وَالمَوتُ قَد سابَقَهُ إِلَيهِ",8,"ه",1,0],["أرخى على أعطافه شعرة","قد جذبتني فيه للحسره",9,"ر",2,0],["أرخصتْ كفُّهُ العطايا وأغْلَتْ","حَمْدَ سُوَّامِها على السُّوَّام",10,"م",1,0],["أَرخى الدُجى ذَيلَهُ وَرُحتُ أَجُرُّ","الذَيلَ عُجباً وَغَيرِيَ النَزِقُ",11,"ق",1,0],["أَرخَصنَ ماءَ الجَفنِ ثُمَّ أَذَلنَهُ","وَلَقَد يَكونُ الدَمعُ غَيرَ مُذالِ",12,"ل",1,0],["أَرخَصتُ فيكَ مَدامِعاً","لَولاكَ كانَت غالِيَه",13,"ي",2,0],["أَرخى الأَعِنَّةَ لِلخُطوبِ وَرَدَّها","فَلَكٌ بِكُلِّ فُجاءَةٍ دَوّارُ",14,"ر",1,0],["أرخَى فضولَ عِنانه لمَّا جَرَى","فكبَا وكَبَّا",15,"ب",2,0],["إِرخِ الزِمامَ وَلا تَخَف مِن عائِقٍ","فَاللَهُ يُرديهُم عَنِ التَنكيلِ",16,"ل",1,0],["أَرخى الحِذارُ عَلى الأَرماحِ أَيديهِم","فَكُلَّما حاوَلوا طَعناً بِها سَبَحَت",17,"ت",1,0],["أرخانيَ الشدُّ منْهُ","وكثرةُ الشدِّ ترخي",18,"ي",1,0],["أرخى على الليلِ ذؤاباتِهِ","فما استطاعَ الظبيُ أن يدخلا",19,"ل",2,0],["أَرْخِي زمامَكِ لا عِثارَ لآخذٍ","من ربّه وكتابهِ بزمامِ",20,"م",1,0],["أَرْخَصُوا في الوغَى نُفُوسَ مُلُوكٍ","حارَبُوها أسلابُها إغْلاءُ",21,"ا",2,0],["أَرخَت عُقوداً مِنَ الياقوتِ مِدمَجَةً","صُفراً وَحُمراً بِها كَالجَمرِ يَشتَعِلُ",22,"ل",1,0],["أَرخَت عَلى قَصَبِ الرَوادِفِ فَاِنثَنَت","كَالخَيزُرانَةِ لَدنَةً أَملودا",23,"د",2,0],["أُرْخِي العِذَارَ وإِنْ طَالَتْ قَبَائِلُهُ","عَنْ حَشْرَةٍ مِثْلِ سِنْفِ المَرْخَةِ الصَّفِرِ",24,"ر",1,0],["أَرْخَصْتُمُ مَا عَزَّ فِي تَهْذِيبِهِمْ","وَلِكُلِّ تُفْدِيةٍ جَمِيلُ ثَوَابِ",25,"ب",1,0],["أرختْ شعوراً للنسيمِ كأنّما","أظلالُها تحت الغَمامِ غمام",26,"م",1,0],["أرخى غدائرَها الحياءُ كأنها","عَذراءُ تخلِطُ لينها بجِماحها",27,"ح",3,0],["أرختْ غدائرَها أخلاطَ نافِجةٍ","وأرسلتْ ذيلَها ورداً ونِسْرينا",28,"ن",2,0],["أرخته صدقا هيا بشراكم","مدارج الكمال طبعا كملا",29,"ل",2,0],["أرخَصّتُها وهي علقٌ لا كِفاءَ لَهُ","ورُحْتُ أصْفِقُ فيها كَفَّ مغلوب",30,"ب",1,0],["أرخصن ماء الجفن ثمّ أذلته","ولقد يكون الدّمع غير مذال",31,"ل",1,0],["أرخصت للدمع جفني ثم باكره","في هدأة الفجر طيف منك أغلاه",32,"ا",2,0],["ارخصتني فقطعت حبل مودتي","يا ايها الريم العزيز الغالي",33,"ل",2,0],["ارخته وادي الصفاء ممجد","علم الحما حسن ابو البركات",34,"ت",1,0],["أرخى ذوائَبه دونى يُشكِّكُنى","أَهْى التي سترتُه أم ولائدُهُ",35,"د",2,0],["أرخا أثيث الدجى الجاني على الفلق","وسل مصقولة بيضا من الحدق",36,"ق",1,1],["أرْخي الضَّفائرَ عَلّ الشّعْرَ يُلْهِمُني","شِعْراً يُكَفكِفُ دمعَ الحرفِ في وَرَقي",37,"ق",2,1],["أرَخص نفسي في هواها وأدْمُعي","وما عُوِّدَتْ قبلَ العَلاقةِ تَرّخُصُ",38,"ص",1,0],["أرخصت يوم فراقك الدمعا","وأصم وقع أنينك السمعا",39,"ع",2,1],["أرْخَتْ على الّليالي جَوْرَهُنّ ومَنْ","أيّامُه ظَلمتْه سوف يَنْظَلِمُ",40,"م",1,0],["أَرخى عَلى مَجلِسٍ ذَلَّ الزَمانُ لَهُ","فَاِستَخدَمَ النَصرَ وَالتَأيِيدَ وَالظَفَرا",41,"ر",2,0],["أرخي النقابَ فنعمايَ الحنينُ إلى","ذَيَّالِكَ الفلكِ البادي من الحَلك",42,"ك",1,0],["أرخي النِّقابَ على المحيّا فالسَّنى","أن يَطلعَ المبيضُّ من مِسوَدّه",43,"د",2,0],["أرخي النقاب على الوجهِ الحيي ولا","تُعَرّضيه لعلجٍ عاب واغتابا",44,"ب",2,0],["أرخل من النيابَتين قَلائصا","في الدونا فرة تَبارى الاسهما",45,"م",2,0],["أَرخى ذَوائبهُ الوزيرُ المصطفى","أَكرِم بذلكِ منتمى للمنتمي",46,"م",2,0],["أَرخَتهُ يَدُ التَهاني فَقالَت","جانِسِ المَجدَ رُتبَةَ الناضوري",47,"ر",2,0],["أرخص الروح في الدفاع عن الدي","ن بعزم يفلّ غفل الحديد",48,"د",1,0],["أَرّخت عُد حائِزاً بِالعود نَيل هنا","تَقبّل اللَه مِنكَ الحَجّ وَالنُسكا",49,"ك",2,0],["أَرخى عَلى الصُبح لَيلا من ذَوائِبِهِ","فَاِستَقبَح الصُبح أَن يَبدو من الخَجَل",50,"ل",1,0],["أَرّختُه زهر الربا","في وَجهِ اِبراهيمَ راق",51,"ق",1,0],["أَرّخته أَبدا بِعَهدِ جاكم","لاِبي الفَلاح تَجَدّد الاِفراح",52,"ح",1,0],["أرختْ لهُ جناحه","في رغبةٍ ورهَبِ",53,"ب",1,0],["أرْخَصَتْ لي كلَّ غالٍ فكأنْ","وَجَدتْ في جودها التبر ترابا",54,"ب",2,0],["أَرَّخْتُ طالِعَ داودٍ بمولِدِه","وكانتِ الشَّمسُ بالجوزاء طالِعَهُ",55,"ه",1,0],["ارخت فزت بنعمة","بكل عام آتيه",56,"ي",2,0],["أرّخت ان لآلها","فاضت بروح القدس",57,"س",1,0],["أرْخى ذوائبَهُ نقابَهُ","كالبدرِ بين ظلامِه وغمامِه",58,"م",2,0],["أرخصَ منها الودُّ ممنوعةً","غلتْ فلم يقدِر عليها المُغالْ",59,"ل",1,0],["أرخصت من مدامعي لآلنا","لو جمدت غاليت في أثمانها",60,"ن",3,0],["أرخصتُه بعدما بِنتمْ على دِمَنٍ","لم يبقَ للدمعِ مِن بعدِ النوى ثمنا",61,"ن",2,0],["أرخصتُ غيرَهمُ لأنّهمُ","يُغلون أثماني كما أُغلي",62,"ل",2,0],["أرخى لكمْ فحسبتُم لا زمامَ لكم","وليس يفْرِق فَوْتاً مُمِسكُ الطِّوَلِ",63,"ل",1,0],["أرخصتموا في هواكم مدمعي سفهاً","وهو العزيز الذي عهدي به غالي",64,"ي",1,0],["أرخ الازمَّة واتبعْها إِنهَّا","تدري الحمى النَّجْدِيّ مع من درى",65,"ر",2,0],["أَرخَى عَلَينا اللَّيلُ أَستارَهُ","فكُلُّ طرفٍ رامَنا خاسِ",66,"س",1,0],["أرخصت يوم البين سعر مدامعي","وتركت قلبي بالغرام مسعرا",67,"ر",2,0],["ارخى جعوداً في عبير","المسك فاحمها تغلف",68,"ف",1,0],["أَرخت عن الواشي لها غدائراً","سودا