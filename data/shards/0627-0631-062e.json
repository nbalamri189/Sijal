{"poems":[[63,"لله أي فتى مجد تناوشه","https://www.aldiwan.net/poem45903.html","البسيط"],[86,"لله درك كنت من رجل","https://www.aldiwan.net/poem10491.html","أحذ الكامل"],[73,"وضح الحق المبين","https://www.aldiwan.net/poem11841.html","مجزوء الرمل"],[73,"أرخصتني من بعد ما أغليتني","https://www.aldiwan.net/poem11889.html","الكامل"],[73,"خنت عهدي ولم أخن","https://www.aldiwan.net/poem11969.html","مجزوء الخفيف"],[93,"هو يوم أغر مبتسم","https://www.aldiwan.net/poem11188.html","الخفيف"],[93,"ربة الدولة والجاه المكين","https://www.aldiwan.net/poem11231.html","الرمل"],[93,"لا تبن أيها المحيا الوسيم","https://www.aldiwan.net/poem11339.html","الخفيف"],[47,"ما العمر ماطالت به الدهور","https://www.aldiwan.net/poem24771.html","الرجز"],[72,"مبلبل الأصداغ والطره","https://www.aldiwan.net/poem18697.html","السريع"],[51,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[91,"أمست ثيابي وكلها خرق","https://www.aldiwan.net/poem8984.html","عموديه"],[91,"ما للهموم الطارقات ومالي","https://www.aldiwan.net/poem62625.html","عموديه"],[70,"يا قلب بعض الناس هل","https://www.aldiwan.net/poem42398.html","مجزوء الكامل"],[85,"سكن الزمان ولانت الأقدار","https://www.aldiwan.net/poem62969.html","الكامل"],[62,"يا أيها المولى الذي اصطنع الورى","https://www.aldiwan.net/poem52507.html","مجزوء الكامل"],[58,"إن المنية شربة مورودة","https://www.aldiwan.net/poem30927.html","الكامل"],[66,"يا نسمة لأحاديث الحمى شرحت","https://www.aldiwan.net/poem41359.html","البسيط"],[69,"زنار بنت النصارى","https://www.aldiwan.net/poem28137.html","المجتث"],[69,"واعجبي من طول ليلي وقد","https://www.aldiwan.net/poem28254.html","السريع"],[105,"حملت سناك مواكب الأعوام","https://www.aldiwan.net/poem42074.html","الكامل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[48,"ما لي بدار خلت من أهلها شغل","https://www.aldiwan.net/poem64514.html","البسيط"],[50,"أنى شبابك قد مضى محمودا","https://www.aldiwan.net/poem63930.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54605","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54264","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54244","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54220","البسيط"],[90,"قتل العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179140",""],[91,"بالاسكندرية","https://www.poetsgate.com/ViewPoem.aspx?id=53217",""],[94,"الحبّ والله","https://www.poetsgate.com/ViewPoem.aspx?id=15625",""],[115,"قسما برقة خصرك الميال","https://www.aldiwan.net/poem40624.html","عموديه"],[115,"يا عين جودي بالدموع وهات","https://www.aldiwan.net/poem41197.html","عموديه"],[142,"عذب من الماء قد سدت موارده","https://www.aldiwan.net/poem58328.html","البسيط"],[160,"أرخا أثيث الدجى الجاني على الفلق","https://www.aldiwan.net/poem59000.html","البسيط"],[178,"أرخى الضفائر","https://www.aldiwan.net/poem50716.html","البسيط"],[212,"وميالة العطفين غرثانة الحشى","https://www.aldiwan.net/poem37870.html","الطويل"],[221,"أرخصت يوم فراقك الدمعا","https://www.aldiwan.net/poem55275.html","أحذ الكامل"],[229,"تميط الأذى عن حامليها الصوارم","https://www.aldiwan.net/poem50832.html","الطويل"],[235,"أصبحت ظلا على من ظل دولته","https://www.aldiwan.net/poem31952.html","البسيط"],[270,"يا جنة الحسن حر الصيف أمحلك","https://www.aldiwan.net/poem35314.html","البسيط"],[270,"سلت مهندها فخف من حده","https://www.aldiwan.net/poem35414.html","الكامل"],[270,"صافح من العرب الأمجاد أحبابا","https://www.aldiwan.net/poem35654.html","البسيط"],[271,"ضحك تبروق الابرقين تبسما","https://www.aldiwan.net/poem52106.html","الكامل"],[305,"يمم جياد القول خير ميمم","https://www.aldiwan.net/poem56411.html","الكامل"],[320,"يا سريا له السعادة وافت","https://www.aldiwan.net/poem67206.html","الخفيف"],[328,"أبنجواي من رقيق النشيد","https://www.aldiwan.net/poem55060.html","الخفيف"],[353,"ما راح بدر المعالي يمتطي الفلكا","https://www.aldiwan.net/poem40008.html","البسيط"],[361,"بدا فأشبه غصن البان في الميل","https://www.aldiwan.net/poem68076.html","البسيط"],[361,"خد عليه الورد ما","https://www.aldiwan.net/poem68081.html","مجزوء الكامل"],[361,"أبدا تحن اليكم الارواح","https://www.aldiwan.net/poem68126.html","الكامل"],[400,"خديجة رضي الله عنها","https://www.aldiwan.net/poem6774.html","عموديه"],[416,"إسأل الأرسم لو ردت جوابا","https://www.aldiwan.net/poem54032.html","الرمل"],[416,"في الأربعاء لخمس كن من صفر","https://www.aldiwan.net/poem54082.html","البسيط"],[429,"ورق التهاني الوافيه","https://www.aldiwan.net/poem41000.html","مجزوء الكامل"],[429,"يا بيعة مشرقة","https://www.aldiwan.net/poem41060.html","مجزوء الكامل"],[432,"لو حل عن خديه عقد لثامه","https://www.aldiwan.net/poem12734.html","الكامل"],[458,"ما كنت لولا طمعي في الخيال","https://www.aldiwan.net/poem55936.html","السريع"],[464,"باحت بنجد وهوى غزلانها","https://www.aldiwan.net/poem3273.html","عموديه"],[477,"خاطبت بعدكم الأطلال والدمنا","https://www.aldiwan.net/poem15328.html","البسيط"],[551,"خذ صاحبي عني الذي أملي","https://www.aldiwan.net/poem47284.html","أحذ الكامل"],[551,"لو كنت في مثل حالي لم ترد عذلي","https://www.aldiwan.net/poem47288.html","البسيط"],[558,"يا قلب أحبابنا جسمي بهم بالي","https://www.aldiwan.net/poem34245.html","البسيط"],[559,"للعيس شوق قادها نحو السري","https://www.aldiwan.net/poem69355.html","الكامل"]],"verses":[["أُرْخِي عِطافِي وِأُضْحِي غَيْرَ مُحْتَفِلٍ","بِها وَقَدْ شُدَّ مِنْ غَيْري لَها الأُزُرُ",0,"ر",1,0],["أَرخَصتُ فيها كُلَّ غالِيَةٍ","وَذَكَرتُ فيها وَقفَةَ الطَلَلِ",1,"ل",1,0],["أَرخَصَ الحُبُّ فُؤادي","لَكَ وَالعِلقُ ثَمينُ",2,"ن",1,0],["أَرخَصتِني مِن بَعدِ ما أَغلَيتِني","وَحَطَطتِني وَلَطالَما أَعلَيتِني",3,"ن",2,1],["أَرخِصِ البَيعَ كَيفَ شِئ","تَ وَذَرني لَتَندَمَن",4,"ن",1,0],["أَرَّخَ الشَّرْقَ فَهْوَ عَالِمُهُ","وَهْوَ مُعْطِيهِ عُمْرَهُ الثَّانِي",5,"ن",2,0],["أَرْخَصَ العَسْجَدَ حَتَّى إِنَّهُ","جَازَ فِي المَأْلُوفِ أَنْ يُسْمَى بِطِينْ",6,"ن",1,0],["أَرَّخَ النُّوبَ لَمْ يَفُتْهُ حَدِيثٌ","مُسْتَفَادٌ وَلَمْ يَفُتْهُ قَدِيمُ",7,"م",1,0],["أَرخى لَهُ بِنَبجِهِ رِجلَيهِ","وَالمَوتُ قَد سابَقَهُ إِلَيهِ",8,"ه",1,0],["أرخى على أعطافه شعرة","قد جذبتني فيه للحسره",9,"ر",2,0],["أرخصتْ كفُّهُ العطايا وأغْلَتْ","حَمْدَ سُوَّامِها على السُّوَّام",10,"م",1,0],["أَرخى الدُجى ذَيلَهُ وَرُحتُ أَجُرُّ","الذَيلَ عُجباً وَغَيرِيَ النَزِقُ",11,"ق",1,0],["أَرخَصنَ ماءَ الجَفنِ ثُمَّ أَذَلنَهُ","وَلَقَد يَكونُ الدَمعُ غَيرَ مُذالِ",12,"ل",1,0],["أَرخَصتُ فيكَ مَدامِعاً","لَولاكَ كانَت غالِيَه",13,"ي",2,0],["أَرخى الأَعِنَّةَ لِلخُطوبِ وَرَدَّها","فَلَكٌ بِكُلِّ فُجاءَةٍ دَوّارُ",14,"ر",1,0],["أرخَى فضولَ عِنانه لمَّا جَرَى","فكبَا وكَبَّا",15,"ب",2,0],["إِرخِ الزِمامَ وَلا تَخَف مِن عائِقٍ","فَاللَهُ يُرديهُم عَنِ التَنكيلِ",16,"ل",1,0],["أَرخى الحِذارُ عَلى الأَرماحِ أَيديهِم","فَكُلَّما حاوَلوا طَعناً بِها سَبَحَت",17,"ت",1,0],["أرخانيَ الشدُّ منْهُ","وكثرةُ الشدِّ ترخي",18,"ي",1,0],["أرخى على الليلِ ذؤاباتِهِ","فما استطاعَ الظبيُ أن يدخلا",19,"ل",2,0],["أَرْخِي زمامَكِ لا عِثارَ لآخذٍ","من ربّه وكتابهِ بزمامِ",20,"م",1,0],["أَرْخَصُوا في الوغَى نُفُوسَ مُلُوكٍ","حارَبُوها أسلابُها إغْلاءُ",21,"ا",2,0],["أَرخَت عُقوداً مِنَ الياقوتِ مِدمَجَةً","صُفراً وَحُمراً بِها كَالجَمرِ يَشتَعِلُ",22,"ل",1,0],["أَرخَت عَلى قَصَبِ الرَوادِفِ فَاِنثَنَت","كَالخَيزُرانَةِ لَدنَةً أَملودا",23,"د",2,0],["أَرْخَصْتُمُ مَا عَزَّ فِي تَهْذِيبِهِمْ","وَلِكُلِّ تُفْدِيةٍ جَمِيلُ ثَوَابِ",24,"ب",1,0],["أرختْ شعوراً للنسيمِ كأنّما","أظلالُها تحت الغَمامِ غمام",25,"م",1,0],["أرخى غدائرَها الحياءُ كأنها","عَذراءُ تخلِطُ لينها بجِماحها",26,"ح",3,0],["أرختْ غدائرَها أخلاطَ نافِجةٍ","وأرسلتْ ذيلَها ورداً ونِسْرينا",27,"ن",2,0],["أرخَصّتُها وهي علقٌ لا كِفاءَ لَهُ","ورُحْتُ أصْفِقُ فيها كَفَّ مغلوب",28,"ب",1,0],["أرخصن ماء الجفن ثمّ أذلته","ولقد يكون الدّمع غير مذال",29,"ل",1,0],["أرخصت للدمع جفني ثم باكره","في هدأة الفجر طيف منك أغلاه",30,"ا",2,0],["ارخصتني فقطعت حبل مودتي","يا ايها الريم العزيز الغالي",31,"ي",1,0],["ارخته وادي الصفاء ممجد","علم الحما حسن ابو البركات",32,"ت",1,0],["أرخى ذوائَبه دونى يُشكِّكُنى","أَهْى التي سترتُه أم ولائدُهُ",33,"د",2,0],["أرخا أثيث الدجى الجاني على الفلق","وسل مصقولة بيضا من الحدق",34,"ق",1,1],["أرْخي الضَّفائرَ عَلّ الشّعْرَ يُلْهِمُني","شِعْراً يُكَفكِفُ دمعَ الحرفِ في وَرَقي",35,"ي",1,1],["أرَخص نفسي في هواها وأدْمُعي","وما عُوِّدَتْ قبلَ العَلاقةِ تَرّخُصُ",36,"ص",1,0],["أرخصت يوم فراقك الدمعا","وأصم وقع أنينك السمعا",37,"ع",2,1],["أرْخَتْ على الّليالي جَوْرَهُنّ ومَنْ","أيّامُه ظَلمتْه سوف يَنْظَلِمُ",38,"م",1,0],["أَرخى عَلى مَجلِسٍ ذَلَّ الزَمانُ لَهُ","فَاِستَخدَمَ النَصرَ وَالتَأيِيدَ وَالظَفَرا",39,"ر",2,0],["أرخي النقابَ فنعمايَ الحنينُ إلى","ذَيَّالِكَ الفلكِ البادي من الحَلك",40,"ك",1,0],["أرخي النِّقابَ على المحيّا فالسَّنى","أن يَطلعَ المبيضُّ من مِسوَدّه",41,"د",2,0],["أرخي النقاب على الوجهِ الحيي ولا","تُعَرّضيه لعلجٍ عاب واغتابا",42,"ب",2,0],["أرخل من النيابَتين قَلائصا","في الدونا فرة تَبارى الاسهما",43,"م",2,0],["أَرخى ذَوائبهُ الوزيرُ المصطفى","أَكرِم بذلكِ منتمى للمنتمي",44,"م",2,0],["أَرخَتهُ يَدُ التَهاني فَقالَت","جانِسِ المَجدَ رُتبَةَ الناضوري",45,"ر",2,0],["أرخص الروح في الدفاع عن الدي","ن بعزم يفلّ غفل الحديد",46,"د",1,0],["أَرّخت عُد حائِزاً بِالعود نَيل هنا","تَقبّل اللَه مِنكَ الحَجّ وَالنُسكا",47,"ك",2,0],["أَرخى عَلى الصُبح لَيلا من ذَوائِبِهِ","فَاِستَقبَح الصُبح أَن يَبدو من الخَجَل",48,"ل",1,0],["أَرّختُه زهر الربا","في وَجهِ اِبراهيمَ راق",49,"ق",1,0],["أَرّخته أَبدا بِعَهدِ جاكم","لاِبي الفَلاح تَجَدّد الاِفراح",50,"ح",1,0],["أرختْ لهُ جناحه","في رغبةٍ ورهَبِ",51,"ب",1,0],["أرْخَصَتْ لي كلَّ غالٍ فكأنْ","وَجَدتْ في جودها التبر ترابا",52,"ب",2,0],["أَرَّخْتُ طالِعَ داودٍ بمولِدِه","وكانتِ الشَّمسُ بالجوزاء طالِعَهُ",53,"ه",1,0],["ارخت فزت بنعمة","بكل عام آتيه",54,"ي",2,0],["أرّخت ان لآلها","فاضت بروح القدس",55,"س",1,0],["أرْخى ذوائبَهُ نقابَهُ","كالبدرِ بين ظلامِه وغمامِه",56,"م",2,0],["أرخصَ منها الودُّ ممنوعةً","غلتْ فلم يقدِر عليها المُغالْ",57,"ل",1,0],["أرخصت من مدامعي لآلنا","لو جمدت غاليت في أثمانها",58,"ن",3,0],["أرخصتُه بعدما بِنتمْ على دِمَنٍ","لم يبقَ للدمعِ مِن بعدِ النوى ثمنا",59,"ن",2,0],["أرخصتُ غيرَهمُ لأنّهمُ","يُغلون أثماني كما أُغلي",60,"ي",1,0],["أرخى لكمْ فحسبتُم لا زمامَ لكم","وليس يفْرِق فَوْتاً مُمِسكُ الطِّوَلِ",61,"ل",1,0],["أرخصتموا في هواكم مدمعي سفهاً","وهو العزيز الذي عهدي به غالي",62,"ي",1,0],["أرخ الازمَّة واتبعْها إِنهَّا","تدري الحمى النَّجْدِيّ مع من درى",63,"ر",2,0]]}