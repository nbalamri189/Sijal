{"poems":[[63,"لله أي فتى مجد تناوشه","https://www.aldiwan.net/poem45903.html","البسيط"],[86,"لله درك كنت من رجل","https://www.aldiwan.net/poem10491.html","أحذ الكامل"],[73,"وضح الحق المبين","https://www.aldiwan.net/poem11841.html","مجزوء الرمل"],[73,"أرخصتني من بعد ما أغليتني","https://www.aldiwan.net/poem11889.html","الكامل"],[73,"خنت عهدي ولم أخن","https://www.aldiwan.net/poem11969.html","مجزوء الخفيف"],[93,"هو يوم أغر مبتسم","https://www.aldiwan.net/poem11188.html","الخفيف"],[93,"ربة الدولة والجاه المكين","https://www.aldiwan.net/poem11231.html","الرمل"],[93,"لا تبن أيها المحيا الوسيم","https://www.aldiwan.net/poem11339.html","الخفيف"],[47,"ما العمر ماطالت به الدهور","https://www.aldiwan.net/poem24771.html","الرجز"],[72,"مبلبل الأصداغ والطره","https://www.aldiwan.net/poem18697.html","السريع"],[51,"راح شيبي علي مثل الثغام","https://www.aldiwan.net/poem66324.html","الخفيف"],[91,"أمست ثيابي وكلها خرق","https://www.aldiwan.net/poem8984.html","عموديه"],[91,"ما للهموم الطارقات ومالي","https://www.aldiwan.net/poem62625.html","عموديه"],[70,"يا قلب بعض الناس هل","https://www.aldiwan.net/poem42398.html","مجزوء الكامل"],[85,"سكن الزمان ولانت الأقدار","https://www.aldiwan.net/poem62969.html","الكامل"],[62,"يا أيها المولى الذي اصطنع الورى","https://www.aldiwan.net/poem52507.html","مجزوء الكامل"],[58,"إن المنية شربة مورودة","https://www.aldiwan.net/poem30927.html","الكامل"],[66,"يا نسمة لأحاديث الحمى شرحت","https://www.aldiwan.net/poem41359.html","البسيط"],[69,"زنار بنت النصارى","https://www.aldiwan.net/poem28137.html","المجتث"],[69,"واعجبي من طول ليلي وقد","https://www.aldiwan.net/poem28254.html","السريع"],[105,"حملت سناك مواكب الأعوام","https://www.aldiwan.net/poem42074.html","الكامل"],[67,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[48,"ما لي بدار خلت من أهلها شغل","https://www.aldiwan.net/poem64514.html","البسيط"],[50,"أنى شبابك قد مضى محمودا","https://www.aldiwan.net/poem63930.html","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54605","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54264","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54244","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54220","البسيط"],[90,"قتل العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179140",""],[91,"بالاسكندرية","https://www.poetsgate.com/ViewPoem.aspx?id=53217",""],[94,"الحبّ والله","https://www.poetsgate.com/ViewPoem.aspx?id=15625",""]],"verses":[["أُرْخِي عِطافِي وِأُضْحِي غَيْرَ مُحْتَفِلٍ","بِها وَقَدْ شُدَّ مِنْ غَيْري لَها الأُزُرُ",0,"ر",1,0],["أَرخَصتُ فيها كُلَّ غالِيَةٍ","وَذَكَرتُ فيها وَقفَةَ الطَلَلِ",1,"ل",1,0],["أَرخَصَ الحُبُّ فُؤادي","لَكَ وَالعِلقُ ثَمينُ",2,"ن",1,0],["أَرخَصتِني مِن بَعدِ ما أَغلَيتِني","وَحَطَطتِني وَلَطالَما أَعلَيتِني",3,"ن",2,1],["أَرخِصِ البَيعَ كَيفَ شِئ","تَ وَذَرني لَتَندَمَن",4,"ن",1,0],["أَرَّخَ الشَّرْقَ فَهْوَ عَالِمُهُ","وَهْوَ مُعْطِيهِ عُمْرَهُ الثَّانِي",5,"ن",2,0],["أَرْخَصَ العَسْجَدَ حَتَّى إِنَّهُ","جَازَ فِي المَأْلُوفِ أَنْ يُسْمَى بِطِينْ",6,"ن",1,0],["أَرَّخَ النُّوبَ لَمْ يَفُتْهُ حَدِيثٌ","مُسْتَفَادٌ وَلَمْ يَفُتْهُ قَدِيمُ",7,"م",1,0],["أَرخى لَهُ بِنَبجِهِ رِجلَيهِ","وَالمَوتُ قَد سابَقَهُ إِلَيهِ",8,"ه",1,0],["أرخى على أعطافه شعرة","قد جذبتني فيه للحسره",9,"ر",2,0],["أرخصتْ كفُّهُ العطايا وأغْلَتْ","حَمْدَ سُوَّامِها على السُّوَّام",10,"م",1,0],["أَرخى الدُجى ذَيلَهُ وَرُحتُ أَجُرُّ","الذَيلَ عُجباً وَغَيرِيَ النَزِقُ",11,"ق",1,0],["أَرخَصنَ ماءَ الجَفنِ ثُمَّ أَذَلنَهُ","وَلَقَد يَكونُ الدَمعُ غَيرَ مُذالِ",12,"ل",1,0],["أَرخَصتُ فيكَ مَدامِعاً","لَولاكَ كانَت غالِيَه",13,"ي",2,0],["أَرخى الأَعِنَّةَ لِلخُطوبِ وَرَدَّها","فَلَكٌ بِكُلِّ فُجاءَةٍ دَوّارُ",14,"ر",1,0],["أرخَى فضولَ عِنانه لمَّا جَرَى","فكبَا وكَبَّا",15,"ب",2,0],["إِرخِ الزِمامَ وَلا تَخَف مِن عائِقٍ","فَاللَهُ يُرديهُم عَنِ التَنكيلِ",16,"ل",1,0],["أَرخى الحِذارُ عَلى الأَرماحِ أَيديهِم","فَكُلَّما حاوَلوا طَعناً بِها سَبَحَت",17,"ت",1,0],["أرخانيَ الشدُّ منْهُ","وكثرةُ الشدِّ ترخي",18,"ي",1,0],["أرخى على الليلِ ذؤاباتِهِ","فما استطاعَ الظبيُ أن يدخلا",19,"ل",2,0],["أَرْخِي زمامَكِ لا عِثارَ لآخذٍ","من ربّه وكتابهِ بزمامِ",20,"م",1,0],["أَرْخَصُوا في الوغَى نُفُوسَ مُلُوكٍ","حارَبُوها أسلابُها إغْلاءُ",21,"ا",2,0],["أَرخَت عُقوداً مِنَ الياقوتِ مِدمَجَةً","صُفراً وَحُمراً بِها كَالجَمرِ يَشتَعِلُ",22,"ل",1,0],["أَرخَت عَلى قَصَبِ الرَوادِفِ فَاِنثَنَت","كَالخَيزُرانَةِ لَدنَةً أَملودا",23,"د",2,0],["أَرْخَصْتُمُ مَا عَزَّ فِي تَهْذِيبِهِمْ","وَلِكُلِّ تُفْدِيةٍ جَمِيلُ ثَوَابِ",24,"ب",1,0],["أرختْ شعوراً للنسيمِ كأنّما","أظلالُها تحت الغَمامِ غمام",25,"م",1,0],["أرخى غدائرَها الحياءُ كأنها","عَذراءُ تخلِطُ لينها بجِماحها",26,"ح",3,0],["أرختْ غدائرَها أخلاطَ نافِجةٍ","وأرسلتْ ذيلَها ورداً ونِسْرينا",27,"ن",2,0],["أرخَصّتُها وهي علقٌ لا كِفاءَ لَهُ","ورُحْتُ أصْفِقُ فيها كَفَّ مغلوب",28,"ب",1,0],["أرخصن ماء الجفن ثمّ أذلته","ولقد يكون الدّمع غير مذال",29,"ل",1,0],["أرخصت للدمع جفني ثم باكره","في هدأة الفجر طيف منك أغلاه",30,"ا",2,0]]}