.poetsgate.com/ViewPoem.aspx?id=188375",""],[5376,"احزمْ متاعَك أيها الرجلُ","https://www.poetsgate.com/ViewPoem.aspx?id=198998",""],[5442,"غنى بذكر الحمى فارتاح كل شجى","https://www.poetsgate.com/ViewPoem.aspx?id=114774",""],[5444,"جَنَى الأردن","https://www.poetsgate.com/ViewPoem.aspx?id=205519",""],[5582,"أَبَى اللهُ إِلاّ أَنْ أَرَى الحَقَّ غالِبا","https://www.poetsgate.com/ViewPoem.aspx?id=186674",""],[5648,"وش فيك ؟!","https://www.poetsgate.com/ViewPoem.aspx?id=154660",""],[5736,"نم يا صغيري","https://www.poetsgate.com/ViewPoem.aspx?id=208409",""],[4623,"ماذا يضرك لو تركت ملامي ( المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146686",""],[5762,"الذبيح الصاعد","https://www.poetsgate.com/ViewPoem.aspx?id=13136",""],[5776,"أطوارُ ......عنكبوت الهولوكوست","https://www.poetsgate.com/ViewPoem.aspx?id=199338",""],[5816,"( العبيرية ) في وصف الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=125964",""],[5992,"وأربعٍ شَرَّفْنَ ذي الحجة للمفاضلهْ","https://www.poetsgate.com/ViewPoem.aspx?id=41850",""],[6089,"امدد كؤؤسك","https://www.poetsgate.com/ViewPoem.aspx?id=213755",""],[6102,"لُمْ نَفسَك!!","https://www.poetsgate.com/ViewPoem.aspx?id=186291",""],[6115,"اربع لاصابع ماخذت دور البهام","https://www.poetsgate.com/ViewPoem.aspx?id=180469",""],[6277,"شرب فطرب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64450&r=&rc=13",""]],"verses":[["وارَبتِهِ زَمَناً فَعاذَ بِحِلمِهِ","إِنَّ المُحِبَّ عَنِ الحَبيبِ حَليمُ",0,"م",1,0],["وارْبَأْ بنَفْسِكَ عنْ تسامُحِ بائِعٍ","واغْنَمْ إذا سامَتْكَ شهْوَةَ مُشْتَري",1,"ي",1,0],["وَاِربَح لِمِصرَ بِرَأسِ مالِكَ عِزَّةً","إِنَّ الذَكاءَ حُبالَةُ الأَرباحِ",2,"ح",1,0],["وَأَربو عَلى ذاكَ الفَخورِ بِقَولِهِ","إِذا قُلتُ شِعراً أَصبَحَ الدَهرُ مُنشِدا",3,"د",2,0],["وأربط الناس جأشاً في مواقفة","من شدّة الرعب فيها ترجُف اللمم",4,"م",1,0],["وَأُربِحُ التَجرَ إِن عَزَّت فِضالُهُمُ","حَتّى يَعودَ سُلَيمى حَولَهُ نَفَرُ",5,"ر",1,0],["وَأَربَدُ فارِسُ الهَيجا إِذا ما","تَقَعَّرَتِ المَشاجِرُ بِالخِيامِ",6,"م",1,0],["وأربعة كِقداح السَّرا","ء لا عانيات ولا عُبَّلُ",7,"ل",1,0],["واربضي في ظلِّها الوارِفِ","إنْ خِفْتِ الكَلالْ",8,"ل",1,0],["وَاِربَأ بِحِلمِكَ في النَوا","زِلِ أَن يُلِمَّ بِهِ الجَزَع",9,"ع",1,0],["وأربع أركاننا","قد زال عنهن الحسد",10,"د",1,0],["واربَأْ بعُرفِكَ من شريكٍ يدَّعي","فيه النصيبَ وما له بُرهانُ",11,"ن",1,0],["وَأَربَدُ القُطرِ يَلقاكَ السَرابُ بِهِ","بَعدَ التَرَبُّدِ مُبيَضَّ الجَلابيبِ",12,"ب",1,0],["وَأَربابُ الوَدادِ لَهُم قُلوبٌ","يُذيبُ صَميمَها فَرطُ الجَفاءِ",13,"ا",2,0],["وَاِربَع عَلى حُكمِ الرَبيعِ بِأَجرَعٍ","هَزِجَ النَدى مِن مُفصِحِ الأَطيارِ",14,"ر",1,0],["وَاِربَع بِحَيثُ تَصوبُ أرَضَكَ ديمَةٌ","لِيَمينِ يُمنٍ أَو يَسارِ يَسارِ",15,"ر",1,0],["وَاِربَع بِوادٍ عُشبُهُ","خَضلٌ وَنَم في رَأسِ نيقِ",16,"ق",1,0],["وَأَرَبَّ يَبرُدُ مِن حَشاهُ مَكرَعٌ","خَصِرٌ يَسُحُّ وَتَلعَةٌ مِخضالُ",17,"ل",1,0],["وَأَربَعَةٍ أَنِسنَ بِكُلِّ حَيٍّ","رَمَتهُنَّ الحَوادِثُ بِالنِبالِ",18,"ل",1,0],["وأرْبابُ الجِيادِ بَنو عليّ","مُزِيرُوهَا الذّوابِلَ والصّفيحا",19,"ح",2,0],["واربأ بنفسك من أن","تهون أو تستفيدا",20,"د",2,0],["وأربت جمالا وزادت سنا","ونورا إلى نورها السرمدي",21,"د",2,0],["وأرباب الكمال إذا تولوا","تولى الخير في دنيا ودين",22,"ن",1,0],["واربأ بنفسك عن تسامح بائع","واغنم إذا سامتك شهوة مشتر",23,"ر",1,0],["واربأ بنفسك فهي أسمى غاية","من أن تذوب صبابة وغراما",24,"م",2,0],["وأربعاً ما وراء الحصن ليس بها","إلا مكحلة من حورها العين",25,"ن",1,0],["وأَربَى على نورِ الغزالة نورُه","كما يفضل الحُرُّ الكريمُ على العَبدِ",26,"د",1,0],["واربأ بنفسك أن تُرى","مستمرئاً في العيش جبنا",27,"ن",2,0],["واربدَّ ضوءُ الشمسِ في رأد الضحى","حتى استوى الإشراقُ والإظلام",28,"م",1,0],["واربدَّ وجهُ الحكم لمّا أن رأى","ذاك السَّنا متوارياً بحجاب",29,"ب",1,0],["وأربي على محبتها القو","مَ لترقى بهم على الأقوام",30,"م",1,0],["وأربت على الستين مدة عيشتي","كذلك لم أعرف لنفسي موطنا",31,"ن",2,0],["وَأَرْبُعُ الْعِلْمِ لَمْ يُلْفَ بِمَنْهَلِهَا","مِنَ الأَفَاضِلِ لاَ سَاقٍ وَلاَ فَرُطُ",32,"ط",1,0],["وأربح الناس عندي في تجارته","محصلٌ يشتري بالفضة الذهبا",33,"ب",2,0],["وَأَربعا نمْنمَتْ يُمْنَى الرَّبيعِ لَها","ما شِئت مِنْ خِلَعٍ مَوْشِيَّةٍ وكُسى",34,"س",2,0],["وَأَرْبى عَلَى الأملاكِ مَجداً وَسُؤْدَداً","فجرَّ عَلى الأفلاكِ أرْدِيَة الفَخْرِ",35,"ر",1,0],["وأربابُ الحِجا خُلِقوا ليَأْتوا","خِلافَ صَنيعِ رَبّاتِ الحِجال",36,"ل",1,0],["وار بأبنفسك أن تقيم","بحيث يغشاك الدرن",37,"ن",1,0],["وأربعمائة خُتِنَتْ وكانت","يَتامى لم تُسَنَّنْ بالختان",38,"ن",1,0],["وأَربابُ مُلْكٍ فِي رياسةِ أُمَّةٍ","لهم فِي المعالي عِيرُها ونفيرُها",39,"ر",3,0],["وأَربعة عُربا وعُجما جَميعهم","فهذي جَميع الأَنبياء أَتَت تَتَرى",40,"ر",2,0],["وأرْبى أمير المؤمنين عليهمُ","عليهم صلاةٌ جَمَّةٌ وسلامُ",41,"م",1,0],["وارب غادية يسح دموعها","ضحك البروق على ثرى بطحائها",42,"ا",3,0],["وَاِربِط عَلى يَدِكَ اللِقاءُ عَشِيَّةً","فَأَنا عَلى خَيلِ الجَريدَةِ وارِدُ",43,"د",1,0],["وَاِربِط عَلى كَفِّكَ إِن أَنتَ لَم","تُجِب سُؤالي أَنَّني أَغضَبُ",44,"ب",1,0],["وأربعٌ يشقى بها مغرمٌ","تُقلِقُه الذكرى ومشتاقُ",45,"ق",1,0],["واربأ بنفسك عن رب الحماقة واس","تبدله بالكيس الأخلاق ذي الأدب",46,"ب",1,0],["وارْبُضْ ببابِ الأَمرِ واهْجُرْ غيرَهُ","مُتَجَرِّداً من كلِّ علمٍ أَو عَمَلْ",47,"ل",1,0],["وأربعُة أسرى بُطونَهمُ جَثَوا","بأطرافِهم تبَّت يَداهمُ مِن أسرى",48,"ر",2,0],["وَأَربَدَّ مِن خَشيَةِ السُؤالِ كَما","يَربَدُّ عِندَ الوَفاةِ ذُو أَلَمِ",49,"م",1,0],["وَأَربَعَةٌ وَالمُصطَفى خامِسٌ لَهُم","أَفاضَ عَلَيهِم مِرطَهُ وَتَلا فَصلا",50,"ل",2,0],["وأَرْبى ولا نَقْصٌ عَلمْتُم عَليْهِمُ","وزيرٌ أَقام الملكَ والدينَ والدُّنَا",51,"ن",2,0],["وأَربعةٌ قطُّ لم تَفْتَرِقْ","هَوىً وجوىً وحياةٌ وهَمْ",52,"م",1,0],["وأَرْبَعَةٌ فيَّ ممَّا وَهَبْ","ت نَفْسٌ وروحٌ ولَحمٌ وَدَمْ",52,"م",1,0],["وأَربَدُ ما عاداه ذُو جَبَريَّةٍ","مِنَ القَومِ إلاَّ ماتَ ميتَةَ أربَد",53,"د",1,0],["وأربابها في حجر حجري تربت","ذهبت بروح اللَه في كل مذهب",54,"ب",1,0],["وأرباب ألباب تربى بلبه","وأرواح أحباب تهيج بحبه",54,"ه",1,0],["وَأَرباب قَد تجارى","عَلَيهم بِالسَفاهة كُل نَذل",55,"ل",1,0],["وارْبَأْ بِمَجْدِكَ عن سَوَاقِطِ سُقَّطٍ","هي في الحقيقةِ مَقْدَحُ لا مَمْدَحُ",56,"ح",1,0],["وأربع على أربع يا تعاييب الأنظار","وثمان سحمٍ يستون بالكمالي",57,"ل",2,0],["وأَرْبُطُ جَأْشِي عند كلِّ عظيمةٍ","تُلِمُّ ويومَ البَيْن يَنْتَكِثُ الرَّبْطُ",58,"ط",1,0],["وأَرْبحُ منْ في الأرض مَنْ يعرف الورى اخ","تباراً ويشْرِى بالأسود الثعالبا",59,"ب",2,0],["واربأْ بنفسك واعرف قدرَ قيمتها","فجيِّدُ الرأى مَنْ للفرصة انتهزا",60,"ز",2,0],["واربأْ بنفسك واعرِفْ قدرَ قيمتها","واجعل بعقلك أصنامَ الفساد جُذا",61,"ذ",2,0],["وأربع بربع الزينبّ","ي متاجراً بالمدح تربح",62,"ح",1,0],["وأربت على رباه سيول","ليس يدري من بعدها ما المحول",63,"ل",1,0],["وأربع بربع الزيني معرسا","تذمم به خضراء كل ربيع",64,"ع",1,0],["وآربا بنفسك عن أوخام لذتها","فهي التي ما شفت إلا أورثت سقما",65,"م",2,0],["واربدت الآفاق تح","مل ألف شر مستطير",66,"ر",1,0],["وأربعٌ سقوفها","منقوشة مذهَبهْ",67,"ب",2,0],["وأرباب الحساب وكل رهطٍ","بتنميق الدفاتر حاز سبقا",68,"ق",2,0],["وَأَرْبى عَلى الأَخيارِ مِنْهُمْ بِخُبْرِهِ","فَدَعْ عَنْكَ ما يُرْوى وَخُذْ عَنْهُ ما تَرَى",69,"ر",2,0],["وارْبَأْ بِعِلْمِكَ عمَّنْ ليسَ يَفْهمُهُ","ولا تُذاكِرْ بِهِ مَنْ ليس مِنْ نَمَطِهْ",70,"ط",2,0],["وأربابها في الفهم عنها تعينت","مراتبهم فيها على وفق ما ظهر",71,"ر",1,0],["واربا بها يسعون فيها بوجهة","فهم بين عباد بعلم وزهاد",72,"د",1,0],["وأربعة مرت ولم تحل لامرىء","تهادت على الأقطار وهي سمائم",73,"م",1,0],["وأربعٌ تختصّ بالمضارعه","أتين في مستقبل متابعه",74,"ه",1,0],["وأربع التوبيخ لوما ألا","وهن للتحضيض لولا هلا",74,"ل",2,0],["وأربع من النساء تقبل","قطعاً وفيما دونها تأمل",75,"ل",1,0],["وَاِربَأ بِنَفسِكَ أَن تَكونَ ذَليلَةً","فَالوردُ مِلءُ الرَوضِ فَاِختَر وَاِقطَعِ",76,"ع",1,0],["وأربعةٌ في باضعٍ والتي تلا","حم فيه ستةٌ وهو أبجلُ",77,"ل",1,0],["وأربعةٌ في الجبر من بعد كسرها","على الشين إبلا في التراقي تبدلُ",77,"ل",1,0],["وأربعةٌ أذ المهورِ دراهماً","يتم بها عقد الذي يتصحح",78,"ح",1,0],["وأربعوها حدها عالمٌ","نبيه في حده مصقع",79,"ع",1,0],["وأربعٌ إن بلغت أربعاً","من مائةٍ ما دونها مقنعُ",79,"ع",1,0],["وأربعُ السهمان أقسامه","ثلاثةٌ ما نقت الضفدعُ",79,"ع",1,0],["وَأَربعُ عُرفٍ لَم يَشنها بِمُنكَرٍ","وَلَم تَسمَع الآذان مِنها بِها لَغطا",80,"ط",2,0],["واربخى في المدينه","ألا يا أحمد",81,"د",1,0],["وارباب المحاكم يا لقومي","بصائرهم خلت منها البصاره",82,"ر",2,0],["واربأ بنفسك ان تذل لغيره","أبداً وأكرِمها بصبرك تكرم",83,"م",1,0],["وأربعة نكحتهم فماتوا","فليت عريف حيٍّ قد نعاني",84,"ن",2,0],["وَأَربَعَةٍ تَحكي سَبائِكَ عَسجَدٍ","تَطيرُ بَها في الأَرضِ كُلَّ مَطارِ",85,"ر",1,0],["وَأَربَدَ يَومَ الجِزعِ لَمّا أَتاكُمُ","وَجارَكُمُ لَم تُنذِروهُ لِيَحذَرا",86,"ر",2,0],["واربأ بنفسك ان تحاط بحية","كانت قبيل غرامها انسانا",87,"ن",2,0],["وارباب هذا الربع هذا بحيكم","اسير ديون كيف مع ذاك يوسر",88,"ر",1,0],["وأربع سيرتهم مشهورة","والأرض من أنوارهم مغمورة",89,"ه",1,0],["وأربع وجوب تركها ورد","نميمة وغيبة كبر حسد",90,"د",1,0],["وأربطُه فوق الشئون تميمةً","لجفني لعلَّ الجفنَ يرقأ ساجمه",91,"م",2,0],["وأربى على الستين فازداد أربعاً","وقيل ثلاثٌ وهو أحسن ما يروى",92,"و",2,0],["واربعْ بنا واقصُرِ الأقدامَ من حَذَر","فالمرءُ قَدْ يحذر الزَّلاّتِ بالقدم",93,"م",1,0],["وارب وصاله ودع ودّه","وصد واللَه ودود وكيل",94,"ل",1,0],["وَاِربأ بِها إِن تَشتَكي","عنتاً وأن تتألّما",95,"م",2,0],["واربتُ مذ لامني اللاحي وقلتُ لهُ","حييتَ يا سمجَ الأخلاق والشيمِ",96,"م",1,0],["وارْبَعْ بها دِمَناً ألِفْتُ بها الهَوى","أكْرِمْ بها من مرْبعٍ أو مألَفِ",97,"ف",1,0],["وأربع العلم أمست","فيها المآتم تعقد",98,"د",1,0],["وَاربتُ قَولي لِواشٍ في تَعقله","وَقُلتُ سُبحانَ رَبّي مَوجد النِعَم",99,"م",1,0],["وَاربت في اللَوم عَن عُذر وَإِنَك ذو","حَزم هَديت لحبّ فيكَ مُلتَزم",100,"م",1,0],["وأربط الخلق جأشا يوم معضلة","وخير قاض بتحريم وتحليل",101,"ل",1,0],["وأربى على البحتري ولم","يطاوله في شأوه مقتدر",102,"ر",1,0],["وَاربأ بنفسك إِن أَردت سَلامة","فَلَقَد بَدا خافٍ وَزال غِطاء",103,"ا",2,0],["وأربعة أولى بهم أن يباعدوا","وإن خواطر فليؤخذ الحذر منهم",104,"م",1,0],["واربأ بنفسك أن تغازلها وإن","منحتك حبّاً من صميم فؤادها",105,"د",3,0],["واربأ بنفسِك عن أن","تكونَ مِمَّن أضاعَه",106,"ه",1,0],["وأربعٌ أخَوَاتٌ","بِالثُّلثِ تَفخَرُ فَخرَا",107,"ر",2,0],["واربأ بنفسك أن تميل مع الهوى","إن الهوى للعاشقين بلاء",108,"ا",2,0],["واربط على قلوبنا بالمعرفهْ","ولا لنا يربط من أن يعرف