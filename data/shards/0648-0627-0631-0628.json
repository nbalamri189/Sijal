{"poems":[[34,"ولقد أردت الصبر عنك فعاقني","https://www.aldiwan.net/poem4932.html","الطويل"],[77,"حقر لها ما في يديها بدأة","https://www.aldiwan.net/poem36478.html","الكامل"],[86,"أشرق فدتك مشارق الإصباح","https://www.aldiwan.net/poem10673.html","الكامل"],[86,"تعمدت قتلي في الهوى وتعمدا","https://www.aldiwan.net/poem68959.html","الطويل"],[88,"هي المنى كثغور الغيد تبتسم","https://www.aldiwan.net/poem44833.html","البسيط"],[4,"راح القطين بهجر بعدما ابتكروا","https://www.aldiwan.net/poem21160.html","البسيط"],[4,"ألا ذهب المحافظ والمحامي","https://www.aldiwan.net/poem21204.html","الوافر"],[37,"وفي ضبن حقف يراجعنه","https://www.aldiwan.net/poem7310.html","المتقارب"],[92,"أقبل الصبح يغني","https://www.aldiwan.net/poem38893.html","مجزوء الرمل"],[85,"الناس للدنيا تبع","https://www.aldiwan.net/poem63761.html","مجزوء الكامل"],[62,"المبدأ الأول في","https://www.aldiwan.net/poem52199.html","مجزوء الرجز"],[62,"لقياك من غير الزمان أمان","https://www.aldiwan.net/poem52256.html","الكامل"],[45,"أتاركي أنت أم مغرى بتعذيبي","https://www.aldiwan.net/poem10649.html","البسيط"],[66,"رسائل صدق إخوان الصفاء","https://www.aldiwan.net/poem39063.html","الوافر"],[74,"أذن الغمام بديمة وعقار","https://www.aldiwan.net/poem12944.html","الكامل"],[74,"سمح الخيال على النوى بمزار","https://www.aldiwan.net/poem12955.html","الكامل"],[74,"ياهزة الغصن الوريق","https://www.aldiwan.net/poem13198.html","مجزوء الكامل"],[74,"نهر كما سال اللمى سلسال","https://www.aldiwan.net/poem13208.html","الكامل"],[46,"وبالي فيك يا دنيا وبالي","https://www.aldiwan.net/poem23231.html","الوافر"],[46,"ألاح وقد رأى برقا مليحا","https://www.aldiwan.net/poem23637.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85844","المجتث"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142329","المتقارب"],[77,"حقر لها ما في يديها بدأة","https://www.poetsgate.com/ViewPoem.aspx?id=34112",""],[100,"هموم الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=50137",""],[125,"ما قهوة البن إن قيست بصافية","https://www.aldiwan.net/poem23759.html","البسيط"],[126,"سلام ولا أقرا سلاماً على هند","https://www.aldiwan.net/poem4095.html","الطويل"],[136,"رقيتني حسا ومعنى","https://www.aldiwan.net/poem49107.html","مجزوء الكامل"],[199,"بيني وبين الحادثات خصام","https://www.aldiwan.net/poem51882.html","الكامل"],[199,"هم سرى في أضلعي وسرى بي","https://www.aldiwan.net/poem51978.html","الكامل"],[200,"لكم سادتي أجل احترامي","https://www.aldiwan.net/poem45668.html","الخفيف"],[232,"إذا صار قلب العبد للسر معدنا","https://www.aldiwan.net/poem44575.html","الطويل"],[238,"ما للأحبة أسياف الجفا اخترطوا","https://www.aldiwan.net/poem18841.html","البسيط"],[257,"والكأس تسلبني عقلي وأهون ما","https://www.aldiwan.net/poem48465.html","البسيط"],[276,"أدرك بخيلك خيل الله أندلسا","https://www.aldiwan.net/poem25469.html","البسيط"],[276,"أمبتسم الأضحى ومطلع الفطر","https://www.aldiwan.net/poem25567.html","الطويل"],[365,"جوانح واجد وجفون سال","https://www.aldiwan.net/poem60683.html","الوافر"],[392,"يا من له الخلق الحسن والخلق والعقل ومن","https://www.aldiwan.net/poem54485.html","عموديه"],[417,"ليهنك ما بلغت من الأماني","https://www.aldiwan.net/poem54133.html","الوافر"],[440,"لئن سرت الدنيا فأنت سرورها","https://www.aldiwan.net/poem34913.html","الطويل"],[442,"ألا إن كتب الأنبياء عليهم","https://www.aldiwan.net/poem14406.html","الطويل"],[462,"منازلكم للخائفين عصام","https://www.aldiwan.net/poem16033.html","الطويل"],[465,"قف بالمنازل أو كناس ظبائها","https://www.aldiwan.net/poem3275.html","عموديه"],[469,"يا موقظ العتب الذي هو راقد","https://www.aldiwan.net/poem60254.html","الكامل"],[469,"يا من هو الأم لنا والأب","https://www.aldiwan.net/poem60460.html","السريع"],[478,"بي من جوى التبريح اشفاق","https://www.aldiwan.net/poem15351.html","السريع"],[480,"بالشاعرين نحيي ندوة الأدب","https://www.aldiwan.net/poem37191.html","البسيط"],[501,"بين النجوم وبين مسبار الضحى","https://www.aldiwan.net/poem37819.html","الكامل"],[539,"اسال من الأجفان عن صدره نهرا","https://www.aldiwan.net/poem48140.html","عموديه"],[554,"يا ضيف موسى أخى خزيمة صم","https://www.aldiwan.net/poem68397.html","المنسرح"],[574,"لقد طهر الرحمان آل محمد","https://www.aldiwan.net/poem3643.html","الطويل"],[576,"أحدث عنكم أن بعدكم دنا","https://www.aldiwan.net/poem2999.html","الطويل"],[576,"مديحك كالمسك لا يكتتم","https://www.aldiwan.net/poem3006.html","المتقارب"]],"verses":[["وارَبتِهِ زَمَناً فَعاذَ بِحِلمِهِ","إِنَّ المُحِبَّ عَنِ الحَبيبِ حَليمُ",0,"م",1,0],["وارْبَأْ بنَفْسِكَ عنْ تسامُحِ بائِعٍ","واغْنَمْ إذا سامَتْكَ شهْوَةَ مُشْتَري",1,"ي",1,0],["وَاِربَح لِمِصرَ بِرَأسِ مالِكَ عِزَّةً","إِنَّ الذَكاءَ حُبالَةُ الأَرباحِ",2,"ح",1,0],["وَأَربو عَلى ذاكَ الفَخورِ بِقَولِهِ","إِذا قُلتُ شِعراً أَصبَحَ الدَهرُ مُنشِدا",3,"د",2,0],["وأربط الناس جأشاً في مواقفة","من شدّة الرعب فيها ترجُف اللمم",4,"م",1,0],["وَأُربِحُ التَجرَ إِن عَزَّت فِضالُهُمُ","حَتّى يَعودَ سُلَيمى حَولَهُ نَفَرُ",5,"ر",1,0],["وَأَربَدُ فارِسُ الهَيجا إِذا ما","تَقَعَّرَتِ المَشاجِرُ بِالخِيامِ",6,"م",1,0],["وأربعة كِقداح السَّرا","ء لا عانيات ولا عُبَّلُ",7,"ل",1,0],["واربضي في ظلِّها الوارِفِ","إنْ خِفْتِ الكَلالْ",8,"ل",1,0],["وَاِربَأ بِحِلمِكَ في النَوا","زِلِ أَن يُلِمَّ بِهِ الجَزَع",9,"ع",1,0],["وأربع أركاننا","قد زال عنهن الحسد",10,"د",1,0],["واربَأْ بعُرفِكَ من شريكٍ يدَّعي","فيه النصيبَ وما له بُرهانُ",11,"ن",1,0],["وَأَربَدُ القُطرِ يَلقاكَ السَرابُ بِهِ","بَعدَ التَرَبُّدِ مُبيَضَّ الجَلابيبِ",12,"ب",1,0],["وَأَربابُ الوَدادِ لَهُم قُلوبٌ","يُذيبُ صَميمَها فَرطُ الجَفاءِ",13,"ا",2,0],["وَاِربَع عَلى حُكمِ الرَبيعِ بِأَجرَعٍ","هَزِجَ النَدى مِن مُفصِحِ الأَطيارِ",14,"ر",1,0],["وَاِربَع بِحَيثُ تَصوبُ أرَضَكَ ديمَةٌ","لِيَمينِ يُمنٍ أَو يَسارِ يَسارِ",15,"ر",1,0],["وَاِربَع بِوادٍ عُشبُهُ","خَضلٌ وَنَم في رَأسِ نيقِ",16,"ق",1,0],["وَأَرَبَّ يَبرُدُ مِن حَشاهُ مَكرَعٌ","خَصِرٌ يَسُحُّ وَتَلعَةٌ مِخضالُ",17,"ل",1,0],["وَأَربَعَةٍ أَنِسنَ بِكُلِّ حَيٍّ","رَمَتهُنَّ الحَوادِثُ بِالنِبالِ",18,"ل",1,0],["وأرْبابُ الجِيادِ بَنو عليّ","مُزِيرُوهَا الذّوابِلَ والصّفيحا",19,"ح",2,0],["واربأ بنفسك من أن","تهون أو تستفيدا",20,"د",2,0],["وأربت جمالا وزادت سنا","ونورا إلى نورها السرمدي",21,"د",2,0],["واربأ بنفسك عن تسامح بائع","واغنم إذا سامتك شهوة مشتر",22,"ر",1,0],["واربأ بنفسك فهي أسمى غاية","من أن تذوب صبابة وغراما",23,"م",2,0],["وأربعاً ما وراء الحصن ليس بها","إلا مكحلة من حورها العين",24,"ن",1,0],["وأَربَى على نورِ الغزالة نورُه","كما يفضل الحُرُّ الكريمُ على العَبدِ",25,"د",1,0],["واربأ بنفسك أن تُرى","مستمرئاً في العيش جبنا",26,"ن",2,0],["واربدَّ ضوءُ الشمسِ في رأد الضحى","حتى استوى الإشراقُ والإظلام",27,"م",1,0],["واربدَّ وجهُ الحكم لمّا أن رأى","ذاك السَّنا متوارياً بحجاب",28,"ب",1,0],["وأربي على محبتها القو","مَ لترقى بهم على الأقوام",29,"م",1,0],["وأربت على الستين مدة عيشتي","كذلك لم أعرف لنفسي موطنا",30,"ن",2,0],["وَأَرْبُعُ الْعِلْمِ لَمْ يُلْفَ بِمَنْهَلِهَا","مِنَ الأَفَاضِلِ لاَ سَاقٍ وَلاَ فَرُطُ",31,"ط",1,0],["وأربح الناس عندي في تجارته","محصلٌ يشتري بالفضة الذهبا",32,"ب",2,0],["وَأَربعا نمْنمَتْ يُمْنَى الرَّبيعِ لَها","ما شِئت مِنْ خِلَعٍ مَوْشِيَّةٍ وكُسى",33,"س",2,0],["وَأَرْبى عَلَى الأملاكِ مَجداً وَسُؤْدَداً","فجرَّ عَلى الأفلاكِ أرْدِيَة الفَخْرِ",34,"ر",1,0],["وأربابُ الحِجا خُلِقوا ليَأْتوا","خِلافَ صَنيعِ رَبّاتِ الحِجال",35,"ل",1,0],["وار بأبنفسك أن تقيم","بحيث يغشاك الدرن",36,"ن",1,0],["وأربعمائة خُتِنَتْ وكانت","يَتامى لم تُسَنَّنْ بالختان",37,"ن",1,0],["وأَربابُ مُلْكٍ فِي رياسةِ أُمَّةٍ","لهم فِي المعالي عِيرُها ونفيرُها",38,"ر",3,0],["وأَربعة عُربا وعُجما جَميعهم","فهذي جَميع الأَنبياء أَتَت تَتَرى",39,"ر",2,0],["وأرْبى أمير المؤمنين عليهمُ","عليهم صلاةٌ جَمَّةٌ وسلامُ",40,"م",1,0],["وارب غادية يسح دموعها","ضحك البروق على ثرى بطحائها",41,"ا",3,0],["وَاِربِط عَلى يَدِكَ اللِقاءُ عَشِيَّةً","فَأَنا عَلى خَيلِ الجَريدَةِ وارِدُ",42,"د",1,0],["وَاِربِط عَلى كَفِّكَ إِن أَنتَ لَم","تُجِب سُؤالي أَنَّني أَغضَبُ",43,"ب",1,0],["وأربعٌ يشقى بها مغرمٌ","تُقلِقُه الذكرى ومشتاقُ",44,"ق",1,0],["واربأ بنفسك عن رب الحماقة واس","تبدله بالكيس الأخلاق ذي الأدب",45,"ب",1,0],["وارْبُضْ ببابِ الأَمرِ واهْجُرْ غيرَهُ","مُتَجَرِّداً من كلِّ علمٍ أَو عَمَلْ",46,"ل",1,0],["وأربعُة أسرى بُطونَهمُ جَثَوا","بأطرافِهم تبَّت يَداهمُ مِن أسرى",47,"ر",2,0],["وَأَربَدَّ مِن خَشيَةِ السُؤالِ كَما","يَربَدُّ عِندَ الوَفاةِ ذُو أَلَمِ",48,"م",1,0],["وَأَربَعَةٌ وَالمُصطَفى خامِسٌ لَهُم","أَفاضَ عَلَيهِم مِرطَهُ وَتَلا فَصلا",49,"ل",2,0],["وأَرْبى ولا نَقْصٌ عَلمْتُم عَليْهِمُ","وزيرٌ أَقام الملكَ والدينَ والدُّنَا",50,"ن",2,0],["وأَربعةٌ قطُّ لم تَفْتَرِقْ","هَوىً وجوىً وحياةٌ وهَمْ",51,"م",1,0],["وأَرْبَعَةٌ فيَّ ممَّا وَهَبْ","ت نَفْسٌ وروحٌ ولَحمٌ وَدَمْ",51,"م",1,0]]}