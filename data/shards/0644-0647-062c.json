{"poems":[[77,"قسما بالليل وما وسقا","https://www.aldiwan.net/poem35922.html","المتدارك"],[77,"أهاجتك ذكرى من خليط ومعهد","https://www.aldiwan.net/poem36601.html","الطويل"],[73,"جاءتك وافدة الشمول","https://www.aldiwan.net/poem11978.html","مجزوء الكامل"],[35,"ألما على سلمى نسلم ونسأل","https://www.aldiwan.net/poem39099.html","الطويل"],[93,"أمر من يطلب الخلود عسير","https://www.aldiwan.net/poem9165.html","الخفيف"],[37,"ألم تتعجبي من ريب دهر","https://www.aldiwan.net/poem7679.html","الوافر"],[72,"ما لظبي الحمى إليه التفاته","https://www.aldiwan.net/poem18387.html","الخفيف"],[51,"ثنى شوقه والمرء يصحو ويسكر","https://www.aldiwan.net/poem63015.html","الطويل"],[85,"كبير السابقين من الكرام","https://www.aldiwan.net/poem63748.html","الوافر"],[45,"أما الخيال فإنه لم يطرق","https://www.aldiwan.net/poem65181.html","الكامل"],[45,"عست دمن بالأبرقين خوال","https://www.aldiwan.net/poem65567.html","الكامل"],[61,"أحبب إلي بإلف ذي مساعدة","https://www.aldiwan.net/poem51619.html","البسيط"],[49,"تبارك رب لايزال ولم يزل","https://www.aldiwan.net/poem10345.html","الطويل"],[49,"جمعت من الدنيا وحزت ومنيتا","https://www.aldiwan.net/poem10833.html","الطويل"],[80,"وليث مقيم في غياض منيعة","https://www.aldiwan.net/poem31232.html","الطويل"],[44,"إن بكاء في الدار من أربه","https://www.aldiwan.net/poem30574.html","المنسرح"],[87,"ألا من معيني على صاحب","https://www.aldiwan.net/poem8261.html","المتقارب"],[69,"لهجوا سنين بجوسلين فإنه","https://www.aldiwan.net/poem28047.html","الكامل"],[105,"أقبل عليك من الشعوب سلام","https://www.aldiwan.net/poem42067.html","الكامل"],[105,"هل الحرب إلا أن تطير الجماجم","https://www.aldiwan.net/poem43156.html","الطويل"],[105,"مرحبا بالوفد وافى من هجر","https://www.aldiwan.net/poem44012.html","المتقارب"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85837","المجتث"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39664","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42562","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42707","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42561","الخفيف"],[106,"سمر الأدباء","https://www.poetsgate.com/ViewPoem.aspx?id=179454",""],[106,"الكلب هول","https://www.poetsgate.com/ViewPoem.aspx?id=179445",""],[115,"أرق من الصبا النجدي طبعا","https://www.aldiwan.net/poem41516.html","الوافر"],[128,"خليلى هل بعد السنين الغوائر","https://www.aldiwan.net/poem50598.html","الطويل"],[133,"لهجت بذكرك السن المداح","https://www.aldiwan.net/poem4244.html","الكامل"],[150,"بذكرك نستكفي وإياك نعبد","https://www.aldiwan.net/poem68496.html","الطويل"],[150,"بدت لجفونك العبر","https://www.aldiwan.net/poem68498.html","مجزوء الرمل"],[150,"قضى القلب من عهد الشباب ديونه","https://www.aldiwan.net/poem68583.html","الطويل"],[160,"ولعت به كبدر التم يبدو","https://www.aldiwan.net/poem58989.html","الطويل"],[169,"من ذا أفتاك بسفك دمي","https://www.aldiwan.net/poem1682.html",""],[185,"هناك الفخر يا شهر الصيام","https://www.aldiwan.net/poem14663.html","الوافر"],[186,"رأيت مهفهفا كالغصن مالت","https://www.aldiwan.net/poem44136.html","الوافر"],[235,"ليهنك أن عيني ما تنام","https://www.aldiwan.net/poem31761.html","الوافر"],[248,"اغالط مهما سميت ام خالد","https://www.aldiwan.net/poem1318.html",""],[261,"تذكر مهدا بالغوير ومعهدا","https://www.aldiwan.net/poem38337.html","الطويل"],[270,"هي الريح قد هبت من الغرب صرصرا","https://www.aldiwan.net/poem35642.html","الطويل"],[275,"ما للهوى إلا الرصافة مأرب","https://www.aldiwan.net/poem25635.html","الكامل"],[364,"صب مقيم سائر فؤاده","https://www.aldiwan.net/poem60930.html","الرجز"],[377,"إن الإله قدير في تصرفه","https://www.aldiwan.net/poem59418.html","البسيط"],[406,"إن الحمول غداة غربة غرب","https://www.aldiwan.net/poem50208.html","الكامل"],[409,"أأحبابنا خطب التفرق شاغل","https://www.aldiwan.net/poem32278.html","الطويل"],[409,"من مبلغ النائي المقيم تحية","https://www.aldiwan.net/poem32410.html","الكامل"],[409,"لو أحسنوا في ملكنا أو أعتقوا","https://www.aldiwan.net/poem32423.html","الكامل"],[437,"إن داراً بين اللوى والعفيق","https://www.aldiwan.net/poem2547.html","الخفيف"],[439,"عزم حداه السعد والإقبال","https://www.aldiwan.net/poem34802.html","الكامل"],[441,"عزاء وصبرا كل حي فميت","https://www.aldiwan.net/poem14441.html","الطويل"],[452,"وذي قامة في الزهر تندى غضارة","https://www.aldiwan.net/poem13778.html","الطويل"],[500,"كثر الصنوف وأنت أنت الواحد","https://www.aldiwan.net/poem37565.html","الكامل"],[514,"ويا وميض بروق المزن إن سفرت","https://www.aldiwan.net/poem20795.html","البسيط"],[529,"يقولون دق قد عراك فقلت لا","https://www.aldiwan.net/poem37285.html","الطويل"],[562,"ما بين أعطاف القدود الهيف","https://www.aldiwan.net/poem52947.html","الكامل"],[575,"أمجلس لهوي ليس لي منك مجلس","https://www.aldiwan.net/poem3058.html","الطويل"],[576,"إني لقطاع اللبانة والهوى","https://www.aldiwan.net/poem1774.html","الطويل"]],"verses":[["لهَجَرْتَ النّوْمَ لِطاعَتِهِ","بالغَزْوِ وواصَلْتَ الأرَقا",0,"ق",2,0],["لهُ جبَلٌ في مُلْتَقَى الهوْلِ عاصِمٌ","يُناولُ مَنْ يحْتَلّهُ النّجْمَ باليَدِ",1,"د",1,0],["لَهَجَرتَها صَفراءَ في","بَيضاءَ هاجِرُها قَليل",2,"ل",1,0],["لَهُ جَزَرٌ في كُلِّ يَومٍ يَجُرُّهُ","إِلى لَبواتٍ في العَرينِ وَأَشبُلِ",3,"ل",1,0],["لهج ما ادخرت عزماً ول","كن مرادي ناء وباعي قصير",4,"ر",1,0],["لَهُ جَمَعُوا اللَّتَينِ إِلى اللُّتَيَّا","فَلاَ حَلِماً لَقُوهُ وَلاَ عَطِينا",5,"ن",2,0],["لهِجٌ بالهوى وإن نفرت أي","دِي الليالي غزالَهُ ومهاته",6,"ت",2,0],["له جُنة لا تستعار وشِكّة","هو الدهر في هذي وهذي مكفَّرُ",7,"ر",1,0],["لُهِجتَ باِلاِحتِلالِ وَما أَتاهُ","وَجُرحُكَ مِنهُ لَو أَحسَستَ دامي",8,"م",2,0],["لَهِجٌ بِإِصلاحِ الأُمورِ يَروضُها","تَدبيرُهُ في مَنهَجٍ مُستَوسِقِ",9,"ق",1,0],["لَهُ جَوهَرٌ في الجودِ يُبديهِ بِشرُهُ","كَذا السَيفُ يَبدو أَثرُهُ بِصِقالِ",10,"ل",1,0],["له جَناحانِ يَحْبُو الشَّرْبَ خَفقُهُما","بلؤلؤٍ من حَبابِ الماءِ مَنثور",11,"ر",1,0],["لَهِجتُ بِدارِ المَوتِ مُستَحسِناً لَها","وَحَسبي لِدارِ المَوتِ بِالمَوتِ مِن عَيبِ",12,"ب",1,0],["لَهِجتَ بِأَنواعِ الأَباطيلِ غِرَّةً","وَأَدنَيتَ أَقواماً عَلَيها وَأَقصَيتا",13,"ت",2,0],["له جبهةٌ مثل المجنّ ومعطسٌ","كأنّ على أرجائه صبغةَ الحبرِ",14,"ر",1,0],["لَهُ جَلالٌ إِذا تَسَربَلَهُ","أَكسَبَهُ البَأوَ غَيرَ مُكتَسِبِه",15,"ب",2,0],["لَهُ جَهَلاتٌ تُمِيتُ الرِّضَا","وَحُمْقٌ يَكَادُ يُسِيلُ الدِّمَا",16,"م",2,0],["لهجوا سنينَ بجوسلينَ فإنَّهُ","قَدْ كانَ علجاً عالياً في كفرِهِ",17,"ه",1,1],["لَهِجٌ بأخبارِ السّماءِ يَهيجُه","عند الكواكبِ مَطلبٌ ومَرامُ",18,"م",1,0],["لَهُ جَهلاتٌ يَرتَمينَ بِهِ سُدىً","كَذي أَولَقٍ لَم تُغنِ عَنهُ التَمائِمُ",19,"م",1,0],["لهجوا بالخمرِ ثُمَّ ازْدَجرُوا","وعنِ الخمرِ غِنىً للمُزدجِرْ",20,"ر",1,0],["له جنود وسيف","ماض وحبل متين",21,"ن",1,0],["له جنان وأنها","ر ماؤهن معين",21,"ن",1,0],["لهجَتْ قلوبٌ بالذي صَنَعَتْ يدٌ","شَدَّتْ لجُرْح المسلمين ضِمادا",22,"د",2,0],["لَهِجٌ بِحُبِّ الصَّالِحَاتِ فَكُلَّمَا","بَلَغَ النِّهَايَةَ مِنْ صَنِيعٍ يَبْتَدِي",23,"د",2,0],["لَهِجٌ بِعَارِيَةِ الْحَيَاةِ وَمَا دَرَى","أَنَّ الْحَيَاةَ إِلَى الْمَنُونِ مَسَاقُ",24,"ق",1,0],["لَهِجٌ بِالْحُروبِ لا يَأْلَفُ الْخَفْ","ضَ ولا يَصْحَبُ الْفَتَاةَ الرَّدَاحَا",25,"ح",2,0],["لهجوا بذكر «فرانسَ» حتى خلته","حيا، إليه بالبنان يشار",26,"ر",1,0],["لهجت بذكرك ألسُنٌ","وروت حوادثَكَ الرواة",27,"ا",2,0],["له جد الغزال وعين ريم","وهزة سمهري ودلال حورا",28,"ر",2,0],["لهُ جوُد كفٍّ لا يقاسُ بأولٍ","وبحرُ عطاءِ لا يقاسُ بآخِر",29,"ر",1,0],["لهجت بذكرِك السن المداحِ","وسمت بذكرِك رُتبَةُ الأمداحِ",30,"ح",1,1],["له جمع الله الديانة والدُّنا","وهل جَمَعَ الدارين إلاَّ مؤيد",31,"د",1,0],["له جودٌ كأن البحر","تطفو فوقه الدُّرر",32,"ر",1,0],["لَهُ جَمَعَ اللَهُ الفَضائِلَ كُلَّها","فَمِقدارُهُ يَعلو وَتَذكارُهُ يَحلو",33,"و",1,0],["له جندان من سيف ومال","فكلهما لحاجته معد",34,"د",1,0],["لَهِجٌ بَهِجٌ بِفَواضِلِهِ","سَمحٌ طَمحٌ عَالي الهِمَمِ",35,"م",1,0],["له جيشٌ سَماويٌّ خَفِيٌّ","كظاهرِ جيشِه اللَّجِبِ اللُّهام",36,"م",1,0],["له جفنان قد مليا سقاما","يبثان السقام إلى القلوب",37,"ب",1,0],["لَهُ جودٌ وَبَأسٌ وَاِصطِناعٌ","وَإِرغامٌ وَعَفوٌ وَاِنتِقامُ",38,"م",1,0],["له جانب سفل وعلو كلاهما","تباعد حتى ليس يبلغه العدو",39,"و",1,0],["لهجت بذم الدهر عنه وانني","ليشغلني مدحي الرئيس محمدا",40,"د",2,0],["له جَفَّتِ الجنَاتُ إذ بضَّ ماؤها","فما الحُورُ والولدان يُسقَونَ كوثرا",41,"ر",2,0],["لَهَجاً بِدُولاب تَرَقّى نهره","فَلَكا ولكنْ مَا ارْتَقاهُ كَوْكَبُ",42,"ب",1,0],["له جوىً مُخامِرُ يَعتادُه","إذا اشتكى طيفَ الكَرى في العُوّد",43,"د",1,0],["له جمالٌ يفوق العالمين به","من حبه كلُّ قلبٍ في مسمار",44,"ر",1,0],["لَهِجَ اللِسانُ لِزائريه بِمَرحبٍ","إِنَّ النَدى عنوانه في مرحَبِ",45,"ب",1,0],["لهِجتُم بهجرِي والدّيارُ قريبةٌ","وما قربُ دارٍ حالَ من دونِها الهَجرُ",46,"ر",1,0],["لَهجٍ مع اليأْسِ المُبينِ بذكْرِه","قَلقِ الحشَا لِبِعادِهِ خَفّاقِهِ",47,"ق",2,0],["لَهِجُوا بهَجري في الدُّنوِّ كأنّهُم","لم يعلَمُوا أنّ الزّمانَ يُفَرِّقُ",48,"ق",1,0],["لهج باقتناء مجد إذا ما","لهج الناس بالخنا والغسوق",49,"ق",1,0],["لهجُوا بيَا منصورُ فَهْوَ شِعارُهُمْ","نَغَمٌ تعوَّدَ صِدْقَهُنَّ الفالُ",50,"ل",1,0],["لهجرة مولانا النبي محمد","عليه صلاة اللَه ما هز صيت",51,"ت",1,0],["له جُمَمٌ زُغْبٌ تَفَلَّك حَوْلَها","من الزهر إِفريز كأجربة العِطْر",52,"ر",1,0],["لهجت بها شعراءُ حبِّك فانجلى","عنهم هناك نشائدٌ وقصائدُ",53,"د",1,0],["له جِبالُ حُلومٍ لو شوامخُها","رسَتْ على السّبعة الأفلاكِ لم تَدُرِ",54,"ر",1,0],["لَهُ جُلُّ َلْطَافٍ ودَقُّ مَواهِبٍ","لِمَنْ كانَ للبابِ الْوَسِعِ يَدُقُّ",55,"ق",1,0],["لَهِجٌ بخُلقِ الزاهدِينَ أحَبُّ من","لُبس الشَّفُوفِ إليهِ لُبسُ الصوفِ",56,"ف",1,0],["له جَحْفَلٌ جرَّ القَنا فتعثَّرَت","قَنَا الخَطِّ إِلاَّ أَنَّها ليسَ تَنْفَسُ",57,"س",1,0],["لَهُ جُدَدٌ سودٌ كَأَنَّ أَرَندَجاً","بِأَكرُعِهِ وَبِالذِراعَينِ سُندُسُ",58,"س",1,0]]}