com/ViewPoem.aspx?id=120992",""],[1021,"كم شب في القلب نارا","https://www.poetsgate.com/ViewPoem.aspx?id=47802",""],[5338,"في رثاء أستاذي الأول قدس الله سره","https://www.poetsgate.com/ViewPoem.aspx?id=187778",""],[5376,"يا نبيُّ اللهِ يا نورُ السما","https://www.poetsgate.com/ViewPoem.aspx?id=188536",""],[5431,"له...له...","https://www.poetsgate.com/ViewPoem.aspx?id=191170",""],[5431,"فتطوى له الأكوان طيّ الشرائح","https://www.poetsgate.com/ViewPoem.aspx?id=192308",""],[5490,"هل جادك الوجد؟","https://www.poetsgate.com/ViewPoem.aspx?id=176135",""],[5593,"لهجت يمينك بالندى، فبنانها","https://www.poetsgate.com/ViewPoem.aspx?id=181042",""],[5596,"ردي على قصيدة ناصر بن سعيد الرواحي","https://www.poetsgate.com/ViewPoem.aspx?id=206691",""],[5642,"مُذكرات طفل سوري","https://www.poetsgate.com/ViewPoem.aspx?id=131268",""],[5690,"إذا ما المجد داريهِ الكلامُ","https://www.poetsgate.com/ViewPoem.aspx?id=172178",""],[5755,"جنون الشك والغيره","https://www.poetsgate.com/ViewPoem.aspx?id=133413",""],[5847,"المولد النبوي الشريف لعام 1435 ه","https://www.poetsgate.com/ViewPoem.aspx?id=176834",""],[5956,"تصدُّ النفسُ","https://www.poetsgate.com/ViewPoem.aspx?id=215870",""],[6070,"قلبي يَفِرُّ مِنَ الأضلاعِ للرَّهفِ","https://www.poetsgate.com/ViewPoem.aspx?id=191458",""],[6290,"بلاد وعُمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85151&r=&rc=19",""]],"verses":[["لهَجَرْتَ النّوْمَ لِطاعَتِهِ","بالغَزْوِ وواصَلْتَ الأرَقا",0,"ق",2,0],["لهُ جبَلٌ في مُلْتَقَى الهوْلِ عاصِمٌ","يُناولُ مَنْ يحْتَلّهُ النّجْمَ باليَدِ",1,"د",1,0],["لَهَجَرتَها صَفراءَ في","بَيضاءَ هاجِرُها قَليل",2,"ل",1,0],["لَهُ جَزَرٌ في كُلِّ يَومٍ يَجُرُّهُ","إِلى لَبواتٍ في العَرينِ وَأَشبُلِ",3,"ل",1,0],["لهج ما ادخرت عزماً ول","كن مرادي ناء وباعي قصير",4,"ر",1,0],["لَهُ جَمَعُوا اللَّتَينِ إِلى اللُّتَيَّا","فَلاَ حَلِماً لَقُوهُ وَلاَ عَطِينا",5,"ن",2,0],["لهِجٌ بالهوى وإن نفرت أي","دِي الليالي غزالَهُ ومهاته",6,"ت",2,0],["له جُنة لا تستعار وشِكّة","هو الدهر في هذي وهذي مكفَّرُ",7,"ر",1,0],["لُهِجتَ باِلاِحتِلالِ وَما أَتاهُ","وَجُرحُكَ مِنهُ لَو أَحسَستَ دامي",8,"م",2,0],["لَهِجٌ بِإِصلاحِ الأُمورِ يَروضُها","تَدبيرُهُ في مَنهَجٍ مُستَوسِقِ",9,"ق",1,0],["لَهُ جَوهَرٌ في الجودِ يُبديهِ بِشرُهُ","كَذا السَيفُ يَبدو أَثرُهُ بِصِقالِ",10,"ل",1,0],["له جَناحانِ يَحْبُو الشَّرْبَ خَفقُهُما","بلؤلؤٍ من حَبابِ الماءِ مَنثور",11,"ر",1,0],["لَهِجتُ بِدارِ المَوتِ مُستَحسِناً لَها","وَحَسبي لِدارِ المَوتِ بِالمَوتِ مِن عَيبِ",12,"ب",1,0],["لَهِجتَ بِأَنواعِ الأَباطيلِ غِرَّةً","وَأَدنَيتَ أَقواماً عَلَيها وَأَقصَيتا",13,"ت",2,0],["له جبهةٌ مثل المجنّ ومعطسٌ","كأنّ على أرجائه صبغةَ الحبرِ",14,"ر",1,0],["لَهُ جَلالٌ إِذا تَسَربَلَهُ","أَكسَبَهُ البَأوَ غَيرَ مُكتَسِبِه",15,"ب",2,0],["لَهُ جَهَلاتٌ تُمِيتُ الرِّضَا","وَحُمْقٌ يَكَادُ يُسِيلُ الدِّمَا",16,"م",2,0],["لهجوا سنينَ بجوسلينَ فإنَّهُ","قَدْ كانَ علجاً عالياً في كفرِهِ",17,"ه",1,1],["لَهِجٌ بأخبارِ السّماءِ يَهيجُه","عند الكواكبِ مَطلبٌ ومَرامُ",18,"م",1,0],["لَهُ جَهلاتٌ يَرتَمينَ بِهِ سُدىً","كَذي أَولَقٍ لَم تُغنِ عَنهُ التَمائِمُ",19,"م",1,0],["لهجوا بالخمرِ ثُمَّ ازْدَجرُوا","وعنِ الخمرِ غِنىً للمُزدجِرْ",20,"ر",1,0],["له جنود وسيف","ماض وحبل متين",21,"ن",1,0],["له جنان وأنها","ر ماؤهن معين",21,"ن",1,0],["لهجَتْ قلوبٌ بالذي صَنَعَتْ يدٌ","شَدَّتْ لجُرْح المسلمين ضِمادا",22,"د",2,0],["لَهِجٌ بِحُبِّ الصَّالِحَاتِ فَكُلَّمَا","بَلَغَ النِّهَايَةَ مِنْ صَنِيعٍ يَبْتَدِي",23,"د",2,0],["لَهِجٌ بِعَارِيَةِ الْحَيَاةِ وَمَا دَرَى","أَنَّ الْحَيَاةَ إِلَى الْمَنُونِ مَسَاقُ",24,"ق",1,0],["لَهِجٌ بِالْحُروبِ لا يَأْلَفُ الْخَفْ","ضَ ولا يَصْحَبُ الْفَتَاةَ الرَّدَاحَا",25,"ح",2,0],["لهجوا بذكر «فرانسَ» حتى خلته","حيا، إليه بالبنان يشار",26,"ر",1,0],["لهجت بذكرك ألسُنٌ","وروت حوادثَكَ الرواة",27,"ا",2,0],["له جد الغزال وعين ريم","وهزة سمهري ودلال حورا",28,"ر",2,0],["لهُ جوُد كفٍّ لا يقاسُ بأولٍ","وبحرُ عطاءِ لا يقاسُ بآخِر",29,"ر",1,0],["لهجت بذكرِك السن المداحِ","وسمت بذكرِك رُتبَةُ الأمداحِ",30,"ح",1,1],["له جمع الله الديانة والدُّنا","وهل جَمَعَ الدارين إلاَّ مؤيد",31,"د",1,0],["له جودٌ كأن البحر","تطفو فوقه الدُّرر",32,"ر",1,0],["لَهُ جَمَعَ اللَهُ الفَضائِلَ كُلَّها","فَمِقدارُهُ يَعلو وَتَذكارُهُ يَحلو",33,"و",1,0],["له جندان من سيف ومال","فكلهما لحاجته معد",34,"د",1,0],["لَهِجٌ بَهِجٌ بِفَواضِلِهِ","سَمحٌ طَمحٌ عَالي الهِمَمِ",35,"م",1,0],["له جيشٌ سَماويٌّ خَفِيٌّ","كظاهرِ جيشِه اللَّجِبِ اللُّهام",36,"م",1,0],["له جفنان قد مليا سقاما","يبثان السقام إلى القلوب",37,"ب",1,0],["لَهُ جودٌ وَبَأسٌ وَاِصطِناعٌ","وَإِرغامٌ وَعَفوٌ وَاِنتِقامُ",38,"م",1,0],["له جانب سفل وعلو كلاهما","تباعد حتى ليس يبلغه العدو",39,"و",1,0],["لهجت بذم الدهر عنه وانني","ليشغلني مدحي الرئيس محمدا",40,"د",2,0],["له جَفَّتِ الجنَاتُ إذ بضَّ ماؤها","فما الحُورُ والولدان يُسقَونَ كوثرا",41,"ر",2,0],["لَهَجاً بِدُولاب تَرَقّى نهره","فَلَكا ولكنْ مَا ارْتَقاهُ كَوْكَبُ",42,"ب",1,0],["له جوىً مُخامِرُ يَعتادُه","إذا اشتكى طيفَ الكَرى في العُوّد",43,"د",1,0],["له جمالٌ يفوق العالمين به","من حبه كلُّ قلبٍ في مسمار",44,"ر",1,0],["لَهِجَ اللِسانُ لِزائريه بِمَرحبٍ","إِنَّ النَدى عنوانه في مرحَبِ",45,"ب",1,0],["لهِجتُم بهجرِي والدّيارُ قريبةٌ","وما قربُ دارٍ حالَ من دونِها الهَجرُ",46,"ر",1,0],["لَهجٍ مع اليأْسِ المُبينِ بذكْرِه","قَلقِ الحشَا لِبِعادِهِ خَفّاقِهِ",47,"ق",2,0],["لَهِجُوا بهَجري في الدُّنوِّ كأنّهُم","لم يعلَمُوا أنّ الزّمانَ يُفَرِّقُ",48,"ق",1,0],["لهج باقتناء مجد إذا ما","لهج الناس بالخنا والغسوق",49,"ق",1,0],["لهجُوا بيَا منصورُ فَهْوَ شِعارُهُمْ","نَغَمٌ تعوَّدَ صِدْقَهُنَّ الفالُ",50,"ل",1,0],["لهجرة مولانا النبي محمد","عليه صلاة اللَه ما هز صيت",51,"ت",1,0],["له جُمَمٌ زُغْبٌ تَفَلَّك حَوْلَها","من الزهر إِفريز كأجربة العِطْر",52,"ر",1,0],["لهجت بها شعراءُ حبِّك فانجلى","عنهم هناك نشائدٌ وقصائدُ",53,"د",1,0],["له جِبالُ حُلومٍ لو شوامخُها","رسَتْ على السّبعة الأفلاكِ لم تَدُرِ",54,"ر",1,0],["لَهُ جُلُّ َلْطَافٍ ودَقُّ مَواهِبٍ","لِمَنْ كانَ للبابِ الْوَسِعِ يَدُقُّ",55,"ق",1,0],["لَهِجٌ بخُلقِ الزاهدِينَ أحَبُّ من","لُبس الشَّفُوفِ إليهِ لُبسُ الصوفِ",56,"ف",1,0],["له جَحْفَلٌ جرَّ القَنا فتعثَّرَت","قَنَا الخَطِّ إِلاَّ أَنَّها ليسَ تَنْفَسُ",57,"س",1,0],["لَهُ جُدَدٌ سودٌ كَأَنَّ أَرَندَجاً","بِأَكرُعِهِ وَبِالذِراعَينِ سُندُسُ",58,"س",1,0],["له جهاد قد رَأتهُ العِدى","إذ كانَ في الثورةِ نعمَ الزعيم",59,"م",1,0],["لَهِجَ النّاسُ بِعِرضي وَبِها","ما لِهَذا النّاسِ يا قَومُ وَلي",60,"ل",2,0],["لهجت بهِ الاعرابُ دون تصنّعٍ","فيهِ فجاء وحسنهُ مفطورُ",61,"ر",1,0],["لهجت بمدحي للوزير فشاقني","وكل امرىء يولى الجميل محبب",62,"ب",1,0],["لهجت ببيعته النفوس فأخذها","من واجب الأشياء لو لم تلهج",63,"ج",1,0],["له جودٌ بفَجْعِ الوَفْرِ مُغرىً","وذاك هُوَ الغنيمةُ لا الفجيعه",64,"ع",2,0],["لَهُ جَبهَةٌ كَالشَّمسِ شَعشعَ ضَوؤُها","فَصارَ بِها بدرُ الدّجى لَيسَ يُعرفُ",65,"ف",1,1],["لهجرة المصطفى الهادي لأُمته","محمد القرشيِّ الطاهرِ الشِّيم",66,"م",1,0],["له جانب سهل فأما بلوته","وجدت أبياً لم ترمه اللوامح",67,"ح",1,0],["له جفون مراض","تدوي الصحيح صحاحُ",68,"ح",1,0],["له جفون تعنو لفتكتها","ما في جفون الصطرم الخذمِ",69,"م",1,0],["له جانب في القلب والنفس والنهى","وقل الذي يحوى الجليل فنونا",70,"ن",2,0],["لَهَجتُ بِذِكرِهِ لِأُبَيَّنَ عَنهُ","فَضاقَ بِوَصفِهِ ذَرعُ البَيانِ",71,"ن",1,0],["له جَيْبٌ صغير من ورائي","وآخرُ \"كالزكيبة\" فوق صدري",72,"ر",2,0],["لَهجَ الزَمانُ بِشُكرِكَ المَتضوّعِ","فَأَمِل سَماعَكَ لِلبَريةِ وَاِسمَعِ",73,"ع",1,1],["له جمل من مكرمات تعاظمت","وتفصيلها نال التقاصي عن الحصر",74,"ر",1,0],["له جمل الكمال ومفردات المزايا","وهو محرز خير همه",75,"م",2,0],["له جنة من وجنتيه وإنما","تعارضنا من دونه ثار هجره",76,"ر",2,0],["لَهُ جَمرٌ عَلى كَبِدي","إِذا حَرَّكتَهُ اِتَّقَدا",77,"د",2,0],["لَهُ جِسمُ بُرغوثٍ وَعَقلُ مُكاتِبٍ","وَغُلمَةُ سِنّورٍ يبيتُ يُوَلوِلُ",78,"ل",1,1],["لَهُ جَدث يَفوق البَرق لَمعاً","بِهِ أَضحى لِليل الشَك قَمعا",79,"ع",2,0],["لَهُ جَمَعَ اللَّهُ الشَّجَاعَةَ كُلَّهَا","فَكَانَ سِوَاهُ مِنْ شُجَاعٍ كَلاَ سِوَى",80,"و",2,0],["لهجوا منْ علاءِ شانكَ باسمٍ","سوف يَجْري لهم بأَبْرَحِ فال",81,"ل",1,0],["له جنودُ النصر والعزّ حمى","لا تبرحن عن بابه بل تُرحمن",82,"ن",1,0],["لهجت بمدحي فيه لا بد من قرا","دخيل أنا ما خاب فيه دخيل",83,"ل",1,0],["لَهُ جَمالٌ وَحُسنٌ جَلَّ مَن صَنَعَا","فَوَجهُهُ بالضِّيا وَالنُّورِ قَد سَطَعا",84,"ع",2,0],["له جُدبا لقصد مع وزرا","عينُ ميم طاويا احدى",85,"د",2,0],["لَهُ جيدُ الطّلى إِذ قامَ يَسعى","أَضَلَّ الضّرعَ أَم طَلَبَ الرَواحا",86,"ح",2,0],["له جَمالٌ في مَجالِ السَّبْقِ","وإنّه مُسَابقٌ لِلْبَرْقِ",87,"ق",1,0],["له جأواء مظلمة طحون","فوارسها تلهب كالأسود",88,"د",1,0],["لهجوا بهاروتٍ وبابل برهةً","حتى ظهرتَ فكان طرفك أسحرا",89,"ر",2,0],["لهجتَ بنا بلا نسبٍ إلينا","ولو نُسِبَ اليهودُ إلى القرودِ",90,"د",1,0],["له جلال وأخلاق مهذبة","تذكارها يبرىء المضنى من السقم",91,"م",1,0],["لهجت بأبيات امرؤ القيس هذه","فأكثرن إسراجي وحطي وترحالي",92,"ل",2,0],["له جريا على سنن التصافي","كما سلكا طريق الحق قصدا",93,"د",2,0],["لهج الناس بالقَريض فأَمسى","يَشتَري النظم منهمو بالآلى",94,"ل",2,0],["لهجرةِ هادينا النبيّ محمدٍ","هو المرتضى الزاكي الشفيعُ المشفّعُ",95,"ع",1,0],["لَهُ جُثَّةٌ عُظمى كَأنَّ إِهابَهُ","صَفيحُ حَديدٍ لا يُخَرَّقُ بِالنَبلِ",96,"ل",1,0],["لهِجتَ بالحُبِّ لَما أَن لَهَوتَ بِهِ","عَن كُلِّ شَيءٍ فَوَيحَ اللاهجِ اللاهي",97,"ا",3,0],["له جا بعير يشتكى ذا تذلل","على حضرة الاصحاب اذ صاحب الامر",98,"ر",1,0],["لَهُ جمعا جَمع الرجال بِذاته","وَما اِتحَدوا لَكنهم دَخَلوا ضمنا",99,"ن",2,0],["لَهُ جَناحٌ وَثيرٌ","مُضاعَفُ التَنميرِ",100,"ر",1,0],["لَهُ جُؤجؤٌ كالفِهرِ يكتنُّ زَورَه","بمُحتَنكٍ صَدق الظُهارِ جَديلِ",101,"ل",1,0],["لهَجَرنا المَنامَ حَتَّى تَنَاسَت","نحونا للخَيالِ طُرقُ المَسِيرِ",102,"ر",1,0],["له جناح وله يدان","ينقص عن خلقته الرجلان",103,"ن",1,0],["لهِجتُ بأمداحِ النبي محمدٍ","وساعدني فيها مقالي ومقولي",104,"ل",2,0],["لَهجت بشكرك يا علي","ي وَأَنصَفَتكَ المنصوفا",105,"ف",2,0],["لهج الزَمان بذكر آ","يك في الوَرى وَترنّما",106,"م",2,0],["لهجن من اللحونِ بساقِ حُرٍ","وما أطيارُ فلجٍ واللحونُ",107,"ن",1,0],["لهجت بهذا الغيثِ حتى فَضحتَهُ","وبنيتَ في فعلِ المكارمِ زُهْدَهُ",108,"د",2,0],["لَه جِسم وَلَيسَ لَه دَماءٌ","وَلا لَحم يُرى غَير العِظام",109,"م",1,0],["لهجاً بالإعرابِ إنّ لدَينا","بعضَ ما تشتَهي منَ الأعرابِ",110,"ب",1,0],["له جنة الفردوس مثوى فأرخوا","لمثوى علي بين روح وريحان",111,"ن",1,0],["له جانبٌ قاسي الصّفا ولربّما","يلين لداعي الحّب منه قياد",