{"poems":[[55,"ألا ناشدا ذاك الجناب الممنعا","https://www.aldiwan.net/poem30145.html","الطويل"],[95,"عذيري من ضنى القلب الحزين","https://www.aldiwan.net/poem11221.html","الوافر"],[53,"ألا قل لذي العطن الواسع","https://www.aldiwan.net/poem65403.html","المتقارب"],[45,"ما أنصف القوم ضبه وأمه الطرطبه","https://www.aldiwan.net/poem9511.html","المجتث"],[47,"بودي لو يهوى العذول ويعشق","https://www.aldiwan.net/poem65199.html","الطويل"],[63,"فؤاد علي بالسماح علوق","https://www.aldiwan.net/poem51508.html","الطويل"],[68,"أخلاي بالفيحاء إن طال بعدكم","https://www.aldiwan.net/poem40651.html","الطويل"],[47,"بوُدّيَ لَوْ يَهْوَى العَذولُ، وَيَعْشَقُ","https://www.poetsgate.com/ViewPoem.aspx?id=32173",""],[128,"إذا داعبه الحب","https://www.aldiwan.net/poem23742.html","الهزج"],[203,"هم الناس حى يروي الأرض مدمع","https://www.aldiwan.net/poem45406.html","الطويل"],[368,"طربن لترجيع الغناء المهزج","https://www.aldiwan.net/poem60970.html","الطويل"],[554,"أرق عيني طارق","https://www.aldiwan.net/poem47360.html","مجزوء الرجز"],[561,"بعيد الشبه يا عيني","https://www.aldiwan.net/poem34737.html","الهزج"]],"verses":[["وَإِن يَختَلِسنا ذَلِكَ العَضبَ حادِثٌ","فَمِن بَعدِ ما أَبقى الغِمادَ المُرَصَّعا",0,"ع",2,0],["وَإنْ يَخْتَلْ عَلَى الأفْرَاسِ تِيهاً","فَشَتْ فِيهِنَّ أَعْرَاضُ الْفُتُونِ",1,"ن",1,0],["وأني خدمت وأني استقمت","إذا ضلعت شيمة الضالع",2,"ع",1,0],["وَإِن يَخُنكَ لَعَمري","لَطالَما خانَ صَحبَه",3,"ب",2,0],["وَإِنّي خَليقٌ بَل حَقيقٌ بِعُقبِ ما","يُغَرِّبُ شَخصي أَنَّ شَوقي يُشَرِّقُ",4,"ق",1,0],["وإنّي خَليقٌ من نَداكَ بنَيْلِها","وأنتَ بما أُولِيتُ منكَ خَليقُ",5,"ق",1,0],["وَإِن يَخلُ مِن تِكرارِ ذِكري حَديثُكُمُ","فَلَم يَخلُ يَوماً مِن مَديحِكُم شِعري",6,"ر",2,0],["وإنّي خَليقٌ بَل حَقيقُ يِعُقْبِ ما","يُغَرِّبُ شَخصي، إنّ شَوْقي يُشَرِّقُ",7,"ق",1,0],["وأن يخفق للغزلان","ما مر به السرب",8,"ب",1,0],["وأن يخدعَ الإنسانُ غيرَ مجاملٍ","ويجزعُ إن أمسى كذلكَ يخدعُ",9,"ع",1,0],["وأَنّى خَطَتْ في الرّملِ طُرْقاً خفيّةً","على الحيِّ أن يَقْتافَها أُختُ مُدلِج",10,"ج",1,0],["وإنْ يخُنْ قومٌ وفى","أو كذّبوني صدّقا",11,"ق",2,0],["وإني خلفهم أعدو","أنادي آخر الركب",12,"ب",1,0]]}