{"poems":[[55,"ألا ناشدا ذاك الجناب الممنعا","https://www.aldiwan.net/poem30145.html","الطويل"],[95,"عذيري من ضنى القلب الحزين","https://www.aldiwan.net/poem11221.html","الوافر"],[53,"ألا قل لذي العطن الواسع","https://www.aldiwan.net/poem65403.html","المتقارب"],[45,"ما أنصف القوم ضبه وأمه الطرطبه","https://www.aldiwan.net/poem9511.html","المجتث"],[47,"بودي لو يهوى العذول ويعشق","https://www.aldiwan.net/poem65199.html","الطويل"],[63,"فؤاد علي بالسماح علوق","https://www.aldiwan.net/poem51508.html","الطويل"],[68,"أخلاي بالفيحاء إن طال بعدكم","https://www.aldiwan.net/poem40651.html","الطويل"],[47,"بوُدّيَ لَوْ يَهْوَى العَذولُ، وَيَعْشَقُ","https://www.poetsgate.com/ViewPoem.aspx?id=32173",""],[128,"إذا داعبه الحب","https://www.aldiwan.net/poem23742.html","الهزج"],[203,"هم الناس حى يروي الأرض مدمع","https://www.aldiwan.net/poem45406.html","الطويل"],[369,"طربن لترجيع الغناء المهزج","https://www.aldiwan.net/poem60970.html","الطويل"],[556,"أرق عيني طارق","https://www.aldiwan.net/poem47360.html","مجزوء الرجز"],[563,"بعيد الشبه يا عيني","https://www.aldiwan.net/poem34737.html","الهزج"],[995,"","https://poetry.dctabudhabi.ae/diwan/poem/96304","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59412","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59413","الخفيف"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64815","البسيط"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56629","الطويل"],[2302,"","https://poetry.dctabudhabi.ae/diwan/poem/124770","الطويل"],[2308,"","https://poetry.dctabudhabi.ae/diwan/poem/138926",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204585","السريع"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65453","الطويل"],[3242,"","https://poetry.dctabudhabi.ae/diwan/poem/124098","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131199",""],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66581","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58017","الطويل"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136404",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120245","الوافر"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35149","الكامل"],[5183,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=180172",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[5975,"فتب يا ربّ","https://www.poetsgate.com/ViewPoem.aspx?id=58784",""]],"verses":[["وَإِن يَختَلِسنا ذَلِكَ العَضبَ حادِثٌ","فَمِن بَعدِ ما أَبقى الغِمادَ المُرَصَّعا",0,"ع",2,0],["وَإنْ يَخْتَلْ عَلَى الأفْرَاسِ تِيهاً","فَشَتْ فِيهِنَّ أَعْرَاضُ الْفُتُونِ",1,"ن",1,0],["وأني خدمت وأني استقمت","إذا ضلعت شيمة الضالع",2,"ع",1,0],["وَإِن يَخُنكَ لَعَمري","لَطالَما خانَ صَحبَه",3,"ب",2,0],["وَإِنّي خَليقٌ بَل حَقيقٌ بِعُقبِ ما","يُغَرِّبُ شَخصي أَنَّ شَوقي يُشَرِّقُ",4,"ق",1,0],["وإنّي خَليقٌ من نَداكَ بنَيْلِها","وأنتَ بما أُولِيتُ منكَ خَليقُ",5,"ق",1,0],["وَإِن يَخلُ مِن تِكرارِ ذِكري حَديثُكُمُ","فَلَم يَخلُ يَوماً مِن مَديحِكُم شِعري",6,"ر",2,0],["وإنّي خَليقٌ بَل حَقيقُ يِعُقْبِ ما","يُغَرِّبُ شَخصي، إنّ شَوْقي يُشَرِّقُ",7,"ق",1,0],["وأن يخفق للغزلان","ما مر به السرب",8,"ب",1,0],["وأن يخدعَ الإنسانُ غيرَ مجاملٍ","ويجزعُ إن أمسى كذلكَ يخدعُ",9,"ع",1,0],["وأَنّى خَطَتْ في الرّملِ طُرْقاً خفيّةً","على الحيِّ أن يَقْتافَها أُختُ مُدلِج",10,"ج",1,0],["وإنْ يخُنْ قومٌ وفى","أو كذّبوني صدّقا",11,"ق",2,0],["وإني خلفهم أعدو","أنادي آخر الركب",12,"ب",1,0],["وإن يَخُنّا زَمانٌ لا نُعاتِبُه","فقد أرانا وما في عظمنا رَقَقُ",13,"ق",1,0],["وأنيخ من باب السلام وكائبي","وأحطّ في أكناف طيبة محملي",14,"ل",2,0],["وأنيخا ببابها عيس قصدي","عن العيس فاطرحا الأوكارا",15,"ر",2,0],["وإنْ يُخالِفْ عَذولي في مَحَبَّتِهَا","تَقْبيحَ صَبْري بِها أَو حُسْنَ وَسْواسي",16,"س",2,0],["وإن يخدم الأوطان صاحب أمرها","كما تخدم الأوطان بالعين يخدم",17,"م",1,0],["وإن يخل عن جعل فمنه محرّم","كنرد وشطرنج وشبههما اعدد",18,"د",1,0],["وأنيخا بها المطايا وميلا","للثرى وانشقا أريج شذاها",19,"ا",3,0],["وإن يخب ظني بوحش الفلا","فلست حيواناً اذن بل نبات",20,"ت",1,0],["وإن يخذُلنك الدّهرُ يوماًن فإنّهُ","على الدّهر نصرٌ فقد لناصر",21,"ر",1,0],["وإن يخفف حسابي لا أناقشُه","وتستحيل عيوبي كلّهن حلا",22,"ل",2,0],["وأن يخفضوا الجوزاء عن مسرتقها","من الأفق أو أن يجعلوا العضب نابيا",23,"ي",2,0],["وَأَنْ يَخورَ عَلى القُرْبانِ عِجْلُهُمْ","جَهْراً وَيَخْفَى أَذانٌ أَوْ تِلاواتُ",24,"ت",1,0],["وإنِّي خبيرٌ بالزَّمَانِ وأهله","وأعرف منهم سُوقَةً وأَكابِرَا",25,"ر",2,0],["وان يخطر على قلبي نواها","نوى معها الرحيل إلى النزيح",26,"ح",1,0],["وان يخفق يقولوا قد رأينا","له الاخفاق في صدر العواقب",27,"ب",1,0],["وَأُنيخ حَيثُ دُموعُ عَيني منهَلٌ","يُروي وَحَيث حَشايَ مَوقِدُ نارِ",28,"ر",1,0],["وإن يخاتلني على مرصده","يختل من المنعة عنقاء الفضا",29,"ا",1,0],["وان يخادعني في صفرائه","فلي ضمير باللهى لا يشترى",29,"ا",1,0],["وأن يخرق الأعدا سياجاً من الهدى","وأن يهدم الأوباش ما كان قيما",30,"م",2,0],["وإني خاطئٌ جانٍ أثيمٌ","تعشعشُ ضمنَ خافقِهِ الشرورُ",31,"ر",1,0]]}