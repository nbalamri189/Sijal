{"poems":[[310,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52046","الكامل"],[1965,"","https://poetry.dctabudhabi.ae/diwan/poem/102726","المتدارك"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130837",""],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48300","الخفيف"]],"verses":[["وَلِقصرهِ لِقصوره قد كلّف ال","إيمان بالغيبِ الّذي هو أجمعُ",0,"ع",1,0],["ولِقَصرِها فيك المحبَّة لم تَكُنْ","تَلقَاكَ بَعْدُ بِشِركَةِ المُتوَلِّدِ",1,"د",1,0],["ولقصدكَ أوقاتٌ فارفق","فعديمُ النضجِ أخو السقمِ",2,"م",1,0],["ولقصتي في حبها","دمعي جرى بدمٍ صهيرٍ",3,"ر",1,0],["ولِقصّادِه جَناباً مَريعاً","ومُحيّاً سمْحاً ورفداً جَزيلا",4,"ل",2,0]]}