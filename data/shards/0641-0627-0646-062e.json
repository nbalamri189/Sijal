{"poems":[[73,"أدرها فقد حسن المجلس","https://www.aldiwan.net/poem11924.html","المتقارب"],[93,"وفاء كهذا العهد فليكن العهد","https://www.aldiwan.net/poem9845.html","الطويل"],[51,"يا ابن الوزيرين سمعا من أخي طلب","https://www.aldiwan.net/poem10000.html","البسيط"],[51,"إن أنت صادفت أخا لحية","https://www.aldiwan.net/poem62961.html","الطويل"],[91,"من الفرنسيس قيد العين صورتها","https://www.aldiwan.net/poem8873.html","عموديه"],[85,"وهذه واقعة مستغربه","https://www.aldiwan.net/poem8047.html","الرجز"],[45,"تعاط الصبابة أو عانها","https://www.aldiwan.net/poem66802.html","المتقارب"],[66,"ملكت ببعض برك رق شكري","https://www.aldiwan.net/poem38795.html","الوافر"],[80,"يمضي لك السيف ما تنويه والقلم","https://www.aldiwan.net/poem31288.html","البسيط"],[44,"جرت له أسماء حبل الشموس","https://www.aldiwan.net/poem30479.html","السريع"],[52,"عودوا إلى الإصباح","https://www.aldiwan.net/poem27153.html","المجتث"],[48,"على خبز إسماعيل واقية البخل","https://www.aldiwan.net/poem65041.html","الطويل"],[48,"قولوا لمن قد تنفر","https://www.aldiwan.net/poem66288.html","المجتث"],[46,"إذا بلغ الوليد لديك عشرا","https://www.aldiwan.net/poem22408.html","الوافر"],[46,"نادى حشا الأم بالطفل الذي اشتملت","https://www.aldiwan.net/poem22432.html","البسيط"],[46,"لقد غادر العيش هذا السواد","https://www.aldiwan.net/poem22441.html","المتقارب"],[46,"يجوز أن تطفأ الشمس التي وقدت","https://www.aldiwan.net/poem23070.html","البسيط"],[46,"يا نفس جسمك سربال له خطر","https://www.aldiwan.net/poem23226.html","البسيط"],[15,"أرقت لضوء برق في نشاص","https://www.aldiwan.net/poem45263.html","الوافر"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12640","البسيط"],[45,"تَعَاطَ الصّبَابَةَ، أوْ عَانِها","https://www.poetsgate.com/ViewPoem.aspx?id=31823",""],[46,"لقد غادرَ العيشُ هذا السّوادَ،","https://www.poetsgate.com/ViewPoem.aspx?id=18544",""],[46,"نادى حَشا الأمّ بالطفل الذي اشتملت","https://www.poetsgate.com/ViewPoem.aspx?id=18535",""],[46,"إذا بلغَ الوليدُ لديكَ عَشراً،","https://www.poetsgate.com/ViewPoem.aspx?id=18367",""],[109,"قفا نتشاكا ما تشاكاه وامق","https://www.aldiwan.net/poem16390.html","الطويل"],[150,"لعزك ذلت الأمم","https://www.aldiwan.net/poem68499.html","مجزوء الوافر"],[157,"قلمي","https://www.aldiwan.net/poem23654.html","الهزج"],[181,"أمنك أميم الدار غيرها البلى","https://www.aldiwan.net/poem58861.html","الطويل"],[185,"أرى الشر طبع نفوس الأنام","https://www.aldiwan.net/poem14667.html","المتقارب"],[204,"تذلل لمن تهوى تكن واجد العز","https://www.aldiwan.net/poem53275.html","الطويل"],[221,"غريرة زانها الحياء","https://www.aldiwan.net/poem55302.html","مخلع البسيط"],[237,"يا أخا اللب يا بديع القيل","https://www.aldiwan.net/poem18869.html","الخفيف"],[353,"ذوو اللب عاشرهم وقدم أسنهم","https://www.aldiwan.net/poem40184.html","الطويل"],[364,"رأينا عجيبا والزمان عجيب","https://www.aldiwan.net/poem61001.html","الطويل"],[366,"غرتك أبدان وأردان","https://www.aldiwan.net/poem17126.html","الرجز"],[366,"كلفت بتعنيفي بلا طلب عذري","https://www.aldiwan.net/poem17192.html","الطويل"],[377,"فإن خضع العقل الوضي لحواسنا","https://www.aldiwan.net/poem59295.html","الطويل"],[377,"رأيت الله حل بكل قلب","https://www.aldiwan.net/poem59367.html","الوافر"],[377,"أيدري الدهر أيم الله أني","https://www.aldiwan.net/poem59430.html","الكامل"],[377,"عج بالحمى يا راكب الوجناء","https://www.aldiwan.net/poem66977.html","الكامل"],[409,"إذا ضاق بالخطي معترك الوغى","https://www.aldiwan.net/poem32163.html","الطويل"],[439,"ما أحسن الصبر فيما يحسن الجزع","https://www.aldiwan.net/poem34837.html","البسيط"],[439,"دعي عزمات المستضام تسير","https://www.aldiwan.net/poem34841.html","الطويل"],[458,"ظن غداة الخيف أن قد سلِما","https://www.aldiwan.net/poem55900.html","الرجز"],[458,"يزور عن حسناء زورة خائف","https://www.aldiwan.net/poem56115.html","الطويل"],[458,"شفى الله نفسا لا تذل لمطلب","https://www.aldiwan.net/poem56303.html","الطويل"],[468,"قم نصطبح تحت رفرف السحر","https://www.aldiwan.net/poem60135.html","المنسرح"],[505,"الجرّافة","https://www.aldiwan.net/poem56764.html","الوافر"],[551,"دع الجزع عن يمناك لا عن شمالكا","https://www.aldiwan.net/poem47348.html","الطويل"],[551,"أبالبارق النجدي طرفك مولع","https://www.aldiwan.net/poem47725.html","الطويل"],[558,"ليس طيب الحياة غير وفاتك","https://www.aldiwan.net/poem34275.html","الخفيف"],[567,"له شغل عن سؤال الطلل","https://www.aldiwan.net/poem69529.html","المتقارب"]],"verses":[["فَإِنَّ خِلالَ أَبي عامِرٍ","بِها يَحضُرُ الوَردُ وَالنَرجِسُ",0,"س",1,0],["فإن خطرت في الرائعات من الحلى","تمنت حلاها الروض والأغصن الملد",1,"د",1,0],["فإن خَشِيتَ هجائي فاخْشَ حينئذٍ","من كلِّ شيء مُحَالِ الكَوْنِ مفقودِ",2,"د",1,0],["فإن خشيت اللّه في قتله","وخفت منه سطوة مرَّه",3,"ر",2,0],["فَإِن خَلَت هاجَتِ الذِكرى لَواعِجَها","فَاِستَنفَدَت طَرفَها الدَمعَ الَّذي اِذَّخَرا",4,"ر",2,0],["فَاِنخَرَطَت مِثلَ الحُسامِ الوالِجِ","وَاِندَفَعَت تِلكَ كَسَهمٍ زالِجِ",5,"ج",1,0],["فَإِنَّ خَواتيمَ أَعمالِ مَن","تَراهُ جَوامِعُ أَديانِها",6,"ن",3,0],["فَإِن خَفَّفتَ بِالإِحسانِ نَهضي","فَقَدأَثقَلتَ بِالإِنعامِ ظَهري",7,"ي",1,0],["فإن خَشوا غَرَقاً عُنْوانُهُ بَلَلٌ","هلّا خشوا راجمات حَشْوُها ديمُ",8,"م",1,0],["فَإِن خَدا يَرتَجِلُ المَشيَ فَال","مَوكِبُ في إِحسانِهِ وَالخَميس",9,"س",1,0],["فَإِنَّ خَيرَ هُداها ال","أَسماءُ لِلأَرواحِ",10,"ح",1,0],["فَإِن خُبزُ إِسماعيلَ حَلَّ بِهِ الَّذي","أَصابَ كُلَيباً لَم يَكُن ذاكَ مِن ذُلِّ",11,"ل",1,0],["فإنّ خلفكَ شيئاً","بهِ ذنوبُكَ تُغفر",12,"ر",1,0],["فَإِن خالَفتَني وَأَضَعتَ نُصحي","فَأَنتَ وَإِن رُزِقتَ حِجاً بَليدُ",13,"د",1,0],["فَإِن خَرَجتَ إِلى الدُنيا لَقيتَ أَذىً","مِنَ الحَوادِثِ بَلحَ القَيظَ وَالجَمَدا",14,"د",2,0],["فَإِنَّ خُمولَكَ دِرعٌ عَلَيكَ","وُقيتَ بِها عائِباً أَو حَسودا",15,"د",2,0],["فَإِن خَبَت في طَوالِ الدَهرِ حُمرَتُها","فَلا مَحالَةَ مِن أَن يُنقَضَ الفَلَكُ",16,"ك",1,0],["فَإِن خَرَجتِ إِلى بُؤسي فَوا حَرَجي","وَإِن نُقِلتِ إِلى نُعمى فَطوبى لي",17,"ي",1,0],["فَإِن خَفَّت لِجوعِ البَطنِ رِجلي","فَدَقَّ اللَهُ رِجلي بِالمُعاصِ",18,"ص",1,0],["فَإِنَّ خالِقَنا لِلحُبِّ مُبتَدِعاً","لَم يُفرِدِ الروحَ لمّا أَفرَدَ الجَسَدا",19,"د",2,0],["فَإنّ خَوَاتيمَ أعْمَالِ مَا","تَرَاهُ جَوَامِعُ أدْيَانِهَا",20,"ن",3,0],["فإنّ خمولَكَ دِراْعٌ عليكَ،","وُقيتَ بها عائِباً أو حَسودا",21,"د",2,0],["فإنْ خرجتَ إلى الدّنيا لقِيتَ أذىً","من الحوادث، بَلْهَ القيظَ والجَمَدا",22,"د",2,0],["فإنْ خالفْتَني وأضعتَ نُصحي،","فأنتَ، وإن رُزِقتَ حِجًى، بليد",23,"د",1,0],["فَإِن خَطرت زَهواً فَغصن مَنعم","وَإِن عَبقت رَيا فَثم حَدائِقُ",24,"ق",1,0],["فإنَّ خليفة الرحم","ن بالرحمن معتصم",25,"م",1,0],["فَإِنْ خِبْتُ فَمِنْ نَفْسِي","وَشَيْطَانِي لَهُ الحَرْبُ",26,"ب",1,0],["فإِن خِفتِ أَلاّ تُحكِمِى مِرَّةَ الهَوَى","فَرُدِّى فُؤَادِى وَالمَزَارُ قَرِيبُ",27,"ب",1,0],["فإنْ خلُصت عند سَبْكِ العقولِ","فسهمٌ أصابَ به غيرُ رام",28,"م",1,0],["فإن خِفتَ من عين الرَّقيب فَعُذ به","وسَلِّم إليه بالإشارة والغَمزِ",29,"ز",1,0],["فإن خلا الجو والتقينا","نغض أبصارنا حياء",30,"ا",2,0],["فَانْخِرَامُ الْمُعَاقَبَاتِ بِهَذَا ال","بَحْرِ فَاشٍ فِي شِعْرِ هَذَا الْجِيلِ",31,"ل",1,0],["فَإِن خفتَ إنس الحاسدين وَجنَّهم","عَلَيك بِإِخوان الصَفاءِ فَإِنَّهُم",32,"م",1,0],["فإن خُلِقوا في الخيرِ صَخْراً فإنّهم","إلى الشرِّ سَيلٌ إن أهابَ مُهيب",33,"ب",1,0],["فَإِن خَلا مِن ذاكَ بُستانُهُ","فَلا تَقُل شِعري بُستانُ",34,"ن",1,0],["فَإِن خَفَّفت قَيدي فَقَد أَثقَلَت ظَهري","وَإِن رَوَّحَت سِرّي فَقَد أَتعَبَت فِكري",35,"ر",2,0],["فإن خضعَ العقلُ الوضي لحواسنا","فيأكلُ معْها من طعام الصعالكِ",36,"ك",1,1],["فإن خالطتَه يُغويك سرّاً","وإن قاطعته يُبقيك خاش",37,"ش",1,0],["فإنْ خيراً يسود به فخيراً","وإن شرّاً يسود به فشرا",38,"ر",2,0],["فأَنِخ بهاتيكَ الرُبوعِ ولا تقُل","أَرَجُ النسيم سَرى من الزَوراءِ",39,"ا",2,0],["فإن خَفَضَ الفُرسانُ للطّعنِ في الوغى","رِماحَهُمُ انقضَّتْ عليها القَشاعِمُ",40,"م",1,0],["فإِن خَلَتْ للأَسى فِي شجوها سُنَنٌ","فطالَما أُحْمِدَتْ فِي كَظْمِها البِدَعُ",41,"ع",1,0],["فإِنَّ خطيراتِ المهالِكِ ضُمَّنٌ","لراكِبِها أَنَّ الجزاءَ خطيرُ",42,"ر",1,0],["فإنِ خبت شمسُ نهارٍ منهمُ","غطُّوا الدجى أهلّةً وأنجما",43,"م",2,0],["فإن خفتما شوقي فقد تأمنانِهِ","بخاتلةٍ بين القنا والمخاوفِ",44,"ف",1,0],["فإن خَبُثَتْ أيديهُمُ ليِ وأَسْهَكَتْ","فرُبَّ نوالٍ طاهرٍ لك طيِّبِ",45,"ب",1,0],["فَإِنَّ خَزَّ الغَمامَ يَنثُرُ في","ديباجَةِ الرَوضِ زَئبَرَ المَطَرِ",46,"ر",1,0],["فإنْ خَشِيتْ جيوبهُمُ فإنّ","البطونَ لتفضحُ السرَّ الّدفينا",47,"ن",2,0],["فإنْ خبروا بالفضل منك رقابةً","فقد شاهدوا ما شاهدوا من جلالكا",48,"ك",2,0],["فإنَّ خِطاراً أنْ تهيجوا مفوَّهاً","له كَلِمٌ تفرِي البلادَ وتقطعُ",49,"ع",1,0],["فانخلع عنك في الوجود إليها","سائحاً منك في فضا فلواتك",50,"ك",1,0],["فَإِنْ خَرَجَ المُصْطَفَى حَافِيَاً","تَمِيْلُ بِهِ سَكَرَاتُ العِلَلْ",51,"ل",1,0]]}