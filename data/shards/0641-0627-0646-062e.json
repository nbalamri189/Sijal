ewPoem.aspx?id=186042",""],[1901,"عدتْك كرائمُ الديَمُ الغوادي","https://www.poetsgate.com/ViewPoem.aspx?id=160388",""],[4955,"أفضلُ أن أقلِّلَ من كلامي","https://www.poetsgate.com/ViewPoem.aspx?id=187802",""],[5193,"على هامش أحداث .. كرونا","https://www.poetsgate.com/ViewPoem.aspx?id=213403",""],[2365,"قفا صاحبيّ نحىّ الطلل","https://www.poetsgate.com/ViewPoem.aspx?id=200654",""],[5237,"ما حال من فارق ذاك الجمال","https://www.poetsgate.com/ViewPoem.aspx?id=113108",""],[5293,"من يوميات فنان","https://www.poetsgate.com/ViewPoem.aspx?id=186129",""],[5351,"إليها","https://www.poetsgate.com/ViewPoem.aspx?id=202129",""],[5410,"آهات","https://www.poetsgate.com/ViewPoem.aspx?id=144495",""],[5582,"إِلَى التِّيهِ مالَتْ لَها أَنْ تَمِيلا","https://www.poetsgate.com/ViewPoem.aspx?id=187262",""],[5616,"عهد","https://www.poetsgate.com/ViewPoem.aspx?id=207587",""],[5626,"هيا ارجعي","https://www.poetsgate.com/ViewPoem.aspx?id=189691",""],[5720,"سنرحلُ","https://www.poetsgate.com/ViewPoem.aspx?id=210360",""],[5751,"الصقر مرة اخرى","https://www.poetsgate.com/ViewPoem.aspx?id=214980",""],[5809,"استجابة","https://www.poetsgate.com/ViewPoem.aspx?id=205311",""],[5943,"كليني ياهموم فلن أبالي","https://www.poetsgate.com/ViewPoem.aspx?id=34857",""],[5950,"مريم ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128336",""],[6031,"نُسَلِّمُ من بُعدِ الدِّيَارِ عَليكُمُ","https://www.poetsgate.com/ViewPoem.aspx?id=46391",""],[6079,"مأساة العذريين","https://www.poetsgate.com/ViewPoem.aspx?id=207045",""],[6082,"المصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=58835",""],[6082,"عام جديد","https://www.poetsgate.com/ViewPoem.aspx?id=60780",""],[6167,"لا رجعية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85486&r=&rc=15",""],[463,"يزوِّرُ عنْ حسناءَ زورة َ خائفٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60142&r=&rc=198",""],[6277,"نَوَرٌ نسميهم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=64476&r=&rc=39",""]],"verses":[["فَإِنَّ خِلالَ أَبي عامِرٍ","بِها يَحضُرُ الوَردُ وَالنَرجِسُ",0,"س",1,0],["فإن خطرت في الرائعات من الحلى","تمنت حلاها الروض والأغصن الملد",1,"د",1,0],["فإن خَشِيتَ هجائي فاخْشَ حينئذٍ","من كلِّ شيء مُحَالِ الكَوْنِ مفقودِ",2,"د",1,0],["فإن خشيت اللّه في قتله","وخفت منه سطوة مرَّه",3,"ر",2,0],["فَإِن خَلَت هاجَتِ الذِكرى لَواعِجَها","فَاِستَنفَدَت طَرفَها الدَمعَ الَّذي اِذَّخَرا",4,"ر",2,0],["فَاِنخَرَطَت مِثلَ الحُسامِ الوالِجِ","وَاِندَفَعَت تِلكَ كَسَهمٍ زالِجِ",5,"ج",1,0],["فَإِنَّ خَواتيمَ أَعمالِ مَن","تَراهُ جَوامِعُ أَديانِها",6,"ن",3,0],["فَإِن خَفَّفتَ بِالإِحسانِ نَهضي","فَقَدأَثقَلتَ بِالإِنعامِ ظَهري",7,"ر",2,0],["فإن خَشوا غَرَقاً عُنْوانُهُ بَلَلٌ","هلّا خشوا راجمات حَشْوُها ديمُ",8,"م",1,0],["فَإِن خَدا يَرتَجِلُ المَشيَ فَال","مَوكِبُ في إِحسانِهِ وَالخَميس",9,"س",1,0],["فَإِنَّ خَيرَ هُداها ال","أَسماءُ لِلأَرواحِ",10,"ح",1,0],["فَإِن خُبزُ إِسماعيلَ حَلَّ بِهِ الَّذي","أَصابَ كُلَيباً لَم يَكُن ذاكَ مِن ذُلِّ",11,"ل",1,0],["فإنّ خلفكَ شيئاً","بهِ ذنوبُكَ تُغفر",12,"ر",1,0],["فَإِن خالَفتَني وَأَضَعتَ نُصحي","فَأَنتَ وَإِن رُزِقتَ حِجاً بَليدُ",13,"د",1,0],["فَإِن خَرَجتَ إِلى الدُنيا لَقيتَ أَذىً","مِنَ الحَوادِثِ بَلحَ القَيظَ وَالجَمَدا",14,"د",2,0],["فَإِنَّ خُمولَكَ دِرعٌ عَلَيكَ","وُقيتَ بِها عائِباً أَو حَسودا",15,"د",2,0],["فَإِن خَبَت في طَوالِ الدَهرِ حُمرَتُها","فَلا مَحالَةَ مِن أَن يُنقَضَ الفَلَكُ",16,"ك",1,0],["فَإِن خَرَجتِ إِلى بُؤسي فَوا حَرَجي","وَإِن نُقِلتِ إِلى نُعمى فَطوبى لي",17,"ل",2,0],["فَإِن خَفَّت لِجوعِ البَطنِ رِجلي","فَدَقَّ اللَهُ رِجلي بِالمُعاصِ",18,"ص",1,0],["فَإِنَّ خالِقَنا لِلحُبِّ مُبتَدِعاً","لَم يُفرِدِ الروحَ لمّا أَفرَدَ الجَسَدا",19,"د",2,0],["فان خام عنه وارتضى الضيم ملبا","وسالم فالأيمان ليس بسالم",20,"م",1,0],["فَإنّ خَوَاتيمَ أعْمَالِ مَا","تَرَاهُ جَوَامِعُ أدْيَانِهَا",21,"ن",3,0],["فإنّ خمولَكَ دِراْعٌ عليكَ،","وُقيتَ بها عائِباً أو حَسودا",22,"د",2,0],["فإنْ خرجتَ إلى الدّنيا لقِيتَ أذىً","من الحوادث، بَلْهَ القيظَ والجَمَدا",23,"د",2,0],["فإنْ خالفْتَني وأضعتَ نُصحي،","فأنتَ، وإن رُزِقتَ حِجًى، بليد",24,"د",1,0],["فَإِن خَطرت زَهواً فَغصن مَنعم","وَإِن عَبقت رَيا فَثم حَدائِقُ",25,"ق",1,0],["فإنَّ خليفة الرحم","ن بالرحمن معتصم",26,"م",1,0],["فَإِنْ خِبْتُ فَمِنْ نَفْسِي","وَشَيْطَانِي لَهُ الحَرْبُ",27,"ب",1,0],["فإِن خِفتِ أَلاّ تُحكِمِى مِرَّةَ الهَوَى","فَرُدِّى فُؤَادِى وَالمَزَارُ قَرِيبُ",28,"ب",1,0],["فإنْ خلُصت عند سَبْكِ العقولِ","فسهمٌ أصابَ به غيرُ رام",29,"م",1,0],["فإن خِفتَ من عين الرَّقيب فَعُذ به","وسَلِّم إليه بالإشارة والغَمزِ",30,"ز",1,0],["فإن خلا الجو والتقينا","نغض أبصارنا حياء",31,"ا",2,0],["فَانْخِرَامُ الْمُعَاقَبَاتِ بِهَذَا ال","بَحْرِ فَاشٍ فِي شِعْرِ هَذَا الْجِيلِ",32,"ل",1,0],["فَإِن خفتَ إنس الحاسدين وَجنَّهم","عَلَيك بِإِخوان الصَفاءِ فَإِنَّهُم",33,"م",1,0],["فإن خُلِقوا في الخيرِ صَخْراً فإنّهم","إلى الشرِّ سَيلٌ إن أهابَ مُهيب",34,"ب",1,0],["فَإِن خَلا مِن ذاكَ بُستانُهُ","فَلا تَقُل شِعري بُستانُ",35,"ن",1,0],["فَإِن خَفَّفت قَيدي فَقَد أَثقَلَت ظَهري","وَإِن رَوَّحَت سِرّي فَقَد أَتعَبَت فِكري",36,"ر",2,0],["فإن خضعَ العقلُ الوضي لحواسنا","فيأكلُ معْها من طعام الصعالكِ",37,"ك",1,1],["فإن خالطتَه يُغويك سرّاً","وإن قاطعته يُبقيك خاش",38,"ش",1,0],["فإنْ خيراً يسود به فخيراً","وإن شرّاً يسود به فشرا",39,"ر",2,0],["فأَنِخ بهاتيكَ الرُبوعِ ولا تقُل","أَرَجُ النسيم سَرى من الزَوراءِ",40,"ا",2,0],["فإن خَفَضَ الفُرسانُ للطّعنِ في الوغى","رِماحَهُمُ انقضَّتْ عليها القَشاعِمُ",41,"م",1,0],["فإِن خَلَتْ للأَسى فِي شجوها سُنَنٌ","فطالَما أُحْمِدَتْ فِي كَظْمِها البِدَعُ",42,"ع",1,0],["فإِنَّ خطيراتِ المهالِكِ ضُمَّنٌ","لراكِبِها أَنَّ الجزاءَ خطيرُ",43,"ر",1,0],["فإنِ خبت شمسُ نهارٍ منهمُ","غطُّوا الدجى أهلّةً وأنجما",44,"م",2,0],["فإن خفتما شوقي فقد تأمنانِهِ","بخاتلةٍ بين القنا والمخاوفِ",45,"ف",1,0],["فإن خَبُثَتْ أيديهُمُ ليِ وأَسْهَكَتْ","فرُبَّ نوالٍ طاهرٍ لك طيِّبِ",46,"ب",1,0],["فَإِنَّ خَزَّ الغَمامَ يَنثُرُ في","ديباجَةِ الرَوضِ زَئبَرَ المَطَرِ",47,"ر",1,0],["فإنْ خَشِيتْ جيوبهُمُ فإنّ","البطونَ لتفضحُ السرَّ الّدفينا",48,"ن",2,0],["فإنْ خبروا بالفضل منك رقابةً","فقد شاهدوا ما شاهدوا من جلالكا",49,"ك",2,0],["فإنَّ خِطاراً أنْ تهيجوا مفوَّهاً","له كَلِمٌ تفرِي البلادَ وتقطعُ",50,"ع",1,0],["فانخلع عنك في الوجود إليها","سائحاً منك في فضا فلواتك",51,"ك",1,0],["فَإِنْ خَرَجَ المُصْطَفَى حَافِيَاً","تَمِيْلُ بِهِ سَكَرَاتُ العِلَلْ",52,"ل",1,0],["فَإِن خِفتُما بُعدَ البِلادِ فَهَيِّجا","مُمَلِّعَةً أَو ذا هِبابٍ مُمَلِّعا",53,"ع",2,0],["فأنختها بفنائك الرحب الذي","وسع الورى بالنائل الدفاق",54,"ق",1,0],["فَإِن خان العُهود فَلا تلمه","فَما هُوَ مِن رِجال الافتخار",55,"ر",1,0],["فإن خفَّ خطوُ الوَهْمِ عن حَدِّ طَورِه","فَثَمَّ سِهامُ اللَّحظِ عن كَثبٍ تُرْدي",56,"د",2,0],["فإنْ خَجلَت أوْ عَراها حَياءٌ","فمِنْ أجْلِ تَقصيرِها عَنْ مَزِيدِ",57,"د",1,0],["فانخَدع الغراب مِن كَلامه","وَجاءَ للخَصم عَلى مرامه",58,"ه",1,0],["فإن خلعت عذاري لستُ مُبتدعاً","فلتعذروني فهذا جل منهاجي",59,"ج",2,0],["فإن ختام الأمر عنك مغيب","ومن ليس ذا خسر يخاف من المكر",60,"ر",1,0],["فأنخ مطيك في فنا ذاك القنا","واقصد بني القصاب وقت الهاجرة",61,"ه",1,0],["فإِنْ خُنْتُ أَو أَضْمَرْتُ يوماً جِنايةً","فلا صَحِبَتني نحو أَرِضِكم رِجْلي",62,"ل",2,0],["فإِنَّ خيرَ الملوكِ أَعرفُها","بأَنَّ بهرامَ شاهَ أَفضلُها",63,"ل",3,0],["فَإِن خَطَبُوا ألفَيتَ سَحبَان بَاقِلاً","وِإن شَعرُوا لاَكُوا قَوافِيَ كَالتِّبرِ",64,"ر",1,0],["فَاِنخدع الفاتك بالمحال","وَقالَ هَل تصدق في المَقال",65,"ل",1,0],["فإن خامرتهُ لوعة فكأنها","وإِن يكُ صبر عنده فعجيبُ",66,"ب",1,0],["فإن خفت أمراً وحاذرت فقْراً","وحاولْت يُسراً فبختانَ سَلْ",67,"ل",1,0],["فإن خرجت فقد أبررت حين له","قصدت سيراً ولو أتاه لم يصل",68,"ل",1,0],["فإن خرج الإمام فما بنزوى","تصلى جمعةً بالناسِ قصرا",69,"ر",2,0],["فإن خواص خواص الختم ليسوا","لغير مداده يالوا العلايا",70,"ا",3,0],["فَإِن خافَ بِالإِقدامِ إيقاظَ فِتنَةٍ","تُغِصُّ بريقٍ أَو تَجيءُ بِمُؤلِمِ",71,"م",1,0],["فإن خلا من شكر علياه فمي","فما خلت من جود كفيه يدي",72,"د",2,0],["فأنخ بأشجع من علا مُتَمَطِّراً","نَهْداً وأرفع من علاه لواء",73,"ا",2,0],["فَأَنِخ بِها لا يَرهَبَنَّكَ أُسُدُها","الإِشتِياقُ يُريكَها أَشبالا",74,"ل",2,0],["فإن خصه الرحمن منه بصورةٍ","إلهية في الكون قيل هي المثل",75,"ل",1,0],["فإن خليلي من يقاسمني الأسَى","ويشركني في نائب الحَدثان",76,"ن",1,0],["فَإِن خانَ نَجوايَ عِيُّ اللسان","فَأَلسنُ هَذي الجَواري فِصاح",77,"ح",1,0],["فَإن خَلَفتَ الشِّعبَ أُدخُل بَندَرَك","بَندَرَ زَيلَع قَد هَنِيتَ سَفَرك",78,"ك",1,0],["فَإن خَلَصتَ آخضَرَّ المَاء","فَالرَّأيُ في البرِّ بِلاَ مِرَاء",79,"ا",2,0],["فَإِن خديوي مَصر أَول ماجد","يُشار إِلَيهِ في العُلا بِبنان",80,"ن",1,0],["فإن خذلتنا وهي في حال عزها","وضعف أعاديها وحال انتشارها",81,"ر",3,0],["فأنخ بذي سلم وقم","واقرأ تحيات السلام",82,"م",1,0],["فأن خيرك للدنيا بأجمعها","لكل ذي حاجة تجريه مدرارا",83,"ر",2,0],["فان خطوب الدهر أذكت بصيرتي","وإن خطوب الدهر أوحت ليَ الشعرا",84,"ر",2,0],["فإن خذَلتني الحادثاتُ فما أنا","بأوّل جمّاع لدهرٍ يبدّدُ",85,"د",1,0],["فإن خفاءَ الفضلِ يَظْهر بالثَّنا","وَلَمْ يَخْفَ ضوءُ الصبحِ والصبحُ عاطِس",86,"س",1,0],["فأَنخْتها قُلُصاً حَنايا طُلَّحاً","مثلَ القِسِي سودَ الحَدائق وُرْقا",87,"ق",2,0],["فإنْ خانتْكَ أبكارُ القَوافي","فبردكَ لا يخونُكَ والعِطافُ",88,"ف",1,0],["فإنّ خسارَ الجهلِ والعَقْلُ رابِحٌ","يحققُ عندي أنّكنّ صَوانِعُ",89,"ع",1,0],["فَإِن خَطَبتك مَرتَبةٌ لِتَرقى","إلَيها قالَت الأُخرى إِلَيّا",90,"ي",2,0],["فإن خالفت يوما فكم من دويبة","على عرض حطت لشهم مفوّق",91,"ق",1,0],["فإن خير العشق يا صاح ما","في جنبه قد هتك السترُ",92,"ر",1,0],["فأَنخ عَلى تلك الرُسوم وَحيّها","وَاندب صَفاه وَنُح عَلى سكانه",93,"ن",2,0],["فإن خير العشره","ما حاز قوماً عشره",94,"ه",1,0],["فانخدع الغراب في","رقيق مدح أسكره",95,"ر",2,0],["فإن خطرت في جانبٍ منك هفوةٌ","فلا تحسبن أنّي أضيق بها صدرا",96,"ر",2,0],["فإن خلتها بنت الظليم أظلّها","فقد فرش الإذخرّ من تحتها تبرا",96,"ر",2,0],["فأن خطرت بالقلب ذكراك خطرةً","ظلِلتُ بلا لُبٍّ إليكَ أهيمُ",97,"م",1,0],["فانخرطت بينهم في السحب","تحثهم من طي تلك الحجب",98,"ب",1,0],["فان خيالي ليس يبرحُ ماثلاً","لعينيكِ يحييه الوفا والتذكرُ",99,"ر",1,0],["فإنّ خصال المدح فيكم عزيزة","ولم يُحصِ عُشر العُشر منهن ناظمُ",100,"م",1,0],["فإن خرجوا يوماً عليك فطالما","على عظماء المجد تجني الأسافل",101,"ل",1,0],["فإن خلَفتُهُ السنُ فالعقلُ بالغٌ","به رتبة الشيخ الموفق للرشيد",102,"د",1,0],["فإن خيراً يجازيه بخيرٍ","وإن شراً