{"poems":[[73,"أدرها فقد حسن المجلس","https://www.aldiwan.net/poem11924.html","المتقارب"],[93,"وفاء كهذا العهد فليكن العهد","https://www.aldiwan.net/poem9845.html","الطويل"],[51,"يا ابن الوزيرين سمعا من أخي طلب","https://www.aldiwan.net/poem10000.html","البسيط"],[51,"إن أنت صادفت أخا لحية","https://www.aldiwan.net/poem62961.html","الطويل"],[91,"من الفرنسيس قيد العين صورتها","https://www.aldiwan.net/poem8873.html","عموديه"],[85,"وهذه واقعة مستغربه","https://www.aldiwan.net/poem8047.html","الرجز"],[45,"تعاط الصبابة أو عانها","https://www.aldiwan.net/poem66802.html","المتقارب"],[66,"ملكت ببعض برك رق شكري","https://www.aldiwan.net/poem38795.html","الوافر"],[80,"يمضي لك السيف ما تنويه والقلم","https://www.aldiwan.net/poem31288.html","البسيط"],[44,"جرت له أسماء حبل الشموس","https://www.aldiwan.net/poem30479.html","السريع"],[52,"عودوا إلى الإصباح","https://www.aldiwan.net/poem27153.html","المجتث"],[48,"على خبز إسماعيل واقية البخل","https://www.aldiwan.net/poem65041.html","الطويل"],[48,"قولوا لمن قد تنفر","https://www.aldiwan.net/poem66288.html","المجتث"],[46,"إذا بلغ الوليد لديك عشرا","https://www.aldiwan.net/poem22408.html","الوافر"],[46,"نادى حشا الأم بالطفل الذي اشتملت","https://www.aldiwan.net/poem22432.html","البسيط"],[46,"لقد غادر العيش هذا السواد","https://www.aldiwan.net/poem22441.html","المتقارب"],[46,"يجوز أن تطفأ الشمس التي وقدت","https://www.aldiwan.net/poem23070.html","البسيط"],[46,"يا نفس جسمك سربال له خطر","https://www.aldiwan.net/poem23226.html","البسيط"],[15,"أرقت لضوء برق في نشاص","https://www.aldiwan.net/poem45263.html","الوافر"],[55,"","https://poetry.dctabudhabi.ae/diwan/poem/12640","البسيط"],[45,"تَعَاطَ الصّبَابَةَ، أوْ عَانِها","https://www.poetsgate.com/ViewPoem.aspx?id=31823",""],[46,"لقد غادرَ العيشُ هذا السّوادَ،","https://www.poetsgate.com/ViewPoem.aspx?id=18544",""],[46,"نادى حَشا الأمّ بالطفل الذي اشتملت","https://www.poetsgate.com/ViewPoem.aspx?id=18535",""],[46,"إذا بلغَ الوليدُ لديكَ عَشراً،","https://www.poetsgate.com/ViewPoem.aspx?id=18367",""]],"verses":[["فَإِنَّ خِلالَ أَبي عامِرٍ","بِها يَحضُرُ الوَردُ وَالنَرجِسُ",0,"س",1,0],["فإن خطرت في الرائعات من الحلى","تمنت حلاها الروض والأغصن الملد",1,"د",1,0],["فإن خَشِيتَ هجائي فاخْشَ حينئذٍ","من كلِّ شيء مُحَالِ الكَوْنِ مفقودِ",2,"د",1,0],["فإن خشيت اللّه في قتله","وخفت منه سطوة مرَّه",3,"ر",2,0],["فَإِن خَلَت هاجَتِ الذِكرى لَواعِجَها","فَاِستَنفَدَت طَرفَها الدَمعَ الَّذي اِذَّخَرا",4,"ر",2,0],["فَاِنخَرَطَت مِثلَ الحُسامِ الوالِجِ","وَاِندَفَعَت تِلكَ كَسَهمٍ زالِجِ",5,"ج",1,0],["فَإِنَّ خَواتيمَ أَعمالِ مَن","تَراهُ جَوامِعُ أَديانِها",6,"ن",3,0],["فَإِن خَفَّفتَ بِالإِحسانِ نَهضي","فَقَدأَثقَلتَ بِالإِنعامِ ظَهري",7,"ي",1,0],["فإن خَشوا غَرَقاً عُنْوانُهُ بَلَلٌ","هلّا خشوا راجمات حَشْوُها ديمُ",8,"م",1,0],["فَإِن خَدا يَرتَجِلُ المَشيَ فَال","مَوكِبُ في إِحسانِهِ وَالخَميس",9,"س",1,0],["فَإِنَّ خَيرَ هُداها ال","أَسماءُ لِلأَرواحِ",10,"ح",1,0],["فَإِن خُبزُ إِسماعيلَ حَلَّ بِهِ الَّذي","أَصابَ كُلَيباً لَم يَكُن ذاكَ مِن ذُلِّ",11,"ل",1,0],["فإنّ خلفكَ شيئاً","بهِ ذنوبُكَ تُغفر",12,"ر",1,0],["فَإِن خالَفتَني وَأَضَعتَ نُصحي","فَأَنتَ وَإِن رُزِقتَ حِجاً بَليدُ",13,"د",1,0],["فَإِن خَرَجتَ إِلى الدُنيا لَقيتَ أَذىً","مِنَ الحَوادِثِ بَلحَ القَيظَ وَالجَمَدا",14,"د",2,0],["فَإِنَّ خُمولَكَ دِرعٌ عَلَيكَ","وُقيتَ بِها عائِباً أَو حَسودا",15,"د",2,0],["فَإِن خَبَت في طَوالِ الدَهرِ حُمرَتُها","فَلا مَحالَةَ مِن أَن يُنقَضَ الفَلَكُ",16,"ك",1,0],["فَإِن خَرَجتِ إِلى بُؤسي فَوا حَرَجي","وَإِن نُقِلتِ إِلى نُعمى فَطوبى لي",17,"ي",1,0],["فَإِن خَفَّت لِجوعِ البَطنِ رِجلي","فَدَقَّ اللَهُ رِجلي بِالمُعاصِ",18,"ص",1,0],["فَإِنَّ خالِقَنا لِلحُبِّ مُبتَدِعاً","لَم يُفرِدِ الروحَ لمّا أَفرَدَ الجَسَدا",19,"د",2,0],["فَإنّ خَوَاتيمَ أعْمَالِ مَا","تَرَاهُ جَوَامِعُ أدْيَانِهَا",20,"ن",3,0],["فإنّ خمولَكَ دِراْعٌ عليكَ،","وُقيتَ بها عائِباً أو حَسودا",21,"د",2,0],["فإنْ خرجتَ إلى الدّنيا لقِيتَ أذىً","من الحوادث، بَلْهَ القيظَ والجَمَدا",22,"د",2,0],["فإنْ خالفْتَني وأضعتَ نُصحي،","فأنتَ، وإن رُزِقتَ حِجًى، بليد",23,"د",1,0]]}