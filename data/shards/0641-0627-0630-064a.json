{"poems":[[53,"يمن الله طلعة المهرجان","https://www.aldiwan.net/poem66446.html","الخفيف"],[2606,"","https://poetry.dctabudhabi.ae/diwan/poem/198979","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110092","البسيط"],[5219,"الطاهرة المطهرة","https://www.poetsgate.com/ViewPoem.aspx?id=194998",""]],"verses":[["فأُذيلت فيها تهاويلُ رَقْمٍ","قائماتٌ بزينةِ المُزْدان",0,"ن",1,0],["فأذيق من كأس المحبة صرفها","سبحان ساقيه بها ومذيقه",1,"ق",2,0],["فإِذ يرى اللَه ما يُبدِي بذِلَّتِهِ","يُوليهِ رُشداً وتوفيقاً مَدَى الزَمَنِ",2,"ن",1,0],["فآذى رسول الله بطل كلامهم","وصارت حديثا في لسان الأسافلِ",3,"ل",1,0]]}