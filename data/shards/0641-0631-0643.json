ewPoem.aspx?id=206692",""],[4623,"أعلى الزمان أخذت عهد أمان (المدائح )","https://www.poetsgate.com/ViewPoem.aspx?id=146772",""],[5823,"التحدي","https://www.poetsgate.com/ViewPoem.aspx?id=62110",""],[5858,"شاطئ العشق","https://www.poetsgate.com/ViewPoem.aspx?id=188119",""],[5879,"الوجد لي","https://www.poetsgate.com/ViewPoem.aspx?id=215458",""],[5943,"صلاة الشكر","https://www.poetsgate.com/ViewPoem.aspx?id=62007",""],[6093,"خطََّ البكاءُ على الخدودِ مسيلا","https://www.poetsgate.com/ViewPoem.aspx?id=176266",""],[463,"هوَّنَ باللَّيلِ عليها الغررا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60075&r=&rc=131",""],[6344,"جنوح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87977&r=&rc=17",""]],"verses":[["فَرُكنِ مِهراسٍ إِلى مارِدِ","فَقاعِ مَنفوحَةَ ذي الحائِرِ",0,"ر",1,0],["فركبتها طيارة","والنار تلهب في ركابك",1,"ك",1,0],["فَرَكَبتَها هَولاً مَتى تُخبِر بِها","يَقُلِ الجَبانُ أَتَيتَ غَيرَ صَوابِ",2,"ب",1,0],["فركبنا الوهمَ نبغي دارَها","وطوينا الدهر والعالَم طَيَّا",3,"ي",2,0],["فركبْتُ أخطارَ الهوى في وصلها","والطيبُ واشٍ والحليُّ رقيبُ",4,"ب",1,0],["فَرَكِبناهُ بِلا سَر","جٍ رُكوباً مَروَزِيّا",5,"ي",2,0],["فركضُ السكر في يوم عبوس","بأعناقِ الرؤوسِ إلى الرؤوس",6,"س",1,0],["فركابُه ما تَنثنى بأزِمَّةٍ","وجيادُه ما ترعوىِ بِعنانِ",7,"ن",1,0],["فركبتم الخطر الذي","لستم عليه بقادرين",8,"ن",1,0],["فَركن كُلَّ الناسِ تيهاً وَلَم","يَهوَينَ إِلّا الملك الأَمجَدا",9,"د",2,0],["فركت ثوبي من بعد صقلٍ","لأن لي في النسيم بابا",10,"ب",2,0],["فرِكَتْني الدُّنْيا فطلَّقْتُها عَمْ","داً وما للفَروكِ غَيرُ الطَّلاقِ",11,"ق",1,0],["فركِبْتُ فوق مَطَا أَقبَّ مُضَمَّرٍ","في مُهْرَقِ البَيْداءِ مِثْلَ النُّونِ",12,"ن",1,0],["فركبتَ قادمةَ الفرارِ وضاقتِ ال","غبراءُ في عينيك والخضراءُ",13,"ا",2,0],["فركعتان بجوف الليل جالبة","لك الرضى وسعيد الحظ والظفرا",14,"ر",2,0],["فركب تقدم من قبلنا","ونحن على إثرهم في اللحاق",15,"ق",1,0],["فركنُ دولتكم بالأمس أوّلُهُ","وأنت يا ركنَ دينِ اللّه رابعُهُ",16,"ع",2,0],["فركِّبَتْ بسُوقِها رؤوسُها","حتى تخيَّلنا الحجولَ الغُرَرا",17,"ر",2,0],["فركضتُ طرف اللهو غير مفكّرٍ","وسرحت في روض السرور ركائبي",18,"ب",2,0],["فَرَكَّعُوه ُعلى أعتابِ بَلدَتِهِم","وَرَكَّعُوا مَعَهُ كلَّ الصَّهايين ِ!",19,"ن",1,0],["فَرُكوبِها مُتَعَذِّرٌ إِن لَم تَكُن","مِمَّن لَهُ لُجُمٌ مِنَ الآلاءِ",20,"ا",2,0],["فركضُ الجياد وَقسر الأعادي","وغوث المنادي ونحر اللِقاح",21,"ح",1,0],["فركبتُ هاديةَ الدجى متلثماً","بعزيم أروع للدجى ركّاب",22,"ب",1,0],["فَرَكِبتَ رَدعَكَ بَينَ ثَنيي فائِرٍ","يَعلو بِهِ أَثَرُ الدِماءِ وَشائِلِ",23,"ل",1,0],["فركبوها بعد تشعير فقي","عند انتهائهم لوضع المردف",24,"ف",1,0],["فركبتم غمارَ برٍ خضَمٍّ","هائجاتٌ أمواجُهُ الظَّلماء",25,"ا",2,0],["فرُكونُكَ للتقوى غضَبٌ","ورُكونكَ أدهى للأمَمِ",26,"م",1,0],["فركبن حسرى لاقناع ولا ردى","سوى الصون يحمى والأشعة تحجب",27,"ب",1,0],["فركائب العبرات في","ك بسائر الزفرات تُحْدَى",28,"د",2,0],["فركبنا سفن الفلاة وسرنا","وتركنا للغير زيدا وعمرا",29,"ر",2,0],["فَرُكود الأَحلام فيهن طَيش","وَعُروق الحَياة فيها رُكود",30,"د",1,0],["فركبت ظهر الحزم في همم بها","لك دان ما يرجى وما يتوقع",31,"ع",1,0],["فركبنا خيل التصابي جيادا","وأذرعنا الثبات بيضا وسمرا",32,"ر",2,0],["فرَكضاً في مَيادينِ التَّصابي","أحَقُّ الخيل بالركض المُعارُ",33,"ر",1,0],["فركبت في حُبّي له","بحر الغرام وخُضتهُ",34,"ت",2,0],["فركبت صعباً والسماحةُ عُدَّني","إني عَلَى التقصير لستُ أُلام",35,"م",1,0],["فركّبنهُ إن ترد أن تعلمه","واقلب نتيجةً به مقامه",36,"ه",1,0],["فركّبَ أغضانَ المنيّة فيهمُ","رِواءَ الأعالي ظامئاتِ الأسافِلِ",37,"ل",1,0],["فركب الحسام فوق العيرِ","ويوسف البغلة نحو الدير",38,"ر",1,0],["فركنُ غيرك لا يقوى لمرتكن","لكن ركنك ركن غير منهدم",39,"م",1,0],["فَرُكبَتَيهِ متَى يأتي أُقَبِّلُ في","قَصرِ النُّحَاسِ عسى يُصغي وَيَكفِيني",40,"ن",2,0],["فَرَكِبناها عَلى مَجهولِها","بِصِلابِ الأَرضِ فيهِنَّ شَجَع",41,"ع",1,0],["فركن الهدى بعدهم لم يُشَد","وعرف الندى بعدهم لن يضوعا",42,"ع",2,0],["فركبنا كلَّ يومٍ مركباً","وذهبنا كلَّ يومٍ مذهبا",43,"ب",2,0],["فركضت في ميدانه وكرعت من","غدرانه وركعت في محرابه",44,"ب",2,0],["فَرَكْبُ العزِّ للرّحمنِ يسعى","ورَكْبُ الذلِّ يسعى للإشادةْ",45,"د",2,0],["( فركضتِ نحوي لهفةً مشدوهةً )","وهتفت ِباسمى جيئة ًوذهابا",46,"ب",2,0],["فركبت رأسك تستفزك نزوة","خبطت بك الظلمات غير معان",47,"ن",1,0],["فَرَكْبُ الْإِفْكِ آخِرُهُ ضَلَاْلٌ","وَرَكْبُ الصَّدْقِ أَوْلَىْ أَنْ يَبِيْنَاْ",48,"ن",2,0],["فَرْكبُ اللفْظِ يَسرِي فِي دِمَانَا","بِرغْم الجُرْح ِيشْدُوه الْجَمَالُ",49,"ل",1,0],["فركبتُ منْ سفُنِ الصباحِ أخفَّها","في البحرِ تجري كالسهامِ تصرَّمَا",50,"م",2,0],["فركَبتَ موجَ البحرِ حينَ تعاظَمت","ظُلماتُه وأطالَ فيكَ دُوارا",51,"ر",2,0],["فركبت الهوا إليك كسهمٍ","أطلقته من قوسها الأسفار",52,"ر",1,0],["فركنت للدنيا بقلب ساكن","حتى كأنك واثق بزمان",53,"ن",1,0],["فركْنُ البيتِ موعودٌ بنَسْفٍ","إذا لَمْ يُحْمَ مِنْ شهْمٍ وورْدِ",54,"د",1,0],["فركبت قاربي الصغير مغادرا","ذاك المكان فأمسكت بي غرّاء",55,"ا",1,0],["فركبتُ ريحك في المهب مبايعا","كي لا أُضيّع في الهبوب شَمالها",56,"ل",3,0],["فركضتُ تستهدي بنورِك خطوتي","في الليلِ دربًا بالتنائي مظلما",57,"م",2,0],["فركبْتُ في أثرِ الحبيبِ كطائرٍ","أرجو إلي منْ قدْ هويتُ وصولا",58,"ل",2,0],["فركَّبتْ بسوقها رءوسها","حتى تخيلنا الحجولَ الغررا",59,"ر",2,0],["فَرَكِبْتَ طُوفَانَ الهَوانِ .. حَسِبْتَهُ","لَمَّا طَغَى مِنْ تَحْتِ رِجْلِكَ رِيحَا",60,"ح",2,0]]}