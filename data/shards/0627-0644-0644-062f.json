{"poems":[[287,"عسى الدهر أن ينتاشني ولعله","https://www.aldiwan.net/poem32650.html","الطويل"],[1379,"","https://poetry.dctabudhabi.ae/diwan/poem/20003","الطويل"],[2001,"","https://poetry.dctabudhabi.ae/diwan/poem/111183","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200184",""],[3099,"","https://poetry.dctabudhabi.ae/diwan/poem/11256","الوافر"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59466","الطويل"]],"verses":[["أَلِلدَهرِ ثَأرٌ فَهوَ يَطلُبُ ثَأرَهُ","لَدَيَّ فَمالي لا أُفارِقُ ذَحلَهُ",0,"ل",2,0],["أَلِلدَّهرِ تَبكي أَم عَلى الدَهرِ تَجزَعُ","وَما صاحِبُ الأَيّامِ إِلّا مُفَجَّعُ",1,"ع",1,1],["أللدار ابكي ان تحمل أهلها","ام السيد السجاد أم لكي مسلما",2,"م",2,1],["اللّدغ طبعٌ قد خلقت له","أفتطمعين برحمة الراحم",3,"م",1,0],["أَلِلدُنيا أُعِدُّكَ يا بنَ عَمّي","فَأَعلَم أَم أُعِدُّكَ لِلحِسابِ",4,"ب",1,1],["أللِدَّارِ من أكنافِ قَوٍ فَعَرعرِ","فجبتُ النَّقا بطن الصّفا فالمشَّقرِ",5,"ر",1,1]]}