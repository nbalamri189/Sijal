{"poems":[[88,"أجاد مطران كعاداته","https://www.aldiwan.net/poem10857.html","السريع"],[88,"لمصر أم لربوع الشام تنتسب","https://www.aldiwan.net/poem10918.html","البسيط"],[53,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8298.html","البسيط"],[93,"ما لقلبي يلج من الخفقان","https://www.aldiwan.net/poem62761.html","عموديه"],[93,"يا جنة قبلما حلت بها قدمي","https://www.aldiwan.net/poem62814.html","عموديه"],[87,"لمن المساكن كالمقابر","https://www.aldiwan.net/poem7768.html","مجزوء الكامل"],[87,"رضي المسلمون والإسلام","https://www.aldiwan.net/poem63740.html","الخفيف"],[87,"قم ناد أنقرة وقل يهنيك","https://www.aldiwan.net/poem63757.html","الكامل"],[45,"قد علم البين منا البين أجفانا","https://www.aldiwan.net/poem10588.html","البسيط"],[51,"رحلت عن الربع المحيل قعودي","https://www.aldiwan.net/poem64158.html","الطويل"],[68,"عين حبي أعيذها بالله","https://www.aldiwan.net/poem39639.html","الخفيف"],[33,"هل أنت إن بكر الأحبة غادي","https://www.aldiwan.net/poem42584.html","الكامل"],[41,"بان الخليط بسحرة فتبددوا","https://www.aldiwan.net/poem53799.html","الكامل"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39598","المتقارب"],[53,"ما أنس لا أنس هنداً آخر الحقبِ","https://www.poetsgate.com/ViewPoem.aspx?id=26853",""],[119,"يا ربنا يا ارحم الراحمين","https://www.aldiwan.net/poem40450.html","عموديه"],[119,"يا مغيثي وعدتي ورجائي","https://www.aldiwan.net/poem41475.html","عموديه"],[125,"بالواسعات أرى الأشواق تنهمر","https://www.aldiwan.net/poem23811.html","البسيط"],[287,"هل أنت بقصتي عليم","https://www.aldiwan.net/poem32476.html","مجزوء الدوبيت"],[396,"يا تاركين الصلاة","https://www.aldiwan.net/poem54601.html","عموديه"],[422,"أبا جميل قر عينا بمن","https://www.aldiwan.net/poem53939.html","السريع"],[463,"خفف بذات البان من أثقالها","https://www.aldiwan.net/poem55951.html","الرجز"],[466,"نيطت حمائل سيفه","https://www.aldiwan.net/poem16105.html","مجزوء الكامل"],[466,"ممدح غمر الرداء والشيم","https://www.aldiwan.net/poem16220.html","الرجز"],[469,"وبأبي من قده معتدل","https://www.aldiwan.net/poem3171.html","عموديه"],[484,"ظلموك يا جدي ولست ظلوما","https://www.aldiwan.net/poem37194.html","الكامل"],[509,"ما لي إلى وصل الحبيب سبيل","https://www.aldiwan.net/poem38410.html","الكامل"],[543,"قدك يا جميل","https://www.aldiwan.net/poem47914.html","عموديه"],[564,"لأخلعن عذارى في محبتكم","https://www.aldiwan.net/poem69347.html","البسيط"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138291",""],[605,"","https://poetry.dctabudhabi.ae/diwan/poem/216404",""],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38896","الكامل"],[856,"","https://poetry.dctabudhabi.ae/diwan/poem/198755","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120074","الكامل"],[1172,"","https://poetry.dctabudhabi.ae/diwan/poem/111288","الكامل"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130620","الرمل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/49064","الطويل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77840","الرجز"],[1696,"","https://poetry.dctabudhabi.ae/diwan/poem/102056","البسيط"],[1965,"","https://poetry.dctabudhabi.ae/diwan/poem/102725","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27702","البسيط"],[2251,"","https://poetry.dctabudhabi.ae/diwan/poem/82123","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93528","السريع"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137210",""],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87325","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94016","الكامل"],[2835,"","https://poetry.dctabudhabi.ae/diwan/poem/198815","الوافر"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118965","الكامل"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132596","الرجز"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86343","الرجز"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108386",""],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101240","الرمل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45862","الكامل"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110082","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/206144",""],[435,"","https://poetry.dctabudhabi.ae/diwan/poem/107975","البسيط"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135773","الرجز"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135734","الرجز"],[3871,"","https://poetry.dctabudhabi.ae/diwan/poem/145928","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111507","الكامل"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77174","البسيط"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36663","الدوبيت"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36613","الدوبيت"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36376","الدوبيت"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90859","الكامل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81729","البسيط"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136707",""],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120300","الكامل"],[4690,"عمّي الفَلاّح / أدب الطفل","https://www.poetsgate.com/ViewPoem.aspx?id=120388",""],[4699,"لقاء في الخيال","https://www.poetsgate.com/ViewPoem.aspx?id=153960",""],[4767,"لا فض فوك","https://www.poetsgate.com/ViewPoem.aspx?id=180856",""],[4797,"في غيبتك","https://www.poetsgate.com/ViewPoem.aspx?id=71830",""],[4852,"كأس شاي","https://www.poetsgate.com/ViewPoem.aspx?id=214267",""],[4869,"ياصغيّر السن يامروّق","https://www.poetsgate.com/ViewPoem.aspx?id=151555",""],[4984,"يا خالق الأكوان","https://www.poetsgate.com/ViewPoem.aspx?id=190543",""],[5002,"اليتيمة...","https://www.poetsgate.com/ViewPoem.aspx?id=209143",""],[5121,"بِالْوَرْدِ","https://www.poetsgate.com/ViewPoem.aspx?id=213627",""],[5138,"يانصيب الغير واحلام السنين","https://www.poetsgate.com/ViewPoem.aspx?id=184848",""],[5183,"الفقيد الكريم","https://www.poetsgate.com/ViewPoem.aspx?id=180252",""],[5273,"كبرياء عاشقة","https://www.poetsgate.com/ViewPoem.aspx?id=28546",""],[5376,"بدرٌ يضيءُ وشفةٌ لمياءُ","https://www.poetsgate.com/ViewPoem.aspx?id=192684",""],[5431,"قصيدة تفكيكية (2)","https://www.poetsgate.com/ViewPoem.aspx?id=215499",""],[5652,"دُرتي","https://www.poetsgate.com/ViewPoem.aspx?id=192118",""],[5732,"حل الفرقا","https://www.poetsgate.com/ViewPoem.aspx?id=177903",""],[5739,"راسبه والاّ ناجحه ..!","https://www.poetsgate.com/ViewPoem.aspx?id=126872",""],[5784,"هدية لشاعر واهم غيبه النسيان ..... !؟","https://www.poetsgate.com/ViewPoem.aspx?id=190687",""],[5956,"حيوية الدنيا بوجه أسفر","https://www.poetsgate.com/ViewPoem.aspx?id=182286",""],[5975,"الرسم الخالد","https://www.poetsgate.com/ViewPoem.aspx?id=52992",""],[6004,"جَنَّةٌ للنِّسَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=59595",""],[6102,"يا أنا","https://www.poetsgate.com/ViewPoem.aspx?id=185331",""],[1387,"أصبحت لا أملك للنفس وطر","https://diwany.org/%D8%A3%D8%B5%D8%A8%D8%AD%D8%AA-%D9%84%D8%A7-%D8%A3%D9%85%D9%84%D9%83-%D9%84%D9%84%D9%86%D9%81%D8%B3-%D9%88%D8%B7%D8%B1/","الرجز"]],"verses":[["بِالواجِبِ الأَقدَسِ في حَقِّ مَن","باعَتهُ مِصرٌ بَيعَةَ الوَكسِ",0,"س",1,0],["بِالوادِيَينِ تَمَشّى الفَخرُ مِشيَتَهُ","يَحُفُّ ناحِيَتَيهِ الجودُ وَالدَأَبُ",1,"ب",1,0],["بآل وهبٍ غدتْ دنيا زمانهمُ","منصورةً وتغنَّت بعدَ منتحبِ",2,"ب",1,0],["بِالوُجوهِ الزَهراءِ بِالأَنفُ","سِ السَمحاءِ مِن يَعرُبٍ وَمِن غَسّانِ",3,"ن",1,0],["بِالوَهمِتوجَدُ دُنيا لا وُجودَ لَها","وَتَنطَوي عَنكَ دُنيا أَنتَ رائيها",4,"ي",3,0],["بالوحش في صور الأنا","م عشائرا حازت عشائر",5,"ر",1,0],["بِالوَلاءِ الَّذي تُريدُ الأَيادي","وَالوَلاءِ الَّذي يُريدُ المُقامُ",6,"م",1,0],["بِالواجِبِ اِلتَمَسَ الحُقوقَ وَخابَ مَن","طَلَبَ الحُقوقَ بِواجِبٍ مَتروكِ",7,"ك",1,0],["بِالواخِداتِ وَحاديها وَبي قَمَرٌ","يَظَلُّ مِن وَخدِها في الخِدرِ حَشيانا",8,"ن",2,0],["بِأَلوِيَةٍ جِبريلُ يَقدُمُ أَهلَها","وَراياتِ نَصرٍ حَولَهُ وَبُنودِ",9,"د",1,0],["بِالوَصلِ نَجّاني","مِن ذي الهُموم",10,"م",1,0],["بِالوَجدِ أَغدَرُ ما يَكونُ وَبِالبُكا","وَبِرِحلَةٍ مِن طِيَّةٍ وَبِلادِ",11,"د",1,0],["بالوا مَخافَتَهاعَلى نيرانِهِم","وَاِستَسلَموا بَعدَ الخَطيرِ وَأَخمَدوا",12,"د",3,0],["بألُوفِ البَطْحاءِ يُجْفِلُهَا النِّي","لُ وقد شَفَّ جَوْفَهَا الإِظْماءُ",13,"ا",2,0],["بألوانِها الحمر جَمْرُ الغضا","وفي نفحِها لفَحَاتُ العذابْ",14,"ب",1,0],["بآل وهبٍ غدتْ دنيا زمانهمُ","منضورة ً وتغنَّت بعدَ منتحبِ",15,"ب",1,0],["بالوالهين الكاملين الاولى","بالراخسين الطور والعاشقين",16,"ن",1,0],["بالولي السجاد سيدنا الص","ياد والعارفين والاولياء",17,"ا",2,0],["بالواسعات أرى الأشواقَ تنهمرُ","من واسعاتِ صدور الشوق تنفجرُ",18,"ر",1,1],["بِالوَجدِ عَدِمتُ حُسنَ صَبري","وَالعاشِقُ واجِدٌ عَديمُ",19,"م",1,0],["بالوعد للقائمين","لها بنيل الهبات",20,"ت",1,0],["بالولد الماجد من ماجد","لا يَلِدُ الماجدُ إلاَّ مجيد",21,"د",1,0],["بالواحد المبعوث في زمانها","والباتر المبعوث لانتشالها",22,"ل",3,0],["بالواضِحِ البَسَّام للْعا","فِينَ والكَفِّ النَّفوعِ",23,"ع",1,0],["بالوابل الغَيْداق من صوب النِّعمْ","لا بلَلٌ من جَوْنِه ولا رَذَمْ",24,"م",1,0],["بالوجد لي شغلٌ عن العذل كما","لابن عليٍ بالمعالي شغل",25,"ل",1,0],["بالوقت أمره موكل واليوم قد","وفاك حقك فارأ المنظوما",26,"م",2,0],["بالوعد قد باع الوفا غبن الحشا","لوفايه لا ينفع التعجيل",27,"ل",1,0],["بِالوَصلِ أحيِ مَن لا","يَنالُ منكَ وَصلا",28,"ل",2,0],["بالوْهم يثبتُن والتّحقِيق يُعدمُهُ","أنَّى لضعف الفرَاش الصّبرُ للشعل",29,"ل",1,0],["بالوافدين الدار قد ضاقت فلم","نَر حولنا الا جموعا شكرا",30,"ر",2,0],["بالوصف لِبّ غْشاية الليف","أو شِبْه لون الصبح لي بَر",31,"ر",1,0],["بِالوَصلِ جُدْ فَأَنا المُحبُّ المُخلِصُ","ما إِن لَهُ مِن أَسر حبّك مخلصُ",32,"ص",1,1],["بالوفاق الذي دعوت إِليه","بالتآخي ووحدة الأديان",33,"ن",1,0],["بالوافر استنفدت معظم وفره","لما قربت إليه والمتقاربِ",34,"ب",1,0],["بالوصل جاد محمد","لمحمد من بعد صد",35,"د",1,0],["بالورود النضر","روض انس كم ليال بالغضا",36,"ض",2,0],["بالولدِ الرابع يا خالقي","أَنعمتَ من إبحار أَفضالكا",37,"ك",2,0],["بالوشي من نسج المنى تخايل","قدامها الشاؤوش وَالمنادي",38,"ي",1,0],["بالوحي شرف والمعراج ثم رأى","مولاه بالعين جل اللَه لم ينم",39,"م",1,0],["بآلٍ وأجدادِ النبي وصحبه","وأتباعهِم والأولياءِ فألحقنا",40,"ن",2,0],["بالوهم كان لنا مما قلت كان له","فيه لناظره أمر وتحكيم",41,"م",1,0],["بِالوَصلِ راضِيَةٍ عَهدي مُواتِيَةٍ","عَنّي مُحامِيَةٍ تَجفو وَتَنساني",42,"ن",2,0],["بِالواحد الفَرد استعن وَابتهج","فيهِ وَأرّخ غرفاً طَيبه",43,"ب",2,0],["بالوزير القاضي حبيب ابي شهلا","سيفوق البلاد لبنان فضلا",44,"ل",2,1],["بالوَاحِدِ المَعبُودِ يا خليلي","إذا رَكبتَ الغَلقَ فَآدعو لي",45,"ي",1,0],["بالوصل يحيي من يمي","ت بهجره من حيث مله",46,"ل",2,0],["بألوان الطبيعة جئتَ حتى","تفتّقَتِ الرمال بها زُهورا",47,"ر",2,0],["بالوصل منك مريض هجر يشتفى","مما ألم به ومثلك من شفى",48,"ف",2,1],["بالوحي والسنة قد هديتنا","يا هادياً في سور وفي سير",49,"ر",1,0],["بِالوَعدِ يَوماً لا يَفي","لكِن يَفي ما اِوعدا",50,"ا",1,0],["بالوقع اذوى زهر لحظ يانعاً","بالحسن بل بل احنى قواماً اهيفا",51,"ف",2,0],["بالوجوه المستنيرات التي","كان يثني مشيها الردف الثقيل",52,"ل",1,0],["بِالوَعد لي في كُل يَوم رُتبة","أَسمو بِها في دَولة الأَحلام",53,"م",1,0],["بأَلُوكةٍ لم يأتِ منكَ جوابُها","فكأَنَّني راجٍ نَوالَ لئيمِ",54,"م",1,0],["بالوكْف لا نرضى فوا عجبي","كيف ارتضينا أمسِ بالبلل",55,"ل",1,0],["بالوردتين حبتني ظبيةٌ سفكت","سيوف أجفانها يا صاحبي دمي",56,"م",2,1],["بالواسعِ البرِّ وصادقٍ ونورْ","كلَّ المهمِّ ارزقه لي مدى الدّهورْ",57,"ر",1,0],["بالوارث الرشيد واسم الحقِّ","بك ارزقنِّي حبّك المْرَقّي",58,"ي",1,0],["بالواحد الماجد والمجيدِ","ينفذ حبي بلا ترديدِ",58,"د",1,0],["بالواديين كلاهما الغربي وال","شرقي نزهة من برفق يرمق",59,"ق",1,0],["بالويل صاح وهاله الخبر","يخشى فجاج الأرض تنفجر",60,"ر",1,0],["بِالوُدِّ وَالخُلق الصافي مُعاتَبَة","فَاِستَوضَح الوَد ثُمَّ اِعتَب بِلا أَشَر",61,"ر",1,1],["بالوَرد مَتى تتَوَّجُ الأَغصانُ","قالَ اِتعظوا كَشأنكم لي شانُ",62,"ن",1,1],["بِالوَردِ لِغُرَّة الدمى تَحجيلُ","لِلغُصنِ مُتَوَّجاً بِهِ تَجميلُ",63,"ل",1,1],["بِالوَصلِ وَعدتَني فَطابَ الوَعدُ","عَجِّل فَعَنِ اِنتظاره لا أَعدو",64,"و",1,1],["بالوزن مني والروي اقنع فقد","أهديت لؤلؤة إلى بحر الندا",65,"د",2,0],["بالواثقِ الملك المحيي خليقته","يحيي أبي زكرياءَ ابنِ مولانا",66,"ن",2,0],["بالوصل قد أحييتَ أموات الهوى","لما 