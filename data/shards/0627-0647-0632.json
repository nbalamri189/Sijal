{"poems":[[55,"أهز عاسية العيدان آبية","https://www.aldiwan.net/poem29936.html","البسيط"],[29,"ألا رب يوم قد أتيح لك الصبا","https://www.aldiwan.net/poem5996.html","الطويل"],[74,"يا رب طرف يفوق الطرف من سبق","https://www.aldiwan.net/poem18776.html","البسيط"],[53,"ألا يا زينة الدنيا جميعا","https://www.aldiwan.net/poem66039.html","الوافر"],[64,"لقد هاجني والصبح طلق المباسم","https://www.aldiwan.net/poem52267.html","الطويل"],[47,"وواعظ منه لولا أنه حجر","https://www.aldiwan.net/poem63596.html","البسيط"],[63,"يروع هجرها قلبا مروعا","https://www.aldiwan.net/poem51573.html","الوافر"],[76,"أهزك لا إني إخالك نابيا","https://www.aldiwan.net/poem13276.html","الطويل"],[107,"إلى ذات السلاسل من بلي","https://www.aldiwan.net/poem43574.html","الوافر"],[13,"إني لمهد من ثناء فقاصد","https://www.aldiwan.net/poem2214.html","الطويل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85310","المجتث"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43754","الطويل"],[108,"في ربا الخلد","https://www.poetsgate.com/ViewPoem.aspx?id=179685",""],[92,"إلى الرّصافي","https://www.poetsgate.com/ViewPoem.aspx?id=179197",""],[202,"أهزز معاطف رائح ومبكر","https://www.aldiwan.net/poem51948.html","الطويل"],[240,"سقاها الحيا من أربع وطلول","https://www.aldiwan.net/poem31789.html","الطويل"],[275,"أهزتك الحمية في الحميا","https://www.aldiwan.net/poem35287.html","الوافر"],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[438,"أهز عطفيك بالأشعار أنظمها","https://www.aldiwan.net/poem12611.html","البسيط"],[463,"أشوقا ومن تهوى خلي الجوانح","https://www.aldiwan.net/poem56258.html","الطويل"],[556,"ألا حبذا زمن الحاجر","https://www.aldiwan.net/poem47796.html","المتقارب"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48664","الوافر"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122312","المنسرح"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/17145","الوافر"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202069","الرجز"],[1084,"","https://poetry.dctabudhabi.ae/diwan/poem/119102","الطويل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/65031","المتقارب"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/144121","الكامل"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132800","الطويل"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79820","الرمل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49589","الطويل"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49565","الطويل"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76626","الطويل"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/121016","الطويل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106859","المنسرح"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60865","السريع"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102559","الكامل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75945","الوافر"],[3362,"","https://poetry.dctabudhabi.ae/diwan/poem/31663","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62887","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205687","الهزج"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205677","الرمل"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35108","البسيط"],[4908,"حبلى سنيني (شعر / ماجد العبادي) وضيم المحبة (تعقيب/جهاد العبادي)","https://www.poetsgate.com/ViewPoem.aspx?id=209094",""],[4913,"لا سر اخفيه","https://www.poetsgate.com/ViewPoem.aspx?id=202954",""],[4942,"إني ٱنطلقت","https://www.poetsgate.com/ViewPoem.aspx?id=188393",""],[585,"تحية تملأ الدنيا وتمجيد","https://www.poetsgate.com/ViewPoem.aspx?id=161886",""],[5409,"أهزةٌ أيقظت من روعها البلدا","https://www.poetsgate.com/ViewPoem.aspx?id=155458",""],[5854,"أهزّك الوجد لما بانت الرُسُم ((بالتوحيد نتحد))","https://www.poetsgate.com/ViewPoem.aspx?id=192157",""],[5943,"الضمير الميت","https://www.poetsgate.com/ViewPoem.aspx?id=61824",""],[5997,"الغَرَّاْءُ","https://www.poetsgate.com/ViewPoem.aspx?id=214276",""],[6078,"نيليّة الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=202774",""]],"verses":[["أَهُزُّ عاسِيَةَ العيدانِ آبِيَةً","عَلى الخَوابِطِ لا ليناً وَلا وَرَقا",0,"ق",2,1],["أَهِزّانُ لَولا اِبنا لُجَيمٍ كِلاهُما","لَكُنتُم سَواءً قِسمَةً بَينَ أَسهُمي",1,"م",2,0],["أهز في البيد مثل الغصن هادية","فألقط الوحش عن وجه الثرى أثره",2,"ر",2,0],["أهِزَّةُ منطق كالسِّحْرِ لُطْفاً","عرتني أم سماعٍ أم مُدامِ",3,"م",1,0],["أهُزُّ أنابيبَ الردينيّ سافحاً","على جمرةِ الهيجاءِ ماءَ الصوارمِ",4,"م",1,0],["أَهُزُّ بِالشِعرِ أَقواماً ذَوي وَسَنٍ","في الجَهلِ لَو ضُرِبوا بِالسَيفِ ما شَعَروا",5,"ر",3,0],["أَهُزُّ بها على قَوْمٍ سُيوفاً","وأجعلُها على قَوْمٍ دُروعا",6,"ع",2,0],["أَهُزُّكَ لا إِنّي إِخالُكَ نابِيا","وَإِن كُنتَ مَطرورَ الغِرارِ يَمانِيا",7,"ي",2,1],["أهزلٌ من قُضاعةَ أم خيالٌ","غَوِيٌّ جَالَ في جَوٍّ غَوِيِّ",8,"ي",1,0],["أَهُزُّ بِهِ في نَدوَةِ الحَيِّ عِطفَهُ","كَما هَزَّ عِطفي بِالهِجانِ الأَوارِكِ",9,"ك",1,0],["أهز مهدك هزا","حَتّى تَنامي فَنامي",10,"ي",1,0],["أَهَزُّ حُسام يُنتَضى وَسِنان","وَمَوتُ شُجاعٍ مِثل مَوتِ جَبانِ",11,"ن",1,1],["اهزلي؛ فالحياةُ، يا نفسُ، هزلٌ","إنَّ من جدَّ عاش غيرَ سعيد",12,"د",1,0],["أهزُّ بكَ الجيلَ الذي لا تهزُّه","نوابغُه ، حتى تزورَ المقابرا",13,"ر",2,0],["أُهْزُزْ معاطفَ رائحٍ ومُبَكِّرِ","ما بينَ سارٍ في الدُّجى ومهجِّرِ",14,"ر",1,1],["أَهُزُّ اِختِيالاً في ذُراهُ مَعاطِفي","وَأَسحَبُ تيهاً في ذَراهُ ذُيولي",15,"ل",2,0],["أَهَزَّتكَ الحَميَّةُ في الحُمَيَّا","فبتَّ ترى كؤوسَكَ في الثُّرَيَّا",16,"ي",2,1],["اهزئي بالشقاء مادامت الكأ","س وما دام حبنا فينانا",17,"ن",2,0],["أهزُّ عِطفيك بالأشعارِ أنظُمُها","هزّ الرياحِ لغصنِ البانةِ النّضِرِ",18,"ر",1,1],["أهزُّ بعتبي منه طودأً كأنني","أريد لأكسو العَيْرَ جلدةَ سابحِ",19,"ح",1,0],["أهزّك بالشّعر هزَّ الشّجا","عِ يومَ الوغى ظُبَتَيْ باترِ",20,"ر",1,0],["أهز به العوالي والمواضي","كما تهتز أعطاف الأسود",21,"د",1,0],["اهز جذع المنى وما يبدي","الا نواه وشوكه رطب",22,"ب",1,0],["أهزُّكُمُ بأشعاري وأَنتُم","جَمادٌ لا تهزُّكُمُ السِياطُ",23,"ط",1,1],["أهُزُوٌ أقْسَامه بهذا","أو لَعِبٌ ماذا الجواب ماذا",24,"ذ",2,0],["أهزك إني عرفتك ناسياً","لوعد ولا أني أردف تقاضيا",25,"ي",2,1],["أَهُزُّ بهاتيكَ عِطْفَ القَريضِ","لِيُثْنى على هذهِ الثانِيَهْ",26,"ي",2,0],["إهزِلْ فقد هزَلَ الزّما","نُ وجدّ في حرب الأديب",27,"ب",1,0],["أَهَزَّ الصَّبا قُضبَانَهَا كاهتزازه","إذا لَمَست كفَّيه كَفَّك طالبا",28,"ب",2,0],["أهزلَ الأعمارَ منهم قولُهم","كلَّما جدَّ الوغى زيدي هُزالا",29,"ل",2,0],["أَهُزُّ بها عِطْفَيْكَ في كلِّ مَشْهَدٍ","كما اهتزَّ في يُمْنَاكَ أسْمَرُ ذابل",30,"ل",1,0],["أهزُّ لها عطفيّ منْ غيرِ نشوةٍ","على ما بجسمي من كلال ومن فَتْر",31,"ر",1,0],["أهزك لا أني عهدتك ناسياً","ولا أنني أبغي لديك التغاضيا",32,"ي",2,1],["أهزلاً وقد جَدَّت بك اللَّمّةُ الشمطا","وأمناً وقد ساورتِ يا حيةٌ رَقطا",33,"ط",2,1],["أهزأُ بالناس أنهم خُلقوا","شُعثَ النواصي للأكل والشرب",34,"ب",1,0],["أهزلني هزلُ النَّوى وجدها","وَاتعبني من هَزْلها والجَدَ",35,"د",1,0],["اهزم جيوش البغي وافلل حدّها","ليطيب بعدهم الربى والموضع",36,"ع",1,0],["أَهزَّكَ وَالكَريمُ لَهُ اهتِزازُ","وَمثلُكَ مَن يُجيزُ وَلا يُجازُ",37,"ز",1,1],["أَهَزُّ عِطْفَيْ قَضيبِ البانِ مُعْتَنِقاً","مِنْهُ وأَلْثُمُ عَيْنَيْ لُعْبَةِ العاجِ",38,"ج",1,0],["أَهُزكَ للجُلَّى وأَنتَ تَخالني","بُروقُ لُجينٍ هِمَّتي ونُضَارُ",39,"ر",1,0],["أهزلًا تهمس الأنج","م أم تهمس عن جِدِّ",40,"د",1,0],["أهزيع منك يا ليل مضى","أمضى نصف أما ينشطران",41,"ن",1,0],["أَهزَّ مِن مَوجِهِ أَثناءَ مَسرورِ","أَم خاضَ مِن لُجِّهِ أَحشاءَ مَذعورِ",42,"ر",1,0],["أهز جذع الحب والجذع خاوي","على عروش الصيف تاهت خطاويه",43,"و",3,0],["أهزّ جِذْعَ فَراغِ الامسياتِ وَكمْ","تَساقَطَ الوقتُ حولي يابساً جَشِبا",44,"ب",2,0],["أهزهز الحب تسّاقط ازاهره","وأدفع البغض مثل الغيم أزجيه",45,"ي",2,0],["أهزهم عند ترجيع الغناء بهم","كما ترنم بالمزمار داود",46,"د",1,0],["أهزةٌ أيقظت من روعها البلدا","أم أنه الأجل المحتوم فيك حدا",47,"د",2,1],["أَهَزَّكَ الوَجْدُ لَمَّا بَانَتِ الرُّسُمُ..؟!","فَخَانَكَ الدَّمْعُ لَمَّا جِئْتَ تَبْتَسِمُ!؟",48,"م",1,1],["آهٍ زمانَ العزِّ كيفَ خذ لتَنا","وركبتَ عصرًا بالمخازي مبحرا",49,"ر",2,0],["أَهُزُّ بِجِذْعِ الْحُبِّ مِنْ نَخْلَةِ الْوَفَاْ","فَجَاْدَتْ مِنَ الْأَفْلَاْذِ خَمْسَاً قِطَاْفِيَا",50,"ف",3,0],["أهزوجةُ الشمسِ اكتمالُ صلاتهِ","ومناجلُ الضوءِ امتدادُ بهائهِ",51,"ا",3,0]]}