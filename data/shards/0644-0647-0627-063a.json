{"poems":[[4,"كبيشة حلت بعد عهدك عاقلا","https://www.aldiwan.net/poem21183.html","الطويل"],[53,"شاهدت في بعض ما شاهدت مسمعة","https://www.aldiwan.net/poem66016.html","البسيط"],[80,"يطول علي الدهر إن لم ألاقها","https://www.aldiwan.net/poem14248.html","الطويل"],[47,"أما لعيني طليح الشوق تغميض","https://www.aldiwan.net/poem64638.html","البسيط"],[102,"لعيني أم بلقيس","https://www.poetsgate.com/ViewPoem.aspx?id=50431",""],[146,"تزاورن عن أذرعات يمينا","https://www.aldiwan.net/poem58450.html","المتقارب"],[369,"نمت بأسرار ليل كان يخفيها","https://www.aldiwan.net/poem60595.html","البسيط"],[371,"كلانا جنى هذا الهوى واصطليته","https://www.aldiwan.net/poem17208.html","الطويل"],[463,"لمن طالعات في السراب أفول","https://www.aldiwan.net/poem55924.html","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[706,"","https://poetry.dctabudhabi.ae/diwan/poem/144836","الطويل"],[972,"","https://poetry.dctabudhabi.ae/diwan/poem/67838","الطويل"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/116003","الطويل"],[1669,"","https://poetry.dctabudhabi.ae/diwan/poem/202318","الطويل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118436","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27450","الوافر"],[3224,"","https://poetry.dctabudhabi.ae/diwan/poem/199773","المنسرح"],[3224,"","https://poetry.dctabudhabi.ae/diwan/poem/199777","السريع"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103980","الطويل"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85144","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72471","الطويل"],[5582,"أَتَعْلَمُ ذاتُ الغُنْجِ أَمْ لَيْسَ تَعْلَمُ","https://www.poetsgate.com/ViewPoem.aspx?id=187302",""],[5751,"إيقاعُ اُنثى","https://www.poetsgate.com/ViewPoem.aspx?id=214769",""]],"verses":[["لَها غَلَلٌ مِن رازِقِيٍّ وَكُرسُفٍ","بِأَيمانِ عُجمٍ يَنصُفونَ المَقاوِلا",0,"ل",2,0],["لها غناءٌ يثيبُ اللَّهُ سامعَهُ","ضِعفي ثوابِ صلاةِ الليل والصومِ",1,"م",1,0],["لَها غُرَّةٌ كالبَدرِ عِندَ تَمامِهِ","وَصَدغا عَبيرٍ نَمَّقا صَفحَةَ البَدرِ",2,"ر",1,0],["لَها غَرائِبُ دَلٍّ مايَزالُ لَها","عَلى الغَرامِ بِنا بَثٌّ وَتَحريضُ",3,"ض",1,0],["لها غزوي وإرهاقي","لها أزهى فتوحاتي",4,"ت",2,0],["لها غُرَوٌ إن رآها العد","وّ لم ير أكفالَها والمتُونا",5,"ن",2,0],["لها غَرائبُ تَبدو من مَحاسِنها","إذا تَفكّرْتُ يوماً في مَعانيها",6,"ي",3,0],["لَها غُرَرٌ يَستَضحِكُ النَصرُ وَجهَها","وَتَفهَمُ مِنها العَينُ مَعنى البَشائِرِ",7,"ر",1,0],["لها غِبطَةٌ يوماً ويوماً فجيعةٌ","كذلك دولاتُ الزمان تدولُ",8,"ل",1,0],["لها غيرة تغرى بها غير أهلها","فأغيارها ما بين غِر وغرة",9,"ه",1,0],["لها غُرَّةٌ يجلو الدجى نُورُ وجهها","وقدٌّ كغصنِ البانِ أهيفُ أملد",10,"د",1,0],["لَهَا غُرَرٌ فِي الْحَافِقَيْنِ بِوَازِغُ","لَقَدْ خَصَّهُ الْمَولَى وَأعْلىَ مَنَارَهُ",11,"ه",1,0],["لها غُرَّةٌ فى طُرَّةٍ كلّما بدَت","تعجَّبتُ من نُورٍ علاهُ ظلامُ",12,"م",1,0],["لها غلل في الصدر ليس ببارح","شجى نشب والعين بالماء تدمع",13,"ع",1,0],["لها غرفة في قيد شبر من الهوى","تغرد فيها كالنزيف وتعلبب",14,"ب",1,0],["لها غَور بعيد ليس يدري","لذا قال اللبيبُ هي الفليقه",15,"ق",2,0],["لها غناءٌ كالبرء في جسد","أضناه طول السّقام والتّرح",16,"ح",1,0],["لها غناء مطرب معجب","يفعل ما تفعله الخمره",17,"ر",2,1],["لَهَا غُرَّةٌ فِي صَفحَة الدَّهر وَسمُهَا","وَفِي عَاتِق الأيَّام سَيفٌ مُقَلَّدٌ",18,"د",1,0],["لها غزلي والمدح في خير سادة","بهم يعتلي بالذوق تمييز أحوالي",19,"ل",2,0],["لها غرر معلومة وحجول","ظبي وقنى قد مزقت كل فيلق",20,"ق",1,0],["لَها غُرَّةٌ كالبَدْرِ لَيْلَةَ تَمِّهِ","وَفَرْعٌ أَثِيثٌ نَبْتُهُ لَيْسَ يَقْتِمُ",21,"م",1,0],["له أغصانُ ضوءٍ مثملاتٌ","تردده الملاحمُ والعصورُ",22,"ر",1,0]]}