{"poems":[[65,"ونفحة من ربا ذي الأثل قابلني","https://www.aldiwan.net/poem45794.html","البسيط"],[95,"يا من يخاطبه ويمدحه","https://www.aldiwan.net/poem9831.html","مجزوء الكامل"],[95,"رب البيان وسيد القلم","https://www.aldiwan.net/poem11371.html","أحذ الكامل"],[87,"بين المقطم والمقطم نسبة","https://www.aldiwan.net/poem7268.html","الكامل"],[51,"سبحان جبار السماء","https://www.aldiwan.net/poem63210.html","مجزوء الكامل"],[71,"من قال بالمرد فاحذر إن تصاحبه","https://www.aldiwan.net/poem28769.html","البسيط"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85389","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[128,"لقد تبوهم حتى كاد بوهمة","https://www.aldiwan.net/poem23751.html","البسيط"],[154,"يا من له شيم تملكه","https://www.aldiwan.net/poem68473.html","مجزوء الكامل"],[164,"هنيته عيدا فصل وانحر","https://www.aldiwan.net/poem58821.html","الرجز"],[164,"لكن ذلك مجهودي أتيت به","https://www.aldiwan.net/poem59219.html","البسيط"],[325,"وسيع صدري انقضت في ضيقه حيلي","https://www.aldiwan.net/poem67221.html","البسيط"],[376,"ما يصبح العاذل معذورا","https://www.aldiwan.net/poem57393.html","السريع"],[376,"من يسأل الطرف المسهد","https://www.aldiwan.net/poem57505.html","مجزوء الكامل"],[415,"قالوا ترشفت الليالي ماءه","https://www.aldiwan.net/poem32170.html","الكامل"],[435,"ما لذة المرء بالكاسات والوتر","https://www.aldiwan.net/poem40743.html","البسيط"],[447,"لولا مخافة بيع قائد الغبن","https://www.aldiwan.net/poem14431.html","البسيط"],[519,"شط العرب إن طفح جوده ومده طما","https://www.aldiwan.net/poem20930.html","المواليا"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138364",""],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77611","الرجز"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[1067,"","https://poetry.dctabudhabi.ae/diwan/poem/138061","الرجز"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80244","الكامل"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126159","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56162","الكامل"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49923","الكامل"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105413","الكامل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93707","الكامل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87322","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87318","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87327","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87323","الرجز"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76011","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202733","المجتث"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87421","البسيط"],[3356,"","https://poetry.dctabudhabi.ae/diwan/poem/206301",""],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89397","الرجز"],[3560,"","https://poetry.dctabudhabi.ae/diwan/poem/117156","البسيط"],[3564,"","https://poetry.dctabudhabi.ae/diwan/poem/127821","الكامل"],[3637,"","https://poetry.dctabudhabi.ae/diwan/poem/106811","الرجز"],[3700,"","https://poetry.dctabudhabi.ae/diwan/poem/118770","الكامل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114326","المجتث"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111485","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111425","الرجز"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69901","الكامل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124745","الرجز"],[4265,"","https://poetry.dctabudhabi.ae/diwan/poem/138723","البسيط"],[4442,"","https://poetry.dctabudhabi.ae/diwan/poem/104531","الرجز"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141617","السريع"],[4767,"جرح في مسرح الفن","https://www.poetsgate.com/ViewPoem.aspx?id=190963",""],[1012,"فقر الأولياء","https://www.poetsgate.com/ViewPoem.aspx?id=186275",""],[4858,"رثاء الشّيخ الحاج محمّد أحمد خليل","https://www.poetsgate.com/ViewPoem.aspx?id=139897",""],[4929,"مناجاة","https://www.poetsgate.com/ViewPoem.aspx?id=199526",""],[4984,"الْعَهْدُ الْجَدِيدُ","https://www.poetsgate.com/ViewPoem.aspx?id=209104",""],[5313,"حذر فديتك بشرى من تبرزه","https://www.poetsgate.com/ViewPoem.aspx?id=181094",""],[5690,"ما بال نائحة الأغصان لم تنمِ","https://www.poetsgate.com/ViewPoem.aspx?id=172182",""],[6068,"أحببتها وأحبها وأحبها -07-","https://www.poetsgate.com/ViewPoem.aspx?id=177334",""],[6093,"دَعِ التماسَ الهوى مِنْ ظبية الآس (البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176196",""],[6093,"حوار مطرقة","https://www.poetsgate.com/ViewPoem.aspx?id=204052",""],[6097,"أيّار","https://www.poetsgate.com/ViewPoem.aspx?id=186068",""],[6167,"الربان الجسور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85570&r=&rc=53",""]],"verses":[["لكنَّ ذا الأَثْلِ طابَ الواديانِ بِهِ","حَيثُ الرَّبابُ تَجُرُّ الذَّيلَ أَحيانا",0,"ن",2,0],["لكن ذكرت ونعمت الذك","رى لقلبٍ مستهام",1,"م",1,0],["لَكِنَّ ذِكْركَ خَالِدٌ أَبَداً","فِي النَّاسِ مَحْمُودٌ بِكُلِّ فَمِ",2,"م",1,0],["لكن ذاك سطوره ما سُطرت","إلا لهدم فضائل العقلاء",3,"ا",2,0],["لَكِن ذَهَبتُ لِأَرتَدي","فَأَصَبتُ عَيني بِالرِداءِ",4,"ا",2,0],["لكنَّ ذلكَ قولٌ ليسَ يتبعُهُ","خنا وحاشايَ منْ أفعالِ أشرارِ",5,"ر",1,0],["لكن ذلك قَد يَكون لباعث","ظني بكشف غطائه كذاب",6,"ب",1,0],["لَكِنَّ ذَاكَ الصَّوْتَ مِنْ خَفْضٍ بِهِ","يَسْمُو الْحِفَاظُ بِهِ إِلى الْجَوْزَاءِ",7,"ا",2,0],["لكن ذكراك يا وادي الشتا وهوى","جآذر السير رأَس الكوم في راسي",8,"س",2,0],["لكن ذكرتك طيباً","فذكرتهن أطائب",9,"ب",1,0],["لكنَّ ذو المنصب يبقى قائماً","وغيرهُ يذهب غير منظرِ",10,"ر",1,0],["لكن ذلك مجهودي أتيت به","ومن يقصر وراء الجهد لم يلم",11,"م",1,1],["لَكِن ذا الجَهلِ طَبعاً لا يَظُنُّ سِوى","أَنَّ المَلا مِثلُهُ في طَبعِهِ السَفَلِ",12,"ل",1,0],["لكنَّ ذا يوجبُ في قُربِه","حَمداً وذا يوجِب تَكثيرا",13,"ر",2,0],["لكن ذاكَ يسلُّ أح","ياناً وهذا ليسَ يغمَد",14,"د",1,0],["لكنَّ ذاكَ العتبَ يُش","عِلُ في جوانحِهِ اُشتعَالا",15,"ل",2,0],["لكن ذا الفضل مولانا البشير روى","بأن أجود تلك السادةِ الغررِ",16,"ر",1,0],["لكن ذخرتكم حتى تركتكم","آلي وأَوطانكم خلّفتها وطني",17,"ن",2,0],["لكن ذا يا حسين يداهُ تجري بما","وأنت يدك بالذهب تجري وسيفك دما",18,"م",2,0],["لكنّ ذا الفضل العظيم وان أبى","أظهاره دلت عليه دلائل",19,"ل",1,0],["لَكِنّ ذي حِكايَة مِن المَثَل","من يدرها في الناس للرشد وَصل",20,"ل",1,0],["لَكنّ ذا في كُلّ ذاكَ أَلطفُ","إِذ أَهلهُ بِالمُسلِمينَ أَرأفُ",21,"ف",1,0],["لكِنَّ ذاكَ عِنْدَنا يُخَصُّ","بِما رَوى حَمّادُ فَهْوَ نَصُّ",22,"ص",1,0],["لَكنَّ ذا الفَردوسَ خُلِّدَ بَعدَهُ","وَغَدا فَخارُهُم بِهِ مُتَمَكِنا",23,"ن",2,0],["لكن ذلك بعد حجي مكة","وإقامتي حيناً بحيِّ المصطفى",24,"ف",2,0],["لكن ذلك ليس عن عرفٍ ولا","عن فظنةٍ أو عن صوابٍ مشترطْ",25,"ط",1,0],["لكنذَه رُزق التواضُعَ والنهى","والنسّكَ والأخلاصَ في محرابهِ",26,"ب",2,0],["لكن ذكرت به عهود هوىً","لا أختشي لعهوده نقضا",27,"ض",2,0],["لَكِنَّ ذَا عَينُ المَحالِ وَلَو يُسَا","عِدُكم عَلَيهِ رَبُّ كُلِّ لِسَانِ",28,"ن",1,0],["لَكِنَّ ذَا التَّجرِيدَ مُمتَنِعٌ فَإن","يُفرَض يَكُن لاَ شَكَّ فِي الأذهَانِ",28,"ن",1,0],["لَكِن ذَا وَصَفَ الإِلَهَ بِكُلِّ أو","صَافِ الكَمَالِ المُطلَقِ الرَّبَّانِي",28,"ن",2,0],["لكن ذا الايمان يعلم أن ه","ذا كالظلال وكل هذا فان",28,"ن",1,0],["لَكن ذكرت مِن الفَواطم عصبةً","ضَربت بِأَرجاء الطُفوف خِيامَها",29,"م",3,0],["لكنَّ ذا الذي وصَفتُهُ لك","كبيسةٌ يَعرِفها أهل الفَلَك",30,"ك",1,0],["لكنَّ ذا شعبٌ كبيرٌ قاصي","خَمسَ فراسِخ صِرنَ للخَواصِ",31,"ص",1,0],["لَكِنَّ ذي يا صاحبي فيهَا شَجَر","والبَلدُ خَمسُونَ فَقِف أو أغزُر",32,"ر",1,0],["لَكِنَّ ذَاكَ الخَورَ هُوَّ طَويل","يَدخُل لِوَازِينَا لَنَا قَد قِيل",33,"ل",1,0],["لَكنَّ ذاكَ ارتياحٌ هاجَ ساكِنَهُ","ذِكرى مَكانٍ بِهِ نَشئي وَمُؤتَلَفِي",34,"ف",2,0],["لكنّ ذا لانهزامٍ","دعا وذا لاغتنام",35,"م",1,0],["لكنَّ ذَنبي على الحبّ الشديد بُني","يا ليت هَذا بهذا في الغَرام يفي",36,"ف",2,0],["لكن ذاك الرياح أجرت","وذا غداً للرياح يجري",37,"ي",1,0],["لكن ذا لا شك قدماً قُدِرا","قد يرفع التقدير شأن الداني",38,"ي",1,0],["لكِنَّ ذَنبي إليكَ أنّي","قحطانُ لي الجدُّ لا نزارُ",39,"ر",1,0],["لكن ذا عَبَبثٌ فلا خيرٌ بهِ","الاَّ ازديادُ القلبِ حزناُ دائما",40,"م",2,0],["لكِنَّ ذَا بَحَسَبِ الهَواءِ","والأرضُ مِن تحت بِلاَ امتِراءِ",41,"ا",2,0],["لكنّ ذكراه تعيد الحزن لي","والدمع ليس بمطفىءٍ جمراته",42,"ت",2,0],["لَكِنَّ ذَلِكَ فَضلٌ","عظَِيمٌ أحدَثَ فَضلا",43,"ل",2,0],["لكِن ذِيُومِيذٌ على العُنُقِ انثَنى","بِحُسامِهِ العَضَلَينِ قَطعاً يَقطَعُ",44,"ع",1,0],["لكنَّ ذا العَسجَدَ لا يَقِيهِ","مِن بَطشِ آخيلَ إِذا يأتِيهِ",45,"ه",1,0],["لَكنَّ ذا يَسمو عَلى","معنٍ بِمجدٍ يُذخرُ",46,"ر",1,0],["لَكِنَّ ذَا القَولَ لِوَصفِ الحَالِ","بِالحَالِ أفضَى وَهوَ ذُو إشكالِ",47,"ل",1,0],["لَكِنَّ ذَا العِصيَانِ لاَ يُخَلفَّدُ","فِيهَا وَذُو الكُفرِ بِهَا مُؤَبَّدُ",47,"د",1,0],["لكن ذوو النقص صاف فيه شربهم","فلا يطاق لفرط العز حربهم",48,"م",1,0],["لكن ذا قصر عنه سعده","وحظ ذي طال عليه فعبر",49,"ر",1,0],["لكنّ ذا مفتاحه يهي","وتلك مأمون لها الانفتاح",50,"ح",1,0],["لكنَّ ذلك لم يرُق لعصابةٍ","مِن فِكرها عاش المُبجلُ مُبتَلى",51,"ل",2,0],["لكن ذي الحرب لها عدة","خالفت العادة في الأمر",52,"ر",1,0],["لكنّ ذكراها وميراثاً لها","ببناءِ زاويةٍ لها أصداها",53,"ا",3,0],["لكن ذنوبي وآن تعظم بكثرتها","فإن رحمتك الكبرى لها غمد",54,"د",1,0],["لكن ذات الحلم ظل معششا","يبكي به متوجس أطلالها",55,"ل",3,0],["لكن ذلك منه غير دافعه","عن القبول وعن بعد من الشين",56,"ن",1,0],["لكنَّ ذكراك يحيا كلما ذكروا","شيئاً من العلم أو شيئاً من الحكمِ",57,"م",1,0],["لكن ذليل الحب أن قدومها","أحلا من الشهد اللذيذ المبطن",58,"ن",1,0],["12. لكنَّ ذا الحبَّ أعْلاقٌ بأَفئِدةٍ","فقد علقتكَ دونَ الخلْق يا قاسي",59,"س",2,0],["لكنَّ ذا عَقلٍ أجادَ جِهادَهُ","في بحرِ إنكارٍ لذاتٍ أغرَقَهْ",60,"ق",2,0],["لكنَّ ذاكرتي تَأبَى مُعاوَنتي","فالحُبُّ يَغفِرُها، والبُعدُ كَفَارُ",61,"ر",1,0],["لكنَّ ذا العصفورَ قد أزرَى بهم","وأَشَارَ أن الخطبَ يا نزراً يسيرْ",62,"ر",1,0]]}