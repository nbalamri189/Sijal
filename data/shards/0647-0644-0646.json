iewPoem.aspx?id=6687",""],[5493,"معراج الشهداء","https://www.poetsgate.com/ViewPoem.aspx?id=203377",""],[5512,"قمحانة ( هل نعشق )","https://www.poetsgate.com/ViewPoem.aspx?id=204385",""],[5512,"ربيعٌ أم خريف","https://www.poetsgate.com/ViewPoem.aspx?id=204667",""],[5587,"أَرْضُ الرِّسَالَاتِ","https://www.poetsgate.com/ViewPoem.aspx?id=196678",""],[5638,"رثاء وأمل في اللقاء","https://www.poetsgate.com/ViewPoem.aspx?id=198247",""],[5674,"ياوحي الدواوين","https://www.poetsgate.com/ViewPoem.aspx?id=186781",""],[5674,"أمشي ودربي عاثرة","https://www.poetsgate.com/ViewPoem.aspx?id=187634",""],[5690,"هل نور وجهك ضاءَ في لبنانِ","https://www.poetsgate.com/ViewPoem.aspx?id=172190",""],[5725,"انوار محمد","https://www.poetsgate.com/ViewPoem.aspx?id=177543",""],[5742,"مولد النور","https://www.poetsgate.com/ViewPoem.aspx?id=206973",""],[5956,"لِمَ يقصد الدخلاء دوماً بحرنا؟","https://www.poetsgate.com/ViewPoem.aspx?id=192186",""],[5956,"ديمقراطية الدمويِّين","https://www.poetsgate.com/ViewPoem.aspx?id=192364",""],[5956,"عامُ الفجائع","https://www.poetsgate.com/ViewPoem.aspx?id=193099",""],[5956,"القراقوش الأمريكي","https://www.poetsgate.com/ViewPoem.aspx?id=199888",""],[6004,"شَكوَى وَرَجَاء","https://www.poetsgate.com/ViewPoem.aspx?id=59104",""],[6082,"كل الخطى","https://www.poetsgate.com/ViewPoem.aspx?id=60243",""],[6124,"هل نور","https://www.poetsgate.com/ViewPoem.aspx?id=194314",""],[523,"هل لُغْزِي هذا مَفْهُومٌ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=100021",""],[6202,"الشعر والسيف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86705&r=&rc=6",""]],"verses":[["هَل نافِعٌ نَفسَكَ أَذلَلتَها","كَرامَةُ البَيتِ وَعِزُّ القَبيل",0,"ل",1,0],["هَل نَهى الأَعداءَ ساقي","عَلَقٍ ذَمَّوا رَحيقَه",1,"ق",2,0],["هَل نافِعي وَالجَدُّ في صَبَبٍ","مَرّي مَعَ الآمالِ في صُعُدِ",2,"د",1,0],["هَل ناشِدٌ يَنشُدُ لي","ذاكَ الغَزالَ الأَغيَدا",3,"د",2,0],["هَل ناشِدٌ لي بِعَقيقِ الحِمى","غُزَيّلِاً مَرَّ عَلى الرَكبِ",4,"ب",1,1],["هَلْ نُوَفَّيهِ شُكْرَنَا لَوْ بَذَلْنَا","فِي هَوَاهُ الأرْوَاحَ وَالأجْسَامَا",5,"م",2,0],["هل نسيتم جيشاًلكم مُبْذَعِرّاً","شهدت جُبنه سواحل إيجه",6,"ج",2,0],["هل نسيتم جيوشهم يوم جاءوا","فعثَوْا في البلاد واستنفضوها",7,"و",3,0],["هل نبا مِنْكُمُ كبيرٌ سديدٌ","بالكبير السَّديد من أولادِهْ",8,"د",2,0],["هل نَقموا منه سوى جوده","وطيب نفْس فيه عن عِرسِهِ",9,"س",2,0],["هل نكبتي رفعَتْهُمْ فوقَ قدرِهِمُ","فيستوي في مساعينا بنا قدُمُ",10,"م",1,0],["هل نقيضُ السكون إلّا حَرَاكٌ","ونقيضُ الحراكِ إلا السّكونُ",11,"ن",1,0],["هلْ نارُها في كاسِها أم كاسُها","في نارِها وعلى المنازلِ نورُها",12,"ر",3,0],["هَل نافِعٌ قَولي أَبا العَبّاسِ لا","تَبعُد وَبُعدُكَ لَيسَ فيهِ مَزارُ",13,"ر",1,0],["هَل نَحنُ إِلّا كَأَرواحٍ تَمُرُّ بِها","تَحتَ التُرابِ وَأَجسادٍ كَأَجسادِ",14,"د",1,0],["هَل نَحنُ إِلّا كَأَجسادٍ تَمُرُّ بِها","تَحتَ التُرابِ وَأَرواحٍ كَأَرواحِ",15,"ح",1,0],["هل نارُ ليلى بدَتْ ليَلاً بذي سَلَمِ","أمْ بارقٌ لاح في الزوراء فالعَلَمِ",16,"م",1,1],["هل نفوس إلى الدنايا عطاش","كنفوس إلى المَعالي ظوامي",17,"م",2,0],["هَلْ نَجِيبٌ وَقَدْ نَدَا النَّاسَ إِلاَّ","مَنْ لَهُ حَيْثُ كَانَ صَدْرُ النَّادِي",18,"د",2,0],["هَل نَعَت مُصابَ فَتىً","فيهِ طيبُ عُنصُرِها",19,"ر",3,0],["هَل نَحنُ فيكَ جسومٌ دونَ أَفئِدَةٍ","أَم نَحنُ أَفئِدَةٌ مِن دونِ أَجسامِ",20,"م",1,0],["هَلْ نَعَيْتُم لِلْبُحْتُرِيِّ بَيَانَهْ","أوْ بَكَيْتُم لِمَعْبَدٍ أَلْحَانَهْ",21,"ن",2,1],["هل ننثني يا شوط ؟ هل ينثني","نهر يريد العشب ، أن يوقفه؟",22,"ف",2,0],["هل نفحة هل نظرة هل غوثةٌ","ترقى خويدكم لنيل مناله",23,"ل",2,0],["هل نقضت العهد القديم وإلا","فلماذا سبقْتني بارتحالِ",24,"ل",1,0],["هل نحنُ إلا كَمَن تقدَّمنا","منا ومن تمَّ ظِمؤُه يَرِد",25,"د",1,0],["هَل نُفِّرَت لا نُفِّرَت غِزلانُهُ","أَو صَوَّحَت لا صَوَّحَت باناتُهُ",26,"ت",2,0],["هَل ناشِدٌ لي بِاللِّوا شادِناً","في لَحظِهِ هاروتُ مَسجونا",27,"ن",2,0],["هَلْ نَافَسَ الرَّجَّافَ في دُرَّةٍ","فَكانَ ما أَخْرَجَهُ أَغْرَبَا",28,"ب",2,0],["هل نافِعي كِتمانُ ما لاقَيتُه","لمَّا غَدا دَمعي علَيهِ دَليلا",29,"ل",2,0],["هَل نافِعي أن أتَى المَقصودُ مُشتَمِلاً","بِجودِه وارتَدى المَعشوقُ بالبخلِ",30,"ل",1,0],["هَلْ نسلّ البيضَ مِن أغمادها","ونَرى الأغماد منهْم وهي هامُ",31,"م",1,0],["هل نرى السّمرَ تُبدّي ألْسُناً","نَفْثُها عندَ الِّلقا الموتُ الزؤامُ",31,"م",1,0],["هل نقود الخيلَ تَتْرى شزّباً","جلّلَ الأكفالَ منهنّ القتامُ",31,"م",1,0],["هل نشقُ النقعَ يوماً بالظّبىَ","مثلما انشقَّ عنِ الشهب الغمامُ",31,"م",1,0],["هَلْ نرى الدّين عزيزاً بعدما","قد غدا بالثّمن النزرِ يُسامُ",31,"م",1,0],["هَلْ نرى مذهب زيدٍ ظاهراً","فلقدْ طالَ اختفاءٌ واكْتِتَامُ",31,"م",1,0],["هل نعمة خلصت من نقمة عرضت","فيما اعتراض جفون العين للغمض",32,"ض",1,0],["هل نافعٌ لي حسنُ إفصاحي بها","إذا غدا حظّي بها مُجمجِما",33,"م",2,0],["هل نجدُ إلا منزلٌ مفارَقٌ","ووطنٌ في غيره يُقضى الوطَرْ",34,"ر",1,0],["هل نافعي طولُ البكاءِ وقد مَضَى","زمنُ الوصالِ ولو تدافعَ عِدُّه",35,"د",2,0],["هل نسيمُ الصَّبا على نارِهم مر","رَ ففيه أشُمُّ أنفاسَ عُودِ",36,"د",1,0],["هل نشأة الزمن القديم أعادها","منشي الخليقة في الزمان الأول",37,"ل",1,0],["هَل نَحنُ في الأيّام إِلّا معشرٌ","صُمٌّ بلا فهمٍ ولا إِفهامِ",38,"م",1,0],["هل نِلتَ إنْ نِلْتَ الأمانِيَّ الّتي","تَروم إلّا مَشرباً أو مطعما",39,"م",2,0],["هل نافعي عذبُك يا","عذبٌ ومنه شَرَقي",40,"ق",2,0],["هَلْ نافِعي أَنِّيَ يق","ظانٌ وجدِّيَ ناعِسْ",41,"س",1,0],["هل ناصعات المحيا ام ملائكة","في الخز وُشى بياقوت ومرجان",42,"ن",1,0],["هَل نَسيتَ العُهودَ هَيهاتَ ما كا","نَت عُهودٌ ما بَينَنا العُمرُ تَخفِر",43,"ر",1,0],["هَل نازَعُوك غُبارَ الخَوفِ أو فُتِحَت","لَهُم بَراقِشُ مِن قَهرٍ وَغُمدانُ",44,"ن",1,0],["هل نال إسماعيلُ من شعرائه","ما نلت من شعرائك الأمجاد",45,"د",1,0],["هل نبدلنَّ مسيطراً بمسيطرٍ","ونفر من نَهِمٍ إلى غرثان",46,"ن",1,0],["هل نسيت سينوبُ حربَ القِرْمِ","ورجمك الأسطول أي رجْمِ",47,"م",1,0],["هل نبعث البدنَ الدفينَ من الثرى","ونخط للروح القوي المدفنا",48,"ن",2,0],["هل نحن أمة قيصرٍ أو جاره","كسرى فيخشى أن يحيط به الدم",49,"م",1,0],["هل نهلةٌ من ريقها ورُضابها","فَلَعلَّ روحي تَهتَدي لِحياتِها",50,"ت",3,0],["هَل نَسمَةٌ مِنها إِليّ تَمرُّ بي","حَتّى أَشُمَّ العِطرَ من نَفحاتها",50,"ت",3,0],["هل نهلةٌ من فيكَ تطفئُ حرَّه","فلعلّه يُروَى وأنّى يَرتوي",51,"و",2,0],["هَل نَتّقي ذا السَبع وَهوَ عَيِّلُ","أَبوه قَد ماتَ فَماذا يَفعل",52,"ل",1,0],["هل نفحة بالغور طيّبةُ الأَرج","تُطفي فؤاداً ذاب من فَرْط الوَهَجْ",53,"ج",1,1],["هل نختشي الكرب الشداد وكفه","عنا تكف من الخطوب شدادها",54,"د",3,0],["هل نظرة تذر الخطوب بلاقعا","أو مطرة يحيي الرميم غمامها",55,"م",3,0],["هل نَلتَقِي في رَوضَةٍ مَوشِيَّةٍ","خَفَّاقَةِ الأَغصَانِ وَالأَفيَاءِ",56,"ا",2,0],["هل نعيت الغصن رطبا ناميا","أم نعيت البدر وهّاج الجناب",57,"ب",1,0],["هل نسمة من صبا نجد تعلّلني","ففي النسيم لقلب الصب تعليل",58,"ل",1,0],["هل نثرت مِسكاً على كُثبها","إذ عبقت دلاًّ بإسبالها",59,"ل",3,0],["هل نفوسُ العُلى مباءةُ حتفٍ","أَم كبارُ الآمال نِضوُ الجِهاد",60,"د",1,0],["هَل نحن إِلّا أَنتم","حرف بحرف معجم",61,"م",1,0],["هل نافعي والأماني كلُّها خُدَعٌ","قولي له اليومَ لا تَبْعَدْ وقد بَعُدا",62,"د",2,0],["هل نافع آه والصعداء أو","إهراقنا للمدمع المدرار",63,"ر",1,0],["هل نستعيد زمانا كان يحسدنا","عليه من حسدته البدو والحضر",64,"ر",1,0],["هل نسبوا أيام لا نسمع في","مصر إلا حافظا يذكي الزبون",65,"ن",1,0],["هل نكير عليك انك للم","عوز غوث تجيئه وهابا",66,"ب",2,0],["هل نكير عليك انك ذوق","لبٍ بحب الإله يذكى التهابا",66,"ب",2,0],["هل نكيرٌ عليك انك راعٍ","في رعاياهُ يألف الاتعابا",66,"ب",2,0],["هَل نُكرِمُ الأَضيافَ إِن نَزَلوا بِنا","وَنَسودُ بِالمَعروفِ غَيرَ تَنَحُّلِ",67,"ل",1,0],["هل ناصح للملوك ينذرهم","مبلغ إن أفاد إنذار",68,"ر",1,0],["هل نسبة الذهب الإبريز في شِبه","ما صاغَه الصائغُ العلاّم من شَبَه",69,"ب",2,0],["هَل نالَ رُتبَتَهُ الهادي وَسُؤدُده","إِلّا بِإِدمانِهِ صَبراً عَلى الأَلَمِ",70,"م",1,0],["هل نهضةٌ لِلعلمِ يظهرُ فضلُها","في غربنا فالعلمُ أصدقُ مُرشِدِ",71,"د",1,0],["هل نظرته حبيب القلب في ذلك الدّار","حيّ تلك البوادي مجمع الغيد الأقمار",72,"ر",1,0],["هل نفحة منكم تلف شملي","قد طال بي يا أحبتي جفاكم",73,"م",1,0],["هل نفحة منكم تخف ثقلي","ما خاب بل ما ردّ من دعاكم",73,"م",1,0],["هل نظرة منك عين اللَه تلحظني","بها وهل عطفة لي منك تدركني",74,"ن",2,0],["هل نافعي أن جمعت العلم والأدبا","إن كان أسعدُ أيامي الذي ذهبا",75,"ب",2,1],["هل نبوغي بصنع مرآة روحي","أو بأني كشفت عنها المحيا",76,"ي",2,0],["هل نرى يوماً سنا حرية","فلقد ساد علينا الغلس",77,"س",1,0],["هل نعمة مثل صمت سيدة","حيث كلام النساء أعيانا",78,"ن",2,0],["هل نهرك الجاري سوى أدمعٍ","تجري على ما دال من دولتك",79,"ك",1,0],["هل نجوم السماء إلا صفات","لك زينت بزهرهن السماء",80,"ا",2,0],["هل نبأ البرق الذي جاءنا","عن بشرنا بالفتح انباك",81,"ك",1,0],["هل نسوا للشرق ما أسّسه","مِن فخارٍ قد تولّاه الهلاك",82,"ك",1,0],["هل نسوا ما كان في أندلسٍ","من علومٍ وفنون حينذاك",82,"ك",1,0],["هَل نَفسُهُ تُرضيهِ واعجبا","ام كانَ هَذا الحكم مطرَّدا",83,"د",2,0],["هَل نَسمَةٌ نتِنيك يَا مَن عُد","ت تجري بِهِ فِي التِّيهِ جَريَ جِمَاح",84,"ح",1,0],["هَل نَائِلٌ أَنَا وَصلَهُ وَإلَيهِ يَو","ماً مَنهَجاً بِالوَصلِ أَنَّى يَسمَحُ",85,"ح",1,0],["هل نَهْنَأُ العيشَ وذا الدهرُ إِذن","بطَيِّه تقلُّبٌ بلا انتها",86,"ا",1,0],["هل نيل مما خرت إلا نسبة","والرزق رغماً من هوانِ المال",87,"ل",1,0],["هل نسبةٌ لِذُكاءَ بين ذكائه","إن قستَه بالبدر أنت ظلوم",88,"م",1,0],["هل نعقل الخمر عقلاً عن محاسنه","إذ ما له عن صواب الرأي من خمر",89,"ر",1,0],["هَل نأمل اللائين حالوا بَينَنا","في الرائِعاتِ وَبَينَ كلّ أَمانِ",90,"ن",1,0],["هل نأنف الهولَ والكروبا","وعشينا عندها رغيد",91,"د",1,0],["هل نعْمةٌ أو يدٌ تأتي وقد سلفَتْ","إلا وناصرُ دين اللهِ مُسْدِيها",92,"ي",3,0],["هل نسوا كم افاد مقتطف عل","ماً واذكى مقطم اذهانا",93,"ن",2,0],["هَل نَكَسَت رَأسَها الأَقلام باكية","إَلّا عَلَيك بِطول الوَيل وَالحَرب",94,"ب",1,0],["هل نالَ هاجَرَ وابنَها اذ فارَقَت","مولاتَها في البِيدِ غيرُ ظَماءِ",95,"ا",2,0],["هَل ناعسٌ يَسطو على سَهرانِ","فَرَمى الفؤادَ بلحظه الوَسنانِ",96,"ن",1,1],["هَل نافعي من سحر عينيك ما","كَررته من عُوَذٍ في الصَّلاه",97,"ا",2,0],["هَلْ نَوْطُ حِلْيَتِهِ إِلاَّ بِلَبَّةِ مَنْ","فِي طَاعَةِ اللهِ لَجَّ غَيْرِ ذِي ثِقَلِ",98,"ل",1,0],["هَل نَظرَةٌ مِنكُمُ أَجلو بِها كَربي","وَلا يَخيبُ بِكُم يا سادَتي الأَمَلُ",99,"ل",1,0],["هَل نافع منك الفرار إِذا وهل","تغنى محاذرة القَضاء فَتيلا",100,"ل",2,0],["هَل نَحوكُم لقصَّتي إِبلاغُ","أَم هَل لِظلالِ وَصلكم إِسباغُ",101,"غ",1,1],["هَل نَصلُكَ يا ص