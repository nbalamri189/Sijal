{"poems":[[53,"إن أشر الخطب فلا روعة","https://www.aldiwan.net/poem29882.html","السريع"],[53,"خل دمعي وطريقه","https://www.aldiwan.net/poem29957.html","مجزوء الرمل"],[53,"هب للديار بقية الجلد","https://www.aldiwan.net/poem30519.html","الكامل"],[53,"يا قلب جدد كمدا","https://www.aldiwan.net/poem30611.html","مجزوء الرجز"],[53,"هل ناشد لي بعقيق الحمى","https://www.aldiwan.net/poem30721.html","السريع"],[93,"أيها البالغ الثريا مقاماً","https://www.aldiwan.net/poem11412.html","الخفيف"],[88,"أيها الانكليز لن نتناسى","https://www.aldiwan.net/poem44457.html","الخفيف"],[88,"يا بني الرافدين مالي أراكم","https://www.aldiwan.net/poem44473.html","الطويل"],[51,"أتصاب إلى ذوي إسعاده","https://www.aldiwan.net/poem61862.html","الخفيف"],[51,"ماذا يريد الناس من خالد","https://www.aldiwan.net/poem64633.html","السريع"],[62,"يا شامتا لزمان قد تنكر لي","https://www.aldiwan.net/poem52292.html","البسيط"],[80,"سلم الأمر منك لله واعلم","https://www.aldiwan.net/poem31257.html","الخفيف"],[69,"برية بحرية حزنية","https://www.aldiwan.net/poem29299.html","الكامل"],[81,"يشقى بريب زمانها الأحرار","https://www.aldiwan.net/poem61519.html","الكامل"],[15,"يا حار ما راح من قوم ولا ابتكروا","https://www.aldiwan.net/poem45269.html","البسيط"],[15,"يا صاح مهلا أقل العذل يا صاح","https://www.aldiwan.net/poem45278.html","البسيط"],[68,"هل نار ليلى بدت ليلا بذي سلم","https://www.aldiwan.net/poem1526.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85330","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43747","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54261","الخفيف"],[100,"أمام المفترق الاخير","https://www.poetsgate.com/ViewPoem.aspx?id=50359",""],[116,"من للفقير المشتكي من حاله","https://www.aldiwan.net/poem41750.html","الكامل"],[136,"كنت في مصر قوة ذات بال","https://www.aldiwan.net/poem49176.html","الخفيف"],[225,"هل تعرف الدار خف ساكنها","https://www.aldiwan.net/poem416.html",""],[236,"عصر الشباب تصرمت أوقاته","https://www.aldiwan.net/poem32134.html","الكامل"],[283,"حي على أثلات يبرينا","https://www.aldiwan.net/poem32396.html","السريع"],[349,"من صفة الجوهر أن يرسبا","https://www.aldiwan.net/poem19852.html","السريع"],[372,"قل للأحبة يصبرون قليلا","https://www.aldiwan.net/poem57171.html","الكامل"],[372,"دون اعتدالك حكم غير معتدل","https://www.aldiwan.net/poem57199.html","البسيط"],[403,"كيف يرضيك على الضيم المقام","https://www.aldiwan.net/poem46920.html","الرمل"],[442,"المرء لا زال في دنياه كالعرض","https://www.aldiwan.net/poem14456.html","البسيط"],[459,"ظن غداة الخيف أن قد سلِما","https://www.aldiwan.net/poem55900.html","الرجز"],[459,"بالغور ما شاء المطايا والمطر","https://www.aldiwan.net/poem56190.html","الرجز"],[478,"أما هواك وان تقادم عهده","https://www.aldiwan.net/poem15208.html","الكامل"],[515,"شرف الوجه في تراب زرود","https://www.aldiwan.net/poem20806.html","الخفيف"],[516,"من أجل هيبة ذا المقام المذهل","https://www.aldiwan.net/poem12202.html","الكامل"],[552,"من أين لي معد على الأيام","https://www.aldiwan.net/poem47204.html","الكامل"],[552,"إن على رمل العقيق خيما","https://www.aldiwan.net/poem47229.html","الرجز"],[552,"يا جالبا للأرق","https://www.aldiwan.net/poem47350.html","مجزوء الرجز"],[576,"أوحشني الأوانس","https://www.aldiwan.net/poem3056.html","مجزوء الرجز"]],"verses":[["هَل نافِعٌ نَفسَكَ أَذلَلتَها","كَرامَةُ البَيتِ وَعِزُّ القَبيل",0,"ل",1,0],["هَل نَهى الأَعداءَ ساقي","عَلَقٍ ذَمَّوا رَحيقَه",1,"ق",2,0],["هَل نافِعي وَالجَدُّ في صَبَبٍ","مَرّي مَعَ الآمالِ في صُعُدِ",2,"د",1,0],["هَل ناشِدٌ يَنشُدُ لي","ذاكَ الغَزالَ الأَغيَدا",3,"د",2,0],["هَل ناشِدٌ لي بِعَقيقِ الحِمى","غُزَيّلِاً مَرَّ عَلى الرَكبِ",4,"ب",1,1],["هَلْ نُوَفَّيهِ شُكْرَنَا لَوْ بَذَلْنَا","فِي هَوَاهُ الأرْوَاحَ وَالأجْسَامَا",5,"م",2,0],["هل نسيتم جيشاًلكم مُبْذَعِرّاً","شهدت جُبنه سواحل إيجه",6,"ج",2,0],["هل نسيتم جيوشهم يوم جاءوا","فعثَوْا في البلاد واستنفضوها",7,"و",3,0],["هل نبا مِنْكُمُ كبيرٌ سديدٌ","بالكبير السَّديد من أولادِهْ",8,"د",2,0],["هل نَقموا منه سوى جوده","وطيب نفْس فيه عن عِرسِهِ",9,"س",2,0],["هل نكبتي رفعَتْهُمْ فوقَ قدرِهِمُ","فيستوي في مساعينا بنا قدُمُ",10,"م",1,0],["هل نقيضُ السكون إلّا حَرَاكٌ","ونقيضُ الحراكِ إلا السّكونُ",11,"ن",1,0],["هلْ نارُها في كاسِها أم كاسُها","في نارِها وعلى المنازلِ نورُها",12,"ر",3,0],["هَل نافِعٌ قَولي أَبا العَبّاسِ لا","تَبعُد وَبُعدُكَ لَيسَ فيهِ مَزارُ",13,"ر",1,0],["هَل نَحنُ إِلّا كَأَرواحٍ تَمُرُّ بِها","تَحتَ التُرابِ وَأَجسادٍ كَأَجسادِ",14,"د",1,0],["هَل نَحنُ إِلّا كَأَجسادٍ تَمُرُّ بِها","تَحتَ التُرابِ وَأَرواحٍ كَأَرواحِ",15,"ح",1,0],["هل نارُ ليلى بدَتْ ليَلاً بذي سَلَمِ","أمْ بارقٌ لاح في الزوراء فالعَلَمِ",16,"م",1,1],["هل نفوس إلى الدنايا عطاش","كنفوس إلى المَعالي ظوامي",17,"م",2,0],["هَلْ نَجِيبٌ وَقَدْ نَدَا النَّاسَ إِلاَّ","مَنْ لَهُ حَيْثُ كَانَ صَدْرُ النَّادِي",18,"د",2,0],["هَل نَعَت مُصابَ فَتىً","فيهِ طيبُ عُنصُرِها",19,"ر",3,0],["هَل نَحنُ فيكَ جسومٌ دونَ أَفئِدَةٍ","أَم نَحنُ أَفئِدَةٌ مِن دونِ أَجسامِ",20,"م",1,0],["هَلْ نَعَيْتُم لِلْبُحْتُرِيِّ بَيَانَهْ","أوْ بَكَيْتُم لِمَعْبَدٍ أَلْحَانَهْ",21,"ن",2,1],["هل ننثني يا شوط ؟ هل ينثني","نهر يريد العشب ، أن يوقفه؟",22,"ف",2,0],["هل نفحة هل نظرة هل غوثةٌ","ترقى خويدكم لنيل مناله",23,"ل",2,0],["هل نقضت العهد القديم وإلا","فلماذا سبقْتني بارتحالِ",24,"ل",1,0],["هل نحنُ إلا كَمَن تقدَّمنا","منا ومن تمَّ ظِمؤُه يَرِد",25,"د",1,0],["هَل نُفِّرَت لا نُفِّرَت غِزلانُهُ","أَو صَوَّحَت لا صَوَّحَت باناتُهُ",26,"ت",2,0],["هَل ناشِدٌ لي بِاللِّوا شادِناً","في لَحظِهِ هاروتُ مَسجونا",27,"ن",2,0],["هَلْ نَافَسَ الرَّجَّافَ في دُرَّةٍ","فَكانَ ما أَخْرَجَهُ أَغْرَبَا",28,"ب",2,0],["هل نافِعي كِتمانُ ما لاقَيتُه","لمَّا غَدا دَمعي علَيهِ دَليلا",29,"ل",2,0],["هَل نافِعي أن أتَى المَقصودُ مُشتَمِلاً","بِجودِه وارتَدى المَعشوقُ بالبخلِ",30,"ل",1,0],["هَلْ نسلّ البيضَ مِن أغمادها","ونَرى الأغماد منهْم وهي هامُ",31,"م",1,0],["هل نرى السّمرَ تُبدّي ألْسُناً","نَفْثُها عندَ الِّلقا الموتُ الزؤامُ",31,"م",1,0],["هل نقود الخيلَ تَتْرى شزّباً","جلّلَ الأكفالَ منهنّ القتامُ",31,"م",1,0],["هل نشقُ النقعَ يوماً بالظّبىَ","مثلما انشقَّ عنِ الشهب الغمامُ",31,"م",1,0],["هَلْ نرى الدّين عزيزاً بعدما","قد غدا بالثّمن النزرِ يُسامُ",31,"م",1,0],["هَلْ نرى مذهب زيدٍ ظاهراً","فلقدْ طالَ اختفاءٌ واكْتِتَامُ",31,"م",1,0],["هل نعمة خلصت من نقمة عرضت","فيما اعتراض جفون العين للغمض",32,"ض",1,0],["هل نافعٌ لي حسنُ إفصاحي بها","إذا غدا حظّي بها مُجمجِما",33,"م",2,0],["هل نجدُ إلا منزلٌ مفارَقٌ","ووطنٌ في غيره يُقضى الوطَرْ",34,"ر",1,0],["هل نافعي طولُ البكاءِ وقد مَضَى","زمنُ الوصالِ ولو تدافعَ عِدُّه",35,"د",2,0],["هل نسيمُ الصَّبا على نارِهم مر","رَ ففيه أشُمُّ أنفاسَ عُودِ",36,"د",1,0],["هل نشأة الزمن القديم أعادها","منشي الخليقة في الزمان الأول",37,"ل",1,0],["هَل نَحنُ في الأيّام إِلّا معشرٌ","صُمٌّ بلا فهمٍ ولا إِفهامِ",38,"م",1,0],["هل نِلتَ إنْ نِلْتَ الأمانِيَّ الّتي","تَروم إلّا مَشرباً أو مطعما",39,"م",2,0],["هل نافعي عذبُك يا","عذبٌ ومنه شَرَقي",40,"ق",2,0],["هَلْ نافِعي أَنِّيَ يق","ظانٌ وجدِّيَ ناعِسْ",41,"س",1,0]]}