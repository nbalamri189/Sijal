an/poem/58163","الوافر"],[4675,"وصية لفتاة","https://www.poetsgate.com/ViewPoem.aspx?id=192257",""],[4755,"فَتِّشْ معي يا ابنَ أمِّي عَن ظِلالِ أبي","https://www.poetsgate.com/ViewPoem.aspx?id=184808",""],[4755,"كُلُّ شَيءٍ يَجيءُ بِالبُندُقِيّةْ","https://www.poetsgate.com/ViewPoem.aspx?id=201014",""],[4767,"أسير الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=211260",""],[4578,"يا من سمت بمعانيه قوافينا","https://www.poetsgate.com/ViewPoem.aspx?id=49532",""],[4578,"أبانت فوق حاجبها المصون","https://www.poetsgate.com/ViewPoem.aspx?id=49534",""],[4987,"رغم التعب","https://www.poetsgate.com/ViewPoem.aspx?id=49591",""],[5111,"هَامَانُ يَعْرِفُنِي","https://www.poetsgate.com/ViewPoem.aspx?id=212238",""],[5121,"الإحسَاس","https://www.poetsgate.com/ViewPoem.aspx?id=215180",""],[5122,"يابعد عمري تعالي","https://www.poetsgate.com/ViewPoem.aspx?id=18066",""],[5136,"إما وتعليس اللما","https://www.poetsgate.com/ViewPoem.aspx?id=121687",""],[5145,"نسيم الصبا بادر بهبتك الفجرا","https://www.poetsgate.com/ViewPoem.aspx?id=108203",""],[5152,"وتسأل؟","https://www.poetsgate.com/ViewPoem.aspx?id=184347",""],[5185,"نبوءة الحجاب","https://www.poetsgate.com/ViewPoem.aspx?id=72852",""],[5277,"لحن لم يغنه زرياب","https://www.poetsgate.com/ViewPoem.aspx?id=186005",""],[5302,"إني أحبك يا نجود","https://www.poetsgate.com/ViewPoem.aspx?id=200779",""],[5324,"رأس مال المفلسين.","https://www.poetsgate.com/ViewPoem.aspx?id=211508",""],[5376,"هلاَّ وصلتم دار ليلى مرةً","https://www.poetsgate.com/ViewPoem.aspx?id=197728",""],[5387,"أحبكِ","https://www.poetsgate.com/ViewPoem.aspx?id=50582",""],[5480,"العين والكاف","https://www.poetsgate.com/ViewPoem.aspx?id=31228",""],[5628,"شر المصائب","https://www.poetsgate.com/ViewPoem.aspx?id=178705",""],[5630,"ولقد أقول لشَيْبة أبْصرتُها","https://www.poetsgate.com/ViewPoem.aspx?id=15407",""],[5648,"حنين القلب","https://www.poetsgate.com/ViewPoem.aspx?id=154662",""],[5664,"الزبرجد","https://www.poetsgate.com/ViewPoem.aspx?id=176688",""],[5672,"طيف الخيال","https://www.poetsgate.com/ViewPoem.aspx?id=206507",""],[5732,"لا وا عشيري","https://www.poetsgate.com/ViewPoem.aspx?id=177921",""],[5732,"من يم خلي","https://www.poetsgate.com/ViewPoem.aspx?id=177891",""],[5745,"من وحي مهرجان بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=200061",""],[5758,"إلى شاعر","https://www.poetsgate.com/ViewPoem.aspx?id=200527",""],[402,"أمر الأمير لما احب دعاني","https://www.poetsgate.com/ViewPoem.aspx?id=36459",""],[5790,"أنظرت أم فوقت سهما","https://www.poetsgate.com/ViewPoem.aspx?id=112135",""],[5939,"أسيرتي","https://www.poetsgate.com/ViewPoem.aspx?id=129125",""],[5944,"عنيدة","https://www.poetsgate.com/ViewPoem.aspx?id=213101",""],[5956,"هجاء","https://www.poetsgate.com/ViewPoem.aspx?id=192939",""],[5956,"لولا أحبكَ هل يجيشُ قصيدي؟","https://www.poetsgate.com/ViewPoem.aspx?id=193370",""],[5956,"سأكون دون إقامة وأبورُ","https://www.poetsgate.com/ViewPoem.aspx?id=204590",""],[6056,"نفحة نسانيس","https://www.poetsgate.com/ViewPoem.aspx?id=130322",""],[6102,"زيشان","https://www.poetsgate.com/ViewPoem.aspx?id=184170",""],[6113,"الحمد لله بس عدت على خير","https://www.poetsgate.com/ViewPoem.aspx?id=27074",""],[6174,"الشِّعر في عُرس النجومِ الخُضر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86185&r=&rc=2",""],[6215,"شرقيّة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84933&r=&rc=7",""]],"verses":[["عَنّي إِلَيكَ فَما الوِصالُ بِنافِعٍ","مَن لا يُعَذَّبُ قَلبُهُ بِغَرامِ",0,"م",1,0],["عَنيتُ مِنَ القَلبِ العَفيفِ بِعاذِلٍ","وَمِن خُدَعِ الشَوقِ السَفيهِ بِعاذِرِ",1,"ر",1,0],["عَنّي إِلَيكَ فَلَستِ مِن أَربي","ما أَنتِ مِن غَيِّي وَمِن رَشدي",2,"د",2,0],["عَنيفٌ وَإِن كانَ ذا شِرَّةٍ","بِجَمعِ الضَرائِرِ شَلّالُها",3,"ل",3,0],["عُنيتَ بِحالَةَ الفَلّاحِ حَتّى","تَهَيَّبَ أَن يَزورَ الأَرضَ مَحلُ",4,"ل",1,0],["عَنيفٍ بِتَجميعِ الضَرائِرِ فاحِشٍ","شَتيمٍ كَذِلقِ الزُجِّ ذي ذَمَراتِ",5,"ت",1,0],["عَنَيتُ قَصيراتِ الحِجالِ وَلَم أُرِد","قِصارَ الخُطا شَرُّ النِساءِ البَحاتِرُ",6,"ر",1,0],["عَنّي وَعَن شَمَردَلٍ مِجفالِ","أَعيَطَ وَخّاطِ الخُطى الطِوالِ",7,"ل",1,0],["عني الربيع بوشيها فتنوّعت","للعين أنوار بها وزهور",8,"ر",1,0],["عَنيفٌ بِهَزِّ السَيفِ قَينُ مُجاشِعٍ","رَفيقٌ بِأَخراتِ الفُؤوسِ الكَرازِمِ",9,"م",1,0],["عُنينا زَماناً بِالتَصَعلُكِ وَالغِنى","كَما الدَهرُ في أَيّامِهِ العُسرُ وَاليُسرُ",10,"ر",1,0],["عَنّي تَضِبُّ لِثاتُكُم فَغَدَت بِكُم","سَوداءَ أَصلُ فُروعِها كَالعُنقُرِ",11,"ر",1,0],["عن يميني وعن شمالي وقُدّا","مي وخلفي فأين عنه أحيدُ",12,"د",1,0],["عُنِيتَ بهم حتى كأنك والدٌ","لهم وهمُ دوني بنوك الأصاغر",13,"ر",1,0],["عُنيتَ بأخلاق الزمان تروضُها","ليبأسَ عاتيه ويَنعم بائسه",14,"س",2,0],["عنيتني والعناء أفدح ما","يقدح في العارفات والمنن",15,"ن",1,0],["عَنيفٌ بِتَحوازِ المَخاضِ وَرَعيِها","وَلَكِن بِإِرقاصِ البُرينَ رَفيقُ",16,"ق",1,0],["عَنَيتُ مالِيَ مِن قَلبَينِ في جَسَدي","وَلَيسَ قَلبي إِلى قِسمَينِ مُشَطِرا",17,"ر",2,0],["عَن يَميني وَيَساري","وَوَرائي وَأَمامي",18,"م",2,0],["عن يمني اذا نظرت يميني","وشمالي اذا نظرت شمالي",19,"ل",2,0],["عَنّي كَأَنّي إِذا أَتَيتُكُمُ","مُسَلِّماً شارِفٌ بِها جَرَبُ",20,"ب",1,0],["عُنِيَت بِهِ عَينُ الرَقيبِ فَلَم تَدَع","مِن نَيلِهِ المَطلوبِ غَيرَ زَهيدِهِ",21,"د",2,0],["عَنيتُ بِشَرقِ الأَرضِ قَدماً وَغَربِها","أُجَوِّبُ في آفاقِها وَأَسيرُها",22,"ر",3,0],["عُنِيَ الرَّبيعُ بها فَنشَّرَ حولَها","حُللاً تُدَبِّجُ وَشْيَها أيدي النَّدى",23,"د",2,0],["عَنّي إِلَيكِ فَإِنّي عَنكِ في شُغُلٍ","لي مِنهُ يَومٌ يُبَكّي مُهجَتي وَغَدُ",24,"د",1,0],["عُنِيَ الرَبيعُ بِرَوضِهِ فَكَأَنَّما","أَهدى إِلَيهِ الوَشيَ مِن صَنعاءِ",25,"ا",2,0],["عنى الوالِهَ المتبولَ منكِ ادِّكارُهُ","وأضناهُ طيْفُ من خَيالكِ يَطرُقُه",26,"ق",2,0],["عنيفٌ ببَذلِ الوَفرِ يَلحي عُفاتَه","على صَفَدٍ ما كان نُهزَةَ من لَحى",27,"ح",2,0],["عُنيتُ بِمَركَبِ البِرذَونِ حَتّى","أَضَرَّ الكيسَ إِغلاءُ الشَعيرِ",28,"ر",1,1],["عَن يَميني وَعَن يَساري وَقُدّا","مي وَخَلفي الهَوى فَكَيفَ أَفِرُّ",29,"ر",1,1],["عَنَّيتُ نَفساً غَيرَ آمِنَةٍ","في غَيرِ فاحِشَةٍ وَلا هُجرِ",30,"ر",1,0],["عَنَيتُ بِها القَوارِحَ وَهيَ غُرٌّ","وَلَسنَ بِخَيلِكَ المُتَقَدِّماتِ",31,"ت",1,0],["عني خذوا وبي اقْتدوا وليَ اسمعوا","وتحدّثوا بصَبابتي بَينَ الوَرى",32,"ر",2,0],["عنّي إليكُمْ ظِبَاءَ المُنْحَنَى كرَماً","عهِدْتُ طَرْفِيَ لم يَنْظرْ لغَيْرِهم",33,"م",1,0],["عَنِيَتْ تُوَاصِلُني فَلَمَّا رَابَني","مِنْها الهَوَى آذَنْتُهَا بِزِيَالِ",34,"ل",1,0],["عنيت بي عناية واستمرت","بشرابي مهتمة وطعامي",35,"م",2,0],["عُنِيَ الرَّبِيعُ بِنَسْجِ بُرْدَتِهَا","إِنَّ الرَّبِيعَ لَصَانِعٌ ثَقِفُ",36,"ف",1,0],["عُنِيتَ بِالزَّرْعِ وَبِالزُّرَّاعِ مَا","فَرَّطْتَ فِي جُهْدٍ وَلاَ اجْتِهَادِ",37,"د",1,0],["عُنيتَ بِالفُنُونِ وَالآدَابِ لَمْ","تَضَنَّ بِالعَطْفِ عَلَى مِجْوَادِ",37,"د",1,0],["عَنَيْتُ إِيزابِيلَّ أُخْتَ الْبَدْرِ","ذَاتَ الصِّفَاتِ البَاهِرَاتِ الغُرِّ",38,"ر",1,0],["عَنْ يَقِينٍ مِنَ الأُولَى رَابَهُمْ قَبْ","لَكَ أَنَّ الحَيَاةَ فِي التَّجْدِيدِ",39,"د",1,0],["عن يد، صيفيةِ اللّمس وعن","شرفةٍ جذلى، وعن نبض غناءِ",40,"ا",2,0],["عنيت مالي من قلبين في جسدي","وليس قلبي إلى قسمين منشطرا",41,"ر",2,0],["عن يد ، صيفية اللّمس وعر شرفة","جذلى ، وعن نبض غناء",42,"ا",2,0],["عني توارى دلالاً","وللأباعد دارا",43,"ر",2,0],["عني اقتصرْ يا لائمي في حبه","سفهاً فقول العارفينَ فضولُ",44,"ل",1,0],["عنيت بها الرؤيا التي شان ذكرها","كتابك أعني موجبات المغافر",45,"ر",1,0],["عَنينٌ وَآلُ الفَضلِ مِن آلِ بَرمَكٍ","وَكُلُّهُمُ لِلعِزِّ أَنفٌ وَكاهِلُ",46,"ل",1,0],["عَنّي إِلَيكِ حَوادِثَ الأَيّامِ","ما كُلُّ يَومٍ يُستَطاعُ خِصامي",47,"م",2,1],["عَنِّى وَعَن صَيهَبَةٍ قَد شَرَفَت","عادَت تُبارِى الاَزفَلَى وَاستَأنَفَت",48,"ت",1,0],["عنيت بوصفهم فقصدتُ ذمّاً","ليسلم من غلوٍّ ما أقول",49,"ل",1,0],["عني عفوا لا عفت عنهم جرائمهم","من جانثين بصدق الوعد غدّار",50,"ر",1,0],["عُنِيتَ بِما يُعْنَى بِهِ كُلُّ خَاشِعٍ","فَلِلَّهِ بَرٌّ مِنْكَ للَّهِ خاشِعُ",51,"ع",1,0],["عنيَت لَها بالرغمِ إِذ عنيت بها","وَبلا فداءٍ أسرُ من لا يقنعُ",52,"ع",1,0],["عَنّي وَإِن وَعَدوا تُخلِفُ وَعدَهُم","لَم يَبقَ لي فيهِم رَجاءٌ أَنَّهُم",53,"م",1,0],["عَنِيَّ بالرَّاحِ يَا نَدِيمي","فالشَّيْب قَدْ أغْلَظَ الخِطابَا",54,"ب",2,0],["عنيت لِقاء أَحمَد مَن تَهادى","لَهُ حمدي فَطابَ شَذاً وَريّا",55,"ي",2,0],["عنيت