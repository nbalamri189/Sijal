{"poems":[[53,"بعادا لمن صاحبت غير المقوم","https://www.aldiwan.net/poem29758.html","الطويل"],[53,"تناسيت إلا باقيات من الذكر","https://www.aldiwan.net/poem30441.html","الطويل"],[53,"سلا ظاهر الأنفاس عن باطن الوجد","https://www.aldiwan.net/poem30601.html","الطويل"],[54,"مدارس آيات خلت من تلاوة","https://www.aldiwan.net/poem28547.html","الطويل"],[30,"أقول لنفسي واقفا عند مشرف","https://www.aldiwan.net/poem29553.html","الطويل"],[30,"ألا أيها الربع الذي غير البلى","https://www.aldiwan.net/poem29602.html","الطويل"],[27,"إذا أوضع الركبان غورا وأنجدوا","https://www.aldiwan.net/poem5915.html","الطويل"],[27,"إذا أولى النجوم بدت فغارت","https://www.aldiwan.net/poem5923.html","الوافر"],[27,"متى كان الخيام بذي طلوح","https://www.aldiwan.net/poem5991.html","الوافر"],[11,"ومرقبة دون السماء علوته","https://www.aldiwan.net/poem227.html",""],[51,"رويدك أيها الرجل المنادي","https://www.aldiwan.net/poem9229.html","الوافر"],[51,"أبو عثمان والرومي","https://www.aldiwan.net/poem64019.html","الهزج"],[51,"إذا أولي النعمى دعا الله أن يرى","https://www.aldiwan.net/poem65404.html","الطويل"],[51,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[70,"تمليته يالابس العز ملبسا","https://www.aldiwan.net/poem42859.html","الطويل"],[12,"إذا أوحش الليل الهدان وجدتني","https://www.aldiwan.net/poem1209.html",""],[85,"على أي الجنان بنا تمر","https://www.aldiwan.net/poem63714.html","الوافر"],[62,"لقاء الأماني في ضمان القواضب","https://www.aldiwan.net/poem52506.html","الطويل"],[45,"قفا في مغاني الدار نسأل طلولها","https://www.aldiwan.net/poem65590.html","الطويل"],[28,"تذكر هذا القلب من شوقه ذكرا","https://www.aldiwan.net/poem5056.html","الطويل"],[69,"إذا أوعدتنا شرا","https://www.aldiwan.net/poem28678.html","مجزوء الوافر"],[74,"ألا سرت القبول ولو نسيما","https://www.aldiwan.net/poem13250.html","الوافر"],[46,"أرى كل أم عبرها غير مبطئ","https://www.aldiwan.net/poem22528.html","الطويل"],[46,"أعن عفر تلم بسرب عفر","https://www.aldiwan.net/poem22686.html","الوافر"],[46,"ينشر في الدنيا الحديث وينطوي","https://www.aldiwan.net/poem22786.html","الطويل"],[46,"تمنت شيعة الهجري نصرا","https://www.aldiwan.net/poem23455.html","الوافر"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/147517","الطويل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16643","الوافر"],[67,"وسَلَنَّ حَبْقُوقَ المُصَرِّحَ باسْمِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=14564",""],[30,"ألا أيُّها الرَّسمُ الذي غيَّرَ البلى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=20510&r=&rc=4",""],[126,"أيا سوقا فلو صورت شخصا","https://www.aldiwan.net/poem50670.html","الوافر"],[158,"إذا اومض البرق من أرضها","https://www.aldiwan.net/poem58689.html","المتقارب"],[158,"قليل لها هجر الجنوب المضاجعا","https://www.aldiwan.net/poem58996.html","الطويل"],[158,"هو الدهر كرت في المعالي كتائبه","https://www.aldiwan.net/poem59068.html","الطويل"],[183,"سيان ستر غرامي فيك والعدم","https://www.aldiwan.net/poem14662.html","البسيط"],[227,"وفاتقة ظلمة الحندس","https://www.aldiwan.net/poem50982.html","المتقارب"],[233,"أيطمع أن يساجلك السحاب","https://www.aldiwan.net/poem32176.html","الوافر"],[346,"إذا أوترت قوس السحاب وفوقت","https://www.aldiwan.net/poem20772.html","الطويل"],[349,"ومختلف الأصوات مؤتلف الزحف","https://www.aldiwan.net/poem68975.html","الطويل"],[351,"صلوا حبل ودي يا كرام وزوروا","https://www.aldiwan.net/poem40349.html","الطويل"],[364,"هجرت الفتى ظلما له فوجدته","https://www.aldiwan.net/poem17668.html","الطويل"],[403,"أبان لنا من دره يوم ودعا","https://www.aldiwan.net/poem50150.html","الطويل"],[406,"ديار الهوى حيا معالمك ولإن","https://www.aldiwan.net/poem31699.html","عموديه"],[406,"إذا أوحشتني جفوة الخل ردني","https://www.aldiwan.net/poem32527.html","الطويل"],[413,"إلى العز خوري يا نياقي وأنجدي","https://www.aldiwan.net/poem54159.html","الطويل"],[436,"أرحلي محمول على العتق النجب","https://www.aldiwan.net/poem34886.html","الطويل"],[456,"إذا ذهب الوفاء من الزمانِ","https://www.aldiwan.net/poem55825.html","الوافر"],[459,"يتيه الخميس المجر بابن مهلهل","https://www.aldiwan.net/poem15350.html","الطويل"],[459,"يمل هواه كل سرج وسابح","https://www.aldiwan.net/poem15449.html","الطويل"],[459,"الام يراك المجد في زي شاعر","https://www.aldiwan.net/poem15927.html","الطويل"],[462,"ألمت سليمى والنسيم عليل","https://www.aldiwan.net/poem3634.html","عموديه"],[468,"ألا نولي قبل الفراق قذور","https://www.aldiwan.net/poem4845.html","الطويل"],[560,"أتتني بلا وعد وقد نضت الحجبا","https://www.aldiwan.net/poem52878.html","الكامل"],[565,"إذا أومض البرق من نحوها","https://www.aldiwan.net/poem69514.html","المتقارب"]],"verses":[["إِذا أَوجَسَت حِسَّ القَطيعِ وَراءَها","أَلاحَت بِخَيشومٍ كَريمٍ وَمَلطَمِ",0,"م",1,0],["إِذا أَوهَنَت عَظمي اللَيالي وَجَدتُهُم","بِأَيدي النَدى وَالطَعنِ قَد جَبَروا كَسري",1,"ر",2,0],["إِذا أَورَدَتهُ نَهلَةً مِن نَعيمِها","أَعادَتهُ حَرّانَ الضُلوعِ مِنَ الوِردِ",2,"د",1,0],["إِذا أَورَدوا خَيلاً تَسَعَّرُ بِالقَنا","مَساعِرُ جَمرِ المَوتِ وَالغَمَراتِ",3,"ت",1,0],["إِذا أَومَضَت مِن نَحوِ مَيٍّ سَحابَةٌ","نَظَرتُ بِعَيني صادِقِ الشَوقِ وامِقِ",4,"ق",1,0],["إِذا أَوجَعَتهُنَّ البُرى أَو تَناوَلَت","قُوى الضَفرِ في أَعطافِهِنَّ الوَلائِدُ",5,"د",1,0],["إِذا أَوضَعَ الرُكبانُ غَوراً وَأَنجَدوا","بِها فَاِرجُزا يا اِبنَي مُعَيَّةَ أَو دَعا",6,"ع",2,1],["إِذا أولى النُجومِ بَدَت فَغارَت","وَقُلتُ أَنى مِنَ اللَيلِ اِنتِصافُ",7,"ف",1,1],["إِذا أَوقَعتُ صاعِقَةً عَلَيهِم","رَأوا أُخرى تَحَرَّقُ فَاِستَداموا",8,"م",3,0],["إِذا أَوطَنَ القَومُ البُيوتَ وَجَدتَهُم","عُماةً عَنِ الأَخبارِ خُرقَ المَكاسِبِ",9,"ب",1,0],["إذا أولَى أياديَهُ أُناساً","فأُولاها لأخراها احتثاثُ",10,"ث",1,0],["إذا أوفى على المنبَ","رِ مثل القمر البدر",11,"ر",1,0],["إذا أُولِيَ النُّعمى دعا الله أن يرى","بأصحابها يوم اختبار الصنائع",12,"ع",1,1],["إذا أوْجس النُّوتيُّ يوماً حَسِيسَهُ","وقد عارض البوصيُّ شمَّرَ واحتزمْ",13,"م",1,0],["إِذا أوقِدَت لِلحَربِ نارٌ أَوِ القِرى","تَوَهَّمتَهُ مِن عِشقِها مُتَمَجِّسا",14,"س",2,0],["إِذا أَوحَشَ اللَّيلُ الهِدانَ وَجَدتني","هو الأُنسُ لي والمَشرفِيُّ المُهَنَّدُ",15,"د",1,1],["إِذا أَومَأنَ وَقَّفَتِ اللَيالي","وَتَحمي الحادِثاتُ فَلا تَمُرُّ",16,"ر",1,0],["إِذا أوردوا السمر اللِّدانَ تحاجزوا","بها عن دماءِ الأُسْدِ حُمْرَ الثعالبِ",17,"ب",1,0],["إِذا أَوطَأَ الشُقرَ الدِماءَ مُشايِحاً","أَعادَ إِلى تِلكَ الشِياتِ حُجولَها",18,"ل",3,0],["إِذا أَوعَدوني عِندَ ظَمياءَ ساءَها","وَعيدي وَقالَت لا تَقولوا لَهُ هُجرا",19,"ر",2,0],["إذا أوعدْتَنا شراً","يلوكُكَ طفلُنا لوكَهْ",20,"ه",1,1],["إِذا أَوطَأتُهُ أَعقابَ لَيلٍ","طَرَدتُ مِنَ الظَلامِ بِهِ ظَليما",21,"م",2,0],["إِذا أودِعَتها جُثَّةٌ وَتَعَرَّضَت","لِبيضِ الظُبى لَم يُمكِنِ السَيفَ هَبرُها",22,"ر",3,0],["إِذا أوتيتَ مِلءَ يَدٍ طَعاماً","فَأَطعِم مَن عَراكَ وَلَو كَظُفرِ",23,"ر",1,0],["إِذا أَوجَدَت يَوماً مِنَ الوُجدِ أَوجَدَت","مِنَ الوَجدِ هَذا خُلُقُها وَهوَ أَشرَسُ",24,"س",1,0],["إِذا أوتيتَ مالاً فَاِبذُلنَهُ","فَما يُبقيهِ تَوفيرٌ وَخَزنُ",25,"ن",1,0],["إذا أودعت سراً غلا في ضميرها","فباتت من السر المصون على الجمر",26,"ر",1,0],["إذا أوْطَأتُها قَدَمَيْ سُهَيْلٍ","فلا سُقِيَتْ خُناصِرَةُ العِهادا",27,"د",2,0],["إذا أوْصَلَ القَوْلَ الصَّريحَ بِذِكْرِهِ","للسَّامعينَ فأحسنَ التوصيلا",28,"ل",2,0],["إِذَا أَوْجَعَتْهُنَّ الْبُرَى أَوْ تَنَاوَلَتْ","قوى الضَّفرِ عنْ أعطافهنَّ الولائدُ",29,"د",1,0],["إذا آواك ذو كِبَرٍ تَقَوَّى","كأن به يرى عمراً قشيباً",30,"ب",2,0],["إذا اومض البرق من أرضها","يخيل لي أنها تبسم",31,"م",1,1],["إذا أوعد الجاني فصدق بخلفه","وكن بوفاه في المواعيد قاطعا",32,"ع",2,0],["إذا أوعد الجاني تغشاه عفوه","وإن وعد العافي غشته مواهبه",33,"ب",2,0],["إذا أُولُوا الفضلِ غالُوا في مدائحِه","منها فقد جَهِلُوا أضعافَ ماعلموا",34,"م",3,0],["إذا أوقِدت نثرت أدمعا","عليهِ من الذهبِ الأملس",35,"س",1,0],["إِذا أَوفَت عَلى أَرضٍ طَوَتها","عَواشِرُها كَما يُطوى الكِتابُ",36,"ب",1,0],["إذا أُوتِرَتْ قَوسُ السَّحابِ وَفُوِّقَتْ","سِهَامُ الحَيالِلحلي سَحَّتْ رَاميها",37,"ه",2,1],["إذا أومضت فيه الصوارم خلتها","بروقاً تراءى في الجهام وتستخفي",38,"ف",2,0],["إِذا أَوطؤوها عاصما خلت أَنَّهُ","فَريسٌ قَد اِنقَضَّت عَلَيهِ نُسورُ",39,"ر",1,0],["إِذا أوقِدَت نارٌ لِهِجرانِهِ اِصطَلى","وَإِن يَجزِ عَن حيفٍ أَلَمَّ بِهِ اِصطَلَم",40,"م",1,0],["إِذا أَول الخُطيِّ أَخطاك طعنه","فَلا ترج في أَخراهُ لِلضَّيمِ مدفعا",41,"ع",2,0],["إذا أوحشتني وحدتي بعد فقرهم","ولهت كأني قد أصابني السحر",42,"ر",1,0],["إِذا أَوحَشَتْنِي جَفوةُ الخِلِّ رَدّني","إِليهِ وَفاءٌ بالإخاءِ ضَنِينُ",43,"ن",1,1],["إذا أوعدوا الطاغين بالبأس أرهبوا","وإنْ أحْسَنوا الحسنى فعن غير موعد",44,"د",1,0],["إِذا أَوْقدَتْ جِسمي هَجيراً تظلَّلت","فَحلَّتْ كِناساً من شَغافِيَ أَوْ خِلبي",45,"ب",2,0],["إذا أوت الأمور إليه بانت","محامَاةُ المعين عن المُعانِ",46,"ن",1,0],["اذا أوقد النارين بالصبح والدجى","تباشر بالخِصب المَعاديمُ والنَّسر",47,"ر",1,0],["إِذا أوسعوهُ من جِدالٍ بشُبهةٍ","رماهم ببرهانِ النُّهى والحقائقِ",48,"ق",1,0],["اذا أوطأ الجبَّارَ حافِرَ طِرْفهِ","غَدا لاثماً وجه النَّديم المُعاشِرِ",49,"ر",1,0],["إذا أوحشت خوف الأعادي","دعتك فلبتها قناً ونصول",50,"ل",1,0],["إِذا أولجت مِنكُم بِنا العيسُ أَو غَدَت","فَلا وَصل إِلا ما يجنُّ ضَميرُ",51,"ر",1,0],["إذا أوجَبَ اللهُ الكريمُ لعبدِهِ","عَطاءً فمَنْ ذا يَستطيعُ لهُ سَلْبا",52,"ب",2,0],["إِذَا أَوْمَضَ البَرْقُ مِنْ نَحْوِهَا","تَمَثَّلُ لِي أَنَّهَا تَبْتَسِمُ",53,"م",1,1]]}