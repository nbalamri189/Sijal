{"poems":[[55,"بعادا لمن صاحبت غير المقوم","https://www.aldiwan.net/poem29758.html","الطويل"],[55,"تناسيت إلا باقيات من الذكر","https://www.aldiwan.net/poem30441.html","الطويل"],[55,"سلا ظاهر الأنفاس عن باطن الوجد","https://www.aldiwan.net/poem30601.html","الطويل"],[56,"مدارس آيات خلت من تلاوة","https://www.aldiwan.net/poem28547.html","الطويل"],[32,"أقول لنفسي واقفا عند مشرف","https://www.aldiwan.net/poem29553.html","الطويل"],[32,"ألا أيها الربع الذي غير البلى","https://www.aldiwan.net/poem29602.html","الطويل"],[29,"إذا أوضع الركبان غورا وأنجدوا","https://www.aldiwan.net/poem5915.html","الطويل"],[29,"إذا أولى النجوم بدت فغارت","https://www.aldiwan.net/poem5923.html","الوافر"],[29,"متى كان الخيام بذي طلوح","https://www.aldiwan.net/poem5991.html","الوافر"],[11,"ومرقبة دون السماء علوته","https://www.aldiwan.net/poem227.html",""],[53,"رويدك أيها الرجل المنادي","https://www.aldiwan.net/poem9229.html","الوافر"],[53,"أبو عثمان والرومي","https://www.aldiwan.net/poem64019.html","الهزج"],[53,"إذا أولي النعمى دعا الله أن يرى","https://www.aldiwan.net/poem65404.html","الطويل"],[53,"أفيضا دما إن الرزايا لها قيم","https://www.aldiwan.net/poem66086.html","الطويل"],[72,"تمليته يالابس العز ملبسا","https://www.aldiwan.net/poem42859.html","الطويل"],[12,"إذا أوحش الليل الهدان وجدتني","https://www.aldiwan.net/poem1209.html",""],[87,"على أي الجنان بنا تمر","https://www.aldiwan.net/poem63714.html","الوافر"],[64,"لقاء الأماني في ضمان القواضب","https://www.aldiwan.net/poem52506.html","الطويل"],[47,"قفا في مغاني الدار نسأل طلولها","https://www.aldiwan.net/poem65590.html","الطويل"],[30,"تذكر هذا القلب من شوقه ذكرا","https://www.aldiwan.net/poem5056.html","الطويل"],[71,"إذا أوعدتنا شرا","https://www.aldiwan.net/poem28678.html","مجزوء الوافر"],[76,"ألا سرت القبول ولو نسيما","https://www.aldiwan.net/poem13250.html","الوافر"],[48,"أرى كل أم عبرها غير مبطئ","https://www.aldiwan.net/poem22528.html","الطويل"],[48,"أعن عفر تلم بسرب عفر","https://www.aldiwan.net/poem22686.html","الوافر"],[48,"ينشر في الدنيا الحديث وينطوي","https://www.aldiwan.net/poem22786.html","الطويل"],[48,"تمنت شيعة الهجري نصرا","https://www.aldiwan.net/poem23455.html","الوافر"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/147517","الطويل"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16643","الوافر"],[69,"وسَلَنَّ حَبْقُوقَ المُصَرِّحَ باسْمِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=14564",""],[32,"ألا أيُّها الرَّسمُ الذي غيَّرَ البلى","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=20510&r=&rc=4",""],[132,"أيا سوقا فلو صورت شخصا","https://www.aldiwan.net/poem50670.html","الوافر"],[164,"إذا اومض البرق من أرضها","https://www.aldiwan.net/poem58689.html","المتقارب"],[164,"قليل لها هجر الجنوب المضاجعا","https://www.aldiwan.net/poem58996.html","الطويل"],[164,"هو الدهر كرت في المعالي كتائبه","https://www.aldiwan.net/poem59068.html","الطويل"],[189,"سيان ستر غرامي فيك والعدم","https://www.aldiwan.net/poem14662.html","البسيط"],[234,"وفاتقة ظلمة الحندس","https://www.aldiwan.net/poem50982.html","المتقارب"],[240,"أيطمع أن يساجلك السحاب","https://www.aldiwan.net/poem32176.html","الوافر"],[353,"إذا أوترت قوس السحاب وفوقت","https://www.aldiwan.net/poem20772.html","الطويل"],[356,"ومختلف الأصوات مؤتلف الزحف","https://www.aldiwan.net/poem68975.html","الطويل"],[358,"صلوا حبل ودي يا كرام وزوروا","https://www.aldiwan.net/poem40349.html","الطويل"],[371,"هجرت الفتى ظلما له فوجدته","https://www.aldiwan.net/poem17668.html","الطويل"],[412,"أبان لنا من دره يوم ودعا","https://www.aldiwan.net/poem50150.html","الطويل"],[415,"ديار الهوى حيا معالمك ولإن","https://www.aldiwan.net/poem31699.html","عموديه"],[415,"إذا أوحشتني جفوة الخل ردني","https://www.aldiwan.net/poem32527.html","الطويل"],[422,"إلى العز خوري يا نياقي وأنجدي","https://www.aldiwan.net/poem54159.html","الطويل"],[445,"أرحلي محمول على العتق النجب","https://www.aldiwan.net/poem34886.html","الطويل"],[463,"إذا ذهب الوفاء من الزمانِ","https://www.aldiwan.net/poem55825.html","الوافر"],[466,"يتيه الخميس المجر بابن مهلهل","https://www.aldiwan.net/poem15350.html","الطويل"],[466,"يمل هواه كل سرج وسابح","https://www.aldiwan.net/poem15449.html","الطويل"],[466,"الام يراك المجد في زي شاعر","https://www.aldiwan.net/poem15927.html","الطويل"],[469,"ألمت سليمى والنسيم عليل","https://www.aldiwan.net/poem3634.html","عموديه"],[475,"ألا نولي قبل الفراق قذور","https://www.aldiwan.net/poem4845.html","الطويل"],[567,"أتتني بلا وعد وقد نضت الحجبا","https://www.aldiwan.net/poem52878.html","الكامل"],[572,"إذا أومض البرق من نحوها","https://www.aldiwan.net/poem69514.html","المتقارب"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96992","الطويل"],[927,"","https://poetry.dctabudhabi.ae/diwan/poem/123395","المتقارب"],[936,"","https://poetry.dctabudhabi.ae/diwan/poem/138717",""],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62457","الوافر"],[469,"","https://poetry.dctabudhabi.ae/diwan/poem/205217","الطويل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59119","الطويل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/138111",""],[1052,"","https://poetry.dctabudhabi.ae/diwan/poem/130884","الطويل"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61192","الطويل"],[1239,"","https://poetry.dctabudhabi.ae/diwan/poem/128264","المتقارب"],[1284,"","https://poetry.dctabudhabi.ae/diwan/poem/202176","الوافر"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49993","الطويل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48239","الوافر"],[2224,"","https://poetry.dctabudhabi.ae/diwan/poem/126381","الطويل"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45641","الطويل"],[2597,"","https://poetry.dctabudhabi.ae/diwan/poem/198645","الطويل"],[2737,"","https://poetry.dctabudhabi.ae/diwan/poem/20977","البسيط"],[2770,"","https://poetry.dctabudhabi.ae/diwan/poem/93437","الطويل"],[2789,"","https://poetry.dctabudhabi.ae/diwan/poem/21628","الوافر"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74093","الوافر"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123920","الطويل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129406","الطويل"],[3697,"","https://poetry.dctabudhabi.ae/diwan/poem/140289",""],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92132","الوافر"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85246","الطويل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131278",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131079",""],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32859","الطويل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59481","الطويل"],[3928,"","https://poetry.dctabudhabi.ae/diwan/poem/131342","الطويل"],[3987,"","https://poetry.dctabudhabi.ae/diwan/poem/146873","الوافر"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101386","الوافر"],[4298,"","https://poetry.dctabudhabi.ae/diwan/poem/135092","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81707","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73186","الوافر"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120484","الوافر"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139595",""],[4933,"سهام الليل صائبة المرامي","https://www.poetsgate.com/ViewPoem.aspx?id=196610",""],[4119,"ألا كم ترامت بالس بمسافر","https://www.poetsgate.com/ViewPoem.aspx?id=16165",""],[1043,"جنة القلب","https://www.poetsgate.com/ViewPoem.aspx?id=93885",""],[5277,"مطرٌ.. ولاتَ سحاب","https://www.poetsgate.com/ViewPoem.aspx?id=201052",""],[5277,"مناط الحب والسلام","https://www.poetsgate.com/ViewPoem.aspx?id=203323",""],[5582,"أَهذا الَّذِي تَحْتَ النِّقابِ هُوَ الخَدُّ","https://www.poetsgate.com/ViewPoem.aspx?id=63487",""],[402,"واذكر ضروب كفاحه لبلاده","https://www.poetsgate.com/ViewPoem.aspx?id=36068",""],[5956,"أوكلتُ أمري للإلهِ","https://www.poetsgate.com/ViewPoem.aspx?id=194038",""],[5956,"أ يصبح أولويّاً في انتشالي","https://www.poetsgate.com/ViewPoem.aspx?id=204460",""],[6086,"ذات همة !!","https://www.poetsgate.com/ViewPoem.aspx?id=29238",""],[6093,"عند قبر","https://www.poetsgate.com/ViewPoem.aspx?id=192004",""],[5126,"تأمل! فلا سرّ لديك ولا جهر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87800&r=&rc=15",""],[5126,"فلسطين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87828&r=&rc=43",""],[572,"إذا أومضَ البرقُ من أرضِهَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9454&r=&rc=311",""]],"verses":[["إِذا أَوجَسَت حِسَّ القَطيعِ وَراءَها","أَلاحَت بِخَيشومٍ كَريمٍ وَمَلطَمِ",0,"م",1,0],["إِذا أَوهَنَت عَظمي اللَيالي وَجَدتُهُم","بِأَيدي النَدى وَالطَعنِ قَد جَبَروا كَسري",1,"ر",2,0],["إِذا أَورَدَتهُ نَهلَةً مِن نَعيمِها","أَعادَتهُ حَرّانَ الضُلوعِ مِنَ الوِردِ",2,"د",1,0],["إِذا أَورَدوا خَيلاً تَسَعَّرُ بِالقَنا","مَساعِرُ جَمرِ المَوتِ وَالغَمَراتِ",3,"ت",1,0],["إِذا أَومَضَت مِن نَحوِ مَيٍّ سَحابَةٌ","نَظَرتُ بِعَيني صادِقِ الشَوقِ وامِقِ",4,"ق",1,0],["إِذا أَوجَعَتهُنَّ البُرى أَو تَناوَلَت","قُوى الضَفرِ في أَعطافِهِنَّ الوَلائِدُ",5,"د",1,0],["إِذا أَوضَعَ الرُكبانُ غَوراً وَأَنجَدوا","بِها فَاِرجُزا يا اِبنَي مُعَيَّةَ أَو دَعا",6,"ع",2,1],["إِذا أولى النُجومِ بَدَت فَغارَت","وَقُلتُ أَنى مِنَ اللَيلِ اِنتِصافُ",7,"ف",1,1],["إِذا أَوقَعتُ صاعِقَةً عَلَيهِم","رَأوا أُخرى تَحَرَّقُ فَاِستَداموا",8,"م",3,0],["إِذا أَوطَنَ القَومُ البُيوتَ وَجَدتَهُم","عُماةً عَنِ الأَخبارِ خُرقَ المَكاسِبِ",9,"ب",1,0],["إذا أولَى أياديَهُ أُناساً","فأُولاها لأخراها احتثاثُ",10,"ث",1,0],["إذا أوفى على المنبَ","رِ مثل القمر البدر",11,"ر",1,0],["إذا أُولِيَ النُّعمى دعا الله أن يرى","بأصحابها يوم اختبار الصنائع",12,"ع",1,1],["إذا أوْجس النُّوتيُّ يوماً حَسِيسَهُ","وقد عارض البوصيُّ شمَّرَ واحتزمْ",13,"م",1,0],["إِذا أوقِدَت لِلحَربِ نارٌ أَوِ القِرى","تَوَهَّمتَهُ مِن عِشقِها مُتَمَجِّسا",14,"س",2,0],["إِذا أَوحَشَ اللَّيلُ الهِدانَ وَجَدتني","هو الأُنسُ لي والمَشرفِيُّ المُهَنَّدُ",15,"د",1,1],["إِذا أَومَأنَ وَقَّفَتِ اللَيالي","وَتَحمي الحادِثاتُ فَلا تَمُرُّ",16,"ر",1,0],["إِذا أوردوا السمر اللِّدانَ تحاجزوا","بها عن دماءِ الأُسْدِ حُمْرَ الثعالبِ",17,"ب",1,0],["إِذا أَوطَأَ الشُقرَ الدِماءَ مُشايِحاً","أَعادَ إِلى تِلكَ الشِياتِ حُجولَها",18,"ل",3,0],["إِذا أَوعَدوني عِندَ ظَمياءَ ساءَها","وَعيدي وَقالَت لا تَقولوا لَهُ هُجرا",19,"ر",2,0],["إذا أوعدْتَنا شراً","يلوكُكَ طفلُنا لوكَهْ",20,"ه",1,1],["إِذا أَوطَأتُهُ أَعقابَ لَيلٍ","طَرَدتُ مِنَ الظَلامِ بِهِ ظَليما",21,"م",2,0],["إِذا أودِعَتها جُثَّةٌ وَتَعَرَّضَت","لِبيضِ الظُبى لَم يُمكِنِ السَيفَ هَبرُها",22,"ر",3,0],["إِذا أوتيتَ مِلءَ يَدٍ طَعاماً","فَأَطعِم مَن عَراكَ وَلَو كَظُفرِ",23,"ر",1,0],["إِذا أَوجَدَت يَوماً مِنَ الوُجدِ أَوجَدَت","مِنَ الوَجدِ هَذا خُلُقُها وَهوَ أَشرَسُ",24,"س",1,0],["إِذا أوتيتَ مالاً فَاِبذُلنَهُ","فَما يُبقيهِ تَوفيرٌ وَخَزنُ",25,"ن",1,0],["إذا أودعت سراً غلا في ضميرها","فباتت من السر المصون على الجمر",26,"ر",1,0],["إذا أوْطَأتُها قَدَمَيْ سُهَيْلٍ","فلا سُقِيَتْ خُناصِرَةُ العِهادا",27,"د",2,0],["إذا أوْصَلَ القَوْلَ الصَّريحَ بِذِكْرِهِ","للسَّامعينَ فأحسنَ التوصيلا",28,"ل",2,0],["إِذَا أَوْجَعَتْهُنَّ الْبُرَى أَوْ تَنَاوَلَتْ","قوى الضَّفرِ عنْ أعطافهنَّ الولائدُ",29,"د",1,0],["إذا آواك ذو كِبَرٍ تَقَوَّى","كأن به يرى عمراً قشيباً",30,"ب",2,0],["إذا اومض البرق من أرضها","يخيل لي أنها تبسم",31,"م",1,1],["إذا أوعد الجاني فصدق بخلفه","وكن بوفاه في المواعيد قاطعا",32,"ع",2,0],["إذا أوعد الجاني تغشاه عفوه","وإن وعد العافي غشته مواهبه",33,"ب",2,0],["إذا أُولُوا الفضلِ غالُوا في مدائحِه","منها فقد جَهِلُوا أضعافَ ماعلموا",34,"م",3,0],["إذا أوقِدت نثرت أدمعا","عليهِ من الذهبِ الأملس",35,"س",1,0],["إِذا أَوفَت عَلى أَرضٍ طَوَتها","عَواشِرُها كَما يُطوى الكِتابُ",36,"ب",1,0],["إذا أُوتِرَتْ قَوسُ السَّحابِ وَفُوِّقَتْ","سِهَامُ الحَيالِلحلي سَحَّتْ رَاميها",37,"ه",2,1],["إذا أومضت فيه الصوارم خلتها","بروقاً تراءى في الجهام وتستخفي",38,"ف",2,0],["إِذا أَوطؤوها عاصما خلت أَنَّهُ","فَريسٌ قَد اِنقَضَّت عَلَيهِ نُسورُ",39,"ر",1,0],["إِذا أوقِدَت نارٌ لِهِجرانِهِ اِصطَلى","وَإِن يَجزِ عَن حيفٍ أَلَمَّ بِهِ اِصطَلَم",40,"م",1,0],["إِذا أَول الخُطيِّ أَخطاك طعنه","فَلا ترج في أَخراهُ لِلضَّيمِ مدفعا",41,"ع",2,0],["إذا أوحشتني وحدتي بعد فقرهم","ولهت كأني قد أصابني السحر",42,"ر",1,0],["إِذا أَوحَشَتْنِي جَفوةُ الخِلِّ رَدّني","إِليهِ وَفاءٌ بالإخاءِ ضَنِينُ",43,"ن",1,1],["إذا أوعدوا الطاغين بالبأس أرهبوا","وإنْ أحْسَنوا الحسنى فعن غير موعد",44,"د",1,0],["إِذا أَوْقدَتْ جِسمي هَجيراً تظلَّلت","فَحلَّتْ كِناساً من شَغافِيَ أَوْ خِلبي",45,"ب",2,0],["إذا أوت الأمور إليه بانت","محامَاةُ المعين عن المُعانِ",46,"ن",1,0],["اذا أوقد النارين بالصبح والدجى","تباشر بالخِصب المَعاديمُ والنَّسر",47,"ر",1,0],["إِذا أوسعوهُ من جِدالٍ بشُبهةٍ","رماهم ببرهانِ النُّهى والحقائقِ",48,"ق",1,0],["اذا أوطأ الجبَّارَ حافِرَ طِرْفهِ","غَدا لاثماً وجه النَّديم المُعاشِرِ",49,"ر",1,0],["إذا أوحشت خوف الأعادي","دعتك فلبتها قناً ونصول",50,"ل",1,0],["إِذا أولجت مِنكُم بِنا العيسُ أَو غَدَت","فَلا وَصل إِلا ما يجنُّ ضَميرُ",51,"ر",1,0],["إذا أوجَبَ اللهُ الكريمُ لعبدِهِ","عَطاءً فمَنْ ذا يَستطيعُ لهُ سَلْبا",52,"ب",2,0],["إِذَا أَوْمَضَ البَرْقُ مِنْ نَحْوِهَا","تَمَثَّلُ لِي أَنَّهَا تَبْتَسِمُ",53,"م",1,1],["إذا أومض البرق الحجازي في الدجى","كعرنين قن من بني الزنج يرعف",54,"ف",1,0],["إذا أَوْحَشَ الحيُّ من سادتي","فلا أنا منكَ ولا أنت منّي",55,"ي",1,0],["إذا أوحش السياح في الغرب مربع","ففي الطلل الشرقى أنسٌ ومنجعُ",56,"ع",1,1],["إذا أوحت بكوكبها","تدانى القرب والبعدُ",57,"د",1,0],["إذا أوحشت خوف الأعادي قلوبها","دعتك فلبتها قناً ونصول",58,"ل",1,0],["إذَا أوَّبُوا قُلْنَا شُمُوسٌ طَوَالِعٌ","وَإنْ أدْلَجُوا قُلْنَا نُجُومٌ ثَوَاقِبُ",59,"ب",1,0],["إذا أومضت عيناك لاح لمقلتي","ضياء منير يزدري صفحة البدر",60,"ر",1,1],["إذا أوقدوا للحرب ناراً تأجَّجت","مجامرها والبيض تدمى نصولها",61,"ل",3,0],["إِذا أودعت جَمراً تَضوع ريحها","بِعرف فتيت المسك أَو عَنبر الشحر",62,"ر",1,0],["إذا أوجعتك سياط الغريب","فعون القريب له أوجع",63,"ع",1,1],["إِذا أَودى ابْنُ زيدانٍ عَليٌّ","فلا طَلَعتْ نُجومُكِ يا سماءٌ",64,"ا",2,1],["إذا أودعت جسمَ الزُجاجة روحها","وراح يُعاطيها الغَضيضَ المُهفْهَفا",65,"ف",2,0],["إِذا أوْلى الندى ترك الأراضي","لها حَدَقاً تُغازِلُها البَراجا",66,"ج",2,0],["اذا أومض البرق اليماني شمته","برجع جفون لحظها متخازرُ",67,"ر",1,0],["إِذا أَوحَت اليُسرى إِلَيها وَوَسوسَت","انلت لَها اليُمنى بِما ذا تَوَسوسُ",68,"س",1,0],["إذا أوّبوا ساروا شموساً منيرة","وإن أدلجوا أمسوا نجوماً ثواقبا",69,"ب",2,0],["إِذا أُواضِعُ مِنهُ ظَلَّ مُنتَحِياً","مَرَّ الأَتِيِّ عَلى بَردِيَّةِ الطافي",70,"ف",2,0],["إِذا أودع الطاقاتِ بَينَ حُروفِهِ","تَأَلَّفنَ تَأليفَ الجُمانِ المُنَظَّمِ",71,"م",1,0],["إِذا أَودى مُعاوِيَةُ بِنُ حَربٍ","فَبَشَر شَعبَ قَعبِكَ بِانِصداعِ",72,"ع",1,0],["إِذا أُودِعتُ سِرّاً ماتَ عِندي","وساد عَلى تحرّكه السكونُ",73,"ن",1,0],["إذا أوجبت أحشاءها وطأة العدى","علا ندبها لكن على غوثها الندب",74,"ب",1,0],["اذا أوعدت حيا يكاد وعيدها","إذا ما هوى بطشا له العفو يخلف",75,"ف",1,0],["إذا أوردوا في محفل الذكر سنة","رأيت سناها رافعاً لك برقعا",76,"ع",2,0],["إذا أوتيتَها عفواً فخُذها","ولا تَسَلِ المبايعَ ما أرادا",77,"د",2,1],["إذا أودعوا النعماء لم يشكروا لها","وإن رمت نفعاً منهم أبداً اضروا",78,"ر",3,0],["إذا أوجب الإسلام ستر محاسني","فليس أمان الله بعلي مسلما",79,"م",2,0],["إذا أوهمتك قربا","فذاك الدنو بعد",80,"د",1,0],["إِذا أَوحَتِ اليُمنى إِلَيهِ وَوَسوَسَت","أَبانَت لَهُ اليُسرى بِماذا توسوسُ",81,"س",1,0],["إذا أودعت أردافَها ثني مِنطقٍ","تفتَّقَ تمزيق الجهامِ المعبّقِ",82,"ق",1,0],["إذا أوْعدَ الهِجْرانَ وَفَّى وَعِيدَهُ","وإن وعَد المُشْتاقَ فَهُوَ يُمَازِحُهْ",83,"ح",2,0],["إذا أوردتها صدرت رواء","وخلت هام وهي هيم",84,"م",1,0],["اذا اودى الذميل بها كلالاً","يعللها براحتها الرسيم",85,"م",1,0],["إذا أودعت قلبي لهيباً وحرقة","ففي كبدي حر وفي مقلتي سهد",86,"د",1,0],["إذا أوقدتْ ناراً بقذف الحصى حكت","وبحر الدُّجى طام سفيناً رمت نقطا",87,"ط",2,0],["إذا أَوترتَها ورميتَ عنها","بهذا فالقُلوبُ هيَ الرَّمايا",88,"ا",3,0],["اذا اوهمت ان بهم قمينا","بخير عاد من امم قمينا",89,"ن",2,0],["إذا أومت العليا بكفٍ له انثنت","إليه عيونُ الأكرمين الطوامح",90,"ح",1,0],["إذا أوترن ثم رمين سهمًا","فما يغني التحصن بالدروع",91,"ع",1,0],["إذا أوجه الفتيان غارت مياهها","فوجه علي ماؤه غير غائر",92,"ر",1,0],["اذا أومضت عيناك لاح لمقلتي","ضياء منير صفحة البدر",93,"ر",1,1],["إذا أوغلتَ في روحي تجدْني","دموعاً لا تملُّ منَ الدموعِ",94,"ع",1,1],["إذا أودعْتَها قلباً تقيّاً","لطابتْ مثلما طابَ المُقامُ",95,"م",1,0],["[ إِذا أَوْعَدُوكَ البَيْنَ هَزْلاً فَلا نَرَى","هُنالِكَ إِلاَّ أَنَّ هَزْلَهُمُ جِدُّ ]",96,"د",1,0],["إذا أوهن الأحزاب خلف أفرزت","فيها ضغائنه سموم صلال",97,"ل",1,0],["إذا أوكلتُ أمري للإلهِ","ودينهِ هل ألوذ من الدواهي؟؟",98,"ا",3,1],["إذا أوفى لآمالي فإني","ربحْتُ المجدَ والرزاقُ يُغْني",99,"ن",2,0],["إذا أوهنتك جبالُ العُلا","تخيّل ( بِلالاً )، تذّكر ( عُمرْ",100,"ر",1,0],["إِذَا أَوْدَعَ الإِنْسَانُ شَخْصَاً يحِبُّهُ","بِقَبْرٍ فَقَبْرُ الخِلِّ ذَاكَ حَبِيْبُهُ",101,"ب",2,1],["إذا أوْمضَتْ شمسٌ، ولاحتْ كواكبٌ","وتاهَ الصبيُّ.. واستنفَدَ الأمرُ والقدْرُ",102,"ر",1,0],["إذا أوسَعوها نَقْمةً في جنانها","مضَوْا في حِماها، فاستزادوا نَماءها",103,"ا",3,0],["إذا أومضَ البرقُ من أرضِهَا","يُمَثَّلُ لي أنَّها تبسمُ",104,"م",1,1]]}