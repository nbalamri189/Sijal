{"poems":[[90,"صاح إن الخطوب في غليان","https://www.aldiwan.net/poem44456.html","الخفيف"],[12,"إن بالشعب الذي دون سلع","https://www.aldiwan.net/poem1231.html",""],[47,"ما تقضى لبانة عند لبنى","https://www.aldiwan.net/poem66658.html","الخفيف"],[60,"كل ماض كأن لم يكن","https://www.aldiwan.net/poem31087.html","الطويل"],[99,"بي نزوع إلى الدموع الهوامي","https://www.aldiwan.net/poem24764.html","الخفيف"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39673","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54889","الخفيف"],[112,"انكساري","https://www.poetsgate.com/ViewPoem.aspx?id=34733",""],[406,"أيها الغائب","https://www.aldiwan.net/poem6734.html","عموديه"],[408,"كيف يرضيك على الضيم المقام","https://www.aldiwan.net/poem46920.html","الرمل"],[422,"لهذي النوق تنحط كلالا","https://www.aldiwan.net/poem54004.html","الرمل"],[438,"طار عن برقة برق فشم","https://www.aldiwan.net/poem12350.html","الرمل"],[463,"من عذيري يوم شرقي الحمى","https://www.aldiwan.net/poem56251.html","الرمل"],[469,"عاد من عيد وصله ما تولى","https://www.aldiwan.net/poem3155.html","عموديه"],[505,"أطلق الصب في الهوى تقييده","https://www.aldiwan.net/poem37687.html","الخفيف"],[520,"سقم الحاظ الحسان الخرد","https://www.aldiwan.net/poem12081.html","الرمل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122738","الرمل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59533","الخفيف"],[1071,"","https://poetry.dctabudhabi.ae/diwan/poem/203794","الخفيف"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56648","الخفيف"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49578","الخفيف"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66319","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27148","الرمل"],[349,"","https://poetry.dctabudhabi.ae/diwan/poem/205426","الخفيف"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112385","الرمل"],[4190,"","https://poetry.dctabudhabi.ae/diwan/poem/105129","الخفيف"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33063","المديد"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73091","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139707",""],[3271,"راهب الغرب","https://www.poetsgate.com/ViewPoem.aspx?id=103195",""],[5074,"الضَّيغم الجريح","https://www.poetsgate.com/ViewPoem.aspx?id=153941",""],[5444,"غَزَّةٌ ... وَصَمْتُ المنَارة","https://www.poetsgate.com/ViewPoem.aspx?id=205078",""],[5532,"ولد عمّي !","https://www.poetsgate.com/ViewPoem.aspx?id=34633",""],[402,"سنحت فرصة لقالة حق","https://www.poetsgate.com/ViewPoem.aspx?id=35703",""],[469,"جزتَ في المجد والفعال الشريفِ","https://www.poetsgate.com/ViewPoem.aspx?id=76859",""],[5997,"كهف العبيد","https://www.poetsgate.com/ViewPoem.aspx?id=214282",""],[5997,"كهف العبيد","https://www.poetsgate.com/ViewPoem.aspx?id=215046",""],[469,"عاد من عيد وصله ما تولى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=574792",""],[6237,"عودة إلى الطبيعة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77860&r=&rc=2",""],[6299,"إنَّ بالشَّعبِ الذي دونَ سلعٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19694&r=&rc=19",""]],"verses":[["كل ما ضمّ ملكه كلماتٌ","وإليه انتهت جميع المعاني",0,"ن",2,0],["كُلُّ ماضٍ قَد تَرَدَّى بماضٍ","كَسَنا البَرقِ إِذا ما يُسَلُّ",1,"ل",1,0],["كُلُّ ماضٍ أَنساهُ غَيرَ لَيالٍ","ماضِياتٍ لَنا بِبارى وَبِنّا",2,"ن",2,0],["كُلُّ ماضٍ كَأَن لَم يَكُن","كُلُّ آتٍ فَكَأَن قَدِ",3,"د",1,1],["كل ماضي صبابة قد أخذتن","فمن مدمع ومن حسرات",4,"ت",1,0],["كلّما ضجّ تحتهنّ تنزّى","جرحُه الخالدُ السخين الدماء",5,"ا",2,0],["كلُّ مَاضِيك شَاهِدٌ لك عَدْلٌ","بِالَّذِي كُنْتَ فِي جِسَامِ الأُمْورِ",6,"ر",1,0],["كل ماضاقت بعيني .. يا معيني","أبتسمت وصار لي ليلي نهاري",7,"ر",2,0],["كلما ضجت من السير رحال","هيأ القلب من العزم رحالا",8,"ل",2,0],["كلّ ماضي القلب فردُ حولَهُ","في الوغى من بأسِه جيشٌ لُهامُ",9,"م",1,0],["كلَّما ضِقْتُ به ذَرعاً أرى","يوسع الفضلَ على الفكر مجالا",10,"ل",2,0],["كلما ضَلَّ جَرَتْ أدْمُعُهُ","في حواشِي وَجَنَاتِ الأَكَمِ",11,"م",1,0],["كلّما ضاقت يدُ الغيثِ بما","مَلكتْ جاودها مُنفَسِحا",12,"ح",2,0],["كلَّما ضمَّنا محلُّ عتابٍ","بتُ أبكي ذلاً وتضحكُ دلاّ",13,"ل",2,0],["كلُّ ماضٍ من الوجود وآتٍ","مستفيضٌ منه الأيادي السعيده",14,"د",2,0],["كلما ضل الهوى في فرعها","فعلى برق الثنايا يهتدي",15,"د",2,0],["كُلَّما ضَمَّنتُ شِعري مَثلاً","نَوَّهُوا عَنّي بِذاك المَثَلِ",16,"ل",1,0],["كلما ضلًّ عاذلي فيك قصداً","فعليَّ التماسُ نهج الصواب",17,"ب",1,0],["كلما ضجَّ، أو تساءل ركبٌ","عن مصير، تنمرّ الأجراءُ",18,"ا",2,0],["كلما ضاقت القلوب بسر","فجرت منه في العيون عيونا",19,"ن",2,0],["كلُّ ماضي الشَّبَا يعوِّدكَ القَتْ","لَ وإن لم تُعِدَّه للقتال",20,"ل",1,0],["كلما ضمّت العوالم قدماً","ما أهاجت أمينة لاجتلاها",21,"ا",3,0],["كُلَّما ضَنَّت تَباريحُ الهَوى","فَضَحَ الدَمعُ الجَوى وَالأَرَقا",22,"ق",2,0],["كل ماض من الأسى نسيته الن","نفس من ذلك الزمان الكريم",23,"م",1,0],["كلّما ضاءَ محَيّاكَ البديع","هَبّتِ الأرضُ تباهي الكوكبَا",24,"ب",2,0],["كلما ضلت العتاق هداها","بنسيم الصبا عبير العراق",25,"ق",1,0],["كُلُّ ماضٍ قَد تَرَدّى بِماضٍ","كَسَنى البَرقِ إِذا ما يُسَلُّ",26,"ل",1,0],["كُلَّما ضلَّ عن طريقِ جَفاهُ","ظلَّ فيهِ مِنَ الدَّلالِ دليلا",27,"ل",2,0],["كلما ضاقت الثرى في علاه","جودُه كالثنا غدا باتساع",28,"ع",1,0],["كلّما ضجّ منهمُ قلب حرٍّ","أترع الكأس من دماهُ عُقارا",29,"ر",2,0],["كلَّما ضُمَّ في ثَرَاكِ شَهِيْدٌ","أَسْكَنَتْهُ في صَدْرِهَا العَلْيَاءُ",30,"ا",2,0],["كلَّما ضاقَ في دروبِك بابٌ","ضَاقَ بالروحِ طولُ صَمتِ المنارة",31,"ر",2,0],["كلما ضاق اللي فيني \" ابتسمت \" وقلت ليت","آه .. ليته ثالث اسمك اسم جدي ..!",32,"ي",1,1],["كل ماضيك شاهد لك عد","بالذي كنت في جسام الأمور",33,"ر",1,0],["كلُّ ماضي الشبا نخيفٍ وامضى الب","يضِ يومَ الضّراب كلُّ نخيف",34,"ف",1,0],["كلَّ ماضي قد سباها حطة","كلّ صبٍّ في محبتها شهيد",35,"د",1,0],["كلَّ ماضٍ قد سباها حطة","كلّ صبٍّ في صبابتها شهيد",36,"د",1,0],["كلَّما ضمَّنا محلُّ عتابٍ","بِتُّ أبكي ذُلاًّ ويضحك دَلاّ",37,"ل",2,0],["كلما ضمني دجاكِ ورقّتْ","نفحاتُ الصبا على الأدواحِ",38,"ح",1,0],["كلُّ ماضٍ قدْ تردَّى بماضٍ","كسنا البرقِ إذا ما يسيلُّ",39,"ل",1,0]]}