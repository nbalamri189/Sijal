{"poems":[[55,"أداري المقلتين عن ابن ليلى","https://www.aldiwan.net/poem30660.html","الوافر"],[93,"أقاح ذاك أم شنب وريق ذاك أم ضرب","https://www.aldiwan.net/poem8741.html","عموديه"],[47,"مرنت مسامعه على التفنيد","https://www.aldiwan.net/poem63544.html","الكامل"],[33,"لم يقض ذو الشجو ممن شفه أربا","https://www.aldiwan.net/poem42634.html","البسيط"],[107,"أقبل نعيم هداك ربك ساريا","https://www.aldiwan.net/poem44192.html","الكامل"],[107,"ما للسيوف أما تثوب فتعطف","https://www.aldiwan.net/poem44198.html","الكامل"],[77,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39586","الخفيف"],[3,"","https://poetry.dctabudhabi.ae/diwan/poem/9921","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42696","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[32,"","https://poetry.dctabudhabi.ae/diwan/poem/12321","الطويل"],[113,"لعمرك ما الدنيا العريضة بالدنيا","https://www.aldiwan.net/poem16188.html","الطويل"],[147,"هل بعد فتحك ذا لباغ مطمع","https://www.aldiwan.net/poem11774.html","الكامل"],[214,"بدت فأنارت من سناها المطالع","https://www.aldiwan.net/poem13382.html","الطويل"],[240,"ألفجر ليلك بالبنية مطلع","https://www.aldiwan.net/poem31891.html","الكامل"],[264,"نهارا تجلى الحق في ليلة السبت","https://www.aldiwan.net/poem35961.html","الطويل"],[287,"أما كفاني طرف منك نبال","https://www.aldiwan.net/poem32665.html","البسيط"],[369,"سبى مني الفؤاد لحاظ فاتن","https://www.aldiwan.net/poem60611.html","الوافر"],[385,"قلب يحبك مولع","https://www.aldiwan.net/poem48747.html","مجزوء الكامل"],[498,"أتاهم بألحاظ الجياد ولم يكن","https://www.aldiwan.net/poem67398.html","الطويل"],[519,"أتنكر بأس أحداق العذارى","https://www.aldiwan.net/poem20826.html","الوافر"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122691","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77557","الرجز"],[995,"","https://poetry.dctabudhabi.ae/diwan/poem/96294","المتقارب"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133811","الرجز"],[226,"","https://poetry.dctabudhabi.ae/diwan/poem/121457","الرمل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84510","الرجز"],[1376,"","https://poetry.dctabudhabi.ae/diwan/poem/118092","البسيط"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95581","البسيط"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/49092","السريع"],[1563,"","https://poetry.dctabudhabi.ae/diwan/poem/203659","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108502","الكامل"],[1681,"","https://poetry.dctabudhabi.ae/diwan/poem/146780","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93642","الكامل"],[2670,"","https://poetry.dctabudhabi.ae/diwan/poem/100882","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100274","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201733","الكامل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112667","الرجز"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62938","السريع"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216627","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131258",""],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86403","المتقارب"],[4540,"","https://poetry.dctabudhabi.ae/diwan/poem/105185","الوافر"],[4902,"أموت من فرقاك","https://www.poetsgate.com/ViewPoem.aspx?id=6530",""],[5012,"كف شالت شموع","https://www.poetsgate.com/ViewPoem.aspx?id=22795",""],[5122,"لا تجرح المجروح","https://www.poetsgate.com/ViewPoem.aspx?id=17972",""],[5335,"الغرير","https://www.poetsgate.com/ViewPoem.aspx?id=35189",""],[5455,"سكة الذكرى الحزينه","https://www.poetsgate.com/ViewPoem.aspx?id=34467",""],[5461,"غربة الروح","https://www.poetsgate.com/ViewPoem.aspx?id=5065",""],[5461,"استطيع امنع لساني","https://www.poetsgate.com/ViewPoem.aspx?id=509",""],[5491,"أحبك فوق ما تتصور","https://www.poetsgate.com/ViewPoem.aspx?id=215087",""],[5553,"سرب الوضيحي","https://www.poetsgate.com/ViewPoem.aspx?id=185915",""],[5694,"غرامي","https://www.poetsgate.com/ViewPoem.aspx?id=132097",""],[5937,"لا يُجيدُ الكلام","https://www.poetsgate.com/ViewPoem.aspx?id=211809",""],[231,"ابتسامة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79151&r=&rc=25",""],[6243,"تَمْتَمَات","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84433&r=&rc=7",""]],"verses":[["مُرَنَّقَةَ العُيونِ كَأَنَّ فيها","دِهانَ مَواقِدٍ يَصِفُ الزَجاجا",0,"ج",2,0],["مُرَنَّحَةٌ إِذا خَطَرَت","رَأَيتَ الغُصنَ يَضطَرِبُ",1,"ب",1,0],["مَرَنَت مَسامِعُهُ عَلى التَفنيدِ","فَعَصى المَلامُ لِأَعيُنٍ وَخُدودِ",2,"د",1,1],["مُرَنَّحُ العَقلِ قَد مَلَّ الحَياةَ وَمَن","يَعلَق هَوى مِثلِها يَستَوجِبِ العَطَبا",3,"ب",2,0],["مُرْني بما أحببتَ في القومِ الأُلَى","كَرِهوا الرشادَ أكن لأمرِكَ واعيا",4,"ي",2,0],["مُرْنِي رسولَ اللَّهِ أكْفِكَ أمرَه","فلقد عَهدتُكَ راحماً تتلطّف",5,"ف",1,0],["مُرَنَّحاً من خُمار الحَتْفِ صَبَّحَهُ","وليسَ يخْفى مكانُ الشارِبِ الثمِل",6,"ل",1,0],["مرّ نورُ الضحى على آدميٍّ","مُطرقٍ في اختلاجةِ المصعوقِ",7,"ق",1,0],["مُرَنَّحَةُ الأَعطافِ مَهضومَةُ الحَشا","مُنَعَّمَةُ الأَطرافِ مائِسَةُ القَدِّ",8,"د",1,0],["مُرْنِي بِمَا شِئْتَ أَبْلُغْ كُلَّ مَا وَصَلَتْ","يَدِي إِلَيْهِ فَإِنِّي سَامِعٌ وَاعِي",9,"ع",2,0],["مَرِنَ الأَرْسَاغِ مِمْرَاحاً يُرَى","قَارِحاً أَوْ فَوْقَهُ إِنْ هوَ فرَّا",10,"ر",2,0],["مُرِنِّ الضُحى طاوٍ بَنى صَهَواتِهِ","رَوايا غَمامِ النَثرَةِ المُتَرادِفِ",11,"ف",1,0],["مرنحة الأَعطاف رَيمية الطَلا","فَما عَرفت قُلباً وَلا اِتَخَذت حليا",12,"ي",2,0],["مَرَنَت عَلى خَطمِ المَوارِنِ عِندَما","رَأَتِ الخَناجِرَ في خِلافِكَ تُجدَعُ",13,"ع",1,0],["مرنحة الاعطاف بين وشاحها","قضيب عليه صادح الحلي ساجع",14,"ع",1,0],["مَرَنوا عَلى حُبِّ النِفاقِ فَكُلُّهُم","عَذبُ المُجاجَةِ وَهُوَ سُمٌّ مِنقِعُ",15,"ع",1,0],["مرنّحة الأغصان هبّ بها الصبا","مفتحة الأزهار في الغرس والنبت",16,"ت",1,0],["مُرَنَّحٌ خَوطُ بانٍ في كَثيبِ نَقاً","يَهُزُّهُ الحُسنُ تيهاً فَهوَ مَيّالُ",17,"ل",1,0],["مَرنْتُ على عَدُوِّكمُ إلى أنْ","قَدِمْتُ برَغْمِ هاتيكَ المَوارن",18,"ن",1,0],["مَرني بِما تَهواهُ يا","سَكني أَطيعُ وَأَسمَع",19,"ع",1,0],["مَرنٌ عَلى لَدعِ القَنا فَكَأَنَّما","عَلَيهِنَّ مِن صَبغِ الدِماءِ مَجاسِدُ",20,"د",1,0],["مرنّحةٌ معاطفُهم صُحاةٌ","تكادُ عُيونُهم تجري عُقارا",21,"ر",2,0],["مُرَنَّحاتٌ كُلَّما تَرَنَّحت","بِالرَّملِ باناتٌ عَلَيهِ رُوق",22,"ق",1,0],["مُرنا بِصُنع مثل ذي الخَليه","نَحنُ مَع الذُباب في البَريَّه",23,"ه",1,0],["مُرِنٌّ يُحاذرُ رَوعاتِهِ","سَماحيجُ مثلُ القَنا شُزّبُ",24,"ب",1,0],["مرنّح الأعطافِ مرناناً","على صدر النسم",25,"م",1,0],["مرن النفس على حمل الأذى","وأراها كيف ظلم الأبرياء",26,"ا",2,0],["مرنوقة لمشبه تمثلا","النشر مسك والوجوه في أنجلا",27,"ل",2,0],["مرنح العطف لدن القد معتدلٌ","لا زيغ في متهه يلقى ولا أودا",28,"د",2,0],["مرنا فنحن أرقاء ذوو شمم","ولن نعق نداء منك يا نيلُ",29,"ل",1,0],["مُرنِّحُ الفُصحى بآياتِه","ونافحٌ بالطيبِ روضَ الحقوقْ",30,"ق",1,0],["مُرنّحة الأعطاف تلعب بالنهى","فتسبى الحجا طوراً وطوراً تردُّه",31,"د",2,0],["مرني فأجهر بالغرام وأجتني","ثمر الرضى بأنامل الضوضاء",32,"ا",2,0],["مرّن النفس للقناعة كرهاً","اي مال يفي بذل سؤاله",33,"ه",1,0],["مرنا فأمرك في العراق مطاع","أَنتَ الزَعيم وَكُلُنا أَتباع",34,"ع",1,1],["مُرنى على الفقر أُخرج عنك نافلةً","من الزكاة وهبها من جناياتى",35,"ت",2,0],["مرنَّحٌ مرحٌ متسعذبٌ عذبٌ","مخصَّر ناعم الأطراف أملود",36,"د",1,0],["مرِّنْ جناحك في فنائي طائراً","ثم انطلق لتطير دون عثار",37,"ر",1,0],["مُرنا بما تشاءُ لَسنا نَرغَبُ","عنكَ ولا مولى سواك نطلُبُ",38,"ب",1,0],["مُرَّنَّقُ الطير على ضَربها","يكاد يدنو من يدِ النَّابِلِ",39,"ل",1,0],["مرّنح العطف من سكر بلا طرب","هذا لعمرك سكر يورث الخَبلا",40,"ل",2,0],["مرنت على الإرجاف أي مرانةٍ","وعلى النميمة وكدت أيمانها",41,"ن",3,0],["مرنحة أعطافها فكأنما","يزر على خوط الأراك رداؤها",42,"ه",2,0],["مرنحة المعاطف قد دعتني","أكابد في الهوى داء عضالا",43,"ل",2,0],["مرن تجيني لين أقول إني إياك","ومرن تروح بعيد وأنسى أوانك",44,"ك",1,0],["مرني في عيونك كل كلمة هلا","الظما في عيوني وانت وصلك شحيح",45,"ح",1,0],["مر(ن)،تقول أحب ، مر(ن)،تجافيه","وتغير الجو اللطيف أبعجاجا",46,"ج",2,0],["مرني تلعب ايام الصبا في عنانه","غض الاشواق وعيونه عيون الهواوي",47,"ا",3,0],["مرّني طيفك .. وطيفك صاحبي مدري عدوّي","جايبٍ صوتك .. وصوتك سكة الذكرى الحزينة",48,"ن",2,1],["مر(ن) على الهيّن ومر(ن) على الكود","وعمر الفتى لحظات هيّن وكايد",49,"د",1,0],["مرني طيفك على العادة عجول","عز طيفك مثلما عز الكرى",50,"ر",2,0],["مُرني بحبك فهو معروف الهوى","وسواه في دين المحبة مُنكَرُ",51,"ر",1,0],["مرن وعدن مثقلاتن مراديف","مشى المزون ومشيهن عا مهلهن",52,"ن",1,0],["مرني من عطرك العابر طيوف","أنتي عن كل الخلايق فيك نوف",53,"ف",1,0],["مرَّ نهر العروبةِ العذب ،،،،، رشفاً","فامتلا حلقه لظىً وصديدا !",54,"د",2,0],["مرنحة الأعطاف تومض خلسة","وتخطر في رفق بذيالك الفم",55,"م",1,0],["مَرَّنْت أسْئِلة الهُيَام جَميعَهَا","فَبَدَا عبيرُ العِشْقِ فَوْقِي زاخِرَ ا",56,"ر",2,0]]}