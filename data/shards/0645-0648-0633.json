modules.php?name=Sh3er&doWhat=shqas&qid=73058&r=&rc=15",""],[5080,"حتّام ترثي نخيلا في العناوينِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=88135&r=&rc=5",""],[406,"حوار في ساحة المطاف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=847&r=&rc=38",""],[463,"ألطيمة ٌ حبستْ بكاظمة ٍ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60221&r=&rc=277",""],[463,"أولى لها أن يرعوي نفارها","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60088&r=&rc=144",""],[6358,"دخان الخرائط","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77584&r=&rc=43",""]],"verses":[["مَوسومَةً بِالهَوى يُدرى بِرُؤيَتِها","أَنَّ المَطايا مَطايا مُضمِري شَجَنِ",0,"ن",1,0],["مُؤَسَّسَةٌ وَهَبَتْ دَارَهَا","لَهَا بَارَكَ اللهُ فِي الوَاهِبِينْ",1,"ن",1,0],["موسى هوَ الآن العزيز وعامنا","عام الرَّجا فيه يُغاث الناس",2,"س",1,0],["موسم الورد أخذنا عطره","وتركنا فيه غصنا لينا",3,"ن",2,0],["موسى ببابكِ فِي المكارم والعلا","وعَصاه فِي سحر البيانِ عَصاكِ",4,"ك",1,0],["موسى عَدُوُّ الرِقِّ حَولَ لِوائِكُم","لا الظُلمُ يُرهِبُهُ وَلا طاغوتُهُ",5,"ت",2,0],["موسى وَعيسى نَشَآ بَينَهُم","في سَعَةِ الفِكرِ وَفي رُحبِهِ",6,"ب",2,0],["موسِرٌ مِن خَلائِقٍ تَتَراءى","مِن ضُروبِ الرَبيعِ أَو أَشكالِه",7,"ل",2,0],["مُوَسِّداً فَوقَ نَصلِ السَيفِ تَحسِبُهُ","مُستَلقِياً فَوقَ شاطي جَدوَلٍ ثَمِلا",8,"ل",2,0],["مَوسومَةٌ بِالحُسنِ ذاتُ حَواسِدٍ","إِنَّ الحِسانَ مَظِنَّةٌ لِلحُسَّدِ",9,"د",1,0],["موسى على أسفٍ وعيسى ناقمٌ","ومحمدٌ جَهْمُ المُحيَّا شاحبُ",10,"ب",1,0],["مُوسى أخوكَ أُصيبَ من أعدائهِ","بأشَدِّ ما تَرمِي قُوَى الأعداءِ",11,"ا",2,0],["مُوسَى تَرَفَّق وَلاَ تُضِعنِي","في الرّق عَبدُكَ بَعضُ مَالِك",12,"ك",1,1],["موسى حَوَيتَ الجَمالا","وَعِفَّةً في طِباعِك",13,"ك",1,0],["موسى تَنَبَّأَ بِالجَمالِ وَإِنَّما","هاروتُ لا هارونُ مِن أَنصارِهِ",14,"ر",2,0],["موسى تَصَدَّق عَلى مِسكينِ حُبِّكَ لا","تَرُدَّ كَفّي فَكَم باتَت عَلى كَبِدي",15,"د",2,0],["موسى كليم الإله عنّ لهُ","عارضُ حبٍّ عراهُ عن رحلِه",16,"ل",2,0],["موسى بَعَثتِ لِكُلِّ حَيٍّ مُعضَباً","فَقَضى عَلَيهِ مُعَجَّلاً موكوُزا",17,"ز",2,0],["مُوسى الأَغرَّ من بني حُدَيرِ","عَقيدَ كُلِّ رأفةٍ وخَيرِ",18,"ر",1,0],["موسُليني أين أنت اليوم أينْ","حُلُمٌ أم قصَّةٌ أم بينَ بينْ",19,"ن",1,0],["موسُليني قِفْ على أبوابِ رُوما","وتأمَّلْها طُلولاً ورسوما",19,"م",2,0],["موسُليني لسْتَ من أمسٍ بعيدا","فاذكرِ المختارَ والشعْبَ الشهيدا",19,"د",2,0],["موسُليني خُذْ بكفيَّكَ الحديدا","وصُغِ القيدَ لساقيْكَ عَتيدا",19,"د",2,0],["موسى الكليم استؤجر استئجارا","وكان عيسى في الصبا نجارا",20,"ر",2,0],["مُوسَى وَعِيسَى بَعْدَهُ وَمُحَمَّدٌ","فَرُّوا مِنَ الظُّلاَّمِ أَيَّ فِرارِ",21,"ر",1,0],["مُؤَسَّسَاتُكِ لَوْ عُدَّتْ وَلَوْ وُصِفَتْ","لَمَا انْتَهَى عَجَبٌ إِلاَّ إِلَى عَجَبِ",22,"ب",1,0],["مُوسَى لَقدْ كَمُلَ النِّظَا","مُ وَأَنْتَ فِيهِ فَرَاعَ عِقْدَا",23,"د",2,0],["موسى وعيسى به لاذ وآدم مذ","به استجار نجا من أتم عصيان",24,"ن",1,0],["مُوَسَّمَة الأَعضادِ أَو قَصَراتِها","مُخَيَّسَةٌ بَينَ السديسِ وَبازِلِ",25,"ل",1,0],["مَوسومَةً بِالنَصرِ لَم تَرَ قَبلَها","عَينٌ رِئالاً يَحتَمِلنَ رِجالا",26,"ل",2,0],["موسى هزبرٌ لا يطاق نواله","في الحرب لكنْ أين موسى من حسن",27,"ن",1,0],["موسر وعده عسير وصال","فأنا منه قانع بالسير",28,"ر",1,0],["مَوسِماً لِلَّهوِ ما أَس","رَعَ ما كانَ اِنقِضاءا",29,"ا",3,0],["موسى وعيسى والخليل جميعهم","فتصافح الأحفاد والأجداد",30,"د",1,0],["مُوَسَّخَ الثوبِ والصحيفةِ من","طول اكتسابي ذَنباً بلا كَسبِ",31,"ب",1,0],["موسيقاكَ تَصْخَبُ","هل بكتْ أغنيةٌ في كاحليكَ",32,"ك",1,0],["موسى هُوَ البَحرُ الخِضَم","لَم يَظمَ مَن يَمَّمَ يَم",33,"م",1,0],["موسى لديهم كاذب ومخادع","والسامريّ مصدّق الأنباء",34,"ا",2,0],["موسومة بالبُعد تحسب سهلها","ألقى السماءُ بحوله أطنابا",35,"ب",2,1],["موسى أزال بفَصْحِه عن قومه","أسراً تُخَصُّ بمصره البُلدان",36,"ن",1,0],["موسى أحق بطاعة الرحمن إذ","صار الضمير لربه مجمولا",37,"ل",2,0],["موسى وَهارونَ هُما اللَذانِ","في كُتُبِ الأَخبارِ يوجَدانِ",38,"ن",1,1],["موسى وعيسى أرسلا لمحمد","ومحمد بالنصر والتأييد",39,"د",1,0],["مؤسّس الدولة المرهوب جانبها","ومن شأت قمة الدنيا مبانيها",40,"ي",3,1],["موسمة بعمرو أو ببكر","تصرِّح تارة بهمُ وتَكْني",41,"ن",2,0],["موسومة بكُمُ غرائبُ