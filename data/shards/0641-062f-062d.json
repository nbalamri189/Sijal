{"poems":[[95,"أي رزء دهاك يا سمعان","https://www.aldiwan.net/poem11258.html","الخفيف"],[95,"عزمات نحاس إذا جاورتها","https://www.aldiwan.net/poem11354.html","الكامل"],[95,"دال السكون من الحراك الدائم","https://www.aldiwan.net/poem11373.html","الكامل"],[107,"هتف النعي فما ملكت بياني","https://www.aldiwan.net/poem42093.html","الكامل"],[107,"عندي إذا صرع الجنوب سبات","https://www.aldiwan.net/poem42095.html","الكامل"],[107,"لبيك من حر المواقف عال","https://www.aldiwan.net/poem43058.html","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54915","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54761","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54542","الخفيف"],[409,"تحفة تهدى لمن يهوى عليا","https://www.aldiwan.net/poem33355.html","الرمل"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138209",""],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88647","الكامل"],[2404,"","https://poetry.dctabudhabi.ae/diwan/poem/32599","الوافر"],[3206,"","https://poetry.dctabudhabi.ae/diwan/poem/145871","الرمل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111408","الخفيف"]],"verses":[["فَدَحَ الأَمْرُ فِي الفَتَى البَاسِطِ الكَفِّ","وَفِي العَفِّ قَلْبُهُ وَاللِّسَانُ",0,"ن",1,0],["فَدْحُ الَّذِي حُمِّلْتُمُ فَحَمَلْتُمُ","إِنَّ العِظَامَ بِبَعْضِ ذَاكَ عِظَامُ",1,"م",1,0],["فَدَحَ المُصَابُ وَقَدْ أَلَمَّ بِقَسْوَرٍ","وَردٍ ذَكِيِّ الطَّرْفِ أَرْوَعَ باسمِ",2,"م",1,0],["فَدحَ المصابُ فلا البكاءُ أراحَني","مّما لَقيتُ ولا الرِّثاءُ شفاني",3,"ن",2,0],["فَدَحَتْ تكاليفُ الحياةِ وبَرَّحت","بالقومِ منهم سادةٌ وسَرَاةُ",4,"ه",1,0],["فَدَحَ الذي بين الجوانحِ فانظري","أدبيبُ حُبٍّ أم دبيبُ سُلالِ",5,"ل",1,0],["فدحَ المُصَابُ بِه فَمَا مِنْ مُقْلَةٍ","إِلاَّ بَكَتْهُ بِمَدْمَعٍ مِدْرَارِ",6,"ر",1,0],["فَدَحَ المُصَابُ وَلاَ اعْتِراضَ فَإِنَّهُ","حُكْمُ القَدِيرِ وَهَلْ لَنَا فِيهِ يَدُ",7,"د",1,0],["فَدَحَ الْخَطْبُ يَا عَفِيفَةُ في هِجْ","رَانِكِ الأَقْرِبَاءَ وَالأًوْلِيَاءَ",8,"ا",2,0],["فدحى الباب وأردى مُرْحِباً","بعد أن صارع فيها قَسْوَرِيَّا",9,"ي",2,0],["فدحت رزيئتها ولكن الرجا","إن الإله جزيل أجر واهب",10,"ب",1,0],["فدحتك من إحدى الكبائر","بمقلة عدد الأكابر",11,"ر",1,1],["فدحرجها بنادق وازدردها","متى رمت التكلم أي زرد",12,"د",1,0],["فدح الخطب فيا كرب الثكالى","قد سقين اليوم أتراح الأنام",13,"م",1,0],["فَدَحَ الأَمرُ إِن تَكُونا لأَجلِ الن","اسِ بالأَرضِ تُنشِبانِ القِتالا",14,"ل",2,0]]}