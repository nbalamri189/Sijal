85,"","https://poetry.dctabudhabi.ae/diwan/poem/198824","السريع"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105067","السريع"],[2914,"","https://poetry.dctabudhabi.ae/diwan/poem/9608","البسيط"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81295","الرجز"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[5701,"لاحت على الشاطئ بستانا","https://www.poetsgate.com/ViewPoem.aspx?id=164672",""],[5976,"يا بو سعد ..","https://www.poetsgate.com/ViewPoem.aspx?id=35084",""],[5992,"انظر إلى شِقْشِقَةِ الفَحْلِ إذْ","https://www.poetsgate.com/ViewPoem.aspx?id=41818",""],[6318,"لآلئ الشِّعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66159&r=&rc=9",""],[5126,"فكرة مُختلطة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87818&r=&rc=33",""]],"verses":[["كَأَنَّهُ يَنظُرُ مُستَوجِساً","رُبَيئَةً قامَ عَلى مَخرِمِ",0,"م",1,0],["كَأَنَّهُ يَومَ يَأَتيهِ رَسولُكُمُ","قَد نالَ مُلكَ سُلَيمانَ بنِ داوُدِ",1,"د",1,0],["كَأَنَّهُ يَومَ الرِهانِ المُحتَضِر","طاوٍ غَدا يَنفُضُ صيبانَ المَطَر",2,"ر",1,0],["كَأَنَّهُ يَتَّقي الحَيّاتِ فاغِرَةً","لا بَل كَأَنّي عَنِ المَعروفِ مَجدودُ",3,"د",1,0],["كَأَنَّهُ يقْتُلُني بِأَمْري","آلَيْتُ لا أَمْلِكُ عنهُ صَبري",4,"ر",2,0],["كأنه يفتح الفواقعَ دا","راتٍ على راكدٍ من الغُدُر",5,"ر",1,0],["كأنه يقصِد ذاك الذي","يفعل مختارا لكَيْدٍ وشَرّْ",6,"ر",1,0],["كأنّهُ يوم يرتجُّ الوغى شهبٌ","تساقطَ الجو منها يرجمُ البشرا",7,"ر",2,0],["كَأَنَّه يومُ صَفاءٍ سَنَح","فَقالَ يا قَلبي الى الجَلجَله",8,"ه",1,0],["كَأَنَّهُ يَمزُجُ بِال","فِضَّةِ فيها ذَهَبا",9,"ب",2,0],["كأَنَّه يُوسفٌ في السِجن مُضطَهداً","وكُلُّ ذي خِلَّة في الحيِّ يَعقوبُ",10,"ب",1,0],["كأنَّه يعلّم أن الحذَرا","ليس يُنجِي المرءَ ممّا قَدرا",11,"ر",2,0],["كأنه يومَ بَرَّ أقسم لا","يكون فيه لفاضلٍ قِسْمُ",12,"م",1,0],["كأنه يبسط من","عنانها وما قبضْ",13,"ض",1,0],["كأنه يجلو ثنايا بالغضا","رُوقاً وينهلُّ لَمىً أو شَنبَا",14,"ب",2,0],["كأنَّ هَيْقاً أبا رِئالٍ","آنَسَ بالدَّوِّ خيْلَ جُنْدِ",15,"د",1,0],["كأنه يوم عيد كارعون به","كاس التهاني ومالت بالنهى النغم",16,"م",1,0],["كأنَّهُ يُبدي لِلأَنامِ تَنَدُّماً","وهل لمناتين الضمير تندم",17,"م",1,0],["كأنّه يخفق ريحٌ على","رابيةٍ تلعب بالمِطْرَدِ",18,"د",1,0],["كَأَنَّهُ يَزْدَجِرْدُ مُنْتَصِبَاً","يَبْنِي فَيُعْلِي مَآثِرَ العَجَمِ",19,"م",1,0],["كأنه يدعو فلما استقبلة","قرّب من مجلسه ووصلة",20,"ه",1,0],["كأنه يطلب منهم ثارا","وقال أنا أشبه العذار",21,"ر",1,0],["كأنه يعذل في جوده","مبارك الطلعة بن الصباحْ",22,"ح",1,0],["كأَنَّ هَيدَبةً من فوقِ جُؤجئها","أَو جِرو حَنظَلَةٍ لم يعدُ راميها",23,"ي",3,0],["كانه يوَلّفْ بين الاحباب","يرصد زحل لاجل التّسابيب",24,"ب",1,0],["كأنه يجلس من ذا وذا","بين كنيفين من النتن",25,"ن",1,0],["كأنه يروي شذا الطيب عن","عرس ابن خير الأنس والجان",26,"ن",1,0],["كَأَنَّهُ يَرفَئِيٌّ نامَ عَن غَنَمٍ","مُستَنفَرٍ في سَوادِ اللَيلِ مَذؤوبِ",27,"ب",1,0],["كَأَنَّهُ يَصرَخ إِن المَ","وت بِالشَمس عَلق",28,"ق",1,0],["كأنَّهُ يأمُرُ كُلَّ مُهجَةٍ","بالشُكرِ لِلّهِ عَلى ما قد حبا",29,"ا",1,0],["كأنه يتلو أناجيله","أو أنه يقرأ قرآنا",30,"ن",2,0],["كانه يحبّ الرّدى .. ويْخالف اهل الراي ..","الخالدي ما يماشي واحد فْسربه",31,"ب",2,0],["كأنَّهُ ينفخُ في قِرْبَةٍ","ويُمطِرُ الثلجَ مع الرَّعْدِ",32,"د",1,0],["كَأنَّه يَهَبُ الأَحْداثَ خَفْقَتها","يَجْرِي فَيَمْلأُ أَسْماَعَا وأَبصاراً",33,"ر",2,0],["كأنه يوم يجري من يديْ عمرٍ","إلى يديْ خالدٍ يجري بحُسبانِ",34,"ن",1,0]]}