{"poems":[[50,"تباعد ما استطعت من الشقوق","https://www.aldiwan.net/poem66603.html","الوافر"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54771","المتقارب"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54829","الوافر"],[111,"ألا هل لداعي الله في الأرض سامع","https://www.poetsgate.com/ViewPoem.aspx?id=103",""],[47,"تَظُنُّ شُجُونيَ لَمْ تَعْتَلِجْ","https://www.poetsgate.com/ViewPoem.aspx?id=33100",""],[173,"لذا اليوم أعملت القلاص العباهلا","https://www.aldiwan.net/poem1655.html",""],[287,"لحاظ المهى لا بابل تنفث السحرا","https://www.aldiwan.net/poem32789.html","الطويل"],[445,"نداك حبيب لا يشط مزاره","https://www.aldiwan.net/poem34778.html","الطويل"],[445,"أرحلي محمول على العتق النجب","https://www.aldiwan.net/poem34886.html","الطويل"],[520,"عسى منجد الأظعان يوماً يغيرها","https://www.aldiwan.net/poem12160.html","الطويل"],[689,"","https://poetry.dctabudhabi.ae/diwan/poem/203595","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64019","السريع"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64516","الطويل"],[3434,"","https://poetry.dctabudhabi.ae/diwan/poem/203220","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111465","المتقارب"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111520","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111452","البسيط"],[4764,"راعي شهامه","https://www.poetsgate.com/ViewPoem.aspx?id=31769",""],[5553,"انتم بدو","https://www.poetsgate.com/ViewPoem.aspx?id=185922",""],[5689,"هنا بين هذا الدوح والزهرات","https://www.poetsgate.com/ViewPoem.aspx?id=143393",""],[5956,"مفاتيح الدخول إلى بلادي العربية","https://www.poetsgate.com/ViewPoem.aspx?id=192786",""],[520,"عسى منجد الأظعان يوما يغيرها","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577553",""]],"verses":[["وأيرُكَ ما استطعتَ فصنهُ إلّا","عن الخلواتِ بالرشأ العتيقِ",0,"ق",1,0],["وَأَيُّ رَأَى شَارِداً يَقْتَنِصْ","هُ وَأَيٌّ رَأَى وَارِداً يَصْطَدِ",1,"د",1,0],["وَأَيٌّ رَامَ بَيْنَ النَّاسِ مَجْداً","فَلَيْسَ يَعِيبُهُ غَيْرُ الْقصُورِ",2,"ر",1,0],["وأي رجاء بعد ستين حجة","لعيش وهل ماض من العمر راجع",3,"ع",1,0],["وأير طماس إذا ما أشظ","في صدع إمراتك المنفرج",4,"ج",1,0],["وَأَيُّ رَئيسٍ لا يُرى دُونَ مالِهِ","صَديقٌ وَلا عافٍ يُرَجِّيهِ حائِلا",5,"ل",2,0],["وَإيرادُكَ الراياتِ صُفراً صَوادِياً","وَإِصدارُها رَيّا تَمُجُّ دِماً حُمرا",6,"ر",2,0],["وأيُّ رجاءٍ حادَ منكَ طريقُهُ","وأيُّ ثناءٍ قَرَّ عنك قرارُهُ",7,"ر",2,0],["وأَيُّ رَجاءٍ قادَ رَحْلي إِليكُما","وَقَدْ أَصعَقَتْني مثلُ رَاغِيَةِ الصَّقْبِ",8,"ب",1,0],["وأي رحى دارت فلم يك شاور","بقطب العطايا والرزايا يديرها",9,"ر",3,0],["وأي رهط لهم حق الامامة من","بعد النبي بنص واضح ونبا",10,"ب",2,0],["وأيّ رأيٍ لامرئٍ إِن رأى","شخصَينِ من قُربٍ يَقلْ أربَعه",11,"ع",2,0],["وايراثك المخلوق للملك نعمة","على أنه ما حال عنك بلحظة",12,"ه",1,0],["وأيرك أضحى وارثاً علم جابرٍ","فأعطاك من ألقابه الشمس والقمر",13,"ر",1,0],["وإِيرُثلِيُونُ زَعِيمُ العِدى","شَدِيداً لَدينا كَرَبٍّ بَدا",14,"د",2,0],["وإيريس سارت وهي طارت وراءها","عليها نقابٌ حالك اللون مسود",15,"د",1,0],["وإيرِسٌ وُصُروعُ الخَيلِ في يَدِها","تَستَاقُها وَهيَ أَجرى مِن سَنَا الشُّهُبِ",16,"ب",1,0],["وأيُّ رَبٍّ كما لَو كُنتِ جانِيَةً","جَنَى عَلَيكِ كَما أَلقَاكِ أَيُّ غَبي",16,"ب",2,0],["وايرشني بالورد / حتى تِعدى","كل السواحل / بي تِعدى المواني",17,"ن",2,0],["وايروح عمري في هوا كامل الزين","اللي هواها بالخوافي عطبنا",18,"ن",2,0],["وأي رشاد في الحياة يقودني","وراك، وانت الرشد، أنت حياتي؟",19,"ت",2,0],["وأي روابطٍ ستزيد فينا","لحبّ الدّارجين على الفسادِ؟",20,"د",1,0],["وأي رحاً دارت فلم يك شاورٌ","بقطب الوطايا والرزايا مديرها",21,"ر",3,0]]}