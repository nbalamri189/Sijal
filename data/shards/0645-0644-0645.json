{"poems":[[9,"ما بكاء الكبير بالأطلال","https://www.aldiwan.net/poem21974.html","الخفيف"],[23,"لك الخير غضي اللوم عني فإنني","https://www.aldiwan.net/poem21238.html","الطويل"],[40,"عاد الهموم وما يدري الخلي بها","https://www.aldiwan.net/poem7725.html","البسيط"],[87,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[78,"كم ألحم السيف في أبناء ملحمة","https://www.aldiwan.net/poem39314.html","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54214","الخفيف"],[139,"شفيق مضى والدهر خانك يا مصر","https://www.aldiwan.net/poem49167.html","الطويل"],[194,"وان يعمهُم حياً مطبقُ","https://www.aldiwan.net/poem1158.html",""],[369,"بملتقى لحظنا البرق الذي ومضا","https://www.aldiwan.net/poem60862.html","البسيط"],[391,"هل عند غان لفؤاد","https://www.aldiwan.net/poem1847.html","السريع"],[438,"مل من صبوته ما أملا","https://www.aldiwan.net/poem12453.html","الرمل"],[463,"مل معي لا عليك ضري ونفعي","https://www.aldiwan.net/poem56120.html","الخفيف"],[463,"من الغادي تحط به وتعلو","https://www.aldiwan.net/poem56250.html","الوافر"],[463,"جاء بها والخير مجلوب","https://www.aldiwan.net/poem56277.html","السريع"],[463,"أجدك بعد أن ضم الكثيب","https://www.aldiwan.net/poem56288.html","الوافر"],[572,"خرجت أقبح المخارج منه","https://www.aldiwan.net/poem69532.html","الخفيف"],[572,"ململمين فوق جرف هار","https://www.aldiwan.net/poem69663.html","الرجز"],[572,"ململمات من كرات التبر","https://www.aldiwan.net/poem69695.html","الهزج"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63802","المنسرح"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56575","الكامل"],[440,"","https://poetry.dctabudhabi.ae/diwan/poem/47385","المتقارب"],[1352,"","https://poetry.dctabudhabi.ae/diwan/poem/18431","الرجز"],[1355,"","https://poetry.dctabudhabi.ae/diwan/poem/31375","البسيط"],[460,"","https://poetry.dctabudhabi.ae/diwan/poem/21667","البسيط"],[1522,"","https://poetry.dctabudhabi.ae/diwan/poem/29533","الطويل"],[2323,"","https://poetry.dctabudhabi.ae/diwan/poem/116593","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106860","الكامل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103439","الطويل"],[3032,"","https://poetry.dctabudhabi.ae/diwan/poem/103419","البسيط"],[3105,"","https://poetry.dctabudhabi.ae/diwan/poem/46010","الطويل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/140026","الطويل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89222","البسيط"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103864","السريع"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/118006","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131230",""],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/141688","الرجز"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86532","البسيط"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114153","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102977","الطويل"],[4102,"","https://poetry.dctabudhabi.ae/diwan/poem/136912",""],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4529,"","https://poetry.dctabudhabi.ae/diwan/poem/105373","الرجز"],[4755,"مِل مَعَ التَّقبيلِ","https://www.poetsgate.com/ViewPoem.aspx?id=195173",""],[5150,"إلى أختي ...!","https://www.poetsgate.com/ViewPoem.aspx?id=203764",""],[5225,"اغسلي بالبرد","https://www.poetsgate.com/ViewPoem.aspx?id=16758",""],[5401,"مجنون ليلى","https://www.poetsgate.com/ViewPoem.aspx?id=78116",""],[5414,"بكائية بين يدي بشار بن برد","https://www.poetsgate.com/ViewPoem.aspx?id=12926",""],[5717,"يا حسرة من فؤاد محتدم","https://www.poetsgate.com/ViewPoem.aspx?id=170590",""],[1703,"يا قلب ما لك خافقاً وجلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83751&r=&rc=88",""],[6217,"وَمجنُونَة ٍ أَبَداً لَمْ تَكُنْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23135&r=&rc=12",""],[572,"ململمينَ فَوْقَ جرفٍ هارِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9309&r=&rc=166",""],[572,"ململماتٌ مِنْ كراة ِ التّبْرِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9303&r=&rc=160",""]],"verses":[["مُلمِعٍ لاعَةِ الفُؤادِ إِلى جَح","شٍ فَلاهُ عَنها فَبِئسَ الفالي",0,"ل",2,0],["مُلَملَمَةٌ خَطّارَةٌ لَو حَمَلتُها","عَلى السَيفِ لَم تَعدِل عَنِ السَيفِ مَعدِلا",1,"ل",2,0],["مُلَملَمٌ كَمُدُقِّ الهَضبِ مُنصَلِتٌ","ما إِن يَكادُ إِذا ما لَجَّ يُرتَجَعُ",2,"ع",1,0],["مُلمّةٌ لَو لَم تُصادف هِمّةً","لَأَودَت الدَولَةُ في شَرخ الصِبا",3,"ا",1,0],["مَلْمُومَةً تَتَبارى في مُلَمْلَمَةٍ","كأَنَّها لاعْتِدالِ الخَلْقِ أَفْهارُ",4,"ر",1,0],["مَلَّ مِنْ وَجْدِهِ وَمِنْ فَرْطِ مَا بِهْ","وَأرَاقَ الشَّرَابَ مِنْ أَكْوَابِهْ",5,"ب",2,1],["ملماتٌ بها حكمُ القضاءُ","وحزنُ ما لمدّتهِ انقضاءُ",6,"ا",2,0],["مَلمُومَة يَضِلُّ فِيها الاَبلَقُ","بِالخَيلِ تَمضِى قُدُماً وَتَلحَقُ",7,"ق",1,0],["مُلمِّةٌ تَقتفي بالّلهوِ مُعقبَةً","وزُبدةٌ تُجتنَى للعيشِ إذ مُخِضا",8,"ض",2,0],["مُلَمَّعُ الخَدَّينِ قَد أُردِفَت","أَكرُعُهُ بِالزَّمَعِ الأَسَودِ",9,"د",1,0],["ملّ من صبوتِه ما أمّلا","فسلا عن قلبِه كيفَ سَلا",10,"ل",2,1],["مِلْ معي لا عليك ضرّي ونفعي","نسأل الجَزْعَ عن ظباءِ الجزعِ",11,"ع",1,1],["ململَمةٍ لها ظَهرٌ مصونٌ","وبطنٌ تحت راكبها مُتاحُ",12,"ح",1,0],["مُلملمَ الجنبِ أمينَ القُوى","وكلُّهم أدبرُ مجلوبُ",13,"ب",1,0],["مُلَملَمَةٌ تضيقُ العينُ عنها","إذا شِرقتْ بجُمَّتِها السُّهوبُ",14,"ب",1,0],["مَلَّ مِنْ حَلْقِهَا فَشَابَتْ وَلَكِنْ","شَيْبُهَا كَانَ كَامِنَاً فِي الأُصُولِ",15,"ل",1,0],["مُلَمْلَمِيْنَ فوقَ جُرُفٍ هارِ","قد نُحِتَا شِبْهَيِنِ في نَجَارِ",16,"ر",1,1],["ململماتٌ من كُراتِ التِّبْرِ","مُعْتَنِقَاتٌ لِدَقِيْق الخَصْرِ",17,"ر",1,1],["مُلَمَّعٌ فهو أبيضٌ أحْمَرْ","كما تراهُ وأصْفَرٌ أَخْضَر",18,"ر",1,0],["ملمومة الأطراف تن","زو بالصدور إلى الصدور",19,"ر",1,0],["مُلَمَّعَةٍ مِثْلَما","بِحَناءِ وَشْيٍ يَدُ الكاعِبِ",20,"ب",1,0],["مَلمومَةٌ شَدَّ المَليكُ أَسرَها","أَسفَلَها وَبَطنَها وَظَهرَها",21,"ر",3,0],["مَلمومَةً لَم تُدارِك في سَوامِهِم","حَتّى أُبيحوا بِها وَالسَبيَ فَاِنتُهِبا",22,"ب",2,0],["مَلمومَةٍ نُحِتَت في حُسنِ خِلقَتِها","وَأُجفِرَت في تَمامٍ أَيُّ إِجفارِ",23,"ر",1,0],["مُلَمَّعَةً بِالشَأمِ سُفعاً خُدودُها","كَأَنَّ عَلَيها سابِرِيّاً مُذَيَّلا",24,"ل",2,0],["ملمومةٌ خضراءُ لو قَذَفُوا بِهَا","حَضناً لظل كأنَّهُ لم يُخلَقِ",25,"ق",1,0],["ملموةُ الورقات ذابلة","مثل المليحة ما لها بخت",26,"ت",1,0],["ململمةٌ فرعاءُ لولا شكيرها","لقلت مَداكٍ ضُمِّنَتهُ صخورُ",27,"ر",1,0],["مُلمَّعٌ أَخصَفُ العَينَينِ مُنتَدِبٌ","كَأَنَّهُ بِبَديع مَقصودُ",28,"د",1,0],["مُلَملَمَةُ الهاماتِ غُلبٌ كَأَنَّها","شَماريخُ تُعلى بِالضَبابِ العَواجِرِ",29,"ر",1,0],["ململمة هالت رجالاً فأمسكوا","فلمَّا أتى انهلت ولم تتلوّم",30,"م",1,0],["ملمّساً لا أراه حين أطلبه","كأنما الحرُّ فارٌ طالما قَرَضَهْ",31,"ض",2,1],["مل مداواتي طبيبي فقد","يرحمني للسقم حسّادي",32,"د",2,0],["ملمّة بولي العهد قد حدثت","بحكمة اللّه تعليماً وتنبيها",33,"ي",3,0],["ملماتٌ تكاد الأرض منها","يلم بجاذبيتها اختلال",34,"ل",1,0],["مُلَمْلَمَ الخَلْقِ كجُلمودِ الصَّفَا","مُقْتَدِرَ المِنْسَرِ مَقْدودَ القَنَا",35,"ا",1,0],["ملمة أصعقت لبنان حين دهت","ومزقت عن رباه هيدب السحب",36,"ب",1,0],["مُلَمِّحاً بِهِ للإسراءِ إِذ ظَهَرَت","بِهِ وُجُوهٌ مِنَ التَّفضِيلِ تُعتَقَدُ",37,"د",1,0],["ململة الأطراف ذات بوارق","تطن طنين الرعد فيها الزماجر",38,"ر",1,0],["مل من عيشه ملالَ السجين","وتمنى ورود حوض المنونِ",39,"ن",1,1],["ملمومةٌ من صخرةٍ صَلْدَةٍ","فاجرةٌ بالماءِ مفجورَهْ",40,"ر",2,0],["ملمّة تبيض منها لمتيّ","ان نزلت فدونها صرف القضا",41,"ا",1,0],["مِل مَعَ التَّقبيلِ, واخْتَل, وتِهِ","أَنتَ حَظُّ القَلبِ مِن دَعْوَتِهِ",42,"ت",2,1],["مِلْ مَعَ التَّقبيلِ, واختَل طَرِبًا","أَفلَتَ المَجنُونُ مِن خُلوَتِهِ",42,"ت",2,0],["ملَّ من عشْقِ النِّسا لمّا غدا","عاشقاً فلسفةَ الحبِّ الرصينَهْ",43,"ن",2,0],["ملّ منّي السّهد لو ينام المسهّد","طيّب النّوم شَلّه ظبي طرفه كحيل",44,"ل",1,0],["مل من سوق الهوى ومن التسوّووح","بين برج المملكه والفيصليه",45,"ي",2,0],["ملَّ من وجهه الكئيب سهيل","والثريا, وكل نجم زهير",46,"ر",1,0],["ملمة قد أتت بقارعة","منها ألم المشيب باللمم",47,"م",1,0],["م لم يكن في صدره أمل","عبثً يرى في غيره أملا",48,"ل",2,0],["مُلَمَّعَة ٍ مِثلَما لُمِّعَتْ","بِحِنَّاءِ وَشي يَدُ الكاعبِ",49,"ب",1,0],["ململمينَ فَوْقَ جرفٍ هارِ","قد نحتا وشبهني في نجارِ",50,"ر",1,1],["ململماتٌ مِنْ كراة ِ التّبْرِ","معتنقاتٌ لرقيقِ الخَضْرِ",51,"ر",1,1]]}