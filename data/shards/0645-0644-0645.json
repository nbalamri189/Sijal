{"poems":[[9,"ما بكاء الكبير بالأطلال","https://www.aldiwan.net/poem21974.html","الخفيف"],[23,"لك الخير غضي اللوم عني فإنني","https://www.aldiwan.net/poem21238.html","الطويل"],[38,"عاد الهموم وما يدري الخلي بها","https://www.aldiwan.net/poem7725.html","البسيط"],[85,"من جعل المغرب مطلع الضحى","https://www.aldiwan.net/poem7908.html","الرجز"],[76,"كم ألحم السيف في أبناء ملحمة","https://www.aldiwan.net/poem39314.html","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54214","الخفيف"],[135,"شفيق مضى والدهر خانك يا مصر","https://www.aldiwan.net/poem49167.html","الطويل"],[190,"وان يعمهُم حياً مطبقُ","https://www.aldiwan.net/poem1158.html",""],[364,"بملتقى لحظنا البرق الذي ومضا","https://www.aldiwan.net/poem60862.html","البسيط"],[386,"هل عند غان لفؤاد","https://www.aldiwan.net/poem1847.html","السريع"],[432,"مل من صبوته ما أملا","https://www.aldiwan.net/poem12453.html","الرمل"],[458,"مل معي لا عليك ضري ونفعي","https://www.aldiwan.net/poem56120.html","الخفيف"],[458,"من الغادي تحط به وتعلو","https://www.aldiwan.net/poem56250.html","الوافر"],[458,"جاء بها والخير مجلوب","https://www.aldiwan.net/poem56277.html","السريع"],[458,"أجدك بعد أن ضم الكثيب","https://www.aldiwan.net/poem56288.html","الوافر"],[567,"خرجت أقبح المخارج منه","https://www.aldiwan.net/poem69532.html","الخفيف"],[567,"ململمين فوق جرف هار","https://www.aldiwan.net/poem69663.html","الرجز"],[567,"ململمات من كرات التبر","https://www.aldiwan.net/poem69695.html","الهزج"]],"verses":[["مُلمِعٍ لاعَةِ الفُؤادِ إِلى جَح","شٍ فَلاهُ عَنها فَبِئسَ الفالي",0,"ل",2,0],["مُلَملَمَةٌ خَطّارَةٌ لَو حَمَلتُها","عَلى السَيفِ لَم تَعدِل عَنِ السَيفِ مَعدِلا",1,"ل",2,0],["مُلَملَمٌ كَمُدُقِّ الهَضبِ مُنصَلِتٌ","ما إِن يَكادُ إِذا ما لَجَّ يُرتَجَعُ",2,"ع",1,0],["مُلمّةٌ لَو لَم تُصادف هِمّةً","لَأَودَت الدَولَةُ في شَرخ الصِبا",3,"ا",1,0],["مَلْمُومَةً تَتَبارى في مُلَمْلَمَةٍ","كأَنَّها لاعْتِدالِ الخَلْقِ أَفْهارُ",4,"ر",1,0],["مَلَّ مِنْ وَجْدِهِ وَمِنْ فَرْطِ مَا بِهْ","وَأرَاقَ الشَّرَابَ مِنْ أَكْوَابِهْ",5,"ب",2,1],["ملماتٌ بها حكمُ القضاءُ","وحزنُ ما لمدّتهِ انقضاءُ",6,"ا",2,0],["مَلمُومَة يَضِلُّ فِيها الاَبلَقُ","بِالخَيلِ تَمضِى قُدُماً وَتَلحَقُ",7,"ق",1,0],["مُلمِّةٌ تَقتفي بالّلهوِ مُعقبَةً","وزُبدةٌ تُجتنَى للعيشِ إذ مُخِضا",8,"ض",2,0],["مُلَمَّعُ الخَدَّينِ قَد أُردِفَت","أَكرُعُهُ بِالزَّمَعِ الأَسَودِ",9,"د",1,0],["ملّ من صبوتِه ما أمّلا","فسلا عن قلبِه كيفَ سَلا",10,"ل",2,1],["مِلْ معي لا عليك ضرّي ونفعي","نسأل الجَزْعَ عن ظباءِ الجزعِ",11,"ع",1,1],["ململَمةٍ لها ظَهرٌ مصونٌ","وبطنٌ تحت راكبها مُتاحُ",12,"ح",1,0],["مُلملمَ الجنبِ أمينَ القُوى","وكلُّهم أدبرُ مجلوبُ",13,"ب",1,0],["مُلَملَمَةٌ تضيقُ العينُ عنها","إذا شِرقتْ بجُمَّتِها السُّهوبُ",14,"ب",1,0],["مَلَّ مِنْ حَلْقِهَا فَشَابَتْ وَلَكِنْ","شَيْبُهَا كَانَ كَامِنَاً فِي الأُصُولِ",15,"ل",1,0],["مُلَمْلَمِيْنَ فوقَ جُرُفٍ هارِ","قد نُحِتَا شِبْهَيِنِ في نَجَارِ",16,"ر",1,1],["ململماتٌ من كُراتِ التِّبْرِ","مُعْتَنِقَاتٌ لِدَقِيْق الخَصْرِ",17,"ر",1,1]]}