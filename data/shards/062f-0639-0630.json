{"poems":[[79,"يا خاتم الفضل أو يا حاتم الزمن","https://www.aldiwan.net/poem36034.html","البسيط"],[95,"فجع القريض وقد ثوى حسان","https://www.aldiwan.net/poem11217.html","البسيط"],[23,"ما هاج حسان رسوم المقام","https://www.aldiwan.net/poem21255.html","السريع"],[23,"ما بال عيني دموعها تكف","https://www.aldiwan.net/poem21478.html","المنسرح"],[74,"قدمت كالسيف إلى غمده","https://www.aldiwan.net/poem18559.html","السريع"],[53,"بدر وشمس ولدا كوكبا","https://www.aldiwan.net/poem8321.html","السريع"],[53,"ومدامة أغنت عن المصباح","https://www.aldiwan.net/poem9412.html","الكامل"],[53,"لي أربعون من السنين","https://www.aldiwan.net/poem10868.html","مجزوء الكامل"],[53,"راجع من بعد سلوة ذكره","https://www.aldiwan.net/poem62848.html","المنسرح"],[53,"لا يغضبن لعمرو من له خطر","https://www.aldiwan.net/poem62965.html","البسيط"],[53,"لهوت عن وصف الطلول الدارسه","https://www.aldiwan.net/poem64573.html","الرجز"],[53,"بدعة عندي كاسمها بدعه","https://www.aldiwan.net/poem65395.html","السريع"],[53,"أصبحت عاديت للصبا رشدك","https://www.aldiwan.net/poem65760.html","المنسرح"],[53,"شغل المحب عن الرسوم","https://www.aldiwan.net/poem66332.html","مجزوء الكامل"],[53,"أقرضته أيرا فرد لسانا","https://www.aldiwan.net/poem66469.html","الكامل"],[47,"نفسي فداؤك أيها الغضبان","https://www.aldiwan.net/poem66807.html","الكامل"],[30,"طرقت أمية في المنام تزورنا","https://www.aldiwan.net/poem5168.html","الكامل"],[2,"لمن الديار بقنة الحجر","https://www.aldiwan.net/poem25056.html","الكامل"],[60,"دع ذكرهن فما لهن وفاء","https://www.aldiwan.net/poem31207.html","الكامل"],[82,"أرأيت لنا ولهم ظعنا","https://www.aldiwan.net/poem31261.html","المتدارك"],[33,"لا فخر إلا قد علاه محمد","https://www.aldiwan.net/poem42554.html","الكامل"],[50,"عاج الشقي على دار يسائلها","https://www.aldiwan.net/poem62547.html","البسيط"],[50,"راح الشقي على دار يسائلها","https://www.aldiwan.net/poem66592.html","البسيط"],[52,"يا طير إنا في غد طير","https://www.aldiwan.net/poem63822.html","السريع"],[52,"دع ذكر عبدة إنه فند","https://www.aldiwan.net/poem63911.html","الكامل"],[154,"صدروا وسحر لحاظهم يغريني","https://www.aldiwan.net/poem68480.html","الكامل"],[190,"يا رب عفوك عن شيخ وذي حنف","https://www.aldiwan.net/poem43615.html","البسيط"],[208,"تطوى المنى عن طلاب غايته","https://www.aldiwan.net/poem53265.html","المنسرح"],[229,"هل تعرف الدار خف ساكنها","https://www.aldiwan.net/poem416.html",""],[242,"أملى الهنا والسعد ردد","https://www.aldiwan.net/poem18140.html","مجزوء الكامل"],[267,"قف بالديار وأي الدهر لم تقف","https://www.aldiwan.net/poem68198.html","البسيط"],[290,"بشرى السلامة أشرقت","https://www.aldiwan.net/poem39378.html","مجزوء الكامل"],[385,"لا يخدعنك جمال صوره","https://www.aldiwan.net/poem48759.html","مجزوء الكامل"],[415,"حيا ربوعك من ربى ومنازل","https://www.aldiwan.net/poem31851.html","الكامل"],[415,"من كان لي من حماه خيس ذي لبد","https://www.aldiwan.net/poem32214.html","البسيط"],[415,"يا قلب كم يستخفك القلق","https://www.aldiwan.net/poem32421.html","المنسرح"],[415,"ما أنصفوا في الحب إذ حكموا","https://www.aldiwan.net/poem32534.html","السريع"],[415,"حتى متى يا قلب لا تستفيق","https://www.aldiwan.net/poem32561.html","السريع"],[415,"أطع الهوى واعص المعاتب","https://www.aldiwan.net/poem32615.html","مجزوء الكامل"],[567,"دع ذكر بانات العلم","https://www.aldiwan.net/poem52959.html","مجزوء الكامل"],[718,"","https://poetry.dctabudhabi.ae/diwan/poem/124029","البسيط"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44561","الرجز"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64018","المنسرح"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120089","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56185","البسيط"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109105","الكامل"],[1863,"","https://poetry.dctabudhabi.ae/diwan/poem/11121","البسيط"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124741","البسيط"],[1922,"","https://poetry.dctabudhabi.ae/diwan/poem/76669","الكامل"],[1949,"","https://poetry.dctabudhabi.ae/diwan/poem/105316","البسيط"],[1949,"","https://poetry.dctabudhabi.ae/diwan/poem/105304","الكامل"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69382","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69353","البسيط"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48244","الكامل"],[2221,"","https://poetry.dctabudhabi.ae/diwan/poem/34831","المجتث"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28491","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93562","الكامل"],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136960",""],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100320","الرجز"],[2910,"","https://poetry.dctabudhabi.ae/diwan/poem/122487","البسيط"],[2914,"","https://poetry.dctabudhabi.ae/diwan/poem/9620","البسيط"],[2961,"","https://poetry.dctabudhabi.ae/diwan/poem/111550","السريع"],[3100,"","https://poetry.dctabudhabi.ae/diwan/poem/124293","البسيط"],[3240,"","https://poetry.dctabudhabi.ae/diwan/poem/126279","الكامل"],[3242,"","https://poetry.dctabudhabi.ae/diwan/poem/124093","البسيط"],[3317,"","https://poetry.dctabudhabi.ae/diwan/poem/35855","الكامل"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82821","البسيط"],[3561,"","https://poetry.dctabudhabi.ae/diwan/poem/32364","الكامل"],[3665,"","https://poetry.dctabudhabi.ae/diwan/poem/34711","المنسرح"],[496,"","https://poetry.dctabudhabi.ae/diwan/poem/117847","الكامل"],[3717,"","https://poetry.dctabudhabi.ae/diwan/poem/36723","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59493","الكامل"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59453","الكامل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35616","الكامل"],[3917,"","https://poetry.dctabudhabi.ae/diwan/poem/88539","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86470","السريع"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86363","الكامل"],[4205,"","https://poetry.dctabudhabi.ae/diwan/poem/22068","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94784","الكامل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94580","البسيط"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94360","البسيط"],[4258,"","https://poetry.dctabudhabi.ae/diwan/poem/18995","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73205","الكامل"],[4348,"","https://poetry.dctabudhabi.ae/diwan/poem/198549","البسيط"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83201","الرجز"],[4505,"","https://poetry.dctabudhabi.ae/diwan/poem/89589","المتدارك"],[5145,"أذر الدموع فلات حين مجاز","https://www.poetsgate.com/ViewPoem.aspx?id=108241",""],[5149,"حديث ٌ معَ الدُّنيا","https://www.poetsgate.com/ViewPoem.aspx?id=215290",""],[5338,"معارضة قصيدة بات سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=187941",""]],"verses":[["دَعْ ذكْرَ قَيْصَرَ أَوْ كِسْرَى وَمَا جَمَحَتْ","بِهِ الْحِكَايَةُ عَنْ سَيْفِ بْنِ ذِي يَزَنِ",0,"ن",1,0],["دَعْ ذَلِكَ الأَدَبَ الرَّفِيعَ وَمَا بِهِ","مِنْ كُلِّ لَوْنٍ مُونِقٍ يَزْدَانُ",1,"ن",1,0],["دَع ذِكرَها وَاِنمِ إِلى جَسرَةٍ","جُلذِيَّةٍ ذاتِ مَراحٍ عَقام",2,"م",1,0],["دَع ذا وَعَدِّ القَريضَ في نَفَرٍ","يَدعونَ مَجدي وَمِدحَتي شَرَفُ",3,"ف",1,0],["دعْ ذا وعدْ للقولِ في معشرٍ","غرٍّ وفي غيرهم عده",4,"د",2,0],["دع ذا وجاوزْهُ إلى غيرِهِ","يا أكرمَ السادةِ مُستعتَبا",5,"ب",2,0],["دعْ ذا وقلْ في آل شيْخٍ إنَّهم","أقصى مَطامح هِمَّةِ الطمَّاحِ",6,"ح",1,0],["دع ذا فَخَلْفَك أربعو","ن ضحى طويلاتُ المُددْ",7,"د",1,0],["دعْ ذكره إنّ ذكره شعفٌ","وامنحْ من المدح سالماً غُررَه",8,"ر",2,0],["دع ذا فأنت حقيقٌ أن تكافئني","لو كنت تدري وأنَّى يفْقه الحجر",9,"ر",1,0],["دع ذا وذُدْ عنك الهموم الهالسه","ونهسَ ذُؤبان الخطوب الناهسه",10,"س",2,0],["دع ذا وجاوزه إلى غيره","وارضَ لمن أغضبتَه طبعه",11,"ع",2,0],["دعْ ذا وقلْ في مديحِ ذي كرمٍ","قَوَّمَ إفْضالُ كفِّهِ أودَكْ",12,"ك",1,0],["دع ذا لِبدْرٍ قد أضا","ءَ فما عليه من قُتوم",13,"م",1,0],["دع ذا فإنّ قرونه لو أصبحت","لك معقلاً لم ترهب الحَدثانا",14,"ن",2,0],["دَع ذا وَأَخبِرني بِشَأنِ صَديقِنا","بِشرٍ وَهَل يُرضى لِبِشرٍ شانُ",15,"ن",1,0],["دَع ذا فَقَد أَطنَبتَ في طَلَبِ الصِبا","وَعَلاكَ مِن بَعدِ الشَبابِ قَتيرُ",16,"ر",1,0],["دَع ذا وَعَدِّ القَولَ في هَرَمٍ","خَيرِ البُداةِ وَسَيِّدِ الحَضرِ",17,"ر",1,0],["دَع ذِكرَهُنَّ فَما لَهُنَّ وَفاءُ","ريحُ الصَبا وَعُهودُهُنَّ سَواءُ",18,"ا",2,1],["دَعْ ذكرَ نَزُوحٍ عنك نأى","وتَبَدّلْ من سَكَنٍ سَكَنَا",19,"ن",2,0],["دَع ذا وَرُح بِفِناءِ خَودٍ بَضَّةٍ","مِمّا نَطَقتُ بِهِ وَغَنّى مَعبَدُ",20,"د",1,0],["دَع ذا عَدِمتُكَ وَاِشرَبها مُعَتَّقَةً","صَفراءَ تُعنِقُ بَينَ الماءِ وَالزَبَدِ",21,"د",1,0],["دع ذا فقدتُكَ للأعرابِ واغدُ بنا","إلى مدامِ نديمِ اللهوِ منتقدِ",22,"د",1,0],["دَع ذا فَإِنَّ الغُرَّ مِن هاشِمٍ","أَبناءُ داوودَ المَساعيرُ",23,"ر",1,0],["دَع ذِكرَ عَبدَةَ إِنَّهُ فَنَدُ","وَتَعَزَّ تَرفِدُ مِنكَ ما رَفَدوا",24,"د",3,1],["دع ذكر عروة أو كثيّر عزة","وابن الذريج وقيس المجنون",25,"ن",1,0],["دع ذا وخذ في حديث فيه معتبرٌ","لكل حرّ دقيق الفكر ذي شرَف",26,"ف",1,0],["دَع ذِكرَ أقلامه فلم يكن ال","صَمصَامُ إلا بعنترٍ يُذكَرْ",27,"ر",1,0],["دع ذا ولكن ربَّ عاذِلَةٍ","لو عَلِمَت ما أُريدُ لِمَ تعدِ",28,"د",1,0],["دَعْ ذِكْرَ بَسْطَامٍوَعَنْتَ","رَةَ الْفَوَارِسِ حِينَ يَحْرَدْ",29,"د",1,0],["دَع ذا وَقُل في الذي قَد فَازَ مِن مُضَرٍ","بِالمَكرُماتِ وعِزٍّ غَيرِ مُقتَرَفِ",30,"ف",1,0],["دع ذا الخنا في غيه","فالاسد لا تبدي ضجر",31,"ر",1,0],["دَع ذا وَخُذ ملحاً تر","دّ طَلائع الهَم المُغيره",32,"ر",2,0],["دَع ذا فأنتَ على الحوادِث مَروةٌ","تَلقى الرّزايا عالماً كالجاهلِ",33,"ل",1,0],["دَعْ ذا وقل لِبَنِي الآمالِ قد وَضَحَتْ","لكم سبيلُ الأماني وانجلَى الأَسَفُ",34,"ف",1,0],["دَعْ ذَا ففيه عَن لَومِنَا صَمَمٌ","وهْو بِنَا مَا علِمتَه عُقَقُ",35,"ق",1,0],["دَعْ ذا فما يُسمَعُ عُذرُ الهَوى","بَعدَ التّقَالِي فَالقِلَى أَبكَمُ",36,"م",1,0],["دَعْ ذا فما الناسُ سواءٌ ولا","يلْقَى الفتَى في كلِّ أرضٍ صَديقْ",37,"ق",1,0],["دَعْ ذا فما عُذرُ الفَتى","في غَيِّه والفودُ شَائِبْ",38,"ب",1,0],["دَعْ ذِكرَ باناتِ العَلَمْ","والنازلاتِ بذي سَلَمْ",39,"م",1,1],["دع ذا ولكن لمن سجف على يققٍ","دسّت مشاعرُهُ ابصرته لمن",40,"ن",1,0],["دَع ذا فَهذا كُلُّهُ تَهديدُ","أَرجو بِهِ قُربَكَ يا بَعيدُ",41,"د",1,0],["دع ذا أبا هاشمٍ وهاتِ أجِب","في سرعةٍ فالمجيبُ مَن أَسْرَع",42,"ع",1,0],["دع ذكر ماضيه وخذ","كرما يفيض بنانه",43,"ن",2,0],["دع ذكر عنتر عبسٍ والأولى سلفوا","من أمةٍ تنشر الأعصار ذكراها",44,"ا",3,0],["دع ذكرَ معبدَ والهُ عن انداده","هذا الذي قد عزَّ فينا نده",45,"ه",1,1],["دَع ذا وَعُدِّ عَفَرناةً مُذَكَّرَةً","بِمِثلِها يَطلُبُ الحاجاتِ مُطَّلَبُ",46,"ب",1,0],["دع ذا فلست بهم ضبا ولا كلفاً","ولا أطباك لهم وجدٌ ولا كلف",47,"ف",1,0],["دع ذا وصلنا غير مؤتمر","مستأثراً بالحمد والشكر",48,"ر",1,0],["دع ذا وقل في منيف ما يكافئه","عن بره فلقد زادت له المنن",49,"ن",1,0],["دع ذكر شيء قد مضى","لا يخطرن أبداً ببالك",50,"ك",1,1],["دَع ذِكرَ هِندٍ وَلَكن رُبَّ مَهلَكَةٍ","أَضحَت بِيَ العِيسُ في أَجوازِها تَفِدُ",51,"د",1,0],["دَع ذا وَرُبّ شَطُونِ البِيدِ نازِحةٍ","غُبرٍ مَعالِمُها طُمسٍ مَوامِيها",52,"ي",3,0],["دعْ ذكرَهُنَّ وعجْ إِلى","حَمْدِ الحميدِ الأريحيِّ محمدِ",53,"د",1,0],["دَع ذا وَقُل في ثَناءٍ","عَلى الأَميرِ المُصَفّى",54,"ف",2,0],["دَع ذَا أليسَ الله قد أبدَى لَنَا","حقَّ الأدلةِ وَهي فِي القُرآنِ",55,"ن",1,0],["دَع ذَا فَقَد قَالَ الرَّسُولُ بِنَفسِهِ","أينَ الإِلَهُ لِعَالِمٍ بِلِسَانِ",55,"ن",1,0],["دَع ذا وَقُل لي أَنتَ يا ابنَ مُحَسِّنٍ","وَجَفاء مِثلِكَ مِن تَمام المِحنَةِ",56,"ه",1,0],["دع ذكرك الدار الَّتي بكَ قَد نَبَت","فَذممت مربعها وعفت مَراحها",57,"ح",3,0],["دع ذكر روما فلا صحب ولا آل","فيها لنا وبها لا ينعم البال",58,"ل",1,1],["دع ذَنب القوم الهجين منهم","واحثث الى الرأس الهجان القلصا",59,"ص",2,0],["دَع ذِكرياتِ الصِّبَا والأخذِ فِي الغَزَلِ","وَلاَ تُشبِّب بأعكَانٍ وَلاَ كَفَلِ",60,"ل",1,1],["دَع ذا وَقُل لِبَني سَعدٍ بِفَضلِهِمِ","مَدحاً يَسيرُ بِهِ غادي الأَراكيبِ",61,"ب",1,0],["دع ذا وقل للناس ما طارق","يطرقك جهراً ولا يتقي",62,"ق",2,1],["دع ذا وشمر لما ترجى عواقبه","وما به تبلُغُ الأقصى من الأمل",63,"ل",1,0],["دع ذكر ليلى والرباب وزينبا","ومنازلا خطرت بهما سلماكا",64,"ك",2,0],["دع ذا وزُفّ من الأمداح أجودها","إلى الكريمين أبناء الكريمينا",65,"ن",2,0],["دَع ذا التَبَسُّم فالتَبسّمُ آلَةٌ","تُردي الغَبِيَّ لَدى اللِقاءِ بِلا اِمتِرا",66,"ر",2,0],["دَع ذا ا