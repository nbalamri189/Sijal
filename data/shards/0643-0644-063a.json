{"poems":[[55,"قربت بالبعد من الناس","https://www.aldiwan.net/poem30188.html","السريع"],[45,"ذي المعالي فليعلون من تعالى","https://www.aldiwan.net/poem9979.html","الخفيف"],[47,"يا غاديا والثغر خلف مسائه","https://www.aldiwan.net/poem10200.html","الكامل"],[63,"وطيب النشر عبق","https://www.aldiwan.net/poem51526.html","مجزوء الرجز"],[63,"أقررت في شكرك بالتقصير","https://www.aldiwan.net/poem51655.html","الرجز"],[82,"طرقت والليل ممدود الجناح","https://www.aldiwan.net/poem31522.html","الرمل"],[71,"كل غرام فيك أمسى لي","https://www.aldiwan.net/poem28636.html","الرجز"],[69,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39671","الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[98,"مصرع سياسي","https://www.poetsgate.com/ViewPoem.aspx?id=13202",""],[119,"هذا كتاب منزل وزبور","https://www.aldiwan.net/poem41746.html","الكامل"],[147,"لا تجز في الذي بلغت الأنام","https://www.aldiwan.net/poem11812.html","الخفيف"],[302,"يا نسيم الصبا متى جزت نجدا","https://www.aldiwan.net/poem33288.html","الخفيف"],[302,"لمن العيس لها في البيد نفح","https://www.aldiwan.net/poem33307.html","الرمل"],[303,"لزوال جميع ما أنت رائي","https://www.aldiwan.net/poem36262.html","عموديه"],[303,"ما لها تشرق حمرا أتراها","https://www.aldiwan.net/poem36835.html","عموديه"],[369,"نمت بأسرار ليل كان يخفيها","https://www.aldiwan.net/poem60595.html","البسيط"],[369,"اليوم يومي ويوم الأينق الذلل","https://www.aldiwan.net/poem60675.html","البسيط"],[369,"ذكر المعسكر صاحبي ذكرا","https://www.aldiwan.net/poem60913.html","أحذ الكامل"],[422,"جد في وجده بكم فعلاما","https://www.aldiwan.net/poem53970.html","الخفيف"],[422,"ما لها تطوي فيافي الأرض سيرا","https://www.aldiwan.net/poem53994.html","الرمل"],[453,"كل غرام لحسنكم تابع","https://www.aldiwan.net/poem53732.html","المنسرح"],[463,"ظن غداة الخيف أن قد سلِما","https://www.aldiwan.net/poem55900.html","الرجز"],[463,"راش نبالا في جفنه ورمى","https://www.aldiwan.net/poem55902.html","المنسرح"],[463,"ما على منجد رأى ما أهمه","https://www.aldiwan.net/poem55903.html","الخفيف"],[463,"نوازع الشوق والغليلِ","https://www.aldiwan.net/poem55990.html","مخلع البسيط"],[463,"عثرت يوم العذيب فاستقل","https://www.aldiwan.net/poem55993.html","المنسرح"],[463,"رق لبغداد القضاء والقدر","https://www.aldiwan.net/poem56181.html","الرجز"],[463,"بالغور ما شاء المطايا والمطر","https://www.aldiwan.net/poem56190.html","الرجز"],[463,"حيها أوجها على السفح غرا","https://www.aldiwan.net/poem56191.html","الخفيف"],[463,"قل للزمان صلحا","https://www.aldiwan.net/poem56249.html","مجزوء الرجز"],[466,"نكبا صمتي وخافا صخبي","https://www.aldiwan.net/poem15144.html","الرمل"],[469,"ظبيات الحمى تخيف الأسودا","https://www.aldiwan.net/poem3169.html","عموديه"],[469,"أيها الكامل المروءة والمفحم","https://www.aldiwan.net/poem3234.html","عموديه"],[469,"راح يستمطر الدموع الغزارا","https://www.aldiwan.net/poem3621.html","عموديه"],[556,"ما رأتني عيناك يوم الفراق","https://www.aldiwan.net/poem47357.html","الخفيف"],[556,"ضمنت مجدك العلا والمساعي","https://www.aldiwan.net/poem47709.html","الخفيف"],[563,"أطلق الكاس بعد طول احتباس","https://www.aldiwan.net/poem34439.html","الخفيف"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62460","الرمل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62534","الكامل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120065","الرمل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59413","الخفيف"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132900","المنسرح"],[2096,"","https://poetry.dctabudhabi.ae/diwan/poem/122939","المديد"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/105018","الخفيف"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28517","الرمل"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28515","الخفيف"],[2328,"","https://poetry.dctabudhabi.ae/diwan/poem/113034","الرجز"],[2449,"","https://poetry.dctabudhabi.ae/diwan/poem/115396","المديد"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94275","الخفيف"],[3400,"","https://poetry.dctabudhabi.ae/diwan/poem/130609","الرمل"],[3415,"","https://poetry.dctabudhabi.ae/diwan/poem/82825","الرمل"],[3455,"","https://poetry.dctabudhabi.ae/diwan/poem/99329","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89161","الخفيف"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131955","الرمل"],[3827,"","https://poetry.dctabudhabi.ae/diwan/poem/139834",""],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86351","الرمل"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54397","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72969","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72465","الرجز"],[4739,"ليلة الحزن","https://www.poetsgate.com/ViewPoem.aspx?id=34892",""],[5121,"رعشة","https://www.poetsgate.com/ViewPoem.aspx?id=33585",""],[5198,"غيمة نرجسية","https://www.poetsgate.com/ViewPoem.aspx?id=135531",""],[5213,"أعلى السفح تعرفت الديارا","https://www.poetsgate.com/ViewPoem.aspx?id=170459",""],[5831,"بيت جالا","https://www.poetsgate.com/ViewPoem.aspx?id=20387",""],[6102,"سِباقُ الواوِيات ..","https://www.poetsgate.com/ViewPoem.aspx?id=184411",""],[463,"رقَّ لبغدادَ القضاءُ والقدرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60077&r=&rc=133",""],[4222,"كيف قلتم في مقلتيه فتور","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=52785&r=&rc=77",""]],"verses":[["كُلُّ غُلامِ رامَ خَدعَ العُلى","يَلطُفُ في بِرّي وَإيناسي",0,"س",2,0],["كُلُّ غادٍ لِحاجَةٍ يَتَمَنّى","أَن يَكونَ الغَضَنفَرَ الرِئبالا",1,"ل",2,0],["كَلغَيثِ مُنسَكِباً عَلى إِخوانِهِ","كَالنارِ مُلتَهِباً عَلى أَعدائِهِ",2,"ا",3,0],["كلُّ غَريبٍ نُقِشَتْ","حُلَّتُه نَقْشَ السَّرَقْ",3,"ق",1,0],["كلِّ غريبِ الحُسنِ مستنيرِ","أخضرَ مثل الشاربِ المَطرورِ",4,"ر",1,0],["كُلّ غصنٍ تَعتري أعطافَهُ","رِعْدَةُ النَشوانِ مِن كَأسِ اصطِباح",5,"ح",1,0],["كلُّ غرامٍ فيكَ أمسى لي","أَوَالهاً بي كنتَ أَمْ سالِ",6,"ل",1,1],["كلٌّ غَدا وله مِن جِنسِهِ رَصَدٌ","لِلجِنِّ شُهبٌ وللإِنسانِ سِجِّيلُ",7,"ل",1,0],["كلُّ غالٍ من مناعٍ ودمٍ","لكِ يا مصرُ وما عزَّ الفداءْ",8,"ا",2,0],["كلّ غزاة للنبي حقه","لم يعد في حرب قريش حقّه",9,"ه",1,0],["كُلُ غيْدَاءَ رَدَاحٍ ناوَحَتْ","بِيدٍ عَبراً وَبِالأَخْمُصِ عَبْرَا",10,"ر",2,0],["كلّ غال من متاع ودم","لك يا مصر ، وما عزّ الفداء",11,"ا",2,0],["كل غدا يسعى على مرضاته","سعى الخلوص وسعيه مشكور",12,"ر",1,0],["كُلُّ غَرّاءَ لِلمُصيخِ إِلَيها","نَشوَةٌ ما تَقَدَّمَتها مُدامُ",13,"م",1,0],["كُلُّ غَرّاءَ لا تَرى البَدرَ مثلاً","لسَناها ولا الغَزالَةَ نِدّا",14,"د",2,0],["كُلُّ غَرّاءَ اذا ما أنشِدَت","زانَها في شيَم المُختار مَدحُ",15,"ح",1,0],["كلُّ غصنٍ في الأرضِ ينبت رمزٌ","لِبِلى كلِّ قامةٍ هيفاءِ",16,"ا",2,0],["كلُّ غصنِ مرسلٌ من ظلِّه","ذَيْلَ مختالٍ عَلَى الأقران تاها",17,"ا",3,0],["كُلٌّ غدا من بَني الدُّنْيا أَخا خُدَعٍ","يَبْغي لباطِله بالحَقِّ تَمْويها",18,"ي",3,0],["كُلٌّ غدا دونَ قَولي فِعْلُهمْ أبداً","ودونَ فِعْلِكَ قَولي فاغْتفِرْ زَللَي",19,"ل",2,0],["كُلٌّ غدا غُمْراً وصاحبُه","قد ظَل منه طالباً غَمرا",20,"ر",2,0],["كلّ غصن يُقِلُّ بدراً تماما","مَن لصادٍ ظامي الحشا يتلظَّى",21,"ا",1,0],["كلُّ غصنٍ ما بدا إلاَّ أرى","حاملاً من صَنْعَة الخلاّق بدرا",22,"ر",2,0],["كل غرام لحسنكم تابع","وكل حسن إليكم راجع",23,"ع",1,1],["كلُّ غلام ذاهبٌ بنفسه","حيثُ مضى المجدُ به ويمَّما",24,"م",2,0],["كلُّ غلام يُرجَى إذا اشتطَّ غض","بانَ ويُخشى بَكراً إذا ابتسما",25,"م",2,0],["كلّ غَمرٍ كأنَّ في كفّه من","حتفه في الوغى أماناً وعِصْمَهْ",26,"م",2,0],["كلّ غلامٍ يَسُدُّ مجداً","بنفسه ثُغرةَ القبيلِ",27,"ل",1,0],["كلّ غلامٍ ضربٍ يخفّ إلى ال","ضرب خُفوفَ الصَّنَاع للعملِ",28,"ل",1,0],["كلّ غلام إن عفا وإن سطا","أمَّنَ بين الخافقين وذَعَرْ",29,"ر",1,0],["كلُّ غلام ذاهبٌ بنفسه","مع العَلاء إن بدا وإن حضَرْ",30,"ر",1,0],["كلّ غراءَ تجتليها على شر","طك في الحسن ثيِّباً أو بِكرا",31,"ر",2,0],["كلُّ غلامٍ كافرٌ","تحت اللثامِ الصُّبحا",32,"ح",2,0],["كل غمرٍ وكِلٍ في عيشهِ","عاجزٍ عن شرفٍ في نصبِ",33,"ب",1,0],["كل غصن لدن القوام مجودٍ","تحت شادٍ يلقي الغناء مجيدا",34,"د",2,0],["كل غراء يرقص السمع إذ تن","شد رقص السلاف في الأقداح",35,"ح",1,0],["كلُّ غيداءَ ريقها العذبُ خمرٌ","ما شربنا منها ونحن سكارى",36,"ر",2,0],["كلُّ غَضٍّ يرى المنايا حياةً","والعوالِي إلى المعالِي مَراقِ",37,"ق",1,0],["كلُّ غلٍّ لم يَشفِهِ يومُ حِلْمٍ","برؤُه في دواءِ يومِ المِصاعِ",38,"ع",1,0],["كل غصن من المليح أناء","هي فيه بالوهم والإلتباس",39,"س",1,0],["كل غَمر ليس يدري الفرق من","جلس العالم معنى وقعدْ",40,"د",1,0],["كل غطارفة جحاجحة الوغى","شادوا العُلا بمكارم وشمائلِ",41,"ل",1,0],["كل غراء المعاني تجتلي","في رداء زان من أوزانها",42,"ن",3,0],["كل غيث فمن نداه مفاض","كل ليث فمن ظباه استجارا",43,"ر",2,0],["كلُّ غرامٍ تُخافُ فِتنَتَه","فَبَنَ ألحاظِه ومبتسمه",44,"م",2,0],["كل غصن مال جانبه","فكأن الغصن سكران",45,"ن",1,1],["كل غيداء غضة الجسم تحكي","فضة أُشربت بتبرٍ مذاب",46,"ب",1,0],["كُلُّ غَرّاء شَرودٍ حَسَدَت","أَوَّلُ الدَّهرِ عَلَيها الأخَرا",47,"ر",2,0],["كُلُّ غَنّاء يُقطِعُ الغَيثُ عَنها","وَلَها أَعيُنٌ مِنَ النُّورِ حُورُ",48,"ر",1,0],["كلَّ غزالٍ آنسٍ لحاظه","للعاشقين لم تزل قواتلا",49,"ل",2,0],["كل غضب مسرف عللا","وحرار الحر مغلول",50,"ل",1,0],["كل غرس تجنى له ثمرات","فاد كر صاح يوم تجنى ثمارك",51,"ك",1,0],["كل غيداء من الخود غدا","أبداً في طوعها الشوق وراحا",52,"ح",2,0],["كُلُّ غالٍ في هَواكِ","هانَ مَهما عَزَّ قَدرا",53,"ر",2,0],["كل غلام منهم رب بلد","يا سعده مني والد بما ولد",54,"د",1,0],["كل غصن أماله حمل لوز","يملأ الكف بعضه مستنيرْ",55,"ر",1,0],["كل غصن فوقه عصفورة","من رأى المنبر من غير خطيب",56,"ب",1,0],["كل غض الشباب قد شاب منه ال","حلم والرأي قبل وقت المشيب",57,"ب",1,0],["كل غيداء سعت للمشعر","قد جلا معصمها رمي الجمار",58,"ر",1,0],["كُل غُصنيهِ الموشحِ هَيْفا","ءَ على البَدْرِ جَيْبُها مَزور",59,"ر",1,0],["كل غصنٍ عليه من خَلعِ النوْ","رِ رداءٌ ضافٍ ووشيٌ حَبيرُ",59,"ر",1,0],["كلٌّ غدا مستنبطاً من غورِه","ضروب معنى هي أحلى من ضرب",60,"ب",1,0],["كل غدا مستنبطا من غورها","ضروب معنى هي أحلى من ضرب",61,"ب",1,0],["كل غلطه غير غلطة تجافينا صواب","وكل بعد غير بعدك عن عيوني قريب",62,"ب",1,0],["كُلُّ غَرْسٍ مِلْءُ ذَاتِي","رَقَّ وَجْدِي فِيِكِ يُسْرَا",63,"ر",2,0],["كل غصن صابه الوقت بشظيّة","والجفاف اجتاح الاوراق وشجرها",64,"ر",3,0],["كل غرثى الخصر ريا معصم","فصمت فعمته فيه السوارا",65,"ر",2,0],["كلُّ غازي سوفَ يمضي","يلقى موتاً أو زوالا",66,"ل",2,0],["كُلُّ غاوٍ- كَأَنَّهُ ظِلُّ ظِلِّي-","تابِعٍ خُطوَتِي, وَلستُ بِغاو",67,"ا",2,0],["كلُّ غلامٍ إن عفا وإنْ سطا","أمَّنَ بينَ الخافقينَ أو ذعرْ",68,"ر",1,0],["كل غصنيه الموشح هيفاء","على البدر جيبها مزرور",69,"ر",1,0]]}