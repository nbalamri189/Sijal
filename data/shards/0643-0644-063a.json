{"poems":[[53,"قربت بالبعد من الناس","https://www.aldiwan.net/poem30188.html","السريع"],[43,"ذي المعالي فليعلون من تعالى","https://www.aldiwan.net/poem9979.html","الخفيف"],[45,"يا غاديا والثغر خلف مسائه","https://www.aldiwan.net/poem10200.html","الكامل"],[61,"وطيب النشر عبق","https://www.aldiwan.net/poem51526.html","مجزوء الرجز"],[61,"أقررت في شكرك بالتقصير","https://www.aldiwan.net/poem51655.html","الرجز"],[80,"طرقت والليل ممدود الجناح","https://www.aldiwan.net/poem31522.html","الرمل"],[69,"كل غرام فيك أمسى لي","https://www.aldiwan.net/poem28636.html","الرجز"],[67,"إلى متى أنت باللذات مشغول","https://www.aldiwan.net/poem18083.html","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39671","الرمل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54881","الرمل"],[96,"مصرع سياسي","https://www.poetsgate.com/ViewPoem.aspx?id=13202",""],[116,"هذا كتاب منزل وزبور","https://www.aldiwan.net/poem41746.html","الكامل"],[144,"لا تجز في الذي بلغت الأنام","https://www.aldiwan.net/poem11812.html","الخفيف"],[298,"يا نسيم الصبا متى جزت نجدا","https://www.aldiwan.net/poem33288.html","الخفيف"],[298,"لمن العيس لها في البيد نفح","https://www.aldiwan.net/poem33307.html","الرمل"],[299,"لزوال جميع ما أنت رائي","https://www.aldiwan.net/poem36262.html","عموديه"],[299,"ما لها تشرق حمرا أتراها","https://www.aldiwan.net/poem36835.html","عموديه"],[365,"نمت بأسرار ليل كان يخفيها","https://www.aldiwan.net/poem60595.html","البسيط"],[365,"اليوم يومي ويوم الأينق الذلل","https://www.aldiwan.net/poem60675.html","البسيط"],[365,"ذكر المعسكر صاحبي ذكرا","https://www.aldiwan.net/poem60913.html","أحذ الكامل"],[417,"جد في وجده بكم فعلاما","https://www.aldiwan.net/poem53970.html","الخفيف"],[417,"ما لها تطوي فيافي الأرض سيرا","https://www.aldiwan.net/poem53994.html","الرمل"],[449,"كل غرام لحسنكم تابع","https://www.aldiwan.net/poem53732.html","المنسرح"],[459,"ظن غداة الخيف أن قد سلِما","https://www.aldiwan.net/poem55900.html","الرجز"],[459,"راش نبالا في جفنه ورمى","https://www.aldiwan.net/poem55902.html","المنسرح"],[459,"ما على منجد رأى ما أهمه","https://www.aldiwan.net/poem55903.html","الخفيف"],[459,"نوازع الشوق والغليلِ","https://www.aldiwan.net/poem55990.html","مخلع البسيط"],[459,"عثرت يوم العذيب فاستقل","https://www.aldiwan.net/poem55993.html","المنسرح"],[459,"رق لبغداد القضاء والقدر","https://www.aldiwan.net/poem56181.html","الرجز"],[459,"بالغور ما شاء المطايا والمطر","https://www.aldiwan.net/poem56190.html","الرجز"],[459,"حيها أوجها على السفح غرا","https://www.aldiwan.net/poem56191.html","الخفيف"],[459,"قل للزمان صلحا","https://www.aldiwan.net/poem56249.html","مجزوء الرجز"],[462,"نكبا صمتي وخافا صخبي","https://www.aldiwan.net/poem15144.html","الرمل"],[465,"ظبيات الحمى تخيف الأسودا","https://www.aldiwan.net/poem3169.html","عموديه"],[465,"أيها الكامل المروءة والمفحم","https://www.aldiwan.net/poem3234.html","عموديه"],[465,"راح يستمطر الدموع الغزارا","https://www.aldiwan.net/poem3621.html","عموديه"],[552,"ما رأتني عيناك يوم الفراق","https://www.aldiwan.net/poem47357.html","الخفيف"],[552,"ضمنت مجدك العلا والمساعي","https://www.aldiwan.net/poem47709.html","الخفيف"],[559,"أطلق الكاس بعد طول احتباس","https://www.aldiwan.net/poem34439.html","الخفيف"]],"verses":[["كُلُّ غُلامِ رامَ خَدعَ العُلى","يَلطُفُ في بِرّي وَإيناسي",0,"س",2,0],["كُلُّ غادٍ لِحاجَةٍ يَتَمَنّى","أَن يَكونَ الغَضَنفَرَ الرِئبالا",1,"ل",2,0],["كَلغَيثِ مُنسَكِباً عَلى إِخوانِهِ","كَالنارِ مُلتَهِباً عَلى أَعدائِهِ",2,"ا",3,0],["كلُّ غَريبٍ نُقِشَتْ","حُلَّتُه نَقْشَ السَّرَقْ",3,"ق",1,0],["كلِّ غريبِ الحُسنِ مستنيرِ","أخضرَ مثل الشاربِ المَطرورِ",4,"ر",1,0],["كُلّ غصنٍ تَعتري أعطافَهُ","رِعْدَةُ النَشوانِ مِن كَأسِ اصطِباح",5,"ح",1,0],["كلُّ غرامٍ فيكَ أمسى لي","أَوَالهاً بي كنتَ أَمْ سالِ",6,"ل",1,1],["كلٌّ غَدا وله مِن جِنسِهِ رَصَدٌ","لِلجِنِّ شُهبٌ وللإِنسانِ سِجِّيلُ",7,"ل",1,0],["كلُّ غالٍ من مناعٍ ودمٍ","لكِ يا مصرُ وما عزَّ الفداءْ",8,"ا",2,0],["كلّ غزاة للنبي حقه","لم يعد في حرب قريش حقّه",9,"ه",1,0],["كُلُ غيْدَاءَ رَدَاحٍ ناوَحَتْ","بِيدٍ عَبراً وَبِالأَخْمُصِ عَبْرَا",10,"ر",2,0],["كلّ غال من متاع ودم","لك يا مصر ، وما عزّ الفداء",11,"ا",2,0],["كل غدا يسعى على مرضاته","سعى الخلوص وسعيه مشكور",12,"ر",1,0],["كُلُّ غَرّاءَ لِلمُصيخِ إِلَيها","نَشوَةٌ ما تَقَدَّمَتها مُدامُ",13,"م",1,0],["كُلُّ غَرّاءَ لا تَرى البَدرَ مثلاً","لسَناها ولا الغَزالَةَ نِدّا",14,"د",2,0],["كُلُّ غَرّاءَ اذا ما أنشِدَت","زانَها في شيَم المُختار مَدحُ",15,"ح",1,0],["كلُّ غصنٍ في الأرضِ ينبت رمزٌ","لِبِلى كلِّ قامةٍ هيفاءِ",16,"ا",2,0],["كلُّ غصنِ مرسلٌ من ظلِّه","ذَيْلَ مختالٍ عَلَى الأقران تاها",17,"ا",3,0],["كُلٌّ غدا من بَني الدُّنْيا أَخا خُدَعٍ","يَبْغي لباطِله بالحَقِّ تَمْويها",18,"ي",3,0],["كُلٌّ غدا دونَ قَولي فِعْلُهمْ أبداً","ودونَ فِعْلِكَ قَولي فاغْتفِرْ زَللَي",19,"ل",2,0],["كُلٌّ غدا غُمْراً وصاحبُه","قد ظَل منه طالباً غَمرا",20,"ر",2,0],["كلّ غصن يُقِلُّ بدراً تماما","مَن لصادٍ ظامي الحشا يتلظَّى",21,"ا",1,0],["كلُّ غصنٍ ما بدا إلاَّ أرى","حاملاً من صَنْعَة الخلاّق بدرا",22,"ر",2,0],["كل غرام لحسنكم تابع","وكل حسن إليكم راجع",23,"ع",1,1],["كلُّ غلام ذاهبٌ بنفسه","حيثُ مضى المجدُ به ويمَّما",24,"م",2,0],["كلُّ غلام يُرجَى إذا اشتطَّ غض","بانَ ويُخشى بَكراً إذا ابتسما",25,"م",2,0],["كلّ غَمرٍ كأنَّ في كفّه من","حتفه في الوغى أماناً وعِصْمَهْ",26,"م",2,0],["كلّ غلامٍ يَسُدُّ مجداً","بنفسه ثُغرةَ القبيلِ",27,"ل",1,0],["كلّ غلامٍ ضربٍ يخفّ إلى ال","ضرب خُفوفَ الصَّنَاع للعملِ",28,"ل",1,0],["كلّ غلام إن عفا وإن سطا","أمَّنَ بين الخافقين وذَعَرْ",29,"ر",1,0],["كلُّ غلام ذاهبٌ بنفسه","مع العَلاء إن بدا وإن حضَرْ",30,"ر",1,0],["كلّ غراءَ تجتليها على شر","طك في الحسن ثيِّباً أو بِكرا",31,"ر",2,0],["كلُّ غلامٍ كافرٌ","تحت اللثامِ الصُّبحا",32,"ح",2,0],["كل غمرٍ وكِلٍ في عيشهِ","عاجزٍ عن شرفٍ في نصبِ",33,"ب",1,0],["كل غصن لدن القوام مجودٍ","تحت شادٍ يلقي الغناء مجيدا",34,"د",2,0],["كل غراء يرقص السمع إذ تن","شد رقص السلاف في الأقداح",35,"ح",1,0],["كلُّ غيداءَ ريقها العذبُ خمرٌ","ما شربنا منها ونحن سكارى",36,"ر",2,0],["كلُّ غَضٍّ يرى المنايا حياةً","والعوالِي إلى المعالِي مَراقِ",37,"ق",1,0],["كلُّ غلٍّ لم يَشفِهِ يومُ حِلْمٍ","برؤُه في دواءِ يومِ المِصاعِ",38,"ع",1,0],["كل غصن من المليح أناء","هي فيه بالوهم والإلتباس",39,"س",1,0]]}