{"poems":[[53,"ولولا هناة والهناة معاذر","https://www.aldiwan.net/poem30412.html","الطويل"],[53,"أعاتب أيامي وما الذئب واحد","https://www.aldiwan.net/poem30632.html","الطويل"],[63,"نظرت وللأدم النوافخ في البرى","https://www.aldiwan.net/poem45783.html","الطويل"],[77,"قلبي وسمعي في شغل عن الفند","https://www.aldiwan.net/poem36613.html","البسيط"],[24,"من سره كرم الحياة فلا يزل","https://www.aldiwan.net/poem21866.html","الكامل"],[88,"زر السجن في بغداد زورة راحم","https://www.aldiwan.net/poem45020.html","الطويل"],[23,"نشدت بني النجار أفعال والدي","https://www.aldiwan.net/poem21244.html","الطويل"],[72,"قدمت قدوم الغيث والحي مجذب","https://www.aldiwan.net/poem18238.html","الطويل"],[72,"أناعسة الأجفان أسهرت مكمدا","https://www.aldiwan.net/poem18553.html","الطويل"],[72,"كف الملامة عن حشا المتوجع","https://www.aldiwan.net/poem19166.html","الكامل"],[51,"ليوقن من يعارضني بأني","https://www.aldiwan.net/poem65446.html","الوافر"],[85,"كل حي على المنية غادي","https://www.aldiwan.net/poem62901.html","الخفيف"],[61,"أفي دمى أبكت العيون دما","https://www.aldiwan.net/poem51428.html","المنسرح"],[80,"إذا البدر يطوى في ربوع البلى لحدا","https://www.aldiwan.net/poem31479.html","الطويل"],[90,"يادجلة الخير","https://www.aldiwan.net/poem60155.html","عموديه"],[75,"لمن صولجان فوق خدك عابث","https://www.aldiwan.net/poem69097.html","الطويل"],[48,"أيها المنتاب عن عفره","https://www.aldiwan.net/poem63366.html","المديد"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43800","الكامل"],[106,"أغنية الإِسراء","https://www.poetsgate.com/ViewPoem.aspx?id=179622",""],[77,"قلبي وسمعي في شغل عن الفند","https://www.poetsgate.com/ViewPoem.aspx?id=33815",""],[90,"تونس","https://www.poetsgate.com/ViewPoem.aspx?id=179195",""],[90,"دم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179229",""],[90,"أخي جعفر","https://www.poetsgate.com/ViewPoem.aspx?id=179226",""],[94,"ما شأن هذا الأشعث الجواب","https://www.poetsgate.com/ViewPoem.aspx?id=15610",""],[115,"كشفت حجاب الطمس عن حيطة الأسما","https://www.aldiwan.net/poem41777.html","الطويل"],[132,"إن للبين صولة وهجوما","https://www.aldiwan.net/poem54650.html","الخفيف"],[132,"جعلت بيننا الرباب النمو ما","https://www.aldiwan.net/poem54747.html","الخفيف"],[135,"تفضلت بالآلاء والعدل والبر","https://www.aldiwan.net/poem49132.html","الطويل"],[142,"يا صحابي واين منى صحبى","https://www.aldiwan.net/poem58430.html","البسيط"],[143,"بسعدك دارت في السماء الكواكب","https://www.aldiwan.net/poem11734.html","الطويل"],[160,"أحسنت في تدبير أمرك يا حسن","https://www.aldiwan.net/poem58795.html","الكامل"],[160,"خذوا لي من سعدى أمانا من الهجر","https://www.aldiwan.net/poem59078.html","الطويل"],[185,"نحا البين في تشتيت شملي مقاصدا","https://www.aldiwan.net/poem14496.html","الطويل"],[185,"إن الخلافة لم تزل عن أصلها","https://www.aldiwan.net/poem14645.html","الكامل"],[198,"يا رب يوم واضح نضرته","https://www.aldiwan.net/poem51970.html","الكامل"],[210,"مسير قد ألم به هناء","https://www.aldiwan.net/poem13311.html","الوافر"],[210,"هناء به شمل المعاني تنظما","https://www.aldiwan.net/poem13324.html","الطويل"],[235,"وأغن معسول المراشف","https://www.aldiwan.net/poem31819.html","مجزوء الكامل"],[235,"نار جوى في الضلوع تتقد","https://www.aldiwan.net/poem32028.html","المنسرح"],[235,"طرقت ودون طروقها","https://www.aldiwan.net/poem32143.html","مجزوء الكامل"],[237,"تعززت بذي العز","https://www.aldiwan.net/poem18832.html","الهزج"],[250,"قضى حبه ألا تطاع عواذله","https://www.aldiwan.net/poem15013.html","الطويل"],[279,"ذرا السعي في نيل العلا والفضائل","https://www.aldiwan.net/poem2630.html","الطويل"],[280,"أمد الله ظلك يا سعيد","https://www.aldiwan.net/poem60568.html","الرمل"],[280,"متى ارتجعت مواهبها الكرام","https://www.aldiwan.net/poem60717.html","الوافر"],[297,"وافاك نشوان المعاطف ناشي","https://www.aldiwan.net/poem33234.html","الكامل"],[297,"إذا ما امتطيت الفلك مقتحم البحر","https://www.aldiwan.net/poem33276.html","الطويل"],[305,"دام أفق الوزير ينمي الأهله","https://www.aldiwan.net/poem56436.html","الخفيف"],[305,"رسل البشائر ورد وصدور","https://www.aldiwan.net/poem56545.html","الخفيف"],[305,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[320,"ابشر بعز مخلد","https://www.aldiwan.net/poem67177.html","المجتث"],[328,"يا أيها الشاكي جفاه الرقاد","https://www.aldiwan.net/poem55041.html","السريع"],[353,"هناء بالسلامة مستديم","https://www.aldiwan.net/poem39955.html","الوافر"],[353,"تبارك من له الألطاف دوما","https://www.aldiwan.net/poem40005.html","الوافر"],[353,"بالفتح لاح لنا الهناء مبشرا","https://www.aldiwan.net/poem40350.html","الكامل"],[364,"جوانح واجد وجفون سال","https://www.aldiwan.net/poem60683.html","الوافر"],[364,"رأيت الطريق إلى الوصل وعرا","https://www.aldiwan.net/poem60911.html","الطويل"],[371,"سل الظعن هل من نظرة تستزيدها","https://www.aldiwan.net/poem57501.html","الطويل"],[377,"ما أحسن الروض في الروابي","https://www.aldiwan.net/poem66927.html","مخلع البسيط"],[410,"وسدت بهارون الثغور فأحكمت","https://www.aldiwan.net/poem67500.html","الطويل"],[432,"اجتل اللهو حمرة في بياض","https://www.aldiwan.net/poem12451.html","الخفيف"],[432,"صاح هذا ربع الهوى المعهود","https://www.aldiwan.net/poem12476.html","الخفيف"],[439,"قل للربيع اسحب ملاء سحائب","https://www.aldiwan.net/poem34876.html","الكامل"],[452,"وجني من القرنفل يبدي","https://www.aldiwan.net/poem13908.html","الخفيف"],[458,"سقى دارها بالرقمتين وحياها","https://www.aldiwan.net/poem55818.html","الطويل"],[458,"أيا سكر الزمان متى تفيق","https://www.aldiwan.net/poem56099.html","الوافر"],[458,"نشدتك يا بانة الأجرع","https://www.aldiwan.net/poem56118.html","المتقارب"],[458,"دعوها ترد بعد خمس شروعا","https://www.aldiwan.net/poem56122.html","المتقارب"],[458,"أتكتم يوم بانة أم تبوح","https://www.aldiwan.net/poem56247.html","الوافر"],[458,"أمرتكم أمري بنعمان ناصحا","https://www.aldiwan.net/poem56253.html","الطويل"],[461,"يا خيرة الله حلي عند مجتهد","https://www.aldiwan.net/poem15394.html","البسيط"],[461,"ضروب قذال القرن فذا لدى الوغى","https://www.aldiwan.net/poem16039.html","الطويل"],[464,"وجدي كوجدك بالظباء الغيد","https://www.aldiwan.net/poem3208.html","عموديه"],[464,"لذاك الحبيب وهذي الدمن","https://www.aldiwan.net/poem3319.html","عموديه"],[464,"إن يوم النوى شنيع سماعه","https://www.aldiwan.net/poem3396.html","عموديه"],[464,"كم بين دوح الأبرقين عوارياً","https://www.aldiwan.net/poem3596.html","عموديه"],[500,"هذا الوجود على مجلاك إيماء","https://www.aldiwan.net/poem38106.html","البسيط"],[515,"يا خير من نظم المديح لمجده","https://www.aldiwan.net/poem12063.html","الكامل"],[515,"وفى لك حد الجد والسيف غادر","https://www.aldiwan.net/poem12105.html","الطويل"],[538,"أينما كنت كنت رمز الكمال","https://www.aldiwan.net/poem47986.html","عموديه"],[551,"وسدني كفه وعانقني","https://www.aldiwan.net/poem47154.html","المنسرح"],[551,"أما سمعت حمام الأيك إذ صدحا","https://www.aldiwan.net/poem47895.html","البسيط"],[558,"وجودي جل عن جسمي","https://www.aldiwan.net/poem34248.html","الهزج"],[558,"وجود حقيقي هو الغيب مطلق","https://www.aldiwan.net/poem34303.html","الطويل"],[561,"يا رَبِّ إِذ شَدَدَتني عِقالاً","https://www.aldiwan.net/poem27837.html","الرجز"],[575,"يا ويح نفس عشقت","https://www.aldiwan.net/poem2982.html","مجزوء الرجز"]],"verses":[["وَسَدَّدَ مِن دوني سِناناً كَأَنَّهُ","إِلى الطَعنِ نابٌ يُقلِسُ السُمَّ قاطِرُ",0,"ر",1,0],["وَسُدَّ طَريقُ المَجدِ عَن كُلِّ سالِكٍ","وَضاقَت عَلى الآمالِ هَذي المَوارِدُ",1,"د",1,0],["وَسَدَّ خِصاصَ الخِدرِ طَرفٌ وَمَسمَعٌ","وَنَحرٌ وَخَدٌّ واضِحٌ وَجَبينُ",2,"ن",1,0],["وسَدّدَ الدّهْرُ دوني كلَّ شاحِبةٍ","زَرْقاءَ أصْمى شَباها فِلْذَةَ الكَبِدِ",3,"د",1,0],["وَسَدَت مُهَملِجَةً عُلالَةَ مُدمَجٍ","مِن فالِقٍ حَصِدٍ مِنَ الإِمرارِ",4,"ر",1,0],["وسدّ علينا الاعتشافُ طريقَنا","فأجحف بالغَوْريّ والمتنجِّد",5,"د",1,0],["وَسُدَّ عَلَيهِ كُلُّ أَمرٍ يُريدُهُ","وَزيدَ وَثاقاً فَاِقفَعَلَّت أَصابِعُه",6,"ع",2,0],["وسدت إلى أن سرّا سعدُ في الثرى","بسؤدَدِكَ الوضاح بل سر يعرب",7,"ب",1,0],["وسدت على نجل الحسين بمدحِ من","سأثقلُ أفراسي بنعماه عسجدا",8,"د",2,0],["وسداد رأي لا تخاف صفاته","لكن متى يخدعه عاف يخدع",9,"ع",1,0],["وسدِّد في معاملتي وقارب","ولا تك في محاربتي عنيفا",10,"ف",2,0],["وَسِّدوهُ التُرابَ نِضوَ سِفارٍ","في سَبيلِ الحُقوقِ نِضوَ سُهادِ",11,"د",1,0],["وسَدَّ أفْقَ السَّماءِ قَسطَلُهُ","فَخِيلَ دونَ السَّماءِ منه سَما",12,"م",2,0],["وسُدَّ عَنِ العافينَ مَهْيَعُهُمْ إلى","مَكارمَ كانت من أناملهِ تُسدى",13,"د",2,0],["وسِدْرةٌ نبعُها خضْدٌ، وساقيةٌ","وباسقُ النخلِ معقوفُ العراجين",14,"ن",1,0],["وسَدّ ثُغورَ المُلكِ بعدَ انثلامِها","وقد أظلمتْ تلك الخطوبُ الكوارث",15,"ث",1,0],["وَسَّدَتهُ ثِنيَ ساعِدِهِ","سِنَةٌ حَلَّت إِلى شَفرِه",16,"ر",2,0],["وَسَدَدتُ بِابي عَن عِدايَ ثَلاثَةً","خَوف البُكا وَالشامِتونَ جُلوسُ",17,"س",1,0],["وَسِدرَةُ المنتهى ماسَتْ لمقدَمِهِ","أفنانُها، وانثَنَتْ تِيهًا بُلقياهُ",18,"ا",2,0],["وسدد الدهر دوني كل شاحبة","زرقاء أسمى شباها فلذة الكبد",19,"د",1,0],["وسدَّتْ ثقوبَ الأرضِ مُحجرةً بها","فما غادرَتْ مأوىً لضبٍ ولا ثقبا",20,"ب",2,0],["وسدِّدْ من خُطاه اذا توانى","وجدِّدْ من قُواه اذا تََداعى",21,"ع",2,0],["وسُدي ثُلمةً من كل خَرْقٍ","يَزيدُ الخَرقُ شقتَّه اتساعا",21,"ع",2,0],["وسُدَّ الروُُاقُ ، فلا مَخرجٌ","وضاقَ الطريقُ ، فلا مَخرم",22,"م",1,0],["وسّدتك اليمنى لعلّي في غد","أرد الحساب ووجنتاك كتابي",23,"ب",2,0],["وسدت صدور القوم في كل حضرةٍ","بشأن وفي الديوان أعظمهم أسما",24,"م",2,0],["وسدوسا وإِثمداً وسيَالاً","ومهاةً وخيزراناً وريما",25,"م",2,0],["وَسَدُوساً وَأُقحُوانَاً وَرُمَّا","ناً وَكَشحاً مِنَ الحَريرِ هَضيمَا",26,"م",2,0],["وسدّدت أقوالاً يؤلّف حسنُها","إلى الضبِ في البيداءِ والنون في البحرِ",27,"ر",1,0],["وسدادٌ رأىُ العذول ولكن","ليس يُعِفى الغرامُ من قال حَسبي",28,"ب",2,0],["وَسَدّوا بِتَسديدِ الطِعانِ مِنَ العُلى","ثُغوراً تَوَلَّت كَشفَهُنَّ النَوائِبُ",29,"ب",1,0],["وسديدُ رأي لا يحرك فتنةً","سكنت وإن حركته الفتن اطمانْ",30,"ن",1,0],["وسدوا طريق الصلحي بيني وبينها","فما قبلت مني ولا سمعت عذري",31,"ي",1,0],["وسَدَّ الفضا بالنَّبْلِ حتى أعَادَني","أَسيرا إليها أَيْنَما كنتُ حائدا",32,"د",2,0],["وسدادُ رأىٍ أظهرتْ مرآتُه","لك ما يدِقُّ بما صَفا من صَقْلها",33,"ل",3,0],["وَسَّدْتُهُ عَضُدي فظلْتُ كأنما","أَطْلَعْتُ في عَضُدي سَنا الإصباح",34,"ح",1,0],["وسدوا رق المعالي وابق فردا","شهابا للانام به اهتداء",35,"ا",2,0],["وسدت على الأقران مذ سرت للعلا","مجدا فكنت السابق المتقدما",36,"م",2,0],["وَسَّدتُهُ كَفّي وَبا","تَ مُوَسِّدي خَدّاً وَسالِف",37,"ف",1,0],["وَسَّدتُهُ ساعِدي وَوَسَّدَني","خَدّاً لَهُ سَيفُ لَحظِهِ رَصَدُ",38,"د",1,0],["وَسَدادُ رَأيٍ لا يَضِل","لُ عَلى بَديهَتِهِ الصَوابُ",39,"ب",1,0],["وَسَدِّدْنِي وَأَيِّدْنِي","فيِ نُطْقِي وَفيِ ضَمْزِي",40,"ز",2,0],["وسدَّدَ من عطفَيهِ لَدناً مُثَقَّفاً","وناظُرهُ الفَّتانُ بالسِّحر عاملُه",41,"ل",2,0],["وسد من التجسيم باب ضلالةٍ","ورد من التشبيه شبهة باطل",42,"ل",1,0],["وَسُدْتَ فَما أَحَقَّ بِكُلِّ مَجْدٍ","سِواكَ إِذا تَفَرَّدَ مَنْ يَسُودُ",43,"د",1,0],["وَسُدُّوا الثُّغُورَ بِطَعْنِ النُّحُورِ","فَمِنْ حَقِّ ثَغْرٍ بِكُمْ أَنْ يُسَدّا",44,"د",2,0],["وَسَّدتُه زَندي وأَفرشَ زندَه","خدّي وَبتنا في أَلذِّ مَعاشِ",45,"ش",1,0],["وَسَدَّ عليَّ الطُرقَ من كُلِّ جانِبٍ","وهمَّ بما ضاقَت به ساحة الصَبرِ",46,"ر",1,0],["وَسدادٌ في الرأيِ والقول والفع","ل وعهدٌ بهِ الوفا ناطَ حَبله",47,"ل",2,0],["وَسَدادُ رَأيٍ أَعزَبَتهُ زُيودُهُم","وَسَوادُ ثغرٍ أَسلَمَتهُ عُمورُ",48,"ر",1,0],["وَسدّت مساعي بغيهم فتخبّطوا","تخبّط محبول بأشراكه رعبا",49,"ب",2,0],["وَسُد بِجُدِكَ فينا","وَدُس عَلى مَن تَمَرَّدِ",50,"د",1,0],["وسدت آمالك بطن الثرى","ولم توسد رأسك المثقلا",51,"ل",2,0],["وَسدتَ تَواضعاً وَنهىً وَحلماً","وَلا بدع إِذا سادَ الحَليمُ",52,"م",1,0],["وَسدَّت دونَ مَقصدك المَسالك","عَلَيكَ بِبابِهِ تَحظى بِيُسرٍ",53,"ر",1,0],["وَسَداد رَأيٍ حزمه يقضي بِهِ","في المُشكِلات بِدون أَن يَتَفَكّرا",54,"ر",2,0],["وسُدِّدَ دُونَها عِشرونَ ألْفاً","تَزعزعُ فَوقَهمْ عَذَبُ العَوالي",55,"ل",2,0],["وسَدِّدْ سهامكَ واشْدُدْ قُواك","تَجِدْ غَرضاً إنْ قضَى اللّهُ يُسرا",56,"ر",2,0],["وسُدَّت به أطرافُها وثُغورُها","وشُدَّت به أركانها وعقودُها",57,"د",3,0],["وسد عني جحيم عدلٍ","فتحت فاها على عتابي",58,"ب",2,0],["وَسُدَّت بِهارونَ الثُغورُ فَأُحكِمَت","بِهِ مِن أُمورِ المُسلِمينَ المَرائِرُ",59,"ر",1,1],["وسديدُ الآراءِ يبعَثُ عنها","أسهُماً لم تطِشْ عن الأغراضِ",60,"ض",1,0],["وسديدٌ في الرأي ليْنٌ ولكن","هو في النائبات جَلدٌ شديدُ",61,"د",1,0],[