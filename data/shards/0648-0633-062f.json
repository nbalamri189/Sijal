161865",""],[5147,"سبرت مقاييس العراق فلاح لي","https://www.poetsgate.com/ViewPoem.aspx?id=166736",""],[5186,"لا تعد بي إلى ربوع الخيام","https://www.poetsgate.com/ViewPoem.aspx?id=156442",""],[5187,"فرسان ميونيخ","https://www.poetsgate.com/ViewPoem.aspx?id=29246",""],[5387,"لمن أشكو؟","https://www.poetsgate.com/ViewPoem.aspx?id=53754",""],[5397,"بكيت شجواً على الأطلال والدمن","https://www.poetsgate.com/ViewPoem.aspx?id=157909",""],[5409,"يا زماني كأنما كل أيا","https://www.poetsgate.com/ViewPoem.aspx?id=155266",""],[5431,"الا اجتراحك في عشق إذا لفحا","https://www.poetsgate.com/ViewPoem.aspx?id=198342",""],[5442,"لعل حداة العيش أن يترفقوا","https://www.poetsgate.com/ViewPoem.aspx?id=114754",""],[5464,"سميرَ الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=125410",""],[5518,"سِدرةُ المنتهَى","https://www.poetsgate.com/ViewPoem.aspx?id=206241",""],[243,"ثورة 14 رمضان","https://www.poetsgate.com/ViewPoem.aspx?id=19625",""],[5800,"بآراء أرباب العقول الزكية","https://www.poetsgate.com/ViewPoem.aspx?id=124952",""],[5956,"ما هو القصيد","https://www.poetsgate.com/ViewPoem.aspx?id=185814",""],[5977,"جفاء الأصحاب","https://www.poetsgate.com/ViewPoem.aspx?id=213121",""],[6142,"إذا ما سهام الدهر أغرق نزعها","https://www.poetsgate.com/ViewPoem.aspx?id=155756",""],[6152,"مناجاة رمضانية","https://www.poetsgate.com/ViewPoem.aspx?id=204731",""],[5309,"دعني اقبل وجنتيك","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573770",""],[6270,"لنا حجرٌ ودون الموت صدرٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69080&r=&rc=4",""],[6318,"القدس في خطر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66164&r=&rc=14",""]],"verses":[["وَسَدَّدَ مِن دوني سِناناً كَأَنَّهُ","إِلى الطَعنِ نابٌ يُقلِسُ السُمَّ قاطِرُ",0,"ر",1,0],["وَسُدَّ طَريقُ المَجدِ عَن كُلِّ سالِكٍ","وَضاقَت عَلى الآمالِ هَذي المَوارِدُ",1,"د",1,0],["وَسَدَّ خِصاصَ الخِدرِ طَرفٌ وَمَسمَعٌ","وَنَحرٌ وَخَدٌّ واضِحٌ وَجَبينُ",2,"ن",1,0],["وسَدّدَ الدّهْرُ دوني كلَّ شاحِبةٍ","زَرْقاءَ أصْمى شَباها فِلْذَةَ الكَبِدِ",3,"د",1,0],["وَسَدَت مُهَملِجَةً عُلالَةَ مُدمَجٍ","مِن فالِقٍ حَصِدٍ مِنَ الإِمرارِ",4,"ر",1,0],["وسدّ علينا الاعتشافُ طريقَنا","فأجحف بالغَوْريّ والمتنجِّد",5,"د",1,0],["وَسُدَّ عَلَيهِ كُلُّ أَمرٍ يُريدُهُ","وَزيدَ وَثاقاً فَاِقفَعَلَّت أَصابِعُه",6,"ع",2,0],["وسدت إلى أن سرّا سعدُ في الثرى","بسؤدَدِكَ الوضاح بل سر يعرب",7,"ب",1,0],["وسدت على نجل الحسين بمدحِ من","سأثقلُ أفراسي بنعماه عسجدا",8,"د",2,0],["وسداد رأي لا تخاف صفاته","لكن متى يخدعه عاف يخدع",9,"ع",1,0],["وسدِّد في معاملتي وقارب","ولا تك في محاربتي عنيفا",10,"ف",2,0],["وَسِّدوهُ التُرابَ نِضوَ سِفارٍ","في سَبيلِ الحُقوقِ نِضوَ سُهادِ",11,"د",1,0],["وسَدَّ أفْقَ السَّماءِ قَسطَلُهُ","فَخِيلَ دونَ السَّماءِ منه سَما",12,"م",2,0],["وسُدَّ عَنِ العافينَ مَهْيَعُهُمْ إلى","مَكارمَ كانت من أناملهِ تُسدى",13,"د",2,0],["وسِدْرةٌ نبعُها خضْدٌ، وساقيةٌ","وباسقُ النخلِ معقوفُ العراجين",14,"ن",1,0],["وسَدّ ثُغورَ المُلكِ بعدَ انثلامِها","وقد أظلمتْ تلك الخطوبُ الكوارث",15,"ث",1,0],["وَسَّدَتهُ ثِنيَ ساعِدِهِ","سِنَةٌ حَلَّت إِلى شَفرِه",16,"ر",2,0],["وَسَدَدتُ بِابي عَن عِدايَ ثَلاثَةً","خَوف البُكا وَالشامِتونَ جُلوسُ",17,"س",1,0],["وَسِدرَةُ المنتهى ماسَتْ لمقدَمِهِ","أفنانُها، وانثَنَتْ تِيهًا بُلقياهُ",18,"ا",2,0],["وسدد الدهر دوني كل شاحبة","زرقاء أسمى شباها فلذة الكبد",19,"د",1,0],["وسدَّتْ ثقوبَ الأرضِ مُحجرةً بها","فما غادرَتْ مأوىً لضبٍ ولا ثقبا",20,"ب",2,0],["وسدِّدْ من خُطاه اذا توانى","وجدِّدْ من قُواه اذا تََداعى",21,"ع",2,0],["وسُدي ثُلمةً من كل خَرْقٍ","يَزيدُ الخَرقُ شقتَّه اتساعا",21,"ع",2,0],["وسُدَّ الروُُاقُ ، فلا مَخرجٌ","وضاقَ الطريقُ ، فلا مَخرم",22,"م",1,0],["وسّدتك اليمنى لعلّي في غد","أرد الحساب ووجنتاك كتابي",23,"ب",2,0],["وسدت صدور القوم في كل حضرةٍ","بشأن وفي الديوان أعظمهم أسما",24,"م",2,0],["وسدوسا وإِثمداً وسيَالاً","ومهاةً وخيزراناً وريما",25,"م",2,0],["وَسَدُوساً وَأُقحُوانَاً وَرُمَّا","ناً وَكَشحاً مِنَ الحَريرِ هَضيمَا",26,"م",2,0],["وسدّدت أقوالاً يؤلّف حسنُها","إلى الضبِ في البيداءِ والنون في البحرِ",27,"ر",1,0],["وسدادٌ رأىُ العذول ولكن","ليس يُعِفى الغرامُ من قال حَسبي",28,"ب",2,0],["وَسَدّوا بِتَسديدِ الطِعانِ مِنَ العُلى","ثُغوراً تَوَلَّت كَشفَهُنَّ النَوائِبُ",29,"ب",1,0],["وسديدُ رأي لا يحرك فتنةً","سكنت وإن حركته الفتن اطمانْ",30,"ن",1,0],["وسدوا طريق الصلحي بيني وبينها","فما قبلت مني ولا سمعت عذري",31,"ر",2,0],["وسَدَّ الفضا بالنَّبْلِ حتى أعَادَني","أَسيرا إليها أَيْنَما كنتُ حائدا",32,"د",2,0],["وسدادُ رأىٍ أظهرتْ مرآتُه","لك ما يدِقُّ بما صَفا من صَقْلها",33,"ل",3,0],["وَسَّدْتُهُ عَضُدي فظلْتُ كأنما","أَطْلَعْتُ في عَضُدي سَنا الإصباح",34,"ح",1,0],["وسدوا رق المعالي وابق فردا","شهابا للانام به اهتداء",35,"ا",2,0],["وسدت على الأقران مذ سرت للعلا","مجدا فكنت السابق المتقدما",36,"م",2,0],["وَسَّدتُهُ كَفّي وَبا","تَ مُوَسِّدي خَدّاً وَسالِف",37,"ف",1,0],["وَسَّدتُهُ ساعِدي وَوَسَّدَني","خَدّاً لَهُ سَيفُ لَحظِهِ رَصَدُ",38,"د",1,0],["وَسَدادُ رَأيٍ لا يَضِل","لُ عَلى بَديهَتِهِ الصَوابُ",39,"ب",1,0],["وَسَدِّدْنِي وَأَيِّدْنِي","فيِ نُطْقِي وَفيِ ضَمْزِي",40,"ز",2,0],["وسدَّدَ من عطفَيهِ لَدناً مُثَقَّفاً","وناظُرهُ الفَّتانُ بالسِّحر عاملُه",41,"ل",2,0],["وسد من التجسيم باب ضلالةٍ","ورد من التشبيه شبهة باطل",42,"ل",1,0],["وَسُدْتَ فَما أَحَقَّ بِكُلِّ مَجْدٍ","سِواكَ إِذا تَفَرَّدَ مَنْ يَسُودُ",43,"د",1,0],["وَسُدُّوا الثُّغُورَ بِطَعْنِ النُّحُورِ","فَمِنْ حَقِّ ثَغْرٍ بِكُمْ أَنْ يُسَدّا",44,"د",2,0],["وَسَّدتُه زَندي وأَفرشَ زندَه","خدّي وَبتنا في أَلذِّ مَعاشِ",45,"ش",1,0],["وَسَدَّ عليَّ الطُرقَ من كُلِّ جانِبٍ","وهمَّ بما ضاقَت به ساحة الصَبرِ",46,"ر",1,0],["وَسدادٌ في الرأيِ والقول والفع","ل وعهدٌ بهِ الوفا ناطَ حَبله",47,"ل",2,0],["وَسَدادُ رَأيٍ أَعزَبَتهُ زُيودُهُم","وَسَوادُ ثغرٍ أَسلَمَتهُ عُمورُ",48,"ر",1,0],["وَسدّت مساعي بغيهم فتخبّطوا","تخبّط محبول بأشراكه رعبا",49,"ب",2,0],["وَسُد بِجُدِكَ فينا","وَدُس عَلى مَن تَمَرَّدِ",50,"د",1,0],["وسدت آمالك بطن الثرى","ولم توسد رأسك المثقلا",51,"ل",2,0],["وَسدتَ تَواضعاً وَنهىً وَحلماً","وَلا بدع إِذا سادَ الحَليمُ",52,"م",1,0],["وَسدَّت دونَ مَقصدك المَسالك","عَلَيكَ بِبابِهِ تَحظى بِيُسرٍ",53,"ر",1,0],["وَسَداد رَأيٍ حزمه يقضي بِهِ","في المُشكِلات بِدون أَن يَتَفَكّرا",54,"ر",2,0],["وسُدِّدَ دُونَها عِشرونَ ألْفاً","تَزعزعُ فَوقَهمْ عَذَبُ العَوالي",55,"ل",2,0],["وسَدِّدْ سهامكَ واشْدُدْ قُواك","تَجِدْ غَرضاً إنْ قضَى اللّهُ يُسرا",56,"ر",2,0],["وسُدَّت به أطرافُها وثُغورُها","وشُدَّت به أركانها وعقودُها",57,"د",3,0],["وسد عني جحيم عدلٍ","فتحت فاها على عتابي",58,"ب",2,0],["وَسُدَّت بِهارونَ الثُغورُ فَأُحكِمَت","بِهِ مِن أُمورِ المُسلِمينَ المَرائِرُ",59,"ر",1,1],["وسديدُ الآراءِ يبعَثُ عنها","أسهُماً لم تطِشْ عن الأغراضِ",60,"ض",1,0],["وسديدٌ في الرأي ليْنٌ ولكن","هو في النائبات جَلدٌ شديدُ",61,"د",1,0],["وسُدِكْتُ بالغَمَرَاتِ حَتَّى بَلَّدَتْ","فَرَمَيْنَ حَبْلِي فَوْقَ ذِرْوَةِ غارِبِ",62,"ب",1,0],["وسَّدَتْ فوقها السقاةُ خدوداً","دامياتٍ منها مكان الفدام",63,"م",1,0],["وسُدْتَ بنفسٍ حِلمُها دون بطشها","وسلطانُها مُولىً عليهِ بتقواها",64,"ا",3,0],["وسُدَّ بفضلِ همّتك اختلالي","وقد جلَّت عن النَّصْح الخروقُ",65,"ق",1,0],["وسدّ بهيبته في الصدور","مسَدَّ الظُّبا والقنا الشُّرَّعِ",66,"ع",1,0],["وسَدّت عليك مَجازَ الطري","ق مسحبةُ الأرقمِ الأدلعِ",66,"ع",1,0],["وسدَّدتَ أكثر خَلّاتِيَ ال","رِغاب فلو قد سددت الجميعا",67,"ع",2,0],["وسدَّ بجوده خَلاَّتِ حالي","وقد ضعفتْ على الخَرْقِ النُّصوحُ",68,"ح",1,0],["وسدّيتَ عندي نعمةً ليس ناهضاً","ثنائي بها ما لم أجدك مُسامحا",69,"ح",2,0],["وسددي رأيهُ في كل مُعْضلةٍ","حتى تؤول إِلى أمْنٍ محاذرهُ",70,"ر",2,0],["وسُدَّ الفَضا عن ناظرٍ مُتأمِّلٍ","فلست ترى إلاَّ سِناناً ومِخْذَما",71,"م",2,0],["وسديدُ رمح القدِّ ينجدُ قومهُ","في حيث نبتُ الخطِّ غيرُ سديد",72,"د",1,0],["وسدَّد أسهمَ أقلامهِ","وضاعف بالجود سرد الجنن",73,"ن",1,0],["وسديدٌ بالصب لا يأسه","يُغنيه في حبه ولا إطماعه",74,"ع",2,0],["وسدى خيوط المزن يرسلها الحيا","أبداً وأكمام النبات تفتق",75,"ق",1,0],["وسدَّ كلَّ طريقٍ لا دُخولَ له","على الرَّسولِ فأُمُّ الغيِّ خنساءُ",76,"ا",2,0],["وسددتم بالنقد خلة فقره","وسترتم كرماً معائب نقده",77,"د",2,0],["وسدت عليه الأرض صولتك التي","مهابتها سور على الأرض دائر",78,"ر",1,0],["وسَدادُ الآراءِ منه يُرِى العَي","نَ مثالَ الأشياءِ قَبلَ المآلِ",79,"ل",1,0],["وَسَّدني كفَّهُ وعانقني","ونحن ف