],[367,"أأحبابنا قد شقتمونا فأسعدوا","https://www.aldiwan.net/poem60942.html","الطويل"],[369,"وحوشي أن يقال لها عتابي","https://www.aldiwan.net/poem17143.html","الوافر"],[405,"أبثك فرط اشتياق إليك","https://www.aldiwan.net/poem46535.html","المتقارب"],[405,"إلى غيركم قلبي المتيم لا يصبو","https://www.aldiwan.net/poem46662.html","الطويل"],[405,"لكسب العلى فاجعل همومك تحمد","https://www.aldiwan.net/poem46939.html","الطويل"],[409,"هي البدر لكن تستر مدى الدهر","https://www.aldiwan.net/poem50169.html","الطويل"],[409,"تعاتب سعدى أن تنقل دارها","https://www.aldiwan.net/poem50172.html","الطويل"],[409,"ألم وليلي بالكواكب أشيب","https://www.aldiwan.net/poem50207.html","الطويل"],[419,"تذكر عهدا بالحمى قد تقدما","https://www.aldiwan.net/poem53977.html","الطويل"],[419,"سقاك الحيا من أربع وطلول","https://www.aldiwan.net/poem54049.html","الطويل"],[419,"جلا في الكأس جالية الهموم","https://www.aldiwan.net/poem54058.html","الوافر"],[432,"إلى الروم أصبو كلما أومض الخال","https://www.aldiwan.net/poem40048.html","الطويل"],[432,"لك الهناء بنيل المجد والنعم","https://www.aldiwan.net/poem40798.html","البسيط"],[432,"الحمد لله الذي قد حللا","https://www.aldiwan.net/poem40815.html","الرجز"],[435,"صدرنا وقد نادى السماح بنا ردوا","https://www.aldiwan.net/poem12450.html","الطويل"],[435,"طلعت ربيعا من ربيع وأربع","https://www.aldiwan.net/poem12659.html","الطويل"],[440,"دعوا مقلتي تغفي إذا لم يكن وصل","https://www.aldiwan.net/poem2512.html","الطويل"],[440,"لهم حب قلبي إن تدانوا وإن صدوا","https://www.aldiwan.net/poem2622.html","الطويل"],[442,"سماء العلا منكم وأنت لها بدر","https://www.aldiwan.net/poem34843.html","الطويل"],[444,"نجمع والمجموع يكلا ويترك","https://www.aldiwan.net/poem14471.html","الطويل"],[454,"لك الطائر الميمون فاسرج به طرفا","https://www.aldiwan.net/poem13844.html","الطويل"],[460,"على مثلها كان العلاء يحوم","https://www.aldiwan.net/poem55895.html","الطويل"],[463,"ألا حبذا مسعى تميم بن خندف","https://www.aldiwan.net/poem15149.html","الطويل"],[463,"سل الحي عني هل أناخت خسيفة","https://www.aldiwan.net/poem15293.html","الطويل"],[463,"أطعت النهى في نجدتي وبياني","https://www.aldiwan.net/poem15465.html","الطويل"],[463,"لئن ذاد مدحي بأس عذر فانني","https://www.aldiwan.net/poem15485.html","الطويل"],[463,"واني وان لم يدرك الشعر وصفه","https://www.aldiwan.net/poem15589.html","الطويل"],[463,"وإني ومدحي أبا جعفر","https://www.aldiwan.net/poem16149.html","المتقارب"],[463,"وإني وإن كف الأسى غرب مقولي","https://www.aldiwan.net/poem16393.html","الطويل"],[463,"وإني وإن لم تنصفوا في حكومتي","https://www.aldiwan.net/poem16404.html","الطويل"],[463,"وإني ومدح الفارس الشهم يزدن","https://www.aldiwan.net/poem16415.html","الطويل"],[466,"شهيدا غرامي ادمعي وسجومها","https://www.aldiwan.net/poem3217.html","عموديه"],[466,"لذاك الحبيب وهذي الدمن","https://www.aldiwan.net/poem3319.html","عموديه"],[468,"ألا بأبي من قد برى الجسم حبه","https://www.aldiwan.net/poem50472.html","الطويل"],[472,"ألا لا تلمه اليوم أن يتبلدا","https://www.aldiwan.net/poem4657.html","الطويل"],[479,"يقر بعيني أن أرى الربع والدارا","https://www.aldiwan.net/poem15252.html","الطويل"],[479,"هوى بين أحناء الضلوع دفين","https://www.aldiwan.net/poem15260.html","الطويل"],[479,"متى حان من شمس النهار غروب","https://www.aldiwan.net/poem15325.html","الطويل"],[515,"وأني وإن شاعت لديك سرائري","https://www.aldiwan.net/poem67728.html","الطويل"],[517,"سرى لك عرف في النسيم الذي سرى","https://www.aldiwan.net/poem12108.html","الطويل"],[517,"حرام على قلبي يرى وهو ساكن","https://www.aldiwan.net/poem12286.html","الطويل"],[518,"وإني وإياهم كساع لقاعد","https://www.aldiwan.net/poem48630.html","الطويل"],[529,"أكل بناءٍ أنت بانيه معجز","https://www.aldiwan.net/poem45542.html","الطويل"],[542,"وإني وإن كانت مراضا صدوركم","https://www.aldiwan.net/poem56814.html","الطويل"],[542,"تعلقتها وإناء الشباب","https://www.aldiwan.net/poem56872.html","المتقارب"],[548,"ألا يا اسلمي لا صرم لي اليوم فاطما","https://www.aldiwan.net/poem1864.html","الطويل"],[553,"عتاب لدهر لا يمل عتابي","https://www.aldiwan.net/poem48065.html","الطويل"],[555,"وإني وإسماعيل يوم وداعه","https://www.aldiwan.net/poem68272.html","الطويل"],[555,"وإني لأستحي السؤال ومذهبي","https://www.aldiwan.net/poem68370.html","الطويل"],[565,"غرام سقى قلبي مدامته صرفا","https://www.aldiwan.net/poem13596.html","الطويل"],[566,"أجودُ ابن زين أو غيوثُ سواجم","https://www.aldiwan.net/poem890.html",""],[571,"أرى كل ريح سوف تسكن مرة","https://www.aldiwan.net/poem52004.html","الطويل"],[627,"","https://poetry.dctabudhabi.ae/diwan/poem/21183","الطويل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/29471","الوافر"],[860,"","https://poetry.dctabudhabi.ae/diwan/poem/17738","الطويل"],[1043,"","https://poetry.dctabudhabi.ae/diwan/poem/27100","الطويل"],[1061,"","https://poetry.dctabudhabi.ae/diwan/poem/21393","الطويل"],[1098,"","https://poetry.dctabudhabi.ae/diwan/poem/20932",""],[1132,"","https://poetry.dctabudhabi.ae/diwan/poem/18998","الطويل"],[1162,"","https://poetry.dctabudhabi.ae/diwan/poem/28933","الطويل"]],"verses":[["وَإِنّي وَالمَواعِدُ كاذِباتٌ","لَيُطمِعُنا خِلابُ الواعِدينا",0,"ن",2,0],["وَإِنّي وَإِن والى عَلى القَلبِ حَربَهُ","لمُنتَظِرٌ أَن يَعقُبَ الحَربَ سِلمُهُ",1,"م",2,0],["وَإِنّي وَإِن كُنتُمُ في البِلا","دِ أَنأى دِياراً وَأَبدى خِياما",2,"م",2,0],["وَإِنّي وَإِن قَلّوا لِمُستَمسِكٌ بِهِم","وَقَد تُمسِكُ الساقَ المَهيضَ الجَبائِرُ",3,"ر",1,0],["وَإِنّي وَإِن كُنتُ مِن أَهلِهِ","لَتُنكِرُني حِرفَةُ الشاعِرِ",4,"ر",1,0],["وَإِنّي وَهوَ في خَيشومِ مَجدٍ","تَنَفَّسَ عَن نَسيمٍ مِن وِدادِ",5,"د",1,0],["وَإِنّي وَإِن كانَ الهَوى يَستَفِزُّني","لَذو مِرَّةٍ قَطّاعَةٍ لِلقَرائِنِ",6,"ن",1,0],["وَإنّي وَإِنْ نَالَ مِنِّي الزَّمانُ","وَنَحْنُ كَذلك سُؤْرُ النُّوَبْ",7,"ب",1,0],["وإني وإنْ ضَعْضَعَتْني الخُطوبُ","لأَنْفُضُ عنْ فَضْلِ بُرْدَيَّ هُونا",8,"ن",2,0],["وَإِنّي وَإِيّاها كَما شَفَّنا الهَوى","لَأَهلُ حِفاظٍ لا يُدَنَّسُ بِالجَهلِ",9,"ل",1,0],["وَإِنّي وَكِتماني هَواها وَقَد فَشا","كَذي الجَهلِ تَحتَ الثَوبِ يَضرِبُ بِالطَبلِ",9,"ل",1,0],["وَإِنّي وَإِيّاها عَلى غَيرِ رِقبَةٍ","وَتَفريقِ شَملٍ لَم نَبِت لَيلَةً مَعا",10,"ع",2,0],["وَإِنِّي وَإِنْ أَزْمَعْتُ عَنْكَ لطِيَّة","وَقَوَّضْتُ رَحْلِي عَنْكَ دُونَ تَلَوُّمِ",11,"م",1,0],["وإنّي وإنْ أطْنَبْتُ فيكَ لَقاصِرٌ","ومَنْ بلغَ المَجْهودَ قد بانَ عُذْرُهُ",12,"ر",2,0],["وإنّي وإنْ أطْنَبْتُ فيكَ لَقاصِرٌ","ومَنْ ذا يُطيقُ الرّمْلَ بالحَصْرِ والعَدِّ",13,"د",1,0],["وَإِنّي وَما كَلَّفتُموني وَرَبِّكُم","لَيَعلَمَ مَن أَمسى أَعَقَّ وَأَحرَبا",14,"ب",2,0],["وَإِنِّي وَلَو داما لأَعلَمُ أَنَّني","لِحُفرَةِ مَوتٍ مَرَّةً لَدَفينُ",15,"ن",1,0],["وَإِنّي وَإِن أَعرَضتُ عَنها تَجَلُّداً","عَلى العَهدِ فيما بَينَنا لَمُقيمُ",16,"م",1,0],["وَإِنّي وَإِن شَطَّت نَواها لِحافِظٌ","لَها حَيثُ حَلَّت وَاِستَقَرَّ قَرارُها",17,"ر",3,0],["وَإِنّي وَإِن صَدَّت لَمُثنٍ وَصادِقٌ","عَلَيها بِما كانَت إِلَينا أَزَلَّتِ",18,"ت",1,0],["وَإِنّي وَتَهيامي بِعَزَّةَ بَعدَما","تَخّلَّيتُ مِمّا بَينَنا وَتَخَلَّتِ",18,"ت",1,0],["وإِنِّي وَلوصَاحَ الوُشاةُ وَطَرَّبوا","لَمُتَّخِذٌ سُعدى شَبابًا فَناسِبُ",19,"ب",1,0],["وَإِنّي وَالبُكا مِن بَعدِ صَخرٍ","كَسالِكَةٍ سِوى قَصدِ الطَريقِ",20,"ق",1,0],["وَأَنْ يُؤَجِّجَ نَاراً مِنْ حَمِيَّتِهِمْ","وَأَنْ يَرُدَّ فِرَِنْدَ الصَّبْرِ مَثْلُومَا",21,"م",2,0],["وإني وإن كنتُ الأبيَّ قيادُهُ","لَيَأْمُرني حبُّ الحسان وينهاني",22,"ن",2,0],["وإني وإن كنت الأخير زمانُه","لآتٍ بما لم تستطعه الأوائلُ",23,"ل",1,0],["وإنّي وإن كنت الممنّعَ جارُهُ","لتسبي فؤادي أعين وثغورُ",24,"ر",1,0],["وإن يوماً نقضوا عهدهم","فيه ليوم خزيه مبتكر",25,"ر",1,0],["وإني وإن لم أحظ منه برؤية","ليشهد لي من عادل فيه شاهد",26,"د",1,0],["وَإِنّي وَقَيساً يا اِبنَ قَينِ مُجاشِعٍ","كَريمٌ أُصَفّي مِدحَتي لِلأَكارِمِ",27,"م",1,0],["وَإِنّي وَإِن كانَت إِلى الشامِ نِيَّتي","يَماني الهَوى أَهلَ المَجازَةِ آلِفُ",28,"ف",1,0],["وَإِنّي وَإِن طالَ الثَواءُ لَمَيِّتٌ","وَيَعطِمُني ماوِيَّ بَيتٌ مُسَقَّفُ",29,"ف",1,0],["وَإِنّي وَإِيّاهُ لَعَينٌ وَأُختُها","وَإِنّي وَإِيّاهُ لَكَفٌّ وَمِعصَمُ",30,"م",1,0],["وإني وإن شيبتْ حياتي وأعرَضوا","وحقكَ ما ليَ غير بابك باب",31,"ب",1,0],["وإني وإنْ أخرتُ سعياً لأرتجي","عوائد من نعماه تسعى بها البرد",32,"د",1,0],["وإني وإن باكرتُ بالمدح منشداً","لداعٍ بأستار الأجنة ضارع",33,"ع",1,0],["وإنِّي وإن عِيقت عن السعي حجَّتي","إلى وقفةٍ في ذلك الباب مشتاق",34,"ق",1,0],["وإنِّي وإن كنت الأخير غرامه","لآتٍ بما لم تستطعه الأوائل",35,"ل",1,0],["وإني وإن أحسنت سلوة فاقدٍ","لمضمر شجوٍ مثخن بنصاله",36,"ل",2,0],["وإني وذكري ما حويت من الثنا","كمن رام تعداد القطار التي تهمي",37,"م",2,0],["وَإِنّي وَإِن أُهجِرتُ فَالهَجرُ صاحِبي","وَكَيفَ يَصِحُّ الهَجرُ وَالحُبُّ واحِدُ",38,"د",1,0],["وإنِّي وإن مُتِّعْتُ بابْنيَّ بَعْده","لَذاكرُه ما حنَّتِ النِّيبُ في نَجْدِ",39,"د",1,0],["وإني وإن أضحى لسانيَ جاحداً","لذو مدْمعٍ يُضْحي وليس بجاحدِ",40,"د",1,0],["وإني وإنْ جفني تقادم عهده","لأمضي مضاءَ المَشرفيِّ المذكَّر",41,"ر",1,0],["وإني وإن أخلفتُ وعدَك لَلَّذي","وفَى لك منه جَهْرهُ والسرائر",42,"ر",1,0],["وإني ودوني الشمسُ في بيت عزّها","وقابٌ تعاطاه العيون فتقصُر",43,"ر",1,0],["وإني وإن دارتْ علي دوائرٌ","لأُعرضُ عمَّن صدَّ عني وأعرَضا",44,"ض",2,0],["وإني وصدق المرء من خير قوله","لراضٍ بحظي من ضميرك قانعُ",45,"ع",1,0],["وإني وإنْ أضحى مُدِلّاً بماله","لآمُلُ أن أُلفَى مُدِلّاً بمالكا",46,"ك",2,0],["وإني وإنْ لم تأتني وحجبتَني","لأَعتدُّك النصلَ المُبرَّ على النصلِ",47,"ل",1,0],["وإنِّي وإنْ أهْدَى أُساه لساخطٌ","عليه ولكن هل من الدهر منتقمْ",48,"م",1,0],["وإني وقد زوَّدتِني منكِ لوْعةً","لها وقْدة في القلبِ كالنارِ في الضرمْ",48,"م",1,0],["وإني وقد زودتني منك لوعةً","مُحالفةً للقلب ما أورق السَّلَمْ",48,"م",1,0],["وإني وقدْ آب لا خائباً","ولا حاملاً ثقَلَ الآثمِ",49,"م",1,0],["وَإِنّي وَإِيّاها إِذا ما لَقيتُها","لَكَالماءِ مِن صَوبِ السَحابَةِ وَالخَمرِ",50,"ر",1,0],["وَإِنّي وَإِن فَضَّلتُ تَغلِبَ بِالقِرى","إِذا أَصبَحَت غَبراءَ ذاتَ قَتامِ",51,"م",1,0],["وَإِنّي وَإِن شَطَّت نَواها بِوِدِّها","لَصُلبُ التَعَزّي مُستَمِرُّ الشَكائِمِ",52,"م",1,0],["وَإِنّي وَإِيّاهُ كَما قالَ قائِلٌ","رَفيقُكَ قَيسِيٌّ وَأَنتَ يَماني",53,"ن",2,0],["وَإِنّي وَإِن أَعطَيتُ في القَولِ بَسطَةً","وَطاوَعَني هَذا الكَلامُ المُحَبَّرُ",54,"ر",1,0],["وَإِنّي وَإِن كانَت أَياديكَ جَمَّةً","عَلَيَّ فَإِنّي عَبدُها وَشَكورُها",55,"ر",3,0],["وَإِنّي وَإِن هَزَّ الغَرامُ مَعاطِفي","لَآبى الدَنايا نَخوَةً وَتَعَرُّبا",56,"ب",2,0],["وَإِنّي وَإِن كُنتُ المُسيءَ فَإِنَّني","عَلى كُلِّ حالاتي لَهُ مِنهُ أَنصَحُ",57,"ح",1,0],["وَإِنّي وَذِكرايَ اِبنَ حَربٍ لَعائِدٌ","لِخُلَّةِ مَرعِيِّ الأَمانَةِ واصِلِ",58,"ل",1,0],["وَإِنّي وَتَكراري الزِيارَةَ نَحوَكُم","لَبَينَ يَدَي هَجرٍ بُثَينَ طَويلِ",59,"ل",1,0],["وَإِنّي وَلا مَنٌّ عَلَيكَ بِطاعَةٍ","أُجِلُّ وَأُغلي في الفُروضِ زَكاتي",60,"ت",2,0],["وَأَنّي وَفَيتُ وَأَنّي أَبَيتُ","وَأَنّي عَتَوتُ عَلى مَن عَتا",61,"ا",1,0],["وَإِنّي وَإِن كانَ الدَفينُ حَبيبَهُ","حَبيبٌ إِلى قَلبي حَبيبُ حَبيبي",62,"ب",2,0],["وَإِنّي وَإِن نِلتُ السَماءَ لَعالِمٌ","بِأَنَّكَ ما نِلتَ الَّذي يوجِبُ القَدرُ",63,"ر",1,0],["وإني وإنْ لم أكنْ مُثْرِياً","لَيصغُرُ عندي ثَراءُ الِلئَامِ",64,"م",1,0],["وَإِنّي وَإِن رابَ الغَواني تَماسُكي","لَمُستَهتِرٌ بِالوَصلِ مِنهُنَّ مُستَهوى",65,"و",2,0],["وَأَن يوجَدَ السِحرُ في طَرفِهِ","وَأَن يُجتَنى الوَردُ مِن خَدِّهِ",66,"د",2,0],["وَإِنّي وَإِن أَمَّلتُ في جودِكَ الغِنى","لَبالِغُ ما أَمَّلتُ مِنكَ وَزائِدُ",67,"د",1,0],["وَإِنّي وَجَدتُ فَلا تَكذَبَنَّ","سَوادَ الهَوى في بَياضِ الشَعَر",68,"ر",1,0],["وَإِنّي وَإِن بَلَّغتَني شَرَفَ العُلا","وَأَعتَقتَ مِن ذُلِّ المَطالِعِ أَخدَعي",69,"ع",2,0],["وَإِنّي وَإِن ضَنَّت عَلَيَّ بِوُدِّها","لَأَرتاحُ مِنها لِلخَيالِ المُؤَرِّقِ",70,"ق",1,0],["وَإِنّي وَذاتَ الخالِ في حالِ مُغرَمٍ","يَزيدُ غَراماً مِن جَوانِحِ خالِ",71,"ل",1,0],["وَإِنّي وَكِتماني هَواها وَقَد فَشا","كَذي الجَهلِ تَحتَ الشَوبِ يَضرِبُ بِالطَبلِ",72,"ل",1,0],["وَإِنّي وَإِيّاكُم وَمَن في حِبالِكُم","كَمَن حَبلُهُ في رَأسِ نيقٍ مُعَرِّدِ",73,"د",1,0],["وَإِنّي وَالَّذي حَجَّت قُرَيشٌ","لَهُ الأَيّامَ تابِعَةَ اللَيالي",74,"ل",2,0],["وَإِنّي وَإِيّاها كَمَن لَيسَ واجِداً","سِواها لِما قَد أَنطَفَتهُ مُداوِيا",75,"ي",2,0],["وَإِنّي وَمَن قَد ماتَ قَبلي لَكَالَّذي","يَزورُ خَليلاً أَو يُروحُ وَيَغتَدي",76,"د",2,0],["وَإِنّي وَإِن أَصبَحتُ بِالمَوتِ موقِناً","فَلي أَمَلٌ دونَ اليَقينِ طَويلُ",77,"ل",1,0],["وَإِنّي وَإِن ساءَني فِعلُهُ","وَأَصبَحَ بَعدَ الوَفا مُعرِضا",78,"ض",2,0],["وَإِنّي وَإِن أَغلَظتُ في القَولِ مَرَّةً","عَليكُم لِأَمرٍ ضاقَ عَن حَملِهِ صَدري",79,"ر",2,0],["وَإِنّي وَإِن فارَقتُ مَغناكَ مُخطِئاً","لَأَعلَمُ أَنّي كُنتُ في ذاكَ خاطِيا",80,"ي",2,0],["وإنّ يوماً واحداً","حِبَالُه مُقطَّعه",81,"ع",2,0],["وإنّي وإنْ أصبحتُ منها مسُلَّماً","لأكْثرُ قوْلي ليتَ شعريَ هل أُمسي",82,"س",2,0],["وأنّى وفي عُقْبَى الشبابِ عقوبةٌ","أُسَرّ بها بئس السرورُ وأَفرحُ",83,"ح",1,0],["وَإِنِّي وَإِنْ طَالَ الْمِطَالُ لَوَاثِقٌ","بِرَحْمَةِ رَبِّي فَهْوَ ذُو الطَّوْلِ وَالْمَنِّ",84,"ن",1,0],["وَإِنِّي وَإِنْ كُنْتُ الْمُسَالِمَ فِي الْهَوَى","لَذُو تُدْرَإ فِي النَّائِبَاتِ خَصِيمُ",85,"م",1,0],["وَإِنّي وَالنَسيمُ بِها لَذيذٌ","لَمُشتَمِلٌ عَلى نَفسٍ مُذيبِ",86,"ب",1,0],["وَإِنّي وَإِن جِئتُ المَشيبَ لَمولَعٌ","بِطُرَّةِ ظِلٍّ فَوقَ وَجهِ غَديرِ",87,"ر",1,0],["وَإِنّي وَعَيني بِالظَلامِ كَحيلَةٌ","لَآبى لِجَنبي أَن يُلائِمَ مَضجَعا",88,"ع",2,0],["وَإِنّي وَمَجدِكَ ما راقَني","كَمَجدِكَ أَعزِز بِهِ مَن قاسَم",89,"م",1,0],["وَإِنِّيَ وَلهانٌ بِها وَمُتَيَّمٌ","وَنيرانُ قَلبي في الفُؤادِ سَعيرُها",90,"ر",3,0],["وَإِنّي وَإِن لَم آتِ لَيلى وَأَهلَها","لَباكٍ بُكا طِفلٍ عَلَيهِ التَمائِمُ",91,"م",1,1],["وَإِنّي وَذاكَ الهَجرَ ما تَعلَمينَهُ","كَعازِبَةٍ عَن طِفلِها وَهيَ رائِمُ",91,"م",1,0],["وَإِنّي وَإِن غالَ التَقادُمُ حاجَتي","مُلِمٌّ عَلى أَوطانِ لَيلى فَناظِرُ",92,"ر",1,0],["وَإِنّي وَإِن لَم يَبقَ لي دونَكُم سِوى","حَديثِ الأَماني مَوعِداً بَعدَ مَوعِدِ",93,"د",1,0],["وَإِنّي وَلا عِلمٌ لَأَعلَمُ أَنَّني","سَأَلقى سِنانَ المَوتِ يَبرُقُ أَصلَعا",94,"ع",2,0],["وَإِنّي وَإِنحَلَّأتِ قَلبي لَقائلٌ","وَذَو البَثِّ يَعنيهِ الهَوى فَيَقُولُ",95,"ل",1,0],["وَإِنّي وَإِن كانَ التَصابي يَحُثُّني","لِأَبلُغُ حاجاتي وَأَجري عَلى قَدري",96,"ر",2,0],["وإنّي وإنْ تَرَني قابضاً","جَناحي إليّ كَظِيماً وَجِم",97,"م",1,0],["وإنّي وإنْ شَطّ المَزارُ لَراجِعٌ","إلى وُدّ قلْبٍ في ذراك مُخَيِّم",98,"م",1,0],["وَإِنّي وَإِيّاهُ لِقَرنانِ نَصطَلي","مِنَ المَطلِ ناراً غَيرَ ذاتِ خُمودِ",99,"د",1,0],["وَإِنّي وَالَّذي حاوَلتَ مِنّي","لَمُعوَجٌ دَفَعتَ إِلى مُقيمِ",100,"م",1,0],["وَإِنّي وَإِن عَرَّضتُ نَفسِيَ لِلهَوى","كَمُبتَحِثٍ عَن حَتفِهِ بِيَدَيهِ",101,"ي",2,0],["وَإِنّي وَمَدحي هَيثَماً أَبتَغي النَدى","لَكَالمُبتَغي المَعروفَ في اِستِ اِبنِ دَعلَجِ",102,"ج",1,0],["وَإِنّي وَإِن لَم آتِ خَيراً أَعُدُّهُ","لَآمَلُ إِرواءً بِخَيرِ ذَنوبِ",103,"ب",1,0],["وإني وإن كانت أنوفٌ رواغما","وماتت أواما أنفس ثم أنفس",104,"س",1,0],["وإنّي وإن جارت عليّ مواطني","فؤادي على قُطّانهنّ مُوَزّع",105,"ع",1,0],["وإِنِّي وَإِنْ أَصْبَحْتُ فَرْدَاً فَإِنَّنِي","بِنَفْسِي عَشِيرٌ لَيْسَ يَنْجُو طَرِيدُهُ",106,"د",2,0],["وَإِنِّي وَإِنْ كُنْتُ ابْنَ كَأْسٍ وَلَذَّةٍ","لَذُو تُدْرَإٍ يَوْمَ الْكَرِيهَةِ وَالأَزْلِ",107,"ل",1,0],["واني وإياه كما قال شعره :","\" مغاني اللوي من شخصكَ اليوم أطلال \"",108,"ل",1,0],["وإنّي وإنْ مارستُ شَّتى كوارثٍ","إذا راحَ منها مُتْلِفٌ جاء متلف",109,"ف",1,0],["وإني وإن لم يبق قول لقائل","ولم يتركِ الأقوامُ من متردمِّ",110,"م",1,0],["وإني وإن كنتُ صِنْوَ الرجاءِ","في حومةِ اليأسِ ، لا أُغْلَب",111,"ب",1,0],["وأني ، ومابي حبّ الصخور","أحن إلى صخرك الأملس",112,"س",1,0],["وإني وإن كنت القليل حماقة","فلي مبدأ عنه أحامي وأدفع",113,"ع",1,0],["وإنّي، وإنْ أبلَغْتَني شَرَفَ العُلا،","وأعتَقْتَ من ذل المَطامِعِ أخدَعي",114,"ع",2,0],["وإني وإن أوعدته أو وعدته","لمختلفٌ إيعادي ومنجز موعدي",115,"د",2,0],["وإني، وإنْ لم آتِ خيراً أعدُّهُ،","لآمل إرواءً يخير ذَنوب",116,"ب",1,0],["وإنّي  وإن جاوزت هذين سالما","لأكبر لولا جود عفوك حوبي",117,"ب",2,0],["وإنّي وإن أُهْجِرتُ فَالهَجْرُ صاحبي","وكيف يصحّ الهجر والحُبّ واجد",118,"د",1,0],["وأنَّي والمكارم باقياتٌ تروح","عليك أوْجُهُها وتغْدُو",119,"د",2,0],["وإني وإن أصبحت بالموت موقنا","فلي أمل من دون ذاك طويل",120,"ل",1,0],["وإني وإن شطت بي الدار نازحا","وقد مات قبلي بالفراق جميل",120,"ل",1,0],["وإني ولو جزت الثمانين حجة","لداعي صبابات الهوى لمجيب",121,"ب",1,0],["وأني وَقَّادٌ الحُرُوبِ فَإِن خَبَت","لَظَى الحَربِ بِكراً زِدتُها بِعَوَانِ",122,"ن",1,0],["وإني واللَّيَالِى لاَعِبَاتٌ","بِمَن فِيهِنَّ أحسَنَ أو أسَاءَ",123,"ا",2,0],["وإني وقد أمنتموني لم أخن","فذلك شيء ما هممتُ به عمري",124,"ر",2,0],["وإنى وإن جرّت زمامى عواذلى","لأتبعُ فيكِ باطلى وضَلالى",125,"ل",2,0],["وَأَنّى وَقَد سَطَّرتَ في كُلِّ مَأزِقٍ","صَحائِفَ تُتلى وَالسُطورُ الكَتائِبُ",126,"ب",1,0],["وَإِنّي وَإِن أَكثَرتُ وَصفَ مُبارَكٍ","وَأَطنَبتُ ما خَبَّرتُ إِلّا بِشائِعِ",127,"ع",1,0],["وإني وحق اللَه دائم لوعةٍ","ونار الجوى بين الجوانح في وقد",128,"د",1,0],["وإني وصبري عنك في النأي ليلة","فكيف ليال عدة لصبور",129,"ر",1,0],["وإنِّي وقد بنتُم لفي كفِّ حادثٍ","قضى رمقٌ منه وضاق مجال",130,"ل",1,0],["وإن يوما تسلقت الأماني","يحطم سحفها عبثا وغيا",131,"ي",2,0],["وان يوشى العنان لها تجدها","أخفَّ من الوجيف يداً ورجلاً",132,"ل",2,0],["وإِني وإِن أَخفيتُ ما بي من الأسى","لأَعلم حقاً أَن حبّك فاضحي",133,"ح",2,0],["وَإِنّي وَإِيَّاكُم لِما قَد يَغولُني","وَفَرطِ نِزاعي وَالَّذي هُوَ رائِثي",134,"ث",2,0],["وَإِنّي وَإِن أَبدى اِصعِراراً بِخَدِّهِ","وَأَوجَفَ بِي وَاِزوَرَّ لِلبُغضِ جانِبُهْ",135,"ب",2,0],["وَإِن يَوماً دَعَوتَهُمُ لِحَربٍ","أَثَرتَ لِيَومِ عاصِفَةٍ رَمادا",136,"د",2,0],["وَإِنّي وَإِن كُنتُ الرَفيعَ عِمادهُ","لَأُثني عَلَيهِ بِالَّذي كانَ أَسلَفا",137,"ف",2,0],["وَإِنّى وَذَاكَ الهَجرَ لَو تَعلَمينَهُ","كَعَازِبةٍ عَن طِفلِهَا وَهىَ رَائِمُ",138,"م",1,0],["وإني وإياه لَكالأرضِ حاولتْ","مجازاةَ ما تُولى السماءُ من الوَبْل",139,"ل",1,0],["وإني وإنْ باشرتُ أرفعَ رتبةٍ","بمدحِ ملوكٍ أُعجبتْ بكلامي",140,"م",2,0],["وإني وإن أصبحت في دار غربة","وحيدا ومالي ناصر وعشير",141,"ر",1,1],["وَإِنّي وَإِن أحكُم لِظاهرِ حالِهم","بِإِسلامِهم بِالقولِ لا أكفلُ السرّا",142,"ر",2,0],["وَإنّي وَإن كانت ذُنوبي كثيرةً","وَلا وَزرٌ مِن تَوبتي يدفعُ الوِزرا",142,"ر",2,0],["وَإِنّي وَفَرطَ اِنتِظاري لَهُ","وَخَوفِيَ مِن عائِقٍ أَن يَنُوبا",143,"ب",2,0],["وإني وقد أمسيتُ في دارِ غُرْبةٍ","فريداً لمنبتُّ العزاءِ فريد",144,"د",1,0],["وإني وإياها على ظمإ الهوى","أنا الفم هذا الهوى وهي الخد",145,"د",1,0],["وإني وإن لم أحتملْ أمرَ معشرٍ","فقلبي على كلِّ القلوبِ أميرُ",146,"ر",1,0],["واني وان وسعت نظمي بمدحه","حمدت الطريقين القوافي والشعرا",147,"ر",2,0],["واني وان ضاقت وعز تخلصي","حمدت القوافي وامتدحت ابن يوسفا",148,"ف",2,0],["وإنِّي وإن كنتُ نَجْلَ المُعِزِّ","لَعَبْدُك والحقُّ ما إنْ أُكِنه",149,"ن",2,0],["وإني وإن لم أُعطَ حظّاً لَعالِمٌ","جَليد على كرِّ الخطوب صَبُورُ",150,"ر",1,0],["وَأَنْ يُوَاسِي مَنْ بِهِ رَكَضَتْ","خَيْلُ النَّوَى أَوْ حَادَ عَنْ وِجْهَتِهِ",151,"ت",2,0],["وَإِنِّي وَإِنْ شَطَّ الْمَزَارُ أَحِبَّتِي","صَفَاءُ وِدَادِي لَمْ يُشَبْ بِتَكَدُّرِ",152,"ر",1,0],["وَإِنِّي وَإِنْ أَمْسَيْتُ فِي فَاسَ ثَاوِياً","لِتِطْوَانَ آمَالِي وَفِيهَا تَوَلُّعِي",153,"ع",2,0],["واني وان قلت سني لمدرك","مآثر اعمار النسور القشاعم",154,"م",1,0],["وإني وإن حال التفرق بيننا","وجد لما القاه دونكم وجدي",155,"ي",1,1],["واني وان اتيبت بها امتداحا","إليك وزدت فيها الأعتمادا",156,"د",2,0],["واني وان نقحت فيك قصائدي","وارسلتها غرا مع الدهر شردا",157,"د",2,0],["وإني وإن شط النوى بي لحادث","وضاقت على الجرد الجياد مذاهبي",158,"ب",2,0],["وإني وإن كنت القليل ثراؤه","لألقى الفتى ما بين عيني وحاجبي",159,"ب",2,0],["وَإِنِّي وَمَدْحِيهِمْ وَتَرْكَكَ كَالَّذِي","رَأَى الْجدَّ أَوْلى أَنْ يُناطَ بِعابِثِ",160,"ث",1,0],["وَأَنّى وَقَد ذُقنا مَرارَةَ فَقدِهِ","نَزورُ دِياراً ما نُحِبُّ لَها مَغنى",161,"ن",2,0],["وَإِنّي وَإِن كانَ التَشَيُّعُ مَذهَبي","لأَكثَرُ خَلقِ اللَهِ شَوقاً إِلى عُمَر",162,"ر",1,0],["وَإِنّي وَإِن يَمَّمتُ بِالمَدحِ غَيرَهُ","لأَبعَدُ خَلقِ اللَهِ عَن طُرُقِ الرُشدِ",163,"د",1,0],["وأن يوفقنا للصالحات وما","يرضيه عنا ويحفظنا من الخطل",164,"ل",1,0],["وان يوفقنا للصالحات وما","وترضيه قبل حلول الموت والأجل",165,"ل",1,0],["وإني وإن أصبحت في دار غربة","تحيل الليالي سلوتي وتديل",166,"ل",1,0],["وَاِنّي وَان أَضناني الحُبّ لم أَخُن","عُهودَ الهَوى خانَ المَحبون أَو وَفوا",167,"ف",3,0],["وَاني وَان أَضنى فُؤادي قَدّه","مَتى لاحَ ذاكَ القَدّ لا أَتخلف",167,"ف",1,0],["وَاِنّي وَاِن صانَعت بِالقَولِ لَوّمي","لِمخف أَمورا لَيسَت عَنها بِمعرب",168,"ب",1,0],["وإنّي وإنْ حاولْتُ منه إجابةً","فأصبحتُ فيه حائراً أتَلَدَّد",169,"د",1,0],["وَإِنّي وَالمَطامِعُ مومِضاتٌ","بَوارِقُها لِأَستَحيي الحَياءَ",170,"ا",2,0],["وإنّي وإن غبتَ عن ناظري","على العَهْدِ طول المدى لم أزَلْ",171,"ل",1,0],["وأنّي وجَيشُ الحُبِّ بالقَلْب مُحْدِقٌ","وكيفَ يكُفُّ النّارَ مَن دُونَه الحربُ",172,"ب",1,0],["وإنّي وإن أزرَى بيَ الفقرُ وانتَحَتْ","عليّ اللّيالي بالمصَائب عَنْ يَد",173,"د",1,0],["وَإِنّي وَإِذكاريك أَمري كَقائِل","لهذي النُجوم وَهيَ تَسري أَلا فاسري",174,"ر",2,0],["وَإِنّي وَإِن عاصيت في بيشة الهَوى","ليعجبني غُزلانها وَصوارُها",175,"ر",3,0],["وَإِنّي وَإِن أَصبَحتُ بِالشامِ ثاوِياً","أَحِنُّ إِلى أَرضُ الحِجازِ وَأَطرَبُ",176,"ب",1,0],["وإنِّي وإنْ لم أقضِ للشُّكر واجباً","بمستغرم أصبَحْتُ بالمجد مغرما",177,"م",2,0],["وإنِّي وإنْ لم آمن الدهر خطبه","وما أَمنَ الأَيَّام غير جهول",178,"ل",1,0],["وإنِّي والهموم إذا اعترتني","وجَدْتُ به النجاة من الغموم",179,"م",1,0],["وإني وإن كنت الرديف نظامهُ","لمبرقةٍ حسن الروي بها الخالُ",180,"ل",1,0],["وإن يؤمك يا نعم البشير بنوا الآ","مال كان اسمك البشرى بفوزهمِ",181,"م",1,0],["وإن يوخر هضمهُ عن حدِّهِ","أقامهُ على مثاني يدهِ",182,"ه",1,0],["وإني وعندي نشوةٌ منك بالغِنى","لأرفَعُ صوتي بالغناءِ وأُنشِدُ",183,"د",1,0],["وإني وإيضاعي وإشرافَ همّتي","لأعلمُ عند الأشرفِ النَدْبِ موضِعي",184,"ع",2,0],["وإني وتذكاري لياليا تصرّمت","بقربكم يعتادني للنوى خبل",185,"ل",1,0],["وإني وإن قامت قيامه عذّلي","على كل حال ليس لي منكم بد",186,"د",1,0],["وإِنِّي وإِنْ قصَّرْتُ فيكَ مدائِحِي","فلا قِصَرٌ بالسلكِ إِن عَظُمَ الدُّرُّ",187,"ر",1,0],["وإني وإياك الشريكان في الأسى","وإن لم يكن ما قلت بالجبت مشرك",188,"ك",1,0],["وإِني وإن طالت مسافة بيننا","لأعلمُ حقاً إنِّيَ الأخلص الأصفى",189,"ف",2,0],["وأني وراء الغيب تطلُعُ فيكمُ","بصائرُ لي معروفةٌ وعزيمٌ",190,"م",1,0],["وإني وإنْ أمسيت سيد دارمٍ","أناضِلُ عن أحسابهم وأقارعُ",191,"ع",1,0],["وإني ومدحَ القوم أفخرُ عندهُ","رذيَّةُ سيرٍ نُشِّطتْ بحُداءِ",192,"ا",2,0],["واني وأبناء العراق أولي الغِنى","لمُجتمعا معنىً ومُفتَرقانِ",193,"ن",1,0],["واِني وانْ أمسيت أوثق ذي هوىً","لأرهبُ من وهْمِ الضمير وأفرقُ",194,"ق",1,0],["وِاني وانْ لم يُدرك الشعرُ وصفَه","وزاد على لفظ المدائحِ مجدهُ",195,"د",2,1],["وإنِّي ومَدْحي أبا جعفرٍ","بما طابَ منْ شِعْريَ السَّائر",196,"ر",1,1],["وإِني وإنْ كَفَّ الأسى غَرْبَ مِقْوَلي","فغاضَ عُبابِيٌّ وأغْمِدَ قاطِعُ",197,"ع",1,1],["وإِني وإنْ لمْ تُنْصفوا في حكومتي","وشَوَّهْتُمُ بالظَّنِ حُسْنَ وَلائي",198,"ا",2,1],["وإِني ومَدْحَ الفارس الشَّهْمِ يَزْدنٍ","فَتى المَجْدِ مِنْ بأسٍ مَهيبٍ وأنْعُمِ",199,"م",1,1],["وإني وأيام مضت أستعيدها","كما كنت من قبل النوى أستديمها",200,"م",3,0],["وإني وأني لعينُ الحنيف","لمن جاهليّة ذاك الوثن",201,"ن",1,0],["وَإِنّي وَإِن أَحمَوا عَلَيَّ كَلامَها","وَحالَت أَعادٍ دونَها وَحُروبُ",202,"ب",1,0],["وَإِنِّي وَإِن فُنِّدتُ فِي طَلَبِ الصِّبا","لأَعلَمُ أَنِّي لَستُ فِي الحُبِّ أَحدَا",203,"د",2,0],["واِنّي واِنْ جاوزتُ في الوجدِ حدَّه","وأنجدَبي شوقي اليهنَّ أو غارا",204,"ر",2,0],["واِنّي وان جادوا بمثلي على الهوى","بمثلِهُمُ عُمْرُ الزمانِ ضنينُ",205,"ن",1,0],["واِنَّي واِنْ ضنُّوا عليَّ بزَوْرَةٍ","تحومُ عليها غُلَّتي وتلوبُ",206,"ب",1,0],["وأني وإن شاعت لديك سرائري","فإن الذي استودعتني غير شائع",207,"ع",1,1],["وإني وإن أهديت من حسناته","إلى سمعه القول الذي ليس يفترى",208,"ر",2,0],["وإني وإن كنت البخيل ببذلها","وأنت لها زين وغيرك شائن",209,"ن",1,0],["وَإِنّي وَإِيّاهُم كساعٍ لِقاعد","مُقيم وَاِشقى الناس بِالشِعر قائِلُه",210,"ه",1,1],["وآني وإلزاميك بالشعر بعدما","تعلّمته منك الندى والفواضلا",211,"ل",2,0],["وَإِنّي وَإِن كانَت مَراضاً صُدورُكُم","لَمُلتَمِسُ البُقيا سَليمٌ لَكَمُ صَدري",212,"ي",1,1],["وَإِنّي وَتَركي نَدى الأَكرمين","وَقَدحِي بِكَفّيَّ زَنداً شِحاحا",213,"ح",2,0],["وإنِّي وإِنْ كَلَّتْ قَلُوصِي لَراجِمٌ","بِها وبنَفْسي يا فُطَيْمَ المَراجِما",214,"م",2,0],["وإنّي وأَدناسُ الزّمان كَثيرةٌ","مَررتُ فَلم تَعلقْ بهنّ ثِيابي",215,"ب",2,0],["وَإِنّي وَإِسماعيلُ يَومَ وَداعِهِ","لَكَالغُمدِ يَومَ الرَوعِ فارَقَهُ النَصلُ",216,"ل",1,1],["وَإِنّي وَإِشرافي عَلَيكَ بِهِمَّتي","لَكَالمُبتَغي زُبداً مِنَ الماءِ بِالمَخضِ",217,"ض",1,0],["وَإِنّي وَتوصافي بَديعَ حُلاهُما","كَمَن هَمَّ بِالبَحرَينِ يُفنيهِما غَرفا",218,"ف",2,0],["وإني والأيام ضدان في الهوى","ومن لي بنصر الحق والوقت غاشم",219,"م",1,0],["واني والاضياف في بردة معاً","اذا ماتَ نصف الشمس والنصف ينزع",220,"ع",1,0],["وَإِنّي وَتَأميلي لِقاءَ مُؤَمَّلٍ","وَقَد شَعَبَتهُ عَن لِقاي شَعوبُ",221,"ب",1,0],["وإنِّي والذي حَجَّتْ قُريشٌ","مَحَارِمَهُ وما جَمَعَتْ حِراءُ",222,"ا",2,0],["وَإِنّي وَإِن شابَت مَفارِقُ لِمَّتي","لَكالسَيفِ أَفنى جَفنُهُ وَهُوَ قاطِعُ",223,"ع",1,0],["وَإِنّي وَإِن كانوا نَصارى أُحِبُّهُم","وَيَرتاحُ قَلبي نَحوَهُم وَيَتوقُ",224,"ق",1,0],["وإِنّي وإِن قالوا أَميرٌ وَتابِعٌ","وَحُرّاسُ أَبوابٍ لَهُنَّ صَريرُ",225,"ر",1,0],["وأني ولو سبحت باسمك ربنا","لأكثر إلا ما غفرت خطائيا",226,"ي",2,0],["وَإِنّي وَذِكري أُمَّ حَيّانَ كَالفَتى","مَتى يَذُق طعمَ المُدامَةِ يَجهَلِ",227,"ل",1,0],["وإنّي وإن هازلتني قد أصابني","من البثّ ما يُبكي الحزين المفجَعا",228,"ع",2,0]]}