{"poems":[[55,"يا طائر البان غريدا على فنن","https://www.aldiwan.net/poem29732.html","البسيط"],[55,"ما للبياض والشعر","https://www.aldiwan.net/poem30486.html","مجزوء الرجز"],[24,"إن عرسي قد آذنتني أخيرا","https://www.aldiwan.net/poem21863.html","الخفيف"],[24,"أنى ألم بك الخيال يطيف","https://www.aldiwan.net/poem21870.html","الكامل"],[74,"أثنى شذا الروض على فضل السحب","https://www.aldiwan.net/poem20617.html","الرجز"],[53,"قد عجلت لي عقوبة الخور","https://www.aldiwan.net/poem63996.html","المنسرح"],[87,"ما بين دمعي المسبل","https://www.aldiwan.net/poem62836.html","مجزوء الكامل"],[47,"أبكاء في الدار بعد الدار","https://www.aldiwan.net/poem63605.html","الخفيف"],[68,"للترك مالي ترك","https://www.aldiwan.net/poem39673.html","المجتث"],[68,"أهلا بشهب في سماء المجلس","https://www.aldiwan.net/poem41342.html","الكامل"],[99,"مكاني الهادئ البعيد","https://www.aldiwan.net/poem24785.html","مجزوء البسيط"],[48,"","https://poetry.dctabudhabi.ae/diwan/poem/16683","الخفيف"],[102,"ثائران","https://www.poetsgate.com/ViewPoem.aspx?id=50176",""],[53,"يا أيها المرء الكريم والدا","https://www.poetsgate.com/ViewPoem.aspx?id=27704",""],[24,"إنّ عِرْسِي قد آذنتْني أخِيراً","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=10866&r=&rc=7",""],[119,"أرأيت يا حلول الشمائل","https://www.aldiwan.net/poem40609.html","عموديه"],[156,"القادمون الخضر","https://www.aldiwan.net/poem17107.html","عموديه"],[190,"في كل منقلب غيظ أساء به","https://www.aldiwan.net/poem43798.html","البسيط"],[197,"أرى وصالك لا يصفو لآمله","https://www.aldiwan.net/poem13047.html","البسيط"],[203,"أترى زمانك بالحمى سيعاد","https://www.aldiwan.net/poem45629.html","الكامل"],[234,"جارية مرهفة القد","https://www.aldiwan.net/poem51177.html","السريع"],[234,"يا شاعرا جل عن أن","https://www.aldiwan.net/poem51265.html","المجتث"],[240,"وغزال علقته","https://www.aldiwan.net/poem32145.html","مجزوء الخفيف"],[285,"لاح الهلال فما يكاد يرى","https://www.aldiwan.net/poem60617.html","أحذ الكامل"],[287,"وهو الذي لم يزل تهمي أنامله","https://www.aldiwan.net/poem32887.html","البسيط"],[369,"لو شاء طيفك بعد الله أحياني","https://www.aldiwan.net/poem60625.html","البسيط"],[369,"إن الذي نصب المكارم للورى","https://www.aldiwan.net/poem60939.html","الكامل"],[408,"وثلاث لما بدت لي منها","https://www.aldiwan.net/poem46684.html","الخفيف"],[409,"حي الحمى ومنازل الحب","https://www.aldiwan.net/poem34158.html","الكامل"],[415,"كم قد جزعت لبين من فارقته","https://www.aldiwan.net/poem32378.html","الكامل"],[416,"طرقتك زائرة فحي خيالها","https://www.aldiwan.net/poem67473.html","الكامل"],[435,"لديك يا من قد سما رفعة","https://www.aldiwan.net/poem39843.html","السريع"],[447,"الحمد لله القريب النائي","https://www.aldiwan.net/poem14286.html","الرجز"],[469,"شهرت علي صوارم العذل","https://www.aldiwan.net/poem3349.html","عموديه"],[487,"عرج بمنعرج الكثيب الأخضد","https://www.aldiwan.net/poem24364.html","عموديه"],[519,"ما بال وتر صلاتكم لا يشفع","https://www.aldiwan.net/poem20809.html","الكامل"],[572,"حسبي من اللهو وآلات الطرب","https://www.aldiwan.net/poem69818.html","الرجز"],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25308","الرجز"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126123","الرجز"],[1239,"","https://poetry.dctabudhabi.ae/diwan/poem/128272","الكامل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128709","السريع"],[1563,"","https://poetry.dctabudhabi.ae/diwan/poem/203663","السريع"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77824","الخفيف"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77863","المنسرح"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66291","الرجز"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125374","الكامل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53040","المجتث"],[2357,"","https://poetry.dctabudhabi.ae/diwan/poem/177978","الكامل"],[2412,"","https://poetry.dctabudhabi.ae/diwan/poem/101700","الكامل"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109802","الكامل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65137","الكامل"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100827","الكامل"],[3349,"","https://poetry.dctabudhabi.ae/diwan/poem/73843","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62924","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45805","البسيط"],[3637,"","https://poetry.dctabudhabi.ae/diwan/poem/106811","الرجز"],[3701,"","https://poetry.dctabudhabi.ae/diwan/poem/46012","الكامل"],[3946,"","https://poetry.dctabudhabi.ae/diwan/poem/32466","البسيط"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77127","البسيط"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36433","الدوبيت"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45136","المنسرح"],[4670,"","https://poetry.dctabudhabi.ae/diwan/poem/143611","الخفيف"],[4767,"البر والتقوى","https://www.poetsgate.com/ViewPoem.aspx?id=213423",""],[4988,"فضا الإبداع","https://www.poetsgate.com/ViewPoem.aspx?id=198226",""],[5038,"في الحكمة / الصدق4","https://www.poetsgate.com/ViewPoem.aspx?id=190170",""],[585,"الكاس واحدةٌ ونحن اثنان","https://www.poetsgate.com/ViewPoem.aspx?id=161930",""],[585,"يا رائد القوم إن القوم أنضاء","https://www.poetsgate.com/ViewPoem.aspx?id=161878",""],[585,"أين القصائد أفوافاً توشيها","https://www.poetsgate.com/ViewPoem.aspx?id=161879",""],[5075,"وعدا لأجلك يا مها","https://www.poetsgate.com/ViewPoem.aspx?id=187721",""],[592,"يا طالباً مني جوابا شافيا","https://www.poetsgate.com/ViewPoem.aspx?id=128823",""],[592,"الحق شمس لأهل الحق قد بانا","https://www.poetsgate.com/ViewPoem.aspx?id=128820",""],[5559,"بيننا شغاف الروح ( محمود أسد )","https://www.poetsgate.com/ViewPoem.aspx?id=60738",""],[5616,"أين النخوة العرباء؟","https://www.poetsgate.com/ViewPoem.aspx?id=204849",""],[5781,"ناياتِ كوثرهِ.....","https://www.poetsgate.com/ViewPoem.aspx?id=208987",""],[5784,"سحر حلال","https://www.poetsgate.com/ViewPoem.aspx?id=191611",""],[5992,"شكري لفضلك بالزناد كأنًّهُ","https://www.poetsgate.com/ViewPoem.aspx?id=41826",""],[5994,"لحن المدى","https://www.poetsgate.com/ViewPoem.aspx?id=184588",""],[6093,"مَثَلُ البخيل ( الكامل )","https://www.poetsgate.com/ViewPoem.aspx?id=181333",""],[572,"أَرى وِصَالَكَ لا يصفُو لآمِلِهِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9324&r=&rc=181",""]],"verses":[["كَالقُرطِ عُلِّقَ في ذِفرى مُبَتَّلَةٍ","بَينَ العَقائِلِ قُرطاها قَليقانِ",0,"ن",1,0],["كَالقَاتِلِ اِعتامَ القِوى","بَعدَ القِوى ثُمَّ شَزَر",1,"ر",1,0],["كَالقِسِيِّ الأَعطالِ أَفرَدَ عَنها","آتُناً قُرَّحاً وَوَحشاً ذُكورا",2,"ر",2,0],["كَالقَوسِ عَطَّلَها لِبَيعٍ سائِمٌ","أَو كَالقَناةِ أَقامَها التَثقيفُ",3,"ف",1,0],["كالقوس إلاَّ أنه كالسهم","والغيم يجلو عن شهاب رجم",4,"م",1,0],["كالقَطِران الذي يُرى أبداً","في رأسهِ ما اقتنى من العكر",5,"ر",1,0],["كَالقَبرِ ما لَم يَبلَ في","هِ مِنَ العِظامِ وَما بَلي",6,"ل",2,0],["كَالقِسى المُعَطَّفاتِ بَلِ الأَس","هُمِ مَبرِيَّةً بَلِ الأَوتارِ",7,"ر",1,0],["كَالقَوسِ يُصمي وَهَذي","تَشكي المُحِبَّ وَيَشكو",8,"ك",2,0],["كَالقُضبِ إِلّا أَنَّها لا تَنثَني","مِنها القُدودُ وَزَهرُها لَم يُلمَسِ",9,"س",1,0],["كالقلب إن ضاق واكتأب","تخفف الذكريات عنهُ",10,"ه",1,0],["كالقَليبِ النَّزُوعِ في القلبِ لا تُنْ","بِطُ إلاّ الدّمَ الغَريضَ زَبيرا",11,"ر",2,0],["كالقلاع الجهنّميات ينقضّون","يرمون بالجبال الجبالا",12,"ل",2,0],["كالقُسور الضاري تربَّى صائدا","ولم أزل عضاً أكيدُ الكائدا",13,"د",2,0],["كالقيسيِّ الأعطالِ أفرد عنها","آتناً قرّحاً ووحشا ذكورا",14,"ر",2,0],["كالقوس اضحى رمح قد","ي آه ذاك الوهم باطل",15,"ل",1,0],["كالقضاءِ المحتومِ، فالفجر خلف الليل","كالشمس من سجوف الضَّباب",16,"ب",1,0],["كالقوس في الحرب لا يرجى الغناء بها","ولا القتال إذا ما خانها الوتر",17,"ر",1,0],["كَالقَوسِ أَقرَبُ سَهميها إِذا عَطَفت","عَلَيهِ أَبعَدُها عَن مَنزَعِ الوَترِ",18,"ر",1,0],["كالقصرِ فيهِ لكلِّ خودٍ حجرةٌ","ولكلِّ صبٍّ مضجعٌ ووسادُ",19,"د",1,0],["كالقمر الطالع لكنّها","في حسنها كالرَّشأ الفَرْد",20,"د",1,0],["كالقُرْبِ بعد بِعَادٍ","والوَصْل بعد جفاء",21,"ا",2,0],["كَالقَضيبِ يو","هيهِ حَملُ الذَوائِبِ",22,"ب",1,0],["كَالْقَوْسِ فُوِّقَ سَهْمُها فَبَدا","مُتَأَلِّقاً فِي رَأْسِهِ النَّصْلُ",23,"ل",1,0],["كَالقَصرِ في الجَنَّةِ الفَيحاءِ يَحسُدُهُ","إيوان كِسرى عَلى ما فيهِ مِن نُخَبِ",24,"ب",1,0],["كالقَطْرِ يُسمَّى بأسماءٍ تُعدَّدُ من","وَبْلٍ وهَطْلٍ وتَسكابٍ وتَهْتان",25,"ن",1,0],["كالقَطْرِ أسلَمَه الغمامُ ولم يَقَعْ","في الأرض بعدُ فقد تَبلّد رائدي",26,"د",2,0],["كالقسِيّ المعطّفات وكالأسهمِ","مَبْريّةً وكالأَوتارِ",27,"ر",1,0],["كالقطب في علم وفي عمل","لا بل سما قدراً على القطب",28,"ب",1,0],["كالقَوسِ تَرمِي السّهمَ ثُمّ تَرِنُّ من","جزعٍ ويبدو اليأسُ منه فَتكْظِمُ",29,"م",1,0],["كَالقَوسِ ساهِمَةٌ أَتَتكَ وَقَد تُرى","كَالبُرجِ تَملأُ رَحلَها وَحِبالَها",30,"ل",3,0],["كالقمر الوضاح أصبحت من","منزلةٍ تسري إلى منزله",31,"ه",1,0],["كالقلة الهائلة الرعناء","أقلقها بويرح الصباء",32,"ا",2,0],["كالقطر في الأقطار يعرفهُ","بالفضل أهلُ الحزن والسهل",33,"ل",1,0],["كالقاعة والعساء والعنمي من","ويد الأثيلات الشعاب الصرغد",34,"د",1,0],["كالقلبِ في صدرِ الخَميسِ تظنّه","في جانِبَيْهِ من الصّوارِمِ أضلُعُ",35,"ع",1,0],["كالقُرْط في الجيد تَدَلّى واضطربْ","تصحبُها والأخواتُ تصطحبْ",36,"ب",1,0],["كَالقَلْتِ آلَ الماءُ مِنْهُ نَضْبا","إِذا أَقَمْنَا عَجِراتٍ شُزْبا",37,"ب",2,0],["كالقول بالعلة والطبيعة","فهو من العقائد الشنيعة",38,"ه",1,0],["كالقار داسهم الهوان فأصبحوا","للعابرين مواطئ الأقدام",39,"م",1,0],["كالقلم الممشوق وهنا فما","زال به السقم إلى أن يراه",40,"ا",2,0],["\"كالقمر الزاهي\" في نوره","\"عليه كالليل البهيم\" الدلال",41,"ل",1,0],["كالقَضيب الرطيب تمشي الهُوَينا","بين غصني وَصيفة وَوَصيف",42,"ف",1,0],["كالقهرمان للزَعفران","سر الأَغاني لحن المَعاني",43,"ن",2,0],["كالقمر الأعلى بدا من أوجه","للعالمين ثم للأوج أوى",44,"و",2,0],["كالقَوسِ أطلَقَ سهمَهُ فجنى ولا","لومٌ عليه فليسَ يَدري ما جنى",45,"ا",1,0],["كالقطر في كل قطر","نداه غير مُغِبِّه",46,"ب",2,0],["كالقار لونك أو طليت برامكٍ","أو مسّ جلدك هانئٌ بهناء",47,"ا",2,0],["كالقطر جاد به غمام مبرق","داني الهيادب عارض مدرار",48,"ر",1,0],["كالقوس أطلق سهمها فجنى ولا","لوم عليه فليس يدري ما جنى",49,"ا",1,0],["كالقطّ للأقْلام يسْرع جرْيها","أبدا وينمو الغصْن مهما قلما",50,"م",2,0],["كالقلب في خفقانه","لكنه لا يشعر",51,"ر",1,0],["كَالقَرنِ وَالقَوَدِ المَشهورِ وَالكَذِبِ ال","مَعروفِ وَالخَلَّةِ الشَّنعاءِ وَالسَّرِقَه",52,"ق",2,0],["كالقادحِ العَتِدِ الأَقبِّ صفَاقَةً","يومَ الرِّهانِ يبذُّ كلَّ مُخَاطِرِ",53,"ر",1,0],["كَالقَوس مِنهُ سِهام المَوت مُرسَلة","لَهُ اِختِراع بَدا في هام كُل كَمي",54,"م",2,0],["كاَلقَلبِ مِن ظَبيٍ بِتَرخِيم غَدَا","يَفعَلُ فِينَا لَحظُهُ فِعلَ المُدَى",55,"د",2,0],["كَالقائِدِ المِغوارِ فَوقَ الطِّرف في","صَدرِ الطَّليعَةِ لَيسَ بِالرعديدِ",56,"د",1,0],["كَالقِردِ هانَ فَأَمسى وَهُوَ مُهزَأَةٌ","يَختالُ لِلمَشيِ في طَوقٍ وَخَلخالِ",57,"ل",1,0],["كَالقَوسِ لَولا اِعوِجاجٌ فيهِ ما اِنتَفَعت","عِندَ النِضالُ بِهِ أَهل الرِمايات",58,"ت",1,0],["كالقَول لَفَظتهِ وَمنه دُرَرٌ","كاللَحظِ كسرتِهِ وَمنه السِحرُ",59,"ر",1,0],["كالقَطرِ في الأَقطار","وَفي العُلا كالطَود",60,"د",1,0],["كالقَضيب الرَّطيب حينَ تَصَدَّى","والقضيبِ الرَّطيبِ حينَ تَصُدُّ",61,"د",1,0],["كالقولِ ما لَم يغنِ سامِعَهُ","فالقول يُصبِحُ هكذا لغوا",62,"و",2,0],["كالقراح العذب ولا / السلسبيل","هاذي اخت لذيّ واعزومي عزوم",63,"م",1,0],["كَالْقَلْبِ يُسْمَعُ في النَّسيبِ وَجيبُهُ","وَالثُّكْلِ يَعْتَوِرُ اللِّحاظَ حَرارَهْ",64,"ه",1,0],["كالقوس تبدي الصد إذ هي تنحني","للسهم قد ضمته ضم حنان",65,"ن",1,0],["كالقدر والنار دأب النار قهقهةٌ","منها وللقدر إزبادٌ وإرغاء",66,"ا",2,0],["كالقوم ظاهرها حالٍ وباطنها","خالٍ ومن سفلها تحيا أعاليها",67,"ي",3,0],["كالقيد حبك لا يغادر معصمًا","والرُّوحُ فِي غُلِّ المَشَاعِرِ تَرْسُفُ",68,"ف",1,0],["كالقول بالأعراض والأغراض وإلاَّ","بعاض هذا كله قد باين",69,"ن",1,0],["كالقبئر القيعم المولود من حنش","أمين بل خؤن خانع خانا",70,"ن",2,0],["كالقطنِ هَشَّتْ ، والرياحُ عقيمةٌ","لا الغيثُ جاءَ ، ولا الرجالُ تأثَّروا",71,"ر",3,0],["كالقلعةِ الشَّمَّاء تنْ","تصبينَ وحدَكِ يا عُقابُ",72,"ب",1,0],["كالقافياتِ على بَحري أتَذْكُرُها","وأبْجَدِيَّاتُ عِشْقٍ بَدؤها ألِفُ ؟",73,"ف",1,0],["كالقوس حاجبكمْ يرمي بأسهمهِ","من داعشيَّتهِ أمسيتُ في كمدِ",74,"د",1,0],["كالقلب تقدحُ نظرةٌ فيه فتم","لأه لأسبابِ الهوى وسواسا",75,"س",2,0],["كالقيد يا حزني شددت فؤاديا","طوقتني وذبحت صدري مرغما",76,"م",2,0],["كَالقِدْرِ فَوقَ النَّارِ يَبْقى جَائِعاً","والزَّادُ يَذْهَبُ فِي إِنَا أَكَّالِهِ",77,"ه",1,0],["كالقوسِ اسَسقسربُ سهيمها إذا عطفَتْ","عليهِ أَبعدُهَا من منزعِ الوَتَرِ",78,"ر",1,0]]}