{"poems":[[55,"كربلا لا زلت كربا وبلا","https://www.aldiwan.net/poem30772.html","الرمل"],[91,"مات سعد فما عسى أن تقولا","https://www.aldiwan.net/poem44613.html","الخفيف"],[69,"كيف ترقى رقيك الأنبياء","https://www.aldiwan.net/poem18028.html","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54521","الكامل"],[119,"نفحة الغيب حرزنا","https://www.aldiwan.net/poem41210.html","عموديه"],[173,"يا شمس دين الله كم لك من يد","https://www.aldiwan.net/poem1625.html",""],[201,"غادة حطم الفؤاد بكاها","https://www.aldiwan.net/poem39820.html","الخفيف"],[236,"سبح لربك في الظلام الداجي","https://www.aldiwan.net/poem44595.html","الكامل"],[305,"كسع الشتاء بسبعة غبر","https://www.aldiwan.net/poem45441.html","أحذ الكامل"],[422,"دنف ذو مهجة في الحب تصدا","https://www.aldiwan.net/poem54128.html","الرمل"],[563,"لمتى تموه بالمهاة وبالرشا","https://www.aldiwan.net/poem34430.html","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87217","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86985","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86657","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87067","الخفيف"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86679","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86588","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59419","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59384","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56248","الكامل"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112837","الكامل"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/73951","الخفيف"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113927","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125359","الكامل"],[1965,"","https://poetry.dctabudhabi.ae/diwan/poem/102724","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93695","الكامل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102541","المتقارب"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115538","المتقارب"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138448",""],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/110060","الكامل"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135741","الرجز"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77136","الكامل"],[3968,"","https://poetry.dctabudhabi.ae/diwan/poem/105263","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125837","الرمل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94350","الكامل"],[4246,"","https://poetry.dctabudhabi.ae/diwan/poem/103268","الرمل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83448","الكامل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72690","الكامل"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139470",""],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139741",""],[4858,"مرسي والسيسي","https://www.poetsgate.com/ViewPoem.aspx?id=144476",""],[5943,"حراس القدس ملائكة","https://www.poetsgate.com/ViewPoem.aspx?id=45279",""],[5956,"الطائرة المنكوبة","https://www.poetsgate.com/ViewPoem.aspx?id=193917",""]],"verses":[["وَبِأُمٍّ رَفَعَ اللَهُ لَها","عَلَماً ما بَينَ نُسوانِ الوَرى",0,"ا",1,0],["وبآمال أمة ذات تاريخ","وباليأس المر في النكبات",1,"ت",1,0],["وبأمِّ السِّبْطَيْنِ زَوْجِ عَلِيٍّ","وَبَنِيها وَمَنْ حَوَتْهُ العَبَاءُ",2,"ا",2,0],["وَبِأَمْرِهَا تَعْرَى الْحُقُولُ فَتَنْثَنِي","أُمُّ الْعُرَاةِ بِمِيرَةٍ وَكِسَاءِ",3,"ا",2,0],["وبأمن احلنا","صاح اعظم محلنا",4,"ن",2,0],["وَبِأَمسِ كانَت لِي بِقُربِكَ صَيلَمٌ","ما لي وَبَيتِ اللَهِ فيها عاذِرُ",5,"ر",1,0],["وبأمّي عذراء حطّمت الأوصاب","في ميعة الشباب قواها",6,"ا",3,0],["وبأمره البحران يلتقيان لا","يبغي على عذب مرور أجاج",7,"ج",1,0],["وَبِآمِرٍ وَأَخيهِ مُؤتَمِرٍ","وَمُعَلِّلٍ وَبِمُطفِئِ الجَمرِ",8,"ر",1,0],["وبأمر الله قاضٍ إنْ قضى","كانَ أمضى من شفير السيف حدا",9,"د",2,0],["وبأمرها ظهرت بما ظهرت ولم","تزل الغيوب لباسها والمَفْرَشا",10,"ش",2,0],["وَبأمِّ القُرى تَشرَّف لَمّا","مَهَّد الدَربَ وَاِنمَحَت سُفَهاه",11,"ا",2,0],["وَبِأَمر حَضرته العليه جدّ في","حل المَشاكل بَعدَ كَشف حَقائق",12,"ق",1,0],["وَبِأَمره طافَ البِلاد جَميعها","مَعَهُ وَعادَ لِمصر بَعد الرحلة",13,"ه",1,0],["وَبِأَمر السَعيد خَير مليكٍ","نوّر الأُفق بَعدَ ما كانَ أَظلَم",14,"م",1,0],["وَبِأَمس تاسعه لِوَضع لَبيبة","مِن وَجهِها قَد لاحَ نُور صَباح",15,"ح",1,0],["وَبأمك المشؤومة الوَجه الَّتي","عُرفت بأَم الألكن الزلاء",16,"ا",2,0],["وبأمره رد الغزالة بعدما","عزبت ونجاها لأجل الرضع",17,"ع",1,0],["وبأمره عاد الطفيل لقومه","يدعو بأنة صوته المتشعشع",17,"ع",1,0],["وَبِامْتِدَاحِ حَبِيبِهِ","خَيْرِ الأنَامِ مُحَمَّدِ",18,"د",1,0],["وبأمنه أرّخت جاد لأنه","أمر العباد بأن تجوز على الصفا",19,"ف",2,0],["وبأمهم من كان مهرجنا بها ال","مهر المرقى للعلى ووروده",20,"د",2,0],["وبأمر تخلو به كل دار","دونها يختلي من الليث غابه",21,"ب",2,0],["وبِآمِلِّ حولَهُ رَبعُ سَلمى","صيّرَتهُ الليالِ رقمَ الكِتابِ",22,"ب",1,0],["وبأمرِهِم جرَتِ الرياحُ وسيرَت","لهم الجبالُ وسُخِّرَ الثَّقَلان",23,"ن",1,0],["وبأمه الزهراء بنت نبينا","أصل الأصول ومنبع الرضوان",24,"ن",1,0],["وَبِأَمرك الدول الأباعد إذعَنَت","وَطَوت لَهُ قانونَها وَنِظامَها",25,"م",3,0],["وبأملاكك اللَه يا رازقي","توسلت يا بغية الآملين",26,"ن",1,0],["وبأمر جفنيه أن يجرحا","وحاجبه لم يزل يأتمر",27,"ر",1,0],["وبأم القرى تجلى سناه","ليعم الورى يداً ولحاظا",28,"ظ",2,0],["وبامره المجنونُ حازَ على الشِفا","والمُعتَرى والابرصُ المتجذّمُ",29,"م",1,0],["وبامرهِ المَوتَى حَيُوا والمُقعَدو","نَ لقد مَشَوا والمنحنُونَ تقوَّموا",29,"م",3,0],["وبإمام المتقّين قدِّما","لرتبتي وعافني وعظِّما",30,"م",2,0],["وَبِأَمرٍ مَعروفٍ وَنَهيٍ مناكِر","في اللّهِ لا يَخشونَ لَومَ مفند",31,"د",1,0],["وبأمنه عين الرقيب ورشفه","ثغر الحبيب لدى توسد زنده",32,"د",2,0],["وبأَمريكا زنوحٌ","عُتَقَاءٌ أَمْ رقيق",33,"ق",1,0],["وبأمر دنياهُ يرى من دونه","فيَحوز اقناعاً يُرَوّقُ بالا",34,"ل",2,0],["وبأمريكا وفي انجلترا","وبروسيا وفي الصين حصين",35,"ن",1,0],["وَبِأُمِّيَ الزَهراء عُد بي لِلحِمى","فَالعودُ أحمدُ لِلَّذي يتودَّدُ",36,"د",1,0],["وبأمر باريها لقد نفخت به","روحا مسيحا فوق مهرقه جرى",37,"ر",2,0],["وبأمرٍ منه ونهىٍ على أم","رٍ ونهىٍ نعم تسير ولاء",38,"ا",2,0],["وبأمر المهدىِّ شيد بناها","فاستطالت مجداً له العرش دانا",39,"ن",2,0],["وبأمر أمريكا وصهيونٍ ومَن","هو حاقدٌ أقصيتَ عبّاد القدير",40,"ر",1,0],["وبأمرِ الله تحرُّرُها","من غيرِ سلاحٍ أو متراسْ",41,"س",1,0],["وبأمره يهدي ويُعْمِهُ مَن يشا","وله الإرادة والسيادة واللُّهَى",42,"ه",2,0]]}