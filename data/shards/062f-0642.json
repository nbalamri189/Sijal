{"poems":[[71,"خبروها بأنه ما تصدى","https://www.aldiwan.net/poem4014.html","الخفيف"],[10,"لا تخل أنني لقيت رواحا","https://www.aldiwan.net/poem21066.html","الخفيف"],[72,"مسلسل من حديث الدمع مذروف","https://www.aldiwan.net/poem19258.html","البسيط"],[72,"خليلي من مصر قفا نبك في السبك","https://www.aldiwan.net/poem19441.html","الطويل"],[51,"أشجتك منزلة بمرجي راهط","https://www.aldiwan.net/poem65022.html","الكامل"],[85,"أحمدك الله وأطري الأنبياء","https://www.aldiwan.net/poem8099.html","الرمل"],[85,"المشرقان عليك ينتحبان","https://www.aldiwan.net/poem8188.html","الكامل"],[56,"شادن راح نحو سرحة ماء","https://www.aldiwan.net/poem58617.html","الخفيف"],[45,"بعض هذا العتاب والتفنيد","https://www.aldiwan.net/poem63476.html","الخفيف"],[66,"دق شوال في قفا رمضان","https://www.aldiwan.net/poem39193.html","الخفيف"],[97,"مرت حياتي دون أمنية","https://www.aldiwan.net/poem24923.html","أحذ الكامل"],[80,"أوميض البرق في الليل البهيم","https://www.aldiwan.net/poem31292.html","الرمل"],[44,"لها وأعارني ولها","https://www.aldiwan.net/poem30085.html","مجزوء الوافر"],[44,"إن عهدا لو تعلمان ذميما","https://www.aldiwan.net/poem30357.html","الخفيف"],[69,"دقاق قمح مليح","https://www.aldiwan.net/poem28310.html","المجتث"],[31,"خليلي مرا بي على رسم منزل","https://www.aldiwan.net/poem41841.html","الطويل"],[40,"قد رابه ولمثل ذلك رابه","https://www.aldiwan.net/poem42339.html","الكامل"],[48,"دق معنى الخمر حتى","https://www.aldiwan.net/poem65285.html","مجزوء الرمل"],[48,"لا تحزنن لفرقة الأقران","https://www.aldiwan.net/poem65305.html","الكامل"],[48,"نك من لقيت من البشر","https://www.aldiwan.net/poem66623.html","مجزوء الكامل"],[76,"أرقت وقلبي عنك ليس يفيق","https://www.aldiwan.net/poem39255.html","الطويل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20248","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16699","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42815","البسيط"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24724","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54303","الكامل"],[106,"انتصار الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179290",""],[106,"الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=179448",""],[45,"بَعْضَ هَذا العِتَابِ وَالتّفْنيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=31628",""],[113,"سر التجلي معناه","https://www.aldiwan.net/poem42199.html","منهوك المنسرح"],[209,"تحدثت بالهتاف أنك حاضر لإيناس","https://www.aldiwan.net/poem46315.html","الطويل"],[229,"دق المعنى فحار لب الفهم","https://www.aldiwan.net/poem43673.html","الدوبيت"],[230,"هوى لولا لواحظ أم عمرو","https://www.aldiwan.net/poem14885.html","الوافر"],[233,"يا صلاح الدين خذ حذ","https://www.aldiwan.net/poem31807.html","مجزوء الرمل"],[278,"متى ارتجعت مواهبها الكرام","https://www.aldiwan.net/poem60717.html","الوافر"],[280,"ذكرتك إذ شمت بالشام برقا","https://www.aldiwan.net/poem32694.html","المتقارب"],[280,"أيامنا بالرقمتين تولت","https://www.aldiwan.net/poem32857.html","الكامل"],[296,"أما ترى تحية السحاب","https://www.aldiwan.net/poem36833.html","عموديه"],[320,"أتصرم أم تواصلك النجود","https://www.aldiwan.net/poem56354.html","الوافر"],[366,"ألا بان جيراني ولست بعائف","https://www.aldiwan.net/poem1874.html","الطويل"],[369,"أطاعك الدمع الذي كان عصى","https://www.aldiwan.net/poem57538.html","الرجز"],[374,"هبطت إليك من المحل الأرفع","https://www.aldiwan.net/poem59343.html","الكامل"],[377,"من لولهان كئيب","https://www.aldiwan.net/poem49235.html","مجزوء الرمل"],[397,"في جوف الكعبة","https://www.aldiwan.net/poem6711.html","عموديه"],[402,"يا قمرا في الفؤاد حلا","https://www.aldiwan.net/poem49813.html","مخلع البسيط"],[426,"ما لذة المرء بالكاسات والوتر","https://www.aldiwan.net/poem40743.html","البسيط"],[429,"دقق ابن اليسار سي المعاني","https://www.aldiwan.net/poem12766.html","الخفيف"],[456,"ما جد السعي أتاه ما سعى له","https://www.aldiwan.net/poem55933.html","الرمل"],[456,"إما تقومون كذا أو فاقعدوا","https://www.aldiwan.net/poem56238.html","الرجز"],[459,"شربت دما ان حال ودي ساعة","https://www.aldiwan.net/poem15480.html","الطويل"],[462,"أنة الحب زفرة وعويل","https://www.aldiwan.net/poem3412.html","عموديه"],[498,"خذ شهودا عن شهود الكائنات","https://www.aldiwan.net/poem38068.html","الرمل"],[536,"إن كان في كل أرض ما تشان به","https://www.aldiwan.net/poem48233.html","عموديه"],[549,"يا طائر الأيك غرد لي على الفنن","https://www.aldiwan.net/poem47158.html","البسيط"],[549,"يوم الحمى ما أنت من همي","https://www.aldiwan.net/poem47212.html","أحذ الكامل"],[560,"نادى منادي البين حي على السرى","https://www.aldiwan.net/poem52892.html","الكامل"]],"verses":[["دَقَّ فِكراً في المُشكِلاتِ فَجَلَّت","بِمَديحٍ أَوصافُهُ أَن تُحَدّا",0,"د",2,0],["دَقَّ عَظمي وَهاضَ مِنّي جَناحي","هُلكُ صَخرٍ فَما أُطيقُ بَراحا",1,"ح",2,0],["دقَّت يدُ الرزق بابي وهي ناشزةٌ","فقلت كسّ أخت رزق فيه تعسيف",2,"ف",1,0],["دقاق تحملن الجليل وتشتكي","إليها فلا تشكو ولكنها تشكي",3,"ك",2,0],["دقّوا فلو أولجْتَهم لتولَّجوا","من دقَّةٍ في سَمِّ إبرة خائطِ",4,"ط",1,0],["دَقَّ كَالناقوسِ وَسطَ الهَيكَل","في اِنتِفاضٍ كَاِنتِفاضِ البُلبُل",5,"ل",1,0],["دَقّاتُ قَلبِ المَرءِ قائِلَةٌ لَهُ","إِنَّ الحَياةَ دَقائِقٌ وَثَواني",6,"ي",1,0],["دَقَّ حتى حَسِبْتُهُ وَرَقَ الوَرْ","دِ جَنِيّاً يَرِفُّ بينَ الرِّياحِ",7,"ح",1,0],["دَقَّ فَهماً وَجَلَّ عِلماً فَأَرضى اللَ","هَ فينا وَالواثِقَ إِبنَ الرَشيدِ",8,"د",1,0],["دَقَّ شَوّالُ في قَفا رَمَضانِ","وَأَتى الفِطرُ مُؤذِناً بِالتَهاني",9,"ن",2,1],["دقّت يد النعمى على بابي","والعيش خابى النجم آفله",10,"ه",1,0],["دقّ فيه السّمْرَ طعناً وَثَنى","وَرَقَ الفولاذِ بالضربِ هشيم",11,"م",1,0],["دَقيقُ مَحاسِنٍ وُصِلَت","مَحاسِنُ وَجنَتَيهِ بِها",12,"ه",2,0],["دِقَّةٌ في الحَياةِ تُدعى جَلالاً","مِثلَما سُمِّيَ اللَديغُ سَليما",13,"م",2,0],["دقاقُ قمحٍ مليحٍ","للبدرِ يدعو علامَهْ",14,"ه",1,1],["دِقاقاً بَراها السَيرُ مِنها مُنَعَّلُ ال","سَريحِ وَواقٍ مِن حَفىً لَم يُنَعَّلِ",15,"ل",1,0],["دَقّاً يُراوِجُ دَقَّهُ ثَفَناتِهِ","سَحقَ التَخَلّصِ إِذ يَصِيحُ جَنابُهُ",16,"ب",2,0],["دَقَّ مَعنى الخَمرِ حَتّى","هُوَ في رَجمِ الظُنونِ",17,"ن",1,1],["دَقَّت عَنِ اللَحَظاتِ حَتّى ما تَرى","إِلّا اِلتِماعَ شُعاعِها العَينانِ",18,"ن",1,0],["دقّا بهِ رأسيكما","وكُلا الترابَ من المَدر",19,"ر",1,0],["دقيقُ فرندِ الحُسنِ أمَّا وشاحُهُ","فيَهْفو وأما حِجلُهُ فيضيقُ",20,"ق",1,0],["دَقّوا عَلَيها بابَها","وَاللَيلُ مَسدولُ النِقاب",21,"ب",1,0],["دَقّتْ وما رَقّتْ ولكنّها","جاءتْ كما راقكَ ضَحْضَاحُ غَيْل",22,"ل",1,0],["دَقَّتْ وَجَلَّتْ وَلانَتْ وَهْيَ قَاسِيَةٌ","كَذَاكَ حَدُّ الْمَوَاضِي لَيِّنٌ خَشِنُ",23,"ن",1,0],["دقيقاً مثل فطنتك الْ","لتي دَقَّتْ عن الفطَنِ",24,"ن",1,0],["دقّوا فما أودَى بعزم أكفِّهم","بأسُ الحديدِ وقسوةُ الألواح",25,"ح",1,0],["دقَّتْ لغير ترحُّلٍ أطنابَها","ورمتْ مراسيها لغيرِ بَراح",25,"ح",1,0],["دقُّوا عليه بابهُ","وبوجههِ عنهم أشاح",26,"ح",1,0],["دقة الحِسِّ لم تدع لي فؤادًا","ملك الحسن من فؤادي الزماما",27,"م",2,0],["دَقّ فَهماً وَجَلّ عِلماً، فأرْضى","الله فينَا، وَالوَاثقَ بنَ الرّشيدِ",28,"د",1,0],["دقائق في الطي","عنوان أمر الحي",29,"ي",1,0],["دقائق كالأعوام طالت ولم تجىء","حماك إله الحبّ من كل عائق",30,"ق",1,0],["دق المعنى فحار لب الفهم","في متضح عن الورى منعجم",31,"م",1,1],["دَقيقَة صَفحَةِ الخَدَّينِ أَشهى","مِنَ الماءِ الزُلالِ عَلى الظَماءِ",32,"ا",2,0],["دَقَّ لُؤماً فَتَفَطَّن","في مَعانيهِ الدِقاقِ",33,"ق",1,0],["دَقِيقُ مَحاسِنِ الأَخْلاقِ يَبْدُو","أَمامَ نَداهُ بِشْرٌ وَابْتِسامُ",34,"م",1,0],["دَقيقٌ يُجَلّي جَليلَ الخُطوبِ","بِخَطٍّ قَنا الخَطّ تَخشاهُ صدقا",35,"ق",2,0],["دَقَّت وَجَلَّت لَوعتي فيها كما","دَقَّت مَعانيها الحِسانُ وَجَلَّتِ",36,"ت",1,0],["دقَّتْ عن الأوصافِ والأسماء","لكنّها رائحةُ (الفيحاءِ)",37,"ا",2,0],["دَقيقِ الخَصرِ رَحبِ الجَوفِ شَثنٍ","كَأَنَّ أَخاً تَوالِيهِ عَمودُ",38,"د",1,0],["دِقاقُ الحُضُورِ لم تُعَفَّرْ قُرُونُها","لِشَجْوٍ ولم يَحْضُرْنَ حُمَّى المَزالِفِ",39,"ف",1,0],["دقّت على أفهامِنا أوصافُه","كأنّه في الأرضِ من أهل السما",40,"ا",1,0],["دقت ورقَّت جوهراً فكأنها","ورقاءُ ذات تعزُّزٍ وتمنُّع",41,"ع",1,0],["دَقَ شَخصي فيكَ إِن يُد","ركهُ فكر لَبيب",42,"ب",1,0],["دقائقُ عَشْرٌ كالقرونِ مكانةً","وأَعْظَمُ في الميزان شأناً وأَثْقَلُ",43,"ل",1,0],["دقَّتْ معَانيِه حينَ جَلاّ","مَنْ لوَ يشاُ الهُمومَ جَلّى",44,"ل",2,0],["دقيق ريشٍ ونقش الصدر ذا عنقٍ","رقيق أبيض ذي طولٍ بلا قصر",45,"ر",1,0],["دقّقَ ابنُ اليَسارِ سيّ المعاني","في الحديثِ الذي يُضافُ إليهِ",46,"ي",2,1],["دقّ فاستصعب ما تحملُهُ","وهي تحت الحِمل بزلاءُ جُلالَهْ",47,"ل",2,0],["دقَّ وجلَّ فهو إن لامستَهُ","سَبْطٌ وإن مارسته مُجَعَّدُ",48,"د",1,0],["دقيقِ المَعاني في المَعالي مَقامُه","اذا عُدَّت الأحساب في الشرف العبل",49,"ل",1,0],["دقَّ خصراً وجلَّ للحسن ردفاً","فسباني الحسن الدقيق الجليلُ",50,"ل",1,0],["دُقَّ طبلُ السَّعْدِ لي في الحضرَتَيْنْ","ثانِيَ اثنينِ التَّدلِّي ثالِثي",51,"ي",1,0],["دَقَّ فمن قلتُ قال افتجح فقلتُ لِمَن","قال افتَحَن أنا ربُّ المطعِم البلدي",52,"د",2,0],["دقّتْ وما زالتِ الأشطانُ تجذبُها","إلى المَهامِهِ حتّى صِرْن كالشَّطَنِ",53,"ن",1,0],["دقّوا كَما دقّ المحالُ وما","لا طائلٌ فيه عن الفهمِ",54,"م",1,0],["دَقَّت معَانيهِ ورَقَّ نسيمُها","وسَمَت على أوهامِنا أنْ تُحصَرا",55,"ر",2,0]]}