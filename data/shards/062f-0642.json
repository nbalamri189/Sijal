5",""],[2638,"المُتْرَار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87860&r=&rc=17",""]],"verses":[["دَقَّ فِكراً في المُشكِلاتِ فَجَلَّت","بِمَديحٍ أَوصافُهُ أَن تُحَدّا",0,"د",2,0],["دَقَّ عَظمي وَهاضَ مِنّي جَناحي","هُلكُ صَخرٍ فَما أُطيقُ بَراحا",1,"ح",2,0],["دقَّت يدُ الرزق بابي وهي ناشزةٌ","فقلت كسّ أخت رزق فيه تعسيف",2,"ف",1,0],["دقاق تحملن الجليل وتشتكي","إليها فلا تشكو ولكنها تشكي",3,"ك",2,0],["دقّوا فلو أولجْتَهم لتولَّجوا","من دقَّةٍ في سَمِّ إبرة خائطِ",4,"ط",1,0],["دَقَّ كَالناقوسِ وَسطَ الهَيكَل","في اِنتِفاضٍ كَاِنتِفاضِ البُلبُل",5,"ل",1,0],["دَقّاتُ قَلبِ المَرءِ قائِلَةٌ لَهُ","إِنَّ الحَياةَ دَقائِقٌ وَثَواني",6,"ن",2,0],["دَقَّ حتى حَسِبْتُهُ وَرَقَ الوَرْ","دِ جَنِيّاً يَرِفُّ بينَ الرِّياحِ",7,"ح",1,0],["دَقَّ فَهماً وَجَلَّ عِلماً فَأَرضى اللَ","هَ فينا وَالواثِقَ إِبنَ الرَشيدِ",8,"د",1,0],["دَقَّ شَوّالُ في قَفا رَمَضانِ","وَأَتى الفِطرُ مُؤذِناً بِالتَهاني",9,"ن",2,1],["دقّت يد النعمى على بابي","والعيش خابى النجم آفله",10,"ه",1,0],["دقّ فيه السّمْرَ طعناً وَثَنى","وَرَقَ الفولاذِ بالضربِ هشيم",11,"م",1,0],["دَقيقُ مَحاسِنٍ وُصِلَت","مَحاسِنُ وَجنَتَيهِ بِها",12,"ه",2,0],["دِقَّةٌ في الحَياةِ تُدعى جَلالاً","مِثلَما سُمِّيَ اللَديغُ سَليما",13,"م",2,0],["دقاقُ قمحٍ مليحٍ","للبدرِ يدعو علامَهْ",14,"ه",1,1],["دِقاقاً بَراها السَيرُ مِنها مُنَعَّلُ ال","سَريحِ وَواقٍ مِن حَفىً لَم يُنَعَّلِ",15,"ل",1,0],["دَقّاً يُراوِجُ دَقَّهُ ثَفَناتِهِ","سَحقَ التَخَلّصِ إِذ يَصِيحُ جَنابُهُ",16,"ب",2,0],["دَقَّ مَعنى الخَمرِ حَتّى","هُوَ في رَجمِ الظُنونِ",17,"ن",1,1],["دَقَّت عَنِ اللَحَظاتِ حَتّى ما تَرى","إِلّا اِلتِماعَ شُعاعِها العَينانِ",18,"ن",1,0],["دقّا بهِ رأسيكما","وكُلا الترابَ من المَدر",19,"ر",1,0],["دقيقُ فرندِ الحُسنِ أمَّا وشاحُهُ","فيَهْفو وأما حِجلُهُ فيضيقُ",20,"ق",1,0],["دَقّوا عَلَيها بابَها","وَاللَيلُ مَسدولُ النِقاب",21,"ب",1,0],["دَقّتْ وما رَقّتْ ولكنّها","جاءتْ كما راقكَ ضَحْضَاحُ غَيْل",22,"ل",1,0],["دَقَّتْ وَجَلَّتْ وَلانَتْ وَهْيَ قَاسِيَةٌ","كَذَاكَ حَدُّ الْمَوَاضِي لَيِّنٌ خَشِنُ",23,"ن",1,0],["دقيقاً مثل فطنتك الْ","لتي دَقَّتْ عن الفطَنِ",24,"ن",1,0],["دقّوا فما أودَى بعزم أكفِّهم","بأسُ الحديدِ وقسوةُ الألواح",25,"ح",1,0],["دقَّتْ لغير ترحُّلٍ أطنابَها","ورمتْ مراسيها لغيرِ بَراح",25,"ح",1,0],["دقُّوا عليه بابهُ","وبوجههِ عنهم أشاح",26,"ح",1,0],["دقة الحِسِّ لم تدع لي فؤادًا","ملك الحسن من فؤادي الزماما",27,"م",2,0],["دَقّ فَهماً وَجَلّ عِلماً، فأرْضى","الله فينَا، وَالوَاثقَ بنَ الرّشيدِ",28,"د",1,0],["دقائق في الطي","عنوان أمر الحي",29,"ي",1,0],["دقائق كالأعوام طالت ولم تجىء","حماك إله الحبّ من كل عائق",30,"ق",1,0],["دق المعنى فحار لب الفهم","في متضح عن الورى منعجم",31,"م",1,1],["دَقيقَة صَفحَةِ الخَدَّينِ أَشهى","مِنَ الماءِ الزُلالِ عَلى الظَماءِ",32,"ا",2,0],["دَقَّ لُؤماً فَتَفَطَّن","في مَعانيهِ الدِقاقِ",33,"ق",1,0],["دَقِيقُ مَحاسِنِ الأَخْلاقِ يَبْدُو","أَمامَ نَداهُ بِشْرٌ وَابْتِسامُ",34,"م",1,0],["دَقيقٌ يُجَلّي جَليلَ الخُطوبِ","بِخَطٍّ قَنا الخَطّ تَخشاهُ صدقا",35,"ق",2,0],["دَقَّت وَجَلَّت لَوعتي فيها كما","دَقَّت مَعانيها الحِسانُ وَجَلَّتِ",36,"ت",1,0],["دقَّتْ عن الأوصافِ والأسماء","لكنّها رائحةُ (الفيحاءِ)",37,"ا",2,0],["دَقيقِ الخَصرِ رَحبِ الجَوفِ شَثنٍ","كَأَنَّ أَخاً تَوالِيهِ عَمودُ",38,"د",1,0],["دِقاقُ الحُضُورِ لم تُعَفَّرْ قُرُونُها","لِشَجْوٍ ولم يَحْضُرْنَ حُمَّى المَزالِفِ",39,"ف",1,0],["دقّت على أفهامِنا أوصافُه","كأنّه في الأرضِ من أهل السما",40,"ا",1,0],["دقت ورقَّت جوهراً فكأنها","ورقاءُ ذات تعزُّزٍ وتمنُّع",41,"ع",1,0],["دَقَ شَخصي فيكَ إِن يُد","ركهُ فكر لَبيب",42,"ب",1,0],["دقائقُ عَشْرٌ كالقرونِ مكانةً","وأَعْظَمُ في الميزان شأناً وأَثْقَلُ",43,"ل",1,0],["دقَّتْ معَانيِه حينَ جَلاّ","مَنْ لوَ يشاُ الهُمومَ جَلّى",44,"ل",2,0],["دقيق ريشٍ ونقش الصدر ذا عنقٍ","رقيق أبيض ذي طولٍ بلا قصر",45,"ر",1,0],["دقّقَ ابنُ اليَسارِ سيّ المعاني","في الحديثِ الذي يُضافُ إليهِ",46,"ي",2,1],["دقّ فاستصعب ما تحملُهُ","وهي تحت الحِمل بزلاءُ جُلالَهْ",47,"ل",2,0],["دقَّ وجلَّ فهو إن لامستَهُ","سَبْطٌ وإن مارسته مُجَعَّدُ",48,"د",1,0],["دقيقِ المَعاني في المَعالي مَقامُه","اذا عُدَّت الأحساب في الشرف العبل",49,"ل",1,0],["دقَّ خصراً وجلَّ للحسن ردفاً","فسباني الحسن الدقيق الجليلُ",50,"ل",1,0],["دُقَّ طبلُ السَّعْدِ لي في الحضرَتَيْنْ","ثانِيَ اثنينِ التَّدلِّي ثالِثي",51,"ي",1,0],["دَقَّ فمن قلتُ قال افتجح فقلتُ لِمَن","قال افتَحَن أنا ربُّ المطعِم البلدي",52,"د",2,0],["دقّتْ وما زالتِ الأشطانُ تجذبُها","إلى المَهامِهِ حتّى صِرْن كالشَّطَنِ",53,"ن",1,0],["دقّوا كَما دقّ المحالُ وما","لا طائلٌ فيه عن الفهمِ",54,"م",1,0],["دَقَّت معَانيهِ ورَقَّ نسيمُها","وسَمَت على أوهامِنا أنْ تُحصَرا",55,"ر",2,0],["دقت محاسنها فلا عمل حكي","ما ابدعته حكمة الرحمن",56,"ن",1,0],["دقائق الحسن يحويها له درج","فحبذا منه بالساعات ساعات",57,"ت",1,0],["دُقَّ طبلُ السُرور في التَخت لَمّا","جئت تَسعى إِلَيهِ في مَهرَجان",58,"ن",1,0],["دقَّت معانيها ورقَّ نسيمها","وَبَدت محاسنُها وطابَ زمانها",59,"ن",3,0],["دقَّ في حسنه وجلَّ فأضحى","هُوَ طوراً يخفى وطوراً يُحَسُّ",60,"س",1,0],["دقتَ الكريهةَ بَغتةً وفَقدتَها","وكريه فقدِك في الورى لا يُفقَدُ",61,"د",1,0],["دقِيقِ حَوَاشِي الذّهْنِ هُذِّبَ طَبْعُهُ","وَمُحِّصَ فِي قُرْبِ الْمَدَى أَيَّمَا مَحْصِ",62,"ص",1,0],["دَقّاتُ قَلبي وَالحبا","بُ مِنَ الجَوى يَتَشاكَيانِ",63,"ن",1,0],["دِقَّةُ الناقوسِ مَعنى لِاِسمِها","وَاِسمُها مِلءَ تَسابيح السّحَرْ",64,"ر",1,0],["دقَّتْ عن الأَفهام حتى حكت","عبارةَ المولى الأَجلِّ العِماد",65,"د",1,0],["دَقَّ مَعْنايَ فيكَ مُذْ كُنتَ طِفْلاً","لسْتُ أَدْري بِكمْ يُباعُ الدَّقيقُ",66,"ق",1,0],["دقق وحقق تأمل","شرح فتح المعين",67,"ن",1,0],["دقق بفكرك ما لاحت شواهده","عليك في كل ساعات وحالات",68,"ت",1,0],["دقق بنكرك يا فطين فاتها","عبر بها قد حارت الألباب",69,"ب",1,0],["دقّت معاني الفضلِ فيّ","وحِرفتي منه أدقُّ",70,"ق",1,0],["دقّت معاني الفضلِ فِيَّ","وحِرفتي مِنها أدَق",71,"ق",1,0],["دقيقين لا حُرمَةً يَعرِفَانِ","لِجَارٍ وَلاَ سَائِلٍ مُعتَرِي",72,"ر",2,0],["دقّت بشائره في مصر وانتشرت","راياته بقلوع آذنت بوفا",73,"ف",2,0],["دقل يناط به شراع الدين","وَسَفينة تجري عَلى ياسين",74,"ن",1,1],["دقة للبحتري في أسر يشا","ر ونسج ابن معمر أو خفاف",75,"ف",1,0],["دقيقَةُ اللّماتِ في رُؤسها","كأنَّهُ أسودُ جعدٌ قطط",76,"ط",1,0],["دَقّوا الكُؤوسَ وَراحوا يَضحَكونَ لَها","ما بَينَ 