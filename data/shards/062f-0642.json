{"poems":[[71,"خبروها بأنه ما تصدى","https://www.aldiwan.net/poem4014.html","الخفيف"],[10,"لا تخل أنني لقيت رواحا","https://www.aldiwan.net/poem21066.html","الخفيف"],[72,"مسلسل من حديث الدمع مذروف","https://www.aldiwan.net/poem19258.html","البسيط"],[72,"خليلي من مصر قفا نبك في السبك","https://www.aldiwan.net/poem19441.html","الطويل"],[51,"أشجتك منزلة بمرجي راهط","https://www.aldiwan.net/poem65022.html","الكامل"],[85,"أحمدك الله وأطري الأنبياء","https://www.aldiwan.net/poem8099.html","الرمل"],[85,"المشرقان عليك ينتحبان","https://www.aldiwan.net/poem8188.html","الكامل"],[56,"شادن راح نحو سرحة ماء","https://www.aldiwan.net/poem58617.html","الخفيف"],[45,"بعض هذا العتاب والتفنيد","https://www.aldiwan.net/poem63476.html","الخفيف"],[66,"دق شوال في قفا رمضان","https://www.aldiwan.net/poem39193.html","الخفيف"],[97,"مرت حياتي دون أمنية","https://www.aldiwan.net/poem24923.html","أحذ الكامل"],[80,"أوميض البرق في الليل البهيم","https://www.aldiwan.net/poem31292.html","الرمل"],[44,"لها وأعارني ولها","https://www.aldiwan.net/poem30085.html","مجزوء الوافر"],[44,"إن عهدا لو تعلمان ذميما","https://www.aldiwan.net/poem30357.html","الخفيف"],[69,"دقاق قمح مليح","https://www.aldiwan.net/poem28310.html","المجتث"],[31,"خليلي مرا بي على رسم منزل","https://www.aldiwan.net/poem41841.html","الطويل"],[40,"قد رابه ولمثل ذلك رابه","https://www.aldiwan.net/poem42339.html","الكامل"],[48,"دق معنى الخمر حتى","https://www.aldiwan.net/poem65285.html","مجزوء الرمل"],[48,"لا تحزنن لفرقة الأقران","https://www.aldiwan.net/poem65305.html","الكامل"],[48,"نك من لقيت من البشر","https://www.aldiwan.net/poem66623.html","مجزوء الكامل"],[76,"أرقت وقلبي عنك ليس يفيق","https://www.aldiwan.net/poem39255.html","الطويل"],[86,"","https://poetry.dctabudhabi.ae/diwan/poem/20248","الكامل"],[46,"","https://poetry.dctabudhabi.ae/diwan/poem/16699","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42815","البسيط"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/24724","الرمل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54303","الكامل"],[106,"انتصار الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=179290",""],[106,"الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=179448",""],[45,"بَعْضَ هَذا العِتَابِ وَالتّفْنيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=31628",""]],"verses":[["دَقَّ فِكراً في المُشكِلاتِ فَجَلَّت","بِمَديحٍ أَوصافُهُ أَن تُحَدّا",0,"د",2,0],["دَقَّ عَظمي وَهاضَ مِنّي جَناحي","هُلكُ صَخرٍ فَما أُطيقُ بَراحا",1,"ح",2,0],["دقَّت يدُ الرزق بابي وهي ناشزةٌ","فقلت كسّ أخت رزق فيه تعسيف",2,"ف",1,0],["دقاق تحملن الجليل وتشتكي","إليها فلا تشكو ولكنها تشكي",3,"ك",2,0],["دقّوا فلو أولجْتَهم لتولَّجوا","من دقَّةٍ في سَمِّ إبرة خائطِ",4,"ط",1,0],["دَقَّ كَالناقوسِ وَسطَ الهَيكَل","في اِنتِفاضٍ كَاِنتِفاضِ البُلبُل",5,"ل",1,0],["دَقّاتُ قَلبِ المَرءِ قائِلَةٌ لَهُ","إِنَّ الحَياةَ دَقائِقٌ وَثَواني",6,"ي",1,0],["دَقَّ حتى حَسِبْتُهُ وَرَقَ الوَرْ","دِ جَنِيّاً يَرِفُّ بينَ الرِّياحِ",7,"ح",1,0],["دَقَّ فَهماً وَجَلَّ عِلماً فَأَرضى اللَ","هَ فينا وَالواثِقَ إِبنَ الرَشيدِ",8,"د",1,0],["دَقَّ شَوّالُ في قَفا رَمَضانِ","وَأَتى الفِطرُ مُؤذِناً بِالتَهاني",9,"ن",2,1],["دقّت يد النعمى على بابي","والعيش خابى النجم آفله",10,"ه",1,0],["دقّ فيه السّمْرَ طعناً وَثَنى","وَرَقَ الفولاذِ بالضربِ هشيم",11,"م",1,0],["دَقيقُ مَحاسِنٍ وُصِلَت","مَحاسِنُ وَجنَتَيهِ بِها",12,"ه",2,0],["دِقَّةٌ في الحَياةِ تُدعى جَلالاً","مِثلَما سُمِّيَ اللَديغُ سَليما",13,"م",2,0],["دقاقُ قمحٍ مليحٍ","للبدرِ يدعو علامَهْ",14,"ه",1,1],["دِقاقاً بَراها السَيرُ مِنها مُنَعَّلُ ال","سَريحِ وَواقٍ مِن حَفىً لَم يُنَعَّلِ",15,"ل",1,0],["دَقّاً يُراوِجُ دَقَّهُ ثَفَناتِهِ","سَحقَ التَخَلّصِ إِذ يَصِيحُ جَنابُهُ",16,"ب",2,0],["دَقَّ مَعنى الخَمرِ حَتّى","هُوَ في رَجمِ الظُنونِ",17,"ن",1,1],["دَقَّت عَنِ اللَحَظاتِ حَتّى ما تَرى","إِلّا اِلتِماعَ شُعاعِها العَينانِ",18,"ن",1,0],["دقّا بهِ رأسيكما","وكُلا الترابَ من المَدر",19,"ر",1,0],["دقيقُ فرندِ الحُسنِ أمَّا وشاحُهُ","فيَهْفو وأما حِجلُهُ فيضيقُ",20,"ق",1,0],["دَقّوا عَلَيها بابَها","وَاللَيلُ مَسدولُ النِقاب",21,"ب",1,0],["دَقّتْ وما رَقّتْ ولكنّها","جاءتْ كما راقكَ ضَحْضَاحُ غَيْل",22,"ل",1,0],["دَقَّتْ وَجَلَّتْ وَلانَتْ وَهْيَ قَاسِيَةٌ","كَذَاكَ حَدُّ الْمَوَاضِي لَيِّنٌ خَشِنُ",23,"ن",1,0],["دقيقاً مثل فطنتك الْ","لتي دَقَّتْ عن الفطَنِ",24,"ن",1,0],["دقّوا فما أودَى بعزم أكفِّهم","بأسُ الحديدِ وقسوةُ الألواح",25,"ح",1,0],["دقَّتْ لغير ترحُّلٍ أطنابَها","ورمتْ مراسيها لغيرِ بَراح",25,"ح",1,0],["دقُّوا عليه بابهُ","وبوجههِ عنهم أشاح",26,"ح",1,0],["دقة الحِسِّ لم تدع لي فؤادًا","ملك الحسن من فؤادي الزماما",27,"م",2,0],["دَقّ فَهماً وَجَلّ عِلماً، فأرْضى","الله فينَا، وَالوَاثقَ بنَ الرّشيدِ",28,"د",1,0]]}