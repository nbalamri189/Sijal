{"poems":[[53,"لقد طال هزي من قوائم معشر","https://www.aldiwan.net/poem29850.html","الطويل"],[53,"من الظلم أن نتعاطى الخمارا","https://www.aldiwan.net/poem30470.html","المتقارب"],[53,"أبينتها أم ناكرتك شياتها","https://www.aldiwan.net/poem30677.html","الطويل"],[53,"ألا حيها رب العلى من غوارب","https://www.aldiwan.net/poem30755.html","الطويل"],[55,"ثقي بي فإني للأمانة موضع","https://www.aldiwan.net/poem26149.html","الطويل"],[55,"ثقي بعيني فلو آنست من بصري","https://www.aldiwan.net/poem26335.html","البسيط"],[77,"ما لليراع خواضع الأعناق","https://www.aldiwan.net/poem35907.html","الكامل"],[77,"ما لقلبي إذا هفا البرق حنا","https://www.aldiwan.net/poem36076.html","الخفيف"],[77,"الحق يعلو والأباطل تسفل","https://www.aldiwan.net/poem36367.html","الكامل"],[77,"لم أجد فيه لين بث لقلبي","https://www.aldiwan.net/poem36410.html","الخفيف"],[77,"تعلقته من دوحة الجود والباس","https://www.aldiwan.net/poem35881.html","الطويل"],[9,"رحلت سمية غدوة أجمالها","https://www.aldiwan.net/poem21970.html","الكامل"],[86,"ليلاي ما أنا حي","https://www.aldiwan.net/poem10682.html","المجتث"],[86,"أطل على الأكوان والخلق تنظر","https://www.aldiwan.net/poem10689.html","الطويل"],[73,"ثقي بي يا معذبتي فإني","https://www.aldiwan.net/poem11877.html","الوافر"],[35,"تنيل قليلا في تناء وهجرة","https://www.aldiwan.net/poem39130.html","الطويل"],[93,"صدق النعي وردد الهرمان","https://www.aldiwan.net/poem11225.html","الكامل"],[27,"أتصحو بل فؤادك غير صاح","https://www.aldiwan.net/poem5698.html","الوافر"],[37,"قف بالديار وقوف زائر","https://www.aldiwan.net/poem7174.html","مجزوء الكامل"],[47,"نفى النوم عن عيني خيال مسلم","https://www.aldiwan.net/poem25134.html","الطويل"],[23,"إذا الثقفي فاخركم فقولوا","https://www.aldiwan.net/poem21326.html","الوافر"],[72,"بقيت لحمد مثل فضلك واف","https://www.aldiwan.net/poem19259.html","الطويل"],[72,"إذا جاء عثمان مستخبرا","https://www.aldiwan.net/poem19641.html","المتقارب"],[51,"يا أخي أين ريع ذاك اللقاء","https://www.aldiwan.net/poem7944.html","الخفيف"],[51,"شاب رأسي ولات حين مشيب","https://www.aldiwan.net/poem8148.html","الخفيف"],[51,"ما مدمعي حذر النوى بقريح","https://www.aldiwan.net/poem9403.html","الكامل"],[51,"يا كائنا بين أوعاث وأوعار","https://www.aldiwan.net/poem62972.html","البسيط"],[51,"ثنى شوقه والمرء يصحو ويسكر","https://www.aldiwan.net/poem63015.html","الطويل"],[51,"رمين فؤادي من عيون الوصاوص","https://www.aldiwan.net/poem64935.html","الطويل"],[51,"بنات ثوابة ما في الأنام","https://www.aldiwan.net/poem65927.html","المتقارب"],[51,"إن امرأ رفض المكاسب واغتدى","https://www.aldiwan.net/poem66367.html","الكامل"],[51,"صدق القائلون إنك يا خالد","https://www.aldiwan.net/poem66743.html","الخفيف"],[38,"ألم يسأل الركب الديار العوافيا","https://www.aldiwan.net/poem7821.html","الطويل"],[89,"أذكى تعصب ثلة جهال","https://www.aldiwan.net/poem44909.html","الكامل"],[85,"قف بطوكيو وطف على يوكاهامه","https://www.aldiwan.net/poem63698.html","الخفيف"],[56,"شرفي محبة معشر","https://www.aldiwan.net/poem58627.html","مجزوء الكامل"],[43,"أقل فعالي بله أكثره مجد","https://www.aldiwan.net/poem9542.html","الطويل"],[62,"فديتك قد حان وقت الصبوح","https://www.aldiwan.net/poem52395.html","المتقارب"],[62,"هي العيس قودا في الأزمة تنفخ","https://www.aldiwan.net/poem52455.html","الطويل"],[62,"لمن في عراص البيد نوق مطاريب","https://www.aldiwan.net/poem52480.html","الطويل"],[45,"نفسي تقيك ووالداي كلاهما","https://www.aldiwan.net/poem10210.html","الكامل"],[45,"يجانبنا في الحب من لا نجانبه","https://www.aldiwan.net/poem10904.html","الطويل"],[45,"لأخي الحب عبرة ما تجف","https://www.aldiwan.net/poem65151.html","الخفيف"],[45,"هويناك من لوم على حب تكتما","https://www.aldiwan.net/poem65682.html","الطويل"],[28,"عفى المنازل آخر الأيام","https://www.aldiwan.net/poem5617.html","الكامل"],[61,"هلم فقد بردت راحنا","https://www.aldiwan.net/poem51414.html","المتقارب"],[66,"ثقتي بغير هواكم لا تحدث","https://www.aldiwan.net/poem38498.html","الكامل"],[80,"يا ذنوبي ثقلت والله ظهري","https://www.aldiwan.net/poem31425.html","الخفيف"],[80,"طرقت والليل ممدود الجناح","https://www.aldiwan.net/poem31522.html","الرمل"],[44,"نسج المشيب له لفاعا مغدفا","https://www.aldiwan.net/poem29716.html","الكامل"],[44,"أهلوك أضحوا شاخصا ومقوضا","https://www.aldiwan.net/poem30471.html","الكامل"],[69,"بهادر عبدي لا بهاء ولا در","https://www.aldiwan.net/poem28375.html","الطويل"],[69,"ثقيلة ردف قصدها قتلتي به","https://www.aldiwan.net/poem28734.html","الطويل"],[31,"ألمم بجور في الصفاح حسان","https://www.aldiwan.net/poem41303.html","الكامل"],[31,"منعت النوم بالسهد","https://www.aldiwan.net/poem42566.html","مجزوء الوافر"],[105,"لك من تحيات القلوب مواكب","https://www.aldiwan.net/poem42053.html","الكامل"],[105,"هذا الدفاع وهذه الأجناد","https://www.aldiwan.net/poem42120.html","الكامل"],[105,"حي الخليل وطف بتلك الدار","https://www.aldiwan.net/poem43086.html","الكامل"],[105,"رب أحببني وأحبب أسرتي","https://www.aldiwan.net/poem43384.html","الكامل"],[105,"ثقيف اجمعي للات ما شئت من عزم","https://www.aldiwan.net/poem43571.html","الطويل"],[105,"ثقيف انظري أين قصد الطريق","https://www.aldiwan.net/poem44033.html","المتقارب"],[105,"ما للسيوف أما تثوب فتعطف","https://www.aldiwan.net/poem44198.html","الكامل"],[67,"إلهي على كل الأمور لك الحمد","https://www.aldiwan.net/poem18053.html","الطويل"],[75,"قولا لمعتقل الرمح الرديني","https://www.aldiwan.net/poem69026.html","الطويل"],[75,"أحبب به قنصا إلى متقنص","https://www.aldiwan.net/poem69068.html","الكامل"],[48,"ثقيل يطالعنا من أمم","https://www.aldiwan.net/poem65265.html","المتقارب"],[50,"ألم يأن أن تسلى مودة مهددا","https://www.aldiwan.net/poem63919.html","الطويل"],[50,"ألا من لمطروب الفؤاد عميد","https://www.aldiwan.net/poem63957.html","الطويل"],[46,"يا للمفضل تكسوني مدائحه","https://www.aldiwan.net/poem23646.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85538","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85442","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85314","الطويل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85403","الكامل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39627","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55067","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54843","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54858","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43633","الطويل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43835","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43792","الرمل"],[51,"","https://poetry.dctabudhabi.ae/diwan/poem/23651","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54248","البسيط"],[106,"شبل بشبل","https://www.poetsgate.com/ViewPoem.aspx?id=179705",""],[106,"صاحب ثقيل","https://www.poetsgate.com/ViewPoem.aspx?id=179530",""],[50,"أَلاَ منْ لِمطْرُوبِ الْفُؤَادِ عمِيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=21663",""],[90,"المجلس المفجوع","https://www.poetsgate.com/ViewPoem.aspx?id=179038",""],[90,"أنغام الخطوب","https://www.poetsgate.com/ViewPoem.aspx?id=179139",""],[90,"إلى الشباب السوري","https://www.poetsgate.com/ViewPoem.aspx?id=179164",""],[90,"وادي العرائش","https://www.poetsgate.com/ViewPoem.aspx?id=179145",""],[90,"يافا الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=179202",""],[99,"اكتبي لي","https://www.poetsgate.com/ViewPoem.aspx?id=36388",""],[51,"ثِقلُ أوركها على عاتِقَي","https://www.poetsgate.com/ViewPoem.aspx?id=30704",""],[31,"ألمم بجورٍ في الصفاحِ حسانِ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19099&r=&rc=361",""],[31,"مُنِعْتُ النَّوْمَ بِالسَّهَدِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18837&r=&rc=100",""]],"verses":[["ثِقالٌ بِأَيديهِم خِفافٌ كَأَنَّما","أَطاروا إِلى الأَعداءِ مِن روسِها نَخلا",0,"ل",2,0],["ثِقا بِالإِلَهِ فَإِنَّ الزَما","نَ يُعطي أَماناً وَيُمطي حِذارا",1,"ر",2,0],["ثِقوا عَن قَليلٍ أَن يَهُبَّ شَرارُها","وَإِن قُلتُمُ قَد أُخمِدَت جَمَراتُها",2,"ت",3,0],["ثِقالاً بِأَعباءِ العَوالي كَأَنَّما","يَطَأنَ الرُبى وَطءَ الإِماءِ الحَواطِبِ",3,"ب",1,0],["ثِقي بي فَإِنّي لِلأَمانَةِ مَوضِعٌ","كَفى بي فَإِنّي بِالوَفاءِ كَفيلُ",4,"ل",1,1],["ثِقي بِعَيني فَلَو آنَستُ مِن بَصَري","خِيانَةً لَكِ لَم يَصحَبنِيَ البَصَرُ",5,"ر",1,1],["ثِقْ بالوَفاءِ علَى المَدى في فِتْيَةٍ","بكَ تقْتَدي في العَهْدِ والمِيثاقِ",6,"ق",1,0],["ثِقَةً بِالْوَفَاءِ فِي عَهْدِ خِلٍّ","أَصْبَحَ الْعَهْدُ عِنْدَهُ مُطْمَئِنا",7,"ن",2,0],["ثُقِفُوا بِكُلِّ ثَنِيَّةٍ وَتَبَادَرَتْ","بِهِمُ عُيُونُ الْمُؤَمِنِينَ فَقُتِّلُوا",8,"ل",3,0],["ثقّلَ اللهُ ظَهْرَهُ بعِيالٍ","سوّدَ اللهُ وجْهَهُ بعِذارِ",9,"ر",1,0],["ثِقوا بوَفائي ما اسْتَقلّتْ جوارِحي","ورَعْيِ ذِمامي ما تَماسَكَ إحْساسي",10,"س",2,0],["ثَقِفٌ إِذا نالَت يَداهُ غَنيمَةً","شَدَّ الرِكابَ لِمِثلِها لِيَنالَها",11,"ل",3,0],["ثِقوا فَإِنّا وَثِقنا","بِكُم وَجِئنا قَطينا",12,"ن",2,0],["ثِقوا بِالأَميرِ القائِمِ اليَومَ إِنَّهُ","بِكُم وَبِما تَرجونَ أَدرى وَأَخبَرُ",13,"ر",1,0],["ثِقي بي يا مُعَذِّبَتي فَإِنّي","سَأَحفَظُ فيكِ ما ضَيَّعتِ مِنّي",14,"ن",2,1],["ثَقيلُ الرَحى واهي الكِفافِ دَنا لَهُ","بِبيضِ الرُبى ذو هَيدَبٍ مُتَعَصِّفُ",15,"ف",1,0],["ثِقَةُ الثِّقَاتِ وَغَوْثُ كُلِّ مُهَذَّبٍ","أَوْدَى بِهِ رَيْبٌ مِنَ الحِدْثَانِ",16,"ن",1,0],["ثِقي بِاللَهِ لَيسَ لَهُ شَريكٌ","وَمِن عِندِ الخَليفَةِ بِالنَجاحِ",17,"ح",1,0],["ثقتي لكل ملمة","وعشيرتي دون العشائر",18,"ر",1,0],["ثَقيلٌ عَلى الأَعداءِ أَعقابُ وَطئِهِ","صَليبٌ عَلى أَفواهِها حينَ تُعجَمُ",19,"م",1,0],["ثَقيفٌ شَرُّ مَن رَكِبَ المَطايا","وَأَشباهُ الهَجارِسِ في القِتالِ",20,"ل",1,0],["ثقالاً بمنديلِي ألذّ بثقلها","وأخطر من بعد الحفا بخفاف",21,"ف",1,0],["ثقيلٌ ثقيلٌ ثقيل ثقيل","ثقيلٌ ثقيلٌ ثقيلٌ ثقيل",22,"ل",1,0],["ثَقُلتْ حاجتي عليك فأضحتْ","وهي عبءٌ من فادحِ الأعباءِ",23,"ا",2,0],["ثِقةً أنَّهُنَّ يلقينَ مرعىً","فيه نَيٌّ لكل نِضْوٍ شَزيبِ",24,"ب",1,0],["ثِقَةً بِسَيْبٍ منه ليس يعوقُهُ","مهما جرى من سَانح وبريحِ",25,"ح",1,0],["ثِقْ بالعوائد منهُ إنه رجل","كالسيل يحفِر تياراً بتيار",26,"ر",1,0],["ثقُلت فغادرت الكواهل كلها","ثقالاً فظهر الأرض من ذاك أدبر",27,"ر",1,0],["ثقيلات أردافٍ نبيلات أسْوُقٍ","وما شئتَ من قُبِّ البطونِ خَمائص",28,"ص",1,0],["ثقُلتُم فلو كنتُمُ تُنكَحو","ن باتت نساؤكم تُطحَلُ",29,"ل",1,0],["ثقةً برعْي الأكرمين حقوقه","لأحقُّ ملتمسٍ بأن لا يُحرما",30,"م",2,0],["ثِقلُ أوراكِها على عاتِقَيه","ولك النسلُ جئتَ شيئاً فَرِيّا",31,"ي",2,0],["ثَقالٌ إِذا رادَ النِساءُ خَريدَةٌ","صَناعٌ فَقَد سادَت إِلَيَّ الغَوانِيا",32,"ي",2,0],["ثق بالطبيعة انها مستعرض","فيه يطول تعاقب الاجيال",33,"ل",1,0],["ثِق بِما شِئتَ مِن زَمانِكَ إِلّا","صُحبَةَ العَيشِ أَو جِوارَ السَلامَه",34,"م",2,0],["ثِقْلُ الهُدَى وكِتَابُهُ","بَعْدَ النّبي تَشَتّتَا",35,"ت",2,0],["ثِقالٍ إِذا لاقَوا خِفافٍ إِذا دُعوا","كَثيرٍ إِذا شَدّوا قَليلٍ إِذا عُدّوا",36,"د",3,0],["ثِقالُ المآزرِ قُبُّ البطو","نِ غيرُ سِمانٍ ولا ضُمَّرِ",37,"ر",1,0],["ثِقالٌ إِذا اصطفَّ السِماطانِ حولَهمْ","خِفافٌ إِذا الداعي المُثَوِّبُ يصرُخُ",38,"خ",1,0],["ثقيلُ حَصاةِ الحِلم مستصحفُ الحُبَى","إِذا ما هفتْ قُودُ الجِبال الشَّنَاخِيبُ",39,"ب",1,0],["ثِقَلُ الخَراجِ عَلَيَّ دَينٌ مُؤلِمٌ","وَلَدَيكَ مِمّا أَشتَكيهِ دَوائي",40,"ي",1,0],["ثَقيلٌ عَلى جَنبِ الثَريدِ مُراقِبٌ","لِشَخصِ الخِوانِ يَبتَدي فَيُواثِبُه",41,"ب",2,0],["ثَقُلَت وَطأَةُ الزَمانِ عَلى جا","نِبِ وَفري وَأَقسَمَت لاتَخِفُّ",42,"ف",1,0],["ثِقافُ اللَيالي في يَدَيهِ فَإِن تَمِل","صُروفُ اللَيالي رَدَّ مِنها فَقَوَّما",43,"م",2,0],["ثَقُلَت عَلَيَّ عَمايَتانِ وَلَم أَجِد","سَبَباً يُحَوِّلُ لي جِبالَ شَمامِ",44,"م",1,0],["ثِقالٌ لدَى الوَزْنِ أحلامُنا","خِفافٌ لَدى القَصْفِ أرواحُنا",45,"ن",2,0],["ثِقَتي بِغَيرِ هَواكُمُ لا تَحدُثُ","وَيَدي بِحَبلِ وِصالِكُم تَتَشَبَّثُ",46,"ث",1,1],["ثَقُلَ الهَوى وَإِنِ اِستُلِذَّ فَإِنَّهُ","داءٌ بِهِ تَبلى العِظامُ وَتَشعَثُ",46,"ث",1,0],["ثَقَّفتَ زَيغَ المُلكِ يا نَجمَ الهُدى","بِأَسِنَّةٍ سَمَّ المَنِيَّةِ تَنفُثُ",46,"ث",1,0],["ثِقَةً بِأَنَّ يَدَ الرَدى إِن غادَرَت","مَيتاً فَعِندَكَ بِالمَكارِمِ يُبعَثُ",46,"ث",1,0],["ثَقُلتْ خَطْوَتي وفَوْدي تَفَرّى","غَيْهَبُ اللَّيلِ فيه عن نُورِ فجرِ",47,"ر",1,0],["ثَقّلِ الرّاحةَ مِنْ كاساتِها","برَداحٍ من يَدِ الخودِ الرّداح",48,"ح",1,0],["ثَقِّف فَتِيَّ الجودِ تَلقَ قَصائِداً","لاقَت أَوابِدُهُنَّ فيكَ مُثَقَّفا",49,"ف",2,0],["ثِقلاً لَو اَنَّ مُتالِعاً حَمَلَ اِسمَهُ","لا جِسمَهُ لَم يَستَطِع أَن يَنهَضا",50,"ض",2,0],["ثقيلٌ خفيفُ الكفِّ فيما ائتمنْتُهُ","وَثوبٌ على مالي كما يثبُ النمرُ",51,"ر",1,0],["ثقيلةُ ردفٍ قصدها قتلتي بهِ","فقلتُ لها إنْ تقتلي النفسَ تُقتلي",52,"ي",1,1],["ثَقُلَت عَجيزَتُها فَراثَ قِيامُها","وَمَشَت لَمَشيِ الشارِبِ النَشوانِ",53,"ن",1,0],["ثِقالٌ كَالمَهاةِ خَري","دَةٌ مِن نِسوَةٍ خُرُدِ",54,"د",1,0],["ثَقُلَتْ على مصرَ القيودُ فهزَّها","حتّى هوى منها العَضُوضُ النَّاشبُ",55,"ب",1,0],["ثِقةٌ وإيمانٌ وصِدقُ عزيمةٍ","تلك الذخائرُ ما لَهُنَّ نَفادُ",56,"د",1,0],["ثِقَةُ المَمالِكِ بِالرِجالِ وَحُبُّها","وَقفٌ عَلى أَبنائِها الأَخيارِ",57,"ر",1,0],["ثِقَةٌ ما خالَطَتها ريبَةٌ","وَيَقينٌ ما بِهِ مِن وَهَنِ",58,"ن",1,0],["ثَقِيفُ اجْمَعِي للَّاتِ ما شِئتِ من عَزْمِ","ولا تُسلِميها للمعاولِ والهَدْمِ",59,"م",1,1],["ثَقيفُ انظري أين قَصْدُ الطريقْ","وكيفَ يلقَّى النجاةَ الغريقْ",60,"ق",1,1],["ثَقيفُ ادْخُلِي الحصن لا تهلكي","ويا عَبْدَ ليل لماذا النَّعيقْ",60,"ق",1,0],["ثَقُلَتْ عليَّ من الغبيِّ مقالةٌ","جَلَلٌ تُهَدُّ بها الجبالُ وتُنْسَفُ",61,"ف",1,0],["ثِقاتٌ مِنَ الإِسلامِ إنْ يَعِدُوا يَفُوا","وإنْ يُسْأَلُوا يُهْدُوا وإنْ يُقْصَدُوا يُجْدُوا",62,"د",3,0],["ثَقِفتُ منهُ أديباً شاعراً لَسنِاً","شَتَى الأعاريضِ محذورَ الأحاجي",63,"ي",1,0],["ثَقُلَتْ روادفُها وأُدمِجَ خَصُرها","فأتَتْكَ بينَ مُفَعَّمٍ ومُخَمَّص",64,"ص",1,0],["ثَقيلٌ يُطالِعُنا مِن أَمَم","إِذا سَرَّهُ رَعفُ أَنفي أَلَم",65,"م",1,1],["ثَقالٌ إِذا راحَت كَسولٌ إِذا غَدَت","وَتَمشي الهُوَينا حينَ تَمشي تَأَوُّدا",66,"د",2,0],["ثَقيلَةُ ما بَينَ البُرينَ إِلى الحَشا","لَها عَينُ أَدمانٍ وَلَونُ فَريدِ",67,"د",1,0],["ثَقِيلةُ النهْضِ ممّا حُلّيتْ ذَهَباً","فليس تَمْلِكُ غيرَ المَشْيِ والعَنَقِ",68,"ق",1,0],["ثقل الإثم في العراق كثيراً","فَلماذا العراق ليس يغور",69,"ر",1,0],["ثقيل على روحي سماع نعيه","فيا لت سمعي كان عنه به وقر",70,"ر",1,0],["ثقي بدموعي في كتابي فإنني","بِنَفسيَ قد أَودعتهنَّ ولوعي",71,"ي",1,0],["ثقل المَريض وَلا أَقول ببرئه","حتىّ يَزول هنالك البحران",72,"ن",1,0],["ثِقي بملَّاحكِ في المأزقِ","إنّي أنا ابنُ الموج والعاصفاتْ",73,"ت",1,0],["ثَقَّفَ النَّشْء