 الذبل","https://www.aldiwan.net/poem15925.html","الكامل"],[462,"أقول لصحبي والهموم كأنها","https://www.aldiwan.net/poem15972.html","الطويل"],[462,"أما اذا سلم الامام الأعظم","https://www.aldiwan.net/poem16018.html","الكامل"],[465,"نعم هذه آثارهم والمنازل","https://www.aldiwan.net/poem3164.html","عموديه"],[465,"عداك وجدي فعد عن عذلي","https://www.aldiwan.net/poem3178.html","عموديه"],[465,"عرضت سماء الدجنِ زهر جنودها","https://www.aldiwan.net/poem3192.html","عموديه"],[465,"ما على الركب من تلافي تلافي","https://www.aldiwan.net/poem3215.html","عموديه"],[465,"بين القدود وبين أعطاف القنا","https://www.aldiwan.net/poem3325.html","عموديه"],[465,"وتنوفة عذراء لم تركب","https://www.aldiwan.net/poem3351.html","عموديه"],[465,"عثرة قلبي فيكم لا تقال","https://www.aldiwan.net/poem3558.html","عموديه"],[501,"لا تشوش لك سرا","https://www.aldiwan.net/poem37924.html","مجزوء الرمل"],[515,"ما حركت سكنات الأعين النجل","https://www.aldiwan.net/poem20788.html","البسيط"],[516,"لكل مقام في علاك مقال","https://www.aldiwan.net/poem12200.html","الطويل"],[530,"أنا مضطر وأرجو","https://www.aldiwan.net/poem37517.html","مجزوء الرمل"],[539,"بما بيننا من حرمة ايها الصحب","https://www.aldiwan.net/poem48303.html","عموديه"],[541,"ألم تأرق لضوء البرق","https://www.aldiwan.net/poem56864.html","الهزج"],[545,"المتنبي .. كون في ملامح كائن","https://www.aldiwan.net/poem67242.html","عموديه"],[552,"بقاء ولكن لو أتى لا أذمه","https://www.aldiwan.net/poem47249.html","الطويل"],[552,"أسيف الدين قد حملت ظهري","https://www.aldiwan.net/poem47308.html","الوافر"],[552,"قالوا الحبيبة تيمتك","https://www.aldiwan.net/poem47322.html","مجزوء الكامل"],[552,"حل ذاك الكناس ظبي ربيب","https://www.aldiwan.net/poem48093.html","الخفيف"],[559,"كل شيء لا يرى الرحمن به","https://www.aldiwan.net/poem33521.html","الرمل"],[559,"ثمرات على غصون الحوادث","https://www.aldiwan.net/poem33556.html","الخفيف"],[559,"ليس إلا مظاهر ومجالي","https://www.aldiwan.net/poem34223.html","الخفيف"],[559,"زينة العبد فقره واحتياجه","https://www.aldiwan.net/poem34682.html","الخفيف"],[565,"أجودُ ابن زين أو غيوثُ سواجم","https://www.aldiwan.net/poem890.html",""],[576,"جاءت بحسن مطمئن","https://www.aldiwan.net/poem3000.html","مجزوء الكامل"]],"verses":[["ثِقالٌ بِأَيديهِم خِفافٌ كَأَنَّما","أَطاروا إِلى الأَعداءِ مِن روسِها نَخلا",0,"ل",2,0],["ثِقا بِالإِلَهِ فَإِنَّ الزَما","نَ يُعطي أَماناً وَيُمطي حِذارا",1,"ر",2,0],["ثِقوا عَن قَليلٍ أَن يَهُبَّ شَرارُها","وَإِن قُلتُمُ قَد أُخمِدَت جَمَراتُها",2,"ت",3,0],["ثِقالاً بِأَعباءِ العَوالي كَأَنَّما","يَطَأنَ الرُبى وَطءَ الإِماءِ الحَواطِبِ",3,"ب",1,0],["ثِقي بي فَإِنّي لِلأَمانَةِ مَوضِعٌ","كَفى بي فَإِنّي بِالوَفاءِ كَفيلُ",4,"ل",1,1],["ثِقي بِعَيني فَلَو آنَستُ مِن بَصَري","خِيانَةً لَكِ لَم يَصحَبنِيَ البَصَرُ",5,"ر",1,1],["ثِقْ بالوَفاءِ علَى المَدى في فِتْيَةٍ","بكَ تقْتَدي في العَهْدِ والمِيثاقِ",6,"ق",1,0],["ثِقَةً بِالْوَفَاءِ فِي عَهْدِ خِلٍّ","أَصْبَحَ الْعَهْدُ عِنْدَهُ مُطْمَئِنا",7,"ن",2,0],["ثُقِفُوا بِكُلِّ ثَنِيَّةٍ وَتَبَادَرَتْ","بِهِمُ عُيُونُ الْمُؤَمِنِينَ فَقُتِّلُوا",8,"ل",3,0],["ثقّلَ اللهُ ظَهْرَهُ بعِيالٍ","سوّدَ اللهُ وجْهَهُ بعِذارِ",9,"ر",1,0],["ثِقوا بوَفائي ما اسْتَقلّتْ جوارِحي","ورَعْيِ ذِمامي ما تَماسَكَ إحْساسي",10,"س",2,0],["ثَقِفٌ إِذا نالَت يَداهُ غَنيمَةً","شَدَّ الرِكابَ لِمِثلِها لِيَنالَها",11,"ل",3,0],["ثِقوا فَإِنّا وَثِقنا","بِكُم وَجِئنا قَطينا",12,"ن",2,0],["ثِقوا بِالأَميرِ القائِمِ اليَومَ إِنَّهُ","بِكُم وَبِما تَرجونَ أَدرى وَأَخبَرُ",13,"ر",1,0],["ثِقي بي يا مُعَذِّبَتي فَإِنّي","سَأَحفَظُ فيكِ ما ضَيَّعتِ مِنّي",14,"ن",2,1],["ثَقيلُ الرَحى واهي الكِفافِ دَنا لَهُ","بِبيضِ الرُبى ذو هَيدَبٍ مُتَعَصِّفُ",15,"ف",1,0],["ثِقَةُ الثِّقَاتِ وَغَوْثُ كُلِّ مُهَذَّبٍ","أَوْدَى بِهِ رَيْبٌ مِنَ الحِدْثَانِ",16,"ن",1,0],["ثِقي بِاللَهِ لَيسَ لَهُ شَريكٌ","وَمِن عِندِ الخَليفَةِ بِالنَجاحِ",17,"ح",1,0],["ثقتي لكل ملمة","وعشيرتي دون العشائر",18,"ر",1,0],["ثَقيلٌ عَلى الأَعداءِ أَعقابُ وَطئِهِ","صَليبٌ عَلى أَفواهِها حينَ تُعجَمُ",19,"م",1,0],["ثَقيفٌ شَرُّ مَن رَكِبَ المَطايا","وَأَشباهُ الهَجارِسِ في القِتالِ",20,"ل",1,0],["ثقالاً بمنديلِي ألذّ بثقلها","وأخطر من بعد الحفا بخفاف",21,"ف",1,0],["ثقيلٌ ثقيلٌ ثقيل ثقيل","ثقيلٌ ثقيلٌ ثقيلٌ ثقيل",22,"ل",1,0],["ثَقُلتْ حاجتي عليك فأضحتْ","وهي عبءٌ من فادحِ الأعباءِ",23,"ا",2,0],["ثِقةً أنَّهُنَّ يلقينَ مرعىً","فيه نَيٌّ لكل نِضْوٍ شَزيبِ",24,"ب",1,0],["ثِقَةً بِسَيْبٍ منه ليس يعوقُهُ","مهما جرى من سَانح وبريحِ",25,"ح",1,0],["ثِقْ بالعوائد منهُ إنه رجل","كالسيل يحفِر تياراً بتيار",26,"ر",1,0],["ثقُلت فغادرت الكواهل كلها","ثقالاً فظهر الأرض من ذاك أدبر",27,"ر",1,0],["ثقيلات أردافٍ نبيلات أسْوُقٍ","وما شئتَ من قُبِّ البطونِ خَمائص",28,"ص",1,0],["ثقُلتُم فلو كنتُمُ تُنكَحو","ن باتت نساؤكم تُطحَلُ",29,"ل",1,0],["ثقةً برعْي الأكرمين حقوقه","لأحقُّ ملتمسٍ بأن لا يُحرما",30,"م",2,0],["ثِقلُ أوراكِها على عاتِقَيه","ولك النسلُ جئتَ شيئاً فَرِيّا",31,"ي",2,0],["ثَقالٌ إِذا رادَ النِساءُ خَريدَةٌ","صَناعٌ فَقَد سادَت إِلَيَّ الغَوانِيا",32,"ي",2,0],["ثق بالطبيعة انها مستعرض","فيه يطول تعاقب الاجيال",33,"ل",1,0],["ثِق بِما شِئتَ مِن زَمانِكَ إِلّا","صُحبَةَ العَيشِ أَو جِوارَ السَلامَه",34,"م",2,0],["ثِقْلُ الهُدَى وكِتَابُهُ","بَعْدَ النّبي تَشَتّتَا",35,"ت",2,0],["ثِقالٍ إِذا لاقَوا خِفافٍ إِذا دُعوا","كَثيرٍ إِذا شَدّوا قَليلٍ إِذا عُدّوا",36,"د",3,0],["ثِقالُ المآزرِ قُبُّ البطو","نِ غيرُ سِمانٍ ولا ضُمَّرِ",37,"ر",1,0],["ثِقالٌ إِذا اصطفَّ السِماطانِ حولَهمْ","خِفافٌ إِذا الداعي المُثَوِّبُ يصرُخُ",38,"خ",1,0],["ثقيلُ حَصاةِ الحِلم مستصحفُ الحُبَى","إِذا ما هفتْ قُودُ الجِبال الشَّنَاخِيبُ",39,"ب",1,0],["ثِقَلُ الخَراجِ عَلَيَّ دَينٌ مُؤلِمٌ","وَلَدَيكَ مِمّا أَشتَكيهِ دَوائي",40,"ي",1,0],["ثَقيلٌ عَلى جَنبِ الثَريدِ مُراقِبٌ","لِشَخصِ الخِوانِ يَبتَدي فَيُواثِبُه",41,"ب",2,0],["ثَقُلَت وَطأَةُ الزَمانِ عَلى جا","نِبِ وَفري وَأَقسَمَت لاتَخِفُّ",42,"ف",1,0],["ثِقافُ اللَيالي في يَدَيهِ فَإِن تَمِل","صُروفُ اللَيالي رَدَّ مِنها فَقَوَّما",43,"م",2,0],["ثَقُلَت عَلَيَّ عَمايَتانِ وَلَم أَجِد","سَبَباً يُحَوِّلُ لي جِبالَ شَمامِ",44,"م",1,0],["ثِقالٌ لدَى الوَزْنِ أحلامُنا","خِفافٌ لَدى القَصْفِ أرواحُنا",45,"ن",2,0],["ثِقَتي بِغَيرِ هَواكُمُ لا تَحدُثُ","وَيَدي بِحَبلِ وِصالِكُم تَتَشَبَّثُ",46,"ث",1,1],["ثَقُلَ الهَوى وَإِنِ اِستُلِذَّ فَإِنَّهُ","داءٌ بِهِ تَبلى العِظامُ وَتَشعَثُ",46,"ث",1,0],["ثَقَّفتَ زَيغَ المُلكِ يا نَجمَ الهُدى","بِأَسِنَّةٍ سَمَّ المَنِيَّةِ تَنفُثُ",46,"ث",1,0],["ثِقَةً بِأَنَّ يَدَ الرَدى إِن غادَرَت","مَيتاً فَعِندَكَ بِالمَكارِمِ يُبعَثُ",46,"ث",1,0],["ثَقُلتْ خَطْوَتي وفَوْدي تَفَرّى","غَيْهَبُ اللَّيلِ فيه عن نُورِ فجرِ",47,"ر",1,0],["ثَقّلِ الرّاحةَ مِنْ كاساتِها","برَداحٍ من يَدِ الخودِ الرّداح",48,"ح",1,0],["ثَقِّف فَتِيَّ الجودِ تَلقَ قَصائِداً","لاقَت أَوابِدُهُنَّ فيكَ مُثَقَّفا",49,"ف",2,0],["ثِقلاً لَو اَنَّ مُتالِعاً حَمَلَ اِسمَهُ","لا جِسمَهُ لَم يَستَطِع أَن يَنهَضا",50,"ض",2,0],["ثقيلٌ خفيفُ الكفِّ فيما ائتمنْتُهُ","وَثوبٌ على مالي كما يثبُ النمرُ",51,"ر",1,0],["ثقيلةُ ردفٍ قصدها قتلتي بهِ","فقلتُ لها إنْ تقتلي النفسَ تُقتلي",52,"ي",1,1],["ثَقُلَت عَجيزَتُها فَراثَ قِيامُها","وَمَشَت لَمَشيِ الشارِبِ النَشوانِ",53,"ن",1,0],["ثِقالٌ كَالمَهاةِ خَري","دَةٌ مِن نِسوَةٍ خُرُدِ",54,"د",1,0],["ثَقُلَتْ على مصرَ القيودُ فهزَّها","حتّى هوى منها العَضُوضُ النَّاشبُ",55,"ب",1,0],["ثِقةٌ وإيمانٌ وصِدقُ عزيمةٍ","تلك الذخائرُ ما لَهُنَّ نَفادُ",56,"د",1,0],["ثِقَةُ المَمالِكِ بِالرِجالِ وَحُبُّها","وَقفٌ عَلى أَبنائِها الأَخيارِ",57,"ر",1,0],["ثِقَةٌ ما خالَطَتها ريبَةٌ","وَيَقينٌ ما بِهِ مِن وَهَنِ",58,"ن",1,0],["ثَقِيفُ اجْمَعِي للَّاتِ ما شِئتِ من عَزْمِ","ولا تُسلِميها للمعاولِ والهَدْمِ",59,"م",1,1],["ثَقيفُ انظري أين قَصْدُ الطريقْ","وكيفَ يلقَّى النجاةَ الغريقْ",60,"ق",1,1],["ثَقيفُ ادْخُلِي الحصن لا تهلكي","ويا عَبْدَ ليل لماذا النَّعيقْ",60,"ق",1,0],["ثَقُلَتْ عليَّ من الغبيِّ مقالةٌ","جَلَلٌ تُهَدُّ بها الجبالُ وتُنْسَفُ",61,"ف",1,0],["ثِقاتٌ مِنَ الإِسلامِ إنْ يَعِدُوا يَفُوا","وإنْ يُسْأَلُوا يُهْدُوا وإنْ يُقْصَدُوا يُجْدُوا",62,"د",3,0],["ثَقِفتُ منهُ أديباً شاعراً لَسنِاً","شَتَى الأعاريضِ محذورَ الأحاجي",63,"ي",1,0],["ثَقُلَتْ روادفُها وأُدمِجَ خَصُرها","فأتَتْكَ بينَ مُفَعَّمٍ ومُخَمَّص",64,"ص",1,0],["ثَقيلٌ يُطالِعُنا مِن أَمَم","إِذا سَرَّهُ رَعفُ أَنفي أَلَم",65,"م",1,1],["ثَقالٌ إِذا راحَت كَسولٌ إِذا غَدَت","وَتَمشي الهُوَينا حينَ تَمشي تَأَوُّدا",66,"د",2,0],["ثَقيلَةُ ما بَينَ البُرينَ إِلى الحَشا","لَها عَينُ أَدمانٍ وَلَونُ فَريدِ",67,"د",1,0],["ثَقِيلةُ النهْضِ ممّا حُلّيتْ ذَهَباً","فليس تَمْلِكُ غيرَ المَشْيِ والعَنَقِ",68,"ق",1,0],["ثقل الإثم في العراق كثيراً","فَلماذا العراق ليس يغور",69,"ر",1,0],["ثقيل على روحي سماع نعيه","فيا لت سمعي كان عنه به وقر",70,"ر",1,0],["ثقي بدموعي في كتابي فإنني","بِنَفسيَ قد أَودعتهنَّ ولوعي",71,"ع",2,0],["ثقل المَريض وَلا أَقول ببرئه","حتىّ يَزول هنالك البحران",72,"ن",1,0],["ثِقي بملَّاحكِ في المأزقِ","إنّي أنا ابنُ الموج والعاصفاتْ",73,"ت",1,0],["ثَقَّفَ النَّشْءَ وَهْوَ يَعْلَمُ أَنْ الشَّرْقَ","إِلاَّ بِالنَّشْءِ لاَ يَسْتَفِيقُ",74,"ق",1,0],["ثِقَةً بَأَنَّ الْفَوْزَ لَيْسَ لِجَازِعٍ","فِي الْعَالَمِينَ الْفَوْزُ لِلصَّبَّارِ",75,"ر",1,0],["ثِقَةً بِفَوْزِكَ مَا غَلَوْتَ بِهَا","وَيَفُوزُ مَنْ لاَ يَعْدَمُ الصَّبْرَا",76,"ر",2,0],["ثِقالَةُ ردفَيها وَرِقَّةُ خَصرها","وَسِحرُ العُيونِ القاتِلاتِ البَواعِثِ",77,"ث",1,0],["ثَقِفتُ بِعَينَيكَ الأُسود كَأَنَّما","هُما سَيفُ جبّارٍ بِقَتلاهُ عابِثِ",77,"ث",1,0],["ثِقي بي عَلى ذا النَأيِ إِنّي لَمُقسِمٌ","بِعَينَيكِ لا أَشكو وَلَستُ بِحانِثِ",77,"ث",1,0],["ثِق أَنَّنا نَلتَقي بِطوبى","قَد يَغفِر اللَه ذَنب عاثِ",78,"ث",1,0],["ثَقَّفتني يا زَمانُ حَرباً","كَحَربِ صفَّين أَو بُعاثِ",78,"ث",1,0],["ثَقِّل اللهُمَّ ميزاني بِهِ","وَتَدارك لي فَعَقلي قَد زَهَق",79,"ق",1,0],["ثقلتُ في كفة الميزان فانكدرتْ","تهوي وشالت خفاف القوم أقدارا",80,"ر",2,0],["ثقافةُ الفُرْسِ قد كانت ثقافَتنا","في كلِّ ناحيةٍ عنهم أخذناها",81,"ا",3,0],["ثقةُ الدار فيك تطلبُ مهرًا","إنَّ مهرَ الحرائر الغِيد غال",82,"ل",1,0],["ثقلت عبارته، فأصبح صمتُه","نغمًا أرق من النسيم إذا سرى",83,"ر",2,0],["ثقيلة ما بين البرين إلى الحشا","وما الدّاءُ إلاّ غَيْرَ وَدُودِ",84,"د",1,0],["ثق أنَّ أبياتي لسانُ عواطفي","ثقْ أنَّ قلبي بينَهن مُذاب",85,"ب",1,0],["ثقافةُ الشعبِ قل لي أين تَنشُدها","أفي الصحافةِ مزجاةً أم الكُتُب",86,"ب",1,0],["ثقي \" دِمَشقُ \" فلا حدٌّ ولا سِمةٌ","ولا خطوطٌ – كلعبِ ا