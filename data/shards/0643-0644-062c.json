{"poems":[[55,"قد زيلت عظيمة فشمري","https://www.aldiwan.net/poem30450.html","الرجز"],[79,"كل جار لغاية مرجوه","https://www.aldiwan.net/poem35837.html","الخفيف"],[95,"أمر من يطلب الخلود عسير","https://www.aldiwan.net/poem9165.html","الخفيف"],[32,"ما هاج عينيك من الأطلال","https://www.aldiwan.net/poem29544.html","الرجز"],[53,"ما بحريث نال ابنه الكرما","https://www.aldiwan.net/poem66351.html","المنسرح"],[72,"لا أحس الآلام في القرب والبع","https://www.aldiwan.net/poem42954.html","الخفيف"],[45,"أوه بديل من قولتي واها","https://www.aldiwan.net/poem10603.html","المنسرح"],[47,"شط من ساكن الغوير مزاره","https://www.aldiwan.net/poem63580.html","الخفيف"],[51,"أرى المقادير تعمل العملا","https://www.aldiwan.net/poem63065.html","المنسرح"],[46,"لو تراه يا أبا الحسن","https://www.aldiwan.net/poem30098.html","المديد"],[107,"ها هنا الأعلام كانت تنصب","https://www.aldiwan.net/poem42062.html","الرمل"],[104,"هو ذا البحر مزبدا يتعالى","https://www.aldiwan.net/poem33132.html","الخفيف"],[50,"غرد الديك الصدوح","https://www.aldiwan.net/poem62532.html","مجزوء الرمل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85330","الخفيف"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125573","الرمل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39567","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55176","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54826","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54201","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54204","الخفيف"],[98,"عَدْلِي يَكَنْ","https://www.poetsgate.com/ViewPoem.aspx?id=13198",""],[119,"لي قلب قد قلبته على الجم","https://www.aldiwan.net/poem40867.html","عموديه"],[124,"خده أحسن أم ثغره","https://www.aldiwan.net/poem49374.html","المديد"],[193,"لست أنسى زمنا قد سلفا","https://www.aldiwan.net/poem35098.html","الرمل"],[228,"إيه برناس هيكل الشعراء","https://www.aldiwan.net/poem41899.html","الخفيف"],[354,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[398,"قل لأبي القاسم ان جيته","https://www.aldiwan.net/poem53605.html","السريع"],[412,"حازك البين حين أصبحت بدرا","https://www.aldiwan.net/poem50175.html","الخفيف"],[435,"صاح وافى داعي الهناء يشير","https://www.aldiwan.net/poem40995.html","الخفيف"],[443,"لك في المجد أول وأخير","https://www.aldiwan.net/poem2590.html","الخفيف"],[463,"مل معي لا عليك ضري ونفعي","https://www.aldiwan.net/poem56120.html","الخفيف"],[463,"من بسلع مطلع لي","https://www.aldiwan.net/poem56295.html","مجزوء الرمل"],[534,"يا إمام الأنام قد ضجر الناس","https://www.aldiwan.net/poem37530.html","الخفيف"],[556,"ليس دار الزوراء دار مقام","https://www.aldiwan.net/poem47209.html","الخفيف"],[556,"شد غروض المطي مغتربا","https://www.aldiwan.net/poem48085.html","المنسرح"],[563,"إن روحي بجسمها مصبوغه","https://www.aldiwan.net/poem34362.html","الخفيف"],[778,"","https://poetry.dctabudhabi.ae/diwan/poem/44566","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48816","الخفيف"],[880,"","https://poetry.dctabudhabi.ae/diwan/poem/34800","الخفيف"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119887","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59413","الخفيف"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109271","الرجز"],[1378,"","https://poetry.dctabudhabi.ae/diwan/poem/216847",""],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113953","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125357","الخفيف"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69339","المنسرح"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53177","الرمل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53128","البسيط"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67946","المديد"],[2238,"","https://poetry.dctabudhabi.ae/diwan/poem/67927","المديد"],[2358,"","https://poetry.dctabudhabi.ae/diwan/poem/123474","الرجز"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106893","الخفيف"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60927","الخفيف"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93631","الخفيف"],[2536,"","https://poetry.dctabudhabi.ae/diwan/poem/131719",""],[2560,"","https://poetry.dctabudhabi.ae/diwan/poem/132384","الخفيف"],[2714,"","https://poetry.dctabudhabi.ae/diwan/poem/199895",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204463","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199907","الخفيف"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74323","الخفيف"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89161","الخفيف"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74065","المتدارك"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92030","الخفيف"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91198","الخفيف"],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85072","الخفيف"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32761","الخفيف"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102981","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86351","الرمل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123526","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81248","السريع"],[4280,"","https://poetry.dctabudhabi.ae/diwan/poem/130536","البسيط"],[4455,"","https://poetry.dctabudhabi.ae/diwan/poem/35028","المديد"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33683","الخفيف"],[4622,"","https://poetry.dctabudhabi.ae/diwan/poem/139491",""],[4739,"إعتذار من نوع خاص","https://www.poetsgate.com/ViewPoem.aspx?id=28123",""],[4797,"سوار المقبرة","https://www.poetsgate.com/ViewPoem.aspx?id=50260",""],[463,"منْ بسلعٍ مطلعٌ لي","https://www.poetsgate.com/ViewPoem.aspx?id=14622",""],[4988,"إسكني في قلب مآا يعرف يخون","https://www.poetsgate.com/ViewPoem.aspx?id=145813",""],[5064,"أحزَان الشّارع اللّيلي","https://www.poetsgate.com/ViewPoem.aspx?id=199144",""],[5121,"مارد الحب","https://www.poetsgate.com/ViewPoem.aspx?id=33705",""],[5136,"أيامنا بين أعراس وأفراج","https://www.poetsgate.com/ViewPoem.aspx?id=121540",""],[5186,"قلب الدهر اختيارا","https://www.poetsgate.com/ViewPoem.aspx?id=156521",""],[5431,"سطوة المال ...(شجرُ الحب مورقٌ لا انتهاءُ )","https://www.poetsgate.com/ViewPoem.aspx?id=198472",""],[5431,"طاغوت....","https://www.poetsgate.com/ViewPoem.aspx?id=202911",""],[5444,"غَزَّةٌ ... وَصَمْتُ المنَارة","https://www.poetsgate.com/ViewPoem.aspx?id=205078",""],[5525,"ليل التجافي","https://www.poetsgate.com/ViewPoem.aspx?id=7193",""],[5525,"ما بقى لي قلب","https://www.poetsgate.com/ViewPoem.aspx?id=7297",""],[5587,"قَلْبِي عَلِيلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=190229",""],[5701,"لاحت على الشاطئ بستانا","https://www.poetsgate.com/ViewPoem.aspx?id=164672",""],[5716,"وي ........","https://www.poetsgate.com/ViewPoem.aspx?id=24333",""],[5756,"السفينة","https://www.poetsgate.com/ViewPoem.aspx?id=5180",""],[5848,"أنا اقصد حبيبي","https://www.poetsgate.com/ViewPoem.aspx?id=52026",""],[5956,"أقصوصة أنثى سُحاقية","https://www.poetsgate.com/ViewPoem.aspx?id=182690",""],[5956,"ازحفْ أيا أرتينُ ازحف للعُلا","https://www.poetsgate.com/ViewPoem.aspx?id=205127",""],[5977,"جروح تبرأ","https://www.poetsgate.com/ViewPoem.aspx?id=213270",""],[6023,"يا إماماً له الفضائل تُعزى","https://www.poetsgate.com/ViewPoem.aspx?id=123885",""],[6102,"فواتير","https://www.poetsgate.com/ViewPoem.aspx?id=184556",""]],"verses":[["كُلُّ جَرِيِّ القَلبِ في مُقتَحَمٍ","لِلرَوعِ مَغرورٍ بِهِ مُغَرِّرِ",0,"ر",1,0],["كُلُّ جارٍ لِغايَةٍ مرْجُوّهْ","فهْوَ عِندي لمْ يعُدْ حدَّ الفُتوّهْ",1,"و",2,1],["كل جرمٍ يعلو ويصبح نجماً","فله حيزٌ وفيه يدور",2,"ر",1,0],["كُلَّ جَهيضٍ لَثِقِ السِربالِ","حَيِّ الشَهيقِ مَيِّتِ الأَوصالِ",3,"ل",1,0],["كلُّ جوادٍ في ملْكه حَرَمٌ","وليس شيءٌ في مِلكهِ حَرُما",4,"م",2,0],["كُلُّ جِسمٍ لاقَيتُهُ يَستَثيرُ النا","رَ مِنّي كَذا عَهِدتُ الجَمادا",5,"د",2,0],["كُلُّ جَريحٍ تُرجى سَلامَتُهُ","إِلّا فُؤاداً دَهَتهُ عَيناها",6,"ا",3,0],["كُلُّ جَونٍ إِذا اِرتَقى البَرقُ فيهِ","أوقِدَت لِلعُيونِ بِالماءِ نارُه",7,"ر",2,0],["كُلُّ جَديدٍ فَالدَهرُ يُخلِقُهُ","وَكُلُّ حَيٍّ فَمَيِّتٌ عَجَلا",8,"ل",2,0],["كُلُّ جُزءٍ مِن مَحاسِنِهِ","فيهِ أَجزاءٌ مِنَ الفِتَنِ",9,"ن",1,0],["كُلُّ جاهٍ ليس مِنهُ يَنْقَضِي","كُلُّ سُلطانٍ سِواهُ يذهبُ",10,"ب",1,0],["كُل جُرح أَصابَكُم حلَ مِنا","في صَميم يأبى اِندمالا",11,"ل",2,0],["كُلُّ جودٍ يا أَميري","ما خَلا جودَكَ ريحُ",12,"ح",1,0],["كل جرح له التئام مع الده","ر وجرحى باق بغير التئام",13,"م",1,0],["كل جِدٍّ عَبَثٌ والدهرُ ساخر","وخبيء السرِّ للعينين ظاهر",14,"ر",1,0],["كلَّ جرح أسالَ جرحُك حتى","رَسَفَتْ مصرُ في الجراح الثخينه",15,"ن",2,0],["كُل جَمْعٍ مِنْهُمُ فِدى وَاحِدٍ","يَنْفَعُ وَالفَضْلُ أَيْنَ مِنْهُ الفُضُولُ",16,"ل",1,0],["كُلُّ جَيْشٍ إِنْ قَامَ فِيهَا بِدَعْوَى","رَدِّ عَادٍ أَقَامَ عُذْراً لِعَادِي",17,"د",2,0],["كُلُّ جُرمٍ يَعْلُو وَيُصْبحُ نَجْماً","فَلْكُهُ صَغيرٌ وَفيهِ يَدُورُ",18,"ر",1,0],["كلُّ جُحْرٍ بالبُؤْسِ والفَقْرِ مملو","ءٌ ولكنّه من الزَّادِ خالي",19,"ل",2,0],["كلُّ جُزْءٍ في جِسْمِهِنَّ له عَيْنٌ","على الشرِّ أو له أُذُنانِ",20,"ن",1,0],["كلَّ جرحٍ أسالَ رُزْؤُكَ حتَّى","رَسَفَتْ مصرُ في الجراح الثخينَةْ",21,"ن",2,0],["كل جزء مني وعينيك عين","شفها الشوق فهي طورا تراكا",22,"ك",2,0],["كل جزء من بدائعه","لفنون الحسن بستان",23,"ن",1,0],["كلُّ جاهٍ في البَرايا ذي نفاذ","فَعليهِ جاهكَ الضافي يطول",24,"ل",1,0],["كلّ جيلٍ يَجثو أَمامك بِالمَج","دِ وَيَرمي عَلَيكِ زهرَ البقاءِ",25,"ا",2,0],["كُلُّ جِهاتِ قَصدِها واحِدَةٌ","لِخاطِرٍ فيها بِسُلطانٍ خَطَر",26,"ر",1,0],["كُلُّ جمالٍ فائِقٍ رائِقٍ","أَنتَ بِرغم البَدرِ اوتيتَهُ",27,"ه",1,0],["كل جفن يَرى أَخاهُ وَلا يَسطي","عُ خَوضاً وَلا يُصادِف عبرا",28,"ر",2,0],["كل جود طليق كفيه لكن","كل حمد لراحتيه أسيرُ",29,"ر",1,0],["كل جودٍ ما لم تفده هباء","كل مدح ما لم يكن فيك زور",30,"ر",1,0],["كلّ جرداءَ لفّها السيرُ بالسي","ر فعادت في النِّسع مثلَ النسعِ",31,"ع",1,0],["كلُّ جُرْمٍ لك إلا ال","غَدْرَ فالقلب وَهُو وَهُوبُهْ",32,"ب",2,0],["كُلَّ جِدِّي وقَلَّ جَهْدِي عَنِ الإنْ","كارِ يا سَيِّدي وجَلَّ الخَطْبُ",33,"ب",1,0],["كلُّ جارٍ لهمْ بغير وفاءٍ","وصديقٍ لَهُمْ بغيرِ ذِمامِ",34,"م",1,0],["كُلّ جَريءِ الجَنان إنْ هتفتْ","يَوماً بهِ حَومةُ الوغى وثبا",35,"ب",2,0],["كل جسم كذاك صبغة روح","عند تحقيق ذي الكمال بلوغَهْ",36,"غ",2,0],["كلُّ جمالٍ ترى فمنهُ","إِذا تأَمَّلتَ مستعارُ",37,"ر",1,0],["كل جزء من البناء إذا صح","حَ متمٌّ لسائر الأجزاء",38,"ا",2,0],["كلّ جرداءَ قد تحيَّفَها الخَص","فُ بأقطارها بسرد النِّقال",39,"ل",1,0],["كل جود تخال كف علاء الد","ين فيه بالمكرما تجود",40,"د",1,0],["كل جود فمن علاه تجلّى","كل حسن فمن حلاه استعارا",41,"ر",2,0],["كل جبال الأرض مهما تعلو","فإنها لاخمصيك نعلُ",42,"ل",1,0],["كِلْ جِنس جِنْسَه يَنسِبَه","بِمخالِطَه ومزاوِرَه",43,"ر",2,0],["كُلُّ جارٍ منَ الدموعِ مُضاعٌ","غيرَ دمعٍ غدا علَيهنَّ جارِ",44,"ر",1,0],["كلُّ جسمٍ مَشَى على الأرض فيها","هي ترب وهو الوليدُ الفاني",45,"ن",2,0],["كلُّ جسمٍ يَدُ البِلَى حَوَّلَتهُ","من رُفاتٍ تُرباً كذرِّ الدُّخانِ",45,"ن",1,0],["كلُّ جسمٍ ينامُ إلا شهيداً","يذكرُ اللَه خافقاً بلسانِ",45,"ن",1,0],["كلُّ جسمٍ نما على الأرض بحيا","لو تولته نضرةُ الريعانِ",45,"ن",1,0],["كلُّ جسمٍ بعدَ البلى سوفَ يحيا","يومَ عرضِ الصراطِ والميزانِ",45,"ن",1,0],["كُلُّ جَوادٍ تَجُودُ راحَتُهُ","يَجودُ مِن جُودِهِ وَمِن كَرَمِه",46,"م",2,0],["كل جمع لشتات مؤذن","إنه لا شيء إلا لزوال",47,"ل",1,0],["كلّ جواد لو أن ريحاً","ظلت تجاريه كان أجرى",48,"ر",2,0],["كلُّ جزءٍ من محاسنها","فيه أجزاءٌ من الفِتَنِ",49,"ن",1,1],["كلُّ جزءٍ عن محاسِنها","كائنٌ في حُسنِهِ مَثلا",50,"ل",2,0],["كلُّ جفاءٍ أصلُه سوءُ التّفا","هُمِ فحاذر أن تُحاكي مَن طغى",51,"ا",1,0],["كل جزءٍ بشكله صار كلّاً","كاملاً في المحاسن الكاملات",52,"ت",1,0],["كل جسم أرق من سلسل الماء","وقلب أرق منه الحديد",53,"د",1,0],["كُل جَرح لَهُ أَساة وَلَكن","ما لجرح الهَوى بِقَلبي آسي",54,"س",2,0],["كل جهدي وحيلتي واصطباري","وحياتي كرهتها والمقام",55,"م",1,0],["كلُّ جُودٍ من جُودِهِ مُستَمَدٌّ","وسناءٍ من نُورِهِ الرَّباني",56,"ن",2,0],["كل جزء من محاسنها","كائنٌ في فضله مثلا",57,"ل",2,0],["كل جزء سائر في عالم","ناسياً أجزاءه المنفصلات",58,"ت",1,0],["كل جسمي زوائد وفضول","أبعدتني عن مبدع سوّاني",59,"ن",2,0],["كُل جود فَمن نَوال نداكا","نور اللَه بِالجَمال حماكا",60,"ك",2,1],["كل جل