{"poems":[[53,"قد زيلت عظيمة فشمري","https://www.aldiwan.net/poem30450.html","الرجز"],[77,"كل جار لغاية مرجوه","https://www.aldiwan.net/poem35837.html","الخفيف"],[93,"أمر من يطلب الخلود عسير","https://www.aldiwan.net/poem9165.html","الخفيف"],[30,"ما هاج عينيك من الأطلال","https://www.aldiwan.net/poem29544.html","الرجز"],[51,"ما بحريث نال ابنه الكرما","https://www.aldiwan.net/poem66351.html","المنسرح"],[70,"لا أحس الآلام في القرب والبع","https://www.aldiwan.net/poem42954.html","الخفيف"],[43,"أوه بديل من قولتي واها","https://www.aldiwan.net/poem10603.html","المنسرح"],[45,"شط من ساكن الغوير مزاره","https://www.aldiwan.net/poem63580.html","الخفيف"],[49,"أرى المقادير تعمل العملا","https://www.aldiwan.net/poem63065.html","المنسرح"],[44,"لو تراه يا أبا الحسن","https://www.aldiwan.net/poem30098.html","المديد"],[105,"ها هنا الأعلام كانت تنصب","https://www.aldiwan.net/poem42062.html","الرمل"],[102,"هو ذا البحر مزبدا يتعالى","https://www.aldiwan.net/poem33132.html","الخفيف"],[48,"غرد الديك الصدوح","https://www.aldiwan.net/poem62532.html","مجزوء الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85330","الخفيف"],[97,"","https://poetry.dctabudhabi.ae/diwan/poem/125573","الرمل"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39567","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55176","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54701","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54826","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54201","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54204","الخفيف"],[96,"عَدْلِي يَكَنْ","https://www.poetsgate.com/ViewPoem.aspx?id=13198",""],[116,"لي قلب قد قلبته على الجم","https://www.aldiwan.net/poem40867.html","عموديه"],[121,"خده أحسن أم ثغره","https://www.aldiwan.net/poem49374.html","المديد"],[190,"لست أنسى زمنا قد سلفا","https://www.aldiwan.net/poem35098.html","الرمل"],[224,"إيه برناس هيكل الشعراء","https://www.aldiwan.net/poem41899.html","الخفيف"],[350,"ومغرب الشمس ومشرق القمر","https://www.aldiwan.net/poem15722.html","الرجز"],[394,"قل لأبي القاسم ان جيته","https://www.aldiwan.net/poem53605.html","السريع"],[407,"حازك البين حين أصبحت بدرا","https://www.aldiwan.net/poem50175.html","الخفيف"],[430,"صاح وافى داعي الهناء يشير","https://www.aldiwan.net/poem40995.html","الخفيف"],[438,"لك في المجد أول وأخير","https://www.aldiwan.net/poem2590.html","الخفيف"],[459,"مل معي لا عليك ضري ونفعي","https://www.aldiwan.net/poem56120.html","الخفيف"],[459,"من بسلع مطلع لي","https://www.aldiwan.net/poem56295.html","مجزوء الرمل"],[530,"يا إمام الأنام قد ضجر الناس","https://www.aldiwan.net/poem37530.html","الخفيف"],[552,"ليس دار الزوراء دار مقام","https://www.aldiwan.net/poem47209.html","الخفيف"],[552,"شد غروض المطي مغتربا","https://www.aldiwan.net/poem48085.html","المنسرح"],[559,"إن روحي بجسمها مصبوغه","https://www.aldiwan.net/poem34362.html","الخفيف"]],"verses":[["كُلُّ جَرِيِّ القَلبِ في مُقتَحَمٍ","لِلرَوعِ مَغرورٍ بِهِ مُغَرِّرِ",0,"ر",1,0],["كُلُّ جارٍ لِغايَةٍ مرْجُوّهْ","فهْوَ عِندي لمْ يعُدْ حدَّ الفُتوّهْ",1,"و",2,1],["كل جرمٍ يعلو ويصبح نجماً","فله حيزٌ وفيه يدور",2,"ر",1,0],["كُلَّ جَهيضٍ لَثِقِ السِربالِ","حَيِّ الشَهيقِ مَيِّتِ الأَوصالِ",3,"ل",1,0],["كلُّ جوادٍ في ملْكه حَرَمٌ","وليس شيءٌ في مِلكهِ حَرُما",4,"م",2,0],["كُلُّ جِسمٍ لاقَيتُهُ يَستَثيرُ النا","رَ مِنّي كَذا عَهِدتُ الجَمادا",5,"د",2,0],["كُلُّ جَريحٍ تُرجى سَلامَتُهُ","إِلّا فُؤاداً دَهَتهُ عَيناها",6,"ا",3,0],["كُلُّ جَونٍ إِذا اِرتَقى البَرقُ فيهِ","أوقِدَت لِلعُيونِ بِالماءِ نارُه",7,"ر",2,0],["كُلُّ جَديدٍ فَالدَهرُ يُخلِقُهُ","وَكُلُّ حَيٍّ فَمَيِّتٌ عَجَلا",8,"ل",2,0],["كُلُّ جُزءٍ مِن مَحاسِنِهِ","فيهِ أَجزاءٌ مِنَ الفِتَنِ",9,"ن",1,0],["كُلُّ جاهٍ ليس مِنهُ يَنْقَضِي","كُلُّ سُلطانٍ سِواهُ يذهبُ",10,"ب",1,0],["كُل جُرح أَصابَكُم حلَ مِنا","في صَميم يأبى اِندمالا",11,"ل",2,0],["كُلُّ جودٍ يا أَميري","ما خَلا جودَكَ ريحُ",12,"ح",1,0],["كل جرح له التئام مع الده","ر وجرحى باق بغير التئام",13,"م",1,0],["كل جِدٍّ عَبَثٌ والدهرُ ساخر","وخبيء السرِّ للعينين ظاهر",14,"ر",1,0],["كلَّ جرح أسالَ جرحُك حتى","رَسَفَتْ مصرُ في الجراح الثخينه",15,"ن",2,0],["كُل جَمْعٍ مِنْهُمُ فِدى وَاحِدٍ","يَنْفَعُ وَالفَضْلُ أَيْنَ مِنْهُ الفُضُولُ",16,"ل",1,0],["كُلُّ جَيْشٍ إِنْ قَامَ فِيهَا بِدَعْوَى","رَدِّ عَادٍ أَقَامَ عُذْراً لِعَادِي",17,"د",2,0],["كُلُّ جُرمٍ يَعْلُو وَيُصْبحُ نَجْماً","فَلْكُهُ صَغيرٌ وَفيهِ يَدُورُ",18,"ر",1,0],["كلُّ جُحْرٍ بالبُؤْسِ والفَقْرِ مملو","ءٌ ولكنّه من الزَّادِ خالي",19,"ل",2,0],["كلُّ جُزْءٍ في جِسْمِهِنَّ له عَيْنٌ","على الشرِّ أو له أُذُنانِ",20,"ن",1,0],["كلَّ جرحٍ أسالَ رُزْؤُكَ حتَّى","رَسَفَتْ مصرُ في الجراح الثخينَةْ",21,"ن",2,0],["كل جزء مني وعينيك عين","شفها الشوق فهي طورا تراكا",22,"ك",2,0],["كل جزء من بدائعه","لفنون الحسن بستان",23,"ن",1,0],["كلُّ جاهٍ في البَرايا ذي نفاذ","فَعليهِ جاهكَ الضافي يطول",24,"ل",1,0],["كلّ جيلٍ يَجثو أَمامك بِالمَج","دِ وَيَرمي عَلَيكِ زهرَ البقاءِ",25,"ا",2,0],["كُلُّ جِهاتِ قَصدِها واحِدَةٌ","لِخاطِرٍ فيها بِسُلطانٍ خَطَر",26,"ر",1,0],["كُلُّ جمالٍ فائِقٍ رائِقٍ","أَنتَ بِرغم البَدرِ اوتيتَهُ",27,"ه",1,0],["كل جفن يَرى أَخاهُ وَلا يَسطي","عُ خَوضاً وَلا يُصادِف عبرا",28,"ر",2,0],["كل جود طليق كفيه لكن","كل حمد لراحتيه أسيرُ",29,"ر",1,0],["كل جودٍ ما لم تفده هباء","كل مدح ما لم يكن فيك زور",30,"ر",1,0],["كلّ جرداءَ لفّها السيرُ بالسي","ر فعادت في النِّسع مثلَ النسعِ",31,"ع",1,0],["كلُّ جُرْمٍ لك إلا ال","غَدْرَ فالقلب وَهُو وَهُوبُهْ",32,"ب",2,0],["كُلَّ جِدِّي وقَلَّ جَهْدِي عَنِ الإنْ","كارِ يا سَيِّدي وجَلَّ الخَطْبُ",33,"ب",1,0],["كلُّ جارٍ لهمْ بغير وفاءٍ","وصديقٍ لَهُمْ بغيرِ ذِمامِ",34,"م",1,0],["كُلّ جَريءِ الجَنان إنْ هتفتْ","يَوماً بهِ حَومةُ الوغى وثبا",35,"ب",2,0],["كل جسم كذاك صبغة روح","عند تحقيق ذي الكمال بلوغَهْ",36,"غ",2,0]]}