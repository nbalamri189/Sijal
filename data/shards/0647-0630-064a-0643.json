{"poems":[[90,"أنا بالحكومة والسياسة أعرف","https://www.aldiwan.net/poem44808.html","الكامل"],[74,"سقى حماك من الوسمي باكره","https://www.aldiwan.net/poem18704.html","البسيط"],[94,"يا قلبي الدامي إلام الوجوم","https://www.aldiwan.net/poem38920.html","البسيط"],[87,"يا راكب الريح حي النيل والهرما","https://www.aldiwan.net/poem63746.html","البسيط"],[68,"خذ فرصة اللذات قبل فواتها","https://www.aldiwan.net/poem41354.html","الكامل"],[107,"لمن الجموع كثيرة تتألب","https://www.aldiwan.net/poem44040.html","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19772","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54563","الكامل"],[102,"إلا أنا وبلادي","https://www.poetsgate.com/ViewPoem.aspx?id=50339",""],[92,"أنغام الخطوب","https://www.poetsgate.com/ViewPoem.aspx?id=179139",""],[147,"بالحول نلت ونال الناس بالحيل","https://www.aldiwan.net/poem11794.html","البسيط"],[382,"قد ضل من قد حاد عن كشف الزلل","https://www.aldiwan.net/poem59290.html","الكامل"],[409,"وافى إلى سوح الأمير","https://www.aldiwan.net/poem33909.html","مجزوء الكامل"],[1689,"","https://poetry.dctabudhabi.ae/diwan/poem/36194","الدوبيت"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100982","الكامل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123279","المواليا"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110345","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93843","البسيط"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36458","الدوبيت"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66163","المتدارك"],[4728,"الجد والغي","https://www.poetsgate.com/ViewPoem.aspx?id=176883",""],[4987,"دليل المحبه","https://www.poetsgate.com/ViewPoem.aspx?id=49562",""],[4987,"مداعبةنسيم الليل","https://www.poetsgate.com/ViewPoem.aspx?id=49588",""],[5092,"حبٌ يورقُ في الفراغ","https://www.poetsgate.com/ViewPoem.aspx?id=175329",""],[5118,"فيّة الليمون","https://www.poetsgate.com/ViewPoem.aspx?id=129792",""],[5526,"زهور العشب","https://www.poetsgate.com/ViewPoem.aspx?id=192803",""],[5582,"أَبُدُورُ تَمٍّ كالبُدُورِ طَوالِعُ","https://www.poetsgate.com/ViewPoem.aspx?id=63530",""],[5626,"أنا وأنتِ","https://www.poetsgate.com/ViewPoem.aspx?id=189593",""],[5720,"كياد *","https://www.poetsgate.com/ViewPoem.aspx?id=199081",""],[5756,"الاسرى","https://www.poetsgate.com/ViewPoem.aspx?id=5366",""],[6052,"كواكب أمتي","https://www.poetsgate.com/ViewPoem.aspx?id=34627",""],[6113,"ايمان","https://www.poetsgate.com/ViewPoem.aspx?id=26379",""],[6113,"الا يالله تسعدها...","https://www.poetsgate.com/ViewPoem.aspx?id=139109",""]],"verses":[["هذي كراسيّ الوزارة تحتكم","كادت لفرط حيائها تتقصَّف",0,"ف",1,0],["هذي كؤوس الثنا والحمد مترعةٌ","باكر صبوحك أهنى العيش باكره",1,"ر",2,0],["هذي كؤوسي مُرَّةً كالرَّدى","مَا مِلْؤُها إلاَّ عصيرُ الهُمومْ",2,"م",1,0],["هَذي كَرائِمُ أَشياءِ الشُعوبِ فَإِن","ماتَت فَكُلُّ وُجودٍ يُشبِهُ العَدَما",3,"م",2,0],["هَذي كُنوزُ الشُكرِ وافِرَةٌ لَكُم","فَاِجعَل نَجازَ الوَعدِ بَعضَ زَكاتِها",4,"ت",3,0],["هَذِي كَتائِبُهُ عَلَيكَ تَنَزَّلَتْ","وَمَضتْ إلى أعدائِهِ تتوثَّبُ",5,"ب",1,0],["هذى كما الملكَ الكري","م وتلك كالفَلَك المنير",6,"ر",1,0],["هَذِي كَوَافِلُ حُسْنِ ذِكْرِكَ في الْوَرَى","وَأَبَرُّ مَا يَبْقَى الْفَعَالُ الطَّيِّبُ",7,"ب",1,0],["هذي كلها بلادي ... وفيها","كل شيء ... إلا أنا وبلادي",8,"د",2,0],["هذي كما اندفعتْ عشواءُ خابطةٌ","وتلك فيما حوت \" حمالةُ الحطب \"",9,"ب",1,0],["هَذي كَواعِبُ قَد وافَتكَ مُقسِمَةً","أَن لَم تُزَفَّ إِلى بَعلٍ وَلَم تُنَلِ",10,"ل",1,0],["هذي كواكبها تزانُ بسَيرها","هذي ثوابتُها كطلٍّ في طَلَل",11,"ل",1,0],["هذي كؤوس ذوي التقى","أنقيس كاسات الفجور",12,"ر",1,0],["هَذي كَبدي إِذا السَماء اِنفَطَرَت","شَوقاً وَكَواكِب الدُموع اِنتَثَرَت",13,"ت",1,0],["هذي كتائبها تجول به","غضبى لدين اللَه تحتد",14,"د",1,0],["هذيك تحبل وتولد","عجل أو عجله",15,"ل",2,0],["هذي كتلك معاقلٌ بقبابها","وشخوصها ونقوشها تتحاكى",16,"ك",2,0],["هذي كنانة مصر بعد أن تثلث","سهامها بك قد عادت عن العدم",17,"م",1,0],["هَذي كَلمي نَفائسُ الأَنفاسِ","تُلهيك عَن اِرتِشاف ثَغر الكاسِ",18,"س",1,1],["هذي كَبِدي قَدْ قَرَّحَها","شَوْقٌ يَزْدادُ تَوَقُّدُهُ",19,"د",2,0],["هذيك هي عطر القصيد وعبيره","في غيرها لا يا قصيد الهوى عيّ",20,"ي",1,0],["هذيك الليالي وين أثرالزمن دوار","خذاها ولاظني زماني يرجّعها",21,"ع",3,0],["هذيك اليالي وين اثر الزمان يدور","رجح في عيونك ذيك الايام ميزاني",22,"ن",2,0],["هذي كفوفُ العاشقين تحسُّرٌ","نبضاتُ قلبي للغرام تصفّقُ",23,"ق",1,0],["هذيك .. أدروب .. قلب .. ومحتري ينثر لك المكنون","__________ زرع رمضا .. كراريس المكان اسمك رمق نوره",24,"ر",2,0],["هذيك اللي احبّه كنت يمكن من عصر هامان","إلى هالحين مع بكره احب اخطاءه وعيوبه",25,"ب",2,0],["هَذِيكَ تُبْلِيها الدُّهُورُ وَهذِهِ","لَمْ تُبْلِها لِلْحادِثاتِ قَوارِعُ",26,"ع",1,0],["هذي كؤوسُ الهوى جاءتكَ مُترَعَةً","فاشْربْ على طللِ الأيامِ نشوانا",27,"ن",2,0],["هذي ( كيادُ ) وفي ثنايا ذِكرِها","يتعمَّقُ التاريخُ في الإغراقِ",28,"ق",1,0],["هذي (كيادُ) .. وهؤلاءِ شبابُها","ساروا بها للمجدِ .. في الآفاقِ",28,"ق",1,0],["هذيك والله فرحة انسان بنسان","ماهي بفرحة قرن واحد وعشرين",29,"ن",1,0],["هذي كواكب أمتي سطعت هدىً","فلك النبوة في الصدور مدارها",30,"ر",3,0],["هذيك أصدق من الكلمه خذت قلبي مع الوجدان","هذيك اللي ملت عيني وكل الناس منخمه",31,"م",2,0],["هذيك اغلى من الالماس والياقوت والريناد","هذيك اللي عليها القلب ذاب ومات من قهره",32,"ر",2,0]]}