{"poems":[[55,"إلى كم الطرف بالبيداء معقود","https://www.aldiwan.net/poem30637.html","البسيط"],[59,"العلم مغرس كل فخر فافتخر","https://www.aldiwan.net/poem24679.html","الكامل"],[23,"أنظر خليلي ببطن جلق هل","https://www.aldiwan.net/poem21402.html","المنسرح"],[74,"يا قلب أنت ومقلتي","https://www.aldiwan.net/poem18742.html","مجزوء الكامل"],[74,"كفوا حديث العذل عن مسمعي","https://www.aldiwan.net/poem19170.html","السريع"],[74,"لا آخذ الله غزال النقا","https://www.aldiwan.net/poem19421.html","السريع"],[53,"عيد يطابق أول الأسبوع","https://www.aldiwan.net/poem65060.html","الكامل"],[91,"ذهبت ايام الشباب سراعا","https://www.aldiwan.net/poem44894.html","الخفيف"],[87,"إن الوشاة وإن لم أحصهم عددا","https://www.aldiwan.net/poem63674.html","البسيط"],[58,"كيف الدعاء على من جار أو ظلما","https://www.aldiwan.net/poem58512.html","الكامل"],[47,"أمخلفي يا فتح أنت وظاعن","https://www.aldiwan.net/poem10665.html","الكامل"],[68,"صبرا على وعد الزمان وإن لوى","https://www.aldiwan.net/poem41578.html","الكامل"],[33,"جن قلبي فقلت يا قلب مهلا","https://www.aldiwan.net/poem41849.html","الخفيف"],[107,"ناد القبور وبشر كل مقبور","https://www.aldiwan.net/poem43053.html","البسيط"],[107,"هدأ المخيم واطمأن المضجع","https://www.aldiwan.net/poem44071.html","الكامل"],[48,"لا أخطب الدنيا إلى مالك الدن","https://www.aldiwan.net/poem22180.html","السريع"],[8,"ما لي وما لإبنة المجنون تطرقني","https://www.aldiwan.net/poem21850.html","البسيط"],[96,"طمع الأقوياء","https://www.poetsgate.com/ViewPoem.aspx?id=15664",""],[113,"من مبلغ قصر الأمير بأنه","https://www.aldiwan.net/poem16370.html","الكامل"],[132,"ورمتني الأيام أو","https://www.aldiwan.net/poem50671.html","مجزوء الكامل"],[159,"دون المنى في الهوى يا نفس آفات","https://www.aldiwan.net/poem55749.html","البسيط"],[164,"يا من بنعماه لحمي نابت ودمي","https://www.aldiwan.net/poem58990.html","البسيط"],[173,"بع واسطاً بالنأي والهجر","https://www.aldiwan.net/poem1629.html",""],[201,"يا بني العرب إنما الضعف عار","https://www.aldiwan.net/poem39951.html","الخفيف"],[234,"في الطن معنى من التعنيق معترض","https://www.aldiwan.net/poem51213.html","البسيط"],[234,"أنا من رقة الهوى والهواء","https://www.aldiwan.net/poem51268.html","الخفيف"],[280,"رق مولانا لعبد زمن","https://www.aldiwan.net/poem25513.html","الرمل"],[302,"يا بريق الحيا ويا عذب البان","https://www.aldiwan.net/poem33004.html","الخفيف"],[366,"هل ذاك ثغر تبسم","https://www.aldiwan.net/poem68065.html","المجتث"],[409,"يا سعد خذ بأبي وأمي","https://www.aldiwan.net/poem33426.html","مجزوء الكامل"],[435,"أرج الصبابة من ثنائك عارف","https://www.aldiwan.net/poem40081.html","الكامل"],[435,"راو لمية بالقمراء دانية","https://www.aldiwan.net/poem40285.html","البسيط"],[435,"يا نائيا وفؤاد الصب مأواه","https://www.aldiwan.net/poem41023.html","البسيط"],[438,"ردوا لها أيامها الأوائلا","https://www.aldiwan.net/poem12388.html","الرجز"],[443,"هي بشرى الإسلام والأيام","https://www.aldiwan.net/poem2569.html","الخفيف"],[463,"أنت على حالتيك محمود","https://www.aldiwan.net/poem56242.html","المنسرح"],[487,"ظبي خزّ بلحاظه","https://www.aldiwan.net/poem24369.html","عموديه"],[545,"اربع علينا قليلا أيها الحادي","https://www.aldiwan.net/poem56848.html","البسيط"],[556,"أما ترى الرزء الذي أقبلا","https://www.aldiwan.net/poem47307.html","السريع"],[563,"قطع الجهول زمانه بتغزل","https://www.aldiwan.net/poem34311.html","الكامل"],[567,"ماذا جلبت لنا يا ليلة العيد","https://www.aldiwan.net/poem52846.html","البسيط"],[574,"إن أدع مسكينا فما قصرت","https://www.aldiwan.net/poem52007.html","أحذ الكامل"],[591,"أضحى له في اكتئابه سبب","https://www.aldiwan.net/poem17411.html","المنسرح"],[591,"أوحشتموا نظري فكم من عبرة","https://www.aldiwan.net/poem17613.html","الكامل"],[591,"أحلى الهوى أن يطول الوجد والسقم","https://www.aldiwan.net/poem17711.html","البسيط"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83324","البسيط"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122828","السريع"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122757","البسيط"],[675,"","https://poetry.dctabudhabi.ae/diwan/poem/110403","البسيط"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130169","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38277","البسيط"],[978,"","https://poetry.dctabudhabi.ae/diwan/poem/73897","الرمل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59302","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59411","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59113","البسيط"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111856","الكامل"],[1597,"","https://poetry.dctabudhabi.ae/diwan/poem/77776","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49586","البسيط"],[1777,"","https://poetry.dctabudhabi.ae/diwan/poem/105431","الرجز"],[1890,"","https://poetry.dctabudhabi.ae/diwan/poem/89682","الخفيف"],[2066,"","https://poetry.dctabudhabi.ae/diwan/poem/108458","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109577","البسيط"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77436","المديد"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67203","البسيط"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60846","البسيط"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93544","الكامل"],[2536,"","https://poetry.dctabudhabi.ae/diwan/poem/131691",""],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137372",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201917","المنسرح"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200756","البسيط"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103979","البسيط"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86338","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91459","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111498","الرمل"],[4048,"","https://poetry.dctabudhabi.ae/diwan/poem/110653","الكامل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36590","الدوبيت"],[4205,"","https://poetry.dctabudhabi.ae/diwan/poem/22082","الخفيف"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73125","الكامل"],[4966,"جفَّتْ بحورُالحب","https://www.poetsgate.com/ViewPoem.aspx?id=196864",""],[5049,"المسكنة الله","https://www.poetsgate.com/ViewPoem.aspx?id=186335",""],[5136,"يا راقد الليل لم تشعر لمن سهرا","https://www.poetsgate.com/ViewPoem.aspx?id=121584",""],[5362,"يا آخذ الروح مني والفؤاد معا","https://www.poetsgate.com/ViewPoem.aspx?id=170393",""],[5431,"لاأخاف العشق زدني","https://www.poetsgate.com/ViewPoem.aspx?id=185603",""],[5818,"مُت مثل مَن ماتوا","https://www.poetsgate.com/ViewPoem.aspx?id=180562",""],[5939,"هي كِبريائي عنكِ حالتْ","https://www.poetsgate.com/ViewPoem.aspx?id=178588",""],[5952,"شوقٌ لِ قُبَّتهِ","https://www.poetsgate.com/ViewPoem.aspx?id=212162",""],[5956,"واللهِ أنا صافي القلبِ","https://www.poetsgate.com/ViewPoem.aspx?id=184493",""],[5956,"يُخيل إليّ","https://www.poetsgate.com/ViewPoem.aspx?id=192657",""],[6177,"يُوجِع الموتُ...","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=79068&r=&rc=15",""],[6243,"سارق النّار الجديد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84438&r=&rc=12",""]],"verses":[["لا آخُذُ الطَعنَ إِلا عَن رِماحِهِمُ","إِذا تَطاعَنَتِ الشُمُّ المَناجيدُ",0,"د",1,0],["لا أَخو العِلمِ الَذي يُعنى بِهِ","في حالَتَيهِ عارِيا أَو مُكتَسي",1,"س",2,0],["لا أَخدِشُ الخَدشَ بِالنَديمِ وَلا","يَخشى جَليسي إِذا غَضِبتُ يَدي",2,"د",2,0],["لا آخذَ الرحمن من","ملك الحشا فتجبرا",3,"ر",2,0],["لا آخذ الله ليالي اللقا","فإنها أصل الأسى الموجع",4,"ع",1,0],["لا آخذَ الله غزال النقا","أيُّ عناً أبقى على العاشق",5,"ق",1,1],["لا أُخِّروا ليقدِّموك وقُدِّموا","برضى صبورٍ أو بسُخْط جزوع",6,"ع",1,0],["لا اخاف المنون فهو اذا ما","لاح لي القاه بوجهي شجاعا",7,"ع",2,0],["لا أَخلَفَ اللَهُ ظَنّي في نَواظِرِهِم","ماذا رَأَت بِيَ مِمّا يَبعَثُ الحَسَدا",8,"د",2,0],["لا آخذَ اللّهُ مَنْ أهوى بِجَفْوَتِهِ","عَنِّي ولا اقْتَصَّ لي منهُ ولا ظَلما",9,"م",2,0],["لا أَخلِطُ التَأميلَ مِنكَ بِغَيرِهِ","أَبَداً وَلا أَلقى دَنِيَّ المَكسَبِ",10,"ب",1,0],["لا أَختَشي مِن ذِلَّةٍ أَو قِلَّةٍ","عِزّي لِساني وَالقَناعَةُ لي غِنى",11,"ن",2,0],["لا أَخونُ الخَليلَ ما عُشتُ حَتّى","يُنقَلَ البَحرُ بِالغَرابيلِ نَقلا",12,"ل",2,0],["لا أَخلَفَتْكِ الأمانِي مِن مُوَلهّةٍ","يبكي لها النّاسُ من حُرٍّ ومقصورِ",13,"ر",1,0],["لا أخطأتكَ من الجحيمِ وَحرِّها","مشبوبةٌ فيها تُدَعُّ وتُدفَعُ",14,"ع",1,0],["لا أَخطُبُ الدُنيا إِلى مالِكِ الدُن","يا وَلَكِن خُطبَتي أُختَها",15,"ت",3,1],["لا أَخذَعُ البَوَّ بَوَّ الزَعمِ أَرأَمُهُ","وَلا أُقيمُ بِدارِ العَجزِ وَالهُونِ",16,"ن",1,0],["لا إخال الأرواح تكسر قيد الأسر","إن لم تعذّبوا الأجساما",17,"م",2,0],["لا أَخصَبت فيهِ الحَدائق بَعدَهُ","أَبَداً وَلا مادَت بِهنَّ غُصونُ",18,"ن",1,0],["لا أختشى إن كنت لي","من خافضِ أو ناصبِ",19,"ب",1,0],["لا آخَذَ اللَهُ مَنْ قَلْبي بِهِ كَلِفٌ","صَبٌّ قَدِ اسْتَحكَمَتْ فيهِ الصَّباباتُ",20,"ت",1,0],["لا أختشي سرفا في الهجر من ملك","أحكامه كلها تبنى على الحكم",21,"م",1,0],["لا أَخلَفَ الرَحمَنُ مالَ فَتىً","يَأتيكُمُ فَيَبيعُ أَو يَشري",22,"ر",2,0],["لا إخاءٌ كما ادّعوا لا حقوقٌ","لضَعيفٍ عانٍ ولا حُريّه",23,"ي",2,0],["لا أّخّر البُرءُ من لُقياك زَوْرتَه","فإنّ بُرْءَك برءُ المجد والأدب",24,"ب",1,0],["لا أخافُ الوُشاةَ إنْ رمَقُوني","لا ولا أتَّقى من الرُّقَباء",25,"ا",2,0],["لا أَخَافُ الهونَ في دَوْلَتِهِ","مَنْ يكُن عَبْداً لَهُ لا يَهُنِ",26,"ن",1,0],["لا أَخصُّ النَسيمَ والبرقَ والبا","نَ وإِن جدَّدَت لِشَوقيَ عَهدا",27,"د",2,0],["لا آخذ اللَه دَهرا","فيما مَضى كانَ أَجرَم",28,"م",1,0],["لا أختشي عند الشمو","س الزاهرات أفول نجم",29,"م",1,0],["لا اختشي عذر الزمان وناصري","ذو المجد والشرف الأمير العارفُ",30,"ف",1,0],["لا آخذ اللَه هاتيك العيون وإن","جارت على كبدٍ بالشوق تنقد",31,"د",1,0],["لا آخذ الله عينيه بما فعلت","فالصبر ولى وهذا القلب يفداه",32,"ا",2,0],["لا أَخْتَشِي صَدَّ حبيبٍ واصِلٍ","يومًا ولا أَبْكِي خليطاً راحلا",33,"ل",2,0],["لا أختراق ما بينكم في المعالي","وسواء فخراً بنو الأعمام",34,"م",1,0],["لا أَخلَفَ المالَ غيرُ متلفهِ","إن الغنيَّ البخيلَ مكدودُ",35,"د",1,0],["لا أختشي في حبكم","من أجلكم موتا وقاصر",36,"ر",1,0],["لا أَخذُلُ الجارَ بَل أَحمي مَباءَتَهُ","وَلَيسَ جاري كَعُشٍّ بَينَ أَعوادِ",37,"د",1,0],["لا أخطأتْ قبرَك هطّالةٌ","ولا عداك المُزْنُ إنْ أسبلا",38,"ل",2,0],["لا أختشي من جانب تفويتَه","يا قاصراً فينا يحاول صيته",39,"ه",1,0],["لا أخَذَ اللهُ قلباً لم يَطِرْ أسَفاً","مني لشَخصٍ عظيمِ الشأنِ مفقودِ",40,"د",1,0],["لا آخذ الصبيان أَلثمهم","وَالأَمر قد يغري به الأَمرُ",41,"ر",1,0],["لا أَخْتَشِي الحادِثاتِ وَالحَسَنُ ال","مُحْسِنُ لِي في جَنابِهِ أَرَبُ",42,"ب",1,0],["لا اِخْضَرَّ بَعدَكُمُ العَقيقُ ولا حَلَا","مِنْ مَائِهِ لِلْوارِدينَ مَذَاقُ",43,"ق",1,0],["لا آخذَ اللَّهُ جِيرانَ النَّقا بِدَمِي","هُمْ أَسْلَمُونِي لِوَجْدٍ مِنْهُ قَدْ سَلِمُوا",44,"م",3,0],["لا أَختَشي إِن أَقُل مَن ذا يُساجِلهُ","مَن ذا يُساوِرهُ مَن ذا يُساويهِ",45,"ي",2,0],["لا آخَذَ اللهُ غَريماً لَوَى","دَينِيَ فَأستَلوَيتُهُ ما لَوَى",46,"و",2,0],["لا آخَذَ اللهُ قَلبي في تَحَمُّلِهِ","ما لا يُطيقُ بَحَملٍ وَهُوَ عالِمُهُ",47,"م",2,0],["لا أَخمد الله ناراً في الحشا اشتعلت","مني ولا نشفت عيني من البَلَلِ",48,"ل",1,0],["لا اختشى الخطب اذ حفت حمايته","ولو دهتني أسود الغيل بالغيل",49,"ل",1,0],["لا أَختَشي القتلَ مِن بيضٍ وَمِن أسَلٍ","وَمِن سِهامِ رُماةٍ مِن بني ثُعَلِ",50,"ل",1,0],["لا أَخافُ الدَّهرَ إِلا حادِياً","ظَلتُ أَخشَاهُ وَأَخشَى الجَمَلا",51,"ل",2,0],["لاَ أخْتَشِي فِيهِ مِنْ عَذْلٍ يُفَنِّدُنِي","وَالشَّوْقُ يَقْتَادُ قَلْبِي فِي أزِقَّتِهِ",52,"ت",2,0],["لا أختشي فيه من عذل يفنذني","فلحشا بعليل الشوق تعليل",53,"ل",1,0],["لاَ أختشِي فِيهِ مِنْ منعِ المَلاَمِ ولي","فِي حُبِّهِ أي إخلاَص وَتمكينِ",54,"ن",1,0],["لا اختشيك وان تكن ذا صولة","فتصبري ابداً ازاءك يرسخُ",55,"خ",1,0],["لا أَخصب اللَه أَرضاً عنك ما خصبت","وَلا أَسر عيوناً لَم تسريها",56,"ي",3,0],["لا أخْدَعُ النَّاسَ عنّي قد بَلَوْتُهمُ","يا دهرُ أُنْجُ ويا وشكَ الحمامِ غُلِ",57,"ل",1,0],["لا أختشي ذنباً ولي فيكم رجاً","أعظم ذنب معه لا يختشي",58,"ش",2,0],["لا أَخونُ الخَليلَ في السِرِّ حَتّى","يَنقُل البَحر في الغَرابيل نَقلا",59,"ل",2,1],["لا آخذ اللَه الممات فانه","قصد الطرادي الجسور لينصرا",60,"ر",2,0],["لا أختشي من كريم الأصل فاتكةً","تؤذي وان هاج منه لاعجُ الغضبِ",61,"ب",1,1],["لا أَخُصُّ الَغيدَ بِالعِشقِ","كُلُّ شَيءٍ مُبدَعُ الخَلقِ",62,"ق",1,1],["لا أختشي الدهرَ إمّا خانَ 