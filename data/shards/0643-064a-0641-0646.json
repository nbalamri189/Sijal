252","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202408","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202992","الخفيف"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74323","الخفيف"],[3368,"","https://poetry.dctabudhabi.ae/diwan/poem/104235","الخفيف"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131952","الرمل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91068","الخفيف"],[3837,"","https://poetry.dctabudhabi.ae/diwan/poem/114688","الرمل"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33188","الخفيف"],[4581,"","https://poetry.dctabudhabi.ae/diwan/poem/123854","الخفيف"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67486","الرمل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204207","الخفيف"],[4680,"الوطن الجريح","https://www.poetsgate.com/ViewPoem.aspx?id=185017",""],[4702,"الذل محموس","https://www.poetsgate.com/ViewPoem.aspx?id=155202",""],[4747,"رسالة إلى صدام","https://www.poetsgate.com/ViewPoem.aspx?id=17213",""],[4755,"عُد قَلِيلًا إِلَيكَ","https://www.poetsgate.com/ViewPoem.aspx?id=183651",""],[4791,"اجمع الغره","https://www.poetsgate.com/ViewPoem.aspx?id=36961",""],[5009,"جيل الصحوة","https://www.poetsgate.com/ViewPoem.aspx?id=68820",""],[5102,"بنت السجان","https://www.poetsgate.com/ViewPoem.aspx?id=12893",""],[5121,"دولة الأيام","https://www.poetsgate.com/ViewPoem.aspx?id=33514",""],[5121,"نَوْمَةُ مَلاَك","https://www.poetsgate.com/ViewPoem.aspx?id=174100",""],[5190,"رائيل","https://www.poetsgate.com/ViewPoem.aspx?id=104370",""],[5302,"بين خوف وهموم","https://www.poetsgate.com/ViewPoem.aspx?id=201379",""],[5360,"يانخيل العراق","https://www.poetsgate.com/ViewPoem.aspx?id=33241",""],[5401,"دايم السيف","https://www.poetsgate.com/ViewPoem.aspx?id=179866",""],[5414,"الهابطون والصاعدون","https://www.poetsgate.com/ViewPoem.aspx?id=12938",""],[5431,"هكذا تكلمت ريمادشت...","https://www.poetsgate.com/ViewPoem.aspx?id=202692",""],[5459,"كيف نعلو ..","https://www.poetsgate.com/ViewPoem.aspx?id=197648",""],[5461,"كيف ننسى الكويت","https://www.poetsgate.com/ViewPoem.aspx?id=5293",""],[5533,"وَطَنِي","https://www.poetsgate.com/ViewPoem.aspx?id=176873",""],[5542,"نحن أدرى","https://www.poetsgate.com/ViewPoem.aspx?id=10197",""],[5542,"شموخ الصابرين","https://www.poetsgate.com/ViewPoem.aspx?id=10070",""],[5559,"من يرد للقدس نصرا","https://www.poetsgate.com/ViewPoem.aspx?id=204217",""],[5616,"القدس","https://www.poetsgate.com/ViewPoem.aspx?id=203475",""],[5616,"صرخة","https://www.poetsgate.com/ViewPoem.aspx?id=204843",""],[5670,"جئتُ يا شِعري","https://www.poetsgate.com/ViewPoem.aspx?id=211123",""],[5725,"جحر ضب","https://www.poetsgate.com/ViewPoem.aspx?id=187234",""],[5891,"أحلام الموتى","https://www.poetsgate.com/ViewPoem.aspx?id=39927",""],[5906,"مَرَّ بي","https://www.poetsgate.com/ViewPoem.aspx?id=188228",""],[5956,"ارحميني","https://www.poetsgate.com/ViewPoem.aspx?id=182191",""],[5956,"سؤال وجواب على شاطئ البحر","https://www.poetsgate.com/ViewPoem.aspx?id=183228",""],[5956,"صرخة أهل فلسطين","https://www.poetsgate.com/ViewPoem.aspx?id=192087",""],[5957,"كل حب في حياتي لا يزول","https://www.poetsgate.com/ViewPoem.aspx?id=113357",""],[406,"أنشودة الفجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1117&r=&rc=61",""],[6318,"درّة الأقصى مُحمَّد الدرّة وأبوه جمال الدرّة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66165&r=&rc=15",""],[6328,"آمنة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84422&r=&rc=20",""],[6355,"مناجاة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66603&r=&rc=63",""]],"verses":[["كَيفَ نَنسى مَواقِفاً لَكَ فينا","كُنتَ فيها المَهيبَ لا الهَيّابا",0,"ب",2,0],["كيف نسعى إلى العلا في أمور","ليس فيها رَأيٌ لنا واختيار",1,"ر",1,0],["كيف نُصلى الحرب التي نحن فيها","لاذُ حُول لنا ولا أوتار",1,"ر",1,0],["كيف نُصلى الحرب التي فصلتنا","عن ذويها مَهامِهٌ وبحار",1,"ر",1,0],["كيف ناوَيت سيداً كلما زا","دَ عِداةً يزيده الله مجدا",2,"د",2,0],["كيف ندعوهمُ لآبائهم رَبْ","بي ومنهم أمثال هذا الزنيم",3,"م",1,0],["كيف نجاتي في خضم طما","والموج مثل الجبل الزاحل",4,"ل",1,0],["كَيفَ نَحصي عَلى عُلاكَ ثَناءُ","لَكَ مِنكَ الثَناءُ وَالإِكرامُ",5,"م",1,0],["كَيفَ نُثني عَلى اِبنِ يوسُفَ لا كَي","فَ سَرى مَجدُهُ فَفاتَ الثَناءَ",6,"ا",2,0],["كَيفَ نَخافُ الفَقرَ يا طَيبَ بَعدَما","أَتَتنا بِنَصرٍ مِن هَراةَ مَقادِرُه",7,"ر",2,1],["كَيفَ نَرجو الخُلودَ أَو نَطمَعُ العَي","شَ وَأَبياتُ سالِفينا القُبورُ",8,"ر",1,0],["كَيفَ نَلهو وَكَيفَ نَسلو بِعَيشٍ","هُوَ مِنّا مُستَرجَعٌ مَنزوعُ",9,"ع",1,0],["كَيفَ نَبتاعُ فانِيَ العَيشِ بِالدا","ئِمِ أَينَ العُقولُ وَالرَحلامُ",10,"م",1,0],["كَيفَ نَنساهُم وَما طالَ المَدى","كَيفَ نَنسى الأُمَناءَ الصادِقينْ",11,"ن",1,0],["كيف نَأبَى مُحمّداً وَهْوَ حقٌّ","أيقولُ الهُداةُ إنّا عَمِينا",12,"ن",2,0],["كَيفَ نَومي وَقَد حَلَلتُ بِبَغدا","دَ مُقيماً في أَرضِها لا أَريمُ",13,"م",1,1],["كيف نصفو ونحن من عُنْصِر الط","ينِ فساداً وظلمةً وجُمودا",14,"د",2,0],["كيف نسري ؟ وراءنا عاصف يط","غى º وقدّامنا أعاصير نكبا",15,"ب",2,0],["كيف ناغينا الصبا ماذا انتوى","مهدنا المشؤوم أو ماذا انتوينا؟",16,"ن",2,0],["كيف نستعجل الرصاص ! ونخشى","بعد هذا ، نباح كلب وكلبه",17,"ب",2,0],["كَيفَ نُثني على ابنِ يوسُفَ لا كيْ","لفَ سَرى مَجدُهُ، فَفاتَ الثّنَاءَ",18,"ا",2,0],["كيف ندعوهم لآبائهم ربي","ومنهم أمثال هذا الزنيم",19,"م",1,0],["كيف ناغينا الصبا .. ماذا انتوى ؟","منهدنا المشؤوم .. أو ماذا انتوينا ؟",20,"ن",2,0],["كَيفَ نَرمي مِن الزَمان بُروع","وَلَنا في ظلال جاهِكَ سَكنى",21,"ن",2,0],["كَيفَ نَرجو إِقامة وَحياتاً","وَاللَيالي تَحثّها الأَسحار",22,"ر",1,1],["كيفَ نلقى لها شبيهاً ونورُ","الله مِن تحتِ عرشه يَغْشَاها",23,"ا",3,0],["كيف نفّذته بنفسك يا هذا","بلا رهبة ولا إحجام",24,"م",1,0],["كيف نخشى فاقة الجهال من","بعد ما نلنا شذور الذهب",25,"ب",1,1],["كيفَ نفسي تستَريحْ","بينَ أمواجٍ وريحْ",26,"ح",1,1],["كَيفَ نَرجو الوَفاءَ مِن ناقِضاتٍ","عَهدَنا ناقِصاتِ عَقلٍ وَدينِ",27,"ن",1,0],["كيف نسلو من فارقَ المجدَ والسّوء","دَدَ والحزمَ والندَى والعَلاءَ",28,"ا",2,0],["كيف نحمي العراق أرضاً وشعب","دونَ صَفٍ موحَّدٍ يحتوينا؟",29,"ن",2,0],["كيف نَسطيع صدَّ ذاتِ قرونٍ","زرعت رأَسَها العنيدَ قُرونا؟",29,