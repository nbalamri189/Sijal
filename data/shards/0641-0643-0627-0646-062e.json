{"poems":[[549,"في كل عضو منك روح تقى","https://www.aldiwan.net/poem67236.html","عموديه"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80170","البسيط"],[1478,"","https://poetry.dctabudhabi.ae/diwan/poem/95508","البسيط"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53237","الوافر"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106987","الكامل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/107004","الكامل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129349","الطويل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73234","الكامل"],[585,"هو الصوت دوّى من فلسطين عالياً","https://www.poetsgate.com/ViewPoem.aspx?id=161906",""],[5308,"الكرم","https://www.poetsgate.com/ViewPoem.aspx?id=215218",""],[5190,"وليمة رفضت تناولها أعشاب البحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78294&r=&rc=7",""]],"verses":[["فكأنَّ خصرَكِ وَسْطَ عُزلَتِهِ","مُتَصَوِّفٌ لِلعالمِ الأبقى",0,"ق",2,0],["فكانَ خامسَ عيدٍ مِن خِلافَتِهِ لَها","وَأَوَّلَ عيدٍ طافَ كَوثَرَهُ",1,"ر",2,0],["فكان خطُّ حديدىُّ قد اندفعت","في صنعه أسد في ثوب إنسانِ",2,"ن",1,0],["فكان خزامها نشر الخزامى","ولمع البرق شائقها الوحيّا",3,"ي",2,0],["فكأن خط عذاره في خدّه","نقش الزبرجد لاح في بلور",4,"ر",1,0],["فكأن خافقة البنود تعاقدت","هي والقلوب لشدة الخفقان",5,"ن",1,0],["فكان خياراً من خيار فصاعداً","إلى آدم من سيد بعد سيد",6,"د",1,0],["فَكأَنَّ خَمَّاراً يُروِّقُها","وَكَأَن عَطَّاراً يُعَطِّرهُ",7,"ر",2,0],["فكان خضاباً في يديك وزينةً","عليك تبذ المترفات الغوانيا",8,"ي",2,0],["فَكَانَ خِتَامُ الرِّفْدِ مِنْهُ لِقَومِهِمْ","قُفُولاً سَرِيْعاً، لَيْسَ ذَاكَ بِمُغْرِمِ",9,"م",1,0],["فكان خوانك الممدود شوكاً","وكان طعامكَ المطهيُّ صابا",10,"ب",2,0]]}