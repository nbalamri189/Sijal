{"poems":[[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85428","الخفيف"],[325,"لا تقل همت في ضياء الغزال","https://www.aldiwan.net/poem67214.html","الخفيف"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125402","الرمل"],[3103,"","https://poetry.dctabudhabi.ae/diwan/poem/140295",""],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128953","الخفيف"],[4927,"الْفَتَاْةُ الْمُكَاْفِحَة","https://www.poetsgate.com/ViewPoem.aspx?id=29949",""],[5057,"قاوميني","https://www.poetsgate.com/ViewPoem.aspx?id=197180",""],[5081,"عِتَابُ لَيْلَى","https://www.poetsgate.com/ViewPoem.aspx?id=190184",""],[5190,"لن تهوني يا مصر","https://www.poetsgate.com/ViewPoem.aspx?id=153356",""],[5408,"أوجاع يوسفية","https://www.poetsgate.com/ViewPoem.aspx?id=190737",""],[5431,"لقد ذبح السلام حمائمَه","https://www.poetsgate.com/ViewPoem.aspx?id=186546",""],[5431,"العمرُ بحرٌ والكرامة ساحلُ","https://www.poetsgate.com/ViewPoem.aspx?id=187569",""],[5771,"شُكرًا","https://www.poetsgate.com/ViewPoem.aspx?id=189157",""],[5943,"قاوم، جاهد، اِصبر، صابرْ","https://www.poetsgate.com/ViewPoem.aspx?id=45281",""],[6102,"قاومي","https://www.poetsgate.com/ViewPoem.aspx?id=184633",""],[6102,"هبط الليل","https://www.poetsgate.com/ViewPoem.aspx?id=185296",""],[6147,"سوريا..لاءاتنا الحُمْر","https://www.poetsgate.com/ViewPoem.aspx?id=151697",""]],"verses":[["قاوموا القوة التي غشمت بال","مِثل والدهر للقوي ظهير",0,"ر",1,0],["قاومَت خلفة الحوادِث دهراً","ثم شق البِلى إليها سَبيلا",1,"ل",2,0],["قاوَمتُهُم أَجرَنا اللَهُ مِنها","بِلِحاظِ فَتَاكَةِ قِتالَه",2,"ل",2,0],["قاوِمُوا الجهل وهبُّوا","ألبِسُوا العلمَ الدروع",3,"ع",1,0],["قاومتهم بزين العلم فاندحروا","بالخزي يأكل في أيديهم العطب",4,"ب",1,0],["قاومي الحزن يا حبيبة قلبي","بخشوع ورقة وسكون",5,"ن",1,0],["قَاْوَمَتْ كُلَّ عَمِيْلٍ خَاْئِنٍ","سَاْوَمَ الضِّدَّ، وَرَاْمَ الاِنْبِطَاْحْ",6,"ح",1,0],["قاوميني - إذا رغبتُ - قليلا","واجعلي دربَ ما أُريدُ طويلا",7,"ل",2,1],["قَاوِمْ بِمَا قَدْ حَبَاكَ اللهُ يَا وَلَدِي","فَالْحَرْفُ نُورٌ بِهِ لِي قَدْ يَكُنْ حِوَلَا",8,"ل",2,0],["قَاوِمِيهَا ، ونَحنُ خَلفَكِ نَمضِي","وأْمُرِينَا ، نَخُضْ جَحِيمَ المَنونِ",9,"ن",1,0],["قاومْتُ مُذ صاحَتْ بهيْتَ لحجْرِها","فتهيّأتْ روحي وعدْتُ أسوّفُ",10,"ف",1,0],["قاوم مصيرك كيفما شاء الوغى!","تباً لقد ذبح السلام حمائمَه!!",11,"م",2,0],["قاوم رياحك فالمراكب أبحرت","واثبت لنصرك إنّ صبرك هاطلُ",12,"ل",1,0],["قَاومتُ أمواج الزَّمان وَريحه","ودعوتُني فعزمتُ أن أتصبّرا",13,"ر",2,0],["قاومْ.. جاهدْ..اِصبرْ.. صابرْ","فستهزمُ أجنادَ الشيطانْ",14,"ن",1,0],["قَاوِمِي مَا استَطَعتِ فِيَّ صُمُودا","تُدرِكِي مِنْ صَلَابَتِي جُلمُودا",15,"د",2,1],["قَاوَمَانِي كَجَلْمَدٍ مِنْ حَدِيدٍ","- تَارَةً - ثُمَّ - فَوقَ صَدرِي - لَانا",16,"ن",2,0],["قاؤوا على صحُف التاريخ ما ابتلعوا","حتى الخنازيرُ قد عافتْه قٌذرانُها",17,"ن",3,0]]}