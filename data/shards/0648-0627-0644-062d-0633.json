iwan/poem/72408","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141605","الكامل"],[4674,"جنية الماء","https://www.poetsgate.com/ViewPoem.aspx?id=186367",""],[4767,"لا تلمني","https://www.poetsgate.com/ViewPoem.aspx?id=178897",""],[4578,"يا من سمت بمعانيه قوافينا","https://www.poetsgate.com/ViewPoem.aspx?id=49532",""],[4859,"سناب شات!","https://www.poetsgate.com/ViewPoem.aspx?id=204328",""],[4888,"الشاطئان مصر والإمارات","https://www.poetsgate.com/ViewPoem.aspx?id=207744",""],[4927,"الجمال والحب","https://www.poetsgate.com/ViewPoem.aspx?id=4576",""],[4927,"الجمال والحب","https://www.poetsgate.com/ViewPoem.aspx?id=29739",""],[4929,"سوء الظن","https://www.poetsgate.com/ViewPoem.aspx?id=202432",""],[3271,"على مذبح الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=103196",""],[3591,"ضعفٌ ألم بقلبي بعدما ارتحلا","https://www.poetsgate.com/ViewPoem.aspx?id=149393",""],[3591,"يا دار مية دمع العين هطَّال","https://www.poetsgate.com/ViewPoem.aspx?id=149395",""],[5122,"صاحبي","https://www.poetsgate.com/ViewPoem.aspx?id=34796",""],[5136,"غصن يرنحه التنعم أملدا","https://www.poetsgate.com/ViewPoem.aspx?id=121550",""],[5277,"ما عُدْتُ أقولُ: متى غدُهُ","https://www.poetsgate.com/ViewPoem.aspx?id=200888",""],[5281,"ما احلى حبيبي","https://www.poetsgate.com/ViewPoem.aspx?id=199502",""],[5356,"جنّيةٌ","https://www.poetsgate.com/ViewPoem.aspx?id=204487",""],[5387,"سمراء","https://www.poetsgate.com/ViewPoem.aspx?id=53543",""],[5389,"عشاق فاطمة","https://www.poetsgate.com/ViewPoem.aspx?id=207840",""],[5452,"هواجس","https://www.poetsgate.com/ViewPoem.aspx?id=112743",""],[5616,"تعليق هامشي على هامش أحداث هامشية!","https://www.poetsgate.com/ViewPoem.aspx?id=205035",""],[5790,"ومهفهفٍ ماس القضيب وقده","https://www.poetsgate.com/ViewPoem.aspx?id=112146",""],[469,"وعدُ النحلية بالكرى لا يصدقُ","https://www.poetsgate.com/ViewPoem.aspx?id=39786",""],[5837,"خسارة","https://www.poetsgate.com/ViewPoem.aspx?id=189956",""],[5939,"يغار القلب فاتنتي","https://www.poetsgate.com/ViewPoem.aspx?id=185489",""],[5956,"صلواتٌ في ذكرى الخليل بن أحمد الفراهيدي","https://www.poetsgate.com/ViewPoem.aspx?id=215185",""],[6019,"يا أقسى من ليلٍ أسودْ","https://www.poetsgate.com/ViewPoem.aspx?id=202307",""],[6093,"زخرفة عربية","https://www.poetsgate.com/ViewPoem.aspx?id=193651",""]],"verses":[["وَالحُسْنُ أَكْمَلُ مَا يَكُونُ شَبِيبَةٌ","فِي بَدْئِهَا وَمَلاحَةٌ فِي تِمِّهَا",0,"م",3,0],["وَالحُسْنُ إِنْ لَمْ يَرْجَ يُمْلَلْ كَمَا","يُمَلُّ حُسْنُ الأَنْجُمِ السَّافِرَهْ",1,"ر",2,0],["والحسناتُ عنه لا تُمَسَّخُ","تفدِي الكهولُ نفسَه والشُّرَّخُ",2,"خ",1,0],["وَالحُسنَ قالَت كُلُّ ما أَحبَبتُمُ","وَالأَرضَ قالَت أَينَما اِستَوطَنتُمُ",3,"م",1,0],["وَالحُسنُ مِن كَرَمِ الوُجوهِ وَخَيرُهُ","ما أوتِيَ القُوّادُ وَالزُعَماءُ",4,"ا",2,0],["والحُسنُ ضِدَّانِ لا أدري إذا اجتمعا","أنوارُه فتَنَتْني أم غَياهبُه",5,"ب",2,0],["وَالحُسامُ الَّذي إِذا صَلَّتِ البي","ضُ وَصَلَّت في البَيضِ وَالأَبدانِ",6,"ن",1,0],["وَالحُسامُ المَشرَفِيُّ هُنا","رَمزَةٌ تومي إِلى الحَشَمِ",7,"م",1,0],["وَالحُسنُ مِنكِ يَطوفُ العاشِقونَ بِهِ","فَأَنتِ مَوسِمُ رُوّادٍ وَعُشّاقِ",8,"ق",1,0],["وَالحِسُّ أَوقَعَ حَيّاً في مَساءَتِهِ","وَلِلزَمانِ جُيوشٌ ما لَها لَجَبُ",9,"ب",1,0],["والحسن ما لم يك في الكلام","عرضك التحسين للملام",10,"م",1,0],["وَالحِسُّ لُطْفٌ يَسْتَشِفُّ","الْغَيْبَ مِنْ حُجُبِ الظَّلامِ",11,"م",1,0],["والحسن شيء فتَّان","وللشجونِ أفنان",12,"ن",1,0],["والحسنُ أخرسُ ناطقٌ بكمالِهِ","في وجههِ أَفديهِ أخرَس ناطِقا",13,"ق",2,0],["والحسنُ أعلقُ بالقلو","ب إذا تمنعَ أن يجودا",14,"د",2,0],["والحسنُ زيتٌ لشبابِ الفتى","إن جفَّ منهُ لحظةً ينطفي",15,"ف",2,0],["والحسن في عليائه","وجلاله مولى صباك",16,"ك",1,0],["والحسن للحب عبدٌ","فأنت يا روح عبدي",17,"ي",1,0],["والحسن لا تسع العبارة وصفه","وتطاول الشعراء فيه من القصر",18,"ر",1,0],["والحسَنِيُّون طالمَا تَلِفوا","بِحدّ أَسْيافِكُمْ وما قتلوا",19,"ل",3,0],["والحسن جند لا يفكّ أسيره","وقتيله بدم الجوى متشحط",20,"ط",1,0],["والحسين الشهيد والحسن المس","موم والبضعة الرضا الزهراء",21,"ا",2,0],["وَالحُسنُ مِنهُ يُستَعارُ جَميعُهُ","فَكَأَنَّما هُوَ في الوَرى أَنموذَجُ",22,"ج",1,0],["وَالحُسنِ قَد خَطَّ في خَدِّكَ وَقَد تَرجَم","سَطرَينِ بِالمِسكِ ذا مُعرِبٍ وَذا مُعجِم",23,"م",1,0],["وَالحُسامُ الطَريرُ إِن رَقَّ لِلنا","ظِرِ فَالمَوتُ كامِنٌ في الفِرِندِ",24,"د",1,0],["والحسنُ كالدرِّ فوقَ مَزبلةٍ","مَن يَلتَقِط منهُ يَلمُس الوَسَخا",25,"خ",2,0],["والحسنُ أضحى متاعاً يُشترى فلكم","أرى الحرائرَ أزواجاً لأعلاج",26,"ج",1,0],["والحسنُ زهرٌ والغرامُ عبيرُهُ","يا حبّذا لو بتِّ تنتَشِقينا",27,"ن",2,0],["والحُسنُ والإحسانُ فيكِ فمن إذا","رُوِّعتِ لا يَبكيكِ أو يَرثيك",28,"ك",1,0],["والحسن كالورد اذا حصنت","ارجاؤه ينمو ولم يذبل",29,"ل",1,0],["والحسن كالدهر إذا حصنت","أرجاؤه ينمو ولم يذبل",30,"ل",1,1],["وَالحسن نقَّطه بَدرِّ حَيائِهِ","فَزَها عَلى ياقوته بِنَضيدهِ",31,"د",2,0],["والحُسنُ للحسناء مُستَجمَعٌ","والحظُّ قد جُنَّ بحُبِ القِباح",32,"ح",1,0],["وَالحُسن وَالإِحسان عِندَك","وَاللَطافة أَجمَع",33,"ع",1,0],["والحسنة تدخل بها الجنة","في الكفه يثقل بها الميزان",34,"ن",1,0],["والحسن والحسين ثم البتول","والصحابه هم القوم الحسان",35,"ن",1,0],["وَالحسنُ المَمنوع شُربَةَ ماءٍ","بَينَ حرِّ الظَبي وَحرِّ الغَليلِ",36,"ل",1,0],["وَالحسنِ الرَضِيِّ في أَحوالِهِ","مَن مَنبَعُ العُلومِ في أَقوالِهِ",37,"ه",1,0],["وَالحسينِ المُرتَضى يَو","مَ المَساعي اِذ حَواها",38,"ا",3,0],["والحسن أآمل ما يكون شبيبة","في بدئها وملاحة في تمها",39,"م",3,0],["والحسنُ للعشّاقِ مثلُ السيفِ يق","تُلُ منْ يكابرُهُ ويُعجِبُ رونَقا",40,"ق",2,0],["والحسنب يدعو كل قلب فارغ","فيجيب ما فيه من الذرّات",41,"ت",1,0],["والحسين الخليع ينثر عقداً","من ندامٍ يشف تحت العباره",42,"ر",2,0],["والحسام الغضوب في كل خطبٍ","حيث تحكي بيض السيوف الغمودا",43,"د",2,0],["والحسن كالمال كما يفسده","الجود كذا يصلح منه البخل",44,"ل",1,0],["والحسن من قلبي وقر","طك حاز ملك الخافقينِ",45,"ن",1,0],["والحسان حافلة","تتجلي وتحتجب",46,"ب",1,0],["والحُسنُ فيه لسلطان الهوى أخذتْ","يَداهُ في كلّ قلبٍ عقْدَ بَيعتِهِ",47,"ت",2,0],["والحسن قد ألف أشتاته","غصن تثنى فوق ردف رداح",48,"ح",1,0],["والحُسنُ يَجذِب بَعضُهُ بعضاً فَتَذ","هَلُ عند رُؤيتِه العُقُولُ ذُهولا",49,"ل",2,0],["والحس والمحسوس قد قاما بها","والعقل والمعقول يا إخوان",50,"ن",1,0],["والحس والمحسوس والوهم وال","موهوم بل والوعظ والواعظ",51,"ظ",1,0],["والحسن شخصٌ لم يَزَلْ قائماً","في وجْهِهَا المنتقبِ المُسْفِر",52,"ر",1,0],["والحُسْنُ لَيْسَ بِحَافِظٍ لَكَ ذِمَّةً","إِلّا بِحِفْظِكَ ذِمَّةَ العُشّاقِ",53,"ق",1,0],["وَالحُسْنُ لَو أَبْصَرَهُ","لَماتَ مِنْ فَرْطِ الحَسَدْ",54,"د",1,0],["وَالحُسنُ يُشرِقُ في العُيونِ بِذاتِهِ","وَهَنا يُضيءُ بِذاتِهِ وَصِفاتِهِ",55,"ت",2,0],["والحُسامُ السَّفّاكُ مِن مُهجِ الأع","داءِ ما حَوَّلَ اسمَهُ السَّفاكا",56,"ك",2,0],["وَالحسنُ صَيَّرَهُ يتيهُ بِحَظِّهِ","فَطَويلُ هَجري مِن أَبيهِ وَجَدِّهِ",57,"د",2,0],["وَالْحُسْنُ فِي الْعَيْنَيْنِ مِنْهَا عَاضِدٌ","ذَاكَ الْجَمَالَ مَعَ الْمَلاَحَةِ فِي الْفَمِ",58,"م",1,0],["وَالحُسن في الخَدّ","أَحشاء الشّجي قَد خَد",59,"د",1,0],["والحسن معقود اللِوا","يدعو لطاعته الأنامْ",60,"م",1,0],["وَالحُسنُ يَبلى كالشَّبيبَةِ فاغنَمِي","وَصلِي لنأخُذَ مِن نَعِيمٍ حاضِرِ",61,"ر",1,0],["والحسن قد وجبت عليه زكاته","أفلا على ابن سبيله يتصدق",62,"ق",1,0],["والحسن زها واللفظ شها","والحزم نهى عن كل ردي",63,"د",2,0],["والحسنُ في الأمر المزوَّرِ زائلٌ","كالشيب ينصلُ بعد حُسن خِضابهِ",64,"ب",2,0],["والحسنُ يكتبُ بالغصونِ على","وَرَقِ الرياضِ بأحرُفِ الزَّهْر",65,"ر",1,0],["وَالحسن تكمل بالإِحسان صورته","وأصدق البرق مالَم يخط راعده",66,"د",2,0],["والحسن يكمل حيثما هو جامع","بين الذكاء ودقّة التّكوين",67,"ن",1,0],["والحسن في تصريف أحكامه","منزهٌ عن سَفهِ الجاهل",68,"ل",1,0],["وَالحُسنُ كانَ وَلا يَزالُ وَسيمُهُ","شَرَكَ القُلوبِ وَقِبلَةَ المُتَطَلِّعِ",69,"ع",1,0],["والحسن الذي عداه في رحى","ذل قياده هشيم المحتضر",70,"ر",1,0],["والحسن تاه دلالا","وأكبر الغُصنُ قَدَّك",71,"ك",1,0],["والحسن وزن لمعنى الشعرِ نَقدِرهُ","به كما كان للألفاظِ أوزانُ",72,"ن",1,0],["وَالحُسنُ لا حُسنَ في وَجهٍ تَأَمَّلُهُ","إِن لَم تَكُن مِثلَهُ الأَخلاقُ وَالشِيَمُ",73,"م",1,0],["والحسن دبجه بثغر أبيض","ونواظر سود وخدّ أحمر",74,"ر",1,0],["والحسامُ الذي بكلِّ حسامٍ","حاسمِ المَضْربَيْنِ زادٍ وهازِي",75,"ز",2,0],["والحسن والعاشقيه","والزهر والأنساما",76,"م",2,0],["والحَسَنَينِ ثمّ عن عَمَّيهِما","وبُضعَةِ النبىّ أمِّهِما",77,"م",2,0],["وَالحسنيون كُماة الوَغى","في يَوم لا يَثبتُ فيها كَمي",78,"م",2,0],["وَالحسنيون أَجل همة","وَأَسمَح الناس بطون راح",79,"ح",1,0],["والحسن أذكى خدها","بجمره المؤجج",80,"ج",1,0],["وَالحَسكيات فَلا تَنسَ في","خَندَقِها أَوتادَها القائِمة",81,"م",2,0],["والحسام الذي أشار اليه","في مقام يجل عن هذيان",82,"ن",1,0],["والحسنُ المُحسنُ الذي كان","ولولاهُ إلى الزَّمانِ أي مُسي",83,"س",2,0],["والحساب الأصمّ أحسنُ شيءٍ","عجزَت عنه عامّةُ الحساب",84,"ب",1,0],["والحسم أصرح في الردى من خمرة","فيها الردى من تالف الأعناب",85,"ب",1,0],["والحسن حسن الجسم رهن الزوال","لا عين يبقي بعده أو أثر",86,"ر",1,0],["والحسن يلهمك البيان فتثني","ونهاك مبتدعٌ وقلبك شادي",87,"د",2,0],["والحُسْنُ في وَجْنتيْهِ غَضٌّ","ما اخْتلَف الليلُ والنهارُ",88,"ر",1,0],["والحسنُ على القلوب والٍ","والقلب إلى الحبيب وائل",89,"ل",1,0],["والحسينُ الذي رأَى القتل في الع","زِّ حياةً والعيشَ في الذُّلِ قَتْلا",90,"ل",2,0],["والحسينُ بنُ أَحمدٍ كان للخُط","بَةِ فصلاً وفي الحكومةِ عَدْلا",90,"ل",2,0],["والحسن لا يتوارى في الورى ابداً","لا يملأ العين إلا عين بغداد",91,"د",1,0],["والحسن الأزهري الحجازي","يرجو لما قد جناه غفرا",92,"ر",2,0],["والحسن إن أودى به أهله","يغدو قذى في مقلة الناظر",93,"ر",1,0],["والحسن يعشقه الكريم وربما","أضرى لئيم النفس بالنزاعات",94,"ت",1,0],["والحسن عند المبطلي","ن، وعند من يهوى عداءَكْ",95,"ك",1,0],["والحس يشهد أن للمحضار آ","يات يراها الناس بالأبصار",96,"ر",1,0],["والحسيب النسيب نجل سليما","ن الزكيّ الأصول والخال والعم",97,"م",1,0],["والحسين السبط موفور الحيا","وذوي الفيض الذي فاق الركاما",98,"م",2,0],["والحسن خص بنا على","رغم الكواكب والبدور",99,"ر",1,0],["والحسبلهْ والحيعلهْ وتسبيحْ","لك الذي صَمَتْ والذي يصيحْ",100,"ح",1,0],["والحسن فيه لسلطان الهوى أخذت","يداه من كل قلب عقد بيعته",101,"ت",2,0],["والحسن في صور النفوس وإن","راقتك من أجسامها الصور",102,"ر",1,0],["والحسن يستسقى به الغماما","ومن كريم خلقه يستجدى",103,"د",2,0],["والحسن ان يقرن بصوت حببا","لكل ذي نفس بغير حد",103,"د",1,0],["والحسنُ بالإِحسانِ يكمل فضلهُ