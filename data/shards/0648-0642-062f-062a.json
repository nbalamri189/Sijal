s.php?name=Sh3er&doWhat=shqas&qid=9740&r=&rc=230",""],[67,"جَنابكِ منه تُسْتَفَادُ الفَوائدُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=13730&r=&rc=6",""]],"verses":[["وَقَد تَرَكَت صَوارِمُهُم بِحِجرٍ","وَقائِعَ مِن دِماءِ بَني عِقالِ",0,"ل",1,1],["وَقَد تَعقُمُ الأَفهامُ عَن قَولِ قائِلٍ","فَيُوجِزُ بَعضَ القَولِ وَهوَ مُطيلُ",1,"ل",1,0],["وَقُدتَ إِلَيهِ العيسَ عَجلى مَروعَةً","تَناهَزُ في أَنماطِها وَالنَمارِقِ",2,"ق",1,0],["وَقُدتَ إِلَيهِ الحَيلَ يُسبِبنَ بِالقَنا","وَيَسبُبنَ بوغاءَ المَلا وَالسَباسِبِ",3,"ب",1,0],["وَقَد تَوالَتْ مِن سَنا","هُ لَمَعاتٌ تَخدَعُ",4,"ع",1,0],["وَقُدْتَ إِلَى الأَعْدَاءِ فِيهَا مُبَادِراً","لُيُوثَ رَجَالٍ فِي مَنَاكِبِ عِقْبَانِ",5,"ن",1,0],["وقُدْتَ إلَيْهِ الُرْدَ والنصْرُ خافِقٌ","يَرِفُّ علَيْها والملائِكُ أعْدادُ",6,"د",1,0],["وقُدْتَ إلَيْها الجيْشَ والعَسْكَر الذي","تُرَوّى عَواليهِ وتُرْوَى صِحاحُهُ",7,"ح",2,0],["وقدْ تُعْتِبُ الأيّامُ بعْدَ عِتابِها","وقدْ يُعْقِبُ اللهُ النّعيمَ منَ البؤسِ",8,"س",1,0],["وَقَد تُخرِسُ الأَحزانُ كُلَّ مُفَوَّهٍ","يُصَرِّفُ في الإِنشادِ كُلَّ عِنانِ",9,"ن",1,0],["وَقَد تَمَنّى الضُحى لَو أَنَّهُم دَرَجوا","هَذا الفَقيدَ بِثَوبٍ مِنهُ مَقدودِ",10,"د",1,0],["وقد تَخَلَّلَ في أثناءِ لِحَيتِهِ","منها الدُّخانُ وَفُوهُ غابَ في فيها",11,"ي",3,0],["وَقَد تَوَلّى اِبنُهُ عَلَيها","ما أَشبَهَ الفَرخَ بِالحَمامَه",12,"م",2,0],["وَقَد تُسمِعُ اللَيثَ الجِحاشُ نَهيقَها","وَتُعلي إِلى البَدرِ النِباحَ كِلابُ",13,"ب",1,0],["وَقَدْ تَابَعَ إِلْيَاسُ مِنْهَاجَهَا","وَنَالَ مِنْ الجَّاهِ كُلَّ الأَرَبْ",14,"ب",1,0],["وقد تحرم الشمس العفاة شعاعها","ولم تحرميهم منك في حالة يدا",15,"د",2,0],["وقد تناجيها بأسرارها","جدا وقد تصغي لأخبارها",16,"ه",2,0],["وقد تربيها بزجر عنيف","وتتبعه الزجر بعفو لطيف",16,"ف",1,0],["وَقَدْ تَلْقَى مُنَاكَ مُصَوَّرَاتٍ","وَلَمْ يَخْطُرْنَ فِي ظَنِّ الحَمِيمِ",17,"م",1,0],["وَقَد تَهَيَّأَ رامٍ عَن شَمائِلِها","مُجَرَّبٌ مِن بَني جِلّانَ مَعلومُ",18,"م",1,0],["وَقَد تَوَجَّس رِكزاً مُقفِرٌ نَدُسٌ","بِنَبأَةِ الصَوتِ ما في سَمعِهِ كَذِبُ",19,"ب",1,0],["وقد تُنطق الأيام بالحق أعجماً","وتُسكِت عن تبيانه كلَّ ناطق",20,"ق",1,0],["وقد تُعرِض الأسماعُ عن ذي فصاحة","وتُصغى إلى ذي اللُكنة المتشارق",20,"ق",1,0],["وقد ترمي الصواعق محرقاتٍ","بها في الأرض يندكّ البناء",21,"ا",2,0],["وقد تخبر الحرب العوان بسرها","وإن لم تُبِحْ من لا يريد سؤالها",22,"ل",3,0],["وَقَد تَبَيَّنَ في شِجعٍ وِلادَتُكُم","كَما تَبَيَّنَ أَنّى يَطلُعُ القَمَرُ",23,"ر",1,0],["وقد تغير عهدُ الحال من جسدي","وما لحال عهدي فيك تغيير",24,"ر",1,0],["وقد تفاءَلت من طول البقاء له","إذ قال عنه الورى هذا أخو الخضر",25,"ر",1,0],["وقد تكثر حسَّادِي وأورثهم","نفاق لفظيَ في نادِيك أحزانا",26,"ن",2,0],["وَقَد تَقَدَّمَ في هَذا أَبو حَسَنٍ","إِلى الحُسَينِ وَوَصّى قَلبَهُ الحَسنا",27,"ن",2,0],["وقد تفاءلتُ له زاجراً","كُنيتَهُ لا زاجراً ثعلبا",28,"ب",2,0],["وقد تعفَّرتِ الشمطاءُ فاكتسبتْ","لونين من غُبرةٍ فيها ومن شَهَبِ",29,"ب",1,0],["وقد تُسلميهِ للمنيّةِ بعدما","ذهبتِ بحلو العيش منه وعذبِهِ",30,"ب",2,0],["وقد ترسُو مَرَاسِيهِ","وقد تجري لَهُ أَرْحي",31,"ح",2,0],["وقد تبدلتُ من بَلْواي عافيةً","بحمْد رَبٍّ على الحاليْنِ مَحْمُودِ",32,"د",1,0],["وقد تخايلتُ في سرباله عُصُراً","أعود فيه من اللذات أعيادي",33,"ي",1,0],["وقد تَتَوَّجْتُ من ولاء أبي ال","عباس تاجاً يسْمُو به السَّامي",34,"م",2,0],["وقد تردَّتْ على سربالِ بَهْجَتِها","فرعاً غذَتْه الغوادي فهو فَينان",35,"ن",1,0],["وقد تضمنتَ أرزاقاً نعيش بها","وكان وعدك والإنجازُ في قَرَن",36,"ن",1,0],["وَقَد تَكونُ سُلَيمى غَيرَ ذي خُلُفٍ","فَاليَومَ أَخلَفَ مِن سَلمى المَواعيدُ",37,"د",1,0],["وَقَد تَبيتُ هُمومُ النَفسِ تَبعَثُني","مِنها نَوافِذُ حَتّى أُعمِلَ الجَمَلا",38,"ل",2,0],["وَقَد تَنَقَّذتَهُم مِن قَعرِ مُظلِمَةٍ","إِذا الجَبانُ رَأى أَمثالَها زَحَلا",38,"ل",2,0],["وَقَد تَكونُ بِها سَلمى تُحَدِّثُني","تَساقُطَ الحَليِ حاجاتي وَأَسراري",39,"ر",2,0],["وَقَد تَفاقَمَ أَمرٌ غَيرُ مُلتَئِمٍ","ما بَينَنا فيهِ أَرحامٌ وَلا عِذَرُ",40,"ر",1,0],["وَقَد تَكونُ بِها هيفٌ مُنَعَّمَةٌ","لا يَلتَفِعنَ عَلى سوءٍ وَلا سَقَمِ",41,"م",1,0],["وَقَد تُبلى بِأَحمَقَ يَدعيها","فَإِن تَغضَب لِذَلِكَ يَدعيكا",42,"ك",2,0],["وَقَد تَذَكَّرَ قَلبي بَعدَ هَجعَتِهِ","أَيَّ البِلادِ وَأَيَّ الناسِ أَنتَجِعُ",43,"ع",1,0],["وَقَد تناهت يَدي عَن كأسها غَضَباً","وَمَجَّت الأُذنُ أَيضاً نَعمَةَ الوَتَرِ",44,"ر",1,0],["وقد تهتّك فيها","حتى أضاع وقاره",45,"ر",2,0],["وقد تأتى الجداول في خشوع","بما قد يعجز السيل الأتيا",46,"ي",2,0],["وقد ترفع الأوطانَ للنجم همةُ","ويُرجع قوما للحياة شعور",47,"ر",1,0],["وقد تجرى سعود او نحوس","وليس سوى قضاء الله جاري",48,"ي",1,0],["وَقَد تَحزُنُ أَحياناً","وَتَمشي وَحدَها تارَه",49,"ر",2,0],["وَقَد تَروى عَلى صُلتٍ","إِذا نادَمتَ سُمّارَه",49,"ر",2,0],["وَقَد تَسكَرُ مِن خَودٍ","عَلى الإِفريزِ مِعقارَه",49,"ر",2,0],["وَقَد تَشبَعُ يا اِبنَ اللَي","لِ مِن رَنَّةِ قيثارَه",49,"ر",2,0],["وَقَد تَتَجَلّى إِذا أَقبَلَت","بِنُعمى الشَقِيِّ وَبُؤسى السَعيد",50,"د",1,0],["وَقَد تَتَوَلّى إِذا أَدبَرَت","وَلَيسَت بِمَأمونَةٍ أَن تَعود",50,"د",1,0],["وَقَد تَقبَلُ العُذرَ الخَفيَّ تَكَرُّما","فَما بالُ عُذري واقِفاً وَهوَ واضِحُ",51,"ح",1,0],["وَقَد تُبَدِّلُها بِالقَومِ غَيرُهُمُ","لِكَي تَجِمَّ رُؤوسَ القَومِ وَالقَصرُ",52,"ر",1,0],["وَقَد تَمَنَّوا غَداةَ الدَربِ في لَجَبٍ","أَن يُبصِروكَ فَلَمّا أَبصَروكَ عَموا",53,"م",3,0],["وَقَد تَوالى العِهادُ مِنهُ لَكُم","وَجادَتِ المَطرَةُ الَّتي تَسيمُ",54,"م",1,0],["وَقُدتَ إِلَيها كُلَّ أَجرَدَ سابِحٍ","يُؤَدّيكَ غَضباناً وَيَثنِكَ راضِيا",55,"ي",2,0],["وقد تبعت مزاجات المبادي","تراكيب تفرُ بها العيونُ",56,"ن",1,0],["وَقَد تَفوتُ الرائِمينَ غُرَّتُهُ","إِعراسَ لَيثِ العَرينِ في أَشَبِه",57,"ب",2,0],["وَقَد تَوَهَّمَ أَو أَخطا مُنَجِّمُكُم","بَينَ الدَقائِقِ لَمّا اِجتازَ وَالدَرَجِ",58,"ج",1,0],["وَقَد تَطَلَّبتُ جَهدي ثالِثاً لَكُما","عِندَ اللَيالي فَلَم تَفعَل وَلَم تَكَدِ",59,"د",1,0],["وَقَد تَجاذَبَني شَوقانِ عَن عَرَضٍ","مِن بَينِ مُطَّرَفٍ عِندي وَمُتَّلَدِ",60,"د",1,0],["وَقَد تَجَلّى كاسِراً طَرفَهُ","كَأَنَّهُ ديكٌ بِهِ نَقرَه",61,"ر",2,0],["وَقَد تَرَكَ العَبّاسُ عِندَكَ وَاِبنُهُ","عُلاً طُلنَ مَرمى النَجمِ حَتّى تَحَيَّرا",62,"ر",2,0],["وَقَدَت دونَهُ إِضاءَةُ نورٍ","وَقَدَتها لَهُ لَهُ طَلاقَةُ بِشرِ",63,"ر",1,0],["وَقَد تَكونُ مُعاناً وَالهَوى قَبَلٌ","لِأُنَّسٍ مِن ظِباءِ الإِنسِ أَو فورِ",64,"ر",1,0],["وَقَد تَتَناهى الأُسدُ مِن دونِ صَيدِها","شِباعاً وَتَغشى صَيدَها وَهيَ جُوَّعُ",65,"ع",1,0],["وَقَد تَقَصَّيتُ عُذري في التَجَمُّلِ لَو","أَحمَدتَ غايَتَهُ وَالحُزنِ لَو نَفَعا",66,"ع",2,0],["وَقَد تَبَدَّأتَ فاعِلاً حَسَناً","فَإِمتَثَلَ الغَيثُ ذاكَ فَإِتَّبَعَك",67,"ك",1,0],["وَقَد تَقولُ الأَبياتِ تُصبي بِها ال","غادَةَ خَلفَ الأَبوابِ وَالسُجُفِ",68,"ف",1,0],["وَقَد تُؤَدّى عَنكَ الرِسالَةُ في الحُب","بِ فَتَأتي كَدُرَّةُ الصَدَفِ",68,"ف",1,0],["وَقَد تَبَيَّنتَ ذاكَ في الكَمَدِ ال","بادي عَلَيها وَالواكِفِ الذَرِفِ",68,"ف",1,0],["وَقَد تَمَّ صُنعُ اللَهِ لِلمَعشَرِ الأُلى","تَولّاهُمُ الغَمرُ المُؤَمَّلُ نائِلُه",69,"ل",2,0],["وَقَد تُسعَرُ الهَيجاءُ مِنهُ بِمِرجَمٍ","تُوَفّى بِهِ أَوتارُها وَذُحولُها",70,"ل",3,0],["وَقَد تَعفو الظُنونُ بِمَن يُرَجّى","فَتُخلِفُ مِثلَ ماتَعفُ الطُلولُ",71,"ل",1,0],["وَقَد تَدرُسُ الأَحسابُ إِن هِيَ ضُيِّعَت","مَناكِحُ أَهليها دُروسَ المَنازِلِ",72,"ل",1,0],["وَقَد تَكونُ بِها قِضبانُ إِسحِلَةٍ","مُهتَزَّةٍ في اِحمِرارِ الوَردِ وَالعَنَمِ",73,"م",1,0],["وَقَد تَبَيَّنَ أَنّي مُغرَمٌ كَلِفٌ","فَاِستَشعَرَ العُجبَ في ضَنٍّ وَفي تيهِ",74,"ي",2,0],["وَقَد تَحظى اللَئيمَةُ بَعدَ فَقرٍ","وَتُعطى الرِزقَ مِن وَلَدٍ وَمالِ",75,"ل",1,0],["وَقَد تَحَرَّفَ حَتّى قالَ قَد فَعَلَت","وَاِستَوضَحَت صَفَحاتِ القُرَّحِ الهيمِ",76,"م",1,0],["وَقَد تَرَكَ الأَيّامُ لي بَعدَ صاحِبي","إِذا أَظلَمَت عَيناً طَويلاً سِجامُها",77,"م",3,0],["وَقَد تَرَكَت مِرداةُ خِندِفَ في يَدي","جَماجِمَ مِن قَيسٍ عِظاماً هُزومُها",78,"م",3,0],["وقد تَمَهَّلْتَ شَهراً بعدَه كَمَلاً","وإنَّما خُلِقَ الإنسانُ من عَجَلِ",79,"ل",1,0],["وقد تناوبَني منها الخيالُ فما","أصابَ إلا خيالاً قلبُه يَجِبُ",80,"ب",1,0],["وَقَد تَجَلّى الحَقَّ مِن بَعدِ ما","صَدَّقَ فيهِ السَعيَ يَعقوبُ",81,"ب",1,0],["وَقَد تَلاقَت فُروعُ الدَوحِ وَاِشتَبَكَت","كَأَنَّما الطَيرُ مِنها فَوقَ أَقفاصِ",82,"ص",1,0],["وَقَد تَرَنَّمَ شادٍ صَوتُهُ غَرِدٌ","كَأَنَّهُ ناطِقٌ مِن حَلقِ شُحرورِ",83,"ر",1,0],["وقَد تُوِّجَ البهوُ البهيُّ بِقُبَّةٍ","فقلْ في عروسٍ في جلابيبها تُجلى",84,"ل",2,0],["وقد تَشُقّ بنا الأهوالَ جاريةٌ","تجري بريح متى تسْكُنْ لها تقفِ",85,"ف",1,1],["وقد تنْتخي الساداتُ بعد خمولها","وَتَخرُجُ مِن بَعدِ الكُسوفِ بُدورُ",86,"ر",1,0],["وَقَد تُرِعَت إِثفِيَّةُ العَرَبِ الَّتي","بِها صُدِعَت ما بَينَ تِلكَ الجَلامِدِ",87,"د",1,0],["وَقَد تَألَفُ العَينُ الدُجى وَهوَ قَيدُها","وَيُرجى شِفاءُ السَمِّ وَالسَمُّ قاتِلُ",88,"ل",1,0],["وَقَدَتْ حِمَيَّتُهَا فَلَوْلا مَزْجُهَا","بِالْمَاءِ بَعْدَ الْمَاءِ شَبَّ ضِرَامُ",89,"م",1,0],["وقدْ تقنَّعتُ مِنهمْ","بما يقيمُ سطوري",90,"ي",1,0],["وَقَد تَغنى بِهِ نُعمٌ","وَكُنتُ بِوَصلِها جَذِلا",91,"ل",2,0],["وَقَد تَأَرَّجَ نَورٌ","غَضَّ يُخالِطُ وَردا",92,"د",2,0],["وَقَد تَرَنَّحَ غُصناً","وَاِحمَرَّتِ الكَأسُ وُردَه",93,"د",2,0],["وَقَد تَهادى بِها نَسيمٌ","حَيَّت سُلَيمى بِها سَلاما",94,"م",2,0],["وَقَد تَقَلَّدتَ مِن حَليِ الفَضائِلِ ما","أَلقى لَكَ الناسُ فيهِ بِالمَقاليدِ",95,"د",1,0],["وَقَدَت بِهِ الشِعرى فَأَل","لَفَتِ الخُدودَ بِها الهَواجِر",96,"ر",1,0],["وَقَدَّتِ المَجَرَّةُ الظَلاما","تَحسَبُها في لَيلِها إِذا ما",97,"م",2,0],["وَقَد تَبَدّى النَجمُ في سَوادِهِ","كَحُلَّةِ الراهِبِ في حِدادِهِ",97,"ه",1,0],["وَقَد تَشُقُّ غُبارَ الحَربِ لي فَرَسٌ","مُقَدَّمٌ غَيرَ هَيّابٍ وَلا وانِ",98,"ن",1,0],["وَقَد تَرَدَّيتُ بِاِبنِ صاعِقَةٍ","أَخضَرَ ما في غِرارِهِ فَلَلُ",99,"ل",1,0],["وَقَد تَرَدَّت بِمِنديلٍ عَواتِقُهُ","يُقَطِّبُ الوَجهَ مِن تيهٍ وَما غَضِبا",100,"ب",2,0],["وَقد تَأَدَّبَتِ المُسْتَخْدمون بهم","وَالغافلون إذَا ما ذُكِّرُوا ذَكَرُوا",101,"ر",3,0],["وقد تعاطى ابنُ عَفَّانٍ لأُسرَتِهِ","وما تعاطَى أبو بَكْرٍ ولا عُمَرُ",101,"ر",1,0],["وقَدْ تَعِبَتْ خُيُولُ الْقَوْمِ مِمَّا","يَطُوفُونَ البِلادَ ويَرْجِعُونا",102,"ن",2,0],["وقد تلاقَتْ عليه كلُّ مُنجِبَةٍ","ومُنجِبٍ فهو لا يُعزَى إلى سيّ",103,"ي",1,0],["وقد تركْتَ عِداهم فيه مِن حَذَرٍ","تَخْلُو فما تَتَناجَى بالأمانيّ",103,"ي",1,0],["وقُدْتُ إلى نَفْسي منّيةَ نَفسِها","كما أُحِرقتْ في نارِها كَفُّ مُضْرِم",104,"م",1,0],["وقُدْتَ بها قُبَّ الأياطِلِ شُزَّباً","تُسابقُ وَقْدَ الرّيحِ عَدْواً فتَسبقُه",105,"ق",2,0],["وقُدتُمْ إلَيْها كُلَّ ذي جَبَريّةٍ","على المُقرَباتِ الجُرْد تَبأى وتبذخ",106,"خ",1,0],["وَقَد تَأَلَّيتُ أَن لا","في البَرِّ ما عِشتُ أَركَب",107,"ب",1,0],["وَقَد تَناهَت وَصارَت","كَمِثلِ قَبسِ الزِنادِ",108,"د",1,0],["وَقَد تُبتُ عَنها يَعلَمُ اللَهُ تَوبَةً","تَبيتُ مَكانَ السِرِّ مِنّي المُكَتَّمِ",109,"م",1,0],["وَقَد تَراها إِذ لَنا وُدُّها","تَدنو وَتخَشى عَقرَبَ العَين",110,"ن",1,1],["وَقَد تَرِدُ الأَيّامُ غُرّاً وَرُبَّما","وَرَدنَ كُلوحاً بادِياتِ الشَكائِمِ",111,"م",1,0],["وَقَد تَعاطيني عِراقِيَّةٌ","كَأَنَّها إِذ جُلِيَت نورُ",112,"ر",1,0],["وَقَد تَرَدّى بِالسَرابِ القورُ","والجُندَبُ الجَونُ لَهُ صَريرُ",113,"ر",1,0],["وَقَد تُبتُ فَاِقبَل تَوبَتي يابنَ هاشِمٍ","فَإِنَّ الَّذي بَيني وَبَينَكَ مُدمَجُ",114,"ج",1,0],["وَقَد تَمَنَّيتُ أَن أَلقاكِ خالِيَةً","يَوماً وَأَنّي وَفيما قُلتِ لي عِوَجُ",115,"ج",1,0],["وَقَد تَرَكتُ أَبا اللِصَّينِ مُعتَرِضاً","وَما اِعتِراضُ ذُبابٍ طَنَّ مَذبوبِ",116,"ب",1,0],["وَقَد تَأمَني مَن لا يَزالُ مُباعِداً","عَلى قُربِ مَن يَدنو بِسَهلٍ وَمَرحَبِ",117,"ب",1,0],["وَقَد تَجِرَت بِأُختِكُمُ غَنِيٌّ","فَما خَسِرَ التِجارُ وَلا أَسَاءوا",118,"ا",1,0],["وَقَد تَنجو النُفوسُ بِأَرضِ جَدبٍ","وَيُهلِكُ أَهلَهُ المَغنى الخَصيبُ",119,"ب",1,0],["وَقَد تَحَمَّلتُ مِنَ الوِزرِ ما","تَعجِزُ أَن تَحمِلَهُ البُختُ",120,"ت",1,0],["وَقَد تُقَضّى الحَياةُ راضِيَةً","بِدونِ ما نيلَ مِن مَآرِبِها",121,"ب",3,0],["وَقَد تَكونُ أَيادي القَومِ باذِلَةً","حَتّى تُعَدُّ مَعَ الأَمطارِ أَمطارا",122,"ر",2,0],["وَقَد تَغشى السَعادَةُ غَيرَ نَدبٍ","فَيُشرِقُ بِالسُعودِ إِذا وَدَسنَه",123,"ن",2,0],["وقد تَبَيّنَ قَدْري أن معرِفَتي","مَن تَعلَمينَ ستُرْضيني عن القَدَرِ",124,"ر",1,0],["وقد تَنْطِقُ الأشياءُ وهْيَ صَوَامِتٌ","وما كُلّ نُطْقِ المُخْبِرينَ كلامُ",125,"م",1,0],["وقد تفرّسْتُ فيكَ الفَهْمَ مُلْتَهِباً","من كل وجهٍ كنارِ الفُرْسِ في السَّذَقِ",126,"ق",1,0],["وَقَد تُلافي بِيَ الحاجاتِ ناجِيَةٌ","وَجناءُ لاحِقَةُ الرِجلَينِ عَيسورُ",127,"ر",1,0],["وَقَد تَبَطَّنتُ مِثلَ الرِئمِ آنِسَةً","رُؤدَ الشَبابِ كَعاباً ذاتَ أَوضاحِ",128,"ح",1,0],["وقَدْ تَزيَّنتِ الدُّنيا لِساكِنها","كأَنَّما أُلْبِسَتْ وَشْياً وَدِيباجا",129,"ج",2,0],["وقدت نارها تئزُّ فتغلي","أنفسٌ فوق جمرها وتخور",130,"ر",1,0],["وَقَد تعيد تماماً","يد الطَبيعة شملي",131,"ل",2,0],["وقد تقتل النفس في ذودها","وفكر التحرر لا يقتل",132,"ل",1,0],["وَقَد تسمع الأذنان جعجعةً له","ولا تشهد العينان عوضُ له طحنا",133,"ن",2,0],["وقد تطير إلى قبري مغردة","كأن تغريدها شعر لتأبيني",134,"ن",2,0],["وقد تصادم شمس","أُخرى فَيا للفَجيعه",135,"ع",2,0],["وَقَد تَموت فَتاة","وَلا تَموت عجوز",136,"ز",1,0],["وقد تحدث الأيّام عندك شيمةً","وتنعمر الأوقات وهي يباب",137,"ب",1,0],["وقد توالى العهاد منه لكم","وجادت المطرة التي تسم",138,"م",1,0],["وقد تبدّلها بالقوم غيرهم","لكي تجمّ رءوس القوم والقصر",139,"ر",1,0],["وَقَد تَلتَقي الأَشتاتُ بَعدَ تَفَرُّقٍ","وَقَد تُدرَكُ الحاجاتُ وَهيَ بَعيدُ",140,"د",1,0],["وقد تُرْجِعُ السَّهْمَ الأصَمَّ نَضِيُّهُ","فيَنْكُصُ عنها بَعْدَ ما هَمّ حابيا",141,"ي",2,0],["وقد تَعَوّضْتُ من كُلٍّ بمُشْبِهِهِ","فما وَجَدْتُ لأيّامِ الصِّبا عِوَضَا",142,"ض",2,0],["وقد تُرْضَي البَشاشَةُ وهْيَ خِبٌّ","ويُرْوَى بالتّعِلَّةِ وهْيَ آل",143,"ل",1,0],["وَقَدْ تَنْطِقُ الآثَارُ وَهْيَ صَوَامِتٌ","وَيُثْنِي بِرَيَّاهُ عَلَى الْوابِلِ الزَّهْرُ",144,"ر",1,0],["وَقَدْ تَخَلَّلَ خَيْطُ النُّورِ ظُلْمَتَهَا","كَمَا تَخَلَّلَ شَعْرَ اللَّمَّةِ الْوَخَطُ",145,"ط",1,0],["وَقَدْ تَلاقَى الشَّرْقُ والغَ","رْبُ بِهِ عَنْ أُمَمِ",146,"م",1,0],["وَقدْ تُسْتعَادُ بِهَا خِلَّةٌ","مُجَدَّدَةٌ مِنْ لِقاءٍ سَلفْ",147,"ف",1,0],["وَقَدْ تُرَى بَيْنَ الْوَرَى مِثْلَمَا","يُسْعِفُ غَرْقَى البَحْرِ حُرُّ مُجِيبْ",148,"ب",1,0],["وَقَدْ تَمَنَّوْا لَوْ دَنَوْا فظَفِروا","مِنْ يَدِهِ بِمَوْضِعِ التَّقْبِيلِ",149,"ل",1,0],["وقد تقرّأتُ ولا عهد لي","بالفسق منذ أكثر من شهر",150,"ر",1,0],["وَقَد تَركَبُ الخَيلَ العِتاقَ عَبيدُهُم","وَيَرضونَ حُبّاً لِلتَواضُعِ أَن يَمشوا",151,"ش",3,0],["وَقَد تَعَجَّبتُ إِذ دَهاني","عَيشٌ وَعِندي بِالمَوتِ عِلمُ",152,"م",1,0],["وقد تُفصحُ العَبَرَاتُ الغِزارُ","إذا أدرَك الناطقين الحَصَر",153,"ر",1,0],["وقد تكشف بارق ال","دُّستور عن ومْضِ السّراب",154,"ب",1,0],["وقد تعلم الغايات من بدآتها","وتظهر في أولى الأمور الأواخر",155,"ر",1,0],["وقدت إليها الجرد والنصر خافق","يرق عليها والملائك أعداد",156,"د",1,0],["وقَدَتْ به الشِّعْرَى فآ","لَفَتِ الخُدُودَ بها الهواجِرْ",157,"ر",1,0],["وقد تحدب فوق البحر يفحصه","كغادة وهى تلهو ضاع قرطاها",158,"ا",3,0],["وقد تفجَّر يُنبوعُ الجمالِ بها","عن كل معنىً بديعِ القصدِ مأثور",159,"ر",1,0],["وقد تَسيلُ دماء جَمَّة هَدَراً","وقد يُقَدَّرُ من دون الدماءِ دَم",160,"م",1,0],["وقد تَبوخُ على الأهمال مَوهِبةٌ","لو أُلْهِبَت لرأيتُم أيَّ بَركان",161,"ن",1,0],["وقد تتبَّعتُ أسلافي فما وقعتْ","عيني على غير مشغوفِ بدُنياء",162,"ا",2,0],["وقد تقسو ظروفٌ مُحوِجاتٌ","عليك وأنت وَهمُ بما ظنوا مُحِقُ",163,"ق",1,0],["وقد تفوت الرائين غرته","أعراس ليث العرين في أشبه",164,"ب",2,0],["وَقد تؤدّي عنكَ الرّسالةَ في الحبّ","فَتَأتيكَ دُرّةُ الصّدَفِ",165,"ف",1,0],["وَقَدْ تَعفُو الظّنُونُ بمنْ يُرَجّى","، فتُخْلَفُ مثلَ ما تَعفُو الطّلولُ",166,"ل",1,0],["وَقدْ تَقَصّيتُ عُذْرِي في التَّحمُّلِ لوْ","أحمَدْتُ غايَتهُ وَالحزْنَ لوْ نَفَعَا",167,"ع",2,0],["وَقَدْ تَرَكَ العبّاسُ عِندَكَ وَابْنُهُ","عُلا طلْنَ مرْمى النجمِ حيْثُ تحَيّرَا",168,"ر",2,0],["***وقد توّج البهو البهيّ بقيّة","ٍ فقلْ في عروسٍ في جلابيبها تُجلى",169,"ل",2,0],["وَقَدْ تَرَكَتْ مِرْادةُ خُندِفَ في يدي","جَماجمَ من قَيسٍ عِظاماً هُزُومُهَا",170,"م",3,0],["وقد تبدلت من بلواي عافية ً","قدماً بلطفكَ باباً غير مسدودِ",171,"د",1,0],["وَقَد تناهت يدي عَن كأسِها غَضَبًا","وَمَجَّت الأُذنُ أَيضاً نَغمَةَ الوَتَرِ",172,"ر",1,0],["وقد تَحْرُنُ أَحياناً","وتمشِي وحدَها تارَهْ",173,"ر",2,0],["وقدت عليكم بالمديحِ وكلكم","عليه كتابُ الله بالمَدْحِ وَافِدُ",174,"د",1,0]]}