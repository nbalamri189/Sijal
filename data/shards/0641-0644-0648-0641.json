{"poems":[[37,"شجا أظعان غاضرة الغوادي","https://www.aldiwan.net/poem39157.html","الوافر"],[23,"لمن منزل عاف كأن رسومه","https://www.aldiwan.net/poem21242.html","الطويل"],[53,"رمين فؤادي من عيون الوصاوص","https://www.aldiwan.net/poem64935.html","الطويل"],[47,"بودي لو يهوى العذول ويعشق","https://www.aldiwan.net/poem65199.html","الطويل"],[71,"وافى الكتاب الذي تعنو له الكتب","https://www.aldiwan.net/poem29125.html","البسيط"],[83,"طليق دموعي في الغرام مسلسل","https://www.aldiwan.net/poem61331.html","الطويل"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/141032",""],[173,"لقاؤك عامه يوم قصير","https://www.aldiwan.net/poem1672.html",""],[189,"عسى يدنيك يا بلدي إياب","https://www.aldiwan.net/poem14108.html","الوافر"],[234,"أعذلا وما عذلتني النهى","https://www.aldiwan.net/poem51276.html","المتقارب"],[275,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[287,"هنيئا أيها الملك المعظم","https://www.aldiwan.net/poem32628.html","الوافر"],[303,"أبى رق الحياة فمات حرا","https://www.aldiwan.net/poem36809.html","عموديه"],[369,"ألا من عذيري من جوى في الجوانح","https://www.aldiwan.net/poem60966.html","الطويل"],[398,"سرقت يا ظبي كتبي","https://www.aldiwan.net/poem53613.html","الطويل"],[411,"لا تعتبن ولا تخدعك بارقة","https://www.aldiwan.net/poem49860.html","البسيط"],[422,"أدار الكأس مترعة شرابا","https://www.aldiwan.net/poem54184.html","الوافر"],[466,"أود ولي من شيمة المجد عاصم","https://www.aldiwan.net/poem15146.html","الطويل"],[668,"","https://poetry.dctabudhabi.ae/diwan/poem/139019",""],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145826","الوافر"],[1177,"","https://poetry.dctabudhabi.ae/diwan/poem/28381","الوافر"],[1730,"","https://poetry.dctabudhabi.ae/diwan/poem/121892","الوافر"],[1738,"","https://poetry.dctabudhabi.ae/diwan/poem/124296","الطويل"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87327","الرجز"],[2799,"","https://poetry.dctabudhabi.ae/diwan/poem/121128","الطويل"],[3142,"","https://poetry.dctabudhabi.ae/diwan/poem/74142","البسيط"],[3296,"","https://poetry.dctabudhabi.ae/diwan/poem/105632","الوافر"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62740","الوافر"],[3537,"","https://poetry.dctabudhabi.ae/diwan/poem/26957","الوافر"],[3740,"","https://poetry.dctabudhabi.ae/diwan/poem/123600","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103037","الوافر"],[4361,"","https://poetry.dctabudhabi.ae/diwan/poem/145510","الطويل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66139","الوافر"],[4929,"قراءة دخانية","https://www.poetsgate.com/ViewPoem.aspx?id=207715",""],[5213,"سل السرب يوم الظعن ما فعل السرب","https://www.poetsgate.com/ViewPoem.aspx?id=170411",""],[5582,"سَرَتْ الحُدُوجُ يَزِينُها الأَفْزازُ","https://www.poetsgate.com/ViewPoem.aspx?id=187152",""],[5790,"خذوا حذركم من طرفها فهو ساحرُ","https://www.poetsgate.com/ViewPoem.aspx?id=111917",""],[5956,"هدير وهرير","https://www.poetsgate.com/ViewPoem.aspx?id=183250",""],[6093,"رَقِيْعٌ فَوْقَهَا أخرى رَقيعُ","https://www.poetsgate.com/ViewPoem.aspx?id=176147",""]],"verses":[["فَلو فودِيتَ مِن حَدَثِ المَنايا","وَقَيتُكَ بِالطَّريفِ وَبِالتِلادِ",0,"د",1,0],["فَلَو فَهِموا أَو وُفِّقوا رُشدَ أَمرِهِم","لَعُدنا عَلَيهِم بَعدَ بُؤسى بِأَنعُمِ",1,"م",1,0],["فلو فاخرتك الشمسُ أضحت ضئيلةً","لفخرِك مثلَ الكوكب المتخاوص",2,"ص",1,0],["فَلَو فَهِمَ النَاسُ التَلاقِي وَحُسنَهُ","لَحُبِّبَ مِن أَجلِ التَلاقي التَفَرُّقُ",3,"ق",1,0],["فلو فرشتُ سروراً وجنتيَّ له","لم أقضِ مِنْ حقِّهِ بعضَ الذي يجبُ",4,"ب",1,0],["فَلَو فَصَلُوا جَِسمِي لأسلُو جَمَالَهُ","صَبَرتُ لأنَّ الصَّبرَ للِصَّبّ أجمَلُ",5,"ل",1,0],["فلو فارقت نفسي إليك حياتها","لقلت أصابت غير مذمومة العهد",6,"د",1,0],["فَلَو في الخُلدِ كُنتُ وَلَم أُمَتَّع","بِقُربِكَ لَم يَلَذَّ لِيَ المُقامُ",7,"م",1,0],["فلو فَزِع الحمامُ لَهوْلِ شيءٍ","لأَفْزَعه لها ظُفُر وناب",8,"ب",1,0],["فلو فَدّتِ الحربُ قَرْماً إِذاً","لفدّتْك صارخةً بالعِدى",9,"ا",1,0],["فلو فطنّا لقابلنا قذائفَهم","بمثلِها وامتنعنا في صياصينا",10,"ن",2,0],["فَلَو في الحُسنِ ناظَرَهُ العَزيز ب","نُ يَعقوبَ اِستَكانَ لَهُ وَسَلَّم",11,"م",1,0],["فلو في كلِّ شعبٍ مثل (ماكٍ)","لما كانتْ خطوبُ القومِ تترى",12,"ر",2,0],["فلو فَرسَيْن اثنَيْنِ عن حاتمِ الندى","تَشفَّع إن لاعْبتُه لِعْبَ طارح",13,"ح",1,0],["فَلَو فَعَلتَ جَميلا","رَدَدتَ قَلبي وَكُتبي",14,"ي",1,0],["فلو فَليتَ جميعَ النَّاسِ قاطِبةٌ","وسِرتَ في الأرضِ أوساطاً وأطرافا",15,"ف",2,0],["فلو فاكهته لجنيت شهداً","ولو عاديته لشهدت صابا",16,"ب",2,0],["فلو فاه في يوم النزال بحجَّةٍ","لعادَ شباها وهو للجيش هازمُ",17,"م",1,0],["فلو فارسي الفن غامرك اغتدي","لنحوك يسعى وهو في زي راجل",18,"ل",1,0],["فلو في الأرض ِغيرُ الأرض ِكُنَّا","رَحلنا وَليكُنْ لِلاّمكَانِ",19,"ن",1,0],["فَلَو فَلَقَ التَلَهُّفُ قَلبَ حَيٍّ","لَهَمَّ القَلبُ مِنّي بِانفِلاقِ",20,"ق",1,0],["فلو فلق الفؤاد شديد وجد","لهم سواد قلبي بانفلاق",21,"ق",1,0],["فلو فقدت كل الدواوين وامّحَت","لكان بدين اللّه أكمل قائم",22,"م",1,0],["فُلوفاسَلاَرُ وَهُوَ في الحُقَّه","على الحِمَارَينِ بِلاَ مَشَقَّه",23,"ه",1,0],["فلو فتشوا عن هيكل الطهر أحمد","لقوا وجهه مما فعلت بهم يندا",24,"د",2,0],["فلّ وَفاكِهة فوارة هملت","في فيء فرع وَفتيان وَفنجان",25,"ن",1,0],["فلو فتشتني لوجدت مني","أخاً براً لدى الجلي وصولا",26,"ل",2,1],["فلو في القَيظِ جِئتُكِ رَهنَ عَشْرٍ","لما ألقيتُ في الهِرْماسِ شَنّي",27,"ن",2,0],["فَلَو فاحَت لِأَصبَحنا هُروباً","فُرادى بِالفَلا ما نَستَريحُ",28,"ح",1,0],["فلو فَوَّقتَ سهمَ المنون جفونُه","لقلبٍ سوى قلبي تمنَّيتُه قلبي",29,"ب",2,0],["فلو فدت العلى قوماً لكانت","لهم يوم المنية خير فاد",30,"د",1,0],["فلو فاخر السيف المصمم رأيه","لعاد وحد السيف خزيان مطرق",31,"ق",1,0],["فَلَوْ فُرِشَتْ ليَ الغَبْراءُ دُرا","ولم أَشْمَخْ بأَنْفِي ما مَشَيْتُ",32,"ت",1,0],["فلو فُلك نوحٍ أدركتَها لما نَجَتْ","من القصف أو تابوتُ موسى لبُعثِرَا",33,"ر",2,0],["فلو فاخرت فيها السماء وبدرها ال","بسيطة كان الفخر للأرض والغلب",34,"ب",1,0],["فَلِوَفْدِهِ يَهَبُ الجِيادَ شَوازِباً","قُبَّ المُتُونِ وَلِلْعِدَى لَهَّازُ",35,"ز",1,0],["فلو في الكرى مر النسيم بطيفها","سرى أبدا من طيبها وهو عاطر",36,"ر",1,0],["فلو في اللُجِّ كنت لكان حالي","كأني بين أنياب الذِّئابِ",37,"ب",1,0],["فلوْ في القَبْر إخمادٌ لذكرٍ","أجيبوني بمن مُلئَ (البَقيعُ )؟",38,"ع",1,0]]}