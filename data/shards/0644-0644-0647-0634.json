{"poems":[[55,"جري النسيم على ماء العناقيد","https://www.aldiwan.net/poem30625.html","البسيط"],[53,"أجنت لك الوجد أغصان وكثبان","https://www.aldiwan.net/poem66376.html","البسيط"],[82,"لله شمس كان أولها السها","https://www.aldiwan.net/poem31264.html","الكامل"],[69,"إن تحي آمالي برؤية عيسى","https://www.aldiwan.net/poem18073.html","الكامل"],[50,"صبح فضل ظاهر التيه","https://www.aldiwan.net/poem66197.html","السريع"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85406","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55524","المجتث"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[108,"لله شعرك!","https://www.poetsgate.com/ViewPoem.aspx?id=179701",""],[202,"لله شهر ما انتظرت هلاله","https://www.aldiwan.net/poem51884.html","الكامل"],[519,"ما بال وتر صلاتكم لا يشفع","https://www.aldiwan.net/poem20809.html","الكامل"],[567,"لك الهناء بما أوتيت معتذرا","https://www.aldiwan.net/poem52962.html","البسيط"],[633,"","https://poetry.dctabudhabi.ae/diwan/poem/53756","البسيط"],[757,"","https://poetry.dctabudhabi.ae/diwan/poem/132458","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38313","السريع"],[1067,"","https://poetry.dctabudhabi.ae/diwan/poem/138064",""],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202075","الكامل"],[1206,"","https://poetry.dctabudhabi.ae/diwan/poem/143131","الكامل"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11887","السريع"],[1553,"","https://poetry.dctabudhabi.ae/diwan/poem/144597","البسيط"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141259","الكامل"],[2321,"","https://poetry.dctabudhabi.ae/diwan/poem/147009","الكامل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67200","الكامل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87789","الكامل"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102504","البسيط"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/130011","الكامل"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129856","الكامل"],[2757,"","https://poetry.dctabudhabi.ae/diwan/poem/83214","المتدارك"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93975","البسيط"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100273","الكامل"],[2926,"","https://poetry.dctabudhabi.ae/diwan/poem/100484","الكامل"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65103","الكامل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127036","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103057","الكامل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35492","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70062","البسيط"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69987","البسيط"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69912","الوافر"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70149","الكامل"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125875","البسيط"],[4165,"","https://poetry.dctabudhabi.ae/diwan/poem/97092","الكامل"],[4291,"","https://poetry.dctabudhabi.ae/diwan/poem/142466","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73250","الكامل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83582","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133155","المجتث"],[4935,"روض الهنا أزهى المنى أوراده","https://www.poetsgate.com/ViewPoem.aspx?id=129388",""],[4980,"أشتاق","https://www.poetsgate.com/ViewPoem.aspx?id=191690",""],[4980,"أبلغ حبيبًا بدمع العين متعته","https://www.poetsgate.com/ViewPoem.aspx?id=195043",""],[307,"متى نعود أيا بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=213657",""],[5497,"أصبو إلى ما مضى","https://www.poetsgate.com/ViewPoem.aspx?id=206791",""],[5790,"لله شبارة حوت ملكا","https://www.poetsgate.com/ViewPoem.aspx?id=112060",""],[5190,"يا رائعَ النَّفَحاتِ عُد مُتَفَضِّلا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85081&r=&rc=156",""]],"verses":[["لِلَّهِ شَمسُ عُلىً جاءَت بِجَوهَرَةٍ","غَرّاءَ عَن قَمَرٍ بِالمَجدِ مَسعودِ",0,"د",1,0],["للِّهِ شيبانُ قوماً لا يشيبهمُ","روع إذا الروعُ شابتْ منه وِلْدان",1,"ن",1,0],["للّه شمسٌ كانَ أولها السّها","كَحَلَ الظلامُ بنورها أجفاني",2,"ن",2,1],["للَّهِ شَمْسُ الدِّينِ شَمْسٌ أَطلَعَت","فينا بُدُوراً لِلْهُدَى وَشُمُوسا",3,"س",2,0],["لِلَّهِ شِعري أَيُّ مُفواهَةٍ","لِكُلِّ مَن دوني قَوافيهِ",4,"ي",2,0],["لِلَّه شيبٌ أَحبوا الموت من أَسف","عَلى بنيهم وَشبانٌ قد اخترموا",5,"م",3,0],["للهِ شَعْبُكِ يَغْزُو","حَقّاً وَيُحْكِمُ زَحْفَهْ",6,"ف",2,0],["لِلهِ شَوْقِي سَاجِياً أَوْ ثَائِراً","كَاللَّيْثِ وَالْبُرْكَانِ وَالدَّأْمَاءِ",7,"ا",2,0],["لِلهِ شَوْقِي فِي طَرَائِقِ أَخْذِهِ","بِطَرَائِفِ الأَحْوَالِ وَالأَشْيَاءِ",7,"ا",2,0],["لله شعرُك! إِنه","لَمِنَ العُروبةِ في الصميم",8,"م",1,0],["لله شهرٌ ما انتظرتُ هلالَهُ","إلا كنونٍ أو كعطفة لام",9,"م",1,1],["للّهِ شُعلةُ بارِقٍ لا تَنطَفي","في راحتَيْهِ وديمةٌ لا تُقلِعُ",10,"ع",1,0],["للهِ شمسُ جَمالٍ أدرَكَتْ قمراً","والشمسُ لا ينبغي أن تُدرِكَ القمَرا",11,"ر",2,0],["للّه شَمْلُ جميعٍ كان مُلتئماً","أَضحى لِيَومِ سَعِيد وَهْو مُنْتَشِرُ",12,"ر",1,0],["لله شمسُ ضحى في اللحد قد غربت","فأعقبت قمراً بالسعد قد طلعا",13,"ع",2,0],["للَّهِ شادَ سَلسبيلاً لَنا","بِمائِهِ العَذبِ شِفاءُ السّقامْ",14,"م",1,0],["لله شيخ عزيز في عشيرته","يساق في سوقهم بالذل والنكب",15,"ب",1,0],["لله شأنٌ فيك جدّ مُعَظَّم","قامت بهِ الأعلامُ للمُتدَبر",16,"ر",1,0],["لله شمس للوزارة أشرقت","بالشوق يختطف النواظر نورها",17,"ر",3,0],["لِلَّهِ شِبلا أَسَدٍ خادِرٍ","ما فيهِما جُبنٌ وَلا شُحُّ",18,"ح",1,1],["لله شكري وللسلطان خالصتي","وللعفاة الجنى المعسول في كنف",19,"ف",1,0],["لله شبّان المحيدثة الأولى","صعدوا إلى أوج العلاء وحلّقوا",20,"ق",3,0],["لله شهمٌ قد تسامى سوددا","وغدا هماماً بالمكارم منجدا",21,"ا",1,1],["لله شَهرٌ ليسَ يُجلى كربُه","عنَّا مدى عُمر الليالي سَرمدا",22,"د",2,0],["لِلّه شاكر أَي صَبّ","مِنكَ بِالعَليا شُعافه",23,"ف",2,0],["لِلّه شيء من فيض فضل","أنا ضعيف فلاطفوني",24,"ن",2,0],["لِلّه شيء من ديم جود","أنا فقير فاسعدوني",24,"ن",2,0],["لِلّه شيء من عين كرم","أنا سقيم فارحموني",24,"ن",2,0],["لِلّه شيء من عطف لطف","أنا بعيد فقرّبوني",24,"ن",2,0],["لِلّه شيء من برد وصل","أنا معيب فاقبلوني",24,"ن",2,0],["لِلّه شيء من سبل ستر","أنا مقلّ فاستروني",24,"ن",2,0],["لِلّه شيء من حسن نظر","بعين رحمتكم انظروني",24,"ن",2,0],["للّه شيعَتُك التي ترى العدا","أقداحَهُم بمواطىءِ الأقدامِ",25,"م",1,0],["للّه شوقي إن هفته","من نحو أرضهمُ الرياح",26,"ح",1,0],["لِلَهِ شَبيبَتُنا نَهَضَت","تَبني مَجداً فَوقَ القِنَنِ",27,"ن",1,0],["للَه شاد رخيم الصوت همت به","وفيه طابت أويقاتي وأحياني",28,"ي",1,1],["للَه شهر محرم فلقد","فيه استحلّوا حمرة الصمد",29,"د",1,0],["للَه شمعته التي ما أسفرت","إلا توارت في الحجاب ذكاء",30,"ا",2,0],["لله شرح للامير مُوضّحٍ","لم يتّصف بصعوبة التّلويح",31,"ح",1,1],["للّه شبل علي وهو منفرد","ما بين أرجاس حرب عاد حيرانا",32,"ن",2,0],["للَه شيمتك التي جعلت","للمجد بيت قصيدة الكرم",33,"م",1,0],["لِله شاهِنشاه عَزمتك الَّتي","تَرَكت لَكَ الغَرض البَعيد قَريبا",34,"ب",2,0],["لِلّهِ شُكري نَجيبٌ كَالهِلالِ بَدا","وَدار يوسف باستهلالِهِ لَمعت",35,"ت",1,1],["لِلّه شَهمٌ نَبيلٌ قَد كلفتُ بِهِ","حُلوَ الشَمائل أَرضيهِ وَيَرضيني",36,"ن",2,1],["لِلّهِ شَهمٌ تناجيني مَفاخره","حِّث عَن البَحر مَهما جئتَ تَختارُ",37,"ر",1,0],["لِلّهِ شهمٌ بديعٌ في مَآثرِهِ","لا عَيب فيهِ سوى التَنفيس للكربِ",38,"ب",1,0],["لله شعرك السلسال منسجم","منه على الروح والإحساس تسنيم",39,"م",1,0],["للَه شهر ما استهلت مقلتي","لهلاله إلا استهل العندم",40,"م",1,0],["للهِ شِدْتَ وما تَشيدُ وفي غَدٍ","يُهدى إِليكَ مِنَ الإِلَهِ جَزَاءُ",41,"ا",2,0],["للهِ شعرُكَ يا بليغُ فإِنَّني","نَزَّهتُ طرفي في رياضِ بديعهِ",42,"ع",2,1],["لِلَّهِ شَكوايَ من عُجمٍ وَمن عرب","ضَلّوا السَبيلَ فَباءَ الكُلُّ بِالنُّوَبِ",43,"ب",1,1],["لله شادن أغن","أحوم حريري البدن",44,"ن",1,0],["لله شبل طاهر نسبته","عزت بهه وأحرزت إمداده",45,"د",2,0],["لله شوقٌ لِمَن بالقلب مسكنهُ","لكنَّ سُكنَاهُ بُعد النَّجمِ من قُربِي",46,"ب",2,0],["للهِ شوقٌ تُذيبُ العينَ هَبَّتُهُ","يُعلي فؤادًا تهاوى النارَ والحِمَمَا",47,"م",2,0],["لله شدّ رحالاً غير مكترثٍ","حتّى تعالى بذاك العزّ قربانا",48,"ن",2,0],["لله شكوايَ كم أمسيت مكتئبا","ولذة النوم للأجفان لم تلجِ",49,"ج",1,0],["لله شبارة حوت ملكا","كأنما الأرض في يديه كره",50,"ه",1,1],["للهِ شهرٌ كالنسيمِ طراوةً","غَمَرَ القلوبَ بنورِهِ مُتَفَضِّلا",51,"ل",2,0]]}