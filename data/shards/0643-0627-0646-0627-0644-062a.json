{"poems":[[65,"أغض جماح الوجد بين الجوانح","https://www.aldiwan.net/poem45724.html","الطويل"],[75,"إني ذكرتك بازهراء مشتاقا","https://www.aldiwan.net/poem11858.html","البسيط"],[0,"لعمرك ما قلبي إلى أهله بحر","https://www.aldiwan.net/poem63.html",""],[90,"خليلي قوما بي لنشهد للربا","https://www.aldiwan.net/poem44422.html","الطويل"],[29,"غدا باجتماع الحي نقضي لبانة","https://www.aldiwan.net/poem5735.html","الطويل"],[29,"أتنسى يوم حومل والدخول","https://www.aldiwan.net/poem5965.html","الوافر"],[39,"وحديثهن إذا التقين","https://www.aldiwan.net/poem7178.html","مجزوء الكامل"],[74,"أجبت منادي الحب من قبل ما دعا","https://www.aldiwan.net/poem19162.html","الطويل"],[18,"أليلتنا بذي حسم أنيري","https://www.aldiwan.net/poem23949.html","الوافر"],[54,"ألا حي من أهل المحبة منزلا","https://www.aldiwan.net/poem26719.html","الطويل"],[52,"مللت مبيتي بالقرين وشاقني","https://www.aldiwan.net/poem63905.html","الطويل"],[7,"لعمرك ما خشيت على يزيد","https://www.aldiwan.net/poem1961.html","الوافر"],[48,"تنازع في الدنيا سواك وما له","https://www.aldiwan.net/poem23569.html","الطويل"],[78,"كأن التي يوم الوداع تعرضت","https://www.aldiwan.net/poem38990.html","الطويل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/125571","الكامل"],[30,"","https://poetry.dctabudhabi.ae/diwan/poem/8027","الطويل"],[169,"نأت سلمى وأمست في عدو","https://www.aldiwan.net/poem719.html",""],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[240,"دويت بغيظ صدورها الحساد","https://www.aldiwan.net/poem32102.html","الكامل"],[287,"دعا مهجة الصب لا تردعاها","https://www.aldiwan.net/poem32310.html","المتقارب"],[297,"ألا من لنفس لا تؤدي حقوقها","https://www.aldiwan.net/poem441.html",""],[310,"هذا المصير وكل نفس ذائقه","https://www.aldiwan.net/poem56444.html","الكامل"],[325,"كان التنقل في الغرام يلذ لي","https://www.aldiwan.net/poem61736.html","الكامل"],[327,"آذن اليوم جيرتي بارتحال","https://www.aldiwan.net/poem56350.html","الخفيف"],[401,"إن امرأً مولاه أدنى داره","https://www.aldiwan.net/poem567.html",""],[416,"كأن التي يوم الرحيل تعرضت","https://www.aldiwan.net/poem67479.html","الطويل"],[422,"متى لاح رسم الدار من طلل قفر","https://www.aldiwan.net/poem54144.html","الطويل"],[454,"إن العروبة بالإسلام عزتها","https://www.aldiwan.net/poem996.html",""],[567,"يا أيها القبر فيك الناس قد رقدوا","https://www.aldiwan.net/poem52822.html","البسيط"],[591,"قد كان ما علم اللاحي وما جهلا","https://www.aldiwan.net/poem17661.html","البسيط"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126891","الكامل"],[659,"","https://poetry.dctabudhabi.ae/diwan/poem/76572","الكامل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101534","الطويل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145893","المتقارب"],[1175,"","https://poetry.dctabudhabi.ae/diwan/poem/67741","الوافر"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64972","البسيط"],[1710,"","https://poetry.dctabudhabi.ae/diwan/poem/49579","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27567","البسيط"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45727","الطويل"],[2678,"","https://poetry.dctabudhabi.ae/diwan/poem/137398",""],[2791,"","https://poetry.dctabudhabi.ae/diwan/poem/65970","الطويل"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87434","الطويل"],[3569,"","https://poetry.dctabudhabi.ae/diwan/poem/105816","الطويل"],[3874,"","https://poetry.dctabudhabi.ae/diwan/poem/2574","البسيط"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70138","الكامل"],[4141,"","https://poetry.dctabudhabi.ae/diwan/poem/146740","الوافر"],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54413","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120357","الكامل"],[4717,"كفيفٌ في الصحاري من يقوده","https://www.poetsgate.com/ViewPoem.aspx?id=204367",""],[416,"كأنَّ التي يَوْمَ الرّحِيل تَعَرَّضَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=22392",""],[4869,"البارحه يوم الخلايق نياما","https://www.poetsgate.com/ViewPoem.aspx?id=137914",""],[4869,"الحشيمه","https://www.poetsgate.com/ViewPoem.aspx?id=151642",""],[4045,"لئن حبس المشيب عنان لهوي","https://www.poetsgate.com/ViewPoem.aspx?id=200298",""],[5294,"أصاحبك وأحبك بالقوي","https://www.poetsgate.com/ViewPoem.aspx?id=95115",""],[5561,"ومضة شوق","https://www.poetsgate.com/ViewPoem.aspx?id=193806",""],[5992,"كأنَّ بروقَ الجوّ في حجراتِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=41847",""],[6148,"رحيل","https://www.poetsgate.com/ViewPoem.aspx?id=201621",""],[5309,"كان التلذذ بالأوهام مسرايا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573816",""],[4983,"أسرى بها الحبُّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82961&r=&rc=1",""]],"verses":[["كَأَنَّ التِوائي مِن جَوىً وَصَبابَةٍ","تَرَنُّحُ نَشوانٍ مِنَ السُّكرِ طافِحِ",0,"ح",1,0],["كانَ التَجارِي بِمَحضِ الوُدِّ مُذ زَمَنٍ","مَيدانَ أُنسٍ جَرَينا فيهِ أَطلاقا",1,"ق",2,0],["كَأَنَّ التُجارَ أُصعِدوا بِسَبيئَةٍ","مِنَ الخِصِّ حَتّى أَنزَلوها عَلى يَسَر",2,"ر",1,0],["كأنّ التفاف الدوح بينها","جيوب من الأنوار زرًت بأزرار",3,"ر",1,0],["كَأَنَّ الَّتي يَدعونَ جِعثَنَ وَرَّكَت","عَلى فالِجٍ مِن بُختِ كَرمانَ أَحرَدا",4,"د",2,0],["كَأَنَّ التَيمَ وَسطَ بَني تَميمٍ","خَصيٌّ بَينَ أَحصِنَةٍ فُحولِ",5,"ل",1,0],["كَأَنَّ التَيمَ إِذ فَخَرَت بِسَعدٍ","إِماءُ الحَيِّ تَفخَرُ بِالحُمولِ",5,"ل",1,0],["كان التهللُ بالتبس","م لا القهاقه بالقراقرْ",6,"ر",1,0],["كأن التلاقي كان وفراً تسرعت","أيادي ابن شادٍ فيه حتى تضعضعا",7,"ع",2,0],["كَأَنَّ التابِعَ المِسكينَ فيها","أَجيرٌ في حُداباتِ الوَقيرِ",8,"ر",1,0],["كَأَنَّ التَصابي كانَ تَعريسَ نازِلٍ","ثَوى ساعَةً مِن لَيلِهِ وَتَرَحَّلا",9,"ل",2,0],["كَأَنَّ الَّتي تَمري فُؤادي بِحُبِّها","مَرِيَّةُ نَطفِ البابِلِيِّ المُعانِدِ",10,"د",1,0],["كَأَنَّ التاجَ مَعصوباً عَلَيهِ","لِأَذوادٍ أُصِبنَ بِذي أَبانِ",11,"ن",1,0],["كَأَنَّ الَّتي في الكَأسِ يَطفو حَبابُها","سِمامُ حُبابٍ بَينَ مُرتَشِفيها",12,"ي",3,0],["كأنَّ التي يومَ الوداعِ تَعرَّضَتْ","هِلالٌ بَدا مَحْقاً على أنَّهُ تِمُّ",13,"م",1,1],["كان التلاقي بيننا كَفَّارةً","للدهر عن آثامِه لِيَتوبا",14,"ب",2,0],["كَأَنَّ الَّتي يَومَ الرَحيلِ تَعَرَّضَت","لَنا ظَبيَةٌ تَحنو عَلى رَشَإٍ طِفلِ",15,"ل",1,1],["كأن التاج معقود عليهم","إذا وردت لقاحهم شزابا",16,"ب",2,0],["كانَ التَعَبُّدُ دَأبَهُ لِلَّهِ مِن","قَبلِ النُّبَوَّةِ لَيسَ عَنهُ بِوانِ",17,"ن",1,0],["كانَ التَأَخُّرُ عوذَةً لِعُلاكَ مِن","نَظَرٍ تَشِفُّ وَرائَهُ الأَحقادُ",18,"د",1,0],["كَأَنَّ التَرائِكَ وَسطَ العَجاجِ","وَلا شَمسَ تَبدو شُموسٌ تراها",19,"ا",3,0],["كَأَنَّ التَميمَ البيضَ في كَورِ صَفوِها","إِذا شِمتَها وَالشَمسُ بادٍ شُروقُها",20,"ق",3,0],["كانَ التواضعُ خُلقهُ والبرّ بال","مَخلوقِ لا سيما الموالي خالِقَه",21,"ق",2,0],["كانَ التَنَقُّلُ في الغَرامِ يَلُذُّ لي","بَينَ الحِسانِ وَكُلُّ ظَبيٍ أَكحَلِ",22,"ل",1,1],["كَأَنَّ التَرعيبَ فيها عَذارى","خالِصاتُ الأَلوانِ إِلفُ الحِجالِ",23,"ل",1,0],["كانَ التفرقُ بَينَنا مِن مِئرَةٍ","فاذهَب إِليك فقَد شفيتَ فُؤادي",24,"د",2,0],["كَأَنَّ الَّتي يَومَ الرَحيل تَعَرَّضَت","لَنا مِن ظِباءِ الرَملِ أَدماءُ مُعزِلُ",25,"ل",1,1],["كأَنَّ التهاب البرق يُبرِزُ لوعتي","ويُبْرِزُ للأَبصار ما كانَ في صدري",26,"ر",2,0],["كان التفاخر بالأنساب رائدهم","في كل ناد فماذا حقق النسب",27,"ب",1,0],["كانُ التُّقى والنَّقا والحِلمُ مُجتمِعاً","في شَخصِهِ واصطناعُ الخَيرِ والرَشَدِ",28,"د",1,0],["كَانَ التَّكَتُّمُ يُرْجَى قَبلَ بَيْنِكُمُ","أَمَّا وَقَدْ حَكَمَتْ أَيْدِي الفِرَاقِ فَلا",29,"ل",2,0],["كانَ التقيّ وكان في أيّامه","لبني الهداية معقل وأمانُ",30,"ن",1,0],["كانَ التَسَتُّرُ في هَواكَ مُرادَهُ","فَأَبى عِذارُكَ غَيرَ خَلعِ عِذارِهِ",31,"ر",2,0],["كأنَّ التواءُ الماءِ يسقي نباتها","أفاعٍ من البلَّور روَّعها امرُ",32,"ر",1,0],["كأن َّالترابَ الذي في الدروب","حِرَابٌ أدوسُ عليهِ احترابَا",33,"ب",2,0],["كَأنَّ التَّاجَ تَاجَ بَنِي هِرَقْلٍ","جَلَوْهُ لأعْظَمِ الأيَّامِ عِيدَا",34,"د",2,0],["كانَ التَّغَزُّلُ بِالغِزْلانِ يُفْقِرُني","واليَومَ مَدْحُ ابْنِ مُعِزِّ الدّينِ يُغْنيني",35,"ن",2,0],["كأنّ التماعَ البرقِ في جَنَبَاتِها","مصابيحُ تُذْكَى أوْ صوارمُ تُسْتَل",36,"ل",1,0],["كان التولي له من أصلِ نشأته","فمن تولَّى تولَّته أباطله",37,"ل",2,0],["كَأَنَّ الَّتي حَول المَجَرة أَورَدَت","لَتَكرع في ماءٍ هُناكَ صَبيب",38,"ب",1,1],["كأن التهاني عاشق شفه الهوى","لمصر فوافى يجتلى حسن بدره",39,"ر",2,0],["كأن التهاب الجمر ابراق حليها","إذا جعدها عن حليها يتكشف",40,"ف",1,0],["كأن التفات الظبي يحكي التفاتها","إذا التفتت والجعد منها مغلف",40,"ف",1,0],["كأنَّ التناءي مُستَعيرٌ من اللقا","بِهِ قِصَرٌ وَذَلِكَ طولُ",41,"ل",1,0],["كأنَّ التماعَ البرق في ظُلماته","هدىً في ضلالٍ يبتدي ثم يختفي",42,"ف",2,0],["كانَ التَبابِعُ في دَهرٍ لَهُم سَلَفٌ","وَاِبنُ المُرارِ وَأَملاكٌ عَلى الشامِ",43,"م",1,1],["كانَ التَلاقي بمضمارِ السباق يَرى","في موقف الهول بين الحربِ وَالحَربِ",44,"ب",1,0],["كأن الترك فوقهمُ صقور","وهم من فرط خوفهمُ حبارى",45,"ر",2,0],["كان التعرُّضُ لي بنصحكَ نافعي","لو كانَ يمكنُ للسُّلوِّ تعرُّضي",46,"ض",2,0],["كان التلاقي بيننا واحسرتي","كجريعة العصفور بان بزاته",47,"ت",2,0],["كأنَّ (التيه) خارطةٌ .. ويَسعَى","فيلقَى فيه ما لاقتْ (يهوده)",48,"د",2,0],["كأنَّ التي يَوْمَ الرّحِيل تَعَرَّضَتْ","لَنا مِنْ ظَباءِ الرَّمْلِ أدْمَاءُ مُغْزِلُ",49,"ل",1,1],["كان التوجد بعد شهْر الصياما","على الذي في ثاني العيد مدفون",50,"ن",1,0],["كان التنافس لك على وجه الابداع","وكل الدروب اللي تبي مستقيه",51,"ه",1,0],["كأن التاج معصوب برأسى","أحيّا فوق أرواح السرير",52,"ر",1,0],["كان التاني يزعل م الأولاني لو هزر بالقوي","أصاحبك وأحبك بالقوي",53,"و",2,0],["كان التفاخر في الأحساب ميزتنا","والناس يشغلهم عن ربهم جور",54,"ر",1,0],["كأنَّ التي حولَ المجرَّةِ أنيقٌ","أقامَ بها الحادون حولَ مناهلِ",55,"ل",1,0],["كان التداني للتجافي بلسما","فلقد بليت بجفوة وبعاد",56,"د",1,0],["كانَ التَّلذُّذُ بِالأًوهامِ مَسرايا","فَأَظهَرَ البَحثُ ما أَخفَتهُ دُنيايا",57,"ا",3,1],["كان التشهي وليل الحب من غرق","ترفضُّ عن موجه العاتي موانيه",58,"ي",2,0]]}