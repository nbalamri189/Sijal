{"poems":[[47,"يعز على الأحبة بالشآم","https://www.aldiwan.net/poem25139.html","الوافر"],[47,"إذا شئت أن تلقى أسودا قساورا","https://www.aldiwan.net/poem25273.html","الطويل"],[45,"وعالمة وقد جهلت دوائي","https://www.aldiwan.net/poem10211.html","الوافر"],[46,"كأنني راكب اللج الذي عصفت","https://www.aldiwan.net/poem22261.html","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55168","الطويل"],[46,"كأنّني راكبُ اللُّجّ، الذي عصفَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=18250",""],[133,"تجاوز قدر الذم ذا الفاسق الغوي","https://www.aldiwan.net/poem54649.html","الطويل"],[136,"سعى بالكاس مخضوب البنان","https://www.aldiwan.net/poem48995.html","الوافر"],[187,"ليالي الصبا درت عليك السحائب","https://www.aldiwan.net/poem44142.html","الطويل"],[224,"حلمت بدنيا ليتها لا تبدد","https://www.aldiwan.net/poem41601.html","الطويل"],[224,"كعاب أتت في الحسن فخر الكواعب","https://www.aldiwan.net/poem41907.html","الطويل"],[271,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[305,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[350,"أراني البعض في بعضي","https://www.aldiwan.net/poem15758.html","الهزج"],[354,"رياض الهنا باليمن فاحت ورودها","https://www.aldiwan.net/poem40398.html","الطويل"],[401,"مواكب خير ، موكب إثرموكب","https://www.aldiwan.net/poem4595.html","عموديه"],[401,"إيقاعات على نيل مصر","https://www.aldiwan.net/poem6726.html","عموديه"],[404,"وأما شيوخي في العلوم فإنهم","https://www.aldiwan.net/poem33941.html","الطويل"],[404,"أما آن عما أنت فيه متاب","https://www.aldiwan.net/poem34163.html","الطويل"],[417,"شديد ما أضر بها الغرام","https://www.aldiwan.net/poem54005.html","الوافر"],[417,"أدار على الندمان كأس عقاره","https://www.aldiwan.net/poem54057.html","الطويل"],[440,"لك الخير قد أوفى بعهدك خيران","https://www.aldiwan.net/poem34887.html","الطويل"],[442,"إلى كم أرقع الدنيا","https://www.aldiwan.net/poem14389.html","مجزوء الوافر"],[453,"أتت أسماء ساحبة رداها","https://www.aldiwan.net/poem13950.html","الوافر"],[478,"أغار إذا وصفتك من لساني","https://www.aldiwan.net/poem16190.html","الوافر"],[530,"نظام يحاكي الدر أهدته نحونا","https://www.aldiwan.net/poem37082.html","الطويل"],[562,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"]],"verses":[["وَفي طَلَبِ الثَناءِ مَضى بُجَيرٌ","وَجادَ بِنَفسِهِ كَعبُ بنُ مامِ",0,"م",1,0],["وَفي طَيِّئٍ لَمّا أَثارَت سُيوفُهُ","كُماتُهُمُ مَرأىً لِمَن كانَ مُبصِرا",1,"ر",2,0],["وَفي طَيفِ الخَيالِ شِفا المُعَنّى","وَرِيُّ الصادِياتِ مِنَ الظَماءِ",2,"ا",2,0],["وَفي طِباعِكَ زَيغٌ وَالهِلالُ عَلى","سُمُوِّهِ حِلفُ تَقويسٍ وَتَعويجِ",3,"ج",1,0],["وَفِي طَيِّبِ الرِّزْقِ الَّذِي هُوَ كَاسِبٌ","زَكَاتَانِ مِنْ لُطْفِ الإِشارَةِ وَالبَذْلِ",4,"ل",1,0],["وفي طِباعِكَ زَيْغٌ، والهلالُ، على","سُمُوّهِ، حِلْفُ تقويسٍ وتعوج",5,"ج",1,0],["وفي طاعة الشيطان أفنى شبابَه","على أنه عن طاعة الله يَنزوي",6,"و",2,0],["وفي طيّ اللسانِ كما روينا","عُلاَ الإنسان لا في الطيلسانِ",7,"ن",1,0],["وفي طيّ هذا الدهر كل عجيبة","فمن عاش لافته النهى والعجائب",8,"ب",1,0],["وَفي طَبَق وادٍ تكدَّر ماؤُهُ","فَلا عشبَة تَنمو وَلا غُصنَ يُنقَدُ",9,"د",1,0],["وَفي طرف الأَجفانِ سُلَّت مَضارِبٌ","تَقوم عَلى أَحداقِها كَالمَضارِب",10,"ب",1,0],["وفي طرابلس الغرب استجدَّ لنا","وَجدٌ قديمٌ وقد ضاعت أمانينا",11,"ن",2,0],["وفي طي هذا سر علم محجب","له يهتدي أهل القلوب المنيرة",12,"ه",1,0],["وَفي طولي بَدا عُمقِ","يَ بَينَ الناسِ في عَرضي",13,"ي",1,0],["وَفي طالع الأَفراح مِن أُفق الهَنا","بَدا بَدرُ آفاق العُلى وَسَعيدها",14,"د",3,0],["وفي طيبةِ الهادي البشير لها يدٌ","تمدُّ بريحانٍ إلى المتطيِّبِ",15,"ب",1,0],["وفي طيبةِ المصطفى روضةٌ","بها القلب عن غيرها يُشْغَلُ",16,"ل",1,0],["وفي طيبة الفيحاء شيوخي ومكة","شيوخ علومي في الحديث المحمدي",17,"د",2,0],["وفي طيٍّ أثناء المثاني نفائسٌ","يطيب لها نَشْرٌ ويفتح باب",18,"ب",1,0],["وفي طيِّ الجوانح لو نَشَرْنا","بها المطويَّ طال لنا كلام",19,"م",1,0],["وفي طرفه للسكر ما في يمينه","فكلتاهما من خمرِهِ واختماره",20,"ر",2,0],["وفِي طَيِّ أَسْمَالِ الغَرِيبِ غَرَائِبٌ","سَكَنَّ شَغافَ القلبِ شيبٌ وَوِلْدانُ",21,"ن",1,0],["وفي طاعتك اللَهم","م بالإخلاص تبقيني",22,"ن",2,0],["وفي طَرَفِ الخباءِ ليوثُ حَرْبٍ","تدورُ عليهمُ أبَداً رَحَاها",23,"ا",3,0],["وَفي طَي الطُروس لَهُ رِياض","سَقاها الفَضل أَنواع المَعاني",24,"ن",2,0],["وفي طَيِّهِ بَحْثٌ يَدِقُّ بَيانُهُ","إذا رامَهُ فِكْرُ البَيانِيِّ والنَّحْوِي",25,"و",2,0],["وَفي طِراقِ البيضِ يُوقدنَ الشَرَر","صَقعاً إِذا ما رَنَّحَ الطَرفَ اِسمَدَر",26,"ر",1,0]]}