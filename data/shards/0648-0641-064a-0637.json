{"poems":[[49,"يعز على الأحبة بالشآم","https://www.aldiwan.net/poem25139.html","الوافر"],[49,"إذا شئت أن تلقى أسودا قساورا","https://www.aldiwan.net/poem25273.html","الطويل"],[47,"وعالمة وقد جهلت دوائي","https://www.aldiwan.net/poem10211.html","الوافر"],[48,"كأنني راكب اللج الذي عصفت","https://www.aldiwan.net/poem22261.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55168","الطويل"],[48,"كأنّني راكبُ اللُّجّ، الذي عصفَتْ","https://www.poetsgate.com/ViewPoem.aspx?id=18250",""],[136,"تجاوز قدر الذم ذا الفاسق الغوي","https://www.aldiwan.net/poem54649.html","الطويل"],[139,"سعى بالكاس مخضوب البنان","https://www.aldiwan.net/poem48995.html","الوافر"],[190,"ليالي الصبا درت عليك السحائب","https://www.aldiwan.net/poem44142.html","الطويل"],[228,"حلمت بدنيا ليتها لا تبدد","https://www.aldiwan.net/poem41601.html","الطويل"],[228,"كعاب أتت في الحسن فخر الكواعب","https://www.aldiwan.net/poem41907.html","الطويل"],[275,"يا أرض أندلس الخضراء حيينا","https://www.aldiwan.net/poem35649.html","البسيط"],[309,"بعثت لجيران العقيق تحيتي","https://www.aldiwan.net/poem16789.html","الطويل"],[354,"أراني البعض في بعضي","https://www.aldiwan.net/poem15758.html","الهزج"],[358,"رياض الهنا باليمن فاحت ورودها","https://www.aldiwan.net/poem40398.html","الطويل"],[406,"مواكب خير ، موكب إثرموكب","https://www.aldiwan.net/poem4595.html","عموديه"],[406,"إيقاعات على نيل مصر","https://www.aldiwan.net/poem6726.html","عموديه"],[409,"وأما شيوخي في العلوم فإنهم","https://www.aldiwan.net/poem33941.html","الطويل"],[409,"أما آن عما أنت فيه متاب","https://www.aldiwan.net/poem34163.html","الطويل"],[422,"شديد ما أضر بها الغرام","https://www.aldiwan.net/poem54005.html","الوافر"],[422,"أدار على الندمان كأس عقاره","https://www.aldiwan.net/poem54057.html","الطويل"],[445,"لك الخير قد أوفى بعهدك خيران","https://www.aldiwan.net/poem34887.html","الطويل"],[447,"إلى كم أرقع الدنيا","https://www.aldiwan.net/poem14389.html","مجزوء الوافر"],[457,"أتت أسماء ساحبة رداها","https://www.aldiwan.net/poem13950.html","الوافر"],[482,"أغار إذا وصفتك من لساني","https://www.aldiwan.net/poem16190.html","الوافر"],[534,"نظام يحاكي الدر أهدته نحونا","https://www.aldiwan.net/poem37082.html","الطويل"],[566,"قد جبر الدين الإله فجبر","https://www.aldiwan.net/poem27820.html","الرجز"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138441",""],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126840","الوافر"],[669,"","https://poetry.dctabudhabi.ae/diwan/poem/66745","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86818","الطويل"],[438,"","https://poetry.dctabudhabi.ae/diwan/poem/58807","الطويل"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/67005","الوافر"],[920,"","https://poetry.dctabudhabi.ae/diwan/poem/90572","الرجز"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59610","الطويل"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62533","الوافر"],[1010,"","https://poetry.dctabudhabi.ae/diwan/poem/107212","الوافر"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119915","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59417","الطويل"],[1097,"","https://poetry.dctabudhabi.ae/diwan/poem/80189","البسيط"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126128","الرجز"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55999","الكامل"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56224","البسيط"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64756","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136177","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136326","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136352","البسيط"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52032","الوافر"],[1918,"","https://poetry.dctabudhabi.ae/diwan/poem/99058","الهزج"],[2029,"","https://poetry.dctabudhabi.ae/diwan/poem/123710","الوافر"],[2263,"","https://poetry.dctabudhabi.ae/diwan/poem/140235",""],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93685","الطويل"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87676","الوافر"],[2604,"","https://poetry.dctabudhabi.ae/diwan/poem/102503","البسيط"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132607","الرجز"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89209","الطويل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103907","الطويل"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103908","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45789","الطويل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91891","الوافر"],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85283","الطويل"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114370","الطويل"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103570","الطويل"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76510","الوافر"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77154","الطويل"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127114","الوافر"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/91023","الطويل"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81718","الطويل"],[4702,"مشوار عز","https://www.poetsgate.com/ViewPoem.aspx?id=155169",""],[4578,"تكمَّل بالتوفيق حجك والمنا","https://www.poetsgate.com/ViewPoem.aspx?id=49533",""],[5198,"نود الاشعار","https://www.poetsgate.com/ViewPoem.aspx?id=136094",""],[5397,"تدلت لأفنان النقا عذباتها","https://www.poetsgate.com/ViewPoem.aspx?id=157920",""],[5431,"مصر...والرؤيا","https://www.poetsgate.com/ViewPoem.aspx?id=197044",""],[5431,"وكلّ دروب الأرض ضربٌ من القُبل!","https://www.poetsgate.com/ViewPoem.aspx?id=197577",""],[5470,"الليل والشجن","https://www.poetsgate.com/ViewPoem.aspx?id=10906",""],[5493,"أراكَ","https://www.poetsgate.com/ViewPoem.aspx?id=206413",""],[5540,"تهاني","https://www.poetsgate.com/ViewPoem.aspx?id=216063",""],[5786,"بريقٌ أضا بالغَضَا مُوهِن","https://www.poetsgate.com/ViewPoem.aspx?id=50653",""],[5790,"أما وبدور الكلل","https://www.poetsgate.com/ViewPoem.aspx?id=112122",""],[6048,"معراجُ الوجع","https://www.poetsgate.com/ViewPoem.aspx?id=197747",""],[6225,"نسيمُ الخلود","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=81328&r=&rc=355",""]],"verses":[["وَفي طَلَبِ الثَناءِ مَضى بُجَيرٌ","وَجادَ بِنَفسِهِ كَعبُ بنُ مامِ",0,"م",1,0],["وَفي طَيِّئٍ لَمّا أَثارَت سُيوفُهُ","كُماتُهُمُ مَرأىً لِمَن كانَ مُبصِرا",1,"ر",2,0],["وَفي طَيفِ الخَيالِ شِفا المُعَنّى","وَرِيُّ الصادِياتِ مِنَ الظَماءِ",2,"ا",2,0],["وَفي طِباعِكَ زَيغٌ وَالهِلالُ عَلى","سُمُوِّهِ حِلفُ تَقويسٍ وَتَعويجِ",3,"ج",1,0],["وَفِي طَيِّبِ الرِّزْقِ الَّذِي هُوَ كَاسِبٌ","زَكَاتَانِ مِنْ لُطْفِ الإِشارَةِ وَالبَذْلِ",4,"ل",1,0],["وفي طِباعِكَ زَيْغٌ، والهلالُ، على","سُمُوّهِ، حِلْفُ تقويسٍ وتعوج",5,"ج",1,0],["وفي طاعة الشيطان أفنى شبابَه","على أنه عن طاعة الله يَنزوي",6,"و",2,0],["وفي طيّ اللسانِ كما روينا","عُلاَ الإنسان لا في الطيلسانِ",7,"ن",1,0],["وفي طيّ هذا الدهر كل عجيبة","فمن عاش لافته النهى والعجائب",8,"ب",1,0],["وَفي طَبَق وادٍ تكدَّر ماؤُهُ","فَلا عشبَة تَنمو وَلا غُصنَ يُنقَدُ",9,"د",1,0],["وَفي طرف الأَجفانِ سُلَّت مَضارِبٌ","تَقوم عَلى أَحداقِها كَالمَضارِب",10,"ب",1,0],["وفي طرابلس الغرب استجدَّ لنا","وَجدٌ قديمٌ وقد ضاعت أمانينا",11,"ن",2,0],["وفي طي هذا سر علم محجب","له يهتدي أهل القلوب المنيرة",12,"ه",1,0],["وَفي طولي بَدا عُمقِ","يَ بَينَ الناسِ في عَرضي",13,"ي",1,0],["وَفي طالع الأَفراح مِن أُفق الهَنا","بَدا بَدرُ آفاق العُلى وَسَعيدها",14,"د",3,0],["وفي طيبةِ الهادي البشير لها يدٌ","تمدُّ بريحانٍ إلى المتطيِّبِ",15,"ب",1,0],["وفي طيبةِ المصطفى روضةٌ","بها القلب عن غيرها يُشْغَلُ",16,"ل",1,0],["وفي طيبة الفيحاء شيوخي ومكة","شيوخ علومي في الحديث المحمدي",17,"د",2,0],["وفي طيٍّ أثناء المثاني نفائسٌ","يطيب لها نَشْرٌ ويفتح باب",18,"ب",1,0],["وفي طيِّ الجوانح لو نَشَرْنا","بها المطويَّ طال لنا كلام",19,"م",1,0],["وفي طرفه للسكر ما في يمينه","فكلتاهما من خمرِهِ واختماره",20,"ر",2,0],["وفِي طَيِّ أَسْمَالِ الغَرِيبِ غَرَائِبٌ","سَكَنَّ شَغافَ القلبِ شيبٌ وَوِلْدانُ",21,"ن",1,0],["وفي طاعتك اللَهم","م بالإخلاص تبقيني",22,"ن",2,0],["وفي طَرَفِ الخباءِ ليوثُ حَرْبٍ","تدورُ عليهمُ أبَداً رَحَاها",23,"ا",3,0],["وَفي طَي الطُروس لَهُ رِياض","سَقاها الفَضل أَنواع المَعاني",24,"ن",2,0],["وفي طَيِّهِ بَحْثٌ يَدِقُّ بَيانُهُ","إذا رامَهُ فِكْرُ البَيانِيِّ والنَّحْوِي",25,"و",2,0],["وَفي طِراقِ البيضِ يُوقدنَ الشَرَر","صَقعاً إِذا ما رَنَّحَ الطَرفَ اِسمَدَر",26,"ر",1,0],["وفي طبرية بحر ولكن","فرات ساغ للامم الظميه",27,"ي",2,0],["وفي طَبعي سماح غير أنّي","على قدرِ البِساط مَدَدتُ رِجلي",28,"ي",1,0],["وفي طائرٍ جاءت به أم أيمنٍ","بيانٌ لمن بالحقِّ يَرضى ويَقْنَعُ",29,"ع",1,0],["وَفي طالع السَعد استردّت مَهابة","تَدوم مَدى الدُنيا لِدَولتك الغَرّا",30,"ر",2,0],["وفي طيّ أبرادِ النّسيم خميلةٌ","بأعطافِها نَوْرُ المُنى يتفتّحُ",31,"ح",1,0],["وفي طَيِّ الخميلةِ رِيْمُ إنْسٍ","رَمَزْتُ بها فللَّهِ الخميلهْ",32,"ل",2,0],["وَفي طَريقِنا رَأَينا كَم بَلَد","بِها فَرَنسا اِتَّخَذَت أَي مدَد",33,"د",1,0],["وَفي طَريقا رَأَينا صيدا","وَعَكَّة لَم نلفَ عَنها حيدا",33,"د",2,0],["وفي طيّ أستار الغيوب عجائبٌ","وتحت بنود الصبر نصر مؤزر",34,"ر",1,0],["وفي طيّ القضاء بديع سِرِّ","تبوح به عوادي الدهر جهرا",35,"ر",2,0],["وَفِي طَهَ رَسُولِ اللَّهِ أَقوى","دَلِيلٍ فاطَّرِح عَنكَ الجِدَالا",36,"ل",2,0],["وفي طرقي خفاجة وهي بطن","حلال عندها أكل الحرام",37,"م",1,0],["وفي طيه نشر لمعناه قد غدا","لإظهاره أنف المعاند يرغم",38,"م",1,0],["وَفي طِباعك يااِسكَندَر اِنطَبَعَت","رَقائق اللُطف تَنفي الغَيظ وَالغَضَبا",39,"ب",2,0],["وفي طلوع الشمس كل يوم","فوائد شتى لكل قوم",40,"م",1,0],["وفي طالع الاقبال والسعد ارّخوا","لقد جاء فتح الله في أجمل النصرِ",41,"ر",1,0],["وفي طوالع سعدٍ غير مغربةٍ","ما لاح فجرو أفنى الصبح أحلاكَ",42,"ك",1,0],["وفي طَعْمِها والرِّيحُ مِنْهُ مُشابَهٌ","بِرِيقٍ شِفائي في المَنامِ بَرودُهُ",43,"د",2,0],["وفي طلب العلم الشريف توجهوا","بجد وتشمير وترك لمعتادي",44,"د",2,0],["وفي طاعة الرحمن افنوا حياتهم","فلم يتركوا فرضا ولا ارتكبوا حرما",45,"م",2,0],["وفي طريقته أولاده وكذا","فروعهم من بني علوي الاساطين",46,"ن",1,0],["وَفي طَرقِي مَفَاوِزَ لَيسَ يَدرِي","مَسَالِكَهَا لِبيضَتِهِ العُقابُ",47,"ب",1,0],["وفي طوس مناخ الرك","ب في شعبان في العشر",48,"ر",1,0],["وفي طيّ الجوانح جمر وجد","يؤججه التذكر والتناسي",49,"س",2,0],["وفي طي أهواء النفوس دسائس","ولكنها تبدو لمن يتصفح",50,"ح",1,0],["وَفي طَيِّه العَتب الَّذي رَق لَفظه","كَأني مِن أَلفاظك الغُر ناقل",51,"ل",1,0],["وَفي طَيّ الجَوانح نار وَجدٍ","يسعّرها الجَوى وَالإِدّكار",52,"ر",1,0],["وفي طريقتهم جاء ابن سمرة والشي","خ المراغي فاعدل غير معتدل",53,"ل",1,0],["وفي طلاب العز جدّوا واصبروا","ان زعيم الطالبين صبرها",54,"ر",3,0],["وفي طنتدا قال القبول مؤرخاً","لوضع أساس الأحمدي جاء عباسي",55,"س",2,0],["وفي طاعة الرحمن يقعدك الونى","وتبدي أناةً لا يصح اعتذارها",56,"ر",3,0],["وفي طي مثني الصفيح على الثرى","للشكل والحسن لابس",57,"س",1,0],["وَفي طَلب الخَلق اِتباع سميّه","دَليل عَلى تَعظيمه عِندَ خالق",58,"ق",1,0],["وَفي طَير السمندل اعتبار","لظىً مَأوى وَرزقٌ لا يَفوت",59,"ت",1,0],["وفي طي أثناء المثاني نفائسٌ","ويطيب لها نشر ويفتح باب",60,"ب",1,0],["وفي طلبٍ للعلم جاءت أثارةٌ","من العلم منها عن معاذٍ تعلموا",61,"م",3,0],["وفي طوقه بدر الدُجنةِ طالعٌ","تجلَّله قِطعٌ من الليل فاحمُ",62,"م",1,0],["وَفي طيات امسى راح قَلبي","يفتش بالتلهف عن عشيره",63,"ه",1,0],["وفي طلب الوشل اقتتلا","فما انكفأ الليث حتى انتصر",64,"ر",1,0],["وَفي طَلَبِالأَرزاقِ في واسِع الفَضا","شَواغِل تُقصي النسر عَن مَركَزِ الوَكر",65,"ر",1,0],["وفي طرفي أقمتم غير اني","أخاف عليكم ألم السهاد",66,"د",1,0],["وفي طالع الأفراح يا أملي شدا","ورنم شادي القوم في السر والجهر",67,"ر",1,0],["وفي طَيْبةٍ فانزل ولا تغشَ منزلاً","بسِقْطِ اللِّوى بين الدّخول فحومل",68,"ل",1,0],["وْفي طرْفها الأيسر خذتني وتمشيت","نقطف زهور العشق لين الهدب ذاب",69,"ب",1,0],["وفي طيبة أحكمت نسك زيارة","لدى روضة طابت لمن حج مجتنى",70,"ن",2,0],["وفي طرقتي يسرلي الصحب الاخيار","اهل العقول الراشدة والركادة",71,"د",2,0],["وفي طي أضلاعي أحاديث صبوة","كتمن بيانا والدموع رواتها",72,"ت",3,0],["وفي طورها عشقٌ قديمٌ وشعلةٌ","تضيئُ على الدنيا فمصر لنا القطبُ",73,"ب",1,0],["وفي طاقة الأرواح سرٌّ معظمٌ","بها يقطع البلدان سرّا وماوصل!",74,"ل",1,0],["وفي طَيِّهِ خِلٌّ يُنَاجِي خَلِيلَهُ","وتَسرِي إلَيهِ الرُّوحُ والقَلبُ مُغرَمُ",75,"م",1,0],["وَفي طيّاتِ 