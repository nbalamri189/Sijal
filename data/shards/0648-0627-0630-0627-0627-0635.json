{"poems":[[90,"سر في حياتك سير نابه","https://www.aldiwan.net/poem44813.html","مجزوء الكامل"],[53,"أتصاب إلى ذوي إسعاده","https://www.aldiwan.net/poem61862.html","الخفيف"],[87,"قم للمعلم وفه التبجيلا","https://www.aldiwan.net/poem15422.html","الكامل"],[47,"أهلا بذالكم الخيال المقبل","https://www.aldiwan.net/poem65577.html","الكامل"],[101,"إفادة في محكمة الشعر","https://www.aldiwan.net/poem6630.html","عموديه"],[60,"صرمت حبالك بعد وصلك زينب","https://www.aldiwan.net/poem31129.html","الكامل"],[82,"صب يذوب إلى لقاء مذيبه","https://www.aldiwan.net/poem31568.html","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43817","الكامل"],[108,"ظلال الثورة مصر وسوريا","https://www.poetsgate.com/ViewPoem.aspx?id=179583",""],[108,"صانع الأجيال","https://www.poetsgate.com/ViewPoem.aspx?id=179410",""],[108,"حي البيان","https://www.poetsgate.com/ViewPoem.aspx?id=179367",""],[101,"إفادة في محكمة الشعر","https://www.poetsgate.com/ViewPoem.aspx?id=581",""],[101,"إفادة في محكمة الشعر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=203&r=&rc=17",""],[234,"لا تأمن الدهر الغيور وإن صفا","https://www.aldiwan.net/poem50781.html","الكامل"],[302,"خطرت في شمائل ونعوت","https://www.aldiwan.net/poem33316.html","الخفيف"],[369,"طرقت بليل من سناها مقمر","https://www.aldiwan.net/poem60912.html","الكامل"],[411,"وإذا اصطنعت يدا فراع ثلاثة","https://www.aldiwan.net/poem49385.html","الكامل"],[422,"سعدت نجد إذا وافيت نجدا","https://www.aldiwan.net/poem54161.html","الرمل"],[556,"لا تفخرن إلا بنفسك","https://www.aldiwan.net/poem48032.html","مجزوء الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122620","الخفيف"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38010","الكامل"],[974,"","https://poetry.dctabudhabi.ae/diwan/poem/96365","الكامل"],[996,"","https://poetry.dctabudhabi.ae/diwan/poem/82251","الكامل"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132903","الكامل"],[1890,"","https://poetry.dctabudhabi.ae/diwan/poem/89656","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137112",""],[2611,"","https://poetry.dctabudhabi.ae/diwan/poem/82879","الكامل"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93834","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204463","الرمل"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/46983","الكامل"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66351","الرمل"],[3712,"","https://poetry.dctabudhabi.ae/diwan/poem/132132","الكامل"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131078",""],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34585","المديد"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146754","الكامل"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/141585","الكامل"],[5125,"سرّ","https://www.poetsgate.com/ViewPoem.aspx?id=190047",""],[5219,"كن عاقلا ....","https://www.poetsgate.com/ViewPoem.aspx?id=195013",""],[5324,"إن يكن حبك عيبا.","https://www.poetsgate.com/ViewPoem.aspx?id=211183",""],[5550,"مُلئ الدهرُ","https://www.poetsgate.com/ViewPoem.aspx?id=212116",""],[5689,"ضاقت بمن في ظلها الآجام","https://www.poetsgate.com/ViewPoem.aspx?id=143413",""],[5978,"آمال عجاف","https://www.poetsgate.com/ViewPoem.aspx?id=191287",""]],"verses":[["وإذا أصابك ما يَسُو","ءُ مُصابك من مصابه",0,"ب",2,0],["وإذا اصْطادك المشيبُ فطاردْ","تَ غزالاً فلستَ بالمُصطادِهْ",1,"د",2,0],["وَإِذا أُصيبَ القَومُ في أَخلاقِهِم","فَأَقِم عَلَيهِم مَأتَماً وَعَويلا",2,"ل",2,0],["وَإِذا أَصابَ فَكُلُّ شَيءٍ مَقتَلٌ","وَإِذا أُصيبَ فَما لَهُ مِن مَقتَلِ",3,"ل",1,0],["وإذا أصبح المفكر بوق","يستوي الفكر عندها والحذاء",4,"ا",2,0],["وَإِذا أَصابَكَ في زَمانِكَ شِدَّةٌ","وَأَصابَكَ الخَطبُ الكَريهُ الأَصعَبُ",5,"ب",1,0],["وإذا أصابَ قذالَ ذِمْرٍ قَدّهُ","ومشَتْ يدي معه إلى مَرْغوبهِ",6,"ب",2,0],["وَإِذا اِصطَلَحنا بَعضَ يَومٍ لَم نَدم","فَكَأَنَّنا في المُبتَدا نَتَناهى",7,"ا",3,0],["وإذا أصابَ دمَشْقَ مكروهٌ ترى","أحشاءَ مصر تكادُ أن تتمزَّقا",8,"ق",2,0],["وإذا أُصِيْبَ الشَّعْبُ في إيمانِه","فانْدُبْه في نَوْحٍ، وفي إعوالِ",9,"ل",1,0],["وإذا أُصيب الشعب في آدابه","عَزَّ العزاءُ أمامَ هوْل مُصَابه",10,"ب",2,0],["وإذا اصبح المفكر بوقا","يستوي الفكر عنده والحذاء",11,"ا",2,0],["وإذا أصبحَ المفكِّرُ بُوقاً","يستوي الفكرُ عندها والحذاءُ",12,"ا",2,0],["وإذا أصابك من زمانٍ نبوَةٌ","فالبس لها الخلُقُ الحميدَ الأكرما",13,"م",2,0],["وإذا أَصفَتِ الهَوى وأَدارَت","في صفا الدرِّ ذائبَ الياقوتِ",14,"ت",1,0],["وإذا اصطنَعْتَ حسيبَ قومٍ فارْجُه","وإذا اصطَنَعْتَ دَنِيءَ قومٍ فاحْذَر",15,"ر",1,0],["وإذا اصطنَعت يداً فراعِ ثلاثةً","مقدارَها ومكانَها وأوانَها",16,"ه",2,1],["وإذا أصبحتَ في أحسائها","قيل للشرّ عن الأَحساء بُعْدا",17,"د",2,0],["وإذا أصاب الدهرُ غي","رَكَ بالسّهامِ فقد وُعِظْتا",18,"ت",2,0],["وإذا أصحَبَ المَوَدَّةَ كانَ ال","مُرُّ فيها حُلواً ولم يَكُ مُرّا",19,"ر",2,0],["وإذا أُصِبْتَ فلا تكنْ متبرِّماً","فأخو الحِجى لو قَد أُصيبَ صَبورُ",20,"ر",1,0],["وإذا أصابَكَ والحوادثُ جَمّةٌ","حَدَثٌ حَداكَ الى أخيكَ الأوثَقِ",21,"ق",1,0],["وَإِذا أَصَبتَ مِنَ النَّوافِلِ رَغبَةً","فَاِمنَح عَشيرَتَكَ الأَداني فَضلَها",22,"ل",3,0],["وإذا أصاخَ إلى المديحِ رَأَيتَه","وكأن مالك طيِّئِ غنَّاهُ",23,"ه",1,0],["وَاِذا اِصابَكَ نَكبَة فَاِصبِر لَها","مِن ذا رَأَيت مُسلِماً لا يُنكَب",24,"ب",1,0],["واذا اصطلت منها القلوب بحرها","فبعذب وعظك بردها وسلامها",25,"م",3,0],["وَإِذا أصبتَ فَكُلُّ ما","أَغفَلتَهُ دونَ الإِصابَه",26,"ب",2,0],["وإذا اصطفى الرحمن بعض عباده","أبدى بديع عجائب الإمكان",27,"ن",1,0],["وإذا أصبح جسمي مأكلاً","لنسور أو سباع ضاربات",28,"ت",1,0],["وَإِذَا أُصَافِحُهُ وأَمْسَحُ لاثِماً","أَرْكانَهُ فَمُعزِّزاً وَمُوَقِّرا",29,"ر",2,0],["وإذا أصغوا لوصفي قل لهم","في خلال الوصف أنّي كالخلال",30,"ل",1,0],["وإذا أصيب فقد أصبتُ","كذاك أصحاب العهود",31,"د",1,0],["وإذا أصبحت حمامة أيك","تألف الشدو بكرة وأصيلا",32,"ل",2,0],["واذا أصغيت ذكرني","نشرُ كافورٍ على بردِ",33,"د",1,0],["وإذا أصادر غدوة لم يرتفع","عند المساء سواي في الأوراد",34,"د",1,0],["وإذا أصر على الخلاف محرّم","فاعمد إلى حدّ الحسام الأبتر",35,"ر",1,0],["وإذا أصبت مصيبةً أمهلنني","بحراسةِ الأشهاب ليس تُذاعُ",36,"ع",1,0],["وإذا أُصبتَ بطائش من سهمها","ألفيت نفسك فاقدَ الخلانِ",37,"ن",1,0],["وإذا أصبح ذنبا","فمحال ان اتوب",38,"ب",1,0],["وإذا اصطادكَ السهادُ تبيتُ","الليلَ تشكو منْ قسْوة الصيَّاد",39,"د",1,0],["وإذا أصيب الأسد في انيابها","عبث بها وبغابها الأنعام",40,"م",1,0],["(وإذا أصيبَ القوم في أخلاقهم )","ماتوا وإن سمعَ الترابُ وأبصرا",41,"ر",2,0]]}