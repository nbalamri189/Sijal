{"poems":[[53,"أسائل سيفي أي بارقة تجدي","https://www.aldiwan.net/poem30621.html","الطويل"],[47,"نفى النوم عن عيني خيال مسلم","https://www.aldiwan.net/poem25134.html","الطويل"],[43,"عزيز أسى من داؤه الحدق النجل","https://www.aldiwan.net/poem9987.html","الطويل"],[21,"وما لي لا أحييه وعندي","https://www.aldiwan.net/poem36237.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85602","الطويل"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140827",""],[32,"","https://poetry.dctabudhabi.ae/diwan/poem/8248","الطويل"],[90,"الأنانية","https://www.poetsgate.com/ViewPoem.aspx?id=179128",""],[18,"جَارَتْ بَنُو بَكْرٍ وَلَمْ يَعْدِلُوا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=26453&r=&rc=19",""],[179,"خليلى إنى اليوم شاك إليكما","https://www.aldiwan.net/poem59049.html","الطويل"],[235,"إلى ما فؤادي يذوب زفيرا","https://www.aldiwan.net/poem18193.html","المتقارب"],[247,"تناهيت عن ذكر الصبابة فاحكم","https://www.aldiwan.net/poem2094.html","الطويل"],[269,"أتأمرني بالصبر والطبع أغلب","https://www.aldiwan.net/poem52082.html","الطويل"],[278,"هبوا طيفكم أعدى على النأي مسراه","https://www.aldiwan.net/poem60774.html","الطويل"],[318,"أبا مصطفى استمتع فحظك وافر","https://www.aldiwan.net/poem67164.html","الطويل"],[362,"أأحبابنا قد شقتمونا فأسعدوا","https://www.aldiwan.net/poem60942.html","الطويل"],[400,"مولاي قد أحسنتم","https://www.aldiwan.net/poem33347.html","مجزوء الرجز"],[403,"أبى زمني مذ شبت ألا تعوجا","https://www.aldiwan.net/poem50197.html","الطويل"],[413,"لفقدان عبد الواحد الدمع قد جرى","https://www.aldiwan.net/poem54022.html","الطويل"],[436,"تصدت لوشك البين من جفوة الصد","https://www.aldiwan.net/poem34776.html","الطويل"],[438,"أعيدي بديع النوح ويك أعيدي","https://www.aldiwan.net/poem14453.html","الطويل"],[438,"نجمع والمجموع يكلا ويترك","https://www.aldiwan.net/poem14471.html","الطويل"],[438,"نكابد في الدنيا هموما وأحزانا","https://www.aldiwan.net/poem14485.html","الطويل"],[450,"إلى روضة الآداب ريحانة الندى","https://www.aldiwan.net/poem13631.html","الطويل"],[466,"عندي لون طبخته بيدي","https://www.aldiwan.net/poem60228.html","المنسرح"],[472,"إلى روض به نفل وبقل","https://www.aldiwan.net/poem2169.html","الوافر"],[477,"هلموا خفافا بني المكتب","https://www.aldiwan.net/poem36929.html","المتقارب"],[527,"على العالم البحر خدن الكمال","https://www.aldiwan.net/poem37267.html","المتقارب"],[574,"إني لقطاع اللبانة والهوى","https://www.aldiwan.net/poem1774.html","الطويل"]],"verses":[["إِلى رَبعِكَ المَألوفِ مِنّي تَطَلَّعَت","رِقابُ القَوافي تَحتَ أَدعَجَ مُزبَدِّ",0,"د",1,0],["إِلى رَجُلٍ يَلقاكَ في شَخصِ واحِدٍ","وَلَكِنَّهُ في الحَربِ جَيشٌ عَرَمرَمُ",1,"م",1,0],["إِلى رَبِّ مالٍ كُلَّما شَتَّ شَملُهُ","تَجَمَّعَ في تَشتيتِهِ لِلعُلا شَملُ",2,"ل",1,0],["إِلى رُدُحٍ مِنَ الشيزى مِلاءٍ","لُبابَ البُرِّ يُلبَكُ بِالشَهادِ",3,"د",1,0],["إلى راية خضراء كالنبت زانها","هلال به قد حق للعرب الفخر",4,"ر",1,0],["إلى رب مالٍ كلما شت شمله","تجمع في تشتيته للعلى شمل",5,"ل",1,0],["إِلى رُجُحِ الأَعجازِ حورٍ نَمى بِها","مَعَ العِتقِ وَالأَحسابِ صالِحُ دينِ",6,"ن",1,0],["إلى روح \" مكيافيل \" نفحُ تحية","وصوبُ غمامٍ يترك القبرَ عاشبا",7,"ب",2,0],["إلى رئيسِ الناسِ وَ المرتجى","لَعُقْدَة ِ الشَّدِّ وَرَتْقِ الْفُتُوقْ",8,"ق",1,0],["إِلَى رُجَّحِ الاَكفالِ غِيدٍ كَأنَّهَا","ظِباءُ الفَلا أَعناقُهَا وَخُدُودُهَا",9,"د",3,0],["إِلَى رِقَّةٍ لَوْ حَوَاهَا النَّسِيمُ","لَمَا قََصَفَ الدَّهْرُ غُصْناً نَضِيرَا",10,"ر",2,0],["إِلى رَبِّكِ الخَيرِ اِبنِ قُرّانَ فَاِعمَلي","ثُمامَةَ مَأوى كُلِّ مُثرٍ وَمُعدَمِ",11,"م",1,0],["الى روضة ما بين قبر وَمَنبَر","عَلَيها رباح الخلد تَصبو وَتجنب",12,"ب",1,0],["إِلى رَبْعِ عَمّارِ بْنِ عَمّارِ الَّذِي","تَكَفَّلَ أَرْزاقَ الْعُفاةِ بِجَدْواهُ",13,"ا",2,0],["إِلى رُتبَةِ الباشا رَقيتُ وَأَنَّها","لِعِنونٍ مَكنونٍ قَريباً سَيُجلى لَك",14,"ك",1,0],["إلى رُؤيةِ الأحبابِ رامَ تَطرُّقاً","فؤادٌ غدا منّي لعينيّ يَحسُد",15,"د",1,0],["إلى رياض نضره","تحسبها معطره",16,"ه",1,0],["إِلى راسِيات ما تَنام طُهاتُها","وَمقراة نُبلٍ ما تَغِب المودَّجا",17,"ج",2,0],["إلى رحمة الرَّحمن والفوز بالرّضا","سبَقت وما أسبقت فينا التَّصبّرا",18,"ر",2,0],["إلى رَوْحِ إنعامٍ يُراحُ إلى المُنى","ولُجَّةِ معروفٍ تُهِلُّ إلى الوِرْدِ",19,"د",1,0],["إِلى رحمة الرحمن روحك روحت","وفي وفده أقبلت صدر وفود",20,"د",1,0],["إلى رحمة الرحمن راحوا فأدركوا","مناهم وهنوا بالذي قد تمسكوا",21,"ك",3,0],["إلى رحمة الرحمن يمم قاصداً","وزوّده للحشر صفحاً وغفرانا",22,"ن",2,0],["إلى روضةِ الآدابِ ريحانة الندى","تحايا حفاظ حركتها يدُ الودِّ",23,"د",1,1],["إِلى رِخامِيَّةٍ مَذاقَتُها","أَطيبُ مِن عيشَةٍ بِلا نَكَدِ",24,"د",1,0],["إلى روض به نَفَلُ وبَقلٌ","يُغَنِّي في أسِرِتَّه الُّبابُّ",25,"ب",1,1],["إلى رفاقي نحث المسير","مع البعض بعضا على خبب",26,"ب",1,0],["إلَى رَاحِلٍ باخِلٍ باللّقا","إلَى مُتْهمٍ مُنْهَمٍ بالْمَطالِ",27,"ل",1,0],["إِلى رَبِّها قَيسٍ تَروحُ وَتَغتَدي","فَلا فَرِحٌ قَيسٌ وَلا مُتَعَبِّسُ",28,"س",1,0]]}