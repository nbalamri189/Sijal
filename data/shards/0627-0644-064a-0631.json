Poem.aspx?id=188448",""],[5122,"(غني الاوأدم ما تكفل أبمفلسها)","https://www.poetsgate.com/ViewPoem.aspx?id=34736",""],[5232,"خذي قلبي","https://www.poetsgate.com/ViewPoem.aspx?id=213007",""],[5277,"غصنٌ منفرد..","https://www.poetsgate.com/ViewPoem.aspx?id=205100",""],[5431,"البردة -ريم","https://www.poetsgate.com/ViewPoem.aspx?id=190769",""],[5431,"حنانيك ياأختاه...لعروبا الباشا","https://www.poetsgate.com/ViewPoem.aspx?id=198086",""],[5438,"تَكْوِينٌ لِذَاتِي","https://www.poetsgate.com/ViewPoem.aspx?id=202094",""],[5525,"الطير","https://www.poetsgate.com/ViewPoem.aspx?id=993",""],[5533,"لَيَالي الشَّوْق","https://www.poetsgate.com/ViewPoem.aspx?id=186685",""],[5550,"رجوع حبيبي","https://www.poetsgate.com/ViewPoem.aspx?id=215208",""],[5573,"ماحال دون معانق الشوق حراس","https://www.poetsgate.com/ViewPoem.aspx?id=201913",""],[5573,"دربي طويل وسكتي مالها زي","https://www.poetsgate.com/ViewPoem.aspx?id=201932",""],[5612,"إلى رَبِّ البَرِيّة","https://www.poetsgate.com/ViewPoem.aspx?id=179669",""],[5652,"تمثال حلمي ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=178197",""],[5672,"في الحسين عليه السلام","https://www.poetsgate.com/ViewPoem.aspx?id=206429",""],[5690,"سلوا عن فؤادي من بار واحنا يفدا","https://www.poetsgate.com/ViewPoem.aspx?id=172144",""],[5816,"( العبيرية ) في وصف الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=125964",""],[694,"ألا يا عين بكي لا تملي","https://www.poetsgate.com/ViewPoem.aspx?id=81338",""],[5930,"أراها بكل وجوه المكان","https://www.poetsgate.com/ViewPoem.aspx?id=77443",""],[6106,"إلى رحمات الله ، يا أبا فيصل","https://www.poetsgate.com/ViewPoem.aspx?id=7000",""],[6315,"قَبائلُ النِّسْرِين !! هامشٌ على قرطاسِ المُتَنَبّي ..","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87575&r=&rc=0",""]],"verses":[["إِلى رَبعِكَ المَألوفِ مِنّي تَطَلَّعَت","رِقابُ القَوافي تَحتَ أَدعَجَ مُزبَدِّ",0,"د",1,0],["إِلى رَجُلٍ يَلقاكَ في شَخصِ واحِدٍ","وَلَكِنَّهُ في الحَربِ جَيشٌ عَرَمرَمُ",1,"م",1,0],["إِلى رَبِّ مالٍ كُلَّما شَتَّ شَملُهُ","تَجَمَّعَ في تَشتيتِهِ لِلعُلا شَملُ",2,"ل",1,0],["إِلى رَئيسِ الناسِ وَالمُرتَجى","لِعُقدَةَ الشَدِّ وَرَتقِ الفُتوق",3,"ق",1,0],["إِلى رُدُحٍ مِنَ الشيزى مِلاءٍ","لُبابَ البُرِّ يُلبَكُ بِالشَهادِ",4,"د",1,0],["إلى راية خضراء كالنبت زانها","هلال به قد حق للعرب الفخر",5,"ر",1,0],["إلى رب مالٍ كلما شت شمله","تجمع في تشتيته للعلى شمل",6,"ل",1,0],["إِلى رُجُحِ الأَعجازِ حورٍ نَمى بِها","مَعَ العِتقِ وَالأَحسابِ صالِحُ دينِ",7,"ن",1,0],["إلى روح \" مكيافيل \" نفحُ تحية","وصوبُ غمامٍ يترك القبرَ عاشبا",8,"ب",2,0],["إِلَى رُجَّحِ الاَكفالِ غِيدٍ كَأنَّهَا","ظِباءُ الفَلا أَعناقُهَا وَخُدُودُهَا",9,"د",3,0],["إِلَى رِقَّةٍ لَوْ حَوَاهَا النَّسِيمُ","لَمَا قََصَفَ الدَّهْرُ غُصْناً نَضِيرَا",10,"ر",2,0],["إِلى رَبِّكِ الخَيرِ اِبنِ قُرّانَ فَاِعمَلي","ثُمامَةَ مَأوى كُلِّ مُثرٍ وَمُعدَمِ",11,"م",1,0],["الى روضة ما بين قبر وَمَنبَر","عَلَيها رباح الخلد تَصبو وَتجنب",12,"ب",1,0],["إِلى رَبْعِ عَمّارِ بْنِ عَمّارِ الَّذِي","تَكَفَّلَ أَرْزاقَ الْعُفاةِ بِجَدْواهُ",13,"ا",2,0],["إِلى رُتبَةِ الباشا رَقيتُ وَأَنَّها","لِعِنونٍ مَكنونٍ قَريباً سَيُجلى لَك",14,"ك",1,0],["إلى رُؤيةِ الأحبابِ رامَ تَطرُّقاً","فؤادٌ غدا منّي لعينيّ يَحسُد",15,"د",1,0],["إلى رياض نضره","تحسبها معطره",16,"ه",1,0],["إِلى راسِيات ما تَنام طُهاتُها","وَمقراة نُبلٍ ما تَغِب المودَّجا",17,"ج",2,0],["إلى رحمة الرَّحمن والفوز بالرّضا","سبَقت وما أسبقت فينا التَّصبّرا",18,"ر",2,0],["إلى رَوْحِ إنعامٍ يُراحُ إلى المُنى","ولُجَّةِ معروفٍ تُهِلُّ إلى الوِرْدِ",19,"د",1,0],["إِلى رحمة الرحمن روحك روحت","وفي وفده أقبلت صدر وفود",20,"د",1,0],["إلى رحمة الرحمن راحوا فأدركوا","مناهم وهنوا بالذي قد تمسكوا",21,"ك",3,0],["إلى رحمة الرحمن يمم قاصداً","وزوّده للحشر صفحاً وغفرانا",22,"ن",2,0],["إلى روضةِ الآدابِ ريحانة الندى","تحايا حفاظ حركتها يدُ الودِّ",23,"د",1,1],["إِلى رِخامِيَّةٍ مَذاقَتُها","أَطيبُ مِن عيشَةٍ بِلا نَكَدِ",24,"د",1,0],["إلى روض به نَفَلُ وبَقلٌ","يُغَنِّي في أسِرِتَّه الُّبابُّ",25,"ب",1,1],["إلى رفاقي نحث المسير","مع البعض بعضا على خبب",26,"ب",1,0],["إلَى رَاحِلٍ باخِلٍ باللّقا","إلَى مُتْهمٍ مُنْهَمٍ 