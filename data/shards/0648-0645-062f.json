/www.poetsgate.com/ViewPoem.aspx?id=179147",""],[90,"ذكرى وعد بلفور","https://www.poetsgate.com/ViewPoem.aspx?id=179206",""],[90,"يوم الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=179227",""],[90,"حافظ إبراهيم","https://www.poetsgate.com/ViewPoem.aspx?id=179126",""],[90,"إلى المناضلين","https://www.poetsgate.com/ViewPoem.aspx?id=179212",""],[90,"قف بأجداث الضحايا","https://www.poetsgate.com/ViewPoem.aspx?id=179225",""],[90,"عقابيل داء","https://www.poetsgate.com/ViewPoem.aspx?id=179142",""],[45,"شَطَّ مِنْ ساكِنِ الغُوَيْرِ مَزَارُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=31263",""],[28,"سلوت عن الدهر الذي كان معجبا","https://www.poetsgate.com/ViewPoem.aspx?id=22069",""],[51,"أحسنَ ما كان الدقيقُ مَوقعا","https://www.poetsgate.com/ViewPoem.aspx?id=29501",""],[51,"يمَّنَ اللهُ طلعة المهرجان","https://www.poetsgate.com/ViewPoem.aspx?id=30807",""],[93,"أَتَتْ مِصرَ تَسْتَعْطِي بِأَعْيُنِهَا النُّجْلِ","https://diwany.org/%D8%A3%D9%8E%D8%AA%D9%8E%D8%AA%D9%92-%D9%85%D9%90%D8%B5%D8%B1%D9%8E-%D8%AA%D9%8E%D8%B3%D9%92%D8%AA%D9%8E%D8%B9%D9%92%D8%B7%D9%90%D9%8A-%D8%A8%D9%90%D8%A3%D9%8E%D8%B9%D9%92%D9%8A%D9%8F%D9%86%D9%90/","الطويل"]],"verses":[["وَمَدَّ سَماءً مِن عَلائِكَ مِلؤُها","نُجومٌ مِنَ الإِقبالِ غَيرُ أُفولِ",0,"ل",1,0],["وَمِدى الجازِرِ تَدمى","كَالمَباتيرِ الرَقيقَه",1,"ق",2,0],["وَمُداوي العَلاءِ مِن عِلَّةِ البُؤ","سِ وَقَد أَعجَزَ الطَبيبَ وَأَشفى",2,"ف",2,0],["وَمُدَرَّبينَ عَلى اللِقاءِ كَأَنَّهُم","لَم يُخلَقوا إِلا لِيَومِ قِراعِ",3,"ع",1,0],["وَمِدرَهُ قَولٍ يَبُذُّ الخُصومَ","إِذا بَلَغوا بِالخِصامِ القِذاعا",4,"ع",2,0],["وَمَدّوا يَدي مِن بَعدِ ما كانَ مَطرَحي","مِنَ الأَرضِ مَجروراً عَليهِ الجَرائِرُ",5,"ر",1,0],["وَمَدَّ عَلى الجَوزاءِ أَطنابَ مَنزِلٍ","يَلوذُ بِخَقوَيهِ السُها وَالفَراقِدُ",6,"د",1,0],["وَمَدَّ بِضَبعي يَومَ لا العَثمُ ناصِرٌ","وَلا الرُمحُ مَنّاعٌ وَلا العَضبُ ذائِدُ",7,"د",1,0],["وَمَدحُكَ هَذا بِكرُ مَدحٍ مَدَحتُهُ","وَكُنتُ أُروضُ القَولَ حَتّى تَسَدَّدا",8,"د",2,0],["وَمُدَّرِعٍ سَمَوتُ لَهُ مِغَذّاً","وَقَد غَرِضَ المُقارِعُ بِالرِماحِ",9,"ح",1,0],["وَمَدَّ إِلَيكَ البَاعَ حَتّى أَطالَهُ","بِذي قُدْرَةٍ تَرْفَضُّ عَنها الحَفائِظُ",10,"ظ",1,0],["وَمُدَجَّجٍ نازَلْتُهُ في مَأْزِقٍ","يَضْفو عَلَيْهِ مِنَ العَجاجِ رِداءُ",11,"د",3,1],["ومدّتْ إلينا منَ الخِدْرِ غِيداً","وأغْضَتْ على النّظَرِ الشَّزْرِ عِينا",12,"ن",2,0],["ومدَّ سَحاباً منْ قَناً وقِسيُّهُ","رُعودُ المَنايا والبُروقُ سِهامُهُ",13,"م",2,0],["ومَدَّ عِنانَ الدّهْرِ إنْ شاءَ أو أَبى","إِلى نَيْلِ ما أمّلْتَهُ المَلَوانِ",14,"ن",1,0],["ومُدَّ إِلى العُلا ضَبْعَيَّ وامْنَعْ","صُروفَ الدّهْرِ أنْ يُضْرِعْنَ خَدّي",15,"ي",1,0],["ومِدْحَةٍ ذَهَبَتْ في الأرضِ شاردَةً","تُهدي مَعَدُّ قَوافيها إِلى اليَمَنِ",16,"ن",1,0],["ومَدَدْتَ لِلعافينَ ظِلاً وارِفاً","يتوشَّحُ الضّاحِي بهِ والمُعتِمُ",17,"م",1,0],["وَمُدامَةٍ قَرَّعتُها بِمُدامَةٍ","وَظِباءِ محنِيَةٍ ذَعَرتُ بِسَمحَجِ",18,"ج",1,0],["وَمُدَجَّجٍ كَرِهَ الكُماةُ نِزالَهُ","لا مُمعِنٍ هَرَباً وَلا مُستَسلِمِ",19,"م",1,0],["وَمَدَّ إِلَى سَيْفٍ أَكُفَّ اعْتِدَائِهِ","فَأَخْرَجَهُ بالرَّغْم مِنْ غَمْدِ غُمْدَانِ",20,"ن",1,0],["وَمَدَّ بُرُودَ النَّبْتِ فِي قُتَنِ الرُّبَى","وَحَلَّى عَرُوسَ الدَّوْحِ دُرًّا وَعِقْيَانَا",21,"ن",2,0],["وَمَدَدْتَ لِلتَّقْبِيلِ يُمْنَاكَ الَّتِي","هِيَ وَالْحَيَا فِي نَفْعِهَا سِيَّانِ",22,"ن",1,0],["وَمَدْحِي عَلَى الأَمْلاَكِ وَقْفٌ وَإِنَّمَا","رَأَيْتُكَ مِنْهَا فَامْتَدَحْتُ عَلَى وَسْمِي",23,"ي",1,1],["وَمُدَّرِعٍ يَنْسَابُ فِي مَنْبِتَ الْخوطِ","تَفيَّأَ مَثْوَى ظله كُلُّ مَغْبُوطِ",24,"ط",1,1],["ومُدّتْ إلى اللهِ الأكُفُّ ضَراعَةً","فقال لهنّ اللهُ قد قُضيَ الأمْرُ",25,"ر",1,0],["ومَدَدْتُ كفَّ الفَقْرِ أسْألُهُ فَيا","عِزَّ الغَنيِّ وذِلّةَ المُحْتاجِ",26,"ج",1,0],["وَمَدَدتِ صَوتَكِ بَعدَ طولِ خُفوتِهِ","فَدَعا بِعافِيَةٍ لَكِ الإِسلامُ",27,"م",1,0],["وَمُدامَةٌ يَسعى بِها","مُتَأَدِّبٌ وَيَطوفُ ريمُ",28,"م",1,0],["وَمُدِلٍّ عَلى الأَخِلّاءِ مُغتَرٍّ","بِإِكرامِهِم لَهُ وَاِحتِرامِه",29,"م",2,1],["وَمَدَّت كَفَّها الجَذما قَليلاً","كَمَن يَرجو مُصافَحَةَ الحَبيبِ",30,"ب",1,0],["وَمدامَةً مِن صَيدِنا يا نَشرُها","مِن عَنبَرٍ وَقَميصُها مِن صَندَلِ",31,"ل",1,0],["وَمَدامَةٍ لَم يُبقِ طولُ ثَوائِها","في خدرِها إِلّا وَميضَ شُعاعِ",32,"ع",1,0],["ومديحي فيه لو جاد لما","زاده عن كونه أرفع شانا",33,"ن",2,0],["وَمَدَّت بِضَبعَيَّ الرِبابُ وَمالِكٌ","وَعَمرٌو وَشالَت مِن وَرائي بَنو سَعدِ",34,"د",1,0],["ومدارة الأفلاك أعجز كُنْهُها","إبداعَ كلِّ مهندس ومهندمِ",35,"م",1,0],["ومدَّ ظلالَ الأمن إذ قصر العدا","فيُتُلى سناءُ الملك بالمدّ والقصرِ",36,"ر",1,0],["ومدَّ ظلال العدل في كل وجهةٍ","وكفَّ أكُفَّ البغي من كلِّ معتدِ",37,"د",1,0],["ومدّت على بيروت منها غَيابةً","بها عاد وجه الأفق أسفع مُكدرّا",38,"ر",2,0],["وَمُدَفَّعينَ جَفا الأَقارِبُ عَنهُمُ","حَلّوا إِلَيكَ بِدَمثَةٍ مِحلالِ",39,"ل",1,0],["وَمُدَجَّجينَ تَرى المَغاوِلَ وَسطَهُم","وَذُبابَ كُلِّ مُهَنَّدٍ قِرضابِ",40,"ب",1,0],["وَمُدَفَّعٌ طَرَقَ النُبوحَ فَلَم يَجِد","مَأوىً وَلَم يَكُ لِلمُضيفِ سَوامُ",41,"م",1,0],["ومَدَارِيكَ لِلذُّحُولِ مَتَارِي","كَ وإِن أُحفِظُوا لعُورِ الكَلاَمِ",42,"م",1,0],["وَمَدعُوٍّ إِلَيَّ أَجابَ لَمّا","رَأى أَن قَد تَذَمَّمَ وَاِستَلاما",43,"م",2,0],["ومديرها قمرٌ منازِله","في الطرفِ دائرةٌ وفي القلب",44,"ب",1,0],["ومدحة أنت أنت أجدرُ من","تحدِثُ للخيرِ فيها جَذبه",45,"ب",2,0],["ومُدِحت حين قصدته","وقصدت حين مدحته",46,"ت",2,0],["ومد جناحي ظلها آلِقُ الضحى","فشدت كما شد النعام المنفّر",47,"ر",1,0],["ومدْرجٌ كانَ فيه الدّرّ منتظماً","على ترائب أسماعٍ وأبصار",48,"ر",1,0],["ومد يد النعمى إلى كل فضة","دنا وَرَقٌ منها إليه فأثمرا",49,"ر",2,0],["ومدحت من نشرت مدائح مجده","ذكري فلو لم يعطني لكفاني",50,"ي",1,0],["ومدَّ يميناً يعذر البحر والحيا","إذا حلفا يوم الندى بيمينه",51,"ن",2,0],["ومديحٌ يضمُّ لفظاً فصيحاً","غيرَ مُستكرهٍ ومعنىً جليبا",52,"ب",2,0],["ومُدامةٍ أغنَتْ عن المصباحِ","يلقى المساءَ إناؤُها بِصَبَاحِ",53,"ح",1,1],["ومدائحي تترى يجو","دُ بها لسانيَ والضميرُ",54,"ر",1,0],["ومدقَّقات كلُّهن مزخرفٌ","بالبيض منها مُلَسَّنٌ ومُدَنَّر",55,"ر",1,0],["ومُدامةٍ كحشاشة النفسِ","لَطُفت عن الإدراك باللمسِ",56,"س",1,1],["ومدحه المأخوذُ من مجدِه","ما قال لي وجدي به دلِّس",57,"س",1,0],["ومدت وسائل أُعدمتُها","وأنت الوسيلة لا تنقطع",58,"ع",1,0],["ومدحة لو عدتكم كذبت","كنتم سبيلاً لصدق صادقها",59,"ق",3,0],["ومدامة كدم الذبيح شربتها","والبدر يجنح من خلال المشرقِ",60,"ق",1,1],["ومديح الملوك من آل حرب","ثم من بعدِهِم بني مروانِ",61,"ن",1,0],["ومديح الممدَّحين من النا","سِ جيمعاً في كل حينٍ وآن",61,"ن",1,0],["وَمُدَّعَسٍ فيهِ الأَنيضُ اِختَفَيتَهُ","بِجَرداءَ يَنتابُ الثَميلَ حِمارُها",62,"ر",3,0],["وَمُدارَةٍ في الجَوِّ","يَحسَبُها الجَهولُ بِلا مُديرِ",63,"ر",1,0],["وَمُدَىً وَسُيوفاً مِن خَشَبِ","وَنَجولُ وَنَركُضُ في الطُرُقِ",64,"ق",1,0],["وَمَدينَةٍ زَهراءَ آمِنَةِ الحِمى","هُدِمَت مَنازِلُها عَلى السُكّانِ",65,"ن",1,0],["وَمُدامٍ مِن رُضابٍ","وَحَبابٍ مِن ثَنايا",66,"ا",3,0],["ومُدَّ على الكونِ سحرٌ غريبٌ","يصرّفُهُ ساحرٌ مقتدِرْ",67,"ر",1,0],["ومدّع بحياة البحر معرفة","ما حازها احد في الاعصر الاول",68,"ل",1,1],["وَمَدَّ نَحوَهُ يَميناً قاسِيَه","بِضَربَةٍ كادَت تَكونُ القاضِيَه",69,"ه",1,0],["وَمَدرَسَةٍ سَمَت بِالعِلمِ رُكناً","وَأَنهَضَتِ القَضاءَ وَالاِشتِراعا",70,"ع",2,0],["وَمَدائِنُ البَرَّينِ في إِعظامِهِ","وَعَوالِمُ البَحرَينِ في الإِكبارِ",71,"ر",1,0],["وَمَدارِسٌ لا تُنهِضُ ال","أَخلاقَ دارِسَةَ الرُسومِ",72,"م",1,0],["وَمُدقِعينَ بِسُبروتٍ صَحِبتُهُمُ","عارينَ مِن حُلَلٍ كاسينَ مِن دَرَنِ",73,"ن",1,0],["ومُدَّ القُباطِيُّ فوقَ الخِوا","ن يلمعُ كالقمر المُزْهِرِ",74,"ر",1,0],["ومدبَّراً ضمنتْ أَيالَتُهُ","ألّا يُراعَ لصقرِها الحَزَبُ",75,"ب",1,0],["وَمُدَرَّبينَ عَلى اللِقاءَ يَشُفُّهُم","شَوقٌ إِلى يَومِ الوَغى المَوعودِ",76,"د",1,0],["وَمَدَّ الهَوانُ عَلى شَخصِهِ","حَواشي ثِيابٍ مِنَ الذُلِّ سودِ",77,"د",1,0],["وَمَدَدتَ تَطَّلِبُ الَّذي لَم يَطلُبوا","كَفّاً تُناوِلُكَ السَماءَ وَساعِدا",78,"د",2,0],["وَمَدارٌ عَلَيهِ وَالفَلَكُ الضَخ","مُ عَلى كَوكَبِ السِماكِ مَدارُه",79,"ر",2,0],["وَمَدافِعُ الساجورِ حَيثُ تَقابَلَت","في ضِفَّتَيهِ تِلاعُهُ وَكُهوفُهُ",80,"ف",2,0],["وَمَدَّت بِضَبعَيَّ الرَبابُ وَدارِمٌ","وَعَمروٌ وَسالَت مِن وَرائي بَنو سَعدِ",81,"د",1,0],["وَمَدَّت بِأَيديها النِساءُ وَلَم يَكُن","لِذي حَسَبٍ عَن قَومِهِ مُتَخَلَّفُ",82,"ف",1,0],["وَمَدَّ يَداً مِنهُ لِبَيعَةِ خاسِرٍ","وَما المُكسِدُ المَغبونُ كَالرابِحِ المُغلي",83,"ل",2,0],["ومُدامَةٍ رَقَّتْ فخِلْتُ حَبابَها","دَمْعاً على وَرْدِ الخُدودِ تَرقرَقا",84,"ق",2,0],["ومَدَاكَ إن جادَ المَداءُ بهِ","غَمْرَ الثناءِ نداكَ يغمُرُه",85,"ر",2,0],["ومدَّ عليكَ للنَّعماءِ ظِلاًّ","فإنَّا منك في ظِلٍّ مَديدِ",86,"د",1,0],["ومِدْحَةٍ ثُقِّفَتْ فلم يَدَعِ التْ","ثقَيْفُ مَيْلاً بها ولا أَوَدا",87,"د",2,0],["ومدَّ عليه ظِلُّ السَّيفِ حتى","تَفَيَّأ للعُلى ظِلاً مَديدا",88,"د",2,0],["ومَدْحٍ فوَّقَتْه لك المعالي","فجاء كأنه بُردٌ قَشيبُ",89,"ب",1,0],["وَمِدرَهُ حَربٍ حَميُها يُتَّقى بِهِ","شَديدُ الرِجامِ بِاللِسانِ وَبِاليَدِ",90,"د",1,0],["وَمُدَبِّرِ الدُنيا وَجاعِلِ لَيلَها","سَكَناً وَمَنزِلِ غَيثِ كُلِّ سَحابِ",91,"ب",1,0],["وَمُدافِعٍ لِلشَيبِ يَخضُبُهُ","وَالشَيبُ نَحوَ المَوتِ يَدفَعُهُ",92,"ع",2,0],["وَمُدَّةُ وَقتٍ لَم يَدَع مُرُّ ما مَضى","عَلِيَّ مِنَ الأَيّامِ إِلّا أَقَلَّها",93,"ل",3,0],["وَمُدامٍ حَكَت سُهَيلَ اِتِّقاداً","في زُجاجٍ كَأَنَّهُ المِرّيخُ",94,"خ",1,1],["وَمَدَّ باعُ الضُحى كَفّاً أَنامِلُها","تُزجي الشُعاعَ وَأَخرى تَلقَطُ الشُهُبا",95,"ب",2,0],["وَمُدمَجٍ كَالنونِ في تَعريقِهِ","أَشهى إِلى العاشِقِ مِن مَعشوقِهِ",96,"ه",1,0],["ومدّ الشيخ في الصحراء لحظاً","كلحظ الصقر في الآفاق جالا",97,"ل",2,0],["ومدَحتُ غلاماً جدّ أبيك","وها أنذا شيخاً يَفَنَا",98,"ن",2,0],["ومُديمةٍ لَمْعَ البروقِ كأنّما","هَزّتْ من البيضِ الصفاحِ متونا",99,"ن",2,1],["ومدرسةٌ أبناؤها فُقَهاؤها","فَمِنْ عالمٍ منهمْ وَمِنْ متعلّمِ",100,"م",1,0],["وَمَدّ ظلّاً على دينِ الهدى خَصِراً","لمّا تلظَّى حرورُ الكفر واحتدما",101,"م",2,0],["ومدامٍ قَدُمَتْ فهيَ إذا","سُئِلتْ تخبرُ عنْ عادِ إِرم",102,"م",1,0],["ومديدِ الخطى كأنّكَ منه","تضعُ اللّبْدَ فوق تيّارِ سَيْلِ",103,"ل",1,1],["ومدحُكَ منها خصّ كلّ لطيمةٍ","بمسكٍ مقيمٍ في التأرّج راحِلِ",104,"ل",1,0],["ومُدامٍ تطيرُ في الصحنِ سُكراً","فتُحَلّ العقُودُ منها وتعقد",105,"د",1,0],["ومدائحُ الحسنِ المبخّرَة التي","فغمتْ بِطيبِ الفخر أَنفَ الطيبِ",106,"ب",1,0],["وَمَدحُ مَن لَيسَ أَهلَ المَدحِ أَحسَبُهُ","عُضواً تَفَصَّلَ مِن قَلبي وَمِن كَبِدي",107,"د",2,0],["ومدامعٍ سحَّتْ وما شحَّتْ على","خدٍّ بحمرةِ لونها قدْ ضُرِّجا",108,"ج",2,0],["وَمَدَّ عَلَيها السَجفَ يَومَ لَقيتُها","عَلى عَجَلٍ تُبّاعُها وَالخَوادِمُ",109,"م",1,0],["وَمَدَت لَدى البيتِ العَتيقِ بِثَوبِهِ","نَهاراً فَما يَدري بِها كَيفَ يَصنَعُ",110,"ع",1,0],["وَمُدامٍ عُتِّقَت في بابِلٍ","مِثلِ عَينِ الديكِ أَو خَمرِ جَدَر",111,"ر",1,0],["وَمُدَجَّجينَ رَمى الدُعاةُ سَوادَهُم","فَمَضوا سِهاماً لِلعِدى وَنُصولا",112,"ل",2,0],["ومَدَّ يمينَ الخيرِ يَملؤُها حَصىً","فلم يكُ فيها بالعَيِيِّ ولا الحَصْرِ",113,"ر",1,0],["وَمُدِّي من حُصونِكِ كلَّ عالٍ","لِيرفعَ في السماواتِ القِبابا",114,"ب",2,0],["وَمدامي وَقَد ظَفَر","ت بِها نَشوةُ الظَفر",115,"ر",1,0],["وَمَدحَ أَفلاطونَ وَالفَلاسِفَه","وَساعَدَتهُ في هَواهُ طائِفَه",116,"ه",1,0],["وَمُدامَةٍ يَكسو الزُجاجَ شُعاعُها","كَالخَيطِ مِن ذَهَبٍ إِذا ما سُلَّتِ",117,"ت",1,1],["ومَدْرَسَةٌ وَدَّ الخَورْنَقُ أَنّه","لَدَيْهَا حَظِيرٌ والسَّدِيرُ غَدِيرُ",118,"ر",1,0],["ومِدْرَهُ غَيْبٍ لا مُعَنّى تَجَارِبٍ","ولابسُ حِلْمٍ لا مُعارُ تَحَلُّم",119,"م",1,0],["وَمُدامَةٍ سَجَدَ المُلوكَ لِذِكرِها","جَلَّت عَنِ التَصريحِ بِالأَسماءِ",120,"ا",2,0],["وَمَدَّت راحَةً كَالماءِ مِنها","إِلى ماءٍ مُعَدٍّ في إِناءِ",121,"ا",2,0],["وَمُدامَةٍ سَجَدَ المُلوكُ لَها","باكَرتُها وَالديكُ قَد صَدَحا",122,"ح",2,0],["وَمُدامَةٍ تَحيا النُفوسُ بِها","جَلَّت مَآثِرُها عَنِ الوَصفِ",123,"ف",1,0],["وَمُدَّ مِن أَبصارِهِم أَشمُسٌ","تَقصُرُ عَنها غايَةُ الوَصفِ",124,"ف",1,0],["وَمُدامَةٍ مِثلِ الخَلوقِ عَتيقَةٍ","حُجِبَت زَماناً في كَنائِسِ دابِقِ",125,"ق",1,0],["ومدُّ كفٍّ نحو تفّاحة","مجروحةِ الخدّينِ بالعضِّ",126,"ض",1,0],["وَمَدخَلٍ غالَ بِهِ شَهيرُ","يَكِلُّ عَنهُ الرامِكُ المَريرُ",127,"ر",1,0],["ومُدامَةٌ في راحَتَيكِ بِذلَتِها","كَمُدامَةٍ في عارِضَيكِ حَميتِها",128,"ت",3,0],["وَمَدُّ وَقتِيَ مِثلُ القِصرِ غايَتُهُ","وَفي الهَلاكِ تَساوى الدُرُّ وَالبَرَدُ",129,"د",1,0],["وَمُدَّت حِبالُ الشَمسِ مِن قَبلِ عَصرِنا","عَلى أُمَمٍ لَم تَتَّرِك لَهُمُ سِلكا",130,"ك",2,0],["وَمَدحُكَ المَرءَ بِالأَخلاقِ يَعدَمُها","لِلحُرِّ ذي اللُبِّ تَبكيتٌ وَتَخجيلُ",131,"ل",1,0],["ومُدامةٍ صلَّى الملوكُ لوجهِها","من كثرةِ التَّبجيلِ والتّعظيمِ",132,"م",1,1],["وَمدارس للطَّالبي","نَ وَمثلها للطالبات",133,"ت",1,0],["ومدُّوا العيونَ إلى فتنةٍ","تجسَّد في حيوانٍ عَجَبْ",134,"ب",1,0],["ومدائنٌ سحْريَّةٌ شارفنَهُ","بنَخيلها وضفافها الخضراءِ",135,"ا",2,0],["ومَدّ شعاع الفجر رَيِّقَ نورهِ","يحيّيك يا ابن الفجر من شَعفاتِها",136,"ت",3,0],["ومدّ في القصر حديثي وكم","ذممت في قصر وأيوان",137,"ن",1,0],["ومدحةً ليَ قد أيمنت طائرها","حيث المدائح في أهل الغنى طيره",138,"ر",2,0],["وَمُديرِهَا الشَّهْمِ الَّذي","كَمُلَتْ بِه صِفَةُ المُديرِ",139,"ر",1,0],["وَمَدحٌ يَكونَ الدَهرُ بَعضَ رُواتِهِ","فَيُمسي وَيُضحي وَهُوَ يَسري وَيَسرَحُ",140,"ح",1,0],["وَمُدرَجَةٌ بَيضاءُ فيها عَظيمَةٌ","تَكادُ لَها الصُمُّ الصِلابُ تَذوبُ",141,"ب",1,0],["ومَدَّتْ بها الآدَابُ ظِلاً على الوَرَى","تَسَاوَتْ به آصالُهُ وهَواجِرُه",142,"ر",2,0],["ومُدَي الصوتَ صخَاباً جريئاً","فمعنى الموتِ من معنى السكُون",143,"ن",1,0],["ومدُّوا له في زمان الجهادِ","ويأبى له الموتُ عمْرًا مديدا",144,"د",2,0],["ومد برود النبت في قنن الربا","وحلى عروس الدوح درا وعقيانا",145,"ن",2,0],["ومدى الرعب الذي تذكرهُ","عدّد الأشواط، غالى في التمادي",146,"د",2,0],["ومدَّتْ برفقٍ كفَّها فتلَمَّسَت","جراحَ بني الدُّنيا فآستْ لهم نُدْبا",147,"ب",2,0],["ومدَّتْ لهُ الأطماعُ في نَزواتهِ","إلى أنْ غَدَتْ كَلاً على نَفْسْهِ حَرْبا",147,"ب",2,0],["ومُدَّتْ إصْبَعٌ لذويهِ فيهِ","فعاثَتْ فوقَ ما عاثُوا فَسادا!",148,"د",2,0],["ومدَحْتُ من لا يستحقُّ وراقَ لي","تَكفيرتي بهجائِه عما مَضى",149,"ض",2,0],["ومُدِّي بالمماتِ إلى حياةٍ","تسَرُّ وبالعَناءِ إلى ارتياح",150,"ح",1,0],["ومَداس أرجلهم ونَهْبُ نِعالهم","شَعبٌ مهيضُ الجانِحين مُضام",151,"م",1,0],["ومُدافِعٌ عما يَدينُ مُخرِّبٌ","ومطالِبٌ بحقوقِه هدّام",151,"م",1,0],["ومَدَّها ببنَتِ الفِكرِ مُرسَلةً","تَرَسُّلَ السَّيلِ أدناهُ كأقصاه",152,"ا",2,0],["ومُدّوا سَواعدَكم انها","معينٌ من الجُهد لا ينضُب",153,"ب",1,0],["وَمُدِلّين بأن قد قَرَنوا !","بالخَنا جاهاً وب \" الحُظِوةِ \" مالا",154,"ل",2,0],["ومُدَّخَرٌ سوطُ العذابِ لناهضٍ","ومُدَّخَرٌ للخاملِ الغِرّ مَنْصِب",155,"ب",1,0],["وَمَدارٌ عَلَيْهِ وَالفَلَكُ الضّخْ","مُ على كَوْكَبِ الشّماكِ مدارُهْ",156,"ر",2,0],["وَمَدّ يَداً مِنْهُ لِبَيْعَةِ خَاسِرٍ،","وَمال المُكْسِدُ المَغبونُ كالرّابحِ المغلي",157,"ل",2,0],["ومدّ ذو العَيْلة فيه الإصْبعا","يشكو إلى اللِّه ويَمري المدمعا",158,"ع",2,0],["ومديح الممدَّحين من النا","سِ جميعاً في كل حينٍ وآن",159,"ن",1,0],["وَمَدَّ يَداً مِنْهُمْ فَتًى مُتَوَقِّحُ","إِلَيْهَا فَجَافَتْ ثُمْ صَافَتْ لِيَسْمَحُوا",160,"ح",3,0]]}