3987.html","مجزوء الكامل"],[429,"الخيل عزوفي صهواتها الشرف","https://www.aldiwan.net/poem40706.html","البسيط"],[429,"لله منزل قصف قد سما شرفا","https://www.aldiwan.net/poem40736.html","البسيط"],[429,"يا ذا الخليل الذي في قوله ثقة","https://www.aldiwan.net/poem40862.html","البسيط"],[432,"حي وجها من الرياض وسيما","https://www.aldiwan.net/poem12376.html","الخفيف"],[432,"هل في قطار النصر نسر واقع","https://www.aldiwan.net/poem12385.html","الكامل"],[432,"خبراني بهول يوم الفراق","https://www.aldiwan.net/poem12469.html","الخفيف"],[432,"هل يا حداة النجب","https://www.aldiwan.net/poem12478.html","مجزوء الرجز"],[432,"دوعدت ولم تف لي بذاك الموعد","https://www.aldiwan.net/poem12481.html","الكامل"],[432,"يا عاذلي لا تطيلا عذلي","https://www.aldiwan.net/poem12482.html","الرجز"],[432,"تيم قلبي أغيد","https://www.aldiwan.net/poem12484.html","مجزوء الرجز"],[432,"ما ضر ذاك الريم ألا يريم","https://www.aldiwan.net/poem12725.html","السريع"],[437,"كل يوم لي من صدودك حاله","https://www.aldiwan.net/poem2501.html","الخفيف"],[437,"هي بشرى الإسلام والأيام","https://www.aldiwan.net/poem2569.html","الخفيف"],[439,"يا غياث العباد إن بخل المز","https://www.aldiwan.net/poem34805.html","الخفيف"],[443,"زرت لندن ربة المدن والشمس","https://www.aldiwan.net/poem55989.html","عموديه"],[447,"لمن الديار عرفتها وكأنها","https://www.aldiwan.net/poem2172.html","الكامل"],[458,"لعلك بالشعب تعلو اليفاعا","https://www.aldiwan.net/poem56128.html","المتقارب"],[458,"جم لها الوادي وعز الذائد","https://www.aldiwan.net/poem56225.html","الرجز"],[461,"جعلت من الحدثان أحصن أدرع","https://www.aldiwan.net/poem15148.html","الكامل"],[461,"خفضا لا موت الا بأجل","https://www.aldiwan.net/poem15467.html","الرمل"],[461,"زرت الامامين عن قلب طويته","https://www.aldiwan.net/poem15942.html","البسيط"],[461,"نازلت همي وهو فارس بهمة","https://www.aldiwan.net/poem16262.html","الكامل"],[464,"طاعة الدمع وعصيان المنام","https://www.aldiwan.net/poem3436.html","عموديه"],[479,"زرت المحل المحلى","https://www.aldiwan.net/poem37030.html","المجتث"],[500,"زر حيش لا تلو النياق لحاسا","https://www.aldiwan.net/poem37995.html","الكامل"],[500,"جاء البشير ليعقوبي بيوسفه","https://www.aldiwan.net/poem38078.html","البسيط"],[515,"سقم الحاظ الحسان الخرد","https://www.aldiwan.net/poem12081.html","الرمل"],[515,"تقبل الله صوماً أنت واصله","https://www.aldiwan.net/poem12203.html","البسيط"],[538,"يا رحى الطحن استريحي","https://www.aldiwan.net/poem47521.html","عموديه"],[538,"قد أثرتم لواعجا وشجونا","https://www.aldiwan.net/poem47587.html","عموديه"],[538,"وجمرة الوجنة ذاب","https://www.aldiwan.net/poem47912.html","عموديه"],[538,"قدك يا جميل","https://www.aldiwan.net/poem47914.html","عموديه"],[538,"زارت ضيوف النيل منا المغربا","https://www.aldiwan.net/poem48267.html","عموديه"],[551,"يوم الحمى ما أنت من همي","https://www.aldiwan.net/poem47212.html","أحذ الكامل"],[551,"ما للخيال ببطن مر يطرق","https://www.aldiwan.net/poem47378.html","الكامل"],[551,"زرت هندا ومن ظلام قميصي","https://www.aldiwan.net/poem48109.html","الطويل"],[553,"تدعي الشوق إن نأت","https://www.aldiwan.net/poem68341.html","مجزوء الخفيف"],[553,"عجبا لطيف خيالك المتجانب","https://www.aldiwan.net/poem68410.html","الكامل"],[558,"يا منزل الركب بين البان فالعلم","https://www.aldiwan.net/poem33496.html","البسيط"],[558,"زر بنات القسوس في دير هنه","https://www.aldiwan.net/poem33712.html","الخفيف"],[562,"زر قبر جرجي الغلام اللاذقي سحرا","https://www.aldiwan.net/poem52534.html","البسيط"],[562,"زر قبر لطوف عكاوي الكريم وقل","https://www.aldiwan.net/poem52542.html","البسيط"],[562,"زر قبر سلمان تلحوق الذي اشتهرت","https://www.aldiwan.net/poem52552.html","البسيط"],[562,"زر ضريح المصطفى وادع له","https://www.aldiwan.net/poem52562.html","البسيط"],[562,"هذا فرنسيس ابن جسطر قد مضى","https://www.aldiwan.net/poem52572.html","الكامل"],[562,"زر قبر كاتبة الكريمة إنها","https://www.aldiwan.net/poem52593.html","الكامل"],[562,"هكذا هكذا وإلا فلا لا","https://www.aldiwan.net/poem52814.html","الخفيف"],[562,"زر تربة في الحمى يا أيها المطر","https://www.aldiwan.net/poem52838.html","البسيط"],[562,"لمن الهوادج في عراء الهوجل","https://www.aldiwan.net/poem52887.html","الكامل"],[575,"لام العذول على هواك وفندا","https://www.aldiwan.net/poem2960.html","الكامل"]],"verses":[["زَرقاءُ مِن زُرقِ بَني مِلاصِ","حَتّى اِتَّقَينَ الشَمسَ بِالنَواصي",0,"ي",1,0],["زَرَّ عَلَيهِ المَلكُ فَضفاضَها","وَإِنَّما زَرَّ عَلى النَسرِ",1,"ر",1,0],["زَرَعتُم وَلَكِن حالَ مِن دونِ زَرعِكُم","جُنودُ أَذىً مِنها دَبىً وَجَرادُ",2,"د",1,0],["زَرَعتُ أَسِنَّتي في كُلِّ قَلبٍ","بِها وَالهامُ تُزرَعُ بِالحَصادِ",3,"د",1,0],["زُرتُ المَليحَةَ وَالرَّقِي","بُ يَروعُني ذاكَ الخَبيثُ",4,"ث",1,1],["زَرَّ الرَّبيعُ عَليهِ جَيبَهُ وَسَرى","إِلَيهِ مُزنٌ لِذايلِ الخِصبِ جَرَّارُ",5,"ر",1,0],["زُرنَ وَالظَّلماءُ عاكِفَةٌ","وَقِناعُ اللَّيلِ مَسدولُ",6,"ل",1,0],["زُرْنا الرِّياضَ بهِ وَقَدْ بَسطَ الخُطا","فِيها الصَّبا وَشَقيقُها يَتَبَسَّمُ",7,"م",1,0],["زُرْناكِ والظِّلُّ ألْمى فاسْتُريبَ بِنا","ولم يُنِخْ عندَكِ الأنْضاءَ حاديها",8,"ي",3,0],["زُرنا بهِ رَشأً يَرتادُ غِرّتَهُ","ذو لِبْدَةٍ بنِجادِ السيفِ مُشْتَمِلُ",9,"ل",1,0],["زُرتَني تَطلُبُ مِنّي غَفلَةً","زَورَةَ الذِئبِ عَلى الشاةِ رَتَع",10,"ع",1,0],["زَرَعْتُ اللِّقاءَ وعالَجْتُهُ","فلمْ أسْتَفِدْ منْهُ إلاّ الفِراقْ",11,"ق",1,0],["زَرعُوا فيّ جَميلاً فجَنَوْا","يحْصِدُ الإنسانُ إلاّ ما زَرَعْ",12,"ع",1,0],["زَرَيْنا على شُهْبِ السّماءِ بشُهْبِها","متى شِئْتِ يا زُهْرَ الثّواقِبِ غوري",13,"ي",1,0],["زَرَعْتً عُرْقْوبَ أَرْضِي مِنْ شَعِيرِكُمْ","جَاءَ الْجَرَادُ فَأَفْنَى زَرْعَ عُرْقُوبِي",14,"ي",1,0],["زَرَتْ بِابْنِ الْحُسَينِ فَمَا","لَهُ فِي الْحُسْنِ مُنْتَسَبُ",15,"ب",1,0],["زُرتَ بَرلينَ فَنادى سَمتُها","نَزَلَت شَمسُ الضُحى بُرجَ الأَسَد",16,"د",1,0],["زَرَعتَ لَنا زَرعاً فَأَخرَجَ شَطأَهُ","وَبِنتُ وَلَمّا نَجتَنِ الثَمَراتِ",17,"ت",1,0],["زُرتُها وَالشَقاءُ يَجري وَرائي","وَشُعاعُ الرَجاءِ يَسري أَمامي",18,"م",2,0],["زُرتُها مَوهِناً وَفي طَيِّ نَفسي","ذِلَّةَ الصَبِّ وَاِنكِسارُ اليَتامى",19,"م",2,0],["زُرناكَ لَم تَأذَن كَأَنَّكَ غافِلٌ","ما كانَ مِنكَ لِواجِبٍ إِغفالُ",20,"ل",1,0],["زَرْتُ حِمَى الحَسْنَاءِ وَالشَّمسُ قَدْ","تَنَزَّلَتْ عَنْ عَرْشِهَا القَائِمِ",21,"م",1,1],["زُر خَيرَ قَبرٍ بِالعِراقِ يُزارُ","وَاِعصِ الحِمارَ فَمَن نَهاكَ حِمارُ",22,"ر",1,1],["زُرقُ العُيونِ إِذا جاوَرتَهُم سَرَقوا","ما يَسرقُ العَبُد أَو نابَأتَهُم كَذَبوا",23,"ب",3,1],["زُر أيها الملك المحبوب موطنهم","ولو زيارة عجلان ومُجتاز",24,"ز",1,0],["زُرِ الهند إن رمت العيان فكم ترى","على الأرض من غُبر هناك ومن شُعث",25,"ث",1,0],["زر ردهة التأريخ إن فناءها","للمجد من أبناء يعرب متحف",26,"ف",1,0],["زُر السجن في بغداد زورة راحم","لتَشهَد للأنكاد أفجع مشهد",27,"د",1,1],["زرقة جسمي وبياض ثلجِها","سنجابِي الأبلق أيَّام الشتا",28,"ت",2,0],["زرت أبوابه فقرَّب شخصي","ومحا عُسرتي ونوَّه ذِكري",29,"ي",1,0],["زُرقة الجسم وابْيضاض ثلوج","ألبساني ثوبَ العذابِ مشهر",30,"ر",1,0],["زُرقٌ يُنَكنَ بسُمرٍ ذُبّلٍ أبداً","وكلُّهُنَّ بريئاتٌ من السُّبَبِ",31,"ب",1,0],["زُرْهم على ثقةٍ مَزَارَ مُحَصِّلٍ","مالاً فلستَ كَضَارِبٍ بِقداحِ",32,"ح",1,0],["زُرُوعٌ سقاها اللّه رِيّاً فَأثْمرَتْ","عُتِيّاً فأضْحَتْ وَهْيَ للنَّارِ تُحْصَدُ",33,"د",1,0],["زرتُ ابن يحيى الذي يؤمِّلُه","كلُّ أجبِّ السَّنام مُنتاضِه",34,"ض",2,0],["زرابيُّ كسرى بثَّها في صِحَانه","ليُحضِرَ وفداً أو ليجمع مجمعا",35,"ع",2,0],["زرتَ بغداد زورة الغيث أغفى","بالقرى وهو زائر فأضافا",36,"ف",2,0],["زُرتموه والصالحاتُ عليه","مقبلاتٌ فأدبر الإقبالُ",37,"ل",1,0],["زرت بالامس الروض امتع عيني","واذا الورد فيه ذو اكمام",38,"م",1,0],["زرتها معولا بصبح ولكن","لم ينبهها من كرى اعوالي",39,"ي",1,0],["زره تجد صور الحياة جلية","فتود حين تزول لو تتمادى",40,"د",2,0],["زرق الجلاليب الذين يحبهم","هم منه في حفر القبور براء",41,"ا",2,0],["زُرنَها وَالرَبيعُ فَصلاً فَخَفَّت","نَحوَ رَكبَيكُما خُفوفَ المَشوقِ",42,"ق",1,0],["زُرناهُ لِلأَمرِ الَّذي لَم يُعهَدِ","لِلصَيدِ وَالنُزهَةِ وَالتَمَرُّدِ",43,"د",1,0],["زرنيخنا يطفو ذرواً ميتاً","ويغوص حين يذاب وهو مرصّصُ",44,"ص",1,0],["زُرتَ رِفهاً فَأَخلَقَ الوَصلُ بِالوَص","لِ كَما يُخلِقُ الرِداءُ القَشيبُ",45,"ب",1,0],["زُرتُهُ تِلوَ غُرَّةِ الشَهرِ بِالطَي","رِ المَيامينِ وَالنُجومِ السُعودِ",46,"د",1,0],["زُرتُهُ مُكرَهاً عَلَيهِ وَما كُن","تُ لِمِثلِ العَلاءِ بِالزُوّارِ",47,"ر",1,0],["زَرَعتُ الرَجاءَ في ذَراكَ مُبَكِّراً","وَجُلَّ حَصادِ المَرءِ مِن حَيثُ يَزرَعُ",48,"ع",1,0],["زُرَيقَةٌ أُمُّها وَالفالُ يُخبِرُني","عَن نائِلٍ مِن هَواها سَوفَ تُرزَقَهُ",49,"ق",2,0],["زُرتَ بِالدارِعينَ أَهلَ البُقُلّا","رِ فَأَجلَوا عَن صاغِري صاغِرينا",50,"ن",2,0],["زراعة القلب.. تشفي بعض من عشقو","وما لقلبي –إذا أحببت جراح",51,"ح",1,0],["زُرتَ القُبورَ قُبورَ أَهلَ المُلكِ في ال","دُنيا وَأَهلِ الرَتعِ في الشَهَواتِ",52,"ت",1,0],["زُرتُ القُبورَ فَحيلَ بَي","نَ الزَورِ فيها وَالمَزورِ",53,"ر",1,0],["زُرهُ وَاِبدَأ أَيّامَهُ بِالتَهاني","ثُمَّ بادِر أَموالَهُ بِالتَعازي",54,"ز",2,0],["زَرَعَ الجودَ في البِلادِ وَساوى","فيهِ بَينَ الوِهادِ وَالأَقوازِ",54,"ز",1,0],["زُرتُهُ مادِحاً فَرَنَّحَهُ الجو","دُ بِإِكرامِنا وَبِالإِعزازِ",54,"ز",1,0],["زُر حَبيباً لَنا بِدَربِ حَبيبٍ","وَاِتلُ شَوقي وَما أَبيتُ أُقاسي",55,"ي",1,0],["زرعٌ على ظُلَلٍ فذا","أبداً لصاحبه رفيق",56,"ق",1,0],["زرتني كالربيع في موكب الزهر له روعة وفيه رواء","ولك الوجه أومض الحسن فيه",57,"ه",1,0],["زرعَ الشَّيبُ بفوديّ الأسى","فنما منه كثيرٌ من قليلِ",58,"ل",1,0],["زرتُ الحبائبَ والأعادي دونها","كضراغمٍ تُذكي العيونَ غضابا",59,"ب",2,0],["زَرَعتُ لَهُ في الصَدرِ مِنّي مَوَدَّةً","أَقامَت عَلى قَلبي رَقيباً مِنَ الحُبِّ",60,"ب",1,0],["زُرتَ الخَليفَةَ زَورَةً مَيمونَةً","مَذكورَةً قَطَعَت رَجاءَ الحُسَّدِ",61,"د",1,0],["زرديَّةٌ حلقاتُها","ترنو إلينا بالحدقْ",62,"ق",1,1],["زرتُهُ مرتينِ والحمدُ لل","هِ فعاينْتُ خيرَ تلكَ الزيارَهْ",63,"ه",1,1],["زرتهُمُ صحبةً وودَّا","ألفيتُهم مغلقينَ بابا",64,"ب",2,1],["زرقُ الأعادي وبيضُ السحبِ واجدةٌ","على دمشق فلا كانوا ولا السحبُ",65,"ب",1,0],["زُرْقُ العمائمِ أيُّ موتٍ أحمرٍ","قد ساقهُ هذا العدوُّ الأزرقُ",66,"ق",1,0],["زُرَّت عَلَيهِ جُبَّةٌ مَوشِيَّةٌ","بِمَقيلِهِ أُختٌ لَها أَسمالُ",67,"ل",1,0],["زَرَّ الحَديدُ عَلَيهِ جَيبَ حَمامَةٍ","وَرقاءَ في غَبَشِ العَجاجِ الأَقتَمِ",68,"م",1,0],["زَرَعنَ الهَوى في القَلبِ ثُمَّ سَقَينَهُ","صُباباتِ ماءِ الشَوقِ بِالأَعيُنِ النُجلِ",69,"ل",1,0],["زُرني فَلَو كُنتَ تَسخو ب