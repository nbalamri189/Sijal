{"poems":[[53,"ما هاج من ذي طرب مخماص","https://www.aldiwan.net/poem30179.html","الرجز"],[53,"قرت عيون المجد والفخر","https://www.aldiwan.net/poem30478.html","السريع"],[53,"هوى لكما إن الشباب يعاد","https://www.aldiwan.net/poem30513.html","الطويل"],[53,"لحيا عهدهن حيا العهاد","https://www.aldiwan.net/poem30619.html","الوافر"],[63,"زرت المليحة والرقيب","https://www.aldiwan.net/poem45710.html","مجزوء الكامل"],[63,"أكوكب ما أرى يا سعد أم نار","https://www.aldiwan.net/poem45803.html","البسيط"],[63,"وظباء من بني أسد","https://www.aldiwan.net/poem45804.html","المديد"],[63,"ومعرس للهو يسحب ذيله","https://www.aldiwan.net/poem45858.html","الكامل"],[63,"لواعج الحب أخفيها وأبديها","https://www.aldiwan.net/poem46166.html","البسيط"],[63,"رنا وناظره بالسحر مكتحل","https://www.aldiwan.net/poem46198.html","البسيط"],[3,"يا أبا اليقظان أغواك الطمع","https://www.aldiwan.net/poem172.html",""],[77,"فلاحة مثلي ممقوتة","https://www.aldiwan.net/poem35911.html","المتقارب"],[77,"خدع الشوق فؤادي فانخدع","https://www.aldiwan.net/poem35986.html","الرمل"],[77,"ولما اجتلينا من نجوم قبابنا","https://www.aldiwan.net/poem36422.html","الطويل"],[77,"أشكو إلى الصيد من أبناء يعقوب","https://www.aldiwan.net/poem36752.html","البسيط"],[77,"لك الحق الذي يجب","https://www.aldiwan.net/poem36769.html","مجزوء الوافر"],[86,"من ليوم نحن فيه من لغد","https://www.aldiwan.net/poem10478.html","الرمل"],[86,"سلام على الإسلام بعد محمد","https://www.aldiwan.net/poem10494.html","الطويل"],[86,"صفحة البرق أومضت في الغمام","https://www.aldiwan.net/poem10914.html","الخفيف"],[86,"جاز بي عرفها فهاج الغراما","https://www.aldiwan.net/poem68932.html","الخفيف"],[73,"إعجب لحال السرو كيف تحال","https://www.aldiwan.net/poem11939.html","الكامل"],[93,"زرت حمى الحسناء والشمس قد","https://www.aldiwan.net/poem11365.html","السريع"],[54,"زر خير قبر بالعراق يزار","https://www.aldiwan.net/poem27432.html","الكامل"],[30,"زرق العيون إذا جاورتهم سرقوا","https://www.aldiwan.net/poem29615.html","البسيط"],[88,"قل للحكومات في البلقان هل علقت","https://www.aldiwan.net/poem44467.html","البسيط"],[88,"لقد جمع الدهر المكايد كلها","https://www.aldiwan.net/poem44791.html","الطويل"],[88,"أنا بالحكومة والسياسة أعرف","https://www.aldiwan.net/poem44808.html","الكامل"],[88,"زر السجن في بغداد زورة راحم","https://www.aldiwan.net/poem45020.html","الطويل"],[72,"يا سيدي عطفا فإني ميت","https://www.aldiwan.net/poem18425.html","الرجز"],[72,"يوم صحو فاجعله لي يوم سكر","https://www.aldiwan.net/poem18694.html","الخفيف"],[72,"أيها البحر نائلا وعلوما","https://www.aldiwan.net/poem18744.html","الخفيف"],[51,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8499.html","البسيط"],[51,"ومدامة أغنت عن المصباح","https://www.aldiwan.net/poem9412.html","الكامل"],[51,"أبين ضلوعي جمرة تتوقد","https://www.aldiwan.net/poem9992.html","الطويل"],[51,"أنهضه في أوان إنهاضه","https://www.aldiwan.net/poem64941.html","المنسرح"],[51,"أمون من العظعاظ عند مروقها","https://www.aldiwan.net/poem65078.html","الطويل"],[51,"أيها الماجد الذي بهر المداح","https://www.aldiwan.net/poem65475.html","الخفيف"],[51,"قل لأيوب والكلام سجال","https://www.aldiwan.net/poem65887.html","الخفيف"],[89,"انت في شعر كان فتحا مبينا","https://www.aldiwan.net/poem44626.html","الخفيف"],[89,"كنت طاغور ماثلا في خيالي","https://www.aldiwan.net/poem44752.html","الخفيف"],[89,"أبدى يمثل يوسف واعادا","https://www.aldiwan.net/poem44753.html","الكامل"],[85,"شكرتك في أجداثها الشهداء","https://www.aldiwan.net/poem7258.html","الكامل"],[85,"أيها الكاتب المصور صور","https://www.aldiwan.net/poem63704.html","الخفيف"],[43,"وشامخ من الجبال أقود","https://www.aldiwan.net/poem9548.html","الرجز"],[62,"أنعم إذابة ما سكبت فإنه","https://www.aldiwan.net/poem52193.html","الكامل"],[45,"يا سعيد والأمر فيك عجيب","https://www.aldiwan.net/poem11045.html","الخفيف"],[45,"من عذيري من الظباء الغيد","https://www.aldiwan.net/poem63503.html","الخفيف"],[45,"للعلاء ابن صاعد في مدح","https://www.aldiwan.net/poem63607.html","الخفيف"],[45,"أحاجيك هل للحب كالدار تجمع","https://www.aldiwan.net/poem64680.html","الطويل"],[45,"كأنك السيف حداه ورونقه","https://www.aldiwan.net/poem65200.html","البسيط"],[45,"هم ألى رائحون أم غادونا","https://www.aldiwan.net/poem66662.html","الخفيف"],[99,"القصيدة الدمشقية","https://www.aldiwan.net/poem6529.html","عموديه"],[49,"إن كنت تطمع في الحياة فهات","https://www.aldiwan.net/poem10393.html","الكامل"],[49,"لله عاقبة الأمور","https://www.aldiwan.net/poem62098.html","مجزوء الكامل"],[66,"زار والليل مؤذن بالبراز","https://www.aldiwan.net/poem38491.html","الخفيف"],[66,"طمعي في لقاك بعد إياس","https://www.aldiwan.net/poem40639.html","الخفيف"],[97,"هي محنة وزمان ضيق","https://www.aldiwan.net/poem24855.html","مجزوء الكامل"],[97,"السراب الخؤون والصحراء","https://www.aldiwan.net/poem24994.html","الخفيف"],[80,"أي روح لي في الريح القبول","https://www.aldiwan.net/poem31315.html","الرمل"],[80,"ودجنة كالنقس صب على الثرى","https://www.aldiwan.net/poem31573.html","الكامل"],[44,"ومنفرد بالحسن خلو من الهوى","https://www.aldiwan.net/poem30290.html","الطويل"],[44,"داع دعا بلسان هاد مرشد","https://www.aldiwan.net/poem30532.html","الكامل"],[69,"زردية حلقاتها","https://www.aldiwan.net/poem28026.html","مجزوء الكامل"],[69,"زرته مرتين والحمد لله","https://www.aldiwan.net/poem28058.html","الخفيف"],[69,"زرتهم صحبة وودا","https://www.aldiwan.net/poem28453.html","مخلع البسيط"],[69,"وافى الكتاب الذي تعنو له الكتب","https://www.aldiwan.net/poem29125.html","البسيط"],[69,"لا أنكر التسمير في أحداقهم","https://www.aldiwan.net/poem29225.html","الكامل"],[74,"نهر كما سال اللمى سلسال","https://www.aldiwan.net/poem13208.html","الكامل"],[74,"وأغر يسفر للعوالي والعلى","https://www.aldiwan.net/poem13240.html","الكامل"],[33,"ليالي أصبو بالعشي وبالضحى","https://www.aldiwan.net/poem25837.html","الطويل"],[81,"أحلى من الأمن لا يأوي لذي كمد","https://www.aldiwan.net/poem61536.html","البسيط"],[52,"وصاحب يسخر في موعده","https://www.aldiwan.net/poem27089.html","السريع"],[52,"لا بد للشيب أن يبدو وإن حجبا","https://www.aldiwan.net/poem27253.html","البسيط"],[67,"ذو يراع يروع كالسيف إما","https://www.aldiwan.net/poem18069.html","الخفيف"],[48,"يا خليلي من بني مخزوم","https://www.aldiwan.net/poem65102.html","الخفيف"],[50,"يا لقوم للحبيب المذكر","https://www.aldiwan.net/poem63802.html","الرمل"],[50,"أشادن إن ريمة لا تصاد","https://www.aldiwan.net/poem63916.html","الوافر"],[46,"سمتك أمك دينارا وقد كذبت","https://www.aldiwan.net/poem22830.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85446","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85800","الكامل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85324","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202538","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42734","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54930","الكامل"],[104,"","https://poetry.dctabudhabi.ae/diwan/poem/199486","الوافر"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43704","المقتضب"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43842","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43640","الطويل"],[99,"","https://poetry.dctabudhabi.ae/diwan/poem/142074","البسيط"],[106,"مبايعة الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179496",""],[106,"من وحي البحر","https://www.poetsgate.com/ViewPoem.aspx?id=179317",""],[106,"ذكرى دنشواي","https://www.poetsgate.com/ViewPoem.aspx?id=179341",""],[106,"راهب الحقل","https://www.poetsgate.com/ViewPoem.aspx?id=179334",""],[106,"على سطح القمر","https://www.poetsgate.com/ViewPoem.aspx?id=179308",""],[67,"ذُو يَراعٍ يَرُوعُ كالسَّيْفِ إمَّا","https://www.poetsgate.com/ViewPoem.aspx?id=14534",""],[90,"ستالينغراد","https://www.poetsgate.com/ViewPoem.aspx?id=179193",""],[90,"ساعة مع البحتري في سامراء ...","https://www.poetsgate.com/ViewPoem.aspx?id=179035",""],[90,"سبيل الجَماهير","https://www.poetsgate.com/ViewPoem.aspx?id=178923",""],[99,"اكتبي لي","https://www.poetsgate.com/ViewPoem.aspx?id=36388",""]],"verses":[["زَرقاءُ مِن زُرقِ بَني مِلاصِ","حَتّى اِتَّقَينَ الشَمسَ بِالنَواصي",0,"ي",1,0],["زَرَّ عَلَيهِ المَلكُ فَضفاضَها","وَإِنَّما زَرَّ عَلى النَسرِ",1,"ر",1,0],["زَرَعتُم وَلَكِن حالَ مِن دونِ زَرعِكُم","جُنودُ أَذىً مِنها دَبىً وَجَرادُ",2,"د",1,0],["زَرَعتُ أَسِنَّتي في كُلِّ قَلبٍ","بِها وَالهامُ تُزرَعُ بِالحَصادِ",3,"د",1,0],["زُرتُ المَليحَةَ وَالرَّقِي","بُ يَروعُني ذاكَ الخَبيثُ",4,"ث",1,1],["زَرَّ الرَّبيعُ عَليهِ جَيبَهُ وَسَرى","إِلَيهِ مُزنٌ لِذايلِ الخِصبِ جَرَّارُ",5,"ر",1,0],["زُرنَ وَالظَّلماءُ عاكِفَةٌ","وَقِناعُ اللَّيلِ مَسدولُ",6,"ل",1,0],["زُرْنا الرِّياضَ بهِ وَقَدْ بَسطَ الخُطا","فِيها الصَّبا وَشَقيقُها يَتَبَسَّمُ",7,"م",1,0],["زُرْناكِ والظِّلُّ ألْمى فاسْتُريبَ بِنا","ولم يُنِخْ عندَكِ الأنْضاءَ حاديها",8,"ي",3,0],["زُرنا بهِ رَشأً يَرتادُ غِرّتَهُ","ذو لِبْدَةٍ بنِجادِ السيفِ مُشْتَمِلُ",9,"ل",1,0],["زُرتَني تَطلُبُ مِنّي غَفلَةً","زَورَةَ الذِئبِ عَلى الشاةِ رَتَع",10,"ع",1,0],["زَرَعْتُ اللِّقاءَ وعالَجْتُهُ","فلمْ أسْتَفِدْ منْهُ إلاّ الفِراقْ",11,"ق",1,0],["زَرعُوا فيّ جَميلاً فجَنَوْا","يحْصِدُ الإنسانُ إلاّ ما زَرَعْ",12,"ع",1,0],["زَرَيْنا على شُهْبِ السّماءِ بشُهْبِها","متى شِئْتِ يا زُهْرَ الثّواقِبِ غوري",13,"ي",1,0],["زَرَعْتً عُرْقْوبَ أَرْضِي مِنْ شَعِيرِكُمْ","جَاءَ الْجَرَادُ فَأَفْنَى زَرْعَ عُرْقُوبِي",14,"ي",1,0],["زَرَتْ بِابْنِ الْحُسَينِ فَمَا","لَهُ فِي الْحُسْنِ مُنْتَسَبُ",15,"ب",1,0],["زُرتَ بَرلينَ فَنادى سَمتُها","نَزَلَت شَمسُ الضُحى بُرجَ الأَسَد",16,"د",1,0],["زَرَعتَ لَنا زَرعاً فَأَخرَجَ شَطأَهُ","وَبِنتُ وَلَمّا نَجتَنِ الثَمَراتِ",17,"ت",1,0],["زُرتُها وَالشَقاءُ يَجري وَرائي","وَشُعاعُ الرَجاءِ يَسري أَمامي",18,"م",2,0],["زُرتُها مَوهِناً وَفي طَيِّ نَفسي","ذِلَّةَ الصَبِّ وَاِنكِسارُ اليَتامى",19,"م",2,0],["زُرناكَ لَم تَأذَن كَأَنَّكَ غافِلٌ","ما كانَ مِنكَ لِواجِبٍ إِغفالُ",20,"ل",1,0],["زَرْتُ حِمَى الحَسْنَاءِ وَالشَّمسُ قَدْ","تَنَزَّلَتْ عَنْ عَرْشِهَا القَائِمِ",21,"م",1,1],["زُر خَيرَ قَبرٍ بِالعِراقِ يُزارُ","وَاِعصِ الحِمارَ فَمَن نَهاكَ حِمارُ",22,"ر",1,1],["زُرقُ العُيونِ إِذا جاوَرتَهُم سَرَقوا","ما يَسرقُ العَبُد أَو نابَأتَهُم كَذَبوا",23,"ب",3,1],["زُر أيها الملك المحبوب موطنهم","ولو زيارة عجلان ومُجتاز",24,"ز",1,0],["زُرِ الهند إن رمت العيان فكم ترى","على الأرض من غُبر هناك ومن شُعث",25,"ث",1,0],["زر ردهة التأريخ إن فناءها","للمجد من أبناء يعرب متحف",26,"ف",1,0],["زُر السجن في بغداد زورة راحم","لتَشهَد للأنكاد أفجع مشهد",27,"د",1,1],["زرقة جسمي وبياض ثلجِها","سنجابِي الأبلق أيَّام الشتا",28,"ت",2,0],["زرت أبوابه فقرَّب شخصي","ومحا عُسرتي ونوَّه ذِكري",29,"ي",1,0],["زُرقة الجسم وابْيضاض ثلوج","ألبساني ثوبَ العذابِ مشهر",30,"ر",1,0],["زُرقٌ يُنَكنَ بسُمرٍ ذُبّلٍ أبداً","وكلُّهُنَّ بريئاتٌ من السُّبَبِ",31,"ب",1,0],["زُرْهم على ثقةٍ مَزَارَ مُحَصِّلٍ","مالاً فلستَ كَضَارِبٍ بِقداحِ",32,"ح",1,0],["زُرُوعٌ سقاها اللّه رِيّاً فَأثْمرَتْ","عُتِيّاً فأضْحَتْ وَهْيَ للنَّارِ تُحْصَدُ",33,"د",1,0],["زرتُ ابن يحيى الذي يؤمِّلُه","كلُّ أجبِّ السَّنام مُنتاضِه",34,"ض",2,0],["زرابيُّ كسرى بثَّها في صِحَانه","ليُحضِرَ وفداً أو ليجمع مجمعا",35,"ع",2,0],["زرتَ بغداد زورة الغيث أغفى","بالقرى وهو زائر فأضافا",36,"ف",2,0],["زُرتموه والصالحاتُ عليه","مقبلاتٌ فأدبر الإقبالُ",37,"ل",1,0],["زرت بالامس الروض امتع عيني","واذا الورد فيه ذو اكمام",38,"م",1,0],["زرتها معولا بصبح ولكن","لم ينبهها من كرى اعوالي",39,"ي",1,0],["زره تجد صور الحياة جلية","فتود حين تزول لو تتمادى",40,"د",2,0],["زرق الجلاليب الذين يحبهم","هم منه في حفر القبور براء",41,"ا",2,0],["زُرنَها وَالرَبيعُ فَصلاً فَخَفَّت","نَحوَ رَكبَيكُما خُفوفَ المَشوقِ",42,"ق",1,0],["زُرناهُ لِلأَمرِ الَّذي لَم يُعهَدِ","لِلصَيدِ وَالنُزهَةِ وَالتَمَرُّدِ",43,"د",1,0],["زرنيخنا يطفو ذرواً ميتاً","ويغوص حين يذاب وهو مرصّصُ",44,"ص",1,0],["زُرتَ رِفهاً فَأَخلَقَ الوَصلُ بِالوَص","لِ كَما يُخلِقُ الرِداءُ القَشيبُ",45,"ب",1,0],["زُرتُهُ تِلوَ غُرَّةِ الشَهرِ بِالطَي","رِ المَيامينِ وَالنُجومِ السُعودِ",46,"د",1,0],["زُرتُهُ مُكرَهاً عَلَيهِ وَما كُن","تُ لِمِثلِ العَلاءِ بِالزُوّارِ",47,"ر",1,0],["زَرَعتُ الرَجاءَ في ذَراكَ مُبَكِّراً","وَجُلَّ حَصادِ المَرءِ مِن حَيثُ يَزرَعُ",48,"ع",1,0],["زُرَيقَةٌ أُمُّها وَالفالُ يُخبِرُني","عَن نائِلٍ مِن هَواها سَوفَ تُرزَقَهُ",49,"ق",2,0],["زُرتَ بِالدارِعينَ أَهلَ البُقُلّا","رِ فَأَجلَوا عَن صاغِري صاغِرين