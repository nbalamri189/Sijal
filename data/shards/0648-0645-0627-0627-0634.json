{"poems":[[47,"إذا كان منا واحد في قبيلة","https://www.aldiwan.net/poem25105.html","الطويل"],[72,"شدا شدو الحمام وماس غصنا","https://www.aldiwan.net/poem20294.html","الوافر"],[51,"رأيت حمالا مبين العمى","https://www.aldiwan.net/poem61861.html","البسيط"],[51,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[45,"دنا السرب إلا أن هجرا يباعده","https://www.aldiwan.net/poem63461.html","الطويل"],[45,"لما وصلت أسماء من حبلنا شكر","https://www.aldiwan.net/poem63563.html","الطويل"],[45,"دموع عليها السكب ضربة لازم","https://www.aldiwan.net/poem65662.html","الطويل"],[61,"وفتية تعلو بها أخطارها","https://www.aldiwan.net/poem51622.html","الرجز"],[44,"سقى عهد الحمى سبل العهاد","https://www.aldiwan.net/poem30558.html","الكامل"],[69,"وما أشبه الحمام بالموت لامرئ","https://www.aldiwan.net/poem28716.html","الطويل"],[33,"يا للرجال لهم بات يعروني","https://www.aldiwan.net/poem25770.html","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[90,"قتل العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179140",""],[45,"دَنَا السّرْبُ، إلاّ أنّ هَجراً يُباعِدُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=32954",""],[158,"أعد نظرا في قصة ليس تحجب","https://www.aldiwan.net/poem59091.html","الطويل"],[208,"يا رب عفواً فإني خائف وجل","https://www.aldiwan.net/poem13305.html","البسيط"],[247,"أتعرف من هنيدة رسم دار","https://www.aldiwan.net/poem2088.html","الوافر"],[250,"أما وجفونك المرضى الصحاح","https://www.aldiwan.net/poem1418.html",""],[259,"فديناك طرق الجدا جدى من الهزل","https://www.aldiwan.net/poem38209.html","الطويل"],[269,"سقاك الحيا الوسمى ربعا تأيدا","https://www.aldiwan.net/poem52098.html","الطويل"],[273,"ولا ودعوا يوم النوى جارة الحمى","https://www.aldiwan.net/poem25412.html","الطويل"],[273,"أتجحد قتلي ربة الشنف والخرص","https://www.aldiwan.net/poem25494.html","الطويل"],[280,"وهو الذي لم يزل تهمي أنامله","https://www.aldiwan.net/poem32887.html","البسيط"],[364,"كأنك مخلوق كما شاءت العلا","https://www.aldiwan.net/poem17169.html","الطويل"],[374,"تنبه دهري من عهود معاهدي","https://www.aldiwan.net/poem59454.html","الطويل"],[406,"أيا منقذي والحادثات تنوشني","https://www.aldiwan.net/poem32284.html","الطويل"],[406,"وما أشكو تلون أهل ودي","https://www.aldiwan.net/poem32285.html","الوافر"],[413,"لأسماء دار حيث منقطع الرمل","https://www.aldiwan.net/poem53930.html","الطويل"],[413,"لمن أينق يا سعد ترقل أو تخدي","https://www.aldiwan.net/poem53991.html","الطويل"],[413,"أتنكر منك ما تطوي الضلوع","https://www.aldiwan.net/poem54084.html","الوافر"],[451,"أشح بوجهك عن فكري وعن نظري","https://www.aldiwan.net/poem61579.html","البسيط"],[456,"أما لنجوم ليلك بالمصلى","https://www.aldiwan.net/poem56087.html","الوافر"],[462,"صفاتك تفغم الآفاق طيبا","https://www.aldiwan.net/poem3170.html","عموديه"],[462,"أقام الوجد بعدهم وساروا","https://www.aldiwan.net/poem3209.html","عموديه"],[462,"سقى دمع العين لا دموع الغمائم","https://www.aldiwan.net/poem3271.html","عموديه"],[538,"أغذو تلادا من الأشعار أصلحها","https://www.aldiwan.net/poem56705.html","البسيط"],[573,"ما العيش ري ولا الحمام صدى","https://www.aldiwan.net/poem3074.html","المنسرح"]],"verses":[["وَما اِشتَوَرَت إِلّا وَأَصبَحَ شَيخَها","وَلا أَحرَبَت إِلّا وَكانَ فَتاها",0,"ا",3,0],["وما أشهى عذاراً قد سباني","بحرفٍ جاء في حسنٍ لمعنى",1,"ن",2,0],["وما اشْتهى ذاك ولكنَّه","فرَّ من اللُّؤْم إلى الجَهْدِ",2,"د",1,0],["وما أشكوه منك إلى رحيم","وشكري في ذَراهُ مستضامُ",3,"م",1,0],["وَما اِشتَدَّ خَطبُ الدَهرِ إِلّا اِنبَرى لَهُ","أَبو نَهشَلٍ حَتّى تَلينَ شَدائِدُه",4,"د",2,0],["وَما أَشرَفُ البَكرَينِ مَن لَم يَكُن لَهُ","حَبيبٌ أَباً يَومَ التَفاضُلِ أَو عَمرُو",5,"ر",2,0],["وَما اِشتَدَّ خَطبُ الدَهرِ إِلّا أَلانَهُ","حَميدُ بَني عَبدِ الحَميدِ الأَكارِمِ",6,"م",1,0],["وما اشتَهت أنفسُها شِعارُها","تَطرَّبَت لنُزهَةٍ أقمارُها",7,"ر",3,0],["وَما اِشتَبَهَت طَريقُ المَجدِ إِلّا","هَداكَ لِقِبلَةِ المَعروفِ هادِ",8,"د",1,0],["وما أشبهَ الحمَّامَ بالموتِ لامرئٍ","تَذَكَّرَ لكنْ أينَ مَنْ يتذكرُ",9,"ر",1,1],["وَما أُشارِكُ في رَأيِي أَخا ضَعَفٍ","وَلا أَقولُ أَخي مَن لا يُواتيني",10,"ن",2,0],["وَمَا أَشَدَّ وُدَّهُ","لَوُ يُسْتَدَامُ فِي حَجَرْ",11,"ر",1,0],["وما اشتكائي إلى الأشعارِ من مُضَضٍ","إلا شكيَّةَ محروبٍ لمحروب",12,"ب",1,0],["وَما اشتَدّ خَطْبُ الإ انبرَى لهُ","أبُو نَهشَلٍ، حَتّى تَلينَ شَدائِدُهْ",13,"د",2,0],["وما أشتكى إلا توثب عاجز","على قادر سهل عليه التوثب",14,"ب",1,0],["وما اشبب في معنى اهيم به","الا وانت لعمري القصد والامل",15,"ل",1,0],["وَما أَشجاكَ مِن أَطلالِ هِندٍ","وَقَد شَطَّت لِطِيَّتِها نَواها",16,"ا",3,0],["وَما أَشكو الزَمانَ وَأَنتَ فيهِ","وان أَصبحتَ مَحصوص الجِناحِ",17,"ح",1,0],["وما اشتغلت نفسي بغيرك والسوى","ولكنها عن غير ودك في شغل",18,"ل",1,0],["وَما اِشتملت أَرض عَلى مثل أَحمَد","أَبروأ وَفي من تقمص واِرتَدى",19,"د",2,0],["وَمَا أَشعَبِي الخِلالِ إِلا كَباسِط","لِيَشرَبَ راحاً بِالإِشارَةِ فِي الوَهدِ",20,"د",1,0],["وَما اشْتَبَهَتْ حَالُ المُلُوكِ وَحالُهُ","ألَمْ تَرَ أنَّ الفَضْلَ لَيْسَ مِنَ النَّقْصِ",21,"ص",1,0],["وَما أشَبِّهُهُ بِاللَيثِ وَهوَ لَهُ","صَيدٌ وَكيفَ يُقاسُ الصَقرُ بِالخَرَبِ",22,"ب",1,0],["وَما أشتَكي إلا نُهوضَ نَداكُمُ","وَتَقصيرَ ما أَنهَضتُهُ مِن مَدائِحِ",23,"ح",1,0],["وما اشتدت الأيام بالهجر شدةً","ولكنها تاقت لمخض الفوائد",24,"د",1,0],["وما أشتكِي شوقي إليكَ تجلُّداً","على أَنَّه بَلْبَالُ قَلبِي وَبثُّهُ",25,"ث",2,0],["وما أشكُو تلَوُّنَ أهلِ وُدّي","ولو أجْدَتْ شَكَّيتُهم شكوْتُ",26,"ت",1,1],["وما أشْفَقوا من وخز دهياء طخيةٍ","كما أشفقوا يوم النَّوال من البذل",27,"ل",1,0],["وما أشبَهَتْكَ المرسَلات بوبلها","بما لك من جدوًى وما لك من رفد",28,"د",1,0],["وما أشكو الهوى لو أنَّ قلبي","تَحَمَّلَ بالهوى ما يستطيع",29,"ع",1,0],["وما أشك بإخلاص لقادتها","من أنقذوها من الطاغوت والخور",30,"ر",1,0],["وما أشكو السهادَ لأنّ جَفني","تنافَى عنده فتحٌ وطبْقُ",31,"ق",1,0],["وما أشكو سوى حسنات دهري","فلو حاققته كانت ذنوبا",32,"ب",2,0],["وما أشكو غليها ضنكَ عيشٍ","ولولا الفضلُ ما سجن الهزار",33,"ر",1,0],["وما أشك لا أشك النوى بعد بذلها","إلى ابن نظيف ذي العلى والمكارم",34,"م",1,0],["وَما أُشارِكُهُم في طَرقِ فَحلِهُمُ","وَلا بسَهلٍ أُراعيهِم وَلا جَبَلِ",35,"ل",1,0],["وما اشْتكَتْ بَعد وِرْدِه ظَمأً","إِذ تَرِدُ العِدَّ مِنه لاَ الثَّمدا",36,"د",2,0]]}