{"poems":[[49,"إذا كان منا واحد في قبيلة","https://www.aldiwan.net/poem25105.html","الطويل"],[74,"شدا شدو الحمام وماس غصنا","https://www.aldiwan.net/poem20294.html","الوافر"],[53,"رأيت حمالا مبين العمى","https://www.aldiwan.net/poem61861.html","البسيط"],[53,"كبرت فغيرك الغر الغلام","https://www.aldiwan.net/poem66077.html","الوافر"],[47,"دنا السرب إلا أن هجرا يباعده","https://www.aldiwan.net/poem63461.html","الطويل"],[47,"لما وصلت أسماء من حبلنا شكر","https://www.aldiwan.net/poem63563.html","الطويل"],[47,"دموع عليها السكب ضربة لازم","https://www.aldiwan.net/poem65662.html","الطويل"],[63,"وفتية تعلو بها أخطارها","https://www.aldiwan.net/poem51622.html","الرجز"],[46,"سقى عهد الحمى سبل العهاد","https://www.aldiwan.net/poem30558.html","الكامل"],[71,"وما أشبه الحمام بالموت لامرئ","https://www.aldiwan.net/poem28716.html","الطويل"],[35,"يا للرجال لهم بات يعروني","https://www.aldiwan.net/poem25770.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54929","الرجز"],[92,"قتل العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179140",""],[47,"دَنَا السّرْبُ، إلاّ أنّ هَجراً يُباعِدُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=32954",""],[164,"أعد نظرا في قصة ليس تحجب","https://www.aldiwan.net/poem59091.html","الطويل"],[214,"يا رب عفواً فإني خائف وجل","https://www.aldiwan.net/poem13305.html","البسيط"],[254,"أتعرف من هنيدة رسم دار","https://www.aldiwan.net/poem2088.html","الوافر"],[257,"أما وجفونك المرضى الصحاح","https://www.aldiwan.net/poem1418.html",""],[266,"فديناك طرق الجدا جدى من الهزل","https://www.aldiwan.net/poem38209.html","الطويل"],[276,"سقاك الحيا الوسمى ربعا تأيدا","https://www.aldiwan.net/poem52098.html","الطويل"],[280,"ولا ودعوا يوم النوى جارة الحمى","https://www.aldiwan.net/poem25412.html","الطويل"],[280,"أتجحد قتلي ربة الشنف والخرص","https://www.aldiwan.net/poem25494.html","الطويل"],[287,"وهو الذي لم يزل تهمي أنامله","https://www.aldiwan.net/poem32887.html","البسيط"],[371,"كأنك مخلوق كما شاءت العلا","https://www.aldiwan.net/poem17169.html","الطويل"],[382,"تنبه دهري من عهود معاهدي","https://www.aldiwan.net/poem59454.html","الطويل"],[415,"أيا منقذي والحادثات تنوشني","https://www.aldiwan.net/poem32284.html","الطويل"],[415,"وما أشكو تلون أهل ودي","https://www.aldiwan.net/poem32285.html","الوافر"],[422,"لأسماء دار حيث منقطع الرمل","https://www.aldiwan.net/poem53930.html","الطويل"],[422,"لمن أينق يا سعد ترقل أو تخدي","https://www.aldiwan.net/poem53991.html","الطويل"],[422,"أتنكر منك ما تطوي الضلوع","https://www.aldiwan.net/poem54084.html","الوافر"],[458,"أشح بوجهك عن فكري وعن نظري","https://www.aldiwan.net/poem61579.html","البسيط"],[463,"أما لنجوم ليلك بالمصلى","https://www.aldiwan.net/poem56087.html","الوافر"],[469,"صفاتك تفغم الآفاق طيبا","https://www.aldiwan.net/poem3170.html","عموديه"],[469,"أقام الوجد بعدهم وساروا","https://www.aldiwan.net/poem3209.html","عموديه"],[469,"سقى دمع العين لا دموع الغمائم","https://www.aldiwan.net/poem3271.html","عموديه"],[545,"أغذو تلادا من الأشعار أصلحها","https://www.aldiwan.net/poem56705.html","البسيط"],[580,"ما العيش ري ولا الحمام صدى","https://www.aldiwan.net/poem3074.html","المنسرح"],[659,"","https://poetry.dctabudhabi.ae/diwan/poem/76571","المتقارب"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96977","الطويل"],[680,"","https://poetry.dctabudhabi.ae/diwan/poem/96990","الطويل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86858","الطويل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53908","البسيط"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/53880","البسيط"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59563","السريع"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56325","الطويل"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122027","المتقارب"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124723","السريع"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53105","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202395","المتقارب"],[3014,"","https://poetry.dctabudhabi.ae/diwan/poem/118968","البسيط"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87405","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89267","الوافر"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103956","الوافر"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48277","الطويل"],[3529,"","https://poetry.dctabudhabi.ae/diwan/poem/102445","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108312","البسيط"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45754","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91165","الطويل"],[3911,"","https://poetry.dctabudhabi.ae/diwan/poem/35631","الطويل"],[4432,"","https://poetry.dctabudhabi.ae/diwan/poem/83177","البسيط"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/58068","الطويل"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72509","الطويل"],[1012,"فقر الأولياء","https://www.poetsgate.com/ViewPoem.aspx?id=186275",""],[4914,"بمن أتداوى والدوا معك وسدوا","https://www.poetsgate.com/ViewPoem.aspx?id=170940",""],[4988,"أحفاد الاجداد","https://www.poetsgate.com/ViewPoem.aspx?id=196636",""],[4988,"مدرسة دنياي","https://www.poetsgate.com/ViewPoem.aspx?id=214087",""],[5338,"رمتني في صرفها الليالي","https://www.poetsgate.com/ViewPoem.aspx?id=187598",""],[5358,"وقفتُ حزينَ القلبِ","https://www.poetsgate.com/ViewPoem.aspx?id=187082",""],[5431,"إلى حبيب الروح...","https://www.poetsgate.com/ViewPoem.aspx?id=214054",""],[5790,"هذا العذيب وهذا الرند والبان","https://www.poetsgate.com/ViewPoem.aspx?id=112145",""],[5795,"أبيت ومن نفسي لنفسي لائم","https://www.poetsgate.com/ViewPoem.aspx?id=167911",""],[5809,"شربة من يده الشريفة عليه الصلاة والسلام","https://www.poetsgate.com/ViewPoem.aspx?id=205112",""],[5809,"بانت سعاد","https://www.poetsgate.com/ViewPoem.aspx?id=205310",""]],"verses":[["وَما اِشتَوَرَت إِلّا وَأَصبَحَ شَيخَها","وَلا أَحرَبَت إِلّا وَكانَ فَتاها",0,"ا",3,0],["وما أشهى عذاراً قد سباني","بحرفٍ جاء في حسنٍ لمعنى",1,"ن",2,0],["وما اشْتهى ذاك ولكنَّه","فرَّ من اللُّؤْم إلى الجَهْدِ",2,"د",1,0],["وما أشكوه منك إلى رحيم","وشكري في ذَراهُ مستضامُ",3,"م",1,0],["وَما اِشتَدَّ خَطبُ الدَهرِ إِلّا اِنبَرى لَهُ","أَبو نَهشَلٍ حَتّى تَلينَ شَدائِدُه",4,"د",2,0],["وَما أَشرَفُ البَكرَينِ مَن لَم يَكُن لَهُ","حَبيبٌ أَباً يَومَ التَفاضُلِ أَو عَمرُو",5,"ر",2,0],["وَما اِشتَدَّ خَطبُ الدَهرِ إِلّا أَلانَهُ","حَميدُ بَني عَبدِ الحَميدِ الأَكارِمِ",6,"م",1,0],["وما اشتَهت أنفسُها شِعارُها","تَطرَّبَت لنُزهَةٍ أقمارُها",7,"ر",3,0],["وَما اِشتَبَهَت طَريقُ المَجدِ إِلّا","هَداكَ لِقِبلَةِ المَعروفِ هادِ",8,"د",1,0],["وما أشبهَ الحمَّامَ بالموتِ لامرئٍ","تَذَكَّرَ لكنْ أينَ مَنْ يتذكرُ",9,"ر",1,1],["وَما أُشارِكُ في رَأيِي أَخا ضَعَفٍ","وَلا أَقولُ أَخي مَن لا يُواتيني",10,"ن",2,0],["وَمَا أَشَدَّ وُدَّهُ","لَوُ يُسْتَدَامُ فِي حَجَرْ",11,"ر",1,0],["وما اشتكائي إلى الأشعارِ من مُضَضٍ","إلا شكيَّةَ محروبٍ لمحروب",12,"ب",1,0],["وَما اشتَدّ خَطْبُ الإ انبرَى لهُ","أبُو نَهشَلٍ، حَتّى تَلينَ شَدائِدُهْ",13,"د",2,0],["وما أشتكى إلا توثب عاجز","على قادر سهل عليه التوثب",14,"ب",1,0],["وما اشبب في معنى اهيم به","الا وانت لعمري القصد والامل",15,"ل",1,0],["وَما أَشجاكَ مِن أَطلالِ هِندٍ","وَقَد شَطَّت لِطِيَّتِها نَواها",16,"ا",3,0],["وَما أَشكو الزَمانَ وَأَنتَ فيهِ","وان أَصبحتَ مَحصوص الجِناحِ",17,"ح",1,0],["وما اشتغلت نفسي بغيرك والسوى","ولكنها عن غير ودك في شغل",18,"ل",1,0],["وَما اِشتملت أَرض عَلى مثل أَحمَد","أَبروأ وَفي من تقمص واِرتَدى",19,"د",2,0],["وَمَا أَشعَبِي الخِلالِ إِلا كَباسِط","لِيَشرَبَ راحاً بِالإِشارَةِ فِي الوَهدِ",20,"د",1,0],["وَما اشْتَبَهَتْ حَالُ المُلُوكِ وَحالُهُ","ألَمْ تَرَ أنَّ الفَضْلَ لَيْسَ مِنَ النَّقْصِ",21,"ص",1,0],["وَما أشَبِّهُهُ بِاللَيثِ وَهوَ لَهُ","صَيدٌ وَكيفَ يُقاسُ الصَقرُ بِالخَرَبِ",22,"ب",1,0],["وَما أشتَكي إلا نُهوضَ نَداكُمُ","وَتَقصيرَ ما أَنهَضتُهُ مِن مَدائِحِ",23,"ح",1,0],["وما اشتدت الأيام بالهجر شدةً","ولكنها تاقت لمخض الفوائد",24,"د",1,0],["وما أشتكِي شوقي إليكَ تجلُّداً","على أَنَّه بَلْبَالُ قَلبِي وَبثُّهُ",25,"ث",2,0],["وما أشكُو تلَوُّنَ أهلِ وُدّي","ولو أجْدَتْ شَكَّيتُهم شكوْتُ",26,"ت",1,1],["وما أشْفَقوا من وخز دهياء طخيةٍ","كما أشفقوا يوم النَّوال من البذل",27,"ل",1,0],["وما أشبَهَتْكَ المرسَلات بوبلها","بما لك من جدوًى وما لك من رفد",28,"د",1,0],["وما أشكو الهوى لو أنَّ قلبي","تَحَمَّلَ بالهوى ما يستطيع",29,"ع",1,0],["وما أشك بإخلاص لقادتها","من أنقذوها من الطاغوت والخور",30,"ر",1,0],["وما أشكو السهادَ لأنّ جَفني","تنافَى عنده فتحٌ وطبْقُ",31,"ق",1,0],["وما أشكو سوى حسنات دهري","فلو حاققته كانت ذنوبا",32,"ب",2,0],["وما أشكو غليها ضنكَ عيشٍ","ولولا الفضلُ ما سجن الهزار",33,"ر",1,0],["وما أشك لا أشك النوى بعد بذلها","إلى ابن نظيف ذي العلى والمكارم",34,"م",1,0],["وَما أُشارِكُهُم في طَرقِ فَحلِهُمُ","وَلا بسَهلٍ أُراعيهِم وَلا جَبَلِ",35,"ل",1,0],["وما اشْتكَتْ بَعد وِرْدِه ظَمأً","إِذ تَرِدُ العِدَّ مِنه لاَ الثَّمدا",36,"د",2,0],["وَما أَشتَكي مِن غَرامي بِكُم","كَفى بِالنحُول عَلَيهِ شَهِيدا",37,"د",2,0],["وما أشغلت منه الحفاظ نقيبة","أطالت بحفظ الكائنات اشتعالها",38,"ل",3,0],["وما أشرقت شمس النهار بمشرقٍ","وما حازها عند المساء المغارب",39,"ب",1,0],["وَما أَشرَقت في مَصر شَمس تَمدّن","أَبوك لَهُ قَد شادَ أَرصن سُور",40,"ر",1,0],["وما اشتكتْ مُهْجَتي بالنّار تُحرِقُها","ولا اشتكت مُقلتي بالدمع والسُّهُدِ",41,"د",1,0],["وما أشار به من بعث شِعرِيَ قَدْ","وافاهُ ما بين وحْشِيٍّ ومُخْتَشَبِ",42,"ب",1,0],["وما أشدَّ الوَجْد من نازح","فؤادُه يخفق خفق الجناح",43,"ح",1,0],["وما اشتد خطب الدهر يوماً على فتى","غريب من الأوطان إلا تسربلا",44,"ل",2,1],["وَمَا اشْتَعَلَ الرَّأْسُ مِنِّيَ شَيْباً","فَأَوْدَعَ إِلاَّ ضُلُوعِي السِّرَارَا",45,"ر",2,0],["وما اشترى الذمى من كل ما","يئول في السلم له مرجعُ",46,"ع",1,0],["وما أشتكي إلا فراقك وحده","وإلا فقد أغنيت ما كان من فقري",47,"ر",2,0],["وما اشتهي منزلي في السماء","أعيش بها عيشة المفرد",48,"د",1,0],["وما أشرنا إلا سكرنا","ولا لحظنا إلا رأينا",49,"ن",2,0],["وَما أَشدَّ الغَرامَ عندي","لكل مَيّاسةٍ كَعابِ",50,"ب",1,0],["وما اشتبهت طريق المجد إلا","تراها للمعالي قد هدتكا",51,"ك",2,0],["وما أشكو لعمر الله حمى","وإن الحر في جسمي قليل",52,"ل",1,0],["وما أشرَقَ الإصباحُ إلا لأن بَدَتْ","على الشمْسِ من وجْهِ ابنِ نَصْرٍ مَلامِحُ",53,"ح",1,0],["وما اشتهر اللذاتِ والنشوة الفتى","فكان له في المكرمات نصيبُ",54,"ب",1,0],["وما أشد احتراق المستهام إذا","جاد الحبيب ولم تسمح يد الزمن",55,"ن",1,0],["وَما اِشتَكَت في الوَغى أَسيافهُ ظَمأ","إِلّا سَقَتها التَراقي وَاللغاديد",56,"د",1,0],["وَما أَشرف المقدامَ يبذل رُوحَه","عَلى شَرف يَبقى فَيُبقي الدَوائما",57,"م",2,0],["وَما أَشتَكي فَقدَ الصَّباح لِأَنَّني","لِفَقدك في لَيلٍ مَدى الدَّهر مُظلمِ",58,"م",1,0],["وَما اِشتِهاؤُكَ وُدّاً حُزنُ آخِرِه","يُنسيكَ ما أَفرحت أَيامُهُ الأُوَلُ",59,"ل",1,0],["وما أشجعُ الشجعانِ إلا مهذبٌ","نهى النفسَ عن أهوائها ولها لَزَّا",60,"ز",2,0],["وما اشتقت من غيد المعاني رشيقة","يغص لها ساق من اللفظ في حجل",61,"ل",1,0],["وما اشتكائي في بكائي سوى","إنك بالحالة ذو خبر",62,"ر",1,0],["وما اشتبهت في المحكمات قواعد","سوى أنه في كشفها يتهجد",63,"د",1,0],["وما أشمل التصريح وابياتي وكاد","تجرح خبيث النفس راعي النميمه",64,"م",2,0],["وما اشتكي وان شفت ب ايامي عماس","اشمخ ولو قلبي يزيد اختلاجه",65,"ج",2,0],["وَمَا اشْتَكَتْ مُثْقِلاَتِ حَمْلٍ","وَارِفَةُ الْعَيْشِ وَالظِّلاَلِ(٢٥)",66,"ل",1,0],["وما أشتكي من حاجةٍ غيرَ بُعْدِها","وما أنا من شيءٍ سوى البعدِ أحذَرُ",67,"ر",1,0],["وما أشقاك إلا طوق عتمٍ","وكان العشق نوريّا وطلْقا ....",68,"ق",2,0],["وما اشتياقي إلى نجد وساكنها","لولا بدور وغزلان وكثبان",69,"ن",1,0],["وما أشتبها في مظهر بل تشابها","كما شابهت بعض الذباب التوائم",70,"م",1,0],["وما اشتاقتِ العينانِ في العمرِ كلِّه",".لشيءٍ كما اشتاقتْ الى نورِ أحمدِ",71,"د",1,1],["ومااشتياقي الى عينينِ زانهما","حسنُ احورارٍ ولا مافي الشفاهِ لمى",72,"م",2,0]]}