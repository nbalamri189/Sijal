{"poems":[[53,"لا أحب الرئيس ذا العز يضحي","https://www.aldiwan.net/poem61850.html","الخفيف"],[47,"لا الدهر مستنفذ ولا عجبه","https://www.aldiwan.net/poem10901.html","المنسرح"],[48,"قد وعظتني بك الليالي","https://www.aldiwan.net/poem22402.html","مجزوء البسيط"],[53,"لا أحبُّ الرئيسَ ذا العز يُضْحي","https://www.poetsgate.com/ViewPoem.aspx?id=28480",""],[240,"آه للبرق أضاءا","https://www.aldiwan.net/poem32197.html","مجزوء الرمل"],[356,"يا ابن الخلائف من مروان أنجبك","https://www.aldiwan.net/poem68969.html","البسيط"],[463,"حسبوا العلا خفا وكن ثقالا","https://www.aldiwan.net/poem56000.html","الكامل"],[1349,"","https://poetry.dctabudhabi.ae/diwan/poem/84509","الرجز"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48260","البسيط"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87789","الكامل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62898","الرجز"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125812","الكامل"],[4767,"بلاغ","https://www.poetsgate.com/ViewPoem.aspx?id=179843",""],[5111,"جموحُ","https://www.poetsgate.com/ViewPoem.aspx?id=212077",""],[5376,"إنِّي جَزِعْتُ وما لنا الا هو","https://www.poetsgate.com/ViewPoem.aspx?id=188286",""],[5466,"يا مَنْ يرومُ تلاوة القرآن","https://www.poetsgate.com/ViewPoem.aspx?id=112512",""],[5725,"رحيق الخزامى","https://www.poetsgate.com/ViewPoem.aspx?id=177720",""],[5997,"لَبَّيْكَ حَبِيْبِيْ","https://www.poetsgate.com/ViewPoem.aspx?id=214238",""]],"verses":[["كاليتيم الممسَّح الرأس إن شا","ء ذوو مَسْح رأسه قَفَدوهُ",0,"د",3,0],["كالِىءُ ثَغرِ الإِسلامِ يَرفِدُهُ","جِدُّ اِمرِىءٍ لا يَشوبُهُ لَعِبُه",1,"ب",2,0],["كَاليَومُ بانَت فَضيلَتاهُ","بِأَنَّهُ جُمعَةٌ وَعيدُ",2,"د",1,0],["كاليتيم الممسحِ الرأس إن شا","ء ذوه مسْحِ رأسِهِ قَفَدوهْ",3,"د",3,0],["كاّليَماني العَضبِ يَهتَز","زُ صِقالا وَمَضاءا",4,"ا",3,0],["كاليم تسمعُ في حافاته قصفاً","من كل أوبٍ له كالرعد هينومُ",5,"م",1,0],["كاليوم ردَّ كرىً وشدّ سواعداً","وأعاش أفئدةً وراش نبالا",6,"ل",2,0],["كالياء فعال وفاعل فعل","وبالسماع أمويّ شتوى نقل",7,"ل",1,0],["كالي الثغور وحاميها بهيبتِهِ","ومرهَفٍ من سيوفِ الهندِ بتّاكِ",8,"ك",1,0],["كَاليمّ عبَّ عُبابه","وَالسَيل حينَ طَما جُرافه",9,"ف",2,0],["كاليومِ انْ مرَّ رَجَعْ","والبدرِ انْ غابَ طَلَعْ",10,"ع",1,0],["كَاليَاءِ وَالكافِ من ابنِى أكرمَك","وَاليَاءِ وَالهَا مِنُ سَلِيهِ مَا مَلَك",11,"ك",1,0],["كاليوم يفتح ذو المعالي قصره","بمكارم أزرت بكل جواد",12,"د",1,0],["كاليم ينساب بأمواجهِ","أعيت ذوي الأبصار شطآنه",13,"ن",2,0],["كَاليَاسَمِيْنِ شَذَاً رَقَّتْ نَوَافِحُهُ","إشْرَاقَةٌ فِيْ سَنَى أبْهَى الفَسَاتِيْنِ",14,"ن",1,0],["كالياسمينِ من الصفاءِ فؤادُه","تحلو الحياةُ به تغنَّى فاهُ",15,"ا",2,0],["كاليمِّ ما والحقَّ قُل ومثال ظلا ظللْنا","لنا لكيما يظهرَ الأخوانِ",16,"ن",1,0],["كاليمامات في الضحى نائحاتٍ","ترسل الدمع في المساء سجاما",17,"م",2,0],["كَالْيَوْمِ يَا صَفْوَ الْكِرَاْمِ وَخَيْرَ مَنْ","تَحْتَ الغَمَاْمِ مَشَىٰ عَلَىٰ الْغَبْرَاْءِ",18,"ا",2,0]]}