{"poems":[[65,"أكوكب ما أرى يا سعد أم نار","https://www.aldiwan.net/poem45803.html","البسيط"],[9,"كفى بالذي تولينه لو تجنبا","https://www.aldiwan.net/poem21907.html","الطويل"],[94,"ليت شعري","https://www.aldiwan.net/poem38945.html","الخفيف"],[71,"بسي من الشعر بسي","https://www.aldiwan.net/poem28397.html","المجتث"],[83,"هاتها كالمنار لاح النهار","https://www.aldiwan.net/poem61524.html","الخفيف"],[54,"أيا معقلي للنائبات وإن قست","https://www.aldiwan.net/poem26629.html","الطويل"],[77,"أكوكب في يمين يحيى","https://www.aldiwan.net/poem69078.html","الرجز"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43793","البسيط"],[9,"كَفَى بِالّذِي تُولِينَهُ لَوْ تَجَنّبَا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17253&r=&rc=0",""],[148,"أبدا إليك تولع الأحباب","https://www.aldiwan.net/poem4461.html","الكامل"],[173,"إليكن عني فانصرفن على مهل","https://www.aldiwan.net/poem1643.html",""],[214,"أهديت لي مولاي أضحية","https://www.aldiwan.net/poem13532.html","السريع"],[236,"سبحان ذي الجبروت والبرهان","https://www.aldiwan.net/poem44602.html","الكامل"],[309,"ما حل قلبي ولا سكن","https://www.aldiwan.net/poem16880.html","مخلع البسيط"],[371,"قم فاسقني مما تروق","https://www.aldiwan.net/poem17235.html","مجزوء الكامل"],[396,"متى متى ياسا كنين سمعون","https://www.aldiwan.net/poem54484.html","عموديه"],[435,"بانوا فصار الجسم من بعدهم","https://www.aldiwan.net/poem41044.html","السريع"],[438,"أكوكب بشر من جبينك لائح","https://www.aldiwan.net/poem12578.html","الطويل"],[438,"أشاقك برق بالدجنة لائح","https://www.aldiwan.net/poem12585.html","الطويل"],[463,"وصفحة وجه من وجوه علقتها","https://www.aldiwan.net/poem56267.html","الطويل"],[463,"أبلغ بها أمنية الطالب","https://www.aldiwan.net/poem56275.html","السريع"],[534,"أكؤوس مترعات من عقار","https://www.aldiwan.net/poem37409.html","الرمل"],[558,"نبا به الوساد","https://www.aldiwan.net/poem68396.html","مجزوء الرجز"],[558,"يا أيها المعمود","https://www.aldiwan.net/poem68407.html","مجزوء الرجز"],[563,"أنا الوجود كما أني أنا العدم","https://www.aldiwan.net/poem33860.html","البسيط"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126682","الطويل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122823","الوافر"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63938","الخفيف"],[944,"","https://poetry.dctabudhabi.ae/diwan/poem/51558","السريع"],[961,"","https://poetry.dctabudhabi.ae/diwan/poem/100149","الكامل"],[1534,"","https://poetry.dctabudhabi.ae/diwan/poem/206182",""],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69423","الطويل"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102138","الوافر"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42462","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27812","الكامل"],[2275,"","https://poetry.dctabudhabi.ae/diwan/poem/28057","الطويل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67258","الرمل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60845","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94083","البسيط"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93896","الخفيف"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93801","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202812","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62895","المتقارب"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62817","المنسرح"],[3585,"","https://poetry.dctabudhabi.ae/diwan/poem/104854","الخفيف"],[125,"","https://poetry.dctabudhabi.ae/diwan/poem/135890","الرجز"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86496","الكامل"],[4327,"","https://poetry.dctabudhabi.ae/diwan/poem/73290","البسيط"],[185,"أميم منك الدار غيرها البلى","https://www.poetsgate.com/ViewPoem.aspx?id=186042",""],[4860,"تعبت أرسم بلا ألوان","https://www.poetsgate.com/ViewPoem.aspx?id=32516",""],[5055,"مركئين العز","https://www.poetsgate.com/ViewPoem.aspx?id=104298",""],[5111,"هَامَانُ يَعْرِفُنِي","https://www.poetsgate.com/ViewPoem.aspx?id=212238",""],[5281,"نزلت للوادي ملاوي ملاوي","https://www.poetsgate.com/ViewPoem.aspx?id=199603",""],[5387,"بعد الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=53063",""],[5431,"احرق بربك قد جُعِلْتُ لتحْرقا","https://www.poetsgate.com/ViewPoem.aspx?id=195162",""],[5664,"هدير الماء","https://www.poetsgate.com/ViewPoem.aspx?id=176679",""],[5703,"لن أنساه","https://www.poetsgate.com/ViewPoem.aspx?id=215194",""],[5790,"هل في الصبا من عريب المنحنى نفس","https://www.poetsgate.com/ViewPoem.aspx?id=112064",""],[5950,"دموع التماسيح ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128120",""],[5956,"أخاف عليك يا نجلي","https://www.poetsgate.com/ViewPoem.aspx?id=193290",""],[6089,"البحرُ المولّهُ","https://www.poetsgate.com/ViewPoem.aspx?id=212945",""],[2220,"إذا جاءتِ الأسماء يقدمُها الله","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11859&r=&rc=728",""]],"verses":[["أَكَوكَبٌ ما أَرى يا سَعدُ أَم نارُ","تَشُبُّها سَهلَةُ الخَدَّينِ مِعطارُ",0,"ر",1,1],["أَكونُ اِمرَءً مِنكُم عَلى ما يَنوبُكُم","وَلَن يَرَني أَعداؤكُم قَرنَ أَعضَبا",1,"ب",2,0],["أَكوابِ زَهْرِ الزَّنْبَقِ","وَادْفُنِيهِ بجَلالٍ في",2,"ي",1,0],["أكونُ عفاً بريئاً","وما أبرِّئُ نفسي",3,"ي",1,0],["أَكؤُساً ما أَرى بِأَيدي سُقاةٍ","أَم نُجوماً تَسعى بِها أَقمارُ",4,"ر",1,0],["أَكونُ كَذي داءٍ يُعَدُّ دَوائُهُ","لَهُ كُلَّ يَومٍ زَفرَةٌ وَأَنينُ",5,"ن",1,0],["أكوكبٌ في يمينِ يحيَى","أم صارمٌ باتكُ الغِرارِ",6,"ر",1,1],["أَكَوكَبٌ غارَ في ضَريح","أم درَّةٌ صُنتها بِحقِّ",7,"ق",1,0],["أكونُ امرأً منكمْ على ما ينوبكمْ،","وَلَنْ يَرَني أعداؤكُمْ قَرْنَ أعضَبَا",8,"ب",2,0],["أكواب حب من مدام مكارم","بيد الكرام أحبة الاواب",9,"ب",1,0],["أَكُونُ بِهِ قُطبَ الرَحى وَمُديرَها","بِعَزمٍ عَلى أَهلِ الضَلالَةِ وَالجَهلِ",10,"ل",1,0],["اكولة تأكل في يومها","أضعاف ما يؤكل في شهر",11,"ر",1,0],["أَكوابُهُ ذَهَبٌ تَلوحُ وَفِضَّةٌ","بَيضاءُ هُنَّ لَدَيهِ خَيرُ أَواني",12,"ن",2,0],["أكو إلى اللَه ذي الجلال","وعنده تجمع الخصوم",13,"م",1,0],["أَكُؤوسُنا إِلّا جَوا","ري ما وَساقينا يُغَرِّق",14,"ق",1,0],["أكون معهم وأكن لهم جار","تفوز معهم عند ما يفوزون",15,"ن",1,0],["أكون من دين الهوى خالياً","إذا رأوني بعدهم حيّا",16,"ي",2,0],["أكوكبُ بِشرٍ من جَبينكَ لائحُ","وصيّبُ يُسْرٍ من يمينكَ سائحُ",17,"ح",1,1],["أكوكبُ بِشرٍ من جَبينك لائحُ","وصبّ يُسرٍ من يمينك سافح",18,"ح",1,0],["أكونُ حليماً تارةً ما اجتليتُها","وَقُوراً وأحياناً أكون طَروبا",19,"ب",2,0],["أكون ما استغنيتُ عن رفدهم","جِلدةَ بين العينِ والحاجب",20,"ب",1,0],["أكُؤُوسٌ مُتْرَعاتٌ منْ عقارِ","مُزِجَتْ بالظَّلْمِ منْ ذِي الاِحْوِرارِ",21,"ر",1,1],["أَكواسُنا مِلاءٌ","صادِرَةٌ وُرّادُ",22,"د",1,0],["أَكواسُهُم مِلاءُ","طافِحَةٌ رُكودُ",23,"د",1,0],["أكون طوراً وجوداً إن ظهرت به","وتارةً عدما يخفى وينكتم",24,"م",1,0],["أَكَوكب هذا في الترابِ مُغيّب","أم البدر في هذا الضريح محجّبُ",25,"ب",1,1],["أَكُونُ وَخِلَّتي قَيساً وَلَيلَى","مُقايَسةً وَغَيلانا وَميّا",26,"ي",2,0],["أكوارُهُنَّ عِقاصهنَّ وما الدمى","إلاَّ دمىً أَكوارُها الأعقاص",27,"ص",1,0],["أكونُ مع طالعهِ طالِعاً","طَوراً ومع غائِرهِ غائرا",28,"ر",2,0],["أكواب زهر قد تنظم","أم خرد عرب تبسم",29,"م",1,1],["اكْويعبٍ يخجل سنا الشمس لي جاب","عن نور خدّينه انعام الجلابيب",30,"ب",1,0],["أَكُونُ مِراراً ذا هُمُومٍ كَثِيرَةٍ","وَأَنظُرُ في وَجهِ المُعِزِّ فَتُفرَجُ",31,"ج",1,0],["أكونُ معاهمُ فارى ضريحاً","به قد قام خير الرسل ذاكا",32,"ك",2,0],["أكولٌ متى ما شامَ قِدراً مُعرَّماً","فيأكلُ أكلاً بالغاً يحسف القدرا",33,"ر",2,0],["أكوانُه بصفاته وتباهى","في ذاك إعجاباً بها وتناهى",34,"ا",3,0],["أَكونُ لَهُ أَن يُنكَبَ الدَهرَ مِدرَهاً","أَكالِبُ عَنهُ الخَصمَ إِن عَضَّهُ الخَصمُ",35,"م",1,0],["أكؤساً يمزجها من ريقهِ","فتخالُ الكأسَ في تصفيقهِ",36,"ه",1,0],["أكونُ زنْجيًّا ولا","أدخُل في ذا النّسبِ",37,"ب",1,0],["أكوكب لاح زاهي نوره الزاهر","أم ذاك باهي جمال حسنه باهر",38,"ر",1,1],["أكؤوس شرابها زنجبيل","أم أفاويه جلها زنجبيل",39,"ل",1,1],["أكؤوس تجلى ببنت الدوالي","أم شهى الرضاب فيه الدوالي",40,"ل",2,1],["أكوّن ألفاظاً ومعنى وهيكلاً","وانفخ من روحي به ثم أنساه",41,"ه",1,0],["أَكونُ الظَّلامَ على شَمسِها","وضوءَ النَّهارِ على الحِنْدِسِ",42,"س",1,0],["أكوعُ أفراسه بخُرَّمةٍ","لها على الهندوانِ إعصارُ",43,"ر",1,0],["أكؤس للطلى بذوق نزيف","يا غنى اللمى عن التعريف",44,"ف",1,0],["أكون فيه عن شهود الطاعةِ","ونظر العصيانِ كل ساعةِ",45,"ه",1,0],["أكواكب طلعت من الأبراج","أم خرد بكرت على الأحداج",46,"ج",1,1],["أَكوكَبٌ في دُجى اللَّيلِ البَهيمِ بدا","أم لاحَ للعينِ في نيرانِهِم قَبَسُ",47,"س",1,0],["أكون أخا ذي الصرم إما لخلةٍ","سواك وإما أرعوى فأتوب",48,"ب",1,0],["أكون بدنيتك ورده تِنَمّي للجذور أغصان","ويجرفها أذى الواقع..ويدفنها وهي حيه",49,"ي",2,0],["اكويت وتَنّعم الديرة ثراها منبع الأنجاب","اكويت وينتخي الأشهب مدار الشهب تهنابه",50,"ب",2,0],["اكويت ويا ذرى النخوة حضرهم بدوهم واعراب","لهم سبق الطَلَقْ فيها على من كشّر أنيابه",50,"ب",2,0],["اكويت ويا الملك لله سماها ماجدين أحقاب","وهي يا ( سالم السيار ) مثل ما( الطارق ) أشهابه",50,"ب",2,0],["أكَوِّرُ الْحَرْفَ أسْرِي فِيْهِ نَافِحَهُ","بَيْنَ الأصَابِع ِيَعْنُو لِيْ وَيَمْتَثِلُ",51,"ل",1,0],["أكونْ لكْ صَاحبْ، وًانْتَهْ مِخَاوي","وخلَّنا من هَدرَتكْ يا خَواوه",52,"ا",3,0],["أكّون منك رائعة تغنّى","ومن عينيك أبياتاً تشيعُ",53,"ع",1,0],["أُكوى على نار السعير تعشقا","وبلمس قلبك أستجير لترفقا",54,"ق",2,0],["أكون احيان في قلبي وفي عقلي بعض احيان","ولا ادري من يوديني ويوقفني على لساني",55,"ن",2,0],["أكونُ بينَ السَما والأرضِ عالِقةً","إليَّ لو نَظَرَتْ في الحُبِّ عيناهُ",56,"ا",2,0],["أكوكب في دجى الليل البهيم بدا","أم لاح للعين من نيرانهم قبس",57,"س",1,0],["أكون بارد دمّ لو قلبي يصيح","وأضحك بوجه جروحهم لا تألمت",58,"ت",1,0],["أكولُ السُّحْتِ والمُهْلِ","يكابد شهوة القتلِ",59,"ل",1,0],["أَكونُ عروسَ الموْج أَوْ لا أكونُها","إِذا الرّوح لَم يَخْضعْ لغَصْبٍ سَفينُها",60,"ن",3,1],["أكونُ عليها فالشهيدُ هوَ اللهُ","شديدٌ إذا يُدعى المليكُ بحكمه",61,"ه",1,0]]}