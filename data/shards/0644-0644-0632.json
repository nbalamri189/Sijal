{"poems":[[94,"ههنا في خمائل الغاب تحت الزا","https://www.aldiwan.net/poem38901.html","المديد"],[228,"لا لقوم ولا لدين","https://www.aldiwan.net/poem39694.html","مجزوء الخفيف"],[275,"يا من يقدم طاقة الزهر","https://www.aldiwan.net/poem35657.html","أحذ الكامل"],[563,"للزاي في شأن الخلافة زينة","https://www.aldiwan.net/poem33519.html","الكامل"],[763,"","https://poetry.dctabudhabi.ae/diwan/poem/54128","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70673","المتدارك"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59531","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93613","الرجز"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3369,"","https://poetry.dctabudhabi.ae/diwan/poem/117021","البسيط"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48428","البسيط"],[3750,"","https://poetry.dctabudhabi.ae/diwan/poem/126513","البسيط"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111507","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70049","الكامل"],[4479,"","https://poetry.dctabudhabi.ae/diwan/poem/57974","المتقارب"],[4927,"مَجْدُ الْعِرَاْق","https://www.poetsgate.com/ViewPoem.aspx?id=30480",""],[5150,"معنى التحيه ...!","https://www.poetsgate.com/ViewPoem.aspx?id=203146",""],[5776,"والمرءُ إنْ ما حرّكَتْهُ قصيدةٌ ..","https://www.poetsgate.com/ViewPoem.aspx?id=199682",""]],"verses":[["للزَّمانِ الَّذي يوشِّحُ أَيَّا","مي بضَوءِ المنى وظلِّ الشُّجونِ",0,"ن",1,0],["لِلزُّناةِ المُسَيطِرين","لِلأُباةِ المُستَعبَدين",1,"ن",1,0],["للزهر أَلسنةٌ عليَّ بِكُمْ","باحت لأهل الحبِّ بالسرِّ",2,"ر",1,0],["للزاي في شأن الخلافة زينة","زالت بها في العين تقديراتها",3,"ت",3,1],["للزهد فيه وكونه من غشه","متناهياً في وصفه بالدونِ",4,"ن",1,0],["للزيارة تعنو الحجيج له","قاصدين لهم في القِفارِ زَجَل",5,"ل",1,0],["للزمتُه حتى يجود بقُبلةٍ","تبرى فؤادي من أليم عذابه",6,"ب",2,0],["للزائِرين قَد حلى نَميره","وَاجتمع الناس عليهِ زمرا",7,"ر",2,0],["للزور قد قبلوا ثم الرشا اكلوا","والحق قد بدلوا نكثا لعهدهم",8,"م",1,0],["للزمان اندراج في محاسنه","فالثغر والشعر إصباح وإمساء",9,"ا",2,0],["للزُّهْرِ بهْجَتُها للزَّهْرِ نفْحَتُها","للبَدْرِ طَلعَتُها للسِّحْرِ مرْآها",10,"ا",3,0],["للزهر ديباجة خضراء طرزها","كف السما بلآلىء القطر مثل غطا",11,"ط",2,0],["للزهرة الغراء منتسبي","والشهم أنخيسٌ أبي عهدا",12,"د",2,0],["للزغزغي ذكرٌ يُؤرَّخُ دائِماً","وَعَلى ذِراع الرَب يوحنا اِتَكا",13,"ك",2,0],["للزوج نصف رأوا حقه","والجد نصف وتم الخطاب",14,"ب",1,0],["لِلزَّاْحِفَاْتِ  مَعَ الرِّجَاْلِ  عَلَى الْعِدَىْ","بِشَجَاْعَةِ الشُّجْعَاْنِ º وَ الأَطْوَاْدِ",15,"د",1,0],["لَلزّعيمُ الفذُّ أوحى حِكمةً","فخذوها.. قد تجلّتْ منطقيّهْ",16,"ي",2,0],["للزاملِ اليمنيِّ صولةُ فارسٍ","إنْ خاضَ معركةً فليسَ يُهانُ",17,"ن",1,1]]}