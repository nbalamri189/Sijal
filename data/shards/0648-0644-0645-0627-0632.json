{"poems":[[55,"وذي نضد لا يقطع الطرف عرضه","https://www.aldiwan.net/poem30440.html","الطويل"],[55,"أي دموع عليك لم تصب","https://www.aldiwan.net/poem30737.html","المنسرح"],[65,"واها لأيامي بأكناف اللوى","https://www.aldiwan.net/poem46135.html","الرجز"],[53,"ناشدتك الله في قدري ومنزلتي","https://www.aldiwan.net/poem9222.html","البسيط"],[53,"أساء الرأي أم عزب الرسول","https://www.aldiwan.net/poem65999.html","الوافر"],[72,"دعوا الوشاة وما قالوا وما نقلوا","https://www.aldiwan.net/poem42743.html","البسيط"],[68,"مملوكك اليوم أبو حبه","https://www.aldiwan.net/poem38646.html","السريع"],[54,"لا عذر للعاذل في الكاس","https://www.aldiwan.net/poem26916.html","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19720",""],[70,"","https://poetry.dctabudhabi.ae/diwan/poem/25961","البسيط"],[127,"من رأس بيروت حتى ثغر لرناكا","https://www.aldiwan.net/poem23796.html","البسيط"],[232,"جزيت بفرط الود مثنى وموحدا","https://www.aldiwan.net/poem51161.html","الطويل"],[259,"ولم أزل وهي إلى جانبي","https://www.aldiwan.net/poem48451.html","السريع"],[273,"قد أرخت الشال على الخد","https://www.aldiwan.net/poem35336.html","السريع"],[274,"طيف الخيال من النيابتين سرى","https://www.aldiwan.net/poem52115.html","البسيط"],[331,"ملأت بالدمع كأسي","https://www.aldiwan.net/poem54927.html","المجتث"],[352,"لولا سنى ربة الخدر بدا","https://www.aldiwan.net/poem15643.html","الرجز"],[352,"تجردت نفسي عن نفسي","https://www.aldiwan.net/poem15741.html","السريع"],[352,"لو كنت مني ما غبت عني","https://www.aldiwan.net/poem15970.html","مخلع البسيط"],[352,"ما أومض البرق بين الطلع والبان","https://www.aldiwan.net/poem15981.html","البسيط"],[374,"يد الغرام علت يوم الوداع يدي","https://www.aldiwan.net/poem57472.html","البسيط"],[419,"اليوم أصبح فيك الوقت منتظما","https://www.aldiwan.net/poem54127.html","البسيط"],[419,"نبهت الورقاء ذات الجناح","https://www.aldiwan.net/poem54157.html","الطويل"],[435,"عليكم جانبت أصحابي","https://www.aldiwan.net/poem12326.html","السريع"],[435,"ألحق بنفسج فجري وردتي شفقي","https://www.aldiwan.net/poem12386.html","البسيط"],[435,"عرس بالتوفيق والسعد","https://www.aldiwan.net/poem12394.html","السريع"],[435,"خليلي اتركا ما تعدلاني","https://www.aldiwan.net/poem12479.html","الوافر"],[454,"ولما زارني سحرا حبيب","https://www.aldiwan.net/poem13889.html","الوافر"],[455,"شربنا مذاب النار بعد فكاكها","https://www.aldiwan.net/poem61705.html","الطويل"],[517,"أمنت من الغرام على فؤادي","https://www.aldiwan.net/poem12064.html","الوافر"],[517,"لا وعيون لحظها ساهر","https://www.aldiwan.net/poem12116.html","السريع"],[553,"ما ضر طيفك لو والى زياراتي","https://www.aldiwan.net/poem48030.html","البسيط"],[569,"جاءت فأكبرها طرفي فقمت لها","https://www.aldiwan.net/poem69463.html","البسيط"],[577,"أحسنتم إن تحسنوا في الفعل","https://www.aldiwan.net/poem3038.html","الرجز"],[860,"","https://poetry.dctabudhabi.ae/diwan/poem/17741","الطويل"]],"verses":[["وَلَم أَزجُرِ العَينَ الدُموعَ لِتَنتَهي","وَلَم أَعذُلِ القَلبَ اللَجوجَ لِيَصبِرا",0,"ر",2,0],["وَلَم أَزَعهُ إِلّا وَأَعقَبَني","سَطواً كَوَقعِ الظُبى عَلى اليَلَبِ",1,"ب",1,0],["ولم أزَلْ أخْطِرُ في رِدائِهِ","بينَ رَعابيبَ حِسانٍ كالدُّمى",2,"ا",1,0],["ولم أزل سَبِطَ الأخلاق واسعَها","وإن غدوتُ امرأً في لحيتي كَثَثُ",3,"ث",1,0],["ولم أزجرْ هناك الطيرَ لكنْ","ثناؤك حين تحتفِل الحُفولُ",4,"ل",1,0],["وَلَم أَزَل في أُموري كُلَّما عَرَضَت","عَلى اِهتِمامِكَ بَعدَ اللَهِ أَتَّكِلُ",5,"ل",1,0],["وَلَم أَزَل في رَحبِ أَكنافِهِ","أَقولُ بِاللَذّاتِ وَاللُبسِ",6,"س",1,0],["وَلَم أَزَل وَاللَيلُ سُترٌ لَنا","مِن دونِ رُقابٍ وَحُرّاسِ",7,"س",1,0],["ولم أزل أطرِى له ال","جد وأمدح الأبا",8,"ا",1,0],["ولم أَزَلْ منذ أخذِ العهدِ في قِدَمي","لكَعْبَةِ الحُسْنِ تجريدي وإجرامي",9,"م",2,0],["ولم أزل بالندامى كلما فترت","أكفهم سمتها روماً وكنياكا",10,"ك",2,0],["ولم أزْج وعظي نحو ودِّك أنّني","أخاف عليه الدهر أن يَتبدَّدا",11,"د",2,0],["ولم أزل وهي إلى جانبي","كظبيةٍ عفراء وحشيه",12,"ه",1,1],["ولم أزَل آكلُ من جَنّتي","تُفّاحَها ولم تزَل عندي",13,"د",2,0],["وَلَم أزل رافِعا صَوتي بِتَلبيَتي","مَع الملبين مِمَّن حج واِعتَمرا",14,"ر",2,0],["ولم أزل غير أني","محيّر في هواك",15,"ك",1,0],["وَلَم أَزَل مُتَسِّعاً مُسَبِّعاً","مُخَمِّساً مُثَلِّثاً مُوَحِّدا",16,"د",2,0],["وَلَم أَزَل أَرصُدُ بَدرَ الدُجى","حَتّى اِجتَلَيتُ البَدرَ في الشَمسِ",17,"س",1,0],["وَلَم أَزَل سامِعاً بَصيراً","أُجيبُ بِالنُطقِ مَن دَعاني",18,"ن",2,0],["وَلَم أَزَل بِوِشاحِ السُقمِ مُتَّشِحاً","أَغشى فُنونَ الأَسى طَوراً وَتَغَشّاني",19,"ن",2,0],["ولم أزل واثقاً بالصبر يُنجدُني","أو التجلُّدِ حتى خانَني جَلَدي",20,"د",2,0],["ولم أزل كلماتي فيك أنظمها","كما تتابع قطر المزن وانسجما",21,"م",2,0],["ولم أزَلْ في القرب من وُدِّه","أقرع بالأفراح باب النجاح",22,"ح",1,0],["ولم أَزَلْ أُطْنِبُ في شُكْرِكُمْ","غايَةَ ما يَبْلُغُ إِطْنَابِي",23,"ب",2,0],["ولم أَزَلْ في ارْتِشافِي منه رِيقَ فم","أَطفأْتُ في بردِهِ مشبوبةَ الحُرَقِ",24,"ق",1,0],["ولم أَزَلْ أَنْظِمُ في وَصْفِهِ","فرائدَ الأَمداحِ كالعِقْدِ",25,"د",1,0],["ولما زادَ ما بي من هواهُ","وألبسَ مهجتي ثوبَ الهوانِ",26,"ن",1,0],["ولمّا زارني سَحَراً حبيبٌ","بلطْفِ الخطو قد أخفىْ بحاله",27,"ه",1,1],["ولما زأرنا قيل سَكري تخبطوا","وما نحن من يعنو إلى اللهوِ والسكر",28,"ر",1,0],["ولما زاد عندي كل نقد","وميز بهرج الناس انتقادي",29,"د",2,0],["ولم أزل أمسح أعطافه","ورأيه في قصتي حائر",30,"ر",1,0],["وَلَم أَزَلْ مُشفقاً حتّى علمتُ بما","أَنالَهُ اللَّهُ مِن ظِلِّ السّلاماتِ",31,"ت",1,0],["وَلَمْ أَزَلْ دُونَ نَدْمَانِيَّ مُقْتَرِحَاً","شِعْرِي عَلَيْهَا تُغَنِّيْنِي وَأَسْقِيْهَا",32,"ي",3,0],["ولم أَزل على نداك والجاً","إِنِّي على نَدَاك كالمُدْلِ",33,"ل",1,0],["وَلَمّا زَجَرنا الخَيلَ خاضَت بِنا القَنا","كَما خاضَتِ البُزلُ النِهاء الطَوامِيا",34,"ي",2,0]]}