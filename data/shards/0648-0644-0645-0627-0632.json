{"poems":[[55,"وذي نضد لا يقطع الطرف عرضه","https://www.aldiwan.net/poem30440.html","الطويل"],[55,"أي دموع عليك لم تصب","https://www.aldiwan.net/poem30737.html","المنسرح"],[65,"واها لأيامي بأكناف اللوى","https://www.aldiwan.net/poem46135.html","الرجز"],[53,"ناشدتك الله في قدري ومنزلتي","https://www.aldiwan.net/poem9222.html","البسيط"],[53,"أساء الرأي أم عزب الرسول","https://www.aldiwan.net/poem65999.html","الوافر"],[72,"دعوا الوشاة وما قالوا وما نقلوا","https://www.aldiwan.net/poem42743.html","البسيط"],[68,"مملوكك اليوم أبو حبه","https://www.aldiwan.net/poem38646.html","السريع"],[54,"لا عذر للعاذل في الكاس","https://www.aldiwan.net/poem26916.html","السريع"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/19720",""],[70,"","https://poetry.dctabudhabi.ae/diwan/poem/25961","البسيط"],[128,"من رأس بيروت حتى ثغر لرناكا","https://www.aldiwan.net/poem23796.html","البسيط"],[234,"جزيت بفرط الود مثنى وموحدا","https://www.aldiwan.net/poem51161.html","الطويل"],[261,"ولم أزل وهي إلى جانبي","https://www.aldiwan.net/poem48451.html","السريع"],[275,"قد أرخت الشال على الخد","https://www.aldiwan.net/poem35336.html","السريع"],[276,"طيف الخيال من النيابتين سرى","https://www.aldiwan.net/poem52115.html","البسيط"],[333,"ملأت بالدمع كأسي","https://www.aldiwan.net/poem54927.html","المجتث"],[354,"لولا سنى ربة الخدر بدا","https://www.aldiwan.net/poem15643.html","الرجز"],[354,"تجردت نفسي عن نفسي","https://www.aldiwan.net/poem15741.html","السريع"],[354,"لو كنت مني ما غبت عني","https://www.aldiwan.net/poem15970.html","مخلع البسيط"],[354,"ما أومض البرق بين الطلع والبان","https://www.aldiwan.net/poem15981.html","البسيط"],[376,"يد الغرام علت يوم الوداع يدي","https://www.aldiwan.net/poem57472.html","البسيط"],[422,"اليوم أصبح فيك الوقت منتظما","https://www.aldiwan.net/poem54127.html","البسيط"],[422,"نبهت الورقاء ذات الجناح","https://www.aldiwan.net/poem54157.html","الطويل"],[438,"عليكم جانبت أصحابي","https://www.aldiwan.net/poem12326.html","السريع"],[438,"ألحق بنفسج فجري وردتي شفقي","https://www.aldiwan.net/poem12386.html","البسيط"],[438,"عرس بالتوفيق والسعد","https://www.aldiwan.net/poem12394.html","السريع"],[438,"خليلي اتركا ما تعدلاني","https://www.aldiwan.net/poem12479.html","الوافر"],[457,"ولما زارني سحرا حبيب","https://www.aldiwan.net/poem13889.html","الوافر"],[458,"شربنا مذاب النار بعد فكاكها","https://www.aldiwan.net/poem61705.html","الطويل"],[520,"أمنت من الغرام على فؤادي","https://www.aldiwan.net/poem12064.html","الوافر"],[520,"لا وعيون لحظها ساهر","https://www.aldiwan.net/poem12116.html","السريع"],[556,"ما ضر طيفك لو والى زياراتي","https://www.aldiwan.net/poem48030.html","البسيط"],[572,"جاءت فأكبرها طرفي فقمت لها","https://www.aldiwan.net/poem69463.html","البسيط"],[580,"أحسنتم إن تحسنوا في الفعل","https://www.aldiwan.net/poem3038.html","الرجز"],[631,"","https://poetry.dctabudhabi.ae/diwan/poem/146569","الوافر"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48863","البسيط"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63814","المجتث"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18501","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77495","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77652","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77544","الرجز"],[969,"","https://poetry.dctabudhabi.ae/diwan/poem/145608","المجتث"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59427","البسيط"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202072","الرجز"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136173","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46522","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46508","الرجز"],[1326,"","https://poetry.dctabudhabi.ae/diwan/poem/46569","الرجز"],[1441,"","https://poetry.dctabudhabi.ae/diwan/poem/78143","البسيط"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133874","المنسرح"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133871","السريع"],[1836,"","https://poetry.dctabudhabi.ae/diwan/poem/66293","السريع"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118299","البسيط"],[1972,"","https://poetry.dctabudhabi.ae/diwan/poem/69347","الوافر"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110273","السريع"],[2053,"","https://poetry.dctabudhabi.ae/diwan/poem/132441","الرجز"],[2079,"","https://poetry.dctabudhabi.ae/diwan/poem/42408","الطويل"],[2347,"","https://poetry.dctabudhabi.ae/diwan/poem/89516","الطويل"],[2410,"","https://poetry.dctabudhabi.ae/diwan/poem/121184","السريع"],[2436,"","https://poetry.dctabudhabi.ae/diwan/poem/17741","الطويل"],[2475,"","https://poetry.dctabudhabi.ae/diwan/poem/106995","الرجز"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87329","الرجز"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94080","الطويل"],[2953,"","https://poetry.dctabudhabi.ae/diwan/poem/99503","المجتث"],[2956,"","https://poetry.dctabudhabi.ae/diwan/poem/115425","الوافر"],[2991,"","https://poetry.dctabudhabi.ae/diwan/poem/84472","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74216","الرجز"],[3083,"","https://poetry.dctabudhabi.ae/diwan/poem/138015",""],[3083,"","https://poetry.dctabudhabi.ae/diwan/poem/137975",""],[3296,"","https://poetry.dctabudhabi.ae/diwan/poem/105622","الرجز"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97998","الطويل"],[3304,"","https://poetry.dctabudhabi.ae/diwan/poem/97991","الوافر"],[3460,"","https://poetry.dctabudhabi.ae/diwan/poem/112335","السريع"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89368","البسيط"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62742","الطويل"],[3534,"","https://poetry.dctabudhabi.ae/diwan/poem/127054","السريع"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86345","الوافر"],[3667,"","https://poetry.dctabudhabi.ae/diwan/poem/125774","السريع"],[3762,"","https://poetry.dctabudhabi.ae/diwan/poem/128916","السريع"],[3786,"","https://poetry.dctabudhabi.ae/diwan/poem/202343","البسيط"],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66615","الرجز"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114541","المنسرح"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103061","الطويل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44891","الرجز"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86479","البسيط"],[4053,"","https://poetry.dctabudhabi.ae/diwan/poem/78340","البسيط"],[4119,"","https://poetry.dctabudhabi.ae/diwan/poem/93252","المنسرح"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123527","الوافر"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94549","الوافر"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146765","المنسرح"],[4500,"","https://poetry.dctabudhabi.ae/diwan/poem/33691","السريع"],[4755,"صَدَاكِ ما أَبقَيتِ مِن عَافِيَةْ","https://www.poetsgate.com/ViewPoem.aspx?id=183621",""],[4755,"مُسافِرٌ قَلبي.. وجسمِي مُقِيمْ","https://www.poetsgate.com/ViewPoem.aspx?id=189737",""],[4755,"قَصيدةٌ بَعدَ أُخرَى.. ما الذي اتَّضَحَا؟!","https://www.poetsgate.com/ViewPoem.aspx?id=198424",""],[4984,"كم أتمنى ..","https://www.poetsgate.com/ViewPoem.aspx?id=215101",""],[4119,"واحربا في الثغور من بلد","https://www.poetsgate.com/ViewPoem.aspx?id=16144",""],[5409,"عشت نقي الجيب لم اقترف","https://www.poetsgate.com/ViewPoem.aspx?id=155410",""],[5457,"هي الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=213104",""],[5472,"فهمت ما قلت فى برّي ومنزلتى","https://www.poetsgate.com/ViewPoem.aspx?id=200470",""],[5518,"حين تسجد الكلمات","https://www.poetsgate.com/ViewPoem.aspx?id=201119",""],[5689,"أهبت فنلت من قلبي الجوابا","https://www.poetsgate.com/ViewPoem.aspx?id=143429",""],[5690,"هذا الصباح بدا أم ذا محياكِ","https://www.poetsgate.com/ViewPoem.aspx?id=172170",""]],"verses":[["وَلَم أَزجُرِ العَينَ الدُموعَ لِتَنتَهي","وَلَم أَعذُلِ القَلبَ اللَجوجَ لِيَصبِرا",0,"ر",2,0],["وَلَم أَزَعهُ إِلّا وَأَعقَبَني","سَطواً كَوَقعِ الظُبى عَلى اليَلَبِ",1,"ب",1,0],["ولم أزَلْ أخْطِرُ في رِدائِهِ","بينَ رَعابيبَ حِسانٍ كالدُّمى",2,"ا",1,0],["ولم أزل سَبِطَ الأخلاق واسعَها","وإن غدوتُ امرأً في لحيتي كَثَثُ",3,"ث",1,0],["ولم أزجرْ هناك الطيرَ لكنْ","ثناؤك حين تحتفِل الحُفولُ",4,"ل",1,0],["وَلَم أَزَل في أُموري كُلَّما عَرَضَت","عَلى اِهتِمامِكَ بَعدَ اللَهِ أَتَّكِلُ",5,"ل",1,0],["وَلَم أَزَل في رَحبِ أَكنافِهِ","أَقولُ بِاللَذّاتِ وَاللُبسِ",6,"س",1,0],["وَلَم أَزَل وَاللَيلُ سُترٌ لَنا","مِن دونِ رُقابٍ وَحُرّاسِ",7,"س",1,0],["ولم أزل أطرِى له ال","جد وأمدح الأبا",8,"ا",1,0],["ولم أَزَلْ منذ أخذِ العهدِ في قِدَمي","لكَعْبَةِ الحُسْنِ تجريدي وإجرامي",9,"م",2,0],["ولم أزل بالندامى كلما فترت","أكفهم سمتها روماً وكنياكا",10,"ك",2,0],["ولم أزْج وعظي نحو ودِّك أنّني","أخاف عليه الدهر أن يَتبدَّدا",11,"د",2,0],["ولم أزل وهي إلى جانبي","كظبيةٍ عفراء وحشيه",12,"ه",1,1],["ولم أزَل آكلُ من جَنّتي","تُفّاحَها ولم تزَل عندي",13,"د",2,0],["وَلَم أزل رافِعا صَوتي بِتَلبيَتي","مَع الملبين مِمَّن حج واِعتَمرا",14,"ر",2,0],["ولم أزل غير أني","محيّر في هواك",15,"ك",1,0],["وَلَم أَزَل مُتَسِّعاً مُسَبِّعاً","مُخَمِّساً مُثَلِّثاً مُوَحِّدا",16,"د",2,0],["وَلَم أَزَل أَرصُدُ بَدرَ الدُجى","حَتّى اِجتَلَيتُ البَدرَ في الشَمسِ",17,"س",1,0],["وَلَم أَزَل سامِعاً بَصيراً","أُجيبُ بِالنُطقِ مَن دَعاني",18,"ن",2,0],["وَلَم أَزَل بِوِشاحِ السُقمِ مُتَّشِحاً","أَغشى فُنونَ الأَسى طَوراً وَتَغَشّاني",19,"ن",2,0],["ولم أزل واثقاً بالصبر يُنجدُني","أو التجلُّدِ حتى خانَني جَلَدي",20,"د",2,0],["ولم أزل كلماتي فيك أنظمها","كما تتابع قطر المزن وانسجما",21,"م",2,0],["ولم أزَلْ في القرب من وُدِّه","أقرع بالأفراح باب النجاح",22,"ح",1,0],["ولم أَزَلْ أُطْنِبُ في شُكْرِكُمْ","غايَةَ ما يَبْلُغُ إِطْنَابِي",23,"ب",2,0],["ولم أَزَلْ في ارْتِشافِي منه رِيقَ فم","أَطفأْتُ في بردِهِ مشبوبةَ الحُرَقِ",24,"ق",1,0],["ولم أَزَلْ أَنْظِمُ في وَصْفِهِ","فرائدَ الأَمداحِ كالعِقْدِ",25,"د",1,0],["ولما زادَ ما بي من هواهُ","وألبسَ مهجتي ثوبَ الهوانِ",26,"ن",1,0],["ولمّا زارني سَحَراً حبيبٌ","بلطْفِ الخطو قد أخفىْ بحاله",27,"ه",1,1],["ولما زأرنا قيل سَكري تخبطوا","وما نحن من يعنو إلى اللهوِ والسكر",28,"ر",1,0],["ولما زاد عندي كل نقد","وميز بهرج الناس انتقادي",29,"د",2,0],["ولم أزل أمسح أعطافه","ورأيه في قصتي حائر",30,"ر",1,0],["وَلَم أَزَلْ مُشفقاً حتّى علمتُ بما","أَنالَهُ اللَّهُ مِن ظِلِّ السّلاماتِ",31,"ت",1,0],["وَلَمْ أَزَلْ دُونَ نَدْمَانِيَّ مُقْتَرِحَاً","شِعْرِي عَلَيْهَا تُغَنِّيْنِي وَأَسْقِيْهَا",32,"ي",3,0],["ولم أَزل على نداك والجاً","إِنِّي على نَدَاك كالمُدْلِ",33,"ل",1,0],["ولما زرته شاهدت منه ال","خليل مع المبرد في قميص",34,"ص",1,0],["ولم أزل بينهم للخصم متقياً","دخائلاً هي في ذهني وفي بالي",35,"ل",2,0],["ولم أزلْ منذ خاضَتْ","بيَ الأُموُر أمورا",36,"ر",2,0],["وَلَمّا زَحَفنا لِاِبنِ يوسُفَ غَدوَةً","وَأَبرَقَ مِنّا العارِضانِ وَأَرعَدا",37,"د",2,0],["وَلم أَزَل في لعب وَحَظ","وَأَفتن الناسَ بِحُسن لَفظي",38,"ي",1,0],["وَلَم أَزَل عَن الشَواطي مُبعدا","أَقتَحِمُ الخَطبَ وَأَنظُر العِدا",39,"د",2,0],["وَلَم أَزَل طول النَهار أَجري","وَطالَما صَحَوتُ قَبلَ الفَجرِ",40,"ر",1,0],["ولم أزل في عكاظ","أصبح في دكان",41,"ن",1,1],["ولم أزل باسمه أنادي","في كل واد وفي كل نادي",42,"د",2,0],["ولم أزَلْ في الرُّشدِ والتقوى معا","يُضرَبُ بي في ذى الأقاليم الَمثَلْ",43,"ل",1,0],["ولم ازل بذكره","في كل حين مستفيد",44,"د",1,0],["وَلَم أَزَل أَتبَعها حَتَّى أَتت","وَكراً لَها في رأس نبق فعدت",45,"ت",1,0],["وَلَم أزَل انظُر في النَواحي","وَأرهب الجَرس مِن الرِّياح",46,"ح",1,0],["وَلَم أَزل أهذبه","منقحاً وأحسبه",47,"ه",1,0],["وَلَم أَزَل في الهَوى مَضنى وَمفتتنا","أَمضي وَعَيشك أحكامي عَلي وَلي",48,"ل",2,0],["ولم أزل في خزانة الفرش أي","اماً مخلى في زي معتقل",49,"ل",1,0],["ولم أزل أدفعه جاهداً","وقد تقاعست إلى خلف",50,"ف",1,0],["ولم أزل أُدعى بسلمانهم","فاليوم هل أحظى بغفرانهم",51,"م",1,0],["ولم ازل هكذا حتى تنهنهني","عداوة وردت بين الاخلاء",52,"ا",2,0],["وَلَمّا زادَ شَأَنُكَ في المَعالي","غَدا لِلشِعرِ وَالشُعَراءِ شانُ",53,"ن",1,0],["ولم أزل حتى تساري النسيم","يحمل أنات فؤاد وجيع",54,"ع",1,0],["ولم أزل بشغله سميرا","فما أفدت عنده قطميرا",55,"ر",2,0],["ولمَّا زهدتُ الناسَ طراً بأسرهمْ","ونزّهتُ سمعي عن مجالسِ ذكرهمْ",56,"م",1,1],["ولم أزع من ودي سواعة أنها","لها الصفو من ودي الذي لا يؤشب",57,"ب",1,0],["ولم أزر مجالسا أهلها","من فئة على الورى باغيه",58,"ي",2,