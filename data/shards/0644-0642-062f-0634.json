ب"],[440,"تتبين شمل الدين أنك ناظمه","https://www.aldiwan.net/poem34869.html","الطويل"],[449,"لما علمت بما ألقى من الوصب","https://www.aldiwan.net/poem53774.html","الطويل"],[453,"قدوم به قد حل في الشام سيد","https://www.aldiwan.net/poem13713.html","الطويل"],[465,"لقد غاض بحر العلم بعد أخي العلم","https://www.aldiwan.net/poem3167.html","عموديه"],[465,"أطاع فما إلى صبر سبيل","https://www.aldiwan.net/poem3168.html","عموديه"],[465,"شهيدا غرامي ادمعي وسجومها","https://www.aldiwan.net/poem3217.html","عموديه"],[465,"ليهن الورى برء العلى والفضائل","https://www.aldiwan.net/poem3265.html","عموديه"],[465,"وجودك غادر النعمى معينا","https://www.aldiwan.net/poem3274.html","عموديه"],[465,"كيف الوقوف على آثار مرتحل","https://www.aldiwan.net/poem3470.html","عموديه"],[465,"حديث غرامي في هواك قديم","https://www.aldiwan.net/poem3516.html","عموديه"],[465,"درت أنها شمس الضحى فتجلت","https://www.aldiwan.net/poem3592.html","عموديه"],[465,"ألمت سليمى والنسيم عليل","https://www.aldiwan.net/poem3634.html","عموديه"],[471,"لقد شاقك الحي إذ ودعوا","https://www.aldiwan.net/poem4757.html","المتقارب"],[478,"على البان قمرية تسجع","https://www.aldiwan.net/poem15215.html","المتقارب"],[510,"لقد شهدت حقاً سدوس بأنني","https://www.aldiwan.net/poem748.html",""],[515,"أما والهوى لولا الجفون السواحر","https://www.aldiwan.net/poem20819.html","الطويل"],[515,"تصاحى وهو مخمور الجنان","https://www.aldiwan.net/poem20821.html","الوافر"],[515,"إلى الله نشكو فادحات النوائب","https://www.aldiwan.net/poem20840.html","الطويل"],[516,"إذا لم يكن بين القلوب صدود","https://www.aldiwan.net/poem12062.html","الطويل"],[516,"أما وخدود ألفن الصدودا","https://www.aldiwan.net/poem12070.html","المتقارب"],[539,"أمسوا يمر الذكر منك بمجلس","https://www.aldiwan.net/poem47992.html","عموديه"],[559,"أنا العاشق السالي لوجهك يا علو","https://www.aldiwan.net/poem33585.html","الطويل"],[563,"لقد شادها الحبر الجليل أغابيس","https://www.aldiwan.net/poem52541.html","الطويل"],[563,"تقلص ظل للشباب وريف","https://www.aldiwan.net/poem52757.html","الطويل"],[563,"أسحرا كان شغلي في هواكا","https://www.aldiwan.net/poem52945.html","الوافر"],[565,"بكم وغرامي محنتي وتولعي","https://www.aldiwan.net/poem868.html",""],[574,"الله أطفأ ما أذكى أبو قصبه","https://www.aldiwan.net/poem3661.html","البسيط"],[576,"لقد شيبتني في الزمان خطوبه","https://www.aldiwan.net/poem2765.html","الطويل"],[576,"سرى طيفه لا بل سرى بي سرابه","https://www.aldiwan.net/poem3103.html","الطويل"]],"verses":[["لَقَد شَغَلتَني المَرائي لَكُم","بِوَجدِيَ عَن أَن أَقولَ النَسيبا",0,"ب",2,0],["لَقَد شَفَّنِي عَتْبٌ تَراخَى بِهِ المَدى","وَمالي بِحَمدِ اللَهِ غَيرَ الهَوى ذَنبُ",1,"ب",1,0],["لَقَد شامَتكَ يا عَبّا","سُ يَومَ السَطحِ عَيناكا",2,"ك",2,1],["لَقَد شَقيتُ لَئِن دُمنا كَذا أَبَداً","إِذا سَعَيتُ لِإِصلاحِ الهَوى فَسَدا",3,"د",2,0],["لقدْ شِدْتَ رَبْعَ النّظْمِ بعْدَ دُروسِه","وأحْيَيْتَ منْهُ سفنّةً وافَقَتْ هَوى",4,"و",2,0],["لَقَدْ شَقِيتْ طَوْعَ الصَّبَابَةِ أَنْفُسٌ","حَبَا الرُّشْدُ مَثْوَاهَا وَبَايَنَهَا الْحِلْمُ",5,"م",1,0],["لقدْ شدّ أزْرَ المُلْكِ منْكَ خليفَةٌ","لهُ تحْتَ سِتْرِ الغَيْبِ نصْرٌ مؤزّرُ",6,"ر",1,0],["لَقَدْ شَاقَنِي مِنْكَ الْحَبِيبُ الْمُفَارِقُ","فَقَلْبي وَأَجْفَانيِ الْعَقيقُ وَبَارِقُ",7,"ق",1,0],["لَقَد شابَ مِن هَولِ القَوافي وَوَقعِها","وَإِتيانِهِ بِالمُعجِزِ المُتَمَنِّعِ",8,"ع",1,0],["لَقَد شَرَّفتَني وَرَفَعتَ قَدري","فَأَصبَحَتِ المجَرَّةُ لي سَريرا",9,"ر",2,0],["لَقَدْ شَفَعَتْ بِكَ الحَسَنَاتُ فِيهَا","فَشَفَّعَهَا لَكَ اللهُ المُعِينُ",10,"ن",1,0],["لَقَدْ شَعَرْنَا بِمَا غَضَّتْ جهَالَتُنَا","مِنَّا وَبَالَغَ فِي تَأْدِيبِنَا النّدَمُ",11,"م",1,0],["لقد شاهدت مبتهجاً بعيني","له في مصر آثاراً كبارا",12,"ر",2,0],["لقد شجُعوا والموت ليس له يد","ولم يَشجُعوا والموت يطعنهم شزرا",13,"ر",2,0],["لَقَد شَفَّني بَينُ الخَليطِ بِساجِرٍ","وَمَحبِسُ أَجمالٍ لَهُنَّ حَنينُ",14,"ن",1,0],["لَقَد شَدَّ بِالخَيلِ الهُذَيلُ عَلَيكُمُ","عِنانَينِ يُمضي الخَيلَ ثُمَّ يُعيدُها",15,"د",3,0],["لَقَد شَعَفَ الفُؤادَ غَداةَ رَهبى","تَفَرُّقُ نِيَّةِ الأَنَسِ الحُلولِ",16,"ل",1,0],["لَقَد شابَ رَأسي أَو دَنا لِمَشيبِهِ","وَما عَتَقَت سَعدُ بنِ زَرِّ وَلا هِندُ",17,"د",1,0],["لَقَد شَقِيَت كَعبٌ جَميعاً وَعامِرٌ","بِأَسيافِنا يَومَ اِلتَقَينا عَلى بَدرِ",18,"ر",1,1],["لقد شرَّفت ناسٌ وبادت وإنما","لكم شرفٌ في سائرِ الناسِ خالد",19,"د",1,0],["لقد شاءَ ربُّ الناس تفضيل قدرهم","كأنَّك فيهم يا أخا العين إنسان",20,"ن",1,0],["لَقَد شَبِعَ الذِئب وَالأَجدَلُ","وَأَقفَرَتِ الدور وَالأَربُعُ",21,"ع",1,0],["لَقَد شَرُفَت مِنهُ الصَعيدُ وِلايَةً","فَأَصبَحَ واديهِ بِهِ قَد تَقَدَّسا",22,"س",2,0],["لقد شجتني شكواه برقتها","وكل صوت رقيق بي له اثر",23,"ر",1,0],["لقد شدا عندليب فوق باسقة","كأن اوراقها للشعر ديوان",24,"ن",1,0],["لَقَد شابَ فَردي وَجازَ المَشيبَ","وَعَيدا شَبيبَتُها زاهِيَه",25,"ي",2,0],["لَقَد شَبَّ في هَذا الزَمانِ كُهولُهُ","لَدَيكَ وَشابَت عِندَ غَيرِكَ مُردُهُ",26,"د",2,0],["لقد شككتَ ظهورَ الخيلِ متعبةً","وإن شكت فَكَّهُنَّ المالُ شاكيكا",27,"ك",2,0],["لَقَد شَرَّدَتهُ الخَيلُ كُلَّ مُشَرَّدٍ","وَطَرَّحنَهُ يَومَ الوَغى كُلَّ مَطرَحِ",28,"ح",1,0],["لَقَد شَرَّدَ الأَعرابَ كُلَّ مُشَرَّدٍ","تَسَوُّقَ غادٍ في سِياقَتِهِ عَسفُ",29,"ف",1,0],["لَقَد شَهِدَت قَيسٌ فَما كانَ نَصرُها","قُتَيبَةَ إِلّا عَضَّها بِالأَباهِمِ",30,"م",1,0],["لقد شَقَيِتْ بمِديَتِكَ الأضاحي","كما شَقِيَتْ بغارَتِكَ القَوافي",31,"ف",2,0],["لقد شَكَتِ القصائدُ منك ضَيماً","فهل حامٍ يَقيها الضَّيمَ كافي",31,"ف",2,0],["لقد شَرُفَت بِسُؤْدُدِكَ القَوافي","وفاز المجدُ والحسَبُ التَّليدُ",32,"د",1,0],["لَقَد شَهِدَت أَهلُ المَمالِكِ أَنَّهُ","مَليكٌ لَهُ مِن فَوقِ قَدرِهِمُ قَدرُ",33,"ر",1,0],["لَقَد شَرِقَت في الشَرقِ بِالمَوتِ غادَةٌ","تَعَوَّضتُ مِنها غُربَةَ الدارِ في الغَربِ",34,"ب",1,0],["لقدْ شرَّفَتْ قدري وأعلَتْ مراتبي","ومثلُكَ حقاً مَنْ بهِ يٌتشرَّفُ",35,"ف",1,0],["لَقَد شَقيتُ وَكانَ الحَينُ لي سَبَباً","أَن عُلِّقَ القَلبُ قَلباً يُشبِهُ الحَجَرا",36,"ر",2,0],["لَقَد شَغَفَتني أُمُّ بَكرٍ وَبَغَّضَت","إِلَيَّ نِساءٌ ما لَهُنَّ ذُنوبُ",37,"ب",1,0],["لَقَد شَفَّ هَذا القَلبَ أَن لَيسَ بارِحاً","لَهُ شَجَنٌ ما يُستَطاعُ قَريبُ",38,"ب",1,0],["لَقَد شُفِعَت فِيهِفَزادت جَلالَهُ","كَمَا زان أفراد الَّلالِىءِ نَاظِمُ",39,"م",1,0],["لَقَد شَقيتُ شَقاءً لا اِنقِطاعَ لَهُ","إِن لَم أَفُز فَوزَةً تُنجي مِنَ النارِ",40,"ر",1,1],["لَقَد شَدَّت حَبائِلُ آلِ لَأيٍ","حِبالي بَعدَما ضَعُفَت قُواها",41,"ا",3,0],["لَقَد شُدَّ مُلكَ بَني هاشِمٍ","وَأَبدَلَهُ بِالفَسادِ الصَلاحا",42,"ح",2,1],["لقد شككتَ فؤادي","بأسهمِ الهجرانِ",43,"ن",1,0],["لَقَد شاعَ لِحَمّادٍ","بِداءٍ في اِستِهِ ذِكرُ",44,"ر",1,0],["لَقَد شانَ أَولادَ الزِناءِ سَوادُهُ","وَإِن كانَ في بَدرِ السَماءِ سَوادُ",45,"د",1,0],["لَقَد شَطَّ المَزارُ فَبِتُّ صَبّاً","يُطالِعُني الهَوى مِن كُلِّ بابِ",46,"ب",1,0],["لَقَد شَرِقَت عَيني بِعَبدَةَ غادِياً","وَدَبَّت لِقَتلي مِن هَواها عَقارِبي",47,"ب",2,0],["لَقَد شَغَلَت قَلبي عُبَيدَةُ في الهَوى","فَلَيسَ لِأُخرى في الفُؤادِ نَصيبُ",48,"ب",1,0],["لَقَد شَطَّ حيٌّ بِجِزعِ الأَغَرِّ","حَيّاً تَرَبَّعَ بِالشُربُبِ",49,"ب",1,0],["لقد شَفعت يومَ العروبةِ عِندَها","بعيدٍ لنا فيه السلامةُ والنُّجحُ",50,"ح",1,0],["لَقَد شَجاني صبيٌّ","يَلوي من اليتم جيدا",51,"د",2,0],["لَقَد شدوت بريعان المساء أَسىً","وَللمساء كما للصبح ريعان",52,"ن",1,0],["لَقَد شُغِفَت نَفسي بُثَينَ بِذِكرِكُم","كَما شُغِفَ المَخمورُ يا بَثنَ بِالخَمرِ",53,"ر",1,0],["لَقَدْ شَادَ أَصْيَدُهُمْ بَيْتَهُ","عَنَيْتُ بِهِ الصَّيْدَ دُونَ الصَّيَدْ",54,"د",1,0],["لَقَدْ شَغَلَتْهُ بِالْعُلَى عَنْ حُطَامِهَا","حَيَاةٌ بِهَا إِنْ تُعْنَ بِالرِّزْقِ تُرْزَقِ",55,"ق",1,0],["لقد شَعَبَ الشَّعْبِيُّ قَلْباً صَدَعْتِهِ","كما تَصْدَعُ المظلومةَ الخيلُ بالرَّكْضِ",56,"ض",1,0],["لَقَد شَفَت بِالبُعدِ لَو أَنَّها","مِن تنَّسٍ صارَت إِلى قِفطا",57,"ط",2,0],["لَقَد شَغَلَ الدُموعُ عَنِ الغَواني","مُصابُ الأَكرَمينَ بَني عَلِيِّ",58,"ي",1,0],["لقد شربوا من منهل الدين نغبةً","مطهّرةً فالظامئون رِوَاءُ",59,"ا",2,0],["لقد شربنا بكأس الراح أوَّلها","حلواً فماذا أصاب الكأسَ والراحا",60,"ح",2,0],["لقد شِيب بالسم الهواءُ فهل تُرى","يُشَابُ من الأنهار سائلها العذب",61,"ب",1,0],["لقد شبَّه العُربُ حسنَ البيانِ","والشعر في الزمنِ البائِن",62,"ن",1,0],["لقدْ شَرَّدَ الأَعرابَ كُلَّ مُشَرَّدٍ","تَسوُّقُ غَادٍ في سياقَيهِ عَسْفُ",63,"ف",1,0],["لَقَد شَهدت لَكَ العَلياء حَقّاً","وَفيك مَقالة الأَعداء زورُ",64,"ر",1,0],["لَقَد شَرَب الأَوائل كاس خَمر","غَدَت مِنهُ الأَواخر في خِمار",65,"ر",1,0],["لَقَد شَبهت بِالفلك اِعتِباراً","لَما قَد كانَ مِن أَمر مُديري",66,"ي",1,1],["لقد شمت الأعدا بما حرك القضا","عليَّ من البلوى وكدر خلاني",67,"ن",2,0],["لقد شبَّ بينَى هذا الغرامُ","وما بين قومِك حَربا زَبونا",68,"ن",2,0],["لَقَد شَجِيَت بِكَ الحُسّادُ غَيظاً","فَلا بَرِحَ الشَجى تِلكَ الحُلوقا",69,"ق",2,0],["لقد شادوا المؤسّس من قديم","بهم ترقى المكارم والخصال",70,"ل",1,0],["لقد شاع بين الناس بالأمس أنكم","سمعتم وقد شد المشد وشددا",71,"د",2,0],["لقد شربت ما لو تقيأت بعضه","جرى فوق وجه الأرض بحرٌ من الدما",72,"م",2,0],["لَقَد شَغَلتَني دونَ شُكرِكُم البُشرى","فَلا تُنكِروا إِن كُنتُ لَم أُجملِ الشُّكرا",73,"ر",2,1],["لَقَد شَمِلتهم لعنةٌ بعد لعنةٍ","منَ اللَّه مَغضوبين قَد دُحِروا دحرا",74,"ر",2,0],["لَقَد شرّف اللَّه الجدودَ بسرّهِ","بُطوناً ظهوراً والوجودَ بأسرهِ",75,"ه",1,0],["لَقد شَغلَت فؤادي عَن سواها","وَلَم تَترك له بالغيرِ شُغلا",76,"ل",2,0],["لَقَد شرّفتني في النوم فضلاً","بِتَقبيلي يداً منكُم وَرِجلا",76,"ل",2,0],["لقد شاب رأسي شاب من هول جوركم","ونار الجوى المكتوم تزفر بالشيب",77,"ب",1,0],["لَقَد شَعَرتُ بِأَنّي","أَمسُّ ذِكرى قَديمَه",78,"ه",1,0],["لقد شرحت منه الملائك صدره","وكان له من أبرك العمر أربع",79,"ع",1,0],["لقد شف قلبي الوجد نحو أحبتي","ومالي عنهم عائض فيعوض",80,"ض",1,0],["لَقَد شانَني أَدَبي بَينَكُم","كَما شينَ بِاللِحيَةِ الأَمرَدُ",81,"د",1,0],["لقد شاد مُلكاً أسَّسته جُدودُهُ","فأصبح ذا ملك أثيلٍ مُشَيَّد",82,"د",1,1],["لقد شاع إيماني بكلّ كلامه","فمن شاء فليؤمن ومن شاء فليكفُرْ",83,"ر",1,0],["لقد شرفت شهباؤنا بقدومه","كما شرف البيت العتيق رسول",84,"ل",1,0],["لقد شرفت بك هذي البقاع","كما شرف المجتبى يثربا",85,"ب",2,0],["لقد شهدت أطوادُ لبنانَ هولَهُ","فكادت تهي من هيبةٍ وتخشّع",86,"ع",1,0],["لقد شفيت نفسي وعادت إلى الهُدى","وإنَّ شفاءَ النفسِ منهُ شقاك",87,"ك",1,0],["لقد شهدَت مرّاكِشُ الفتَكةَ التي","لها ضَجَّتِ الأملاكُ والنَّجم غوَّرا",88,"ر",2,0],["لقد شهدَت أمٌّ وأختٌ وزوجةٌ","وبنتٌ وجُوهاً شوّه