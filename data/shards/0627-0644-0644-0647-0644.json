{"poems":[[53,"قالوا انتبذ قلت مهلا","https://www.aldiwan.net/poem62888.html","المجتث"],[93,"لا لهفة النفس على غابة","https://www.aldiwan.net/poem62811.html","عموديه"],[93,"كم بين طيات العصور الخاليه","https://www.aldiwan.net/poem62819.html","عموديه"],[91,"طلعت من الافق الجديد عطارد","https://www.aldiwan.net/poem44628.html","الكامل"],[91,"الله للعصفور من","https://www.aldiwan.net/poem44654.html","مجزوء الكامل"],[91,"صبوا على الاسماع نارا","https://www.aldiwan.net/poem44849.html","مجزوء الكامل"],[91,"يا روح هذه الدنى","https://www.aldiwan.net/poem44928.html","مجزوء الرجز"],[47,"وأمر من عللي تخلى ناظري","https://www.aldiwan.net/poem66681.html","الكامل"],[71,"لام ولو أنصف ما كان لام","https://www.aldiwan.net/poem28373.html","السريع"],[71,"الترك ملح الأرض في عصرنا","https://www.aldiwan.net/poem28737.html","السريع"],[107,"ما للنفوس إلى العماية تجنح","https://www.aldiwan.net/poem44223.html","الكامل"],[48,"الله لا ريب فيه وهو محتجب","https://www.aldiwan.net/poem22119.html","البسيط"],[108,"في مهرجان دار العلوم","https://www.poetsgate.com/ViewPoem.aspx?id=179366",""],[93,"عصر الرشيد","https://www.poetsgate.com/ViewPoem.aspx?id=53398",""],[164,"غدرت فيا باني الغزال الغادر","https://www.aldiwan.net/poem58938.html","الكامل"],[287,"دعني من الرشأ الأغن الأكيس","https://www.aldiwan.net/poem32739.html","الكامل"],[302,"الله لي من واعد وعده","https://www.aldiwan.net/poem32971.html","السريع"],[302,"سفرت أميمة ليلة النفر","https://www.aldiwan.net/poem33277.html","أحذ الكامل"],[309,"الله لا تشهد سواه ولا ترى","https://www.aldiwan.net/poem16758.html","الكامل"],[347,"قلبي يحدثني","https://www.aldiwan.net/poem55325.html","منهوك البسيط"],[463,"عِمي صباحا بعدنا واسلمي","https://www.aldiwan.net/poem55887.html","السريع"],[463,"راش نبالا في جفنه ورمى","https://www.aldiwan.net/poem55902.html","المنسرح"],[463,"بلوت هذا الدهر أطواره","https://www.aldiwan.net/poem56171.html","السريع"],[463,"أبلغ بها أمنية الطالب","https://www.aldiwan.net/poem56275.html","السريع"],[463,"يا دار لا أنهج القشيب","https://www.aldiwan.net/poem56284.html","مخلع البسيط"],[470,"على سناك سلام الله","https://www.aldiwan.net/poem36230.html","عموديه"],[484,"طال السبات فشأننا استلقاء","https://www.aldiwan.net/poem37618.html","الكامل"],[505,"رفرف غصن البان لا بمرق","https://www.aldiwan.net/poem37963.html","الرجز"],[543,"قدك يا جميل","https://www.aldiwan.net/poem47914.html","عموديه"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122791","المنسرح"],[1341,"","https://poetry.dctabudhabi.ae/diwan/poem/124688","السريع"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64586","الرجز"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110274","المنسرح"],[2048,"","https://poetry.dctabudhabi.ae/diwan/poem/110308","الكامل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27977","السريع"],[2580,"","https://poetry.dctabudhabi.ae/diwan/poem/87739","المتدارك"],[2649,"","https://poetry.dctabudhabi.ae/diwan/poem/105662","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201445","الكامل"],[3083,"","https://poetry.dctabudhabi.ae/diwan/poem/137983",""],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100829","الكامل"],[3484,"","https://poetry.dctabudhabi.ae/diwan/poem/216444",""],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138702",""],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77058","البسيط"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81240","البسيط"],[4755,"يا لَيْلْ.. باقِي مَعِي كِلْمَهْ","https://www.poetsgate.com/ViewPoem.aspx?id=201118",""],[4755,"الحِقدُ والأُخُوَّةُ","https://www.poetsgate.com/ViewPoem.aspx?id=183527",""],[4797,"كيك وعسل","https://www.poetsgate.com/ViewPoem.aspx?id=51279",""],[5038,"الشهيد","https://www.poetsgate.com/ViewPoem.aspx?id=190147",""],[3591,"أهلاً وسهلاً بالذي هو قابلُ","https://www.poetsgate.com/ViewPoem.aspx?id=149389",""],[5122,"وين أنت يالمعتصم","https://www.poetsgate.com/ViewPoem.aspx?id=24262",""],[5186,"الله للعرب، حسبي لطفه حسبي","https://www.poetsgate.com/ViewPoem.aspx?id=156499",""],[5455,"وحده بوحده","https://www.poetsgate.com/ViewPoem.aspx?id=34435",""],[5526,"ذكرياتي","https://www.poetsgate.com/ViewPoem.aspx?id=192601",""],[5564,"يا لله يارب الخلايق يامعبود","https://www.poetsgate.com/ViewPoem.aspx?id=186844",""],[5652,"ماغير صوتك لا ندهني ولبيت","https://www.poetsgate.com/ViewPoem.aspx?id=136695",""],[5652,"المماليك البحرية","https://www.poetsgate.com/ViewPoem.aspx?id=177048",""],[5732,"بالهرج يعطونك","https://www.poetsgate.com/ViewPoem.aspx?id=177914",""],[5732,"حل الرحيل وفرقوا شمل الاحباب","https://www.poetsgate.com/ViewPoem.aspx?id=177871",""],[5732,"عزي لمن مثلي","https://www.poetsgate.com/ViewPoem.aspx?id=177918",""],[5732,"سود الليالي","https://www.poetsgate.com/ViewPoem.aspx?id=177941",""],[5732,"يا معذبي بالحب","https://www.poetsgate.com/ViewPoem.aspx?id=177938",""],[5736,"إيمان","https://www.poetsgate.com/ViewPoem.aspx?id=208449",""],[5764,"ست وثلاثينك","https://www.poetsgate.com/ViewPoem.aspx?id=177319",""],[5790,"عذلوا عليك فأكثروا","https://www.poetsgate.com/ViewPoem.aspx?id=112043",""],[5956,"الله وحدَهُ فاطرُ الأكوانِ","https://www.poetsgate.com/ViewPoem.aspx?id=183100",""],[5956,"يا من أخذت من اسمكم معناهُ","https://www.poetsgate.com/ViewPoem.aspx?id=194377",""],[5997,"عِلْمُ الْبَيَاْن","https://www.poetsgate.com/ViewPoem.aspx?id=214993",""],[6038,"العشق","https://www.poetsgate.com/ViewPoem.aspx?id=25688",""],[6115,"ودعتك الله يوم شفتك مغادر","https://www.poetsgate.com/ViewPoem.aspx?id=180500",""],[6202,"روحي هنالك لا هنا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86727&r=&rc=28",""]],"verses":[["الله لي فيك من كلْ","لِ ما أخاف مُجير",0,"ر",1,0],["اللَهُ لَو دامَ زَمانُ الهَوى","وَدامَ مِن هِندٍ تَجَنّيها",1,"ي",3,0],["اللَهَ لَو حَرَصوا عَلى أَمجادِهِم","فَلَتِلكَ عُنوانُ الشُعوبِ الراقِيَه",2,"ي",2,0],["الله للأحرار في آدابهم","ماذا من المتعصبين تكابد",3,"د",1,0],["الله للعصفور من","بلواه ليس له مفر",4,"ر",1,1],["اللَه للوطن العزيز","فانه يشكو الصغارا",5,"ر",2,0],["اللَه لا يجزي على","اتيان ما شاء لنا",6,"ن",2,0],["اللَهُ لِلمُعتَزِّ جارٌ إِنَّهُ","جارٌ لَنا مِن رَيبِ كُلِّ زَمانِ",7,"ن",1,0],["اللهُ لي مِنْ وبأٍ قدْ سبا","حامَ على الروحِ وللنفسِ سامْ",8,"م",1,0],["اللهُ لا يوحشُ منْ أُنسهم","فجورُهُمْ أَهْوَنُ مِنْ فقدِهِمْ",9,"م",1,0],["اللّهُ لا وَلدٌ أحبُّ ولا أبٌ","منه فأين المُنتأَى والمنزحُ",10,"ح",1,0],["اللَهُ لا رَيبَ فيهِ وَهوَ مُحتَجِبٌ","بادٍ وَكُلٌّ إِلى طَبعٍ لَهُ جَذَبا",11,"ب",2,1],["الله لا يرضيه سَتْرُ هِبَاتِه","أتُرَاهُ قد خلَقَ الجمَال ليُستَرا؟",12,"ر",2,0],["الله لو حرصوا على أمجادهم","فتلك عنوان الشعوب الراقية",13,"ي",2,0],["الله لي وابن الممهد منهم","جار عليه لا يجير الجائر",14,"ر",1,0],["اللَهُ لي وَلَهُم وُجودُ الأَشرَفِ ال","مَلِكِ الَّذي مِن جودِهِ لَم أَيأَسِ",15,"س",1,0],["اللَه لي من واعدٍ وعدُهُ","كذبٌ وفي الإنجازِ من يَلمَعِ",16,"ع",1,1],["اللَه لي من حبِّ غانيَةٍ","تَرمي الحَشا مِن حيث لا تَدري",17,"ر",2,0],["اللَه لا تشهد سواه ولا ترى","إلاه في ملك وفي ملكوت",18,"ت",1,1],["اللَه لي مثل","والخلد لي طلب",19,"ب",1,0],["اللهَ لي من زمنٍ مائلٍ","عليّ جَورا كيفَ قلتُ احكمِ",20,"م",1,0],["اللهَ لي من أخٍ علِقتُ به","أوثقَ ما خلتُ حبلُه انجذَما",21,"م",2,0],["اللّهُ لي منتصفٌ من أخٍ","يكِيلُني بالعُرفِ إنكارَهْ",22,"ر",2,0],["اللّهَ للمغصوبِ فيكم على","ديونِه يا شِيعة الغاصبِ",23,"ب",1,0],["اللهُ لي إن طَرَحْتُ عِرضي","أُكلةَ آمالهم حسيبُ",24,"ب",1,0],["اللهَ .. لَو أنَّ أهلي أنصَفُوا دَمَهُم","لكنَّ أهليَ فَرْط َالذُّلِّ ما نَصَفُوا",25,"ف",3,0],["اللّه لم يلبسك إلا عزة","خلعت عليها الملة السمحاء",26,"ا",2,0],["اللهُ لا تجعَلْ سِواهُ مَوْئلاً","وارْكُنْ إليه وعلى الدُّنيا العَفَا",27,"ف",2,0],["أَللَّهُ لِلعُشَّاقِ","سِيَّما مَن يُلاقي",28,"ي",1,0],["اللهُ لِلعَبدِ في تَصَرُّفِهِ","إن خانَهُ دَهرُهُ وَإخوانُه",29,"ن",2,0],["اللّه لم يطلع عليه الضحى","إلا صريع الناب والمنسم",30,"م",1,0],["اللّه لا إله إلا هو عن","مراده ما كان أو ما لم يكن",31,"ن",1,0],["اللّه لا إله إلا هو لا","تدركه الأبصار جل وعلا",31,"ل",2,0],["اللّه لا إله إلا هو به","قام الوجود في صنوف رتبه",31,"ه",1,0],["اللّه لا إله إلا هو عم","عباده كما أراد بالنعم",31,"م",1,0],["اللَه لي بعد أن غدوتُ أباً","جعلت روحي في المهد مع ولدي",32,"د",2,0],["اللَه للجبل المفدى مجتنى","ثمر النعيم ومجتلى أنواره",33,"ر",2,0],["الله لا يعرفه غيره","وما هنا غير فلا تغفلوا",34,"ل",3,0],["اللَه لِأَوطانٍ فُجِعَت","وَلشَعب حرٍّ قَد رُزيا",35,"ي",2,0],["ألله للشعب الذي أشواكه","حكمت على ان تخنق الأوراد",36,"د",1,0],["الله لم يحمل إساءة خلقه","أأطيق حملهمُ أنا المخلوقُ",37,"ق",1,0],["الله لي من طول هجره حسيب","يا ما أشد قلبه وما اقساه",38,"ا",2,0],["اللَه لو نظروا القضاء يصونه","بيمينه وتحوطه الاقدار",39,"ر",1,0],["الله لا حَلّه ولا باحه","يوم مِنّي يطلب الحِلّي",40,"ل",2,0],["الله لم يرتدع اللعين عن","طغيانه يا ليت سيفه نبا",41,"ب",2,0],["اللَهُ لِما يَرى خَلقاً فأَتقنهُ","بِكُم هُداهُم وَليل الغَي مُعتَكَر",42,"ر",1,0],["اللَهُ لِي وَلصرح الدين مِن رَيب","مَجنونة الرَأي ثارَت حَولَ مَعبودي",43,"د",2,0],["اللهْ لا يجعَلَكْ تُهمَه","نُجلَدْ عَلَيها ونتْلَطَّمْ",44,"م",1,0],["الله لَن يَنَالَ مِن جَميعِكُم قَتِيلًا","أَو قَاتِلًا, فَكُلُّكُم لِغَيرِهِ أَضَاحِي",45,"ح",2,0],["الله لايعطيه ناسن ينظلون","ويستر عليه من النحل لاياكله",46,"ل",2,0],["اللهُ للشّهداءِ قالَ لهمْ","سَنُريهُمُ جنّاتِنا الأخْرى",47,"ر",2,0],["اللهُ لستُ إلى النوال بمعوزٍ","فجميل فعلك والخلائق نائلُ",48,"ل",1,0],["الله لو شفت وشلون الرشيديه","ماكنه دوج بها للعز روادي",49,"د",2,0],["الله للعرب، حسبي لطفه حسبي،","في ما دهى العرب من كرب ومن خطب",50,"ب",1,1],["الله لامنّه ذكر مامضاله","قبل الدواير ماتجر الدواير",51,"ر",1,0],["الله .. لو ترجع بنا بس الايام","وأعيد ترتيب البشر في حياتي",52,"ت",2,1],["الله لنا يخليه سلطان وسعود","واللى بعدهم عصبتي من رجاله",53,"ل",2,0],["الله لنا في ضيقتي لوّي شكيت","والله يعين الي غدى كله جروح",54,"ح",1,0],["الله .. ! لو قومات الايام تنزاح","عن فتنةٍ هدت صروحٍ تليده",55,"د",2,0],["الله لا يجزا هل الحقد بالخير","اللي سعو بفرقا خل لخله",56,"ل",2,0],["الله لايجزي عريبين الانساب","لو هم على ماقيل سوٍ على الخيل",57,"ل",1,0],["الله لحد يا بعد حي نوده","لعل يسقي ديرته كل رايح",58,"ح",1,1],["الله لحد ما فيه حي يعزين","وعلى زمان فات جريت ونه",59,"ن",2,0],["الله لا يبلي صديق ببلواي","ومن نور عيني لا يخيب رجايه",60,"ا",3,0],["الله لو نطقت نورُ اليقينِ بها","أنعم بمن هو رغم القهر إنسانُ",61,"ن",1,0],["الله لايجعل على قلبك هموم","والله لايجعل على عينك إسهاد",62,"د",1,0],["الله لي من كل ما","أخشاه والمستنصر",63,"ر",1,0],["الله لي فيما أحا","ذر والإمام الأطهر",63,"ر",1,0],["الله لا يرضى التناحرَ بيننا","وثقافةَ التكفيرِ والشّنآنِ",64,"ن",1,0],["الله لي اختار الصراط إليهما","بملائكٍ تجري بوحي هُداهُ",65,"ا",2,0],["اللهُ لَا رَبّاً سِوَاهُ وَلَيْسَ لِي","إلَّاهُ مَوْلَى نَابِضٌ بِفُؤَادِيْ",66,"د",2,0],["الله لقاءك ما اجمله","يا ربيع كل الفصول",67,"ل",1,0],["الله لو تدري بما فى المشاعر","الحزن عمّ قلوبنا يوم فرقاك",68,"ك",1,0],["اللهَ لي ولغربتي","لولا الخيال بنا دنا",69,"ن",2,0]]}