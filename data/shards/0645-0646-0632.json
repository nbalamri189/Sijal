"https://www.aldiwan.net/poem12136.html","البسيط"],[518,"يا زمان العكس قلاب الأمور","https://www.aldiwan.net/poem818.html",""],[527,"هذا مقام العائذ","https://www.aldiwan.net/poem37427.html","مجزوء الكامل"],[536,"نلت عطفي وحناني","https://www.aldiwan.net/poem47925.html","عموديه"],[549,"أما ترى الدهر لا يبقي على حال","https://www.aldiwan.net/poem47289.html","البسيط"],[549,"عرج على الدارسة القفر","https://www.aldiwan.net/poem47777.html","الرجز"],[556,"طريقتنا قل بأقوالها","https://www.aldiwan.net/poem33500.html","المتقارب"],[556,"إن الذي أكد وعدي وفاه","https://www.aldiwan.net/poem33660.html","السريع"],[556,"يا ذوينا وأمنا وأبينا","https://www.aldiwan.net/poem34437.html","الخفيف"],[556,"لو خلق الله وجودا للورى","https://www.aldiwan.net/poem34491.html","الرجز"],[560,"هل للذي في حشاه حزن يعقوب","https://www.aldiwan.net/poem52873.html","البسيط"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[573,"قد زارني نصف ليلي","https://www.aldiwan.net/poem2713.html","المجتث"],[573,"حتى خيالك لا وفى ولا وافى","https://www.aldiwan.net/poem3051.html","البسيط"],[573,"رأت منك رائيتي ما تحب","https://www.aldiwan.net/poem3095.html","المتقارب"]],"verses":[["مِنزِلٌ مِن آلِ لَيلى لَم يَدَع","وَلَعُ الدَهرِ بِهِ إِلّا رِماما",0,"م",2,0],["مُنزِعُ النَبلَةِ قَد طا","رَ بِها الريشُ اللُؤامُ",1,"م",1,0],["مَنزِلي لا يَزالُ يَد","نو إِلى كُلِّ طارِقِ",2,"ق",1,0],["مَنزِلي قَلعَةٌ وَلُبثٌ فَهَذا","كَ مَجازاً لَنا وَهَذا مَقَرّا",3,"ر",2,0],["مَنزِلٌ حَلَّ بِهِ لي سَكَنٌ","بَعدَما اختارَ فؤادي وَطَنا",4,"ن",2,0],["مَنزِلٌ أَشرَقَت بِساكِنِهِ الأَر","ضُ وَأَشقَت بِهِ العُيونُ القُلوبا",5,"ب",2,0],["مَنْ زَارَ رَبْعَكَ لَمْ تَبْرَحْ جَوَارِحُهُ","تَرْوِي أَحَادِيثَ مَا أَوْلَيْتَ مِنْ منَنِ",6,"ن",1,0],["مِن زِقاقِ التَجرِ في باطِيَةٍ","جَونَةٍ حارِيَّةٍ ذاتِ رَوَح",7,"ح",1,0],["مَنْ زَاره من مُؤَرِّخِيهِ","رأَى هُنَا مَوْضِعَ الثُّرَيَّا",8,"ي",2,0],["مَنْ زَيَّفَ الأَحْكَامَ لَمْ يَكُ نَاقِماً","بَلْ نَاقِداً فَلْيُبْدِ حُجَّةَ نَقْدِهِ",9,"د",2,0],["مُنَزَّهُ اللَّفْظِ وَالإِيمَانِ عَنْ رِيَبٍ","حُرُّ الضَّمِيرِ نَقِيُّ الطَّبْعِ منْ دَرَنِ",10,"ن",1,0],["مِنْ زَاخِرِ الإِيْقَاعِ تَخْرُجُ","مُفْرَدَاتٍ كَالَّلآلِي",11,"ي",1,0],["مَنزلَ اليُمْن والرضا والسُّعودِ","أَنجزت فيه صادقات الوعودِ",12,"د",1,1],["منزّهة عن الفحشاء خَوْد","من الخَفِرات آنسة عَروب",13,"ب",1,0],["مَن زائِرٌ زارَ لَم تَرجِع تَحِيَّتُهُ","ماذا الَّذي ضَرَّهُم لَو أَنَّهُم رَجَعوا",14,"ع",3,0],["من زهرةٍ قد حفَّها شجر","للطير فيها أَيُّما لَجبِ",15,"ب",1,0],["مَنْزل يشهد بالنْب","لِ كُبارٌ لِكُبار",16,"ر",1,0],["من زارنا فيه ألقى اللَهُ حاضرهُ","ناهيك من حاضر فيه ومحتضَر",17,"ر",1,0],["من زغباتٍ منظَّمات","في خدِّهِ زانَها النِّظام",18,"م",1,0],["مَنزِلٌ لَيسَ عَلى الأَر","ضِ لَهُ عِندي نَظيرُ",19,"ر",1,0],["منزل يملؤه","عوض النور حلك",20,"ك",1,0],["مَنزِلاً قارَعوا عَلَيهِ العَمالي","قَ وَعاداً في عِزِّها وَثَمودا",21,"د",2,0],["مَنزِلٌ لاتَزالُ تَسري إِلَيهِ","طُرُقُ الرُغبِ قائِماتٍ مَنارُه",22,"ر",2,0],["مِن زِياداتِ النَقيصاتِ لَهُ","طَبَقٌ يَركَبُهُ بَعدَ طَبَق",23,"ق",1,0],["مَنزِلٌ لي بِالعِراقِ إِختَرتُهُ","لَم يَشُب حُرَّ يَقيني فيهِ شَكّ",24,"ك",1,0],["مَنزِلٌ هاجَ لي الصَبابَةَ وَالشَي","بُ قَريني فيها وَساءَ قَرينا",25,"ن",2,0],["مَنزِلٌ كانَ بَينَ دِجلَةَ فيهِ","لَكَ صَحنٌ تَرعى بِهِ العَينانِ",26,"ن",1,0],["منزل فيه لصياد المها","شرك يدفن في الترب وفخ",27,"خ",1,0],["مَنزِلٌ كالرَّبيعِ حَلَّتْ عليه","حالياتُ السِّحابِ عِقْدَ النِّطاقِ",28,"ق",1,0],["مَنزِلٌ في فِناء دِجلةَ يرتا","حُ إليه الخليعُ والمَستورُ",29,"ر",1,0],["مَنزِلٌ ما يَثبُتُ المَرءُ بِهِ","سالِماً إِلّا قَليلاً إِن ثَبَت",30,"ت",1,0],["مِن زَهَرٍ مُفَتِّحٍ أَو غُصنٍ","مُرَنَّحٍ أَو طائِرٍ مُغَرِّدِ",31,"د",1,0],["مُنَزَّهُ النّفسِ سمحٌ ما لَهُ أمَلٌ","إلّا مَكارِمُ يَحويها بنو الأملِ",32,"ل",1,0],["مَن زارَ في سنةِ الأَجفانِ في خَفَرٍ","لم يخش غيرانَ مرهوبَ الشذا حَنِقا",33,"ق",2,0],["مَنزِلاً موحِشاً وَإِن كانَ مَع","موراً بِحِلِّ الصَديقِ وَالأَحبابِ",34,"ب",1,0],["مَن زاحَفَ الأَيّامَ ثُمَّ عَبا لَها","غَيرَ القَناعَةِ لَم يَزَل مَفلولا",35,"ل",2,0],["مُنَزَّهَةٌ عَنِ السَرَقِ المُوَرّى","مُكَرَّمَةً عَنِ المَعنى المُعادِ",36,"د",1,0],["مَنزِلَ مَن راحَ مِنهُ مُعتَمِراً","لَيلَةَ سِتٍّ خَلَونَ مِن رَجَبِ",37,"ب",1,0],["مَنزِلاً كانَ لَنا مَرَّةً","وَطَناً نَحتَلُّهُ كُلَّ عام",38,"م",1,0],["مَنزِلٌ أَقوى بِسَلمى وَرُبوعُ","تُعذَرُ الأَنفاسُ فيهِ وَالدُموعُ",39,"ع",1,1],["مُنَزَّهٌ عَنْ شَرِيكٍ في محاسِنِهِ","فَجَوْهَرُ الحُسْنِ فيه غيرُ مُنْقَسِمِ",40,"م",1,0],["مَنْ زِيُّه أنْ لا يجيءَ مُقَنَّعاً","حتى يَقُدّ مُتَوَّجاً ومَعُصَّبا",41,"ب",2,0],["مَن زادَنا النَقدَ زِدنا في مَوَدَّتِهِ","ما يَطلُبُ الناسُ إِلّا كُلَّ رُجحانِ",42,"ن",1,1],["مَنزِلٌ دَمَّنَهُ آباؤُنا ال","مورِثونا المَجدَ في أولى اللَيالِ",43,"ل",1,0],["من زل من عجل يوماً فأحر به","بعد السَلامة أن يمشي عَلى مهل",44,"ل",1,0],["مَنْ زخْرَفَ الوادي وأجرَى به","جداولَ التبر كماءٍ معينْ",45,"ن",1,0],["منزّلا بحسب الزمان","مفصّل اللؤلؤ والجمان",46,"ن",1,0],["منزلة في غالب عليّهْ","وشيمٌ تقطر جاهليّهْ",47,"ه",1,0],["منزّل الذّكر بخير الألسن","مشتملا على البيان الأحسن",48,"ن",1,0],["مِنْ زُرْقَةِ السَّمَاءِ فِي اليَوْمٍ","البَشُوشِ المُقْبِلِ",49,"ل",1,0],["مُنَزَّهُ الشِّيمَةِ عَنْ","عَيْبٍ وَعَنْ تَبَذُّلِ",49,"ل",1,0],["مِنْ زَائِرٍ لمحَ التُّقَى مُتَجَلِّياً","كَالنُّورِ مِنْ سِتْرِ الْجَلاَلِ الْحَاجِبِ",50,"ب",1,0],["مَنْ زان صدرَ المجلس الأعلى وقد","طفح الجلال بحيثُ فاض النادي",51,"د",2,0],["مَنزِلٌ هَاجَ لِي الصّبَابَةَ،","والشَّ يْبُ قَرِيني فيهِ، فَسَاءَ قَرِينَا",52,"ن",2,0],["من زمني وأحربي واحزني","وا اسفي والهفي من زمن",53,"ن",1,0],["منزل أنزل الدما من عيوني ال","معصرات السحائب الممطرات",54,"ت",1,0],["منزلنا رحب لمن زارنا","ما عاقنا في سوحه عائق",55,"ق",1,1],["من زاحف الأيام في جيشها","فبالطلى كر على البتر",56,"ر",1,0],["من زهر جلعاد الأشم","ومن ربى تلك المنارة",57,"ر",2,0],["منزهةٌ تاهتْ على أخواتها","بمعنى دقيقٍ في العبارةِ ظاهرِ",58,"ر",1,0],["منزلاتٍ أودت بهن السوارى","وسوافي الرياح نُكبَا وقُومَا",59,"م",2,0],["منزلتي أحمد عظمها","وكم وكم يداً له معظمُ",60,"م",1,1],["من زاحمَ الأُسدَ في غاباتها وقعا","في معضلٍ ليس إِن دافَعتْه اندفعا",61,"ع",2,1],["منزهة عن لو ولولا خصا له","فما خصلة فيها بلولا ولو دعوى",62,"و",2,0],["مَنزلةٌ مَا خِلتها يَرضى بِها","لِنَفسِهِ ذو أرَبٍ وَلا حِجى",63,"ا",1,0],["مَن زنى فليتبطّنْ حُرّةً","وليكُفَّ اليدَ عن كلِّ أَمَهْ",64,"ه",1,0],["من زمان فيه القبول لذي الجه","ل ووقتٍ لذي الحجى لفاظ",65,"ظ",1,0],["مَن زارَهُ فَكَأَنَّما قَد زارَهُ","حَيّاً زِيارَةَ صِحَّةٍ وَعَيانِ",66,"ن",1,0],["مَن زارَهُ وَجَبَت شَفاعَتُهُ لَهُ","فَنَجا مِنَ الزَّقّومِ وَالقطرانِ",66,"ن",1,0],["مُنَزَّهِ العِرضِ عَنِ الأَدناسِ","زاكي الفُروعِ طاهِرِ الأَغراسِ",67,"س",1,0],["مَنزِلَةٌ ما اِرتَقى إِلَيها ال","فَضلُ وَلا نالَها الرَبيعُ",68,"ع",1,0],["مِن زَرَدٍ مُحكَمٍ بَراقِعُهُ","وَتَحتَها مِن عِذارِهِ زَرَدُ",69,"د",1,0],["مَنزِلُهُ رَحبٌ لِزُوّارِهِ","فَإِن سَرى ضاقَت بِهِ البيدُ",70,"د",1,0],["مِنْ زَهْرَةِ الْمَوْجُودْ","بَاهِتْ بِهِ الأَشْرَاطْ",71,"ط",1,0],["مَنْ زَارَ مِنْهُ هُمَاماً","آوَى لِرُكْنٍ شَدِيدِ",72,"د",1,0],["من زيّنتَ الأكوانَ به","تزيين الدرّة للصدف",73,"ف",1,0],["مِنْ زَاهِراتِ حُلاهُ حِلْمٌ بارِزٌ","أَعْيا مُعاوِيَةً وعِلْمٌ بارِعُ",74,"ع",1,0],["منْ زُهَيْرٍ في الإجَادَةِ أَوْ","فِي فِنَاءِ الجُودِ مِنْ هَرِمِ",75,"م",1,0],["مَنزِلٌ أَوطِنُهُ الفَقرَ فَلَو","دَخَلَ السارِقُ فيهِ سُرِقا",76,"ق",2,0],["من زارَه في ظلام اللَيلِ مُستَتِراً","ما شَكَّ في أَنَّ بدرَ التمِّ زائرُهُ",77,"ر",2,0],["مَنزِلٍ لَم يَزَل يَضي","قُ وَيَنبو بِمَن نَزَل",78,"ل",1,0],["مَنْزِلي في ذلك البَرِّ","وَفي ذا البَرِّ زَادِي",79,"ي",1,1],["منزل الغائبين حضرة قلبي","فعليهم من السلام السلام",80,"م",1,0],["مَنزل يَشرح الصُدور جَمالاً","وَنَوالاً لِلوَفد وَالطلّابِ",81,"ب",1,0],["مَنَزِلُهُ وَقفٌ عَلَى الزَّدِ والقِرى","يَحُلُّ فَرِيقٌ إِذ يَسِيرُ فِريقُ",82,"ق",1,0],["مَنزل قَد حَوى جَمالا وَحسنا","فَهوَ رَوض يَميل بِالاغصان",83,"ن",1,0],["مُنزَّهُ الخُلْقِ عن جُبْنٍ وعن بَخَلٍ","مُخلَّصُ العِرْضِ من ذَمّ ومن ذام",84,"م",1,0],["من زمانٍ أَضحَى لئيمُ شِباعِ الرْ","رَهْطِ أهلهِ كريمَ الخِماص",85,"ص",1,0],["مَن زائري واللّيلُ أدهمُ صافِنٌ","ومُودّعي والفجرُ أَشقَرُ مُحضِر",86,"ر",1,0],["من زمانٍ جَفا فأضحَتْ ولم تَظْ","لِمْ بنو