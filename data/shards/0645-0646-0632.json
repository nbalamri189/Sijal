{"poems":[[53,"أعلى الغور تعرفت الخياما","https://www.aldiwan.net/poem29816.html","الرمل"],[53,"زار والركب حرام","https://www.aldiwan.net/poem29819.html","مجزوء الرمل"],[53,"سيدي أنت ليس كلل","https://www.aldiwan.net/poem29953.html","مجزوء الخفيف"],[53,"لو رأيت الغرام يبلغ عذرا","https://www.aldiwan.net/poem30442.html","الخفيف"],[63,"عرضت والنجم واه عقده","https://www.aldiwan.net/poem45808.html","الرمل"],[55,"إن بالشط نحو دار المعلى","https://www.aldiwan.net/poem26478.html","الخفيف"],[77,"يا خاتم الفضل أو يا حاتم الزمن","https://www.aldiwan.net/poem36034.html","البسيط"],[9,"ما تعيف اليوم في الطير الروح","https://www.aldiwan.net/poem21921.html","الرمل"],[93,"زوج سليم إليه آبت","https://www.aldiwan.net/poem11099.html","مخلع البسيط"],[93,"در في سمائك يا قضاء فإن يثر","https://www.aldiwan.net/poem11145.html","الكامل"],[93,"أمرتني وبهذا الأمر تسعدني","https://www.aldiwan.net/poem11261.html","البسيط"],[93,"يا حبذا أخت الغزال","https://www.aldiwan.net/poem11463.html","مجزوء الكامل"],[83,"منزل اليمن والرضا والسعود","https://www.aldiwan.net/poem54325.html","الطويل"],[88,"بدت كالشمس يحضنها الغروب","https://www.aldiwan.net/poem45008.html","الوافر"],[27,"أواصل أنت أم العمرو أم تدع","https://www.aldiwan.net/poem5802.html","البسيط"],[51,"يا ابن المسيب عشت في نعم","https://www.aldiwan.net/poem8151.html","الكامل"],[51,"دار أمن وقرار","https://www.aldiwan.net/poem62849.html","مجزوء الرمل"],[51,"يا ناعي ابن رسول الله في البشر","https://www.aldiwan.net/poem64080.html","البسيط"],[51,"أفي هوى يوسف ألام","https://www.aldiwan.net/poem66363.html","مخلع البسيط"],[70,"حبذا دور على الني","https://www.aldiwan.net/poem42900.html","مجزوء الرمل"],[89,"إن من قد جبلك","https://www.aldiwan.net/poem44848.html","مجزوء المديد"],[45,"إنما الغي أن يكون رشيدا","https://www.aldiwan.net/poem63464.html","الخفيف"],[45,"شط من ساكن الغوير مزاره","https://www.aldiwan.net/poem63580.html","الخفيف"],[45,"قلت للائم في الحب أفق","https://www.aldiwan.net/poem65180.html","الرمل"],[45,"هبل الواشي بها أنى أفك","https://www.aldiwan.net/poem65215.html","الرمل"],[45,"هم ألى رائحون أم غادونا","https://www.aldiwan.net/poem66662.html","الخفيف"],[45,"يا أخا الفضل والندى يا أبا العباس","https://www.aldiwan.net/poem66835.html","الخفيف"],[61,"قل لجار الشط ما هذا الوسخ","https://www.aldiwan.net/poem51371.html","الرمل"],[61,"عش مدى الدهر يا أبا إسحاق","https://www.aldiwan.net/poem51505.html","الخفيف"],[61,"أربعاء حسامه مشهور","https://www.aldiwan.net/poem51674.html","الخفيف"],[49,"من يعش يكبر ومن يكبر يمت","https://www.aldiwan.net/poem10392.html","الرمل"],[66,"أقطرات أدمعي لا تجمدي","https://www.aldiwan.net/poem40965.html","الرجز"],[80,"ملاعب البيض بين البيض والأسل","https://www.aldiwan.net/poem31322.html","البسيط"],[80,"ما للوشاة عليها أذكت الحدقا","https://www.aldiwan.net/poem31358.html","البسيط"],[44,"ريب دهر أصم دون العتاب","https://www.aldiwan.net/poem30322.html","الخفيف"],[44,"يوم الفراق لقد خلقت طويلا","https://www.aldiwan.net/poem30378.html","الكامل"],[44,"سقى عهد الحمى سبل العهاد","https://www.aldiwan.net/poem30558.html","الكامل"],[31,"أمست كراع الغميم موحشة","https://www.aldiwan.net/poem42619.html","المنسرح"],[39,"شث شعب الحي التئام","https://www.aldiwan.net/poem53751.html","المديد"],[52,"منزل أقوى بسلمى وربوع","https://www.aldiwan.net/poem26865.html","الرمل"],[67,"أمن تذكر جيران بذي سلم","https://www.aldiwan.net/poem18097.html","البسيط"],[75,"كذب السلو العشق أيسر مركبا","https://www.aldiwan.net/poem69104.html","الكامل"],[50,"من زادنا النقد زدنا في مودته","https://www.aldiwan.net/poem24523.html","البسيط"],[15,"يا خليلي اربعا واستخبرا المنزل","https://www.aldiwan.net/poem45251.html","الرمل"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85351","البسيط"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39613","السريع"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202532","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202544","الرجز"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202526","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55172","الرجز"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54557","الكامل"],[90,"أمين الريحاني","https://www.poetsgate.com/ViewPoem.aspx?id=178954",""],[45,"هُمُ أُلَى رائِحُونَ، أو غَادُونَا","https://www.poetsgate.com/ViewPoem.aspx?id=32088",""]],"verses":[["مِنزِلٌ مِن آلِ لَيلى لَم يَدَع","وَلَعُ الدَهرِ بِهِ إِلّا رِماما",0,"م",2,0],["مُنزِعُ النَبلَةِ قَد طا","رَ بِها الريشُ اللُؤامُ",1,"م",1,0],["مَنزِلي لا يَزالُ يَد","نو إِلى كُلِّ طارِقِ",2,"ق",1,0],["مَنزِلي قَلعَةٌ وَلُبثٌ فَهَذا","كَ مَجازاً لَنا وَهَذا مَقَرّا",3,"ر",2,0],["مَنزِلٌ حَلَّ بِهِ لي سَكَنٌ","بَعدَما اختارَ فؤادي وَطَنا",4,"ن",2,0],["مَنزِلٌ أَشرَقَت بِساكِنِهِ الأَر","ضُ وَأَشقَت بِهِ العُيونُ القُلوبا",5,"ب",2,0],["مَنْ زَارَ رَبْعَكَ لَمْ تَبْرَحْ جَوَارِحُهُ","تَرْوِي أَحَادِيثَ مَا أَوْلَيْتَ مِنْ منَنِ",6,"ن",1,0],["مِن زِقاقِ التَجرِ في باطِيَةٍ","جَونَةٍ حارِيَّةٍ ذاتِ رَوَح",7,"ح",1,0],["مَنْ زَاره من مُؤَرِّخِيهِ","رأَى هُنَا مَوْضِعَ الثُّرَيَّا",8,"ي",2,0],["مَنْ زَيَّفَ الأَحْكَامَ لَمْ يَكُ نَاقِماً","بَلْ نَاقِداً فَلْيُبْدِ حُجَّةَ نَقْدِهِ",9,"د",2,0],["مُنَزَّهُ اللَّفْظِ وَالإِيمَانِ عَنْ رِيَبٍ","حُرُّ الضَّمِيرِ نَقِيُّ الطَّبْعِ منْ دَرَنِ",10,"ن",1,0],["مِنْ زَاخِرِ الإِيْقَاعِ تَخْرُجُ","مُفْرَدَاتٍ كَالَّلآلِي",11,"ي",1,0],["مَنزلَ اليُمْن والرضا والسُّعودِ","أَنجزت فيه صادقات الوعودِ",12,"د",1,1],["منزّهة عن الفحشاء خَوْد","من الخَفِرات آنسة عَروب",13,"ب",1,0],["مَن زائِرٌ زارَ لَم تَرجِع تَحِيَّتُهُ","ماذا الَّذي ضَرَّهُم لَو أَنَّهُم رَجَعوا",14,"ع",3,0],["من زهرةٍ قد حفَّها شجر","للطير فيها أَيُّما لَجبِ",15,"ب",1,0],["مَنْزل يشهد بالنْب","لِ كُبارٌ لِكُبار",16,"ر",1,0],["من زارنا فيه ألقى اللَهُ حاضرهُ","ناهيك من حاضر فيه ومحتضَر",17,"ر",1,0],["من زغباتٍ منظَّمات","في خدِّهِ زانَها النِّظام",18,"م",1,0],["مَنزِلٌ لَيسَ عَلى الأَر","ضِ لَهُ عِندي نَظيرُ",19,"ر",1,0],["منزل يملؤه","عوض النور حلك",20,"ك",1,0],["مَنزِلاً قارَعوا عَلَيهِ العَمالي","قَ وَعاداً في عِزِّها وَثَمودا",21,"د",2,0],["مَنزِلٌ لاتَزالُ تَسري إِلَيهِ","طُرُقُ الرُغبِ قائِماتٍ مَنارُه",22,"ر",2,0],["مِن زِياداتِ النَقيصاتِ لَهُ","طَبَقٌ يَركَبُهُ بَعدَ طَبَق",23,"ق",1,0],["مَنزِلٌ لي بِالعِراقِ إِختَرتُهُ","لَم يَشُب حُرَّ يَقيني فيهِ شَكّ",24,"ك",1,0],["مَنزِلٌ هاجَ لي الصَبابَةَ وَالشَي","بُ قَريني فيها وَساءَ قَرينا",25,"ن",2,0],["مَنزِلٌ كانَ بَينَ دِجلَةَ فيهِ","لَكَ صَحنٌ تَرعى بِهِ العَينانِ",26,"ن",1,0],["منزل فيه لصياد المها","شرك يدفن في الترب وفخ",27,"خ",1,0],["مَنزِلٌ كالرَّبيعِ حَلَّتْ عليه","حالياتُ السِّحابِ عِقْدَ النِّطاقِ",28,"ق",1,0],["مَنزِلٌ في فِناء دِجلةَ يرتا","حُ إليه الخليعُ والمَستورُ",29,"ر",1,0],["مَنزِلٌ ما يَثبُتُ المَرءُ بِهِ","سالِماً إِلّا قَليلاً إِن ثَبَت",30,"ت",1,0],["مِن زَهَرٍ مُفَتِّحٍ أَو غُصنٍ","مُرَنَّحٍ أَو طائِرٍ مُغَرِّدِ",31,"د",1,0],["مُنَزَّهُ النّفسِ سمحٌ ما لَهُ أمَلٌ","إلّا مَكارِمُ يَحويها بنو الأملِ",32,"ل",1,0],["مَن زارَ في سنةِ الأَجفانِ في خَفَرٍ","لم يخش غيرانَ مرهوبَ الشذا حَنِقا",33,"ق",2,0],["مَنزِلاً موحِشاً وَإِن كانَ مَع","موراً بِحِلِّ الصَديقِ وَالأَحبابِ",34,"ب",1,0],["مَن زاحَفَ الأَيّامَ ثُمَّ عَبا لَها","غَيرَ القَناعَةِ لَم يَزَل مَفلولا",35,"ل",2,0],["مُنَزَّهَةٌ عَنِ السَرَقِ المُوَرّى","مُكَرَّمَةً عَنِ المَعنى المُعادِ",36,"د",1,0],["مَنزِلَ مَن راحَ مِنهُ مُعتَمِراً","لَيلَةَ سِتٍّ خَلَونَ مِن رَجَبِ",37,"ب",1,0],["مَنزِلاً كانَ لَنا مَرَّةً","وَطَناً نَحتَلُّهُ كُلَّ عام",38,"م",1,0],["مَنزِلٌ أَقوى بِسَلمى وَرُبوعُ","تُعذَرُ الأَنفاسُ فيهِ وَالدُموعُ",39,"ع",1,1],["مُنَزَّهٌ عَنْ شَرِيكٍ في محاسِنِهِ","فَجَوْهَرُ الحُسْنِ فيه غيرُ مُنْقَسِمِ",40,"م",1,0],["مَنْ زِيُّه أنْ لا يجيءَ مُقَنَّعاً","حتى يَقُدّ مُتَوَّجاً ومَعُصَّبا",41,"ب",2,0],["مَن زادَنا النَقدَ زِدنا في مَوَدَّتِهِ","ما يَطلُبُ الناسُ إِلّا كُلَّ رُجحانِ",42,"ن",1,1],["مَنزِلٌ دَمَّنَهُ آباؤُنا ال","مورِثونا المَجدَ في أولى اللَيالِ",43,"ل",1,0],["من زل من عجل يوماً فأحر به","بعد السَلامة أن يمشي عَلى مهل",44,"ل",1,0],["مَنْ زخْرَفَ الوادي وأجرَى به","جداولَ التبر كماءٍ معينْ",45,"ن",1,0],["منزّلا بحسب الزمان","مفصّل اللؤلؤ والجمان",46,"ن",1,0],["منزلة في غالب عليّهْ","وشيمٌ تقطر جاهليّهْ",47,"ه",1,0],["منزّل الذّكر بخير الألسن","مشتملا على البيان الأحسن",48,"ن",1,0],["مِنْ زُرْقَةِ السَّمَاءِ فِي اليَوْمٍ","البَشُوشِ المُقْبِلِ",49,"ل",1,0],["مُنَزَّهُ الشِّيمَةِ عَنْ","عَيْبٍ وَعَنْ تَبَذُّلِ",49,"ل",1,0],["مِنْ زَائِرٍ لمحَ التُّقَى مُتَجَلِّياً","كَالنُّورِ مِنْ سِتْرِ الْجَلاَلِ الْحَاجِبِ",50,"ب",1,0],["مَنْ زان صدرَ المجلس الأعلى وقد","طفح الجلال بحيثُ فاض النادي",51,"د",2,0],["مَنزِلٌ هَاجَ لِي الصّبَابَةَ،","والشَّ يْبُ قَرِيني فيهِ، فَسَاءَ قَرِينَا",52,"ن",2,0]]}