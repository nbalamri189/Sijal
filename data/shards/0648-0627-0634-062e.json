{"poems":[[54,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[136,"آمنت من الخطوب أتيت طوبى","https://www.aldiwan.net/poem54892.html","الطويل"],[303,"عذيري من حليف ذي خصال","https://www.aldiwan.net/poem36815.html","عموديه"],[500,"نذير ولكنه صامت","https://www.aldiwan.net/poem9799.html","المتقارب"],[1445,"","https://poetry.dctabudhabi.ae/diwan/poem/49983","الطويل"],[1663,"","https://poetry.dctabudhabi.ae/diwan/poem/97109","الوافر"],[2261,"","https://poetry.dctabudhabi.ae/diwan/poem/105652","الخفيف"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127400","الوافر"],[4022,"","https://poetry.dctabudhabi.ae/diwan/poem/199060","الكامل"],[4717,"مرثية الدكتور أحمد زويل","https://www.poetsgate.com/ViewPoem.aspx?id=199624",""],[4830,"مجرى دمي","https://www.poetsgate.com/ViewPoem.aspx?id=202615",""],[5138,"عايش مع الاحزان","https://www.poetsgate.com/ViewPoem.aspx?id=184843",""]],"verses":[["وَأُشخِصَ الأَميرُ نَحوَ طاهِرِ","يَسحَبُ أَذيالاً مِنَ العَساكِرِ",0,"ر",1,0],["وَاشخَبَ في حياضِ القَلبش ثَدياً","من العرفانِ مِدرَاراً شُخوبا",1,"ب",2,0],["وأشخاص الروايةِ من ذكورٍ","ونسوانٍ قرود أو سَعالُ",2,"ل",1,0],["واشخاص موت ولكنه","إلى من يودعه ثابت",3,"ت",1,0],["وأشخاصُ أرباب تزاحم ناظري","وأسرار أطراب تَلجلج في صدري",4,"ر",2,0],["وأشخصتم كرائمه اعتداء","على الأقتاب غير مساترينا",5,"ن",2,0],["واشخصي للعلى بأبناك قدماً","فالمعالي ولائد الأقدام",6,"م",1,0],["وأشخاص الرواية طالبات","وطلاب ولكن دون غايه",7,"ا",3,0],["واشخص بقلب ليس فيه غيره","تجد السعادة في الحياة مسارا",8,"ر",2,0],["وأشخاصٌ يقالُ لهم نجومٌ","هراءً .. بَلْ يُضَلُّ بهنَّ جيلُ",9,"ل",1,0],["وأشخصَتْ من حولهِ أعيُنٌ","هل ياتَرى للحشرِ قد أُحشِرَتْ",10,"ت",1,0],["واشخاص كانوا اغلا الاحباب عندي","في حبهم ماحد يسوي سواتي",11,"ت",2,0]]}