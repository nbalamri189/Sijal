{"poems":[[65,"النائبات كثيرة الإنذار","https://www.aldiwan.net/poem46177.html","الكامل"],[65,"رنا وناظره بالسحر مكتحل","https://www.aldiwan.net/poem46198.html","البسيط"],[91,"ما انت الا نادره","https://www.aldiwan.net/poem44632.html","مجزوء الرجز"],[87,"يا قوم عثمان والدنيا مداولة","https://www.aldiwan.net/poem63738.html","البسيط"],[46,"لولا أبو يعقوب في إبرامه","https://www.aldiwan.net/poem30350.html","الكامل"],[48,"علم الإمام ولا أقول بظنه","https://www.aldiwan.net/poem22103.html","الكامل"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85571","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54977","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54200","الكامل"],[101,"لا تحبيني","https://www.poetsgate.com/ViewPoem.aspx?id=196733",""],[173,"حطوا الرحال فقد أودى بها الرحل","https://www.aldiwan.net/poem1661.html",""],[173,"أنخ فهذي قباب العز والكرم","https://www.aldiwan.net/poem1676.html",""],[186,"أحبابنا هل لذاك العهد تذكار","https://www.aldiwan.net/poem67065.html","البسيط"],[228,"كان شفيق لم يزل مختلي","https://www.aldiwan.net/poem39703.html","السريع"],[310,"يهنأ بمولد طه خاتم الرسل","https://www.aldiwan.net/poem56438.html","البسيط"],[310,"در أيادي التهاني فتحت صدفه","https://www.aldiwan.net/poem56474.html","البسيط"],[358,"تعس الهلال القهوجي لأنه","https://www.aldiwan.net/poem40165.html","الكامل"],[366,"تلك الغصون امالتها الصبا هيفا","https://www.aldiwan.net/poem68086.html","البسيط"],[415,"ماذا يروعك من وجدي ومن قلقي","https://www.aldiwan.net/poem32420.html","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136274","البسيط"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132901","الكامل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111779","الكامل"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26480","البسيط"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47119","الكامل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88651","المنسرح"],[2931,"","https://poetry.dctabudhabi.ae/diwan/poem/109850","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48326","الكامل"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48316","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/92013","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91214","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91210","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91211","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91580","البسيط"],[3933,"","https://poetry.dctabudhabi.ae/diwan/poem/76504","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119665","البسيط"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90845","الكامل"],[4204,"","https://poetry.dctabudhabi.ae/diwan/poem/90835","الكامل"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81302","الكامل"],[4691,"وعودَكنَّ خيالُ !!","https://www.poetsgate.com/ViewPoem.aspx?id=75081",""],[5052,"قالوا تغزّل","https://www.poetsgate.com/ViewPoem.aspx?id=205134",""],[5057,"يا آخر الأوطان","https://www.poetsgate.com/ViewPoem.aspx?id=199288",""],[5121,"هذا الْهَوَى","https://www.poetsgate.com/ViewPoem.aspx?id=216055",""],[5411,"عَيْناكَ تَحْرُسُني","https://www.poetsgate.com/ViewPoem.aspx?id=201923",""],[5509,"هبَّة التحرير","https://www.poetsgate.com/ViewPoem.aspx?id=88155",""],[5674,"البوح فضاح","https://www.poetsgate.com/ViewPoem.aspx?id=198517",""],[5686,"لا تأسفي","https://www.poetsgate.com/ViewPoem.aspx?id=204521",""],[5690,"لحسن رأيك باتت تخضع الفكرُ","https://www.poetsgate.com/ViewPoem.aspx?id=172163",""],[5725,"هذا الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=195400",""],[5770,"ليلة العيد","https://www.poetsgate.com/ViewPoem.aspx?id=178358",""],[5829,"العاشق الجسور","https://www.poetsgate.com/ViewPoem.aspx?id=215927",""],[5956,"ضربتْ سكوني يا إلهُ شجونُها","https://www.poetsgate.com/ViewPoem.aspx?id=192384",""],[5956,"رصاص وشعر","https://www.poetsgate.com/ViewPoem.aspx?id=192450",""],[6068,"أعواذلي كفِّي اللوائم واعدلي -28-","https://www.poetsgate.com/ViewPoem.aspx?id=175792",""],[6182,"قَلْبٌ على مائَيْنِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86118&r=&rc=15",""],[6268,"فلسفتي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82929&r=&rc=15",""]],"verses":[["هذا الهِلالُ وقد رَجَوْتَ نُمُوَّهُ","للمَجْدِ عاجَلَهُ الرّدى بسِرارِ",0,"ر",1,0],["هذا الهِلالُ سَتَجلوهُ العُلا قَمَراً","تُلقي إليهِ عِنانَ الطّاعةِ المُقَلُ",1,"ل",1,0],["هذا الهتاف المستطير","كله لنادره",2,"ر",2,0],["هَذا الهِلالُ الَّذي تُحيونَ لَيلَتَهُ","أَبهى الأَهِلَّةِ عِندَ اللَهِ أَلوانا",3,"ن",2,0],["هَذا الهِلالُ يَروقُ أَبصارَ الوَرى","حُسناً وَلَيسَ كَحُسنِهِ لِتَمامِهِ",4,"م",2,0],["هَذا الهَواءُ يَلوحُ فيهِ لِناظِرٍ","صُوَرٌ وَلَكِن عَن قَريبٍ تَرسُبُ",5,"ب",1,0],["هَذا الهتاف الَّذي يعلو فتسمعه","جميعه لك فاسلم أَيُّها العلم",6,"م",1,0],["هَذا الْهِلاَلُ لَكُمْ رَأْدَ النَّهَارِ هُدى","وفِي اعْتِكَارِ الدَّيَاجِي خَيْرُ نِبْرَاسِ",7,"س",1,0],["هذا الهُمامُ وهذه أعمالُه","أرأيتَ كيفَ جلائلُ الأعمال",8,"ل",1,0],["هذا .. الهوى ما عاد يغرينيَ !","فلتستريحيِ .. ولترُيحينيِ",9,"ن",2,1],["هَذا الهُمامُ الَّذي أَقصى مَطالِبِهِ","ما لا يُحدُّ وَأَدنى هَمِّهِ زُحَلُ",10,"ل",1,0],["هَذا الهُمامُ عِمادُ الدِّينِ أَكرَمُ مَن","يُدعى وَيُرجى وَخَيرُ الناسِ كُلِّهِمُ",11,"م",1,0],["هَذا الهُمامُ الَّذي أَضحَت مَناقِبُهُ","قُدىً بِها في طِلابِ الحَمدِ يُستارُ",12,"ر",1,0],["هذا الهَوى يَمضي وَيَأتي النَدَم","وَحَدَّقَت حيناً إِلى المَغرَمِ",13,"م",1,0],["هذا الهَناءُ بشهرِ المَولدِ اِتّصلت","بهِ التهاني لكم علاً على نهلِ",14,"ل",1,0],["هَذا الهناءُ الّذي هبّت بشائرهُ","فَأصبَحت سحبُ الأوهامِ مُنكشفه",15,"ف",2,0],["هَذا الهِلال هُوَ الهَلاك وَإِنَّما","غَلطوا فَلَم يَضعوا العصا في رَاسهِ",16,"ه",1,0],["هذا الهزار بِأَعلى الغُصن مضطَرِب","كَأَنَّهُ همزَة قَد عانَقَت أَلفا",17,"ف",2,0],["هذَا الهوى لا هوَى القَيْسَينِ إنّهما","عاشَا مَلِيّاً وذَا مُوفٍ على رَمَقي",18,"ق",2,0],["هذا الهنا لا برحنا في فوايده","ومشهد الحسن في بسط واجمالي",19,"ل",2,0],["هذا الهلالُ شبيهُهُ في حُسنهِ","وبهائِه كَلاَّ وفترةِ جَفنِه",20,"ن",2,1],["هذا الهوى لا ما يقال بحقّهِ","ذاك الهوى في قول قومٍ سارا",21,"ر",2,0],["هذا الهِجاءُ الَّذي تَبقى مَياسِمُهُ","عَلى جِباهِكُمُ ما أَورَقَ الشَجَرُ",22,"ر",1,0],["هذا الهُمَامُ محمّدُ العربي الذي","جَمَعَ السّيادة طارفاً وتليدا",23,"د",2,0],["هَذا الهدى قد اتاك مبتدئا","بادمع في الخدود يهملها",24,"ل",3,0],["هذا الهدى فاتبع منار بيانه","وقل السلام على من اتبع الهدى",25,"د",2,0],["هذا الهمامُ العادلُ الأرْضى الذي","قادَ الجُيوشَ إلى العِدى فاقتادَها",26,"د",3,0],["هذا الهُدى قد لاحَ نورُ صباحِهِ","يَهْدي سبيلَ الرُشْدِ كُلَّ مُضَلّلِ",27,"ل",1,0],["هذا الهمام أَبو الإقبال سيدنا","بهِ تعالت عَلى الأَحياء أَموات",28,"ت",1,0],["هَذا الهِلال وَهَذِهِ شمس الضُحى","وَكِلاهُما أَنس زَهى وَمَسرةُ",29,"ه",1,0],["هذا الهمام الَّذي الأَيام تحمده","وَالعلم وَالحلم فيهِ بَعض شهرته",30,"ت",2,0],["هَذا الهَنا بِالَّذي تَهواه أَرّخه","محمد شارف الأَكوان طَلعته",31,"ت",2,0],["هذا الهَوى وَقَديماً كُنتُ أَحذرُه","أَنعم بمكنتمٍ منهُ وَمتّضحِ",32,"ح",1,0],["هَذا الهَناء بلا مرا","يا حبذا لَو كانَ في الانسان من يَرمي له",33,"ه",1,0],["هذا الهُدى كلُّه هذا البشير لنا","هذا النذير من العصيان في العمل",34,"ل",1,0],["هذا الهوى هو والقضاء كلاهما","من أعين الآرام سهم حمام",35,"م",1,0],["هذا الهوى يا لائمي سبحان من","أعماك عما ليس بالمحجوب",36,"ب",1,0],["هَذا الهَوى وَأَولاء نمنَ بِرَوضِهِ","أَفلا نُغَرد في ذُرى أَفنانه",37,"ن",2,0],["هذا الهوى كالطفل يقتله النوى","ويضيعه الحرمان والإهمالُ",38,"ل",1,0],["هذا الهوى قد سرى قهراً إلى خَلَدي","يا ويحَ قلبي أبعدَ الزُّهد قد رجعا",39,"ع",2,0],["هذا الهوى المغروسُ في أحشائِي","أعتى من الأوصافِ والأسماءِ",40,"ا",2,1],["هَذَا الْهَوَى سِحْرٌ نَرْتَجِي فَحْصَهْ","وَالطِّبُّ لَا يَقْوَى أَنْ يَرَى شَخْصَهْ",41,"ص",2,1],["هذا الهَوَى وَجَميعُ ماعَتَّدْتَ مِنْ","حُزَمِ النَّهار بِهِ النَّهارُ سَيَغْرَقُ",42,"ق",1,0],["هذا الهلالُ مع الصليب تعانقا","وتلاحم الجمعان ِ تحت السارية",43,"ي",2,0],["هذا الهوى غصة ٌفي الصدر توجعني","جمر من الشوق( بعض العشق ذباحُ)",44,"ح",1,0],["هذا الهوى والجمرُ في أكنافِهِ","الصبرُ أشعل َ موقِفَيْك ِ وموقِفي",45,"ف",2,0],["هذا الهمام الذي ذاعت مكارمهُ","في الخافقين كما طابت بها السيرُ",46,"ر",1,0],["هذا الهوى في كل يوم يكبر","وقلوبنا في كل حين تصغرُ",47,"ر",1,1],["هذا الهوان الذي ساقوه مهزلةٌ","وليس صنّاعُهُ في الناس شجعانا",48,"ن",2,0],["هذا الهوى قدر ولا","ينجيك أخذٌ بالمحاذر",49,"ر",1,0],["هذا الهروب هديّةٌ كبرى لها","شكراً لهم إذْ منهمو تكوينُها",50,"ن",3,0],["هذا الهجاء مضادُّ كل مدائحي","فاغضبْ وإلا فالسماح مفيدُ",51,"د",1,0],["هذا الهوى العذري يرفل شامخا","يا غزة الأبطال هاك مايلي:",52,"ل",2,0],["هذا الهواءُ جَحودٌ لا يصَدِّقُني","إنْ قُلتُ: لاحَتْ لِعَيْني فيهِما سَبَأُّ!",53,"ا",1,0],["هذا الهواءُ الذي استنشقتُه زمناً","أضحى مع اليأسِ نيراناً على رئتي",54,"ت",2,0]]}