{"poems":[[55,"أقول لها بين الغديرين والنقا","https://www.aldiwan.net/poem29961.html","الطويل"],[55,"أيا لله أي هوى أضاء","https://www.aldiwan.net/poem30781.html","الوافر"],[79,"أطاع لساني في مديحك إحساني","https://www.aldiwan.net/poem36069.html","الطويل"],[85,"سل الأفق بالزهر الكواكب حاليا","https://www.aldiwan.net/poem54224.html","الطويل"],[90,"من أين من أين يا ابتدائي","https://www.aldiwan.net/poem45073.html","مخلع البسيط"],[74,"سقاك وحياك الحيا أيها القبر","https://www.aldiwan.net/poem18739.html","الطويل"],[53,"أبا جعفر لا زلت معطى وواهبا","https://www.aldiwan.net/poem8161.html","الطويل"],[87,"أعياد عزك للدنيا مجاليها","https://www.aldiwan.net/poem7533.html","البسيط"],[45,"طوال قنا تطاعنها قصار","https://www.aldiwan.net/poem9568.html","الوافر"],[47,"تقضى الصبا إلا تلوم راحل","https://www.aldiwan.net/poem65618.html","الطويل"],[63,"ومبنية من خيزران مفضض","https://www.aldiwan.net/poem51565.html","الطويل"],[63,"أرى همة تختال بين الكواكب","https://www.aldiwan.net/poem51785.html","الطويل"],[46,"السيف أصدق أنباء من الكتب","https://www.aldiwan.net/poem30591.html","البسيط"],[71,"عجائب عامنا عظمت وجلت","https://www.aldiwan.net/poem28011.html","الوافر"],[83,"هو البين حتى لم تزدك النوى بعدا","https://www.aldiwan.net/poem61535.html","الطويل"],[54,"رعين كما شئن الربيع سوارحا","https://www.aldiwan.net/poem27302.html","الطويل"],[27,"","https://poetry.dctabudhabi.ae/diwan/poem/62231","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39661","الوافر"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54262","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54259","الطويل"],[108,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179289",""],[92,"بنت بيروت","https://www.poetsgate.com/ViewPoem.aspx?id=179192",""],[92,"ذكرى دمشق الجميلة","https://www.poetsgate.com/ViewPoem.aspx?id=179048",""],[53,"أبا جعفرٍ لا زلت مُعطى ً وواهبا","https://www.poetsgate.com/ViewPoem.aspx?id=26848",""],[119,"كر الجديدين تبدو منه الوان","https://www.aldiwan.net/poem40479.html","عموديه"],[119,"خفايا المعاني تنجلي بالدلائل","https://www.aldiwan.net/poem40849.html","عموديه"],[146,"أبينا أن نطيعكم أبينا","https://www.aldiwan.net/poem58432.html","البسيط"],[147,"قفوا في القلى حيث انتهيتم تذمما","https://www.aldiwan.net/poem11819.html","الطويل"],[164,"سماط ما أراه أم مناخ","https://www.aldiwan.net/poem58912.html","الوافر"],[190,"عظ النفس أن تصبو إلى شهواتها","https://www.aldiwan.net/poem44109.html","الطويل"],[193,"بربك ذكرهم عسى تنفع الذكرى","https://www.aldiwan.net/poem35096.html","الطويل"],[216,"ونشوانة غيداء ظامية الحشا","https://www.aldiwan.net/poem37898.html","الطويل"],[242,"أبلغهم مألكا عن قلب من ملكوا","https://www.aldiwan.net/poem18848.html","البسيط"],[371,"إليك بعد انقضاء الجد واللعب","https://www.aldiwan.net/poem17151.html","البسيط"],[409,"كسا الله وجه الأرض حلة زاهد","https://www.aldiwan.net/poem34107.html","الطويل"],[409,"أديرت على حمى بكيل وحاشد","https://www.aldiwan.net/poem34126.html","الطويل"],[412,"الآن قد صح لي حقا بلا كذب","https://www.aldiwan.net/poem50209.html","البسيط"],[435,"عج إلى منزل قصف","https://www.aldiwan.net/poem40702.html","مجزوء الرمل"],[438,"لذي الظلامة عد الظلم والشنب","https://www.aldiwan.net/poem12438.html","البسيط"],[458,"أضحي بترحالي ومثلي من ضحى","https://www.aldiwan.net/poem61252.html","الطويل"],[458,"أفى العرس تنعى يالها قسوة القدر","https://www.aldiwan.net/poem61712.html","الطويل"],[466,"لمن جيرة دون اللوى والشقائق","https://www.aldiwan.net/poem15088.html","الطويل"],[466,"عجائب أرض الله شتى كثيرة","https://www.aldiwan.net/poem16409.html","الطويل"],[473,"عجاج ضباب قد تجلله وبل","https://www.aldiwan.net/poem59731.html","الطويل"],[484,"عجائب الدهر شتى","https://www.aldiwan.net/poem36936.html","المجتث"],[505,"هو الوجد لا شيل هناك ولا حط","https://www.aldiwan.net/poem37985.html","الطويل"],[534,"أتتنا مع الركبان أخبار فاضل","https://www.aldiwan.net/poem37384.html","الطويل"],[591,"خذ من حديثي ما يغنيك عن نظري","https://www.aldiwan.net/poem17531.html","البسيط"],[606,"","https://poetry.dctabudhabi.ae/diwan/poem/83321","الطويل"],[682,"","https://poetry.dctabudhabi.ae/diwan/poem/101467","الوافر"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34426","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77589","الرجز"],[936,"","https://poetry.dctabudhabi.ae/diwan/poem/138717",""],[1134,"","https://poetry.dctabudhabi.ae/diwan/poem/25359","الرجز"],[1194,"","https://poetry.dctabudhabi.ae/diwan/poem/206180","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136135","البسيط"],[1457,"","https://poetry.dctabudhabi.ae/diwan/poem/122031","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108944","الكامل"],[1940,"","https://poetry.dctabudhabi.ae/diwan/poem/198873","الطويل"],[1953,"","https://poetry.dctabudhabi.ae/diwan/poem/123873","الرجز"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93735","البسيط"],[2705,"","https://poetry.dctabudhabi.ae/diwan/poem/128657","المتقارب"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75990","البسيط"],[2899,"","https://poetry.dctabudhabi.ae/diwan/poem/107121","الطويل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/140030","الطويل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/68025","الرجز"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48443","الطويل"],[3550,"","https://poetry.dctabudhabi.ae/diwan/poem/206272","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216430","البسيط"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131017",""],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131243",""],[3805,"","https://poetry.dctabudhabi.ae/diwan/poem/66555","الهزج"],[3837,"","https://poetry.dctabudhabi.ae/diwan/poem/114659","الوافر"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114494","الطويل"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102974","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111447","الكامل"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/70122","الوافر"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86378","الخفيف"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86356","الرمل"],[4096,"","https://poetry.dctabudhabi.ae/diwan/poem/100001","المضارع"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127072","المتقارب"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123495","الخفيف"],[4245,"","https://poetry.dctabudhabi.ae/diwan/poem/73824","البسيط"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72439","المتقارب"],[4607,"","https://poetry.dctabudhabi.ae/diwan/poem/132198","الطويل"],[4830,"دَمْعُ الصَّبابة","https://www.poetsgate.com/ViewPoem.aspx?id=202359",""],[5022,"البردة المالكية","https://www.poetsgate.com/ViewPoem.aspx?id=186512",""],[5055,"شمس إيليا","https://www.poetsgate.com/ViewPoem.aspx?id=101654",""],[5277,"الحبّ في الله","https://www.poetsgate.com/ViewPoem.aspx?id=191252",""],[5277,"عهدٌ... إلى عهدٍ التميميِّ تلكَ الَّتي كشفتْ بصفعتِها عِوارَنا...","https://www.poetsgate.com/ViewPoem.aspx?id=194810",""],[5327,"الفَلُّ المَارِد !","https://www.poetsgate.com/ViewPoem.aspx?id=140752",""],[5344,"وداع الشتاء ..","https://www.poetsgate.com/ViewPoem.aspx?id=180698",""],[5411,"ضجيج الحرف","https://www.poetsgate.com/ViewPoem.aspx?id=185306",""],[5431,"فرات الجود مقهورٌ مباحُ","https://www.poetsgate.com/ViewPoem.aspx?id=185456",""],[5512,"عجاف الدَّهر ( أنا الشَّام )","https://www.poetsgate.com/ViewPoem.aspx?id=204281",""],[5573,"عجايب هذي الدنيا متاهات وعذاب وويل","https://www.poetsgate.com/ViewPoem.aspx?id=204543",""],[5690,"غريبٌ فقده أبكى","https://www.poetsgate.com/ViewPoem.aspx?id=172278",""],[5725,"حلم","https://www.poetsgate.com/ViewPoem.aspx?id=186383",""],[5759,"قلادة الشعراء","https://www.poetsgate.com/ViewPoem.aspx?id=213395",""],[5786,"علاقةُ حبٍّ في الهَوى تتغلّبُ","https://www.poetsgate.com/ViewPoem.aspx?id=50658",""],[5786,"بريقٌ أضا بالغَضَا مُوهِن","https://www.poetsgate.com/ViewPoem.aspx?id=50653",""],[6127,"البشرى","https://www.poetsgate.com/ViewPoem.aspx?id=204472",""],[6147,"أم الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=151698",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577086",""],[6153,"غنى الذي من واهج الضيم والنوى","http://www.aldiwanalarabi.com/poemDescription.do?poemId=577085",""],[6300,"نقش قديم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82860&r=&rc=31",""]],"verses":[["عِجافاً كَأَوتارِ الحَنايا مِنَ الطَوى","عَلى مِثلِ أَعجاسِ القِسِيِّ العَطائِفِ",0,"ف",1,0],["عَجاجٌ تَرجِعُ الأَرواحُ عَنهُ","فَلا هوجاً يُجيزُ وَلا رُخاءَ",1,"ا",2,0],["عَجَائِبُ أَقْطَارٍ وَمألَفُ شَارِدٍ","وَأَفْلاَذُ آفَاقٍ وَمَوْعِدُ رُكْبَانِ",2,"ن",1,0],["عجائب لم تخطر ببالِ وإنما","ظفرنا بها عن همة هي ما هيا",3,"ي",2,0],["عجائب الكون وهي شتّى","فيك انطوت أيمّا انطواء",4,"ا",2,0],["عجائب تعيي النَّاظرين وحكمةٌ","ممنعةٌ قد زَلَّ من دونها الفكر",5,"ر",1,0],["عجائبُ هذا الدهر عندي كثيرة","فيا ابن عليٍّ لا تَزِدْني عجائبا",6,"ب",2,0],["عجائب الطب لا لقمان يعرفها","في الغابرين ولا بستور يدريها",7,"ي",3,0],["عَجاجاً تَعثُرُ العِقبانُ فيهِ","كَأَنَّ الجَوَّ وَعثٌ أَو خَبارُ",8,"ر",1,0],["عِجالاً مِنَ الدُنيا بِأَسرَعِ سَعيِنا","إِلى آجِلٍ مِنها شَبيهٍ بِعاجِلِ",9,"ل",1,0],["عجَاجَتُها دَكْناءُ في كلِّ مَجلسٍ","وياقوتُها الجَمرُ الذي يَتَضَوَّعُ",10,"ع",1,0],["عَجائبُ مُلْكٍ في فَنائلَ لم تَكُنْ","عجائبُ مُلْكٍ قبلَها بعجائب",11,"ب",1,0],["عَجائِباً زَعَموا الأَيّامَ مُجفِلَةً","عَنهُنَّ في صَفَرِ الأَصفارِ أَو رَجَبِ",12,"ب",1,0],["عجائبُ عامِنا عَظُمَتْ وجلَّتْ","أعاماً كانَ أمْ مائتينِ عاما",13,"م",2,1],["عَجائِبُ لَم تُدرَك فَعَنقاءُ مُغرِبٌ","وَإِقبالُ موسى أَو زَمانُ الصِبا رُدّا",14,"د",2,0],["عِجالاً عَلى الطاهي بِإِنضاجِ لَحمِهِ","سِراعاً بِزادِ الضَيفِ تُلهِبُ إِلهابا",15,"ب",2,0],["عَجَاجاً أَهَابَ الصَّيْفُ مِنْهُ بِوَجْهِهِ","فَشَمَّرَ جَارِيهِ عَلَيْهِ وأَسْبَلاَ",16,"ل",2,0],["عجائب لم تقَعْ إلَّا بمصر","وأحداثٌ لهن يَطيش لُبُّ",17,"ب",1,0],["عجائبُ صُنْعٍ يصغُرُ الدهرُ دونَها","وكلُّ فعالِ الخالدين عُجابُ",18,"ب",1,0],["عجائبُ أحداثٍ تليها عجائبٌ","وصَبْري على تلكَ العجائب أعْجَب",19,"ب",1,0],["عجائب الدهر لا تُحْصَى، وأعْجَبُها","أن يُخْلِيَ الغابَ للذؤبان آساد!",20,"د",1,0],["عَجّ الرصيفُ بأسرابِ المها وهَفا","قلبي بزفرةِ قَنَّصٍ ولم يسِد",21,"د",1,0],["عجافاً أُطلقت ترعى ولكن","معاهدة القويّ لها وَثاق",22,"ق",1,0],["عجائبُ هذا الدهر عندي كثيرة ٌ","فيابن عليٍّ لا تَزْدني عجائبا",23,"ب",2,0],["عجائب من خدور الغيب بارزة","تلوح يهشدها من فيه اذعان",24,"ن",1,0],["عجائب اقدار خفايا رموزها","تتيه لها الافكار من كل عاقل",25,"ل",1,0],["عجائبُ في اصلبابة لو عقلَنا","نحبُّ محاسنا فتصير حَيْنَا",26,"ن",2,0],["عَجاجٌ إِذا أَمَّ المَجَرَّةَ صاعِداً","إِلَيها رَمى عَينَ الغَزالَةِ بِالعَما",27,"م",2,0],["عجائب كل يوم منك تأتي","لأولادها بأخراها انتساخ",28,"خ",1,0],["عجائبها ما تنقضي وغمومها","وأهوالها نيطت إلى روعاتها",29,"ت",3,0],["عَجائِبهم لا تَنقضي فبحزنهِ","لهُم فَرحٌ والكسرُ كان لهم جبرا",30,"ر",2,0],["عَجائبُهم مَهما تعاظمَ شأنها","أقلُّ شؤونِ الحقِّ يَجعلها صغرى",30,"ر",2,0],["عَجَاجُ الوغى والسيف سحب وبارق","وسيل الدما والضّرب بحر وراعد",31,"د",1,0],["عُجْ آثِراً مَا بِقَبْرٍ قَدْ حَوَى رِمَماً","مُقَدَّسَاتٍ بِهَا لِلْفَضْلِ مُعْتَرَكُ",32,"ك",1,0],["عَجائِبُ الدَهرِ لا تَفنى فَلا عَجَبٌ","إِلّا لِيَومِكَ إِذ يَفنى بِلا عَجَبِ",33,"ب",1,0],["عجائب دلت أنه الواحد الذي","له وحده في الكون أعظم قدرة",34,"ه",1,0],["عجائب أبدتها المقادير بعدها","عجائب تتركها أخف العجائب",35,"ب",1,0],["عَجائِب الدَهر لا تَفنى عَجائِبُها","ما الدَهر في فِعلِهِ إِلّا أَبو العَجَبِ",36,"ب",1,0],["عج إلى منزل قصفٍ","مطلق الروض الشذيّ",37,"ي",1,1],["عجائبٌ في المعالي ما برِحْتَ لها","مُكرَّرَ الفعل حتى لم يُقَلْ عجَبُ",38,"ب",1,0],["عجائب من صنع الحضارة جاوزت","تهاويل من خالوا عجائبها مزحا",39,"ح",2,0],["عجائبُ ضاقَ العقلُ عنها ببحثه","وَزلَّ خيالُ الشعر فانبتَّ وانكسر",40,"ر",1,0],["عجال السرى لا يستقل معرَّسٌ","بهم غير أرجاء الطلاح الأيانق",41,"ق",1,0],["عجائبُ أرضِ اللّهِ شَتَّى كَثيرَةٌ","وأعْجَبُها حاوي المَناقِبِ يَزْدَنُ",42,"ن",1,1],["عَجاجُ ضَبابٍ قَد تَجَلَّلَهُ وَبلُ","إِذا سارَ لَم يَأمَن عَلى نَفسِهِ المَحلُ",43,"ل",1,1],["عجائب الدهر شتّى","لم تنحصر في حساب",44,"ب",1,1],["عَجائِبُ ألفاظٍ حَكى الشَّوقُ بَعْضُها","وحارَ بها القُرَّاءُ وانْعَجَمَ الخَطُّ",45,"ط",1,0],["عَجائِبُ أَخْبارٍ غَرائِبُ صَنْعَةٍ","مَناقِبُ جَمْعٍ في البَرِيَّةِ تُذْكَرُ",46,"ر",1,0],["عَجائبٌ ما لها حَدٌّ فَقُلْ وَأَطِلْ","إِنْ شِئْتَ أو فاقْتَصِدْ في القَوْلِ واقْتَصِرِ",47,"ر",1,0],["عَجائِبَ مَولى في مُحَمَّد عَبدُهُ","وَرَبُّكَ يُعطي ما يَشاءُ وَيَرزُقُ",48,"ق",1,0],["عجائِبُ ذاكَ كانت مخزياتٍ","وفي هدي لهُ الفخر العميمُ",49,"م",1,0],["عَجائِبُهُ ليسَت تعدّ فإِنّه","فَريدٌ أساميهِ الكِرامُ مئينُ",50,"ن",1,0],["عَجائِبٌ عَجائِبٌ عَجائِب","إِنَك وَاللَه العَظيم خائِبُ",51,"ب",1,0],["عجائب هذا الكون سبع عظيمة","تضارعها النزهات إذهنّ أربع",52,"ع",1,0],["عَجاجَةً وَهَبْوَةَ القَتامِ","عَنْ دِينِ كُلِّ لُبَدٍ جَثَّامِ",53,"م",1,0],["عجائب من خير وشر كليهما","فإن كنت سمّاعا بدا القلب واعيا",54,"ي",2,0],["عجايب الفضل تدنيهم حقايقها","فهم بوصف الغنا احيا وان ماتوا",55,"ت",3,0],["عَجَائِبُهُ فَوْقَ الْعَجَائِبِ إِنَّهَا","عَجَائِبُ لَمْ تَخْطُرْ بِبَالٍ وَلاَ فِكْرِ",56,"ر",1,0],["عجانة ضنت علَي","يَ بريقها العذب الثمين",57,"ن",1,0],["عجائبه في المعجزات عجيبة","إليه يحن الجذع والضب يخضع",58,"ع",1,0],["عجاجةً ترى لها رواهِجا","يُطير عنها الوبرَ الصهابِجا",59,"ج",2,0],["عَجاجة المحل في جَدواه يَكشفها","وَأنصل الدَهر في يمناه يلويها",60,"ي",3,0],["عجائبها ما لَهُ عَدَدٌ","وَمَن لي بإحصاءِ أصنافِها",61,"ف",3,0],["عَجائِبٌ قَد أَتَتنا مِن مَحاسنِهِ","فَكُلُّ قَلبٍ لذيّاكَ الجَمالِ صَغا",62,"غ",2,0],["عجائب مجد أعجزت من سواكم","ومن سرّها المشهور صدق المواعد",63,"د",1,0],["عجائب آيات النبي بدائعٌ","وأخباره في الخافقين شوائعُ",64,"ع",1,1],["عجائبُ الكونِ لَهَا","تجري دموعي بدمِي",65,"م",2,0],["عجائِبُ لا الأيامُ أحْدَثْنَ مثلَها","ولا الدّهْرُ عنْها في القديمِ يُحادثُ",66,"ث",1,0],["عجاج يظل الملتقى منه في دجى","وإن لمعت أسيافه طلع الفجرُ",67,"ر",1,0],["عجائب القلب ويلي من عجائبه","عزت نظائرها في العالم الفاني",68,"ن",2,0],["عجائب لم تبرح سوالب للنهى","فواعل بالألباب ما يفعل السحر",69,"ر",1,0],["عجائب ما رآها قط ذو بصر","إلا انثنى وهو مشدوهٌ بها ثمل",70,"ل",1,0],["عِجافٌ خَيلُهُ وَالوَحْ","شُ يَوْمَ نِزَالِهِ تَسْمَنْ",71,"ن",1,0],["عجائب فى زمانك شاهدات","على خرف من الفلك المحيط",72,"ط",1,1],["عجا وردا من ماءِ وجهٍ له سبى","أخا النسكِ حُسناً إن تنحَّ البراقِعُ",73,"ع",1,1],["عجائبه في السلم والحرب جمة","ولا عجيب إن أحدث العجب البحر",74,"ر",1,0],["عَجَّ العَجاجُ وكانَ أَوَّلَ طاعِنٍ","أَنطِيلُخٌ بِطَلائِعِ الطُّروادِ",75,"د",1,1],["عَجائِبُها العَديدة لرخوها","تَريهم مَن غَدا لِلّهِ عَبدا",76,"د",2,0],["عج إذا جزت أرض بدرة واقصد","شعب جصان جادها الغيث وكفا",77,"ف",2,0],["عج إذا جزت ثنيات الوداع","وتجاوزت إلى أم القرى",78,"ر",2,0],["عجائزُهُمْ يقُدْنَ","ويزْنينَ في الشبيبهْ",79,"ب",2,0],["عجائب نقش سوى انها","بأوصافها حار أهل النهى",80,"ه",2,0],["عج اذا جزت بالحمى يا حادى","ثم قف وقفة بربع سعاد",81,"د",1,1],["عُج المَطايا بِرَقمَتَينِ","وَحَيِّ باناتِ رامَتَينِ",82,"ن",1,1],["عجا للغوير وتلك الطلول","وبثا سلام مشوق عليل",83,"ل",1,1],["عجائب أشكال سما هرمس بها","مهندسة تأتي الجبال فتنهد",84,"د",1,0],["عجائبُ الشوقِ أضدادٌ بها جُمِعَتْ","نارٌ وماءٌ مِشاجٌ غيرُ مُنفصِلِ",85,"ل",1,0],["عجائب دارت الأيام دورتها","ولم تبدّل ولم تمسخ ولم ترم",86,"م",1,0],["عجائب مالها آخر طواها الدهر في ليله","طواها وانتهى حلمي أرى الماضي يداريني",87,"ن",2,0],["عجّ الحجيج فهاجوا من لواعجنا","شوقاً الى أحمدٍ لا زال يغشانا",88,"ن",2,0],["عجافٌ إذا ردُّوا...حيارى إذا صدُّوا","بخالٌ إذا مدُّوا... نكاسٌ إنِ ارْتدُّوا",89,"د",3,0],["عَجائبُ تَسمَعُهَا وتَرَى","فأبْدِ إزاها عَمَىً فى طَرَشْ",90,"ش",1,0],["عج الفضا ثم زان ثم عاود وشان","وما كنه إلا حالنا قبل مَ افقدك",91,"ك",1,0],["عَجائِب الدَّهْر قد جاءتْ \"وفي يَدها","رَحَى الحُروب\"عن الطّوفان تَنْتدبُ",92,"ب",1,0],["عجافٌ قد أتت خمسٌ نياحُ","فرات الجود مقهورٌ مباحُ",93,"ح",1,1],["عجافُ الدّهرِ قد زِدنَ اصفراري","قتلنَ ربيعَ عمري واخضراري",94,"ر",2,1],["عجايب هذي الدنيا متاهات وعذاب وويل","وامانينا مع الواقع بها تقضي معاناته",95,"ت",2,1],["عجاباً أظهر التاريخُ","غاب البدرُ بالتربِ",96,"ب",1,0],["عجاف الارض قد جمعت","ترى هل تنهض الهممُ",97,"م",1,0],["عجائبُ الدهرِ لازالتْ تُصرِّفُهُ","مِن مَبلِغِ الصَرْفِ عمَّا شاءَ عاذِلهُ",98,"ل",2,0],["عجائبُهُ شتّى وفيه جواهرٌ","بألباب أرباب الهداية تُنهبُ",99,"ب",1,0],["عجائبُه كَثرةٌ لا تُعَدُّ","فطوبى لطرف إليها رنا",100,"ن",2,0],["عجائبها على سبعٍ أُديرتْ","وطافتْ حول مصرعه مئينا",101,"ن",2,0],["عجائب هذا العصر كثْر طريفة","وأطرف ما في الخُبْر وهْم يشاغب",102,"ب",1,0],["عجاروم ريح وَصلت يا طارش النَوا","نوخ ذلولك لازم يخضبونها",103,"ن",3,0],["عجاروم حث النضو يا راكب النَضا","وَعَلى يوزغار بفرها ما عشالها",104,"ل",3,0],["عجائبٌ تنتقي الأخيَارَ ،تملؤُهم","بالزَيْفِ ترضِعُهُمْ مِنْ نهدِهَا زَللا",105,"ل",2,0]]}