{"poems":[[68,"ذا شعرك كالأرقم إما لسبا","https://www.aldiwan.net/poem39629.html","الدوبيت"],[54,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[54,"حيلة الشيب في عذاري تلوح","https://www.aldiwan.net/poem27140.html","الخفيف"],[53,"يا أيها المرء الكريم والدا","https://www.poetsgate.com/ViewPoem.aspx?id=27704",""],[267,"نح عنك الطبيب واسمع لنعتي","https://www.aldiwan.net/poem68222.html","الخفيف"],[449,"دع عنك صهباء الدساكر","https://www.aldiwan.net/poem56047.html","عموديه"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138437",""],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126677","الكامل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34430","البسيط"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38267","الرمل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136334","البسيط"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74232","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74204","الكامل"],[3395,"","https://poetry.dctabudhabi.ae/diwan/poem/67997","الرمل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129430","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94808","البسيط"],[4381,"","https://poetry.dctabudhabi.ae/diwan/poem/198214","البسيط"],[4802,"سنابل قمح","https://www.poetsgate.com/ViewPoem.aspx?id=32338",""],[4802,"تضحك","https://www.poetsgate.com/ViewPoem.aspx?id=32678",""],[4888,"الشاطئان مصر والإمارات","https://www.poetsgate.com/ViewPoem.aspx?id=207744",""],[4935,"أنوار ممدوحي سنا لها صفا","https://www.poetsgate.com/ViewPoem.aspx?id=129531",""],[4935,"حسن المطالع في صفاء براعة","https://www.poetsgate.com/ViewPoem.aspx?id=129288",""],[5057,"الخطوة الأولى","https://www.poetsgate.com/ViewPoem.aspx?id=197231",""],[5121,"يَا عِيدُ مَرحَى","https://www.poetsgate.com/ViewPoem.aspx?id=33497",""],[5186,"لم يبق لي في الساح جولة جائل","https://www.poetsgate.com/ViewPoem.aspx?id=156459",""],[5691,"الكوكب الأحمر... الوطن القادم...!","https://www.poetsgate.com/ViewPoem.aspx?id=206733",""],[6152,"الوكالة","https://www.poetsgate.com/ViewPoem.aspx?id=201644",""]],"verses":[["ذا شَعرُكَ كَالأَرقَمِ إِمّا لَسَبا","وَالعِقدُ كَالغُصنِ البانِ إِن مالَ سَبى",0,"ب",2,1],["ذا شارِبٍ وَظُفُرٍ طَويلِ","يُنَغَّصُ الزادَ عَلى الأَكيلِ",1,"ل",1,0],["ذا شَبابٌ مُلَفَّقٌ لَيسَ يَخفى","وَمَضى ذَلِكَ الشَبابُ الصَحيحُ",2,"ح",1,0],["ذا شيعة ٍ طوراً وطوراً فاردا","أُلقى لقاء الأجدلِ الصَّفاردا",3,"د",2,0],["ذا شِفَاءٌ وَدَع مَقَالَةَ هذا","نَاكَ ذا أُمَّهُ بِأَيرِ رَبَاحِ",4,"ح",1,0],["ذا شأنهم اضحى وأن","ت غدوت تسحب ذيل عائر",5,"ر",1,0],["ذا شأن قوم على ارضاء ربهمِ","نياتهم عقدوا يا حبذا النيه",6,"ي",2,0],["ذا شبلهُ المحبوب جعفرٌ الّذي","ضَرَبَت عليه المكرُمات خباءها",7,"ا",3,0],["ذا شِبهُ فخر غِفارٍ لَهجَةً صدقَت","وَذا جُهَينَةُ إِن تسأل عَن الخبرِ",8,"ر",1,0],["ذا شَهيدٌ لِثَراهُ","وابلُ الرّضوان يَسقي",9,"ق",2,1],["ذا شاهدي قد بدا من غايبي وكفى","فهمي ظهور الهدى في ضمن عرفان",10,"ن",1,0],["ذَا شَأنُهُ سُبحَانَهُ وَبِحَمدِهِ","حَتَّى يَكُونَ الفَجرُ فَجراً ثَانِ",11,"ن",1,0],["ذا شَأن آل مُحمد وَبَني الرِضا","بَحر النَوال وَكَعبة القصاد",12,"د",1,0],["ذا شيمة الأَيام كَم أَولت فَتى","مَنحاً وَتمنحه بِسَلب عَطاء",13,"ا",2,0],["ذا شَرابٌ من لُجينٍ","فاق شهداً ورُضابا",14,"ب",2,0],["ذا شئت أن أعصي هواي يردني","شفيع وداد لا تخيب وسائله",15,"ل",2,0],["ذا شربها من سواد الحبر ترغبهُ","لا من قراحٍ أتى بالصفو موصوفا",16,"ف",2,0],["ذا شعْبُكمْ نالَ فَوْقَ الأُفْقِ مَنزلَةً","مُستقْبِلاً وجههُ أنوارَ ناديكَا",17,"ك",2,0],["ذا شعري اللي تشوفونه وذا دمي","من منهم اللي يشرب نكهة الثاني؟",18,"ن",2,0],["ذا شي غير الناس ياهل الهوى غير","حسن الوحدة لوتعرت سترها",19,"ر",3,0],["ذا شاطئٌ في بلادِ النِّيلِ أترُكُهُ","لِشاطئٍ ما لهُ في الشّرْقِ أقرانُ",20,"ن",1,0],["ذا شبل صالح من سمت آدابه","وغدا بعزتها الامام المقتفى",21,"ف",2,0],["ذا شاهد وشهيد مشود بشي","ر مبشر ونذير منذر بالتي",22,"ي",1,0],["ذَا شهرُ خيرٍ فاغتنِمهُ مُعوِّضاً","ما فاتَ مِن زللٍ ومِن تقصيرِ",23,"ر",1,0],["ذَا شَيْخُنَا فِي لَوْعَةٍ","يَحْدُو ضَرِيحَ الإِبْنِ أَنَّا",24,"ن",2,0],["ذا شاغلي وثقافة الأرواح وال","أبدان في الشبان أفضل شاغل",25,"ل",1,0],["ذا شريدٌ من الزلازل ِوالحربِ","وهذا خلّى الديارَ اقْتِلاعا",26,"ع",2,0],["ذا شِئت الغنيمةَ والكرامة","فلا تمنح لمجهولٍ وكالةْ",27,"ل",2,1]]}