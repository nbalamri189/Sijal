6056,"الفكة غنيمة","https://www.poetsgate.com/ViewPoem.aspx?id=130526",""],[6068,"فِي الْحَيِّ أَلْمَى شَادِنٌ -10-","https://www.poetsgate.com/ViewPoem.aspx?id=175790",""],[6068,"سؤال وجواب (التأخر)-08-","https://www.poetsgate.com/ViewPoem.aspx?id=177482",""],[6082,"لا تحزني","https://www.poetsgate.com/ViewPoem.aspx?id=60188",""],[6093,"(دوبيت) في الحج لنا كأمة مؤتمرُ","https://www.poetsgate.com/ViewPoem.aspx?id=181806",""],[6102,"مفعول عكسي !!","https://www.poetsgate.com/ViewPoem.aspx?id=185062",""],[6144,"باريس","https://www.poetsgate.com/ViewPoem.aspx?id=13694",""],[5309,"زار الهوى زهر الربى الأغيدا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573748",""],[2588,"قد كنت في عين الزمان صغيرة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83218&r=&rc=166",""],[6317,"دموع التاريخ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86079&r=&rc=4",""],[5190,"عاشق الكنانة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=85059&r=&rc=134",""]],"verses":[["فِي الحَرْبِ أَوْ فِي السِّلْمِ لا تُقْضَى المُنَى","إِلاَّ وَسَاعَاتُ الكِفَاحِ ثَوَانِ",0,"ن",1,0],["فِي الحَاضِرِ اسْتسْلَفْتُ مَا","سَيَقُولُهُ التَّالُونَ عَنِّي",1,"ن",2,0],["فِي الحِلِّ وَالتَّرْحَالِ يَنْضَحُ عَنْهُمُ","بِوُضُوحِ بُرْهَانٍ وَسِحْرِ بَيَانِ",2,"ن",1,0],["في الحرب طاب لكم جلاد فلْتَطِب","في السلم أعمال لكم ومقاصد",3,"د",1,0],["في آلِ حَربٍ وَفي الأَعياصِ مَنبِتُهُ","هُم وَرَّثوكَ بِناءً عالِيَ السورِ",4,"ر",1,0],["في الحمدِ والأجرِ ذو فكرٍ وذو نظرٍ","إلى صميمِ العلى والفضل ولاَّج",5,"ج",1,0],["فيا لحظه الماضي وأحمر خدّه","رفيقك قيسيّ وأنت يماني",6,"ي",1,0],["في الحيِّ صبٌّ يُعاني","في الصَّدْرِ داءً دَفينا",7,"ن",2,0],["في الحَقِّ سُلَّ وَفيهِ أُغمِدَ سَيفُهُم","سَيفُ الكَريمِ مِنَ الجَهالَةِ يَفرَقُ",8,"ق",1,0],["في الحل والعقد حار الناس كلهم","ومنهما النشء دورا دائما أبدا",9,"د",2,1],["في الحل والعقد سر لا يباح به","وفيك بكتوم هذا السر مشروحُ",10,"ح",1,1],["في الحَربِ لُبسُهُمُ الحَديدُ مُضاعَفاً","وَالسِلمُ لُبسُهُمُ جَميلُ لِباسِ",11,"س",1,0],["في الحَجِّ إِن حَجَّت وَماذا مِنىً","وَأَهلُهُ إِن هِيَ لَم تَحجِجِ",12,"ج",1,0],["في الحُزنِ إِن نابَ الفَتى حُزنُهُ","وَصاحِبُ المَرءِ بِهِ مُقتَدِ",13,"د",1,0],["في الحُبِّ رَوعاتٌ وَتَعذيبُ","وَفيهِ يا قَومُ الأَعاجيبُ",14,"ب",1,1],["في الحَسَنِ الهَدّاءِ وَالتَخيِيرِ","رَيبِ شَهاداتٍ لِدَعوى زورِ",15,"ر",1,0],["في الحُجبِ شَيئاً فَشَيئاً","يَحورُ دونَ العُيونِ",16,"ن",1,0],["في الحَيِّ مِن سَرَواتِ الحَيِّ جارِيَةٌ","رَيّا التَرائِبِ في طَوقٍ وَأَسوارِ",17,"ر",1,0],["في الحَيِّ لي دَردَقٌ شُعثٌ شَقيتُ بِهِم","لا يَكسِبونَ وَما عِندي لَهُم نَشَبُ",18,"ب",1,0],["في الحَربِ عَقلُ رِجالٍ إِن هُم قُتِلوا","وَفي الحِجا عَقلُ نِسوانٍ لَها مَسَكُ",19,"ك",1,0],["في الحَولِ عيدانِ ما فازا بِما رُزِقا","فَيُظهِرا البِشرَ لَمّا قيلَ عيدانِ",20,"ن",1,0],["في الحرب لا تلقى من ال","فئتين من لا يخسر",21,"ر",1,0],["في الحي لا يجري سوى","ما أَنتَ فاعله حديث",22,"ث",1,0],["فِي الحَرْبِ مَوْعِظَةٌ كُبْرَى أَمَا شَهِدُوا","أَيُّ الأَعَاصِيرِ بِالعُمْرَانِ قَدْ عَصَفَا",23,"ف",2,0],["فِي الحَيِّ أَعْرَابِيَّةٌ هَدَرَتْ دَماً","لَوْلاَ الْهَوَى مَا كَانَ بِالْمَهْدُورِ",24,"ر",1,0],["فِي الْحَدِيثِ المَعْزوِّ لاِبْنِ هِشَامٍ","لِمْ يُفَنِّدْ فِي الْقَوْمِ غَيْرَ المفَنُدْ",25,"د",1,0],["فِي الحَيَاةِ الدُّنْيَا إِلى المَجْدِ رَاقٍ","وَإِلى اللهِ فِي المَنيَّةِ رَاقِ",26,"ق",1,0],["فِي الحِسِّ وَالمَعْنَى عَلَى قَدْرِ المُنى","كَمُلَتْ صِفَاتُكَ فَهْيَ عِقْدُ بَدَائِعِ",27,"ع",1,0],["فِي الْحَقِّ أَنَّكَ نِمْتَ نَوْماً هَادِئاً","سَيَطُولُ أَمْ هَذَا غِرَارُ مُسَهَّدِ",28,"د",1,0],["فيالَحروبٍ لا يجف لها دمٌ","ويالشعوب كلما نهضت تكبو",29,"ب",2,0],["فيالحياة قضت نخبها","وكل حياة أمرئ نافده",30,"د",2,0],["في الحَرْبِ بِوقاتٍ لَهُ وَطُبُولا","جادتهمُ مطرَ الرَّدَى سِجِّيلا",31,"ل",2,0],["في الحالتين معا وقد كلفته","أن لا يمزق كتبهم فتكلّفا",32,"ف",2,0],["في الحرب والسلم يلقي منه إن سئلوا","بحرا وان حركوه للقا جبلا",33,"ل",2,0],["في آلِ حَجّافٍ وَآلِ شَبانَةٍ","مِثلَ الأُسُودِ بحافَتَي خَفّانِ",34,"ن",1,0],["في الحبِّ سحر للعقول لأنه","يغشى النفوسَ بدائها ودوائها",35,"ا",3,0],["في الحب مما أريد","ماذا تريد ماذا تريد",36,"د",1,0],["في الحُبِّ آيَه","نَمَّت عَلَينا",37,"ن",2,0],["في الحَقلِ وَاليَوم الشتاء","أَتُراكَ لا تَستأسرُ",38,"ر",1,0],["في الحيِّ قَلبانِ باتا يا نَعيمَهما","وَفيهما إذ قَضَيتَ النارُ تَستَعِرُ",39,"ر",1,0],["في الحالِ إِلى حاجِبِهِ وَقَعَ لي","هَذا الشاكي يَزادُ في الجَورِ عَلَيهِ",40,"ه",1,0],["في الحالَتَينِ أَراكَ إِلّا أَنَّني","في اليَوم أَنسى أَنَّ شَخصَكَ غائِب",41,"ب",1,0],["في الحب لذَّ لكِ السكوتُ ولذّتي","كانت بلاغتَهُ وكان بيانا",42,"ن",2,0],["في الحَربِ سِهامُ لَواحِظِهِ","يَهجُمنَ عَلى قَلبِ البَطَلِ",43,"ل",1,0],["في الحَدِّ للزياره","وَالمدَّةِ المُختارَه",44,"ه",1,0],["في الحَزم وَالعَزم مِن رَأيٍ وَمِن هِمَمٍ","لَهُ مَع الحلم تَشديد وَتَسديدُ",45,"د",1,0],["في الحالِ أَغدو إذا استقبلتُ طلعتَه","لِما مضَى من ذُنوب الدّهرِ مُغْتَفِرا",46,"ر",2,0],["في الحال والمآل والدين المصان","وأهلنا والقرابه والبنين",47,"ن",1,0],["في الحيِّ بعد الظاعنين لما به","مَيْتٌ بكته لرحمة أحياؤه",48,"ا",3,0],["في الحِلْمِ فاقَ أحنفا","وفي الجمالِ يوسُفا",49,"ف",2,0],["في الحُسنِ أغربَ والإمامُ الحافظ بْ","نُ محمد في كلِّ فن أغربا",50,"ب",2,0],["في الحرب أن سفروا يقول جمالهم","بالنَّقعِ يا شمس النهار تقنعي",51,"ع",2,0],["في الحَشرِ عِلقٌ يَدُهُ مِنجَلٌ","يَحصُدُ ما يَنبُتُ في الخَدِّ",52,"د",1,1],["في الحربِ والسلمِ مِنْ كَرًّ ومِنْ كَرَمٍ","لم يَبْرَحوا بينَ ضرّارٍ ونفّاعِ",53,"ع",1,0],["في الحب كل العذاب","والحسن فيه كباب",54,"ب",1,0],["في الحلم ما ينهى ذوي الارحام","عما يخالف عادل الاحكام",55,"م",1,1],["في الحالَتَيْنِ إِمامي","ما بين وهبٍ وسلبِ",56,"ب",1,0],["في الحلق والتقصير في التقصير","فقل لأيامي قعي وطيري",57,"ر",2,0],["في الحِين عنه أخبَرا","بالصِّدقِ أو بالكَذبِ",58,"ب",1,0],["في الحَشا منه ندوبٌ","وزفيرٌ واِلتهابُ",59,"ب",1,0],["في الحَيّ حيّ سِوى لَيْلي فتَسألهْ","عنها سؤالك وهم جر للعَدم",60,"م",1,0],["في الحالة الوُسْطى فلا","ظهراً رَجَعْتُ ولسْتُ صَدْرا",61,"ر",2,0],["فيَا لحدَها يا ليت أَنِّي سَكنْتُه","وأَكْفانَها يا ليْتَ أَنِّي لبسْتُها",62,"ت",3,0],["في الحسْنَ والطِّيب أَخبارٌ لسيرته","تُعْزَى بعدْنٍ ولا تُعزَى إِلى عَدَن",63,"ن",1,0],["في