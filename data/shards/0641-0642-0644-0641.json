{"poems":[[79,"أأبصرت مني في المصانع قبة","https://www.aldiwan.net/poem36774.html","الطويل"],[74,"إليك أخا العلياء دعوة لائذ","https://www.aldiwan.net/poem18615.html","الطويل"],[74,"له كل يوم فيك واش وعاذل","https://www.aldiwan.net/poem19479.html","الطويل"],[53,"لعمرك ما ضيف ابن موسى بصائم","https://www.aldiwan.net/poem66067.html","الطويل"],[45,"عذيري من عذارى من أمور","https://www.aldiwan.net/poem9584.html","الوافر"],[82,"بلى جر أذيال الصبا وتصابى","https://www.aldiwan.net/poem31543.html","الطويل"],[76,"أرقت وقد نام الخلي لنازح","https://www.aldiwan.net/poem12977.html","الطويل"],[54,"شجاك الحي إذ بانوا","https://www.aldiwan.net/poem26661.html","الهزج"],[52,"شهدت على الزيدي أن نساءه","https://www.aldiwan.net/poem62384.html","السريع"],[52,"نبا بك خلف الظاعنين وساد","https://www.aldiwan.net/poem63876.html","الطويل"],[52,"خليلي قوما فاعذرا أو تعتبا","https://www.aldiwan.net/poem64836.html","الطويل"],[52,"أعاذل إن لومك في تباب","https://www.aldiwan.net/poem64852.html","الوافر"],[45,"","https://poetry.dctabudhabi.ae/diwan/poem/140894",""],[79,"أأبْصرتَ مني في المصانع قُبَّة ً","https://www.poetsgate.com/ViewPoem.aspx?id=33305",""],[52,"أعَاذِلَ إِن لوْمَكِ في تبَابِ","https://www.poetsgate.com/ViewPoem.aspx?id=17112",""],[276,"لك الحمد حمدا نستلذ به ذكرا","https://www.aldiwan.net/poem52136.html","الطويل"],[276,"تجلت لوحدانية الحق أنوار","https://www.aldiwan.net/poem52137.html","الطويل"],[290,"بقصر مليكة العليا أقمنا","https://www.aldiwan.net/poem39355.html","الوافر"],[310,"لك الحمد يا من خص أهل الطريقة","https://www.aldiwan.net/poem56591.html","الطويل"],[353,"بنيتم على تقوى من الله مسجدا","https://www.aldiwan.net/poem20053.html","الطويل"],[385,"أبرق سرى وهنا فهيج أشجاني","https://www.aldiwan.net/poem48778.html","الطويل"],[469,"تلقاك يا سعد بالنجح سعد","https://www.aldiwan.net/poem3152.html","عموديه"],[469,"قفي فاسمعي محض النُّهى يا ابنة الفهم","https://www.aldiwan.net/poem3280.html","عموديه"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122803","الوافر"],[808,"","https://poetry.dctabudhabi.ae/diwan/poem/137689",""],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64226","الهزج"],[1335,"","https://poetry.dctabudhabi.ae/diwan/poem/198680","الطويل"],[1408,"","https://poetry.dctabudhabi.ae/diwan/poem/132826","الوافر"],[1409,"","https://poetry.dctabudhabi.ae/diwan/poem/130253","الطويل"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44823","الطويل"],[1523,"","https://poetry.dctabudhabi.ae/diwan/poem/128697","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53127","المتقارب"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104956","الطويل"],[2379,"","https://poetry.dctabudhabi.ae/diwan/poem/67208","الطويل"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100370","الوافر"],[2883,"","https://poetry.dctabudhabi.ae/diwan/poem/100428","الوافر"],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87609","الطويل"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139975","المتقارب"],[3431,"","https://poetry.dctabudhabi.ae/diwan/poem/46890","الطويل"],[3443,"","https://poetry.dctabudhabi.ae/diwan/poem/143480","الوافر"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66330","الطويل"],[3977,"","https://poetry.dctabudhabi.ae/diwan/poem/99166","الوافر"],[4541,"","https://poetry.dctabudhabi.ae/diwan/poem/76705","الطويل"]],"verses":[["فَقُلْ فِي إِنِّي لِلْمُؤَمِّلِ كَعْبَةٌ","وَإِنْ كُنْتُ قَدْ أَبْرِزْتُ فِي زِيِّ كَاعِبِ",0,"ب",1,0],["فقل في نباتٍ أصله وفروعه","مواثل ترجو من سحائبك الندى",1,"د",2,0],["فقل فيه ما شئتَ المقال مهنئاً","فإنك في ظلِّ السيادة قايل",2,"ل",1,0],["فقل في ربيع في ربيع أراكه","ربيعٌ يرى حمدَ الرجال مغانما",3,"م",2,0],["فَقُل في حاجَةٍ لَم أَقضِ مِنها","عَلى شَغَفي بِها شَروى نَقيرِ",4,"ر",1,0],["فقلْ في ظلامٍ طالَ ثم بدا له","فقد أبْصَرَت منهُ العيونُ عُجابا",5,"ب",2,0],["فَقُل في أَتِيٍّ قَد تَهادى كَأَنَّهُ","إِذا ماثَنى أَعطافَهُ حَيَّةٌ تَسعى",6,"ع",2,0],["فَقُل في مَكرَعٍ عَذبٍ","وَقَد وافاهُ عَطشانُ",7,"ن",1,0],["فَقُل في بَني زَيدٍ كَما قالَ مُعرِبٌ","قَواريرُ حَجّامٍ غَداً تَتَكَسَّرُ",8,"ر",1,0],["فَقُل في صَديقٍ يَحسَبُ الغِيَّ رَشدَةً","وَفي بَعضَ حَوزاتِ الخَليلِ رَشادُ",9,"د",1,0],["فَقُل في فَتىً سُدَّت عَلَيهِ سَبيلُهُ","فَضاعَ وَقَد كانَ الطَلوبَ المُطَلَّبا",10,"ب",2,0],["فَقُل في حاسِرٍ ذَمّاً وَحَمداً","وَلا تَغرُركَ عَينٌ في النِقابِ",11,"ب",1,0],["فقل في حاجةٍ لم أقض منها","على تعبي بها شروى نقير",12,"ر",1,0],["فقُلْ فيّى إني للمأمَّلِ كعْبة ً","وإن كنتُ قد أبْرزْتُ في زيِّى كاعب",13,"ب",1,0],["فقل في حسرٍ ذمًّا وحمداً","ولا تغررك عينٌ في النِّقاب",14,"ب",1,0],["فقل فزت يا عبدالرَحيم برحمتي","وَمَغفرتي لا تَخش بؤسا وَلا ضرا",15,"ر",2,0],["فَقل فزت يا عبدالرَحيم بِرَحمَتي","وَطبت وَلا خزى لديك وَلا عار",16,"ر",1,0],["فقل في جوده بحر عميق","وكررها جهاراً لا تبال",17,"ل",1,0],["فَقُل فيه كلّ العالمينَ بواحدٍ","وَقُل طيّب الأصلين روحٍ وجثّةِ",18,"ه",1,0],["فَقُلْ في طِرازٍ مُعْلَمٍ فَوقَ بِرْكَةٍ","علَى حُسْنهِ الزَّاهِي لها البَحرُ حَاسِدُ",19,"د",1,0],["فَقُل في حَبيب زارَ مِن غَير مَوعد","وَصَب قَرير العَين بِالوَصل جَذلان",20,"ن",1,0],["فقل في ذوابلهم وهي سمرٌ","وقبِ صواهلهم وهي جردُ",21,"د",1,0],["فقل في يدٍ علوية شرفيةٍ","بها تم عقدُ الجود والفضل وانتظم",22,"م",1,0],["فَقُل في مُشتَرٍ سَهَراً بِنَومِ","وَفي بَيعِ الكَرامَةِ بِالهَوانِ",23,"ن",1,0],["فقل فاجع الناس ناس ولا","تول الملامة حكم القضا",24,"ض",2,0],["فقلْ في وَقْعَةٍ تُرْبي","على وَقْعَةِ صفين",25,"ن",1,0],["فقل في شج قد بات يمسح دمعه","بكف وأخرى تحتها كبد حرى",26,"ر",2,0],["فقُل في حالِ مأسورٍ ضعيفِ","يلوذُ من الأَعَادِ بالأَعَادي",27,"د",2,0],["فَقُلْ في غدٍ إمّا تعجَّلْتَ قِيلَهُ","لِعَاتٍ عُتَاهِيّ إذا عَضّ أوجعَا",28,"ع",2,0],["فَقُل فِي خَلِيجٍ يُلبِسُ الحُوتَ دِرعَهُ","وَلَكِنَّهُ لا يَستَطِيعُ بِهَا نَصرَا",29,"ر",2,0],["فقل في رضاع للوصال محلل","ولكن له في القلب أية حرخمة",30,"ه",1,0],["فقل في أَبيٍّ أبى أن تلوح وج","وه مكارمه غير غرِّ",31,"ر",1,0],["فقل فيه ما قد قلت فيهم فكلهم","على ما أراد الله أهواؤهم قصر",32,"ر",1,0],["فقل فرقدا مجد عليٌ وصنوه","محمدٌ الممدوح في أشرف الكُتب",33,"ب",1,0],["فقل في عاطش ارجاس حرب","صوادر منه بالاسل النهال",34,"ل",1,0],["فقل فيه رضيع لبان عز","بثدي الفضل مرتضعا بفيه",35,"ي",2,0],["فقل فوق رمسٍ بات ارختُ تحتهُ","لَئن تَكُ طفلاً فالأَسى ليسَ بالطفلِ",36,"ل",1,0],["فقل فيهم يوم بدر وقد","جزاهم بضرب الطلى والقُلل",37,"ل",1,0],["فَقُلْ في الرّبيعِ النَّضْر بِشْراً ومَبْسَماً","وقُلْ في الصَّباحِ الطَّلْقِ نَشْراً ومَيْسَما",38,"م",2,0],["فقل في النصل وافقه نصاب","وقل في الأفق اشرق فيه بدره",39,"ر",2,0],["فقل فيه يا رب الفخار مؤرخاً","به السعد مقرون لديَّ بطلعته",40,"ه",1,0],["فقل في نشوة من نفح ريح","سقيت بها الشمول من الشمال",41,"ل",1,0],["فقل في أياديه رياضته الذرى","وقل في معاليه مصافحة المجد",42,"د",1,0]]}