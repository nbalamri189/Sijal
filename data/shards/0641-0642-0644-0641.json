{"poems":[[77,"أأبصرت مني في المصانع قبة","https://www.aldiwan.net/poem36774.html","الطويل"],[72,"إليك أخا العلياء دعوة لائذ","https://www.aldiwan.net/poem18615.html","الطويل"],[72,"له كل يوم فيك واش وعاذل","https://www.aldiwan.net/poem19479.html","الطويل"],[51,"لعمرك ما ضيف ابن موسى بصائم","https://www.aldiwan.net/poem66067.html","الطويل"],[43,"عذيري من عذارى من أمور","https://www.aldiwan.net/poem9584.html","الوافر"],[80,"بلى جر أذيال الصبا وتصابى","https://www.aldiwan.net/poem31543.html","الطويل"],[74,"أرقت وقد نام الخلي لنازح","https://www.aldiwan.net/poem12977.html","الطويل"],[52,"شجاك الحي إذ بانوا","https://www.aldiwan.net/poem26661.html","الهزج"],[50,"شهدت على الزيدي أن نساءه","https://www.aldiwan.net/poem62384.html","السريع"],[50,"نبا بك خلف الظاعنين وساد","https://www.aldiwan.net/poem63876.html","الطويل"],[50,"خليلي قوما فاعذرا أو تعتبا","https://www.aldiwan.net/poem64836.html","الطويل"],[50,"أعاذل إن لومك في تباب","https://www.aldiwan.net/poem64852.html","الوافر"],[43,"","https://poetry.dctabudhabi.ae/diwan/poem/140894",""],[77,"أأبْصرتَ مني في المصانع قُبَّة ً","https://www.poetsgate.com/ViewPoem.aspx?id=33305",""],[50,"أعَاذِلَ إِن لوْمَكِ في تبَابِ","https://www.poetsgate.com/ViewPoem.aspx?id=17112",""],[272,"لك الحمد حمدا نستلذ به ذكرا","https://www.aldiwan.net/poem52136.html","الطويل"],[272,"تجلت لوحدانية الحق أنوار","https://www.aldiwan.net/poem52137.html","الطويل"],[286,"بقصر مليكة العليا أقمنا","https://www.aldiwan.net/poem39355.html","الوافر"],[306,"لك الحمد يا من خص أهل الطريقة","https://www.aldiwan.net/poem56591.html","الطويل"],[349,"بنيتم على تقوى من الله مسجدا","https://www.aldiwan.net/poem20053.html","الطويل"],[381,"أبرق سرى وهنا فهيج أشجاني","https://www.aldiwan.net/poem48778.html","الطويل"],[465,"تلقاك يا سعد بالنجح سعد","https://www.aldiwan.net/poem3152.html","عموديه"],[465,"قفي فاسمعي محض النُّهى يا ابنة الفهم","https://www.aldiwan.net/poem3280.html","عموديه"]],"verses":[["فَقُلْ فِي إِنِّي لِلْمُؤَمِّلِ كَعْبَةٌ","وَإِنْ كُنْتُ قَدْ أَبْرِزْتُ فِي زِيِّ كَاعِبِ",0,"ب",1,0],["فقل في نباتٍ أصله وفروعه","مواثل ترجو من سحائبك الندى",1,"د",2,0],["فقل فيه ما شئتَ المقال مهنئاً","فإنك في ظلِّ السيادة قايل",2,"ل",1,0],["فقل في ربيع في ربيع أراكه","ربيعٌ يرى حمدَ الرجال مغانما",3,"م",2,0],["فَقُل في حاجَةٍ لَم أَقضِ مِنها","عَلى شَغَفي بِها شَروى نَقيرِ",4,"ر",1,0],["فقلْ في ظلامٍ طالَ ثم بدا له","فقد أبْصَرَت منهُ العيونُ عُجابا",5,"ب",2,0],["فَقُل في أَتِيٍّ قَد تَهادى كَأَنَّهُ","إِذا ماثَنى أَعطافَهُ حَيَّةٌ تَسعى",6,"ع",2,0],["فَقُل في مَكرَعٍ عَذبٍ","وَقَد وافاهُ عَطشانُ",7,"ن",1,0],["فَقُل في بَني زَيدٍ كَما قالَ مُعرِبٌ","قَواريرُ حَجّامٍ غَداً تَتَكَسَّرُ",8,"ر",1,0],["فَقُل في صَديقٍ يَحسَبُ الغِيَّ رَشدَةً","وَفي بَعضَ حَوزاتِ الخَليلِ رَشادُ",9,"د",1,0],["فَقُل في فَتىً سُدَّت عَلَيهِ سَبيلُهُ","فَضاعَ وَقَد كانَ الطَلوبَ المُطَلَّبا",10,"ب",2,0],["فَقُل في حاسِرٍ ذَمّاً وَحَمداً","وَلا تَغرُركَ عَينٌ في النِقابِ",11,"ب",1,0],["فقل في حاجةٍ لم أقض منها","على تعبي بها شروى نقير",12,"ر",1,0],["فقُلْ فيّى إني للمأمَّلِ كعْبة ً","وإن كنتُ قد أبْرزْتُ في زيِّى كاعب",13,"ب",1,0],["فقل في حسرٍ ذمًّا وحمداً","ولا تغررك عينٌ في النِّقاب",14,"ب",1,0],["فقل فزت يا عبدالرَحيم برحمتي","وَمَغفرتي لا تَخش بؤسا وَلا ضرا",15,"ر",2,0],["فَقل فزت يا عبدالرَحيم بِرَحمَتي","وَطبت وَلا خزى لديك وَلا عار",16,"ر",1,0],["فقل في جوده بحر عميق","وكررها جهاراً لا تبال",17,"ل",1,0],["فَقُل فيه كلّ العالمينَ بواحدٍ","وَقُل طيّب الأصلين روحٍ وجثّةِ",18,"ه",1,0],["فَقُلْ في طِرازٍ مُعْلَمٍ فَوقَ بِرْكَةٍ","علَى حُسْنهِ الزَّاهِي لها البَحرُ حَاسِدُ",19,"د",1,0],["فَقُل في حَبيب زارَ مِن غَير مَوعد","وَصَب قَرير العَين بِالوَصل جَذلان",20,"ن",1,0],["فقل في ذوابلهم وهي سمرٌ","وقبِ صواهلهم وهي جردُ",21,"د",1,0],["فقل في يدٍ علوية شرفيةٍ","بها تم عقدُ الجود والفضل وانتظم",22,"م",1,0]]}