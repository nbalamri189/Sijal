{"poems":[[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43639","الطويل"],[159,"رأى ذلي فأعرض واستطالا","https://www.aldiwan.net/poem55569.html","الوافر"],[310,"بمثلك هز الملك أعطافه عجبا","https://www.aldiwan.net/poem56611.html","الطويل"],[374,"العبد يهدي إلى المولى ويتحفه","https://www.aldiwan.net/poem4318.html","البسيط"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109945","الطويل"],[592,"ألا بلغا عني حنانيكما أمرأ","https://www.poetsgate.com/ViewPoem.aspx?id=128803",""]],"verses":[["رَأى ذلَّتي في العِشقِ فَاِعتَزّ وَاِعتَدى","عَلى مُهجَةٍ فيها لَهُ النَهيُ وَالأَمرُ",0,"ر",1,0],["رأى ذُلِّي فَأَعْرَضَ وَاسْتَطالا","وَآلى لا يُكَلِّمُني دَلالا",1,"ل",2,1],["رأى ذكرك الأجدى فخاراً وقربةً","فرقّ له شوقاً وطال به عجبا",2,"ب",2,0],["رأى ذراك وتحديد المقام به","لآجل العمر أسنى ما تعجَّله",3,"ل",2,0],["رأَى ذلكَ التعذيبَ عَذباً ولم يكن","لِيَأنَفَ ممَّا نالَ من قَسوةِ العِدَى",4,"د",2,0],["رأى ذاك مشهوراً وليس بمنكر","لديكم وتدري ذلك القيل والعمل",5,"ل",1,0]]}