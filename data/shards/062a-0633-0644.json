oetsgate.com/ViewPoem.aspx?id=159789",""],[5652,"انا غازي غزيتك ؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=176983",""],[5660,"ألا فَابْكِ يا عَيْنايَّ ما سَحَّ دَمْعُكِ","https://www.poetsgate.com/ViewPoem.aspx?id=23707",""],[5691,"خُلقْنا أُناساً...!","https://www.poetsgate.com/ViewPoem.aspx?id=207459",""],[5784,"ارتجال سريع","https://www.poetsgate.com/ViewPoem.aspx?id=190800",""],[5845,"كلامٌ بلا نحوٍ طعامٌ بلا ملحِ","https://www.poetsgate.com/ViewPoem.aspx?id=198485",""],[5851,"قصيدة طيف له ألف طيف","https://www.poetsgate.com/ViewPoem.aspx?id=175290",""],[5937,"خَلْفَ اللثام","https://www.poetsgate.com/ViewPoem.aspx?id=211889",""],[5956,"لقد فقدَتْني","https://www.poetsgate.com/ViewPoem.aspx?id=182494",""],[5956,"تسللَ حُسْنُ الحقول إليّا","https://www.poetsgate.com/ViewPoem.aspx?id=193853",""],[5956,"دعوتُ للإنسانية","https://www.poetsgate.com/ViewPoem.aspx?id=194884",""],[5970,"سلوا البؤس عن إخوانه وصحابه","https://www.poetsgate.com/ViewPoem.aspx?id=130671",""],[6031,"مررت بكربلاء فهاج وجدي","https://www.poetsgate.com/ViewPoem.aspx?id=46419",""],[6068,"ويَوْم لَا كَيَوْم أَحُلّ بُوحَي -08-","https://www.poetsgate.com/ViewPoem.aspx?id=175806",""],[6093,"يا عاذلَ الدَّمْعِ إنْ أجراهْ إنسانُ ( البسيط)","https://www.poetsgate.com/ViewPoem.aspx?id=176207",""],[3779,"تسل عن كل شيء بالحياة فقد","https://www.poetsgate.com/ViewPoem.aspx?id=105383",""],[5309,"قضيت العمر في سكر","http://www.aldiwanalarabi.com/poemDescription.do?poemId=573569",""],[5957,"فحبكَ عندي فراتٌ ونيلٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82451&r=&rc=90",""],[6239,"المتنبي","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=75979&r=&rc=30",""],[5001,"ماذا أريد ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=80713&r=&rc=3",""],[572,"السِّحْرُ في ألحاظِهَا الفاتِكَهْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9420&r=&rc=277",""]],"verses":[["تَسَلّى الغَواني عَنهُ مِن بَعدِ صَبوَةٍ","وَما أَبعَدَ النَبتَ الهَشيمَ مِنَ النُجَع",0,"ع",1,0],["تَسَلَّطَت فيهِ أَترافُ الظُبى وَدَنَت","عَوامِلُ السُمرِ فَاِرتابَت بِها الثُغَرُ",1,"ر",1,0],["تَسُلُّ مِنكَ اللَيالي سَيفَ مَلحَمَةٍ","يَستَنهِضُ المَوتَ بَينَ البيضِ وَالسُمرِ",2,"ر",1,0],["تَسُلُّ عَليَّ الحادِثاتُ سُيوفَها","فَمِن مُغمَدٍ قَد نالَ مِنّي وَمُصلَتِ",3,"ت",1,0],["تَسَلَّوا وَلَولا اليَأسُ ما كُنتُ سالِياً","وَقَد يَصبِرُ العَطشانُ وَالوِردُ ناضِبُ",4,"ب",1,0],["تَسُلُّ منْ مُقْلَتَيْها صارِماً أخَذَتْ","مِنْ حَدِّه وَجْنَتاها حُمْرَةَ الخَجَلِ",5,"ل",1,0],["تَسَلسلَ فيها ماؤُها وَهوَ مُطلقٌ","وَصَحَّ نَسيمُ الرَوضِ وَهوَ عَليلُ",6,"ل",1,0],["تَسَلَّت عِماياتُ الرِجالِ عَنِ الصِب","وَلَيسَ فُؤادي عَن هَواكِ بِمُنسَلِ",7,"ل",1,0],["تَسَلَّلتُها مِن حَيثُ أَدرَكَها الرُقى","إِلى الكَفِّ لَمّا سالَمَت وَاِنسِلالَها",8,"ل",3,0],["تَسلُو قُلُوبُ ذَوِي الهَوى","وَهُوَ المُكَلَّفُ والمَشُوق",9,"ق",1,0],["تسلُّ سيوف البرق أيدي حُداتها","فتنهلُّ خوفاً من سطاها دموعُها",10,"ع",3,0],["تَسلُبُ الكانِسَ لَم يوأَر بِها","شُعبَةَ الساقِ إِذا الظِلُّ عَقَل",11,"ل",1,0],["تسلسلت في خدِّيَ الأدمع","معربةً فاعجبْ لما يسمع",12,"ع",1,1],["تسلَّى فؤاديَ بعد الهوى","ونامت جفوني بعد الأرق",13,"ق",1,1],["تَسَلسَلَ فيها جَدوَلٌ مِن مُحَلَّمٍ","إِذا زَعزَعَتها الريحُ كادَت تُميلُها",14,"ل",3,0],["تَسَلَّتِ النَفسُ عَن أَحبابِها بِكُم","لَولاكُمُ لَم يَكُن شَيءٌ يُسَلّيها",15,"ي",3,0],["تُسَلِّمُ بِاليُمنى عَلَيَّ إِشارَةً","وَتَمسَحُ بِاليُسرى مَجاري المَدامِعِ",16,"ع",1,0],["تَسَلَّلَ في الزِحامِ إِلَيَّ نِضوٌ","مِنَ الأَحرارِ تَحسَبُهُ خَيالا",17,"ل",2,0],["تَسَلَّ بِفِكرٍ في أَبيكَ فَإِنَّما","بَكَيتَ فَكانَ الضِحكُ بَعدَ قَريبِ",18,"ب",1,0],["تُسَلّيهِمُ عَلياؤهُم عَن مُصابِهِم","وَيَشغَلُهُم كَسبُ الثَناءِ عَنِ الشُغلِ",19,"ل",1,0],["تسَلَّ عمَّا مضَى إِذ ليس مرتجعاً","وأَقلِلِ الفكرَ فيما بعدُ لم يقَعِ",20,"ع",1,0],["تَسلَّ فما الأهواءُ إِلّا لجاجةٌ","تمادتْ ولا السُّلوانُ إِلّا غرائزُ",21,"ز",1,0],["تَسَلُ المَنازِلَ عَنهُمُ وَعَلى اللِوى","دِمَنٌ دَوارِسُ إِن تَسَل لا تُخبِرِ",22,"ر",1,0],["تَسلَّبَ رَوْضُ الياسرِيَّةِ بعدَه","وكانَ جديدَ الحَلْيِ غَضَّ المَلابسِ",23,"س",1,0],["تَسَلَّ عَنها فَإِنَّها لَعِبٌ","تَفنى سَريعاً وَإِنَّها لَهوُو",24,"و",1,0],["تَسَلسَلُ في خَمائِلِهِ مِياهٌ","يُقَدُّ أَديمُها قَدَّ الأَديمِ",25,"م",1,0],["تُسلِمُ أَرواحَ العِدى إِلى الرَدى","وَتُرجِعُ الأَمرَ إِلى أَربابِهِ",26,"ب",2,0],["تسلّ بدنْياكَ وانظرْ إلى","نفوذ المقادير في عالميها",27,"ي",3,0],["تَسَلَّبَتِ الدُنيا عَلَيهِ فَأَصبَحَت","خَلائِقُها مِثلَ الفِجاجِ القَواتِمِ",28,"م",1,0],["تَسُلُّ سُيوفَها فَتَكِلُّ عنها","مَضاربُ كُلِّ أَشطبَ ذِي مَضاءِ",29,"ا",2,0],["تسلّلَ يستخفي وأقبلَ قومُه","وللؤمِ منهم ما تَضمُّ الملاحِفُ",30,"ف",1,0],["تَسَلَّيتُ عَن مُوسَى بِحُبّ مُحَمَّدِ","وَلولاَ هُدَى الرَّحمَانِ مَا كُنتُ اهتَدِي",31,"ي",1,1],["تَسَلَّيتُ عَن موسى بِحُبِّ مُحَمَّدٍ","هُديتُ وَلَولا اللَهُ ما كُنتُ أَهتَدي",32,"ي",1,1],["تُسْلي المُحِبَّ عن الحبيبِ وتجتَني","ثمرَ النفوس مُحَرَّماً سُلْوانُها",33,"ن",3,0],["تَسَلَّ به عّمنْ سواه ومثلُهُ","يُريكَ أباه في صُدورِ المحافل",34,"ل",1,0],["تَسَلّى عَنِ الأَحبابِ صَرّامُ خُلَّةٍ","وَوَصّالُ أُخرى ما يُقيمُ عَلى أَمرِ",35,"ر",1,1],["تَسَلَّتِ النَفسُ كُلَّ شَيءٍ","إِلّا نُهاها وَما نَهاها",36,"ا",3,0],["تسلُب الناسَ حِجاهم وتَرى","أُمَم الأرض قطيعاً من سوامِ",37,"م",1,0],["تسلَّلَ يبغي مقتلاً مِن محمدٍ","لقد خُيّبَ الباغي وخابَتْ مآرِبُهْ",38,"ب",2,0],["تسلقوا حصونها تسلقا","واقتحموا ما ردها والأبلقا",39,"ق",2,0],["تَسَلَّيتُمُ عَني وَلَم أَسلُ عَنكُمُ","وَلا عاقَني يا مُنيَتي عَنكَ عائِقُ",40,"ق",1,1],["تَسَلَّوا بِماءِ الكرمِ أَيّامَ عَصرِهِ","وَعافوهُ لمّا قيلَ حَرَّمَهُ النَشُّ",41,"ش",1,0],["تَسَلَّت عِماياتُ الرِجالِ عَنِ الصِبا","وَلَيسَ فُؤادي عَن هَواكِ بِمُنسَلِ",42,"ل",1,0],["تسلياتي كموجعاتي وزادي","مثل جوعي وهجعتي كسهادي",43,"د",2,1],["تسلَّبَتْ من حُلِيِّ النَبْتِ آنفةً","وزُيِّنت بجلالِ اللّه تزيينا",44,"ن",2,0],["تسلمته حينا، فكادت نجومه","تطاول في الأفق النجوم الدراريا",45,"ي",2,0],["تسليمةُ المرءِ فيما خُطَّ من قَدَرٍ","أجدى له من داء الويل والحرَب",46,"ب",1,0],["تَسَلَّحْ بما اسطعتَ من حيلةٍ","إلى الذئبِ تُعزَى ، أو الأرنب",47,"ب",1,0],["تسلت عمايات الرجالِ عن الصّبا","وليسَ صِبايَ عن هواها بمنسل",48,"ل",1,0],["تَسلَّى بأُخرَى غيرِها، فإذا","التي تَسلَّى بها تُغْري بِلَيْلَى وَلاَ تُسْلي",49,"ي",1,0],["تسل المنازل عنهم، وعلة اللوى","دمن دوارس إن تسل لا تخبر",50,"ر",1,0],["تَسُلُّ وراءَه القلبَ الرُّواعا","ولم يَهدَأْ وسادُك في الليالي",51,"ا",3,0],["تسلط شيطانٌ من النفسِ غالبٌ","عَلَيَّ وَشَيْطانٌ مِنَ البُؤْسِ مارِدُ",52,"د",1,0],["تسلسلت بعرانين الاعاظم من","عدنان اعراقه نورا ولم تزل",53,"ل",1,0],["تسلوا بعتم الوقت لكنهم نسوا","بان نظام الكون في طيه فجر",54,"ر",1,0],["تسلطنت على رفيع عرشها","وصار جيش الحسن من امارها",55,"ر",3,0],["تسلسلني اعراق قومي فتنتهي","الى نسب ضخم الفخار نسيب",56,"ب",1,0],["تسلطن في ظرافته بشأن","علا عن ذل شائبة الحرام",57,"م",1,0],["تسلطن رتبة وسما مقاما","ففيد أكابر الأقطاب ترشد",58,"د",1,0],["تسلسلوا فعلوا مجداً ومنزلةً","عظمى بدين وآباء وأجداد",59,"د",1,0],["تسليك منه وإن أشجتك روعته","وقد تسري من الأشجان أشجان",60,"ن",1,0],["تسليتُ عن حيٍّ بدا لي بعادهم","وفارقتُهم بالكُره مُنذ زَمانِ",61,"ن",1,0],["تسلى قلوبَ العاشقين كأنها","حبيب إلى أهليه قد صار قَادِمَا",62,"م",2,0],["تسلِّى قلوب الفاقدين أحبّة","وتنسى الوليد الوالد المكرِّمَا",63,"م",2,0],["تَسْلَم من العاهاتِ والإيذاءِ من","كلِّ البريةِ واتَّبعْ ما ألقّوا",64,"ق",3,0],["تُسلى قلوبَ الوالهينَ ملاحَةً","ويذهب بالأحزانِ أيَّانَ يعربُ",65,"ب",1,0],["تسلَّوا عن الأوطان بالأبطح الذي","يلائم مَرعاه لبادٍ وحاضرِ",66,"ر",1,0],["تَسَلطَنَ بِالحَدباءِ عَبدٌ بِلُؤمِهِ","بَصِيرٌ بَلى عَن نَيلِ مَكرُمَةٍ عَمِ",67,"م",1,1],["تسل عن التنجيم واصدف عن الرقى","سؤالك والوهميّ ما عنه تسأل",68,"ل",1,1],["تسلم من رام ومن صاعد","يفسد فيها الخوص والكفرا",69,"ر",2,0],["تسلَّلَ من أملاكِ تُبَّعَ نَجْرُهُ","فلا بعدَه بَعْدُ ولا قَبْلَه قَبْلُ",70,"ل",1,0],["تسللَ من قومٍ ملا الأرضَ عدلُهم","ولكنه قد فاق كسرى وقيصرا",71,"ر",2,0],["تَسَلَّقتَها لمّا رَأيتَ حماتَها","يَذودونَ عن أبوابِها الوَغدَ وَالنَذلا",72,"ل",2,0],["تُسلَبُ الأَغمادُ عَن رَوضاتِها","وَعِيابُ السَردِ عَن غُدرانِها",73,"ن",3,0],["تُسَلُّ في الحَربِ لِلمَفارِقِ وَال","هامِ وَفي السِلمِ لِلعَراقيبِ",74,"ب",1,0],["تُسْلِي الْكَئِيبَ بِلاَبِلٌ صَدَحَتْ بِهَا","كَكَوَاعِبٍ رَجَّعْنَ آيَ زَبُورِ",75,"ر",1,0],["تَسَلّي في الهمومِ ولا تُصَلّي","لعلَّ الصبرَ يأتي بالنَّجاة",76,"ه",1,0],["تسلسل من أَعلى ذؤابة هاشم","أَشم رَحيب الباع أَروع أَغلب",77,"ب",1,0],["تسلسل في الاصلاب من عهد آدم","فَسارَ مسير الشمس في طالع النطح",78,"ح",1,0],["تَسَلَّمَها بِحَقٍّ أَلْمَعِيّاً","نِقَاباً عَنْ نِقابٍ أَلْمَعِيِّ",79,"ي",1,0],["تسل وما ثم من سلوة","ولست بناسي عهود الوداد",80,"د",1,0],["تُسلى وَيأتي على ذكراكَ أزمنةٌ","إن كانَ ما عنكَ يُسلي غير محظورِ",81,"ر",1,0],["تسلمته عجلان والدمع واكفٌ","كأن له في ناظري زفيرا",82,"ر",2,0],["تَسلّى بِالمُدام فُؤادُ قَومٍ","إِلى الهزيان قَد قَعَدوا وَقاموا",83,"م",3,1],["تسَلَّفُ الجارَ شرباً وهي حائمةٌ","والماء لزنٌ بكيُّ العَين مقتسمُ",84,"م",1,0],["تسلَّ يا قَلب عَن عَيش خَلا وَمَضى","أَوذب فَذاكَ عَيان قَد بَقِيَ خَبَرا",85,"ر",2,0],["تُسَلِّمُ حكَّامَها أمرَهَا","إذا لمْ يخُونوا ولمْ ينْهبوا",86,"ب",3,0],["تُسلِبنا اليَقظة ما زَفَّهُ","لَنا الكَرى مِن كُلِّ خود رَداح",87,"ح",1,0],["تسلُّونها في الخطب في كلّ شدَّةٍ","ألا إنَّها معروفةٌ بالشَّدائد",88,"د",1,0],["تسلُّ السيوف البيض كفك للورى","فكفُّك للجدوى وسيفك للقهر",89,"ر",1,0],["تَسَلَّيْتَ حَتَّى أُنْسِيَ الهائِمُ الهَمَّا","وأَغْنَيْتَ حَتَّى أُعْدِمَ المُعْدِمُ العُدْمَا",90,"م",2,1],["تسليت عن ريح الصباء وعنكم","بليلى مني قلبي وريح جنوب",91,"ب",1,0],["تسلُّ غمامة المزكوم منه","على ذكر الرياض مقطعاتُه",92,"ه",1,0],["تُسلِّط البلوى على عشّاقها","تسلُّطَ الحِنثِ على أَيْمانِها",93,"ن",3,0],["تسُلُّ جَناحي ريشةً بعد ريشةٍ","وتخلِسُ غصنا من فروعي إلى غصنِ",94,"ن",1,0],["تسلَّفتْ وُدَّ الملوك قبلكم","وعقَدَتْ لي في الرقاب المِننا",95,"ن",2,0],["تسلُك خَبْطاً كلَّ فج","جٍ ضيِّقٍ كالسَّمِّ",96,"م",1,0],["تسلُقني باللوم فيكم ألسنٌ","أقوالُها تصغرُ في اعتقادِها",97,"د",3,0],["تسلَّطَ البخلُ على جنَابِهِ","تسلُّطَ الخُلْفِ على الميعادِ",98,"د",1,0],["تَسلَّطُ بغياً أكفُّ النفا","ق منهم على سيِّدٍ سيِّدِ",99,"د",1,0],["تسلَّمتْ من القذى أخلاقُهُ","والماءُ يَقذَى بالسِّقاء والزَّبَدْ",100,"د",1,0],["تسلَّقوا المجدَ وداسوا العلا