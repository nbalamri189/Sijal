{"poems":[[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54539","الخفيف"],[310,"محيا الهنا طلق وثغر المنى افترا","https://www.aldiwan.net/poem56547.html","الطويل"],[333,"نذر العمر للغرام صبيا","https://www.aldiwan.net/poem55029.html","الخفيف"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130151","الطويل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216801","الخفيف"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34688","الرمل"],[4935,"تدل بدلها تيها","https://www.poetsgate.com/ViewPoem.aspx?id=129500",""],[5106,"سَاْجَ الهَوَىْ وًرِشَاً ..","https://www.poetsgate.com/ViewPoem.aspx?id=137169",""],[5616,"صرخة","https://www.poetsgate.com/ViewPoem.aspx?id=204843",""]],"verses":[["أرَصَدَ العُمْرَ لِلْهُدَى وَتَوَلَّى","كَاغْتِمَادِ الشِّهَابِ فِي الظَّلْماءِ",0,"ا",2,0],["أُرصِّعُ فيهِ من سَجاياكَ حليةً","لِغادةِ فِكري كَي تُجيدَ لَها مَهرا",1,"ر",2,0],["أرصدُ السبل ربّما لاح بدرٌ","فأنارَ الوجودَ في ناظريّا",2,"ي",2,0],["ارصع في شكوى الزمان فرائدي","لذلك في التضمين اطرى واطرب",3,"ب",1,0],["أرصد الله للمحبين ناراً","في سماء الجمال والألباب",4,"ب",1,0],["أرصدَ الباب رقيبينِ","له فاكتفناه",5,"ا",2,0],["ارصعها بياقوت","ومرجان أهديها",6,"ي",3,0],["أَرُصُّ قَلْبِيْ بِِأَرْكَانِ الْمَدَىْ شَرِهَاً","مِنَ الأَمَانِيْ وَإِكْلِيْلُ السَّنَا لَبِسَا",7,"س",2,0],["أَرُصُّ رِيْحَ لِقَاءَآتٍ سَرَينَ بِهَاْ","نَبْضِيْ وَنَبْضُكَ وَالقِنْدِيلُ قَدْ يَئِسَاْ",7,"س",2,0],["أَرَصاصُ اليهود مزَّقَ أشلا","ئيْ أمِ الصمتُ والكلامُ الرقيقُ؟",8,"ق",1,0]]}