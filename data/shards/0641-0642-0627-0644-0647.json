{"poems":[[65,"نظرت وللأدم النوافخ في البرى","https://www.aldiwan.net/poem45783.html","الطويل"],[73,"الحمد لله واجب الشكر","https://www.aldiwan.net/poem3812.html","المنسرح"],[53,"لي خادم لا أزال أحتسبه","https://www.aldiwan.net/poem8303.html","المنسرح"],[53,"ثنى شوقه والمرء يصحو ويسكر","https://www.aldiwan.net/poem63015.html","الطويل"],[91,"تعلموا تعلموا","https://www.aldiwan.net/poem44642.html","مجزوء الرجز"],[58,"ودعتها ولهيب الشوق في كبدي","https://www.aldiwan.net/poem58601.html","البسيط"],[68,"عاتبت محبوب قلبي حين زايلني","https://www.aldiwan.net/poem38462.html","البسيط"],[68,"وليلة طال سهادي بها","https://www.aldiwan.net/poem38644.html","السريع"],[68,"أقول لراووق تضمن راحنا","https://www.aldiwan.net/poem39080.html","الطويل"],[71,"أفشى إلي صاحبي","https://www.aldiwan.net/poem28738.html","مجزوء الرجز"],[107,"ما يكسب المرء من إثم ولا يزر","https://www.aldiwan.net/poem44197.html","الطويل"],[83,"أهدى نسيم الصباح","https://www.aldiwan.net/poem61390.html","المجتث"],[54,"لي صاحب قد لامني وزادا","https://www.aldiwan.net/poem26560.html","الرجز"],[50,"ومائل الرأس نشوان شدوت له","https://www.aldiwan.net/poem62508.html","البسيط"],[50,"رب غزال كأنه قمر","https://www.aldiwan.net/poem62561.html","المنسرح"],[50,"ومعتد بالذي تحوي أنامله","https://www.aldiwan.net/poem64499.html","البسيط"],[50,"اختصم الجود والجمال","https://www.aldiwan.net/poem65039.html","مجزوء البسيط"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/4632","السريع"],[22,"وَطاوي ثَلاثٍ عاصِبِ البَطنِ مُرمِلٍ","https://www.poetsgate.com/ViewPoem.aspx?id=67743",""],[119,"ماذا اقول وقد غار الحسود فلم","https://www.aldiwan.net/poem41162.html","عموديه"],[261,"حمية السرم ولكنها البظراء","https://www.aldiwan.net/poem48455.html","السريع"],[302,"يقول راجي الصمد","https://www.aldiwan.net/poem33036.html","مجزوء الرجز"],[308,"شرى صاحب لي بغلة قلت هذه","https://www.aldiwan.net/poem57752.html","الطويل"],[371,"دعوت بماء في إناء فجاءني","https://www.aldiwan.net/poem17011.html","الطويل"],[382,"رويدا رويدا يا حداة الركائبِ","https://www.aldiwan.net/poem66929.html","الطويل"],[398,"حمدا لرب جل عن نديد","https://www.aldiwan.net/poem53683.html","الرجز"],[409,"الحمد لله الذي لا يفي","https://www.aldiwan.net/poem33643.html","السريع"],[409,"إن كان من يبغضنا كارها","https://www.aldiwan.net/poem33906.html","السريع"],[438,"قبلته يوما وقابلته","https://www.aldiwan.net/poem12623.html","السريع"],[473,"ما أنس لا أنس غياثا وقد","https://www.aldiwan.net/poem60471.html","السريع"],[482,"دعوت بماء في اناء فجاءني","https://www.aldiwan.net/poem15359.html","الطويل"],[541,"قال النبي ولم أجزع يوقرني","https://www.aldiwan.net/poem23854.html","البسيط"],[543,"إن كان في كل أرض ما تشان به","https://www.aldiwan.net/poem48233.html","عموديه"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34440","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77626","البسيط"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59188","البسيط"],[1059,"","https://poetry.dctabudhabi.ae/diwan/poem/72327","البسيط"],[1372,"","https://poetry.dctabudhabi.ae/diwan/poem/79446","الطويل"],[1589,"","https://poetry.dctabudhabi.ae/diwan/poem/111909","الرمل"],[1652,"","https://poetry.dctabudhabi.ae/diwan/poem/67406","الطويل"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108904","البسيط"],[1718,"","https://poetry.dctabudhabi.ae/diwan/poem/44738","الوافر"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26425","السريع"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26446","الوافر"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114777","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27724","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27528","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27322","المنسرح"],[2404,"","https://poetry.dctabudhabi.ae/diwan/poem/32610","الوافر"],[2411,"","https://poetry.dctabudhabi.ae/diwan/poem/126191","الرجز"],[2623,"","https://poetry.dctabudhabi.ae/diwan/poem/129823","السريع"],[2882,"","https://poetry.dctabudhabi.ae/diwan/poem/140058",""],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58307","الرجز"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202999","المتقارب"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74176","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74213","الوافر"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74029","المتقارب"],[3520,"","https://poetry.dctabudhabi.ae/diwan/poem/48428","البسيط"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138702",""],[3747,"","https://poetry.dctabudhabi.ae/diwan/poem/85284","الرجز"],[3794,"","https://poetry.dctabudhabi.ae/diwan/poem/131041",""],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111497","المتقارب"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[3963,"","https://poetry.dctabudhabi.ae/diwan/poem/44722","الرجز"],[3969,"","https://poetry.dctabudhabi.ae/diwan/poem/44891","الرجز"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/95064","الوافر"],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[4830,"خطَّ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=200443",""],[5087,"أداروها ولليل اعتكار","https://www.poetsgate.com/ViewPoem.aspx?id=96349",""],[5183,"حفظ الكرام","https://www.poetsgate.com/ViewPoem.aspx?id=180286",""],[5183,"سَعد وسُعَيد","https://www.poetsgate.com/ViewPoem.aspx?id=180217",""],[5816,"( العبيرية ) في وصف الجنة","https://www.poetsgate.com/ViewPoem.aspx?id=125964",""],[5953,"يا محضر الغيد بالصمان بالغار","https://www.poetsgate.com/ViewPoem.aspx?id=93853",""]],"verses":[["فَقالَ هُذَيمٌ وَهوَ خِلِّي وَناصِحٌ","لَها وَعَلى أَسرارِهِنَّ أَمينُ",0,"ن",1,0],["فَقالَ هَذا يَكونُ مُمتَهِناً","مُضَيَّعاً لا رِضى عَنِ الدَهرِ",1,"ر",1,0],["فقال هاكم وليس في يده","إلا نوى كان مرة رُطَبُهْ",2,"ب",2,0],["فقال هبوا أن الفراش لخالدٍ","أليس لهذا كان بالليل يُجمَر",3,"ر",1,0],["فقال هذا هو ما","ضقت به واكتم",4,"م",1,0],["فقال هذا سَقَامٌ لا دَواءَ لَهُ","إِلاَّ بِرُؤْيَةِ مَنْ تَهْواهُ يا سَنَدِي",5,"د",2,0],["فقال هذا شعاع الشمس مدركنا","والشمس لا ينبغي أن تدرك القمرا",6,"ر",2,0],["فَقالَ هَل لَكَ في شَقفَةِ","كَبشِيَّةٍ تَطرُدُ عَنّا السُهاد",7,"د",1,0],["فَقالَ هَمَت عَيني وَسِنّي ضاحِكٌ","وَقَد تَدمَعُ العَينانِ مِن شِدَّةِ الضَحِكِ",8,"ك",1,0],["فقالَ هلْ حفظتَهُ","فقلتْ بل نسيتُهُ",9,"ه",1,0],["فقالها مُرّةً حَرَّى وأرسلها","كأنّها روحُه من فِيهِ تَنحدِر",10,"ر",1,0],["فَقالَ هاتِ الكُؤوسا","واِشرَب وَدَع مَن تَعَذَّر",11,"ر",1,0],["فَقالَ هَذا أَوَّلُ الجُنونِ","مَتى ثَوى الضَبُّ بِوادي النونِ",12,"ن",1,0],["فَقالَ هاتِ اِسقِني وَاِشرَب وَغَنِّ لَنا","يا دارَ شَعثاءَ بِالقاعَينِ فَالساحِ",13,"ح",1,0],["فَقالَ هَيهاتَ ذا تُرَقِّقُني","وَلَن يَرِقَّ الغَزالُ لِلأَسَدِ",14,"د",1,0],["فَقالَ هاتِ وَأَسمِعنا عَلى طَرَبٍ","وَدِّع هُرَيرَةَ إِنَّ الرَكبَ مُرتَحِلُ",15,"ل",1,0],["فَقالَ هَذا يَمينُهُ لي","لِلعُرفِ وَالجودِ وَالنَوال",16,"ل",1,0],["فَقالَ هَذا رَجُلٌ قالَ لي","سُبَّ عَليَّ بنَ أَبي طالِبِ",17,"ب",1,0],["فقال هيا رباه ضيف ولا قرى","بحقك لا تحرمه تالليلة اللحما",18,"م",2,0],["فقال هاتف سر الغيب ارض وطب","فهل رأيت سعيدا غير محسود",19,"د",1,0],["فقال هيهات وهل يرجع الل","ص إذا فر من المطبق",20,"ق",1,0],["فَقال هَذا رَجلٌ","لا يَعتَريه المَللُ",21,"ل",1,0],["فقال هي الطاحون عندي لأنها","إذا ما سعت لم تنتقل عن مكانها",22,"ه",2,0],["فَقالَ هُوَ الماءُ القَراحُ وَإِنَّما","تَجَلّى لَهُ خَدّي فَأَوهَمَكَ الخَمرا",23,"ر",2,0],["فقال هو الحصن الموطد في الورى","أثيل السجايا والعلا والمواهب",24,"ب",1,0],["فَقالَ هل يُفعَل ما لا يُؤثِرُ","إِذاً عَن المُلكِ العَظيمِ يقصرُ",25,"ر",1,0],["فقال هذا مقصدي لا سوى","فارو كلامي غير مستنكف",26,"ف",1,0],["فقال هذا ناصح صادق","وقال هذا كاذب مفتري",27,"ر",2,0],["فقال هذي دررٌ جمّةٌ","فقلت في ثغرِك هذي الدُررْ",28,"ر",1,0],["فَقالَ هَذاكَ لَهُ هَكَذا","يَكونُ لِلقِبطِ جَوابُ العَرَب",29,"ب",1,0],["فقالَهو الماءُ القَراحُ واِنَّما","تجلَّى لها خدَّي فأوهمكَ الخَمْرا",30,"ر",2,0],["فَقالَ هَل لَكُم أَن تُطلِقوا فَرَسي","وَتَأخُذوا مَوثِقي في نُصحِ أَشرارِ",31,"ر",1,0],["فقال ها أنتَ للحقِّ اهتَديتَ فقل","إذن متَى ستزورُ المطعمَ البلدي",32,"د",2,0],["فَقالَ هَل صَيَّفَ في مساءَةٍ","قُلتُ نَعَم وَفي هُمومٍ شَتّى",33,"ت",2,0],["فَقالَ هَذا لَيسَ أَقوى مِما","عَبرتُهُ وَجاءهُ ما اِهتَمّا",34,"م",2,0],["فَقَالَ هَيْهَاتَ أنْتَ لِصٌّ","وَاللِّصُّ لاَ يَنْتَهِي بِلاَ حَدْ",35,"د",1,0],["فقال هذا وصي والخليفة من","عدي وذو العلم بالمفروض والسنن",36,"ن",1,0],["فقالَ هو الماءُ القراحُ وإنَّما","تجلَّى لهُ وجهي فأوهمَكَ الخَمْرا",37,"ر",2,0],["فقال هما امران احلاهما مرُّ","تجلَّى الامر واتضح الخفآءُ",38,"ا",2,0],["فَقَالَ هَدَأكَ الله لِلرشُد إنَّمَا","دَعَوْتَ لِمَا لَمْ يَأتِهِ سَبُعٌ قَبْلِي",39,"ل",2,0],["فقال هيهات إني عاشقٌ دنفٌ","لا أشتهي أحداً فيها يشاركني",40,"ن",2,0],["فَقالَ هاتِ أَلحِقنا بِراحٍ","بِهِ وَتَعللوا ثُمَّ اِستَراحوا",41,"ح",3,0],["فَقالَ هَل أَكمَلَها قَدرُهُ","إِذا بَدا في حُلَّةٍ يَخطُرُ",42,"ر",1,0],["فَقالَ هُوَ الشِفاءُ فَلا تُقَصِّر","فَقُلتُ أَجَل وَلكِن لا يُجيبُ",43,"ب",1,0],["فقال هُم في آخر الدَّهرِ صَفوَتي","يعضُّون أَعدائي ويستنصرونَ بي",44,"ب",2,0],["فقال هذا بذا ففكِّر","إذ تسمعِ القولَ والنداء",45,"ا",2,0],["فقالَ هيهاتِ لما تعرفه","مني فإني منذ وليتُ الدبر",46,"ر",1,0],["فقال هذا الذي أقول به","في حقِّ هذا الأنيس فازدجر",47,"ر",1,0],["فقال همُ قريب من","ك لو نفعوك إذ رحلوا",48,"ل",3,0],["فقال هلاّ تشكرين المصطفى","قالت لغيرِ الله لن اختِلفَ",49,"ف",1,0],["فقال ها لثميَ نقلاً ولا","تشمّ إلا عرفيَ الأطيبا",50,"ب",2,0],["فقال هيهات مقلة برزت","حمرة مرجانها من اليقق",51,"ق",1,0],["فَقالَ هذي صَنْعَة","لم يَبْقَ لي فيها يَدُ",52,"د",1,0],["فقال هب الأجر لي قبل أن","تراه وإن لم تهب تخسر",53,"ر",1,0],["فَقالَ هُوَ القَصر المُنيف الَّذي عَلَت","عَلى القبة الخَضراء قُبته الصَفرا",54,"ر",2,0],["فَقالَ هِيَ العَقيلة مِن لُؤي","وَخَير قَبيلة شدوا العِقالا",55,"ل",2,0],["فَقالَ هَوَتني وَأَبدَت هَواي","وَلَم تُخفِ أَسرارها البادِيَه",56,"ي",2,0],["فقال هلْ لكَ في أحْلى سنىً وحُلاً","فقلتُ دعْ غايَةً أبْعَدتَ مَرْماها",57,"ا",3,0],["فقال هاهما على أثري فقد","دنا الحمام منهما واقتربا",58,"ب",2,0],["فقال هذا الخل","جفاه لا يحل",59,"ل",1,0],["فقال هي الحبيبة لا سواها","وقالت إنه بالروح يفدى",60,"د",2,0],["فَقالَ هُنا خَيمَتي اِدخُل تَنَقّى","قَناةً وَإِن شِئتَ عِشرينَ تَلقى",61,"ق",2,0],["فقال هل من مدع فعن عجل","كي نستريح من جهاد الجهد",62,"د",1,0],["فَقالَ هَيا فَاِنَهَضوا لِلأَمرِ","وَالتَهَبَت عَيناهُ مِثل الجَمرِ",63,"ر",1,0],["فَقالَ هاتي قُبلةً","فَقُلتُ خُذها وَاِذهَبِ",64,"ب",1,0],["فقال هجرتكم يا آلُ رغماً","وذا حتمٌ على كل العبيدِ",65,"د",1,0],["فقال هو النور الذي بدخوله الص","دور انفساح وانشراح بايقان",66,"ن",1,0],["فقالَ هذا برزخٌ بيننا","فقلتُ هل تخشى بياضَ المَشيبْ",67,"ب",1,0],["فقال هي العقار تداولوها","مشعشعة يطير لها شرار",68,"ر",1,0],["فقال هلم تجمعنا صلاة","فجاء الناس في حسن انتظام",69,"م",1,0],["فقال هي الدنيا ودونك قصتي","بها عظة للمبصرين ومهتدى",70,"د",2,0],["فقال هلموا يا أحباي أنتم","من القلب عندي قلبها وصدورها",71,"ر",3,0],["فقال هذا رسولي أحمد وله","منه علي وصي مالك الدار",72,"ر",1,0]]}