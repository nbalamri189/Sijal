{"poems":[[51,"لاتك في كل هوا تنهمك","https://www.aldiwan.net/poem63039.html","السريع"],[48,"سل سبيل الحياة عن سلسبيل","https://www.aldiwan.net/poem23261.html","الخفيف"],[92,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[310,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[406,"قمر الهدى","https://www.aldiwan.net/poem6776.html","عموديه"],[563,"حولوا عني من الكون لثاما","https://www.aldiwan.net/poem33885.html","الرمل"],[673,"","https://poetry.dctabudhabi.ae/diwan/poem/137337",""],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/63759","الوافر"],[838,"","https://poetry.dctabudhabi.ae/diwan/poem/64226","الهزج"],[1074,"","https://poetry.dctabudhabi.ae/diwan/poem/35407","الوافر"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/55935","الرجز"],[1824,"","https://poetry.dctabudhabi.ae/diwan/poem/95388","الكامل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125358","الخفيف"],[2069,"","https://poetry.dctabudhabi.ae/diwan/poem/102104","الوافر"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28539","الكامل"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104680","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203487","الوافر"],[3364,"","https://poetry.dctabudhabi.ae/diwan/poem/139923","الكامل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45852","الطويل"],[3841,"","https://poetry.dctabudhabi.ae/diwan/poem/205411","الهزج"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81279","الرمل"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104880","المنسرح"],[4815,"إرم البذار","https://www.poetsgate.com/ViewPoem.aspx?id=210463",""],[4862,"يسامرني القريض وأصطفيهِ","https://www.poetsgate.com/ViewPoem.aspx?id=135806",""],[4888,"زف الدماء","https://www.poetsgate.com/ViewPoem.aspx?id=207759",""],[4888,"دعوني أحلق","https://www.poetsgate.com/ViewPoem.aspx?id=207763",""],[4908,"حقوق العشق","https://www.poetsgate.com/ViewPoem.aspx?id=207333",""],[4962,"ابتَسِمْ","https://www.poetsgate.com/ViewPoem.aspx?id=201737",""],[5038,"رذاذ القسطل","https://www.poetsgate.com/ViewPoem.aspx?id=189378",""],[5057,"قاوميني","https://www.poetsgate.com/ViewPoem.aspx?id=197180",""],[5323,"أمشاج الحب","https://www.poetsgate.com/ViewPoem.aspx?id=207794",""],[5351,"القادم أولاً وثانياً","https://www.poetsgate.com/ViewPoem.aspx?id=202236",""],[5376,"لا تبكينَّ على عزيزٍ قد مضى","https://www.poetsgate.com/ViewPoem.aspx?id=202172",""],[5512,"قضيت العمر أعجنه بصبري","https://www.poetsgate.com/ViewPoem.aspx?id=204500",""],[5533,"في انتِظار المَوْعِد","https://www.poetsgate.com/ViewPoem.aspx?id=179799",""],[5574,"يا أيّها الرّسام","https://www.poetsgate.com/ViewPoem.aspx?id=206043",""],[5818,"البنات كالنبات","https://www.poetsgate.com/ViewPoem.aspx?id=181760",""],[5829,"قم لرمضان","https://www.poetsgate.com/ViewPoem.aspx?id=212930",""],[5952,"لا تبتئس","https://www.poetsgate.com/ViewPoem.aspx?id=196903",""],[5956,"أجيبي جواباً يثيرُ اْلتذاذا","https://www.poetsgate.com/ViewPoem.aspx?id=182220",""],[5956,"أحبك يا إلهي","https://www.poetsgate.com/ViewPoem.aspx?id=192500",""],[6093,"الدِّبْسُ مَهْمَا حَلَا لَنْ يَبْلُغَ العَسَلا","https://www.poetsgate.com/ViewPoem.aspx?id=191372",""],[6128,"عزيزي","https://www.poetsgate.com/ViewPoem.aspx?id=212860",""],[6131,"نحَّاتُ نورٍ","https://www.poetsgate.com/ViewPoem.aspx?id=189270",""],[5014,"حديث الشمس للقمر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76223&r=&rc=19",""],[6251,"إلى الشيخ جابر الأحمد الصباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76467&r=&rc=7",""],[6344,"طُقُوسُ العاشِقين","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87967&r=&rc=7",""]],"verses":[["وَاِصنَع إِلى الناسِ جَميلاً كَما","تُحِبُّ أَن يَصنَعَهُ الناسُ بِك",0,"ك",1,0],["وَاِصنَعوا مِن حَلاوَةٍ ذاتِ طيبٍ","لا بِرِطلَي بَغدادَ بَل أَردَبيلِ",1,"ل",1,0],["وأصنامِ بَغْيٍ يصُبّونها","ويَدْعُونها مَثلاً يُقتدى",2,"ا",1,0],["وَاِصنَع بِها ما شِئتهُ ترهُ غداً","إِذ لا رَهينَ يفكُّ ممّا يصنعُ",3,"ع",1,0],["وأصنافاً من الأقلامِ ظَلَّتْ","تصوِّر مَنْهَجَ الإسلام غُولا",4,"ل",2,0],["واصنع الفلك بتقواك ولا","تأمن الطوفان موجاً والتطاما",5,"م",2,0],["واصنع الخير ما حييتَ وجانب","كلَّ امرٍ يُلقي عليك الذُّنوبا",6,"ب",2,0],["وأصنافٌ من الريحانِ مما","تخبَّرُ عن جَنَى وردٍ وَخِيري",7,"ر",2,0],["وأصنافِ النواميسِ","وأصنافِ القوانين",8,"ن",1,0],["وَأَصنافِ التُخوتِ مُلَوَّناتٍ","كَما وَشَّت يَدُ الأَنوارِ باها",9,"ا",3,0],["واصنع من الحديد في ذا الحجبِ","عوداً طويلا راسه ذو شعبِ",10,"ب",1,0],["واصنعه مطبوخاً وإن شئت اتخذ","من لحمه مشوي على الأفحام",11,"م",1,0],["واصنعوا الخيرَ للحياتينِ حتى","تأمَنَ النفسُ إن تدانى القضاء",12,"ا",2,0],["وأصنامٌ معجزاتٌ ليسَ تُحصى","وكم في ليل مولدهِ السطيع",13,"ع",1,0],["وَاصنَع جَميلاً لا يَضيعُ صَنيعُهُ","واسمَح بِقوتِكَ لِلضَّعيفِ البائِسِ",14,"س",1,0],["واصنعوا مهما أردتم في الهوى","ما ألذ الحب وصلاً وانصراما",15,"م",2,0],["وأصنام من الشعراء حفت","بها العباد تنفخها دواما",16,"م",2,1],["واصنعْ لها عرساً ولا تحوج إلى","قاضٍ عليك ولا وكيل رافعِ",17,"ع",1,0],["وَأَصنع مِن فَرط السُرور وَلائِماً","عَلى رغَم كُلٍّ مِن حَسود وَلائم",18,"م",1,0],["وأصناف من الطيب","ليستعمل من يتفل",19,"ل",1,0],["وَاِصنَعي مِنهُ خَطاياها فَما","وَزر البَدر وَلَم تَجن قَمَر",20,"ر",1,0],["وأصنع اليوم في الطفوف كما","صنعت في خبير وفي أحد",21,"د",1,0],["واصْنَعْ ببأسِكَ سَهْمَ شَبٍّ يافِعٍ","يَنشَأْ وقوسُكَ في يَديهِ إذا اقتَدَرْ",22,"ر",1,0],["وأصنعُ من معانيها دواءً","وأهديهِ لموجوعٍ سبيلا",23,"ل",2,0],["واصنع له بئرًا سحيقًا ألقِهِ","في قعرها واحلفْ بأنّكَ لم تَرَه",24,"ر",2,0],["وأصنعُ لي جذوةً من طموحٍ","تخلِّصكمُ من ضميرٍ مُعوّقْ",25,"ق",1,0],["وأصنعُ من حقولِ الشعر عطراً","توزعهُ على الجيدِ الكفوفُ",26,"ف",1,0],["واصنع لثغرك بسمةً","واخلق سرورك من عدم",27,"م",1,0],["واصْنعْ لعمْركَ مرْكباً تنْجو بهِ","مِنْ يومِ أهْوالِ الحسابِ المقْبلِ",28,"ل",1,0],["واصنعي دونكِ الصِّعاب فإنّي","أكرهُ السهلَ أعشقُ المُستحيلا",29,"ل",2,0],["‏واصنعوا ماشئتمُ من طرقٍ","‏لست محتاجا إلى روحي طريقه",30,"ق",2,0],["وأصنع سكيناً من عنقي","واذبحني، مهلاً لا تفعل",31,"ل",1,0],["واصنعْ جميلَك قبلَ أن تلقى الردى","فلكلِّ شمسٍ مطلعٌ وزوالُ",32,"ل",1,0],["وأصنعُ قارباً لي من ضلوعي","لأركبَهُ ، وأعبرَ فيه نهري",33,"ر",2,0],["واصْنَعْ بِها عِقْداً يُحَاكُ لغَادةٍ","فَمَعَ الغَوانِي لَسْتُ أُخْلِفُ مَوْعِدا",34,"د",2,0],["٣٠- واصْنعْ لِحُلْمِكَ سؤددًا قبلَ الثرى","ليظلَّ ذكرُكَ خالدًا أبدِيّا",35,"ي",2,0],["وأصناف البنات بلا خلافِ","ك أصناف النباتِ على اختلافِ",36,"ف",1,1],["واصنعْ من المعروفِ كل مؤجلٍ","فالبرّْ كلُّ البرِّ ماهو عاجِلُ",37,"ل",1,0],["واصنع لنفسك من شجونك سُلَّماً","ترقى عليه إذا الشعورُ تبخّرا",38,"ر",2,0],["وأصنع ضدَّ اشتياقي بديلا","فما الصبر إلا الدَّوا والملاذا",39,"ذ",2,0],["وأصنع من نسيمي أوكسجيناً","وعطراً بالقصيدِ به أفيدُ",40,"د",1,0],["واصنعْ رياحَ شُكُوْكٍ حَولَ وحْدَتِنَا","فالرِّيْحُ مَهْمَا عَتَتْ لَنْ تَنْقلَ الجَبَلا",41,"ل",2,0],["واصنع من الكلمات بيت صبابةٍ","يرضي الفؤاد بخفةِ التحفيزِ",42,"ز",1,0],["وَ أصنافَ عُمرٍ ومرآةَ وجدٍ","وَ عُصفُورَ نورٍ وَ أَشياءَ أُخْرى",43,"ر",2,0],["واصنع لنفسك منك في","ك طبيعة تأبى النفورا",44,"ر",2,0],["وَأَصْنَعُ لِلأَيَّامِ مِنْكَ حَدِيْثُهَا","وَكُلُّ حَدِيْثٍ عَنْكَ يَحْلُوْ وَيَعْذَبُ",45,"ب",1,0],["وَأَصْنَعُ مِنْ ثِيَابِكِ لِيْ بِسَاطًا","يُسَافِرُ بِيْ ظِلَالًا صَوْبَ بَدْرِكْ",46,"ك",1,0]]}