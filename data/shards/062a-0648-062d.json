{"poems":[[95,"وافى الكتاب فأحيا","https://www.aldiwan.net/poem9828.html","عموديه"],[53,"للناس عيد ولي عيدان في العيد","https://www.aldiwan.net/poem10864.html","البسيط"],[87,"شبكت قلبي يا عيني","https://www.aldiwan.net/poem6805.html","عموديه"],[87,"سويجع النيل رفقا بالسويداء","https://www.aldiwan.net/poem63685.html","البسيط"],[47,"يكاد يبدي لسعدى غيب ما أجد","https://www.aldiwan.net/poem63477.html","البسيط"],[46,"يصدني عن كلامك الشفق","https://www.aldiwan.net/poem30197.html","المنسرح"],[48,"توحد فإن الله ربك واحد","https://www.aldiwan.net/poem22023.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39661","الوافر"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39581","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202645","المجتث"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/142003","البسيط"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54272","الطويل"],[111,"إن المعارف للقلوب مصائد","https://www.poetsgate.com/ViewPoem.aspx?id=531",""],[98,"مهرجانُ الزِّفافِ","https://www.poetsgate.com/ViewPoem.aspx?id=187844",""],[92,"المقصورة","https://www.poetsgate.com/ViewPoem.aspx?id=179220",""],[96,"الكعبة الزهراء","https://www.poetsgate.com/ViewPoem.aspx?id=12696",""],[53,"للناس عيدٌ ولي عيدانِ في العيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=27703",""],[208,"بدا الشعر في وجهه فانتقم","https://www.aldiwan.net/poem53012.html","المتقارب"],[208,"فراركما بالأمس بغضني أمسي","https://www.aldiwan.net/poem53134.html","الطويل"],[215,"تناسيتكم عمدا كأني سلوتكم","https://www.aldiwan.net/poem46783.html","الطويل"],[275,"برزت وقد شقت حجاب الأعصر","https://www.aldiwan.net/poem35653.html","الكامل"],[318,"بنور تجلى وجه قدسك دهشتي","https://www.aldiwan.net/poem59507.html","الطويل"],[369,"أساير ركب الجو وهو كواكب","https://www.aldiwan.net/poem60997.html","الطويل"],[385,"الله أكبر جاء النصر والظفر","https://www.aldiwan.net/poem48765.html","البسيط"],[458,"يا شعر من ترجو تحسب أنه","https://www.aldiwan.net/poem61226.html","الكامل"],[458,"أهذا هو الفنان نسمعه فنا","https://www.aldiwan.net/poem61703.html","الطويل"],[463,"لعل الركب أن خلصوا نجيا","https://www.aldiwan.net/poem55813.html","الوافر"],[463,"صحا القلب لكن صبوة وحنين","https://www.aldiwan.net/poem55824.html","الطويل"],[463,"إذا ذهب الوفاء من الزمانِ","https://www.aldiwan.net/poem55825.html","الوافر"],[463,"يذنب دهر ويستقيل","https://www.aldiwan.net/poem55932.html","مخلع البسيط"],[463,"متى رفعت لها بالغور نار","https://www.aldiwan.net/poem56187.html","الوافر"],[487,"أشكو له منه مهجتي","https://www.aldiwan.net/poem24282.html","عموديه"],[563,"نحن المراتب بالوجود مرتبه","https://www.aldiwan.net/poem33526.html","الكامل"],[591,"أرح يمينك مما أنت معتقل","https://www.aldiwan.net/poem17644.html","البسيط"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103109","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103081","البسيط"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103086","الطويل"],[663,"","https://poetry.dctabudhabi.ae/diwan/poem/103066","البسيط"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70848","الطويل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202069","الرجز"],[1100,"","https://poetry.dctabudhabi.ae/diwan/poem/133834","البسيط"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56102","المتدارك"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64858","المنسرح"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6763","السريع"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64592","الكامل"],[1536,"","https://poetry.dctabudhabi.ae/diwan/poem/82545","الطويل"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141294","الكامل"],[2028,"","https://poetry.dctabudhabi.ae/diwan/poem/123157","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27813","الرجز"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27381","البسيط"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27447","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27442","الطويل"],[2232,"","https://poetry.dctabudhabi.ae/diwan/poem/118739","الكامل"],[2588,"","https://poetry.dctabudhabi.ae/diwan/poem/137023",""],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127374","الكامل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202739","المنسرح"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204970",""],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/199949","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/202410","المنسرح"],[3116,"","https://poetry.dctabudhabi.ae/diwan/poem/132748","السريع"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74039","البسيط"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103850","الطويل"],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108032","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109962","البسيط"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91051","الطويل"],[3844,"","https://poetry.dctabudhabi.ae/diwan/poem/86509","الكامل"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29309","البسيط"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125894","الطويل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101365","الطويل"],[4052,"","https://poetry.dctabudhabi.ae/diwan/poem/36653","الدوبيت"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119621","الوافر"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81735","الرجز"],[4304,"","https://poetry.dctabudhabi.ae/diwan/poem/81716","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133083","الرجز"],[4535,"","https://poetry.dctabudhabi.ae/diwan/poem/72494","الرجز"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52145","الكامل"],[4767,"لا تسأليني","https://www.poetsgate.com/ViewPoem.aspx?id=210247",""],[4805,"حين خِلوْه","https://www.poetsgate.com/ViewPoem.aspx?id=176594",""],[4876,"سباق مع التيه","https://www.poetsgate.com/ViewPoem.aspx?id=207497",""],[4929,"صدى الواقع","https://www.poetsgate.com/ViewPoem.aspx?id=199284",""],[5041,"لك الله مساجد الله","https://www.poetsgate.com/ViewPoem.aspx?id=24395",""],[5072,"كفى هوساً","https://www.poetsgate.com/ViewPoem.aspx?id=52569",""],[5136,"الحق أبلج واضح للمهتدي","https://www.poetsgate.com/ViewPoem.aspx?id=121802",""],[5145,"من كان يصبو إلى الأوصاف والغزل","https://www.poetsgate.com/ViewPoem.aspx?id=108227",""],[5145,"رقدت ودهرك لا يرقد","https://www.poetsgate.com/ViewPoem.aspx?id=108069",""],[5191,"حَوَتْ كلّي","https://www.poetsgate.com/ViewPoem.aspx?id=214053",""],[5232,"شموخ الأرز","https://www.poetsgate.com/ViewPoem.aspx?id=212986",""],[5277,"رثائياتٌ بغدادية","https://www.poetsgate.com/ViewPoem.aspx?id=198579",""],[307,"ما زادني قولُ المديحِ جميلا","https://www.poetsgate.com/ViewPoem.aspx?id=213806",""],[5408,"لأنك إنّي","https://www.poetsgate.com/ViewPoem.aspx?id=190763",""],[5425,"نَورَسَةُ الهَور","https://www.poetsgate.com/ViewPoem.aspx?id=198930",""],[5459,"بعثة الرحمة المهداة","https://www.poetsgate.com/ViewPoem.aspx?id=190905",""],[5582,"ثَنَتْ لِوَداعِي جِيدَها غُدْوَةً يُسْرَا","https://www.poetsgate.com/ViewPoem.aspx?id=187150",""],[5837,"سيرة وطن","https://www.poetsgate.com/ViewPoem.aspx?id=179315",""],[5943,"سلوا الأيام منشدة(أبو سهام)","https://www.poetsgate.com/ViewPoem.aspx?id=34370",""],[5953,"يا سرّ مرَّى لقد أصبحت لي سكناً","https://www.poetsgate.com/ViewPoem.aspx?id=93789",""],[5956,"‏ رثاء حب الطفولة","https://www.poetsgate.com/ViewPoem.aspx?id=182240",""],[5956,"حَسَبُ الإنسان لا نَسَبُه","https://www.poetsgate.com/ViewPoem.aspx?id=184369",""],[5956,"عقيدة التوحيد تصنع وحدة العالم","https://www.poetsgate.com/ViewPoem.aspx?id=192642",""],[5997,"الغَرَّاْءُ","https://www.poetsgate.com/ViewPoem.aspx?id=214276",""],[6293,"ترنيمةُ المدَدِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83639&r=&rc=1",""]],"verses":[["تُوحِي المَحَاسِنُ فِيهِ","مُقَدَّمَاتِ الذُّنُوبِ",0,"ب",1,0],["تَوْحِيدُ مَدْحِك دون الناس كلِّهمُ","سِيَّانِ عنْدي وإخْلاصي وتوْحِيدي",1,"د",2,0],["توحشني وأنت ويايا","وأشتاق لك وعينيك في عينيا",2,"ي",2,0],["توحي إِلَيَّ الَّذي توحي وَتَسمَعُ لي","وَفي سَماعِكَ بَعدَ الوَحيِ إِغرائي",3,"ي",1,0],["تَوَحَّدَ القَمَرُ الساري بِشُهرَتِهِ","وَأَنجُمُ اللَيلِ نَثرٌ حَولَهُ بَدَدُ",4,"د",1,0],["توحي بِأَسرارِنا حَواجِبُنا","وَأَعيُنٌ بِالوِصالِ تَرتَشِقُ",5,"ق",1,0],["تَوَحَّد فَإِنَّ اللَهَ رَبَّكَ واحِدٌ","وَلا تَرغَبَن في عِشرَةِ الرُؤَساءِ",6,"س",3,1],["توحَّدَ في الزعامة فهو فردٌ","وأُفرِدَ بالأمانةِ فهو صُلْبُ",7,"ب",1,0],["توحي إليَّ الشعرَ علويَّ السنى","مصر ونورُ شبابكَ المتألِّقُ",8,"ق",1,0],["توحشني وانت ويايى","واشتاق لك وعينيك بعيني",9,"ي",1,0],["توحدوا باسم مصر في تجهمها","وطالعوا ثغرَ مصر كيف يتبسم",10,"م",1,0],["توحّد حتى صار قلباً تحوطه","قلوبٌ من العُرْبِ الكرام وأضلُع",11,"ع",1,0],["توحي الى الروع الهدى من نورها","وهدى النبي هو الضياء الواقد",12,"د",1,0],["توحِي إليَّ الشعرَ علويَّ السنا","مصرٌ، ونورُ شبابِكَ المتألِّقُ",13,"ق",1,0],["توحُ على مثلِ شَوك القَتادِ","وتغدو على مثل جَمْرِ الغضا",14,"ا",1,0],["توحّدت بالصحراء . حتّى مغيبها","ومشهدها من مشهديّ ومغيبي",15,"ب",2,0],["تَوحيدُ مديحك دون الناس كلِّهمُ","سِيَّانِ عندي وإخلاصي وتوحيدي",16,"د",2,0],["توحَّشت العينُ في وجهه","وحقّ لها وحشة في الظُّلمْ",17,"م",1,0],["توحشتما مني لأنسي إليكما","فلم تُنصفاني في التوحُّش من أنسي",18,"س",2,0],["توحدت مقهوراً فما لي إخوةٌ","ولا صحبة يقوى برفقتهم زندى",19,"د",2,0],["توحدت لا خل أبث شكايتي","إليه ولا حب يؤرقه سهدى",19,"د",2,0],["توحدت لا فالأسد يؤنسها الأسى","بوحشتها في ظلمة الكثب الجرد",19,"د",1,0],["توحيدَكم لله منهُ وحدةٌ","لجموعِكم فخذوا برأي مُدبّر",20,"ر",1,0],["توحشت من أبناء نوعي ولم يكن","لشيء سوى أنسي بقربك وحشتي",21,"ي",1,0],["توحَّدَ في عَلْيائهِ فهو غُرّةٌ","لدَهْر بهيمٍ والحُجولُ المناقب",22,"ب",1,0],["تَوحشوا فَرقاً حَتّى مَواردهم","ما أَسأر البَقَر الوَحشيّ وَالحُمرُ",23,"ر",1,0],["توحي الجديد لنا وقبلا طالما","أوحت ولم تبرح كفلك دائر",24,"ر",1,0],["توحدت الأضداد حتى كأنها","عيالُ حباهَا الفُّن من شأنِه شأنا",25,"ن",2,0],["توحَّشُ يومَ تطلب سامريّاً","وتأنس يومَ تجلبُ بابليَّا",26,"ي",2,0],["توحَّدَ في الدنيا فما يستحقُّه","مكانٌ من الدنيا الوَساع مكينُ",27,"ن",1,0],["توحّدَ في الكمال فلم يعزَّزْ","بقوّةِ ثالثٍ وبنصرِ ثاني",28,"ن",2,0],["توحّدوا بالعلا فبانوا","والناسُ من بعدهم شُكولُ",29,"ل",1,0],["توحَّدَ من بني الدنيا رَكوبٌ","صعائبَها إذا كُرِه الخِطارُ",30,"ر",1,0],["توحدت في حبي فما لي سواه","وظن بوصل الحسن المستطابا",31,"ب",2,0],["توحيدنا تمييزه عنها به","وإذا تميز فهي عنه مغيبه",32,"ب",2,0],["تُوحي إلى كلّ قِرطاسٍ بَلاَغَتُهُ","سِحْرُ البيانِ وَمِنْ أَقْلاَمِهِ الرُّسُلُ",33,"ل",1,0],["توحدهم في كل نفس وحيدة","مرادهم في كل نفس مريدة",34,"ه",1,0],["توحيد وحدته إظهار حكمته","من حيث حدد في تصوير منصرم",35,"م",1,0],["توحدت في الآحاد لما تناسخت","قواعد أحكامي بنفي جحودي",36,"د",2,0],["توحدت وهي في الآحاد ما اتحدت","أقسمتُ ما قسمت قسما لمنقسم",37,"م",1,0],["توحَّش مني إذ رأى شيبَ عارضي","بنفسي وما لي الآنس المتوحشُ",38,"ش",1,0],["توحيدُها التشبيهُ والتمثيل","ما إن لَهَا نَحْوَ الهُدَى سبيل",39,"ل",1,0],["توحّدت عندك الأهواء وانتبهت","مكارمُ كنّ أشتاتاً وقطعانا",40,"ن",2,0],["توحيد غرامك لي شرفٌ","والفضل إلى عبد الاحدِ",41,"د",1,0],["تُوحِشُني بَعْدَكَ الدِّيارُ كما","يُؤْنِسُ نَفْسي مَحلُّكَ البَلْقَعْ",42,"ع",1,0],["تُوَحِّدُ اللَهَ عَلى عَرشِهِ","في غَيبِهِ فَالأَمرُ لِلَّهِ",43,"ل",2,0],["توحيدنا إياه توحيد القُرآ","ن بذاته والفعل منه المعرفه",44,"ف",2,0],["توحّش مِن لَيلى الحِمى وَتَنَكّرت","مَنازِل لَيلى خَيمُها وَكَثيبُها",45,"ب",3,0],["توحي إليك بكل قصدٍ صالحٍ","حتّى تحقّق في الورى مرماها",46,"ا",3,0],["توحّل الناس في خدّيه حين بدا","نبات عارضه بالحُسن يسبيني",47,"ن",2,0],["توحيدكم إلهكم","فذاك عينُ شركنا",48,"ن",2,0],["توحيدُه للذي تراه","من نسب كلها أصول",49,"ل",1,0],["توحدتِ الأشياء إذ كنتَ عينَها","وما ثَمَّ إلا سامِعٌ ومكلِّمُ",50,"م",1,0],["توحدتُ سرّاً وهو أمر يخصُّني","وإني كثيرٌ بالتأمّل إعلانا",51,"ن",2,0],["تَوحِيدُ أتبَاعِ ابن سِينَا وَهُوَ مَن","سُوبٌ لآرسطُو مِنَ اليُونَانِ",52,"ن",1,0],["تَوحِيدُهُم أنَّ الإِلَهَ هُوَ الوُجُو","دُ المُطلَقُ المَبثُوثُ فِي الأعيَانِ",52,"ن",1,0],["تَوحِيدُهُم نَوعَانِ قَولِيٌّ وَفِع","لِيٌّ كِلاَ نَوعَيهِ ذُو بُرهَانِ",52,"ن",1,0],["توحيده نوعان علمي وقص","دي كما قد جرد النوعان",52,"ن",1,0],["توحي الى مزاياك الرفيعة ما","به ابذ بسوق الشعر مروانا",53,"ن",2,0],["توح