.poetsgate.com/ViewPoem.aspx?id=135394",""],[5213,"أشبه البدر طلعة وجمالا","https://www.poetsgate.com/ViewPoem.aspx?id=170532",""],[5277,"طيرُ الثماد","https://www.poetsgate.com/ViewPoem.aspx?id=191142",""],[5277,"نديانةُ العبق","https://www.poetsgate.com/ViewPoem.aspx?id=197752",""],[5307,"يا عويد البان","https://www.poetsgate.com/ViewPoem.aspx?id=10540",""],[5351,"الكرار من جديد","https://www.poetsgate.com/ViewPoem.aspx?id=202211",""],[5368,"في هدأة النجوى","https://www.poetsgate.com/ViewPoem.aspx?id=186518",""],[5376,"الشهد بالزهر ما ان نلت أحلاه","https://www.poetsgate.com/ViewPoem.aspx?id=188553",""],[5720,"عُدْ","https://www.poetsgate.com/ViewPoem.aspx?id=204381",""],[5732,"فات الشباب ولا بقى فيه لذات","https://www.poetsgate.com/ViewPoem.aspx?id=177834",""],[5785,"باهي المحيَّا شمس نصف النهار","https://www.poetsgate.com/ViewPoem.aspx?id=131580",""],[5790,"من منصفي منك يا ظلوم","https://www.poetsgate.com/ViewPoem.aspx?id=112131",""],[5830,"إِنَّ الوَصْلَ يُحْيِيكِ","https://www.poetsgate.com/ViewPoem.aspx?id=200823",""],[5861,"صرخة أم","https://www.poetsgate.com/ViewPoem.aspx?id=188056",""],[5943,"إنْ غابَ نجمي","https://www.poetsgate.com/ViewPoem.aspx?id=11265",""],[6008,"المكوك","https://www.poetsgate.com/ViewPoem.aspx?id=61067",""],[6031,"يا أَخَا هَاشِمَ أهْلا","https://www.poetsgate.com/ViewPoem.aspx?id=46348",""],[4442,"بشرى الأماني فقد زالت غواشيها","https://www.poetsgate.com/ViewPoem.aspx?id=171222",""],[6090,"البدر أشرق أم جبين سعيد","https://www.poetsgate.com/ViewPoem.aspx?id=170910",""],[6134,"يا بدر غب أسفاً عليها واخسف","https://www.poetsgate.com/ViewPoem.aspx?id=169579",""],[242,"مات الحفيظ فمن يحفظ من عاشا","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563799",""],[242,"أزف الرحيل فخانني صبري","http://www.aldiwanalarabi.com/poemDescription.do?poemId=563697",""],[572,"ياريمُ كمْ أدنو وأنتَ ترِيمُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9467&r=&rc=324",""]],"verses":[["يَا بَدْرَ تِمَّ يَهْتَدِي بِضِيَائِهِ","سَاري الفَلاَةِ وَلَيْلَتِي لَيْلاَءُ",0,"ا",2,0],["يا بَدرُ كُنتَ لَنا اليَمينَ وَما عَسى","تُغني إِذا مَضَت اليَمينُ يَسارُ",1,"ر",1,0],["يا بَدرُ ضاقَ بِكَ الضَريحُ وَطالَما","ضاقَت عَلى عَزَماتِكَ الأَقطارُ",1,"ر",1,0],["يا بَدرُ لَو أَبصَرتَ بَعدَكَ حالَنا","لَشَجاكَ ما جاءَت بِهِ الأَقدارُ",1,"ر",1,0],["يا بَدرُ عَمَّكَ بِالملاحَةِ خالُكَ الد","اجي فَخَصَّكَ بِالملاحَةِ وَاِجتَبى",2,"ب",2,0],["يا بَدرَ تِمٍّ بَدا في أُفقِ مَملَكَةٍ","فَراقَ مُطَّلِعاً مِن خَيرِ مُطَّلَعِ",3,"ع",1,0],["يَا بَدْرَ مِصْرَ وَمَا بَرِحَتْ هِلالَهَا","عَجَب تَمَامُكَ قَبْلَ آنِ تَمَامِ",4,"م",1,0],["يا بدرَ تِمٍّ في سماء خلافة","حفَّتْ نجومَ السعد هالةَُ قصرِه",5,"ر",2,1],["يا بدر حسَّادِي عليك كثيرة","والمسعدون على هواك قليل",6,"ل",1,0],["يا بَديعَ الدَلِّ وَالغُنجِ","لَكَ سُلطانٌ عَلى المُهَجِ",7,"ج",1,1],["يا بديعاً له البري","يَة بالحسن تشهدُ",8,"د",1,0],["يا بدرُ ما أسرعَ ما رابني","في وصلِكَ الدهرُ وما خانا",9,"ن",2,0],["يا بَدرُ إِن رُمتَ بِهِ","تَشَبُّهاً رُمتَ الشَطَط",10,"ط",1,0],["يا بَديعَ الحُسنِ وَالإِح","سانِ يا بَدرَ الدَياجي",11,"ج",2,1],["يا بَدرَ تَمَّ تَجَلّى","فَالأَرضُ تُشرِقُ مِنهُ",12,"ه",1,1],["يا بَدرُ يا بَحرُ يا عَمامَةُ يا","لَيثَ الشَرى يا حَمامُ يا رَجُلُ",13,"ل",1,0],["يا بَدرُ إِنَّكَ وَالحَديثُ شُجونُ","مَن لَم يَكُن لِمِثالِهِ تَكوينُ",14,"ن",1,1],["يا بَديعَ الحُسنِ وَالقَد","دِ بِهِ وَجدي بَديعُ",15,"ع",1,1],["يا بُدوراً تَغيبُ تَحتَ التُرابِ","وَجِبالاً تَمُدُّ مَرَّ السَحابِ",16,"ب",1,1],["يا بدرُ قل لي بعدَ بؤ","سِك كيفَ صافاكَ القدر",17,"ر",1,0],["يا بدرَ تمٍّ نورُهُ باهرُ","منزلُهُ في القلبِ والطرفِ",18,"ف",1,1],["يا بَديعاً بِلا شَبيهِ","وَيا حَقيقاً بِكُلِّ تيهِ",19,"ه",1,1],["يا بِدعَةً في مِثالٍ","لا مُدرِكاً بِالصِفاتِ",20,"ت",1,0],["يا بَديعَ الجَمالِ وَالحُسنِ وَالدَل","لِ حَياتي وَميتَتي في يَدَيكَ",21,"ك",1,0],["يا بَدَويَّ اِتَّقِ المُدامَةَ إِنَّ ال","خَمرَ باتَت كَثيرَةَ الأُبَنِ",22,"ن",1,1],["يا بَديعَ الحُسْنِ كم لي","فيكَ مِنَ وَجْدٍ بَديعِ",23,"ع",1,0],["يا بُدُوراً أنابَها الد","دَهْرََ عانٍ أسِيرُ",24,"ر",1,0],["يَا بَدْرَ ظُلْمَتِها يَا شَمْسَ صُبْحَتِها","يَا لَيْثَ حَوْمَتِها إِنْ هائِجٌ هاجا",25,"ج",2,0],["يا بدرَ فضلً تم حيناً نوره","فأصابه عند التمام محاق",26,"ق",1,0],["يا بدر يا بحر يا غمامة يا","ليث الشرى يا حمام يا رجل",27,"ل",1,0],["يا بَدْرُ سُمِّيت بدْراً","وَأَيْنَ مِنْكَ البُدُورُ",28,"ر",1,0],["يَا بَدِيعَ الْفنِّ وَالآ","دَابِ وَالأَخْلاَقِ شُكْرَا",29,"ر",2,1],["يا بَدرُ كُنتَ مُنيراً","حَتّى مَحاكَ السّرارُ",30,"ر",1,0],["يا بدرَ التّمِّ نكحتَ الشَّمْ","سَ فذاك بُنيّك فَرْقَدهُ",31,"د",2,0],["يا بديعَ الجمالِ في كلِّ حالٍ","وغريبَ الكمالِ في كل فَنِّ",32,"ن",1,0],["يا بدر، أنت ابنت القرى، وأراك في","ليل الحواضر -إن طلعت- غريبا",33,"ب",2,0],["يا بدر هذا الشعب أنت زعيمة","وهواك سحر غرامة المتعسّر",34,"ر",1,0],["يا بدر إن واصلتنى بالجفا","ومت فى شرخ الصبا مغرمك",35,"ك",1,0],["يا بدرَ داجيةِ الخطوبِ ونورِها","أعزِزْ بانَّكَ غبتَ لا لِطلوع",36,"ع",1,0],["يا بداياتي . يا مائي . يا أكسجيني","يا أندثاري . يا أعتدالي . يا أزدهاري",37,"ر",2,0],["يا بَدِيع الحُسنِ والقَدِّ","،بهِ وَجدِي بَديعُ",38,"ع",1,1],["يا بدر طال هجري","اكفف عن المطال",39,"ل",1,0],["يا بَدْرُ بادِرْ إِلَيَّ بالكاسِ","فَرُبَّ خَيْرٍ أَتى عَلى يَاسِ",40,"س",1,1],["يا بَدرُ بِالبَدرِ الَّذي","أطلعتَ من فَلك الجيوبِ",41,"ب",1,0],["يا بدرَ تِمٍّ بالجمالِ تَبَرْقَعا","وقضيبَ بانٍ ماسَ لما أنْ سَعَى",42,"ع",2,1],["يا بديع الجمال مالك لا تف","عل مع من يهواك فعلا حميلا",43,"ل",2,0],["يا بدرُ بلغهُ سلامي وقفْ","واشرحَ لهُ ما أحدثَ العاذلونْ",44,"ن",1,0],["يا بدرُ لا تكمدْ وفيكَ ضنى","لكَ أسوةٌ بالجفنِ والخصرِ",45,"ر",1,0],["يا بدرُ كانتْ ليلةً ومضتْ","وقعَ العصافيرِ على الغُدرِ",45,"ر",1,0],["يا بديع الزمان في كل فن","وامام الانشاء في كل عصر",46,"ر",1,1],["يابَدرُ إِنَّ البَدرَ يَنقُصُ نورُهُ","وَضِياءُ وَجهِكَ دائِماً يَزدادُ",47,"د",1,0],["يَا بُدوراً لَسْتُ عَنْهَا بِصَاحْ","مَا لِقَلْبِي عن هَواكُمْ بَراحْ",48,"ح",1,1],["يَا بَدْرُ رَكْبُكَ زَلَّعُوا كَبِدِي","يَا بَدْرُ رَكْبُكَ صَدَّعُوا صَدْرِي",49,"ر",2,0],["يَا بَدْرُ رَكْبُكَ أَضْرَمُوا حُرَقِي","يَا بَدْرُ رَكْبُكَ شَرَّدُوا صَبْرِي",49,"ر",2,0],["يَا بَدْرُ رَكْبُكَ هَيَّجُوا ضَُرِّي","يَا أَصْلَ نُورِ الشَّمْسِ وَالْبَدْرِ",49,"ر",1,0],["يَا بَدْرَ مَجْدٍ لَوْ أَنَّ اللهَ أَنْسَأَهُ","مَا أَدْهَشَتْنَا صُرُوفُ الدَّهْرِ إِدْهَاشَا",50,"ش",2,0],["يا بَدرُ عُذّالي عَلَيكَ كَثيرَةٌ","وَالمُسعِدون عَلى هَواكَ قَليل",51,"ل",1,0],["يا بدر يا بدر التمام","بك أشرقت خلع الإمام",52,"م",1,1],["يا بديع الحسن يا من","بسناه لا يشارك",53,"ك",1,0],["يا بديع الجمال جرت علينا","الأمانَ الأمانَ من فتكاتك",54,"ك",1,0],["يا بدرُ ما أبهاكَ في كدَري وما","أشهاكَ في سمَري مع الحسناء",55,"ا",2,0],["يا بدرُ كم أرعاكَ والغبراءُ قد","سَكنت وقلبي واسعٌ كفضاء",55,"ا",2,0],["يا بَدرَ تمٍّ لَيسَ لي","مِنهُ سِوى رَعي النُجومِ",56,"م",1,1],["يا بَدرَ تَمامٍ مَطلِعُهُ","بِسَوادِ القَلبِ فَلَم يَغِلِ",57,"ل",1,0],["يا بَدَوِيّاً يَعتَزي","إِلى عُبَيدِ بنِ مِرا",58,"ر",2,0],["يَا بَدْرَ لَيْلٍ تَوَسَّطَ الفَلَكا","ذِكْرُكَ في القَلْبِ حَيْثما سَلكا",59,"ك",2,1],["يا (بدر) دعوة معمودٍ أضرَّ به","هجرٌ ويجزيكَ عني بارئُ النسم",60,"م",1,0],["يا بدرَ تم له دونَ البرية في","أهلةِ اللثم لا في السحب هالاتُ",61,"ت",1,1],["يا بَدعَ الزَمانِ يا نُخبَةَ العَص","رِ وَنورِ الهُدى وَرَبِّ المَعاني",62,"ن",2,1],["يا بديع الجمال أطلق من الق","يد ذكاء إلى الشقي الطريد",63,"د",1,0],["يا بدر فاشهد سر دفنهم","وتساقطي من فوق يا شهب",64,"ب",1,0],["يا بَدر لا غبت لَم تَبرَح تَميس بِها","عمَّ الدِيار وَعَمَّ السَهل وَالجَبَلا",65,"ل",2,0],["يا بَدر حُسنٍ بِالكَمال قَد اِنجَلى","اِرحَم كَئيباً بِالمحاقِ قَد اِختفى",66,"ف",2,0],["يا بَدر إِن قيل بِما جُرَّ قُل","مُؤرّخاً جُرّ بِلام العذار",67,"ر",1,0],["يا بَدر آفاق المَعالي وَمَن","زانَ علاه كُلّ وَصف حَميد",68,"د",1,1],["يا بَدر أَما قَد كَفاكَ شاهِد سَقمى","وَالمَدمَع حَتّى قَضيت في بهجران",69,"ن",1,0],["يا بَدر تَمَّ بَل وَحقك","أَنتَ عِندي أَعظَم",70,"م",1,0],["يا بَديع الزَمان حسنا وَمَعنى","وَمَقاما حَكى الزَمان وَشِعرا",71,"ر",2,0],["يا بَدرُ حَتّى أَنتَ في","ها لا يَتِمُّ لَكَ التَمامُ",72,"م",1,0],["يا بَد تَمٍّ جَلا لي ظُلمة السدف","يا مَن تَنَزَه عَن نَقص وَعَن كَلَف",73,"ف",1,0],["يا بَدر تَمٍّ أَجَل اللَهُ صورَتَهُ","عَن الخُسوف وَعَن نَقض وَعَن كَلف",74,"ف",1,0],["يا بَدرَ آفاقِ الجَما","ل وَعَينَ أَرباب الكَمال",75,"ل",1,0],["يا بَديع الجَمال ما كانَ بَدعاً","لَو وَصلت المُحب يَوماً وَأَنى",76,"ن",2,0],["يا بدر نظمك وافاني فأسكرني","أظنه خمرة من كرم رحبان",77,"ن",1,0],["يا بدر دين اللّه أفديك لقد","حملتني ما لم أطق لحمله",78,"ل",2,1],["يا بدوراً في حالكٍ مكفهرّ","شَتَّتْ شملَهُم وكانوا حماة",79,"ه",1,0],["يا بَدْرَ تِمٍّ بأٌفق المجد مطلعه","من قال إنَّك بَدْرُ التِمِّ ما كذبا",80,"ب",2,0],["يا بدرُ ما نالَ الأُفولُ","مناه منك ولا الغروب",81,"ب",1,0],["يا بدر علمِ ضاءَ في بدر العلى","شرفاً يقصر عن مداهُ الواصفُ",82,"ف",1,1],["يا بدر المجد لقد وافت","عذراء لمربعك الأزهر",83,"ر",1,0],["يا بدْرَ تِمٍّ قد غدَتْ","رُقَباؤه عددَ النجومِ",84,"م",1,0],["يا بدرُ هذي الشمسُ مه","داةٌ إليكَ نِكحا",85,"ح",2,0],["يا بدرَ عَوْفٍ وعوفُ الشمسُ في أَسَدٍ","وأَسَدٌ شامةٌ بيضاءُ في العربِ",86,"ب",1,0],["يا بدورَ الخدود ما عفتمً طر","فيَ إلاَّ من كثرة الأنواءِ",87,"ا",2,0],["يا بَدرَ تَمٍّ إِن لاحَ أَو بَدَرا","وَغُصنَ بانٍ إِن ماسَ أَو خَطَرا",88,"ر",2,1],["يا بَدرَ تَمٍّ مُحَيّاهُ تَحِيَّتُهُ","وَغُصنَ بانٍ تُهاديهِ هَدِيَّتُهُ",89,"ت",2,1],["يا بدرَ دجًى لم يبدُ لنا","اِلاّ وغَنِيتُ عنِ القمرِ",90,"ر",1,0],["يا بدر قف نحيى بوصلة ساعة","يا شرب ذي لغرامنا مفتاح",91,"ح",1,0],["يا بديعاً فاقَ الورى وأديباً","رقّ طبعاً وراقَ فيه زمانُه",92,"ن",2,0],["يا بدر والبدر المنير عبارة","عن نور وجهك لم يزل لك مسفرا",93,"ر",2,0],["يا بَدْرَ قَدْ أطْلَعْتَ في فَلَكِ العُلَى","شُهُباً مِنَ الدُّرِّ النَّظِيمِ نِظامُهُ",94,"م",2,1],["يا بَدْرُ دُمْتَ لِكُلّ مَا","يَعْني عَلَى فِكْري وُرُودُهْ",95,"د",2,0],["يا بديع الجمال بالعشق منا","قد شغلت القلوب والأفواها",96,"ا",3,0],["يا بديع الحسن بالصورِ","جئتنا في هيكل البشرِ",97,"ر",1,1],["يا بدرَ نورٍ في بياضِ تَمامهِ","جَلَبَ الخُسوفَ عليه يومٌ أسوَدُ",98,"د",1,0],["يَا بَدْرَ هَاشِمٍ الَّذِي مِنْ بِيْنِهِمء","أَضْحَى لَهُ التَّفْضِيْلُ وَالتَّقْدِيْمُ",99,"م",1,0],["يا بدرَ داجِيةٍ وشمسَ ظهيرةٍ","وقضيبَ كُثبانٍ وريمَ بطاحِ",100,"ح",1,0],["يا بدرُ إِن كنتَ تشكو في الظَّلام أ