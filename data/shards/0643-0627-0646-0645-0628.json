{"poems":[[52,"سلم على الدار بذي تنضب","https://www.aldiwan.net/poem64870.html","السريع"],[164,"في لحظ عينيه سكر من رحيق فمه","https://www.aldiwan.net/poem58995.html","البسيط"],[302,"سرت نفحة من حيهم بسلام","https://www.aldiwan.net/poem33168.html","الطويل"],[385,"إذا ما نسيم الريح من نحوكم أسرا","https://www.aldiwan.net/poem48830.html","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96734","البسيط"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96603","البسيط"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112889","الطويل"],[1743,"","https://poetry.dctabudhabi.ae/diwan/poem/17659","الطويل"],[2565,"","https://poetry.dctabudhabi.ae/diwan/poem/103764","الرمل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/76029","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74161","البسيط"],[5582,"لِمَنْ بِسِقْطِ اللِّوَى وَالمُنْحَنَى طَلَلُ","https://www.poetsgate.com/ViewPoem.aspx?id=187219",""],[5582,"شاقَتْكَ هِنْدٌ وَأَمْسَى الحَبْلُ مُنْصَرِمَا","https://www.poetsgate.com/ViewPoem.aspx?id=63568",""]],"verses":[["كَأَنَّ مَبعوثاً عَلى بابِهِ","يُدني وَيُقصي ناقِداً يَجتَبي",0,"ب",2,0],["كأن مبسمه من عقد جوهره","وعقد جوهره من در مبتسمه",1,"م",2,0],["كأَنَّ مبانيها مباسمُ غادةٍ","نضَت عن لآليها فضولَ لثامِ",2,"م",1,0],["كانّ مبادي الصُبح ذَيل غِلالُهُ","قَد اِنغَمَسَت في أَدمُعي فَبَدَت حمرا",3,"ر",2,0],["كأنّ مَبسمها أسنانهُ بردٌ","أَو لؤلؤٌ مِن نفيسِ الدرِّ مكنونُ",4,"ن",1,0],["كأنّ مَبسمها درّ وَريقتها","ماءٌ منَ المزنِ صبّت فيه صهباءُ",5,"ا",2,0],["كأن مبانيها لاجلك سيدي","كواكب في جو السماء تنير",6,"ر",1,0],["كَأَنَّ مُبيتاً مِن ثَمانٍ مِنَ القَطا","مُناخُهُما يَنفي الحَصى كَلكَلاهُما",7,"م",2,0],["كان مبهوتا فلما","نفخت فيه تكلم",8,"م",1,0],["كَأَنَّ مَبسِمَها ميمٌ وَناظِرَها","صادٌ عَلَيها لِنونِ الحُسنِ تَعريقُ",9,"ق",1,0],["كَأَن مَبدأه مِن عَين مختمه","يا طيب مبتدأ مِنهُ وُمختتم",10,"م",1,0],["[ كأَنَّ مَبْسِمَها الدُّرِّيَّ إِنْ بَسَمَتْ","فِي الحُسْنِ زَهْرُ أَقاحٍ رائِقٌ خَضِلُ ]",11,"ل",1,0],["كأَنَّ مَبْسِمَها فِي حُسْنِهِ دُرَرٌ","مَنْظُومَةٌ وَأَقاحٌ راقَ غِبَّ سَما",12,"م",2,0]]}