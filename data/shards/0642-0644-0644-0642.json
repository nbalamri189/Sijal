{"poems":[[53,"أعقب القرب من حبيبك شحط","https://www.aldiwan.net/poem65005.html","الخفيف"],[93,"أيهذا الشاكي وما بك داء","https://www.aldiwan.net/poem62667.html","عموديه"],[87,"أيها المنتحي بأسوان دارا","https://www.aldiwan.net/poem63710.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85538","الخفيف"],[74,"","https://poetry.dctabudhabi.ae/diwan/poem/40975","الخفيف"],[108,"في مهرجان الوليد","https://www.poetsgate.com/ViewPoem.aspx?id=179778",""],[136,"ما للشجى على برح الغرام يد","https://www.aldiwan.net/poem54853.html","الطويل"],[164,"منكر رقص عاقد الطيلسان","https://www.aldiwan.net/poem59204.html","الخفيف"],[193,"سيد الرسل قدره معلوم","https://www.aldiwan.net/poem35108.html","الخفيف"],[463,"قد قنعنا أن نرقب الأحلاما","https://www.aldiwan.net/poem55874.html","الخفيف"],[543,"طال مني لذا النهار ارتقابي","https://www.aldiwan.net/poem48296.html","عموديه"],[556,"قل لقوم شنوا المعاتب منهم","https://www.aldiwan.net/poem47170.html","الخفيف"],[556,"قد مضى شهر الصيام","https://www.aldiwan.net/poem47208.html","مجزوء الرمل"],[556,"قل لقوم لا أبالي","https://www.aldiwan.net/poem47239.html","مجزوء الرمل"],[556,"قل لقوم ما لكم في","https://www.aldiwan.net/poem47300.html","مجزوء الرمل"],[556,"يا خليلي ومعيني","https://www.aldiwan.net/poem47735.html","مجزوء الرمل"],[556,"يا ديار الأحباب كيف تحولت","https://www.aldiwan.net/poem47800.html","الخفيف"],[563,"قل لقوم غصبوا أنفسهم","https://www.aldiwan.net/poem33775.html","الرمل"],[596,"","https://poetry.dctabudhabi.ae/diwan/poem/2468","الخفيف"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70742","السريع"],[1184,"","https://poetry.dctabudhabi.ae/diwan/poem/56214","الرمل"],[1361,"","https://poetry.dctabudhabi.ae/diwan/poem/104407","السريع"],[1895,"","https://poetry.dctabudhabi.ae/diwan/poem/74992","الخفيف"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71051","الخفيف"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75943","الخفيف"],[2789,"","https://poetry.dctabudhabi.ae/diwan/poem/21612","الخفيف"],[2898,"","https://poetry.dctabudhabi.ae/diwan/poem/58360","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200708","الخفيف"],[3090,"","https://poetry.dctabudhabi.ae/diwan/poem/65133","الخفيف"],[3437,"","https://poetry.dctabudhabi.ae/diwan/poem/102029","الخفيف"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32820","الخفيف"],[3888,"","https://poetry.dctabudhabi.ae/diwan/poem/103575","الرمل"],[3937,"","https://poetry.dctabudhabi.ae/diwan/poem/40121","الرمل"],[556,"ياخليلي ومُعِيني","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=24272&r=&rc=11",""]],"verses":[["قُل لقوم وسمتُهُم بهجاء","لمكاويه في السَّوالف عَلطُ",0,"ط",1,0],["قُل لِقَومٍ يَستَنزِفونَ المَآقي","هَل شُفيتُم مَعَ البُكاءِ غَليلا",1,"ل",2,0],["قُل لِقَومٍ عَلى الوِلاياتِ أَيقا","ظٍ إِذا ذاقَتِ البَرِيَّةُ غُمضا",2,"ض",2,0],["قل لقوم قد طأطأوا بعد كبرٍ","أَين ذاكَ الهوى وَذاك الغرور",3,"ر",1,0],["قل لقاضٍ من صنعه عزلوه","وهو بالعودِ طامع متقاضي",4,"ي",1,1],["قل لقومي: دوَّي الأذانُ، فهبُّوا","من سُباتٍ، واستيقظوا من رقود",5,"د",1,0],["قَل لِقرىءٍ رَامَ فِآ شَاوٍ مُسَابَقَتِى","لا يَغرُرَنَّكَ دَاءُ الجَهلِ والحَسدُ",6,"د",1,0],["قل لقاضي القضاة يا ملك العصر","جميعا ونور عين الزمان",7,"ن",1,0],["قُل لِقومٍ ضلّت لديهم عقول","كلُّ أصحابهِ هداةٌ قرومُ",8,"م",1,0],["قل لقوم عدُّوا الغنى كلَّه البخ","لَ وعدُّوا السماحةَ الإِعداما",9,"م",2,0],["قُل لقَومٍ عَليهمُ أشكل الأم","رُ فظنُّوا السَّراب ماءَ شَرَابِ",10,"ب",1,0],["قل لقومٍ شنّوا المعاتبَ منهم","في الأحاديث شَأْمَةً ويمينا",11,"ن",2,1],["قل لقومٍ غرّه من","ه تَغاضٍ وتحامِ",12,"م",1,0],["قل لقومٍ لا أُبالي","فيهمُ مَن ذا ألومُ",13,"م",1,1],["قلْ لقومٍ ما لكمْ في","ما قضى الرّحمن حِيلَهْ",14,"ل",2,1],["قلْ لقومٍ لم يزالوا","في الجهالاتِ رُبوضا",15,"ض",2,0],["قُل لِقومٍ بنوا بغيرِ أَساسٍ","في ديارٍ ما يملكون مَنارا",16,"ر",2,0],["قل لقوم غصبوا أنفسهم","في يد الله وهم لا يعلمون",17,"ن",1,1],["قُل لِقَندٍ يُشَيِّعُ الأَظعانَ","طالَ ما سَرَّ غَيبَنا وَكَفانا",18,"ن",2,0],["قلْ لقليلِ الشكرِ في دهرنا","مَنْ كفَرَ النعمة ذاق الوبال",19,"ل",1,0],["قل لقد غادرتهُ قد عُدما","بعدكم لذة طيب النعسِ",20,"س",1,0],["قل لقريب الدار في بعده","ما باله قد حال عن عهده",21,"د",2,1],["قل لِقَلبي اصبر عَلى كل هول","وَلِعَيني تساعد الأقدارا",22,"ر",2,0],["قُلْ لقومٍ خانوا العُهودَ وَبتَّوا","حَبْلَ تلك العُقود والأَيْمانِ",23,"ن",1,0],["قُل لِقاضي القُضاة شَيخِ البَرايا","يا إِماماً حَوى الفَرائدَ طُرّا",24,"ر",2,1],["قُل لِقَومي لَدى الأَباطِحِ مِن آ","لِ لُؤَيِّ بِنِ غالِبٍ ذي الجودِ",25,"د",1,0],["قُل لِقاضي الفُسوقِ والإدبارِ","عَضُدِ البُلهِ عُمْدَةِ الفُجّارِ",26,"ر",1,1],["قلْ لقوم تصنّعوا الفن لمّا","مات منهم شعورهم والضمير",27,"ر",1,1],["قلُ لقوم بجهلهم خالفوهُ","فيم سُوءُ الخلاف ذا وعلامه",28,"م",2,0],["قل لقومي نصيحة من خبير","محكم الرأي لا يطيش حجاه",29,"ا",2,0],["قُل لِقَومٍ ما فيهِمُ مِن رَشيدِ","لا وَلا فَوقَ بُخلِهِم مِن مَزيدِ",30,"د",1,1],["قل لقوم لا يتوبون","وعلى الإثم يصّرون",31,"ن",1,1],["قُلْ لقومٍ غَرَّهُم إمهالُهُ","سَتَذوقونَ شَذاهُ بَعدَ حين",32,"ن",1,0],["قل لقومٍ لم يزالوا","لُ فتى ً يُلفَى جَريضا",33,"ض",2,0]]}