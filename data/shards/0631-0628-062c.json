{"poems":[[91,"جف روض المنى وشح الربيع","https://www.aldiwan.net/poem44612.html","الخفيف"],[87,"مرحبا بالربيع في ريعانه","https://www.aldiwan.net/poem62943.html","الخفيف"],[107,"يا بريد النيل إن جئت الشآما","https://www.aldiwan.net/poem42115.html","الرمل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/202528","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54704","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54204","الخفيف"],[92,"عريانة!","https://www.poetsgate.com/ViewPoem.aspx?id=179125",""],[113,"من أي مولى ارتجي","https://www.aldiwan.net/poem16183.html","مجزوء الرمل"],[193,"نورك الكل والورى أجزاء","https://www.aldiwan.net/poem35276.html","الخفيف"],[197,"رب جنين من جنى النمير","https://www.aldiwan.net/poem13053.html","الرجز"],[226,"من طريف الآثار والأخبار","https://www.aldiwan.net/poem55284.html","الخفيف"],[228,"إجرح القلب واسق شعرك منه","https://www.aldiwan.net/poem39702.html","الخفيف"],[255,"سار والقلب في يديه مقيم","https://www.aldiwan.net/poem15026.html","الخفيف"],[303,"نفخ الصور فهبوا مسرعين","https://www.aldiwan.net/poem36856.html","عموديه"],[333,"يا نديم الصباح أترع كئوسك","https://www.aldiwan.net/poem55031.html","الخفيف"],[514,"كل شيءٍ مصيره للزوال","https://www.aldiwan.net/poem744.html","الخفيف"],[543,"صنعة الشعر لقد عافتك","https://www.aldiwan.net/poem47428.html","عموديه"],[563,"رؤية الحق رؤية الأغيار","https://www.aldiwan.net/poem33550.html","الخفيف"],[593,"","https://poetry.dctabudhabi.ae/diwan/poem/107092","الرجز"],[668,"","https://poetry.dctabudhabi.ae/diwan/poem/139003",""],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120048","الخفيف"],[2173,"","https://poetry.dctabudhabi.ae/diwan/poem/142787","الخفيف"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53227","الخفيف"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77301","الرمل"],[2365,"","https://poetry.dctabudhabi.ae/diwan/poem/34713","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/205045","الخفيف"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86291","الرمل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133225","الخفيف"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111521","الخفيف"],[4126,"","https://poetry.dctabudhabi.ae/diwan/poem/126340","الرمل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83578","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83382","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83407","الخفيف"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83528","الخفيف"],[4661,"","https://poetry.dctabudhabi.ae/diwan/poem/52131","الرمل"],[4717,"رثاء مصطفى القاسم","https://www.poetsgate.com/ViewPoem.aspx?id=199669",""],[4915,"غيبوبة !","https://www.poetsgate.com/ViewPoem.aspx?id=212763",""],[5155,"موكب الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=176566",""],[5186,"رب خير يولى ولا من بشير","https://www.poetsgate.com/ViewPoem.aspx?id=156485",""],[5409,"هكذا من حقه من نام ضاعا","https://www.poetsgate.com/ViewPoem.aspx?id=155288",""],[5550,"أضاع الغنى","https://www.poetsgate.com/ViewPoem.aspx?id=213740",""],[5956,"ليس بالتعداد قدْر الأمم","https://www.poetsgate.com/ViewPoem.aspx?id=193584",""]],"verses":[["رب جيل يردي فتوطأ بالأق","دام منه جماجم وضلوع",0,"ع",1,0],["رُبَّ جارٍ تَلَفَّتَت مِصرُ تولي","هِ سُؤالَ الكَريمِ عَن جيرانِه",1,"ن",2,0],["رُبَّ جيشٍ بات يقظانَ القَنَا","ساهِرَ الأسيافِ يخشَى أن تُراما",2,"م",2,0],["ربَّ جديدٍ عنده المعوَّل","وربَّ كنزٍ لم يثره الأول",3,"ل",1,0],["رُبَّ جَمْعٍ وَقَفْتَ فِيهِ خَطِيباً","أَنْصَتَتْ فِي صُدُورِهِ الأَكْبَادُ",4,"د",1,0],["رُبَّ جَيْشٍ من الْحَديدِ تَوَلَّى","واجِفَ القلبِ مِن حَديدِ اللِّسانِ",5,"ن",1,0],["رُب جسمٍ تُطرى الملاحةُ فيه","ثم تَعدوه مُطرياً فُستانه",6,"ن",2,0],["رَب جَواد لَم يَزَل","مِن كُل ضيقٍ مَخرَجي",7,"ج",2,0],["ربَّ جدبٍ قَد جرّد النبتَ فالأر","ضَ منَ الجدبِ ناقةٌ جرباءُ",8,"ا",2,0],["رُبَّ جَنينٍ مِن جَنى النَميرِ","مُهَتّكِ الأَسرارِ وَالضَميرِ",9,"ر",1,1],["رب جمع من اللدات رأينا","ه كسرب يرف من أطيار",10,"ر",1,0],["رُبَّ جُرحٍ قَد صارَ يُنبوع شِعرٍ","تَلتَقي عِندَهُ النُفوسُ الظَوامي",11,"ي",1,0],["رَبُّ جودٍ للقاصدين لمغنا","هُ جِنَانٌ فيها نعيمٌ مقيمُ",12,"م",1,0],["ربّ جدٍ كامنٍ طيّ مجونْ","وكبير مبتداه من صغير",13,"ر",1,0],["رب جمرٍ يا أخت يطفأ بالجمر","وحي يحيا بكاس المنيّه",14,"ه",1,0],["رُبَّ جَيشٍ لَقيتُهُ يَمطُرُ المَو","تَ عَلى هَيكَلٍ خَفيفِ الجِلالِ",15,"ل",1,0],["رُبَّ جودٍ رُبَّ مَجدٍ","رُبَّ حَسمٍ رُبَّ رَحمِ",16,"م",1,0],["رب جسم ورب نفس وروح","واحد والخلاف بالإعتبار",17,"ر",1,0],["رب جمال نحن من","جنوده عز وجل",18,"ل",1,0],["رب جزارٍ هواه","صار لي دماً ولحما",19,"م",2,1],["رب جود غض إذا اخلق ال","جود وغاضت مكارم الأخلاقِ",20,"ق",1,0],["رُبَّ جهلٍ أَدنى إلى النُّجْحِ مِنْ حِلْ","مٍ إذا ما أَعانَهُ التَّوفيقُ",21,"ق",1,0],["رب جود تشكو خزائنه الإس","راف في ماله إلى خزانه",22,"ن",2,0],["رُبَّ جَيشٍ كُتِبَ الظَفرُ لَهُ","أَعزَلٍ إِلا مِنَ الحَقِّ المُبين",23,"ن",1,0],["رُبَّ جُبنٍ مِنها وَزُبدٍ طَرِيٍّ","قَد جَمَعنا طَرِيَّهُ لِسِلاءِ",24,"ا",2,0],["رُبَّ جَدي قَد أَطَعمتَنا السُوَي","داءُ قَديراً وَأَعقَبَت لِشِواءِ",24,"ا",2,0],["رب جرو ربّاه قدماً غنيٌ","فقضى في حماه عهد الشباب",25,"ب",1,1],["رَب جود منعِم ذو رَحمَة","لَم يَخَب فيه لَقصاد امل",26,"ل",1,0],["رب جمل بفيض فضلك حالي","وعلى ما ترضاه منّى أعنّى",27,"ن",2,0],["رب جارٍ أصابه ببلاءٍ","وهو لا عون صد عنه المصابا",28,"ب",2,0],["ربّ جود طهَّرت منهُ الدما","كلَّ مختارٍ لهُ من دنسِ",29,"س",1,0],["ربَّ جفنٍ إِطباقُهُ كانَ حِلماً","فَإِذا اِهتَزَّ هَزَّ سَبعَ الطباقِ",30,"ق",1,0],["رَبِّ جُد لي بِرَحمَةٍ مِنكَ تُطفي","غِلَّتي عاجِلاً وَمُنَّ بِلُطفِ",31,"ف",1,0],["رب جُد لي بتوبَةٍ منك تمحو","كُلّ ذنبٍ أذنبتهُ في حَياتي",32,"ت",2,1],["رَبِّ جُد لي بعودَةٍ لِدِيارٍ","هِيَ فيها بِالروحِ وَالجُثمانِ",33,"ن",1,0],["ربُّ جاهٍ وغنىً صعب المنالْ","مذ رأَى إِلا بنة من أهل الجمالْ",34,"ل",1,0],["ربِّ جُدْ وارحمْ منْ قَضَى واعفُ عَنْهُ","وتَجاوَزْ عمَّا سَهَى أوتَجَنَّى",35,"ن",2,0],["رُبَّ جنيَّةٍ رآها كهيفا","جاهلٌ فانثنى يُقبِّلُ فاها",36,"ا",3,0],["رب جو من الخيال غريب","لم تعانق نجومه الشعراء",37,"ا",2,0],["رب جهل أجدى بقلب كبير","رب علم أودى برأس صغير",38,"ر",1,0],["رب جرحٍ كان سهلاً برؤه","قبل أن يستفحل الجرح اتساعا",39,"ع",2,0],["رُبَّ جِسْمٍ مثْل الجِبال قَوَيٍّ","صار بالهمِّ والأسَى كالخَراب",40,"ب",1,0],["رُبَّ جزار وحيدٍ ذابحٍ","ألف رأس من رؤوس الغنمِ",41,"م",1,0]]}