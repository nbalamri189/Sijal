{"poems":[[53,"وقصير تراه فوق يفاع","https://www.aldiwan.net/poem8647.html","الخفيف"],[53,"ألا قل لنحويك الأخفش","https://www.aldiwan.net/poem64923.html","المتقارب"],[87,"على منازل غالي","https://www.aldiwan.net/poem7249.html","المجتث"],[68,"ظفرت سهام فواتر الألحاظ","https://www.aldiwan.net/poem38485.html","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43844","البسيط"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43646","الطويل"],[119,"أهيم بخود عندها القلب قد فنى","https://www.aldiwan.net/poem41648.html","الطويل"],[154,"تزودت من مدح النبي المؤيد","https://www.aldiwan.net/poem68589.html","الطويل"],[411,"إذا مدح الأقوام قرما بسؤدد","https://www.aldiwan.net/poem49811.html","الطويل"],[463,"تغرب فبالدار الحبية دار","https://www.aldiwan.net/poem56195.html","الطويل"],[563,"ظن الجهول بأنه مستيقظ","https://www.aldiwan.net/poem33543.html","الكامل"],[572,"يا رب مهد هدية لطفت","https://www.aldiwan.net/poem69550.html","المنسرح"],[580,"أضحى هلالاً بدر ذاك النادي","https://www.aldiwan.net/poem2962.html","الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56697","الكامل"],[1269,"","https://poetry.dctabudhabi.ae/diwan/poem/122846","الوافر"],[2211,"","https://poetry.dctabudhabi.ae/diwan/poem/121907","الوافر"],[2396,"","https://poetry.dctabudhabi.ae/diwan/poem/146665","السريع"],[2624,"","https://poetry.dctabudhabi.ae/diwan/poem/84527","الكامل"],[2705,"","https://poetry.dctabudhabi.ae/diwan/poem/128658","المتدارك"],[3170,"","https://poetry.dctabudhabi.ae/diwan/poem/115116","الطويل"],[3362,"","https://poetry.dctabudhabi.ae/diwan/poem/31666","المنسرح"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/88932","الكامل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129498","الكامل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131981","المتقارب"],[3859,"","https://poetry.dctabudhabi.ae/diwan/poem/114274","الطويل"],[4226,"","https://poetry.dctabudhabi.ae/diwan/poem/94324","الطويل"],[4588,"","https://poetry.dctabudhabi.ae/diwan/poem/104916","الخفيف"],[4602,"","https://poetry.dctabudhabi.ae/diwan/poem/120300","الكامل"],[5206,"السلامة في الدنيا","https://www.poetsgate.com/ViewPoem.aspx?id=187360",""],[5206,"غابة الغرايب","https://www.poetsgate.com/ViewPoem.aspx?id=187358",""],[2365,"ظربت وشاقتك البروق اللوامع","https://www.poetsgate.com/ViewPoem.aspx?id=200652",""],[2110,"ظن المتيم قد سلا فاغتاظا","https://www.poetsgate.com/ViewPoem.aspx?id=156279",""],[5850,"نظرتُ وسهبٌ من بوانة َ بيننا","https://www.poetsgate.com/ViewPoem.aspx?id=19710",""],[5956,"بين تنمية أطفالي وبين ذبولي","https://www.poetsgate.com/ViewPoem.aspx?id=182406",""],[6223,"طارقة السحر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1216&r=&rc=1",""],[572,"يا رُبَّ مُهْدٍ هَدِيَّة ً لَطُفَتْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9443&r=&rc=300",""]],"verses":[["ظَرُف الدهرُ في اتخاذك صَفْعا","ناً وما خلْتُهُ ظريفَ الدُّعابَهْ",0,"ب",2,0],["ظريفٌ وفي الظُرف مستأنسٌ","وفي الجهل موضعُ مستوحش",1,"ش",1,0],["ظرف النواسىّ لكن","في ثابت كالجبال",2,"ل",1,0],["ظَرُفَت خَلائِقُهُ وَأَحفَظَ مالَهُ","فَأَضاعَهُ رُغماً عَلى الحُفّاظِ",3,"ظ",1,0],["ظُرّانُ أَرضِكَ لِلسَماءِ قَدِ اِغتَدَت","بِكَ في مُفاخَرَةٍ وَفَرطِ غِياظِ",3,"ظ",1,0],["ظُرفُ أَبيهِ عَلَيهِ يَبدو","وَاللَفظُ وَالحِفظُ وَالحِفاظُ",4,"ظ",1,0],["ظَريُهُم خَرَّ حَيثُ شَتّوا","فَقظتُ مِن زَفرَتي وَقاظوا",4,"ظ",3,0],["ظِرافٌ لَعَمري العاشِقونَ وَإِنَّما","يَلومُهُمُ قاسي الفُؤادِ غَليظُ",5,"ظ",1,0],["ظريفة طبع زاد فيها تفنني","ولعت بها قبل الرضاع وإنني",6,"ي",1,0],["ظِرابُ نَواحي يَثرِبٍ وَبِطاحُها","مُنايَ وَهَل يَحظى بها غَيرُ مَن أُحظي",7,"ي",1,0],["ظريفُ السَّجايا حُلوَةٌ حركاتُهُ","كأنَّ لهُ في كُلِّ جارِحَةٍ عَقْلا",8,"ل",2,0],["ظرَابُ الغضا من تحت أخفافها سَفاً","يطيشُ وأحقافُ الغويرِ حِفارُ",9,"ر",1,0],["ظرف يظن له بنا من قربه","وهو الذي يسمو به المتيقظ",10,"ظ",1,0],["ظَرُرْتَ فِيْهِ وَكُنْتَ مُتَّبِعَاً","فِي الظَّرْفِ وَاللُّطْفِ أَيُّهَا الرَّجُلُ",11,"ل",1,0],["ظرُفَتْ محاسِنُه وكادَتْ رِقَّةً","تُخفي علينا من ضَناه البَادِي",12,"د",2,0],["ظرف الهوى ما بيننا وحلا به","هذا السهاد فخاب من لا يسهد",13,"د",1,0],["ظريفاً شاعراً فطناً لبيباً","أصيل الرأي في الجلى أريبا",14,"ب",2,0],["ظروف حشوها هم وغم","وفيها الاجتماع لنا وداع",15,"ع",1,0],["ظرافة الخلق غدت شيمةً","أكثرهم دخل أبوابها",16,"ب",3,0],["ظرف الرجال يفوقهم بظرائف","عجبت لها القصاص والوعاظ",17,"ظ",1,0],["ظرف المَديح اليك أَهدى سمطها","لكن جواهر نظمه الأَلفاظ",17,"ظ",1,0],["ظَرفاً حِكماً أدباً حسباً","فاق أهلَ الثناء والفخارِ العَميد",18,"د",1,0],["ظَرفَتَ ومَن يجمع من العلمِ مثلَ ما","جمعتَ أَبا إسحاقَ يَظرُف وَيُشهَرِ",19,"ر",1,0],["ظَريفَ مَزْحٍ مَليحَ نادِرَةٍ","جَوْهَرَ حُسْنٍ شَرارُهُ يَقِدُ",20,"د",1,0],["ظرفاً ولطفاً كم حوت أوصافه","أمل الورى هذا السريّ ابن الكرام",21,"م",1,0],["ظرف السخاء وليس يمسك ما به","متهللا باللين والاغلاظ",22,"ظ",1,0],["ظريف الفكاهة مرسلها","لطيف النوادر والمقطع",23,"ع",1,0],["ظُرُوفُ قُلُوبٍ امتَلأنَ بِحُبِّهِ","قَد اكتَسَبَت مِن رَبِّهَا البَختَ وَالحَظَّا",24,"ظ",2,0],["ظروفٌ على سعي المريد تصادفت","فأبلغهُ أسمى المقام مثاقبُه",25,"ب",2,0],["ظرفه دائر بكل لسان","ونراه مقدراً محذوفا",26,"ف",2,0],["ظربان سوء كل طرف قد نبا","عنه ويحسب نفسه طاووسا",27,"س",2,0],["ظَرِيفٌ وظَرْوِيٌّ وغَيرُ مُلاحِظٍ","ظِلَالَ حُظُوظِ النَّفسِ إذ هِيَ أقطُعُ",28,"ع",1,0],["ظَرَى في ظُبَى ظِلِّ الحَقِيقَةِ ظَأمُهُ","وفي ظُهرِها ظَهْرُ الظَوَاهِرِ عَاتِكُ",29,"ك",1,0],["ظربت وشاقتك البروق اللوامع","بأكناف مرو والهوى بك نازع",30,"ع",1,1],["ظرفت شمائله الحسان وأيقظت","مقل القلوب لعشقها أيقاظا",31,"ظ",2,0],["ظرفت معانيها ولا بدعا إذا","حسد الكواكب هذه الألفاظا",31,"ظ",2,0],["ظرتُ وسهبٌ من بوانة َ بيننا","وأَفْيَحُ من رَوْضِ الرُّبابِ عميقُ",32,"ق",1,1],["ظروف العيش تحرمنا كثيراً","من اللقيا وتُحْبِطُ كلَّ حيلةْ",33,"ل",2,0],["..ظريفةٌ كاعبٌ في ثغرها بَرَدٌ","تبدي سناه لُماها وهي تنفتق",34,"ق",1,0],["ظرفتَ فيهِ وكنتَ متّبعاً","في الظّرفِ واللّطْفِ أيّها الرّجُلْ",35,"ل",1,0]]}