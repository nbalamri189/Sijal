{"poems":[[51,"وقصير تراه فوق يفاع","https://www.aldiwan.net/poem8647.html","الخفيف"],[51,"ألا قل لنحويك الأخفش","https://www.aldiwan.net/poem64923.html","المتقارب"],[85,"على منازل غالي","https://www.aldiwan.net/poem7249.html","المجتث"],[66,"ظفرت سهام فواتر الألحاظ","https://www.aldiwan.net/poem38485.html","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43844","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43646","الطويل"]],"verses":[["ظَرُف الدهرُ في اتخاذك صَفْعا","ناً وما خلْتُهُ ظريفَ الدُّعابَهْ",0,"ب",2,0],["ظريفٌ وفي الظُرف مستأنسٌ","وفي الجهل موضعُ مستوحش",1,"ش",1,0],["ظرف النواسىّ لكن","في ثابت كالجبال",2,"ل",1,0],["ظَرُفَت خَلائِقُهُ وَأَحفَظَ مالَهُ","فَأَضاعَهُ رُغماً عَلى الحُفّاظِ",3,"ظ",1,0],["ظُرّانُ أَرضِكَ لِلسَماءِ قَدِ اِغتَدَت","بِكَ في مُفاخَرَةٍ وَفَرطِ غِياظِ",3,"ظ",1,0],["ظُرفُ أَبيهِ عَلَيهِ يَبدو","وَاللَفظُ وَالحِفظُ وَالحِفاظُ",4,"ظ",1,0],["ظَريُهُم خَرَّ حَيثُ شَتّوا","فَقظتُ مِن زَفرَتي وَقاظوا",4,"ظ",3,0],["ظِرافٌ لَعَمري العاشِقونَ وَإِنَّما","يَلومُهُمُ قاسي الفُؤادِ غَليظُ",5,"ظ",1,0]]}