{"poems":[[51,"وقصير تراه فوق يفاع","https://www.aldiwan.net/poem8647.html","الخفيف"],[51,"ألا قل لنحويك الأخفش","https://www.aldiwan.net/poem64923.html","المتقارب"],[85,"على منازل غالي","https://www.aldiwan.net/poem7249.html","المجتث"],[66,"ظفرت سهام فواتر الألحاظ","https://www.aldiwan.net/poem38485.html","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43844","البسيط"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43646","الطويل"],[113,"أهيم بخود عندها القلب قد فنى","https://www.aldiwan.net/poem41648.html","الطويل"],[148,"تزودت من مدح النبي المؤيد","https://www.aldiwan.net/poem68589.html","الطويل"],[402,"إذا مدح الأقوام قرما بسؤدد","https://www.aldiwan.net/poem49811.html","الطويل"],[456,"تغرب فبالدار الحبية دار","https://www.aldiwan.net/poem56195.html","الطويل"],[556,"ظن الجهول بأنه مستيقظ","https://www.aldiwan.net/poem33543.html","الكامل"],[565,"يا رب مهد هدية لطفت","https://www.aldiwan.net/poem69550.html","المنسرح"],[573,"أضحى هلالاً بدر ذاك النادي","https://www.aldiwan.net/poem2962.html","الكامل"]],"verses":[["ظَرُف الدهرُ في اتخاذك صَفْعا","ناً وما خلْتُهُ ظريفَ الدُّعابَهْ",0,"ب",2,0],["ظريفٌ وفي الظُرف مستأنسٌ","وفي الجهل موضعُ مستوحش",1,"ش",1,0],["ظرف النواسىّ لكن","في ثابت كالجبال",2,"ل",1,0],["ظَرُفَت خَلائِقُهُ وَأَحفَظَ مالَهُ","فَأَضاعَهُ رُغماً عَلى الحُفّاظِ",3,"ظ",1,0],["ظُرّانُ أَرضِكَ لِلسَماءِ قَدِ اِغتَدَت","بِكَ في مُفاخَرَةٍ وَفَرطِ غِياظِ",3,"ظ",1,0],["ظُرفُ أَبيهِ عَلَيهِ يَبدو","وَاللَفظُ وَالحِفظُ وَالحِفاظُ",4,"ظ",1,0],["ظَريُهُم خَرَّ حَيثُ شَتّوا","فَقظتُ مِن زَفرَتي وَقاظوا",4,"ظ",3,0],["ظِرافٌ لَعَمري العاشِقونَ وَإِنَّما","يَلومُهُمُ قاسي الفُؤادِ غَليظُ",5,"ظ",1,0],["ظريفة طبع زاد فيها تفنني","ولعت بها قبل الرضاع وإنني",6,"ي",1,0],["ظِرابُ نَواحي يَثرِبٍ وَبِطاحُها","مُنايَ وَهَل يَحظى بها غَيرُ مَن أُحظي",7,"ي",1,0],["ظريفُ السَّجايا حُلوَةٌ حركاتُهُ","كأنَّ لهُ في كُلِّ جارِحَةٍ عَقْلا",8,"ل",2,0],["ظرَابُ الغضا من تحت أخفافها سَفاً","يطيشُ وأحقافُ الغويرِ حِفارُ",9,"ر",1,0],["ظرف يظن له بنا من قربه","وهو الذي يسمو به المتيقظ",10,"ظ",1,0],["ظَرُرْتَ فِيْهِ وَكُنْتَ مُتَّبِعَاً","فِي الظَّرْفِ وَاللُّطْفِ أَيُّهَا الرَّجُلُ",11,"ل",1,0],["ظرُفَتْ محاسِنُه وكادَتْ رِقَّةً","تُخفي علينا من ضَناه البَادِي",12,"ي",1,0]]}