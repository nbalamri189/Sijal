ps://www.aldiwan.net/poem54132.html","الوافر"],[434,"إذا اهتز للجدوى اهتزاز مهند","https://www.aldiwan.net/poem2498.html","الطويل"],[436,"إليك سبقت أقدار الحمام","https://www.aldiwan.net/poem34862.html","الوافر"],[438,"تشفلط جلدي والليالي تشفلط","https://www.aldiwan.net/poem14310.html","الطويل"],[438,"ألق العصي فهذا مقتضى الأرب","https://www.aldiwan.net/poem14330.html","البسيط"],[438,"إلى كم أرقع الدنيا","https://www.aldiwan.net/poem14389.html","مجزوء الوافر"],[438,"لا يمنع الموت حجاب ولا زرد","https://www.aldiwan.net/poem14449.html","البسيط"],[441,"جنى قوم على الدنيا","https://www.aldiwan.net/poem55978.html","عموديه"],[456,"لمن طل بلِوى عاقِلِ","https://www.aldiwan.net/poem55998.html","المتقارب"],[456,"عجلت بحطك فيها الرحالا","https://www.aldiwan.net/poem56065.html","المتقارب"],[456,"إذا عارض نحو أرض عدل","https://www.aldiwan.net/poem56076.html","المتقارب"],[456,"حبست وأيام الملوك كذاكا","https://www.aldiwan.net/poem56082.html","الطويل"],[456,"مشين لنا بين ميل وهيف","https://www.aldiwan.net/poem56114.html","المتقارب"],[456,"نشدتك يا بانة الأجرع","https://www.aldiwan.net/poem56118.html","المتقارب"],[456,"هل في الشموس التي تحدى بها العير","https://www.aldiwan.net/poem56166.html","البسيط"],[459,"إذا ما بحار الأرض جاشت وأجلبت","https://www.aldiwan.net/poem16350.html","الطويل"],[461,"إذا قلت لم أقصد جدالاً ولا مرا","https://www.aldiwan.net/poem926.html",""],[462,"أرحها فقد ضاقت بها سعة المدى","https://www.aldiwan.net/poem3600.html","عموديه"],[466,"جوامع أوهامي تقصر عن قدري","https://www.aldiwan.net/poem59974.html","الطويل"],[475,"صباه الهوى ما أحوج الخلو أن يصبو","https://www.aldiwan.net/poem15336.html","الطويل"],[513,"قدك مثل الغصن في اعتداله","https://www.aldiwan.net/poem12217.html","الرجز"],[527,"ومن جار في الحكم فهو امرؤ","https://www.aldiwan.net/poem37362.html","المتقارب"],[536,"بمقدمك الحمراء قد عبقت عطرا","https://www.aldiwan.net/poem48185.html","عموديه"],[549,"عرفت الديار كسحق البرود","https://www.aldiwan.net/poem47805.html","المتقارب"],[556,"ألا أيها الحادي لذاك الحمى سر بي","https://www.aldiwan.net/poem34950.html","الطويل"]],"verses":[["وَمَن جَعَلَ القَلبَ الجَريءَ دَليلَهُ","فَكُلَّ ظَلامِ عِندَهُ غَيرُ مُظلِمِ",0,"م",1,0],["وَمَن جَعَلَ الدَليلَ لَهُ اِبنَ لَيلى","فَلَن يَخشى الضَلالَ وَلا الغِلاطا",1,"ط",2,0],["وَمِن جَبَلٍ أَعدَدتُ شُمَّ هِضابِهِ","مَرَدّاً لِأَيدي النائِباتِ الكَوارِثِ",2,"ث",1,0],["وَمَنجوبٌ لَهُ مِنهُنَّ صَرعٌ","يَميلُ إِذا عَدَلتَ بِهِ الشَوارا",3,"ر",2,0],["ومَنْ جهِلَ الحُقوقَ أطاعَ نفْساً","ببَحْرِ الجهْلِ راسِبَةً غَريقَهْ",4,"ق",2,0],["ومَنْجَى نيقَةٍ أمْرٌ بَعيدٌ","إذا نصَبَ المهَنْدِسُ مَنْجَنيقَهْ",4,"ق",2,0],["وَمِنْ جَبَلٍ لِلْحِلْمِ أَشْرَفَ وَاعْتَلَى","فَدَانَتْ لَهُ بِالْعِزَّةِ الْقُلَلُ الشُّمُّ",5,"م",1,0],["وَمِنْ جَمَالٍ وَكَمَالٍ","جَلَّ رَبٌّ أَبْدَعَهْ",6,"ع",2,0],["وَمَنْ جُمْهُورٌ تَخَالُ رِجَالَهُمْ","نِسَاءٌ مُحَلاَّةً وَنِسْوَتَهُمْ دُمَى",7,"م",2,0],["وَمِن جَوفِ ماءٍ عَرمَضُ الحَولِ فَوقَهُ","مَتى يَحسُ مِنهُ مائِحُ القَومِ يَتفُلِ",8,"ل",1,0],["وِمِن جَردٍ غُفلٍ بَساطٍ تَحاسَنَت","بِهِ الوَشي قَرّاتُ الرِياحِ وَخورُها",9,"ر",3,0],["وَمِن جَوفِ أَصواءٍ يَصيحُ بِها الصَدى","لِمُترِبَةِ الأَخفافِ صُفرٍ غُرورُها",9,"ر",3,0],["ومن جمال كل من راءه","يبلغ منه الغاية القُصوى",10,"ص",3,0],["ومن جهلنا استكراهُنا في معاشنا","شقاءً نزيهاً للنعيم المدنّس",11,"س",1,0],["ومن جمرات الشعر رنّة ثاكل","مفجّعة أودى بواحدها الدهر",12,"ر",1,0],["وَمَن جَدُّهُ الأَدنى أَبي وَاِبنُ أُمِّهِ","لِأُمِّ أَبي ذاكَ الشَهيدُ المُجاهِدُ",13,"د",1,0],["ومن جودِ مولانا علاً ومناصبٌ","وعلمٌ لنظَّام الثناء وتبيان",14,"ن",1,0],["ومن جبى المال للسلطان دونهمُ","أعداهُ إثماً وعاراً لازبَ الجَرَبِ",15,"ب",1,0],["ومن جاور الماء الغزير مجمُّهُ","وسد سبيل الماء فهو غريقه",16,"ه",1,0],["وَمِن جَدٍّ وَمِن هَزَلٍ","وَمِن حَقٍّ وَمِن زورِ",17,"ر",1,0],["وَمَن جَهِلَت نَفسُهُ قَدرَهُ","رَأى غَيرُهُ مِنهُ مالا يَرى",18,"ا",1,0],["وَمِن جاهِلٍ بي وَهوَ يَجهَلُ جَهلَهُ","وَيَجهَلُ عِلمي أَنَّهُ بِيَ جاهِلُ",19,"ل",1,0],["وَمِن جَسَدي لَم يَترُكِ السُقمُ شَعرَةً","فَما فَوقَها إِلّا وَفيها لَهُ فِعلُ",20,"ل",1,0],["ومن جوهرِ السيفِ صارَ الحديد","بقيمةِ أضعافِه عَسْجَدَا",21,"د",2,0],["وَمِن جَلَلِ الخُطوبِ نَعِيُّ ناعٍ","أَتانا عَنكَ بِالخَطبِ الجَليلِ",22,"ل",1,0],["وَمَن جَهِلَ الأَمرَ الَّذي هُوَ غايَةٌ","لَمَبدَإِنا هَذا فَإِنَّكَ عالِمُه",23,"م",2,0],["وَمِن جَفنَةٍ كانَ اليَتامى عِيالَها","وَسابِغَةٍ تَغشى بَنانَ الأَصابِعِ",24,"ع",1,0],["وَمُنجَرِدُ السُهبانِ أَيسَرُ ما بِهِ","سَليبُ صُهارٍ أَو قُصاعٌ مُؤَلَّفُ",25,"ف",1,0],["ومن جَوْرِ الهَوى أن راحَ يُزْجي","مَطايا البَيْنِ في أَثَرِ الصُّدودِ",26,"د",1,0],["وَمِن جَهولٌ مُكثِرٍ مالَهُ","ذَلِكَ تَقديرُ العَزيزُ العَليمِ",27,"م",1,0],["وَمِن جَدِّهِ جَدي وَمِن عَمهِ أَبي","وَمِن نَجلِهِ نَجلي وَمِن بِنتِهِ أَهلي",28,"ي",1,0],["وَمَن جاءَ يَبغي ما لَدَيكَ فَأَرضِهِ","بِجُهدِكَ وَاترُك ما يَكونُ لَدَيهِ",29,"ي",2,0],["وَمَن جادَ بَعدَ تَمادي المَطالِ","فَإِنَّ العَطِيَّةَ أَجرُ السُعاةِ",30,"ا",2,0],["وَمُنجَرِدٍ كالسيدِ يعُمِلُ أَرضَهُ","فَيبني سماءً فوقه سمكها النّقعُ",31,"ع",1,0],["وَمِن جودٍ لَهُ حَولي صَريفٌ","بِنابَيهِ وَمِن عُرفٍ فَتِيِّ",32,"ي",1,0],["وَمِن جيدِ غَيداءِ التَثَنّي كَأَنَّما","أَتَتكَ بِلَيتَيها مِنَ الرَشَأِ الفَردِ",33,"د",1,0],["وَمُنجَرِدٌ ضَخمُ الجُزارَةِ أَوحَدٌ","يَطيرُ بِهِ تَحتَ العَجاجَةِ أَربَعُ",34,"ع",1,0],["وَمُنجَدِلاً كَالحَبلِ مِن سَورَةِ الكَرى","يَرى الحَجَرَ المُلقى فِراشاً مُمَهَّدا",35,"د",2,0],["ومن جهل الوغى اشتبهت عليه","ذئاب القفر والأسد الغضاب",36,"ب",1,0],["وَمَن جَرى نَيلُهُ بَحراً فَغاصَ بِهِ","أَهلُ الثَناءِ عَلى دُرٍّ مِنَ الكَلِمِ",37,"م",1,0],["وَمَن جَفاني فَلا أَراهُ","هَب لي رُقاداً أَراكَ فيهِ",38,"ه",1,0],["ومنْ جَمَعَ القرآنَ فاجْتَمَعَتْ به","فضائلُ منهُ مِثْلَ مَا اجْتَمَعَ الزُّبْدُ",39,"د",1,0],["ومِن جبَابرَةِ الدّنْيا الذينَ خَلَوْا","وأنْزَلَ اللّهُ فيهم وَحْيَهُ فتُلى",40,"ل",2,0],["ومنجنيقُ القذافِ بربطهُ","وقَذفةُ الضربِ بالرواثينِ",41,"ن",1,0],["ومنجنيقاتُنا المعازفُ والعيدا","نُ إذا سوّيت ملاويها",42,"ي",3,0],["وَمَن جَعَلَ السَخاءَ لِأَقرَبيهِ","فَلَيسَ بِعارِفٍ طُرُقَ السَخاءِ",43,"خ",3,0],["وَمَن جاوَرتَ مِن حُنُفٍ وَسِربٍ","صَوابيءَ فَليَبِنَّ مُكَرَّماتِ",44,"ت",1,0],["وَمَن جَمَعَ الضَرّاتِ يَطلُبُ لَذَّةً","فَقَد باتَ في الإِضرارِ غَيرَ سَديدِ",45,"د",1,0],["وَمَن جاءَ مِنهُم واثِقاً بِشَفاعَةٍ","فَكَم شافِعٍ في هَيِّنٍ لا يُشَفَّعُ",46,"ع",1,0],["وَمَن جَمَعَ اِثنَتَينِ فَما تَوَخّى","سَبيلَ الحَقِّ في خَمسٍ وَرُبعِ",47,"ع",1,0],["وَمَنْ جَدَّ فِي التَّصْرِيفِ لِلأمْرِ جِدَّهُ","وَقَدْ بَاتَ فِي تَصْرِيفِهِ العَقْدُ وَالْحَلُ",48,"ل",1,0],["ومَنْجُوفةٌ جِرْمِيَّةٌ صَاعِديَّةٌ","يُذَرُّ عليها السّمُّ سَاعةَ تَصْنَعُ",49,"ع",1,0],["وَمِن جَرّاكِ أوطِنتُ الفَيافي","وَفيكِ غُذيتُ أَلبانَ اللِقاحِ",50,"ح",1,0],["وَمَنْ جَهِلَ الأمْرَ الذي هُوَ غَايَةٌ","لِمَبْدَائِنَا هَذا، فإنّكَ عَالِمُهْ",51,"م",2,0],["ومن جاورَ الماءَ العزيز مَجمُّهُ","وسدّ سبيل الماء فهو غريقه",52,"ه",1,0],["وَمِن جُمُوعِ النَّارِ أيضاً أنوُرُ","وأنَثنَّهَا وقَد تُذَكَّرُ",53,"ر",1,0],["وَمِن جَورِهِ أَن غادَرَ الذُلَّ قاهِراً","عَزيزاً وَأَبقى مازِنَ العِزِّ أَجدَعا",54,"ع",2,0],["وَمَن جادَ بِالآمالِ عَنكَ فَإِنَّني","أَرى كُلَّ بَحرٍ مُذ رَأَيتُكَ جَدوَلا",55,"ل",2,0],["ومنجح آمال وحسن مقاصد","يكون بها في جنة الخلد لي الخلد",56,"د",1,0],["ومن جعل الذكر حديثاً لنفسه","يردِّده مستعذباً ويعيده",57,"د",2,0],["ومن جدَّ في تحصيل هاد يدلهُ","إِلى الرشد لم يعدم دليلاً ومرشدا",58,"د",2,0],["ومن جار سولا منهم عاد نحوهم","نذيرا يريهم ما يراه ويسمع",59,"ع",1,0],["ومن جا بدين مفتر غير دينه","فاهلك أعمارا به كالأباقر",60,"ر",1,0],["وَمَن جَرَّبَ الشَكوى فَلَم تَجد طائِلاً","أَقَرَّ عَلى الصَبرِ الجَميلِ قَرارَهْ",61,"ر",2,0],["ومن جيّد الداذيّ ما ليس مثلهُ","تخيّرهُ لي فيلسوف أبو عمرو",62,"ر",2,0],["وَمَن جدَّ في قطعِ البحار بعزمهِ","غَدا عزمهُ فوقَ البحارِ لهُ جِسرا",63,"ر",2,0],["وَمِن جودهِ تَعجيلهُ فضلهُ لهم","وَتَأجيلهُ التأديبَ لِلنَشأةِ الأُخرى",63,"ر",2,0],["وَمَن جاءَها يَمشي لها مُتقرّباً","فَمِن فَضلها تَأتيهِ هَرولةً طفرا",63,"ر",2,0],["وَمَن جاءَها مِن هفوةٍ متنصّلاً","وَمُعتذراً ممّا جنى تقبلُ العُذرا",63,"ر",2,0],["ومن جعل التعريض محصول مزحه","فذاك على المقت المصرِّح يحصلُ",64,"ل",1,0],["ومن جاءه يشكو من الدهر عسرة","فان مع العسر الذي ناله يسرا",65,"ر",2,0],["ومن جميل عطاياه وسؤدده","يعطي الكثير لراجيه ويعتذر",66,"ر",1,0],["ومن جماد جبال","ومن ظلال جبال",67,"ل",1,0],["ومَن جَرَّب الأيّامَ تجرِبتي لها","دَرَى أنّها ليست تدومُ على مَعنَى",68,"ن",2,0],["وَمِن جَزعي أخفي الهَوى وَأُجِنُّهُ","عَلى أَنَّ دَمعي بِالسَرائِرِ يَنطقُ",69,"ق",1,0],["وَمَنْ جَابِرٌ أُسْتَاذُهُ فَمُظَفَّرٌ","بِأَعْلَى الْعُلاَ فِي كُلِّ وَجْهٍ وَمَقْصَدِ",70,"د",1,0],["وَمِنْ جَرْزٍ جُرَازُ غَ","مِّهَا لَمْ يَنْبُ عَنْ جَرْزِ",71,"ز",1,0],["وَمَنْ جَلَّى سَنَا شَمْسِ الْمَعَانِي","وَمَنْ نُورُ الْفَضَاءِ بِهِ جَلِيُّ",72,"ي",1,0],["ومن جعل التدبير في الحربِ هَمّهُ","أذلت إليه كل دهياءَ صَيلَمِ",73,"م",1,0],["ومن جاء ملهوفاً غريباً لبابكم","ولم يستغثكم في الورى من يغيثه",74,"ه",1,0],["ومن جاورته النائبات بجورها","تباعد عنه الأقربون وجاره",75,"ر",2,0],["ومن جهل الدنيا فأني بعامها","وخبر بنيها ان سئلت عروف",76,"ف",1,0],["ومن جوده حتى بكل تنوفة","ينوء بما ضن الحيا وينوف",76,"ف",1,0],["ومن جهل التصابي فهو داء","كساك السهد واستلب الرقادا",77,"د",2,0],["ومن جَورِهم تبكي شعوبٌ كثيرةٌ","بنوها عبيدٌ عندَهم وإماء",78,"ا",2,0],["وَمِن جودِ مَجدِ الدينِ في بعَلبكَّ لي","أَتَت نِعَمٌ أَغدو بِها وَأَروحُ",79,"ح",1,0],["ومن جناةٍ وأفاقين أطمَعَهُم","فينا التخاذُلُ والتقصيرُ والخور",80,"ر",1,0],["ومن جاء نادى البر بعد افتتاحه","فأقرانه يومون فيه بأعيان",81,"ن",1,0],["وَمن جرّدٍ شقرٍ تلظّت صرامةً","فَأَبدى تلظّيها على أهبِها حَنطا",82,"ط",2,0],["وَمِن جَوايَ حَمَلتُ قَهرا","بِبابِهِ حَملَةَ الجَوادِ",83,"د",1,0],["وَمِن جَأبِ النُسالَةِ أَخدَرِيٌّ","وَمِن شَخصٍ تَرودُ وَأُمِّ جَحشِ",84,"ش",1,0],["وَمن جوِهِ أَملت امنا ورحة","لساكن هذا القبران مسه رُعب",85,"ب",1,0],["ومَن جَلَّ عن شُغْلٍ يَجُلّ بهِ الورى","وإن لم يَنلْ صاعَ المُجارِين مُدّه",86,"د",2,0],["ومن جَنبٍ مُجَنِّبَةٌ ضَروبٌ","لهامِ القومِ بالأَبطالِ تُردي",87,"د",2,0],["ومِن جفونٍ بضعفِها قويَت","والسقم يُعدي واللَّحظُ يَستعدي",88,"ي",1,0],["ومن جرى ضُعفه يَجني تواضعَه","كمُدنِفٍ ذلَّ لما حسَّ بالحتفِ",89,"ف",1,0],["ومن جنى سيآت ساء مضجعه","يندم ندامة لا يمكن تلافيها",90,"ي",3,0],["ومُنْجِز ميعاد الأَماني لِوقتِهِ","فما قال إلاّ أتبعَ القولَ بالفِعْلِ",91,"ل",1,0],["ومن جاءني من تأليفه برسائل","يكفر أهل الأرض على عمد",92,"د",1,0],["ومن جهله ألقى إلى الزور نفسه","وجاء بما لم يأته اليوم جاهل",93,"ل",1,0],["ومن جرَّب الأَيَّام والنَّاس غيركم","رنا نحوهم لكن بناظر زاهد",94,"د",1,0],["ومن جُمَل الفروض عليك تتلى","لشكر صنيعك الإِحسان حمد",95,"د",1,0],["ومن جدواك كم قد سال سيلٌ","فروّى سيلُ جودك كل ظامي",96,"م",2,0],["ومن جرّ جيش المشرقين بعزمة","أضاءت فكانت للورى سنّة الفجر",97,"ر",1,0],["ومن جَدْوَاكَ رُدَّ دمي ولَحْمِي","وَمَا انْتَقَتِ الحوادِثُ من عِظَامِي",98,"م",2,0],["ومن جاوز الخمسين عاماً فإنه","عليه صروف الحادثات تسلط",99,"ط",1,0],["ومن جنابي كم من واردٍ صدرا","منا ومعتقبٍ في إثر معتقب",100,"ب",1,0],["ومنجاتي ومهلكتي","وإصلاحي وتأفيني",101,"ي",1,0],["ومن جلالته ما رُمت تحفظه","منك الفرائص لما ساح مرتعد",102,"د",1,0],["ومن جذ ومن قطع","ومن مسح إذا اصمى",103,"ا",1,0],["ومن جائرٍ ليتَ ما قبله","تعلّم من قدّه العادلِ",104,"ل",1,0],["ومن جامعٍ حسناتِ الخِلال","وقد قبّح الفقر تلك الخِلالا",105,"ل",2,0],["ومَن جاورَ الغيثَ أنَّى أقا","م يتبعُه الغيثُ أنَّى رحلْ",106,"ل",1,0],["ومن جعجع الأقدارَ عن طُرقِ كيدهِ","عطفن عليه فاستُثرن وِشَاكا",107,"ك",2,0],["ومن جمع الدينَ في يوم بدرٍ","وأُحْدٍ بتفريقِ تلك الصفوفِ",108,"ف",1,0],["ومن جانبٍ بلدٌ لا يرى","لخُرق الصِّبا فيه من مَرتَعِ",109,"ع",1,0],["ومن جنا النحلِ بيضاء يلملمها","ماءٌ من الأصفر السوسي معصورُ",110,"ر",1,0],["ومنْ جعل الإِحسان دأباً فحمدُه","وتعْزيرُه فرضٌ على كلِّ مِقْوَل",111,"ل",1,0],["ومن جوّز الإفطار في رمضان قد","غدى كافرا ان كان يا صاح حاضرا",112,"ر",2,0],["ومن جمرةٍ يزداد بالنار بردها","وجمرٍ بماء الوجنتين توقَّدا",113,"د",2,0],["وَمَن جَدُّهُ جَدّي وَأُمِّيَ أُمُّهُ","يَرى نَفسَهُ أَعلى مَحَلّاً مِنَ الزَهرِ",114,"ر",1,0],["ومِن جيرةٍ بانوا فأصبحتُ بعدَهمْ","مقيماً بجسمٍ ليس يَصحَبُه قلبُ",115,"ب",1,0],["ومن جنايات اللئام بعض ما","لا يقدر الشعر على احتماله",116,"ل",2,0],["ومَنْ جارَ في الحُكْمِ فَهْوَ امْرُؤٌ","أَحالَ الخِصامُ عَلَى نَفْسِهِ",117,"ه",1,1],["ومَن جودُه يُنسيكَ مَعناً وحاتِماً","ومَن صيتُه قد جاوزَ البَرَّ والبَحرا",118,"ر",2,0],["وَمن جبلٍ ما اِستجار المَروعُ","بهِ في البوائقِ إلّا أَجارا",119,"ر",2,0],["ومن جهل المحبوب فالضرب موجع","له ومتى يعرفه يلتذ بالضرب",120,"ب",1,0]]}