px?id=128838",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[592,"لك الحمد وإن الحمد أول ما نبدي","https://www.poetsgate.com/ViewPoem.aspx?id=128714",""],[592,"بحمد الله نبدأ في المقال","https://www.poetsgate.com/ViewPoem.aspx?id=128799",""],[592,"جواب خرافات نماها وظنها","https://www.poetsgate.com/ViewPoem.aspx?id=128808",""],[5362,"أكلف عيني أن تجود بمائها","https://www.poetsgate.com/ViewPoem.aspx?id=170365",""],[5544,"عبري","https://www.poetsgate.com/ViewPoem.aspx?id=213406",""],[5573,"تحيزمت واحلامي عن العين غايبه","https://www.poetsgate.com/ViewPoem.aspx?id=200138",""],[5582,"ستبدي خفيّات الأمورِ العواقبُ","https://www.poetsgate.com/ViewPoem.aspx?id=63465",""],[5587,"هذي الرسائل","https://www.poetsgate.com/ViewPoem.aspx?id=196819",""],[5596,"بين السبحية والحمراء","https://www.poetsgate.com/ViewPoem.aspx?id=206360",""],[5628,"غيرة العاشق","https://www.poetsgate.com/ViewPoem.aspx?id=179895",""],[5650,"ليسَ غيرُ التّيهِ","https://www.poetsgate.com/ViewPoem.aspx?id=181696",""],[5689,"عذيرك: ما في الدهر ما تبغض الأنس","https://www.poetsgate.com/ViewPoem.aspx?id=143406",""],[5742,"الحمراء تأريخ ونهضة","https://www.poetsgate.com/ViewPoem.aspx?id=206897",""],[5758,"لعِيْنَيْ غَزَّة","https://www.poetsgate.com/ViewPoem.aspx?id=200916",""],[402,"عفا العلم الراسي كما يقشع الظل","https://www.poetsgate.com/ViewPoem.aspx?id=36213",""],[5818,"يقولون انْسها","https://www.poetsgate.com/ViewPoem.aspx?id=195363",""],[5818,"لاجئ","https://www.poetsgate.com/ViewPoem.aspx?id=196530",""],[5989,"ليت أنك قد ذقتا","https://www.poetsgate.com/ViewPoem.aspx?id=181497",""],[5997,"وصايا","https://www.poetsgate.com/ViewPoem.aspx?id=214221",""],[6045,"شباب الحلوة","https://www.poetsgate.com/ViewPoem.aspx?id=123996",""],[161,"ضاع ترتيب الفصول","https://www.poetsgate.com/ViewPoem.aspx?id=180916",""],[6079,"أمِن بأسِ الفواجعِ تدمعينا","https://www.poetsgate.com/ViewPoem.aspx?id=208563",""]],"verses":[["وَمَن جَعَلَ القَلبَ الجَريءَ دَليلَهُ","فَكُلَّ ظَلامِ عِندَهُ غَيرُ مُظلِمِ",0,"م",1,0],["وَمَن جَعَلَ الدَليلَ لَهُ اِبنَ لَيلى","فَلَن يَخشى الضَلالَ وَلا الغِلاطا",1,"ط",2,0],["وَمِن جَبَلٍ أَعدَدتُ شُمَّ هِضابِهِ","مَرَدّاً لِأَيدي النائِباتِ الكَوارِثِ",2,"ث",1,0],["وَمَنجوبٌ لَهُ مِنهُنَّ صَرعٌ","يَميلُ إِذا عَدَلتَ بِهِ الشَوارا",3,"ر",2,0],["ومَنْ جهِلَ الحُقوقَ أطاعَ نفْساً","ببَحْرِ الجهْلِ راسِبَةً غَريقَهْ",4,"ق",2,0],["ومَنْجَى نيقَةٍ أمْرٌ بَعيدٌ","إذا نصَبَ المهَنْدِسُ مَنْجَنيقَهْ",4,"ق",2,0],["وَمِنْ جَبَلٍ لِلْحِلْمِ أَشْرَفَ وَاعْتَلَى","فَدَانَتْ لَهُ بِالْعِزَّةِ الْقُلَلُ الشُّمُّ",5,"م",1,0],["وَمِنْ جَمَالٍ وَكَمَالٍ","جَلَّ رَبٌّ أَبْدَعَهْ",6,"ع",2,0],["وَمَنْ جُمْهُورٌ تَخَالُ رِجَالَهُمْ","نِسَاءٌ مُحَلاَّةً وَنِسْوَتَهُمْ دُمَى",7,"م",2,0],["وَمِن جَوفِ ماءٍ عَرمَضُ الحَولِ فَوقَهُ","مَتى يَحسُ مِنهُ مائِحُ القَومِ يَتفُلِ",8,"ل",1,0],["وِمِن جَردٍ غُفلٍ بَساطٍ تَحاسَنَت","بِهِ الوَشي قَرّاتُ الرِياحِ وَخورُها",9,"ر",3,0],["وَمِن جَوفِ أَصواءٍ يَصيحُ بِها الصَدى","لِمُترِبَةِ الأَخفافِ صُفرٍ غُرورُها",9,"ر",3,0],["ومن جمال كل من راءه","يبلغ منه الغاية القُصوى",10,"ص",3,0],["ومن جهلنا استكراهُنا في معاشنا","شقاءً نزيهاً للنعيم المدنّس",11,"س",1,0],["ومن جمرات الشعر رنّة ثاكل","مفجّعة أودى بواحدها الدهر",12,"ر",1,0],["وَمَن جَدُّهُ الأَدنى أَبي وَاِبنُ أُمِّهِ","لِأُمِّ أَبي ذاكَ الشَهيدُ المُجاهِدُ",13,"د",1,0],["ومن جودِ مولانا علاً ومناصبٌ","وعلمٌ لنظَّام الثناء وتبيان",14,"ن",1,0],["ومن جبى المال للسلطان دونهمُ","أعداهُ إثماً وعاراً لازبَ الجَرَبِ",15,"ب",1,0],["ومن جاور الماء الغزير مجمُّهُ","وسد سبيل الماء فهو غريقه",16,"ه",1,0],["وَمِن جَدٍّ وَمِن هَزَلٍ","وَمِن حَقٍّ وَمِن زورِ",17,"ر",1,0],["وَمَن جَهِلَت نَفسُهُ قَدرَهُ","رَأى غَيرُهُ مِنهُ مالا يَرى",18,"ا",1,0],["وَمِن جاهِلٍ بي وَهوَ يَجهَلُ جَهلَهُ","وَيَجهَلُ عِلمي أَنَّهُ بِيَ جاهِلُ",19,"ل",1,0],["وَمِن جَسَدي لَم يَترُكِ السُقمُ شَعرَةً","فَما فَوقَها إِلّا وَفيها لَهُ فِعلُ",20,"ل",1,0],["ومن جوهرِ السيفِ صارَ الحديد","بقيمةِ أضعافِه عَسْجَدَا",21,"د",2,0],["وَمِن جَلَلِ الخُطوبِ نَعِيُّ ناعٍ","أَتانا عَنكَ بِالخَطبِ الجَليلِ",22,"ل",1,0],["وَمَن جَهِلَ الأَمرَ الَّذي هُوَ غايَةٌ","لَمَبدَإِنا هَذا فَإِنَّكَ عالِمُه",23,"م",2,0],["وَمِن جَفنَةٍ كانَ اليَتامى عِيالَها","وَسابِغَةٍ تَغشى بَنانَ الأَصابِعِ",24,"ع",1,0],["وَمُنجَرِدُ السُهبانِ أَيسَرُ ما بِهِ","سَليبُ صُهارٍ أَو قُصاعٌ مُؤَلَّفُ",25,"ف",1,0],["ومن جَوْرِ الهَوى أن راحَ يُزْجي","مَطايا البَيْنِ في أَثَرِ الصُّدودِ",26,"د",1,0],["وَمِن جَهولٌ مُكثِرٍ مالَهُ","ذَلِكَ تَقديرُ العَزيزُ العَليمِ",27,"م",1,0],["وَمِن جَدِّهِ جَدي وَمِن عَمهِ أَبي","وَمِن نَجلِهِ نَجلي وَمِن بِنتِهِ أَهلي",28,"ل",2,0],["وَمَن جاءَ يَبغي ما لَدَيكَ فَأَرضِهِ","بِجُهدِكَ وَاترُك ما يَكونُ لَدَيهِ",29,"ي",2,0],["وَمَن جادَ بَعدَ تَمادي المَطالِ","فَإِنَّ العَطِيَّةَ أَجرُ السُعاةِ",30,"ا",2,0],["وَمُنجَرِدٍ كالسيدِ يعُمِلُ أَرضَهُ","فَيبني سماءً فوقه سمكها النّقعُ",31,"ع",1,0],["وَمِن جودٍ لَهُ حَولي صَريفٌ","بِنابَيهِ وَمِن عُرفٍ فَتِيِّ",32,"ي",1,0],["وَمِن جيدِ غَيداءِ التَثَنّي كَأَنَّما","أَتَتكَ بِلَيتَيها مِنَ الرَشَأِ الفَردِ",33,"د",1,0],["وَمُنجَرِدٌ ضَخمُ الجُزارَةِ أَوحَدٌ","يَطيرُ بِهِ تَحتَ العَجاجَةِ أَربَعُ",34,"ع",1,0],["وَمُنجَدِلاً كَالحَبلِ مِن سَورَةِ الكَرى","يَرى الحَجَرَ المُلقى فِراشاً مُمَهَّدا",35,"د",2,0],["ومن جهل الوغى اشتبهت عليه","ذئاب القفر والأسد الغضاب",36,"ب",1,0],["وَمَن جَرى نَيلُهُ بَحراً فَغاصَ بِهِ","أَهلُ الثَناءِ عَلى دُرٍّ مِنَ الكَلِمِ",37,"م",1,0],["وَمَن جَفاني فَلا أَراهُ","هَب لي رُقاداً أَراكَ فيهِ",38,"ه",1,0],["ومنْ جَمَعَ القرآنَ فاجْتَمَعَتْ به","فضائلُ منهُ مِثْلَ مَا اجْتَمَعَ الزُّبْدُ",39,"د",1,0],["ومِن جبَابرَةِ الدّنْيا الذينَ خَلَوْا","وأنْزَلَ اللّهُ فيهم وَحْيَهُ فتُلى",40,"ل",2,0],["ومنجنيقُ القذافِ بربطهُ","وقَذفةُ الضربِ بالرواثينِ",41,"ن",1,0],["ومنجنيقاتُنا المعازفُ والعيدا","نُ إذا سوّيت ملاويها",42,"ي",3,0],["وَمَن جَعَلَ السَخاءَ لِأَقرَبيهِ","فَلَيسَ بِعارِفٍ طُرُقَ السَخاءِ",43,"خ",3,0],["وَمَن جاوَرتَ مِن حُنُفٍ وَسِربٍ","صَوابيءَ فَليَبِنَّ مُكَرَّماتِ",44,"ت",1,0],["وَمَن جَمَعَ الضَرّاتِ يَطلُبُ لَذَّةً","فَقَد باتَ في الإِضرارِ غَيرَ سَديدِ",45,"د",1,0],["وَمَن جاءَ مِنهُم واثِقاً بِشَفاعَةٍ","فَكَم شافِعٍ في هَيِّنٍ لا يُشَفَّعُ",46,"ع",1,0],["وَمَن جَمَعَ اِثنَتَينِ فَما تَوَخّى","سَبيلَ الحَقِّ في خَمسٍ وَرُبعِ",47,"ع",1,0],["وَمَنْ جَدَّ فِي التَّصْرِيفِ لِلأمْرِ جِدَّهُ","وَقَدْ بَاتَ فِي تَصْرِيفِهِ العَقْدُ وَالْحَلُ",48,"ل",1,0],["ومَنْجُوفةٌ جِرْمِيَّةٌ صَاعِديَّةٌ","يُذَرُّ عليها السّمُّ سَاعةَ تَصْنَعُ",49,"ع",1,0],["وَمِن جَرّاكِ أوطِنتُ الفَيافي","وَفيكِ غُذيتُ أَلبانَ اللِقاحِ",50,"ح",1,0],["وَمَنْ جَهِلَ الأمْرَ الذي هُوَ غَايَةٌ","لِمَبْدَائِنَا هَذا، فإنّكَ عَالِمُهْ",51,"م",2,0],["ومن جاورَ الماءَ العزيز مَجمُّهُ","وسدّ سبيل الماء فهو غريقه",52,"ه",1,0],["وَمِن جُمُوعِ النَّارِ أيضاً أنوُرُ","وأنَثنَّهَا وقَد تُذَكَّرُ",53,"ر",1,0],["وَمِن جَورِهِ أَن غادَرَ الذُلَّ قاهِراً","عَزيزاً وَأَبقى مازِنَ العِزِّ أَجدَعا",54,"ع",2,0],["وَمَن جادَ بِالآمالِ عَنكَ فَإِنَّني","أَرى كُلَّ بَحرٍ مُذ رَأَيتُكَ جَدوَلا",55,"ل",2,0],["ومنجح آمال وحسن مقاصد","يكون بها في جنة الخلد لي الخلد",56,"د",1,0],["ومن جعل الذكر حديثاً لنفسه","يردِّده مستعذباً ويعيده",57,"د",2,0],["ومن جدَّ في تحصيل هاد يدلهُ","إِلى الرشد لم يعدم دليلاً ومرشدا",58,"د",2,0],["ومن جار سولا منهم عاد نحوهم","نذيرا يريهم ما يراه ويسمع",59,"ع",1,0],["ومن جا بدين مفتر غير دينه","فاهلك أعمارا به كالأباقر",60,"ر",1,0],["وَمَن جَرَّبَ الشَكوى فَلَم تَجد طائِلاً","أَقَرَّ عَلى الصَبرِ الجَميلِ قَرارَهْ",61,"ر",2,0],["ومن جيّد الداذيّ ما ليس مثلهُ","تخيّرهُ لي فيلسوف أبو عمرو",62,"ر",2,0],["وَمَن جدَّ في قطعِ البحار بعزمهِ","غَدا عزمهُ فوقَ البحارِ لهُ جِسرا",63,"ر",2,0],["وَمِن جودهِ تَعجيلهُ فضلهُ لهم","وَتَأجيلهُ التأديبَ لِلنَشأةِ الأُخرى",63,"ر",2,0],["وَمَن جاءَها يَمشي لها مُتقرّباً","فَمِن فَضلها تَأتيهِ هَرولةً طفرا",63,"ر",2,0],["وَمَن جاءَها مِن هفوةٍ متنصّلاً","وَمُعتذراً ممّا جنى تقبلُ العُذرا",63,"ر",2,0],["ومن جعل التعريض محصول مزحه","فذاك على المقت المصرِّح يحصلُ",64,"ل",1,0],["ومن جاءه يشكو من الدهر عسرة","فان مع العسر الذي ناله يسرا",65,"ر",2,0],["ومن جميل عطاياه وسؤدده","يعطي الكثير لراجيه ويعتذر",66,"ر",1,0],["ومن جماد جبال","ومن ظلال جبال",67,"ل",1,0],["ومَن جَرَّب الأيّامَ تجرِبتي لها","دَرَى أنّها ليست تدومُ على مَعنَى",68,"ن",2,0],["وَمِن جَزعي أخفي الهَوى وَأُجِنُّهُ","عَلى أَنَّ دَمعي بِالسَرائِرِ يَنطقُ",69,"ق",1,0],["وَمَنْ جَابِرٌ أُسْتَاذُهُ فَمُظَفَّرٌ","بِأَعْلَى الْعُلاَ فِي كُلِّ وَجْهٍ وَمَقْصَدِ",70,"د",1,0],["وَمِنْ جَرْزٍ جُرَازُ غَ","مِّهَا لَمْ يَنْبُ عَنْ جَرْزِ",71,"ز",1,0],["وَمَنْ جَلَّى سَنَا شَمْسِ الْمَعَانِي","وَمَنْ نُورُ الْفَضَاءِ بِهِ جَلِيُّ",72,"ي",1,0],["ومن جعل التدبير في الحربِ هَمّهُ","أذلت إليه كل دهياءَ صَيلَمِ",73,"م",1,0],["ومن جاء ملهوفاً غريباً لبابكم","ولم يستغثكم في الورى من يغيثه",74,"ه",1,0],["ومن جاورته النائبات بجورها","تباعد عنه الأقربون وجاره",75,"ر",2,0],["ومن جهل الدنيا فأني بعامها","وخبر بنيها ان سئلت عروف",76,"ف",1,0],["ومن جوده حتى بكل تنوفة","ينوء بما ضن الحيا وينوف",76,"ف",1,0],["ومن جهل التصابي فهو داء","كساك السهد واستلب الرقادا",77,"د",2,0],["ومن جَورِهم تبكي شعوبٌ كثيرةٌ","بنوها عبيدٌ عندَهم وإماء",78,"ا",2,0],["وَمِن جودِ مَجدِ الدينِ في بعَلبكَّ لي","أَتَت نِعَمٌ أَغدو بِها وَأَروحُ",79,"ح",1,0],["ومن جناةٍ وأفاقين أطمَعَهُم","فينا التخاذُلُ والتقصيرُ والخور",80,"ر",1,0],["ومن جاء نادى البر بعد افتتاحه","فأقرانه يومون فيه بأعيان",81,"ن",1,0],["وَمن جرّدٍ شقرٍ تلظّت صرامةً","فَأَبدى تلظّيها على أهبِها حَنطا",82,"ط",2,0],["وَمِن جَوايَ حَمَلتُ قَهرا","بِبابِهِ حَملَةَ الجَوادِ",83,"د",1,0],["وَمِن جَأبِ النُسالَةِ أَخدَرِيٌّ","وَمِن شَخصٍ تَرودُ وَأُمِّ جَحشِ",84,"ش",1,0],["وَمن جوِهِ أَملت امنا ورحة","لساكن هذا القبران مسه رُعب",85,"ب",1,0],["ومَن جَلَّ عن شُغْلٍ يَجُلّ بهِ الورى","وإن لم يَنلْ صاعَ المُجارِين مُدّه",86,"د",2,0],["ومن جَنبٍ مُجَنِّبَةٌ ضَروبٌ","لهامِ القومِ بالأَبطالِ تُردي",87,"د",2,0],["ومِن جفونٍ بضعفِها قويَت","والسقم يُعدي واللَّحظُ يَستعدي",88,"د",2,0],["ومن جرى ضُعفه يَجني تواضعَه","كمُدنِفٍ ذلَّ لما حسَّ بالحتفِ",89,"ف",1,0],["ومن جنى سيآت ساء مضجعه","يندم ندامة لا يمكن تلافيها",90,"ي",3,0],["ومُنْجِز ميعاد الأَماني لِوقتِهِ","فما قال إلاّ أتبعَ القولَ بالفِعْلِ",91,"ل",1,0],["ومن جاءني من تأليفه برسائل","يكفر أ