{"poems":[[53,"بعادا لمن صاحبت غير المقوم","https://www.aldiwan.net/poem29758.html","الطويل"],[53,"كأنك لم تقد بعويرضات","https://www.aldiwan.net/poem30163.html","الوافر"],[53,"خذوا نفثات من جوى القلب نافث","https://www.aldiwan.net/poem30663.html","الكامل"],[3,"حولي تنفض اِستُكَ مذرويه","https://www.aldiwan.net/poem95.html",""],[77,"من استغضبت من هذي الخليقه","https://www.aldiwan.net/poem35915.html","الوافر"],[77,"أما لو علمنا أنه ينطق الرسم","https://www.aldiwan.net/poem36120.html","الطويل"],[93,"جاءوا وكانوا أربعه","https://www.aldiwan.net/poem11132.html","مجزوء الرجز"],[93,"سوى الحب لا تشفي الفؤاد المكلما","https://www.aldiwan.net/poem11364.html","الطويل"],[30,"قف العيس في أطلال مية فاسأل","https://www.aldiwan.net/poem29540.html","الطويل"],[30,"تصابيت في أطلال مية بعدما","https://www.aldiwan.net/poem29578.html","الطويل"],[88,"هذي بلودان وذا نزلها","https://www.aldiwan.net/poem44394.html","الخفيف"],[88,"بني وطني ماذا أؤمل بعدما","https://www.aldiwan.net/poem44979.html","الطويل"],[88,"لعمرك ما كل انكسار له جبر","https://www.aldiwan.net/poem45069.html","الطويل"],[23,"ألا أبلغ المستمعين لوقعة","https://www.aldiwan.net/poem21239.html","الطويل"],[72,"سرى والدجى كالصدر بالهم ملآن","https://www.aldiwan.net/poem20168.html","الطويل"],[51,"ما أنس لا أنس هندا آخر الحقب","https://www.aldiwan.net/poem8298.html","البسيط"],[51,"ألم تر أن المال يهلك أهله","https://www.aldiwan.net/poem65509.html","الطويل"],[70,"علا حس النواعير","https://www.aldiwan.net/poem42906.html","الهزج"],[43,"ألا كل ماشية الخيزلى","https://www.aldiwan.net/poem9448.html","المتقارب"],[43,"قفا تريا ودقي فهاتا المخايل","https://www.aldiwan.net/poem9986.html","الطويل"],[43,"عزيز أسى من داؤه الحدق النجل","https://www.aldiwan.net/poem9987.html","الطويل"],[62,"يسود الفتى قومه بالفعال","https://www.aldiwan.net/poem52451.html","المتقارب"],[45,"محا نور النواظر والعقول","https://www.aldiwan.net/poem65643.html","الوافر"],[45,"لأية حال أعلن الوجد كاتمه","https://www.aldiwan.net/poem65658.html","الطويل"],[28,"لو أعلم الأيام راجعة لنا","https://www.aldiwan.net/poem5276.html","الطويل"],[28,"لنا ما تمنينا من العيش ما دعا","https://www.aldiwan.net/poem5337.html","البسيط"],[61,"يغض الطرف عن ورد الخدود","https://www.aldiwan.net/poem51717.html","الوافر"],[58,"كم أديب فطن عالم","https://www.aldiwan.net/poem30861.html","السريع"],[58,"أقيك بنفسي أيها المصطفى الذي","https://www.aldiwan.net/poem30919.html","الطويل"],[49,"إذا ما سألت المرء هنت عليه","https://www.aldiwan.net/poem63173.html","الطويل"],[66,"كفرض الصلاة فروض الصلات","https://www.aldiwan.net/poem38744.html","المتقارب"],[80,"أيا جزعي بالدار إذ عن لي الجزع","https://www.aldiwan.net/poem31387.html","الطويل"],[44,"أيا ويل الشجي من الخلي","https://www.aldiwan.net/poem30326.html","الوافر"],[44,"شهدت لقد أقوت مغانيكم بعدي","https://www.aldiwan.net/poem30537.html","الطويل"],[74,"أرأيك أمضى أم حسامك يقطع","https://www.aldiwan.net/poem13174.html","الطويل"],[33,"فمن يتبع آثارنا في محلنا","https://www.aldiwan.net/poem25941.html","الطويل"],[105,"مصيبة أمة وأنا المصاب","https://www.aldiwan.net/poem41138.html","الوافر"],[81,"لولا قضاؤك بين الحكم والحكم","https://www.aldiwan.net/poem61492.html","البسيط"],[52,"يا بديعا بلا شبيه","https://www.aldiwan.net/poem26577.html","مجزوء البسيط"],[67,"إلهي على كل الأمور لك الحمد","https://www.aldiwan.net/poem18053.html","الطويل"],[75,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[48,"سقيا لحرب جنيتها عبثا","https://www.aldiwan.net/poem66586.html","المنسرح"],[48,"سقيا لحرب أنا أحييها","https://www.aldiwan.net/poem66587.html","المنسرح"],[46,"إذا صاحبت في أيام بؤس","https://www.aldiwan.net/poem22027.html","الوافر"],[46,"ترنم في نهارك مستعينا","https://www.aldiwan.net/poem22214.html","الوافر"],[46,"إذا المرء لم يغلب من الغيظ سورة","https://www.aldiwan.net/poem22451.html","الطويل"],[46,"ألا يكشف القصاص وال فإن هم","https://www.aldiwan.net/poem22933.html","الطويل"],[46,"تزوج بعد واحدة ثلاثا","https://www.aldiwan.net/poem22963.html","الوافر"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55170","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67319","الطويل"],[47,"","https://poetry.dctabudhabi.ae/diwan/poem/883","الوافر"],[45,"لأَيَّةِ حالٍ أَعْلَنَ الوَجْدَ كاتِمُهْ","https://www.poetsgate.com/ViewPoem.aspx?id=32082",""],[51,"ألم ترَ أن المال يُهلكُ أهلَهُ","https://www.poetsgate.com/ViewPoem.aspx?id=29878",""]],"verses":[["وَمَن جَعَلَ القَلبَ الجَريءَ دَليلَهُ","فَكُلَّ ظَلامِ عِندَهُ غَيرُ مُظلِمِ",0,"م",1,0],["وَمَن جَعَلَ الدَليلَ لَهُ اِبنَ لَيلى","فَلَن يَخشى الضَلالَ وَلا الغِلاطا",1,"ط",2,0],["وَمِن جَبَلٍ أَعدَدتُ شُمَّ هِضابِهِ","مَرَدّاً لِأَيدي النائِباتِ الكَوارِثِ",2,"ث",1,0],["وَمَنجوبٌ لَهُ مِنهُنَّ صَرعٌ","يَميلُ إِذا عَدَلتَ بِهِ الشَوارا",3,"ر",2,0],["ومَنْ جهِلَ الحُقوقَ أطاعَ نفْساً","ببَحْرِ الجهْلِ راسِبَةً غَريقَهْ",4,"ق",2,0],["ومَنْجَى نيقَةٍ أمْرٌ بَعيدٌ","إذا نصَبَ المهَنْدِسُ مَنْجَنيقَهْ",4,"ق",2,0],["وَمِنْ جَبَلٍ لِلْحِلْمِ أَشْرَفَ وَاعْتَلَى","فَدَانَتْ لَهُ بِالْعِزَّةِ الْقُلَلُ الشُّمُّ",5,"م",1,0],["وَمِنْ جَمَالٍ وَكَمَالٍ","جَلَّ رَبٌّ أَبْدَعَهْ",6,"ع",2,0],["وَمَنْ جُمْهُورٌ تَخَالُ رِجَالَهُمْ","نِسَاءٌ مُحَلاَّةً وَنِسْوَتَهُمْ دُمَى",7,"م",2,0],["وَمِن جَوفِ ماءٍ عَرمَضُ الحَولِ فَوقَهُ","مَتى يَحسُ مِنهُ مائِحُ القَومِ يَتفُلِ",8,"ل",1,0],["وِمِن جَردٍ غُفلٍ بَساطٍ تَحاسَنَت","بِهِ الوَشي قَرّاتُ الرِياحِ وَخورُها",9,"ر",3,0],["وَمِن جَوفِ أَصواءٍ يَصيحُ بِها الصَدى","لِمُترِبَةِ الأَخفافِ صُفرٍ غُرورُها",9,"ر",3,0],["ومن جمال كل من راءه","يبلغ منه الغاية القُصوى",10,"ص",3,0],["ومن جهلنا استكراهُنا في معاشنا","شقاءً نزيهاً للنعيم المدنّس",11,"س",1,0],["ومن جمرات الشعر رنّة ثاكل","مفجّعة أودى بواحدها الدهر",12,"ر",1,0],["وَمَن جَدُّهُ الأَدنى أَبي وَاِبنُ أُمِّهِ","لِأُمِّ أَبي ذاكَ الشَهيدُ المُجاهِدُ",13,"د",1,0],["ومن جودِ مولانا علاً ومناصبٌ","وعلمٌ لنظَّام الثناء وتبيان",14,"ن",1,0],["ومن جبى المال للسلطان دونهمُ","أعداهُ إثماً وعاراً لازبَ الجَرَبِ",15,"ب",1,0],["ومن جاور الماء الغزير مجمُّهُ","وسد سبيل الماء فهو غريقه",16,"ه",1,0],["وَمِن جَدٍّ وَمِن هَزَلٍ","وَمِن حَقٍّ وَمِن زورِ",17,"ر",1,0],["وَمَن جَهِلَت نَفسُهُ قَدرَهُ","رَأى غَيرُهُ مِنهُ مالا يَرى",18,"ا",1,0],["وَمِن جاهِلٍ بي وَهوَ يَجهَلُ جَهلَهُ","وَيَجهَلُ عِلمي أَنَّهُ بِيَ جاهِلُ",19,"ل",1,0],["وَمِن جَسَدي لَم يَترُكِ السُقمُ شَعرَةً","فَما فَوقَها إِلّا وَفيها لَهُ فِعلُ",20,"ل",1,0],["ومن جوهرِ السيفِ صارَ الحديد","بقيمةِ أضعافِه عَسْجَدَا",21,"د",2,0],["وَمِن جَلَلِ الخُطوبِ نَعِيُّ ناعٍ","أَتانا عَنكَ بِالخَطبِ الجَليلِ",22,"ل",1,0],["وَمَن جَهِلَ الأَمرَ الَّذي هُوَ غايَةٌ","لَمَبدَإِنا هَذا فَإِنَّكَ عالِمُه",23,"م",2,0],["وَمِن جَفنَةٍ كانَ اليَتامى عِيالَها","وَسابِغَةٍ تَغشى بَنانَ الأَصابِعِ",24,"ع",1,0],["وَمُنجَرِدُ السُهبانِ أَيسَرُ ما بِهِ","سَليبُ صُهارٍ أَو قُصاعٌ مُؤَلَّفُ",25,"ف",1,0],["ومن جَوْرِ الهَوى أن راحَ يُزْجي","مَطايا البَيْنِ في أَثَرِ الصُّدودِ",26,"د",1,0],["وَمِن جَهولٌ مُكثِرٍ مالَهُ","ذَلِكَ تَقديرُ العَزيزُ العَليمِ",27,"م",1,0],["وَمِن جَدِّهِ جَدي وَمِن عَمهِ أَبي","وَمِن نَجلِهِ نَجلي وَمِن بِنتِهِ أَهلي",28,"ي",1,0],["وَمَن جاءَ يَبغي ما لَدَيكَ فَأَرضِهِ","بِجُهدِكَ وَاترُك ما يَكونُ لَدَيهِ",29,"ي",2,0],["وَمَن جادَ بَعدَ تَمادي المَطالِ","فَإِنَّ العَطِيَّةَ أَجرُ السُعاةِ",30,"ا",2,0],["وَمُنجَرِدٍ كالسيدِ يعُمِلُ أَرضَهُ","فَيبني سماءً فوقه سمكها النّقعُ",31,"ع",1,0],["وَمِن جودٍ لَهُ حَولي صَريفٌ","بِنابَيهِ وَمِن عُرفٍ فَتِيِّ",32,"ي",1,0],["وَمِن جيدِ غَيداءِ التَثَنّي كَأَنَّما","أَتَتكَ بِلَيتَيها مِنَ الرَشَأِ الفَردِ",33,"د",1,0],["وَمُنجَرِدٌ ضَخمُ الجُزارَةِ أَوحَدٌ","يَطيرُ بِهِ تَحتَ العَجاجَةِ أَربَعُ",34,"ع",1,0],["وَمُنجَدِلاً كَالحَبلِ مِن سَورَةِ الكَرى","يَرى الحَجَرَ المُلقى فِراشاً مُمَهَّدا",35,"د",2,0],["ومن جهل الوغى اشتبهت عليه","ذئاب القفر والأسد الغضاب",36,"ب",1,0],["وَمَن جَرى نَيلُهُ بَحراً فَغاصَ بِهِ","أَهلُ الثَناءِ عَلى دُرٍّ مِنَ الكَلِمِ",37,"م",1,0],["وَمَن جَفاني فَلا أَراهُ","هَب لي رُقاداً أَراكَ فيهِ",38,"ه",1,0],["ومنْ جَمَعَ القرآنَ فاجْتَمَعَتْ به","فضائلُ منهُ مِثْلَ مَا اجْتَمَعَ الزُّبْدُ",39,"د",1,0],["ومِن جبَابرَةِ الدّنْيا الذينَ خَلَوْا","وأنْزَلَ اللّهُ فيهم وَحْيَهُ فتُلى",40,"ل",2,0],["ومنجنيقُ القذافِ بربطهُ","وقَذفةُ الضربِ بالرواثينِ",41,"ن",1,0],["ومنجنيقاتُنا المعازفُ والعيدا","نُ إذا سوّيت ملاويها",42,"ي",3,0],["وَمَن جَعَلَ السَخاءَ لِأَقرَبيهِ","فَلَيسَ بِعارِفٍ طُرُقَ السَخاءِ",43,"خ",3,0],["وَمَن جاوَرتَ مِن حُنُفٍ وَسِربٍ","صَوابيءَ فَليَبِنَّ مُكَرَّماتِ",44,"ت",1,0],["وَمَن جَمَعَ الضَرّاتِ يَطلُبُ لَذَّةً","فَقَد باتَ في الإِضرارِ غَيرَ سَديدِ",45,"د",1,0],["وَمَن جاءَ مِنهُم واثِقاً بِشَفاعَةٍ","فَكَم شافِعٍ في هَيِّنٍ لا يُشَفَّعُ",46,"ع",1,0],["وَمَن جَمَعَ اِثنَتَينِ فَما تَوَخّى","سَبيلَ الحَقِّ في خَمسٍ وَرُبعِ",47,"ع",1,0],["وَمَنْ جَدَّ فِي التَّصْرِيفِ لِلأمْرِ جِدَّهُ","وَقَدْ بَاتَ فِي تَصْرِيفِهِ العَقْدُ وَالْحَلُ",48,"ل",1,0],["ومَنْجُوفةٌ جِرْمِيَّةٌ صَاعِديَّةٌ","يُذَرُّ عليها السّمُّ سَاعةَ تَصْنَعُ",49,"ع",1,0],["وَمِن جَرّاكِ أوطِنتُ الفَيافي","وَفيكِ غُذيتُ أَلبانَ اللِقاحِ",50,"ح",1,0],["وَمَنْ جَهِلَ الأمْرَ الذي هُوَ غَايَةٌ","لِمَبْدَائِنَا هَذا، فإنّكَ عَالِمُهْ",51,"م",2,0],["ومن جاورَ الماءَ العزيز مَجمُّهُ","وسدّ سبيل الماء فهو غريقه",52,"ه",1,0]]}