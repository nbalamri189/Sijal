{"poems":[[53,"إذا أجاد الذي يشبهه","https://www.aldiwan.net/poem9207.html","المنسرح"],[53,"لي صديق إذا رأت","https://www.aldiwan.net/poem62008.html","مجزوء الخفيف"],[82,"أين مني عتب أحباب هجود","https://www.aldiwan.net/poem31481.html","الرمل"],[107,"نظم المجد لأبطال الحمى","https://www.aldiwan.net/poem42072.html","الرمل"],[107,"يا أبا العاص أي أرض تريد","https://www.aldiwan.net/poem43996.html","الخفيف"],[107,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[132,"أنت يا مقلتي أسقمت حالي","https://www.aldiwan.net/poem50549.html","الخفيف"],[154,"قل لمن يحسدكم","https://www.aldiwan.net/poem68538.html","مجزوء الرمل"],[164,"ليتهم كانوا يهودا","https://www.aldiwan.net/poem59208.html","مجزوء الرمل"],[186,"قال كم صانع الزمان حميرا","https://www.aldiwan.net/poem67059.html","الخفيف"],[325,"ما لعيني قريره","https://www.aldiwan.net/poem67225.html","مجزوء الرمل"],[563,"لمتى أنت في الضلال المبين","https://www.aldiwan.net/poem33722.html","الخفيف"],[573,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77508","الرجز"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130620","الرمل"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75907","الرمل"],[2907,"","https://poetry.dctabudhabi.ae/diwan/poem/127383","الرمل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216818","الرمل"],[3993,"","https://poetry.dctabudhabi.ae/diwan/poem/107505","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81282","الخفيف"],[4228,"","https://poetry.dctabudhabi.ae/diwan/poem/81234","الخفيف"],[4481,"","https://poetry.dctabudhabi.ae/diwan/poem/34004","الرمل"],[4811,"الى البردوني ورحمة الله","https://www.poetsgate.com/ViewPoem.aspx?id=198338",""],[4935,"قلت للعالم في صدق المقال","https://www.poetsgate.com/ViewPoem.aspx?id=129322",""],[5183,"قال","https://www.poetsgate.com/ViewPoem.aspx?id=186485",""],[5776,"الحكيمُ الرابع","https://www.poetsgate.com/ViewPoem.aspx?id=199327",""],[406,"كاترينا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66905&r=&rc=11",""],[6352,"حزت بالكاظمين شأنا كبيرا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=22745&r=&rc=6",""]],"verses":[["قال كُرَاتُ الأديم قد حُشِيَتْ","بسِمْسِمٍ قُمِّعَتْ بكَيْمَخْتِ",0,"ت",1,0],["قال كانت فُليتةً","فوَقَى اللَّه شرَّها",1,"ر",3,0],["قَالَ كَم تَظما مِنَ الظَّلْمِ إلى","مَوْرِدٍ لم تَرْوَ منهُ بِوُرود",2,"د",1,0],["قال كلَّا لستُ ممَّن يَتَّقي","عاصفَ الموتِ إذا الموتُ ارْتَمى",3,"م",2,0],["قالَ كلا فلستُ أبدأَ دِيني","بالتي يَأنفُ الشَّريفُ الرَّشيدُ",4,"د",1,0],["قال كلاَّ لن يعبُدَ اللّهُ سِرّاً","ويُرَى نُورُ دينهِ مستورا",5,"ر",2,0],["قال كل الذي عرضت علينا","أيها الشيخ الهِمُّ شيءٌ حقير",6,"ر",1,0],["قالَ كلٌّ منكم تعاونتم طُرَّا","علَى كلِّ باطلٍ وضَلالٍ",7,"ل",1,0],["قال كم ذا تفرغون","الشّكر والذّكر عليه",8,"ي",2,0],["قال كل الخلق شيء","وهو الله اضطرارا",9,"ر",2,0],["قالَ كَم صانعَ الزَمانُ حَميراً","يَتَخطّونَ فَوقَ بُسُطِ الحَريرِ",10,"ر",1,1],["قالَ كَيفَ الأَمرُ يَخفى","أَينَ هاتيكَ البَصيرُهُ",11,"ر",2,0],["قال كن للورى فكانوا جميعاً","وهو أمر مرتب التعيين",12,"ن",1,0],["قال كما قال الذين قد بدا","بذكرهم من ادعى محمدا",13,"د",2,0],["قالَ كَبيرهم رَأَيت حيله","وَهيَ عَلى خلاصنا جَميله",14,"ه",1,0],["قال كل الصيد في جوف الفرا","قلت ما اضللت نهجا فاحذر",15,"ر",1,0],["قال كُفُّوا ما بِهِ مِن جُنَّةٍ","إِنَّما سَهمِيَ فيهِ قَد نَفذ",16,"ذ",1,0],["قال كن من شئت علما","ثم قل لي ما الوجود",17,"د",1,0],["قال كوني محنة للأبرياء","فأطاعت يا لها من فاجرة",18,"ه",1,0],["قال كوني محنة للأبرياء","واخسأي أيتها النفس العقيم",18,"م",1,0],["قال كن عبدي فلما أن أبى","قال كن صخرا كما شئت فكان",18,"ن",1,0],["قال كن من تشاءُ إِنَّكَ ضيفي","وَهوَ عندي من أقدسِ الأسماءِ",19,"ا",2,0],["قالَ كُن فَاِستَجاشَ يَقذف دِفا","عاً وَيَجري عَلى الشَواطئ خَمرا",20,"ر",2,0],["قالَ كِلتاهُما مِن النور تَفضى","بِنَبي مِن رَحمة وَإِخاء",21,"ا",2,0],["قالَ كَالمازِحِ وَاِستَعلَمَني","أَنتَ صَبٌ عاشِقٌ لي أَو لِمَن",22,"ن",1,0],["قال كونوا هوى فكنا غيوما","ان دعا الشوق امطرت افراحا",23,"ح",2,0],["قال كلا إن عقلي ثابت","وأنا والله ممدوح الفعال",24,"ل",1,0],["قال كم قد داعبتني يدُها","قلت بعض اللمس مسّ من خيال",25,"ل",1,0],["قال كم قد لطفت بي حالها","قلت لطف الحسن بالشوق محال",25,"ل",1,0],["قال كم باتت تغنيني الهوى","قلت هاتيكم تعاويذ الخيال",25,"ل",1,0],["قال كم قد طبعت بي قبلاً","قلت راقبها إذا ما الليل طال",25,"ل",1,0],["قال كم قد ضحكت لي وبكت","قلت للعسال لين في النضال",25,"ل",1,0],["قال كم مال أفادتني به","قلت ناهيك فكم مال أمال",25,"ل",1,0],["قال كيف الأمر ما بينهما","قلت حزم وانتباه واعتدال",25,"ل",1,0],["قال كم جادت على ذي فاقة","قلت تلكم خير أمٍّ لعيال",25,"ل",1,0],["قال كم صلت بآناء الدجى","قلت تلك الكنز إن رمت الوصال",25,"ل",1,0],["قال كم صامت وحجت ووفت","بنذور : قلت هاتيك المثال",25,"ل",1,0],["قال كم باتت على مصحفها","قلت : جل الله : هاتيك الكمال",25,"ل",1,0],["قالَ كوني لعاشقِ الّلّيلِ عمّا","وأعيدي لهُ احتلامَ البكارهْ ً",26,"ر",2,0],["قال: كُنْ، خالقُ العباد فكانتْ","لَمْحَةُ العينِ مُهلَةَ الظالمينا",27,"ن",2,0],["قال: كن أنت سيفه المنصورا","ملك عن أب وعن حد سيف",28,"ف",1,0]]}