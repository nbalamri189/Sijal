{"poems":[[51,"إذا أجاد الذي يشبهه","https://www.aldiwan.net/poem9207.html","المنسرح"],[51,"لي صديق إذا رأت","https://www.aldiwan.net/poem62008.html","مجزوء الخفيف"],[80,"أين مني عتب أحباب هجود","https://www.aldiwan.net/poem31481.html","الرمل"],[105,"نظم المجد لأبطال الحمى","https://www.aldiwan.net/poem42072.html","الرمل"],[105,"يا أبا العاص أي أرض تريد","https://www.aldiwan.net/poem43996.html","الخفيف"],[105,"إملإ الأرض يا محمد نورا","https://www.aldiwan.net/poem44227.html","الخفيف"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[126,"أنت يا مقلتي أسقمت حالي","https://www.aldiwan.net/poem50549.html","الخفيف"],[148,"قل لمن يحسدكم","https://www.aldiwan.net/poem68538.html","مجزوء الرمل"],[158,"ليتهم كانوا يهودا","https://www.aldiwan.net/poem59208.html","مجزوء الرمل"],[180,"قال كم صانع الزمان حميرا","https://www.aldiwan.net/poem67059.html","الخفيف"],[318,"ما لعيني قريره","https://www.aldiwan.net/poem67225.html","مجزوء الرمل"],[556,"لمتى أنت في الضلال المبين","https://www.aldiwan.net/poem33722.html","الخفيف"],[566,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["قال كُرَاتُ الأديم قد حُشِيَتْ","بسِمْسِمٍ قُمِّعَتْ بكَيْمَخْتِ",0,"ت",1,0],["قال كانت فُليتةً","فوَقَى اللَّه شرَّها",1,"ر",3,0],["قَالَ كَم تَظما مِنَ الظَّلْمِ إلى","مَوْرِدٍ لم تَرْوَ منهُ بِوُرود",2,"د",1,0],["قال كلَّا لستُ ممَّن يَتَّقي","عاصفَ الموتِ إذا الموتُ ارْتَمى",3,"م",2,0],["قالَ كلا فلستُ أبدأَ دِيني","بالتي يَأنفُ الشَّريفُ الرَّشيدُ",4,"د",1,0],["قال كلاَّ لن يعبُدَ اللّهُ سِرّاً","ويُرَى نُورُ دينهِ مستورا",5,"ر",2,0],["قال كل الذي عرضت علينا","أيها الشيخ الهِمُّ شيءٌ حقير",6,"ر",1,0],["قالَ كلٌّ منكم تعاونتم طُرَّا","علَى كلِّ باطلٍ وضَلالٍ",7,"ل",1,0],["قال كم ذا تفرغون","الشّكر والذّكر عليه",8,"ي",2,0],["قال كل الخلق شيء","وهو الله اضطرارا",9,"ر",2,0],["قالَ كَم صانعَ الزَمانُ حَميراً","يَتَخطّونَ فَوقَ بُسُطِ الحَريرِ",10,"ر",1,1],["قالَ كَيفَ الأَمرُ يَخفى","أَينَ هاتيكَ البَصيرُهُ",11,"ر",2,0],["قال كن للورى فكانوا جميعاً","وهو أمر مرتب التعيين",12,"ن",1,0],["قال كما قال الذين قد بدا","بذكرهم من ادعى محمدا",13,"د",2,0]]}