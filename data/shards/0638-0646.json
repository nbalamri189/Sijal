oem55900.html","الرجز"],[458,"أتمنى والمنى جهد المقل","https://www.aldiwan.net/poem55996.html","الرمل"],[458,"در لها خلف الغمام فسقى","https://www.aldiwan.net/poem56094.html","البسيط"],[458,"من حاكم وخصومي الأقدار","https://www.aldiwan.net/poem56189.html","الكامل"],[458,"هل تقبلون إنابة الدهر","https://www.aldiwan.net/poem56194.html","أحذ الكامل"],[464,"ليست قدوداً ولكن هذه أسل","https://www.aldiwan.net/poem3144.html","عموديه"],[464,"وأنلته عزاً بغير مذلة","https://www.aldiwan.net/poem3180.html","عموديه"],[464,"ولهي في الهوى حديث قديم","https://www.aldiwan.net/poem3279.html","عموديه"],[464,"ما لطيف زار منكم موهنا","https://www.aldiwan.net/poem3343.html","عموديه"],[464,"أشاقك برق بالشآم يشام","https://www.aldiwan.net/poem3487.html","عموديه"],[464,"لو عاد طيفكم فعاد عليلا","https://www.aldiwan.net/poem3602.html","عموديه"],[465,"الموجعة","https://www.aldiwan.net/poem59030.html","عموديه"],[479,"ظننت ظنا عانى","https://www.aldiwan.net/poem36878.html","المجتث"],[493,"ومجلس حل من يحل به","https://www.aldiwan.net/poem67406.html","المنسرح"],[500,"حسد الولي الجاهل","https://www.aldiwan.net/poem37807.html","مجزوء الكامل"],[509,"لقد شهدت حقاً سدوس بأنني","https://www.aldiwan.net/poem748.html",""],[515,"إذا قدرت على العلياء بالغلب","https://www.aldiwan.net/poem12009.html","البسيط"],[515,"قدك مثل الغصن في اعتداله","https://www.aldiwan.net/poem12217.html","الرجز"],[529,"ظني بربي مليح","https://www.aldiwan.net/poem37475.html","المجتث"],[538,"ظننت الحمار بليدا فلما","https://www.aldiwan.net/poem47486.html","عموديه"],[538,"تجلت معاني الطعن من قدك اللدن","https://www.aldiwan.net/poem47919.html","عموديه"],[551,"رضيت بالدون لما لم أجد وزرا","https://www.aldiwan.net/poem47161.html","البسيط"],[551,"أنتم علي وإن لم","https://www.aldiwan.net/poem47175.html","المجتث"],[551,"إن كنت يا عمرو قد أسأت فقد","https://www.aldiwan.net/poem47227.html","المنسرح"],[551,"ظننتم محل الأمر فيكم وعندكم","https://www.aldiwan.net/poem47807.html","الطويل"],[551,"حلفت بمن لاذت قريش ببيته","https://www.aldiwan.net/poem47812.html","الطويل"],[553,"أغرى به الشوق ليل الساهر الرمد","https://www.aldiwan.net/poem68425.html","البسيط"],[558,"ظن الجهول بأنه مستيقظ","https://www.aldiwan.net/poem33543.html","الكامل"],[558,"ظهر الوجود من العدم","https://www.aldiwan.net/poem33877.html","مجزوء الكامل"],[558,"لا تظلم الله بما لا يليق","https://www.aldiwan.net/poem34298.html","السريع"],[558,"ظهرت ذاتي لذاتي","https://www.aldiwan.net/poem34729.html","مجزوء الرمل"],[558,"خلني في محبة المحبوب","https://www.aldiwan.net/poem34963.html","الخفيف"],[562,"لاحت من الغرب في وقت الغروب لنا","https://www.aldiwan.net/poem52724.html","البسيط"],[562,"خذوا حذركم من طرفه فهو قتال","https://www.aldiwan.net/poem52839.html","الطويل"],[562,"الزهر تبسم نورا عن أقاحيها","https://www.aldiwan.net/poem52974.html","البسيط"],[563,"تخافقت البروق على الغميم","https://www.aldiwan.net/poem13599.html","الوافر"],[564,"يأتي على الناس إصباح وامساء","https://www.aldiwan.net/poem822.html",""],[567,"ياعوضا من فائت","https://www.aldiwan.net/poem69617.html","مجزوء الرجز"],[573,"بشراي دالت دولة المعصوم","https://www.aldiwan.net/poem3641.html","الكامل"],[575,"قد شاب شارب من أحب فجاز لي","https://www.aldiwan.net/poem2870.html","الكامل"],[575,"جاءت بحسن مطمئن","https://www.aldiwan.net/poem3000.html","مجزوء الكامل"],[575,"لست أدري بأي فتح تهنا","https://www.aldiwan.net/poem3001.html","الخفيف"],[586,"قف بالركائب أو سقها بترتيب","https://www.aldiwan.net/poem17440.html","البسيط"]],"verses":[["ظَنَّ بِالعَجزِ أَنَّ حَبسَكَ ذُلٌّ","وَالمَواضي تُصانُ بِالإِغمادِ",0,"د",1,0],["ظَنَّ أَنَّ المَدى يَطولُ وَفي الآ","مالِ ما لا يُعانُ بِالإِجدادِ",0,"د",1,0],["ظَنٌّ مِنَ القَومِ يَرمونَ البَريءَ بِهِ","وَما نَجيُّكِ مِنهُم نافِرَ الجاشِ",1,"ش",1,0],["ظَنَّ أَو كادَ أَنَّ أَوَّلَ نَومٍ","نامَهُ كانَ تَحتَ تِلكَ الرِمالِ",2,"ل",1,0],["ظَنَّ بَأسَ الحَديدِ فارَقَ مَثوا","هُ اِجتِواءً وَحَلَّ عودَ الخِلالِ",2,"ل",1,0],["ظَنَّ يا سَعدُ أَن يَرى مِهرَجاناً","فَرَأى مَأتَماً وَحَشداً عُجابا",3,"ب",2,0],["ظَنَّت سُكوتِيَ صَفحاً عَن مَوَدَّتِهِ","فَأَسلَمَتني إِلى هَمٍّ وَتَسهيدِ",4,"د",1,0],["ظَنَّ بِهِ طوجو فَأَهدى لَهُ","تَحِيَّةً طوجو بِها أَخبَرُ",5,"ر",1,0],["ظَنّوكَ مِنهُم وَقَد أَنشَأتَ تَخطُبُهُم","بِما عَنا لَكَ مِن سِحرٍ وَتِبيانِ",6,"ن",1,0],["ظَنَّ الحَقيقَةَ في الأَشعارِ تَنقُصُنا","وَاللَفظَ وَالقَصدَ وَالتَصويرَ في آنِ",6,"ن",1,0],["ظَنَّتا ذَلِكَ المَكانَ خَلاءً","لا رَقيباً يُخشى وَلا نَمّاما",7,"م",2,0],["ظَنَنتُ سُلَيماناً جَواداً يَهِزُّهُ","مَديحي وَتُستَجدى بِسِحري مَواهِبُه",8,"ب",2,1],["ظَنَّ العِدا إِذ أَغَبَّت أَنَّها اِنقَطَعَت","هَيهاتَ لَيسَ لِمَدِّ البَحرِ مُنقَطَعُ",9,"ع",1,0],["ظَنُّوهُ بِالتَّاجِ يَرْضَى غَيْرَ مُكْتَرِثٍ","لِمَا عَدَاهُ فَأَلْقَى التَّاجَ وَهْوَ أَبِي",10,"ب",2,0],["ظَنوا بِمُلْكِكَ مِنْ طُولِ المَدَى هَرَماً","سَيَعْرِفُونَ فَتىً مَا مَسَّهُ الْهَرَمُ",11,"م",1,0],["ظننتُ بأن تنجو بها كلاَّ ولو","أغريتَه بأرانب الأقمارِ",12,"ر",1,0],["ظَنَنتُم بِأَن يَخفى الَّذي قَد صَنَعتُمُ","وَفيكُم نَبِيٌّ عِندَهُ الحُكمُ واضِعُه",13,"ع",2,0],["ظنُّوا السؤال خديعة وأنا الذي","خدعت يداه بصائرَ العلماء",14,"ا",2,0],["ظنَّ قومٌ شربها رَفثاً","لا سُقُوا من ذلك الرفَثِ",15,"ث",1,0],["ظننَّا طوله يجدِي","بيوم العرض أو يرضي",16,"ي",1,1],["ظنِّي لئن أنا دام لي حرمانُهُ","لألقَّبَنَّ بشاعرٍ كذابِ",17,"ب",1,0],["ظُنُّوا بجيدٍ يكون الحَلْيُ عُوذَتُهُ","هَلْ فوق مِقداره في الأرض مقدار",18,"ر",1,0],["ظنِّي بعدلِ الأميرِ بل ثِقتي","بحرمتي أنه سينتقم",19,"م",1,0],["ظَنَّ الأَنامُ بِنا الظُنو","ن وَما اِجتَرَحنا من نَكيرِ",20,"ر",1,0],["ظَنّوكَ في شُغُلٍ حَتّى دَهِمتَهُمُ","فَأَصبَحوا وَلَهُم عَن ظَنِّهِم شُغُلُ",21,"ل",1,0],["ظَنَّت بِكَ الناسُ الظُنونَ وَإِنَّني","لَأَخافُ بَعدَ الظَنِّ أَن يَتَقَوَّلوا",22,"ل",3,0],["ظَنَّ المَغولُ جُنودَهُم تَحميهُمُ","وَالقِردُ يَحسَبُهُ أَبوهُ غَزالا",23,"ل",2,0],["ظُنَّ خَيراً بِغَيرِهِ","وَبِهِ لا تَظُنُّهُ",24,"ن",2,0],["ظَنَنتُ بِكَ الجَميلَ وَأَنتَ أَهلٌ","بِحَقِّكَ لا تُخَيِّبُ فيكَ ظَنّي",25,"ن",2,0],["ظُنَّ خَيراً بَينَنا أَو غَيرَهُ","فَحَبيبي فيهِ تَحلو التُهَمُ",26,"م",1,0],["ظنوا بأن الشعر ألفاظ لها","في النظم أوزان وبضع قوافي",27,"ي",1,0],["ظن ابن آوى انه اسد الشرى","حتى اذا لقي الهزبر تحامى",28,"م",2,0],["ظنناها أعزّ من السحاب","وأمنع في الطوابي من عُقاب",29,"ا",2,0],["ظَنَّ فِرعَونُ أَنَّ موسى لَهُ وا","فٍ وَعِندَ الكِرامِ يُرجى الوَفاءُ",30,"ا",2,0],["ظَنَّوا بنا السُوءَ وارتابُوا فنزَّهَنا","بَردُ المضاجعِ عمَّا راب من تهمِ",31,"م",1,0],["ظَنَّ الظُنونَ صَواعِداً فَرَدَدنَهُ","خَزيانَ يَحمِلُ مَنكِباً مَنكوبا",32,"ب",2,0],["ظَنَنتَ أَنَّكَ بِالأَلفِ الَّتي جَشِمَت","يَداكَ مِن بَعدِ تَعسيرٍ وَتَنكيدِ",33,"د",1,0],["ظَنٌ يُصيبُ بِهِ الغُيو","بَ إِذا تَوَخّى أَو تَعَمَّد",34,"د",1,0],["ظَنَنتَ فيها الغِنى فَتَأخُذَها","مِن شاعِرٍ أَم حَسِبتَها كَمَرَه",35,"ر",2,0],["ظُنونُ الناسِ تَذهَبُ فيهِ عُلواً","فَحَقِّق مُنعِماً تِلكَ الظُنونا",36,"ن",2,0],["ظَنَنتُ بِهِ الَّتي سَرَّت صَديقي","فَكانَ الظَنُّ قُدّامَ اليَقينِ",37,"ن",1,0],["ظَنَّ الخَلِيُّ بِأَن أُحاوِلَ بَعدَهُم","سَكَناً وَدامَ بِعَدلِهِ إيقاظي",38,"ي",1,0],["ظَنّي جَميلٌ فيكَ يا مَن أَصبَحَت","تَرنو إِلى نَعمائِهِ أَلحاظي",38,"ي",1,0],["ظَنَّ حَبيبي راضِياً بِسَعيِهِ","فَشَنَّ غاراتِ الأَذى وَسَنّا",39,"ن",2,0],["ظَنَّ قَومي أَنَّ الأُساةَ سَتَبري","داءَ وَجدِيَ وَالعِلاجُ يُفيدُ",40,"د",1,1],["ظَنّوا الوِلاياتِ أَن تَدومَ لَهُم","فَاِقتَطَعوا بِالبِلادِ وَاِقتَسَموا",41,"م",3,0],["ظَنَّ قَومي أَنَّ الأُساةَ سَتَبري","داءَ وَجدي وَذاكَ شَيءٌ بَعيدُ",42,"د",1,1],["ظَنَنتُ حِبالَ السِحرِ ما قَد أَتوا بِهِ","وَتِلكَ عَصا موسى لَها تَتَلَقَّفُ",43,"ف",1,0],["ظَنّوا السَحابَ إِذا نَشَأنَ عَجاجَةً","وَالبَرقَ بيضاً وَالرُعودَ بُنودا",44,"د",2,0],["ظَنّوا تَأَنّيكَ عَن عَجزٍ وَما عَلِموا","أَنَّ التَأَنّي فيهِم يَعقُبُ الظَفَرا",45,"ر",2,0],["ظَنّوا الوِلايَةَ أَن تَدومَ عَليهِمُ","هَيهاتَ لَو دامَت لَهُم دامَت لَنا",46,"ن",2,0],["ظَنَّت تَأَنّي البُزاةِ الشُهبِ عَن جَزَعٍ","وَما دَرَت أَنَهُ قَد كانَ تَهوينا",47,"ن",2,0],["ظَنَّهُ كنزاً فلمّا انْتَسَبَتْ","منهُ للأنفِ درى ذاك النسبْ",48,"ب",1,0],["ظَنّي بِهِ حَسَنٌ لَولا تَجَنّيهِ","وَأَنَّهُ لَيسَ يَرعى حَقَّ حُبّيهِ",49,"ي",2,1],["ظَنُّكَ فيما أُسِرُّهُ حَكَمُ","أَرضى بِهِ لي وَطَرفُكَ الفَهِمُ",50,"م",1,1],["ظَنَنْتُ خَيْراً وَلَمْ أُدْرِكْ عَوَاقِبَهُ","فَكَانَ شَرّاً وَبَعْضُ الظَّنِّ آثَامُ",51,"م",1,0],["ظننتُ أنَّ مشيبي","يصدُّني عَنْ هواها",52,"ه",2,1],["ظُنّوا بربِّ العرشِ ما هو أهلُهُ","لا تقطعوا لمخلِّطٍ بالنارِ",53,"ر",1,1],["ظَنُّها بي ظَنُّ سوءٍ فاحِشٍ","وَبِها ظَنّي عَفافٌ وَكَرَم",54,"م",1,0],["ظنّوا الظنون ولجّوا في عَمايتهم","وفي الحوادث للأقوامِ تِبيانُ",55,"ن",1,0],["ظنّوا الظنونَ بنا فقالوا عُصبةٌ","ترجو المحالَ وإنّنا لَثِقَاتُ",56,"ت",1,0],["ظَنُّوا بهِ من ظُنونِ السُّوءِ ما ضحكتْ","جُنودُهُ منه وَاسْتَحيتْ بَوادِرُهُ",57,"ر",2,0],["ظَنّوا الحَضارَةَ لا تَعدو مَنازِلَهُم","وَلا تُجاوِزَهُم أَيّانَ تَنتسِبُ",58,"ب",1,0],["ظَنَّ الظُنونَ بِكُم مَن لَيسَ يَعرِفُكُم","وَالأَمرُ ذو صُوَرٍ شَتّى وَأَلوانِ",59,"ن",1,0],["ظَنّوا الظُنونَ بِها وَأَعلَمُ أَنَّها","سَتَذوبُ في الدَمِ وَالحَديدِ يَقينا",60,"ن",2,0],["ظَنّوا القُلوبَ تُواليهِم وَغَرَّهُمو","رِضى الذَليلِ وَقَولُ الزورِ وَالمَلَقُ",61,"ق",1,0],["ظَنَنتِ سِواهُ أَن نَزَحَت دُموعي","وَأَن هَدَأَ التَشَوُّقُ وَالحَنينُ",62,"ن",1,0],["ظَننتُمْ به شرّاً وقلتم أصابَهُ","من اللّاتِ ما يَنْهَى الغَوِيَّ عن الإثمِ",63,"م",1,0],["ظَنَنْتَها غزوةً تَخفَى مكائدها","فما احتيالُكَ في السِرِّ الذي ظَهَرا",64,"ر",2,0],["ظَنُّوا الظنُّونَ بهِ فلمَّا اسْتَيْقَنُوا","زَالوا عَنِ الأموالِ وَهْيَ كَثيرُ",65,"ر",1,0],["ظَنُّوا الجنودَ تَنحّتْ عن مَواقفها","لغيرها مِن عَمىً بالقومِ أو حَوَلِ",66,"ل",1,0],["ظَنّوا الأُمورَ لغير اللهِ يَملكها","إذا جَرَتْ بين مُعْوَجٍّ ومُعْتَدِلِ",66,"ل",1,0],["ظُنونٌ يُعفّيها اليقينُ ودَولةٌ","من الوهمِ تذروها الرياحُ العواصفُ",67,"ف",1,0],["ظننّا بهِ خَيراً ولا خيرَ في امرئٍ","أبوه أبو سُوءٍ على الشرِّ عاكِفُ",67,"ف",1,0],["ظنُّوا الضّعافَ عبيداً بئس ما زعموا","هل يَخلقُ اللّهُ قوماً غيرَ أحرارِ",68,"ر",1,0],["ظَنّوا الشَقاوَةَ فيما فيهِ فَوزُهُمُ","لا تَثقُلُ الدِرعُ إِلّا عِندَ مُنهَزِمِ",69,"م",1,0],["ظننتُ بها سوءاً ولم تجنِ بعدما","يُظنُّ به ما أشبه الظنّ بالإثمِ",70,"م",1,0],["ظَنُّوهُمُ عَمَرُوا الدُّنيا بِبَذْلِهمُ","وَإنما خَرَّبُوا الدُّنيا وما عَمَرُوا",71,"ر