.poetsgate.com/ViewPoem.aspx?id=179308",""],[100,"بنوك .. وديوك","https://www.poetsgate.com/ViewPoem.aspx?id=183585",""],[84,"إذا لم تجد إلا الأسى لك صاحبا","https://www.poetsgate.com/ViewPoem.aspx?id=26307",""],[67,"أفيأنفُ الُفَّارُ أنْ يستدركوا","https://www.poetsgate.com/ViewPoem.aspx?id=14556",""],[67,"البردة","https://www.poetsgate.com/ViewPoem.aspx?id=14575",""],[90,"قتل العواطف","https://www.poetsgate.com/ViewPoem.aspx?id=179140",""],[90,"هاشم الوترى","https://www.poetsgate.com/ViewPoem.aspx?id=179237",""],[45,"حَاشَاكِ مِنْ ذِكَرٍ ثَنَتْهُ كَئِيبَا","https://www.poetsgate.com/ViewPoem.aspx?id=31694",""],[45,"إن الطويل وإن قلت حلاوته","https://www.poetsgate.com/ViewPoem.aspx?id=32875",""],[91,"فتح اورشليم","https://www.poetsgate.com/ViewPoem.aspx?id=53229",""],[51,"أبا حسنٍ وأنت فتًى أديبُ","https://www.poetsgate.com/ViewPoem.aspx?id=26849",""],[101,"ظَنَنْتَ الدمْعَ يُسْعِدُ بالْعَزَاءِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=62451&r=&rc=43",""]],"verses":[["ظَنَّ بِالعَجزِ أَنَّ حَبسَكَ ذُلٌّ","وَالمَواضي تُصانُ بِالإِغمادِ",0,"د",1,0],["ظَنَّ أَنَّ المَدى يَطولُ وَفي الآ","مالِ ما لا يُعانُ بِالإِجدادِ",0,"د",1,0],["ظَنٌّ مِنَ القَومِ يَرمونَ البَريءَ بِهِ","وَما نَجيُّكِ مِنهُم نافِرَ الجاشِ",1,"ش",1,0],["ظَنَّ أَو كادَ أَنَّ أَوَّلَ نَومٍ","نامَهُ كانَ تَحتَ تِلكَ الرِمالِ",2,"ل",1,0],["ظَنَّ بَأسَ الحَديدِ فارَقَ مَثوا","هُ اِجتِواءً وَحَلَّ عودَ الخِلالِ",2,"ل",1,0],["ظَنَّ يا سَعدُ أَن يَرى مِهرَجاناً","فَرَأى مَأتَماً وَحَشداً عُجابا",3,"ب",2,0],["ظَنَّت سُكوتِيَ صَفحاً عَن مَوَدَّتِهِ","فَأَسلَمَتني إِلى هَمٍّ وَتَسهيدِ",4,"د",1,0],["ظَنَّ بِهِ طوجو فَأَهدى لَهُ","تَحِيَّةً طوجو بِها أَخبَرُ",5,"ر",1,0],["ظَنّوكَ مِنهُم وَقَد أَنشَأتَ تَخطُبُهُم","بِما عَنا لَكَ مِن سِحرٍ وَتِبيانِ",6,"ن",1,0],["ظَنَّ الحَقيقَةَ في الأَشعارِ تَنقُصُنا","وَاللَفظَ وَالقَصدَ وَالتَصويرَ في آنِ",6,"ن",1,0],["ظَنَّتا ذَلِكَ المَكانَ خَلاءً","لا رَقيباً يُخشى وَلا نَمّاما",7,"م",2,0],["ظَنَنتُ سُلَيماناً جَواداً يَهِزُّهُ","مَديحي وَتُستَجدى بِسِحري مَواهِبُه",8,"ب",2,1],["ظَنَّ العِدا إِذ أَغَبَّت أَنَّها اِنقَطَعَت","هَيهاتَ لَيسَ لِمَدِّ البَحرِ مُنقَطَعُ",9,"ع",1,0],["ظَنُّوهُ بِالتَّاجِ يَرْضَى غَيْرَ مُكْتَرِثٍ","لِمَا عَدَاهُ فَأَلْقَى التَّاجَ وَهْوَ أَبِي",10,"ب",2,0],["ظَنوا بِمُلْكِكَ مِنْ طُولِ المَدَى هَرَماً","سَيَعْرِفُونَ فَتىً مَا مَسَّهُ الْهَرَمُ",11,"م",1,0],["ظننتُ بأن تنجو بها كلاَّ ولو","أغريتَه بأرانب الأقمارِ",12,"ر",1,0],["ظَنَنتُم بِأَن يَخفى الَّذي قَد صَنَعتُمُ","وَفيكُم نَبِيٌّ عِندَهُ الحُكمُ واضِعُه",13,"ع",2,0],["ظنُّوا السؤال خديعة وأنا الذي","خدعت يداه بصائرَ العلماء",14,"ا",2,0],["ظنَّ قومٌ شربها رَفثاً","لا سُقُوا من ذلك الرفَثِ",15,"ث",1,0],["ظننَّا طوله يجدِي","بيوم العرض أو يرضي",16,"ي",1,1],["ظنِّي لئن أنا دام لي حرمانُهُ","لألقَّبَنَّ بشاعرٍ كذابِ",17,"ب",1,0],["ظُنُّوا بجيدٍ يكون الحَلْيُ عُوذَتُهُ","هَلْ فوق مِقداره في الأرض مقدار",18,"ر",1,0],["ظنِّي بعدلِ الأميرِ بل ثِقتي","بحرمتي أنه سينتقم",19,"م",1,0],["ظَنَّ الأَنامُ بِنا الظُنو","ن وَما اِجتَرَحنا من نَكيرِ",20,"ر",1,0],["ظَنّوكَ في شُغُلٍ حَتّى دَهِمتَهُمُ","فَأَصبَحوا وَلَهُم عَن ظَنِّهِم شُغُلُ",21,"ل",1,0],["ظَنَّت بِكَ الناسُ الظُنونَ وَإِنَّني","لَأَخافُ بَعدَ الظَنِّ أَن يَتَقَوَّلوا",22,"ل",3,0],["ظَنَّ المَغولُ جُنودَهُم تَحميهُمُ","وَالقِردُ يَحسَبُهُ أَبوهُ غَزالا",23,"ل",2,0],["ظُنَّ خَيراً بِغَيرِهِ","وَبِهِ لا تَظُنُّهُ",24,"ن",2,0],["ظَنَنتُ بِكَ الجَميلَ وَأَنتَ أَهلٌ","بِحَقِّكَ لا تُخَيِّبُ فيكَ ظَنّي",25,"ن",2,0],["ظُنَّ خَيراً بَينَنا أَو غَيرَهُ","فَحَبيبي فيهِ تَحلو التُهَمُ",26,"م",1,0],["ظنوا بأن الشعر ألفاظ لها","في النظم أوزان وبضع قوافي",27,"ي",1,0],["ظن ابن آوى انه اسد الشرى","حتى اذا لقي الهزبر تحامى",28,"م",2,0],["ظنناها أعزّ من السحاب","وأمنع في الطوابي من عُقاب",29,"ا",2,0],["ظَنَّ فِرعَونُ أَنَّ موسى لَهُ وا","فٍ وَعِندَ الكِرامِ يُرجى الوَفاءُ",30,"ا",2,0],["ظَنَّوا بنا السُوءَ وارتابُوا فنزَّهَنا","بَردُ المضاجعِ عمَّا راب من تهمِ",31,"م",1,0],["ظَنَّ الظُنونَ صَواعِداً فَرَدَدنَهُ","خَزيانَ يَحمِلُ مَنكِباً مَنكوبا",32,"ب",2,0],["ظَنَنتَ أَنَّكَ بِالأَلفِ الَّتي جَشِمَت","يَداكَ مِن بَعدِ تَعسيرٍ وَتَنكيدِ",33,"د",1,0],["ظَنٌ يُصيبُ بِهِ الغُيو","بَ إِذا تَوَخّى أَو تَعَمَّد",34,"د",1,0],["ظَنَنتَ فيها الغِنى فَتَأخُذَها","مِن شاعِرٍ أَم حَسِبتَها كَمَرَه",35,"ر",2,0],["ظُنونُ الناسِ تَذهَبُ فيهِ عُلواً","فَحَقِّق مُنعِماً تِلكَ الظُنونا",36,"ن",2,0],["ظَنَنتُ بِهِ الَّتي سَرَّت صَديقي","فَكانَ الظَنُّ قُدّامَ اليَقينِ",37,"ن",1,0],["ظَنَّ الخَلِيُّ بِأَن أُحاوِلَ بَعدَهُم","سَكَناً وَدامَ بِعَدلِهِ إيقاظي",38,"ي",1,0],["ظَنّي جَميلٌ فيكَ يا مَن أَصبَحَت","تَرنو إِلى نَعمائِهِ أَلحاظي",38,"ي",1,0],["ظَنَّ حَبيبي راضِياً بِسَعيِهِ","فَشَنَّ غاراتِ الأَذى وَسَنّا",39,"ن",2,0],["ظَنَّ قَومي أَنَّ الأُساةَ سَتَبري","داءَ وَجدِيَ وَالعِلاجُ يُفيدُ",40,"د",1,1],["ظَنّوا الوِلاياتِ أَن تَدومَ لَهُم","فَاِقتَطَعوا بِالبِلادِ وَاِقتَسَموا",41,"م",3,0],["ظَنَّ قَومي أَنَّ الأُساةَ سَتَبري","داءَ وَجدي وَذاكَ شَيءٌ بَعيدُ",42,"د",1,1],["ظَنَنتُ حِبالَ السِحرِ ما قَد أَتوا بِهِ","وَتِلكَ عَصا موسى لَها تَتَلَقَّفُ",43,"ف",1,0],["ظَنّوا السَحابَ إِذا نَشَأنَ عَجاجَةً","وَالبَرقَ بيضاً وَالرُعودَ بُنودا",44,"د",2,0],["ظَنّوا تَأَنّيكَ عَن عَجزٍ وَما عَلِموا","أَنَّ التَأَنّي فيهِم يَعقُبُ الظَفَرا",45,"ر",2,0],["ظَنّوا الوِلايَةَ أَن تَدومَ عَليهِمُ","هَيهاتَ لَو دامَت لَهُم دامَت لَنا",46,"ن",2,0],["ظَنَّت تَأَنّي البُزاةِ الشُهبِ عَن جَزَعٍ","وَما دَرَت أَنَهُ قَد كانَ تَهوينا",47,"ن",2,0],["ظَنَّهُ كنزاً فلمّا انْتَسَبَتْ","منهُ للأنفِ درى ذاك النسبْ",48,"ب",1,0],["ظَنّي بِهِ حَسَنٌ لَولا تَجَنّيهِ","وَأَنَّهُ لَيسَ يَرعى حَقَّ حُبّيهِ",49,"ي",2,1],["ظَنُّكَ فيما أُسِرُّهُ حَكَمُ","أَرضى بِهِ لي وَطَرفُكَ الفَهِمُ",50,"م",1,1],["ظَنَنْتُ خَيْراً وَلَمْ أُدْرِكْ عَوَاقِبَهُ","فَكَانَ شَرّاً وَبَعْضُ الظَّنِّ آثَامُ",51,"م",1,0],["ظننتُ أنَّ مشيبي","يصدُّني عَنْ هواها",52,"ه",2,1],["ظُنّوا بربِّ العرشِ ما هو أهلُهُ","لا تقطعوا لمخلِّطٍ بالنارِ",53,"ر",1,1],["ظَنُّها بي ظَنُّ سوءٍ فاحِشٍ","وَبِها ظَنّي عَفافٌ وَكَرَم",54,"م",1,0],["ظنّوا الظنون ولجّوا في عَمايتهم","وفي الحوادث للأقوامِ تِبيانُ",55,"ن",1,0],["ظنّوا الظنونَ بنا فقالوا عُصبةٌ","ترجو المحالَ وإنّنا لَثِقَاتُ",56,"ت",1,0],["ظَنُّوا بهِ من ظُنونِ السُّوءِ ما ضحكتْ","جُنودُهُ منه وَاسْتَحيتْ بَوادِرُهُ",57,"ر",2,0],["ظَنّوا الحَضارَةَ لا تَعدو مَنازِلَهُم","وَلا تُجاوِزَهُم أَيّانَ تَنتسِبُ",58,"ب",1,0],["ظَنَّ الظُنونَ بِكُم مَن لَيسَ يَعرِفُكُم","وَالأَمرُ ذو صُوَرٍ شَتّى وَأَلوانِ",59,"ن",1,0],["ظَنّوا الظُنونَ بِها وَأَعلَمُ أَنَّها","سَتَذوبُ في الدَمِ وَالحَديدِ يَقينا",60,"ن",2,0],["ظَنّوا القُلوبَ تُواليهِم وَغَرَّهُمو","رِضى الذَليلِ وَقَولُ الزورِ وَالمَلَقُ",61,"ق",1,0],["ظَنَنتِ سِواهُ أَن نَزَحَت دُموعي","وَأَن هَدَأَ التَشَوُّقُ وَالحَنينُ",62,"ن",1,0],["ظَننتُمْ به شرّاً وقلتم أصابَهُ","من اللّاتِ ما يَنْهَى الغَوِيَّ عن الإثمِ",63,"م",1,0],["ظَنَنْتَها غزوةً تَخفَى مكائدها","فما احتيالُكَ في السِرِّ الذي ظَهَرا",64,"ر",2,0],["ظَنُّوا الظنُّونَ بهِ فلمَّا اسْتَيْقَنُوا","زَالوا عَنِ الأموالِ وَهْيَ كَثيرُ",65,"ر",1,0],["ظَنُّوا الجنودَ تَنحّتْ عن مَواقفها","لغيرها مِن عَمىً بالقومِ أو حَوَلِ",66,"ل",1,0],["ظَنّوا الأُمورَ لغير اللهِ يَملكها","إذا جَرَتْ بين مُعْوَجٍّ ومُعْتَدِلِ",66,"ل",1,0],["ظُنونٌ يُعفّيها اليقينُ ودَولةٌ","من الوهمِ تذروها الرياحُ العواصفُ",67,"ف",1,0],["ظننّا بهِ خَيراً ولا خيرَ في امرئٍ","أبوه أبو سُوءٍ على الشرِّ عاكِفُ",67,"ف",1,0],["ظنُّوا الضّعافَ عبيداً بئس ما زعموا","هل يَخلقُ اللّهُ قوماً غيرَ أحرارِ",68,"ر",1,0],["ظَنّوا الشَقاوَةَ فيما فيهِ فَوزُهُمُ","لا تَثقُلُ الدِرعُ إِلّا عِندَ مُنهَزِمِ",69,"م",1,0],["ظننتُ بها سوءاً ولم تجنِ بعدما","يُظنُّ به ما أشبه الظنّ بالإثمِ",70,"م",1,0],["ظَنُّوهُمُ عَمَرُوا الدُّنيا بِبَذْلِهمُ","وَإنما خَرَّبُوا الدُّنيا وما عَمَرُوا",71,"ر",3,0],["ظَنُّوا بربِّهِمُ الظُّنُونَ ورُسْلِهِ","وَرَمَوْا إناثاً بالأَذَى وَفُحُولا",72,"ل",2,0],["ظَنُّوا الحَمامِ وظَنُّوا العَنْكَبُوتَ على","خَيْرِ البَرِيِّةِ لَمْ تَنْسُجْ ولمْ تَحُمِ",73,"م",1,0],["ظَنَنتُ أَنّي نِلتُ ما لَم يَنَل","ذو صَبوَةٍ في العُجمِ أَو في العَرَب",74,"ب",1,0],["ظَنَّ بي مَن قَد كَلِفتُ بِهِ","فَهوَ يَجفوني عَلى الظِنَنِ",75,"ن",1,0],["ظَنَّ الحَياةَ عَروساً خَلقُها حَسَنُ","وَإِنَّما هِيَ غولٌ خُلقُها شَرِسُ",76,"س",1,0],["ظَنَنتُ أَنِّيَ وَحدي مُخطِئٌ فَإِذا","أَفعالُ كُلِّ بَني الدُنيا كَأَفعالي",77,"ي",1,0],["ظَنَّ اِرتِقاءً بِكُم جاهِلٌ","وَكُلُّكُم في صَبَبٍ تَهبِطون",78,"ن",1,0],["ظنوا الهدى في الَّذي جاؤوه من عملٍ","وَقَد يَكون ضلالاً ما يُعدُّ هدى",79,"د",2,0],["ظننت بأن الشعر يغني فما أَغنى","وَكَم شاعر في موقفي أخطأ الظنَّا",80,"ن",2,1],["ظنه الناس للفناء وإني","مَع نقصي حسبته للبقاء",81,"ا",2,0],["ظن النساء رجال","صنفاً أذاه يحل",82,"ل",1,0],["ظنَّها من عبقرٍ ناحيةً","أخطأتْ عيناهُ بالأمس صُواها",83,"ا",3,0],["ظنُّوكَ أُقصِيتَ عنها فهي نائمةٌ","وكيف هل في ربوع القدس نُوَّامُ",84,"م",1,0],["ظَنَّ الدُّجى فَظَّةَ الأظفارِ كاسِرَةً","والصّبْحَ نَسْراً فما يَنْفَكّ مَزْؤودا",85,"د",2,0],["ظَنَنَّا الَّذِي نادى مُحِقَّا بمَوْتِهِ","لِعُظْمِ الَّذِي أَنْحَى منَ الرزءِ كاذِبَا",86,"ب",2,1],["ظَنَنتُم يا بَني شَيبانَ ظَنّاً","فَأَخلَفَ ظَنَّكُم جَلدي وَصَبري",87,"ي",1,0],["ظَنَنْتُ بِهِمْ خَيْرَاً فَأُبْتُ بِحَسْرَةٍ","لَهَا شَجَنٌ بَيْنَ الْجَوَانِحِ لاصِقُ",88,"ق",1,0],["ظَنُّوا ابْتِعَادِيَ إِغْفَالاً لِمَنْقَبَتِي","وَذَاكَ عِزٌّ لَهَا لَوْ أَنَّهُمْ فَطَنُوا",89,"ن",3,0],["ظَنَّ بِي سُوءاً وَقَدْ سَاوَمْتُهُ","قُبْلَةً فَازْوَرَّ حَتَّى فَرِكَا",90,"ك",2,0],["ظَنَّ الظُّنُونَ فَبَاتَ غَيْرَ مُوَسَّدِ","حَيْرَانَ يَكْلأ مُسْتَنِيرَ الْفَرْقَدِ",91,"د",1,1],["ظَنَنْتُ أَنَّ النَّوَى تُخَفِّفُ مِنْ","وَجْدِي قَلِيلاً فَزَادَ مَا أَجِدُ",92,"د",1,1],["ظَنَّتْ حُمَاةَ الْحَيِّ قَد غَرَّتْهُمُ","أَقْسَامُ حَنَّاثِينَ فِيهِ حِلاَلِ",93,"ل",1,0],["ظَنَّ فِي الجُمهُورِ أَعَدَاءً لَهُ","مُلِئَتْ أَكْبادُهُمْ ضِغْناً وَدَغْرَا",94,"ر",2,0],["ظَنَنتُ نَفسي وَفهر هَلّا","فِظتُ عَلَيهِ أَسىً وَفاظوا",95,"ظ",3,0],["ظَنَنتُ بِأَنَّ الدَهرَ يَبقى مُسالِماً","وَهَيهاتَ حَربُ النائِباتِ كَظوظُ",96,"ظ",1,0],["ظَنّ العَذُولُ بأنّ العَذْلَ يوقِفُني","نامَ العَذُولُ وشَوقي زائدٌ نامِ",97,"م",1,0],["ظَنَتْتَ الدمْعَ يُسْعِدُ بالْعَزَاءِ","فَهَلْ أَجْدَى بُكَاؤُكَ أَوْ بُكَائي",98,"ا",2,1],["ظنّتِ الغيدُ وما أجرأَها","أنّه من خدِّها المختضِب",99,"ب",1,0],["ظنها تعمُرُ الوجود؛ فكانت","معولاً يترك الوجودَ خرابا!",100,"ب",2,0],["ظننا فيك تَعْزيَةً وسلوى","لمن أنضاه فقر واعتِرار",101,"ر",1,0],["ظننَّا أن في القمر انطلاقًا","أفي القمر انطلاقٌ أم إسَار؟",101,"ر",1,0],["ظنونكم عنا يقينيةٌ","يقيتنا عنكم ، كخوف الشكوك",102,"ك",1,0],["ظننا الذي نادى محقا بموته","لعظم الذي أنجى من الرزء كاذبا",103,"ب",2,0],["ظَنُّوا بربِّهِمُ الظُّنُونَ وَرُسْلِهِ","أوْ خالَفُوا هارُونَ في ذَبْحٍ وَفي",104,"ي",1,0],["ظنُّوا الحمامَةَ وظنُّوا العنكبوتَ على","خيرِ البَرِّيَّةِ لم تَنسُجْ ولم تَحُمِ",105,"م",1,0],["ظننتُني صادقاً فيما ادَّعَيْتُ بها","حتى انبرى لؤمُ جانيها لتكذيبي",106,"ب",2,0],["ظنّاً بأنَّ يدي تُمَدُّ لتشتري","سقطَ المَّتاع ، وأنْ أبيعَ مواهبا",107,"ب",2,0],["ظَنّ الظّنُونَ صَوَاعِداً، فَرَدَدْتَهُ","خَزْيَانَ، يَحمِلُ مَنكِباً مَنكُوبا",108,"ب",2,0],["ظننت أنك بالألف الذي جشمت","يداك من بعد تعسير وتنكيد",109,"د",1,0],["ظنّ المغول جنودهم تحميهم","والقرد يحسنه أبوه غزالا",110,"ل",2,0],["ظننتُ بك الجميلَ فهل تلُمني","فإنك قد تُصيبُ ولا أصيبُ",111,"ب",1,0],["ظَنَنْتَ الدمْعَ يُسْعِدُ بالْعَزَاءِ","فَهَلْ أَجْدَى بُكَاؤُكَ أَوْ بُكَائِي",112,"ا",2,1]]}