5,"كتم الهوى فوشى النحول بسره","https://www.aldiwan.net/poem20801.html","الكامل"],[515,"ضحكت فبان لنا عقود جمان","https://www.aldiwan.net/poem20818.html","الكامل"],[515,"هذا الحمى يا فتى فانزل بحومته","https://www.aldiwan.net/poem20832.html","البسيط"],[516,"أعندك أن وجدي واكتئابي","https://www.aldiwan.net/poem12008.html","الوافر"],[516,"عسى منجد الأظعان يوماً يغيرها","https://www.aldiwan.net/poem12160.html","الطويل"],[516,"أيا أذن الأيام إن قلت فاسمعي","https://www.aldiwan.net/poem12176.html","الطويل"],[516,"الحمد لله الذي","https://www.aldiwan.net/poem12285.html","مجزوء الرجز"],[552,"إذا أنتم لم تشفعوا في قباحة","https://www.aldiwan.net/poem47152.html","الطويل"],[552,"وسائلة لتعرف ما عراني","https://www.aldiwan.net/poem47165.html","الوافر"],[552,"هل الشيب إلا غصة في الحيازم","https://www.aldiwan.net/poem47203.html","الطويل"],[552,"أيا ظبية في ربى جاسم","https://www.aldiwan.net/poem47219.html","المتقارب"],[552,"متى أنا ناج من سهام الغوائل","https://www.aldiwan.net/poem47258.html","الطويل"],[552,"رأيت فلم أر فيما رأيت","https://www.aldiwan.net/poem47836.html","المتقارب"],[554,"ذهلت فلم أنقع غليلا بعبرة","https://www.aldiwan.net/poem68231.html","الطويل"],[554,"أقمت خلافة وأزلت أخرى","https://www.aldiwan.net/poem68342.html","الوافر"],[559,"خذوا علمكم بالله لا تتأخروا","https://www.aldiwan.net/poem34489.html","الطويل"],[559,"إن السماع سماع الناي والوتر","https://www.aldiwan.net/poem34546.html","البسيط"],[560,"سهرت غراما والخليون نوم","https://www.aldiwan.net/poem69344.html","الطويل"],[563,"بشراك بالخير يا لبنان بشراكا","https://www.aldiwan.net/poem52738.html","البسيط"],[568,"محاسن الدير تسبيحي ومساحي","https://www.aldiwan.net/poem69749.html","البسيط"],[570,"أقمت بقصر زربي زمانا","https://www.aldiwan.net/poem52021.html","الوافر"],[574,"يا برق برقاً بين مروة والصفا","https://www.aldiwan.net/poem3646.html","الكامل"],[576,"تذكرت أيام الصبابة والصبا","https://www.aldiwan.net/poem2767.html","الطويل"],[576,"أقمت على عاشقيك القيامه","https://www.aldiwan.net/poem2863.html","المتقارب"],[576,"طراز غرامي في المحبة مذهب","https://www.aldiwan.net/poem2984.html","الطويل"],[576,"أبى صدها أن يجمع الحسن والحسنى","https://www.aldiwan.net/poem3005.html","الطويل"],[576,"شربت شرب الهيم","https://www.aldiwan.net/poem3010.html","مجزوء الرجز"],[586,"عروس الكأس يجلوها نديمي","https://www.aldiwan.net/poem1566.html",""],[587,"أراك فيمتلي قلبي سرورا","https://www.aldiwan.net/poem17512.html","الوافر"],[587,"أدام الله أيام الوصال","https://www.aldiwan.net/poem17685.html","الوافر"],[587,"بلا غيبة للبدر وجهك أجمل","https://www.aldiwan.net/poem18010.html","الطويل"],[588,"بعزك يا ذا الكبرياء والمراحم","https://www.aldiwan.net/poem11517.html","عموديه"]],"verses":[["أَقَمتَهُمُ مِن رَوعَةٍ عَن شِوائِهِم","يَمُشّونَ بِالأَعرافِ كُلَّ بَنانِ",0,"ن",1,0],["أَقَمتُ عَلى ما ساءَ أُذناً وَمُقلَةً","يُبَلِّغُني المَكروهَ سَمعٌ وَناظِرُ",1,"ر",1,0],["أَقَمنا أَنابيبَكُم بِالثِقافِ","وَداوى الهِناءُ مِطالَ الجَرَب",2,"ب",1,0],["أَقَمنا بِالتَجارِب كُلَّ أَمرٍ","أَبى إِلّا اِعوِجاجاً وَاِلتِواءَ",3,"ا",2,0],["أقَمْنا بحيْثُ الطَّلُّ ذابَ سَقيطُهُ","على زَهَرٍ بالمَنْدَليِّ مُضَمَّخِ",4,"خ",1,0],["أقَمْنا بهِ صِغْوَ المَطايا كأنّما","يمُدُّ بِها سَيْراً على الأرضِ خارِزُ",5,"ز",1,0],["أقَمْنا صُدورَ الأرحَبيَّةِ نَحْوَهُ","طَوالِبَ رِفْدٍ لا بَكِيٍّ ولا نَزْرِ",6,"ر",1,0],["أَقَمتُ الحَقَّ بِالهِندِيِّ رَغم","وَأَظهَرتُ الضَلالَ مِنَ الرَشادِ",7,"د",1,0],["أَقَمنا بِالذَوابِلِ سوقَ حَربٍ","وَصَيَّرنا النُفوسَ لَهَ مَتاعا",8,"ع",2,0],["أَقَمتُ بِصارِمي سوقَ المَناي","وَنِلتُ بِذابِلي الرُتَبَ العَلِيَّه",9,"ي",2,0],["أَقَمنا عَلى أَنَّها نِعمَةٌ","تَقَرُّ بِها أَعيُنُ الناظِرينا",10,"ن",2,0],["أَقَمتَ بِالكُرهِ لِلشَكوى مُجاوِرَنا","وَلَو تَخَلَّصتَ مِن شَكواكَ لَم تُقِم",11,"م",1,0],["أَقَمتُ بِبَلدةٍ وَرَحَلتِ عَنها","كِلانا بَعدَ صاحِبِهِ غَريبُ",12,"ب",1,1],["أَقَمْنَا بُرْهَةً ثُمَّ ارْتَحَلْنَا","كَذَاكَ الدَّهْرُ حَالاً بَعْدَ حَالِ",13,"ل",1,1],["أقَمْتَ جِدارَها وأفَدْتَ كَنْزا","ولوْ شِئْتَ اتّخَذْتَ عليْهِ أجْرا",14,"ر",2,0],["أقَمْتَ لمِيلادِ الرّسولِ شَعائِراً","بِها اللهُ عنْ ذَنْبِ المُسيئينَ صافِحُ",15,"ح",1,0],["أَقَمتُ الهَدى فيهِ إِذا المَرءُ غَمَّهُ","سَقيطُ النَدى وَالدّاخِنُ المُتَحَلِّبُ",16,"ب",1,0],["أَقَمتَ عَلَيهِم زاجِراً مِن نُفوسِهِم","إِذا سَوَّلَت أَمراً لَهُم قامَ يَردَعُ",17,"ع",1,0],["أَقَمتُنَّ بِالأَمسِ الأَساسَ مُبارَكاً","وَجِئتُنَّ يَومَ الفَتحِ مُغتَبِطاتِ",18,"ت",1,0],["أَقَمتَ بِهَلكى مالكٍ حينَ عَضَّهُم","زَمَانٌ يَعُرُّ الواجِدينَ عَصيبُ",19,"ب",1,0],["أَقَمْتَ صُرُوحاً لِلثَّقَافَةِ ضَخْمَةً","تُعَانُ عَلَى تَشْيِيدِهَا وَتَعِينُ",20,"ن",1,0],["أَقَمنا أَوَدَ الأَعنا","قِ بِالهِندِيَّةِ البُترِ",21,"ر",1,0],["أَقَمتُ لَهُ سَراهُ بِمُدلَهِمٍّ","أَمَقَّ إِذا تَخاوَصَتِ النُجومُ",22,"م",1,0],["أَقَمتُ لَهُ أَعناقَ هيمٍ كَأَنَّها","قَطاً نَشَّ عَنها ذو جَلاميدَ خامِسُ",23,"س",1,0],["أَقَمتُ لَهُ صَدرَ المَطِيِّ وَما دَرى","أَجائِرَةٌ أَعناقُها أَم قَواصِدُ",24,"د",1,0],["أَقَمتُ بِها إِدلاجَ شُعثٍ يُميلُهُم","سَقامُ السُّرَى تَوصيمُها وَدَبيبُها",25,"ب",3,0],["أقمتَ به من فطرة الدين سُنْةً","وجدْدت في رسم الهداية عافيا",26,"ي",2,0],["أقمتَ به من فطرة الدين سُنّةً","وجدَّدْتَ من رسم الهداية عافيا",27,"ي",2,0],["أَقمت لها الأعذار موسم رحمة","تسنّتْ به للمتقين المآملُ",28,"ل",1,0],["أقمت ببلدة مُلئت حُقوداً","عليّ فكل ما فيها مُريب",29,"ب",1,0],["أقمت لذكرى الخالديّ مقامةً","بها حسنت للقوم منك المقاصد",30,"د",1,0],["أَقَمتَ لَهُم بِمَسكَنِ سوقَ موتٍ","وَأُخرى يَومَ زاوِيَةِ الجُنودِ",31,"د",1,0],["أَقَمنا وَرَبَّتنا الدِيارُ وَلا أَرى","كَمَربَعِنا بَينَ الحَنِيَّينِ مَربَعا",32,"ع",2,1],["أَقَمنا بِما بَينَ الشَرَبَّةِ وَالمَلا","تُغَنّي اِبنَ ذي الجَدَّينِ فينا سَلاسِلُه",33,"ل",2,0],["أَقَمتُ بِأَرضِ الرومِ عامَينِ لا أَرى","مِنَ الناسِ مَحزوناً وَلا مُتَصَنِّعا",34,"ع",2,0],["أَقَمتُ عَلى الأَميرِ وَكُنتُ مِمَّن","يَعُزُّ عَلَيهِ فُرقَتُهُ اِختِيارا",35,"ر",2,0],["أَقَمتُ وَلَو رَطَعتُ رَسيسَ شَوقي","رَكِبتُ إِلَيكَ أَعناقَ الرِياحي",36,"ح",2,0],["أَقَمنا عَلى الرَسِّ النَزيعِ لَيالِياً","بِأَرعَنَ جَرّارٍ عَريضِ المَبارِكِ",37,"ك",1,1],["أَقَمنا لَهُم ضَرباً مُبيراً مُنَكِّلاً","وَحُزناهُمُ بِالطَعنِ مِن كُلِّ جانِبِ",38,"ب",1,0],["أقمت به على نيران برح","فما لي كابن قيس من براح",39,"ح",1,0],["أقمتُ لكي تزدادَ نعماك نعمةً","وتَغْنَى بوجهٍ ناضرٍ غيرِ شاحبِ",40,"ب",1,0],["أقمْهُ مُقامي ناطقاً بمدائحي","لديك وقد صدّرتها بالمنَاسبِ",40,"ب",1,0],["أقْمأَهُ القفْدُ فأضْ","حى قائماً كقاعدِ",41,"د",1,0],["أقِم العقوبةَ والمثوبةَ جانباً","وتخيَّر الحسناءَ في التدوين",42,"ن",1,0],["أَقَمتَ فَخَلّى أَهلُهُ وَبِلادِهِ","إِلى كُلِّ فَجٍّ مِن خَصيبٍ وَقاحِمِ",43,"م",1,0],["أَقَمنَ حَبيساتٍ كَحَبسِكَ مَن جَنى","عَلى أَنَّها لَم تَجنِ يَوماً فَتُحبَسا",44,"س",2,0],["أَقَمنَ بِها رَهينَةَ كُلِّ نَحسٍ","فَما يَعدَمنَ ريحاً أَو قِطارا",45,"ر",2,0],["أقم عندنا لا ترحلّن فإن تُقم","فكل نحوسات الزمان ترحل",46,"ل",1,0],["أقم للحق ديواناً عظيماً","ورخّص كي نُلمَّ به عجالى",47,"ل",2,0],["أَقِمِ المَسالِحَ فَوقَ شُفرِ سُكَينَةٍ","إِنَّ المَنِيَّ بِحَلقَتَيها خِضرِمُ",48,"م",1,0],["أَقَمتُ بِأَرضِ مِصرَ فَلا وَرائي","تَخُبُّ بِيَ المَطِيُّ وَلا أَمامي",49,"م",2,0],["أَقَمتَ بِهِ وَلَم تَألُ اِختِياراً","سَبيلَ الحَجِّ فينا وَالجِهادِ",50,"د",1,0],["أَقمارُ مَروِ الشاهِجانِ إِذا دَجا","خَطبٌ وَأَنجُمُ لَيلِها المُستَحسِرِ",51,"ر",1,0],["أَقَمتَها لِأَميرِ المُؤمِنينِ بِما","في نَصلِ سَيفِكَ إِذ جاءَت بِها البُشُرُ",52,"ر",1,0],["أَقَمنا أَكلُنا أَكلُ اِستِلابٍ","هُناكَ وَشُربُنا شُربٌ بِدارُ",53,"ر",1,0],["أَقمارُ لَيلٍ رُكِّبَت مِن تَحتِها","أَبدانُ حورٍ أُسكِنَتها الأَنفُسُ",54,"س",1,0],["أَقِم بِاِبنِ يَزدادَ الأُمورَ فَإِنَّهُ","لَها خَيرَ والٍ تَصطَفيهِ وَراعِ",55,"ع",1,0],["أَقِم عَلَّها أَن تَرجَعَ القَولَ أَو عَلّي","أُخَلِّفُ فيها بَعضَ ما بي مِنَ الخَبلِ",56,"ل",1,1],["أَقَمتُ مِن سَيبِكُم في يانِعٍ خَضِرٍ","وَسِرتُ مِن جاهِكُم في وابِلٍ خَضِلِ",57,"ل",1,0],["أَقَمتَ سَبيلَ حَجِّهِم بِبَدرٍ","أَضاءَ السَهلَ مِنهُ وَالحُزونا",58,"ن",2,0],["أَقَمتَ بِهِ الأَعناقَ بَعدَكَ فَاِنتَهَت","إِلَيكَ بِأَيدي المُسلِمينَ مُشيرُها",59,"ر",3,0],["أَقَمتُ لَهُ المَيلَ الَّذي في نُخاعِهِ","بِتَفدِيَتي وَاللَيلُ داجٍ غَياطِلُه",60,"ل",2,0],["أَقَمنا بِهِ مِن جانِبَينا نَجيبَةً","بِأَمثالِها حَتّى رَأى جُدَداً شُعلا",61,"ل",2,0],["أَقَمتُ بِها أَعناقَ غيدٍ كَأَنَّها","سُكارى تُفَدّى تارَةً وَتَلومُها",62,"م",3,0],["أَقَمتُ لَها أَعناقَ لازِقَةِ الذُرى","إِلى أَن تَجَلّى بِالبَياضِ بَهيمُها",62,"م",3,0],["أَقَمنا لَهُ صَهباءَ كَالمِسكِ ريحُها","إِقامَتَهُ حَتّى تَرَحَّلَ غادِيا",63,"د",3,0],["أقمتُ وكيفَ يرحلُ عنك راجٍ","رآكَ البحرَ والمَلِكَ الهُماما",64,"م",2,0],["أَقَمْنا لا نَريمُ وسالَمَتْنا","بساحَتِكَ الخطوبُ فما نُرامُ",65,"م",1,0],["أَقمنا نَرى روضَ المحامدِ يُجتلَى","عليكَ وآفاقُ السماحِ تُغَامُ",66,"م",1,0],["أَقمارُ تَمٍّ في سَوادِ حَنادِسٍ","وغُصونُ بانٍ في رِقاقِ شُفوفِ",67,"ف",1,0],["أَقَمْنا لَدَيْها في رياضٍ أنيقَةٍ","نَمارِقُها مَوشِيَّةٌ وقُطوعُها",68,"ع",3,0],["أقمارُ مَجْدٍ تَنجلي","بضيائِها ظُلَمُ الدَّياجِر",69,"ر",1,0],["أَقِمِ الصَلاةَ لِوَقتِها بِطُهورِها","وَمِنَ الضَلالِ تَفاوُتُ الميقاتِ",70,"ت",1,0],["أَقَمتَ لِصَنعَةِ الإِنشاءِ سوقاً","وَكانَت قَبلُ شاكِيَةً كَسادا",71,"د",2,0],["أقمت من عبقري الشعري برهانا","وقبلها كنت للأخلاق عنوانا",72,"ن",2,0],["أَقَمتُ شُهوراً في فَنائِكَ خَمسَةً","لَقىً حَيثُ لا تَهمي عَلَيَّ جَنوبُ",73,"ب",1,0],["أَقِم ثُمَّ حُطَّ الرَحلَ وَالظَنَّ إِنَّهُ","مَضَت قِبلَةُ الأَسفارِ مِن بَعدِ خالِدِ",74,"د",1,0],["أقمْ في الأهلِ في رغدٍ وطيبٍ","بأمري واغتنمْ ذاكَ اغتناما",75,"م",2,0],["أقمت من الآداب ملكا مخلدا","جمعت له الأخلاق تجعلها جندا",76,"د",2,0],["أقم غير مصروف الهوى عن ديارهم","ودع عنك شعبا هازلا ينكر الجدا",76,"د",2,0],["أقمنا لهم فيها المآتِمَ كُلَّما","مَضَى مَشهدٌ مِنهُنَّ أَحْدَثْنَ مَشهدا",77,"د",2,0],["أقِمْ مِن بناءِ الله كلَّ مُهَدَّمٍ","إذا القومُ هَدُّوا كلَّ عالٍ مُمرَّدِ",78,"د",1,0],["أَقِمِ المنارَ لِمُدلجِينَ تنكّبوا","سُبُلَ الرّشادِ وجَدِّدِ النّاموسا",79,"س",2,0],["أقمتم للأُلى ظلموا وجاروا","مآتِمَ تملأُ الدُّنيا رَنينا",80,"ن",2,0],["أَقَمنا عَلى أَعدائِنا الحَربَ نَبتَغي","شِفاءَ الأَذى لَمّا مَلَلنا التَداوِيا",81,"ي",2,0],["أَقَمنا عَلى عَهدَي وَفاءٍ وَأُلفَةٍ","فَما بَينَنا قالٍ وَلا ثَمَّ صارِمُ",82,"م",1,0],["أَقِم مِنآدَها وَاِشدُد قُواها","وَجاهِد في سِياسَتِها جِهادا",83,"د",2,0],["أقمتَ تُراعِي الركبَ حَرَّانَ شَيِّقاً","هَنِيئاً فهذا الركبُ وَافاكَ زائرا",84,"ر",2,0],["أقمتَ على المُسْتَضْعَفِينَ بِمَكَّةٍ","تَرُدُّ الأذَى عنهم وَتَرْعَى الأَواصِرا",84,"ر",2,0],["أقِمِ الصَّلاَةَ على الشَّهيدِ وسِرْ بِهِ","في ظِلِّ رَبِّكَ والملائكُ خُشَّعُ",85,"ع",1,0],["أقمتَ الأرضَ تكره أن تميلا","ألا بَرَزَ الزُبَيْرُ فأيُّ وصفِ",86,"ف",1,0],["أَقَمنا المَيلَ آخِرَةً وَبَدءً","مِنَ الأَحياءِ في الزَمَنِ الطَويلِ",87,"ل",1,0],["أَقَمتُ لَهُم سوقَ الجِلادِ بِمُنصِلي","وَعَلَّمتُهُم طَعنَ الكُلى بِالنَيازِكِ",88,"ك",1,0],["أقمتُ لشربها عَبَثاً وعندي","بناتُ اللهوِ تعبثُ بالعُقار",89,"ر",1,0],["أقَمْنَا فمنْ فُرسانِنا خُطباؤنا","ومنبرُنا من بِيض ما تطبعُ الهِنْد",90,"د",1,0],["أَقَمتِ دَمعي عَلى ما","يَطوي الضَميرُ رَقيبا",91,"ب",2,0],["أَقُمنا بِهِ نُعطي البَطالَةَ حَقَّها","إِذا لَم يَنَل لَذّاتِها الرَجُلُ المُثري",92,"ر",2,0],["أَقَمنا بِها يَوماً وَيَوماً وَثالِثاً","وَيَوماً لَهُ يَومُ التَرَحُّلِ خامِسُ",93,"س",1,0],["أَقَمنا حَلبَةَ اللَهوِ","فَأَجرَينا بِها الكاسا",94,"س",2,0],["أَقَمنا لِأَضيافِنا مَرقَداً","وَما كُلُّ يَومٍ لَهُم مَرقَدُ",95,"د",1,0],["أَقَمتُ وَأَجرَيتُ الصِبا ما وَحى واحٍ","وَأَمسَكتُ عَن بابِ الضَلالَةِ مِفتاحي",96,"ح",2,1],["أَقَمنا عَلى هَذا وَذاكَ نِساءَها","مَآتِمَ تَدعو لِلبُكا فَتُجاوِبُه",97,"ب",2,0],["أَقُمتُ وَكانَ بَعضُ الحَزمِ يَوماً","لِرَكبِ السُفُنِ أَن تُلقي المَراسي",98,"س",2,0],["أَقَمنا في الرِحالِ وَنحنُ سَفرٌ","كَأَنّا قاعِدونَ عَلى الرِحالِ",99,"ل",1,0],["أَقَمتُ بِرَغمي وَما طائِري","بِراضٍ إِذا أَلِفَتهُ الوُكونُ",100,"ن",1,1],["أقْمَعها بالخيل والرّجالِ","من غيرِ ما حربٍ ولا قِتالِ",101,"ل",1,0],["أقَمنا عليها اللهوَ في يومِ عيدِهمْ","فكم لهم فِصحاً بهِ قُطعَ الفصحُ",102,"ح",1,0],["أقمت فيك وقد كا","نَ بي يضر المقام",103,"م",1,0],["أَقمنا إذ الأقوام طراً تقدموا","بمنزلة فيها الرؤوس نواكس",104,"س",1,0],["أقمت بأرض مصر فلا ورائي","تخبّ بي الرّكاب ولا أمامي",105,"م",2,0],["أقمن منتظراتٍ ما شكونَ ضنىً","وقد تعاقبَ إِصباحٌ وإِمساءُ",106,"ا",2,0],["أقِمْ في الأقْرَبِينَ فكُلُّ حَيّ","يُرَاوَحُ بالمَعِيشَةِ أوْ يُغادى",107,"د",2,0],["أَقَمتُ الحَقَّ بِالهِندِيِّ رَغماً","وَأَظهَرتُ الضَلالَ مِنَ الرَشادِ",108,"د",1,0],["أَقَمتُ بِصارِمي سوقَ المَنايا","وَنِلتُ بِذابِلي الرُتَبَ العَلِيَّه",109,"ي",2,0],["أَقَمْنَا بِهِ شَمْسَ النَّهَارِ وَكُلُّنَا","عَلَى مَا بِهِ مِنْ شِدَّةِ الْعُجْبِ يَحْرِصُ",110,"ص",1,0],["أَقَمْتُ بِهَا شَهْرَاً فَأَدْرَكْتُ كُلَّ مَا","تَمَنَّيْتُهُ مِنْ نِعْمَةِ الدَّهْرِ فِي شَهْرِ",111,"ر",1,0],["أَقَمْنَا بِهِ يَوْماً طَلِيقاً وَلَيْلَةً","دُجَاهَا بِلأْلاءِ الْمُدَامِ طَلِيقُ",112,"ق",1,0],["أَقَمْنَا مِهْرَجَانَ دُجىً","يُحَالِفُ ذِكْرُهُ الدَّهْرَا",113,"ر",2,0],["أَقَمْنَا عَلَى المَرْسِ البَرِيعِ لَيَالِياً","بأَرْعَنَ جَزَّارٍ عَرِيضِ المبَاركِ",114,"ك",1,1],["اقمطرّ الشرّ فيه","بعذابِ الزمهَريرِ",115,"ر",1,0],["أقمتم مِهْرجانَ الطبِّ يحُيي","مَعالمَ دَرْسِه عاماً فعاما",116,"م",2,0],["أَقْمَارُ مَمْلَكَةٍ آسَادُ مَلْحَمَةٍ","أَملاَكُ مَرْحَمَةٍ صُنَّاعُ أَقْطَارِ",117,"ر",1,0],["أقمتُ بمصرٍ، عاثر الجدِّ، ساكنًا","كما سكنت أهرامها، والمقطم",118,"م",1,0],["أقمستُ، ما «حرب» وعِترتهُ","إلا النجومُ أحَطْنَ بالبدر",119,"ر",1,0],["أقمت لميلاد الرسول شعائرا","بها الله عن ذنب المسلمين صافح",120,"ح",1,0],["أقمنا على هذا وذاك نساءهُ","مَآتِمَ تَدْعُو للبُكا فتُجاوِبه",121,"ب",2,0],["أقِمْ كتِفَيْكَ لا يُثْقِلْكَ ذُلْ","ولا يشمَتْ بكَ القَصْرُ المُنيف",122,"ف",1,0],["أقمتمُوها عُصوراً في رعايتِكم","لم تَخلُ من آمرٍ منكُم وسُلطان",123,"ن",1,0],["أقمنا بجوٍّ كلُّ ما عند أهله","مجالسُ ألهاها صفير المدائح",124,"ح",1,0],["أقمتُ ، ولوْ أطعتُ رسيسَ شوقي","ركبتُ إليكَ أعناقَ الرياحِ",125,"ح",1,0],["أقَمْنَا بِهِ مِنْ جَانِبَيْهَا نَجِيبَةً","بِأمثالِهَا حتى رأى جُدَداً شُعْلا",126,"ل",2,0],["أقمنا لهم فيها المآثم كلما","مضى مشهد منهن أحدثن مشهدا",127,"د",2,0],["أقمنا بالذوابل سُوق حربٍ","وصيَّرنا النفوس لها متاعا",128,"ع",2,0],["أقمتُ الحقَّ في الهنديَّ رغماً","وأظهَرْتُ الضَّلال منَ الرَّشاد",129,"د",1,0],["أقَمْنَا لكُمْ طَعْناً مُبيراً، مُنَكِّلاً،","وحزناكمُ بالضربِ من كلّ جانبِ",130,"ب",1,0],["أَقِم يا اِبنَ مَسعودٍ قَناةً صَليبَةً","كَما كانَ سُفيانُ بنُ عَوفٍ يُقيمُها",131,"ه",2,1],["اقمار سمك المكرمات وكلهم","بين الرجال كاشخ الاعلام",132,"م",1,0],["أقم وادعاً واصبر على الضيم والأذى","فإنك إنسان وجدك آدم",133,"م",1,1],["أقَمتُ بِها دَهراً بِأهَنَأِ غِبطَةٍ","وأعذَبِ وَصلٍ آمِناً صَولَةَ النَّوَى",134,"و",2,0],["أقَمتُ فِيهِ زَمَاناً في بُلَهنِيَةٍ","جَذلاَنَ أرفُلُ في بُردِ الصِّبَا ثَمِلا",135,"ل",2,0],["أَقَمتَ لَها سوقَ الطِعانِ وَلَم تُقِم","دَعائِمَ هَذا الدينِ كَالسُمرِ شُرَّعا",136,"ع",2,0],["أَقَمنا وَنارُ الشَوقِ تُذكى تَلَهُّبا","وَرُمنا إِلَيهِ السَيرَ وَالحُكمُ قَد أَبى",137,"ب",2,0],["أقمن على قلبي رقيبا من الحب","فلا تسألوني واسئلوهنّ عن قلبي",138,"ب",2,1],["أقمت شعائر الإسلام فيه","بتقوى الله في سر وجهر",139,"ر",1,0],["أقمت شعار دين الله فيه","بما أحييت من هذا المقام",140,"م",1,0],["أَقم صَدرَها قَصداً إِلى الخَطِّ وَاِحتَقِب","رِسالَةَ وُدٍّ أَنتَ عِندي كِتابُها",141,"ب",3,0],["أقَمتُ عَلَى رَمّانَ يَوماً وَلَيلَةً","لاَنظُرَ ماواشِى أُمَيمَةَ صانِعُ",142,"ع",1,1],["أقمت بجنبلا عشرين يوما","وكنت وردتها فوق اليفاع",143,"ع",1,1],["أَقَمنا عَلى أَوطارِ لَهوٍ مُعَجَّلٍ","بِهِ وَتَواعَدنا بِلَيلٍ مُعَقَّبِ",144,"ب",1,0],["أقمتَ بدارٍ لا أنيسَ بأرضها","وإن حلَّها بعدَ الوفود وفود",145,"د",1,0],["اقمت منار الدين للحق رفعة","صدعت به الباغين والحق يصدع",146,"ع",1,0],["أقمنا على الحب أيامنا","لنهصر في الحسن ما نهصر",147,"ر",1,0],["أقمنا بأرض جناها العقوق","لكل أديب بها يظهر",148,"ر",1,0],["أقمت بها حيناً فطابت إقامتي","وكدت بأحلامي من الحب أغرق",149,"ق",1,0],["أقمنا معاً روحاً لروح بليلةٍ","هي الخلد منضوراً وأشهى وأجمل",150,"ل",1,0],["أقمتب أرض مصر أروض قلبي","على عيش هو الروض الجديب",151,"ب",1,0],["أقمنا وللشعري العَبُورِ تَوَقّدٌ","ونَجْمُ الثُّريا وهو بالغَرْبِ نازِلُ",152,"ل",1,0],["أقمار أفلاك المال منيرة","بسمائه ونجومهن سعود",153,"د",1,0],["أقمته كالطودِ في هَضبةٍ","تَردُّ عادي الدهرِ عن قَصدِه",154,"د",2,0],["أقم على نفسك الميزان معترفاً","وحقّق الحقّ في الأحكام واعتبر",155,"ر",1,0],["أقم بالبكا يا ذا عليك مناحةً","فإنّك مع موتي الغواية في لحد",156,"د",1,0],["أَقَمنا عَلى عِزِّ