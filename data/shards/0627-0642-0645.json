 نَواصِبُها","أُصولُها في اليَهودِ مَعروفَه",181,"ف",2,0],["أقمت عندك في ربع السرور على","نعماء تنسى بنعما آل حمدونا",182,"ن",2,0],["أقمت على الخدود فمن رآني","يسألني أدمع أم غمام",183,"م",1,0],["أقمت بها تجني العلوم بمنحل ال","يراع وأوراق الفوائد أطباق",184,"ق",1,0],["أقمت بها كرهاً وللدهر حكمة","وحكم الليالي لا يطاق له رَدُّ",185,"د",1,0],["أقمت عمود الدين حين أماله","لطاغي الفرنج الغتم طاغي بني سعد",186,"د",1,1],["أقمتُ طوعاً وسَارُوا ثُمَّ أنْدُبُهم","ألا صَحِبْتُ نَواهُم حيثُما اتّجَهُوا",187,"ه",3,0],["أَقَمنا بِاليَمامَةِ إِذ يَئِسنا","مُقاماً لا نُريدُ لَهُ زِيالا",188,"ل",2,0],["أقمنا لهم عرض الشمال فكبكبوا","ككبكبة الغزى أناخوا على الوفر",189,"ر",1,1],["أقَمْتَ إلى القوم الخوارج حُجَّةً","وجئتَهُم في كلّ خوف وتهديد",190,"د",1,0],["أقمْنا بينَ أفناءِ الأغاني","وما اخترنا المقام بلا مقام",191,"م",1,0],["أَقَمْتُم ركن هذا الدِّين فيها","وأَوْضَحْتُم لطالبه المنارا",192,"ر",2,0],["أَقِمْ في ذُرا عبد الغنيّ وإنْ تَشأْ","فسَرِّحْ إليه أنيقاً وحمالا",193,"ل",2,0],["أقمتُ بأرضٍ غير أرضي وموطني","وما لي في أفنائها أنيقٌ تحدى",194,"د",2,0],["أقمتُ في دارِه طويلاً","فلا كلام ولا سلام",195,"م",1,0],["أَقمار أَفلاك الجمال تغيَّبت","بعد الطلوع على حدوج جمال",196,"ل",1,0],["أقمتُ بها في الضيقِ ستّةَ أشهر","وذاك أقلّ الحمْل واليومَ مولِدُ",197,"د",1,0],["أقمتَ منارَ العلمِ شرْقاً ومغرِباً","فأحكامُه طُراً عليك تَدورُ",198,"ر",1,0],["أقم مأتم الأشواق إن كنت ذا هوىً","يُرنّحه بأن ويذكره رند",199,"د",1,0],["أقمتُ وسار السابقون فسرَّني","وما ظعنَ الجيرانُ إلا لأظعنا",200,"ن",2,0],["أقمْ فيَّ من عاداتِ سيبك سُنّةً","هي الغيثُ أو كانت أعمَّ وأجزلا",201,"ل",2,0],["أقمر الليلُ فقالوا رشَداً","قلت يا شوقي إلى ذاك الضلالِ",202,"ل",1,0],["أقمتُ وقدّمتُها رائداً","فشفِّع وسيلتها شفِّعِ",203,"ع",1,0],["أقمتُ أرعَى جدبَ دارٍ وفي","أخرَى ربيعٌ مائحٌ مائرُ",204,"ر",1,0],["أقِمْ ببني عبد الرحيم ضدورَها","إذا حطَّ منها أو أمالَ لُغوبُ",205,"ب",1,0],["أقم يا حسامي في صوانك واهجم","شربت دماً لم أُروِّك بالدَّمِ",206,"م",1,1],["أقمتُ بها حيث الرضا ذو مخائلٍ","وفارقتُها لمَّا بدا لي غُرورها",207,"ر",3,0],["أقمْتَ عِماد الدين حتى رفَعْتهُ","ولو لاكَ أضْحى بالتَّجاذبِ واهيا",208,"ي",2,1],["أقمتَ دهراً بمصرهم لا يني","حزنك فيها مقارناً جذلك",209,"ك",1,0],["أقم صدور المطيّ يا ساريً ال","ليل وعجّل دين العلى قبلك",209,"ك",1,0],["أقمتم بها سوقَ الصبابة مثلما","أقيمت بنجم الدين سوق المكارمِ",210,"م",1,0],["أقمار ليل النقع فرسان الوغى","والحرب أملاك الفخار وصيده",211,"د",2,0],["أقمتُ لديه ليلةً نابغيةً","عزيز كرى الأجفانَ حزن المضاجع",212,"ع",1,0],["أقمت فيه الصلاة دينا","إذ قال رب الورى أقيموا",213,"م",3,0],["أقمت بالعدل من ترضى خلافته","وبات بالعدل من ناواك معزولا",214,"ل",2,0],["اقمتكم لي عدولا","على ثبوت عدولي",215,"ل",2,0],["أقمت بدار كي أصون حقائق","الكنوز فلا تبدو يواقيت مطلبي",216,"ب",2,1],["اقمتهم للناس يبرأ منهم","ووجه الهدى من خزيهم يتهلّل",217,"ل",1,0],["أقمارُكم فوقَ الأهلّةِ طُلَّعٌ","وشُموسُكُمْ تحت الأكِلّة تَغرُبُ",218,"ب",1,0],["أقمارُه حملَتْ أهلّةَ بِيضِه","وشُموسُه حُرِسَتْ بأنجُم سُمرِهِ",219,"ر",2,0],["أقمارُ تِمٍّ لا يُوَقّى نقصها","إلّا بلَيلِ عجاجَةِ المَيدانِ",220,"ن",1,0],["أقمارُه لحديدِ الهِندِ حاملةٌ","تحمي شُموسَ العَذارَى في أهلّتهِ",221,"ت",2,0],["أقمت الناصر المحيي فأحيى","رسوماً كن بالرسم اليباب",222,"ب",1,0],["أقمت بها تلوي حبال مكيدة","لوى عنق الدنيا إليك مريرها",223,"ر",3,0],["أقمت لكم ضيفاً ثلاثة أشهر","أقول لقلبي لكما ضاق وسع",224,"ع",1,0],["أقمت من صعادهم","ما كان بالميل انحنى",225,"ن",2,0],["أقمْ واحداً فرداً ودعْ عنك مرّةً","نفاقَ فلانٍ أوْ خِداعَ فلانِ",226,"ن",1,0],["أُقِمْ في ظلّهمْ ما دمتُ حيّاً","ويُدركني بعَقْوَتهمْ أواني",227,"ن",2,0],["أقِمْ لا تَرِمْ عنّي وإنْ لم تكنْ هوىً","فكم قد سَخِطْنا فَقْدَ غيرِ مُلائمِ",228,"م",1,0],["أقِمْ حيث يُشجى بك الحاسدون","وخلِّ الهوادَةَ للنّادِمِ",229,"م",1,0],["أقمتَ مقامَ الأمن فينا أو الغنى","وأقلعتَ إِقلاع الغيوث الهواطلِ",230,"ل",1,0],["أقمنَ فما بعده للخيولِ","مقاديرُ حتَّى مع القُوَّدِ",231,"د",1,0],["أَقَمتُ لَكَ الأَنواحَ تَرتَدُّ بَينَها","مَآتِمُ يَندُبنَ النَدى وَالمَعالِيا",232,"ي",2,0],["أَقَمتَ خِلافَةً وَأَزَلتَ أُخرى","جَليلٌ ما أَقَمتَ وَما أَزَلتا",233,"ت",2,1],["اقم عاجزاً عنه وآمن به ولا","تشبِّهه بالمعنى الذي فيه تفكر",234,"ر",1,0],["أقم على نفسك الميزان معترفاً","بالجهل عن كل من لم تدر في البشر",235,"ر",1,0],["أقمتمْ غرامي في الهوى وقَعدْتم","وأسهَرْتموا جَفني القَريحَ ونمْتمُ",236,"م",1,0],["أَقَمتَ في ظِلّهِ المسعودِ مُغتبِطاً","فلم تكنْ نُوَبُ الأَحداثِ تَغشاكا",237,"ك",2,0],["أَقَمْتُ فِيهِ إلى أنْ صار هيكَلُهُ","بَيْتي وَمِفْتَاحُهُ للأُنْسِ مِفْتاحي",238,"ح",2,0],["أَقَمتُ بقصر زربيّ زَماناً","وَمريده فدار بني بشير",239,"ر",1,1],["أَقِمِ الصَلاةَ عَلى النَبِيِّ فَإِنَّها","تَذَرُ الذُنوبَ الشُمَّ قاعاً صَفصَفا",240,"ف",2,0],["أَقمتُ به بَيْنَ البشَاشةِ والقِرى","وإِن شئْتَ قُل بين المحبَّة والحَبَا",241,"ب",2,0],["أَقمت على عاشِقيك القيامهْ","بوردٍ لخدٍّ وغصنٍ لقامَهْ",242,"م",2,1],["أَقمتُ فروضَ الحُبِّ فيه وما أَرَى","به أَبداً غيرِي من الناس يُنْدَب",243,"ب",1,0],["أَقمتَ بها التوحيدَ للهِ وحدَهُ","وأُنْسيتَ فيها الروحَ والأَبَ والابْنَا",244,"ن",2,0],["أَقمْتَنِي فرجَعُوا","في المقْعَدِ المُقيمِ",245,"م",1,0],["أَقمتُ بها فلم يظفر طِلابي","بذي أَدبٍ ولا خِلٍّ حميم",246,"م",1,0],["أَقِمْ واهْجُرْ وصُدَّ وَلاَ تَصِلْنِي","رَضِيتُ بِأَنْ تَجُورَ وَأَنْتَ جَارُ",247,"ر",1,0],["أَقَمْنَا في جَنَابِ أَميرِ حُسْنٍ","عُقِدْنَ عَليهِ أَلوِيَةُ الجَمالِ",248,"ل",1,0],["أَقَمْتُ زَماناً لَسْتُ أَنْظِمُ مِدْحَةً","وَلا لِيَ هَمٌّ أَنَّني أَتَغَزَّلُ",249,"ل",1,0],["أقم على الإسلام بعد اندراسه","وثبت حماة الدين يا ذا المراحم",250,"م",1,0]]}