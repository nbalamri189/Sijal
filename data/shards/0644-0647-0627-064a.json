{"poems":[[73,"ما قام لولا هواك المدنف الوصب","https://www.aldiwan.net/poem4015.html","البسيط"],[0,"قفا نبك من ذكرى حبيب ومنزِل","https://www.aldiwan.net/poem50.html","الطويل"],[0,"خليلي مرا بي على أم جندب","https://www.aldiwan.net/poem52.html","الطويل"],[45,"أهلا بدار سباك أغيدها","https://www.aldiwan.net/poem9531.html","المنسرح"],[47,"برق أضاء العقيق من ضرمه","https://www.aldiwan.net/poem65686.html","المنسرح"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54248","البسيط"],[0,"قفا نبك من ذِكرى حبيب ومنزل ( معلقة )","https://www.poetsgate.com/ViewPoem.aspx?id=4730",""],[215,"عدنا إلى الحب عدنا","https://www.aldiwan.net/poem46249.html","المجتث"],[234,"وخمر ترشفت سلسالها","https://www.aldiwan.net/poem50882.html","المتقارب"],[309,"لك الخير حدثني بطبية عامر","https://www.aldiwan.net/poem16806.html","الطويل"],[358,"صلوا حبل ودي يا كرام وزوروا","https://www.aldiwan.net/poem40349.html","الطويل"],[369,"دع العين مني تسكب الدمع أو تفنى","https://www.aldiwan.net/poem60624.html","الطويل"],[556,"وسائلة لتعرف ما عراني","https://www.aldiwan.net/poem47165.html","الوافر"],[580,"نعم هي سعدي وهي لي قمر سعد","https://www.aldiwan.net/poem3086.html","الطويل"],[905,"","https://poetry.dctabudhabi.ae/diwan/poem/146459","الوافر"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62550","الرجز"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120056","السريع"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/119906","السريع"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96627","الوافر"],[148,"","https://poetry.dctabudhabi.ae/diwan/poem/112808","الوافر"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108631","البسيط"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118351","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53224","الوافر"],[2216,"","https://poetry.dctabudhabi.ae/diwan/poem/100480","البسيط"],[2707,"","https://poetry.dctabudhabi.ae/diwan/poem/75999","الطويل"],[3023,"","https://poetry.dctabudhabi.ae/diwan/poem/31532","الطويل"],[3098,"","https://poetry.dctabudhabi.ae/diwan/poem/131896","الطويل"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74079","المنسرح"],[3539,"","https://poetry.dctabudhabi.ae/diwan/poem/86246","البسيط"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45810","البسيط"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103037","الوافر"],[3956,"","https://poetry.dctabudhabi.ae/diwan/poem/77183","الوافر"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127170","السريع"],[4115,"","https://poetry.dctabudhabi.ae/diwan/poem/127058","البسيط"],[4566,"","https://poetry.dctabudhabi.ae/diwan/poem/136406",""],[4690,"يقين نبيّ","https://www.poetsgate.com/ViewPoem.aspx?id=186151",""],[4811,"شظايا","https://www.poetsgate.com/ViewPoem.aspx?id=198304",""]],"verses":[["لَهُ أَيادٍ مُقيماتٌ مُسافِرَةٌ","لَم يَخلُ مِن بِرها عُجمٌ وَلا عَربُ",0,"ب",1,0],["لَهُ أَيطَلا ظَبيٍ وَساقا نَعامَةٍ","وَإِرخاءُ سِرحانٍ وَتَقريبُ تَتفُلِ",1,"ل",1,0],["لَهُ أَيطَلا ظَبيٍ وَساقا نَعامَةٍ","وَصَهوَةُ عيرٍ قائِمٍ فَوقَ مَرقَبِ",2,"ب",1,0],["لَهُ أَيادٍ إِلَيَّ سابِقَةٌ","أُعَدُّ مِنها وَلا أُعَدِّدُها",3,"د",3,0],["لَهُ أَيادٍ عِندي وَلي أَمَلٌ","ما زالَ في عَهدِهِ وَفي ذِمَمِه",4,"م",2,0],["له أياد على الأيامِ سابغةٌ","في كلِّ جيدٍ من الأيام نُعْماها",5,"ا",3,0],["لهُ أيطلا ظبيٍ وساقا نعامة","وإرخاء سرحانٍ وتقريبُ تنفلِ",6,"ل",1,0],["لهائب من شجون","من نارها قد نجوتم",7,"م",1,0],["له آيةٌ في العلا لم يكن","عدوّ لِيدرِك إِبطالها",8,"ل",3,0],["له آية المعراج وهي عظيمةٌ","وكم آيةٍ لم يحصها حصر حاصر",9,"ر",1,0],["لَهُ آية السحر الَّتي جاءنا بِها","عَلى فَترة مِن داعجيه نَذيرُ",10,"ر",1,0],["لها يومَ نَشْرٍ فيه يُظْهِرُ للورَى","خفايا من الأسرارِ كُنَّ لها ضِمْنا",11,"ن",2,0],["له أَيْدٍ بما أَجنِي عليه","وما لي بِالّذي يجني يدانِ",12,"ن",1,0],["له آيةٌ والخلقُ فانٍ مُخلَّد","أَلم يعلمُوا أَنَّ الَّثناءَ هو الخُلْدُ",13,"د",1,0],["له آيةٌ ما لا تُحدّ جلالةً","وأُبَّهةً ما كُلُّ شيءٍ له حدُّ",13,"د",1,0],["له أيد على كل البرايا","ولا سيما خلاف الناس عندي",14,"د",2,0],["له أيادٍ لم تزل تنهلّ من","يديه للناس كما انهل الغمامْ",15,"م",1,0],["له أياد غير معدودة","والقطر لا يحصر بالعدِّ",16,"د",1,0],["لها يد عندى ورجل معا","والرجل دون البد تكفيني",17,"ن",2,0],["لَهُ أَيدٍ سخيّات ولكن","بِما كسبته من مجدٍ شحاحُ",18,"ح",1,0],["له آيات حق قد أفادت","بأن القدر عند الرب سام",19,"م",1,0],["لها يدٌ لو تعرَّت من دمالجها","سالت تبارك واقيها من الخطر",20,"ر",1,0],["لها يدنى اقصى المرامي ويندفئي","من المعضل الآبي لها الحجر الاير",21,"ر",1,0],["له آيات مجد لو رآها","عُرابة لم يمدَّ لها يمينا",22,"ن",2,0],["له أياد ببذل البر طائلةٌ","ما أن رأينا له في بذله قصرا",23,"ر",2,0],["لَهُ أَينَعَت أَيكُ العُلومِ فَإِن ترِد","جَناها مَتى ما شاءَ يَهمِ وَيَقطِفِ",24,"ف",1,1],["لَهُ أَيكَةٌ لا يَأمَنَ الناسُ غَيبَها","حَمى رَفرَفاً مِنها سِباطاً وَخِروَعا",25,"ع",2,0],["لها يأرَزُ الإيمان صحّ حديثه","مهاجر خير الخلق حاوى الفضائل",26,"ل",1,0],["له أَياد عليّ ضافية","أَجحد نَفسي وَلست أَجحدها",27,"د",3,0],["لَهُ ايادٍ تُنادي لِلملا كَرَماً","هَلُمَّ يا طالِباً من فَيضنا مدَدا",28,"د",2,0],["لَهُ أَيادي إِياد في بَني مُضَر","تَهمي فَتَنشُر طَيّاً بَعدَ طَيهم",29,"م",1,0],["له أيد لفرط العذل يشكو","عليهن الطريف إلى التلاد",30,"د",1,0],["لَها يَهتَزُّ عَطف كَريم طَبع","وَحَلَت سَمع صافي الذِهن حبر",31,"ر",1,0],["له أياد جمة عندها","كعب الأيادي مادر الألكع",32,"ع",1,0],["له أياد إذا ما فاض أصغرها","لم ينم جود إلى كعب الأيادي",33,"ي",1,0],["لها يخطب القول الانيق وضده","كخابط ليل أو به هو حاطب",34,"ب",1,0],["لها يقينُ نَبيّ لا يُقَلْقلُهُ","رَيْبُ المَنونِ ولا يَزْري بِهِ وَجَلُ",35,"ل",1,0],["لها يغني الهوى فيها يذوبُ أسى","بها يُحَلِّقُ في المعنى جناحاهُ",36,"ا",2,0]]}