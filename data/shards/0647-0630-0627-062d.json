{"poems":[[88,"أي مكمهون قدمت بالقصد","https://www.aldiwan.net/poem10680.html","مجزوء الكامل"],[95,"هذا حفيد لفتح الله مولده","https://www.aldiwan.net/poem11182.html","البسيط"],[56,"يا واقفا يبكي الطلول وينشد","https://www.aldiwan.net/poem27436.html","الكامل"],[72,"أمحمد والجود فيك سجية","https://www.aldiwan.net/poem42784.html","الكامل"],[94,"كم من عهود عذبة","https://www.aldiwan.net/poem38946.html","مجزوء الكامل"],[87,"بين المقطم والمقطم نسبة","https://www.aldiwan.net/poem7268.html","الكامل"],[99,"مرت حياتي دون أمنية","https://www.aldiwan.net/poem24923.html","أحذ الكامل"],[71,"إني إلى طلعته شيق","https://www.aldiwan.net/poem29221.html","السريع"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55016","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55018","البسيط"],[100,"","https://poetry.dctabudhabi.ae/diwan/poem/141954","الكامل"],[67,"","https://poetry.dctabudhabi.ae/diwan/poem/43758","الكامل"],[105,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""],[164,"غايات جودك لا تبطي عن الامل","https://www.aldiwan.net/poem59074.html","البسيط"],[215,"فجعت بألطف العلماء روحا","https://www.aldiwan.net/poem46629.html","الوافر"],[260,"هذا حديثي تنمي عجائبه","https://www.aldiwan.net/poem48532.html","المنسرح"],[274,"أبدي هلالك من غمام البرقع","https://www.aldiwan.net/poem35396.html","الكامل"],[285,"اسمع حديثي فإن الصدق مقبول","https://www.aldiwan.net/poem1382.html",""],[324,"الملك لله جل القرد والشان","https://www.aldiwan.net/poem61619.html","البسيط"],[370,"إن كنت تترعه كأسا لمكتئب","https://www.aldiwan.net/poem17314.html","البسيط"],[375,"هذا حديثي ولم أمسك لمعتبة","https://www.aldiwan.net/poem57005.html","الطويل"],[375,"قلبي مع الحيوان لا","https://www.aldiwan.net/poem57256.html","مجزوء الكامل"],[482,"عجبا لقلبك كيف يحمل وده","https://www.aldiwan.net/poem37018.html","الكامل"],[503,"كثر الصنوف وأنت أنت الواحد","https://www.aldiwan.net/poem37565.html","الكامل"],[503,"هجم العدو بخيله وبرجله","https://www.aldiwan.net/poem37794.html","الكامل"],[503,"بالله يا سائق الأظعان خذ خبرا","https://www.aldiwan.net/poem38017.html","البسيط"],[532,"أقول بعد الحمد","https://www.aldiwan.net/poem37446.html","مجزوء الرجز"],[561,"الحبة السوداء في خده","https://www.aldiwan.net/poem34478.html","السريع"],[578,"تجنى لواحظه وتستعدي","https://www.aldiwan.net/poem2971.html","أحذ الكامل"]],"verses":[["هَذا حُسَينٌ فَوقَ عَر","شِ النيلِ تَحرُسُهُ العِنايَه",0,"ا",3,0],["هَذَا حَفِيدٌ لِفَتْحِ اللهِ مَوْلِدُهُ","فَتْحٌ مِنَ اللهِ وَلِلاَدَابِ وَالفِطَنِ",1,"ن",1,1],["هَذا حُسَينٌ بِالسُيوفِ مُبَضَّعٌ","وَمُلَطَّخٌ بِدِمائِهِ مُستَشهَدُ",2,"د",1,0],["هَذا حَديثي عَن ضَميرٍ صادِقٍ","وَاِسأَل ضَميرَكَ إِنَّهُ يُنبيكا",3,"ك",2,0],["هذا حَصادي من حقولِ","العالَمِ الرَّحْبِ الخَطيرْ",4,"ر",1,0],["هذا حَصادي كُلُّهُ في","يقظةِ العَهْدِ الأَخيرْ",4,"ر",1,0],["هذا حجارته إذا ما قُطِّعت","صلحت بجملتها لكل بناء",5,"ا",2,0],["هذا حديث يشبه السِّحرا","هيهات أفرغ من روايته",6,"ه",1,0],["هذا حسامٌ بيدِ اللهِ قدْ","تاهَ على الغربِ بهِ المشرقُ",7,"ق",1,0],["هَذَا حَنِينٌ مِنْ فُؤَا","دِ مُحبِّكِ الْمُتَفجِّعِ",8,"ع",1,0],["هَذَا حَبِيبٌ قضَى وَيَتْلو","آخَرُ فِي إِثْرِهِ سَرِيعَا",9,"ع",2,0],["هذا حصيرك والحبيبات التي","كانت غذاءك واللحاف المبهم",10,"م",1,0],["هذا حَبيبُ اللَهِ مَن","عاداهُ كانَ لَعينهُ",11,"ن",2,0],["هذا حَديثُ النَّفْسِ حينَ تَشُفُّ عَنْ","بَشَرِيَّتي وَتَمُورُ بَعْدَ ثَوانِ",12,"ن",1,0],["هذا حديث الأماني وهي صادقة","فما تحدثني من جودك الهطل",13,"ل",1,0],["هذا حبيبك ملقى فوق أتربة","كما تلوذ بظهر الأرض أزهارُ",14,"ر",1,0],["هذا حديثي تنمي عجائبه","بكثرة القال فيه والقيل",15,"ل",1,1],["هذا حِماكِ بأدمعي رصّعتُهُ","فبدمعةٍ كفَّ التوسُّلِ رصّعي",16,"ع",2,0],["هذا حديث اشتياقي وهو مختصر","وربّما قيل فيه القول مملول",17,"ل",1,0],["هَذا حَليفُ التُقى رَبُّ الفَضائِلِ مَن","لَهُ مِنَ البِرِّ ما لَم يحصِ حُسبانِ",18,"ن",1,0],["هَذا حَديثٌ عَجيبٌ لَيسَ يُعجِبُني","فَلتَقضِ مِنهُ المَعالي آخِرَ العَجَبِ",19,"ب",1,0],["هذا حَديثي ولم أُمسِك لمعتَبَةٍ","يُطوى لها السِرُّ أو يُبدَى لها العَلَنُ",20,"ن",1,1],["هَذا حَريقٌ في القُلو","بِ وذا لِشارِبِهِ رَحيقُ",21,"ق",1,0],["هذا حديث النفس في خلواتها","واللّه يعلم ما الذي يك بعده",22,"د",2,0],["هذا حريصٌ وهو يعلم ترك ما","يقني وهذا عن شهودٍ زاهدُ",23,"د",1,0],["هذا حِمى الغَوثِ الرِّفاعيِّ الَّذي","ما زالَ يُدْعى في الحِمى حامي الحِمى",24,"م",2,0],["هذا حَديثي مُعْتَلٌّ به سَنَدٌ","عَمودُهُ مُرْسَلٌ والنَّصُّ مُخْتَصَرُ",25,"ر",1,0],["هذا حديثي بِكُمْ تُرْوى رِوايَتُهُ","وسِفْرُ وَجْدي لكمْ تُتْلى بهِ السُّوَرُ",25,"ر",1,0],["هَذا حَكَاهُ الْعَضُدُ","وقَوْلُهُ مُجَوَّدُ",26,"د",1,0],["هذا حديث لم يبنه لنا","إلا الذي عنها لنا خبرا",27,"ر",2,0],["هذا حديثي بعدكُم فَتَرَى","يا قومُ كيفَ حديثُكم بَعْدِي",28,"د",2,0]]}