tsgate.com/ViewPoem.aspx?id=139695",""],[669,"نادى علي فوافى فوق منبره","https://www.poetsgate.com/ViewPoem.aspx?id=18397",""],[4935,"حسن المطالع في صفاء براعة","https://www.poetsgate.com/ViewPoem.aspx?id=129288",""],[4961,"زهرةُ آخرِالأنبياء","https://www.poetsgate.com/ViewPoem.aspx?id=40463",""],[5007,"صلصة الصاد","https://www.poetsgate.com/ViewPoem.aspx?id=180745",""],[5038,"حسين العراق","https://www.poetsgate.com/ViewPoem.aspx?id=190164",""],[3271,"أنا شاعر الوادي وعزاف اللظى","https://www.poetsgate.com/ViewPoem.aspx?id=103536",""],[5081,"2) اللَّامِيَّةُ فِي سِيرَةِ خَيْرِ الْبَرِيَّةِ ( صلى الله عليه وسلم )","https://www.poetsgate.com/ViewPoem.aspx?id=190734",""],[3591,"غداّ أفارق عدناناً وأبكيه","https://www.poetsgate.com/ViewPoem.aspx?id=149483",""],[5106,"جَاْدَتْ غِيُوثُكَ ..","https://www.poetsgate.com/ViewPoem.aspx?id=137168",""],[5106,"هذا حَبيبي بِوجهِ الفَجرِ ينتظمُ","https://www.poetsgate.com/ViewPoem.aspx?id=139107",""],[5106,"صِدْقُ العِيُونِ مَرَايَتِيْ ..","https://www.poetsgate.com/ViewPoem.aspx?id=150976",""],[5122,"روضة التنهات","https://www.poetsgate.com/ViewPoem.aspx?id=31513",""],[5127,"حديثُ النفس","https://www.poetsgate.com/ViewPoem.aspx?id=177309",""],[5145,"البين فرق بين جفني والكرى","https://www.poetsgate.com/ViewPoem.aspx?id=108235",""],[5187,"سكرة النفس","https://www.poetsgate.com/ViewPoem.aspx?id=29253",""],[5277,"نؤومُ المواجع","https://www.poetsgate.com/ViewPoem.aspx?id=191348",""],[5278,"يا زوجُ ، يومُكَ قد حَلَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=202550",""],[5282,"أشواق ليلٍ نازفة","https://www.poetsgate.com/ViewPoem.aspx?id=213936",""],[5338,"قالوا: تعزل قلت: هذي كربلا","https://www.poetsgate.com/ViewPoem.aspx?id=190099",""],[5493,"نشيدُ الشجر","https://www.poetsgate.com/ViewPoem.aspx?id=197037",""],[5533,"ما زَلتُ أنتَظِرُ الخَبَر","https://www.poetsgate.com/ViewPoem.aspx?id=176657",""],[5587,"جيتك يا حبي","https://www.poetsgate.com/ViewPoem.aspx?id=197806",""],[5664,"حفيف الجرح","https://www.poetsgate.com/ViewPoem.aspx?id=176687",""],[5691,"حمار الحطاب","https://www.poetsgate.com/ViewPoem.aspx?id=205825",""],[5691,"فخ وبصيرة","https://www.poetsgate.com/ViewPoem.aspx?id=206216",""],[5691,"خمسون عاماً...!","https://www.poetsgate.com/ViewPoem.aspx?id=206746",""],[5720,"جبلُ الأنيِّ","https://www.poetsgate.com/ViewPoem.aspx?id=200359",""],[5818,"الطرف المحتال","https://www.poetsgate.com/ViewPoem.aspx?id=193237",""],[5848,"اشك إنه صديقي","https://www.poetsgate.com/ViewPoem.aspx?id=53202",""],[5861,"مناجاتي","https://www.poetsgate.com/ViewPoem.aspx?id=188039",""],[6010,"أستاذة النحو ,,,","https://www.poetsgate.com/ViewPoem.aspx?id=175986",""],[6068,"استغفر الله -02-","https://www.poetsgate.com/ViewPoem.aspx?id=177337",""],[6097,"نُورُ الأُخُوَّةِ","https://www.poetsgate.com/ViewPoem.aspx?id=190690",""],[5724,"قف يا زمان معي بالله وانتحب","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55151&r=&rc=18",""],[5075,"موتوا لأجل القدس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82754&r=&rc=0",""],[6223,"حقول الشوك","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1214&r=&rc=3",""]],"verses":[["هَذا حُسَينٌ فَوقَ عَر","شِ النيلِ تَحرُسُهُ العِنايَه",0,"ا",3,0],["هَذَا حَفِيدٌ لِفَتْحِ اللهِ مَوْلِدُهُ","فَتْحٌ مِنَ اللهِ وَلِلاَدَابِ وَالفِطَنِ",1,"ن",1,1],["هَذا حُسَينٌ بِالسُيوفِ مُبَضَّعٌ","وَمُلَطَّخٌ بِدِمائِهِ مُستَشهَدُ",2,"د",1,0],["هَذا حَديثي عَن ضَميرٍ صادِقٍ","وَاِسأَل ضَميرَكَ إِنَّهُ يُنبيكا",3,"ك",2,0],["هذا حَصادي من حقولِ","العالَمِ الرَّحْبِ الخَطيرْ",4,"ر",1,0],["هذا حَصادي كُلُّهُ في","يقظةِ العَهْدِ الأَخيرْ",4,"ر",1,0],["هذا حجارته إذا ما قُطِّعت","صلحت بجملتها لكل بناء",5,"ا",2,0],["هذا حديث يشبه السِّحرا","هيهات أفرغ من روايته",6,"ه",1,0],["هذا حسامٌ بيدِ اللهِ قدْ","تاهَ على الغربِ بهِ المشرقُ",7,"ق",1,0],["هَذَا حَنِينٌ مِنْ فُؤَا","دِ مُحبِّكِ الْمُتَفجِّعِ",8,"ع",1,0],["هَذَا حَبِيبٌ قضَى وَيَتْلو","آخَرُ فِي إِثْرِهِ سَرِيعَا",9,"ع",2,0],["هذا حصيرك والحبيبات التي","كانت غذاءك واللحاف المبهم",10,"م",1,0],["هذا حَبيبُ اللَهِ مَن","عاداهُ كانَ لَعينهُ",11,"ن",2,0],["هذا حَديثُ النَّفْسِ حينَ تَشُفُّ عَنْ","بَشَرِيَّتي وَتَمُورُ بَعْدَ ثَوانِ",12,"ن",1,0],["هذا حديث الأماني وهي صادقة","فما تحدثني من جودك الهطل",13,"ل",1,0],["هذا حبيبك ملقى فوق أتربة","كما تلوذ بظهر الأرض أزهارُ",14,"ر",1,0],["هذا حديثي تنمي عجائبه","بكثرة القال فيه والقيل",15,"ل",1,1],["هذا حِماكِ بأدمعي رصّعتُهُ","فبدمعةٍ كفَّ التوسُّلِ رصّعي",16,"ع",2,0],["هذا حديث اشتياقي وهو مختصر","وربّما قيل فيه القول مملول",17,"ل",1,0],["هَذا حَليفُ التُقى رَبُّ الفَضائِلِ مَن","لَهُ مِنَ البِرِّ ما لَم يحصِ حُسبانِ",18,"ن",1,0],["هَذا حَديثٌ عَجيبٌ لَيسَ يُعجِبُني","فَلتَقضِ مِنهُ المَعالي آخِرَ العَجَبِ",19,"ب",1,0],["هذا حَديثي ولم أُمسِك لمعتَبَةٍ","يُطوى لها السِرُّ أو يُبدَى لها العَلَنُ",20,"ن",1,1],["هَذا حَريقٌ في القُلو","بِ وذا لِشارِبِهِ رَحيقُ",21,"ق",1,0],["هذا حديث النفس في خلواتها","واللّه يعلم ما الذي يك بعده",22,"د",2,0],["هذا حريصٌ وهو يعلم ترك ما","يقني وهذا عن شهودٍ زاهدُ",23,"د",1,0],["هذا حِمى الغَوثِ الرِّفاعيِّ الَّذي","ما زالَ يُدْعى في الحِمى حامي الحِمى",24,"م",2,0],["هذا حَديثي مُعْتَلٌّ به سَنَدٌ","عَمودُهُ مُرْسَلٌ والنَّصُّ مُخْتَصَرُ",25,"ر",1,0],["هذا حديثي بِكُمْ تُرْوى رِوايَتُهُ","وسِفْرُ وَجْدي لكمْ تُتْلى بهِ السُّوَرُ",25,"ر",1,0],["هَذا حَكَاهُ الْعَضُدُ","وقَوْلُهُ مُجَوَّدُ",26,"د",1,0],["هذا حديث لم يبنه لنا","إلا الذي عنها لنا خبرا",27,"ر",2,0],["هذا حديثي بعدكُم فَتَرَى","يا قومُ كيفَ حديثُكم بَعْدِي",28,"د",2,0],["هذا حنان نادر قد بات من","صفحات جلِّ قلوبنا محذوفا",29,"ف",2,0],["هذا حيثٌ عجيبٌ عن أبي حسنٍ","يُروى وقد كان يأتي بالأَعاجيبِ",30,"ب",1,0],["هذا حَمامُ أَركٍ","رآكِ في الروضِ سَجَّع",31,"ع",1,0],["هَذا حَديثي وَحالي وَهوَ منبسِطٌ","فَكَيفَ لَو كانَ بِالتَقطيب قابلني",32,"ن",2,0],["هذا حنيني إلى ملقاك يدفعني","وما شفيت غليلاً عند ملقاك",33,"ك",1,0],["هذا حديثي يا عليَّ العلى","فمن مناديَّ بإصلاحي",34,"ح",2,0],["هذا حديثي ولك الأمر ولا","زلت لمن أصفا الولاء موئلا",35,"ل",2,0],["هَذا حَبيبٌ وَصولُ","وَذا رَقيبٌ صَرومُ",36,"م",1,1],["هذا حديثي بالعراق وأنت بال","أهواز معتكف على الأطراب",37,"ب",1,0],["هَذا حَبيبٌ تَصْحيفُ مَعْكوسِهْ","شيءٌ يَصُونُ الفَتَى بمَلْبوسهْ",38,"ه",1,1],["هَذا حَفيدُك سُلطانُ المُلوك أَبو","زَيد إِمامٌ بِنَصر الدين مَشغُولُ",39,"ل",1,0],["هذا حسام الدين بين أهلها","أصبح والملكُ به مقلَّد",40,"د",1,0],["هذا حماها نحوه","وحماك أشرف بل أتم",41,"م",1,0],["هذا حسامك خذه للدفاع لا","تجعل لجسمك غير العز تابوتا",42,"ت",2,0],["هَذا حَديِثي عَنكُمُ ولَعَلَّني","أحظَى لَهُ بِالحُبّ إنْ لَمْ أُحسَدِ",43,"د",1,0],["هَذا حَدِيثِي صَحِيحٌ عَنْ مُشاهَدَةٍ","مَا فِيهِ مَطمَعُ نَقَّادٍ لِتوْهِينِ",44,"ن",1,0],["هذَا حَبِيبُ اللهِ أَكرَمُ مَن مَشى","وأَجَلُّ مَن رَكِبَ المَطِىَّ وأردَفا",45,"ف",2,0],["هذا حماك وليس في","لبنان اعلى من حماك",46,"ك",1,0],["هذا حبيبك بالتراب معفر","فيه المنية أنشبت أظفارها",47,"ر",3,0],["هذا حديثُ رسولٍ","قد اصطفاه نبيّا",48,"ي",2,0],["هذا حديث لقيط المعروف بال","خبر الطويل وذا عظيم الشان",49,"ن",1,0],["هذا حمورابي اتى بك شرعة","نبهت على خطواتها شعراك",50,"ك",1,0],["هذا حمود وَإِنَّهُ السَيف الَّذي","يرضيك إِن تُنضيه وَهُوَ الفَيصل",51,"ل",1,0],["هذا حسامك من يَذب بِهِ العِدى","وَلِواك هذا مَن بِهِ يَتقدَّم",52,"م",1,0],["هذا حبيبك في الطفوف مجدل","عار تكفنه يد النكباء",53,"ا",2,0],["هذا حساب يا أخي خفيّ","لا يفتكر فيه سوى الذكيّ",54,"ي",1,0],["هذا حرم مقدس يخدمه","جبريل وميكال صباحاً ومسا",55,"س",2,0],["هذا حَرَمٌ بفضْلهِ العقلُ أَقَرّ","فيه لملائِكِ السَّموات مَقَرّ",56,"ر",1,1],["هذا حقيقة إسلام الذي سلمت","منها بها نفسه عن صدق مرتقب",57,"ب",1,0],["هذا حطيم الغرام ركني","وأنتم عامر بنائي",58,"ا",2,0],["هذا حديثٌ كان لي ومضى","كالأمس ولى ثم لم يثب",59,"ب",1,0],["هذا حمى الرمل وذاك معهده","فعج بنا نبثه ما نجده",60,"د",2,1],["هذا حبيبك بالطفوف مجدل","تجري عليه الخيل جري مغار",61,"ر",1,0],["هذا حديثُ رُوَاتها","عَنها وعَن عاداتها",62,"ت",3,1],["هذا حمار الشاعر الدرويشِ","مالي أراه بحالة المدهوشِ",63,"ش",1,1],["هذا حبيبك مبعد","ولقربه لك لم تراقب",64,"ب",1,0],["هذا حسين بالعرى جثةً","والنحر قد حز بماضي الغرار",65,"ر",1,0],["هذا حسين رضضت صدره","خيل العدى إذ جعلته مغار",65,"ر",1,0],["هذا حسين قتلوا ظامياً","والماء عبت منه وحش القفار",65,"ر",1,0],["هَذا حَديثُ نَبيِّنا عَن رَبِّهِ","صِدقاً بِلا كَذِبٍ وَلا بُهتانِ",66,"ن",1,0],["هذا حمى الدين وَالدُنيا وَأَهلهما","وَحجة اللَه بَين الإنس وَالجان",67,"ن",1,0],["هذا حمى السبط الحسين من احتمى","بجماح فاز بمنحة وهناء",68,"ا",2,0],["هذا حسين العلا أعلى معالمه","زكيّ أصل عريق المجد والشيم",69,"م",1,0],["هذا حسين أخو الصفا","خدن العلا نسل الكرام",70,"م",1,0],["هَذا حَدِيثُهُمَا انتَهَى وَعَلَيهِما","بَطَلا الطَرَاوِدِ بالعَجَاجَةِ أَقبَلا",71,"ل",2,1],["هذا حديثُ نداهُ من عهدِ الصبا","سالت به الأَقلامُ في الأَوراقِ",72,"ق",1,0],["هذا حسين رأسه فوق القنا","أدمت عليه الكائنات عيونها",73,"ن",3,0],["هذا حَديثي صِلي أَو فاهجُري فَلَقَد","عَلِمتِ ما حَلَّ بي في الحُبِّ فاحتَكمي",74,"م",2,0],["هذا حديثي وما طالَ المِطالُ ولا","حالَ الزَّمانُ وعندي من يُسلِّيني",75,"ن",2,0],["هذا حَبيبُ اللَهِ صَفوَةُ خلقِهِ","هو سِرُّ سرٍّ مُضمرٍ هو مُظهرُ",76,"ر",1,0],["هذا حَبيبُ اللَهِ مُصطَفاهُ","مُذ عادَ مضناه شَفى ضَناهُ",77,"ه",1,0],["هَذا حَرامٌ لمن قَد عَدَّهُ لَمَماً","وَلَن يُعَذِّبَنا الرَحمَنُ بِاللَمَمِ",78,"م",1,0],["هذا حِرَاكِيٌّ يُكَافِحُ لا","صَنعَاءَهُ يَهوَى ولا عَدَنَهْ",79,"ن",2,0],["هذا (حسين) قد أتاك وخلفه","(عبدالكريم) بما أتاه يتمتم",80,"م",1,0],["هذا حديثُ ابنِ الأثير بِ (أسدِه)","إن كنتَ قارىءَ ما به أو سامِعَه",81,"ع",2,0],["هذا حبيب القلب إسلام النّهى","قد غاب في سجن العداة مغيبا",82,"ب",2,0],["هذا حديث عجيب عن أبي حسن","يروى وقد كان يأتي بالأعاجيب",83,"ب",1,0],["هذا حريص يا كرام عليكمو","وبذاك معلوم شهير عناية",84,"ه",1,0],["هذا حضوركِ في كلِّ الزمان ِ بدا","فتحاً تعوَّد أنْ يستسهلَ الصَّعبَا",85,"ب",2,0],["هذا حَصَاد صفير الرّيح مُذْ عصفت","في ساحة الصّفر والصّيّاد مطعونُ",86,"ن",1,0],["هذا حسينُ الْعراقِ الثّائِرُ الْعرَبيْ","هذا إمامُ الْورى في الدّينِ والْأدبِ",87,"ب",1,1],["هذا حسينُ الهدى للنّاسِ كلِّهمُ","بهِ تباهتْ أُباةُ العُجْمِ والْعرَبِ",87,"ب",1,0],["هذا حِمى المنصورة انصدعت به","آساسُ معقلكِ القديمِ فحُطّما",88,"م",2,0],["هَذَا حَبِيبُ اللهِ جَاءَكِ خَاطِبَاً","وَمُلَبِّيَاً لِنِدَاءِ قَلْبٍ عَاقِلِ",89,"ل",1,0],["هَذَا حَبِيبُ اللهِ يَقْضِي لَيْلَهُ","فِي خُلْوَةٍ قَدْ حُبِّبَتْ لِلْمُرْسَلِ",89,"ل",1,0],["هذا حبيبي فلا أرضى له ألماً","يوماً ولا أيّ شيءٍ كان يشقيه",90,"ق",3,0],["هَذَاْ حَبِيْبِيْ فَاْخِرٌ .. وَمُعَطَّرَ الْ","أَعْطَاْفِ يَمْشِيْ زَاْخِرَاً مُتَألِقَا",91,"ق",2,0],["هَذَاْ حَبِيْبِيْ لَوْ تَحَدَّثَ طَاْوَلَتْ","مِنْهُ الْحُرُوْفُ بَلاْغَةً أَنْْ تُرْهَقَاْ",91,"ق",2,0],["هَذَاْ حَبِيْبِيْ سَبِّحِوهُ بَاْرِئِيْ","هَذَاْ الْجَمِيْلُ مِنَ الْجَمِيْلِ وَثَاْئِقَا",91,"ق",2,0],["هَٰذَاْ حَبِيْبِيْ بِوَجْهِ الفَجْرِ يَنْتَظِمُ","وَالطَّلُّ وَالشَّمْسُ وَالأَنْدَاءُ قَدْ نَعِمُوا",92,"م",3,1],["هَٰذَا حَبِيْبِيْ وَرَبُّ الكَوْنِ عَبْقَرَهُ","تَأْتِيْ اعْتِبَاْرَاْتُهُ وَالنُّوْنُ وَالقَلَمُ",92,"م",1,0],["هَذَا حَبِيبِيْ .. زَاهِرٌ كَالنَّجْمِ .. كَال","مَاسِ المُنَّضِحِ بِالسَّنَا .. حُلْوٌ رَطِيْنُهْ",93,"ن",2,0],["هذا حلحيلهالا عقدت بالراي والحيلات","هذا قايد مسييرتنا به الامال معقوده",94,"د",2,0],["هذا حديثُ النفسُ جئتُكَ يا أبي","صدقاً وعدلاً ليس بالأفاكِ",95,"ك",1,0],["هذا حديثُ النفسِ يا أبتي وإنْ","جاءَ القصورُ فأنتَ أنتَ دَرَاكِ",95,"ك",1,0],["هذا حديث والنزاع يكاد أن","يقوى فينزع قلبي المتحسرا",96,"ر",2,0],["هذا حَصادُ غوايتي","كمْ ذقتُ مِنها صابِيا",97,"ي",2,0],["هذا حمامُ(الكرخ) ناح بحزنه","إيهٍ حمامُ (الكرخِ) صغت هديلَكْ",98,"ك",1,0],["\"هذَا حَلالٌ بيِّنٌ...","يا ربَّنا ، ما أعْدَلَكْ..!!\"",99,"ك",1,0],["هذا حَبيبي جَفاني دُونما سببٍ","فكيفَ أُبْغضُ ليلاً ضَم أشلائي؟!",100,"ا",3,0],["هَذَا حُسَيْنٌ لِلنَّبِيِّ الْمُصْطَفَىٰ","مَثَلٌ بِهِ الذِّكْرُ الحَكِيمُ تَمَثَّلَا",101,"ل",2,0],["هذا حفيفي قد أسَرَّ بلحنه","وترنمت بغنائه أذنُ المدَى",102,"د",2,0],["هذا حَدِيْثُ مُتَيَّمٍ","ما زَالَ يَنْتَظِرُ الخَبَرْ",103,"ر",1,0],["هَذَا حُكْمْ الله إِلِّي مِنُّو غُلْبِي","مَحْكَمْتِي يَا فَارِسْ مَا غَلْقَتْ لَبْوَابْ",104,"ب",1,0],["هذا حفيف الجرح من هبت شجون","ولا سقوط وجيههم من عيوني",105,"ن",2,0],["هذا حِماري به أذْناهُ مِرْصَدةٌ","هما دليلي متى قرَّرْتُ تَجْوابي",106,"ب",2,0],["هذا حَريٌّ بأنْ تُحْذى حَوافِرُهُ","وأنْ تُثَبَّتَ في حذْواتِهِ الدُّسُرُ",107,"ر",1,0],["هذا حصاركَ لن يبقى يقيِّدني","غداً سأكسِرُهُ لابدَّ أكْسِرُهُ !",108,"ر",2,0],["هذا حليُّ الخيرِ في بلدي","من حسنه يسمو بنا قَدْرا",109,"ر",2,0],["هذا حرامٌ حرامٌ لا يقول بهِ","إلّا الّذي لمْ يذقْ هجْرًا كما قالوا",110,"ل",3,0],["هذا حطب دنياي .. هذا حريقي","وهذي معالم باقية مثل الاطلال",111,"ل",1,0],["هذا حصادي في السجود وجدته","يا لذةً قد نلتها بحصادي",112,"د",2,0],["(هذا) حَبيبُكِ (مَرْفوعٌ) (بِضَمّتِهِ)","فَأَكْثِري (ضَمَّهُ) (فالضَمّ ) يشْفيهِ",113,"ي",2,0],["(هَذا) حَبيبُكِ مَنْ مَرَّتْ جَنَازتُهُ","كُفِّي الدُّموع .. أَيَبْكي المَيْتَ مُرْدِيهِ",113,"ي",2,0],["هذا حديث لنفس دونه كلف","كموثق حرج من غارق حبا",114,"ب",2,0],["هذا حَفيدُ خَليلِ اللهِ، إِخْوَتُهُ","قالوا اقتُلوه يَبوءُ الذِّئبُ بِالذَّنبِ",115,"ب",1,0],["هذا حمى الله يا باغي وحرمته","والله يرقب من يعصيه عن كثب",116,"ب",1,0],["هذا حبيبٌ أَبْعَدَتْهُ جراحُُهُ","هذا عدوٌ قُربُه مَمَنُوحُ",117,"ح",1,0],["..........هذا حصادُك! أنت مَن زرع الحقول ومن جنى!","أتظنٌ أنّك من حقول الشوك تجني السوسنا!؟",118,"ا",1,0]]}