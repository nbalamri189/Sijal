{"poems":[[53,"ستعلمون ما يكون مني","https://www.aldiwan.net/poem29652.html","الرجز"],[51,"يا نجدة الروم في بطارقها","https://www.aldiwan.net/poem65502.html","المنسرح"],[89,"إن من قد جبلك","https://www.aldiwan.net/poem44848.html","مجزوء المديد"],[97,"تحت عين الصباح والأنوار","https://www.aldiwan.net/poem24747.html","الخفيف"],[31,"باسم الإله تحية لمتيم","https://www.aldiwan.net/poem41806.html","الخفيف"],[105,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[105,"أرأيت حكمة سيد الكرماء","https://www.aldiwan.net/poem44034.html","الكامل"],[105,"يا مطعم الجيش أشبعت السيوف دما","https://www.aldiwan.net/poem44069.html","البسيط"],[48,"لا صيد إلا بالصقور اللمح","https://www.aldiwan.net/poem62542.html","الرجز"],[106,"زفاف الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179500",""],[90,"الشاعر الجبَار","https://www.poetsgate.com/ViewPoem.aspx?id=179153",""],[51,"يا نجدة َ الرومِ في بطارقها","https://www.poetsgate.com/ViewPoem.aspx?id=29922",""],[142,"النجاء النجاء من أرض نجد","https://www.aldiwan.net/poem58420.html","البسيط"],[177,"خليقان هلهالان لا خير فيهما","https://www.aldiwan.net/poem4504.html","الطويل"],[235,"شكري لسيب نوالك الغمر","https://www.aldiwan.net/poem31998.html","الكامل"],[237,"البحر قد أبدى سنا نضرته","https://www.aldiwan.net/poem18084.html","السريع"],[458,"ما بعد يومك سلوة لمعلل","https://www.aldiwan.net/poem55988.html","الكامل"],[555,"لقد علمت هذيل أن جاري","https://www.aldiwan.net/poem1922.html","الوافر"],[558,"يا ذوينا وأمنا وأبينا","https://www.aldiwan.net/poem34437.html","الخفيف"],[562,"عتبت سعاد ولم أكن بالمذنب","https://www.aldiwan.net/poem52964.html","الكامل"],[562,"الزهر تبسم نورا عن أقاحيها","https://www.aldiwan.net/poem52974.html","البسيط"],[567,"مستهتر بالرمي واه عضده","https://www.aldiwan.net/poem69720.html","الرجز"]],"verses":[["أَحصَلُ مِن عَزمي عَلى التَمَنّي","وَلَيتَني أَفعَلُ أَو لَوَ اِنّي",0,"ي",1,0],["أحصن من سور كل عالية ال","سور حفاظاً ومن خنادقها",1,"ق",3,0],["احص لي كل خطا","ياك واذمم عملك",2,"ك",1,0],["أحصيرٌ ممزقٌ أم حريرٌ","مقعد للمجاهد الصبَّارِ",3,"ر",1,0],["أَحصَيتُ خَمسَةَ أَشهُرِ مَعدودَةٍ","وَثَلاثَةً مِن بَعدِها لَم توهَمِ",4,"م",1,0],["أَحِصْنَ اللهِ يُوعِدُ كلُّ رامٍ","ويطمعُ أن يكونَ له مُهينا",5,"ن",2,0],["أحْصِ الرجالَ وآتِ كُلّاً حَقَّهُ","ممّا أفاءَ اللهُ ذُو الآلاءِ",6,"ا",2,0],["أحْصَاه يا سعدُ عَدّاً ثم ضَاعَفَهُ","فلستَ تُحْصِيهِ حَتّى تُحْصِيَ الأُمَما",7,"م",2,0],["أَحَصُّ أَطرافَ القُدامى وَحوَحٍ","أَبرَشُ ما بَينَ القَرا وَالمَذبَحِ",8,"ح",1,0],["أحصنتَ في شرخ الشباب، وطالما","ألقى الشباب إلى الهوى بقياد",9,"د",1,0],["أحصيد دور الثقافة في الشرقِ","ألا يستينُ منهُنَّ قائِم؟",10,"م",1,0],["أحصنُ من سورِ كلِّ عالية ِ السْ","سُور حِفاظاً ومن خنادقها",11,"ق",3,0],["أحصِن ما شئتَ من حصىً وقُطارِ","فمعاليه ليس تُحصَى بَعدِّ",12,"د",1,0],["أَحَصّانِ من نَحْوِ الأَسافِلِ جُرّدا","أَلِفّانِ مِنْ أَعلاهما هَدِيانِ",13,"ن",1,0],["أَحصاهُمُ عَدَداً فَما اِشتَمَلَت","مِنهُم جَريدَتُهُ عَلى حُرِّ",14,"ر",1,0],["أَحْصَى أُصُولَ الْفَنِّ مُحْكَمَةً","وَحَاكَهَا طُرًّا عَلَى نَزْوَتِهِ",15,"ت",2,0],["أُحصِي السنينَ يَسُرُّ نفسي طولُها","وقصيرُ ما يُغنيك مثلُ الأطوَلِ",16,"ل",1,0],["أَحُصُّ فَلا أُجيرُ وَمِن أُجِرهُ","فَلَيسَ كَمَن تَدَلّى بِالغُرورِ",17,"ر",1,0],["أحصنوا بالتقى فروج قلوب","طاهرات ممن سواكم بِفاس",18,"س",1,0],["أحصى من الكُتُبِ الذي كَتَبوا لنا","فيها وزادَ عليهِ ما لم يُكَتبِ",19,"ب",1,0],["أحصى المُنى والثَّنا والحَزْمَ والكَرَمَ ال","أسنى وآياتِ عدلٍ لَستُ أُحصيها",20,"ي",3,0],["أحصنُ شيءٍ حين يرْمي طردُه","كأنّه فؤادهُ أوْ كَبِدُهُ",21,"ه",1,0]]}