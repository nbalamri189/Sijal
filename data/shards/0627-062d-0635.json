{"poems":[[55,"ستعلمون ما يكون مني","https://www.aldiwan.net/poem29652.html","الرجز"],[53,"يا نجدة الروم في بطارقها","https://www.aldiwan.net/poem65502.html","المنسرح"],[91,"إن من قد جبلك","https://www.aldiwan.net/poem44848.html","مجزوء المديد"],[99,"تحت عين الصباح والأنوار","https://www.aldiwan.net/poem24747.html","الخفيف"],[33,"باسم الإله تحية لمتيم","https://www.aldiwan.net/poem41806.html","الخفيف"],[107,"ردوا غمراتها في الواردينا","https://www.aldiwan.net/poem42142.html","الوافر"],[107,"أرأيت حكمة سيد الكرماء","https://www.aldiwan.net/poem44034.html","الكامل"],[107,"يا مطعم الجيش أشبعت السيوف دما","https://www.aldiwan.net/poem44069.html","البسيط"],[50,"لا صيد إلا بالصقور اللمح","https://www.aldiwan.net/poem62542.html","الرجز"],[108,"زفاف الفاروق","https://www.poetsgate.com/ViewPoem.aspx?id=179500",""],[92,"الشاعر الجبَار","https://www.poetsgate.com/ViewPoem.aspx?id=179153",""],[53,"يا نجدة َ الرومِ في بطارقها","https://www.poetsgate.com/ViewPoem.aspx?id=29922",""],[146,"النجاء النجاء من أرض نجد","https://www.aldiwan.net/poem58420.html","البسيط"],[181,"خليقان هلهالان لا خير فيهما","https://www.aldiwan.net/poem4504.html","الطويل"],[240,"شكري لسيب نوالك الغمر","https://www.aldiwan.net/poem31998.html","الكامل"],[242,"البحر قد أبدى سنا نضرته","https://www.aldiwan.net/poem18084.html","السريع"],[463,"ما بعد يومك سلوة لمعلل","https://www.aldiwan.net/poem55988.html","الكامل"],[560,"لقد علمت هذيل أن جاري","https://www.aldiwan.net/poem1922.html","الوافر"],[563,"يا ذوينا وأمنا وأبينا","https://www.aldiwan.net/poem34437.html","الخفيف"],[567,"عتبت سعاد ولم أكن بالمذنب","https://www.aldiwan.net/poem52964.html","الكامل"],[567,"الزهر تبسم نورا عن أقاحيها","https://www.aldiwan.net/poem52974.html","البسيط"],[572,"مستهتر بالرمي واه عضده","https://www.aldiwan.net/poem69720.html","الرجز"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34414","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59435","الكامل"],[1387,"","https://poetry.dctabudhabi.ae/diwan/poem/64586","الرجز"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124719","الكامل"],[1923,"","https://poetry.dctabudhabi.ae/diwan/poem/118300","الوافر"],[2267,"","https://poetry.dctabudhabi.ae/diwan/poem/104963","الكامل"],[2490,"","https://poetry.dctabudhabi.ae/diwan/poem/45597","المنسرح"],[2895,"","https://poetry.dctabudhabi.ae/diwan/poem/143710","الكامل"],[3008,"","https://poetry.dctabudhabi.ae/diwan/poem/103196","السريع"],[3473,"","https://poetry.dctabudhabi.ae/diwan/poem/74070","الكامل"],[3558,"","https://poetry.dctabudhabi.ae/diwan/poem/107096","الرجز"],[3608,"","https://poetry.dctabudhabi.ae/diwan/poem/101227","الكامل"],[3626,"","https://poetry.dctabudhabi.ae/diwan/poem/129469","الوافر"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131950","الكامل"],[3714,"","https://poetry.dctabudhabi.ae/diwan/poem/199022","الرجز"],[4701,"غزل عذري","https://www.poetsgate.com/ViewPoem.aspx?id=184188",""],[4926,"تحيّات إجلال عن الحصر جلَّت","https://www.poetsgate.com/ViewPoem.aspx?id=171107",""],[5033,"حسّان","https://www.poetsgate.com/ViewPoem.aspx?id=183980",""],[5055,"وثقت سد","https://www.poetsgate.com/ViewPoem.aspx?id=101662",""],[5136,"ما هز عطفي ملة الحنفاء","https://www.poetsgate.com/ViewPoem.aspx?id=121489",""],[5373,"بلاغة القرآن وإعجازه","https://www.poetsgate.com/ViewPoem.aspx?id=186008",""],[5730,"أحصت قصائده أم خانها العدُّ؟","https://www.poetsgate.com/ViewPoem.aspx?id=210350",""],[5732,"هيهات اطيعك","https://www.poetsgate.com/ViewPoem.aspx?id=177897",""],[5736,"دموع الرحيل","https://www.poetsgate.com/ViewPoem.aspx?id=203163",""],[5759,"رحلت","https://www.poetsgate.com/ViewPoem.aspx?id=213550",""],[5950,"غثى ..!!","https://www.poetsgate.com/ViewPoem.aspx?id=128333",""],[5963,"شاعرٌ في زمن الضَّياع","https://www.poetsgate.com/ViewPoem.aspx?id=187324",""],[6062,"وعد","https://www.poetsgate.com/ViewPoem.aspx?id=176606",""],[6068,"أحصر أعاني أم تركت طبوعا -05-","https://www.poetsgate.com/ViewPoem.aspx?id=176001",""],[6127,"إليكِ يا أنا","https://www.poetsgate.com/ViewPoem.aspx?id=203112",""]],"verses":[["أَحصَلُ مِن عَزمي عَلى التَمَنّي","وَلَيتَني أَفعَلُ أَو لَوَ اِنّي",0,"ن",2,0],["أحصن من سور كل عالية ال","سور حفاظاً ومن خنادقها",1,"ق",3,0],["احص لي كل خطا","ياك واذمم عملك",2,"ك",1,0],["أحصيرٌ ممزقٌ أم حريرٌ","مقعد للمجاهد الصبَّارِ",3,"ر",1,0],["أَحصَيتُ خَمسَةَ أَشهُرِ مَعدودَةٍ","وَثَلاثَةً مِن بَعدِها لَم توهَمِ",4,"م",1,0],["أَحِصْنَ اللهِ يُوعِدُ كلُّ رامٍ","ويطمعُ أن يكونَ له مُهينا",5,"ن",2,0],["أحْصِ الرجالَ وآتِ كُلّاً حَقَّهُ","ممّا أفاءَ اللهُ ذُو الآلاءِ",6,"ا",2,0],["أحْصَاه يا سعدُ عَدّاً ثم ضَاعَفَهُ","فلستَ تُحْصِيهِ حَتّى تُحْصِيَ الأُمَما",7,"م",2,0],["أَحَصُّ أَطرافَ القُدامى وَحوَحٍ","أَبرَشُ ما بَينَ القَرا وَالمَذبَحِ",8,"ح",1,0],["أحصنتَ في شرخ الشباب، وطالما","ألقى الشباب إلى الهوى بقياد",9,"د",1,0],["أحصيد دور الثقافة في الشرقِ","ألا يستينُ منهُنَّ قائِم؟",10,"م",1,0],["أحصنُ من سورِ كلِّ عالية ِ السْ","سُور حِفاظاً ومن خنادقها",11,"ق",3,0],["أحصِن ما شئتَ من حصىً وقُطارِ","فمعاليه ليس تُحصَى بَعدِّ",12,"د",1,0],["أَحَصّانِ من نَحْوِ الأَسافِلِ جُرّدا","أَلِفّانِ مِنْ أَعلاهما هَدِيانِ",13,"ن",1,0],["أَحصاهُمُ عَدَداً فَما اِشتَمَلَت","مِنهُم جَريدَتُهُ عَلى حُرِّ",14,"ر",1,0],["أَحْصَى أُصُولَ الْفَنِّ مُحْكَمَةً","وَحَاكَهَا طُرًّا عَلَى نَزْوَتِهِ",15,"ت",2,0],["أُحصِي السنينَ يَسُرُّ نفسي طولُها","وقصيرُ ما يُغنيك مثلُ الأطوَلِ",16,"ل",1,0],["أَحُصُّ فَلا أُجيرُ وَمِن أُجِرهُ","فَلَيسَ كَمَن تَدَلّى بِالغُرورِ",17,"ر",1,0],["أحصنوا بالتقى فروج قلوب","طاهرات ممن سواكم بِفاس",18,"س",1,0],["أحصى من الكُتُبِ الذي كَتَبوا لنا","فيها وزادَ عليهِ ما لم يُكَتبِ",19,"ب",1,0],["أحصى المُنى والثَّنا والحَزْمَ والكَرَمَ ال","أسنى وآياتِ عدلٍ لَستُ أُحصيها",20,"ي",3,0],["أحصنُ شيءٍ حين يرْمي طردُه","كأنّه فؤادهُ أوْ كَبِدُهُ",21,"ه",1,0],["أحصي لَيالي البينِ في حِسبانِهِ","فَأجِزهُ عَن بابِ الصُدودِ وَعَدِّهِ",22,"د",2,0],["أحصى الوجود بأسره","وأحاطه كيلا وعد",23,"د",1,0],["أحصى وسوى وقضى وعلما","بممد لا إله إلا اللّه",24,"ه",1,0],["أحصى الورى متكفلاً أرزاقهم","وحوى خروج الرزقِ بالإتقانِ",25,"ن",1,0],["احصراء السواقي ما ورائي","الان غربت أيها الانشائي",26,"ي",1,1],["أحصاهم عدداً وهم عدد الحصى","وأبادهم وهم الرمال حسابا",27,"ب",2,0],["أَحصَت أُلوفَاً يسراه أَربَعةً","مَنقوصة سَبعة مِن العَدَد",28,"د",1,0],["أحصي على دهري الذنوب بمقلة","لدموعها لا أملك الإحصاء",29,"ا",2,0],["أحصني اللَه بكفي فتىً","مهذب من سر قحطان",30,"ن",1,0],["أَحصَت عليك جهادك الأُمَم","وَتناقلتك العرب وَالعَجَمُ",31,"م",1,1],["أحصَى مِنَ الكافِيَةِ الخلاَصَه","كمَا اقتَضَى غِنًى بِلاَ خَصَاصَه",32,"ه",1,0],["أحصى فوارسها وأردى عمرها","وهوى بحد السيف نشر بنودها",33,"د",3,0],["أحصن المستجير ونجل جود","به للعلم كم بنيت حصون",34,"ن",1,1],["أحصى الرسائل من حبيب عابث","طورا وطورا عاتبا لواما",35,"م",2,0],["أحصى الكثير منه والقليلا","وعلم الجملة والتفصيلا",36,"ل",2,0],["أُحْصِي لكِ العمرَ بالأحلامِ ناقصةً","لو كنتُ أشْهدُ أنَّ العمرَ إحصاءُ",37,"ا",2,0],["أحصِّنه بالله من شرِّ حاسدٍ","ومن مدلهمّات الخطوب الملمَّة",38,"ه",1,0],["احْصُدْ نِتَاجَكَ مَا زَرَعْتَ بُذُورَا","يَا رَبَّ بَيْتِيَ بَلْ زَرَعْتَ سُرُورَا",39,"ر",2,1],["احصون شعر وعمّرت دارس الطين","فقلوب ناسٍ سعْيهم للمثالي",40,"ل",2,0],["أحصاهم قتلا وأنهب ما لهم","وغدا بأبناء لهم ونساء",41,"ا",2,0],["أَحْصَى عُلُوْماً في نُصُوْصٍ ، جُلَّهَا","فِيْهَا الأَدِلَّةُ لِلتَّجَارُبِ تَخْضَعُ",42,"ع",1,0],["‏أحصت قصائدهُ أم خانها العدُّ؟","وانسابَ في فمها الهجرانُ والصدُّ؟",43,"د",1,1],["احصد بذارك باليدين الحفيفات","لو شفت يالبراق فيها غليبه",44,"ب",2,0],["أحصيت خيباتٍ، حزمت حقائبًا","وغرست نصلا في الفؤادِ المدنفِ",45,"ف",1,0],["أُحصي النجومَ بلا حسابٍ علَّني","أنسى السُهادَ بذلكَ الإحصاءِ",46,"ا",2,0],["أحصدي ما علق بالذاكره من غثى","حرريني من الصمت الهزيل الغثيث",47,"ث",1,0],["أَحْصَتْهُ مُقْلَتُهُ الأُولىٰ فَصَادَقَهَا","مَنْ ذَا لِمُقْلَتِهِ الأُخرىٰ يُعَدِّدُهُ ؟!",48,"د",2,0],["أحصي له الوقت كم يبقى ليسعفني","من وحشة الليل , والشوق الذي ثملا",49,"ل",2,0],["أحصر أعاني أم تركت طبوعا","لذلك أنسيت الكلام جميعا",50,"ع",2,1],["أحصيتَ منهمْ أمةً معدودةً","هِيَ في الأنام وقدْ بدتْ جلمودا",51,"د",2,0]]}