{"poems":[[51,"أعقب القرب من حبيبك شحط","https://www.aldiwan.net/poem65005.html","الخفيف"],[87,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54259","الطويل"],[133,"أياب الإمام حياة الأمم","https://www.aldiwan.net/poem4211.html","المتقارب"],[160,"لو كنت تعلم ما بأهل زبيد","https://www.aldiwan.net/poem58886.html","الكامل"],[229,"أعذلا وما عذلتني النهى","https://www.aldiwan.net/poem51276.html","المتقارب"],[403,"يا قرير العين في بلده","https://www.aldiwan.net/poem33965.html","الرمل"],[432,"تلين لعزمي بالعراء العوائك","https://www.aldiwan.net/poem12691.html","الطويل"],[477,"أرى العيش بعد المالكية لا يحلو","https://www.aldiwan.net/poem15218.html","الطويل"],[558,"ظهرت لقلبي بما قد نوى","https://www.aldiwan.net/poem34272.html","المتقارب"]],"verses":[["فكشطْنا سماءَ ذُلٍّ عليهم","لم يكن يُرتجَى لها الدهرَ كشطُ",0,"ط",1,0],["فَكَشَّفَ اللَّهُ مِنها غُمَّةً نَزَلَت","بِالمُؤمِنينَ وَرَبِّي كاشِفُ الغُمَمِ",1,"م",1,0],["فكشَّفْتَ أسرارَ السياسةِ مُوجِزاً","وجئتَ بما يَعْيَا به اليومَ مُسهبُ",2,"ب",1,0],["فكشراً لخيلٍ وفلكٍ دنت","بمستأصلِ الظلمِ ماحي الظُّلَم",3,"م",1,0],["فكشف عنهم ما كشفت من البلا","وعددت هذا النخل خير عديد",4,"د",1,0],["فكشّف من ليلها ما سَجَا","وقوَّم من زَيْغها ما التوى",5,"ا",1,0],["فكشفت الكرب وانقشعت","سحب الأظلام من سدده",6,"د",2,0],["فكشِّفْ حجابَ السّمْعِ عن صِدْقِ مقولي","فما هو فيما قالَهُ فيكَ آفكُ",7,"ك",1,0],["فكشَّفْتُ أستارَ الحِجابِ كأنَّني","لِمَنْ دونَها بَعْلٌ واِن كَرِهَ البَعْلُ",8,"ل",1,0],["فكشفك للحجب حتى أراكا","فؤادي بفرط الجوى ممتلي",9,"ي",1,0]]}