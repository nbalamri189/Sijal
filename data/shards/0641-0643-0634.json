{"poems":[[53,"أعقب القرب من حبيبك شحط","https://www.aldiwan.net/poem65005.html","الخفيف"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/29339","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54259","الطويل"],[137,"أياب الإمام حياة الأمم","https://www.aldiwan.net/poem4211.html","المتقارب"],[164,"لو كنت تعلم ما بأهل زبيد","https://www.aldiwan.net/poem58886.html","الكامل"],[234,"أعذلا وما عذلتني النهى","https://www.aldiwan.net/poem51276.html","المتقارب"],[409,"يا قرير العين في بلده","https://www.aldiwan.net/poem33965.html","الرمل"],[438,"تلين لعزمي بالعراء العوائك","https://www.aldiwan.net/poem12691.html","الطويل"],[482,"أرى العيش بعد المالكية لا يحلو","https://www.aldiwan.net/poem15218.html","الطويل"],[563,"ظهرت لقلبي بما قد نوى","https://www.aldiwan.net/poem34272.html","المتقارب"],[609,"","https://poetry.dctabudhabi.ae/diwan/poem/198599","الخفيف"],[657,"","https://poetry.dctabudhabi.ae/diwan/poem/200323","الكامل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77611","الرجز"],[936,"","https://poetry.dctabudhabi.ae/diwan/poem/138719",""],[1018,"","https://poetry.dctabudhabi.ae/diwan/poem/105469","الكامل"],[1603,"","https://poetry.dctabudhabi.ae/diwan/poem/117126","المتقارب"],[2021,"","https://poetry.dctabudhabi.ae/diwan/poem/139350",""],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48237","الطويل"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27862","السريع"],[3121,"","https://poetry.dctabudhabi.ae/diwan/poem/100724","الطويل"],[3823,"","https://poetry.dctabudhabi.ae/diwan/poem/34629","الكامل"],[4247,"","https://poetry.dctabudhabi.ae/diwan/poem/33069","المنسرح"],[4433,"","https://poetry.dctabudhabi.ae/diwan/poem/121273","الكامل"],[4767,"جزاء سنمار","https://www.poetsgate.com/ViewPoem.aspx?id=87719",""],[5050,"أرى الأيام لي حربا","https://www.poetsgate.com/ViewPoem.aspx?id=38212",""],[5121,"جنون عاقلة","https://www.poetsgate.com/ViewPoem.aspx?id=37465",""],[5409,"ماذا حدا بك فاعتزمت رحيلا","https://www.poetsgate.com/ViewPoem.aspx?id=155477",""],[5409,"صوني جمالك بالحياء","https://www.poetsgate.com/ViewPoem.aspx?id=155249",""],[5953,"إن يوم الغدير يوم السرور","https://www.poetsgate.com/ViewPoem.aspx?id=93784",""],[2220,"ما والدي إلا الذي يحكم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=11794&r=&rc=664",""]],"verses":[["فكشطْنا سماءَ ذُلٍّ عليهم","لم يكن يُرتجَى لها الدهرَ كشطُ",0,"ط",1,0],["فَكَشَّفَ اللَّهُ مِنها غُمَّةً نَزَلَت","بِالمُؤمِنينَ وَرَبِّي كاشِفُ الغُمَمِ",1,"م",1,0],["فكشفت عني الموت منك بألوةٍ","كمتن جواد شقّ عنها لبودها",2,"د",3,0],["فكشَّفْتَ أسرارَ السياسةِ مُوجِزاً","وجئتَ بما يَعْيَا به اليومَ مُسهبُ",3,"ب",1,0],["فكشراً لخيلٍ وفلكٍ دنت","بمستأصلِ الظلمِ ماحي الظُّلَم",4,"م",1,0],["فكشف عنهم ما كشفت من البلا","وعددت هذا النخل خير عديد",5,"د",1,0],["فكشّف من ليلها ما سَجَا","وقوَّم من زَيْغها ما التوى",6,"ا",1,0],["فكشفت الكرب وانقشعت","سحب الأظلام من سدده",7,"د",2,0],["فكشِّفْ حجابَ السّمْعِ عن صِدْقِ مقولي","فما هو فيما قالَهُ فيكَ آفكُ",8,"ك",1,0],["فكشَّفْتُ أستارَ الحِجابِ كأنَّني","لِمَنْ دونَها بَعْلٌ واِن كَرِهَ البَعْلُ",9,"ل",1,0],["فكشفك للحجب حتى أراكا","فؤادي بفرط الجوى ممتلي",10,"ي",1,0],["فكشفتَ الهمومَ والرَّوعَ حتى","نسيَ الكلُّ لوعةَ الأحزانِ",11,"ن",1,0],["فكشفت رأسي ثم قلت لمالك:","كروا عليهم يا فدائكم أبي",12,"ب",2,0],["فَكَشفوه مِن قَريبٍ فَجَرى","وَدَخل الجُحر وَما تَأَخَّرا",13,"ر",2,0],["فكشفت من تلك الغوامض سرها","وجريت في الزرقاء جرى مذاكى",14,"ك",2,0],["فكشفت عن دين النبي ضلالةً","شحذت عليه بارقات رفاقها",15,"ق",3,0],["فكشفها البعل قبل الصدا","ق فاستقبلته بمعتافها",16,"ف",3,0],["فكشفهُ عمّا في يديه فإنّما","يُبيِّن أخلاقَ الرّجالِ الدّراهمُ",17,"م",1,0],["فَكَشَّفْتَ ما لم يَكْشِفِ الصبحُ بالضيا","بعزمكَ حُجْباً دونَها الشمسُ تَغْربُ",18,"ب",1,0],["فكشفنا قوَّض بنيانه","والفكر في أنفسنا طنبا",19,"ب",2,0],["فكشف عنها الهول والهول واثب","اخو فتكات للنفوس مبيد",20,"د",1,0],["فكشفت عن خدَّيك لي","لكشفت عن مثل المفوف",21,"ف",1,0],["فَكَشَفتُ عَن ذي جَمَّةٍ عُصُباً","تَنزو عَلى بَرَّيهِ ضَفدَعُهُ",22,"ع",2,0],["فَكَشَفنَ عمّا في البراقِعِ مختَفٍ","وترَكنَ ما تخفى الصدورُ مكَشّفا",23,"ف",2,0],["فكشفت أبغيك النجاة مقاصداً","ما كنت يوماً بالمقاصد تعبأ",24,"ا",1,0],["فكشر نابه غضبا","كما أغضبتم الكلبا",25,"ب",2,0],["فَكَشَفْتُ أَسْرَاراً بِدَمِّي صُنْتُهَا","وَنَزِيِفُهَا شِعْرٌ تَجَلَّى فَانْعَتَقْ",26,"ق",1,0],["فكشفتها من بعد ما عالجتها","وهناً معالجة الطبيب عليلا",27,"ل",2,0],["فكشفت منها الجانبين","وعفت للوسط النقابا",28,"ب",2,0],["فكشفت الغطاء طوعا لدين","مظهرا كنه ذاته المستور",29,"ر",1,0],["فكشرهُ عندَ إلهِ السما","شكرٌ بهِ ظهرُ العدى يقصمْ",30,"م",1,0]]}