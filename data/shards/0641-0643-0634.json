{"poems":[[53,"أعقب القرب من حبيبك شحط","https://www.aldiwan.net/poem65005.html","الخفيف"],[89,"يا رائد البرق يمم دارة العلم","https://www.aldiwan.net/poem8190.html","البسيط"],[28,"","https://poetry.dctabudhabi.ae/diwan/poem/29339","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54259","الطويل"],[136,"أياب الإمام حياة الأمم","https://www.aldiwan.net/poem4211.html","المتقارب"],[163,"لو كنت تعلم ما بأهل زبيد","https://www.aldiwan.net/poem58886.html","الكامل"],[232,"أعذلا وما عذلتني النهى","https://www.aldiwan.net/poem51276.html","المتقارب"],[406,"يا قرير العين في بلده","https://www.aldiwan.net/poem33965.html","الرمل"],[435,"تلين لعزمي بالعراء العوائك","https://www.aldiwan.net/poem12691.html","الطويل"],[479,"أرى العيش بعد المالكية لا يحلو","https://www.aldiwan.net/poem15218.html","الطويل"],[560,"ظهرت لقلبي بما قد نوى","https://www.aldiwan.net/poem34272.html","المتقارب"],[599,"","https://poetry.dctabudhabi.ae/diwan/poem/200323","الكامل"]],"verses":[["فكشطْنا سماءَ ذُلٍّ عليهم","لم يكن يُرتجَى لها الدهرَ كشطُ",0,"ط",1,0],["فَكَشَّفَ اللَّهُ مِنها غُمَّةً نَزَلَت","بِالمُؤمِنينَ وَرَبِّي كاشِفُ الغُمَمِ",1,"م",1,0],["فكشفت عني الموت منك بألوةٍ","كمتن جواد شقّ عنها لبودها",2,"د",3,0],["فكشَّفْتَ أسرارَ السياسةِ مُوجِزاً","وجئتَ بما يَعْيَا به اليومَ مُسهبُ",3,"ب",1,0],["فكشراً لخيلٍ وفلكٍ دنت","بمستأصلِ الظلمِ ماحي الظُّلَم",4,"م",1,0],["فكشف عنهم ما كشفت من البلا","وعددت هذا النخل خير عديد",5,"د",1,0],["فكشّف من ليلها ما سَجَا","وقوَّم من زَيْغها ما التوى",6,"ا",1,0],["فكشفت الكرب وانقشعت","سحب الأظلام من سدده",7,"د",2,0],["فكشِّفْ حجابَ السّمْعِ عن صِدْقِ مقولي","فما هو فيما قالَهُ فيكَ آفكُ",8,"ك",1,0],["فكشَّفْتُ أستارَ الحِجابِ كأنَّني","لِمَنْ دونَها بَعْلٌ واِن كَرِهَ البَعْلُ",9,"ل",1,0],["فكشفك للحجب حتى أراكا","فؤادي بفرط الجوى ممتلي",10,"ي",1,0],["فكشفت رأسي ثم قلت لمالك:","كروا عليهم يا فدائكم أبي",11,"ب",2,0]]}