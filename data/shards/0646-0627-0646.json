{"poems":[[29,"كأني بالمديبر بين زكا","https://www.aldiwan.net/poem5752.html","الوافر"],[1122,"","https://poetry.dctabudhabi.ae/diwan/poem/98088","الخفيف"],[1858,"","https://poetry.dctabudhabi.ae/diwan/poem/106703","الطويل"]],"verses":[["نَآني وُدُّهُم فَنَئيتُ إِنّي","بِذَلِكَ حينَ لا أُدنى جَديرُ",0,"ر",1,0],["نإن تأمَّلتَهُ فبومَةُ جُشٍّ","وإذاما شَمَمتَهُ كان صَقرا",1,"ر",2,0],["نأنهُ عَنِ البَطحا لُؤَيُّ بنُ غالِبٍ","وأحشَاؤُهُم تعلِي وأعيُنُهُم حُزرُ",2,"ر",1,0]]}