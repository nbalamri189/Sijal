{"poems":[[95,"لا تحقر الدرهم من مسعد","https://www.aldiwan.net/poem11340.html","السريع"],[95,"علمتنا بالمثال والقلم","https://www.aldiwan.net/poem11355.html","المنسرح"],[90,"كل ما في البلاد من أموال","https://www.aldiwan.net/poem44984.html","الخفيف"],[53,"طرقت أسماء والركب هجود","https://www.aldiwan.net/poem61906.html","الرمل"],[53,"حاجيت فضلا وهو ذو فطنة","https://www.aldiwan.net/poem64660.html","السريع"],[53,"حاجتي أيها الأمير كتاب","https://www.aldiwan.net/poem65437.html","الخفيف"],[72,"يا رسول الحبيب أهلا وسهلا","https://www.aldiwan.net/poem42677.html","الخفيف"],[72,"يا كثير الصدود والإعراض","https://www.aldiwan.net/poem42843.html","الطويل"],[91,"لبيك من آمر يا خير من عزما","https://www.aldiwan.net/poem44739.html","البسيط"],[47,"لا أرى بالبراق رسما يجيب","https://www.aldiwan.net/poem10653.html","الخفيف"],[47,"عاد للصب شجوه واكتئابه","https://www.aldiwan.net/poem10654.html","الخفيف"],[47,"حاجة ذا الحيران أن ترشده","https://www.aldiwan.net/poem63481.html","البسيط"],[47,"ما لذا الظبي لاينال إقتناصه","https://www.aldiwan.net/poem64618.html","الخفيف"],[47,"هبل الواشي بها أنى أفك","https://www.aldiwan.net/poem65215.html","الرمل"],[47,"برق أضاء العقيق من ضرمه","https://www.aldiwan.net/poem65686.html","المنسرح"],[47,"يا أبا الصقر وعدك المضمون","https://www.aldiwan.net/poem66815.html","الخفيف"],[71,"حاجبك المزور أبعده عن","https://www.aldiwan.net/poem28454.html","السريع"],[54,"حاجيتكم يا كل من لامني","https://www.aldiwan.net/poem26649.html","السريع"],[48,"حاجي نظيم جمان والحياة معي","https://www.aldiwan.net/poem22537.html","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54834","الرجز"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54674","الخفيف"],[47,"هُبِلَ الوَاشِي بهَا، أنّى أفَكْ","https://www.poetsgate.com/ViewPoem.aspx?id=33095",""],[124,"من عذيري من الذي يبكيني","https://www.aldiwan.net/poem49349.html","الخفيف"],[132,"كتب الحسن في محياك سطرا","https://www.aldiwan.net/poem50510.html","الخفيف"],[164,"يا بحر علم يزخر","https://www.aldiwan.net/poem59124.html","مجزوء الرجز"],[234,"إن اسم من سمته أجفانه","https://www.aldiwan.net/poem50938.html","السريع"],[287,"بأبي الريم الذي مر بنا","https://www.aldiwan.net/poem32406.html","الرمل"],[287,"يا عاذلي أقصر فكم تتعب","https://www.aldiwan.net/poem32861.html","السريع"],[309,"قد كفاني علم ربي","https://www.aldiwan.net/poem16762.html","مجزوء الرمل"],[354,"حاجج لمن قال أنا أنت بالسب","https://www.aldiwan.net/poem15810.html","السريع"],[369,"وعدت باستراقة للقاء","https://www.aldiwan.net/poem61018.html","الخفيف"],[385,"من لنفس طال في الحب عناها","https://www.aldiwan.net/poem49195.html","الرمل"],[408,"وثلاث لما بدت لي منها","https://www.aldiwan.net/poem46684.html","الخفيف"],[408,"برح الشوق فواصل","https://www.aldiwan.net/poem46726.html","مجزوء الرمل"],[438,"أنجد الصب وغاروا","https://www.aldiwan.net/poem12645.html","مجزوء الرمل"],[443,"سل دار هند بالكثيب الفرد","https://www.aldiwan.net/poem2579.html","الرجز"],[463,"بلغت صبرا فقالت ما الخبر","https://www.aldiwan.net/poem56203.html","الرمل"],[463,"لعلها واليأس منها أغلب","https://www.aldiwan.net/poem56283.html","الرجز"],[563,"حولوا عني من الكون لثاما","https://www.aldiwan.net/poem33885.html","الرمل"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34475","المنسرح"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48775","الرمل"],[853,"","https://poetry.dctabudhabi.ae/diwan/poem/38188","الرمل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59093","الخفيف"],[1109,"","https://poetry.dctabudhabi.ae/diwan/poem/61162","السريع"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136205","الخفيف"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136093","الخفيف"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/73970","السريع"],[1466,"","https://poetry.dctabudhabi.ae/diwan/poem/115966","الرجز"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/11904","الخفيف"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26480","البسيط"],[1799,"","https://poetry.dctabudhabi.ae/diwan/poem/99899","المنسرح"],[1899,"","https://poetry.dctabudhabi.ae/diwan/poem/52077","الرمل"],[1951,"","https://poetry.dctabudhabi.ae/diwan/poem/114799","الكامل"],[2105,"","https://poetry.dctabudhabi.ae/diwan/poem/101761","السريع"],[2310,"","https://poetry.dctabudhabi.ae/diwan/poem/28566","الخفيف"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/121019","السريع"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/121029","الرجز"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/121013","السريع"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/121005","الرجز"],[2496,"","https://poetry.dctabudhabi.ae/diwan/poem/100435","السريع"],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/94039","الرمل"],[2913,"","https://poetry.dctabudhabi.ae/diwan/poem/104671","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203483","السريع"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62943","الخفيف"],[3644,"","https://poetry.dctabudhabi.ae/diwan/poem/66353","السريع"],[3797,"","https://poetry.dctabudhabi.ae/diwan/poem/103802","الرمل"],[4028,"","https://poetry.dctabudhabi.ae/diwan/poem/101382","الكامل"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123482","الخفيف"],[4203,"","https://poetry.dctabudhabi.ae/diwan/poem/105533","الخفيف"],[4206,"","https://poetry.dctabudhabi.ae/diwan/poem/93774","المنسرح"],[4341,"","https://poetry.dctabudhabi.ae/diwan/poem/136557",""],[4391,"","https://poetry.dctabudhabi.ae/diwan/poem/114045","الرمل"],[4532,"","https://poetry.dctabudhabi.ae/diwan/poem/45316","البسيط"],[4791,"سحابة الغره","https://www.poetsgate.com/ViewPoem.aspx?id=36948",""],[4984,"التَّضْحِيَّةُ","https://www.poetsgate.com/ViewPoem.aspx?id=201088",""],[5057,"الخطوة الأولى","https://www.poetsgate.com/ViewPoem.aspx?id=197231",""],[5061,"حب بدوي","https://www.poetsgate.com/ViewPoem.aspx?id=148017",""],[5542,"نفحة من بستان الوحي","https://www.poetsgate.com/ViewPoem.aspx?id=10057",""],[1547,"حاجتي شقَّة ٌ تشقّ على كلِّ","https://www.poetsgate.com/ViewPoem.aspx?id=16749",""],[5652,"حاجه وانا من حاجتي ماتعلمت ؟؟","https://www.poetsgate.com/ViewPoem.aspx?id=178306",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[402,"علتنا بالمثال والقلم","https://www.poetsgate.com/ViewPoem.aspx?id=36322",""],[5837,"أعداء النجاح","https://www.poetsgate.com/ViewPoem.aspx?id=181808",""],[5956,"الحمد لله على إرساله لمحمد","https://www.poetsgate.com/ViewPoem.aspx?id=192571",""],[5956,"أنا أحتفي بإخائه البنَّاء","https://www.poetsgate.com/ViewPoem.aspx?id=194391",""],[5970,"قد تبارى الناس في حب الحياة","https://www.poetsgate.com/ViewPoem.aspx?id=130590",""],[6031,"هَتَفَتْ بِدَمْعِ العَينِ وَهْي سَجُومُ","https://www.poetsgate.com/ViewPoem.aspx?id=46292",""],[6031,"قُلْ لِمَنْ يُرْجِعُ الحَوَائجَ","https://www.poetsgate.com/ViewPoem.aspx?id=46404",""]],"verses":[["حَاجَتُنَا الْيَوْمَ إِلَيْهِ فَمَنْ","لَمْ يَقْضِ مَا تُوجِبُهُ بَأْثَمِ",0,"م",1,0],["حَاجَتُنَا أُسْرَةٌ تَقُومُ عَلَى","مَا يَقْتَضِي عَصْرُنَا مِنَ النظُمِ",1,"م",1,0],["حاجة المرء أكلةٌ وكساء","وسوى ذاك بسطة في الكمال",2,"ل",1,0],["حاجتي ثقْلٌ وقد حُمّلْتَهَا","فاحْتملْها لا تكاءَدْكَ كَؤودُ",3,"د",1,0],["حاجَيْت فضلاً وهو ذو فطنةٍ","ما زال للحكمة درَّاسا",4,"س",2,1],["حاجتي أيها الأمير كتاب","لا يخلُّ التوكيد منه بحرفِ",5,"ف",1,1],["حاجَةٍ ما لَنا إِلَيها سَبيلٌ","وَلَعَمري لَقَد تَعَزُّ عَلَينا",6,"ن",2,0],["حاجَةً مُذ أَرَدتُها أَنا في التَع","ريضِ عَنها وَأَنتَ في الإِعراضِ",7,"ض",1,0],["حاججتهم بكتاب اللَه تفحمهم","فكان امضى من الصمصامة الذكر",8,"ر",1,0],["حاجَزوا سابِقاً تَمَهَّلَ حَتّى","أَحسَرَ الريحَ شَأوُهُ المَطلوبُ",9,"ب",1,0],["حاجَةٌ لَو أَمَرتَ فيها بِنُجحٍ","قَرُبَ النازِحُ البَعيدُ مَآبُه",10,"ب",2,0],["حاجَةُ ذا الحَيرانِ أَن تُرشِدَه","أَو تَترُكَ اللَومَ الَّذي لَدَّدَه",11,"د",2,1],["حاجَةٌ إِن قَضَيتَ فيها بِأَمرٍ","ذَلَّ مَأمورُها وَقَلَّ اِعتِياصُه",12,"ص",2,0],["حاجَتٌ ما عَرَضَت عائِرَةً","أَخَذَ التَخفِفُ مِنها وَتَرَك",13,"ك",1,0],["حاجَتُنا أَن تَدومَ مُدَّتُهُ","وَسُؤلُنا أَن نُعاذَ مِن عَدَمِه",14,"م",2,0],["حاجَتي سَهلَةٌ لَدَيكَ وَرَأيٌ","إِن قَبَلتُ التَعذيرَ فيها أَفينُ",15,"ن",1,0],["حاجبُكَ المزْورُّ أَبْعدْهُ عنْ","عينِكَ واحذرْ منهُ أنْ يهلكَكْ",16,"ك",1,1],["حاجَيتُكُم يا كُلَّ مَن لامَني","قولوا بِحَقٍّ أَو دَعوني إِذَن",17,"ن",1,1],["حاجي نَظيمُ جُمانٍ وَالحَياةُ مَعي","سِلكٌ قَصيرٌ فَيَأبى جَمعَها القِصَرُ",18,"ر",1,1],["حَاجَتُنَا إِلى الْهدَى قَدْ بَلَغَتْ","غَايَتَهَا فِي الزَّمَنِ الأَخِيرِ",19,"ر",1,0],["حَاجَةٌ مِنْ لَوَازِمِ النُّقْصَانِ","تِلْكَ فِي الخَلْقِ سُنَّةُ الرَّحْمَنِ",20,"ن",1,0],["حاجَةٌ ما عَرَضَتْ عائِرَةٌ،","أخَذَ التّخفيفُ منها، أوْ تَرَكْ",21,"ك",1,0],["حاجة النفس كلها ومني النف","س جميعاً في سحر هذي الجفون",22,"ن",1,0],["حاجبُ مقلة فمٌ لؤلؤى","نشْرُه المسكُ درُّه منظومُ",23,"م",1,0],["حاجيت في أربعة","منها اشتبهت الصور",24,"ر",1,0],["حاجيتكم ما هُوَ إن كنتُمُ","عِصابةَ الآدابِ والظَرفِ",25,"ف",1,0],["حاجِباهُ حَجَبا عَنّي الكَرى","وَسَناهُ صَدَّ عَنّي الوَسَنا",26,"ن",2,0],["حاجِبُهُ يُغنيهِ عَن قَوسِهِ","وَلَحظُهُ السَهمُ فَما يُحجَبُ",27,"ب",1,0],["حاجَةً في النَفسِ رَبّي","فَاِقضِها يا خَيرَ قاضي",28,"ي",1,0],["حاجَج لِمَن قالَ أَنا أَنتَ بِالسَب","بِ وَبِالضَربِ وَبِالصَكِّ",29,"ك",1,1],["حاجِبٌ دون حاجِبِ الشمسِ عنه","ظِلُّ مَبنيّةٍ له قَوراء",30,"ا",2,0],["حاجة في نَفس يَعقوب الأَسى","لَو يَجود الدَهر يَوماً لَقَضاها",31,"ا",3,0],["حاجباها ومُقلتاها وما تَنثرُ","مِن درّ لفظِها السحّارِ",32,"ر",1,0],["حاجبي المقرون نُونٌ","وعذاري سَالَ سائلْ",33,"ل",1,0],["حاجزٌ فيه على منْ","يتعاطاه احْتِجارُ",34,"ر",1,0],["حاجبها حاجبُها لكنّهُ","إذا أتاهُ مشتكٍ لا يعدي",35,"د",2,0],["حاجةٌ تمّتْ ووافى حظُّها","حين نبَّهتُ لها منك عُمَرْ",36,"ر",1,0],["حاجةُ صدرٍ لك لا ملفوظةٌ","ولا تَسوغُ حُلوةً فُتشرَبُ",37,"ب",1,0],["حاجب يعلو على العين هنا","أسود يعطي اتفاقا واختصاما",38,"م",2,0],["حاجاك مَن جُدتَ بالنوال لَهُ","مصحِّفاً ما نوالُ مَحبوبِ",39,"ب",1,0],["حاجة الخلق إلى مزرعة","قبل ما حل اكتشافاً واختراعا",40,"ع",2,0],["حاجِباكَ القَوسُ مِن غَيرِ وَتَرْ","بِسِهامِ الحبِّ قد أَفنى المُهَجْ",41,"ج",1,0],["حَاجب الشَّمْس حَجَّبَ القمرَا","بحجَاب النَّهَارْ",42,"ر",1,1],["حاجيت ذا فهم وَذا فطنة","في اسم رُباعي مِن الطَّير",43,"ر",1,1],["حاجتي منك يا الهي دخولي","في فريق همو لديك حضور",44,"ر",1,0],["حاجة في الفواد يا رب اني","ارتجيها فاسمح لها بقضاء",45,"ا",2,0],["حاجبك المفرطِ في ظلمهِ","أعانه ناظرك الجائر",46,"ر",1,0],["حاجبُهُ قوسٌ ولحظُ عينهِ","سهمٌ فما يُخطى إذا ما رَشَقَا",47,"ق",2,0],["حاجَتي شُقَّةٌ تَشُقُّ عَلى كُلِّ","بَغيضٍ مِنَ الوَرى وَحَسودِ",48,"د",1,1],["حاجَيتُكُم مَن أَبوكُم يا بَني عُصَبٍ","شَتّى وَلكِنَّما لِلعاهِرِ الحَجَرُ",49,"ر",1,0],["حاجة مثلي إليك عارفةٌ","عندك بالله لست تشكرها",50,"ه",2,0],["حَاجَةُ المَدحِ لِحُلوِ الغَزَلِ","حَاجَةُ الصَّبّ لأولَى القُبَلِ",51,"ل",1,1],["حاجاك مُكتَتِماً بما في نَفسِه","ولَطيفُ ذِهنكَ مُخرِجٌ ما يكتُم",52,"م",1,0],["حاجبُهُ قَوْسٌ وأَجفانُهُ","نَبْلٌ وعطفاه تَثَنِّي الرماحْ",53,"ح",1,0],["حاجَة خَفَّ حملُها وَلَها","مِن ثَقيلٍ يَبقى عَلى الأَعناقِ",54,"ق",1,0],["حاجيتكم ما اسمٌ لبعضِ السّباع","تصحيفُهُ ما لكَ فيه انتفاع",55,"ع",1,1],["حاجيتكم ما اسمُ عَلَم","ذو نسبة إلى العجم",56,"م",1,1],["حاجيتُ كلَّ فطِنٍ نظَّارِ","ما اسمٌ لأنثى من بني النّجارِ",57,"ر",1,1],["حاجيتُ كلَّ فطِنٍ لبيبِ","مَا اسمٌ لأنثى من بني يعقوبِ",58,"ب",1,1],["حاجبه قوس لنبالة","رمى بها القلب فأصماه",59,"ا",2,0],["حاجة في النفس أقضيها ولم","تغن شيأ بعد عمن قد عني",60,"ن",2,0],["حاجَةٌ مَن لي بِها إِذ أَصبَحَت","هِيَ في النَفسِ المُناكُلُ المِنا",61,"ن",2,0],["حاجات جسمي كثّرت همي","يا ليتني روح بلا جسم",62,"م",1,1],["حاجبُ الشمسِ ما يُغيبُ عنه","فسواءٌ غروبُها والشرُوقُ",63,"ق",1,0],["حاجبه نون وفي ثغره ال","فجر ومن جبهته النور",64,"ر",1,0],["حاجب ما إن ثنى انمله","بالعطايا والمنايا تندفق",65,"ق",1,0],["حاجج مجاورك الذي","خلط الجدال المحض بالفن",66,"ن",1,0],["حاجباه كنونى الخط زينا","بجبين رحب بهىّ الضياء",67,"ا",2,0],["حاجز الحر مانع القر لكن","آذن للعليل أن يتنسم",68,"م",1,0],["حاجة لا طامح لمرتبة","وَلا فخور يُمجد اللقبا",69,"ب",2,0],["حاجبك الفتاك أم باتُر","وطرفكَ السفاكُ أم ساحر",70,"ر",1,1],["حاجب العذراء تحت الستر هل","أنت تخشى أن يراها ذكر",71,"ر",1,0],["حاجَيتُكُم يا بَني اللَخناءِ أَينَ أَنا","في حَيصَ بيصَ عَلى الصَلعاءِ فَاِبغَوني",72,"ن"