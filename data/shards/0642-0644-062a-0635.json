{"poems":[[71,"لمت صباغكم على","https://www.aldiwan.net/poem28275.html","مجزوء الخفيف"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85813","الخفيف"],[190,"جئت أشكو إلى الطبيب الذي بي","https://www.aldiwan.net/poem44170.html","الخفيف"],[201,"طرقتني فجر يوم المولد","https://www.aldiwan.net/poem39890.html","الرمل"],[203,"قلت صلني فإني لك باق","https://www.aldiwan.net/poem45573.html","الخفيف"],[242,"زادك الله يا خليلي رشدا","https://www.aldiwan.net/poem18167.html","الخفيف"],[289,"ولقد قلت حين أجحرني البرد","https://www.aldiwan.net/poem44308.html","الخفيف"],[463,"أتمنى والمنى جهد المقل","https://www.aldiwan.net/poem55996.html","الرمل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77575","الرجز"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70852","الرمل"],[1343,"","https://poetry.dctabudhabi.ae/diwan/poem/109187","السريع"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/128233","الخفيف"],[2900,"","https://poetry.dctabudhabi.ae/diwan/poem/102164","الرمل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201556","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/201188",""],[3222,"","https://poetry.dctabudhabi.ae/diwan/poem/70400","الخفيف"],[4572,"","https://poetry.dctabudhabi.ae/diwan/poem/22792","الرمل"],[5376,"لستُ عنه من أنسِه ببعيدِ","https://www.poetsgate.com/ViewPoem.aspx?id=191853",""],[5573,"ساقه الله فوق ساقه والقدم","https://www.poetsgate.com/ViewPoem.aspx?id=200221",""]],"verses":[["قلتُ صفَّرْتَ لونَهُ","قالْ رجلي تزَرِّقُهْ",0,"ه",1,0],["قلت صفحاً فكل فلسفتي قد","كان مما يمليه عقلي الصغير",1,"ر",1,0],["قلت صف لي فقال لي بانكسار","فطبيبي ممّا رأى بي كئيب",2,"ب",1,0],["قلتُ صونيها فإنّ الدمع غالي","أدمعاً للروح لا للجسد",3,"د",1,0],["قلتُ صلني فإني لكَ باق","ولو أن الكثيرَ ليسَ بباق",4,"ق",1,1],["قُلْتُ صَالِحٌ قَدْ عَلاَ غَارِبَ الفَضْ","لِ وَيَعْلُو الذِي اقْتَنَى الْفَضْلَ عَبْدَا",5,"د",2,0],["قُلتُ صَبراً نازَ رَأس السَنانيرِ","وَعَلَلتهُ بِحُسنِ مَقالَه",6,"ل",2,0],["قلتِ صبراً فهبيني فِلقةً","من أبانٍ قد أذابتني المقلْ",7,"ل",1,0],["قُلت صدقت يا مُشير فاصغ","وَسر بِنا إِلى الهُدى لا تَطغ",8,"غ",1,0],["قلتُ صَبٌّ ما لدائي","من دواءٍ ومُداوى",9,"ا",3,0],["قلت صدقتم فهو فوق الذي","عن فعله قيل وعن شكله",10,"ل",2,0],["قلت صرح فقال تجهل من","سيف ألحاظه تحكم فيك",11,"ك",1,0],["قلت صف لي قدك الزاهي","وأوضح زدت وجدي",12,"د",2,0],["قلت صه عالمي الحياةُ ومن لم","يك مثلي فلم يكن في العالم",13,"م",1,0],["قلت : صدقت يا أخي","لو كان في الحرب أدب",14,"ب",1,0],["قلت صدقاً وجئت حقاً فلو قل","ت وكافي الدنيا لبَرَّت يمينُكْ",15,"ك",1,0],["قُلتُ صِح ياديكُ أَلفاً","لَيسَ ذا وَقتَ البَراحِ",16,"ح",1,0],["قلت صبراً عليَّ بعد جفاء","إنَّ وجدَ المحبِّ نارُ الغيدِ",17,"د",1,0],["قلت صدرك لايضيق ابه النسم","كان مالك مع مغباته وعد",18,"د",1,0]]}