"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54537","الطويل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55418","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55142","البسيط"],[19,"","https://poetry.dctabudhabi.ae/diwan/poem/2232","الطويل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67312","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142040","الرجز"],[53,"","https://poetry.dctabudhabi.ae/diwan/poem/13661","الطويل"],[0,"","https://poetry.dctabudhabi.ae/diwan/poem/1912","الطويل"],[59,"","https://poetry.dctabudhabi.ae/diwan/poem/117017","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54289","الطويل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54232","الوافر"],[77,"عهد الشباب سقى أيامك الأولا","https://www.poetsgate.com/ViewPoem.aspx?id=34202",""],[50,"لَقَدْ ذَكَّرَتْنِي لَيْلَة ُ الْقَدْرِ مَجْلِساً","https://www.poetsgate.com/ViewPoem.aspx?id=21679",""],[90,"أمين الريحاني","https://www.poetsgate.com/ViewPoem.aspx?id=178954",""],[90,"العزم وأبناؤه","https://www.poetsgate.com/ViewPoem.aspx?id=178926",""],[90,"الشاعرية","https://www.poetsgate.com/ViewPoem.aspx?id=650",""],[45,"تَبيتُ لَهُ، مِنْ شَوْقِهِ وَنِزَاعِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=32194",""],[45,"أراجعة سعدى على هجودي","https://www.poetsgate.com/ViewPoem.aspx?id=31396",""],[94,"ذكرى الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=15593",""],[94,"الحبّ والله","https://www.poetsgate.com/ViewPoem.aspx?id=15625",""],[99,"إليه في يوم ميلاده","https://www.poetsgate.com/ViewPoem.aspx?id=211910",""],[99,"الى ضفيرتي ماس","https://www.poetsgate.com/ViewPoem.aspx?id=36371",""],[51,"تَبحَّثتُ عن أخباره فكأنما","https://www.poetsgate.com/ViewPoem.aspx?id=30609",""],[51,"يا طول غلَّة نفسِي المبلاهِ","https://www.poetsgate.com/ViewPoem.aspx?id=30801",""],[97,"غصن صغير","https://www.poetsgate.com/ViewPoem.aspx?id=25527",""],[97,"زازا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=63558&r=&rc=104",""],[31,"وإني لسائلُ أمّ الربيعِ،","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=18956&r=&rc=219",""],[88,"طرب الشعر أن يكون نسيبا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=19532&r=&rc=35",""]],"verses":[["تُضاجِعُني الحَسناءُ وَالسَيفُ دونَها","ضَجيعانِ لي وَالسَيفُ أَدناهُما مِنّي",0,"ي",1,1],["تَضُمُّ رِجالاً كَالرِماحِ إِذا دُعوا","إِلى الحَربِ لَفّوا نارَها بِضِرامِ",1,"م",1,0],["تَضَرَّمَ خَدّاهُ حَتّى عَجِبتُ","لِعارِضِهِ كَيفَ لَم يَضطَرِم",2,"م",1,0],["تَضحَكُ عَن وَجهِهِ غَياهِبُها","كَأَنَّهُ بِالهِلالِ مُلتَثِمُ",3,"م",1,0],["تُضمَنُ الأَعناقُ لِلسَيفِ إِذا","أَخفَرَ السَيفُ عَلى الدِرعِ الذِماما",4,"م",2,0],["تَضحَكُ عَن وَميضِهِ","لَمّاعَةٌ مِنَ الدِيَم",5,"م",1,0],["تَضُمُّهُ في الرَوعِ مِن دِرعِهِ","أُمٌّ لَها مِنهُ أَذىً أَو عُقوق",6,"ق",1,0],["تَضيقُ صُدورُ العَتبِ وَالعُذرُ أَوسَعُ","وَيجمَحُ طَرفُ الهَجرِ وَالوِدُّ أَطوَعُ",7,"ع",1,1],["تُضاعُ كَما ضاعَت خَلاةٌ بِقَفرَةٍ","زَفَتها النُعامى وَالرِياحُ الزَعازِعُ",8,"ع",1,0],["تَضبَعُ عَن غِبِّ الوَنى كَأَنَّها","عائِمَةٌ قَد رَفَعَت شِراعَها",9,"ع",3,0],["تَضوعُ أَرواحُ نَجدٍ مِن ثِيابِهِمُ","عِندَ النُزولِ لِقُربِ العَهدِ بِالدارِ",10,"ر",1,0],["تَضَرَّعتُ في أَعقابِ وَجدٍ عَليكُمُ","وَمَن فاتَهُ الإِعذارُ بِالأَمرِ عَذَّرا",11,"ر",2,0],["تَضَنَّ وَقَد ضَنَنتُ فَما أَراها","بِعَينِ المُستَعيرِ وَلا المُعيرِ",12,"ر",1,0],["تُضافِرُني فيكَ الصَوارِمُ وَالقَنا","وَيَصحَبُني مِنكَ العُذَيقُ المُرَجَّبُ",13,"ب",1,0],["تَضَوَّعَ مِسكاً حينَ ناجاهُ ذَيلُها","كَأَنَّ مَحانيهِ مَذاكٍ لِطيبِهِ",14,"ب",2,0],["تَضِنُّ بِما نَبغي لِظَنٍّ تُسيئُهُ","أَلا ساءَ ما ظَنَّت بِنا حينَ ضَنَّتِ",15,"ت",1,0],["تَضْفو عَليهِمْ أدْرُعٌ مَوضونَةٌ","يَرْتَدُّ عنها السّيفُ مَفْلولَ الشَّبا",16,"ا",1,0],["تَضحكُ منْ ذي ولَهٍ يَبكي الصِّبا","شَوْقاً إِلى أيّامِهِ القَلائِلِ",17,"ل",1,0],["تُضيءُ وَراءَ اللُّثْمِ كالشّمْسِ أشْرَقَتْ","وَراءَ غَمامٍ للغَزالَةِ ساتِرِ",18,"ر",1,0],["تُضَوِّعُ أرياحَ النّجيعِ دُروعُهُمْ","وتَنفَحُ مِسْكاً ساطِعاً حِبَراتُها",19,"ت",3,0],["تَضَمَّنَ نِعمَتي فَغَدا عَلَيه","بُكوراً أَو تَعَجَّلَ في الرَواحِ",20,"ح",1,0],["تُضيءُ بِاللَيلِ إِذا ما بَدَت","أَزَّرَها الحُسنُ وَرَدّاها",21,"ا",3,0],["تَضِنُّ إِذا اِستَمنَحتُها لِيَ نَظرَةً","أُداوي بِها ما يُحدِثُ الحُبُّ في صَدري",22,"ي",1,1],["تُضيءُ أوجُهُها والحَرْبُ كالِحَةٌ","قد شابَ مفْرِقُها بالنّقْعِ واكْتَهَلا",23,"ل",2,0],["تَضِيقُ عَلَىَّ الأَرْضُ وَهيَ فَسِيحَةٌ","كَمَا ضَاقَ فَوْقَ الْخِصْرِ مَعْقِدُ هِمْيَانِ",24,"ن",1,0],["تَضِنُّ بِكَ الدُّنْيَا وَيَحْرُسُكَ الْعُلا","كَأَنَّكَ مِنْهَا بَيْنَ لَحْظٍ وَأَجْفاَنِ",25,"ن",1,0],["تضمّنَ منْ نوْعِ الدّعابَةِ ما بِهِ","رجَوْتُ الذي قد قيلَ في نشْوَةِ الخَمْرِ",26,"ر",1,0],["تُضْرَمُ النّارُ في غَديرٍ دِلاصٍ","وعَزيزٌ تآلُفُ الأضْدادِ",27,"د",1,0],["تُضْحِكُ لِحْيَيْكَ لَها رِعْدَةٌ","ضِحْكَ الحَصا في مَطْرَحِ المَوْجِ",28,"ج",1,0],["تَضبُطُ المَوكِبَ الرَفيعَ بِأَيدٍ","وَسَنامٍ مُصَعَّدٍ مَكثوبِ",29,"ب",1,0],["تَضَيَّفتُهُ يَوماً فَقَرَّبَ مَقعَدي","وَأَصفَدَني عَلى الزَمانَةِ قائِدا",30,"د",2,0],["تَضَيَّفَ رَملَةَ البَقّارِ يَوماً","فَباتَ بِتِلكَ يَضرِبُهُ الجَليدُ",31,"د",1,0],["تَضَيَّفتُ يَوماً عَلى نارِهِ","مِنَ الجودِ في مالِهِ أَحتَكِم",32,"م",1,0],["تَضيعُ الحَقيقَةُ ما بَينَنا","وَيَصلى البَريءُ مَعَ المُذنِبِ",33,"ب",1,0],["تَضِلُّ بِلَيلِها لِهبٌ فَتَحكي","بِوادي التيهِ أَقوامَ الكَليمِ",34,"م",1,0],["تَضُمُّهُم في حَشاها طولَ لَيلَتِها","وَأَكثَرَ اليَومِ إِشفاقاً مِنَ الباري",35,"ي",1,0],["تَضحَكُ في الحُبِّ وَأَبكي أَنا","أَللَهُ فيما بَينَنا حاكِمُ",36,"م",1,0],["تَضحَكُ الأَزمُنُ عَن عَلياكُما","ضَحِكَ الرَوضَةِ عَن ثَغرِ الزَهَر",37,"ر",1,0],["تُضيءُ الظَلامَ بِالعِشاءِ كَأَنَّه","مَنارَةُ مَمسى راهِبٍ مُتَبَتِّلِ",38,"ل",1,0],["تَضَمّنَ داءً مُنذُ عِشرينَ حِجَةً","لَكُم ما تُسَلِّيهِ السُنونَ الكَواذِبُ",39,"ب",1,0],["تضاهيتما قدراً وحسناً وشيمةً","كما يتضاهى في تقابله الورد",40,"د",1,0],["تَضُمُّهُمْ فِي سَبِيلِ الضَّادِ جَامِعَةٌ","كُلٌّ بِهَا لأَخِيهِ خَيْرُ مِعْوَانِ",41,"ن",1,0],["تَضُمُّهُ وَالرِّفَاقُ المُقْتَدِينَ بِهِ","عُرَى يَقِينٍ مَتِينٍ لَيْسَ تَنْفَصِمُ",42,"م",1,0],["تُضامُ اِمرُؤُ القَيسِ بنُ لُؤمٍ حُقوقَها","وَتَرضى وَلا يُدعى لِحُكمٍ عَميدُها",43,"د",3,0],["تُضحي بِهِ الرَوعاءُ كَالبَليدِ","وَفِتَية غيدٍ مِنَ التَسهيدِ",44,"د",1,0],["تضيء النجومَ الزاهراتِ خِلالُهُ","وينفث في رُوع الزّمان المعاليا",45,"ي",2,0],["تضيق عن الحق أرواحهم","وإن لبسوا واسعات الجبب",46,"ب",1,0],["تضيء نجوم السعد واليمن فوقه","فينجاب شؤم الدهر عنه ونحسه",47,"س",2,0],["تضحك الجوّ في الصباح طلوعاً","ثم تبكيه في المساء غروبا",48,"ب",2,0],["تضطرب الأرض والسماء له","إذا غدا بالجَناح يضطرب",49,"ب",1,0],["تضاربت الأهواء فيهم فناكبٌ","عن الشرّ يُقصيه وآخر جالبه",50,"ب",2,0],["تَضيق بها الأنفاس حتى كأنما","على كل حيزوم صفائح جَلْمَد",51,"د",1,0],["تضجّ الملاهي وهو كالطود شامخ","فلم تلقه إلا من المجد يطرب",52,"ب",1,0],["تُضيءُ لَنا الحِجالُ سَنا غِمامٍ","إِذا لَمَحَت غَوارِبُهُ اِنجَلَينا",53,"ن",2,0],["تَضَمَّنَ ما أَضَعتَ بَنو قُرَيعٍ","لِجارِكَ أَن يَموتَ مِنَ الخُفاتِ",54,"ت",1,0],["تَضحَكُ عَن ذي أُشُرٍ بَرّاقِ","كَالأُقحُوانِ اِهتَزَّ في البِراقِ",55,"ق",1,0],["تُضَمَّنُ بيضاً كَالإِوَزِّ ظُروفُها","إِذا أَتأَقوا أَعناقَها وَالحَواصِلا",56,"ل",2,0],["تضور يشكو ما به من خصاصة","وكاد من الإفصاح بالشكو يعربُ",57,"ب",1,0],["تضيق بنا الفجاج وهنَّ فِيحٌ","ونهجرُ ماءَها السدم الدفينا",58,"ن",2,0],["تضَيّفه تحت الألاءةِ مَوهِناً","بظلماءَ فيها الرَّعدُ والبَرقُ صَيِّبُ",59,"ب",1,0],["تَضِيقُ بِنَا الفِجَاجُ وَهُنٌّ فُتحٌ","ونُجهِزُ ماءَهَا السَّدِمَ الدَّفِينَا",60,"ن",2,0],["تَضِنُّ بِالحَربِ عَنّا ضَنَّ ذي بُخَلٍ","وَمِنكَ في كُلِّ حالٍ يُعرَفُ الكَرَمُ",61,"م",1,0],["تضيء في الحرب والمحراب طلعته","فحبذا في الدجى والنقع قنديل",62,"ل",1,0],["تضايق بي التصبّرُ عنك شوقاً","وأسلمني الزفيرُ إلى النحيبِ",63,"ب",1,0],["تَضَعَّفَتْني ومتَى نالني","عونُ أبي الصَّقْرِ تَضَعَّفْتُهَا",64,"ت",3,0],["تَضمَّنَ تذليلَ الزمان فأصبحتْ","أواعِرُهُ ذَلَّت لنا وأواعِثُهْ",65,"ث",2,0],["تُضاحك نُوَّاراتُها زهرَاتها","لها أرَج في نافح العطر نافحُ",66,"ح",1,0],["تضاحك في أفنان رأسي ولحيتي","وأقبحُ ضَحَّاكَيْن شَيْبٌ وأدْردُ",67,"د",1,0],["تضن به الأم الرؤوم على ابنها","وإن كان مأمولاً لسدّ المفاقرِ",68,"ر",1,0],["تضيّفتهُ أحلى من الشهد مَرفِداً","وجاورته أحمى حَمِيّاً من الدَّبْر",69,"ر",1,0],["تضيء نجوم الليل في الليل وحده","وليس لها ضوء إذا الصبح نَوَّرا",70,"ر",2,0],["تُضحي وتمسي وأنت ملتمسٌ","أعيَطَ كالرمح من ذوي الطُّرر",71,"ر",1,0],["تضرب خَيشاً إذا تغنَّت","عليك في قائم الظهيره",72,"ر",2,0],["تضَمَّنتُ أن لا يبخل الدهرُ بعدها","بأي نفيسٍ بعدكم هو نافس",73,"س",1,0],["تضاءلُ في عيني الجموع لدى الوغى","وإن هي جاءت بالقضيض وبالقضّ",74,"ض",1,0],["تضغطُ الصوت الذي تشدو به","غُصّةٌ في حلقها معترضهْ",75,"ض",2,0],["تضل في السربال من قلة","كصعوة في جوف قفّاعه",76,"ع",2,0],["تضحي الرياح إذا تمطَّر في","شأويه حسرى ليس تتبعه",77,"ع",2,0],["تضمن عن وجهها ومخبرها","حسنَ رُواءٍ وقبح منكشف",78,"ف",1,0],["تضحي أحبته تُوَلَّى سفحه","عند الفراق وعند كل تلاقي",79,"ق",2,0],["تضُلُّ عن الدقيق عقول قومٍ","فتحكم للمجل على المدق",80,"ق",1,0],["تُضيءُ للناسِ وهم فوق المُثل","محترقاتٌ للمفاريح الجُذل",81,"ل",1,0],["تَضْفو عليك فُضُولُه","فيُعاشُ فيه ويُستظلُّ",82,"ل",1,0],["تُضَعْضِعُهُ الأوقاتُ وهْي بقاؤهُ","وتغتاله الأقواتُ وهْي له طُعمْ",83,"م",1,0],["تُضْحي يداهُ لمالهِ","ما شئتَ من جارٍ هضوم",84,"م",1,0],["تَضَوَّعتِ الأنباءُ عنه بنفحةٍ","زويتُ لها وجهي من الخُبث والنتنِ",85,"ن",1,0],["تضعُ السلاح تأثُّماً وتكرماً","وتظلُّ بالرأي السديدِ مُزابنا",86,"ن",2,0],["تُضْحِي وتُمْسِي لا يُغِبُّ مُحِبُّها","مَلْهَى كرىً أو مأثم استنباه",87,"ه",1,0],["تَضَمَّنُها نُفوسُ الشَربِ حَتّى","يَروحوا في عُيونِهِمِ اِنكِسارُ",88,"ر",1,0],["تُضيءُ لَنا الظَلماءَ غُرَّةُ وَجهِهِ","إِذا الأَقعَسُ المِبطانُ أَرتَجَ حاجِبُه",89,"ب",2,0],["تُضيءُ في اللَيلَةِ الظَلماءِ سُنَّتُهُ","كَما يُضيءُ لِمَن يَسري بِهِ القَمَرُ",90,"ر",1,0],["تَضفَر لِرَأسِكَ مِن أَزاهِرِها الرُبى","تاجا وَتَهتُفُ بِاِسمِكَ الأَغوارُ",91,"ر",1,0],["تُضاحِكُ الخَلقَ لا زَهوا وَلا لَعِباً","وَتَجحَدُ الفَقرَ لا كِبرا وَلا أَشَرا",92,"ر",2,0],["تَضاحَكَ الشَيبُ في رَأسي فَعَرَّضَ بي","ذو الشَيبِ عِندَ الغَواني مَوضِعُ التُهَمِ",93,"م",1,0],["تَضاعَفَ عِندي مِنهُ حينَ قَرَأتُهُ","مِنَ الشَوقِ وَالتَبريحِ ما اللَهُ عالِمُه",94,"م",2,0],["تُضيءُ لَيالي الدَهرِ مِنكَ مُنيرَةً","وَأَيّا