tsgate.com/ViewPoem.aspx?id=129805",""],[1012,"السلوك","https://www.poetsgate.com/ViewPoem.aspx?id=186323",""],[4830,"حَوالِكُ النأي","https://www.poetsgate.com/ViewPoem.aspx?id=211128",""],[4961,"للصلاةِ شهبٌ يراها العارفون","https://www.poetsgate.com/ViewPoem.aspx?id=47905",""],[4119,"إن كان لا بد من السكر","https://www.poetsgate.com/ViewPoem.aspx?id=16162",""],[4119,"دار تغار الشمس في أفقها","https://www.poetsgate.com/ViewPoem.aspx?id=16143",""],[5054,"نَعيمُ روحي","https://www.poetsgate.com/ViewPoem.aspx?id=213763",""],[3271,"لم يطب للنبوغ فيك مقام","https://www.poetsgate.com/ViewPoem.aspx?id=103537",""],[3749,"رفاهية الشهم اقتحام العظائم","https://www.poetsgate.com/ViewPoem.aspx?id=134962",""],[5102,"أبي . . .","https://www.poetsgate.com/ViewPoem.aspx?id=15171",""],[5121,"دَهْشَة","https://www.poetsgate.com/ViewPoem.aspx?id=215977",""],[5122,"لله","https://www.poetsgate.com/ViewPoem.aspx?id=27776",""],[5142,"الفردوس المضرج","https://www.poetsgate.com/ViewPoem.aspx?id=11405",""],[5224,"يا حسن ما أجلاك في عيني وفي بصري","https://www.poetsgate.com/ViewPoem.aspx?id=121308",""],[5285,"الغريب","https://www.poetsgate.com/ViewPoem.aspx?id=203649",""],[5353,"كن سوى ان تكون نفسك سجنا","https://www.poetsgate.com/ViewPoem.aspx?id=214881",""],[5431,"ولانور إلا الله عنك يُدافعُ","https://www.poetsgate.com/ViewPoem.aspx?id=198629",""],[5550,"يا ابن الوجود","https://www.poetsgate.com/ViewPoem.aspx?id=211770",""],[5582,"أَتَجْحَدُ داءَ الحُبِّ عِنْدَ المُشاهِدِ","https://www.poetsgate.com/ViewPoem.aspx?id=186906",""],[5628,"ترنيمة الحرية","https://www.poetsgate.com/ViewPoem.aspx?id=178440",""],[5690,"إذا الصارم البتار عزت مضاربه","https://www.poetsgate.com/ViewPoem.aspx?id=172139",""],[5691,"بيادق","https://www.poetsgate.com/ViewPoem.aspx?id=206042",""],[5691,"طغى الجوْر","https://www.poetsgate.com/ViewPoem.aspx?id=206098",""],[5756,"التمثال","https://www.poetsgate.com/ViewPoem.aspx?id=1366",""],[5894,"ته بالجمال وطف على أوقاتي","https://www.poetsgate.com/ViewPoem.aspx?id=131412",""],[5909,"ما لي وللزهرِ إنّ الزهرَ فَّواحُ","https://www.poetsgate.com/ViewPoem.aspx?id=210561",""],[5917,"تمسك بتقوى اللّه فالمرء لا يبقى","https://www.poetsgate.com/ViewPoem.aspx?id=106538",""],[5973,"رودي-مرثية","https://www.poetsgate.com/ViewPoem.aspx?id=13241",""],[5986,"أيا بدر المعارف والمعالي","https://www.poetsgate.com/ViewPoem.aspx?id=162953",""],[6052,"روضة الايمان","https://www.poetsgate.com/ViewPoem.aspx?id=35138",""],[6070,"دوامُ البقاءِ بربي محالْ","https://www.poetsgate.com/ViewPoem.aspx?id=188867",""],[6124,"أنفاسك الحيرى","https://www.poetsgate.com/ViewPoem.aspx?id=159464",""],[6144,"باريس","https://www.poetsgate.com/ViewPoem.aspx?id=13694",""],[6213,"أرض ونجوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76296&r=&rc=44",""],[5957,"فحبكَ عندي فراتٌ ونيلٌ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82451&r=&rc=90",""],[6237,"آذان الفجر","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77887&r=&rc=29",""],[6243,"منعرج","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84441&r=&rc=15",""],[463,"صديقٌ يداري الحزنَ عنكَ مماذقُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=60154&r=&rc=210",""],[5126,"الحياة صغرى وكبرى!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87821&r=&rc=36",""],[572,"تُرِيكَ مُرورُ الليالي العِبَرْ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9276&r=&rc=133",""]],"verses":[["تَمَسَّكوا بِوَصايا اللُؤمِ تَحسَبُهُم","تُتلى عَليهِم بِها الآياتُ وَالزُبُرُ",0,"ر",1,0],["تَمَسُّ أَسِنَّةَ الأَرما","حِ مِن طولٍ مَغافِرُه",1,"ر",2,0],["تَمسَحُ التُربَ عَلى إِعجالِها","عَن طُلى نَحرٍ رَميلٍ بِالدِما",2,"ا",1,0],["تُمسي وَتُصبِحُ فَوقَ ظَهرِ حَشِيَّةٍ","وَأَبيتُ فَوقَ سَراةِ أَدهَمَ مُلجَمِ",3,"م",1,0],["تُمَسِّحُ باليُمْنى دُموعَ جفونِها","وتَجعلُ يُسْرى فوقَ قلْبٍ مُرَوَّعِ",4,"ع",1,0],["تُمسي فَيَصرِفُ بابُها مِن دونِها","غَلَقاً صَريفَ مَحالَةِ الأَمسادِ",5,"د",1,0],["تُمسي الرِياحُ بِهِ حَنّانَةً عُجُلاً","سَوفَ الرَوائِمِ بَوّاً بَينَ أَظآرِ",6,"ر",1,0],["تُمسِكُ أَحشاءَها عَلى حُرَقٍ","تُطفِئُها وَالهُمومُ تُشعِلُها",7,"ل",3,0],["تمسي إذا ذكرت يراعك بينها","ودموعها بدل السلاح سلاح",8,"ح",1,0],["تمسكتُ بالأمر الجميل مبرّءاً","من الغِشِّ إلا ما توهَّم واهمُ",9,"م",1,0],["تُمَسّي بِآجامَ الفُراتِ سَفاهَةً","وَتُحصِدُ في حافاتِهِ وَتُكاثِرُ",10,"ر",1,0],["تُمسينَ عِندَ مَجاري الماءِ نائِمَةً","وَلِلأَزاهِرِ وَالأَعشابِ مَغداكِ",11,"ك",1,0],["تُمسي الرِياحُ بِها حَسرى وَيَتبَعُها","سُرادِقٌ لَيسَ في أَطرافِهِ عَمَدُ",12,"د",1,0],["تُمسي الأَمانِيُّ صَرعى دونَ مَبلَغِهِ","فَما يَقولُ لِشَيءٍ لَيتَ ذَلِكَ لي",13,"ل",2,0],["تُمسي الضُيوفُ مُشَهّاةً بِعَقوَتِهِ","كَأَنَّ أَوقاتَها في الطيبِ آصالُ",14,"ل",1,0],["تُمسي عَلى أَيدي مَواهِبِهِ","هِيَ أَو بَقِيَّتُها أَوِ البَدَلُ",15,"ل",1,0],["تُمسي سُهولاً لَهُم يَرضَونَ بَسطَتَها","وَيُصبِحونَ لَها بِالعِزِّ أَوتادا",16,"د",2,0],["تُمسي الرِياحُ بِها وَقَد لَغِبَت","أَو كُلِّ صادِقَةٍ عَلى الفَترِ",17,"ر",1,1],["تمس يد الساقي الأغنّ بزالها","فتمنحه طيبا وتمنحه ودا",18,"د",2,0],["تمسَّكْتُ بالإنجيلِ لمَّا أباحَها","وخالفْتُ فيها نصَّ ما في المَصاحفِ",19,"ف",1,0],["تَمَسَّك بِالتُقى حَتّى تَموتا","وَلا تَدَعِ الكَلامَ أَوِ السُكوتا",20,"ت",2,1],["تَمَسَّكتَ بِآمالٍ","طِوالٍ بَعدَ آمالِ",21,"ل",1,1],["تمسَّك من قولِ ابن عمروٍ بمَوْثِقٍ","وطارت به في الجو هوجاء مجفال",22,"ل",1,0],["تُمسي المَكارِمُ حَيثُ يُمسي رَحلُهُ","وَإِذا غَدا في مَنزِلٍ أَغداها",23,"ا",3,0],["تمسحُ أيري بعد ما نكتُها","كأنّه أصغر أولادِها",24,"د",3,0],["تُمسي لشَقائِقُ فيها وَهيَ قانِيَةٌ","مِمّا سَقاها رُعافُ الجَديِ وَالأَسَدِ",25,"د",1,0],["تَمَسَّكَنَ طيباً أَم تَمَسَّكنَ حِليَةً","فَإِنّي رَأَيتُ النَوعَ يَلحَقُ بِالجِنسِ",26,"س",1,0],["تَمَسَّكَت بِحِبالِ العُمرِ مُهجَتُهُ","وَالوَقتُ بِالمَرِّ يوهي قُوَّةَ المَرسِ",27,"س",1,0],["تَمَسَّكَ بِتَقوى اللَهِ لَستُ بِقائِلٍ","تَمُسَّك وَمَعنايَ السُوارُ وَلا المِسكُ",28,"ك",1,1],["تَمَسَّكوا بِحِبالِ النُسكِ في زَمَنٍ","وَلاحَ نَزرٌ فَخَلّوا ما بِهِ اِمتَسَكوا",29,"ك",3,0],["تَمَسَّخَت في أُمورٍ غَيرَ طائِلَةٍ","سُهدٍ وَنَومٍ وَوَفَّت نِصفَها حَلَكا",30,"ك",2,0],["تُمسون أشتاتاً كما تصبحونْ","والشمس حيرى فوقكم والنجومْ",31,"م",1,0],["تُمَسِّحُ كفَّيكِ راحاتهنَّ","على قُبَلٍ من شفاهٍ ظماءْ",32,"ا",2,0],["تَمَّ سَعْدِي بِمَنْ رَأَيْ","تُ بِهَا الْيَوْمَ عَنْ كَثَبْ",33,"ب",1,0],["تَمَّ سَعْدُ المُنَى لسَامِرهِ","بَيْنَ لَيْلَى وَالظَّبْيِ وَالْقَمَرِ",34,"ر",1,0],["تمسك به في حالة السخط والرضا","وطهر به الآفات فهو طهور",35,"ر",1,0],["تمسَحُ الدمعةَ سالتْ حرّةً","فوق جُرحٍ فاحَ بالعِطر وسالا",36,"ل",2,0],["تُمسي الشقائقُ فيها، وهي قانيةٌ،","ممّا سقاها رُعافُ الجَدْي والأسد",37,"د",1,0],["تُمسِي الرّيَاحُ بهَا وَقَدْ لَغِبَتْ","أوْ كُلِّ صَادِقَةٍ عى الفَتْرِ",38,"ر",1,0],["تمس على اريكته وجوها","وتفرش حول ساحته عيونا",39,"ن",2,0],["تمسك بالكرام اخي واهجر","لئام الناس واصابع الرجالا",40,"ل",2,0],["تمسك بحب طاهر القلب واثبق","بحبك مشمول بحسن الشمائل",41,"ل",1,1],["تُمسي كِرامُ العَصرِ بَعضَ ضُيوفِهِ","وَيَبيتُ فِعلُ الخَيرِ مِن صَبَواتِهِ",42,"ت",2,0],["تمسّك ما استطعت عساك تنجو","بحبل الباقيات الصالحات",43,"ت",1,0],["تمسيى ورأيك عن هواك معوق","والغرّ ملقٍ في يد الأهوا الرسنْ",44,"ن",1,0],["تمسي تعللني أضاليل المنى","منها لمطل الوعد والليان",45,"ن",1,0],["تُمسي إَليهِ بِالسَلامِ مؤرِّخاً","أَبَداً وَتَغدو بِالمَراحمِ عِندَهُ",46,"د",2,0],["تمسكت من قولى لَعلَّ بهُدْبَةٍ","فلما وَهَت باليأسِ مات لها صبرى",47,"ر",2,0],["تمسّك بما تعطاه منها ولا تكن","له متلفا إلا تلاه بديل",48,"ل",1,0],["تُمَسِّحُ عَن أَجفانِها سِنَةَ الكَرى","بِراحَةِ فِضِّيّ البَنانِ خَضِيبِ",49,"ب",1,0],["تُمسي تُذَكِّرُنا الشَبابَ وَعهدهُ","حَسناءُ مُرهَقةُ القَوامِ فنَذكُر",50,"ر",1,1],["تمسي وتصبح في البيداء هاجرة","طيب الكرى عند إسحار وتبكير",51,"ر",1,0],["تُمسي بِأَبوابِها الآمالُ مُحدِقَةً","حَتّى يَغصَّ بِوَفدِ الحَمدِ ناديها",52,"ي",3,0],["تُمسي أَكاليلُهُنَّ ال","خَيرِيُّ وَالمَنثورُ",53,"ر",1,0],["تمسَّكْ بحبلِ الأخيليةِ واطَّرحْ","عدا النَّاسِ فيها والوشاةَ الأدانيا",54,"ي",2,0],["تمسَّكي بعرى الإيمانِ واثقةً","فإنَّ دِينَك موصولٌ بدنياك",55,"ك",1,0],["تمسي سمير النجم وَحدك ساهِرا","وَالركب دونك في الرجال هجودا",56,"د",2,0],["تُمسينَ مِن أَلَمِ الفِراقِ سَليمَةً","يا هَذِهِ و