{"poems":[[65,"أسمراء عهدي بالخطوب قريب","https://www.aldiwan.net/poem46118.html","الطويل"],[79,"لقد رام كتم الوجد يوم ارتحاله","https://www.aldiwan.net/poem36375.html","الطويل"],[53,"صبحة النوروز في الأحد","https://www.aldiwan.net/poem61831.html","المديد"],[53,"وكم معان وألفاظ مهذبة","https://www.aldiwan.net/poem64020.html","البسيط"],[40,"ضعيف العصا بادي العروق ترى له","https://www.aldiwan.net/poem7728.html","الطويل"],[87,"مر الغراب بشاة","https://www.aldiwan.net/poem8039.html","المجتث"],[87,"أنادي الرسم لو ملك الجوابا","https://www.aldiwan.net/poem63784.html","الوافر"],[45,"لعينيك ما يلقى الفؤاد وما لقي","https://www.aldiwan.net/poem9733.html","الطويل"],[63,"محلك مثل الغاب ليس يرام","https://www.aldiwan.net/poem51457.html","الطويل"],[82,"وأكلف منسره ذو شغا","https://www.aldiwan.net/poem31367.html","المتقارب"],[22,"ألا طرقتنا بعدما هجدوا هند","https://www.aldiwan.net/poem21643.html","الطويل"],[54,"ردت علي اللوم ظلامة","https://www.aldiwan.net/poem26606.html","السريع"],[69,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[50,"إذا ذكر الفراق بكى","https://www.aldiwan.net/poem64468.html","مجزوء الوافر"],[52,"لحى الله حماد بن نهيا فإنه","https://www.aldiwan.net/poem63895.html","الطويل"],[48,"أما الحسام فما أدناك من أجل","https://www.aldiwan.net/poem22791.html","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42687","الطويل"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54231","الطويل"],[108,"صحا الشرق","https://www.poetsgate.com/ViewPoem.aspx?id=179625",""],[69,"جِوَارُكَ منْ جَوْرِ الزَّمانِ يُجِيرُ","https://www.poetsgate.com/ViewPoem.aspx?id=14535",""],[124,"فتى مزق الحب البرح قلبه","https://www.aldiwan.net/poem49299.html","الطويل"],[147,"شفاء الهدى يا سيفه العضب أن تشفا","https://www.aldiwan.net/poem11779.html","الطويل"],[164,"إِذا حسدا مالت عن الصاحب الصحب","https://www.aldiwan.net/poem58822.html","الطويل"],[164,"سطوت بسلطان الجمال على الصب","https://www.aldiwan.net/poem58871.html","الطويل"],[190,"أبا طالب لله در مناقب","https://www.aldiwan.net/poem43271.html","الطويل"],[193,"رأى مدح خير الخلق صعبا فأحجما","https://www.aldiwan.net/poem35105.html","الرمل"],[203,"ألا لا تلمه اليوم أن يتألما","https://www.aldiwan.net/poem45633.html","الطويل"],[280,"جناني عامر بهوى جناني","https://www.aldiwan.net/poem25501.html","الوافر"],[303,"قفا عللا قبل التفرق عانيا","https://www.aldiwan.net/poem36278.html","عموديه"],[368,"بالعفر دار من جميلة هيجت","https://www.aldiwan.net/poem1718.html","الطويل"],[369,"وصال الشمس يهدي الاحتراقا","https://www.aldiwan.net/poem60836.html","الوافر"],[369,"تجلت فقلت البدر لولا عقودها","https://www.aldiwan.net/poem60950.html","الطويل"],[415,"وكيف أشكر من أسدى إلي يدا","https://www.aldiwan.net/poem32253.html","البسيط"],[438,"أجزعت بعد إقامتي من رحلتي","https://www.aldiwan.net/poem12382.html","الكامل"],[438,"أظن البدر نازعك الكمالا","https://www.aldiwan.net/poem12760.html","الوافر"],[463,"ألا صاحب كالسيف حلو شمائله","https://www.aldiwan.net/poem55994.html","الطويل"],[466,"من شاء يعلم ما خص الوزير به","https://www.aldiwan.net/poem16132.html","البسيط"],[484,"خذ الكاسات واشرب من مدامي","https://www.aldiwan.net/poem37598.html","الوافر"],[522,"أقبله على جزع","https://www.aldiwan.net/poem60550.html","مجزوء الوافر"],[543,"بكم شعري على غيري فخور","https://www.aldiwan.net/poem48179.html","عموديه"],[580,"أرى كل شيء في البسيطة قد نما","https://www.aldiwan.net/poem3021.html","الطويل"],[592,"إلى الله في كشف المهمات نرغب","https://www.aldiwan.net/poem11511.html","عموديه"],[592,"ألا مال نيران الأسى تتضرم","https://www.aldiwan.net/poem11519.html","عموديه"],[840,"","https://poetry.dctabudhabi.ae/diwan/poem/143235","الطويل"],[885,"","https://poetry.dctabudhabi.ae/diwan/poem/77542","الرجز"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120100","الرمل"],[1046,"","https://poetry.dctabudhabi.ae/diwan/poem/96568","الطويل"],[1055,"","https://poetry.dctabudhabi.ae/diwan/poem/96624","الطويل"],[1300,"","https://poetry.dctabudhabi.ae/diwan/poem/31620","المتقارب"],[1333,"","https://poetry.dctabudhabi.ae/diwan/poem/6779","البسيط"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48987","الطويل"],[1565,"","https://poetry.dctabudhabi.ae/diwan/poem/113960","المتقارب"],[1703,"","https://poetry.dctabudhabi.ae/diwan/poem/141276","الطويل"],[1867,"","https://poetry.dctabudhabi.ae/diwan/poem/130678","البسيط"],[1957,"","https://poetry.dctabudhabi.ae/diwan/poem/100466","الوافر"],[2170,"","https://poetry.dctabudhabi.ae/diwan/poem/198622","الطويل"],[2190,"","https://poetry.dctabudhabi.ae/diwan/poem/53171","الطويل"],[2527,"","https://poetry.dctabudhabi.ae/diwan/poem/17710","الطويل"],[2874,"","https://poetry.dctabudhabi.ae/diwan/poem/136994",""],[3253,"","https://poetry.dctabudhabi.ae/diwan/poem/87382","الطويل"],[3274,"","https://poetry.dctabudhabi.ae/diwan/poem/145049","الطويل"],[3294,"","https://poetry.dctabudhabi.ae/diwan/poem/112691","الرجز"],[3400,"","https://poetry.dctabudhabi.ae/diwan/poem/130611","الطويل"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45784","الطويل"],[3749,"","https://poetry.dctabudhabi.ae/diwan/poem/33125","البسيط"],[3929,"","https://poetry.dctabudhabi.ae/diwan/poem/198514","الكامل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111501","الرجز"],[3967,"","https://poetry.dctabudhabi.ae/diwan/poem/75691","الكامل"],[4035,"","https://poetry.dctabudhabi.ae/diwan/poem/86361","البسيط"],[4273,"","https://poetry.dctabudhabi.ae/diwan/poem/45446","الوافر"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83638","الطويل"],[4354,"","https://poetry.dctabudhabi.ae/diwan/poem/83671","الطويل"],[4466,"","https://poetry.dctabudhabi.ae/diwan/poem/66107","الطويل"],[4679,"غدا هذا الحمى يزهو فخاراً","https://www.poetsgate.com/ViewPoem.aspx?id=142783",""],[4852,"الخلُّ حقا","https://www.poetsgate.com/ViewPoem.aspx?id=214619",""],[1901,"ليَ الله ما ننفكّ ترفضُ أدمعي","https://www.poetsgate.com/ViewPoem.aspx?id=160399",""],[2177,"بشرى فقد أقبل من لم يزل","https://www.poetsgate.com/ViewPoem.aspx?id=127090",""],[5183,"من وحي الجزائر","https://www.poetsgate.com/ViewPoem.aspx?id=180196",""],[5582,"دَعاهُ يَعُجْ فِي حُبِّهِ لِمَعاجِهِ","https://www.poetsgate.com/ViewPoem.aspx?id=63476",""],[6075,"الأميرة والفتى العاشق","https://www.poetsgate.com/ViewPoem.aspx?id=213306",""]],"verses":[["رَأَى مُسْتَقَرَّ السَّمْعِ مِنْ أَمِّ رَأْسِهِ","يَصَمُّ وَأُدْعَى لِلْعُّلا فَأُجِيبُ",0,"ب",1,0],["رَأَى مِنْكَ بحر الماء بَحْراً مِنَ النَّدَى","فَوَاصَلَ مِنْهُ الْمَوْجُ لَثْمَ نِعَالِهِ",1,"ل",2,0],["رائماتٍ ما رَئمنَ سوى","أدوات اللهو من وَلَدِ",2,"د",1,0],["رأى مَظالم شيبٍ في مَسائحه","لم يجنِها السن لكنْ رؤية العِبر",3,"ر",1,0],["رَأى ما أَرَتهُ يَومَ دارَةِ رَفرَفٍ","لِتَصرَعَهُ يَوماً هُنَيدَةُ مَصرَعا",4,"ع",2,0],["رَأى مِنَ الذِئبِ ما قَد","رَأى أَبوهُ الكَريمُ",5,"م",1,0],["رَأى مَيلَ الزَمانِ بِها فَكانَت","عَلى الأَيّامِ صُحبَتُهُ عِتابا",6,"ب",2,0],["رَأى مَلِكُ الرومِ اِرتِياحَكَ لِلنَدى","فَقامَ مَقامَ المُجتَدي المُتَمَلِّقِ",7,"ق",1,0],["رأى من أَخِيكَ الشامُ أكرمَ شيمةٍ","وأصدقَ برقٍ في المُحولِ يُشامُ",8,"م",1,0],["رَأى مَا رَأى وبريق الشعاعِ","يكحلُ أجفانَهُ بالشروق",9,"ق",1,0],["رَأى مَجدَ أَقوامٍ أُضيعَ فَحَثَّهُم","عَلى مَجدِهِم لَمّا رَأى أَنَّهُ الجَهدُ",10,"د",1,0],["رَأى مِنَ الشَرِّ الَّذي لَم يَرَوا","وَكانَ يَهتَمُّ وَهُم يَفرَحون",11,"ن",1,0],["رَأَى ما يَرُوقُ الطَّرْفَ بلْ ما يَرُوعُهُ","فَخَارَ وَذُو القَلْبِ الضعيفِ يَخُورُ",12,"ر",1,0],["رَأى ما بي فَقالَ مَنِ ال","لَذي بِاللَومِ حَرَّقَكا",13,"ك",2,0],["رَأى مُنعِظاً يَوماً وَقَد طالَ عَهدُهُ","مِنِ اِستِهِ الماءُ كَالزَبَد",14,"د",1,0],["رَأى مَناحَةَ أَهلِ الدارِ شامِتُهُم","فَما تَخَيَّلَ إِلّا أَنَّها عُرُسُ",15,"س",1,0],["رَأَى مُقْلَتِي تَرْعَى رِيَاضَ جَمَالِهِ","فَعَاقَبَهَا حَدَّيْنِ بِالسُّهْدِ وَالدَّمْعِ",16,"ع",1,0],["رَأَى مَا رَأَى لَمْ يلْقَ عَزْماً كعزْمِهِ","تَقُدُّ مَواضِيه وتَفْرِي مَنَاصِلُهْ",17,"ل",2,0],["رَأَى مَلِكاً يَحْيَا القَريضُ بِوَصْفِهِ","فضائلُهُ جَلَّتْ وعَمَّتْ فَوَاضِلُهْ",17,"ل",2,0],["رَأى مَلِكاً يُزْهَى بِهِ الدِّينُ والتُّقَى","شمائلُ أملاكِ السماءِ شمائلُهْ",17,"ل",2,0],["رَأى مَلِكاً كالنِّيلِ أما عَطَاؤُهُ","فغَمْرٌ وأما المكرماتُ فساحِلُهْ",17,"ل",2,0],["رأى منهم الناسُ ما لم يَرَوْ","هُ من عدلِ كسرى، ولا قيصرا",18,"ر",2,0],["ٌ رأى مُسْتَعيراً غِبَّها وسَعِيرُ","فَدَى نفسَهُ بالمالِ والآلِ وانْثَنَى",19,"ن",2,0],["رأى ما جناه حنسه ودلاله","فقال أيا ويحي لقد صرت جانيا",20,"ي",2,0],["رَأى مُعجِزاتٍ مِنكَ يا عُدَّةَ الهُدى","تَطَلَّبَها في العالَمينَ فَما أَلفا",21,"ف",2,0],["رأى منهم قولاً يوافق رأيه","وأعجبه منه لي الذم والثلبُ",22,"ب",1,0],["رأى منك هذا العيد أضعاف ما رأى","وعوده من فضل آبائك النجبِ",23,"ب",1,0],["رأى منك أصحاب الحديث موثقا","فقيها كريما من أناس أكارم",24,"م",1,0],["رَأى مدحَ خيرِ الخلقِ صَعباً فَأَحجما","وَقادتهُ أنوارُ المَعاني فأَقدما",25,"م",2,1],["رأى من صروفِ الدهرِ في الناسِ ما أرى","وعلمه الدهر الأسى فتعلما",26,"م",2,0],["رَأَى مِنْها قَضِيباً مِنْ لُجَيْنٍ","يَجُرُّ الوَشْي لا مِنْ خَيْزُرَانِ",27,"ن",1,0],["رأى ما رأَى بي من تباريحِ حبِّها","فقام بما أَعيا الطبيب النطاسيا",28,"ي",2,0],["رَأى مُجتَنو الكُرّاثِ مِن رَملِ عالِجٍ","رِعالاً مَطَت مِن أَهلِ سَرحٍ وَتَنضُبِ",29,"ب",1,0],["رأى مَلْكاً يُبادِرُ كُلُّ مَلْكٍ","لطَوْقٍ من عُبودتِه اعتناقا",30,"ق",2,0],["رأَى مَلِكُ الدنْيا اختصاصَكَ بالّتي","تُذيبُ لها أكبادَ قومٍ حُقودها",31,"د",3,0],["رأى مكانِي علَى بُعدِي وقد عَشِيَتْ","عنّي عيونُ أخِلاَّئِي وأيَّامِي",32,"م",2,0],["رأَى منه المليكُ حِلَى أَمينٍ","بَرِئَ النُّصْحِ من سُقْمِ الضَّميرِ",33,"ر",1,0],["رأى منكَ الخليفةُ ما رآه","فأبْشِرْ إذ أنالَكَ ما أنالا",34,"ل",2,0],["رأى مهجتي مرعىً وعينيّ مشرباً","فلم يُغنه ماءُ النّخيل وباقِلُهْ",35,"ل",2,0],["رأى منازلَ مِطْعامِ العَشيِّ إذا","أضحى من الجدب لينُ الوعث كالجلَدِ",36,"د",1,0],["رأى مني العزيمة في رسوخ","وشاهد عزة الشرف التهامي",37,"م",2,0],["رأى ماء فأطعمه","وخاف عواقب الطمع",38,"ع",1,0],["رَأى منهُ خديماً لا يُضاهَى","يُبَرهِنُ عن محبَّتهِ البُرورُ",39,"ر",1,0],["رأَى ما دِحُوه المدح أَوْلَى فأَقْبلوا","عليه وخَلَّوا ذكر سُعدى وَكُلْثُما",40,"م",2,0],["رأى منه صبراً في حدوثه سنة","وقد كان منه دائماً يتعجب",41,"ب",1,0],["رأى ما رأى في رأيه الصلح واقتضى","له النظر العالي الذي هو أحزم",42,"م",1,0],["رأى من حمار سوءة الفيل فانكفا","إليها وواراها بسوءة خلفه",43,"ه",1,0],["رَأى مِن الطاووس ريشاً نثره","فَلمَّ مِنهُ تسعةً وَعَشرَه",44,"ه",1,0],["رأي من والاك يا مو","لى الندى رأي صحيح",45,"ح",1,0],["رأى من رفيقيهِ خُفوفاً وفاته","بقُرفته المستعجلات الخوانف",46,"ف",1,0],["رَأى منك بحراً مُزبداً فاِكتفى به","بتيّارهِ عن قعرهِ وعناجهِ",47,"ج",2,0],["رَأى مِنْكَ ما مِنْهُ أَبْصَرْتَهُ","هِلالاً أَضاءَ ووَجْهاً تَلالا",48,"ل",2,0],["رَأى مِنَ الطِبِّ ما بُقراطُ لَم يَرَهُ","في بُرءِ كُلِّ سَخيفِ العَقلِ مَخذولِ",49,"ل",1,0],["رأى مصر في عصر الحضارة والنُّهى","تُحاكي فَتاةً في يديها السَّلاسِل",50,"ل",1,0],["رأى ما رأى بيننَا من ثأى","إذا ريمَ بالرقعِ لَم يُرقَعِ",51,"ع",1,0],["رأى من بساط الرّيح خير وسيلةٍ","يحاذي بها مرمى النّجوم الرّواصد",52,"د",1,0],["رأى ملامي عليه أثما","وكف عن كثرة العتاب",53,"ب",1,0],["رأى منها علي شمس حسن","كما أرخ رأت بدراً تماما",54,"م",2,0],["رأى من رمى سهما يكسر طرفه","فأصبح يحكيه ليرسل أسهما",55,"م",2,0],["رأى منك عزّ الدين ابنك همة","طريق المعالي عندها غير مهمل",56,"ل",1,0],["رَأى مَجدَ أَقوامٍ صَرىً في حِياضِهِم","وَهَدَّمَ حَوضَ الزَبرَقانِ غَوائِلُه",57,"ل",2,0],["رأى ما عرى أهل الحمى في هجوعهم","وما نابهم من بؤسهم في ربوعهم",58,"م",1,0],["رأَى ما بها من رائق الأُنس فاِنثَنى","الينا وَحيّانا تحيَّة ذي ودِّ",59,"د",1,0],["رأى ما دعوا من رعيه محض خدعة","فأوجس منهم خيفة أي إيجاس",60,"س",1,0],["رأى من العدو والموالي","أمض من إصابة النبال",61,"ل",1,0],["رأى من كنين الفضل طلعة بارز","ومن مستكن المنّ برزة كاتم",62,"م",1,0],["رَأى ملكاً في الحكم كَالرُمح عادِلاً","وَفي الحَرب كَالسَيف الصَقيل يَجور",63,"ر",1,0],["رَأى مَليكاً مُلوكُ الأَرضِ تَتبَعُهُ","وَالنَجمُ يَخدِمُهُ وَالشَمسُ وَالقَمَرُ",64,"ر",1,0],["رأى منه أبو يعقوب فيها","عقابا لا يهاض له جناح",65,"ح",1,0],["رأى منه أبو يعقوب فيها","عقاباً لا يهاض لها جناح",65,"ح",1,0],["رأى منيلاً وأياس حالا","أن العدى زفس إليهم مالا",66,"ل",2,0],["رأى مضى وَالمشرفية قَد نبت","وَحجى أَقام وَما أَقام يلملم",67,"م",1,0],["رأى مسميه فصل الحسن فيه فقل","في حسن خلق نما في حسن أخلاق",68