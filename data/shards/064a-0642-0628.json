","https://www.poetsgate.com/ViewPoem.aspx?id=36762",""],[5644,"ضيا الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=198647",""],[5776,"ضريح الخلود","https://www.poetsgate.com/ViewPoem.aspx?id=199857",""],[6023,"يُقبل الأرض تقبيلاً يَقِلُّ له","https://www.poetsgate.com/ViewPoem.aspx?id=123912",""],[6023,"يُقبِّلُ الأرض وإن شطَّ به","https://www.poetsgate.com/ViewPoem.aspx?id=123884",""],[6023,"يُقبّل الأرض التي تُربها","https://www.poetsgate.com/ViewPoem.aspx?id=123859",""],[6093,"ضلعُ آدم ( الكامل )","https://www.poetsgate.com/ViewPoem.aspx?id=176003",""],[6102,"سِباقُ الواوِيات ..","https://www.poetsgate.com/ViewPoem.aspx?id=184411",""],[6211,"أَعنِيهِ، لَيْسَ عَنْهُ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=78533&r=&rc=15",""],[6288,"الحاضر ... ليس النهاية","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76849&r=&rc=12",""]],"verses":[["يُقبِلنَ كَالجَيشِ المُغيرِ يَؤُمُّهُ","كَمِشُ الإِزارِ مُقَلِّصٌ عَن ساقِ",0,"ق",1,0],["يُقبِلُ الطَعنَ لِلنُحورِ بِشَزرٍ","حينَ يَسمو حَتّى يُلينَ الجِراحا",1,"ح",2,0],["يقبّل جانبيه البحر حتى","كأن البحر مشغوف كئيب",2,"ب",1,0],["يُقَبِّحُ جِبريلٌ وُجوهَ مُجاشِعٍ","وَتَنعى الحَوارِيَّ النُجومُ الطَوالِعُ",3,"ع",1,0],["يقبل الروض لديها الثرى","ويلثم الأزهار أكمامها",4,"ه",2,0],["يقبِضُ بالخَمْسِ على","أيْرِ غُلامٍ بيده",5,"د",2,0],["يَقْبحُ الصِّدْقُ بالغَواني لأمْرٍ","هُنَّ فيه إذا صدقْن زواني",6,"ي",1,0],["يقبلُ الحمد ولا يوجبُه","وإن امتنَّ فأسنَى مننه",7,"ن",2,0],["يُقَبِّلُ الأَرضَ وَيُنهي إِلى","مالِكِهِ شِدَّةَ أَشواقِهِ",8,"ق",2,1],["يُقبِلُ الناسُ عَلى الشَيءِ الحَسَن","كُلُّ شَيءٍ بِجَزاءٍ وَثَمَن",9,"ن",1,0],["يُقبِلُهُم وَجهَ كُلِّ سابِحَةٍ","أَربَعُها قَبلَ طَرفِها تَصِلُ",10,"ل",1,0],["يقبِّلُ أفلاذَ الحَيا ويُكِنُّها","بطاميةِ الأرجاء خُضر النَّصائبِ",11,"ب",1,0],["يُقَبِّلونَ تُراباً فَوقَ أَعظُمِهِ","كَما يُقَبَّلُ في المَحجوجَةِ الحَجَرُ",12,"ر",1,0],["يُقَبِّلُ أَرضاً شَرَّفَتها رِكابُكُم","وَيُلصِقُ أَحناءَ التَرائِبِ بِالتُربِ",13,"ب",1,1],["يُقَبَّلُ الأَرضَ عَبدٌ تَحتَ ظِلِّكُمُ","عَليكُمُ بَعدَ فَضلِ اللَهِ يَعتَمِدُ",14,"د",1,1],["يقبسان النور من روحيهما","كلما قد ضنت الدنيا بنور",15,"ر",1,0],["يقبِّلُ الأرضَ مشتاقٌ يحاولُ أنْ","يزورَكم وصروفُ الدهرِ تمنعُهُ",16,"ع",2,1],["يقبِّلُ الأرضَ مشوقاً قائلاً","ومستكنُّ الحبِّ منْهُ ظاهرُ",17,"ر",1,1],["يقبِّلُ الأرضَ ويُنهي إلى","علومكُم بعدَ الثناءِ المبينْ",18,"ن",1,1],["يُقَبِّلُني بدلٍّ مِنْ قَبُولٍ","وَيُسْعِدُنِي بِوَصْلٍ مِنْ سُعادِ",19,"د",1,0],["يُقبِّلنَ من قدميكَ الخطى","كما قبَّل الوثنيُّ الحجَرْ",20,"ر",1,0],["يُقبِّلنَ من قدميكَ الخُطَا","كما قَبَّل الوثنيُّ الحَجَرْ",21,"ر",1,0],["يقبل أفواه الملوك بساطه","ويكبر عنها كمه وبراجمه",22,"م",2,0],["يَقْبلُ البخس في الثناء عليٌّ","ويكيل الجزاءَ كيلَ مُوفِّي",23,"ف",2,0],["يقبّلن من قدميك الخطى","كما فبّل الوثنيّ الحجر",24,"ر",1,0],["يقبلُ النفسَ على","مرأى قُدودٍ وخُصور",25,"ر",1,0],["يقبِّل الأرض مشتاقٌ أضرَّ بهِ","طول التنائي وأقذى عينَه السهرُ",26,"ر",1,1],["يقبل لكن بعد إدباره","واليسر بعد العسر طبعاً يطيب",27,"ب",1,0],["يُقَبِّلونَ ثَرىً دامَت تُظَلِّلُهُ","سُحبُ النَدى فَهوَ في أَفيائِها خَضِلُ",28,"ل",1,0],["يقبلّون الثرى خوفاً وأسعدهم","من أسقطت تاجه قدامك القُبَلُ",29,"ل",1,0],["يقبِّل منها النديمُ الصباح","ويصبِغُ كُمَّيه من نورها",30,"ر",3,0],["يقبّل مَكنوناً مِن الدُرِّ رائِقا","وَيرشُفُ مَعسولاً مِن الريقِ سَلسلا",31,"ل",2,0],["يقبلُّ الكأس خجلى كُلَّما شَربت","في ماءِ فيهِ فَقاسته بِما فيها",32,"ي",3,0],["يقبِّحون الحسَنا","ودأبُهم قولُ الخَنا",33,"ن",2,0],["يَقبَلُهُ اللَهُ وَمَن فَضلُهُ","يَحسَبُهُ في الفِرقَةِ الناجِيَةِ",34,"ي",2,0],["يُقَبِّلُ كَفَّكَ كانتِجاعِ سَحَابِ","فَأَغِثْ بِغَيْثِكَ مَنْزِلي وَرِحَابي",35,"ي",1,1],["يقبّل مِنكَ المشرفيَّ غضنفر","وَيصهر قَدَّ السَمهريّ صهورُ",36,"ر",1,0],["يُقَبِّلُ الأَرضَ ثَغرُ السُحْبِ عِندَهُمُ","وَالقَطرُ ريقَتُهُ وَالأَنجُمُ الشَنَبُ",37,"ب",1,0],["يُقَبِّلُ البَدرُ تُرباً أَنتَ واطِئُهُ","فَلِلتُرابِ عَلَيهِ ذَلِكَ الأَثَرُ",38,"ر",1,0],["يقبلُ اللوم مسمَعي مثلَما يَن","بُتُ من هاطِلِ السَّحائِب صَخرُ",39,"ر",1,0],["يقبّل الأرضَ إعظاماً وإجْلاَلا","صبٌّ تَحمَّلَ مِن هجرانِكمْ مَالا",40,"ل",2,1],["يقبّل والأَجفان تهمي بصيّب","ثرًى منه في الدُّنيا الثراء لمترب",41,"ب",1,0],["يقبل الفرع أذيالاً معانقةً","نطاق خصر على المريخ ذا طربِ",42,"ب",1,0],["يقبلها بين الورى كل قانت","ومن صحن خديها يسف خضابها",43,"ب",3,0],["يُقَبِّلُ النَّاسَ إنسانا ً فَإنسانا","وَيَحضُنُ الدُّورَ أبوابا ًوَجُدرانا",44,"ن",2,0],["يقبّلُ الطفلَ والأيادِي","يحدّثُ الناسَ بانفتاحِ",45,"ح",1,0],["يقبل الأرض وينهي إلى","مالك رق الحق والباطل",46,"ل",1,0],["يُقَبِّلُون جَبهَتي","مِن حُرقَةِ الفُقدَان",47,"ن",1,0],["يقبل صفحتي سيفٍ صقيلٍ","ويثنيه عن الخمر القراع",48,"ع",1,0],["يُقْبِلُ اللَّيْلُ حِيْنَ تُقْبِلُ لَوْلاَ","وَضَحٌ فِي سَوَادِ سَالِفَتَيْهَا",49,"ي",3,0],["يُقَبِّل مفرَقي مِن غَيرِ قَومي","ومِن نِسوانِهِم شُمُّ ولُعسُ",50,"س",1,0],["يَقْبَلُ فِيهِ ضَمَانَ مَوْعِدِهِ","فَلَيْسَ يُخْشَى مِنْهُ تَزَيُّدُهُ",51,"د",2,0],["يقبل كفا عودت بثلاثة","بجود وتقبيل وحتف للاتم",52,"م",1,1],["يقبّل العبد أيدٍ حاكت السحبا","ويستمد الدعا من جوده طلبا",53,"ب",2,1],["يقبل الأرض إجلالاً لمالكه","رقا وينهي إليه بعد كل هنا",54,"ن",2,0],["يُقَبِّلُ أقدام الغصونِ فتنثني اخ","تيالاً ولم تبرح عليه تطولُ",55,"ل",1,0],["يَقبحون الحسنا","يَهيجون الإحنا",56,"ن",2,0],["يَقبح عِندَ السائس","مَجد بِلا مُنافس",57,"س",1,0],["يقبّلها حقّ تبلَّج كالضُّحى","ويلثمها فضل يضيق به السردُ",58,"د",1,0],["يقبضُ المال لا لغيرِ العَطايا","فالندى في يديه قبضٌ وبَسط",59,"ط",1,0],["يقبّلُ الغلَّ مرتاحاً أسيركمُ","فهو البشيرُ له أن تُسحَبَ الحلل",60,"ل",1,0],["يقبله اللثام هوى وشوقاً","ويجني ورد خديه النقاب",61,"ب",1,0],["يقبل العام من أعتاب مولانا","سماء مجدٍ سمت بالمجد كيوانا",62,"ن",2,1],["يقبل العبد من أعتاب مولانا","سماء مجدٍ حوت حسناً وإحسانا",63,"ن",2,1],["يقبل وردَ الصبى باسماً","نسيمُ الصبا فوقَ خدٍّ ندى",64,"د",2,0],["يقبّل الأرض بالإحسان معترفا","كتاب عبد أتى مُستلزم الأدب",65,"ب",1,1],["يقبل الأرض من ذابت جوانحهُ","شوقاً إليكم ولم يعلم به أحدُ",66,"د",1,1],["يقبِّلُ ثغرَ الشمس وهو أشعةٌ","ويغسل فيه الوجه بدرٌ وأنجم",67,"م",1,0],["يقبلون الخسيس منك ويثنو","ن ثناء مد خمسا دخماسا",68,"س",2,0],["يقبل منك البحر اخمص ارجلٍ","لها موطئٌ منه الترائب والخد",69,"د",1,0],["يقبل الأرض اجلالا وتكرمة","عبد به منك داعى الجود قد هتفا",70,"ف",2,0],["يَقبح ما حذفت مِنهُ المضمرا","أَو كانَ فيهِ مضمر تكررا",71,"ر",2,0],["يُقَبِّلنَ مِنها الردنَ عِظماً لِشأنِها","فَتُلقي لَهُنَّ الدُرَّ مِن مَنطِقٍ حُلوِ",72,"و",1,0],["يقبس النور من بهاء الدرارى","ويصوغ القريض صوغ اللآلى",73,"ل",2,0],["يقبس الخاطر السنيّ فلا يل","بث حتى يصوغ فيه المعاني",74,"ن",2,0],["يقبس القابسون منك سني العل","م فتعطينهم بلا مقياس",75,"س",1,0],["يقبل ثغر الأقحوان شقيقه","ويلتف فيها الغصن الغصن اللدن",76,"ن",1,0],["يقبل المسواك منه مبسماً","يحمي بعسّال القوام مورده",77,"د",2,0],["يُقبِّلُ أولادهُنَّ الصِّغارَ","ومَن عَشِقَ الدَّنَّ بَاسَ الْقَدَحْ",78,"ح",1,0],["يقبل شعرها القدمين منها","إذا قامتْ تميلُ من النعيمِ",79,"م",1,0],["يقبّل الغصن يا مياس أقدامك","والبدر في الحسن مثل العبد قدّامك",80,"ك",1,1],["يَقبسونَ من","ذَلِكَ الضرم",81,"م",1,0],["يَقبِضُهُ تارً ويَبْسُطُهُ","ساعٍ تَحَدَّى بسعيهِ الأُمَمَا",82,"م",2,0],["يُقبلُ اللهوُ والسرورُ اذا أقْ","بلَ نَحوي وانْ تَولَّى تَولَّى",83,"ل",2,0],["يُقبِّل للخديعة خدَّ حربا","وَيَرشفُ للضرورة ثَغرَ غُول",84,"ل",1,0],["يُقبِّلُ الوَهمُ من خدّيهِ زاهرةً","وَيَهصرُ القدَّ منهُ الظَنُّ وَالفِكَرُ",85,"ر",1,0],["يقبلها النسيم كأنّ عنه","حياء العاشقين فليس يبدو",86,"د",2,0],["يُقبِّلُها المُضنى وإنِّي لجاعِلٌ","حَنُوطيَ مِنها عندَ مَوتي لكي أحيا",87,"ي",2,0],["يُقبِّلُ المُزنُ في شوقٍ ذوائِبَها","ويُرسلُ الغيثَ سَحّاً غيرَ ممنونِ",88,"ن",1,0],["يَقبَلُ ما جُدتِ بِهِ طائِعاً","وَهُوَ وَإِن قَلَّ لَدَيهِ كَثيرُ",89,"ر",1,0],["يَقبَح فِعلي عِندَها بَعضُ أَهلِها","فَتَأبى وَلَم تَسمَع مَقالَة عائِب",90,"ب",1,0],["يُقَبِّلُ بالإِجلالِ أَعتابَ بابِكُم","وَيَسلُكُ في التَبجيلِ أَعظَمَ مِنهاجِ",91,"ج",1,0],["يقبل أرضاً أشرقت شمس علمها","وليس سواها مقصد ومرام",92,"م",1,1],["يقبل نحره المختار شوقا","وتدميه الاسنة والحراب",93,"ب",1,0],["يُقبِل الناسُ عليها عشراتْ","وهي تُضْطَرُّ إلى رفضِ الجميعْ",94,"ع",1,0],["يقبّلُ عينيك ِ شعري الحزين","ويأتيك عذبا كما تشتهينْ",95,"ن",1,1],["يقبل بوجهٍ كالصبح في صفاوته","وعليه كالليل البهيم لثام",96,"م",1,0],["يقبض فوادي لا تخيلت فرقاك","شف عين (ن) ما سواك يعنيها",97,"ي",3,0],["يُقَبِّلُهُنَّ ثَغرُ الفَجْرِ عَنّا","وتَلْثُمُهُنَّ أَنداءُ البُكورِ",98,"ر",1,0],["يُقَبِّلُنِيْ بِشَاطِئِهِ نَهَارِيْ","وَيَبْعَثُ بِيْ شُرُوقَ الجَلَّنَارِ",99,"ر",1,1],["يقبل خدها والشوق يبدى","نضارتها على الخدين وردا",100,"د",2,0],["يقبل الحسن من وجه الرسول له","حدان مستتر ذاتاً ومنتشر",101,"ر",1,0],["يُقبّحُ حُسْنٌ، ويُنسى قبيحٌ","ويُحسبُ \"خُنْثُ الكلامِ\" دُرَر",102,"ر",1,0],["يُقَبِّلُني فوقَ الجَبينِ ... أُعانِقُهْ","وتُنْبيْ سَريعاً بالفِراقِ دَقائقُهْ",103,"ق",2,0],["يقبل وجهك الحاني","ويسكب فوق رمشيك",104,"ك",1,0],["يقبل الليل لامرفأ ولامينا","عاد لو غاب صوتك ويش يبقالي",105,"ل",2,0],["يُقَبِّلُ وجهَ ورودِ الأقَاحِي","ويحنُو على الزهرِ كَي يبهَجَا",106,"ج",2,0],["يقبضُ الحزنُ مقلتيه وبالحُزْ","ن غدا يبسطُ الشّفاهَ الدّعاءُ",107,"ا",2,0],["يُقبل الأرض تقبيلاً يَقِلُّ له","من أن تكون الثُّريَّا عند ذاك فما",108,"م",2,1],["يُقبِّلُ الأرض وإن شطَّ به","مزاره أو بعدت دياره",109,"ه",1,1],["يُقبّل الأرض التي تُربها","تُعنى به العين عن غن الإتمد",110,"د",1,1],["يقبلنَ في ثمرِ الشَّبابِ وزَهْره","وبنا إلى روضِ الحسان جِماحُ",111,"ح",1,0],["يَقبِسُ الوَمضَةَ المُضِيئَةَ مِنِّي","زاعِمًا أَنَّ نُورَها مِنهُ ضاوِ",112,"ا",2,0],["يُقبّلُ أحْجاراً ويعبُدُ بعضَا","لها الأمرُ مِنْ بعدٍ يَراها ومِن قَبْلُ",113,"ل",1,0],["يقبل البلبل أنداءها","فيرتوي من قطرةٍ طاهره ْ",114,"ر",2,0]]}