{"poems":[[88,"أيها الوسمي زر نبت الربا","https://www.aldiwan.net/poem10855.html","الرمل"],[53,"أيها الواعد الذي برقه الدهر خلب","https://www.aldiwan.net/poem8664.html","مجزوء الخفيف"],[53,"أيها الواعد المماطل بالبر","https://www.aldiwan.net/poem61841.html","الخفيف"],[53,"لاح شيب فنهنه الحلم جهلا","https://www.aldiwan.net/poem65914.html","الخفيف"],[45,"كفرندي فرند سيفي الجراز","https://www.aldiwan.net/poem9609.html","الخفيف"],[51,"المنايا تجوس كل البلاد","https://www.aldiwan.net/poem62044.html","الخفيف"],[99,"هذه الكعبة كنا طائفيها","https://www.aldiwan.net/poem24799.html","الرمل"],[99,"يا جمالا وجلالا يتدفق","https://www.aldiwan.net/poem24990.html","الرمل"],[82,"أشهاب في دجى الليل ثقب","https://www.aldiwan.net/poem31545.html","الرمل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54891","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54201","الخفيف"],[103,"","https://poetry.dctabudhabi.ae/diwan/poem/54194","الخفيف"],[82,"أشهابٌ في دجى الليل ثَقَبْ","https://www.poetsgate.com/ViewPoem.aspx?id=3017",""],[119,"أنا من تسمع عنه وترى","https://www.aldiwan.net/poem42905.html","الرمل"],[177,"أيها الواقف اعتباراً بقبري","https://www.aldiwan.net/poem4407.html","الخفيف"],[213,"غار مثل النجم من خلف البحور","https://www.aldiwan.net/poem26480.html","عموديه"],[362,"ما عسى تبلغ شكراً ما عسى","https://www.aldiwan.net/poem4166.html","الرمل"],[396,"أيها الوفد إلى البيت الحرام","https://www.aldiwan.net/poem54495.html","عموديه"],[435,"أيها الوالد إني بعدكم","https://www.aldiwan.net/poem41015.html","الرمل"],[505,"تحت سبر المرفرف الأزلي","https://www.aldiwan.net/poem37723.html","الخفيف"],[563,"من مجيري من فاتر الطرف فاتك","https://www.aldiwan.net/poem34260.html","الخفيف"],[634,"","https://poetry.dctabudhabi.ae/diwan/poem/126767","الخفيف"],[820,"","https://poetry.dctabudhabi.ae/diwan/poem/66989","الرمل"],[357,"","https://poetry.dctabudhabi.ae/diwan/poem/142198","الرمل"],[946,"","https://poetry.dctabudhabi.ae/diwan/poem/145808","الخفيف"],[1058,"","https://poetry.dctabudhabi.ae/diwan/poem/198786","الخفيف"],[1538,"","https://poetry.dctabudhabi.ae/diwan/poem/79845","الخفيف"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48977","الخفيف"],[1793,"","https://poetry.dctabudhabi.ae/diwan/poem/26406","الرمل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125485","الرمل"],[230,"","https://poetry.dctabudhabi.ae/diwan/poem/125492","الرمل"],[1981,"","https://poetry.dctabudhabi.ae/diwan/poem/202068","الخفيف"],[2041,"","https://poetry.dctabudhabi.ae/diwan/poem/71047","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203053","الخفيف"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74279","الخفيف"],[3057,"","https://poetry.dctabudhabi.ae/diwan/poem/112501","الرمل"],[3084,"","https://poetry.dctabudhabi.ae/diwan/poem/101613","الخفيف"],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110799","الخفيف"],[3510,"","https://poetry.dctabudhabi.ae/diwan/poem/123928","الخفيف"],[3647,"","https://poetry.dctabudhabi.ae/diwan/poem/109953","الخفيف"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/205934","الخفيف"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/102939","الخفيف"],[3887,"","https://poetry.dctabudhabi.ae/diwan/poem/103005","الخفيف"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29282","الخفيف"],[4759,"كرموه","https://www.poetsgate.com/ViewPoem.aspx?id=204258",""],[4767,"العيون السهارى","https://www.poetsgate.com/ViewPoem.aspx?id=213985",""],[5183,"طوى","https://www.poetsgate.com/ViewPoem.aspx?id=180160",""],[5377,"الأمن الزائف","https://www.poetsgate.com/ViewPoem.aspx?id=61898",""],[5596,"الاخضر الشامخ","https://www.poetsgate.com/ViewPoem.aspx?id=208736",""],[243,"أعاصير","https://www.poetsgate.com/ViewPoem.aspx?id=50473",""],[5689,"حي بدرا بافق مسرتا، تلالا","https://www.poetsgate.com/ViewPoem.aspx?id=143437",""],[6124,"علمتني كيف أجفو","https://www.poetsgate.com/ViewPoem.aspx?id=125190",""]],"verses":[["أَيُّها الوَسمِيُّ زُر نَبتَ الرُبا","وَاِسبِقِ الفَجرَ إِلى رَوضِ الزَهَر",0,"ر",1,1],["أيها الواعدُ الذي","برقُهُ الدهرَ خُلَّبُ",1,"ب",1,1],["أيها الواعد المماطل بالبِرْ","ذَوْنِ ماذا أحال وُدَّكَ بعدي",2,"د",2,1],["أيها الوافدُ المُيمّمُ عيسى","اغترفْ لي من ذلك البحرِ سَجْلا",3,"ل",2,0],["أَيُّها الواسِعُ الفَناءِ وَما في","هِ مَبيتٌ لِمالِكَ المُجتازِ",4,"ز",1,0],["أَيُّها الواصِلي سَتَرفُضُ وَصلي","عَنكَ لَو قَد أُذِقتَ طَعمَ اِفتِقادي",5,"د",2,0],["أيها الوكر إذَا طار الأليف","لا يَرَى الآخر معنى للسماء",6,"ا",2,0],["أيها الورد الذي طاف بنا","أيها الطل الذي بلَّ الظما",7,"م",2,0],["أيها الواصلُ من إحسانِهِ","سبباً من كلّ منبَتِّ السبب",8,"ب",1,0],["أَيُّهَا الْوَافِدُونَ لِلْجَوْد وَالإِحْ","سَانِ حَيَّاكمُ الْعَلِيُّ الْقَديرُ",9,"ر",1,0],["أيُّها الوَادِعُون يَمْشُون زَهْواً","بَيْنَ جَبْرِيّةٍ وبَيْنَ اخْتِيالِ",10,"ل",1,0],["أيُّها الوَافِدُونَ من أمَمِ الشَّرْ","قِ وأشْبَاله الأُبَاةِ الصِّيدِ",11,"د",1,0],["أيها الوصلُ من إحسانه","سبباً من كل منبٍ السبب",12,"ب",1,0],["أَيُّها الواشونَ ما أَغفَلَكُم","لَو عَلِمتُم ما جَرى لي وَجَرى",13,"ر",2,0],["أَيُّها الواقِفُ اِعتِباراً بِقَبري","إِسمَع فيهِ قَولَ عَظمٍ رَمِيمِ",14,"م",1,1],["أيها الوارد في ليل النوى","موردا لا يرتجي منه صدور",15,"ر",1,0],["أيُّهَا الوَفدُ ادخُلوا حَضرَتَهُ","وَتَرَاءَوا نُورَهَأ المُقتبَسَا",16,"س",2,0],["أيها الوفد إلى البيت الحرام","آمين البيت يانعم المرام",17,"م",1,1],["أيها الوالد إني بعدكم","مدنف القلب لشوق قد غلب",18,"ب",1,1],["أيُّها الوارِثُ الكَريمُ بِحالي","رُحْ أَميناً عن لَوْثِ كُلِّ غَوِيِّ",19,"ي",1,0],["أيها الوجه بالمحبين رفقاً","نحن مثل الشخوص في مرآتك",20,"ك",1,0],["أيّها الوافدُ الكريم إلينا","والكميّ الشهم الهمام الغيورُ",21,"ر",1,0],["أيُّها الواصِلُ هَجْرِي","أنا في هِجْرانِ صَبْرِي",22,"ي",1,1],["أيها الواعد ما زال اللقا","في ضمير الغيب بابا موصدا",23,"د",2,0],["أيها الواهبونَ للأرضِ أقصى","غايةِ الجُودِ..أنتمُ الأوفياءُ",24,"ا",2,0],["أيها الوالد المغادر؛ مهلاً","كل من قد تركتهم أبناء",25,"ا",2,0],["أيها الواخدُ المغلّس في عز","مٍ على الهول ليس بالمغلوبِ",26,"ب",1,0],["أيُّها الوادي اْحتفظْ برفاتٍ","لا تُضِعهُ ضَنانةً بجُمانِهْ",27,"ن",2,0],["أَيُّها الواثِقُ بِاللَ","هِ لَقَد ناصَحتَ رَبَّكْ",28,"ك",1,0],["أيُّها الوادي المُفَدَّى","أنت آمالُ القُلُوب",29,"ب",1,0],["أيُّها الوَطَنُ المُفَدَّى","قد وهبناكَ الحياه",30,"ه",1,0],["أيها الوفد أنت عين علاها","وجمال وأنور الناظران",31,"ن",1,0],["أَيّها الوالد الرَّؤوف الذي أَوْ","جدني بعد أَنْ عُدِمْتُ بأَسْرى",32,"ر",2,0],["أيها الواد إن أصابك غبن","فلقد جاء من عمى الأبصار",33,"ر",1,0],["أيها الواد أنت في الحظ مثلي","ما لفني وما لحسنك شار",33,"ر",1,0],["أَيُّها الواحد المُسَمى حُسيناً","نلتَ فَضلاً بِرَأيك المُستَنير",34,"ر",1,1],["أيها الورد انتحر لا تتئد","قد تجافى دهرنا بالأرج",35,"ج",1,0],["أيها الورد والضحى فض كمك","كيف تبكي بلا سبب",36,"ب",1,1],["أيها الوارثو العلا عن جدود","أسسوه بجدهم تأسيسا",37,"س",2,0],["أيها الوالد المقد","س رحماك بالولد",38,"د",1,0],["أَيُّها الواعظُ المُحاوِلُ مدحاً","لا اتِّلادَ الفضائِل المُستلَذَّة",39,"ه",1,1],["أيها الواثقون بالعمر مهلًا","إنما العمر زهرة في نداها",40,"ا",3,0],["أيها الورق ليس وجدك وجدي","أين من ذي الصبابة المرتاح",41,"ح",1,0],["أيها الواشيان لا تهزءا بي","ربَّ عود يخضر بعد ذبول",42,"ل",1,0],["أَيُّها الوَقتُ كَم أَطَحتَ بِعَيشٍ","خَضلٍ كانَ وارِفَ الأَظلالِ",43,"ل",1,0],["أيها الواهب الحياة عقولا","نيرات وجئت قلبا سليما",44,"م",2,0],["أيها الوردُ لا أطيقُ اصطبارا","شدةُ العشقِ أضرمتْ فيَّ نارا",45,"ر",2,1],["أيها الواصل الذي هاله المو","قف فانصاع دونه إحجاما",46,"م",2,0],["أيها الواضعون كل مصير","لهمو في أحضان شيخ مسوّد",47,"د",1,0],["أيها الورد يا جميل المحيّا","في سفوح من لونه قد حباها",48,"ا",3,0],["أيها الواقفون في زحمة الدنيا","وقد عصب الرؤوس الدوار",49,"ر",1,0],["أيها الوافدين حياكم الل","ه وأحياكم لنا أبطالا",50,"ل",2,0],["أَيُّهَا الوَعْدُ الذِيْ أَخْلَفْتَنِيْ","خِلْفَ عَهْدٍ قَالَ لِيْ هَلْ نَعْشَقُ ؟",51,"ق",1,0]]}