],[43,"الحزن يقلق والتجمل يردع","https://www.aldiwan.net/poem9724.html","الكامل"],[45,"كنت إلى وصل سعدى جد محتاج","https://www.aldiwan.net/poem62673.html","البسيط"],[45,"أبقاك ربك في عز وتأييد","https://www.aldiwan.net/poem63547.html","البسيط"],[45,"يا ابنة العامري عما قليل","https://www.aldiwan.net/poem65557.html","الخفيف"],[45,"لامت علي أنها في الدمع لم تلم","https://www.aldiwan.net/poem66653.html","البسيط"],[45,"ماجو خبت وإن نأت ظعنه","https://www.aldiwan.net/poem66814.html","المنسرح"],[66,"أسلبن من فوق النهود ذوائبا","https://www.aldiwan.net/poem41382.html","الكامل"],[97,"آه من وجدك بالهاجر آه","https://www.aldiwan.net/poem24926.html","الرمل"],[80,"إني لأبسط للقبول إذا سرت","https://www.aldiwan.net/poem31477.html","الكامل"],[44,"بني حميد الله فضلكم","https://www.aldiwan.net/poem30349.html","المنسرح"],[44,"ما لي بعادية الأيام من قبل","https://www.aldiwan.net/poem30374.html","البسيط"],[44,"لطمحت في الإبراق والإرعاد","https://www.aldiwan.net/poem30535.html","الكامل"],[44,"طلل الجميع لقد عفوت حميدا","https://www.aldiwan.net/poem30553.html","الكامل"],[44,"السيف أصدق أنباء من الكتب","https://www.aldiwan.net/poem30591.html","البسيط"],[67,"أهل التقى والعلم أهل السؤدد","https://www.aldiwan.net/poem18059.html","الكامل"],[75,"قولا لمعتقل الرمح الرديني","https://www.aldiwan.net/poem69026.html","الطويل"],[75,"أحين ولت أنجم الأفق","https://www.aldiwan.net/poem69057.html","السريع"],[75,"طلب المجد من طريق السيوف","https://www.aldiwan.net/poem69060.html","الخفيف"],[75,"صدق الفناء وكذب العمر","https://www.aldiwan.net/poem69076.html","أحذ الكامل"],[48,"قد عذب الحب هذا القلب ما صلحا","https://www.aldiwan.net/poem62533.html","البسيط"],[48,"كفاك أني قد بت لم أنم","https://www.aldiwan.net/poem65259.html","المنسرح"],[50,"قد أذهب الداء حسادي بكثرتهم","https://www.aldiwan.net/poem24522.html","البسيط"],[50,"يا عبد ضاق بحبكم جلدي","https://www.aldiwan.net/poem63920.html","الكامل"],[50,"غيب جيرانه بذي حمد","https://www.aldiwan.net/poem63926.html","الطويل"],[50,"يا صاحبي العشية احتسبا","https://www.aldiwan.net/poem64817.html","المنسرح"],[7,"أبقيت للعبسي فضلاً ونعمة","https://www.aldiwan.net/poem2000.html","الطويل"],[46,"إدأب لربك لا يلومك عاقل","https://www.aldiwan.net/poem22349.html","الكامل"],[46,"أودى فليت الحادثات كفاف","https://www.aldiwan.net/poem23630.html","الكامل"],[46,"إبق في نعمة بقاء الدهور","https://www.aldiwan.net/poem23636.html","الخفيف"],[19,"هل عاجل من متاع الحي منظور","https://www.aldiwan.net/poem342.html",""],[68,"ته دلالا فأنت أهل لذاكا","https://www.aldiwan.net/poem1517.html",""],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85451","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85456","الكامل"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42646","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54742","الكامل"],[25,"","https://poetry.dctabudhabi.ae/diwan/poem/67292","الكامل"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54324","الكامل"],[106,"الطبيب الشاعر","https://www.poetsgate.com/ViewPoem.aspx?id=179681",""],[90,"في الأربعين","https://www.poetsgate.com/ViewPoem.aspx?id=179041",""],[90,"أمين الريحاني","https://www.poetsgate.com/ViewPoem.aspx?id=178954",""],[45,"يا ابنَةَ العامرِيّ عَمّا قَليلِ","https://www.poetsgate.com/ViewPoem.aspx?id=32130",""],[46,"إدْأبْ لرَبّكَ، لا يلومُكَ عاقلٌ","https://www.poetsgate.com/ViewPoem.aspx?id=18040",""],[51,"ما الشُكر منّي لمَا أوْليتَني ثمنا","https://www.poetsgate.com/ViewPoem.aspx?id=30684",""],[39,"إنَّ الفؤادَ هفَا للبائنِ الغردِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=7469&r=&rc=9",""]],"verses":[["أَبقَتِ الأَيّامُ مِنّي صَعدَةً","تَزبُنُ العاجِمَ عَنها إِن عَجَم",0,"م",1,0],["أَبقَوا أَسيراً بَعدَهُم لا يُفتَدى","مِمّا يَجِنُّ وَطالِباً لا يَلحَقُ",1,"ق",1,0],["أَبقى الجَوى جَرحَةً بِقَلبي","ماعِشتُ مَكتومَةَ النَجيعِ",2,"ع",1,0],["أَبقى الخَليطُ بِها مَعاهِدَهُ","أَثَرٌ لَعَمرُكَ ما لَهُ قَصُّ",3,"ص",1,0],["أَبقَوا مَخازِيَ لا تُعفي مَواطِنَها","عَلى البِلادِ فُضولُ الرَيطِ وَالأُزُرُ",4,"ر",1,0],["أَبقوا عَليلاً بَعدَهُم لا بُرؤُهُ","يُرجى وَلا الآمالُ فيهِ تَخيبُ",5,"ب",1,0],["أَبقى الهَوى لِأَخيكَ نَفساً حُرَّةً","حَسرى وَجِسماً ناحِلاً نِضوا",6,"و",2,0],["أَبْقَاكَ ظِلاَّ لِلْعِبَادِ وَمَلْجَأً","وَأَعَانَكَ الرَّحْمَانُ مِنْ سُلطْانِ",7,"ن",1,1],["أَبْقَاكُم اللهُ فِي سَعْدٍ عَقَائِلُهُ","تُبْدِي لَكُمْ غُرَرَ الأَبْكَارِ وَالعونِ",8,"ن",1,0],["أَبقَيْتَنِي فَتَرَكتُ ذِكْرَكَ بَاقِيا","يُتْلَى بِمَدْرَسَةٍ وَمَارِسْتَانِ",9,"ن",1,0],["أَبْقَى رُسُومَكَ كَلَّهَا مَحْفُوظَةً","لَمْ يَنْتَثِرْ مِنْهَا عَلَيْكَ نِظَامُ",10,"م",1,0],["أبْقَيْتُ بالذِّكْرِ الجَميلِ مَدائِحاً","لكَ في فَمِ الرّاوي وقَلْبِ الرّاجي",11,"ي",1,0],["أَبقَى التَهَجُّرُ مِنها بَعدَ ما اِبتُذِلَت","مَخيَلَةً وَهِباباً خاَلِطاً كَثَفا",12,"ف",2,0],["أَبقِ شَيئاً إِذا مَضَيتَ ذَميماً","عَن قَريبٍ يَأتي عَلَيهِ بَنوكا",13,"ك",2,0],["أَبقَيتَ في كَبِدي عَلَيكَ حَزازَةً","تَبدو لِأَهلِ الحَشرِ يَومَ معادي",14,"ي",1,0],["أَبقَيتَ لي يا دَهرُ بَعدَ فِراقِهِ","كَبِداً مُقَرَّحَةً وَجَفناً أَرمَدا",15,"د",2,0],["أَبقى لَنا كُلَّ مَجهولٍ وَفَجَّعَنا","بِالحالِمينَ فَهُم هامٌ وَأَرماسُ",16,"س",1,0],["أبقى لآلك خير ذكرى أنهم","ما طالت الأيام لن يسلوك",17,"ك",1,0],["أبقى من الكنز الدفين وقد علا","هبة الكريم ولو تكون دخانا",18,"ن",2,0],["أَبِقَلْبَيْكُمَا مِنَ الشَّوْقِ بَاقٍ","فَاشْفِيَاهُ بِدَمْعِنَا الهَتَّانِ",19,"ن",1,0],["أَبْقَيْتَ فِينَا وَفِي الأَجْيَالِ تُعْقِبُنَا","ذِكْرَى نُقَدِّسُهَا فِي السِّرِّ وَالْعَلَنِ",20,"ن",1,0],["أبْقَى بَنَاءَيْكَ الَّذِي اسْتَوْطَنْتَهُ","فِي اللهِ عَنْ عُرْفٍ وَعَنْ إيمانِ",21,"ن",1,0],["أَبْقَى وَيَرْفَضُّ حَوْلِي عِقْدُ خُلاَّنِي","أَشْكُو إِلَى اللهِ آلامِي وَأَحْزَانِي",22,"ن",2,1],["أَبْقَى لِرَأْيِكَ أَنْ تُصَرِّفَ أَمْرَهُ","وَالرَّأْيُ قَدْ يُغْنِي عَنِ الصَّمْصَامِ",23,"م",1,0],["أَبقَت مُراكَضَةُ الرِهانِ مُجَرَّباً","عِندَ المَواطِنِ يُرزَقُ التَبشيرا",24,"ر",2,0],["أَبقى العَواصِفُ مِن مَعالِمِ رَسمِها","شَذَبَ الخِيامِ وَمَربَطَ الأَمهارِ",25,"ر",1,0],["أَبقَت لِبَكرٍ مَفخَراً وَسَمالَها","مِن دونِ قَومِهِما يَزيدُ وَهاني",26,"ن",2,0],["أَبقى عَلَيهِ مِن جَوىً مُفارِقُه","رَسيسَ حُبٍّ عَلِقَت عَلائِقُه",27,"ق",2,0],["أَبقى لِأَسبابِ المَوَد","دَةِ أَن تَزورَ وَلا تُجاوِر",28,"ر",1,0],["أَبقى لَنا اللَهُ مَولانا وَلا بَرِحَت","أَيّامُنا أَبَداً في ظِلِّهِ جُدَدا",29,"د",2,0],["أَبقَت رَياسَتُهُ لِمَعشَرِهِ","غَضَبَ الإِلَهِ وَذِلَّةَ الأَصلِ",30,"ل",1,0],["إبقَ ما شئتَ كيف شئت ودوموا","في حمى الله يا بني أيوب",31,"ب",1,0],["أبقوا عليَّ وقوَّضوا فحسبتهم","وحسبتُه سيلاً طما وسحائِبا",32,"ب",2,0],["أبقاكُمُ نُهْزة للناس كلِّهِمُ","أذلَّةً لا عدِمتم ذلة النفَر",33,"ر",1,0],["أبقِ من مالك الممزْ","زَقِ حظّاً لآملِكْ",34,"ك",1,1],["أبقاهُمُ مَنْ أعزَّني بهمُ","ما أفلَ النَّيّران أَوْ نجما",35,"م",2,0],["أبقدْري وزنتَ خَمسينَ رطلاً","من حطام يا ظالماً في الحكومه",36,"م",2,0],["أبقِ منه لا تدعه خائفاً","كلما هَزَّ نسيمٌ فَنَنَه",37,"ن",2,0],["أبقاك ذو العرش أعواماً مُضاعفةً","فلن نزال بخير ما بقيت لنا",38,"ن",2,0],["أبقى الإلهُ لنا العَلاءَ مُمتَّعاً","بعلائِهِ القَوْليِّ والفِعليِّ",39,"ل",2,0],["أَبقَيتَ يا زَمَن الحَرو","رِ بِمُهجَتي مِثلَ الحَرورِ",40,"ر",1,0],["أَبِقَ النَومُ فَاِنطَلَقتُ إِلى انَهرِ","بِنَفسٍ كادَت تَسيلُ دِماها",41,"ا",3,0],["أبْقوا سَماءَ المَعالي","بِما أضاءوا مَنارا",42,"ر",2,0],["ابقيت في كل ارض للهجى اثرا","فجل ما انت قد ابقيت من اثر",43,"ر",1,0],["ابقيت يوسف في العراق لاهله","ذكرى تزيد المعجبين ودادا",44,"د",2,0],["أَبُقراطُ مِثلُ اِبنِ سينا الرَئي","سِ وَهوميرُ مِثلُ أَبي الطَيِّبِ",45,"ب",1,0],["أَبقى عَلَيها عَرشَها في بُرهَةٍ","تَرمي العُروشَ وَتَنثُرُ التيجانا",46,"ن",2,0],["أَبقى المَمالِكَ ما المَعارِفُ أُسُّهُ","وَالعَدلُ فيهِ حائِطٌ وَدِعامُ",47,"م",1,0],["أَبقى زُرَيقٌ لِلثُغورِ مُحَمَّداً","أَبقى نَفيسٌ لِلنَفيسِ نَفيساً",48,"س",2,0],["أَبقَيتَ أَكذَبَ كاذِبٍ أَبقَيتَهُ","وَأَخَذتَ أَصدَقَ مَن يَقولُ وَيَسمَعُ",49,"ع",1,0],["أَبقى وَلَولا التَلافي مِن بَقِيَّتِهِ","قاظَت لَهُم نِسوَةٌ مِن غَيرِ أَزواجِ",50,"ج",1,0],["أَبقاكَ رَبُّكَ في عِزٍّ وَتَأييدِ","وَفي سُرورٍ وَإِنعامٍ وَتَمهيدِ",51,"د",1,1],["إِبقَ وَقفاً عَلى العُلا يَا أَبا أَي","يوبَ في ظِلِّها عَلَيكَ الظَليلِ",52,"ل",1,0],["أَبقى مَآثِرَ مِن مَجدٍ وَمِن كَرَمٍ","عَفَّت مَآثِرَ مِن كَعبٍ وَمِن هَرَمِ",53,"م",1,0],["أَبقِ عَلى القَلبِ مِن تَتَيُّمِهِ","وَأَيُّ مُستَغلِقيهِ يَرتَهِنُه",54,"ن",2,0],["أَبقى قَلاونُ الفَخارَ لِوُلدِهِ","إِرثاً وَفازوا بِالثَناءِ مَكاسِبا",55,"ب",2,0],["أَبقِها أنفُض بها خوفَ غدٍ","وأُحِسُّ الأَمنَ منها وبِها",56,"ه",2,0],["أبقِها أشدُد بها أزرِي إذا","ضَعُفَ الأزرُ أو العزم وهَى",56,"ه",2,0],["أبقِها أُومن إِذا لامَستُها","أن حبي ليسَ حُلماً وانتهى",56,"ه",2,0],["أَبقى الجَزيلُ لها جَميلَ ثَنائِهِ","في العيسِ مَوصولاً بِقَطعِ الفَدفَدِ",57,"د",1,0],["أَبقى لَكُم والِداً يَبَرُّكُمُ","أَنجَدَكُم في الوَغى وَأَمجَدَكُم",58,"م",1,0],["أَبقى عَلى جَولَةِ الأَيّامِ مِن كَنَفَي","رَضوى وَأَسيَرُ في الآفاقِ مِن مَثَلِ",59,"ل",1,0],["أَبقَينَ في أَعناقِ جودِكَ جَوهَراً","أَبقى مِنَ الأَطواقِ في الأَجيادِ",60,"د",1,0],["أَبقى يَزيدُ وَمَزيَدُ وَأَبوهُما","وَأَبوكَ رُكنَكَ في الفَخارِ شَديدا",61,"د",2,0],["أَبقَيتَ جَدَّ بَني الإِسلامِ في صَعَدٍ","وَالمُشرِكينَ وَدارَ الشِركِ في صَبَبِ",62,"ب",1,0],["أَبقَت بَني الأَصفَرِ المِمراضِ كَاِسمِهِمُ","صُفرَ الوُجوهِ وَجَلَّت أَوجُهَ العَرَبِ",62,"ب",1,0],["أَبْقَى لهُ الذِّكْرَ المُخَلَّدَ عِلْمُهُ","أنْ ليس في الدُّنْيَا امرُؤٌ بِمُخَلَّدِ",63,"د",1,0],["أبقَيتَ منهم وقد رَوَّوا أسِنّتَهم","بجائِشاتٍ كأفواهِ البَخاتي",64,"ي",1,0],["أبْقَى العُلى ذُخراً ولكنّهُ","لم يَدّخِرْ وَفْراً ولم يُبْقِ",65,"ق",1,0],["أبقِ لي جعفراً أبا جعفرٍ لا","تَرْمِ يَوْمَيْهِ بالنّآدِ العَسوف",66,"ف",1,0],["أبقَتْ حديثاً من مآثِرِهَا","يَبقى وتَنْفَد قبلَه الصُّوَر",67,"ر",1,0],["أَبقَيتَ فِيَّ لِتَقوى اللَهِ باقِيَةً","وَلَم أَكُن كَحَريصٍ لَم يَدَع مَرَحا",68,"ح",2,0],["أَبقى البِلى مِن جَديدِهِنَّ كَما","أَبقى مِنَ الجِسمِ مُقلَتَي حَكَمِ",69,"م",1,0],["أَبقى لِيَ اللَهُ حُسّاداً وَغَمَّهُمُ","حَتى يَموتوا بِداءٍ غَيرِ مَكنونِ",70,"ن",1,0],["أَبقَيتِ مِن قَلبي حُشاشَتَهُ","وَحَلَلتِ بَينَ الروحِ وَالجَسَدِ",71,"د",1,0],["أَبقى لَكَ البَينَ في مَلاعِبِهِ","فَاِنصاعَ لِلبَينِ آخِرَ الأَبَدِ",72,"د",1,0],["أَبقى لَنا الدَهرُ مِن تَذَكُّرِ مَن","قَد كانَ جاراً فَبانَ وَاِغتَرَبا",73,"ب",2,0],["أَبقَيتَ لِلعَبسيِّ فَضلاً وَنِعمَةً","وَمَحمَدَةً مِن باقِياتِ المَحامِدِ",74,"د",1,1],["أَبقَت أَحاديثَ الرِجالِ وَأَهلَكَت","سَلَفي عُتَيبَتَهَا وَآلَ ذُؤابِها",75,"ب",3,0],["أبْقَيْتَ فينا كَوْكَبَينِ سناهما","في الصّبحِ والظّلماءِ ليسَ بخافِ",76,"ف",1,0],["إبْقَ في نِعْمَةٍ بَقاءَ الدّهورِ","نافِذَ الأمرِ في جميعِ الأمورِ",77,"ر",1,1],["أَبقى التَهَجُّرُ مِنها بَعدَ كِدنَتِها","مِنَ المَحالَةِ ما يَشغى بِهِ الكورُ",78,"ر",1,0],["أبْقِ لي مقْلَةً لَعَلّيَ يوماً","قبل مَوتي أَرَى بها مَنْ رآكا",79,"ك",2,0],["أَبقَت مُقابلتي إياه حينئذٍ","ذِكرى له في فؤادي لَيسَ تنصرف",80,"ف",1,0],["أَبقى وَحيداً في الفراش تديرني","أيدي الهموم فَيا هموم أَديري",81,"ي",1,0],["أَبْقَى زُهَيْرٌ بِهِ مَا شَادَهُ هَرِمٌ","مِنَ الْفَخَارِ حَدِيثاً جدَّ مَأْثُورِ",82,"ر",1,0],["أَبْقَى من الأَعيَانِ وَهْيَ زَوَائِلٌ","أَثَرٌ لَهُ فِي كُلِّ بَارِحَة غد",83,"د",1,0],["أبْقَى لنا حَدَثُ الحروبِ بَقِيَّةً","مِنْ خَيْرِ نِحْلَةِ رَبِّنا الوَهَّابِ",84,"ب",1,1],["أبقتْ ليالي الأُنسِ من أخلاقهم","فزعَ النعامةِ وازدهاءَ الديك",85,"ك",1,0],["أبقى من الهرمَيْن، إلا أنَّها","منحوتةٌ من سائلٍ وقراق",86,"ق",1,0],["أبقيتَها حُرَّةً تمشي أناملها","يَمدُّهنَّ النُهى والنُبْلُ والهِمَم",87,"م",1,0],["أبقيةَ السلف الكريم عجيبةٌ","ما غيرتكِ طوارئ الآباد",88,"د",1,0],["إبْقَ وَقْفاً عَلى العُلا يا أبَا أيّو","بَ في ظِلّهَا عَلَيْكَ الظّليلِ",89,"ل",1,0],["أبقتْ أحاديثَ الرّجالِ، وأهلكتْ","سَلفي عُتَيبيهَا، وآلَ ذؤابها",90,"ب",3,0],["أبقاك ذو العرش أعواماً مُضاعفة ً","فلن تزال بخير ما بقيت لنا",91,"ن",2,0],["أبقينَ منهُ............ وسطَ محبرة ٍ","يكبو، وترفعُهُ الولدانُ بالعمدِ",92,"د",1,0]]}