""],[397,"رسالة اعتذار إلى أم المؤمنين خديجة (رضي الله عنها)","https://www.aldiwan.net/poem10309.html","عموديه"],[400,"جادت على قبر الجلال","https://www.aldiwan.net/poem33476.html","مجزوء الكامل"],[402,"محمد بن حامد إذا ارتجل","https://www.aldiwan.net/poem49493.html","الرجز"],[406,"يا من يهين المال في كسب العلا","https://www.aldiwan.net/poem32221.html","الكامل"],[413,"انظر إلى الأشراف كيف تسود","https://www.aldiwan.net/poem54146.html","البسيط"],[434,"سفها بكيت بدمع عين هام","https://www.aldiwan.net/poem2585.html","الكامل"],[438,"المرء لا زال في دنياه كالعرض","https://www.aldiwan.net/poem14456.html","البسيط"],[438,"حزن يفور ومهجة تتقطع","https://www.aldiwan.net/poem14458.html","الكامل"],[450,"إني لمشتاق لربوة جلق","https://www.aldiwan.net/poem13808.html","الكامل"],[451,"وددت أهدي طويل العمر من أدبي","https://www.aldiwan.net/poem61568.html","البسيط"],[456,"دع ملامي باللوى أورح ودعني","https://www.aldiwan.net/poem55844.html","الرمل"],[456,"حاشاك من عارية ترد","https://www.aldiwan.net/poem56234.html","الوافر"],[462,"شهرت علي صوارم العذل","https://www.aldiwan.net/poem3349.html","عموديه"],[462,"يا خليلي تلك أعلام نجد","https://www.aldiwan.net/poem3489.html","عموديه"],[468,"أكرع الكرعة الروية منها","https://www.aldiwan.net/poem4796.html","البسيط"],[477,"الموت درس وعزرائيل ملقيه","https://www.aldiwan.net/poem36869.html","البسيط"],[477,"لما تعذر أن أكو","https://www.aldiwan.net/poem36887.html","مجزوء الكامل"],[477,"وخز اليراع كوخز الرمح في الألم","https://www.aldiwan.net/poem37183.html","البسيط"],[477,"روضا غرسته في الحياة نضيرا","https://www.aldiwan.net/poem37591.html","الكامل"],[477,"زوجي حسينة خففي لأوائي","https://www.aldiwan.net/poem37596.html","الكامل"],[477,"يا أمة شهد الكتاب بفضلها","https://www.aldiwan.net/poem37623.html","الكامل"],[491,"خلف المدائح بعدك التأبين","https://www.aldiwan.net/poem67315.html","الكامل"],[503,"تائية القافلة","https://www.aldiwan.net/poem27889.html","البسيط"],[512,"خطرت فمال الغصن وهو ممنطق","https://www.aldiwan.net/poem20823.html","الكامل"],[513,"أعرب إذا ما الخطب لم يعرب","https://www.aldiwan.net/poem12015.html","السريع"],[513,"ردا أحاديث المنى وأعيدا","https://www.aldiwan.net/poem12092.html","الكامل"],[513,"هنئت مفتتح الصيام السافر","https://www.aldiwan.net/poem12120.html","الكامل"],[513,"إن السعادة قد أظل زمانها","https://www.aldiwan.net/poem12284.html","الكامل"],[536,"فتحت في روضها زهرة","https://www.aldiwan.net/poem47421.html","عموديه"],[536,"فضلك لا أنساه","https://www.aldiwan.net/poem47510.html","عموديه"],[536,"ألقلب من حذر النوى ملآن","https://www.aldiwan.net/poem47592.html","عموديه"],[551,"قبر ببرذعة استسر ضريحه","https://www.aldiwan.net/poem68330.html","الكامل"],[560,"أسألت بان الجزع وهو يصفق","https://www.aldiwan.net/poem52880.html","الكامل"],[560,"الزهر تبسم نورا عن أقاحيها","https://www.aldiwan.net/poem52974.html","البسيط"],[573,"الصبر بعدك لا يكون","https://www.aldiwan.net/poem2774.html","مجزوء الكامل"],[573,"مالي هجرت بغير ذنب","https://www.aldiwan.net/poem3104.html","مجزوء الكامل"],[574,"ألك السدير وبارق","https://www.aldiwan.net/poem1782.html","مجزوء الكامل"]],"verses":[["أَبقَتِ الأَيّامُ مِنّي صَعدَةً","تَزبُنُ العاجِمَ عَنها إِن عَجَم",0,"م",1,0],["أَبقَوا أَسيراً بَعدَهُم لا يُفتَدى","مِمّا يَجِنُّ وَطالِباً لا يَلحَقُ",1,"ق",1,0],["أَبقى الجَوى جَرحَةً بِقَلبي","ماعِشتُ مَكتومَةَ النَجيعِ",2,"ع",1,0],["أَبقى الخَليطُ بِها مَعاهِدَهُ","أَثَرٌ لَعَمرُكَ ما لَهُ قَصُّ",3,"ص",1,0],["أَبقَوا مَخازِيَ لا تُعفي مَواطِنَها","عَلى البِلادِ فُضولُ الرَيطِ وَالأُزُرُ",4,"ر",1,0],["أَبقوا عَليلاً بَعدَهُم لا بُرؤُهُ","يُرجى وَلا الآمالُ فيهِ تَخيبُ",5,"ب",1,0],["أَبقى الهَوى لِأَخيكَ نَفساً حُرَّةً","حَسرى وَجِسماً ناحِلاً نِضوا",6,"و",2,0],["أَبْقَاكَ ظِلاَّ لِلْعِبَادِ وَمَلْجَأً","وَأَعَانَكَ الرَّحْمَانُ مِنْ سُلطْانِ",7,"ن",1,1],["أَبْقَاكُم اللهُ فِي سَعْدٍ عَقَائِلُهُ","تُبْدِي لَكُمْ غُرَرَ الأَبْكَارِ وَالعونِ",8,"ن",1,0],["أَبقَيْتَنِي فَتَرَكتُ ذِكْرَكَ بَاقِيا","يُتْلَى بِمَدْرَسَةٍ وَمَارِسْتَانِ",9,"ن",1,0],["أَبْقَى رُسُومَكَ كَلَّهَا مَحْفُوظَةً","لَمْ يَنْتَثِرْ مِنْهَا عَلَيْكَ نِظَامُ",10,"م",1,0],["أبْقَيْتُ بالذِّكْرِ الجَميلِ مَدائِحاً","لكَ في فَمِ الرّاوي وقَلْبِ الرّاجي",11,"ي",1,0],["أَبقَى التَهَجُّرُ مِنها بَعدَ ما اِبتُذِلَت","مَخيَلَةً وَهِباباً خاَلِطاً كَثَفا",12,"ف",2,0],["أَبقِ شَيئاً إِذا مَضَيتَ ذَميماً","عَن قَريبٍ يَأتي عَلَيهِ بَنوكا",13,"ك",2,0],["أَبقَيتَ في كَبِدي عَلَيكَ حَزازَةً","تَبدو لِأَهلِ الحَشرِ يَومَ معادي",14,"ي",1,0],["أَبقَيتَ لي يا دَهرُ بَعدَ فِراقِهِ","كَبِداً مُقَرَّحَةً وَجَفناً أَرمَدا",15,"د",2,0],["أَبقى لَنا كُلَّ مَجهولٍ وَفَجَّعَنا","بِالحالِمينَ فَهُم هامٌ وَأَرماسُ",16,"س",1,0],["أبقى لآلك خير ذكرى أنهم","ما طالت الأيام لن يسلوك",17,"ك",1,0],["أبقى من الكنز الدفين وقد علا","هبة الكريم ولو تكون دخانا",18,"ن",2,0],["أَبِقَلْبَيْكُمَا مِنَ الشَّوْقِ بَاقٍ","فَاشْفِيَاهُ بِدَمْعِنَا الهَتَّانِ",19,"ن",1,0],["أَبْقَيْتَ فِينَا وَفِي الأَجْيَالِ تُعْقِبُنَا","ذِكْرَى نُقَدِّسُهَا فِي السِّرِّ وَالْعَلَنِ",20,"ن",1,0],["أبْقَى بَنَاءَيْكَ الَّذِي اسْتَوْطَنْتَهُ","فِي اللهِ عَنْ عُرْفٍ وَعَنْ إيمانِ",21,"ن",1,0],["أَبْقَى وَيَرْفَضُّ حَوْلِي عِقْدُ خُلاَّنِي","أَشْكُو إِلَى اللهِ آلامِي وَأَحْزَانِي",22,"ن",2,1],["أَبْقَى لِرَأْيِكَ أَنْ تُصَرِّفَ أَمْرَهُ","وَالرَّأْيُ قَدْ يُغْنِي عَنِ الصَّمْصَامِ",23,"م",1,0],["أَبقَت مُراكَضَةُ الرِهانِ مُجَرَّباً","عِندَ المَواطِنِ يُرزَقُ التَبشيرا",24,"ر",2,0],["أَبقى العَواصِفُ مِن مَعالِمِ رَسمِها","شَذَبَ الخِيامِ وَمَربَطَ الأَمهارِ",25,"ر",1,0],["أَبقَت لِبَكرٍ مَفخَراً وَسَمالَها","مِن دونِ قَومِهِما يَزيدُ وَهاني",26,"ن",2,0],["أَبقى عَلَيهِ مِن جَوىً مُفارِقُه","رَسيسَ حُبٍّ عَلِقَت عَلائِقُه",27,"ق",2,0],["أَبقى لِأَسبابِ المَوَد","دَةِ أَن تَزورَ وَلا تُجاوِر",28,"ر",1,0],["أَبقى لَنا اللَهُ مَولانا وَلا بَرِحَت","أَيّامُنا أَبَداً في ظِلِّهِ جُدَدا",29,"د",2,0],["أَبقَت رَياسَتُهُ لِمَعشَرِهِ","غَضَبَ الإِلَهِ وَذِلَّةَ الأَصلِ",30,"ل",1,0],["إبقَ ما شئتَ كيف شئت ودوموا","في حمى الله يا بني أيوب",31,"ب",1,0],["أبقوا عليَّ وقوَّضوا فحسبتهم","وحسبتُه سيلاً طما وسحائِبا",32,"ب",2,0],["أبقاكُمُ نُهْزة للناس كلِّهِمُ","أذلَّةً لا عدِمتم ذلة النفَر",33,"ر",1,0],["أبقِ من مالك الممزْ","زَقِ حظّاً لآملِكْ",34,"ك",1,1],["أبقاهُمُ مَنْ أعزَّني بهمُ","ما أفلَ النَّيّران أَوْ نجما",35,"م",2,0],["أبقدْري وزنتَ خَمسينَ رطلاً","من حطام يا ظالماً في الحكومه",36,"م",2,0],["أبقِ منه لا تدعه خائفاً","كلما هَزَّ نسيمٌ فَنَنَه",37,"ن",2,0],["أبقاك ذو العرش أعواماً مُضاعفةً","فلن نزال بخير ما بقيت لنا",38,"ن",2,0],["أبقى الإلهُ لنا العَلاءَ مُمتَّعاً","بعلائِهِ القَوْليِّ والفِعليِّ",39,"ل",2,0],["أَبقَيتَ يا زَمَن الحَرو","رِ بِمُهجَتي مِثلَ الحَرورِ",40,"ر",1,0],["أَبِقَ النَومُ فَاِنطَلَقتُ إِلى انَهرِ","بِنَفسٍ كادَت تَسيلُ دِماها",41,"ا",3,0],["أبْقوا سَماءَ المَعالي","بِما أضاءوا مَنارا",42,"ر",2,0],["ابقيت في كل ارض للهجى اثرا","فجل ما انت قد ابقيت من اثر",43,"ر",1,0],["ابقيت يوسف في العراق لاهله","ذكرى تزيد المعجبين ودادا",44,"د",2,0],["أَبُقراطُ مِثلُ اِبنِ سينا الرَئي","سِ وَهوميرُ مِثلُ أَبي الطَيِّبِ",45,"ب",1,0],["أَبقى عَلَيها عَرشَها في بُرهَةٍ","تَرمي العُروشَ وَتَنثُرُ التيجانا",46,"ن",2,0],["أَبقى المَمالِكَ ما المَعارِفُ أُسُّهُ","وَالعَدلُ فيهِ حائِطٌ وَدِعامُ",47,"م",1,0],["أَبقى زُرَيقٌ لِلثُغورِ مُحَمَّداً","أَبقى نَفيسٌ لِلنَفيسِ نَفيساً",48,"س",2,0],["أَبقَيتَ أَكذَبَ كاذِبٍ أَبقَيتَهُ","وَأَخَذتَ أَصدَقَ مَن يَقولُ وَيَسمَعُ",49,"ع",1,0],["أَبقى وَلَولا التَلافي مِن بَقِيَّتِهِ","قاظَت لَهُم نِسوَةٌ مِن غَيرِ أَزواجِ",50,"ج",1,0],["أَبقاكَ رَبُّكَ في عِزٍّ وَتَأييدِ","وَفي سُرورٍ وَإِنعامٍ وَتَمهيدِ",51,"د",1,1],["إِبقَ وَقفاً عَلى العُلا يَا أَبا أَي","يوبَ في ظِلِّها عَلَيكَ الظَليلِ",52,"ل",1,0],["أَبقى مَآثِرَ مِن مَجدٍ وَمِن كَرَمٍ","عَفَّت مَآثِرَ مِن كَعبٍ وَمِن هَرَمِ",53,"م",1,0],["أَبقِ عَلى القَلبِ مِن تَتَيُّمِهِ","وَأَيُّ مُستَغلِقيهِ يَرتَهِنُه",54,"ن",2,0],["أَبقى قَلاونُ الفَخارَ لِوُلدِهِ","إِرثاً وَفازوا بِالثَناءِ مَكاسِبا",55,"ب",2,0],["أَبقِها أنفُض بها خوفَ غدٍ","وأُحِسُّ الأَمنَ منها وبِها",56,"ه",2,0],["أبقِها أشدُد بها أزرِي إذا","ضَعُفَ الأزرُ أو العزم وهَى",56,"ه",2,0],["أبقِها أُومن إِذا لامَستُها","أن حبي ليسَ حُلماً وانتهى",56,"ه",2,0],["أَبقى الجَزيلُ لها جَميلَ ثَنائِهِ","في العيسِ مَوصولاً بِقَطعِ الفَدفَدِ",57,"د",1,0],["أَبقى لَكُم والِداً يَبَرُّكُمُ","أَنجَدَكُم في الوَغى وَأَمجَدَكُم",58,"م",1,0],["أَبقى عَلى جَولَةِ الأَيّامِ مِن كَنَفَي","رَضوى وَأَسيَرُ في الآفاقِ مِن مَثَلِ",59,"ل",1,0],["أَبقَينَ في أَعناقِ جودِكَ جَوهَراً","أَبقى مِنَ الأَطواقِ في الأَجيادِ",60,"د",1,0],["أَبقى يَزيدُ وَمَزيَدُ وَأَبوهُما","وَأَبوكَ رُكنَكَ في الفَخارِ شَديدا",61,"د",2,0],["أَبقَيتَ جَدَّ بَني الإِسلامِ في صَعَدٍ","وَالمُشرِكينَ وَدارَ الشِركِ في صَبَبِ",62,"ب",1,0],["أَبقَت بَني الأَصفَرِ المِمراضِ كَاِسمِهِمُ","صُفرَ الوُجوهِ وَجَلَّت أَوجُهَ العَرَبِ",62,"ب",1,0],["أَبْقَى لهُ الذِّكْرَ المُخَلَّدَ عِلْمُهُ","أنْ ليس في الدُّنْيَا امرُؤٌ بِمُخَلَّدِ",63,"د",1,0],["أبقَيتَ منهم وقد رَوَّوا أسِنّتَهم","بجائِشاتٍ كأفواهِ البَخاتي",64,"ي",1,0],["أبْقَى العُلى ذُخراً ولكنّهُ","لم يَدّخِرْ وَفْراً ولم يُبْقِ",65,"ق",1,0],["أبقِ لي جعفراً أبا جعفرٍ لا","تَرْمِ يَوْمَيْهِ بالنّآدِ العَسوف",66,"ف",1,0],["أبقَتْ حديثاً من مآثِرِهَا","يَبقى وتَنْفَد قبلَه الصُّوَر",67,"ر",1,0],["أَبقَيتَ فِيَّ لِتَقوى اللَهِ باقِيَةً","وَلَم أَكُن كَحَريصٍ لَم يَدَع مَرَحا",68,"ح",2,0],["أَبقى البِلى مِن جَديدِهِنَّ كَما","أَبقى مِنَ الجِسمِ مُقلَتَي حَكَمِ",69,"م",1,0],["أَبقى لِيَ اللَهُ حُسّاداً وَغَمَّهُمُ","حَتى يَموتوا بِداءٍ غَيرِ مَكنونِ",70,"ن",1,0],["أَبقَيتِ مِن قَلبي حُشاشَتَهُ","وَحَلَلتِ بَينَ الروحِ وَالجَسَدِ",71,"د",1,0],["أَبقى لَكَ البَينَ في مَلاعِبِهِ","فَاِنصاعَ لِلبَينِ آخِرَ الأَبَدِ",72,"د",1,0],["أَبقى لَنا الدَهرُ مِن تَذَكُّرِ مَن","قَد كانَ جاراً فَبانَ وَاِغتَرَبا",73,"ب",2,0],["أَبقَيتَ لِلعَبسيِّ فَضلاً وَنِعمَةً","وَمَحمَدَةً مِن باقِياتِ المَحامِدِ",74,"د",1,1],["أَبقَت أَحاديثَ الرِجالِ وَأَهلَكَت","سَلَفي عُتَيبَتَهَا وَآلَ ذُؤابِها",75,"ب",3,0],["أبْقَيْتَ فينا كَوْكَبَينِ سناهما","في الصّبحِ والظّلماءِ ليسَ بخافِ",76,"ف",1,0],["إبْقَ في نِعْمَةٍ بَقاءَ الدّهورِ","نافِذَ الأمرِ في جميعِ الأمورِ",77,"ر",1,1],["أَبقى التَهَجُّرُ مِنها بَعدَ كِدنَتِها","مِنَ المَحالَةِ ما يَشغى بِهِ الكورُ",78,"ر",1,0],["أبْقِ لي مقْلَةً لَعَلّيَ يوماً","قبل مَوتي أَرَى بها مَنْ رآكا",79,"ك",2,0],["أَبقَت مُقابلتي إياه حينئذٍ","ذِكرى له في فؤادي لَيسَ تنصرف",80,"ف",1,0],["أَبقى وَحيداً في الفراش تديرني","أيدي الهموم فَيا هموم أَديري",81,"ي",1,0],["أَبْقَى زُهَيْرٌ بِهِ مَا شَادَهُ هَرِمٌ","مِنَ الْفَخَارِ حَدِيثاً جدَّ مَأْثُورِ",82,"ر",1,0],["أَبْقَى من الأَعيَانِ وَهْيَ زَوَائِلٌ","أَثَرٌ لَهُ فِي كُلِّ بَارِحَة غد",83,"د",1,0],["أبْقَى لنا حَدَثُ الحروبِ بَقِيَّةً","مِنْ خَيْرِ نِحْلَةِ رَبِّنا الوَهَّابِ",84,"ب",1,1],["أبقتْ ليالي الأُنسِ من أخلاقهم","فزعَ النعامةِ وازدهاءَ الديك",85,"ك",1,0],["أبقى من الهرمَيْن، إلا أنَّها","منحوتةٌ من سائلٍ وقراق",86,"ق",1,0],["أبقيتَها حُرَّةً تمشي أناملها","يَمدُّهنَّ النُهى والنُبْلُ والهِمَم",87,"م",1,0],["أبقيةَ السلف الكريم عجيبةٌ","ما غيرتكِ طوارئ الآباد",88,"د",1,0],["إبْقَ وَقْفاً عَلى العُلا يا أبَا أيّو","بَ في ظِلّهَا عَلَيْكَ الظّليلِ",89,"ل",1,0],["أبقتْ أحاديثَ الرّجالِ، وأهلكتْ","سَلفي عُتَيبيهَا، وآلَ ذؤابها",90,"ب",3,0],["أبقاك ذو العرش أعواماً مُضاعفة ً","فلن تزال بخير ما بقيت لنا",91,"ن",2,0],["أبقينَ منهُ............ وسطَ محبرة ٍ","يكبو، وترفعُهُ الولدانُ بالعمدِ",92,"د",1,0],["أَبقاكَ رَبك لِلعِباد فَلَم تَزَل","لِتلافهم بيد النَدى مُتَلافي",93,"ي",1,0],["أَبقى لَكَ اللَهُ نَجلاً طابَ محتده","مِن مَهدِهِ نَقَلتُهُ لِلعُلا هِمَم",94,"م",1,0],["أَبقاكِ رَب العالَمين لِخَلقِهِ","كَهفاً وَصَمصاماً لِنَصرة دِينِهِ",95,"ن",2,0],["آبِقٌ عادَ واستعادَ صوابَه","باركَ اللهُ عَزْمَهُ وإيابَه",96,"ب",2,0],["آبِقٌ يَسْتَغِيثُ في اللَّيلِ رَبَّه","مُبْتَلًى يَشتكي هَواهُ وكَرْبَهْ",97,"ب",2,1],["آبِقٌ لا يَؤُوبُ، يغشى صحارى","موبقاتٍ مِنَ المَهالِك جَدْبَةْ",97,"ب",2,0],["أبقاه والذعرِ المخيفُ يبيدُه","فكأنه سبع على أشلائه",98,"ا",3,0],["ابق أنسى فليس يحلو لي العيش","إذا لم تكن عليه قريني",99,"ي",1,0],["أَبقى لَها التَعداءُ مِن عَتَداتِها","وِمُتونِها كَخُيوطَةِ الكِتّانِ",100,"ن",1,1],["أبقى وأيسرُ من حِقْدِ الرجال ومن","عداوَةِ الأهل والجيرانِ إن كَلِبُوا",101,"ب",3,0],["أبقاهُ مولاهُ لَنَا مَلجَاً","مِن كُلَّ خَطبٍ دَاهِمٍ نَاصِبِ",102,"ب",1,0],["أبقني بضعَ سنينٍ ريثما","يقدر الأكبرُ أن يؤوي صغارهْ",103,"ر",2,0],["أبقِ الرئيس الأعظما","في صحة ونعيم بالْ",104,"ل",1,0],["أَبَقِيَّةَ البَيتِ الرَفيعِ بِناؤُهُ","لا زِلتَ تِربَ عُلاً حَليفَ بَقاءِ",105,"ا",2,0],["أَبِقَت مِنهُمُ العُقولُ وَأَبقَت","سَقَماً ظاهِراً وَهَمّاً دَخيلا",106,"ل",2,0],["أبقاه ربي للوجود وصانه","من سوء كل مروع ومكدّر",107,"ر",1,0],["أبقاك ربّ العلا في نشر حكمتها","رغماً لأنف معاديها وشانيها",108,"ي",3,0],["أبقاك ربي للأنام فإن في","طول البقاء لك البقاء لدينه",109,"ن",2,0],["أبقاي في كنف الوزير أقام لي","أملا يقل الدهر صادق وعده",110,"د",2,0],["أبقاكَ ربك آمراً في خلقهِ","ناهٍ عن الفحشاءِ والطغيانِ",111,"ن",1,0],["أَبقى على كل من إبقاؤه حسنٌ","ولم يصن بحسامِ يسبق العَذلا",112,"ل",2,0],["أبقيت فيها عنك ذكراً باقياً","ملأ المسامع حمده والألسنا",113,"ن",2,0],["ابقوا على هذه أو هذه ودعوا","هذا النزول إلى الحصبا من الشهب",114,"ب",1,0],["أَبقَيتَ لي سَقَماً يُمازِجُ عَبرَتي","مَن ذا يلذُّ مَعَ السَقامِ لِقاءَ",115,"ا",2,1],["أبقيتَ مني روحاً ما لَها بدنٌ","لِذاكَ زوَّرتَ من ثوبي لها بَدنَا",116,"ن",2,0],["أَبقى لَكُم في كُلِّ دارٍ حلَّها","شَرَفاً يُشَرِّقُ ذِكرُهُ وَيُغَرِّبُ",117,"ب",1,0],["أَبقَت مَرارةَ لَهفةٍ لِقَرينِها","أَبَداً تَجَدِّدُ حُزنهُ تَجديدا",118,"د",2,0],["أَبقَت لَهُ طِفلاً يَئنُّ لِفَقدِها","فَتَزيدُ عِندَ بُكائِهِ الآلامُ",119,"م",1,0],["أَبقى لَنا العالَمَ الفاني وَسارَ إِلى","عَرشٍ بِهِ العَفوُ لِلأَبرارِ مَكتوبُ",120,"ب",1,0],["أَبقى لآلِ قلاووزَ الكِرامَ أَسىً","مَدى الزَمانِ يُلاقي مَدمَعاً هَطِلا",121,"ل",2,0],["أَبقى الحَبيبُ لآلِ فَياضٍ أَسىً","ذابَت بِلَهفَتِها عَلَيهِ الأَنفُسُ",122,"س",1,1],["أَبقى لآلِ المَجدَلانِي بَعدَهُ","غُصَصاً يَدومُ بِها الأَسى المُتواصِلُ",123,"ل",1,0],["أبقى له الحب وجدا في جوارحه","يفنى ويبقى الهوى ما أورق العود",124,"د",1,0],["أبقتْ بها الشمسُ المنيرةُ مثلما","أبقى الحياءُ بوجنةِ المعشوقِ",125,"ق",1,0],["أَبقى لِيَ الأَمسُ مِن غَلواءِ عِفَّتَها","وَلم يَزَل في دَمي مِن روحِها نَسَبُ",126,"ب",1,0],["أَبِقُربَي فنحن أقرب للمو","روث منك ومن مكان الشِعار",127,"ر",1,0],["أبقى بسنته طريقا واضحا","رحبا سواء ليله ونهاره",128,"ر",2,0],["أَبقوا الأسى لي بَعدَهُم مَطعَماً","وَالدَمع حَتّى نَلتَقي مَشرَبا",129,"ب",2,0],["أَبقَيتَ مِن بَعدِكَ لي حَسرَةً","تَفنى اللَيالي دونَها وَالحِقَب",130,"ب",1,0],["أَبْقَى الإِلَهُ لَنَا بِكُمْ","سَمْشَ الرشَادِ بِلا سَحَابْ",131,"ب",1,0],["أَبْقَى لَهُ الْحَمْدَ محْبُوباً نَوَاسِمُهُ","كَالروْضِ سَامَرَهُ طَلٌّ مِنَ السُّحُبِ",132,"ب",1,0],["أَبْقَى لَهُ حُلَلَ التقْرِيضِ رَائِقَةً","في زَيِّ مِرْطٍعلَى الْعِقْيانِ مُنْسَحِبِ",132,"ب",1,0],["أبْقَى الإِلَهُ وُجُودَكُمْ","وَالْبَرُّ فِي الدُّنْيَا مُخَلَّدْ",133,"د",1,0],["أبْقَى الإِلَهُ وُجُودَكُمْ","لِيُجيدَ مِنْ ذَا الدَّهْرِ جِيدَهْ",134,"د",2,0],["أَبْقَاكَ رَبِّي ذَا حَالٍ يَغَصُّ بِهَا","مَنْ رَاحَ يُضْمِرُ بَغْضاً لَكُمْ وَغَدَا",135,"د",2,0],["أَبْقَتْكَ بَعْدَ الْمَوْتِ مُفْ","نِي الْمُبْطِلِينَ مِنَ الْعَبِيدْ",136,"د",1,0],["أَبْقَاكَ رَبِّي فَنَبْقَى بِبَقَائِكَ يَا","مَنْ لاَ يُرَامُ لِمَا قَدْ حَازَهُ دَرَكُ",137,"ك",1,0],["أَبْقَاهُمُ اللهُ لِمَا","مِنْ دِينِهِ يَحْيُونَهْ",138,"ن",2,0],["أَبْقَى إِلَهِي جُودَهُ وَوُجُودَهُ","مُتَعَارِفاً بِحِمَايَةِ السُّلْطَانِ",139,"ن",1,0],["أَبْقَاهُ مَنْ يُبْقِي عَلَى خَيْرِ مَا","يُبْقِي عَلَيْهِ الْحَبْرَ ذَا السُّنَنِ",140,"ن",1,0],["أَبْقَى سِيَادَتَهُ مَنْ","يَبْقَى بِلاَ نَقْصِ كَفِّ",141,"ف",1,0],["أَبْقَاكَ مَنْ أَرْقَاكَ تَخْلُفُ مَنْ مَضَى","كَسُمَاكَ يَا ابْنَ الطَّيِّبِ الأَعْرَاقِ",142,"ق",1,0],["أَبْقَى الإِلَهُ كَمَالَكُمْ مَحْرُوسَا","وَأَدَامَ سِرَّ جَلاَلِكُمْ مَحْسُوسَا",143,"س",2,0],["أَبْقَى عَلَيْهِ مَنِ اصْطَفَاهُ صَلاَتَهُ","مَوْصُولَةً تَتْرَى بِغَيْرِ تَنَاهِ",144,"ا",2,0],["ابق لي اليوم ضعف ما بقيت","أمس نسور الحكيم لقمان",145,"ن",1,0],["أَبِقْتُ لِصَحْوِي مِن عَلاقَتِها نَشْوَى","رَمَتنِي بِسَهْمِ اللَّحْظِ عَمْداً فَما أَشْوَى",146,"و",2,1],["أَبْقَى بِقَلبِي لَوْعَةً لَوْ لَمْ يَكُنْ","يَسْقِيهِ مَاءٌ ذَابَ مِنْ نِيرَانِها",147,"ن",3,0],["أبْقَوْا لَه شَرَفاً يَزيدُ تَجَدُّداً","يَبْأَى لَدَيْهِ عَلَى مَدى الأَحوالِ",148,"ل",1,0],["أبْقاهُمُ لِلْمُتّقين هديَةً","كالشّمسِ تُعْقِبُ أقْمُراً