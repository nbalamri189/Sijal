{"poems":[[55,"أداري المقلتين عن ابن ليلى","https://www.aldiwan.net/poem30660.html","الوافر"],[74,"بكيت ليلا بوجدي وهي تبتسم","https://www.aldiwan.net/poem19675.html","البسيط"],[53,"ضحك الربيع إلى بكا الديم","https://www.aldiwan.net/poem66296.html","أحذ الكامل"],[31,"حي المنازل بين السفح والرحب","https://www.aldiwan.net/poem6045.html","البسيط"],[31,"عفا ممن عهدت به حفير","https://www.aldiwan.net/poem6048.html","الوافر"],[47,"عارضننا أصلا فقلنا الربرب","https://www.aldiwan.net/poem10644.html","الكامل"],[47,"عند العقيق فماثلات دياره","https://www.aldiwan.net/poem63562.html","الكامل"],[30,"ومظلمة علي من الليالي","https://www.aldiwan.net/poem5455.html","الوافر"],[63,"ما ضر ليلتنا بسفح محجر","https://www.aldiwan.net/poem51682.html","الكامل"],[54,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[50,"ومظهرة لخلق الله نسكا","https://www.aldiwan.net/poem65267.html","الوافر"],[91,"","https://poetry.dctabudhabi.ae/diwan/poem/85600","البسيط"],[47,"عَارَضْنَنا أُصُلاً، فَقُلْنَا الرّبْرَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=31698",""],[31,"حيِّ المنازِلَ بَينَ السّفْحِ والرُّحَبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17430&r=&rc=3",""],[139,"بدا علم الإنسان في عالم الحس","https://www.aldiwan.net/poem49035.html","الطويل"],[147,"لا فات ملكك ما أعيا به الطلب","https://www.aldiwan.net/poem11730.html","البسيط"],[147,"ما ذي المساعي الغر في قدر الورى","https://www.aldiwan.net/poem11761.html","الكامل"],[147,"ما ضر طيفك والكرى لو زارا","https://www.aldiwan.net/poem11768.html","الكامل"],[234,"ومظهرة عقد هميانها","https://www.aldiwan.net/poem50757.html","المتقارب"],[276,"ضحك تبروق الابرقين تبسما","https://www.aldiwan.net/poem52106.html","الكامل"],[325,"الدهر أصبح مشرقا بتجليه","https://www.aldiwan.net/poem67199.html","الكامل"],[376,"أفردتني وأرى العشاق أقرانا","https://www.aldiwan.net/poem57010.html","البسيط"],[534,"رؤياك للفاروق تأويلها","https://www.aldiwan.net/poem37232.html","السريع"],[572,"بكرت تلوم ومثلها لك لائمه","https://www.aldiwan.net/poem69523.html","الرجز"],[580,"كحل العيون بمرود من عسجد","https://www.aldiwan.net/poem3085.html","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122774","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122730","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122542","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122755","الكامل"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122772","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/87081","البسيط"],[739,"","https://poetry.dctabudhabi.ae/diwan/poem/34404","البسيط"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48671","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48680","الكامل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48750","الكامل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59570","الرمل"],[1019,"","https://poetry.dctabudhabi.ae/diwan/poem/123317","الطويل"],[1021,"","https://poetry.dctabudhabi.ae/diwan/poem/120084","الكامل"],[1214,"","https://poetry.dctabudhabi.ae/diwan/poem/64895","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136209","الطويل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136278","البسيط"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136364","البسيط"],[1390,"","https://poetry.dctabudhabi.ae/diwan/poem/117137","الكامل"],[458,"","https://poetry.dctabudhabi.ae/diwan/poem/143128","الكامل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109423","الطويل"],[2225,"","https://poetry.dctabudhabi.ae/diwan/poem/109457","الطويل"],[2326,"","https://poetry.dctabudhabi.ae/diwan/poem/88658","الرجز"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120715","السريع"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106894","الطويل"],[2421,"","https://poetry.dctabudhabi.ae/diwan/poem/60984","البسيط"],[2625,"","https://poetry.dctabudhabi.ae/diwan/poem/87332","الرجز"],[2724,"","https://poetry.dctabudhabi.ae/diwan/poem/130837",""],[2804,"","https://poetry.dctabudhabi.ae/diwan/poem/93983","الطويل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74235","البسيط"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74293","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62831","الوافر"],[3512,"","https://poetry.dctabudhabi.ae/diwan/poem/103907","الطويل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138486",""],[3591,"","https://poetry.dctabudhabi.ae/diwan/poem/108090","الطويل"],[3954,"","https://poetry.dctabudhabi.ae/diwan/poem/124746","الرجز"],[4128,"","https://poetry.dctabudhabi.ae/diwan/poem/123518","البسيط"],[4430,"","https://poetry.dctabudhabi.ae/diwan/poem/133119","الطويل"],[5688,"أجيبي مغرما","https://www.poetsgate.com/ViewPoem.aspx?id=206653",""]],"verses":[["وَمُظلِمَةٍ مِنَ الغَمَراتِ عَطشى","جَعَلتَ لَها مِنَ القُضبِ اِنبِلاجا",0,"ج",2,0],["ومظهراً ليَ في دهر يمجمج بي","كأنما أنا حرفٌ فيه مدّغمُ",1,"م",1,0],["ومُظفَّرٍ وعظ العدا بِعِداً","حانوا فأهداهمْ إلى أزمِ",2,"م",1,0],["وَمُظلِمٍ تُعلِنُ الشَكوى حَوامِلُهُ","مُستَفرِغٍ لِسِجالِ العَينِ مُنشَطِبِ",3,"ب",1,0],["وَمُظلِمَةٍ تَضيقُ بِها ذِراعي","وَيَترُكُني بِها الحَدِبُ النَصورُ",4,"ر",1,0],["وَمُظُفَّرونَ إِذا اِستَقَلَّ لِواءُهُم","بِالعِزِّ أَدرَكَ رَبُّهُ ما يَطلُبُ",5,"ب",1,0],["وَمُظَفَّرٌ بِالمَجدِ إِدراكاتُهُ","في الحَظِّ زائِدَةٌ عَلى أَوطارِهِ",6,"ر",2,0],["وَمُظلِمَةٍ عَلَيَّ مِنَ اللَيالي","جَلا ظَلماءَها عَنّي بِلالُ",7,"ل",1,1],["ومُظَفَّرٍ بِنَدَى يَديْكَ ولو غَدا","بالحمدِ غيرُكَ عادَ غيرَ مظفَّرِ",8,"ر",1,0],["وَمُظهِراتٍ قُوَّةَ الإِسلامِ","عَلى رَعاديهِ مِنَ الأَنامِ",9,"م",1,0],["وَمُظهِرَةٍ لِخَلقِ اللَهِ نُسكاً","وَتَلقاني بِذَلٍّ وَاِبتِسامِ",10,"م",1,1],["ومظهرين عداءً لا انقضاء له","كَما تعادي هزار الروض غربان",11,"ن",1,0],["وَمُظَفَّرُونَ، إذا اسْتَقَلّ لوَاؤهُمْ","بالعِزّ، أدْرَكَ رَبُّهُ مَا يَطْلُبُ",12,"ب",1,0],["ومظلمِ تعملُ الشكوى حواملُهْ","مستفرغٍ من سجالِ العينِ منشطبِ",13,"ب",1,0],["ومُظهرُ آثار الفنون وربما","معالمها لولاك آلت إلى الطمسِ",14,"س",1,0],["وَمَظهِرُ العَدلِ في نَأيٍ وَمُقتَرَبٍ","حَتّى لَقَد عَدَلَت عَن ظُلمِها النُوَبُ",15,"ب",1,0],["وَمُظَفَّراً كَفَلَت لَهُ عَزَماتُهُ","أَن لا يُقَدِّمَ هَمُّهُ مَن أَخَّرا",16,"ر",2,0],["وَمُظَفَّرَ الأَقلامِ كَم أَردى بِها","مَلِكاً وَرَوَّعَ جَحفَلاً جَرّارا",17,"ر",2,0],["ومظهِرةٍ عَقْدَ هِمْيانِها","تَدِينُ بطاعةِ رُهبْانِها",18,"ن",3,1],["وَمظفر العزمات يصدع عزمه","صم الجبال وَيستحط الانجما",19,"م",2,0],["وَمَظاهِرُ الإيناسِ يَسطَعُ نورُها","وَاليَمَنُ قارَنَها بِأَبهى بَهجَة",20,"ه",1,0],["ومُظهِراً غَضَباً للنائِبَاتِ لقَد","أرضَيتَ مِنَّا بِهِ مَن كانَ غَضبانا",21,"ن",2,0],["ومُظْهِرُ الفَرْقِ المكَانُ الّذي","رَأَيْتَهُ فِيهِ بِلا حَائِلِ",22,"ل",1,0],["وَمُظَلَّلٍ فِي الخَيْشِ يُلْهَبُ حَتْفُهُ","وَمُقَيَّدٍ مُتَوَسَّدٍ فِي طَارِمَهْ",23,"م",2,0],["ومظفَّرُ العَزماتِ منْصورٌ على","الأَعداءِ مِقدِامُ الجَنانِ مؤيَّدِ",24,"د",1,0],["وَمُظَفَّرُ الحَمَلاتِ لَو صَدَمَ السُّها","بِالخَيلِ طِرنَ لَهُ بِغَيرِ قَوادِمِ",25,"م",1,0],["وَمُظَفَّرُ الحَمَلاتِ لَو صَدَم الجِبا","لَ الرّاسياتِ الشّامِخاتِ أزالَها",26,"ل",3,0],["ومُظَفَّرٌ لو صَكَّ رُكنَي كَبكَبٍ","بِدخانش عزمَتهِ لطحطح كبكبا",27,"ب",2,0],["ومظفر الطلبات لَو عادَ النُّجُو","مَ الأُفقُ ما بَعُدت عَلَيهِ نُجُومُهُ",28,"م",2,0],["وَمُظَّفُرُّ الحَمَلاتِ أَغلَبُ لَم تَخَف","فَتَكاتُهُ في اللهِ لَومَة لائَمِ",29,"م",1,0],["وَمَظهري في ثِياب العَجز ممتطياً","متن التَوكل في نَقض وَإِبرام",30,"م",1,0],["وَمظلمُ النَقعِ مِن إِشراق طلعته","منوِّر وَلَهُ في الأُفق تَصعيدُ",31,"د",1,0],["ومظلَّلين من اللوافح بالقنا","في البيد إذ أذكى الرمالَ هجير",32,"ر",1,0],["ومظاهر الدين الفضائل والهدى","ومظاهر الدنيا ندى ومكارم",33,"م",1,0],["ومظاهر الملك المؤيد تاجه","ولواؤه ومناره والمنبر",34,"ر",1,0],["ومظاهر الهدى","وموالاة السخا",35,"خ",2,0],["ومظهر هذا الحب يوشك أن يرى","قتيلا لمحبوب يغار على السر",36,"ر",1,0],["ومظّم ما زال يد","فع نازل الخطب العظيمِ",37,"م",1,0],["ومُظْهِر النُّصْحِ لي مُخْفٍ جَنايَتَهُ","تَيَقَّنَ الغَدْرَ حتى يُحْسِنَ المَلَقَا",38,"ق",2,0],["ومظهرها ان قرر العلم حكمه","بدا داعيا للحق من عالم الأمر",39,"ر",1,0],["ومظهر السر ان ادركت ظاهره","اطوار علم سمت عن مقتضى العلل",40,"ل",1,0],["ومظهر عين ما اخفاه شاهده","ينبي بسر عن الاكوان يحكيه",41,"ي",2,0],["ومظفر الحملات يرقص منه قل","ب المغرب الأقصى وقلب المشرق",42,"ق",1,0],["ومظاهر (العمران) وهي كثيرة","في (الشرق) لم تعدم لديك خليلا",43,"ل",2,0],["ومظهر ذاك الحسن منه تعرفت","بهيئته الأفكار من غير تنكير",44,"ر",1,0],["ومظهره في الكون لا يطرأ الخفا","عليه ومن نور به لا يجرد",45,"د",1,0],["ومظهر النور الَّذي اوهمته","من جانب الطور لموسى لمعا",46,"ع",2,0],["ومَظهر الحُكمِ الحَكيمِ الذي","يَتلُو عليهِ طِيبَ أخبارِك",47,"ك",1,0],["ومظهرَ إدلالٍ عليَّ وريبةٍ","بطاهر ما أخفى فؤادي وما أبدى",48,"د",2,0],["ومُظُهرُ الصدق محمود عواقبه","وناقل الشر مذموم وممقوت",49,"ت",1,0],["وَمَظلَعُ العيُّوقِ لِهَنجَامِ","وَالنَّعشُ لِلمَيَّانِ خُذ كلامي",50,"ي",1,0],["ومظالم الرومان كا","نت كالقلائد في النحور",51,"ر",1,0],["ومظهرة للوقت ظهراً وغيره","وللبرج أيضاً فهي واحدة العصر",52,"ر",1,1],["وَمَظهر الحَق وَالنهج القَويم وَمَن","بشرعه كان للتَوحيد إِظهار",53,"ر",1,0],["وَمظهر بُشرى في الوَرى طابَ نَشرها","وَفي طَيها يَبدو السُرور وَينشر",54,"ر",1,0],["ومُظلمةٍ من الغَمَراتِ يُغني","عن الآراءِ فيها والصِّحابِ",55,"ب",1,0],["ومظلمةٍ قد نالها متسلط","مدل بأيدٍ عند ذي العرش ثارها",56,"ر",3,0],["ومظهر قدرته فالأمور","متى يدع جامحها يسلس",57,"س",1,0],["ومظلومة باريس أيَّ ظلامةٍ","إذا هي لم تختل ولم تزدر المدنا",58,"ن",2,0],["ومظهر البرى من المرتاب","ما لم يكن داعية اجتناب",59,"ب",1,0],["ومظهر ابن زهير فيه أطمعنى","والعفو عند رسول الله مأمول",60,"ل",1,0],["ومظهر جمال الحق للخلق منةً","معظمةً أعظم بها من مزية",61,"ه",1,0],["وَمَظْهَرُ عَيْنِكِ الحَوْرَاءَ سِحْرٌ","يُصِيبُ عُيُونَ مُبْصِرِهَا العَمَاءُ",62,"ا",2,0]]}