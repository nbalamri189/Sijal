{"poems":[[53,"أداري المقلتين عن ابن ليلى","https://www.aldiwan.net/poem30660.html","الوافر"],[72,"بكيت ليلا بوجدي وهي تبتسم","https://www.aldiwan.net/poem19675.html","البسيط"],[51,"ضحك الربيع إلى بكا الديم","https://www.aldiwan.net/poem66296.html","أحذ الكامل"],[29,"حي المنازل بين السفح والرحب","https://www.aldiwan.net/poem6045.html","البسيط"],[29,"عفا ممن عهدت به حفير","https://www.aldiwan.net/poem6048.html","الوافر"],[45,"عارضننا أصلا فقلنا الربرب","https://www.aldiwan.net/poem10644.html","الكامل"],[45,"عند العقيق فماثلات دياره","https://www.aldiwan.net/poem63562.html","الكامل"],[28,"ومظلمة علي من الليالي","https://www.aldiwan.net/poem5455.html","الوافر"],[61,"ما ضر ليلتنا بسفح محجر","https://www.aldiwan.net/poem51682.html","الكامل"],[52,"باسم الإله الملك الرحمن","https://www.aldiwan.net/poem26559.html","الرجز"],[48,"ومظهرة لخلق الله نسكا","https://www.aldiwan.net/poem65267.html","الوافر"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/85600","البسيط"],[45,"عَارَضْنَنا أُصُلاً، فَقُلْنَا الرّبْرَبُ","https://www.poetsgate.com/ViewPoem.aspx?id=31698",""],[29,"حيِّ المنازِلَ بَينَ السّفْحِ والرُّحَبِ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=17430&r=&rc=3",""]],"verses":[["وَمُظلِمَةٍ مِنَ الغَمَراتِ عَطشى","جَعَلتَ لَها مِنَ القُضبِ اِنبِلاجا",0,"ج",2,0],["ومظهراً ليَ في دهر يمجمج بي","كأنما أنا حرفٌ فيه مدّغمُ",1,"م",1,0],["ومُظفَّرٍ وعظ العدا بِعِداً","حانوا فأهداهمْ إلى أزمِ",2,"م",1,0],["وَمُظلِمٍ تُعلِنُ الشَكوى حَوامِلُهُ","مُستَفرِغٍ لِسِجالِ العَينِ مُنشَطِبِ",3,"ب",1,0],["وَمُظلِمَةٍ تَضيقُ بِها ذِراعي","وَيَترُكُني بِها الحَدِبُ النَصورُ",4,"ر",1,0],["وَمُظُفَّرونَ إِذا اِستَقَلَّ لِواءُهُم","بِالعِزِّ أَدرَكَ رَبُّهُ ما يَطلُبُ",5,"ب",1,0],["وَمُظَفَّرٌ بِالمَجدِ إِدراكاتُهُ","في الحَظِّ زائِدَةٌ عَلى أَوطارِهِ",6,"ر",2,0],["وَمُظلِمَةٍ عَلَيَّ مِنَ اللَيالي","جَلا ظَلماءَها عَنّي بِلالُ",7,"ل",1,1],["ومُظَفَّرٍ بِنَدَى يَديْكَ ولو غَدا","بالحمدِ غيرُكَ عادَ غيرَ مظفَّرِ",8,"ر",1,0],["وَمُظهِراتٍ قُوَّةَ الإِسلامِ","عَلى رَعاديهِ مِنَ الأَنامِ",9,"م",1,0],["وَمُظهِرَةٍ لِخَلقِ اللَهِ نُسكاً","وَتَلقاني بِذَلٍّ وَاِبتِسامِ",10,"م",1,1],["ومظهرين عداءً لا انقضاء له","كَما تعادي هزار الروض غربان",11,"ن",1,0],["وَمُظَفَّرُونَ، إذا اسْتَقَلّ لوَاؤهُمْ","بالعِزّ، أدْرَكَ رَبُّهُ مَا يَطْلُبُ",12,"ب",1,0],["ومظلمِ تعملُ الشكوى حواملُهْ","مستفرغٍ من سجالِ العينِ منشطبِ",13,"ب",1,0]]}