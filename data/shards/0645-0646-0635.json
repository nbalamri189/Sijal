{"poems":[[100,"من أرض بلقيس","https://www.aldiwan.net/poem43676.html","عموديه"],[77,"يا نجعة الوزراء والنواب","https://www.aldiwan.net/poem36707.html","الكامل"],[93,"في رضى المربوب والرب","https://www.aldiwan.net/poem9791.html","عموديه"],[93,"ألطيب في نفحات الروض حياني","https://www.aldiwan.net/poem11224.html","البسيط"],[93,"ذلك الرزء في الصديق الكريم","https://www.aldiwan.net/poem11372.html","الخفيف"],[23,"تبلت فؤادك في المنام خريدة","https://www.aldiwan.net/poem21235.html","الكامل"],[72,"كن كيف شئت فلا براح","https://www.aldiwan.net/poem18503.html","مجزوء الكامل"],[51,"ناشدتك الله في قدري ومنزلتي","https://www.aldiwan.net/poem9222.html","البسيط"],[51,"رقاب أهل الحلوم معتبده","https://www.aldiwan.net/poem61895.html","المنسرح"],[51,"يا هل من الحادثات من وزر","https://www.aldiwan.net/poem62010.html","المنسرح"],[51,"طاف الخيال وعن ذكراك ما طافا","https://www.aldiwan.net/poem65468.html","البسيط"],[51,"شهر نسك قرينه يوم لهو","https://www.aldiwan.net/poem66715.html","الخفيف"],[85,"غال في قيمة أبن بطرس غالى","https://www.aldiwan.net/poem7128.html","الخفيف"],[85,"مرت على الخفاش","https://www.aldiwan.net/poem8037.html","مجزوء الرجز"],[85,"صرح على الوادي المبارك ضاحي","https://www.aldiwan.net/poem62982.html","الكامل"],[85,"من صور السحر المبين عيونا","https://www.aldiwan.net/poem63011.html","الكامل"],[85,"أنا من بدل بالكتب الصحابا","https://www.aldiwan.net/poem63724.html","الكامل"],[45,"إن تأمل محاسن الأصبهاني","https://www.aldiwan.net/poem64696.html","الخفيف"],[61,"صب بغرات الصبا مكلف","https://www.aldiwan.net/poem51549.html","الرجز"],[49,"من سالم الناس سلم","https://www.aldiwan.net/poem63111.html","مجزوء الرجز"],[49,"من صدق الحب لأحبابه","https://www.aldiwan.net/poem64210.html","السريع"],[66,"أما ترى الأنواء والسحائبا","https://www.aldiwan.net/poem40945.html","الرجز"],[80,"أرأيت لنا ولهم ظعنا","https://www.aldiwan.net/poem31261.html","المتدارك"],[80,"ما للوشاة غدوا علي وراحوا","https://www.aldiwan.net/poem31513.html","الكامل"],[80,"غيرته غير الدهر فشاب","https://www.aldiwan.net/poem31541.html","الرمل"],[81,"ردوا على طرفي النوم الذي سلبا","https://www.aldiwan.net/poem61557.html","البسيط"],[75,"كدأبك ابن نبي الله لم يزل","https://www.aldiwan.net/poem69048.html","البسيط"],[75,"قد مررنا على مغانيك تلك","https://www.aldiwan.net/poem69052.html","الطويل"],[75,"الحب حيث المعشر الأعداء","https://www.aldiwan.net/poem69109.html","الكامل"],[48,"أنزف دمعي طول تسكابه","https://www.aldiwan.net/poem10782.html","السريع"],[48,"إني عجبت وفي الأيام معتبر","https://www.aldiwan.net/poem62445.html","البسيط"],[48,"لما تبدى الصبح من حجابه","https://www.aldiwan.net/poem62448.html","الرجز"],[48,"نداماي طول الدهر خرس عن الخنا","https://www.aldiwan.net/poem63279.html","البسيط"],[50,"يا رام قومي اصبحينا غير تصريد","https://www.aldiwan.net/poem63869.html","البسيط"],[46,"من صفة الدنيا التي أجمع النا","https://www.aldiwan.net/poem22219.html","السريع"],[46,"عللاني فإن بيض الأماني","https://www.aldiwan.net/poem23641.html","الخفيف"],[96,"","https://poetry.dctabudhabi.ae/diwan/poem/39640","الكامل"],[85,"","https://poetry.dctabudhabi.ae/diwan/poem/202535","الرجز"],[87,"","https://poetry.dctabudhabi.ae/diwan/poem/42511","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55176","الخفيف"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54953","السريع"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54510","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/141921","المجتث"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43661","الخفيف"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54260","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54224","البسيط"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54220","البسيط"],[106,"بطل الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=179585",""],[106,"خيال في يقظة","https://www.poetsgate.com/ViewPoem.aspx?id=179676",""],[106,"حي اللاجئين","https://www.poetsgate.com/ViewPoem.aspx?id=179618",""],[106,"أغنية الإِسراء","https://www.poetsgate.com/ViewPoem.aspx?id=179622",""],[77,"لمن طلل نائي المزار بعيده","https://www.poetsgate.com/ViewPoem.aspx?id=33818",""],[96,"موكب الوداع","https://www.poetsgate.com/ViewPoem.aspx?id=17479",""],[90,"ذكرى أبو التمن","https://www.poetsgate.com/ViewPoem.aspx?id=179207",""],[90,"سامراء","https://www.poetsgate.com/ViewPoem.aspx?id=179132",""],[90,"أمين الريحاني","https://www.poetsgate.com/ViewPoem.aspx?id=178954",""],[45,"إِن تأَملْ مَحاسِنَ الأَصبَهَاني","https://www.poetsgate.com/ViewPoem.aspx?id=31114",""],[51,"ناشدتُك اللَّه في قَدري ومنزلتي","https://www.poetsgate.com/ViewPoem.aspx?id=27260",""],[85,"مَنْ صَوَّرَ السِّحْرَ المُبينَ عيونا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9570&r=&rc=60",""]],"verses":[["من صدرها هذه الآهات، من فمها","هذي اللحون. ومن تاريخها الذكر",0,"ر",1,0],["مَنْصُوَر دَوْلَةِ آلِ عَبْدِ الْحَقِّ ذَا الْ","أَثَرِ الْغَرِيبِ لُبَابَ كُلِّ لُبَابِ",1,"ب",1,0],["مَنْ صَحِيحِ المجدِ صَادِقِهِ","حِينَ يُشْرَى المَجْدُ بِالكذْبِ",2,"ب",1,0],["منْ صَادِرِينَ إِلَى العَلْيَاءِ عَنْ أَمَلٍ","كَأَنَّهُ دَوْحَةٌ أَوْفَتْ بِأَغْصَانِ",3,"ن",1,0],["مَنْصِبٌ بَعْدَ مَنْصِبٍ فَازَ مِنْ طَيِّ","بِ أَرْزَاقِهِ بِدَرٍّ جَمِيمِ",4,"م",1,0],["مِن صُلبِ خِندِفَ ماجِدٍ أَعراقُهُ","نَجَلَت بِهِ بَيضاءُ ذاتُ تَمامِ",5,"م",1,0],["من صدّ عن نيرانها","فأنا ابنُ قيسٍ لا براح",6,"ح",1,0],["من صاحبٍ خلطَ الحسنى بسيِّئةٍ","وما الدهاءُ دهاهُ لا ولا اللَّوَثُ",7,"ث",1,0],["من صَوْنك الحلمَ أن تدَّرِعَه ال","جهلَ فظاهرْ من دونه زَرَدَهْ",8,"د",2,0],["مُنصلتُ السيفِ كلَّ مُنصلَت","مُنشمر النَّبل كل منشمَرِ",9,"ر",1,0],["منصورة في يدٍ منصورة أبداً","من مُحرِبٍ لم يزل في الروع دلّافا",10,"ف",2,0],["مِنْ صلاةٍ ومن صيام ومن بذْ","لِ نوال ومن سَدىً يُسديه",11,"ي",2,0],["من صفات كأنها العين صدقا","في أداء الوجوه والأشكال",12,"ل",1,0],["مِن صاحِبي الأَميرِ","الظاهِرِ المُنيرِ",13,"ر",1,0],["مَن صَيَّرَ الأَغلالَ زَهرَ قَلائِدٍ","وَكَسا القُيودَ مَحاسِنَ الأَوضاحِ",14,"ح",1,0],["مَن صَوَّرَ السِحرَ المُبينَ عُيوناً","وَأَحَلَّهُ حَدَقاً وَجُفونا",15,"ن",2,1],["مُنصِفٌ ما لَم يَرُض عاطِفَةً","أَو يُعالِجُ لِهَوى النَفسِ غِلابا",16,"ب",2,0],["مُنصِبٌ نَفسَهُ لِمُكتَسِبِ الحَم","دِ يُرى أَنَّهُ مَكانُ اِتِداعِه",17,"ع",2,0],["من صِفَتَيْها الرِّفْقُ والتَّعَجرُفُ","فلم تَزَلْ تُرسَلُ ثم تُخطَفُ",18,"ف",1,0],["مَن صَدَقَ اللَهَ عَلا","مَن طَلَبَ العِلمَ عَلِم",19,"م",1,0],["مَن صَدَقَ الحُبَّ لِأَحبابِهِ","فَإِنَّ حُبَّ ابنِ عُزَيزٍ غُرور",20,"ر",1,1],["مِن صارِعٍ يُحمَلُ أَو مَصروعِ","تَحمِلُ آتٍ أَو تُقِلُّ ذاهِبا",21,"ب",2,0],["من صانَ الدينَ بِصَولَتِهِ","وأذلّ بعزّتهِ الوَثَنَا",22,"ن",2,0],["من صَوْنُهُ قُفْلٌ لكلّ مدينةٍ","فإذا عَصَتْهُ فسَيفهُ المِفتاحُ",23,"ح",1,0],["من صناديدهمُ إنْ ساوروا","أُسُدَ البيد وحيّاتِ الشعاب",24,"ب",1,0],["مَن صاغَهُ اللَهُ مِن ماءِ الحَياةِ","وَمَد جَرَت بَقِيَّتُهُ في ثَغرِهِ شَنَبا",25,"ب",2,0],["مَن صَغَّرَ المَشرِقَينِ الأعظمين إلى","مَن فيهما من مَليكِ الأمر أو بطل",26,"ل",1,0],["مَنصِبٌ فارِعٌ وغابُ أُسودٍ","لم تَدِنْهُ الملوكُ يوماً بمَلْك",27,"ك",1,0],["من صفوِ ماء الوحي وهوَ مُجاجةٌ","من حَوضه الينبوع وهو شفاء",28,"ا",2,0],["مَن صَدَقَت نِيَّتُهُ في الهَوى","أَعانَهُ الحُبُّ عَلى ما بِهِ",29,"ب",2,0],["مِن صاحِبٍ كانَ دُنيائي وَآخِرَتي","عَدا عَلَيَّ جِهاراً عَدوَةَ الذيبِ",30,"ب",1,0],["مِن صَرَخٍ يَغلو إِذا اِغلَولى بِهِ","وَميعَةٍ تَغلِبُ مِن شَبابِهِ",31,"ب",2,0],["مُنَصَّبَةٌ قَد قَدَّمَتها سُقاتُنا","وَريحانُنا شَمُّ الخُدودِ إِلى النَحرِ",32,"ر",1,0],["مَن صاحَبَ الدَهرَ لَم يَترُك لَهُ شَجَناً","فَاِترُك بُكاكَ عَلى نَدمانِكَ المودي",33,"د",2,0],["مِن صِفَةِ الدُنيا الَّتي أَجمَعَ النا","سُ عَلَيها أَنَّها ما صَفَت",34,"ت",1,1],["من صُروفٍ ملَكنَ فكري ونُطْقي","فهْيَ قَيْدُ الفؤاد قَيْدُ اللّسانِ",35,"ن",1,0],["من صُنعِ نظّامينَ جَهدُ خيالهم","مَسحُ الزجاج من الغبار الثائرِ",36,"ر",1,0],["من صحب النّجم تعالى وانفرد","ومن دنا من ساحة البحر وردْ",37,"د",1,0],["مَنْ صَاحَبَ الْعَجْزَ لَمْ يَظْفَرْ بِمَا طَلَبَا","فارْكَبْ مِنَ الْعَزْمِ طِرْفاً يَسْبِقُ الشُّهُبَا",38,"ب",2,1],["مَنْصِبٌ حُفَّ بِالمَخَاطِرِ لَكِنْ","قَلَّمَا مُسْتَقِلُّهُ يَسْتَقِيلُ",39,"ل",1,0],["مِنْ صِبْيَةٍ فِيهِمْ سَدِيدُ الْخُطَى","وَفِيهُمُ الأَصْغَرُ فَالأَصْغَرُ",40,"ر",1,0],["مَنْ صَالَ فِي فَلَكِ الخَيَالِ مَصَالَهُ","فَأَتَي بِكُلِّ سَبِيَّةٍ عَذْرَاءِ",41,"ا",2,0],["من صفف الشعر فوق الجبين","سطر كتاب؟",42,"ب",1,0],["مَن صَحا عَقلهُ وَصَحَّ سَلا عَن","حُبِّ دُنياهُ إِنَّهُ كانَ حوبا",43,"ب",2,0],["من صَخْرِ خُوفُو لها دُونَ الْوَرى عَضَلٌ","جرى به دَمُ عَدْنانٍ شَرايينا",44,"ن",2,0],["مَنْ صارَ في الْخَمْسِينَ فَخرَ بِلادِه","قد كان في العِشْرينَ فَخْرَ لِدَاتِهِ",45,"ت",2,0],["مِنَصّة الحكم زانوها ملائكة","وجَذْوَة الحرب شبّوها شياطينا",46,"ن",2,0],["مَنْ صاوَلَ الجبَّارَ فوق سريره","لا يغدِر الأحرارُ عندَ صيالِهِ",47,"ل",2,0],["مَن صادهُ ضوءُ النَّهار، فما لَهُ","يغشى إذا حالَ النهارُ وأظلما؟",48,"م",2,0],["مَنْ صادَ في الآجامِ فهْ","ولأسْدها صْيدٌ سمين",49,"ن",1,0],["مَنْ صاحبُ الركب قد حَفَّ الجلال به؟","هذا هو المصطفى أسرى به اللهُ",50,"ه",1,0],["منصور اللواء سعيده","وظلك خفاق الرواق مديده",51,"د",2,0],["من صنع نظّامين خهد خيالهم","مسح الزّجاج من الغبار الثائر",52,"ر",1,0],["من صفوةٍ لو قيلَ أيٌّ فَذُّهُمْ","لم تَعْدُ شَخْصَكَ أعينُ النُظَّار",53,"ر",1,0],["من صائنٍ للنفس غيرِ مُذيلها","شُحُاً ومُعطي المالِ غيرِ مُديله",54,"ل",2,0],["مِن صاحبُ السِّمة التي دَّلت على","أدب الحضارة في جمال البادي",55,"د",2,0],["مُنْصبٌ نفسهُ لِمكتَسبِ الحَمْد","يُرى أَنهُ مَكانُ ابتِداعِهْ",56,"ع",2,0],["مِن صاحبٍ خلطَ الحسنى بسيئة ٍ","وما الدهاءُ دهاهُ ولا اللَّوَثُ",57,"ث",1,0],["مَنْ صَوَّرَ السِّحْرَ المُبينَ عيونا","واحلَّه حدقاً لها وجفونا ؟",58,"ن",2,1]]}