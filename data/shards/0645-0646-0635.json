لى الغرام معنفي","https://www.aldiwan.net/poem33645.html","الكامل"],[405,"والعلم إن كلف الإنسان خدمته","https://www.aldiwan.net/poem49750.html","البسيط"],[409,"منصور دارك أضحت منك موحشة","https://www.aldiwan.net/poem32357.html","البسيط"],[416,"وقف الربع على مرتبع","https://www.aldiwan.net/poem53831.html","الرمل"],[416,"يا قبر هل علمت من ضممته","https://www.aldiwan.net/poem53901.html","الرجز"],[416,"كاد أن يقضي سقاما ونحولا","https://www.aldiwan.net/poem54027.html","الرمل"],[420,"كالخط في كتب الغلام أجاده","https://www.aldiwan.net/poem4859.html","الكامل"],[432,"سافر إذا حاولت قدرا","https://www.aldiwan.net/poem12635.html","مجزوء الكامل"],[432,"بكرت لنصحك يا أبا بكر","https://www.aldiwan.net/poem12637.html","أحذ الكامل"],[452,"وردت إلى بيت الأريب البارع","https://www.aldiwan.net/poem13833.html","الكامل"],[452,"بكرت علي نوازع الأشواق","https://www.aldiwan.net/poem13865.html","الكامل"],[453,"الصيف أين هو الحبيب فما أرى","https://www.aldiwan.net/poem61223.html","الكامل"],[458,"تركتك يا زمان قلى فدعني","https://www.aldiwan.net/poem55826.html","الوافر"],[458,"طاف عليه بالرقمتينِ","https://www.aldiwan.net/poem55834.html","مخلع البسيط"],[458,"بالله ثم بالله","https://www.aldiwan.net/poem55953.html","مجزوء الرجز"],[458,"حملوك لو علموا من المحمول","https://www.aldiwan.net/poem56003.html","الكامل"],[464,"شهرت علي صوارم العذل","https://www.aldiwan.net/poem3349.html","عموديه"],[468,"أيها التيس الذي ما","https://www.aldiwan.net/poem59560.html","مجزوء الرمل"],[500,"مطلسم القوم لا تهمل مكانته","https://www.aldiwan.net/poem37775.html","البسيط"],[538,"مقدم القائد الأعز نظيرا","https://www.aldiwan.net/poem48180.html","عموديه"],[538,"ألله أعلم ما السبب","https://www.aldiwan.net/poem48274.html","عموديه"],[558,"يا حسن مطلع من أهوى بذي سلم","https://www.aldiwan.net/poem33497.html","البسيط"],[558,"من صالحيتنا طرنا بأجنحة","https://www.aldiwan.net/poem34683.html","المواليا"],[562,"نحن التراب إلى تراب نرجع","https://www.aldiwan.net/poem52741.html","الكامل"],[562,"خير الرثاء الذي بالقلب قد لطفا","https://www.aldiwan.net/poem52788.html","البسيط"],[562,"دع النسيب وجانب جانب الغزل","https://www.aldiwan.net/poem52825.html","البسيط"],[562,"فعلت كما فعلت سلاف الساقي","https://www.aldiwan.net/poem52920.html","الكامل"],[568,"الحمد لله بديع ما خلق","https://www.aldiwan.net/poem68172.html","الرجز"]],"verses":[["من صدرها هذه الآهات، من فمها","هذي اللحون. ومن تاريخها الذكر",0,"ر",1,0],["مَنْصُوَر دَوْلَةِ آلِ عَبْدِ الْحَقِّ ذَا الْ","أَثَرِ الْغَرِيبِ لُبَابَ كُلِّ لُبَابِ",1,"ب",1,0],["مَنْ صَحِيحِ المجدِ صَادِقِهِ","حِينَ يُشْرَى المَجْدُ بِالكذْبِ",2,"ب",1,0],["منْ صَادِرِينَ إِلَى العَلْيَاءِ عَنْ أَمَلٍ","كَأَنَّهُ دَوْحَةٌ أَوْفَتْ بِأَغْصَانِ",3,"ن",1,0],["مَنْصِبٌ بَعْدَ مَنْصِبٍ فَازَ مِنْ طَيِّ","بِ أَرْزَاقِهِ بِدَرٍّ جَمِيمِ",4,"م",1,0],["مِن صُلبِ خِندِفَ ماجِدٍ أَعراقُهُ","نَجَلَت بِهِ بَيضاءُ ذاتُ تَمامِ",5,"م",1,0],["من صدّ عن نيرانها","فأنا ابنُ قيسٍ لا براح",6,"ح",1,0],["من صاحبٍ خلطَ الحسنى بسيِّئةٍ","وما الدهاءُ دهاهُ لا ولا اللَّوَثُ",7,"ث",1,0],["من صَوْنك الحلمَ أن تدَّرِعَه ال","جهلَ فظاهرْ من دونه زَرَدَهْ",8,"د",2,0],["مُنصلتُ السيفِ كلَّ مُنصلَت","مُنشمر النَّبل كل منشمَرِ",9,"ر",1,0],["منصورة في يدٍ منصورة أبداً","من مُحرِبٍ لم يزل في الروع دلّافا",10,"ف",2,0],["مِنْ صلاةٍ ومن صيام ومن بذْ","لِ نوال ومن سَدىً يُسديه",11,"ي",2,0],["من صفات كأنها العين صدقا","في أداء الوجوه والأشكال",12,"ل",1,0],["مِن صاحِبي الأَميرِ","الظاهِرِ المُنيرِ",13,"ر",1,0],["مَن صَيَّرَ الأَغلالَ زَهرَ قَلائِدٍ","وَكَسا القُيودَ مَحاسِنَ الأَوضاحِ",14,"ح",1,0],["مَن صَوَّرَ السِحرَ المُبينَ عُيوناً","وَأَحَلَّهُ حَدَقاً وَجُفونا",15,"ن",2,1],["مُنصِفٌ ما لَم يَرُض عاطِفَةً","أَو يُعالِجُ لِهَوى النَفسِ غِلابا",16,"ب",2,0],["مُنصِبٌ نَفسَهُ لِمُكتَسِبِ الحَم","دِ يُرى أَنَّهُ مَكانُ اِتِداعِه",17,"ع",2,0],["من صِفَتَيْها الرِّفْقُ والتَّعَجرُفُ","فلم تَزَلْ تُرسَلُ ثم تُخطَفُ",18,"ف",1,0],["مَن صَدَقَ اللَهَ عَلا","مَن طَلَبَ العِلمَ عَلِم",19,"م",1,0],["مَن صَدَقَ الحُبَّ لِأَحبابِهِ","فَإِنَّ حُبَّ ابنِ عُزَيزٍ غُرور",20,"ر",1,1],["مِن صارِعٍ يُحمَلُ أَو مَصروعِ","تَحمِلُ آتٍ أَو تُقِلُّ ذاهِبا",21,"ب",2,0],["من صانَ الدينَ بِصَولَتِهِ","وأذلّ بعزّتهِ الوَثَنَا",22,"ن",2,0],["من صَوْنُهُ قُفْلٌ لكلّ مدينةٍ","فإذا عَصَتْهُ فسَيفهُ المِفتاحُ",23,"ح",1,0],["من صناديدهمُ إنْ ساوروا","أُسُدَ البيد وحيّاتِ الشعاب",24,"ب",1,0],["مَن صاغَهُ اللَهُ مِن ماءِ الحَياةِ","وَمَد جَرَت بَقِيَّتُهُ في ثَغرِهِ شَنَبا",25,"ب",2,0],["مَن صَغَّرَ المَشرِقَينِ الأعظمين إلى","مَن فيهما من مَليكِ الأمر أو بطل",26,"ل",1,0],["مَنصِبٌ فارِعٌ وغابُ أُسودٍ","لم تَدِنْهُ الملوكُ يوماً بمَلْك",27,"ك",1,0],["من صفوِ ماء الوحي وهوَ مُجاجةٌ","من حَوضه الينبوع وهو شفاء",28,"ا",2,0],["مَن صَدَقَت نِيَّتُهُ في الهَوى","أَعانَهُ الحُبُّ عَلى ما بِهِ",29,"ب",2,0],["مِن صاحِبٍ كانَ دُنيائي وَآخِرَتي","عَدا عَلَيَّ جِهاراً عَدوَةَ الذيبِ",30,"ب",1,0],["مِن صَرَخٍ يَغلو إِذا اِغلَولى بِهِ","وَميعَةٍ تَغلِبُ مِن شَبابِهِ",31,"ب",2,0],["مُنَصَّبَةٌ قَد قَدَّمَتها سُقاتُنا","وَريحانُنا شَمُّ الخُدودِ إِلى النَحرِ",32,"ر",1,0],["مَن صاحَبَ الدَهرَ لَم يَترُك لَهُ شَجَناً","فَاِترُك بُكاكَ عَلى نَدمانِكَ المودي",33,"د",2,0],["مِن صِفَةِ الدُنيا الَّتي أَجمَعَ النا","سُ عَلَيها أَنَّها ما صَفَت",34,"ت",1,1],["من صُروفٍ ملَكنَ فكري ونُطْقي","فهْيَ قَيْدُ الفؤاد قَيْدُ اللّسانِ",35,"ن",1,0],["من صُنعِ نظّامينَ جَهدُ خيالهم","مَسحُ الزجاج من الغبار الثائرِ",36,"ر",1,0],["من صحب النّجم تعالى وانفرد","ومن دنا من ساحة البحر وردْ",37,"د",1,0],["مَنْ صَاحَبَ الْعَجْزَ لَمْ يَظْفَرْ بِمَا طَلَبَا","فارْكَبْ مِنَ الْعَزْمِ طِرْفاً يَسْبِقُ الشُّهُبَا",38,"ب",2,1],["مَنْصِبٌ حُفَّ بِالمَخَاطِرِ لَكِنْ","قَلَّمَا مُسْتَقِلُّهُ يَسْتَقِيلُ",39,"ل",1,0],["مِنْ صِبْيَةٍ فِيهِمْ سَدِيدُ الْخُطَى","وَفِيهُمُ الأَصْغَرُ فَالأَصْغَرُ",40,"ر",1,0],["مَنْ صَالَ فِي فَلَكِ الخَيَالِ مَصَالَهُ","فَأَتَي بِكُلِّ سَبِيَّةٍ عَذْرَاءِ",41,"ا",2,0],["من صفف الشعر فوق الجبين","سطر كتاب؟",42,"ب",1,0],["مَن صَحا عَقلهُ وَصَحَّ سَلا عَن","حُبِّ دُنياهُ إِنَّهُ كانَ حوبا",43,"ب",2,0],["من صَخْرِ خُوفُو لها دُونَ الْوَرى عَضَلٌ","جرى به دَمُ عَدْنانٍ شَرايينا",44,"ن",2,0],["مَنْ صارَ في الْخَمْسِينَ فَخرَ بِلادِه","قد كان في العِشْرينَ فَخْرَ لِدَاتِهِ",45,"ت",2,0],["مِنَصّة الحكم زانوها ملائكة","وجَذْوَة الحرب شبّوها شياطينا",46,"ن",2,0],["مَنْ صاوَلَ الجبَّارَ فوق سريره","لا يغدِر الأحرارُ عندَ صيالِهِ",47,"ل",2,0],["مَن صادهُ ضوءُ النَّهار، فما لَهُ","يغشى إذا حالَ النهارُ وأظلما؟",48,"م",2,0],["مَنْ صادَ في الآجامِ فهْ","ولأسْدها صْيدٌ سمين",49,"ن",1,0],["مَنْ صاحبُ الركب قد حَفَّ الجلال به؟","هذا هو المصطفى أسرى به اللهُ",50,"ه",1,0],["منصور اللواء سعيده","وظلك خفاق الرواق مديده",51,"د",2,0],["من صدى البيد ، والشعاب الحواشد","بالمهاوي والضاربات السواهد",52,"د",1,1],["من صخور جلودهن حراب","وكهوف عيونهن مواقد",52,"د",1,0],["من صنع نظّامين خهد خيالهم","مسح الزّجاج من الغبار الثائر",53,"ر",1,0],["من صفوةٍ لو قيلَ أيٌّ فَذُّهُمْ","لم تَعْدُ شَخْصَكَ أعينُ النُظَّار",54,"ر",1,0],["من صائنٍ للنفس غيرِ مُذيلها","شُحُاً ومُعطي المالِ غيرِ مُديله",55,"ل",2,0],["مِن صاحبُ السِّمة التي دَّلت على","أدب الحضارة في جمال البادي",56,"د",2,0],["مُنْصبٌ نفسهُ لِمكتَسبِ الحَمْد","يُرى أَنهُ مَكانُ ابتِداعِهْ",57,"ع",2,0],["مِن صاحبٍ خلطَ الحسنى بسيئة ٍ","وما الدهاءُ دهاهُ ولا اللَّوَثُ",58,"ث",1,0],["مَنْ صَوَّرَ السِّحْرَ المُبينَ عيونا","واحلَّه حدقاً لها وجفونا ؟",59,"ن",2,1],["مَنصبك الفَضل وَأَنتَ الَّذي","مِن ذاكَ في الدارين لا يَعزلُ",60,"ل",1,0],["مِن صَفْوَةِ الصَّفْوَةِ العَلْياءِ مَنْزِلَةً","ضُيوفُهُ مِنْ لآلِي آدمٍ عِقْدُ",61,"د",1,0],["من صيتِ شارِعِها أَحيتْ مَشَارِعُها","ذكراً لذاكرها بالرفعِ يُشْتَهَرُ",62,"ر",1,0],["من صوابٍ ظاهرٍ أو مِنْ مُجُونْ","عفوك اللهم يا رب الأنام",63,"م",1,0],["من صريح يعطيك زبداً بلا مخ","ضٍ ويُغنيك عن تعنّى الوَطبِ",64,"ب",1,0],["مِن صِدقِ قَولِكَ يَبتَدي وَإِلى فِعا","لِكَ يَنتَهي وَإِلَيكَ أَجمَعُ يَنتَمي",65,"م",2,0],["مَن صاحَبَ الدَهرَ لَم يَعدم مُجَلجِلَةً","يَظَلُّ مِنها طِوالَ العَيشِ مَنكوبا",66,"ب",2,0],["منصورٍ الأروَعِ المنصورِ رايتُهُ","فتى محمدٍ المحمودِ أَديانا",67,"ن",2,0],["مَنصِبي في المَجدِ أَعلى مَنصِبٍ","وَعِمادي في العُلى أَوفى عِمادِ",68,"د",1,0],["من صام فيما مضى كانون مقتدرا","على الصيام فلا حر ولا طول",69,"ل",1,1],["من صبا الخُلد وريّا سنتريس","صوّر الوجدان أنفاس غرامي",70,"ي",1,0],["من صنع من أنت","تبارك الخالق",71,"ق",1,0],["من صيغة المضارع الذي ابتدى","بالهمز واحمل ما عداه تهتد",72,"د",1,0],["مِن صِدقِ حُبِّهِما لَهُ أَفذو الحِجى","أَولى بِهِ حُبّاً أَمِ الحَجَرانِ",73,"ن",1,0],["مَنصورَةً أَبَداً كَتا","ئِبُهُ عَلى أَعدائِها",74,"ا",3,0],["مَن صَحا مِن سَكرَةِ الحُب","بِ فَقَلبي غَيرُ صاحِ",75,"ح",1,0],["مَنصوبَةٌ أَعلامُهُ مَحفوضَةٌ","أَعداؤُهُ مَرفوعَةٌ راياتُهُ",76,"ت",2,0],["مِنْ صِيَالٍ نَارُهُ في اضْطِرامٍ","ونَوالٍ ماؤُهُ في انْسِياح",77,"ح",1,0],["من صفوِ سادات الأنا","م وسر أرباب الأول",78,"ل",1,0],["مُنَصِّلُ أَطراف العَوالي وَلَم يَكُن","قَديماً بِهِ ذو التِّبلِ يُدرِك تِبلَهُ",79,"ل",2,0],["مِن صَفحِهِم عَن ذي المكانةِ فيهم","وَالبطشِ بالمستضعفِ الأركانِ",80,"ن",1,0],["مِن صاحِبٍ وَماجِدٍ قَتيلِ","وَالدَهرُ لا يَقنَعُ بِالبَديلِ",81,"ل",1,0],["مِن صُنعِ صَواغِ حَديثٍ نَشأَةً","فاقَ الشُيوخَ بِما تَحصُلُ وَاِكتَسَب",82,"ب",1,0],["من صلاتي عليك في غسق","الليل وفي ضحوة الصباح السنى",83,"ن",2,0],["مِن صَوبِ سارِيَةٍ أَطاعَ جَهامُها","نَكباءَ تَمري مُزنَها أَوداقا",84,"ق",2,0],["مَن صادَفَ الدَهرُ في تَصَرُّفِهِ","وَرامَ لِلجَهلِ خُدعَةً خَدَعَه",85,"ع",2,0],["مِن صفة الجَوْهِرِ أَنْ يَرْسُبَا","فَما الذِي أَوْجَبَ أَن تَعْجَبَا",86,"ب",2,1],["مِن صِفاتِ الكَرِيمِ سِتْرُ الحَريِمِ","فَلَكَ اللَّهُ مِن جَوادٍ كَريمِ",87,"م",1,1],["مِن صُنع ذي فَضل بِبَيروت لا","مِن صُنع صَنعاءِ بِلاد اليَمَن",88,"ن",1,0],["مُنصِتَةٌ تَسمَعُ ما يَقولُ","كالخُلدِ لمَّا قابَلَتهُ الغُولُ",89,"ل",1,1],["من صخرةٍ شرقيةٍ قد قابلت","مرماةَ منجَى الجهبذِ النقّاد",90,"د",1,0],["من صار ديدنه النواح فإنه","بهواه في كل النواحي نائح",91,"ح",1,0],["من صوت صافورٍ وفك خواتمٍ","مع ضربةٍ جاءت بجامٍ تسكب",92,"ب",1,0],["من صخرة كمنجنيق القذاف","حتى نقلنا صخر ذات أعراف",93,"ف",1,1],["من صادهُ تاه به واستَبثرا","لأنَّ كلّ الصَّيد في جَوف الفرا",94,"ر",2,0],["مِن صادِقٍ كُنتُ أُصفيهِ مُخالَصَتي","فَباعَ داراً بِأَغلى صَفقَةِ الدارِ",95,"ر",1,0],["من صيد برىي مع الفديه بمثل أو بمال","وحفظك القلب وا