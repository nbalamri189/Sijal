{"poems":[[95,"قالوا قراكم شعيي","https://www.aldiwan.net/poem11211.html","المجتث"],[93,"قالوا قضى موسى فقلت قد انطوى","https://www.aldiwan.net/poem8827.html","عموديه"],[91,"لهفي على الحر الموس","https://www.aldiwan.net/poem44925.html","مجزوء الكامل"],[54,"مل سقامي عوده","https://www.aldiwan.net/poem27131.html","مجزوء الرجز"],[57,"","https://poetry.dctabudhabi.ae/diwan/poem/12640","البسيط"],[92,"يا بنت رسطاليس","https://www.poetsgate.com/ViewPoem.aspx?id=179219",""],[128,"عفا الصفا وانتفى من كوخ ندماني","https://www.aldiwan.net/poem23777.html","البسيط"],[214,"قالوا قصيدتك ارتدت وما سمعت","https://www.aldiwan.net/poem13450.html","البسيط"],[358,"قالوا قضى زيد فزاد بنا الأسا","https://www.aldiwan.net/poem40028.html","الكامل"],[369,"من كان فوق سراة المجد معتليا","https://www.aldiwan.net/poem60558.html","البسيط"],[412,"قالوا قتلت بصارم من طرفه","https://www.aldiwan.net/poem50093.html","الكامل"],[543,"قالوا فلما يجبهم","https://www.aldiwan.net/poem47964.html","عموديه"],[556,"من ذا الطبيب لأدوائي وأوجاعي","https://www.aldiwan.net/poem47698.html","البسيط"],[556,"من مثلها كنت تخشى أيها الحذر","https://www.aldiwan.net/poem47824.html","البسيط"],[580,"قالوا قضيب البان قد بانا","https://www.aldiwan.net/poem2840.html","السريع"],[695,"","https://poetry.dctabudhabi.ae/diwan/poem/88630","السريع"],[802,"","https://poetry.dctabudhabi.ae/diwan/poem/130170","البسيط"],[1199,"","https://poetry.dctabudhabi.ae/diwan/poem/130637","البسيط"],[415,"","https://poetry.dctabudhabi.ae/diwan/poem/31780","الكامل"],[2270,"","https://poetry.dctabudhabi.ae/diwan/poem/97800","البسيط"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/200211",""],[3172,"","https://poetry.dctabudhabi.ae/diwan/poem/110764","الكامل"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89378","البسيط"],[3610,"","https://poetry.dctabudhabi.ae/diwan/poem/45869","الكامل"],[3835,"","https://poetry.dctabudhabi.ae/diwan/poem/32845","البسيط"],[244,"","https://poetry.dctabudhabi.ae/diwan/poem/125806","الكامل"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119663","البسيط"],[4087,"","https://poetry.dctabudhabi.ae/diwan/poem/131660",""],[4985,"صدام","https://www.poetsgate.com/ViewPoem.aspx?id=11311",""],[5135,"قاتلَ اللهُ الهوى","https://www.poetsgate.com/ViewPoem.aspx?id=201971",""],[5365,"الأطلال","https://www.poetsgate.com/ViewPoem.aspx?id=190439",""],[5431,"حول معضلة الشر ...","https://www.poetsgate.com/ViewPoem.aspx?id=210553",""],[5525,"طير السعد","https://www.poetsgate.com/ViewPoem.aspx?id=999",""],[5542,"قالوا تطرف جيلنا","https://www.poetsgate.com/ViewPoem.aspx?id=10190",""],[5616,"قصب","https://www.poetsgate.com/ViewPoem.aspx?id=203436",""],[5732,"قالوا قحوم","https://www.poetsgate.com/ViewPoem.aspx?id=177824",""],[5736,"إلى حيث الهوى تَرِفُ","https://www.poetsgate.com/ViewPoem.aspx?id=208222",""],[5789,"مغازلة الجِراح","https://www.poetsgate.com/ViewPoem.aspx?id=201410",""],[5790,"قالوا قضى الملك المسعود قلت لهم","https://www.poetsgate.com/ViewPoem.aspx?id=111874",""],[5944,"كلاسيكية","https://www.poetsgate.com/ViewPoem.aspx?id=214285",""],[5997,"عِلْمُ الْبَيَاْن","https://www.poetsgate.com/ViewPoem.aspx?id=214993",""],[6093,"أَلِهَ المُعنى ما يُحيرُ جوابا","https://www.poetsgate.com/ViewPoem.aspx?id=177706",""],[5724,"شريعة الله للاصلاح عنوان","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55134&r=&rc=1",""],[6318,"السهم الأخير وفتىًُ يفَجَّر نفسَهَّ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66168&r=&rc=18",""]],"verses":[["قَالُوا قِرَاكُمْ شَعِييٌّ","كَذَا بِعَهْدِي كَانَا",0,"ن",2,1],["قالوا قَضى موسى فَقُلتُ قَدِ اِنطَوى","عَلَم وَأُغمِدَ صارِمٌ بَتّارُ",1,"ر",1,1],["قالوا قضى فمسكت قلبي","وهو يلحف في الوجيف",2,"ف",1,0],["قالوا قَليلاً عَدَدُه","مَن غَشَّ قَلَّ وَلَدُه",3,"د",2,0],["قالوا قَدِ اِعتَلَّ مَن تَهوى فَقُلتُ لَهُم","وَيلي إِذا لَم أَجِد مِثلَ الَّذي وَجَدا",4,"د",2,1],["قالوا : قواعدُ يبتنيها غاضبٌ","وسْطَ العراق على الكرامةِ قاعدا",5,"د",2,0],["قالوا قضى ومضى وهبي لطيته","تغمدت روحه رحمات رحمان",6,"ن",1,0],["قالوا قصيدتك ارتدت وما سمعت","بالله بالله اخبرنا عن السبب",7,"ب",1,1],["قالوا قَضى زَيدٌ فَزادَ بِنا الأَسا","أَسَفاً فَقُلت على الأَراذل لا أَسَف",8,"ف",1,1],["قالوا قد اختلَفتْ منه الخُطا خطأً","فقلتُ حاشا العُلا ما خَطْوهُ خَطيا",9,"ي",2,0],["قالوا قُتلت بِصارِمٍ من طَرفِهِ","فيما زَعمت وَما نَراهُ بَقاني",10,"ي",1,1],["قالوا قلما يجبهُم","اقرأ لنا في حواله",11,"ل",2,0],["قالوا قنعتَ بدون النَّصفِ قلت لهمْ","هَيهات ما باِختياري كان إقناعي",12,"ع",2,0],["قالوا قَضى غيرَ ذي ضَعفٍ ولا كِبَرٍ","فقلت ما كلُّ أسبابِ الرّدى كِبَرُ",13,"ر",1,0],["قالوا قضيبُ البان قد بَانا","فقُلْتُ إِنَّ الحَيْن قد حانا",14,"ن",2,1],["قالوا قصير وله همة","ما قصرت عن كل أَمر عسير",15,"ر",1,1],["قالوا قضى هرمز المديون قلت لهم","يا ويله مفلساً يسري بتابوت",16,"ت",1,1],["قالوا قضى نحبه عيسى فقلت لهم","كلا لقد اخطأوا مرأى ومستمعا",17,"ع",2,0],["قَالُوا قَلاكَ ومَلّا","فقلتُ حاشا وكلّا",18,"ل",2,1],["قالوا قَتلنا دريداً قلت قَد صَدقوا","وَظلّ دمعي عَلى الخدّين ينحدرُ",19,"ر",1,1],["قالوا : قريضُك لفظه صدفٌ","حيناً وحيناً لفظه درُّ",20,"ر",1,1],["قالوا قضى بركات قلت فحق لي","أن أتبع العبراتِ بالزفرات",21,"ت",1,1],["قالوا قضى حسنٌ نحباً فقلت لهم","لا بعد يحسن بي إلا النحيب إذن",22,"ن",1,0],["قالوا قَضى حسن المَناقب فارثه","فَأَجبتهم وَمَدامِعي تَتَحدر",23,"ر",1,1],["قالوا قَميصُكَ مَغمورٌ بِآثارِ","مِنَ المُدامَةِ وَالرَيحانِ وَالغارِ",24,"ر",1,1],["قالوا قضى عبدُ العزيز ويالَه","هول يهد من الأمور جسامها",25,"م",3,0],["قالوا قعَدتَ فلم تخرج فقلت لهم","بعدي عن الناس في هذا الزمان حجا",26,"ج",2,1],["قالوا قد الغيد يتقرا يا عماد","ما قد سمعنا بحرمه قاربه",27,"ه",1,0],["قالوا قتلت زعيما من غواتهم","( بجبهة العير يفدى حافر الفرس)",28,"س",1,0],["قالوا قديماً : \" قاتلَ اللهُ الهوى \"","وأقولُ : مرحا للهوى أحيانا",29,"ن",2,1],["قالوا قديماً جميلُ الشِّعرِ ما كذَبَتْ","بهِ القوافي وقدْ سادَتْ بما كذَبُوا",30,"ب",3,0],["قالوا : قديرٌ وذو علمٍ ورحمته","الأكوان قد وسعت وارتابت المقل",31,"ل",1,0],["قالوا قصدت: وقلت أنا مقصدي فيه","مدحي لأخوي اليوم يكفي قليله",32,"ل",2,0],["قالوا قسوت ورب قسوة عاشق","حفظت لمن يهوى المكان الأعمقا",33,"ق",2,0],["قالوا قعدت وكل الناس قد هرُعوا","وكلهم لاهثاً قد جدّ في الطلب",34,"ب",1,0],["قالوا قحوم ويرفع الرأس بالحيل","مع اول الغاره يعطعط رهيمه",35,"م",2,0],["قالوا قديما وفي أقوالهم حِكَمٌ","تمضي \"الخطاوي\" إلى حيث الهوى تَرِفُ",36,"ف",1,0],["قاَلُوا قديما.ولكِن صِرتُ اَعرِفُهاَ","قِدِّيسةٌ..مِن يَدَيهَا تُطعِمُ الفُقَرا",37,"ر",2,0],["قالوا قضى الملك المسعود قلت لهم","لا تطمعوا في بقاء الشمس والقمر",38,"ر",1,1],["8–قالوا: قَلاكَ فقُلْتُ: را (م)","ضٍ بالحبيبِ وما قَضىٰ",39,"ض",2,0],["قَاْلُوْا قَضَاْءُ اللهِ حَقّاً إِنْ قَضَىْ","شَيْئَاً يَقُوْلُ يَكُوْنُ بِالْإِيْكَاْدِ",40,"د",1,0],["13. قالوا: قديمٌ ما أتيتَ بمُحْدَثٍ","البومُ ترجو أن تَبُزَّ عقابا",41,"ب",2,0],["قالوا قد اختلفت ترك ويونان","لا بل قد اختلفنا كفر وإيمان",42,"ن",1,0],["قالوا قَلِقْنا! أوقفوا الإرهاب! ويْ","لكُمُ ! فمن ذاك الذي هُو يُرْهِبُ ؟!",43,"ب",1,0]]}