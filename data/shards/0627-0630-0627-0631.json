ت فيهما","https://www.poetsgate.com/ViewPoem.aspx?id=21755",""],[28,"يا عجبا للعذارى يوم معقلة","https://www.poetsgate.com/ViewPoem.aspx?id=21598",""],[85,"أحقُّ أنهم دفنوا عليَّا","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=9637&r=&rc=127",""]],"verses":[["إِذا رَجَعَ الغَزِيُّ بِهِنَّ حَسرى","أُعِدنَ إِلى الطِعانِ كَما بُدينا",0,"ن",2,0],["إِذا رُمتُ طَعناً بِالقَريضِ حَمَيتُهُ","وَإِن رُمتُ طَعناً بِالرِماحِ حَماني",1,"ي",1,0],["إِذا رَأوا مَدَّهُ نَحوي يَداً وَضَعوا","فيها عِظامَ جَلاميدٍ لِتَرميني",2,"ي",1,0],["إِذا رَأى وَطفاءَ عُلوِيَّةً","أَيقَظَني شائِمَ بَرقٍ وَنام",3,"م",1,0],["إِذا رابَني الأَقوامُ بَعدَ وَدادَةٍ","لَبِستُ القِلى نَعلاً بِغَيرِ قِبالِ",4,"ل",1,1],["إِذا ريعَ شَمَّرَ لِلمُحفِظاتِ","وَجَرَّ ذُيولَ الحَديدِ المُذالِ",5,"ل",1,0],["إِذا رَجا القَلبُ أَن يُنسيهِ غُصَّتَهُ","ما يُحدِثُ الدَهرُ أَدمى قَرحَهُ وَنَكا",6,"ك",2,0],["إِذا رَثَموا المِسكَ العَرانينَ خِلتَهُم","أُسودَ الشَرى سافَت دَماً بِالمَناشِقِ",7,"ق",1,0],["إِذا رَأَينا قِوامَ الدينِ راكِبَها","فَلَيسَ في ظَهرِها لِلقَومِ مُرتَدَفُ",8,"ف",1,0],["إِذا رَكَضَت أَقوالَهُم في مَسامِعي","عَلى العُذرِ جاءَت خاطِري وَهيَ ظُلَّعُ",9,"ع",1,0],["إِذا راقَ صُبحٌ فَالحِصانُ مُصاحِبٌ","وَإِن عاقَ لَيلٌ فَالحُسامُ ضَجيعُ",10,"ع",1,0],["إِذا رَأى اِفتِراقَها زاوَلَها","ثُمَّ يَني إِذا رَأى اِجتِماعَها",11,"ع",3,0],["إِذا رَمَقوهُ وَالجُفونُ كَواسِرٌ","عَلى غَيرِ داءٍ وَالرِقابُ نَواكِسُ",12,"س",1,0],["إِذا راوَحَ الرُعيانُ لَيلاً سَوامَهُ","فَقَد لَفَّها جِنحُ الظَلامِ بِعاقِرِ",13,"ر",1,0],["إِذا رَكَضَت بِساحَتِكَ اللَيالي","فَلا زالَت تَقاعَسُ في الشُهورِ",14,"ر",1,0],["إِذا رَأى أَعلامَها","عَجَّ إِلَيها وَجَأَر",15,"ر",1,0],["إِذا رَحَلوا عَن خِطَّةِ اللَؤمِ خالَفوا","إِلَيها بِأَعناقِ المَطِيِّ وَعادوا",16,"د",3,0],["إِذا رَكِبَت آمالُهُ ظَهرَ نِيَّةٍ","رَأَيتَ غُلاماً غائِرَ الشَوقِ مُنجِدا",17,"د",2,0],["إِذا رَداحُ الرَوعِ عَنَّت لَهُ","فَرَّ إِلى ضَمِّ الكِعابِ الرَداح",18,"ح",1,0],["إِذا ريعَ الشَجاعُ بِهِنَّ قُلنا","لِأَمرٍ غَصَّ بِالماءِ القَراحِ",19,"ح",1,0],["إِذا رَسَبَت حَصاةُ القَلبِ مِنهُ","طَفا قَلبُ الجَبانِ بِهِ اِنزِعاجا",20,"ج",2,0],["إِذا رُمتُ مِن سَوآتِكُم سَدَّ هُوَّةٍ","تَشاغَلتُمُ عَن غَيرِها بِالنَبائِثِ",21,"ث",1,0],["إِذا رَكِبوا سالَ اللَديدانِ بِالقَبا","وَحَنَّت مَطاياها المَنايا الرَوائِثُ",22,"ث",1,0],["إِذا رَكِبوا تَضايَقَتِ الفَيافي","وَعَطَّلَ بَعضُ جَمعِهِمُ الفَضاءَ",23,"ا",2,0],["إِذا رأَى الأُفقَ بالظَّلماءِ مُختَمِرا","أَمسى وَناظِرُهُ بِالدَّمعِ مُنتَقِبُ",24,"ب",1,0],["إِذا رَأَيتُ الرِّكابَ صادِرَةً","سارَ بِقَلبي إِلَيكَ مُنجِدُها",25,"د",3,0],["إِذا رَموا مَن يُعاديهِم بِها رَجَعَتْ","بِالنَّهبِ داميَةَ اللَّباتِ وَالثُنَنِ",26,"ن",1,0],["إِذا رَضيتْ عَنّي فَلا باتَ لَيلَةً","عَلى غَضَبٍ إِلّا العَشيرَةُ وَالأَهلُ",27,"ل",1,0],["إِذا رُفِعَت عَنهُ السُّجوفُ وَأَشرَقَتْ","أَسِرَّتُهُ خَرَّ السَلاطينُ سُجَّدا",28,"د",2,0],["إِذا رَمى النَّقْعُ عَيْنَ الشَّمْسِ بالعَمَشِ","فَاحْرِصْ على المَوْتِ في كَسْبِ العُلا تَعِشِ",29,"ش",1,1],["إذا رُفِعَ السِّجْفُ عنها بَدَتْ","هِلالاً على غُصُنٍ في نَقا",30,"ا",1,0],["إذا رَكِبَ اخْتالَتْ بهِ الخَيْلُ أو مَشى","لَوَتْ مِنْ هَواديها إليهِ المَجالِسُ",31,"س",1,0],["إذا رَنا لَفَّ الرّدى حاسِراً","بِدارِعٍ فاللحْظُ شاكي السِّلاحْ",32,"ح",1,0],["إذا رَكزوها فالأنامُ عُفاتُهُمْ","وإنْ رَفَعوها فالنّسورُ عُفاتُها",33,"ت",3,0],["إذا رنَّحَتْهُ هِزَّةُ المَدْحِ أخْضَلَتْ","سِجالُ أيادِيهِ وللحَمْدِ أثْمانُ",34,"ن",1,0],["إذا راعَها غَولُ الطّريقِ هَفَتْ بِها","أغاريدُ حادٍ خَلْفَها مُتَرَنِّمِ",35,"م",1,0],["إِذا رَأَت سائِرَ الساداتِ سائِرَةً","تَزورُ شِعري بِرُكنِ البَيتِ في رَجَبِ",36,"ب",1,0],["إِذا ريحُ الصَبا هَبَّت أَصيل","شَفَت بِهُبوبِها قَلباً عَليلا",37,"ل",2,1],["إِذا رَفَعوها بِعودِ الخِلافِ","رَفَعنا جَميعاً إِلَيها العُيونا",38,"ن",2,0],["إِذا رَقَدتُ دَنَت مِن بُعدِها فَإِذا","أَصبَحتُ أَصبَحَ مِنها القُربُ قَد بَعُدا",39,"د",2,0],["إِذا رَضيَت لَم يَهنِني ذَلِكَ الرِضا","لِعِلمي بِهِ أَن سَوفَ يَتبَعُهُ العَتَبُ",40,"ب",1,0],["إِذا رُمتَ أَن تَحيا سَليماً مِنَ الرَدى","وَدينُكَ مَوفورٌ وَعِرضُكَ صَيِّنُ",41,"ن",1,1],["إِذا رُمتَ المَكارِمَ مِن كَريمٍ","فَيَمِّم مَن بَنى لِلَّهِ بَيتا",42,"ت",2,1],["إِذَا رَنَتْ أَوْ ثَنَتْ أَعْطَافَهَا مَرَحاً","فَالظَّبْيُ فِي نَظَرٍ وَالْغُصْنُ فِي مَيَلِ",43,"ل",1,0],["إذا رُمْتَ صَعْباً أو طَلَبْتَ مُمَنّعاً","فجَدُّكَ يدْعو بالصِّعابِ فتَنْقادُ",44,"د",1,0],["إِذا رَوَّحَ الراعي اللَقاحَ مُعَزِّباً","وَأَمسَت عَلى آفاقِها غَبَراتُها",45,"ت",3,0],["إِذا رَهِبَ المَوجَ نُوتِيُّهُ","يَحُطُّ القِلاعَ وَيُرخي الزِيارَ",46,"ر",1,0],["إِذا راعَها مَسٌّ مِنَ الضَيمِ خِلتَها","كَمَن راعَهُ بِالمَسِّ سِلكٌ مُكَهرَبُ",47,"ب",1,0],["إِذا رَضِيَت جاءَت بِأَنفاسِ رَوضَةٍ","وَإِن غَضِبَت جاءَت بِنَكباءَ زَعزَعِ",48,"ع",1,0],["إِذا رُمتُ أَن أَسمو صُعوداً إِلى العُلى","غَدا عرقُهُ نَحوَ الدَنِيَّةِ جاذِبي",49,"ي",1,0],["إِذا رَفَدوا في وَشيِ تِلكَ المَطارِفِ","فَلَيسَ عَلى خَلعِ العِذارِ مُلامُ",50,"م",1,0],["إِذا ريغَ فَليَقتَصِد مُسرِفٌ","مَساعٍ يُقَصِّرُ عَنها الحَفَض",51,"ض",1,0],["إِذا راقَ حُسنُ الرَوضِ أَو فاحَ طيبُهُ","فَما ضَرُّهُ أَن طَنَّ فيهِ ذُبابُ",52,"ب",1,0],["إِذا رَكِبوا الخَيلَ وَاِستَلأَمو","تَحَرَّقَتِ الأَرضُ وَاليَومُ قَر",53,"ر",1,0],["إِذا راحَ لِلأُدحِيِّ أَوباً يَفُنُّه","تُحاذِرُ مِن إِدراكِهِ وَتَحيصُ",54,"ص",1,0],["إِذا رَحَلَت مِنها قَلوصٌ تَبَغَّمَت","تَبَغُّمَ أُمِّ الخِشفِ تَبغي غَزالَها",55,"ل",3,0],["إِذا رَكِبوا ثارَت عَلَيكَ عَجاجَةٌ","وَفي الأَرضِ مِن وَقعِ الأَسِنَّةِ أَولَقُ",56,"ق",1,0],["إذا رخص الغالي من السلعة اشتروا","ولا يشترون الحر إن رخص العبد",57,"د",1,0],["إذَا رَأَيْتُمْ قَلْباً جَرِيحاً","لَهُ جَنَاحَانِ يَضْرِبَانِ",58,"ن",1,1],["إِذا رَأَيتَ بَني وَهبٍ بِمَنزِلَةٍ","لَم تَدرِ أَيُّهُمُ الأُنثى مِنَ الذَكَرِ",59,"ر",1,1],["إِذا رَدَّ في رَقشاءَ عَجّاً كَأَنَّهُ","عَزيفٌ جَرى بَينَ الحروفِ الشَوابِكِ",60,"ك",1,0],["إِذا رَكبُها الناجونَ حانَت بِجَوزِها","لَهُم وَقعَةٌ لَم يَبعَثوا لِحَيادِ",61,"د",1,0],["إِذا رَفَعَ الشَخصَ النِجادُ أَمامَها","رَمَتهُ بِعَينَي فارِكٍ طامِحِ القَلبِ",62,"ب",1,0],["إذا رميت سهام العزم صائبةً","فما رميتَ بل التوفيق راميها",63,"ي",3,0],["إذا رأيت بروق الشيب قد بسمت","بمفرقٍ فمُحيَّا العيش قد كَلَحَا",64,"ح",2,0],["إذا راح يستنجد الافرنج منتصفاً","كأنه حَمَل يستنجد الذيبا",65,"ب",2,0],["إذا رمضان جاءهم أعَدُّوا","مَطاعم ليس يُدركها انهضام",66,"م",1,0],["إذا ربّ الحسام ثَناه عَجزٌ","تدارك عجزه رب اليراع",67,"ع",1,0],["إذا رام جَزْلاً منه أنشد زاخِراً","وأن رام سَهلاً منه أنشد ساحرا",68,"ر",2,0],["إذا رُمْتُ نُصحاً جئت بالنصح واضحاً","وما كان من شأني الكلام المُعَقَّد",69,"د",1,0],["إذا رنا ناظراً يرنو بساحرة","أو انثنى ينثني عن عطف نشوان",70,"ن",1,0],["إذا رأى نهضة للمجد أقعدها","وإن رأى فتنة مشبوبةً نعرا",71,"ر",2,0],["إِذا رَكِبَت قَيسٌ خُيولاً مُغيرَةً","عَلى القَينِ يَقرَع سِنَّ خَزيانَ نادِمِ",72,"م",1,0],["إِذا رُمتَ في حَيِي خُزَيمَةَ عِزَّنا","سَما كُلُّ صَرّيفِ السَنانَينِ مُصعَبِ",73,"ب",1,0],["إِذا رَضِيَت رَضيتُ وَتَعتَريني","إِذا غَضِبَت كَهَيضاتِ السُباتِ",74,"ت",1,0],["إِذا رَفَعوا طَيَّ الخِباءِ رَأَيتَهُ","كَضارِبِ طَيرٍ في الحِبالَةِ يَلمَعُ",75,"ع",1,0],["إِذا رَحَلوا جَزِعتَ وَإِن أَقاموا","فَما يُجدي المُقامُ على الرَحيلِ",76,"ل",1,0],["إِذا رَكِبوا لَم تَرهَبِ الرَوعَ خَيلُهُم","وَلَكِن تُلاقي البَأسَ أَنّى نَسيمُها",77,"م",3,0],["إذا رجل الغراب عليَّ صُرَّتْ","ذكرتك فاطمأن بي الضميرُ",78,"ر",1,1],["إِذا رَأَينا أولى الكِرامِ بِها","يُضيعُها جاهِداً وَيُهمِلُها",79,"ل",3,0],["إذا رفعت قدري بمدحك ليلةٌ","تيقَّن قصدي أنها ليلةُ القدر",80,"ر",1,0],["إذا رمت أن تتلو على يدهِ الرَّجا","فتيسير عنوان الندى منه نشره",81,"ر",2,0],["إذا رأيت دخان النقع مرتفعاً","لمحت للسبق من أعطافه شرره",82,"ر",2,0],["إذا رويت الثناء متَّصلاً","أرويه عن مالك ابن دينار",83,"ر",1,0],["إذا رأوا حلقات الصّدغ دائرةً","فكلهم جند أشجان من الحلقه",84,"ق",2,0],["إذا ريم خير أو تعرّض حادث","روى نافع عن شيمتيك وعاصم",85,"م",1,0],["إذا رأى الدلوَ فوق الرأس أنشده","ضيفٌ ألمّ برأسي غير محتشم",86,"م",1,0],["إذا رأيت قوافيها وطلعته","فقد رأت مقلتاك البحر والنونا",87,"ن",2,0],["إذا راح في رَيَّا نَثَاه حسبتَه","هنالِك بالمسك الذَّكيِّ مُضَمَّخا",88,"خ",2,0],["إذا رجلٌ يقول وليس يَكنى","ألا ترضى تُقَبل أو تَعَضُّ",89,"ض",1,0],["إذا رأتْ فيشلةً ضخمةً","خرَّت لها قائلة حِطّه",90,"ط",2,0],["إذ