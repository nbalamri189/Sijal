رَكِبَت مِنّا بِلَيلٍ فَقُل لَها","عَلَيكِ سَلامٌ ماتَ مَن يَتَزَوَّجُ",206,"ج",1,0],["إِذا رَقَصَت في مَهمَهِ اللَيلِ ضَمَّها","إِلى نَهَجٍ مِثلِ المَجَرَّةِ لاحِبُه",207,"ب",2,0],["إِذا رَزَمَت أَنَّت وَأَنَّ لَها الصَدى","أَنينَ المَريضِ لِلمَريضِ يُجاوِبُه",207,"ب",2,0],["إِذا رَكِبوا بِالمَشرَفِيَّةِ وَالقَنا","وَأَصبَحَ مَروانٌ تُعَدُّ مَواكِبُه",207,"ب",2,0],["إِذا رَآها نِساءُ الحَيِّ قُلنَ لَها","سُبحانَ مَن صاغَها يُغرِقنَ إِطنابا",208,"ب",2,0],["إِذا رَماهُ النَقَرى بِاِمرِئٍ","لانَ لَهُ البابُ وَلَم يُحجَبِ",209,"ب",1,0],["إِذا رَجَفَت فيهِ رَحىً مُرجَحِنَّةٌ","تَبَعَّقَ ثَجّاجٌ غَزيرُ الحَوافِلِ",210,"ل",1,0],["إِذا راكِبٌ نالَت بِهِ الشَأوَ ناقَةٌ","فَما أَينُقي إِلّا الظَوالِعُ وَالحَسرى",211,"ر",2,0],["إِذا رامَ كَيداً بِالصَلاةِ مُقيمُها","فَتارِكُها عَمداً إِلى اللَهِ أَقرَبُ",212,"ب",1,0],["إِذا رَفَعَت تِلكَ المَواكِبُ قَسطَلاً","فَرافِعُهُ لِلعَينِ مُجري الكَواكِبِ",213,"ب",1,0],["إِذا رَأَيتُم كَريماً عِندَ غَيرِكُمُ","فَأَكرِموهُ عَلى يُسرٍ وَإِنضابِ",214,"ب",1,1],["إِذا رَأَيتُ الخَيرَ في رَقدَتي","عَدَدتُها لَيلَةَ مِعراجي",215,"ج",2,0],["إِذا رَجَونا قَضاءَ وَعدٍ","فَكَيفَ لا يُرهَبُ الوَعيدُ",216,"د",1,0],["إِذا رُزِقَ الفَتى في المَحلِ جَدّاً","رَعى ما شاءَ مِن ثَعدٍ وَمَعدِ",217,"د",1,0],["إِذا رَأَيتُ أُموراً لا تُوافِقُني","قُلتُ الإِيابُ إِلى الأَوطانِ أَدّى ذا",218,"ذ",2,0],["إِذا رَكِبتَ لِإِدراكِ العُلا سُفُناً","فَالبَحرُ يَحمِلُ ما لا يَحمِلُ النَهَرُ",219,"ر",1,0],["إِذا رَدَنَت فيما يَعودُ لِطِفلِها","بِنَفعٍ فَآمِرها وَرُجِّ إِمارَها",220,"ر",3,1],["إِذا رَكِبَت إِجّارَها وَرَأَيتَها","تُكَلِّمُ يَوماً في التَسَتُّرِ جارَها",221,"ر",3,1],["إِذا رَشِرَت أَكُفٌّ مِن رِجالٍ","فَما أَولى أَنامِلَهُم بِأَشرِ",222,"ر",1,0],["إِذا رُمتُهُ مَرَّةً في الزَمانِ","رَجَعتُ وَلي دونَهُ حاجِزُ",223,"ز",1,0],["إِذا رَفَعوا كَلامَهُم بِمَدحٍ","فَلَفظي في مَواطِنِهِ رَسيسُ",224,"س",1,1],["إِذا راضَ في نُسُكٍ قَلبَهُ","غَدا وَهوَ صَعبٌ كَأَن لَم يُرضَ",225,"ض",1,0],["إِذا رَشَقَت دُنياكَ هَذي إِلى الفَتى","رَمَتهُ بِنَبلٍ مِن غِوايَتِها رَشقا",226,"ق",2,1],["إِذا رُؤَساءُ الناسِ أَمّوا تَنازَعوا","كُؤوسَ الأَذى هَل في الزُجاجَةِ عِندَمُ",227,"م",1,0],["إِذا رَملَةٌ لَم تَجِئ بِالنَباتِ","فَقَد جَهِلَت إِن سَقَتها السَواني",228,"ن",2,0],["إِذا رَجَعَ الحَصيفُ إِلى حِجاهُ","تَهاوَنَ بِالمَذاهِبِ وَاِزدَراها",229,"ا",3,0],["إِذا رَجَّعَت في صَوتِها خِلتَ صَوتَها","تَجاوُبَ أَظآرٍ عَلى رُبَعٍ رَدي",230,"د",2,0],["إذا رجع الخصوم إلى التقاضي","فإن السيف أَكبرهم ذنوبا",231,"ب",2,0],["إذا رمن الوقوع عَلى بيوت","ربين بها اِنقلبن إلى الوَراء",232,"ا",2,0],["إذا رأى وشلاً حرانُ ذو ظمأٍ","فإنه لَيسَ يستَغني عَنِ الوشل",233,"ل",1,0],["إذا رمت عن دار المذلة رحلة","فسر قبل أَن تنسد في وجهك الطرق",234,"ق",1,0],["إذا رأيت نيوب اللّيث بارزةً","فلا تظنّنّ أنّ اللّيث مبتسم",235,"م",1,0],["إذا رامتكِ عاديةٌ وشقّتْ","فضاءَكِ غيلةً ورماكِ خَطبُ",236,"ب",1,0],["إذا رادَ عَيْرُ السّيْفِ منها برَوْضَةٍ","تَلَقّاهُ مِن لَحْظِ العَرادَةِ فارس",237,"س",1,0],["إذا رأيْتِ سَوادَ الليلِ فانصَلِتي","وإنْ رأيتِ بياضَ الصّبْحِ فانصاعي",238,"ع",2,0],["إِذا رَشَدَ المُعَلِّمُ كانَ موسى","وَإِن هُوَ ضَلَّ كانَ السامِرِيّا",239,"ي",2,0],["إِذا ريحُ الصَبا هَبَّت أَصيلا","شَفَت بِهُبوبِها قَلباً عَليلا",240,"ل",2,1],["إِذا رَشَقَت قَلبي سِهامٌ مِنَ الصَدِّ","وَبَدَّلَ قُربي حادِثُ الدَهرِ بِالبُعدِ",241,"د",1,1],["إِذَا رَاطَنُوا بَعْضَاً سَمِعْتَ لِصَوْتِهِمْ","عَزِيفاً كَجِنٍّ فِي الْمَفَاوِزِ هُتَّفِ",242,"ف",1,0],["إِذَا رَاعَتِ الظَّلْمَاءُ غَيْرِي فَإِنَّمَا","هِلالُ الدُّجَى قَوْسِي وَأَنْجُمُهُ نَبْلِي",243,"ي",1,0],["إِذَا رَاطَنُوا بَعْضاً سَمِعْتَ لِصَوْتِهِمْ","هَدِيداً تَكَادُ الأَرْضُ مِنْهُ تَمِيدُ",244,"د",1,0],["إِذَا رَنَتْ غَارَ مِنْها","فِي الْحَيِّ عِينٌ وَحُورُ",245,"ر",1,0],["إِذَا رُمْتَ الْبَعِيدَ فَذَاكَ دَانٍ","وَإِن فَاقَ السُّهَى وَبَدَا مُرِيبَا",246,"ب",2,0],["إِذَا رُمْنَا الوَفَاءَ بِمَا عَلَيْنَا","لَهَا أَوْ بَعْضَهُ هَلْ مِنْ سَبِيلِ",247,"ل",1,0],["إِذَا رَنَا أَلَمٌ مِنْهُ رَأَى أَمَلاً","فِي رَحْبَةِ الدَّارِ يَجْلُو رَوْضَةً أَنَفَا",248,"ف",2,0],["إِذْ أَرَّقَ الدُّجَى عُبُوسَتَهُ","وإِذِ الفجرُ هَمَّ أَوْ بَشَّا",249,"ش",2,0],["إِذا رُعِظَ السَهمُ أَو عَظعَظا","فَسَهمُ المَنيّةِ لَن يُرعَظا",250,"ظ",2,1],["إِذا راحَ لِلأُدحِيِّ أَوباً يَفُنُّها","تُحاذِرُ مِن إِدراكِهِ وَتَحيصُ",251,"ص",1,0],["إِذا رَكِبوا الخَيلَ وَاِستَلأَموا","تَحَرَّقَتِ الأَرضُ وَاليَومُ قَر",252,"ر",1,0],["إِذا رُمِيَت بِاللَحظِ مِن كُلِّ مَربَعٍ","تَلَقّاهُ عاري عَظمِها فَيُصيبُ",253,"ب",1,0],["إِذَا رَمَاهَا كمَا يَخْتَارُ قَافِيَةً","دَارتْ مَعَ الفَلَكِ الدَّوَّارِ في قُطُبِ",254,"ب",1,0],["إذا رنتِ الآمالُ كان ثِمالَها","وإنْ حارتِ الآراءُ كان لها رُشْدا",255,"د",2,0],["إِذَا رَمَتْ عُرْضَ صَهْيُودٍ مناسِمُها","رَمَتْ إِلَيْهَا اللَّيَالي كُلَّ مَقْصُودِ",256,"د",1,0],["إِذَا رَأَى كَانَ حَقا","أوْ قالَ كَانَ صَوَابا",257,"ب",2,0],["إذا رامَها فارسٌ نالَها","ويعجَزُ عن نَيلِها الرَّاجِل",258,"ل",1,0],["إذا رفعت في الكنانة بندًا","فقد رفعت في سواها بنودًا",259,"د",2,0],["إذا رمت منه ساقيا ومحدثا","فمن ثغره يلقي ومن لحظه يسقي",260,"ق",2,0],["إذا رفعت عنه الظلال رواقهاتعد","بها النينان في الطول والعمق",260,"ق",1,0],["إذا رام نهبي لم يجد ما يرومه","وإن رام موتي فالمصير إليه",261,"ي",2,0],["إذا رأوني أصاخوا في مجائمهم","كما أصاخ ابن نهيا بعد تغريد",262,"د",1,0],["إذا رَمَتْكَ بعينَيْها فَلبِّهِما","واعلَمْ بأنَّكَ مأخوذٌ فمصفود",263,"د",1,0],["إذا رُمْتُ أوصافاً تليقُ بحالةٍ","تعرَّفْتُها ضاقَتْ بطونُ المعاجم",264,"م",1,0],["إذا رَفعَ اليدَ للحاكمينَ","بدَتْ \" نَعَمٌ \" وهي في زيِّ \" لا! \"",265,"ا",1,0],["إذا رمت دفع الشك بالعلم فاختبر","بعينك ماذا تفعل الأسد الغلب",266,"ب",1,0],["إِذَا رَجَّعَ القِسِّيسُ قُلُوبُهُمْ","حَنِيناً إِلى دَيْرٍ بِحَرَّانَ آهِلِ",267,"ل",1,0],["إذا رَاوَحَتْهَا مُزْنَةٌ بَكَرَتْ لَهَا","شآبيبُ مُجْتَازٍ عَلَيْهَا، وَقَاصِدِ",268,"د",1,0],["إذا رَكِبُوا زَادُوا المَوَاكِبَ بَهجَةً،","وإنْ جَلَسُوا كانُوا بُدورَ المَجالسِ",269,"س",1,0],["إذا رجعت في صوتها خلت صوتها","تجاوب آظآرٍ على ربعٍ رد",270,"د",1,0],["إذا رَفَعُوا فِيهَا الشِّراعَ كَأنّها","قُلُوصُ نَعامٍ أوح ظَلِيمٌ شَمَرْدَلُ",271,"ل",1,0],["إذا رَأتْهُ عِتَاقُ الطّيْرِ أوْ سَمِعَتْ","مِنِ هَوِيّاً تَشَظّتْ تَبتغي الوَزَرَا",272,"ر",2,0],["إذا رشد المعلمُ خلوا وفاقوا","إلى الحرية کنساقُوا هديَّا",273,"ي",2,0]]}