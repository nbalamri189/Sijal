{"poems":[[27,"فلا خوف عليك ولن تراعي","https://www.aldiwan.net/poem5978.html","الوافر"],[72,"سلبت عقلي بأحداق وأقداح","https://www.aldiwan.net/poem18481.html","البسيط"],[70,"أكتاب من فاضل","https://www.aldiwan.net/poem43013.html","مجزوء الخفيف"],[85,"ديوان رامي تحت حاشية الصبا","https://www.aldiwan.net/poem7125.html","الكامل"],[67,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[46,"بين الغريزة والرشاد نفار","https://www.aldiwan.net/poem22580.html","الكامل"],[148,"أود بأن أرى ظبي الصحاري","https://www.aldiwan.net/poem47684.html","الوافر"],[153,"الشوكة","https://www.aldiwan.net/poem17104.html","عموديه"],[161,"انهض فطائر سعدك الميمون","https://www.aldiwan.net/poem59011.html","الكامل"],[161,"سهام مقاها فاحذروها صوائب","https://www.aldiwan.net/poem59016.html","البسيط"],[366,"لمن طلل بتيمات فجند","https://www.aldiwan.net/poem44517.html","الوافر"],[459,"بالغور ما شاء المطايا والمطر","https://www.aldiwan.net/poem56190.html","الرجز"],[506,"المُحتلّ","https://www.aldiwan.net/poem42460.html","الهزج"]],"verses":[["أَمازِنُ يا اِبنَ كَعبٍ إِنَّ قَلبي","لَكُم طولَ الحَياةِ لِغَيرُ قالي",0,"ل",2,0],["أما زمان عليّ مع شذا كلمي","فقد تجانس نفاع بنفاح",1,"ح",1,0],["أَم أَزاهِيرُ رَوضَةٍ","فَتَّقَتها يَدُ الصَبا",2,"ب",2,0],["أما زهير فقد سما هرم به","ولتسمون بشعرك الأهرام",3,"م",1,0],["أما زُلْزِلَتْ بالعادياتِ وَجاءها","مِنَ التُّرْكِ جَمٌّ لا يُعَدُّ غَفِيرُ",4,"ر",1,0],["أَمّا زَمانُكَ بِالأَنيسِ فَآهِلٌ","لَكِنَّهُ مِمّا تَوَدُّ قِفارُ",5,"ر",1,0],["أمازحه فلا يرضى مزاحاً","وأسأله المراء فلا يُماري",6,"ر",2,0],["أَمَا زِلْتُ فِي حَلْقِكُمْ شَوْكَةً","عَلَى رَغْمِ أَنْفِي، وَمَا لِيَ قَصْدُ!",7,"د",1,0],["أَمَا زِلْتُ فِي دَرْبِكُمْ شَامِخًا","يُعِيقُ مَسِيرَتَكُمْ، أَوْ يَصُدُّ؟",7,"د",1,0],["أَمَا زَالَ حُبِّي لِرَبِّي، وَطُهْرِي","عَلَى بَعْضِكُمْ خَطَرًا لاَ يُرَدُّ؟!",7,"د",1,0],["أما زبيد فكلما حدثته","عنها اليقين وغيره المظنون",8,"ن",1,0],["امازجهال ضما يريك اتحادنا","كما مزج الصهباء بالماء شارب",9,"ب",1,0],["أُمازحهم إذا ما مازحوني","ويُغضي جِدُّهم إِن جَدَّ جِدّي",10,"د",2,0],["إمَّا زعيمُ فيلقٍ يطرحهم","في لَهَواتِ الظلم حتى ينتصرْ",11,"ر",1,0],["أما زلْت على الجمرِ","وعُقب الشهر ما ولّى؟",12,"ل",2,0]]}