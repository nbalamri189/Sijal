{"poems":[[27,"فلا خوف عليك ولن تراعي","https://www.aldiwan.net/poem5978.html","الوافر"],[72,"سلبت عقلي بأحداق وأقداح","https://www.aldiwan.net/poem18481.html","البسيط"],[70,"أكتاب من فاضل","https://www.aldiwan.net/poem43013.html","مجزوء الخفيف"],[85,"ديوان رامي تحت حاشية الصبا","https://www.aldiwan.net/poem7125.html","الكامل"],[67,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[46,"بين الغريزة والرشاد نفار","https://www.aldiwan.net/poem22580.html","الكامل"],[145,"أود بأن أرى ظبي الصحاري","https://www.aldiwan.net/poem47684.html","الوافر"],[158,"انهض فطائر سعدك الميمون","https://www.aldiwan.net/poem59011.html","الكامل"],[158,"سهام مقاها فاحذروها صوائب","https://www.aldiwan.net/poem59016.html","البسيط"],[363,"لمن طلل بتيمات فجند","https://www.aldiwan.net/poem44517.html","الوافر"],[456,"بالغور ما شاء المطايا والمطر","https://www.aldiwan.net/poem56190.html","الرجز"],[503,"المُحتلّ","https://www.aldiwan.net/poem42460.html","الهزج"]],"verses":[["أَمازِنُ يا اِبنَ كَعبٍ إِنَّ قَلبي","لَكُم طولَ الحَياةِ لِغَيرُ قالي",0,"ي",1,0],["أما زمان عليّ مع شذا كلمي","فقد تجانس نفاع بنفاح",1,"ح",1,0],["أَم أَزاهِيرُ رَوضَةٍ","فَتَّقَتها يَدُ الصَبا",2,"ب",2,0],["أما زهير فقد سما هرم به","ولتسمون بشعرك الأهرام",3,"م",1,0],["أما زُلْزِلَتْ بالعادياتِ وَجاءها","مِنَ التُّرْكِ جَمٌّ لا يُعَدُّ غَفِيرُ",4,"ر",1,0],["أَمّا زَمانُكَ بِالأَنيسِ فَآهِلٌ","لَكِنَّهُ مِمّا تَوَدُّ قِفارُ",5,"ر",1,0],["أمازحه فلا يرضى مزاحاً","وأسأله المراء فلا يُماري",6,"ي",1,0],["أما زبيد فكلما حدثته","عنها اليقين وغيره المظنون",7,"ن",1,0],["امازجهال ضما يريك اتحادنا","كما مزج الصهباء بالماء شارب",8,"ب",1,0],["أُمازحهم إذا ما مازحوني","ويُغضي جِدُّهم إِن جَدَّ جِدّي",9,"د",2,0],["إمَّا زعيمُ فيلقٍ يطرحهم","في لَهَواتِ الظلم حتى ينتصرْ",10,"ر",1,0],["أما زلْت على الجمرِ","وعُقب الشهر ما ولّى؟",11,"ل",2,0]]}