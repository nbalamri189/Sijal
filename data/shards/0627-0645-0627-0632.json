{"poems":[[29,"فلا خوف عليك ولن تراعي","https://www.aldiwan.net/poem5978.html","الوافر"],[74,"سلبت عقلي بأحداق وأقداح","https://www.aldiwan.net/poem18481.html","البسيط"],[72,"أكتاب من فاضل","https://www.aldiwan.net/poem43013.html","مجزوء الخفيف"],[87,"ديوان رامي تحت حاشية الصبا","https://www.aldiwan.net/poem7125.html","الكامل"],[69,"جوارك من جور الزمان يجير","https://www.aldiwan.net/poem18067.html","الطويل"],[48,"بين الغريزة والرشاد نفار","https://www.aldiwan.net/poem22580.html","الكامل"],[151,"أود بأن أرى ظبي الصحاري","https://www.aldiwan.net/poem47684.html","الوافر"],[156,"الشوكة","https://www.aldiwan.net/poem17104.html","عموديه"],[164,"انهض فطائر سعدك الميمون","https://www.aldiwan.net/poem59011.html","الكامل"],[164,"سهام مقاها فاحذروها صوائب","https://www.aldiwan.net/poem59016.html","البسيط"],[370,"لمن طلل بتيمات فجند","https://www.aldiwan.net/poem44517.html","الوافر"],[463,"بالغور ما شاء المطايا والمطر","https://www.aldiwan.net/poem56190.html","الرجز"],[510,"المُحتلّ","https://www.aldiwan.net/poem42460.html","الهزج"],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122752","الطويل"],[857,"","https://poetry.dctabudhabi.ae/diwan/poem/73719","البسيط"],[882,"","https://poetry.dctabudhabi.ae/diwan/poem/18533","الرجز"],[3050,"","https://poetry.dctabudhabi.ae/diwan/poem/79721","المتقارب"],[5002,"يا ليل...","https://www.poetsgate.com/ViewPoem.aspx?id=210265",""],[5102,"شاعر المليون","https://www.poetsgate.com/ViewPoem.aspx?id=14630",""],[5184,"لأنك العراق","https://www.poetsgate.com/ViewPoem.aspx?id=186052",""],[5187,"حوار مع القلب","https://www.poetsgate.com/ViewPoem.aspx?id=29064",""],[5273,"أسئلة بظهر الغيب","https://www.poetsgate.com/ViewPoem.aspx?id=176796",""],[5274,"أحلام أندلسية","https://www.poetsgate.com/ViewPoem.aspx?id=207438",""],[5277,"كتابي","https://www.poetsgate.com/ViewPoem.aspx?id=191689",""],[5285,"حلم","https://www.poetsgate.com/ViewPoem.aspx?id=204397",""],[5302,"خليلي زورا","https://www.poetsgate.com/ViewPoem.aspx?id=200132",""],[5376,"مررْتُ الدارَ اسألُ عنْ صحابي","https://www.poetsgate.com/ViewPoem.aspx?id=188387",""],[5431,"إلى شامي أنا راجعْ","https://www.poetsgate.com/ViewPoem.aspx?id=183085",""],[5431,"تسألني القصيدة عن هوانا","https://www.poetsgate.com/ViewPoem.aspx?id=183091",""],[5431,"فلا تُذهبِ الأيام لهوا ومتعة","https://www.poetsgate.com/ViewPoem.aspx?id=188654",""],[5431,"أمازلتَ ياقلبي تضخّ له الحُبا","https://www.poetsgate.com/ViewPoem.aspx?id=189641",""],[5431,"إلى الجزائر الحبيبة ....","https://www.poetsgate.com/ViewPoem.aspx?id=190246",""],[5431,"ومن ياقلب يدرَؤه!","https://www.poetsgate.com/ViewPoem.aspx?id=195436",""],[5431,"إلى حضنه يهفو وفي وهجه مشى!!","https://www.poetsgate.com/ViewPoem.aspx?id=197886",""],[5431,"بكف الله ممزوجا بلوني....","https://www.poetsgate.com/ViewPoem.aspx?id=200700",""],[5431,"الى حيّ الميدان الدمشقي...","https://www.poetsgate.com/ViewPoem.aspx?id=202358",""],[5431,"الكولا وعنترة العبسي!","https://www.poetsgate.com/ViewPoem.aspx?id=215610",""],[5554,"امازيغية","https://www.poetsgate.com/ViewPoem.aspx?id=180581",""],[5718,"قدس أقصانا","https://www.poetsgate.com/ViewPoem.aspx?id=213783",""],[5861,"سراب الأحلام","https://www.poetsgate.com/ViewPoem.aspx?id=188086",""],[6102,"حَتمِيَّةُ الصِّراعِ...","https://www.poetsgate.com/ViewPoem.aspx?id=211869",""],[6152,"حبك عالمي الأروع","https://www.poetsgate.com/ViewPoem.aspx?id=204685",""],[406,"استنكار ..!","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=1118&r=&rc=62",""]],"verses":[["أَمازِنُ يا اِبنَ كَعبٍ إِنَّ قَلبي","لَكُم طولَ الحَياةِ لِغَيرُ قالي",0,"ل",2,0],["أما زمان عليّ مع شذا كلمي","فقد تجانس نفاع بنفاح",1,"ح",1,0],["أَم أَزاهِيرُ رَوضَةٍ","فَتَّقَتها يَدُ الصَبا",2,"ب",2,0],["أما زهير فقد سما هرم به","ولتسمون بشعرك الأهرام",3,"م",1,0],["أما زُلْزِلَتْ بالعادياتِ وَجاءها","مِنَ التُّرْكِ جَمٌّ لا يُعَدُّ غَفِيرُ",4,"ر",1,0],["أَمّا زَمانُكَ بِالأَنيسِ فَآهِلٌ","لَكِنَّهُ مِمّا تَوَدُّ قِفارُ",5,"ر",1,0],["أمازحه فلا يرضى مزاحاً","وأسأله المراء فلا يُماري",6,"ر",2,0],["أَمَا زِلْتُ فِي حَلْقِكُمْ شَوْكَةً","عَلَى رَغْمِ أَنْفِي، وَمَا لِيَ قَصْدُ!",7,"د",1,0],["أَمَا زِلْتُ فِي دَرْبِكُمْ شَامِخًا","يُعِيقُ مَسِيرَتَكُمْ، أَوْ يَصُدُّ؟",7,"د",1,0],["أَمَا زَالَ حُبِّي لِرَبِّي، وَطُهْرِي","عَلَى بَعْضِكُمْ خَطَرًا لاَ يُرَدُّ؟!",7,"د",1,0],["أما زبيد فكلما حدثته","عنها اليقين وغيره المظنون",8,"ن",1,0],["امازجهال ضما يريك اتحادنا","كما مزج الصهباء بالماء شارب",9,"ب",1,0],["أُمازحهم إذا ما مازحوني","ويُغضي جِدُّهم إِن جَدَّ جِدّي",10,"د",2,0],["إمَّا زعيمُ فيلقٍ يطرحهم","في لَهَواتِ الظلم حتى ينتصرْ",11,"ر",1,0],["أما زلْت على الجمرِ","وعُقب الشهر ما ولّى؟",12,"ل",2,0],["أَما زَورَةٌ يا عُلوُ في أُخرَياتِها","يُحَلُّ نِطاقٌ أو يُماطَ لِثامُ",13,"م",1,0],["أَمّا زُبَيرٌ فَقَد أَودى بِأَندَلُسٍ","ما كانَ مِن حُرمَةٍ فيها وَصِدّيقِ",14,"ق",1,1],["أَما زَعَمتَ الخَيلَ لا تَرقى الجَبَل","بَلى وَرَبّي ثَمَّ يَعلونَ القُلَل",15,"ل",1,1],["أم أزدان للعين هذا السبيل","فلم يرع للعقل حق الزمام",16,"م",1,0],["أما زِلْتَ فينا تَنْتَشِي من قَصائدٕ","وتتَّقِدُ الأشْعار ُ فيكَ لطَالِبِ",17,"ب",1,0],["أما زِلْنا نُفاخِرُ بالقبيلهْ","ولا نرقى لمفخرةٍ بديلهْ",18,"ل",2,0],["أما زالَ في بَغْدادَ صَوْتُ طُفولَتي","أما زالَ في دُكّانِ حارتِنا مَجْرى",19,"ر",2,0],["أما زالَ ثَوْبُ العيْدِ يحضنُ ضِحْكَتي","وفَرحةَ أُمِّي حينما تَنْثُرُ العِطْرا",19,"ر",2,0],["أما زالَ سَطْحُ البيْتِ يَذْكُرُ غَفْوَتي","وصَوْتَ أبي كَمْ كانَ يُوقِظُني فَجْرا",19,"ر",2,0],["أما زِلْتَ يا نَيْسانُ تَذْكُرُ وجهها","وتَذْكُرُ نَزْفاً حَوْلَ مُقْلَتِها اليُسْرى",19,"ر",2,0],["اما زِلْتَ تَسْقي الياسَميْنَ بِرِيْقِها","وتَدْفَعُ أَزْهارَ الرَّبِيْعِ لَها مَهْرا",19,"ر",2,0],["أما زالَ الحياءُ بهِ","وداءُ الخوفِ مُنزرعا",20,"ع",2,0],["أ مازالَ يذكُرُني ضَوْءُ قِرطٍ ؟","تَدَلّى وتحتَ سَناهُ انتَحَرْتُ",21,"ت",1,0],["أ مازالَ شَعْرُكِ يُسْقِطُ ليلاً؟","إذا اسَّاقَطَ الليلُ منهُ سَقَطْتُ",21,"ت",1,0],["أما زيغية ُ \" العينين لاحتْ","يفوح ُ بِهَا القُرنفل ُ والبشَام ُ",22,"م",1,0],["أما زلْتَ تقسو متى سوفَ تَحْنو","وكنتَ ودوداً طويلَ الأناةْ",23,"ا",2,0],["أ مازلتَ تهوى سنينَ العذابِ","وذاكَ العذابُ حصادُ السنينْ ؟!",24,"ن",1,0],["أما زلت مفتونا وفي القلب جذوة","وفي النفس شيء نحوه المبتلى هبا",25,"ب",2,0],["أما زلت من يحنو إذا مر ذكرها","أم القلب في يأس يقول لها تبا",25,"ب",2,0],["اما زالتْ قوافينا تغنِّي","على الاوطانِ ام مالتْ خطوبُ",26,"ب",1,0],["أما زفت لنا البشرى؟","ومااﻷسباب؟ ماالمانعْ؟",27,"ع",1,0],["أما زالَت بعينك نور حبٍّ","فترقص شعلةٌ ترنو رضانا",28,"ن",2,0],["أما زالت قلوبٌ ترتجينا","لندفئها ونغدقها الحنانا",28,"ن",2,0],["أمازال النقاء يموج سحراً","فأحيا فيك عمريَ والجنانا",28,"ن",2,0],["أما زلت نبضا للهوى في فؤاديا","لتشدو لك الأسحار مني القوافيا",29,"ي",2,1],["أمازلتَ ياقلبي تضخّ له الحُبا","فينقرُ أشعاري كما ينقرُ الحَبا",30,"ب",2,1],["أمازيغُ في درب الحياة حبائب","سويا سنبنيها وتحلو المشارب",31,"ب",1,1],["أمازيغ من نور وحب ورفعة","وقلبٌ مع العرْب الكرام محاربُ",31,"ب",1,0],["أمازيغ في قلبي كوشم مؤبد","ومهما سعت في نزف قلبي الثعالب",31,"ب",1,0],["أمازيغ من طهر ومزن عطاؤهم","على درب أشواق العروبة راغب",31,"ب",1,0],["أما زالت شغاف الرو","ح طفل الروح تقرؤه",32,"ا",2,0],["أما زلتَ تحبو في العروقِ وفي الحشا","وقطرُ الندى من ورد عينيك أجهشا",33,"ش",2,1],["أما زلتَ سرّ الشمس مفتاح نورها","تحيك بهدب الشمس قلبي مزركشا",33,"ش",2,0],["أ مازالت تُراقصني مساءً؟!","بضوء البدر من أجلي تُغنّي!؟",34,"ن",2,0],["أمازلت ياحيّ الأحبة حانيا","أما زال من ملح التكيّات طهرُه",35,"ر",2,0],["أمازلت في خصر المحيط تثرثر","وترسم ردفيها سفينا وتبحر؟",36,"ر",1,1],["امازيغيةُ الاشْواقِ مُمطِرةٌ","اذا انهَمَرتْ فلاتُبقي ولا تذِرُ",37,"ر",1,1],["أَمَا زُرِعَتْ حَدَائِقُهُمْ خَرَابًا","ودُكَّ الحِصْنُ وانْسَدَلَ السِّتَارُ؟",38,"ر",1,0],["أما زالَ حبّي في فؤادِكَ ماكثٌ","ترى أم لأوهامي غدوت أنيبُ؟",39,"ب",1,0],["أَما زِلتَ فِي الكُوَّةِ القاتِمَةْ؟","تُفَتِّشُ عَن فِكرَةٍ حالِمَةْ!",40,"م",2,1],["أما زورت في نفسي","بأني فيك لن أخنع",41,"ع",1,0],["َأما زِلتِ تستصغرينَ الأسى","بقلبي وتنسينَ آثارَهُ ؟",42,"ر",2,1]]}