at=shqas&qid=87027&r=&rc=13",""],[5393,"في حفل زفاف شاب مسلم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=84724&r=&rc=2",""],[5075,"موتوا لأجل القدس","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82754&r=&rc=0",""],[6251,"مجرات النجوم","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=76487&r=&rc=27",""],[5561,"قل لي من تكون ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=86133&r=&rc=1",""],[6261,"الحصار","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82136&r=&rc=8",""],[6294,"هل لامسّت معطفها ! ! !","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=69183&r=&rc=24",""],[6341,"من أي السماء؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=87278&r=&rc=7",""]],"verses":[["قُل لي بِأَيِّ خِلالِ سَروِكَ","قَبلُ أُفتَنُ أَو أَهيم",0,"م",1,0],["قُل لِيِحيى اِبنِ أَكثَمِ","إِنَّ ما خِفتَ قَد وَقَع",1,"ع",1,0],["قل لي ما مبهم جلي","وفيه للواصفين خلف",2,"ف",1,0],["قل ليراع الإمام شيخ الشيوخ الو","قت ماحي الإعسار والحيف",3,"ف",1,1],["قُلْ لي وقد أيْقَنْتَ أَنِّي عارف","بالحقِّ مُعْطىً في البَلاَغةِ مَنْدَحَا",4,"ح",2,0],["قل لي بأية حيلة أعملْتَها","هتفوا بأنك لا حُفِظْتَ جوادُ",5,"د",1,0],["قل لي بأية حيلةٍ أعملتها","هتفوا بأنك ماجدٌ غَمْرُ الندى",6,"د",2,0],["قل ليَ لِمْ لَمْ تَتِهْ بمعرفة ال","حقّ وإحكامِ نفسِك الحِكَما",7,"م",2,0],["قُل لي وَحَدِّثني فَما","ذا مَوضِعُ الكِتمانِ مِنّي",8,"ن",2,0],["قُل لي فَإِنّي كَئيبٌ","مُفَكِّرٌ مُحتارُ",9,"ر",1,0],["قُل لي نُصَيرُ وَأَنتَ بَرٌّ صادِقٌ","أَحَمَلتَ إِنساناً عَلَيكَ ثَقيلا",10,"ل",2,0],["قُل لي بِسابِقَةِ الوِدادِ أَقاتِلٌ","هُوَ حينَ يَنزِلُ بِالفَتى أَم شافي",11,"ف",2,0],["قُل لي بِعَيشِكَ أَينَ أَن","تَ وَأَينَ صاحِبُكَ الكَبير",12,"ر",1,0],["قُل لي أَحينَ بَدا الثَرى","لَكَ هَل جَزِعتَ عَلى العَرين",13,"ن",1,0],["قُل لي بحُرمَةِ من ضيَّعتَ حُرمَتَهُ","أكان قدرَكَ ذا أم كان مقداري",14,"ر",2,0],["قُل لي إِذا قُمتَ عَلى أَربَعٍ","مُحَيِّياً في ذَلِكَ الشانِ",15,"ن",1,1],["قُل لي لِمَن أَصبَحتَ تَجمَعُ ما أَرى","أَلِبَعلِ عِرسِكَ لا أَبا لَكَ تَجمَعُ",16,"ع",1,0],["قل لي أهذا الطَلُّ دمعٌ حائرٌ","يروي الربيعَ النَضرَ من أشجانِه",17,"ن",2,0],["قل لي وأنتَ خزانةٌ","في طيِّها الغيبُ استتر",18,"ر",1,0],["قُل لي أَهَذا حَسَنٌ بِاللَيلِ","وَيلِيَ مِمّا تَشتَهي وَعَولي",19,"ي",1,0],["قل لي مَتى الإنسان يفرخ روعه","وَالقلب يهدأ والعيون تنام",20,"م",1,0],["قل لي أمن ملَكوتِ الروح منطلقٌ","أم طائرٌ أنت في الآفاقِ هيمان",21,"ن",1,0],["قل لي بحقِّ الموتِ ما يفعلُ","بالشاعرِ الموتُ وهذي القبورْ",22,"ر",1,0],["قُل لي إِنَّ النَهارَ لَيلٌ","أَينَ سَنى وَجهِكَ الأَنيقِ",23,"ق",1,0],["قل لي: أَأَنت لِيْعربٍ","أم أنت من أصل يَهُودي؟",24,"د",2,0],["قل لي -بربِّك-: كهل أنت، أم هرم","أم لا تزال غلامًا بالغَ الحلُم؟",25,"م",1,0],["قُلْ لي فَدَيْتُكَ يا سمعي ويا بصري","لِمْ ذا اللجاجة في بُعدي وإقصائي",26,"ا",3,0],["قل لي - ولو كذباً- كلاماً ناعما ً","قد كاد يقتلني بك التمثال",27,"ل",1,1],["((قل لي اقرأت مقالاتي ))","في أنقى ساعات الإمعان",28,"ن",1,0],["قل لي بحقك وانصف","أذاك حال الموله",29,"ل",2,0],["قل لي فدتك نفسي","كيف مزاج الشمس",30,"س",1,0],["قل لي بعيشك هل رأيتَ منعماً","عمّ الشقاءُ فليس ثَمَ منعّمُ",31,"م",1,0],["قُلْ لي مَقالاً واعْتَمِدْ صِدْقَهُ","لأَيِّ شَيءٍ قُتِلَتْ نَفْسي",32,"س",2,0],["قُل لِي أَمَلكٌ أَنتَ أَم مَلكٌ فَمَن","نَظَرَ العُجابَ فَحَقُّهُ أَن يَسأَلا",33,"ل",2,0],["قُل لي مَتى العذراءُ تَرضى","وَلبانةُ المُشتاقِ تُقضى",34,"ض",2,1],["قُل لي فإني مذ عشقتُكَ سيدي","قد ظَلتُ في شَرَك الهوى محبوسا",35,"س",2,0],["قل لي بألسِنَة التَّنَف","فُسُ كيف أنت وكيف حالُكْ",36,"ك",1,1],["قُل لي وَدَع عَنكَ المَعا","ذيرَ الرَكيكَةَ وَالحُجَج",37,"ج",1,0],["قُلْ لِي وَطرْطوركَ هذَا الّذي","في غَايةِ الحُسنِ شَوابيرهُ",38,"ه",1,1],["قُل لي بتربةِ خالدٍ هل وقعةٌ","في ميسلونَ كوقعةِ اليرموك",39,"ك",1,0],["قُل لي أقرَّحتَ الجفونَ تسهُّداً","وضرَبتَ قلباً في الهوى يتلَّهب",40,"ب",1,0],["قُل لي أسامَرتَ الكواكبَ هاجساً","ودَعوتَ أشباحاً تئنُّ وتهرب",40,"ب",1,0],["قُل لي أسرتَ عن الجمالِ مفتِّشاً","فرأيتَ في سوقٍ بغيّاً ترقُب",40,"ب",1,0],["قُل لي أسرتَ مع الرِّفاقِ لنزهةٍ","وغدوتَ تلهو في الرياض وتلعب",40,"ب",1,0],["قُل لي بعيشِكَ هَل تناثرَ درُّها","من عَينها أو عقدِها أو ثغرها",41,"ر",3,0],["قُلْ لِي لأَي فَضِيلَةٍ لَمْ تُبْكِنِي","إِنْ كانَ قَلْبِي ما بَكاكَ وَمَدْمَعِي",42,"ي",1,0],["قُل لي أَهَذا الَّذي تَسطو بِهِ قَلَمٌ","بِهِ المَفاتِحُ لِلأَرزاقِ أَم عَلَمُ",43,"م",1,0],["قل لي بربك ما وراء","الموت ما تحت التراب",44,"ب",1,0],["قلْ لي بربِّكَ سِحرُ شِع","رِك وَحيُه أنىّ يكون؟",45,"ن",1,0],["قل لي ما شيءٌ غدا قلبه","معذباً بالبيض والسمر",46,"ر",1,1],["قل لي بمن هذا العتا","وذا التصابي والذهول",47,"ل",1,0],["قُل لي سَميَّ أَمير المُؤمنين لما","حَجبت عَنّا عَطاء اللَه يا أَملي",48,"ي",1,1],["قُل لي بِأَية سَنَة","الحُب عار أَم بِأَيّ",49,"ي",1,0],["قُل لي ومَنزلُكَ الذي","مازالَ يَصلُحُ للنِّزالَه",50,"ل",2,0],["قل لي فأيكما يُهنى دلني","فلقد ضللتُ عن الطريق الأرشدِ",51,"د",1,0],["قل لي فأصنعَ ما تريد فإنني","في اللَهِ خيرُ مبشِّرٍ ومناد",52,"د",1,0],["قل ليس تدنو العدا من ربع مقبرةٍ","أنى يجوز اجتماع القدس والطمث",53,"ث",1,0],["قل لي بربكَ من تخاطبُ ، إنَّني","لأرى خِطابَ الغافلينَ خَسارا",54,"ر",2,0],["قُلْ لي عَن الأحباب هَل عهدي على","عَهْدي وهل ميثاقيَ الميثاقُ",55,"ق",1,0],["قل لي فأي عصابة يرجى بها","نصر الهدى ونكاية الألفاف",56,"ف",1,0],["قل لي أطَرْدُك لي بذا ال","إعراضِ عنّي أمْ طِرادُك",57,"ك",1,0],["قل لي، ومعذرة ، من أي مبهمة","أعصابك الصم قدت أيها الرجل؟!",58,"ل",1,0],["قُلْ لي إذ َنْ سَيِّدي..هل أنتَ مَيِّتُهُم","أم الَّذينَ تُوُفُّوا أهلُكَ النُّجُبُ؟!",59,"ب",1,0],["قل لي تناسيت أم أنسيت الفتنا","أيام رأيك فينا غير ذا الرائي",60,"ا",3,0],["قل لي متى لقيتك ظبية حاجر","تختال بين محاجر وعقود",61,"د",1,0],["قل لي فداك الأكرمون ولا غدت","طير المنى إلا ببابك وكفا",62,"ف",2,0],["قل لي بهمتك الشري","فة أين حسن الاهتمام",63,"م",1,0],["قل ليس مني كل من هو شارب","مني فإني فاتنٌ نصّاح",64,"ح",1,0],["قل لي فهل تدفع هذا أيضا","أم لا ترى هذا عليك نقضا",65,"ض",2,0],["قل لي ولو كانت كما زعمتا","بينهم شورى كما ذكرتا",65,"ت",2,0],["قلْ لي فما معنى قعو","دِك عندنا ضيَّقت قُمْ قُمْ",66,"م",1,0],["قُلْ لِي بِعَيْشِكَ هَلْ عَلى هَذا الجَفَا","تَبْقَى قُلُوبٌ أَوْ تَدُومُ عُقولُ",67,"ل",1,1],["قل لي بربك أي فائدة من ال","آثار شادته