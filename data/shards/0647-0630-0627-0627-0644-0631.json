{"poems":[[95,"هذا الرثاء الذي تمليه أشجاني","https://www.aldiwan.net/poem11189.html","البسيط"],[47,"يشكو إليك هواك المدنف الوصب","https://www.aldiwan.net/poem11494.html","البسيط"],[99,"جلست يوما حين حل المساء","https://www.aldiwan.net/poem24794.html","السريع"],[78,"قل ما بدا لك وافعل","https://www.aldiwan.net/poem39011.html","مجزوء الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39640","الكامل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39681","البسيط"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39593","البسيط"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/55303","الكامل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54772","البسيط"],[108,"شيخ القضاة","https://www.poetsgate.com/ViewPoem.aspx?id=179683",""],[111,"غوث الوجود اغثني ضاق مصطبري","https://www.poetsgate.com/ViewPoem.aspx?id=517",""],[92,"بم أستهل","https://www.poetsgate.com/ViewPoem.aspx?id=179014",""],[92,"سيصدني وأصده","https://www.poetsgate.com/ViewPoem.aspx?id=179085",""],[98,"النّهر الظّامئ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=66381&r=&rc=57",""],[119,"هذا الرفاعي الذي ظهرت له","https://www.aldiwan.net/poem40636.html","عموديه"],[130,"هذا الربيع بنور الحسن وافانا","https://www.aldiwan.net/poem805.html",""],[189,"هذا الربيع أتى بأحسن منظر","https://www.aldiwan.net/poem14517.html","الكامل"],[189,"هذا الربيع وهذه أنواره","https://www.aldiwan.net/poem14548.html","الكامل"],[208,"إقبال عام بشكر الخير مقبول","https://www.aldiwan.net/poem53187.html","البسيط"],[242,"هذا هلال المغرب","https://www.aldiwan.net/poem18051.html","الوافر"],[275,"يا دار أزهر حولك الورد","https://www.aldiwan.net/poem35667.html","أحذ الكامل"],[443,"نصر من الله وافانا به الخبر","https://www.aldiwan.net/poem2611.html","البسيط"],[458,"طرفت فلما أغرورقت عيني","https://www.aldiwan.net/poem61681.html","أحذ الكامل"],[500,"راض كلا أو ساخط كالراضي","https://www.aldiwan.net/poem10225.html","الكامل"],[505,"عرج بعيس القوم يا حاديها","https://www.aldiwan.net/poem37637.html","الكامل"],[505,"ها أين يا ريح الصبا","https://www.aldiwan.net/poem38086.html","مجزوء الرجز"],[520,"هذي مناجاة عبد رق حاسده","https://www.aldiwan.net/poem12097.html","البسيط"],[835,"","https://poetry.dctabudhabi.ae/diwan/poem/122374","الرجز"],[451,"","https://poetry.dctabudhabi.ae/diwan/poem/62496","الكامل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59422","البسيط"],[1143,"","https://poetry.dctabudhabi.ae/diwan/poem/126149","الكامل"],[1246,"","https://poetry.dctabudhabi.ae/diwan/poem/136228","الكامل"],[1260,"","https://poetry.dctabudhabi.ae/diwan/poem/56630","الكامل"],[1310,"","https://poetry.dctabudhabi.ae/diwan/poem/74012","الكامل"],[1475,"","https://poetry.dctabudhabi.ae/diwan/poem/133869","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48994","الكامل"],[1547,"","https://poetry.dctabudhabi.ae/diwan/poem/12034","الدوبيت"],[1716,"","https://poetry.dctabudhabi.ae/diwan/poem/101906","الكامل"],[1753,"","https://poetry.dctabudhabi.ae/diwan/poem/105848","السريع"],[1908,"","https://poetry.dctabudhabi.ae/diwan/poem/199763","الكامل"],[2108,"","https://poetry.dctabudhabi.ae/diwan/poem/113737","الكامل"],[2248,"","https://poetry.dctabudhabi.ae/diwan/poem/77209","الكامل"],[2743,"","https://poetry.dctabudhabi.ae/diwan/poem/141192","الكامل"],[2815,"","https://poetry.dctabudhabi.ae/diwan/poem/105738","الكامل"],[2999,"","https://poetry.dctabudhabi.ae/diwan/poem/147344","البسيط"],[3464,"","https://poetry.dctabudhabi.ae/diwan/poem/89370","الكامل"],[3686,"","https://poetry.dctabudhabi.ae/diwan/poem/131985","الكامل"],[3702,"","https://poetry.dctabudhabi.ae/diwan/poem/91073","البسيط"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216829","الكامل"],[3710,"","https://poetry.dctabudhabi.ae/diwan/poem/216573","البسيط"],[3948,"","https://poetry.dctabudhabi.ae/diwan/poem/69898","الوافر"],[4062,"","https://poetry.dctabudhabi.ae/diwan/poem/119665","البسيط"],[4223,"","https://poetry.dctabudhabi.ae/diwan/poem/45035","الكامل"],[4411,"","https://poetry.dctabudhabi.ae/diwan/poem/146754","الكامل"],[4717,"هي القصيدة","https://www.poetsgate.com/ViewPoem.aspx?id=203988",""],[4733,"عُمُرُ الجمر(رجَزية)","https://www.poetsgate.com/ViewPoem.aspx?id=199978",""],[4755,"وسَأَلْتُهَا: ولِمَن كِتَابَتُهُ ؟","https://www.poetsgate.com/ViewPoem.aspx?id=184804",""],[4908,"لا تعذلوه","https://www.poetsgate.com/ViewPoem.aspx?id=207388",""],[5009,"قوة","https://www.poetsgate.com/ViewPoem.aspx?id=67997",""],[5106,"يَا مِسْكَةَ العَرَبِ ..","https://www.poetsgate.com/ViewPoem.aspx?id=154846",""],[5121,"عِيِدُ الرَّيَاحِيِنِ","https://www.poetsgate.com/ViewPoem.aspx?id=117934",""],[5121,"لُؤْلُؤَة","https://www.poetsgate.com/ViewPoem.aspx?id=215867",""],[5145,"هذا الربيع وهذه أزهاره","https://www.poetsgate.com/ViewPoem.aspx?id=108102",""],[5150,"عاد الربيع ...!","https://www.poetsgate.com/ViewPoem.aspx?id=203766",""],[5216,"أحزانُ أمَّتِنا","https://www.poetsgate.com/ViewPoem.aspx?id=186987",""],[5277,"الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=186873",""],[5411,"القَصيدةُ المحَمدية","https://www.poetsgate.com/ViewPoem.aspx?id=186387",""],[243,"حقائق كالخيال","https://www.poetsgate.com/ViewPoem.aspx?id=50559",""],[5644,"عبق الصباح","https://www.poetsgate.com/ViewPoem.aspx?id=198556",""],[5652,"يوم الرفاقه لوحت لي على الكمْ","https://www.poetsgate.com/ViewPoem.aspx?id=190142",""],[5829,"العبد التائب","https://www.poetsgate.com/ViewPoem.aspx?id=148784",""],[5829,"شدو المستهام في مدح خير الأنام","https://www.poetsgate.com/ViewPoem.aspx?id=155538",""],[5829,"كان الجلاء","https://www.poetsgate.com/ViewPoem.aspx?id=162006",""],[5829,"ذكره العطر","https://www.poetsgate.com/ViewPoem.aspx?id=213703",""],[5887,"يا طائر الدوح","https://www.poetsgate.com/ViewPoem.aspx?id=35290",""],[5977,"أخبرته من أول لقاء","https://www.poetsgate.com/ViewPoem.aspx?id=213282",""]],"verses":[["هَذَا الرِّثَاءُ الَّذِي تُمْلِيهِ أَشْجَانِي","أَخُطُّهُ وَدُمُوعِي مِلْءُ أَجْفَانِي",0,"ن",2,1],["هَذا الرَبيعُ يُسَدّي مِن زَخارِفِهِ","وَشياً يَكادُ عَلى الأَلحاظِ يَلتَهِبُ",1,"ب",1,0],["هذا الردى الجاري اختراع الرجل","هل بعد صنع الموت شيءٌ يُرام",2,"م",1,0],["هذا الرَّبيعُ فحيِّهِ","وانزلْ بأكرمِ منزِلِ",3,"ل",1,0],["هذا الرحيقُ فأين كأسُ الشاعِرِ","قد أوحشَ الأحبابَ ليلُ السامرِ",4,"ر",1,1],["هذا الربيع الجميل يجلو","فنون إبداعه الرفيعَه",5,"ع",2,0],["هذا الرفاتُ تراثُ المجدِ في وطنٍ","لواؤه عن ركازِ المجدِ لم يَمِلِ",6,"ل",1,0],["هَذَا الرَّئِيسُ وَمِثْلُهُ","فِي النَّاسِ يَعْظُمُ مَنْ عَظُمْ",7,"م",1,0],["هَذَا الرَّبِيعُ أَتَتْ وَفْقاً بَشَائِرُهُ","بِمَا تَقَرُّ بِهِ الأبْصَارُ إِذْ يَفِدُ",8,"د",1,0],["هذا الرُّفاتُ سجلُّ أكبرِ ثورةٍ","بالله، لا تطووهُ عن قرَّائه",9,"ا",3,0],["هذا الرجاء حبيب الله منبسط","فابسط يمينك بالحسنى إلى ضروري",10,"ر",2,0],["هذا الربيع – وأنت من أزهاره -","يَبكيك طيبَ أريجه وهوائه",11,"ا",3,0],["هذا الربيع لكم ، ولي","حرُّ العراق وبرده",12,"د",2,0],["هذا الرّفات تراث المجد في وطن","لواؤه عن زكاز المجد لم يمل",13,"ل",1,0],["هذا الرفاعي الذي ظهرت له","آيات سر للقيامة تنجلي",14,"ل",2,1],["هذا الربيع بنور الحسن وافانا","وقد كسا الأرض بالأزهار ألوانا",15,"ن",2,1],["هذا الربيعُ أتى بأحسنِ منظرِ","يختالُ بين مُدَبَّجٍ ومُعَصْفَرِ",16,"ر",1,1],["هذا الربيعُ وهذه أَنْوارُهُ","طاب الزمانُ وأورقَتْ أشجارُهُ",17,"ه",1,1],["هذا الربيع من الجنّات مُستَرَقٌّ","ففيه منهنَّ تَميِيلٌ وتمثيلُ",18,"ل",1,0],["هذا الرِّضَى إِدْرِيسُ نَجْ","لُ الكامِلِالمُهَذَّبِ",19,"ب",1,0],["هذا الربيعُ يلوحُ زخرفُهُ","فاليوم لا غيمٌ ولا رعدُ",20,"د",1,0],["هذا الرجاء الذي كنا نؤمله","قد وفيت لك في تيسيره النزر",21,"ر",1,0],["هذا الربيعُ السمحُ واكفهُ","دمعي ودمعُ البؤسِ في وطني",22,"ن",2,0],["هذا الرئيس وهذه آثاره","وسنا المكارم ظاهر الايماض",23,"ض",1,0],["هذا الرفاعي الكبير وهذه","آياته بوركت يا تاليها",24,"ي",3,0],["هذا الرَّبيعُ أَنِقاً","طمَّ النَّواحِي ذَهَبَا",25,"ب",2,0],["هذا الرديني لاهتز عامله","حتى يقوم بالتثقيف مائده",26,"د",2,0],["هذا الربيع مقبل","يصحب آل برمك",27,"ك",1,0],["هذا الرسول بعثتُه","لجنابكم متبيِّنا",28,"ن",2,0],["هذا الرسول الحبيب المصطفى كرما","من صاغه الله من نور وسواه",29,"ا",2,0],["هذا الرياء بعينه","هذا النفاق المغضب",30,"ب",1,0],["هذا الرياض وهذه انهاره","تجري فيشرب عذبها عماره",31,"ر",2,1],["هذا الربيع وأنت روضته","فتآلفا فكلاكما خضل",32,"ل",1,0],["هذا الربيع وإنه","عمر الفتى وزمانه",33,"ن",2,1],["هذا الرقيع بعينه","لي في رقاعته علامه",34,"م",2,0],["هذا الربيعُ لذا الزمانِ شبابُهُ","فيه تزولُ عن المَلا الادواء",35,"ا",2,0],["هَذا الرَيحانُ ثُمَّ هَذا الوَرد","ما قَطُّ جَنَيتُهُ وَلِلَّهِ الحَمِد",36,"د",1,0],["هذا الربيع بعنفوان شبابه","يختال كالحسناء في جلبابه",37,"ب",2,1],["هذا الرِبا واللَه في وَحيهِ","المُنزلِ قد حَرَّم فِعل الرِبا",38,"ب",2,0],["هذا الرئيس أبو عليّ فالْقهُ","وانظر فما أخباره كعيانهِ",39,"ن",2,1],["هذا الرسول الطاهرُ الأخلاقِ","والأعلاقِ والأعراقِ وهو الأطهَرُ",40,"ر",1,0],["هَذا الرَبيعُ أَتى لِيُصلِحَ بَينَنا","وَبِراحَتَيهِ بَنَفسجٌ وَقُرُنفُلُ",41,"ل",1,0],["هذا الربيع اذ أتى","يا شيخ قل حتى متى",42,"ا",1,0],["هذا الرحيل وأمرُنا ما قد ترى","فمتى تَوؤبُ الى الصِغار وترجعُ",43,"ع",1,0],["هَذَا الرَّحِيقُ غَمَامٌ مِنْ عُصَارَتِهِ","يُطَوِّقُ النُّورَ فِي ثَوْبٍ مِنَ التَّرَفِ",44,"ف",1,0],["هذا الربيع طبيب دائك فانتعش","أو أنت عش قد ماتت الأحزان",45,"ن",1,0],["هذا الربيع أتاك في خيلائه","فاستقبل البشرى بيوم لقائه",46,"ا",3,1],["هذا الرَسول الَّذي أَرجو شفاعتَه","إِذا بَدَت سيئاتٌ سوّدت كتبي",47,"ب",2,0],["هذا الربيع فإن نبا بك روضه","فالروض موطن وحشة وموات",48,"ت",1,0],["هذا الربيع تجلى في مواكبه","وهكذا الدهر آن بعدها آن",49,"ن",1,0],["هَذا الرَئيس الَّذي ضاءَت منارتهُ","بالعلمِ وَالطَهرِ والانذارِ وَالسهرِ",50,"ر",1,0],["هذا الرسول الذي كانت رسالته","مقرونة باسمه في سابق الأزل",51,"ل",1,0],["هذا الرسول الذي كانت تظلّله","غمامة من هجير الشمس لم تزل",51,"ل",1,0],["هذا الرؤوف بنا هذا الرفيق بنا","هذا الودود لنا مذ كان لم يزل",51,"ل",1,0],["هذا الرسول الذي آياته ظهرت","كالشمس في هامة الجوزاء والحمل",51,"ل",1,0],["هَذا الرياحي قُطبُ دارَة قُطرَنا","مَن فاقَ جلَّتهُ الكِرامُ عُموما",52,"م",2,0],["هذا الربيع وأنت أكرم مجتنى","منه وأعجبه إلى المرتاد",53,"د",1,0],["هذا الرقيقُ (بلالٌ) في مكابدةٍ","فَمُرْ (أُميَّةَ) يُلْقِ السوْطَ يا (هُبلُ)",54,"ل",1,0],["هذا الرَّبيعُ قد أتى مُلتهِبا","وربَّما شتاؤُنا لن يُمطِرا",55,"ر",2,0],["هذا الرَّمَادُ أنا شَرَارَتُهُ","هذا الطَّحِينُ أنا سَحَابَتُهُ",56,"ت",2,0],["هذا الرّبيعُ أتى يغازل حلمَنا","عطرُ الجمالِ بجوِّنا رقْرَاقُ",57,"ق",1,0],["هذا الرقيق تراه عند الروع في قلب الأسود","متبسماً والدهر غضبان يزمجر بالوعيد",58,"د",1,1],["هَذَاْ الرَّحِيْقُ بِقَلْبِ الْأَرْضِ فِيْ تَرَفٍ","أَرْكَاْنُهُ ارْتَفَعَتْ مِنْ عَقْلِهِ الْأَرِبِ",59,"ب",1,0],["هَذَا الرَّحِيِقُ الَّذِي يَجْرِي بِمُفْرَدَتِي","عُصَارَةٌ جَمَعَتْ أَزْهَارَ سَاقِيِنِي",60,"ن",2,0],["هَذَا الرَّحِيِلُ الَّذِي يَجْتَازُ أَزْمِنَتِي","مَسَافَةٌ فِي دَمِ الأَشْوَاقِ لَمْ تَضِقِ",61,"ق",1,0],["هذا الربيع وهذه أزهاره","وافى سواءً ليله ونهاره",62,"ر",2,1],["هذا الربيعُ فتى آذارَ رائدُهُ","في القلبِ يحيى وبالعلياءِ يلتحقُ",63,"ق",1,0],["هذا الرَّشيدُ وهذا حدُّ دولَتِهِ","جريُ السَّحابِ على الوِديانِ والقِمَمِ",64,"م",1,0],["هذا الربيعُ بديعُهُ لمْ يأتِنا","إلَّا بوجهٍ في الدجى يتهلَّلُ",65,"ل",1,0],["هذا الرَّسول وَقدْ أَنْجَى بِملَّته","والشِّرْك يُوْرد أوْزارا بأوْزارِ",66,"ر",1,0],["هذا الربيع الذي تهدي شقائقه","ريح المنايا إلى قلبي بريّاها",67,"ا",1,0],["هذا الربيعُ أزاحَ بردَ شِتائِنا","واسْتَبدَلَتْ أعمَارُنا الأوراقَا",68,"ق",2,0],["هذا الرفيق وفعل غيره فلا همْ","يطيب ف الشدات والغير لاجي ..!!",69,"ج",2,0],["هذا الرسولُ فيا طوبى لمادحِه ِ","ترقى مقالته ُ أو تبلغَ الأفقا",70,"ق",2,0],["هذا الرسول فيا بقاع تشرّفي","واستبشري , فعطاؤه ممدود",71,"د",1,0],["هذا الرخاء الذي جاؤوا ببدعته","بل صدعونا به جور وإجرام",72,"م",1,0],["هذا الرسول فهل صليتَ فانتعشت","منكَ الجوارحٌ وانسالَتْ لك العِبرُ",73,"ر",1,0],["هذا الرسول بجنح الليل شرفني","على البراق يغذ السير في طلبي",74,"ب",2,0],["هذا الرفيق وإن بدت لي زلةٌ","سأسير دوماً ممسكاً كفيهِ",75,"ي",2,0]]}