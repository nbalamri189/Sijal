{"poems":[[47,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[85,"عش للخلافة ترضاها وترضيها","https://www.aldiwan.net/poem7528.html","البسيط"],[67,"ما أكلنا في ذا الصيام كنافه","https://www.aldiwan.net/poem18075.html","الخفيف"],[46,"عيشي مؤد إلى الضراء والوهن","https://www.aldiwan.net/poem23512.html","البسيط"],[106,"موظف بلا مأوى","https://www.poetsgate.com/ViewPoem.aspx?id=179766",""],[106,"في ذكرى الكواكبي","https://www.poetsgate.com/ViewPoem.aspx?id=179601",""],[90,"في طهران","https://www.poetsgate.com/ViewPoem.aspx?id=179053",""],[116,"يا آل أحمد كم لكم من مدحةٍ","https://www.aldiwan.net/poem41801.html","الكامل"],[125,"ليلاي ليلاي إن الدهر أشقانا","https://www.aldiwan.net/poem23775.html","البسيط"],[236,"جادك الواكف الهتن","https://www.aldiwan.net/poem31739.html","مجزوء الخفيف"],[298,"تفديك لو قبل المنون فداها","https://www.aldiwan.net/poem33083.html","الكامل"],[306,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[306,"خطب عيون الدين منه ثجوجه","https://www.aldiwan.net/poem56586.html","الكامل"],[403,"لكم آل الرسول جعلت ودي","https://www.aldiwan.net/poem46969.html","المديد"],[406,"أنا ضيفك المكدود بالأسفار","https://www.aldiwan.net/poem49561.html","الكامل"],[459,"ظل المنى واسع والشمل ملتئم","https://www.aldiwan.net/poem55869.html","البسيط"],[466,"قدمت وعفوك عن مقدمي","https://www.aldiwan.net/poem59035.html","عموديه"],[501,"من زار منقطع العلائق حيشا","https://www.aldiwan.net/poem37990.html","الكامل"],[552,"بالله يا أيام يثرب عودي","https://www.aldiwan.net/poem47844.html","الكامل"],[552,"ما ضر طيفك لو والى زياراتي","https://www.aldiwan.net/poem48030.html","البسيط"],[588,"أتعرف نظماً فيك منى مسراً","https://www.aldiwan.net/poem11501.html","عموديه"]],"verses":[["أُناضِلُ عَن أَحسابِ قَومي بِفَضلِهِ","وَأَفخَرُ حَتّى لا أَرى مَن يُفاخِرُ",0,"ر",1,0],["إن أضحك الملا المفتون حاضرها","ابكى الاجنة في الارحام آتيها",1,"ي",3,0],["أنا ضَيفٌ لَهُ وَقد مُتُّ جوعاً","لَيتَ شِعْرِي لِمْ لا تُعدُّ الضِّيافَه",2,"ف",2,0],["إِنّا ضُيوفُ زَمانٍ ما قِراهُ لَنا","إِلّا المَنايا وَنَحنُ الآنَ في اللُهَن",3,"ن",1,0],["أنا ضيفُ طهَ. هل يبيتُ مشرَّدًا","ضيفٌ ألمَّ بمحسنينَ كرام؟",4,"م",1,0],["إنَّا ضُيوفٌ على ذكرَى تَفُوحُ شذًى","يسْتافُها الدهرُ نَسرِينًا، وريْحانا",5,"ن",2,0],["إن أُضيَّعْ فسوف يُنْشَدُ شعرٌ","بدويٌّ برقةِ المطبوع",6,"ع",1,0],["أنا ضيفكم ونزيل ساحة مثلكم","يعلو بمجد علو رب المنزل",7,"ل",1,0],["إنا ضحايا لهذا المين مينهم","من يوم حطين حتى اليوم والآنا",8,"ن",2,0],["أَنا ضَيَّعتُهُ بِإي","داعِهِ غَيرَ مُؤتَمَن",9,"ن",1,0],["إِن أَضحكت أَبكت وإِن برَّت بَرَت","وإِذا شَفَت شفَّت عليلَ ضَناها",10,"ا",3,0],["إن أضمَأتك مدامع مكفوفةٌ","روعاً فَمن رضوانِ ربّك تكرعُ",11,"ع",1,0],["إِن أُضرِمَت أَكبادُكُم مِن فقدهِ","فَنُفوسُكم بمفازِهِ مَثلوجه",12,"ج",2,0],["أنَاضِلُ عَنْ مكارِمِكمْ لأَنّي","كريمُ الأَصْلِ ميمونُ الولادهْ",13,"د",2,0],["أنا ضَيفُكَ المَكدودُ بالأسفارِ","فاجعَلْ قِراهُ قِراءَةَ الأسفارِ",14,"ر",1,1],["إنْ أُضرمَتْ فهي تاجٌ أوخَبْتَ ظهرتْ","أقراطُها الحمرُ أو أصداغُها الفُحُمُ",15,"م",1,0],["إنَّا ضِخامٌ كما تَهوى ، عَمالِقَة ٌ","كَما عَهِدْ تَ ، مُخيفاتٌ عَوادينا",16,"ن",2,0],["أنا ضامِنٌ وَصَلَ الحِبالِ لِخالِصٍ","قد زارَ مُنْقَطعَ العَلائِقِ حِيشَا",17,"ش",2,0],["إِنْ أُضحِ عَضباً فالقاً قِمَم العدى","فلربّ عضبٍ عِيق عن تجريدِ",18,"د",1,0],["إِنِ اِضطَجعتُ فمِنْ شوكِ القنا فُرُشِي","وإنْ مشيتُ فواطٍ فوقَ جَمْرَاتِ",19,"ت",1,0],["أناضل عن أحسابكم كل ثالب","وأحمي كد الذي كان أنكرا",20,"ر",2,0]]}