{"poems":[[49,"لعل خيال العامرية زائر","https://www.aldiwan.net/poem25294.html","الطويل"],[87,"عش للخلافة ترضاها وترضيها","https://www.aldiwan.net/poem7528.html","البسيط"],[69,"ما أكلنا في ذا الصيام كنافه","https://www.aldiwan.net/poem18075.html","الخفيف"],[48,"عيشي مؤد إلى الضراء والوهن","https://www.aldiwan.net/poem23512.html","البسيط"],[108,"موظف بلا مأوى","https://www.poetsgate.com/ViewPoem.aspx?id=179766",""],[108,"في ذكرى الكواكبي","https://www.poetsgate.com/ViewPoem.aspx?id=179601",""],[92,"في طهران","https://www.poetsgate.com/ViewPoem.aspx?id=179053",""],[119,"يا آل أحمد كم لكم من مدحةٍ","https://www.aldiwan.net/poem41801.html","الكامل"],[128,"ليلاي ليلاي إن الدهر أشقانا","https://www.aldiwan.net/poem23775.html","البسيط"],[240,"جادك الواكف الهتن","https://www.aldiwan.net/poem31739.html","مجزوء الخفيف"],[302,"تفديك لو قبل المنون فداها","https://www.aldiwan.net/poem33083.html","الكامل"],[310,"القلب يخشع والمدامع تهمع","https://www.aldiwan.net/poem56485.html","الكامل"],[310,"خطب عيون الدين منه ثجوجه","https://www.aldiwan.net/poem56586.html","الكامل"],[408,"لكم آل الرسول جعلت ودي","https://www.aldiwan.net/poem46969.html","المديد"],[411,"أنا ضيفك المكدود بالأسفار","https://www.aldiwan.net/poem49561.html","الكامل"],[463,"ظل المنى واسع والشمل ملتئم","https://www.aldiwan.net/poem55869.html","البسيط"],[470,"قدمت وعفوك عن مقدمي","https://www.aldiwan.net/poem59035.html","عموديه"],[505,"من زار منقطع العلائق حيشا","https://www.aldiwan.net/poem37990.html","الكامل"],[556,"بالله يا أيام يثرب عودي","https://www.aldiwan.net/poem47844.html","الكامل"],[556,"ما ضر طيفك لو والى زياراتي","https://www.aldiwan.net/poem48030.html","البسيط"],[592,"أتعرف نظماً فيك منى مسراً","https://www.aldiwan.net/poem11501.html","عموديه"],[597,"","https://poetry.dctabudhabi.ae/diwan/poem/138414",""],[658,"","https://poetry.dctabudhabi.ae/diwan/poem/122685","الكامل"],[732,"","https://poetry.dctabudhabi.ae/diwan/poem/86833","الكامل"],[938,"","https://poetry.dctabudhabi.ae/diwan/poem/70905","الكامل"],[959,"","https://poetry.dctabudhabi.ae/diwan/poem/59726","الخفيف"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59390","الوافر"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59231","الرمل"],[1038,"","https://poetry.dctabudhabi.ae/diwan/poem/59216","الرمل"],[1068,"","https://poetry.dctabudhabi.ae/diwan/poem/202127","الطويل"],[1177,"","https://poetry.dctabudhabi.ae/diwan/poem/28334","الطويل"],[1463,"","https://poetry.dctabudhabi.ae/diwan/poem/44841","الكامل"],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48912","البسيط"],[1564,"","https://poetry.dctabudhabi.ae/diwan/poem/84969","الرجز"],[1719,"","https://poetry.dctabudhabi.ae/diwan/poem/100960","الرمل"],[1907,"","https://poetry.dctabudhabi.ae/diwan/poem/124724","الخفيف"],[2229,"","https://poetry.dctabudhabi.ae/diwan/poem/47151","البسيط"],[2333,"","https://poetry.dctabudhabi.ae/diwan/poem/120727","الكامل"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106893","الخفيف"],[2385,"","https://poetry.dctabudhabi.ae/diwan/poem/106879","الطويل"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/204644","الخفيف"],[2944,"","https://poetry.dctabudhabi.ae/diwan/poem/203027","الخفيف"],[3208,"","https://poetry.dctabudhabi.ae/diwan/poem/130392","البسيط"],[3222,"","https://poetry.dctabudhabi.ae/diwan/poem/70361","الكامل"],[3494,"","https://poetry.dctabudhabi.ae/diwan/poem/52994","الكامل"],[3581,"","https://poetry.dctabudhabi.ae/diwan/poem/138561",""],[3730,"","https://poetry.dctabudhabi.ae/diwan/poem/85072","الخفيف"],[3848,"","https://poetry.dctabudhabi.ae/diwan/poem/59496","الكامل"],[3867,"","https://poetry.dctabudhabi.ae/diwan/poem/133284","الكامل"],[3957,"","https://poetry.dctabudhabi.ae/diwan/poem/139466",""],[4222,"","https://poetry.dctabudhabi.ae/diwan/poem/54431","الخفيف"],[4394,"","https://poetry.dctabudhabi.ae/diwan/poem/117207","الخفيف"],[412,"","https://poetry.dctabudhabi.ae/diwan/poem/31264","الكامل"],[4691,"مللتك شوقا أقام قليلا","https://www.poetsgate.com/ViewPoem.aspx?id=81257",""],[4755,"أَنا ضائِعِي في كُلِّ يَومٍ.. وخابِئِي","https://www.poetsgate.com/ViewPoem.aspx?id=184088",""],[4791,"نداء","https://www.poetsgate.com/ViewPoem.aspx?id=28400",""],[4800,"ياحبيّب يايابه","https://www.poetsgate.com/ViewPoem.aspx?id=105041",""],[4869,"ياطير حنا في زمان المحابيل","https://www.poetsgate.com/ViewPoem.aspx?id=151687",""],[4902,"عيون الحب","https://www.poetsgate.com/ViewPoem.aspx?id=5071",""],[5057,"شعري يضايقهم","https://www.poetsgate.com/ViewPoem.aspx?id=184759",""],[5190,"النيل يتحدث عن نفسه","https://www.poetsgate.com/ViewPoem.aspx?id=61840",""],[5213,"زر أول الشهداء مسلم إنه","https://www.poetsgate.com/ViewPoem.aspx?id=170479",""],[5277,"رسالةٌ إلى روحي","https://www.poetsgate.com/ViewPoem.aspx?id=194241",""],[592,"أهاجك أزماة تسامى بها الخلف","https://www.poetsgate.com/ViewPoem.aspx?id=128857",""],[592,"ألا بلغا المأفون من كان ألأما","https://www.poetsgate.com/ViewPoem.aspx?id=128807",""],[5370,"طفولة","https://www.poetsgate.com/ViewPoem.aspx?id=81393",""],[5409,"ذكرت صباً لها كان وفياً","https://www.poetsgate.com/ViewPoem.aspx?id=155366",""],[5431,"كن صديقي...","https://www.poetsgate.com/ViewPoem.aspx?id=200252",""],[5431,"أنا وأنا والإنعتاق الأخير...","https://www.poetsgate.com/ViewPoem.aspx?id=200430",""],[5781,"شفاهٌ عُرْضَةٌ للدفء","https://www.poetsgate.com/ViewPoem.aspx?id=202841",""],[5956,"ذكرياتُ مشاهدَ من حياتي","https://www.poetsgate.com/ViewPoem.aspx?id=184838",""]],"verses":[["أُناضِلُ عَن أَحسابِ قَومي بِفَضلِهِ","وَأَفخَرُ حَتّى لا أَرى مَن يُفاخِرُ",0,"ر",1,0],["إن أضحك الملا المفتون حاضرها","ابكى الاجنة في الارحام آتيها",1,"ي",3,0],["أنا ضَيفٌ لَهُ وَقد مُتُّ جوعاً","لَيتَ شِعْرِي لِمْ لا تُعدُّ الضِّيافَه",2,"ف",2,0],["إِنّا ضُيوفُ زَمانٍ ما قِراهُ لَنا","إِلّا المَنايا وَنَحنُ الآنَ في اللُهَن",3,"ن",1,0],["أنا ضيفُ طهَ. هل يبيتُ مشرَّدًا","ضيفٌ ألمَّ بمحسنينَ كرام؟",4,"م",1,0],["إنَّا ضُيوفٌ على ذكرَى تَفُوحُ شذًى","يسْتافُها الدهرُ نَسرِينًا، وريْحانا",5,"ن",2,0],["إن أُضيَّعْ فسوف يُنْشَدُ شعرٌ","بدويٌّ برقةِ المطبوع",6,"ع",1,0],["أنا ضيفكم ونزيل ساحة مثلكم","يعلو بمجد علو رب المنزل",7,"ل",1,0],["إنا ضحايا لهذا المين مينهم","من يوم حطين حتى اليوم والآنا",8,"ن",2,0],["أَنا ضَيَّعتُهُ بِإي","داعِهِ غَيرَ مُؤتَمَن",9,"ن",1,0],["إِن أَضحكت أَبكت وإِن برَّت بَرَت","وإِذا شَفَت شفَّت عليلَ ضَناها",10,"ا",3,0],["إن أضمَأتك مدامع مكفوفةٌ","روعاً فَمن رضوانِ ربّك تكرعُ",11,"ع",1,0],["إِن أُضرِمَت أَكبادُكُم مِن فقدهِ","فَنُفوسُكم بمفازِهِ مَثلوجه",12,"ج",2,0],["أنَاضِلُ عَنْ مكارِمِكمْ لأَنّي","كريمُ الأَصْلِ ميمونُ الولادهْ",13,"د",2,0],["أنا ضَيفُكَ المَكدودُ بالأسفارِ","فاجعَلْ قِراهُ قِراءَةَ الأسفارِ",14,"ر",1,1],["إنْ أُضرمَتْ فهي تاجٌ أوخَبْتَ ظهرتْ","أقراطُها الحمرُ أو أصداغُها الفُحُمُ",15,"م",1,0],["إنَّا ضِخامٌ كما تَهوى ، عَمالِقَة ٌ","كَما عَهِدْ تَ ، مُخيفاتٌ عَوادينا",16,"ن",2,0],["أنا ضامِنٌ وَصَلَ الحِبالِ لِخالِصٍ","قد زارَ مُنْقَطعَ العَلائِقِ حِيشَا",17,"ش",2,0],["إِنْ أُضحِ عَضباً فالقاً قِمَم العدى","فلربّ عضبٍ عِيق عن تجريدِ",18,"د",1,0],["إِنِ اِضطَجعتُ فمِنْ شوكِ القنا فُرُشِي","وإنْ مشيتُ فواطٍ فوقَ جَمْرَاتِ",19,"ت",1,0],["أناضل عن أحسابكم كل ثالب","وأحمي كد الذي كان أنكرا",20,"ر",2,0],["ان أضرمت في فؤادي امس نار جوى","فقلبيَ اليوم شبَّ فيه نيران",21,"ن",1,0],["إن أضمَرُوا حَسَداً فأنتَ كَيُوسُفٍ","في الطَّيِّبينَ وَهُم كَإخوَةِ يُوسفِ",22,"ف",1,0],["إِن أَضحَكت أَبكَت وَإِن هِيَ سالمت","غَدرت وَما تَنفك في تَدمير",23,"ر",1,0],["إنْ أضحكتْ أبكتْ وإنْ هي عاهدتْ","نقَضَتْ وإن عزمتْ فِعالا تفعلِ",24,"ل",1,0],["إن أضيع فلم أكن بمذيع","قط سراً ولا الذمام مضيعا",25,"ع",2,0],["أنَا ضَيْفُ الكَرِيمِ بِكُلّ أرْضٍ","وإن ضَاقَتْ تَقومُ بِيَ اتِّسَاعَا",26,"ع",2,1],["إنْ أضَاءَ البَدْرُ يَحْكِي خَدَّهُ","قُلْ لَهُ يَا بَدْرُ مَا هَذاَ الغَلَطْ",27,"ط",1,0],["إنْ أضَا الديجُورَ مِنْ طَلْعَتِهِ","فَبِخَدَّيْهِ البدورُ الطُّلَّعُ",28,"ع",1,0],["أنَاضِل دهرا هَدَّ عزمي صَرْفُه","فكم ذا لقلبي مِنْ أذَاه بَلابل",29,"ل",1,0],["أُناضِلُ عَنكُم في المَغيبِ عَشيرَتي","وَأَمَّا بِنَفسي دونَكُم فَأضارِبُ",30,"ب",1,0],["أَنا ضَيفُ حُبِّكَ فَاصطَنِعني إِنَّه","ضَيفُ الهَوَى يَستَوجِبُ الإِكرَاما",31,"م",2,0],["إِنا ضربنا له في صدرنا قِبباً","تُغني عن القُبة الحمراءِ من أَدَمِ",32,"م",1,0],["أنا ضوار الفارس القرم البطل","باعي على الأعداء أضحى المتصل",33,"ل",1,0],["إن أضع في معشر ضلّوا فقد","عرف المجدُ جَنابي أرحبا",34,"ب",2,0],["أنا ضيفٌ وللضيوف نزولٌ","فاجعل العفو لي منك إنزالا",35,"ل",2,0],["إنّا ضيوفُكَ يا خَيْرَ الأنام قِرىً","ذوُو افتقارٍ إلى ما منك من نُزُلِ",36,"ل",1,0],["أنا ضيفكم يا آل بيتِ محمَّدٍ","وعلى الكرامِ إجارةُ الأضيافِ",37,"ف",1,0],["أنا ضيَّعتُ كلَّ شيءٍ فهل عن","دك علمٌ ببعض مفقوداتي",38,"ت",2,0],["إن أضطجعت من دائها مستريحة","رأت شبحاً بالقرب منها توسدا",39,"د",2,0],["ان اضراس أمتي زعماء","قد ألحت بأكل مال الناس",40,"س",1,0],["إن أضل الأنام عقل فعقلي","فاق عقل الورى فأدرك ربي",41,"ب",2,0],["ان اضحكت مرة ابكت بلا عدد","وان صفت برهة اردت على الدوم",42,"م",1,0],["أنا ضَيفك المدعو يومَ معادنا ال","مرجوّ فاجْعَلْ منْ قرايَ الكوثَرَا",43,"ر",2,0],["إن أضمرتْ ودَّ العزيز نفوسُنا","سرُّ الضمير يكادُ يُظهره الفم",44,"م",1,0],["إن اضرموا النار على بابها","فذي خباها اضرموه بنار",45,"ر",1,0],["أنا ضيف ولي انتساب إليكم","جامع المعنوي والمحسوس",46,"س",1,0],["أنا ضَيْغمُ الحربِ العَوا","ن إذا تصادمتِ الأفاضلْ",47,"ل",1,0],["إنا ضيوفك يا إمام وذو الندى","يهب الجزيل لمن أتى متضيفا",48,"ف",2,0],["أنا ضيفٌ وجزاءُ","الضيف إحسانٌ إليهِ",49,"ي",2,0],["أَنا ضيفٌ بربعكمْ","أينَ أينَ المضيِّف",50,"ف",1,0],["إنّ أضيافَ خالدٍ وبَنيهِ","ليجوعون فوقَ ما يشبَعونا",51,"ن",2,0],["أَنا ضائِنٌ في الناسِ لَيسَ مُوافِقاً","لي مِن شُهورِ الرومِ إِلّا آبُها",52,"ب",3,0],["أنا ضائع في مدن من سكون","حراكي َ صار بها مستحيلا",53,"ل",2,0],["أَنا ضائِعِي في كُلِّ يَومٍ.. وخابِئِي","صَديقِي وأَعدائِي, جِرَاحِي وناكِئِي",54,"ا",2,1],["أنا ضايع ٍ ما بين هجره وزود أشواق","يكسِّرْ بها قلبي مع الغالي احسابه",55,"ب",2,0],["انا ضاقت على كل الرحيبه","اخاف افقدك ياحبيّب يايابه",56,"ب",2,0],["انا ضحيّة ما اخزنته المراسيل","كني يتيم وفارقه من يربيه",57,"ي",2,0],["أنا ضحيت له وأرجي وصابر","وإذا عيا أقول الله يحله",58,"ل",2,0],["أنا ضِدّكم ما عِشتُ أكشِفكم","والضِّدّ يكشِفُ قبحهُ الضِّدُّ",59,"د",1,0],["أَنَا ضَمِيرُ مَلايِينٍ عَلَى جُرُفِي","أَنَّتْ ، فَمَزَّقَهَا سَيفُ الدُّجَى مِزَقَا",60,"ق",2,0],["أنا ضامن لك ان وصلت لقبره","أن ليس ترجع خائبا من وفره",61,"ر",2,0],["أنا ضميمةُ أرضٍ ملؤُها وجعٌ","فلا تلومي..ففي التاريخِ ما رمتِ",62,"ت",1,0],["أناضل عن دين الهدى كل مبطل","وأحمي حمى التوحيد إن سامه خسف",63,"ف",1,0],["أناضل عن دين النبي محمد","وملة إبراهيم من كان مجرما",64,"م",2,0],["أنا ضحكتي للحين في وحشة الوديان","تصارع شبح نسيان وتخاف يطويها",65,"ي",3,0],["أنا ضحيت بنفسي وبه","حينما صيرني الحظ بغيا",66,"ي",2,0],["أنا ضوء وللضياء دروب","نحو كنهٍ محلقٍ وحقيقي",67,"ق",2,0],["أنا ضوءٌ شرودٌ دون حدٍ","وأنت البئرُ في الأسرار تُعنى!!",68,"ن",2,0],["إِن أَضْرَمَ القَلْبَ جُرْحُ البَيْنِ أرَّقَهُ","وازْدادَ نَزْفًا إِذا ما الشَّوقُ أدْماهُ",69,"ا",2,0],["\"أنا ضدُّ حبكَ للعلم إني","أخذْتُك عقلا وقلبا ومالا",70,"ل",2,0]]}