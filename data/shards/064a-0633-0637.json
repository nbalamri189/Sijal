bi.ae/diwan/poem/199214","البسيط"],[4615,"","https://poetry.dctabudhabi.ae/diwan/poem/35093","الكامل"],[4627,"","https://poetry.dctabudhabi.ae/diwan/poem/102017","البسيط"],[4639,"","https://poetry.dctabudhabi.ae/diwan/poem/124653","الكامل"],[4767,"سيف العدل","https://www.poetsgate.com/ViewPoem.aspx?id=180687",""],[4927,"رسالة حب","https://www.poetsgate.com/ViewPoem.aspx?id=29840",""],[5213,"أرح قلوصك من كد ومن تعب","https://www.poetsgate.com/ViewPoem.aspx?id=170412",""],[5259,"ستودع الله من ودعته ويدي","https://www.poetsgate.com/ViewPoem.aspx?id=186806",""],[5431,"قالت جهينة ...","https://www.poetsgate.com/ViewPoem.aspx?id=214882",""],[5542,"مشاهد من يوم القيامة","https://www.poetsgate.com/ViewPoem.aspx?id=10202",""],[2110,"يا مهاة قد نأت عن مقلتي","https://www.poetsgate.com/ViewPoem.aspx?id=156291",""],[5691,"مأمن الله","https://www.poetsgate.com/ViewPoem.aspx?id=206667",""],[4372,"ما أَعجَبَ الحُبَّ في مَذاهِبِه","https://www.poetsgate.com/ViewPoem.aspx?id=86430",""],[6069,"يا من يعيب علي حب مدللٍ","https://www.poetsgate.com/ViewPoem.aspx?id=105675",""],[6075,"مخاض النصر","https://www.poetsgate.com/ViewPoem.aspx?id=190481",""],[6080,"ورب ليلة سعد قد حظيت بها","https://www.poetsgate.com/ViewPoem.aspx?id=127326",""],[6268,"مرثية الصباح","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=82926&r=&rc=12",""],[6346,"مشنقة الحروف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=83387&r=&rc=3",""]],"verses":[["يَسطو بِلا سَبَبٍ وَتِل","كَ طَبيعَةُ الكَلبِ العَقورِ",0,"ر",1,0],["يَسْطَعُ مُشْرِفاً عَلَى الأزْمَانِ","يَقمْنَ بِالوَاجِبِ مَهْمَا صَعُبَا",1,"ب",2,0],["يَسطو عَلى كُتّابِهِ بِدَواتِهِ","فَمُرَمَّل وَمُضَمَّخٌ بِمِدادِ",2,"د",1,0],["يسطو على الآجالِ رمح سماكها","ولتسطونَّ على السماك رماح",3,"ح",1,0],["يسطو بلا حولٍ ولا قوةٍ","منه ولا نابٍ ولا مِخلبِ",4,"ب",1,0],["يسطو بسيف في المخاطبِ ناطقٍ","شَفعٍ بآخر في الضرائب أخرس",5,"س",1,0],["يسطع كالماس على","عقد ثمين من ذهب",6,"ب",1,0],["يَسِطُ البُيوتَ لِكَي يَكونَ مَظِنَّةً","مِن حَيثُ توضَعُ جَفنَةُ المُستَرفِدِ",7,"د",1,0],["يَسطُو بِعَضبٍ إِذا ما هَزّ مَضْرِبَهُ","يومَ الضّرابِ لعيني ساهِدٍ رَقَدا",8,"د",2,0],["يَسطو عَلَيَّ بِحُسنٍ لَستُ أُنكِرُهُ","يا مَن رَأى حَمَلاً يَسطو عَلى ذيبِ",9,"ب",1,0],["يَسْطُو بِرِفْقٍ إِذَا مَا الْحَزْمُ أَعْوَزَهُ","إِلَى الْعِقَابِ وَيَعْفُو حِينَ يَقْتَدِرُ",10,"ر",1,0],["يَسْطُو بِهَذا وَيَرْمِي ذَاكَ عَنْ عُرُضٍ","كَطَارِدٍ يَقْتَفِي صَيْدَيْنِ إِذْ عَادَى",11,"د",2,0],["يسطيرها لمع النجوم تخاله","لمع الصوارم حين ثار قتامها",12,"م",3,0],["يسطو بسيف في المخاطبِ ناطقٍ","شَفعٍ بآخر من الضرائب أخرس",13,"س",1,0],["يَسْطُو وَالحَارَةُ سَاهِيَةٌ","يُرْدِيْ سِرِّيَّاً أَوْ جَهْرِيْ",14,"ر",2,0],["يسطو بادبار على ذي غفلة","ثمل بخمر الامن من اقباله",15,"ل",2,0],["يسطيع أن يودي به","داء وتأسره منون",16,"ن",1,0],["يَسطُو عَلَى بِدَعٍ قَد شِبنَ مُنتَضِياً","صَمصَامَةَ الحَقِّ فِئنَ مُنهَزِمَه",17,"م",2,0],["يسطو وقائمُ سيفهِ في كفِّه","فكأن راحتُه له أوطان",18,"ن",1,0],["يسطو بذاكَ وذا فيغدو قِرْنُهُ","بهما صريعَ لواحظٍ ومناصل",19,"ل",1,0],["يسطو على امواله يوم الندى","فكأنما يسطو على الأعداء",20,"ا",2,0],["يَسطو بِضَربٍ قاصِلٍ بَل فاصِلٍ","وَبِطَعنِ دِعّيسٍ وَرَميِ مُقَرطِسِ",21,"س",1,0],["يَسطو عَلى ما لَيسَ يَعقِلُ مَثلَماً","يَسطو بِمِديَتِهِ عَلى العُقَلاءِ",22,"ا",2,0],["يسطو بموزره على","ألف من القوم الأخر",23,"ر",1,0],["يسطع من ثمة طيبِ ريّا","افعل في النفس من المحيّا",24,"ي",2,0],["يَس طَهَ بنِ عَبدِ اللَهِ مَن شَرَّفتَ","مَعَ أَضطِرادِ العُلا وَالمَجدُ أُسرَتُهُ",25,"ت",2,0],["يَسطو عَلى بيض الظُبات قَوامه","حَيث العَوالي السُمر بَعض جُنودهِ",26,"د",2,0],["يسطو على الأَرزاء سطوة ضيغمٍ","إحدى براثنه السنان الأَزرق",27,"ق",1,0],["يسطو ويحلم في سلْمٍ ومُعتركٍ","فالفتك للحرب والإعراضُ للنادي",28,"د",2,0],["يسطو بألحاظه تيهاً ولا عجب","من اللهاذم أن تسطو بها الأسل",29,"ل",1,0],["يسطو القوي على الضعيف فإن شكا","ثانيهما المسكين عد الجاني",30,"ن",2,0],["يَسطو فيُشهِدُنا السِماكَ بسرجِه","والبدرَ مكتملاً بنثرة سردهِ",31,"د",2,0],["يسطو بعزْمَتِه الجبانُ على العِدى","كالسّهمِ يحمِلُه جناحُ سوائِهِ",32,"ا",3,0],["يَسطو وأفواهُ الجِراحِ فواغِرٌ","تَشكو وألسِنةُ الأسنّةِ تلذَعُ",33,"ع",1,0],["يسطُو على شَمْلِ بيتِ المالِ مُقتَطِعاً","كأنَّهُ بيتُ شِعرٍ إذْ يُقطِّعُهُ",34,"ع",2,0],["يسطر ما يَلقى السقيمُ ببرْئه","ويكتبُ ما يَلْقَى الْعَدُوُّ بحتفه",35,"ف",2,0],["يَسطو عَلى المَرءِ المَنِيِّ بَعدَ العَنا","قَسراً فَماذا النَفعُ مِن إيجادِهِ",36,"د",2,0],["يَسطو عَلَيَّ وَلا يَرِقُّ فَعِندَهُ","قَلبٌ وَلَكِن بِالحَديدِ مَصفَحُ",37,"ح",1,0],["يسطو على أعدائهِ","صولة ليث مخدرِ",38,"ر",1,0],["يَسطو بِهَيبَتِه تَعنو الأُسودُ لَها","وَقَد تَرَدَّت بِثَوبِ الرّعبِ وَالرّهبِ",39,"ب",1,0],["يَسطو عَلى خَيلِ العداةِ بِعَضّهِ","وَبِضَربِهِ وَوثوبهِ إِنْ أَقدَما",40,"م",2,0],["يَسطو بِرمحٍ تقطُّ العمرَ حربتُهُ","فَلَم تَدَع عمرَ عاتٍ غيرَ مقتضبِ",41,"ب",1,0],["يَسطو بِسَيفٍ تُذيبُ الرّوح برقتُه","وَتَسلِبُ الرّوحَ مِن أَحشاءِ منسلِبِ",41,"ب",1,0],["يَسطو عَليهِ وَبِالإِعطاءِ يتلفهُ","فَلا عَلى فِضّةٍ يُبقي وَلا ذَهَبِ",41,"ب",1,0],["يَسطو هِزَبْراً تَعتَليهِ وَسامَةٌ","يَعدو عَلى طِرفٍ أَغرَّ محجَّلِ",42,"ل",1,0],["يَسطو عَلَيهِ غَضَنفَراً بِزَئيرِهِ","لَكِنّهُ لَو خَرّ مِثلَ الهَيثَمِ",43,"م",1,0],["يسطو على مَنْ يعتدى عليه","وهْو فتىً برٌّ بوالديْه",44,"ه",1,0],["يسطو على القوم سطواً","بالسَّلح لا بالسلاح",45,"ح",1,0],["يسطو بهندي لحظٍ","يستلّ عن جفن تُركي",46,"ك",2,0],["يسطو بفتيان صدق في الوغى صبرا","عند اللقاء إذا طعن القنا اختلفا",47,"ف",2,0],["يسطو فيَظهرُ في أسِرةِ وَجْهِهِ","بشرٌ تُمَازِجُ أمْنَهُ الرحْمَاءُ",48,"ا",2,0],["يسطو باللحظ وبالقد الرطيبْ","ويغازي لا بعضب وعَوالْ",49,"ل",1,0],["يسطو على الجيش اللهام","هناك بالجيش اللهامِ",50,"م",1,0],["يسطو على الأسماك يوماً كلما","أذكى له حر المجاعة نارا",51,"ر",2,0],["يسطو بمُقلَته فتحسبُهُ","يسطو عليك بصارمٍ عَضبِ",52,"ب",1,0],["يَسطو إِذا يَسطو بسطوة حيدر","في كفه سنن له وَسنان",53,"ن",1,0],["يسطو به وبحيات القنا أسدٌ","جمُّ الرماد شديد الساعدين جري",54,"ر",2,0],["يسطو على مُهَجٍ لها","ببريقِ لمعتِهِ اتِّصَال",55,"ل",1,0],["يسطو على ساط جموح سابح","كالسيد بادر غفلة الرقباء",56,"ا",2,0],["يسطو بأسلحة للأكل أربعة","يد وفم وبلعوم وأمعاء",57,"ا",2,0],["يسطو بأعظم صولة رواعة","منها الكماة تصرمت أعمارها",58,"ر",3,0],["يسْطو على المال إِنعاماً كأَنَّ به","غَيْظاً على المال يومَ الجُود أَو شَنَأَ",59,"ا",1,0],["يسطوا فقل في السبنتي خلفت بشرى","أشبالها جوعاً في غاية الألم",60,"م",1,0],["يسطوا فتقى البيض تغرس في الطلى","فتعود قائمة الرؤس حصيدا",61,"د",2,0],["يَسطو عَلى القِرنِ غَداةَ الوَغى","سَطوَةَ مِقدامٍ بِها عاتِ",62,"ت",1,0],["يَسطو وَقَد بَرَقَت أَسِرَّةُ وَجهِهِ","بِشراً فَيَمزُجُ أَمنَهُ الإِشفاقُ",63,"ق",1,0],["يسطوا على العاشقين منتصرا","بسيف جفن للغنج منكسر",64,"ر",1,0],["يسطو على الجيش اللهامِ بصارمٍ","في حدِّه الهاماتُ خرّت سَّجدا",65,"د",2,0],["يسطو وعينُ معاليه لِنسوتِه","تَرعى وتجري اللئالي من محاجرها",66,"ر",3,0],["يَسطو بأبيضَ صارمٍ","كالشّمس والبرق اللَّموع",67,"ع",1,0],["يسطو على العشاق من لحظه","في صرام عري متناه",68,"ا",2,0],["يسطو عليهم سطوة الكرار إذ","حملت عليه القوم حملة واحد",69,"د",1,0],["يسطو فتنثل الجيوش كأنما","شاء تنافر من ليوث عرين",70,"ن",1,0],["يَسطو عَلى الناس خاقان الجَبين وزن","جى اللحاظ بِجَيش خسر وانيّ",71,"ي",1,0],["يسطو فيختطف النفوس بصارمٍ","كالبرق يقدح بالشرار فيلمعُ",72,"ع",1,0],["يسطو على الجلى فيقعدها","بأساً بسطوة باسل يثب",73,"ب",1,0],["يَسطو سطُو العَبد الخَصي منافِقاً","ويَظَلُّ يَرقُصُ تارةً وَيُصَفّقُ",74,"ق",1,0],["يسطو بألحاظ أحدّ من اسمهِ","ويجلُّ عن بدرِ الوجود وشمسِهِ",75,"س",2,0],["يَسطو بِصارمه السَقيم فَلَم يَعد","إِلا بِقَلب الضَيغم الضرغام",76,"م",1,0],["يَسطو بأبيض في إفرنده شعل","يَذوب مِن حرها عِندَ الوقاع حرا",77,"ر",2,0],["يسطو القوي على الضعيف فان شكا","الماً فلا احد يرق لحاله",78,"ل",2,0],["يسطون في الجم الغفير ضياغماً","لكنما شجر القنا اجماتها",79,"ت",3,0],["يَسطو عَلى خَلقٍ بِلا ذَنب كَما","يَسطو عَلى بَعض الفَرائِس قسورُ",80,"ر",1,0],["يسطع من جبينه نور الهدى","مستحوذٌ بباسه على العدى",81,"د",2,0],["يَسطو عَلى ضعفي سَوادُ جفونِه","بِالبيضِ وَهِيَ قضيةٌ لم تُنتِج",82,"ج",1,0],["يسطو على نظمك في نظمه","ويدّعى فخرك من فخره",83,"ر",2,0],["يسطع العنبر من أردافها","ويفوح المسك من أردانها",84,"ن",3,0],["يسطو على الأدواء موقع رأيه","فيهن موقع صارم بقذال",85,"ل",1,0],["يس طاهرٍ مطهِّرٍ لنا","طهِّر من الذنوب واحفظ كلَّنا",86,"ن",2,0],["يسطو بسيفين من بأسٍ ومن كرم","يستأصلان عروق البخل والجبن",87,"ن",1,0],["يسطو بمثل هلال منه بدر دجىً","في جنح ليل من الهيجاء معتكر",88,"ر",1,0],["يَسطَعُ بِالحَديدِ وَالفولاذِ","كَبَرقِ زَفسِ اللامِعِ الجَبّاذِ",89,"ذ",1,0],["يَسطُ عَلى قداستي","وَيَأتني بِالعَجَبِ",90,"ب",1,0],["يسطو بساريتي لجي","نٍ يحطمان الصخر هدّا",91,"د",2,0],["يَسطو وَلا يَخشى مَلامَة لائِم","وَيَجور وَهو محكم في الاِنفس",92,"س",1,0],["يسطع نور المجد من وجهه","فينجلي الليل بذاك السطوع",93,"ع",1,0],["يسطو عليهم كالعقاب","وقد تحصب خلف طائر",94,"ر",1,0],["يسطو بهم فوق طرفٍ","يشأى الصبا في السباق",95,"ق",1,0],["يسطو على أسد الشرى فيصدها","بلواحظ هي والقضاء سواء",96,"ا",2,0],["يسطو علي بأبيض من لود","وبرمح قد لابذات كعوب",97,"ب",1,0],["يسطو علي بأبيض من أسود","وبرمح قدٍّ لا بذات كعوب",98,"ب",1,0],["يسطو على أسد الشرى فيصيدها","بلواحظ هي والقضاء سواء",99,"ا",2,0],["يسطُو على عُشَّاقهِ مِن قَدِّهِ","ولِحاظِهِ بمثقَّفٍ ومهنَّدِ",100,"د",1,0],["يَسطو إِذا ما ثارَ نقعُ مسائلٍ","قَد أَشكلت بِشَبَاةِ سطوةِ ثائِر",101,"ر",1,0],["يَسطو بطَرفٍ فاترٍ","لم تنبُ بِيضُ نِصالهِ",102,"ل",2,0],["يَسطُو عليَّ بأبيضِ من لَحظهِ","وبأسمرٍ من قَدِّهِ عَرَّاصِ",103,"ص",1,0],["يَسْطُو بِشُوسٍ مَصالِيتٍ جَحاجِحَةٍ","يَجُرَّ بَحْرَ خَمِيسٍ فَوقَ سابِحَةٍ",104,"ه",1,0],["يسطو على الغرم في ترقيعها","سطو الغرم على فؤاد المدنف",105,"ف",1,0],["يسطو فتلقى العدى من خوف سطوته","تفرّ منه بلا قلب من الرهب",106,"ب",1,0],["يسطو فيكسر ان عدا جمع العدى","ويعودُ في جميع صحيح سالم",107,"م",1,0],["يسطو فتلقى الأسد منه مروعة","ذا أكبد عطت من البرحاء",108,"ا",2,0],["يسطو علينا بتفريقٍ فواعجبا","هل كان للبَينِ فيما بيننا ثارُ",109,"ر",1,0],["يَسطو بِها فَأَقولُ يا عَجَبا","ماذا يُري عَلياءَهُ الجَدُّ",110,"د",1,0],["يسطو بأبيض مشحوذ الغرار فلو","يشاء يفني العدى عادوا إلى العدم",111,"م",1,0],["يسطو فيختطف النفوس بعضبه ال","ماضي الشبا ويوزع الأجسادا",112,"د",2,0],["يسطع كالشمس إذا أشرقت","يبيض ما ثوب الدجى سوده",113,"د",2,0],["يُسَطِّرُهُ عَلَى الأَوْرَاْقِ قَلْبٌ","كَأَنَّ سُطُوْرَه