://poetry.dctabudhabi.ae/diwan/poem/54508","الكامل"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/54697","البسيط"],[93,"","https://poetry.dctabudhabi.ae/diwan/poem/55126","الوافر"],[19,"","https://poetry.dctabudhabi.ae/diwan/poem/2231","الكامل"],[19,"","https://poetry.dctabudhabi.ae/diwan/poem/2238","السريع"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/142037","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43800","الكامل"],[65,"","https://poetry.dctabudhabi.ae/diwan/poem/43884","المتدارك"],[101,"","https://poetry.dctabudhabi.ae/diwan/poem/54258","الوافر"],[72,"وهارب من رضوان","https://www.poetsgate.com/ViewPoem.aspx?id=45465",""],[106,"تهنئة بوسام","https://www.poetsgate.com/ViewPoem.aspx?id=179504",""],[106,"حي اللاجئين","https://www.poetsgate.com/ViewPoem.aspx?id=179618",""],[106,"على الأعراف","https://www.poetsgate.com/ViewPoem.aspx?id=179633",""],[106,"صوت الشباب","https://www.poetsgate.com/ViewPoem.aspx?id=179642",""],[106,"الديمقراطية","https://www.poetsgate.com/ViewPoem.aspx?id=179443",""],[106,"زيارة طرابلس","https://www.poetsgate.com/ViewPoem.aspx?id=179604",""],[106,"قومي بين الشرق والغرب","https://www.poetsgate.com/ViewPoem.aspx?id=179442",""],[106,"تحيّة لبنان","https://www.poetsgate.com/ViewPoem.aspx?id=179608",""],[106,"ثورة على الحضارة","https://www.poetsgate.com/ViewPoem.aspx?id=179425",""],[106,"في ذكرى الكواكبي","https://www.poetsgate.com/ViewPoem.aspx?id=179601",""],[106,"شعب واحد ورب واحد","https://www.poetsgate.com/ViewPoem.aspx?id=179304",""],[106,"بغداد","https://www.poetsgate.com/ViewPoem.aspx?id=179289",""],[84,"أما الرياح بجو عاصم","https://www.poetsgate.com/ViewPoem.aspx?id=26356",""],[50,"ابْنَ نِهْيَا رَأسٌ علَّي ثَقِيلُ","https://www.poetsgate.com/ViewPoem.aspx?id=30920",""],[98,"عودوا إلى تلك القرى","https://www.poetsgate.com/ViewPoem.aspx?id=55335",""],[90,"تحية الحلة","https://www.poetsgate.com/ViewPoem.aspx?id=179146",""],[90,"ساعة مع البحتري في سامراء ...","https://www.poetsgate.com/ViewPoem.aspx?id=179035",""],[90,"تحية العيد أو الملك والإنتداب","https://www.poetsgate.com/ViewPoem.aspx?id=178948",""],[90,"إبن الشام","https://www.poetsgate.com/ViewPoem.aspx?id=178945",""],[90,"النجوى","https://www.poetsgate.com/ViewPoem.aspx?id=178987",""],[90,"رثاء شيخ الشريعة","https://www.poetsgate.com/ViewPoem.aspx?id=178927",""],[54,"تأسَّفَتْ جَارتي لمَّا رَأْتْ زَوَري","https://www.poetsgate.com/ViewPoem.aspx?id=14275",""],[45,"زَعَمَ الغُرَابُ مُنَبّىءُ الأنْبَاءِ","https://www.poetsgate.com/ViewPoem.aspx?id=32958",""],[91,"الحرب العظمى","https://www.poetsgate.com/ViewPoem.aspx?id=53314",""],[91,"عام 1910","https://www.poetsgate.com/ViewPoem.aspx?id=53146",""],[28,"لا قوم أكرم من تميم إذ غدت","https://www.poetsgate.com/ViewPoem.aspx?id=22081",""],[51,"أبن لي تعمّم طابقيا","https://www.poetsgate.com/ViewPoem.aspx?id=30791",""],[105,"تلك القضية هل لها ميعاد","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=55087&r=&rc=257",""],[103,"رسالة في ليلة التنفيذ","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=74370&r=&rc=3",""]],"verses":[["أَبَّنتُهُ تَحتَ الصَفائِحِ لَو يَرى","وَدَعَوتُهُ خَلفَ الجَنادِلِ لَو يَعي",0,"ع",2,0],["أَبَني عَديٍّ إِنَّما","سالَت بِخَيلِكُمُ الشِعابُ",1,"ب",1,0],["أَبناءُ طَلحَةَ طابوا بالنَّدى مُهَجاً","إِذ طَيَّبَ المَجدُ وَالعَلياءُ محتِدَهُم",2,"م",1,1],["أَبَني زَبيبَةَ ما لِمُهرِكُمُ","مُتَخَدِّداً وَبُطونُكُم عُجرُ",3,"ر",1,1],["أبَني الأنْصارِ لكُمْ شرَفٌ","حُكْمُ القُرْآنِ بهِ نطَقا",4,"ق",2,0],["أَبْنَاءُ يَحْيَى وَفَتْهُمْ كُلَّمَا وُلِدُوا","عِنَايَةُ اللهِ مِنْ مُوسَى وَهَارُونِ",5,"ن",1,0],["أبْنَاءُ نَصْرٍ آلُ سَعْدٍ نَاصَرُوا","خَيْرَ الْوَرَى طُرّاً وَمَا أَدْرَاكَا",6,"ك",2,0],["أبني عُبادَةَ إنّ فخْرَ قديمكُمْ","تُلِيَتْ بفُرْقانِ الهُدى أسْطارُهُ",7,"ر",2,0],["أَبَنِي عَلِيٍّ آلَ بَيتِ مُحَمَدٍ","بِالطَّفِّ تَقتُلُهُم جُفاةُ نِزارِ",8,"ر",1,0],["أَبني قُشَيرٍ إِنَّني أَدعوكُمُ","لِلحَقِّ قَبلَ ضَلالَةٍ وَخَسارِ",8,"ر",1,0],["أَبناءَ قَومٍ قُتِّلوا","يَومَ القُصَيبَةِ مِن أَوارَه",9,"ر",2,0],["أَبَنتَ لَنا التَنزيلَ حُكماً وَحِكمَةً","وَفَرَّقتَ بَينَ النورِ وَالظُلُماتِ",10,"ت",1,0],["أَبناؤُنا وَهُمُ أَحاديثُ النَدى","لَيسوا عَلى أَوطانِهِم بِشِحاحِ",11,"ح",1,0],["اِبنا الحَرَستانِيِّ في لقبيهِما","ضِدُّ الَّذي نُعِتا بِهِ بَينَ المَلا",12,"ل",2,1],["أَبِن لِيَ ما اسمٌ لَيتَ لي يُمنَ مَن بِهِ","تَسَمّى وَلَو يَوماً مِنَ الدَهرِ بِاسمِهِ",13,"م",2,0],["أَبِن لي أَلَم أَضطَلِع ناهِضاً","بِأَعباءِ بِرِّكَ فيمَن نَهَض",14,"ض",1,0],["أَبناكَ في ثَبَجِ المَجَرَّةِ قُبَّةً","فَهَناكَ أَنَّكَ لِلنُجومِ مُخاصِرُ",15,"ر",1,0],["أَبَني سُلَيمٍ إِن لَقَيتُم فَقعَساً","في مَحبَسٍ ضَنكٍ إِلى وَعرِ",16,"ر",1,1],["أَبِنتُ صَخرٍ تِلكُما الباكِيَة","لا باكِيَ اللَيلَةَ إِلّا هِيَه",17,"ي",2,1],["أَبْنَاءَ يَعْرُبَ هَذِي سِيرَةٌ بَرَزَتْ","لَكُمْ حَقَائِقُهَا الكُبْرَى مِنَ الحُجُبِ",18,"ب",1,0],["أبني رجالاً للبلاد بأرؤسٍ","وعليك كسوة هامهم بفخار",19,"ر",1,0],["أَبْنَاءُ زَحْلَةَ آسَادٌ غَطَارِفَةٌ","فِيهَا وَفِي كُلِّ مَا حَلُّوا مِنَ المُدُنِ",20,"ن",1,0],["أَبْنَاءُ عُثْمَانَ حُفَّاظٌ وَقَدْ عَهِدُوا","تَارِيخَ عُثْمَانَ فِيهِ الفَتْحُ وَالعِظَمُ",21,"م",1,0],["أَبناءُ حَربٍ وَوَمَروانٍ وَأُسرَتُهُم","بَنو مُعَيطٍ وُلاةُ الحِقدِ وَالوَغَرِ",22,"ر",1,0],["أَبَنَّ بِهِ عَودُ المَباءَةِ طَيِّبٌ","نَسيمَ البِنانِ في الكِناسِ المُظَلَّلِ",23,"ل",1,0],["أبناءُ نصرٍ ملوك عزّ نصرُهُمُ","وأوسعوا الخلق تَنْويها وترفيها",24,"ي",3,0],["أبناء أنصار النَّبيّ وحزبه","وذوي السوابق والحوار الأعصمِ",25,"م",1,0],["أبناء أنصار النّبِيّ وصحبه","في الذكر أصبح فخرهم مذكورا",26,"ر",2,0],["أبناؤهم أبناء نصر بعدهم","بسيوفهم دين الإله قد انتصرْ",27,"ر",1,0],["أبناء مدرسة أولاء وكلّهم","يفع مرير المرفقين غلام",28,"م",1,0],["أبنيّ سر سير الأما","ن من الطوارق في خفير",29,"ر",1,0],["أبناء مصر والشآم إليكم","منّي تحية وامق وصديق",30,"ق",1,0],["ابنوا المدارس واستقصوا بها الأملا","حتى نُطاول في بنيانها زُحلا",31,"ل",2,1],["أبِن ذنبي إليَّ فدتك نفسي","فإني عنه بعدئذ أتوب",32,"ب",1,0],["أَبناءُ نَخلٍ وَحيطانٍ وَمَزرَعَةٍ","سُيوفُهُم خَشَبٌ فيها مَساحيها",33,"ي",3,0],["أَبُنَيَّ شِعرَةَ إِنَّ سَعداً لَم تَلِد","قَيناً بِليتَيهِ عَصيمُ دُخانِ",34,"ن",1,0],["أَبِنا عَدَلتَ بَني خَضافِ مُجاشِعاً","وَعَدَلتَ خالَكَ بِالأَشَدِّ سِنانِ",34,"ن",1,0],["أَبَني حَنيفَةَ أَحكِموا سُفَهاءَكُم","إِنّي أَخافُ عَلَيكُمُ أَن أَغضَبا",35,"ب",2,1],["أَبَني حَنيفَةَ إِنَّني إِن أَهجُكُم","أَدَعِ اليَمامَةَ لا تُواري أَرنَبا",35,"ب",2,0],["أَبَنو قُفَيرَةَ يَبتَغونَ سِقاطَنا","حُشِرَت وُجوهُ بَني قُفَيرَةَ سودا",36,"د",2,0],["أَبُنَيَّ شِعرَةَ لَم نَجِد لِمُجاشِعٍ","حِلماً يُوازِنُ ريشَةَ العُصفورِ",37,"ر",1,0],["أَبَني قُفَيرَةَ قَد أَناخَ إِلَيكُمُ","يَومَ التَقاسُمِ لُؤمُ آلِ نِزارِ",38,"ر",1,0],["أَبَني رَبيعَةَ إِنَّما أَزرى بِكُم","نَكَدُ الجُدودِ وَدِقَّةُ الأَخلاقِ",39,"ق",1,0],["أَبُنَيَّ شِعرَةَ لِم تَسُدُّ طَريقَنا","بِالأَعمَيَينِ وَلا قُفَيرَةَ فَاِزحَلِ",40,"ل",1,0],["أَبَنو طُهَيَّةَ يَعدِلونَ فَوارِسي","وَبَنو خَضافِ وَذاكَ ما لَم يُعدَلِ",40,"ل",1,0],["أَبَني قُفَيرَةَ مَن يُوَرِّعُ وِردَنا","أَم مَن يَقودُ لِشِدَّةِ الأَحمالِ",41,"ل",1,0],["أَبناؤُهُنَّ أَقَلُّ قَومٍ حُرمَةً","عِندَ الشَرابِ وَما لَهُنَّ عُقولُ",42,"ل",1,0],["أَبَني أُسَيدَةَ قَد وَجَدتُ لِمازِنٍ","قِدَماً وَلَيسَ لَكُم قَديمٌ يُعلَمُ",43,"م",1,1],["أَبَني كِلابٍ كَيفَ تُنفى جَعفَرٌ","وَبَنو ضُبَينَةَ حاضِرو الأَجبابِ",44,"ب",1,0],["أَبُنَيَّ هَل أَحسَستَ أَع","مامي بَني أُمِّ البَنينا",45,"ن",2,0],["ابني أمية إنكم","أهل الوسائل والأوامر",46,"ر",1,0],["إِبنانِ أَم شِبلانِ ذانِ فَإِنَّني","لَأَرى دِماءَ الدارِعينَ غِذاهُما",47,"م",2,1],["أَبُنَيَّتي لاتَحزَني","كُلُّ الأَنامِ إِلى ذَهابِ",48,"ب",1,1],["أَبُنَيَّتي صَبراً جَمي","لاً لِلجَليلِ مِنَ المُصابِ",48,"ب",1,0],["اِبنُ عَمّي الداني عَلى شَحطِ دارٍ","وَالقَريبُ المَحَلُّ غَيرُ قَريبِ",49,"ب",1,0],["أَبَنِيَّ إِن حاوَلتُمُ أَن تَسرِقوا","فَخُذوا مَعاوِلَ كُلَّهُنَّ صَليبُ",50,"ب",1,0],["أَبَني الحِماسِ أَلَيسَ مِنكُم ماجِدٌ","إِنَّ المُروءَةَ في الحِماسِ قَليلُ",51,"ل",1,1],["أَبَني الحِماسِ فَما أَقولُ لِثُلَّةٍ","تَرعى البِقاعَ خَبيثَةِ الأَوطانِ",52,"ن",1,0],["أبنيّ إن تكسَ التراب فإنه","غايات أجمعنا وليس بعار",53,"ر",1,0],["أبنيّ إني قد كنزتك في الثرى","فانفع أباك بساعة الإقتار",53,