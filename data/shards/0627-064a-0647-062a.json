{"poems":[[30,"أيهتف مكروب ببكر بن وائل","https://www.aldiwan.net/poem5139.html","الطويل"],[95,"","https://poetry.dctabudhabi.ae/diwan/poem/54926","المتقارب"],[1529,"","https://poetry.dctabudhabi.ae/diwan/poem/140212",""],[1546,"","https://poetry.dctabudhabi.ae/diwan/poem/48917","الكامل"],[2433,"","https://poetry.dctabudhabi.ae/diwan/poem/93578","الخفيف"],[399,"","https://poetry.dctabudhabi.ae/diwan/poem/205765","الخفيف"],[3921,"","https://poetry.dctabudhabi.ae/diwan/poem/29276","الخفيف"],[5111,"عَشْتَارُ","https://www.poetsgate.com/ViewPoem.aspx?id=212606",""],[308,"يَا فَاضلا كرمت فِينَا سجاياه","https://www.poetsgate.com/ViewPoem.aspx?id=190382",""],[5539,"حزم البطولات","https://www.poetsgate.com/ViewPoem.aspx?id=192483",""]],"verses":[["أَيَهتِفُ مَكروبٌ بِبَكرِ بنِ وائِلٍ","تَخَوَّنَهُ كابٍ مِنَ الجَدِّ عاثِرُ",0,"ر",1,1],["أَيُهْتَكُ عَنْهَا قَمِيصُ المُرُو","ءَة تَحْتَ البِلَى مَنْع أَنْ تُسْتَرَا",1,"ر",2,0],["آيةٌ تحشد المباهجَ في الرُّو","حِ وتُوحي الهوى نديَّ الغلائل",2,"ل",1,0],["إيه تلاميذَ المدارس إنكم","في راحة بين الطروس ونِعمة",3,"ه",1,0],["آية تملأ العَوالم حَتّى","جاوَزت بِالصُعود قَوس الصُعود",4,"د",1,0],["إيه تلّ الرمال ماذا ترى أب","قيت لي من مدينة الأحلام",5,"م",1,0],["آيَةً تَذهَبينَ في ذلِكَ المَو","تِ وَلكِن هَيا خُذيني خُذيني",6,"ي",1,0],["آيَةٌ تَبْعَثُ فِيْ العُمْرِ ضِيَاءً","وَبَهَاءً يَتَنَامَى فِيْ دَلالِ",7,"ل",1,0],["إيه تفضلت بالنظم البديع فَمَا","أَعْلَاهُ عِنْدِي من عقد وأغلاه",8,"ا",2,0],["ايه تامر ياملكنا وكلن لك عظيد","ننصر اللي دمع عينه على خده نثر",9,"ر",1,0]]}