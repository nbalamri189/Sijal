//www.poetsgate.com/ViewPoem.aspx?id=185598",""],[5431,"أيا خير من صافى وياخير من عفّا","https://www.poetsgate.com/ViewPoem.aspx?id=191456",""],[5542,"نفحة من بستان الوحي","https://www.poetsgate.com/ViewPoem.aspx?id=10057",""],[5690,"ماذا الشفيع وماذا ينفع الحذرُ","https://www.poetsgate.com/ViewPoem.aspx?id=172157",""],[5732,"ملحمه عكاظ","https://www.poetsgate.com/ViewPoem.aspx?id=177864",""],[402,"يا حسنها حين تجلت على","https://www.poetsgate.com/ViewPoem.aspx?id=36426",""],[5804,"آخر أنسأم الربيع","https://www.poetsgate.com/ViewPoem.aspx?id=180676",""],[5956,"إن عشتُ للربيع","https://www.poetsgate.com/ViewPoem.aspx?id=183183",""],[5970,"أذن الصبح فهل قلبي معي","https://www.poetsgate.com/ViewPoem.aspx?id=130651",""],[6019,"ندى الفجر","https://www.poetsgate.com/ViewPoem.aspx?id=186015",""],[6056,"الأحلام الوردية","https://www.poetsgate.com/ViewPoem.aspx?id=130357",""],[6056,"المعاناة الشديدة","https://www.poetsgate.com/ViewPoem.aspx?id=130508",""],[6093,"العين تقطف ورد الخد بالنظر","https://www.poetsgate.com/ViewPoem.aspx?id=210636",""],[6237,"حسناء الريف","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77879&r=&rc=21",""],[6237,"عودة إلى الطبيعة","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=77860&r=&rc=2",""]],"verses":[["وَإِن تَشتَمِل أَرضٌ عَليكَ فَإِنَّما","عَلى ماءِ عَينِ النَقا وَالكَثاكِثُ",0,"ث",1,0],["وإنْ تشوّفْتَ الى زَوْجَةٍ","ثانِيةٍ حَسْبُكَ منْ زَوْجِ",1,"ج",1,0],["وَإِن تَشَأ كانَ فِعلَي","نِ فِعلَ نَهيٍ وَأَمرِ",2,"ر",1,0],["وَإِن تَشرَب فَنِعمَ أَخو النَدامى","كَريمٌ ماجِدٌ حُلوُ النِدامِ",3,"م",1,0],["وإن تشاجتْ سمعت هاتفاً","يهتفُ من خلفٍ بها تعسا",4,"س",2,0],["وانْتَشْتُه من خمول والده ال","ساقِط فانتشت شر مُنتاش",5,"ش",1,0],["وأن تشرع الدُهمُ في بحركم","وأن لا يروني مع الشارع",6,"ع",1,0],["وَاِنتَشَروا وَالدُروبُ واسِعَةٌ","كَالأَنجُمِ الزُهرِ حينَ تَنبَثِقُ",7,"ق",1,0],["وَإِن تَشَء أَن تَكونَ قَبري","فَكُن كَما شِئتَ أَن تَكونا",8,"ن",2,0],["وانتشتْ روحيَ الكئيبَةُ بالحبِّ","وغنَّتْ كالبلبلِ الغِرِّيدِ",9,"د",1,0],["وأنت شقيق الروح تؤثر وصلها","إذا راعها بالهجر خل وصاحب",10,"ب",1,0],["وَاِنتِشارُ الغُيومِ في مَبدَإِ الفَص","لِ وَشَمسُ الخَريفِ في الميزانِ",11,"ن",1,0],["وَأَنتَ شِهابٌ في المُلِمّاتِ ثاقِبٌ","وَسَيفٌ إِذا ما هَزَّكَ الحَقُّ قاصِلُ",12,"ل",1,0],["وَأَنتَ شَغّابٌ عَلى الشَغّابِ","لِلخُطَّةِ الفَقماءِ آبٍ آبِ",13,"ب",1,0],["وَإِن تَشرَبَ الصَهباءَ تُعقِبكَ شَهوَةً","وَلَكِن مِنَ المَوتِ الشَرابُ الَّذي يَقهي",14,"ي",1,0],["وَانْتَشِقْ رَيَّاكَ مِنْ مُلْتَقَى","شَارِبٍ بِالمِسْكِ مَلْطُوخِ",15,"خ",1,0],["وانتشى من عطرها فانتثرتْ","مثل حبَّاتٍ من الماس يراها",16,"ا",3,0],["وانتَشَرتْ في الأرْض ريحٌ له","يَسُوقُها المُنْجِدُ والمُتْهِمُ",17,"م",1,0],["وانتَشَقَتْ عَرْفَكَ طَيْرُ المَلا","فزَارَكَ النّاشئُ والقَشْعَمُ",17,"م",1,0],["وانتشى القلبُ بالحنانِ وبالح","بِّ وحلوِ الهوى وصفوِ الأماني",18,"ن",2,0],["وانتشى جوّنا انتشاء النّدامى","وأدار النجوم أكواب صهبا",19,"ب",2,0],["وانتشى من شعاعك العلم لمّا","زرت \" دار العلم \" يا خير زائر",20,"ر",1,0],["وأن تَشْهَدَ الأشلاء تنقضُّ حولَها","وفي دَمِها الفرسانُ مخضوبةً خَضْبا",21,"ب",2,0],["وانت شيخ حباه الله مرتبة","قعساء قد قصرت عن طولها الفكر",22,"ر",1,0],["وأنت شرقية والشأن عندكمو","أن الملاح ذوات الحسن تستترُ",23,"ر",1,0],["وَإِن تَشتَرُ وانفَعَ الكَلامِ بِضَيرِهِ","دَعوا الامتِداح المُصطَفى مَدحَ غَيرِهِ",24,"ه",1,0],["وَانْتَشَى البُسْتَانُ منْ خَمْرِ الحَيَا","فاسْتَقاءَ النَّوْرُ منْ ذَاكَ السَّكَرْ",25,"ر",1,0],["وإن تشأ صحفه وانظر تجد","خلقاً سوياً قط ما أغفى",26,"ف",2,0],["وَإِن تَشدُد يَداً بِالخَيرِ تُفلِح","وَإِن تَعدِل فَما لَكَ مِن مَناصِ",27,"ص",1,0],["وانتشت روحه الطليقة في الدهر","بخمر مزاجها الإيحاء",28,"ا",2,0],["وانتشى الكون بكأس","لم تذقها شفتان",29,"ن",1,0],["وانتشيك في الرؤى خيالاً","ولا أني أعلل الأمالا",30,"ل",2,0],["وانتشلنا الغرب من ظلمته","وملأنا صفحة الكون ضياء",31,"ا",2,0],["وإن تشأ اعربته","إعراب جمع كُسِّرا",32,"ر",2,0],["وإن تشأ فَثِّنه","وَجمعه قد ذُكِّرّا",32,"ر",2,0],["وانْتَشتَهم من يدِ الخطوبِ ولا","ملجأَ منها يُنجِي ولا وَزَرُ",33,"ر",1,0],["وانتشقنا نسيم رقّةِ لفظ","كنسيم الصَّبا ونشر الخزامى",34,"م",2,0],["وأنتِ شِفائي يا أُميمُ وإنَّني","أُعالِجُ داءً في هواكِ عضالا",35,"ل",2,0],["وأنت شرق إيمانا وفلسفة","كأنما تحكم الدنيا وما فيها",36,"ي",3,0],["وانتشرت خضراءَ دوحةُ العلا","فالساقُ وَحْف والقضيبُ مكتسي",37,"س",2,0],["وإن تشابهتِ الألفاظُ واتفقتْ","فرُمَّة الحبل شكلاً حَيَّةٌ ذكَرُ",38,"ر",1,0],["وانتشرتْ أهداب أعلامهِ","مصبّغاتٍ بدماء الجراح",39,"ح",1,0],["وَاِنتَشَرَ الزَهرُ عَلى الرَوابي","كَأَنَّهُ الديباجُ وَالعَتّابي",40,"ب",2,0],["وأنت شهاب حق وهو منه","بمنزلة الضياء من الشهاب",41,"ب",1,0],["وانْتَشِقْ مِنْ عَرْفِها ما","قَدْ حَكَى طِيبَ شَذَاكا",42,"ك",2,0],["وإنْ تَشُكَّ فِيما","رَوَيتُه قَدِيما",43,"م",2,0],["وأنت شمس","وهم غمائم",44,"م",1,0],["وانتشرت في الورى روائحه","واشتهرت في الملا تباشيره",45,"ر",2,0],["وانتشق زهر رياضي","فبطيبي الكون عاطر",46,"ر",1,0],["وانتشي كلما عدت فضائلكم","وما لها أبداً بالعد إحصاء",47,"ا",2,0],["وأَنْ تَشِيعَ في الْورَى","جَواهِري النفائِسْ",48,"س",1,0],["وإِنْ تَشَكَّكتَ أَنِّي قد قُتِلتُ بها","فاسْتَقْسمِ الدَّلَّ أَو فَاسْتَشْهِد الغَيَدا",49,"د",2,0],["وَإِن تَشدُ وَرقاءَ في أَيكَةٍ","تُؤَرِّقهُ في صَوتِها وَالنَغَم",50,"م",1,0],["وانتشق بعد الرحيق","ورد خديه المضعف",51,"ف",1,0],["وانتَشَرَ العَدلُ في رَعيَّتِهِ","فَحاطَهُ أَمنُهُ وَإيمانُه",52,"ن",2,0],["وإن تشا قلت لوح وهو أحرفه","على اختلاف بدت عن نقطة القلم",53,"م",1,0],["وَأَنتَ شكل حسنُ","وَالجودُ فيك ضابطة",54,"ه",1,0],["وَاِنتَشَلنا خَزائِنَ المَرءِ كسرى","يَومَ وَلّوا وَحاصَ مِنّا جَريضا",55,"ض",2,0],["وَاِنتَشِقْ مِنها شَذى نَفحٍ يَضوع","مُنعِش الأَرواحِ شافٍ لِلزّكام",56,"م",1,0],["وَأَنت شَمس العُلى والعزّ في شرفٍ","مَن ذَروةٍ فَوقَ رَأسِ المَجدِ وَالفخرِ",57,"ر",1,0],["وَاِنتَشقْ عَرفَ غوالٍ وشذَى","مِن نَسيمٍ صافَحت فيها الخُزامى",58,"م",2,0],["وَإِن تَشأ حِكايَةً لِلثاني","فَالأَمر في ذَلِكَ للسُلطان",59,"ن",1,0],["وَانتَشَر الخَوفُ وَحَلَ الرُعب","وَكَثُرَ الكر مَعاً وَالكَرب",60,"ب",1,0],["وَاِنتَشَرَ الريح هُناكَ وَهُنا","وَفي قَرار البَحر أَلقى السُفُنا",61,"ن",2,0],["وإن تُشاورْ من الأنام أخا","رأىٍ فخذه من غير مِصْداقِ",62,"ق",1,0],["وإن تَشأْ فميلةٌ من ذابلٍ","يضمنُ منه الوِرد نجح المصدر",63,"ر",1,0],["وَإِن تَشتَمِل قَيسٌ عَلَيَّ وَتَغلِب","أَبِت واثِقاً بِالمالِ وَالثَرَواتِ",64,"ت",1,0],["وَإِنْ تَشَكَّيْتُ مِنَ الإِنْحافِ","لَمْ أَرَ عِطْفاً مِنْ أَبٍ عَطّافِ",65,"ف",1,0],["وإن تشا فزد لها ريح الصبا","لأن من طالعها لها صبا",66,"ب",2,0],["وانتشق ريحها وكن عبد ساقي","كاسها يا مريد نيل المرام",67,"م",1,0],["وانتشينا من خمرة القرب ذوقا","وطربنا بصوت طبل وعود",68,"د",1,0],["وأنت شيخنا بدر الشيوخ","وبيت العِز بيتك لا جدالا",69,"ل",2,0],["وإن تشأ فامنعه حيث انفصلا","واقرن به إن شئت نحو أفعلا",70,"ل",2,0],["وان تشا فاستعمل الرتقاءَ مع","غير الذي نصبته حيثُ وقع",71,"ع",1,0],["وان تشأ فانزل على نصبٍ صُرف","حتى تزيدَ الثلثَ من عَرض الألف",71,"ف",1,0],["وإن تشعر ذيل كلِّ مُنتصب","أو لم تشعِّر ذا وهذا قد كُتِب",71,"ب",1,0],["وأنت شعاره في كل حال","وغيرك لم يكن إلا دثاره",72,"ر",2,0],["وانتشقنا الرياحَ نطلبُ ذرواً","من شذا ذِكرةٍ بجيبِ الرياح",73,"ح",1,0],["وأنت شيخٌ شاب منك الورى","ورأسُك الأَسودُ لم يُبدَل",74,"ل",1,0],["وانتشينا من مزج ريق بريق","وجنايا لثم بلثم معاده",75,"د",2,0],["وان تشر الثريا لي بكف","خضيب قلت عني للبطين",76,"ن",1,0],["وانتشر الصبح بأنواره","وانجاب عن أضوائه الحندس",77,"س",1,0],["وانتشرت الأرواح في نشر عرفها","وأرجت الأرجاء منها نوافح",78,"ح",1,0],["وأَنت شهيدٌ حاضِرٌ غيرُ غائِبٍ","وهل غابَ مَنْ أَقْصَى منازِله صَدْري",79,"ر",2,0],["وَأنتَ شَفِيعُ البَرَايا أغِث","عُبَيداً بأَذيالِكُم قَد شَبِث",80,"ث",1,0],["وإن تشأ فاختبر الأملاكا","فلست تُلفي فيهم ملاكا",81,"ك",2,0],["وانتشقها كروضة الحَزْن أَهْدَتْ","نفحات جاءت بها النَّكْباء",82,"ا",2,0],["وأنتَ شَرَعتَ الله أكبر من كذا","فحيّر أهلَ الفكر قولُك تحييرا",83,"ر",2,0],["وَاِنتَشَينا فَتَلاقَينا عَلى","نِعمَةِ الحُبِّ وَغَيظِ العُذَّلِ",84,"ل",1,0],["وَانتشق الأَرواح مَهما تَنسمت","فَتذهب في رُوحي الصِبا وَالأَصائل",85,"ل",1,0],["وَانتشينا مِن خَمرة بلماها","فَسكرنا بِها وَنَحنُ صِحات",86,"ت",1,0],["وأن تشرين عن كانون حدثنا","من بعد ما غاب في نيسان أيار",87,"ر",1,0],["وَاِنتَشَروا في البَرِّ كَالجَراد","وَمَلَأوا تَلّاً كَذا وَوادي",88,"ي",1,0],["وان تشب لبناً بالماء او عسلا","فذا مباح وحول الخمر لا تحم",89,"م",1,0],["وَإنْ تَشَوَّقْتَكُمْ بَعَثْتُ لَكُمْ","كُتْبَ غَرَامِي وَمِنْكُمُ الكُتُبُ",90,"ب",1,0],["وانتشقا من طيبها مسك ثرى","أمسى به روض الهدى مفوفا",91,"ف",2,0],["وان تشرق فضريح القاموس","شيخ جليل في مقام مأنوس",92,"س",1,0],["وأنتَ شَبابٌ للذي شابَ مُقْبِلٌ","إليه وجَدٌّ للذي خابَ مُنْجِبُ",93,"ب",1,0],["وإن تشأ بلدا في القطر متحدا","فزر صفاقس تلف عندها عجبا",94,"ب",2,0],["وانتشت من وجودها في ربوعٍ","أرضها بالتقديس تسمو سماها",95,"ا",3,0],["وانتشى أول عَرْف","في نسيم الصبح فاحا",96,"ح",2,0],["وانتشق عرف الروابي قائلاً","يا له عرفاً يعيد الميت حي",97,"ي",1,0],["وإن تشكروا حكم البعاد فللنوى","علينا إياد لا يقوم بها الشكر",98,"ر",1,0],["وَإِنْ تَشَأ رَاحَةً مَا شَانَهَا نَصَبٌ","فَاعْمَدْ لِمَا أنْتَ عَنْهُ الدَّهْرَ فِي شُغُلِ",99,"ل",1,0],["وَإِن تَشَا حُبَّ رَبٍّ","فَاقفُه وَلاَ تَعدُ نَهجَه",100,"ج",2,0],["وإن تشأ أُهدر فهو مُهَدر","وقد أُهِلّ ذا الهلالُ النيّر",101,"ر",1,0],["وإن تشأ شتان ماهما وقل","شتان ما بينهما كذا نُقِل",102,"ل",1,0],["وإن تشأ جئت بياء النسب","وقد حلمت عن يزيد المذنب",103,"ب",1,0],["وإن تشأ بنية الولاده","وطُلقت طَلقا من الولاده",103,"ه",1,0],["وإن تشأ بنية الإيصاف","وفارس في الخيل غير خاف",103,"ف",1,0],["وإن تشأ عنينة في عمرو","واليوم قرّ وشديد القُرّ",103,"ر",1,0],["وإن تشأ فتحت منه الأَولا","واقصد بِنا الأُردُنَّ أو قُطرُبّلا",104,"ل",2,0],["وإن تشأ أسكنت ثاني اللفظ","من هذه الثلاث فاحفظ حفظي",105,"ي",1,0],["وإن تشأ أجنَّه الليل وقل","ذهبت بالإبل وأذهبت الإبل",106,"ل",1,0],["وإن تشأ تستجبهم فاصحبن إذاً","فريام فهو إلى الأسطول ق خرجا",107,"ج",2,0],["وإن تَشكَّي يهود","فالعالم الحر يغضب",108,"ب",1,0],["وأنت شهاب الدين تحمي سماءه","فلا ماردَّ إلاَّ عليه تصولُ",109,"ل",1,0],["وانتشق عرف نشر طيب معانيه","اذا لم تكن لمرآه رائي",110,"ا",2,0],["وانتشق ما جرى من غيمها من سايم","وأرمق الطير إذا رأيته في الجو حائم",111,"م",1,0],["وان تشأ فابلني تعثر على رجلٍ","مطهر القلب من غشٍ ومن خبث",112,"ث",1,0],["وَاِنتش الزَهر وَالزَهرة","كَم تَحمل عُطرا",113,"ر",2,0],["وَاِنتَشَقتُ