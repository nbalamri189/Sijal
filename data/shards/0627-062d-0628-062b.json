{"poems":[[55,"من الركب ما بين النقا والأناعم","https://www.aldiwan.net/poem29748.html","الطويل"],[55,"أقول لركب خابطين إلى الندى","https://www.aldiwan.net/poem30195.html","الطويل"],[29,"غدا باجتماع الحي نقضي لبانة","https://www.aldiwan.net/poem5735.html","الطويل"],[285,"هبوا طيفكم أعدى على النأي مسراه","https://www.aldiwan.net/poem60774.html","الطويل"],[556,"أحب ثرى نجد ونجد بعيدة","https://www.aldiwan.net/poem48084.html","الطويل"],[2691,"","https://poetry.dctabudhabi.ae/diwan/poem/178002","الطويل"],[3501,"","https://poetry.dctabudhabi.ae/diwan/poem/62808","الوافر"]],"verses":[["أُحِبُّ ثَرى أَرضٍ أَقامَ بِجَوِّها","حَبيبٌ إِلى قَلبي وَإِن لَم يُلائِمِ",0,"م",1,0],["أُحِبُّ ثَرى أَرضٍ أَقَمتَ بِجوِّها","وَإِن كانَ في أَرضٍ سِواها مَغارِسي",1,"س",2,0],["أُحِبُّ ثَرى نَجدٍ وَبِالغَورِ حاجَةٌ","فَغارَ الهَوى يا عَبدَ قَيسٍ وَأَنجَدا",2,"د",2,0],["أُحِبُّ ثَرى الْوادِي الَّذِي بانَ أَهْلُهُ","وَأَصْبُو إِلى الرَّبْعِ الَّذِي مَحَّ مَغْناهُ",3,"ا",2,0],["أُحِبُّ ثَرى نجدٍ ونجدٌ بعيدةٌ","أَلا حبّذا نجدٌ إن لم تُفِدْ قُربا",4,"ب",2,1],["أحب ثرى أرض إلي وإن نأت","محلك منها نبتها وترابها",5,"ب",3,0],["أُحِبُّ ثَنيةَ الصّنَمين تحدو","بها الأرواحُ مُطَّلَعَ الغُيومِ",6,"م",1,0]]}