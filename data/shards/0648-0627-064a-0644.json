{"poems":[[65,"ووغد حديث بالخصاصة عهده","https://www.aldiwan.net/poem45862.html","الطويل"],[74,"على اليمن والنعمى ليال تبسمت","https://www.aldiwan.net/poem18240.html","الطويل"],[53,"يا صائد الأسد إن صيدكها","https://www.aldiwan.net/poem61832.html","المنسرح"],[63,"كستك الشبيبة ريعانها","https://www.aldiwan.net/poem51411.html","المتقارب"],[68,"خليلي ما أغبى المغالين في الهوى","https://www.aldiwan.net/poem40098.html","الطويل"],[77,"أرياك أم ردع من المسك صائك","https://www.aldiwan.net/poem69053.html","الطويل"],[98,"","https://poetry.dctabudhabi.ae/diwan/poem/39649","البسيط"],[89,"","https://poetry.dctabudhabi.ae/diwan/poem/42586","المنسرح"],[89,"هل فى التَّصابى على امرئٍ فنَدُ ؟","//adab.com/modules.php?name=Sh3er&doWhat=shqas&qid=23881&r=&rc=143",""],[449,"عوذت بالله إمام العصر","https://www.aldiwan.net/poem56033.html","عموديه"],[466,"وائلوا بي إلى أغر هجان","https://www.aldiwan.net/poem15692.html","الخفيف"],[556,"متى أنا ناج من سهام الغوائل","https://www.aldiwan.net/poem47258.html","الطويل"],[844,"","https://poetry.dctabudhabi.ae/diwan/poem/199599","المسحوب"],[1009,"","https://poetry.dctabudhabi.ae/diwan/poem/17583","الخفيف"],[1659,"","https://poetry.dctabudhabi.ae/diwan/poem/108838","الخفيف"],[2220,"","https://poetry.dctabudhabi.ae/diwan/poem/27275","الهزج"],[2765,"","https://poetry.dctabudhabi.ae/diwan/poem/116519","الطويل"],[3941,"","https://poetry.dctabudhabi.ae/diwan/poem/111500","المتقارب"],[4523,"","https://poetry.dctabudhabi.ae/diwan/poem/200110","السريع"],[5072,"لا تدعها","https://www.poetsgate.com/ViewPoem.aspx?id=52557",""],[5344,"عطره الشانيل ..","https://www.poetsgate.com/ViewPoem.aspx?id=180706",""],[5431,"لقد شطبَ اليماني الإمامه...","https://www.poetsgate.com/ViewPoem.aspx?id=200001",""],[5749,"الفكلمة","https://www.poetsgate.com/ViewPoem.aspx?id=132697",""],[5749,"ما تتبدل ما تتغير","https://www.poetsgate.com/ViewPoem.aspx?id=154942",""],[5749,"سعداتك ايلا بغاتك","https://www.poetsgate.com/ViewPoem.aspx?id=179968",""]],"verses":[["وَأَيُّ لَئيمٍ لا يُصَعِّرُ خَدَّهُ","إِذا افْتَرَّ عَمَّا زَحْزَحَ الشِّدَّةُ الرَّخا",0,"خ",2,0],["وإيلام حسادٍ وفضل وليمة","كذلك فليولم أخو السعد والخصب",1,"ب",1,0],["وأي لصٍ أجلُّ مَرْزأة","من مُتْلِفِ الروح مُتْلِف الجسدِ",2,"د",1,0],["وأيُّ ليالي الهَوى أحسَنَتْ","إليَّ فأَنكرْتُ إحسانَها",3,"ن",3,0],["وَأَيُّ لَبيبٍ ما سَبى الحُسنُ لُبَّهُ","فَباتَ بِقَلبٍ بِالغَرامِ قَريحِ",4,"ح",1,0],["وأيُّ لسانٍ ناطِقٌ وهو مُفحَمٌ","وأيُّ قَعُودٍ ناهِضٌ وهو بارك",5,"ك",1,0],["وأيُّ لحن إِليه تُصغي","بروحها الحالم استبدَّا",6,"د",2,0],["وَأَيُّ لَوْمٍ عَلَى امْرِئٍ طَلَبَ الْ","لَهْوَ وَأَثْوَابُ عُمْرِهِ جُدُدُ",7,"د",1,0],["وَأَيُّ لَوْمٍ عَلَى امْرِىء ٍ طَلَبَ الْ","ما شَذَّ عَنْ طَبْعِ وَالِدٍ وَلَدُ",8,"د",1,0],["وأي لفظ كالنجوم الزهر","لم يك طوع نهيه والأمر",9,"ر",1,0],["وائِلوا بي إِلى أغَرَّ هِجانٍ","من بني النَّضْر يخْضِبُ المشرفيَّةْ",10,"ي",2,1],["وأيُّ لِزازٍ للخصومِ دفنتَهُ","وأَنزلتَه في منزلٍ غير آهلِ",11,"ل",1,0],["وايلاج هب ع الغايه","ما من اعظام اصحاح",12,"ح",1,0],["وائِل بَعضُها يقتلُ بَعضا","لا يَفِلُّ الحَديدَ غَيرُ الحَديدِ",13,"د",1,0],["وائلي البيان حس","سانه فاه أو رقم",14,"م",1,0],["وأى للكاملِ البادي","بحالِ العالِ والدونِ",15,"ن",1,0],["واي لاعمال العباد معرض","على خير من جازى على الخير والشر",16,"ر",1,0],["وإيلاس موليساً ميلنيفاً","وسائرهم للهزيمة هما",17,"م",2,0],["وأي ليث هب من خيسه","فاعترضت ارباه اعتراض",18,"ض",1,0],["وإي ْ للذنب ِ فاعلُه ُ ولكن","لهذا الذنب ِ غفّار ٌ وغافر ْ",19,"ر",1,0],["وايلي حجري من سلالة منبه","وينتشي كل الفخر بإسم القبيله",20,"ل",2,0],["وأيلول البهي يُقيمُ صرحا","محافله إلى يوم القيامه",21,"م",2,0],["وأيلول المجيد بلا انتهاءٍ","وكلّ العابثينَ إلى القمامه...",21,"م",2,0],["وإيلا العين تشرق ولاتدمع","نعبر بلكلمة الكلمة الحنينة",22,"ن",2,0],["وايلا هدرتك ولقيت لك حيلة","محال نندم اكيد نغمات ميات وتر",23,"ر",1,0],["وايلا مشات كرهاتك","تحير فامرها ما تعرف اش تدير",24,"ر",1,0]]}