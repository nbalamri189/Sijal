{"poems":[[82,"للأقاحي بفيك نور ونور","https://www.aldiwan.net/poem31434.html","الخفيف"],[276,"أنسمة طيب أم صبا طيبة هبا","https://www.aldiwan.net/poem52104.html","الطويل"],[831,"","https://poetry.dctabudhabi.ae/diwan/poem/48676","الكامل"],[2061,"","https://poetry.dctabudhabi.ae/diwan/poem/48266","الكامل"],[3027,"","https://poetry.dctabudhabi.ae/diwan/poem/74300","الهزج"],[4372,"","https://poetry.dctabudhabi.ae/diwan/poem/28762","الطويل"],[4624,"","https://poetry.dctabudhabi.ae/diwan/poem/67434","الكامل"],[4672,"","https://poetry.dctabudhabi.ae/diwan/poem/204255","الكامل"],[5845,"أنسمة ُ طيبٍ أمْ صبا طيبة ً هبا","https://www.poetsgate.com/ViewPoem.aspx?id=198483",""],[6031,"حَمَامَاتِ شِيرازَ رِفْقاً بِنَا","https://www.poetsgate.com/ViewPoem.aspx?id=46324",""]],"verses":[["لِسُكونِ الغرامِ مِنهُ حَرَاكٌ","وَلِمَيْتِ السّقامِ فيهِ نُشورُ",0,"ر",1,0],["لسكان تلك الأَرض عهد مؤكد","لدى وَخبر العهد ما أَنصب الحبا",1,"ب",2,0],["لسكتُّ سكتةَ من يغص بريقه","وتركت للطلل المحيل البوما",2,"م",2,0],["لسُكَيْنَةٍ في قلبِ عاشقها سكنْ","ومُحِبُّها من فرْط حبٍّ ما سَكَنْ",3,"ن",1,1],["لسكان النَقا وَالبان","سهادي في جُفوني بان",4,"ن",1,0],["لسكر الهَوى أَروى لِعَظمي وَمِفصَلي","إِذا ظَمِيا يا روح مِن سُكرَةِ الخَمرِ",5,"ر",1,1],["لسكبته أسفاً عليك وحسرة","وجعلت ذاك مكان دمع ساكب",6,"ب",1,0],["لسكبت كافوري بشحم بياضها","وكتبت أبياتي بذوب سوادها",7,"د",3,0],["لسكانِ تلكَ الأرضِ عهدٌ مؤكدٌ","لدى َّ وخيرُ العهدِ ما أنصبَ الحبا",8,"ب",2,0],["لَسُكَّانُ ظَهرِ مَنِي من أُوا","لَ أوّلُ مطلبِنَا والمُنَى",9,"ن",2,0]]}